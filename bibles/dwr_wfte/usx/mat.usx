<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">ማቶሳ ምሽራቹዋ</para>
  <para style="toc1">ማቶስ ጻፌዳ ምሽራቹዋ ቃላ</para>
  <para style="toc2">ማቶሳ ምሽራቹዋ</para>
  <para style="toc3">ማቶሳ</para>
  <para style="mt1">ማቶስ ጻፌዳ</para>
  <para style="mt2">ምሽራቹዋ ቃላ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ማቶስ ጻፌዳ ምሽራቹ፥ የሱስ ያና ጌተትያ ህዶታይ ካሰ ኦደት ኡቴዳ ልያ ግድያዋነ ጾሳይ ካሰ ኤጫ ጫቁዋን ባረ አሳዉ እሜዳ ህዶታ ቃላ ፖሌዳዌ የሱሳ ባጋና ግድያዋ ኦድያ ምሽራቹዋ ቃላ ኦይቄዳዋ። ሀ ምሽራቹዋ ቃላይ የሱስ ኡንቱንቱ ግዶን የለቲደ ድጬዳዌ አይሁዳቱ ጻላላሳ ግደናን፥ አላምያ ኡባን ደእያ አሳሳ።</para>
  <para style="ip">ማቶስ ጻፌዳ ምሽራቹዋ ቃላይ ዳሮ አኬካን ጻፈቴዳ ማጻፋ። የሱሳ የለታን ዶሚደ፥ እ ጻማቀቴዳዋነ እ ፓጨቴዳዋ ኦድ ስሚደ፥ ጋሊላን እ ቃላ ኦዴዳዋ፥ ታማርሴዳዋነ ሀርጋንቻቱዋ ፓዳዋ ኦዴ። ሄዋፐ ካሊደ የሱስ ጋሊላፐ የሩሳላመ ቤዳዋነ እ ሀ አላምያን ጋምኤዳ ዉርሰ ሳምንታን ሀኔዳ የዋቱዋ ቆንጭሴ። ሄዋንቱካ እ ካቀቶዋ፥ ሀይቄዳዋነ ደንዴዳዋ ኦዲኖ።</para>
  <para style="ip">ሀ ምሽራቹዋ ቃላይ የሱሳ፥ ጾሳ ህግያ ብለ እማናዉ ማታይ ደእያዋነ ጾሳ ካዉተባ ኤርስያ ዎልቃማ ታማርስያዋ ኦደ ሺሼዳ። አ ትምርትያፐ ዳርያ ባጋይ፥ ዱማ ዱማ ኦግያን ጊገቴዳ እቼሹ ሳን ሻከቴ።</para>
  <para style="ili">1. ጾሳ ካዉተን ደአና አሳ ኤሻ፥ ኦሱዋ፥ ማታነ ዉርሰ ካጫ ኦድያ ደርያ ቦላ ትምርትያ (ማቶሳ 5:1—7:28)።</para>
  <para style="ili">2. ታማነ ላኡ የሱሳ ካልያዋንቱ ምሽራቹዋ ቃላ ታማርሳናዉ ቤዳ ዎደ ኡንቱንቶ እመቴዳ ካለዋ (ማቶሳ 10)።</para>
  <para style="ili">3. ጾሳ ካዉተባ ታማርስሽን ሺቄዳ ዱማ ዱማ ሌምሳቱዋ (ማቶሳ 13)።</para>
  <para style="ili">4. የሱሳ ካልያዋንቱባ ብል ኦድያ ትምርትያ (ማቶሳ 18)።</para>
  <para style="ili">5. ሀእ ዎድያ ዉርሰነ ጾሳ ካዉተ ዩሳ ጼልያዋን እመቴዳ ትምርትያ (ማቶሳ 24-25)።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">የሱስ ክርስቶሳ ጉየ ዘረነ የለታ <char style="ior"><ref loc="MAT 1:1-2:23">1:1—2:23</ref></char></para>
  <para style="io1">ጻማቅያ ዮሃንሳ ኦሱዋ <char style="ior"><ref loc="MAT 3:1-12">3:1-12</ref></char></para>
  <para style="io1">የሱስ ጻማቀቶዋነ ፓጨቶዋ <char style="ior"><ref loc="MAT 3:13-4:11">3:13—4:11</ref></char></para>
  <para style="io1">የሱስ ኦሱዋ ጋሊላን ዶሞዋ <char style="ior"><ref loc="MAT 4:12-18:35">4:12—18:35</ref></char></para>
  <para style="io1">የሱስ ጋሊላፐ የሩሳላመ ቦዋ <char style="ior"><ref loc="MAT 19:1-20:34">19:1—20:34</ref></char></para>
  <para style="io1">የሩሳላመንነ እዝ ዩሹዋን የሱሳ ዉርሰ ሳምንታ <char style="ior"><ref loc="MAT 21:1-27:66">21:1—27:66</ref></char></para>
  <para style="io1">ኑ ጎዳ የሱሳ ደንዱዋነ ቆንጨ <char style="ior"><ref loc="MAT 28:1-20">28:1-20</ref></char></para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s1">የሱስ ክርስቶሳ የለታ ማራ</para>
  <para style="r">(<ref loc="LUK 3:23-38">ሉቃሳ 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>ሀዌ ዳዊታ ዛርያነ አብራሃመ ዛረ ግዴዳ የሱስ ክርስቶሳ የለታ ኦድያ ማጻፋ።<verse eid="MAT 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2"/>አብራሃመ፥ ይሳቃ የሌዳ፤ ይሳቅ፥ ያቆባ የሌዳ፤ ያቆብ፥ ይሁዳነ አ እሻቱዋ የሌዳ። <verse eid="MAT 1:2"/><verse number="3" style="v" sid="MAT 1:3"/>ይሁዳይ ትእማርፐ ፓሬሳነ ዛራሀ የሌዳ፤ ፓሬሰ፥ ሄጽሮና የሌዳ፤ ሄጽሮነ፥ ራማ የሌዳ። <verse eid="MAT 1:3"/><verse number="4" style="v" sid="MAT 1:4"/>ራመ አምናዳባ የሌዳ፤ አምናዳበ፥ ናአሶና የሌዳ፤ ናአሶነ፥ ሰልሞና የሌዳ። <verse eid="MAT 1:4"/><verse number="5" style="v" sid="MAT 1:5"/>ሰልሞነ፥ ራኣቦ ጌተትያ ምሽራትፐ ቦኤዛ የሌዳ፤ ቦኤዝ፥ ኡሩቶ<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="RUT 4:18-22">ኡሩቶ 4:18-22</ref>፤ <ref loc="1CH 2:13-15">1 ኦዱዋ 2:13-15</ref></char></note> ጌተትያ ምሽራትፐ እዮቤዳ የሌዳ፤ እዮቤደ፥ እሰይ የሌዳ። <verse eid="MAT 1:5"/><verse number="6" style="v" sid="MAT 1:6"/>እሰይ ካትያ ዳዊታ የሌዳ።</para>
  <para style="p" vid="MAT 1:6">ካትያ ዳዊተ፥ ኦርያ ማቻትፐ ሶሎሞና የሌዳ። <verse eid="MAT 1:6"/><verse number="7" style="v" sid="MAT 1:7"/>ሶሎሞነ፥ ሮብኣማ የሌዳ፤ ሮብኣመ፥ አብያ የሌዳ፤ አቢ፥ አሳፋ የሌዳ። <verse eid="MAT 1:7"/><verse number="8" style="v" sid="MAT 1:8"/>አሳፈ፥ ዮሳፌጻ የሌዳ፤ ዮሳፌጸ፥ እዮራማ የሌዳ፤ እዮራመ፥ ኦዝያና የሌዳ። <verse eid="MAT 1:8"/><verse number="9" style="v" sid="MAT 1:9"/>ኦዝያነ፥ እዮኣታማ የሌዳ፤ እዮኣታመ፥ አካዛ የሌዳ፤ አካዝ፥ ህዝቂያሳ የሌዳ። <verse eid="MAT 1:9"/><verse number="10" style="v" sid="MAT 1:10"/>ህዝቂያሰ ምናሳ የሌዳ፤ ምናሰ፥ አሞጻ የሌዳ፤ አሞጸ፥ እዮስያሳ የሌዳ። <verse eid="MAT 1:10"/><verse number="11" style="v" sid="MAT 1:11"/>እስራኤልያ አሳይ ኦሞደቲደ፥ ባብሎነ ጋድያ ቤዳ ዎደ፥ እዮስያሰ እኮንያናነ<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">ሄዋ ጉሳይ፥ ዮኣክና ግያዋ፤ ቃይ ፓይዱዋ 12 ደእያዎካ ብለይ እቱዋ።</char></note> አ እሻቱዋ የሌዳ።<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="2KI 24:14-15">2 ካታ. 24:14-15</ref>፤ <ref loc="2CH 36:10">2 ኦዱዋ 36:10</ref>፤ <ref loc="JER 27:20">ኤር. 27:20</ref></char></note><verse eid="MAT 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12"/>ባብሎነ ኦሞዱዋፐ ጉይያን፥ እኮንያናነ ሳላትያላ የሌዳ፤ ሳላትያለ፥ ዘሩባቤላ የሌዳ። <verse eid="MAT 1:12"/><verse number="13" style="v" sid="MAT 1:13"/>ዘሩባቤል፥ አብዩዳ የሌዳ፤ አብዩደ፥ ኤልያቄማ የሌዳ፤ ኤልያቄም፥ አዞራ የሌዳ። <verse eid="MAT 1:13"/><verse number="14" style="v" sid="MAT 1:14"/>አዞረ ሳዶቃ የሌዳ፤ ሳዶቀ፥ አኪማ የሌዳ፤ አኪመ ኤልዩዳ የሌዳ። <verse eid="MAT 1:14"/><verse number="15" style="v" sid="MAT 1:15"/>ኤልዩደ፥ አልኣዛራ የሌዳ፤ አልኣዛረ፥ ማታና የሌዳ፤ ማታነ፥ ያቆባ የሌዳ። <verse eid="MAT 1:15"/><verse number="16" style="v" sid="MAT 1:16"/>ያቆብ፥ ክርስቶሳ ጌተትያ የሱሳ የሌዳ ማይራሞ ኦቼዳ ዮሴፋ የሌዳ።<verse eid="MAT 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17"/>ስም የለታይ ኡባይ አብራሃሞፐ ዳዊታ ጋካናዉ ታማነ ኦይዱ የለታ፤ ዳዊተፐ ዶሚደ፥ አሳይ ባብሎነ ጋድያ ኦሞደቲደ ቤዳ ዎድያ ጋካናዉ ታማነ ኦይዱ የለታ፤ አሳይ ባብሎነ ጋድያ ኦሞደቲደ ቤዳ ዎድያፐ ክርስቶስ<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">ክርስቶሳ፥ ግያዌ ግሪከ ቃላና ግዶደ፥ መስህ ጉሳይ እብራይስጸ ቃላና ግዲደ ላኡዋ ብለይካ “ኦከቴዳዋ” ጉሳ።</char></note> የለቴዳ ዎድያ ጋካናዉ ታማነ ኦይዱ የለታ።<verse eid="MAT 1:17"/></para>
  <para style="s1">የሱስ ክርስቶሳ የለታ</para>
  <para style="r">(<ref loc="LUK 2:1-7">ሉቃሳ 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>የሱስ ክርስቶሳ የለታይ ሀዋ ማላ፤ አ ዳያ ማይራማ ዮሴፎ ኦሸታ ቃሸታ ኡታዱ። ሄ ዎደ ዮሴፎና ጋከተናን ደኣደ፥ ጌሻ አያናን ሻሃራዱ። <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>እዞ ጊግስ ዎዳ ዮሴፎ ጽሎ አሳ<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">ዮሴፎ ጽሎ አሳ ግያ ቆፋዉ ሄዙ ኦግያን ብለይ እመታና ዳንዳዬ: 1. ጾሳባዉ ኡባዉ ኤኖ ጊደ አዛዘትያ አሳ፤ አማልያ ሎኦ አሳ። 2. ጋራ (ቃረታንቻ)። 3. ሎኡዋ። ሄዋ ጉሳይ፥ ኡባ ካላ ሎኦባ ኦያ አሳ ጉሳ።</char></note> ግዴዳ ድራዉ፥ እዞ ካዉሻናዉ ኮይቤና፤ ኢባ ቆንጭሰናን እዞ አጋናዉ ቆፔዳ። <verse eid="MAT 1:19"/><verse number="20" style="v" sid="MAT 1:20"/>ሽን እ ሄዋ ቆፕሽን፥ ጎዳ ኪታንቻይ አኩሙዋን<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">አኩሙዋን ጉሳይ፥ ጮካ ጎኤና አኩሙዋ ግደናዳን አይሁዳቱዋ አኩሙዋ ጉሳይ፥ ጾሳይ ልከ ቆንጭያ ኦግያ።</char></note> አናና ጋከቲደ፥ “ዳዊተ ናኣ ዮሴፎ፥ ማይራማ ጌሻ አያናን ሻሃሬዳ ድራዉ<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">ጌሻ አያናን ሻሃሬዳ ድራዉ፥ ጉሳይ እዛ ሀዋ ጋካናሽን የለታናዳን ናግያ ናአይ፥ ጾሳ ጌሻ አያናፐ ዬ ጉሳ።</char></note> እዞ አካናዉ ያዮፓ። <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>እዛ አቱማ ናኣ የላናዉኑ፤ ኔንካ፥ እ አሳ ናጋራፐ አሽያ ድራዉ አ ሱን የሱሳ ጋደ ጼሳናሳ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="LUK 1:31">ሉቃሳ 1:31</ref></char></note><verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22-23" style="v" sid="MAT 1:22-23"/>ቃይ ጎዳይ ናብያ ባጋና፥ “ወዶራታ ሻሃራናዉኑ፤ ናኣካ የላናዉኑ፤ አ ሱንይካ አማኔላ ጌተታናዋ” ያጌዳዌ ፖለታና ማላ፥ ሀዌ ኡባይ ሃኔዳ፤ “አማኔላ” ያግያዌ፥ “ጾሳይ ኑናና ደኤ” ያግያዋ።<note caller="-" style="x"><char style="xo" closed="false">1:22-23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">ኢሳ. 7:14</ref></char></note><verse eid="MAT 1:22-23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>ዮሴፎ ገምእሹዋፐ ቤጎቲደ፥ ጎዳ ኪታንቻይ ባረና አዛዞዋዳን፥ ማይራሞ ባረ ጎለ አፌዳ። <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>ሽን ናአይ የለታና ጋካናዉ ዮሴፎ እዝኮ ሺቅቤና፤ ቃይ ናኣካ የሱሳ ጊደ ሱንዳ።<note caller="-" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="LUK 2:21">ሉቃሳ 2:21</ref></char></note><verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s1">ዶላሃ ባጋፐ ዬዳ ጾልንትያ ፓይድያ አሳቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>የሱስ ይሁዳ ጋድያን ቤተሌመ ጌተትያ ካታማን ሄሮድሰ ካዉቲደ ደእያ ዎደ የለቴዳ፤ ሄዋፐ ጉይያን፥ ጾልንትያ ፓይድያ አሳይ<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">ጾልንትያ ፓይድያ አሳ ጉሳይ፥ ኤረቴዳ ማራ ብለን ኤራንቻ አሳቱዋ ጉሳ።</char></note> አዋይፊ ዶልያ ባጋፐ የሩሳላመ ዪደ፥ <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>“አይሁዳ ካትያ ግዳናዉ የለቴዳ ናአይ ሀቃን ደኢ? ኑን አዋይፊ ዶልያ ባጋና ከሴዳ አ ጾልንትያ በኢደ፥ አዉ ጎይናናዉ ዬዶ” ያጊደ ኦቼድኖ።<verse eid="MAT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3"/>ካትያ ሄሮድሰ፥ ሄዋ ስሲደ ዳጋሜዳ፤ የሩሳላመን ደእያ አሳይ ኡባይካ ዎዛና ባዬድኖ። <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>ሄሮድሰ ቄሳቱዋ ካፓቱዋ ኡባቱዋነ ሙሴ ህግያ ታማርስያዋንታ ጼሲደ፥ “ክርስቶስ ሀቃን የለታንዴሻ?” ያጊደ ኦቼዳ።<verse eid="MAT 2:4"/></para>
  <para style="p">
    <verse number="5-6" style="v" sid="MAT 2:5-6"/>ኡንቱንቱ ዛሪደ፥ “ይሁዳ ጋድያን ቤተሌመ ካታማን የለታናዋ። ናቢ፥</para>
  <para style="q1" vid="MAT 2:5-6">“ ‘ይሁዳ ጋድያን ደእያ ቤተሌመ፥</para>
  <para style="q2" vid="MAT 2:5-6">ኔን ይሁዳ ጋድያን ደእያ ዎልቃማ ካታማቱዋፐ ላፋካ።</para>
  <para style="q1" vid="MAT 2:5-6">እስራኤልያ ሞድያዌ ኔፐ ከሳናዋ’</para>
  <para style="m" vid="MAT 2:5-6">ጊደ ጻፌዳ” ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">2:5-6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">ሚክ. 5:2</ref></char></note><verse eid="MAT 2:5-6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>ሄዋፐ ካላ፥ ሄሮድሰ አዋይፊ ዶልያ ባጋፐ ዬዳ አሳቱዋ ጌማን ጼሲደ፥ ጾልንቲ ኡንቱንቶ ቤቴዳ ዎድያ ኡንቱንቱፐ ጌሺደ ኤሬዳ። <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>ያቲደ ቤተሌመ ኡንቱንታ የዲደ፥ “ቢደ ናኣ ሎይ ኮይተ፤ አ ደሜዳ ዎደ ታንካ ባደ አዉ ጎይናናዳን፥ ታናካ ኤርስተ” ያጌዳ።<verse eid="MAT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9"/>ኡንቱንቱ ካቲ ጌዳዋ ስስ ቢደ ኦግያን አዋይፊ ዶልያ ባጋና ኡንቱንቱ ካሰ በኤዳ ጾልንትያ በኤድኖ፤ ናአይ ደኢያሳ ጋኪደ ኤቃና ጋካናዉ፥ ጾልንቲ ኡንቱንታ ካለዳ። <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>ኡንቱንቱ ሄ ጾልንትያ በኤዳ ዎደ፥ ዛዋይ ባይና ዳሮ ናሸቻ ናሸቴድኖ። <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>ጎለ ገሊደ፥ ናአይ ባረ ዳይ ማይራምና ደእያዋ በኤድኖ፤ ጉልባቲደ አዉ ጎይኔድኖ፤ ሄዋፐ ካላ፥ ባረንቱ ሳጽንያ ዶዪደ፥ ዎርቃ፥ እጻናነ ካዋራ<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fq" closed="false">እጻናነ ካዋራ፦ </char><char style="ft" closed="false">እጻናይ፥ ማድያ ልያ ግዲደ፥ ታማን የግያ ዎደ ሳዋናሳ፤ ካዋራይካ ሳዎ ማድያ ልያ ግዲደ ሽቱዋዳን ማዴ።</char></note> አዉ እሞታ ሺሼድኖ።<verse eid="MAT 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12"/>ኡንቱንቱ ሄሮድሳኮ ስመና ማላ፥ ጾሳይ አኩሙዋን ኡንቱንታ፥ “ህንተና ኤርተ” ጊና ሀራ ኦግያና ባረንቱ ጋደ ስሜድኖ።<verse eid="MAT 2:12"/></para>
  <para style="s1">ግብጼ በቱሳ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>ኡንቱንቱ ቤዳዋፐ ጉይያን፥ ጎዳ ኪታንቻይ አኩሙዋን ዮሴፎ ቤቲደ፥ “ሄሮድሰ ናኣ ዎናዉ ኮይያ ድራዉ፥ ደንዳደ ናኣነ አ ዳዮ አካደ ግብጼ ጋድያ በታ፤ ታን ነዉ ኦዳና ጋካናዉ፥ ያን ደአሻ” ያጌዳ።<verse eid="MAT 2:13"/></para>
  <para style="p">
    <verse number="14-15" style="v" sid="MAT 2:14-15"/>ዮሴፎ ቃማ ደንዲደ፥ ናኣነ አ ዳዮ አኪደ፥ ግብጼ ጋድያ ቤዳ፤ ጎዳይ ናብያ ባጋና፥ “ታን ታ ናኣ ግብጼ ጋድያፐ ጼሳድ” ያጌዳዌ ፖለታና ማላ፥ ሄሮድሰ ሀይቃና ጋካናዉ እ ያን ደኤዳ።<note caller="-" style="x"><char style="xo" closed="false">2:14-15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">ሆሰ 11:1</ref></char></note><verse eid="MAT 2:14-15"/></para>
  <para style="s1">ሄሮድሰ ቄር ናና ዎሴዳ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>ሄዋፐ ጉይያን፥ ሄሮድሰ አዋይፊ ዶልያ ባጋፐ ዬዳዋንቱ ባረና ጭሜዳዋ ኤሬዳ ዎደ፥ ዳሮ ሀንቀቲደ፥ ጾልንቲ ካሰ ቤቴዳ ዎድያ ኡንቱንቱፐ ስሴዳዋዳን፥ ዎታዳራቱዋ የዲደ፥ ቤተሌመንነ ዩሹዋን ደእያ ላኡ ላይ አቱማ ናናነ ላኡ ላይፐ ጋርሳና ደእያ አቱማ ናና ኡባ ዎሴዳ።<verse eid="MAT 2:16"/></para>
  <para style="p">
    <verse number="17-18" style="v" sid="MAT 2:17-18"/>ናብያ ኤርማስ፥</para>
  <para style="q1" vid="MAT 2:17-18">“ዬኩነ ዝላሳይ ራማ ጌተትያ ካታማን ስሰቴዳ፤</para>
  <para style="q2" vid="MAT 2:17-18">ራሄላ ባረ ናናዉ ዬካዉ።</para>
  <para style="q1" vid="MAT 2:17-18">ኡንቱንቱ ሀይቂድጎ ድራዉ፥</para>
  <para style="q2" vid="MAT 2:17-18">አጋ ጊና፥ አገናን እጻዱ”</para>
  <para style="m" vid="MAT 2:17-18">ጊደ ኦዴዳዌ ፖለቴዳ።<note caller="-" style="x"><char style="xo" closed="false">2:17-18 </char><char style="xt" closed="false"><ref loc="JER 31:15">ኤር. 31:15</ref></char></note><verse eid="MAT 2:17-18"/></para>
  <para style="s1">ግብጼፐ ስማ</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>ሄሮድሰ ሀይቄዳዋፐ ጉይያን፥ ጎዳ ኪታንቻይ ግብጼን ዮሴፎ አኩሙዋን ቤቲደ <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>አ፥ “ደንዳ፤ ናኣነ አ ዳዮ አካደ፥ እስራኤልያ ጋድያ ስማ። ናኣ ዎናዉ ኮይያዋንቱ ሀይቂ ድጌድኖ” ያጌዳ። <verse eid="MAT 2:20"/><verse number="21" style="v" sid="MAT 2:21"/>ዮሴፎ ደንዲደ፥ ናኣነ አ ዳዮ አኪደ፥ እስራኤልያ ስሜዳ።<verse eid="MAT 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22"/>ሽን ዮሴፎ አርከላዎስ ባረ አዉዋ ሄሮድሳ ኦይድያን ይሁዳ ጋድያን ካዉቴዳዋ ስሴዳ ዎደ፥ ያ ባናዉ ያዬዳ፤ ጾሳይ አዉ አኩሙዋን ህንተና ኤርተ ጊና፥ ጋሊላ ጋድያ ቤዳ። <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>ናባቱ፥ “አሳይ አ፥ ‘ናዝሬትያ አሳ’<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">ሀዋ ጌዳዌ ኦነንቶ ኤረተና።</char></note> ጊደ ጼሳና” ያጌዳዌ ፖለታና ማላ፥ ናዝሬተ ጌተትያ ካታማ ቢደ ደኤዳ።<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MRK 1:24">ማር. 1:24</ref>፤ <ref loc="LUK 2:39">ሉቃሳ 2:39</ref>፤ <ref loc="JHN 1:45">ዮሃ. 1:45</ref></char></note><verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s1">ጻማቅያ ዮሃንስ ቃላ ኦዴዳ</para>
  <para style="r">(<ref loc="MRK 1:1-8">ማር. 1:1-8</ref>፤ <ref loc="LUK 3:1-18">ሉቃሳ 3:1-18</ref>፤ <ref loc="JHN 1:19-28">ዮሃ. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1-2" style="v" sid="MAT 3:1-2"/>ሄ ዎደ ጻማቅያ ዮሃንስ አሳ፥ “ሳሉዋ ካዉተይ ማታቴዳ ድራዉ፥ ህንተ ናጋራፐ ስምተ” ያጊደ፥ ይሁዳ መላ ቢታን ኦዲደ ዬዳ።<note caller="-" style="x"><char style="xo" closed="false">3:1-2 </char><char style="xt" closed="false"><ref loc="MAT 4:17">ማቶሳ 4:17</ref>፤ <ref loc="MRK 1:15">ማር. 1:15</ref></char></note> <verse eid="MAT 3:1-2"/><verse number="3" style="v" sid="MAT 3:3"/>አያዉ ጎፐ፥ ናብያ ኢስያሰ፥ ዮሃንሳባ ኦዲደ፥</para>
  <para style="q1" vid="MAT 3:3">“እቱ መላ ቢታን ባረ ቃላ ቁ ኦደ፥</para>
  <para style="q2" vid="MAT 3:3">‘ጎዳ ኦግያ ጊግስተ።</para>
  <para style="q1" vid="MAT 3:3">እ ሄመታና ሎሱዋካ</para>
  <para style="q2" vid="MAT 3:3">አዉ ስት ኦተ’ ጌዳ”</para>
  <para style="m" vid="MAT 3:3">ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">ኢሳ. 40:3</ref></char></note><verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>ዮሃንሳዉ ጋሉዋ እስክያ ዳደቴዳ ማዩ ደኤ፤ ቃይ ባረ ጼሳን ዳፉዋ ዳንጬዳ፤ እ ምያ ቁማይካ ቦልያነ ባዙዋ ኤሳ።<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="1KI 1:8">1 ካታ. 1:8</ref></char></note> <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>አሳይ ሄ ዎደ የሩሳላመፐ፥ ይሁዳ ጋድያ ኡባ ሳፐነ ዮርዳኖሳ ሻፋ ሄራን ደእያ ጋድያ ኡባፐ አኮ ዪኖ። <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>ባረንቱ ናጋራ ፓጽና፥ ዮርዳኖሳ ሻፋን አሳ ጻማቄዳ።<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>ሽን ዮሃንስ ዳሮ ፓርሳዋቱነ<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="fqa" closed="false">ፓርሳዋቱዋ፦ </char><char style="ft" closed="false">ጉሳይ አይሁዳ አሳቱዋ ካለያ አሳቱዋ ግዶፐ ግዲደ ጌሻ ቃላን ካሰ ኤጫ ጫቁዋ ግዶን ደእያ ቃላ ዎጋ ኡባን አማንያዋንታ።</char></note> ሳዱቃዋናቱ<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="fqa" closed="false">ሳዱቃዋናቱዋ፦ </char><char style="ft" closed="false">ጉሳይ አይሁዳ አሳቱዋ ካለያ አሳቱዋ ግዶፐ ግዲደ ጌሻ ቃላን ካሰ ኤጫ ጫቁዋ ግዶን ደእያ ቃላ ዎጋፐ ሙሴ ጻፌዳ ኮይሮ እቼሹ ማጻፋቱዋ ግዶን ደእያ ዎጋቱዋ ጻላላን አማንያዋንታ።</char></note> ጻማቀታናዉ ባረኮ ይያዋንታ በኢደ፥ “ሀ ሾሻቶ፥ ጾሳ ሀንቁ ያና ሀንያዋፐ አታና ማላ፥ ህንተዉ ኦኔ ኦዴዳዌ? <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>ስም ህንተ፥ ህንተንቱ ናጋራፐ ስሜዳዋ ኤርስያ ኦሱዋ፥ ኦተ። <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>ህንተ ህንተንቱ ዎዛናን፥ ‘አብራሃመ ኑ አባ’ ጊደ ቆፕያዋ ህንተዉ ማላቶፖ። አያዉ ጎፐ፥ ታን ህንተንቶ ኦዳይ፤ ጾሳይ ሀ ሹቻቱዋፐ አብራሃሞ ናና ኦ ደንናዉ ዳንዳዬ። <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>ቤጽ ም ጻጱዋን ቃንጻናዉ ጊግ ኡቴዳ፤ ሎኦ አይፍያ አይፈና ም ኡባይ ቃንጸቲደ፥ ታማን የገታና።<verse eid="MAT 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11"/>“ህንተ ህንተንቱ ናጋራፐ ስምያዋ በሳናዉ፥ ታን ህንተና ሃን ጻማቃይ፤ ሽን ታፐ ጉየና ይያዌ፥ ህንተንታ ጌሻ አያናንነ ታማን ጻማቃና።<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="fq" closed="false">ጌሻ አያናንነ ታማን ጻማቃና፥ </char><char style="ft" closed="false">ጉሳይ የሱስ ዪደ አሳ ጋርሳ አያና አሳተ ላምያዋ ታማርስያዋ።</char></note> እ ታፐ ዳሮ ምኔ፤ አ ጫማ ቶካናዉካ ታን በስያ አሳ ግድከ። <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>አ ኩሽያን ካ ሰጽያ ላይዳይ ደኤ። ኡዱማን ደእያ ካ ሎይ ጌሼ፤ ባረ ዛርጋ ድይያን ቆላና፤ ሽን ዳላ ቶኤና ታማን ጉዳና” ያጌዳ።<verse eid="MAT 3:12"/></para>
  <para style="s1">የሱስ ጻማቀቴዳ</para>
  <para style="r">(<ref loc="MRK 1:9-11">ማር. 1:9-11</ref>፤ <ref loc="LUK 3:21-22">ሉቃሳ 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>የሱስ ሄ ዎደ ዮሃንሳን ጻማቀታናዉ፥ ጋሊላፐ ዮርዳኖሳ ጌተትያ ሻፋ አኮ ቤዳ። <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>ሽን ዮሃንስ፥ “ታን ኔናን ጻማቀታናዉ በስያ ዎደ፥ ኔን ታኮ ያይ?” ያጊደ፥ አ ድጋናዉ ኮዬዳ።<verse eid="MAT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15"/>ሽን የሱስ ዛሪደ አ፥ “ኑን ጽሎተ ኦሱዋ ኡባ ሀዋዳን ፖላናዉ በስያ ድራዉ፥ ሀእ ታዉ ኤኖ ጋ” ያጌዳ። ዮሃንስካ አዉ ኤኖ ጌዳ።<verse eid="MAT 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16"/>የሱስ ጻማቀቶዋፐ ጉይያን፥ ኤለካ ሃፐ ከሴዳ፤ ሳሉ ዶየትና፥ ጾሳ አያናይ ሀራጵያዳን ሳሉዋፐ ዎደ ባረ ቦላ ይያ ዎደ በኤዳ፤ <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>ቃይ ሳሉዋፐ፥ “ታን ሲቅያ፥ ታና ናሸችያ፥ ታ ናአይ ሀዋ” ያግያ ቃላይ ዬዳ።<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="GEN 22:2">ዶመ 22:2</ref>፤ <ref loc="PSA 2:7">ማዝ. 2:7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42:1</ref>፤ <ref loc="MAT 12:18">ማቶሳ 12:18</ref>፤ <ref loc="MAT 17:5">17:5</ref>፤ <ref loc="MRK 1:11">ማር. 1:11</ref>፤ <ref loc="LUK 9:35">ሉቃሳ 9:35</ref></char></note><verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s1">የሱስ ፓጨቴዳ</para>
  <para style="r">(<ref loc="MRK 1:12-13">ማር. 1:12-13</ref>፤ <ref loc="LUK 4:1-13">ሉቃሳ 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>ሄዋፐ ጉይያን፥ ጻላህያን ፓጨታና ማላ፥ ጌሻ አያናይ አሳይ ደኤና ሳኣ የሱሳ አፌዳ። <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>የሱስ ኦይታሙ ጋላሳነ ኦይታሙ ቃማ ጾሞዋፐ ጉይያን ኮሻቴዳ። <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>ጻላሂ ዪደ አ፥ “ኔን ጾሳ ናኣ ግዶፐ፥ አነ ሀ ሹቻቱዋ ኡክ ግዳና ማላ ጋ” ያጌዳ።<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>ሽን የሱስ ዛሪደ፥ “ጾሳ ማጻፋን፥ ‘አሳይ ጾሳይ ሃሳይያ ቃላ ኡባን ደአናፐ አትን፥ ኡክ ጻላላን ደኤና’ ያገት ጻፈቴዳ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">ዛረ. 8:3</ref></char></note><verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>ሄዋፐ ጉይያን፥ ጻላሂ የሱሳ ጌሻ ካታማ አፍ ጌሻ ጎልያ ጼራን ኤሲደ፥ <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>“ኔን ጾሳ ናኣ ግዶፐ፥ አነ ዱገ ኩንዳ። አያዉ ጎፐ፥ ጾሳ ማጻፋን፥</para>
  <para style="q1" vid="MAT 4:6">“ ‘ጾሳይ ባረ ኪታንቻቱዋ</para>
  <para style="q2" vid="MAT 4:6">ነዉ አዛዛናዋ’</para>
  <para style="q2" vid="MAT 4:6">ቃይ ‘ኡንቱንቱ ነ ገዲ ሹቻን በተና ማላ፥</para>
  <para style="q2" vid="MAT 4:6">ባረንቱ ኩሽያን ኔና ደንናዋንታ’</para>
  <para style="m" vid="MAT 4:6">ያገት ጻፈቴዳ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">ማዝ. 91:11-12</ref></char></note><verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>የሱስ ዛሪደ አ፥ “ቃይካ ጾሳ ማጻፋን፥ ‘ጎዳ ነ ጾሳ ፓጮፓ’ ያገት ጻፈቴዳ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">ዛረ. 6:16</ref></char></note><verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>ቃይ ጻላሂ የሱሳ እት ዳሮ ዎልቃማ ደርያ ጼራ ከሲደ፥ ሀ አላምያን ደእያ ካዉተ ኡባነ ኡንቱንቱ ቦንቹዋ <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>በሲደ አ፥ “ኔን ታዉ ጉልባታደ ጎይኖፐ፥ ታን ሀዋ ኡባ ነዉ እማና” ያጌዳ።<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>ሄ ዎደ የሱስ ዛሪደ አ፥ “ላ ሀ ሴጻናዉ ሃካ፤ አያዉ ጎፐ፥ ጾሳ ማጻፋን፥ ‘ጎዳዉ፥ ነ ጾሳዉ ጎይና፤ አ ጻላላ ጎሸታ’ ጌተት ጻፈቴዳ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">ዛረ. 6:13</ref></char></note><verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>ሄዋፐ ጉይያን፥ ጻላሂ የሱሳ አግና፥ ኪታንቻቱ ዪደ፥ አዉ ኦድኖ።<verse eid="MAT 4:11"/></para>
  <para style="s1">የሱስ ባረ ታማርስያ ኦሱዋ ጋሊላን ዶሜዳ</para>
  <para style="r">(<ref loc="MRK 1:14-15">ማር. 1:14-15</ref>፤ <ref loc="LUK 4:14-15">ሉቃሳ 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>ዮሃንስ ቃሸቴዳዋ የሱስ ስሴዳ ዎደ፥ ጋሊላ ጌተትያ ጋድያ ቤዳ። <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>ናዝሬተፐ ከሲደ፥ ቅፍርናሆማ ካታማ ቢደ፥ ያን ደኤዳ፤ ቅፍርናሆም ዛብሎናንነ ንፍታሌመ ጋድያን ደእያ ጋሊላ አባ ማታን ደኤ። <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>ሀዌ ሀኔዳዌ ናብያ ኢስያስ፥<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>“ዛብሎነ ጋድያንነ ንፍታሌመ ጋድያን፥</para>
  <para style="q2" vid="MAT 4:15">አባ ኦግያን ዮርዳኖሳ ሻፋፐ ሄፍን ባጋን፥</para>
  <para style="q1" vid="MAT 4:15">አይሁዳ ግደና አሳይ ደእያ ጋሊላን፥<verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>ማን ደእያ አሳይ፥</para>
  <para style="q2" vid="MAT 4:16">ዎልቃማ ፖኡዋ በኤዳ።</para>
  <para style="q1" vid="MAT 4:16">ቃይ ሀይቁዋ ኩዋይ ደእያ ጋድያን ኡቴዳዋንቶ</para>
  <para style="q2" vid="MAT 4:16">ፖኡ ከሴዳ”</para>
  <para style="m" vid="MAT 4:16">ያጌዳዌ ፖለታና ማላሳ።<note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">ኢሳ. 9:1-2</ref></char></note><verse eid="MAT 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 4:17"/>ሄ ዎድያፐ ዶሚደ የሱስ፥</para>
  <para style="q2" vid="MAT 4:17">“ህንተ ናጋራ ፓጽተ፤ አያዉ ጎፐ፥</para>
  <para style="q2" vid="MAT 4:17">ሳሉዋ ካዉተይ ማታቴዳ ድራሳ”</para>
  <para style="m" vid="MAT 4:17">ጊደ ቃላ ኦዱዋ ዶሜዳ።<verse eid="MAT 4:17"/></para>
  <para style="s1">የሱስ ባረና ካልያ ኦይዳቱዋ ጼጌዳ</para>
  <para style="r">(<ref loc="MRK 1:16-20">ማር. 1:16-20</ref>፤ <ref loc="LUK 5:1-11">ሉቃሳ 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>የሱስ ጋሊላ አባ ማታና አደ፥ ላኡ እሻቱ ጰጽሮሳ ጌተትያ ስሞንነ አ እሻ እንድራስ፥ ሞልያ ኦይቂያዋንታ ግዶ ድራዉ፥ ዳባ<note caller="+" style="f"><char style="fr" closed="false">4:18 </char><char style="fk" closed="false">ዳባ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ ሞልያ ጲራናዉ ዎይ ኦይቃናዉ ሃን የግያ አማራዋን ማራብያ ግያዋ።</char></note> አባን የግያዋንታ በኤዳ። <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>ኡንቱንታ፥ “ታና ካልተ፤ ታን ህንተና ሞልያ ኦይቂያዋዳን አሳ ታኮ አህያ ኦግያ ታማርሳና” ያጌዳ። <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>ኡንቱንቱ ኤለካ ባረንቱ ዳባ አጊደ፥ የሱሳ ካሌድኖ።<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>የሱስ ሄዋፐ ስንኮ ቢደ፥ ሀራ ላኡ እሻቱዋ፥ ዛብድዮሳ ናና ያቆባነ አ እሻ ዮሃንሳ በኤዳ፤ ኡንቱንቱ ባረንቱ አዉዋ ዛብድዮሳና ሃ ቦላን ብያ ዎንግርያ ግዶን ባረንቱ ዳባ ጊግስያዋንታ በኢደ፥ ጼሴዳ። <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>ኡንቱንቱ ኤለካ ሃን ብያ ዎንግርያነ ባረንቱ አዉዋ አጊደ፥ የሱሳ ካሌድኖ።<verse eid="MAT 4:22"/></para>
  <para style="s1">የሱስ ጮራ አሳ ታማርሴዳነ ፓዳ</para>
  <para style="r">(<ref loc="LUK 6:17-19">ሉቃሳ 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>የሱስ አይሁዳ ዎሳ ጎለቱዋን ታማርሲደ፥ ካዉተ ምሽራቹዋ ቃላ ኦዲድነ ቃይ ሀርግያ ኡባፐነ ሳኩዋ ኡባፐ አሳ ፓደ፥ ጋሊላ ጋድያ ኡባን ዩዬዳ። <verse eid="MAT 4:23"/><verse number="24" style="v" sid="MAT 4:24"/>አ ዋሪ ሶርያ ጋድያ ኡባ ጋኬዳ፤ ዱማ ዱማ ሀርግያን ኦይቀቲደ ሀርጌዳ አሳ ኡባ፥ ጻላሀቱዋን ኦይቀቴዳዋንታ፥ ዪጩዋ ሳኩ ደእያዋንታ፥ ቃይ ጉንዴዳዋንታ አሳይ የሱሳኮ አሄዳ፤ እ ኡንቱንታ ፓዳ። <verse eid="MAT 4:24"/><verse number="25" style="v" sid="MAT 4:25"/>ጮራ አሳይ ጋሊላፐ፥ ታሙ ካታማቱዋፐ፥ የሩሳላመፐ፥ ይሁዳፐነ ዮርዳኖሳፐ ሄፍንን ደእያ ጋድያፐ የሱሳ ካሌድኖ።<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s1">የሱስ ደርያ ቦላን ግዲደ ታማርሴዳ ትምርትያ</para>
  <para style="r">(<ref loc="MAT 5:1-7:29">5:1—7:29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>የሱስ ጮራ አሳ በኢደ፥ ፑደ ደርያ ከሲደ ኡቴዳ። አ ካልያዋንቱ አኮ ሺቄድኖ። <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>ኡንቱንታ ሀዋዳን ያግ ታማርሱዋ ዶሜዳ።<verse eid="MAT 5:2"/></para>
  <para style="s1">ቱሙ አንጁዋ አክያ አሳቱዋ</para>
  <para style="r">(<ref loc="LUK 6:20-23">ሉቃሳ 6:20-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3"/>“ባረንቱ አያና ደኡዋን፥</para>
  <para style="q2" vid="MAT 5:3">ህዬሳ ግዴዳዋ ኤርያዋንቱ አንጀቴዳዋንታ፤</para>
  <para style="q2" vid="MAT 5:3">አያዉ ጎፐ፥ ሳሉዋ ካዉተይ ኡንቱንቱሳ።<verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>ካዮትያዋንቱ አንጀቴዳዋንታ፤</para>
  <para style="q2" vid="MAT 5:4">አያዉ ጎፐ፥ ጾሳይ ኡንቱንታ ምንሳና።<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="ISA 61:2">ኢሳ. 61:2</ref></char></note><verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>አሽከ ግዴዳዋንቱ አንጀቴዳዋንታ፤</para>
  <para style="q2" vid="MAT 5:5">አያዉ ጎፐ፥</para>
  <para style="q2" vid="MAT 5:5">ኡንቱንቱ ሳኣ ላታና።<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 37:11">ማዝ. 37:11</ref></char></note><verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>ጽሎተ ኮሻትያዋንቱነ ሳመትያዋንቱ፥<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">ሀዋ ብለይ ጾሳዉ ኤኖ ግያዋንታ ዎይ ሎኦባ ዎይ ቱሞባ ኦያዋንታ ጉሳ።</char></note></para>
  <para style="q2" vid="MAT 5:6">አንጀቴዳዋንታ፤</para>
  <para style="q2" vid="MAT 5:6">አያዉ ጎፐ፥ ጾሳይ ኡንቱንታ ካልሳና።<verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>ማርያዋንቱ አንጀቴዳዋንታ፤</para>
  <para style="q2" vid="MAT 5:7">አያዉ ጎፐ፥</para>
  <para style="q1" vid="MAT 5:7">ጾሳይ ኡንቱንታ ማራና።<verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>ዎዛና ጌሻቱ አንጀቴዳዋንታ፤</para>
  <para style="q2" vid="MAT 5:8">አያዉ ጎፐ፥</para>
  <para style="q2" vid="MAT 5:8">ኡንቱንቱ ጾሳ በአና።<verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>አሳ ስገያዋንቱ አንጀቴዳዋንታ፤</para>
  <para style="q2" vid="MAT 5:9">አያዉ ጎፐ፥ ጾሳይ ኡንቱንታ፥</para>
  <para style="q2" vid="MAT 5:9">ባረ ናና ጊደ ጼሳና።<verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>ጽሎተ ድራዉ፥</para>
  <para style="q2" vid="MAT 5:10">የደርሰትያዋንቱ አንጀቴዳዋንታ፤</para>
  <para style="q2" vid="MAT 5:10">አያዉ ጎፐ፥ ሳሉዋ ካዉተይ ኡንቱንቱሳ።<note caller="+" style="f"><char style="fr" closed="false">5:10</char><char style="fk" closed="false">ሳሉዋ ካዉተይ ኡንቱንቱሳ፦ </char><char style="ft" closed="false">ጉሳይ ሄ አሳቱ ሳሉዋ ካዉተ ላታናዉ ዳንዳይያዋንታ ግድያዋ በሴ።</char></note><verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>“ህንተ ታና ካልያ ድራዉ፥ አሳይ ህንተና ቦርያ ዎደነ ዋይስያ ዎደ፥ ቃይ ህንተ ቦላ ኢታባ ኡባ ዎርዱዋን ሃሳይያ ዎደ፥ ህንተ አንጀቴዳዋንታ። <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/>ህንተዉ ሳሉዋን ዎልቃማ ዎይታይ ደእያ ድራዉ፥ ናሸትተ፤ ሀሹ ጊተ፤ አያዉ ጎፐ፥ አሳይ ህንተፐ ካሰ ደኤዳ ናባቱዋ ሄዋዳን የደርሴድኖ።<verse eid="MAT 5:12"/></para>
  <para style="s1">ማጽንያነ ፖኡዋ ሌምሱዋ</para>
  <para style="r">(<ref loc="MRK 9:50">ማር. 9:50</ref>፤ <ref loc="LUK 14:34-35">ሉቃሳ 14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>“አሳ ኡባዉ ህንተ ማጽነ ማላ፤ ሽን ማጽኒ ማልአና ዮፐ፥ ዛሪደ አ ዎት ማልኤኔ? ካረ ኦልና፥ አሳይ አ የ ሀመታናፐ አትን፥ ስንዉ አይነ ማደና።<verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>“ሀ አላመዉ ህንተ ፖኦ፤ ደርያ ሁጲያን ኬጸቴዳ ካታማይ ጌማና ዳንዳየና። <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>ጾምፕያ ጾምፒደ፥ ሶይን ደእያ አሳ ኡባዉ ፖአና ማላ፥ ቂያ ሳን ዎፐ አትን፥ ካምያ ሚሻ ግዶን ቁምእ ዎያ አሳይ ኦንነ ባዋ። <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>ሄዋዳንካ፥ አሳይ ህንተ ኦያ ሎኦ ኦሱዋ በኢደ፥ ሳሉዋን ደእያ ህንተ አዉዋ ቦንቻና ማላ፥ ህንተ ፖኡ አሳ ስንን ፖኦ።<verse eid="MAT 5:16"/></para>
  <para style="s1">ሙሴ ህግያባ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>“ታን ሙሴ ህግያነ ናባቱ ታማርስያዋ<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="fq" closed="false">ሙሴ ህግያነ ናባቱ ታማርስያዋ፦ </char><char style="ft" closed="false">ጉሳይ አይሁድያ ጌሻ ማጻፋ፤ ሄዌኔካ ኤጫ ጫቁዋ።</char></note> ይሳናዉ ዬዳዋ ህንተዉ ማላቶፖ፤ ታን ፖላናዉ ዬዳዋፐ አትን፥ ይሳናዉ ያበይከ። <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>አያዉ ጎፐ፥ ታን ህንተዉ ቱሙዋ ኦዳይ፤ ሳሉነ ሳአይ አና ጋካናዉ፥ ቃይ ኡባባይካ ፖለታና ጋካናዉ፥<note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="fk" closed="false">ኡባባይካ ፖለታና ጋካናዉ፦ </char><char style="ft" closed="false">ጉሳይ ቃላይ ታማርስያ ኡባይ ቱማተን ቆንጫና ጋካናዉ።</char></note> ህግያፐ እት ጫቻይካ ዎይ ቄር ፕዶሊካ አና። <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>ሄዋ ድራዉ፥ ሀ አዛዙዋ ኡባፐ ጉጽያ እት አዛዙዋ መንያ ኡራይ ኦንነ፥ ቃይ ሀራቱካ ባረዋዳን ሀናናዳን ታማርስያ ኡራይ ኦንነ፥ ሳሉዋ ካዉተን ኡባፐ ጉ ግዳና፤ ሽን አዛዙዋ ኦያዌነ ሀራንቱካ ኦናዳን ታማርስያዌ ኦንነ ሳሉዋ ካዉተን ቃ ግዳና። <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>አያዉ ጎፐ፥ ህንተ ጽሎተይ ሙሴ ህግያ ታማርስያዋንቱ ጽሎተፐነ ፓርሳዋቱዋ ጽሎተፐ ዳራና ዮፐ፥ ሳሉዋ ካዉተ ህንተ ሙለ ገለናዋ ታን ኦዳይ።<verse eid="MAT 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>“በን አሳዉ፥ ‘አሳ ዎፓ፤ አሳ ዎዳ ኦንነ ፕርደታና’ ጌዳዋ ስሴድታ።<note caller="-" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="EXO 20:13">ከሳ 20:13</ref>፤ <ref loc="DEU 5:17">ዛረ. 5:17</ref></char></note> <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>ሽን ታን ህንተዉ ኦዳይ፤ ባረ እሻ ሀንቀትያ ኡባይ ፕርደታና፤ ባረ እሻ ቦርያ ኡባይ ሻንጉዋ ፕርዳዉ ሺቃና፤ ቃይ ባረ እሻ፥ ‘ሎዌ’ ግያ ኡባይ ጋናምያ ታማ ፕርዳዉ ሺቃና። <verse eid="MAT 5:22"/><verse number="23" style="v" sid="MAT 5:23"/>ሄዋ ድራዉ፥ ኔን ያርሽያሳን ያርሽሽን፥ ነ እሻ ናቄዳባይ ነዉ ሄዋን ሀሳየቶፐ፥ <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>ነ ያርሹዋ ሄዋን አጋደ ባ፤ ካሰታደ ነ እሻና ስገታ ድጋ፤ ሄዋፐ ካላ ያደ፥ ነ ያርሹዋ ያርሻ።<verse eid="MAT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25"/>“ኔና ሞትያዋና ዎዲ ደእሽን ኤለ አናና ስገታ ድጋ፤ ሄዌ ዮፐ፥ እ ኔና ዳና ስን አና፤ ቃይ ዳናይ ኔና ፖልሰዉ አ እምና፥ ፖልሲ ኔና ቃሾ ጎለን የጋና። <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>ታን ነዉ ቱሙዋ ኦዳይ፤ ኔን እት ሳንትሚ አተናን፥ ነ ማጋጩዋ ዉርሳደ ጭጋና ጋካናዉ፥ ሙለካ ቃሾ ጎለፐ ከሳካ።<verse eid="MAT 5:26"/></para>
  <para style="s1">ዎሹማባዉ እመቶ ትምርትያ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>“ ‘ዎሹሞፓ’ ጌዳዋ ስሴድታ።<note caller="-" style="x"><char style="xo" closed="false">5:27 </char><char style="xt" closed="false"><ref loc="EXO 20:14">ከሳ 20:14</ref>፤ <ref loc="DEU 5:18">ዛረ. 5:18</ref></char></note> <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>ሽን ታን ህንተዉ ያጋይ፤ ‘ማጫዉኖ ጼሊደ አሞትያ ኡባይ፥ ባረ ዎዛና ግዶን ሄ ዎደ ኢናና ዎሹሜዳ።’ <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>ነ ኡሸቻ አይፊ ኔና ናጋራ ኦስሶፐ፥ ኔፐ ዎጫደ ኦላ አጋ፤ አያዉ ጎፐ፥ ነ ቦላይ ሙለካ ጋናምያ ታማን ኦለትያዋፐ፥ አፐ እቱ ፓጭንቶ ነዉ ሎአ።<note caller="-" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">ማቶሳ 18:9</ref>፤ <ref loc="MRK 9:47">ማር. 9:47</ref></char></note> <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>ቃይ ነ ኡሸቻ ኩሺ ኔና ናጋራ ኦስሶፐ፥ ኔፐ ቃንጻደ ኦላ አጋ፤ አያዉ ጎፐ፥ ነ ቦላይ ሙለካ ጋናምያ ታማን ኦለትያዋፐ፥ አፐ እቱ ፓጭንቶ ነዉ ሎአ።<verse eid="MAT 5:30"/></para>
  <para style="s1">ማችያ የደናዳን እመቶ ትምርትያ</para>
  <para style="r">(<ref loc="MAT 19:9">ማቶሳ 19:9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10:11-12</ref>፤ <ref loc="LUK 16:18">ሉቃሳ 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>“ ‘ቃይ ባረ ማቻቶ የድያ ኦንነ እዞ የድያ ፓራማ እሞ’ ጌተቴዳ።<note caller="-" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">ዛረ. 24:1-4</ref>፤ <ref loc="MAT 19:7">ማቶሳ 19:7</ref>፤ <ref loc="MRK 10:4">ማር. 10:4</ref></char></note> <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>ሽን ታን ህንተዉ ያጋይ፤ ‘ባረ ማቻታ ዎሹመናን ደእሽን የድያ ኦንነ እዞ ዎሹማ ከሴ፤ ቃይ አስናይ የዴዳ ምሽራቶ አክያዌ ኦንነ ዎሹሜ።’<note caller="-" style="x"><char style="xo" closed="false">5:32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">ማቶሳ 19:9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10:11-12</ref>፤ <ref loc="LUK 16:18">ሉቃሳ 16:18</ref>፤ <ref loc="1CO 7:10-11">1 ቆሮ. 7:10-11</ref></char></note><verse eid="MAT 5:32"/></para>
  <para style="s1">ጫቀናዳን እመቶ ትምርትያ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>“ቃይ በን አሳዉ፥ ‘ዎርዱዋን ጫቆፓ፤ ሽን ነ ጎዳዉ ጫቄዳዋ ፖላ’ ጌዳዋ ስሴድታ።<note caller="-" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="LEV 19:12">ዎጋ 19:12</ref>፤ <ref loc="NUM 30:2">ፓይ. 30:2</ref>፤ <ref loc="DEU 23:21">ዛረ. 23:21</ref></char></note> <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>ሽን ታን ህንተዉ ያጋይ፤ ‘ኡባካ ጫቆፕተ’፤ ሳሉ ጾሳ ካዉተ ኦይድያ ግድያ ድራዉ፥ ‘ሳሉዋን ጫቆፕተ’ <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>ቃይ ሳአይ አ ገዲ የያ ሳ ግድያ ድራዉ፥ ‘ሳኣን ጫቆፕተ’፤ ቃይካ፥ የሩሳላመ ዎልቃማ ካትያ ካታማ ግድያ ድራዉ፥ ‘የሩሳላመንካ ጫቆፕተ’<note caller="-" style="x"><char style="xo" closed="false">5:35 </char><char style="xt" closed="false"><ref loc="ISA 66:1">ኢሳ. 66:1</ref>፤ <ref loc="PSA 48:2">ማዝ. 48:2</ref></char></note> <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>ኔን እት ብናናካ ቦ ዎይ ካረ ከሳናዉ ዳንዳየና ድራዉ፥ ‘ነ ሁጲያንካ ጫቆፓ።’ <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>ሽን ህንተ፥ ‘ኤ’ ዎይ፥ ‘ግደና’ ጊተ፤ ሀዋንቱፐ ሀራይ ሴጻናፐ ዬ።<verse eid="MAT 5:37"/></para>
  <para style="s1">ኢታ ኢታን ዛረናዳን እመቶ ትምርትያ</para>
  <para style="r">(<ref loc="LUK 6:29-30">ሉቃሳ 6:29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>“ ‘አይፍያ ድራዉ አይፍያ፤ አቻ ድራዉ አቻ’ ጌዳዋ ስሴድታ።<note caller="-" style="x"><char style="xo" closed="false">5:38 </char><char style="xt" closed="false"><ref loc="EXO 21:24">ከሳ 21:24</ref>፤ <ref loc="LEV 24:20">ዎጋ 24:20</ref>፤ <ref loc="DEU 19:21">ዛረ. 19:21</ref></char></note> <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>ሽን ታን ህንተዉ ያጋይ፤ ‘ህንተዉ ኢታባ ኦያ ኡራዉ ኢታን ዛሮፕተ፤ ኦንነ ነ ኡሸቻ ባጋ ሻይያ ባቆፐ፥ ነ ሀድርሳ ባጋ ሻይያካ አ በሳ፤ <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>ነ ሻምጭያ አካናዉ እት ኡራይ ኔና ሞቶፐ፥ ሄ ኡራዉ ነ ኮትያካ ጉጃ እማ። <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>ኦንነ ኔና እት ሳትያ ኦግያ ባረናና ባናዳን ዎልቃንፐ፥ አናና ላኡ ሳትያ ኦግያ ባ። <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>ኔና ዎስያ ኡራዉ እማ፤ ቃይ ኔፐ ታልአና ኮይያ ኡራዉካ ድጎፓ።’<verse eid="MAT 5:42"/></para>
  <para style="s1">ሞርክያ ሲቃና ማላ እመቶ ትምርትያ</para>
  <para style="r">(<ref loc="LUK 6:27-36">ሉቃሳ 6:27-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>“ ‘ነ ላገቱዋ ሲቃ፤ ነ ሞርክያ ሞርካ’ ጌዳዋ ስሴድታ።<note caller="-" style="x"><char style="xo" closed="false">5:43 </char><char style="xt" closed="false"><ref loc="EXO 19:18">ከሳ 19:18</ref></char></note> <verse eid="MAT 5:43"/><verse number="44-45" style="v" sid="MAT 5:44-45"/>ሽን ታን ህንተዉ ያጋይ፤ ሳሉዋን ደእያ ህንተ አዎ ናና ግዳና ማላ፥ ህንተ ሞርከቱዋ ሲቅተ፤ ህንተና ሸቂያዋንታ አንጅተ፤ ህንተና እጽያዋንቶ ሎኦባ ኦተ፤ ህንተና የደርስያዋንቶ፥ ጾሳ ዎስተ፤ አያዉ ጎፐ፥ ኢታ አሳዉካ ሎኦ አሳዉካ ጾሳይ ባረ አዋ አዋጽሴ፤ ቃይ ጽላቶካ ናጋራንቻቶካ ባረ እራ ቡክሴ። <verse eid="MAT 5:44-45"/><verse number="46" style="v" sid="MAT 5:46"/>ህንተ ህንተና ሲቅያዋንቱ ጻላላ ሲቆፐ፥ ህንተዉ አይ ዎይታይ ደኢ? ሀራይ አቶ፥ ናጋራንቻቱካ ሄዋዳን ኦኖ። <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>ህንተ ህንተንቱ እሻቱዋ ጻላላ ሳሮቶፐ፥ ሀራቱ ኦያዋፐ አያባ አያ ኦድቴ? ሀራይ አቶ፥ አይሁደ ግደና አሳይካ ሄዋዳን ኦ። <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>ሄዋ ድራዉ፥ ሳሉዋን ደእያ ህንተ አዉ ፖሎ ግዶዋዳን፥ ህንተካ ፖሎ ግድተ።<note caller="-" style="x"><char style="xo" closed="false">5:48 </char><char style="xt" closed="false"><ref loc="EXO 19:2">ከሳ 19:2</ref>፤ <ref loc="DEU 18:13">ዛረ. 18:13</ref></char></note><verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s1">ህዬሳዉ እምያ ማራ ታማርሱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>“ህንተ ሎኦ ኦሱዋ አሳ በሳናዉ አሳ ስንን ኦና ማላ ናገትተ፤ ሄዌ ዮፐ፥ ሳሉዋን ደእያ ህንተ አዉ ህንተዉ ጋትያ እመና።<verse eid="MAT 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2"/>“ሄዋ ድራዉ፥ ህንተ አዉደነ ህዬሳዉ እምያ ዎደ፥ ሎአ ማላትያ ኢታቱ ባረንታ ቦንችሳናዉ፥ አይሁዳ ዎሳ ጎለንነ ኦግያን ሀራን በኤታናዉ ኦያዋዳን ኦፕተ፤ ታን ህንተዉ ቱሙዋ ኦዳይ፤ ኡንቱንቱ ባረንቱ ጋትያ አክ ድጌድኖ። <verse eid="MAT 6:2"/><verse number="3-4" style="v" sid="MAT 6:3-4"/>ሽን ኔን ህዬሳዉ እምያ ዎደ፥ ጌማን እማናዳን፥ ነ ኡሸቻ ኩሺ ኦያዋ ሀድርሳ ኩሺ ኤሮፖ።<note caller="+" style="f"><char style="fr" closed="false">6:3-4 </char><char style="fqa" closed="false">ኡሸቻ ኩሺ ኦዳዋ ሀድርሳ ኩሺካ ኤሮፖ፥ </char><char style="ft" closed="false">ጉሳይ ጾሳፐ አትን፥ ኦንነ ኤሮፖ ጉሳ።</char></note> ጌማን ኦዳዋ በእያ ነ አቡ፥ ነ ሎኦ ኦሱዋ ጋትያ ዛራናዋ።<verse eid="MAT 6:3-4"/></para>
  <para style="s1">ዎሳባ</para>
  <para style="r">(<ref loc="LUK 11:2-4">ሉቃሳ 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>“ጾሳ ዎሲደ፥ ሎአ ማላትያ ኢታቱዋዳን ሀኖፕተ፤ አያዉ ጎፐ፥ ባረንታ አሳይ በአና ማላ፥ አይሁዳ ዎሳ ጎለንነ ኦግያ ዶናን ኤቂደ፥ ጾሳ ዎስያዋ ዶሲኖ፤ ታን ህንተዉ ቱሙዋ ኦዳይ፤ ኡንቱንቱ ባረንቱ ጋትያ ኡባካ አኬድኖ። <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>ሽን ኔን ጾሳ ዎስያ ዎደ፥ ነ ጎለ ገላ፤ እፍ ቃቻደ፥ ቤተና ነ አዉዋ ዎሳ፤ ጌማን ኦሰቶዋ በእያ ነ አቡ ነዉ እማናዋ።<verse eid="MAT 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7"/>“ጾሳ ህንተ ዎስያ ዎደ፥ ጾሳ አማነና አሳዳን፥ ጮ መላ ዛረዋ ዳርሶፕተ፤ ኡንቱንቱ ሃሳያ ዳሩዋን ስሰቴ ጊደ ቆፒኖ። <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>ሄዋ ድራዉ፥ ሄ አሳዳን ሀኖፕተ፤ አያዉ ጎፐ፥ ህንተ አቡ ህንተና ኮሽያዋ ህንተንቱ ዎሳናፐ ካሰቲደ ኤሬ።<verse eid="MAT 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9"/>“ስም ህንተንቱ ሀዋ ማላ ዎሳ ዎስተ፤</para>
  <para style="q1" vid="MAT 6:9">“ ‘ሳሉዋን ደእያ ኑ አቦ፥</para>
  <para style="q2" vid="MAT 6:9">ነ ጌሻ ሱንይ አንጀቶ።<verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>ነ ካዉተይ ዮ፤</para>
  <para style="q2" vid="MAT 6:10">ነ ሸኒ ሳሉዋን ሀኔዳዋዳን፥</para>
  <para style="q2" vid="MAT 6:10">ሳንካ ሀኖ።<verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>ጋላሳን ጋላሳን ኮሽያ ቁማ</para>
  <para style="q2" vid="MAT 6:11">ኑዉ ሀቼ እማ።<verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>ኑን ኑና ናቆዋንቶ</para>
  <para style="q2" vid="MAT 6:12">አቶ ያግያዋዳን፥</para>
  <para style="q2" vid="MAT 6:12">ኔንካ ኑ ናቁዋ አቶ ጋ።<verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>ኑና ኢታባፐ አሻፐ አትን፥</para>
  <para style="q2" vid="MAT 6:13">ፓጭያን ገልሶፓ።</para>
  <para style="q1" vid="MAT 6:13">ካዉተይ፥ ዎልቃይነ ቦንቹ</para>
  <para style="q2" vid="MAT 6:13">መናዉካ ኔሳ።</para>
  <para style="m" vid="MAT 6:13">አመንእ።’<verse eid="MAT 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14"/>“ህንተንቱ ህንተና ናቄዳ ሀራ አሳ ናቁዋ አቶ ጎፐ፥ ሳሉዋን ደእያ ህንተንቱ አዉካ ህንተዉ አቶ ጋና።<verse eid="MAT 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 6:15"/>“ሽን ህንተንቱ ህንተና ናቄዳ ሀራ አሳ ናቁዋ አቶ ጋና ዮፐ፥ ህንተንቱ አዉካ ህንተ ናቁዋ አቶ ጌና።<note caller="-" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="MRK 11:25-26">ማር. 11:25-26</ref></char></note><verse eid="MAT 6:15"/></para>
  <para style="s1">ጾማባ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>“ቃይ ህንተንቱ ጾምያ ዎደ፥ ሎአ ማላትያ ኢታቱዋዳን፥ ካዮትያዋ ማላቶፕተ፤ አያዉ ጎፐ፥ ኡንቱንቱ ጾምያዋ አሳይ በአና ማላ፥ ባረንቱ ሶምእያ ቡላልሲኖ፤ ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ኡንቱንቱ ባረንቱ ጋትያ አኬድኖ።<verse eid="MAT 6:16"/></para>
  <para style="p">
    <verse number="17-18" style="v" sid="MAT 6:17-18"/>“ሽን ህንተንቱ ጾምያ ዎደ፥ ህንተንቱ አቡ ህንተ ጾምያዋ ኤሮፐ አትን፥ አሳይ ኤረና ማላ፥ ህንተ ሶምእያ ሜጨትተ፤ ህንተ ሁጲያካ ኦከትተ፤ ያቶፐ፥ ቤተና ህንተ አዉ ህንተንቱ ኦያዋ ጌማን በኢደ፥ ህንተ ጋትያ እማናዋ።<verse eid="MAT 6:17-18"/></para>
  <para style="s1">ሳሉዋን ደእያ ሚሻባ</para>
  <para style="r">(<ref loc="LUK 12:33-34">ሉቃሳ 12:33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>“ሚሻ ብልአይ ምያሳንነ ብራታይ ሽኢደ ባይዝያሳን፥ ካይሱካ ቦኪደ ዉኢያሳን፥ ሀ ሳኣን ህንተንቱ ሁጲያዉ ዳጋዮፕተ።<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="JOS 5:2-3">ኢያሳ 5:2-3</ref></char></note> <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>ሽን ብልአይ ሜናሳንነ ሽኤና ሳን፥ ካይሱካ ቦኪደ ዉኤና ሳን ህንተንቱ ሁጲያዉ ሳሉዋን ሚሻ ዳጋይተ። <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>አያዉ ጎፐ፥ ነ ዎዛናይ ነ ሚሻይ ደእያ ሳን ደአና።<verse eid="MAT 6:21"/></para>
  <para style="s1">ቦላ ፖኡዋባ</para>
  <para style="r">(<ref loc="LUK 11:34-36">ሉቃሳ 11:34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>“ቦላ ፖኡ አይፍያ፤ ሄዋ ድራዉ፥ ነ አይፊ ፓጻ ግዶፐ፥ ነ ቦላ ኡባይ ፖኦ ግዳና። <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>ሽን ነ አይፊ ፓጻ ግዳና ዮፐ፥ ነ ቦላ ኡባይ ማና፤ ስም ኔናን ደእያ ፖኡ ሞፐ፥ ማይ አይ ኬና ዳራኔ!<verse eid="MAT 6:23"/></para>
  <para style="s1">ደኦ ህርጋናዉ በሰና</para>
  <para style="r">(<ref loc="LUK 16:13">ሉቃሳ 16:13</ref>፤ <ref loc="LUK 12:22-31">12:22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>“ላኡ ጎዳቶ ሞደታናዉ ዳንዳይያዌ ኦንነ ባዋ፤ አያዉ ጎፐ፥ እቱዋ እጺደ፥ የኩዋ ሲቄ፤ ዎይ እቱዋ ቦንቺደ፥ የኩዋ ካ፤ እት አሳይ ጾሳዉነ ሻሎ ሞደታናዉ ዳንዳየና።<verse eid="MAT 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>“ሄዋ ድራዉ፥ ታን ህንተንቶ ኦዳይ፤ ህንተ ደኦ ማናባዉነ ኡሻናባዉ፥ ዎይ ህንተ ቦላዉ ማያናባዉ ህርጎፕተ፤ ሸምፑ ቁማፐ አኔ? ቃይ ቦላይ ማዩዋፐ አኔ? <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>ፓልያ ካፋቱዋ ጼልተ፤ ኡንቱንቱ ዘርክኖ፤ ጫክክኖ፤ ድይያንካ ቆልክኖ፤ ሽን ሳሉዋን ደእያ ህንተንቱ አዉ ኡንቱንታ ምዜ፤ ህንተንቱ ኡንቱንቱፐ ሎይ ዳርክቴ? <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>ህንተንቱ ግዶን ዳርስ ህርጊደ፥ ባረ ጌሳ ቦላ እት ዋ ጉጃናዉ ዳንዳይያዌ ኦኔ?<verse eid="MAT 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28"/>“አያዉ ማዮ ህርጊቴ? ደምባን ደእያ ጪሻቱ ዎት ድጪኖንቶ፥ አኬክ ጼልተ፤ ኡንቱንቱ ዳቡርክኖ ዎይ ፑቱዋ ሱቂክኖ።<note caller="-" style="x"><char style="xo" closed="false">6:28 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1 ካታ. 10:4-7</ref>፤ <ref loc="2CH 9:3-6">2 ኦዱዋ 9:3-6</ref></char></note> <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>ሽን ታን ህንተንቶ ኦዳይ፤ ሀራይ አቶ፥ ሶሎሞነ ሄዋ ኬና ቦንቼቴዳዋ ግዲደ፥ ሄ ጪሻቱዋፐ እቱዋ ማላካ ማይቤና። <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>ሽን ላፋ አማኑ ደእያዋንቶ፥ ጾሳይ፥ ሀቼ ደኢደ፥ ዎንት ታማን ኤጽያ ደምባ ማታ ማይዝያዌ፥ ህንተና ኡንቱዋፐ አደ ዎት ማይዘኔ? <verse eid="MAT 6:30"/><verse number="31" style="v" sid="MAT 6:31"/>ስም፥ ‘ኑን አያ ማኔ? ዎይ አያ ኡሻኔ? ዎይ አያ ማያኔ?’ ያጊደ ህርጎፕተ። <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>አያዉ ጎፐ፥ ሄ ኡባባ ጾሳ አማነናዋንቱ ዳርሲደ ኮዪኖ፤ ሄ ኡባይ ህንተና ኮሽያዋ ሳሉዋን ደእያ ህንተንቱ አዉ ኤሬ። <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>ሽን ካሰቲደ፥ ጾሳ ካዉተነ አ ጽሎተ ኮይተ፤ እ ህንተንቶ ሄ ኡባባ እማና። <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>ሄዋ ድራዉ፥ ዎንትባዉ ህርጎፕተ፤ አያዉ ጎፐ፥ ዎንት ጋላሳይ ባረዉ ህርጋና፤ ጋላሳ ኡባዉካ አ ሁጰዉ ግድያ ዋዪ ደኤ።<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s1">ሀራ አሳ ቦላ ፕርዳናዉ ኮሸና</para>
  <para style="r">(<ref loc="LUK 6:37-42">ሉቃሳ 6:37-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>“ጾሳይ ህንተንቱ ቦላ ፕርደና ማላ፥ ህንተካ ሀራቱዋ ቦላ ፕርዶፕተ። <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>አያዉ ጎፐ፥ ህንተንቱ ሀራቱዋ ቦላ ፕርድያዋዳን፥ ጾሳይ ህንተንቱ ቦላ ፕርዳና፤ ቃይ ህንተንቱ ሀራቶ እማናዉ ማክያባን እ ህንተዉ ማካና። <verse eid="MAT 7:2"/><verse number="3" style="v" sid="MAT 7:3"/>ነ አይፍያን ደእያ ቱሳ በአካ፤ ሽን ነ እሻ አይፍያን ደእያ ሱላ አያዉ ጼላይ? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>ዎይ ነ አይፍያን ቱሳይ ደእሽን፥ ኔን ነ እሻ፥ ‘ታን ነ አይፍያፐ ሱላ ከሶ’ ዋናደ ጋናዉ ዳንዳያይ? <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>ላ ሀ ሎኡዋ ማላትያ ኢታዉ! ካሰታደ ነ አይፍያፐ ቱሳ ከሳ ድጋ፤ ሄዋፐ ጉይያን፥ ነ እሻ አይፍያፐ ሱላ ከሳናዉ ጌሻደ ጼላናዉ ዳንዳያ።<verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>“ጌሻባ ካናቶ እሞፕተ፤ ኡንቱንቱ ጉየ ስሚደ፥ ህንተና ሳአና። ቃይ እንቁዋ ጌተትያ ህንተንቱ አልኦ ሹቻ ጉዱንቱዋ ስንን ኦሎፕተ፤ ኡንቱንቱ ባረንቱ ገድያን የና።<verse eid="MAT 7:6"/></para>
  <para style="s1">ዎስተ፥ ኮይተ፥ ካርያኮ ዪደ ጼስተ</para>
  <para style="r">(<ref loc="LUK 11:9-13">ሉቃሳ 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>“ዎስተ፤ ህንተ አካና። ኮይተ፤ ህንተ ደማና። ካርያኮ ዪደ ጼስተ፤ ህንተዉ ፐንጊ ዶየታና። <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>አያዉ ጎፐ፥ ዎስያ ኡባይ አካና፤ ኮይያ ኡራይ ደማና፤ ቃይ ካርያኮ ዪደ ጼስያ ኡራዉ ፐንጊ ዶየታና። <verse eid="MAT 7:8"/><verse number="9" style="v" sid="MAT 7:9"/>ዎይ ህንተንቱ ግዶን ባረ ናአይ፥ ‘ኡክ እማ’ ጎፐ፥ ሹቻ እምያ አዉ ደኢ? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>ቃይ፥ ‘ሞልያ እማ’ ጎፐ፥ አዉ ሾሻ እማናዌ? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>ህንተንቱ ኢታ ግዲደ፥ ህንተንቱ ናናቶ ሎኦባ እምያዋ ኤሮፐ፥ ያትና፥ ሳሉዋን ደእያ ህንተንቱ አዉ ባረና ዎስያዋንቶ ሎኦባ ዎት ዳርስ እመኔ!<verse eid="MAT 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12"/>“ሄዋ ድራዉ፥ ሀራ አሳይ ህንተዉ ኦናዉ ኮይያ ኡባባ ህንተካ አሳዉ ኦተ፤ አያዉ ጎፐ፥ ሙሴ ህግያ ብለይነ ናባቱ ታማርስያዌ ሀዋ።<verse eid="MAT 7:12"/></para>
  <para style="s1">ኡንአ ፐንግያባ</para>
  <para style="r">(<ref loc="LUK 13:24">ሉቃሳ 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>“ኡንአ ፐንግያና ገልተ። አያዉ ጎፐ፥ ባየዉ አፍያ ፐንጊ አኩዋ፤ ኦጊካ ዎጋ። ሄዋና ገልያ አሳይካ ጮራ።<verse eid="MAT 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 7:14"/>“ሽን፥ ደኦ አፍያ ፐንጊ ኡንአ፤ ኦጊካ ጹን። ቃይ ሄዋ ደምያዋንቱካ ጉ።<verse eid="MAT 7:14"/></para>
  <para style="s1">ምይ ባረ አይፍያን ኤረቴ</para>
  <para style="r">(<ref loc="LUK 6:43-44">ሉቃሳ 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>“ቦላ ባጋና ዶርሳ ማላቲደ፥ ህንተኮ ይያ ዎርዶ ናባቱዋፐ ናገትተ፤ ሽን ኡንቱንቱ ጋርሳ ባጋና ዋላቱዋ ማላ። <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>ኡንቱንቱ አይፍያ አይፍያዋን ህንተ ኡንቱንታ ኤራና፤ አጉንይ ዎደን አይፍያ አይፈና፤ ጎምኦሪካ ኮክያ አይፍያ አይፈና። <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>ሄዋዳንካ፥ ሎኦ ም ኡባይ ሎኦ አይፍያ አይፌ፤ ሽን ኢታ ምይ ኢታ አይፍያ አይፌ። <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>ሎኦ ምይ ኢታ አይፍያ አይፋናዉ ዳንዳየና፤ ቃይ ኢታ ምይካ ሎኦ አይፍያ አይፋናዉ ዳንዳየና። <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>ሎኦ አይፍያ አይፈና ም ኡባይ ቃንጸቲደ፥ ታማን የገታና። <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>ሄዋ ድራዉ፥ ህንተ ኡንቱንቱ አይፍያ አይፍያዋን ኡንቱንታ ኤራንታ።<verse eid="MAT 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>“ሳሉዋን ደእያ ታ አቡ ጌዳዋ ኦያ ኡራይ ሳሉዋ ካዉተ ገላናፐ አትን፥ ‘ጎዳዉ፥ ጎዳዉ’ ግያ ኡባይ ገለና። <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>ፕርዳ ጋላስ ዳሮ አሳይ ታና፥ ‘ጎዳዉ፥ ጎዳዉ፥ ኑን ነ ሱንን ጾሳይ ኪቶዋ ኦድበይኮ? ነ ሱንን ጻላሀቱዋ ከስበይኮ? ቃይ ኑን ጾሳይ ኦያ ማላልስያባ ነ ሱንን ኦበይኮ?’ ያጋናዋንታ። <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>ታን ሄ ዎደ ኡንቱንታ፥ ‘ታን ህንተና ኡባካ ኤርከ፤ ኢታባ ኦያዋንቱ ህንተ ታ ማታፐ ሃክተ’ ያጋና።<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="PSA 6:8">ማዝ. 6:8</ref></char></note><verse eid="MAT 7:23"/></para>
  <para style="s1">ላኡ ማላ ጎላቱዋ</para>
  <para style="r">(<ref loc="LUK 6:47-49">ሉቃሳ 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>“ሄዋ ድራዉ፥ ሀዋ ታ ቃላ ስሲደ ኦያ ኡባይ ምኖ ዛላ ቦላ ባረ ጎልያ ኬጼዳ ዎዛናማ አሳ ማላ። <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>እራይ ቡኪደ፥ ድኡ ድኤዳ፤ ጫርኩካ ጫርኪደ፥ ሄ ጎልያ ሱጌዳ። ሽን ጎሊ ምኖ ዛላ ቦላ ኬጸቴዳ ድራዉ፥ ኩንድቤና።<verse eid="MAT 7:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26"/>“ሀዋ ታ ቃላ ስሲደ ኦና አሳይ ኡባይ፥ ባረ ጎልያ ሻፍያ ቦላ ኬጼዳ ቦዛ አሳ ማላ። <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>እራይ ቡኪደ፥ ድኡ ድኤዳ፤ ጫርኩካ ጫርኪደ፥ ሄ ጎልያ ሱግና፥ ጎሊ ኤለካ ኩንዴዳ። ሄ ጎሊ ዎልቃማ ኩንደ ኩንዴዳ።”<verse eid="MAT 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28"/>የሱስ ባረ ሃሳይያዋ ዉርሴዳ ዎደ፥ አሳይ እ ታማርስያዋን ማላለቴድኖ። <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/>አያዉ ጎፐ፥ እ ኡንቱንታ ታማርሲደ፥ ሙሴ ህግያ ታማርስያዋንቱዳን ግደናን፥ ማታይ ደእያ አሳዳን ታማርሶ ድራሳ።<verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s1">የሱስ ኦሉ ኦይቄዳ ብታንያ ፓዳ</para>
  <para style="r">(<ref loc="MRK 1:40-45">ማር. 1:40-45</ref>፤ <ref loc="LUK 5:12-16">ሉቃሳ 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>የሱስ ደርያፐ ዎዳ ዎደ፥ ጮራ አሳይ አ ካሌዳ። <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>ሄ ዎደ ኦሉ<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="ft" closed="false">ኦሉ ኦይቄዳ አሳ ቦላይ ቦጼ። ሀዌ ሳክያ አሳይ ሄ ዎደ ደኡዋን አሳና ደእያ ዎጋ ኡባፐ ሻከቲደ ደኤ። ቃይካ ጌሻ ግደና ጌተቲደ ሀራ አሳን ጼሰቴ።</char></note> ኦይቄዳ እት ብታኒ የሱሳኮ ይ አ ስንን ጉልባቲደ፥ “ጎዳዉ፥ ነ ሸነ ግዶፐ፥ ታና ፓደ ጌሻናዉ ዳንዳያ” ያጌዳ።<verse eid="MAT 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3"/>የሱስ ባረ ኩሽያ የድ አ ቦቺደ፥ “ታን ኮያይ፤ ፓጻደ ጌያ!” ያጌዳ። ኤለካ ኦሉ ብታንያ የድ አጌዳ። <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>የሱስ አ፥ “ስም ሀዋ ኦስነ ኦዶፓ፤ ሽን ቄሳኮ ባደ ነ ፓጻደ ጌዬዳዋ አ በሳ፤ ነ ፓጻደ ጌዬዳዋ አሳ ኤርሳናዉ ሙሴ አዛዜዳ ያርሹዋ ጾሳዉ ያርሻ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">ዎጋ 14:1-32</ref></char></note><verse eid="MAT 8:4"/></para>
  <para style="s1">የሱስ ጼቱዋ ካፑዋ ቆማ ፓዳ</para>
  <para style="r">(<ref loc="LUK 7:1-10">ሉቃሳ 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5-6" style="v" sid="MAT 8:5-6"/>የሱስ ቅፍርናሆማ ካታማ ገሌዳ ዎደ፥ እት ሮማ ጋደ ጼቱዋ ካፑ አኮ ዪደ፥ “ታ ጎዳዉ፥ ታ ቆማ ቦላይ ጉንድና፥ ዳሮ ሳከቲደ፥ ሶይን ግሴዳ፤ ሀያ ጎዶ ታዉ ፓርኪ” ያግ ዎሴዳ።<verse eid="MAT 8:5-6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7"/>የሱስ፥ “ታን ባደ አ ፓና” ያጌዳ።<verse eid="MAT 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8"/>ሽን ጼቱዋ ካፑ ዛሪደ፥ “ታ ጎዳዉ፥ ኔና ታ ሶይ ገልሳናዉ ታዉ በሰና፤ ሽን ኔን ቃላ ጻላላ ሃሳያ፤ ታ ቆማይ ፓጻናዋ። <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>አያዉ ጎፐ፥ ታን ታፐ ቦላና ደእያዋንቶ ኤኖ ግያ አሳ፤ ቃይ ታፐ ጋርሳና ዎታዳራቱ ደኢኖ። ታን እቱዋ፥ ‘ባ!’ ጎፐ ቤ፤ ቃይ የኩዋ፥ ‘ሃያ!’ ጎፐ ዬ፤ ታ ቆማ፥ ‘ሀዋ ኦ!’ ጎፐ ኦ” ያጌዳ።<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>የሱስ ሄዋ ስሴዳ ዎደ ማላለቲደ፥ ባረና ካልያ አሳ፥ “ታን ህንተዉ ቱሙዋ ኦዳይ፤ ታን ሀዋ ማላ አማኑዋ ሀራይ አቶ፥ እስራኤልያ ጋድያንካ በአበይከ። <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>ጮራ አሳይ አዋይፊ ዶልያ ባጋፐነ ዉልያ ባጋፐ ዪደ፥ አብራሃሞና፥ ይሳቃናነ ያቆባና ሳሉዋ ካዉተ ጋይታን እትፐ ኡታናዋንታ ያጋይ። <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>ሽን ካዉተን ደአናዉ በስያ አሳይ ዎልቃማ ማ ጋርሳ ካረ ኦለታና፤ ሄዋን ኡንቱንቱ ዬካናነ ባረንቱ አቻ ቃናዋንታ” ያጌዳ።<verse eid="MAT 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13"/>ሄዋፐ ካላ የሱስ ጼቱዋ ካፑዋ፥ “ነ ሶይ ባ፤ ኔን አማኔዳዋዳን ነዉ ሀኖ” ያጌዳ፤ ጼቱዋ ካፑዋ ቆማይ ሄ ሳትያንካ ፓጽ አጌዳ።<verse eid="MAT 8:13"/></para>
  <para style="s1">የሱስ ጮራ አሳቱዋ ኡንቱንቱ ሀርግያፐ ፓዳ</para>
  <para style="r">(<ref loc="MRK 1:29-34">ማር. 1:29-34</ref>፤ <ref loc="LUK 4:38-41">ሉቃሳ 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>የሱስ ጰጽሮሳ ሶይ ቢደ፥ አ ቦሎታታ ቆጹዋ ሀርጋደ ግሴዳዉኖ በኤዳ። <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>እዝ ኩሽያ የሱስ ቦችና፥ ቆጹ እዞ ባሽ አጌዳ፤ እዛካ ደንዳደ አዉ ምያባ ጊግሳዱ።<verse eid="MAT 8:15"/></para>
  <para style="p">
    <verse number="16-17" style="v" sid="MAT 8:16-17"/>ሳአይ ኦማርሴዳ ዎደ፥ አሳይ ኢታ አያናቱ ኦይቄዳ ጮራ አሳ የሱሳኮ አሄዳ፤ ናብያ ኢስያስ፥ “እ ኑ ዳቡራ ባረዉ አኬዳ፤ ቃይ ኑ ሀርግያካ ቶኬዳ” ያጌዳዌ ፖለታና ማላ፥ የሱስ ኢታ አያናቱዋ ባረ ቃላን ከሲደ፥ ሀርጌዳ አሳ ኡባካ ፓዳ።<note caller="-" style="x"><char style="xo" closed="false">8:16-17 </char><char style="xt" closed="false"><ref loc="ISA 53:4">ኢሳ. 53:4</ref></char></note><verse eid="MAT 8:16-17"/></para>
  <para style="s1">የሱሳ ካልያዋንታ ጋክያ መቱዋ</para>
  <para style="r">(<ref loc="LUK 9:57-62">ሉቃሳ 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>የሱስ ጮራ አሳይ ባረ ዩሹዋን ደእያዋንታ በኢደ፥ አባፐ ሄፍን ፕናና ማላ፥ ባረና ካልያዋንታ አዛዜዳ። <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>ሄዋፐ ጉይያን ሙሴ ህግያ ታማርስያ እቱ አኮ ዪደ፥ “ታማርስያዎ፥ ኔን ብያሳ ኡባ ታን ኔና ካላና” ያጌዳ።<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>የሱስ አ፥ “ዎራካናቶ ኦላይ ደኤ፤ ካፋቱዋስካ ኬይ ደኤ፤ ሽን ታዉ፥ አሳ ናአዉ፥ ሸምፓ አክያሳይካ ባዋ” ያጌዳ።<verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>ቃይ ካልያዋንቱፐ እቱ የሱሳ፥ “ጎዳዉ፥ ታን ስንታ ባደ ታ አባ ሞጋናዉ ባ ያጋርኪ” ያጌዳ።<verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>ሽን የሱስ አ፥ “ኔን ታና ካላ፤ ሀይቄዳዋንቱ ባረንቱ አሃ ሞግኖ” ያጌዳ።<verse eid="MAT 8:22"/></para>
  <para style="s1">የሱስ ጎቱዋነ ቤታ ጮኡ ኦዳ</para>
  <para style="r">(<ref loc="MRK 4:35-41">ማር. 4:35-41</ref>፤ <ref loc="LUK 8:22-25">ሉቃሳ 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>የሱስ ዎንግርያን ገሎደ፥ አ ካልያዋንቱ አናና ቤድኖ። <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>ቤታይ ዎንግርያ ምታና ጋካናዉ፥ አባን ዎልቃማ ሆቢ ደንዴዳ፤ ሽን የሱስ ገምእሼዳ። <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>አ ካልያዋንቱ አኮ ቢደ፥ ገምእሹዋፐ ደንድኖ፤ ሄዋፐ ስሚደ አ፥ “ጎዳዉ፥ ኑን ዬቶ፤ ኑና አሻርኪ” ያጌድኖ።<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>የሱስ ኡንቱንታ፥ “ሀ አማኑ ፓጬዳዋንቶ፥ አያዉ ያዪቴ?” ያጌዳ። ሄዋፐ ጉይያን ደንዲደ፥ ጎቱዋነ ቤታ አግተ ጊና፥ ጎቱነ ቤታይ ጮኡ ጌዳ።<verse eid="MAT 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27"/>አሳይ ማላለቲደ፥ “ሀዌ ላ ሀራይ አቶ፥ ጎቱነ ቤታይ አዛዘትያዌ አይባ አሴ?” ያጌድኖ።<verse eid="MAT 8:27"/></para>
  <para style="s1">የሱስ ኢታ አያናይ ኦይቄዳ ላኡ አሳቱዋ ፓዳ</para>
  <para style="r">(<ref loc="MRK 5:1-20">ማር. 5:1-20</ref>፤ <ref loc="LUK 8:26-39">ሉቃሳ 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>የሱስ ጋሊላ አባፐ ሄፍንን ደእያ ገርገሰኖና ጌተትያ ጋድያ ፕኔዳ፤ ኢታ አያናቱ ኦይቄዳ ላኡ አሳቱ ሄ ጋድያን ደእያዋንቱ ዱፉዋፐ ከሲደ፥ አናና ጋከቴድኖ። ኡንቱንቱ ዳሮ ኢታ ግድያ ድራዉ፥ ኦንነ ሄ ኦግያና አናዉ ዳንዳይቤና። <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>ኡንቱንቱ ባረንቱ ቃላ ቁ ኦደ፥ “ጾሳ ናአዉ፥ ኑናና ነዉ አይ አላሊ ደኢ? ዎዲ ጋከናን ኑና ሙራናዉ ያዲ?” ያጌድኖ።<verse eid="MAT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30"/>ኡንቱንቱፐ ላፋ ሃክያሳን ጉዱን ዉዲ ሄመቴ። <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>ኢታ አያናቱ የሱሳ፥ “ኔን ኑና ከስያዋ ግዶፐ፥ ህን ጉዱን ዉድያ ግዶ የዳርኪ” ያጊደ ዎሴድኖ።<verse eid="MAT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32"/>የሱስ ኡንቱንታ፥ “ቢተ!” ጊና ኡንቱንቱ ብታናቱዋፐ ከስ ቢደ፥ ጉዱንቱዋን ገሌድኖ። ጉዱን ዉዲ ኡባይ ካካ ላንቂያና ካጆቲደ፥ አባን ገሊደ፥ ምተት አጌድኖ።<verse eid="MAT 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33"/>ጉዱን ዉድያ ሄምያዋንቱ ባቃቲደ ካታማ ብ አጌድኖ፤ ቤዳሳን ኢታ አያናቱ ኦይቄዳ አሳቱ ሀኔዳባ ኡባ ኦዴድኖ። <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>ሄዋ ስሴዳ ካታማን ደእያ አሳይ ኡባይ የሱሳና ጋከታናዉ ከሴድኖ፤ አ በኤዳ ዎደ፥ ባረንቱ ጋድያፐ ባና ማላ ዎሴድኖ።<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s1">የሱስ ቦላይ ጉንዴዳ ብታንያ ፓዳ</para>
  <para style="r">(<ref loc="MRK 2:1-12">ማር. 2:1-12</ref>፤ <ref loc="LUK 5:17-26">ሉቃሳ 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>ሀዋፐ ካላ የሱስ ዎንግርያን ገሊደ፥ አባ ፕኒደ፥ ባረ ካታማ ዬዳ። <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>አማሬዳ አሳይ ቦላይ ጉንዴዳ እት ብታንያ ሻንቻማን ቶኪደ፥ የሱሳኮ አሄድኖ፤ የሱስ ኡንቱንቱ አማኑዋ በኢደ፥ ቦላይ ጉንዴዳ ብታንያ፥ “ታ ናአዉ፥ ያዮፓ፤ ነ ናጋራይ አቶ ጌተቴዳ” ያጌዳ።<verse eid="MAT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3"/>ህግያ ታማርስያዋንቱፐ እቱ እቱ ባረንቱ ዎዛናን፥ “ላ ሀ ብታኒ ጾሳ ቦላ ኢታባ ሃሳዬቴ!” ያግ ቆፔድኖ።<verse eid="MAT 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4"/>የሱስ ኡንቱንቱ ቆፋ ኤሪደ፥ ኡንቱንታ ሀዋዳን ያጌዳ፤ “ህንተንቱ ህንተ ዎዛናን ሀዋ ማላ ኢታባ አያዉ ቆፒቴ? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>‘ነ ናጋራይ አቶ ጌተቴዳ’ ያግያዌ ማቴዬ? ዎይ፥ ‘ደንዳ ኤቃደ ሀመታ’ ያግያዌ ማቴ? <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>ሽን ሳኣ ቦላን ናጋራ አቶ ጋናዉ ታዉ፥ አሳ ናአዉ፥ ማታይ ደእያዋ ታን ህንተና ኤርሳና” ያጊደ፥ ሄዋፐ ጉየ እ ሄ ቦላይ ጉንዴዳ ብታንያ፥ “ደንዳ ኤቃ፤ ያታደ ነ ሻንቻማ ቶካደ፥ ነ ጎለ ባ” ያጌዳ።<verse eid="MAT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7"/>ጉንዴዳ ብታኒካ ደንድ ኤቂደ፥ ባረ ጎለ ቤዳ። <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>ሽን ዳሮ አሳይ ሄዋ በኢደ ያዬድኖ፤ አሳዉ ሀዋ ማላ ማታ እሜዳ ጾሳ ጋላቴድኖ።<verse eid="MAT 9:8"/></para>
  <para style="s1">የሱስ ሌዊያ ማቶሳ ጼሴዳ</para>
  <para style="r">(<ref loc="MRK 2:13-17">ማር. 2:13-17</ref>፤ <ref loc="LUK 5:27-32">ሉቃሳ 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>የሱስ ሄዋና አደ፥ ማቶሳ ያግያዌ ቃራጻ ቃንጽያ ሳን ኡቴዳዋ ደሚደ አ፥ “ታና ካላ” ያጌዳ።</para>
  <para style="p" vid="MAT 9:9">ማቶስካ ደንድ ኤቂደ፥ አ ካሌዳ።<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>የሱስ ማቶሳ ጎለን ቁማ ማናዉ ኡት ደእሽን፥ ቃራጻ አክያ ጮራ አሳይነ ናጋራንቻቱ ዪደ፥ አናናነ አ ካልያዋንቱና እትፐ ጋይታን ኡቴድኖ። <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>እት እት ፓርሳዋቱ ሄዋ በኢደ፥ የሱሳ ካልያዋንታ፥ “ህንተና ታማርስያዌ ቃራጻ ቃንጽያዋንቱናነ ናጋራንቻቱዋና ቁማ አያዉ እትፐ ሚ?” ያጌድኖ።<verse eid="MAT 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12"/>ሽን የሱስ ኡንቱንቱ ያግያዋ ስሲደ፥ “ሀርጋንቻቱዋፐ አትን፥ ፓጻቶ አክሚ ኮሸና። <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>ሽን ህንተንቱ ቢደ፥ ጾሳ ማጻፋይ፥ ‘ታን ማሮተ ኮያይፐ አትን፥ ያርሹዋ ኮይከ’ ያግያዌ ዋግያዌንቶ ኤርተ፤ አያዉ ጎፐ፥ ታን ናጋራንቻቱዋ ጼሳናዉ ዬዳዋፐ አትን፥ ጽላቱዋ ጼሳናዉ ያበይከ” ያጌዳ።<verse eid="MAT 9:13"/></para>
  <para style="s1">ጾማባ ኦቼዳ ኦሻ</para>
  <para style="r">(<ref loc="MRK 2:18-22">ማር. 2:18-22</ref>፤ <ref loc="LUK 5:33-39">ሉቃሳ 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>ሄ ዎደ ዮሃንሳ ካልያዋንቱ የሱሳኮ ዪደ፥ “ኑንነ ፓርሳዋቱ ኡባ ዎደ ጾሜቶ፤ ሽን ኔና ካልያዋንቱ አያዉ ጾምክኖ?” ያጊደ አ ኦቼድኖ።<verse eid="MAT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15"/>የሱስ ኡንቱንታ፥ “ቡላቻ ዬዳ አሳይ ማቻቶ አክያዌ ባረንቱና ደእሽን፥ ካዮታናዉ ዳንዳዪኖ? ዳንዳይክኖ፤ ሽን ማቻቶ አክያዋ ኡንቱንቱ ማታፐ አፋና ዎዲ ያና፤ ኡንቱንቱ ሄ ዎደ ጾማናዋንታ” ያጌዳ።<verse eid="MAT 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16"/>“ኤጫ ማዩዋ ቦላ ኦራ ፍያ ዎደ ስክያ አሳይ ባዋ፤ አያዉ ጎፐ፥ ኦራ ፊ ኤጫ ማዩዋ ፔሬና፤ ፔይካ ካሰዋፐ ዳራናዋ። <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>ሆኦ ዎይንያ ኤሳ ኤጫ ኦጎሩዋን ናእያ አሳይ ባዋ። ሽን ናኦፐ፥ ሄ ዎይንያ ኤሳይ ኦጎሩዋ ዳካና፤ ባረዉካ ዎፈታና፤ ኦጎሩካ ባያናዋ። ሽን፥ ሆኦ ዎይንያ ኤሳ ኦራ ኦጎሩዋን ናአናዉ በሴ፤ ላኡካ ባይክኖ” ያጌዳ። <figure style="fig" alt="Wineskin" file="LB00145B.TIF" size="span" ref="9:17">ዎይንያ ኤሳ ኦጎሩዋ</figure><verse eid="MAT 9:17"/></para>
  <para style="s1">ያእሮሳ ናትባነ የሱሳ ማዩዋ ቦቼዳ ምሽራትባ</para>
  <para style="r">(<ref loc="MRK 5:21-43">ማር. 5:21-43</ref>፤ <ref loc="LUK 8:40-56">ሉቃሳ 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>የሱስ ኡንቱንቶ ሄዋ ኦድሽን፥ አይሁደ ዎሳ ጎለ ካፓቱዋፐ እቱ አኮ ይ አ ስንን ጉልባቲደ፥ “ታ ናታ ሀእ ሀይቃዱ፤ ሽን ኔን ያደ ነ ኩሽያ እዝ ቦላ ዎርኪ፤ እዛ ደኡዋን ደአናዉኑ” ያጌዳ።<verse eid="MAT 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19"/>የሱስ ደንዲደ፥ ባረና ካልያዋንቱና እትፐ ብታንያ ካሊደ ቤዳ። <verse eid="MAT 9:19"/><verse number="20" style="v" sid="MAT 9:20"/>ሄ ዎደ ታማነ ላኡ ላይ ኩመን፥ እዝ ቦላፐ ሱይ ጎግያ እት ምሽራታ ጉየና ሺቃደ፥ የሱሳ ማዩዋ ማጫራ ቦቻዱ። <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>ሀዋ እዛ ኦዌ፥ እዛ ባረ ዎዛናን፥ “ታን አ ማዩዋ ጻላላ ቦቻንቶ ፓጻና” ያጋደ ቆፓዱ።<verse eid="MAT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22"/>ሽን የሱስ ዩይ እዞ ጼሊደ፥ “ታ ናቴ፥ ያዮፓ፤ ኔና ነ አማኑ ፓዳ” ያጌዳ። ሄ ማንእያን ምሽራታ ፓጻ አጋዱ።<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>የሱስ አይሁዳ ዎሳ ጎለ ካፑዋ ሶይ ጋኬዳ ዎደ፥ ዬኩዋን ድንካ ፑንያ አሳነ ዬክያ አሳ በኢደ፥ <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>“ካረ ከስተ፤ ጉ ናታ ገምእሻዱፐ አትን፥ ሀይቃበይኩ” ያጌዳ። ሄዋፐ ጉይያን አሳይ አ ቦላ ዳሪ ሚጬዳ። <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>ሽን ጮራ አሳ ካረ እ ከሴዳዋፐ ጉይያን፥ ጎለ ገሊደ፥ ናት ኩሽያ ኦይቄዳ፤ ናታካ ደንዳ አጋዱ። <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>ሄ ዋሪ፥ ሄ ማንእያን ሄ ጋድያን ኡባን ስሰቴዳ።<verse eid="MAT 9:26"/></para>
  <para style="s1">የሱስ ላኡ ቆቃቱዋ ፓዳ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>የሱስ ሄዋና አደ ብያ ዎደ፥ ላኡ ቆቃቱ ባረንቱ ቃላ ቁ ኦደ፥ “ዳዊተ ናአዉ፥ ኑና ማራርኪ” ያጊደ አ ካሌድኖ።<verse eid="MAT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28"/>የሱስ ጎለ ገሌዳ ዎደ፥ ቆቃቱ አኮ ዬድኖ፤ የሱስ ኡንቱንታ፥ “ታን ሀዋ ኦናዉ ዳንዳይያዋ አማኒቴ?” ያጌዳ።</para>
  <para style="p" vid="MAT 9:28">ኡንቱንቱ፥ “ኤ ጎዳዉ” ያግ ዛሬድኖ።<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>ሄዋፐ ጉይያን፥ የሱስ ኡንቱንቱ አይፍያ ባረ ኩሽያን ቦቺደ ኡንቱንታ፥ “ህንተዉ ህንተንቱ አማኑዋዳን ሀኖ” ያጌዳ። <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>ኡንቱንቱ አይፊ ዶየት አጌዳ፤ የሱስ ኡንቱንቶ፥ “ሀዋ ኦስነ ኦዶፕተ” ያጊደ ምንሲደ ኦዴዳ። <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>ሽን ኡንቱንቱ ቢደ፥ ሄ ጋድያ ኡባን የሱሳባ ኦዴድኖ።<verse eid="MAT 9:31"/></para>
  <para style="s1">የሱስ እት ዱድያ ፓዳ</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>ኡንቱንቱ ከሲደ ብያ ዎደ፥ አማሬዳ አሳይ ኢታ አያናይ ኦይቂና ዱዴዳ ብታንያ የሱሳኮ አሄድኖ። <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>የሱስ ኢታ አያና ከሴዳዋፐ ጉይያን፥ ዱደ ብታኒ ሃሳዬዳ። አሳይ፥ “ሀዌ ኦራባ፤ ሀዋ ማላባይ እስራኤልያ ጋድያን ኡባካ ሀንቤና” ያግ ማላለቴድኖ።<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>ሽን ፓርሳዋቱ፥ “እ ኢታ አያናቱዋ ካፑዋ ዎልቃን ጻላሀቱዋ ከሴ” ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="MAT 10:25">10:25</ref>፤ <ref loc="MAT 12:24">12:24</ref>፤ <ref loc="MRK 3:22">ማር. 3:22</ref>፤ <ref loc="LUK 11:15">ሉቃሳ 11:15</ref></char></note><verse eid="MAT 9:34"/></para>
  <para style="s1">የሱስ አሳዉ ቃረቴዳ</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>የሱስ ኡንቱንታ አይሁዳ ዎሳ ጎለቱዋን ታማርሲደነ ካዉተ ዎንጋላ ምሽራቹዋ ኦዲደ፥ ቃይ ሀርግያ ኡባፐነ ሳኩዋ ኡባፐ አሳ ፓደ፥ ዎጋ ካታማቱዋንነ ቄር ካታማቱዋ ኡባን ዩዬዳ።<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 4:23">ማቶሳ 4:23</ref>፤ <ref loc="MRK 1:39">ማር. 1:39</ref>፤ <ref loc="LUK 4:44">ሉቃሳ 4:44</ref></char></note> <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>ጮራ አሳ በኢደ፥ ሄምያ አሳይ ባይና ዶርሳዳን አሳይ ህርገትያ ድራዉነ አሳ ማድያባይ ባይና ድራዉ፥ አሳዉ ቃረቴዳ።<note caller="-" style="x"><char style="xo" closed="false">9:36 </char><char style="xt" closed="false"><ref loc="NUM 27:17">ፓይ. 27:17</ref>፤ <ref loc="1KI 22:17">1 ካታ. 22:17</ref>፤ <ref loc="2CH 18:16">2 ኦዱዋ 18:16</ref>፤ <ref loc="EZK 34:5">ህዝ. 34:5</ref>፤ <ref loc="MRK 6:34">ማር. 6:34</ref></char></note> <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>ያቲደ ባረና ካልያዋንታ፥ “ቆይቻዉ ጋካ ካይ ዳራ፤ ሽን ጫክያ አሳይ ጉ። <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>ስም ካ ጎዳይ ካ ጫካናዉ ኦሳንቻቱዋ የዳና ማላ፥ አ ዎስተ” ያጌዳ።<verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s1">የሱስ ኪቴዳ ታማነ ላኡ አሳቱዋባ</para>
  <para style="r">(<ref loc="MRK 3:13-19">ማር. 3:13-19</ref>፤ <ref loc="LUK 6:12-16">ሉቃሳ 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>የሱስ ባረ ታማነ ላኡ ካልያዋንታ ጼሲደ፥ ኡንቱንቱ ኢታ አያና ከሳና ማላ፥ ቃይ ሀርግያ ኡባነ ሳኩዋ ኡባ ፓና ማላ፥ ኡንቱንቶ ማታ እሜዳ። <verse eid="MAT 10:1"/><verse number="2" style="v" sid="MAT 10:2"/>የሱስ ኪቴዳ ታማነ ላአቱዋ ሱንይ፥ ኮይሮዌ ጰጽሮሳ ጌተትያ ስሞናነ አ እሻ እንድራሳ፥ ዛብድዮሳ ናና፥ ያቆባነ ዮሃንሳ፥ <verse eid="MAT 10:2"/><verse number="3" style="v" sid="MAT 10:3"/>ፕልጶሳ፥ ባርታላሞሳ፥ ቶማሳ፥ ቃራጻ አክያ ማቶሳ፥ እልፕዮሳ ናኣ ያቆባነ ታዶሳ፤ <verse eid="MAT 10:3"/><verse number="4" style="v" sid="MAT 10:4"/>ባረ ጋደዉ ቃረትያ ስሞናነ የሱሳ አ እሜዳ አስቆሮቱ ይሁዳ።<verse eid="MAT 10:4"/></para>
  <para style="s1">የሱስ ኪቴዳ ታማነ ላአቱ ታማርሳናዉ ኪተቴድኖ</para>
  <para style="r">(<ref loc="MRK 6:7-13">ማር. 6:7-13</ref>፤ <ref loc="LUK 9:1-6">ሉቃሳ 9:1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>የሱስ ሀ ታማነ ላአቱዋ ሀዋዳን ያጊደ ኪቴዳ፤ “አይሁዳ ግደና አሳ ጋድያ ቦፕተ፤ ቃይ ሳማረቱዋ ካታማካ ገሎፕተ፤ <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>ሄዋ ድራ ባዬዳ ዶርሳኮ፥ እስራኤልያ አሳኮ <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>ቢደ፥ ‘ሳሉዋ ካዉተይ ማቴዳ’ ያጊደ ኦድተ።<note caller="-" style="x"><char style="xo" closed="false">10:7-15 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">ሉቃሳ 10:4-12</ref></char></note> <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>ሀርጋንቻቱዋ ፓተ፤ አሃ ሀይቁዋፐ ደንተ፤ ኦሉ ኦይቄዳዋንታ ፓተ፤ ኢታ አያናቱዋካ ከስተ። ህንተንቱ ጮ አኬድታ፤ ጮ እምተ። <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/>ዎርቃ ዎይ ብራ ዎይ ሳንትምያ ህንተንቱ ኪስያን ኦይቆፕተ፤ <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>ዎይ ኦገዉ ቃርጪትያ፥ ዎይ ላኤንያ ማዩዋ፥ ዎይ ጫማ ዎይ ጻምኣ ኦይቆፕተ። አያዉ ጎፐ፥ ኦሳንቻዉ ኮሽያባይ ቁማ።<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 ቆሮ. 9:14</ref>፤ <ref loc="1TI 5:18">1 ጽሞ. 5:18</ref></char></note><verse eid="MAT 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11"/>“ህንተንቱ ገልያ ካታማን ዎይ ቄር ካታማ ኡባን ህንተና ሞካናዉ ናሸትያዌ ኦነንቶ አኬካን ጾሞስተ፤ ህንተንቱ ሄዋፐ ከሳና ጋካናዉ፥ ሄዋን ኡትተ። <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>ቃይ ጎለ ገሊደ ሳሮትተ። <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>ሄ ጎለን ደእያ አሳይ ህንተና ሞኮፐ፥ ህንተንቱ ሳሮቴዳ ሳሮታይ ኡንቱንታ ጋኮ። ሽን ኡንቱንቱ ህንተና ሞከናን እጾፐ፥ ህንተንቱ ሳሮቴዳ ሳሮታይ ህንተዉ ጉየ ስሞ። <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>ቃይ እት እት ጎሊ ዎይ ካታማይ ህንተና ሞከናን ዎይ ህንተንቱ ኦድያዋ ስሰናን እጾፐ፥ ሄ ጎለፐ ዎይ ሄ ካታማፐ ከሲደ፥ ህንተንቱ ገድያፐ ባና ሾጭተ። <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>ታን ህንተዉ ቱሙዋ ኦዳይ፤ ጾሳይ ፕርድያ ጋላስ ሄ ካታማ አሳፐ፥ ሶዶማ ካታማ አሳዉነ ጋሞራ ካታማ አሳዉ ፕርዳ ካዉሽሳና።<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 11:24">ማቶሳ 11:24</ref>፤ <ref loc="GEN 19:24-28">ዶመ 19:24-28</ref></char></note><verse eid="MAT 10:15"/></para>
  <para style="s1">ጎዳይ ያናፐ ካሰቲደ፥ የደርሱነ መቱ ሀናና</para>
  <para style="r">(<ref loc="MRK 13:9-13">ማር. 13:9-13</ref>፤ <ref loc="LUK 21:12-17">ሉቃሳ 21:12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>“በእተ! ታን ህንተና ዶርሳ ዋላቱዋ ግዶ የድያዋዳን የዳይ። ሄዋ ድራዉ፥ ሾሻዳን ጭንጫ ግድተ፤ ቃይ ሀራጵያዳን፥ አሽከ ግድተ። <verse eid="MAT 10:16"/><verse number="17" style="v" sid="MAT 10:17"/>ሽን አሳፐ ናገትተ። አያዉ ጎፐ፥ አሳይ ህንተና ፕርዳ ጎለዉ አደ እማና፤ ቃይ ባረ አይሁዳ ዎሳ ጎለቱዋንካ ህንተና ልሱዋን ፔዳና።<note caller="-" style="x"><char style="xo" closed="false">10:17-20 </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">ማር. 13:9-11</ref>፤ <ref loc="LUK 12:11-12">ሉቃሳ 12:11-12</ref>፤ <ref loc="LUK 21:12-15">21:12-15</ref></char></note> <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>ጋድያ አይስያዋንቱ ስንንነ ካታቱዋ ስንን ታ ድራዉ ህንተንቱ ኤቂደ፥ ኡንቱንቶነ አይሁዳ ግደና አሳ ስንን ታዉ ማርካ ግዳንታ። <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>ሽን ኡንቱንቱ ህንተና ፕርዳዉ አያ ዎደ፥ ህንተንቱ ሃሳያናባ ሄ ሳትያን ጾሳይ ህንተዉ እምያ ድራዉ፥ ህንተንቱ ጋናባዉነ ዎይ ዋጊደ ሃሳያነንቶነ ህርጎፕተ። <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>አያዉ ጎፐ፥ ህንተንቱን አቂደ ሃሳይያዌ ህንተንቱ አዉዋ ጌሻ አያናፐ አትን፥ ሃሳይያዋንቱ ህንተንታ ግድክታ።<verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>“እሻይ ባረ እሻ፥ አዉ ባረ ናኣ ቦላ ደንዳና፤ ናናይ ባረንቱ አትነ አዉዋ ቦላ ደንዲደ፥ ኡንቱንታ ዎሳና። <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>ቃይ አሳይ ኡባይ ህንተንታ ታ ሱን ድራዉ እጻና፤ ሽን ዉርሰይ ጋካናዉ ገንጭያዌ አታናዋ። <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/>ኡንቱንቱ ህንተና እት ካታማፐ የደርሶፐ፥ ሀራ ካታማ ቢተ። አያዉ ጎፐ፥ ታን ህንተዉ ቱሙዋ ጋይ፤ ታን፥ አሳ ናአይ፥ ያና ጋካናዉ፥ ህንተንቱ ህንተ ኦሱዋ እስራኤልያ ካታማ ኡባን ኦደ ዉርስክታ።<verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>“ታማርያዌ ባረና ታማርስያዋፐ ዳረና፤ ቆማይካ ባረ ጎዳፐ ዳረና። <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>ታማርያዌ ባረና ታማርስያዋ ኬና ግድያዌ፥ ቆማይካ ባረ ጎዳ ኬና ግድያዌ አዉ ግዳና፤ ኡንቱንቱ ጎለ ጎዳ ብኤል-ዘቡላ ጊደ ጼሶፐ፥ አ ጎለ አሳ ዋግ ጼሳኔሻ!<verse eid="MAT 10:25"/></para>
  <para style="s1">ኦስ ያያናዉ በስንቶ</para>
  <para style="r">(<ref loc="LUK 12:2-7">ሉቃሳ 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>“ስም አሳዉ ያዮፕተ፤ አያዉ ጎፐ፥ ገን ዎዳባይ ቆንጭያ ከሰናን አተና፤ ቆሴዳባይካ ኤረተናን አተና። <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>ታን ህንተንቶ ማን ኦድያባ ፖኡዋን ሃሳይተ፤ ህንተዉ ሀይን ሳሱኪደ ኦዴዳዋ፥ ቃሳን አዋይተ። <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>አሹዋ ዎያዋንቶ ያዮፕተ፤ ኡንቱንቱ፥ ሸምፑዋ ዎናዉ ዳንዳይክኖ። ሽን ሸምፑዋነ አሹዋ ጋናምያን ይሳናዉ ዳንዳይያ ጾሳዉ ያይተ። <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>ላኡ ሱንያ ካፋቱ ሳንትምያን ዛልኤትክኖ? ህንተንቱ አዉዋ ሸንያ ግዳና ዮፐ፥ ሄ ሱንያ ካፋቱዋፐ እትናካ ሳኣን ዎደ ባዩኩ። <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>ሽን ሀራይ አቶ፥ ህንተንቱ ሁጲያን ደእያ ብናናይ ኡባይካ ፓይዱዋን ደኤ። <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>ስም ያዮፕተ፤ ዳሮ ሱንያ ካፋቱዋፐ ህንተንቱ አታ።<verse eid="MAT 10:31"/></para>
  <para style="s1">ክርስቶሳባ ማርካታናዉ በሴ</para>
  <para style="r">(<ref loc="LUK 12:8-9">ሉቃሳ 12:8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>“ሄዋ ድራዉ፥ አሳ ስንን ታባ ማርካትያ ኦስ ግዶፐነ፥ ታንካ ሳሉዋን ደእያ ታ አቡ ስንን ማርካታና፤ <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>ሽን አሳ ስንን ታና ካድያ ኦናነ ታንካ ቃይ ሳሉዋን ደእያ ታ አቡ ስንን አ ካዳና።<note caller="-" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="2TI 2:12">2 ጽሞ. 2:12</ref></char></note><verse eid="MAT 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>“ታን ሳአዉ ሳሮተ አሀናዉ ዬዳዋ ህንተዉ ማላቶፖ፤ ታን ቶራ አሀናዉ ዬዳዋፐ አትን፥ ሳሮተ አሀናዉ ያበይከ። <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/>አያዉ ጎፐ፥ ታን ናኣ አ አቡፐ፥ ናቶ እዝ ዳይፐ፥ ናኣ ማቻቶካ እዝ ቦሎታትፐ ሻካናዉ ያድ፤<note caller="-" style="x"><char style="xo" closed="false">10:35 </char><char style="xt" closed="false"><ref loc="MIC 7:6">ሚክ. 7:6</ref></char></note> <verse eid="MAT 10:35"/><verse number="36" style="v" sid="MAT 10:36"/>አሳዉ ሞርከቱ አ ጎለ አሳቱዋ ግዳናዋንታ።<verse eid="MAT 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37"/>“ባረ አባ ዎይ ባረ ዳዮ ታፐ አደ ሲቅያዌ ታዋ ግዳናዉ በሰና፤ ባረ አቱማ ናኣ ዎይ ባረ ማጫ ናቶ ታፐ አደ ሲቅያዌ ታዋ ግዳናዉ በሰና። <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>ባረ ማስቃልያ ቶኪደ፥ ታ ጌዱዋ ካለናዌ ታዋ ግዳናዉ በሰና። <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>ባረ ሸምፑዋ አሽያዌ ባይዛናዋ፤ ሽን ታ ድራዉ ባረ ሸምፑዋ ባይዝያዌ አሻናዋ።<verse eid="MAT 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>“ህንተንታ ሞክያዌ ታና ሞኬ፤ ቃይ ታና ሞክያዌ ታና ኪቴዳዋ ሞኬ። <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>ናብያ፥ ናብያ ሱንን ሞክያዌ፥ ናብያ ጋትያ አናና ግሸታናዋ፤ ቃይ ጽሉዋ፥ ጽሉዋ ሱንን ሞክያዌ፥ ጽሉዋ ጋትያ አናና ግሸታናዋ። <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>ኦንነ ሀ ታና ካልያዋንቱፐ ጉጽያ እቶ፥ ሀራይ አቶ ቡልያ ሃ ጻላላ ኡሻናዉ እሞፐካ፥ ታን ህንተንቶ ቱሙዋ ጋይ፤ እ ባረ ጋትያ አካና” ያጌዳ።<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s1">ጻማቅያ ዮሃንሳፐ የሱሳኮ ኪተቴዳ አሳቱዋ</para>
  <para style="r">(<ref loc="LUK 7:18-35">ሉቃሳ 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>የሱስ ባረ ታማነ ላኡ ካልያዋንታ አዛዝያዋ ፖሌዳ ዎደ፥ ሄዋፐ ደንዲደ፥ ካታማቱዋን ታማርሳናዉነ ኦዳናዉ ቤዳ።<verse eid="MAT 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>ጻማቅያ ዮሃንስ ቃሾ ጎለን ደኢደ፥ የሱስ ኦዳዋ ስሲደ፥ ባረና ካልያዋንታ አኮ ኪቲደ፥ <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>“ያናዌ ኔኔየ? ዎይ ሀራ ናጋኔ?” ያግ ኦቻናዳን ኦዳ።<verse eid="MAT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4"/>የሱስ ዛሪደ፥ ኡንቱንቶ ሀዋዳን ያጌዳ፤ “ቢደ ህንተንቱ በእያዋነ ስስያዋ ዮሃንሳዉ ኦድተ፤ <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>ቆቃቱ ጼሊኖ፤ ዎባቱ ሀመቲኖ፤ ኦሉ ኦይቄዳዋንቱ ፓጺደ ጌዪኖ፤<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="ft" closed="false">ፓጺደ ጌዪኖ ግያዋ ሎይ አኬካናዉ 8:2 ጻደና ደእያ ብለን ጻፈቴዳዋ በአና ዳንዳየቴ።</char></note> ቱላቱ ስሲኖ፤ ሀይቄዳዋንቱ ደንዲኖ፤ ህዬሳቱ ዎንጋላ ምሽራቹዋ ስሲኖ።<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">ኢሳ. 35:5-6</ref>፤ <ref loc="ISA 61:1">61:1</ref></char></note> <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>ታባ ስና ኡራይ አንጀቴዳዋ” ያጌዳ።<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>ዮሃንሳ ካልያዋንቱ ስም ቤዳ ዎደ፥ የሱስ ዮሃንሳባ ሺቄዳ አሳዉ ሀዋዳን ያግ ሃሳዬዳ፤ “አያ በአናዉ አሳይ ደኤና መላ ቢታ ከሴድቴ? ጫርኩ ቃያ ማቃ በአናዉ ከሴድቴ? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>ያትና፥ አያ በአናዉ ከሴድቴ? ሎእያ ማዩዋ ማዬዳ ብታንያ በአናዉ ከሴድቴ? ሎእያ ማዩዋ ማዬዳዋንቱ ካታቱዋ ጎለን ደኢኖ። <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>ያትና፥ አያ በአናዉ ከሴድቴ? ናብያ በአናዉ ከሴድቴ? ኤ፥ ታን ህንተዉ ኦዳይ፤ ናብያፐካ አያዋ በኤድታ። <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/>አያዉ ጎፐ፥ ጾሳ ማጻፋን፥</para>
  <para style="q1" vid="MAT 11:10">“ ‘ጾሳይ፥ “በአ፥ ታን ኪትያዋ</para>
  <para style="q2" vid="MAT 11:10">ኔፐ ስንዉ የዳና።”</para>
  <para style="q1" vid="MAT 11:10">እ ነዉ ኦግያ ጊግሳናዋ’ ያጌዳ</para>
  <para style="m" vid="MAT 11:10">ጌተቲደ ዮሃንሳባይ ጻፈቴዳ።”<note caller="-" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚልክ. 3:1</ref></char></note><verse eid="MAT 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11"/>ታን ህንተንቶ ቱሙዋ ኦዳይ፤ አት ኡሉዋፐ የለቴዳ አሳ ኡባን ጻማቅያ ዮሃንሳፐ አያዌ ኦንነ ደንድቤና፤ ሽን ሳሉዋ ካዉተን ኡባፐ ላፍያዌ አፐ አና። <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>ጻማቅያ ዮሃንሳ ዎድያፐ ዶሚደ፥ ሀቼ ጋካናዉ፥ ሳሉዋ ካዉተታ ዳሮ ናቀታዉ፤ ምን ባጸትያዋንቱ እዞ ደሚኖ። <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/>አያዉ ጎፐ፥ ናባቱ ኡባቱነ ሙሴ ህጊ ዮሃንሳ ዎዲ ጋካናዉ፥ ትምቢትያ ሃሳዬድኖ፤ <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>ስም ህንተንቱ ኡንቱንቱ ሃሳዮዋ አማናናዋ ግዶፐ፥ ያናዋ ጌተቴዳ ኤላስ ሀ ዮሃንሳ።<note caller="-" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚልክ. 4:5</ref>፤ <ref loc="MAT 17:10-13">ማቶሳ 17:10-13</ref>፤ <ref loc="MRK 9:11-13">ማር. 9:11-13</ref></char></note> <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>ስስያ ሀይይ ደእያዌ ስሶ!<verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>“ሽን ታን ሀ ዎድያ አሳ አያና ሌምሶ? ኡንቱንቱ ቆጫን ኡትያ ናና ማላቲኖ፤ ኡንቱንቱ ባረንቱ ላገቱዋ ጼሲደ፥ <verse eid="MAT 11:16"/><verse number="17" style="v" sid="MAT 11:17"/>‘ኑን ህንተንቶ ህጽጽያ ፑኔዶ፤ ሽን ዱርበይክታ፤ ዬኩዋ የካ ከሴዶ፤ ሽን ዬክበይክታ’ ያጊኖ። <verse eid="MAT 11:17"/><verse number="18" style="v" sid="MAT 11:18"/>አያዉ ጎፐ፥ ዮሃንስ ጾሚደነ ዎይንያ ኤሳ ኡሸናን ዪና ኡንቱንቱ፥ ‘አ ቦላ ኢታ አያናይ ደኤ’ ያጌድኖ። <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>ታን፥ አሳ ናአይ፥ ማደነ ኡሻደ ዪና፥ ኡንቱንቱ ታና፥ ‘ሀ ናፍሳማነ ዎይንያ ኤሳ ኡሽያዋ በእተ፤ ቃራጻ ቃንጽያዋንቱናነ ናጋራንቻቱዋና ሲቀቴ’ ያጊኖ፤ ሽን ጾሳ አዳ ኤራተይ ባረ ኦሱዋን ቱማ ግዲደ ቤቴ” ያጌዳ።<verse eid="MAT 11:19"/></para>
  <para style="s1">አማነናን እጼዳ ድራዉ ቶሸቴዳ ካታማቱዋ</para>
  <para style="r">(<ref loc="LUK 10:13-15">ሉቃሳ 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>ሄዋፐ ጉይያን፥ የሱስ ባረ ማላታፐ ዳርያ ባጋ ኦዳ ካታማቱዋን ደእያ አሳይ ባረንቱ ናጋራፐ ስምቤና ድራዉ፥ ኡንቱንታ ሀዋዳን ያጊደ፥ ቶሽያ ዶሜዳ፤ <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>“ኮራዚነ ካታማዉ፥ ነዉ አየሮ፤ ቤተሳይዳ ካታማዉ፥ ነዉካ አየሮ፤ አያዉ ጎፐ፥ ህንተንቱ ቦላ ጾሳይ ኦዳ ማላታይ ጺሮሳ ካታማንነ ሲዶና ካታማን ኦሰቶዋ ግድንቶ፥ ኡንቱንቱ ማቅያ ማዪደ፥ ብድን ኦከቲደ፥ በን ባረንቱ ናጋራፐ ስማናዋንታሽን።<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">ኢሳ. 23:1-18</ref>፤ <ref loc="EZK 26:1-28:26">ህዝ. 26:1—28:26</ref>፤ <ref loc="JOL 3:4-8">ኢዩ. 3:4-8</ref>፤ <ref loc="AMO 1:9-10">አሞጻ 1:9-10</ref>፤ <ref loc="ZEC 9:2-4">ዛካ. 9:2-4</ref></char></note> <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>ታን ህንተዉ ኦዳይ፤ ፕርዳ ጋላስ ጾሳይ ህንተፐ ጺሮሳ ካታማዉነ ሲዶና ካታማዉ ፕርዳ ካዉሽሳና። <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/>ቃይ ቅፍርናሆማ ካታማዉ፥ ኔን ሳሉዋ ፑደ ቁ ጋናዉ ኮያድ? ኔን ስኦልያ ዱገ የገታና፤ አያዉ ጎፐ፥ ነ ቦላ ጾሳይ ኦዳ ማላታይ ሶዶማ ካታማን ኦሰቶዋ ግድንቶ፥ ሶዶማ ካታማይ ሀቼ ጋካናስካ ደአናዋሽን።<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">ኢሳ. 14:13-15</ref>፤ <ref loc="GEN 19:24-28">ዶመ 19:24-28</ref></char></note> <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>ታን ህንተዉ ኦዳይ፤ ፕርዳ ጋላስ ጾሳይ ኔፐ ሶዶማዉ ፕርዳ ካዉሽሳና” ያጌዳ።<verse eid="MAT 11:24"/></para>
  <para style="s1">የሱሳን ሸምፑዋ ደምያዋ</para>
  <para style="r">(<ref loc="LUK 10:21-22">ሉቃሳ 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>የሱስ ሄ ዎደ ዛሪደ፥ ሀዋዳን ያጌዳ፤ “ታ አቦ፥ ሳሉዋ ሳኣ ጎዳዉ፥ ኔን ሀዋ አዳ ኤራንቻቱዋፐነ አኬካንቻቱዋፐ ገንደ፥ ኤረና ናናቶ ቆንጭሴዳ ድራዉ፥ ኔና ጋላታይ፤ <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>ኤ ታ አቦ፥ አያዉ ጎፐ፥ ሀዌ ነ ሸንያዳን ኦሰቴዳ።<verse eid="MAT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27"/>“ታ አቡ ታዉ ኡባባ እሜዳ፤ አዉዋፐ ሀራይ ናኣ ኤረና፤ ናኣፐነ ናአይ አዉዋ ቆንጭሳናዉ ኮይያ አሳፐ አትን፥ ሀራይ አዉዋ ኤረና።<verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>“ዳቡራንቻቶ፥ ዴጹዋ ቶኮዋንቶ ኡባቶ፥ ታኮ ሃ ዪተ፤ ታን ህንተንታ ሸምፕሳና። <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>ታን ጋራነ ታ ዎዛናን አሽከ ግዶ ድራዉ፥ ታ ሞርገ ምን ዋጸትተ፤ ታፐ ታማርተ፤ ህንተንቱ ሼምፖካ ህንተ ሸምፑዋ ደማና።<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="JER 6:16">ኤር. 6:16</ref></char></note> <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>አያዉ ጎፐ፥ ታ ሞርገ ምይ ጊጋ፤ ቃይ ታን ህንተንታ ቶሴዳዌካ ካዉሻ” ያጌዳ።<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s1">ሳምባታባዉ ሺቄዳ ኦሻ</para>
  <para style="r">(<ref loc="MRK 2:23-28">ማር. 2:23-28</ref>፤ <ref loc="LUK 6:1-5">ሉቃሳ 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>የሱስ ሄ ዎደ ሳምባታ ጋላስ፥ ትሻ ባንጋ ግዶና አሽን አ ካልያዋንቱ ኮሻቲደ፥ ትሻ ባንጋ ዱደ፥ ሙሳ ዶሜድኖ።<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ዛረ. 23:25</ref></char></note> <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>ሽን ፓርሳዋቱ ሄዋ በኢደ የሱሳ፥ “በአ፥ ኔና ካልያዋንቱ ሳምባታ ጋላስ ኦናዉ ዎጋ ግደናባ ኦኖ” ያጌድኖ።<verse eid="MAT 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3"/>ሽን የሱስ ኡንቱንቶ ሀዋዳን ያጌዳ፤ “ዳዊተነ አናና ደእያዋንቱ ኮሻቴዳ ዎደ፥ ዳዊተ ኦዳዋ ናባብ በይክቴ?<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 ሳሜላ 21:1-6</ref></char></note> <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>ዳዊተ ጾሳ ጎለ ገሊደ፥ ቄሳቱዋ ጻላላይ ማናፐ አትን፥ እነ አናና ደእያዋንቱ ማናዉ ዎጋ ግደና ጾሳዉ ያርሼዳ ቁማ ሜዳ።<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ዎጋ 24:9</ref></char></note> <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>ዎይ ሳምባታ ኡባን ጌሻ ጎልያን ደእያ ቄሳቱ ሳምባታ ዎጋ መንያዋ፥ ቃይ ኡንቱንቶ ሄዌ ባይዞ ግደናዋ ሙሴ ህግያን ናባብ በይክቴ?<note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="NUM 28:9-10">ፓይ. 28:9-10</ref></char></note> <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>ሽን ታን ህንተዉ ኦዳይ፤ ጌሻ ጎልያፐ አያዌ ሀዋን ደኤ። <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>ጾሳ ማጻፋይ፥ ‘ታን ማሮተ ኮያይፐ አትን፥ ያርሹዋ ኮይከ’ ያግያዌ ዋግያዌንቶ ህንተንቱ ኤሪተንቶ፥ ባይዙ ባይና አሳ ቦላ ፕርድክታ።<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="MAT 9:13">ማቶሳ 9:13</ref>፤ <ref loc="HOS 6:6">ሆሰ 6:6</ref></char></note> <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>አያዉ ጎፐ፥ ታን፥ አሳ ናአይ፥ ሳምባታ ጎዳ” ያጌዳ።<verse eid="MAT 12:8"/></para>
  <para style="s1">የሱስ ኩሺ ጉንዴዳ ብታንያ ፓዳ</para>
  <para style="r">(<ref loc="MRK 3:1-6">ማር. 3:1-6</ref>፤ <ref loc="LUK 6:6-11">ሉቃሳ 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>የሱስ ሄዋፐ ደንዲደ፥ አይሁዳ ዎሳ ጎለ ቤዳ። <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>ሄዋን ኩሺ ጉንዴዳ እት ብታኒ ደኤ፤ የሱሳ ሞታናዉ ጋሱዋ ኮይያ አሳቱ፥ “ሳምባታን፥ ሀርጋንቻ ፓያዌ ዎጌ?” ያጊደ አ ኦቼድኖ።<verse eid="MAT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11"/>የሱስ ኡንቱንታ፥ “ህንተንቱ ግዶን እት ዶርሳይ ደእያ ኡራይ፥ ሄ ዶርሳይ ሳምባታ ጋላስ ኦላን ኩንዶፐ፥ ኦይቂደ ከሰናዌ ኦኔ? <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>ያትና፥ አሳይ ዶርሳፐ ዎት ሎይደ ዳረኔ! ሄዋ ድራዉ፥ ሳምባታ ጋላስ ሎኦባ ኦያዌ ዎጋ” ያጌዳ። <verse eid="MAT 12:12"/><verse number="13" style="v" sid="MAT 12:13"/>ሄዋፐ ጉይያን ብታንያ፥ “ነ ኩሽያ ፕድ ኦ” ያግና ብታኒ ፕድ ኦዋፐ ጉይያን፥ አ ኩሺ የኮ ኩሽያዋዳንካ ፓጽ አጌዳ። <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>ሽን ፓርሳዋቱ ካረ ከሲደ፥ የሱሳ ዎት ዎነንቶ ማቀቴድኖ።<verse eid="MAT 12:14"/></para>
  <para style="s1">ጾሳይ ዶሬዳ አይልያ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>ሽን የሱስ ኡንቱንቱ ዞረታ ኤሪደ፥ ሄዋፐ አጊደ ብያ ዎደ፥ ዳሮ አሳይ አ ካሌዳ፤ ሀርጌዳ ኡባ ፓዳ። <verse eid="MAT 12:15"/><verse number="16-17" style="v" sid="MAT 12:16-17"/>ጾሳይ ናብያ ኢስያሳ ባጋና ኦዴዳዌ ፖለታና ማላ፥ የሱስ አሳቶ፥ “ታባ ሀራ አሳዉ ኦዶፕተ” ያጌዳ። <verse eid="MAT 12:16-17"/><verse number="18" style="v" sid="MAT 12:18"/>ጾሳይ ኢስያሳ ባጋና ሀዋዳን ያጌዳ፤</para>
  <para style="q1" vid="MAT 12:18">“ታን ዶሬዳ ታ አይሊ፥</para>
  <para style="q2" vid="MAT 12:18">ታን ሲቅያ፥ ታና ናሸችያዌ ሀዌኩ።</para>
  <para style="q1" vid="MAT 12:18">ታን ታ አያና አ ቦላ ዎና።</para>
  <para style="q2" vid="MAT 12:18">እ ሱረ ፕርዳ አሳዉ ኡባዉ ኦዳናዋ።<note caller="-" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">ኢሳ. 42:1-4</ref></char></note><verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>እ ፓሉመተና፤ ዎይ ዋሰና።</para>
  <para style="q2" vid="MAT 12:19">ባረ ቃላካ ኦግያን ስሰና።<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>ሱረ ፕርዳይ ጾን ከሳና ጋካናዉ፥</para>
  <para style="q2" vid="MAT 12:20">ትንጨቴዳ ማቃ መንና፤<note caller="+" style="f"><char style="fr" closed="false">12:20 </char><char style="ft" closed="false">አ። ትንጨቴዳ ማቃ መንና፤ ሀዋ ጉሳይ፥ ማዱ ባይናዋንቶነ ዳቡራንቻቶ የሱስ ኬካነ ጋራ ጉሳ። ብ። ጩዋትያ ሙቃዳ ቁንጩትያካ እ ቶይሰና ጉሳይ፥ የሱስ ዳቡራንቻቶ ጉዙማ ግደናዳን ኬካ ጉሳ።</char></note></para>
  <para style="q2" vid="MAT 12:20">ቃይ ጩዋትያ ሙቃዳ ቁንጩትያካ እ ቶይሰና።<verse eid="MAT 12:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21"/>አይሁዳ ግደና አሳይ ኡባይ፥</para>
  <para style="q1" vid="MAT 12:21">አ ቦላ ባረንቱ ህዶታ ዎና”</para>
  <para style="m" vid="MAT 12:21">ያጌዳ።<verse eid="MAT 12:21"/></para>
  <para style="s1">የሱሳባነ ብኤል-ዘቡላባ</para>
  <para style="r">(<ref loc="MRK 3:20-30">ማር. 3:20-30</ref>፤ <ref loc="LUK 11:14-23">ሉቃሳ 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>ሄዋፐ ጉይያን፥ አማሬዳ አሳቱ ኢታ አያናይ ኦይቂና ዱዴዳ እት ቆቃ ብታንያ የሱሳኮ አሄድኖ፤ የሱስ ሄ ዱደ ብታንያ ፓዳ፤ ብታኒካ ሃሳያነ ጼላ ዶሜዳ። <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>አሳይ ኡባይ ማላለቲደ፥ “ላ ሀዌ ዳዊተ ናኣ ግዳንዴሻ?” ያጌድኖ።<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>ሽን ፓርሳዋቱ ሄዋ ስሲደ፥ “ሀ ብታኒ ኢታ አያናቱዋ ካፑ ‘ብኤል-ዘቡል’ ባረዉ ዎልቃ እምና፥ ጻላሀቱዋ ከሴ” ያጌድኖ።<verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>ሽን የሱስ ኡንቱንቱ ቆፋ ኤሪደ፥ ኡንቱንታ ሀዋዳን ያጌዳ፤ “ባረ ግዶን ሻከትያ ካዉተይ ኡባይ ያና፤ ቃይ ባረ ግዶን ሻከትያ ካታማይ ዎይ ጎለን ደእያ አሳይካ ምነና። <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>ቃይ ሴጻናይ ሴጻና ከስያዋ ግዶፐ፥ ባረ ግዶን ሻከቴ፤ ያትና፥ አ ካዉተይ ዋኒደ ምን ኤቃናዌ? <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>ታዉ ብኤል-ዘቡል ዎልቃ እምና፥ ታን ጻላሀቱዋ ከስያዋ ግዶፐ፥ ህንተንቱ አሳዉ ዎልቃ ኦን እምና ጻላሀቱዋ ከሳኔ? ሄዋ ድራዉ፥ ኡንቱንቱ ህንተ ቦላ ፕርዳና። <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>ሽን ጾሳ ጌሻ አያናይ ታዉ ዎልቃ እምና፥ ታን ጻላሀቱዋ ከስያዋ ግዶፐ፥ ስም ጾሳ ካዉተይ ህንተ ቦላ ይ ድጌዳ።<verse eid="MAT 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29"/>“ዎይ አሳይ ካሰቲደ፥ ዎልቃማ አሳ ቃቼናን ደኢደ፥ አ ጎለ ገሊደ፥ አ ሚሻ ቦንቃናዉ ዋኒደ ዳንዳዪ? ቃቼዳዋፐ ጉይያን፥ አ ሚሻ ቦንቃናዉ ዳንዳዬ።<verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>“ታ ባጋ ግደና ኡራይ ታዋ እጼ፤ ቃይ ታናና እትፐ ሺሸናዌ ላሌ። <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>ሄዋ ድራዉ፥ ታን ህንተዉ ኦዳይ፤ ጾሳይ አሳዉ አይ ናጋራ ግድናካ፥ ቃይ አይ ቦረ ግድናካ አቶ ጋና፤ ሽን ጌሻ አያና ቦርያዋ አቶ ጌና። <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>ታ ቦላ፥ አሳ ናኣ ቦላ፥ ኢታባ ሃሳይያ ኦ ናጋራነ ጾሳይ አቶ ጋና፤ ሽን ጌሻ አያና ቦላ ኢታባ ሃሳይያ ኦ ናጋራነ ሳኣን ግድና፥ ሳሉዋንካ ጾሳይ አቶ ጌና።<verse eid="MAT 12:32"/></para>
  <para style="s1">ሎኦ ምይ ባረ አይፍያን ኤረቴ</para>
  <para style="r">(<ref loc="LUK 6:43-45">ሉቃሳ 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>“ሎኦ አይፍያ ደማናዉ ሎኦ ም ድቻናዉ በሴ፤ ኢታ ም ህንተንቱ ድቾፐ፥ ኢታ አይፍያ ደማንታ፤ አያዉ ጎፐ፥ ምይ ኤረትያዌ ባረ አይፍያ አይፍያዋና። <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>ሾሻቶ፥ ህንተንቱ ኢታ ግዲደ፥ ዎት ሎኦባ ሃሳያናዉ ዳንዳዪቴ? አያዉ ጎፐ፥ ዶናይ ዎዛና ግዶን ኩሜዳዋ ሃሳዬ። <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/>ሎኦ አሳይ ባረ ሎኦ ምንጁዋፐ ሎኦባ ከሴ፤ ቃይ ኢታ አሳይ ባረ ኢታ ምንጁዋፐ ኢታባ ከሴ። <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>ታን ህንተንቶ ኦዳይ፤ አሳይ ባረ ሃሳዬዳ ማደና ሃሳያ ኡባዉ ፕርዳ ጋላስ ዛሩዋ እማናዋ። <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>አያዉ ጎፐ፥ ነ ሃሳያይ ኔና ጽልሳና፤ ዎይ ነ ሃሳያይ ነ ቦላ ፕርድሳና” ያጌዳ።<verse eid="MAT 12:37"/></para>
  <para style="s1">ማላታ በአናዉ ሺቄዳ ኦሻ</para>
  <para style="r">(<ref loc="MRK 8:11-12">ማር. 8:11-12</ref>፤ <ref loc="LUK 11:29-32">ሉቃሳ 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>ሄዋፐ ጉይያን፥ ህግያ ታማርስያ እት እት አሳይነ ፓርሳዋቱ ዛሪደ የሱሳ፥ “ታማርስያዎ፥ ኔን ማላታ ኦሽን፥ ኑን በአናዉ ኮዬቶ” ያጌድኖ።<verse eid="MAT 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39"/>ሽን እ ዛሪደ፥ ኡንቱንቶ ሀዋዳን ያጌዳ፤ “ሀ ዎድያ አሳይ ኢታነ ጾሳ አማነና ድራዉ፥ ማላታ ኮዬ፤ ናብያ ዮናሳ ማላታፐ አትን፥ ሀራ ማላታይ እመተና። <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>ዮናስ ዎጋ ሞልያ ኡሉዋን ሄዙ ጋላሳነ ሄዙ ቃማ ደኤዳዋዳን፥ አሳ ናአይካ፥ ቢታ ግዶን ሄዙ ጋላሳነ ሄዙ ቃማ ደአናዋ። <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/>ነነዌ አሳይ ዮናስ ኦዴዳዋን ባረንቱ ናጋራፐ ስሜዳ ድራዉ፥ ፕርዳ ጋላስ ደንዲደ፥ ህንተንታ ሞታናዋንታ፤ በይተ፥ ዮናሳፐ አያዌ ሀዋን ደኤ። <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>ዱገ ባጋ ጋድያ ካታታ ሶሎሞነዉ ደእያ አ ኤራተ ስሳናዉ ሳኣ ጋጻፐ ዬዳ ድራዉ፥ ፕርዳ ጋላስ ደንዳደ፥ ህንተንታ ሞታናዉኑ፤ በይተ፥ ሶሎሞነፐካ አያዌ ሀዋን ደኤ።<note caller="-" style="x"><char style="xo" closed="false">12:42 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 ካታ. 10:1-10</ref>፤ <ref loc="2CH 9:1-12">2 ኦዱዋ 9:1-12</ref></char></note><verse eid="MAT 12:42"/></para>
  <para style="s1">ኢታ አያናይ አሳ ጋርሳ ስሚደ ገልያዋ</para>
  <para style="r">(<ref loc="LUK 11:24-26">ሉቃሳ 11:24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>“ኢታ አያናይ አሳፐ ከሴዳ ዎደ፥ ባረዉ ሸምፕያ ሳ ኮዪደ፥ ሃይ ባይና መላሳና ዩዬ፤ ሽን ደመና። <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>ሄ ዎደ፥ ‘ታን አጋደ ዬዳ ታ ጎለ ስማና’ ያጌ፤ ስሚደ ይያ ዎደ፥ ጎሊ መላ ደእያዋነ ፕተት ጌዪደ፥ ጊግ ኡቴዳዋ ደሜ። <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>ሄዋፐ ጉይያን፥ ቢደ ባረፐ ኢትያ ላፑ ሀራ አያናቱዋ አኪደ ዬ፤ ሄ አያናቱ ገሊደ፥ ሄዋን ደኢኖ። ሄ ብታንያ ደኡ ካሰዋፐ ዳሪ ኢቴ። ሀ ዎድያ ኢታ አሳዉካ ቃይ ሄዋዳን ሀናና” ያጌዳ።<verse eid="MAT 12:45"/></para>
  <para style="s1">የሱሳ ዳዮነ አ እሻቱዋ</para>
  <para style="r">(<ref loc="MRK 3:31-35">ማር. 3:31-35</ref>፤ <ref loc="LUK 8:19-21">ሉቃሳ 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>የሱስ ዳሮ አሳዉ ሃሳይሽን፥ አ ዳያነ አ እሻቱ አናና ሃሳያናዉ ኮዪደ፥ ካረን ኤቄድኖ። <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>ሄዋን ደእያ አሳፐ እቱ አ፥ “ነ ዳያነ ነ እሻቱ ኔናና ሃሳያናዉ ኮዪደ፥ ካረን ኤቄድኖ” ያጌዳ።<note caller="+" style="f"><char style="fr" closed="false">12:47 </char><char style="ft" closed="false">እት እት ጌሻ ማጻፋ ብለን ሀ ፓይዱ ባዋ።</char></note><verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>ሽን የሱስ ዛሪደ፥ “ታ ዳያ ኦኔ? ታ እሻቱ ኦኔ?” ያጌዳ። <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>ባረ ኩሽያን ባረና ካልያዋንቱኮ ጾርሲደ፥ “በይተ፥ ታ ዳያነ ታ እሻቱ ሀዋንቱሽ። <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>አያዉ ጎፐ፥ ሳሉዋን ደእያ ታ አቡ ሸንያ ኦያ ኡባይ፥ ታ እሻ፥ ታ ምቻቶነ ታ ዳዮ” ያጌዳ።<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s1">ዘርያዋ ሌምሱዋ</para>
  <para style="r">(<ref loc="MRK 4:1-9">ማር. 4:1-9</ref>፤ <ref loc="LUK 8:4-8">ሉቃሳ 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>የሱስ ሄ ጋላስ ሶይፐ ከሲደ፥ አባ ጋጻን ኡቴዳ። <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>ዳሮ ጮራ አሳይ ባረ ዩሹዋን ዩይ አደ ሺቅና፥ ዎንግርያ ግዶ ገሊደ ኡቴዳ፤ አሳይ ኡባይ አባ ጋጻን ኤቄዳ። <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>አሳዉ ሌምሱዋን ዳሮባ ሀዋዳን ያጊደ ኦዴዳ፤ “እት ብታኒ ዘረ ዘራናዉ ከሴዳ። <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>እ ዘርሽን፥ እት እት ዘረይ ኦግያ ዶናን ዎዳ፤ ያትና ካፉ ዪደ ሜዳ። <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>ቃይ እት እት ዘረይ አንጮ ግዴዳ ቢታ ቦላ ዎዳ፤ ዳሮ ቢታይ ባይና ድራዉ፥ ሄ ዘረይ ኤለካ ዶሌዳ። <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>ሽን አዋይ ከሴዳ ዎደ ጫርሻይ ሹሌዳ፤ አዱሳ ጻጱዋ የድቤና ድራዉ መል አጌዳ። <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>እት እት ዘረይ አጉን ግዶን ዎዳ፤ ሄዋን ዶሌዳዋ አጉንይ ድጪደ ጩሌዳ። <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>እት እት ዘረይ ቱኤ ቢታን ዎደ ዶሌዳ፤ እቱ ጼቱ አይፍያ፥ እቱ ኡሱፑን ታሙዋ፥ እቱ ሀታሙዋ አይፌዳ። <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>ስስያ ሀይይ ደእያ ኡራይ ስሶ!” ያጌዳ።<verse eid="MAT 13:9"/></para>
  <para style="s1">የሱስ ሌምሱዋን ኦዶ ጋሱዋ</para>
  <para style="r">(<ref loc="MRK 4:10-12">ማር. 4:10-12</ref>፤ <ref loc="LUK 8:9-10">ሉቃሳ 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>የሱሳ ካልያዋንቱ አኮ ሺቂደ፥ “ኔን አያዉ አሳዉ ሌምሱዋን ኦዳይ?” ያጌድኖ።<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>የሱስ ዛሪደ፥ ኡንቱንቶ ሀዋዳን ያጌዳ፤ “ህንተንቶ ሳሉዋ ካዉተ ጹራ ኤሩሳይ እመቴዳ፤ ሽን ኡንቱንቶ እመትቤና። <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>አያዉ ጎፐ፥ ደእያዎ ጉጀታና፤ አዉ ዳራናዋ፤ ሽን ባይናዋፐ ሀራይ አቶ፥ ሄ ደእያዌካ አከታናዋ። <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>ታን ኡንቱንቱ ጼሊደ ጼለናዋዳን፥ ስሲደ ስሰናዋዳን ሀንያ ድራዉ፥ ዎይ ቃይ አኬከና ድራዉ ኡንቱንቶ ሌምሱዋን ኦዳይ።<verse eid="MAT 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 13:14"/>“እስያስ ኡንቱንቱባ ሀዋዳን ኦዶዌ ፖለታናዋ፤</para>
  <para style="q1" vid="MAT 13:14">“ ‘ህንተንቱ ስሳ ስሳና፤</para>
  <para style="q2" vid="MAT 13:14">ሽን ህንተንቶ ገለና፤</para>
  <para style="q2" vid="MAT 13:14">ህንተንቱ ጼላ ጼላና፤</para>
  <para style="q2" vid="MAT 13:14">ሽን በእክታ።<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">ኢሳ. 6:9-10</ref></char></note><verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>አያዉ ጎፐ፥ ሀ አሳ ዎዛናይ ጉዙሜዳ፤</para>
  <para style="q2" vid="MAT 13:15">ባረንቱ ሀይ ቱልሴድኖ፤</para>
  <para style="q2" vid="MAT 13:15">ባረንቱ አይፍያካ ጪሉሜድኖ።</para>
  <para style="q2" vid="MAT 13:15">ሀዌ ባዌንቶ፥ ኡንቱንቱ ባረንቱ አይፍያን በአና፤</para>
  <para style="q2" vid="MAT 13:15">ባረንቱ ሀይን ስሳና፤</para>
  <para style="q2" vid="MAT 13:15">ባረንቱ ዎዛናንካ አኬካና፤</para>
  <para style="q2" vid="MAT 13:15">ኡንቱንቱ ታኮ፥ ጾሳኮ ስማና፤</para>
  <para style="q2" vid="MAT 13:15">ታንካ ኡንቱንታ ፓና’</para>
  <para style="m" vid="MAT 13:15">ያጌ።<verse eid="MAT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16"/>“ሽን ህንተንቱ አይፊ ጼልያ ድራዉነ ህንተንቱ ሀይይካ ስስያ ድራዉ፥ ህንተንቱ አንጀቴዳዋንታ። <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ዳሮ ናባቱነ ጽላቱ ህንተንቱ በእያዋ በአናዉ አሞቴድኖ፤ ሽን በእበይክኖ። ህንተንቱ ስስያዋ ስሳናዉ አሞቴድኖ፤ ሽን ስስበይክኖ።<verse eid="MAT 13:17"/></para>
  <para style="s1">የሱስ ዘርያዋ ሌምሱዋ ብለ ኦዴዳ</para>
  <para style="r">(<ref loc="MRK 4:13-20">ማር. 4:13-20</ref>፤ <ref loc="LUK 8:11-15">ሉቃሳ 8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>“ስም ካ ዘርያዋ ሌምሱዋ ብለይ ግያዋ ስስተ። <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>ካዉተ ቃላ ስሲደ፥ አኬከና ኦንነ ኦግያ ዶናን ዎዳ ዘረ ማላ፤ ጻላህያ ካፑ ዪደ፥ ኡንቱንቱ ዎዛናን ዘረቴዳዋ ማጽ ድጌ። <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>አንጮ ቢታን ዎዳ ዘረይ ቃላ ስሲደ፥ ኤለካ ናሸቻን አክያዋንታ ማላቴ። <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/>ሽን ሄ አሳቱ ሀእሳፐ አትን፥ ኡንቱንቱን ጻጱ ባዋ፤ ቃላ ጋሱዋን መቱ ዎይ የደሳይ ይያ ዎደ፥ ኤለካ በት አጊኖ። <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>ቃይ አጉን ግዶን ዎዳዌ ቃላ ስስያዋ በሴ፤ ሽን ሀ ሳኣ ደኦ ህርጉሳይነ ዱረተ ሲቁሳይ ቃላ ጩሌ፤ ሀ ጋሱዋን ሄ ዘረይካ አይፈናን አት አጌ። <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>ቱኤ ቢታን ዘረቴዳዌ፥ ቃላ ስሲደ፥ አኬክያ አሳ በሴ፤ እካ አይፌ፤ እቱ ጼቱዋ፥ እቱ ኡሱፑን ታሙዋ፥ እቱ ሀታሙዋ አይፌ” ያጌዳ።<verse eid="MAT 13:23"/></para>
  <para style="s1">ዛርንግያ ሌምሱዋ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>የሱስ ኡንቱንቶ ሀራ ሌምሱዋ ሀዋዳን ያጊደ ኦዴዳ፤ “ሳሉዋ ካዉተይ ባረ ጎሻን ሎኦ ዘረ ዘሬዳ ብታንያ ማላቴ። <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>ሽን ቃማ አሳይ ገምእሽድግና፥ አ ሞርኪ ዪደ፥ ዛርጋ ዘሬዳዋ ቦላ ዛርንግያ ዘሪደ ቤዳ። <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>ሽን ዛርጋይ ዶል አይፌዳ ዎደ፥ ዛርንጊ ሄ ዎደ ቤቴዳ።<verse eid="MAT 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27"/>“አ ቆማቱ አኮ ዪደ፥ ‘ጎዳዉ፥ ኔን ነ ጎሻን ሎኦ ዘረ ዘራበይኪ? ያትና፥ ዛርንጊ ሀቃፐ ዬዴ?’ ያጌድኖ።<verse eid="MAT 13:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="MAT 13:28"/>“ሄዋፐ ጉይያን ጎዳይ፥ ‘ሄዋ ሞርኪ ኦዳ’ ያጌዳ።</para>
  <para style="q2" vid="MAT 13:28">ቆማቱ፥ ‘ኑን ቢደ ሾዳናዳን ዶሳይ?’ ያጌድኖ።<verse eid="MAT 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29"/>“ሽን እ፥ ‘አግተ፥ ዛርንግያ ህንተንቱ ሾዲደ፥ ዛርጋና ሾዳንታ። <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>ቦቾፕተ፤ ቆይጭያ ዎዲ ጋካናዉ፥ እትፐ ድጭኖ። ቆይጭያ ዎዲ ጋኮደ፥ ታን ቆይጭያዋንታ፥ ካሰቲደ ዛርንግያ ማጽተ፤ ታማን ጉዳናዉ ፖችያን ፖችያን ቃችተ፤ ሽን ዛርጋ ሺሺደ ድይያን ቆልተ’ ጋና” ያጌዳ።<verse eid="MAT 13:30"/></para>
  <para style="s1">ሳናፍጭያ ጌተትያ ምት ዘረ ሌምሱዋ</para>
  <para style="r">(<ref loc="MRK 4:30-32">ማር. 4:30-32</ref>፤ <ref loc="LUK 13:18-19">ሉቃሳ 13:18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>የሱስ ኡንቱንቶ ሀራ ሌምሱዋ ያጊደ ኦዴዳ፤ “ሳሉዋ ካዉተይ ሳናፍጭያ ጌተትያ ጉ ምት አይፍያ ማላቴ፤ ሄ ምት አይፍያ አሳይ አኪደ፥ ባረ ጎሻን ዘሬዳ። <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>ሄ ዘረታ ሀራ ዘረ ኡባፐ ጉጻዉ፤ ሽን ድጬዳ ዎደ፥ ሀራ አታክልትያ ኡባፐ ዳራዉ፤ ካፉ ዪደ፥ እዝ ቃንካን ኬጽያዋ ኬና ዎጋ ም ግዳዱ” ያጌዳ።<verse eid="MAT 13:32"/></para>
  <para style="s1">እርሹዋ ሌምሱዋ</para>
  <para style="r">(<ref loc="LUK 13:20-21">ሉቃሳ 13:20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>ቃይ የሱስ ሀራ ሌምሱዋ ኡንቱንቶ ያጊደ ኦዴዳ፤ “ሳሉዋ ካዉተይ እት ምሽራታ ሄዙ ከርያ ልያ አካደ፥ ሙናቄዳ ሙናቃይ ኡባይ ደንዳና ጋካናዉ፥ አን ትጌዳ እርሹዋ ማላቴ” ያጌዳ።<verse eid="MAT 13:33"/></para>
  <para style="s1">የሱስ ሌምሱዋን ታማርሴዳ ጋሱዋ</para>
  <para style="r">(<ref loc="MRK 4:33-34">ማር. 4:33-34</ref>)</para>
  <para style="p">
    <verse number="34-35" style="v" sid="MAT 13:34-35"/>የሱስ አሳዉ ሄ ኡባ ሌምሱዋን ኦዴዳ፤ ሌምሱ ባይናን እ እትባካ ኦደና፤ ናቢ፥</para>
  <para style="q1" vid="MAT 13:34-35">“ታን ኡንቱንቶ ሃሳይያ ዎደ፥</para>
  <para style="q2" vid="MAT 13:34-35">ሌምሱዋን ሃሳያይ።</para>
  <para style="q1" vid="MAT 13:34-35">አላሚ መቶደፐ ዶሚደ</para>
  <para style="q2" vid="MAT 13:34-35">ጌሜዳ የዋቱዋ ኦዳይ”<note caller="-" style="x"><char style="xo" closed="false">13:34-35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">ማዝ. 78:2</ref></char></note></para>
  <para style="m" vid="MAT 13:34-35">ያጌዳዌ ፖለታና ማላ፥ ሄዋ እ ኦዴዳ።<verse eid="MAT 13:34-35"/></para>
  <para style="s1">የሱስ ዛርንግያ ሌምሱዋ ብለ ኦዴዳ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>ሄዋፐ ጉይያን፥ የሱስ አሳ አጊደ፥ ሶይ ገሌዳ፤ አ ካልያዋንቱ አኮ ቢደ፥ “ጎሻን ደእያ ዛርንግያ ሌምሱዋ ብለ ኑዉ ኦዳ” ያጌድኖ።<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>የሱስ ዛሪደ፥ ሀዋዳን ያጌዳ፤ “ሎኦ ዘረ ዘርያዌ አሳ ናኣ፤ <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>ጎሻይ ሀ አላምያ፤ ሎኦ ዘረይ ጾሳ ካዉተ አሳ፤ ዛርንጊ ጻላህያ ካፑዋ ናና። <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>ዛርንግያ ዘሬዳዌ ሞርክያ ጻላህያ፤ ቆይቻ ዎዲ፥ ዎድያ ዉርሰ፤ ቃይ ቆይጭያዋንቱ ኪታንቻቱዋ።<verse eid="MAT 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40"/>“ሄዋ ድራዉ፥ ዛርንግያ ማጺደ፥ ታማን ጉድያዋዳን፥ ዎድያ ዉርሰን ሄዋ ማላ ግዳናዋ። <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>አሳ ናአይ፥ ኪታንቻቱዋ ኪታናዋ፤ ኡንቱንቱ አ ካዉተ ግዶን ናጋራዉ ጋሶ ግድያ ኡባቱዋነ ኢታባ ኦያዋንታ ማጺደ ከሳናዋንታ። <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>ያቲደ ቶኤና ታማን ኦላናዋንታ፤ ሄዋን ኡንቱንቱ ዬካናዋንታነ አቻ ቃናዋንታ። <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>ሄ ዎደ ጽላቱ ባረንቱ አቡ ካዉተን አዋዳን ፖአና። ስስያ ሀይይ ደእያ ኡራይ ስሶ!<verse eid="MAT 13:43"/></para>
  <para style="s1">ሞገቴዳ ሚሻ ሌምሱዋ</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>“ሳሉዋ ካዉተይ ጎሻን ሞገቴዳ ሚሻ በሴ፤ እት ብታኒ ሄ ሚሻ ደሚደ፥ ዛሪደ ሞግ አጌዳ፤ ዳሮ ናሸቲደ ቢደ፥ ባረዉ ደእያዋ ኡባ ዛልኢደ፥ ሄ ጎሻ ሻሜዳ።<verse eid="MAT 13:44"/></para>
  <para style="s1">እንቁዋ ጌተትያ ዳሮ አልኦ ሹቻ ሌምሱዋ</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>“ቃይ ሳሉዋ ካዉተይ እንቁዋ ጌተትያ ዳሮ አልኦ ሹቻ ሻማናዉ ኮይያ ዛልአንቻ ማላቴ። <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>ሄ ዛልአንቻይ ዳሮ አልኦ እንቁዋ ደሚደ፥ ቢደ ባረዉ ደእያዋ ኡባ ዛልኢደ፥ አ ሻሜዳ።<verse eid="MAT 13:46"/></para>
  <para style="s1">ዳባ ሌምሱዋ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>“ቃይ ሳሉዋ ካዉተይ ኡባ ቆሞ ሞልያ ኦይቂያ፥ አባን የገቴዳ ዳባ ማላቴ። <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>ሞሊ ዳባ ኩሜዳ ዎደ፥ ሞልያ ኦይቂያ አሳቱ አባፐ ጋጻ ከሲደ ኡቴድኖ፤ ያቲደ ሎኦ ሞልያ ቆሪደ፥ የግያ ሚሻን የጌድኖ፤ ሽን ኢታ ሞልያ ዎራ ኦሌድኖ። <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>ዎድያ ዉርሰን ሄዋዳን ሀናና፤ ኪታንቻቱ ዪደ፥ ናጋራንቻቱዋ ጽላቱዋ ግዶፐ ቆሪደ፥ <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>ቶኤና ታማን ኦላናዋንታ፤ ሄዋን ኡንቱንቱ ዬካናዋንታነ አቻ ቃናዋንታ።<verse eid="MAT 13:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>“ሀዌ ኡባይ ህንተንቶ ገሌዴ?” ያጊደ ኡንቱንታ ኦቼዳ።</para>
  <para style="p" vid="MAT 13:51">ኡንቱንቱ፥ “ኤ” ያጌድኖ።<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>እ፥ “ሄዋ ድራዉ፥ ሳሉዋ ካዉተ ጹራ ሎይ ኤርያ፥ ህግያ ታማርስያ ኡባይ፥ ባረ ሚሻ ሺሽ ዎዳ ጎልያፐ ኦራ ሚሻነ ኤጫ ሚሻ ሻክ ከስያ እዛዋ ማላቴ” ያግ ዛሬዳ።<verse eid="MAT 13:52"/></para>
  <para style="s1">ናዝሬተን የሱሳ ጋኬዳ እጹዋ</para>
  <para style="r">(<ref loc="MRK 6:1-6">ማር. 6:1-6</ref>፤ <ref loc="LUK 4:16-30">ሉቃሳ 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>የሱስ ሀ ሌምሳቱዋ ኦድ ዉርሶዋፐ ጉይያን፥ ሄዋፐ ደንዲደ፥ <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>ባረ ካታማ ናዝሬተ ቤዳ። አይሁዳ ዎሳ ጎለን ታማርስያዋ ስሴዳ አሳይ ማላለቲደ፥ ሀዋዳን ያጌዳ፤ “ሀዌ ሀ አ ኤራተነ ጾሳይ ኦያ ማላታ ኦናዉ ዎልቃ ሀቃፐ አኬዴ? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>ሀዌ አናጽያ ናኣ ግደኔ? አ ዳያ ማይራሞ ግደኬ? አ እሻቱ ያቆባ፥ ዮሴፎ፥ ስሞናነ ይሁዳ ግድክኖ? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>አ ምቻቱ ኡባይ ኑናና ደእክኖ? ያትና፥ እ ሀ ኤራ ኡባ ሀቃፐ ደሜዴ?” ያጌድኖ። <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>ኡንቱንቱ እ ግያባ አከናን እጼድኖ።</para>
  <para style="p" vid="MAT 13:57">ሽን የሱስ ሄ አሳዉ፥ “ናቢ ባረ ጋድያንነ ባረ ሶይ አሳን ቦንቼተና፤ ሽን ሀራሳ ኡባን ቦንቼቴ” ያጌዳ። <verse eid="MAT 13:57"/><verse number="58" style="v" sid="MAT 13:58"/>ኡንቱንቱ አማንቤና ድራዉ፥ የሱስ ዳሮ ማላታ ሄ ሳን ኦቤና።<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s1">ጻማቅያ ዮሃንሳ ሀይቁዋ</para>
  <para style="r">(<ref loc="MRK 6:14-29">ማር. 6:14-29</ref>፤ <ref loc="LUK 9:7-9">ሉቃሳ 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>ሄ ዎደ ጋሊላ ጋድያ አይስያ ሄሮድሰ የሱሳባ ስሴዳ፤ <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>ያቲደ ባረ ቆማቶ፥ “ሀዌ ሀይቁዋፐ ደንዴዳ ጻማቅያ ዮሃንሳ፤ ጾሳይ ኦያ ዎልቃማ ማላታ እ ኦያዌ ሄዋሳ” ያጌዳ።<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>አያዉ ጎፐ፥ ሄሮድስ ባረ እሻ ፕልጶሳ ማቻት ሄሮድያድ ጋሶታን ዮሃንሳ ኦይ ቃሽሲደ፥ ቃሾ ጎለን የግ ዎዳ። <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>አያዉ ጎፐ፥ ዮሃንስ ሄሮድሳ፥ “ኔን ሄሮድያዶ፥ ነ እሻ ማቻቶ አካናዉ ህጊ ድጌ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">14:4 </char><char style="xt" closed="false"><ref loc="LEV 18:16">ዎጋ 18:16</ref>፤ <ref loc="LEV 20:21">20:21</ref></char></note> <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>ሄሮድስ ዮሃንሳ ዎናዉ ኮዬዳ፤ ሽን ይሁዳ አሳይ ናብያዳን ዮሃንሳ ጼሌዳ ድራዉ፥ አሳዉ ያዬዳ።<verse eid="MAT 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6"/>ሽን ሄሮድስ የለቴዳ ጋላሳ ባላይ ጋክና፥ ሄሮድያድ ናታ አሳ ስንን ዱራደ ሄሮድሳ ናሸቻዉ። <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>ሄሮድስ ናቶ፥ “ኔና ሎኤዳዋ አያነ ግዶፐ፥ ታና ኦቻ፤ ታን ነዉ እማና” ያጊደ እዝዉ ጫቄዳ። <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>ናታ ባረ ዳይ ዞርያ አካደ ሄሮድሳ፥ “ጻማቅያ ዮሃንሳ ሁጲያ ሀ ዎጪትያን ዎደ ታዉ እማ” ያጋዱ። <verse eid="MAT 14:8"/><verse number="9" style="v" sid="MAT 14:9"/>ካቲ አዉ ቃረቴዳ፤ ሽን ባረ ጫቁዋ ድራዉነ ባረናና ማዳን ኡቴዳ እማ ድራዉ፥ እዝዉ ዮሃንሳ ሁጲ እመታና ማላ አዛዜዳ። <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>ካቲ ኪቲደ፥ ዮሃንሳ ቆያ ቃሾ ጎለን ሙጭሴዳ። <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>ሁጲያ ዎጪትያን ዎ አሂደ፥ ናትዉ እሜድኖ፤ ናታ ሄ ሁጲያ ባረ አትኮ አፋዱ። <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>ዮሃንሳ ካልያዋንቱ ዪደ፥ አ አሃ አፊደ ሞጌድኖ፤ ሄዋፐ ስሚደ ሀ የዉዋ የሱሳዉ ቢደ ኦዴድኖ።<verse eid="MAT 14:12"/></para>
  <para style="s1">የሱስ እቼሹ ሻአ አሳ ምዜዳ</para>
  <para style="r">(<ref loc="MRK 6:30-44">ማር. 6:30-44</ref>፤ <ref loc="LUK 9:10-17">ሉቃሳ 9:10-17</ref>፤ <ref loc="JHN 6:1-14">ዮሃ. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>የሱስ ሄዋ ስሲደ፥ ዎንግርያን ገሊደ፥ ሄዋፐ ባረካ አሳይ ባይናሳ ቤዳ፤ አሳይ ሄዋ ስሲደ፥ ካታማፐ ደንዲደ፥ ገድያን አ ካሌድኖ። <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>የሱስ ዎንግርያፐ ከሴዳ ዎደ፥ ዳሮ አሳ በኢደ፥ ሄ አሳዉ ቃረቴዳ፤ ያቲደ ኡንቱንቱና ደእያ ሀርጋንቻቱዋ ፓዳ።<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>ሳአይ ኦማርስያ ዎደ፥ የሱሳ ካልያዋንቱ አኮ ዪደ፥ “ሀዌ ሳአይ አሳይ ባይናሳ፤ ሀእ ሳአይ ቃም ድጌዳ፤ አሳይ ኡባይ ቄር ካታማቱዋ ቢደ፥ ባረንቶ ቁማ ሻማና ማላ፥ አሳ ሞይዛ” ያጌድኖ።<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>ሽን የሱስ ኡንቱንታ፥ “አሳይ ባናዉ ኮሸና፤ አሳዉ ሜተትያባ ህንተንቱ እምተ” ያጌዳ።<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>ኡንቱንቱ ዛሪደ አ፥ “ኑዉ ሀዋን እቼሹ ኡክፐነ ላኡ ሞልያፐ አትን፥ ሀራይ ባዋ” ያጌድኖ።<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>የሱስ ኡንቱንታ፥ “ሄዋንታ፥ ሃ ታኮ አህተ” ያጌዳ። <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>አሳይ ማታን ኡታና ማላ፥ የሱስ አዛዜዳ፤ እቼሹ ኡክነ ላኡ ሞልያ ኦይቂደ፥ ሳሉዋ ፑደ ጼሊደ፥ ጾሳ ጋላቴዳ፤ ሄ ኡክ መንደ፥ ባረና ካልያዋንቶ እምና፥ ኡንቱንቱ ጮራ አሳዉ ግሼድኖ። <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>አሳይ ኡባይ ሚደ ካሌዳ፤ አቴዳ ሱፓ ዶካ ታማነ ላኡ ዛምቤልያ ኩሜዳዋ ደንድኖ። <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>ሜዳ አሳይ ማጫ አሳነ ናና ፓይደናን፥ እቼሹ ሻኣ ግድያዋ ኬና።<verse eid="MAT 14:21"/></para>
  <para style="s1">የሱስ አባ ቦላና ሀመቲደ ቤዳ</para>
  <para style="r">(<ref loc="MRK 6:45-52">ማር. 6:45-52</ref>፤ <ref loc="JHN 6:15-21">ዮሃ. 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>የሱስ ጮራ አሳ ሞይዚደ፥ ባረና ካልያዋንታ ዎንግርያን ገሊደ፥ ባረፐ ስንቲደ፥ አባፐ ሄፍን ፕናና ማላ አዛዜዳ። <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>አሳ ሞይዚደ፥ ጾሳ ዎሳናዉ ደርያ ሁጲያ ባረካ ከሴዳ፤ ሳአይ ቃም ድግናካ ሄዋን ባረካ ደኤ። <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>ሽን ዎንግሪ ሄ ዎደ፥ አባ ቦላን ደእሽን፥ ስን ባጋና ጫርኩ ጫርክያ ድራዉ፥ ቤታይ ዎንግርያ ያነ ሃነ ሱጌ።<verse eid="MAT 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25"/>ባይራ ኩቱ ዋስ ስምና፥ የሱስ አባ ቦላ ሀመቲደ፥ ኡንቱንቱኮ ዬዳ። <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>አ ካልያዋንቱ አባ ቦላ እ ሀመትሽን በእ ዳጋሚደ፥ “ሀዌ ሞይትልያ ግደኔ!” ግ ያዪደ ዋሴድኖ።<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>ሽን የሱስ ኤለካ ኡንቱንታ፥ “አይነ ባዋ፤ ታናተ፤ ያዮፕተ!” ያጌዳ።<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>ጰጽሮስ ዛሪደ አ፥ “ታ ጎዳዉ፥ ሀዌ ኔና ግዶፐ፥ ታን ሃ ቦላና ኔኮ ባና ማላ፥ ታና አዛዛርኪ” ያጌዳ።<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>የሱስ ጰጽሮሳ፥ “ሃያ!” ያጌዳ።</para>
  <para style="p" vid="MAT 14:29">ጰጽሮስ ዎንግርያፐ ዎደ፥ ሃ ቦላና ሀመቲደ፥ የሱሳኮ ቡሳ ዶሜዳ። <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>ሽን ጫርኩዋ ዎልቃ በኢደ፥ ያዬዳ፤ ሃይ ባረና ምቱዋ ዶሜዳ ዎደ፥ ባረ ኮሻ ቁ ኦደ፥ “ታ ጎዳዉ ታና አሻርኪ!” ያግ ዋሴዳ።<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>ሄ ማንእያን የሱስ ባረ ኩሽያ የድ ጰጽሮሳ ኦይቂደ፥ “ላ ሀ አማኑ ላፌዳዎ! አያዉ ስዲ?” ያጌዳ።<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>ኡንቱንቱ ላኡ ዎንግርያን ገሌዳ ዎደ፥ ጫርኩ ዎፑ ጌዳ። <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>ዎንግርያ ግዶን ደእያ አ ካልያዋንቱ የሱሳ፥ “ኔን ጾሳ ናኣ ግዴዳዌ ቱማ” ያጊደ አዉ ጎይኔድኖ።<verse eid="MAT 14:33"/></para>
  <para style="s1">የሱስ ገንሳሬጸን ሀርጋንቻ ፓዳ</para>
  <para style="r">(<ref loc="MRK 6:53-56">ማር. 6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>ኡንቱንቱ አባ ፕኒደ፥ ገንሳሬጻ ጌተትያ ጋድያ ጋኬድኖ። <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>ሄ ጋድያ አሳይ የሱሳ ግድያዋ ኤሬድኖ፤ ሄዋ ሄራ ጋድያ ኡባ ኪቲደ፥ ሀርግያ አሳ ኡባ አኮ አሄድኖ። <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>ሀርግያ አሳይ አ ማዩዋ ማጫራ ጻላላ ቦቻና ማላ፥ አ ዎሴድኖ፤ አ ማዩዋ ማጫራ ቦቼዳ ኡባይካ ፓጼዳ።<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s1">አዎቱዋ ዎጋባ</para>
  <para style="r">(<ref loc="MRK 7:1-13">ማር. 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>ሄዋፐ ጉይያን፥ ህግያ ታማርስያ እት እት አሳይነ ፓርሳዋቱ የሩሳላመፐ የሱሳኮ ዪደ፥ <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>“ኔና ካልያዋንቱ አያዉ ኑ አዎቱዋ ዎጋ ባይዚኖ? አያዉ ጎፐ፥ ኡንቱንቱ ቁማ ማናፐ ካሰቲደ፥ ባረንቱ ኩሽያ ሜጨትክኖ” ያጌድኖ።<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>የሱስ ዛሪደ፥ ኡንቱንታ ሀዋዳን ያጌዳ፤ “ህንተንቱ ህንተ ዎጋ ድራዉ፥ ጾሳ አዛዙዋ ፖልያዋ አያዉ እጺቴ? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>አያዉ ጎፐ ጾሳይ፥ ‘ነ አባነ ነ ዳዮ ቦንቻ’ ቃይ፥ ባረ አባ ዎይ ባረ ዳዮ ቦርያዌ ሀይቆ ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ከሳ 20:12</ref>፤ <ref loc="EXO 21:17">21:17</ref>፤ <ref loc="DEU 5:16">ዛረ. 5:16</ref>፤ <ref loc="LEV 20:9">ዎጋ 20:9</ref></char></note> <verse eid="MAT 15:4"/><verse number="5-6" style="v" sid="MAT 15:5-6"/>ሽን ህንተንቱ፥ ‘እት አሳይ ባረ አባ ዎይ ባረ ዳዮ ማድያባይ ባረዉ ደኢና፥ ሄዌ ጾሳዋ ጎፐ፥ ባረ አባ ዎይ ባረ ዳዮ ቦንቻናዉ በሰና’ ያጊታ፤ ያቲደ ህንተንቱ ህንተንቱ ዎጋ ፖላናዉ ጾሳ ቃላዉ አዛዘትክታ። <verse eid="MAT 15:5-6"/><verse number="7" style="v" sid="MAT 15:7"/>ሀ ሎአ ማላትያ ኢታ አሳቶ፥ እስያስ ባለናን ህንተንቱባዉ ትምቢትያ ኦዲደ፥<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>“ ‘ጾሳይ ሀዋዳን ያጌዳ፤</para>
  <para style="q2" vid="MAT 15:8">“ሀዌ አሳይ ታና፥</para>
  <para style="q2" vid="MAT 15:8">ባረ ቦላ ዶናን ቦንቼ፤</para>
  <para style="q2" vid="MAT 15:8">ሽን ኡንቱንቱ ዎዛናይ፥</para>
  <para style="q2" vid="MAT 15:8">ታፐ ሃኩዋን ደኤ።<verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>አሳይ ታዉ መላ ጎይኔ፤</para>
  <para style="q2" vid="MAT 15:9">አያዉ ጎፐ፥ አሳይ ኦዳ አዛዙዋ፥</para>
  <para style="q1" vid="MAT 15:9">ጾሳ ህግያ ማላትሲደ፥</para>
  <para style="q2" vid="MAT 15:9">ታማርሴድኖ” ጌዳ’ ”</para>
  <para style="m" vid="MAT 15:9">ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="ISA 29:13">ኢሳ. 29:13</ref></char></note><verse eid="MAT 15:9"/></para>
  <para style="s1">አሳ ቱንስያዋንታ</para>
  <para style="r">(<ref loc="MRK 7:14-23">ማር. 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>የሱስ ዳሮ አሳ ባረኮ ጼሲደ፥ “ስስተነ አኬክተ፤ <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>አሳ ቱንስያዌ ዶና ግዶ ገልያዋ ግደና፤ ሽን አሳ ቱንስያዌ ዶናፐ ከስያዋ” ያጌዳ።<verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>ሄዋፐ ጉይያን፥ አ ካልያዋንቱ አኮ ዪደ፥ “ፓርሳዋቱ ኔን ሃሳዬዳዋ ስሲደ፥ ሀንቀቴዳዋ አኬካይ?” ያጌድኖ።<verse eid="MAT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13"/>ሽን የሱስ ዛሪደ፥ “ሳሉዋን ደእያ ታ አቡ ቶክቤና ም ኡባይ ሾደታናዋ። <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>ኡንቱንቶ ህርጎፕተ፤ ኡንቱንቱ ቆቃ ካለያ ቆቃቱዋ፤ ቆቃይ ቆቃ ካለፐ፥ ላኡካ ኦላን ኩንዴ” ያጌዳ።<verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>ጰጽሮስ ዛሪደ፥ “ሀ ሌምሱዋ ብለ ኑዉ ኦዳርኪ” ያጌዳ።<verse eid="MAT 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16"/>የሱስ ኡንቱንታ ሀዋዳን ያጌዳ፤ “ህንተንቶ ቃይ ሀእ ጋካናዉካ ገልቤኔ? <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>ዶናና ገልያ ኡባይ ኡሉዋ ግዶ ቢደ፥ ቃይ ኡሉዋፐ ካረ ከስያዋ ኤርክቴ? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>ሽን ዶናፐ ከስያዌ ዎዛናፐ ከሴ፤ አሳ ቱንስያዌ ሄዋ ማላ። <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>አያዉ ጎፐ፥ ዎዛና ግዶፐ ኢታ ቆፋይ፥ ዎያዌ፥ ዎሹምያዌ፥ ቃይ ዎሹማናዉ ካጄልያዌ ኡባይ፥ ዉእያዌ፥ ዎርዱዋን ማርካትያዌ፥ ቦሪ ከሴ። <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>ሄዋ ማላትያዌ አሳ ቱንስያዋፐ አትን፥ ሜጭቤና ኩሽያን ምያዌ አሳ ቱንሰና” ያጌዳ።<verse eid="MAT 15:20"/></para>
  <para style="s1">ካናነ አሳ ግዴዳ እት ማጫዉን አማኑዋ</para>
  <para style="r">(<ref loc="MRK 7:24-30">ማር. 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>ሄዋፐ ጉይያን፥ የሱስ ሄዋፐ አጊደ፥ ጺሮሳነ ሲዶና ጌተትያ ካታማቱ ደእያ ጋድያ ቤዳ። <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>ካናነ ጌተትያ ጋድያ ማጫዉና እትና ሄዋፐ የሱሳኮ ያደ፥ ባረ ኮሻ ቁ ኦደ፥ “ታ ጎዳዉ፥ ዳዊታ ናአዉ፥ ታዉ ቃረታርኪ፤ ታ ናቶ ኢታ አያናይ ሎኤና ኦይ ኦይቄዳ” ያጋዱ።<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>ሽን የሱስ እዝዉ አይ ቃላነ ቃትቤና፤ አ ካልያዋንቱ አኮ ዪደ፥ “ሀ ምሽራታ ኑ ጌዱዋ ካላ ካላደ፥ ባረ ኮሻ ቁ ኦደ ኦዳዉ፤ ሄዋ ድራዉ፥ ኔን እዞ የዳርኪ” ያጊደ ዎሴድኖ።<verse eid="MAT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24"/>የሱስ ዛሪደ፥ “ታን ባዬዳ ዶርሳዉ፥ እስራኤልያ አሳ ጻላላዉ ኪተታድ” ያጌዳ።<verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>ሽን እዛ ያደ፥ “ታ ጎዳዉ፥ ታና ማዳርኪ!” ያጋደ አዉ ጎይናዱ።<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>ቃይ እ ዛሪደ፥ “ናና ቁማ አኪደ፥ ካና ማራዉ ኦልያዌ ሎአ ግደና” ያጌዳ።<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>ምሽራታ፥ “ኤ ታ ጎዳዉ፥ ሄዌ ቱማ፤ ሽን ሀራይ አቶ ካና ማራቱ ባረንቱ ጎዳቱ ሚና፥ ሳምፓፐ ላለቴዳ ሱፓ ሚኖተኔ” ያጋዱ።<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>የሱስ ዛሪደ እዞ፥ “ሀ ምሽራቴ፥ ነ አማኑ ዎልቃማ፤ ኔን ኮዬዳዋዳን ነዉ ሀኖ” ያጌዳ። እዝ ናታ ኤለካ ፓጻ አጋዱ።<verse eid="MAT 15:28"/></para>
  <para style="s1">የሱስ ጮራ ሀርጋንቻቱዋ ፓዳ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>የሱስ ሄዋፐ ደንዲደ፥ ጋሊላ አባ ማታ ቤዳ፤ ቃይ እት ደርያ ቦላ ከሲደ፥ ሄዋን ኡቴዳ። <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>ዳሮ አሳይ ዎባቱዋ፥ ቆቃቱዋ፥ ቁናቱዋነ ዱደቱዋ፥ ቃይ ሀራ ጮራቱዋ አኮ አሂደ፥ አ ማታን ዎዳ። የሱስ ኡንቱንታ ፓዳ። <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>ሄዋ ድራዉ፥ አሳይ ዱዳቱ ሃሳይሽን፥ ቁናቱ ሱርሽን ዎባቱ ሀመትሽን፥ ቆቃቱ ጼልሽን በእ ማላለቲደ፥ እስራኤልያ ጾሳ ጋላቴድኖ።<verse eid="MAT 15:31"/></para>
  <para style="s1">የሱስ ኦይዱ ሻአ አሳ ምዜዳ</para>
  <para style="r">(<ref loc="MRK 8:1-10">ማር. 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>የሱስ ባረና ካልያዋንታ ባረኮ ጼሲደ፥ “ሀ ጮራ አሳይ ታናና ሄዙ ጋላሳይ ጋካናዉ ጋምኤዳ ድራዉ፥ ታን ሀ አሳዉ ቃረታይ፤ ኡንቱንቶ ሀእ ምያዌ ባዋ። ቃይ ኡንቱንቱ ኦግያን ዳቡሪደ ኩንደና ማላ፥ ቁማ ምዘናን ኡንቱንታ መላ የዳናዉካ ኮይከ” ያጌዳ።<verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>አ ካልያዋንቱ ዛሪደ የሱሳ፥ “ኑን ሀ ባዙዋን ሀዋ ኬና አሳ ካልስያ ቁማ ሀቃፐ ደማኔ?” ያጌድኖ።<verse eid="MAT 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34"/>ቃይ የሱስ ኡንቱንታ፥ “ህንተንቶ አፑን ኡክይ ደኢ?” ያጊደ ኦቼዳ።</para>
  <para style="p" vid="MAT 15:34">ኡንቱንቱ፥ “ላፑ ኡክይነ ሞለቱዋፐ አማሬዳዋንቱ ደኢኖ” ያጌድኖ።<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>የሱስ አሳ፥ “ሳኣን ኡትተ” ያጌዳ። <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>ሄ ላፑ ኡክነ ሞልያ ኦይቂደ፥ ጾሳ ጋላቴዳ፤ መንሬደ ባረና ካልያዋንቶ እሜዳ፤ ቃይ ኡንቱንቱ ጮራ አሳዉ እሜድኖ።<verse eid="MAT 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 15:37"/>አሳይ ኡባይ ሚደ ካሌዳ፤ ሚና አቴዳ ላፑ ዛምቤልያ ኩሜዳ ሱፓ አ ካልያዋንቱ ደንድኖ። <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>ሜዳ አሳይ ማጫ አሳነ ናና ፓይደናን፥ ኦይዱ ሻአ አቱማ አሳ። <verse eid="MAT 15:38"/><verse number="39" style="v" sid="MAT 15:39"/>የሱስ አሳ የዶዋፐ ጉይያን፥ ዎንግርያን ገሊደ፥ መገዶነ ጌተትያ ጋድያ ቤዳ።<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s1">ማላታ በአናዉ ኦቼዳ ኦሻ</para>
  <para style="r">(<ref loc="MRK 8:11-13">ማር. 8:11-13</ref>፤ <ref loc="LUK 12:54-56">ሉቃሳ 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>እት እት ፓርሳዋቱነ ሳዱቃዋናቱ የሱሳኮ ዪደ፥ አ ፓጫናዉ ኮዬድኖ፤ ያቲደ ባረንታ ሳሉዋፐ ማላታ በሳና ማላ ዎሴድኖ። <verse eid="MAT 16:1"/><verse number="2" style="v" sid="MAT 16:2"/>ሽን የሱስ ዛሪደ፥ ኡንቱንታ ሀዋዳን ያጌዳ፤ “ሳአይ ቃምያ ዎደ ህንተንቱ፥ ‘ሳሉ ዞኤዳ ድራዉ፥ ሳአይ ሻማናዋ’ ያጊታ፤ <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>ዎንቱማን ቃይ፥ ‘ሳሉ ዞኢደ ጉባኔዳ ድራዉ፥ ሀቼ እራይ ቡካናዋ’ ያጊታ፤ ሳሉዋ ጼሊደ፥ ሳአይ ሀናናዋ ኤራናዉ ዳንዳዪታ፤ ሽን ታ ዩሳ ዎድያ ማላታ ሻክ ኤራናዉ ዳንዳይክቴ?<note caller="+" style="f"><char style="fr" closed="false">16:3 </char><char style="ft" closed="false">እት እት ጌሻ ማጻፋ በን ብለቱዋን የሱሳ ቃላቱ ሀ ፓይዳቱዋን ባዋ።</char></note> <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>ሀ ዎድያ አሳይ ኢታይነ ዎሹምያዌ፥ ጾሳዉ አማነተናዌ፥ ማላታ ኮዬ፤ ናብያ ዮናሳ ማላታፐ አትን፥ ሀራ ማላታይ አዉ እመተና” ያጌዳ። ሄዋፐ ስሚደ፥ ኡንቱንታ አጊደ ቤዳ።<verse eid="MAT 16:4"/></para>
  <para style="s1">ፓርሳዋቱዋነ ሳዱቃዋናቱዋ እርሹዋ</para>
  <para style="r">(<ref loc="MRK 8:14-21">ማር. 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>አ ካልያዋንቱ አባ ፕኔዳ ዎደ፥ ቁማ አፋናዋ ዶጌድኖ። <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>የሱስ ኡንቱንታ፥ “ፓርሳዋቱዋ እርሹዋፐነ ሳዱቃዋናቱዋ እርሹዋፐ ህንተንታ ኤሪደ ናገትተ” ያጌዳ።<verse eid="MAT 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7"/>ኡንቱንቱ ባረንቱ ግዶን፥ “እ ሀዋ ያግያዌ ኑን ቁማ አህቤና ድራሳ” ያጊደ ሃሳያ ዶሜድኖ።<verse eid="MAT 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8"/>ሽን ኡንቱንቱ ግያዋ የሱስ ኤሪደ፥ “ሀ አማኑ ፓጬዳዋንቶ፥ ቁማይ ባይና ድራዉ፥ አያዉ ህንተንቱ ግዶን ሃሳዪቴ? <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>ሀእካ ህንተንቶ ገልቤኔ? ታን እቼሹ ኡክ እቼሹ ሻአ አሳ ምዛደ ካልሴዳዋ፥ ቃይ ህንተንቱ አፑን ዛምቤልያ ኩንደ አቴዳ ሱፓ ደንድተንቶ ዎዛና አክቴ? <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>ዎይ ታን ላፑ ኡክ ኦይዱ ሻአ አሳ ምዛ ካልሴዳዋ፥ ቃይ ህንተንቱ አፑን ዛምቤልያ ኩንደ አቴዳ ሱፓ ደንድተንቶ ዎዛና አክቴ? <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>ታን ህንተንታ ፓርሳዋቱዋ እርሹዋፐነ ሳዱቃዋናቱዋ እርሹዋፐ ናገትተ ግያዋፐ አትን፥ ኡክባ ህንተንቶ ሃሳያቤናዋ ህንተንቱ ዋኒደ አኬክክቴ?” ያጌዳ።<verse eid="MAT 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12"/>አ ካልያዋንቱ የሱስ ባረንቶ ኦዴዳዋ፥ ፓርሳዋቱዋ ትምርትያፐነ ሳዱቃዋናቱዋ ትምርትያፐ ኡንቱንቱ ናገታና ማላ ኦደቶዋፐ አትን፥ ሙናቃን ትግያ እርሹዋፐ ናገታና ማላ ግደናዋ ሄ ዎደ አኬኬድኖ።<verse eid="MAT 16:12"/></para>
  <para style="s1">ጰጽሮሳ አማኑዋነ ማርካተ</para>
  <para style="r">(<ref loc="MRK 8:27-30">ማር. 8:27-30</ref>፤ <ref loc="LUK 9:18-21">ሉቃሳ 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>የሱስ ቂሳርያ ፕሊጶሳ ጌተትያ ጋድያ ጋኬዳ ዎደ፥ ባረና ካልያዋንታ፥ “አሳይ ታና፥ አሳ ናኣ ኦና ጊ?” ያጊደ ኦቼዳ።<verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>አ ካልያዋንቱ ዛሪደ፥ “ኔና እት እት አሳይ፥ ጻማቅያ ዮሃንሳ ያጌ፤ ሀራንቱ ቃይ ኤላሳ ያጊኖ፤ ቃይ ሀራንቱ ኤርማሳ ዎይ ናባቱዋፐ እቱዋ ያጊኖ” ያጌድኖ።<verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>የሱስ ኡንቱንታ፥ “ያትና ህንተንቱ ታና ኦና ጊቴ?” ያጌዳ።<verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>ስሞን ጰጽሮስ ዛሪደ፥ “ኔን ደኡዋ ጾሳ ናኣ ክርስቶሳ” ያጌዳ።<verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>የሱስ ዛሪደ፥ ሀዋዳን ያጌዳ፤ “ዮና ናኣ ስሞና፥ ሀዋ ነዉ ሳሉዋን ደእያ ታ አቡ ኤርሴዳዋፐ አትን፥ አሳይ ኦንነ ኔና ኤርስቤና ድራዉ፥ ኔን አንጀቴዳዋ። <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>ጰጽሮሳ፥ ታን ነዉ ኦዳይ፤ ኔን ሹቻ፤ ታን ሀ ዛላ ቦላ ታ ዎሳ ጎልያ ኬጻና፤ ታ ዎሳ ጎልያ ሀራይ አቶ፥ ስኦልያ ዎልቃይካ ጾናናዉ ዳንዳየና። <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/>ታን ነዉ ሳሉዋ ካዉተ ቁልፕያ እማና፤ ኔን ሳኣን ሀኖ ጎዌ ኡባይ ሳሉዋን ጾሳ ስንን ሀናና፤ ሽን ኔን ሳኣን ሀኖፖ ጌዳዌ ሳሉዋንካ ሀነና” ያጌዳ።<verse eid="MAT 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20"/>ሄዋፐ ጉይያን፥ እ ክርስቶሳ ግዴዳዋ አ ካልያዋንቱ ኦስነ ኦደና ማላ፥ ኡንቱንታ አዛዜዳ።<verse eid="MAT 16:20"/></para>
  <para style="s1">የሱስ ባረና ጋካና መቱዋባነ ሀይቁዋባ ኮይሮ ኦዱዋ ኦዴዳ</para>
  <para style="r">(<ref loc="MRK 8:31-33">ማር. 8:31-33</ref>፤ <ref loc="LUK 9:22-27">ሉቃሳ 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>ሄ ዎድያፐ ዶሚደ የሱስ፥ “ታን የሩሳላመ ቢና፥ ታና ጭማቱ፥ ቄሳቱዋ ካፓቱነ ህግያ ታማርስያዋንቱ ዳሪ ዋይሳናዉ በሴ፤ ኡንቱንቱ ታና ዎናዉነ ታን ሄዘን ጋላስ ሀይቁዋፐ ደንዳናዉ በሴ” ያጊደ፥ ባረና ካልያዋንቶ ጌሺደ ኦዱዋ ዶሜዳ።<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>ጰጽሮስ አ እት ባጋ ዛሪደ፥ “ታ ጎዳዉ፥ ጾሳይ ኔና ሄዋፐ አሾ፤ ሀዌ ነ ቦላ ኡባካ ዬና” ያጊደ አ ዞራናዉ ዶሜዳ።<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>ሽን የሱስ ጉየ ስሚደ ጰጽሮሳ፥ “ሀ ሴጻናዉ፥ ኔን ታ ማታፐ ክቻ፤ ኔን አሳይ ዶስያዋ ቆፕያዋፐ አትን፥ ጾሳይ ዶስያዋ ቆፐና ድራዉ፥ ታዉ ቦ ግዳዳ” ያጌዳ።<verse eid="MAT 16:23"/></para>
  <para style="s1">የሱሳ ካላናዉ ኮሽያ ኦግያ</para>
  <para style="r">(<ref loc="MRK 8:34-9:1">ማር. 8:34—9:1</ref>፤ <ref loc="LUK 9:23-27">ሉቃሳ 9:23-27</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>ሄዋፐ ጉይያን፥ የሱስ ባረና ካልያዋንታ ሀዋዳን ያጌዳ፤ “ታና ካላናዉ ኮይያ ኡራይ ደኦፐ፥ ባረና ካዶ፤ ያቲደ ባረ ማስቃልያ ቶኪደ፥ ታና ካሎ። <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>አያዉ ጎፐ፥ ባረ ሸምፑዋ አሻናዉ ኮይያ ኡራይ ባይዛናዋ፤ ሽን ባረ ሸምፑዋ ታ ድራዉ ባይዝያ ኡራይ አሻናዋ። <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>እት ኡራይ ሳኣን ደእያ ኡባባ ባረዉ ሺሺደ፥ ባረ ሸምፑዋ ባይዞፐ፥ አ አያ ማዳኔ? ዎይ እት ኡራይ ባረ ሸምፑዋ ዎዛናዉ አያ እማና ዳንዳዪ? <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/>አያዉ ጎፐ፥ ታን፥ አሳ ናአይ፥ ታ አቡ ቦንቹዋን ታ ኪታንቻቱዋና ያና ሀናይ፤ አሳ ኡባዉ ሄ ዎደ አ ኦሱዋ ጋትያ እማና።<note caller="-" style="x"><char style="xo" closed="false">16:27 </char><char style="xt" closed="false"><ref loc="MAT 25:31">25:31</ref>፤ <ref loc="PSA 62:12">ማዝ. 62:12</ref>፤ <ref loc="ROM 2:6">ሮመ 2:6</ref></char></note> <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/>ታን ህንተንቶ ቱሙዋ ጋይ፤ አማሬዳ አሳቱ፥ ታን፥ አሳ ናአይ፥ ካትያ ግዳደ ይያዋ በአና ጋካናዉ፥ ሀይቀናዋንቱ ሀዋን ደኢኖ” ያጌዳ።<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s1">የሱሳ ማላይ ላመቴዳ</para>
  <para style="r">(<ref loc="MRK 9:2-13">ማር. 9:2-13</ref>፤ <ref loc="LUK 9:28-36">ሉቃሳ 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>የሱስ ኡሱፑን ጋላሳፐ ጉይያን፥ ባረናና ጰጽሮሳ፥ ያቆባነ፥ ያቆባ እሻ ዮሃንሳ አኪደ፥ ኡንቱንቱ ጻላላ ዎጋ ደርያ ሁጲያ ከሴዳ።<note caller="-" style="x"><char style="xo" closed="false">17:1-5 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 ጰጽ. 1:17-18</ref></char></note> <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>ቃይ ኡንቱንቱ ጼልሽን፥ ኡንቱንቱ ስንን ላመቴዳ፤ አ ዴሙ አዋይፍያዳን ፖኤዳ፤ አ ማዩካ ፖኡዋዳን ጶሌዳ። <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>ሙሴነ ኤላስ የሱሳና ሃሳይሽን፥ ሀ ሄዙ አ ካልያዋንቱ በኤድኖ። <verse eid="MAT 17:3"/><verse number="4" style="v" sid="MAT 17:4"/>ጰጽሮስ የሱሳ፥ “ታ ጎዳዉ፥ ኑን ሀዋን ደእያዌ ኑዉ ሎአ፤ ኔን ዶሶፐ፥ ኑን ሀዋን ሄዙ ዳስያ እቱዋ ነዉ፥ እቱዋ ሙሴዉ፥ እቱዋ ኤላሳዉ ኬጻና” ያጌዳ።<verse eid="MAT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5"/>እ ሃሳይሽን፥ ፖእያ ሻሪ ዪነ ኡንቱንታ ካም አጌዳ፤ ሻርያ ግዶፐ፥ “ሀዌ ታን ሲቅያ ታና ናሸችያ ታ ናኣ፤ እ ግያዋ ስስተ” ግያ ቃላይ ዬዳ።<note caller="-" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="GEN 22:2">ዶመ 22:2</ref>፤ <ref loc="DEU 18:15">ዛረ. 18:15</ref>፤ <ref loc="PSA 2:7">ማዝ. 2:7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42:1</ref>፤ <ref loc="MAT 3:17">ማቶሳ 3:17</ref>፤ <ref loc="MAT 12:18">12:18</ref>፤ <ref loc="MRK 1:11">ማር. 1:11</ref>፤ <ref loc="LUK 3:22">ሉቃሳ 3:22</ref></char></note><verse eid="MAT 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6"/>አ ካልያዋንቱ ሄ ቃላ ስሴዳ ዎደ፥ ዳሮ ያዪደ፥ ጉፋን አጌድኖ። <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>የሱስ ኡንቱንቱኮ ዪደ፥ ኡንቱንታ ቦቺደ፥ “ደንድተ፤ ያዮፕተ” ያጌዳ። <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>ኡንቱንቱ ቁ ጊደ ጼልያ ዎደ፥ የሱሳ ጻላላፐ አትን፥ ሀራ አሳ ኦናነ በእበይክኖ።<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>ኡንቱንቱ ደርያፐ ዎሽን፥ የሱስ ኡንቱንታ፥ “ታን አሳ ናአይ፥ ሀይቁዋፐ ደንዳና ጋካናዉ፥ ሀ ህንተንቱ በኤዳዋ ኦስነ ኦዶፕተ” ያጊደ አዛዜዳ።<verse eid="MAT 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10"/>አ ካልያዋንቱ የሱሳ፥ “ያትና፥ ህግያ ታማርስያዋንቱ አያዉ፥ ‘ኤላስ ካሰቲደ ያናዉ በሴ’ ጊኖ?” ያጊደ ኦቼድኖ።<note caller="-" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚልክ. 4:5</ref></char></note><verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>እ ዛሪደ ያጌዳ፤ “ኤላስ ካሰት ዪደ፥ ኡባባ ጊግሳናዋ። <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>ሽን ታን ህንተንቶ ኦዳይ፤ ኤላስ ሀዋፐ ካሰ ይ ድጌዳ። ሄ ዎደ አሳይ አ፥ ባረንቶ ኮዬዳዋዳን ኡባ ኦዳዋፐ አትን አ ኤርበይክኖ፤ ሄዋዳንካ፥ ቃይ ታና፥ አሳ ናኣ፥ አሳይ ዋይሳናዋ” ያጌዳ።<verse eid="MAT 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13"/>አ ካልያዋንቱ ሄ ዎደ ባረንቶ የሱስ ጻማቅያ ዮሃንሳባ ኦድያዋ አኬኬድኖ።<verse eid="MAT 17:13"/></para>
  <para style="s1">የሱስ ኢታ አያናይ ኦይቄዳ ናኣ ፓዳ</para>
  <para style="r">(<ref loc="MRK 9:14-29">ማር. 9:14-29</ref>፤ <ref loc="LUK 9:37-43">ሉቃሳ 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>ኡንቱንቱ ዳሮ አሳኮ ዬዳ ዎደ፥ እት ብታኒ የሱሳኮ ዪደ፥ አ ስንን ጉልባቲደ፥ <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>“ታ ጎዳዉ፥ ታ ናኣ ዎዛና ባይዝያ ሀርጊ ኦይቂና፥ እ ዳሮ ዎደ ታማን፥ ቃይ ዳሮ ዎደ ሃን ኩንድያ ድራዉ፥ እ ዳሪ ሳከቴ፤ አ ፓርኪ። <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>ኔና ካልያዋንቱኮካ አ አሃድ፤ ሽን ፓናዉ ዳንዳይበይክኖ” ያጌዳ።<verse eid="MAT 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17"/>የሱስ ዛሪደ ኡንቱንታ፥ “አማነና ሀ ዎድያ ጌላ አሳዉ! ታን ህንተናና አዉደ ጋካናዉ ደአኔ? ቃይ ህንተንቱባ አዉደ ጋካናዉ ዳንዳያኔ? ናኣ ታኮ ሃ አኪደ ዪተ” ያጌዳ። <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>የሱስ ኢታ አያና፥ “አፐ ከሳ” ጊደ አዛዝና፥ ኢታ አያናይ ናኣፐ ከስ አጌዳ፤ ኤለካ ናአይ ፓጽ አጌዳ።<verse eid="MAT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19"/>ሄዋፐ ጉይያን፥ አ ካልያዋንቱ ባረንቱ ጻላላ የሱሳኮ ዪደ፥ “ኑን ኢታ አያና ከሳናዉ አያዉ ዳንዳይበይኮ?” ያጌድኖ።<verse eid="MAT 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20"/>የሱስ ኡንቱንታ ያጌዳ፤ “ሄዌ ህንተንቱ አማኑ ጉጼዳ ድራሳ፤ ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ህንተንቶ ሳናፍጭያ ጌተትያ ጉ ምት አይፍያ ኬና አማኑ ደእንቶ፥ ህንተንቱ ሀ ደርያ፥ ‘ሀዋፐ ያ ሺቃ’ ያግንቶ እ ሺቃና፤ ህንተንቱ አያነ ኦናዉካ ዳንዳያንታ። <verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/>ሽን ሀዋ ማላ ዎሳፐነ ጾማፐ ሀራባይ ከሳናዉ ዳንዳየና” ያጌዳ።<verse eid="MAT 17:21"/></para>
  <para style="s1">የሱስ ባረ ሀይቁዋባ ላኤንዋ ኦዴዳ</para>
  <para style="r">(<ref loc="MRK 9:30-32">ማር. 9:30-32</ref>፤ <ref loc="LUK 9:43-45">ሉቃሳ 9:43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>አ ካልያዋንቱ ጋሊላን፥ እትፐ ሺቅ ኡት ደእሽን፥ የሱስ ኡንቱንታ፥ “ታና፥ አሳ ናኣ፥ አሳይ አሳዉ አደ እማና። <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>አሳይ ታና ዎናዋ፤ ሄዋፐ ጉይያን ታን ሄዘንያ ጋላስ ሀይቁዋፐ ደንዳና” ያጌዳ። አ ካልያዋንቱ ዳሮ ቃረቴድኖ።<verse eid="MAT 17:23"/></para>
  <para style="s1">ጌሻ ጎልያ ጊራ ጊርያዋ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>የሱስነ አ ካልያዋንቱ ቅፍርናሆማ ካታማ ዬዳ ዎደ፥ ጌሻ ጎልያስ ቃራጻ አክያዋንቱ ጰጽሮሳኮ ዪደ፥ “ህንተንታ ታማርስያዌ ጌሻ ጎልያ ጊራ ጊረኔ?” ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="EXO 30:13">ከሳ 30:13</ref>፤ <ref loc="EXO 38:26">38:26</ref></char></note><verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>እ ዛሪደ፥ “ጊሬ” ያጌዳ።</para>
  <para style="p" vid="MAT 17:25">ጰጽሮስ ሶይ ገሌዳ ዎደ፥ የሱስ ካሰቲደ አ፥ “ስሞና፥ ነ ቆፋይ አዬ? ሀ ሳኣ ካታቱ ቃራጻ ዎይ ጊራ ኦፐ አኪኖ? ባረንቱ ጋድያ አሳፐ አኪኖ ዎይ ሀራ ጋድያ አሳፐ አኪኖ?” ያጌዳ።<verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>ጰጽሮስ፥ “ሀራ ጋድያ አሳፐ አኪኖ” ያጌዳ።</para>
  <para style="p" vid="MAT 17:26">የሱስ ጰጽሮሳ፥ “ያቶፐ፥ ጋድያ አሳይ ጊራናዉ በሰና። <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>ሽን ኑን ሀ አሳቱዋ ሀንቀናዉ ኮዮኮ፤ ኔን አባ ባደ አን ዳባ የጋ፤ ያታደ ኮይሮ ከስያ ሞልያ ኦይቃደ፥ አ ዶና ፖቅያ ዎደ፥ ጊራዉ ግድያ ሚሻ ኔን ደማና። ሄዋ አካደ፥ ታ ጊራነ ነ ጊራ ኡንቱንቶ እማ” ያጌዳ።<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s1">ኡባፐ አያዌ ኦኔ?</para>
  <para style="r">(<ref loc="MRK 9:33-37">ማር. 9:33-37</ref>፤ <ref loc="LUK 9:46-48">ሉቃሳ 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>አ ካልያዋንቱ የሱሳኮ ሄ ዎደ ዪደ፥ “ሳሉዋ ካዉተን ኡባፐ አያዌ ኦኔ?” ያጌድኖ።<verse eid="MAT 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2"/>የሱስ እት ጉ ናኣ ጼስ ኡንቱንቱ ግዶን ኤሲደ፥ ሀዋዳን ያጌዳ፤ <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>“ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ጾሳኮ ህንተንቱ ስሚደ፥ ጉ ናናዳን ሀናና ዮፐ፥ ሳሉዋ ካዉተ ኡባካ ገላናዉ ዳንዳይክታ። <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>ስም ሀ ጉ ናኣዳን፥ ባረና ካዉሽያ ኦንነ ሳሉዋ ካዉተን ኡባፐ አያዋ። <verse eid="MAT 18:4"/><verse number="5" style="v" sid="MAT 18:5"/>ቃይ ሀዋ ማላ ናኣ ታ ሱንን ሞክያ ኦንነ ታና ሞኬ። <verse eid="MAT 18:5"/><verse number="6" style="v" sid="MAT 18:6"/>ሽን ታና አማንያ ሀ ጉ ናናፐ እቱዋ ባለያ ኦንነ፥ ጋጭያ ዎጋ ዎጻ ባረ ቆያን ቃቺደ፥ አባ ጪሙዋን ምተትያዌ አዉ ሎአ።<verse eid="MAT 18:6"/></para>
  <para style="s1">ቦ ጋሶ ግድያዋ</para>
  <para style="r">(<ref loc="MRK 9:42-48">ማር. 9:42-48</ref>፤ <ref loc="LUK 17:1-2">ሉቃሳ 17:1-2</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7"/>“አላሚ አሳ ቢያ ድራዉ፥ ሳአዉ አየሮ፤ አያዉ ጎፐ፥ ቢያባይ ዩሳ አገና፤ ሽን ቡ አ ጋሶታን ይያ ኡራዉ አየሮ።<verse eid="MAT 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8"/>“ኔና ኩሺ ዎይ ነ ገዲ ኔና ባለፐ፥ ኔፐ ቃንጻ ኦላ፤ ኔን ላኡ ኩሽያናነ ላኡ ገድያና መና ታማን ኦለትያዋፐ ዎባ ዎይ ዱጻ ኩሽያና መና ደኡዋ ገልያዌ ነዉ ሎአ። <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/>ቃይ ነ አይፊ ኔና ባለፐ፥ ኔፐ ዎጫ ከሳ ኦላ፤ ኔን ላኡ አይፍያና ጋናምያ ታማን ኦለትያዋፐ እት አይፍያና መና ደኡዋ ገልያዌ ነዉ ሎአ።<verse eid="MAT 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>“ህንተንቱ ሀ ጉቱዋፐ እቱዋነ ካና ማላ፥ ህንተንታ ናግተ፤ አያዉ ጎፐ፥ ታን ህንተንቶ ኦዳይ፤ ሳሉዋን ኡንቱንቱ ኪታንቻቱ ኡባ ዎደ፥ ሳሉዋን ደእያ ታ አቡ ስንን ደኢኖ። <verse eid="MAT 18:10"/><verse number="11" style="v" sid="MAT 18:11"/>አያዉ ጎፐ፥ ታን፥ አሳ ናአይ፥ ባዬዳዋ አሻናዉ ያድ።<verse eid="MAT 18:11"/></para>
  <para style="s1">ባዬዳ ዶርሳ ሌምሱዋ</para>
  <para style="r">(<ref loc="LUK 15:3-7">ሉቃሳ 15:3-7</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>“እት አሳዉ ጼቱ ዶርሳቱ ደእያዋንቱፐ እቱ ባዮፐ፥ ኡዱፑ ታማነ ኡዱፑኑዋ ደርያን አጊደ፥ ሄ ባዬዳዋ ኮያናዉ ቤኔ? ህንተንቱ ዋጊቴ? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>ታን ህንተንቶ ቱሙዋ ጋይ፤ እ ደሞፐ፥ ባይቤና ኡዱፑ ታማነ ኡዱፑ ዶርሳቱዋፐ አደ፥ ሄ እት ዶርሳን ናሸቴ። <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>ሄዋዳንካ፥ ሳሉዋን ደእያ ህንተንቱ አቡ ሀ ጉቱዋፐ እቱ ባያናዋካ ኮየና።<verse eid="MAT 18:14"/></para>
  <para style="s1">ባይዜዳ አሳዉ ኦናዉ በስያባ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>“ነ እሻይ ኔና ናቆፐ፥ ኔረካ አኮ ባደ፥ አ ናቁዋ አዉ ኦዳ፤ እ ነዋ ስሶፐ፥ ነ እሻ ባላፐ ዛራዳ። <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>ሽን እ ነዋ ስሰናን እጾፐ፥ ላኡ ዎይ ሄዙ ማርካይ ማርካቶዋን የዉ ኡባይ ቱማትያ ድራዉ፥ ሀራ እት ዎይ ላኡ አሳ ኔናና እትፐ አፋ። <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>እ ኡንቱንቱባ ስሰናን እጾፐ፥ ኡባባ አማንያ አሳዉ ኦዳ፤ ቃይ አማንያ አሳይ ግያዋካ እ ስሰናን እጾፐ፥ አማነና አሳዳንነ ቃራጻ ሺሽያ አሳዳን አ ፓይዳ።<verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>“ታን ህንተንቶ ቱሙዋ ጋይ፤ ኔን ሳኣን ሀኖ ጎዌ ኡባይ ሳሉዋን ጾሳ ስንን ሀናና፤ ሽን ኔን ሳኣን ሀኖፖ ጌዳዌ ሳሉዋንካ ሀነና።<verse eid="MAT 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19"/>“ቃይካ ታን ህንተንቶ ኦዳይ፤ ህንተፐ ላኡ ኡራይ ሳኣን ጾሳ ዎስያዋን አይ የዉዋንነ እት ዎዛና ግዶፐ፥ ሳሉዋን ደእያ ታ አቡ ሄዋ ህንተንቶ እማና። <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>አያዉ ጎፐ፥ ላኡ ኡራይ ዎይ ሄዙ ኡራይ ታ ሱንን ሺቅያሳን፥ ታን ሄዋን ኡንቱንቱ ግዱዋን ደአይ” ያጌዳ።<verse eid="MAT 18:20"/></para>
  <para style="s1">አቶ ግያዋ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>ጰጽሮስ፤ ሄ ዎደ የሱሳኮ ዪደ፥ “ጎዳዉ፥ ታ እሻይ ታና አፑ ካላ ናቆፐ ታን አዉ አቶ ጋናዉ በሲ? ላፑኑዋ ጋካናዉ ናቂኔዬ?” ያጊደ አ ኦቼዳ።<verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>የሱስ ዛሪደ አ፥ “ግደና፥ ታን ኔና ላፑን ታሙ ካላ ላፑኑዋ ጋይፐ አትን፥ ላፑኑዋ ጻላላ ጊከ።<note caller="-" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="GEN 4:24">ዶመ 4:24</ref></char></note><verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>“አያዉ ጎፐ፥ ሳሉዋ ካዉተይ ባረ ቆማቱዋና ሚሻ ሄተታናዉ ቆፔዳ ካትያ በሴ። <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>ሄ ካቲ ሚሻ ሄተታናዉ ዶሜዳ ዎደ፥ ዳሮ ሚሎነ ብራ አጩ ደእያ እት ብታንያ አኮ አሄድኖ። <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>ሽን ሄ ቆማዉ አጩዋ ጭግያዌ ይና፥ አ ጎዳይ ሄ አጩዋ ጭጋናዉ፥ አ ማቻታነ እነ አ ናናይ፥ ቃይ አዉ ደእያ ኡባባይ ዛልኤታና ማላ፥ አ አዛዜዳ። <verse eid="MAT 18:25"/><verse number="26" style="v" sid="MAT 18:26"/>ሄዋ ድራዉ፥ ቆማይ ባረ ጎዳ ስንን ጉልባቲደ፥ ‘ታ ጎዳዉ፥ ሀያ ጎዶ ጉ ዎድያ ናጋርኪ፤ ታን ነዉ ኡባባካ ጭጋና ያጊደ አ ዎሴዳ።’ <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>አ ጎዳይ አዉ ቃረቲደ፥ አ የድ አጌዳ፤ አ አጩዋካ አዉ ማር አጌዳ።<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>“ሽን ሄ ቆማይ ከሲደ፥ ባረ ላገ ቆማቱዋፐ እቱ ባረፐ ጼቱ ብራ ሳንትምያ ታልኤዳዋና ጋከቲደ፥ ‘ነ ቦላ ደእያ ታ ሚሻ ጭጋ’ ያግ ኦይቂደ፥ አ ጩሌዳ።<verse eid="MAT 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29"/>“ያትና ሄ አ ላገ ቆማይ አ ስንን ጉልባቲደ፥ ‘ሀእ ታይሻይ ጉ ዎድያ ናጋርኪ፤ ታን ነዉ ኡባባካ ጭጋና’ ያጊደ አ ዎሴዳ።<verse eid="MAT 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30"/>“ሽን እጽ አክ ቢደ፥ አ ላገይ ሄ አጩዋ ቃንጻና ጋካናዉ፥ ቃሾ ጎለ ገልሴዳ። <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>ሄዋ ድራዉ፥ አ ላገ ቆማቱ ሄዋ በኢደ፥ ዳሮ ይሎቴድኖ፤ ባረንቱ ጎዳኮ ቢደ፥ እ ኦዳ ኡባባ አዉ ኦዴድኖ።<verse eid="MAT 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32"/>“ሄዋፐ ጉይያን፥ ጎዳይ ሄ ቆማ ጼሲደ፥ ‘ሀ ኢታ ቆማዉ፥ ኔን ታና ዎሴዳ ድራዉ፥ ታን ሄ አጩዋ ኡባ ነዉ ማራ አጋድ። <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>ታን ነዉ ሄ አጩዋ ማሬዳዋዳን፥ ኔንካ ነ ላገ ቆማዉ ማራናዉ በሰኔ?’ ያጌዳ። <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>ሄዋፐ ስሚደ አዉ ዳሮ ሀንቀቲደ፥ ባረ አጩዋ ኡባ እ ጭግ ዉርሳና ጋካናዉ፥ ፓጻ ካኤታና ማላ፥ ቃሾ ጎለ ገልሴዳ።<verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>“ህንተንቱ ሁጲያን ሁጲያን ህንተንቱ እሻዉ ዎዛናፐ አቶ ጋና ዮፐ፥ ሄ ጎዳይ ባረ ቆማ ኦዳዋዳን፥ ሳሉዋን ደእያ ታ አቡካ ህንተንታ ሄዋዳን ኦና” ያጌዳ።<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s1">የሱስ ገሉዋባነ አካባ ታማርሴዳ</para>
  <para style="r">(<ref loc="MRK 10:1-12">ማር. 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>የሱስ ሄ ሃሳያ ዉርሶዋፐ ጉይያን፥ ጋሊላፐ ደንዲደ፥ ዮርዳኖሳ ሻፋፐ ሄፍንን ደእያ ይሁዳ ጋድያ ቤዳ። <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>ዳሮ አሳይ አ ካሊደ ቤዳዋ ሄዋን ፓዳ።<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>እት እት ፓርሳዋቱ ፓጫናዉ የሱሳኮ ዪደ፥ “እት አሳይ አይ ጋሱዋንነ፥ ባረ ማቻቶ የዳናዉ ኑ ህጊ አዛዚ?” ያጊደ አ ኦቼድኖ።<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>የሱስ ዛሪደ፥ ሀዋዳን ያጌዳ፤ “ጾሳይ ኮይሮ ኡንቱንታ መደ፥ አቱማዋነ ማጫዉኖ ኦዳ።<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">ዶመ 1:27</ref>፤ <ref loc="GEN 5:2">5:2</ref></char></note> <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>ሄዋ ድራዉ፥ ‘እት አሳይ ባረ አባነ ባረ ዳዮ አጊደ፥ ባረ ማቻትና እትፐ ደኤ፤ ኡንቱንቱ ላኡ እት አሳ ግዲኖ’ ያግያ ቃላ ናባብበይክቴ?<note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">ዶመ 2:24</ref></char></note> <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>ሄዋ ድራዉ፥ ኡንቱንቱ እት አሳ ግድያዋፐ አትን፥ ላኡ አሳ ግድክኖ፤ ሄዋ ድራዉ፥ ጾሳይ እትፐ ደአናዳን ጋዋ አሳይ ሻኮፖ” ያጌዳ።<verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>ፓርሳዋቱ የሱሳ፥ “ያትና፥ ሙሴ አያዉ እት ኡራይ ባረ ማቻቶ ፕርማ ፔደ የዳና ማላ አዛዜዴ?” ያጌድኖ።<verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>የሱስ ዛሪደ፥ “ህንተንቱ ህንተንቱ ማቻቱዋ የዳና ማላ፥ ሙሴ ህንተንታ አዛዜዳዌ፥ ህንተንቱ ኦድና ስሰና ጉዙማ ግዶ ድራፐ አትን፥ ኮይሮ ሄዋ ማላ ግደና። <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/>ታን ህንተንቶ ኦዳይ፤ ባረ ማቻቶ ዎሹመናን ደእሽን የዲደ፥ ሀራሮ አክያ ኦንነ ዎሹሜ፤ ሀራይ የዴዳዉኖ አክያዌካ ዎሹሜ” ያጌዳ።<verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>የሱሳ ካልያዋንቱ አ፥ “አስና ግዱዋንነ ማቻት ግዱዋን ደእያ ዎጋይ ሄዋ ማላ ግዶፐ፥ አከናንነ ገለናን ደእያዌ ሎአ” ያጌድኖ።<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>ሽን የሱስ ኡንቱንታ ያጌዳ፤ “ሄዋ ማላ ትምርቲ ጾሳይ እሞዋንቱሳፐ አትን፥ አሳ ኡባሳ ግደና፤ <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>አያዉ ጎፐ፥ ባረንቱ ዳይ ኡሉዋፐ የለትያ ዎደካ፥ ሹፋ ግዴዳዋንቱ ደኢኖ፤ ቃይ አሳይ ቃራትና ሙሬሳ ግዴዳዋንቱ ደኢኖ፤ ቃይ ሳሉዋ ካዉተ ድራዉ፥ ባረንታ ሹፋ ኦዳዋንቱ ደኢኖ፤ ሀ ትምርትያ አካናዉ ዳንዳይያዌ ኦንነ አኮ” ያጌዳ።<verse eid="MAT 19:12"/></para>
  <para style="s1">የሱስ ቄር ናና ቦላ ባረ ኩሽያ ዎዳ</para>
  <para style="r">(<ref loc="MRK 10:13-16">ማር. 10:13-16</ref>፤ <ref loc="LUK 18:15-17">ሉቃሳ 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>የሱስ ሄ ዎደ ባረ ኩሽያ ጉ ናና ቦላ ዎደ፥ ጾሳ ዎሳና ማላ፥ እት እት አሳይ ናና አኮ አሄዳ፤ ሽን የሱሳ ካልያዋንቱ ሄ አሳ አሄና ማላ ሀንቀቴድኖ። <verse eid="MAT 19:13"/><verse number="14" style="v" sid="MAT 19:14"/>ሽን የሱስ፥ “ቄር ናናይ ታኮ ይያዋ ድጎፕተ፤ አያዉ ጎፐ፥ ሳሉዋ ካዉተይ ሄዋንቱ ማላሳ” ያጌዳ።<verse eid="MAT 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15"/>ሄዋፐ ስሚደ ባረ ኩሽያ ኡንቱንቱ ቦላ ዎዳዋፐ ጉይያን፥ ሄዋፐ ባሽ ቤዳ።<verse eid="MAT 19:15"/></para>
  <para style="s1">ያላጋ፥ ዱረ ብታንያ ኦሻ</para>
  <para style="r">(<ref loc="MRK 10:17-31">ማር. 10:17-31</ref>፤ <ref loc="LUK 18:18-30">ሉቃሳ 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>እት ብታኒ የሱሳኮ ዪደ፥ “ታማርስያዎ፥ ታን መና ደኡዋ ደማናዉ ሎኦባ አያ ኦ?” ያጌዳ።<verse eid="MAT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17"/>የሱስ አ፥ “ሎኦባይ አየንቶ ታና አያዉ ኦቻይ? እቱዋ ጻላላይ ሎአ፤ ሽን ኔን መናዉ ደአናዉ ኮዮፐ፥ አዛዛቱዋ ናጋ” ያጌዳ።<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>ብታኒ፥ “ሀቃዋንታ?” ያጊደ ኦቼዳ።</para>
  <para style="p" vid="MAT 19:18">የሱስ ዛሪደ፥ “ዎፓ፤ ዎሹሞፓ፤ ዉኦፓ፤ ዎርዱዋ ማርካቶፓ፤<note caller="-" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">ከሳ 20:13-16</ref>፤ <ref loc="DEU 5:17-20">ዛረ. 5:17-20</ref></char></note> <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>ነ አባነ ነ ዳዮ ቦንቻ፤ ነ ሾሩዋካ ነ ሁጲያዳን ሲቃ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ከሳ 20:12</ref>፤ <ref loc="DEU 5:16">ዛረ. 5:16</ref>፤ <ref loc="LEV 19:18">ዎጋ 19:18</ref></char></note><verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>ሄ ያላጋ ብታኒ የሱሳ፥ “ታን ሄዋ ኡባካ ጉተፐ ዶማደ ናጋድ፤ ያትና፥ ታዉ ፓጭያዌ አዬ?” ያጌዳ።<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>የሱስ ብታንያ፥ “ኔን ፖሎ አሳ ግዳናዉ ኮዮፐ፥ ባደ ነዉ ደእያዋ ዛልኣደ፥ ሄ ሚሻ ህዬሳዉ እማ፤ ኔን ሳሉዋን ዱረታና፤ ያታደ ያደ ታና ካላ” ያጌዳ።<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>ሽን ሄ ያላጋ ብታኒ ሄዋ ስሴዳ ዎደ፥ እ ዳሮ ዱረ ግድያ ድራዉ፥ ቃረቲደ ባሽ ቤዳ።<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>የሱስ ባረና ካልያዋንቶ፥ “ታን ህንተንቶ ቱሙዋ ጋይ፤ ዱረ አሳይ ሳሉዋ ካዉተ ገላናዌ ዳሮ መቶ ግዳናዋ። <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>ታን ጉጃደካ ህንተንቶ ኦዳይ፤ ዱረ አሳይ ጾሳ ካዉተ ገላናፐ፥ ጋሉ ማርፕያ ሉኩዋና አናዌ ማታቴ” ያጌዳ። <figure style="fig" alt="Man leading unloaded camel" file="LB00039B.TIF" size="span" ref="19:24">ጫነትቤና ጋሉዋ ካለያዋ</figure><verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>አ ካልያዋንቱ ሄዋ ስስ ማላለቲደ፥ “ያትና፥ ኦን አታናዉ ዳንዳዪ?” ያጌድኖ።<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>የሱስ ኡንቱንታ ጫድ ጼሊደ፥ “ሀዌ አሳዉ ዳንዳየተና፤ ሽን ጾሳዉ ኡባባይ ዳንዳየቴ” ያጌዳ።<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>ጰጽሮስ ሄ ዎደ ዛሪደ የሱሳ፥ “በአ፥ ኑን ኑዉ ደእያ ኡባባ ባሺደ፥ ኔና ካሌዶ፤ ያቲደ ኑን አያ ደማኔሻ?” ያጌዳ።<verse eid="MAT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28"/>የሱስ ኡንቱንታ ሀዋዳን ያጌዳ፤ “ታን ህንተንቶ ቱሙዋ ጋይ፤ ታን፥ አሳ ናአይ፥ ኦራ ጋድያን ታ ካዉተ ኦይድያን ኡትያ ዎደ፥ ታና ካሌዳ ህንተንቱካ ታማነ ላኡ እስራኤልያ ዛራቱዋ ቦላ ፕርዳናዉ፥ ታማነ ላኡ ካዉተ ኦይድያን ኡታንታ። <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>ታ ሱን ድራዉ፥ ጎልያ ዎይ እሻቱዋ ዎይ ምቻቱዋ፥ ዎይ አዉዋ ዎይ አቶ ዎይ ማቻቶ፥ ዎይ ናና ዎይ ጋድያ አጌዳ ኦንነ፥ ጼቱ ዳኩዋፐ ዳሩዋ አካና፤ ቃይ መና ደኡዋካ ላታና። <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>ሽን ጮራቱ ሀእ ስንቴዳዋንቱ ጉየታናዋንታ፤ ቃይ ጮራቱ ሀእ ጉየን ደእያዋንቱ ስንታናዋንታ።<verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s1">ዎይንያ ቱራ ግዶን ኦያ ኦሳንቻቱዋ ሌምሱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>“ሳሉዋ ካዉተይ ዎይንያ ጌተትያ ቱራ ግዱዋ ኦያዋንታ ኡንያ ኦስሳናዉ፥ ዎንታ ጉራን ከሴዳ ዎይንያ ቱራ ጎዳ በሴ። <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>እ ሄ ኦሳንቻቶ ሀቼ ሀቼ ኦዳዋ ዎልቃ ጋትያ ጭጋናዉ ኡንቱንቱና ጊጊደ፥ ባረ ዎይንያ ቱራ ግዱዋ ኦስሳናዉ ኡንቱንታ የዴዳ።<verse eid="MAT 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3"/>“ቃይ ሄዙ ሳትያ ግዶደ ከሲደ፥ ኦሱ ባይናን ቆጫን ኤቄዳ ሀራ አሳቱዋ በኢደ፥ <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>ኡንቱንታ፥ ‘ህንተንቱካ ቃይ ታ ዎይንያ ቱራ ግዱዋ ኦናዉ ቢተ፤ ታን ህንተንቶ በስያ ጋትያ ጭጋና’ ያጌዳ፤ ሄዋፐ ጉይያን ኡንቱንቱ ቤድኖ። <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/>ላኤንዋካ ኡሱፑን ሳትያንነ ኡዱፑ ሳትያን ከሲደ፥ ሄዋዳን ኦዳ። <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>ታማነ እት ሳትያ ሄራን እ ከስያ ዎደ፥ ሀራንቱ ሄዋን ኤቄዳዋንታ ደሚደ፥ ‘ኦሱዋ ኦናን ኩመን ጋላሳ ሀዋን አያዉ ኤቂ ፔሼድቴ?’ ያጌዳ።<verse eid="MAT 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7"/>“ኡንቱንቱ፥ ‘ኑና ኦስስያ አሳይ ዬዳ ድራዉ ኤቂ ፔሼዶ’ ያጌድኖ።</para>
  <para style="p" vid="MAT 20:7">“እ፥ ‘ኡንቱንታካ ቃይ ታ ዎይንያ ቱራ ግዱዋ ኦናዉ ቢተ’ ያጌዳ።<verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>“ሳአይ ኦማርስያ ዎደ፥ ዎይንያ ቱራ ጎዳይ ኦያዋንቱ ካፑዋ፥ ‘ኦሳንቻቱዋ ጼሳደ፥ ዉርሰን ኦሱዋን ገሌዳዋንቱፐ ዶማደ ኮይሮ ገሌዳዋንታ ጋካናዉ፥ ኡንቱንቱ ኦሱዋ ድርጉዋ ጭጋ’ ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="LEV 19:13">ዎጋ 19:13</ref>፤ <ref loc="DEU 24:15">ዛረ. 24:15</ref></char></note><verse eid="MAT 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9"/>“ታማነ እት ሳትያ ሄራን ኦሱዋ ዶሜዳዋንቱ ዪደ፥ ሁጲያን ሁጲያን ኦደ ፔሼዳ ዎልቃ ጋትያ አኬድኖ። <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>ኮይሮ ኦሱዋ ዶሜዳ አሳይ ዬዳ ዎደ፥ ዳሩዋ አካናዉ ቆፔድኖ፤ ሽን ኡንቱንቱካ ሁጲያን ሁጲያን ባረንቱ ኦሱዋ ዎልቃ ጋትያ አኬድኖ። <verse eid="MAT 20:10"/><verse number="11-12" style="v" sid="MAT 20:11-12"/>ሄዋፐ ጉይያን፥ ‘ሀ ጉየፐ ዬዳዋንቱ እት ሳትያ ጻላላ ኦድኖ፤ ኩመን ጋላሳ ዳቡሪደ ጫዎቴዳ ኑዋና ኡንቱንቱ ኦሱዋ ድርጉዋ ቃራ ኦዳ’ ያጊደ ባረንታ ኦሱዋን ገልሴዳዋ ቦላ ዙዙሜድኖ።<verse eid="MAT 20:11-12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13"/>“ሽን እ ኡንቱንቱፐ እቱዋ ሀዋዳን ያጌዳ፤ ‘ታ ላገዉ፥ ታን ኔና ናቃበይከ፤ ኦደ ፔሼዳ ዎልቃ ጋትያ ታናና ጊጋበይክዬ? <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>ነዋ አካደ ባ፤ ታን ሀእ ዉርሰን ኦሱዋን ገሌዳዎካ ነዋ ኬና እማናዉ ኮያይ። <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>ታን ታ ሚሻን ታ ኮዬዳዋዳን ኦናዉ ታዉ ማታይ ባዌ? ዎይ ታን ሎአ ግዴዳ ድራዉ፥ ኔን ቃናታይ?’ ያጌዳ።<verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>“ሄዋዳንካ፥ ቃይ ጉየቴዳዋንቱ ስንታናዋንታ፤ ስንቴዳዋንቱ ቃይ ጉየታናዋንታ፤ አያዉ ጎፐ፥ ጼሰቴዳዋንቱ ጮራ፤ ሽን ዶረቴዳዋንቱ ጉ” ያጌዳ።<verse eid="MAT 20:16"/></para>
  <para style="s1">የሱስ ባረ ሀይቁዋባ ሄዘንዋ ኦዴዳ</para>
  <para style="r">(<ref loc="MRK 10:32-34">ማር. 10:32-34</ref>፤ <ref loc="LUK 18:31-34">ሉቃሳ 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>የሱስ የሩሳላመ ቢደ፥ ኦግያን ባረናና ብያ ታማነ ላኡ ባረና ካልያዋንታ ጋጻ ከሲደ፥ ዱማ ኡንቱንቶ ያጌዳ። <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>“በእተ፥ ኑን የሩሳላመ ሀእ ከሴቶ። ያን ታና፥ አሳ ናኣ ቄሳቱዋ ካፓቶነ ህግያ ታማርስያዋንቶ አደ እማናዋንታ፤ ኡንቱንቱ ታ ቦላ ሀይቁዋ ፕርዳ ፕርዳናዋንታ። <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>ቃይ አይሁዳ ግደና አሳዉካ ታና አደ እማናዋንታ፤ ሄ አይሁዳ ግደና አሳይ ታ ቦላ ቅሊጫናዋንታነ ታና ልሱዋን ሾጫናዋንታ፤ ያቲደ ማስቃልያ ቦላ ምስማርያን ሺደ፥ ታና ካቃናዋንታ፤ ታን ሄዘንያ ጋላስ ሀይቁዋፐ ደንዳና” ያጌዳ።<verse eid="MAT 20:19"/></para>
  <para style="s1">ዛብድዮሳ ናና ዳይ ዎሳ</para>
  <para style="r">(<ref loc="MRK 10:35-45">ማር. 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>ሄ ዎደ ዛብድዮሳ ናና ዳያ ባረ ናናና የሱሳኮ ያዱ፤ አ ስንን ጉልባታደ እትባ አ ዎሳዱ።<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>የሱስ እዞ፥ “አያ ኮያይ?” ያጊደ ኦቼዳ።</para>
  <para style="p" vid="MAT 20:21">እዛ ዛራደ፥ “ሀ ታ ላኡ ናናይ ነ ካዉተን እቱ ኔፐ ኡሸቻ ባጋና፥ ቃይ እቱ ኔፐ ሀድርሳ ባጋና ኡትኖ ያጋርኪ” ያጋደ ዎሳዱ።<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>ሽን የሱስ ዛሪደ ናና፥ “ህንተንቱ አያ ዎሳናዉ በስንቶ ኤርክታ። ታና ጋክያ ዎልቃማ መቱዋ መቶታንቴ? ታን ጻማቀታና ጽንቃታ ጻማቀታናዉ ዳንዳዪቴ?” ያጌዳ።</para>
  <para style="p" vid="MAT 20:22">ኡንቱንቱ፥ “ኤ ዳንዳያና” ያጌድኖ።<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>የሱስ፥ “ታና ጋክያ ዎልቃማ መቱዋ ቱማካ ህንተንቱ መቶታንታ፤ ሽን ታፐ ኡሸቻ ባጋናነ ሀድርሳ ባጋና ኡታናዋንታ ዶራናዉ ታዉ ማታይ ባዋ፤ ሽን ሄ ሳአይ ታ አቡ እማናዉ ጊግስ ዎዳዋንቱሳ” ያጌዳ።<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>የኮ ታሙ የሱሳ ካልያዋንቱ ሄዋ ስሴዳ ዎደ፥ ሄ ላኡ እሻቶ ሀንቀቴድኖ። <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>ሽን የሱስ ኡንቱንቱ ኡባቱዋካ ባረኮ ጼሲደ፥ ሀዋዳን ያጌዳ፤ “አህዛበ አሳቱዋ ካፓቱነ ሀዋንታ ካለያ አሳቱ ባረንቱ አሳ አይስያዋ ኤሪታ። <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>ህንተንቱ ግዱዋን ሄዋ ማላ ግደና፤ ሽን ህንተንቱ ግዱዋን ቃተ ኮይያ ኦንነ ህንተንቶ ቆማ ግዳናዉ በሴ። <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>ቃይ ህንተንቱ ግዱዋን ኡባፐ ቦላ ግዳናዉ ኮይያዌ ኦንነ ህንተንቶ አይለ ግዳናዉ በሴ። <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>ሄዋዳን ታን፥ አሳ ናአይ፥ አሳዉ ኦናዉነ ዳሮ አሳ ዎዛናዉ ታ ሸምፑዋ እማናዉ ዬዳዋፐ አትን፥ አሳይ ታዉ ኦና ማላ ያበይከ” ያጌዳ።<verse eid="MAT 20:28"/></para>
  <para style="s1">የሱስ ላኡ ቆቃቱዋ ፓዳ</para>
  <para style="r">(<ref loc="MRK 10:46-52">ማር. 10:46-52</ref>፤ <ref loc="LUK 18:35-43">ሉቃሳ 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>የሱስነ አ ካልያዋንቱ እያርኮፐ ከስሽን፥ ዳሮ አሳይ ኡንቱንታ ካሌዳ። <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>ላኡ ቆቃ አሳቱ ኦግያ ዶናን ኡቴዳዋንቱ የሱስ ሄዋና አያዋ ስሲደ፥ ባረንቱ ኮሻ ቁ ኦደ፥ “ጎዳዉ፥ ዳዊታ ናአዉ፥ ኑዉ ቃረታርኪ” ያጌድኖ።<verse eid="MAT 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31"/>ዳሮ አሳይ ኡንቱንታ፥ “ሀይዝተ” ጊደ ሀንቀቴዳ፤ ሽን ኡንቱንቱ ባረንቱ ኮሻ ዳሪ ቁ ኦደ፥ “ጎዳዉ፥ ዳዊታ ናአዉ፥ ኑና ማራርኪ!” ያጌድኖ።<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>የሱስ ኦግያን ኤቂደ፥ ኡንቱንታ ጼሲደ፥ “ታን ህንተንቶ አያ ኦና ማላ ኮዪቴ?” ያጌዳ።<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>ቆቃቱ፥ “ጎዳዉ፥ ኑ አይፍያ ፓርኪ” ያጌድኖ።<verse eid="MAT 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34"/>የሱስ ኡንቱንቶ ቃረቲደ፥ ኡንቱንቱ አይፍያ ቦቼዳ፤ ኤለካ ኡንቱንቱ አይፊ ጼል አግና፥ አ ካል አጌድኖ።<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s1">የሱስ ዎልቃማ ቦንቹዋን የሩሳላመ ገሌዳ</para>
  <para style="r">(<ref loc="MRK 11:1-11">ማር. 11:1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃሳ 19:28-40</ref>፤ <ref loc="JHN 12:12-19">ዮሃ. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>ኡንቱንቱ የሩሳላመ ማቲደ፥ ደብረ ዛይተ ጌተትያ ደርያ ላንቂያን ደእያ ቤተፋገ ጌተትያ ቄር ካታማ ጋኬድኖ፤ የሱስ ባረና ካልያዋንቱፐ ላኡዋ ስንዉ ኪቲደ፥ <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>ኡንቱንታ ሀዋዳን ያጌዳ፤ “ህንተንቱፐ ስንን ደእያ ቄር ካታማ ቢተ፤ ሄዋን እት ሀራታ ቃሹዋን ደኤዉኖ እዝ ማራና ህንተንቱ ብ ስሞ ሳንካ ደማንታ፤ ኡንቱንታ ብሊደ፥ ታዉ አክ ዪተ። <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>ኦንነ ህንተንታ ኦቾፐ፥ ‘ጎዳይ ሀዋንታ ኮዬ’ ያግተ፤ ኤለካ እ ኡንቱንታ የድ አጋናዋ።”<note caller="+" style="f"><char style="fr" closed="false">21:3 </char><char style="fq" closed="false">ጎዳይ፦ </char><char style="ft" closed="false">ሀራቱዋ ጎዳ ጉሳ።</char></note> <verse eid="MAT 21:3"/><verse number="4-5" style="v" sid="MAT 21:4-5"/>ትምቢትያ ኦድያ ናቢ፥</para>
  <para style="q1" vid="MAT 21:4-5">“ጽዮነ ካታማ አሳዉ፥</para>
  <para style="q2" vid="MAT 21:4-5">‘በአ፥ ነ ካቲ አሽከ ግዲደ፥</para>
  <para style="q2" vid="MAT 21:4-5">ሀርያ ቦላ፥ ሀረ ማራ ቦላ ኡቲደ፥</para>
  <para style="q2" vid="MAT 21:4-5">ኔኮ ዬ’ ያግተ”</para>
  <para style="m" vid="MAT 21:4-5">ያጊደ ሃሳዬዳዌ ፖለታና ማላ፥ ሀዌ ሃኔዳ።<note caller="-" style="x"><char style="xo" closed="false">21:4-5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">ዛካ. 9:9</ref></char></note><verse eid="MAT 21:4-5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>አ ካልያዋንቱ ቢደ፥ የሱስ ባረንታ አዛዞዋዳን ኦድኖ። <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>ሀራቶነ ሀረ ማራ አሂደ፥ ባረንቱ ማዩዋ ኡንቱንቱ ዞክያን ዎድኖ፤ ሄዋፐ ስምና የሱስ ቶጌዳ። <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>ሄ ጮራ አሳፐ ዳርያ ባጋይ ባረ ማዩዋ ኦግያን ሂጼዳ፤ ቃይ ሀራንቱ ም ሀይ ካር ካሪደ፥ ኦግያን የጌድኖ። <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>የሱሳፐ ስንና ሀመትያ ጮራ አሳይነ ቃይ አ ጌዱዋ ካልያ ጮራ አሳይ፥ ባረንቱ ኮሻ ቁ ኦደ፥</para>
  <para style="q1" vid="MAT 21:9">“ዳዊታ ናአይ ጋላተቶ!</para>
  <para style="q2" vid="MAT 21:9">ጎዳ ሱንን ይያዌ አንጀቴዳዋ!</para>
  <para style="q1" vid="MAT 21:9">ጾሳይ ጋላተቶ!”</para>
  <para style="m" vid="MAT 21:9">ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25">ማዝ. 118:25</ref>፣ <ref loc="PSA 118:26">26</ref></char></note><verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>የሱስ የሩሳላመ ካታማ ገሌዳ ዎደ፥ ካታማን ደእያ አሳይ ኡባይ፥ “ሀዌ ኦኔ?” ያጊደ ሻቢረቴድኖ።<verse eid="MAT 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11"/>አሳይ፥ “ሀዌ ጋሊላን ደእያ ናዝሬተ ጌተትያ ካታማፐ ዬዳ ናብያ የሱሳ” ያጌዳ።<verse eid="MAT 21:11"/></para>
  <para style="s1">የሱስ ጌሻ ጎልያ ገሌዳ</para>
  <para style="r">(<ref loc="MRK 11:15-19">ማር. 11:15-19</ref>፤ <ref loc="LUK 19:45-48">ሉቃሳ 19:45-48</ref>፤ <ref loc="JHN 2:13-22">ዮሃ. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>የሱስ ጌሻ ጎልያ ገሊደ፥ ሄዋን ዛልእያዋንታነ ሻምያዋንታ ኡባ ካረ የደርሴዳ፤ ቃይ ሚሻ ላምያዋንቱ ጻራጴዛነ ዶጎሙዋ ዛልእያዋንቱ ኦይድያ ጉጵ የጊደ፥ <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>ኡንቱንታ፥ “ጾሳ ማጻፋን፥ ‘ታ ጎሊ ጾሳ ዎስያ ጎልያ ጌተታና’ ያገቲደ ጻፈት ኡቴዳ፤ ሽን ህንተንቱ አ ቦንቂያዋንቱ ቆሰትያ ጎንጎሉዋ ከሴድታ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ. 56:7</ref>፤ <ref loc="JER 7:11">ኤር. 7:11</ref></char></note><verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>ቆቃቱነ ገዲ ስሌዳዋንቱ የሱሳኮ ጌሻ ጎልያ ዪና፥ እ ኡንቱንታ ፓዳ። <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>ሽን ቄሳቱዋ ካፓቱነ ህግያ ታማርስያዋንቱ የሱስ ኦያ ኦራባ በኤዳ ዎደነ፥ ጉ ናናይ ጌሻ ጎልያን ባረንቱ ኮሻ ቁ ኦደ፥ “ዳዊታ ናአይ ጋላተቶ” ያግያዋ በኤዳ ዎደ ሀንቀቴድኖ።<verse eid="MAT 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16"/>ያቲደ የሱሳ፥ “ሀዋንቱ ግያዋ ስሳይ?” ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">21:16 </char><char style="xt" closed="false"><ref loc="PSA 8:2">ማዝ. 8:2</ref></char></note></para>
  <para style="p" vid="MAT 21:16">የሱስ፥ “ኤ ስሳይ፤ ጾሳ ማጻፋይ፥ ‘ጉ ናናይነ ምያ ናናይ ኔና ጋላታና ማላ፥ ኡንቱንታ ኤርሳዳ’ ያግያዋ ኡባካ ናባብ በይክቴ?” ያጌዳ። <verse eid="MAT 21:16"/><verse number="17" style="v" sid="MAT 21:17"/>የሱስ ኡንቱንታ አጊደ፥ ሄ ካታማፐ ቢታንያ ጌተትያ ካታማ ቢደ፥ ያን አቄዳ።<verse eid="MAT 21:17"/></para>
  <para style="s1">አይፊ ዬዳ ባላስያ ምቶ</para>
  <para style="r">(<ref loc="MRK 11:12-14">ማር. 11:12-14</ref>፣ <ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>የሱስ ዎንታ ጉራና ካታማ ቤዳ ድራዉ ኮሻቴዳ። <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>ኦግያ ዶናን እት ባላስያ ጌተትያ ምቶ በኢደ፥ ኢኮ ቤዳ፤ ብ ጋክያ ዎደ ሄ ምትን ሀይ ጻላላፐ አትን፥ አይፍያ አይነ ደምቤና፤ እዞ፥ “ላኤንዋ መናዉካ አይፎፓ” ያግና፥ ሄ ባላሳታ ኤለካ መላ አጋዱ።<verse eid="MAT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20"/>አ ካልያዋንቱ ሄዋ በኢደ ማላለቲደ፥ “ሀ ባላሳታ ዋናደ እት ኩን መላ አጋዴ?” ያጌድኖ።<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>የሱስ ዛሪደ፥ “ታን ህንተንቶ ቱሙዋ ጋይ፤ ህንተንቱ አማኑ ደእያዋንታነ ስናዋንታ ግዶፐ፥ ሀ ባላሳቶ ታን ኦዳዋ ማላ ጻላላ ኦክታ፤ ሽን ሀራይ አቶ ህንተንቱ ሀ ደርያ፥ ‘ደንዳደ አባን ኩንዳ’ ግንቶካ ሀናና፤ <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>ህንተንቱ አማኒደ ጾሳ ዎስያዋ አያ ግድንቶካ አካና” ያጌዳ። <figure style="fig" alt="Fig tree" file="LB00085B.TIF" size="col" ref="21:19">ባላሲያ ም</figure><verse eid="MAT 21:22"/></para>
  <para style="s1">የሱሳ ማታይ ዬዳሳ</para>
  <para style="r">(<ref loc="MRK 11:27-33">ማር. 11:27-33</ref>፤ <ref loc="LUK 20:1-8">ሉቃሳ 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>የሱስ ጌሻ ጎልያ ዪደ ታማርስሽን፥ ቄሳቱዋ ካፓቱነ አይሁዳ ጭማቱ አኮ ዪደ፥ “ኔን ሀዋ ኦናዉ ነዉ አይ ማታይ ደኢ? ነዉ ሀ ማታ ኦኔ እሜዳዌ?” ያጌድኖ።<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>የሱስ ዛሪደ ኡንቱንታ፥ “ታንካ ህንተንታ እትባ ኦቻና፤ ህንተንቱ ታዉ ሄዋ ኦዶፐ፥ ታን ሀዋ አይ ማታን ኦይታንቶ፥ ህንተንቶ ኦዳና፤ <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>ዮሃንስ ጻማቅያ ማታይ ሀቃፐ ዬዴ? ጾሳፐ ዬደየ አሳፐ ዬዴ?” ያጌዳ።</para>
  <para style="p" vid="MAT 21:25">ኡንቱንቱ ባረንቱ ግዱዋን ፓሉማ ዶሚደ፥ “ኑን፥ ‘ጾሳፐ ዬዳ’ ያጎፐ እ ኑና፥ ‘ያቶፐ፥ ዮሃንስ ኦዴዳዋ አያዉ አማንበይክቴ?’ ያጋናዋ። <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>ሽን ኑን፥ ‘አሳፐ ዬዳ’ ያጎፐ፥ አሳይ ኡባይ ዮሃንስ ናብያ ግዴዳዋ ኤርያ ድራዉ፥ አሳዉ ያዬቶ” ያጌድኖ። <verse eid="MAT 21:26"/><verse number="27" style="v" sid="MAT 21:27"/>ኡንቱንቱ የሱሳዉ፥ “ኑን ኤሮኮ” ያጊደ ዛሬድኖ።</para>
  <para style="p" vid="MAT 21:27">የሱስ፥ “ታንካ ሀዋ አይ ማታን ኦይታንቶ፥ ህንተንቶ ኦድከ” ያጌዳ።<verse eid="MAT 21:27"/></para>
  <para style="s1">ላኡ ናና ሌምሱዋ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>“ሽን ህንተንቱ አያ ቆፒቴ? ላኡ ናናይ ደእያ እት ብታኒ ደኤ፤ ሄ ብታኒ ባይራ ናኣኮ ቢደ፥ ‘ታ ናአዉ፥ ሀቼ ባደ ታ ዎይንያ ቱራ ኦ’ ያጌዳ። <verse eid="MAT 21:28"/><verse number="29" style="v" sid="MAT 21:29"/>ናአይ ዛሪደ፥ ‘ቢከ’ ጌዳ፤ ሽን ጉየፐ ባረ ዎዛናን ቆፕ አኪደ፥ ዎይንያ ቱራ ኦናዉ ቤዳ። <verse eid="MAT 21:29"/><verse number="30" style="v" sid="MAT 21:30"/>አዉ የኮ ናኣኮ ቢደ፥ ባይራዉ ጌዳዋዳንካ አዉ ጌዳ፤ ቴፋ ናአይ ዛሪደ፥ ‘ሎአ ታ ጎዳዉ’ ያጌዳ፤ ሽን ብቤና። <verse eid="MAT 21:30"/><verse number="31" style="v" sid="MAT 21:31"/>ሀ ላኡ ናናፐ ባረ አዉ ኮዬዳዋ ኦዳዌ ሀቃዌ?” ያጌዳ።</para>
  <para style="p" vid="MAT 21:31">ኡንቱንቱ፥ “ባይራ” ያጌድኖ።</para>
  <para style="p" vid="MAT 21:31">የሱስ ኡንቱንታ ሀዋዳን ያጌዳ፤ “ታን ህንተንቶ ቱሙዋ ጋይ፤ ቃራጻ አክያዋንቱነ ዎሹምያዋንቱ ህንተፐ ስንቲደ፥ ጾሳ ካዉተ ገላና። <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>አያዉ ጎፐ፥ ጻማቅያ ዮሃንስ ጽሎተ ኦግያ ታማርሲደ፥ ህንተኮ ዪና፥ እ ግያዋ አማንበይክታ። ሽን ቃራጻ አክያዋንቱነ ዎሹምያዋንቱ እ ግያዋ አማኔድኖ፤ ህንተንቱ ሀራይ አቶ ሄዋ በኢደካ፥ ህንተንቱ ናጋራፐ ስሚደ፥ እ ግይያዋ አማንበይክታ” ያጌዳ።<verse eid="MAT 21:32"/></para>
  <para style="s1">ዎይንያ ቱራ ግዶን ኦያ ጎሻንቻቱዋ ሌምሱዋ</para>
  <para style="r">(<ref loc="MRK 12:1-12">ማር. 12:1-12</ref>፤ <ref loc="LUK 20:9-19">ሉቃሳ 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>ቃይካ የሱስ ሀዋዳን ያጌዳ፤ “ሀራ ሌምሱዋካ ስስተ፤ ዎይንያ ጌተትያ ቱራ ቶኬዳ እት ብታኒ ደኤ፤ ዎይንያ ቱራ ዩሽ አደ ድሬዳ፤ ቃይ ሄ ዎይንያ ጉምእያ ኦላካ ቦኬዳ፤ ሄዋ ናግያ አሳዉ አዱሳ ሹቻ ግምቤዳ። ሄዋፐ ጉይያን፥ ኮ ኦያ አሳዉ እሚደ፥ ሀራ ጋደ ቤዳ።<note caller="-" style="x"><char style="xo" closed="false">21:33 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">ኢሳ. 5:1-2</ref></char></note> <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>ዎይንያ አይፍያ ማጽያ ዎዲ ጋክና፥ ባረና ጋክያዋ አኪደ ያና ማላ፥ ባረ ቆማቱዋ ባረ ኮዋቱዋኮ ኪቴዳ። <verse eid="MAT 21:34"/><verse number="35" style="v" sid="MAT 21:35"/>ኮዋቱ አ ቆማቱዋ ኦይቂደ፥ እቱዋ ዎድኖ፤ ቃይ የኩዋ ሹቻን ጳልቄድኖ። <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>ቃይካ ሄ ብታኒ ካሰዋንቱፐ ዳርያ ሀራ ቆማቱዋ ኪቴዳ፤ ኮዋቱ ሄ ቆማቱዋካ ካሰዋንቱዋዳን ኦድኖ።<verse eid="MAT 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 21:37"/>“ሽን ዉርሰን እ፥ ‘ታ ናኣ ኡንቱንቱ ቦንቻናዋንታ’ ያጊደ ባረ ናኣ ኡንቱንቱኮ ኪቴዳ።<verse eid="MAT 21:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38"/>“ሽን ኮዋቱ ናኣ በኢደ፥ ባረንቱ ግዱዋን፥ ‘ጋድያ ላታናዌ ሀዋ፤ ቢደ አ ዎደ፥ ጋድያ ኑን ላታና’ ያጌድኖ። <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>ናኣ ኦይቂደ፥ ዎይንያ ቱራ ግዶፐ ጋጻ ከሲደ ዎድኖ።<verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>“ስም ዎይንያ ቱራ ጎዳይ ይያ ዎደ፥ ሄ ኮዋቱዋ ዎታኔ?” ያጊደ ኦቼዳ።<verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>ኡንቱንቱ፥ “እ ሄ ኢታ አሳቱዋ ዎ ዉርሲደ፥ ዎይንያ ቱራይ አይፍያ ዎደ ባረና ጋክያዋ ዎድያን ሼያ ሀራ ኮዋቶ እማና” ያጌድኖ።<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>የሱስ ኡንቱንታ ሀዋዳን ያጌዳ፤</para>
  <para style="q1" vid="MAT 21:42">“ ‘ግምቢያዋንቱ ካደ እጼዳ ሹቻይ፥</para>
  <para style="q2" vid="MAT 21:42">ጎዳ ጻጱዋ ምንስያ፥ ኡባፐ አያ ሹቻ ግዴዳ።</para>
  <para style="q1" vid="MAT 21:42">ሀዌ ጎዳይ ኦዳዋ፤</para>
  <para style="q2" vid="MAT 21:42">ቃይ ኑ ጼላዉካ ማላልስያዋ’</para>
  <para style="m" vid="MAT 21:42">ያግያዋ ጾሳ ማጻፋፐ ኡባካ ናባብ በይክቴ?<note caller="-" style="x"><char style="xo" closed="false">21:42 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">ማዝ. 118:22-23</ref></char></note><verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>“ሄዋ ድራዉ፥ ታን ህንተንቶ ኦዳይ፤ ጾሳ ካዉተይ ህንተፐ አከቲደ፥ ሎኦ አይፍያ እምያ አሳዉ እመታናዋ። <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>ሄ ሹቻ ቦላ ኩንድያ ኡባይ መኤረታና፤ ቃይ ሄ ሹቻይ አሳ ቦላ ኩንዶፐ፥ ሄ ኩንዴዳ ኡራ ሊቅሳና” ያጌዳ።<verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>ቄሳቱዋ ካፓቱነ ፓርሳዋቱ የሱስ ኦዴዳ ሌምሱዋ ስሴዳ ዎደ፥ ባረንቱዋ ሃሳይያዋ ኤሬድኖ። <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>ኡንቱንቱ የሱሳ ኦይቃናዉ ኮዬድኖ፤ ሽን የሱሳ ዳሮ አሳይ ናብያ ጊደ ቆፕ ኡቴዳ ድራዉ፥ ሄ አሳዉ ያዬድኖ።<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s1">አካነ ገሉዋ ኦዱዋ ሌምሱዋ</para>
  <para style="r">(<ref loc="LUK 14:15-24">ሉቃሳ 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>የሱስ አሳዉ ላኤንዋ ሌምሱዋን ሀዋዳን ያጊደ ሃሳዬዳ፤ <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>“ሳሉዋ ካዉተይ ባረ ናአዉ ማችያ እማናዉ ኡባባ ማኬዳ ካትያ ማላ። <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>ሄ ካቲ ቡላቻዉ ኦድ ዎዳ አሳቱዋ ጼሳናዉ ባረ ቆማቱዋ ኪቴዳ፤ ሽን አሳቱ ያናዉ ኮይበይክኖ።<verse eid="MAT 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4"/>“ቃይ ሀራ ቆማቱዋ፥ ‘ጼሰቴዳዋንታ፥ “ታን ቁማ ጊግሳድ፤ ታ ሳንጋቱነ ታ ሞ ምያቱ ሹከቴድኖ፤ ኡባባይካ ማከቴዳ። ቡላቻ ሃ ዪተ” ያግተ’ ያጊደ ኪቴዳ። <verse eid="MAT 22:4"/><verse number="5" style="v" sid="MAT 22:5"/>ሽን ጼሰቴዳዋንቱ ኮየናን እጺደ፥ ባረንቱ ኦሶ ቤድኖ፤ እቱ ባረ ጎሻዉ ቢና፥ የኩ ባረ ዛልኤዉ ቤዳ። <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>አቴዳዋንቱ ቃይ ካትያ ቆማቱዋ ኦይቂ ዋደ ዎድኖ።<verse eid="MAT 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 22:7"/>“ካቲ ዳሮ ሀንቀቴዳ፤ ቃይ ባረ ዎታዳራቱዋ የዲደ፥ ሄ ሸምፑዋ ዎዳዋንታ ዎሲደ፥ ኡንቱንቱ ካታማ ጉድሴዳ። <verse eid="MAT 22:7"/><verse number="8" style="v" sid="MAT 22:8"/>ሄዋፐ ጉይያን፥ ባረ ቆማቱዋ፥ ‘ቡላቻይ ማከቴዳ፤ ሽን ጼሰቴዳዋንቱ ቡላቻዉ በስያ አሳ ግድክኖ። <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>ሄዋ ድራዉ፥ ዎጋ ቃ ቢደ፥ ህንተንቱ ደሜዳ አሳ ኡባ ቡላቻዉ ጼስተ’ ያጌዳ። <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>ሄ ቆማቱ ቃ ቢደ፥ ባረንቱ ደሜዳ አሳ ኡባ ሎኡዋ ኢታ ሺሺደ፥ ቡላቻ ዳስያ ኩንድኖ።<verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>“ሽን ካቲ ቁማ ማናዉ ኡቴዳ አሳ በአናዉ ገሌዳ ዎደ፥ ቡላቻ ማዩዋ ማይቤና እት ብታንያ ሄዋን በኢደ፥ <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>‘ታ ላገዉ፥ ቡላቻ ማዩዋ ማየናን ዋናደ ሀዋ ገላዲ?’ ያግና ብታኒ ጮኡ ጌዳ።<verse eid="MAT 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13"/>“ሄዋፐ ጉይያን፥ ካቲ ባረ ቆማቱዋ፥ ‘ሀ ብታንያ ኩሽያነ ገድያ ቃቺደ፥ ካረ ማ ከስ ኦልተ፤ እ ሄዋን ዬካናነ አቻ ቃና’ ያጌዳ።<verse eid="MAT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14"/>“አያዉ ጎፐ፥ ጼሰቴዳዋንቱ ዳራ፤ ሽን ዶረቴዳዋንቱ ጉ” ያጌዳ።<verse eid="MAT 22:14"/></para>
  <para style="s1">ጊራ ዎት ጊራነንቶ ኦቼዳ ኦሻ</para>
  <para style="r">(<ref loc="MRK 12:13-17">ማር. 12:13-17</ref>፤ <ref loc="LUK 20:20-26">ሉቃሳ 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>ሄዋፐ ጉይያን፥ ፓርሳዋቱ ቢደ፥ አ ሃሳያፐ ባላ ደሚደ፥ አ ኦይቃና ማላ ማቀቴድኖ። <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>ቃይ ባረንታ ካልያዋንቱፐነ ሄሮድሳ ባጋቱዋፐ አማሬዳዋንታ አኮ ኪቴድኖ። ኡንቱንቱ፥ “ታማርስያዎ፥ ኔን ቱሙዋ ሃሳይያዋነ ጾሳ ኦግያ ቱማተን ታማርስያዋ ኑን ኤሬቶ፤ አያዉ ጎፐ፥ ኔን አሳፐ አሳ ሻካካነ ዱማያካ። <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>ነ ቆፋይ አየንቶ ኑዉ ኦዳ፤ ኑን ሮመ ጋድያ ካትያ ቄሳረዉ ጊራ ጊርያዌ ዎጌየ ዎጋ ግደኔ?” ያጌድኖ።<verse eid="MAT 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18"/>ሽን የሱስ ኡንቱንቱ ኢታ ቆፋ ኤሪደ፥ “ሀ ሎአ ማላትያ ኢታ አሳቶ፥ አያዉ ታና ፓጪቴ? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>ጊራ ጊርያ ሚሻ ታና በስተ” ያጌዳ። ሄዋፐ ጉየ ኡንቱንቱ ብራ ሳንትምያ አዉ አሄድኖ። <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>እ፥ “ሀ ማላይነ ሱንይ ኦዌ?” ያጌዳ።<verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>ሄዋፐ ስሚደ ኡንቱንታ ኦችና፥ ኡንቱንቱ፥ “ሮመ ጋድያ ካትያ ቄሳረዋ” ያጌድኖ።</para>
  <para style="p" vid="MAT 22:21">ሄዋፐ ጉይያን፥ የሱስ ኡንቱንታ፥ “ያቶፐ፥ ቄሳረዋ ቄሳረዉ፥ ጾሳዋ ጾሳዉ እምተ” ያጌዳ። <verse eid="MAT 22:21"/><verse number="22" style="v" sid="MAT 22:22"/>ኡንቱንቱ ሄዋ ስሴዳ ዎደ፥ ማላለቲደ አ አጊደ ቤድኖ።<verse eid="MAT 22:22"/></para>
  <para style="s1">ሀይቄዳዋንቱ ደንዱዋባ</para>
  <para style="r">(<ref loc="MRK 12:18-27">ማር. 12:18-27</ref>፤ <ref loc="LUK 20:27-40">ሉቃሳ 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>ሀይቄዳ አሳይ ደንደና ግያ ሳዱቃዋናቱዋፐ እት እት አሳቱ ሄ ጋላስ የሱሳኮ ዪደ፥ ሀዋዳን ያጊደ፥ አ ኦቼድኖ፤ <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>“ታማርስያዎ፥ ሙሴ፥ ‘እት አሳይ ናኣ የለናን ሀይቆፐ፥ ሄ ሀይቄዳዋ እሻይ አ ማቻቶ ላቲደ፥ ባረ እሻዉ ናኣ የላናዉ በሴ’ ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ዛረ. 25:5</ref></char></note> <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>ኑናና ላፑ እሻቱ ደኢኖ፤ ባይራይ ማቻቶ አኪደ፥ ናኣ የለናን ሀይቄዳ፤ ሄዋፐ ጉይያን አ ማቻቶ አ እሻይ አኬዳ። <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>ቃይ ላኤንያዌካ ሀይቄዳ፤ ሄዘያዌካ፥ ላፑን ጋካናዉካ ሄዋዳን ሀኔድኖ። <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>ኡባፐ ጉይያን፥ ሄ ምሽራታ ሀይቃዱ። <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>ያትና፥ ሀይቄዳ አሳይ ሀይቁዋፐ ደንድያ ጋላስ ሄ ምሽራታ ላፑናቱዋፐ ሀቃዎ ማቼ ግዳኔ? አያዉ ጎፐ፥ ላፑናቱ ኡባይካ እዞ አኬድኖ” ያጌድኖ።<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>የሱስ ዛሪደ፥ ሀዋዳን ያጌዳ፤ “ጾሳ ማጻፋቱዋ ዎይ አ ዎልቃ ህንተንቱ ኤረና ድራዉ ባሊታ። <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>አያዉ ጎፐ፥ ሀይቄዳ አሳይ ሀይቁዋፐ ደንድያ ጋላስ፥ ሳሉዋን ደእያ ኪታንቻቱዋ ማላ ግዳናፐ አትን፥ አቱማ አሳይነ አከና፤ ማጫ አሳይነ ገለና። <verse eid="MAT 22:30"/><verse number="31-32" style="v" sid="MAT 22:31-32"/>ሽን ሀይቄዳዋንቱ ደንዱዋባ ግዶፐ፥ ጾሳይ፥ ‘ታን አብራሃመ ጾሳ፥ ይሳቃ ጾሳ፥ ያቆባ ጾሳ’ ያጊደ ህንተዉ ኦዴዳዋ ኡባካ ናባብ በይክቴ? ጾሳይ ፓጻ ደእያዋንቱ ጾሳ ግድያዋፐ አትን፥ ሀይቄዳዋንቱ ጾሳ ግደና” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">22:31-32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ከሳ 3:6</ref></char></note><verse eid="MAT 22:31-32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>ዳሮ አሳይ ሄዋ ስሲደ፥ አ ትምርትያን ማላለቴድኖ።<verse eid="MAT 22:33"/></para>
  <para style="s1">ኡባፐ አያ አዛዙዋ</para>
  <para style="r">(<ref loc="MRK 12:28-34">ማር. 12:28-34</ref>፤ <ref loc="LUK 10:25-28">ሉቃሳ 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>ሽን የሱስ ሳዱቃዋናቱዋ ጮኡ ኦዳዋ ፓርሳዋቱ ስሴዳ ዎደ፥ እትሳ ሺቄድኖ። <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>ኡንቱንቱ ግዶፐ ህግያ ታማርስያ እቱ፥ የሱሳ ፓጫናዉ እትባ ኦቼዳ። <verse eid="MAT 22:35"/><verse number="36" style="v" sid="MAT 22:36"/>“ታማርስያዎ፥ ህግያ ግዱዋን ኡባፐ አያ አዛዙ ሀቃዌ?” ያጊደ አ ኦቼዳ።<verse eid="MAT 22:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37"/>የሱስ ዛሪደ፥ ሀዋዳን ያጌዳ፤ “ ‘ኔን ጎዳ ነ ጾሳ ነ ኩመን ዎዛናፐ፥ ነ ኩመን ሸምፑዋፐ፥ ነ ኩመን ቆፋፐ ሲቃ’ ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">ዛረ. 6:5</ref></char></note> <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>ሄዌ ኡባፐ ዳርያ አዛዙዋነ ቃይ ኡባፐ አያ አዛዙዋ። <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>ቃይ ላኤንያ አዛዙካ አ ማላ፤ ሄዌ፥ ‘ኔን ነ ሾሩዋ ነ ሁጲያዳን ሲቃ’ ግያዋ።<note caller="-" style="x"><char style="xo" closed="false">22:39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ዎጋ 19:18</ref></char></note> <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>ሙሴ ህግያ ኡባይነ ናባቱዋ ትምርቲ ሀ ላኡ አዛዛቱዋን ቃሸቴ” ያጌዳ።<verse eid="MAT 22:40"/></para>
  <para style="s1">ክርስቶሳባ ኦቼዳ ኦሻ</para>
  <para style="r">(<ref loc="MRK 12:35-37">ማር. 12:35-37</ref>፤ <ref loc="LUK 20:41-44">ሉቃሳ 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41-42" style="v" sid="MAT 22:41-42"/>ፓርሳዋቱ እትሳ ሺቄዳሳን የሱስ ኡንቱንታ፥ “ክርስቶሳባ ዋጊደ ቆፒቴ? እ ኦ ናኤ?” ያጊደ ኦቼዳ።</para>
  <para style="p" vid="MAT 22:41-42">ኡንቱንቱ፥ “ክርስቶስ ዳዊታ ናኣ” ያጌድኖ።<verse eid="MAT 22:41-42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>የሱስ ኡንቱንታ፥ “ያትና፥ ዳዊተ ባረና ጌሻ አያናይ ሃሳይስና ክርስቶሳ ዋጊደ፥ ‘ጎዳ’ ጊደ ጼሲ? <verse eid="MAT 22:43"/><verse number="44" style="v" sid="MAT 22:44"/>ቃይካ ዳዊተ፥</para>
  <para style="q1" vid="MAT 22:44">“ጎዳይ ታ ጎዳ፥ ታን፥ ‘ነ ሞርከቱዋ፥</para>
  <para style="q2" vid="MAT 22:44">ኔን የ ኤቂያዋ ኦና ጋካናዉ፥</para>
  <para style="q2" vid="MAT 22:44">ሀዋን ታፐ ኡሸቻ ባጋና ኡታደ ታናና እትፐ ዳናታ ጌዳ’</para>
  <para style="m" vid="MAT 22:44">ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note> <verse eid="MAT 22:44"/><verse number="45" style="v" sid="MAT 22:45"/>ዳዊተ ክርስቶሳ፥ ‘ጎዳ’ ጊደ ጼሶፐ፥ ያትና፥ ክርስቶስ ዋኒደ ዳዊታ ናኣ ግዲ?” ያጌዳ።<verse eid="MAT 22:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46"/>የሱሳዉ እት ቃላ ዛራናዉ ዳንዳዬዳ እት አሳይነ ባዋ፤ ቃይ ሄ ጋላሳፐ ዶምና፥ ሀራ ኦሻ አ ኦቻናዉ ጻሌዳዌ ኦንነ ባዋ።<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s1">ሙሴ ህግያ ታማርስያዋንቱነ ፓርሳዋቱዋ ኢታተ</para>
  <para style="r">(<ref loc="MRK 12:38-39">ማር. 12:38-39</ref>፤ <ref loc="LUK 11:43-46">ሉቃሳ 11:43-46</ref>፤ <ref loc="LUK 20:45-46">20:45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>ሄዋፐ ጉይያን፥ የሱስ ሺቄዳ አሳዉነ ባረና ካልያዋንቶ ሀዋዳን ያጊደ ሃሳዬዳ፤ <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>“ህግያ ታማርስያዋንቱነ ፓርሳዋቱ ሙሴ ህግያ ታማርስያ ማታና ደኢኖ። <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>ሄዋ ድራዉ፥ ህንተንቱ ኦና ማላ፥ ኡንቱንቱ ህንተንታ አዛዝያ ኡባባ ኦተነ ቃይ ናግተ፤ ሽን ኡንቱንቱ ኦያዋዳን ኦፕተ፤ አያዉ ጎፐ፥ ኡንቱንቱ ባረንቱ ኦድያዋ ኦክኖ። <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>ቶካናዉ ዴጽያ ቶኩዋ ኡንቱንቱ ቃቺደ፥ አሳ ቶሲኖ፤ ሽን ባረንቱ ሁጲያን ሀራይ አቶ፥ ሄ ቶኩዋ ብራያን ቦቻናዉካ ኮይክኖ።<verse eid="MAT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5"/>“ሽን ኡንቱንቱ ባረንቱ ኦሱዋ ኡባ አሳይ በአናዳን ኦኖ፤ አያዉ ጎፐ፥ ባረንቱ ሶምእያንነ ባረንቱ ኩሽያ ቀስያን ቃችያ ጽቅስያና ደእያ ክታፋ አሲኖነ ባረንቱ ማዩዋ ማጫራካ አዱሲኖ።<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="MAT 6:1">ማቶሳ 6:1</ref>፤ <ref loc="NUM 15:37-41">ፓይ. 15:37-41</ref>፤ <ref loc="DEU 6:8">ዛረ. 6:8</ref></char></note> <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>አሳይ ባረንታ ሾቢደ አፎሳን ቦንቾ ኡቱዋ ዶሲኖ፤ ቃይ አይሁዳ ዎሳ ጎለቱዋንካ ዳሮ ሎእያ ኦይድያ ዶሲኖ። <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>አሳይ ገዋን ባረንታ ቦንቺደ ሳሮታና ማላነ ‘ታማርስያዎ’ ጊደ ባረንታ ጼሳናዳን ኮዪኖ።<verse eid="MAT 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8"/>“ሽን ህንተንታ ታማርስያዌ እቱዋ ጻላላ ግዴዳ ድራዉነ ህንተንቱ ኡባይ እሻቱዋ ግዴዳ ድራዉ፥ እቱ እቱዋ፥ ‘ታማርስያዎ’ ጊደ ጼሶፕተ። <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>ሀ ሳኣን ኦናነ ‘አዉዋ’ ጊደ ጼሶፕተ፤ አያዉ ጎፐ፥ ህንተንቶ ሳሉዋን ደእያ እት አዉ ደኤ። <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>እቱ እቱዋ፥ ‘ታማርስያዎ’ ጊደካ ጼሶፕተ፤ አያዉ ጎፐ፥ ህንተንቶ እት ጎዳይ፥ ክርስቶሳ ጻላላይ ደኤ። <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/>ህንተንቱ ግዶን ኡባፐ ዳርያዌ ህንተንቶ ቆማ ግዳናዉ በሴ። <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>ባረና ዳርስያዌ ኦንነ ቶሸታና፤ ቃይ ባረና ቶችያዌ ኦንነ ቁ ጋና።<verse eid="MAT 23:12"/></para>
  <para style="s1">ህግያ ታማርስያዋንቱነ ፓርሳዋቱ ቦረቴድኖ</para>
  <para style="r">(<ref loc="MRK 12:40">ማር. 12:40</ref>፤ <ref loc="LUK 11:39-42">ሉቃሳ 11:39-42</ref>፣ <ref loc="LUK 11:44">44</ref>፣ <ref loc="LUK 11:52">52</ref>፤ <ref loc="LUK 20:47">20:47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>“ሎአ ማላትያ ኢታቶ፥ ህግያ ታማርስያዋንቶነ ፓርሳዋቶ፥ አሳዉ ሳሉዋ ካዉተ ህንተንቱ ጎርድያ ድራዉ፥ ህንተንቶ አየሮ፤ አያዉ ጎፐ፥ ህንተንቱ ሁጰዉነ ገልክታ፤ ቃይ ገላናዉ ኮይያዋንታካ ገልስክታ።<verse eid="MAT 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14"/>“ሎአ ማላትያ ኢታቶ፥ ህግያ ታማርስያዋንቶነ ፓርሳዋቶ አምኤቱዋ ጎልያ ህንተንቱ ቦንቂደ፥ ህንተንቶ ሎአ ማላታናዉ ጾሳ ዎሳ አዱሲታ፤ ሄዋ ድራዉ፥ ህንተንቶ አየሮ፤ ኡባፐ አያ ፕርዳ ህንተንቱ አካና።<verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>“ሎአ ማላትያ ኢታቶ፥ ህግያ ታማርስያዋንቶነ ፓርሳዋቶ ህንተንቱ እት ኡራ አማንናዉ አባንነ ሳኣን ዩይያ ድራዉነ ቃይ ህንተንቱ አ አማንያ ዎደ፥ ሄ ኡራ ህንተንቱዋፐ ላኡ ኩሽያ ኢቴዳ ጋናመዉ ናኣ ኦያ ድራዉ፥ ህንተንቶ አየሮ።<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>“ ‘ኦንነ ጌሻ ጎልያን ጫቆፐ፥ አይነ ባዋ፤ ሽን ጌሻ ጎልያን ደእያ ዎርቃን ጫቆፐ፥ ሄ ጫቁ አ ጋኬ’ ግያ ህንተንቶ ቆቅ ኡቲደ አሳ ካለያዋንቶ፥ ህንተንቶ አየሮ። <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>ሀ ኤያቱ፥ ሀ ቆቃቱ፥ ዎርቃይ አዬ? ዎርቃ ጌሻ ኦያ ጌሻ ጎሊ አ? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>ቃይ ህንተንቱ፥ ‘ኦንነ ያርሹዋ ያርሽያባን ጫቆፐ፥ አይኔካ ባዋ፤ ሽን ኦንነ አ ቦላ ደእያ ያርሹዋን ጫቆፐ፥ ሄ ጫቁ አ ጋኬ’ ያጊደ ታማርሲታ። <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>ሀ ኤያቱ፥ ሀ ቆቃቱ፥ ያርሹ አዬ? ዎይ ያርሹዋ ጌሻ ኦያ አ ያርሽያባይ አ? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>ሄዋ ድራዉ፥ ያርሹዋ ያርሽያባን ጫቂያ ኡራይ ሄ ያርሽያዋንካ ጫቄ፤ ቃይ አ ቦላ ደእያ ኡባባንካ ጫቄ። <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>ጌሻ ጎልያን ጫቂያ ኡራይ፥ ሄ ጌሻ ጎልያንነ አ ግዶን ደእያ ጾሳን ጫቄ። <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>ሳሉዋን ጫቂያ ኡራይ፥ ጾሳ ካዉተ ኦይድያንነ ሄ ኦይድያን ኡትያዋን ጫቄ።<note caller="-" style="x"><char style="xo" closed="false">23:22 </char><char style="xt" closed="false"><ref loc="ISA 66:1">ኢሳ. 66:1</ref>፤ <ref loc="MAT 5:34">ማቶሳ 5:34</ref></char></note><verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>“ሎአ ማላትያ ኢታቶ፥ ህግያ ታማርስያዋንቶነ ፓርሳዋቶ፥ ህንተንቶ አየሮ። አያዉ ጎፐ፥ ካረ አኑጋፐ፥ ሽላርያፐነ ኦካሽያፐ አስራታ ህንተንቱ እሚታ፤ ሽን ህግያን ደእያ ዳሪ ኮሽያዋንታ አጊታ፤ ሄዋንቱ ፕርዳ፥ ማሮተነ ጽሎተ። ሀራንታካ አገናን፥ ህንተንቱ ኦናዉ በስያ የዋቱ ሀዋንታ። <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>ህንተንቶ ቆቅ ኡቲደ፥ አሳ ካለያዋንቶ፥ ህንተንቱ ኡሻፐ ኡዱንጽያ ጋጪደ፥ ጋሉዋ ምቲታ።<verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>“ሎአ ማላትያ ኢታቶ፥ ህግያ ታማርስያዋንቶነ ፓርሳዋቶ፥ ህንተንቶ አየሮ። አያዉ ጎፐ፥ ህንተንቱ ሻታነ ከርያ ቦላ ባጋ ጌሺታ፤ ሽን አ ግዱዋን ቦንቂያንነ ኡዘተን ኩንድታ። <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>ሀ ቆቃ ፓርሳዌዉ፥ ሻታነ ከርያ ጋርሳ ካሰታደ ጌሻ ድጋ፤ ሄዋፐ ጉይያን፥ ቦላ ባጋይካ ጌሻ ግዳናዋ።<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>“ሎአ ማላትያ ኢታቶ፥ ህግያ ታማርስያዋንቶነ ፓርሳዋቶ፥ ህንተንቶ አየሮ። አያዉ ጎፐ፥ ካረ ባጋና ቦሽንቻን ኦከቲደ፥ ሎኦ ኡቲደ፥ ቃይ ጋርሳ ባጋና ሀይቄዳ አሳ መቀይነ ዎቄዳባይ ኡባባይ ኩሜዳ ዱፎቱዋ ማላቲታ። <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>ሄዋዳንካ፥ ቃይ ቦላ ባጋና አሳ ኡባዉ ጽሉዋ ማላቲታ፤ ሽን ህንተንቶ ጋርሳ ባጋና ሎአ ማላትያ ኢታተይነ ማካላይ ኩም ኡቴዳ።<verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>“ሎአ ማላትያ ኢታቶ፥ ህግያ ታማርስያዋንቶነ ፓርሳዋቶ፥ ህንተንቶ አየሮ። አያዉ ጎፐ፥ ናባቱዋ ዱፉዋ ቦላ ጎልያ ኬጺታ፤ ቃይ ጽላቱዋ ዱፉዋካ ሎይታ። <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>ቃይ ህንተንቱ፥ ‘ኑን በን ኑ አዎቱዋ ዎደ ደኤዳዋንታ ግድንቶ፥ ኡንቱንቱና እትፐ ናባቱዋ ዎኮ ሽን’ ያጊታ። <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>ሄዋ ግዶፐ፥ ናባቱዋ ዎዳዋንቱ ናና ህንተንቱ ግዴዳዋ ህንተንቱ ሁጲያን ማርካቲታ። <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>ስም ህንተንቱ አዎቱ ዶሜዳዋ ፖልክቴ!<verse eid="MAT 23:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33"/>“ሀ ሾሻቶ፥ ሾሻ ናናዉ፥ ጋናምያ ፕርዳፐ ዋኒደ አታንቴ? <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>ሄዋ ድራዉ፥ በይተ፥ ታን ናባቱዋ አ ኤራንቻቱዋነ ህግያ ታማርስያዋንታ ህንተኮ ኪታና። ኡንቱንቱፐ እቱዋ እቱዋ ህንተንቱ ዎናነ ማስቃልያ ቦላ ምስማርያን ሺደ ካቃንታ፤ ቃይ እቱዋ እቱዋ ህንተንቱ ዎሳ ጎለቱን ልሱዋን ሾጫንታነ ካታማፐ ካታማ የደርሳንታ። <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>ሄዋ ድራዉ፥ ጽሉዋ አቤላ ዎደፐ ዶሚደ፥ ጌሻ ጎልያፐነ ያርሽያ ሳፐ ግዱዋን ህንተንቱ ዎዳ ባራክያ ናኣ ዛካራሳ ዎድያ ጋካናዉ፥ ሀይቄዳ ጽላቱዋ ኡባቱዋ ሱ ድራዉ፥ ህንተንቱ ሙረታንታ።<note caller="-" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="GEN 4:8">ዶመ 4:8</ref>፤ <ref loc="2CH 24:20-21">2 ኦዱዋ 24:20-21</ref></char></note> <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ሀ ኡባባይ ሀ ዎድያ አሳ ቦላ ጋካናዋ።<verse eid="MAT 23:36"/></para>
  <para style="s1">የሩሳላመዉ ኦደቴዳ ምኖ ኦዱዋ</para>
  <para style="r">(<ref loc="LUK 13:34-35">ሉቃሳ 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>“የሩሳላመ ካታማ አሳዉ፥ የሩሳላመ ካታማ አሳዉ፥ ናባቱዋ ህንተንቱ ዎታ፤ ጾሳይ ህንተንቱኮ ኪቴዳዋንታካ ሹቻን ጫዲታ፤ ኩታታ ባረ ማራቱዋ ባረ ቀፍያን ሀጵያዋዳን፥ ታን ህንተንቱ አሳ እትሳ ሺሻናዉ አፑ ካላ ኮያድታ! ሽን ታና ድጌድታ። <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>በእተ፥ ህንተንቱ ጎሊ ኡባካ ኦና ግዳናዋ።<note caller="-" style="x"><char style="xo" closed="false">23:38 </char><char style="xt" closed="false"><ref loc="JER 22:5">ኤር. 22:5</ref></char></note> <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>አያዉ ጎፐ፥ ታን ህንተንቶ ኦዳይ፤ ህንተንቱ፥ ‘ጎዳ ሱንን ይያዌ አንጀቴዳዋ ጋና ጋካናዉ፥ ላኤንዋ ታና በእክታ’ ጋይ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">23:39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">ማዝ. 118:26</ref></char></note><verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s1">የሱስ ጌሻ ጎሊ ኮለታናዋ ካሰቲደ ኦዴዳ</para>
  <para style="r">(<ref loc="MRK 13:1-2">ማር. 13:1-2</ref>፤ <ref loc="LUK 21:5-6">ሉቃሳ 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>የሱስ ጌሻ ጎልያፐ ከሲደ ብያ ዎደ፥ ጌሻ ጎልያ ድርሳ ግዶን ደእያ ጎልያ በሳናዉ አ ካልያዋንቱ አኮ ዬድኖ። <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>የሱስ ዛሪደ ኡንቱንታ፥ “ሄዋ ኡባ በኢቴ? ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ሀ ጎለቱዋን ደእያ እት ሹቻይነ አተናን ኡባይ ኮለታና” ያጌዳ።<verse eid="MAT 24:2"/></para>
  <para style="s1">ዎድያ ዉርሰባ</para>
  <para style="r">(<ref loc="MRK 13:3-13">ማር. 13:3-13</ref>፤ <ref loc="LUK 21:7-19">ሉቃሳ 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>የሱስ ደብረ ዛይተ ጌተትያ ደርያ ቦላን ኡት ደእሽን፥ አ ካልያዋንቱ ባረንቱ ጻላላ አኮ ዪደ አ፥ “ሄዌ አዉደ ሀናነንቶ፥ ኑዉ ኦዳርኪ፤ ቃይ ነ ዩሳዉነ ዎድያ ዉርሰዉ ማላይ አያ ግዳኔ?” ያጌድኖ።<verse eid="MAT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4"/>የሱስ ዛሪደ፥ ኡንቱንታ ሀዋዳን ያጌዳ፤ “ህንተንታ ኦንነ ባለና ማላ ናገትተ። <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>አያዉ ጎፐ፥ ዳሮ አሳይ ታ ሱንን፥ ‘ታን ክርስቶሳ’ ያጊደ ያና፤ ያቲደ ዳሮ አሳ ባለና። <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>ማታን ደእያ ኦላ ዋሱዋነ ሃኩዋን ደእያ ኦላ ኦዱዋ ስሳናዉ ህንተንቱ ደኢታ፤ ሄዋ ማላባይ ሀናናዉ በስያ ድራዉ፥ ናገትተ፤ ህርጎፕተ፤ ሽን ዉርሰይ ብራ። <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>አያዉ ጎፐ፥ እት ጋድያ አሳይ ሀራ ጋድያ አሳና ኦለታና፤ ቃይ እት ካዉተይ ሀራ ካዉተና ኦለታና፤ ኮሻይነ ቢታ ቃይ ኡባ ሳን ደአናዋ። <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>ሄዌ ኡባይካ ኮይሮ ኦይ ማላ።<verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>“አሳይ ሄ ዎደ ህንተንታ ዋይሳናነ ዎናዋ፤ ታ ሱን ድራዉ፥ ጋደ ኡባይ ህንተንታ እጻናዋ።<note caller="-" style="x"><char style="xo" closed="false">24:9 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቶሳ 10:22</ref></char></note> <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>ሄ ዎደ ጮራ አሳይ አማኑዋ አጋናዋንታ፤ ባረንቱ ግዶን እቱ እቱዋ አደ እማናነ እቱ እቱዋ እጻናዋ። <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>ቃይ ዎርዶ ናባቱ ጮራቱ ደንዲደ፥ ዳሮ አሳ ጭማናዋንታ። <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>ማካላይ ዳርያ ድራዉ፥ ጮራ አሳ ሲቁ እርጻናዋ። <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>ሽን ዉርሰይ ጋካናዉ ገንጭያ ኡራይ አታናዋ። <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>አሳዉ ኡባዉ ማርካ ግዳና ማላ፥ ካዉተ ዎንጋላ ምሽራቹ ሳኣ ኡባን ኦደታናዋ፤ ሄዋፐ ጉይያን፥ ዉርሰይ ጋካናዋ።”<verse eid="MAT 24:14"/></para>
  <para style="s1">ባሻ ቱናተ</para>
  <para style="r">(<ref loc="MRK 13:14-23">ማር. 13:14-23</ref>፤ <ref loc="LUK 21:20-24">ሉቃሳ 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>“ሄዋ ድራዉ፥ ናብያ ዳኔል ኦዴዳ ባሻ ቱናተይ ጌሻ ሳን ኤቄዳዋ ህንተንቱ በአና፤ ሄዌ ዋግያዌንቶ፥ ናባብያዌ አኬኮ።<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">ዳኔላ 9:27</ref>፤ <ref loc="DAN 11:31">11:31</ref>፤ <ref loc="DAN 12:11">12:11</ref></char></note><verse eid="MAT 24:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 24:16"/>“ይሁዳ ጋድያን ሄ ዎደ ደእያዋንቱ ደርያኮ ከስኖ። <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/>ጎልያ ሁጲያን ደእያ ኡራይካ ባረ ሶይን ደእያዋ አካናዉ ዎፖ። <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>ጋደን ደእያዌ ባረ ማዩዋ አካናዉ ጉየ ስሞፖ። <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>ሄ ዎደ ሻሃራ ማጫዋንቶነ ንያ ማጫዋንቶ አየሮ። <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>ባልጉዋን ዎይ ሳምባታን ህንተንቱ በተና ማላ፥ ጾሳ ዎስተ፤ <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>አያዉ ጎፐ፥ አላሚ መቶደፐ ሀቼ ጋካናዉ ደእቤናባይነ ቃይ ሀዋፐ ስንዉካ ኡባ ደኤና ኢታ ዋዪ ሄ ዎደ ደአናዋ።<note caller="-" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="DAN 12:11">ዳኔላ 12:11</ref>፤ <ref loc="REV 7:14">ሳፃ 7:14</ref></char></note> <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/>ጾሳይ ሄ ጋላሳቱዋ ፓይዱዋ ጉያዌ ባዌንቶ፥ አሳ ግዴዳ ኦንነ አተና፤ ሽን እ ባረ ዶሬዳ አሳቱዋ ድራዉ፥ ሄ ጋላሳቱዋ ፓይዱዋ ጉናዋ።<verse eid="MAT 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23"/>“ሄ ዎደ ኦንነ ህንተንታ፥ ‘በእተ። ክርስቶስ ሀዋን ደኤ’ ዎይ፥ ‘ሄዋን ደኤ’ ያጎፐ አዋ አማኖፕተ። <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>አያዉ ጎፐ፥ ዎርዶ ክርስቶሳቱነ ዎርዶ ናባቱ ደንዳና፤ ያቲደ ባረንቶ ዳንዳየቶፐ፥ ሀራይ አቶ ጾሳይ ዶሬዳዋንታካ ባለናዉ ዎልቃማ ማላታነ ማላልስያባ በሳናዋ። <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>በእተ፥ ታን ህንተዉ ሄዋ ካሰታደ ኦዳድ።<verse eid="MAT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26"/>“ሄዋ ድራዉ፥ አሳይ ህንተንታ፥ ‘በእተ፥ ክርስቶስ ባዙዋን ደኤ’ ጎፐ፥ ያ ቦፕተ፤ ዎይ ህንተንታ፥ ‘በእተ፥ ቆልኦን ደኤ’ ግንቶካ፥ ኡንቱንቱባ አማኖፕተ። <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>አያዉ ጎፐ፥ ዋልቃንይ አዋይፊ ዶልያ ባጋፐ ዋልቃሚደ፥ አዋይፊ ዉልያ ባጋ ጋካናዉ ጶልቁ ግያዋዳን፥ ታ ዩሳይ፥ አሳ ናኣ ዩሳይ፥ ሄዋዳን ሀናናዋ።<verse eid="MAT 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28"/>“ባኩታይ ደኢያሳ ሾርቲ ሺቃና።”<verse eid="MAT 24:28"/></para>
  <para style="s1">አሳ ናአይ፥ ክርስቶስ ላኤንዋ ያና</para>
  <para style="r">(<ref loc="MRK 13:24-27">ማር. 13:24-27</ref>፤ <ref loc="LUK 21:25-28">ሉቃሳ 21:25-28</ref>)</para>
  <para style="q1">
    <verse number="29" style="v" sid="MAT 24:29"/>“ሄ ዎደ ዋይያፐ ጉይያን፥</para>
  <para style="q2" vid="MAT 24:29">ኤለካ አዋይ ማና፤</para>
  <para style="q2" vid="MAT 24:29">አገናይ ፖእያዋ አጋናዋ፤</para>
  <para style="q2" vid="MAT 24:29">ጾልንታቱ ሳሉዋፐ ኩንዳናዋንታ፤</para>
  <para style="q2" vid="MAT 24:29">ቃይ ሳሉዋን ደእያ ዎልቃቱካ ቃጸታናዋንታ።<note caller="-" style="x"><char style="xo" closed="false">24:29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13:10</ref>፤ <ref loc="ISA 34:4">34:4</ref>፤ <ref loc="EZK 32:7">ህዝ. 32:7</ref>፤ <ref loc="JOL 2:10">ኢዩ. 2:10</ref>፣ <ref loc="JOL 2:31">31</ref>፤ <ref loc="JOL 3:15">3:15</ref>፤ <ref loc="REV 6:12-13">ሳፃ 6:12-13</ref></char></note><verse eid="MAT 24:29"/></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 24:30"/>ሄ ዎደ ታ ማላይ፥ አሳ ናኣ ማላይ፥ ሳሉዋን ቤታናዋ፤ ሳኣን ሄ ዎደ ደእያ አሳ ዛሪ ኡባይ ዬካናዋንታ። ቃይ ታን፥ አሳ ናአይ፥ ዎልቃናነ ዎልቃማ ቦንቹዋና ሳሉዋፐ ሻርያ ግዶና ዪሽን፥ ኡንቱንቱ በአና።<note caller="-" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳኔላ 7:13</ref>፤ <ref loc="ZEC 12:10-14">ዛካ. 12:10-14</ref>፤ <ref loc="REV 1:7">ሳፃ 1:7</ref></char></note> <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>እ ባረ ኪታንቻቱዋ ዎልቃማ ማላካታና ኪታና፤ ኪታንቻቱ አላመዉ ሀ ጋጻፐ ያ ጋጻ ጋካናዉ፥ ቃይ ሳኣን ኦይዱ ባጋፐ አዉ ዶረቴዳ አሳ ሺሻናዋ።<verse eid="MAT 24:31"/></para>
  <para style="s1">ጎዳይ ያና ጋላሳ ማላታ</para>
  <para style="r">(<ref loc="MRK 13:28-31">ማር. 13:28-31</ref>፤ <ref loc="LUK 21:29-33">ሉቃሳ 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>“ሌምሱዋ ባላሳቶ ጌተትያ ምትፐ አኬክተ፤ ባላሳታ አጭያ ዎደነ እዝ ሀይይ ቆለትያ ዎደ፥ ቦኒ ማቴዳዋ ህንተንቱ ኤራንታ። <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>ሄዋዳንካ፥ ህንተንቱ ሄ ኡባባ በእያ ዎደ፥ እ ማቲደ ፐንግያ ሺቄዳዋ ኤርተ። <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ሀ ኡባባይ ሀናና ጋካናዉ፥ ሀ ዎድያ አሳይ ሀይቂድገና። <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>ሳሉነ ሳአይ አና፤ ሽን ታ ቃላይ ኡባካ አና።<verse eid="MAT 24:35"/></para>
  <para style="s1">ጎዳይ ያና ጋላሳ ኦንነ ኤረና</para>
  <para style="r">(<ref loc="MRK 13:32-37">ማር. 13:32-37</ref>፤ <ref loc="LUK 17:26-30">ሉቃሳ 17:26-30</ref>፣ <ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>“ሽን ሄ ጋላሳነ ሄ ሳትያ አዉዋ ጻላላፐ አትን፥ ሀራይ አቶ ሳሉዋን ደእያ ኪታንቻቱዋ ግድና፥ ዎይ ታና ናኣ ግድናካ ኦንነ ኤርያዌ ባዋ። <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/>ታ ዩሳይ፥ አሳ ናኣ ዩሳይ፥ ኖሄ ዎደ ሀኖዋ ማላ ግዳናዋ።<note caller="-" style="x"><char style="xo" closed="false">24:37 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">ዶመ 6:5-8</ref></char></note> <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>አያዉ ጎፐ፥ ባሻ ሃ ዩሳፐ ካሰ ዎደ፥ ኖሄ ማርካብያን ገሌዳ ጋላሳይ ጋካናዉ፥ አሳይ ሜነ ኡሼነ፤ ቃይ አቱማ አሳይ አኬነ ማጫ አሳይ አስና ገሌ። <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>ባሻ ሃይ ዪደ፥ ኡንቱንታ ኡባ አፋና ጋካናዉ፥ ኡንቱንቱ አኬክበይክኖ፤ ታን፥ አሳ ናአይ፥ ይያ ዎዲ፥ ሄዋ ማላ ግዳናዋ።<note caller="-" style="x"><char style="xo" closed="false">24:39 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">ዶመ 7:6-24</ref></char></note><verse eid="MAT 24:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 24:40"/>“ሄ ዎደ ላኡ አሳቱ ጋደን ኦያዋንቱፐ እቱዋ አፋና፤ እቱ አታናዋ። <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>ላኡ ማጫዋንቱ ዎጻን ጋጭያዋንቱፐ እትኖ አፋና፤ እትና አታና።<verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>“ስም ህንተ ጎዳይ አይ ጋላስ ያናዌንቶ ህንተንቱ ኤረና ድራዉ፥ ናግ ኡትተ። <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>ሽን ካይሱ ቃማፐ ዎይሳ ዎድያን ያነንቶ ጎልያ ጎዳይ ኤሬደንቶ፥ ባረ ጎሊ ቦከተና ማላ፥ ቤጎቲደ ናግ ኡታናዋ ኤርተ። <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>ሄዋ ድራዉ፥ ህንተንቱካ ጊግ ኡትተ፤ አያዉ ጎፐ፥ ታን፥ አሳ ናአይ፥ ህንተንቱ ቆፐና ሳትያን ያና።<verse eid="MAT 24:44"/></para>
  <para style="s1">ኢታነ ሎኦ ቆማ ሌምሱዋ</para>
  <para style="r">(<ref loc="LUK 12:41-48">ሉቃሳ 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>“ያትና፥ ባረ ሶይ አሳዉ ቁማ ኮሽያ ዎድያን እማና ማላ፥ አ ጎዳይ ሱንዳ አማነቴዳ ዎዛናማ ቆማይ ኦኔ? <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>እ ሄዋዳን ኦሽን፥ አ ጎዳይ ዪደ ደምያ ቆማይ አንጀቴዳዋ። <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ጎዳይ ሄ ቆማ ባረዋ ኡባ ቦላ ሱንና። <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>ሽን ቆማይ ኢታ ግዶፐ፥ ‘ታ ጎዳይ ጋምኢደ ያናዋ’ ያጊደ ባረ ዎዛናን ቆፒደ፥ <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>ባረ ላገ ቆማቱዋ ዋ ዶሞፐ፥ ማትያዋንቱና ሞፐነ ኡሾፐ፥ <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>ሄ ቆማ ጎዳይ እ ቆፕቤና ጋላሳንነ እ ኤርቤና ሳትያን ያና። <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>ሄዋፐ ጉይያን አ ቃንጸሬደ፥<note caller="+" style="f"><char style="fr" closed="false">24:51 </char><char style="fk" closed="false">አ ቃንጸሬደ፦ </char><char style="ft" closed="false">ጉሳይ ከስ ካረ ኦላናዋ ግያዋ።</char></note> ሎአ ማላትያ ኢታ አሳቱ ደእያ ሳን ዎና፤ ሄዋን እ ዬካናነ አቻ ቃና።<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s1">ታሙ ዎዶራቱዋ ሌምሱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>“ሄ ዎደ ሳሉዋ ካዉተይ ባረንቱ ኩራዝያ ኦይቂደ፥ ማቻቶ አክያዋ ሞካናዉ ካረ ከሴዳ ታሙ ዎዶራቱዋ ማላታና። <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>ኡንቱንቱፐ እቼሻቱ ቦዛቱዋ፤ ቃይ እቼሻቱ ጭንጫ። <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>ቦዛቱ ባረንቱ ኩራዝያ ኦይቄድኖ፤ ሽን ላምባ ኦይቂበይክኖ። <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>ሽን ጭንጫቱ ባረንቱ ኩራዝያነ ጻራሙስያን ላምባ ኦይቄድኖ። <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>ማቻቶ አክያዌ ዬናን ጋምእና፥ ሄ ዎዶራቱ ባረንታ ገምእሽስና ግስ አጌድኖ።<verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>“ብላሄ ግዴዳ ዎደ፥ ‘በእተ፥ ማቻቶ አክያዌ ጋኬዳ፤ አ ሞካናዉ ካረ ከስተ’ ያግያ ዎልቃማ ጫቡ ደንዴዳ።<verse eid="MAT 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7"/>“ሄ ዎደ ሄ ዎዶራቱ ኡባቱ ቤጎቲደ፥ ባረንቱ ኩራዝያ ጊግሴድኖ። <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>ቦዛቱ ጭንጫቱዋ፥ ‘ኑ ኩራዝ ቶአና ሀንያ ድራዉ፥ ህንተንቱ ላምባፐ ኑዉ እሜርክቴ’ ያጌድኖ።<verse eid="MAT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9"/>“ሽን ጭንጫቱ ዛሪደ ኡንቱንታ፥ ‘አግተ፥ ኑዉነ ህንተንቶ ግደና፤ ሄዋ ድራ ህንተዉ ዛልእያዋንቱኮ ቢደ ሻም አክተ’ ያጌድኖ። <verse eid="MAT 25:9"/><verse number="10" style="v" sid="MAT 25:10"/>ሄዋፐ ጉየ ቦዛ ዎዶራቱ ላምባ ሻማናዉ ብድግና፥ ማቻቶ አክያዌ ፑቱ ጊና፥ ጊግ ኡቴዳ እቼሹ ዎዶራቱ አናና እትፐ ቡላቻ ጎልያ ገሌድኖ፤ እፍይካ ጎርደት አጌዳ።<verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>“ጉየፐ ቃይ የኮ ዎዶራቱ ዪደ፥ ‘ጎዳዉ፥ ጎዳዉ፥ ኑዉ ዶያርኪ’ ያጌድኖ።<verse eid="MAT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12"/>“ሽን ማቻቶ አክያዌ ዛሪደ፥ ‘ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ታን ህንተንታ ኤርከ’ ያጌዳ።<verse eid="MAT 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13"/>“ስም ታን፥ አሳ ናአይ፥ ያና ጋላሳ ዎይ ሳትያ ህንተንቱ ኤረና ድራዉ፥ ናግ ኡትተ።<verse eid="MAT 25:13"/></para>
  <para style="s1">ሄዙ ቆማቱዋ ሌምሱዋ</para>
  <para style="r">(<ref loc="LUK 19:11-27">ሉቃሳ 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>“አያዉ ጎፐ፥ ሳሉዋ ካዉተይ ባረ ቆማቱዋ ጼሲደ፥ ባረዉ ደእያዋ ኡንቱንቶ ሼደ፥ ኦግያ ባና ሀንያ ብታንያ በሴ። <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>ኡንቱንቱ ሁጲያን ሁጲያን ኡንቱንቱ ዎልቃ ኬና እቶ እቼሹ ሻአ ብራ፥ እቶ ላኡ ሻአ ብራ፥ ቃይ እቶ እት ሻአ ብራ እሚደ፥ ባረ ኦግያ ቤዳ። <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>እቼሹ ሻአ ብራ አኬዳ ቆማይ ኤለካ ቢደ ዛልኢደ፥ ሀራ እቼሹ ሻአ ብራ ዎሴዳ። <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>ሄዋዳንካ፥ ቃይ ላኡ ሻአ ብራ አኬዳ ቆማይ ሀራ ላኡ ሻአ ብራ ዎሴዳ። <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>ሽን እት ሻአ ብራ አኬዳዌ ቢደ፥ ኦላ ቦኪደ፥ ባረ ጎዳ ሚሻ ሞግ አጌዳ።<verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>“ዳሮ ዎድያፐ ጉይያን፥ ሄ ቆማቱዋ ጎዳይ ዪደ፥ ባረ ሚሻ ኡንቱንቱና ሄተቴዳ። <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>እቼሹ ሻአ ብራ አኬዳ ቆማይ ዪደ፥ ሀራ እቼሹ ሻአ ብራ ሼደ፥ ‘ታ ጎዳዉ፥ ኔን ታዉ እቼሹ ሻአ ብራ እማዳ፤ በአ፥ ሀራ እቼሹ ሻአ ብራ ዎሳድ’ ያጌዳ። <verse eid="MAT 25:20"/><verse number="21" style="v" sid="MAT 25:21"/>አ ጎዳይ አ፥ ‘ሀያናሾ! ኔን ሎአነ አማነትያ ቆማ፤ ኔን ጉባን አማነታዳ። ታን ኔና ዳሮባዉ ካፖ ኦና፤ ሃ ገላደ ነ ጎዳና ናሸታ’ ያጌዳ።<verse eid="MAT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22"/>“ቃይ ላኡ ሻአ ብራ አኬዳዌካ ዪደ፥ ‘ታ ጎዳዉ፥ ኔን ታዉ ላኡ ሻአ ብራ እማዳ፤ በአ፥ ታን ሀራ ላኡ ሻአ ብራ ዎሳድ’ ያጌዳ። <verse eid="MAT 25:22"/><verse number="23" style="v" sid="MAT 25:23"/>አ ጎዳይ አ፥ ‘ሀያናሾ! ኔን ሎአነ አማነትያ ቆማ፤ ኔን ጉባን አማነታዳ። ታን ኔና ዳሮባዉ ካፖ ኦና፤ ሃ ገላደ ነ ጎዳና ናሸታ’ ያጌዳ።<verse eid="MAT 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24"/>“እት ሻአ ብራ አኬዳዌ ቃይ ዪደ፥ ‘ታ ጎዳዉ፥ ኔን ዘራቤናሳፐ ቆይጭያ አሳ ግድያዋነ ካ ላላቤናሳፐ ማጽያ መቀ ባይና አሳ ግድያዋ ታን ኤራይ። <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>ታን ያያድ፤ ያታደ ባደ ነ ብራ ቢታን ሞጋድ፤ በአ፥ ነ ብራይ ሀዌኩ’ ያጌዳ።<verse eid="MAT 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26"/>“አ ጎዳይ ዛሪደ፥ አ ሀዋዳን ያጌዳ፤ ‘ሀ ኢታ አዛላ ቆማዉ፥ ታን ዘራቤናሳፐ ቆይጭያ አሳ ግድያዋነ ካ ላላቤናሳፐ ማጽያ አሳ ግድያዋ ኤራዲ? <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>ያትና፥ ኔን ታ ሚሻ ዎስያዋንቱ ማታን ዎዳዋ ግድንቶ፥ ታን ስምያ ዎደ ታ ሚሻ ዎያና አካናዋሽን አቴዳ። <verse eid="MAT 25:27"/><verse number="28" style="v" sid="MAT 25:28"/>ሄዋ ድራዉ፥ ሄ ሚሻ አፐ ዎ አኪደ፥ ታሙ ሻአ ብራይ ደእያዎ እምተ። <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/>አያዉ ጎፐ፥ ደእያ ኡባዉ ሀራይ ጉጀታና፤ እ ባረዉ ግድያዋፐ ዳርሲደ አካና፤ ሽን ባይናዎ ሀራይ አቶ፥ ሄ አዉ ደእያ ጉይካ አፐ አከታናዋ። <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>ጎኤና ቆማ ካረ ማ ከስ ኦልተ፤ ሄዋን እ ዬካናነ ባረ አቻ ቃና’ ያጌዳ።<verse eid="MAT 25:30"/></para>
  <para style="s1">ዎድያ ዉርሰን ሀናና ፕርዳ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>“ታን፥ አሳ ናአይ፥ ኪታንቻቱዋ ኡባቱዋና ቦንቹዋን ይያ ዎደ፥ ታ ቦንቾ ካዉተ ኦይድያን ኡታና።<note caller="-" style="x"><char style="xo" closed="false">25:31 </char><char style="xt" closed="false"><ref loc="MAT 16:27">ማቶሳ 16:27</ref>፤ <ref loc="MAT 19:28">19:28</ref></char></note> <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>ሳኣን ደእያ አሳይ ኡባይ ታ ስን ሺቃናዋንታ፤ ሄምያዌ ዶርሳቱዋ ዴሻቱዋፐ ሻክያዋዳን፥ ታን ሄ አሳ ላኡ ከሳደ ሻካና። <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>ቃይ ዶርሳቱዋ ታፐ ኡሸቻ ባጋና ኤሳደ፥ ዴሻቱዋ ታፐ ሀድርሳ ባጋና ኤሳና።<verse eid="MAT 25:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34"/>“ሄዋፐ ጉይያን፥ ታን ካቲ ታፐ ኡሸቻ ባጋና ደእያዋንታ ሀዋዳን ያጋና፤ ‘ታ አቡ አንጄዳዋንቶ፥ ሃ ዪደ ሳአይ መቶደፐ ሀቼ ጋካናዉ፥ ህንተንቶ ጊጌዳ ካዉተ ላትተ። <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>አያዉ ጎፐ፥ ታን ኮሻትና ምዜድታ፤ ሳመትና ኡሼድታ፤ እማ ግዳደ ቢናካ ሞኬድታ። <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>ታን ካሎትና ማይዜድታ፤ ሀርግና በኤድታ፤ ቃሸትና ታኮ ጋኪደ ኦቼድታ’ ያጋና።<verse eid="MAT 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37"/>“ሄዋፐ ጉይያን፥ ጽላቱ ዛሪደ፥ አ ሀዋዳን ያጋና፤ ‘ጎዳዉ፥ ኔን ኮሻትና፥ አዉደ በኢደ ምዜዶ? ዎይ ኔን ሳመትና፥ አዉደ በኢደ ኡሼዶ? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>ኔን እማ ግዳደ ዪና አዉደ በኢደ ሞኬዶ? ዎይ ኔን ካሎትና አዉደ ማይዜዶ? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>ቃይ ኔን ሀርግና፥ ዎይ ቃሸትና ኔኮ ቢደ አዉደ ኔና በኤዶ?’ ያጋናዋንታ። <verse eid="MAT 25:39"/><verse number="40" style="v" sid="MAT 25:40"/>ታን ካቲ ዛራደ፥ ‘ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ህንተንቱ ሀ ታ እሻቱዋ ኡባፐ ሀራይ አቶ፥ ላፍያ እቶ ኦዳዋ ግድንቶካ፥ ሄዋ ታዉ ኦድታ’ ያጋና።<verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>“ሄ ዎደ፥ ታፐ ሀድርሳ ባጋና ደእያዋንታ ታን ያጋና፤ ‘ሀ ሸቀቴዳዋንቶ፥ ታ ማታፐ ክችተ፤ ቢደ ጻላህያ ካፖነ አ ኪታንቻቶ ጊጌዳ መና ታማን ገልተ። <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>አያዉ ጎፐ፥ ታን ኮሻትና፥ ታና ምዝበይክታ፤ ሳመትና ኡሽበይክታ። <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>ታን እማ ግዳደ ቢና፥ ታና ሞክበይክታ፤ ካሎትና ማይዝበይክታ፤ ቃይ ሀርግና፥ ቃሸትናካ ታና በእበይክታ’ ያጋና።<verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>“ሄ ዎደ ኡንቱንቱ ቃይ ሀዋዳን ያጊደ ዛራናዋንታ፤ ‘ጎዳዉ፥ ኔን ኮሻትና ዎይ ሳመትና፥ ዎይ እማ ግዳደ ቢና ዎይ ካሎትና፥ ዎይ ሀርግና ዎይ ቃሸትና፥ አዉደ በኢደ፥ ኔና ማደናን እጼዶ?’ ያጋናዋንታ።<verse eid="MAT 25:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45"/>“ሄ ዎደ ታን ካቲ ዛራደ ኡንቱንታ፥ ‘ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ህንተንቱ ሀ ኡባፐ ላፍያ እቱዋ ማደናን እጼዳዌ፥ ታና ማደናን እጼዳዋ’ ያጋና። <verse eid="MAT 25:45"/><verse number="46" style="v" sid="MAT 25:46"/>ሄዋንቱ መና ሙራዉ ባና፤ ሽን ጽላቱ መና ደኦ ባና” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">25:46 </char><char style="xt" closed="false"><ref loc="DAN 12:2">ዳኔላ 12:2</ref></char></note><verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s1">የሱሳ ቦላ ማቀቴድኖ</para>
  <para style="r">(<ref loc="MRK 14:1-2">ማር. 14:1-2</ref>፤ <ref loc="LUK 22:1-2">ሉቃሳ 22:1-2</ref>፤ <ref loc="JHN 11:45-53">ዮሃ. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>የሱስ ሀ ትምርትያ ኡባ ዉርሴዳ ዎደ፥ ባረና ካልያዋንታ፥ <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>“ላኡ ጋላሳፐ ጉይያን፥ ፓስጋ ባላ ቦንችያ ጋላሳ ግድያዋ ኤሪታ። ሄ ጋላስ ታና፥ አሳ ናኣ፥ አሳይ ማስቃልያ ቦላ ምስማርያን ሺደ ካቃናዉ አደ እማና” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">26:2 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ከሳ 12:1-27</ref></char></note><verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>ሄ ዎደ ቄሳቱዋ ካፓቱነ ጋድያ ጭማቱ ቃያፋ ጌተትያ ቄሳቱዋ ኡባቱዋ ካፑዋ ዎጋ ጎልያን ሺቂደ፥ <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>አሳይ ኤረናን የሱሳ ኦይቂደ፥ ዎናዉ ማቀቴድኖ። <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>ሽን ኡንቱንቱ፥ “አሳይ ዋላሳ ከሰና ማላ፥ ፓስጋ ቦንችያ ጋላስ ሄዋ ኦኮ” ያጌድኖ።<verse eid="MAT 26:5"/></para>
  <para style="s1">እት ማጫ ምሽራታ የሱሳ ሽቱዋ ጫጫፋዱ</para>
  <para style="r">(<ref loc="MRK 14:3-9">ማር. 14:3-9</ref>፤ <ref loc="JHN 12:1-8">ዮሃ. 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>የሱስ ቢታንያ ካታማን ኦሉዋ ሀርግያ ስሞና ሶይን ደእሽን፥ <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>እት ምሽራታ አልባስጽሮሳ ጌተትያ ሹቻፐ ኦሰቴዳ አልባስጽሮሳ ባሬታ ኩሜዳ ዳሪ አልኦ ሽቱዋ አካደ ዬዳዉና ቁማ እ ሚና፥ ሄ ሽቱዋ የሱሳ ሁጲያን ጫጫፋዱ። <verse eid="MAT 26:7"/><verse number="8" style="v" sid="MAT 26:8"/>ሽን የሱሳ ካልያዋንቱ ሄዋ በኢደ፥ “ሀ ሽቱዋ ጮ ባይዙሳይ አያሴ? <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>አያዉ ጎፐ፥ ሀ ሽቱዋ አልኦ ጋትያን ዛልኢደ፥ ሚሻ ህዬሳዉ እማናዉ ዳንዳየቴ” ያጌድኖ።<verse eid="MAT 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10"/>የሱስ ኡንቱንቱ ግያዋ ኤሪደ፥ ኡንቱንታ ሀዋዳን ያጌዳ፤ “ሀ ምሽራቶ አያዉ ዋይሲቴ? እዛ ታዉ ሎኦባ ኦዱ። <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>ህዬሳቱ ኡባ ዎደ ህንተናና ደኢኖ፤ ሽን ታን ህንተናና ኡባ ዎደ ደእከ፤<note caller="-" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ዛረ. 15:11</ref></char></note> <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>እዛ ሀ ሽቱዋ ታ ቦላ ትግያዌ ታና ሞጋናዉ ጊግሳናሳ። <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ሳኣ ኡባን ሀ ዎንጋላ ምሽራቹዋ ኦድያሳን ሀቃንነ፥ አሳይ እዞ ዎዛና አና ማላ፥ እዛ ኦዳዌ ኦደታናዋ” ያጌዳ።<verse eid="MAT 26:13"/></para>
  <para style="s1">ይሁዳይ የሱሳ አደ እማናዉ የዉዋን ጊጌዳ</para>
  <para style="r">(<ref loc="MRK 14:10-11">ማር. 14:10-11</ref>፤ <ref loc="LUK 22:3-6">ሉቃሳ 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>ሄ ዎደ ታማነ ላኡ የሱሳ ካልያዋንቱፐ እቱ ይሁዳ አስቆሮቱ ያገትያዌ ቄሳቱዋ ካፓቱዋኮ <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>ቢደ፥ “ታን ህንተንቶ የሱሳ ኦይፐ፥ ታዉ አያ እማንቴ?” ያግና ኡንቱንቱ አዉ ሀታሙ ብራ ቆፒደ እሜድኖ።<note caller="-" style="x"><char style="xo" closed="false">26:15 </char><char style="xt" closed="false"><ref loc="ZEC 11:12">ዛካ. 11:12</ref></char></note> <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>ሄዋፐ ጉይያን፥ ይሁዳይ የሱሳ አ እማናዉ እንጀትያ ዎድያ ዎቼ።<verse eid="MAT 26:16"/></para>
  <para style="s1">የሱስ አይሁዳቱ ፓስጋ ካዉዋ ባረና ካልያዋንቱና ሜዳ</para>
  <para style="r">(<ref loc="MRK 14:12-21">ማር. 14:12-21</ref>፤ <ref loc="LUK 22:7-14">ሉቃሳ 22:7-14</ref>፣ <ref loc="LUK 22:21-23">21-23</ref>፤ <ref loc="JHN 13:21-30">ዮሃ. 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>ባላ ዳቡዋ ምያ ጋላሳ ቦንችያ ኮይሮ ጋላስ፥ የሱሳ ካልያዋንቱ አኮ ዪደ፥ “ፓስጋ ቦንችያ ጋላስ ኔን ማና ቁማ ሀቃን ጊግሳኔ?” ያጌድኖ።<verse eid="MAT 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18"/>ሄዋፐ ጉየ የሱስ ኡንቱንታ፥ “ካታማ ቢደ፥ እት ብታንያ፥ ‘ታማርስያዌ ኔና፥ “ታዉ ዎዲ ጋኬዳ፤ ታን ታና ካልያዋንቱና ፓስጋ ቦንችያ ጋላሳ ነ ሶይን አና” ጌዳ’ ጊተ” ያጌዳ።<verse eid="MAT 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19"/>አ ካልያዋንቱ የሱስ ባረንታ አዛዞዋዳን ኦደ፥ ፓስጋ ቦንችያ ጋላስ ማና ቁማ ጊግሴድኖ።<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>ሳአይ ኦማርሴዳ ዎደ፥ የሱስ ታማነ ላኡ አ ካልያዋንቱና ቁማ ማናዉ ኡቴዳ። <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>ኡንቱንቱ ሚሽን፥ የሱስ ኡንቱንታ፥ “ታን ህንተንቶ ቱሙዋ ኦዳይ፤ ህንተፐ እት ኡራይ ታና አደ እማናዋ” ያጌዳ።<verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>ኡንቱንቱ ዳሪ ዳጋሚደ፥ ሁጲያን ሁጲያን፥ “ጎዳዉ፥ ቱሙ ታኔሻ?” ጉሳ ዶሜድኖ።<verse eid="MAT 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23"/>የሱስ ዛሪደ፥ “ባረ ኩሽያ ታናና እትፐ ዎጪትያፐ የዲደ ቱሽያዌ ታና አ እማና።<note caller="-" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="PSA 41:9">ማዝ. 41:9</ref></char></note> <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>ታን፥ አሳ ናአይ፥ ጾሳ ማጻፋይ ሀይቃና ጌዳዋዳን ሀይቃና፤ ሽን ታና፥ አሳ ናኣ፥ አ እምያ ኡራዉ አየሮ፤ ሄ ኡራይ የለተናን አቴደንቶ አዉ ሎአ ሽን” ያጌዳ።<verse eid="MAT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25"/>አ አ እምያ ይሁዳይ ዛሪደ፥ “ታማርስያዎ፥ ኔን ግያዌ ታኔ?” ያጌዳ።</para>
  <para style="p" vid="MAT 26:25">የሱስ ዛሪደ አ፥ “ኔን ነ ሁጲያን ጋዳ” ያጌዳ።<verse eid="MAT 26:25"/></para>
  <para style="s1">ጎዳ ካዉዋ አክያ ዎጋ</para>
  <para style="r">(<ref loc="MRK 14:22-26">ማር. 14:22-26</ref>፤ <ref loc="LUK 22:15-20">ሉቃሳ 22:15-20</ref>፤ <ref loc="1CO 11:23-25">1 ቆሮ. 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>ኡንቱንቱ ሚሽን፥ የሱስ ዳቡዋ አኪደ፥ ጾሳ ጋላቴዳ፤ ሄ ዳቡዋ መንሬደ፥ ባረና ካልያዋንቶ እሚደ፥ “ሄይተ፤ ሚተ፤ ሀዌ ታ አሹዋ” ያጌዳ።<verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>ጹኣ አኪደ፥ ጾሳ ጋላቴዳ። ኡንቱንቶ እሚደ፥ “ኡባይ ሀዋፐ ኡሽተ፤ <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>አያዉ ጎፐ፥ ሀዌ ዳሮ አሳ ናጋራይ አቶ ጌተታና ድራዉ ጉክያ ታ ሱ፤ ታ ሱይ ኦራ ጫቁዋ።<note caller="-" style="x"><char style="xo" closed="false">26:28 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ከሳ 24:8</ref>፤ <ref loc="JER 31:31-34">ኤር. 31:31-34</ref></char></note> <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>ሽን ታን ህንተንቶ ኦዳይ፤ ታን ታ አቡ ካዉተን ኦራ ዎይንያ ኤሳ ህንተንቱና ኡሻና ጋላሳይ ጋካናዉ፥ ላኤንዋ ሀ ዎይንያ ኤሳ ኡባካ ኡሽከ” ያጌዳ።<verse eid="MAT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>ማዝሙርያ የጾዋፐ ጉይያን፥ ደብረ ዛይተ ጌተትያ ደርያ ቤድኖ።<verse eid="MAT 26:30"/></para>
  <para style="s1">የሱስ ጰጽሮስ ካዳናዋ ካሰቲደ ኦዴዳ</para>
  <para style="r">(<ref loc="MRK 14:27-31">ማር. 14:27-31</ref>፤ <ref loc="LUK 22:31-34">ሉቃሳ 22:31-34</ref>፤ <ref loc="JHN 13:36-38">ዮሃ. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>የሱስ ሄ ዎደ ኡንቱንታ፥ “ሀቼ ቃማ ህንተንቱ ኡባይ ታና አጊደ ክቻና፤ አያዉ ጎፐ፥ ጾሳ ማጻፋይ፥</para>
  <para style="q1" vid="MAT 26:31">“ ‘ጾሳይ ዶርሳ ሄምያዋ ዎናዋ፤</para>
  <para style="q2" vid="MAT 26:31">ሄዋፐ ጉይያን ዶርሳ ዉዲ ላለታናዋ’</para>
  <para style="m" vid="MAT 26:31">ያጌ።<note caller="-" style="x"><char style="xo" closed="false">26:31 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">ዛካ. 13:7</ref></char></note> <verse eid="MAT 26:31"/><verse number="32" style="v" sid="MAT 26:32"/>ሽን ታን ሀይቁዋፐ ደንዶዋፐ ጉይያን፥ ህንተፐ ካሰታደ ጋሊላ ባና” ያጌዳ።<verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>ጰጽሮስ ዛሪደ፥ “ኡንቱንቱ ኡባቱ ኔና አጊደ ክቻናዋንታ፤ ታን ኔና ኡባካ የጋደ ክችከ” ያጌዳ።<verse eid="MAT 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34"/>የሱስ ጰጽሮሳ፥ “ታን ነዉ ቱሙዋ ኦዳይ፤ ሀቼ ቃማ ኩቱ ዋሳናፐ ካሰ፥ ኔን ታና ሄዙ ካላ ካዳናሳ” ያጌዳ።<verse eid="MAT 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35"/>ጰጽሮስ ዛሪደ፥ “ታን ሀራይ አቶ፥ ኔናና እትፐ ሀይቂንቶካ፥ ኔና ኡባካ ካድከ” ያጌዳ። ቃይ የሱሳ ካልያዋንቱ ኡባቱካ ሄዋዳን ጌድኖ።<verse eid="MAT 26:35"/></para>
  <para style="s1">የሱስ ጌተሰማንያን ዎሴዳ</para>
  <para style="r">(<ref loc="MRK 14:32-42">ማር. 14:32-42</ref>፤ <ref loc="LUK 22:39-46">ሉቃሳ 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>የሱስ ሄ ዎደ ባረና ካልያዋንቱና ጌተሰማንያ ጌተትያሳ ቢደ ኡንቱንታ፥ “ታን ህን ባደ ጾሳ ዎስሽን፥ ህንተንቱ ሀዋን ኡትሽተ” ያጌዳ። <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>ሄዋፐ ጉየ ጰጽሮሳነ ዛብድዮሳ ናና ላኡዋ ባረናና አፊደ፥ ዳሮ ካዩዋነ ኡጋ ዶሜዳ። <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>ቃይ ኡንቱንታ፥ “ታን ሀይቃና ጋካናዉካ ካዮታይ፤ ሀዋን ቤጎቲደ፥ ታናና ናግተ” ያጌዳ።<verse eid="MAT 26:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39"/>ላፋ ስንኮ ሺቂደ፥ ሳኣን ጉፋኒደ፥ “ታ አቦ፥ ዳንዳየትያዋ ግዶፐ፥ ሀ ጹኣ ታፐ ድጋ፤ ሽን ኔን ኮይያዋዳን ሀኖፐ አትን፥ ታን ኮይያዋዳን ሀኖፖ” ያጊደ ጾሳ ዎሴዳ።<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>የሱስ ባረና ካልያዋንቱኮ ስሚደ ዬዳ፤ ገምእሾዋንታ ደሚደ ጰጽሮሳ፥ “ህንተንቱ እት ሳተንቶነካ ገምእሸናን ታናና ናጋናዉ ዳንዳይበይክቴ? <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>ፓጭያን ህንተንቱ ገለና ማላ፥ ምንተነ ጾሳ ዎስተ፤ አያናይ ጊግ ኡቴዳ፤ ሽን አሳተ ኤሻይ ዳቡራንቻ” ያጌዳ።<verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>የሱስ ቃይ ላኤንዋ ቢደ፥ “ታ አቦ፥ ታን ሀ ዎልቃማ መቱዋ አከናን ደእሽን ጹኣ ደንናዉ ዳንዳየተናዋ ግዶፐ፥ ኔን ግያዌ ሀኖ” ያጊደ ጾሳ ዎሴዳ። <verse eid="MAT 26:42"/><verse number="43" style="v" sid="MAT 26:43"/>ቃይካ ስም ዪደ፥ አ ካልያዋንቱ አይፍያ ገምእሹ ጎዝ ዎዳ ድራዉ፥ ገምእሾዋንታ ደሜዳ።<verse eid="MAT 26:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44"/>ቃይካ ኡንቱንታ የግ ቢደ፥ ሄዘንዋ ካሰ ቃላ ዛሪደ፥ ጾሳ ዎሴዳ። <verse eid="MAT 26:44"/><verse number="45" style="v" sid="MAT 26:45"/>ሄዋፐ ጉይያን፥ ባረና ካልያዋንቶ ዪደ፥ “ሀእ ጋካናዉካ ገምእሺቴነ ሸምፒቴ? በእተ፥ ታና፥ አሳ ናኣ፥ ናጋራንቻ አሳቶ አደ እምያ ዎዲ ጋኬዳ። <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>ደንድና ቦይተ፤ በእተ፥ ታና አ እምያዌ ሀዌኩ ጋኬዳ” ያጌዳ።<verse eid="MAT 26:46"/></para>
  <para style="s1">የሱስ ባረ ሞርከቱዋን ኦይቀቴዳ</para>
  <para style="r">(<ref loc="MRK 14:43-50">ማር. 14:43-50</ref>፤ <ref loc="LUK 22:47-53">ሉቃሳ 22:47-53</ref>፤ <ref loc="JHN 18:3-12">ዮሃ. 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>የሱስ ሄዋ ብሮ ሃሳይሽን፥ ታማነ ላኡ አ ካልያዋንቱፐ እቱ፥ ይሁዳይ፥ ጋክ ዎዳ፤ ቃይ ቄሳቱዋ ካፓቱነ ጋድያ ጭማቱ ኪትና፥ ማሻነ ጻምኣ ኦይቄዳ ጮራ አሳይ አናና እትፐ ዬዳ። <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>የሱሳ አ እምያዌ ሄ ጮራ አሳ፥ “ታን የርያዌ አ፤ አ ኦይቂተ” ያጊደ ማላ ኦድ ዎዳ።<verse eid="MAT 26:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49"/>ኤለካ የሱሳኮ ሺቂደ፥ “ታማርስያዎ፥ ሳሮ ደአይ” ያጊደ አ የር አኬዳ።<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>የሱስ ይሁዳ፥ “ታ ላገዉ፥ ኔን ኦናባ ኦ አጋ” ያጌዳ።</para>
  <para style="p" vid="MAT 26:50">ሄዋፐ ጉይያን፥ ሄ ጮራ አሳይ ሺቂደ፥ የሱሳ ሎይ ኦይቄዳ። <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>የሱሳና ደእያዋንቱፐ እቱ ባረ ማሻ ከሲደ ቄሳቱዋ ኡባቱዋ ካፑዋ ቆማ ሀይ ቃንጽ ኦሌዳ። <verse eid="MAT 26:51"/><verse number="52" style="v" sid="MAT 26:52"/>የሱስ ሄ ዎደ አ ሀዋዳን ያጌዳ፤ “ነ ማሻ አኬዳሳን ዛራደ ዎ፤ አያዉ ጎፐ፥ ማሻ ደንያ ኡባይ ማሻን ሀይቃና። <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>ታ አቡ ዳሮ ሻአ ኪታንቻቱዋ እት ኩን የዲደ፥ ታና ማዳና ማላ፥ ታን አ ዎሳናዉ ዳንዳይያዋ ኤርኪ? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>ያትና፥ ጾሳ ቃላይ ሀዋዳን ሀናናዉ በሴ ያጌዳዌ ዋኒደ ፖለታናዉ ዳንዳዪ?” ያጌዳ።<verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>ሄዋፐ ጉይያን፥ የሱስ ሄዋን ሺቄዳ ጮራ አሳ ሀዋዳን ያጌዳ፤ “ታና ካይሶ ከሲደ፥ ካይሱዋ ኦይቂያዋዳን ኦይቃናዉ ማሻነ ጻምኣ ኦይቂደ ዬድቴ? ታን ጌሻ ጎልያን ታማርሳደ፥ ጋላሳን ጋላሳን ህንተንቱና ኦያ ዎደ ታና ኦይቂበይክታ፤ <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>ሽን ሀዌ ኡባይ ሀኔዳዌ ናባቱ ጾሳ ቃላን ጻፌዳዌ ፖለታናሳ” ያጌዳ።</para>
  <para style="p" vid="MAT 26:56">የሱሳ ካልያዋንቱ ሄ ዎደ ኡባቱ አ የግ ቤድኖ።<verse eid="MAT 26:56"/></para>
  <para style="s1">የሱስ ፕርዳ ሻንጎ አዳ</para>
  <para style="r">(<ref loc="MRK 14:53-65">ማር. 14:53-65</ref>፤ <ref loc="LUK 22:54-55">ሉቃሳ 22:54-55</ref>፣ <ref loc="LUK 22:63-71">63-71</ref>፤ <ref loc="JHN 18:13-14">ዮሃ. 18:13-14</ref>፣ <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>የሱሳ ኦይቄዳዋንቱ ቄሳቱዋ ኡባቱዋ ካፑዋ ቃያፋኮ፥ ህግያ ታማርስያዋንቱነ ጭማቱ ሺቄዳሳ አኪደ ቤድኖ። <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>ሽን ጰጽሮስ ቄሳቱዋ ኡባቱዋ ካፑዋ ድርሳ ግዶ ጋካናዉ፥ ሃኩዋን አ ካሌዳ፤ የዉዋ ዉርሰ በአናዉ ድርሳ ግዶ ገሊደ፥ ናግያዋንቱና ኡት አጌዳ።<verse eid="MAT 26:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59"/>ቄሳቱዋ ካፓቱነ ሺቄዳ አሳይ ኡባይ የሱሳ ዎናዉ አ ቦላ ዎርዱዋ ማርካ ደማናዉ ኮዬድኖ። <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>ሽን ሀራይ አቶ ጮራ አሳይ ዪደ፥ አ ቦላ ዎርዱዋን ማርካትናካ አፐ አይነ ደምበይክኖ። ጉየፐ ላአቱ ዪደ፥ <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>“ሀ ብታኒ፥ ‘ታን ጾሳ ጌሻ ጎልያ ኮላደ፥ ሄዙ ጋላሳን ዛራደ ኬጻናዉ ዳንዳያይ’ ጌዳ” ያጌድኖ።<verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>ቄሳቱዋ ኡባቱዋ ካፑ ደንድ ኤቂደ የሱሳ፥ “ሀዋንቱ ኔና ሞትያ ሞቶ ነዉ ዛርያባይ ባዌ?” ያጌዳ። <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/>ሽን የሱስ ጮኡ ጌዳ፤ ቃይካ ቄሳቱዋ ኡባቱዋ ካፑ አ፥ “ታን ኔና ደኡዋ ጾሳ ሱንን ጫላይ፤ ኔን ጾሳ ናኣ ክርስቶሳ ግዶፐ ኑዉ ኦዳ” ያጌዳ።<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>የሱስ ዛሪደ፥ “ኔን ነ ሁጰዉካ ጋዳ፤ ሽን ታን ህንተንቶ ኦዳይ፤ ሀዋፐ ስንን፥ ህንተንቱ ታና፥ አሳ ናኣ፥ ዎልቃማ ጾሳፐ ኡሸቻ ባጋና ኡቴዳዋነ ሳሉዋ ሻርያና ዪሽን በአና” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">26:64 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳኔላ 7:13</ref></char></note><verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>ሄዋፐ ጉይያን፥ ቄሳቱዋ ኡባቱዋ ካፑ ባረ ማዩዋ ፔ ኦሊደ፥ “ሀዌ ቦሬዳ፤ ኑና ሀዋፐ ስንን አያዉ ሀራ ማርካ ኮሺ? እ ሀእ ቦርያዋ ህንተንቱ ስሴድታ። <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>ህንተንቱ ቆፋይ አዬ?” ያጌዳ።</para>
  <para style="p" vid="MAT 26:66">ኡንቱንቱ፥ “አዉ ሀይቁ በሴ” ያጊደ ዛሬድኖ።<note caller="-" style="x"><char style="xo" closed="false">26:66 </char><char style="xt" closed="false"><ref loc="LEV 24:16">ዎጋ 24:16</ref></char></note><verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>ሄዋፐ ጉይያን፥ ኡንቱንቱ አ ዴሙዋን ጩቺደ፥ አ ደቼድኖ፤ ሀራንቱ ቃይ አ ባቂደ፥<note caller="-" style="x"><char style="xo" closed="false">26:67 </char><char style="xt" closed="false"><ref loc="ISA 50:6">ኢሳ. 50:6</ref></char></note> <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>“ክርስቶሳ! ኔን ኔና ናበ ጋሳሽን፥ ኔና ሾጬዳዌ ኦነንቶ አነ ኑዉ ኦዳ!” ያጌድኖ።<verse eid="MAT 26:68"/></para>
  <para style="s1">ጰጽሮስ የሱሳ ካዴዳ</para>
  <para style="r">(<ref loc="MRK 14:66-72">ማር. 14:66-72</ref>፤ <ref loc="LUK 22:56-62">ሉቃሳ 22:56-62</ref>፤ <ref loc="JHN 18:15-18">ዮሃ. 18:15-18</ref>፣ <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>ጰጽሮስ ጎልያፐ ካረና ድርሳ ግዶን ኡት ደእሽን፥ እት ቆማታ አኮ ያደ፥ “ኔንካ ጋሊላ የሱሳና እትፐ ደኣ” ያጋዱ።<verse eid="MAT 26:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70"/>ሽን እ ኡንቱንቱ ኡባ ስንን ሄ ቆማቶ፥ “ኔን ግያዌ አየንቶ ታን ኤርከ” ያጊደ ካዴዳ።<verse eid="MAT 26:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71"/>ቃይ ቢደ ድርሳ ፐንግያኮ ከስሽን፥ ሀራ ቆማታ አ በኣደ፥ ሄዋን ደእያ አሳቶ፥ “ሀ ብታኒ ናዝሬትያ የሱሳና ደኤ” ያጋዱ።<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>ጰጽሮስ ላኤንዋ ጫቂደ፥ “ታን ሄዋ ብታንያ ኤርከ” ያጌዳ።<verse eid="MAT 26:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73"/>ላፋ ጋምእሽን፥ ሄዋን ኤቄዳ አሳይ ጰጽሮሳኮ ዪደ፥ “ኔንካ ቱማ ኡንቱንቱና እትፐ ደኣ፤ አያዉ ጎፐ፥ ኔን ሃሳይያ ሃሳያይካ ኔና ኤርሴ” ያጌድኖ።<verse eid="MAT 26:73"/></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74"/>ሄዋፐ ጉይያን ጰጽሮስ፥ “ታን ሄዋ ብታንያ ኤርከ!” ያጊደ፥ ባረና ሸቃነ ጫቁዋ ዶሜዳ።</para>
  <para style="p" vid="MAT 26:74">ሄ ዎደ ኤለካ ኩቱ ዋስ አጌዳ። <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/>ጰጽሮስ ባረና የሱስ፥ “ኔን ኩቱ ዋሳናፐ ካሰ ሄዙ ካላ ታና ካዳናሳ” ጌዳዋ ሀሳዪደ፥ ካረ ከሲደ፥ ሴለት ዬኬዳ።<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s1">የሱስ ጵላጾሳ ስን ፕርዳዉ ሺቄዳ</para>
  <para style="r">(<ref loc="MRK 15:1">ማር. 15:1</ref>፤ <ref loc="LUK 23:1-3">ሉቃሳ 23:1-3</ref>፤ <ref loc="JHN 18:28-32">ዮሃ. 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>ዎንታ ጉራን ቄሳቱዋ ካፓቱ ኡባቱነ ጋድያ ጭማቱ የሱሳ ዎናዉ ማቀቴድኖ፤ <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>ኡንቱንቱ የሱሳ ቃች አፊደ፥ ጋድያ አይስያ ጵላጾሳዉ አ እሜድኖ።<verse eid="MAT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>የሱሳ ሄ ዎደ ኦይዳ ይሁዳይ ጵላጾስ የሱሳ ቦላ ፕርዴዳዋ በኢደ፥ “አዬሮ! ኦይናን አጋርክታ!” ያጊደ፥ ሄ ማንእያን ሀታሙ ብራ ቄሳቱዋ ካፓቶነ ጋድያ ጭማቶ ጉየ ዛሪደ፥ <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>“ታን ጌሻ አሳ ኦይደ ናጋራ ኦድ” ያጌዳ።</para>
  <para style="p" vid="MAT 27:4">ሽን ኡንቱንቱ አ፥ “ሄዌ ኑዉ አያ መቴ? ሄዌ ነ ሸነ” ያጌድኖ።<verse eid="MAT 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5"/>ይሁዳይ ብራ ጌሻ ጎልያን ኦል አጌዳ፤ ኡንቱንቱ ማታፐ ቢደ፥ ሱለት ሀይቄዳ።<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>ቄሳቱዋ ካፓቱ ብራ አኪደ፥ “ሀ ብራይ ሱ ሚሻ ግድሽን፥ ኑን ጌሻ ጎልያ ሚሻና ጋያዌ ዎጋ ግደና” ያጌድኖ። <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>ሄዋፐ ጉየ እትፐ ዞረቲደ፥ እማ አሳዉ ሞጎ ጋድያ ኦናዉ ኡርቃፐ ሚሻ መያዋንቱ ጋድያ ሻሜድኖ። <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>ሄዋ ድራዉ፥ ሄ ጋዲ ሀቼ ጋካናዉካ፥ ሱ ጋድያ ጌተቲደ ጼሰቴ።<verse eid="MAT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9"/>ናብያ ኤርማስ፥ “ኡንቱንቱ አዉ እማናዉ ቆፔዳ ሀታሙ ሹቻ ብራ አኪደ፥ <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>ጎዳይ ታና አዛዞዋዳን፥ ኡርቃፐ ሚሻ መያዋንቱ ጋድያ ሻማናዉ እሜድኖ” ጌተቶዌ ሄ ዎደ ፖለቴዳ ጌዳ።<note caller="-" style="x"><char style="xo" closed="false">27:10 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">ዛካ. 11:12-13</ref></char></note><verse eid="MAT 27:10"/></para>
  <para style="s1">ጵላጾስ የሱሳ ኡባባ ኦቼዳ</para>
  <para style="r">(<ref loc="MRK 15:2-5">ማር. 15:2-5</ref>፤ <ref loc="LUK 23:3-5">ሉቃሳ 23:3-5</ref>፤ <ref loc="JHN 18:33-38">ዮሃ. 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>የሱስ ጋድያ አይስያዋ ስን ሺቅና፥ ጋድያ አይስያዌ አ፥ “ኔን አይሁዳቱዋ ካቴ?” ያጊደ ኦቼዳ።</para>
  <para style="p" vid="MAT 27:11">የሱስ አ፥ “ኔንካ ጋደኣ” ያጌዳ።<verse eid="MAT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12"/>ቄሳቱዋ ካፓቱነ ጋድያ ጭማቱ አ ሞትና፥ ኡንቱንቶ አይነ ዛሩዋ እምቤና። <verse eid="MAT 27:12"/><verse number="13" style="v" sid="MAT 27:13"/>ሄ ዎደ፥ ጵላጾስ የሱሳ፥ “ሀዋንቱ ኔና ሞትያባ ኡባ ስስኪ?” ያጌዳ።<verse eid="MAT 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14"/>የሱስ ሀራይ አቶ፥ እት ቃላካ ዛረናን እጽና፥ ጋድያ አይስያዋንቱ ዳሪ ማላለቴዳ።<verse eid="MAT 27:14"/></para>
  <para style="s1">የሱስ ሀይቆ ፕርደቴዳ</para>
  <para style="r">(<ref loc="MRK 15:6-15">ማር. 15:6-15</ref>፤ <ref loc="LUK 23:13-25">ሉቃሳ 23:13-25</ref>፤ <ref loc="JHN 18:39-40">ዮሃ. 18:39-40</ref>፤ <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>ጋድያ አይስያዌ ፓስጋ ቦንችያ ጋላሳን፥ አሳይ ኮይያ እት ኡራ ቃሹዋፐ ብልያ ዎጋይ ደኤ። <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>ሄ ዎደ እት ባርባና ጌተትያ የሱስ ዳሮ ኤረቴዳ ኢታ ብታኒ ቃሾ ጎለን ደኤ። <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>ሄዋ ድራዉ፥ ጮራ አሳይ እትሳ ሺቄዳሳን ጵላጾስ፥ “ታን ህንተንቶ ባርባና ግያ የሱሳ ብሎ፥ ዎይ ክርስቶሳ ጌተትያ የሱሳ ብሎ?” ያጊደ አሳ ኦቼዳ። <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>አያዉ ጎፐ፥ ኡንቱንቱ ቃናቲደ የሱሳ ኦዳዋ እ ኤሬ።<verse eid="MAT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19"/>ጵላጾስ ፕርዳ ጎለን ኡት ደእሽን፥ አ ማቻታ አዉ፥ “ሄ ጽሎ ብታንያ አይነ ኦፓ፤ አያዉ ጎፐ፥ ታን ሀቼ ቃማ አኩሙዋን አባን ዳሮ መቶታድ” ያጋደ ኪታዱ።<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>ሽን ቄሳቱዋ ካፓቱነ ጋድያ ጭማቱ ጵላጾስ ባርባና ብሊደ፥ የሱሳ ዎናዳን፥ ሺቄዳ አሳይ አ ዎሳና ማላ፥ አሳ ጭሜድኖ።<verse eid="MAT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21"/>ጵላጾስ ዛሪደ ኡንቱንታ፥ “ታን ኡንቱንቱ ላአቱዋፐ ህንተዉ ኦና ብላናዳን ኮዪቴ?” ያግና ኡንቱንቱ፥ “ባርባና ብላናዳን ኮዬቶ” ያጌድኖ።<verse eid="MAT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22"/>ጵላጾስ፥ “ያትና፥ ክርስቶሳ ጌተትያ የሱሳ ዎቶ?” ያጊደ ኡንቱንታ ኦችና ኡባይ፥ “ማስቃልያ ቦላ ምስማርያን ሸቲደ ካቀቶ” ያጌድኖ።<verse eid="MAT 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23"/>ጵላጾስ አሳ፥ “አያዉ? አይ ኢታባ ኦዴ?” ያጌዳ።</para>
  <para style="p" vid="MAT 27:23">ሽን አሳይ ካሰዋፐካ ባረንቱ ኮሻ ቁ ኦደ፥ “ማስቃልያ ቦላ ምስማርያን ሸቲደ እ ካቀቶ” ያጌድኖ።<verse eid="MAT 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>ዋላሳይ ደንዳናዋፐ አትን፥ አይነ ሀነናዋ ጵላጾስ በኢደ፥ ሃ አኪደ፥ “ሀ ብታኒ ሀይቂያዋን ታን ገልከ፤ ሄዋ ህንተንቱ ኤርተ” ያጊደ ሺቄዳ አሳ ስንን ባረ ኩሽያ ሜጨቴዳ።<note caller="-" style="x"><char style="xo" closed="false">27:24 </char><char style="xt" closed="false"><ref loc="DEU 21:6-9">ዛረ. 21:6-9</ref></char></note><verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>ሺቄዳ አሳይ ኡባይ ዛሪደ፥ “አ ሱ ጎሚ ኑናነ ኑ ናና ጋኮ” ያጌዳ።<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>ሄዋፐ ጉይያን፥ ጵላጾስ ባርባና ኡንቱንቶ ብሌዳ፤ ልሱዋን የሱሳ ሾጪደ፥ ማስቃልያ ቦላ ምስማርያን ሺደ ካቃናዉ ኡንቱንቶ አደ እሜዳ።<verse eid="MAT 27:26"/></para>
  <para style="s1">ዎታዳራቱ የሱሳ ቦላ ቅሊጬድኖ</para>
  <para style="r">(<ref loc="MRK 15:16-20">ማር. 15:16-20</ref>፤ <ref loc="JHN 19:2-3">ዮሃ. 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>ሄዋፐ ጉይያን፥ ጵላጾሳ ዎታዳራቱ የሱሳ ጋድያ አይስያዋ ቤሩዋ አፍና፥ ዎታዳራቱ ኡባይ አ ምይያን ዩይ አደ ኤቄድኖ። <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>አ ማዩዋ ቃር አኪደ፥ ዞኦ ማዩዋ አ ማይዜድኖ። <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>ቃይ አጉን ካላቻ ጊግሲደ፥ አ ሁጲያን ዎድኖ፤ አ ኡሸቻ ኩሽያን ማቃ ጻምኣ ኦይደ፥ አ ስንን ጉልባቲደ፥ “አይሁዳቱዋ ካተዉ፥ ሳሮ ደአይ!” ያጊደ፥ አ ቦላ ቅሊጬድኖ። <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>አ ቦላ ጩቼድኖ፤ ሄ ማቃ ጻምኣ አኪደ፥ አ ሁጲያ ሾጬድኖ። <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>ኡንቱንቱ አ ቦላ ቅሊጬዳዋፐ ጉይያን፥ ዞኦ ማዩዋ አፐ ቃር አኪደ፥ አ ማዩዋ አ ማይዜድኖ፤ ቃይ ማስቃልያ ቦላ ምስማርያን ሺደ አ ካቃናዉ አፌድኖ።<verse eid="MAT 27:31"/></para>
  <para style="s1">የሱስ ካቀቴዳ</para>
  <para style="r">(<ref loc="MRK 15:21-32">ማር. 15:21-32</ref>፤ <ref loc="LUK 23:25-43">ሉቃሳ 23:25-43</ref>፤ <ref loc="JHN 19:17-27">ዮሃ. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>ኡንቱንቱ ካረ ከሲደ፥ እት ስሞና ጌተትያ ቀሬና ጋደ አሳ ደሚደ፥ የሱሳ ማስቃልያ ዎልቃን ቶሴድኖ። <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>ጎልጎታ ጌተትያሳ ጋኬድኖ። “ጎልጎታ” ያገትያዌ “ሁጲያሳ” ግያዋ። <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>ሄዋን ኡንቱንቱ ጫሜዳ ዎይንያ ኤሳ የሱሳዉ ኡሻናዉ እሜድኖ፤ እ ሄዋ ጋንጽ ጼሊደ፥ ኡሸናን እጼዳ።<note caller="-" style="x"><char style="xo" closed="false">27:34 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዝ. 69:21</ref></char></note><verse eid="MAT 27:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35"/>ኡንቱንቱ ማስቃልያ ቦላ ምስማርያን ሺደ አ ካቆዋፐ ጉይያን፥ አ ማዩዋ ሻኪደ፥ ሳማ የጊደ አኬድኖ።<note caller="-" style="x"><char style="xo" closed="false">27:35 </char><char style="xt" closed="false"><ref loc="PSA 22:18">ማዝ. 22:18</ref></char></note> <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>ሄዋፐ ጉይያን፥ አ ናጋናዉ ሄዋን ኡት አጌድኖ። <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>ቃይ፥ “ሀዌ አይሁዳቱ ካትያ የሱሳ” ያጊደ ሞቱ ጻፈቶዋ አ ሁጰ ባጋና ዎድኖ። <verse eid="MAT 27:37"/><verse number="38" style="v" sid="MAT 27:38"/>የሱሳና ሄ ዎደ ላኡ ካይሳቱዋ እቱዋ አፐ ኡሸቻ ባጋና፥ ቃይ እቱዋ አፐ ሀድርሳ ባጋና፥ ማስቃልያ ቦላ ምስማርያን ሺደ ካቄድኖ።<verse eid="MAT 27:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39"/>ኦግያና አያ አሳይ የሱሳ ካደ፥ ባረንቱ ሁጲያ ቃደ ቦሬድኖ።<note caller="-" style="x"><char style="xo" closed="false">27:39 </char><char style="xt" closed="false"><ref loc="PSA 22:7">ማዝ. 22:7</ref>፤ <ref loc="PSA 109:25">109:25</ref></char></note> <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>“ጌሻ ጎልያ ኮላደ ሄዙ ጋላሳ ግዶን ኬጽያዎ፥ ነ ሁጲያ አሻ፤ ኔን ጾሳ ናኣ ግዶፐ፥ አነ ማስቃልያ ቦላፐ ዎ” ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="MAT 26:61">ማቶሳ 26:61</ref>፤ <ref loc="JHN 2:19">ዮሃ. 2:19</ref></char></note><verse eid="MAT 27:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41"/>ሄዋዳንካ፥ ቄሳቱዋ ካፓቱ ህግያ ታማርስያዋንቱናነ ጭማቱዋና እትፐ የሱሳ ቦላ ቅሊጪደ፥ ሀዋዳን ያጌድኖ፤ <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>“ሀራንታ አሼዳ፤ ሽን ባረና አሻናዉ ዳንዳየና። እ እስራኤልያ ካትያ፤ አነ ማስቃልያ ቦላፐ ሀእ ዎ፤ ኑንካ ቃይ አን አማናና። <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>ጾሳን እ አማነቴ፤ ጾሳይ አ አሻናዉ ኮዮፐ አነ አሾ፤ አያዉ ጎፐ፥ እ ባረና፥ ‘ታን ጾሳ ናኣ’ ጌ” ያጌድኖ።<note caller="-" style="x"><char style="xo" closed="false">27:43 </char><char style="xt" closed="false"><ref loc="DEU 22:8">ዛረ. 22:8</ref></char></note><verse eid="MAT 27:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44"/>ቃይ ሀራይ አቶ፥ አናና ማስቃልያ ቦላ ምስማርያን ሸቲደ ካቀቴዳ ካይሳቱካ ሄዋዳን ጊደ፥ አ ቦላ ቅሊጬድኖ።<verse eid="MAT 27:44"/></para>
  <para style="s1">የሱስ ሀይቄዳ</para>
  <para style="r">(<ref loc="MRK 15:33-41">ማር. 15:33-41</ref>፤ <ref loc="LUK 23:44-49">ሉቃሳ 23:44-49</ref>፤ <ref loc="JHN 19:28-30">ዮሃ. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>ኡሱፑን ሳትያፐ ዶሚደ፥ ኡዱፑ ሳትያ ጋካናዉ፥ ቢታይ ኡባይ ሜዳ። <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>ኡዱፑ ሳተ ግድያ ሄራን የሱስ ባረ ቃላ ቁ ኦደ፥ “ኤሎሄ፥ ኤሎሄ፥ ላማ ሳባቅታኒ?” ያጌዳ። ሄዋ ጉሳይ፥ “ታ ጾሳዉ፥ ታ ጾሳዉ፥ ታና አያዉ ጮኡ ጋድ?” ጉሳ።<note caller="-" style="x"><char style="xo" closed="false">27:46 </char><char style="xt" closed="false"><ref loc="PSA 22:1">ማዝ. 22:1</ref></char></note><verse eid="MAT 27:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47"/>ሄዋን ኤቄዳ አሳፐ እቱ ሄዋ ስሲደ፥ “ሀ ብታኒ ኤላሳ ጼሴ” ያጌዳ። <verse eid="MAT 27:47"/><verse number="48" style="v" sid="MAT 27:48"/>ሄ ማንእያን ኡንቱንቱፐ እቱ ዎጺደ፥ እስፖንጅያ አኪደ፥ ጫላ ዎይንያ ኤሳ ግዶ የጊደ፥ ሄዋ ማቃ ጻምኣ ጼራን ዎደ፥ ኡሻናዉ አ ዶናኮ ሺሼዳ።<note caller="-" style="x"><char style="xo" closed="false">27:48 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዝ. 69:21</ref></char></note> <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>ሽን የኮንቱ፥ “አነ ደአሻ፥ ኤላስ አ አሻናዉ ያናዌንቶ በአና” ያጌድኖ። <verse eid="MAT 27:49"/><verse number="50" style="v" sid="MAT 27:50"/>የሱስ ላኤንዋ ባረ ቃላ ቁ ኦ ዋሲደ፥ ሀይቂ አጌዳ።<verse eid="MAT 27:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51"/>አኬክተ፤ ጌሻ ጎልያን ካቀቴዳ ጋርዱ ቆሞፐ ዱገ ጋካናዉ፥ ላኡ ከሲደ፥ ፖሸት ዎዳ፤ ሳአይ ቃጼዳ። ቃይ ዛላይካ ጳልቀቴዳ፤<note caller="-" style="x"><char style="xo" closed="false">27:51 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">ከሳ 26:31-33</ref></char></note> <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>ጮራ ዱፉ ዶየቴዳ። ጾሳ አሳፐ ጮራቱ ሀይቄዳዋንቱ፥ ሀይቁዋፐ ደንዴድኖ። <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>ኡንቱንቱ ዱፉዋፐ ከሲደ፥ የሱስ ሀይቁዋፐ ደንዶዋፐ ጉይያን፥ ጌሻ ካታማ ቤድኖ፤ ሄዋን ኡንቱንታ ጮራ አሳይ በኤዳ።<verse eid="MAT 27:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54"/>ጼቱዋ ካፑነ አናና የሱሳ ናግያ ዎታዳራቱ ሳአይ ቃጽያዋነ ሄዋን ሀኔዳዋ ኡባ በኤዳ ዎደ ዳሮ ያዬድኖ፤ ያሻ ጋሱዋን፥ “ቱሙ ሀዌ ጾሳ ናኣ” ያጌድኖ።<verse eid="MAT 27:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55"/>ሄዋን ጮራ ማጫዋንቱ፥ ጋሊላፐ ዶሚደ፥ የሱሳ ማዲደ ካልያዋንቱ፥ ሃኩዋን ኤቂደ ጼሊኖ። <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>ኡንቱንቱ ግዶን ማግዳላ ጌተትያ ካታማፐ ዬዳ ማይራማ፥ ያቆባነ ዮሴፎ ዳያ ማይራማነ ዛብድዮሳ ናና ዳያ ደኢኖ።<verse eid="MAT 27:56"/></para>
  <para style="s1">የሱስ ሞገቴዳ</para>
  <para style="r">(<ref loc="MRK 15:42-47">ማር. 15:42-47</ref>፤ <ref loc="LUK 23:50-56">ሉቃሳ 23:50-56</ref>፤ <ref loc="JHN 19:38-42">ዮሃ. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>ሳአይ ኦማርስያ ዎደ፥ ዮሴፎ ጌተትያ እት ዱረ ብታኒ፥ አርማትያሳ ካታማ ብታኒ ዬዳ፤ እ ባረ ሁጰዉካ የሱሳ ካልያዋ። <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>ዮሴፎ ጵላጾሳኮ ቢደ፥ የሱሳ አሃ አካናዉ ዎሴዳ፤ ጵላጾስ ዮሴፎ እመታና ማላ አዛዜዳ። <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>የሱሳ አሃ አኪደ፥ ጌሻ ሞጉዋ ማዩዋን <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>ጻጺደ ባረዉ ሞገታናዉ ሹቻ ዎጬዳ ኦራ ጎንጎሉዋ ግዶን አ አሃ ዎዳ፤ ቃይ ሄ ጎንጎሉዋ ዶናን ዎጋ ሹቻ ጎንዶርስ ዎደ፥ ባሽ ቤዳ። <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>ማግዳላ ካታማፐ ዬዳ ማይራማነ የኮ ማይራማ ሄዋን ጎንጎሉዋኮ ስሚደ ኡቴድኖ።<verse eid="MAT 27:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>ሳምባታዉ ጊገትያ ጋላሳፐ ዎንተ ጋላስ፥ ቄሳቱዋ ካፓቱነ ፓርሳዋቱ ጵላጾሳና ጋከቲደ፥ ሀዋዳን ያጌድኖ፤ <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>“ጎዳዉ፥ ሄ ዎርዱ ፓጻ ደእያ ዎደ፥ ‘ታን ሄዙ ጋላሳፐ ጉይያን፥ ሀይቁዋፐ ደንዳና’ ያጎዋ ኑን ሀሳዬዶ።<note caller="-" style="x"><char style="xo" closed="false">27:63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">ማቶሳ 16:21</ref>፤ <ref loc="MAT 17:23">17:23</ref>፤ <ref loc="MAT 20:19">20:19</ref>፤ <ref loc="MRK 8:31">ማር. 8:31</ref>፤ <ref loc="MRK 9:31">9:31</ref>፤ <ref loc="MRK 10:33-34">10:33-34</ref>፤ <ref loc="LUK 9:22">ሉቃሳ 9:22</ref>፤ <ref loc="LUK 18:31-33">18:31-33</ref></char></note> <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>ሄዋ ድራዉ፥ አ ሞጌዳ ጎንጎሉዋ ሄዙ ጋላሳ ጋካናዉ፥ ሎይ ናጋና ማላ አዛዛርኪ፤ ሄዌ ዮፐ አ ካልያዋንቱ ቢደ፥ አ አሃ ዉኢደ አሳዉ፥ ‘ሀይቁዋፐ ደንዴዳ’ ያጋናዋንታ፤ ላኤንያ ባላይ ካሰ ባላፐ ኡባ ያ ኢታና” ያጌድኖ።<verse eid="MAT 27:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65"/>ጵላጾስ ኡንቱንታ፥ “ህንተንቶ ናግያዋንቱ ደኢኖ፤ ቢደ ህንተንቶ ዳንዳየትያ ኬና ናግሽተ” ያጌዳ።<verse eid="MAT 27:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66"/>ሄዋፐ ጉየ ኡንቱንቱ ቢደ፥ ሹቻ ቦላ ማታፋ አታሚደ፥ ቃይ ናግያዋ ያን ዎደ፥ የሱሳ ሞጌዳ ጎንጎሉዋ ናግሴድኖ።<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s1">የሱስ ሀይቁዋፐ ደንዴዳ</para>
  <para style="r">(<ref loc="MRK 16:1-10">ማር. 16:1-10</ref>፤ <ref loc="LUK 24:1-12">ሉቃሳ 24:1-12</ref>፤ <ref loc="JHN 20:1-10">ዮሃ. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>ሳምባታይ አና ዎጋ ጋላስ ዎንታ ባካልያን፥ ማግዳላ ጌተትያ ካታማፐ ዬዳ ማይራማነ የኮ ማይራማ የሱስ ሞገቴዳ ጎንጎሉዋ በአናዉ ቤድኖ። <verse eid="MAT 28:1"/><verse number="2" style="v" sid="MAT 28:2"/>ጎዳ ኪታንቻይ ሳሉዋፐ ዎዳ ድራዉ፥ ሳአይ ዳሮ ቃጼዳ፤ ሄ ኪታንቻይ ዪደ፥ ሹቻ ጎንዶርስ ኦሊደ፥ አ ቦላ ከስ ኡቴዳ። <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>አ ማላይ ዋልቃን ማላቴ፤ አ ማዩካ ሻቻዳን ቦ። <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>ናግያዋንቱ ኪታንቻዉ ያሻ ኮኮሪደ፥ ሀይቄዳ አሳዳን ሀኔድኖ።<verse eid="MAT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5"/>ኪታንቻይ ማጫዋንታ ሀዋዳን ያጌዳ፤ “ያዮፕተ፤ አያዉ ጎፐ፥ ማስቃልያ ቦላ ምስማርያን ሺደ ካቄዳ የሱሳ ህንተንቱ ኮይያዋ ታን ኤራይ። <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>እ ሀዋን ባዋ፤ አያዉ ጎፐ፥ እ ባረ ጌዳዋዳንካ ሀይቁዋፐ ደንድ ድጌዳ፤ ሃ ዪደ፥ እ ሞገት ግሶሳ በእተ። <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>ህንተንቱ ሀእ ኤለካ ቢደ፥ የሱሳ ካልያዋንቶ፥ ‘የሱስ ሀይቁዋፐ ደንድ ድጌዳ። ቃይ እ ህንተፐ ካሰቲደ፥ ጋሊላ ቤ፤ ህንተንቱ አ ያን በአና’ ያጊደ ኦድተ። በእተ፥ ታን ህንተንቶ ኦዳድ” ያጌዳ።<verse eid="MAT 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8"/>ኡንቱንቱ ያዪድነ ቃይ ዳሮ ናሸቲደ፥ የሱስ ሞገቴዳ ጎንጎሉዋ ማታፐ ኤለካ ክቺደ፥ የሱሳ ካልያዋንቶ ኦዳናዉ ዎጼድኖ።<verse eid="MAT 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9"/>ሄ ማንእያን የሱስ ኡንቱንቱና ጋከቲደ ኡንቱንታ፥ “ሳሮ ደኢቴ” ያግ አጌዳ፤ ኡንቱንቱ አኮ ሺቅ አ ገድያ ኦይቂደ፥ አዉ ጎይኔድኖ። <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>የሱስ ሄ ዎደ ኡንቱንታ፥ “ያዮፕተ፤ ታ እሻቱ ጋሊላ ባና ማላ፥ ቢደ ኡንቱንቶ ኦድተ፤ ኡንቱንቱ ታና ያን በአናዋንታ” ያጌዳ።<verse eid="MAT 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>ሄ ማጫዋንቱ ብያ ዎደ፥ ጎንጎሉዋ ናግያ ዎታዳራቱዋፐ አማሬዳዋንቱ ካታማ ቢደ፥ ሀኔዳዋ ኡባ ቄሳቱዋ ካፓቶ ኦዴድኖ። <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>ቄሳቱዋ ካፓቱ ጭማቱዋና እትፐ ሺቅ ዞረቲደ፥ ዎታዳራቶ ዳሮ ሚሻ እሚደ፥ <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>“ ‘ኑን ገምእሹዋን ደእሽን አ ካልያዋንቱ ቃማ ዪደ፥ አ አሃ ዉኤድኖ’ ያግተ። <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>ሀ የዉዋ ጋድያ አይስያዌ ስሶፐ፥ ኑን አዉ ኦድ አማንና፤ ቃይ ህንተንታ አይነ ህርግሰናዳን ኦና” ያጌድኖ።<verse eid="MAT 28:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15"/>ዎታዳራቱ ሚሻ አኪደ፥ ባረንቶ ኦዴዳዋዳን ኦድኖ። ሀ የዉ አይሁዳቱዋ ማታን ሀቼ ጋካናዉ፥ ኦደቲደ ደኤ።<verse eid="MAT 28:15"/></para>
  <para style="s1">የሱስ ባረና ካልያዋንቶ ቤቴዳ</para>
  <para style="r">(<ref loc="MRK 16:14-18">ማር. 16:14-18</ref>፤ <ref loc="LUK 24:36-49">ሉቃሳ 24:36-49</ref>፤ <ref loc="JHN 20:19-23">ዮሃ. 20:19-23</ref>፤ <ref loc="ACT 1:6-8">ኪታ 1:6-8</ref>፤ <ref loc="1CO 15:3-8">1 ቆሮ. 15:3-8</ref>)</para>
  <para style="p">
    <verse number="16-17" style="v" sid="MAT 28:16-17"/>ሽን ታማነ እት አ ካልያዋንቱ የሱስ ባረንታ ቢተ ጌዳ ጋሊላ ጋድያ ቢደ አ በኤዳ ዎደ፥ አዉ ጎይኔድኖ፤ ሽን ኡንቱንቱፐ እቱ እቱ ስድኖ።<note caller="-" style="x"><char style="xo" closed="false">28:16-17 </char><char style="xt" closed="false"><ref loc="MAT 26:32">ማቶሳ 26:32</ref>፤ <ref loc="MRK 14:28">ማር. 14:28</ref></char></note><verse eid="MAT 28:16-17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18"/>የሱስ ኡንቱንቱኮ ሺቂደ፥ ኡንቱንታ ሀዋዳን ያጌዳ፤ “ማታይ ኡባይ ሳሉዋንነ ሳኣን ታዉ እመቴዳ። <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>ሄዋ ድራዉ፥ ህንተንቱ ቢደ፥ አሳ ኡባ ታና ካልያዋንታ ኦተ፤ አዉዋ ሱንን፥ ናኣ ሱንንነ ጌሻ አያና ሱንን ኡንቱንታ ጻማቅተ።<note caller="-" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 1:8">ኪታ 1:8</ref></char></note> <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>ታን ህንተንታ አዛዜዳባ ኡባ ኡንቱንቱ ናጋና ማላ፥ ኡንቱንታ ታማርስተ፤ ታን ዎድያ ዉርሰይ ጋካናዉካ ኡባ ዎደ ህንተንቱና ደእያዋ አኬክተ” ያጌዳ።<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
