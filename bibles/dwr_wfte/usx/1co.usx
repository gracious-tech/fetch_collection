<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Dawuro Full Bible Ethiopic Version</book>
  <para style="h">1 ቆሮንቶሳ</para>
  <para style="toc1">ጳዉሎስ ቆሮንቶሳ አሳዉ ጻፌዳ ኮይሮ ኪታ</para>
  <para style="toc2">1 ቆሮንቶሳ</para>
  <para style="toc3">1 ቆሮ.</para>
  <para style="mt2">ጳዉሎስ</para>
  <para style="mt1">ቆሮንቶሳ አሳዉ</para>
  <para style="mt2">ጻፌዳ ኮይሮ ኪታ</para>
  <para style="imt">ገሉዋ</para>
  <para style="ip">ጳዉሎስ ቆሮንቶሳ አሳዉ ጻፌዳ ኮይሮ ኪታይ፥ ጳዉሎስ ቆሮንቶሳ ካታማን ደእያ አማንያዋንቱ ግዶን ክርስትና ደኡዋነ አማኑዋ ጼልያባን ደንዴዳ መቱዋ ይሳናዉ ቆፒደ ጻፌዳዋ። ሄ ዎደ ቆሮንቶሳ ካታማይ ሄ ጋደን ደእያ አሳይ ጎኤትያ ኤረቴዳ ግሪከ ካታማ። ሄዋ ቦላካ ቃይ አካይያ ጌተትያ ሮማ ካዉተዉ ሁጰ ካታማ። ሀ ካታማይ ዎልቃማ ዛልእያን፥ ጋምኢደ ምኔዳ ዎጋን፥ ሎይ አክ አክ ብያ የዳ ደኡዋን ዎይ ጊገናባ ሀንያዋንነ ሀይማኖትያ ጮራተን ኤረቴዳዋ።</para>
  <para style="ip">የሱስ ኪቴዳዌ ምንሲደ ኦዳናዉ ኮዬዳዌ፥ ሄ አማንያዋንቱ ግዶን ደእያ ሻኮተባነ የዳ ደኡዋባ፥ ዎሹማባነ ገሉዋ አካባ፥ ዎሳ ጎለ ዎጋባ፥ ጌሻ አያና እሞታቱዋባነ ሀይቁዋ ደንዱዋባ። የሱስ ኪቴዳዌ ሀ ምሽራቹዋ ቃላ ሀ ኦሻቱዋ ቦላ ምንሲደ ኦድያዋ ናጊደ ሺሼ።</para>
  <para style="ip">ሲቁ ጾሳይ ባረ አሳዉ እሜዳ እሞታ ኡባፐ አያዋ ግድያዋ ኦድያ ሸምፑዋ ታማነ ሄዙ፥ ሀ ማጻፋን ዳሮ ኤረቴዳዋ ጌተቲደ ቆፈቴ።</para>
  <para style="iot">ሸምፓቱዋ ኡባቶ እመቴዳ ቃን ቆፋቱዋ</para>
  <para style="io1">ገሉዋ <char style="ior"><ref loc="1CO 1:1-9">1:1-9</ref></char></para>
  <para style="io1">አማንያዋንቱ ግዶን ደንዴዳ ሻኮተ <char style="ior"><ref loc="1CO 1:10-4:21">1:10—4:21</ref></char></para>
  <para style="io1">የዳ ደኡዋባነ ሶይ አሳ ደኡዋባ <char style="ior"><ref loc="1CO 5:1-7:40">5:1—7:40</ref></char></para>
  <para style="io1">አማንያዋንታነ ክርስትና አማኑዋ አክቤናዋንታ <char style="ior"><ref loc="1CO 8:1-11:1">8:1—11:1</ref></char></para>
  <para style="io1">አማንያዋንቱ ደኡዋነ ጎሸታ ዎጋ <char style="ior"><ref loc="1CO 11:2-14:40">11:2—14:40</ref></char></para>
  <para style="io1">ክርስቶስ ሀይቁዋ ጾን ደንዶዋነ አማንያዋንቱ ደንዱዋባ <char style="ior"><ref loc="1CO 15:1-58">15:1-58</ref></char></para>
  <para style="io1">ይሁዳን ደእያ መቶታንቻቶ እመቴዳ ማዱዋባ <char style="ior"><ref loc="1CO 16:1-4">16:1-4</ref></char></para>
  <para style="io1">ዉርሰ ቁትያ <char style="ior"><ref loc="1CO 16:5-24">16:5-24</ref></char></para>
  <chapter number="1" style="c" sid="1CO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1"/>ታን፥ ጾሳ ሸንያን የሱስ ክርስቶስ ኪቴዳዋ ግዳናዉ ጼሰቴዳ ጳዉሎስነ፥ ኑ እሻ ሶስተኒስ፥ <verse eid="1CO 1:1"/><verse number="2" style="v" sid="1CO 1:2"/>ቆሮንቶሳን ደእያ ጾሳ አማንያ አሳቶ፥ የሱስ ክርስቶሳን ጌዬዳዋንቱስነ፥ ኑዉ ጎዳ ግድያ ኑ ጎዳ የሱስ ክርስቶሳ ሱን ኡባ ሳኣን ጼስያ ኡባቱዋና ጌሻ ግዳናዉ ጼሰቴዳዋንቶ ሀ ዳብዳቢያ ጻፌቶ።<verse eid="1CO 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3"/>ጾሳይ፥ ኑ አዉነ ኑ ጎዳይ የሱስ ክርስቶስ ህንተንቶ አ ኬካተነ ሳሮተ እሞ።<verse eid="1CO 1:3"/></para>
  <para style="s1">ጾሳ ጋላቱሳ</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4"/>ጾሳይ ክርስቶሳ የሱሳ ባጋና ህንተንቶ እሜዳ አ ኬካተ ድራዉ፥ ታን ኡባ ዎደ ህንተንቶ ጾሳ ጋላታይ። <verse eid="1CO 1:4"/><verse number="5-6" style="v" sid="1CO 1:5-6"/>ታን ክርስቶሳዉ ማርካትያዌ ህንተንቱን ምኔዳ ድራዉ፥ ህንተ ኡባባን፥ ሃሳያ ኡባን ኤራተ ኡባን፥ አን ዱረቴድታ። <verse eid="1CO 1:5-6"/><verse number="7" style="v" sid="1CO 1:7"/>ሀዋዳን ህንተ ኑ ጎዳ የሱስ ክርስቶሳ ዩሳ ናግሽን፥ አያና እሞታፐ ሀራይ አቶ እቱነ ህንተንቶ ፓጨና። <verse eid="1CO 1:7"/><verse number="8" style="v" sid="1CO 1:8"/>ቃይ ኑ ጎዳ የሱስ ክርስቶሳ ጋላሳን ህንተ ካ ባይናዋንታ ግዳናዳን፥ ዉርሰይ ጋካናዉ እ ህንተንታ ምንሳናዋ። <verse eid="1CO 1:8"/><verse number="9" style="v" sid="1CO 1:9"/>ባረ ናኣ ኑ ጎዳ የሱስ ክርስቶሳ እትፐተዉ ህንተንታ ጼሴዳ ጾሳይ አማነቴዳዋ።<verse eid="1CO 1:9"/></para>
  <para style="s1">አማንያ አሳ ግዶን ሻኮተይ መቶፖ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10"/>ሽን ታናዳን አማንያዋንቶ፥ እት ዎዛናንነ እት ቆፋን እትፐ ግዳናፐ አትን፥ ሻኮተይ ህንተ ግዶን ደኤና ማላ፥ ህንተ ኡባይ እት ሃሳያ ሃሳያናዳን፥ ኑ ጎዳ የሱስ ክርስቶሳ ሱንን ታን ህንተንታ ዎሳይ። <verse eid="1CO 1:10"/><verse number="11" style="v" sid="1CO 1:11"/>አያዉ ጎፐ፥ ታናዳን አማንያዋንቶ፥ ቃሎአ ሶይ አሳይ ህንተንቱባ፥ ህንተ ግዶን ዋላሳይ ደእያዋ፥ ታዉ ኦዴድኖ። <verse eid="1CO 1:11"/><verse number="12" style="v" sid="1CO 1:12"/>ታን ግያዌ ሀዋ፤ ህንተንቱ ሁጲያን ሁጲያን፥ “ታን ጳዉሎሳዋ። ታን አጲሎሳዋ። ታን ኬፋዋ።<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="fq" closed="false">ኬፋ፦ </char><char style="ft" closed="false">ሀዌ ግሪከ ሱን ግዲደ፥ ብለይ ዛላ ግያዋ። ሀራ ጌሻ ማጻፋቱዋን ኬፋ ሱንይ ጰጽሮሳ።</char></note> ታን ክርስቶሳዋ” ያጊታ። <verse eid="1CO 1:12"/><verse number="13" style="v" sid="1CO 1:13"/>ክርስቶስ ሻከቴዴ? ህንተንቱ ድራዉ፥ ማስቃልያ ቦላ ምስማርያን ሸቲደ ካቀቴዳዌ ጳዉሎስ? ዎይ ህንተ ጳዉሎሳዉ ግዳናዉ ጻማቀቴድቴ?<verse eid="1CO 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14"/>ታን ቃርስጶሳፐነ ጋዮሳፐ አትን፥ ህንተንቱፐ ኦናነ ጻማቃቤና ድራዉ፥ ጾሳ ጋላታይ። <verse eid="1CO 1:14"/><verse number="15" style="v" sid="1CO 1:15"/>ሄዋ ድራዉ፥ ኦንነ ህንተንታ ታዉ ግዳናዳን ጻማቀቴድታ ጋናዉ ዳንዳየና። <verse eid="1CO 1:15"/><verse number="16" style="v" sid="1CO 1:16"/>ቃይ፥ ኤ፥ እስጽፋኖሳ ሶይ አሳካ ታን ጻማቃድ። ሽን ሀራ ጉጃደ ጻማቃድታንቶነ ዎዛና አከ። <verse eid="1CO 1:16"/><verse number="17" style="v" sid="1CO 1:17"/>አያዉ ጎፐ፥ ክርስቶስ ታና ምሽራቹዋ ቃላ ኦዳና ማላ ኪቴዳፐ አትን፥ ጻማቃና ማላ ኪትቤና፤ ቃይ ክርስቶስ ማስቃልያ ቦላ ሀይቄዳዌ መላ ግደና ማላ፥ ታን አሳ አዳ ኤራተ ቃላን ታማርስከ።<verse eid="1CO 1:17"/></para>
  <para style="s1">ክርስቶስ ጾሳ አዳ ኤራነ ዎልቃ</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18"/>አያዉ ጎፐ፥ ክርስቶስ ማስቃልያ ቦላ ሀይቄዳዋ ኦድያ ቃላይ ይያዋንቶ ኤያተ። ሽን ኑዉ አትያዋንቶ ጾሳ ዎልቃ። <verse eid="1CO 1:18"/><verse number="19" style="v" sid="1CO 1:19"/>ጾሳ ማጻፋይ፥</para>
  <para style="q1" vid="1CO 1:19">“ታን ኤራንቻቱዋ አዳ ኤራተ፥</para>
  <para style="q2" vid="1CO 1:19">ባይዛና፤</para>
  <para style="q2" vid="1CO 1:19">ቃይ አኬካንቻቱዋ አኬካካ ይሳና”</para>
  <para style="m" vid="1CO 1:19">ያጌ።<note caller="-" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="ISA 29:14">ኢሳ. 29:14</ref></char></note> <verse eid="1CO 1:19"/><verse number="20" style="v" sid="1CO 1:20"/>አዳ ኤራንቻይ ሀቃን ደኢ? ህግያ ታማርስያዌ ሀቃን ደኢ? ዎይ ሀ አላምያ ጾናናዉ ፓሉመትያዋንቱ ዋናንድኖሻ? ጾሳይ ሀ ሳኣ አ ኤራተይ ኤያተ ግድያዋ በሴዳ!<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="JOB 12:17">ኢዮባ 12:17</ref>፤ <ref loc="ISA 19:12">ኢሳ. 19:12</ref>፤ <ref loc="ISA 33:18">33:18</ref>፤ <ref loc="ISA 44:25">44:25</ref></char></note><verse eid="1CO 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21"/>አያዉ ጎፐ፥ አሳይ ባረ ሁጰ አ ኤራተን ባረና ጾሳ ኤረና ማላ፥ ጾሳይ ባረ አ ኤራተን ድጊደ፥ ኑን ኦድያ ኤያ ቃላን አማንያዋንታ አሻናዉ ቆፔዳ። <verse eid="1CO 1:21"/><verse number="22" style="v" sid="1CO 1:22"/>አይሁዳቱ ማላታ ኦቺኖ። ቃይ ግሪከ አሳቱ አ ኤራተ ዎልቃማ ኮሻ ኮዪኖ። <verse eid="1CO 1:22"/><verse number="23" style="v" sid="1CO 1:23"/>ሽን ኑን ማስቃልያ ቦላ ምስማርያን ሸቲደ ካቀቴዳ ክርስቶሳባ ኦዴቶ። ሄዌ አይሁዳቶ ቦ፤ ቃይ አይሁዳ ግደናዋንቶ ኤያተ። <verse eid="1CO 1:23"/><verse number="24" style="v" sid="1CO 1:24"/>ሽን ጾሳይ ጼሴዳዋንቶ አይሁዳቶካ ግሪካቶካ ኑን ኦድያ ጾሳ ዎልቃይነ አ አ ኤራተይ ክርስቶሳ። <verse eid="1CO 1:24"/><verse number="25" style="v" sid="1CO 1:25"/>አያዉ ጎፐ፥ ጾሳ ኤያተይ አሳ አዳ ኤራተፐ አ፤ ቃይ አ ላፋተ ጌተትያዌካ አሳ ምኖተፐ ምኔ።<verse eid="1CO 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26"/>ስም ታናዳን አማንያዋንቶ፥ ጾሳይ ህንተንታ ጼስያ ዎደ ህንተ ዎይሳ ማላ አሰንቶ ቆፕተ። አሳ ቆፋን ህንተ ግዶን አ ኤራንቻቱ፥ ዎልቃማቱነ ቃ ሼሻቱ ዳራ ግድክኖ። <verse eid="1CO 1:26"/><verse number="27" style="v" sid="1CO 1:27"/>ሽን ጾሳይ አዳ ኤራንቻቱዋ ዬላያናዉ፥ አላምያን ደእያ ኤያቱዋ ዶሬዳ፤ ቃይ ምናቱዋ ዬላያናዉ፥ አላምያን ደእያ ላፋቱዋ ዶሬዳ። <verse eid="1CO 1:27"/><verse number="28" style="v" sid="1CO 1:28"/>ጾሳይ ሀ አላምያን ዎልቃማባ ጊደ ቆፕያዋ ይሳናዉ፥ ሀ አላምያ ማደናባ ካቶባነ ሀንቤናባ ዶሬዳ። <verse eid="1CO 1:28"/><verse number="29" style="v" sid="1CO 1:29"/>ሄዋ ድራዉ፥ ኦንነ ጾሳ ስንን ጬቀታናዉ በሰና። <verse eid="1CO 1:29"/><verse number="30" style="v" sid="1CO 1:30"/>ሽን ጾሳይ ህንተንቶ ክርስቶስ የሱሳ ደኡዋ ኦ እሜዳ። ክርስቶስ ኑዉ አ ኤራተ፥ ጽሎተ፥ ጌሻተነ አቶተ ግዴዳ። <verse eid="1CO 1:30"/><verse number="31" style="v" sid="1CO 1:31"/>ሄዋ ድራዉ፥ ጾሳ ማጻፋይ፥</para>
  <para style="q1" vid="1CO 1:31">“ጬቀትያ ኡራይ ኦንነ፥</para>
  <para style="q2" vid="1CO 1:31">ጎዳይ ኦዳዋን ጬቀቶ”</para>
  <para style="m" vid="1CO 1:31">ያጌ።<note caller="-" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="JER 9:24">ኤር. 9:24</ref></char></note><verse eid="1CO 1:31"/></para>
  <chapter eid="1CO 1"/>
  <chapter number="2" style="c" sid="1CO 2"/>
  <para style="s1">ኑን ክርስቶሳ ካቃባ ማርካቴቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1"/>ታናዳን አማንያዋንቶ፥ ታን ጾሳ ቱማተ ጹራ<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">ጾሳ ቱማተ ጹራ፦ </char><char style="ft" closed="false">እት እት ጌሻ ማጻፋ ብለቱ፥ ጾሳባ ማርካተ፥ ያጊኖ።</char></note> ህንተንቶ ኦዳናዉ ህንተንቱኮ ዬዳ ዎደ፥ ቃ ቃላንነ አዳ ኤራተን ኦዳናዉ ያበይከ። <verse eid="1CO 2:1"/><verse number="2" style="v" sid="1CO 2:2"/>አያዉ ጎፐ፥ ታን ህንተንቱና ደኣደ፥ የሱስ ክርስቶሳፐነ ቃይ ማስቃልያ ቦላ ምስማርያን ሸቲደ እ ካቀቴዳዋፐ አትን፥ ሀራባ ኤረናዳን፥ ታ ቆፋ ቃቻድ። <verse eid="1CO 2:2"/><verse number="3" style="v" sid="1CO 2:3"/>ታን ዳቡራንነ ያሻን ዳሮ ኮኮርሳን ህንተንቱና ደኣድ። <verse eid="1CO 2:3"/><verse number="4" style="v" sid="1CO 2:4"/>ታን ታማርስያዋነ ኦድያዋ ጾሳ አያናንነ ዎልቃን ቆንጭሳይፐ አትን፥ ጪማ ግዲደ አዳ ኤራተ ቃላና ግደና። <verse eid="1CO 2:4"/><verse number="5" style="v" sid="1CO 2:5"/>ሄዋ ድራዉ፥ ህንተ አማኑ ጾሳ ዎልቃናፐ አትን፥ አሳ አ ኤራተን ዘምፕቤና።<verse eid="1CO 2:5"/></para>
  <para style="s1">ጾሳ አዳ ኤራ</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6"/>ኑን አያናን ዎዛናማቱዋ ግዶን አ ኤራተ ሃሳዬቶ። ሽን ሄዌካ ሀ አላምያ አ ኤራተ ግደና፤ ዎይ ሀ አላምያ ሞድያ ይያዋንቱ አ ኤራተ ግደና። <verse eid="1CO 2:6"/><verse number="7" style="v" sid="1CO 2:7"/>ሽን ኑን ኦድያ አ ኤራተይ፥ ጾሳይ ካሰቲደ፥ ጮራ ዎድያፐ ካሰ ኑ ቦንቾ ዶሬዳ አሳፐ ጌሜዳ አ ጹራ አ ኤራተ። <verse eid="1CO 2:7"/><verse number="8" style="v" sid="1CO 2:8"/>ሀ አላምያ ሞድያዋንቱፐ ኦንነ ሀ አ ኤራተ ኤርቤና። ኡንቱንቱ ኤሬዳዋ ግድንቶ፥ ቦንቾ ጎዳ ማስቃልያ ቦላ ምስማርያን ሺደ ካቂክኖ። <verse eid="1CO 2:8"/><verse number="9" style="v" sid="1CO 2:9"/>ሽን ጾሳ ማጻፋይ፥</para>
  <para style="q1" vid="1CO 2:9">“ኦንነ አይፍያን በእቤናዌ፥</para>
  <para style="q2" vid="1CO 2:9">ሀይንካ ስስቤናዌ፥</para>
  <para style="q2" vid="1CO 2:9">ቃይ ኦንነ ባረ ዎዛናን ቆፕቤናዌ</para>
  <para style="q2" vid="1CO 2:9">ጾሳይ ባረና ሲቅያዋንቶ ጊግሴዳዋ”</para>
  <para style="m" vid="1CO 2:9">ግያዋዳን ኑን ሃሳዬቶ።<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="ISA 64:4">ኢሳ. 64:4</ref></char></note> <verse eid="1CO 2:9"/><verse number="10" style="v" sid="1CO 2:10"/>ጾሳይ ባረ ጹራ የዉዋ ባረ አያናን ኑና ኤርሴዳ፤ አያዉ ጎፐ፥ ጌሻ አያናይ ጾሳባ ሀራይ አቶ ጌሜዳ የዉዋ ኡባ ብዴ። <verse eid="1CO 2:10"/><verse number="11" style="v" sid="1CO 2:11"/>አያዉ ጎፐ፥ አሳን ደእያ አሳ አያናፐ አትን፥ አሳባ ኤርያዌ ኦኔ? ሀዋዳንካ፥ ቃይ ጾሳባ ጾሳ አያናፐ አትን፥ ኦንነ ኤረና። <verse eid="1CO 2:11"/><verse number="12" style="v" sid="1CO 2:12"/>ኑን ጾሳይ ኑዉ እሜዳባ ኡባ ኤራናዉ እ ኑዉ የዴዳ አያና አኬዶፐ አትን፥ አላምያ አያና አክበይኮ።<verse eid="1CO 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13"/>ኑን አያና የዉዋ<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="fk" closed="false">አያና የዉዋ፦ </char><char style="ft" closed="false">ጌሻ አያናይ እሜዳ ቃላ።</char></note> አያና የዉዋና ጋደ፥ ጌሻ አያናይ ኑና ታማርሴዳ ቃላን ሀዋ ሃሳዬቶፐ አትን፥ አሳ አ ኤራተይ ኑና ታማርሴዳ ቃላን ሃሳዮኮ። <verse eid="1CO 2:13"/><verse number="14" style="v" sid="1CO 2:14"/>ሽን ጌሻ አያናይ ባይና አሳይ ጾሳ አያና የዉዋ አከና፤ አያዉ ጎፐ፥ ሄዌ አዉ ኤያተ። የዉ ጌሻ አያናን ፓጨትያ ድራዉ፥ እ ኤራናዉ ዳንዳየና። <verse eid="1CO 2:14"/><verse number="15" style="v" sid="1CO 2:15"/>ሽን ጌሻ አያናይ ደእያ አሳይ ኡባባ ሻኬ፤ ሽን እ ባረ ሁጰዉ ኦናንነ ሻከተና። <verse eid="1CO 2:15"/><verse number="16" style="v" sid="1CO 2:16"/>አያዉ ጎፐ፥ ጾሳ ማጻፋይ፥</para>
  <para style="q1" vid="1CO 2:16">“ጎዳ ዎዛና ኤርያዌ ኦኔ?</para>
  <para style="q2" vid="1CO 2:16">አ ዞራናዉ ዳንዳይያዌ ኦኔ?”</para>
  <para style="m" vid="1CO 2:16">ያጌ። ሽን ኑዉ ክርስቶሳ ዎዛናይ ደኤ።<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="fk" closed="false">ኑዉ ክርስቶሳ ዎዛናይ ደኤ፦ </char><char style="ft" closed="false">ሀዋ ጉሳይ፥ ኑን ክርስቶስ ቆፕያዋዳን ቆፔቶ ጉሳ።</char></note><note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ISA 40:13">ኢሳ. 40:13</ref></char></note><verse eid="1CO 2:16"/></para>
  <chapter eid="1CO 2"/>
  <chapter number="3" style="c" sid="1CO 3"/>
  <para style="s1">ጾሳ ካልያዋንቱ ኦሱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1"/>ታናዳን አማንያዋንቶ፥ ታን ጌሻ አያናይ ደእያ አሳዉ ሃሳይያዋዳን፥ ህንተንቶ ሃሳያናዉ ዳንዳያበይከ። ሽን ሀ አላምያ አሳዉ ሃሳይያዋዳንነ አማኑዋን ምንቤና ክርስቶሳን ደእያ ጉ ናና ማላ አሳዉ ሃሳይያዋዳን ሃሳያድ። <verse eid="1CO 3:1"/><verse number="2" style="v" sid="1CO 3:2"/>ህንተንቱ ብሮ ምኖ ቁማ ማናዉ ዳንዳይቤና ድራዉ፥ ታን ህንተንታ ማ ፓካድ፤ ሀራይ አቶ፥ ሀእካ ዳንዳይበይክታ። <verse eid="1CO 3:2"/><verse number="3" style="v" sid="1CO 3:3"/>አያዉ ጎፐ፥ ህንተ ሀእካ ሀ አላምያ አሳዳን ደኢታ። ህንተንቱ ሀ አላምያ አሳ ግድያዋ ህንተ ግዶን ደእያ ቃናቲነ ፓሉማይ ኤርሰኔ? ቃይ ሀ አላምያ አሳዳን ስመረቲታ። <verse eid="1CO 3:3"/><verse number="4" style="v" sid="1CO 3:4"/>አያዉ ጎፐ፥ ህንተንቱፐ እቱ፥ “ታን ጳዉሎሳዋ” ጎፐ፥ ሀራይ ቃይ፥ “ታን አጲሎሳዋ” ጎፐ፥ ሀ አላምያ አሳ ማላ ግድክቴ?<verse eid="1CO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5"/>ያትና፥ አጲሎስ ኦኔ? ጳዉሎስ ኦኔ? ኑን ህንተንታ አማንዳ ጾሳ ካልያዋንታ። ጾሳይ ኑዉ ሁጲያን ሁጲያን እሜዳ ኦሱዋ ኦቶ። <verse eid="1CO 3:5"/><verse number="6" style="v" sid="1CO 3:6"/>ታን ፑትያ ቶካድ፤ አጲሎስ ሃ ኡሼዳ፤ ሽን ጾሳይ ፑትያ ድቼዳ። <verse eid="1CO 3:6"/><verse number="7" style="v" sid="1CO 3:7"/>ሄዋ ድራዉ፥ ድችያ ጾሳፐ አትን፥ ቶክያዌካ ሃ ኡሽያዌካ አያነ ግደና። <verse eid="1CO 3:7"/><verse number="8" style="v" sid="1CO 3:8"/>ቶክያዌነ ሃ ኡሽያዌ እት ማላ፤ ሽን ጾሳይ ሁጲያን ሁጲያን አ ዳቡራ ኬና አዉ ዎይታና። <verse eid="1CO 3:8"/><verse number="9" style="v" sid="1CO 3:9"/>ኑን ጾሳዉ እትፐ ኦያ አ ኦሳንቻቱዋ ግድያ ድራዉ፥ ህንተ አ ኦሱዋ ሳኣ።</para>
  <para style="p" vid="1CO 3:9">ቃይካ ህንተ ጾሳ ጎልያ። <verse eid="1CO 3:9"/><verse number="10" style="v" sid="1CO 3:10"/>ጾሳይ ታዉ እሜዳ አ ኬካተን ኤራንቻ አናጽያዳን፥ ጎልያ ባሱዋ ባሳድ። ሀራ ኡራይ አ ቦላ ኬጼ። ሽን አ ቦላ ኬጽያ ኦንነ ዎት ኬጽንቶ፥ ባረ ሁጰዉ ናገቶ። <verse eid="1CO 3:10"/><verse number="11" style="v" sid="1CO 3:11"/>አያዉ ጎፐ፥ ጾሳይ የሱስ ክርስቶሳ ጻላላ ባሶ ኦደ ዎዳ። አፐ ሀራ ባሱዋ ባሳናዉ ኦንነ ዳንዳየና። <verse eid="1CO 3:11"/><verse number="12" style="v" sid="1CO 3:12"/>ሽን ሀ ባሱዋ ቦላ ኦንነ ዎርቃን ግድና፥ ብራን ግድና፥ አልኦ ሹቻን ግድና፥ ምን ግድና፥ ጋታን ዎይ ማቃን ኬጾፐ፥ <verse eid="1CO 3:12"/><verse number="13" style="v" sid="1CO 3:13"/>አሳ ኡባ ኦሱ ቆንጭያ ከሳናዋ። አያዉ ጎፐ፥ ታማን ቆንጫና ድራዉ፥ ሄ ጋላሳይ አሳ ኡባ ኦሱዋ በሳና። አሳይ ኡባይ ባረ ኦሱዋ ዎት ኦደንቶነ ታማይ ፓጫና። <verse eid="1CO 3:13"/><verse number="14" style="v" sid="1CO 3:14"/>ኦንነ ባሱዋ ቦላ ኬጼዳ ኦሱ ምኒደ አቶፐ፥ እ ዎይታ አካናዋ። <verse eid="1CO 3:14"/><verse number="15" style="v" sid="1CO 3:15"/>ኦ ኦሱነ ጉደቶፐ፥ ሄ ኡራይ ቆሄታና። እ ባረ ሁጰዉ አታና፤ ሽን ታማ ግዶፐ ከስ አኮዋዳን አታና።<verse eid="1CO 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16"/>ህንተንቱ ጾሳይ አቅያ ጌሻ ጎልያ ግድያዋነ ጾሳ አያናይ ህንተንቱን ደእያዋ ኤርክቴ? <verse eid="1CO 3:16"/><verse number="17" style="v" sid="1CO 3:17"/>ኦንነ ጾሳ ጌሻ ጎልያ ኮሎፐ፥ ጾሳይ አ ኮላና። አያዉ ጎፐ፥ ጾሳይ አቅያ ጌሻ ጎሊ ጌሻ፤ ሄ ጌሻ ጎሊካ ህንተንታ።<verse eid="1CO 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18"/>ኦንነ ባረ ሁጲያ ጭሞፖ። ህንተንቱፐ ኦንነ ባረና ሀ አላምያን አ ኤራንቻ ያጊደ ቆፖፐ፥ አ ኤራንቻ ግዳናዉ፥ ኤያ ግዶ። <verse eid="1CO 3:18"/><verse number="19" style="v" sid="1CO 3:19"/>አያዉ ጎፐ፥ ሀ አላምያ አ ኤራተይ ጾሳ ስንን ኤያተ። ጾሳ ማጻፋይ፥</para>
  <para style="q1" vid="1CO 3:19">“ጾሳይ አ ኤራንቻቱዋ፥</para>
  <para style="q2" vid="1CO 3:19">ኡንቱንታ ኡንቱንቱ ገንያን ኦይቄ”</para>
  <para style="m" vid="1CO 3:19">ያጌ።<note caller="-" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="JOB 5:13">ኢዮባ 5:13</ref></char></note> <verse eid="1CO 3:19"/><verse number="20" style="v" sid="1CO 3:20"/>ቃይ፥</para>
  <para style="q1" vid="1CO 3:20">“አዳ ኤራንቻቱዋ ቆፋይካ፥</para>
  <para style="q2" vid="1CO 3:20">ማዱ ባይናዋ ግድያዋ ጎዳይ ኤሬ”</para>
  <para style="m" vid="1CO 3:20">ያጌ።<note caller="-" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="PSA 94:11">ማዝ. 94:11</ref></char></note> <verse eid="1CO 3:20"/><verse number="21" style="v" sid="1CO 3:21"/>ሄዋ ድራዉ፥ ኦንነ አሳን ጬቀቶፖ። አያዉ ጎፐ፥ ኡባባይካ ህንተዋ። <verse eid="1CO 3:21"/><verse number="22" style="v" sid="1CO 3:22"/>ጳዉሎስካ፥ አጲሎስካ፥ ኬፋይካ፥ ሀ አላሚካ፥ ደኡካ፥ ሀይቁካ፥ ሀእ ደእያዌካ፥ ስንፐ ያናዌካ፥ ኡባይካ ህንተዋ። <verse eid="1CO 3:22"/><verse number="23" style="v" sid="1CO 3:23"/>ህንተንቱ ክርስቶሳዋንታ፤ ክርስቶስካ ጾሳዋ።<verse eid="1CO 3:23"/></para>
  <chapter eid="1CO 3"/>
  <chapter number="4" style="c" sid="1CO 4"/>
  <para style="s1">ክርስቶሳ ካልያዋንታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1"/>አሳይ ኑና ክርስቶሳዉ ኦያዋንቱዳንነ ጾሳ ጎለን ደእያ ጹራ ናግያ አሳዳን ቆፖ። <verse eid="1CO 4:1"/><verse number="2" style="v" sid="1CO 4:2"/>ያቲደ ሄ አሳቱ ባረንቱ ጎዳዉ አማነቴዳዋንታ ግዲደ፥ ቤታናዉ ኮሼ። <verse eid="1CO 4:2"/><verse number="3" style="v" sid="1CO 4:3"/>ሽን ህንተ ዎይ ሀራይ ታ ቦላ ፕርዶፐ፥ አይነ ግደና። ሀራይ አቶ፥ ታንካ ታ ሁጲያን ፕርድከ። <verse eid="1CO 4:3"/><verse number="4" style="v" sid="1CO 4:4"/>አያዉ ጎፐ፥ ታን ታ ሁጲያን አያኔካ ኤርያባይ ባዋ፤ ሽን ታና ሄዌ ጽልሰና። ታና ፕርድያዌ ጎዳ። <verse eid="1CO 4:4"/><verse number="5" style="v" sid="1CO 4:5"/>ሄዋ ድራዉ፥ ጎዳይ ማን ጌሜዳባ ፖኡዋ ከስያዌ፥ ዎዛና ቆፋ ቆንጭስያዌ ያና ዎዲ ጋካናዉ ኦ ቦላንነ ኦናነ ፕርዶፕተ። ሄ ዎደ፥ አሳይ ኡባይ ሁጲያን ሁጲያን ጾሳፐ ሳባ ደማናዋ።<verse eid="1CO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6"/>ታናዳን አማንያዋንቶ፥ ህንተንቱፐ ኦንነ እቱ ታማርስያዋ ሳቢደ፥ ሀራይ ታማርስያዋ ቦረና ማላ፥ “ጾሳ ማጻፋን ጻፈቴዳዋ ቦንቻ” ያግያዋ ህንተ ኑናና ታማራና ማላ፥ ህንተ ድራዉ፥ ታባነ አጲሎሳባ ሌምሱዋዳን ኦዳድ። <verse eid="1CO 4:6"/><verse number="7" style="v" sid="1CO 4:7"/>አያዉ ጎፐ፥ ሀራቱዋፐ ኔና ኦኔ ቂሴዳዌ? ኔን ጾሳፐ አካቤናባይ ነዉ አዬ ደእያዌ? ያትና፥ ኔን አኬዳዋ ግዶፐ፥ አያዉ አካቤናዋዳን ጬቀታይ?<verse eid="1CO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8"/>ሀእ ህንተ ካሌድታ። ሀእ ዱረቴድታ። ኑን ባይናን ህንተረካ ካዉቴድታ። ኑንካ ህንተንቱና ካተታናዳን፥ ህንተ ካዉቴድተንቶ ሎአ ሽን። <verse eid="1CO 4:8"/><verse number="9" style="v" sid="1CO 4:9"/>አያዉ ጎፐ፥ ታዉ ማላትያዋዳን፥ ኑን ሀ ሳአዉ፥ ኪታንቻቶነ አሳዉ ካሳ ግዴዳ ድራዉ፥ ጾሳይ ኑና የሱስ ኪቴዳዋንታ ሀይቆ ፕርደቴዳ አሳዳን፥ ኡባፐ ዉርሰ ኦዳ።<verse eid="1CO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 4:10"/>ኑን ክርስቶሳ ድራዉ ኤያ፥ ሽን ህንተ ክርስቶሳን አዳ ኤራንቻ። ኑን ዳቡራንቻ፥ ሽን ህንተ ምና። ህንተንቱ ቦንቼቴዳዋንታ፥ ሽን ኑን ቶሸቴዳዋንታ። <verse eid="1CO 4:10"/><verse number="11" style="v" sid="1CO 4:11"/>ሀ ዎዲ ጋካናዉ፥ ኑን ኮሻቴቶ፤ ሳመቴቶ፤ ካሎቴቶ፤ ደሸቴቶ። ቃይ ደእያ ሳኣ ዪደ ዩዬቶ። <verse eid="1CO 4:11"/><verse number="12" style="v" sid="1CO 4:12"/>ኑን ኑ ኩሽያን ኦደ ዳቡሬቶ። ኑና አሳይ ሸቂያ ዎደ፥ አንጄቶ። ኑና የደርስ ዩይያ ዎደካ ዳንዳዬቶ። <verse eid="1CO 4:12"/><verse number="13" style="v" sid="1CO 4:13"/>ኑ ቦላ ኢታባ ሃሳይያ ዎደ፥ ኑን ሎኦ ቃላ ዛሬቶ። ኑን ሀዋ ጋካናስካ፥ ሀ ሳኣ ፕቱዋነ ኡባባ ቡራ ግዴዶ።<verse eid="1CO 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14"/>ታን ታ ሲቅያ ናናዳን፥ ህንተንታ ሴራናዉ ሀዋ ጻፋድፐ አትን፥ ዬላያናዉ ጻፋበይከ። <verse eid="1CO 4:14"/><verse number="15" style="v" sid="1CO 4:15"/>አያዉ ጎፐ፥ ክርስቶሳን ህንተንታ ድችያ ታሙ ሻአ አሳይ ህንተንቶ ደኦፐካ፥ ህንተንቶ እት አዉዋፐ ሀራይ ባዋ። አያዉ ጎፐ፥ ታን ምሽራቹዋ ቃላ ህንተንቶ አሄዳዋዳን፥ ክርስቶሳ የሱሳን ህንተንቶ አዉዋ ግዳድ። <verse eid="1CO 4:15"/><verse number="16" style="v" sid="1CO 4:16"/>ስም ታናዳን ሀንተ ያጋደ ህንተንታ ዎሳይ። <verse eid="1CO 4:16"/><verse number="17" style="v" sid="1CO 4:17"/>ሄዋ ድራዉ፥ ጎዳን አማነቴዳ ታ ሲቅያ ታ ናኣ ጽሞቶሳ ህንተንቱኮ ኪታድ። እ ኡባ ሳኣን ደእያ አማንያ አሳ ኡባዉ ታን ታማርስያ ክርስቶሳ የሱሳን ደእያ ታ ኦግያ ህንተንታ ሀሳይሳናዋ።<verse eid="1CO 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18"/>ታን ህንተንታ በአናዉ ህንተንቱኮ ዬናባ ማላትና፥ ኦቶረትያ እት እት አሳቱ ደኢኖ። <verse eid="1CO 4:18"/><verse number="19" style="v" sid="1CO 4:19"/>ሽን ጎዳይ ጎፐ፥ ታን ህንተንቱኮ ኤለካ ባደ ሄ ኦቶረትያ አሳቶ ሃሳያ ግደናን፥ ኡንቱንቱ ዎልቃ ኤራና። <verse eid="1CO 4:19"/><verse number="20" style="v" sid="1CO 4:20"/>አያዉ ጎፐ፥ ጾሳ ካዉተይ ጾሳ ዎልቃናፐ አትን፥ ሃሳያና ግደና። <verse eid="1CO 4:20"/><verse number="21" style="v" sid="1CO 4:21"/>ታን ህንተንቱኮ ሙርያ ጻምኣና ዮየ ዎይ ሲቁዋናነ አሽከ አያናና ዮ? ሀቃዋ ዶሪቴ?<verse eid="1CO 4:21"/></para>
  <chapter eid="1CO 4"/>
  <chapter number="5" style="c" sid="1CO 5"/>
  <para style="s1">አማንያ አሳ ግዶን ኦሰቴዳ ፖኮባ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1"/>ህንተንቱ ግዶን ፖኮ ዎሹማ ኦሱ ደእያዌ ዝግረቴ፤ ሄዋ ማላ ፖኮ ዎሹማ ኦሱ ሀራይ አቶ፥ ጾሳ አማነና አሳ ግዶንነ ባዋ። አያዉ ጎፐ፥ ባረ አዉዋ ማቻቶ አኬዳ አሳይ ደኤ።<note caller="-" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="DEU 22:30">ዛረ. 22:30</ref></char></note> <verse eid="1CO 5:1"/><verse number="2" style="v" sid="1CO 5:2"/>ህንተንቱካ ኦቶረቴድታ። ሄዋፐ ህንተ ካዮታናዉ በሰኔ? ሄዋ ማላ ፖኮ ኦሱዋ ኦዳ ብታኒ ህንተ ግዶፐ ክቻናዉ በሴ።<verse eid="1CO 5:2"/></para>
  <para style="p">
    <verse number="3-4" style="v" sid="1CO 5:3-4"/>አያ ግድናካ ታን ታ አሳተን ህንተንቱና ደኤናን ዮፐካ፥ አያናን ህንተንቱና ደአይ። ሀእ ህንተንቱና ደእያዋዳን ሀናደ፥ ሄዋ ማላ ኦሱዋ ኦዳ ብታንያ ቦላ ኑ ጎዳ የሱስ ክርስቶሳ ሱንን ፕርዳድጋድ። ህንተንቱነ ታ አያናይ ኑ ጎዳ የሱስ ክርስቶሳ ዎልቃና እትፐ ሺቂደ፥ <verse eid="1CO 5:3-4"/><verse number="5" style="v" sid="1CO 5:5"/>ሄ ብታንያ አያናይ ጎዳ የሱስ ፕርዳዉ ይያ ጋላሳን አታና ማላ፥ ናጋራን ኩሜዳ አ ቦላ ኮላናዳን ሴጻናዉ ህንተ እማናዳን፥ ታን ፕርዳድ።<verse eid="1CO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6"/>ህንተንቱ ጬቁ ሎአ ግደና። ጉ እርሹ ሙናቃ ኡባ ደንያዋ ኤርክቴ? <verse eid="1CO 5:6"/><verse number="7" style="v" sid="1CO 5:7"/>ህንተንቱ ኦራ ግዳና ማላ፥ ናጋራ እርሹ ጫሌዳዋ ከስተ። ህንተንቱ እርሹ ባይና ሙናቃ ማላ። አያዉ ጎፐ፥ ኑ ፓስጋ ዶርሳይ፥ ክርስቶስ ያርሸቴዳ።<note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="EXO 12:5">ከሳ 12:5</ref></char></note> <verse eid="1CO 5:7"/><verse number="8" style="v" sid="1CO 5:8"/>ሄዋ ድራዉ፥ ኑን ኡክ ባላ ሱረተንነ ቱማተን ቦንቻናፐ አትን፥ ጫላ እርሹዋን፥ ኢታተ እርሹዋንነ ጌላተ እርሹዋን ቦንቾኮ።<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="EXO 13:7">ከሳ 13:7</ref>፤ <ref loc="DEU 16:3">ዛረ. 16:3</ref></char></note><verse eid="1CO 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9"/>ዎሹማናዉ ቆፕያዋንቱና ህንተ እትፐ ጋይተና ማላ፥ ህንተንቶ ዳብዳቢያ ጻፋድ።<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="fk" closed="false">ዳብዳቢያ ጻፋድ፦ </char><char style="ft" closed="false">ሀዋ ጻፋናፐ ካሰና ጳዉሎስ ቆሮንቶሳ አሳዉ ጻፌዳ ሀራ ቆንጭያን ኤረትቤና ዳብዳቢ ደኤ ጉሳ።</char></note> <verse eid="1CO 5:9"/><verse number="10" style="v" sid="1CO 5:10"/>ታን ግያዌ ሀ አላምያን ደእያ ዎሹማናዉ ቆፕያዋንቱፐ ዎይ ዮራትያዋንቱፐ፥ ካይሶትያዋንቱፐነ ዎይ ኤቃዉ ጎይንያዋንቱፐ ኡባካ ሻከታና ማላ ግደና። ሄዋ ግዶፐ፥ ሀ አላምያፐ ህንተ ሻከት ባናዉ በሴ ጉሳ። <verse eid="1CO 5:10"/><verse number="11" style="v" sid="1CO 5:11"/>ሽን እሻቱዋ ሀእ ጌተትያዋንቱፐ እቱነ ዎሹማናዉ ቆፕያዋንቱ ዎይ ሚሻዉ ዮራትያዋንቱ ዎይ ኤቃዉ ጎይንያዋንቱ ዎይ አሳ ሱን ባይዝያዋንቱ ዎይ ማትያዋንቱ ዎይ ዉእያዋንቱና ህንተንቱ እትፐተ ኦና ማላ፥ ታን ህንተንቶ ጻፋድ። ሄዋንቱ ማላና ሀራይ አቶ፥ ቁማካ እትፐ ሞፕተ።<verse eid="1CO 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12"/>አያዉ ጎፐ፥ ዎሳ ጎለፐ ካረና ደእያዋንቱ ቦላ ፕርዳናዉ ታና አዬ ጋ? ህንተንቱ ግዶን ዎሳ ጎለን ደእያዋንቱ ቦላን ህንተ ፕርድክቴየ? <verse eid="1CO 5:12"/><verse number="13" style="v" sid="1CO 5:13"/>ሽን ካረና ደእያዋንቱ ቦላን ጾሳይ ፕርዳና። ሄ ኢታባ ኦያ ኡራ ህንተ ግዶፐ ከስ ድግተ።<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="DEU 13:5">ዛረ. 13:5</ref>፤ <ref loc="DEU 17:7">17:7</ref></char></note><verse eid="1CO 5:13"/></para>
  <chapter eid="1CO 5"/>
  <chapter number="6" style="c" sid="1CO 6"/>
  <para style="s1">አማንያ አሳ ግዶን ደእያ ዋላሳ ዎቲደ ይሳናዉ በሲ?</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1"/>ህንተንቱፐ እት ኡራዉ ባረ እሻና ሞቱ ደእያባ ግዶፐ፥ አማንያዋንቱ ቦላ ፕርደታናዋ ባሺደ፥ አማነናዋንቱ ቦላ ፕርደታናዉ ዋን ጻሊደ ቤዳ? <verse eid="1CO 6:1"/><verse number="2" style="v" sid="1CO 6:2"/>አማንያዋንቱ አላምያ ቦላ ፕርዳናዋ ኤርክቴ? ያትና፥ አላምያ ቦላ ህንተ ፕርዳናዋንታ ግዶፐ፥ ኡባባፐ ጉጽያዋ ፕርዳናዉ ዳንዳይክቴ? <verse eid="1CO 6:2"/><verse number="3" style="v" sid="1CO 6:3"/>ሀ ደኡዋባይ አቶ ሽን፥ አማንያዋንቱ ኪታንቻቱዋ ቦላ ፕርዳናዋ ኤርክቴ? <verse eid="1CO 6:3"/><verse number="4" style="v" sid="1CO 6:4"/>ያትና፥ ህንተንታ ሀ አላምያ ደኡዋባዉ ፕርዳ ጎለ ቡሳይ ኮሾፐ፥ አማንያ አሳይ ካዳ አሳን ፕርድሳናዉ አፊቴ? <verse eid="1CO 6:4"/><verse number="5" style="v" sid="1CO 6:5"/>ታን ህንተንታ ዬላያናዉ ሀዋ ጋይ፤ ሀዋ ግዳናዉ በሲ? ህንተንቱ ግዶን እሻቱዋ ስገናዉ ዳንዳይያ ሎኦ ኤራንቻ አሳይ እቱነ ባዌ? <verse eid="1CO 6:5"/><verse number="6" style="v" sid="1CO 6:6"/>ሽን እት እሻይ የኮ እሻ ፕርዳ ጎለን ሞቲደ፥ ሄ የዉዋ አማነና አሳን ፕርድሲ?<verse eid="1CO 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7"/>ስም እቱ እቱዋ ሞትያዌ ህንተ ግዶን ደኦፐ፥ ሄዌ ህንተ ኩንዴዳዋ በሴ። ሄዋፐ ህንተ ናቀትያዌነ ጭመትያዌ ሎኤኔ? <verse eid="1CO 6:7"/><verse number="8" style="v" sid="1CO 6:8"/>ሽን ህንተ ህንተ ሁጰዉ እቱ እቱዋ ሀራይ አቶ፥ ህንተ እሻቱዋካ ናቂታነ ጭሚታ።<verse eid="1CO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 6:9"/>ዎይ ማካላንቻቱ ጾሳ ካዉተ ላተናዋ ኤርክቴ? ባሎፕተ። ዎሹማናዉ ቆፕያዋንቱ ዎይ ኤቃዉ ጎይንያዋንቱ ዎይ ዎሹምያዋንቱ ዎይ አቱማዋ ግዲደ፥ አቱማዋና ግስያዋንቱ፥ <verse eid="1CO 6:9"/><verse number="10" style="v" sid="1CO 6:10"/>ዎይ ካይሳቱ ዎይ ሚሻዉ ዮራትያዋንቱ ዎይ ማትያዋንቱ ዎይ አሳ ሱን ባይዝያዋንቱ ዎይ ቦንቂያዋንቱ ጾሳ ካዉተ ላትክኖ። <verse eid="1CO 6:10"/><verse number="11" style="v" sid="1CO 6:11"/>ህንተንቱፐካ እት እት አሳይ ሄዋንቱ ማላ። ሽን ጎዳ የሱስ ክርስቶሳ ሱንንነ ኑ ጾሳ አያናን ህንተ ሜጨቲደ ጌዬድታ፤ ቃይ ጽሌድታ።<verse eid="1CO 6:11"/></para>
  <para style="s1">ህንተንቱ አሳተ ጾሳ ቦንቾ ፔሽተ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12"/>እት ኡራይ፥ “ታን ኮዬዳባ ኡባ ኦናዉ ዳንዳያይ” ጋና ዳንዳዬ። ሽን ኡባይካ ታና ማደና። ታን ኮዬዳባ ኡባ ኦናዉ ዳንዳያይ። ሽን አዬኔካ ታና ሞደና። <verse eid="1CO 6:12"/><verse number="13" style="v" sid="1CO 6:13"/>ቃይ ሀራይካ፥ “ቁማይ ኡሉዋሳ፤ ኡሉካ ቁማሳ” ጌ። ሽን ጾሳይ ኡሉዋካ ቁማካ ይሳና። አሳ አሳተይ ጎዳ የሱሳሳፐ አትን፥ ዎሹማሳ ግደና። ጎዳ የሱስካ አሳ አሳተሳ። <verse eid="1CO 6:13"/><verse number="14" style="v" sid="1CO 6:14"/>ጾሳይ ጎዳ የሱሳ ሀይቁዋፐ ደንዳ፤ ቃይ ኑናካ ሀይቁዋፐ ባረ ዎልቃን ደንና።<verse eid="1CO 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15"/>ህንተንቱ አሳተይ ክርስቶሳ አሳተና እቱዋ ግድያዋ ህንተ ኤርክቴ? ያትና፥ ታን ክርስቶሳ አሳተና እቱዋ ግዴዳዋ አፋደ፥ ጫራት አሳተና እቱዋ ኦናዉ በሲ? በሰና! <verse eid="1CO 6:15"/><verse number="16" style="v" sid="1CO 6:16"/>ዎይ ጫራትና እትፐተ መያ ኡራይ እዝና እት አሳተ ግድያዋ ኤርክቴ? አያዉ ጎፐ፥ ጾሳ ማጻፋይ፥ “ኡንቱንቱ ላአቱ እት አሾ ግዳና” ያጌ።<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="GEN 2:24">ዶመ 2:24</ref></char></note> <verse eid="1CO 6:16"/><verse number="17" style="v" sid="1CO 6:17"/>ሽን ጎዳና እትፐተ መያ ኡራይ አያናን አናና እቱዋ ግዴ።<verse eid="1CO 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18"/>ዎሹማፐ ሃክተ። እት ኡራይ ኦያ ሀራ ናጋራ ኡባይ አ አሳተፐ ካረና ደኤ፤ ሽን ዎሹምያዌ ባረ ቦላን ናጋራ ኦ። <verse eid="1CO 6:18"/><verse number="19" style="v" sid="1CO 6:19"/>ዎይ ህንተ ቦላይ ጾሳይ ህንተንቶ እሜዳ ህንተንቱን ደእያ ጌሻ አያናይ አቅያ ጌሻ ጎልያ ግድያዋ ኤርክቴ? ቃይ ህንተ ህንተ ሁጲያሳ ግድክታ። <verse eid="1CO 6:19"/><verse number="20" style="v" sid="1CO 6:20"/>አያዉ ጎፐ፥ ጾሳይ ህንተንታ ጋትያን ሻሜዳ። ሄዋ ድራዉ፥ ህንተ አሳተን አ ቦንችተ።<verse eid="1CO 6:20"/></para>
  <chapter eid="1CO 6"/>
  <chapter number="7" style="c" sid="1CO 7"/>
  <para style="s1">ገሉዋ አካባስ ኦሸቴዳ ኦሻነ እመቴዳ ዛሩዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1"/>ህንተንቱ ታዉ ጻፌዳ የዎ አቱማ አሳይ ማጫዉኖ ቦቼነንቶ ሎአ። <verse eid="1CO 7:1"/><verse number="2" style="v" sid="1CO 7:2"/>ሽን ዎሹማ ጋሱዋ ድራዉ፥ አቱማ አሳዉ ሁጲያን ሁጲያን ማቻታ ደኡ። ቃይ ማጫ አሳዉካ ሁጲያን ሁጲያን አስናይ ደኦ።<verse eid="1CO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 7:3"/>አስናይ ባረ ማቻትዉ አስናተን በስያባ ኦ፤ ቃይ ሄዋዳን፥ ማቻታካ ባረ አስናዉ ማቼተን በስያባ ኦ። <verse eid="1CO 7:3"/><verse number="4" style="v" sid="1CO 7:4"/>ማቻታ ባረ አሳተዉ ጎዳ ግዱኩ፤ ሽን እዝ አስናይ ጎዳ። ሀዋዳንካ፥ ቃይ አስናይ ባረ አሳተዉ ጎዳ ግደና፤ ሽን አ ማቻታ ጎዳ። <verse eid="1CO 7:4"/><verse number="5" style="v" sid="1CO 7:5"/>ህንተንቱ ህንተ ግዶን ጾሳ ዎሳን ገንጫናዉ ሄ ዎድያዉ ዞረታን ድገታናፐ አትን፥ እቱ እቱዋ ድጎፕተ። ህንተንቱ ህንተንታ ናገና ድራዉ፥ ሴጻናይ ህንተንታ ፓጨናዳን፥ እትፐ ደእተ። <verse eid="1CO 7:5"/><verse number="6" style="v" sid="1CO 7:6"/>ሽን ታን ህንተንታ ሄዋ ህንተ ዶሶዋዳን ሀንተ ጋይፐ አትን፥ አዛዝከ። <verse eid="1CO 7:6"/><verse number="7" style="v" sid="1CO 7:7"/>ታን አሳይ ኡባይ ታናዳን ሀንንቶ ዶሳይ። ሽን ጾሳይ አሳዉ ሁጲያን ሁጲያን ዱማ ዱማ እሞታ እም ዎዳ፤ እቶ ሀዋዳን፥ ቃይ የኮ ሄዋዳን እም ዎዳ።<verse eid="1CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8"/>ሄዋ ድራዉ፥ ታን ማቻቶ አክቤናዋንቱነ አስናይ ሀይቆ ማጫዋንቱ ታናዳን ጮ ደኢኖንቶ፥ ኡንቱንቶ ሎአ ጋይ። <verse eid="1CO 7:8"/><verse number="9" style="v" sid="1CO 7:9"/>ሽን አሙዋን ጉደትያዋፐ አክያዌነ ገልያዌ ሎአ ግድያ ድራዉ፥ ኡንቱንቱ ባረንታ ናጋናዉ ዳንዳያና ዮፐ፥ አክኖነ ገልኖ።<verse eid="1CO 7:9"/></para>
  <para style="p">
    <verse number="10-11" style="v" sid="1CO 7:10-11"/>ማቻታ ባረ አስናፐ ሻከቱፑ። ሽን ሻከቶፐነ ገለናን ደኡ፤ ዎይ ባረ አስናና ስገቱ። አስናይካ ባረ ማቻቶ የዶፖ ያጋደ፥ አኬዳዋንታነ ገሌዳዋንታ አዛዛይ። ሽን ሀዋ አዛዝያዌ ጎዳፐ አትን፥ ታና ግድከ።<verse eid="1CO 7:10-11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12"/>ታን ሀራቱዋ ሀዋዳን ጋይ፤ ጎዳ ግደና። አማነና ማቻታ ደእያ አማንያ አሳይ ኦንነ ደኦፐ፥ አ ማቻታ አናና እትፐ ደእያዋ እ ዶሶፐ፥ እዞ የዶፖ። <verse eid="1CO 7:12"/><verse number="13" style="v" sid="1CO 7:13"/>ቃይ አማነና አስናይ ደእያ አማንያ ማቻታ ደኦፐ፥ እዝ አስናይ እዝና እትፐ ደእያዋ እዛ ዶሶፐ፥ አፐ ሻከቱፑ። <verse eid="1CO 7:13"/><verse number="14" style="v" sid="1CO 7:14"/>አያዉ ጎፐ፥ አማነና አስናይ ባረ አማንያ ማቻትና ደኢደ ጌዬዳ። ቃይ አማነና ማቻታ ባረ አማንያ አስናና ደኣደ ጌያዱ። ሄዌ ባዌንቶ፥ ህንተንቱ ናናይ ቱና፤ ሽን ሀእ ኡንቱንቱ ጌሻ። <verse eid="1CO 7:14"/><verse number="15" style="v" sid="1CO 7:15"/>ሽን አማነናዌ ሻከታና ኮዮፐ ሻከቶ። አማንያ ማቻቶ ግድና፥ ዎይ አስና ግድና፥ ሀዋ ማላ የዉዋን ቃሸትክኖ። አያዉ ጎፐ፥ ጾሳይ ኑና ሳሮተን ደአናዉ ጼሴዳ። <verse eid="1CO 7:15"/><verse number="16" style="v" sid="1CO 7:16"/>አማንያ ማቻቴ፥ ኔን ነ አስና አሻንንቶነ ኦ ኤር? ዎይ አማንያ አስናዉ ኔን ነ ማቻቶ አሻንንቶነ ኦ ኤር?<verse eid="1CO 7:16"/></para>
  <para style="s1">ጾሳይ ህንተንታ ኮይሮ ጼስያ ዎደ ህንተንቱ ደእያ ሀኖታን ደእተ</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17"/>ግዶፐነ፥ አሳይ ሁጲያን ሁጲያን ጎዳይ አዉ እሜዳዋዳንነ ቃይ ጾሳይ ባረና ጼሴዳዋዳን ደኦ። ሄዌ አማንያ አሳ ኡባ ታን ታማርሴዳ ህግያ። <verse eid="1CO 7:17"/><verse number="18" style="v" sid="1CO 7:18"/>ኦንነ ቃጻረት ኡቲደ፥ ጾሳ አማኔዳዋ ግዶፐ፥ ባረ ቃጻራ ማላ ድጎፖ። ቃይ ኦንነ ቃጻረተናን ደኢደ፥ ጾሳ አማኔዳዋ ግዶፐ ቃጻረቶፖ። <verse eid="1CO 7:18"/><verse number="19" style="v" sid="1CO 7:19"/>አያዉ ጎፐ፥ ጾሳ አዛዙዋ ናጋናፐ አትን፥ ቃጻረትና ቃጻረታና ይና አላሊ ባዋ።<verse eid="1CO 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 7:20"/>አሳይ ሁጲያን ሁጲያን ጾሳይ ባረና ጼስያ ዎደ ደእያዋዳን ደኦ። <verse eid="1CO 7:20"/><verse number="21" style="v" sid="1CO 7:21"/>ጾሳይ ኔና ጼስያ ዎደ ኔን አይለ? አይነ ባዋ፤ ሽን ኔን አይለተፐ ከሳናዉ ዳንዳዮፐ ከሳ። <verse eid="1CO 7:21"/><verse number="22" style="v" sid="1CO 7:22"/>አያዉ ጎፐ፥ አይለ ግድ ኡቴዳ አሳ ጎዳይ ጼሶፐ፥ እ ጎዳይ አይለተፐ ከሴዳ አሳ። ሀዋዳንካ፥ አይለ ግደና አሳ ክርስቶስ ጼሶፐ፥ እ ክርስቶሳ አይለ። <verse eid="1CO 7:22"/><verse number="23" style="v" sid="1CO 7:23"/>ጾሳይ ህንተንታ ጋትያን ሻሜዳ። አሳ አይለ ግዶፕተ። <verse eid="1CO 7:23"/><verse number="24" style="v" sid="1CO 7:24"/>ታናዳን አማንያዋንቶ፥ አሳይ ሁጲያን ሁጲያን ጾሳይ አ ጼስያ ዎደ ደእያ ደኡዋዳን፥ ጾሳና ደኦ።<verse eid="1CO 7:24"/></para>
  <para style="s1">ገለት አከትቤናዋንቱባነ አምኤቱዋባዉ ኦሸቴዳ ኦሻ</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25"/>ዎዶራቶ ጎዳይ ታና አዛዜዳባይ ባዋ። ሽን ታን ጎዳዉ አማነቴዳዋ ግዴዳ ድራዉ፥ አፐ ማሮተ አኬዳዋዳን፥ ህንተንታ ዞራይ። <verse eid="1CO 7:25"/><verse number="26" style="v" sid="1CO 7:26"/>ስም ሀእ መቶ ታዉ ሀዌ ሎአ ማላቴ፤ አሳይ ሀዋዳን ሀኒደ ደኦፐ ሎአ። <verse eid="1CO 7:26"/><verse number="27" style="v" sid="1CO 7:27"/>ኔን ማቻቶ አካ ድጌዳዋ ግዶፐ፥ እዞ የዳናዉ ኮዮፓ። ማቻቶ አካቤናዋ ግዶፐ፥ አካናዉ ኮዮፓ። <verse eid="1CO 7:27"/><verse number="28" style="v" sid="1CO 7:28"/>ሽን ኔን ማቻቶ አኮፐ፥ ናጋራ ኦበይካ። ወዶራታካ አስና ገሎፐ፥ ናጋራ ኦበይኩ። ሽን አከትያዋንቶነ ገለትያዋንቶ ኡንቱንቱ ደኡዋን ዎልቃማ መቱ ደኤ። ታን ህንተንታ ሄ መቱዋፐ አሻናዉ ኮያይ።<verse eid="1CO 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29"/>ሽን ታናዳን አማንያዋንቶ፥ ታን ግያዌ ሀዋ፤ ዎዲ ዉሬዳ። ሀዋፐ ስንዉ አኬዳ አሳቱ፥ አክቤና አሳዳን ሀንኖ። <verse eid="1CO 7:29"/><verse number="30" style="v" sid="1CO 7:30"/>ዬክያዋንቱ ዬከናዋዳን፥ ናሸትያዋንቱ ናሸተናዋዳን፥ ሻምያዋንቱካ ሻሚደ አይነ ባይናዋዳን፥ <verse eid="1CO 7:30"/><verse number="31" style="v" sid="1CO 7:31"/>ሀ አላምያ ደኡዋን ማደትያዋንቱ ኡባካ ማደተናዋዳን ሀንኖ። አያዉ ጎፐ፥ ሀ አላምያ ደኡ አትያዋ።<verse eid="1CO 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32"/>ህንተንቱ ህርገናን ደአናዋ ታን ዶሳይ። አክቤናዌ ጎዳ ናሸቻናዉ ኮይያ ድራዉ፥ አ ኦሱዋባ ቆፔ። <verse eid="1CO 7:32"/><verse number="33" style="v" sid="1CO 7:33"/>ሽን አኬዳዌ ባረ ማቻቶ ናሸቻናዉ ኮይያ ድራዉ፥ ሳኣባ ቆፔ። <verse eid="1CO 7:33"/><verse number="34" style="v" sid="1CO 7:34"/>አ ቆፋይ ሻከቴዳ። አስና ገላቤና ወዶራታ ባረ አሹዋንነ ባረ ሸምፑዋን ጌያናዉ ኮይያ ድራዉ፥ ጎዳ ኦሱዋባ ቆፓዉ። ሽን አስና ገሌዳዉና ባረ አስና ናሸቻናዉ ኮይያ ድራዉ፥ ሳኣባ ቆፓዉ።<verse eid="1CO 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35"/>ታን ሀዋ ህንተንታ ማዳና ማላ ጋይፐ አትን፥ ህንተንታ ባናዉ ጊከ። ሽን ህንተ በስያዋዳን ደኢደ፥ ጎዳ ኦሱዋ ህንተና እሚደ ኦና ማላ ኮያይ።<verse eid="1CO 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36"/>ኦንነ ባረ ጊግሴዳ ዎዶራቶ አክያ ዎዲ ጋክና፥ ባረና ናጋናዉ አዉ ዳንዳየተናን እጾፐ፥ እዞ አኮ። እ እዞ አኮፐ፥ ሄዋን ናጋራይ ባዋ። <verse eid="1CO 7:36"/><verse number="37" style="v" sid="1CO 7:37"/>ሽን እ ባረ ዎዛናን ምኖፐ፥ አከናን ጋምአና ዳንዳዬ። ቃይ ባረና ናጊደ፥ ባረ ጊግሴዳ ዎዶራቶ አከናን ጋምአና ጎፐ፥ ኦንነ ዎልቃንናን ባረ ዎዛናን ቆፋ ቃቼዳዋ ግዶፐ ሎይዳ። <verse eid="1CO 7:37"/><verse number="38" style="v" sid="1CO 7:38"/>ሄዋ ድራዉ፥ ዎዶራቶ አክያ ኡራይ ሎይዳ፤ ቃይ አከናዌ ኡባ አ ሎይዳ።<verse eid="1CO 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39"/>አስና ገሌዳ ምሽራታ ባረ አስናይ ደኤዳ ኬናን አናና እትፐ ደአናዳን ቃሸታ ኡታዱ። ሽን እ ሀይቆፐ፥ ጎዳ አማንያ አሳ ኦናነ ግዶፐ፥ ባረ ዶሴዳ አስና ገላናዉ ዳንዳያዉ። <verse eid="1CO 7:39"/><verse number="40" style="v" sid="1CO 7:40"/>ታ ቆፋ ግዶፐ፥ ገለናን ደአንቶ፥ እዛ ናሸቻን ደአና። ቃይ ታናን ጾሳ አያናይ ደእያዋ ታን ኤራይ።<verse eid="1CO 7:40"/></para>
  <chapter eid="1CO 7"/>
  <chapter number="8" style="c" sid="1CO 8"/>
  <para style="s1">ኤቃዉ ያርሸቴዳ ቁማባ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1"/>ኤቃዉ ያርሼዳ ቁማባ ግዶፐ፥ ኑን ኡባይካ ኤሬቶ። ኤራይ ኦቶርሴ፤ ሽን ሲቁ አማኑዋን ድቼ። <verse eid="1CO 8:1"/><verse number="2" style="v" sid="1CO 8:2"/>ኦንነ ባረዉ እትባ ኤርያዋ ማላቶፐ፥ እ ብሮ ኤራናዉ በስያዋ ኤርቤና። <verse eid="1CO 8:2"/><verse number="3" style="v" sid="1CO 8:3"/>ሽን ኦንነ ጾሳ ሲቆፐ፥ ጾሳይ አ ኤሬ።<verse eid="1CO 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4"/>ሄዋ ድራዉ፥ ኤቃዉ ያርሼዳ ቁማ ሙሳባ ግዶፐ፥ ኤቃ ኡባይ አላምያን አያነ ግደናዋነ፥ እት ጾሳፐ አትን፥ ሀራይ ባይናዋ ኑን ኤሬቶ። <verse eid="1CO 8:4"/><verse number="5" style="v" sid="1CO 8:5"/>አያዉ ጎፐ፥ ጮራ ጾሳቱነ ጮራ ጎዳቱ ደኢኖ። ሽን ሀራይ አቶ፥ ሳሉዋን ግድና ሳኣን ግድና፥ ጾሳቱዋ ጌተትያዋንቱ ደኦፐካ፥ <verse eid="1CO 8:5"/><verse number="6" style="v" sid="1CO 8:6"/>ኡባባ መዳዌ ኑን አዉ ደእያዌ፥ እት ጾሳይ፥ አዉ፥ ኑዉ ደኤ። ቃይ ኡባባይ አን መቴዳዌነ ኑን አን ደእያዌ እት ጎዳይ፥ የሱስ ክርስቶስካ ኑዉ ደኤ።<verse eid="1CO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7"/>ሽን ሀ ኤራይ አሳ ኡባዉ ደኤና። እት እት አሳቱ ኤቃ ዶዬዳ ድራዉ፥ ሀእ ጋካናዉካ፥ “ኤቃዉ ያርሼዳ ቁማ” ያጊደ ሚኖ። ቃይ ኡንቱንቱ ዎዛናይ ሹጋ ግዴዳዋን፥ ኡንቱንቶ ሀ ቁማን ቱኔዳዋ ማላቴ። <verse eid="1CO 8:7"/><verse number="8" style="v" sid="1CO 8:8"/>ሽን ቁማይ ኑና ጾሳኮ ሺቃናዳን ማደና። ኑን ማና ይንቶካ ኑዉ አይነ ፓጨና፤ ሞፐነ ኑዉ አይነ ጉጀተና።<verse eid="1CO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9"/>ሽን ሀዌ ህንተ ህንተ ዶሶዋዳን ሀንያዌ ሹጎ አማኑዋና ደእያዋንታ ናጋራን የገና ማላ ናገትተ። <verse eid="1CO 8:9"/><verse number="10" style="v" sid="1CO 8:10"/>አያዉ ጎፐ፥ ኔን ኤራንቻይ ኤቃዉ ያርሼዳ ቁማ ማናዉ ኤቃ ጎልያን ኡቴዳ ዎደ፥ ሹጎ አማኑዋና ደእያ እት አሳይ ኔና በኦፐ፥ ኤቃዉ ያርሼዳ ቁማ እ ማናዉ አ ዎዛናይ ቆፐኔዬ? <verse eid="1CO 8:10"/><verse number="11" style="v" sid="1CO 8:11"/>ሄዋ ግዶፐ ሀ ሹጎ አማኑዋና ደእያ ነ እሻይ፥ ክርስቶስ አ ድራዉ ሀይቄዳዌ፥ ነ ኤራን ባዬ። <verse eid="1CO 8:11"/><verse number="12" style="v" sid="1CO 8:12"/>ሀዋዳንካ፥ ህንተ ህንተ እሻቱዋ ናቂያዋንነ ኡንቱንቱ ሹጎ ዎዛና ማይያዋን ክርስቶሳ ናቂታ። <verse eid="1CO 8:12"/><verse number="13" style="v" sid="1CO 8:13"/>ሄዋ ድራዉ፥ ቁማይ አማንያ ታ እሻ ቢያዋ ግዶፐ፥ አ በና ማላ፥ ታ ደእያ ላይን ሙለካ አሹዋ ሚከ።<verse eid="1CO 8:13"/></para>
  <chapter eid="1CO 8"/>
  <chapter number="9" style="c" sid="1CO 9"/>
  <para style="s1">የሱስ ኪቴዳዋንቶ ደእያ ማታነ ኡንቱንቱ ኦናዉ በስያባ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1"/>ታን አይለተይ ባይና አሳ ግድክታ? የሱስ ኪቴዳዋ ግድክታ? ኑ ጎዳ የሱስ ክርስቶሳ በአበይክታ? ህንተንቱ ታን ጎዳዉ ኦዳ ታ ኦሱዋፐ ቤቴዳዋንታ ግድክቴዬ? <verse eid="1CO 9:1"/><verse number="2" style="v" sid="1CO 9:2"/>ታን ሀራንቶ የሱስ ኪቴዳዋ ግዳና ዮፐካ፥ ህንተንቶ የሱስ ኪቴዳዋ ግድያዌ ኤረቴዳዋ፤ አያዉ ጎፐ፥ ታን ጎዳን የሱስ ኪቴዳዋ ግድያዎ ህንተ ማርካ።<verse eid="1CO 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3"/>ታና ቦርያዋንቶ ታን እምያ ዛሩ ሀዋ። <verse eid="1CO 9:3"/><verse number="4" style="v" sid="1CO 9:4"/>ማናዉነ ኡሻናዉ ኑዉ ማት ባዌ? <verse eid="1CO 9:4"/><verse number="5" style="v" sid="1CO 9:5"/>የሱስ ኪቴዳ ሀራቱዋዳንነ ጎዳ እሻቱዋዳን፥ ጰጽሮሳዋዳን፥ ኤኖ ግያ ማቻቶ እትፐ አኪደ ባናዉ ኑዉ ማታይ ባዌ? <verse eid="1CO 9:5"/><verse number="6" style="v" sid="1CO 9:6"/>ዎይ ኑ ደኦ ኦደ ባጸታናዉ በስያዌ ታናነ ባርናባሳ ጻላሌ? <verse eid="1CO 9:6"/><verse number="7" style="v" sid="1CO 9:7"/>አይ ዎደነ ባረ ሚሻ ሚደ፥ ዎታዳራተ ኦያዌ ኦኔ? ዎይ ዎይንያ ቱራ ቶኪደ፥ አ አይፍያ ሜናዌ ኦኔ? ዎይ ሚዛ ዉድያ ሄሚደ፥ ሄ ሚዛ ዉድያፐ ማ ኡሸናዌ ኦኔ?<verse eid="1CO 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8"/>ታን ሀዋ አሳ ቆፋ ጻላላን ጋይታ? ዎይ ህጊ ቃይ ሀዋ ጌኔ? <verse eid="1CO 9:8"/><verse number="9" style="v" sid="1CO 9:9"/>አያዉ ጎፐ፥ ሙሴ ህግያን፥ “ካ የያ መህያ ዶና ቃቾፓ” ጌተቲደ ጻፈቴዳ። ጾሳይ መህያባ ቆፒደ ሀዋ ጊ?<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="DEU 25:4">ዛረ. 25:4</ref>፤ <ref loc="1TI 5:18">1 ጽሞ. 5:18</ref></char></note> <verse eid="1CO 9:9"/><verse number="10" style="v" sid="1CO 9:10"/>ዎይ እ ሄዋ ግያዌ ሙለካ ኑ ድራሳ ግደኔ? ቱማካ ኑ ድራዉ ጻፈቴዳ፤ ጎሽያ ብታኒካ ካ ቡክያ ብታኒካ፥ “ታና ጋክያዋ አካና” ያጊደ ኦናዉ በሴ። <verse eid="1CO 9:10"/><verse number="11" style="v" sid="1CO 9:11"/>ኑን ህንተ ግዶን አያና የዉዋ ዘሬዳዋንታ ግዲደ፥ ኑ አሾ ማዶ ግድያዋ ህንተንቱፐ ጫኮፐ ዳሮቤ? <verse eid="1CO 9:11"/><verse number="12" style="v" sid="1CO 9:12"/>ሀራቱ ሄዋ ህንተንቱፐ አካናዉ ኡንቱንቶ ማታይ ደኦፐ፥ ኑዉ ኡንቱንቱዋፐ አያ ማታይ ባዌ?</para>
  <para style="p" vid="1CO 9:12">ሽን ኑን ክርስቶሳ ምሽራቹዋ ቃላዉ ቦ ግደናዳን፥ ኡባባ ገንጭያዋፐ አትን፥ ሄ ማታን ጎኤትበይኮ። <verse eid="1CO 9:12"/><verse number="13" style="v" sid="1CO 9:13"/>ጌሻ ጎልያን ኦያ አሳቱ ባረንቱ ቁማ ጌሻ ጎልያፐ አክያዋ ኤርክቴ? ቃይ ያርሽያሳን ኦያዋንቱ ያርሹዋፐ አክያዋ ኤርክቴ?<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="DEU 18:1">ዛረ. 18:1</ref></char></note> <verse eid="1CO 9:13"/><verse number="14" style="v" sid="1CO 9:14"/>ሀዋዳንካ፥ ቃይ ምሽራቹዋ ቃላ ኦድያዋንቱ ባረንቱ ደኦ ኮሽያባ አፐ ደማናዳን፥ ጎዳይ አዛዜዳ።<verse eid="1CO 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15"/>ሽን ታን ሀ ማታ ኡባን አይነ ጎኤታበይከ። ታን ሀዋ ጻፌዳዌ ሄዋ ማላ ማታይ ታዉ ደአናዉ በሴ ያግያዋና ግደና። አያዉ ጎፐ፥ ታ ጬቁዋ ኦንነ መላ ከስያዋፐ ሀይቂያዌ ታዉ ሎአ። <verse eid="1CO 9:15"/><verse number="16" style="v" sid="1CO 9:16"/>ምሽራቹዋ ቃላ ኦዳናዉ ታን አዛዘታ ኡቴዳ ድራዉ፥ አ ኦዶፐካ ታዉ ጬቀትያባይ ባዋ። ምሽራቹዋ ቃላ ኦደናን አጎፐ፥ ታዉ አየሮ። <verse eid="1CO 9:16"/><verse number="17" style="v" sid="1CO 9:17"/>አያዉ ጎፐ፥ ታን ሀዋ ዶሳደ ኦፐ፥ ታዉ ዎይታይ ደኤ። ሽን ታን ዶሰናን እጾፐካ፥ ምሽራቹዋ ቃላ ድራዉ ሀዳራ ጾሳይ ታዉ እሜዳ። <verse eid="1CO 9:17"/><verse number="18" style="v" sid="1CO 9:18"/>ያትና፥ ታ ዎይታይ አዬ? ምሽራቹዋ ቃላ ኦዳደ፥ ታዉ ዎንጋላን ደእያ ኩመን ማታን ጎኤተናን፥ ምሽራቹዋ ቃላ ጮ ኦድያዋ።<verse eid="1CO 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19"/>ታን ኦስነ አይለ ግድከ ሽን፥ ጮራቱዋ ዛራናዉ ታና ኡባዉ አይለ ከሳድ። <verse eid="1CO 9:19"/><verse number="20" style="v" sid="1CO 9:20"/>ታን አይሁዳቱዋ ዛራናዉ ኡንቱንቱና ኡንቱንታ ግዳደ ደኣድ። ታ ሁጰዉ ህግያፐ ጋርሳና ደእከ። ሽን ህግያፐ ጋርሳና ደእያዋንታ ዛራናዉ ህግያፐ ጋርሳና ደእያ አሳ ማላ ግዳድ። <verse eid="1CO 9:20"/><verse number="21" style="v" sid="1CO 9:21"/>ታን ህጊ ባይና አሳቱዋና ደኣደ፥ ህጊ ባይና አሳዳን ሀናድ። ጾሳ ህጊ ይና ግደና። ሽን ህጊ ባይናዋንታ ዛራናዉ፥ ክርስቶሳ ህግያፐ ጋርሳና ደኣድ። <verse eid="1CO 9:21"/><verse number="22" style="v" sid="1CO 9:22"/>ታን አማኑዋን ዳቡርያዋንታ ዛራናዉ፥ ኡንቱንቱ ማላ ግዳድ። ታን አይ ኦግያንነ አማሬዳ አሳቱዋ አሻናዉ፥ ኡባ አሳቱዋና ኡባባን ኡንቱንቱ ማላ ግዳድ። <verse eid="1CO 9:22"/><verse number="23" style="v" sid="1CO 9:23"/>ታን ምሽራቹዋ ቃላ አንጁዋ ሻካናዉ፥ ምሽራቹዋ ቃላ ድራዉ፥ ኡባባ ኦይ።<verse eid="1CO 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24"/>ዎን ጾናና ጊደ ዎጽያ ኡባይ እትፐ ዎጼ። ሽን እቱዋ ጻላላይ ዎይታ አክያዋ ኤርክቴ? ሀዋዳን ህንተንቱካ ዎይታ አካናዉ ዎጽተ። <verse eid="1CO 9:24"/><verse number="25" style="v" sid="1CO 9:25"/>ካሳዉ ባረና ጊግስያ ኦንነ ኡባባን ባረና ናጌ። አሳይ ሄዋ ዳቡርያዌ ጾኔዳዎ እመትያ ባይያ ካላቻ ደማናሳ። ሽን ኑን ዳቡርያዌ መናዉ ደእያዋነ ባየና ካላቻ ደማናሳ። <verse eid="1CO 9:25"/><verse number="26" style="v" sid="1CO 9:26"/>ሄዋ ድራዉ፥ ታን ቆፍ ባይናን ዎጽያዋዳን ዎጽከ። ጫርኩዋ ይምፕያ አሳዳንካ ጮ ኦለትከ። <verse eid="1CO 9:26"/><verse number="27" style="v" sid="1CO 9:27"/>ሽን ታን ሀራንቶ ኦዴዳዋፐ ጉይያን፥ ታ ሁጰዉ ዎይታፐ አተና ማላ፥ ታ አሳተ ናገታናዳን ኦይ።<verse eid="1CO 9:27"/></para>
  <chapter eid="1CO 9"/>
  <chapter number="10" style="c" sid="1CO 10"/>
  <para style="s1">ኤቃዉ ጎይናናዉ በሰና</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1"/>ሄዋ ቦላን ታናዳን አማንያዋንቶ፥ ታን ህንተ ሀዋ ኤራና ማላ ኮያይ። ኑ አዎቱ ኡባይ ሻርያፐ ጋርሳና ደኤድኖ፤ ኡባይካ አባ ግዶና ፕኔድኖ።<note caller="-" style="x"><char style="xo" closed="false">10:1 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">ከሳ 13:21-22</ref>፤ <ref loc="EXO 14:22-29">14:22-29</ref></char></note> <verse eid="1CO 10:1"/><verse number="2" style="v" sid="1CO 10:2"/>ኡንቱንቱ ኡባይ ሙሴና እትፐ ግዳናዉ፥ ሻርያንነ አባን ጻማቀቴድኖ። <verse eid="1CO 10:2"/><verse number="3" style="v" sid="1CO 10:3"/>ኡንቱንቱ ኡባይ ሄ እት አያና ቁማ ሜድኖ።<note caller="-" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="EXO 16:35">ከሳ 16:35</ref></char></note> <verse eid="1CO 10:3"/><verse number="4" style="v" sid="1CO 10:4"/>ቃይ ኡባይካ ሄ እት አያና ኡሻ ኡሼድኖ። አያዉ ጎፐ፥ ኡንቱንቱ ባረንታ ካለያ አያና ዛላፐ ፑልቶዋ ኡሼድኖ፤ ሄ ዛላይካ ክርስቶሳ።<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="EXO 17:6">ከሳ 17:6</ref>፤ <ref loc="NUM 20:11">ፓይ. 20:11</ref></char></note> <verse eid="1CO 10:4"/><verse number="5" style="v" sid="1CO 10:5"/>ሽን ጾሳይ ኡንቱንቱፐ ዳርያ ባጋቱዋን ናሸትቤና ድራዉ፥ ኡንቱንቱ አሃይ አሳይ ባይና ሳን ላለቴዳ።<note caller="-" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="NUM 14:29-30">ፓይ. 14:29-30</ref></char></note><verse eid="1CO 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6"/>ኡንቱንቱ ኢታባ አሞቴዳዋዳን፥ ኑ ዎዛናይ ቃይ ኢታባ አሙዋፐ ናገታናዳን፥ ሄዌ ኡባይ ኑዉ ትምርተ ግዴዳ።<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="NUM 11:4">ፓይ. 11:4</ref></char></note> <verse eid="1CO 10:6"/><verse number="7" style="v" sid="1CO 10:7"/>ጾሳ ማጻፋይ፥ “አሳይ ማናዉነ ኡሻናዉ ኡቴድኖ፤ ቃይ ዱሮ ደንድ ኤቄድኖ” ያግያዋዳን፥ ኡንቱንቱፐ እቱ እቱ ኤቃዉ ጎይኔዳዋዳን፥ ህንተ ጎይኖፕተ።<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="EXO 32:6">ከሳ 32:6</ref></char></note> <verse eid="1CO 10:7"/><verse number="8" style="v" sid="1CO 10:8"/>ኡንቱንቱፐ እቱ እቱ ዎሹሜዳዋዳን፥ ኑን ዎሹማናዉ በሰና። ሄዋ ጋሱዋን ኡንቱንቱፐ እት ጋላስ ላታማነ ሄዙ ሻአይ ሀይቄዳ።<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="NUM 25:1-18">ፓይ. 25:1-18</ref></char></note> <verse eid="1CO 10:8"/><verse number="9" style="v" sid="1CO 10:9"/>ኡንቱንቱፐ እቱ እቱ ጎዳ ፓጪደ፥ ሾሻን ዱከት ሀይቄዳዋዳን፥ ኑን ጎዳ ፓጫናዉ በሰና። <verse eid="1CO 10:9"/><verse number="10" style="v" sid="1CO 10:10"/>ኡንቱንቱፐ እቱ እቱ ዙዙምና፥ ዎያ ኪታንቻን ኡንቱንታ ይሴዳዋዳን ዙዙሞፕተ።<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="NUM 16:41-49">ፓይ. 16:41-49</ref></char></note><verse eid="1CO 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11"/>ሀዌ ኡባይ ሀራቶ ትምርተ ግዳናዳን ኡንቱንቱ ቦላ ጋኬዳ። ቃይ ኑና ዎድያ ዉርሰይ ጋካና ማቴዳዋንታ ሴራናዉ ጻፈቴዳ።<verse eid="1CO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12"/>ሄዋ ድራዉ፥ ምና ኤቃድ ጊደ ቆፕያ ኡራይ ኦንነ ኩንደናዳን፥ ባረና ናጎ። <verse eid="1CO 10:12"/><verse number="13" style="v" sid="1CO 10:13"/>ህንተንታ ጋክያ ፓጪ፥ አሳ ኡባ ጋክያ ፓጭያ ማላፐ አትን፥ አይነ ዱማተና። ህንተንቱ ዎልቃይ ዳንዳይያዋፐ አያ ፓጭያን ህንተ ፓጨታናዉ ኮየና ጾሳይ አማነቴዳዋ። ሽን ህንተንታ ፓጪ ጋክያ ዎደ፥ ሄ ፓጭያ እ ህንተንታ ዳንዳይሳና። ቃይ ሄ ፓጭያፐ ህንተንቱ ከስያ ኦግያካ እ እማና።<verse eid="1CO 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14"/>ሄዋ ድራዉ፥ ታ ዶስያዋንቶ፥ ኤቃዉ ጎይኖፕተ። <verse eid="1CO 10:14"/><verse number="15" style="v" sid="1CO 10:15"/>ህንተንቱ ዎዛናማ አሳ ግዴዳ ድራዉ፥ ታን ህንተንቶ ኦዳይ። ታን ግያዋ ህንተ ፕርድተ። <verse eid="1CO 10:15"/><verse number="16" style="v" sid="1CO 10:16"/>ኑን ጾሳ ጋላቲደ ሻክያ አንጁዋ ጹአይ ክርስቶሳ ሱና እትፐተይ ደእያዋ ግደኔ? ቃይ ኑን መንያ ኡክይ ክርስቶሳ አሹዋና እትፐተይ ደእያዋ ግደኔ? <verse eid="1CO 10:16"/><verse number="17" style="v" sid="1CO 10:17"/>እት ኡክይ ደእያ ድራዉ፥ ኑን ጮራ ግዶፐካ፥ እት አሳተ። አያዉ ጎፐ፥ ኑን ኡባይካ ሄ እት ኡክ ሻከቴቶ።<verse eid="1CO 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18"/>እስራኤልያ አሳ ጼልተ። ያርሹዋ ምያዋንቱ ያርሽያሳና እትፐተይ ደእያዋንታ ግድክኖ?<note caller="-" style="x"><char style="xo" closed="false">10:18 </char><char style="xt" closed="false"><ref loc="LEV 7:6">ዎጋ 7:6</ref></char></note> <verse eid="1CO 10:18"/><verse number="19" style="v" sid="1CO 10:19"/>ስም ታን ዋጋይታ? ኤቃዉ ያርሸቴዳ ቁማይ ማዲ ዎይ ኤቃይ ማዲ? <verse eid="1CO 10:19"/><verse number="20" style="v" sid="1CO 10:20"/>ማደና፤ ሽን ታን ግያዌ ጾሳ አማነና አሳቱ ኢታ አያናቶ ያርሽያዋፐ አትን፥ ጾሳዉ ያርሽክኖ። ኢታ አያናቱዋና ህንተ እትፐ ዙፐታና ማላ፥ ታን ኮይከ።<note caller="-" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="DEU 32:17">ዛረ. 32:17</ref></char></note> <verse eid="1CO 10:20"/><verse number="21" style="v" sid="1CO 10:21"/>ጎዳ ጹኣፐ ኡሺደ ቃይ ኢታ አያናቱዋ ጹኣፐ ኡሻናዉ ህንተ ዳንዳይክታ። ጎዳ ጋይታፐ ህንተ ግሸቲደ ቃይ ኢታ አያናቱዋ ጋይታፐ ማናዉ ዳንዳይክታ። <verse eid="1CO 10:21"/><verse number="22" style="v" sid="1CO 10:22"/>ሄዋ ኦደ ኑን ጎዳና ጺኖታናዉ ኮሺ? ኑን አፐ ምኔቶ?<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="DEU 32:21">ዛረ. 32:21</ref></char></note><verse eid="1CO 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23"/>ህንተፐ እቱ እቱ፥ “ኡባባ ኦናዉ ታና ድግያባይ ባዋ”፤ ሽን ኡባባይ ማደና። “ኡባባ ኦናዉ ድግያባይ ባዋ፤ ሽን ኡባባይ ጌሸና” ያጊኖ። <verse eid="1CO 10:23"/><verse number="24" style="v" sid="1CO 10:24"/>ኦንነ ሀራ አሳ ማድያባ ቆፖፐ አትን፥ ሀራይ አቶ እቱነ ባረና ማድያባ ቆፖፖ።<verse eid="1CO 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25"/>ገያን አጻረ ታራን ዛልኤትያ አሹዋ ህንተ ዎዛና ቆፋን፥ አይነ ስናን ሚተ። <verse eid="1CO 10:25"/><verse number="26" style="v" sid="1CO 10:26"/>አያዉ ጎፐ፥ አላሚነ አን ደእያባይ ኡባይ ጎዳባ።<note caller="-" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="PSA 24:1">ማዝ. 24:1</ref></char></note><verse eid="1CO 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27"/>እት አማነና አሳይ ህንተንታ እማ ኦ ሾባናዉ ጼስና ባናዉ ኮዮፐ፥ ህንተ ዎዛና ቆፋን፥ አይነ ስናን ህንተ ስን እ አያባ ኡባ ሚተ። <verse eid="1CO 10:27"/><verse number="28" style="v" sid="1CO 10:28"/>ሽን እት ኡራይ ህንተንቶ፥ “ሀዌ ኤቃዉ ያርሼዳዋ” ጎፐ፥ ሄ ህንተንቶ ኦዴዳ ብታንያ ድራዉነ ቃይ ህንተ ዎዛና ቆፋ ድራዉ፥ ሄ ቁማ ሞፕተ። <verse eid="1CO 10:28"/><verse number="29" style="v" sid="1CO 10:29"/>ታን ግያዌ ነ ዎዛና ቆፋ ድራሳ ግደና፤ ሽን የኮ ብታንያ ዎዛና ቆፋ ድራሳ።</para>
  <para style="p" vid="1CO 10:29">ታን ታ ሀናናዉ ዳንዳይያ ታ ሀኖታ ሀራ አሳ ዎዛናይ አያዉ ፕርዲ? <verse eid="1CO 10:29"/><verse number="30" style="v" sid="1CO 10:30"/>ታን ጾሳ ጋላታደ ቁማ ሞፐ፥ ጾሳ ጋላታደ ሜዳ ቁማዉ አያዉ ቦረታይታ?<verse eid="1CO 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31"/>ስም ህንተ አያነ ሞፐ፥ ዎይ አያነ ኡሾፐ፥ ዎይ ህንተ አያነ ኦፐ፥ ኡባባ ጾሳ ቦንቾ ኦተ። <verse eid="1CO 10:31"/><verse number="32" style="v" sid="1CO 10:32"/>ህንተንቱ አይሁዳ አሳቶ ዎይ ግሪከ አሳቶ ዎይ ጾሳ አማንያዋንቶ ቦ ግዶፕተ። <verse eid="1CO 10:32"/><verse number="33" style="v" sid="1CO 10:33"/>ታን ቃይ ጮራቱ አታና ማላ፥ ኡንቱንቱ ኡባ ማዳናዳንፐ አትን፥ ታ ሁጰዉ ማዱዋ ኮየናን፥ አሳ ኡባ ኡባባን ናሸችያዋዳን፥ ህንተንቱካ ሄዋዳ ኦተ።<verse eid="1CO 10:33"/></para>
  <chapter eid="1CO 10"/>
  <chapter number="11" style="c" sid="1CO 11"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1"/>ታን ክርስቶሳ ሌምሱዋ ካልያዋዳን፥ ህንተንቱካ ታዋ ካልተ።<verse eid="1CO 11:1"/></para>
  <para style="s1">አሳይ እትፐ ዎስያ ዎደ ደአናዉ በስያ ዎጋ</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2"/>ታናዳን አማንያዋንቶ፥ ህንተ ኡባባን ታና ሀሳይያ ድራዉነ፥ ዎጋ ታን ህንተንቶ እሜዳዋዳን፥ ህንተ ምንሲደ ናግያ ድራዉ፥ ህንተንታ ጋላታይ። <verse eid="1CO 11:2"/><verse number="3" style="v" sid="1CO 11:3"/>ሽን ክርስቶስ አቱማዋ ኡባዉ ሁጰ ግድያዋ፥ አቱማ አሳይ ማጫ አሳዉ ሁጰ ግድያዋነ ቃይ ጾሳይ ክርስቶሳዉ ሁጰ ግድያዋ ህንተ ኤራና ማላ ኮያይ። <verse eid="1CO 11:3"/><verse number="4" style="v" sid="1CO 11:4"/>ጾሳ ዎሲደ፥ ዎይ ትምቢትያ ኦዲደ፥ ባረ ሁጲያ ጎዝያ አቱማ አሳይ ኡባይ ክርስቶሳ ቶቼ። <verse eid="1CO 11:4"/><verse number="5" style="v" sid="1CO 11:5"/>ቃይ ጾሳ ዎሳደ ዎይ ትምቢትያ ኦዳደ፥ ባረ ሁጲያ ጎዘና ማጫዉና ባረ አስና ቶቻዉ፤ አያዉ ጎፐ፥ እዛ ባረ ሁጲያ ሜደታ ድጎንና እት ማላ።<verse eid="1CO 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 11:6"/>ማጫዉና ባረ ሁጲያ ጎዛና ዮፐ፥ ቃንጽሱ። ሽን እዛ ባረ ሁጲያ ቃንጽሳናዌ ዎይ ሜድሳናዌ ፖኮፐ፥ ባረ ሁጲያ ጎዙ። <verse eid="1CO 11:6"/><verse number="7" style="v" sid="1CO 11:7"/>አቱማዌ ጾሳ ሌምሱዋነ ቦንቹዋ ግድያ ድራዉ፥ ባረ ሁጲያ ጎዛናዉ በሰና፤ ሽን ማጫዉና አቱማዎ ቦንቾ።<note caller="-" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="GEN 1:26-27">ዶመ 1:26-27</ref></char></note> <verse eid="1CO 11:7"/><verse number="8" style="v" sid="1CO 11:8"/>አያዉ ጎፐ፥ ማጫዉና አቱማዋፐ ቤታዱፐ አትን፥ አቱማዌ ማጫዉንፐ ቤትቤና።<note caller="-" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="GEN 2:18-23">ዶመ 2:18-23</ref></char></note> <verse eid="1CO 11:8"/><verse number="9" style="v" sid="1CO 11:9"/>አያዉ ጎፐ፥ ማጫዉና አቱማዋ ድራዉ መታዱፐ አትን፥ አቱማዌ ማጫዉን ድራዉ መትቤና። <verse eid="1CO 11:9"/><verse number="10" style="v" sid="1CO 11:10"/>ሄዋ ድራዉ፥ ማጫዉና ባረ አስና አይሱዋፐ ጋርሳና ደእያዋ ኤርሳናዉነ ኪታንቻቱዋ ድራዉ፥ እዝ ሁጲያን ጎዝያባይ ደአናዉ በሴ።<verse eid="1CO 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 11:11"/>ሽን ጎዳን ማጫዉና አቱማዌ ባይናን ደኡኩ፤ አቱማዌካ ማጫዉና ባይናን ደኤና። <verse eid="1CO 11:11"/><verse number="12" style="v" sid="1CO 11:12"/>አያዉ ጎፐ፥ ማጫዉና አቱማዋፐ መቴዳዋዳን፥ ቃይ አቱማዌካ ማጫዉንፐ የለቴዳ። ቃይ ኡባባይካ ጾሳፐ ዬ።<verse eid="1CO 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13"/>ህንተንቱ ህንተ ሁጰዉ ፕርድተ። ማጫዉና ባረ ሁጲያ ጎዘናን ጾሳ ዎሳናዉ በሲ? <verse eid="1CO 11:13"/><verse number="14-15" style="v" sid="1CO 11:14-15"/>አቱማዌ ባረ ሁጲያ ድቾፐ፥ አዉ ፖኮ። ሽን ማጫዉና ባረ ሁጲያ ድቾፐ፥ እዝዉ ቦንቾ ግድያዋ ሀራይ አቶ፥ መተንቶነ ህንተንታ ታማርሰኔ? አያዉ ጎፐ፥ ማጫዉን ሁጲ እዞ ካማናዉ እዝዉ እመቴዳ። <verse eid="1CO 11:14-15"/><verse number="16" style="v" sid="1CO 11:16"/>ሽን ኦንነ ሀ የዉዋን ፓሉመታናዉ ኮዮፐ፥ ኑዉ ግድና ዎይ ጾሳ አማንያዋንቶ ግድናካ፥ ሀዋፐ ሀራ ዎጋይ ባዋ።<verse eid="1CO 11:16"/></para>
  <para style="s1">ጎዳ ካዉዋ አክያ ዎጋ</para>
  <para style="r">(<ref loc="MAT 26:26-29">ማቶሳ 26:26-29</ref>፤ <ref loc="MRK 14:22-25">ማር. 14:22-25</ref>፤ <ref loc="LUK 22:14-20">ሉቃሳ 22:14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17"/>ህንተ ሺቅያዌ ኢታባሳፐ አትን፥ ሎኦባሳ ግደና ድራዉ፥ ታን ሀ አዛዙዋ እማደ ህንተንታ ጋላትከ። <verse eid="1CO 11:17"/><verse number="18" style="v" sid="1CO 11:18"/>ሽን ህንተ ዎሳ ጎለን ሺቅያ ዎደ፥ ህንተ ግዶን ጳልቀይ ደእያዋ ታን ስሳይ። ቃይ ሄዌ እት ባጋና ቱማ ግድያዋ አማናይ። <verse eid="1CO 11:18"/><verse number="19" style="v" sid="1CO 11:19"/>አያዉ ጎፐ፥ ህንተ ማታን አማነቴዳዋንቱ ቆንጭ ኤረታና ማላ፥ ህንተ ግዶንካ ቃይ ሻኩ ደአናዉ በሴ። <verse eid="1CO 11:19"/><verse number="20" style="v" sid="1CO 11:20"/>ሄዋ ድራዉ፥ ህንተ እትፐ ሺቅያ ዎደ፥ ህንተ ሺቁ ጎዳ ካዉዋ ማናሳ ግደና። <verse eid="1CO 11:20"/><verse number="21" style="v" sid="1CO 11:21"/>አያዉ ጎፐ፥ ህንተ ቁማ ምያ ዎደ፥ ኡባይ ሁጲያን ሁጲያን ባረዋ ባረዋ ምያ ድራዉ፥ እቱ ኮሻቴ፤ እቱ ቃይ ማቴ። <verse eid="1CO 11:21"/><verse number="22" style="v" sid="1CO 11:22"/>ማናዉነ ኡሻናዉ ህንተንቶ ጎሊ ባዌ? ዎይ ጾሳ ዎሳ ጎልያ ካቴ? ቃይ አይነ ባይናዋንታ ዬላዪቴ? ታን ህንተንታ ዋጎ? ሀ የዉዋን ታን ህንተንታ ጋላቶ? ጋላትከ።<verse eid="1CO 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23"/>አያዉ ጎፐ፥ ታን ቃይ ህንተንቶ እሜዳ ትምርትያ ጎዳፐ አካድ። ጎዳ የሱስ ኡንቱንቱ አ አደ እሜዳ ቃማ ዳቡዋ አኪደ፥<note caller="-" style="x"><char style="xo" closed="false">11:23-24 </char><char style="xt" closed="false"><ref loc="MAT 26:26-28">ማቶሳ 26:26-28</ref>፤ <ref loc="MRK 14:22-24">ማር. 14:22-24</ref>፤ <ref loc="LUK 22:19">ሉቃሳ 22:19</ref>፣ <ref loc="LUK 22:20">20</ref></char></note> <verse eid="1CO 11:23"/><verse number="24" style="v" sid="1CO 11:24"/>ጾሳ ጋላቴዳ፤ ዳቡዋ መንደ፥ “ሄይተ፤ ሚተ። ሀዌ ህንተ ግሻታዉ ባረና እሜዳ ታ አሹዋ። ሀዋን ታና ቆፕተ” ያጌዳ። <verse eid="1CO 11:24"/><verse number="25" style="v" sid="1CO 11:25"/>ሀዋዳንካ፥ ካዉዋ ሚደ ስምና፥ ጹኣ ቃይ አኪደ፥ “ሀዌ ጹአይ ታ ሱን ታን ጫቄዳ ኦራ ጫቁዋ። ህንተንቱ አፐ ኡሼዳ ዎደ ኡባን ሄዋን ታና ቆፕተ” ያጌዳ።<note caller="-" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">ከሳ 24:6-8</ref>፤ <ref loc="JER 31:31-34">ኤር. 31:31-34</ref></char></note> <verse eid="1CO 11:25"/><verse number="26" style="v" sid="1CO 11:26"/>አያዉ ጎፐ፥ ህንተ ሀ ዳቡዋ ሜዳ ዎደ ኡባንነ ሀ ጹኣፐ ኡሼዳ ዎደ ኡባን ጎዳይ ያና ጋካናዉካ፥ አ ሀይቁዋ ኦዲታ።<verse eid="1CO 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27"/>ሄዋ ድራዉ፥ በሰናን ደኢደ ጎዳ ዳቡዋ ምያዌ፥ ዎይ ጎዳ ጹኣፐ ኡሽያዌ ኦንነ አ አሹዋነ አ ሱ አጮቴ። <verse eid="1CO 11:27"/><verse number="28" style="v" sid="1CO 11:28"/>ሽን አሳይ ባረ ሁጲያ ፓጮ። ያቲደ ዳቡዋ ሞ። ጹኣፐካ ኡሾ። <verse eid="1CO 11:28"/><verse number="29" style="v" sid="1CO 11:29"/>አያዉ ጎፐ፥ ጎዳ አሹዋ ሻኪደ ኤረናን ዳቡዋ ምያዌነ ጹኣፐካ ኡሽያዌ ባረ ሁጰዋ ፕርዳ ሜኔ ኡሼ። <verse eid="1CO 11:29"/><verse number="30" style="v" sid="1CO 11:30"/>ሄዋ ድራዉ፥ ህንተ ግዶን ጮራቱ ዳቡራንቻነ ሀርጋንቻ ግዴድኖ፤ ቃይ ኡንደኔዳዋንቱ ሀይቄድኖ። <verse eid="1CO 11:30"/><verse number="31" style="v" sid="1CO 11:31"/>ሽን ኑን ኑ ሁጲያ ቱሙ ፓጬደንቶ፥ ጾሳይ ኑና ፕርደና። <verse eid="1CO 11:31"/><verse number="32" style="v" sid="1CO 11:32"/>ኑን ፕርደትያ ዎደ፥ ሀ አላምያና እትፐ ፕርደተና ማላ፥ ጎዳይ ኑና ሴሬ።<verse eid="1CO 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33"/>ሄዋ ድራዉ፥ ታናዳን አማንያዋንቶ፥ ጎዳ ካዉዋ ማናዉ ህንተ ሺቅያ ዎደ፥ እቱ እቱዋ ናግተ። <verse eid="1CO 11:33"/><verse number="34" style="v" sid="1CO 11:34"/>ኦንነ ኮሻቴዳዋ ግዶፐ፥ እትፐ ሺቅያ ዎደ ጾሳ ፕርዳን ህንተ ገለና ማላ፥ ባረ ሶይን ሞ።</para>
  <para style="p" vid="1CO 11:34">አቴዳዋ ታን ያ ባደ ጊግሳና።<verse eid="1CO 11:34"/></para>
  <chapter eid="1CO 11"/>
  <chapter number="12" style="c" sid="1CO 12"/>
  <para style="s1">ጌሻ አያና እሞታቱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1"/>ታናዳን አማንያዋንቶ፥ ጌሻ አያና እሞታባ ህንተ ኤራናዉ ኮያይ። <verse eid="1CO 12:1"/><verse number="2" style="v" sid="1CO 12:2"/>ህንተንቱ ጾሳ አማነና ዎደ፥ ኡባ ዎደ ካልያዋዳንካ፥ ሃሳየና ኤቃቱዋኮ ህንተ ቤዳዋ ኤሪታ። <verse eid="1CO 12:2"/><verse number="3" style="v" sid="1CO 12:3"/>ሄዋ ድራዉ፥ ጾሳ አያናይ ካለያ አሳይ ኦንነ፥ “የሱስ ሸቀቶ” ያጊደ ሃሳየናዋነ ቃይ ጌሻ አያናይ ካለፐፐ አትን፥ ሀራይ አቶ እት አሳይነ፥ “የሱስ ጎዳ” ጋናዉ ዳንዳየናዋ ታን ህንተንታ ኤርሳይ።<verse eid="1CO 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4"/>አያና እሞታይ ዱማ ዱማ፤ ሽን እምያ አያናይ እቱዋ።<note caller="-" style="x"><char style="xo" closed="false">12:4-11 </char><char style="xt" closed="false"><ref loc="ROM 12:6-8">ሮመ 12:6-8</ref></char></note> <verse eid="1CO 12:4"/><verse number="5" style="v" sid="1CO 12:5"/>ቃይ ኦያ ኦሱ ዱማ ዱማ፤ ሽን ጎዳይ እቱዋ። <verse eid="1CO 12:5"/><verse number="6" style="v" sid="1CO 12:6"/>ኦሱዋ ኦናዉ ዱማ ዱማ ኦጊ ደእሽን፥ ሄ ኦያ ኦግያ ኡባ አሳ ኡባዉ ቆንጭስያ ጾሳይ እቱዋ። <verse eid="1CO 12:6"/><verse number="7" style="v" sid="1CO 12:7"/>ሽን አሳ ኡባ ማዳናዉ፥ ጌሻ አያና ቆንጭስያ ዎልቃይ ኡባዉ ሁጲያን ሁጲያን እመቴዳ።<verse eid="1CO 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 12:8"/>አያዉ ጎፐ፥ ጌሻ አያናይ እቶ አ ኤራተ ሃሳያ እሜዳ፤ ቃይ እቶ ኤራተ ሃሳያ እሜዳ። <verse eid="1CO 12:8"/><verse number="9" style="v" sid="1CO 12:9"/>ሄ ጌሻ አያናይ እቶ አማኑዋ እሚደ፥ የኮ ሀርጋንቻ ፓያ ዎልቃ እሜዳ። <verse eid="1CO 12:9"/><verse number="10" style="v" sid="1CO 12:10"/>ጌሻ አያናይ እቶ ማላታ ኦያ ዎልቃ እሚደ፥ እቶ ትምቢትያ ኦድያ ዎልቃ እሜዳ። እቶ አያናቱዋ ግዱዋን ደእያ ዱማተ ኤርያ ዎልቃ እሚደ፥ እቶ ዱማ ዱማ ቃላን ሃሳይያ ዎልቃ እሜዳ። ቃይ እቶ ዱማ ዱማ ቃላን ሃሳዬዳዋ ብልያ ዎልቃ እሜዳ <verse eid="1CO 12:10"/><verse number="11" style="v" sid="1CO 12:11"/>ሽን ሀ ኡባባ ኦያዌ ሄ እት ጌሻ አያና። አሳ ኡባዉ እ ባረ ኮይያዋዳን፥ ዱማ ዱማ እሞታ ሻክ ሻኪደ እሜዳ።<verse eid="1CO 12:11"/></para>
  <para style="s1">እት ቦላን ደእያ ዱማ ዱማ አሳተቱዋ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12"/>ክርስቶስ ጮራ አሳተቱ ደእያ እት ቦላ ማላ። ቦላይ ጮራ አሳተቱዋፐ መቴዳዋ ግዶፐካ፥ እት ቦላ።<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="ROM 12:4-5">ሮመ 12:4-5</ref></char></note> <verse eid="1CO 12:12"/><verse number="13" style="v" sid="1CO 12:13"/>አያዉ ጎፐ፥ ኑን አይሁዳ አሳ ግዶፐነ ዎይ ግሪከ አሳ ግዶፐ፥ ዎይ አይለ ግዶፐነ ዎይ ዎማኖ ግዶፐ፥ ኡባይ እት ጌሻ አያናን እት ቦላ ግዳናዉ ጻማቀቴዶ። ቃይ ኑን ኡባይ እት ጌሻ አያና ኡሼዶ።<verse eid="1CO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14"/>አያዉ ጎፐ፥ ቦላዉ አሳተይ ጮራ ግድያዋፐ አትን፥ እቱዋ ግደና። <verse eid="1CO 12:14"/><verse number="15" style="v" sid="1CO 12:15"/>ገዲ፥ “ታን ኩሽያ ግደና ድራዉ፥ ቦላ ቆሞ ግድከ” ጎፐ፥ እ ሄዋ ግያዌ ቦላ ቆሞ ግድያዋ ድጋኔ? <verse eid="1CO 12:15"/><verse number="16" style="v" sid="1CO 12:16"/>ሀይይካ፥ “ታን አይፍያ ግደና ድራዉ፥ ቦላ ቆሞ ግድከ” ጎፐ፥ እ ሄዋ ግያዌ ቦላ ቆሞ ግድያዋ ድጋኔ? <verse eid="1CO 12:16"/><verse number="17" style="v" sid="1CO 12:17"/>ቦላይ ኡባይ አይፍያ ጻላላ ግድንቶ፥ ዎቲደ ስሳናዉ ዳንዳዪ? ቃይ ቦላይ ኡባይ ሀይ ጻላላ ግድንቶ፥ ዎቲደ ስንጋናዉ ዳንዳዪ?<verse eid="1CO 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 12:18"/>ሽን ጾሳይ ባረ ኮዬዳዋዳን፥ ቦላ አሳተቱዋ እቱዋ እቱዋ ቦላን ዎዳ። <verse eid="1CO 12:18"/><verse number="19" style="v" sid="1CO 12:19"/>ኡባይ እት ቆሞ ግድንቶ፥ ቦላይ ሀቃን ደአኔ? <verse eid="1CO 12:19"/><verse number="20" style="v" sid="1CO 12:20"/>ሽን አሳተቱ ጮራ ግዶፐካ፥ ቦላይ እቱዋ።<verse eid="1CO 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21"/>አይፊ ኩሽያ፥ “ኔን ታና ኮሻካ” ጋናዉ ዳንዳየና። ዎይ ቃይ ሁጲ ገዳቱዋ፥ “ህንተንቱ ታና ኮሽክታ” ጋናዉ ዳንዳየና። <verse eid="1CO 12:21"/><verse number="22" style="v" sid="1CO 12:22"/>ሽን ላፋ ማላትያ ቦላ አሳተቱ ሎይ ኮሽያዋንታ። <verse eid="1CO 12:22"/><verse number="23" style="v" sid="1CO 12:23"/>ቦላ አሳተቱዋፐ ቦንቼተናዋንታ ኑዉ ማላትያዋንታ ኑን ሎይ ቦንቼቶ። ቃይ ኑና ዬላይያ ቦላ አሳተቱዋካ ሎይ ቦንቼቶ። <verse eid="1CO 12:23"/><verse number="24" style="v" sid="1CO 12:24"/>ኑ ቦላፐ ቤትያ ባጋዉ ማዩ ኮሸና፤ ሽን ፖክያ ባጋ አሳተቱዋ ሎይ ማይዛናዳን፥ ጾሳይ አሳተ እትፐ ጋዳ። <verse eid="1CO 12:24"/><verse number="25" style="v" sid="1CO 12:25"/>ቦላ አሳተቱ እቱ እቶ እት ማላ ቆፋ ቆፓናፐ አትን፥ ቦላን ዱማተይ ደአናዉ በሰና። <verse eid="1CO 12:25"/><verse number="26" style="v" sid="1CO 12:26"/>ቦላ አሳተቱዋፐ እቱ ሴለቶፐ፥ ቦላ አሳተቱ ኡባይካ አናና ሴለቲኖ፤ ቦላ አሳተቱዋፐ እቱ ቦንቼቶፐ፥ ቦላ አሳተቱ ኡባይ አናና ናሸቲኖ።<verse eid="1CO 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27"/>ህንተንቱ ኡባይ ክርስቶሳ ቦላ፤ ቃይ ሁጲያን ሁጲያን ህንተ ኡባይካ አ ቦላ አሳተቱዋ። <verse eid="1CO 12:27"/><verse number="28" style="v" sid="1CO 12:28"/>ጾሳይ ዎሳ ጎለን እት እት አሳቱዋ፥ ኮይሩዋን የሱስ ኪቴዳዋንታ፥ ላኤንዋን ናባቱዋ፥ ሄዘንዋን ታማርስያዋንታ፥ ሄዋፐ ጉይያን፥ ማላታ ኦያዋንታ፥ ሄዋፐ ጉይያን፥ ፓያ ዎልቃይ ደእያዋንታ፥ ማድያዋንታ፥ ዎሳ ጎልያ አይስያዋንታ ዱማ ዱማ ቃላን ሃሳይያዋንታ ኦዳ።<note caller="-" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="EPH 4:11">ኤፈ. 4:11</ref></char></note> <verse eid="1CO 12:28"/><verse number="29" style="v" sid="1CO 12:29"/>ኡባቱ የሱስ ኪቴዳዋንቴ? ኡባቱ ናባቴ? ኡባቱ ታማርስያዋንቴ? ኡባቱ ማላታ ኦኖ? <verse eid="1CO 12:29"/><verse number="30" style="v" sid="1CO 12:30"/>ኡባዉ ፓያ ዎልቃይ ደኢ? ኡባቱ ዱማ ዱማ ቃላን ሃሳዪኖ? ቃይ ዱማ ዱማ ቃላን ሃሳዬዳዋ ኡባቱ ብሊኖ? <verse eid="1CO 12:30"/><verse number="31" style="v" sid="1CO 12:31"/>ሽን ኡባፐ አያ እሞታ ሎይ ኮይተ።</para>
  <para style="p" vid="1CO 12:31">ቃይ ኡባፐ ሎይ አያ ኦግያ ታን ህንተንታ በሳና።<verse eid="1CO 12:31"/></para>
  <chapter eid="1CO 12"/>
  <chapter number="13" style="c" sid="1CO 13"/>
  <para style="s1">ቱሙ ሲቁዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1"/>ታን አሳ ቃላንነ ኪታንቻ ቃላን ሃሳዮፐካ ታዉ ሲቁ ዮፐ፥ ታ ሃሳያይ ጮ ዋስያ ዳዋላ ማላ፤ ዎይ ቆልጫካትያ ጽናጽልያ ማላ። <verse eid="1CO 13:1"/><verse number="2" style="v" sid="1CO 13:2"/>ናበተ እሞታይ ታዉ ደኦፐካ፥ ታን ጌሜዳ የዉዋ ኡባነ ኤራተ ኡባ ኤርንቶካ፥ ቃይ ደርያ ደን ድግያ አማኑ ታዉ ደኦፐካ፥ ሲቁ ዮፐ፥ ታን አያነ ግድከ።<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቶሳ 17:20</ref>፤ <ref loc="MAT 21:21">21:21</ref>፤ <ref loc="MRK 11:23">ማር. 11:23</ref></char></note> <verse eid="1CO 13:2"/><verse number="3" style="v" sid="1CO 13:3"/>ታዉ ደእያዋ ኡባ ህዬሳቱዋ ምዛናዉ እምንቶካ ሀራይ አቶ፥ ታ ቦላ ታማን ጉዳናዉ አ እምንቶካ ሲቁ ዮፐ፥ ታና አይነ ማደና።<verse eid="1CO 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4"/>ሲቁ ዳንዳያንቻ። ሲቁ ኬኬ። ሲቁ ቃናተና። ጬቀተና፤ ቃይ ኦቶረተና። <verse eid="1CO 13:4"/><verse number="5" style="v" sid="1CO 13:5"/>ሲቁ ባረዉ በሰናዋ ኦና፤ ኡዜተና፤ ይሎተና፤ ሲቁ ናቀቴዳዋካ ፓይደና። <verse eid="1CO 13:5"/><verse number="6" style="v" sid="1CO 13:6"/>ሲቁ ቱማተን ናሸትያዋፐ አትን፥ ዎርዱዋን ናሸተና። <verse eid="1CO 13:6"/><verse number="7" style="v" sid="1CO 13:7"/>ሲቁ ኡባባ ዳንዳዬ። ኡባባይካ ሀናናዋ ጊደ፥ ናሸቻን ናጌ። ኡባባን ገንጬ።<verse eid="1CO 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8"/>ሲቁ ሙለካ የና። ሽን ናበተይካ አታና። ዱማ ዱማ ቃላን ሃሳይያዌካ አታና። ኤራተይካ ያና። <verse eid="1CO 13:8"/><verse number="9" style="v" sid="1CO 13:9"/>አያዉ ጎፐ፥ ኑን ኤራተፐ ፓጫ ኤሬቶ፤ ትምቢትያፐካ ፓጫ ኦዴቶ። <verse eid="1CO 13:9"/><verse number="10" style="v" sid="1CO 13:10"/>ሽን ኩመን ግዴዳዌ ይያ ዎደ፥ ፓጫይ ያና።<verse eid="1CO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11"/>ታን ናአተን ደእያ ዎደ፥ ናኣዳን ሃሳያይ። ናኣዳን ቆፓይ። ቃይ ናኣዳንካ አኬካይ። ዎዳላ ግዴዳ ዎደ፥ ናአተ ሀኑዋ አጋድ። <verse eid="1CO 13:11"/><verse number="12" style="v" sid="1CO 13:12"/>ኑን ሀእ በእያዌ ማስቶትያን በእያ ለምእ ለምእያ ማላ ማላ፤ ሽን ሄ ዎደ ኑን ኑ አይፍያን ቆንጭያን በአና። ሀእ ታን ኤራተፐ ፓጫ ኤራይ፤ ሽን ጾሳይ ታና ዉርሲደ ኤርያዋዳን፥ ሄ ዎደ ታንካ ዉርሳ ኤራና።<verse eid="1CO 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13"/>ሽን ሄዋ ግዶፐ፥ አማኑ፥ ሀናናዋ ጊደ ናሸቻን ናግያዌነ ሲቁ፥ ሀዋንቱ ሄዛቱ ምኒደ ደኢኖ። ሀዋንቱፐ አያዌ ሲቁዋ።<verse eid="1CO 13:13"/></para>
  <chapter eid="1CO 13"/>
  <chapter number="14" style="c" sid="1CO 14"/>
  <para style="s1">ጌሻ አያና እሞታነ ኡንቱንቱ ማዱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1"/>ሲቁዋ ካልተ። አያና እሞታካ ሎይ ኮይተ። ሽን ኡባፐ አደ፥ ናበተ ኮይተ። <verse eid="1CO 14:1"/><verse number="2" style="v" sid="1CO 14:2"/>አያዉ ጎፐ፥ ዱማ ዱማ ቃላን ሃሳይያ ኡራይ ጾሳዉ ሃሳዬፐ አትን፥ አሳዉ ሃሳየና። አያዉ ጎፐ፥ እ ሃሳይያዋ ኦንነ አኬከና። ሽን አሳዉ ቆንጭቤና የዉዋ አያና ዎልቃን ሃሳዬ። <verse eid="1CO 14:2"/><verse number="3" style="v" sid="1CO 14:3"/>ሽን ናቢ አሳ ማዳናዉ፥ ዞራናዉነ ምንሳናዉ አሳዉ ሃሳዬ። <verse eid="1CO 14:3"/><verse number="4" style="v" sid="1CO 14:4"/>ዱማ ዱማ ቃላን ሃሳይያ ኡራይ ባረና ማዴ። ሽን ናቢ ዎሳ ጎልያ ማዴ።<verse eid="1CO 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5"/>ህንተንቱ ኡባይ ዱማ ዱማ ቃላን ሀሳያናዋ ታን ዶሳይ። ሽን ናበተ ሄዋፐ አደ ዶሳይ። አያዉ ጎፐ፥ ዱማ ዱማ ቃላን ሃሳይያዌ ሄ ሃሳዬዳዋ ዎሳ ጎልያ ማዳናዉ ብልያ አሳይ ዮፐ፥ ዱማ ዱማ ቃላን ሃሳይያዋፐ ናበተይ አ።<verse eid="1CO 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6"/>ሽን ታናዳን አማንያዋንቶ፥ ሀእ ታን ህንተንቱኮ ባደ፥ ዱማ ዱማ ቃላን ሃሳያደ፥ ሳጻን ዎይ ኤራተን ዎይ ናበተን ዎይ ታማርስያዋን ህንተንቶ ኦዳና ዮፐ፥ ታን ህንተንታ አያ ማዳይታ? <verse eid="1CO 14:6"/><verse number="7" style="v" sid="1CO 14:7"/>ሀራይ አቶ፥ ሸምፑ ባይናባይ ሱሱልያ ግድና ዎይ ዲ ግድና ካኢደ፥ ባረ ካሳ ዱማተ ኤርሳና ዮፐ፥ ሱሱልያ ፑኖፐነ፥ ዎይ ዲ ዲጾፐ፥ አሳይ ዎቲደ ኤራኔ? <verse eid="1CO 14:7"/><verse number="8" style="v" sid="1CO 14:8"/>ቃይ ጹሩምባ ዋሱ ሎይ ኤረታና ዮፐ፥ ኦላዉ ኦኔ ጊገታናዌ? <verse eid="1CO 14:8"/><verse number="9" style="v" sid="1CO 14:9"/>ሀዋዳንካ፥ ቃይ ዱማ ዱማ ቃላን ህንተ ሃሳይያዌ ቆንጨ ግደናን ዮፐ፥ ህንተ ሃሳይያዋ አሳይ ዎት አኬካኔ? አያዉ ጎፐ፥ ጫርኮ ህንተ ሃሳዪታ።<verse eid="1CO 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 14:10"/>ሀ አላምያን ጮራ ቃላይ ደኤ፤ ሽን ብለይ ባይና ቃላይ እቱነ ባዋ። <verse eid="1CO 14:10"/><verse number="11" style="v" sid="1CO 14:11"/>ሽን እት አሳይ ሃሳይያ ቃላ ታን ኤራና ዮፐ፥ ሄ ሃሳይያዌ ታዉ እማ ግዴ፤ ታንካ አዉ እማ ግዳይ። <verse eid="1CO 14:11"/><verse number="12" style="v" sid="1CO 14:12"/>ሀዋዳንካ፥ ቃይ ጌሻ አያና እሞታ ህንተ አካናዉ ሎይ ኮይያዋንታ ግድያ ድራዉ፥ ዎሳ ጎልያ ድቻናዉ ማዳዋ ኡባባፐ አደ ኮይተ።<verse eid="1CO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13"/>ሄዋ ድራዉ፥ ዱማ ዱማ ቃላን ሃሳይያዌ ባረ ሃሳዬዳዋ ብላናዉ ዳንዳያና ማላ፥ ጾሳ ዎሶ። <verse eid="1CO 14:13"/><verse number="14" style="v" sid="1CO 14:14"/>አያዉ ጎፐ፥ ታን ዱማ ዱማ ቃላን ጾሳ ዎሶፐ፥ ታ አያናይካ ዎሴ፤ ሽን ታ ጋርሳ ቆፋይ አይነ ጎኤተና። <verse eid="1CO 14:14"/><verse number="15" style="v" sid="1CO 14:15"/>ያትና፥ ታን ዎቶ? ታን ታ አያናን ጾሳ ዎሳና፤ ቃይ ታ ቆፋንካ ጾሳ ዎሳና። ታ አያናን የጻና፤ ቃይ ታ ቆፋንካ የጻና። <verse eid="1CO 14:15"/><verse number="16" style="v" sid="1CO 14:16"/>ሄዋ ግዳና ዮፐ፥ ኔን ነ አያና ጻላላን ጾሳ ጋላትያዋ ግዶፐ፥ ሄ ሳኣን ኔን ግያዋ ኤረና አሳይ ኔን ጾሳ ጋላትያዋ ኤረናን፥ ኔን ጋላቴዳዋን ዎቲደ፥ “አመንእ” ጋኔ? <verse eid="1CO 14:16"/><verse number="17" style="v" sid="1CO 14:17"/>ኔን ጾሳ ጋላትያዌ ሎአ፤ ሽን ሄዌ የኮ ብታንያ ማደና።<verse eid="1CO 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18"/>ታን ዱማ ዱማ ቃላን ህንተ ኡባፐ አደ ሃሳይያ ድራዉ፥ ጾሳ ጋላታይ። <verse eid="1CO 14:18"/><verse number="19" style="v" sid="1CO 14:19"/>ሽን ታን ዎሳ ጎለን ሀራቱዋ ታማርሳናዉ ዱማ ዱማ ቃላን ታሙ ሻአ ቃላቱዋ ሃሳይያዋፐ እቼሹ ቃላቱዋ ታ ዎዛና ቆፋን ሃሳያናዉ ዶሳይ።<verse eid="1CO 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20"/>ታናዳን አማንያዋንቶ፥ ህንተ ኢታ የዉዋን ጉ ናና ማላ ግዳናፐ አትን፥ ቆፋን ጉ ናና ማላ ግዶፕተ፤ ህንተ ጋርሳ ቆፋን ዎዛናማቱዋ ግድተ። <verse eid="1CO 14:20"/><verse number="21" style="v" sid="1CO 14:21"/>ጾሳ ማጻፋን፥</para>
  <para style="q1" vid="1CO 14:21">“ጎዳይ፥ ‘ታን ሀ አሳዉ፥</para>
  <para style="q2" vid="1CO 14:21">ዱማ ዱማ ቃላን ሃሳይያ አሳንነ፥</para>
  <para style="q2" vid="1CO 14:21">እማቱዋ ዶናን ሃሳያና።</para>
  <para style="q2" vid="1CO 14:21">ሽን ሄዋንካ፥</para>
  <para style="q2" vid="1CO 14:21">ታን ግያዋ ኡንቱንቱ ስስክኖ’ ያጌ”</para>
  <para style="m" vid="1CO 14:21">ጌተቲደ ጻፈቴዳ።<note caller="-" style="x"><char style="xo" closed="false">14:21 </char><char style="xt" closed="false"><ref loc="ISA 28:11-12">ኢሳ. 28:11-12</ref></char></note><verse eid="1CO 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22"/>ስም ዱማ ዱማ ቃላን ሃሳይያዌ አማነናዋንቶ ማላታ ግድያዋፐ አትን፥ አማንያዋንቶ ማላታ ግደና። ቃይ ናባቱዋፐ ሃሳየትያዌ አማንያዋንቶ ማላታ ግድያዋፐ አትን፥ አማነናዋንቶ ማላታ ግደና።<verse eid="1CO 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23"/>ሄዋ ድራዉ፥ አማንያ አሳይ ኡባይ እትፐ ሺቂደ፥ ቃይ ኡባይካ ዱማ ዱማ ቃላን ሃሳዮፐ፥ ታማርቤና አሳይ ዎይ አማነና አሳይ ገሊደ፥ ህንተንታ ኡባ፥ “ጎዪታ” ጌኔ? <verse eid="1CO 14:23"/><verse number="24" style="v" sid="1CO 14:24"/>ሽን ታማርቤና አሳይ ዎይ አማነና አሳይ ዎሳ ጎለ ገልያ ዎደ፥ አሳይ ኡባይ ትምቢትያ ኦዶፐ፥ እ ባረ ስስያዋን ባረ ናጋራ አኬኬ። ቃይ ሄ ስሴዳባ ኡባንካ እ ፕርደታና። <verse eid="1CO 14:24"/><verse number="25" style="v" sid="1CO 14:25"/>አ ዎዛናን ጌሜዳ ቆፋይካ ቆንጫና። ሀዋዳንካ ቃይ፥ “ጾሳይ ቱሙ ህንተ ግዶን ደኤ” ያጊደ ማርካቲደ፥ ጉፋኒደ ጾሳዉ ጎይናና።<verse eid="1CO 14:25"/></para>
  <para style="s1">አሳይ እትፐ ዎስያ ዎደ ደአናዉ በስያ ዎጋ</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26"/>ስም ታናዳን አማንያዋንቶ፥ አዬ? ህንተንቱ እትፐ ሺቅያ ዎደ፥ ሁጲያን ሁጲያን፥ እቶ ማዝሙሪ ደኤ፤ እቶ ታማርስያዌ ደኤ፤ እቶ ሳጻይ ደኤ፤ ቃይ እቶ ዱማ ዱማ ቃላን ሃሳይያዌ ደኤ፤ እቶ ብልያዌ ደኤ። ኡባይካ ዎሳ ጎልያ ማድያዋ ግዳናዉ በሴ። <verse eid="1CO 14:26"/><verse number="27" style="v" sid="1CO 14:27"/>ኦንነ ዱማ ዱማ ቃላን ሃሳዮፐ፥ ላኡ ግዲደ፥ ዎይ ዳሮፐ ሄዙ ግዲደ፥ ካላን ካላን ሃሳያናዉ በሴ። ቃይ ሀራ እቱ ኡንቱንቱ ሃሳዬዳዋ ብሎ። <verse eid="1CO 14:27"/><verse number="28" style="v" sid="1CO 14:28"/>ሽን ብልያ አሳይ ዮፐ፥ ዱማ ዱማ ቃላን ሃሳይያዌ ዎሳ ጎልያን ጮኡ ጎ። ባረ ሁጰዉነ ጾሳዉ ሃሳዮ።<verse eid="1CO 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 14:29"/>ናባቱካ ላኡ ግዲደ ዎይ ሄዙ ግዲደ ሃሳይኖ። ቃይ ሀራንቱ ኡንቱንቱ ግያዋ ሻክኖ። <verse eid="1CO 14:29"/><verse number="30" style="v" sid="1CO 14:30"/>ሽን ጾሳይ ሄ ሳኣን ኡቴዳ ሀራዉ እትባ ቆንጭሶፐ፥ ካሰና ሃሳይያዌ ጮኡ ጎ። <verse eid="1CO 14:30"/><verse number="31" style="v" sid="1CO 14:31"/>አያዉ ጎፐ፥ ኡባይ ታማራና ማላነ ኡባይ ምናና ማላ፥ ካላን ካላን ትምቢትያ ኦዳናዉ ዳንዳዪታ። <verse eid="1CO 14:31"/><verse number="32" style="v" sid="1CO 14:32"/>ትምቢትያ ኦድያዋንቱ እሞታይ ኡንቱንቶ አዛዘቴ። <verse eid="1CO 14:32"/><verse number="33" style="v" sid="1CO 14:33"/>አያዉ ጎፐ፥ ጾሳይ ሳሮተ ጾሳፐ አትን፥ ጫቡዋ ጾሳ ግደና።</para>
  <para style="p" vid="1CO 14:33">ጌሻቱ ዎሳ ጎለቱዋ ኡባን፥ <verse eid="1CO 14:33"/><verse number="34" style="v" sid="1CO 14:34"/>ማጫዋንቱ ሺቁዋ ጋርሳን ጮኡ ጊኖ። አያዉ ጎፐ፥ አይሁዳቱዋ ህጊ ግያዋዳንካ ኡንቱንቱ ሞደታናፐ አትን፥ ሺቁዋ ጋርሳን ሃሳያናዉ ኡንቱንቶ ማት ባዋ። <verse eid="1CO 14:34"/><verse number="35" style="v" sid="1CO 14:35"/>ማጫዋንቱ ሺቁዋ ጋርሳን ሃሳይያዌ ፖኮ ግድያ ድራዉ፥ አየንቶ ኤራናዉ ኮዮፐነ ሶይን ባረንቱ አስና ኦችኖ።<verse eid="1CO 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36"/>ጾሳ ቃላይ ኮይሮ ህንተፐ ዬዴ? ዎይ ህንተ ጻላላኮ ዬዴ? <verse eid="1CO 14:36"/><verse number="37" style="v" sid="1CO 14:37"/>ኦንነ ባረና ናብያ ዎይ ጾሳ አያናይ ደእያ አሳ ያጊደ ቆፖፐ፥ ታን ህንተንቶ ጻፍያዌ ጎዳ አዛዙዋ ግድያዋ አኬኮ። <verse eid="1CO 14:37"/><verse number="38" style="v" sid="1CO 14:38"/>ሽን ኦንነ አኬካና ዮፐ፥ አኬኮፖ ባሽ አጎ።<verse eid="1CO 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39"/>ሄዋ ድራዉ፥ ታናዳን አማንያዋንቶ፥ ትምቢትያ ኦዳናዉ ሎይ አሞትተ። ቃይ ዱማ ዱማ ቃላን ሃሳይያዋካ ድጎፕተ። <verse eid="1CO 14:39"/><verse number="40" style="v" sid="1CO 14:40"/>ሽን ኡባባይካ ዎጋንነ ማራን ሀኖ።<verse eid="1CO 14:40"/></para>
  <chapter eid="1CO 14"/>
  <chapter number="15" style="c" sid="1CO 15"/>
  <para style="s1">ክርስቶስ ሀይቁዋፐ ደንዴዳባ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1"/>ታናዳን አማንያዋንቶ፥ ታን ህንተንቶ ኦዴዳ ምሽራቹዋ ቃላ ህንተ አኬዳዋነ ቃይ ህንተ አማኑ አን ኤቄዳዋ ህንተንታ ቆፈይ። <verse eid="1CO 15:1"/><verse number="2" style="v" sid="1CO 15:2"/>ህንተንቱ አማኑ መላ ግዳና ዮፐ፥ ቃይ ታን ህንተንቶ ኦዴዳ ቃላ ሎይ ኦይቆፐ፥ ህንተ ሄ ምሽራቹዋ ቃላን አቴድታ።<verse eid="1CO 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3"/>አያዉ ጎፐ፥ ታን ቃይ አኬዳዋ ኡባባፐ አደ ኮሽያዋ ካሰታደ ህንተንቶ እማድ። ሄዌ አዬ ጎፐ፥ ጾሳ ማጻፋይ ግያዋዳን፥ ክርስቶስ ኑ ናጋራ ድራዉ<note caller="-" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="ISA 53:5-12">ኢሳ. 53:5-12</ref></char></note> <verse eid="1CO 15:3"/><verse number="4" style="v" sid="1CO 15:4"/>ሀይቂደ ሞገቴዳ። ጾሳ ማጻፋይ ግያዋዳንካ፥ ሄዘንያ ጋላስ ሀይቁዋፐ<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="PSA 16:8-10">ማዝ. 16:8-10</ref>፤ <ref loc="MAT 12:40">ማቶሳ 12:40</ref>፤ <ref loc="ACT 2:24-32">ኪታ 2:24-32</ref></char></note> <verse eid="1CO 15:4"/><verse number="5" style="v" sid="1CO 15:5"/>ደንዲደ፥ ጰጽሮሳዉ ቆንጬዳ። ሄዋፐ ጉይያን፥ ባረ ኪቴዳ ታማነ ላአቶ ቆንጬዳ።<note caller="-" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="MAT 28:16-17">ማቶሳ 28:16-17</ref>፤ <ref loc="MRK 16:14">ማር. 16:14</ref>፤ <ref loc="LUK 24:34">ሉቃሳ 24:34</ref>፣ <ref loc="LUK 24:36">36</ref>፤ <ref loc="JHN 20:19">ዮሃ. 20:19</ref></char></note> <verse eid="1CO 15:5"/><verse number="6" style="v" sid="1CO 15:6"/>ሄዋፐ ጉይያን፥ እቼሹ ጼቱዋፐ ዳርያ ባረና ካልያ አሳዉ እት ካላ ቆንጬዳ። ኡንቱንቱፐ ዳርያ ባጋይ ሀኖ ጋካናስካ ፓጻ ደኢኖ፤ ሽን አማሬዳዋንቱ ሀይቄድኖ። <verse eid="1CO 15:6"/><verse number="7" style="v" sid="1CO 15:7"/>ሄዋፐ ጉይያን፥ ያቆባዉ ቆንጬዳ፤ ጉየፐ ባረ ኪቴዳ ኡባቶ ቆንጬዳ።<verse eid="1CO 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8"/>ቃይ ኡባፐ ዉርሰን፥ ዎዲ ጋከናን የለቴዳ ታዉካ ቆንጬዳ።<note caller="-" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ACT 9:3-6">ኪታ 9:3-6</ref></char></note> <verse eid="1CO 15:8"/><verse number="9" style="v" sid="1CO 15:9"/>አያዉ ጎፐ፥ የሱስ ኪቴዳ ኡባፐ ታን ላፋ፤ ታን ጾሳ ዎሳ ጎልያ ዋይሴዳ ድራዉ፥ የሱስ ኪቴዳዋ ጌተታደ ጼሰታናዉካ በስከ። <verse eid="1CO 15:9"/><verse number="10" style="v" sid="1CO 15:10"/>ሽን ጾሳ አ ኬካተን ታን ታናካ። ቃይ ታዉ እ እሜዳ አ ኬካተይ መላ ግድቤና፤ ሽን ታን ኡንቱንታ ኡባፐ አደ ኦድ። ሽን ታናና ደእያ ጾሳ አ ኬካተይ ኦዳፐ አትን፥ ታና ግድከ። <verse eid="1CO 15:10"/><verse number="11" style="v" sid="1CO 15:11"/>ስም ታና ግዶፐካ፥ ዎይ ኡንቱንታ ግዶፐካ፥ ኑን ኡባይ ኦድያዌ ሀዋ፤ ህንተንቱካ ሀዋ አማኔድታ።<verse eid="1CO 15:11"/></para>
  <para style="s1">አሳይ ሀይቁዋፐ ደንዳናባ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12"/>ክርስቶስ ሀይቁዋፐ ደንዴዳዋ ኦድያዋ ግዶፐ፥ ህንተንቱፐ እት እት አሳቱ ያትና ዎቲደ፥ “ሀይቄዳ አሳይ ሀይቁዋፐ ደንደና” ያጊኖ? <verse eid="1CO 15:12"/><verse number="13" style="v" sid="1CO 15:13"/>ሀይቄዳ ኡራይ ሀይቁዋፐ ደንድቤናዋ ግዶፐ፥ ያትና ሄኮ ክርስቶስካ ሀይቁዋፐ ደንድቤና ግያዋ። <verse eid="1CO 15:13"/><verse number="14" style="v" sid="1CO 15:14"/>ክርስቶስ ሀይቁዋፐ ደንድቤናዋ ግዶፐ፥ ያትና ኑን ኦድያዌካ መላ፤ ቃይ ህንተ አማኑካ መላ። <verse eid="1CO 15:14"/><verse number="15" style="v" sid="1CO 15:15"/>ቃይ ኑን፥ “ክርስቶሳ ሀይቁዋፐ ደንዳ” ያጊደ ጾሳባ ማርካቴዳ ድራዉ፥ አ ዎርዶ ማርካቱዋ ግዲደ ቤቴዶ። ሽን ሀይቄዳዋንታ ሀይቁዋፐ እ ደንቤናዋ ግዶፐ፥ ክርስቶሳካ ደንቤና። <verse eid="1CO 15:15"/><verse number="16" style="v" sid="1CO 15:16"/>አያዉ ጎፐ፥ ሀይቄዳዋንቱ ሀይቁዋፐ ደንደናዋ ግዶፐ፥ ስም ክርስቶስካ ደንድቤና። <verse eid="1CO 15:16"/><verse number="17" style="v" sid="1CO 15:17"/>ክርስቶስ ሀይቁዋፐ ደንድቤናዋ ግዶፐ፥ ህንተ አማኑካ መላ፤ ቃይ ህንተ ሀዋ ጋካናዉካ ናጋራና ደኢታ። <verse eid="1CO 15:17"/><verse number="18" style="v" sid="1CO 15:18"/>ስም ክርስቶሳ አማኒደ ሀይቄዳዋንቱካ ቃይ ዬድኖ ግያዋ። <verse eid="1CO 15:18"/><verse number="19" style="v" sid="1CO 15:19"/>ኑን ሀ ደኡዋ ጻላላዉ ክርስቶሳን ህዶቴዳ<note caller="+" style="f"><char style="fr" closed="false">15:19 </char><char style="fqa" closed="false">ህዶታ፦ </char><char style="ft" closed="false">ክርስቶሳን ኑ ዎዳ ኑ ኡባ ህዶታይ፥ ሀ አላምያን ደኡዋሳ ግዶፐ፥ ሀ አላምያን ደእያ ሀራ አሳቱዋ ኡባፐካ ኑባይ አደ ኢታ፥ ጉሳ።</char></note> ግዶፐ፥ ሀ አላምያን ደእያ አሳ ኡባፐካ ኑባይ ሎኤና።<verse eid="1CO 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20"/>ሽን ክርስቶስ ሀይቄዳዋንቱ ደንዶ ባይራ ግዲደ፥ ሀይቁዋፐ ደንዴዳዌ ቱማ። <verse eid="1CO 15:20"/><verse number="21" style="v" sid="1CO 15:21"/>አያዉ ጎፐ፥ ሀይቁ እት አሳ ባጋና ሀ አላምያ ዬዳ፥ ሀይቄዳዋንቱ ደንዱካ ቃይ እት አሳ ባጋና ዬዳ። <verse eid="1CO 15:21"/><verse number="22" style="v" sid="1CO 15:22"/>አያዉ ጎፐ፥ አሳይ ኡባይ አዳማና እትፐተ መዳ ድራዉ ሀይቄዳዋዳን፥ ክርስቶሳና እትፐተ መዳ ድራዉ፥ ኡባይ ደኦ ደንዳና። <verse eid="1CO 15:22"/><verse number="23" style="v" sid="1CO 15:23"/>ሽን ኡባይካ ባረ ካላን ካላን ደንዳና። ክርስቶስ ኡባፐ ካሰቲደ ደንዴዳ፤ ሄዋፐ ጉይያን፥ ክርስቶሳዋንቱ ክርስቶስ ይያ ዎደ ደንዳና።<verse eid="1CO 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 15:24"/>ሄዋፐ ጉይያን፥ ክርስቶስ ማታ ኡባ፥ ጎዳተ ኡባነ ዎልቃ ኡባ ይሲደ፥ ጾሳዉ ባረ አቦ ካዉተ እምያ ዎደ፥ ዎድያ ዉርሰይ ያናዋ። <verse eid="1CO 15:24"/><verse number="25" style="v" sid="1CO 15:25"/>አያዉ ጎፐ፥ ጾሳይ አ ሞርከቱዋ ኡባ አ ገድያፐ ጋርሳና ዎና ጋካናዉ፥ ክርስቶስ ሞዳናዉ በሴ።<note caller="-" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note> <verse eid="1CO 15:25"/><verse number="26" style="v" sid="1CO 15:26"/>ኡባፐ ዉርሰን ዪደ ደእያ ሞርኪ ሀይቁዋ። <verse eid="1CO 15:26"/><verse number="27" style="v" sid="1CO 15:27"/>አያዉ ጎፐ፥ ጾሳ ማጻፋይ፥ “ጾሳይ ኡባባ አ ገድያፐ ጋርሳና ዎደ ሞድሴዳ” ያጌ። ሽን ኡባባ አ ገድያፐ ጋርሳና ዎደ ሞድሴዳ ግያ ዎደ፥ ኡባባ ኦዳ ጾሳፐ አትን፥ የኮ ኡባይ ሞደቴዳ ግያዌ ቆንጨ።<note caller="-" style="x"><char style="xo" closed="false">15:27 </char><char style="xt" closed="false"><ref loc="PSA 8:6">ማዝ. 8:6</ref></char></note> <verse eid="1CO 15:27"/><verse number="28" style="v" sid="1CO 15:28"/>ሽን ኡባባይ ክርስቶሳዉ ሞደቴዳዋፐ ጉይያን፥ ክርስቶስ ቃይ ባረ ሁጰዉ ኡባባ ባረና ሞድሴዳ ጾሳዉ ሞደታና። ጾሳይ ቃይ ኡባባ ዉርሲደ ሞዳና።<verse eid="1CO 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29"/>ሄዋ ግዳና ዮፐ፥ ሀይቄዳዋንቱ ኮታ ጻማቀትያዋንቱ አያ ኦኖ? ሀይቄዳዋንቱ ኡባካ ደንደናዋ ግዶፐ፥ አሳይ ሀይቄዳዋንቱ ኮታ አያዉ ጻማቀቲ?<verse eid="1CO 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1CO 15:30"/>ያትና፥ ኑን ኡባ ዎደ አያዉ ሀሳየና መቱዋን ገሌቶ? <verse eid="1CO 15:30"/><verse number="31" style="v" sid="1CO 15:31"/>ታናዳን አማንያዋንቶ፥ ታን ኑ ጎዳ ክርስቶሳ የሱሳን ታዉ ደእያ ህንተናን ጬቀታደ፥ ጋላሳን ጋላሳን ሀይቃይ። <verse eid="1CO 15:31"/><verse number="32" style="v" sid="1CO 15:32"/>ታን ኤፈሶነን አሳ ቆፋዳን ዱኣና ባጸቴዳዌ ታና አያ ማዲ? ሽን ሀይቄዳዋንቱ ሀይቁዋፐ ደንደናዋ ግዶፐ፥</para>
  <para style="q1" vid="1CO 15:32">“ስም ሞይተነ ኡሾይተ፤</para>
  <para style="q2" vid="1CO 15:32">አያዉ ጎፐ፥ ኑን ዎንት ሀይቃና” ግያዋ ማላ።<note caller="-" style="x"><char style="xo" closed="false">15:32 </char><char style="xt" closed="false"><ref loc="ISA 22:13">ኢሳ. 22:13</ref></char></note><verse eid="1CO 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33"/>ጭመቶፕተ፤ ኢታ ላገተይ ሎኦ ሀኖታ ባይዜ። <verse eid="1CO 15:33"/><verse number="34" style="v" sid="1CO 15:34"/>ጽሎተኮ ስምተ። ናጋራ ኦፕተ። ህንተንቱፐ እት እት አሳይ ጾሳ ኤረና፤ ታን ሀዋ ህንተንታ ዬላያናዉ ጋይ።<verse eid="1CO 15:34"/></para>
  <para style="s1">ሀይቁዋፐ ደንዴዳ ቦላ ሀኖታ</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35"/>ሽን እት አሳይ፥ “ሀይቄዳ አሳይ ዋኒደ ደንዳኔ? ኡንቱንቱ አያ ማላ ቦላና ያኔ?” ያገናን አገና። <verse eid="1CO 15:35"/><verse number="36" style="v" sid="1CO 15:36"/>ኔኖ ኤያዉ፥ ኔን ጋድያን ዘርያ ዘረይ ሀይቀናን ሞከና። <verse eid="1CO 15:36"/><verse number="37" style="v" sid="1CO 15:37"/>ኔን ዘርያዌ ዛርጋ ግድና ዎይ ሀራ ቆሞ ካ ግድና፥ አይፍያ ጻላላፐ አትን፥ ላም ዶሊደ ከስያዋ ግደና። <verse eid="1CO 15:37"/><verse number="38" style="v" sid="1CO 15:38"/>ሽን ጾሳይ ዘረዉ ባረ ዶሴዳ ቦላ እሜ፤ ቃይ ዘረ ኡባዉካ ሁጲያን ሁጲያን ኡንቱንቱ ቦላ እሜ። <verse eid="1CO 15:38"/><verse number="39" style="v" sid="1CO 15:39"/>መታ ኡባ አሹ እቱዋ ግደና። ሽን አሳ አሹ እቱዋ፤ መህያ አሹ ዱማ፤ ካፋቱዋ አሹካ ዱማ፤ ቃይ ሞልያ አሹካ ዱማ።<verse eid="1CO 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40"/>ቃይ ሳሉዋ አሳተቱነ ሳኣ አሳተቱ ደኢኖ። ሽን ሳሉዋ ቦላ ቦንቹ ዱማ፤ ቃይ ሳኣ ቦላ ቦንቹ ዱማ። <verse eid="1CO 15:40"/><verse number="41" style="v" sid="1CO 15:41"/>አዋይፍያዉ አ ሁጰ ቦንቹ ደኤ። አገናዉካ አ ሁጰ ቦንቹ ደኤ። ቃይ ጾልንታቶካ ዱማ ቦንቹ ደኤ፤ አያዉ ጎፐ፥ እት ጾልንቲ የኮ ጾልንትያፐ ቦንቹዋን ዱማቴ።<verse eid="1CO 15:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42"/>ቃይ ሀይቄዳዋንቱ ሀይቁዋፐ ደንድያ ዎደ ሄዋዳን ሀናና፤ ሀይቂያ ቦላይ ሞገቲደ፥ ሀይቀና ቦላ ግዲደ ደንዳና። <verse eid="1CO 15:42"/><verse number="43" style="v" sid="1CO 15:43"/>ቦላይ ቶሽያን ሞገቲደ፥ ቦንቹዋን ደንዳና። ቃይ ዳቡራን ሞገቲደ፥ ዎልቃን ደንዳና። <verse eid="1CO 15:43"/><verse number="44" style="v" sid="1CO 15:44"/>መታ ቦላይ ሞገቲደ፥ ጌሻ አያናን ካለሰትያ ቦላ ግዲደ ደንዳና። መታ ቦላይ ደኦፐ፥ ቃይ ጌሻ አያናን ካለሰትያ ቦላይካ ደኤ።<verse eid="1CO 15:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="1CO 15:45"/>ሀዋዳንካ፥ ቃይ ጾሳ ማጻፋን፥ “ኮይሮ ብታኒ፥ አዳም፥ ፓጻ ደእያ አሳ ግዲደ መቴዳ” ያጌ። ሽን ዉርሰ አዳም ደኡዋ እምያ አሳ ግዴዳ።<note caller="-" style="x"><char style="xo" closed="false">15:45 </char><char style="xt" closed="false"><ref loc="GEN 2:7">ዶመ 2:7</ref></char></note> <verse eid="1CO 15:45"/><verse number="46" style="v" sid="1CO 15:46"/>ሽን መታ አሳይ ኮይሮ ዪና፥ ጌዶፐ አያና አሳይ ዬዳፐ አትን፥ አያናዌ ኮይሮ ይቤና። <verse eid="1CO 15:46"/><verse number="47" style="v" sid="1CO 15:47"/>ኮይሮ አዳም ቢታፐ መቴዳ፤ እ ቢታፐ መቴዳዋ። ላኤንዋ አዳም ሳሉዋፐ ዬዳ። <verse eid="1CO 15:47"/><verse number="48" style="v" sid="1CO 15:48"/>ሀ ሳኣ አሳቱ ቢታፐ መቴዳዋ ማላቲኖ። ቃይ ሳሉዋ አሳቱ ሳሉዋፐ ዬዳዋ ማላቲኖ። <verse eid="1CO 15:48"/><verse number="49" style="v" sid="1CO 15:49"/>ኑን ቢታፐ መቴዳዋ ማላ ማዬዳዋዳን፥ ሳሉዋፐ ዬዳዋ ማላካ ቃይ ማያና።<verse eid="1CO 15:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50"/>ታናዳን አማንያዋንቶ፥ ታን ግያዌ ሀዋ፤ አሹነ ሱይ<note caller="+" style="f"><char style="fr" closed="false">15:50 </char><char style="ft" closed="false">ሀ ሳኣ ቦላ ደኢደ አሳይ ማዬዳ አሹዋነ ሱ፥ ጉሳይ ሀ አላምያ አሳተ ጉሳ።</char></note> ጾሳ ካዉተ ላታና ዳንዳየና። ቃይ ዎቂያዌ ዎቀናዋ ላተና።<verse eid="1CO 15:50"/></para>
  <para style="p">
    <verse number="51-52" style="v" sid="1CO 15:51-52"/>ስስተ! ታን ህንተንቶ እትባ ጹራይ። ኑን ኡባይ ሀይቆኮ። ሽን ዉርሰ ጹሩምባይ ፑነትያ ዎደ፥ ልጴዳ አይፊ ጼላናዉ ዎዛና አናን ላመታና። አያዉ ጎፐ፥ ጹሩምባይ ፑነትያ ዎደ፥ ሀይቄዳ አሳይ ዎቀና አሳ ግዲደ ደንዳና፤ ኑንካ ላመታና።<note caller="-" style="x"><char style="xo" closed="false">15:51-52 </char><char style="xt" closed="false"><ref loc="1TH 4:15-17">1 ተስ. 4:15-17</ref></char></note> <verse eid="1CO 15:51-52"/><verse number="53" style="v" sid="1CO 15:53"/>አያዉ ጎፐ፥ ሀዌ ዎቂያዌ ዎቀናዋ ማያናዉ በሴ፤ ቃይ ሀዌ ሀይቂያዌ ሀይቀናዋ ማያናዉ በሴ።<verse eid="1CO 15:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="1CO 15:54"/>ሽን ሀዌ ዎቂያዌ ዎቀናዋ ማይያ ዎደ፥ ቃይ ሀዌ ሀይቂያዌ ሀይቀናዋ ማይያ ዎደ፥ ሄ ዎደ፥ ጾሳ ማጻፋይ፥</para>
  <para style="q1" vid="1CO 15:54">“ሀይቁ ጾነቲደ ምተቴዳ።<note caller="-" style="x"><char style="xo" closed="false">15:54 </char><char style="xt" closed="false"><ref loc="ISA 25:8">ኢሳ. 25:8</ref></char></note><verse eid="1CO 15:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55"/>ሀይቆ፥ ነ ይሻይ ሀቃኔ?</para>
  <para style="q2" vid="1CO 15:55">ሀይቆ፥ ነ ጾኑ ሀቃኔ?”</para>
  <para style="m" vid="1CO 15:55">ጌዳ ቃላይ ፖለታና።<note caller="-" style="x"><char style="xo" closed="false">15:55 </char><char style="xt" closed="false"><ref loc="HOS 13:14">ሆሰ 13:14</ref></char></note> <verse eid="1CO 15:55"/><verse number="56" style="v" sid="1CO 15:56"/>ሀይቁ ዱክያ ዎልቃ ናጋራፐ ደሜ፤ ቃይ ናጋራይ ዎልቃ ህግያፐ ደሜ። <verse eid="1CO 15:56"/><verse number="57" style="v" sid="1CO 15:57"/>ሽን ኑ ጎዳ የሱስ ክርስቶሳ ባጋና ኑና ጾንስያ ጾሳ ጋላታይ ጋኮ።<verse eid="1CO 15:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58"/>ታን ሲቅያ ታናዳን አማንያዋንቶ፥ ሄዋ ድራዉ፥ ቃጸናን ምን ኤቂተ። ህንተንቱ ዳቡራይ ጎዳ ባጋና መላ ግደናዋ ኤሪደ፥ ኡባ ዎደ ጎዳ ኦሱዋ አዛለናን ኦተ።<verse eid="1CO 15:58"/></para>
  <chapter eid="1CO 15"/>
  <chapter number="16" style="c" sid="1CO 16"/>
  <para style="s1">የሩሳላመን ደእያ አማንያ አሳዉ ሺቄዳ ሚሻ ማዱዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1"/>ጾሳ አሳቶ ሚሻ ሺሻናዉ ጋላትያን ደእያ አማንያ አሳቶ ታን ቃላ ገሌዳዋዳን፥ ህንተንቱካ ቃይ ሄዋዳን ኦተ። <verse eid="1CO 16:1"/><verse number="2" style="v" sid="1CO 16:2"/>ህንተንቱ ታን ያ ብያ ዎደ፥ ሚሻ ሺሸና ማላ፥ ህንተ ኡባይ ዎጋ ጋላስ ጋላስ፥ ህንተ ደምያ ኬናፐ ህንተ ጎለን ዳጋይተ። <verse eid="1CO 16:2"/><verse number="3" style="v" sid="1CO 16:3"/>ታን ያ ጋክያ ዎደ፥ ህንተ አማንያ አሳ ኦና ግዶፐነ፥ ህንተ እሜዳዋ ጋና ማላ፥ ዳብዳቢያና ኡንቱንታ የሩሳላመ ኪታና። <verse eid="1CO 16:3"/><verse number="4" style="v" sid="1CO 16:4"/>ቃይ ታን ኡንቱንቱና ባናዉ ኮሾፐ፥ ኡንቱንቱ ታናና እትፐ ባናዋንታ።<verse eid="1CO 16:4"/></para>
  <para style="s1">ጳዉሎሳ ቆፋቱዋ</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5"/>ታን ማቅዶንያና አአደ፥ ህንተንቱኮ ባና፤ አያዉ ጎፐ፥ ታን ማቅዶንያና አይ። <verse eid="1CO 16:5"/><verse number="6" style="v" sid="1CO 16:6"/>ታን ብያሳ ሀቃ ግዶፐነ፥ ታ ቡሳን ህንተ ታና ማዳና ማላ፥ ህንተ ማታን አማሬዳ ዎድያ ጋምኤናን አግከ። ዎይ ባልጉዋካ ህንተ ማታን ሻጨናን ዋያ አጋና። <verse eid="1CO 16:6"/><verse number="7" style="v" sid="1CO 16:7"/>አያዉ ጎፐ፥ ታን ሀእ ያና አአደ ሄ ኦግያና ህንተንታ በአናዉ ኮይከ። ጎዳይ ጎፐ፥ ህንተ ማታን አማሬዳ ዎድያ ታካናዉ ቆፓይ።<verse eid="1CO 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8"/>ሽን ታን ጰንጸቆስተ ግያ ጋላሳይ ጋካናዉ ኤፈሶነን ጋምአና። <verse eid="1CO 16:8"/><verse number="9" style="v" sid="1CO 16:9"/>ታዉ ኦሱ ኩሜዳ አኮ ፐንጊካ ያን ዶየቴዳ። ቃይ ታዉ ጮራ ሞርከቱ ደኢኖ።<verse eid="1CO 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10"/>ጽሞቶሰ ህንተንቱኮ ዮፐ፥ ህንተ ማታን እ ያየናን ደአናዳን፥ አ ሎይ ኦይቂተ። አያዉ ጎፐ፥ እካ ቃይ ጎዳ ኦሱዋ ኦ። <verse eid="1CO 16:10"/><verse number="11" style="v" sid="1CO 16:11"/>ሄዋ ድራዉ፥ ኦንነ አ ካፖ። ሽን እ ታኮ ሳሮ ስማና ማላ፥ አ ማዲደ ሳሮተን ሞይዝተ። አያዉ ጎፐ፥ ታን እ እሻቱዋና ስማናዋ ናጋ ኡታድ።<verse eid="1CO 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12"/>ሽን ኑ እሻ አጲሎስ የኮ እሻቱዋና ህንተንቱኮ ባና ማላ፥ ታን አ ምንሳ ዎሳድ። ሽን ሀእ ህንተንቱኮ ባናዉ ኮይቤና፤ እ ባረዉ ሚክያ ዎደ ህንተንቱኮ ባናዋ።<verse eid="1CO 16:12"/></para>
  <para style="s1">ዉርሰ ዞርያነ ሳሮታ</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13"/>ቤጎትተ። አማኑዋን ምን ኤቂተ። ጻልተ። ጎብተ። <verse eid="1CO 16:13"/><verse number="14" style="v" sid="1CO 16:14"/>ኦሱዋ ኡባ ሲቁዋን ኦተ።<verse eid="1CO 16:14"/></para>
  <para style="p">
    <verse number="15-16" style="v" sid="1CO 16:15-16"/>ታናዳን አማንያዋንቶ፥ እስጽፋኖስነ አ ሶይ አሳይ ግሪከን ኮይሮ አማኔዳዋንታ ግድያዋነ ጾሳ አሳቶ ኦናዉ ባረንታ እሜዳዋ ህንተ ኤሪታ። ህንተንቱካ ኡንቱንቱ ማላ አሳዉነ፥ ኡንቱንቱና ኦያ ኡባዉ ዳቡርያ ኡባዉ ኤኖ ጋናዳን፥ ታን ህንተንታ ዎሳይ።<verse eid="1CO 16:15-16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17"/>እስጽፋኖስ፥ ፓርዶናጽስነ አካይቆስ ህንተ ባይናሳን ታና ቦራስስቤና ድራዉ፥ ኡንቱንቱ ዩሳን ታን ናሸታይ። <verse eid="1CO 16:17"/><verse number="18" style="v" sid="1CO 16:18"/>ኡንቱንቱ ህንተንታ አያናን ምንሴዳዋዳን፥ ታናካ አያናን ምንሴዳ ድራዉ፥ ሄዋንቱ ማላ አሳቱዋ ዶጎፕተ።<verse eid="1CO 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19"/>ኢስያን ደእያ አማንያ አሳይ ህንተንታ፥ “ሳሬ፥ ሎኤ” ጊኖ። አቂላይነ ጵርስቂላ ባረንቱ ሶይን ሺቅያ ዎሳ ጎለ አሳናካ ህንተንቶ ጎዳ ሳሮታ ዎዛናፐ ኪቲኖ። <verse eid="1CO 16:19"/><verse number="20" style="v" sid="1CO 16:20"/>እሻቱ ኡባይ ህንተንቶ ሳሮታ ኪቲኖ።</para>
  <para style="p" vid="1CO 16:20">እቱ እቱዋና ጌሻ የረታ የረቲደ ሳሮተትተ። <verse eid="1CO 16:20"/><verse number="21" style="v" sid="1CO 16:21"/>ታን ጳዉሎስ ሀ ሳሮታ ታ ኩሽያን ጻፋድ።<verse eid="1CO 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22"/>ጎዳ የሱስ ክርስቶሳ ሲቀና አሳይ ደኦፐ፥ እ ሸቀቴዳዋ ግዶ። ኑ ጎዳዉ፥ ሃያ።<verse eid="1CO 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23"/>ጎዳ የሱስ ክርስቶሳ አ ኬካተይ ህንተንቱና ግዶ።<verse eid="1CO 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24"/>ክርስቶሳ የሱሳን ደእያ ህንተንቱ ኡባና ታ ሲቁ ግዶ። አመንእ።<verse eid="1CO 16:24"/></para>
  <chapter eid="1CO 16"/>
</usx>
