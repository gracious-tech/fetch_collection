<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">NT0108.CO1 IAMALELE (BEAUMONT) - 25-FEB-88; 1-October-2014</book>
  <para style="h">KOLOSE</para>
  <para style="toc3">Kol</para>
  <para style="toc2">Kolose</para>
  <para style="toc1">Faulo yana kiluma me Kolose 'waidie.</para>
  <para style="mt1">KOLOSE</para>
  <para style="mt2">Faulo yana kiluma me Kolose 'waidie</para>
  <para style="is">'Eba kiavemageta</para>
  <para style="ip">Tutuyanina Faulo i miamia Loma vanuga yogona nageneye lubulubu de'e i kilumi me Kolose faifaidi. We'e wata tamu lubulubu i kilumiga Filimoni faifaina fai taunina tomogo Kolose, bega lubulubunidi 'ailuga Tikiasa wata Onesimo i nawedi. Kolose sai'afo Efeso lilivaneye, 'awalawa Eisia nageneye. Kolose tovetumagana 'adi 'aila'a i souyeniga kebu Faulo yana lau'age 'wainega, Faulo taunina i miamia Efeso we'e Efafilasi i vetunei i lau'age 'waidie nika tovetumagana 'adi 'aila'a i souyeni. (Kolose 1:7) Efafilasi 'atamana 'ailuga 'waidie i folova Kolose lilivaneye, Lodisia wata Ilafolisi. (Kolose 4:13) Kebu tamu tutuya 'atamananidi 'adi tomotoga Faulo i da 'isediga, siwe faifaidi i nuanua wata i vevelu'ui.</para>
  <para style="ip">Efafilasi i nago Faulo 'waineye i lu'ivona tove-vekavekali faifaidi, bega Faulo lubulubu de'e i kilumi, kebu nuanuana tovekalinidi me Kolose yadi vetumagana i na 'ivesakoidi. Tovekalinidi nuanuadi tovetumaganavo ma yadi subia i na 'odu'odu tomotoga bwaikidi wata toketokedi bani'odi anelose 'waidie, kumanidiavo i miamia abame. Wata i vonaga Iesu kebu mogitana Yaubada Natuna, taunina tamu anelose bani'odi. Wata tovekalinidi nuanuadi bunu 'aibobo wata veimea 'ifwaidi Mosese 'wainega i na vevematayakeyakedi.</para>
  <para style="ip">Lubulubu de'e 'wainega Faulo i ve me Kolose 'waidie Keliso 'asa'aiana kumanina Yaubada yana 'ai'aiwabu, yana sauluva wata yana nuanua i vesala. Keliso 'wainega Yaubada nani matatabuna i 'idewadi wata taunina tovetumaganavo yadi To'edakumeta. Keliso 'aiseotogina 'ita'ita'i wata mia 'atumaina lamuna. Lubulubu de'e 'ana 'idi side bani'odi.</para>
  <para style="io1">Faulo yana vona-vekaiwa. <char style="ior"><ref loc="COL 1:1-2">1:1-2</ref></char></para>
  <para style="io1">Faulo i vekaiwa wata i velu'ui me Kolose faifaidi. <char style="ior"><ref loc="COL 1:3-14">1:3-14</ref></char></para>
  <para style="io1">Keliso yana vebwaika wata yana folova faifaidi. <char style="ior"><ref loc="COL 1:15-23">1:15-23</ref></char></para>
  <para style="io1">Faulo yana folova tovetumagana 'adi 'aila'avo faifaidi. <char style="ior"><ref loc="COL 1:24-2:5">1:24-2:5</ref></char></para>
  <para style="io1">Me Kolose i na miave'itubama Keliso taiadi, we'e tove-vekavekali i na bailedi. <char style="ior"><ref loc="COL 2:6-3:4">2:6-3:4</ref></char></para>
  <para style="io1">Sauluvanidi tovetumaganavo 'adi laubwaina. <char style="ior"><ref loc="COL 3:5-4:1">3:5-4:1</ref></char></para>
  <para style="io1">Velu'ase'ase 'ifwaidi wata yana 'alanuai. <char style="ior"><ref loc="COL 4:2-18">4:2-18</ref></char></para>
  <para style="ie" />
  <chapter number="1" style="c" sid="COL 1" />
  <para style="m">
    <verse number="1-2" style="v" sid="COL 1:1-2" />Emavo, yau Faulo iada Timoti taiadi 'a vekaiwa 'waimie. Yaubada nuanuana, bega a vetomata'aulele Iesu Keliso faifaina, we'e 'omi Yaubada yana tomotoga vevenua'ivinimi, 'wa miamia 'atamana Kolose 'waineye. 'Aila'animi 'wa miave'itubama Keliso taiadi, 'waimie a kilukiluma. 'A vevelu'ui faifaimi, nuanuama Yaubada Tamada ma yana nuakalikali i na vevesauluva 'atumaina 'waimie wata nuanua bikana mia 'atumaina taiadi i na velevelemi.<verse eid="COL 1:1-2" /></para>
  <para style="s">Faulo i vekaiwa Yaubada 'waineye me Kolose faifaidi</para>
  <para style="p">
    <verse number="3-4" style="v" sid="COL 1:3-4" />Tutuya fuedi faifaimi 'a vevelu'ui wata 'a vevekaiwa Yaubada 'waineye, kumanina 'ada Toveimea Iesu Keliso Tamana. Fai valami 'a nogai yami vetumagana Iesu Keliso 'waineye toketokena wata Yaubada yana tomotoga matatabudi 'wa nunuakalikaliedi. <verse eid="COL 1:3-4" /><verse number="5" style="v" sid="COL 1:5" />Basenadi Iesu Valana 'Atumaina 'wa nogai, Valanina Yaubada yana Vona tonovina, nika bei 'wa nuani mogitana 'awaie 'ami veuveuta 'atumaidi 'wa na veluagadi Yaubada 'wainega. 'Ami veuveutanidi Yaubada 'akonadi i 'idewadi abame i 'eno'enovi, bega ma yami vetumagana faifaidi 'wa lulukamata. Fai naninidi 'wa nuani mogitana 'awaie 'wa na veluagadi, 'wa nunuakalikali wata 'wa vevetumagana. <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />Valanina Iesu faifaina basenadi 'wa nogaiga, i vevebwaika tomia fwayafwaya matatabuna 'waidie, 'atumaina wata ma vuagina. Wata 'omi bani'odi. Tutuyanina valanina 'wa nogai wata 'wa 'asetai mogitana Yaubada ma yana nuakalikali i vesauluva 'atumaina 'waimie, i maiga 'asiau Iesu Valana i vevebwaika 'waimie wata yami sauluva i veve'atumai 'wa da vo ma vuagina. <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" /><note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="COL 4:12">Kol 4:12</ref>; <ref loc="PHM 1:23">Fmi 1:23</ref></char></note>Yami 'asetanina Yaubada yana nuakalikali faifaina Efafila 'wainega 'wa nogai, iadanina to'idumwebika ta nuakalikalieni, ma fuema 'a vetofolova Keliso faifaina, kumanina tutulima i wai 'waimie. <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />We'e 'wa nuakalikaliga Yaubada 'Anu'anununa yana 'anivelena 'waimie, faifaina Efafila i vonema.<verse eid="COL 1:8" /></para>
  <para style="s">Faulo i velu'ui nuanuana me Kolose i na vetoketoke Keliso faifaina</para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />Valami 'a nogai bega tutuya fuedi 'a vevelu'ui faifaimi. Tutuyanina 'a nogai i maiga 'asiau kebu 'a da 'ailove 'a vevelu'ui Yaubada 'waineye faifaimi bega naninidi Yaubada nuanuana 'wa na 'i'idewadiga, 'wa na 'aseta-'atumaidi, wata 'Anu'anunu Magemagetana nuamageta i na velemi bega nani matatabuna 'waidie ma yami 'aseta 'wa na vevenua'ivina 'atumaina. <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />Naninidi i na velemiga, nika sauluvanidi 'Auvea yana tomotoga 'adi laubwaina 'wa na 'i'idewadi yami mia matatabuna 'waidie bega 'Auvea 'wa na kiavesosoani. 'Wa na vevesauluva 'atumaina nani tulina tulina 'waidie 'wa da vo yami mia ma vuagina wata Yaubada 'ana 'aseta i na vevebwaika 'waimie. <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />Wata 'a vevelu'ui faifaimi bega tutuya fuedi Yaubada i na kiavetoketokemi taunina yana toketokena magemagetana 'wainega, bega vita tulina tulina i na sousouyediga kebu 'wa na 'abiawa 'wa na tokemaigemi. <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />Ma yami sosoana 'wa na vevekaiwa Tamada 'waineye fai i 'ive'atumaimi bega 'ami fata 'ami veuveuta 'wa na veluagadi yana 'ai'aiwabu 'waidiega. 'Ai'aiwabunidi i 'idewadi yana tomotoga faifaida 'awaie yana 'Eba Veimea magemagetana nageneye i na veleda. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />Tamadanina i 'ita'ita'ieda Seitani yana veimea dududubalina 'wainega i sidamaneda Natuna nuafouna yana veimea 'waineye. <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" /><note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="EPH 1:7">Efe 1:7</ref></char></note>Natunanina 'wainega Yaubada i tuveobuda sakona 'wainega wata yada sakonanidi i nuatavunidi.<verse eid="COL 1:14" /></para>
  <para style="s">Keliso nani matatabuna i vebwaika-'iawedi</para>
  <para style="q1">
    <verse number="15" style="v" sid="COL 1:15" />Keliso 'asa'aiana kumanina Yaubada 'anununa,</para>
  <para style="q2" vid="COL 1:15">fai Yaubada kebu ta da 'ise'iseniga i vemageta Keliso 'wainega.</para>
  <para style="q1" vid="COL 1:15">Kelisonina Yaubada Natuna, 'eba velamu 'waineye taunina i miamia,</para>
  <para style="q2" vid="COL 1:15">Yaubada 'ana 'idewadewa matatabuda taunina 'ada to'edakumeta.<verse eid="COL 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="COL 1:16" />Taunina to'edakumeta fai 'wainega nani matatabuna tomotoga taiadi Yaubada i 'idewada.</para>
  <para style="q2" vid="COL 1:16">Naninidi abame wata fwayefwayeye.</para>
  <para style="q1" vid="COL 1:16">Naninidi ta 'ise'isediga wata kebu 'ada fata ta na 'isediga,</para>
  <para style="q2" vid="COL 1:16">bani'odi kini, tomotoga bwaikidi, toveimea tulina tulina, wata nani toketokedi i miamiani 'awasasa'aveye.</para>
  <para style="q2" vid="COL 1:16">Nani matatabuna i souyedi Keliso 'wainega, taunina yana nuanua faifaina.<verse eid="COL 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="COL 1:17" />We'e 'ana 'idewadewanidi bola kebu tamu i da souyeniga, Keliso 'akonadi i miamia,</para>
  <para style="q2" vid="COL 1:17">mulieta nani matatabuna i souyedi i 'a'avana i 'i'isave'avinidi wata i kikiavefa'alidi.<verse eid="COL 1:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="COL 1:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:18 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 1:22-23">Efe 1:22-23</ref>
      </char>
    </note>Wata Keliso kumanina toveimea yana 'Aila'a faifaina,</para>
  <para style="q2" vid="COL 1:18">'Aila'anina 'asa'aiana Keliso tomogona we'e taunina 'unu'unu.</para>
  <para style="q1" vid="COL 1:18">Keliso 'Aila'anina yana mia 'atumaina lamuna,</para>
  <para style="q2" vid="COL 1:18">wata kumanina nagami wafayega i tovoi-vaitugana.</para>
  <para style="q2" vid="COL 1:18">Begaidi nani matatabuna 'waidiega taunina 'aiseotogina i kumetaotoga.<verse eid="COL 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="COL 1:19" />Fai Yaubada nuanuana, tauniotogina i miamia Natuna 'waineye.<verse eid="COL 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="COL 1:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:20 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 2:16">Efe 2:16</ref>
      </char>
    </note>Wata Natuna yana wafa 'wainega, 'ana 'idewadewavo matatabuna i veianedi.</para>
  <para style="q1" vid="COL 1:20">Basenadi naninidi abame wata fwayefwayeye tomotoga taiadi i mia'idi Yaubada 'wainega,</para>
  <para style="q2" vid="COL 1:20">siwe Natuna yana wafa 'ai lagalagana 'waineye, dayaginega nani matatabuna i veiana Yaubada taiadi.<verse eid="COL 1:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21" />We'e 'omi basenadi yami sauluva wata yami nuanua sakoidi 'waidiega, Yaubada 'wa vedumwe'ai'aieni 'wa 'awa'idimi 'wainega. <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />Tutuya de'e Yaubada i veianemi Natuna yana wafa 'wainega. Natunanina i vetomotogaotoga i wafa faifaida bega Yaubada i na vagavaimi i na nawemi mataneye, bega 'omi magemagetami, kebu tamu yami sakona wata kebu tamu 'ami 'eba awavesako. <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />Siwe i lubwainemi yami vetumagana Keliso 'waineye fa'alina, kebu 'wa na venuanaluga wata kebu 'wa na fetoga. Tutuyanina Iesu Valana 'Atumaina 'wa nogai, 'wa vetumagana Keliso i wafa 'ami 'ita'ita'i faifaina, wata 'wa nuani mogitana 'awaie 'ami veuveuta 'atumaidi 'wa na veluagadi Yaubada 'wainega, begaidi ma yami vetumagana 'wa lulukamata. Valanina 'wa nogaiga 'akonadi Yaubada yana tomotoga i lu'ivona tomotoga matatabuna 'waidie, we'e yau Faulo a vetofolova faifaina a lalau'age.<verse eid="COL 1:23" /></para>
  <para style="s">Faulo yana folova wata yana veviga Keliso yana 'Aila'a faifaidi</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />Iesu Valana 'Atumaina a lalau'age, we'e 'ana tovedumwe'ai'aivo 'waidiega veviga a veveluagadi faifaimi, siwe ma yaku sosoana. Keliso veviga bwaikina i veluagai, siwe veviganidi bola i 'eno'enovi, bega tomogokuye veviga a veveluagai Keliso yana 'Aila'a 'alo Tomogona faifaina. <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />Yaubada i venua'ivineku a vetofolova Keliso yana 'Aila'a 'awasasamie 'ami 'aivaita faifaina. Yaku folovanina Yaubada yana Vona matatabuna a sisivemagesedi 'waimie. Yana Vonanina a lulu'ageyeniga side bani'odi. <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />Basenadi Yaubada yana nuanua givagivana kebu i da lu'ivoneyeni tomotoga 'waidie, givagivana i 'eno'eno i maiga tutuya de'e i sivemageseni yana tomotoga 'waideye. <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />I sivemageseniga fai nuanuana ta na 'asetai yana nuanuananina givagivana 'atumaiotogina wata magemagetana. Yaubada yana nuanuananina givagivana tomotoga 'ada 'aila'a tulina tulina faifaida side. Keliso i agemi nagemie i miamia, bega 'awaie abame Yaubada yana 'ai'aiwabu magemagetadi i na velemi.<verse eid="COL 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="COL 1:28" />Begaidi 'a lalau'age Keliso faifaina tomotoga matatabumi 'waimie, ma yama nuamageta nani tulina tulina faifaidi 'a vevelu'ase'ase wata 'a veve 'waimie. Nuanuama tomotoga 'aitamogana 'aitamogana Keliso taiadi i na miave'itubama i na kumaga bega 'a na vagavaidi 'a na nawedi Yaubada mataneye. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />Begaidi ma yaku tokemaiga a toke a folofolova. Keliso toketokeotogina yana toketokena i veleku, 'wainega a folofolova wata toketokenanina i folofolova 'waikuye.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="s">Keliso 'ana 'aseta 'waideye 'asa'aiana 'ai'aiwabu</para>
  <para style="m">
    <verse number="1" style="v" sid="COL 2:1" />Nuanuaku 'wa na 'asetai yaku velu'ui 'waidiega a toke a folofolova faifaimi, 'omi kebu 'aisemi faifaimi wata Iesu 'ana tovetumaganavo i miamianiga 'atamana Lodisia 'waineye faifaidi wata tovetumaganavo 'ifwaidi, kumanidiavo kebu maigiku i da 'ise'iseniga wata faifaidi a vevelu'ui. <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />A vevelu'ui faifaimi bega Yaubada i na kiavefa'alimi wata ma emiavo yami venuakalikali i na luvetubamimi. Wata nuanuaku yami 'aseta i na vebwaika bega Yaubada yana nuanua givagivana 'wa na 'aseta-'atumaia. De'e naninina bani'odi kukuafou, fai nuanuananina givagivana 'asa'aiana taunina Keliso. <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />Yaubada yana 'ai'aiwabu givagivadi bani'odi nuamageta wata 'aseta matatabuna Keliso 'aiseotogina 'waineye i 'eno'eno. <verse eid="COL 2:3" /><verse number="4" style="v" sid="COL 2:4" />Naninidi a vonevonemi, kebu nuanuaku tamu aitoi i na vekaliemi bonana 'adi nogaya 'eba nua'ewa 'waidiega. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />Yau kebu taiadi ta da miamia, siwe nuaku i viwai 'waimie wata a sososoana fai yami nuanua 'aitamogana 'wainega matatabumi 'wa tovotovoi fa'alina, wata yami vetumagana Keliso 'waineye toketokena.<verse eid="COL 2:5" /></para>
  <para style="s">Mia 'ivauna wata 'atumaina ta veluagai Keliso 'wainega</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />Basenadi ma yami vetumagana taunimi 'wa tauyemi Iesu Keliso 'waineye, taunina 'ami Toveimea, i lubwainemi tutuya de'e wata bani'odi yami mia matatabuna 'waidie ma yami vetumagana, taunimi 'wa na tauyemi 'waineye 'wa na miave'itubama taiadi. <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />Welavi yadi 'eba vetoketoke 'walamidi, wata bani'odi taunimi 'wa na tauyemi Keliso 'waineye bega i na 'i'ivefa'alimi wata i na kikiavetoketokemi. Yami vetumagana 'waineye i na vevebwaika bega 'wa na tovotovoi fa'alina, basenadi bani'odi Yaubada yana tomotoga i ve 'waimie. Wata tutuya fuedi 'wa na vevekaiwa Yaubada 'waineye.<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />Taunimi 'wa na 'i'isave'avinimi kebu tamu aitoi nuami i na 'ewadi yadi ve igodi 'eba 'aseta 'waidiega, we'e mogitana venidi i na yogonimi kebu 'eba 'aivaita. Yadi venidi kebu i da mai Keliso 'wainega, we'e mogitana tomotoga yadi ve, i mai tubudiavo 'waidiega, wata yaiainanidi ma yadi veimea i miamia fwayefwayeye.<verse eid="COL 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 2:9" />Ve-vekavekalinidi 'wa na bailedi fai Yaubada tauniotogina i miamia Keliso nageneye, Keliso kumanina i vetomotogaotoga. <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />We'e 'omi Keliso taiadi 'wa miave'itubama, mia 'ivauna wata 'atumaina 'wa veluagadi, kebu tamu ava'ai 'wainega 'wa da ve'ale'usa. Keliso yana veimea toketokeotogina, kebu toveimea tulina tulina, wata yaiaina taiadi i da vesala, matatabuna 'waidiega taunina 'aiseotogina i 'edakumetaotoga.<verse eid="COL 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="COL 2:11" />Me Diu i vonavona i vo, Yaubada yana tugusa bunu 'aibobo 'a 'ewaiga, 'ima yana tomotoga mogitana." We'e 'omi, tutuyanina 'wa miave'itubama Keliso taiadi, kebu bunu 'aibobo 'wa da 'ewaiga tomotoga 'waidiega, we'e Keliso yami nuanua sakoidi nagami, i si'a'idi bega 'wa da vo nuanuananidi sakoidi i da boboyavuledi. <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" /><note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="ROM 6:4">Lom 6:4</ref></char></note>Wata side bani'odi. Keliso i wafaga i ve'ufai, wata bani'odi 'omi 'wa bafitaiso Iesu taiadi 'wa wafa i ve'ufami. Tutuyanina Yaubada Iesu i sivetovoia, 'omi 'wa vetumaganaga Yaubada yana toketokena 'waineye, taiadi i sivetovoimi nika mia 'ivauna wata 'atumaina 'wa veluagai.<verse eid="COL 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="COL 2:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:13 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 2:1-5">Efe 2:1-5</ref>
      </char>
    </note>Basenadi 'anu'anunumi wafadi fai 'wa sakosakona, yami nuanua sakoidi bola kebu 'wa da si'a'idi. Siwe Yaubada Keliso i sivetovoia, 'omi wata bani'odi mia 'ivauna wata miamia-vagaina i velemi wata yada sakona matatabuna i nuatavunidi. <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" /><note caller="-" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="EPH 2:15">Efe 2:15</ref></char></note>Basenadi Yaubada yana veimea ta geugeudi, yada sakonanidi 'adi tutula i lubwaineda ta da wafa, siwe Keliso yana wafa 'wainega yada sakonanidi i 'u'umidi, 'wa da vo yada sakona kilukilumidi i da 'ewayavuledi i da tutufwasedi 'ai lagalagana 'waineye, nika bei i ve'a'avadi. <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />Keliso yana wafanina 'wainega, Seitani ma enavo yaiaina yadi toketokena i ve'a'avadi, tomotoga matatabudi 'waidie i lu'ivevenedi nika i bunumayaga.<verse eid="COL 2:15" /></para>
  <para style="s">Venidi tomotoga yadi nuanuayega 'wa na bailedi</para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:16 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 14:1-6">Lom 14:1-6</ref>
      </char>
    </note>Fai Keliso i vetoketoke bega a na vonemi. 'Ai'edi aitoi i na awavesakoyemi nani 'ifwaidi 'wa 'ani'anidi 'alo 'wa yemuyemudi faifaidi, kebu bonadi 'wa na nogaidi. Wata 'ai'edi i na lukakademi bega lusakali tulina tulina tafalolo faifaina, 'wa na 'i'idewadi, 'alo Weta'i 'Ivauna 'ana tafalolo, me Diu yadi 'Aiata Veawai 'wa na veve'ililibuyeniga, kebu bonadi 'wa na nogaidi. <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />Veimeanidi de'e 'a'a'avidi, i 'eno'enovi nika Keliso i souyeni. Naninidi bani'odi 'anunu, we'e Keliso mogitana tauniotogina. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />Tomotoga 'ifwaidi igodina tonuaobu i 'odu'odu anelose 'waidie, 'ai'edi i na awavesakoyemiga kebu bonadi 'wa na nogaidi. Tutuya fuedi ma yadi nualaka 'adi ve i veveifufu-dewedi i vo 'ako Yaubada nani fuedi i sivemagesedi 'waidie, we'e mogitana taunidi yadi nuanua-vekavekali 'waidiega i sousouyedi. <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" /><note caller="-" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="EPH 4:16">Efe 4:16</ref></char></note>Tomotoganidi yadi miave'itubama Keliso taiadi, 'akonadi i 'awa'ididi 'wainega. Keliso taunina 'unu'unu, we'e 'ida, yana 'Aila'a 'alo Tomogona. Yana toketokena 'wainega 'ida du'u tulina tulina ta tubwa 'waineye i 'i'ive'avinida wata i 'i'isave'avinida. Wata Yaubada yana toketokena 'wainega 'ida Keliso Tomogona ta vevebwaika wata ta vevetoketoke Yaubada yana nuanua bani'odi.<verse eid="COL 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />Tutuyanina Keliso i wafa, 'omi taiadi 'wa wafa, i yavumi Seitani ma enavo yaiaina 'waidiega, kumanidiavo ma yadi veimea fwayefwayeye. Mogitana i yavumi siwe awale yami sauluva 'wa da vo fwayafwaya 'ana nuanua i da vebwaika 'waimie? Naninidi tomotoga 'aisedi yadi nuanuayega i talabodedi, awale tomotoganidi 'wa vematayakeyakedi? <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />Yadi talabodanidi i vo, Nani de'e tabutabuna, kebu 'wa na 'abitonovi. 'Ani'ani de'e tabutabuna, kebu 'wa na 'ania." <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />Naninidi tomotoga i talabodediga nani-'avo'avovo, 'a'a'avidi. Ve'etobodanidi tomotoga yadi nuanua wata yadi ve 'waidiega i sousouyedi, kebu Yaubada 'wainega. <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />Tomotoganidi i veve 'waimie i vo, I lubwainemi taunimi 'wa na kiaobuyemi wata ma yami ve'ililibu 'wa na 'odu'odu anelose 'waidie. Taunimi tomogomi 'wa na nikenikedi bega nuagiva sakoidi 'waimie i 'eno'enovi i na 'a'ava." Yadi vonanidi 'adi nogaya 'wa da vo taunidi tonuamageta, we'e mogitana kebu 'eba 'aivaita, kebu 'ana fata nuagiva sakoidi 'wa na talabodedi taunimi 'ami 'ivekokova 'wainega.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="s">Keliso ma yana 'ai'aiwabu mataududulina i na souyeniga, wata 'ida taiadi</para>
  <para style="m">
    <verse number="1" style="v" sid="COL 3:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 110:1">Sam 110:1</ref>
      </char>
    </note>Keliso i wafa Yaubada i sivetovoia i laka abame ma yana veimea i miabui Yaubada 'ana 'atagiega. 'Omi wata bani'odi i sivetovoimi Keliso taiadi mia 'ivauna wata miamia-vagaina i velemi, begaidi i lubwainemi yami nuanua i na nunago abama 'ana nuanua 'waineye. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />Nuanuaku abama 'ana nuanua nuami i na 'ewaotogidi, we'e fwayafwaya 'ana nuanua kebu i na vebwaika 'waimie. <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />Bani'odi 'wa na nuanuayediga fai tutuyanina Keliso i wafa wata bei 'omi 'wa wafa. Tutuya de'e Yaubada taiadi 'wa miave'itubama, nageneye 'wa givagiva Keliso taiadi. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />We'e Keliso taunina yami mia 'ivauna wata miamia-vagaina lamuna, 'awaie ma yana 'ai'aiwabu magemagetana i na souyeniga, 'omi taiadi 'wa na souyemi, yana 'ai'aiwabunina i na velemi.<verse eid="COL 3:4" /></para>
  <para style="s">Sauluva sakoidi 'wa na bailedi, 'ivaudi 'wa na 'ewadi</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />Fai Keliso taiadi 'wa miave'itubama, i lubwainemi fwayafwaya 'ana nuanua sakoidi 'wa na bailediga 'wa da vo 'waidiega 'wa da wafa, bega kebu 'wa na ve'avula-'avo'avovo, sakona tulina tulina 'eba bunumayaga wata bunu 'ana nuanua sakoidi taiadi 'wa na bailedi. Naninidi sakoidi kebu faifaidi 'wa na nuagiva wata kukua 'adi nuanua kebu 'waimie i na vebwaika. Tomotoganidi kukua nuadi i 'ewadiga, mogitana i sakona fai kukua 'adi nuakalikali 'waidie bwaikina, 'wa da vo 'waidie i da 'odu'odu, we'e Yaubada i da baileni. <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />Egavo sauluvanidi i na 'i'idewadiga, taunidi Yaubada yana nuanua 'adi tovedumwe'ai'ai, 'awaie ma yana nuasako vematavuloga i na veledi. <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />Basenadi 'omi tovedumwe'ai'ainidi 'wa saladi, taunimi 'wa tauyemi sauluvanidi sakoidi 'waidie.<verse eid="COL 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 3:8" />Tutuya de'e i lubwainemi sauluva sakoidi matatabuna 'wa na bailedi. Kebu 'wa na nunuasakoga, kebu kamomi i na ogaogalaga wata kebu tamu aitoi 'wa na tolive'edeni bega vita i na veluagai. Kebu 'wa na vebonaivo wata vona sakoidi kebu 'awamiega i na sousouyedi. <verse eid="COL 3:8" /><verse number="9-10" style="v" sid="COL 3:9-10" /><note caller="-" style="x"><char style="xo" closed="false">3:9-10 </char><char style="xt" closed="false"><ref loc="GEN 1:26">Nag 1:26</ref>; <ref loc="EPH 4:22">Efe 4:22</ref>,<ref loc="EPH 4:24">24</ref> </char></note>Kebu emiavo 'wa na vekaliedi fai yami nuanua sakoidi nagami, sauluva sakoidi taiadi 'akonadi 'wa si'a'idi, ma'itufa yami nuanua 'ivaudi 'wa ve'wesenedi. Yami nuanuananidi 'ivaudi 'adi to'idewadewa Yaubada, tutuya fuedi i 'i'ive'ivaudi taunina yana nuanua bani'odi, bega taunina 'wa na 'aseta'a'avai wata taiadi 'wa na veiana. <verse eid="COL 3:9-10" /><verse number="11" style="v" sid="COL 3:11" />Fai Yaubada yada nuanua i 'ive'ivaudi ta luku yana 'Aila'a 'waineye, matatabuda ta vesala mataneye, me Diu wata taunidi kebu me Diu, taunidi bunu 'aibobo i 'ewaiga wata kebu i da 'ewaiga, yavuyavula wata tobavu, tofolova-maimaiga wata tomotoga yavuyavudi, matatabuda Keliso i ageda bega kebu ta na lau'idi, 'aiseotogina 'ada toveimea bwaikina.<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:12 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:2">Efe 4:2</ref>
      </char>
    </note> Fai Yaubada i venua'ivinemi bega 'omi yana tomotoga magemagetami i nuakalikaliemi, begaidi i lubwainemi side naninidi 'wa na 'i'idewadi. 'Wa na 'i'isanuakalikali, ma yami nuakalikali 'wa na vevesauluva 'atumaina tomotoga 'waidie, 'wa na nunuaobu, yami sauluva i na bika, 'ai'edi egavo i na vesauluva sakoina 'waimie, ma yami tokemaiga 'wa na nuakalikaliedimo. <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" /><note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EPH 4:32">Efe 4:32</ref></char></note>Ma emiavo 'wa na ve'ivaivaita kebu 'wa na logiedi, emiavo i na vesauluva sakoina 'waimie 'wa na nuatavunidi. Yada 'Auvea i nuatavunimi, i lubwainemi 'omi wata emiavo 'wa na nuatavunidi. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />De'e sauluvanidi 'atumaidi 'wa na 'i'idewadi, siwe ma yami nuakalikali. Nuakalikalinina i na 'itavimi, 'wainega 'wa na luvetubama.<verse eid="COL 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 3:15" />Keliso 'akonadi nuanua bikana i velemi, begaidi i lubwaineni yami nuanua 'waidie i na veveimea bega yana 'aivaita 'wainega i na vevemi ava'ai yana nuanua 'wa na 'i'idewadi. Matatabumi Keliso yana 'Aila'a 'aitamogana, Yaubada i vagavaimi bega yami sauluva bikanega ma emiavo 'wa na veveiana. Wata tutuya fuedi 'wa na vevekaiwa Yaubada 'waineye. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" /><note caller="-" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="EPH 5:19-20">Efe 5:19-20</ref></char></note>I lubwainemi Keliso Valana 'Atumaina nuami i na 'ewadi, bega ma yami nuamageta nani matatabuna faifaidi emiavo 'waidie 'wa na veve wata 'wa na awave'eda'eda. Same Yaubada yana Buki 'wainega, lei 'eba subia wata lei 'Anu'anunu Magemagetana yana 'alavelevelena 'wainega 'wa na leileiedi wata nuamiega 'wa na vevekaiwa Yaubada 'waineye. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />Fai 'omi 'ada Toveimea Iesu yana tomotoga, ava'ai 'wa na 'i'idewadi bonamiega 'alo nimamiega, sauluvanidi matatabuna 'wa na 'i'idewadi 'ana wagavayega wata 'wa na vevekaiwa Keliso 'waineamo Yaubada Tamada 'waineye.<verse eid="COL 3:17" /></para>
  <para style="s">Keliso yana 'Aila'a 'ada veimea wata 'ada awave'eda'eda</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:18 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:22">Efe 5:22</ref>; <ref loc="1PE 3:1">1Fi 3:1</ref></char>
    </note>'Omi vevine naginagimi, fai 'omi Keliso yana tomotoga, i lubwainemi taunimi 'wa na tauyemi yami lalamogavo yadi nuanua 'wa na 'i'idewadi.<verse eid="COL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:19 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:25">Efe 5:25</ref>; <ref loc="1PE 3:7">1Fi 3:7</ref></char>
    </note>We'e 'omi iaveta naginagimi yami vevinevo 'wa na nunuakalikaliedi wata kebu vita 'wa na velediga.<verse eid="COL 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:20 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:1">Efe 6:1</ref>
      </char>
    </note>We'e 'omi yavayavava nani matatabuna 'waidie, tamamiavo wata inamiavo 'wa na vevematayakeyakedi nika 'ada Toveimea Iesu i na sosoana faifaimi.<verse eid="COL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:21 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:4">Efe 6:4</ref>
      </char>
    </note>We'e 'omi tamadiavo, natumiavo kebu 'wa na yagai-maimaigidi, i na nunago i na nuavita wata i na vedumwe'ai'ai.<verse eid="COL 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:22 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:5-8">Efe 6:5-8</ref>
      </char>
    </note>We'e 'omi tofolova-maimaiga, 'ami toveimeavo yadi veimea 'wa na vevematayakeyakedi nani matatabuna 'waidie. 'Ai'edi 'ami toveimeavo i na 'ise'isemi 'alo kebu, tutuya matatabuna yami sauluva 'waidiega 'wa na kiavesosoanidi. Fai 'ami Toveimea abame 'wa veve'ililibuyeni, ma yami 'idumwebika 'wa na folofolova. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />Ava'ai folovaga 'wa na 'i'idewaiga, ma yami sosoana 'wa na toke 'wa na folova, kebu tomotoga 'aisedi 'waidie 'wa da folofolova, we'e mogitana 'ami Toveimea Keliso 'waineye 'wa folofolova. <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />Vona mogitana 'wa na toke 'wa na folova fai 'awaie 'ami Toveimea Keliso abame i na tutulimi, naninidi 'atumaidi i yatodiga yana tomotoga faifaidi 'waidiega. I na tutulimi fai taunina 'ami Toveimea mogitana. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" /><note caller="-" style="x"><char style="xo" closed="false">3:25 </char><char style="xt" closed="false"><ref loc="DEU 10:17">VeL 10:17</ref>; <ref loc="EPH 6:9">Efe 6:9</ref></char></note>Egavo sauluva sakoidi i 'i'idewadi wata 'adi tutula nani sakoidi i na veluagai Yaubada 'wainega. Yaubada kebu i da lau'idi, mataneye tomotoga bwaikidi wata siaidi i vesala, bega matatabuda tutula ta na veluagai.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="m">
    <verse number="1" style="v" sid="COL 4:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:9">Efe 6:9</ref>
      </char>
    </note>We'e 'omi toveimea, 'wa na vevesauluva 'atumaina yami tofolova-maimaiga 'waidie wata 'adi 'aivaita 'wa na veleveledi 'eda'eda mogitana 'waineamo. 'Wa na nuani 'omi wata ma 'ami Toveimea, i miamia abame.<verse eid="COL 4:1" /></para>
  <para style="s">Faulo yana velu'ase'ase velu'ui wata vona 'atumaina faifaidi</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />Tutuya fuedi 'wa na vevelu'ui Yaubada 'waineye kebu 'wa na 'ailove. Yami velu'ui 'waidie, kebu yami nuanua i na nunago mali nuanua 'waidie, Yaubada 'aisena faifaina 'wa na nuanua wata 'waineye 'wa na vevekaiwa. <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />Wata yami velu'ui 'waidie, faifaima 'wa na vevelu'ui bega Yaubada tamu 'eda'eda 'atumaina i na 'idewai, nika 'ama fata yana Vona 'a na lalau'age tomotoga 'waidie. Vonanina Keliso faifaina basenadi givagivana, siwe tutuya de'e i sivemageseni. Keliso faifaina a lalau'age, begaidi 'ana tovedumwe'ai'ai i yatoku vanuga yogona nageneye a miamia. <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />I lubwaineku Keliso valana faifaina a na lalau'age, begaidi nuanuaku 'wa na vevelu'ui faifaiku bega 'aku fata a na kiavemageta 'atumaina nika 'ana 'aseta safailina wata magemagetana.<verse eid="COL 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 4:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:5 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:16">Efe 5:16</ref>
      </char>
    </note>Tomotoganidi kebu i da vetumagana taiadi 'wa na miamiaga, ma yami nuamageta 'wa na vevesauluva 'atumaina 'waidie. 'Ai'edi tutuya 'atumaina 'wa na veluagai, bei 'wa na lu'ivona Keliso faifaina. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />Tutuya matatabuna yami vona 'adi nogaya 'atumaidi wata nua'ewa'ewadi bega 'ai'edi aitoi i na velutoliemi yami 'aseta Keliso faifaina, yami tutula 'atumai'avana.<verse eid="COL 4:6" /></para>
  <para style="s">Faulo yana 'alanuai</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:7 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:4">Fol 20:4</ref>; <ref loc="EPH 6:21-22">Efe 6:21-22</ref>; <ref loc="2TI 4:12">2Ti 4:12</ref></char>
    </note>Iada Tikiasa i na wai valaku matatabuna i na lu'ivona 'waimie. Taunina iada mogitana, ma fuema 'a folofolova 'ada Toveimea Iesu faifaina wata taunina Iesu 'ana to'idumwebika ma 'ana vetumagana. <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />A vevetunei 'waimie bega 'ama vebae wata ava'ai 'a 'i'idewai i na lu'ivoneyedi 'waimie wata i na kiavefa'alimi. <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" /><note caller="-" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="PHM 1:10-12">Fmi 1:10-12</ref></char></note>Wata Onesimo taiadi i na wai, taunina iada mogitana Iesu 'ana to'idumwebika ma 'ana vetumagana wata taunina tamu 'ami 'aila'a. 'Adi 'ailuga i na lu'ivona 'waimie naninidi i sousouyediga 'waimeye faifaidi.<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10-11" style="v" sid="COL 4:10-11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:10-11 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 12:12">Fol 12:12</ref>,<ref loc="ACT 12:25">25</ref>, <ref loc="ACT 13:13">13:13</ref>, <ref loc="ACT 15:37-39">15:37-39</ref>, <ref loc="ACT 19:29">19:29</ref>, <ref loc="ACT 27:2">27:2</ref>; <ref loc="PHM 1:24">Fmi 1:24</ref></char>
    </note>Alisitako, kumanina taiadi 'a miamia vanuga yogona de'e 'waineye, Malika Banabasa nibaina wata Iosua tamu 'ana wagava Iusito, 'adi 'aitonu i vekaiwa 'waimie. Me Diu 'waidiega 'asa'aiana 'adi 'aitonunidi 'aku tofolova-vaita taiadi 'a folofolova bega Yaubada yana veimea i na vebwaika tomotoga 'waidie. Taunidi mogitana 'aku tokiavesosoana. We'e Malika, 'akonadi faifaina yaku vona i wai, 'ai'edi i na viwai i na le'waga, ma yami sosoana 'wa na lu'uma'umaieni.<verse eid="COL 4:10-11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 4:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:12 </char>
      <char style="xt" closed="false">
        <ref loc="COL 1:7">Kol 1:7</ref>; <ref loc="PHM 1:23">Fmi 1:23</ref></char>
    </note>Efafila, taunina wata tamu 'ami 'aila'a wata Iesu Keliso yana tofolova, i vekaiwa 'waimie. Tomogonina tutuya fuedi ma yana tokemaiga i vevelu'ui faifaimi, nuanuana ma yami vetumagana 'wa na tovotovoi fa'alina, 'wa na kumaga wata Yaubada yana nuanua matatabuna 'wa na 'aseta-'atumaidi wata 'wa na 'i'idewadi. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />Efafila a veveifufuyeni, fai nuanuaku 'wa na 'asetai taunina i toke i folofolova 'ami 'aivaita faifaina wata tovetumaganavo i miamiani 'atamana Lodisia wata Ilafolisi faifaidi.<verse eid="COL 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="COL 4:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:14 </char>
      <char style="xt" closed="false">
        <ref loc="2TI 4:10-11">2Ti 4:10-11</ref>; <ref loc="PHM 1:24">Fmi 1:24</ref></char>
    </note>Luke kumanina viga 'adi to'ive'atumai, iada mogitana wata Dimasi, 'adi 'ailuga i vekaiwa 'waimie.<verse eid="COL 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 4:15" />Nuanuama yama vekaiwa 'wa na lu'ivona Nimufa 'waidie wata edavo tovetumaganavo 'waidie kumanidiavo i miamiani 'atamana Lodisia. Vavinenidi yadi vanuge tovetumaganavo i vava'auta velu'ui faifaina, wata 'waidie 'wa na lu'ivona yama vekaiwa.<verse eid="COL 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 4:16" />Tutuyanina lubulubu de'e 'wa na lu'iawawa-'a'avai, 'wa na vetunei i na nago Lodisia wata bei i na lu'iawawai. We'e lubulubunina a vetunei i nago Lodisia wata i na vetunei i na wai 'waimie bega 'wa na lu'iawawai.<verse eid="COL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="COL 4:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:17 </char>
      <char style="xt" closed="false">
        <ref loc="PHM 1:2">Fmi 1:2</ref>
      </char>
    </note>Wata nuanuaku Akifasi 'wa na voneni 'wa na vo, 'Omu 'ada Toveimea Keliso taiadi 'wa miave'itubama bega folovanina i velemuga 'u na ve'a'avai."<verse eid="COL 4:17" /></para>
  <para style="pmc">
    <verse number="18" style="v" sid="COL 4:18" />De'e bei yaku lubulubu 'ana tokiluma a voneni i 'ailove, tauniku a na ve'a'avai. Yau Faulo de'e nimaku, a vekaiwa 'waimie.</para>
  <para style="pmc" vid="COL 4:18">'Wa na nuanuaniku faifaiku 'wa na vevelu'ui fai yau vanuga yogona nageneye a miamia.</para>
  <para style="pmc" vid="COL 4:18">A vevelu'ui faifaimi, nuanuaku Yaubada ma yana nuakalikali i na vevesauluva 'atumaina 'waimie.</para>
  <para style="b" vid="COL 4:18" />
  <para style="pmc" vid="COL 4:18">'Asa'aiana bani'odi,</para>
  <para style="q2" vid="COL 4:18">
    <char style="sig">Faulo</char>
    <verse eid="COL 4:18" />
  </para>
  <chapter eid="COL 4" />
</usx>