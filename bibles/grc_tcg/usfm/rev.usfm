\v 3 \w Μακάριος|strong="G3107"\w* \w ὁ|strong="G3588"\w* \w ἀναγινώσκων|strong="G0314"\w*, \w καὶ|strong="G2532"\w* \w οἱ|strong="G3588"\w* \w ἀκούοντες|strong="G0191"\w* \w τοὺς|strong="G3588"\w* \w λόγους|strong="G3056"\w* \w τῆς|strong="G3588"\w* \w προφητείας|strong="G4394"\w* \w καὶ|strong="G2532"\w* \w τηροῦντες|strong="G5083"\w* \w τὰ|strong="G3588"\w* \w ἐν|strong="G1722"\w* \w αὐτῇ|strong="G0846"\w* \w γεγραμμένα|strong="G1125"\w*· \w ὁ|strong="G3588"\w* \w γὰρ|strong="G1063"\w* \w καιρὸς|strong="G2540"\w* \w ἐγγύς|strong="G1451"\w*.   
\s1 Greeting to the Seven Churches  
\p
\v 4 \f + \fr 1:4 \ft ιωαννης \+bd 𝔐\+bd*\+sup A,C,K\+sup* [98.6%] ¦ ιωανης WH [0.5%]\f*\w Ἰωάννης|strong="G2491"\w* \w ταῖς|strong="G3588"\w* \w ἑπτὰ|strong="G2033"\w* \w ἐκκλησίαις|strong="G1577"\w* \w ταῖς|strong="G3588"\w* \w ἐν|strong="G1722"\w* \w τῇ|strong="G3588"\w* \w Ἀσίᾳ|strong="G0773"\w*· \w χάρις|strong="G5485"\w* \w ὑμῖν|strong="G4771"\w* \w καὶ|strong="G2532"\w* \w εἰρήνη|strong="G1515"\w* \w ἀπὸ|strong="G0575"\w* \f + \fr 1:4 \ft θεου \+bd 𝔐\+bd*\+sup K\+sup* 51.5% ¦ του TR 8.4% ¦ — \+bd 𝔐\+bd*\+sup A,C\+sup* CT PCK 37.4%\f*\w Θεοῦ|strong="G2316"\w* \w ὁ|strong="G3588"\w* \w ὢν|strong="G3739"\w* \w καὶ|strong="G2532"\w* \w ὁ|strong="G3588"\w* \w ἦν|strong="G1510"\w* \w καὶ|strong="G2532"\w* \w ὁ|strong="G3588"\w* \w ἐρχόμενος|strong="G2064"\w*· \w καὶ|strong="G2532"\w* \w ἀπὸ|strong="G0575"\w* \w τῶν|strong="G3588"\w* \w ἑπτὰ|strong="G2033"\w* \w πνευμάτων|strong="G4151"\w* \f + \fr 1:4 \ft α \+bd 𝔐\+bd*\+sup K\+sup* [50%] ¦ α εστιν \+bd 𝔐\+bd*\+sup A,C\+sup* PCK TR [40.8%] ¦ των MSS [6.4%]\f*\w ἃ|strong="G3739"\w* \w ἐνώπιον|strong="G1799"\w* \w τοῦ|strong="G3588"\w* \w θρόνου|strong="G2362"\w* \w αὐτοῦ|strong="G0846"\w*·  
\v 5 \w καὶ|strong="G2532"\w* \w ἀπὸ|strong="G0575"\w* \w Ἰησοῦ|strong="G2424"\w* \w Χριστοῦ|strong="G5547"\w*, \w ὁ|strong="G3588"\w* \w μάρτυς|strong="G3144"\w* \w ὁ|strong="G3588"\w* \w πιστός|strong="G4103"\w*, \w ὁ|strong="G3588"\w* \w πρωτότοκος|strong="G4416"\w* \f + \fr 1:5 \ft των \+bd 𝔐\+bd*\+sup A−,K\+sup* [72.5%] ¦ εκ των \+bd 𝔐\+bd*\+sup A+,C\+sup* PCK TR [27.1%]\f*\w τῶν|strong="G3588"\w* \w νεκρῶν|strong="G3498"\w*, \w καὶ|strong="G2532"\w* \w ὁ|strong="G3588"\w* \w ἄρχων|strong="G0758"\w* \w τῶν|strong="G3588"\w* \w βασιλέων|strong="G0935"\w* \w τῆς|strong="G3588"\w* \w γῆς|strong="G1093"\w*.  
\p \w Τῷ|strong="G3588"\w* \f + \fr 1:5 \ft αγαπωντι \+bd 𝔐\+bd*\+sup K\+sup* [54.6%] ¦ αγαπησαντι \+bd 𝔐\+bd*\+sup A,C\+sup* PCK TR [39.4%]\f*\w ἀγαπῶντι|strong="G0025"\w* \w ἡμᾶς|strong="G1473"\w*, \w καὶ|strong="G2532"\w* \f + \fr 1:5 \ft λουσαντι \+bd 𝔐\+bd*\+sup A−,C,K\+sup* [67%] ¦ λυσαντι \+bd 𝔐\+bd*\+sup A+\+sup* ECM\+sup †\+sup* NA SBL TH WH [26.1%]\f*\w λούσαντι|strong="G3068"\w* \w ἡμᾶς|strong="G1473"\w* \f + \fr 1:5 \ft απο \+bd 𝔐\+bd*\+sup C,K\+sup* [70.2%] ¦ εκ \+bd 𝔐\+bd*\+sup A\+sup* ECM\+sup †\+sup* NA SBL TH WH [29.4%]\f*\w ἀπὸ|strong="G0575"\w* \w τῶν|strong="G3588"\w* \w ἁμαρτιῶν|strong="G0266"\w* \w ἡμῶν|strong="G1473"\w* \w ἐν|strong="G1722"\w* \w τῷ|strong="G3588"\w* \w αἵματι|strong="G0129"\w* \w αὐτοῦ|strong="G0846"\w*·  
\v 6 \w καὶ|strong="G2532"\w* \w ἐποίησεν|strong="G4160"\w* \w ἡμᾶς|strong="G1473"\w* \f + \fr 1:6 \ft βασιλειαν \+bd 𝔐\+bd*\+sup C,K\+sup* [69.7%] ¦ βασιλεις και \+bd 𝔐\+bd*\+sup A\+sup* TR [22%]\f*\w βασιλείαν|strong="G0932"\w*, \w ἱερεῖς|strong="G2409"\w* \w τῷ|strong="G3588"\w* \w Θεῷ|strong="G2316"\w* \w καὶ|strong="G2532"\w* \w πατρὶ|strong="G3962"\w* \w αὐτοῦ|strong="G0846"\w*· \w αὐτῷ|strong="G0846"\w* \w ἡ|strong="G3588"\w* \w δόξα|strong="G1391"\w* \w καὶ|strong="G2532"\w* \w τὸ|strong="G3588"\w* \w κράτος|strong="G2904"\w* \w εἰς|strong="G1519"\w* \w τοὺς|strong="G3588"\w* \w αἰῶνας|strong="G0165"\w* \f + \fr 1:6 \ft των αιωνων \+bd 𝔐\+bd*\+sup A+,C,K\+sup* 82.5% ¦ — \+bd 𝔐\+bd*\+sup A−\+sup* WH 15.2%\f*\w τῶν|strong="G3588"\w* \w αἰώνων|strong="G0165"\w*. \w Ἀμήν|strong="G0281"\w*.  
\v 7 \w Ἰδού|strong="G3708"\w*, \w ἔρχεται|strong="G2064"\w* \w μετὰ|strong="G3326"\w* \w τῶν|strong="G3588"\w* \w νεφελῶν|strong="G3507"\w*, \w καὶ|strong="G2532"\w* \w ὄψεται|strong="G3708"\w* \w αὐτὸν|strong="G0846"\w* \w πᾶς|strong="G3956"\w* \w ὀφθαλμός|strong="G3788"\w*, \w καὶ|strong="G2532"\w* \w οἵτινες|strong="G3748"\w* \w αὐτὸν|strong="G0846"\w* \w ἐξεκέντησαν|strong="G1574"\w*· \w καὶ|strong="G2532"\w* \w κόψονται|strong="G2875"\w* \w ἐπ|strong="G1909"\w*᾽ \w αὐτὸν|strong="G0846"\w* \w πᾶσαι|strong="G3956"\w* \w αἱ|strong="G3588"\w* \w φυλαὶ|strong="G5443"\w* \w τῆς|strong="G3588"\w* \w γῆς|strong="G1093"\w*. \w Ναί|strong="G3483"\w*, \w ἀμήν|strong="G0281"\w*.   
\p
\v 8 \w Ἐγώ|strong="G1473"\w* \w εἰμι|strong="G1510"\w* \w τὸ|strong="G3588"\w* \f + \fr 1:8 \ft αλφα \+bd 𝔐\+bd*\+sup A−,C,K\+sup* [71%] ¦ Α \+bd 𝔐\+bd*\+sup A+\+sup* ANT TR [29%]\f*\wj \+w Ἄλφα|strong="G0001"\+w* \+w καὶ|strong="G2532"\+w* \+w τὸ|strong="G3588"\+w*\wj* \f + \fr 1:8 \ft Ω \+bd 𝔐\+bd*\+sup C,K\+sup* 63.7% ¦ Ω αρχη και τελος \+bd 𝔐\+bd*\+sup A\+sup* TR 22.5% ¦ Ω η αρχη και το τελος MSS 9.9%\f*\wj \+w Ὦ|strong="G3739"\+w*,\wj* \w λέγει|strong="G3004"\w* \f + \fr 1:8 \ft κυριος ο θεος \+bd 𝔐\+bd*\+sup A,C,K\+sup* [96.8%] ¦ ο κυριος TR [1.8%]\f*\w Κύριος|strong="G2962"\w* \w ὁ|strong="G3588"\w* \w Θεός|strong="G2316"\w*, \wj \+w ὁ|strong="G3588"\+w* \+w ὢν|strong="G3739"\+w* \+w καὶ|strong="G2532"\+w* \+w ὁ|strong="G3588"\+w* \+w ἦν|strong="G1510"\+w* \+w καὶ|strong="G2532"\+w* \+w ὁ|strong="G3588"\+w* \+w ἐρχόμενος|strong="G2064"\+w*, \+w ὁ|strong="G3588"\+w* \+w παντοκράτωρ|strong="G3841"\+w*.\wj*   
\s1 John's Vision of Christ  
\p
\v 9 \w Ἐγὼ|strong="G1473"\w* \f + \fr 1:9 \ft ιωαννης \+bd 𝔐\+bd*\+sup A,C,K\+sup* [99.1%] ¦ ιωανης WH [0.9%]\f*\w Ἰωάννης|strong="G2491"\w*, \w ὁ|strong="G3588"\w* \f + \fr 1:9 \ft αδελφος \+bd 𝔐\+bd*\+sup A,C,K\+sup* [99.1%] ¦ και αδελφος TR [0.9%]\f*\w ἀδελφὸς|strong="G0080"\w* \w ὑμῶν|strong="G4771"\w* \w καὶ|strong="G2532"\w* \f + \fr 1:9 \ft κοινωνος\+bd 𝔐\+bd*\+sup C,K\+sup* [56.4%] ¦ συγκοινωνος \+bd 𝔐\+bd*\+sup A\+sup* ANT ECM\+sup †\+sup* NA SBL TR [39.9%] ¦ συνκοινωνος TH WH [3.2%]\f*\w κοινωνὸς|strong="G2844"\w* \w ἐν|strong="G1722"\w* \w τῇ|strong="G3588"\w* \w θλίψει|strong="G2347"\w* \w καὶ|strong="G2532"\w* \f + \fr 1:9 \ft βασιλεια \+bd 𝔐\+bd*\+sup C,K\+sup* [72.1%] ¦ εν τη βασιλεια \+bd 𝔐\+bd*\+sup A\+sup* TR [25.6%]\f*\w βασιλείᾳ|strong="G0932"\w* \w καὶ|strong="G2532"\w* \w ὑπομονῇ|strong="G5281"\w* \f + \fr 1:9 \ft εν χριστω ιησου \+bd 𝔐\+bd*\+sup C,K\+sup* 66.1% ¦ ιησου χριστου \+bd 𝔐\+bd*\+sup A\+sup* TR 25.7% ¦ εν ιησου CT 3.9% ¦ εν ιησου χριστω ANT 0.4%\f*\w ἐν|strong="G1722"\w* \w Χριστῷ|strong="G5547"\w* \w Ἰησοῦ|strong="G2424"\w*, \w ἐγενόμην|strong="G1096"\w* \w ἐν|strong="G1722"\w* \w τῇ|strong="G3588"\w* \w νήσῳ|strong="G3520"\w* \w τῇ|strong="G3588"\w* \w καλουμένῃ|strong="G2564"\w* \w Πάτμῳ|strong="G3963"\w*, \w διὰ|strong="G1223"\w* \w τὸν|strong="G3588"\w* \w λόγον|strong="G3056"\w* \w τοῦ|strong="G3588"\w* \w Θεοῦ|strong="G2316"\w* \w καὶ|strong="G2532"\w* \f + \fr 1:9 \ft δια \+bd 𝔐\+bd*\+sup A+,C,K\+sup* 73.6% ¦ — \+bd 𝔐\+bd*\+sup A−\+sup* NA SBL TH WH 26%\f*\w διὰ|strong="G1223"\w* \w τὴν|strong="G3588"\w* \w μαρτυρίαν|strong="G3141"\w* \w Ἰησοῦ|strong="G2424"\w* \f + \fr 1:9 \ft χριστου \+bd 𝔐\+bd*\+sup A+,C,K\+sup* [81.3%] ¦ — \+bd 𝔐\+bd*\+sup A−\+sup* CT [17.8%]\f*\w Χριστοῦ|strong="G5547"\w*.  
\v 10 \w Ἐγενόμην|strong="G1096"\w* \w ἐν|strong="G1722"\w* \w πνεύματι|strong="G4151"\w* \w ἐν|strong="G1722"\w* \w τῇ|strong="G3588"\w* \w κυριακῇ|strong="G2960"\w* \w ἡμέρᾳ|strong="G2250"\w*· \w καὶ|strong="G2532"\w* \w ἤκουσα|strong="G0191"\w* \f + \fr 1:10 \ft φωνην οπισω μου \+bd 𝔐\+bd*\+sup C,K\+sup* [61.5%] ¦ οπισω μου φωνην \+bd 𝔐\+bd*\+sup A\+sup* CT TR [25.7%]\f*\w φωνὴν|strong="G5456"\w* \w ὀπίσω|strong="G3694"\w* \w μου|strong="G1473"\w* \w μεγάλην|strong="G3173"\w* \w ὡς|strong="G5613"\w* \w σάλπιγγος|strong="G4536"\w*,  
\v 11 \f + \fr 1:11 \ft λεγουσης \+bd 𝔐\+bd*\+sup A+,C,K\+sup* [67.7%] ¦ λεγουσης εγω ειμι το Α και το Ω ο πρωτος και ο εσχατος και \+bd 𝔐\+bd*\+sup A+\+sup* TR [7.4%] ¦ λεγουσης εγω ειμι το Α και το Ω πρωτος και εσχατος και \+bd 𝔐\+bd*\+sup A−\+sup* [5.1%]\f*\w λεγούσης|strong="G3004"\w*, \wj \+w Ὃ|strong="G3588"\+w* \+w βλέπεις|strong="G0991"\+w* \+w γράψον|strong="G1125"\+w* \+w εἰς|strong="G1519"\+w* \+w βιβλίον|strong="G0975"\+w*, \+w καὶ|strong="G2532"\+w* \+w πέμψον|strong="G3992"\+w* \+w ταῖς|strong="G3588"\+w*\wj* \f + \fr 1:11 \ft επτα \+bd 𝔐\+bd*\+sup A,C,K\+sup* [95.9%] ¦ — ST [1.8%]\f*\wj \+w ἑπτὰ|strong="G2033"\+w*\wj* \f + \fr 1:11 \ft εκκλησιαις \+bd 𝔐\+bd*\+sup A,C,K\+sup* [97.7%] ¦ εκκλησιαις ταις εν ασια TR [1.8%]\f*\wj \+w ἐκκλησίαις|strong="G1577"\+w*, \+w εἰς|strong="G1519"\+w* \+w Ἔφεσον|strong="G2181"\+w*, \+w καὶ|strong="G2532"\+w* \+w εἰς|strong="G1519"\+w* \+w Σμύρναν|strong="G4666"\+w*, \+w καὶ|strong="G2532"\+w* \+w εἰς|strong="G1519"\+w* \+w Πέργαμον|strong="G4010"\+w*, \+w καὶ|strong="G2532"\+w*\wj* \f + \fr 1:11 \ft εις θυατειρα \+bd 𝔐\+bd*\+sup A−,C,K\+sup* [69.9%] ¦ εις θυατειραν MSS [12.5%] ¦ εν θυατειροις \+bd 𝔐\+bd*\+sup A+\+sup* [11.6%] ¦ εις θυατειρας MSS [5.1%]\f*\wj \+w εἰς|strong="G1519"\+w* \+w Θυάτειρα|strong="G2363"\+w*, \+w καὶ|strong="G2532"\+w* \+w εἰς|strong="G1519"\+w* \+w Σάρδεις|strong="G4554"\+w*, \+w καὶ|strong="G2532"\+w* \+w εἰς|strong="G1519"\+w*\wj* \f + \fr 1:11 \ft φιλαδελφειαν \+bd 𝔐\+bd*\+sup A+,C,K+\+sup* [63.3%] ¦ φιλαδελφιαν \+bd 𝔐\+bd*\+sup A−,K−\+sup* ECM TH WH [35.3%]\f*\wj \+w Φιλαδέλφειαν|strong="G5359"\+w*, \+w καὶ|strong="G2532"\+w* \+w εἰς|strong="G1519"\+w*\wj* \f + \fr 1:11 \ft λαοδικειαν \+bd 𝔐\+bd*\+sup A,C,K\+sup* [89.4%] ¦ λαοδικιαν TH WH [10.6%]\f*\wj \+w Λαοδίκειαν|strong="G2993"\+w*.\wj*   
\p
