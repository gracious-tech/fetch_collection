\c 21  
\s1 The New Heaven and the New Earth  
\p
\v 1 \w Καὶ|strong="G2532"\w* \w εἶδον|strong="G3708"\w* \w οὐρανὸν|strong="G3772"\w* \w καινὸν|strong="G2537"\w* \w καὶ|strong="G2532"\w* \w γῆν|strong="G1093"\w* \w καινήν|strong="G2537"\w*· \w ὁ|strong="G3588"\w* \w γὰρ|strong="G1063"\w* \w πρῶτος|strong="G4413"\w* \w οὐρανὸς|strong="G3772"\w* \w καὶ|strong="G2532"\w* \w ἡ|strong="G3588"\w* \w πρώτη|strong="G4413"\w* \w γῆ|strong="G1093"\w* \f + \fr 21:1 \ft απηλθον ¦ παρηλθε \+bd Αν\+bd* PCK TR ¦ απηλθαν NA SBL TH WH\f*\w ἀπῆλθον|strong="G0565"\w*, \w καὶ|strong="G2532"\w* \w ἡ|strong="G3588"\w* \w θάλασσα|strong="G2281"\w* \w οὐκ|strong="G3756"\w* \w ἔστιν|strong="G1510"\w* \w ἔτι|strong="G2089"\w*.  
\v 2 \w Καὶ|strong="G2532"\w* \f + \fr 21:2 \ft την πολιν την αγιαν ιερουσαλημ καινην ειδον ¦ εγω ιωαννης ειδον την πολιν την αγιαν ιερουσαλημ καινην TR\f*\w τὴν|strong="G3588"\w* \w πόλιν|strong="G4172"\w* \w τὴν|strong="G3588"\w* \w ἁγίαν|strong="G0040"\w*, \w Ἱερουσαλὴμ|strong="G2419"\w* \w καινήν|strong="G2537"\w*, \w εἶδον|strong="G3708"\w* \w καταβαίνουσαν|strong="G2597"\w* \f + \fr 21:2 \ft εκ του ουρανου απο του θεου ¦ απο του θεου εκ του ουρανου \+bd Αν\+bd* PCK TR\f*\w ἐκ|strong="G1537"\w* \w τοῦ|strong="G3588"\w* \w οὐρανοῦ|strong="G3772"\w* \w ἀπὸ|strong="G0575"\w* \w τοῦ|strong="G3588"\w* \w Θεοῦ|strong="G2316"\w*, \w ἡτοιμασμένην|strong="G2090"\w* \w ὡς|strong="G5613"\w* \w νύμφην|strong="G3565"\w* \w κεκοσμημένην|strong="G2885"\w* \w τῷ|strong="G3588"\w* \w ἀνδρὶ|strong="G0435"\w* \w αὐτῆς|strong="G0846"\w*.  
\v 3 \w Καὶ|strong="G2532"\w* \w ἤκουσα|strong="G0191"\w* \w φωνῆς|strong="G5456"\w* \w μεγάλης|strong="G3173"\w* \w ἐκ|strong="G1537"\w* \w τοῦ|strong="G3588"\w* \f + \fr 21:3 \ft ουρανου \+bd 𝔐\+bd*\+sup A,C,K\+sup* 96.1% ¦ θρονου ECM\+sup †\+sup* NA SBL TH WH 1.3%\f*\w οὐρανοῦ|strong="G3772"\w*, \w λεγούσης|strong="G3004"\w*, \w Ἰδού|strong="G3708"\w*, \w ἡ|strong="G3588"\w* \w σκηνὴ|strong="G4633"\w* \w τοῦ|strong="G3588"\w* \w Θεοῦ|strong="G2316"\w* \w μετὰ|strong="G3326"\w* \w τῶν|strong="G3588"\w* \w ἀνθρώπων|strong="G0444"\w*, \w καὶ|strong="G2532"\w* \w σκηνώσει|strong="G4637"\w* \w μετ|strong="G3326"\w*᾽ \w αὐτῶν|strong="G0846"\w*, \w καὶ|strong="G2532"\w* \w αὐτοὶ|strong="G0846"\w* \f + \fr 21:3 \ft λαος \+bd 𝔐\+bd*\+sup C,K\+sup* 72.3% ¦ λαοι \+bd 𝔐\+bd*\+sup A\+sup* ECM\+sup †\+sup* NA SBL TH TR WH 25.5%\f*\w λαὸς|strong="G2992"\w* \w αὐτοῦ|strong="G0846"\w* \w ἔσονται|strong="G1510"\w*, \w καὶ|strong="G2532"\w* \w αὐτὸς|strong="G0846"\w* \w ὁ|strong="G3588"\w* \w Θεὸς|strong="G2316"\w* \f + \fr 21:3 \ft εσται μετ αυτων \+bd 𝔐\+bd*\+sup A−,C\+sup* 26.3% ¦ μετ αυτων εσται \+bd 𝔐\+bd*\+sup K\+sup* ANT ECM\+sup †\+sup* HF SBL WH 36.4% ¦ εσται μετ αυτων θεος αυτων \+bd 𝔐\+bd*\+sup A+\+sup* TR 22.9% ¦ μετ αυτων εσται αυτων θεος ECM\+sup †\+sup* NA TH 1.7%\f*\w ἔσται|strong="G1510"\w* \w μετ|strong="G3326"\w*᾽ \w αὐτῶν|strong="G0846"\w*·  
\v 4 \w καὶ|strong="G2532"\w* \f + \fr 21:4 \ft εξαλειψει \+bd 𝔐\+bd*\+sup A+,C\+sup* 51.3% ¦ εξαλειψει απ αυτων \+bd 𝔐\+bd*\+sup K\+sup* HF 30.4% ¦ εξαλειψει ο θεος \+bd 𝔐\+bd*\+sup A−\+sup* TR 16.5% ¦ εξαλειψει απ αυτων ο θεος ANT 0%\f*\w ἐξαλείψει|strong="G1813"\w* \w πᾶν|strong="G3956"\w* \w δάκρυον|strong="G1144"\w* \f + \fr 21:4 \ft απο \+bd 𝔐\+bd*\+sup A,C,K\+sup* 94.3% ¦ εκ NA SBL TH WH 5.2%\f*\w ἀπὸ|strong="G0575"\w* \w τῶν|strong="G3588"\w* \w ὀφθαλμῶν|strong="G3788"\w* \w αὐτῶν|strong="G0846"\w*, \w καὶ|strong="G2532"\w* \w ὁ|strong="G3588"\w* \w θάνατος|strong="G2288"\w* \w οὐκ|strong="G3756"\w* \w ἔσται|strong="G1510"\w* \w ἔτι|strong="G2089"\w*· \w οὔτε|strong="G3777"\w* \w πένθος|strong="G3997"\w*, \w οὔτε|strong="G3777"\w* \w κραυγή|strong="G2906"\w*, \w οὔτε|strong="G3777"\w* \w πόνος|strong="G4192"\w* \w οὐκ|strong="G3756"\w* \w ἔσται|strong="G1510"\w* \w ἔτι|strong="G2089"\w*· \f + \fr 21:4 \ft οτι τα \+bd 𝔐\+bd*\+sup A+,C,K\+sup* 71.1% ¦ τα \+bd 𝔐\+bd*\+sup A−\+sup* ECM SBL TH WH 14.9% ¦ τα γαρ \+bd 𝔐\+bd*\+sup A−\+sup* 6%\f*\w ὅτι|strong="G3754"\w* \w τὰ|strong="G3588"\w* \w πρῶτα|strong="G4413"\w* \f + \fr 21:4 \ft απηλθον \+bd 𝔐\+bd*\+sup A,C\+sup* 54.4% ¦ απηλθε \+bd 𝔐\+bd*\+sup K\+sup* ECM\+sup †\+sup* HF 42.9% ¦ απηλθαν NA SBL TH WH 0.9%\f*\w ἀπῆλθον|strong="G0565"\w*.   
\p
\v 5 \w Καὶ|strong="G2532"\w* \w εἶπεν|strong="G3004"\w* \w ὁ|strong="G3588"\w* \w καθήμενος|strong="G2521"\w* \w ἐπὶ|strong="G1909"\w* \f + \fr 21:5 \ft τω θρονω ¦ του θρονου PCK TR\f*\w τῷ|strong="G3588"\w* \w θρόνῳ|strong="G2362"\w*, \w Ἰδού|strong="G3708"\w*, \f + \fr 21:5 \ft παντα καινα ποιω ¦ καινα ποιω παντα ANT CT PCK ¦ καινα παντα ποιω TR\f*\w πάντα|strong="G3956"\w* \w καινὰ|strong="G2537"\w* \w ποιῶ|strong="G4160"\w*. \w Καὶ|strong="G2532"\w* \w λέγει|strong="G3004"\w* \f + \fr 21:5 \ft μοι ¦ — CT HF\f*\w μοι|strong="G1473"\w*, \w Γράψον|strong="G1125"\w*· \w ὅτι|strong="G3754"\w* \w οὗτοι|strong="G3778"\w* \w οἱ|strong="G3588"\w* \w λόγοι|strong="G3056"\w* \f + \fr 21:5 \ft αληθινοι και πιστοι ¦ πιστοι και αληθινοι του θεου \+bd K\+bd* HF ¦ πιστοι και αληθινοι ANT CT\f*\w ἀληθινοὶ|strong="G0228"\w* \w καὶ|strong="G2532"\w* \w πιστοί|strong="G4103"\w* εἰσι.  
\v 6 \w Καὶ|strong="G2532"\w* \w εἶπέ|strong="G3004"\w* \w μοι|strong="G1473"\w*, \f + \fr 21:6 \ft γεγονα \+bd 𝔐\+bd*\+sup C,K\+sup* 42.9% ¦ γεγονα εγω \+bd 𝔐\+bd*\+sup A\+sup* ECM 31.9% ¦ γεγονασιν εγω ειμι MSS 8% ¦ γεγονε MSS 7.6% ¦ γεγονεν εγω ειμι TR 3.4% ¦ γεγοναν εγω ειμι NA TH 1.3% ¦ γεγοναν εγω SBL WH 0.4% ¦ γεγονεν εγω ANT 0%\f*\w Γέγονα|strong="G1096"\w* \w τὸ|strong="G3588"\w* \f + \fr 21:6 \ft αλφα ¦ Α ANT TR\f*\w Ἄλφα|strong="G0001"\w* \w καὶ|strong="G2532"\w* \w τὸ|strong="G3588"\w* \w Ὦ|strong="G3739"\w*, \f + \fr 21:6 \ft η αρχη και το \+bd 𝔐\+bd*\+sup A+\+sup* 35% ¦ αρχη και \+bd 𝔐\+bd*\+sup A−,C\+sup* PCK 33.3% ¦ και η αρχη και το \+bd 𝔐\+bd*\+sup K\+sup* HF 29.1%\f*\w ἡ|strong="G3588"\w* \w ἀρχὴ|strong="G0746"\w* \w καὶ|strong="G2532"\w* \w τὸ|strong="G3588"\w* \w τέλος|strong="G5056"\w*. \w Ἐγὼ|strong="G1473"\w* \w τῷ|strong="G3588"\w* \w διψῶντι|strong="G1372"\w* \f + \fr 21:6 \ft δωσω \+bd 𝔐\+bd*\+sup A,C\+sup* 61.5% ¦ δωσω αυτω \+bd 𝔐\+bd*\+sup K\+sup* HF 37.7%\f*\w δώσω|strong="G1325"\w* \w ἐκ|strong="G1537"\w* \w τῆς|strong="G3588"\w* \w πηγῆς|strong="G4077"\w* \w τοῦ|strong="G3588"\w* \w ὕδατος|strong="G5204"\w* \w τῆς|strong="G3588"\w* \w ζωῆς|strong="G2222"\w* \w δωρεάν|strong="G1432"\w*.  
\v 7 \w Ὁ|strong="G3588"\w* \w νικῶν|strong="G3528"\w* \f + \fr 21:7 \ft κληρονομησει ταυτα ¦ δωσω αυτω ταυτα \+bd K\+bd* HF ¦ κληρονομησει παντα TR ¦ εσται αυτω ταυτα ANT\f*\w κληρονομήσει|strong="G2816"\w* \w ταῦτα|strong="G3778"\w*, \w καὶ|strong="G2532"\w* \w ἔσομαι|strong="G1510"\w* \w αὐτῷ|strong="G0846"\w* \w Θεός|strong="G2316"\w*, \w καὶ|strong="G2532"\w* \f + \fr 21:7 \ft αυτος εσται μοι υιος ¦ αυτος εσται μοι ο υιος TR ¦ αυτοι εσονται μοι υιοι \+bd Αν\+bd*\f*\w αὐτὸς|strong="G0846"\w* \w ἔσται|strong="G1510"\w* \w μοι|strong="G1473"\w* \w υἱός|strong="G5207"\w*.  
\v 8 \f + \fr 21:8 \ft τοις δε δειλοις ¦ δειλοις δε TR\f*\w Τοῖς|strong="G3588"\w* \w δὲ|strong="G1161"\w* \w δειλοῖς|strong="G1169"\w* \w καὶ|strong="G2532"\w* \w ἀπίστοις|strong="G0571"\w* \f + \fr 21:8 \ft και αμαρτωλοις ¦ — ANT CT TR\f*\w καὶ|strong="G2532"\w* \w ἁμαρτωλοῖς|strong="G0268"\w* \w καὶ|strong="G2532"\w* \w ἐβδελυγμένοις|strong="G0948"\w* \w καὶ|strong="G2532"\w* φονεῦσι \w καὶ|strong="G2532"\w* \w πόρνοις|strong="G4205"\w* \w καὶ|strong="G2532"\w* \f + \fr 21:8 \ft φαρμακοις ¦ φαρμακευσι TR\f*\w φαρμάκοις|strong="G5333"\w* \w καὶ|strong="G2532"\w* \w εἰδωλολάτραις|strong="G1496"\w*, \w καὶ|strong="G2532"\w* πᾶσι \w τοῖς|strong="G3588"\w* ψευδέσι, \w τὸ|strong="G3588"\w* \w μέρος|strong="G3313"\w* \w αὐτῶν|strong="G0846"\w* \w ἐν|strong="G1722"\w* \w τῇ|strong="G3588"\w* \w λίμνῃ|strong="G3041"\w* \w τῇ|strong="G3588"\w* \w καιομένῃ|strong="G2545"\w* \f + \fr 21:8 \ft πυρι ¦ εν πυρι ANT\f*\w πυρὶ|strong="G4442"\w* \w καὶ|strong="G2532"\w* \w θείῳ|strong="G2303"\w*, \w ὅ|strong="G3588"\w* \w ἐστιν|strong="G1510"\w* \f + \fr 21:8 \ft ο θανατος ο δευτερος ¦ δευτερος θανατος TR\f*\w ὁ|strong="G3588"\w* \w θάνατος|strong="G2288"\w* \w ὁ|strong="G3588"\w* \w δεύτερος|strong="G1208"\w*.   
\s1 The New Jerusalem  
