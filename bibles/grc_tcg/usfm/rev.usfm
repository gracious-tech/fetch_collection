\p
\v 11 \w Καὶ|strong="G2532"\w* \w εἶδον|strong="G3708"\w* \w θρόνον|strong="G2362"\w* \f + \fr 20:11 \ft μεγαν λευκον ¦ λευκον μεγαν \+bd Αν\+bd* TR\f*\w μέγαν|strong="G3173"\w* \w λευκόν|strong="G3022"\w*, \w καὶ|strong="G2532"\w* \w τὸν|strong="G3588"\w* \w καθήμενον|strong="G2521"\w* \w ἐπ|strong="G1909"\w*᾽ \f + \fr 20:11 \ft αυτον ¦ αυτου SBL TH TR WH ¦ αυτω ANT\f*\w αὐτόν|strong="G0846"\w*, \w οὗ|strong="G3756"\w* \w ἀπὸ|strong="G0575"\w* \f + \fr 20:11 \ft προσωπου ¦ του προσωπου CT\f*\w προσώπου|strong="G4383"\w* \w ἔφυγεν|strong="G5343"\w* \f + \fr 20:11 \ft η γη και ο ουρανος ¦ ο ουρανος και η γη PCK\f*\w ἡ|strong="G3588"\w* \w γῆ|strong="G1093"\w* \w καὶ|strong="G2532"\w* \w ὁ|strong="G3588"\w* \w οὐρανός|strong="G3772"\w*, \w καὶ|strong="G2532"\w* \w τόπος|strong="G5117"\w* \w οὐχ|strong="G3756"\w* \w εὑρέθη|strong="G2147"\w* \w αὐτοῖς|strong="G0846"\w*.  
\v 12 \w Καὶ|strong="G2532"\w* \w εἶδον|strong="G3708"\w* \w τοὺς|strong="G3588"\w* \w νεκρούς|strong="G3498"\w*, \f + \fr 20:12 \ft τους μεγαλους και τους μικρους ¦ μικρους και μεγαλους TR ¦ — \+bd K\+bd*\f*\w τοὺς|strong="G3588"\w* \w μεγάλους|strong="G3173"\w* \w καὶ|strong="G2532"\w* \w τοὺς|strong="G3588"\w* \w μικρούς|strong="G3398"\w*, \w ἑστῶτας|strong="G2476"\w* \w ἐνώπιον|strong="G1799"\w* \w τοῦ|strong="G3588"\w* \f + \fr 20:12 \ft θρονου ¦ θεου TR\f*\w θρόνου|strong="G2362"\w*, \w καὶ|strong="G2532"\w* \w βιβλία|strong="G0975"\w* \f + \fr 20:12 \ft ηνεωχθησαν ¦ ηνοιξαν \+bd K\+bd* HF ¦ ανεωχθησαν PCK ¦ ηνοιχθησαν ANT CT\f*\w ἠνεῴχθησαν|strong="G0455"\w*· \w καὶ|strong="G2532"\w* \f + \fr 20:12 \ft αλλο βιβλιον ¦ βιβλιον αλλο TR\f*\w ἄλλο|strong="G0243"\w* \w βιβλίον|strong="G0975"\w* \f + \fr 20:12 \ft ηνεωχθη ¦ ανεωχθη PCK ¦ ηνοιχθη ANT NA SBL TH WH\f*\w ἠνεῴχθη|strong="G0455"\w*, \w ὅ|strong="G3588"\w* ἐστι \w τῆς|strong="G3588"\w* \w ζωῆς|strong="G2222"\w*· \w καὶ|strong="G2532"\w* \w ἐκρίθησαν|strong="G2919"\w* \w οἱ|strong="G3588"\w* \w νεκροὶ|strong="G3498"\w* \w ἐκ|strong="G1537"\w* \w τῶν|strong="G3588"\w* \w γεγραμμένων|strong="G1125"\w* \w ἐν|strong="G1722"\w* \w τοῖς|strong="G3588"\w* \w βιβλίοις|strong="G0975"\w*, \w κατὰ|strong="G2596"\w* \w τὰ|strong="G3588"\w* \w ἔργα|strong="G2041"\w* \w αὐτῶν|strong="G0846"\w*.  
