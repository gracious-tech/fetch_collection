<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- MAALE Full Bible</book>
  <para style="h">ያይቆኦቤ ኪኢቶ</para>
  <para style="toc1">ያይቆኦቤ ዳኬ ኪኢቶ</para>
  <para style="toc3">ያይ.</para>
  <para style="toc2">ያይቆኦቤ ኪኢቶ</para>
  <para style="mt1">ያይቆኦቤ ኪኢቶ</para>
  <para style="imt">ዓይፆ ካሮ</para>
  <para style="ip">ሃይ ያይቆኦቤ ኪኢታ ዓሲ ናንጋንዳ ጎይሢ ዻዋ ማሊሢ ዓርቄያ ማዓዛ፥ ኪኢታ ፃኣፒንቴሢያ ዬኖ ዎዶና ዓጮ ቢያይዳ ላኣሊንቲ ዓኣ ፆኦሲ ዴሮምኬ፤ ኪኢቴሎ ፃኣፔሢ ዔራቶ ኑ ማዾይዳ ፔኤሻንዳ ጎይሢና ዬሱሴ ጉሙርቃ ዓሲ ናንጋንዳ ናንጋ ፔጋዺ ዔርቴያ ማዓንዳጉዲ ጌኤሺ ዔርዛ ጎይሢ ኬኤዛኔ፤ ዬይያኣ፦ ማንቃቶና ዖርጎቹሞና ዛላ፥ ዻቢንታቴያ ዛጋኒ ጌሺሢ ዛላ፥ ዓሲኮ ኮሹሞ ዛላ፥ ቂኢሩሞ ዛላ፥ ጉሙርቂሢና ኮሺ ማዾና ዛላ፥ ዒንዲርሲኮ ኮሹሞንታ ፑርቱሞንታ ዛላ፥ ዔራቶ ዛላ፥ ዎሊና ፑርቲሢ ዛላ፥ ዖቶርሙሞና ሼሌዑሞና ዛላ፥ ኮይሱዋ ጎይሢና ሜሌ ዓሲዳ ዎጊሢ ዛላ፥ ዓኣ ባኣዚና ሄርሺንቲና ሆኦሊንቲሢና ዛላ፥ ዳንዳዒሢና ሺኢጲሢና ዛላ፥ ዬሱሴ ጉሙርቃ ዓሳ ዔራኒ ኮይሳ ባኣዚ ፓይዲ ፓይዲ ፃኣፔኔ።</para>
  <para style="ip">ሃና ኪኢታ ባሼ ፔጋሲ ኬኤዛሢ ዬሱሴ ጉሙርቃ ዓሳ ዬሱሴ ጉሙርቂፆ ናንጎ ማዾና ዻዋንዳጉዲኬ።</para>
  <para style="iot">ማፃኣፔላ ዱማ ዱማ ዓርቄ ባኮ</para>
  <para style="io1">ዓይፆ ካሮ (1፡1)</para>
  <para style="io1">ዬሱሴ ጉሙርቂሢና ዔራቶና ዛላ (1፡2-8)</para>
  <para style="io1">ማንቃቶና ዖርጎቹሞና ዛላ (1፡9-11)</para>
  <para style="io1">ዻቢንታቴ ዛጋኒ ጌሺሢና ሜቶና ዛላ (1፡12-18)</para>
  <para style="io1">ዋይዚሢና ማዾይዳ ፔኤሺሢና ዛላ (1፡19-27)</para>
  <para style="io1">ዓሲ ዱማሲሢ ኮይሱዋያ ማዔሢ ዛላ (2፡1-13)</para>
  <para style="io1">ዬሱሴ ጉሙርቂሢና ማዾና ዛላ (2፡14-26)</para>
  <para style="io1">ዬሱሴ ጉሙርቃ ዓሲና ዒዛኮ ዒንዲርዞ ዛላ (3፡1-18)</para>
  <para style="io1">ዬሱሴ ጉሙርቃ ዓሲና ሃያ ዓጮ ዓሶ ዛላ (4፡1—5፡6)</para>
  <para style="io1">ዱማ ዱማ ዞሮ (5፡7-20)</para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>ዓጮ ቢያ ላኣሊንቲ ዴንዴ ፆኦሲ ዓሶ ማዔ ታጶ ላምዖ ዜርፆም፦ ፆኦሲና ጎዳ ዬሱስ ኪሪስቶሴናም ማዻያ ማዔ ያይቆኦቤይዳፓ ዳኪንቴ ኪኢታ፤ <note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">ማቲ. 13፡55</ref>፤ <ref loc="MRK 6:3">ማር. 6፡3</ref>፤ <ref loc="ACT 15:13">ዳኪ. ማዾ 15፡13</ref>፤ <ref loc="GAL 1:19">ጋላ. 1፡19</ref>።</char></note></para>
  <para style="p" vid="JAS 1:1">ዒንሢ ዎዚ ኮሺዳ?<verse eid="JAS 1:1"/></para>
  <para style="s1">ጊቢ ዳንዳዒሢና ጉሙርቂሢና ሃሣ ዔራቶና ዛላ</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>ታ ዒሾንሦ! ታ ሚሾንሦ! ዱማ ዱማ ሜታ ዒንሢ ሄሌ ዎዶና ኮሺ ባኣዚ ማሂ ዛጉዋቴ። <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>ዓይጎሮ ጌዔቶ ዒንሢኮ ጉሙርቂፃ ሜቶና ዛጊንታ ዎዶና ጊቢ ዳንዳዒሢ ዒንሢ ዴንቃንዳኔ። <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>ዒንሢኮ ጊቢ ዳንዳዒ ዶዲፃ፥ ፔቴ ባኣዚታዖ ዒንሢም ፓጪባኣንቴ ጎኔ ዓሲ ዒንሢ ማዓንዳጉዲ ማሆንጎ። <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>ዒንሢ ባኣካ ዔራቶ ፓጬ ዓሲ ዓኣቶ ፆኦሲ ሺኢቆንጎ፤ ፆኦሲያ ዒዛም ዒንጋንዳኔ፤ ዓይጎሮ ጌዔቶ ዒዚ ፔቴ ባኣዚታዎ ላኣጉዋዖ ቢያሢም ኮሹሞና ዒዒንጋያኬ። <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>ጋዓንቴ ዓሲ ፔቴታዖ ዓልቱዋዖ ጉሙርቂሢና ሺኢቆንጎ፤ «ማዓንዳ?» ጌዒ ዓልታ ዓሲ ዢባሬና ሂዒንታያና ዓጊፃ ባዞ ዋኣፆ ጉዴያኬ። <verse eid="JAS 1:6"/><verse number="7" style="v" sid="JAS 1:7"/>ዬያጉዴ ዓሲ ጎዳይዳፓ ፔቴ ባኣዚታዖ ዴንቃንዳያ ዒዛም ማሎፓ። <verse eid="JAS 1:7"/><verse number="8" style="v" sid="JAS 1:8"/>ዓይጎሮ ጌዔቶ ዒዛኮ ላምዖ ማሊሢ ዓኣሢሮና ሃሣ ዒዚ ዔቄ ጎይፆይዳ ሴካ ሃንጋ ጋዓሢሮኬ።<verse eid="JAS 1:8"/></para>
  <para style="s1">ማንቆ ዓሲና ዖርጎቺ ዓሲናኮ ዓኣ ዎዛ</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>ዬሱሴ ጉሙርቂ ጎናሲ ዔኬ ማንቆ ማዔ፥ ሂርኬ ዓሢ ፆኦሲ ዒዛ ዼጊዳንዳሢሮ ዎዛዾንጎ። <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>ሃሣ ፆኦሲ ጉሙርቃ ዖርጎጮ ማዔ ፑኡፖ ዓሢ ዒዛኮ ናንጎ ፆኦሲ ሂርኪዴቶዋ ዎዎዛዾንጎ፤ ዓይጎሮ ጌዔቶ ዓሲኮ ቆሎ ሳዖይዳ ዓኣ ቡኒጉዲ ዲኢናኔ። <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>ዓባ ዖይዺ ኬስካዖ ማኣቶ ሜልዛኔ፤ ቡናኣ ዲኢናኔ፤ ሃሣ ሚዛጱማኣ ባባይቃኔ። ዬያጉዲ ዖርጎቺ ዓሲ ፔኤኮ ቆሎ ዛሎይዳ ሌሊ ጳሽኪ ጉሪ ዓታኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡11 </char><char style="xt" closed="false"><ref loc="ISA 40:6-7">ዒሲ. 40፡6-7</ref>።</char></note><verse eid="JAS 1:11"/></para>
  <para style="s1">ዓሲዳ ሄላ ሜቶ</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>ፔ ጊዳ ሙኬ ሜቶ ጊቢ ዳንዳዒ ዶዳ ዓሲ ዓንጂንቴያኬ፤ ዓይጎሮ ጌዔቶ ፆኦሲ ጫኣቁሞ ጌሌ ጎይፆና ዒዛ ናሽካ ዓሶም ዒንጋንዳ ኮዦ ናንጎ ዒ ዴንቃንዳኔ። <verse eid="JAS 1:12"/><verse number="13" style="v" sid="JAS 1:13"/>ዓሲ ሜቶይዳ ጌላ ዎዶና፦ «ፆኦሲ ታና ዻቢሻኒ ሜቶ ዒንጌኔ» ጎዖፓ፤ ዓይጎሮ ጌዔቶ ፑርታ ሜቶ ፆኦሲ ዓሲም ዓሲ ዻቢሻኒ ዒንጉዋሴ፤ ሃሣ ዒዚ ዖናኣ ዻቢሻኒ ፑርታ ሜቶ ዒንጉዋሴ፤ <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>ጋዓንቴ ፔቴ ፔቴሢ ሜቶ ዔኪ ዻቢንታሢ ፔኤኮ ፑርቶ ሱኡኮ ጊንፆ ዓኣዺ ጌሺንቲሢናኬ። <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>ዬካፓ ፑርቶ ሱኡካ ጎጳዺ ጎሜ ሾዓኔ፤ ጎሜያ ዲጪ ዑጌስካፓ ሃይቢ ሾዓኔ።<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>ታኣኒ ዒንሢ ናሽካ፥ ታኣኮ ዒሾንሦ! ሚሾንሦ! ጌሺንቲፖቴ፤ <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>ኮሺ ማዔ ዒንጊሢንታ ጉቤ ማዔ ዓንጆዋ ቢያ ፆኦሲዳፓኬ፤ ዬይያ ሙካሢ ሺቢጉዲ ቤዛፓ ሺኢኪ ላኣሚንቱዋያ፥ ሃሣ ፖዖኮ ቢያ ዓዶ ማዔ ፆኦዛሢዳፓኬ። <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>ፆኦሲ ፔኤኮ ማዢንቶ ቢያሢኮ ኑኡኒ ቤርቲ ማዓንዳጉዲ ፔ ማሊሢዳፓ ጎኑሞ ቃኣሎና ኑና ሾዔኔ።<verse eid="JAS 1:18"/></para>
  <para style="s1">ዋይዜ ባኮ ማዾይዳ ፔኤሺሢ</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>ታኣኒ ዒንሢ ናሽካ፥ ታኣኮ ዒሾንሦ! ሚሾንሦ! ሃይማ ዋሊፖቴ፤ ዓሲ ቢያ ዔኤቢ ዋይዛኒ ሩኡራያ፥ ኬኤዛኒና ዻጋዺ ጎሪንታኒ ታሣያ ማዖንጎ። <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>ዓይጎሮ ጌዔቶ ዓሲኮ ዻጋዺ ጎሪንቲ ፆኦሲኮ ፂሉማ ዓሲ ሼምፖይዳ ኩሙሢ ማዓንዳጉዲ ማሁዋሴ። <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>ዬያሮ ዒኢሳ ባኣዚንታ ዺቦ ፑርቱሞዋ ቢያ ዒንሢዳፓ ሺኢሺ ዒንሢኮ ዒኖይዳ ዜርቂንቴ ዒንሢ ዻቂሻኒ ዳንዳዓ ፆኦሲ ቃኣሎ ሼሌዑሞና ዔኩዋቴ።<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>ቃኣሎ ማዾይዳ ፔኤሻያ ማዑዋቴ፤ ጋዓንቴ ዒንሢ ዒንሢ ቶኦኮ ዒንሢሮ ጌሺ ጌሺ ዋይዛ ዓሲ ሌሊ ማዒፖቴ። <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>ቃኣሎ ዋይዛዖ ማዾይዳ ፔኤሹዋ ዓሲ፥ ፔኤኮ ዓኣፖ ካሮ ሌማሌኤሼና ዛጋ ዓሲ ጉዴያኬ፤ <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>ዓይጎሮ ጌዔቶ ዬይ ዓሢ ፔኤኮ ዓኣፖ ካሮ ሌማሌኤሾና ዛጌስካፓ ዓኣዻኔ፤ ጋዓንቴ ዻካ ጌዔስካፓ ዋኣዼታቴያ ዒ ፔና ዔሩዋሴ። <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>ጋዓንቴ ጎሜ ዓይላቶይዳፓ ጉቤና ዒዛ ኬሳ ዎጎ ዛጊ ዬያና ዶዳያ፥ ዬያ ዋይዛዖ ዋሉዋያ፥ ሃሣ ማዾይዳ ፔኤሻ ዓሢ ዬይ ፔ ማዾና ዓንጂንቴያ ማዓንዳኔ።<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>ዒንዲርዞ ፔኤሲ ቃዙዋዖ «ታ ፆኦሲ ካኣሽካኔ» ጋዓ ዓሲ ፔና ጌሻኔ፤ ዒዛኮ ካኣዣኣ ጉሪኬ። <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>ፆኦሲ፥ ዓዳሢ ቤርቶይዳ ፑርታ ባኣዚ ባኣያ ጌኤሺ ማዔ ጉሙርቂፆ ካኣዣ፦ «ዜኤሮ ናኣቶንታ ሃሣ ዬያጉዲ ዜኤሮይንዶ ማዔ ላኣሎንታኮ ዓኣ ሜቶ ማኣዲሢና ፔ ቶኦኮዋ ሳዖይዳ ዒኢሳ ባኮይዳፓ ካፒሢኬ።»<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s1">ዓሲ ዱማሲ ዛጋንዳያ ኮይሱዋያ ማዒፆ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>ታ ዒሾንሦ! ታ ሚሾንሦ! ቦንቺንቴ ኑ ጎዳሢ ዬሱስ ኪሪስቶሴ ዒንሢ ጉሙርቃያ ማዔሢሮ ፔቴሢ ባጋሢዳፓ ባሻያ ማሂ ዛጊ ዱሙሞ ሳዛ ጌሢፖቴ። <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>ጎዖንቴ ላምዖ ዓሲ ዒንሢ ቡኪንቴ ቤዞ ሙኬኔ ኑ ጎዖም፤ ፔቴ ዓሢ ኬኤሎይዳ ዎርቄ ዢኢሮ ዓኣሢ ሃሣ ሚዛጲ ማኣዖ ማይንቴ ዖርጎቺ ዓሲ፥ ባጋሢ ቱርጫዺ ኪንቄ ማኣዖ ማይንቴያ ማንቆ ዓሲ ማዔቶ፥ <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>ዒንሢ ሚዛጶ ዓፒሎ ማይንቴ ዓሢ ቦንቺ፦ «ሃኖ ኮዦ ቤዜሎይዳ ዴዔ» ጌዒጋፓ ማንቆ ዓሢም ጋዓንቴ፦ «ኔኤኒ ያኣሶ ዔቄ ጋዓንዳኔ፤ ሃንጎ ዒንሢ ዒዛ ሃይካ ሙኪ ቶኮ ዴማ ዴዔ» ጋዓንዳኔ። <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>ዬያይዲፆና ዒንሢ ባኣኮይዳ ዒንሢ ፔቴሢ ሂርኪዲ ባጋሢ ባሼ ማሂ ዱሙሞ ሳዛ ጌሣያ፥ ሃሣ ፑርቱሞና ዓሲዳ ዎጋያ ማዒባኣዓዳ?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>ታኣኒ ዒንሢ ናሽካ፥ ታኣኮ ዒሾንሦ! ሚሾንሦ! ዋይዙዋቴ፤ ፆኦሲ ዒዛ ጉሙርቂ ጎናሲ ዔኪፆና ዔያታ ዖርጎቺ ማዓንዳጉዲና ዒዛ ናሽካ ዓሶም ሃጊ ማዓንዳ ዎዛ ማሂ ዒንጌ ካኣቱሞ ዔያታ ዻካላንዳጉዲ ሃያ ሳዖይዳ ዓኣ ማንቆ ዓሶ ዒዚ ዶኦሪባኣዓዳ? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>ዒንሢ ጋዓንቴ ማንቆ ዓሶ ቦሃኔ፤ ዒንሢ ሜታሳ ዓሶና ሃሣ ዎጎ ቤዞ ዒንሢ ዔኪ ዔኪ ዓኣዻ ዓሳ ዖርጎጮ ዓሶቱዋዓዳ? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>ዒንሢ ዛሎና ዔኤሊንታ ቦንቺንቴ ሱንፆ ዒንሢኮ ጫሽካሢ ዔያቶቱዋዓዳ?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>ጌኤዦ ማፃኣፖይዳ፦ «ዓሲ ዓዳ ኔና ማሂ ናሽኬ» ጌይንቲ ፃኣፒንቴ ፆኦሲኮ ቦንቺንቴ ዎጎ ዒንሢ ኩንሣያ ማዔቶ ኮሺ ዒንሢ ማዻኔ። <note caller="-" style="x"><char style="xo" closed="false">2፡8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌዊ. ዓኬ 19፡18</ref>።</char></note> <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>ዓሶ ባኣካ ዒንሢ ዱማሲሢ ጌሤቶ ጋዓንቴ ጎሜ ዒንሢ ማዻኔ፤ ዎጎኮ ዒንሢ ዑሣ ዓኣዺፆና ዎጋ ፔ ቶኦኪና ዒንሢም ዻቢንቶ ዻዋንዳኔ። <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>ዓሲ ፆኦሲ ዓይሢፆ ቢያሢዳፓ ፔቴ ዻባዖ፥ ሃንጎ ዓቴሢ ቢያ ኩንሤያታቶዋ ቢያሢ ዒዚ ዻቤያ ማዓንዳኔ። <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>«ማቾ ሃሣ ዓኒ ማዒባኣ ዓሲና ላሂፖ» ጌዔ ጎዳሢ ዬያጉዲ ሃሣ «ዓሲ ዎዺፖ» ጌዔኔ፤ ኔኤኒ ማቾ ሃሣ ዓኒ ማዒባኣ ዓሲና ላሂባኣያ ማዔቶዋ ዓሲ ኔ ዎዼቴ ዎጎ ኔ ዻቤኔ። <note caller="-" style="x"><char style="xo" closed="false">2፡11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">ኬሲ. ማፃ 20፡13-14</ref>፤ <ref loc="DEU 5:17-18">ላሚ. ዎማ 5፡17-18</ref>።</char></note> <verse eid="JAS 2:11"/><verse number="12" style="v" sid="JAS 2:12"/>ዒንሢ ጌስታኣና ሃሣ ማዻኣና ዎጋ ጎሜ ዓይላቶይዳፓ ጉቤ ኬሴ ዓሲጉዲ ማዑዋቴ። <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>ዓይጎሮ ጌዔቶ ፆኦሲኮ ዎጋ ዓቶም ጎውዋ ዓሲም ፔኤሮ ዓቶም ጎውዋሴ፤ ያዺ ማዔቶዋ ዓቶም ጌይሢ ዎጌ ባባሻኔ።<verse eid="JAS 2:13"/></para>
  <para style="s1">ጉሙርቂሢና ማዾና ዛላ</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>ታ ዒሾንሦ! ታ ሚሾንሦ! ዓሲ፦ «ዬሱሴ ታ ጉሙርቃኔ» ጋዓዖ፥ ጉሙርቂፆ ኮሺ ማዾና ፔጋሲባኣቶ ዒዛ ዓይጎ ማኣዳንዳይ? ጉሙርቂፃ ዒዛኮ ዒዛ ዻቂሻኒ ዳንዳዓ? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>ኮኦኪንሢና ማኣዓ ባኣዚና ሙዓ ባኣዚና ባኣ ጌርሲንሢ ሃሣ ጌሮንሢ ማዓ ዓሲ ዒንሢኮ ዓኣንቴ፥ <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>ዒንሢ ዔያቶ ናንጎም ኮይሳ ባኮ ዒንጉዋዖ ጉሪ፦ «ኮሺ ዓኣዹዋቴ! ዒንሢም ዖይዾንጎ! ሙዒ ሚሽኩዋቴ!» ጌዔያታቶ ዔያቶ ዓይጎ ማኣዳንዳይ? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>ዬያሮ ኮሺ ማዾይዳፓ ዱማዼ ዬሱሴ ጉሙርቂሢ ፔ ቶኦኪና ሃይቄያኬ።<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>ጋዓንቴ፦ «ኔኤኒ ‹ታ ዬሱሴ ጉሙርቃኔ› ጌዒ ዖቶርቃያታቶ፥ ታ ኮሺ ማዾ ማዻያኬ» ጋዓ ዓሲ ዓኣቶ፥ «ታኣኒ ዒዛም ኔኤኮ ዬሱሴ ጉሙርቂፆ ኔ ማዾይዳፓ ዱማሲ ታና ቤኤዜ፤ ታኣኒያ ታ ማዾና ዬሱሴ ጉሙርቂፆ ታኣሲ ኔና ቤኤዛንዳኔ» ጋዓንዳኔ። <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>ኔኤኒ፦ «ፔቴ ፆኦሲ ዓኣኔ ጌዒ ጉሙርቃኔ» ዬይ ኮሺኬ፤ ጋዓንቴ ጉሙርቂፆ ፑርቶ ዓያናኣ ጉጉሙርቃኔ፤ ሃሣ ዒጊጪያ ጎጎጋይቃኔ። <verse eid="JAS 2:19"/><verse number="20" style="v" sid="JAS 2:20"/>ኔኤኒ ሃይ ዔኤያሢ! ማዾይዳፓ ዱማዼ ጉሙርቂሢ ዓኣፒ ባኣያ<note caller="+" style="f"><char style="fr" closed="false">2፡20 </char><char style="fq" closed="false">ዓኣፒ ባኣያ፦ </char><char style="ft" closed="false">ጋዓዞ ፔቴ ፔቴ ቡሊፆ ማፃኣፓ «ሃይቄያ» ጋዓኔ።</char></note> ማዔሢ ኔ ዛጋ? <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>ኑ ዓዳሢ ዓብራሃሜ ፔ ናኣዚ ዪሳኣቄ ዒንጎ ባኮ ሺኢሺ ካኣሽኮ ቤዞይዳ ፆኦሲም ዒንጎ ባኣዚ ማዓንዳጉዲ ሺኢሼ ዎዶና፥ ማዾና ፂሊባኣዓዳ? <note caller="-" style="x"><char style="xo" closed="false">2፡21 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">ማዢ. ማፃ 22፡1-14</ref>።</char></note> <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>ዬይ ጉሙርቂፃ ማዾና ዎላ ማዔሢና ጉሙርቂፃኣ ማዾና ጎናዼሢ ኔ ዛጋ? <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>ጌኤዦ ማፃኣፖይዳ፦ «ዓብራሃሜ ፆኦሲ ጉሙርቄኔ፤ ፆኦሲያ ዒዛ ፔ ዓሲ ማሄኔ» ጌይንቴ ቃኣላ ኩሜኔ፤ ዬያይዲፆና ዓብራሃሜ ፆኦሲኮ ላጌ ጌይንቴኔ። <note caller="-" style="x"><char style="xo" closed="false">2፡23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">ማዢ. ማፃ 15፡6</ref>፤ <ref loc="2CH 20:7">2ፆኦሲ. ዓሃኬ 20፡7</ref>፤ <ref loc="ISA 41:8">ዒሲ. 41፡8</ref>።</char></note> <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>ዓካሪ ዓሲ ፂላሢ ጉሙርቂሢና ሌሊቱዋንቴ ማዾና ዎላ ማዔሢ ኔ ዛጋኔ።<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>ዓኒ ባኣያ ዞኦዛ ኮኦማ፥ ሬዓባ ጌይንታ ላኣሌላ ዒስራዔኤሌኮ ኪኢቶ ዓሶ ፔ ማኣራ ዔኪ ሾኦቺንሢፆና ሃሣ ጊንሣ ሜሌ ጎይሢና ፑኒንቲ ዔያታ ቶሊ ዴንዳንዳጉዲ ማሂፆና ፔ ማዾና ፂሊባኣዓዳ? <note caller="-" style="x"><char style="xo" closed="false">2፡25 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">ዒያ. 2፡1-21</ref>።</char></note><verse eid="JAS 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26"/>ሼምፖይዳፓ ዱማዼ ዓሽኪ ሃይቄያታሢጉዲ ማዾይዳፓ ዱማዼ ጉሙርቂሢ ያዼ ሃይቄያኬ።<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s1">ዒንዲርሲ ፑርታ ባኣዚፓ ካፒሢ ዛላ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>ታ ዒሾንሦ! ታ ሚሾንሦ! ኑኡኒ ዔርዛ ዓሶ ማዔ ዓሳ ዑሣ ዓኣዼ ሜቶ ዔካንዳያ ማዔሢ ዒንሢ ዔራኔ፤ ዬያሮ ዒንሢዳፓ ሚርጌሢ ዔርዛ ዓሶ ማዖፓ። <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>ዓይጎሮ ጌዔቶ ኑኡኒ ቢያሢ ሚርጌና ዻቢንታኔ፤ ፔ ጌስታ ጌኤዞና ዻቢንቱዋ ዓሢ ዬይ ፔና ካፓኒ ዳንዳዓ ጎኔ ዓሲኬ። <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>ፓራሢ ኑም ዓይሢንታንዳጉዲ ዻንጎይዳ ኑኡኒ ቢፃላ ጌልዛኔ፤ ዬያይዲ ኑ ኮዔ ቤሲ ፓራሢ ዔኪ ዓኣዻኔ። <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>ሃሣ ዋኣፆ ካኣሚላ ዎዚ ዼኤፒ ማዔያ ሃሣ ዼኤፒ ዢባሬና ሂዒንቲ ዓኣዻያ ማዔቶዋ፥ ዋኣፆ ካኣሚሎ ዒሻ ዓሢ ዓልዔቱዋ ባኣዚና ዒዚ ኮዔ ቤሲ ዔኪ ዓኣዻኔ። <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>ዬያጉዲ ዒንዲርሲ ዑፆይዳፓ ዻካታዖ ሚርጌ ዼኤፒ ባኣዚና ዖቶርቃኔ፤ ፑኡፒ ካይዚ ሚቺንታሢ ዻካ ታሚናኬ። <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>ዬኖ ጎይፆ ዒንዲርሲያ ታሚኬ፤ ዒንዲርሲ ኑ ዑፆ ባኣኮይዳ ጴዻ ፑርታ ዓጪኬ፤ ኑኡኮ ዑፃ ዓኣ ዓሽኮዋ ቢያ ዒኢሳኔ፤ ናንጎ ቢያይዳ ኑኡኮ ዓኣ ጳዦና ዑፆና ቢያ ታሚዳ ሚቻኔ፤ ፔኤሮዋ ባይቁዋ ጋኣናኣሜ ታሞይዳ ሚቺንታንዳኔ። <verse eid="JAS 3:6"/><verse number="7" style="v" sid="JAS 3:7"/>ሳዖይዳ ዓኣ ካፖንታ ቦዖ ዻኮንታ ዼኤፖንታ ሃሣ ባዞይዳ ዓኣ ማዢንታ ቢያ ዓሲና ዓርቂ ቆሊንታኒ ዳንዳዓኔ፤ ዓሲያ ዔያቶ ቆላኔ። <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>ጋዓንቴ ዒንዲርሲ ዓርቂ ቆላኒ ዳንዳዓ ዓሲ ፔቴታዖ ባኣሴ፤ ዒዞ ጊዳ ዓሲ ዎዻ ባኣዚ ኩሜያ፥ ሃሣ ሃውሺሢያ ባኣ ፑርታ ባኣዚኬ። <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>ዒዞ ዒንዲርዜሎና ኑ ጎዳሢና ኑ ዓዳሢያ ኑ ዓንጃኔ፤ ሃሣ ዒዞና ፆኦሲ ማሎና ማዢንቴ ዓሶዋ ኑ ጋዳንቃኔ። <note caller="-" style="x"><char style="xo" closed="false">3፡9 </char><char style="xt" closed="false"><ref loc="GEN 1:26">ማዢ. ማፃ 1፡26</ref>።</char></note> <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>ፔቴ ዻንጋይዳፓ ዓንጆና ጋዳማና ኬስካኔ፤ ታ ዒሾንሦ! ታ ሚሾንሦ! ዬይ ያዺ ማዓኒ ኮይሱዋሴ። <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>ፔቴ ዋኣሢ ዓልቃ ቤስካፓ ኮሺ ዋኣሢና ፑርታ ዋኣሢና ዓልቃኒ ዳንዳዓ? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>ታ ዒሾንሦ! ታ ሚሾንሦ! ቤሌሴ ሚፃ ዛይቶ ሪሚቶ ዓኣፖ ዓኣፓኒ ዳንዳዓ? ጊንሣ ሃሣ ዎይኔ ቤሌሴ ዓኣፖ ዓኣፓኒ ዳንዳዓ? ዬያጉዲ ፑርታ ዋኣሢ ዓልቃ ቤስካፓ ኮሺ ዋኣሢ ጴዻኒ ዳንዳዑዋሴ።<verse eid="JAS 3:12"/></para>
  <para style="s1">ጫሪንቺ ዔራቶና ሳዓ ዔራቶና</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>ዒንሢ ባኣኮይዳ ዔራ ማዔያና ጶቂሣያ ማዔ ዓሲ ዖናዳይ? ፔኤኮ ማዾ ዔራቶና ማዔ ኮሺ ናንጊና ፔጋሲ ዻዎንጎ። <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>ጋዓንቴ ፑርታ ቂኢሩሞና ፔና ናሽኪሢና ዒንሢኮ ዒኖ ጊዳ ዓኣቶ ዖቶርቂፖቴ፤ ጎኔ ባኣዚያ «ዔሩዋሴ» ጌይፖቴ። <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>ዓይጎሮ ጌዔቶ ዬኖጉዴ ዔራታ ጴዻሢ ዓጮይዳፓ፥ ዓሲዳፓ ሃሣ ፃላሄይዳፓ ማዓንዳኣፓዓቴም ፆኦሲዳፓቱዋሴ። <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>ቂኢሩሞና ፔና ናሽኪሢና ዓኣ ቤሲዳ፥ ዣሎና ፑርታ ማዾና ቢያ ዓኣያ ማዓኔ። <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>ጋዓንቴ ፆኦሲዳፓ ጴዻ ዔራታ ቤርታሳዖ ጌኤሺኬ፤ ሄሊሳዖ ኮሹሞ ናሽካያ፥ ጊቢ ዳንዳዓያ፥ ዓይሢንታያ፥ ዓቶም ጋዓያ፥ ቃራ ዓኣፒ ዓኣፓያ፥ ዓሲ ዱማሲሢና ዔራያ ፔና ማሊሲሢና ባኣያኬ። <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>ኮሺ ናሽካ ዓሳ ኮሹሞ ዜርቃዖ ፂሉሞ ዓኣፒ ዴንቃኔ።<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s1">ፆኦሲም ቆሊንቲሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>ዒንሢ ባኣኮይዳ ዓኣ ዖሎና ዑሮና ዓንካፓ ሙኬያዳይ? ዒንሢ ዒኖይዳ ዖልታ ዒንሢ ሱኡኮይዳፓ ዔቄያቱዋዓዳ? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>ዒንሢ ኮዓ ባኮ ዴንቂፃ ባሻዛ ዒንሢ ዎላ ዖልታኔ፤ ሚርጌና ሱኡካዺ ዴንቆ ባሻዛ ዒንሢ ዎላ ዣላኔ፤ ሃሣ ዎላ ማርማኔ። ዒንሢ ሺኢጲሢ ሺኢቁዋያ ማዔሢሮ ዒንሢ ኮዓ ባኮ ዴንቁዋሴ። <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>ዒንሢ ሺኢቄቶዋ ሺኢጲፆኮ ማሂፆ ዒንሢ ዴንቁዋኣሢ ዒንሢ ሺኢቄ ባኮ ዒንሢ ዎዛሲሢዳ ፔኤሻኒ ፑርታ ማሊሢና ሺኢቃሢሮኬ። <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>ዒንሢ ሃይ ጉሙርቂፃ ባኣ ዓሳ! ዓጮ ናሽካሢ ፆኦሲኮ ሞርኬታሢ ዒንሢ ዔሩዋዓዳ? ዬያሮ ዓጮ ናሽካሢ ቢያ ፆኦሲኮ ሞርኬ ማዓኔ። <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>ሃሣ ጊንሣ ጌኤዦ ማፃኣፖይዳ፦ «ፆኦሲ ዒንሢኮ ዒኖ ጋሮይዳ ጌሤ ዓያና ዒዛም ሌሊ ኑ ማዓንዳጉዲ ሚርጌና ኮዓኔ» ጌይንቴሢ ጉሪዳ? <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>ጌኤዦ ማፃኣፖይዳ፦ «ፆኦሲ ዖቶርቃ ዓሶ ዒፃኔ፤ ሼሌዔ ኮሺ ማዔ ዓሶም ጋዓንቴ ኮሹሞ ዒንጊፆ ዒንጋኔ» ጋዓሢሮ፥ ፆኦሲ ዒንጋ ኮሹሞ ዒንጊፃ ቢያፓ ባሼኬ። <note caller="-" style="x"><char style="xo" closed="false">4፡6 </char><char style="xt" closed="false"><ref loc="PRO 3:34">ኮኦኪ. 3፡34</ref>።</char></note><verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>ዬያሮ ፆኦሲም ዓይሢንቲ ዎርቁዋቴ፤ ፃላሄ ጋዓንቴ ዒፂ ማኩዋቴ፤ ዒንሢዳፓኣ ዒዚ ሃካንዳኔ። <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>ፆኦሲ ባንሢ ዑኩዋቴ፥ ፆኦሲያ ዒንሢ ባንሢ ዑካንዳኔ፤ ዒንሢ ጎሞ ዓሳ! ዒንሢኮ ኩጮ ማስኪ ጌኤሹዋቴ፤ ዒንሢ ሴካ ሃንጋ ጋዓ ዓሳ! ዒኖ ዒንሢኮ ፒዚሱዋቴ። <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>ሃሣ ዒናፓ ጎኔና ማሊ ሜታዹዋቴ፤ ዖዩዋቴ፤ ሚኢጫ ዒንሢኮ ዬኤፒ ባንሢ፥ ዎዛ ዒንሢኮ ዖዪሢ ባንሢ ላኣሚንቶንጎ። <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>ጎዳሢ ቤርቶይዳ ዒንሢ ቶኦኮ ሂርኪዱዋቴ፤ ዒዚያ ዒንሢ ዼጊዳንዳኔ።<verse eid="JAS 4:10"/></para>
  <para style="s1">ዓሲዳ ኮይሱዋ ጎይሢና ዎጊሢ ዛላ</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>ታ ዒሾንሦ! ታ ሚሾንሦ! ሴካና ሃንጋና ዎሊ ዾንኪፖቴ፤ ዓሲ ዾንካ ዓሲ ሃሣ ዓሲዳ ኮይሱዋ ጎይሢና ዎጋ ዓሲ ዎጎ ዾንካኔ፤ ዎጎይዳኣ ዎጋኔ፤ ዎጎይዳ ኔኤኒ ዎጋያ ማዔቶ፥ ዎጌ ኔ ዎጋያ ማዓንዳኣፓዓቴም ዎጌ ኔ ኩኩንሣያቱዋሴ። <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>ዎጎ ዒንጋሢና ዎጋሢ ፔቴ ፆኦዛሢ ሌሊኬ፤ ዻቂሻኒያ ባይዛኒያ ዳንዳዓሢ ዒዛ ሌሊኬ፤ ሂዳዖ ዓሲዳ ኮይሱዋ ጎይሢና ዎጋሢ ኔ ዖናዳይ?<verse eid="JAS 4:12"/></para>
  <para style="s1">ዓኣ ባኣዚና ሄርሺንቲ ዛላ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>ዒንሢ፦ «ሃኖታቴያ ዚሮ ሜሌ ዓጪ ኑ ዓኣዺ ዒኢካ ፔቴ ሌዔ ዴዓንዳኔ፤ ኮርሚያ ዑሣ ዓኣዼ ሚኢሼ ዴንቃንዳኔ» ጋዓ ዓሳ ዒንሢ ኮሺ ዋይዙዋቴ። <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>ዓይጎሮ ጌዔቶ ዚሮ ማዓንዳ ባኮ ዒንሢ ዔሩዋሴ፤ ዒንሢኮ ሼምፓሢ ፔቴና ጴዻዖ ባይቃ ሱኡሌጉዴያኬ። <note caller="-" style="x"><char style="xo" closed="false">4፡14 </char><char style="xt" closed="false"><ref loc="PRO 27:1">ኮኦኪ. 27፡1</ref>።</char></note> <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>ባሼ ዒንሢ ጋዓንዳያ ኮይሳሢ፦ «ፆኦሲ ጌዔቶ፥ ሃሣ ሼምፓሢ ኑኡኮ ዓኣያ ማዔቶ ሃያንታ ዬያንታ ኑ ማዻንዳኔ» ጌይሢኬ። <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>ዒንሢ ጋዓንቴ ዬያ ጎዖንዶሢ ሃሺ ዒንሢኮ ዓኣ ባኮና ሄርሺንታኔ፤ ዬያጉዴ ሄርሺንታ ቢያ ፑርታኬ።<verse eid="JAS 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17"/>ዓካሪ ኮሺ ባኣዚ ማዺሢ ዔራያታዖ ማዹዋ ዓሢኮ፥ ማዹዋዖ ሃሺፃ ጎሜ ማዓኔ።<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s1">ዖርጎጮ ዓሶም ላቲ ኬኤዞና ባኣዚ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>ሃሣ ዒንሢ ዖርጎጮ ዓሳ ሃኒ ዬዒ ዋይዙዋቴ፤ ፑርታ ሜታ ዒንሢዳ ሄላንዳሢሮ ዒላቲ ዒላቲ ዬኤኩዋቴ። <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>ዒንሢኮ ቆላ ቢያ ዎዒ ፑርቴኔ፤ ዓፒሎዋ ዒንሢኮ ቁንቁና ሙዔኔ። <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>ዒንሢኮ ዓኣ ዎርቆና ቢሮና ሳልፔኔ፤ ዬይ ሳልፒፃ ዒንሢም ማርካ ማዓንዳኔ። ሃሣ ዒንሢኮ ዓሽኮ ዓዳ ታሚጉዲ ሙዓንዳኔ፤ ጋፒንፆ ኬሎም ዬያ ዺቦ ቆሎ ዒንሢ ቡኩሴኔ። <note caller="-" style="x"><char style="xo" closed="false">5፡3 </char><char style="xt" closed="false"><ref loc="MAT 6:19">ማቲ. 6፡19</ref>።</char></note> <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>ያዺ ማዓዛ ሃሣ ጎዦይዳ ዒንሢም ማኣሎ ቡሪ ፔኤቄ ዓሶም ኮይሳ ባኮ ዒንሢ ጪጊባኣሢሮ ሃይሾ ዒንሢ ዔያታ ቆፂ ዒላታ ዒላቶ ዔያቶኮ ቢያ ባኮ ዎይሣ ጎዳሢ ዋይዜኔ። <note caller="-" style="x"><char style="xo" closed="false">5፡4 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">ላሚ. ዎማ 24፡14-15</ref>።</char></note> <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>ሳዖይዳ ኮሺ፤ ሃሣ ሚርጌና ዎዛሳ ናንጊ ዒንሢ ናንጊፆና ዑፆ ዒንሢሲ ዒንሢ ዓዳ ሹኪንታኒ ጊኢጌ ቡዋጉዲ ማሊሴኔ። <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>ጌኤዣሢ ዒንሢ ሉኡዙሞና ዻቤያ ማሂ፥ ዎዺያ ዒንሢ ዒዛ ዎዼኔ፤ ጋዓንቴ ዒንሢ ዒዚ ዒፂ ማኩዋሴ።<verse eid="JAS 5:6"/></para>
  <para style="s1">ሜቶይዳ ጊቢ ዳንዳዒሢ</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>ታ ዒሾንሦ! ታ ሚሾንሦ! ዓካሪ ጎዳሢኮ ሙኮ ጊቢ ካፑዋቴ፤ ጎሽካ ዓሲ ሌዖ ዒሮና ሲሎ ዒሮና ዴንቃንዳያ ሄላንዳኣና ጊቢ ቃራ ዓኣፒ ሳዓፓ ዴንቃኒ ካፓኔ፤ <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>ዒንሢያ ዬያጉዲ ጊቡዋቴ፤ ጎዳኮ ሙኮ ዎዳ ዑኬሢሮ ዎዛና ዶዱዋቴ።<verse eid="JAS 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9"/>ታ ዒሾንሦ! ታ ሚሾንሦ! ዒንሢ ጊዶይዳ ዎጊንቱዋጉዲ ሴካና ሃንጋና ዎላ ማርሚፖቴ፤ ሃይሾ ዎጋሢ ሙካንዳ ዎዳ ሄሌኔ። <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>ታ ዒሾንሦ! ታ ሚሾንሦ! ጎዳሢ ሱንፆና ፆኦሲ ማሊፆ ኬኤዛ ዓሳ ሜቶ ጊቢ ዔኪፆና ኮኦኪንሢ ዒንሢም ማዔያታሢ ዔሩዋቴ። <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>ሃሢ ጊቢ ዶዴ ዓሶ «ዓንጂንቴያኬ» ኑ ጋዓኔ፤ ዒዮቤ ጎዖሢ ዎዲ ጊቤያታቴያ ዒንሢ ዋይዜኔ። ጊንሣ ጋፒንፆይዳ ፆኦሲ ዒዛም ማዼ ኮዦ ባኮዋ ዒንሢ ዛጌኔ፤ ዬያይዲፆና ጎዳ ማኣራያ፥ ሃሣ ሚርጌ ሚጪንታያ ማዔሢ ዒንሢ ዔሬኔ። <note caller="-" style="x"><char style="xo" closed="false">5፡11 </char><char style="xt" closed="false"><ref loc="JOB 1:21-22">ዒዮ. 1፡21-22</ref>፤ <ref loc="JOB 2:10">2፡10</ref>፤ <ref loc="PSA 103:8">ዓይኑ. 103፡8</ref>።</char></note><verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>ታ ዒሾንሦ! ታ ሚሾንሦ! ቢያ ባኣዚኮ ቤርታ ጫሪንቺና ማዖም ሳዓና ሃሣ ሜሌ ዓይጎ ባኣዚናታዖ ጫኣቂፖቴ፤ ጌኤዛ ዒንሢኮ ጎኔና «ሂዮ» ማዔቶ ሂዮ ማዖንጎ፤ ሃሣ «ዔይዔ» ማዔቶ ጎኔና ዔይዔ ማዖንጎ፤ ያዺ ማዒባኣቶ ጋዓንቴ ዒንሢዳ ዎጊንታንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">5፡12 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">ማቲ. 5፡34-37</ref>።</char></note><verse eid="JAS 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>ዒንሢ ባኣኮይዳ ሜታ ሄሌ ዓሲ ዓኣቶ ሺኢቆንጎ፤ ሃሣ ዎዛዻ ዓሲ ዓኣቶ ፆኦሲ ጋላቲ ጋላቲ ዓይናዾንጎ። <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>ዬያጉዲ ዒንሢ ባኣኮይዳ ሃርጊንቴ ዓሲ ዓኣቶ ሺኢጲፆ ማኣሮ ጪሞ ፔ ባንሢ ዔኤሎንጎ፤ ዔያታ ሙካዖ ሃርጊንቴ ዓሢ ጎዳ ሱንፆና ዛይቶ ቲዦ ቲሽኪ ዒዛም ሺኢቆንጎ። <note caller="-" style="x"><char style="xo" closed="false">5፡14 </char><char style="xt" closed="false"><ref loc="MRK 6:13">ማር. 6፡13</ref>።</char></note> <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>ዬያጉዴ ጉሙርቂሢዳ ዶዲ ዔቂ ሺኢቆ ሺኢጲሢ ሃርጌ ዓሢ ዻቂሻኔ፤ ጎዳሢያ ዒዛ ሃርጎይዳፓ ፖዒሳንዳኔ፤ ሃሣ ዬይ ዓሢ ማዼ ጎሜ ዓኣቶዋ ዓቶም ጌይንታኔ። <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>ዬያሮ ዒንሢ ሃርጎፓ ፖዓኒ ዒንሢኮ ጎሞ ሴካና ሃንጋና ዎሊም ቡኡፂንቱዋቴ፤ ሃሣ ፔቴሢ ባጋሢም ሺኢቆንጎ፤ ጌኤሺ ዓሲ ሺኢጲሢኮ ሚርጌ ባኣዚ ማዻ፥ ዼኤፒ ዎልቄ ዓኣኔ። <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>ዔኤሊያሴ ጎዖሢ ኑጉዴያ ዓሲታዖ፥ ዒርዚ ሳዖይዳ ዋርቁዋጉዲ ሺኢቄ ዎዶና ሃይሦ ሌዔና ላሆ ዓጊኒና ፔቴታዖ ዒርዚ ዋርቂባኣሴ። <note caller="-" style="x"><char style="xo" closed="false">5፡17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1ካኣቶ. ማ 17፡1</ref>፤ <ref loc="1KI 18:1">18፡1</ref>።</char></note> <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>ሃሣ ጊንሣ ዒዚ ሺኢቄ ዎዶና ጫሪንጫፓ ዒርዚ ዋርቄኔ፤ ሳዓ ጊንሣ ሃኣኮ ካሤኔ። <note caller="-" style="x"><char style="xo" closed="false">5፡18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1ካኣቶ. ማ 18፡42-45</ref>።</char></note><verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>ታ ዒሾንሦ! ታ ሚሾንሦ! ዒንሢዳፓ ፔቴ ዓሲ ጎኑሞ ጎይፃፓ ኬስኬያ ማዔም ባጋሢ ዬያ ዓሢ ጎኑሞ ጎይፆ ባንሢ ማሄቶ፥ <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>ጎሞ ዓሢ ዻቢንቴ ጎይፃፓ ማሃሢ፥ ጎሞ ዓሢኮ ሼምፖ ሃይቢዳፓ ዻቂሻያ ማዒፆና ሃሣ ዬያ ዓሢም ሚርጌ ጎሜኮ ዓቶም ጌዒሢ ዴንቂሳያ ማዔሢ ዔሮንጎ። <note caller="-" style="x"><char style="xo" closed="false">5፡20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">ኮኦኪ. 10፡12</ref>፤ <ref loc="1PE 4:8">1ጴፂ. 4፡8</ref>።</char></note><verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
