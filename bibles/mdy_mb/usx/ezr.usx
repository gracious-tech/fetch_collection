<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EZR" style="id">- MAALE Full Bible</book>
  <para style="h">ዒዝራ ማፃኣፖ</para>
  <para style="toc1">ዒዝራ ማፃኣፖ</para>
  <para style="toc3">ዒዝ.</para>
  <para style="toc2">ዒዝራ ማፃኣፖ</para>
  <para style="mt1">ዒዝራ ማፃኣፖ</para>
  <para style="imt">ዓይፆ ካሮ</para>
  <para style="ip">ዒዝራ ማፃኣፓ ፆኦሲ ዓሶ ሃይሶ ኬኤዛ ላምዖ ማፃኣፖንሢ ሄሌያ ማዓዖ፥ ኬኤዛ ሃይሳ ዳውሲንቲ ዴንዲ ዓኣ ዓይሁዶ ዓሶኮ ዛላ ዓሲ ባብሎኔ ዓጫፓ ማዔሢና ዬሩሳላሜይዳ ዓሲኮ ናንጊንታ ፆኦሲ ካኣሽኪሢንታ ዛላ ጊንሣ ዓካሶናያ ማዔሢኬ፤ ዬይ ሃይሳ ፓቂንቴሢ ሃካፓ ዴማ ዓኣ ጎይፆኬ፦</para>
  <para style="ip">1. ባብሎኔይዳ ዳውሲንቲ ዴንዲ ዓኣ ዓይሁዶ ዓሶፓ ካኣቲ ቂኢሮሴ ዓይሤም ቤርታዺ ማዔ ዓሶ</para>
  <para style="ip">2. ጌኤዦ ማኣሮ ጊንሣ ዓካሲ ማዾ ዓርቆናሢና ፆኦሲ ካኣሽኪፆ ዬሩሳላሜይዳ ዓርቆናሢ</para>
  <para style="ip">3. ሚርጌ ሌዔኮ ጊንፃፓ ፆኦሲኮ ዎጎ ዔራ፥ ዒዝራ ዓይሁዶ ዓሶ ዬሩሳላሜ ዔኪ ሙኬሢ፤ ዬይ ዒዝራ ዒስራዔኤሌ ዓሳ ፆኦሲም ማዾ ማዾ ቤርታኣሲጉዲ ማሃኒና ዴራ ፔኤኮ ፔቱሞና ናንጋ ናንጎዋ ጊንሣ ዶዲሻንዳጉዲ ማኣዴኔ።</para>
  <para style="iot">ማፃኣፔላ ዱማ ዱማ ዓርቄ ባኮ</para>
  <para style="io1">ዲዒንታፓ ቤርታሲ ማዔ ዓሶ (1፡1—2፡70)</para>
  <para style="io1">ጌኤዦ ማኣሮ ዓካሶናሢንታ ማዾማኣ ጊኢጊሾናሢ (3፡1—6፡22)</para>
  <para style="io1">ዒዝራና ዎላ ዲዒንታፓ ማዔ ዓሶ (7፡1—10፡44)</para>
  <chapter number="1" style="c" sid="EZR 1"/>
  <para style="s1">ዓይሁዶ ዓሳ ፔ ዓጮ ማዓንዳጉዲ ቂኢሮሴ ዓይሤሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 1:1"/>ናንጊና ናንጋ ጎዳ ፔ ማሊፆ ኬኤዛ ዔርሚያሴ ዛሎና ቤርታ ኬኤዜ ሎንሦ ቃኣሎ ፓርሴ ዓሢ ቂኢሮሴ ካኣታዼ ቤርታሳ ሌዖና ጌይንቴሢጉዲ ማዺ ኩንሤኔ፤ ዎዎዴይ ጌዔቴ፦ ናንጊና ናንጋ ጎዳ ቂኢሮሴ ፔኤሮ ዔቂሲ ሃካፓ ዴማ ዓኣ ዓይሢፆ ፃኣፒሲ ዓጮ ቢያይዳ ናባቢሴኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="JER 25:11">ዔር. 25፡11</ref>፤ <ref loc="JER 29:10">29፡10</ref>።</char></note><verse eid="EZR 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EZR 1:2"/>ፓርሴ ካኣቲ ፃኣፒ ዓይሤ ባካ፦ «ናንጊና ናንጋ ጎዳ ማዔ ጫሪንጮኮ ፆኦዛሢ ዓጮ ቢያ ታኣኒ ዎይሣንዳጉዲ ማሄኔ፤ ዒዚ ፔ ካኣሽኪንታንዳ ጌኤሺ ማኣሪ ዪሁዳ ዓጮኮ ዬሩሳላሜይዳ ታኣኒ ማዣንዳጉዲ ታና ዓይሤኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡2 </char><char style="xt" closed="false"><ref loc="ISA 44:28">ዒሲ. 44፡28</ref>።</char></note> <verse eid="EZR 1:2"/><verse number="3" style="v" sid="EZR 1:3"/>ዓካሪ ዒንሢ ባኣካፓ ናንጊና ናንጋ ጎዳ ዴሬ ማዔ ዓሲ ጉቤ ፆኦሲ ዒዛና ዎላ ማዖንጎ! ዪሁዳይዳ ዓኣ ዬሩሳላሜ ዴንዲጋፓ ዒኢካ ናንጋ ፆኦዛሢም፥ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢም ጌኤሺ ማኣሪ ማዦንጎ። <verse eid="EZR 1:3"/><verse number="4" style="v" sid="EZR 1:4"/>ፆኦሲ ዴሮታዖ ዳውሲንቲ ዴንዲ ዓኣዞንሢ ፔ ዓጮ ማዓ ዎዶና ዔያቶና ዎላ ናንጌ ዓሳ ቢራንታ ዎርቄንታ ዓይጎ ሜሄታቶዋ ጫኣና ጫኣና ቆልሞዋ ማዖም ዒንጊ ማኣዶንጎ፤ ዬይ ባካ ዬሩሳላሜይዳ ዓኣ ጌኤዦ ማኣሮም ፔ ሼኔና ዔያታ ዒንጋሢዳ ቃሲሢ ማዖንጎ» ጋዓያኬ።<verse eid="EZR 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 1:5"/>ዬካፓ ዪሁዳና ቢኢኒያሜና ፃጶኮ ሱኡጎንታ ቄኤሶንታ ሌዊ ዓሶንታ፤ ዬያጉዲ ሃሣ ፆኦሲ ዔቂሴ ሜሌ ዓሲ ቢያ ማዒ ዴንዳኒና ዬሩሳላሜይዳ ዓኣ ናንጊና ናንጋ ጎዳኮ ጌኤዦ ማኣሮ ጊንሣ ዓካሲ ማዣኒ ጊኢጊንቴኔ። <verse eid="EZR 1:5"/><verse number="6" style="v" sid="EZR 1:6"/>ዔያቶኮ ዓሺና ቢራ ዓንጊና ዎርቄናይዳፓ ኮሺንቴ ሜሄ፥ ጋላም ማዓንዳ ሚኢሼንታ ዔኤቢ ጫኣናንዳ ቆልሞንታ ሜሌ ኮይሳያ ማዔ ዒንጊንታ ባኣዚና ጌኤዦ ማኣሮይዳ ዒንጊሢ ማዒ ሺኢካ ባኣዚ ቢያ ዒንጊ ዔያቶ ማኣዴኔ።<verse eid="EZR 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 1:7"/>ዬያ ሌሊቱዋንቴ ሚና ቤርታ ካኣቲ ናብካዳናፆኦሬ ዬሩሳላሜይዳ ዓኣ ጌኤዦ ማኣራፓ ቡሪ ዔኪ ፔኤኮ ካኣሽኮ ፆኦዞ ማኣራ ጌሤ ዑዦ ዑሽኮ ዓንጎንታ ጌኤዦ ማኣሮ ሜሆዋ ማሂ ቂኢሮሴ ዔያቶም ዒንጌኔ። <verse eid="EZR 1:7"/><verse number="8" style="v" sid="EZR 1:8"/>ዬንሢ ዱማዼ ጌኤዦ ማኣሮ ሜሆንሢ ሜትሬዳቴ ጌይንታ ጌኤዦ ማኣሮ ሜሆ ጌሦ ኬኤፆኮ ሱኡጋሢና ፓይዲሲ ዪሁዳ ዓጮ ዎይሣ ሼሽባፃሬም ቂኢሮሴ ዒንጌኔ፤ <verse eid="EZR 1:8"/><verse number="9-10" style="v" sid="EZR 1:9-10"/>ዬያ ሜሆኮ ፓይዳ ሃካፓ ዴማ ዓኣ ጎይፆኬ፦</para>
  <para style="p" vid="EZR 1:9-10">ዒንጎ ባኮ ዔኮያ ማዓንዳ ዎርቄፓ ኮሺንቴ ሳኣኔ ሃይሢታሚ</para>
  <para style="p" vid="EZR 1:9-10">ዒንጎ ባኮ ዔኮያ ማዓንዳ ቢራ ዓንጊዳፓ ኮሺንቴ ሳኣኔ ፔቴ ሺያ</para>
  <para style="p" vid="EZR 1:9-10">ዱማ ዱማ ዓፓሮ ላማታሚ ታዙጳ</para>
  <para style="p" vid="EZR 1:9-10">ዎርቄይዳፓ ኮሺንቴ ዔቴ ሳኣኔ ሃይሢታሚ</para>
  <para style="p" vid="EZR 1:9-10">ቢራ ዓንጊዳፓ ኮሺንቴ ዔቴ ሳኣኔ ዖይዶ ፄኤታና ታጶ</para>
  <para style="p" vid="EZR 1:9-10">ሜሌ ሃሣ ዱማ ዱማ ሜሄ ፔቴ ሺያ<verse eid="EZR 1:9-10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 1:11"/>ሼሽባፃሬ ሃንጎ ዲዒንታፓ ማዔ ዓሶና ዎላ ባብሎኔፓ ዬሩሳላሜ ማዔ ዎዶና ዔኪ ሙኬ ቢሮ ዓንጎና ዎርቆናይዳፓ ኮሺንቴ ሜሆንታ ሜሌ ሜሆኮዋ ሚርጉማ ዶንጎ ሺያና ዖይዶ ፄኤታናኬ።<verse eid="EZR 1:11"/></para>
  <chapter eid="EZR 1"/>
  <chapter number="2" style="c" sid="EZR 2"/>
  <para style="s1">ዲዒንቶይዳፓ ፔ ዓጮ ማዔ ዒስራዔኤሌ ዓሶ</para>
  <para style="r">(<ref loc="NEH 7:4-73">ኔሄ. 7፡4-73</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 2:1"/>ባብሎኔ ካኣቲ ናብካዳናፆኦሬ ዲዒ ዔኪ ባብሎኔ ዓኣዼ ዓሶይዳፓ ፔኤኮ ካታሞ ካታሞ፥ ዬሩሳላሜና ዪሁዳና ማዒ ሙኬ ዓሶኮ ፓይዳ ያዺኬ፦ <verse eid="EZR 2:1"/><verse number="2" style="v" sid="EZR 2:2"/>ዬያቶ ዲዒንታፓ ማዔ ዓሶኮ ሱኡጎ ማዒ ዔኪ ሙኬ ዓሳ ዜሬባቡሌ፥ ዒያሱ፥ ኔሄሚያ፥ ሴራያ፥ ሬዔላያ፥ ሜርዴኪዮሴ፥ ቢልሻኔ፥ ሚስፓሬ፥ ቢግዋዬ፥ ሬሁሜንታ ቤዓና ጌይንታዞንሢኬ። ፔቴ ፔቴ ዒስራዔኤሌ ዓሶ ቶኦካፓ ቡኪንቲ ዓጮ ባንሢ ማዔ ዓሶኮ ፓይዳ ሃካፓ ዴማ ዓኣ ጎይፆኬ፦<verse eid="EZR 2:2"/></para>
  <para style="p">
    <verse number="3-20" style="v" sid="EZR 2:3-20"/>ፓርዖሼ ፃጳፓ ላምዖ ሺያና ፄኤታና ላንካይታሚ ላምዖ ዓሲ</para>
  <para style="p" vid="EZR 2:3-20">ሼፓፂያ ፃጳፓ ሃይሦ ፄኤታና ላንካይታሚ ላምዖ ዓሲ</para>
  <para style="p" vid="EZR 2:3-20">ዓራሄ ፃጳፓ ላንካይ ፄኤታና ላንካይታሚ ዶንጎ ዓሲ</para>
  <para style="p" vid="EZR 2:3-20">ፓሃትሞዓኣቤ ፃጳፓ ዒያሱና ዒዮዓቤና ዜርፃፓ ላምዖ ሺያና ሳሊ ፄኤታና ታጶ ላምዖ ዓሲ</para>
  <para style="p" vid="EZR 2:3-20">ዔላኣሜ ፃጳፓ ፔቴ ሺያና ላምዖ ፄኤታና ዶንጊታሚ ዖይዶ ዓሲ</para>
  <para style="p" vid="EZR 2:3-20">ዛቱ ፃጳፓ ታዞጳ ፄኤታና ዖይዲታሚ ዶንጎ ዓሲ</para>
  <para style="p" vid="EZR 2:3-20">ዛካዬ ፃጳፓ ላንካይ ፄኤታና ላሂታሚ ዓሲ</para>
  <para style="p" vid="EZR 2:3-20">ባኒ ፃጳፓ ላሆ ፄኤታና ዖይዲታሚ ላምዖ ዓሲ</para>
  <para style="p" vid="EZR 2:3-20">ቤባዬ ፃጳፓ ላሆ ፄኤታና ላማታሚ ሃይሦ ዓሲ</para>
  <para style="p" vid="EZR 2:3-20">ዓዝጋኣዴ ፃጳፓ ሺያና ላምዖ ፄኤታና ላማታሚ ላምዖ ዓሲ</para>
  <para style="p" vid="EZR 2:3-20">ዓዶኒቃሜ ፃጳፓ ላሆ ፄኤታና ላሂታሚ ላሆ ዓሲ</para>
  <para style="p" vid="EZR 2:3-20">ቢግዋዬ ፃጳፓ ላምዖ ሺያና ዶንጊታሚ ላሆ ዓሲ</para>
  <para style="p" vid="EZR 2:3-20">ዓዲኔ ፃጳፓ ዖይዶ ፄኤታና ዶንጊታሚ ዖይዶ ዓሲ</para>
  <para style="p" vid="EZR 2:3-20">ሂዚቂያሴ ዛሎና ዓፄሬ ፃጳፓ ታዞጲታሚ ሳሊ ዓሲ</para>
  <para style="p" vid="EZR 2:3-20">ቤፃዬ ፃጳፓ ሃይሦ ፄኤታና ላማታሚ ሃይሦ ዓሲ</para>
  <para style="p" vid="EZR 2:3-20">ዮራ ፃጳፓ ፄኤታና ታጶ ላምዖ ዓሲ</para>
  <para style="p" vid="EZR 2:3-20">ሃሹሜ ፃጳፓ ላምዖ ፄኤታና ላማታሚ ሃይሦ ዓሲ</para>
  <para style="p" vid="EZR 2:3-20">ጊባሬ ፃጳፓ ታዞጲታሚ ዶንጎ ዓሲ<verse eid="EZR 2:3-20"/></para>
  <para style="p">
    <verse number="21-35" style="v" sid="EZR 2:21-35"/>ዬያ ዲዒንታፓ ማዔ ዓሶ ባኣካፓ ዱማና ዔያቶኮ ቤርታኣ ዓዶንሢ ሃካፓ ዴማ ዓኣ ካታሞይዳ ናንጌ ዓሶኮ ፓይዳ ያዺኬ፦</para>
  <para style="p" vid="EZR 2:21-35">ቤኤቴሌሄሜይዳ ሾይንቴ ዓሳ ፄኤታና ላማታሚ ሃይሦ</para>
  <para style="p" vid="EZR 2:21-35">ኔፆፓይዳ ሾይንቴ ዓሳ ዶንጊታሚ ላሆ</para>
  <para style="p" vid="EZR 2:21-35">ዓናቶቴይዳ ሾይንቴ ዓሳ ፄኤታና ላማታሚ ሳሊ</para>
  <para style="p" vid="EZR 2:21-35">ዓዝማዌቴይዳ ሾይንቴ ዓሳ ዖይዲታሚ ላምዖ</para>
  <para style="p" vid="EZR 2:21-35">ቂርያትይዓሪሜ፥ ኬፕራና ቤዔሮቴናይዳ ሾይንቴ ዓሳ ላንካይ ፄኤታና ዖይዲታሚ ሃይሦ</para>
  <para style="p" vid="EZR 2:21-35">ራማና ጌባዔናይዳ ሾይንቴ ዓሳ ላሆ ፄኤታና ላማታሚ ፔቴ</para>
  <para style="p" vid="EZR 2:21-35">ሚክማሴይዳ ሾይንቴ ዓሳ ፄኤታና ላማታሚ ላምዖ</para>
  <para style="p" vid="EZR 2:21-35">ቤኤቴኤሌና ዓይናይዳ ሾይንቴ ዓሳ ላምዖ ፄኤታና ላማታሚ ሃይሦ</para>
  <para style="p" vid="EZR 2:21-35">ኔቦይዳ ሾይንቴ ዓሳ ዶንጊታሚ ላምዖ</para>
  <para style="p" vid="EZR 2:21-35">ማግቢሼይዳ ሾይንቴ ዓሳ ፄኤታና ዶንጊታሚ ላሆ</para>
  <para style="p" vid="EZR 2:21-35">ባጎ ዔላኣሜይዳ ሾይንቴ ዓሳ ፔቴ ሺያና ላምዖ ፄኤታና ዶንጊታሚ ዖይዶ</para>
  <para style="p" vid="EZR 2:21-35">ሃሪሜይዳ ሾይንቴ ዓሳ ሃይሦ ፄኤታና ላማታሚ</para>
  <para style="p" vid="EZR 2:21-35">ሎዴ፥ ሃዲዴና ዖኖናይዳ ሾይንቴ ዓሳ ላንካይ ፄኤታና ላማታሚ ዶንጎ</para>
  <para style="p" vid="EZR 2:21-35">ዒያርኮይዳ ሾይንቴ ዓሳ ሃይሦ ፄኤታና ዖይዲታሚ ዶንጎ</para>
  <para style="p" vid="EZR 2:21-35">ሴናዓይዳ ሾይንቴ ዓሳ ሃይሦ ሺያና ላሆ ፄኤታና ሃይሢታሚ<verse eid="EZR 2:21-35"/></para>
  <para style="p">
    <verse number="36-39" style="v" sid="EZR 2:36-39"/>ሃካፓ ዴማ ሃሣ ዲዒንታፓ ማዔ ቄኤሶ ማኣሮ ዓሶ ፓይዶ ኬኤዛኔ፦</para>
  <para style="p" vid="EZR 2:36-39">ዒያሱ ዜርፃሢ፥ ዪዳዒያ ማኣሮ ዓሶፓ ታዞጳ ፄኤታና ላንካይታሚ ሃይሦ</para>
  <para style="p" vid="EZR 2:36-39">ዒሜሬ ማኣሮ ዓሶፓ ፔቴ ሺያና ዶንጊታሚ ላምዖ</para>
  <para style="p" vid="EZR 2:36-39">ፓሽሁሬ ማኣሮ ዓሶፓ ፔቴ ሺያና ላምዖ ፄኤታና ዖይዲታሚ ላንካይ</para>
  <para style="p" vid="EZR 2:36-39">ሃሪሜ ማኣሮ ዓሶፓ ፔቴ ሺያና ታጶ ላንካይ ዓሲ<verse eid="EZR 2:36-39"/></para>
  <para style="p">
    <verse number="40-42" style="v" sid="EZR 2:40-42"/>ዲዒንቶ ቤዛፓ ማዔ ሌዊ ማኣሮ ዓሶኮ ፓይዳ ሃካፓ ዴማ ዓኣ ጎይፆኬ፦</para>
  <para style="p" vid="EZR 2:40-42">ሆዳውያ ዜርፆ ማዔ ዒያሱንታ ቃድሚዔሌንታ ማኣሮ ዓሳ ላንካይታሚ ዖይዶ</para>
  <para style="p" vid="EZR 2:40-42">ዓሳኣፔ ዜርፆ ማዔ፥ ጌኤዦ ማኣሮይዳ ፆኦሲ ቦንቾ ዓይኑሞ ዓይናዻ ዓሶኮ ሚርጉማ ፔቴ ፄኤታና ላማታሚ ሳሊ</para>
  <para style="p" vid="EZR 2:40-42">ጌኤዦ ማኣሮ ካፓ ሻሉሜ፥ ዓፄሬ፥ ፃልሞኔ፥</para>
  <para style="p" vid="EZR 2:40-42">ዓቁቤ፥ ሃፂፃንታ ሾባዬ ዜርፃፓ ፔቴ ፄኤታና ሃይሢታሚ ታዞጳ<verse eid="EZR 2:40-42"/></para>
  <para style="p">
    <verse number="43-54" style="v" sid="EZR 2:43-54"/>ዲዒንታፓ ማዔ፥ ጌኤዦ ማኣሮ ማዾም ኬሶና ቶኦካ ሃካፓ ዴማ ዓኣ ዓሶኬ፦</para>
  <para style="p" vid="EZR 2:43-54">ፂሃ፥ ሃሱፓ፥ ፃባዖቴ፥</para>
  <para style="p" vid="EZR 2:43-54">ቄሮሴ፥ ሲዓሃ፥ ፓዶኔ፥</para>
  <para style="p" vid="EZR 2:43-54">ሌባና፥ ሃጋባ፥ ዓቁቤ፥</para>
  <para style="p" vid="EZR 2:43-54">ሃጋባ፥ ሻምላዬ፥ ሃናኔ፥</para>
  <para style="p" vid="EZR 2:43-54">ጊዴሌ፥ ጋሃሬ፥ ሬዓያ፥</para>
  <para style="p" vid="EZR 2:43-54">ሬፂኔ፥ ኔቆዳ፥ ጋዛሜ፥</para>
  <para style="p" vid="EZR 2:43-54">ዑዛ፥ ፓሴሄ፥ ቤሳዬ፥</para>
  <para style="p" vid="EZR 2:43-54">ዓሲና፥ ሜዑኒሜ፥ ኔፕሲሜ፥</para>
  <para style="p" vid="EZR 2:43-54">ባቅቡቄ፥ ሃቁፓ፥ ሃርሁሬ፥</para>
  <para style="p" vid="EZR 2:43-54">ባፂሉቴ፥ ሜሂዳ፥ ሃርሻ፥</para>
  <para style="p" vid="EZR 2:43-54">ባርቆሴ፥ ሲሳራ፥ ቴማሄ፥</para>
  <para style="p" vid="EZR 2:43-54">ኔፂሃና ሃፂፓናኬ።<verse eid="EZR 2:43-54"/></para>
  <para style="p">
    <verse number="55-57" style="v" sid="EZR 2:55-57"/>ሴሎሞኔም ማዻ ዓሶ ፃጶታዖ ዲዒንታፓ ማዔ ቶኦካ፦</para>
  <para style="q" vid="EZR 2:55-57">ሶፃዬ፥ ሃሶፔሬቴ፥ ፔሩዳ፥</para>
  <para style="q" vid="EZR 2:55-57">ያዕላ፥ ዳርቆኔ፥ ጊዴሌ፥</para>
  <para style="q" vid="EZR 2:55-57">ሼፓፂያ፥ ሃፂሌ፥ ፖኬሬቴ፥</para>
  <para style="q" vid="EZR 2:55-57">ሃፄባይሜና ዓሚ ጌይንታዞንሢኬ።<verse eid="EZR 2:55-57"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="58" style="v" sid="EZR 2:58"/>ጌኤዦ ማኣሮ ማዾም ኬሶና ፃጶና ሴሎሞኔም ማዻ ዓሶ ዜርፃ ዎሊ ዑፃ ሃይሦ ፄኤታና ታዞጲታሚ ላምዖ ዓሲኬ።<verse eid="EZR 2:58"/></para>
  <para style="p">
    <verse number="59-60" style="v" sid="EZR 2:59-60"/>ቴልሜላሄ፥ ቴልሃርሻ፥ ኬሩቤ፥ ዓዳኔና ዒሜሬ ጌይንታ ካታሞንሢዳፓ ማዒ ሙኬ ዓሲ ዓኣኔ፤ ጋዓንቴ ዔያቶኮ ዜርፃ ዒስራዔኤሌ ቶኦካፓ ማዒፆ ፒዚሲ ኬኤዛኒ ዔያታ ዳንዳዒባኣሴ። ሜሌ ሃሣ ዴላያንታ ፆቢያንታ ኔቆዳ ፃጶ ቶኦካፓ ማዒ ሙኬ ላሆ ፄኤታና ዶንጊታሚ ላምዖ ዓሲያኣ ዓኣኔ፤<verse eid="EZR 2:59-60"/></para>
  <para style="p">
    <verse number="61-62" style="v" sid="EZR 2:61-62"/>ሃካፓ ዴማ ቄኤሶ ፃጶ ማዔዞንሢ ሃባያ፥ ሃቆፄና ባርዚላዬና ዔያቶኮ ቤርታኣ ዓዶንሢ ዖናንሢታቴያ ዔርቲባኣሢሮ ዔያታ ቄኤሴ ማዒ ማዻኒ ዳንዳዒባኣሴ። [ባርዚላዬ ጎዖሢ ጌሌዓዴይዳ ሾይንቴ ባርዚላዬ ፃጳፓ ፔቴ ላኣሊ ዔካዖ ዬኖ ሱንፆና ዔኤሊንቴኔ።] <verse eid="EZR 2:61-62"/><verse number="63" style="v" sid="EZR 2:63"/>ዑሪሜና ቱሚሜ ጎዖ ባኮንሢና ናንጊና ናንጋ ጎዳ ዓይጎ ጋዓቴያ ዖኦጫኒ ዳንዳዓ ቄኤሴ ኬስካንዳያ ሄላንዳኣና ፆኦሲም ሺኢሺንታ ዱማዼ ሙዖ ዔያታ ሙዑዋጉዲ ዓጮ ዎይሣ ዓሢ ዔያቶ ላኣጌኔ። <note caller="-" style="x"><char style="xo" closed="false">2፡63 </char><char style="xt" closed="false"><ref loc="NUM 29:12-38">ፓይ. ማፃ 29፡12-38</ref>።</char></note><verse eid="EZR 2:63"/></para>
  <para style="p">
    <verse number="64-67" style="v" sid="EZR 2:64-67"/>ዓካሪ ዬያ ጎይፆና ዲዒንታፓ ማዔ ዓሶኮ ሚርጉማ ዎሊ ዑፃ ዖይዲታሚ ላምዖ ሺያና ሃይሦ ፄኤታና ላሂታሚናኬ።</para>
  <para style="p" vid="EZR 2:64-67">ዬያ ዓሶፓ ማዾ ማዻ ዓቲንቆና ላኣሎናኮ ሚርጉማ ላንካይ ሺያና ሃይሦ ፄኤታና ሃይሢታሚ ላንካይ ማዓዛ፥ ዓቲንቆና ላኣሎና ማዒ ፆኦሲ ቦንቾም ዓይኑሞ ዓይናዻ ዓሳ ዎሊ ዑፃ ላምዖ ፄኤታኬ።</para>
  <para style="p" vid="EZR 2:64-67">ዬያ ዲዒንታፓ ማዔ ዓሶኮ፦ ላንካይ ፄኤታና ሃይሢታሚ ላሆ ፓራ፥ ላምዖ ፄኤታና ዖይዲታሚ ዶንጎ ባቁሎ፥ ዖይዶ ፄኤታና ሃይሢታሚ ዶንጎ ጋኣሎንታ ላሆ ሺያና ላንካይ ፄኤታና ላማታሚ ሃሬንታ ዓኣኔ።<verse eid="EZR 2:64-67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="EZR 2:68"/>ዬና ዲዒንቴ ዓሳ ዲዒንታፓ ማዒ ዬሩሳላሜይዳ ናንጊና ናንጋ ጎዳኮ ጌኤዦ ማኣራ ዓኣ ቤዞ ሄላዛ ፔቴ ፔቴ ማኣሮ ዓሶኮ ሱኡጋ ጌኤዦ ማኣራ ቤርታ ዓኣ ቤዛ ማዓንዳጉዲ ላሚ ጊንሣ ማዢፆም ማዓንዳያ ፔ ሼኔና ዒንጎ ባኣዚ ዔኪ ሺኢሼኔ። <verse eid="EZR 2:68"/><verse number="69" style="v" sid="EZR 2:69"/>ዔያታ ጌኤዦ ማኣሮ ማዾ ማዾንዶ ባኣዚ ዳንዳዓ ጎይፆና ኬሲ ቡኩሴ ዒንጊፃ ዎሊ ዑፃ ማሆዛ ዶንጎ ፄኤታ ኪሎ ዎርቄ፥ ላምዖ ሺያና ላንካይ ፄኤታና ሳሊታሚ ላሆ ኪሎ ቢራ ማዔኔ፤ ቄኤሶም ማዓያ ፄኤታ ማኣዖ ዔያታ ዒንጌኔ።<verse eid="EZR 2:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="EZR 2:70"/>ቄኤሶንታ ሌዊ ዓሶንታ ዴሮይዳፓኣ ፔቴ ፔቴ ዓሳ ዬሩሳላሜና ኮይሎናይዳ ዱንኪ ዴዔኔ፤ ጊንሣ ሃሣ ዓይኑሞ ዓይናዻ ዓሳ፥ ጌኤዦ ማኣሮ ካፓ ዓሶንታ ጌኤዦ ማኣሮ ሹጮና ማዣንዳጉዲ ጌይንቴ ማዾ ዓሶንታ ኮይላ ኮይላ ዓኣ ካታማ ዴዔኔ፤ ዬያጉዲ ሃንጎ ዒስራዔኤሌ ዓሳ ዔያቶኮ ቤርታኣ ዓዶንሢ ናንጌ ካታማ ዴዔኔ። <note caller="-" style="x"><char style="xo" closed="false">2፡70 </char><char style="xt" closed="false"><ref loc="1CH 9:2">1ፆኦሲ. ዓሃኬ 9፡2</ref>፤ <ref loc="NEH 11:3">ኔሄ. 11፡3</ref>።</char></note><verse eid="EZR 2:70"/></para>
  <chapter eid="EZR 2"/>
  <chapter number="3" style="c" sid="EZR 3"/>
  <para style="s1">ፆኦሲ ካኣሽኪፆ ዳምባ ጊንሣ ዓርቂንቴሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 3:1"/>ላንካሳ ዓጊኖና ዒስራዔኤሌ ዴራ ጉቤ ፔኤኮ ዴዓኒ ዓርቄ ካታማ ካታማ ጊኢጊንቲ ዴዔስካፓ ቢያሢ ዬሩሳላሜይዳ ቡኪንቴኔ፤ <verse eid="EZR 3:1"/><verse number="2" style="v" sid="EZR 3:2"/>ዒማና ዒዮፄዴቄ ናኣዚ ዒያሱ ዒዛኮ ዒጊኖ ማዔ ቄኤሶንታ ሳላቲያሌ ናኣዚ ዜሬባቡሌያ ፔኤኮ ዒጊኖና ዎላ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢም ዒንጎ ባኮ ሺኢሾ ቤዞ ጊንሣ ኮሼኔ፤ ፆኦሲ ዓሢ ሙሴ ዔርዜ ዎጎ ማፃኣፖይዳ ፃኣፒንቴ ዳምቦ ጎይፆ ዒኢካ ዒንጎ ባኮ ሺኢሾ ቤዞ ዑፃ ሚቺ ዒንጎ ዒንጊፆ ዔያታ ዒንጋኒ ዳንዳዔኔ። <note caller="-" style="x"><char style="xo" closed="false">3፡2 </char><char style="xt" closed="false"><ref loc="EXO 27:1">ኬሲ. ማፃ 27፡1</ref>።</char></note> <verse eid="EZR 3:2"/><verse number="3" style="v" sid="EZR 3:3"/>ዬና ዲዒንቶ ቤዛፓ ማዔ ዓሳ ዒማና ዒኢካ ዓጫ ናንጋ ሜሌ ዴራ ዔያቶ ማኪ ዒፃያ ማዔሢሮ ዒጊጬያታቴያ ፆኦሲም ዒንጎ ባኮ ሺኢሾ ቤዞ ቤርታ ኮሾና ቤዛ ማሂ ጊንሣ ኮሼኔ፤ ዬካፓ ሚቺ ዒንጎ ዒንጊፆ ጉቴና ዒባኒና ቢያ ኬላ ጊንሣ ሺኢሺሢ ዓርቄኔ። <note caller="-" style="x"><char style="xo" closed="false">3፡3 </char><char style="xt" closed="false"><ref loc="NUM 28:1-8">ፓይ. ማፃ 28፡1-8</ref>።</char></note> <verse eid="EZR 3:3"/><verse number="4" style="v" sid="EZR 3:4"/>ዎጋ ዓይሣሢ ጎይፆ ዉልሾ ዴማ ዴዒ ቦንቾ ቦንቾዋ ዔያታ ቦንቼኔ፤ ሃሣ ኬላ ኬላ ዒንጊንታንዳጉዲ ማሊንቴ ዒንጊፆዋ ሺኢሼኔ፤ <note caller="-" style="x"><char style="xo" closed="false">3፡4 </char><char style="xt" closed="false"><ref loc="NUM 29:12-38">ፓይ. ማፃ 29፡12-38</ref>።</char></note> <verse eid="EZR 3:4"/><verse number="5" style="v" sid="EZR 3:5"/>ቃሲ ሃሣ ቢያ ኬላ ኬላ ጉቤና ሚቺንቲ ዒንጊንታ ዒንጊፆ፥ ዓጊኖ ፄኤሮ ቦንቾንታ ጎዳም ዱማዼ ሜሌ ቦንቾ ኬሎንታም ዒንጊንታ ዒንጊፆና ዓሳ ፔ ሼኔና ዒንጋ ዒንጊፆ ሜሌ ዒንጎ ባኮና ዎላ ሺኢሼኔ። <note caller="-" style="x"><char style="xo" closed="false">3፡5 </char><char style="xt" closed="false"><ref loc="NUM 28:11-29:39">ፓይ. ማፃ 28፡11—29፡39</ref>።</char></note> <verse eid="EZR 3:5"/><verse number="6" style="v" sid="EZR 3:6"/>ዒማና ዴራ ሃጊ ጌኤዦ ማኣሮ ሹጮና ማዦ ዓርቂባኣቴያ ላንካሳ ዓጊና ፄኤሬ ቤርታሳ ኬሎና ናንጊና ናንጋ ጎዳም ሚቺ ዒንጎ ዒንጊፆ ዒንጊሢ ዓርቄኔ።<verse eid="EZR 3:6"/></para>
  <para style="s1">ጌኤዦ ማኣሮ ሹጮና ማዢፆ ጊንሣ ዓርቆናሢ</para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 3:7"/>ዬያጉዲ ሃሣ ዴራ ሹጮና ማኣሮ ማዣ ዓሶና ሚፆና ማዣ ዓሶናም ጪጎ ሚኢሾ ዒንጌኔ፤ ሊባኖኦሴ ዓጫፓ ዴኤሎ ዚቢቆ ቲቂ ዒዮጴ ባዞ ዓጮና ጌይሲ ዔያቶም ዳካንዳጉዲ ፂሮሴና ሲዶና ካታማ ናንጋ ዓሶም ሙኡዚንታ ዑሺንታ ሪሚታፓ ኮሾ ዛይቶዋ ዳኬኔ፤ ዬይ ቢያ ማዺንቴሢ ፓርሴ ካኣቲ ፂሮሴ ዔያቶ ዓይሤ ጎይፆናኬ። <verse eid="EZR 3:7"/><verse number="8" style="v" sid="EZR 3:8"/>ዬያሮ ዬሩሳላሜይዳ ፆኦሲኮ ጌኤዦ ማኣራ ማዢንቲ ዓኣ ቤዞ ዔያታ ሄሌ ላምዓሳ ሌዖኮ ላምዓሳ ዓጊኖና ማዾ ዔያታ ዓርቄኔ፤ ዔያቶና ዎላ ዲዒንቶይዳፓ ማዒ ዬሩሳላሜ ሙኬ ዜሬባቡሌንታ ዒያሱንታ ሜሌ ሃሣ ዔያቶኮ ዓጮ ናኣቶንታ ቄኤሶንታ ሌዊ ዓሶንታ ቢያ ዔያቶና ዎላ ማዼኔ። ሌዓ ላማታሚና ዬካፓ ዑሣ ማዔ ሌዊ ዓሳ ቢያ ጌኤዦ ማኣሮ ሹጮና ማዦ ማዾኮ ሱኡጌ ማዒ ጌሢንቴኔ። <verse eid="EZR 3:8"/><verse number="9" style="v" sid="EZR 3:9"/>ዒማና ሌዊ ዓሢ ዒያሱንታ ዒዛኮ ዓቲንቆ ናኣቶንታ፤ ዬያጉዲ ሃሣ ዒዛኮ ዒጊኖ ማዔ ቃድሚዔኤሌና ሆዳውያና ማኣሮ ዓሶ ዛላፓ ማዔ ዓቲንቆ ናኣታ ቢያ ፔቱሞና ጌኤዦ ማኣሮ ጊንሣ ማዢሶኮ ሱኡጌ ማዔኔ፤ ሄናዳዴ ዜርፆ ማዔ ሌዊ ዓሳኣ ዔያቶ ዒማና ማኣዳኔ።<verse eid="EZR 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 3:10"/>ሹጮና ማኣሮ ማዣ ዓሳ ጌኤዦ ማኣሮ ማዢፆ ዓርቃኣና ቄኤሳ ፔኤኮ ማዾ ማኣዓሢ ማይንቲ፥ ሃሣ ኩጮይዳ ዛዬ ዔኬም ዓሳኣፔ ማኣሮ ዓሶ ማዔ ሌዊ ዓሳ ዑኡቱቡሎ ዓርቂ ዎሊ ቤቂ ዔቄኔ፤ ዔያታ ካኣቲ ዳውቴ ዎዳፓ ማዺንቲ ማዺንቲ ሙኬ ዳምቦ ጎይፆ ዓይኑሞና ሂዚ ጌዒ ናንጊና ናንጋ ጎዳ ጋላቴኔ፦ <note caller="-" style="x"><char style="xo" closed="false">3፡10 </char><char style="xt" closed="false"><ref loc="1CH 25:1">1ፆኦሲ. ዓሃኬ 25፡1</ref>።</char></note><verse eid="EZR 3:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="EZR 3:11"/>«ናንጊና ናንጋ ጎዳ ኮሺኬ፤</para>
  <para style="q2" vid="EZR 3:11">ዒስራዔኤሌ ዓሶ ዒ ናሽካ ናሹማ ናንጊና ናንጋያኬ።»</para>
  <para style="m" vid="EZR 3:11">ዬያ ዎሊ ዓኣሢ ዓኣሢ ዔያታ ፆኦሲ ቦንቾም ዓይናዼኔ፤ ጌኤዦ ማኣሮ ሹጮና ማዢፃ ዓርቂንቴሢሮ ፔቴ ፔቴ ዓሳ ዑኡዞ ዼጊዲ ዒላሺ ዒላሺሢና ናንጊና ናንጋ ጎዳ ጋላታኔ። <note caller="-" style="x"><char style="xo" closed="false">3፡11 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1ፆኦሲ. ዓሃኬ 16፡34</ref>፤ <ref loc="2CH 5:13">2ፆኦሲ. ዓሃኬ 5፡13</ref>፤ <ref loc="PSA 100:5">ዓይኑ. 100፡5</ref>፤ <ref loc="PSA 106:1">106፡1</ref>፤ <ref loc="PSA 118:1">118፡1</ref>፤ <ref loc="PSA 136:1">136፡1</ref>፤ <ref loc="JER 33:11">ዔር. 33፡11</ref>።</char></note> <verse eid="EZR 3:11"/><verse number="12" style="v" sid="EZR 3:12"/>ጋርቾ ቄኤሶና ሌዊ ዓሶናፓ ሚርጌሢ፤ ዬያጉዲ ሃሣ ቶኦኮ ቶኦኮኮ ሱኡጋ ቤርታኣ ጌኤዦ ማኣሮኮ ማዢንቶ ፔ ዓኣፖና ዛጌሢሮ ሃሢ ማዢንታ ጌኤዦ ማኣሮኮ ማዢፃ ዓርቂንታሢ ዛጋዖ ዑኡዞ ፔኤኮ ዼጊዲ ዬኤኬኔ፤ ዒማና ዒኢካ ዓኣ ዛሎ ዓሳ ጋዓንቴ ዒላሺሢ ዓርቄኔ። <verse eid="EZR 3:12"/><verse number="13" style="v" sid="EZR 3:13"/>ዔያታ ዒላታ ዼጌ ዑኡዛ ሃኬ ዋይዚንታሢሮ ዎዞ ዒላሺፆና ዬኤፖ ዑኡዞና ዖኦኒያ ዱማሲ ዔራኒ ዳንዳዒባኣሴ።<verse eid="EZR 3:13"/></para>
  <chapter eid="EZR 3"/>
  <chapter number="4" style="c" sid="EZR 4"/>
  <para style="s1">ጌኤዦ ማኣራ ጊንሣ ማዢንቱዋጉዲ ዒፂ ማዾና ማዾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 4:1"/>ዪሁዳና ቢኢኒያሜና ዴሮኮ ሞርካ ዲዒንቶፓ ማዔ ዓሳ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢም ጌኤሺ ማኣሪ ማዣሢ ዋይዜኔ። <verse eid="EZR 4:1"/><verse number="2" style="v" sid="EZR 4:2"/>ዬያሮ ዔያታ ዜሬባቡሌና ቶኦኮ ቶኦኮኮ ሱኡጎ ኮይላ ሙካዖ፦ «ጌኤዦ ማኣሮ ኑ ዎላ ማዦም፤ ሃያ ዒንሢ ካኣሽካ ፆኦዛሢ ኑዋ ካኣሽካኔ፤ ዓሶኦሬ ካኣቲ፥ ዓስራዶኔ ሃንጋ ዓጮ ባንሢ ኑና ዳኬሢዳፓ ዓርቃዖ ዒዛም ዒንጎ ባኮ ኑ ዒንጊ ዒንጊኬ» ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡2 </char><char style="xt" closed="false"><ref loc="2KI 17:24-41">2ካኣቶ. ማ 17፡24-41</ref>።</char></note><verse eid="EZR 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 4:3"/>ጋዓንቴ ዒማና ዜሬባቡሌንታ ዒያሱንታ ቶኦኮ ቶኦኮኮ ሱኡጋኣ ቢያ ዬንሢ ዓሶም፦ «ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢም ኑ ማዣ ጌኤዦ ማኣሮ ማዾ ዒንሢ ኑና ማኣዳንዳያ ኮይሱዋሴ፤ ዬያ ፓርሴ ካኣቲ፥ ቂኢሮሴ ኑና ዓይሤ ጎይፆና ኑ ኑኡሮ ማዣንዳኔ» ጌይ ማሄኔ።<verse eid="EZR 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 4:4"/>ዬካፓ ዬኖ ዓጮይዳ ናንጋ ዴራ ዓይሁዶ ዓሶ ዒጊቺሢና ሃሣ ካራ ባይዚሢና ጌኤዦ ማኣሮ ማዢፆ ማዾ ላኣጋኒ ዔቄኔ። <verse eid="EZR 4:4"/><verse number="5" style="v" sid="EZR 4:5"/>ዔያታ ዎዎዴይ ጌዔቴ፦ ፓርሴ ካኣቲኮ ቢታንታ ዓኣ ዓሶም ዴሚና ዒንጎ ሚኢሼ ዒንጊሢና ማኣሮ ማዡዋጉዲ ላኣጋኒ ማሌኔ፤ ዬያ ዔያታ ካኣቲ ቂኢሮሴ ዎዳፓ ዴንዲ ካኣቲ ዳኣሪዮሴ ዎዶ ሄላንዳኣና ማዺፆ ሃሺባኣሴ።<verse eid="EZR 4:5"/></para>
  <para style="s1">ዬሩሳላሜ ጊንሣ ማዢንቱዋጉዲ ዒፂ ማዾና ማዾ</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 4:6"/>ዬያ ሌሊቱዋንቴ ዔያታ ካኣቲ ፄሬኪሲሴ ካኣታዼ ቤርታሳ ሌዖይዳ ዪሁዳና ዬሩሳላሜናይዳ ናንጋ ዲዒንታፓ ማዔ ዓሳ ዎጌና ዓርቂንታንዳጉዲ ሃይሶ ፃኣፒ ካኣቲም ሺኢሼኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡6 </char><char style="xt" closed="false"><ref loc="EST 1:1">ዓስቲ. 1፡1</ref>።</char></note><verse eid="EZR 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 4:7"/>ዓርፄክሲሴ ፓሪሴ ዓጮ ካኣቲ ማዒ ዓኣ ዎዶና ቢሽላሜ፥ ሚትሬዳቴ፥ ፃብዔኤሌንታ ሜሌ ዔያቶና ዎላ ዓኣ ዓሳ ዎጌና ዔያታ ዓርቂንታንዳጉዲ ጋዓ ዋርቃታ ፃኣፒ ካኣቲም ሺኢሼኔ፤ ዬይ ዋርቃታ ፃኣፒንቴሢ ሶኦሪያ ዓጪ ፒዳኣሌና ሙኡቺና ማዔሢሮ ናባቢንቲ ቡሊ ኬኤዚንታንዳጉዲ ዳኪንቴያኬ።<verse eid="EZR 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 4:8"/>ዬያጉዲ ሃሣ ዓጮ ዎይሣ ሬሁሜና ፃኣፓሢ ሺምሻዬና ዬሩሳላሜ ዛሎ ሃካፓ ዴማ ዓኣ ማሊፆ ካኣቲም ፃኣፔኔ፤<verse eid="EZR 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 4:9"/>ዓጮ ዎይሣ ሬሁሜና ፃኣፓሢ ሺምሻዬ፤ ሃሣ ዔያቶና ዎላ ዎጎ ዎጋ ዓሶንታ ቲሪፖሊሴይዳ፥ ፓሪሴይዳ፥ ዔሬኬይዳ፥ ባብሎኔና ሱሳናይዳ ናንጋ ቢታንታ ዓኣ ሃንጎ ዓሳኣ ቢያ፤ <verse eid="EZR 4:9"/><verse number="10" style="v" sid="EZR 4:10"/>ዎልቆና ዼኤፖ ካኣታሢ ዓሴናፔሬ ሾይንቴ ዓጫፓ ሳማሪያ ካታሞና ዔፕራፂሴኮ ዓባ ጌላ ዛሎ ዳኪ ዱማ ዱማ ቤዛ ናንጋንዳጉዲ ዒ ማሄ ሃንጎ ዴሮና ዎላ ዒ ፃኣፔያ ማዓዛ፥<verse eid="EZR 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 4:11"/>ፃኣፒንቴ ዋርቃቴሎኮ ዼኤፖ ማሊፃ ሂዚ ጋዓያኬ፦ ዔፕራፂሴኮ ዓባ ጌላ ዛሎና ናንጋ ኔኤኮ ማዻዞንሢፓ ካኣቲ ዓርፄክሲሴም ዳኪንቴያ፥<verse eid="EZR 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 4:12"/>«ዼኤፖ ቦንቺንታሢዮ! ኔ ኮይላፓ ሙኬ ዓይሁዶ ዓሳ ዬሩሳላሜይዳ ዴዒ ዬኖ ዋይዞ ዒፃ ፑርቶ ካታሜሎ ጊንሣ ኮሺ ማዢሢዳኬ፤ ዲሮዋ ዓካሲ፥ ጌኤዦ ማኣሮዋ ማዢፆ ዓርቄኔ። <verse eid="EZR 4:12"/><verse number="13" style="v" sid="EZR 4:13"/>ዬያሮ ካኣቲዮ! ዬና ካታሜላ ጊንሣ ማዢንቲ ዲሮ ማዻኣ ጊኢጊ ጋፔያታቶ ዴራ ጊኢሮ ኔኤም ጪጊፆ ሃሻንዳኔ፤ ሃሣ ኔኤም ዒንጊንታ ካኣቱሞ ማኣሪ ጌላ ባካኣ ፓጫንዳሢ ዔሬ! <verse eid="EZR 4:13"/><verse number="14" style="v" sid="EZR 4:14"/>ኑኡኒ ካኣቲ ማኣራፓ ዴንቃ ባኣዚ ዓኣያታሢሮ ኔኤኒ ቶኦቺንቴም ዚቲ ጌይ ዛጊፃ ኑም ኮሽኩዋኣያ ማዔም ሃያ ኪኢቶ ኑ ኔኤም ዳኬኔ፤ <verse eid="EZR 4:14"/><verse number="15" style="v" sid="EZR 4:15"/>ኔኤኮ ቤርታኣ ዓዶንሢ ሃይሶይዳ ፃኣፒንቲ ዓኣ ባካ ዛጊንታንዳጉዲ ኔ ዓይሣንዳጉዲ ኑ ኔኤም ኬኤዛኔ፤ ዬይ ዛጊንታ ዎዶና ዬና ካታሜላ ቢያ ዎዴ ዋይዚ ዒፃያ፥ ሃሣ ሚናኣፓ ዓርቃዖ ካኣቶና ዱማ ዱማ ዓጮ ዎይሣ ዓሶ ዎማይዲ ዔያታ ሜታሳቴያ ማርካ ማዓ ባኣዚ ዬና ዛጋ ዓሳ ዴንቃንዳኔ፤ ሚናፓ ዒዞይዳ ዓኣ ዴራ ዋይዙዋኣያኬ፤ ሃያኮ ቤርታ ካታሜላ ዶዒ ባይቃንዳጉዲ ማዺንቴሢ ዬያሮኬ። <verse eid="EZR 4:15"/><verse number="16" style="v" sid="EZR 4:16"/>ዬና ካታሜላ ጊንሣ ላሚ ማዢንቲ፥ ዲሮ ኮሺፃኣ ዒዞኮ ጋፔስካፓ ካኣቲዮ! ዔፕራፂሴኮ ዓባ ኬስካ ባንፆና ዓኣ ዓጮይዳ ቤሲ ኔኤኮ ባኣያ ማዓንዳሢ ኑ ኔኤም ኬኤዛኔ» ጋዓያኬ።<verse eid="EZR 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 4:17"/>ዬኖኮ ካኣቲ ማሃዖ፦ «ዓጮ ዎይሣ ሬሁሜም፥ ፃኣፓሢ ሺምሻዬም፤ ዬያጉዲ ሃሣ ሳማሪያና ዔፕራፂሴ ዎሮኮ ዓባ ጌላ ባንፆይዳ ዓኣ ዴሮናም ቢያ፥ ዒንሢ ኮሺዳ?<verse eid="EZR 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZR 4:18"/>«ዒንሢ ታኣም ፃኣፒ ዳኬ ዋርቃታ ናባቢንቲ ቡሊንቴም ታ ዋይዜኔ፤ <verse eid="EZR 4:18"/><verse number="19" style="v" sid="EZR 4:19"/>ዬኖ ማሊፆና ዒንሢ ጌዔ ጎይፆ ዔባ ዛጊንታንዳጉዲ ታ ዓይሤኔ፤ ዬያሮ ዛጋ ዓሳ ዒማና ዴንቄ ጎይፆና ዬሩሳላሜ ሚናፓ ዓርቃዖ ካኣቶም ዋይዚ ዒፂ ናንጋያ፥ ሜታሳ ዓሲ ኩሜ ካታማታሢ ዔርቴኔ፤ <verse eid="EZR 4:19"/><verse number="20" style="v" sid="EZR 4:20"/>ያዺ ማዔያታቴያ ዬሩሳላሜይዳ ዔፕራፂሴኮ ዓባ ኬስካ ባንፆና ዓኣ ዓጮ ቢያ ጊኢራ ጊኢሪሻያ፤ ሃሣ ኮርሞ ኮርማ ዓሶፓ ሚኢሼ ጪጊሻ ዔርቴ ካኣታ ዒኢካ ካኣታዼኔ። <verse eid="EZR 4:20"/><verse number="21" style="v" sid="EZR 4:21"/>ዬያሮ ታ ላሚ ሃሣ ሜሌ ኪኢታ ዒንሢም ዳካንዳያ ሄላንዳኣና ዬና ዓሳ ካታሜሎ ጊንሣ ማዢፆ ሃሾንጎ ጎዑዋቴ፤ <verse eid="EZR 4:21"/><verse number="22" style="v" sid="EZR 4:22"/>ኑኡኮ ካኣቱሞይዳ ዓይጎ ሜታኣ ሄሉዋጉዲ ዬኖ ዛሎ ዒንሢና ዔሩዋቴ!» ጌይ ዳኬኔ።<verse eid="EZR 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 4:23"/>ዬካፓ ካኣቲ፥ ዓርፄክሲሴ ማሂ ዳኬ ዋርቃታ ሙኪ ሬሁሜም፥ ሺምሻዬና ዔያቶና ዎላ ዓኣ ዓሶም ቢያ ናባቢንቴስካፓ ዔያታ ኔጉዋዖ ዬሩሳላሜ ሙኪ ዓይሁዳ ዬሩሳላሜ ጊንሣ ማዢፆ ሃሻንዳጉዲ ላኣጌኔ፤ <verse eid="EZR 4:23"/><verse number="24" style="v" sid="EZR 4:24"/>ዬያሮ ዳኣሪዮሴ ፓሪሴይዳ ካኣታዼ ላምዓሳ ሌዖ ሄላንዳኣና ጌኤዦ ማኣሮ ማዻ ላኣጊንቴሢሮ ማዻ ዓርቂንቴ ቤዛ ዔቂ ዓቴኔ።<verse eid="EZR 4:24"/></para>
  <chapter eid="EZR 4"/>
  <chapter number="5" style="c" sid="EZR 5"/>
  <para style="s1">ጌኤዦ ማኣሮ ማዦ ጊንሣ ዓርቆናሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 5:1"/>ዒማና ፆኦሲ ማሊፆ ኬኤዛ ላምዖንሢ ሃጌንታ ዒዶ ናኣዚ ዛካሪያሴንታ ዬሩሳላሜና ዪሁዳ ዓጮናይዳ ናንጋ ዓይሁዶ ዓሶም ዒስራዔኤሌ ፆኦሲ ሱንፆና ፆኦሲ ማሊሢ ኬኤዜኔ። <note caller="-" style="x"><char style="xo" closed="false">5፡1 </char><char style="xt" closed="false"><ref loc="HAG 1:1">ሃኣጌ 1፡1</ref>፤ <ref loc="ZEC 1:1">ዛካ. 1፡1</ref>።</char></note> <verse eid="EZR 5:1"/><verse number="2" style="v" sid="EZR 5:2"/>ሳላቲያሌ ናኣዚ ዜሬባቡሌና ዒዮፄዴቄ ናኣዚ ዒያሱና ዬንሢ ፆኦሲ ማሊፆ ኬኤዛዞንሢኮ ሃይሶ ዋይዛዖ ዬሩሳላሜይዳ ጌኤዦ ማኣሮ ማዢፆ ጊንሣ ዓርቄኔ፤ ዬንሢ ላምዖ ፆኦሲ ማሊፆ ኬኤዛዞንሢያ ዔያቶ ማኣዴኔ። <note caller="-" style="x"><char style="xo" closed="false">5፡2 </char><char style="xt" closed="false"><ref loc="HAG 1:12">ሃኣጌ 1፡12</ref>፤ <ref loc="ZEC 4:6-9">ዛካ. 4፡6-9</ref>።</char></note><verse eid="EZR 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 5:3"/>ዔፕራፂሴኮ ዓባ ኬስካ ባንፆ ዓጮ ዎይሣያ ማዔ ታቴናዬና ሺታርቦዝናዬና፤ ዬያጉዲ ሃሣ ዔያቶና ዎላ ቢታንታ ዓኣ ዓሳኣ ዬሩሳላሜ ሙካዖ፦ «ሃያ ጌኤዦ ማኣሮ ማዦም፥ ሃሣ ዲሮዋ ዓካሲ ኮሾም ዖኦኒ ዒንሢ ዓይሤይ?» ጌይ ዖኦጬኔ። <verse eid="EZR 5:3"/><verse number="4" style="v" sid="EZR 5:4"/>ጌኤዦ ማኣሮ ማዣኒ ዔያቶና ዎላ ዔቄ ዓሶኮዋ ሱንፆ ዔራኒ ዔያቶ ዖኦጬኔ። <verse eid="EZR 5:4"/><verse number="5" style="v" sid="EZR 5:5"/>ጋዓንቴ ዓይሁዶ ዓሶኮ ሱኡጎ ፆኦሲ ካፓያታሢሮ ዬያታ ፓርሴ ዓጮኮ ቢታንታ ዓኣ ዓሳ ዳኣሪዮሴም ዒ ዎዚ ጋዓቴያ ዋይዛኒ ኪኢታ ፃኣፒ ዳካዖ ማዾ ማዺፆ ዓሶ ላኣጊባኣሴ። <verse eid="EZR 5:5"/><verse number="6" style="v" sid="EZR 5:6"/>ዒማና ዔፕራፂሴኮ ዓባ ጌላ ዛሎ ዓጮ ዎይሣ ታቴናዬና ሺታርቦዝናዬና፤ ዬያጉዲ ዔያቶና ዎላ ዓኣ ዓሳ ካኣቲም ሂዚ ጋዓ ኪኢታ ፃኣፒ ዳኬኔ፦<verse eid="EZR 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 5:7"/>«ዼኤፖ ቦንቺንታ ካኣታሦ ዳኣሪዮሴ! ኔ ዓጮም ኮሹሞ ማዖንጎ፤<verse eid="EZR 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 5:8"/>«ካኣቲዮ! ኑኡኒ ዪሁዳ ዓጮ ዴንዴንቴ ዒኢካ ዼኤፖ ፆኦዛሢኮ ጌኤዦ ማኣራ ሹቺና ዓርሲንቴ ሚሢና ጊንሣ ማዢንታንቴ ኑ ዛጌያታሢ ኔና፥ ዼኤፖ ቦንቺንታሢም ዔርቴያ ማዖንጎ፤ ዬይ ማዻ ዔያቶኮ ጋርቻ ዛጊ ዓርቂ ማዺሻሢሮ ሩኡሪና ማዺንታኔ።<verse eid="EZR 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 5:9"/>«ኑኡኒ ዒማና ዴሮኮ ሱኡጎ ኮራ፦ ‹ሃያ ጌኤዦ ማኣሮ ጊንሣ ዒንሢ ማሂ ማዣንዳጉዲና ዲሮዋ ዓካሳንዳጉዲ ዖ ዒንሢ ዓይሤይ?› ጌይ ዖኦጬኔ፤ <verse eid="EZR 5:9"/><verse number="10" style="v" sid="EZR 5:10"/>ዬያ ሌሊቱዋንቴ ዬያ ማዾ ማዺሻ ሱኡጋ ዖናንሢታቴያ ሱንፆ ዔያቶኮ ኔኤም ኬኤዛኒ ኑ ዔያቶ ዖኦጬኔ።<verse eid="EZR 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 5:11"/>«ዔያታ ኑም ዒማና፦ ‹ኑኡኒ ጫሪንጮና ሳዖና ማዤ፥ ዼኤፖ ፆኦዛሢኮ ማዻዞንሢኬ፤ ዬያሮ ዒዛም ሚርጌ ዎዴኮ ቤርታ ፔቴ ዼኤፒ፥ ዒስራዔኤሌ ዓሶኮ ካኣቲስኬይ ማዤ ጌኤዦ ማኣሮና ዲሮና ጊንሣ ኑ ማዣኔ፤ <verse eid="EZR 5:11"/><verse number="12" style="v" sid="EZR 5:12"/>ጋዓንቴ ኑኡኮ ቤርታኣ ዓዶንሢ ዬያ ጫሪንጮ ፆኦዛሢ ዻጋሴሢሮ ካላዳ ዓጮ ካኣቶ ዜርፃፓ ባብሎኔ ካኣቲ ናብካዳናፆኦሬ ዖሎና ዔያቶ ባሻንዳጉዲ ማሄኔ፤ ዒማና ጌኤዦ ማኣራ ሻሂንቴኔ፤ ዴራኣ ዲዒንቲ ባብሎኔ ዓጮ ዓኣዼኔ። <note caller="-" style="x"><char style="xo" closed="false">5፡12 </char><char style="xt" closed="false"><ref loc="2KI 25:8-12">2ካኣቶ. ማ 25፡8-12</ref>፤ <ref loc="2CH 36:17-20">2ፆኦሲ. ዓሃኬ 36፡17-20</ref>፤ <ref loc="JER 52:12-15">ዔር. 52፡12-15</ref>።</char></note> <verse eid="EZR 5:12"/><verse number="13" style="v" sid="EZR 5:13"/>ዬካፓ ቂኢሮሴ ባብሎኔይዳ ካኣታዼ ቤርታሳ ሌዖና ዬያ ጌኤዦ ማኣሮ ጊንሣ ኑ ማዣንዳጉዲ ኑና ዓይሤሢ ፔኤሮ ካኣቲ ቂኢሮሴኬ። <note caller="-" style="x"><char style="xo" closed="false">5፡13 </char><char style="xt" closed="false"><ref loc="EZR 1:2-11">ዒዝ. 1፡2-11</ref>።</char></note> <verse eid="EZR 5:13"/><verse number="14" style="v" sid="EZR 5:14"/>ናብካዳናፆኦሬ ሃይካ ዬሩሳላሜይዳ ማዢንቴ ቤርታኣ ጌኤዦ ማኣራፓ ዲዒ ዔኬ ባኮና ባብሎኔይዳ ዔያቶኮ ፆኦዞ ካኣሽኮ ቤዞይዳ ጌሤ ዎርቆና ኮሺንቴ ጌኤዦ ማኣሮ ሜሆ ቢያ ቂኢሮሴ ማሂ ኑም ዒንጌኔ፤ ዬይ ጌኤዦ ማኣሮ ሜሃ ኑም ማሂ ዒንጊንቴሢ ዪሁዳ ዓጮ ዎይሣንዳጉዲ ማሂ ዶኦሮና ሼሽባፃሬ ጌይንታ ዓሢ ዛሎናኬ። <verse eid="EZR 5:14"/><verse number="15" style="v" sid="EZR 5:15"/>ዬይ ዓጮ ዎይሣ ሼሽባፃሬ ዬንሢ፥ ጌኤዦ ማኣሮ ሜሆ ጊንሣ ማሂ ዔኪ ሙኪ ዬሩሳላሜይዳ ዓኣ ጌኤዦ ማኣሮይዳ ጌሣንዳጉዲ፤ ዬያጉዲ ሃሣ ጌኤዦ ማኣሮዋ ቤርታ ዓኣ ቤዛ ማዢሳንዳጉዲ ካኣቲ ቂኢሮሴ ዓይሤኔ። <verse eid="EZR 5:15"/><verse number="16" style="v" sid="EZR 5:16"/>ዬያሮ ሼሽባፃሬ ሙኪ ማኣሮ ማዢሶ ዓይሤኔ፤ ዬካፓ ሹጮና ማዦ ማኣራ ማዢንቶ ዓርቄም ሃኖ ሄላንዳኣና ማኣራ ማዢንቲሢዳኬ፤ ጋዓንቴ ጌኤዦ ማኣሮ ሹጮና ማዦሢ ሃጊ ጋፒባኣሴ› ሂዚ ጌይ ኬኤዜኔ።<verse eid="EZR 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 5:17"/>«ካኣቲዮ! ጎኔና ዬይ ጌኤዦ ማኣራ ዬሩሳላሜይዳ ማዢንታዳጉዲ ካኣቲ ቂኢሮሴ ዓይሤቴያ ዓይሢባኣቴያ ዔራኒ ባብሎኔይዳ ካኣቱሞ ማኣራ ፃኣፒ ጌሦና ማርካ ማዓ ባኣዚ ዓኣቶ ዛጊሲ፥ ሃያ ባኮ ኔ ዎዚ ጋዓቴያ ኑም ኔ ኬኤዛንዳጉዲ ኑ ኔና ሺኢቃኔ።»<verse eid="EZR 5:17"/></para>
  <chapter eid="EZR 5"/>
  <chapter number="6" style="c" sid="EZR 6"/>
  <para style="s1">ቂኢሮሴ ዓይሤ ዓይሢፆ ኮዒ ዴንቆናሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 6:1"/>ባብሎኔይዳ ካኣቱሞ ማኣራ ዓኣ ፃኣፒ ጌሦና ባካ ቢያ ኮይ ዛጊንታንዳጉዲ ካኣቲ ዳኣሪዮሴ ዓይሤኔ፤ <verse eid="EZR 6:1"/><verse number="2" style="v" sid="EZR 6:2"/>ጋዓንቴ ዬይ ባካ ባብሎኔይዳቱዋንቴ ዒዞ ዓጮኮ ሜዶኔይዳ «ዓህሚታ» ጌይንታ ካታማይዳ ፔቴ ቢራና ጌይንታያ ማሪንቴ ባኣዚዳ ጴዼኔ፤ ዬኖ ጋራ ፃኣፒንቴ ባካ፦<verse eid="EZR 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 6:3"/>«ቂኢሮሴ ካኣታዼ ቤርታሳ ሌዖና ዬሩሳላሜይዳ ዓኣ ጌኤዦ ማኣሮይዳ ፆኦሲም ሚቺ ዒንጎ ዒንጊፆንታ ሜሌ ዱማ ዱማ ዒንጊፃ ዒንጊንታንዳጉዲ ጌኤዦ ማኣራ ጊንሣ ማዢንታንዳጉዲ ዓይሤኔ፤ ዬያ ጌኤዦ ማኣሮኮ ዖዶሱማ ላሂታሚ ዋዻ፥ ጋሮ ዳልጉማኣ ላሂታሚ ዋዻ ማዓንዳያ ኮይሳኔ። <verse eid="EZR 6:3"/><verse number="4" style="v" sid="EZR 6:4"/>ዲራ ሃይሦ ሺርሺ ሹቻ ኬልቂ ዲርቆናያ ዬያ ኬኤሎ ዲፆኮ ቶኦካ ፔቴ ሺርሺ ጫርጊ ዲርቆና ሚሢ ዲርሲ ዓኣያ ማዖንጎ፤ ዬያ ማዾም ቢያ ኮይሳ ሚኢሻ ካኣቱሞ ማኣራ ሚኢሾ ጌሦ ኬኤፃፓ ዒንጊንቶንጎ። <verse eid="EZR 6:4"/><verse number="5" style="v" sid="EZR 6:5"/>ዬያጉዲ ሃሣ ሃያኮ ቤርታ ካኣቲ ናብካዳናፆኦሬ ዬሩሳላሜይዳ ዓኣ ጌኤዦ ማኣራፓ ዲዒ ኬሴ ዎርቆና ቢሮ ዓንጎናይዳፓ ኮሺንቴ፥ ጌኤዦ ማኣሮይዳ ማዺንቶ ሜሃ ጊንሣ ማዒ ዬሩሳላሜይዳ ማዢንታ ጌኤዦ ማኣሮይዳ ኮይሳ ቤዛ ጌሢንቶንጎ» ጋዓያኬ።<verse eid="EZR 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 6:6"/>ዬያሮ ዳኣሪዮሴ ሃካፓ ዴማ ዓኣ ኪኢቶ፦ «ዔፕራፂሴኮ ዓባ ኬስካ ባንፆና ዓኣ ዓጮ ዎይሣ ታቴናዬና ሼታርቦዝናዬናም፥ ዔፕራፂሴኮ ዓባ ጌላ ባንፆይዳ ዒንሢና ዎላ ዓኣዞንሢም ቢያ፤ ጌኤዦ ማኣሮ ባንሢ ዑኪፖቴ፥ <verse eid="EZR 6:6"/><verse number="7" style="v" sid="EZR 6:7"/>ማዻ ማዺንቱዋጉዲ ዹቂፆዋ ሃሹዋቴ፥ ዪሁዳ ዓጮ ዎይሣሢና ዓይሁዶ ዓሶኮ ሱኡጎና ፆኦሲኮ ጌኤዦ ማኣሮ ሚና ቤርታ ዓኣ ቤዞይዳ ጊንሣ ማዦንጎ። <verse eid="EZR 6:7"/><verse number="8" style="v" sid="EZR 6:8"/>ሃይማና ጌኤዦ ማኣሮ ማዾ ኮሺ ዒንሢ ዔያቶ ማኣዳንዳጉዲ ታ ዒንሢ ዓይሣኔ። ዬያሮ ዬያ ማዾ ማዺሾንዶ ሚኢሾ ቢያ ዔፕራፂሴኮ ዓባ ኬስካ ባንፆና ዓኣ ዓጫፓ ካኣቲኮ ጊኢሮ ማዒ ቡኩሶና ሚኢሾፓ ዑኬና ኬሲንቲ ዔያቶም ዒንጊንቶጎ፤ ማዻ ዹቂንቲ ዔቃንዳያ ኮይሱዋሴ። <verse eid="EZR 6:8"/><verse number="9" style="v" sid="EZR 6:9"/>ቃሲ ሃሣ ዬሩሳላሜይዳ ዓኣ ቄኤሳ ዒንሢም ኬኤዛ ጎይፆ ኬላ ኬላ ጫሪንጫ ናንጋ ፆኦዛሢም ዔያታ ዒንጋ ዒንጊፆም ኮዓ ዚዮ ጌማታ፥ ማራቶ ዓዳ፥ ማራናኣቶ ዓዳ፤ ዬያጉዲ ሃሣ ዒንጊፆማ ማዓ ዛርጋሢ፥ ሶኦጋ፥ ዎይኖ ዑዦንታ ሪሚታፓ ኮሾ ዛይቶዋ ቢያ ዔያቶም ዒንጉዋቴ። <verse eid="EZR 6:9"/><verse number="10" style="v" sid="EZR 6:10"/>ዬይ ቢያ ያዺ ማዺንታኒ ኮይሳሢ ጫሪንጮ ፆኦዛሢ ዎዛና ዔካ ዒንጊፆ ቢያ ሺኢሺሢና ታኣና ታ ናኣቶና ሼምፓሢም ዔያታ ሺኢቃንዳጉዲኬ፤ <verse eid="EZR 6:10"/><verse number="11" style="v" sid="EZR 6:11"/>ዬያ ሌሊቱዋንቴ ሜሌ ታ ዔርዛኒ ኮዓ ባኣዚ ዓይጎዳይ ጌዔቴ፦ ሃያ ታ ዓይሢፆ ዔኩዋኣያና ዋይዙዋይ ዓይጎ ዓሲታቶዋ ዒዛኮ ማኣሮ ቱርቱራፓ ፔቴ ቱጊንቲ ዓርሲ ዓጪሴስካፓ ጫርጊ ዒዛ ሱፆንጎ፤ ዬካፓ ማኣራ ዒዛኮ ሻሂንቲ ቡኡራ ላኣሎ ቤሲ ማዖንጎ። <verse eid="EZR 6:11"/><verse number="12" style="v" sid="EZR 6:12"/>ሃያ ዓይሢፆ ዋይዞ ዒፂ ዬሩሳላሜይዳ ዓኣ ፆኦሲኮ ጌኤዦ ማኣሮ ሻሃኒ ማላ ዓይጎ ካኣቲ ማዔቴያ ዴሬ ዒዛኮ ሱንፃ ዔኤሊንታ ቤሲ ማዓንዳጉዲ ዶኦሬ ፆኦዛሢ ዬያ ባይዞንጎ፤ ሃያ ኪኢቶ ዓይሢፆ ዳኬሢ ታና፥ ዳኣሪዮሴ ማዔሢሮ ጉቤ ባካ ማዺንቲ ኩማንዳያ ኮይሳኔ» ጌይ ዳኬኔ።<verse eid="EZR 6:12"/></para>
  <para style="s1">ጌኤዦ ማኣራ ማዢንቲ ጋፔሢሮ ቦንቾና ቦንቾ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 6:13"/>ዬካፓ ዓጮ ዎይሣ ታቴናዬንታ ሼታርቦዝናዬንታ ዔያቶና ዎላ ቢታንታ ዓኣ ዓሳ ካኣቲ ዔያቶ ዓይሤ ጎይፆና ቢያ ባኮ ማዺ ኩንሤኔ። <verse eid="EZR 6:13"/><verse number="14" style="v" sid="EZR 6:14"/>ዓይሁዶ ዓሶኮ ሱኡጎንታ ፆኦሲ ማሊፆ ኬኤዛ ሃጌና ዛካሪያሴና ዔያቶ ዶዲሺ ዶዲሺ ጌኤዦ ማኣሮ ማዾ ዑካሴኔ፤ ዒስራዔኤሌ ፆኦዛሢ ማሊፆጉዲ ፓርሴ ካኣታ ቂኢሮሴንታ ዳኣሪዮሴንታ ዓርፄክሲሴንታ ዓይሤ ጎይፆ ጌኤዦ ማኣሮ ማዾ ማዺ ጋፒሴኔ፤ <note caller="-" style="x"><char style="xo" closed="false">6፡14 </char><char style="xt" closed="false"><ref loc="HAG 1:1">ሃኣጌ 1፡1</ref>፤ <ref loc="ZEC 1:1">ዛካ. 1፡1</ref>።</char></note> <verse eid="EZR 6:14"/><verse number="15" style="v" sid="EZR 6:15"/>ዬያ ጌኤዦ ማኣሮ ዔያታ ማዢ ጋፒሴሢ ዳኣሪዮሴ ካኣታዼንቴ ላሃሳ ሌዖኮ ዓዳሬ ጌይንታ ዓጊና ፄኤሬም ሃይሣሳ ኬሎናኬ። <verse eid="EZR 6:15"/><verse number="16" style="v" sid="EZR 6:16"/>ዬካፓ ዒስራዔኤሌ ዴራ፥ ቄኤሶንታ ሌዊ ዓሶንታ፤ ዬያጉዲ ዲዒንቶፓ ማዔ ሃንጎ ዓሳ ቢያ ጌኤዦ ማኣራ ማዢንቲ ጋፔሢሮ ቦንቾ ኬሊ ዎዛና ቦንቼኔ። <verse eid="EZR 6:16"/><verse number="17" style="v" sid="EZR 6:17"/>ዔያታ ዒማና ቢያ ዬያ ቦንቾ ኬሎም ማዓያ ፔቴ ፄኤታ ዚያ ጌማይ፥ ላምዖ ፄኤታ ዓዴ ማራይ፥ ዖይዶ ፄኤታ ማራናይ ዓዴ ዒንጎ ዒንጊሢ ማሂ ሺኢሼኔ፤ ሃሣ ጎሜ ጌኤሺሢ ዛላ ዒንጎ ዒንጊሢ ማዓ ታጶ ላምዖ ኮላይ ፔቴ ፔቴ ዒስራዔኤሌ ዓሶኮ ፃጶ ሱንፆና ሺኢሼኔ። <verse eid="EZR 6:17"/><verse number="18" style="v" sid="EZR 6:18"/>ዬካፓ ሙሴኮ ዓሶ ዎይሦ ዎጋ ፃኣፒንቴ ጎይፆ ዬሩሳላሜይዳ ማዢንቴ ጌኤዦ ማኣሮ ማዾም ቄኤሶና ሌዊ ዓሶና ዔያታ ፔ ቤዛ ቤዛ ማሂ ጊኢጊሼኔ።<verse eid="EZR 6:18"/></para>
  <para style="s1">ዑሣ ዓኣዺፆ ቦንቾ ኬሎ</para>
  <para style="p">
    <verse number="19" style="v" sid="EZR 6:19"/>ዲዒንታፓ ማዔ ዓሳ ቤርታሳ ዓጊኖኮ ታጶ ዖይዳሳ ኬሎና ዑሣ ዓኣዺፆ ቦንቾ ቦንቼኔ። <note caller="-" style="x"><char style="xo" closed="false">6፡19 </char><char style="xt" closed="false"><ref loc="EXO 12:1-20">ኬሲ. ማፃ 12፡1-20</ref>።</char></note> <verse eid="EZR 6:19"/><verse number="20" style="v" sid="EZR 6:20"/>ዒማና ቄኤሶና ሌዊ ዓሶና ቢያ ዎጎ ጎይፆ ዳምቦና ፔ ቶኦኮ ጌኤሼኔ፤ ሃሣ ሌዊ ዓሳኣ ቦንቾ ኬሎይዳ ዲዒንታፓ ማዔ ዴሮና ቄኤሶናም፤ ዬያጉዲ ሃሣ ፔ ቶኦኮም ዔያታ ሺኢሼ ቆልሞዋ ሹኬኔ። <verse eid="EZR 6:20"/><verse number="21" style="v" sid="EZR 6:21"/>ዒንጎ ዒንጊፆዋ ቢያ ዲዒንታፓ ማዔ ዒስራዔኤሌ ዓሳ፤ ዬያጉዲ ሃሣ ዬኖ ዓጮይዳ ናንጋ ሜሌ ዓሶ ዳምቦ ሃሺ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ካኣሽካ ዓሳኣ ቢያ ሙዔኔ። <verse eid="EZR 6:21"/><verse number="22" style="v" sid="EZR 6:22"/>ናንጊና ናንጋ ጎዳ ፔኤሮ ዓሶኦሬ ካኣቲ ዔያቶ ናሽካንዳጉዲና ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ጋላቲንታ ጌኤዦ ማኣሮ ጊንሣ ዔያታ ማዣንዳጉዲ ማዾና ቢያ ዔያቶ ዒ ማኣዳንዳጉዲ ማሄሢሮ ላኣዳ ሙዒ ቦንቾ ኬሎ ላንካይ ኬሊ ኩሙሢ ዼኤፒ ዎዛና ዔያታ ቦንቼኔ።<verse eid="EZR 6:22"/></para>
  <chapter eid="EZR 6"/>
  <chapter number="7" style="c" sid="EZR 7"/>
  <para style="s1">ዒዝራ ዬሩሳላሜ ሙኬሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 7:1"/>ዬካፓ ሚርጌ ሌዔ ዴዓዖ ዓርፄክሲሴ ፓርሴ ካኣቲ ማዔ ዎዶና ዒዝራ ጌይንታ ፔቴ ዓሲስኬይ ዒኢካ ናንጋኔ፤ ዒዛኮ ቤርታኣ ዓዶንሢ ሾይንቶ ፃጳ ዴንዲ ዼኤፓሢ፥ ቄኤሶ ቢያኮ ዑፃሢ፥ ዓኣሮኔ ሄላንዳኣና ፓይዲንታዛ ሃካፓ ዴማ ዓኣ ጎይፆኬ፤ ዬይያ፦ ዒዝራ ሴራያ ናይ ማዓዛ፥ ሴራያ ዓዛሪያ ናይ፥ ዓዛሪያ ሂልቂያ ናይ፥ ሂልቂያ ሻሉሜ ናይ፥ <verse eid="EZR 7:1"/><verse number="2" style="v" sid="EZR 7:2"/>ሻሉሜ ሳዶቄ ናይ፥ ሳዶቄ ዓሂፁቤ ናይ፥ ዓሂፁቤ ዓማሪያ ናይ፥ <verse eid="EZR 7:2"/><verse number="3" style="v" sid="EZR 7:3"/>ዓማሪያ ዓዛሪያ ናይ፥ ዓዛሪያ ሜራዮቴ ናይ፥ ሜራዮቴ ዜራህያ ናይ፥ <verse eid="EZR 7:3"/><verse number="4" style="v" sid="EZR 7:4"/>ዜራህያ ዑዚ ናይ፥ ዑዚ ቡቂ ናይ፥ <verse eid="EZR 7:4"/><verse number="5" style="v" sid="EZR 7:5"/>ቡቂ ዓቢሹዓ ናይ፥ ዓቢሹዓ ፒንሃሴ ናይ፥ ፒንሃሴ ዓላዜሬ ናይ፥ ዓላዜሬ ቄኤሶ ቢያኮ ዑፃሢ ዓኣሮኔ ናይኬ።<verse eid="EZR 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 7:6"/>ዬይ፥ ዒዝራ ባብሎኔይዳፓ ዬሩሳላሜ ሙኬኔ፤ ዒዚ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ሙሴም ዒንጌ ዎጎ ኮሺ ዔራያኬ፤ ናንጊና ናንጋ ጎዳ ማዔ ፆኦሲኮ ዎልቃ ዒዛና ዎላ ዓኣሢሮ ዒዚ ዖኦጬ ባኮ ቢያ ካኣቲ ዒዛም ዒንጌኔ። <verse eid="EZR 7:6"/><verse number="7" style="v" sid="EZR 7:7"/>ዬያጉዲ ሃሣ ካኣቲ ዓርፄክሲሴ ካኣታዼንቴ ላንካሳ ሌዖና ዒስራዔኤሌ ናኣቶ ባኣካፓ ቄኤሳ፥ ሌዊ ዓሳ፥ ዓይኑሞ ዓይናዻ ዓሳ፥ ጌኤዦ ማኣሮ ካሮ ካፓ ዓሶንታ ጌኤዦ ማኣሮይዳ ማዻ ዓሳኣ ዒዝራና ዎላ ዬሩሳላሜ ሙኬኔ። <verse eid="EZR 7:7"/><verse number="8" style="v" sid="EZR 7:8"/>ካኣቲ ዓርፄክሲሴ ካኣታዼ ላንካሳ ሌዖኮ ዶንጋሳ ዓጊኖና ዒዝራ ዬሩሳላሜ ሙኬኔ። <verse eid="EZR 7:8"/><verse number="9" style="v" sid="EZR 7:9"/>ፆኦሲኮ ዼኤፖ ዎልቃ ዒዛይዳ ዓኣሢሮ ባብሎኔይዳፓ ቤርታሳ ዓጊኖኮ ቤርታሳ ኬሎና ዔቂ ዬሩሳላሜ ዶንጋሳ ዓጊኖኮ ዓይፆይዳ ሄሌኔ። <verse eid="EZR 7:9"/><verse number="10" style="v" sid="EZR 7:10"/>ዒዝራ ናንጌ ዎዶ ቢያይዳ ናንጊና ናንጋ ጎዳኮ ዎጎ ናባቢሢና ዬያ ናባቤሢ ማዾይዳ ፔኤሺሢና፤ ዬያጉዲ ሃሣ ናንጊና ናንጋ ጎዳኮ ዓይሢፆንታ ዎጎንታ ዳምቦንታ ዒስራዔኤሌ ዴሮ ጉቤሢም ዔርዚ ዔርዚ ማዾይዳ ፔኤሻያኬ።<verse eid="EZR 7:10"/></para>
  <para style="s1">ካኣቲ ዓርፄክሲሴ ዒዝራም ፃኣፒ ዒንጌ ኪኢቶ</para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 7:11"/>ናንጊና ናንጋ ጎዳ ዒስራዔኤሌ ዓሶም ዒንጌ ዎጎንታ ዓይሢፆንታ ቢያ ኮሺ ዔራያ ማዔ፥ ቄኤሳሢ ዒዝራም ካኣቲ ዓርፄክሲሴ ፃኣፒ ዒንጌ ዋርቃታ ሃካፓ ዴማ ዓኣሢኬ፤ ዬይያ፦<verse eid="EZR 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 7:12"/>«ካኣቶኮ ካኣቲ ዓርፄኪሴይዳፓ ጫሪንጮ ፆኦዛሢኮ ዎጎ ናባቢ ዔሪፆና ዼኤፒ ዔራ ማዔ ቄኤሳሦ፥ ዒዝራ ኔ ኮሺዳ?»<verse eid="EZR 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 7:13"/>«ታኣኒ ዎይሣ ካኣቱሞ ዓጮ ጋራ ዓኣያ፤ ሃሣ ኔኤና ዎላ ዬሩሳላሜ ማዒ ዓኣዻኒ ኮዓ ዒስራዔኤሌ ዓሶንታ ቄኤሶንታ ሌዊ ዓሳኣ ቢያ ማዒ ዴንዳንዳጉዲ ታ ዓይሤኔ፤ <verse eid="EZR 7:13"/><verse number="14" style="v" sid="EZR 7:14"/>ታኣኮ ላንካዎ ዶንዞና ዎላ ዔኤዒ ጌስቲ ኑ ዔቂሴ ጎይፆና ኔ ኩጫ ዓኣ ፆኦሲ ዎጎና ዓይሢፆና ማዾይዳ ፔኤቃሢ ዛጊ ዛጊ ዬሩሳላሜና ዪሁዳናይዳ ማዺንታ ባኮ ኔ ዛጋንዳጉዲ ታ ኔና ዳኬኔ። <verse eid="EZR 7:14"/><verse number="15" style="v" sid="EZR 7:15"/>ቃሲ ሃሣ ዬሩሳላሜይዳ ጌኤሺ ማኣሪ ማዢንቴ፥ ዒስራዔኤሌ ፆኦዛሢም ታኣና ታኣኮ ዶንዞና ኑ ኑ ሼኔና ናሽኪ ዒንጌ ቢሮና ዎርቆና ዔኪ ዴንዴ። <verse eid="EZR 7:15"/><verse number="16" style="v" sid="EZR 7:16"/>ዬያ ሌሊቱዋንቴ ኔኤኒ ኔኤሮ ባብሎኔ ዓጫፓ ቡኩሴ ዎርቆና ቢሮና፥ ዒስራዔኤሌኮ ዴሮንታ ዔያቶኮ ቄኤሳኣ ዓቱዋዖ ዬሩሳላሜይዳ ማዢንቴ ዔያቶኮ ፆኦዛሢ ጌኤዦ ማኣራ ዔያታ ሺኢሻኒ ኮዓ ዒንጊፆ ቢያ ዔኪ ዴንዴ። <verse eid="EZR 7:16"/><verse number="17" style="v" sid="EZR 7:17"/>ዬያ ሚኢሾ ዛጊ ማዾ ማዻንዳጉዲ ማሄ፤ ጌማይ ዚያ፥ ዼኤፖ ዓዶ ማራቶንታ ማራናኣቶንታ፥ ዒንጊፆም ማዓ ሃኣኮንታ ዎይኖ ዑዦዋ ሃሹዋዖ ዬሩሳላሜይዳ ማዢንቴ ዒንሢ ፆኦዛሢኮ ጌኤዦ ማኣሮይዳ ዓኣ ዒንጎ ባኮ ዒንጎ ቤዞይዳ ዒንጊንታ ዒንጊፆ ቢያ ሻንቄ። <verse eid="EZR 7:17"/><verse number="18" style="v" sid="EZR 7:18"/>ዬካፓ ዓታ ቢሮና ዎርቆና ዒንሢኮ ፆኦዛሢ ማሊፆጉዴያ ኔኤና ኔ ዓሶና ዒንሢ ኮዓ ባኣዚ ማዹዋቴ። <verse eid="EZR 7:18"/><verse number="19" style="v" sid="EZR 7:19"/>ጌኤዦ ማኣሮይዳ ማዻንዳጉዲ ዒንጊንቴ ዱማዼ ሜሆ ዬሩሳላሜይዳ ካኣሽኪንታ ፆኦዛሢም ኔ ሺኢሻንዳኔ። <verse eid="EZR 7:19"/><verse number="20" style="v" sid="EZR 7:20"/>ሃሣ ጌኤዦ ማኣሮይዳ ማዺንታኒ ኔኤም ኮይሳ ሜሌ ባኮ ቢያ ካኣቱሞ ማኣሮኮ ሜሆ ጌሦ ማኣራፓ ኔ ዔካኒ ዳንዳዓኔ።<verse eid="EZR 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 7:21"/>«ዔፕራፂሴኮ ዓባ ጌላ ባንፆና ዓኣ ዓጮኮ ቢታንታ ዓኣ ዓሳ ቢያ ጫሪንጮ ፆኦሲ ዒንጌ ዎጎና ዓይሢፆ ኮሺ ዔራ ቄኤሳሢ ዒዝራ ዒዛም ኮይሳ ባኮ ዖኦጫሢ ጉቤ ዒንሢ ኩንሣንዳጉዲ ታኣኒ ዓርፄክሲሴ ዓይሤኔ። <verse eid="EZR 7:21"/><verse number="22" style="v" sid="EZR 7:22"/>ዬይያ፦ ሃይሦ ሺያና ዖይዶ ፄኤታ ኪሎ ማዓ ቢራ፥ ታጶ ሺያ ኪሎ ማዓ ዛርጌ፥ ላምዖ ሺያ ዶሎዜ ማዓ ዎይኔ ዑሺ፥ ላምዖ ሺያ ዶሎዜ ማዓ ሪሚቲ ዛይቴንታ ሶኦጌያ ዒዛም ኮይሳሢጉዴያ ዒንጉዋቴ። <verse eid="EZR 7:22"/><verse number="23" style="v" sid="EZR 7:23"/>ጫሪንጮ ፆኦዛሢኮ ጌኤዦ ማኣሮ ማዾም ኮዓ ባኮ ቢያ ዒንጋንዳያ ዒንሢ ኮይሳያታሢ ዋሊፖቴ፤ ዒዚ ታናንታ ታኣኮ ጊንፃ ኬስካንዳ ካኣቶ ዑፆይዳ ሜቶ ዔኪ ዬዑዋጉዲ። <verse eid="EZR 7:23"/><verse number="24" style="v" sid="EZR 7:24"/>ዬያጉዲ ሃሣ ቄኤሳ፥ ሌዊ ዓሳ፥ ዓይኑሞ ዓይናዻ ዓሳ፥ ጌኤዦ ማኣሮኮ ካሮ ካፓ ዓሶንታ፤ ጉቤና ጌኤዦ ማኣሮ ዛላ ማዓ ዓይጎ ማዾዋ ማዻ ዓሶይዳፓ ቢያ ጊኢራ ዒንሢ ዔካንዳያ ኮይሱዋሴ።<verse eid="EZR 7:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZR 7:25"/>«ኔኤኒ ዒዝራ! ኔ ፆኦዛሢ ኔኤም ዒንጌ ዔራቶጉዴያና ፆኦዛሢ ዎጎና ዎይሣንዳ ዓሲ፥ ዔፕራፂሴኮ ዓባ ጌላ ባንፆና ዓኣ ዓጮ ዓሶ ዎይሣንዳ ዓሲና ጌኤሲያ ዔያቶም ጌስታንዳ ዓሲ ዶኦሬ፤ ሃሣ ዔሩዋ ዓሶማኣ ቢያ ኔ ፆኦዛሢኮ ዎጎ ዔርዜ፤ <verse eid="EZR 7:25"/><verse number="26" style="v" sid="EZR 7:26"/>ዬካፓ ፆኦሲ ዎጎም ማዔቴ ካኣቲ ዎጎም ዓይሢንቱዋ ዓይጎ ዓሲያኣ ዓኣቴ ኮሺ ዛጊንቲ ሃይቃንዳጉዲ ሃንጎ ዓጫፓ ዳውሲንታንዳጉዲ ሃንጎ ዒዛኮ ዓኣ ባካ ዓርቂ ዔኪንታዳጉዲ ዔይዔ ጌዔቴ ቱኡሲና ዎጊንቶንጎ» ጋዓያኬ።<verse eid="EZR 7:26"/></para>
  <para style="s1">ዒዝራ ፆኦሲ ጋላቴሢ</para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 7:27"/>ዒማና ዒዝራ፦ «ናንጊና ናንጋ ጎዳ ማዔ ኑ ዓዶንሢ ፆኦዛሢ ጋላቲንቶንጎ! ዬሩሳላሜይዳ ማዢንታ ፆኦሲ ማኣሮ ካኣቲ ቦንቻንዳጉዲ ማሄሢ ዒዛኬ፤ <verse eid="EZR 7:27"/><verse number="28" style="v" sid="EZR 7:28"/>ፆኦሲ ጌዔሢሮ ካኣቲንታ ዒዛኮ ዶንዞንታ ሃሣ ቢታንታ ዓኣ ዓሳ ታና ናሽኬኔ፤ ናንጊና ናንጋ ጎዳ ማዔ ታ ፆኦዛሢ ታና ዶዲሼሢሮ ዒስራዔኤሌ ፃጶኮ ሱኡጋፓ ሚርጌሢ ታኣና ዎላ ቡኪ ዬሩሳላሜ ሙካንዳጉዲ ዞሪ ታኣኒ ዔያቶ ዔኤዒሳንዳጉዲ ታና ማሄኔ» ጌይ ፆኦሲ ጋላቴኔ።<verse eid="EZR 7:28"/></para>
  <chapter eid="EZR 7"/>
  <chapter number="8" style="c" sid="EZR 8"/>
  <para style="s1">ዒዝራና ዎላ ዲዒንቶ ቤዛፓ ማዔ ዓሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 8:1"/>ካኣቲ ዓርፄክሲሴ ዎዶና ባብሎኔ ዓጫፓ ታኣና ዎላ ኬስኬ ፔቴ ፔቴ ማኣሮ ዓሶኮ ሱኡጎና ዔያቶና ዎላ ፃኣፒንቴ ዓሳ ሃካፓ ሊካ ዓኣ ዓሶኬ፦<verse eid="EZR 8:1"/></para>
  <para style="q">
    <verse number="2-14" style="v" sid="EZR 8:2-14"/>ፒንሃሴ ቶኦካፓ ጌርሾሜ፥ ዒታማሬ ቶኦካፓ ዳኣኔኤሌ</para>
  <para style="q" vid="EZR 8:2-14">ዳውቴ ቶኦካፓ ሼካኒያ ናኣዚ ሃፁሼ</para>
  <para style="q" vid="EZR 8:2-14">ፓርዖሼ ቶኦካፓ ዛካሪያሴ ማዓዛ፥ ዒዛ ማኣሮ ዓሶ ዛላፓ ማዔያ ፄኤታና ዶንጊታሚ ማዓ ዓቲንቄ ፃኣፒንቴኔ፤</para>
  <para style="q" vid="EZR 8:2-14">ፓሃትሞዓኣቤ ቶኦካፓ ዜራሄ ናኣዚ ዔልዬሆናዬ ላምዖ ፄኤታ ዓቲንቄና ዎላ</para>
  <para style="q" vid="EZR 8:2-14">ዛቱ ቶኦካፓ ያሃዚዔኤሌ ናኣዚ ሼካኒያ ሃይሦ ፄኤታ ዓቲንቄና ዎላ</para>
  <para style="q" vid="EZR 8:2-14">ዓዲኔ ቶኦካፓ ዮናታኣኔ ናኣዚ ዔቤዴ ዶንጊታሚ ዓቲንቄና ዎላ</para>
  <para style="q" vid="EZR 8:2-14">ዔላኣሜ ቶኦካፓ ዓታሊያ ናኣዚ ዬሻዕያ ላንካይታሚ ዓቲንቄና ዎላ</para>
  <para style="q" vid="EZR 8:2-14">ሼፓፂያ ቶኦካፓ ሚካዔኤሌ ናኣዚ ዛባዲያ ሳሊታሚ ዓቲንቄና ዎላ</para>
  <para style="q" vid="EZR 8:2-14">ዒዮዓቤ ቶኦካፓ ዬሂዔኤሌ ናኣዚ ዓብዲዮ ላምዖ ፄኤታና ታጶ ሳሊ ዓቲንቄና ዎላ</para>
  <para style="q" vid="EZR 8:2-14">ባኒ ቶኦካፓ ዮሲፒያ ናኣዚ ሼሎሚቴ ፄኤታና ላሂታሚ ዓቲንቄና ዎላ</para>
  <para style="q" vid="EZR 8:2-14">ቤባዬ ቶኦካፓ ቤባዬ ናኣዚ ዛካሪያሴ ላማታሚ ሳሊ ዓቲንቄና ዎላ</para>
  <para style="q" vid="EZR 8:2-14">ዓዝጋኣዴ ቶኦካፓ ሃቃፃኔ ናኣዚ ዮሃናኔ ፄኤታና ታጶ ዓቲንቄና ዎላ</para>
  <para style="q" vid="EZR 8:2-14">ዓዶኒቃሜ ቶኦካፓ ዔሊፔሌፄ፥ ዪዔኤሌንታ ሼማዒያንታ ላሂታሚ ዓቲንቄና ዎላ፤ ዔያታ ጊንፃዺ ማዒ ሙኬኔ።</para>
  <para style="q" vid="EZR 8:2-14">ቢግዋዬ ቶኦካፓ ዑታዬና ዛኩሬና ላንካይታሚ ዓቲንቄና ዎላ ማዔኔ።<verse eid="EZR 8:2-14"/></para>
  <para style="s1">ዒዝራ ጌኤዦ ማኣሮይዳ ማዻንዳ ሌዊ ዓሶ ዴንቄሢ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZR 8:15"/>ታኣኒ ዒማና ዓሃዋ ካታሞ ባንሢ ዎታ ዎሮ ዓጫ ዓሶ ጉቤ ቡኩሴኔ፤ ዒኢካ ሃይሦ ኬሊ ኑ ዱንኪ ዴዔኔ፤ ዬያ ዓሶ ባኣካ ቄኤሶፓ ዓታዛ ሌዊ ዓሲ ባኣሢ ታ ዔሬኔ፤ <verse eid="EZR 8:15"/><verse number="16" style="v" sid="EZR 8:16"/>ዬያሮ ዔሊዔዜሬ፥ ዓሪዔኤሌ፥ ሼማዒያ፥ ዔልናኣታኔ፥ ያሪቤ፥ ዔልናኣታኣኔ፥ ናኣታኣኔ፥ ዛካሪያሴንታ ሜሹላሜ ጌይንታ ታዙጶ ሱኡጎንሢንታ፤ ዬያጉዲ ሃሣ ዮያሪቤና ዔልናኣታኔ ጌይንታ ላምዖ ዔርዛዞንሢ ዔያቶ ባንሢ ታ ዳኬኔ። <verse eid="EZR 8:16"/><verse number="17" style="v" sid="EZR 8:17"/>ዔያቶ ታኣኒ ካሲፒያይዳ ናንጋ ዴሮኮ ሱኡጋሢ ማዔ፥ ዒዶ ባንሢ ዳኪ ዒዶና ጌኤዦ ማኣሮይዳ ዒዛ ማኣዲ ማዻዞንሢ ጌኤዦ ማኣራ ማዻንዳ ዓሲ ኑም ዔያታ ዳካንዳጉዲ ኬኤዞም ታ ዔርዜኔ። <verse eid="EZR 8:17"/><verse number="18" style="v" sid="EZR 8:18"/>ፆኦሲኮ ዼኤፖ ዎልቃ ኑኡና ዎላታሢሮ ዔያታ ኮሺ ዔራያ ማዔ፥ ማሂሊ ቶኦኪ ሼሬቢያ ጎዖ ሌዊ ዓሢ ኑም ዳኬኔ፤ ዒዚ ዒማና ዎሊ ዑፃ ታጶ ሳሊ ማዓ ዓቲንቄ ፔኤኮ ናኣቶና ጌርሲንሢና ዔኪ ኑ ኮራ ሙኬኔ። <verse eid="EZR 8:18"/><verse number="19" style="v" sid="EZR 8:19"/>ዬያጉዲ ሃሣ ሜራሪ ቶኦካፓ ማዔ ሃሻቢያና ዬሻዒያ ጌይንታ ዓሲ ፓይዳ ላማታሚ ማዓ፥ ዔያቶኮ ዒጊኖና ዎላ ዔያታ ኑም ዳኬኔ። <verse eid="EZR 8:19"/><verse number="20" style="v" sid="EZR 8:20"/>ቃሲ ሃሣ ዔያቶኮ ቤርታኣ ዓዶንሢ ሌዊ ዓሶ ማኣዳንዳጉዲ ካኣቲ ዳውቴና ዒዛኮ ዶንዛ ዶኦሬ፥ ሚርጉማ ላምዖ ፄኤታና ላማታሚ ማዓ ዓሲ ጌኤዦ ማኣራ ማዻ ዓሶኬ፤ ዔያታኣ ፔኤኮ ሱንፆና ሱንፆና ፃኣፒንቴኔ።<verse eid="EZR 8:20"/></para>
  <para style="s1">ዒዝራ ዴሮ ሙኡዚ ሃሺ ሺኢቃንዳጉዲ ዓይሤሢ</para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 8:21"/>ፆኦሲ ኑ ዓኣዻ ጎይፆ ኮሻንዳጉዲና ኑናንታ ኑ ናኣቶንታም፤ ዬያጉዲ ሃሣ ኑ ባኮ ቢያ ዒ ካፓንዳጉዲ ዒዛኮ ቤርታ ኑ ቶኦኮ ሂርኪዲ ሺኢቃኒ ዒኢካ ዓሃዋ ዎሮ ዓጫ ሙዖ ሃሺ ሺኢቆ ሺኢጲፆ ሺኢቃንዳጉዲ ታ ዓይሤኔ። <verse eid="EZR 8:21"/><verse number="22" style="v" sid="EZR 8:22"/>ፔቴና ካኣቲ ዓርፄክሲሴም ታ ኬኤዛዖ፦ «ኑ ፆኦዛሢ ዒዛ ጉሙርቃዞንሢ ቢያ ዓንጃኔ፤ ዒዛ ሃሻዞንሢዳ ጋዓንቴ ዶዲ ሜቶ ዓጋኔ» ጌዔሢሮ ጎይፃኣ ኑና ሜታሳንዳ ሞርካፓ ካፓንዳጉዲ ፖኦሊሴንታ ፓራሢና ዖላ ዓሲንታ ዒንጎም ካኣቲ ታኣኒ ዖኦጬያታቶ ሄኤዶ ኑ ቦርሲንቴያ ናንዳኔ። <verse eid="EZR 8:22"/><verse number="23" style="v" sid="EZR 8:23"/>ዬያሮ ፆኦሲ ኑና ፔኤሮ ካፓንዳጉዲ ሙኡዚ ሃሺሢ ዳምቤ ኩንሢ፥ ሙኡዚ ሃሺ ሺኢቆ ሺኢጲሢያ ኑ ሺኢቄም ዒዚ ኑ ሺኢጲፆ ዋይዜኔ።<verse eid="EZR 8:23"/></para>
  <para style="s1">ጌኤዦ ማኣሮም ዒንጊንቴ ባኮ</para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 8:24"/>ዒማና ሱኡጎ ማዔ ቄኤሶንሢ ባኣካፓ ሼሬቢያ፥ ሃሻቢያንታ ሜሌ ታጶ ዓሲያኣ ታ ዶኦሬኔ፤ <verse eid="EZR 8:24"/><verse number="25" style="v" sid="EZR 8:25"/>ዬካፓ ካኣቲንታ ዒዛ ዞራ ዓሶንታ ሃሣ ዶንዞንታ፤ ዬያጉዲ ዒኢካ ዓኣ ዒስራዔኤሌ ዓሳኣ ጌኤዦ ማኣሮ ማዦም ማዓንዳጉዲ ዒንጌ ቢሮንታ ዎርቆንታ ሜሌ ጌኤዦ ማኣሮይዳ ማዺንቶ ሜሆዋ ጉቤ ዔቦኮ ዴኤሡሞ ዔሮ ባኮና ዛጊ ዔሪ ዬንሢ ቄኤሶንሢም ታ ዒንጌኔ።<verse eid="EZR 8:25"/></para>
  <para style="p">
    <verse number="26-27" style="v" sid="EZR 8:26-27"/>ታኣኒ ዒንጌ ጌኤዦ ማኣሮ ባካ ሃካፓ ዴማ ዓኣ ጎይፆኬ፦</para>
  <para style="q" vid="EZR 8:26-27">ላማታሚ ላምዖ ሺያ ኪሎ ማዓ ቢራ</para>
  <para style="q" vid="EZR 8:26-27">ሃይሦ ሺያና ዖይዶ ፄኤታ ኪሎ ማዓ ቢራ ዓንጊና ኮሾና ሜሄ</para>
  <para style="q" vid="EZR 8:26-27">ሃይሦ ሺያና ዖይዶ ፄኤታ ኪሎ ማዓ ዎርቄ</para>
  <para style="q" vid="EZR 8:26-27">ሳሊ ኪሎና ዖይዶ ፄኤታ ጊራኣሜና ማዓ ዎርቄና ኮሺንቴ ላማታሚ ዔቴ ሳኣኔ</para>
  <para style="q" vid="EZR 8:26-27">ዎርቆና ኮሺንቴ ዔቶ ሳኣኖና ዎላ ሄኮ ማዔያ ጌኤሺ ሞኦና ዓንጊና ኮሺንቴ ላምዖ ዔቴ ሳኣኔ።<verse eid="EZR 8:26-27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZR 8:28"/>ዬካፓ ታ ዔያቶም፦ «ዓካሪ ዒንሢ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ቤርታኣ ዓዶንሢ ፆኦዛሢም ዱማዼያኬ፤ ዬያጉዲ ሃሣ ዓሳ ፔ ሼኔና ሺኢሼ፥ ዒንጊሢ ማዒ ዒንጊንቴ ቢሮና ዎርቆናይዳፓ ኮሺንቴ ሜሃ ቢያ ዒዛም ዱማዼያኬ። <verse eid="EZR 8:28"/><verse number="29" style="v" sid="EZR 8:29"/>ዬያ ጌኤዦ ማኣሪ ሄላንዳኣና ዛጊ ካፑዋቴ፤ ዒኢካ ቄኤሶም ጌይንቴ ቆልዖ ጋራ ሃንሢ ቢያ ዱማዼ ሜሆንሢ ዴኤሡሞ ዔሮ ባኮና ዔሪ ቄኤሶና ሌዊ ዓሶናኮ ሱኡጎና፤ ዬያጉዲ ሃሣ ዬሩሳላሜይዳ ዓኣ ዴሮ ሱኡጎም ዒንጉዋቴ» ጌዔኔ። <verse eid="EZR 8:29"/><verse number="30" style="v" sid="EZR 8:30"/>ዬያሮ ቄኤሶና ሌዊ ዓሶና ቢሮንታ ዎርቆንታ፤ ሃንጎ ሜሆ፥ ፆኦሲም ዱማዼሢ ዬሩሳላሜይዳ ጌኤዦ ማኣራ ጌሣኒ ዔኬኔ።<verse eid="EZR 8:30"/></para>
  <para style="s1">ዴሮኮ ዬሩሳላሜ ማዒፆ</para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 8:31"/>ኑ ዒማና ዓሃዋ ዎሮ ዓጫፓ ዔቂ ዬሩሳላሜ ዴንዲፆ ዓርቄሢ ቤርታሳ ዓጊና ፄኤሬ ታጶ ዶንጋሳ ኬሎናኬ፤ ኑ ዓኣዻ ዎዶና ኑ ፆኦዛሢ ኑኡና ዎላታሢሮ ካቲ ዴዒ ኑና ዖላ ዓሶይዳፓ ዒ ኑና ካፔኔ። <verse eid="EZR 8:31"/><verse number="32" style="v" sid="EZR 8:32"/>ዬካፓ ዬሩሳላሜ ኑ ሄላዖ ዒኢካ ሃይሦ ኬሊ ሃውሺ ኑ ዴዔኔ፤ <verse eid="EZR 8:32"/><verse number="33" style="v" sid="EZR 8:33"/>ዖይዳሳ ኬሎና ጌኤዦ ማኣሪ ኑ ዴንዴኔ፤ ዒማና ዬያ ቢሮንታ ዎርቆንታ ዱማዼ ሜሆ ቢያ ዴኤሡሞ ዔሮ ባኮና ዛጊ ዑሪያ ናኣዚ፥ ቄኤሳሢ ሜሬሞቴም ኑ ዒንጌኔ፤ ዒማና ፒንሃሴ ናኣዚ፥ ዔልዓዛሬና ዬያጉዲ ሃሣ ዮዛባዴ ጌይንታ ዒያሱ ናኣዚና ኖዓዲያ ጌይንታ ቢኑዬ ናኣዚያኣ ዒዛና ዎላ ዓኣኔ። <verse eid="EZR 8:33"/><verse number="34" style="v" sid="EZR 8:34"/>ቢያ ባካ ዒማ ኬሎና ፓይዲንቲ ዴኤሡሞ ዔሮ ባኮናኣ ዛጊንቲ ዔርቲ ፒዜ ማዔ ጎይሢና ፃኣፒንቴኔ።<verse eid="EZR 8:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZR 8:35"/>ዬካፓ ዬያታ ዲዒንቴ ቤዛፓ ማዔ ዴራ ቢያ ዒስራዔኤሌ ፆኦዛሢም ሚቺ ዒንጎ ዒንጊሢ ማዓ ባኣዚ ቢያ ዔኪ ሙኬኔ፤ ዬያይዲ ዒስራዔኤሌ ዴሮ ጉቤሢ ሱንፆና ታጶ ላምዖ ዚያ ጌማይ፥ ታዞጲታሚ ላሆ ዓዴ ማራይና ላንካይታሚ ላንካይ ዓዴ ማራናይና ሺኢሼኔ፤ ሃሣ ጎሞ ጌኤሺፆ ዛሎኮ ታጶ ላምዖ ኮላይ ሺኢሼኔ፤ ዬይ ቢያ ናንጊና ናንጋ ጎዳም ሚቺ ሺኢሾ ዒንጊሢ ማዔኔ። <verse eid="EZR 8:35"/><verse number="36" style="v" sid="EZR 8:36"/>ካኣቲ ዔያቶም ፃኣፒ ዒንጌ ባኮ ዔፕራፂሴኮ ዓባ ጌላ ባንፆይዳ ዓኣ ዓጮ ዎይሣ ዓሶና ቢታንታ ዓኣ ዓሶናም ዔያታ ዒንጌኔ፤ ዔያታ ዴሮንታ ፆኦሲ ማኣሮ ማዾንታ ማኣዲ ፔቱሞ ዔርዜኔ።<verse eid="EZR 8:36"/></para>
  <chapter eid="EZR 8"/>
  <chapter number="9" style="c" sid="EZR 9"/>
  <para style="s1">ዓይሁዴቱዋ ላኣሎ ዔኮናሢ ዒዝራ ዔሬሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 9:1"/>ዬይ ባካ ጋፔስካፓ ዒስራዔኤሌ ዴሮ ሱኡጎኮ ፔቴ ፔቴ ዓሲ ታ ኮይላ ሙካዖ፦ «ዴሮንታ ቄኤሶንታ ሌዊ ዓሳኣ ዓቱዋዖ ዔያቶኮ ዓሺኖይዳ ዓኣ ዓሞኦኔ፥ ሞዓኣቤንታ ጊብፄንታይዳ ናንጋዞንሢና ዬያጉዲ ሃሣ ካኣናኔ ዓሶንታ ሂኢታ ዓሶንታ ፔርዜ ዓሶንታ ዒያቡሳ ዓሶንታ ዓሞራ ዓሶንታኮ ዒኢቴ ማዻፓ ፔና ዔያታ ካፒባኣሴ፤ ዬያ ሜሌ ዓሳ ማዻ ሻኣካ ማዾ ቢያ ዔያታ ማዼኔ። <verse eid="EZR 9:1"/><verse number="2" style="v" sid="EZR 9:2"/>ዔያታ ዬያ ዓሶ ቶኦካፓ ፔኤሮ ላኣሊ ዔኪ፥ ሃሣ ዔያቶኮ ናኣቶዋ ዔያቶይዳፓ ዔኪሴኔ፤ ዱማዼ ዜርፆ ሜሌ ዓሺኖ ዓጮ ዓሶና ዎላ ዔያታ ሲኢሬኔ፤ ዬያ ጊቴቃይዶ ማዾኮ ቤርታዼ ዓሳ ሱኡጎና ቢታንታ ዓኣ ዓሶናኬ» ጌይ ታኣም ኬኤዜኔ። <verse eid="EZR 9:2"/><verse number="3" style="v" sid="EZR 9:3"/>ታኣኒ ዬያ ዋይዛዖ ዲቃቲ፥ ታኣኮ ማኣዓሢንታ ዼኤፖ ኮኦቶዋ ዳርዜኔ፤ ሃሣ ታኣኮ ቶኦኮንታ ቡኡጮ ጋፓኖዋ ቡኡጪ ሚርጌና ዖዪ ታ ዴዔኔ፤ <verse eid="EZR 9:3"/><verse number="4" style="v" sid="EZR 9:4"/>ዒስራዔኤሌ ፆኦዛሢ ዲዒንታፓ ማዔ ዓሳ ማዼ ጎሞ ዛሎ ኬኤዜ ቃኣሎ ዋይዜዞንሢ ቢያ ዒጊቹሞፓ ዔቄያና ዲቃቲ ታ ኮይላ ሙኪ ቡኬኔ፤ ታኣኒያ ሳዓ ዒባናኣና ፆኦሲም ዒንጎ ዒንጊፃ ሺኢካ ዎዶ ሄላንዳኣና ሚርጌና ዖዪ ዲቃቲ ፔኤቄኔ፤<verse eid="EZR 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 9:5"/>ዬይ ዒባናኣና ፆኦሲም ዒንጎ ባኮ ሺኢሾ ዎዳ ሄላዛ ታኣኒ ዖዪ ዴዔ ቤዛፓ ዔቄኔ፤ ታኣኮ ታ ዳርዜ ማኣዓሢያ ማይንቲ፥ ጉኡዦና ጉምዓቲ ናንጊና ናንጋ ጎዳ ማዔ ታ ፆኦዛሢ ባንሢ ኩጮ ዔቂሳዖ ሂዚ ጌይ ታ ሺኢቄኔ፦ <verse eid="EZR 9:5"/><verse number="6" style="v" sid="EZR 9:6"/>«ታ ፆኦዛሢዮ! ኑኡኮ ጎማ ኑኡፓ ዑሣ ዓኣዼሢሮና ኑኡኮ ዻቢንታ ጫሪንጮ ሄሌሢሮ ታ ዓኣፖ ካሮ ሌካ ታ ፆኦዛሢ፥ ኔ ባንሢ ማሃኒ ታና ቦርሳኔ፤ ሃሣ ታ ዒጊጫኔ። <verse eid="EZR 9:6"/><verse number="7" style="v" sid="EZR 9:7"/>ኑኡኮ ቤርታኣ ዓዶንሢፓ ዓርቃዖ ሙኪ ሃኖ ሄላንዳኣና ኑኡኒ ኔኤኮ ዴራ ዼኤፒ ዻቢንቲ ማዼኔ፤ ኑኡኮ ጎሞ ሚርጉሞፓ ዔቄያና ኑና ኔ ዴሮንታ ካኣቶንታ ቄኤሶንታ ሜሌ ዓጮ ካኣቶ ኩጫ ኑ ሎኦሜኔ፤ ዬያሮ ኑኡኒ ጬንቾ ዓፓሮና ሃይቄኔ፥ ኑኡኮ ቆላኣ ቡሪንቴኔ፤ ሃሣ ቱኡቲ ኑ ዲዒንቲያ ዔውቴኔ፤ ሃኣዛጌ፥ ሃሢ ኑ ዓኣ ጎይፆ ጋፒንሢ ሄላንዳኣና ዻውሲንቴኔ። <verse eid="EZR 9:7"/><verse number="8" style="v" sid="EZR 9:8"/>ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢዮ! ዓኣፖ ኑኡኮ ኔ ቡሌኔ፤ ሃሢ ዻካ ዎዴም ኔ ቤርታ ኑ ቦንቺንቲ ዴንቂ፥ ኑ ጊዳፓ ዛላ ዓሲ ዓይሉሞ ቃምባራፓ ኬስኪ ሃኖ ዱማዼ ዓጬሎይዳ ኮሺና ናንጋዳጉዲ ኔ ማሄኔ፤ ዎዚ ኑ ዓይሌ ማዔቴያ ዓኪ፥ ላኣሚንቲ ናንጊ ኔ ኑም ዒንጌኔ። <verse eid="EZR 9:8"/><verse number="9" style="v" sid="EZR 9:9"/>ኑኡኒ ዓይሌኬ፤ ጋዓንቴ ዓይሌ ማዒ ዒኢካ ዓታንዳጉዲ ኔ ኮዒባኣሴ፤ ኔኤኒ ፓርሴ ካኣታ ኑም ሚጪንታንዳጉዲና ኑ ናንጋ ዓይላታፓ ኬስኪ ሚና ቤርታ ሻሂንቴ ኔኤኮ ጌኤዦ ማኣሮ ጊንሣ ላሚ ኑ ማዣንዳጉዲ፥ ሃሣ ሃይካ ዪሁዳና ዬሩሳላሜናይዳ ኮሺና ኑ ናንጋንዳጉዲ ኔ ማሄኔ።<verse eid="EZR 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 9:10"/>«ጋዓንቴ ኑ ፆኦዛሢዮ! ሃኖ ሄላንዳኣና ማዔ ባኮሮ ቢያ ኑ ዎዚ ጋዓንዳይ? ሃሢያ ኑ ኔኤኮ ዓይሢፆ ላሚ ዋይዞ ዒፄኔ፤ <verse eid="EZR 9:10"/><verse number="11" style="v" sid="EZR 9:11"/>ዬንሢ ዓይሢፆንሢያ ኔኤኮ ማዾ ማዻ፥ ኔ ማሊፆ ኬኤዛዞንሢ ዛሎና ኬኤዚንቴዞንሢኬ፤ ኔ ማሊፆ ኬኤዛዞንሢ ሃያኮ ቤርታ፦ ‹ዒንሢ ጌሊ ዻካላንዳ ዓጬላ ዒኢቴ ባካፓ ቢያ ጌኤሺቱዋሴ፤ ዎይቲ ጌዔቴ ዒኢካ ናንጋ ዴራ ዓይፃፓ ጋፖ ሄላንዳኣና ሻኣካ ማዾና ቢያ ዓጬሎ ኩንሤኔ። <verse eid="EZR 9:11"/><verse number="12" style="v" sid="EZR 9:12"/>ዬያሮ ዒንሢኮ ዉዱሮ ናኣቶ ዔያቶኮ ዓቲንቆ ናኣቶም ዒንጊፖቴ፤ ጊንሣ ዒንሢኮ ዓቲንቆ ናኣቶ ዔያቶኮ ዉዱሮ ናኣቶ ዔኪሲፖቴ፤ ዓይጎ ዎዴናኣ ማዖም ዓጬሎይዳፓ ኮሺ ባኣዚ ዒንሢ ሙዒ፥ ዒንሢኮ ናኣቶም ናንጊና ማዓ ቤሲ ማሂ ዻካልሳኒ ዓይጎ ዎዴናኣ ዔያቶና ዎላ ጊኢጊ ጫኣቂፖቴ› ጌይ ኑም ኬኤዜኔ። <note caller="-" style="x"><char style="xo" closed="false">9፡12 </char><char style="xt" closed="false"><ref loc="EXO 34:11-16">ኬሲ. ማፃ 34፡11-16</ref>፤ <ref loc="DEU 7:1-5">ላሚ. ዎማ 7፡1-5</ref>።</char></note> <verse eid="EZR 9:12"/><verse number="13" style="v" sid="EZR 9:13"/>ኑና ሄሌ ሜታሢ ኑኡኮ ፑርቶ ማዾና ኑ ዻቢንቶና ዛላናኬ፤ ጋዓንቴ ኔኤኒ፥ ኑ ፆኦዛሢ ኑና ሜታሴ ሜታ ኑ ዔካኒ ኮይሳሢፓ ዻካኬ፤ ዬያ ሌሊቱዋንቴ ባይሲንታፓ ኑ ቶሊ ሼምፔና ኑ ናንጋንዳጉዲ ኔ ማሄሢ ኑ ዔራኔ። <verse eid="EZR 9:13"/><verse number="14" style="v" sid="EZR 9:14"/>ዓካሪ ዎዲ ጊንሣ ኑ ኔ ዓይሢፆ ሃሺ ሃንሢ ዋይዞ ዒፃ ዴሮንሢና ዎሊ ኑ ዔኮንዶይ? ኑኡኒ ዬያ ማዼቶ ኔ ዻጋዺ ጋፒንሢ ሄላንዳኣና ኑና ኔ ባይዛንዳኔ፤ ፔቴ ዓሲታዎ ሼምፔና ኔ ዓይሳዓኬ። <verse eid="EZR 9:14"/><verse number="15" style="v" sid="EZR 9:15"/>ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢዮ! ኔኤኒ ጎኑሞና ዎጋያኬ፤ ጋዓንቴ ባይሲንታፓ ኑ ቶሊ ሼምፔና ዓታንዳጉዲ ኔ ማሄኔ፤ ዓካሪ ኑኡኒ ኑኡኮ ጎሞ ኔ ቤርታ ቡኡፃኔ፤ ኑኡኒ ኔ ቤርቶ ሺኢካኒ ዳንዳዓ ዓሲቱዋሴ።»<verse eid="EZR 9:15"/></para>
  <chapter eid="EZR 9"/>
  <chapter number="10" style="c" sid="EZR 10"/>
  <para style="s1">ሜሌ ዓሶና ዎሊ ዔኩዋጉዲ ላኣጋኒ ኬሲንቴ ዎጌ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 10:1"/>ዒዝራ ጌኤዦ ማኣሮኮ ቤርቶ ዛላ ፆኦሲ ሺኢቃኒ ጉምዓታዖ ዬኤኪ ዬኤኪ ማዺንቴ ጎሞ ቢያ ፆኦሲም ቡኡፃ ዎዶና ዓቲንቆንታ ላኣሎንታ ናኣታኣ ዓቱዋዖ ፓይዳ ሚርጌ ማዔ ዒስራዔኤሌ ዓሲ ፔቱሞና ዒዛ ኮይላ ሙኪ ቡኪ ዒኔ ሜቂ ዬኤካኔ። <verse eid="EZR 10:1"/><verse number="2" style="v" sid="EZR 10:2"/>ዒማና ዔላኣሜ ቶኦካፓ ዬሂዔኤሌ ናኣዚ ሼካኒያ ዒዝራም፦ «ጎኔና ኑኡኒ ኑ ዓሺኖይዳ ዓኣ ሜሌ ዓሶይዳፓ ላኣሎ ዔኪፆና ፆኦሲዳ ኑኡኮ ዓኣ ጉሙርቂንቲፆ ኑ ፓጪሴኔ፤ ዬይ ቢያ ማዔቴያ ሃሢ ዒስራዔኤሌ ዓሶም ሃጊ ማዓንዳ ዎዛ ዓኣኔ። <verse eid="EZR 10:2"/><verse number="3" style="v" sid="EZR 10:3"/>ሃሢ ዬንሢ ሜሌ ዓሶይዳፓ ኑ ዔኬ ላኣሎ ዔያቶኮ ናኣቶና ዎላ ዓንጃንዳያ ኑና ኮይሳሢ ኑ ፆኦዛሢም ኑ ጫኣቆም፤ ኔናንታ ኑ ፆኦዛሢኮ ዎጎ ቦንቻ ሜሌ ዓሶንታ ኑና ዞራ ዞሮ ቢያ ኑ ማዺ ኩንሣንዳኔ፤ ሃሣ ፆኦሲኮ ዎጋኣ ዓይሣሢ ቢያ ኑ ማዺ ኩንሣንዳኔ፤ <verse eid="EZR 10:3"/><verse number="4" style="v" sid="EZR 10:4"/>ዬያ ቢያ ማዺሲ ኑና ኩንሢሳንዳሢ ኔናታሢሮ ዔቄ፤ ኑኡኒ ኔና ማኣዳንዳኔ፤ ዒጊጪፖ፥ ዶዴ» ጌዔኔ።<verse eid="EZR 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 10:5"/>ዬያሮ ዒዝራ ቄኤሶንታ ሌዊ ዓሶንታ ሃሣ ዴሮኮ ሱኡጋ ዬይ ሼካኒያ ሺኢሼ ማሊፆ ዔኬያ ማዒፆ ጫኣቂሴስካፓ ማዾ ዓርቄኔ። <verse eid="EZR 10:5"/><verse number="6" style="v" sid="EZR 10:6"/>ዬካፓ ዒዝራ ጌኤዦ ማኣሮኮ ቤርቶ ዛላ ዓኣ ቤዛፓ ዔቂ ዔሊያሺቤ ናኣዚ ዮሃናኔ ናንጋ ቆልዖንሢ ጋሮ ጌሌኔ፤ ዲዒንቴዞንሢ ጉሙርቂንቲፆ ፓጪሲሢና ማዼ ዻቢንቶና ቢያ ዒ ዖዪ ዖዪ ዬኖ ዋንቶ ዒኢካ ዎርቄኔ፤ ዒማና ዒ ካሣንታ ዋኣሢያ ካኣሚባኣሴ።<verse eid="EZR 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 10:7"/>ዲዒንቶይዳፓ ማዔዞንሢ ቢያ ዬሩሳላሜይዳ ቡኪንታንዳጉዲ ዬሩሳላሜና ዪሁዳ ዓጮናይዳ ቢያ ኬኤዚንቴኔ። <verse eid="EZR 10:7"/><verse number="8" style="v" sid="EZR 10:8"/>ዬይ ቢያ ዴሮ ሱኡጋ ዞሬ ዞሮና ዓይሢፆና ማዺንቴያኬ፤ ሃይሦ ኬሊዳ ዬያ ቡኪንቶ ሙካኒ ዳንዳዒባኣ ዓይጎ ዓሲያ ዓኣቶ ዒዛኮ ዓኣ ባካ ቢያ ዓርቂንቲ ዔውታንዳጉዲና ዲዒንታፓ ማዔ ዓሶኮ ፔቱማፓ ኬስካንዳጉዲ ኬኤዚንቴኔ። <verse eid="EZR 10:8"/><verse number="9" style="v" sid="EZR 10:9"/>ዬይ ዔኤሊፃ ዳኪንቴሢዳፓ ሃይሦ ኬሊዳ ዪሁዳና ቢኢኒያሜ ዓጮናይዳ ናንጋ ዓሳ ቢያ ታዞጳሳ ዓጊና ፄኤሬ ላማታማሶ ዓቦና ዬሩሳላሜ ሙኪ ጌኤዦ ማኣሮኮ ዓሳ ቡካ ጶኦካ ቡኪንቴኔ፤ ዒማና ኮሺ ፑኡፒ ዒርዚ ዋርቃኔ፤ ያዺታቶዋ ቡኪንቴላ ኮሺ ኮይሳያታሢሮ ፔቴ ፔቴ ዓሳ ጪኢዦና ጎጋይቂ ጎጋይቂ ዋይዛኔ።<verse eid="EZR 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 10:10"/>ቄኤሳሢ ዒዝራ ዔቃዖ፦ «ዒንሢ ዒንሢኮ ጉሙርቂንቲፆ ፓጪሲ ጴዼኔ፤ ሜሌ ዓሶይዳፓ ላኣሎ ዒንሢ ዔኬሢሮ ዒስራዔኤሌይዳ ዻቢንቲኮ ጋሌ ዒንሢ ዔኪ ዬዔኔ። <verse eid="EZR 10:10"/><verse number="11" style="v" sid="EZR 10:11"/>ዓካሪ ሃካፓ ሴካ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ቤርታኣ ዓዶንሢ ፆኦዛሢ ቤርታ ዒንሢኮ ጎሞ ቢያ ቡኡፁዋቴ፤ ዒዛ ዎዛሳ ባኣዚ ቢያ ማዹዋቴ፤ ኑ ዓጮይዳ ናንጋ ሜሌ ዓሶይዳፓ ቢያ ዱማዹዋቴ፤ ዒንሢ ዔኬ፥ ሜሌ ዓሶ ማዔ ላኣሎ ኬሱዋቴ» ጌዔኔ።<verse eid="EZR 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 10:12"/>ዬያሮ ዬይ ቡኪንቴ ዓሳ ዼግ ጌዔ ዑኡሲና፦ «ኔኤኒ ጋዓ ባኮ ቢያ ኑኡኒ ማዻንዳኔ!» ጌዔኔ። <verse eid="EZR 10:12"/><verse number="13" style="v" sid="EZR 10:13"/>ላሚ ሃሣ ኬኤዛዖ፦ «ሃሢ ሃይካ ቡኬ ዴራ ሚርጌኬ፤ ዬያይዳ ሃሢ ዼኤፒ ዒርዚያ ዋርቂ ዋርቂኬ፤ ሃይካ ማኣሪባኣ ቤስካ ዔቃኒ ኑ ዳንዳዒባኣሴ፤ ዬያ ጎሞና ቱርጲንቴ ዓሳ ኑ ሚርጌታሢሮ ሃያ ባኮ ቢያ ፔቴና ላምዖ ኬሊናይዳ ማዺ ጋፒሳኒ ኑም ዳንዳዒንቱዋሴ። <verse eid="EZR 10:13"/><verse number="14" style="v" sid="EZR 10:14"/>ዬያሮ ኑኡኮ ሱኡጋ ሃይካ ዬሩሳላሜይዳ ዬኖ ጌኤዜሎ ኮሺ ዛጊ ጌስቶንጎ፤ ዬካፓ ሜሌ ዓሶ ማዔ ላኣሎ ዔኬ ዓሶ ቢያ ፔቴ ፔቴሢም ዓይሢንታ ኬሎማና ዒ ናንጋ ካታሞ ሱኡጎና ዎጎ ዎጋ ዓሶና ዎላ ሙኪ ሙኪ ፔጊዳ ዓጎና ባኮ ዔኮንጎ፤ ፆኦሲ ዻጋዼ ባኮ ዛሎ ኑ ዬያይዴቴ ጎሪንታ ሺማንዳኔ» ጌዔኔ። <verse eid="EZR 10:14"/><verse number="15" style="v" sid="EZR 10:15"/>ዬይ ኬኤዚንቴ ዎዶና ሜሹላሜና ሌዊ ዓሢ ሻቤታዬና ዔያቶኮ ማሊፆ ቃራኬ ጌዔ፥ ዓሳሄሌ ናኣዚ ዮናታኣኔና ቲቂዋ ናኣዚ ያህዜያፓ ዓታዛ ሜሌ ዒፂ ማኬ ዓሲ ባኣሴ።<verse eid="EZR 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 10:16"/>ዲዒንታፓ ማዔ ዓሳ ቢያ ዬኖ ማሊፄሎና ዔኤዒ ጊኢጌኔ፤ ዬያሮ ቄኤሳሢ፥ ዒዝራ ቶኦኮ ቶኦኮኮ ሱኡጎ ባኣካፓ ኬሲ ማዺሻንዳ ዓሲ ዶኦሪ ሱንፆ ዎሊ ሄሊሲ ፃኣፒ ጌሤኔ፤ ዔያታ ታጳሳ ዓጊና ፄኤሬ፥ ቤርታሳ ዓቦና ሜሌ ላኣሎ ዔኬ ዓሶ ሃይሶ ጌስቲሢ ዓርቄኔ። <verse eid="EZR 10:16"/><verse number="17" style="v" sid="EZR 10:17"/>ዬካፓ ሄሊሴ ዓጊኖኮ ቤርታሳ ኬሎ ሜሌ ላኣሎ ዔኬ ዓሶ ሃይሶ ጉቤ ጌስቲ ጋፒሴኔ።<verse eid="EZR 10:17"/></para>
  <para style="s1">ሜሌ ዓሶ ዜርፆፓ ላኣሎ ዔኬ ዓሶ ሱንፆ</para>
  <para style="p">
    <verse number="18" style="v" sid="EZR 10:18"/>ሜሌ ዓሶ ዜርፆፓ ላኣሎ ዔኬ ዓሶኮ ሱንፃ ሃካፓ ዴማ ዓኣ ጎይፆኬ፦</para>
  <para style="s1" vid="EZR 10:18">ፔኤኮ ቶኦኮና ቶኦኮና ፃኣፒንቴ ቄኤሶ</para>
  <para style="p" vid="EZR 10:18">ዒዮፄዴቄ ናኣቶ ማዔ ዒያሱና ዒዛኮ ጌርሲንሢ ቶኦካፓ ኬስኬዞንሢ፦ ማዕሴያ፥ ዔሊዔዜሬ፥ ያሪቤና ጌዳሊያና፤ <verse eid="EZR 10:18"/><verse number="19" style="v" sid="EZR 10:19"/>ዔያታ ፔኤኮ ላኣሎ ዓንጂ ዳካኒ ጫኣቄስካፓ ዔያቶኮ ጎሞ ጌኤሺፆም ማዓ ፔቴ ዓዴ ማራይ ሚቺ ዒንጎ ዒንጊሢ ማሂ ሺኢሼኔ።<verse eid="EZR 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZR 10:20"/>ዒሜሬ ቶኦካፓ፦ ሃናኒና ዜባድያና<verse eid="EZR 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 10:21"/>ሃሪሜ ቶኦካፓ፦ ማዕሴያሄ፥ ዔሊያሴ፥ ሼማዒያ፥ ዬሂዔኤሌንታ ዑዚያንታ፤<verse eid="EZR 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZR 10:22"/>ፓሽሁሬ ቶኦካፓ፦ ዔልዮዔናዬ፥ ማዕሴያ፥ ዒስማዔኤሌ፥ ናትናዔኤሌ፥ ዮዛባዴና ዔልዓሳና፤<verse eid="EZR 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 10:23"/>ሌዊ ዓሶ ፃጳፓ፦</para>
  <para style="p" vid="EZR 10:23">ዮዛባዴ፥ ሺምዒ፥ ቄሊፃ ጌይንታ ቄላያ፥ ፔታህያ፥ ዪሁዳና ዔሊዔዜሬና፤<verse eid="EZR 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 10:24"/>ፆኦሲ ቦንቾም ዓይኑሞ ዓይናዻ ዓሶ ፃጳፓ፦</para>
  <para style="p" vid="EZR 10:24">ዔሊያሺቤ</para>
  <para style="b" vid="EZR 10:24"/>
  <para style="s1" vid="EZR 10:24">ጌኤዦ ማኣሮ ካፓ ዓሶ ፃጳፓ</para>
  <para style="p" vid="EZR 10:24">ሻሉሜ፥ ፄሌሜና ዑሪና፤<verse eid="EZR 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZR 10:25"/>ሃንጎ ዒስራዔኤሌ ዓሶኮ፦</para>
  <para style="p" vid="EZR 10:25">ፓርዖሼ ቶኦካፓ፦ ራሚያ፥ ዪዚያ፥ ማልኪያ፥ ሚያሚኔ፥ ዓላዜሬ፥ ማልኪያና ቤናያና፤<verse eid="EZR 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EZR 10:26"/>ዔላኣሜ ቶኦካፓ፦ ማታኒያ፥ ዛካሪያሴ፥ ዬሂዔኤሌ፥ ዓብዲ፥ ዬሬሞቴና ዔሊያና፤<verse eid="EZR 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 10:27"/>ዛቱ ቶኦካፓ፦ ዔልዮዔናዬ፥ ዔሊያሺቤ፥ ማታኒያ፥ ዬሬሞቴ፥ ዜባዴና ዓዚዛና፤<verse eid="EZR 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZR 10:28"/>ቤባዬ ቶኦካፓ፦ ዮሆናኔ፥ ሃናኒያ፥ ዛባዬና ዓትላዬና፤<verse eid="EZR 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EZR 10:29"/>ባኒ ቶኦካፓ፦ ሜሹላሜ፥ ማሉኬ፥ ዓዳያ፥ ያሹቤ፥ ሼዓሌና ዬራሞቴና፤<verse eid="EZR 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZR 10:30"/>ፓሃትሞዓኣቤ ቶኦካፓ፦ ዓድና፥ ኬላሌ፥ ቤናያ፥ ማዕሴያ፥ ማታኒያ፥ ቤፃልዔኤሌ፥ ቤኑዬና ሚናኣሴና፤<verse eid="EZR 10:30"/></para>
  <para style="p">
    <verse number="31-32" style="v" sid="EZR 10:31-32"/>ሃሪሜ ቶኦካፓ፦ ዔሊዔዜሬ፥ ዪሺያ፥ ማልኪያ፥ ሼማዒያ፥ ሲሞኦኔ፥ ቢኢኒያሜ፥ ማሉኬና ሼማሪያና፤<verse eid="EZR 10:31-32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZR 10:33"/>ሃሹሜ ቶኦካፓ፦ ማታናዬ፥ ማታታ፥ ዛባዴ፥ ዔሊፔሌፄ፥ ዬሬማዬ፥ ሚናኣሴና ሺምዒና፤<verse eid="EZR 10:33"/></para>
  <para style="p">
    <verse number="34-37" style="v" sid="EZR 10:34-37"/>ባኒ ቶኦካፓ፦ ሜዕዳዬ፥ ዓምራሜ፥ ዑዔኤሌ፥ ቤናያ፥ ቤድያ፥ ኬሉሂ፥ ዋኒያ፥ ሜሬሞቴ፥ ዔሊያሺቤ፥ ማታኒያ፥ ማትናዬና ያዕሱና፤<verse eid="EZR 10:34-37"/></para>
  <para style="p">
    <verse number="38-42" style="v" sid="EZR 10:38-42"/>ቢኑዬ ቶኦካፓ፦ ሺምዒ፥ ሼሌምያ፥ ናኣታኒ፥ ዓዳያ፥ ማክናዳባዬ፥ ሼሻዬ፥ ሻራዬ፥ ዓዛርዔኤሌ፥ ሼሌሚያ፥ ሼማሪያ፥ ሻሉሜ፥ ዓማሪያና ዮሴፔና፤<verse eid="EZR 10:38-42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="EZR 10:43"/>ኔቦ ቶኦካፓ፦ ዬዒዔኤሌ፥ ማቲቴያ፥ ዛባዴ፥ ዜቢና፥ ያዳዬ፥ ዒዩዔኤሌና ቤናያና፤<verse eid="EZR 10:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="EZR 10:44"/>ዬይ ዓሳ ቢያ ሜሌ ፃጳፓ ላኣሎ ዔኬ ዓሶኬ፤ ዔያታ ዔኬ ሜሌ ፃጶ ላኣሎ ቢያ ዓንጂ ዔያቶኮ ናኣቶና ዎላ ዳኬኔ።<verse eid="EZR 10:44"/></para>
  <chapter eid="EZR 10"/>
</usx>
