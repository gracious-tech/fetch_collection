<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- MAALE Full Bible</book>
  <para style="h">ዔርሚያሴኮ ቃዮ ማፃኣፖ</para>
  <para style="toc1">ዔርሚያሴኮ ቃዮ ማፃኣፖ</para>
  <para style="toc3">ዔቃ. ማ</para>
  <para style="toc2">ዔርሚያሴኮ ቃዮ ማፃኣፖ</para>
  <para style="mt1">ዔርሚያሴኮ ቃዮ ማፃኣፖ</para>
  <para style="imt">ዓይፆ ካሮ</para>
  <para style="ip">ዔርሚያሴኮ ቃዮ ማፃኣፓ፦ ኪሪስቶሴ ሾይንታንዳሢኮ ቤርታ ዶንጎ ፄኤታና ሳሊታሚ ላሆ ማዓ ሌዖይዳ ዬሩሳላሜ ካታማ ሻሂንቴሢሮ፤ ጊንሣ ሃሣ ዒኢካ ናንጋ ዴራኣ ዳውሲንቲ ዴንዴሢሮ ዖዪ ካላሎና ዶንጎ ካላሊ ዓርቄያኬ። ሃኖ ማፃኣፖይዳ ዓኣ ባካ ባሼ ዬኤፒ ዛላና ሲዬ ዛላ ኬኤዛያ ማዔቴያ ፆኦሲዳ ጉሙርቂሢ ጌሥሢ ዛላንታ ሃጋኣ ማዓንዳ ዎዛ ጌሢ ናንጊሢ ዛላኣ ኬኤዛ ቤሲ ዓኣኔ፤ ዬያቶ ካላሎ ኪሪስቶሴ ሾይንታዳሢኮ ቤርታ ዶንጎ ፄኤታና ሳሊታሚ ላሃሳ ሌዖና ዓጬሎይዳ ሄሌ ባይሲንቶ ማሊ ጶቂሣኒ ዓይሁዶ ዓሳ ሙኡዚ ሃሺሢና ዖዪሢ ካኣሺ ሌዓ ሌዓ ካኣሽካ ዎዶና ዬያቶ ካላሎ ናባባኔ።</para>
  <para style="iot">ማፃኣፔላ ዱማ ዱማ ዓርቄ ባኮ</para>
  <para style="io1">ቤርታሳ ቃዮ፦ ዬሩሳላሜ ሜታዼ ሜቶንታ ዖዪንቴ ዖዪፆ (1፡1-22)</para>
  <para style="io1">ላማሳ ቃዮ፦ ፆኦሲ ዬሩሳላሜይዳ ዓጌ ዴኤፆ ሜቶ (2፡1-22)</para>
  <para style="io1">ሃይሣሳ ቃዮ፦ ሃጊ ማዓንዳ ዎዛ ባኣዚ ዓኣያ ማዒፆ (3፡1-66)</para>
  <para style="io1">ዖይዳሳ ቃዮ፦ ዬሩሳላሜኮ ባይሲንቶ (4፡1-22)</para>
  <para style="io1">ዶንጋሳ ቃዮ፦ ማኣሪሢ ዴንቃኒ ሺኢቂንታ ሺኢጲሢ (5፡1-22)</para>
  <chapter number="1" style="c" sid="LAM 1"/>
  <para style="s1">ዬሩሳላሜ ካታሞኮ ሜቶንታ ዖዪፆንታ</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 1:1"/>ሃያኮ ቤርታ ዓሲ ኩሚ ዓኣ ካታሜላ</para>
  <para style="q2" vid="LAM 1:1">ሃሢ ዎዎይቴዖ ሃሺንቴ ቤሲ ማዒ ዓቴንቴሞ!</para>
  <para style="q2" vid="LAM 1:1">ዓጮ ባኣኮይዳ ዼኤፒ ማዒ ዓኣዛ</para>
  <para style="q2" vid="LAM 1:1">ዓኒ ሃይቄ ላኣሊጉዲ ማዔንቴሞ!</para>
  <para style="q2" vid="LAM 1:1">ዱማ ዱማ ፓቂንቴ ዓጮፓ ጌኤሾ ማዒ ዓኣዛ</para>
  <para style="q2" vid="LAM 1:1">ሃሢ ዓይሌ ማዒ ዴዔኔ።<verse eid="LAM 1:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="LAM 1:2"/>ዒዛ ዹሞና ዒናፓ ዬኤካኔ፤</para>
  <para style="q2" vid="LAM 1:2">ዓቢፃ ዒዞኮ ጋጋጮና ሊካ ኬዳኔ፤</para>
  <para style="q2" vid="LAM 1:2">ዒዞ ሃያኮ ቤርታ ናሽካ ዓሶ ቢያሢዳፓ</para>
  <para style="q2" vid="LAM 1:2">ዒዞ ዶዲሻ ዓሲ ፔቴታዖ ባኣሴ፤</para>
  <para style="q2" vid="LAM 1:2">ዒዞኮ ላጎ ማዔ ዓሳ ቢያ ዒዞ ሃሼኔ፤</para>
  <para style="q2" vid="LAM 1:2">ሞርኬ ማዒያኣ ዒዞይዳ ዔቄኔ።<verse eid="LAM 1:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="LAM 1:3"/>ዪሁዳ ዴራ ሚርጌ ዋኣዪንቲ ዓይላቶ ማዾዋ ማዼስካፓ</para>
  <para style="q2" vid="LAM 1:3">ዲዒንቲ ዔውቴኔ፤</para>
  <para style="q2" vid="LAM 1:3">ሃሢ ዔያታ ሜሌ ዴሮ ባኣካ ናንጋኣና</para>
  <para style="q2" vid="LAM 1:3">ፔቴታዖ ዔያቶኮ ሃውሾ ባኣሴ፤</para>
  <para style="q2" vid="LAM 1:3">ዔያታ ሚርጌና ካራ ባይዚ ዓኣንቴ</para>
  <para style="q2" vid="LAM 1:3">ዔያቶ ዳውሳ ዓሳ ሙኪ ሄሌኔ።<verse eid="LAM 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 1:4"/>ዖኦኒያ ዒኢካ ቦንቺንታ ቦንቾ ቦንቻኒ ሙኪንዱዋኣሢሮ</para>
  <para style="q2" vid="LAM 1:4">ፂዮኔ ዹኮ ባንሢ ዴንዶ ጎይፃ ቦቦይታሳያ ዔዌ ማዓንዳኔ፤</para>
  <para style="q2" vid="LAM 1:4">ዬሩሳላሜ ጌሎ ካሮና ጌላ ዓሲንታ ኬስካ ዓሲያ ባኣሴ፤</para>
  <para style="q2" vid="LAM 1:4">ዒኢካ ዓኣ ቄኤሳ ሜታዺ ፔ ዒኖና ዚኢሊንታኔ፤</para>
  <para style="q2" vid="LAM 1:4">ዉዱሮ ናኣታኣ ዖዪ ሜታዻኔ፤</para>
  <para style="q2" vid="LAM 1:4">ፂዮኔ ካራ ባይዚ ሜታዺሢዳኬ።<verse eid="LAM 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 1:5"/>ዒዛ ሚርጌ ጎሜ ማዼሢሮ</para>
  <para style="q2" vid="LAM 1:5">ናንጊና ናንጋ ጎዳ ዒዞ ሜቶይዳ ዓጌኔ፤</para>
  <para style="q2" vid="LAM 1:5">ዒዞኮ ናኣቶ ሞርካ ዲዒ ዔኪ ዴንዴኔ፤</para>
  <para style="q2" vid="LAM 1:5">ዒዞኮ ሞርካ ዒዞ ዎይሣያ ማዔሢሮ</para>
  <para style="q2" vid="LAM 1:5">ሞርኮም ዔኤቢ ጊኢጌኔ።<verse eid="LAM 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 1:6"/>ዬሩሳላሜኮ ቦንቺንታ ቢያ ባይቂ ጋፔኔ፤</para>
  <para style="q2" vid="LAM 1:6">ዒዞ ዎይሣ ሱኡጋ ሄንቆ ቤሲ ባይዜ ሞይሌ ማዔኔ፤</para>
  <para style="q2" vid="LAM 1:6">ዔያቶ ኬማ ዓሳ ዳውሳዛ</para>
  <para style="q2" vid="LAM 1:6">ዎልቃ ዔያቶኮ ጋፒ ላባንዳያ ሄላንዳኣና ዔያታ ጳሽኪ ፑኔኔ።<verse eid="LAM 1:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 1:7"/>ዬሩሳላሜ ዴራ ካራ ባይዚ ሜታዺ ዋኣዪንታ ዎዶና</para>
  <para style="q2" vid="LAM 1:7">ሃያኮ ቤርታ ዔያቶኮ ዓኣ ባኮ ማሊ ጶቂሣንዳኔ፤</para>
  <para style="q2" vid="LAM 1:7">ዔያታ ሞርኮ ኩጮ ጋሮ ጌላዛ</para>
  <para style="q2" vid="LAM 1:7">ዔያቶ ማኣዳ ዓሲ ባኣያ ማዓዛ</para>
  <para style="q2" vid="LAM 1:7">ሞርካ ዔያቶኮ ካታሞ ዶዒፆ ዛጋዖ ሚኢጬኔ።<verse eid="LAM 1:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="LAM 1:8"/>ዬሩሳላሜ ዼኤፒ ጎሜ ማዼኔ፤</para>
  <para style="q2" vid="LAM 1:8">ዬያሮ ዒዛ ዒኢቴያ ማዔኔ፤</para>
  <para style="q2" vid="LAM 1:8">ዒዛ ዑፆ ካላዺ ዓኣንቴ ዔያታ ዛጌሢሮ</para>
  <para style="q2" vid="LAM 1:8">ቦንቻ ዓሳ ቢያ ቦሂ ዒዞ ቶኦቻኔ፤</para>
  <para style="q2" vid="LAM 1:8">ዓኣፖ ካሮዋ ዔያቶ ቤርታፓ ዚኢሊንቲ ዒዛ ሺርሼኔ።<verse eid="LAM 1:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="LAM 1:9"/>ሻቱማ<note caller="+" style="f"><char style="fr" closed="false">1፡9 </char><char style="fq" closed="false">ሻቱማ፦ </char><char style="ft" closed="false">ዬኖ ጌይንቴሢ ዬሩሳላሜኮ ጎሞ ዔርዛ ማላታ ማሂኬ።</char></note> ዒዞኮ ማኣዓሢዳ ጴዼኔ፤</para>
  <para style="q2" vid="LAM 1:9">ሃጋ ዒዞ ዓይጌ ሄላንዳቴያ ዒዛ ማሊባኣሴ፤</para>
  <para style="q2" vid="LAM 1:9">ዒዞኮ ሎኦሚፃ ዓሲኮ ዑስካ ጌላያኬ፤</para>
  <para style="q2" vid="LAM 1:9">ዒዞ ዶዲሻ ዓሲያኣ ፔቴታዖ ባኣሴ፤</para>
  <para style="q2" vid="LAM 1:9">ሞርካ ዒዞ ባሼሢሮ</para>
  <para style="q2" vid="LAM 1:9">ዬያ ሜቶ ዒዞኮ ዛጋንዳጉዲ ናንጊና ናንጋ ጎዳ ዒዛ ሺኢቄኔ።<verse eid="LAM 1:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 1:10"/>ዬሩሳላሜ ዴሮኮ ዼኤፒ ቦንቺንታያ ማዔ ቆሎ ሞርካ ጌሊ ቡሬኔ፤</para>
  <para style="q2" vid="LAM 1:10">ናንጊና ናንጋ ጎዳ ዴሮ ባኣኮ ጌሉዋጉዲ ላኣጊንቴ</para>
  <para style="q2" vid="LAM 1:10">ሜሌ ዓሳታዎ ዓቱዋዖ</para>
  <para style="q2" vid="LAM 1:10">ጌኤዦ ማኣሮ ጌላንቴ ዒዛ ዴንቄኔ።<verse eid="LAM 1:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="LAM 1:11"/>ዴራ ዒዞኮ ሙዖንዶ ባኣዚ ባይዚ ዒላቲዳኬ፤</para>
  <para style="q2" vid="LAM 1:11">ዔያታ ሃይቁዋዖ ሼምፔና ናንጋኒ</para>
  <para style="q2" vid="LAM 1:11">ፔኤኮ ዓኣ ቆሎ ቢያ ሙኡዚና ዖኦካኔ፤</para>
  <para style="q2" vid="LAM 1:11">ዬሩሳላሜ ዴራ «ናንጊና ናንጋ ጎዳሢዮ! ኑም ማሌ!</para>
  <para style="q2" vid="LAM 1:11">ኑኡኮ ዻውሲንቶ ቢያ ዛጌ!» ጌይ ዒላታኔ።<verse eid="LAM 1:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 1:12"/>ናንጊና ናንጋ ጎዳ ፔኤኮ ዼኤፖ ዻጎ ኑጊዳ ጮኦሽኬ ኬሎና</para>
  <para style="q2" vid="LAM 1:12">ኑና ሄሌ ሜቶጉዴያ</para>
  <para style="q2" vid="LAM 1:12">ሜታ ሄሌ ዓሲ ዓኣቶ</para>
  <para style="q" vid="LAM 1:12">ሂንዳ ዒንሢ</para>
  <para style="q2" vid="LAM 1:12">ጎይፆና ሴካ ሃንጋ ሃንታ ዓሳ ዛጉዋቴ!</para>
  <para style="q2" vid="LAM 1:12">ዬይ ባካ ዒንሢም ሼሌዔ ባኣዚ ማላ?<verse eid="LAM 1:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 1:13"/>«ሎኦፓ ታሚ ዒዚ ኬይሴኔ፤</para>
  <para style="q2" vid="LAM 1:13">ዬይ ታማ ሚቺ ሜጌፆ ጋሮ ኑኡኮ ዴንዴኔ፤</para>
  <para style="q2" vid="LAM 1:13">ቶኮም ኑኡኮ ቡኡዶ ፒሮ ፒሬኔ፤</para>
  <para style="q2" vid="LAM 1:13">ጊንሢም ኑና ጎቺ ማሄኔ፤</para>
  <para style="q2" vid="LAM 1:13">ዒኖ ኑኡኮ ባይዚ ፔቴ ኬሊ ጉቤ ዑፆ ኑኡኮ ዶጪሴኔ።»<verse eid="LAM 1:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="LAM 1:14"/>«ዻቢንታ ታኣኮ ዎሊ ዑፃ ዳፂንቲ</para>
  <para style="q2" vid="LAM 1:14">ባቃኖይዳ ቃንባራጉዲ ጌሢንቴኔ፤</para>
  <para style="q2" vid="LAM 1:14">ዬይ ሚርጌ ዴኤፃያ ማዔሢሮ ዎልቄ ኑኡኮ ባይዜኔ፤</para>
  <para style="q2" vid="LAM 1:14">ኑኡኒ ቃዛኒ ዳንዳዑዋ ኑኡኮ ሞርኮም ዒዚ ኑና ዔኪ ዒንጌኔ።»<verse eid="LAM 1:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="LAM 1:15"/>«ኑና ካፓ ፖኦሊሶ ናንጊና ናንጋ ጎዳ ዒፂ፥ ዔኪ ሺኢሼኔ፤</para>
  <para style="q2" vid="LAM 1:15">ኑኡኮ ዼጌሢኮ ዎልቆ ጋኣጫኒ ዖልዚ ዓሲ ኑጊዳ ዳኬኔ፤</para>
  <para style="q2" vid="LAM 1:15">ዖኦኒያ ጫርቂ ጌሊ ቤቂባኣ ካታሞይዳ ናንጋ ኑኡኮ ዴሮ</para>
  <para style="q2" vid="LAM 1:15">ዎይኖ ጩኡጶ ቤዛ ሄርቂንታ ዎይኔጉዲ ሄርቂ ዒዚ ዳኣፄኔ።»<verse eid="LAM 1:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="LAM 1:16"/>«ሞርካ ኑና ባሼሢሮ ናኣቶም ኑኡኮ ካራ ባይቄኔ፤</para>
  <para style="q2" vid="LAM 1:16">ኑና ዶዲሻ ዓሲ ባይቄሢሮ</para>
  <para style="q2" vid="LAM 1:16">ዓቢሢ ላኣሊ ላኣሊ ኑኡኒ ዬኤካኔ።»<verse eid="LAM 1:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="LAM 1:17"/>«ፂዮኔ ኩጮ ፔኤኮ ሌካ ዔቂሴኔ፤</para>
  <para style="q2" vid="LAM 1:17">ጋዓንቴ ዒዞ ማኣዳ ዓሲያኣ ባኣሴ፤</para>
  <para style="q2" vid="LAM 1:17">ዓሺኖ ማዔ ዓጮይዳ ዓኣ ዓሳ ቢያ ያይቆኦቤ ዜርፆኮ</para>
  <para style="q2" vid="LAM 1:17">ሞርኬ ማዓንዳጉዲ ናንጊና ናንጋ ጎዳ ዓይሤኔ፤</para>
  <para style="q2" vid="LAM 1:17">ዬሩሳላሜ ዔያቶ ባኣካ ዒኢቴ ባኣዚ ማዔኔ።»<verse eid="LAM 1:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="LAM 1:18"/>«ዒዚ ዓይሤ ባኮ ዔያታ ዋይዞ ዒፄሢሮ</para>
  <para style="q2" vid="LAM 1:18">ዒ ማዼ ባኮና ናንጊና ናንጋ ጎዳ ዻቢንቲባኣሴ፤</para>
  <para style="q2" vid="LAM 1:18">ዒንሢ ዴራ ቢያ ዋይዙዋቴ፥ ሜቶዋ ታኣኮ ዛጉዋቴ፤</para>
  <para style="q2" vid="LAM 1:18">ዼጌ ማዔ ዓቲንቆንታ ዉዱራሢንታ ታኣኮ ዲዒንቲ ዔውቴኔ።»<verse eid="LAM 1:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="LAM 1:19"/>«ታኣኮ ላጎ ታኣኒ ዔኤሌኔ፤</para>
  <para style="q2" vid="LAM 1:19">ዔያታ ጋዓንቴ ታና ዒፄኔ።</para>
  <para style="q2" vid="LAM 1:19">ቄኤሶንታ ሱኡጎንታ ቢያ ፔኤኮ ሼምፓሢ ዓውሳኒ</para>
  <para style="q2" vid="LAM 1:19">ሙዖ ኮይፆይዳ ዓኣዖ ዒኢካ ካታሞ ሳዛ ጎይፆይዳ ሃይቄኔ።»<verse eid="LAM 1:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="LAM 1:20"/>«ናንጊና ናንጋ ጎዳሢዮ!</para>
  <para style="q2" vid="LAM 1:20">ታኣኒ ካራ ባይቂ ሜታዺ ዋኣዪሢዳ ዓኣሢ ኔ ዛጉዋዓዳ?</para>
  <para style="q2" vid="LAM 1:20">ታኣኒ ኔኤም ዋይዞ ዒፄሢሮ ጎጳ ታኣኮ ዋኣፄኔ፥ ዒናኣ ታኣኮ ዖዬኔ፤</para>
  <para style="q2" vid="LAM 1:20">ካታሞ ሳዛ ዓኣ ጎይፆይዳ ማዖም ኬኤፆይዳ ዴራ ታኣኮ ሃይቂ ኩዳኔ።»<verse eid="LAM 1:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="LAM 1:21"/>«ታኣኒ ሜታዺ ዬኤካ ዬኤፖ ዓሳ ዋይዜኔ፤</para>
  <para style="q2" vid="LAM 1:21">ጋዓንቴ ታና ዶዲሻ ዓሲ ፔቴታዖ ባኣሴ፤</para>
  <para style="q2" vid="LAM 1:21">ታኣኒ ካራ ባይዚ ዋኣዪንታሢ ሞርካ ቢያ ዋይዜኔ፤</para>
  <para style="q2" vid="LAM 1:21">ኔ ማዼ ባኮ ዛሎና ዔያታ ዎዛዼኔ፤</para>
  <para style="q2" vid="LAM 1:21">ሃዳራ ኔኤኒ ጌዔ ኬሌላ ዬዖንጎ፤</para>
  <para style="q2" vid="LAM 1:21">ዔያቶይዳኣ ታና ሄሌ ባኮጉዴያ ሄሎንጎ።»<verse eid="LAM 1:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="LAM 1:22"/>«ዔያቶኮ ፑርቶ ማዾ ቢያ ዛጌ፤</para>
  <para style="q2" vid="LAM 1:22">ታኣኮ ዻቢንቶ ቢያሢሮ ኔኤኒ ታጊዳ ሄሊሴ</para>
  <para style="q2" vid="LAM 1:22">ፑርቶ ባኮጉዴያ ዔያቶይዳኣ ሄሊሴ፤</para>
  <para style="q2" vid="LAM 1:22">ታኣኮ ሜቶ ዬኤፓ ዺቤኔ፥ ዒናኣ ታኣኮ ላቤኔ።»<verse eid="LAM 1:22"/></para>
  <chapter eid="LAM 1"/>
  <chapter number="2" style="c" sid="LAM 2"/>
  <para style="s1">ናንጊና ናንጋ ጎዳ ዬሩሳላሜይዳ ዓጌ ሜቶ</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 2:1"/>ናንጊና ናንጋ ጎዳ ፔ ዻጎና ፂዮኔ ዻውሲሴኔ፤</para>
  <para style="q2" vid="LAM 2:1">ጫሪንጮ ሌካ ኬስኪ ዼጊ ጌይ ዴዔዞ</para>
  <para style="q2" vid="LAM 2:1">ዒስራዔኤሌኮ ሄርሺንቶዞ ዒዚ ሳዓ ጎቺ ዔኪ ኬኤሬኔ፤</para>
  <para style="q" vid="LAM 2:1">ዒዚ ዻጋዼ ዓቦና ዒዛኮ ቶካ ሄርቃ ቤዜሎ</para>
  <para style="q2" vid="LAM 2:1">ዔኤቢኬያ ጌይ ሺሪ ዛጊባኣሴ።<verse eid="LAM 2:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="LAM 2:2"/>ናንጊና ናንጋ ጎዳ ዒስራዔኤሌኮ ናንጎ ቤዞ ቢያ ሚጪንቱዋዖ ባይዜኔ፤</para>
  <para style="q2" vid="LAM 2:2">ዒዚ ዻጋዺ ዪሁዳ ዴሮኮ ዋርዲዮ ሻሄኔ፤</para>
  <para style="q2" vid="LAM 2:2">ዒኢካ ዓኣ ካኣቶና ቢታንታ ዓኣ ዓሶና ሳዓ ዔኪ ዢቢ ዻውሲሴኔ።<verse eid="LAM 2:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="LAM 2:3"/>ዒዛኮ ዼኤፖ ዻጎና ዒስራዔኤሌኮ ዎልቆ ቢያ ላቢሴኔ፤</para>
  <para style="q2" vid="LAM 2:3">ሞርካ ዒስራዔኤሌይዳ ሙካኣና ዒዚ ዔያቶ ማኣዶ ሃሺ</para>
  <para style="q2" vid="LAM 2:3">ያይቆኦቤ ዜርፆይዳ ፔኤኮ ዻጎ ታሞ ዔኤሤኔ፤</para>
  <para style="q2" vid="LAM 2:3">ኮይላ ዓኣ ባኮ ቢያ ሙዓ ታሚጉዲ ሙዔኔ።<verse eid="LAM 2:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="LAM 2:4"/>ዒዚ ሞርኬጉዲ ሂኢዦና ፔኤኮ ኑና ዱካኒ ዓኣሤኔ፤</para>
  <para style="q2" vid="LAM 2:4">ዒዛኮ ሚዛቆ ኩጫ ኑና ማኣሳንሣኒ ጊኢጌኔ፤</para>
  <para style="q2" vid="LAM 2:4">ዬሩሳላሜይዳ ዓኣ፥ ኑኡኒ ናሽካ ዓሶ ቢያ ዒ ዎዼኔ፤</para>
  <para style="q2" vid="LAM 2:4">ፔኤኮ ዻጎ ታሚጉዲ ዒዚ ዔኤሤኔ።<verse eid="LAM 2:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="LAM 2:5"/>ናንጊና ናንጋ ጎዳ ሞርኬጉዲ ማዒ ዒስራዔኤሌ ባይዜኔ፤</para>
  <para style="q2" vid="LAM 2:5">ካኣቱሞ ማኣሮዋ ዶይሲ ኩርሴኔ።</para>
  <para style="q" vid="LAM 2:5">ዋርዲዮ ሻሄኔ፤</para>
  <para style="q2" vid="LAM 2:5">ዪሁዳ ዴሮይዳ ዬኤፒና ዒላቲና ዺቢሼኔ።<verse eid="LAM 2:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="LAM 2:6"/>ናንጊና ናንጋ ጎዳ ፔኤኮ ጌኤዦ ማኣሮ ጎሺዳ ዓኣ ዉልሻጉዲ ሻሄኔ፤</para>
  <para style="q2" vid="LAM 2:6">ፂዮኔይዳ ቦንቾ ቦንቾንታ ሃውሾ ኬሎዋ ዓይሴኔ፤</para>
  <para style="q2" vid="LAM 2:6">ፔኤኮ ዼኤፖ ዻጎና ካኣቲንታ ቄኤሶዋ ዻውሲሴኔ።<verse eid="LAM 2:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="LAM 2:7"/>ናንጊና ናንጋ ጎዳ ዒዛም ዒንጎ ባኮ ዒንጎ ቤዞ ቦሄኔ፤</para>
  <para style="q2" vid="LAM 2:7">ፔኤኮ ጌኤዦ ማኣሮዋ ሃሼኔ።</para>
  <para style="q2" vid="LAM 2:7">ካኣቱሞ ማኣሮኮ ኬኤሎ ዲፆ ሞርካ ዶይሳንዳጉዲ</para>
  <para style="q2" vid="LAM 2:7">ዒዚ ዓኣሢ ሞርኮም ዒንጌኔ፤</para>
  <para style="q2" vid="LAM 2:7">ዬያሮ ሞርካ ቦንቾ ኬሊና ማዺንታ ጎይሢ</para>
  <para style="q2" vid="LAM 2:7">ጌኤዦ ማኣሮይዳ ዎዛና ኮርጌኔ።<verse eid="LAM 2:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="LAM 2:8"/>ናንጊና ናንጋ ጎዳ ዬሩሳላሜ ካታሞኮ ኬኤሎ ዲፆ ሻሃኒ ጊኢጊ</para>
  <para style="q2" vid="LAM 2:8">ሚፆ ሱዞ ሊካ ኬይሴኔ፤</para>
  <para style="q" vid="LAM 2:8">ካታሜሎ ባይዚፃፓ ጊንሢም ጌይባኣሴ፤</para>
  <para style="q2" vid="LAM 2:8">ካታሞ ካፖ ዼጌ ኬኤሎ ዲፃኣ ዹኡቂ ሻሂንቴኔ፤</para>
  <para style="q2" vid="LAM 2:8">ዬይ ቢያ ፔቴና ዶዔኔ።<verse eid="LAM 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 2:9"/>ካታሞ ጌሎ ካሮ ዎዾ ካራ ሳዖ ዴማ ዱኡኪንቴኔ፤</para>
  <para style="q2" vid="LAM 2:9">ኮምባልቂ ዎዾ ጋጋርዛኣ ሜቂ ሜቂ ጋፔኔ፤</para>
  <para style="q2" vid="LAM 2:9">ካኣቲንታ ዒዚ ቢታንቶ ዒንጌ ሱኡጎንታ</para>
  <para style="q2" vid="LAM 2:9">ሜሌ ዴሮ ባኣኮይዳ ዳውሲንቲ ዴንዲ ዓኣኔ፤</para>
  <para style="q2" vid="LAM 2:9">ሙሴ ዔርዜ ዎጎ ሃካፓ ሴካ ኬኤዚ ዔርዛ ዓሲ ባኣያ ማዓንዳኔ፤</para>
  <para style="q2" vid="LAM 2:9">ፆኦሲ ማሊፆ ኬኤዛ ዓሶም ሃካፓ ሴካ ናንጊና ናንጋ ጎዳ ፔጋሲ ዻዋንዳ ባኣዚ ባኣሴ።<verse eid="LAM 2:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="LAM 2:10"/>ዬሩሳላሜ ካታሞይዳ ዓኣ ጋርቻ ሳዓ ዚቲ ጌይ ዴዔኔ፤</para>
  <para style="q2" vid="LAM 2:10">ዔያታ ፔኤኮ ቶኦኮይዳ ሲላሊ ዋሂ፥ ሲዬ ፓቲሌያ ማኣዔኔ፤</para>
  <para style="q2" vid="LAM 2:10">ዒኢካ ካታሞይዳ ዓኣ ዉዱሮ ናኣታ ካራ ባይዚ ሳኣ ዛጌኔ።<verse eid="LAM 2:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="LAM 2:11"/>ዴሮ ታኣኮ ዎዺ ኩርሶናሢሮ</para>
  <para style="q2" vid="LAM 2:11">ናኣታ ካታሞ ሳዞ ጎይፆይዳ ላቢ ሎኦማሢሮ</para>
  <para style="q2" vid="LAM 2:11">ዬኤኬ ጎይሣ ዓኣፓ ታኣኮ ዶጬኔ፤</para>
  <para style="q2" vid="LAM 2:11">ጎጳኣ ታኣኮ ዋኣፄኔ፥ ሃጊ ማዓ ዎዛኣ ታኣኮ ባኣያ ማዔኔ።<verse eid="LAM 2:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="LAM 2:12"/>ዖልዚ ቦኦሊዳ ዱኡቴ ፖኦሊሴጉዲ</para>
  <para style="q2" vid="LAM 2:12">ካታሞ ሳዞ ጎይፆይዳ ላቢ ሎኦሚ ላሂ ላሂ</para>
  <para style="q2" vid="LAM 2:12">ዒንዶንሢኮ ቃሶይዳ ጌኤቂንቲ ዴዒ</para>
  <para style="q2" vid="LAM 2:12">«ዒንዴ! ሙኡዚ፥ ዋኣሢ ዒንጌ» ጌይ ዬኤኪ ዬኤኪ</para>
  <para style="q2" vid="LAM 2:12">ሼምፓሢ ዔያቶኮ ዬያይዲ ዱጲ ጋፓኔ።<verse eid="LAM 2:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="LAM 2:13"/>ታ ዎዚ ጎዖንዶይ? ዓይጎና ታ ዒንሢ ሄካሳኒ ዳንዳዓይ?</para>
  <para style="q2" vid="LAM 2:13">ታኣኒ ናሽካ፥ ዬሩሳላሜ ካታሞ ዴራ!</para>
  <para style="q2" vid="LAM 2:13">ታ ዒንሢ ዶዲሻኒ ዓይጎና ታ ዒንሢ ቤቂሶንዶይ?</para>
  <para style="q2" vid="LAM 2:13">ዒንሢ፥ ዬሩሳላሜ ካታሞ ዴራ!</para>
  <para style="q2" vid="LAM 2:13">ዒንሢዳ ሄላንዳ ባይሲንታ ዳልጎ ባዞጉዲ ዼኤፒታሢሮ</para>
  <para style="q2" vid="LAM 2:13">ዖኦኒ ዒንሢ ዓውሳኒ ዳንዳዓይ?<verse eid="LAM 2:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="LAM 2:14"/>ዒንሢም ሎንሦ ኬኤዛ ዓሳ ዒንሢም ሉኡቂ፥ ሃሣ ዒንሢ ጌጌሼኔ፤</para>
  <para style="q2" vid="LAM 2:14">ዔያታ ሉኡዚ፥ ሃሣ ዻዻቢሻ ሎንሦ ዒንሢም ኬኤዜኔ፤</para>
  <para style="q2" vid="LAM 2:14">ዒንሢም ጊኢጊ ዓኣ ፑርቶ ባካፓ ዒንሢ ማሃኒ</para>
  <para style="q2" vid="LAM 2:14">ዒንሢኮ ዻቢንቶ ዒንሢም ፔጋሲ ኬኤዚባኣሴ።<verse eid="LAM 2:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="LAM 2:15"/>« ‹ኮሺ ሚዛጲኬ› ጎዖዛ፥ ዓጮ ዴራ ቢያ</para>
  <para style="q2" vid="LAM 2:15">ዒኢካ ሙኪ ዎዛዻዛ፥ ሃኖ ካታሜሎዳ?»</para>
  <para style="q2" vid="LAM 2:15">ጌይ ጌይ ጎይፆና ዴንዳ ዓሳ ቢያ</para>
  <para style="q2" vid="LAM 2:15">ዬሩሳላሜ ዛጋ ዓሳ ቦሂሢና ኩቺ ባዒ ባዒ</para>
  <para style="q" vid="LAM 2:15">ቶኦኮዋ ፔኤኮ ዓጊሢ ዓጊሢ ሚኢጫንዳኔ።<verse eid="LAM 2:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 2:16"/>ዒንሢኮ ሞርካ ቢያ ዒንሢ ጫሽኪ ጫሽኪ ሚኢጪ ዓማላኔ፤</para>
  <para style="q2" vid="LAM 2:16">ዒንሢ ቶኦቺ፥ ዓጮ ፔኤኮ ዻዓኔ፤</para>
  <para style="q2" vid="LAM 2:16">ሂዚ ጌይያኣ ዒላታኔ፦ «ኑ ዔያቶ ኩርሲናኣኮኬ!</para>
  <para style="q2" vid="LAM 2:16">ሂዮ! ሃይማ ኑ ማሊ ሃይቃ ኬሎማዋይ!</para>
  <para style="q2" vid="LAM 2:16">ጋፒንሢ ዑስካ ኑ ዓካሪ ዴንቄያኣዋይ።»<verse eid="LAM 2:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="LAM 2:17"/>ናንጊና ናንጋ ጎዳ ማሌ ባኮ ማዺ ኩንሤኔ፤</para>
  <para style="q2" vid="LAM 2:17">ቤርታ ዒዚ ኬኤዜ ቃኣሎ ማዾይዳ ፔኤሼኔ፤</para>
  <para style="q2" vid="LAM 2:17">ሚርጌ ዎዴኮ ቤርታ ዒ ማሊ ቱኬ ጎይፆ ማኣሚቃይዶ ሻሄኔ፤</para>
  <para style="q2" vid="LAM 2:17">ሞርካ ዒንሢኮ ካሮ ባይዚፆና ዎዛዻንዳጉዲ ዒ ማሄኔ፤</para>
  <para style="q2" vid="LAM 2:17">ዒንሢ ሞርኮኮ ዎልቆ ዒዚ ዶዲሼኔ።<verse eid="LAM 2:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="LAM 2:18"/>ዬሩሳላሜ ዴሬዮቴ! ዒንሢኮ ዒላታ</para>
  <para style="q2" vid="LAM 2:18">ኬኤሎ ዲፆይዳ ማኣሞንጎ!</para>
  <para style="q2" vid="LAM 2:18">ናንጊና ናንጋ ጎዳ ዋይዛንዳጉዲ ዒላቱዋቴ!</para>
  <para style="q2" vid="LAM 2:18">ዓቢፃ ዒንሢኮ ዋንቶንታ ሮኦሮንታ ቢያ ዲጲጉዲ ዎቶንጎ፤</para>
  <para style="q2" vid="LAM 2:18">ፔቴታዖ ሃውሺፖቴ፤ ዓኣፓ ዬኤፖ ሃሻንዳጉዲ ዚቲ ጌይፖቴ።<verse eid="LAM 2:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="LAM 2:19"/>ዹሞና ዎዶ ካፒ ዔቂ ዔቂ ዒላቲ ዒላቱዋቴ፤</para>
  <para style="q2" vid="LAM 2:19">ዒንሢም ማሊንታ ባኮ ቢያ ናንጊና ናንጋ ጎዳም ኬኤዙዋቴ፤</para>
  <para style="q2" vid="LAM 2:19">ካታሞ ሳዛ ዎላ ካኣማ ጎይፆይዳ ናይዺ ላቢንቲ ሎኦማ ናኣቶ ሼምፓሢም</para>
  <para style="q2" vid="LAM 2:19">ናንጊና ናንጋ ጎዳ ሺኢቂ፥ ኩጮ ዒንሢኮ ሌካ ዔቂሱዋቴ።<verse eid="LAM 2:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="LAM 2:20"/>ናንጊና ናንጋ ጎዳሢዮ! ሃዳራ ኑና ዛጌ!</para>
  <para style="q2" vid="LAM 2:20">ሃያኮ ቤርታ ሃያይዲ ኔኤኒ ዙሌ ዻዌ ዴሬ ዓኣኖ?</para>
  <para style="q2" vid="LAM 2:20">ላኣላ ፔኤኮ ሾይ ዲቼ ናኣቶ ሙዔንቴሞ!</para>
  <para style="q2" vid="LAM 2:20">ፆኦሲኮ ጌኤዦ ማኣሮይዳ ቄኤሶንታ</para>
  <para style="q2" vid="LAM 2:20">ፆኦሲ ማሊፆ ኬኤዛ ዓሶንታ ዎዺንቴንቴሞ!<verse eid="LAM 2:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="LAM 2:21"/>ዼጌሢንታ ጋርቾንታ ዒማ ጎይፆ ዎዺንቲ ጎይፃ ኬኤሪንቴኔ፤</para>
  <para style="q2" vid="LAM 2:21">ዼጌ ዓቲንቆንታ ዉዱራሢንታ ሞርኮኮ ጬንቾ ዓራፓ ዎዺ ኩርሴኔ፤</para>
  <para style="q2" vid="LAM 2:21">ኔኤኒ ዻጋዼ ዓቦና ማኣሚቃይዶ ኔ ዔያቶ ሹኪሲሴኔ።<verse eid="LAM 2:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="LAM 2:22"/>ቦንቾ ኬሊና ሙኡዚሮ ዔኤሎጉዲ ሞርኮ ቢያ ቤዛፓ ኔኤኒ ዔኤሌኔ፤</para>
  <para style="q2" vid="LAM 2:22">ኔኤኒ ዻጋዼ ዓቦና ፔቴታዖ ሼምፔና ቶሊ ዓቴ ዓሲ ባኣሴ፤</para>
  <para style="q2" vid="LAM 2:22">ታኣኒ ሾይ ዲቼ ናኣቶ ሞርካ ዎዺ ኩርሴኔ።<verse eid="LAM 2:22"/></para>
  <chapter eid="LAM 2"/>
  <chapter number="3" style="c" sid="LAM 3"/>
  <para style="s1">ጎሜ ቡኡፂሢና ዻቆ ዻቂንታ</para>
  <para style="p">
    <verse number="1" style="v" sid="LAM 3:1"/>ፆኦሲኮ ዻጎ ኮኦሎና ጳዺንቲ ሜቶ ዛጌ ዓሲ ታናኬ።<verse eid="LAM 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 3:2"/>ዒዚ ፔ ቤርታፓ ታና ፔቴታዖ ፖዒባኣ</para>
  <para style="q2" vid="LAM 3:2">ዹሚ ቤሲ ዳውሲ ዳኬኔ።<verse eid="LAM 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 3:3"/>ኬስኬ ዓባ ጌሊ ካራንዳኣና</para>
  <para style="q2" vid="LAM 3:3">ታና ሌሊ ዒዚ ጳርቄ ጎይሣ ዴዔኔ።<verse eid="LAM 3:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="LAM 3:4"/>ዒዚ ታኣኮ ዑፆ ዓሽኮንታ ዒልዖንታ ጋርቺሴኔ፤</para>
  <para style="q2" vid="LAM 3:4">ሜጌፆዋ ታኣኮ ሜንሤኔ።<verse eid="LAM 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 3:5"/>ዒናፓ ዻጋሳ ዻጋና ላቢሢና ታጊዳ ዳኪ ታና ማንጊሴኔ።<verse eid="LAM 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 3:6"/>ሃይቄዖ ሚርጌ ናንጌ ዓሲጉዲ</para>
  <para style="q2" vid="LAM 3:6">ዹሚዳ ታና ዴይሢ ሃሼኔ።<verse eid="LAM 3:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="LAM 3:7"/>ኮይሎ ታኣኮ ዒዚ ዲርቄሢሮ ቶላኒ ታ ዳንዳዒባኣሴ፤</para>
  <para style="q2" vid="LAM 3:7">ካኒ ቢራታና ታና ዒ ቱኬኔ።<verse eid="LAM 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 3:8"/>ታና ዒ ማኣዶም ታኣኒ ዒላቴቴያ</para>
  <para style="q2" vid="LAM 3:8">ታኣሲ ዋይዛኒ ዒዚ ኮዒባኣሴ።<verse eid="LAM 3:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 3:9"/>ጎይፆ ታኣኮ ዓርሲንቴ ዼኤፒ ዼኤፒ ሹቺና ዲርቄኔ፤</para>
  <para style="q2" vid="LAM 3:9">ታኣኒ ዴንዳ ካሮዋ ሺርሺ ዎቢሴኔ።<verse eid="LAM 3:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="LAM 3:10"/>ዒዚ ታና ሙዓኒ ካቲ ዓኣ ዲቤ ጌይንታ ቦዖጉዲ፤</para>
  <para style="q2" vid="LAM 3:10">ጊንሣ ሃሣ ታና ዎዻኒ ጊኢጊ ዔቄ ዞቢ ማዔኔ።<verse eid="LAM 3:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 3:11"/>ጎይፃፓ ታና ጎቺ ዔኪ ሺኢሺ ሾኦሌኔ፤</para>
  <para style="q2" vid="LAM 3:11">ታና ማኣዳያኣ ባኣያ ማሂ ሃሺ ዴንዴኔ።።<verse eid="LAM 3:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 3:12"/>ፔ ሂኢዦና ታና ዱካኒ ዓኣሤኔ፤</para>
  <para style="q2" vid="LAM 3:12">ሆቲና ታና ዱኪ ዓይዲሳኒ ዒ ጊኢጌኔ።<verse eid="LAM 3:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="LAM 3:13"/>ሂኢዦና ሳዞ ታኣኮ ቂርፂዲ ዱኬኔ።<verse eid="LAM 3:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 3:14"/>ታ ዴሮኮ ታኣኒ ሚኢቺ ባኣዚ ማዔኔ፤</para>
  <para style="q2" vid="LAM 3:14">ዔያታ ኮርጋ ኬሎ ዴንዲ ዚሮ ሄላንዳኣና ታና ቦሂ ቦሂ ኮርጋኔ።<verse eid="LAM 3:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 3:15"/>ሜቶ ታጊዳ ዺቢሲ ናንጎ ታኣኮ ጫንቂሴኔ፤</para>
  <para style="q2" vid="LAM 3:15">ታና ዒዚ ዋላንጋ ላይሲ ሚሼኔ።<verse eid="LAM 3:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="LAM 3:16"/>ቃንፆ ታና ዻይሲ ዓጮ ታኣኮ ሜንሤኔ፤</para>
  <para style="q2" vid="LAM 3:16">ሳዖ ሲላሎይዳኣ ታና ሂዒ ኬኤሬኔ።<verse eid="LAM 3:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 3:17"/>ታኣኮ ሼምፓሢ ኮሹሞ ጋዓ ባኣዚ ዴንቃኒ ዳንዳዒባኣሴ፤</para>
  <para style="q2" vid="LAM 3:17">ዎዛ ጎዖ ባኣዚ ዓይጎታቴያ ታኣም ጶቁዋሴ።<verse eid="LAM 3:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 3:18"/>ዬያሮ ታኣኒ፦ «ቦንቻ ታጊዳፓ ዴንዲ ባይቄኔ፤</para>
  <para style="q2" vid="LAM 3:18">ናንጊና ናንጋ ጎዳ ታኣም ሃጊ ዒንጋንዳኣዋይ ታ ጋዓ ባካ ቢያ</para>
  <para style="q2" vid="LAM 3:18">ሙኪ ታና ሄላ ካራ ባኣያ ማዒ ዓቴኔ» ጌዔኔ።<verse eid="LAM 3:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="LAM 3:19"/>ታኣኮ ሜቶና ካሮ ባይቂፆና ዛሎ ማሊፃ</para>
  <para style="q2" vid="LAM 3:19">ዓዳ ዋላንጋና ጪሼናጉዲ ታኣም ጫንቄኔ።<verse eid="LAM 3:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 3:20"/>ዬያ ዛሎ ቢያ ዎዴ ታኣኒ ማላኣና</para>
  <para style="q2" vid="LAM 3:20">ዒና ታኣኮ ኮሺ ዖያኔ።<verse eid="LAM 3:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 3:21"/>ጋዓንቴ ፔቴ ታኣኒ ማላ ባኣዚ ዓኣኔ፤</para>
  <para style="q2" vid="LAM 3:21">ዬኖ ታ ማላማና ሃጊ ማዓንዳ ዎዛና ዒና ታኣኮ ሃውሻኔ።<verse eid="LAM 3:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="LAM 3:22"/>ዬና ዓይጎዳይ ጌዔቴ፦</para>
  <para style="q2" vid="LAM 3:22">ኑኡኒ ባይቁዋዖ ሼምፔና ዓቲ ዓኣሢ</para>
  <para style="q2" vid="LAM 3:22">ናንጊና ናንጋ ጎዳኮ ሚጪንቲፃ ፔቴታዖ ጋፑዋያ</para>
  <para style="q2" vid="LAM 3:22">ናሹማኣ ናንጊና ናንጋያ ማዔሢሮኬ።<verse eid="LAM 3:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="LAM 3:23"/>ዬይ ሚጪንቲፃ ኬላ ኬላ ዓካዻኔ፤</para>
  <para style="q2" vid="LAM 3:23">ናንጊና ናንጋ ጎዳ ማዔ ኔኤኮ ጉሙርቂንቲፃ ዼኤፒኬ።<verse eid="LAM 3:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="LAM 3:24"/>ናንጊና ናንጋ ጎዳ ታኣኮ ጊሽኮና ጊሺ ማዔሢሮ</para>
  <para style="q2" vid="LAM 3:24">ዒዛ ሌሊ ታኣኒ ጉሙርቃንዳኔ።<verse eid="LAM 3:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="LAM 3:25"/>ዒዛ ጉሙርቂ ሃጋኣ ዎዛ ዒዛይዳ ጌሣዞንሢና</para>
  <para style="q2" vid="LAM 3:25">ዒዛ ኮዓዞንሢናም ዒዚ ኮሺኬ።<verse eid="LAM 3:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="LAM 3:26"/>ዓሲ ዚቲ ጋዓዖ ናንጊና ናንጋ ጎዳ ዻቂሻ ዻቂሺፆ</para>
  <para style="q2" vid="LAM 3:26">ጉሙርቂ ካፔያታቴ ቃራኬ።<verse eid="LAM 3:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="LAM 3:27"/>ዓሲ ዼጌ ዓኣዖ ሜቶ ጊቢ</para>
  <para style="q2" vid="LAM 3:27">ዳንዳዒ ዔኬቴ ኮሺኬ።<verse eid="LAM 3:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="LAM 3:28"/>ናንጊና ናንጋ ጎዳ ዒዛይዳ ሜቶ ዓጋኣና</para>
  <para style="q2" vid="LAM 3:28">ዚቲ ጌይ ፔኤሮ ዒ ዴዔቴ ቃራኬ።<verse eid="LAM 3:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="LAM 3:29"/>ሃጊ ጊንሣ ኮሺ ባኣዚ ሙካኒ ዳንዳዓሢሮ</para>
  <para style="q2" vid="LAM 3:29">ሳዓ ባሊቲና ላሂ ናንጊና ናንጋ ጎዳም ዓይሢንቲ ዎርቆንጎ።<verse eid="LAM 3:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="LAM 3:30"/>ባዓሢም ጋንጋሮ ዻዊ ሃሾንጎ፤</para>
  <para style="q2" vid="LAM 3:30">ጫሺታቴያ ዔዔኮንጎ።<verse eid="LAM 3:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="LAM 3:31"/>ናንጊና ናንጋ ጎዳ ዬያ ቢያ ማዼቴያ</para>
  <para style="q2" vid="LAM 3:31">ናኣናና ኬንኬሊዲ ዓሲ ሃሹዋሴ።<verse eid="LAM 3:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="LAM 3:32"/>ዎዚ ዓሲዳ ፑርታ ባኣዚ ሄላንዳጉዲ</para>
  <para style="q2" vid="LAM 3:32">ዒዛ ማሊሢ ማዔቴያ</para>
  <para style="q2" vid="LAM 3:32">ዒዛኮ ዑሣ ዓኣዼ ዺቦ፥ ናንጊና ናንጋ ናሹሞና</para>
  <para style="q2" vid="LAM 3:32">ዓሲም ዒዚ ሚሚጪንታኔ።<verse eid="LAM 3:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="LAM 3:33"/>ዬይ ያዺ ማዓሢ ዒዚ ፔ ሼኔና</para>
  <para style="q2" vid="LAM 3:33">ዓሲዳ ሜቶና ዖዪሢና ሄሊሱዋኣሢሮኬ።<verse eid="LAM 3:33"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="34" style="v" sid="LAM 3:34"/>ዓጬሎይዳ ቢያ ቱኡቲ ዓኣ ዓሳ ቢያ</para>
  <para style="q2" vid="LAM 3:34">ጌኔ ጎይሢና ሄርቂንታሢ፥<verse eid="LAM 3:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="LAM 3:35"/>ዼኤፖ ፆኦዛሢ ዛጋንቴ</para>
  <para style="q2" vid="LAM 3:35">ዓሲኮ ቶኦኪ ባይዞሢ፥<verse eid="LAM 3:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="LAM 3:36"/>ፔቴ ዓሲኮ ጌኤሲ ዎቦ ጎይሢና ዎጊንታሢ</para>
  <para style="q2" vid="LAM 3:36">ጎኔና ናንጊና ናንጋ ጎዳ ሃያ ባኮ ዛጉዋዓዳ?<verse eid="LAM 3:36"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="37" style="v" sid="LAM 3:37"/>ናንጊና ናንጋ ጎዳ ቤርታ ማሊ ቱኪባኣ ባኣዚታቴ</para>
  <para style="q2" vid="LAM 3:37">ዒዛ ዓይሢ ፔቴ ባኣዚታዎ ማዺሻኒ ዳንዳዓ ዓሲ ዖናዳይ?<verse eid="LAM 3:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="LAM 3:38"/>ፑርታ ባኣዚታቴያ ኮሺ ባኣዚ ማዺንታሢ</para>
  <para style="q2" vid="LAM 3:38">ዼኤፖ ፆኦዛሢ ዓይሤምኬ።<verse eid="LAM 3:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="LAM 3:39"/>ሂዳዖ ዓካሪ ሼምፔና ዓኣ ዓሲ ፔ ጎሞና ሜቶ ዔካዖ</para>
  <para style="q2" vid="LAM 3:39">ጉንዱማሢ ዓይጎሮዳዖ?<verse eid="LAM 3:39"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="40" style="v" sid="LAM 3:40"/>ኑ ሃንታ ሃንቲፆ ማሂ ኑ ዛጎም፤</para>
  <para style="q2" vid="LAM 3:40">ናንጊና ናንጋ ጎዳ ባንሢ ኑ ማዖም።<verse eid="LAM 3:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="LAM 3:41"/>ኑኡኮ ዒኖ ኑ ኩጮና ዎላ ጫሪንጫ ዓኣ</para>
  <para style="q2" vid="LAM 3:41">ኑ ፆኦዛሢ ባንሢ ኑ ዔቂሲ፥ ሂዚ ኑ ጎዖም፦<verse eid="LAM 3:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="LAM 3:42"/>«ኑ ፆኦዛሢዮ! ኑኡኒ ኔኤም ዋይዞ ዒፂ</para>
  <para style="q2" vid="LAM 3:42">ጎሜ ማዼኔ፤ ኔኤኒ ኑና ማኣሪባኣሴ።»<verse eid="LAM 3:42"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="43" style="v" sid="LAM 3:43"/>«ዻጋዺ ፑኡካኒ ዑኪ ኑና ኔ ዳውሴኔ፤</para>
  <para style="q2" vid="LAM 3:43">ማኣሚቃይዶ ኑና ኔ ዎዼኔ።<verse eid="LAM 3:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="LAM 3:44"/>ኑ ሺኢጲፃ ሙኪ ኔና ሄሉዋጉዲ</para>
  <para style="q2" vid="LAM 3:44">ዲም ጌዔ ሻኣሬና ኔና ኔኤኒ ዓኣቼኔ።<verse eid="LAM 3:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="LAM 3:45"/>ዴሮ ባኣኮይዳ ቡኡራጉዲ ኔ ኑና ላኣሊ ሃሼኔ።»<verse eid="LAM 3:45"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="46" style="v" sid="LAM 3:46"/>«ኑኡኮ ሞርካ ቢያሢ ኑና ጫሽኪ ጫሽኪ</para>
  <para style="q2" vid="LAM 3:46">ሚኢጪ ኑና ዓማሌኔ።<verse eid="LAM 3:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="LAM 3:47"/>ዒጊቹሞና ባይሲንታና</para>
  <para style="q2" vid="LAM 3:47">ሜቶንታ ሂርጋንታ ሙኪ ኑና ሄሌኔ።<verse eid="LAM 3:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="LAM 3:48"/>ታኣኮ ዴሮይዳ ሄሌ ባይሲንቶ ዛሎ</para>
  <para style="q2" vid="LAM 3:48">ዓቢሢ ታኣኮ ዓኣፓፓ ዎርዚ ዋኣሢጉዲ ጎዓኔ።»<verse eid="LAM 3:48"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="49" style="v" sid="LAM 3:49"/>«ዓኣፓ ታኣኮ ሃውሾ ባኣያ ዬኤካኔ።<verse eid="LAM 3:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="LAM 3:50"/>ዬይ ያዺ ማዒ ዴዓንዳሢ</para>
  <para style="q2" vid="LAM 3:50">ናንጊና ናንጋ ጎዳ ጫሪንጫፓ ሊካ ዛጊ ዴንቃንዳያ ሄላንዳኣናኬ።<verse eid="LAM 3:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="LAM 3:51"/>ታኣኮ ካታሞይዳ ዓኣ ዉዱሮ ናኣቶ ቢያሢዳ</para>
  <para style="q2" vid="LAM 3:51">ሄሌ ባኮ ዛሎና ታኣኒ ካራ ባይቂ ታ ዒኖና ማሊ ሜታዼኔ።»<verse eid="LAM 3:51"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="52" style="v" sid="LAM 3:52"/>«ጉሪ ታና ዒፃ ሞርካ</para>
  <para style="q2" vid="LAM 3:52">ካፒም ፒሮ ፒሮጉዲ ታኣም ፒሬኔ።<verse eid="LAM 3:52"/></para>
  <para style="q">
    <verse number="53" style="v" sid="LAM 3:53"/>ታኣኒ ሃይቂባኣንቴ ዔቴይዳ ታና ዓጊ</para>
  <para style="q2" vid="LAM 3:53">ዔቶ ካሮ ሹቻ ዔያታ ዎዼኔ።<verse eid="LAM 3:53"/></para>
  <para style="q">
    <verse number="54" style="v" sid="LAM 3:54"/>ዋኣሢ ታኣኮ ዑሢና ኩሚ ዴንዳኣና</para>
  <para style="q2" vid="LAM 3:54">ታኣኒ ሃይቃንዳ ዎዳ ዑኬያ ታኣም ማሌኔ።»<verse eid="LAM 3:54"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="55" style="v" sid="LAM 3:55"/>«ናንጊና ናንጋ ጎዳሢዮ! ዼኤፖ ዔቶይዳ</para>
  <para style="q2" vid="LAM 3:55">ታኣኒ ጌሊ ዓኣዖ ኔና ሺኢቄኔ።<verse eid="LAM 3:55"/></para>
  <para style="q">
    <verse number="56" style="v" sid="LAM 3:56"/>ታኣኒ፦ ‹ዋዮ ኔኤኮ ታ ባንሢ ማሄ፤</para>
  <para style="q2" vid="LAM 3:56">ዑኬና ሙኪ ታና ማኣዴ› ጌይ ሺኢቃሢ ኔኤኒ ዋይዜኔ።»<verse eid="LAM 3:56"/></para>
  <para style="q">
    <verse number="57" style="v" sid="LAM 3:57"/>ታኣኒ ኔና ዔኤሌ ዎዶና</para>
  <para style="q2" vid="LAM 3:57">ኔኤኒ፦ «ዒጊጪፖ!» ጌይ ታና ዶዲሼኔ።<verse eid="LAM 3:57"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="58" style="v" sid="LAM 3:58"/>«ናንጊና ናንጋ ጎዳሢዮ! ኔኤኒ ታ ዛሎ ሞኦቲ</para>
  <para style="q2" vid="LAM 3:58">ታና ኔኤኒ ዓውሴኔ።<verse eid="LAM 3:58"/></para>
  <para style="q">
    <verse number="59" style="v" sid="LAM 3:59"/>ናንጊና ናንጋ ጎዳሢዮ!</para>
  <para style="q2" vid="LAM 3:59">ታኣም ማዾና ጌኖ ቢያ ኔኤኒ ዛጌሢሮ</para>
  <para style="q2" vid="LAM 3:59">ታኣም ጌስቲ ዎጌ።<verse eid="LAM 3:59"/></para>
  <para style="q">
    <verse number="60" style="v" sid="LAM 3:60"/>ታኣኮ ሞርካ ታና ኮማኒ</para>
  <para style="q2" vid="LAM 3:60">ዎላ ጌስቲ ቱኬ ቱኡዞ ኔኤኒ ዴንቄኔ።»<verse eid="LAM 3:60"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="61" style="v" sid="LAM 3:61"/>«ናንጊና ናንጋ ጎዳሢዮ!</para>
  <para style="q2" vid="LAM 3:61">ታና ዔያታ ጫሽኬ ጫዦና</para>
  <para style="q2" vid="LAM 3:61">ታኣም ዔያታ ማሌ ጌኖ ኔ ዋይዜኔ።<verse eid="LAM 3:61"/></para>
  <para style="q">
    <verse number="62" style="v" sid="LAM 3:62"/>ኬስኬ ዓቢ ዴንዲ ጌሊ ካራንዳያ ሄላንዳኣና</para>
  <para style="q2" vid="LAM 3:62">ሞርካ ታና ባይዞንዶ ጎይፆ</para>
  <para style="q2" vid="LAM 3:62">ዎላ ካሽካሺ ጌስታኔ።<verse eid="LAM 3:62"/></para>
  <para style="q">
    <verse number="63" style="v" sid="LAM 3:63"/>ዔያታ ዴዒያ ማዖም ዔቂ ቶሳ ቶሶና</para>
  <para style="q2" vid="LAM 3:63">ታና ጫርጋ ጫጮ ዔያቶኮ ዛጌ።»<verse eid="LAM 3:63"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="64" style="v" sid="LAM 3:64"/>«ናንጊና ናንጋ ጎዳሢዮ! ዔያታ ማዼ ባኮ ዛሎ</para>
  <para style="q2" vid="LAM 3:64">ኮይሳማጉዴያ ማሂ ዔያቶም ዒንጌ።<verse eid="LAM 3:64"/></para>
  <para style="q">
    <verse number="65" style="v" sid="LAM 3:65"/>ዔያቶ ጋዳንቂ</para>
  <para style="q2" vid="LAM 3:65">ካራ ዔያቶኮ ባይዜ!<verse eid="LAM 3:65"/></para>
  <para style="q">
    <verse number="66" style="v" sid="LAM 3:66"/>ናንጊና ናንጋ ጎዳሢዮ! ኔ ዻጎና ዔያቶ ዳውሴ፤</para>
  <para style="q2" vid="LAM 3:66">ጫሪንጮ ዴማፓ ጋፒሲ ዔያቶ ኩርሴ!»<verse eid="LAM 3:66"/></para>
  <chapter eid="LAM 3"/>
  <chapter number="4" style="c" sid="LAM 4"/>
  <para style="s1">ዬሩሳላሜይዳ ሄሌ ሜቶ</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 4:1"/>ጌኤዦ ማኣሮ ማዦና ሹጫ ጉሪ ዞኦስካ ኬኤሪንቴኔ።</para>
  <para style="q2" vid="LAM 4:1">ዎዎይቴዖ ዎርቃ ሳልፔንቴሞ!</para>
  <para style="q2" vid="LAM 4:1">ጌኤዦ ዎርቃ ሜሌ ባኣዚ ማዔንቴሞ!<verse eid="LAM 4:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="LAM 4:2"/>ፂዮኔይዳ ዓኣ ዓቲንቆ ናኣታ ጌኤሺ ዎርቄጉዲታዖኬ፤</para>
  <para style="q2" vid="LAM 4:2">ሃይሾ ሃሢ ማኒ ዢኢጬ ዓጪና ማዤ</para>
  <para style="q2" vid="LAM 4:2">ሜሄ ማዒ ዓቴንቴሞ!<verse eid="LAM 4:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="LAM 4:3"/>ዉኡካሢታዖ ፔኤኮ ሾዖና ናኣቶ ዻዻንሢሣኔ፤</para>
  <para style="q2" vid="LAM 4:3">ሃይ ታኣኮ ዴራ ዓሲ ናንጉዋ ዳውሎይዳ ዓኣ ቱኡቴጉዲ</para>
  <para style="q2" vid="LAM 4:3">ፔኤኮ ናኣቶም ሚጪንቱዋያ ማዔንቴሞ!<verse eid="LAM 4:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="LAM 4:4"/>ናኣቶ ዔያቶኮ ዋኣፃ ዼኤቤሢሮ ናኣቶኮ ዒንዲርዛ</para>
  <para style="q2" vid="LAM 4:4">ዻንጎይዳ ዓዺንቲ ዴዔኔ፤</para>
  <para style="q2" vid="LAM 4:4">ናኣታ ዔያቶኮ ሙኡዚ ሺኢቃኔ፤</para>
  <para style="q" vid="LAM 4:4">ጋዓንቴ ፔቴታዖ ዔኤቢ ዔያቶም ዒንጋ ዓሲ ባኣሴ።<verse eid="LAM 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 4:5"/>ሃያኮ ቤርታ ቃውቲ ቃውቲ ኮሺ ባኣዚ ሙዓ ዓሳ</para>
  <para style="q2" vid="LAM 4:5">ካራ ባይዚ ሴካ ሃንጋ ጉሪ ዤኤማኔ።</para>
  <para style="q2" vid="LAM 4:5">ጋላፒ ማዔ ሚዛጶ ማኣዓሢ ማይንቲ ዲጬ ዓሳ</para>
  <para style="q2" vid="LAM 4:5">ሃሢ ዲቢንሢ ላኣሎ ዱባይዳ ፔና ሃሺ ላሄኔ።<verse eid="LAM 4:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="LAM 4:6"/>ታ ዴሮይዳ ሄሌ ሜታ</para>
  <para style="q2" vid="LAM 4:6">ዖኦኒያ ካኣሙዋንቴ ዶዒ ባይቄ</para>
  <para style="q2" vid="LAM 4:6">ሶዶሜ ካታሞ ሜታፓ ባሻያኬ። <note caller="-" style="x"><char style="xo" closed="false">4፡6 </char><char style="xt" closed="false"><ref loc="GEN 19:24">ማዢ. ማፃ 19፡24</ref>።</char></note><verse eid="LAM 4:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="LAM 4:7"/>ካኣቶ ናኣቶ ማዔ ዔያቶ ሱኡጋ ዔያቶ ኮይላ</para>
  <para style="q2" vid="LAM 4:7">ሻቺፓ ባሼ፤ ዲኢቂፓኣ ባሼ ጌኤሽኪ ጴዻያኬ፤</para>
  <para style="q2" vid="LAM 4:7">ዔያቶኮ ሚዛጱማ ሴንፔሬ ጌይንታ ሹጮጉዲኬ።<verse eid="LAM 4:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="LAM 4:8"/>ሃሢ ጋዓንቴ ዓኣፖ ካራ ዔያቶኮ ጪላንቺጉዲ ካርቴኔ፤</para>
  <para style="q2" vid="LAM 4:8">ዞኦዛ ዔያታ ሜታዺ ሃንታኣና ዔያቶ ዔራ ዓሲያኣ ባኣሴ፤</para>
  <para style="q2" vid="LAM 4:8">ሜልዚ ሚሢጉዲ ዒልዓ ዔያቶኮ ዑፆይዳ ፓፂ ባይቄኔ።<verse eid="LAM 4:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="LAM 4:9"/>ናዮና ሃይቂ ኩዳ ዓሶይዳፓ</para>
  <para style="q2" vid="LAM 4:9">ጬንቾ ዓራፖና ዎዾ ዓሳ ቃራኬ፤</para>
  <para style="q2" vid="LAM 4:9">ሙዓ ባይቄሢሮ ዓሳ ዞኦዛ ናዮና ሜሊ ጉሪ ኩዳኔ።<verse eid="LAM 4:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 4:10"/>ባይሲንታ ኬዴም ካታማ ካራ ባይቄ ዎዶና</para>
  <para style="q2" vid="LAM 4:10">ናኣቶ ሚጪንታ ላኣላ ፔ ኩቻ ፔኤኮ ናኣቶ ካሢ ሙዔኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡10 </char><char style="xt" closed="false"><ref loc="DEU 28:57">ላሚ. ዎማ 28፡57</ref>፤ <ref loc="EZK 5:10">ሂዚ. 5፡10</ref>።</char></note><verse eid="LAM 4:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 4:11"/>ናንጊና ናንጋ ጎዳ ፔኤኮ ዼኤፖ ዻጎ ዴንሢ</para>
  <para style="q2" vid="LAM 4:11">ፂዮኔኮ ፃጶ ሙይ ዶዶይሳንዳ ታሚጉዲ</para>
  <para style="q2" vid="LAM 4:11">ዔዔኤታ ፑርታ ባኣዚ ኬይሴኔ።<verse eid="LAM 4:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 4:12"/>ዓጮ ቢያሢዳ ዓኣ ካኣቶዋ ማዖም ዴራ</para>
  <para style="q2" vid="LAM 4:12">ዬሩሳላሜ ካታሞኮ ጌሎ ካሮና</para>
  <para style="q2" vid="LAM 4:12">ሞርኬ ጌላንዳኔ ጌይ ፔቴታዖ ማሊባኣሴ።<verse eid="LAM 4:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="LAM 4:13"/>ጋዓንቴ ዬይ ያዺ ማዔሢ ዒኢካ ጌኤዦ ዓሶ ዎዼ</para>
  <para style="q2" vid="LAM 4:13">ቄኤሶንታ ፆኦሲ ማሊፆ ኬኤዛ ዓሶ ጎሞ ዛሎናኬ።<verse eid="LAM 4:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="LAM 4:14"/>ዔያታ ዬያ ሱጉፆና ዒኢቴያታሢሮ</para>
  <para style="q2" vid="LAM 4:14">ዔያቶኮ ማኣዓሢታዖ ጫርቂ ካኣማ ዓሲ ባኣሴ፤</para>
  <para style="q2" vid="LAM 4:14">ዔያታ ዓኣፒ ባይቄ ዓሲጉዲ ጎይፆይዳ ሴካ ሃንጋ ቴኤም ጋዓኔ።<verse eid="LAM 4:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="LAM 4:15"/>ዬያሮ ዴራ፦ «ዴንዲ ባይቁዋቴ!</para>
  <para style="q2" vid="LAM 4:15">ዒንሢ ዒኢቴ ዓሲታሢሮ ኑና ሄሊፖቴ!» ጌይ ዒላታኔ።</para>
  <para style="b" vid="LAM 4:15"/>
  <para style="q" vid="LAM 4:15">ዬያሮ ዔያታ ዒፂ ዳውሶና ዓሲ፥ ሃሣ ቤሲ ባይዜ ዓሲ ማዔኔ፤</para>
  <para style="q2" vid="LAM 4:15">ዴራ፦ «ሃካፓ ሴካ ማይ ዔያታ ኑ ባኣካ ዴይንዱዋሴ» ጌዔኔ።<verse eid="LAM 4:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="LAM 4:16"/>ናንጊና ናንጋ ጎዳ ዔያቶ ፔኤሮ ዜሪ ዳኬሢሮ</para>
  <para style="q2" vid="LAM 4:16">ሃካፓ ሴካ ዒዚ ዔያቶ ዛሎ ማላዓኬ፤</para>
  <para style="q2" vid="LAM 4:16">ቄኤሶዋ ዒዚ ቦንቺሳዓኬ፤</para>
  <para style="q2" vid="LAM 4:16">ዒኢካ ዓኣ ጋርቾማኣ ኮሺ ባኣዚ ማዺንታዓኬ።<verse eid="LAM 4:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="LAM 4:17"/>«ኑና ማኣዳንዳያ ሙካንዳኔ» ጌይ ኑ ጎይሢ ዛጋኣና ላቤኔ፤</para>
  <para style="q2" vid="LAM 4:17">ኑና ዓውሳኒ ዳንዳዑዋ ዓሲ ኑኡኮ ሴኤሎይዳ ዔቂ ኑ ጉሪ ካፔኔ።<verse eid="LAM 4:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="LAM 4:18"/>ኑኡኒ ጎይፆይዴና ሴካ ሃንጋ ሃንቱዋጉዲ</para>
  <para style="q2" vid="LAM 4:18">ሞርካ ኑና ዚርቂ ዔቂ ካፓኔ፤</para>
  <para style="q2" vid="LAM 4:18">ኑኡኮ ጋፒ ዎዴ ሄሌኔ፥ ኬሊ ኑም ሜንሦናኣኬ፤</para>
  <para style="q2" vid="LAM 4:18">ኑኡኒ ኩዳኒ ዑኬኔ።<verse eid="LAM 4:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="LAM 4:19"/>ኑና ዳውሳ ሞርካ ኮኦኬይዳፓ ባሼ ሩኡራያኬ፤</para>
  <para style="q2" vid="LAM 4:19">ዹኮ ዑፆይዳ ኑና ዳውሴኔ፤</para>
  <para style="q2" vid="LAM 4:19">ዓሲ ናንጉዋ ዳውሎ ቦኦሎይዳኣ ኑና ካቴኔ።<verse eid="LAM 4:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="LAM 4:20"/>ናንጊና ናንጋ ጎዳ ካኣቲ ማሂ ዶኦሜ</para>
  <para style="q2" vid="LAM 4:20">ኑኡኮ ሼምፓሢኮ ዑኡዞ ማዔሢ</para>
  <para style="q2" vid="LAM 4:20">ዔያታ ፔ ፒራሢና ፒሪ ዓይሤኔ፤</para>
  <para style="q" vid="LAM 4:20">ዒዛ ሺቦ ዴማ ዴዒ</para>
  <para style="q2" vid="LAM 4:20">ዴሮ ባኣኮይዳ ናንጋንዳኔ ጌይ ኑኡኒ ማሌንቴኬ።<verse eid="LAM 4:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="LAM 4:21"/>ዒንሢ ዑፄይዳ ናንጋ፥ ዔዶኦሜ ዴራ</para>
  <para style="q2" vid="LAM 4:21">ዎዛዹዋቴ፥ ዒላሹዋቴ!</para>
  <para style="q2" vid="LAM 4:21">ጋዓንቴ ዒንሢም ጊኢጊሾና ጳዻሢ</para>
  <para style="q2" vid="LAM 4:21">ፔ ዎዶ ካፒ ሙኮ ዓታዓኬ፤</para>
  <para style="q2" vid="LAM 4:21">ዒንሢያ ማሢንቲ፥ ማኣዓሢ ኬኤሪ ካላዻንዳኔ።<verse eid="LAM 4:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="LAM 4:22"/>ዬሩሳላሜ ዴሬዮቴ! ዒንሢ ዻቢንቶሮ</para>
  <para style="q2" vid="LAM 4:22">ዒንሢም ዓጎና ፑርቶ ባካ ጊዳንዳኔ፤</para>
  <para style="q2" vid="LAM 4:22">ናንጊና ናንጋ ጎዳ ዑኬና ዒንሢ ዳውሲንቲ ዴንዴ ባዛፓ ማሃንዳኔ፤</para>
  <para style="q2" vid="LAM 4:22">ጋዓንቴ ዔዶሚያሴ ዴሬዮቴ! ዒንሢ ዻቢንቶ ዛሎ</para>
  <para style="q2" vid="LAM 4:22">ናንጊና ናንጋ ጎዳ ዒንሢዳ ሜቶ ዓጋንዳኔ፤ ዻቢንቶዋ ዒንሢኮ ፔጋሳንዳኔ።<verse eid="LAM 4:22"/></para>
  <chapter eid="LAM 4"/>
  <chapter number="5" style="c" sid="LAM 5"/>
  <para style="s1">ፆኦሲ ሚጪንታንዳጉዲ ሺኢቂንቴ ሺኢጲሢ</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 5:1"/>ናንጊና ናንጋ ጎዳሢዮ! ኑና ሄሌ ባኮ ዛሎሮ ኑም ማሌ፤</para>
  <para style="q2" vid="LAM 5:1">ኑኡኮ ዻውሲንቶ ዛጌ!<verse eid="LAM 5:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="LAM 5:2"/>ኑኡኮ ዴና ዔውቲ ሜሌ ዓሲም ዒንጊንቴኔ፤</para>
  <para style="q2" vid="LAM 5:2">ኑኡኮ ኬኤፃ ቢያ ሜሌ ፃንጎ ዓሲ ናንጋ ኬኤሢ ማዔኔ።<verse eid="LAM 5:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="LAM 5:3"/>ኑኡኒ ዓዴ ሃይቄ ዜኤሪ ማዔም</para>
  <para style="q2" vid="LAM 5:3">ኑኡኮ ዒንዶንሢያ ዜኤሪ ዒንዶ ማዔኔ።<verse eid="LAM 5:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="LAM 5:4"/>ኑኡኒ ዑሽካ ዋኣፆንታ</para>
  <para style="q2" vid="LAM 5:4">ካያፓ ሃኣኮ ሃንፂሎንታ ሻሻንቃኔ።<verse eid="LAM 5:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="LAM 5:5"/>ኑና ዳውሳ ዓሳ ኑኡኮ ባቃና ዴዒ ዓኣኔ፤</para>
  <para style="q2" vid="LAM 5:5">ኑኡኒ ላቤኔ፥ ሃውሾዋ ኑኡኮ ባኣሴ።<verse eid="LAM 5:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="LAM 5:6"/>ኑም ጊዳ ሙኡዚ ዴንቃኒ ጊብፄ ዓጮና</para>
  <para style="q2" vid="LAM 5:6">ዓሶኦሬ ዓጮናም ኩቺ ኑ ዒንጌኔ።<verse eid="LAM 5:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="LAM 5:7"/>ኑ ዓዶንሢ ጎሜ ማዺ ኑም ሃሼኔ፤</para>
  <para style="q2" vid="LAM 5:7">ኑኡኒ ዔያቶም ዓጎና ሜቶ ዔኪሢዳኬ።<verse eid="LAM 5:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="LAM 5:8"/>ሃያኮ ቤርታ ዓይሌ ማዔ ዓሳ ሃሢ ኑና ዎይሣያ ማዔኔ፤</para>
  <para style="q2" vid="LAM 5:8">ዔያቶ ኩጫፓ ኑና ዓውሳኒ ዳንዳዓ ዓሲያኣ ባኣሴ።<verse eid="LAM 5:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="LAM 5:9"/>ዳውሎ ቦኦሎይዳ ዎዻ ዓሲ ዓኣሢሮ</para>
  <para style="q2" vid="LAM 5:9">ኑኡኒ ሙዖ ባኣዚ ዴንቃኒ ዳንዳዓሢ</para>
  <para style="q2" vid="LAM 5:9">«ዎዼቴ ዎዼ፥ ዻቂሼቴ ዻቂሼ» ጌይኬ።<verse eid="LAM 5:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="LAM 5:10"/>ናያ ኑና ባሼሢሮ</para>
  <para style="q2" vid="LAM 5:10">ዑፃ ኑኡኮ ናኣቦጉዲ ጪላንቄኔ።<verse eid="LAM 5:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="LAM 5:11"/>ኑኡኮ ላኣላ ፂዮኔይዳ</para>
  <para style="q2" vid="LAM 5:11">ኑኡኮ ዉዱሮ ናኣታኣ ዪሁዳ ካታሞይዳ</para>
  <para style="q2" vid="LAM 5:11">ዎልቄና ዓርቂንቴኔ።<verse eid="LAM 5:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="LAM 5:12"/>ኑ ሱኡጎኮ ኩጮ ቱኪ ሱፂ ዎዾናኔ፤</para>
  <para style="q2" vid="LAM 5:12">ኑኡኮ ጋርቾዋ ቦንቺቦኦሴ።<verse eid="LAM 5:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="LAM 5:13"/>ዓቲንቆ ዼጌሢ ዎልቃዺ ዎንሢ ዎዺሾናኔ፤</para>
  <para style="q2" vid="LAM 5:13">ዓቲንቆ ናኣቶ ዻካኣ ዴኤሢ ሃንፂሌ ኬዲና ሜታዼኔ።<verse eid="LAM 5:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="LAM 5:14"/>ዓጮ ጋርቻ ዴይ ዎጎ ዎጋ ቤዞ ሃሺ ዴንዴኔ፤</para>
  <para style="q2" vid="LAM 5:14">ዼጌሢያ ኮርጋ ኮፆ ሃሼኔ።<verse eid="LAM 5:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="LAM 5:15"/>ዎዛ ኑኡኮ ዒናፓ ባይቄኔ፤</para>
  <para style="q2" vid="LAM 5:15">ኑ ዎንዴ ዎዛዺ ኮርጋ ኮፆ ባይዚ ዖዪሢ ዓርቄኔ።<verse eid="LAM 5:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="LAM 5:16"/>ቦንቻ ኑኡኮ ዔውቲ ባይቄኔ፤</para>
  <para style="q2" vid="LAM 5:16">ኑኡኒ ጎሜ ማዼሢሮ ኑና ባዴዔ!<verse eid="LAM 5:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="LAM 5:17"/>ያዺ ማዔሢሮ ኑኡኒ ሃርጌ ዓሲ ማዔኔ፤</para>
  <para style="q2" vid="LAM 5:17">ዓኣፓኣ ኑኡኮ ፒዜ ዛጎ ባሺንቲ ላቤኔ።<verse eid="LAM 5:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="LAM 5:18"/>ፂዮኔ ዹካ ዓሲባኣያ ጉሪ ቤሲ ማዒ ዓቴሢሮ</para>
  <para style="q2" vid="LAM 5:18">ዉኡካ ዒኢካ ዓማሊ ሺራ ቤሲ ማዔኔ።<verse eid="LAM 5:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="LAM 5:19"/>ኔኤኒ ጋዓንቴ ናንጊና ናንጋ ጎዳሢዮ! ናኣናና ካኣቲኬ፤</para>
  <para style="q2" vid="LAM 5:19">ኔኤኮ ካኣቱሞ ዖይታ ሙካ ዎዶ ቢያይዳ ባይቃዓኬ።<verse eid="LAM 5:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="LAM 5:20"/>ኔ ኑና ዎይታዛ ጋፒ ዋሊ ሃሼዖ?</para>
  <para style="q2" vid="LAM 5:20">ሚርጌ ዎዴ ኔ ኑና ኬንኬሊዲ ሃሼንቴሞ?<verse eid="LAM 5:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="LAM 5:21"/>ናንጊና ናንጋ ጎዳሢዮ! ኔ ባንሢ ኑና ማሄ፥ ኑኡኒ ማዓንዳኔ፤</para>
  <para style="q2" vid="LAM 5:21">ኑኡኒ ናንጋ ናንጎ ቤርታኣ ዎዶጉዲ ማሂ ጊንሣ ኮሼ።<verse eid="LAM 5:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="LAM 5:22"/>ኔኤኒ ዬያይዲባኣቴ ጋፒ ኑና ኔ ሃሺ</para>
  <para style="q2" vid="LAM 5:22">ኑኡኒ ማዼ ባኮሮዋ ዑሣ ዓኣዼ ኔ ዻጋዼኔ ጌይሢኬ።<verse eid="LAM 5:22"/></para>
  <chapter eid="LAM 5"/>
</usx>
