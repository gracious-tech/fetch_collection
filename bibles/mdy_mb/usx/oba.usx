<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- MAALE Full Bible</book>
  <para style="h">ዓብዲዮ ማፃኣፖ</para>
  <para style="toc1">ፆኦሲ ማሊፆ ኬኤዛ ዓብዲዮ ማፃኣፖ</para>
  <para style="toc3">ዓብዲ.</para>
  <para style="toc2">ዓብዲዮ ማፃኣፖ</para>
  <para style="mt1">ዓብዲዮ</para>
  <para style="imt">ዓይፆ ካሮ</para>
  <para style="ip">ሃና ማፃኣፔላ ፃኣፒንቲ ዓኣያ ማዒ ጴዼሢ ኪሪስቶሴ ሾይንታንዳሢኮ ቤርታ ዶንጎ ፄኤታና ሳሊታሚ ላሆ ማዓ ሌዖይዳ፥ ዬሩሳላሜ ካታማ ሻሂንቲ ዶዔሢኮ ጊንፃ ዔርቲባኣ ዎዴይዳኬ። ዬኖ ዎዶና ዾኦሎ ዛሎኮ ዓባ ኬስካ ባንፆይዳ ዓኣ ዪሁዳ ካታሞኮ ሚርጌ ዎዴ ሞርኬ ማዒ ናንጌ፥ ዔዶኦሜ ዓጮ ዓሳ ዬሩሳላሜ ሻሂንቴሢሮ ዎዛዺ፤ ሃሣ ባብሎኔ ዓጮ ዓሳ ዬሩሳላሜ ሙኪ ዖላኣና ካታሞ ዎላ ቡሬኔ። ዒማና ዔዶኦሜ ዓጮ ዓሳ ሜሌ ዒስራዔኤሌ ዓሶኮ ሞርኮ ማዔ ዓሶና ዎላ ሜቶይዳ ኬዳንዳሢና ዖሎናኣ ባሺንታንዳያ ማዒፃ ፆኦሲ ማሊሢ ማዔሢ ዓብዲዮ ኬኤዜኔ።</para>
  <para style="iot">ማፃኣፔላ ዱማ ዱማ ዓርቄ ባኮ</para>
  <para style="io1">ዔዶኦሜ ዓጮም ኬኤዚንቴ ባኮና ዔያቶ ሄላንዳ ሜቶ (1-7)</para>
  <para style="io1">ዔዶኦሜ ዓጮ ዓሶኮ ሚጪንቱዋያ ማዒፆ (8-14)</para>
  <para style="io1">ዒስራዔኤሌ ዓሳ ዖሎና ባሼሢ (15-21)</para>
  <chapter number="1" style="c" sid="OBA 1"/>
  <para style="s1">ዔዶኦሜ ዓጮ ዓሶ ሄላንዳ ሜቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1"/>ዓብዲዮም ፆኦሲ ፔጋሲ ዻዌ ባካ ያዺኬ። ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢ ዔዶኦሜ ዓጮም ኬኤዛንዳጉዲ ዓብዲዮ ዳኬኔ፤ ኑኡኒ ዋይዜ ፆኦሲ ኪኢታ፦ «ሜሌ ዴራ ሙኪ ዔዶኦሜ ዓጮ ዖላንዳጉዲ ታኣኒ፥ ናንጊና ናንጋ ጎዳ ኪኢታ ዳኬኔ!» ጋዓያኬ።<verse eid="OBA 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="OBA 1:2"/>ናንጊና ናንጋ ጎዳ ዔዶኦሜ ዓጮም ሂዚ ጋዓኔ፦</para>
  <para style="q2" vid="OBA 1:2">«ዓካሪ ታ ኔና ሜሌ ዴሮ ባኣካ ዎልቄ ባኣያ ማሃንዳኔ፤</para>
  <para style="q2" vid="OBA 1:2">ሚርጌና ኔኤኒ ቦሂንቴያ ማዓንዳኔ።<verse eid="OBA 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="OBA 1:3"/>ኔኤኮ ዖቶርቃ ዒና ኔና ጌሼኔ፤</para>
  <para style="q2" vid="OBA 1:3">ኔኤኒ፦ ‹ዶዲ ላሌ ሹቺና ዙሎ ዲርቆና ካታማይዳ ታ ናንጋኔ፤</para>
  <para style="q2" vid="OBA 1:3">ታኣኒ ዎርቃ ማኣራ ዼጌ ዹካ ዑስካ ማዢንቴያኬ፤</para>
  <para style="q2" vid="OBA 1:3">ታኣኒ ዓኣ ቤዛፓ ዖ ታና ኬይሳኒ ዳንዳዓይ!› ጌይ ሄርሺንታኔ።<verse eid="OBA 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="OBA 1:4"/>ጋዓንቴ ኔኤኒ ዓዳ ኮኦኬጉዲ ባራኔቴያ</para>
  <para style="q2" vid="OBA 1:4">ዴንዲ ኔኤኒ ዦኦጎ ባኣካ ናንጌቴያ</para>
  <para style="q2" vid="OBA 1:4">ዬካፓ ታ ኔና ኬይሳንዳኔ። ዬያ ጌዔሢ ታና፥ ናንጊና ናንጋ ጎዳኬ።»<verse eid="OBA 1:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="OBA 1:5"/>«ዉሲ፤ ጊንሣ ሃሣ ቡራ ዓሲያ ዹሚና ሙኬቴ</para>
  <para style="q2" vid="OBA 1:5">ፔኤም ጊዳማጉዴያ ሌሊ ዔካኔ፤</para>
  <para style="q" vid="OBA 1:5">ዎይኖ ዓኣፖ ቲቂ ቡኩሳ ዓሳታዖ ቃኣሉሚ ዓይሳኔ፤</para>
  <para style="q2" vid="OBA 1:5">ኔኤኮ ሞርካ ጋዓንቴ ኔና ጋፒሲ ባይዛንዳኔ።<verse eid="OBA 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="OBA 1:6"/>ዒንሢ ዔኤሳዎ ዜርፃ፦ ማኣራ ዒንሢኮ ቡሪንቴኔ፤</para>
  <para style="q2" vid="OBA 1:6">ቆላኣ ዒንሢኮ ጉቤ ዔውቴኔ።<verse eid="OBA 1:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="OBA 1:7"/>ኔኤና ዎላ ዖላኒ ጫኣቄ ላጋ ቢያ ኔና ጌሼኔ፤</para>
  <para style="q2" vid="OBA 1:7">ኔ ዓጫፓ ኬሲ ኔና ዔያታ ዳውሴኔ፤</para>
  <para style="q2" vid="OBA 1:7">ኔኤኮ ላጎ ማዔ ዓጫ ኔጊዳ ሞርኬ ማዒ ዔቄኔ፤</para>
  <para style="q" vid="OBA 1:7">ኔኤና ዎላ ካሦ ሙዔ ዓሳ ኔኤም ፒሬኔ፤</para>
  <para style="q2" vid="OBA 1:7">ዬያ ቢያ ዔያታ ማዻሢ ጋዓንቴ ኔ ዔሪባኣሴ።»<verse eid="OBA 1:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="OBA 1:8"/>«ዬኖ ዎዶና ዔዶኦሜ ዓጮይዳ ዔሮ ዓሶ፤</para>
  <para style="q2" vid="OBA 1:8">ዔኤሳዎ ዓጮ ዹኮይዳ ናንጋ ዓሶኮ ዔራቶ ታኣኒ ባይዛንዳኔ።<verse eid="OBA 1:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="OBA 1:9"/>ዔዶኦሜ ዓጮይዳ ናንጋ ዓሳ ቢያ ዎዺንታንዳኔ፤</para>
  <para style="q2" vid="OBA 1:9">ቴሜና ዓጮይዳ ዖሎና ዔርቴ ዓሳ ዒጊቹሞና ጎጋይቃንዳኔ።»<verse eid="OBA 1:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="OBA 1:10"/>«ኔ ጌርሲ ያይቆኦቤ ዜርፆ ሚጪንቱዋዖ ኔኤኒ ዎዼሢሮ</para>
  <para style="q2" vid="OBA 1:10">ኔኤኒ ዻውሲንታንዳኔ፤ ቤሲባኣያ ማዒ ኔ ባይቃንዳኔ።<verse eid="OBA 1:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="OBA 1:11"/>ሞርካ ዔያቶኮ ካሮ ሜንሣኣና</para>
  <para style="q2" vid="OBA 1:11">ዔያቶኮ ዓኣ ቆሎ ቢያ ቡራኣና</para>
  <para style="q2" vid="OBA 1:11">ኔኤኒ ኮራ ዔቂ ዛጌኔ፤</para>
  <para style="q2" vid="OBA 1:11">ዬሩሳላሜ ዓጮ ጊሽቲ ዔኬ ዓሶፓ ኔ ዱማቱዋሴ።<verse eid="OBA 1:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="OBA 1:12"/>ዪሁዳ ዓጮይዳ ናንጋ ኔ ጌርሲንሢዳ ሄሌ ሜታሢና</para>
  <para style="q2" vid="OBA 1:12">ኔኤኒ ዎዛዻንዳያ ኮይሱዋያታንቴኬ፤</para>
  <para style="q" vid="OBA 1:12">ዔያታ ባይቃ ኬሎና ኔኤኒ ዒላሻንዳያና</para>
  <para style="q2" vid="OBA 1:12">ዔያታ ካራ ባይቂ ዋኣያ ኬሎና ዔያቶይዳ ዖቶርቂ ጌስቲፃ ኔኤም ኮይሱዋያታንቴኬ።<verse eid="OBA 1:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="OBA 1:13"/>ዔያታ ሜታዻ ኬሎና ታ ዴሮኮ ካታሞ ጌሊ</para>
  <para style="q2" vid="OBA 1:13">ካራ ዔያቶኮ ባይቄም ዪሁዳ ዴራ ኩዳ ኬሎና ኔኤኒ ዎዛዻኒና</para>
  <para style="q2" vid="OBA 1:13">ዔያቶኮ ዓኣ ባኮ ቡራኒ ኔኤም ኮይሱዋያታንቴኬ።<verse eid="OBA 1:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="OBA 1:14"/>ቶሊ ዓኣሺንታኒ ጳሽካ ዓሶ ዎዻኒ ጎይፃ ዎላ ካኣማ ካሮይዳ</para>
  <para style="q2" vid="OBA 1:14">ካቲ ዴዓንዳያ ኔና ኮይሱዋያታንቴኬ፤</para>
  <para style="q" vid="OBA 1:14">ቶሊ ዓቴ ዓሶ ሃሣ ዔያታ ካሮ ባይቄያና ዓርቂ ዔኪ</para>
  <para style="q2" vid="OBA 1:14">ዔያቶኮ ሞርኮም ኔና ዒንጋንዳያ ኮይሱዋያታንቴኬ።» <note caller="-" style="x"><char style="xo" closed="false">1፡14 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">ዒሲ. 34፡5-17</ref>፤ <ref loc="ISA 63:1-6">63፡1-6</ref>፤ <ref loc="JER 49:7-22">ዔር. 49፡7-22</ref>፤ <ref loc="EZK 25:12-14">ሂዚ. 25፡12-14</ref>፤ <ref loc="EZK 35:1-15">35፡1-15</ref>፤ <ref loc="AMO 1:11-12">ዓሞ. 1፡11-12</ref>፤ <ref loc="MAL 1:2-5">ሚል. 1፡2-5</ref>። </char></note><verse eid="OBA 1:14"/></para>
  <para style="s1">ፆኦሲ ሜሌ ዴሮይዳ ዓጋንዳ ሜቶ</para>
  <para style="q">
    <verse number="15" style="v" sid="OBA 1:15"/>«ታኣኒ፥ ናንጊና ናንጋ ጎዳ ሜሌ ዴሮ ቢያይዳ</para>
  <para style="q2" vid="OBA 1:15">ዎጋ ኬላ ሄሌኔ፤</para>
  <para style="q" vid="OBA 1:15">ዔዶኦሜ! ኔ ማዼ ጎይፆማ ኔ ጊዳ ማዺንታንዳኔ፤</para>
  <para style="q2" vid="OBA 1:15">ኔ ማዻ ፑርቶ ማዻ ኔ ባንሢ ሺራንዳኔ።<verse eid="OBA 1:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="OBA 1:16"/>ታኣኮ ዴራ ታኣም ዱማዼ ዹኮይዳ</para>
  <para style="q2" vid="OBA 1:16">ዒንጊንቴ ሜቶ ዔኬኔ፤</para>
  <para style="q" vid="OBA 1:16">ዬያሮ ዔያቶ ዓጮ ኮይላ ዓኣ ሜሌ ዴራ ዬያፓ ባሼ ሜቶ ዔካንዳኔ፤</para>
  <para style="q2" vid="OBA 1:16">ዬካፓ ዔያቶኮ ቤሲ ባይቃንዳኔ።»<verse eid="OBA 1:16"/></para>
  <para style="s1">ዒስራዔኤሌ ዓሶኮ ዖሎና ባሺፆ</para>
  <para style="q">
    <verse number="17" style="v" sid="OBA 1:17"/>«ፂዮኔ ዹኮይዳ ዬያ ባይሲንታፓ ቶሊ ዓታንዳ ዓሲ ዓኣኔ፤</para>
  <para style="q2" vid="OBA 1:17">ፂዮኔ ዹካ ታኣም ዱማዼያ ማዓንዳኔ፤</para>
  <para style="q2" vid="OBA 1:17">ያይቆኦቤ ዴራ ቤርታ ዔያቶኮ ዔኮና ባኮ ጊንሣ ማሂ ዔካንዳኔ።<verse eid="OBA 1:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="OBA 1:18"/>ያይቆኦቤ ናኣታ ዓዳ ታሚጉዲ፤</para>
  <para style="q2" vid="OBA 1:18">ዮሴፔ ናኣታኣ ታሚ ሎስቶጉዲ ማዓንዳኔ።</para>
  <para style="q2" vid="OBA 1:18">ዔኤሳዎ ናኣታ ጋዓንቴ ዲኢሪ ማዓንዳኔ፤</para>
  <para style="q2" vid="OBA 1:18">ታሚ ዲኢሪ ሙዓሢጉዲ ያይቆኦቤ ናኣቶንታ</para>
  <para style="q2" vid="OBA 1:18">ዮሴፔ ናኣቶንታ ዔኤሳዎ ናኣቶ ሙይ ባይዛንዳኔ።</para>
  <para style="q2" vid="OBA 1:18">ዬያ ጌዔሢ ታና፥ ናንጊና ናንጋ ጎዳኬ።»<verse eid="OBA 1:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="OBA 1:19"/>«ዪሁዳ ዓጮኮ ዾኦሎ ባንፆና ዓኣ ዴራ</para>
  <para style="q2" vid="OBA 1:19">ዔዶኦሜ ዓጮ ፔ ዓጪ ማሂ ዔካንዳኔ፤</para>
  <para style="q" vid="OBA 1:19">ዓባ ጌላ ባንፆ ዹኮ ዴማ ዓኣ ዳውላዻ ቤዞይዳ ናንጋ ዴራ</para>
  <para style="q2" vid="OBA 1:19">ፒሊስፄኤሜ ዓጮ ፔ ዓጪ ማሂ ዓርቂ</para>
  <para style="q" vid="OBA 1:19">ዔፕሬኤሜንታ ሳማሪያ ዓጮናኮ ዴማ ዎርቃ ዓጮ ዔካንዳኔ፤</para>
  <para style="q2" vid="OBA 1:19">ቢኢኒያሜ ዓሳኣ ጌሌዓዴ ዓጮ ፔ ዓጪ ማሂ ዔካንዳኔ።<verse eid="OBA 1:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="OBA 1:20"/>ዳውሲንቲ ዴንዲ ኬዶ ባንፃ ናንጋ፥ ዒስራዔኤሌ ዴራ</para>
  <para style="q2" vid="OBA 1:20">ሆኦላ ጌይንታ ዓጫፓ ማዒ ሙኪ ካኣናኔ ዓጮኮ</para>
  <para style="q2" vid="OBA 1:20">ዴንዲ ሲራጲታ ሄላንዳኣና ፔ ዓጪ ማሂ ዔካንዳኔ።</para>
  <para style="q2" vid="OBA 1:20">ዬሩሳላሜይዳፓ ዳውሲንቲ ዴንዲ ሴፓራዲሜ ዓጮይዳ ናንጋ</para>
  <para style="q" vid="OBA 1:20">ዒስራዔኤሌ ዓሳ ዓጬሎኮ ዾኦሎ ባንፆና ዓኣ ካታሞ ዓርቃንዳኔ።<verse eid="OBA 1:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="OBA 1:21"/>ቶሊ ዓቴ ዬሩሳላሜ ዓሳ</para>
  <para style="q2" vid="OBA 1:21">ፂዮኔ ዹካ ኬስኪ ዴይ ዔዶኦሜ ዓጮ ዎይሣንዳኔ፤</para>
  <para style="q" vid="OBA 1:21">ካኣታዺ ዎይሣሢያ ናንጊና ናንጋ ጎዳ ማዓንዳኔ።»<verse eid="OBA 1:21"/></para>
  <chapter eid="OBA 1"/>
</usx>
