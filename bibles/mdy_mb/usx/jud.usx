<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- MAALE Full Bible</book>
  <para style="h">ዪሁዳ ኪኢቶ</para>
  <para style="toc1">ዪሁዳ ዳኬ ኪኢቶ</para>
  <para style="toc3">ዪሁ.</para>
  <para style="toc2">ዪሁዳ ኪኢቶ</para>
  <para style="mt1">ዪሁዳ ኪኢቶ</para>
  <para style="imt">ዓይፆ ካሮ</para>
  <para style="ip">ሃይ ዪሁዳ ኪኢታ ፃኣፒንቴሢ ዬሱሴ ጉሙርቂ ጎናሲ ዔኪባኣ ዓሲታዖ ዬሱሴ ጉሙርቂ ዔኬ ዓሶ ማላ፥ ሉኡዙሞ ባኮ ኬኤዛ ዓሶይዳፓ ዬሱሴ ጉሙርቂ ጎናሲ ዔኬ ዓሳ ፔና ካፓንዳጉዲ ዔርዛኒኬ፤ ማሊፃ ላምዓሳ ጴፂሮሴ ኪኢቶ ማላ፥ ሃኖ ዻኮ ኪኢቶ ማፃኣፖ ፃኣፔ ዓሢ ፔቴና ጌኤዦንሢም ፆኦሲ ዒንጌ ጉሙርቂፆ ኮሺ ዔያታ ዓርቃንዳጉዲ ሃሣ ሃኖ ኪኢቶ ናባባ ዓሳኣ ዔራንዳጉዲ ኬኤዛኔ።</para>
  <para style="iot">ማፃኣፔላ ዱማ ዱማ ዓርቄ ባኮ</para>
  <para style="io1">ዓይፆ ካሮ 1-2</para>
  <para style="io1">ሉኡዙሞና ዔርዛ ዓሶኮ ማሊፆንታ ዔርዚፆንታ ሃሣ ዔያቶም ጊኢጊንቴ ባኮ 3-16</para>
  <para style="io1">ዬሱሴ ጉሙርቃ ዓሶም ዒንጊንቴ ዞሮ 17-23</para>
  <para style="io1">ፆኦሲ ጋላቲሢ 24-25</para>
  <chapter number="1" style="c" sid="JUD 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1"/>ዬሱስ ኪሪስቶሴም ማዻያ ማዔ ያይቆኦቤ ጌርሲ ዪሁዳይዳፓ፦</para>
  <para style="p" vid="JUD 1:1">ፆኦሲ ዔኤሌዞንሢም፤ ሃሣ ፆኦሲ ዓዳሢ ናሽኬዞንሢም፤ ሃሣ ዬሱስ ኪሪስቶሴና ካፒንቲ ዓኣዞንሢም ቢያ፦ <note caller="-" style="x"><char style="xo" closed="false">1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">ማቲ. 13፡55</ref>፤ <ref loc="MRK 6:3">ማር. 6፡3</ref>።</char></note><verse eid="JUD 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2"/>ማኣሪሢና ኮሹሞና ሃሣ ናሹሞና ዒንሢም ዺቦንጎ።<verse eid="JUD 1:2"/></para>
  <para style="s1">ሉኡዙሞ ባኣዚ ዔርዛ ዓሶ</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3"/>ታ ዒጊኖንሢዮቴ! ኑም ቢያሢም ማዔ ዻቂንቶ ዛሎ ታ ዒንሢም ፃኣፓኒ ጌዔኔ፥ ሃሢ ላሚ ሺርቱዋ ጎይሢና ጌኤዦ ዓሶም ፔቴና ዒንጊንቴ ጉሙርቂፆ ዛሎ ዶዲ ዒንሢ ዖልታንዳጉዲ ዞሮ ታ ዒንሢም ፃኣፓንዳያ ታና ኮይሴኔ። <verse eid="JUD 1:3"/><verse number="4" style="v" sid="JUD 1:4"/>ዔያቶይዳ ዎጊንታንዳያ ማዒፃ ሚርጌ ዎዴኮ ቤርታ ፃኣፒንቴያ ማዔ ፔቴ ፔቴ ዓሳ ዒንሢኮ ባኣኮ ዴሚና ፑኒ ጌሌኔ፤ ዔያታ ኑ ፆኦዛሢኮ ኮሹሞ ዒንጊፆ ፔ ሱኡካ ዓይሣ ጎይፆ ላኣሚ ላኣሚ ሺራ ጎሜ ዓሲኬ፤ ዒዚ ኑኡኮ ሌሊ ኑና ዎይሣያና ኑ ጊዳ ጎዳታያ ማዔ ዬሱስ ኪሪስቶሴያ ዔያታ «ዔሩዋሴ» ጋዓኔ።<verse eid="JUD 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5"/>ዬያ ቢያ ዒንሢ ቤርታዺ ዔራያ ማዔቶዋ፥ ፆኦሲ ፔ ዴሮ ጊብፄ ዓጮይዳፓ ኬሲ ዻቂሼሢና ዒዛ ጉሙርቂባኣ ዓሶ ጊንፃፓ ባይዜያ ማዔሢ ታ ዒንሢም ጶቂሣኒ ኮዓኔ። <note caller="-" style="x"><char style="xo" closed="false">5 </char><char style="xt" closed="false"><ref loc="EXO 12:51">ኬሲ. ማፃ 12፡51</ref>፤ <ref loc="NUM 14:29-30">ፓይ. ማፃ 14፡29-30</ref>።</char></note> <verse eid="JUD 1:5"/><verse number="6" style="v" sid="JUD 1:6"/>ዬያጉዲ ሃሣ ፔኤኮ ቦንቾ ካፒ ዒፂ ፔ ቤዞዋ ሃሼ ፆኦሲ ኪኢታንቾ ማሉዋቴ፤ ፆኦሲ ዔያቶ ዼኤፖ ዎጎ ኬሎ ሄላንዳኣና ናንጊና ቱኡሲዳ፤ ሃሣ ዼኤፒ ዹሚዳ ጌሢ ካፒ ዓኣኔ። <verse eid="JUD 1:6"/><verse number="7" style="v" sid="JUD 1:7"/>ዬኖ ጎይፆ ሶዶሜና ጋሞራና ሃሣ ኮይሎይዳ ዓኣ ካታማኣ ማቾ ሃሣ ዓኒ ማዒባኣ ዓሲና ላሂ ጎሜ ማዼኔ፤ ቤርታ ማዢንታፓ ዓርቃዖ ዓኣ ዎጎ ላኣሚ ዱማ ጎይሢና ዔያታ ዎላ ላሄኔ። ዬያሮ ዔያታ ናንጊና ባይቁዋ ታሞይዳ ሚቺንታንዳ ዓሶም ኮኦኪንሢ ማዔኔ። <note caller="-" style="x"><char style="xo" closed="false">7 </char><char style="xt" closed="false"><ref loc="GEN 19:1-24">ማዢ. ማፃ 19፡1-24</ref>።</char></note><verse eid="JUD 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8"/>ዬያጉዲ ዬና ዓሳ ዓውቲ ጌዔ ጊንሢ ዓኣዺ ዓኣዺ ፔ ዓሽኮ ዒኢሳኔ፤ ፆኦሲኮዋ ዓኣ ቢታንቶ ቦሃኔ፤ ሃሣ ጫሪንጮይዳ ቦንቻ ዓኣ ማዢንቶዋ ዔያታ ጫሽካኔ። <verse eid="JUD 1:8"/><verse number="9" style="v" sid="JUD 1:9"/>ፆኦሲ ኪኢታንቾኮ ሱኡጋሢ ሚካዔኤሌ ጎዖሢታዖ ሙሴኮ ሌዞ ዛሎ ፃላሄና ዎላ ማርሜያና «ፆኦሲ ኔና ጎሮንጎ» ጌዔያፓዓቴም ጫሽኪ ዒዛይዳ ዎጋኒ ጫርቂባኣሴ። <note caller="-" style="x"><char style="xo" closed="false">9 </char><char style="xt" closed="false"><ref loc="DAN 10:13">ዳኣኔ. 10፡13</ref>፤<ref loc="DAN 10:21">21</ref>፤ <ref loc="DAN 12:1">12፡1</ref>፤ <ref loc="REV 12:7">ዮሃ. ፆፔዻ 12፡7</ref>፤ <ref loc="DEU 34:6">ላሚ. ዎማ 34፡6</ref>፤ <ref loc="ZEC 3:2">ዛካ. 3፡2</ref>።</char></note> <verse eid="JUD 1:9"/><verse number="10" style="v" sid="JUD 1:10"/>ዬያታ ዓሳ ጋዓንቴ ፔ ቶኦኪና ዔራኒ ዳንዳዒባኣ ጫሺ ጫሽካኔ፤ ማሊሢባኣ ቦዖጉዲ ፔኤኮ ማዢንታፓ ዔያታ ዔራ ባኣዚ ዓኣያ ማዔቶዋ ዬያና ዎላ ባይቃንዳኔ። <verse eid="JUD 1:10"/><verse number="11" style="v" sid="JUD 1:11"/>ቃኣዔኤሌ ዓኣዼ ጎይፆ ዔያታ ዓኣዼሢሮ፥ ሚኢሾሮ ጌዒ ባኣላኣሜ ዻቢንቴ ጎይፆ ዔያታኣ ዻቢንቴሢሮ ሃሣ ቆራሄ ጎዖሢ ዒፂ ማኬሢጉዲ ዔያታኣ ዒፂ ማኪ ባይቄሢሮ ዔያቶ ባዴዔ! <note caller="-" style="x"><char style="xo" closed="false">11 </char><char style="xt" closed="false"><ref loc="GEN 4:3-8">ማዢ. ማፃ 4፡3-8</ref>፤ <ref loc="NUM 22:1-35">ፓይ. ማፃ 22፡1-35</ref>፤ <ref loc="NUM 16:1-35">16፡1-35</ref>።</char></note> <verse eid="JUD 1:11"/><verse number="12" style="v" sid="JUD 1:12"/>ዬያታ ዓሳ ቦርሲንቲ ባኣያና ዎሊና ዓማሊ ዒንሢ ናሹሞና ቡኪንቲ ሙዓ ሙዖ ባኣኮይዳ ጴዺ ዒንሢኮ ዹቆ ማዓኔ፤ ዔያታ ማላሢ ፔ ቶኦኮሮ ሌሊኬ፤ ሃሣ ዔያታ ዢባሬና ሂዒንታያ ዒርዚባኣ ሻኣሬጉዴያኬ። ሚፃ ዓኣፓ ዎዶናታዖ ዓኣፒ ጴዹዋያ፥ ፃጳፓ ቱጊንቲ ሜሊ ሃይቄ ሚሢጉዴያኬ። <verse eid="JUD 1:12"/><verse number="13" style="v" sid="JUD 1:13"/>ዔያቶኮ ቦርሲሳ ማዾ ዓዳ ዱባጉዲ ዔያታ ዱባሳያ ዼኤፖ ዢባሮና ሂዒንቲ ዓጊፃ ባዞ ዋኣፆጉዴያኬ፤ ሃሣ ዔያቶ ሻኔ ዹሚ ናንጊና ካፓያ፥ ሴካ ሃንጋ ጌዒ ላቢንቲ ሃንታ ዦኦጋሢጉዴያኬ።<verse eid="JUD 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14"/>ዓዳኣሜይዳፓ ዓርቃዖ ላንካሳ ሾይንቲ ማዔ ሄኖኬ ዬያቶ ዓሶ ዛሎ፦ «ሃይሾ ጎዳሢ ሚርጌ ሺያና ፓይዲንታ ጌኤሺ ዓሲና ዎላ ሙካንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">14 </char><char style="xt" closed="false"><ref loc="GEN 5:18">ማዢ. ማፃ 5፡18</ref>፤<ref loc="GEN 5:21-24">21-24</ref>።</char></note> <verse eid="JUD 1:14"/><verse number="15" style="v" sid="JUD 1:15"/>ዒዚ ሙካንዳሢያ ዓሲ ቢያይዳ ዎጋኒ፥ ዓይሢንቶ ዒፃ ዓሶና ጎሞ ዓሶና ቢያ ዔያታ ዻቢንቲ ማዻ ማዾ ቢያሢና ሃሣ ፆኦሲ ጫሽኬ ጫዦና ቢያ ፔጋሳኒኬ» ጌዒ ፆኦሲ ማሊሢ ኬኤዜኔ።<verse eid="JUD 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JUD 1:16"/>ዬያታ ዓሳ ቢያ ዎዴ ጉንዱማያ፤ ሃሣ ፔቴ ባኣዚናታዖ ዎዛዹዋያኬ፤ ዔያቶኮ ፑርቱሞ ሱኡኮ ሌሊ ኩንሣያ ዻንጋኣ ዔያቶኮ ዖቶርሞ ዑኡሲና ኩሜያኬ፤ ዬያጉዲ ዔያታ ፔና ማኣዳንዳ ባኣዚ ሌሊ ኮዒ ኮዒ ዓሲ ጌሻኔ።<verse eid="JUD 1:16"/></para>
  <para style="s1">ላቲሢና ዞሮና</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17"/>ዒንሢ ጋዓንቴ ዒጊኖንሢዮቴ! ኑ ጎዳሢ ዬሱስ ኪሪስቶሴኮ ዳኪንቴዞንሢ ሃያኮ ቤርታ ኬኤዜ ቃኣሎ ጶቂሡዋቴ። <verse eid="JUD 1:17"/><verse number="18" style="v" sid="JUD 1:18"/>ዔያታ ኬኤዛዖ፦ «ዎዶኮ ጋፒንፆይዳ ፔ ሼና ዓይሤ ሱኡኮ ኩንሣ፥ ጌሻ ዓሲ ሙካንዳኔ» ዒንሢም ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">18 </char><char style="xt" closed="false"><ref loc="2PE 3:3">2ጴፂ. 3፡3</ref>።</char></note> <verse eid="JUD 1:18"/><verse number="19" style="v" sid="JUD 1:19"/>ዔያታ ዓሲ ዎሊፓ ፓቃያ፥ ዓሲ ማሊሢ ሱኡኬ ኩንሣያ፤ ሃሣ ዓያና ጌኤሺያ ዔያቶይዳ ባኣ ዓሲኬ። <verse eid="JUD 1:19"/><verse number="20" style="v" sid="JUD 1:20"/>ዒንሢ ጋዓንቴ ዒጊኖንሢዮቴ! ቢያፓ ዑሣ ዓኣዼ ጌኤሺ ማዔ ጉሙርቂፆና ዒንሢ ቶኦኮ ጌኤሻኒ ማሉዋቴ፤ ዓያና ጌኤሺ ዎልቄናኣ ሺኢቁዋቴ። <verse eid="JUD 1:20"/><verse number="21" style="v" sid="JUD 1:21"/>ኑ ጎዳ ዬሱስ ኪሪስቶሴ ፔኤኮ ማኣሪፆና ናንጊና ናንጊ ሼምፖ ዒንሢም ዒንጋንዳጉዲ ካፒ ካፒ ዒንሢ ቶኦኮ ፆኦሲ ናሹሞ ጋሮይዳ ማሂ ዓርቁዋቴ።<verse eid="JUD 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22"/>«ዬይ ማዓንዳ?» ጌዒ ዓልታ ዓሶም ናሹሞና ኮሺ ባኣዚ ማዹዋቴ፤ <verse eid="JUD 1:22"/><verse number="23" style="v" sid="JUD 1:23"/>ፔቴ ፔቴ ዓሶ ታሞይዳፓ ዓይሲ ዻቂሹዋቴ፤ ሃንጎ ዓሶ ሚጪንቲሢና ዒጊጪ ማኣሩዋቴ፤ ያዺ ማዔቶዋ ዔያቶኮ ጎሞና ዒኢቴ ዑፆ ሄሌ ዓፒላታዖ ዓቱዋንቴ ፒኢሉዋቴ።<verse eid="JUD 1:23"/></para>
  <para style="s1">ፆኦሲ ጋላቲሢ</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24"/>ዒንሢ ሎኦሙዋጉዲ ማሃኒና ቦርሲሳ ባኣዚ ባኣያ ማሃኒ ዎዛና ዒዛኮ ቦንቾ ቤርቶ ዒንሢ ሺኢሻኒ ዳንዳዓሢም፥ <verse eid="JUD 1:24"/><verse number="25" style="v" sid="JUD 1:25"/>ዒዚ ሌሊ ኑና ዻቂሻሢ ማዔ ፆኦዛሢም፥ ኑ ጎዳሢ ዬሱስ ኪሪስቶሴ ዛሎና ሚናፓ ዓርቃዖ፥ ሃሢያ፥ ናንጊና ቦንቾና ዼኤፑሞና፥ ዎልቄና ቢታንቶና ቢያ ዒዛም ማዖንጎ! ዓኣሜን።<verse eid="JUD 1:25"/></para>
  <chapter eid="JUD 1"/>
</usx>
