<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- MAALE Full Bible</book>
  <para style="h">ዒዩዔኤሌ ማፃኣፖ</para>
  <para style="toc1">ፆኦሲ ማሊፆ ኬኤዛ ዒዩዔኤሌ ማፃኣፖ</para>
  <para style="toc3">ዒዩ.</para>
  <para style="toc2">ዒዩዔኤሌ ማፃኣፖ</para>
  <para style="mt1">ዒዩዔኤሌ</para>
  <para style="imt">ዓይፆ ካሮ</para>
  <para style="ip">ፆኦሲ ማሊፆ ኬኤዜ ዒዩዔኤሌ ዎማ ዎዶይዳ ናንጌቴያ፤ ሃሣ ዒዚ ናንጌ ጎይፆ ኬኤዛ ሃይሴ ሜርጌ ዔርታይ ባኣሴ፤ ያዺ ማዔቴያ ማፃኣፓ ፃኣፒንቲ ዓኣያ ማዒ ጴዼሢ ኪሪስቶሴ ሾይንታዳሢኮ ቤርታ ዶንጋሳ ፄኤቶ ሌዖኮ ሃንጎ ዖይዳሳ ፄኤቶ ሌዖኮ ጋራኣኬ ጌይንታኔ፤ ዬይ ዎዳ ፓሪሴ ካኣቲ ካኣታዺ ዎይሣ ዎዶናኬ። ዒዩዔኤሌ ዒስራዔኤሌ ዓጮ ዓቢሢ ሙካንዳሢና ኪሊንኮ ሉማ ኬስካንዳ ዎዶዋ ፔጋሲ ኬኤዜኔ፤ ናንጊና ናንጋ ጎዳ ኬላ ሙካኒ ዑኬያ ማዒፆ ዬይ ባካ ዔርዛያታሢ ዒዚ ኬኤዛኔ፤ ናንጊና ናንጋ ጎዳኮ ኬላ ሙካኣና ዒዛኮ ዱማዼ ማሊፆ ዒፂ ማካዞንሢዳ ቢያ ሜቶ ናንጊና ናንጋ ጎዳ ዓጋንዳሢ ቃሲ ዒ ኬኤዛኔ። ፆኦሲ ማሊፆ ኬኤዛሢ ዴራ ፔኤኮ ጎሞ ቡኡፃንዳጉዲ ፆኦሲ ዔኤላያ ማዒፆ ፔጋሲ ኬኤዚ፥ ዴራ ጎሞ ፔኤኮ ቡኡፄቴ ዔያታ ዎንዴ ናንጋ ጎይፆ ባንሢ ማሂ ዓንጃንዳሢ ዒዚ ዔያቶም ኬኤዛኔ። ዒዚ ኬኤዜ ፆኦሲ ማሊፆይዳ ባሼ ዓኣፒ ማዒ ጴዻ፥ ሃጊ ማዓንዳ ዎዞ ቃኣላ፦ ፆኦሲ ዓቲንቆንታ ላኣሎንታ ዼጌሢንታ ጋርቾዋ ዓይሱዋዖ ዴሮ ቢያ ዑፃ ፔኤኮ ዓያኖ ኬይሳንዳሢ ፔጋሲ ኬኤዛሢኬ።</para>
  <para style="iot">ማፃኣፔላ ዱማ ዱማ ዓርቄ ባኮ</para>
  <para style="io1">ሳዖ ባይዛኒ ሙኬ ዓቢፆ (1፡1—2፡17)</para>
  <para style="io1">ናንጊና ናንጋ ጎዳ ኬሎ (2፡18-32)</para>
  <para style="io1">ናንጊና ናንጋ ጎዳ ሜሌ ዴሮይዳ ሜቶ ዓጋንዳሢ (3፡1-21)</para>
  <chapter number="1" style="c" sid="JOL 1"/>
  <para style="s1">ዓቢፃ ዒስራዔኤሌ ዓጮ ሙይ ባይዜሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1"/>ባኣቱዔኤሌ ናኣዚ ዒዩዔኤሌም ናንጊና ናንጋ ጎዳፓ ዳኪንቴ ኪኢቶ ቃኣላ ያዺኬ፦<verse eid="JOL 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 1:2"/>ዒንሢ ጋርቾ ዓሳ ዋይዙዋቴ!</para>
  <para style="q2" vid="JOL 1:2">ዪሁዳ ዓጫ ናንጋ ዓሳ ቢያ ዒናፓ ዋይዙዋቴ!</para>
  <para style="q" vid="JOL 1:2">ዒንሢ ናንጌ ዎዶይዳ ሃያ ጉዴ ባኣዚ፤</para>
  <para style="q2" vid="JOL 1:2">ጊንሣ ሃሣ ዒንሢኮ ቤርታኣ ዓዶንሢ ዎዶናኣ ዓሲ ዛጊ ቤቂያ?<verse eid="JOL 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 1:3"/>ዬያ ባኮ ዒንሢኮ ናኣቶም ኬኤዙዋቴ፤</para>
  <para style="q2" vid="JOL 1:3">ዒንሢኮ ናኣታ ጊንሣ ፔ ናኣቶም ኬኤዞንጎ፤</para>
  <para style="q2" vid="JOL 1:3">ዬያታኣ ዔያቶ ሄሊ ሙካ ሾይንቶም ኬኤዞንጎ።<verse eid="JOL 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 1:4"/>ሜልካሢዳፓ ዓቴ ሃኣኮ ባቃሎ</para>
  <para style="q2" vid="JOL 1:4">ሻዻ ዓቢፃ ሙዔኔ፤</para>
  <para style="q2" vid="JOL 1:4">ዬካፓ ዓቴሢ ሃሣ ዢኢፓ ዒርዚጉዲ ዲኢና</para>
  <para style="q2" vid="JOL 1:4">ዓቢፃ ሙይ ባይዜኔ፤</para>
  <para style="q2" vid="JOL 1:4">ዓቴሢያኣ ማካሢ ሙዔኔ።<verse eid="JOL 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 1:5"/>ሃይካፓ ሴካ ዒንሢ ሙርጎ ዎይኖ ዑዦ ዻንጋ ካንሢንዱዋኣሢሮ</para>
  <para style="q2" vid="JOL 1:5">ዒንሢ ማሢንታ ዓሳ ጊንዓስካፓ ጴጪ ዬኤኩዋቴ፤</para>
  <para style="q2" vid="JOL 1:5">ዒንሢ ቢያ ዎዴ ዎይኖ ዑዦ ዑሽካ ዓሳ!</para>
  <para style="q2" vid="JOL 1:5">ዒናፓ ቃዪ ዬኤኩዋቴ።<verse eid="JOL 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 1:6"/>ዎልቄና ዓኣ ዑሣ ዓኣዼ ዺቤ ሜሌ ዴሬ</para>
  <para style="q2" vid="JOL 1:6">ታ ዓጮ ዖሊ ባይዛኒ ሙኬኔ፤</para>
  <para style="q2" vid="JOL 1:6">ዬያ ዖሎ ዓሶኮ ዓጫ ዞቢ ዓቺጉዲኬ፤</para>
  <para style="q2" vid="JOL 1:6">ባንጋላ ጊንሣ ሃሣ ዒንዴ ዞቢሮጉዲኬ። <note caller="-" style="x"><char style="xo" closed="false">1፡6 </char><char style="xt" closed="false"><ref loc="REV 9:8">ዮሃ. ፆፔዻ 9፡8</ref>።</char></note><verse eid="JOL 1:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 1:7"/>ታኣኮ ቱኮና ዎይኖ ቢያ ሙይ ባይዜኔ፤</para>
  <para style="q2" vid="JOL 1:7">ቤሌሴ ሚፆዋ ቆፂ ሙዔኔ፤</para>
  <para style="q2" vid="JOL 1:7">ዬያ ሚፆኮ ዛንዞዋ ቦኦሪሺ</para>
  <para style="q2" vid="JOL 1:7">ቁኡሮ ቢያ ፒኢቲ ሙዔኔ።<verse eid="JOL 1:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 1:8"/>ዒዞ ጎቺ ዴዓያታዖ ሃይቄ ዼጌሮ</para>
  <para style="q2" vid="JOL 1:8">ሲዬ ፓቲሌ ማይንቲ ዬኤካ</para>
  <para style="q2" vid="JOL 1:8">ዉዱሮ ናይጉዲ ዒንሢያ ዬኤኩዋቴ።<verse eid="JOL 1:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 1:9"/>ናንጊና ናንጋ ጎዳ ማኣሮይዳ ዒንጎ ባኣዚ ማሂ ሺኢሾ</para>
  <para style="q2" vid="JOL 1:9">ሃኣኮንታ ዎይኖ ዑዦንታ ባይቄሢሮ</para>
  <para style="q2" vid="JOL 1:9">ናንጊና ናንጋ ጎዳም ማዻያ ማዔ ቄኤሳ ዬኤካኔ።<verse eid="JOL 1:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 1:10"/>ጎዣ ጎሽኪንቴ ጎይሣ ጉሪ ዓቴኔ፤</para>
  <para style="q2" vid="JOL 1:10">ሃኣኮ ዒኢካ ባኣያ ማዔኔ፤</para>
  <para style="q2" vid="JOL 1:10">ቱኮና ዎይናኣ ሃይቄኔ፤</para>
  <para style="q2" vid="JOL 1:10">ዛይታኣ ባይቄኔ፤</para>
  <para style="q2" vid="JOL 1:10">ዬያሮ ሳዓ ዬኤካኔ።<verse eid="JOL 1:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 1:11"/>ዛርጋሢንታ ዔልዖንታ፤ ሜሌ ካፃ ሃኣካኣ ቢያ ባይቄሢሮ</para>
  <para style="q2" vid="JOL 1:11">ዒንሢ ጎዦ ጎሽካ ዓሳ ዖዩዋቴ፤</para>
  <para style="q2" vid="JOL 1:11">ዒንሢ ዎይኖ ቱካ ዓሳኣ ዬኤኩዋቴ።<verse eid="JOL 1:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 1:12"/>ቱኮና ዎይኖንታ ቤሌሶ ሚፆንታ ሹሌኔ፤</para>
  <para style="q2" vid="JOL 1:12">ሮኦማኣኔ፥ ቴሚሬ ጌይንታ ሚፃ፥ ሙቃሎንታ ሜሌ ዓኣፖ ዓኣፓ ሚፃ ቢያ ሜሌኔ፤</para>
  <para style="q2" vid="JOL 1:12">ዬያሮ ጎኔና ዓሲ ዎዛዻ ዎዛ ባይቄኔ።<verse eid="JOL 1:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 1:13"/>ዒንሢ ፆኦዛሢም ዒንሢ ዒንጋ ሃኣኮንታ ዎይኖ ዑዦ ዒንጊፆንታ ባኣሢሮ</para>
  <para style="q2" vid="JOL 1:13">ዒንሢ ታ ፆኦዛሢም ማዻ ቄኤሳ!</para>
  <para style="q2" vid="JOL 1:13">ሃኒ ዬዒ፥ ሲዬ ፓቲሌ ማይንቲ ዋንቶ ጉቤ ዬኤኩዋቴ፤</para>
  <para style="q2" vid="JOL 1:13">ዒንሢ ዒንጎ ባኮ ዒንጎ ቤዞይዳ ማዻ ዓሳ ቃዪ ዬኤኩዋቴ።<verse eid="JOL 1:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 1:14"/>ሙኡዚ ሃሾ ዱማ ኬሊ ሜንሡዋቴ!</para>
  <para style="q2" vid="JOL 1:14">ፆኦሲም ዱማዼ ቡኪንቲ ዴሮ ቡኩሱዋቴ!</para>
  <para style="q2" vid="JOL 1:14">ጋርቾንታ ዓጮይዳ ናንጋ ዓሶዋ ቢያ</para>
  <para style="q2" vid="JOL 1:14">ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢ ማኣሪ ቡኩሱዋቴ፤</para>
  <para style="q2" vid="JOL 1:14">ዒኢካ ፆኦሲ ዒንሢም ዋይዛንዳጉዲ ዬኤኩዋቴ።<verse eid="JOL 1:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 1:15"/>ባዴዔ! ናንጊና ናንጋ ጎዳ ኬላ ዑኬኔ!</para>
  <para style="q2" vid="JOL 1:15">ቢያ ባኮ ዳንዳዓ ጎዳሢ ባይሲንታ ዔኬ ሙካ ኬላ ሄሌኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡15 </char><char style="xt" closed="false"><ref loc="ISA 13:6">ዒሲ. 13፡6</ref>።</char></note><verse eid="JOL 1:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="JOL 1:16"/>ሃኣኮ ኑ ዓኣፓፓ</para>
  <para style="q2" vid="JOL 1:16">ዎዛና ዒላሺሢና ኑ ፆኦዛሢኮ ጌኤዦ ማኣራፓ</para>
  <para style="q2" vid="JOL 1:16">ጋፒ ባይቄኔ።<verse eid="JOL 1:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 1:17"/>ዜርቂንቴ ዜርፃ ቢያ ሳዖይዳ ሙርዒ ዓቴኔ፤</para>
  <para style="q2" vid="JOL 1:17">ሃኣካ ባይቄሢሮ ሃኣኮ ናቶ ቤዛ ቢያ ጉሪ ማዔኔ፤</para>
  <para style="q2" vid="JOL 1:17">ኮናኣ ዶዔኔ።<verse eid="JOL 1:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 1:18"/>ባኣታ ሄንቃንዳ ማኣቲ ባይቄሢሮ ዖኦላኔ፤</para>
  <para style="q2" vid="JOL 1:18">ማራታኣ ቢያ ናይዺንቲ ካራ ባይዚ ዓኣኔ።<verse eid="JOL 1:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 1:19"/>ናንጊና ናንጋ ጎዳሢዮ! ቦኦሎይዳ ዓኣ ማኣቶ ቢያ ታሚ ሙዔሢሮ</para>
  <para style="q2" vid="JOL 1:19">ካዮ ሚፆዋ ታሚ ሚቼሢሮ</para>
  <para style="q2" vid="JOL 1:19">ታኣኒ ኔ ባንሢ ዒላታኔ።<verse eid="JOL 1:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 1:20"/>ዎራ ሚጬሢሮ</para>
  <para style="q2" vid="JOL 1:20">ቦኦሎ ማኣታ ቢያ ሜሊ ባይቄሢሮ</para>
  <para style="q2" vid="JOL 1:20">ካዮ ቦዓታዖ ዓቱዋዖ ኔ ባንሢ ዒላታኔ።<verse eid="JOL 1:20"/></para>
  <chapter eid="JOL 1"/>
  <chapter number="2" style="c" sid="JOL 2"/>
  <para style="s1">ናንጊና ናንጋ ጎዳ ኬሎ ሙኮ ዓቢፃ ዔርዛያ ማዒፆ</para>
  <para style="q">
    <verse number="1" style="v" sid="JOL 2:1"/>ፂዮኔይዳ ዛዬ ዋርቁዋቴ! ፆኦሲም ዱማዼ ዹኮይዳኣ</para>
  <para style="q2" vid="JOL 2:1">ኬስኪ ዒላቱዋቴ!</para>
  <para style="q" vid="JOL 2:1">ናንጊና ናንጋ ጎዳ ኬላ ሙካኒ ዑኬሢሮ</para>
  <para style="q2" vid="JOL 2:1">ዓጬሎይዳ ናንጋ ዓሳ ቢያ ጎጋይቆንጎ።<verse eid="JOL 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 2:2"/>ዬና ኬላ ዹማያና ቃኣያዻ ኬሊ፤</para>
  <para style="q2" vid="JOL 2:2">ሻኣራዻያና ሻኒ ዹማ ኬሊኬ፤</para>
  <para style="q2" vid="JOL 2:2">ዓባ ፆርቃኣና ፖዓ ዹኮ ዑፆይዳ ጴዻሢጉዲ</para>
  <para style="q2" vid="JOL 2:2">ዺቢ፤ ሃሣ ዎልቃዻ ሜሌ ዴሬ ቢያ ቤዞ ሙኪ ባይዛንዳኔ።</para>
  <para style="q" vid="JOL 2:2">ዬያጉዴ ባኣዚ ሃያኮ ቤርታ ዛጊንቲ ቤቂባኣሴ፤</para>
  <para style="q2" vid="JOL 2:2">ሃካፓ ሴካ ዓይዲያ ጴዻዓኬ።<verse eid="JOL 2:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="JOL 2:3"/>ዔያቶኮ ቤርታ ጴዻ ዓኣዔ ባኮ ቢያ ታሚጉዲ ዔያታ ሙዓንዳኔ፤</para>
  <para style="q2" vid="JOL 2:3">ዔኤታ ታሚጉዲያኣ ሚቻንዳኔ።</para>
  <para style="q2" vid="JOL 2:3">ሃጊ ዔያታ ሄሊባኣ፥ ቤርታ ዓኣ ሳዓ</para>
  <para style="q2" vid="JOL 2:3">ዔዴኔ ጌይንታ ቤዞጉዴያ ዓኣዔ ባኣዚ ዋርቂ ዓኣያኬ፤</para>
  <para style="q2" vid="JOL 2:3">ዔያታ ሙይ ጊዴና ዓኣዻ ሳዓ ጋዓንቴ</para>
  <para style="q2" vid="JOL 2:3">ጋፒ ባይቄያ ዓሲ ናንጉዋ ዳውሌ ማዓኔ፤</para>
  <para style="q2" vid="JOL 2:3">ዔያቶይዳፓ ቶሊ ዓታንዳ ዓይጎ ባኣዚያ ባኣሴ።<verse eid="JOL 2:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 2:4"/>ዔያቶኮ ማላሢ ፓሮ ማላኔ፤</para>
  <para style="q2" vid="JOL 2:4">ዔያታ ዖሎ ፓራሢጉዲያኣ ሳጋራኔ።<verse eid="JOL 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 2:5"/>ዓዳ ሳርጌሎ ዖይቶጉዴ ዑኡሲ ዋይዚሲ ዋይዚሲ</para>
  <para style="q2" vid="JOL 2:5">ዹኮ ቶኦኮይዳ ኮኦማኔ፤</para>
  <para style="q2" vid="JOL 2:5">ሃኣኮኮ ዲኢሪ ሙዓ ታሚጉዲ</para>
  <para style="q2" vid="JOL 2:5">ቢያ ባኮ ዔያታ ሙዓኔ፤</para>
  <para style="q2" vid="JOL 2:5">ዖልዚም ጊኢጊንቴ ዺቢ ዖልዚ ዓሲጉዲ ቤሲ ቤሲ ዓርቂ ዴዔኔ። <note caller="-" style="x"><char style="xo" closed="false">2፡5 </char><char style="xt" closed="false"><ref loc="REV 9:7-9">ዮሃ. ፆፔዻ 9፡7-9</ref>።</char></note><verse eid="JOL 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 2:6"/>ዔያቶ ዴንቃ ዴራ ካራ ባይዚ ጎጋይቃኔ፤</para>
  <para style="q2" vid="JOL 2:6">ዓሶኮ ቢያ ዓኣፖ ካራ ዒጊቹሞና ቦኦራኔ።<verse eid="JOL 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 2:7"/>ዔያታ ዖልዚ ዓሲጉዲ ዔርቲባኣንቴ ዖልዚ ቡላኔ፤</para>
  <para style="q2" vid="JOL 2:7">ዖላ ዓሶጉዲያኣ ኬኤሎ ዲሮ ዑፆ ጊዓንዳኔ፤</para>
  <para style="q2" vid="JOL 2:7">ቢያሢ ዔያታ ዓርቄ ጎይፆ ዻቡዋዖ</para>
  <para style="q2" vid="JOL 2:7">ዓኣዻ ካሮማና ጎዓንዳኔ።<verse eid="JOL 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 2:8"/>ፔቴይ ባጋሢና ዎሊ ሂዑዋሴ፤</para>
  <para style="q2" vid="JOL 2:8">ፔቴ ፔቴሢ ፔ ጎይፆማ ዓኣዻኔ፤</para>
  <para style="q2" vid="JOL 2:8">ሞርኮኮ ዋርዲዮ ሻሂ ዓኣዻኔ፤</para>
  <para style="q2" vid="JOL 2:8">ዔያቶ ቃዛ ባኣዚ ባኣሴ።<verse eid="JOL 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 2:9"/>ዔያታ ካታሞ ጌሊ ዓርቃኔ፤</para>
  <para style="q2" vid="JOL 2:9">ካታሞኮ ዙሎ ዲርቆና ኬኤሎ ዲፆ ዑፃ ጳሽካኔ፤</para>
  <para style="q2" vid="JOL 2:9">ጱሊ ጱሊ ማኣሮ ዑፆዋ ኬስካኔ፤</para>
  <para style="q2" vid="JOL 2:9">ዓዳ ዉሲጉዲ ማኣሮኮ ፑልቶ ካሮና ጋሮ ጌላኔ።<verse eid="JOL 2:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="JOL 2:10"/>ሳዖ ዔያታ ጎቃይሳኔ፤</para>
  <para style="q2" vid="JOL 2:10">ጫሪንጮዋ ዔያታ ዓጊሣኔ፤</para>
  <para style="q" vid="JOL 2:10">ዓቦንታ ዓጊኖንታ ዹማኔ፤</para>
  <para style="q2" vid="JOL 2:10">ዦኦጋሢያ ፖዑዋያ ማዓኔ። <note caller="-" style="x"><char style="xo" closed="false">2፡10 </char><char style="xt" closed="false"><ref loc="REV 8:12">ዮሃ. ፆፔዻ 8፡12</ref>።</char></note><verse eid="JOL 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 2:11"/>ናንጊና ናንጋ ጎዳ ጉጉንሢጉዴ ዑኡዞ ዬያ ዖሎ ዓሶ ዋይዚሳኔ፤</para>
  <para style="q2" vid="JOL 2:11">ዬይ ዖሎ ዓሳ ዎዚ ሚርጋይ!</para>
  <para style="q" vid="JOL 2:11">ዓይሢፆ ዒዛኮ ኩንሣ ዬይ ዖሎ ዓሳ ኮሺ ዺቢኬ፤</para>
  <para style="q2" vid="JOL 2:11">ዬይ ሚርጌ ዒጊቻያ ማዔሢሮ ዬያ ኬሎና ዖኦኒ ዳንዳዒ ዔቃንዳይ? <note caller="-" style="x"><char style="xo" closed="false">2፡11 </char><char style="xt" closed="false"><ref loc="REV 6:17">ዮሃ. ፆፔዻ 6፡17</ref>።</char></note><verse eid="JOL 2:11"/></para>
  <para style="s1">ጎሜ ቡኡፆም ኬኤዚንቴ ኪኢታ</para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 2:12"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦</para>
  <para style="q2" vid="JOL 2:12">«ሃሢ ሙኡዚ ሃሺሢና ዬኤፒና ዖዪሢና</para>
  <para style="q2" vid="JOL 2:12">ጉቤ ዒናፓ ታ ባንሢ ማዑዋቴ።<verse eid="JOL 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 2:13"/>ዒንሢ ዖያያ ማዒፆ ዔርዛኒ ማኣዓሢ ዒንሢኮ ዳርዚፖቴ፤</para>
  <para style="q2" vid="JOL 2:13">ጋዓንቴ ዒኖ ዒንሢኮ ሺኢቺ፥ ጎሞ ቡኡፁዋቴ።»</para>
  <para style="q2" vid="JOL 2:13">ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢ ኮሺ፥ ማኣራያ፥ ሩኡሪና ዻጋዹዋያ</para>
  <para style="q2" vid="JOL 2:13">ናንጊና ናንጋ ናሹማ ዺቢ፤</para>
  <para style="q2" vid="JOL 2:13">ፑርታ ባኣዚ ዓጋኒ ሩኡሩዋያ ማዔሢሮ</para>
  <para style="q2" vid="JOL 2:13">ዒዛ ባንሢ ማዑዋቴ።<verse eid="JOL 2:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 2:14"/>ጎዖንቴ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢ ዻጎ ሃሺ</para>
  <para style="q2" vid="JOL 2:14">ዓንጆ ዒንሢም ዒንጋንዳያ ናንዳኔ፤</para>
  <para style="q2" vid="JOL 2:14">ዒንሢያ ዒማና ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢም</para>
  <para style="q2" vid="JOL 2:14">ሃኣኮንታ ዑዦ ዒንጊፆንታ ዔኪ ሺኢሻንዳኔ።<verse eid="JOL 2:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="JOL 2:15"/>ፂዮኔ ዹኮይዳ ዛያሢ ዋርቁዋቴ!</para>
  <para style="q2" vid="JOL 2:15">ዴሮ ፆኦሲም ዱማዼ ቡኪንቲሮ ዔኤሉዋቴ!</para>
  <para style="q2" vid="JOL 2:15">ሙኡዚ ሃሻንዳጉዲያኣ ዴሮም ኬኤዙዋቴ!<verse eid="JOL 2:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 2:16"/>ዴሮ ቢያ ፔቴይዳ ቡኩሲ</para>
  <para style="q2" vid="JOL 2:16">ፆኦሲም ዱማዼ ቡኪንቲም ጊኢጊሹዋቴ፤</para>
  <para style="q2" vid="JOL 2:16">ጋርቾ ዓሶ ዔኤሉዋቴ፤</para>
  <para style="q2" vid="JOL 2:16">ዻኮ ናኣቶንታ ዻንፆ ዻንቃ ዓኣሎ ናኣቶዋ ዓይሱዋዖ ቡኩሱዋቴ፤</para>
  <para style="q2" vid="JOL 2:16">ዑኡታኣ ዓቱዋዖ ዑኡቱሞ ኬኤፃፓ ኬስኮንጎ።<verse eid="JOL 2:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 2:17"/>ናንጊና ናንጋ ጎዳም ማዻ ቄኤሳ</para>
  <para style="q2" vid="JOL 2:17">ፆኦሲም ዒንጎ ባኮ ዒንጎ ቤዞና</para>
  <para style="q2" vid="JOL 2:17">ጌኤዦ ማኣሮይዳ ዓሳ ቡካ ጶኦኮናኮ ባኣካ ዔቂ ዬኤኮንጎ፤</para>
  <para style="q" vid="JOL 2:17">ዔያታ፦ «ናንጊና ናንጋ ጎዳሢዮ! ኔኤኮ ዴሮ ሚጪንቴ፤</para>
  <para style="q2" vid="JOL 2:17">ሜሌ ዴራ ‹ዒንሢኮ ፆኦዛሢ ዎካ ዓኣይ?› ጌይ</para>
  <para style="q2" vid="JOL 2:17">ኑና ቶኦቻንዳጉዲና ሚኢጪ ዓማላንዳጉዲ ማሂፖ» ጎዖንጎ።<verse eid="JOL 2:17"/></para>
  <para style="s1">ናንጊና ናንጋ ጎዳ ፔ ዴሮ ጊንሣ ዶዲሺ ዔቂሳንዳሢ ኬኤዜሢ</para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 2:18"/>ናንጊና ናንጋ ጎዳ ሳዔላ ዒዛሮ ሌሊ ማዓንዳጉዲ ኮዒ</para>
  <para style="q2" vid="JOL 2:18">ፔ ዴሮም ሚጪንቴኔ፤<verse eid="JOL 2:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 2:19"/>ዬያሮ ዒዚ ሂዚ ጌዔኔ፦</para>
  <para style="q2" vid="JOL 2:19">«ሃኣኮንታ ዎይኖ ዑዦንታ ሪሚቶ ዛይቶንታ</para>
  <para style="q2" vid="JOL 2:19">ዒንሢ ሚሽካንዳያ ሄላንዳኣና ታ ዒንሢም ዒንጋንዳኔ፤</para>
  <para style="q2" vid="JOL 2:19">ሃካፓ ሴካ ሜሌ ዴራ</para>
  <para style="q2" vid="JOL 2:19">ሚኢጪ ዒንሢ ዓማላንዳጉዲ ታ ሃሻዓኬ።<verse eid="JOL 2:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 2:20"/>ዓጮኮ ኬዶ ዛላፓ ሙካ ዺቦ ዓቢፆ</para>
  <para style="q2" vid="JOL 2:20">ታ ዒንሢ ኮይላፓ ሃኪሳንዳኔ፤</para>
  <para style="q" vid="JOL 2:20">ዓሲ ናንጉዋ ዳውሎ ቦኦሎ ታኣኒ ዳውሲ ዳካንዳኔ፤</para>
  <para style="q2" vid="JOL 2:20">ዬያቶኮ ሶሮፖ ታኣኒ ሶኦጌ ባዚ፤</para>
  <para style="q2" vid="JOL 2:20">ጊንፃ ዓቴሢ ሃሣ ታኣኒ ሜዲቴራኒያ ባዞ ዳውሲ ጌልዛንዳኔ፤</para>
  <para style="q2" vid="JOL 2:20">ዒኢካ ዔያቶኮ ሌዛ ዛዓንዳኔ፤</para>
  <para style="q" vid="JOL 2:20">ጎኔና ታኣኒ፥ ናንጊና ናንጋ ጎዳ ዼኤፒ ባኣዚ ዒንሢም ማዼኔ።»<verse eid="JOL 2:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="JOL 2:21"/>«ሳዔሌ ዒጊጪፖ፤</para>
  <para style="q2" vid="JOL 2:21">ናንጊና ናንጋ ጎዳ ኔኤም ዼኤፒ ባኣዚ ማዼሢሮ ዎዛዼ!</para>
  <para style="q2" vid="JOL 2:21">ሃሣ ዒላሼ።<verse eid="JOL 2:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOL 2:22"/>ዒንሢ ካዮ ቦዓ ዒጊጪፖቴ፤</para>
  <para style="q2" vid="JOL 2:22">ዒንሢ ሄንቃ ቤዛ ዓኣ ማኣታ ዋርቄኔ፤</para>
  <para style="q2" vid="JOL 2:22">ሚፃኣ ዓኣፔኔ፤</para>
  <para style="q2" vid="JOL 2:22">ቤሌሶንታ ዎይኖ ዓኣፖንታ ኮሺ ሚርጌኔ።»<verse eid="JOL 2:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="JOL 2:23"/>«ዒንሢ ፂዮኔ ዴራ!</para>
  <para style="q2" vid="JOL 2:23">ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢ ዒንሢም ማዼ ባኮሮ</para>
  <para style="q2" vid="JOL 2:23">ዎዛዹዋቴ፥ ሃሣ ዒላሹዋቴ፤</para>
  <para style="q2" vid="JOL 2:23">ዒዚ ፒዜ ዎጌ ዎጊ</para>
  <para style="q2" vid="JOL 2:23">ዓዳ ቤርታኣ ጎይፆ ዖጎፆንታ ባርጎ ዓጊኖንታይዳ</para>
  <para style="q2" vid="JOL 2:23">ጊዳ ዒርዚ ዒንሢም ዋርቂሴኔ።<verse eid="JOL 2:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOL 2:24"/>ዒንሢኮ ሃኣኮ ሺርኮ ቆይዶይዳ ሃኣኮ ኩማንዳኔ፤</para>
  <para style="q2" vid="JOL 2:24">ዎይኖ ዑዦንታ ሪሚቶ ዛይቶንታ</para>
  <para style="q2" vid="JOL 2:24">ዒንሢ ጩኡጳ ዔቶ ኩሚ ሾኦታንዳኔ።<verse eid="JOL 2:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOL 2:25"/>ሚርጌ ዎዴ፦ ዺቢ ዖልዚ ዓሲጉዴያ ታ ዒንሢም ዳኬ፥ ዢኢፖ ዒሮጉዲ ዲኢና ዓቢፃ፥</para>
  <para style="q2" vid="JOL 2:25">ማካሢ፥ ሜልካሢንታ ሻዻ ዓቢፆንታ</para>
  <para style="q2" vid="JOL 2:25">ዒንሢኮ ሙይ ጋፒሴ ሃኣኮ ቤዛ ታ ዒንሢም ዒንጋንዳኔ።<verse eid="JOL 2:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOL 2:26"/>ሚርጌ ሙይ ዒንሢ ሚሽካንዳኔ፤</para>
  <para style="q2" vid="JOL 2:26">ሚርጌ ዲቃሢ ሄርሺሳ ባኣዚ ዒንሢም ማዼ</para>
  <para style="q2" vid="JOL 2:26">ታና፥ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢ ዒንሢ ጋላታንዳኔ፤</para>
  <para style="q2" vid="JOL 2:26">ዴራ ታኣኮ ሃካፓ ሴካ ቦርሲንታዓኬ።<verse eid="JOL 2:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOL 2:27"/>ታ ዴሬዮቴ! ታኣኒ ዒንሢ ባኣካ ዓኣሢ፤</para>
  <para style="q2" vid="JOL 2:27">ዒንሢኮ ፆኦዛሢያ ታና ሌሊ ማዔሢ፤</para>
  <para style="q2" vid="JOL 2:27">ታ ጊዳፓ ዓታዛ ሜሌ ፆኦሲ ባኣሢያ ዒንሢ ዔራንዳኔ፤</para>
  <para style="q2" vid="JOL 2:27">ታኣኮ ዴራ ሃካፓ ሴካ ቦርሲንታዓኬ።»<verse eid="JOL 2:27"/></para>
  <para style="s1">ናንጊና ናንጋ ጎዳ ኬሎ</para>
  <para style="q">
    <verse number="28" style="v" sid="JOL 2:28"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦</para>
  <para style="q2" vid="JOL 2:28">«ዓካሪ ታኣኮ ዓያኖ ዓሲ ቢያ ዑስካ ታኣኒ ኬይሳንዳኔ፤</para>
  <para style="q2" vid="JOL 2:28">ዒንሢኮ ዓቲንቆንታ ዉዱሮ ናኣቶንታ ታ ማሊሢ ኬኤዛንዳኔ፤</para>
  <para style="q2" vid="JOL 2:28">ጋርቻ ዒንሢኮ ዓውቲ ዓውታዻንዳኔ፤</para>
  <para style="q2" vid="JOL 2:28">ዼጌሢያ ታኣኒ ፔጋሲ ዻዋ ባኣዚ ዛጋንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">2፡28 </char><char style="xt" closed="false"><ref loc="ACT 2:17-21">ዳኪ. ማዾ 2፡17-21</ref>።</char></note><verse eid="JOL 2:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOL 2:29"/>ዬያጉዲ ሃሣ ዬንሢ ኬሎይዳ</para>
  <para style="q2" vid="JOL 2:29">ታኣም ማዻ ዓቲንቆንታ ላኣሎንታይዳ</para>
  <para style="q2" vid="JOL 2:29">ታኣኮ ዓያኖ ታኣኒ ኬይሳንዳኔ።»<verse eid="JOL 2:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="JOL 2:30"/>«ጫሪንጮና ሳዖናይዳ ዲቃሢ ሄርሺሳ ባኣዚ ታኣኒ ዻዋንዳኔ፤</para>
  <para style="q2" vid="JOL 2:30">ሱጉሢንታ ታሚንታ ጩቢያ ሻኣሬጉዲ ላሂ ጴዻንዳኔ።<verse eid="JOL 2:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOL 2:31"/>ዼኤፖ፥ ዒጊቻ፥ ጎዳ ኬላ ሙካንዳሢኮ ቤርታ</para>
  <para style="q2" vid="JOL 2:31">ዓባ ዹማንዳኔ፤ ዓጊናኣ ሱጉሢጉዲ ዞቃንዳኔ፤ <note caller="-" style="x"><char style="xo" closed="false">2፡31 </char><char style="xt" closed="false"><ref loc="MAT 24:29">ማቲ. 24፡29</ref>፤ <ref loc="MRK 13:24-25">ማር. 13፡24-25</ref>፤ <ref loc="LUK 21:25">ሉቃ. 21፡25</ref>፤ <ref loc="REV 6:12-13">ዮሃ. ፆፔዻ 6፡12-13</ref>።</char></note><verse eid="JOL 2:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOL 2:32"/>ናንጊና ናንጋ ጎዳ ማኣዳንዳጉዲ ዔኤላሢ ቢያ ዻቃንዳኔ፤</para>
  <para style="q2" vid="JOL 2:32">ናንጊና ናንጋ ጎዳ ኬኤዜ ጎይፆ ፂዮኔ ዹኮና</para>
  <para style="q" vid="JOL 2:32">ዬሩሳላሜናይዳፓ ዼኤሻ ጴዻንዳኔ፤</para>
  <para style="q2" vid="JOL 2:32">ዻቃ ዓሶ ባኣኮይዳ ናንጊና ናንጋ ጎዳ ዶኦሬ ዓሳ ዓኣያ ማዓንዳኔ።» <note caller="-" style="x"><char style="xo" closed="false">2፡32 </char><char style="xt" closed="false"><ref loc="ROM 10:13">ሮሜ 10፡13</ref>።</char></note><verse eid="JOL 2:32"/></para>
  <chapter eid="JOL 2"/>
  <chapter number="3" style="c" sid="JOL 3"/>
  <para style="s1">ናንጊና ናንጋ ጎዳ ሜሌ ዴሮይዳ ዎጋንዳያ ማዒፆ</para>
  <para style="q">
    <verse number="1" style="v" sid="JOL 3:1"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦</para>
  <para style="q2" vid="JOL 3:1">«ዬኖ ዎዶና ዬሩሳላሜና ዪሁዳናፓ ዲዒንቴ ባኮንታ ዓሶንታ ታኣኒ ጊንሣ ማሃንዳኔ፤<verse eid="JOL 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 3:2"/>ዒማና ሜሌ ዴሮ ቢያ ታኣኒ ቡኩሲ</para>
  <para style="q2" vid="JOL 3:2">ዒዮሳፒፄ ዶኦጮ ኬይሳንዳኔ፤</para>
  <para style="q2" vid="JOL 3:2">ታኣሮ ማዔ ዒስራዔኤሌ ዴሮ</para>
  <para style="q2" vid="JOL 3:2">ዔያቶ ባኣካ ዔያታ ዜርቂ ሳዖዋ ጊሽቲ ዔኬሢሮ</para>
  <para style="q2" vid="JOL 3:2">ዒዮሳፒፄ ዶኦጮይዳ ፑርታ ዎጌ ዔያቶይዳ ዎጋኒ ዒኢካ ሺኢሻንዳኔ።<verse eid="JOL 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 3:3"/>ዲዒ ዔኬ ታኣኮ ዴሮ ጊሽታኒ ዒፃ ዔያታ ዓጌኔ፤</para>
  <para style="q2" vid="JOL 3:3">ዔያታ ዞኦዛ ኮኦማ ላኣሎና ላሃኒ ዓቲንቆ ናኣቶ፤</para>
  <para style="q2" vid="JOL 3:3">ዎይኖ ዑዦ ዑሽካኒያ ዉዱሮ ናኣቶ ዓይሌ ማሂ ሻንቼኔ።»<verse eid="JOL 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4"/>«ዒንሢ ፂሮሴንታ ሲዶናንታ ፒሊስፄኤሜ ዓጮ ዴራ! ዒንሢ ማዻ ባካ ዓይጎዳይ? ታና ኮማኒ ዒንሢ ማላ? ያዺ ማዔቴ ዒንሢ ማዼ ማዾ ኔጉዋዖ ታኣኒ ዒንሢዳ ሺርሻንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">3፡4 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">ዒሲ. 14፡29-31</ref>፤ <ref loc="ISA 23:1-18">23፡1-18</ref>፤ <ref loc="JER 47:1-7">ዔር. 47፡1-7</ref>፤ <ref loc="EZK 25:15-28:26">ሂዚ. 25፡15—28፡26</ref>፤ <ref loc="AMO 1:6-10">ዓሞ. 1፡6-10</ref>፤ <ref loc="ZEP 2:4-7">ሶፖ. 2፡4-7</ref>፤ <ref loc="ZEC 9:1-7">ዛካ. 9፡1-7</ref>፤ <ref loc="MAT 11:21-22">ማቲ. 11፡21-22</ref>፤ <ref loc="LUK 10:13-14">ሉቃ. 10፡13-14</ref>።</char></note> <verse eid="JOL 3:4"/><verse number="5" style="v" sid="JOL 3:5"/>ታኣኮ ቢሮ ዓንጎንታ ዎርቆንታ፤ ዬያጉዲ ሃሣ ጴዹዋያ ማዔ፥ ታኣኮ ቆሎ ቢያ ዒንሢ ዔኪ ዒንሢኮ ካኣሽኮ ሜሌ ፆኦዞ ማኣሪ ጌልዜኔ። <verse eid="JOL 3:5"/><verse number="6" style="v" sid="JOL 3:6"/>ዪሁዳና ዬሩሳላሜናይዳ ሾይንቴ ዓሶ ዔያቶኮ ዓጫፓ ሃኪሲ ዔኪ ዴንዲ ጊሪኬ ዓሶም ዒንሢ ሻንቼኔ። <verse eid="JOL 3:6"/><verse number="7" style="v" sid="JOL 3:7"/>ሃሢ ዓካሪ ታኣኒ ዔያታ ሻንቺንቴ ቤዛፓ ዔያቶ ዔቂሲ፥ ዬኖ ዓጫፓ ዔያታ ኬስካንዳጉዲ ማሃንዳኔ፤ ዔያቶይዳ ዒንሢ ማዼ ፑርቶ ባኮ ቢያ ዒንሢዳ ታኣኒ ሺርሺ ዔኪ ዬዓንዳኔ። <verse eid="JOL 3:7"/><verse number="8" style="v" sid="JOL 3:8"/>ዒንሢኮ ዓቲንቆንታ ዉዱሮ ናኣቶንታ ዪሁዳ ዴሮም ሻንቺንታንዳኔ፤ ዬካፓ ዪሁዳ ዓጮ ዓሳ ሃኬይዳ ዓኣ ሳኣባ ዓሶም ዔያቶ ሻንቻንዳኔ፤ ዬያ ጌዔሢ ታና፥ ናንጊና ናንጋ ጎዳኬ።»<verse eid="JOL 3:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="JOL 3:9"/>«ዬያ ሜሌ ዴሮም ቢያ ዒላቲ ኬኤዙዋቴ፤</para>
  <para style="q2" vid="JOL 3:9">ዖልዚማኣ ጊኢጊንቱዋቴ!</para>
  <para style="q2" vid="JOL 3:9">ዖሎና ዔርቴ ዓሶዋ ዔኤሊ ኬሱዋቴ፤</para>
  <para style="q2" vid="JOL 3:9">ዖሎ ዖላ ዓሳ ቢያ ቡኪንቲ ዖሎሮ ኬስኮንጎ።<verse eid="JOL 3:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 3:10"/>ማራሾ ዒንሢኮ ዹይ ጬንቻ ዓራፖ፥ ባኣጮዋ ዹይ ዎርሢ ማሁዋቴ፤</para>
  <para style="q2" vid="JOL 3:10">ዎልቄ ባኣሢታቴያ ‹ታኣኒ ዶዲኬ!› ፔና ጎዖንጎ፤ <note caller="-" style="x"><char style="xo" closed="false">3፡10 </char><char style="xt" closed="false"><ref loc="ISA 2:4">ዒሲ. 2፡4</ref>፤ <ref loc="MIC 4:3">ሚኪ. 4፡3</ref>።</char></note><verse eid="JOL 3:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 3:11"/>ዒንሢ ቢያ ዛሎና ዓኣ ሜሌ ዴራ ቢያ፤</para>
  <para style="q2" vid="JOL 3:11">ዑካዺ ኬስኩዋቴ!</para>
  <para style="q2" vid="JOL 3:11">ዶኦጮይዳ ቡኪንቱዋቴ።»</para>
  <para style="b" vid="JOL 3:11"/>
  <para style="q" vid="JOL 3:11">ናንጊና ናንጋ ጎዳሢዮ! ኔኤኮ ዖሎ ዓሶ ዳኬ።<verse eid="JOL 3:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 3:12"/>«ሜሌ ዴራ ቢያ ዔቂ ዒዮሳፒፄ ዶኦጮ ዓኣዾንጎ፤</para>
  <para style="q2" vid="JOL 3:12">ታኣኒ፥ ናንጊና ናንጋ ጎዳ ቢያ ዛላ ዓኣ ሜሌ ዴሮይዳ</para>
  <para style="q2" vid="JOL 3:12">ፑርታ ዎጌ ዎጋኒ ዒኢካ ታኣኒ ዴዓንዳኔ።<verse eid="JOL 3:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 3:13"/>ዔያቶኮ ፑርቱማ ዑሣ ዓኣዼ ዺቤኔ፤</para>
  <para style="q2" vid="JOL 3:13">ካፄ ሃኣኮ ባኣቺና ጮኦሪንታሢጉዲ ዔያቶ ጮኦሩዋቴ፤</para>
  <para style="q2" vid="JOL 3:13">ዎይና ሶዮና ዎላ ጩኡጶ ቤዞይዳ ኩሚ ሄርቂንታሢጉዲ ዔያቶ ሄርቁዋቴ።» <note caller="-" style="x"><char style="xo" closed="false">3፡13 </char><char style="xt" closed="false"><ref loc="REV 14:14-16">ዮሃ. ፆፔዻ 14፡14-16</ref>፤ <ref loc="REV 19">19</ref>፤ <ref loc="REV 20">20</ref>፤ <ref loc="REV 19:15">19፡15</ref>።</char></note><verse eid="JOL 3:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 3:14"/>ናንጊና ናንጋ ጎዳ ዎጎ ዎጎ ዶኦጮይዳ ዎጋ ኬላ ሄሌኔ፤</para>
  <para style="q2" vid="JOL 3:14">ዬያሮ ኮሺ ሚርጌ ዴሬ ዒኢካ ቡኪንቴኔ።<verse eid="JOL 3:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 3:15"/>ዬኖ ኬሎና ዓቦንታ ዓጊኖንታ ዹማንዳኔ፤</para>
  <para style="q2" vid="JOL 3:15">ዦኦጋሢያ ፖዑዋያ ማዓንዳኔ።<verse eid="JOL 3:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 3:16"/>ናንጊና ናንጋ ጎዳ ፂዮኔ ዹኮይዳ፤ ጊንሣ ሃሣ ዬሩሳላሜይዳ ዔቂ</para>
  <para style="q2" vid="JOL 3:16">ፔኤኮ ዒጊቻ ዑኡዞ ዋይዚሳንዳኔ፤</para>
  <para style="q2" vid="JOL 3:16">ጫሪንጮንታ ሳዖንታ ዓጊፃንዳኔ፤</para>
  <para style="q2" vid="JOL 3:16">ዒዚ ፔ ዴሮ ዒስራዔኤሌኮ</para>
  <para style="q2" vid="JOL 3:16">ካናዾ ዋርዲዮ ማዓንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">3፡16 </char><char style="xt" closed="false"><ref loc="AMO 1:2">ዓሞ. 1፡2</ref>።</char></note><verse eid="JOL 3:16"/></para>
  <para style="s1">ፆኦሲ ፔ ዴሮ ዓንጄሢ</para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 3:17"/>«ዒስራዔኤሌ ዓሲዮቴ! ዒማና ታኣኒ፥ ናንጊና ናንጋ ጎዳሢ</para>
  <para style="q2" vid="JOL 3:17">ዒንሢኮ ፆኦዛሢታሢ ዒንሢ ዔራንዳኔ፤</para>
  <para style="q" vid="JOL 3:17">ታኣም ዱማዼ ፂዮኔ ዹኮይዳ ታኣኒ ናንጋንዳኔ፤</para>
  <para style="q2" vid="JOL 3:17">ዬሩሳላሜያ ታኣም ዱማዼ ካታማ ማዓንዳኔ፤</para>
  <para style="q2" vid="JOL 3:17">ሃካፓ ሴካ ሜሌ ዓጮ ፖኦሊሳ ዖሊ ዒዞ ዓርቃዓኬ።»<verse eid="JOL 3:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="JOL 3:18"/>«ዬኖ ዎዶና ዹኮይዳ ቢያ ዎይኔ ባቃሊ ኩማንዳኔ፤</para>
  <para style="q2" vid="JOL 3:18">ጌሜሮ ዑፆይዳኣ ሚርጌ ማኣፃ ባይ ሄንቃንዳኔ፤</para>
  <para style="q" vid="JOL 3:18">ዪሁዳ ዓጮ ዎራ ቢያ ዋኣሢ ዓኣያ ማዓንዳኔ፤</para>
  <para style="q2" vid="JOL 3:18">ናንጊና ናንጋ ጎዳኮ ጌኤዦ ማኣሮይዳፓ ዋኣሢ ዓልቃንዳኔ፤</para>
  <para style="q2" vid="JOL 3:18">ሺፂሜ ዶኦጮዋ ዬይ ዋኣፃ ዑሻንዳኔ።»<verse eid="JOL 3:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="JOL 3:19"/>«ጊብፄና ዔዶኦሜ ዓጮ ዓሶና ዪሁዳ ዴሮ ዑፃ</para>
  <para style="q2" vid="JOL 3:19">ጌኔ ማዾ ማዼሢሮ፥ ፂሎ ዴሮዋ ዎዼሢሮ</para>
  <para style="q2" vid="JOL 3:19">‹ጊብፄ ዓሲ ናንጉዋ ዓጪ ማዓንዳኔ፤</para>
  <para style="q2" vid="JOL 3:19">ዔዶኦሜያ ዓሲ ናንጉዋ ዳውሌ ማዓንዳኔ።›<verse eid="JOL 3:19"/></para>
  <para style="q">
    <verse number="20-21" style="v" sid="JOL 3:20-21"/>ዬያሮ ሃይማ ሄላንዳኣና ኮሞ ኮፁዋዖ ታኣኒ ሃሼ</para>
  <para style="q2" vid="JOL 3:20-21">ጌኤዦ ዓሶ ሱጉፆ ዛሎ ኮሞ ታኣኒ ኮፃንዳኔ፤</para>
  <para style="q" vid="JOL 3:20-21">ጋዓንቴ ዬሩሳላሜንታ ዪሁዳንታ ታኣኮ ዴራ ናኣናና ናንጋ ቤሲ ማዓንዳኔ፤</para>
  <para style="q2" vid="JOL 3:20-21">ታኣኒ፥ ናንጊና ናንጋ ጎዳሢ ፂዮኔ ዹኮይዳ ናንጋንዳኔ።»<verse eid="JOL 3:20-21"/></para>
  <chapter eid="JOL 3"/>
</usx>
