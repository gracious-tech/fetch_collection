<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- MAALE Full Bible</book>
  <para style="h">2 ፂሞቴዎሴም</para>
  <para style="toc1">2 ፆኦሲ ማዾም ዳኪንቴ ጳውሎሴ ፂሞቴዎሴም ዳኬ ኪኢቶ</para>
  <para style="toc3">2ፂሞ.</para>
  <para style="toc2">2 ፂሞቴዎሴም</para>
  <para style="mt2">ፆኦሲ ማዾም ዳኪንቴ ጳውሎሴ ላሚ ዳኬ ኪኢቶ</para>
  <para style="mt1">ፂሞቴዎሴም</para>
  <para style="imt">ዓይፆ ካሮ</para>
  <para style="ip">ሃይ፥ ጳውሎሴ ፂሞቴዎሴም ፃኣፔ ላምዓሳ ኪኢታ፦ ዒዛኮ ዴማ ማዒ፥ ዎላ ማዻያ ማዔ፥ ዼጌሢ፥ ፂሞቴዎሴም ባሼ ዞሮ ዞራያኬ። ሚርጌና ዒ ዞሬሢ ጊቢ ዳንዳዒሢ ዛላኬ፤ ፂሞቴዎሴ ዞሪንቴሢ ዬሱስ ኪሪስቶሴ ዛሎ ጉሙርቂንቲ ማርካዻንዳጉዲ፥ ኪሪስቶሴ ዛሎ ኮዦ ሃይሶና ሚናኣ ጫኣቃሢ ማፃኣፓ ዔርዛ ባኮ ኮሺ ዶዲ ዒ ዓርቃንዳጉዲና ዎዚ ሜቶና ዒፂንቲና ሚርጌቶዋ ፆኦሲ ቃኣሎ ዔርዚፆና ኮዦ ሃይሶ ኬኤዚፆ ማዾዋ ዶዲ ማዻንዳጉዲኬ።</para>
  <para style="ip">ፂሞቴዎሴም ባሼና ላቲ ኬኤዚንቴ ባካ ዔኤያቶና ፓሡዋ ማርሚሢናይዳፓ ሃካንዳጉዲኬ፤ ዓይጎሮ ጌዔቴ ዬያጉዴ ባኣዚ ዋይዛ ዓሶ ባይዚሢዳፓ ዓታዛ ሜሌ ማኣዳ ባኣዚ ባኣሴ።</para>
  <para style="ip">ዬያ ቢያና ፂሞቴዎሴ ማላንዳያ ኮይሴሢ ጳውሎሴኮ ናንጋ ዎማዺ ማዔቴያ፥ ጌይፃ፦ ዒዛኮ ፆኦሲ ጉሙርቂፆ፥ ጊቢ ዳንዳዒፆ፥ ናሹሞ፥ ዶዱሞና ዒፂ ዳኪንቲፆና ሃሣ ዒዛ ሄሌ ሜታሢ ዒ ማላታ ማሂ ናንጋንዳጉዲኬ።</para>
  <para style="iot">ማፃኣፔላ ዱማ ዱማ ዓርቄ ባኮ</para>
  <para style="io1">ዓይፆ ካሮ (1፡1-2)</para>
  <para style="io1">ጳውሎሴ ጋላቴ ጋላቶና ዞሬ ዞሮ (1፡3—2፡13)</para>
  <para style="io1">ፂሞቴዎሴ ማዻንዳጉዲ ዓይሢንቴ ባኮና ላቲ ኬኤዚንቴ ባኮ (2፡14—4፡5)</para>
  <para style="io1">ጳውሎሴ ዒ ዓኣ ጎይፆ ኬኤዜሢ (4፡6-18)</para>
  <para style="io1">ጋፒንሢ ሃይሴ (4፡19-22)</para>
  <chapter number="1" style="c" sid="2TI 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1"/>ዬሱስ ኪሪስቶሴና ጴዼ ናንጎኮ ሃጊ ማዓንዳ ዎዞ ጎይፆ ፆኦሲ ማሊሢና ዬሱስ ኪሪስቶሴ ማዾም ዳኪንቴያ ማዔ፥ ጳውሎሴይዳፓ ዳኪንቴ ኪኢታ፦<verse eid="2TI 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2TI 1:2"/>ታኣኒ ናሽካ ናዓሢ፥ ፂሞቴዎሴም፤</para>
  <para style="p" vid="2TI 1:2">ፆኦሲ፥ ዓዳሢና ኑ ጎዳሢ፥ ዬሱስ ኪሪስቶሴኮ ኮሹሞ ዒንጊፆና ማኣሪፆና ሃሣ ዎዞና ኔኤም ማዖንጎ። <note caller="-" style="x"><char style="xo" closed="false">1፡2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ዳኪ. ማዾ 16፡1</ref>።</char></note><verse eid="2TI 1:2"/></para>
  <para style="s1">ፂሞቴዎሴም ዞሮና ዞሮ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3"/>ቢያ ዎዴ ዋንቴና ሮኦሪና ኔ ዛሎ ማሊ ማሊ ታ ሺኢቃኣና ቤርታኣ፥ ታ ዓዶንሢጉዲ ጌኤሺ ዒናፓ ታ ካኣሽካ ፆኦዛሢ ታ ጋላታኔ። <verse eid="2TI 1:3"/><verse number="4" style="v" sid="2TI 1:4"/>ኔ ዬኤኪ ዓቢቴ ዓቢፆ ታ ዋሊባኣሴ፤ ዬያሮ ሚርጌና ዒና ታኣኮ ዎዛዻንዳጉዲ ኔና ዛጋኒ ታ ኮዓኔ። <verse eid="2TI 1:4"/><verse number="5" style="v" sid="2TI 1:5"/>ኔኤኮ ዓኣ ጎኔ፥ ፆኦሲ ጉሙርቂፆ ታ ጶቂሣኔ፤ ዬያጉዴ ጉሙርቂፃ ቤርታ ኔ ዓሆ ሎይዴይዳ ሃሣ ኔ ዒንዶ ዔዌንቄይዳ ዓኣያኬ፤ ሃሢ ኔኤኮዋ ዬያጉዲ ዓኣሢ ታ ዔሬኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡5 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ዳኪ. ማዾ 16፡1</ref>።</char></note> <verse eid="2TI 1:5"/><verse number="6" style="v" sid="2TI 1:6"/>ዬያሮ ታ ኔ ዑፃ ኩጮ ጌሤም ኔ ዔኬ፥ ኔ ጊዳ ዓኣ ፆኦሲኮ ዒንጊፆ ማዾይዳ ፔኤሺ ኔ ዲቻንዳጉዲ ታ ኔኤም ኬኤዛኔ። <verse eid="2TI 1:6"/><verse number="7" style="v" sid="2TI 1:7"/>ዓይጎሮ ጌዔቴ ፆኦሲ ኑም ዒንጌሢ ዎልቄንታ ናሹሞንታ ዒንጋያ፤ ሃሣ ኑና ኑ ዔሪ ዎይሣንዳ ዓያና ማዓንዳኣፓዓቴም ዒጊቹሞ ዓያናቱዋሴ።<verse eid="2TI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8"/>ዓካሪ ኑ ጎዳሢ ዛሎ ዓሶም ማርካዻኒ ሴልቂፖ፤ ሃሣ ዒዛ ዛሎሮ ቱኡቴ፥ ታ ዛሎሮዋ ሴልቂፖ፤ ፆኦሲ ኔኤም ዒንጋ ዎልቆና ኮዦ ሃይሶ ዛሎሮ ታኣና ዎላ ሜታዼ። <verse eid="2TI 1:8"/><verse number="9" style="v" sid="2TI 1:9"/>ዒዚ ኑኡኒ ማዼ ኮዦ ማዾሮቱዋንቴ ፔ ማሊፆና ፔኤኮ ኮሹሞ ዒንጊፆና ዻቂሺ፥ ፆኦሲም ዱማዼያ ማዒ ናንጋንዳጉዲ ኑና ዔኤሌኔ፤ ዬያ ኮሹሞ ዒንጊፆ ሚርጌ ዎዴኮ ቤርታ ዬሱስ ኪሪስቶሴ ዛሎና ኑም ዒንጌኔ። <verse eid="2TI 1:9"/><verse number="10" style="v" sid="2TI 1:10"/>ዬይ ፆኦሲኮ ኮሹሞ ዒንጊፃ ኑና ዻቂሼ፥ ዬሱስ ኪሪስቶኮ ሙኪፆና ሃሢ ፔጋዺ ዔርቴኔ። ዒዚ ሃይቢኮ ዎልቄ ባይዚ ኮዦ ሃይሶ ዛሎና ሃይቢባኣ፥ ናንጊና ናንጊ ኑም ዻዌኔ።<verse eid="2TI 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11"/>ታኣኒያ ዬያ ኮዦ ሃይሶ ኬኤዛያ፤ ዬያ ማዾም ዳኪንቴያ ሃሣ ዔርዛያ ማዒ ዶኦሪንቴኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡11 </char><char style="xt" closed="false"><ref loc="1TI 2:7">1ፂሞ. 2፡7</ref>።</char></note> <verse eid="2TI 1:11"/><verse number="12" style="v" sid="2TI 1:12"/>ሃያ ታ ሜታሢ ዔካሢ ዬያሮኬ፤ ጋዓንቴ ታኣኒ ሃያ ሜቶ ዔኪፆና ሴልቁዋሴ፤ ዓይጎሮ ጌዔቴ ዖና ጉሙርቃቴያ ታ ዔራኔ፤ ታ ዒዛም ሃዳርሲ ዒንጌ ባኮ ዬኖ ኬሎ ሄላንዳኣና ዒ ካፓኒ ዳንዳዓሢ ታ ጉሙርቃኔ። <verse eid="2TI 1:12"/><verse number="13" style="v" sid="2TI 1:13"/>ታ ጊዳፓ ኔ ዋይዚ ዔሬ ቃኣሎ ማላታ ማሂ ዬሱስ ኪሪስቶሴና ኑኡኮ ዓኣ ፔቱሞ ዛሎና ጴዻ ጉሙርቂፆና ኮሹሞና ዶዲሺ ዓርቄ። <verse eid="2TI 1:13"/><verse number="14" style="v" sid="2TI 1:14"/>ኑ ጊዳ ዓኣ ዓያኖ ጌኤዦ ዛሎና ኔና ጉሙርቂ ኔኤም ዒንጊንቴ ባኮ ካፔ።<verse eid="2TI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15"/>ዒሲያይዳ ዓኣ ዓሳ ቢያ ታና ሃሼሢ ኔ ዔራኔ፤ ዔያቶ ባኣካ ፔጌሎሴና ሄርሞጌኔሴና ዓኣኔ። <verse eid="2TI 1:15"/><verse number="16" style="v" sid="2TI 1:16"/>ጎዳ ዖኔስፖሬ ማኣሮ ዓሶ ማኣዶንጎ፤ ዓይጎሮ ጌዔቴ ዔያታ ሚርጌ ዎዴ ታና ዖኦጪ ዶዲሼኔ፤ ሃሣ ታ ቱኪንቴሢሮ ሙኪ ታና ዖኦጪፆዋ ሴልቂ ሃሺባኣሴ። <verse eid="2TI 1:16"/><verse number="17" style="v" sid="2TI 1:17"/>ዒዚ ሮሜ ዓጮ ሙካዖ ሚርጌና ኮይ ታና ዴንቄኔ፤ <verse eid="2TI 1:17"/><verse number="18" style="v" sid="2TI 1:18"/>ጋፒንፆ ኬሎና ጎዳ ዒዛም ኮሺ ማዾንጎ፤ ቤርታ ታ ዔፕሶኔይዳ ዓኣና ዒ ዎማይዲ ታኣም ማዼቴያ ኔ ኮሺ ዔራኔ።<verse eid="2TI 1:18"/></para>
  <chapter eid="2TI 1"/>
  <chapter number="2" style="c" sid="2TI 2"/>
  <para style="s1">ኪሪስቶሴ ማዾ ዛሎ ዖልታ ዓሲ ማዒሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1"/>ዓካሪ ታ ናዓሢዮ! ዬሱስ ኪሪስቶሴ ዛሎና ጴዻ ኮሹሞ ዒንጊፆና ዶዴ። <verse eid="2TI 2:1"/><verse number="2" style="v" sid="2TI 2:2"/>ሚርጌ ማርካ ማዓ ዓሶ ቤርታ ታጊዳፓ ኔ ዋይዚ፥ ዔሬ ዔራቶ ሜሌ ዓሲ ዔርዛኒ ዳንዳዓያ፤ ሃሣ ጉሙርቂንታ ዓሲም ሃዳርሲ ዒንጌ።<verse eid="2TI 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3"/>ኔኤኒ ዬሱስ ኪሪስቶሴኮ ማዾ ዛሎ ዖልታ ጉሙርቂንታ ዓሲ ማዒ፥ ሜታሢ ኑኡና ዎላ ጊቢ ዳንዳዔ። <verse eid="2TI 2:3"/><verse number="4" style="v" sid="2TI 2:4"/>ፖኦሊሴ ማዔ ዓሲ ፖኦሊሶ ዓይሣሢ ዎዛሳያ ማዓኒ ጊኢጌያ ማዓንዳኣፓዓቴም ፖኦሊሴም ኮይሱዋ ባኣዚዳ ጌሉዋሴ። <verse eid="2TI 2:4"/><verse number="5" style="v" sid="2TI 2:5"/>ዬያጉዲ ሃሣ ጳሺ ጳሽካ ዓሲ ዓይሢንታ ጎይፆማ ጳሽኪባኣያታቴ ጳዦና ባሺ ዴንቆ ባኮ ዔኩዋሴ። <verse eid="2TI 2:5"/><verse number="6" style="v" sid="2TI 2:6"/>ዶዲ ጎሽካ ዓሢ ሃኣኮ ካፂሲ ሙዓ ዓሶይዳፓ ቤርታዻሢ ማዓንዳያ ኮይሳኔ። <verse eid="2TI 2:6"/><verse number="7" style="v" sid="2TI 2:7"/>ጎዳሢ ቢያ ባኣዚና ጶቂሥሢ ማሊሢ ኔኤም ዒንጋንዳሢሮ ታ ኔኤም ጋዓ ባኮ ቢያ ዒና ዔኬ።<verse eid="2TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8"/>ሃይባፓ ዔቄሢ፤ ሃሣ ዳውቴ ዜርፃሢ ማዔ፥ ዬሱስ ኪሪስቶሴ ማሌ፤ ታኣኒ ኬኤዛ ኮዦ ሃይሳ ዬያኬ። <verse eid="2TI 2:8"/><verse number="9" style="v" sid="2TI 2:9"/>ዬያ ኮዦ ሃይሶ ኬኤዚፆ ዛሎና ፑርቲሴ ዓሲጉዲ ቱኡቲ ሜቶ ታ ሃሢ ዔካኔ፤ ፆኦሲኮ ቃኣላ ጋዓንቴ ቱኡቱዋሴ። <verse eid="2TI 2:9"/><verse number="10" style="v" sid="2TI 2:10"/>ዬያሮ ዔያታ ዬሱስ ኪሪስቶሴ ዛሎና ጴዻ ዻቂንቶና ናንጊና ናንጋ ቦንቾ ዴንቃንዳጉዲ ሃሣ ፆኦሲ ዶኦሬ ዓሶሮ ጌዒ ቢያ ባኣዚ ታ ዳንዳዓኔ።<verse eid="2TI 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="2TI 2:11"/>«ዒዛና ዎላ ኑ ሃይቄቶ</para>
  <para style="q2" vid="2TI 2:11">ዒዛና ናንጊና ኑ ናንጋንዳኔ።<verse eid="2TI 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="2TI 2:12"/>ጊቢ ዳንዳዒሢና ዶዴያ ኑ ማዔቴ</para>
  <para style="q2" vid="2TI 2:12">ዒዛና ዎላ ኑ ካኣታዻንዳኔ።</para>
  <para style="q2" vid="2TI 2:12">ዒዛ ኑ ‹ዔሩዋሴ› ጌዔቴ ዒዚያ ኑና ‹ዔሩዋሴ› ጋዓንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">2፡12 </char><char style="xt" closed="false"><ref loc="MAT 10:33">ማቲ. 10፡33</ref>፤ <ref loc="LUK 12:9">ሉቃ. 12፡9</ref>፤ <ref loc="NUM 16:5">ፓይ. ማፃ 16፡5</ref>።</char></note><verse eid="2TI 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="2TI 2:13"/>ኑኡኒ ጉሙርቂንቱዋያ ማዔቴ</para>
  <para style="q2" vid="2TI 2:13">ዒዚ ፔና ‹ዔሩዋሴ› ጋዓኒ ዳንዳዑዋኣሢሮ ጉሙርቂንታያ ማዒ ናንጋንዳኔ»</para>
  <para style="m" vid="2TI 2:13">ጋዓ ቃኣላ ጎናዺ ዔርቴያኬ።<verse eid="2TI 2:13"/></para>
  <para style="s1">ፆኦሲ ባኣዚ ዶዲ ማዻ ዓሲ</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14"/>ሃያ ባኮ ዔያቶም ኮሺ ኬኤዜ፤ ዬይያ፦ ጌይንቴ ባኣዚዳ ዔያታ ማርሚ ሺሩዋጉዲ ፆኦሲ ማርካ ማሂ ዔያቶም ላቲ ኬኤዜ፤ ዓይጎሮ ጌዔቴ ዬይ ማርማሢ ዋይዛ ዓሶ ባባይዛፓዓቴም ዓይጎዋ ማኣዱዋሴ። <verse eid="2TI 2:14"/><verse number="15" style="v" sid="2TI 2:15"/>ጎኔ ፆኦሲ ቃኣሎ ፒዜ ዔርዛያ፥ ማዻ ማዾናኣ ቦርሲንቱዋ ዓሲ፤ ሃሣ ዔርቴ ማዻ ዓሲ ማዒ ኔና ፆኦሲ ቤርቶ ሺኢሻኒ ዶዴ። <verse eid="2TI 2:15"/><verse number="16" style="v" sid="2TI 2:16"/>ሃያ ዓጮ ባኣዚ ማዔያ፥ ሃሣ ጉሪ ጌስቲ ሺሮ ጌኤዛፓ ሃኬ፤ ዓይጎሮ ጌዔቴ ዬያጉዴ ሃይሳ ዓሲ ፆኦሲዳፓ ሃኪሳሢሮኬ። <verse eid="2TI 2:16"/><verse number="17" style="v" sid="2TI 2:17"/>ዔያቶኮ ጌኤዛ ፓፁዋ ኪሢጉዲ ዖዖርሳታያኬ፤ ዔያቶ ባኣካ ሄሜኔዎሴና ፒሊፆሴና ዓኣኔ። <verse eid="2TI 2:17"/><verse number="18" style="v" sid="2TI 2:18"/>ዬንሢ ዓሳ፦ «ሃይቄ ዓሶኮ ሃይባፓ ዔቂፃ ቤርታ ማዒ ጋፔኔ» ጌይ ጌይ ማርሚሢና ጎኑሞ ጎይፃፓ ዻቢንቲ ኬስኪ ፔቴ ፔቴ ዓሶኮዋ ጉሙርቂፆ ዣኣሊሳኔ። <verse eid="2TI 2:18"/><verse number="19" style="v" sid="2TI 2:19"/>ያዒ ማዔቴያ፦ «ጎዳ ፔኤም ማዔዞንሢ ዔራኔ» ዬያጉዲ ሃሣ፦ «ጎዳ ማኣዶም ዔኤላ ዓሲ ቢያ ፑርታ ባኣዚዳፓ ሃኮንጎ» ጋዓ ማላታ ዓይሢንቲ ዓኣ፥ ዓጊፁዋ ፆኦሲ ዔቂሴ ቦኦኮላሢ ዔቂ ዓኣ ጎይሣኬ።<verse eid="2TI 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20"/>ፔቴ ዼኤፒ ማኣሪዳ ዎርቄና ቢራ ዓንጊናይዳፓ ኮሺንቴ ሜሄ ሌሊ ዓኣያቱዋንቴ ሚሢና ዓጪናይዳፓ ኮሺንቴ ሜሄያ ዓኣኔ። ዬያቶይዳፓ ዛላ ቦንቺንታ ማዾም ማዓያ፤ ዛላ ጊንሣ ዻካ ማዾም ኮይሳያኬ። <verse eid="2TI 2:20"/><verse number="21" style="v" sid="2TI 2:21"/>ዓካሪ ዖኦኒያ ፔ ቶኦኮ ዬንሢ ፑርቶ ባኮንሢዳፓ ጌኤሺ ካፔቶ ቦንቾ ማዾም ማዔያ፥ ፆኦሲም ዱማዼያ፥ ፔ ጎዳሢማኣ ኮይሳያ ሃሣ ኮሺ ማዾም ቢያ ጊኢጌ ሜሄ ማዓንዳኔ።<verse eid="2TI 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22"/>ፑርታ ማዔ፥ ዼጋቶ ሱኡኬይዳፓ ሃኬ፤ ጌኤሺ ዒኔና ጎዳ ካኣሽካ ዓሶና ዎላ ማዒ ፂሉሞ፥ ፆኦሲ ጉሙርቂሢ፥ ናሹሞንታ ኮሹሞንታ ዓኣያ ማዒ ናንጌ። <verse eid="2TI 2:22"/><verse number="23" style="v" sid="2TI 2:23"/>ዑራ ማዣሢ ዔሪ ዔኤያቶ ጌኤዞና ፓሡዋ ማርማሢና ሃሼ። <verse eid="2TI 2:23"/><verse number="24" style="v" sid="2TI 2:24"/>ጎዳ ዬሱሴም ማዻ ዓሲ፦ ቢያ ዓሲም ሼሌዔ፥ ዓሲ ዔርዛኒ ዳንዳዓያ ሃሣ ዔኤቢ ጊቢ ዳንዳዓያ ማዓንዳኣፓዓቴም ዑዑራዻንዳያ ኮይሱዋሴ፤ <verse eid="2TI 2:24"/><verse number="25" style="v" sid="2TI 2:25"/>ጎኑሞ ዔያታ ዔራንዳጉዲ ፆኦሲ ዔያቶም ጎሞ ጎዖንቴ ዓቶም ጋዓንዳያ ናንዳኔ ጌዒ ዒዛ ዒፃ ፑርቶ ዓሶ ሼሌዑሞና ፒዚሳያ ማዓኒ ኮይሳኔ። <verse eid="2TI 2:25"/><verse number="26" style="v" sid="2TI 2:26"/>ዬያይዴቴ ዔያቶኮ ዒና ማዔም፥ ፃላሄ ፔ ማሊፆ ዔያታ ኩንሣንዳጉዲ ዔያቶ ዓይሤ ፒራሢዳፓ ዔያታ ቶላንዳኔ።<verse eid="2TI 2:26"/></para>
  <chapter eid="2TI 2"/>
  <chapter number="3" style="c" sid="2TI 3"/>
  <para style="s1">ጋፒንፆ ዎዶና ማዓንዳ ፑርቶ ባኮ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1"/>ጋፒንፃ ዑካኣና ሜታሳ ዎዴ ዬዓንዳሢ ዔሬ፤ <verse eid="2TI 3:1"/><verse number="2" style="v" sid="2TI 3:2"/>ዓሲ ፔና ናሽካያ፥ ሚኢሼሮ ጎጋይቃያ፥ ሄርሺንታያ፥ ዖቶርቃያ፥ ጫሽኪንታያ፥ ሾዔ ዓሶም ዓይሢንቱዋያ፥ ኮሺ ማዾና ዛላም ማሂ ማሉዋያ፥ ጌኤሹሞባኣ ዓሲ፥ <verse eid="2TI 3:2"/><verse number="3" style="v" sid="2TI 3:3"/>ናሹሞባኣ ዓሲ፥ ዓሲና ዎላ ጊኢጋኒ ኮዑዋ ዓሲ፥ ዓሲ ዾንካያ፥ ፔና ዔሪ ዎይሡዋያ፥ ዓሲ ሚጪንቱዋያ፥ ኮሺ ማዔ ባኣዚ ቢያ ዒፃያ፥ <verse eid="2TI 3:3"/><verse number="4" style="v" sid="2TI 3:4"/>ጉሙርቂንቱዋ ዓሲ፥ ዔኤቢ ዔሩዋዖ ሩኡራያ፥ ጉሪ ሆኦሊንታያ፥ ፆኦሲዳፓ ባሼ ፔኤም ኮሽካ ባኣዚ ናሽካያ ማዓንዳኔ። <verse eid="2TI 3:4"/><verse number="5" style="v" sid="2TI 3:5"/>ፆኦሲ ጎኔ ካኣሽካያ ማላዖ ጎኔ ካኣዦኮ ዎልቆ ጉሙርቁዋያ ማዓንዳኔ፤ ዬያጉዴ ዓሶፓ ሃኬ። <verse eid="2TI 3:5"/><verse number="6" style="v" sid="2TI 3:6"/>ዬያታ ዓሳ ዓሲኮ ማኣሪ ዔርቱዋ ጎይሢና ጌሊ ጌሊ ሚርጌ ጎሜ ማዻያ ሃሣ ዱማ ዱማ ፑርታ ሱኡኬና ናንጋ፥ ዓያና ላቤ ላኣሎ ዻቢሻ ዓሶኬ፤ <verse eid="2TI 3:6"/><verse number="7" style="v" sid="2TI 3:7"/>ዬያጉዴ ላኣሎ ቢያ ዎዴ ዔርዞኔ፤ ጋዓንቴ ጎኑሞ ዔያታ ዔራኒ ማሊ ዳንዳዑዋያኬ። <verse eid="2TI 3:7"/><verse number="8" style="v" sid="2TI 3:8"/>ዒያኔሴና ዒያምቤሬሴ ጎዖዞንሢ ሙሴ ዒፂ ማኬሢ ጎይፆ ዬንሢ ዓሳ ማሊፃ ዔያቶኮ ፑርቴያ ሃሣ ፆኦሲ ጉሙርቂፆ ዛሎና ዻቢንቴያ ማዔሢሮ ጎኑሞ ዔያታ ዒፂ ማካኔ። <note caller="-" style="x"><char style="xo" closed="false">3፡8 </char><char style="xt" closed="false"><ref loc="EXO 7:11">ኬሲ. ማፃ 7፡11</ref>።</char></note> <verse eid="2TI 3:8"/><verse number="9" style="v" sid="2TI 3:9"/>ዒያኔሴና ዒያምቤሬሴናኮ ዔኤያታ ፔጋዺ ዔርቴሢጉዲ ዬንሢ ዓሶኮዋ ዔኤያታ ዓሲ ቢያ ቤርታ ፔጋዺ ዔርታንዳሢሮ ዔያቶም ጊኢጋዓኬ።<verse eid="2TI 3:9"/></para>
  <para style="s1">ጳውሎሴ ፂሞቴዎሴም ላቲ ኬኤዜ ባኮ</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10"/>ኔኤኒ ጋዓንቴ ታኣኮ ዔርዚፆ፥ ታ ናንጌ ናንጎ፥ ታ ማላ ማሊፆ፥ ፆኦሲ ጉሙርቂፆ፥ ጊቢ ዳንዳዒፆ፥ ናሹሞና ዶዱሞና ዛጊ ዔሬኔ፤ <verse eid="2TI 3:10"/><verse number="11" style="v" sid="2TI 3:11"/>ዬያጉዲ ሃሣ ዒፂንቲ ታ ዳውሲንቴ ዎዶና ታኣና ዎላ ሜታሢያ ኔ ዔኬኔ፤ ዓንፆኪያና ዒቆኒዮና ሊስፂራናይዳ ታና ሄሌ ባኮና ጊቢ ታ ዓኣሤ ዳውሲንቲፆ ኔ ዔራኔ፤ ጎዳ ጋዓንቴ ዬያ ቢያይዳፓ ታና ዻቂሼኔ። <note caller="-" style="x"><char style="xo" closed="false">3፡11 </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">ዳኪ. ማዾ 13፡14-52</ref>፤ <ref loc="ACT 14:1-7">14፡1-7</ref>፤<ref loc="ACT 14:8-20">8-20</ref>።</char></note> <verse eid="2TI 3:11"/><verse number="12" style="v" sid="2TI 3:12"/>ዬሱስ ኪሪስቶሴ ጊንፆ ሃንታያ ማዒ ዓያና ናንጊ ናንጋኒ ኮዓዞንሢ ቢያ ዒፂንቲ ዳውሲንታኔ። <verse eid="2TI 3:12"/><verse number="13" style="v" sid="2TI 3:13"/>ፑርቶ ዓሶና ጌሻ ዓሶና ጋዓንቴ ዓሲ ዻቢሺ ዻቢሺ፥ ሃሣ ፔ ቶኦኮዋ ዻቢንቲ ፑርቱሞይዳ ፑርቱሞ ቃሲ ቃሲ ዴንዳኔ። <verse eid="2TI 3:13"/><verse number="14" style="v" sid="2TI 3:14"/>ኔኤኒ ጋዓንቴ ዋይዜሢና ዔሬ ጎኑሞና ዶዴ፤ ዓይጎሮ ጌዔቴ ኔኤኒ ዬያ ዖ ጊዳፓ ዔኬቴያ ዔራሢሮኬ። <verse eid="2TI 3:14"/><verse number="15" style="v" sid="2TI 3:15"/>ጌኤዦ ማፃኣፖ ናኣቶፓ ዓርቂ ኔ ዔሬኔ፤ ዬንሢ ጌኤዦ ማፃኣፖንሢ፦ ዬሱስ ኪሪስቶሴ ጉሙርቂፆና ጴዻ፥ ዻቂንታ ባንሢ ሄሊሳኒ ዳንዳዓ ዔራቶ ዓኣዞንሢኬ። <verse eid="2TI 3:15"/><verse number="16" style="v" sid="2TI 3:16"/>ጌኤዦ ማፃኣፓ ቢያ ፆኦሲ ዓያና ማሊሴም ፃኣፒንቴያኬ፤ ዬይያ፦ ጎኑሞ ዔርዛኒ፥ ዻቢንቴ ዓሶ ዞራኒ፥ ዻቢንቶዋ ጊኢጊሻኒና ፒዜ ናንጊም ኮይሳ ማሊሢ ዒንጋኒ ማኣዳያኬ። <verse eid="2TI 3:16"/><verse number="17" style="v" sid="2TI 3:17"/>ማኣዳ ጎይፃ ፆኦሲ ዓሲ ኮሺ ማዾም ቢያ ጊዳያ ማዒ ጴዻንዳጉዲ ማሂፆናኬ።<verse eid="2TI 3:17"/></para>
  <chapter eid="2TI 3"/>
  <chapter number="4" style="c" sid="2TI 4"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1"/>ፆኦሲ ሃሣ ሼምፖና ዓኣ ዓሶና ሃይቄ ዓሶና ዑፃ ዎጋኒ፥ ካኣቲ ማዒያ ዎይሣኒ ሙኪ ጴዻንዳ ዬሱስ ኪሪስቶሴ ማርካ ማሂ ታ ኔና ሺኢቃኔ፤ <verse eid="2TI 4:1"/><verse number="2" style="v" sid="2TI 4:2"/>ፆኦሲ ቃኣሎ ኬኤዜ፤ ጊኢጌቴያ ጊኢጊባኣቴያ ዶዲ ማዼ፤ ዓሶም ኬኤዚ ኬኤዚ ሃሣ ጎሪ ጎሪ፥ ዞሪ ዞሪ፥ ጊቢ ዳንዳዒሢና ዬያጉዲ ቃኣሎ ዔርዚሢናኣ ዶዴ። <verse eid="2TI 4:2"/><verse number="3" style="v" sid="2TI 4:3"/>ዓይጎሮ ጌዔቴ ዓሳ ፆኦሲ ቃኣሎ ዋይዚ ዔካኒ ኮዑዋ ዎዴ ሙካንዳሢሮኬ፤ ጋዓንቴ ዓሳ ዔያቶ ናሻ ሃይሴ፥ ሃሣ ዔያታ ዋይዛኒ ኮዓ ሃይሶ ኬኤዛንዳ ፔኤኮ ዔርዛ ዓሲ ቡኩሳንዳኔ። <verse eid="2TI 4:3"/><verse number="4" style="v" sid="2TI 4:4"/>ዔያታ ጎኔ ባኣዚ ዋይዚፆ ዒፂ፥ ጉሪ ሃይሴ ዋይዚሢ ናሽካንዳኔ። <verse eid="2TI 4:4"/><verse number="5" style="v" sid="2TI 4:5"/>ኔኤኒ ጋዓንቴ ቢያ ባኣዚ ዔሪ ካፒንቲ ናንጌ፤ ኔ ጊዳ ሙካ ሜቶዋ ጊቢ ዳንዳዔ፤ ሃሣ ኮዦ ሃይሶ ኬኤዚፆ ማዾዋ ዶዲ ማዼ፤ ፆኦሲም ኔ ማዻ ዓሲ ማዔ ጎይፆና ኔ ማዻኒ ኮይሳ ባኮ ቢያ ማዺ ኩንሤ።<verse eid="2TI 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6"/>ታኣኒ ጋዓንቴ ፆኦሲም ዒንጎ ባኣዚ ማዒ ዒንጊንታኒ ዑኬኔ፤ ሃያ ዓጮይዳፓ ዱማዺ ታ ዓኣዻንዳ ዎዳ ሄሌኔ፤ <verse eid="2TI 4:6"/><verse number="7" style="v" sid="2TI 4:7"/>ፆኦሲ ጉሙርቂፆ ዛሎና ዓኣ ዖሎ ሚርጌና ታ ዖልቴኔ፤ ጳዦዋ ጋፒንፆ ሄላንዳኣና ታ ጳሽኬኔ፤ ሃሣ ፆኦሲ ጉሙርቂፆ ካኣዦዋ ታ ካፔኔ። <verse eid="2TI 4:7"/><verse number="8" style="v" sid="2TI 4:8"/>ዓካሪ ፂሎ ማዒ ናንጌሢሮ ዒንጊንታ ካኣቶኮ ቶኦካ ዓጎሢጉዴ ቦንቾ ባካ ታኣም ጊኢጊንቲ ታና ካፓንዳኔ፤ ዬያ ባኮ ፒዜ ዎጋያ ማዔ ጎዳሢ ዬኖ ኬሎና ታኣም ዒንጋንዳኔ፤ ዬይ ታኣም ሌሊቱዋንቴ ዒዛኮ ሙኪ ጴዺፆ ጶቂሢ ካፓዞንሢም ቢያ ዒንጊንታንዳኔ።<verse eid="2TI 4:8"/></para>
  <para style="s1">ጳውሎሴ ፔ ዛሎ ፂሞቴዎሴም ኬኤዜሢ</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9"/>ኔ ታ ኮይላ ዑኬ ሙኬቴ ቃራኬ፤ <verse eid="2TI 4:9"/><verse number="10" style="v" sid="2TI 4:10"/>ዴማሴ ሃያ ዓጮ ናንጎ ናሽኪ፥ ታና ሃሺ፥ ቴስሎንቄ ዓኣዼኔ። ታ ኮይላፓ ቄርቂሴ ጋላቲያ፤ ሃሣ ቲቶ ዲልማፂያ ዓኣዼኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡10 </char><char style="xt" closed="false"><ref loc="COL 4:14">ቆላ. 4፡14</ref>፤ <ref loc="PHM 1:24">ፒልሞ. 24</ref>፤ <ref loc="2CO 8:23">2ቆሮ. 8፡23</ref>፤ <ref loc="GAL 2:3">ጋላ. 2፡3</ref>፤ <ref loc="TIT 1:4">ቲቶ 1፡4</ref>።</char></note> <verse eid="2TI 4:10"/><verse number="11" style="v" sid="2TI 4:11"/>ታ ኮይላ ሃሢ ዓኣሢ ሉቃሴ ሌሊኬ። ማርቆሴ ማዾም ታኣም ኮይሳያታሢሮ ኔኤና ዎላ ዒዛ ዔኪ ሙኬ። <note caller="-" style="x"><char style="xo" closed="false">4፡11 </char><char style="xt" closed="false"><ref loc="COL 4:14">ቆላ. 4፡14</ref>፤ <ref loc="PHM 1:24">ፒልሞ. 24</ref>፤ <ref loc="ACT 12:12">ዳኪ. ማዾ 12፡12</ref>፤<ref loc="ACT 12:25">25</ref>፤ <ref loc="ACT 13:13">13፡13</ref>፤ <ref loc="ACT 15:37-39">15፡37-39</ref>፤ <ref loc="COL 4:10">ቆላ. 4፡10</ref>።</char></note> <verse eid="2TI 4:11"/><verse number="12" style="v" sid="2TI 4:12"/>ቲኪቆሴ ዔፕሶኔ ታ ዳኬኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ዳኪ. ማዾ 20፡4</ref>፤ <ref loc="EPH 6:21-22">ዔፕ. 6፡21-22</ref>፤ <ref loc="COL 4:7-8">ቆላ. 4፡7-8</ref>።</char></note> <verse eid="2TI 4:12"/><verse number="13" style="v" sid="2TI 4:13"/>ኔኤኒ ሙካዖ ፂሮዓዳይዳ ካርፑሴ ጎዖሢ ኮይላ ታ ሃሺ ዓኣዼ ታኣኮ ዼኤፖ ኮኦቶና ማሪንቴ ማፃኣፖዋ ባሼ ቢራኖ ማፃኣፖ<note caller="+" style="f"><char style="fr" closed="false">4፡13 </char><char style="fq" closed="false">ማሪንቴ ማፃኣፖና ቢራኖ ማፃኣፖ፦ </char><char style="ft" closed="false">ጋዓሢ ዬኖ ዎዶና ማፃኣፓ ፃኣፒንታሢ ዬኖ ባኮይዳኬ፤ ማሪንቴ ማፃኣፓ «ፓፕሬሴ» ጎዖ ሚፆኮ ቁኡሪፓ ኮሾያ ማዓዛ ቢራና ጌይንታሢ ዒልዒዳፓ ኮሾያኬ።</char></note> ዋሉዋዖ ዔኪ ሙኬ። <note caller="-" style="x"><char style="xo" closed="false">4፡13 </char><char style="xt" closed="false"><ref loc="ACT 20:6">ዳኪ. ማዾ 20፡6</ref>።</char></note><verse eid="2TI 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14"/>ዒስኪንዲሮሴ ጎዖ ጊታሢ ፑርታ ማዾ ታኣም ማዼኔ፤ ጎዳ ዒ ማዼ ማዾጉዴያ ዒዛም ዒንጋንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡14 </char><char style="xt" closed="false"><ref loc="1TI 1:20">1ፂሞ. 1፡20</ref>፤ <ref loc="PSA 62:12">ዓይኑ. 62፡12</ref>፤ <ref loc="ROM 2:6">ሮሜ 2፡6</ref>።</char></note> <verse eid="2TI 4:14"/><verse number="15" style="v" sid="2TI 4:15"/>ዒዚ ኑ ኬኤዛ ኮዦ ሃይሶ ዒፂ፥ ማኬሢሮ ኔኤኒ ዒዛ ዔሪ ካፒንቴ።<verse eid="2TI 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16"/>ታና ዎጌና ዓርቂሴ ባኮሮ ቤርታሲ ጌኤዞ ማሂፆ ኬኤዛኒ ታ ሺኢኬ ዎዶና ቢያሢ ታ ጊዳፓ ዱማዼያፓዓቴም ዖኦኒያ ታኣና ዎላ ማዒ ታና ማኣዴ ዓሲ ባኣሴ። ዬያ ፆኦሲ ዔያቶኮ ዻቢንቲ ማሂ ዓርቆፓ። <verse eid="2TI 4:16"/><verse number="17" style="v" sid="2TI 4:17"/>ጋዓንቴ ኮዦ ሃይሳ ታ ዛሎና ጉቤ ኬኤዚንታንዳጉዲና ዓይሁዴ ማዒባኣ ዓሳ ዋይዛንዳጉዲ ጎዳ ታኣና ዎላ ማዒ ታና ዶዲሼኔ፤ ሃሣ ዞቦ ዻንጋፓኣ ታና ዻቂሼኔ። <verse eid="2TI 4:17"/><verse number="18" style="v" sid="2TI 4:18"/>ጎዳ ዓይጎዋ ማዖም ፑርታ ባኣዚዳፓ ቢያ ታና ዻቂሻንዳኔ፤ ጫሪንጫ ዓኣ ዒዛኮ ካኣቱሞይዳኣ ታና ዒ ጌልዛንዳኔ፤ ዒዛም ናንጊና ቦንቾ ማዖንጎ፤ ዓኣሜን።<verse eid="2TI 4:18"/></para>
  <para style="s1">ጋፒንሢ ሳራሥሢ</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19"/>ጲሪስቂላና ዓቂላናም፤ ሃሣ ዖኔስፖሬ ማኣሮ ዓሶም «ኮሺዳ?» ጌዔኔ፥ ጌዔ። <note caller="-" style="x"><char style="xo" closed="false">4፡19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">ዳኪ. ማዾ 18፡2</ref>፤ <ref loc="2TI 1:16-17">2ፂሞ. 1፡16-17</ref>።</char></note> <verse eid="2TI 4:19"/><verse number="20" style="v" sid="2TI 4:20"/>ዔራስፆሴ ቆሮንቶሴይዳ ዓቴኔ፤ ፂሮፒሞሴ ሃርጊንቴሢሮ ሚሊፂዳ ታ ዒዛ ሃሼኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡20 </char><char style="xt" closed="false"><ref loc="ACT 19:22">ዳኪ. ማዾ 19፡22</ref>፤ <ref loc="ROM 16:23">ሮሜ 16፡23</ref>፤ <ref loc="ACT 20:4">ዳኪ. ማዾ 20፡4</ref>፤ <ref loc="ACT 21:29">21፡29</ref>።</char></note> <verse eid="2TI 4:20"/><verse number="21" style="v" sid="2TI 4:21"/>ባርጎ ዎዳ ሄሉዋንቴ ታ ኮይላ ኔ ሙኬቴ ቃራኬ።</para>
  <para style="p" vid="2TI 4:21">ዔውቡሉሴ፥ ጱዴሴ፥ ሊኖሴ፥ ቂላውዲያና ሃሣ ኪሪስቶሴ ጉሙርቃ ዓሳ ቢያ «ኮሺዳ?» ኔና ጋዓኔ።<verse eid="2TI 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22"/>ጎዳ ኔኤና ዎላ ማዖንጎ፤ ፆኦሲኮ ኮሹሞ ዒንጊፃ ኔኤም ማዖንጎ።<verse eid="2TI 4:22"/></para>
  <chapter eid="2TI 4"/>
</usx>
