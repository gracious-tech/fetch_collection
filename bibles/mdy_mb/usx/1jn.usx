<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- MAALE Full Bible</book>
  <para style="h">1 ዮሃኒሴኮ ኪኢቶ</para>
  <para style="toc1">1 ዮሃኒሴኮ ዳኬ ኪኢቶ</para>
  <para style="toc3">1ዮሃ.</para>
  <para style="toc2">1 ዮሃኒሴኮ ኪኢቶ</para>
  <para style="mt1">ፆኦሲ ማዾም ዳኪንቴ ዮሃኒሴኮ ቤርታሳ ኪኢቶ</para>
  <para style="imt">ዓይፆ ካሮ</para>
  <para style="ip">ፆኦሲ ማዾም ዳኪንቴ ዮሃኒሴኮ ቤርታሳ ኪኢታ ላምዖ ዼኤፒ ዼኤፒ ማሊሢ ዓርቄያኬ፤ ዬያታኣ፦</para>
  <para style="ip">ኪኢቶ ናባባ ዓሶኮ ፆኦሲና ዒዛኮ ናዓሢ፥ ዬሱስ ኪሪስቶሴና ዎላ ፔቱሞ ዓኣያ ማዓንዳጉዲ ዶዲሻኒና ዬያ ፔቱሞ ባይዛኒ ዳንዳዓ ሉኡዙሞ ዔርዚፆ ዔሪ ካፒንታንዳጉዲ ላቲ ኬኤዛያኬ። ዬኖ ዎዶና ኬስኬ ሉኡዙሞ ዔርዚፃ፦ «ፑርቱሞ ሙካሢ ሃያ ጴዻ ዓጮና ካኣሚሢዳፓ ማዔሢሮ ፆኦሲኮ ናዓሢ፥ ዬሱሴ ፔቴታዖ ዓሲ ማዓኒና ሃሣ ዓሲ ማሊሢ ዓኣያ ማዓኒ ዳንዳዑዋሴ» ጋዓያኬ። ዬያታ ሉኡዙሞ ዔርዛ ዓሳ፦ «ዻቂንታ ጌይሢ ናንጊና ናንጊ ዴንቃኒ ጌዒ ማሊ ሜታዺሢ ሃሺኬ» ጋዓኔ፤ ሃሣ ዔያታ፦ «ዓሲ ‹ኮሺኬ፥ ፑርታኬ› ጌዒ ማላ ባኮንታ ሜሌ ዓሲ ናሽኪሢንታ ዻቂንታና ፔቴታዖ ዎላ ካኣሙዋሴ» ጋዓኔ።</para>
  <para style="ip">ሃኖ ኪኢቶ ፃኣፔ ዓሢ ጋዓንቴ ዬያ ማሊፆ ዒፂ ማኪሢና፦ «ዬሱስ ኪሪስቶሴ ፓጫ ባኣዚ ባኣያ ኩሙሢ ዓሲኬ፤ ዬሱሴ ጉሙርቃዞንሢና ፆኦሲ ናሽካዞንሢ ቢያ ዎሊ ናሽካንዳያ ኮይሳኔ» ጌዒ ዓሶም ፔጋሲ ኬኤዜኔ።</para>
  <para style="iot">ማፃኣፔላ ዱማ ዱማ ዓርቄ ባኮ</para>
  <para style="io1">ዓይፆ ካሮ (1፡1-4)</para>
  <para style="io1">ፖዒና ዹሚና ኮኦኪንሢ ማሂ ኬኤዚንቴ ባኮ (1፡5—2፡29)</para>
  <para style="io1">ፆኦሲ ናይና ፃላሄ ናይና ዛላ (3፡1-24)</para>
  <para style="io1">ጎኔና ሉኡዙሞና ዛላ (4፡1-6)</para>
  <para style="io1">ናሹሞ ዛላ (4፡7-21)</para>
  <para style="io1">ቢያ ባኣዚ ባሻ ጉሙርቂሢ ዛላ (5፡1-21)</para>
  <chapter number="1" style="c" sid="1JN 1"/>
  <para style="s1">ናንጊ ቃኣላ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1"/>ቤርታፓ ዓርቃዖ ዓኣ ናንጎ ቃኣሎ ዛሎ ኑ ዒንሢም ፃኣፔኔ፤ ዬይ ናንጎ ቃኣላ ኑኡኒ ዋይዜሢ፥ ኑ ዓኣፖና ኑ ዛጌሢና ኑ ዴንቄሢ ሃሣ ኑ ኩጮናኣ ኑ ዓርቄሢ ዛሎኬ። <note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="JHN 1:1">ዮሃ. 1፡1</ref>።</char></note> <verse eid="1JN 1:1"/><verse number="2" style="v" sid="1JN 1:2"/>ዬይ ናንጎ ማዔሢ ፔጋዺ ጴዼኔ፤ ኑኡኒያ ዬያ ዛጌኔ፤ ዬያ ዛሎዋ ኑ ማርካዻኔ። ዓዳሢ ኮራ ዓኣ፥ ኑኡማኣ ፔጋዺ ጴዼ፥ ናንጊና ናንጎ ኑ ዒንሢም ኬኤዛኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡2 </char><char style="xt" closed="false"><ref loc="JHN 1:14">ዮሃ. 1፡14</ref>።</char></note> <verse eid="1JN 1:2"/><verse number="3" style="v" sid="1JN 1:3"/>ዒንሢኮ ኑኡና ዎላ ፔቱሞ ዓኣያ ማዓንዳጉዲ ኑ ዛጌሢና ዋይዜሢና ዒንሢም ኬኤዛኔ፤ ኑኡኮ ፔቱማ ዓዳሢና ናዓሢ፥ ዬሱስ ኪሪስቶሴና ዎላኬ። <verse eid="1JN 1:3"/><verse number="4" style="v" sid="1JN 1:4"/>ኑኡኮ ዎዛ ኩሙሢ ማዓንዳጉዲ ሃያ ኑ ዒንሢም ፃኣፔኔ።<verse eid="1JN 1:4"/></para>
  <para style="s1">ፆኦሲኮ ፖዒ ማዒፆ</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5"/>ዒዛይዳፓ ኑ ዋይዚ ዒንሢም ኬኤዛ ኪኢታ፦ «ፆኦሲ ፖዒኬ፤ ዹሚ ዒዛ ኮራ ፔቴታዖ ባኣሴ» ጋዓያኬ። <verse eid="1JN 1:5"/><verse number="6" style="v" sid="1JN 1:6"/>ዬያሮ፦ «ፆኦሲና ዎላ ኑኡኮ ፔቱሞ ዓኣኔ» ጌዒ ጌዒ ዹሞይዳ ኑ ናንጋያ ማዔቴ ኑ ሉኡቃኔ፤ ኑ ኬኤዛ ባኮና ማዻ ባኮናኮ ጎኑሞ ባኣሴ ጌይሢኬ። <verse eid="1JN 1:6"/><verse number="7" style="v" sid="1JN 1:7"/>ጋዓንቴ ዒዚ ፖዖይዳ ዓኣሢጉዲ ኑኡኒ ፖዖይዳ ናንጋቶ ኑኡኮ ዎሊና ፔቱሞ ዓኣያ ማዓንዳኔ፤ ሃሣ ዒዛኮ ናዓሢ፥ ዬሱስ ኪሪስቶሴኮ ሱጉፃ ጎሜ ቢያይዳፓ ኑና ጌኤሻኔ።<verse eid="1JN 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8"/>«ጎሜ ኑኡኮ ባኣሴ» ኑ ጌዔቴ ኑና ኑ ጌሻኔ፤ ጎኑሞዋ ኑ ጊዳ ባኣሴ። <verse eid="1JN 1:8"/><verse number="9" style="v" sid="1JN 1:9"/>ኑኡኮ ጎሞ ፆኦሲም ኑ ቡኡፄቴ ዒዚ ጉሙርቂንታያ፥ ሃሣ ጌኤሺ ማዔሢሮ ጎሞ ኑኡኮ ቢያ ዓቶም ጋዓንዳኔ፤ ኑ ዻቢንቶይዳፓኣ ቢያ ኑና ዒ ጌኤሻንዳኔ። <verse eid="1JN 1:9"/><verse number="10" style="v" sid="1JN 1:10"/>«ጎሜ ኑ ማዺባኣሴ» ጌዔቴ ፆኦሲ ሉኡዚ ኑ ማሃኔ፤ ዒዛኮ ቃኣላኣ ኑ ጊዳ ባኣሴ።<verse eid="1JN 1:10"/></para>
  <chapter eid="1JN 1"/>
  <chapter number="2" style="c" sid="1JN 2"/>
  <para style="s1">ኪሪስቶሴ ኑና ማኣዳያ ማዒፆ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1"/>ታ ናይዮቴ! ሃያ ታ ዒንሢም ፃኣፓሢ ጎሜ ዒንሢ ማዹዋጉዲ ጌይኬ፤ ጋዓንቴ ዓይጎ ዓሲያ ማዖም ጎሜ ማዼያ ማዔቴ ኑ ዓዳሢ ኮይላ ማዒ ኑ ዛሎ ጌስታይ ዓኣኔ፤ ዒዚያ ፂሎ ማዔ ዬሱስ ኪሪስቶሴኬ። <verse eid="1JN 2:1"/><verse number="2" style="v" sid="1JN 2:2"/>ኑኡኮ ጎማ ዓቶም ጌይንታሢ ዒዛናኬ፤ ያዺ ማዓሢ ኑ ጎሞ ሌሊቱዋንቴ ዓጮ ዓሶ ቢያሢሲኬ።<verse eid="1JN 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3"/>ፆኦሲኮ ዓይሢፆ ኑ ኩንሣያ ማዔቴ ኑ ዒዛ ዔራያ ማዒፆ ዬያና ኑ ጎናሲ ዔራንዳኔ። <verse eid="1JN 2:3"/><verse number="4" style="v" sid="1JN 2:4"/>«ፆኦሲ ታ ዔራኔ» ጌይ ጌይ ዒዛኮ ዓይሢፆ ኩንሡዋይ ዓኣቶ ዬይ ሉኡዚ ዓሲኬ፤ ጎኑሞዋ ዒዛይዳ ባኣያኬ። <verse eid="1JN 2:4"/><verse number="5" style="v" sid="1JN 2:5"/>ጋዓንቴ ፆኦሲ ቃኣሎም ዓይሢንታሢ ቢያ ፆኦሲ ጉቤ ዒናፓ ናሽካኔ፤ ጎኔና ኑኡኮ ፆኦሲ ዓሲ ማዒፃ ዔርታሢ ዬያናኬ። <verse eid="1JN 2:5"/><verse number="6" style="v" sid="1JN 2:6"/>«ፆኦሲና ታ ናንጋኔ» ጋዓ ዓሲ ኪሪስቶሴ ናንጌ ጎይፆ ናንጋንዳያ ኮይሳኔ።<verse eid="1JN 2:6"/></para>
  <para style="s1">ዓኮ ዓይሢፆ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7"/>ታ ዒጊኖንሢዮቴ! ሃይ ታ ዒንሢም ፃኣፓ ኪኢታ ቤርታፓ ዓርቃዖ ዒንሢ ዔራያ ሃሣ ናንጌያ ማዓንዳኣፓዓቴም ዓኪቱዋሴ፤ ሃይ ናንጌ ዓይሢፃ ቤርታ ዒንሢ ዋይዜ ቃኣሎኬ። <note caller="-" style="x"><char style="xo" closed="false">2፡7 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሃ. 13፡34</ref>።</char></note> <verse eid="1JN 2:7"/><verse number="8" style="v" sid="1JN 2:8"/>ማዔቴያ ኪሪስቶሴ ናንጎና ዒንሢ ናንጎናይዳ ጎኔ ማዒ ጴዼ፥ ዓኪ ኪኢታ ታ ዒንሢም ፃኣፓኔ፤ ዓይጎሮ ጌዔቴ ዹማ ባይቂ ጎኑሞ ፖዒ ፖዒ ፖዒ ዓኣሢሮኬ።<verse eid="1JN 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9"/>«ፖዒዳ ታ ናንጋኔ» ጌዒ ጌዒ ፔ ዒሻሢና ፔ ሚሼሎና ዒፃሢ ሃጊ ዹማ ዓኣኔ። <verse eid="1JN 2:9"/><verse number="10" style="v" sid="1JN 2:10"/>ፔ ዒሻሢና ፔ ሚሼሎና ናሽካሢ ቢያ ፖዒዳ ናንጋያኬ፤ ዒዛ ዛሎና ዓሲ ዻቢንቲ ጎሜይዳ ጌላዓኬ። <verse eid="1JN 2:10"/><verse number="11" style="v" sid="1JN 2:11"/>ፔ ዒሻሢና ፔ ሚሾና ዒፃሢ ጋዓንቴ ዹሚዳ ናንጋኔ፤ ሃሣ ዹሞይዳኣ ሃንታኔ ዹማ ዓኣፖ ዒዛኮ ባይዜሢሮ ዒ ዓኣዻ ቤዞዋ ዔሩዋያኬ።<verse eid="1JN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12"/>ታ ናይዮቴ! ጎማ ዒንሢኮ ኪሪስቶሴ ሱንፆና ዓቶም ጌይንቴሢሮ ታ ዒንሢም ፃኣፓኔ። <verse eid="1JN 2:12"/><verse number="13" style="v" sid="1JN 2:13"/>ዓዶንሢዮቴ! ቤርታፓ ዓኣሢ፥ ዒዛ ዒንሢ ዔሬሢሮ ታ ዒንሢም ፃኣፓኔ። ዼጌዞቴ! ፑርታሢ ዒንሢ ባሼሢሮ ታ ዒንሢም ፃኣፓኔ።<verse eid="1JN 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14"/>ናይዮቴ! ፆኦሲ፥ ዓዳሢ ዒንሢ ዔሬሢሮ ታ ዒንሢም ፃኣፓኔ። ዓዶንሢዮቴ! ቤርታኣፓ ዓኣሢ፥ ዒዛ ዒንሢ ዔሬሢሮ ታ ዒንሢም ፃኣፓኔ። ዼጌዞቴ! ዶዲ ዒንሢ ማዔሢሮ፥ ፆኦሲ ቃኣሎናኣ ዒንሢ ዶዲ ዓኣሢሮ ሃሣ ፑርታሢያ ዒንሢ ባሼሢሮ ታ ዒንሢም ፃኣፓኔ።<verse eid="1JN 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15"/>ሃያ ዓጮንታ ሃያ ዓጮይዳ ዓኣ ዓይጎ ባኣዚያ ናሽኪፖቴ፤ ዓጮ ናሽካ ዓሲ ፆኦሲ፥ ዓዳሢ ናሽኩዋያኬ። <verse eid="1JN 2:15"/><verse number="16" style="v" sid="1JN 2:16"/>ዓይጎሮ ጌዔቴ ዓሲኮ ፑርታ ሱኡኬ፥ ዓኣፒም ኮሽካ ባኣዚና ዓሲ ሄርሺንቲሳ ባኣዚ ሃያ ዓጫፓ ማዓንዳኣፓዓቴም ፆኦሲ፥ ዓዳሢዳፓቱዋሴ። <verse eid="1JN 2:16"/><verse number="17" style="v" sid="1JN 2:17"/>ሃያ ዓጮና ሃካ ዓኣ ፑርቶ ሱኡካ ባይቃንዳኔ፤ ፆኦሲ ማሊፆ ኩንሢ ናንጋሢ ጋዓንቴ ናንጊና ናንጋንዳኔ።<verse eid="1JN 2:17"/></para>
  <para style="s1">ኪሪስቶሴ ዒፂ ማካ ዓሶ ዔሪ ካፒንቲሢ ዛላ</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18"/>ታ ናይዮቴ! ሃይ ጋፒንሢ ዎዴኬ፤ «ኪሪስቶሴ ዒፂ ማካይ ሙካንዳኔ» ጌይንቴሢ ዒንሢ ዋይዜኔ፤ ሃሢያ ሃይሾ ኪሪስቶሴ ዒፂ ማካይ ሚርጌ ኬስኬኔ። ያዺ ማዒፆና ሃይ ጋፒንፆ ዎዶ ማዔሢ ኑ ዔራኔ። <verse eid="1JN 2:18"/><verse number="19" style="v" sid="1JN 2:19"/>ዔያታ ኬስኬሢ ኑ ባኣካፓኬ፤ ማዔቴያ ቤርታ ዔያታ ጎኔ ኑኡና ዎላ ዓኣያቱዋሴ፤ ዎንዴ ዔያታ ጎኔ ኑኡና ዎላ ዓኣያ ማዒ ዓኣቴ ኑኡና ዎላ ዶዲ ናንጌያ ናንዳንቴኬ፤ ቢያሢ ጎኔ ኑኡና ዎላ ማዒባኣያ ማዔሢ ዔያቶኮ ዔርታንዳጉዲ ኑ ባኣካፓ ዔያታ ዱማዺ ኬስኬኔ።<verse eid="1JN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20"/>ዒንሢዳ ጋዓንቴ ኪሪስቶሴ ዓያኖ ጌኤዦ ኬይሴሢሮ ዒንሢ ቢያሢ ጎኔ ባኮ ዔራኔ። <verse eid="1JN 2:20"/><verse number="21" style="v" sid="1JN 2:21"/>ታኣኒ ዒንሢም ፃኣፓሢ ጎኔ ባኮ ዒንሢ ዔሩዋኣሢሮቱዋሴ፤ ዒንሢ ጎኔ ባኮ ዔዔራኔ፤ ጎኔይዳ ሉኡዙሞ ባኣዚ ባኣሢያ ዒንሢ ዔራኔ።<verse eid="1JN 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22"/>ዓካሪ ዬሱሴ፦ «ሜሲሄ» ማዔሢ «ታ ዔሩዋሴ» ጋዓሢዳፓ ዓታዛ ሉኡዚ ጎዖሢ ዖናዳይ? ፆኦሲ ዓዳሢና ናዓሢና «ታ ዔሩዋሴ» ጋዓሢ ቢያ ኪሪስቶሴ ዒፂ ማካሢኬ። <verse eid="1JN 2:22"/><verse number="23" style="v" sid="1JN 2:23"/>ናዓሢ «ታ ዔሩዋሴ» ጋዓሢ ዓዳሢያ ዔሩዋያኬ፤ ናዓሢ ጉሙርቃሢ ዓዶዋ ጉሙርቃኔ።<verse eid="1JN 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24"/>ዒንሢኮ ጋዓንቴ ቤርታ ዒንሢ ዋይዜ ቃኣላ ዒና ዓኣያ ማዖንጎ፤ ያዺ ማዔቴ ዒንሢኮ ናዓሢና ዓዶና ዎላ ፔቱሞ ዓኣያ ማዓንዳኔ። <verse eid="1JN 2:24"/><verse number="25" style="v" sid="1JN 2:25"/>ዬይ፤ ኪሪስቶሴ ኑም ዒንጌ ሃጊ ማዓንዳ ዎዛ ናንጊና ናንጎኬ።<verse eid="1JN 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26"/>ዒንሢ ጌሺ ዻቢሳ ዓሶ ዛሎና ሃያ ታ ዒንሢም ፃኣፔኔ፤ <verse eid="1JN 2:26"/><verse number="27" style="v" sid="1JN 2:27"/>ጋዓንቴ ኪሪስቶሴይዳፓ ዒንሢ ዔኬ ዓያና ዒንሢዳ ናንጋሢሮ ሜሌ ዖኦኒያ ዒንሢ ዔርዛንዳያ ኮይሱዋሴ፤ ዒዚ ቢያ ባኣዚ ዒንሢ ዔርዛንዳኔ፤ ዒዚ ዒንሢ ዔርዛንዳሢ ጎኔ ባኣዚ ማዓንዳኣፓዓቴም ሉኡዙሞቱዋኣሢሮ ዒዚ ዒንሢ ዔርዛ ጎይፆማ ኪሪስቶሴና ናንጉዋቴ።<verse eid="1JN 2:27"/></para>
  <para style="s1">ፆኦሲ ናይ</para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28"/>ዓካሪ ታ ናይዮቴ! ዒዚ ሙኪ ጴዻ ዎዶና ኑኡኒ ዒጊጩዋዖ ጫርቂ ዒዛ ኑ ዛጋንዳጉዲና ዒ ሙካኣና ኑ ቦርሲንቱዋጉዲ ዒዛና ናንጉዋቴ፤ <verse eid="1JN 2:28"/><verse number="29" style="v" sid="1JN 2:29"/>ዒዚ ፂሎ ማዔሢ ዒንሢ ዔሬቴ ፂሎ ማዻሢ ቢያ ፆኦሲ ናይ ማዓሢ ዔሩዋቴ።<verse eid="1JN 2:29"/></para>
  <chapter eid="1JN 2"/>
  <chapter number="3" style="c" sid="1JN 3"/>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1"/>«ፆኦሲ ናይ» ኑ ጌይንታንዳጉዲ ዓዳሢ ዎዚጉዴ ናሹሞና ኑና ናሽኬቴ ሂንዳ ዛጉዋቴ! ጎኔ ኑ ፆኦሲ ናኣቶኬ። ዓጫ ዒዛ ዔሪባኣሢሮ ኑናኣ ዔሩዋሴ። <note caller="-" style="x"><char style="xo" closed="false">3፡1 </char><char style="xt" closed="false"><ref loc="JHN 1:12">ዮሃ. 1፡12</ref>።</char></note> <verse eid="1JN 3:1"/><verse number="2" style="v" sid="1JN 3:2"/>ታ ዒጊኖንሢዮቴ! ሃሢ ኑኡኒ ፆኦሲ ናይኬ፤ ሃጊ ኑ ዎይታንዳቴያ ዔርቲባኣሴ። ጋዓንቴ ኪሪስቶሴ ሙኪ ጴዻ ዎዶና ጎኔና ኑ ዒዛ ዛጋንዳሢሮ ዒዛ ኑ ማላንዳሢ ኑ ዔራኔ። <verse eid="1JN 3:2"/><verse number="3" style="v" sid="1JN 3:3"/>ዬይ ያዺ ማዓንዳያታሢ ኪሪስቶሴ ዛሎና ሃጊ ማዓንዳ ዎዛ ጌሣሢ ቢያ ኪሪስቶሴ ጌኤሺ ማዔሢጉዲ ፔና ጌኤሻኔ።<verse eid="1JN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4"/>ጎሜ ማዻሢ ቢያ ፆኦሲኮ ዎጎ ዑሣ ዓኣዻኔ፤ ዎይቲ ጌዔቴ ጎሜ ጌይሢ ፆኦሲ ዎጎኮ ዑሣ ዓኣዺሢታሢሮኬ። <verse eid="1JN 3:4"/><verse number="5" style="v" sid="1JN 3:5"/>ኪሪስቶሴ ዓሲኮ ጎሞ ጌኤሻኒ ሙኪ ጴዼሢና ዒዛኮ ጎሜ ባኣያታሢ ዒንሢ ዔራኔ። <note caller="-" style="x"><char style="xo" closed="false">3፡5 </char><char style="xt" closed="false"><ref loc="JHN 1:29">ዮሃ. 1፡29</ref>።</char></note> <verse eid="1JN 3:5"/><verse number="6" style="v" sid="1JN 3:6"/>ዬያሮ ኪሪስቶሴና ናንጋ ዓሲ ቢያ ጎሜ ማዺ ማዺ ናንጉዋሴ፤ ጎሜ ማዺ ማዺ ናንጋ ዓሲ ጋዓንቴ ኪሪስቶሴ ዛጊባኣያኬ፤ ሃሣ ዔሪባኣያኬ።<verse eid="1JN 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7"/>ታ ናይዮቴ! ዖኦኒያ ዒንሢ ጌሺ ዻቢሱዋጉዲ፤ ኪሪስቶሴ ፂሎ ማዔሢጉዲ ፂሎ ማዾ ማዻሢ ቢያ ፂሎኬ። <verse eid="1JN 3:7"/><verse number="8" style="v" sid="1JN 3:8"/>ፃላሄ ቤርታኣፓ ዓርቃዖ ጎሜ ማዻያታሢሮ ጎሜ ማዻሢ ቢያ ፃላሄ ናይኬ። ፆኦሲ ናዓሢ ሙኪ ጴዼሢ ፃላሄኮ ማዾ ባይዛኒኬ።<verse eid="1JN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9"/>ፆኦሲ ናይ ማዔያ ጎሜ ማዺ ማዺ ናንጉዋሴ፤ ሃሣ ማዺ ማዺ ናንጋኒያ ዳንዳዑዋሴ። ዎይቲ ጌዔቴ ፆኦሲ ማሊፃ ዒዛይዳ ናንጋሢሮና ፆኦሲ ናይ ዒ ማዔሢሮኬ። <verse eid="1JN 3:9"/><verse number="10" style="v" sid="1JN 3:10"/>ፆኦሲ ናኣቶና ፃላሄ ናኣቶና ዱማዺ ዔርታሢ ዬያናኬ፤ ፂሎ ማዾ ማዹዋያ፥ ሃሣ ፔኤኮ ዒሻሢንታ ሚሾንታ ናሽኩዋኣሢ ቢያ ፆኦሲ ናይቱዋሴ።<verse eid="1JN 3:10"/></para>
  <para style="s1">ዎሊ ናሽኪሢ ዛላ</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11"/>ቤርታኣፓ ዒንሢ ዋይዜ ኪኢታ፦ «ዎሊ ኑ ናሽኮም» ጋዓያኬ። <note caller="-" style="x"><char style="xo" closed="false">3፡11 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሃ. 13፡34</ref>።</char></note> <verse eid="1JN 3:11"/><verse number="12" style="v" sid="1JN 3:12"/>ፃላሄ ዓሲ ማዒ ፔ ጌርሲ ዎዼ፥ ቃኣዔኤሌጉዲ ማዓንዳያ ኑም ኮይሱዋሴ፤ ዒዚ ፔኤኮ ጌርሲ ዓይጎሮ ዎዼይ ጌዔቴ ዒዛኮ ማዻ ፑርታ ማዔሢሮና ጌርሲ ማዻ ፒዜ ማዔሢሮኬ። <note caller="-" style="x"><char style="xo" closed="false">3፡12 </char><char style="xt" closed="false"><ref loc="GEN 4:8">ማዢ. ማፃ 4፡8</ref>።</char></note><verse eid="1JN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13"/>ታ ዒሾንሦ! ታ ሚሾንሦ! ዓጫ ዒንሢ ዒፄቶ ዲቃቲ ሄርሺፖቴ። <verse eid="1JN 3:13"/><verse number="14" style="v" sid="1JN 3:14"/>ኑኡኒ ኑ ዒሾንሢና ኑ ሚሾንሢና ናሽካሢሮ ሃይቢፓ ናንጊ ባንሢ ኑ ፒንቄሢ ኑ ዔራኔ፤ ናሹሞባኣ ዓሲ ሃይቄያ ማዒ ናንጋኔ። <note caller="-" style="x"><char style="xo" closed="false">3፡14 </char><char style="xt" closed="false"><ref loc="JHN 5:24">ዮሃ. 5፡24</ref>።</char></note> <verse eid="1JN 3:14"/><verse number="15" style="v" sid="1JN 3:15"/>ፔ ዒሻሢና ፔ ሚሾና ዒፃሢ ቢያ ዓሲ ሼምፖ ዎዻያኬ፤ ዓሲ ሼምፖ ዎዻ ዓሲኮ ናንጊና ናንጊ ባኣሢ ዒንሢ ዔራኔ። <verse eid="1JN 3:15"/><verse number="16" style="v" sid="1JN 3:16"/>ናሹሞ ዓይጎ ማዔቴያ ኑ ዔራሢ ዬሱስ ኪሪስቶሴ ፔ ሼምፓሢ ኑም ዓኣሢ ዒንጌሢሮኬ፤ ኑኡኒ ሃሣ ኑ ሼምፓሢ ኑ ዒሾንሢንታ ሚሾንሢንታ ዛሎ ዓኣሢ ዒንጋንዳያ ኮይሳኔ። <verse eid="1JN 3:16"/><verse number="17" style="v" sid="1JN 3:17"/>ዓሲ ሃያ ዓጮይዳ ፔኤኮ ቆሎ ዓኣንቴ ሜታዼ ዓሲ ዛጋዖ ሚጪንቲባኣቴ «ፆኦሲ ናሽካኔ» ዎይቲ ጋዓኒ ዳንዳዓይ? <verse eid="1JN 3:17"/><verse number="18" style="v" sid="1JN 3:18"/>ታ ናይዮቴ! ኑኡኮ ናሹማ ጎኔ፥ ሃሣ ማዾና ጴዻያ ማዖንጎ፤ ዻንጋና ኬኤዚሢና ሌሊ ማዖፓ። <verse eid="1JN 3:18"/><verse number="19" style="v" sid="1JN 3:19"/>ዬያና ኑ ጎኑሞ ዓሲ ማዒፆንታ ፆኦሲ ቤርቶ ዓልቱዋዖ ጉሙርቂ ኑ ሺኢካኒ ዳንዳዓሢ ኑ ዔራኔ። <verse eid="1JN 3:19"/><verse number="20" style="v" sid="1JN 3:20"/>ኑኡኮ ዒና ፑርቶ ማዾ ኑ ማዻሢ፦ «ዻባኔ» ጌዔቴያ ፆኦሲ ኑኡኮ ዒናፓ ዑፃ ማዔሢ፤ ሃሣ ቢያ ባኣዚ ዔራያ ማዔሢ ኑ ዔራኔ። <verse eid="1JN 3:20"/><verse number="21" style="v" sid="1JN 3:21"/>ታ ዒጊኖንሢዮቴ! ዒና ኑኡኮ ዻቢንቶ ኑም ኬኤዙዋያ ማዔቴ ፆኦሲ ቤርቶይዳ ዓልቱዋያ ኑ ማዓንዳኔ። <verse eid="1JN 3:21"/><verse number="22" style="v" sid="1JN 3:22"/>ፆኦሲኮ ዓይሢፆ ኑ ኩንሣያና ዒዛ ዎዛሳ ባኣዚ ኑ ማዻያ ማዔሢሮ ኑ ዒዛ ሺኢቃ ባኮ ቢያ ዒዛይዳፓ ኑ ዔካንዳኔ። <verse eid="1JN 3:22"/><verse number="23" style="v" sid="1JN 3:23"/>ዒዛኮ ዓይሢፃ ዒዛኮ ናዓሢ፥ ዬሱስ ኪሪስቶሴ ኑ ጉሙርቃንዳጉዲና ሃሣ ኪሪስቶሴያ ኑና ዓይሤ ጎይፆ ዎሊ ኑ ናሽካንዳጉዲኬ። <note caller="-" style="x"><char style="xo" closed="false">3፡23 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሃ. 13፡34</ref>፤ <ref loc="JHN 15:12">15፡12</ref>፤ <ref loc="JHN 17">17</ref>።</char></note> <verse eid="1JN 3:23"/><verse number="24" style="v" sid="1JN 3:24"/>ፆኦሲ ዓይሢፆ ኩንሣሢ ቢያ ፆኦሲና ናንጋኔ፤ ፆኦሲያ ዒዛይዳ ናንጋኔ። ፆኦሲ ኑጊዳ ናንጋሢ ኑ ዔራሢ ዒዚ ኑም ዒንጌ ዓያኖናኬ።<verse eid="1JN 3:24"/></para>
  <chapter eid="1JN 3"/>
  <chapter number="4" style="c" sid="1JN 4"/>
  <para style="s1">ዓያና ዱማሲ ዔሪሢ ዛላ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1"/>ዒጊኖንሢዮቴ! ዓጮይዳ ሚርጌ፥ ሉኡዙሞና ፆኦሲ ማሊሢ ኬኤዛያ ማላ ዓሲ ኬስኬሢሮ ዓያኖ ቢያ ጎኔ ዓያናኬ ጌይፖቴ፤ ዬያይዳፓ ዺቦ ዓያና ፆኦሲፓታቴያ ቱዋቴያ ዱማሲ ዔራኒ ዛጉዋቴ። <verse eid="1JN 4:1"/><verse number="2" style="v" sid="1JN 4:2"/>ፆኦሲ ዓያኖ ዱማሲ ዒንሢ ዔራኒ ዳንዳዓሢ ያዺኬ፤ ዬይያ፦ ዬሱስ ኪሪስቶሴ ዓሲ ማዒ ጴዼሢ ማርካዻ ዓያና ፆኦሲ ዓያናኬ፤ <verse eid="1JN 4:2"/><verse number="3" style="v" sid="1JN 4:3"/>ዬሱስ ኪሪስቶሴ ዓሲ ማዒ ጴዼሢ ማርካዹዋ ዓያና ፆኦሲ ዓያናቱዋሴ፤ ዬይ ዓያና «ሙካንዳኔ» ጌይንቴም ዒንሢ ዋይዜ፥ ኪሪስቶሴ ዒፃሢ ዓያኖኬ፤ ዬይ ሃሢያ ዓጮይዳ ዓኣኔ።<verse eid="1JN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4"/>ታ ናይዮቴ! ዒንሢ ፆኦሲሮኬ፤ ዒንሢዳ ዓኣ ዓያና ዓጮይዳ ዓኣ ዓያኖይዳፓ ባሼኬ፤ ዬያሮ ሉኡቂ ፆኦሲ ማሊፆ ኬኤዛያ ማላ ዓሶ ዒንሢ ባሼኔ። <verse eid="1JN 4:4"/><verse number="5" style="v" sid="1JN 4:5"/>ዔያታ ሃያ ዓጮሮ ማዔሢሮ ዔያታ ኬኤዛሢ ሃያ ዓጮ ባኣዚኬ፤ ሃይ ዓጫኣ ዔያቶሲ ዋዋይዛኔ። <verse eid="1JN 4:5"/><verse number="6" style="v" sid="1JN 4:6"/>ኑኡኒ ጋዓንቴ ፆኦሲሮኬ፤ ፆኦሲ ዔራሢ ቢያ ኑኡሲ ዋይዛንዳኔ፤ ፆኦሲሮ ማዒባኣሢ ኑ ጋዓሢ ዋይዛዓኬ። ጎኑሞ ዓያኖና ሉኡዙሞ ዓያኖና ዱማሲ ኑ ዔራንዳሢ ዬያናኬ።<verse eid="1JN 4:6"/></para>
  <para style="s1">ፆኦሲ ዓሲ ናሽካያ ማዔሢ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7"/>ታ ዒጊኖንሢዮቴ! ናሹሞ ፆኦሲዳፓ ማዔሢሮ ዎሊ ኑ ናሽኮም፤ ዬያይዴቴ ኑ ፆኦሲ ናይኬ፤ ፆኦሲያ ኑ ዔራኔ። <verse eid="1JN 4:7"/><verse number="8" style="v" sid="1JN 4:8"/>ፆኦሲ ዓሲ ናሽካያታሢሮ ናሹሞ ባኣሢ ፆኦሲ ዔሩዋያኬ። <verse eid="1JN 4:8"/><verse number="9" style="v" sid="1JN 4:9"/>ፔኤኮ ናዓሢ ዛሎና ናንጊ ኑ ዴንቃንዳጉዲ ፆኦሲ ፔቴ ናዖ ዓጮ ዳኬኔ፤ ዬያና ፆኦሲኮ ናሹማ ዎዚጉዴያታቴያ ኑም ፔጋዺ ዔርቴኔ። <verse eid="1JN 4:9"/><verse number="10" style="v" sid="1JN 4:10"/>ኑኡኒ ፆኦሲ ናሽኬሢሮቱዋንቴ ዒዚ ኑና ናሽኪ፥ ጎማ ኑኡኮ ዓቶም ጌይንታንዳጉዲ ፔኤኮ ናዖ ዳኬኔ፤ ናሹሞ ጌይፃ ያዺኬ።<verse eid="1JN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11"/>ታ ዒጊኖንሢዮቴ! ፆኦሲ ኑና ዬያይዲ ናሽኬያ ማዔቴ ኑ ዎሊ ናሽካንዳያ ኮይሳኔ። <verse eid="1JN 4:11"/><verse number="12" style="v" sid="1JN 4:12"/>ፆኦሲ ዛጌ ዓሲ ፔቴታዖ ባኣሴ። ኑኡኒ ዎሊ ናሽኬቴ ፆኦሲ ኑኡና ዎላ ናንጋንዳኔ፤ ዒዛ ናሹማኣ ጎኔና ኑ ዒና ዓኣያ ማዓንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡12 </char><char style="xt" closed="false"><ref loc="JHN 1:18">ዮሃ. 1፡18</ref>።</char></note><verse eid="1JN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13"/>ፆኦሲ ፔኤኮ ዓያኖ ኑማኣ ዒንጌሢሮ ኑኡኒ ዒዛና ናንጋሢንታ ዒዚያ ኑኡና ናንጋሢ ኑ ዔራኔ። <verse eid="1JN 4:13"/><verse number="14" style="v" sid="1JN 4:14"/>ፆኦሲ፥ ዓዳሢ ዓጮ ዻቂሻሢ ማሂ ፔ ናዓሢ ዳኬሢ ኑ ዛጌኔ፤ ሃሣ ኑ ማርካዻኔ። <verse eid="1JN 4:14"/><verse number="15" style="v" sid="1JN 4:15"/>ዬሱሴ ፆኦሲ ናይ ማዔሢ ማርካዻ ዓሲዳ ቢያ ፆኦሲ ናንጋኔ፤ ዒዚያ ፆኦሲና ናንጋኔ። <verse eid="1JN 4:15"/><verse number="16" style="v" sid="1JN 4:16"/>ዬያሮ ፆኦሲ ኑና ናሽካ ናሹሞ ኑ ዔራኔ፤ ሃሣ ኑ ጉሙርቃኔ። ፆኦሲ ዓሲ ናሽካያኬ፤ ናሹሞ ዓኣ ዓሲ ፆኦሲና ናንጋኔ፤ ፆኦሲያ ዒዛና ናንጋኔ። <verse eid="1JN 4:16"/><verse number="17" style="v" sid="1JN 4:17"/>ኑኡኒ ጎኔና ዎሊ ናሽኬቴ፥ ሃሣ ኪሪስቶሴ ናንጌ ጎይፆ ሃያ ዓጮይዳ ኑ ናንጌቴ ጋፒንፆ ዎጎ ኬሎና ኑ ሂርጉዋዖ ዒዛ ቤርቶ ሺኢካንዳኔ። <verse eid="1JN 4:17"/><verse number="18" style="v" sid="1JN 4:18"/>ናሹሞ ዓኣያታቴ ሂርጋ ባኣሴ፤ ጎኔ ናሹሞ ዒዞ ኬሎና ሂርጎ ባይዛንዳኔ፤ ሂርጋ «ፑርታና ዎጊሳንዳኔ» ጌይ ማሊሢዳፓ ሙካሢሮ ሂርጋ ዓሶኮ ናሹማ ኩሙሢ ናሹሞቱዋሴ።<verse eid="1JN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19"/>ፆኦሲ ቤርታዺ ኑና ናሽኬሢሮ ኑ ዒዛ ናሽካኔ። <verse eid="1JN 4:19"/><verse number="20" style="v" sid="1JN 4:20"/>«ፆኦሲ ታ ናሽካኔ» ጌይ ጌይ ፔ ዒሻሢና ፔ ሚሼሎና ዒፃሢ ሉኡዚ ዓሲኬ፤ ዒ ዴንቃ ፔ ዒሻሢና ፔ ሚሼሎና ናሽኪባኣያ ማዔቴ ዒ ዴንቁዋ ፆኦዛሢ ናሽካኒ ዳንዳዑዋሴ። <verse eid="1JN 4:20"/><verse number="21" style="v" sid="1JN 4:21"/>ዬያሮ ኪሪስቶሴ ኑም ዓይሤ ዓይሢፃ፦ «ፆኦሲ ናሽካሢ ፔ ዒሻሢንታ ፔ ሚሼሎንታ ናሽኮንጎ» ጋዓያኬ።<verse eid="1JN 4:21"/></para>
  <chapter eid="1JN 4"/>
  <chapter number="5" style="c" sid="1JN 5"/>
  <para style="s1">ዓጮ ባሺሢ ዛላ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1"/>ዬሱሴ ሜሲሄ ማዔሢ ጉሙርቃሢ ቢያ ፆኦሲ ናይኬ፤ ዓዳሢ ናሽካሢ ቢያ ናዓሢያ ናሽካኔ። <verse eid="1JN 5:1"/><verse number="2" style="v" sid="1JN 5:2"/>ፆኦሲ ናኣቶ ኑ ናሽካያ ማዔሢ ኑ ዔራንዳሢ ፆኦሲ ናሽኪ፥ ዒዛኮ ዓይሢፆዋ ኑ ኩንሤ ዎዶናኬ። <verse eid="1JN 5:2"/><verse number="3" style="v" sid="1JN 5:3"/>ፆኦሲ ናሽኪሢ ጌይሢ ዒዛኮ ዓይሢፆ ኩንሥሢኬ፤ ዒዛኮ ዓይሢፃ ሜታሳያቱዋሴ። <note caller="-" style="x"><char style="xo" closed="false">5፡3 </char><char style="xt" closed="false"><ref loc="JHN 14:15">ዮሃ. 14፡15</ref>።</char></note> <verse eid="1JN 5:3"/><verse number="4" style="v" sid="1JN 5:4"/>ዎይቲ ጌዔቴ ፆኦሲ ናይ ማዔሢ ቢያ ዓጮ ባሻያታሢሮኬ፤ ዓጮ ኑ ባሻንዳሢያ ፆኦሲ ጉሙርቂፆናኬ። <verse eid="1JN 5:4"/><verse number="5" style="v" sid="1JN 5:5"/>ዓጮ ባሻንዳሢ ዬሱሴ ፆኦሲ ናይ ማዔሢ ጉሙርቃሢ ሌሊኬ።<verse eid="1JN 5:5"/></para>
  <para style="s1">ኪሪስቶሴ ዛሎ ማርካዺንቴ ማርካቶ</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6"/>ዒዛኮ ማስቲፆ ዔርዛ ዋኣፆንታ ሃይቦ ዔርዛ ሱጉፆንታ ኬስኬሢ ዬሱስ ኪሪስቶሴይዳፓኬ፤ ዒዛኮ ኬስኬሢ ዋኣሢ ሌሊቱዋንቴ ዋኣሢና ሱጉሢናኬ፤ ዬይ ጎኔ ማዔሢ ዓያኖ ጌኤዣ ማርካዻኔ፤ ዎይቲ ጌዔቴ ዓያኖ ጌኤዣ ጎኔ ኬኤዛያታሢሮኬ። <verse eid="1JN 5:6"/><verse number="7" style="v" sid="1JN 5:7"/>ዬያሮ ዒዛኮ ሃይሦ ማርካ ዓኣኔ፤ <verse eid="1JN 5:7"/><verse number="8" style="v" sid="1JN 5:8"/>ዬያታ ዓያና ጌኤሺንታ ዋኣሢንታ ሱጉሢንታኬ፤ ዬንሢ ሃይሦንሢ ማርካዻ ማርካታ ፔቴ ማዓያኬ። <verse eid="1JN 5:8"/><verse number="9" style="v" sid="1JN 5:9"/>ዓሲ ማርካዻ ማርካቶ ኑ ዔካኔ፤ ጋዓንቴ ፆኦሲ ማርካታ ቢያይዳፓ ባሼኬ። ፆኦሲ ፔኤኮ ናዓሢ ዛሎ ማርካዼ ማርካታ ያዺኬ። <verse eid="1JN 5:9"/><verse number="10" style="v" sid="1JN 5:10"/>ፆኦሲ ናዓሢ ጉሙርቃሢኮ ዬይ ማርካታ ዒና ዓኣኔ። ፆኦሲ ጉሙርቁዋኣሢ ጋዓንቴ ፆኦሲ ፔኤኮ ናዖ ዛሎ ማርካዼ ማርካቶ ጉሙርቂባኣሢሮ ፆኦሲ ሉኡቄያ ማሃኔ። <verse eid="1JN 5:10"/><verse number="11" style="v" sid="1JN 5:11"/>ዬይ ማርካታ ፆኦሲ ናንጊና ናንጊ ኑም ዒንጌሢና ዬያ ናንጎ ዒዛኮ ናዓሢ ዒንጋያታሢ ማርካዻያኬ። <note caller="-" style="x"><char style="xo" closed="false">5፡11 </char><char style="xt" closed="false"><ref loc="JHN 3:36">ዮሃ. 3፡36</ref>።</char></note> <verse eid="1JN 5:11"/><verse number="12" style="v" sid="1JN 5:12"/>ፆኦሲ ናዓሢ ዓኣሢኮ ናንጊ ዓኣኔ፤ ፆኦሲ ናዓሢ ባኣሢኮ ጋዓንቴ ናንጊ ባኣሴ።<verse eid="1JN 5:12"/></para>
  <para style="s1">ናንጊና ናንጊ</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13"/>ዒንሢ፥ ፆኦዛሢ ናዓሢ ሱንፆና ጉሙርቃዞንሢኮ ቢያ ናንጊና ናንጊ ዓኣያ ማዔሢ ዒንሢ ዔራንዳጉዲ ሃያ ቢያ ታ ዒንሢም ፃኣፓኔ። <verse eid="1JN 5:13"/><verse number="14" style="v" sid="1JN 5:14"/>ዓይጎ ባኣዚያ ማዖም ዒዛ ማሊፆጉዲ ኑ ሺኢቄቴ ኑም ዒ ዋይዛንዳሢ ኑ ጉሙርቃኔ፤ ፆኦሲ ቤርታ ኑኡኮ ዓኣ ጫርሹማ ዬያኬ። <verse eid="1JN 5:14"/><verse number="15" style="v" sid="1JN 5:15"/>ኑ ሺኢቃ ባኮ ቢያ ዒ ዋይዛሢ ኑ ዔሬቴ ዒዛይዳፓ ኑ ሺኢቃ ባኮ ቢያ ዔኬሢ ኑ ዔራኔ።<verse eid="1JN 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16"/>ዖኦኒያ ፔኤኮ ዒሻሢያ ማዖም ሚሼሎ ዎዹዋ ጎሜ ማዻንቴ ዴንቄቴ ዒዛም ሺኢቆንጎ፤ ዬያ ዓሢና ዓሴሎና ጎማ ዎዹዋያ ማዔቴ ፆኦሲ ዒዛም ናንጊ ዒንጋንዳኔ። ጋዓንቴ ዎዻ ጎሜ ዓኣኔ፤ ዬያጉዴ ጎሞም ሺኢቆንጎ ታ ጎዑዋሴ። <verse eid="1JN 5:16"/><verse number="17" style="v" sid="1JN 5:17"/>ፑርታ ማዾ ቢያ ጎሜኬ፤ ማዔቴያ ዎዹዋ ጎሜ ዓኣኔ።<verse eid="1JN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18"/>ፆኦሲ ናይ ማዔሢ ቢያ ጎሜ ማዺ ማዺ ናንጉዋኣሢ ኑ ዔራኔ፤ ዎይቲ ጌዔቴ ፆኦሲኮ ናዓሢ፥ ዬሱስ ኪሪስቶሴ ዒዛ ካፓሢሮኬ፤ ፃላሄያ ዒዛ ካኣሙዋሴ።<verse eid="1JN 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19"/>ኑኡኒ ፆኦሲ ዓሲ ማዔሢ፤ ሃሣ ዓጫ ጉቤ ፃላሄ ዓሲ ማዔሢ ኑ ዔራኔ።<verse eid="1JN 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20"/>ፆኦሲ ናዓሢ ሙኬሢና ጎኔ ማዔሢ፥ ዒዛ ኑ ዔራንዳጉዲ ማሊ ጶቂሣ ዒና ኑም ዒንጌሢያ ኑ ዔራኔ፤ ኑኡኒ ዬያ ጎኔ ማዔ፥ ዬሱስ ኪሪስቶሴና ናንጋኔ፤ ዒዚ ጎኔ ፆኦሲ ሃሣ ናንጊና ናንጊ ዒንጋያኬ።<verse eid="1JN 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21"/>ታ ናይዮቴ! ሜሌ ፆኦዞ ካኣሽኪሢዳፓ ዒንሢና ካፑዋቴ።<verse eid="1JN 5:21"/></para>
  <chapter eid="1JN 5"/>
</usx>
