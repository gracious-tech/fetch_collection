<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ZEC" style="id">- MAALE Full Bible</book>
  <para style="h">ዛካሪያሴ ማፃኣፖ</para>
  <para style="toc1">ፆኦሲ ማሊፆ ኬኤዛ ዛካሪያሴ ማፃኣፖ</para>
  <para style="toc3">ዛካ.</para>
  <para style="toc2">ዛካሪያሴ ማፃኣፖ</para>
  <para style="mt1">ዛካሪያሴ</para>
  <para style="imt">ዓይፆ ካሮ</para>
  <para style="ip">ፆኦሲ ማሊፆ ኬኤዛ ዛካሪያሴ ማፃኣፓ ላምዖ ቤሲ ፓቂንታ ማሊሢ ዓኣያኬ፤</para>
  <para style="ip">ፔታሳዛ ዓይሢ 1—8 ሄላንዳኣና ዓኣ ማሊፆኬ፤ ዬና ኪሪስቶሴ ሾይንታንዳሢኮ ቤርታ ዶንጎ ፄኤታና ላማታሚ ሌዔፓ ዴንዲ ዶንጎ ፄኤታና ታጶ ሳሊ ሌዔ ማዓ ጋሮይዳ ዱማ ዱማ ዎዴና ፆኦሲ ማሊፆ ኬኤዛ ዛካሪያሴ ኬኤዜ ባኣዚ ዓርቄያኬ፤ ዬያታ ፆኦሲ ማሊሢ ማዔም ኬኤዚንቴ ቃኣላ ፆኦሲ ፔጋሲ ዻዌ ጎይሢና ኬኤዚንቴያ ማዓዛ፥ ዬይ ኬኤዚንቴ ባካ ዬሩሳላሜኮ ጊንሣ ላሚ ዓካዺፆ፥ ጌኤዦ ማኣሮኮ ጊንሣ ማዢንቲፆ፥ ፆኦሲ ዴሮኮ ጎማፓ ጌኤሽኪፆንታ ሃጊ ሙካንዳ ሜሲሄ ዎዶ ዛሎዋ ኬኤዛያኬ።</para>
  <para style="ip">ላምዓሳዖ ዓይሢ 9—14 ሄላንዳኣና ዓኣ ቤዞይዳ ኬኤዚንቴ ባካ ዻካ ናጌዖ ኬኤዚንቴ ፆኦሲ ማሊሢ ዓርቄያኬ፤ ዬያታ ፆኦሲ ማሊሢ ማዒ ኬኤዚንቴ ቃኣላ ኬኤዛሢ ሃጊ ሙካንዳ ሜሲሄ ዛሎንታ ጋፒንፆና ዎጊንታንዳ ዎጎ ዛሎንታኬ።</para>
  <para style="iot">ማፃኣፔላ ዱማ ዱማ ዓርቄ ባኮ</para>
  <para style="io1">ሜታ ዓኣያ ማዒፃ ላቲ ኬኤዚንቴሢና ሃጊ ሴካ ዎዛ ዓኣያ ማዒፆ (1፡1—8፡23)</para>
  <para style="io1">ዒስራዔኤሌኮ ዓሺኖ ማዔ ዓጮይዳ ዎጊንታንዳ ዎጌ (9፡1-8)</para>
  <para style="io1">ሃጊ ሴካ ዓኣ ዖርጎቹሞንታ ዎዛንታ ዛላ (9፡9—14፡21)</para>
  <chapter number="1" style="c" sid="ZEC 1"/>
  <para style="s1">ናንጊና ናንጋ ጎዳ ፔ ዴራ ዒዛ ባንሢ ማዓንዳጉዲ ዔኤሌሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 1:1"/>ዳኣሪዮሴ ፓሪሴይዳ ካኣታዼንቴ ላምዓሳ ሌዖኮ ሳላሳ ዓጊኖና ዒዶኮ ናኣዚ፥ ባራኪዮ ናዖ ማዔ፥ ፆኦሲ ማሊፆ ኬኤዛ፥ ዛካሪያሴም ናንጊና ናንጋ ጎዳ ኬኤዜ ቃኣላ ያዺኬ፤ <note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="EZR 4:24-5:1">ዒዝ. 4፡24—5፡1</ref>፤ <ref loc="EZR 6:14">6፡14</ref>።</char></note> <verse eid="ZEC 1:1"/><verse number="2" style="v" sid="ZEC 1:2"/>ዛካሪያሴ ዴሮም ሂዚ ጌይ ኬኤዛንዳጉዲ ቢያ ባኮ ዎይሣ ጎዳ ማዔ ፆኦዛሢ ዓይሤኔ፦ «ታኣኒ፥ ናንጊና ናንጋ ጎዳ ዒንሢኮ ቤርታኣ ዓዶንሢ ዑፃ ሚርጌና ዻጋዼኔ፤ <verse eid="ZEC 1:2"/><verse number="3" style="v" sid="ZEC 1:3"/>ሃሢ ጋዓንቴ ታኣኒ ዒንሢም ሂዚ ጋዓኔ፦ ‹ታ ባንሢ ማዑዋቴ፤› ታኣኒያ ዒንሢ ባንሢ ማዓንዳኔ።<verse eid="ZEC 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 1:4"/>«ዒንሢኮ ቤርታኣ ዓዶንሢጉዲ ማዒፖቴ፤ ዔያቶም ሚና ታ ማሊፆ ኬኤዛ ዓሳ፦ ‹ዒንሢ ሃንታ ዎቦ ጎይፆና ፑርቶ ማዾናፓ ማዑዋቴ› ጌይ ላቲ ኬኤዚናኣኮኬ፤ ዒንሢኮ ቤርታኣ ዓዶንሢ ጋዓንቴ ዬያ ዋይዚባኣሴ፤ ታኣኮ ዓይሢፆዋ ካፒ ማዺ ኩንሢባኣሴ። <verse eid="ZEC 1:4"/><verse number="5" style="v" sid="ZEC 1:5"/>ሃሢ ዬያታ ዒንሢኮ ቤርታኣ ዓዶንሢ ዎካ ዓኣይ? ታ ማሊፆ ኬኤዛ ዓሶ ማዔቴያ ናንጊና ናንጋያዳ? <verse eid="ZEC 1:5"/><verse number="6" style="v" sid="ZEC 1:6"/>ጋዓንቴ ታ ዓይሎ ማዔ፥ ታ ማሊፆ ኬኤዛ ዓሶ ዛሎና ዒንሢኮ ቤርታኣ ዓዶንሢም ታ ዒንጌ ዎጎንታ ዓይሢፆንታ ካፖ ዒፂፆና ዔያቶ ሜታ ሄሊባይ? ዬያሮ ዔያታ ፔ ዻቢንቶ ዔሪ፦ ‹ቢያ ባኮ ዎይሣ ጎዳ ማዔ ፆኦዛሢ ማሌ ጎይፆጉዴያ ኑ ማዼ ማዾ ጎይፆና ኑ ሃንቴ ጎይፆናጉዴያ ኑጊዳ ዒዚ ዓጌ ሜታሢ ፒዜ ካራናኬ› ጌዔኔ።»<verse eid="ZEC 1:6"/></para>
  <para style="s1">ፆኦሲ ማሊፆ ኬኤዛ ዛካሪያሴም ፔጋዺ ጴዼ ፓራሢ</para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 1:7"/>ዳኣሪዮሴ ካኣታዼንቴ ላምዓሳ ሌዖና፥ ሼባፄ ጌይንታ ታጶ ፔታሳ ዓጊና ፄኤሬንቴ ላማታሚ ዖይዳሳ ኬሎና ዒዶ ናኣዚ ባራኪዮ ናይ ማዔ፥ ፆኦሲ ማሊፆ ኬኤዛ ዛካሪያሴም ናንጊና ናንጋ ጎዳ ሂዚ ጌይ ኬኤዜኔ። <verse eid="ZEC 1:7"/><verse number="8" style="v" sid="ZEC 1:8"/>ፆኦሲኮ ኪኢታንቻሢ ዞቄ ፓሮይዳ ዴይ ዓኣንቴ ታኣኒ ፔቴ ዋንቴና ዴንቄኔ። ዒዚ ዶኦጮይዳ ዓኣ ባርሴኔቴ ጌይንታ ሚፆ ባኣካ ዔቄኔ፤ ዒዛኮ ጊንፆይዳ ዞቄ፥ ዲንኪ ዞቄ፥ ሃሣ ጋላፒ ፓራ ዔቂ ዓኣኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡8 </char><char style="xt" closed="false"><ref loc="REV 6:2-8">ዮሃ. ፆፔዻ 6፡2-8</ref>።</char></note> <verse eid="ZEC 1:8"/><verse number="9" style="v" sid="ZEC 1:9"/>ታኣኒ ዒማና፦ «ታ ጎዳሢዮ! ሃይ ፓራሢ ዓይጎ ማላቲ ዻዋያዳዖ?» ጌይ ፆኦሲ ኪኢታንቻሢ ኮይላ ዖኦጬኔ።</para>
  <para style="p" vid="ZEC 1:9">ዒዚ ማሃዖ፦ «ሃይ ፓራሢ ዓይጎ ማላታ ዻዋቴያ ታኣኒ ኔና ቤኤዛንዳኔ፤ <verse eid="ZEC 1:9"/><verse number="10" style="v" sid="ZEC 1:10"/>ዔያታ ሳዖ ሃንቲ ሙሪ ሙካንዳጉዲ ናንጊና ናንጋ ጎዳ ዳኬያኬ» ጌዔኔ። <verse eid="ZEC 1:10"/><verse number="11" style="v" sid="ZEC 1:11"/>ዔያታ ዒማና፦ «ሳዖ ኑ ቢያ ሃንቲ ሙሪ ዛጌኔ፤ ሳዓ ቢያ ሜታ ባኣያ ኮሺኬ» ጌይ ፆኦሲ ኪኢታንቻሢም ኬኤዜኔ።<verse eid="ZEC 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 1:12"/>ኪኢታንቻሢ፦ «ቢያ ባኮ ዎይሣ ጎዳሢዮ! ዬሩሳላሜንታ ዪሁዳ ካታሞ ቢያሢ ዑፆይዳ ኔ ዻጋዼንቴ ሃይሾ ላንካይታሚ ሌዔ ዓኣዼኔ፤ ኔኤኒ ዔያቶ ማኣሩዋኣሢ ዎማ ሄላንዳኣናዳዖ?» ጌይ ዖኦጬኔ።<verse eid="ZEC 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEC 1:13"/>ዬካፓ ናንጊና ናንጋ ጎዳ ታኣና ዎላ ጌስታ ኪኢታንቻሢም ኮሺ ዎዛሳ ዑኡሲና ዶዲሻ ጌኤሲያ ጌስቲ ማሄኔ። <verse eid="ZEC 1:13"/><verse number="14" style="v" sid="ZEC 1:14"/>ዬያሮ ኪኢታንቻሢ ታኣም ቢያ ባኮ ዎይሣ ጎዳ ማዔ ፆኦዛሢ ጋዓ ባኮ ሂዚ ጌይ ዼጊዲ ኬኤዜ ጌዔኔ፦ «ፂዮኔንታ ዬሩሳላሜንታ ታኣሮ ሌሊ ማዓንዳጉዲ ኮዓ ማሊሢና ዼኤፒ ናሹሞዋ ታኣኮ ዓኣኔ፤ <verse eid="ZEC 1:14"/><verse number="15" style="v" sid="ZEC 1:15"/>ኮሹሞ ዓኣያ ማዔም ሂርጋ ባኣያ ናንጋ ሜሌ ዴሮ ካኣቶ ዑፃ ሚርጌና ታኣኒ ዻጋዼኔ፤ ዓይጎሮ ጌዔቴ ታኣኒ ታ ዴሮይዳ ሜቶ ዓጊፆ ዻካሮ ሃሼ ዎዶና ዬያታ ካኣታ ታኣኮ ዴሮ ኮይሳሢፓ ዑሣ ፑርታ ጎይሢ ሜታሴኔ። <verse eid="ZEC 1:15"/><verse number="16" style="v" sid="ZEC 1:16"/>ዬያሮ ካታሜሎ፥ ዬሩሳላሜ ማኣራኒ ጊንሣ ታ ሺሪ ዒዞ ዛጋንዳኔ፤ ታኣኮ ጌኤዦ ማኣሮንታ ካታሜሎንታ ጊንሣ ዓካዺ ማዢንታንዳኔ።»<verse eid="ZEC 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ZEC 1:17"/>ፆኦሲ ኪኢታንቻሢ ጊንሣ ሃሣ፦ «ቢያ ባኮ ዎይሣ ጎዳ ካታማ ጊንሣ ዖርጎጫንዳጉዲ ማሃንዳሢ፥ ዬሩሳላሜ ካታሞዋ ሚናኣሲጉዲ ዒዚ ማኣዳንዳሢንታ ፔ ካታማ ማሂ ዒዚ ዶኦራንዳያ ማዔሢ ኬኤዜ» ጌዔኔ።<verse eid="ZEC 1:17"/></para>
  <para style="s1">ፆኦሲ ማሊፆ ኬኤዛ ዛካሪያሴም ፔጋዺ ጴዼ ዖይዶ ጉራኒ</para>
  <para style="p">
    <verse number="18" style="v" sid="ZEC 1:18"/>ሃሣ ፆኦሲ ታና ዖይዶ ጉራኒ ፔጋሲ ዻዌኔ፤ <verse eid="ZEC 1:18"/><verse number="19" style="v" sid="ZEC 1:19"/>ታኣና ዎላ ጌስታ ኪኢታንቻሢ ኮይላ ታኣኒ፦ «ሃንሢ ጉራኖንሢ ዓይጎ ማላታ ማዒ ዻዋቴያ ታኣም ኬኤዜ» ጌዔኔ።</para>
  <para style="p" vid="ZEC 1:19">ዒዚ፦ «ሃኣታ ጉራና ዪሁዳንታ ዒስራዔኤሌንታ ዬሩሳላሜንታ ዴሮ ዳውሲ ባይዜ ካኣቶኬ» ጌዔኔ።<verse eid="ZEC 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ZEC 1:20"/>ዬካፓ ናንጊና ናንጋ ጎዳ ሞቶሻ ኩጫ ዔኪ ዓኣ ዖይዶ ጊቶ ታና ዻዌኔ፤ <verse eid="ZEC 1:20"/><verse number="21" style="v" sid="ZEC 1:21"/>ታኣኒ ዒማና፦ «ሃንሢ ዓሳ ዓይጎ ማዻኒ ሙኬ ዓሲዳይ?» ጌይ ፆኦሲ ኪኢታንቻሢ ኮራ ዖኦጬኔ፤ ዒዚ ማሃዖ፦ «ዔያታ ሙኬሢ ዪሁዳ ሳዖ ጋፒሲ ባይዚ፥ ዴሮዋ ዳውሲ ፒፒንፂዴ ሜሌ ዴሮ ካኣቶኮ ካራ ባይዚ ዎዺ ኩርሳኒኬ» ጌዔኔ።<verse eid="ZEC 1:21"/></para>
  <chapter eid="ZEC 1"/>
  <chapter number="2" style="c" sid="ZEC 2"/>
  <para style="s1">ዛካሪያሴም ፆኦሲ ፔጋሲ ዻዌ ዋርቆ ዎዳሮ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 2:1"/>ፔ ኩጫ ዋርቆ ዎዳራ ዔኪ ዓኣ ፔቴ ዓሲ ፆኦሲ ፔጋሲ ታና ዻዌኔ፤ <verse eid="ZEC 2:1"/><verse number="2" style="v" sid="ZEC 2:2"/>ታኣኒ፦ «ኔኤኒ ዎኒ ዴንዳይ?» ጌይ ዬያ ዓሢ ዖኦጬኔ፤ ዒዚ፦ «ዬሩሳላሜ ካታሞኮ ዖዶሱሞንታ ዳልጉሞንታ ዋኣዺታቴያ ታኣኒ ዋርቂ ዔራኒ ዴንዳኔ» ጌዔኔ።<verse eid="ZEC 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 2:3"/>ዬካፓ ታኣና ጌስታ ኪኢታንቻሢ ቤርቲም ሴካ ዴንዳንቴ ሜሌ ፆኦሲ ኪኢታንቾ ዒዛና ካኣማኒ ሙካያ ታ ዴንቄኔ። <verse eid="ZEC 2:3"/><verse number="4" style="v" sid="ZEC 2:4"/>ቤርታኣ ኪኢታንቻሢ ላምዓሲ ጴዼ ኪኢታንቻሢም፦ «ዋርቂ ዔሮ ዎዳሮ ዔኪ ዓኣ፥ ሃሴኬ ዼጌሢ ኮይላ ጳሽኪ ዴንዲ ‹ዬሩሳላሜይዳ ሚርጌ ዴሬንታ ቆልሞንታ ዓኣሢሮ ዼኤፒ ኬኤሌ ዲሢ ማዣኒ ሜቶኬ› ጌይ ኬኤዜ። <verse eid="ZEC 2:4"/><verse number="5" style="v" sid="ZEC 2:5"/>ናንጊና ናንጋ ጎዳ ፔኤሮ ካታሜሎኮ ዙሎይዳ ታሚ ዲሢ ማዒ ካፓንዳሢና ፔኤኮ ቦንቾናኣ ዒኢካ ፔጋዺ ናንጋንዳሢ ኬኤዜኔ» ጌዔኔ።<verse eid="ZEC 2:5"/></para>
  <para style="s1">ሜሌ ዓጮ ዴንዲ ዓኣ ዓሳ ፔ ዓጮ ማዓንዳጉዲ ኬኤዚንቴሢ</para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 2:6"/>ናንጊና ናንጋ ጎዳ፦ «ዓጮኮ ዖይዶ ዛሎ ቢያ ታ ዒንሢ ሃያኮ ቤርታ ዜርቂ ዳኬኔ፤ ሃሢ ጋዓንቴ ዓጮኮ ኬዶ ዛላፓ ዔቂ ቶላኒ ጳሽኩዋቴ። <verse eid="ZEC 2:6"/><verse number="7" style="v" sid="ZEC 2:7"/>ዒንሢ፥ ዳውሲንቲ ዴንዲ ባብሎኔይዳ ናንጋ ዓሳ ዬሩሳላሜ ማዒ ሙኩዋቴ» ጋዓኔ። <verse eid="ZEC 2:7"/><verse number="8" style="v" sid="ZEC 2:8"/>ዒንሢ ካኣማ ዓሲ ዒዛ ዓኣፖኮ ካርፆማ ሄላ ዓሲ ማዒ ዛጊንታንዳኔ። ዒዚ ታና ቦንቺሲ፥ ዒንሢ ቡሬ ዴሮዋ ማኪ ታ ጌስታንዳጉዲ ዳካኣና ታኣም ኬኤዜ ቃኣላ ያዺ ጋዓያኬ።<verse eid="ZEC 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 2:9"/>«ሃሢ ታኣኒ ታኣኮ ዎልቆ ዔያቶ ዻዋንዳኔ፤ ዔያታ ሃያኮ ቤርታ ዓይሌ ማሂ ሻንቂ ዔኪ ዎይሤ ዓሶ ኩጮ ጋሮ ዲዒንቲ ጌላንዳኔ፤ ዬካፓ ዒንሢያኣ ቢያ ባኮ ዎይሣ ጎዳ ታና ዳኬያ ማዔሢ ዔራንዳኔ።»<verse eid="ZEC 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 2:10"/>«ታኣኒ ሙኪ ዒንሢ ባኣካ ናንጋንዳሢሮ ዬሩሳላሜ ዴሬዮቴ! ታና ቦንቺ ዓይናዹዋቴ! ዎዛዺያ ዒላሹዋቴ!» ጋዓኔ ናንጊና ናንጋ ጎዳ።<verse eid="ZEC 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 2:11"/>ዬይ ያዺ ማዔ ዎዶና ሜሌ ዴሮፓ ሚርጌ ፃጲ ናንጊና ናንጋ ጎዳና ዎላ ማዒ ዒጊንታንዳኔ። ዒዚ ዔያቶ ባኣካ ናንጋንዳኔ፤ ታናኣ ዒንሢ ባንሢ ዳኬሢ ዒዛ ማዔሢ ዒንሢ ዔራንዳኔ። <verse eid="ZEC 2:11"/><verse number="12" style="v" sid="ZEC 2:12"/>ፆኦሲም ዱማዼ ሳዔሎይዳ ዓኣ፥ ዪሁዳ ፔ ዴኔ ማሂ ፆኦሲ ዔካንዳኔ፤ ዬሩሳላሜያ ጊንሣ ላሚ ፔኤሮ ማሂ ዒዚ ዶኦራንዳኔ።<verse eid="ZEC 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEC 2:13"/>ናንጊና ናንጋ ጎዳ ዒዛኮ ናንጎ፥ ጌኤዦ ማኣሮይዳፓ ሙካኒ ጊኢጊ ዔቄሢሮ ዓሲ ቢያ ዒዛ ቤርታ ዚቲ ጎዖንጎ።<verse eid="ZEC 2:13"/></para>
  <chapter eid="ZEC 2"/>
  <chapter number="3" style="c" sid="ZEC 3"/>
  <para style="s1">ቄኤሶ ሱኡጋሢ ዛሎ ፆኦሲ ዛካሪያሴም ፔጋሲ ዻዌ ባኮ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 3:1"/>ዬካፓ ቄኤሶ ሱጋሢ፥ ዒያሱ ፆኦሲ ኪኢታንቻሢኮ ቤርታ ዔቂ ዓኣያ ናንጊና ናንጋ ጎዳ ታኣም ፔጋሲ ዻዌኔ፤ ዒማና ፃላሄ ዒያሱ ካሳሳኒ ዒዛኮ ሚዛቆ ዛላ ዔቂ ዓኣኔ። <note caller="-" style="x"><char style="xo" closed="false">3፡1 </char><char style="xt" closed="false"><ref loc="EZR 5:2">ዒዝ. 5፡2</ref>፤ <ref loc="REV 12:10">ዮሃ. ፆፔዻ 12፡10</ref>።</char></note> <verse eid="ZEC 3:1"/><verse number="2" style="v" sid="ZEC 3:2"/>ፆኦሲኮ ኪኢታንቻሢ ፃላሄ ኮይላ፦ «ሃይ ኔ ፃላሄ! ናንጊና ናንጋ ጎዳ ኔና ጎሮም! ዬሩሳላሜ ፔኤሮ ማሂ ዶኦሬ፥ ናንጊና ናንጋ ጎዳሢ ኔና ጎሮም! ሃይ ዓሢ ታሚ ጋውሌንቴ ባሺ ዓቲ ዓኣ ሚሢታሢ ኔ ዛጉዋይ» ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">3፡2 </char><char style="xt" closed="false"><ref loc="JUD 1:9">ዪሁ. 9</ref>።</char></note><verse eid="ZEC 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 3:3"/>ዒያሱ ኪንቄ ዓፒላ ማኣዒ ፆኦሲ ኪኢታንቻሢ ቤርታ ዔቂ ዓኣኔ። <verse eid="ZEC 3:3"/><verse number="4" style="v" sid="ZEC 3:4"/>ፆኦሲኮ ኪኢታንቻሢ ዒዛም ዓይሢንቲ ማዻ ሃንጎ ኪኢታንቾ፦ «ዬያ ኪንቄ ማኣዓሢ ዒዛ ዑፃፓ ሺኢሹዋቴ!» ጌይ ዓይሤኔ፤ ዒማና ሃሣ ዒዚ ዒያሱ ባንሢ ሺራዖ፦ «ጎሞ ታ ኔኤኮ ኔጊዳፓ ሺኢሼኔ፤ ቃራ ኮሺ ማኣዖ ታ ኔና ማይሳንዳኔ» ጌዔኔ።<verse eid="ZEC 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 3:5"/>ዛካሪያሴ ዒማና፦ «ቶኦካኣ ዒዛኮ ጌኤሺ ዓፒላ ማሩዋቴራ» ጌዔኔ፤ ዔያታኣ ዓይሢንቴ ጎይፆማ ማዼኔ፤ ዒያሱ ዒማካ ዔቂ ዓኣ ጎይሣ ዓኣንቴ ፆኦሲኮ ኪኢታንቻ ዓኪ ማኣዖ ዒዛ ማይሴኔ።<verse eid="ZEC 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 3:6"/>ዒማና ፆኦሲ ኪኢታንቻሢ ዒያሱም፦ <verse eid="ZEC 3:6"/><verse number="7" style="v" sid="ZEC 3:7"/>«ቢያ ባኮ ዎይሣ ጎዳሢ ሂዚ ጋዓኔ፤ ኔ ሃንታ ሃንቲፃ ታ ጋዓ ጎይፆጉዲ ማዔቴ፥ ታ ኔና ዓይሤ ባኮ ቢያ ኔ ማዺ ኩንሤቴ፥ ታኣኮ ጌኤዦ ማኣሮ ኔ ቢታንቶና ኔ ዎይሣንዳጉዲ፤ ታኣኮ ዴራ ቡካ ጶኦኮይዳኣ ዼኤፑሞ ቢታንቶ ታ ኔኤም ዒንጋንዳኔ፤ ሃይካ ሃሢ ዔቂ ዓኣ ፆኦሲ ኪኢታንቾና ዎላ ኔ ማዻያ ታ ኔና ማሃንዳኔ። <verse eid="ZEC 3:7"/><verse number="8" style="v" sid="ZEC 3:8"/>ቄኤሶ ሱኡጋሦ፥ ዒያሱ! ዋይዜ፤ ዒንሢያኣ ዒዛና ዎላ ቄኤሴ ማዒ ማዻያ፥ ጊንሣ ሃሣ ሃጊ ሴካ ማዓንዳ ባኮኮ ማላታ ማዒ ዓኣ ዓሳ ሃያ ታ ጋዓሢ ዋይዙዋቴ፤ ‹ሚሢ ካኣፒ› ጌይንታ ታ ዓይላሢ ሃጊ ታኣኒ ዳካንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">3፡8 </char><char style="xt" closed="false"><ref loc="JER 23:5">ዔር. 23፡5</ref>፤ <ref loc="JER 33:15">33፡15</ref>፤ <ref loc="ZEC 6:12">ዛካ. 6፡12</ref>።</char></note> <verse eid="ZEC 3:8"/><verse number="9" style="v" sid="ZEC 3:9"/>ሃኣዛጉዋቴ፥ ታኣኒ ላንካይ ዓኣፒ ዓኣ ፔቴ ሹቺ ዒያሱ ቤርታ ጌሣንዳኔ፤ ዬይ ዎዚ ጌይሢታቴያ ዒኢካ ታኣኒ ቆኦቂ ፃኣፓንዳኔ፤ ሃኖ ዓጮኮ ጎሞ ፔቴ ኬሊና ታኣኒ ሺኢሺ፥ ጌኤሻንዳኔ። <verse eid="ZEC 3:9"/><verse number="10" style="v" sid="ZEC 3:10"/>ዬኖ ኬሎና ዒንሢ ፔቴ ፔቴሢ ዎይኖና ቤሌሶ ሚፆና ዴማ ዴዒ ዒንሢኮ ዓሺኖ ዔኤሊ ሙይ ዑሽኪ ዑሽኪ ዎዛዻንዳኔ።» ጋዓኔ ቢያ ባኮ ዎይሣ ጎዳሢ። <note caller="-" style="x"><char style="xo" closed="false">3፡10 </char><char style="xt" closed="false"><ref loc="MIC 4:4">ሚኪ. 4፡4</ref>።</char></note><verse eid="ZEC 3:10"/></para>
  <chapter eid="ZEC 3"/>
  <chapter number="4" style="c" sid="ZEC 4"/>
  <para style="s1">ፆኦሲ ዛካሪያሴም ፖዒ ጌሦ ሻርና ፔጋሲ ዻዌሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 4:1"/>ታኣና ዎላ ጌስታ ፆኦሲ ኪኢታንቻሢ ላሚ ጊንሣ ሙኪ ጊንዓፓ ጴቾሢጉዲ ታና ጴቼኔ፤ <verse eid="ZEC 4:1"/><verse number="2" style="v" sid="ZEC 4:2"/>ዒዚ ዒማና፦ «ሃይ ኔኤም ጴዻ ባካ ዓይጌንዴዳይ?» ጌይ ታና ዖኦጬኔ።</para>
  <para style="p" vid="ZEC 4:2">ታኣኒ ዒዛም ማሃዖ፦ «ላንካይ ፖዒ ጊዳ ፖዓያ ፔቴ ዎርቄ ሻርና ታ ዴንቃኔ፤ ዑፆይዳ ጊንሣ ዛይቴ ዖቲ ጌሢንቲ ዓኣኔ፤ ላንካዎ ፖዖ ፖዓ ባኮንሢኮ ቢዖና ሻላ ዳኪንታንዳ ፂኢና ዓኣኔ። <verse eid="ZEC 4:2"/><verse number="3" style="v" sid="ZEC 4:3"/>ዬኖ ሻርኔሎኮ ኮይላ ላምዖ ዛይቴ ሪሚቲ ሚሢ ዖቴሎኮ ሻውሎና ሚዛቆናይዳ ጴዻኔ» ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡3 </char><char style="xt" closed="false"><ref loc="REV 11:4">ዮሃ. ፆፔዻ 11፡4</ref>።</char></note> <verse eid="ZEC 4:3"/><verse number="4" style="v" sid="ZEC 4:4"/>ታኣኒያ ታኣና ዎላ ጌስታ ፆኦሲ ኪኢታንቻሢ ኮይላ፦ «ታ ጎዳ! ሃይ ባካ ዓይጎኮ ኮኦኪንሢ ማዒ ዻዋ ባኣዚዳዖ?» ጌይ ዖኦጬኔ።<verse eid="ZEC 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 4:5"/>ዒዚ፦ «ሃይ ባካ ዓይጎታቴያ ኔኤኒ ዔሩዋዓዳ?» ጌዔኔ። ታኣኒ፦ «ዔይዔ፥ ታ ጎዳሢዮ! ታ ዔሩዋሴ» ጌዔኔ። <verse eid="ZEC 4:5"/><verse number="6" style="v" sid="ZEC 4:6"/>ዜሬባቡሌም ታኣኒ ኬኤዛንዳጉዲ ፆኦሲ ኪኢታንቻሢ ታኣም ኬኤዜ፥ ቢያ ባኮ ዎይሣ ጎዳሢኮ ቃኣላ ሂዚ ጋዓያኬ፦ «ኔኤኒ ባሻንዳሢ ታ ዓያኖናኬ፤ ዎልቄና ሃሣ ዶዱምናቱዋሴ። <note caller="-" style="x"><char style="xo" closed="false">4፡6 </char><char style="xt" closed="false"><ref loc="EZR 5:2">ዒዝ. 5፡2</ref>።</char></note> <verse eid="ZEC 4:6"/><verse number="7" style="v" sid="ZEC 4:7"/>ኔ ቤርቶይዳ ዹካ ማዒ ዔቂ ዓኣ ዹቃሢ ቢያ ሺኢካንዳኔ፤ ጌኤዦ ማኣሮ ጊንሣ ኔኤኒ ማዣንዳኔ፤ ማኣሮ ሹጮና ኔኤኒ ማዣዖ ጋፒንፃ ኔኤኒ ጌሣ ሹጮ ጌሣኣና ዴራ፦ ‹ናይዮቴ፥ ሃይ ዎዚ ሚዛጳዖ! ፆኦሲ ሃያ ዓንጂንቴያ ማሆንጎ!› ጌይ ጌይ ዎዛዺ ዒላታንዳኔ።»<verse eid="ZEC 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 4:8"/>ጊንሣ ሃሣ ናንጊና ናንጋ ጎዳ ታኣም ሂዚ ጌዔኔ፦ <verse eid="ZEC 4:8"/><verse number="9" style="v" sid="ZEC 4:9"/>«ዜሬባቡሌ ናኣታ ሃያ ጌኤዦ ማኣሮ ማዢፆሮ ቤርታሳ ሹጮ ጌሢ ዓርቄኔ፤ ዔያታ ፔ ኩቻ ማዺ ኩኩርሳንዳኔ፤ ያዺ ማዓ ዎዶና ቢያ ባኮ ዎይሣ ጎዳሢ ታና ዒንሢ ባንሢ ዳኬያ ማዒፆ ዒንሢ ዔራንዳኔ። <verse eid="ZEC 4:9"/><verse number="10" style="v" sid="ZEC 4:10"/>ማኣሮኮ ፒዙሞ ሚፂ ዛጎ ዓንጎ ዜሬባቡሌ ኩጫ ዛጋዖ ዻካ ባኣዚ ማዺንቴ ኬሎ ቦሂ ቶኦቼ ዓሢ ዎዛዻንዳኔ፤ ሃንሢ ላንካዎ ፖዖንሢ ናንጊና ናንጋ ጎዳሢኮ ዓኣፖኬ፤ ዬይ ዓኣፓ ዓጮ ቢያ ማዔ ካራና ዛጋያኬ።» <note caller="-" style="x"><char style="xo" closed="false">4፡10 </char><char style="xt" closed="false"><ref loc="REV 5:6">ዮሃ. ፆፔዻ 5፡6</ref>።</char></note><verse eid="ZEC 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 4:11"/>ታኣኒ ዒማና ጊንሣ፦ «ሃንሢ ፖዖ ጌሦ ሻርኖኮ ሻውሎና ሚዛቆናይዳ ዓኣ ዛይቶ ሪሚቶ ሚፆንሢ ዓይጎ ኮኦኪንሢ ዻዋያዳዖ? <note caller="-" style="x"><char style="xo" closed="false">4፡11 </char><char style="xt" closed="false"><ref loc="REV 11:4">ዮሃ. ፆፔዻ 11፡4</ref>።</char></note> <verse eid="ZEC 4:11"/><verse number="12" style="v" sid="ZEC 4:12"/>ሪሚቶ ዛይታ ሾኦታ ላምዖ ዎርቆ ፂኢኖንሢኮ ኮይላ ዓኣ ላምዖ ሪሚቶ ካኣፖንሢሾ፥ ዓይጎ ኮኦኪንሢ ዻዋያዳዖ?» ጌይ ፆኦሲ ኪኢታንቻሢ ዖኦጬኔ።<verse eid="ZEC 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEC 4:13"/>ዒዚ፦ «ሃይ ባካ ዓይጎታቴያ ኔኤኒ ዔሩዋዓዳ?» ጌዔኔ፤ ታኣኒ፦ «ታ ጎዳሢዮ! ታ ዔሩዋኣዋይ» ጌዔኔ።<verse eid="ZEC 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 4:14"/>ዒዚ ታኣም፦ «ሃኣታ ላምዓሢ ካኣቱሞም ፆኦሲ ዔያቶ ዶኦሜያ፥ ሳዖ ቢያይዳ ናንጊና ናንጋ ጎዳ ማዒ ዓኣሢም ዓይሢንቲ ማዻ ዓሲኬ» ጌዔኔ።<verse eid="ZEC 4:14"/></para>
  <chapter eid="ZEC 4"/>
  <chapter number="5" style="c" sid="ZEC 5"/>
  <para style="s1">ዛካሪያሴም ፆኦሲ ፔጋሲ ዻዌ ማሪንቴ ቢራኖ ማፃኣፖ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 5:1"/>ላሚ ታ ሃሣ ዛጋንቴ ፔቴ ማሪንቴ ማፃኣፔ ዢባሬይዳ ዓኣዻያ ታኣኒ ዴንቄኔ፤ <verse eid="ZEC 5:1"/><verse number="2" style="v" sid="ZEC 5:2"/>ፆኦሲ ኪኢታንቻሢ ታ ኮይላ፦ «ኔኤም ዓይጌ ጴዻይ?» ጌይ ዖኦጬኔ፤ ታኣኒ ዒዛም፦ «ዖዶሱማ ላማታሚ ዋዻ፥ ዳልጉማ ታጶ ዋዻ ማዔ ፔቴ ማሪንቴ ቢራና ማፃኣፔ ዢባሬይዳ ዓኣዻያ ታኣም ጴዻኔ» ጌዔኔ።<verse eid="ZEC 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 5:3"/>ዒዚ ዒማና ታኣም፦ «ዬኖ ማሪንቴ ማፃኣፔሎይዳ ሳዖ ቢያ ሄላንዳ ጋዳማ ፃኣፒንቲ ዓኣኔ፤ ዬኖ ማሪንቴ ማፃኣፔሎኮ ፔቴ ዛሎይዳ፦ ‹ዉሲ ቢያ ዓጪፓ ባይቃንዳኔ› ጋዓያኬ፥ ባጎ ዛሎይዳ ሃሣ፦ ‹ሉኡቂ ጫኣቁሞ ጫኣቃ ዓሲ ቢያ ባይቃንዳኔ› ጋዓኔ። <verse eid="ZEC 5:3"/><verse number="4" style="v" sid="ZEC 5:4"/>ቢያ ባኮ ዎይሣ ጎዳ፦ ‹ሃያ ጋዳሞ ታኣኒ ዳካንዳኔ፤ ዬይ ጋዳማ ፔቴ ፔቴ ዉዞንታ ሉኡዙሞና ጫኣቃ ዓሶንታ ማኣሪ ጌላንዳኔ፤ ዬይ ዒኢካ ጌሊ ዴዒ ዔያቶኮ ማኣሮ ሙይ ሻሂ ባይዛንዳኔ› ጋዓኔ» ጌይ ኬኤዜኔ።<verse eid="ZEC 5:4"/></para>
  <para style="s1">ፆኦሲ ዛካሪያሴም ኮታ ጋርካ ዓኣ ላኣሊ ፔጋሲ ዻዌያ</para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 5:5"/>ፆኦሲ ኪኢታንቻሢ ላሚ ታ ኮይላ ሙኪ፦ «ዓካሪ፥ ሙካንዳ ባካ ዓይጎታቴያ ኮሺ ዛጌ!» ጌዔኔ።<verse eid="ZEC 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 5:6"/>ታኣኒ፦ «ሃይ ዓይጎ ባኣዚዳይ?» ጌዔኔ። ዒዚ፦ «ሳዖ ቢያይዳ ማዺንታ ጎሞ ኮኦኪንሢ ዻዋ ኮታኬ» ጌዔኔ።<verse eid="ZEC 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 5:7"/>ኮቴሎኮ ካሮ ጉኡፓ ዒርሳሴ ጌይንታ ዓንጎና ኮሾናያኬ፤ ታ ዛጋ ጎይሣ ዓኣንቴ ዬይ ካራ ቡሊንቴኔ፤ ዬኖ ኮቴሎ ጋራ ፔቴ ላኣሊስኬና ዴይ ዓኣኔ።<verse eid="ZEC 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 5:8"/>ፆኦሲ ኪኢታንቻሢ፦ «ሃና ላኣሌላ ዒኢቴ ማዾኮ ኮኦኪንሢ ማዓያኬ» ጋዓዖ፥ ሊካ ዺምዒ ኮቶ ጋሮ ዒዞ ጌልዜኔ፤ ዬካፓ ጊንሣ ካሮ ዒዞ ዑፃ ዎዼኔ። <verse eid="ZEC 5:8"/><verse number="9" style="v" sid="ZEC 5:9"/>ሌካ ዼግ ጌይ ታ ዛጋንቴ ላምዖ ላኣሊ ዢባሬይዳ ባራኒ ታ ባንሢ ሙካያ ታ ዴንቄኔ፤ ዔያቶኮ ጋኣዛ ኮኦኬ ጋኣሲጉዲ ዶዲኬ። ዔያታ ዬኖ ኮቴሎ ሳዓፓ ዔኪ ሌካ ጫሪንጮ ባራኒ ዴንዴኔ።<verse eid="ZEC 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 5:10"/>ታኣኒ ዒማና ታኣና ጌስታ ፆኦሲ ኪኢታንቻሢ ኮይላ፦ «ዔያታ ኮቶ ዎኒ ዔኪ ዴንዳዖ?» ጌይ ዖኦጬኔ።<verse eid="ZEC 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 5:11"/>ዒዚ፦ «ሴናዖሬ ዔኪ ዴንዳኔ፤ ዔያታ ዒኢካ ማኣሪ ማዢ፥ ማኣራ ማዢንቲ ጋፔስካፓ ኮቴሎ ዒኢካ ጌሣንዳኔ» ጌይ ታኣም ኬኤዜኔ።<verse eid="ZEC 5:11"/></para>
  <chapter eid="ZEC 5"/>
  <chapter number="6" style="c" sid="ZEC 6"/>
  <para style="s1">ፆኦሲ ዛካሪያሴም ፔጋሲ ዻዌ ዖይዶ ሳርጌላ ዖይታ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 6:1"/>ሜሌ ሃሣ ዖይዶ ሳርጌላ ዖይታ ላምዖ ሞኦና ዓንጊ ዹካ ባኣካፓ ኬስካያ ታና ፆኦሲ ፔጋሲ ዻዌኔ። <verse eid="ZEC 6:1"/><verse number="2" style="v" sid="ZEC 6:2"/>ቤርታሳ ሳርጌሎ ዖይቴሎ ጎቻሢ ዞቄ ፓሮ ማዓዛ፥ ላምዓሳዞ ካርሢ ፓራ ጎቻኔ፤ <note caller="-" style="x"><char style="xo" closed="false">6፡2 </char><char style="xt" closed="false"><ref loc="REV 6:4-5">ዮሃ. ፆፔዻ 6፡4-5</ref>።</char></note> <verse eid="ZEC 6:2"/><verse number="3" style="v" sid="ZEC 6:3"/>ሃይሣሳዞ ጎቻሢ ቦኦሬ ፓሮኬ፤ ዖይዳሳዞ ዖዳላ ፓራ ጎቻኔ፤ ቢያ ፓራሢ ዎልቄና ዓኣያ ዶዲኬ። <note caller="-" style="x"><char style="xo" closed="false">6፡3 </char><char style="xt" closed="false"><ref loc="REV 6:2">ዮሃ. ፆፔዻ 6፡2</ref>።</char></note> <verse eid="ZEC 6:3"/><verse number="4" style="v" sid="ZEC 6:4"/>ታኣኒ ዒማና ታኣና ዎላ ጌስታ ፆኦሲ ኪኢታንቻሢ ኮይላ፦ «ታ ጎዳ! ሃይ ሳርጌሎ ዖይታ ዓይጎ ኮኦኪንሢ ዻዋያዳዖ?» ጌይ ዖኦጬኔ።<verse eid="ZEC 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 6:5"/>ዒዚ ታኣም፦ «ሃኣታ ዖይዶ ዢባሮኬ፤ ሳዖ ቢያኮ ናንጊና ናንጋ ጎዳሢ ቤርታ ዔቂ ዓይሢንቲ ማዻ ማዾፓ ሃሢ ዔያታ ሃጊ ኬስኮ ኬስካኔ» ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">6፡5 </char><char style="xt" closed="false"><ref loc="REV 7:1">ዮሃ. ፆፔዻ 7፡1</ref>።</char></note><verse eid="ZEC 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 6:6"/>ካርፆ ፓራሢ ጎቻ ሳርጌሎ ዖይታ ዓጮኮ ኬዴኖ ባንሢ፥ ቦኦሬ ፓራሢ ጎቻ ሳርጌሎ ዖይታ ዓባ ጌላ ባንሢ፥ ዖዳሎ ፓራሢ ጎቻ ሳርጌሎ ዖይታ ዾኦሎ ዛሎ ዓጮ ባንሢ ዴንዳኔ። <verse eid="ZEC 6:6"/><verse number="7" style="v" sid="ZEC 6:7"/>ዎልቆና ዓኣ ዬይ ፓራሢ ኬስኪ ዴንዳኣና ሳዖ ሙሪ ዛጎሮ ኮሺ ሩኡራኔ፤ ፆኦሲ ኪኢታንቻሢ ዔያቶ፦ «ዴንዱዋቴ፤ ሳዖ ሙሪ ዛጉዋቴ!» ጌይ ዓይሤኔ፤ ዬያሮ ዔያታ ዴንዲ ሳዖ ሙሪ ዛጌኔ። <verse eid="ZEC 6:7"/><verse number="8" style="v" sid="ZEC 6:8"/>ዬካፓ ፆኦሲ ኪኢታንቻሢ፦ «ዓጮኮ ኬዶ ዛሎ ዴንዴ ፓራሢ ናንጊና ናንጋ ጎዳሢኮ ዻጎ ሺሚሼኔ» ጌይ ታኣም ዒላቲ ኬኤዜኔ።<verse eid="ZEC 6:8"/></para>
  <para style="s1">ዒያሱ ቶኦካ ዓጊንቴ ቦንቾ ባኮ</para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 6:9"/>ናንጊና ናንጋ ጎዳ ታኣም ሂዚ ጌዔኔ፦ <verse eid="ZEC 6:9"/><verse number="10" style="v" sid="ZEC 6:10"/>«ሄልዳዬ፥ ፆቢያንታ ዪዳዒያ ጌይንታ ሜሌ ዓጫፓ ዳውሲንቲ ሙኬ ዓሳ ዒንጌ ቢሮ ዓንጎንታ ዎርቆንታ ዔኪ ሃሢ ኔጉዋዖ ሶፖኒያሴ ናኣዚ ዒዮሲያሴ ማኣሪ ዴንዴ፤ ዬይ ዓሳ ቢያ ባብሎኔ ዲዒንቲ ዔውቴዖ ማዔ ዓሶኬ፤ <verse eid="ZEC 6:10"/><verse number="11" style="v" sid="ZEC 6:11"/>ዔያታ ዒንጌ ቢሮ ዓንጎና ዎርቆናፓ ዔኪ ካኣቶ ቶኦካ ዓጎ ቦንቾ ባኮ ጉኡሪ ማሂ ኮሺጋፓ ፔቴማ ቄኤሶ ሱኡጋሢ፥ ዒዮሴዴቄ ናኣዚ ዒያሱ ቶኦካ ዓጌ። <verse eid="ZEC 6:11"/><verse number="12" style="v" sid="ZEC 6:12"/>ቢያ ባኮ ዎይሣ ጎዳሢ ሂዚ ጋዓኔ ጌይ ዒዛም ኬኤዜ፦ ‹ካኣፓ ዓኣ ቤዛ ዓኣዖ ጋምፒንቲ ዴንዳንዳሢሮ ሚሢ ካኣፒ ጌይ ሱንፆ ጌሦና ዓሢ ሃያኬ። ዓኣ ቤዛ ዓኣዖ ባቃሊ ዒ ዼኤፓንዳኔ፤ ፆኦሲኮ ጌኤዦ ማኣሮ ጊንሣ ዒ ማዣንዳኔ፤ <note caller="-" style="x"><char style="xo" closed="false">6፡12 </char><char style="xt" closed="false"><ref loc="JER 23:5">ዔር. 23፡5</ref>፤ <ref loc="JER 33:15">33፡15</ref>፤ <ref loc="ZEC 3:8">ዛካ. 3፡8</ref>።</char></note> <verse eid="ZEC 6:12"/><verse number="13" style="v" sid="ZEC 6:13"/>ጌኤዦ ማኣሮኮ ሱኡጌ ማዒ ዎይሣንዳሢ ዒዛኬ፤ ካኣቱሞ ቦንቾ ዔኪ ካኣቶ ዖይታ ዴዒ ዎይሣንዳኔ፤ ቄኤሴ ማዒያ ማዻይ ዓኣኔ፤ ላምዓሢ ዎላ ዔኤዒ ኮሹሞና ናንጋንዳኔ።› <verse eid="ZEC 6:13"/><verse number="14" style="v" sid="ZEC 6:14"/>ካኣቶ ቶኦካ ዓጎ ቦንቾ ባኮኮ ዓቴዞንሢ ጌኤዦ ማኣሮይዳ ሄሌሜ ጌይንታ ሄልዳዬ፥ ፆቢያ፥ ዪዳዒያንታ ሶፖኒያሴ ናኣዚ ሄኔ ጌይንታ ዒዮሲያሴንታኮ ቦንቾ ጶቂሣያ ማዒ ዒኢካ ጌሢንታንዳኔ።»<verse eid="ZEC 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ZEC 6:15"/>ዬኖ ዎዶና ሃኬ ዓጮይዳ ናንጋ ዓሳ ናንጊና ናንጋ ጎዳኮ ጌኤዦ ማኣሮ ዓካሲ ማዦዋኣና ማኣዳኒ ሙካንዳኔ። ዬይ ጌኤዦ ማኣራ ዓካዺ ማዢንታዛ ቢያ ባኮ ዎይሣ ጎዳሢ ታና ዒንሢ ኮይላ ዳኬሢ ዒንሢ ዔራንዳኔ። ዬይ ቢያ ያዺ ማዒ ኩማንዳሢ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢም ዒንሢ ጉቤ ዒናፓ ዓይሢንታያ ማዔቶኬ።<verse eid="ZEC 6:15"/></para>
  <chapter eid="ZEC 6"/>
  <chapter number="7" style="c" sid="ZEC 7"/>
  <para style="s1">ፒዜ ማዒባኣ ጎይሢና ሙኡዚ ሃሺ ሺኢጲፆ ፆኦሲ ኮዑዋያ ማዒፆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 7:1"/>ዳኣሪዮሴ ፓርሴ ዓጮይዳ ካኣታዼንቴ ዖይዳሳ ሌዖና ኪስሌዎ ጌይንታ ታዞጳሳ ዓጊና ፄኤሬንቴ ዖይዳሳ ኬሎና ናንጊና ናንጋ ጎዳ ዛካሪያሴም ሂዚ ጌይ ኬኤዜኔ፦ <verse eid="ZEC 7:1"/><verse number="2" style="v" sid="ZEC 7:2"/>ቤኤቴኤሌይዳ ናንጋ ዓሳ ሳርዔፄሬንታ ሬጌሜሌኬንታ ዔያቶና ዎላ ዓኣ ዓሶዋ ናንጊና ናንጋ ጎዳኮ ጌኤዦ ማኣሪ ዳኬኔ፤ ዬይ ዓሳ ዳኪንቴሢ ናንጊና ናንጋ ጎዳ ዓንጆ ሎፓ ኬይሳንዳጉዲ ሺኢቆም፤ ጊንሣ ሃሣ፥ <verse eid="ZEC 7:2"/><verse number="3" style="v" sid="ZEC 7:3"/>ቢያ ባኮ ዎይሣ ጎዳኮ ጌኤዦ ማኣሮይዳ ዓኣ ቄኤሶና ፆኦሲ ማሊፆ ኬኤዛ ዓሶ፦ «ሃይማ ሄላንዳኣና ሚርጌ ሌዔ ኑ ማዺ ናንጌ ጎይፆ ዶንጋሳ ዶንጋሳ ዓጊኖና ሙኡዚ ሃሺ ሺኢጲሢና ጌኤዦ ማኣሮኮ ሻሂንቲፆሮ ሲዬ ኑ ዓርቆም?» ጌይ ዖኦጫንዳጉዲኬ።<verse eid="ZEC 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 7:4"/>ዬካፓ ናንጊና ናንጋ ጎዳ ታኣም ሂዚ ጋዓ ቃኣላ ኬኤዜኔ፤ <verse eid="ZEC 7:4"/><verse number="5" style="v" sid="ZEC 7:5"/>ሃኖ ዓጮይዳ ናንጋ ዴሮ ቢያሢና ቄኤሶናም ሂዚ ጌዔ፦ «ሃያኮ ቤርታ ላንካይታሚ ሌዔ ቢያ ዶንጋሳ ዓጊኖና ላንካሳ ዓጊኖናይዳ ሙዖ ዒንሢ ሃሼሢንታ ሲዬ ሲዪፆንታ ታና ቦንቻኒዳ? <verse eid="ZEC 7:5"/><verse number="6" style="v" sid="ZEC 7:6"/>ዒንሢ ሙዖ ሙዋ ዎዶና፥ ሃሣ ዑዦ ዑሽካ ዎዶና ዒንሢ ሙይ ዑሽኬሢ ዒንሢ ቶኦኮምቱዋዓዳ?»<verse eid="ZEC 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 7:7"/>ዬሩሳላሜ ዓጫ ዖርጎጪ፥ ጊንሣ ሃሣ ዴሬያ ዺቢ ኩሜ ዎዶና፤ ዬያጉዲ ካታሞኮ ኮይሎይዳ ዓኣ ጉርዶይዳ ሌሊቱዋንቴ ዓጮኮ ዾኦሎ ዛሎና ዓባ ጌላ ባንፆናይዳ ዓኣ ጌሜሮ ዴማ ሚርጌ ዴሬ ናንጋ ዎዶና ናንጊና ናንጋ ጎዳ ፔ ማሊፆ ኬኤዛ ዓሶ ዛሎና ኬኤዜ ቃኣላ ዒማ ሃይማኬ።<verse eid="ZEC 7:7"/></para>
  <para style="s1">ዋይዚ ዒፂፃ ዲዒንቲ ሜሌ ዓጪ ዓኣዺፆኮ ካራ ማዔሢ</para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 7:8"/>ናንጊና ናንጋ ጎዳ ዛካሪያሴም ሂዚ ጌይ ኬኤዜኔ፦ <verse eid="ZEC 7:8"/><verse number="9" style="v" sid="ZEC 7:9"/>«ታኣኒ፥ ቢያ ባኮ ዎይሣ ጎዳሢ ታ ዴሮም ዓይሤ ዓይሢፃ ያዺኬ፤ ‹ፒዜ ዎጌ ዎጉዋቴ፤ ዎሊም ሴካና ሃንጋና ዓቶም ጌይሢና ሚጪንቲሢና ናንጉዋቴ፤ <verse eid="ZEC 7:9"/><verse number="10" style="v" sid="ZEC 7:10"/>ዒንሢ ባኣካ ናንጋ ዜኤሮ ዒንዶንሢ፥ ዜኤሮ ናኣቶ፥ ሜሌ ዓጪፓ ሙኪ ናንጋ ዓሶንታ ሜታዼ ዓሶንታ ሄርቂ ካራ ባይዚፖቴ፤ ፔቴይ ባጋሢም ጌኔ ማዾ ማዻኒ ማሊፖቴ።›<verse eid="ZEC 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEC 7:11"/>«ዔያታ ጋዓንቴ ዋይዞ ዒፂ ሴካ ሺሬኔ፤ ዋይዛዓ ጌይ ፔኤኮ ዋዮዋ ዓርቄኔ። <verse eid="ZEC 7:11"/><verse number="12" style="v" sid="ZEC 7:12"/>ዒኖ ፔኤኮ ዔያታ ሹቺጉዲ ዶዲሼኔ፤ ሃያኮ ቤርታ ታ ማሊፆ ኬኤዛ ዓሶ ዛሎና ታኣኒ፥ ቢያ ባኮ ዎይሣ ጎዳ ታ ዓያኖና ኬኤዜ ዎጎ ቢያ ዋይዙዋያ ዔያታ ማዔኔ፤ ዬያሮ ታኣኒ፥ ቢያ ባኮ ዎይሣ ጎዳሢ ዔያቶይዳ ሚርጌና ዻጋዼኔ። <verse eid="ZEC 7:12"/><verse number="13" style="v" sid="ZEC 7:13"/>ታኣኒ ኬኤዛዛ ዔያታ፦ ‹ኑ ዋይዛዓ› ጌዔሢሮ፥ ታኣኒያ ዔያታ ታና ሺኢቃኣና ዔያቶም ዋይዛዓኬ ጋዓኔ ቢያ ባኮ ዎይሣ ጎዳሢ። <verse eid="ZEC 7:13"/><verse number="14" style="v" sid="ZEC 7:14"/>ዓልጎ ዢባሬጉዲ ፒፂ ታኣኒ ዔያቶ ዔኪ ዔያታ ዔሩዋ፥ ፃንጎ ማዔ ዓጪዳ ዔያቶ ናንጊሼኔ፤ ሃና ኮዦ ሳዔላ ዒማና ዓይጎ ዓሲያ ናንጉዋያ ጉሪ ሳዓ ማዒ ዓቴኔ፤ ዬና ሚዛጶ ሳዔላኣ ጉሪ ዔዌ ቤሲ ማዒ ዓቴኔ።»<verse eid="ZEC 7:14"/></para>
  <chapter eid="ZEC 7"/>
  <chapter number="8" style="c" sid="ZEC 8"/>
  <para style="s1">ናንጊና ናንጋ ጎዳ ዬሩሳላሜ ጊንሣ ዓንጃኒ ጫኣቄ ጫኣቁሞ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 8:1"/>ቢያ ባኮ ዎይሣ ጎዳሢ ታኣም ሂዚ ጌዒ ኬኤዜኔ፦ <verse eid="ZEC 8:1"/><verse number="2" style="v" sid="ZEC 8:2"/>«ዒኢካ ናንጋ ዴሮ ዒናፓ ታኣኒ ናሽካሢሮ ዬሩሳላሜ ታኣኒ ማኣዳኒ ኮዓኔ፤ ዒዞኮ ሞርኮ ዑፃ ዻጋና ታ ዔቃንዳጉዲ ማሄሢ ታኣኮ ዬያ፥ ዒዛ ታኣሮ ሌሊ ማዓንዳጉዲ ኮዒ ዒናፓ ናሽካ ታ ዒኖ ናሹሞኬ። <verse eid="ZEC 8:2"/><verse number="3" style="v" sid="ZEC 8:3"/>ታኣኒ ዒኢካ ናንጋንዳጉዲ ታኣም ዱማዼ፥ ታ ካታሞ፥ ዬሩሳላሜ ባንሢ ታኣኒ ጊንሣ ማዓንዳኔ፤ ጉሙርቂንታ ካታማ ማዒ ዒዛ ዔርታንዳኔ፤ ታኣኒ፥ ቢያ ባኮ ዎይሣ ጎዳሢ ናንጋ ዹካ፥ ፆኦሲም ዱማዼ ዹካ ጌይ ሱንሢ ጌታንዳኔ፤ <verse eid="ZEC 8:3"/><verse number="4" style="v" sid="ZEC 8:4"/>ዒኢካ ናንጋ ዓሳ ሚርጌ ሌዔ ናንጋያ ማዓንዳሢሮ ጋርቺ ባሺንቴ ዓሳ ኮኦሎና ሃንቲ ሃንቲ ዬሩሳላሜይዳ ዓሳ ቡካ ቤዛ ሙኪ ዴዓንዳኔ፤ <verse eid="ZEC 8:4"/><verse number="5" style="v" sid="ZEC 8:5"/>ካታሞኮ ሳዞይዳ ዓኣ ዳልጎ ዳልጎ ጎይፃ ቢያ ዓማሊ ዓማላ ዓቲንቄና ዉዱሮና ኩሚ ዓኣያ ጊንሣ ማዓንዳኔ።<verse eid="ZEC 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 8:6"/>«ዬይ ያዺ ማዓ ዎዶና ዴሮፓ ፒኢጫዺ ዓቲ ዓኣ ዓሶም ዬይ ዳንዳዒንቱዋ ባኣዚ ማሊ ጴዼቴያ ታኣም ዳንዳዒንቱዋያ ማዒ ዴኤፃ ባኣዚ ዓኣኖ? <verse eid="ZEC 8:6"/><verse number="7" style="v" sid="ZEC 8:7"/>ታኣኒ ታኣኮ ዳውሲንቲ ዴንዲ ዓጮኮ ዓባ ኬስካ ባንፆና ጌላ ባንፆናይዳ ናንጋ ዴሮ ማኣዲ ዓውሳንዳኔ፤ <verse eid="ZEC 8:7"/><verse number="8" style="v" sid="ZEC 8:8"/>ጊንሣ ታ ዔያቶ ማሂ ዔኪ ሙኪ ዬሩሳላሜይዳ ናንጊሻንዳኔ፤ ዔያታ ታ ዴሬ ማዓንዳኔ፤ ታኣኒያ ጎኑሞና ፂሉሞና ዒኢካ ዔኪ ሙኪ ዔያቶኮ ፆኦሲ ማዓንዳኔ።<verse eid="ZEC 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 8:9"/>«ቢያ ባኮ ዎይሣ ጎዳሢኮ ጌኤዦ ማኣሮ ጊንሣ ማዣኒ ዓይፆ ሹጫ ዾቂንቴያና ዒኢካ ዓኣ ታ ማሊፆ ኬኤዛ ዓሳ ዒንሢም ኬኤዜ ባኮ ዋይዜ ዓሳ፥ ዒንሢ ዶዱዋቴ ዒጊጪፖቴ! <verse eid="ZEC 8:9"/><verse number="10" style="v" sid="ZEC 8:10"/>ዬያኮ ቤርታ ዓሲ ማዺ ላቤሢኮ ጪጎ ባኣዚንታ ቆልማ ማኣዳ ማኣዲፆኮዋ ቆልሞ ዓዶንሢም ዒንጎ ባኣዚ ባኣያኬ፤ ዓሲ ቢያ ፔ ዓሺኖ ዒፂ ሞርኬ ማዓንዳጉዲ ታኣኒ ማሄሢሮ ዓይጎ ዓሲያ ማዖም ኮሺና ኬስኪ ጌሉዋሴ። <verse eid="ZEC 8:10"/><verse number="11" style="v" sid="ZEC 8:11"/>ሃሢ ጋዓንቴ ዬያ ዴሮፓ ፒኢጫዺ ዓቴ ዓሶ ዑፃ ቤርታ ታኣኒ ማዼ ጎይፆ ማዻዓኬ። <verse eid="ZEC 8:11"/><verse number="12" style="v" sid="ZEC 8:12"/>ሃኣኮ ዔያታ ፔኤኮ ኮሺና ዜርቂ፥ ዬይ ካፃዛ ዔኪ ኮና ዋሃንዳኔ፤ ዎይናኣ ዔያቶኮ ቃራ ዓኣፒ ዓኣፓንዳኔ፤ ሳዖ ሚሻ ዒርዚያ ዋርቃንዳሢሮ ሳዓ ሚርጌ ሃኣኮ ካፂሳንዳኔ፤ ዬያ ፒኢጫዺ ዓቴ ዴሮም ዬያ ዓንጆ ቢያ ታኣኒ ዒንጋንዳኔ። <verse eid="ZEC 8:12"/><verse number="13" style="v" sid="ZEC 8:13"/>ሜሌ ዴራ ጋዳንቂንቴ ዓሲ ማሂ ዛጋ፥ ዪሁዳንታ ዒስራዔኤሌ ዴሬዮቴ! ታኣኒ ዒንሢ ማኣዲ ዓውሳንዳኔ፤ ሜሌ ዓሶም ዓንጆኮ ካራ ዒንሢ ማዓንዳኔ፤ ዬያሮ ዒጊጪፖቴ! ዶዱዋቴ።»<verse eid="ZEC 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 8:14"/>«ዬያ ጌዔሢ ታና ቢያ ባኮ ዎይሣ ጎዳኬ፤ ዒንሢኮ ቤርታኣ ዓዶንሢ ታና ዻጋሴያና ቲኢሩዋኣዖ ሜቶ ታ ዔያቶይዳ ዓጋኒ ማሊ ቱኬኔ። <verse eid="ZEC 8:14"/><verse number="15" style="v" sid="ZEC 8:15"/>ዬሩሳላሜና ዪሁዳ ዴሮናም ኮሺ ባኣዚ ማዻኒ ማሊ ቱኪ ታ ዔቄሢሮ ዶዱዋቴ፥ ዒጊጪፖቴ። <verse eid="ZEC 8:15"/><verse number="16" style="v" sid="ZEC 8:16"/>ዒንሢ ማዻኒ ኮይሳ ባካ ዓይጎዳይ ጌዔቴ፦ ሴካና ሃንጋና ዎላ ጎኔ ባኣዚ ጌስቱዋቴ፤ ዒንሢ ዎጎ ዎጋ ቤዞይዳ ኮሹሞ ዓኣያ ማዓንዳጉዲ ፒዜ ዎጌ ዎጉዋቴ። <note caller="-" style="x"><char style="xo" closed="false">8፡16 </char><char style="xt" closed="false"><ref loc="EPH 4:25">ዔፕ. 4፡25</ref>።</char></note> <verse eid="ZEC 8:16"/><verse number="17" style="v" sid="ZEC 8:17"/>ፔቴይ ባጋሢም ጌኔ ማዾ ማዻኒ ፑርታ ማሊሢ ማሎፓ፤ ሉኡዙሞ ጫኣቁሞ ጫኣቂፖቴ፤ ታኣኒ ዬያጉዴ ባኮ ቢያ ዒዒፃኔ» ጋዓኔ፥ ናንጊና ናንጋ ጎዳሢ።<verse eid="ZEC 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ZEC 8:18"/>ቢያ ባኮ ዎይሣ ጎዳሢ ታኣም ሂዚ ጌዔኔ፦ <verse eid="ZEC 8:18"/><verse number="19" style="v" sid="ZEC 8:19"/>«ዖይዳሳ ዓጊኖና፥ ዶንጋሶና፥ ላንካሶንታ ታጳሳ ዓጊኖንታይዳ ዒንሢ ካፒ ካፒ ሙዖ ሃሻ ኬላ ቢያ ዪሁዳ ዴሮም ኮሺ፤ ሃሣ ዎዛ ቦንቾ ኬሊ ማዓንዳኔ። ዒንሢ ጋዓንቴ ጎኔ ባኣዚና ኮሹሞና ኮዑዋቴ።»<verse eid="ZEC 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ZEC 8:20"/>ቢያ ባኮ ዎይሣ ጎዳሢ ሂዚ ጋዓኔ፦ «ሜሌ ዴሮንታ ሚርጌ ዺቦ ካታሞይዳ ናንጋ ዴራ ዬሩሳላሜ ባንሢ ዋኣሢጉዲ ጎዓንዳ ዎዴ ዬዓንዳኔ። <verse eid="ZEC 8:20"/><verse number="21" style="v" sid="ZEC 8:21"/>ፔቴ ካታማይዳ ናንጋ ዓሳ ሜሌ ካታሞይዳ ናንጋ ዓሶ ኮይላ ዴንዲ፦ ‹ሃኒ ዬውዋቴ! ቢያ ባኮ ዎይሣ ጎዳሢ ኮሺ ባኣዚ ኑም ማዻንዳጉዲ ኑ ዒዛ ሺኢቆም፤ ኑኡኒያ ሃሢ ዒኢካ ዓኣዺፆይዳኬ!› ጋዓንዳኔ። <verse eid="ZEC 8:21"/><verse number="22" style="v" sid="ZEC 8:22"/>ዬያይዲ ቢያ ባኮ ዎይሣ ጎዳሢም ዚጋኒና ዒዛፓ ዓንጆዋ ዔካኒ ሺኢጲሢሮ ሚርጌ ዓሲንታ ዎልቄና ዓኣ ዺቢ ዴሬያ ዬሩሳላሜ ሙካንዳኔ። <verse eid="ZEC 8:22"/><verse number="23" style="v" sid="ZEC 8:23"/>ዬንሢ ኬሎንሢዳ ሜሌ ዓጪ ዓሲ ታጶ ፔቴ ዓይሁዴ ዓሲኮ ማኣዓሢ ጎቺ ዓርቂ፦ ‹ፆኦሲ ዒንሢና ዎላታሢ ኑኡኒ ዋይዜሢሮ ሃዳራ ዒንሢና ኑ ዴንዶም› ጋዓንዳኔ።»<verse eid="ZEC 8:23"/></para>
  <chapter eid="ZEC 8"/>
  <chapter number="9" style="c" sid="ZEC 9"/>
  <para style="s1">ዒስራዔኤሌኮ ዓሺኖ ማዔ ሞርኮይዳ ፆኦሲ ዓጋኒ ጊኢጌ ሜቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 9:1"/>ናንጊና ናንጋ ጎዳ ሃድራኬ ዓጮና ዴማስቆ ካታሞናይዳ ሜቶ ዓጋንዳኔ፤ ዒስራዔኤሌ ፃጶ ሌሊቱዋንቴ ሶኦሪያኮ ዼኤፖ ካታማኣ ናንጊና ናንጋ ጎዳም ማዓንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">9፡1 </char><char style="xt" closed="false"><ref loc="ISA 17:1-3">ዒሲ. 17፡1-3</ref>፤ <ref loc="JER 49:23-27">ዔር. 49፡23-27</ref>፤ <ref loc="AMO 1:3-5">ዓሞ. 1፡3-5</ref>።</char></note> <verse eid="ZEC 9:1"/><verse number="2" style="v" sid="ZEC 9:2"/>ዬይ ሜታ ሃድራኬ ዓጮ ኮይላ ዓኣ ሃማቴና ሚርጌ ዔራቶ ዓኣ ፂሮሴና ሲዶና ካታሞይዳ ኬዳንዳኔ። <verse eid="ZEC 9:2"/><verse number="3" style="v" sid="ZEC 9:3"/>ፂሮሴ ፔና ካፓኒ፥ ዴይ ካፖ ዼጌ ቤሲ ዋርዲያ ማሂ ኮሼኔ፤ ሚርጉማ ዓጪጉዴ ሹቺ ቢራንታ ዎርቄንታኣ ቡኩሴኔ። <verse eid="ZEC 9:3"/><verse number="4" style="v" sid="ZEC 9:4"/>ጋዓንቴ ዒዛ ዬያ ቡኩሴ ባኮ ናንጊና ናንጋ ጎዳ ዒዞፓ ዔካንዳኔ፤ ባዞይዳ ዓኣ ዒዞኮ ዎልቆ ማዔ ባኮ ዒኢካ ዱኡኪ ዒ ባይዛንዳኔ፤ ካታሜላ ታሚና ሚቺንቲ ዲቢንሢ ማዓንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">9፡4 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">ዒሲ. 23፡1-18</ref>፤ <ref loc="EZK 26:1-28:26">ሂዚ. 26፡1—28፡26</ref>፤ <ref loc="JOL 3:4-8">ዒዩ. 3፡4-8</ref>፤ <ref loc="AMO 1:9-10">ዓሞ. 1፡9-10</ref>፤ <ref loc="MAT 11:21-22">ማቲ. 11፡21-22</ref>፤ <ref loc="LUK 10:13-14">ሉቃ. 10፡13-14</ref>።</char></note><verse eid="ZEC 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 9:5"/>ዓስቄሎና ካታማ ዬያ ዛጋዖ ዲቃቲ ዒጊጫንዳኔ፤ ጋኣዛ ካታማኣ ዬያ ዛጋዖ ዎኦቶንዶ ካራ ባይዛንዳኔ፤ ዔቆሮኔያ ዬያጉዲ ሃጋኣ ዎዛ ባኣያ ማዓንዳኔ፤ ጋኣዛ ካታማኣ ካኣቲ ባኣያ ማዓንዳኔ፤ ዓስቄሎና ካታማ ዓሲ ናንጉዋ ጉሪ ቤሲ ማዒ ዓታንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">9፡5 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">ዒሲ. 14፡29-31</ref>፤ <ref loc="JER 47:1-7">ዔር. 47፡1-7</ref>፤ <ref loc="EZK 25:15-17">ሂዚ. 25፡15-17</ref>፤ <ref loc="JOL 3:4-8">ዒዩ. 3፡4-8</ref>፤ <ref loc="AMO 1:6-8">ዓሞ. 1፡6-8</ref>፤ <ref loc="ZEP 2:4-7">ሶፖ. 2፡4-7</ref>።</char></note> <verse eid="ZEC 9:5"/><verse number="6" style="v" sid="ZEC 9:6"/>ዔሽዶዴይዳ ሲኢሪንቴ ዴሬ ናንጋንዳኔ፤ ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ሃኣቶ፥ ዖቶርቃ ፒሊስፄኤሜ ዓሶ ታኣኒ ዻውሲሳንዳኔ፤ <verse eid="ZEC 9:6"/><verse number="7" style="v" sid="ZEC 9:7"/>ሱጉሢ ጊዳ ዓኣ ዓኣዔ ዓሽኮ፥ ጊንሣ ሃሣ ዳምቦ ጎይፆና ሙይንቱዋጉዲ ላኣጊንቴ ሙዖ ዔያቶ ዻንጋፓ ታኣኒ ኬሲሳንዳኔ፤ ዔያቶፓ ፒኢጫዺ ዓቴ ዓሳ ታ ዓሶና ዎላ ሲኢሪንቲ ዪሁዳ ፃጶይዳ ፔቴ ቶኦኪ ማዓንዳኔ፤ ዔቅሮኔ ዴራ ዓዳ ዒያቡሳ ዓሶጉዲ ዴሮና ዎላ ሲኢሪንታንዳኔ። <verse eid="ZEC 9:7"/><verse number="8" style="v" sid="ZEC 9:8"/>ዬካፓ ታ ዓጮኮ ዓጮ ታኣኒ ዋርዲ ዔቂ ካፓንዳኔ፤ ዓጮ ዎልቄና ጌሊ ዓርቃ ዎልቆ ዓሳ ዒኢና ዴንዱዋጉዲ ታኣኒ ላኣጋንዳኔ። ታኣኮ ዴራ ዎማዺ ዋኣዬቴያ ታኣኒ ዛጌሢሮ ሃይካፓ ሴካ ዎልቆና ሄርቂ ዎይሣ ዓሳ ዔያቶ ዎልቄና ጌሊ ዓርቃዓኬ።»<verse eid="ZEC 9:8"/></para>
  <para style="s1">ሃጊ ሙካኒ ዓኣ ፂዮኔ ካኣታሢ</para>
  <para style="q">
    <verse number="9" style="v" sid="ZEC 9:9"/>ፂዮኔ፥ ዎዛዼ!</para>
  <para style="q2" vid="ZEC 9:9">ዬሩሳላሜ፥ ዎዛና ዒሊሼ!</para>
  <para style="q" vid="ZEC 9:9">ሃይሾ፥ ኔኤኮ ካኣቲ ኮሹሞና ሼሌዔ ማዒ</para>
  <para style="q2" vid="ZEC 9:9">ሃሬሎ ዑፃ፥ ጌይፃ ሃሮ ናዖ ዑፃ ዴይ</para>
  <para style="q2" vid="ZEC 9:9">ዎልቄና ባሻያ ማዒ ኔ ባንሢ ሙካኔ። <note caller="-" style="x"><char style="xo" closed="false">9፡9 </char><char style="xt" closed="false"><ref loc="MAT 21:5">ማቲ. 21፡5</ref>፤ <ref loc="JHN 12:15">ዮሃ. 12፡15</ref>።</char></note><verse eid="ZEC 9:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEC 9:10"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦</para>
  <para style="q2" vid="ZEC 9:10">«ታኣኒ ሳርጌሎ ዖይቶ ዒስራዔኤሌፓ</para>
  <para style="q2" vid="ZEC 9:10">ዖሎ ፓራሢያ ዬሩሳላሜፓ ዔኪ ሺኢሻንዳኔ፤</para>
  <para style="q2" vid="ZEC 9:10">ዖሎ ዖላ ሂኢዦዋ ታኣኒ ሜንሣንዳኔ፤</para>
  <para style="q2" vid="ZEC 9:10">ኔኤኮ ካኣቲ ሜሌ ዴሮ ባኣካ ዴይ</para>
  <para style="q2" vid="ZEC 9:10">ኮሹሞ ሳዖይዳ ዔኪ ዬዓንዳኔ፤</para>
  <para style="q2" vid="ZEC 9:10">ዒ ዎይሣ ዓጮኮ ዛጳ ባዛፓ ዴንዲ ሜሌ ባዞ ሄላንዳኣና</para>
  <para style="q2" vid="ZEC 9:10">ዔፕራፂሴ ዎራፓ ዓርቃዖ ዴንዲ</para>
  <para style="q2" vid="ZEC 9:10">ዓጮኮ ጋፒንፆ ሄላያ ማዓንዳኔ።» <note caller="-" style="x"><char style="xo" closed="false">9፡10 </char><char style="xt" closed="false"><ref loc="PSA 72:8">ዓይኑ. 72፡8</ref>።</char></note><verse eid="ZEC 9:10"/></para>
  <para style="s1">ናንጊና ናንጋ ጎዳኮ ዴራ ዲዒንቲ ዴንዴ ዓጫፓ ማዓንዳሢ</para>
  <para style="q">
    <verse number="11" style="v" sid="ZEC 9:11"/>«ዒንጎ ባኣዚ ማዒ ዒንጊንቴ ሱጉሢና ታ ኔኤም ጫኣቄሢሮ</para>
  <para style="q2" vid="ZEC 9:11">ዋኣፃባኣ ጉሮ ዔታ ኔኤኮ ቱኡቲ ዓኣ ዓሶ ታኣኒ ኬሳንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">9፡11 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ኬሲ. ማፃ 24፡8</ref>።</char></note><verse eid="ZEC 9:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEC 9:12"/>ዒንሢ፥ ሃጋኣ ዎዛ ዴንቄ፥ ቱኡዞ ዓሳ!</para>
  <para style="q2" vid="ZEC 9:12">ታኣኒ ቤርታ ዒንሢኮ ዓኣሢፓ ጳንጬ ማሂ ሃኖ ዒንሢም ዒንጋንዳሢሮ</para>
  <para style="q2" vid="ZEC 9:12">ዒኢካ ዴዒ ካታሞ ዒንሢኮ ካፖ ዼጌ ቤዞ ባንሢ ማዑዋቴ።<verse eid="ZEC 9:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEC 9:13"/>ዪሁዳ ታኣኒ ሂኢሺ ጎይሢ</para>
  <para style="q2" vid="ZEC 9:13">ዒስራዔኤሌ ጊንሣ ሃሣ ዓኣዛ ማሂ ዔያቶና ዖላንዳኔ፤</para>
  <para style="q" vid="ZEC 9:13">ጊሪኬ ዓጮ ዓቲንቆ ዖላኒ</para>
  <para style="q2" vid="ZEC 9:13">ፂዮኔፓ ዓቲንቆ ናኣቶ ጬንቻ ዓራፖ ማሂ ታኣኒ ዳካንዳኔ።»<verse eid="ZEC 9:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="ZEC 9:14"/>ናንጊና ናንጋ ጎዳ ዴሮ ዑፃ ማዒ ፔጋዺ ጴዻንዳኔ፤</para>
  <para style="q2" vid="ZEC 9:14">ዒዛኮ ዓኣዛ ዜኤሊንሢጉዲ ፖዒ ዴንዳያ ማዓንዳኔ፤</para>
  <para style="q" vid="ZEC 9:14">ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢ ዛዬ ዋርቃንዳኔ፤</para>
  <para style="q2" vid="ZEC 9:14">ዓጮኮ ዾኦሎ ዛላፓ ቱሮ ሙካ ዓልጎ ዢባሬጉዲ ዢባርሺ ዴንዳንዳኔ።<verse eid="ZEC 9:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEC 9:15"/>ቢያ ባኮ ዎይሣ ጎዳሢ ፔ ዴሮ ዛሎ ዖልታንዳኔ፤</para>
  <para style="q2" vid="ZEC 9:15">ዒዛኮ ዴራ ፔ ሞርኮ ዎዺ ባይዛንዳኔ፤</para>
  <para style="q2" vid="ZEC 9:15">ሞርኮኮ ዎሮ ሹዎ ቶኪና ሄርቃንዳኔ፤</para>
  <para style="q2" vid="ZEC 9:15">ዔያታ ዖሎይዳ ማሢንቴ ዓሲ ጎይሢ ሜርታንዳኔ፤</para>
  <para style="q2" vid="ZEC 9:15">ዔያቶ ሞርኮኮ ሱጉፃ ፆኦሲም ዒንጋኒ ሳኣኔይዳ ኩንሢ ዔኪ ዬይ</para>
  <para style="q2" vid="ZEC 9:15">ዒንጎ ባኮ ዒንጎ ቤዞይዳ ዋሂንታ ሱጉሢጉዲ ሾኦታንዳኔ።<verse eid="ZEC 9:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="ZEC 9:16"/>ዬና ኬላ ሄላኣና ቆልሞ ሄንቃሢ ቆልሞ ፔኤኮ ሙዓ ቦዖይዳፓ ዓውሳሢጉዲ</para>
  <para style="q2" vid="ZEC 9:16">ናንጊና ናንጋ ጎዳ ማዔ ዔያቶኮ ፆኦዛሢ ፔ ዴሮ ዓውሳንዳኔ።</para>
  <para style="q2" vid="ZEC 9:16">ቦንቾሮ ቶኦካ ዓጎ ባኮይዳ ጳርቂ ኮሾና ዓንጋ ፖዓሢጉዲ</para>
  <para style="q2" vid="ZEC 9:16">ዔያታ ፔኤኮ ናንጊና ናንጋ ጎዳሢኮ ዓጮይዳ ፖዓያ ማዓንዳኔ።<verse eid="ZEC 9:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEC 9:17"/>ዓጬሎኮ ኮሹሞና ሚዛጱሞና ዎዚ ሄርሺሳያ ማዓንዳይ!</para>
  <para style="q2" vid="ZEC 9:17">ዒኢካ ዓኣያ ማዓንዳ ሃኣኮንታ ዎይኖ ዑዦንታ</para>
  <para style="q2" vid="ZEC 9:17">ዓቲንቆንታ ዉዱሮ ዼጌሢንታኮ ዑፆ ሚዛጲሳያ ማዓንዳኔ።<verse eid="ZEC 9:17"/></para>
  <chapter eid="ZEC 9"/>
  <chapter number="10" style="c" sid="ZEC 10"/>
  <para style="s1">ናንጊና ናንጋ ጎዳ ዴሮ ዓውሳኒ ማሌ ማሊፆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 10:1"/>ናንጊና ናንጋ ጎዳ ዒንሢም ሃቻቡሮ ዒርዚ ዋርቂሳንዳጉዲ ዒዛ ሺኢቁዋቴ፤ ዒርዚና ዓኣ ሻኣሬ ዳካሢ ናንጊና ናንጋ ጎዳኬ፤ ዒርዚንታ ዱማ ዱማ ባቃላ ባኮዋ ባቃልሳሢ ዒንጋሢ ዒዛኬ። <verse eid="ZEC 10:1"/><verse number="2" style="v" sid="ZEC 10:2"/>ሜሌ ፆኦዛ ፓሡዋ ባኣዚ ኬኤዛኔ፤ ዦዋኣ ሉኡዙሞ ባኣዚ ዴንቄኔ ጌይ ኬኤዛኔ፤ ማቂሢ ዓውቲያ ዓውታዼኔ ጌይ ጌስታኔ፤ ዔያታ ዓሶኮ ዒኖ ዶዲሻሢያ ጉሪ ማዔ ባኣዚናኬ፤ ዬያሮ ዴራ ሄንቃ ዓሲባኣ ማራይጉዲ ዣኣሊ ካራ ባይዜኔ።<verse eid="ZEC 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 10:3"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ታኣኮ ዼኤፖ ዻጋ ታ ዴሮ ሄንቃ ሱኡጎ ታሚጉዲ ሙዓንዳኔ፤ ታኣኒ፥ ቢያ ባኮ ዎይሣ ጎዳሢ ታ ቆልሞ ማዔ ዪሁዳ ዴሮ ዓውሳኒ ኮዓሢሮ ዔያቶኮ ሱኡጎይዳ ሜቶ ታኣኒ ዓጋንዳኔ፤ ዪሁዳ ዴሮ ዖሊ ባሼ ዶዲ ፓሮ ታኣኮ ታ ማሃንዳኔ። <verse eid="ZEC 10:3"/><verse number="4" style="v" sid="ZEC 10:4"/>ዪሁዳ ዴሮ ባኣካፓ ሹዎና ማዦ ማኣራ ዎላ ካኣማ ካራ ጌሦ ሹጮጉዴ፥ ዓፒሎና ማዦ ማኣሮ ዾቆ ዓንጎጉዴ፥ ዖልዚ ዖሎ ሂኢሺጉዴ ሱኡጌንታ ዖሎ ዓሶ ዓይሣ ቢቲያ ኬስካንዳኔ። <verse eid="ZEC 10:4"/><verse number="5" style="v" sid="ZEC 10:5"/>ዪሁዳ ዴራ ፔኤኮ ሞርኮ ጎይሢ ዾቃሌጉዲ ሄርቂ ዳኣፃ፥ ዶዲ ዖልዚ ዓሲ ማዓንዳኔ፤ ናንጊና ናንጋ ጎዳኣ ዔያቶና ዎላታሢሮ ዔያታ ዶዲ ዖሊ፥ ፓራሢና ዖልታ ዎልቆና ዓኣ ዓሶ ባሻንዳኔ።»<verse eid="ZEC 10:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="ZEC 10:6"/>«ታኣኒ ዪሁዳ ዴሮ ዖልዚ ዖላ ዶዲ ዓሲ ማሃንዳኔ፤</para>
  <para style="q2" vid="ZEC 10:6">ዮሴፔ ማኣሮዋ ታኣኒ ዓውሳንዳኔ፤</para>
  <para style="q" vid="ZEC 10:6">ታኣኒ ዔያቶ ሚጪንቲ ቲኢራንዳሢሮ ቢያሢ ፔ ዓጮ ዓጮ ታ ማሃንዳኔ፤</para>
  <para style="q2" vid="ZEC 10:6">ሃያኮ ቤርታ ፔቴታዖ ታ ዔያቶ ኬኤሪ ቤቂባኣያ ዔያታ ማዓንዳኔ፤</para>
  <para style="q" vid="ZEC 10:6">ታኣኒ ናንጊና ናንጋ ጎዳ ዔያቶኮ ፆኦሲ ማዔሢሮ</para>
  <para style="q2" vid="ZEC 10:6">ሺኢጲፆ ታ ዔያቶኮ ዋይዛንዳኔ።<verse eid="ZEC 10:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEC 10:7"/>ዔፕሬኤሜ ዴራ ዖልዚ ዖላ ዶዲ ዓሲ ማዓንዳኔ፤</para>
  <para style="q2" vid="ZEC 10:7">ዎይኔ ዑሺ ዑሽኬ ዓሲጉዲያኣ ዔያታ ዎዛዻያ ማዓንዳኔ፤</para>
  <para style="q2" vid="ZEC 10:7">ዔያቶኮ ናኣታኣ ዬያ ባሺፆ ጶቂሢ ጶቂሢ ዎዛዻንዳኔ፤</para>
  <para style="q2" vid="ZEC 10:7">ናንጊና ናንጋ ጎዳሢ ማዼ ባኮሮዋ ዔያታ ዎዛዻንዳኔ።»<verse eid="ZEC 10:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ZEC 10:8"/>«ታ ዴሮ ታኣኒ ታ ባንሢ ዉቲ ዔኤሊ</para>
  <para style="q2" vid="ZEC 10:8">ፔቴይዳ ቡኩሳንዳኔ፥ ታ ዔያቶ ዓውሳንዳኔ፤</para>
  <para style="q2" vid="ZEC 10:8">ሃያኮ ቤርታ ዔያታ ዓኣ ጎይፆ ፓይዶ ታ ዔያቶኮ ሚርጊሻንዳኔ።<verse eid="ZEC 10:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEC 10:9"/>ሜሌ ዴሮ ባኣካ ታኣኒ ዔያቶ ዜርቄያ ማዔቴያ</para>
  <para style="q2" vid="ZEC 10:9">ዔያታ ናንጋ ሃኬ ዓጮይዳ ዓኣዖ ታና ጶቂሣንዳኔ፤</para>
  <para style="q2" vid="ZEC 10:9">ዔያቶንታ ዔያቶኮ ናኣቶንታ ሼምፔና ዓኣያ ማዒ ፔ ዓጮ ማዓንዳኔ።<verse eid="ZEC 10:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEC 10:10"/>ጊብፄ ዓጫፓ ታ ዔያቶ ማሂ ዔኪ ዬዓንዳኔ፤</para>
  <para style="q2" vid="ZEC 10:10">ዓሶኦሬፓኣ ዔኪ ዬይ ታ ዔያቶ ቡኩሳንዳኔ፤</para>
  <para style="q2" vid="ZEC 10:10">ሳዓ ኩሜም ቤሲ ዔያቶኮ ባይቃንዳሢሮ</para>
  <para style="q2" vid="ZEC 10:10">ጌሌዓዴንታ ሊባኖኦሴ ዓጮንታይዳኣ ታ ዔያቶ ዴይሣንዳኔ።<verse eid="ZEC 10:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEC 10:11"/>ዼኤፖ ሜቶ ባዞ ባኣኪና ዔያታ ዴንዳኣና</para>
  <para style="q2" vid="ZEC 10:11">ታኣኒ፥ ናንጊና ናንጋ ጎዳ ዒኢካ ዔቃ ባዞ ጉዳሢ ጎሪ ዚቲዳንዳኔ፤</para>
  <para style="q2" vid="ZEC 10:11">ዔታዼ ቁልቦይዳ ዴዒ ዓኣ ዓባዬ ዎሮ ዋኣፃኣ ሚጫንዳኔ፤</para>
  <para style="q" vid="ZEC 10:11">ዖቶሬላ ዓሶኦሬ ዻውሲንታንዳኔ፤</para>
  <para style="q2" vid="ZEC 10:11">ጊብፄያ ካኣታቲ ዎይሣ ዎይሢፃፓ ኬዳንዳኔ።<verse eid="ZEC 10:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEC 10:12"/>ታኣኒ፥ ናንጊና ናንጋ ዔያቶኮ ጎዳሢ ዔያቶ ዶዲሻንዳኔ፤</para>
  <para style="q2" vid="ZEC 10:12">ታ ሱንፆና ዔያታ ዖቶርቃንዳኔ።»</para>
  <para style="q" vid="ZEC 10:12">ዬያ ጌዔሢ ታና፥ ናንጊና ናንጋ ጎዳኬ።<verse eid="ZEC 10:12"/></para>
  <chapter eid="ZEC 10"/>
  <chapter number="11" style="c" sid="ZEC 11"/>
  <para style="s1">ዒስራዔኤሌ ዓሶኮ ሞርካ ሜቶይዳ ኬዴሢ</para>
  <para style="q">
    <verse number="1" style="v" sid="ZEC 11:1"/>ሊባኖኦሴ!</para>
  <para style="q2" vid="ZEC 11:1">ኔኤኮ ዴኤሎ ዚቢቆ ሚፆ ታሚ ሙዓንዳጉዲ</para>
  <para style="q2" vid="ZEC 11:1">ካሮ ቡሊ ሃሼ!<verse eid="ZEC 11:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEC 11:2"/>ሊባኖኦሴይዳ ዓኣ ሚፃ ዶዔሢሮ ዒንሢ ዚቢቆ ሚፃ፦</para>
  <para style="q2" vid="ZEC 11:2">«ኑና ዎኦ!» ጌይ ቃዩዋቴ፤</para>
  <para style="q2" vid="ZEC 11:2">ዒጊቻያ ማዔ ዼኤፖ ሚፃ ቢያ ባይቄኔ፤</para>
  <para style="q" vid="ZEC 11:2">ዲም ጌዔ ዴኤሎ ካያ ቲቂንቲ ጋፔሢሮ ዒንሢ ባኣሳኔ ሻኣቢዮቴ፦</para>
  <para style="q2" vid="ZEC 11:2">«ኑና ዎኦ!» ጌይ ጌይ ዒንሢና ቃዩዋቴ።<verse eid="ZEC 11:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEC 11:3"/>ቆልሞ ሄንቃ ዓሶኮ ቆልሞ ሄንቆ ኮዦ ቤዛ ዱጊንቲ ባይቄሢሮ</para>
  <para style="q2" vid="ZEC 11:3">«ኑና ዎኦ!» ጌይ ጌይ ቃያያ ዋይዚንቴኔ፤</para>
  <para style="q2" vid="ZEC 11:3">ዮርዳኖሴ ዎሮ ዓጫ ዓኣ</para>
  <para style="q2" vid="ZEC 11:3">ዔያቶኮ ናንጊ ቤሲ ማዔ ዴኤላ ጲሺንቲ ኩዴሢሮ</para>
  <para style="q2" vid="ZEC 11:3">ዞባ ዖዪ ጉዻያ ዋይዚንቴኔ።<verse eid="ZEC 11:3"/></para>
  <para style="s1">ቆልሞ ሄንቃ ላምዖ ዓሲ</para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 11:4"/>ናንጊና ናንጋ ጎዳ ማዔ ታ ፆኦዛሢ ታኣም ሂዚ ጌዔኔ፦ «ሹኪንታኒ ጊኢጊንቴ ማራቶ ሄንቃኒ ኬሴ። <verse eid="ZEC 11:4"/><verse number="5" style="v" sid="ZEC 11:5"/>ዬያቶ ማራቶ ሻንቄ ዓሳ ሹካንዳኔ፥ ጋዓንቴ ዬያ ሹኬ ዓሶ ሜታ ሄላዓኬ፤ ዔያቶ ሻንቼ ዓሳኣ ‹ናንጊና ናንጋ ጎዳሢ ጋላቲንቶም! ኑ ዖርጎጬኔ› ጋዓንዳኔ፤ ሄንቃ ዓሳኣ ዔያቶ ሚጪንታዓኬ።»<verse eid="ZEC 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 11:6"/>ናንጊና ናንጋ ጎዳሢ ሂዚ ጋዓኔ፦ «ታኣኒያ ሃካፓ ሴካ ሳዖይዳ ናንጋ ዓይጎ ዓሲማኣ ማዖም ሚጪንታዓኬ፤ ታኣኒ ታ ቶኦኪና ፔቴ ፔቴ ዓሶ ፔ ዓሺናሢም፥ ሃሣ ካኣቲ ማዒ ዎይሣሢ ኩጫ ዓኣሢ ዒንጋንዳኔ፤ ዬያታ ዓሺኖንታ ካኣቶንታ ዬያ ሳዖ ባይዛንዳኔ፤ ታኣኒ ዬያቶ ኩጫፓ ዬኖ ዓሶ ዓውሳዓኬ።»<verse eid="ZEC 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 11:7"/>ዬያሮ ሹካኒ ዱማሶና ማራቶ፤ ባሼ ካራ ባይዚ ሜታሶና ቆልሞ ታኣኒ ሄንቃያ ማዓኔ። ዒማና ታኣኒ ላምዖ ኮኦሎ ዔኪ፥ ፔቴ ኮኦላሢ ሱንፆ «ዎዛሴ» ጌይ ጌሢ፥ ባጋሢ ሱንፆ «ፔቱሞ» ጌዔኔ። <verse eid="ZEC 11:7"/><verse number="8" style="v" sid="ZEC 11:8"/>ፔቴ ዓጊኒ ጋርካ ዬያቶ ማራቶ ሄንቃ ሃይሦ ዓሶ ታኣኒ ዳውሲ ዳኬኔ፤ ዒማና ማራታ ታና ዒፄኔ፥ ታኣኒያ ዔያቶ ሼናዼኔ። <verse eid="ZEC 11:8"/><verse number="9" style="v" sid="ZEC 11:9"/>ዬካፓ ታኣኒ ቆልሞም ሂዚ ጌዔኔ፦ «ሃይካፓ ሴካ ታኣኒ ዒንሢ ሄንቃዓኬ፤ ሃይቃሢ ሃይቆንጎ፤ ባይቃሢያ ባባይቆንጎ፤ ዓቲ ዓኣ ቆልማ ዎሊ ጋኣሺ ሙይ ባይቆንጎ፤» <verse eid="ZEC 11:9"/><verse number="10" style="v" sid="ZEC 11:10"/>ሄሊሳዖ «ዎዛሴ» ጌይ ታኣኒ ሱንፆ ጌሤ፥ ኮኦላሢ ታኣኒ ዔኪ ሜንሤኔ፤ ዬያ ታኣኒ ማዼሢ ናንጊና ናንጋ ጎዳና ዎላ ታ ጫኣቄ ጫኣቁማ ሃሺንቴያ ማዔሢ ዔርዛኒኬ። <verse eid="ZEC 11:10"/><verse number="11" style="v" sid="ZEC 11:11"/>ዬያ ጎይፆና ፆኦሲ ጫኣቄ ጫኣቁማ ዒማ ኬላ ሃሺንቴኔ፤ ዬያ ታኣኒ ማዻኣና ዔቂ ዛጋ ማራቶ ኮርማ ዓሳ ናንጊና ናንጋ ጎዳ ቃኣሎ ዬያይዲ ኬኤዜሢ ዔሬኔ። <verse eid="ZEC 11:11"/><verse number="12" style="v" sid="ZEC 11:12"/>ታኣኒ ዒማና፦ «ዒንሢ ናሽኬቴ ታኣም ኮይሳ ሚኢሾ ዒንጉዋቴ፤ ዒፄቴ ሃሹዋቴ» ጌዔኔ፤ ዔያታ ታኣኒ ማዼሢ ዛሎ ሃይሢታሚ ሹቺ ቢራ ታኣም ጪጌኔ። <note caller="-" style="x"><char style="xo" closed="false">11፡12 </char><char style="xt" closed="false"><ref loc="MAT 26:15">ማቲ. 26፡15</ref>።</char></note><verse eid="ZEC 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEC 11:13"/>ናንጊና ናንጋ ጎዳሢ ታኣም፦ «ጌኤዦ ማኣሮይዳ ሚኢሾ ጌሦ ሳኣፂና ዓጌ» ጌዔኔ። ዬያሮ ታኣኒ «ማዺንቴ ማዾ ዛሎኮ ጊዳ ሚኢሼኬ» ጌይ ታኣም ዔያታ ዒንጌ ሃይሢታሞ ሹዎ ቢሮ ዔኪ ማንዚኮ ዖቶ ጋራ ዓጌኔ። <note caller="-" style="x"><char style="xo" closed="false">11፡13 </char><char style="xt" closed="false"><ref loc="MAT 27:9-10">ማቲ. 27፡9-10</ref>።</char></note> <verse eid="ZEC 11:13"/><verse number="14" style="v" sid="ZEC 11:14"/>ዬካፓ ሃሣ «ፔቱሞ» ጌይ ታኣኒ ሱንፆ ጌሤ፥ ላምዓሳ ኮኦላሢ ሜንሤኔ፤ ዬያ ታኣኒ ማዼሢ ዪሁዳና ዒስራዔኤሌና ባኣካፓ ዎሊኮ ጌርሲንሢ ማዒ ናንጎ ናንጋ ባይቄሢ ዔርዛኒኬ።<verse eid="ZEC 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ZEC 11:15"/>ዬያ ታኣኒ ማዼስካፓ ናንጊና ናንጋ ጎዳ ታኣም ሂዚ ጌዔኔ፦ «ሃሣ ጊንሣ ማኣዳ ባኣዚባኣ ቆልሞ ሄንቃ ዓሲ ማዻ ጎይሢ ማዼ፤ <verse eid="ZEC 11:15"/><verse number="16" style="v" sid="ZEC 11:16"/>ሳዔሎይዳ ናንጋ ታኣኮ ቆልሞ ሄንቃንዳ ሄንቃ ዓሲ ታኣኒ ዶኦራንዳኔ፤ ጋዓንቴ ዬይ ዓሢ ዬያይዶ ሃሺ ባይቄ ቆሎ ዛሎ ሜታዺ ማሉዋያ፥ ዣኣሌ ቆልሞ ኮዑዋያ፥ ሜቄ ቆልሞዋ ኮኦሉዋያ፥ ዋሊ ዓኣ ቆልሞም ዖሃ ዓጉዋያ ማዓንዳኔ፤ ዒዚ ዬያይዶ ሃሻዖ ቃራዺ ዲጬዞንሢ ሹኪ ሹኪ ሙዓንዳኔ፤ ሹቁሎዋ ዓይሱዋዖ ዒ ቆፂ ሙዓንዳኔ። <verse eid="ZEC 11:16"/><verse number="17" style="v" sid="ZEC 11:17"/>ቆልሞም ሚጪንቶ ዒፄ፥ ዬያጉዴ ፓሡዋያ ማዔ ሄንቃ ዓሣሢም ባዴዔ! ዒዛኮ ቃሶንታ ሚዛቆ ዓኣፖንታ ጬንቻ ዓራፖና ጫቶም፤ ቃሳ ዒዛኮ ጋፒንሢ ሜሊ ዞሌያ ማዖም፤ ሚዛቆ ዓኣፓ ዒዛኮ ጋፒ ባይቆም።»<verse eid="ZEC 11:17"/></para>
  <chapter eid="ZEC 11"/>
  <chapter number="12" style="c" sid="ZEC 12"/>
  <para style="s1">ዬሩሳላሜኮ ሞርካ ዖሎና ኩዳንዳያ ማዒፃ ኬኤዚንቴሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 12:1"/>ጫሪንጮ ዼጊዲ ዳሬሢ፥ ሳዖ ቦኦኮልቂ ማዤሢ፥ ዓሲማኣ ሼምፖ ዑኡሲ ዒንጌ ናንጊና ናንጋ ጎዳሢ ሂዚ ጋዓኔ፦ <verse eid="ZEC 12:1"/><verse number="2" style="v" sid="ZEC 12:2"/>«ዬሩሳላሜ ታኣኒ ዒዞኮ ኮይላ ዓኣ ሜሌ ዴራ ዒዞፓ ዑሽኪ ማሢንታ ዑሺ ዓንጊ ማሃንዳኔ፤ ዬሩሳላሜ ዖላ ዓሳ ሙኪ ማንጋኣና ዪሁዳኣ ማንጊንታንዳኔ። <verse eid="ZEC 12:2"/><verse number="3" style="v" sid="ZEC 12:3"/>ዬኖ ኬሎና ዬሩሳላሜ ታኣኒ ዴሮ ቢያሢም ዓጊፁዋ ዼኤፒ ላሌ ማሃንዳኔ፤ ዒዞ ቡጊ ሺኢሻኒ ኮዓይ ቢያ ፔኤሮ ማኣሳናንዳኔ፤ ዓጮ ቢያይዳ ዓኣ ዴራ ጉቤ ዒዞ ዖላኒ ሙካንዳኔ፤ <verse eid="ZEC 12:3"/><verse number="4" style="v" sid="ZEC 12:4"/>ዒማና ታኣኒ ፓራሢ ቢያ ዲቃሣንዳኔ፥ ፓራሢ ቶጊ ዖላ ዓሶዋ ታኣኒ ዣኣሻንዳኔ፤ ፓራሢኮ ታኣኒ ዓኣፖ ባይዛንዳኔ፤ ጋዓንቴ ዪሁዳ ዴሮ ታኣኒ ታ ዓኣፖና ዛጊ ዛጊ ካፓንዳኔ። <verse eid="ZEC 12:4"/><verse number="5" style="v" sid="ZEC 12:5"/>ዬያሮ ዪሁዳ ዓጮ ሱኡጋ ፔ ዒኖና፦ ‹ቢያ ባኮ ዎይሣ ጎዳ ዔያቶኮ ፆኦዛሢ ማዔሢሮ ዬሩሳላሜይዳ ናንጋ ዒዛ ዴራ ዒዛና ዎልቄ ዴንቃኔ› ጋዓንዳኔ።<verse eid="ZEC 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 12:6"/>«ዬኖ ዓቦ ታኣኒ ዪሁዳ ዴሮ ሱኡጎ ናኣቦይዳ ዳኪ ዔኤሦ ሃንፂሌ፥ ጮኦሪ ጌሦና ናኣራኮ ባኣኪዳ ዓይሢንቴ ኩሻ ማሃንዳኔ፤ ዬያሮ ዔያታ ዔያቶኮ ኮይላ ዓኣ ሜሌ ዴሮ ሙዒ ባይዛንዳኔ፤ ዬሩሳላሜ ዴራ ጋዓንቴ ፔቴታዖ ዔኤቢ ዔያቶ ቆኦዹዋንቴ ካታሞይዳ ኮሺ ዴዓንዳኔ።<verse eid="ZEC 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 12:7"/>«ታኣኒ፥ ናንጊና ናንጋ ጎዳሢ ቤርታሳዖ ዪሁዳ ዴራ ሞርኮ ባሻንዳጉዲ ማሃንዳኔ፤ ታኣኒ ዬያ ማዻንዳሢ ዳውቴ ናኣቶ ቦንቾንታ ዬሩሳላሜይዳ ናንጋ ዴሮኮ ቦንቻ ሃንጎ ዪሁዳ ፃጶይዳፓ ባሼ ማዒ ዼግ ዼጊ ጎውዋጉዲኬ። <verse eid="ZEC 12:7"/><verse number="8" style="v" sid="ZEC 12:8"/>ዬኖ ዎዶና ታኣኒ፥ ናንጊና ናንጋ ጎዳሢ ዬሩሳላሜይዳ ናንጋ ዓሶም ጊቲማ ማዓንዳኔ፤ ዔያቶ ባኣካ ላቤያኬ ጌይንቴሢታዖ ዳውቴጉዲ ዶዲ ማዓንዳኔ፤ ዳውቴ ናኣታ ታና፥ ናንጊና ናንጋ ጎዳሢጉዲ፤ ጊንሣ ሃሣ ፆኦሲ ኪኢታንቻሢጉዲ ሶሮፒ ማዒ ዴሮ ዔኪ ዓኣዻንዳኔ። <verse eid="ZEC 12:8"/><verse number="9" style="v" sid="ZEC 12:9"/>ታኣኒ ዒማና ዬሩሳላሜይዳ ሞርኬ ማዒ ዔቃ ዴሮ ካኣቶ ቢያ ዖላኒ ጊኢጊንቲ ኬስካንዳኔ።<verse eid="ZEC 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 12:10"/>«ዬኖ ዎዶና ታኣኒ ዳውቴ ዜርፆንታ ዬሩሳላሜይዳ ናንጋ ዓሶንታም ሚጪንታ ዓያናና ሺኢጲሢ ዓያና ሚርጊሺ ዒንጋንዳኔ፤ ዬያ ታኣኒ ማዻንዳሢ ሜቴ ናይ፥ ሃሣ ጊንሣ ቶይዲ ናይ ሃይቃዛ ዒናፓ ዬኤኮ ጎይሢ ዔያታ ጫርጌሢ ሚጪንቲ ዬኤካንዳጉዲኬ። <note caller="-" style="x"><char style="xo" closed="false">12፡10 </char><char style="xt" closed="false"><ref loc="JHN 19:37">ዮሃ. 19፡37</ref>፤ <ref loc="REV 1:7">ዮሃ. ፆፔዻ 1፡7</ref>።</char></note> <verse eid="ZEC 12:10"/><verse number="11" style="v" sid="ZEC 12:11"/>ዒማና ዬሩሳላሜይዳ ዬኤኪንታንዳ ዬኤፓ ሜጊዶ ቦኦሎይዳ ሃዳዲሪሞኔ ዬኤኮና ጎይፆጉዲ ማዓንዳኔ። <verse eid="ZEC 12:11"/><verse number="12" style="v" sid="ZEC 12:12"/>ዬኖ ሳዔሎይዳ ፔቴ ፔቴ ቶኦካ ፔ ማኣሮ ዓሶማ ዓሶማ ዬኤካንዳኔ፤ ዓቲንቃ ዒማና ዔያቶኮ ላኣላፓ ዱማዺ ዴይ ዬኤካንዳኔ፤ ያዺዲ ዬኤካንዳ ማኣራ፦ ዳውቴ ማኣሮ፥ ናኣታኣኔ ማኣሮ፥ <verse eid="ZEC 12:12"/><verse number="13" style="v" sid="ZEC 12:13"/>ሌዊ ማኣሮንታ ሺምዒ ማኣሮንታ ፔ ቶኦኮና ቶኦኮና ፓቂንቲ ዬኤካንዳኔ፤ <verse eid="ZEC 12:13"/><verse number="14" style="v" sid="ZEC 12:14"/>ዬያጉዲ ሃንጎ ዓቴ ማኣሮ ዓሳኣ ፓቂንቲ ፓቂንቲ ዬኤካንዳኔ፤ ላኣላ ዔያቶኮ ዱማዺ ዴዒ ዖዪ ዬኤካንዳኔ።» <note caller="-" style="x"><char style="xo" closed="false">12፡14 </char><char style="xt" closed="false"><ref loc="MAT 24:30">ማቲ. 24፡30</ref>፤ <ref loc="REV 1:17">ዮሃ. ፆፔዻ 1፡17</ref>።</char></note><verse eid="ZEC 12:14"/></para>
  <chapter eid="ZEC 12"/>
  <chapter number="13" style="c" sid="ZEC 13"/>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 13:1"/>ቢያ ባኮ ዎይሣ ጎዳሢ ሂዚ ጋዓኔ፦ «ዬኖ ዎዶና ዳውቴ ናኣቶንታ ዬሩሳላሜይዳ ናንጋዞንሢንታም ጎማፓ ዔያቶ ጌኤሻንዳ ዓልቃ ዋኣሢ ዑርታንዳኔ። <verse eid="ZEC 13:1"/><verse number="2" style="v" sid="ZEC 13:2"/>ዓሳ ካኣሽካ ሜሌ ፆኦዞ ሳዖይዳፓ ዒማና ታኣኒ ባይዛንዳኔ፤ ላሚ ዔያቶ ጶቂሣንዳ ዓሲያኣ ባኣሴ፤ ሜሌ ፆኦዞ ማሊፆ ኬኤዛ ዓሶንታ ፑርቶ ዓያኖንታ ታኣኒ ባይዛንዳኔ። <verse eid="ZEC 13:2"/><verse number="3" style="v" sid="ZEC 13:3"/>ዓይጎ ዓሲያኣ ማዖም ታኣኒ ፆኦሲ ማሊሢ ኬኤዛያኬ ጌይ ዔቄቴ፥ ዬያ ዓሢ ሾዔ ዓዶንታ ዒንዶንታ ‹ናንጊና ናንጋ ጎዳ ሱንፆና ሉኡዚ ባኣዚ ኔ ኬኤዜሢሮ ኔኤም ሃይቢ ኮይሳኔ› ጋዓንዳኔ፤ ዒዚ ፆኦሲ ማሊፆ ኬኤዛኔ ጋዓኣና ሾዔ ዓሳ ዒዛ ጫርጊ ዎዻንዳኔ። <verse eid="ZEC 13:3"/><verse number="4" style="v" sid="ZEC 13:4"/>ዬኖ ዎዶና ዓይጎ ዓሲያኣ ማዖም ታኣኒ ፆኦሲ ማሊሢ ኬኤዛኔ ጋዓ ዓሲ ቢያ ዒዛም ፔጋዺ ጴዻ ባኮ ዴንቃዖ ቦርሲንታንዳኔ፤ ዓሶ ጌሻኒ ፆኦሲ ማሊፆ ኬኤዛ ዓሳ ማኣዓ፥ ጋፓኖ ማኣዓሢ ማይንቲ ኬስኪ ዒ ጴዻዓኬ። <verse eid="ZEC 13:4"/><verse number="5" style="v" sid="ZEC 13:5"/>ዒዚ ዒማና፦ ‹ታኣኒ ጎሺ ጎሽካ ዓሲኬ፥ ፆኦሲ ማሊሢ ኬኤዛያቱዋሴ፤ ታኣኮ ዼጋቶ ዎዳፓ ዓርቃዖ ታኣኒ ጎሺ ጎሽኪ ናንጋ ዓሲኬ› ጋዓንዳኔ። <verse eid="ZEC 13:5"/><verse number="6" style="v" sid="ZEC 13:6"/>ፔቴ ዓሲ፦ ‹ሃይ ኔኤኮ ዑፆይዳ ዓኣ ኪፃ ዓይጌ ኪፃሴ ኪሢዳዖ?› ጌይ ዖኦጬቴ፥ ዒዚ፦ ‹ታ ዒጊኒስኬያ ማኣራ ታ ማዻዖ ኪፃዼ ኪሢኬ› ጌይ ማሃንዳኔ።»<verse eid="ZEC 13:6"/></para>
  <para style="s1">ፆኦሲኮ ቆልሞ ሄንቃሢ</para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 13:7"/>ቢያ ባኮ ዎይሣ ጎዳሢ ሂዚ ጋዓኔ፦ «ታኣኮ ጬንቾ ዓፓራሢዮ! ታና ማኣዲ ታ ቆልሞ ሄንቃ ዓሢ ዑፃ ፑርቱሞና ዔቄ! ማራታ ዣኣሊ ዴንዲ ባይቃንዳጉዲ ሄንቃሢ ጫርጊ ዎዼ! ታኣኒያ ዻኮ ዻኮ ቆልሞ ዎዺ ኩርሳንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">13፡7 </char><char style="xt" closed="false"><ref loc="MAT 26:31">ማቲ. 26፡31</ref>፤ <ref loc="MRK 14:27">ማር. 14፡27</ref>።</char></note> <verse eid="ZEC 13:7"/><verse number="8" style="v" sid="ZEC 13:8"/>ዓጮይዳ ዓኣ ዴሮኮ ሃይሦፓ ላምዖ ማዓ ዛላ ጉቤ ሃይቂ ኩዳንዳኔ፤ ያዺ ማዔቴያ ሃይሦፓ ፔቴ ዛላ ማዓይ ሃይቁዋዖ ዓታንዳኔ። <verse eid="ZEC 13:8"/><verse number="9" style="v" sid="ZEC 13:9"/>ዬያቶ ታኣኒ ዓንጊ ታሚዳ ዓጊ ሼኤሺ ኬሶሢጉዲ ታሚዳ ታ ዔያቶ ጌልዚ ዛጋንዳኔ፤ ዎርቄያ ጎኔ ዎርቄ ማዒፃ ዛጊንታሢጉዲ ጎኑሞ ታ ዔያቶኮ ዛጋንዳኔ፤ ዬካፓ ዔያታ ታና ሺኢቃንዳኔ፤ ታኣኒያ ዔያታ ሺኢቃ ባኮ ዔያቶም ዋይዛንዳኔ። ታኣኒ ዔያቶ፦ ‹ታ ዴሬዮ› ጋዓንዳኔ፤ ዔያታኣ ታና፦ ‹ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢዮ› ጋዓንዳኔ።»<verse eid="ZEC 13:9"/></para>
  <chapter eid="ZEC 13"/>
  <chapter number="14" style="c" sid="ZEC 14"/>
  <para style="s1">ዬሩሳላሜና ሜሌ ዓጮ ካኣቶና ዛላ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 14:1"/>ናንጊና ናንጋ ጎዳሢ ዎጎ ዎጋ ኬላ ሄሌኔ፤ ዒማና ዒንሢ ዛጋ ጎይሣ ዓኣንቴ ዒንሢፓ ቡሪ ዔኬ ዓሳ ዔኬ ባኮ ዎሊም ጊሽታንዳኔ። <verse eid="ZEC 14:1"/><verse number="2" style="v" sid="ZEC 14:2"/>ዬሩሳላሜ ዖላንዳጉዲ ናንጊና ናንጋ ጎዳ ሜሌ ዴሮ ዔኤሊ ዔኪ ዬዓንዳኔ፤ ካታሜሎ ዔያታ ዓርቃንዳኔ፤ ኬኤፆዋ ቡራንዳኔ፤ ዒኢካ ዓኣ ላኣሎዋ ዎልቄና ዓርቃንዳኔ፤ ዴሮፓ ሄካሢ ዲዒንቲ ዔውታንዳኔ፤ ዓቴ ዓሳ ጋዓንቴ ካታማፓ ሜሌ ቤሲ ዴንዳዓኬ። <verse eid="ZEC 14:2"/><verse number="3" style="v" sid="ZEC 14:3"/>ዬካፓ ናንጊና ናንጋ ጎዳ ሃያኮ ቤርታ ዖላ ጎይፆ ዬያቶ ሜሌ ዴሮ ዖላኒ ኬስካንዳኔ። <verse eid="ZEC 14:3"/><verse number="4" style="v" sid="ZEC 14:4"/>ዬኖ ዓቦ ናንጊና ናንጋ ጎዳሢ ዬሩሳላሜኮ ዓባ ኬስካ ባንፃ ዓኣ ሪሚቶ ዹካ ኬስኪ ዔቃንዳኔ፤ ዒማና ዬይ ሪሚቶ ዹካ ዓባ ኬስካ ባንፃፓ ዴንዲ ዓባ ጌላ ባንፆ ሄላንዳኣና ዳልጊ ዶኦቺ ማዒ ላምዖ ፓቂንታንዳኔ፤ ዬያሮ ዬያ ዹኮኮ ሄካሢ ኬዶ ዛሎ ባንሢ፥ ዛላ ዾኦሎ ዛሎ ባንሢ ዶጫንዳኔ። <verse eid="ZEC 14:4"/><verse number="5" style="v" sid="ZEC 14:5"/>ዹኮ ዬያይዲ ላምዖ ፓቂ፥ ዴንዲ ዓፃሌ ሄሌ፥ ዬያ ዶኦጮና ፑኒ ቶሊ ዒንሢ ዴንዳንዳኔ፤ ዪሁዳ ካኣቲ ዖኦዚያ ዎዶይዳ ሳዓ ዓጊፄያና ዒንሢኮ ቤርታኣ ዓዶንሢ ፑኒ ዴንዴ ጎይፆ ዒንሢ ፑኒ ዴንዳንዳኔ፤ ናንጊና ናንጋ ጎዳ ማዔ ታ ፆኦዛሢ ጌኤዦ ዓሶ ፔኤና ዎላ ዔኪ ዬዓንዳኔ።<verse eid="ZEC 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 14:6"/>ዬኖ ኬሎ ሳዖ ሻኣሬ ዓርቄጉዲ ፖዓ ጌኤሽኪ ፖዓዓኬ። <verse eid="ZEC 14:6"/><verse number="7" style="v" sid="ZEC 14:7"/>ዬና ኬላ ፖዒያ ፖዒ፥ ዹሚያ ዹሚ ጋዓ ባኣዚ ባኣያ ፔቴ ዱማ ኬሊ ማዓንዳኔ፤ ዬና ኬላ ናንጊና ናንጋ ጎዳ ዔሬ ኬሊ ማዓንዳኔ፤ ዹማዛኣ ፖፖዓ ኬሊ ማዓንዳኔ።<verse eid="ZEC 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 14:8"/>ዬኖ ዓቦ ዬሩሳላሜፓ ጌኤሺ ዋኣሢ ዓልቃንዳኔ፤ ዬያ ዋኣፆኮ ዛላ ዓባ ኬስካ ባንፃ ዓኣ ዼኤፖ ባዞይዳ፥ ዛላ ጊንሣ ዓባ ጌላ ባንፃ ዓኣ ሜድቴራኒያ ባዞይዳ ዓኣዺ ጌላንዳኔ፤ ዖጎፆናኣ ማዖም ባርጎና ቢያ ዎዴ ዬይ ዎራ ጎዔ ጎይሣ ዴዓንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">14፡8 </char><char style="xt" closed="false"><ref loc="EZK 47:1">ሂዚ. 47፡1</ref>፤ <ref loc="JHN 7:38">ዮሃ. 7፡38</ref>፤ <ref loc="REV 22:1">ዮሃ. ፆፔዻ 22፡1</ref>።</char></note> <verse eid="ZEC 14:8"/><verse number="9" style="v" sid="ZEC 14:9"/>ዬኖ ዎዶና ናንጊና ናንጋ ጎዳ ቢያ ዓጮይዳ ካኣታዻንዳኔ፤ ዓሲ ቢያ ዒዚ ሌሊ ፆኦሲ ማዔሢ ጉሙርቂ ዔካንዳኔ፤ ዒዛ ሱንፆዋ ሌሊ ዔኤሊ ካኣሽካንዳኔ።<verse eid="ZEC 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 14:10"/>ዓጮኮ ኬዶ ዛላ ዓኣ ጌባዔይዳፓ ዓርቃዖ ዴንዲ ዬሩሳላሜኮ ዾኦሎ ዛሎና ጌይ ዴንዲ ሪሞኦኔ ሄላንዳኣና ዓኣ ዓጫ ቢያ ቦኦሊ ማዓንዳኔ፤ ዬሩሳላሜ ኮይሎይዳ ዓኣ ዓጮፓ ዑሣ ሌካ ዼግ ጋዓንዳኔ፤ ካታሜላ ቢኢኒያሜ ካራፓ ዴንዲ ቤርታኣ ካሮ ዛሎይዳ ዓኣ ላምዖ ዲፃ ዎላ ካኣማ ካሮ፤ ዬያጉዲ ሃናኒዔኤሌ ኬኤሎ ዲፃፓ ዴንዲ ካኣቱሞ ማኣሮኮ ዎይኖ ዑዦ ጩኡጶ ቤዞ ሄላንዳኣና ዼግ ዼጊ ጌይ ዶዲ ዴዓንዳኔ። <verse eid="ZEC 14:10"/><verse number="11" style="v" sid="ZEC 14:11"/>ዬሩሳላሜ ዓሲ ናንጋ ቤሲ ማዓንዳኔ፤ ሃይካፓ ሴካ ዒዞይዳ ባይሲንታ ኬዳዓኬ፤ ዒኢካ ናንጋ ዴራኣ ሂርጋ ባኣያ ሃውሺ ናንጋንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">14፡11 </char><char style="xt" closed="false"><ref loc="REV 22:3">ዮሃ. ፆፔዻ 22፡3</ref>።</char></note><verse eid="ZEC 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 14:12"/>ዬሩሳላሜ ዖላኒ ዔቃ ዴሮይዳ ናንጊና ናንጋ ጎዳ ዎዺ ኩኩርሳ ዶርዖ ዓጋንዳኔ፤ ሼምፔና ዔያታ ዓኣንቴ ዑፃ ዓኣ ዓሽካ ዔያቶኮ ሙርዓንዳኔ፤ ዓኣፓ ዔያቶኮ ዴዒ ዓኣ ዔቶይዳ ዒኢካ ዎዓንዳኔ፤ ዒንዲርዛኣ ዻንጎ ጋራ ዓኣዖ ሙርዓንዳኔ።<verse eid="ZEC 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEC 14:13"/>ዬኖ ዎዶና ናንጊና ናንጋ ጎዳ ካራ ባይዛ ሜቶና ዒጊቹሞና ዓሶይዳ ዳካንዳሢሮ ፔቴይ ባጋሢዳ ሞርኬ ማዒ ዔቂ ዎሊ ዎዻንዳኔ። <verse eid="ZEC 14:13"/><verse number="14" style="v" sid="ZEC 14:14"/>ዪሁዳ ዴራ ዬሩሳላሜ ዓውሳኒ ዖላንዳኔ፤ ኮይሎይዳ ዓኣ ሜሌ ካኣቶኮዋ ቆሎ ቢያ ዲዒ ዔካንዳኔ፤ ዔያታ ዲዒ ዔካ ባኮይዳ ዎርቄ፥ ቢራንታ ማኣዖኮዋ ዱማ ዱማ ቶኦኪ ዺቢ ዓኣያ ማዓንዳኔ።<verse eid="ZEC 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ZEC 14:15"/>ዬያጉዴ ዎዺ ኩርሳ ዶርዓ ሞርኮ ጉርዶይዳ ዓኣ ዱማ ዱማ ቆልሞ፥ ፓራሢ፥ ባቁሎ፥ ጋኣላሢንታ ሃሮንታ ቢያ ኬዲ ዎዻንዳኔ።<verse eid="ZEC 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ZEC 14:16"/>ዬሩሳላሜ ዖሌ ካኣቶፓ ባይቁዋዖ ቶሊ ዓቴ ካኣታ ዉልሾ ዴማ ዴዒ ቦንቾ ቦንቾ ቦንቻኒና ቢያ ባኮ ዎይሣ ጎዳሢ ዚጊ ካኣሽካኒ ሌዓ ሌዓ ዬሩሳላሜ ሙካንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">14፡16 </char><char style="xt" closed="false"><ref loc="LEV 23:39-43">ሌዊ. ዓኬ 23፡39-43</ref>።</char></note> <verse eid="ZEC 14:16"/><verse number="17" style="v" sid="ZEC 14:17"/>ካኣታሢ፥ ቢያ ባኮ ዎይሣ ጎዳሢ ዚጊ ካኣሽካኒ ዬሩሳላሜ ሙኩዋ ዴሬ ዓኣቶ ዔያቶኮ ሳዖይዳ ዒርዚ ዋርቂንዱዋሴ። <verse eid="ZEC 14:17"/><verse number="18" style="v" sid="ZEC 14:18"/>ጊብፄ ዓጮ ዓሳ ዬያ ቦንቾ ቦንቻኒ ዬሩሳላሜ ሙኪ፥ ናንጊና ናንጋ ጎዳ ቤርቶ ሺኢካኒ ኮይባኣቶ «ዬሩሳላሜ ኑኡኒ ዴንዲ፥ ዉልሾ ዴማ ዴይ ቦንቾ ቦንቾ ቦንቻዓ» ጋዓ ካኣቶይዳ ኬዴ ዎዺ ኩርሳ ዶርዓሢ ዔያቶይዳኣ ኬዳንዳኔ። <verse eid="ZEC 14:18"/><verse number="19" style="v" sid="ZEC 14:19"/>ጊብፄ ዓጮ ዓሶ ማዔቴያ ሜሌ ካኣታ «ዉልሾ ዴማ ዴይ ቦንቾ ቦንቾ ኑ ቦንቻዓ» ጌኤቴ ዔያቶይዳ ሙካንዳ ሜታ ዬያኬ።<verse eid="ZEC 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ZEC 14:20"/>ዬኖ ዓቦ ፓራሢኮ ሉኡሎ ኬኤፆይዳ ቱኪንታ ሉኡሎይዳ ቢያ «ናንጊና ናንጋ ጎዳሢም ዱማዼያ» ጋዓ ፃኣፒንቴ ባኣዚ ኮሺንታዳኔ፤ ጌኤዦ ማኣሮይዳ ዓሽኮ ካሦ ዖታ ፆኦሲም ዒንጎ ባኮ ዒንጎ ቤዞይዳ ዓኣ ዓንጎ ሳኣኖጉዲ ናንጊና ናንጋ ጎዳም ዱማዼያ ማዓንዳኔ። <verse eid="ZEC 14:20"/><verse number="21" style="v" sid="ZEC 14:21"/>ዬሩሳላሜና ዪሁዳ ዓጮናይዳ ዓኣ ዓሽኮ ካሦ ዖታ ቢያ፥ ቢያ ባኮ ዎይሣ ጎዳሢም ዱማዼያ ማዓንዳኔ፤ ፆኦሲም ዒንጎ ባኮ ዔኪ ሺኢሻ ዓሳ ቢያ ዬያ ዖቶ ዔኪ ዔኪ ዓሽኮ ካሣንዳኔ፤ ዬይ ያዺ ማዓኣና ቢያ ባኮ ዎይሣ ጎዳሢኮ ጌኤዦ ማኣሮይዳ ካኣናኔ ዓሲ<note caller="+" style="f"><char style="fr" closed="false">14፡21 </char><char style="fq" closed="false">ካኣናኔ ዓሲ፦ </char><char style="ft" closed="false">ጋዓዞ ፔቴ ፔቴ ማፃኣፓ ኮርሞ ኮርማ ዓሲ ጋዓኔ።</char></note> ባኣያ ማዓንዳኔ።<verse eid="ZEC 14:21"/></para>
  <chapter eid="ZEC 14"/>
</usx>
