<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- MAALE Full Bible</book>
  <para style="h">ናሆኦሜ ማፃኣፖ</para>
  <para style="toc1">ፆኦሲ ማሊፆ ኬኤዛ ናሆኦሜ ማፃኣፖ</para>
  <para style="toc3">ናሆ.</para>
  <para style="toc2">ናሆኦሜ ማፃኣፖ</para>
  <para style="mt1">ናሆኦሜ ማፃኣፖ</para>
  <para style="imt">ዓይፆ ካሮ</para>
  <para style="ip">ፆኦሲ ማሊፆ ኬኤዛ ናሆኦሜ ማፃኣፓ ሚናፓ ዓርቃዖ ዒስራዔኤሌኮ ሞርኬ ማዒ ናንጌ ዓሶኦሬ ካታሞኮ ዶዒ ባይቂፆ ኬኤዛ ካላሊ ዓርቄያኬ፤ ኔኔዌ ዓሶኦሬኮ ዔርቴ ዼኤፒ ካታማኬ። ኔኔዌ ካታማ ኪሪስቶሴ ሾይንታንዳሢኮ ቤርታ ላንካሳ ፄኤቶ ሌዖኮ ጋፒንፆይዳ ሻሂንቲ ባይቄኔ፤ ዬኖ ካታሞኮ ዬያይዲ ባይቂፃ ዋይዞ ዒፃ ፑርቶ ዓሶንታ ዖቶርቃ ዓሶንታይዳ ፆኦሲ ዎያጉዴ ሜቶ ዓጋቴያ ፔጋሲ ዻዋያኬ።</para>
  <para style="iot">ማፃኣፔላ ዱማ ዱማ ዓርቄ ባኮ</para>
  <para style="io1">ፆኦሲኮ ዒጊቻ ዻጎ (1፡1-6)</para>
  <para style="io1">ዓሶኦሬይዳ ዓጎና ፑርቶ ባካ ዒስራዔኤሌ ዴሮም ሃጊ ማዓ ዎዛ ጴዺሼሢ (1፡7-15)</para>
  <para style="io1">ኔኔዌ ካታሞኮ ዶዒ ባይቂፆ (2፡1—3፡19)</para>
  <chapter number="1" style="c" sid="NAM 1"/>
  <para style="s1">ናንጊና ናንጋ ጎዳኮ ታሞጉዴ ዻጎ</para>
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1"/>ኔኔዌ ባይቃንዳያ ማዒፆ ዔልቆሻ ዓጮ ዓሢ፥ ናሆኦሜም ፆኦሲ ፔጋሲ ዻዌ ባካ ሃካፓ ሊካ ኬኤዚንታ ጎይፆጉዴያኬ። <note caller="-" style="x"><char style="xo" closed="false">1፡1—3፡19 </char><char style="xt" closed="false"><ref loc="ISA 10:5-34">ዒሲ. 10፡5-34</ref>፤ <ref loc="ISA 14:24-27">14፡24-27</ref>፤ <ref loc="ZEP 2:13-15">ሶፖ. 2፡13-15</ref>።</char></note><verse eid="NAM 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 1:2"/>ናንጊና ናንጋ ጎዳ ዒዛፓ ሜሌ ካኣሽኪንታንዳጉዲ ኮዑዋያ</para>
  <para style="q2" vid="NAM 1:2">ዒዛኮ ሞርኮ ኮሜ ኮፃ ፆኦሲኬ፤</para>
  <para style="q2" vid="NAM 1:2">ፔኤኮ ዼኤፖ ዻጎና ሞርኮይዳ ፑርታ ባኣዚ ዓጋያኬ።<verse eid="NAM 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 1:3"/>ናንጊና ናንጋ ጎዳ ቲኢራያ፥ ሃሣ ዎልቄና ዓኣያኬ፤</para>
  <para style="q2" vid="NAM 1:3">ያዺ ማዔቴያ ዻቢንቴሢዳ ሜቶ ዓጉዋዖ ሃሹዋሴ።</para>
  <para style="q" vid="NAM 1:3">ዒዚ ሃንታሢ ዓልጋሢ ዢባሮና ባዞ ጉዳሢናኮ ባኣካኣኬ፤</para>
  <para style="q2" vid="NAM 1:3">ዓሲ ሃንታዖ ሲላሊ ዔቂሳሢጉዲ</para>
  <para style="q2" vid="NAM 1:3">ናንጊና ናንጋ ጎዳ ሃንታዖ ሻኣሮ ዔቂሳኔ።<verse eid="NAM 1:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="NAM 1:4"/>ናንጊና ናንጋ ጎዳ ዼኤፖ ባዞንታ ዎሮንታ</para>
  <para style="q2" vid="NAM 1:4">ሚጫንዳጉዲ ዓይሢ ሚሚጪሳኔ።</para>
  <para style="q" vid="NAM 1:4">ባኣሳኣኔና ቄርሜሎሴናይዳ ዓኣ ካያ ሜሌኔ፤</para>
  <para style="q2" vid="NAM 1:4">ሊባኖኦሴይዳ ዓኣ ቡናኣ ሹሊ ዲኢኔኔ።<verse eid="NAM 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 1:5"/>ናንጊና ናንጋ ጎዳ ቤርቶይዳ ዹካ ጎጎይቃኔ፤</para>
  <para style="q2" vid="NAM 1:5">ጌሜራኣ ዓልቂ ዋኣሢ ማዓኔ።</para>
  <para style="q" vid="NAM 1:5">ናንጊና ናንጋ ጎዳ ቤርቶይዳ ሳዓ ዓዓጊፃኔ፤</para>
  <para style="q2" vid="NAM 1:5">ሳዖንታ ዒኢካ ዓኣ ባካኣ ቢያ ጎጋይቃኔ።<verse eid="NAM 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 1:6"/>ዒዛኮ ዼኤፖ ዻጎ ቤርታ ዖኦኒ ጫርቂ ዔቃንዳይ?</para>
  <para style="q2" vid="NAM 1:6">ዻጋ ዒዛኮ ታሚጉዲ ዔኤታኣና ዖ ዳንዳዓይ?</para>
  <para style="q" vid="NAM 1:6">ታሚጉዲ ሙሙዓ ዻጋ ዒዛኮ ሎኦፓ ኬዳኣና</para>
  <para style="q2" vid="NAM 1:6">ላላ ፃሂ ፃሂ ቡርሺንታኔ።<verse eid="NAM 1:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="NAM 1:7"/>ናንጊና ናንጋ ጎዳ ኮሺ ፆኦሲኬ፤</para>
  <para style="q2" vid="NAM 1:7">ሜቶ ዎዴና ፑኖ ካይዚ ዶዲኬ፤</para>
  <para style="q2" vid="NAM 1:7">ዒዛ ጉሙርቃዞንሢኮ ቶኦኮ ዛጊ ዒዚ ማኣዳኔ።<verse eid="NAM 1:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 1:8"/>ዒዛ ማካ ዓሶ ዼኤፒ ዲጲና ዱኡኪ ዒ ባይዛኔ፤</para>
  <para style="q2" vid="NAM 1:8">ዒዛኮ ሞርኮዋ ዹሚዳ ዳውሲ ጌልዛኔ።<verse eid="NAM 1:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 1:9"/>ናንጊና ናንጋ ጎዳም ጌኔ ማሊሢ ዒንሢ ዓይጎሮ ማላይ?</para>
  <para style="q2" vid="NAM 1:9">ዒዚ ዒንሢ ጋፒ ቲፂዲ ባይዛንዳኔ፤</para>
  <para style="q2" vid="NAM 1:9">ላሚ ዒንሢ ዬያጉዴ ባኣዚ ፔቴታዖ ማዻኒ ዳንዳዑዋሴ።<verse eid="NAM 1:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 1:10"/>ዒንሢ ሃይ ማሢንቴ ዓሳ!</para>
  <para style="q2" vid="NAM 1:10">ዎሊ ማሪ ዓርቄ ዓንጊሢና ቡኡራና</para>
  <para style="q2" vid="NAM 1:10">ታሚ ሙይ ባይዛሢጉዲ</para>
  <para style="q2" vid="NAM 1:10">ያዺዲ ዒንሢ ሙይንቲ ባይቃንዳኔ።<verse eid="NAM 1:10"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="11" style="v" sid="NAM 1:11"/>ኔኔዌ ዴሬዮቴ! ናንጊና ናንጋ ጎዳም ፑርታ ማሊሢ ማላያ፤ ሃሣ ፑርታ ዞሮ ዞራ ዓሲ ዒንሢ ባኣካ ኬስኬኔ። <verse eid="NAM 1:11"/><verse number="12" style="v" sid="NAM 1:12"/>ናንጊና ናንጋ ጎዳ ፔ ዴሮ ዪሁዳም ሂዚ ጋዓኔ፦ «ዓሶኦሬ ዓሳ ዎልቄና፥ ሃሣ ፓይዳኣ ዔያቶኮ ሚርጌታቴያ ዲርካቺንቲ ቤሲ ዔያታ ባይቃንዳኔ። ታ ዴሬዮቴ! ሃያኮ ቤርታ ዒንሢዳ ሜቶ ታኣኒ ዺቢሼያ ማዔቴያ ሃይካፓ ሴካ ታኣኒ ዬያይዳዓኬ። <verse eid="NAM 1:12"/><verse number="13" style="v" sid="NAM 1:13"/>ዓሶኦሬ ዓሳ ዒንሢ ሄርቂ ዎይሣ ዎይሢፆ ታኣኒ ሃሺሳንዳኔ፤ ዒንሢኮ ዔያታ ቶኮ ቱኬ ዱፃሢ ታኣኒ ሜንሣንዳኔ።»<verse eid="NAM 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NAM 1:14"/>ናንጊና ናንጋ ጎዳ ዓሶኦሬ ዓሶይዳ ዎጌ ዎጊፃ ያዺኬ፦ «ሃይካፓ ሴካ ሱንፆ ዒንሢኮ ዔኤሊሳንዳ ዜርሢ ባይቃንዳኔ፤ ዒንሢ ካኣሽካ ፆኦዞ ማኣሮይዳ ዱማ ዱማ ዓርሲ ኮሾና ባኮንታ ዓንጎ ሼኤሺ ኮሾና ፆኦዞዋ ታኣኒ ባይዛንዳኔ፤ ዒንሢያ ፓሡዋ ዴሬ ማዔሢሮ ዱኡፒ ዔቴ ታኣኒ ዒንሢም ቦኦካንዳኔ።» <verse eid="NAM 1:14"/><verse number="15" style="v" sid="NAM 1:15"/>ሃይሾ ሃሢ ኮሺ ሃይሴ ኬኤዛያ፥ ኮሹሞ ዓኣያ ማዒፆ ዒላቲ ኬኤዛ ኪኢታ ዓሲ ዹኮ ዑፆ ዬይ ዬይኬ፤ ዪሁዳ ዴሬዮቴ! ፑርቶ ማዔ ኔኤኮ ሞርካ ጋፒ ዲርካቺንቴሢሮ ሃይካፓ ሴካ ኔኤኮ ዓጮ ዔያታ ሙኪ ፔቴታዖ ዓርቃዓኬ! ዬያሮ ሌዓ ሌዓ ኔኤኒ ቦንቻ ቦንቾ ዎዛና ቦንቼ! ኔኤኒ ናኣቤ ናኣቦዋ ፆኦሲም ዒንጌ! <note caller="-" style="x"><char style="xo" closed="false">1፡15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">ዒሲ. 52፡7</ref>።</char></note><verse eid="NAM 1:15"/></para>
  <chapter eid="NAM 1"/>
  <chapter number="2" style="c" sid="NAM 2"/>
  <para style="s1">ኔኔዌኮ ሎኦሚፆ</para>
  <para style="q">
    <verse number="1" style="v" sid="NAM 2:1"/>ኔኔዌ! ኔጊዳ ሜታ ዬዔኔ!</para>
  <para style="q2" vid="NAM 2:1">ዬያሮ ኔኤኮ ዋርዲዮ ኬኤሎ ዲፆ ዶዲሼ!</para>
  <para style="q" vid="NAM 2:1">ዚጊሮ ጎይፆ ቢያ ዛጊ ካፔ! ዖልዚ ዓንጋሞ ዓርቂ ጊኢጌ!</para>
  <para style="q2" vid="NAM 2:1">ዓኣ ዎልቆ ኔኤኮ ቢያ ቡኩሲ ዶዲሼ!<verse eid="NAM 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 2:2"/>ሞርካ ዔያቶንታ ዔያቶኮ ዓኣ ባኮንታ</para>
  <para style="q2" vid="NAM 2:2">ዲርካቺ ባይዚ ኩርሴታቴያ</para>
  <para style="q" vid="NAM 2:2">ናንጊና ናንጋ ጎዳ ያይቆኦቤ ናኣቶ ማዔ</para>
  <para style="q2" vid="NAM 2:2">ዒስራዔኤሌ ጊንሣ ማሂ ቦንቺሳንዳኔ።<verse eid="NAM 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 2:3"/>ዖሎ ዓሳ ዞቄ ዞቄ ጊቲማ ዔኪ ዓኣኔ፤</para>
  <para style="q2" vid="NAM 2:3">ዔያታ ማኣዔ ማኣዓሢያ ዞቄ ዲንኪኬ፤</para>
  <para style="q2" vid="NAM 2:3">ዒዚ ዔያቶ ዖሎሮ ኬሳዛ ሳርጌሎ ዖይታ ዓኣፓ ዱዱካያኬ፤</para>
  <para style="q2" vid="NAM 2:3">ፓራሢና ዖላ ዓሳኣ ፓራሢዳ ዴዒ ዖሎሮ ዓፃዺ ዋኣጪንታኔ።<verse eid="NAM 2:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="NAM 2:4"/>ሳርጌሎ ዖይታ ዢባሬጉዲ ጎይፆይዳ ዎላ ሄሌሎ ጳሽካኔ፤</para>
  <para style="q2" vid="NAM 2:4">ጶኦኮይዳ ሴካ ሃንጋ ዣኣቂ ሺራኔ፤</para>
  <para style="q" vid="NAM 2:4">ዔዔኤታ ታሚ ማላኔ፤</para>
  <para style="q2" vid="NAM 2:4">ዜኤሊንሢጉዲያኣ ዡኡዣኔ።<verse eid="NAM 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 2:5"/>ዒዚ ፔኤኮ ዖሎ ዓሶ ዓይሣ ቢቶ ዔኤላኔ፤</para>
  <para style="q2" vid="NAM 2:5">ዔያታኣ ዹቂንቲ ሎኦሚ ሎኦሚ ዬዓኔ፤</para>
  <para style="q2" vid="NAM 2:5">ሞርኮኮ ዖሎ ዓሳ ጳሽኪ ጳሽኪ</para>
  <para style="q2" vid="NAM 2:5">ካታሞኮ ዙሎ ኬልቂ ዲርቆና ዲፆ ባንሢ ጳሽካኔ፤</para>
  <para style="q2" vid="NAM 2:5">ዱኪንታ ሂኢዦ ዔያታ ፔኤኮ ዼኤፖ ጊቲሞና</para>
  <para style="q2" vid="NAM 2:5">ዔያቶ ዓይዱዋጉዲ ቃዛኔ።<verse eid="NAM 2:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="NAM 2:6"/>ዎሮ ዛሊና ዓኣ ካታሞ ጌሎ ካራ</para>
  <para style="q2" vid="NAM 2:6">ሜኤሊዮ ጌይ ፖዒ ቡሊንቴኔ፤</para>
  <para style="q2" vid="NAM 2:6">ካኣቱሞ ማኣሮይዳ ዓኣ ዓሶማኣ ካራ ባይቄኔ።<verse eid="NAM 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 2:7"/>ኔኔዌ ዻውሲንቴኔ፥ ጌኤሻ ዲዒንቲ ዔውቴኔ፤</para>
  <para style="q2" vid="NAM 2:7">ዒዞም ማዾ ማዻ ላኣላ ኩኡኬ ዑኡሲና</para>
  <para style="q2" vid="NAM 2:7">ዳዶዋ ፔኤኮ ዱሊ ዱሊ ዒላቲ ቃያኔ።<verse eid="NAM 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 2:8"/>ኔኔዌ ሚናፓ ዴዴዔ ቦቆሊ ዋኣሢኬ፤</para>
  <para style="q2" vid="NAM 2:8">ሃሢ ዒኢካፓ ኬስኪ ሾኦቲ ዴንዳኣና</para>
  <para style="q2" vid="NAM 2:8">«ዔቁዋቴ! ዔቁዋቴ!» ዓሲ ጌዔም ሺሪ ሺሪ ዛጋዓኬ።<verse eid="NAM 2:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="NAM 2:9"/>ካታሞይዳ ዓኣ ባካ ጋፓ ባኣዚቱዋሴ፤</para>
  <para style="q2" vid="NAM 2:9">ሚዛጶ ሹጮኮ ሚርጉማ ሃይማኬ ጌይንታያቱዋሴ፤</para>
  <para style="q2" vid="NAM 2:9">ዬያሮ ዴንዲ ቢሮ ዓንጎንታ ዎርቆንታ ቡሪ ዔኩዋቴ።<verse eid="NAM 2:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="NAM 2:10"/>ኔኔዌ ዲርካቺንቲ ባይቄኔ፤</para>
  <para style="q2" vid="NAM 2:10">ቤሲ ባይቂያ ዶዔኔ፤</para>
  <para style="q2" vid="NAM 2:10">ዓሶኮ ጎጳ ዒጊጪ ዋኣፄኔ፤</para>
  <para style="q2" vid="NAM 2:10">ዬያ ዒጊቹማፓ ዔቄያና ዎልቃ ዔያቶኮ ጌሌኔ፤</para>
  <para style="q2" vid="NAM 2:10">ዓሲ ቢያ ዒጊጪ ጎጋይቄኔ፤</para>
  <para style="q2" vid="NAM 2:10">ዓሶ ቢያሢኮ ዓኣፖ ካራ ቦኦሪ ሜሌ ማዔኔ።<verse eid="NAM 2:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="NAM 2:11"/>ሚርጌ ዞቢ ናንጋ ቤሲ</para>
  <para style="q2" vid="NAM 2:11">ሃጊ ዔቃ ዞቦ ናኣታ ሙዖ ሙዓ ቤሲ</para>
  <para style="q2" vid="NAM 2:11">ዓዶንታ ዒንዶ ዞቦንታ ፔኤኮ ናኣቶና ዎላ</para>
  <para style="q2" vid="NAM 2:11">ሂርጋ ባኣያ ላሂ ዓማሊ ሺራ ቤሲ ማላ</para>
  <para style="q2" vid="NAM 2:11">ዬና ካታሜላ ሃሢ ዎካዳዖ?<verse eid="NAM 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="NAM 2:12"/>ዞባሢ ፔኤኮ ናኣቶም ጊዳንዳያ ኬሚ ዎዺ ዔኪ ዬዔኔ፤</para>
  <para style="q2" vid="NAM 2:12">ዞቦ ዒንዴሎማኣ ሙዖንዶያ ዔኪ ሙኬኔ፤</para>
  <para style="q2" vid="NAM 2:12">ዒኢካ ዔያታ ናንጋ ቤዞ ኬሚ ዎዾና ቦዖና</para>
  <para style="q2" vid="NAM 2:12">ዴኖ ዔቶዋ ሾኦሊ ሾኦሊ ላኣሎና ዓሽኪና ዒ ኩንሤኔ።<verse eid="NAM 2:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="NAM 2:13"/>ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢ፦ «ኔኔዌ! ታ ኔና ባይዛኒ ዔቄኔ፤ ሳርጌሎ ዖይቶዋ ታኣኒ ኔኤኮ ሚቻንዳኔ፤ ሃጊ ዔቃ ዞቦ ናኣቶዋ ጬንቻ ዓራፖ ዎዻንዳኔ፤ ሳዖይዳ ኔኤኒ ዖሊ ባሻንዳ ዓሲ ባኣያ ታኣኒ ማሃንዳኔ፤ ኔኤኒ ዳካ ኪኢቶ ዓሶኮዋ ዑኡሲ ሃይካፓ ሴካ ዋይዚንታዓኬ» ጋዓኔ።<verse eid="NAM 2:13"/></para>
  <chapter eid="NAM 2"/>
  <chapter number="3" style="c" sid="NAM 3"/>
  <para style="q">
    <verse number="1" style="v" sid="NAM 3:1"/>ሱጉሢ ዓሲ ሌሊ ማዔ ካታሜሎ</para>
  <para style="q2" vid="NAM 3:1">ሉኡዙሞና ጌሺሢና ጋፒ ዔርቴያ ማዔዜሎ</para>
  <para style="q2" vid="NAM 3:1">ቡሪሢና ዔኤቢ ዲዒ ዲዒ ዔኪ ፔ ጋሮ ኩንሤዜሎ</para>
  <para style="q2" vid="NAM 3:1">ኔኔዌ ካታሜሎም ባዴዔ!<verse eid="NAM 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 3:2"/>ዢራፓ ዑኡሲንታ ሳርጌሎ ዖይቶኮ ሺራ ቶኮ ዑኡሲንታ</para>
  <para style="q2" vid="NAM 3:2">ፓሮ ካኣኒንታ ሳርጌሎ ዖይታ ዋይዚሳ ዑኡሲንታ ዒኢካ ዋይዚንታኔ።<verse eid="NAM 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 3:3"/>ፓራሢና ዖላ ዓሳ ዖሎሮ ኬስካኣና</para>
  <para style="q2" vid="NAM 3:3">ፖፖዓ ጬንቾ ዓራፖንታ ዎርሢንታ ዔኪ ዓኣኔ፤</para>
  <para style="q2" vid="NAM 3:3">ሚርጌ ዓሲ ሃይቂ ኩሜሢሮ</para>
  <para style="q2" vid="NAM 3:3">ሌዛ ሳዖይዳ ኩሊንቴኔ፤</para>
  <para style="q2" vid="NAM 3:3">ሌዛ ኮሺ ሚርጌሢሮ</para>
  <para style="q2" vid="NAM 3:3">ዒኢና ዓኣዻ ዓሶ ቢያ ዹቂ ሎንሣያ ማዔኔ።<verse eid="NAM 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 3:4"/>ዬይ ያዺ ማዔሢ ዳምቤባኣ ጎይሢ ዞኦዛ ኮኦማ ላኣሌሎ ዛላናኬ፤</para>
  <para style="q2" vid="NAM 3:4">ዒዛ ፔኤኮ ማርሾና</para>
  <para style="q" vid="NAM 3:4">ጊንሣ ሃሣ ሚዛጱሞና ዞኦዛ ኮኦሚፆ ማዾና ዴሮ ጌሺ ዲዒ ዔካኔ።<verse eid="NAM 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 3:5"/>ቢያ ባኮ ዎይሣ ጎዳ ሂዚ ጋዓኔ፦</para>
  <para style="q2" vid="NAM 3:5">«ዔናኣ፥ ታ ኔጊዳ ሞርኬ ማዒ ዔቄኔ፤</para>
  <para style="q2" vid="NAM 3:5">ቡዶ ታ ኔኤኮ ሌካ ዔኪ ዓኣፖ ካሮ ካንቂሳንዳኔ፤</para>
  <para style="q2" vid="NAM 3:5">ሜሌ ዴራ ኔኤኮ ካሉሞ</para>
  <para style="q2" vid="NAM 3:5">ዱማ ዱማ ካኣታኣ ፆኦዛ ማዤ ዑፆ ኔኤኮ ዴንቃንዳኔ።<verse eid="NAM 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 3:6"/>ቡኡራ ላኣሎ ቤሲ ታ ኔና ማሃንዳኔ፤</para>
  <para style="q2" vid="NAM 3:6">ቦሂ ታ ኔና ዛጋንዳኔ፤</para>
  <para style="q2" vid="NAM 3:6">ዓሲ ቢያ ኔና ሚኢጪ ዓማላንዳጉዲ ታ ማሃንዳኔ።<verse eid="NAM 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 3:7"/>ኔና ዛጋ ዓሲም ቢያ ዑስካ ጌሌም፦</para>
  <para style="q2" vid="NAM 3:7">‹ኔኔዌ ካታማ ዶዒ ቤሲ ባይቄኔ፤</para>
  <para style="q2" vid="NAM 3:7">ዒዞ ዖኦኒ ዖዪ ዬኤካንዳይ?›</para>
  <para style="q2" vid="NAM 3:7">ዒዞ ዶዲሻንዳ ዓሲያኣ ዓንካፓ ጴዻንዳይ?» ጋዓንዳኔ።<verse eid="NAM 3:7"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="8" style="v" sid="NAM 3:8"/>ዔዞ ኔኔዌ! ኔኤኮ ሞርኬ ቃዛ ባዚ ዓኣሢጉዲ ዓባዬ ዎሮ ዓጫ ዓኣ፥ ኮይላ ጉቤ ዋኣሢ ሌሊ ማዔ፥ ዼኤፖ ባዞ ዋኣፃ ዒዞኮ ሞርኮ ቃዛያ ማዔ ጊብፄ ካታሜሎ ቴቢሴይዳፓ ኔ ዓይጎና ባሻይ? <verse eid="NAM 3:8"/><verse number="9" style="v" sid="NAM 3:9"/>ሃይማኬ ጌይንቱዋ ዎልቃ ዒዞኮ ዒኢካ ጊብፄ ዓጫፓ፥ ሃሣ ጊንሣ ዒቶጲያ ዓጫፓ ዬዓኔ፤ ፑኡፄንታ ሊኢቢያንታ ዒዞና ዎላ ፔቴ ማዒ ዒዞ ማኣዳያኬ። <verse eid="NAM 3:9"/><verse number="10" style="v" sid="NAM 3:10"/>ዬይ ቢያ ያዺታንቴ ቴቢሴ ካታማ ሞርኮና ዓዺንቴም ዴራ ዒዞኮ ዲዒንቲ ዔውቴኔ፤ ዻኮ ናኣታ ዒዞኮ ሹቺዳ ጳዺንቲ ዹኡቂ ጎይፆይዳ ጎይፆይዳ ኬኤሪንቴኔ፤ ሱኡጎዋ ካራሚ ማሂ ዔካኒ ዒፃ ዓጊንቴኔ፤ ቢቶ ቢቶ ዓሳኣ ዓንጊና ቱኡቴኔ።<verse eid="NAM 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NAM 3:11"/>ዔዞ ኔኔዌ! ኔኤኒ ማሢንቲሢና ቡኡዲንቲ ሃንታ ዓሲጉዲ ማዓንዳ ዎዴንታ ኔኤኮ ሞርኮ ቤርታፓ ፑኒ ካይዚ ኔ ጳሽካንዳ ዎዴያኣ ዬዓንዳኔ። <verse eid="NAM 3:11"/><verse number="12" style="v" sid="NAM 3:12"/>ኔኤኮ ዋርዲዮ ማሂ ማዦና ኬኤሎ ዲራ ቢያ ቤርታዺ ካፄ ዓኣፒ ዓርቄ ቤሌሴ ሚሢጉዲ ማዓንዳኔ፤ ዬያ ዓጊሦዛ ዓኣፓ ዲኢኔም ሙዓ ዓሲ ሙዓኔ። <verse eid="NAM 3:12"/><verse number="13" style="v" sid="NAM 3:13"/>ኔኤኮ ዖሎ ዓሳ ቢያ ላኣሊጉዲ ዒጊቺኬ፤ ኔ ዓጮኮ ዛጶ ካራ ኔኤኮ ሞርኮም ቡሊሢ ማዒ ዓኣኔ፤ ካሮ ጋጋርቆ ዶዶ ሚፆዋ ታሚ ኔኤኮ ሙዔኔ። <verse eid="NAM 3:13"/><verse number="14" style="v" sid="NAM 3:14"/>ኔኤኮ ሞርካ ኔና ማንጊ ካሮ ኔኤኮ ባይዛኣና ኔኤኒ ዑሽካንዳ ዋኣፆ ሃሢ ዓኣንቴ ዱይ ጌሤ! ኔኤኮ ዋርዲዮ ማዓ ኬኤሎ ዲፆዋ ዶዲሼ! ቶርጴ ሄርቂ ዢኢጬጉዲ ካፂሲ ኮሼ! ፁኡቤ ጎዖ ባኮዋ ማዤ።<verse eid="NAM 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NAM 3:15"/>ኔኤኒ ታሚና ሚቺንቴም ዴራ ኔኤኮ ዖልዚዳ ኩዲፃ ዓቱዋያኬ፤ ዓቢሢ ማካ ሙዒ ባይዜ ጎሺ ኔኤኒ ማዓንዳኔ፤ ዒንሢያ ዓቢሢና ማኮናጉዲ ሾይንቲ ዺቡዋቴ።<verse eid="NAM 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NAM 3:16"/>ኔኤኮ ኮርሞ ኮርማ ዓሳ ዦኦጌፓ ባሼ ሚርጌኔ፤ ጋዓንቴ ዔያታ ዓቢሢጉዲ ሳዖ ኔኤኮ ጋፒሲ ሙዒጋፓ ባራኒ ዴንዳንዳኔ። <verse eid="NAM 3:16"/><verse number="17" style="v" sid="NAM 3:17"/>ኔና ካፓ ዓሳ ማኮጉዲ፥ ቢታንታ ዒንጊንቴ ዓሳኣ ሳዓ ጪኢሽኬም ዲርሲዳ ቁንዲ ዴዔ ዓቢሢጉዲ ማዔኔ፤ ዓባ ኬስካኣና ባራኒ ዔያታ ዴንዳንዳኔ፤ ዎኒ ዔያታ ዴንዳንዳቴያ ዔራንዳይ ዖኦኒያ ባኣሴ።<verse eid="NAM 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NAM 3:18"/>ዓሶኦሬ ካኣቲዮ! ኔና ካፓ ዓሳ ጊንዔኔ፥ ሱኡጎ ማዔ ዓሳ ላሂ ሃውሼኔ፥ ዴራ ኔኤኮ ዹኮ ዑፆይዳ ዜርቂንቴኔ፤ ያኣፓ ዔያቶ ቡኩሳ ዓሲያኣ ባኣሴ። <verse eid="NAM 3:18"/><verse number="19" style="v" sid="NAM 3:19"/>ኔኤኒ ጋፒ ማኣሳኔያታሢሮ ኔኤኮ ኪፆ ፓሣንዳ ዓሲ ባኣሴ፤ ሃይማኬ ጌይንቱዋ ኔኤኮ ጌኖ ማዻፓ ቶሊ ዓቴ ዓሲ ባኣሢሮ ኔጊዳ ማዺንቴ ባኮ ዋይዜሢ ቢያ ዎዛዺ ኩቺ ባዓንዳኔ።<verse eid="NAM 3:19"/></para>
  <chapter eid="NAM 3"/>
</usx>
