<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2CH" style="id">- MAALE Full Bible</book>
  <para style="h">2 ፆኦሲ ዓሶ ሃይሶ</para>
  <para style="toc1">2 ፆኦሲ ዓሶ ሃይሶ ኬኤዛ ማፃኣፖ</para>
  <para style="toc3">2ፆኦሲ. ዓሃኬ</para>
  <para style="toc2">2 ፆኦሲ ዓሶ ሃይሶ</para>
  <para style="mt1">2 ፆኦሲ ዓሶ ሃይሶ ኬኤዛ ማፃኣፖ</para>
  <para style="imt">ዓይፆ ካሮ</para>
  <para style="ip">ፆኦሲ ዓሶ ሃይሶ ኬኤዛ ማፃኣፖኮ ላምዓሳ ዓርቃሢ ቤርታሳ ማፃኣፓ ሃይሶ ኬኤዚ ዔቂሴ ካራፓኬ። ዬይያ፦ ካኣቲ፥ ሴሎሞኔ ካኣታዼስካፓ ዴንዲ ሃይቃንዳያ ሄላንዳኣና ዓኣ ሃይሴኬ፤ ዒዮርቢዓሜ ሱኡጌ ማዔም ኬዶ ዛላ ዓኣ ዒስራዔኤሌ ፃጳ ዒዛኮ ዓዶ ሴሎሞኔ ቤዛ ጌሊ ካኣታዼ፥ ዪሁዳ ካኣቲ፥ ሮቢዓሜም ዋይዞ ዒፄሢ ኬኤዜስካፓ ዴንዲ ዬሩሳላሜ ካታማ ዶዔ ዎዶ ጌይፃ ኪሪስቶሴ ሾይንቶኮ ቤርታ ዶንጎ ፄኤታና ሳሊታሚ ላሃሳ ሌዖ ሄላንዳኣና ዓኣ ዾኦሎ ዛሎ ዪሁዳ ካኣቶ ሃይሶ ፓይዲ ፓይዲ ኬኤዛኔ።</para>
  <para style="iot">ማፃኣፔላ ዱማ ዱማ ዓርቄ ባኮ</para>
  <para style="io1">ሴሎሞኔ ካኣታዺ ዎይሤ ዎዶ (1፡1—9፡31)</para>
  <para style="io2">1. ሃጊ ዓይፆ ሌዖይዳ ማዺንቴ ባኮ (1፡1-17)</para>
  <para style="io2">2. ጌኤዦ ማኣራ ማዢንቴሢ (2፡1—7፡10)</para>
  <para style="io2">3. ጊንፃሳ ሌዖይዳ ማዺንቴ ባኮ (7፡11—9፡31)</para>
  <para style="io1">ኬዶ ዛላ ዓኣ ዒስራዔኤሌ ፃጶኮ ዋይዞ ዒፂፆ (10፡1-19)</para>
  <para style="io1">ዪሁዳ ዓጮ ካኣቶ (11፡1—36፡12)</para>
  <para style="io1">ዬሩሳላሜኮ ዶዒፆ (36፡13-23)</para>
  <chapter number="1" style="c" sid="2CH 1"/>
  <para style="s1">ማሊ ጶቂሥሢ ዔራቶ ዴንቃኒ ሴሎሞኔኮ ሺኢጲፆ</para>
  <para style="r">(<ref loc="1KI 3:1-15">1ካኣቶ. ማ 3፡1-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 1:1"/>ናንጊና ናንጋ ጎዳ ማዔ ዒዛኮ ፆኦዛሢ ዒዛና ዎላ ዓኣያ ማዒ ኮሺ ዒዛ ዔርቴያ ማሄሢሮ ዳውቴ ናኣዚ፥ ሴሎሞኔ ካኣቱሞይዳ ጊኢጊንቲ ዴዔኔ።<verse eid="2CH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 1:2"/>ዬካፓ ሴሎሞኔ ዒስራዔኤሌ ዓሶ፥ ሺዮና ፄኤቶ ፖኦሊሶ ዓይሣ ዓሶ፥ ዎጎ ዎጋ ዓሶ፥ ዒስራዔኤሌ ዓሶ ጉቤሢንታ ዱማ ዱማ ማኣሮ ዓሶናኮ ሱኡጎ፥ <verse eid="2CH 1:2"/><verse number="3" style="v" sid="2CH 1:3"/>ጌባዖኦኔይዳ ፆኦሲ ካኣሽኪንታ ባኣኮ ዒዛና ዎላ ዓኣዻንዳጉዲ ዓይሤኔ፤ ዒኢካ ዔያታ ዓኣዻሢ ናንጊና ናንጋ ጎዳኮ ዓይላሢ፥ ሙሴ ዓሳ ናንጉዋ ዳውሎይዳ ማዤ ናንጊና ናንጋ ጎዳ ዴሮና ካኣማ ዓፒሎ ማኣራ ጌባዖኦኔይዳ ዓኣሢሮኬ። <verse eid="2CH 1:3"/><verse number="4" style="v" sid="2CH 1:4"/>ጫኣቁሞ ሳኣፂና ጋዓንቴ ካኣቲ ዳውቴ ቂርያትይዓሪሜ ካታሞይዳፓ ዔኪ ሙኬ ዎዶና ዬሩሳላሜይዳ ዬያም ጊኢጊሼ ዓፒሎ ማኣሮይዳ ዓኣኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡4 </char><char style="xt" closed="false"><ref loc="2SA 6:1-17">2ሳሙ. 6፡1-17</ref>፤ <ref loc="1CH 13:5-14">1ፆኦሲ. ዓሃኬ 13፡5-14</ref>፤ <ref loc="1CH 15:25-16:1">15፡25—16፡1</ref>።</char></note> <verse eid="2CH 1:4"/><verse number="5" style="v" sid="2CH 1:5"/>ሆሬ ናኣዚኮ ናኣዚ ዑሬ ናይ ባስሊዔኤሌ ጎዖሢ ሞኦኖ ዓንጎይዳፓ ኮሼ ሚቺ ዒንጎ ቤዛ ዒኢካ ጌባዖኦኔይዳ ዓፒሎና ማዢንቴ ፆኦሲ ዴሮና ካኣማ ማኣሮኮ ቤርቶ ዛላ ዓኣኔ፤ ዒኢካ ካኣቲ ሴሎሞኔንታ ዴራኣ ቢያ ናንጊና ናንጋ ጎዳና ካኣማኒ ኮዔኔ፤ <note caller="-" style="x"><char style="xo" closed="false">1፡5 </char><char style="xt" closed="false"><ref loc="EXO 38:1-7">ኬሲ. ማፃ 38፡1-7</ref>።</char></note> <verse eid="2CH 1:5"/><verse number="6" style="v" sid="2CH 1:6"/>ካኣቲያ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሬሎኮ ቤርቶ ዛላ ዓኣ ሞኦኖ ዓንጎና ኮሾና ሚቺ ዒንጎ ቤዞ ዑፃ ሚቺ ዒንጎ ባኮ ሺኢሼኔ፤ ዒማና ፔቴ ሺያ ቆልሞ ሹኪሲ ዒንጎ ቤዞይዳ ጉቤና ሚቺንታንዳጉዲ ዒ ማሄኔ።<verse eid="2CH 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 1:7"/>ዬኖ ዋንቴሎ ፆኦሲ ሴሎሜኔም ፔጋዺ ጴዻዖ፦ «ታ ኔኤም ዓይጎ ዒንጋንዳጉዲ ኔ ኮዓይ?» ጌይ ዖኦጬኔ።<verse eid="2CH 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 1:8"/>ዒማና ሴሎሞኔ ማሃዖ፦ «ታ ዓዶ ዳውቴም ኔ ዼኤፒ ኮሺ ባኣዚ ማዼኔ፤ ታና ዒዛ ቤዛ ሃሢ ኔ ካኣታሤኔ። <verse eid="2CH 1:8"/><verse number="9" style="v" sid="2CH 1:9"/>ናንጊና ናንጋ ጎዳ ማዔ ፆኦሲዮ! ታ ዓዶም ኔ ጉሙርሲ ኬኤዜ ቃኣሎ ኩንሤ፤ ሃያ ሚርጉማ ዓጪጉዲ ማዔ ዴሮይዳ ኔ ታና ካኣታሤኔ፤ <note caller="-" style="x"><char style="xo" closed="false">1፡9 </char><char style="xt" closed="false"><ref loc="GEN 13:16">ማዢ. ማፃ 13፡16</ref>፤ <ref loc="GEN 28:14">28፡14</ref>።</char></note> <verse eid="2CH 1:9"/><verse number="10" style="v" sid="2CH 1:10"/>ዬያሮ ኔኤኮ ዴሮ ፒዜ ዔኪ ዓኣዻኒ ታና ዳንዳዒሳ ማሊ ጶቂሥሢና ዔራቶና ታኣም ዒንጌ፤ ያዺ ማዒባኣያታቶ ጋዓንቴ ሃያ ኔኤኮ ዼኤፖ ዴሮ ዎዲ ታ ዔኪ ዓኣዻንዳይ?» ጌዔኔ።<verse eid="2CH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 1:11"/>ዬካፓ ፆኦሲ ሴሎሞኔም፦ «ኔ ኔ ቶኦኪም ዖርጎቹሞ፥ ቆሎ፥ ኔኤኮ ሞርካ ሃይቃንዳንጉዲ፤ ሃሣ ሚርጌ ሌዔ ናንጋኒቱዋንቴ ኔኤኒ ዔያቶይዳ ካኣታዻንዳጉዲ ታ ማሄ፥ ታኣኮ ዴሮ ፒዙሞና ዔኪ ዓኣዻኒ ኔና ዳንዳዒሳ ማሊ ጶቂሥሢና ዔራቶና ኔ ዖኦጬሢሮ፥ <verse eid="2CH 1:11"/><verse number="12" style="v" sid="2CH 1:12"/>ሃይሾ ኔ ታና ዖኦጬ ጶቂሢፆና ዔራቶና ታ ኔኤም ዒንጋንዳኔ፤ ቃሲ ሃሣ ሃያኮ ቤርታ ዎያ ካኣቲ ማዔቴያ ዴንቄያና ሴካ ቤርቲማኣ ዴንቃኒ ዳንዳዓያይዳፓ ባሼ ዖርጎቹሞ፥ ቆሎና ዼኤፒ ሱንሢያ ታ ኔኤም ዒንጋንዳኔ» ጌዔኔ።<verse eid="2CH 1:12"/></para>
  <para style="s1">ካኣቲ ሴሎሞኔኮ ቢታንቶንታ ቆሎንታ</para>
  <para style="r">(<ref loc="1KI 10:26-29">1ካኣቶ. ማ 10፡26-29</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 1:13"/>ሴሎሞኔ ጌባዖኦኔይዳ ፆኦሲ ዴሮና ካኣማ፥ ዓፒሎና ማዢንቴ ማኣራ ዓኣ ባኣካፓ ዬሩሳላሜ ዓኣዼኔ፤ ዒዚ ፔኤኮ ናንጎ ቤዞ ዒኢካ ማሂ ዒስራዔኤሌይዳ ካኣታዼኔ።<verse eid="2CH 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 1:14"/>ሴሎሞኔ ዒማና ፔቴ ሺያና ዖይዶ ፄኤታ ሳርጌላ ዖይታና ታጶ ላምዖ ሺያ ፓሮና ዶዲ ዖላ ዓሲ ጊኢጊሻዖ ዔያቶይዳፓ ዛሎ ዬሩሳላሜይዳ፥ ዓቴ ዓሶ ሃሣ ሃንጎ ዱማ ዱማ ካታማ ናንጋንዳጉዲ ፓቂ ፓቂ ጌሤኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡14 </char><char style="xt" closed="false"><ref loc="1KI 4:26">1ካኣቶ. ማ 4፡26</ref>።</char></note><verse eid="2CH 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 1:15"/>ሴሎሞኔ ካኣታዺ ዓኣ ዎዶና ዬሩሳላሜይዳ ዎርቆና ቢሮናኮ ሚርጉማፓ ዔቄያና ዓዳ ቃንፆ ማዔኔ፤ ሃሣ ዴኤሎ ዚቢቆ ሚርጉማኣ ዪሁዳይዳ ጌሜሮ ዴማ ጉቤ ቤዛ ባቃላ ቦኦቦጉዲ ፓይዲንቴኔ። <verse eid="2CH 1:15"/><verse number="16" style="v" sid="2CH 1:16"/>ካኣቲኮ ፓራሢ ሙካሢ ጊብፄና ቄዌ ዓጮናፓኬ፤ ካኣቲኮ ኮርሞ ኮርማ ዓሳ ዬያ ፓራሢ ቄዌይዳፓ ሻንቃኔ። <verse eid="2CH 1:16"/><verse number="17" style="v" sid="2CH 1:17"/>ጊብፄይዳፓ ዔያታ ጌልዛሢ ፔቴ ሳርጌሎ ላንካይ ኪሎ ጊራኣሜ ማዓ ቢራና፤ ሃሣ ፔቴ ፓሮዋ ፔቴና ዛላና ኪሎ ጊራኣሜ ማዓ ቢራና ሻንቂኬ፤ ዬያ ባኮ ጊንሣ ዔያታ ሂኢታ ዓሶንታ ሶኦሪ ዓሶ ካኣቶም ሻንቻኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡17 </char><char style="xt" closed="false"><ref loc="DEU 17:16">ላሚ. ዎማ 17፡16</ref>።</char></note><verse eid="2CH 1:17"/></para>
  <chapter eid="2CH 1"/>
  <chapter number="2" style="c" sid="2CH 2"/>
  <para style="s1">ጌኤዦ ማኣሮ ማዣኒ ጊኢጎና ጊኢጊንቲ</para>
  <para style="r">(<ref loc="1KI 5:1-18">1ካኣቶ. ማ 5፡1-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 2:1"/>ካኣቲ ሴሎሞኔ ናንጊና ናንጋ ጎዳ ሱንፆም ጌኤዦ ማኣሮና ካኣቱሞ ማኣሮና ማዣኒ ማሌኔ፤ <verse eid="2CH 2:1"/><verse number="2" style="v" sid="2CH 2:2"/>ዬያሮ ዒዚ ኬዲ ኬዳንዳ ላንካይታሚ ሺያ ዓሲ፥ ሹቺ ጳላንዳ ሳሊታሚ ሺያ ዓሲ ኬሲ ማዻንዳጉዲ ዓይሤኔ፤ ዬያጉዲ ሃሣ ማዾ ዛጊ ማዺሻንዳ ሃይሦ ሺያና ላሆ ፄኤታ ማዓ ዓሲ ጊኢጊሼኔ። <verse eid="2CH 2:2"/><verse number="3" style="v" sid="2CH 2:3"/>ዬካፓ ዒዚ ፂሮሴ ካኣቲ፥ ኪራሜም፦ «ታ ዓዴ ዳውቴ ፔኤኮ ካኣቱሞ ማኣሮ ማዤ ዎዶና ሊባኖኦሴ ሚፆ ኔ ዳኬሢጉዲ ታኣማኣ ዳኬቴራ፤ <verse eid="2CH 2:3"/><verse number="4" style="v" sid="2CH 2:4"/>ሃሢ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ታ ፆኦዛሢም ጌኤዦ ማኣሮ ማዣኒ ጊኢጊንቲዳ ዓኣኔ፤ ዬይ ጌኤዦ ማኣራ ታኣና ታ ዴሮና ሳውቃ ዑንጆ ጩቢሲ ናንጊና ናንጋ ጎዳ ኑ ካኣሽካ ቤሲ፥ ዒዛም ዱማዼ ካሦዋ ቢያ ዎዴ ኑ ዒንጋ ቤሲ፥ ቢያ ኬሊ ጉቴና ዋንቴና፤ ዬያጉዲ ሃሣ ሃውሾ ኬሎ ኬሎ፥ ዓጊኖ ፄኤሮንታ ዬያጉዴ ዱማዼ ቦንቾ ኬሎና ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢ ቦንቻኒ ሚቺ ዒንጎ ዒንጊፆ ዒንጎንዶ ዱማዼ ቤሲ ማዓንዳኔ፤ ዒስራዔኤሌ ዴራ ዬያ ናንጊና ማዺ ማዺ ናንጋንዳጉዲ ፆኦሲ ዔያቶ ዓይሤኔ። <verse eid="2CH 2:4"/><verse number="5" style="v" sid="2CH 2:5"/>ኑ ፆኦዛሢ ሜሌ ካኣሽኮ ፆኦዛፓ ቢያ ባሼ ዼኤፒ ማዔሢሮ ዼኤፒ ጌኤሺ ማኣሪ ማዣኒ ታ ማሌኔ። <verse eid="2CH 2:5"/><verse number="6" style="v" sid="2CH 2:6"/>ጋዓንቴ ጫሪንጮንታ ሳዖንታኮ ዳልጉማ ዒዛ ፔ ጋራ ማሂ ዓርቃኒ ዳንዳዑዋሴ፤ ዓካሪ ጌኤሺ ማኣሪ ዒዛም ማዣኒ ዳንዳዓይ ዖናዳይ? ዒዛኮ ቤርታ ዑንጆ ጩቢሶ ቤሲ ማዢፓዓቴም ጌኤሺ ማኣሪ ዒዛም ማዣኒ ታናንሢ ዓይጎ ዓሲዳይ? <note caller="-" style="x"><char style="xo" closed="false">2፡6 </char><char style="xt" closed="false"><ref loc="1KI 8:27">1ካኣቶ. ማ 8፡27</ref>፤ <ref loc="2CH 6:18">2ፆኦሲ. ዓሃኬ 6፡18</ref>።</char></note> <verse eid="2CH 2:6"/><verse number="7" style="v" sid="2CH 2:7"/>ሃሣ ፔቴ ባኣዚ ዱማ ዱማ ጎይሢና ኮሻኒ ዎርቄ፥ ቢራ ዓንጊ፥ ሞኦኖ ዓንጎንታ ዱማ ዱማ ዓንጎዋ ሼኤሺ ዹዓኒ፤ ሃሣ ጮልዔንታ ዲንኪ ዞቄ ዓፒላንታ ዹዋኒ ዳንዳዓ ሃኣሚ ዓሲያኣ ታኣም ዳኬ፤ ታ ዓዴ ዳውቴ ዶኦሬ ዪሁዳና ዬሩሳላሜናይዳ ዓኣ ሃኣሞ ዓሶና ዎላ ዒዚ ማዻንዳኔ። <verse eid="2CH 2:7"/><verse number="8" style="v" sid="2CH 2:8"/>ኔኤኮ ሚፆ ቲቃ ዓሳ ኮሺ ጎኦባታሢ ታ ዔራኔ፤ ዬያሮ ሊባኖኦሴይዳፓ ሊባኖኦሴ ሚፆንታ ዚቢቆንታ ዴኤሎ ዚቢቆንታ ታኣም ዳኬ። <verse eid="2CH 2:8"/><verse number="9" style="v" sid="2CH 2:9"/>ሚርጌ ሚሢ ቲቂፆና ኔ ዓሶ ማኣዳንዳጉዲ ታ ዓሶፓ ኔ ባንሢ ዓሲ ታ ዳካንዳኔ፤ ዬያ ታ ማዻንዳሢ ታ ማዣኒ ማሌ ጌኤዦ ማኣራ ዳልጊ፤ ሃሣ ኮሺ ሚዛጲ ማዓኒ ኮይሳሢሮኬ። <verse eid="2CH 2:9"/><verse number="10" style="v" sid="2CH 2:10"/>ኔኤኮ ማዻ ዓሶም ጋላ ማዓንዳያ ላምዖ ሚሎኔ ኪሎ ማዓንዳ ዛርጌ ዺኢሊ፥ ላምዖ ሚሎኔ ኪሎ ማዓንዳ ዔልዓ፥ ዖይዶ ፄኤታ ሺያ ዶሎዜ ማዓንዳ ዎይኔ ዑሺ፤ ጊንሣ ሃሣ ዖይዶ ፄኤታ ሺያ ዶሎዜ ማዓንዳ ዛይቴያኣ ታኣኒ ዳካንዳኔ» ጌዔኔ።<verse eid="2CH 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 2:11"/>ዬያሮ ካኣቲ፥ ኪራሜ ካኣቲ ሴሎሞኔም ኪኢታ ዋርቃታ ፃኣፓዖ፦ «ናንጊና ናንጋ ጎዳ ፔኤኮ ዴሮ ናሽካሢሮ ኔኤኒ ዔያቶይዳ ካኣታዻንዳጉዲ ኔና ካኣታሤኔ፤ <verse eid="2CH 2:11"/><verse number="12" style="v" sid="2CH 2:12"/>ናንጊና ናንጋ ጎዳም ጌኤዦ ማኣሮንታ ፔኤኮ ካኣቱሞ ማኣሮንታ ማዣኒ ሃኣማቶ ዓኣ ናይ ካኣቲ ዳውቴም ዒንጌ፥ ጫሪንጮንታ ሳዖንታ ማዤ፥ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ጋላቲንቶንጎ! <verse eid="2CH 2:12"/><verse number="13" style="v" sid="2CH 2:13"/>ሃይሾ ሃሢ ታኣኒ ሃኣማቶ ማዾና ዔርቴያ ማዔ ሁራሜ ዓቢ ጌይንታስኬያ ኔኤም ዳኬኔ። <verse eid="2CH 2:13"/><verse number="14" style="v" sid="2CH 2:14"/>ዒዛኮ ዒንዳ ዳኣኔ ዜርፃፓ፥ ዓዴ ዒዛኮ ፂሮሴ ዓጪ ዓሲኬ፤ ዒዚ ዎርቆ፥ ቢሮ ዓንጎ፥ ሞኦኖ ዓንጎ፥ ዱማ ዱማ ዓንጎ፥ ሹቺንታ ሚሢንታይዳፓ ዱማ ዱማ ባኣዚ ኮሻኒ ዳንዳዓ ዓሲኬ፤ ዬያጉዲ ሃሣ ዲንኪ፥ ጮልዔ፥ ዞቄንታ ሻኣዣሲ ሱኮና ሼኤሞና ዱማ ዱማ ማኣዖ ኮሺ ዔራያኬ፤ ሃሣ ጊንሣ ዱማ ዱማ ማሎና ዓኣ ባኣዚ ማዢ ኬሲሢና ዒዛም ማዻንዳጉዲ ዓይሢንቴ ጎይሢና ቢያ ባኣዚ ማዺሢ ዔራያኬ፤ ዬያሮ ዬያ ዓሢ ዱማ ዱማ ባኮ ማዺ ዔራ ኔ ዓዶም ማዻ ዓሶና ዎላ ማዺሼ። <verse eid="2CH 2:14"/><verse number="15" style="v" sid="2CH 2:15"/>ኔ ኑም ዳካኒ ጌዔ ዛርጋሢ ዺኢሎ፥ ዔልዖ፥ ዎይኖ ዑዦንታ ሪሚቶ ዛይቶንታ ዳኬ፤ <verse eid="2CH 2:15"/><verse number="16" style="v" sid="2CH 2:16"/>ኑኡኒያ ኔ ኮዓ ሊባኖኦሶ ሚፆ ቢያ ሊባኖኦሴ ዹካፓ ቲቂ ፔቴይዳ ቱካዖ ባዞ ዋኣፆይዳ ጌሤም ዋኣፃ ዔኪ ዒዮጴ ሄሊሳንዳጉዲ ዳካንዳኔ፤ ዬካፓ ኔኤኒ ዬሩሳላሜ ዔኪ ዓኣዻኒ ዳንዳዓኔ» ጌዔኔ።<verse eid="2CH 2:16"/></para>
  <para style="s1">ጌኤዦ ማኣሮ ማዻ ዓርቄንቴሢ</para>
  <para style="r">(<ref loc="1KI 6:1-38">1ካኣቶ. ማ 6፡1-38</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 2:17"/>ካኣቲ ሴሎሞኔ ቤርታ ዒዛኮ ዓዴ ዳውቴ ማዼሢ ጎይፆ ዒስራዔኤሌይዳ ናንጋ ሜሌ ዓጮ ዓሶ ፓይዴኔ፤ ዬያይዲ ፔኤኮ ዓጮ ጋሮይዳ ፔቴ ፄኤታና ዶንጊታሚ ሃይሦ ሺያና ላሆ ፄኤታ ማዓ ሜሌ ዓጪ ዓሲ ዓኣሢ ዔሬኔ፤ <verse eid="2CH 2:17"/><verse number="18" style="v" sid="2CH 2:18"/>ዬያቶይዳፓ ላንካይታሚ ሺያ ዓሲ ኬዶ ባኮ ኬዳንዳጉዲ፥ ሳሊታሚ ሺያ ዓሲ ዹኮይዳ ሹቺ ጳላንዳጉዲ ዓይሤኔ፤ ዬያጉዲ ሃሣ ማዻ ፒዜ ማዺንታሢ ዛጋንዳጉዲ ሃይሦ ሺያና ላሆ ፄኤታ ዓሲ ዶኦሬኔ።<verse eid="2CH 2:18"/></para>
  <chapter eid="2CH 2"/>
  <chapter number="3" style="c" sid="2CH 3"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 3:1"/>ሴሎሞኔኮ ዓዴ፥ ካኣቲ፥ ዳውቴ ጌኤዦ ማኣራ ማዢንታንዳ ቤሲ ዬሩሳላሜይዳ ሞኦሪያ ዹካ ዬያኮ ቤርታ ጊኢጊሼያኬ፤ ዬና ቤዛ ናንጊና ናንጋ ጎዳ ካኣቲ ዳውቴም ፔጋዺ ጴዼያ፥ ዒያቡሳ ዓሢ ዖርናኮ ሃኣኮ ሺርኮ ቆይዶኬ። <note caller="-" style="x"><char style="xo" closed="false">3፡1 </char><char style="xt" closed="false"><ref loc="GEN 22:2">ማዢ. ማፃ 22፡2</ref>።</char></note> <verse eid="2CH 3:1"/><verse number="2" style="v" sid="2CH 3:2"/>ሴሎሞኔ ካኣታዼዖ ዖይዳሳ ሌዖኮ ላምዓሳ ዓጊኖ ላምዓሶ ኬሎና ጌኤዦ ማኣሮ ማዦ ዓርቄኔ፤ <verse eid="2CH 3:2"/><verse number="3" style="v" sid="2CH 3:3"/>ካኣቲ ሴሎሞኔ ማዢሴ ጌኤዦ ማኣሮኮ ጋሮ ዖዶሱማ ላሂታሚ ዋዻ ማዓዛ፥ ዳልጉማ ላማታሚ ዋዻኬ። <verse eid="2CH 3:3"/><verse number="4" style="v" sid="2CH 3:4"/>ጌሎ ካሮይዳ ዓኣ ማኣሮኮ ዳኣሮ ዔጳ ፄኤታና ላማታሚ ዋዻ፥ ጋሮ ዳልጉማ ጌኤዦ ማኣሮኮ ጋሮ ዳልጉሞጉዴያ ላማታሚ ዋዻኬ፤ ዬይ ጋራ ጌኤሺ ዎርቄና ጳርቂንቴኔ፤ <verse eid="2CH 3:4"/><verse number="5" style="v" sid="2CH 3:5"/>ጌኤዦ ማኣሮኮ ዼኤፖ ቆልዓ ዚቢቂና ጌኤሺ ዎርቄና ጳርቂንቴያ ማዓዖ ሜኤፄንታ ካኒ ቢራታኣ ማሊሺ ዑፃ ኮሺንቴ ባኣዚ ዓኣኔ። <verse eid="2CH 3:5"/><verse number="6" style="v" sid="2CH 3:6"/>ካኣቲ ሴሎሞኔ ጌኤዦ ማኣሮ ኮሺ ሚዛጲ ማዔ ሹቺና ፓርዋይሜ ዓጫፓ ሙኬ ዎርቄና ኮሼኔ። <verse eid="2CH 3:6"/><verse number="7" style="v" sid="2CH 3:7"/>ጌኤዦ ማኣሮኮ ኮጫ፥ ሳኮኮ ፁንጋ፥ ካሮኮ ዓጮ ዛሎና ዓኣ ሚፆና ካሮና ዎርቄና ዒ ጳርቄኔ። ዬካፓ ሹጮና ማዦና ኮጮ ዑፆይዳ ኪሩቤሌ ጌይንታ ኪኢታንቾ ማሊሺ ማዤኔ። <verse eid="2CH 3:7"/><verse number="8" style="v" sid="2CH 3:8"/>ዬያጉዲ ሃሣ ዑሣ ዓኣዼ ጌኤዦ ማኣሮ ጌይንታ ጋሮ ማዤኔ፤ ዬኖ ጋሮ ቆልዔሎኮ ዖዶሱማ ላማታሚ ዋዻ ማዓዛ፥ ጋሮ ዳልጉማ ጌኤዦ ማኣሮኮ ጋሮ ዳልጉሞ ጉዴያ ላማታሚ ዋዻ፥ ዬያ ጋሮ ላማታሚ ሺያ ኪሎ ማዓ ጌኤሺ ዎርቄና ጳርቂ ኮሼኔ። <note caller="-" style="x"><char style="xo" closed="false">3፡8 </char><char style="xt" closed="false"><ref loc="EXO 26:33-34">ኬሲ. ማፃ 26፡33-34</ref>።</char></note> <verse eid="2CH 3:8"/><verse number="9" style="v" sid="2CH 3:9"/>ዎርቆ ሚስማሮኮ ዴኤሡማ ዶንጎ ፄኤታና ላንካይታሚ ጊራኣሜ ማዓያኬ፤ ዑፆ ኩቦ ጋሮ ቆልዖ ሹጮና ማዦናሢ ዎርቄና ጳርቂንቴኔ።<verse eid="2CH 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 3:10"/>ካኣቲ ሴሎሞኔ ዒዛኮ ማዻ ዓሳ ኪሩቤኤሎ ማሊሺ ኮሺ ዎርቄና ጳርቃንዳጉዲ፤ ዬካፓ ዑሣ ዓኣዼ ጌኤዦ ማኣሮ ቆልዖ ጋራ ዔቂሳንዳጉዲ ዓይሤኔ። <verse eid="2CH 3:10"/><verse number="11-13" style="v" sid="2CH 3:11-13"/>ኪሩቤላ ዑሣ ዓኣዼ ጌኤዦ ማኣሮ ጌሎ ካሮ ሆቶይዳ ዎሊ ቤቂ ዔቂ ዓኣኔ፤ ፔቴ ፔቴ ኪሩቤኤሎኮ ላምዖ ጋኣሲ ዓኣኔ፤ ፔቴ ፔቴ ጋኣዞኮ ዖዶሱማ ዶንጎ ዋዻኬ፤ ላምዖ ጋኣዞንሢ ቢያ ዛሎና ፒሺንቴያ ማዒ ቆልዖ ጋሮኮ ሳዛ ዎሊና ካኣማኔ፤ ዓቴ ላምዖ ጋኣዞንሢ ሃሣ ፔቴ ፔቴሢ ቢያ ዛሎና ዓኣ ኮጮ ካኣማያ ማዓዛ፥ ዬንሢ ፒሺንቴ ጋኣዞንሢኮ ዳልጉማ ላማታሚ ዋዻ ማዓያኬ። <note caller="-" style="x"><char style="xo" closed="false">3፡11-13 </char><char style="xt" closed="false"><ref loc="EXO 25:18-20">ኬሲ. ማፃ 25፡18-20</ref>።</char></note> <verse eid="2CH 3:11-13"/><verse number="14" style="v" sid="2CH 3:14"/>ዑሣ ዓኣዼ ዱማዼ ጋሬሎም ቃራ ሚዛጲና ሜሌ ዱማ ዱማ ዓፒላናይዳፓ ጎኦቦ ዓፒላ ጌሤኔ፤ ጎኦቦ ዓፒሌላ ጮልዔ፥ ዲንኪ፤ ሃሣ ዞቄ ማዓዛ ዑፆይዳ ኪሩቤኤሎ ማሊሲ ኮሺንቴ ባኣዚ ዓኣኔ። <note caller="-" style="x"><char style="xo" closed="false">3፡14 </char><char style="xt" closed="false"><ref loc="EXO 26:31">ኬሲ. ማፃ 26፡31</ref>።</char></note><verse eid="2CH 3:14"/></para>
  <para style="s1">ሞኦኖ ዓንጎና ኮሺንቴ ላምዖ ቱርቱሮ</para>
  <para style="r">(<ref loc="1KI 7:15-22">1ካኣቶ. ማ 7፡15-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 3:15"/>ካኣቲ ሴሎሞኔ ፔቴ ፔቴሢኮ ሌካ ዔጳ ሃይሢታሚ ዶንጎ ዋዻ ማዓያ ላምዖ ቱርቱሪ ኮሺሲ ጌኤዦ ማኣሮኮ ቤርቶ ዛላ ሆታ ዔቂሴኔ፤ ፔቴ ፔቴ ቱርቱሮኮ ቶኦኮይዳ ዖዶሱማ ዶንጎ ዋዻ ማዔ ላምዖ ሙስኩሌ ዓኣኔ፤ <verse eid="2CH 3:15"/><verse number="16" style="v" sid="2CH 3:16"/>ሮኦጬ ሱሲ ጎይሢ ካኒ ቢራታ ሞኦና ዓንጊና ኮሺንቴ ፓይዳ ፔቴ ፄኤታ ማዔ ሮኦማኣኔ ሚፆ ዓኣፖ ማሊሺ ኮሺንቴ ባኣዚ ዓኣኔ፤ <verse eid="2CH 3:16"/><verse number="17" style="v" sid="2CH 3:17"/>ቱርቱሮንሢ ዾቂንቴሢ ጌኤዦ ማኣሮ ጌሎ ካሮኮ ሻውሎና ሚዛቆናይዳኬ፤ ዾኦሎ ዛሎና ዔቄ ቱርቱራሢ «ያኪኔ»<note caller="+" style="f"><char style="fr" closed="false">3፡17 </char><char style="fq" closed="false">ያኪኔ </char><char style="ft" closed="false">ጌይፃ፦ «ፆኦሲ ዔቂሳኔ» ጌይሢኬ።</char></note> ጌይንታዛ፥ ኬዶ ዛሎና ዔቄሢ «ቦዔዜ»<note caller="+" style="f"><char style="fr" closed="false">3፡17 </char><char style="fq" closed="false">ቦዔዜ </char><char style="ft" closed="false">ጌይፃ፦ ፆኦሲ ዎልቄና ጌይሢኬ።</char></note> ጌይንቴኔ።<verse eid="2CH 3:17"/></para>
  <chapter eid="2CH 3"/>
  <chapter number="4" style="c" sid="2CH 4"/>
  <para style="s1">ጌኤዦ ማኣሮ ጋራ ማዺንቶ ሜሆ</para>
  <para style="r">(<ref loc="1KI 7:23-51">1ካኣቶ. ማ 7፡23-51</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 4:1"/>ካኣቲ፥ ሴሎሞኔ ዳልጉሞና ዖዶሱሞና ላማታሚ ዋዻ፤ ሌካ ዔጳ ታጶ ዋዻ ማዔያ ፆኦሲም ዒንጎ ቤሲ ሞኦኖ ዓንጎና ኮሼኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡1 </char><char style="xt" closed="false"><ref loc="EXO 27:1-2">ኬሲ. ማፃ 27፡1-2</ref>።</char></note> <verse eid="2CH 4:1"/><verse number="2" style="v" sid="2CH 4:2"/>ዬያጉዲ ሃሣ ሴካ ጎኦቦ ዳልጉማ ዓጫፓ ዓጮ ሄላንዳኣና ታጶ ዋዻ፤ ሌካ ዔጳ ዶንጎ ዋዻ ማዔ ሺሪ ዴንዳ ዙላ ጋባዳጉዴያ ዶኦላ ዓንጎ ሼኤሺ ዓልቂሲ ኮሼኔ፤ ዬያኮ ዙሎ ዋርቆዛ ሃይሢታሚ ዋዻ ማዓኔ። <verse eid="2CH 4:2"/><verse number="3" style="v" sid="2CH 4:3"/>ዬያ ዶኦላሢ ካሮኮ ዴማ ፔቴ ፔቴ ዋዻ ማዓያይዳ ዙሎ ሺሬያ ታጶ ጌማይ ማላ ባኣዚ ላምዖ ቤሲ ፓቂንቲ ዎሊ ቤቂ ዓኣኔ፤ ዬይ ጌማታ ዶኦላሢና ዎላ ፔቴ ማሂ ኮሾናያኬ። <verse eid="2CH 4:3"/><verse number="4" style="v" sid="2CH 4:4"/>ዶኦላሢ ሞኦኖ ዓንጋፓ ፔኤኮ ባሊቶ ሴካ ሺርሺሲ ኮሾና ታጶ ላምዖ ጌማቶ ማላ ባኮ ዑፃ ጌሢንቴኔ፤ ዬንሢ ጌማቶ ማሊሲ ኮሾናዞንሢኮ ሃይሦንሢ ኬዶ ዛሎ ባንሢ፥ ሃይሦንሢ ዾኦሎ ዛሎ ባንሢ፥ ዛሎ ሃይሦንሢ ዓባ ኬስካሢ ባንሢ፥ ዓቴ ሃይሦንሢ ሃሣ ዓባ ጌላ ባንፆ ዛጋያኬ። <verse eid="2CH 4:4"/><verse number="5" style="v" sid="2CH 4:5"/>ዬያ ዶኦላሢኮ ዓንዲርሙማ ፔቴ ኬኤላ ዋዻ ማዓያ፥ ካራ ሃሣ ዑሺ ዑሽኮ ዓንጊ ካራ ማላያ፥ ጊንሣ ሱኡፖ ቡኒጉዴያ ዙሌም ሺሬያኬ፤ ዬይ ዶኦላሢ ላሂታሚ ሺያ ዶሎዜ ማዓ ዋኣሢ ዓርቃያኬ። <verse eid="2CH 4:5"/><verse number="6" style="v" sid="2CH 4:6"/>ሄሊሳዖ ዋኣሢ ማስቶ ታጶ ጎንጊ ኮሺሲ፥ ዶንጋሢ ጌኤዦ ማኣሮኮ ዾኦሎ ዛሎ ጎኦባ፤ ዓቴ ዶንጋሢ ሃሣ ጌኤዦ ማኣሮኮ ኬዶ ዛሎና ጎኦባ ጌሤኔ፤ ዬንሢ ጎንጎንሢ ፆኦሲም ሚቺ ዒንጎሮ ሹኪንታ ቆልሞኮ ዓሽኮ ቢያ ማስኮያኬ፤ ዼኤፖ ዶኦላሢዳ ዓኣ ዋኣፆ ቄኤሳ ማስታያኬ። <note caller="-" style="x"><char style="xo" closed="false">4፡6 </char><char style="xt" closed="false"><ref loc="EXO 30:17-20">ኬሲ. ማፃ 30፡17-20</ref>።</char></note> <verse eid="2CH 4:6"/><verse number="7" style="v" sid="2CH 4:7"/>ሴሎሞኔ ቤርታ ጊኢጊሺ ሃሾና ማሊፆ ጎይፆ ታጶ ፖዒ ጌሦ ሻርና ዎርቄይዳፓ ኮሺሲ ጌኤዦ ማኣሮኮ ዼኤፖ ቆልዖ ጋራ ዶንጋሢ ኬዶ ዛሊና፥ ዶንጋሢ ዾኦሎ ዛሊና ጌሤኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡7 </char><char style="xt" closed="false"><ref loc="EXO 25:31-40">ኬሲ. ማፃ 25፡31-40</ref>።</char></note><verse eid="2CH 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 4:8"/>ዬያጉዲ ሃሣ ታጶ ዼጌ ሎኦዤ ዖይታ ኮሺሲ ጌኤዦ ማኣሮኮ ዼኤፖ ቆልዖ ጋራ ዶንጋሢ ሻውሎ ዛላ፥ ዓቴ ዶንጋሢ ሚዛቆ ዛላ ጌሤኔ፤ ዬያ ሌሊቱዋንቴ ቃሲ ፄኤታ ጉንጉሎዋ ዎርቄይዳፓ ኮሺሴኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡8 </char><char style="xt" closed="false"><ref loc="EXO 25:23-30">ኬሲ. ማፃ 25፡23-30</ref>።</char></note><verse eid="2CH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 4:9"/>ሴሎሞኔ ቄኤሶኮ ማዾም ማዓንዳ ጌኤዦ ማኣሮኮ ጋሮ ዛሎና ዓሲ ቡካ ጶኦካ፤ ዬያጉዲ ሃሣ ዼኤፒ ጶኦካኣ ኮሺሴኔ፤ ዬንሢ ላምዖ ጶኦኮንሢኮ ባኣካ ዓኣ ካራ ሞኦኖ ዓንጎና ጳርቂንቴያኬ። <verse eid="2CH 4:9"/><verse number="10" style="v" sid="2CH 4:10"/>ዼኤፖ ዶኦላሢ ዒማና ጌኤዦ ማኣሮኮ ዾኦሎ ዛላ ዓባ ኬስካ ባንፆና ጌሢንቴኔ። <verse eid="2CH 4:10"/><verse number="11-16" style="v" sid="2CH 4:11-16"/>ሁራሜ ቃሲ ሃሣ ዖቲ፥ ታሚ ካኣሾ ኩንዔንታ ዔቶ ሳኣኖንታ ኮሼኔ፤ ዬያይዲ ሁራሜ ካኣቲ ሴሎሞኔም ኮሻኒ ጫኣቄ ጎይፆ ጌኤዦ ማኣሮ ማዾም ማዓ ሜሆ ቢያ ኮሺ ጋፒሴኔ፤ ዬይ ዒ ኮሼ ባካ ሃካፓ ዴማ ፔቴ ፔቴ ፓይዲንታዞንሢኬ፦</para>
  <para style="q" vid="2CH 4:11-16">ላምዖ ቱርቱሮ፥</para>
  <para style="q" vid="2CH 4:11-16">ቱርቱሮንሢኮ ቶኦካ ዓኣ ሳኣኖ ማላ ላምዖ ሙስኩሎ፥</para>
  <para style="q" vid="2CH 4:11-16">ላምዖ ሙስኩሎንሢ ማይሊ ሚዛጲሳኒ ሮኦጮ ማሊሲ ኮሺንቴ ላምዖ ካኖ ቢራቶ፥</para>
  <para style="q" vid="2CH 4:11-16">ሙስኩሎንሢ ማይሊ ኮሻኒ ፔቴ ፔቴ ሙስኩሎ ዑፃ ላሚ ጳንጪ ሞኦኖ ዓንጎና ኮሺንቴ ዖይዶ ፄኤታ ሮኦማኣኔ ዓኣፖ ማላ ባኮ፥</para>
  <para style="q" vid="2CH 4:11-16">ሺራ ቶኪ ዓኣ ሜሆ ጌሦ ታጶ ባኮ</para>
  <para style="q" vid="2CH 4:11-16">ዋኣፆ ማስቶ ታጶ ዶኦላ፥</para>
  <para style="q" vid="2CH 4:11-16">ዼኤፒ ዶኦላ፥</para>
  <para style="q" vid="2CH 4:11-16">ዶኦላሢ ዶዑዋጉዲ ዓርቄ ጌማቶ ማላ ታጶ ላምዖ ባኮ፥</para>
  <para style="q" vid="2CH 4:11-16">ዖታ፥ ታሞ ካኣሾ ኩንዓ፥ ቃጳሢንታ ሜሌ ዬያጉዲ ሜሆዋ ፔ ሃኣማቶና ዒ ኮሼኔ።</para>
  <para style="m" vid="2CH 4:11-16">ሃኣማቶና ዔርቴያ ማዔ ሁራሜ ካኣቲ፥ ሴሎሞኔ ዒዛ ዓይሤ ጎይፆና ፆኦሲኮ ጌኤዦ ማኣሮ ማዾም ማዓንዳጉዲ ዬያ ሜሆ ቢያ ኮሼሢ ዑጪ ጊኢጊሺ ጌሦና ሞኦኖ ዓንጎናኬ።<verse eid="2CH 4:11-16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 4:17"/>ካኣቲ፥ ሴሎሞኔ ዬያ ሜሆ ቢያ ኮሺሴሢ ዮርዳኖሴ ዶኦጫ፥ ሱኮቴና ፄሬዳ ጌይንታ ቤዞ ባኣካ ዓኣ ሞኦኖ ዓንጎ ሼኤሾ ቤዛኬ፤ <verse eid="2CH 4:17"/><verse number="18" style="v" sid="2CH 4:18"/>ዬያይዲ ኮሺንቴ ባካ ኮሺ ሚርጌታሢሮ ዬያ ባኮ ኮሺሳኒ ዔኪንቴ ሞኦኖ ዓንጎኮ ዴኤሡማ ዎሊ ዑፃ ዋኣዺታቶዋ ዖኦኒያ ዔራኒ ዳንዳዒባኣሴ። <verse eid="2CH 4:18"/><verse number="19" style="v" sid="2CH 4:19"/>ዬያጉዲ ሃሣ ካኣቲ፥ ሴሎሞኔ ጌኤዦ ማኣሮ ማዾም ማዓንዳ ባኣዚ ዎርቄና ኮሺሴኔ፤ ዬይ ባካ፦ ናንጊና ናንጋ ጎዳም ዒንጎ ባኮ ዒንጎ ቤዞንታ ፆኦሲም ዒንጊሢ ማዒ ሺኢሺንታ ካሦ ጌሦ ዼጌ ሎኦዦ ዖይቶ፥ <verse eid="2CH 4:19"/><verse number="20" style="v" sid="2CH 4:20"/>ጌኤሺ ዎርቄፓ ኮሺንቴ ፖዖ ጌሦ ሻርኖንታ ቤርታ ማሊንቴ ጎይፆና ጌኤዦ ማኣሮኮ ቤርቶ ዛላ ፖዓ ፖዖ፥ <verse eid="2CH 4:20"/><verse number="21" style="v" sid="2CH 4:21"/>ቡኖ ማሊሶና ፓልማሢንታ ፖዖንታ፤ ዬያጉዲ ሃሣ ዲቢንፆ ቆንቾሢንታ፥ <verse eid="2CH 4:21"/><verse number="22" style="v" sid="2CH 4:22"/>ጌኤሺ ዎርቄይዳፓ ኮሺንቴ ፖዖ ፖዒሶሢንታ ዎዾሢ፤ ጉንጉላሢ፥ ጩቦ ጩቢሾሢንታ ታሞ ካኣሾ ኩንዖንታ፤ ዬይ ባካ ቢያ ጌኤሺ ዎርቄይዳፓ ኮሺንቴያኬ፤ ጌኤዦ ማኣሮኮ ዙሎ ካሮንታ ዑሣ ዓኣዼ ጌኤዦ ማኣሮኮ ካሮንታ ዎርቄና ጳርቂ ኮሾናያኬ።<verse eid="2CH 4:22"/></para>
  <chapter eid="2CH 4"/>
  <chapter number="5" style="c" sid="2CH 5"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 5:1"/>ካኣቲ ሴሎሞኔ ጌኤዦ ማኣሮ ማዾ ቢያ ማዺ ጋፒሴስካፓ ዒዛኮ ዓዴ፥ ዳውቴ ናንጊና ናንጋ ጎዳም ዱማሴ ቢሮንታ ዎርቆንታ፤ ዬያጉዲ ሃሣ ሜሌ ባኮዋ ቢያ ጌኤዦ ማኣሮይዳ ዓኣ ሜሆ ጌሦ ማኣሮ ጌልዜኔ። <note caller="-" style="x"><char style="xo" closed="false">5፡1 </char><char style="xt" closed="false"><ref loc="2SA 8:11">2ሳሙ. 8፡11</ref>፤ <ref loc="1CH 18:11">1ፆኦሲ. ዓሃኬ 18፡11</ref>።</char></note><verse eid="2CH 5:1"/></para>
  <para style="s1">ጫኣቁሞ ሳኣፂኖ ጌኤዦ ማኣሪ ጌልዞናሢ</para>
  <para style="r">(<ref loc="1KI 8:1-9">1ካኣቶ. ማ 8፡1-9</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 5:2"/>ዬካፓ ካኣቲ ሴሎሞኔ ናንጊና ናንጋ ጎዳኮ ጫኣቁሞ ሳኣፂኖ ዳውቴ ካታሞ ማዔ፥ ፂዮኔይዳፓ ሃንጋ ጌኤዦ ማኣሪ ዔኪ ሙካንዳንጉዲ ኬኤዛኒ ዒስራዔኤሌ ዓሶኮ ጋርቾ ዓሶና ፃጶ ፃጶንታ ማኣሮ ማኣሮንታኮ ሱኡጎ ቢያ ዬሩሳላሜይዳ ቡኩሴኔ። <note caller="-" style="x"><char style="xo" closed="false">5፡2 </char><char style="xt" closed="false"><ref loc="2SA 6:12-15">2ሳሙ. 6፡12-15</ref>፤ <ref loc="1CH 15:25-28">1ፆኦሲ. ዓሃኬ 15፡25-28</ref>።</char></note> <verse eid="2CH 5:2"/><verse number="3" style="v" sid="2CH 5:3"/>ዒስራዔኤሌ ዓሳ ላንካሳ ዓጊኖይዳ ዉልሾ ዴማ ቦንቻ ቦንቾና ካኣቲ ዔኤሌ ዓሳ ቢያ ዬሩሳላሜይዳ ሙኪ ቡኬኔ፤ <verse eid="2CH 5:3"/><verse number="4-5" style="v" sid="2CH 5:4-5"/>ዒስራዔኤሌ ዓሶኮ ሱኡጋ ቢያ ፔቴይዳ ቡኪንቴ ዎዶና ሌዊ ዓሳ ጫኣቁሞ ሳኣፂኖ ኬዲ ጌኤዦ ማኣሪ ዔኪ ዬዔኔ፤ ዬያጉዲ ሃሣ ቄኤሶንታ ሌዊ ዓሶንታ ዓፒሎና ማዢንቴ ናንጊና ናንጋ ጎዳ ካኣሽኪንታ ማኣሮና ጋሮይዳ ዓኣ ፆኦሲ ማዾም ዱማዼ ሜሆዋ ቢያ ጌኤዦ ማኣሪ ዔኪ ዬዔኔ። <verse eid="2CH 5:4-5"/><verse number="6" style="v" sid="2CH 5:6"/>ዒማና ካኣቲ ሴሎሞኔንታ ዴሮንታ ቢያ ጫኣቁሞ ሳኣፂኖኮ ቤርቶ ዛላ ሙኪ ቡኬኔ፤ ሚርጉማፓ ዔቄያና ፓይዲንታኒ ዳንዳዑዋ ዺቢ ማራይንታ ባይንታ ዒንጎ ባኣዚ ማሂ ናንጊና ናንጋ ጎዳም ዔያታ ሺኢሼኔ።። <verse eid="2CH 5:6"/><verse number="7" style="v" sid="2CH 5:7"/>ቄኤሳ ናንጊና ናንጋ ጎዳኮ ጫኣቁሞ ሳኣፂኖ ጌኤዦ ማኣሪ ዔኪ ጌላዖ ዑሣ ዓኣዼ ዱማዼ ጋሮይዳ ዓኣ ኪሩቤሌ ጋኣዞ ዴማ ጌሤኔ። <verse eid="2CH 5:7"/><verse number="8" style="v" sid="2CH 5:8"/>ዒማና ፒሺንቲ ዓኣ ኪሩቤኤሎኮ ጋኣዛ ጫኣቁሞ ሳኣፂኖንታ ሳኣፂኖ ኬዶና ዛጳሢ ሚፆንታ ካንቂ ዓኣቼኔ። <verse eid="2CH 5:8"/><verse number="9" style="v" sid="2CH 5:9"/>ዛጳሢ ሚፃ ኮሺ ዖዶሲታሢሮ ዑሣ ዓኣዼ ዱማዼ ጋሮኮ ቤርቶ ዛላ ዔቄ ዓይጎ ዓሲያማዖም ዴንቃኒ ዳንዳዓኔ፤ ጋዓንቴ ሜሌ ዛላና ዔቄ ዓሲ ፔቴታዖ ዴንቃኒ ዳንዳዑዋሴ፤ ዬንሢ ዛጶ ሚፆንሢ ሃኖ ሄላንዳኣና ዒኢካ ዓኣኔ። <verse eid="2CH 5:9"/><verse number="10" style="v" sid="2CH 5:10"/>ዬያ ጫኣቁሞ ሳኣፂኖ ጋራ ዒስራዔኤሌ ዴራ ጊብፄይዳፓ ኬስኬንቴ ናንጊና ናንጋ ጎዳ ዔያቶና ዎላ ጫኣቁሞ ጫኣቄያና ሙሴ ሲና ዹኮይዳ ጫኣቁሞ ሳኣፂኖ ጋራ ጌሤ ላምዖ ሹጮ ዓርሶናዞንሢዳፓ ዓታዛ ሳኣፂኖ ጋራ ሜሌ ዓኣ ባኣዚ ባኣሴ። <note caller="-" style="x"><char style="xo" closed="false">5፡10 </char><char style="xt" closed="false"><ref loc="DEU 10:5">ላሚ. ዎማ 10፡5</ref>።</char></note><verse eid="2CH 5:10"/></para>
  <para style="s1">ፆኦሲኮ ቦንቻ ፔጋዺ ጴዼሢ</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 5:11"/>ቄኤሳ ጌኤዦ ማኣራፓ ኬስኬኔ፤ ዬያታ ቄኤሳ ቢያ ዔያቶ ማዾንጎ ጎዖና ኬሎ ማዒባኣቴያ ቢያሢ ፔና ጌኤሺ ናንጊና ናንጋ ጎዳም ዱማሴኔ። <verse eid="2CH 5:11"/><verse number="12" style="v" sid="2CH 5:12"/>ፆኦሲ ቦንቾም ዓይኑሞ ዓይናዻ ሌዊ ዓሳ ቢያሢ፥ ዓሳኣፔ፥ ሄማኔንታ ዪዱታኔንታ፤ ዔያቶኮ ዓቲንቆ ናኣቶንታ ዒጊኖንታ ቢያ ሚዛጲ ሻኣዣ ማኣዖ ማይንቲ ዓኣኔ፤ ሌዊ ዓሳ ዒማና ዑኡቱቡሎንታ ፔቴ ሻሺ ዴንሢ ዋርቆ ጎኦሎዋ ዔኪ ናንጊና ናንጋ ጎዳም ዒንጎ ባኮ ሺኢሾ ቤዞኮ ዓባ ኬስካ ዛሎና ዔቂ ዓኣኔ። <verse eid="2CH 5:12"/><verse number="13-14" style="v" sid="2CH 5:13-14"/>ዔያቶና ዎላ ዛዬ ዋርቃ ፄኤታና ላማታሚ ማዓ ቄኤሴ ዓኣኔ፤ ዬያታ ፆኦሲ ቦንቾም ዓይኑሞ ዓይናዻ ዓሳ ዛያሢንታ ዑኡቱቡላሢንታ ፔቴ ሻዦ ዴንሢ ዋርቆ ጎኦሎንታ ሜሌ ባኮዋ ዖልሲ ዖልሲ ሂዚ ጌዒ ዓይናዺ ፔቴ ዑኡሲና ናንጊና ናንጋ ጎዳ ጋላታኔ።</para>
  <para style="q" vid="2CH 5:13-14">«ዒዚ ኮሺታሢሮ፥ ናሹማኣ ዒዛኮ ናንጊና ጋፑዋያታሢሮ</para>
  <para style="q2" vid="2CH 5:13-14">ናንጊና ናንጋ ጎዳ ጋላቱዋቴ።»</para>
  <para style="p" vid="2CH 5:13-14">ዒማና ዔርቲባኣንቴ ፆኦሲኮ ቦንቾ ፔጋሲ ዻዋ፥ ዓኣፒዳ ዱዱካ ፖዒ ፖዓ ሻኣሬ ናንጊና ናንጋ ጎዳኮ ጌኤዦ ማኣሮ ኩሜሢሮ ቄኤሳ ካኣዦ ማዾ ማዻኒ ዳንዳዒባኣሴ። <note caller="-" style="x"><char style="xo" closed="false">5፡13-14 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1ፆኦሲ. ዓሃኬ 16፡34</ref>፤ <ref loc="2CH 7:3">2ፆኦሲ. ዓሃኬ 7፡3</ref>፤ <ref loc="EZR 3:11">ዒዝ. 3፡11</ref>፤ <ref loc="PSA 100:5">ዓይኑ. 100፡5</ref>፤ <ref loc="PSA 106:1">106፡1</ref>፤ <ref loc="PSA 107:1">107፡1</ref>፤ <ref loc="PSA 118:1">118፡1</ref>፤ <ref loc="PSA 136:1">136፡1</ref>፤ <ref loc="JER 33:11">ዔር. 33፡11</ref>።</char></note> <note caller="-" style="x"><char style="xo" closed="false">5፡13-14 </char><char style="xt" closed="false"><ref loc="EXO 40:34-35">ኬሲ. ማፃ 40፡34-35</ref>።</char></note><verse eid="2CH 5:13-14"/></para>
  <chapter eid="2CH 5"/>
  <chapter number="6" style="c" sid="2CH 6"/>
  <para style="s1">ሴሎሞኔ ዴሮም ኬኤዜ ባኮ</para>
  <para style="r">(<ref loc="1KI 8:12-21">1ካኣቶ. ማ 8፡12-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 6:1"/>ዬካፓ ካኣቲ ሴሎሞኔ፦</para>
  <para style="q" vid="2CH 6:1">«ናንጊና ናንጋ ጎዳሢዮ! ‹ታኣኒ ዲም ጌዔ ሻኣሬ ባኣካ ናንጋኔ› ኔኤኒ ጌዔኔ፤<verse eid="2CH 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="2CH 6:2"/>ሃይሾ ዲቃሢ ሄርሺሳ ሚዛጲ ጌኤሺ ማኣሪ</para>
  <para style="q2" vid="2CH 6:2">ታ ኔኤም ማዤኔ፤</para>
  <para style="q" vid="2CH 6:2">ዬይ ጌኤዦ ማኣራ</para>
  <para style="q2" vid="2CH 6:2">ኔኤኒ ዒኢካ ናኣናና ናንጋ ቤሲ ማዓንዳኔ» ጌዔኔ።<verse eid="2CH 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 6:3"/>ዒማና ዒስራዔኤሌ ዓሳ ዒኢካ ዔቂ ዓኣኔ፤ ካኣቲ ሴሎሞኔ ዬያ ዓሶ ባንሢ ሺሪ ፆኦሲኮ ዓንጃ ዔያቶም ማዓንዳጉዲ ሂዚ ጌዒ ሺኢቄኔ፦ <verse eid="2CH 6:3"/><verse number="4" style="v" sid="2CH 6:4"/>«ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ጋላቲንቶንጎ! ዒዚ ታ ዓዶ፥ ዳውቴም ጉሙርሲ ኬኤዜ ሃጊ ማዓንዳ ዎዞ ቃኣሎ ዒ ኩንሤኔ፤ ዒዚ ጉሙርሴ ቃኣላ ሂዚ ጋዓያኬ፦ <verse eid="2CH 6:4"/><verse number="5" style="v" sid="2CH 6:5"/>‹ታኣኮ ዴሮ ጊብፄይዳፓ ታ ኬሴ ኬላፓ ዓርቃዖ ዴንዲ ሃኖ ሄላንዳኣና ታኣኒ ካኣሽኪንታንዳ ጌኤሺ ማኣሪ ማዢንታንዳ ቤሲ ዒስራዔኤሌ ዓጮ ጉቤሢዳፓ ፔቴ ካታማታዖ፤ ዬያጉዲ ሃሣ ታኣኮ ዴሮ ዒስራዔኤሌ ዓርናዺ ዔኪ ዓኣዻንዳ ዓይጎ ዓሲያኣ ታ ዶኦሪባኣሴ፤ <verse eid="2CH 6:5"/><verse number="6" style="v" sid="2CH 6:6"/>ሃሢ ጋዓንቴ ታና ካኣሽኮንዶ ቤሲ ማዓንዳጉዲ ዬሩሳላሜ፤ ታኣኮ ዴሮ ዓርና ማዒ ዔኪ ዓኣዻንዳጉዲ ኔና፥ ዳውቴ ታ ዶኦሬኔ።› »<verse eid="2CH 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 6:7"/>ሄሊሣዖ ሃሣ ካኣቲ ሴሎሞኔ፦ «ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ካኣሽኪንታንዳ ጌኤሺ ማኣሪ ታ ዓዴ ዳውቴ ማዣኒ ማሌኔ፤ <verse eid="2CH 6:7"/><verse number="8" style="v" sid="2CH 6:8"/>ናንጊና ናንጋ ጎዳ ጋዓንቴ ዒዛም፦ ‹ታኣም ጌኤሺ ማኣሪ ማዣኒ ማሊፃ ኔኤኮ ቃራኬ፤ <verse eid="2CH 6:8"/><verse number="9" style="v" sid="2CH 6:9"/>ያዺ ማዔቴያ ታኣም ጌኤዦ ማኣሮ ማዣንዳሢ ኔ ሾዔ ኔኤኮ ናኣዚኬ፤ ኔናቱዋሴ› ጌዔኔ» ጌኤኔ። <note caller="-" style="x"><char style="xo" closed="false">6፡9 </char><char style="xt" closed="false"><ref loc="2SA 7:1-13">2ሳሙ. 7፡1-13</ref>፤ <ref loc="1CH 17:1-12">1ፆኦሲ. ዓሃኬ 17፡1-12</ref>።</char></note><verse eid="2CH 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 6:10"/>ሃሣ ሴሎሞኔ፦ «ሃይሾ ናንጊና ናንጋ ጎዳ ጉሙርሲ ኬኤዜ ሃጊ ማዓንዳ ዎዞ ቃኣሎ ኩንሤኔ፤ ዬያሮ ታኣኒ ታ ዓዶ ቤዛ ጌሊ ዒስራዔኤሌይዳ ካኣታዼኔ፤ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ካኣሽኪንታንዳ ጌኤዦ ማኣሮዋ ታ ማዤኔ፤ <verse eid="2CH 6:10"/><verse number="11" style="v" sid="2CH 6:11"/>ናንጊና ናንጋ ጎዳ ዒስራዔኤሌ ዴሮና ዎላ ጫኣቄ ጫኣቁማ ዓኣ ሳኣፂኖዋ ጌኤዦ ማኣሮይዳ ታ ጌልዚ ጌሤኔ» ጌዔኔ።<verse eid="2CH 6:11"/></para>
  <para style="s1">ሴሎሞኔ ፆኦሲ ሺኢቄ ሺኢጲፆ</para>
  <para style="r">(<ref loc="1KI 8:22-53">1ካኣቶ. ማ 8፡22-53</ref>)</para>
  <para style="p">
    <verse number="12-13" style="v" sid="2CH 6:12-13"/>ዬካፓ ካኣቲ ሴሎሞኔ ዒስራዔኤሌ ዴራ ዓኣ፥ ናንጊና ናንጋ ጎዳም ዒንጎ ባኮ ሺኢሾ ቤዞኮ ቤርቶ ዛሎ ጶኦኮይዳ ዓኣ ዼጊሲ ኮሾና ባኮ ዑፆ ኬስኪ ዔቄኔ። ዳልጉሞና ዖዶሱሞና ዶንጎ ዋዻ፥ ሌካ ዔጳ ሃይሦ ዋዻ ማዔ ዬኖ ዼጌ ባኬሎ ሞኦና ዓንጊና ዒዚ ኮሺሲ ዬካ ጶኦካ ዾቂሼያኬ፤ ዒዚ ዴራ ቢያ ዒዛ ዛጋኒ ዳንዳዓ ዬኖ ዼጌ ባኬሎይዳ ጉምዓታዖ ኩጮ ሌካ ጫሪንጮ ባንሢ ዼጊዲ፦ <verse eid="2CH 6:12-13"/><verse number="14" style="v" sid="2CH 6:14"/>«ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦሲዮ! ጫሪንጮይዳ ማዔቶዋ ሳዖይዳ ቢያ ኔናጉዴ ፆኦሲ ፔቴታዖ ባኣሴ፤ ኔኤኒ ኔኤኮ ዴሮና ዎላ ጫኣቄ ጫኣቁሞ ካፓኔ፤ ጉቤ ዒናፓ ኔኤም ዓይሢንታ ዓሶ ናንጊና ጋፑዋ ናሹሞና ኔ ናሽካኔ። <verse eid="2CH 6:14"/><verse number="15" style="v" sid="2CH 6:15"/>ታ ዓዶ፥ ዳውቴም ኔ ጉሙርሲ ኬኤዜ ሃጊ ማዓንዳ ዎዞ ቃኣሎ ኔ ዶዲሼኔ፤ ኔ ኬኤዜ ፔቴ ፔቴ ዎዞ ቃኣላ ሃይሾ ሃኖ ኩሜኔ፤ <verse eid="2CH 6:15"/><verse number="16" style="v" sid="2CH 6:16"/>ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢዮ! ታ ዓዶ ዳውቴም፦ ‹ኔኤኒ ታኣኮ ዎጎ ዛጊ ካፔሢጉዲ ኔኤኮ ናኣታኣ ካፔቶ ኔ ዜርፆይዳፓ ዒስራዔኤሌይዳ ካኣታዺ ዴዓንዳ ዓሲ ቢያ ዎዴ ባይቃዓኬ› ጌዒ ኔ ጫኣቄ ጫኣቁሞ ሃሢ ኔ ዶዲሻንዳጉዲ ታ ኔና ሺኢቃኔ፤ <note caller="-" style="x"><char style="xo" closed="false">6፡16 </char><char style="xt" closed="false"><ref loc="1KI 2:4">1ካኣቶ. ማ 2፡4</ref>።</char></note> <verse eid="2CH 6:16"/><verse number="17" style="v" sid="2CH 6:17"/>ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢዮ! ኔ ዓይላሢ ዳውቴም ኔ ጉሙርሲ ኬኤዜ ሃጊ ማዓንዳ ዎዞ ቃኣሎ ቢያ ዓካሪ ኩንሣዎ» ጌዔኔ።<verse eid="2CH 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 6:18"/>ሃሣ ዒዚ፦ «ጎኔ ጌስቶያታቴ ፆኦሲ ዓሲና ዎላ ሃይካ ሳዓይዳ ናንጋንዳኖ? ጫሪንጫ ማዔቶዋ ጫሪንጮኮ ዑፃ ዓኣ ጫሪንጫ ኔና ጋራ ማሂ ዓርቃኒ ዳንዳዑዋሴ፤ ታኣኒ ማዤ ማኣሬሎንሢ ዎዚ ዻካንዳይ? <note caller="-" style="x"><char style="xo" closed="false">6፡18 </char><char style="xt" closed="false"><ref loc="2CH 2:6">2ፆኦሲ. ዓሃኬ 2፡6</ref>።</char></note> <verse eid="2CH 6:18"/><verse number="19" style="v" sid="2CH 6:19"/>ያዺ ማዔቴያ ናንጊና ናንጋ ጎዳ ማዔ ታ ፆኦዛሢዮ! ታኣኒ ኔ ዓይሌኬ፤ ታና ኔ ዓይላሢንታ ታ ሺኢቃ ሺኢጲፆንታ ሂንዳ ዛጌ፤ ታ ኔና ሺኢቂ ዔኤላ ዔኤሊፆዋ ዋይዜ። <verse eid="2CH 6:19"/><verse number="20" style="v" sid="2CH 6:20"/>‹ታ ሱንፃ ካኣሽኪንታንዳኔ› ኔኤኒ ጌዔ ሃያ ጌኤዦ ማኣሮ ባንሢ ሮኦሮንታ ዒባኖንታ ዛጌ፤ ታኣኒ ኔኤኮ ዓይላሢ ሃኖ ጌኤዦ ማኣሮ ባንሢ ዛጊ ሺኢቃ ሺኢጲፆዋ ታኣም ዋይዜ፤ <note caller="-" style="x"><char style="xo" closed="false">6፡20 </char><char style="xt" closed="false"><ref loc="DEU 12:11">ላሚ. ዎማ 12፡11</ref>።</char></note> <verse eid="2CH 6:20"/><verse number="21" style="v" sid="2CH 6:21"/>ታና ኔ ዓይላሢታቴያ ኔኤኮ ዴሮ ማዔ ዒስራዔኤሌ ዓሳ ዓኣፖ ካሮ ሃኖ ቤዞ ባንሢ ሺርሺ ሺኢቃኣና ሺኢጲፆ ኑኡሲ ዋይዜ፤ ኔኤኒ ናንጋ፥ ጫሪንጫ ዓኣዖ ኑም ዋይዜ፤ ዓቶንጎ ጌዔ።<verse eid="2CH 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 6:22"/>«ፔቴ ዓሲ ፔኤኮ ላጋሢኮ ዔኤቢ ፑርቲሴያ ማዔም ዎጌና ዓርቂንቲ ሃያ ጌኤዦ ማኣሮይዳ ዒንጎ ባኮ ሺኢሾ ቤዞ ባንሢ ሙኪ ‹ዒ ዻቢባኣያ ማዒፆ ጫኣቆንጎ› ጌይንታ ዎዶና፥ <verse eid="2CH 6:22"/><verse number="23" style="v" sid="2CH 6:23"/>ናንጊና ናንጋ ጎዳሢዮ! ኔኤኒ ጫሪንጫ ዓኣዖ ዋይዜ፤ ኔኤኮ ዓይሎም ዎጌ፤ ዻቢንቲ ማዼሢ ፔ ዻቢንቶ ጎይፆ ዎጊንታንዳጉዲ፥ ጌኤዣሢ ጌኤሺ ማዒ ኬስካንዳጉዲ ማዼ።<verse eid="2CH 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 6:24"/>«ኔኤኮ ዴራ ዒስራዔኤሌ ዓሳ ጎሜ ማዺ ኔና ዖዪሴያሮ ሜሌ ዓሲ ዔያቶ ዖሊ ባሼም ዔያታ ዒናፓ ዖዪ ኔ ባንሢ ማዒ ሃያ ጌኤዦ ማኣሮ ባንሢ ሙኪጋፓ ኔ ዔያቶ ማኣራንዳጉዲ ፔ ቶኦኮ ሂርኪዲ ሼሌዑሞና ኔና ሺኢቄቶ፥ <verse eid="2CH 6:24"/><verse number="25" style="v" sid="2CH 6:25"/>ኔኤኒ ጫሪንጫ ዓኣዖ ሺኢጲፆ ዔያቶኮ ዋይዜ፤ ኔኤኮ ዴሮኮ ጎሞ ዓቶም ጌዒ ዔያቶኮ ቤርታኣ ዓዶንሢና ዔያቶናም ኔ ዒንጌ ዓጬሎ ማሂ ዔያቶ ጌልዜ።<verse eid="2CH 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 6:26"/>«ዴራ ኔኤኮ ዻቢንቲ ኔና ዖዪሴያሮ ጌዒ ዒርዚ ዔያቶም ዋርቁዋጉዲ ኔ ላኣጌ ዎዶና ዔያታ ማዼ ዻቢንቶ ፔኤሲ ዔሪ፥ ሃኖ ጌኤዦ ማኣሮ ባንሢ ዛጊ፥ ሼሌዑሞና ኔና ሺኢቄቶ፥ <verse eid="2CH 6:26"/><verse number="27" style="v" sid="2CH 6:27"/>ናንጊና ናንጋ ጎዳሢዮ! ጫሪንጫ ዓኣዖ ዔያቶኮ ሺኢጲፆ ዋይዜ፤ ኔኤኮ ዓይሎ ዒስራዔኤሌ ዓሶም ጎሞ ዓቶንጎ ጌዔ፤ ፒዜ ማዔ ባኣዚ ዔያታ ማዻንዳጉዲ ዔያቶ ዔርዜ፤ ፆኦሲዮ! ዔያቶ ዴኔ ማዒ ዓታንዳጉዲ ኔ ዴሮም ኔ ዒንጌ ሃኖ ዓጬሎይዳ ዒርዚ ዋርቂሴ።<verse eid="2CH 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2CH 6:28"/>«ዓጬሎይዳ ናይዚንታ ዱማ ዱማ ሜቶንታ፥ ሃኣኮ ሄርቂ ዎዻ ዢባሬንታ ዓቢሢንታ ሙኬያ ማዔም፤ ጊንሣ ኔኤኮ ዴሮ ሞርኬ ዖላኒ ማንጌያ ማዔም፥ ሃሣ ኔኤኮ ዴሮይዳ ዱማ ዱማ ዶርዖንታ ሜታሳ ሃርጌንታ ኬዴያ ማዔም፥ <verse eid="2CH 6:28"/><verse number="29" style="v" sid="2CH 6:29"/>ዬያጉዲ ኔ ዴሮ ዒስራዔኤሌ ዓሶይዳ ዒኔ ሜንሢ ዖዪሳ ባኣዚ ሄሌም ኩጮ ዔያታ ሃኖ ጌኤዦ ማኣሮ ባንሢ ማሂ ኔና ሺኢቄቶ፥ <verse eid="2CH 6:29"/><verse number="30" style="v" sid="2CH 6:30"/>ሺኢጲፆ ዔያቶኮ ዋይዜ፤ ኔ ናንጋ ጫሪንጫ ዓኣዖ ሺኢጲፆ ዔያቶኮ ዋይዚ ጎሞ ዔያቶኮ ዓቶም ጌዔ፤ ዓሲኮ ዒኔና ጋሮይዳ ዓኣ ባኮ ቢያ ዛጊ ዔራሢ ኔና ሌሊኬ፤ ዬያሮ ፔቴ ፔቴ ዓሶም ማዼማጉዲ ኮይሳ ባኮ ዒንጌ። <verse eid="2CH 6:30"/><verse number="31" style="v" sid="2CH 6:31"/>ኔኤኮ ዴራ ኑ ዓዶንሢም ዔያቶ ዓጪ ማሂ ኔ ዒንጌ ሳዓ ናንጋ ዎዶና ቢያ ኔኤም ዓይሢንታያ ማዒ ኔና ቦንቻንዳጉዲ ዬያ ማዼ።<verse eid="2CH 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 6:32"/>«ሃኬ ዓጪዳ ናንጋ ዒስራዔኤሌ ዓሲ ማዒባኣ ዓሲ ኔኤኮ ሱንፆ ዼኤፑሞና ኔ ዴሮም ኔ ማዼ ዲቃሢ ሄርሺሳ ባኮና ቢያ ዋይዚ ሃያ ጌኤዦ ማኣሮይዳ ኔና ካኣሽካኒ፤ ሃሣ ሺኢቃኒ ሙኬቶ፥ <verse eid="2CH 6:32"/><verse number="33" style="v" sid="2CH 6:33"/>ኔኤኒ ዬያ ዓሢኮ ሺኢጲፆ ዋይዜ፤ ኔኤኮ ዴራ ዒስራዔኤሌ ዓሳ ማዻሢጉዲ ዓጮይዳ ዓኣ ዴሬ ቢያ ኔና ዔሪ ኔኤም ዓይሢንታያ ማዓንዳጉዲ ጫሪንጫ ዓኣዖ ዬያ ዓሢኮ ሺኢጲፆ ዋይዜ፤ ኔ ዒዛም ማዻንዳጉዲ ዒ ኔና ሺኢቃ ባኮ ቢያ ዒዛም ኩንሤ፤ ዬይ ያዺ ማዓኣና ሃይ ታ ኔኤም ማዤ ጌኤዦ ማኣራ ኔ ሱንፃ ካኣሽኪንታ ቤሲ ማዔሢ ዬይ ዓሳ ዔራንዳኔ።<verse eid="2CH 6:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2CH 6:34"/>«ዔያታ ፔኤኮ ሞርኮ ዖላኒ ኬስኮም ኔኤኮ ዴሮ ኔ ዓይሣ ዎዶና ዎካ ዓኣዖዋ ማዖም ሃኖ ኔ ዶኦሬ ካታሜሎና ታ ኔኤም ማዤ ሃኖ ጌኤዦ ማኣሮና ባንሢ ሺሪ ዔያታ ኔና ሺኢቄቶ፥ <verse eid="2CH 6:34"/><verse number="35" style="v" sid="2CH 6:35"/>ዔያቶኮ ሺኢጲፆ ዋይዜ፤ ኔኤኒ ጫሪንጫ ዓኣዖ ዔያታ ፔ ዛሎ ሺኢቃ ሺኢጲፆ ዋይዚ ዖሎና ዔያቶ ባሺሲሴ።<verse eid="2CH 6:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="2CH 6:36"/>«ዓሲ ዻቢንቲ ዓቱዋኣያታሢሮ ኔኤኮ ዴራ ጎሜ ማዺ ኔና ዖዪሴያ ማዔም ኔኤኒ ዻጋዺ ሞርካ ዔያቶ ዖሊ ባሺ ዲዒ ዔኪ ሜሌ ዓጪ ዓኣዻንዳጉዲ ማሄቴ ዬይ ዓጫ ዎዚ ሃኬታቴያ፥ <verse eid="2CH 6:36"/><verse number="37" style="v" sid="2CH 6:37"/>ዔያታ ዲዒንቴ ዓሲ ማዒ ዓኣ ዓጬሎይዳ ዓኣዖ፦ ‹ኑ ጎሜ ማዼኔ፤ ኑ ዻቤኔ፤ ዋይዚያ ኑ ዒፄኔ› ጌዒ ጎሞ ፔኤኮ ቡኡፄቴ ናንጊና ናንጋ ጎዳሢዮ! ዔያቶኮ ሺኢጲፆ ዋይዜ፤ <verse eid="2CH 6:37"/><verse number="38" style="v" sid="2CH 6:38"/>ዔያቶ ዲዒ ዔኪ ዓኣዼ፥ ዔያቶኮ ሞርኮ ዓጫ ዓኣዖ ጉቤ ዒናፓ ጎኑሞና ፒዜ ማሊሢና ዔያታ፦ ‹ኑ ዻቤያኣዋይ› ጌዒ ኔኤኒ ኑኡኮ ቤርታኣ ዓዶንሢም ዒንጌ ሃኖ ዓጬሎ ባንሢ፤ ሃሣ ጊንሣ ኔኤኒ ዶኦሬ ሃኖ ካታሜሎና ታኣኒ ኔኤም ማዤ ሃኖ ጌኤዦ ማኣሮና ባንሢ ሺሪ ሺኢቄቶ፥ <verse eid="2CH 6:38"/><verse number="39" style="v" sid="2CH 6:39"/>ዔያቶኮ ሺኢጲፆ ዋይዜ፤ ኔ ናንጋ ጫሪንጫ ዓኣዖ ዔያቶኮ ሺኢጲፆ ዋይዚ ዔያቶ ማኣሬ፤ ኔኤኮ ዴሮኮ ጎሞ ቢያ ዓቶም ጌዔ።<verse eid="2CH 6:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="2CH 6:40"/>«ታ ፆኦዛሢዮ! ሃሢ ኑ ባንሢ ዛጌ! ሃኖ ቤዞይዳ ኑ ሺኢቃ ሺኢጲፆ ቢያ ዋይዜ፤ <verse eid="2CH 6:40"/><verse number="41" style="v" sid="2CH 6:41"/>ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢዮ! ሃሢ ዔቂ ኔኤኮ ዎልቆኮ ማላታ ማዔ ጫኣቁሞ ሳኣፂኖና ዎላ ሃያ ጌኤዦ ማኣሮ ጌሌ፤ ዒኢካ ጋራ ናኣናና ናንጌ፤ ቄኤሳ ማዻ ባኮና ቢያ ዔያቶ ዓንጄ፤ ኔኤኮ ዴራ ኔ ኮሹሞና ዎዛዾንጎ፤ <verse eid="2CH 6:41"/><verse number="42" style="v" sid="2CH 6:42"/>ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢዮ! ኔኤኒ ዶኦሜ ካኣታሢ ሃሺፖ፤ ኔ ዓይላሢ ዳውቴ ኔ ናሽኬ ናሹሞ ማሊ ጶቂሤ» ጌዒ ሺኢቄኔ። <note caller="-" style="x"><char style="xo" closed="false">6፡42 </char><char style="xt" closed="false"><ref loc="PSA 132:8-10">ዓይኑ. 132፡8-10</ref>።</char></note><verse eid="2CH 6:42"/></para>
  <chapter eid="2CH 6"/>
  <chapter number="7" style="c" sid="2CH 7"/>
  <para style="s1">ጌኤዦ ማኣራ ማዾ ዓርቃኒ ኩንሢንቴ ዳምቦ</para>
  <para style="r">(<ref loc="1KI 8:62-66">1ካኣቶ. ማ 8፡62-66</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 7:1"/>ካኣቲ ሴሎሞኔ ሺኢጲፆ ሺኢቂ ጋጋፓማና ኔጉዋዖ ታሚ ጫሪንጫፓ ኬዲ ሚቺ ዒንጋኒ ሺኢሾና ባኮንታ ሜሌ ሺኢሾና ባኮዋ ሙዔኔ፤ ናንጊና ናንጋ ጎዳኮ ቦንቾ ፔጋሲ ዔርዛ ዓኣፒዳ ዱዱካ ፖዒያ ጌኤዦ ማኣሮ ኩሜኔ፤ <note caller="-" style="x"><char style="xo" closed="false">7፡1 </char><char style="xt" closed="false"><ref loc="LEV 9:23-24">ሌዊ. ዓኬ 9፡23-24</ref>።</char></note> <verse eid="2CH 7:1"/><verse number="2" style="v" sid="2CH 7:2"/>ናንጊና ናንጋ ጎዳኮ ቦንቾና ጌኤዦ ማኣራ ኩሜሢሮ ቄኤሳ ጌኤዦ ማኣሪ ጌላኒ ዳንዳዒባኣሴ። <verse eid="2CH 7:2"/><verse number="3" style="v" sid="2CH 7:3"/>ታማ ጫሪንጫፓ ኬዳሢ፥ ናንጊና ናንጋ ጎዳኮ ቦንቻ ጌኤዦ ማኣሮይዳ ሙኬሢ ዒስራዔኤሌ ዓሳ ዛጋዖ ባሊቶ ሳዖ ሄሊሲ ዚጊ፦</para>
  <para style="q" vid="2CH 7:3">«ናንጊና ናንጋ ጎዳ ኮሺ ጎዳኬ፤</para>
  <para style="q2" vid="2CH 7:3">ዒዛኮ ናሹማ ናኣናና ናንጋያኬ!»</para>
  <para style="m" vid="2CH 7:3">ጌዔኔ፤ ፆኦሲያ ጋላታኔ። <note caller="-" style="x"><char style="xo" closed="false">7፡3 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1ፆኦሲ. ዓሃኬ 16፡34</ref>፤ <ref loc="2CH 5:13">2ፆኦሲ. ዓሃኬ 5፡13</ref>፤ <ref loc="EZR 3:11">ዒዝ. 3፡11</ref>፤ <ref loc="PSA 100:5">ዓይኑ. 100፡5</ref>፤ <ref loc="PSA 106:1">106፡1</ref>፤ <ref loc="PSA 107:1">107፡1</ref>፤ <ref loc="PSA 118:1">118፡1</ref>፤ <ref loc="PSA 136:1">136፡1</ref>፤ <ref loc="JER 33:11">ዔር. 33፡11</ref>።</char></note> <verse eid="2CH 7:3"/><verse number="4" style="v" sid="2CH 7:4"/>ዬካፓ ካኣቲ ሴሎሞኔንታ ዒዛና ዎላ ዓኣ ዴሮ ቢያሢንታ ናንጊና ናንጋ ጎዳም ዒንጎ ባኣዚ ሺኢሼኔ፤ <verse eid="2CH 7:4"/><verse number="5" style="v" sid="2CH 7:5"/>ሴሎሞኔ ዒማና ላማታሚ ላምዖ ሺያ ባይና ፄኤታና ላማታሚ ሺያ ማራይ ፔቱሞና ዒንጎ ባኣዚ ማሂ ሺኢሼኔ፤ ዬያይዲ ካኣቲ ሴሎሞኔንታ ዒስራዔኤሌ ዴሮ ቢያሢንታ ጌኤዦ ማኣሮ ፆኦሲም ዱማዼያ ማሄኔ። <verse eid="2CH 7:5"/><verse number="6" style="v" sid="2CH 7:6"/>ቄኤሳ ዔያቶም ጊኢጊሾና ቤዛ ዔቄኔ፤ ዔያቶኮ ቤርቶ ዛላ ሌዊ ዓሳ ዔቂ ካኣቲ ዳውቴ ቤርታ ኮሺሲ፥ ናንጊና ናንጋ ጎዳ ቦንቾም ዓይኑሞ ዓይናዻ ዓንጋሞና፦ « ‹ናሹማ ዒዛኮ ናንጊና ናንጋያኬ› ፆኦሲ ጋላቱዋቴ» ጌይ ጌይ ናንጊና ናንጋ ጎዳ ጋላታኔ፤ ቄኤሳ ዛያሢ ዋርቃኣና ዴራ ጉቤ ዔቂ ዓኣኔ።<verse eid="2CH 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 7:7"/>ዬያጉዲ ሃሣ ዬኖ ኬሎ ሴሎሞኔ ጌኤዦ ማኣሮኮ ቤርቶ ዛላ ዓሳ ቡካ ጶኦኮኮ ሳዛ ዓኣ ቤዞ ናንጊና ናንጋ ጎዳም ዱማሴኔ፤ ሄሊሳዖ ሃሣ ጉቤ ሚቺ ዒንጎ ዒንጊፃ፥ ሃኣኮ ዒንጊፃ፥ ፔቱሞና ዒንጎ ዒንጊፆንታ ቆልሞኮዋ ማሎ ቢያ ናንጊና ናንጋ ጎዳም ሺኢሺ ዬኖ ቤዛ ሺኢሼኔ፤ ዬያ ዒዚ ማዼሢ ሞኦኖ ዓንጎና ኮሺንቴ፥ ናንጊና ናንጋ ጎዳም ዒንጎ ባኮ ሺኢሾ ቤዞይዳ ዬይ ቢያ ጌሢንታኒ ዳንዳዑዋኣሢሮኬ።<verse eid="2CH 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 7:8"/>ዒኢካ ጌኤዦ ማኣሮይዳ ሴሎሞኔንታ ዒስራዔኤሌ ዴሮ ቢያሢንታ ላንካይ ኬሊ ጉቤ ዉልሾ ዴማ ዴዒ ቦንቾ ቦንቾ ቦንቼኔ፤ ኬዶ ዛሎና ሃማቴ ባንሢ ዴንዳ ጎይፃፓ ዓርቃዖ ዴንዲ ዾኦሎ ዛሊና ጊብፄ ዓጮ ዛጶ ሄላንዳኣና ዓኣ ዓጫፓ ሙኬ ዴሮኮ ሚርጉማ ሃማዺኬ ጌይንቱዋኣያኬ። <verse eid="2CH 7:8"/><verse number="9" style="v" sid="2CH 7:9"/>ዒንጎ ባኮ ሺኢሾ ቤዞ ናንጊና ናንጋ ጎዳም ዱማሶ ዳምቦ ኩንሣኒ ላንካይ ኬሊ ዔያታ ዴዔኔ፤ ሃሣ ጊንሣ ላንካይ ኬሊ ቦንቾ ቦንቺ ጌዔስካፓ ሳላሳ ኬሎና ጋፒሲሢ ዳምቤ ኩንሢ ቦንቾ ጋፒሴኔ፤ <verse eid="2CH 7:9"/><verse number="10" style="v" sid="2CH 7:10"/>ዚሮ ጉቴሎ ጌይፃ፦ ላንካሳ ዓጊኖኮ ላማታሚ ሃይሣሳ ኬሎና ዓሳ ፔ ቤዞ ቤዞ ዴንዳንዳጉዲ ዴሮ ቢያ ሴሎሞኔ ዳኬኔ፤ ናንጊና ናንጋ ጎዳ ፔ ዴሮ ዒስራዔኤሌም፤ ሃሣ ፔ ዓይላሢ ዳውቴና ሴሎሞኔናም ዒንጌ ዓንጆሮ ዴራ ዎዛዺ ፔ ማኣሪ ማኣሪ ዴንዴኔ።<verse eid="2CH 7:10"/></para>
  <para style="s1">ፆኦሲ ሴሎሞኔም ላሚ ፔጋዺ ጴዼሢ</para>
  <para style="r">(<ref loc="1KI 9:1-9">1ካኣቶ. ማ 9፡1-9</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 7:11"/>ካኣቲ ሴሎሞኔ ጌኤዦ ማኣሮና ፔ ካኣቱሞ ማኣሮና ማዾ ቢያ ማሌ ጎይፆ ሜቴ ባኣዚ ባኣንቴ ጋፒሴስካፓ፥ <verse eid="2CH 7:11"/><verse number="12" style="v" sid="2CH 7:12"/>ናንጊና ናንጋ ጎዳ ፔቴ ኬሊ ዋንታ ሴሎሞኔም ፔጋዺ ጴዻዖ፦ «ኔኤኮ ሺኢጲፆ ታ ዋይዜኔ፤ ሃይ ጌኤዦ ማኣራ ታኣም ዒንጎ ባኣዚ ሺኢሾ ቤሲ ማዓንዳጉዲ ታ ዶኦሬኔ፤ <verse eid="2CH 7:12"/><verse number="13" style="v" sid="2CH 7:13"/>ዒርዚ ዋርቁዋጉዲ ታ ላኣጋ ዎዶና፤ ሃሣ ሃኣኮ ዓቢፃ ሙዓንዳጉዲ ታ ዳኬ ዎዶና፤ ታ ዴሮይዳ ዱማ ዱማ ዶርዖ ታ ኬይሴ ዎዶናኣ ቢያ፥ <verse eid="2CH 7:13"/><verse number="14" style="v" sid="2CH 7:14"/>ታ ዴራ ማዼ ፑርቶ ባኮይዳፓ ሃኪ ዖዪሢና ታና ሺኢቄቶ ጫሪንጫ ዓኣዖ ታ ዋይዛንዳኔ፤ ጎሞዋ ታ ዔያቶኮ ዓቶም ጋዓንዳኔ፤ ዓጮ ዔያቶኮ ታ ጊንሣ ማሊሻንዳኔ፤ <verse eid="2CH 7:14"/><verse number="15" style="v" sid="2CH 7:15"/>ሃያ ጌኤዦ ማኣሮ ታ ካፓንዳኔ፤ ሃያ ጌኤዦ ማኣሮይዳ ሺኢቂንታ ሺኢጲፆ ቢያ ታ ዋይዛንዳኔ፤ <verse eid="2CH 7:15"/><verse number="16" style="v" sid="2CH 7:16"/>ታኣኮ ሱንፃ ናንጊና ዒኢካ ካኣሽኪንታንዳጉዲ ሃያ ጌኤዦ ማኣሮ ታ ዶኦሪ ታኣም ዱማሴኔ፤ ታኣኮ ዒኖ ጋራ ጌሢ ቢያ ዎዴ ታ ካፓንዳኔ። <verse eid="2CH 7:16"/><verse number="17" style="v" sid="2CH 7:17"/>ኔ ዓዴ፥ ዳውቴ ማዼ ጎይፆ ቢያ ጉሙርቂንቲ ታኣም ኔ ማዼቶ፤ ታኣኮ ዎጎና ዳምቦና ካፒ ዓይሢፆዋ ታኣኮ ኔ ኩንሤቶ፥ <verse eid="2CH 7:17"/><verse number="18" style="v" sid="2CH 7:18"/>ኔኤኮ ዓዶ፥ ዳውቴም፦ ‹ኔኤኮ ዜርፆ ባኣካፓ ዒስራዔኤሌይዳ ካኣታዻንዳ ዓሲ ባይቃዓኬ› ጌዒ ታ ዒዛም ጉሙርሲ ኬኤዜ ቃኣሎ ጎይፆና ካኣቱሞ ታኣኒ ኔኤሲ ዶዲሻንዳኔ፤ <note caller="-" style="x"><char style="xo" closed="false">7፡18 </char><char style="xt" closed="false"><ref loc="1KI 2:4">1ካኣቶ. ማ 2፡4</ref>።</char></note> <verse eid="2CH 7:18"/><verse number="19" style="v" sid="2CH 7:19"/>ጋዓንቴ ኔኤና ኔ ዴሮና ታኣኒ ዒንሢም ዒንጌ ዎጎና ዓይሢፆና ካፒ ኩንሢባኣቴ፥ ሜሌ ፆኦዞ ዒንሢ ካኣሽኪ ዬያቶም ዚጌቴ፥ <verse eid="2CH 7:19"/><verse number="20" style="v" sid="2CH 7:20"/>ታኣኒ ዒንሢም ዒንጌ ዓጬሎይዳፓ ዳውሲንቲ ዓኣዺ ባይቃንዳጉዲ ታ ማሃንዳኔ፤ ታ ካኣሽኪንታ ቤሲ ማዓንዳጉዲ ታኣም ታኣኒ ዱማሴ፥ ሃኖ ጌኤዦ ማኣሬሎ ታ ሃሻንዳኔ፤ ሜሌ ዴራ ቢያ ሚኢጪ ዓማሎ ቤሲ ዒዞ ማሃንዳኔ» ጌዔኔ።<verse eid="2CH 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 7:21"/>ሃሣ ናንጊና ናንጋ ጎዳ፦ «ሃያ ጌኤዦ ማኣሮኮ ሃሢ ዼግ ጌዔ ቦንቾ ዓኣኔ፤ ዬኖና ጋዓንቴ ጌኤዦ ማኣሮኮ ኮርሳ ዴንዳ ዓሲ ቢያ ዲቃቲ ሄርሺሢና ‹ናንጊና ናንጋ ጎዳ ሃኖ ሳዔሎና ሃኖ ጌኤዦ ማኣሮናይዳ ዓይጎሮ ሃያጉዴ ባኣዚ ማዼይ?› ጌይ ዖኦጫንዳኔ፤ <verse eid="2CH 7:21"/><verse number="22" style="v" sid="2CH 7:22"/>ዓሳ ጊንሣ ማሂ፦ ‹ሃይ ባይሲንታ ቢያ ዔያቶ ሄሌሢ ጊብፄፓ ዔያቶ ዔኪ ኬሴ፥ ናንጊና ናንጋ ጎዳ ማዔ ዔያቶ ዓዶንሢኮ ፆኦዛሢ ዔያታ ሃሺ ሜሌ ፆኦዞ ካኣሽኪ ዬያም ዚጌሢሮኬ› ጋዓንዳኔ» ጌዔኔ።<verse eid="2CH 7:22"/></para>
  <chapter eid="2CH 7"/>
  <chapter number="8" style="c" sid="2CH 8"/>
  <para style="s1">ሴሎሞኔ ማዼያ ሜሌ ማዾ</para>
  <para style="r">(<ref loc="1KI 9:10-28">1ካኣቶ. ማ 9፡10-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 8:1"/>ሴሎሞኔ ጌኤዦ ማኣሮና ካኣቱሞ ማኣሮና ማዢ ጋፒሳንዳኣና ላማታሚ ሌዔ ማዔኔ፤ <verse eid="2CH 8:1"/><verse number="2" style="v" sid="2CH 8:2"/>ጊንሣ ሃሣ ካኣቲ ኪራሜ ሴሎሞኔም ዒንጌ ካታሞ ጊንሣ ዓካሲ ማዢ ዒስራዔኤሌ ዓሶ ዒኢካ ጌልዚ ዴይሤኔ። <verse eid="2CH 8:2"/><verse number="3" style="v" sid="2CH 8:3"/>ዒዚ ሃማቴና ፆባ ዓጮናኮ ዴማ ዎርቃ ዓጮ ዖሊ ፔ ዴማ ዎይሤኔ። <verse eid="2CH 8:3"/><verse number="4" style="v" sid="2CH 8:4"/>ዓሲ ናንጉዋ ዳውሎይዳ ዓኣ ታፅሞሬ ካታሞና ሃማቴይዳ ዓኣ ዖሎ ዓሶኮ ጋሎንታ ዓንጋሞንታ ጌሦ ካታሞ ቢያ ማዢ ዶዲሼኔ፤ <verse eid="2CH 8:4"/><verse number="5" style="v" sid="2CH 8:5"/>ዬያጉዲ ሃሣ ሴሎሞኔ ኬዶ ዛሎ ቤትሆሬና ዾኦሎ ዛሎ ቤትሆሬናይዳ ዓንጊና ዎዺንታ ጌሎ ካራ ዓኣያ፥ ዙሎ ኬልቂ ዲርቆና ካታማስኬንሢ ጊንሣ ዶዲሺ ማዤኔ፤ <verse eid="2CH 8:5"/><verse number="6" style="v" sid="2CH 8:6"/>ጊንሣ ሃሣ ባዕላቴ ካታሞንታ ዖሎ ዓሶኮ ጋሎንታ ዓንጋሞንታ ጌሦንዶ ካታማኣ፥ ፓራሢንታ ሳርጌሎ ዖይቶንታ ጌሦንዶ ካታማኣ፤ ዬያይዲ ሴሎሞኔ ዬሩሳላሜንታ ሊባኖኦሴንታይዳ ዒ ዎይሣ ዓጮ ጋራ ቢያ ማዣኒ ማሌ ባኮ ቢያ ማዢ ጋፒሴኔ። <verse eid="2CH 8:6"/><verse number="7-8" style="v" sid="2CH 8:7-8"/>ሴሎሞኔ ዎልቄ ማዾ ማዻንዳጉዲ ዔኬ ካኣናኔ ዓሲ ዓኣኔ፤ ዒስራዔኤሌ ዓሳ ዔያቶኮ ዓጮ ፔ ዓጪ ማሂ ዓርቄ ዎዶና ዬያቶ ዎዹዋዖ ሃሼኔ፤ ዬያታ ሃኖ ሄላንዳኣና ዓይሌ ማዒ ማዾ ማዻ፦ ሂኢታ ዓሶ፥ ዓሞራ ዓሶ፥ ፔርዛ ዓሶ፥ ሂዋዌ ዓሶንታ ዒያቡሳ ዓሶንታኬ፤ <verse eid="2CH 8:7-8"/><verse number="9" style="v" sid="2CH 8:9"/>ሴሎሞኔ ዒስራዔኤሌ ዜርፃፓ ዓይጎ ዓሲያ ካራሚ ማሂ ማዺሺባኣሴ፤ ዒማና ዒስራዔኤሌ ዓሳ፦ ፖኦሊሴ፥ ዖሎ ዓሶኮ ሱኡጌ፥ ሳርጌሎ ዖይቶ ዒሺ ዔኪ ዓኣዻ ዓሶኮ ሱኡጌ፤ ሃሣ ፓራሢና ዖላ ዓሲ ማዒ ማዻኔ። <verse eid="2CH 8:9"/><verse number="10" style="v" sid="2CH 8:10"/>ሴሎሞኔ ማዣ ዱማ ዱማ ባኮ ዎልቄና ማዻንዳጉዲ ጌይንቴ ዓይሎኮ ሱኡጌ ማዒ ላምዖ ፄኤታና ዶንጊታሚ ዒስራዔኤሌ ዓሲ ዶኦሪንቴኔ።<verse eid="2CH 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 8:11"/>ሴሎሞኔ ዒማና፦ «ናንጊና ናንጋ ጎዳኮ ጫኣቁሞ ሳኣፂና ጌሢንቴ ቤዛ ቢያ ዱማዼ ቤሲታሢሮ ታኣኮ ማቻ፥ ጊብፄ ዓጮ ዓሴላ ዒስራዔኤሌ ካኣቲ ዳውቴኮ ካኣቱሞ ማኣሮይዳ ናንጋኒ ኮይሱዋሴ» ጌዒ ጊብፄ ካኣቲ ናዎ፥ ዒዛኮ ማቾ ዳውቴ ካታማፓ ኬሲ ዒዚ ማዢሴ ሜሌ ማኣሪዳ ናንጋንዳጉዲ ዳኬኔ።<verse eid="2CH 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 8:12"/>ሴሎሞኔ ጌኤዦ ማኣሮኮ ቤርታ ሆታ ኮሼ፥ ፆኦሲም ዒንጎ ባኮ ሺኢሾ ቤዞ ዑፃ ሚቺ ዒንጎ ዒንጊፆ ናንጊና ናንጋ ጎዳም ሺኢሼኔ፤ <verse eid="2CH 8:12"/><verse number="13" style="v" sid="2CH 8:13"/>ሙሴ ዔርዜ ዎጋ ዓይሣ ጎይፆና ፔቴ ፔቴ ቦንቾ ኬሎና ጌይፃ፦ ሃውሾ ኬሎና ኬሎና፥ ዓጊኖ ፄኤራ ፄኤራ፥ ሌዓ ሌዓ ቦንቺንታ ሃይሦ ቦንቾ ኬሎንሢዳ ዬንሢያ፦ ሙኑቆ ፃኣዛ ጌሊባኣ ካሦ ሙዒ ቦንቾ ኬሎ፥ ሃኣካ ካፄም ማኣሎ ቡሪፆ ቦንቾንታ ዉልሾ ዴማ ዴዒ ቦንቾ ኬሎንታይዳ ናንጊና ናንጋ ጎዳም ዒንጎ ባኣዚ ሺኢሻኔ። <note caller="-" style="x"><char style="xo" closed="false">8፡13 </char><char style="xt" closed="false"><ref loc="EXO 23:14-17">ኬሲ. ማፃ 23፡14-17</ref>፤ <ref loc="EXO 34:22-23">34፡22-23</ref>፤ <ref loc="NUM 28:9">ፓይ. ማፃ 28፡9</ref>፤ <ref loc="NUM 29:39">29፡39</ref>፤ <ref loc="DEU 16:16">ላሚ. ዎማ 16፡16</ref>።</char></note> <verse eid="2CH 8:13"/><verse number="14" style="v" sid="2CH 8:14"/>ዒዛኮ ዓዴ ዳውቴ ኬሴ ዳምቦ ጎይፆጉዴያ ቄኤሶ ዔያታ ማዻ ቤዛ ቤዛ፥ ሃሣ ሌዊ ዓሳ ፆኦሲ ጋላቶ ዓይኑሞ ዓይናዺ ዓይናዺ ቄኤሶ ማኣዳንዳጉዲ ጊኢጊሼኔ፤ ዬያጉዲ ሃሣ ፆኦሲ ዓሢ፥ ዳውቴ ዓይሤ ጎይፆ ጌኤዦ ማኣሮ ካፓ ዓሳ ፔቴ ፔቴ ዲሮኮ ጋሮ ጌሎ ካሮ ካፒፆ ኬላ ኬላ ካፓንዳጉዲ ፓቂ ፓቂ ጌሤኔ። <verse eid="2CH 8:14"/><verse number="15" style="v" sid="2CH 8:15"/>ዔያታ ካኣቱሞ ማኣሮኮ ሜሆ ጌሦ ማኣሮንታ ሜሌ ባኮ ዛሎዋ ካኣቲ ዳውቴ ቄኤሶንታ ሌዊ ዓሶንታም ዓይሤ ጎይፆና ፔቴ ባኣዚታዖ ፓጪሱዋዖ ቢያ ባኮ ኮይሳሢጉዲ ጊኢጊሼኔ።<verse eid="2CH 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 8:16"/>ዒማና ሴሎሞኔ ማዻኒ ማሌ ማሊፃ ቢያ፥ ጌይፃ፦ ጌኤዦ ማኣሮኮ ዓይፆ ሹጮ ዾቂፆይዳፓ ዓርቃዖ ዴንዲ ጋፒንፆ ሄላንዳኣና ማዻ ቢያ ኮሺና ማዺንቴኔ።<verse eid="2CH 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 8:17"/>ዬካፓ ሴሎሞኔ ዔዶኦሜ ዓጮይዳ ባዞ ዓጫ ዓኣ፥ ዔፂዮንጋቤሬና ዔላቴ ጌይንታ ቤዞ ዓኣዼኔ፤ <verse eid="2CH 8:17"/><verse number="18" style="v" sid="2CH 8:18"/>ዒማና ካኣቲ ኪራሜ፦ ኮሺ ዔራ ማዔ ዋኣፆ ካኣሚሎ ዒሻዞንሢና ዔያቶኮ ሱኡጋ ዔኪ ሃንታ ዋኣፆ ካኣሚሎዋ ሴሎሞኔም ዳኬኔ፤ ዔያታ ሴሎሞኔኮ ዋኣፆ ካኣሚላ ማዻ ዓሶ ሱኡጎና ዎላ ዖፔሬ ጌይንታ ዓጮ ሙኬኔ፤ ዒኢካፓ ታጶ ዶንጎ ሺያ ኪሎ ማዓ ዎርቄ ዔኪ ሙኪ ካኣቲ ሴሎሞኔም ዒንጌኔ።<verse eid="2CH 8:18"/></para>
  <chapter eid="2CH 8"/>
  <chapter number="9" style="c" sid="2CH 9"/>
  <para style="s1">ሳኣባ ዓጮ ካኣቴላ ሴሎሞኔ ዛጋኒ ዴንዴሢ</para>
  <para style="r">(<ref loc="1KI 10:1-13">1ካኣቶ. ማ 10፡1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 9:1"/>ሳኣባ ዓጮ ካኣቴላ ካኣቲ ሴሎሞኔኮ ዲቃሢ ሄርሺሳ ዔራቶ ዛሎ ኬኤዚንታ ሃይሶ ቢያ ዋይዜኔ፤ ዬያሮ ዒዛ ሚርጌና ሜታሳ ዖኦጪሢ ዖኦጪ ዒ ዎዚ ጌይ ማሃቴያ ዋይዛኒ ዬሩሳላሜ ሙኬኔ፤ ዒዛ ዬሩሳላሜ ሙካኣና ሚርጌ ዒዞኮ ዶንዛ ማዓ ዺቢ ዓሲ ዎላ ዔኪ፥ ሳውቃ ቲሺንታ ዼኤሻንታ ሚርጌና ሚዛጳ ሹቺንታ ኮሺ ሚርጌ ዎርቄያ ጋኣሎና ጫኣኒኬ፤ ሴሎሞኔና ዒዛ ካኣማዖ ፔ ዒኖና ዖኦጫኒ ማሌ ባኮ ቢያ ዖኦጬኔ፤ <verse eid="2CH 9:1"/><verse number="2" style="v" sid="2CH 9:2"/>ዒዚያ ዒዛ ዖኦጬ ባኮ ቢያ ማሂ ኬኤዜኔ፤ ዒዞም ዒ ቡሊ ኬኤዛኒ ባሼያና ዔርቶ ዒፂ ዓኣሺንቲ ዓቴ ዖኦጪሢ ፔቴታዖ ባኣሴ። <verse eid="2CH 9:2"/><verse number="3" style="v" sid="2CH 9:3"/>ሳኣባ ዓጮ ካኣቴላ ሴሎሞኔ ዔራቶና ጌስታ ጌኤዞ ዋይዜኔ፤ ሃሣ ዒዚ ማዤ፥ ዒዛኮ ካኣቱሞ ማኣሮዋ ዛጌኔ፤ <verse eid="2CH 9:3"/><verse number="4" style="v" sid="2CH 9:4"/>ጊንሣ ሃሣ ሴሎሞኔ ሙዓንዳጉዲ ካሢንቲ ሺኢካ ሙዓ፥ ዒዚ ቢታንቶ ዒንጌ ዓሳ ናንጋ ቤዞና ዒዛኮ ካኣቱሞ ማኣራ ማዻ ዓሳ ፔ ማዾ ማዾ ዓርቂ ማዻ ጎይፆንታ ዬያ ማዾሮና ሙዖ ሙኡዚፆሮዋ ዓሳ ማኣዓ ማኣዓሢንታ ጌኤዦ ማኣሮይዳ ፆኦሲም ዒንጎ ባኮዋ ቢያ ዛጌኔ፤ ዬያ ዒዛ ዛጋኣና ዒዛ ዎንዴ ማሌሢፓ ዑሣ ዓኣዼ ዲቃሢ ዒዞ ሄርሺሴኔ።<verse eid="2CH 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 9:5"/>ዬካፓ ዒዛ ካኣቲ ሴሎሞኔ ኮራ፦ «ኔ ማዼ ባኮና ኔ ዔራቶኮ ዼኤፑሞ ታ ዓጫ ዓኣዖ ታ ዋይዜሢ ቢያ ጎኔኬ! <verse eid="2CH 9:5"/><verse number="6" style="v" sid="2CH 9:6"/>ጋዓንቴ ሃይካ ሙኪ ታኣኒ ታ ዓኣፒና ዛጋንዳያ ሄላንዳኣና ዬያ ኬኤዚንቴ ባኮ ጎኔኬ ታ ጌይባኣሴ፤ ዋዮና ታ ዋይዜሢ ዓኣፖና ታ ዛጌሢኮ ሄካሢታዖ ማዒባኣሴ፤ ጎኔ ኔኤኮ ዔራቶና ዖርጎቹሞና ታ ዓጫ ዓኣዖ ታኣኒ ዋይዜስካፓ ዑሣ ዓኣዼ ባሼኬ። <verse eid="2CH 9:6"/><verse number="7" style="v" sid="2CH 9:7"/>ኔ ቤርቶ ቢያ ዎዴ ሙኪ ሙኪ ኔኤኒ ዔራቶና ጌስታ ጌኤዞ ዋይዛ ዓሶና ኔኤኮ ዶንዞና ዎዚ ባሊቲና ዓኣያዳይ! <verse eid="2CH 9:7"/><verse number="8" style="v" sid="2CH 9:8"/>ናንጊና ናንጋ ጎዳ ማዔ ኔ ፆኦዛሢ ጋላቲንቶም! ዒዚ ኔና ዶኦሪ ዒስራዔኤሌኮ ካኣቲ ማሃኒ ዒዛኮ ኮሺ ማሊሢ ማዔሢሮ ጋላታ ዒዛ ሄሎም፤ ሃሣ ዒዚ ዒስራዔኤሌ ዓሶ ናሽካ ናሹማ ናንጊና ጋፑዋያ ማዔሢሮ ፂሉሞና ፒዜ ዎጊሢና ባይቁዋዖ ናንጋንዳጉዲ ኔ ማሆም ዒስራዔኤሌኮ ኔና ዒ ካኣቲ ማሂ ዶኦሬኔ» ጌዔኔ።<verse eid="2CH 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 9:9"/>ዒማና ዒንጋኒ ዔኪ ሙኬ ባኮ ቢያ ካኣቲ ሴሎሞኔም ዒዛ ዒንጌኔ፤ ዒዛ ዒንጌ ባካ፦ ዖይዶ ሺያ ኪሎፓ ባሼ ማዓ ዎርቄ፥ ሚርጌ ዺቢ ሳውቃ ቲሺንታ ዼኤሻንታ ሚዛጲ ሹቺንታኬ፤ ዒዛ ሴሎሞኔም ዒንጌ ሳውቃ ቲዦ ሚርጉማፓ ባሻያ ማዔ ሳውቃ ቲሺ ዬያኮ ቤርታ ዒዛም ዔኪ ሙኪንቲ ቤቂባኣሴ። <note caller="-" style="x"><char style="xo" closed="false">9፡9 </char><char style="xt" closed="false"><ref loc="MAT 12:42">ማቲ. 12፡42</ref>፤ <ref loc="LUK 11:31">ሉቃ. 11፡31</ref>።</char></note><verse eid="2CH 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 9:10"/>ዖፔሬ ዓጫፓ ሴሎሞኔም ዎርቆ ዔኪ ሙኬ ካኣቲ ኪራሜና ካኣቲ ሴሎሞኔናኮ ዓሳ ዒኢካፓ ዺቢ ዴኤሎ ዚቢቆንታ ሚዛጲ ሹቺንታ ዔኪ ዬዔኔ፤ <verse eid="2CH 9:10"/><verse number="11" style="v" sid="2CH 9:11"/>ሴሎሞኔ ዬያ ዴኤሎ ዚቢቆና ጌኤዦ ማኣሮንታ ዒዛኮ ካኣቱሞ ማኣሮኮዋ ጊዖ ሳኖ፥ ፆኦሲ ቦንቾም ዓይናዻ ናኣቶኮ ጎኦሎንታ ፔቴ ሻሺና ዋርቆ ጎኦሎዋ ኮሼኔ፤ ዬያጉዴ ዴኤሎ ዚቢቆና ኮሾና ዓይኑሞ ዓንጋሞጉዴያ ሃያኮ ቤርታ ዪሁዳ ዓጫ ፔቴታዖ ጴዺ ቤቂባኣሴ።<verse eid="2CH 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 9:12"/>ሳኣባ ዓጮ ካኣቴላ ኮዔ ባኮንታ ዖኦጬ ባኮዋ ቢያ ካኣቲ ሴሎሞኔ ዒዞም ዒንጌኔ፤ ዬይ ዒዚ ዒንጌ ባካ ዒዛ ዔኪ ሙኬ ባኮይዳፓ ቢያ ባሼኬ፤ ዬካፓ ዒዛ ፔ ዓሶና ዎላ ፔ ዓጮ ማዒ ዴንዴኔ።<verse eid="2CH 9:12"/></para>
  <para style="s1">ካኣቲ ሴሎሞኔኮ ቆሎ ሚርጉሞ</para>
  <para style="r">(<ref loc="1KI 10:14-25">1ካኣቶ. ማ 10፡14-25</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 9:13"/>ካኣቲ ሴሎሞኔ ሌዓ ሌዓ ላማታሚ ሃይሦ ሺያ ኪሎ ማዓ ዎርቄ ዔካኔ፤ <verse eid="2CH 9:13"/><verse number="14" style="v" sid="2CH 9:14"/>ዬይ ዎርቃ ኮርሞ ኮርማ ዓሳ ዒዛም ጪጋሢንታ ኮርማዖ ቃሲ ዒዚ ዴንቃሢንታ፤ ዬያጉዲ ሃሣ ዓሬቦ ዓጮ ካኣቶንታ ዒስራዔኤሌኮ ዱማ ዱማ ፓቆና ዓጮ ዎይሣ ዓሳ ጊኢራ ጌዒ ጪጋሢንታ ቃሱዎንቴኬ።<verse eid="2CH 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 9:15"/>ሴሎሞኔ ላምዖ ፄኤታ ዼኤፒ ዼኤፒ ጊቲማ ኮሺሲ፥ ዬያ ጊቲሞ ፔቴ ፔቴሢኮ ዑፆ ላንካይ ኪሎ ማዓ ዎርቄና ጳርቂ ኮሼኔ። <verse eid="2CH 9:15"/><verse number="16" style="v" sid="2CH 9:16"/>ዬያጉዲ ሃሣ ሃይሦ ፄኤታ ዻካ ዻካ ጊቲማ ኮሺሲ ፔቴ ፔቴ ጊቲሞኮ ዑፆ ሃይሦ ኪሎ ማዓ ዎርቄና ጳርቂ ኮሼኔ፤ ዬያቶ ቢያ «ሊባኖኦሴ ዴኤሎ» ጌይንታ ዳልጎ ማኣራ ጌሤኔ።<verse eid="2CH 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 9:17"/>ሃሣ ዒዚ ዳርሲ ዓቺና ፔቴ ዼኤፒ ካኣታ ዴዓ ዖይታ ኮሺ ዎርቄና ዑፆ ጳርቂ ሚዛጲሴኔ። <verse eid="2CH 9:17"/><verse number="18-19" style="v" sid="2CH 9:18-19"/>ዬያ ካኣቱሞ ዖይቶ ኬስኪ ዴዓኒ ላሆ ጌዲጉዲ ጊዒ ኬስኮ ባኣዚ ዓኣኔ፥ ዬያ ፔቴ ፔቴ ጌዶኮ ዓጫ ዓጫ ላምዖ ዎሊ ዑፃ ታጶ ላምዖ ዞቢ ኮሺንቴኔ፤ ዬያ ካኣታ ዴዓ ዖይቶኮ ቶኪ ጌሦ ዎርቄና ኮሺንቴ ባኣዚ ዓኣኔ፤ ዖይቶኮ ሚዛቆ ዛሎና ሻውሎ ዛሎናይዳ ኩቺ ጌሦ ቤሲ ዓኣኔ፤ ኩጮ ጌሦሢኮ ኮይላ ኮይላ ፔቴ ፔቴ ዞቢ ማሊሲ ማዦና ባኣዚ ዔቂ ዓኣኔ። ሜሌ ዓይጎ ዓጪ ካኣቲኮዋ ዬያ ማላ ካኣታ ዴዓ ዖይታ ፔቴታዖ ባኣሴ።<verse eid="2CH 9:18-19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 9:20"/>ካኣቲ ሴሎሞኔ ዑዦ ዑሽካ ዓንጎንታ «ሊባኖኦሴ ዴኤሎ» ጌይንታ ዼኤፖ ማኣሮይዳ ዓኣ ሜሃ ቢያ ጌኤሺ ዎርቄይዳፓ ኮሺንቴያኬ፤ ካኣቲ ሴሎሞኔ ዎዶና ቢራ ዑሣ ዓኣዼ ሚርጌሢሮ ዔኤቢ ጉሪ ባኣዚ ማዔኔ። <verse eid="2CH 9:20"/><verse number="21" style="v" sid="2CH 9:21"/>ካኣቲ ኪራሜም ማዻ ዓሳ ዒሻ ዋኣፆ ካኣሚሎና ዎላ ዼኤፖ ዋኣፆ ዑፃ ሃንቲ ቴርሴሴ ዴንዳ ዋኣሢ ካኣሚሌ ሴሎሞኔኮ ዓኣኔ፤ ዬያታ ዋኣፆ ካኣሚላ ሃይሦ ሌዔይዳ ፔቴና ዴንዲ ዎርቄንታ ቢራ ዓንጊንታ ዳርሲ ዓቺንታ ቃኣራንታ ቲኢኪንታ ዔኪ ዒዛም ሙካኔ።<verse eid="2CH 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 9:22"/>ካኣቲ ሴሎሞኔ ሳዖይዳ ዓኣ ካኣታፓ ቢያ ባሼ ዖርጎቺ፤ ሃሣ ዔራ ዓሲኬ፤ <verse eid="2CH 9:22"/><verse number="23" style="v" sid="2CH 9:23"/>ዓጮ ቢያይዳ ዓኣ ዓሳ ቢያ ፆኦሲ ዒዛም ዒንጌ ዔራቶና ዒ ጌስታ ጌኤዞ ዋይዛኒ ዒዛ ኮይላ ሙካኒ ኮዓኔ፤ <verse eid="2CH 9:23"/><verse number="24" style="v" sid="2CH 9:24"/>ዒዛ ባንሢ ሙካ ዓሳ ቢያ ቢራ ዓንጊ፥ ዎርቄ፥ ማኣዓ፥ ዖልዚ ዓንጋሞ፥ ሳውቃ ቲሺንታ ዼኤሻንታ፥ ፓሮንታ ባቁሎንታ ዒንጋኒ ዔኪ ሙካኔ፤ ዬይ ዓሳ ዔኪ ሙካሢ ሌዓ ሌዓኬ።<verse eid="2CH 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 9:25"/>ሴሎሞኔኮ ሳርጌሎ ዖይቶና ፓራሢናም ዖይዶ ሺያ ባርታ፥ ዬያጉዲ ሃሣ ታጶ ላምዖ ሺያ ፓሮ ዒሻ ዓሲያ ዓኣኔ፤ ዬያቶይዳፓ ዛሎ ዒዚ ዒዛና ዎላ ዬሩሳላሜይዳ ዴዓንዳጉዲ፥ ዛሎ ጊንሣ ዱማ ዱማ ካታሞይዳ ፓቂንቲ ዴዓንዳጉዲ ጌሤኔ። <note caller="-" style="x"><char style="xo" closed="false">9፡25 </char><char style="xt" closed="false"><ref loc="1KI 4:26">1ካኣቶ. ማ 4፡26</ref>።</char></note> <verse eid="2CH 9:25"/><verse number="26" style="v" sid="2CH 9:26"/>ሴሎሞኔ ዔፕራፂሴ ዎራፓ ፒሊስፄኤሜ ዓጮና ዴንዲ ጊብፄ ዓጮ ዛጶ ሄላንዳኣና ዓኣ ካኣቶ ቢያ ፔኤም ጊኢሪሻኔ፤ <note caller="-" style="x"><char style="xo" closed="false">9፡26 </char><char style="xt" closed="false"><ref loc="GEN 15:18">ማዢ. ማፃ 15፡18</ref>፤ <ref loc="1KI 4:21">1ካኣቶ. ማ 4፡21</ref>።</char></note> <verse eid="2CH 9:26"/><verse number="27" style="v" sid="2CH 9:27"/>ዒዚ ካኣታዺ ዎይሤ ዎዶና ዬሩሳላሜይዳ ዓንጎ ቢራ ቃንፆጉዲ፤ ሊባኖኦሴ ሚፆኮዋ ሚርጉማ ዪሁዳ ጌሜሮ ዴማ ቢያ ቤዛ ባቃላ ቦኦቦጉዲ ማዔኔ። <verse eid="2CH 9:27"/><verse number="28" style="v" sid="2CH 9:28"/>ሴሎሞኔም ጊብፄና ሜሌ ዓጮናፓ ቢያ ፓራሢ ዔኪ ሙኮኔ። <note caller="-" style="x"><char style="xo" closed="false">9፡28 </char><char style="xt" closed="false"><ref loc="DEU 17:16">ላሚ. ዎማ 17፡16</ref>።</char></note><verse eid="2CH 9:28"/></para>
  <para style="s1">ሴሎሞኔ ዎይሤ ዎዶ ሃይሳ ቃሚሢና</para>
  <para style="r">(<ref loc="1KI 11:41-43">1ካኣቶ. ማ 11፡41-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 9:29"/>ሴሎሞኔ ካኣታዺ ዎይሤ ዎዶኮ ሜሌ ሃይሳ ዓይፃፓ ዴንዲ ጋፖ ሄላንዳኣና ፆኦሲ ማሊፆ ኬኤዛ ናኣታኣኔ ፃኣፔ ሃይሶይዳ፥ ሴኤሎ ዓጮይዳ ሾይንቴ ፆኦሲ ማሊፆ ኬኤዛ ዓኪያ ኬኤዜ ፆኦሲ ማሊፆይዳ፥ ሃሣ ዒስራዔኤሌ ካኣቲ ዒዮርቢዓሜ ካኣታዼ ዎዶና ፆኦሲ ማሊፆ ኬኤዛ ዒዶም ፆኦሲ ፔጋሲ ዻዌ ባካ ፃኣፒንቲ ዓኣሢዳ ፃኣፒንቲ ዓኣኔ። <verse eid="2CH 9:29"/><verse number="30" style="v" sid="2CH 9:30"/>ሴሎሞኔ ናንጎ ቤዞ ዬሩሳላሜይዳ ማሂ ጉቤ ዒስራዔኤሌይዳ ዖይዲታሚ ሌዔ ካኣታዼኔ። <verse eid="2CH 9:30"/><verse number="31" style="v" sid="2CH 9:31"/>ዬካፓ ዒዚ ሃይቂ ፔ ዓዶ ዳውቴ ካታማ ዱኡቴም ቤዞይዳ ዒዛኮ ናኣዚ ሮቢዓሜ ካኣታዼኔ።<verse eid="2CH 9:31"/></para>
  <chapter eid="2CH 9"/>
  <chapter number="10" style="c" sid="2CH 10"/>
  <para style="s1">ኬዶ ዛሎይዳ ናንጋ ዒስራዔኤሌ ፃጶኮ ዋይዞ ዒፆ</para>
  <para style="r">(<ref loc="1KI 12:1-20">1ካኣቶ. ማ 12፡1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 10:1"/>ሮቢዓሜ ካኣታሣኒ ኮዓ ኬዶ ዛሎይዳ ናንጋ ዒስራዔኤሌ ዴራ ሴኬሜይዳ ቡኪንቲ ዒዛ ካፓሢሮ ሮቢዓሜ ዒኢካ ዴንዴኔ። <verse eid="2CH 10:1"/><verse number="2" style="v" sid="2CH 10:2"/>ካኣቲ፥ ሴሎሞኔሮ ፑኒ ጊብፄ ዓጮ ዴንዲ ዒኢካ ዓኣ ናባፄ ናኣዚ ዒዮርቢዓሜ ዬያ ዋይዚ ማዒ ሙኬኔ፤ <verse eid="2CH 10:2"/><verse number="3" style="v" sid="2CH 10:3"/>ዒማና ዒስራዔኤሌ ዓጮኮ ኬዶ ዛሎይዳ ናንጋ ፃጳ ኪኢታ ዳኪ ዒዛ ዔኤሊሳዖ ዒዛና ዎላ ሮቢዓሜ ኮራ ሙኪ፦ <verse eid="2CH 10:3"/><verse number="4" style="v" sid="2CH 10:4"/>«ኔ ዓዴ፥ ሴሎሞኔ ኑና ሄርቂ ዎይሢ ሜታሴኔ፤ ሃሢ ኔኤኒ ዬያ ኑም ሼሌዒሲ ናንጎ ኑኡኮ ኔ ጊኢጊሼቴ ኔኤም ኑ ዎርቃንዳኔ» ጌዔኔ።<verse eid="2CH 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 10:5"/>ሮቢዓሜ ዔያቶም፦ «ሃሢ ዴንዲጋፓ ሃይሣሳ ኬሎና ማዒ ሙኩዋቴ» ጋዓዛ፥ ዴራ ዴንዴኔ።<verse eid="2CH 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 10:6"/>ዬካፓ ካኣቲ፥ ሮቢዓሜ ዒዛኮ ዓዶ ሴሎሞኔ ዞራ ዶንዞ ፔቴይዳ ዔኤሊ፦ «ታኣኒ ዴሮም ዎዚ ጌይ ኬኤዛንዳቴያ ዒንሢ ታኣም ኬኤዛ ባኣዚ ዓኣ?» ጌዒ ዖኦጬኔ።<verse eid="2CH 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 10:7"/>ዶንዛ ማሃዖ፦ «ኔኤኒ ዴሮም ኮሺ ማዻያ ማዒ፥ ሃሣ ዔያታ ዖኦጬ ባኮኮ ጊኢጋ ማሂሢ ኔ ማሄቴ ዔያታ ቢያ ዎዴ ጉሙርቂንቲ ኔኤም ዎርቃያ ማዓንዳኔ» ጌዔኔ።<verse eid="2CH 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 10:8"/>ሮቢዓሜ ጋዓንቴ ዶንዛ ዞሬ ዞሮ ቦሂ ዒዛና ዎላ ዲጬ፥ ዒዛኮ ላጌ ማዒ ዒዛ ዞራ ዼጌዞንሢ ኮይላ ዴንዲ፦ <verse eid="2CH 10:8"/><verse number="9" style="v" sid="2CH 10:9"/>«ታ ዎዳንዳቴያ ዒንሢ ታኣም ኬኤዛ ባኣዚ ዓኣ? ዎይሢፆ ሼኤሌዒሲ ዎይሣንዳጉዲ ታና ዖኦጫ ዴሮም ታ ዎዚ ጌዒ ማሆንዶይ?» ጌይ ዖኦጬኔ።<verse eid="2CH 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 10:10"/>ዔያታ ማሃዖ፦ «ዔያቶም ‹ታኣኮ ኬኤሎ ናዖማ ታ ዓዶኮ ኬርናፓ ባሼ ዓንዲርቃያ ማዓንዳኔ! <verse eid="2CH 10:10"/><verse number="11" style="v" sid="2CH 10:11"/>ታ ዓዴ ዒንሢ ሄርቂ ሜታሲ ዎይሤኔ፤ ታኣኒ ሃሢ ዬያይዳፓ ባሼ ዒንሢ ሄርቂ ዎይሣንዳኔ፤ ታ ዓዴ ዒንሢ ዢራፓና ጳርቄኔ፤ ታ ጋዓንቴ ዒንሢ ጉማሬና ጳርቂ ሜታሳንዳኔ!› ሂዚ ጌዔ» ጌኤኔ።<verse eid="2CH 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 10:12"/>ዬካፓ ሃይሣሳ ኬሎና ዒዮርቢዓሜንታ ዴሮንታ ቢያ ሮቢዓሜ «ሙኩዋቴ» ጌዔ ኬሎና ማዒ ሙኬኔ፤ <verse eid="2CH 10:12"/><verse number="13" style="v" sid="2CH 10:13"/>ዒማና ካኣቲ፥ ሮቢዓሜ ጋርቾ ዶንዛ ዒዛ ዞሬ ዞሮ ሃሺ ዴሮም ፑርታ ሃይሴ ጌስቲሢ ዓርቄኔ፤ <verse eid="2CH 10:13"/><verse number="14" style="v" sid="2CH 10:14"/>ዒዛኮ ላጋ ዒዛ ዞሬ ጎይፆ፦ «ታ ዓዴ ዒንሢ ሄርቂ ሜታሲ ዎይሤኔ፤ ጋዓንቴ ታ ዬያፓ ባሼ ዒንሢ ሄርቂ ሜታሲ ዎይሣንዳኔ፤ ታ ዓዴ ዒንሢ ዢራፓና ጳርቄኔ፤ ታ ዒንሢ ጋዓንቴ ጉማሬና ጳርቂ ሜታሳንዳኔ!» ጌዔኔ። <verse eid="2CH 10:14"/><verse number="15" style="v" sid="2CH 10:15"/>ዬይ ያዺ ማዔሢ ሴኤሎይዳፓ ሙኬ፥ ፆኦሲ ማሊፆ ኬኤዛ ዓኪያ ዛሎና ናባፄ ናኣዚ ዒዮርቢዓሜ ዛሎ ናንጊና ናንጋ ጎዳ ኬኤዜ ባካ ኩማንዳጉዲኬ፤ ካኣቲ ሮቢዓሜ ዴሮኮ ማሊፆ ቦሂ ሃሼሢ ፆኦሲ ዬያይዳኒ ማሌያታሢሮኬ።<verse eid="2CH 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 10:16"/>ዒማና ካኣቲ ሮቢዓሜ ዴራ ዖኦጬ ዖኦጪፆ ቦሂ ሃሼሢ ዴራ ዔራዖ፦ «ዳውቴንታ ማኣሮ ዓሶንታ ማይ ኑም ዓይጎዎዳንዳይ? ዔያታ ኑም ፔቴታዖ ማዼ ባኣዚ ባኣሴ! ዒስራዔኤሌ ዴሬዮቴ! ዒንሢ ማኣሪ ማኣሪ ማዒ ዴንዱዋቴ! ሮቢዓሜ ፔ ማሊፆ ጎይፆ ማዾንጎ!» ጌዔኔ።</para>
  <para style="p" vid="2CH 10:16">ዬያይዲ ዒስራዔኤሌ ዴራ ሮቢዓሜም ዋይዞ ዒፂ ፔ ማኣሪ ማኣሪ ማዒ ዴንዴኔ። <note caller="-" style="x"><char style="xo" closed="false">10፡16 </char><char style="xt" closed="false"><ref loc="2SA 20:1">2ሳሙ. 20፡1</ref>።</char></note><verse eid="2CH 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 10:17"/>ዬያሮ ሮቢዓሜ ዪሁዳ ዓጮይዳ ዓኣ ዴሮ ዑፃ ሌሊ ካኣታዼኔ።<verse eid="2CH 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 10:18"/>ዬካፓ ካኣቲ ሮቢዓሜ ዎልቄና ማዺሾ ዓሶኮ ሱኡጋሢ፥ ዓዶኒራሜ ዒስራዔኤሌ ዓሶ ኮይላ ዳኬኔ፤ ዔያታ ጋዓንቴ ሹቻ ዒዛ ዹይ ዎዼኔ፤ ዒማና ሮቢዓሜ ዑካዺ ሳርጌሎ ዖይቶ ቶጊ ዬሩሳላሜ ዴንዳዖ ቶሊ ዓቴኔ። <verse eid="2CH 10:18"/><verse number="19" style="v" sid="2CH 10:19"/>ዒማፓ ዓርቃዖ ኬዶ ዛሎ ዓጫ ናንጋ ዒስራዔኤሌ ዓሳ ካኣቲ ዳውቴ ማኣሮም ዋይዞ ዒፃያ ማዔኔ።<verse eid="2CH 10:19"/></para>
  <chapter eid="2CH 10"/>
  <chapter number="11" style="c" sid="2CH 11"/>
  <para style="s1">ሼማዒያ ኬኤዜ ፆኦሲ ማሊፆ</para>
  <para style="r">(<ref loc="1KI 12:21-24">1ካኣቶ. ማ 12፡21-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 11:1"/>ሮቢዓሜ ዬሩሳላሜ ሄላዖ ዪሁዳና ቢኢኒያሜና ፃጳፓ ዶኦሪ ዶኦሪ ኬሶና ፔቴ ፄኤታና ሳሊታሚ ሺያ ዖልዚ ዖላንዳ ጎኦባ ዓሲ ዔኪ ፔቴይዳ ቡኩሴኔ፤ ዬያ ዒ ማዼሢ ዒስራዔኤሌ ፃጶ ዖሊ ዓጮ ቢያ ፔ ዴማ ማሃኒ ማሊኬ። <verse eid="2CH 11:1"/><verse number="2" style="v" sid="2CH 11:2"/>ጋዓንቴ ፆኦሲ ማሊፆ ኬኤዛ ሼማዒያም ፆኦሲ፦ <verse eid="2CH 11:2"/><verse number="3" style="v" sid="2CH 11:3"/>«ሮቢዓሜም፥ ዬያጉዲ ዪሁዳና ቢኢኒያሜ ፃጶ ቢያሢም፤ ሃሣ ሃንጎ ዴሮማኣ ቢያ፥ <verse eid="2CH 11:3"/><verse number="4" style="v" sid="2CH 11:4"/>‹ዒንሢኮ ዒጊኖ ዒስራዔኤሌ ዓሶ ዖላኒ ዴንዲፖቴ፤ ቢያሢ ዒንሢ ማኣሪ ማኣሪ ዴንዱዋቴ፤ ዬይ ባካ ያዺ ማዔሢ ታኣኒ ማዖንጎ ጌዔምኬ› » ጌይ ኬኤዛንዳጉዲ ዓይሤኔ። ዬያሮ ዬያታ ቢያሢ ናንጊና ናንጋ ጎዳ ጌዔ ባኮ ዋይዚ፥ ዒዮርቢዓሜ ዖሊፆ ሃሺ ፔ ማኣሪ ማኣሪ ዴንዴኔ።<verse eid="2CH 11:4"/></para>
  <para style="s1">ሮቢዓሜ ካታሞ ኬልቂ ዶዲሺ ዲርቄሢ</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 11:5"/>ሮቢዓሜ ዬሩሳላሜይዳ ናንጊ ሱንፃ ሃካፓ ዴማ ፓይዲንታ ዪሁዳና ቢኢኒያሜ ካታሞም ዶዲ ኬኤሌ ኮሼኔ፤ ዬንሢ ካታሞንሢ፦ <verse eid="2CH 11:5"/><verse number="6" style="v" sid="2CH 11:6"/>ቤኤቴሌሄሜ፥ ዔፃሜ፥ ቴቆዓ፥ <verse eid="2CH 11:6"/><verse number="7" style="v" sid="2CH 11:7"/>ቤትፁሬ፥ ሶኮ፥ ዓዱላሜ፥ <verse eid="2CH 11:7"/><verse number="8" style="v" sid="2CH 11:8"/>ጋኣቴ፥ ማሬሻ፥ ዚፔ፥ <verse eid="2CH 11:8"/><verse number="9" style="v" sid="2CH 11:9"/>ዓዶራይሜ፥ ላኪሼ፥ ዓዜቃ፥ <verse eid="2CH 11:9"/><verse number="10" style="v" sid="2CH 11:10"/>ፆርዓ፥ ዓያሎኔንታ ኬብሮኦኔንታኬ። <verse eid="2CH 11:10"/><verse number="11" style="v" sid="2CH 11:11"/>ሮቢዓሜ ዬንሢ ካታሞንሢ ዶዲሺ ኬልቂ ዲርቄኔ፤ ፔቴ ፔቴ ካታሞም ፔቴ ፔቴ ሱኡጌ ዶኦሬኔ፤ ሃሣ ፔቴ ፔቴዞንሢዳ ሃኣኮ፥ ሪሚታፓ ኮሾ ዛይቶንታ ዎይኖ ዑዦንታ፥ <verse eid="2CH 11:11"/><verse number="12" style="v" sid="2CH 11:12"/>ዬያጉዲ ሃሣ ጊቲማና ዎርሢና ቡኩሴኔ፤ ዬያይዲ ዪሁዳና ቢኢኒያሜ ዓጮ ፔ ዴማ ማሄኔ።<verse eid="2CH 11:12"/></para>
  <para style="s1">ቄኤሶና ሌዊ ዓሶናኮ ዒስራዔኤሌይዳፓ ዪሁዳ ሙኪፆ</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 11:13"/>ቄኤሶና ሌዊ ዓሶና ዒስራዔኤሌ ዓጮ ጉቤይዳፓ ዾኦሎ ዛሎና ዓኣ ዪሁዳ ዓጮ ሙኬኔ፤ <verse eid="2CH 11:13"/><verse number="14" style="v" sid="2CH 11:14"/>ዒስራዔኤሌ ካኣቲ ዒዮርቢዓሜና ዒዛ ቤዛ ጌሊ ካኣታዼ፥ ዒዛኮ ዜርፃ ሌዊ ዓሳ ናንጊና ናንጋ ጎዳኮ ቄኤሴ ማዒ ማዻንዳጉዲ ዓይሢንቲባኣሢሮ ሌዊ ዓሳ ዪሁዳና ዬሩሳላሜና ዔያታ ሙኬሢ ቆልሞ ሄንቆ ቤዞና ሜሌ ባኮ ቢያ ሃሺኬ። <verse eid="2CH 11:14"/><verse number="15" style="v" sid="2CH 11:15"/>ዒዮርቢዓሜ ጌሜራ ጌሜራ ሜሌ ዓሳ ፔ ፆኦዞ ካኣሽካ ቤዛ ማዻንዳያ፥ ሃሣ ፃላሄና ዒዚ ፔኤም ጌማቶ ማሊሲ ኮሼ ሜሌ ፆኦዞናም ዚጊ ካኣሽካንዳ ፔ ቄኤሴ ዶኦሪናኣኮኬ። <note caller="-" style="x"><char style="xo" closed="false">11፡15 </char><char style="xt" closed="false"><ref loc="1KI 12:31">1ካኣቶ. ማ 12፡31</ref>።</char></note> <verse eid="2CH 11:15"/><verse number="16" style="v" sid="2CH 11:16"/>ዬያፓ ዔቄያና ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ፒዜ ማዔ ዓያናና ካኣሽካኒ ኮዓ ዓሲ ዒስራዔኤሌ ፃጶ ቢያይዳፓ ኬስኬ ሚርጌ ዴሬ ናንጊና ናንጋ ጎዳ ማዔ ዔያቶኮ ቤርታኣ ዓዶንሢ ፆኦዛሢም ዒንጎ ባኣዚ ሺኢሻኒ ሌዊ ዓሶ ጊንፆ ዬሩሳላሜ ሙኬኔ። <verse eid="2CH 11:16"/><verse number="17" style="v" sid="2CH 11:17"/>ዬይ ማዻ ዪሁዳ ካኣቲ ዶዲሼኔ፤ ሃይሦ ሌዔ ጉቤ ሴሎሞኔኮ ናኣዚ ሮቢዓሜ ዔያታ ማኣዴኔ፤ ዔያታ ካኣቲ ዳውቴና ሴሎሞኔና ማዼ ጎይፆ ማዺ ኮሺና ናንጌኔ።<verse eid="2CH 11:17"/></para>
  <para style="s1">ሮቢዓሜ ማኣሮ ዓሶ</para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 11:18"/>ሮቢዓሜ ማሃላቴ ጌይንታ ላኣሊስኬኖ ዔኬኔ፤ ዒዞኮ ዓዴ ያሪሞቴ ጌይንታያ ዳውቴኮ ናይ ማዓዛ፥ ዒንዳ ዒዛኮ ዓቢጋይሎ ጌይንታያ ዒሴዬኮ ናኣዚ ናዖ ዔኤሊዓቤ ናዎኬ፤ <verse eid="2CH 11:18"/><verse number="19" style="v" sid="2CH 11:19"/>ማሃላቴ ዪዑሼ፥ ሼማሪያና ዛሃሜ ጌይንታ ሃይሦ ዓቲንቄ ሮቢዓሜም ሾዔኔ፤ <verse eid="2CH 11:19"/><verse number="20" style="v" sid="2CH 11:20"/>ዬካፓ ናንጊቤቃ ሮቢዓሜ ማዕካ ጌይንታ ዓቤሴሎሜ ናዎ ዔኪ፦ ዓቢያ፥ ዓታዬ፥ ዚዛና ሼሎሚቴ ጌይንታ ዖይዶ ዓቲንቄ ናይ ሾዔኔ። <verse eid="2CH 11:20"/><verse number="21" style="v" sid="2CH 11:21"/>ሮቢዓሜኮ ዎሊ ዑፃ ታጶ ሳሊ ላኣሊና ላሂታሚ ጊንፃኣ ማቾንሢ ማዓ ላኣሊያ ዓኣኔ፤ ዔያቶይዳፓ ላማታሚ ሳሊ ዓቲንቄና ላሂታሚ ዉዱሮ ናይ ዒ ሾዔኔ፤ ዒዚ ፔኤኮ ላኣሎና ጊንፃኣ ማቾንሢ ቢያሢዳፓ ማዕካ ጋዓዞ፥ ዓቤሴሎሜ ናዎ ባሼ ናሽካኔ፤ <verse eid="2CH 11:21"/><verse number="22" style="v" sid="2CH 11:22"/>ዬያጉዲ ሃሣ ፔኤኮ ናኣቶይዳፓ ቢያ ማዕካይዳፓ ሾይንቴ ዓቢያ ጎዖሢ ባሼ ዒ ናሽካኔ፤ ዬያሮ ዒዚ ፔ ቤዛ ናኣዚ ዓቢያ ካኣታዻንዳጉዲ ማሌሢሮ ዒዛ ጌርሲንሢኮ ሱኡጌ ማሂ ዒዛ ዶኦሬኔ፤ <verse eid="2CH 11:22"/><verse number="23" style="v" sid="2CH 11:23"/>ሮቢዓሜ ዔራቶና ፔኤኮ ዓቲንቆ ናኣቶ ሱኡጌ ማሂሢና፥ ኬልቂ ዲርቆና ዪሁዳና ቢኢኒያሜ ካታሞ ቢያይዳ ሱኡጌ ማሂ ዶኦሬኔ፤ ዬካፓ ዔያቶም ኮይሳ ባኣዚ ቢያ ሚርጌና ዒንጌኔ፤ ሚርጌ ላኣሊያ ዔያታ ዔካንዳጉዲ ማሄኔ።<verse eid="2CH 11:23"/></para>
  <chapter eid="2CH 11"/>
  <chapter number="12" style="c" sid="2CH 12"/>
  <para style="s1">ጊብፄ ዓጮ ካኣቲ ዪሁዳ ዓጮ ዖሌሢ</para>
  <para style="r">(<ref loc="1KI 14:25-28">1ካኣቶ. ማ 14፡25-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 12:1"/>ሮቢዓሜ ካኣቱሞና ዔርቲ ዶዴስካፓ ዒዛንታ ዒስራዔኤሌ ዴራኣ ቢያ ናንጊና ናንጋ ጎዳኮ ዎጎ ሃሼኔ፤ <verse eid="2CH 12:1"/><verse number="2" style="v" sid="2CH 12:2"/>ናንጊና ናንጋ ጎዳም ዔያቶኮ ዓኣ ጉሙርቂንቲፆ ዔያታ ፓጪሴሢሮ ሮቢዓሜ ካኣታዼ ዶንጋሳ ሌዖና ጊብፄ ካኣቲ ሺሻቄ ዬሩሳላሜ ዖሌኔ። <verse eid="2CH 12:2"/><verse number="3" style="v" sid="2CH 12:3"/>ዒዚ ዒማና ፔቴ ሺያና ላምዖ ፄኤታ ሳርጌላ ዖይታ፥ ላሂታሚ ሺያ ፓራሢና ዖላ ዓሲንታ ሃሣ ሚርጉማ ፓይዲንቱዋ ፖኦሊሴ ዔኪ ዬሩሳላሜ ዖሌኔ፤ ዬያ ሺሻቄኮ ዖላ ዓሶ ባኣካ ሊቢያ ዓሲ፥ ሱካ ዓሲንታ ዒቶጲያ<note caller="+" style="f"><char style="fr" closed="false">12፡3 </char><char style="fq" closed="false">ዒቶጲያ </char><char style="ft" closed="false">ጋዓዞ፦ ዔብሬ ዓሶ ሙኡጮ ማፃኣፓ «ኩሼ» ጋዓኔ፤ ዬና ዓጫ ጊብፄ ዓጮኮ ዾኦሎኬ፤ ዬና ቤዛ ሃሢ ዓኣ ዒቶጲያንታ ሱዳኔንታኮ ዛላ ዓጪ ፔ ጋራ ማሃኔ።</char></note> ዓሲያኣ ዓኣኔ፤ <verse eid="2CH 12:3"/><verse number="4" style="v" sid="2CH 12:4"/>ካኣቲ፥ ሺሻቄ ኬልቂ ዲርቆና ዪሁዳ ካታሞ ዖሊ፥ ዴንዲ ዬሩሳላሜ ሄላንዳኣና ዓርቄኔ።<verse eid="2CH 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 12:5"/>ዬካፓ ፆኦሲ ማሊፆ ኬኤዛ ሼማዒያ ሺሻቄ ዒጊጪ ዬሩሳላሜይዳ ዎሊ ዑፃ ቡኪንቲ ዓኣ ካኣቲ ሮቢዓሜና ዪሁዳ ዓሶ ሱኡጎ ኮይላ ዴንዲ፦ «ናንጊና ናንጋ ጎዳ ኬኤዛዖ ‹ታና ዒንሢ ሃሼሢሮ ታ ዒንሢ ሺሻቄ ኩጫ ሃሼኔ› ጋዓኔ» ጌዔኔ።<verse eid="2CH 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 12:6"/>ካኣቲ ሮቢዓሜና ዪሁዳ ዓሶኮ ሱኡጋ ዔያታ ጎሞ ማዺ ዻቤሢ ዔሬሢሮ፦ «ናንጊና ናንጋ ጎዳ ማዼ ባካ ቢያ ፒዜኬ» ጌዔኔ።<verse eid="2CH 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 12:7"/>ናንጊና ናንጋ ጎዳ ዒማና ዔያታ ፔና ሂርኪዴሢ ዛጋዖ ፔ ማሊፆ ኬኤዛ ሼማዒያ ላሚ ጊንሣ፦ «ሃሣ ዔያታ ፔኤኮ ዻቢንቶ ዔሪ ፔ ቶኦኮ ሂርኪዴሢሮ ታ ዔያቶ ባይዛዓኬ፤ ሺሻቄ ዔያቶ ዖላ ዎዶና ዑኬና ዓውሲ ታ ዔያቶ ዻቂሻንዳኔ፤ ዬሩሳላሜይዳ ዻጎና ታ ማዻኒ ማሌ ባኮ ቢያ ማዻዓኬ፤ <verse eid="2CH 12:7"/><verse number="8" style="v" sid="2CH 12:8"/>ያዺ ማዔቴያ ታ ዎይሣሢና ሳዖ ካኣታ ዎይሣሢናኮ ባኣካ ዓኣ ዱሙሞ ዔያታ ዔራንዳጉዲ ሺሻቄ ዖሎና ዔያቶ ባሺ ዎይሣንዳኔ» ጌዔኔ።<verse eid="2CH 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 12:9"/>ዬያሮ ካኣቲ ሺሻቄ ዖሎና ባሺ ዬሩሳላሜ ጌሊ፥ ጌኤዦ ማኣሮና ካኣቱሞ ማኣሮናይዳ ዓኣ ባኮ ቢያ፤ ሃሣ ካኣቲ ሴሎሞኔ ዎርቆይዳፓ ኮሺሴ ጊቲማኣ ዓቱዋንቴ ቡሪ ዔኬኔ። <note caller="-" style="x"><char style="xo" closed="false">12፡9 </char><char style="xt" closed="false"><ref loc="1KI 10:16-17">1ካኣቶ. ማ 10፡16-17</ref>፤ <ref loc="2CH 9:15-16">2ፆኦሲ. ዓሃኬ 9፡15-16</ref>።</char></note> <verse eid="2CH 12:9"/><verse number="10" style="v" sid="2CH 12:10"/>ካኣቲ ሮቢዓሜ ሺሻቄ ዔኬ ጊቲሞ ቤዛ ሜሌ ጊቲማ ሞኦና ዓንጊና ኮሺሲ ካኣቱሞ ማኣሮ ዲሮ ካሮ ካፓ ዓሶኮ ሱኡጋ ጌሣንዳጉዲ ዒንጌኔ። <verse eid="2CH 12:10"/><verse number="11" style="v" sid="2CH 12:11"/>ካኣቲ ጌኤዦ ማኣሪ ሙካ ዎዶና ዎዶና ዬንሢ ካፓዞንሢ ዬንሢ ጊቲሞንሢ ዓርቂ ካኣቲና ዎላ ሃንታኔ፤ ካኣቲ ዴንዴስካፓ ማሂ ካፓዞንሢ ዔያቶኮ ቆልዖ ጋራ ጌሣኔ፤ <verse eid="2CH 12:11"/><verse number="12" style="v" sid="2CH 12:12"/>ዒማና ካኣቲ ሮቢዓሜ ፔኤኮ ዻቢንቶ ዔሪ ፔና ሂርኪዴሢሮ ናንጊና ናንጋ ጎዳኮ ጎሪንታ ጋፒንሢ ሜቶ ሄሊሲባኣሴ፤ ዎዎይቴይ ጌዔቴ ዪሁዳ ዓጮ ቢያይዳ ኮሺ ባኣዚ ማዔኔ።<verse eid="2CH 12:12"/></para>
  <para style="s1">ሮቢዓሜ ካኣቱሞ ዎዶ ሃይሳ ቃሚሢና</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 12:13"/>ሮቢዓሜ ናንጎ ቤዞ ፔኤኮ ፆኦሲ ካኣሽኪንታኒ ዒስራዔኤሌ ዓጮ ጉቤሢ ባኣካፓ ዶኦሬ ዬሩሳላሜ ካታማ ማሂ ታጶ ላንካይ ሌዔ ዎይሤኔ፤ ፔኤኮ ካኣቱሞ ቢታንቶዋ ዶዲሼኔ፤ ዒዚ ካኣታዻ ዎዶና ሌዓ ዒዛኮ ዖይዲታሚ ፔቴ ሌዔኬ፤ ሮቢዓሜኮ ዒንዳ ናዕማ ጌይንታያ ዓሞኦኔ ዓጫ ሾይንቴ ዓሲኬ፤ <verse eid="2CH 12:13"/><verse number="14" style="v" sid="2CH 12:14"/>ናንጊና ናንጋ ጎዳ ጋዓ ባኣዚ ዔራኒ ሮቢዓሜ ኮዒባኣሢሮ ፑርታ ባኣዚ ማዼኔ፤<verse eid="2CH 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 12:15"/>ካኣቲ ሮቢዓሜ ማዼ ባካ ቢያ ዓይፃፓ ጋፖ ሄላንዳኣና፤ ዬያጉዲ ሃሣ ዒዛ ማኣሮ ዓሶኮ ሃይሳ ፆኦሲ ማሊፆ ኬኤዛ ሼማዒያና ዒዶ ሃይሶና ማፃኣፓ ፃኣፒንቲ ዓኣኔ፤ ዒማና ሮቢዓሜና ዒዮርቢዓሜና ጋፑዋ ዖልዚ ቢያ ዎዴ ዖልታኔ፤ <verse eid="2CH 12:15"/><verse number="16" style="v" sid="2CH 12:16"/>ዬካፓ ሮቢዓሜ ሃይቂ ዳውቴ ካታማ ዓኣ ካኣታ ዱኡታ ቤዛ ዱኡቴኔ፤ ዒዛ ቤዛ ዒዛኮ ናኣዚ ዓቢያ ካኣታዼኔ።<verse eid="2CH 12:16"/></para>
  <chapter eid="2CH 12"/>
  <chapter number="13" style="c" sid="2CH 13"/>
  <para style="s1">ዓቢያ ዒዮርቢዓሜ ዖሌሢ</para>
  <para style="r">(<ref loc="1KI 15:1-8">1ካኣቶ. ማ 15፡1-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 13:1"/>ዒዮርቢዓሜ ዒስራዔኤሌይዳ ካኣታዼንቴ ታጶ ሳላሳ ሌዖና ዓቢያ ዪሁዳይዳ ካኣታዼኔ፤ <verse eid="2CH 13:1"/><verse number="2" style="v" sid="2CH 13:2"/>ዒዚ ዬሩሳላሜይዳ ዴዒ ሃይሦ ሌዔ ካኣታዼኔ፤ ዒንዳ ዒዛኮ ሚካያ ጎዖዛ ጊቢዓ ካታማ ሾይንቴያ ዑሪዔኤሌ ናዎኬ።</para>
  <para style="p" vid="2CH 13:2">ዓቢያና ዒዮርቢዓሜና ባኣካ ዼኤፒ ዖልዚ ኬስኬኔ፤ <verse eid="2CH 13:2"/><verse number="3" style="v" sid="2CH 13:3"/>ዒማና ዓቢያ ዖይዶ ፄኤታ ሺያ ዖላ ዓሲና ኬስካዛ፥ ዒዮርቢዓሜ ሃሣ ሳሊ ፄኤታ ሺያ ፖኦሊሴ ዔኪ ዎሊ ዖሎ ዓርቄኔ።<verse eid="2CH 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 13:4"/>ዬካፓ ጌሜራ ሚርጌ ዓኣ ዔፕሬኤሜ ዓጮይዳ ዓኣ ፄማራይሜ ጌይንታ ዹካ ኬስኪ ዔቄኔ፤ ዒዚ ፔኤኮ ዑኡዞ ዼጊዲ ዒዮርቢዓሜና ዒስራዔኤሌ ዓሶናም ጉቤ ዒላታዖ፦ «ኮሺ ዋይዙዋቴ! <verse eid="2CH 13:4"/><verse number="5" style="v" sid="2CH 13:5"/>ዳውቴና ዒዛኮ ዜርፆና ዒስራዔኤሌይዳ ናኣናና ካኣታዻያ ማዒፆ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ዳውቴና ዎላ ዓጊፁዋ ጫኣቁሞ ጫኣቄሢ ዒንሢ ዔሩዋዓዳ? <verse eid="2CH 13:5"/><verse number="6" style="v" sid="2CH 13:6"/>ሂዳዖ ሃይ ሴሎሞኔ ካራማሢ፥ ናባፄ ናኣዚ፥ ዒዮርቢዓሜ ፔ ጎዳሢ ሴሎሞኔም ዋይዞ ዒፄንቴሞ፤ <verse eid="2CH 13:6"/><verse number="7" style="v" sid="2CH 13:7"/>ዬያ ሌሊቱዋንቴ ናንጊቤቃ ዒዮርቢዓሜ ናንጊም ማሉዋ ፑርታ ዓሲ ቡኩሴኔ፤ ዬይ ዓሳ ሃጊ ናይ ዓኣያ፥ ሃሣ ዒናዺባኣያ ማዒ ዔያቶ ቃዛኒ ዳንዳዒባኣ ሮቢዓሜኮ ካራ ባይዜኔ። <verse eid="2CH 13:7"/><verse number="8" style="v" sid="2CH 13:8"/>ሃሢ ዒንሢ ናንጊና ናንጋ ጎዳ ዳውቴ ዜርፆም ዒንጌ ካኣቱሞ ቢታንቶ ባይዛኒ ማሌኔ፤ ዒንሢኮ ዬይ ማሊፃ ጋፒንሢ ሄላንዳጉዲ ሚርጌ ዖልዚ ዓሲ ዒንሢ ጊኢጊሼኔ፤ ዒንሢኮ ካኣሽኮ ባኣዚ ማዓንዳጉዲ ዒዮርቢዓሜ ዎርቄና ኮሺሴ፥ ናኣሮ ማላ ባኮ ዒንሢ ዔኪ ሙኬኔ። <verse eid="2CH 13:8"/><verse number="9" style="v" sid="2CH 13:9"/>ናንጊና ናንጋ ጎዳኮ ቄኤሴ ማዔ ዓኣሮኔ ዜርፆና ሌዊ ዓሶና ዒንሢ ዳውሴኔ፤ ዬያቶ ቤዛ ሜሌ ዴራ ማዻ ጎይፆ ዒንሢም ቄኤሴ ዒንሢ ዶኦሬኔ፤ ፔቴ ዚያ ጌማይ ሃንጎ ላንካይ ማራይ ዔኪ ዒንሢ ኮራ ሙካ ዓይጎ ዓሲያ ፆኦሲቱዋ ዒንሢኮ ሜሌ ፆኦዞም ቄኤሴ ማሂ ዒንሢ ዶዶኦራኔ።<verse eid="2CH 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 13:10"/>«ኑኡኒ ጋዓንቴ ሃሢያ ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢ ካኣሽካኔ፤ ዒዛ ሃሺ ኑ ሺኢካዓኬ፤ ዓኣሮኔ ዜርፆ ማዔ ቄኤሳ ፆኦዛሢም ማዺፆ ሃሺባኣሴ፤ ሌዊ ዓሳኣ ቤርታ ማዻ ጎይፆ ቄኤሶ ማኣዳንዳኔ፤ <verse eid="2CH 13:10"/><verse number="11" style="v" sid="2CH 13:11"/>ቢያ ኬላ ጉቴና ዋንቴና ሳውማ ኮሺ ማዔ ዑንጆና ቆልሞ ሚቺ ዒንጎ ዒንጊፆዋ ናንጊና ናንጋ ጎዳም ሺኢሻኔ፤ ዳምቦ ጎይፆና ጌኤሾና ጋባዶይዳ ካሦ ዒንጎ ዒንጊፆዋ ሺኢሻኔ፤ ዔያታ ቢያ ኬላ ዋንቶ ዋንቶ ዎርቃፓ ኮሺንቴ፥ ፖዖ ጌሦ ሻርኖ ዑፃ ዓኣ ፖዖ ፖዒሣኔ፤ ኑኡኒ ፆኦሲኮ ዓይሢፆ ማዺ ኩንሣኔ፤ ዒንሢ ጋዓንቴ ፆኦሲ ሃሼኔ። <verse eid="2CH 13:11"/><verse number="12" style="v" sid="2CH 13:12"/>ኑኡኮ ሱኡጋሢ ፔኤሮ ዒዛ ፆኦዛሢኬ፤ ዒዛኮ ቄኤሳ ዛዮ ዋርቃኒ ጊኢጊንቲ ሃይካ ኑኡና ዎላ ዓኣኔ፤ ዔያታ ዛያሢ ዋርቆ ዓርቃዛ ኑኡኒ ዒንሢ ዖሊፆ ዓርቃንዳኔ፤ ዬያሮ ዒስራዔኤሌ ዓሲዮቴ! ፔቴታዖ ዒንሢ ዖሎና ባሻኒ ኑና ዳንዳዑዋኣሢሮ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ቤርታኣ ዓዶንሢ ፆኦዛሢና ዖልቲፖቴ!» ጌዔኔ።<verse eid="2CH 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 13:13"/>ዒማና ዒዮርቢዓሜ ፔኤኮ ዖሎ ዓሶኮ ዛሎ ዪሁዳ ዖሎ ዓሶኮ ጊንፆ ዛሊና ካቲ ዖላንዳጉዲ ዳካዖ ዓቴ ዓሶ ሃሣ ዪሁዳ ዖሎ ዓሶኮ ቤርቲና ሙኪ ዖሎ ዓርቃንዳጉዲ ዓይሤኔ። <verse eid="2CH 13:13"/><verse number="14" style="v" sid="2CH 13:14"/>ዪሁዳ ዓሳ ኮይሎ ዛጊ ዔያታ ማንጊንቴሢ ዴንቃዖ ዔያቶ ማኣዳንዳጉዲ ናንጊና ናንጋ ጎዳ ባንሢ ዒላቴኔ፤ ቄኤሳኣ ዛዬ ዋርቄኔ፤ <verse eid="2CH 13:14"/><verse number="15" style="v" sid="2CH 13:15"/>ዪሁዳ ዓሳ ዑኡዞ ዼጊዲ ዒላቴኔ፤ ዬካፓ ካኣቲ ዓቢያ ዔያቶ ዔኪ ኬስኬም ዔያታ ዖሌኔ፤ ፆኦሲ ዒማና ዒዮርቢዓሜንታ ዒስራዔኤሌኮ ዖሎ ዓሶዋ ዖሊ ባሼኔ፤ <verse eid="2CH 13:15"/><verse number="16" style="v" sid="2CH 13:16"/>ዬያሮ ዒስራዔኤሌ ዓሳ ዪሁዳ ዓሶ ቤርታፓ ጳሽኬኔ፤ ፆኦሲ ዒስራዔኤሌ ዓሶ ዪሁዳ ዴሮም ዓኣሢ ዒንጌኔ፤ <verse eid="2CH 13:16"/><verse number="17" style="v" sid="2CH 13:17"/>ዓቢያና ዒዛኮ ዖሎ ዓሶና ዒስራዔኤሌ ዓሶ ዖሎና ባሺ ዺቢ ዓሲ ዎዼኔ፤ ዬኖ ዖሎና ዒስራዔኤሌ ፖኦሊሶፓ ዶኦሪንቴያ ዶንጎ ፄኤታ ሺያ ፖኦሊሴ ሃይቄኔ። <verse eid="2CH 13:17"/><verse number="18" style="v" sid="2CH 13:18"/>ዪሁዳ ዴራ ናንጊና ናንጋ ጎዳ ማዔ ዔያቶኮ ቤርታኣ ዓዶንሢ ፆኦዛሢና ጉሙርቂንቴሢሮ ዒስራዔኤሌ ዓሶ ዖሊ ባሼኔ፤ ዒስራዔኤሌ ዓሳ ጋዓንቴ ቦርሲንቴኔ።<verse eid="2CH 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 13:19"/>ዓቢያ ዒዮርቢዓሜኮ ዖሎ ዓሶ ዒማና ዳውሴኔ፤ ዒዮርቢዓሜ ካታሞይዳፓ፦ ቤኤቴኤሌ፥ ዪሻናንታ ዔፕሮኔንታ ዔያቶኮ ኮይላ ዓኣ ጉርዶና ዎላ ዖሊ ባሺ ዒ ዓርቄኔ፤ <verse eid="2CH 13:19"/><verse number="20" style="v" sid="2CH 13:20"/>ዒማፓ ዒዮርቢዓሜ ዓቢያ ካኣታዺ ዓኣ ዎዶና ዎልቄ ዴንቂ ዔቃኒ ዳንዳዒባኣሴ፤ ናንጊና ናንጋ ጎዳ ጋፒንፆይዳ ዒዮርቢዓሜ ዎዼኔ።<verse eid="2CH 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 13:21"/>ዓቢያ ጋዓንቴ ኮሺ ዶዲ ዶዲ ዓኣዼኔ፤ ታጶ ዖይዶ ላኣሊ ዔኪ ላማታሚ ላምዖ ዓቲንቄ ናይና ታጶ ላሆ ዉዱሮ ናይ ሾዔኔ፤ <verse eid="2CH 13:21"/><verse number="22" style="v" sid="2CH 13:22"/>ካኣቲ ዓቢያኮ ሃንጎ ዓቴ ሃይሶንታ ዒዚ ጌስቴ ጌኤዞንታ ማዼ ማዻኣ ቢያ ፆኦሲ ማሊፆ ኬኤዛ ዒዶ ፃኣፔ ማፃኣፖይዳ ፃኣፒንቲ ዓኣኔ።<verse eid="2CH 13:22"/></para>
  <chapter eid="2CH 13"/>
  <chapter number="14" style="c" sid="2CH 14"/>
  <para style="s1">ዪሁዳ ካኣቲ ዓኣሳ ዒቶጲያ ዓሶ ዖሎና ባሼሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 14:1"/>ካኣቲ ዓቢያ ሃይቂ፥ ዳውቴ ካታማ ካኣታ ዱኡታ ቤዛ ዱኡቴኔ፤ ዬካፓ ዒዛ ቤዛ ዒዛኮ ናኣዚ ዓኣሳ ካኣታዼኔ፤ ዒ ካኣታዼ ዎዶና ዓጫ ታጶ ሌዔ ኮሺ ናንጌኔ። <verse eid="2CH 14:1"/><verse number="2" style="v" sid="2CH 14:2"/>ዓኣሳ ዒማና ኮሺ፥ ሃሣ ፒዜ ማዔ ባኣዚ ማዺ ናንጊና ናንጋ ጎዳ፥ ፔኤኮ ፆኦዛሢ ዎዛሴኔ፤ <verse eid="2CH 14:2"/><verse number="3" style="v" sid="2CH 14:3"/>ዒ ዎዎዴይ ጌዔቴ ሜሌ ፆኦዞም ዒንጎ ባኮ ዒንጎ ቤዞና ጌሜሮይዳ ዓኣ ሜሌ ዓሳ ፔ ፆኦዞ ካኣሽካ ቤዞ ቢያ ባይዜኔ፤ ካኣሽካኒ ኮሾና ዻኣቦ ሹጮ ሜንሤኔ፤ ዓሼራ ጌይንታ ላኣሎ ፆኦዜሎኮዋ ማሊሲ ማዦና ባኮ ቲቂ ቲቂ ኬኤሬኔ፤ <verse eid="2CH 14:3"/><verse number="4" style="v" sid="2CH 14:4"/>ዓኣሳ ዪሁዳ ዴሮ ዔያታ ፔኤኮ ቤርታኣ ዓዶንሢኮ ጎዳ ማዔ ፆኦዛሢ ማሊፆ ማዺ ኩንሣንዳጉዲ፥ ዒዛኮ ዎጎንታ ዓይሢፆንታ ካፓንዳጉዲ ዓይሤኔ፤ <verse eid="2CH 14:4"/><verse number="5" style="v" sid="2CH 14:5"/>ሜሌ ዓሳ ፔ ፆኦዞ ዚጊ ካኣሽካ ቤዞና ዑንጆ ጩቢሻ ቤዞ ዪሁዳ ካታማፓ ቢያ ባይዜሢሮ ዒ ካኣታዼ ዎዶና ሳዓ ኮሺ ማዔኔ፤ <verse eid="2CH 14:5"/><verse number="6" style="v" sid="2CH 14:6"/>ሃሣ ዪሁዳ ካታሞኮዋ ዋርዲያ ቤሲ ኮሼኔ፤ ናንጊና ናንጋ ጎዳ ሳዖ ኮሺ ማሄሢሮ ሚርጌ ሌዔ ዖልዚ ባኣያ ማዔኔ፤ <verse eid="2CH 14:6"/><verse number="7" style="v" sid="2CH 14:7"/>ዓኣሳ ዪሁዳ ዴሮም፦ «ሹጮና ማዦና ማኣሮንታ ዙሎ ኬልቂ ዲርቆና ዲፆንታ ዓንጎና ጋጋርቂ ዎዾ ዲሮ ካሮንታ ማዢ ካታሞ ኑኡኮ ኑ ዋርዲ ጊኢጊሾም፤ ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢኮ ማሊፆ ኑ ማዺ ኩንሤሢሮ ሳዔላ ኑ ኩጮ ጋራ ዓኣኔ፤ ናንጊና ናንጊና ጎዳ ኑና ካፔኔ፤ ቢያ ዛሎና ሂርጊሻ ባኣዚ ባኣያ ማሂ ሃውሾ ኑም ዒንጌኔ» ጌዔኔ፤ ዬያሮ ዴራ ካታሞ ዓጮ ዲርቂ ዋርዲዬኔ፤ ሃሣ ዖርጎጬኔ። <verse eid="2CH 14:7"/><verse number="8" style="v" sid="2CH 14:8"/>ካኣቲ ዓኣሳኮ ዼኤፒ ዼኤፒ ጊቲማና ዎርሢና ዓርቄ ሃይሦ ፄኤታ ሺያ ዖልዚ ዓሲ ዪሁዳፓ፥ ዻካ ዻካ ጊቲማና ሂኢሺና ዓርቄ ላምዖ ፄኤታና ሳሊታሚ ሺያ ዖልዚ ዓሲ ቢኢኒያሜይዳፓ ዓኣኔ፤ ዬያታ ቢያ ዖሎ ዛሎ ኮሺ ዔሬያ ዔርቴ ፖኦሊሴኬ፤<verse eid="2CH 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 14:9"/>ዛራሄ ጌይንታ ዒቶጲያ ዓሲስኬይ ፔቴ ሚሎኔ ፖኦሊሴና ሃይሦ ፄኤታ ሳርጌላ ዖይታና ዔኪ ዪሁዳ ዖሊ ዓርቃኒ ማሬሻ ጌይንታ ቤዞ ሙኬኔ፤ <verse eid="2CH 14:9"/><verse number="10" style="v" sid="2CH 14:10"/>ዬያሮ ዓኣሳ ዔያቶ ዖላኒ ኬስካዖ ላምዓሢ ዎላ ዖልቶሮ ማሬሻ ኮይላ ዓኣ ፄፓታ ዶኦጫ ቤሲ ቤሲ ዓርቂ ጊኢጌኔ፤ <verse eid="2CH 14:10"/><verse number="11" style="v" sid="2CH 14:11"/>ዒማና ዓኣሳ ናንጊና ናንጋ ጎዳ ማዔ ፔ ፆኦዛሢ፦ «ናንጊና ናንጋ ጎዳሢዮ! ዖሎ ዓሶ ሚርጌሢ ማዔቴያ ዻኮ ዓሶ ማኣዳኒ ኔ ዳንዳዓኔ፤ ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢዮ! ኔና ኑ ጉሙርቃሢሮ ሃያ ዺቦ ዖሎ ዓሶና ኑ ዖልታኒ ሙኬኔ፥ ኑና ማኣዴ፤ ናንጊና ናንጋ ጎዳሢዮ፥ ኔ ኑኡኮ ፆኦዛሢኬ፤ ኔና ባሻኒ ዖኦኒያ ዳንዳዑዋሴ» ጌይ ሺኢቄኔ።<verse eid="2CH 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 14:12"/>ዒቶጲያ ዓሳ ዖሎና ባሺንታንዳጉዲ ዓኣሳንታ ዖሎ ዓሶዋ ናንጊና ናንጋ ጎዳ ማኣዴኔ፤ ዬያሮ ዒቶጲያ ዓሳ ባሺንቲ ጳሽኬኔ። <verse eid="2CH 14:12"/><verse number="13" style="v" sid="2CH 14:13"/>ዒማና ዓኣሳንታ ዒዛኮ ዖሎ ዓሶንታ ዔያቶ ዴንዲ ጌራሬ ሄላንዳኣና ዳውሴኔ፤ ዬኖ ኬሎ ዒቶጲያኮ ዖሎ ዓሶይዳፓ ሚርጌ ዓሲ ሃይቄሢሮ ዖሎ ዓሳ ላሚ ዶዲ ዔቂ ዖላኒ ዳንዳዒባኣሴ፤ ዬያይዲ ናንጊና ናንጋ ጎዳና ዒዛኮ ዖሎ ዓሶና ዔያቶ ዖሌም ዒቶጲያ ዓሳ ባሺንቴኔ፤ ካኣቲ ዓኣሳኮ ዖሎ ዓሳ ሚርጌ ባኣዚ ዲዒ ዔኬኔ፤ <verse eid="2CH 14:13"/><verse number="14" style="v" sid="2CH 14:14"/>ዬኖ ዓጮ ኮይላ ዓኣ ዴራ ናንጊና ናንጋ ጎዳ ማዼ ባኮ ዛጊ ሚርጌ ዲቃቴኔ፤ ዓኣሳኮ ዖሎ ዓሳ ጌራሬና ኮይሎይዳ ዓኣ ካታሞ ቢያ ባይዜኔ፤ ካታሞ ቢያይዳፓ ሚርጌ ባኣዚ ቡሪ ዲዒ ዔኬኔ፤ <verse eid="2CH 14:14"/><verse number="15" style="v" sid="2CH 14:15"/>ዬያጉዲ ፔቴ ፔቴ ሞኦሢዳ ዖልዚ ቡሊ ሚርጌ ማራይ፥ ዋኣሪንታ ጋኣሎንታ ዲዔኔ፤ ዬካፓ ማዒ ዬሩሳላሜ ዴንዴኔ።<verse eid="2CH 14:15"/></para>
  <chapter eid="2CH 14"/>
  <chapter number="15" style="c" sid="2CH 15"/>
  <para style="s1">ካኣቲ ዓኣሳ ማዺ ኮሼ ባኮ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 15:1"/>ዬካፓ ፆኦሲኮ ዓያና ዖዴዴ ናኣዚ፥ ዓዛሪያሴይዳ ኬዴኔ፤ <verse eid="2CH 15:1"/><verse number="2" style="v" sid="2CH 15:2"/>ዓዛሪያሴ ዒማና ካኣቲ ዓኣሳና ካኣማኒ ሙካዖ፦ «ካኣቲዮ ዓኣሳ፥ ሂንዳ ዋይዜ! ዒንሢ ዪሁዳና ቢኢኒያሜና ዴራ ዋይዙዋቴ! ዒንሢ ፆኦሲና ዓኣ ዎዶና ዒዚያ ዒንሢና ዎላ ማዓንዳኔ፤ ዒንሢ ዒዛ ኮዔቴ ዴንቃንዳኔ፤ ዒንሢ ዒዛ ሃሼቴ ጋዓንቴ ዒዚያ ዒንሢ ሃሻንዳኔ፤ <verse eid="2CH 15:2"/><verse number="3" style="v" sid="2CH 15:3"/>ዒስራዔኤሌ ዴራ ሚርጌ ዎዴ ጎኔ ፆኦሲ ባኣያ፥ ሃሣ ዔያቶ ዔርዛ ቄኤሴና ዎጌያኣ ባኣያ ማዒ ናንጌኔ፤ <verse eid="2CH 15:3"/><verse number="4" style="v" sid="2CH 15:4"/>ሜታ ዔያቶ ሄላ ዎዶና ጋዓንቴ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ባንሢ ዓኣፖ ካሮ ማሂ ዒዛ ዔያታ ኮዓዖ ዴንቄኔ፤ <verse eid="2CH 15:4"/><verse number="5" style="v" sid="2CH 15:5"/>ዬኖ ዎዶና ቢያ ቤዞይዳ ዣሎና ዲቃሣ ባኣዚና ዓኣሢሮ ኮሺና ሶኦፒ ኬስኪ ጌላይ ዓይጎ ዓሲያ ባኣሴ፤ <verse eid="2CH 15:5"/><verse number="6" style="v" sid="2CH 15:6"/>ፆኦሲ ዴሮይዳ ዲቃቲሢና ሜቶና ሄሊሳሢሮ ፔቴ ዓጫ ባጎ ዓጮ፥ ፔቴ ካታማ ሜሌ ካታሞ ዖሊ ዖሊ ባይዛኔ። <verse eid="2CH 15:6"/><verse number="7" style="v" sid="2CH 15:7"/>ዒንሢ ጋዓንቴ ዶዱዋቴ፤ ሂርጊፖቴ፤ ዒንሢ ማዻ ኮዦ ማዾ ዛሎ ዒንሢ ዴንቃንዳኔ» ጌዔኔ።<verse eid="2CH 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 15:8"/>ዓኣሳ ዖዴዴ ናኣዚ፥ ፆኦሲ ማሊፆ ኬኤዛ ዓዛሪያሴ ኬኤዜ ፆኦሲ ማሊፆ ዋይዛዛ ዒና ዒዛኮ ዶዴኔ። ዒ ዒማና ዪሁዳና ቢኢኒያሜና ዓጮይዳ፥ ዬያጉዲ ሃሣ ዒዚ ዖሎና ባሺ ዲዒ ዓርቄ ጌሜራ ሚርጌ ዓኣ ዔፕሬኤሜ ዓጮ ካታማ ዓኣ ሻኣካ ባኮ ቢያ ባይዜኔ፤ ጌኤዦ ማኣሮኮ ዲሮ ጋራ ናንጊና ናንጋ ጎዳም ዒንጎ ባኮ ሺኢሻኒ ዾቂንቴ ቤዞዋ ዓካሴኔ።<verse eid="2CH 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 15:9"/>ናንጊና ናንጋ ጎዳ ማዔ ዒዛኮ ፆኦዛሢ ዓኣሳና ዎላ ዓኣሢ ዔያታ ዛጌሢሮ ዔፕሬኤሜይዳፓ፥ ሚናኣሴና ሲሞኦኔና ፃጳፓ ማዔ ሚርጌ ዓሲ ዓኣሳ ባንሢ ሙኪ ዒዛ ዓጫ ናንጌኔ፤ ዓኣሳ ዬያ ዓሶ ቢያ፤ ዬያጉዲ ሃሣ ጉቤ ዪሁዳና ቢኢኒያሜና ዴራ ዬሩሳላሜ ሙካንዳጉዲ ዔኤሊሢ ዳኬኔ፤ <verse eid="2CH 15:9"/><verse number="10" style="v" sid="2CH 15:10"/>ዬያሮ ዔያታ ዓኣሳ ካኣታዼ ታጶ ዶንጋሳ ሌዖኮ ሃይሣሳ ዓጊኖና ዬሩሳላሜይዳ ቡኪንቴኔ፤ <verse eid="2CH 15:10"/><verse number="11" style="v" sid="2CH 15:11"/>ዒማና ዔያታ ዔኪ ሙኬ፥ ዲዖና ባካፓ ዬኖ ዓቦ ላንካይ ፄኤታ ጌማይና ላንካይ ሺያ ማራይ ፆኦሲም ሚቺ ዒንጎ ዒንጊሢ ማሂ ሺኢሼኔ፤ <verse eid="2CH 15:11"/><verse number="12" style="v" sid="2CH 15:12"/>ናንጊና ናንጋ ጎዳ ማዔ ዔያቶኮ ቤርታኣ ዓዶንሢ ፆኦዛሢ ጎኔ ዒኔና፥ ጎኔ ሼምፓፓ ካኣሽካኒ ዎላ ጊኢጊ ጫኣቄኔ፤ <verse eid="2CH 15:12"/><verse number="13" style="v" sid="2CH 15:13"/>ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ካኣሽኩዋይ ዓይጎ ዼጌታቴያ ጋርቺ፥ ዓቲንቄታቴያ ላኣሊ ዎዺንታንዳያ ማዔሢ ዔያታ ዎላ ጫኣቄ ጫኣቁሞና ዔርዜኔ፤ <verse eid="2CH 15:13"/><verse number="14" style="v" sid="2CH 15:14"/>ዬያ ዔያታ ጫኣቄ ጫኣቁሞ ካፓንዳያ ማዒፆ ዔርዞሮ ዑኡዞ ፔኤኮ ዼጊዲ ዒላሺሢና ፖሮዚንታ ዛዬያኣ ዋርቂ ዋርቂ ናንጊና ናንጋ ጎዳም ጫኣቄኔ። <verse eid="2CH 15:14"/><verse number="15" style="v" sid="2CH 15:15"/>ዪሁዳ ዓሳ ቢያ ዒማና ጎኔ ዒናፓ ዬያ ጫኣቁሞ ጫኣቄሢሮ ዎዛዼኔ፤ ፆኦሲ ዔያታ ሚርጌና ኮዔኔ፤ ዒዚያ ዔያቶም ጴዼኔ፤ ናንጊና ናንጋ ጎዳ ዔያቶና ዎላ ማዒ ዔያቶ ዓጮኮ ቢያ ዛሎና ሂርጊሻ ባኣዚ ባኣያ ኮሺ ማሄኔ።<verse eid="2CH 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 15:16"/>ካኣቲ ዓኣሳ ዒዛኮ ዓሃ፥ ማዕካ ዓሼራ ጌይንታ ላኣሎ ፆኦዜሎኮ ሻኣካ ማላቶ ዾቄሢሮ ጌኤሻታፓ ዒዞ ዒ ኬይሴኔ፤ ዬያ ማላቶዋ ሜንሢ ጋኣጬኔ፤ ዬያ ሜቂፆ ቄድሮኦኔ ዶኦጫ ሚቼኔ፤ <verse eid="2CH 15:16"/><verse number="17" style="v" sid="2CH 15:17"/>ዓኣሳ ዓጮይዳ ዓኣ ሜሌ ዓሳ ካኣሽካ ቤዞ ጉቤ ባይዚባኣቶዋ ዒዛኮ ናንጎ ጋፖ ሄላንዳኣና ናንጊና ናንጋ ጎዳም ጉሙርቂንታያ ማዔኔ፤ <verse eid="2CH 15:17"/><verse number="18" style="v" sid="2CH 15:18"/>ዒዛኮ ዓዴ፥ ዓቢያ ፆኦሲም ዱማዼያ ማዓንዳጉዲ ማሄ ሜሆ ቢያ፤ ዬያጉዲ ሃሣ ዓኣሳ ፔኤሮ ናንጊና ናንጋ ጎዳም ዱማዼያ ማሄ ዎርቆና ቢሮናይዳፓ ኮሺንቴ ሜሆ ጉቤ ጌኤዦ ማኣሮይዳ ጌሤኔ፤ <verse eid="2CH 15:18"/><verse number="19" style="v" sid="2CH 15:19"/>ዓኣሳ ካኣታዺ ዴዔ ሃይሢታሚ ዶንጋሳ ሌዖ ሄላንዳኣና ዓጬሎይዳ ዖልዚ ባኣሴ።<verse eid="2CH 15:19"/></para>
  <chapter eid="2CH 15"/>
  <chapter number="16" style="c" sid="2CH 16"/>
  <para style="s1">ዪሁዳ ዓሶና ዒስራዔኤሌ ዓሶና ዎሊ ዖሌሢ</para>
  <para style="r">(<ref loc="1KI 15:17-22">1ካኣቶ. ማ 15፡17-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 16:1"/>ዓኣሳ ዪሁዳይዳ ካኣታዼንቴ ሃይሢታሚ ላሃሳ ሌዖና፥ ዒስራዔኤሌ ካኣቲ ባዕሻ ዪሁዳ ዖላኒ ኬስኪ ዪሁዳ ባንሢ ዖኦኒያ ጌሉዋጉዲና ኬስኩዋጉዲ ማሃኒ ራኣማይዳ ዋርዲሢ ዓርቄኔ፤ <verse eid="2CH 16:1"/><verse number="2" style="v" sid="2CH 16:2"/>ዬያሮ ዓኣሳ ጌኤዦ ማኣሮና ካኣቱሞ ማኣሮናኮ ሜሆ ጌሦ ማኣራፓ ቢሮ ዓንጎና ዎርቆና ኬሲ ዴማስቆይዳ ናንጋ ሶኦሪያ ካኣቲ ቤንሃዳዴም ዒንጋንዳጉዲ ዳኬኔ፤ ዬያ ዒንጎም ዳኮና ባኮና ዎላ ሂዚ ጋዓ ኪኢታኣ ዓኣኔ፦ <verse eid="2CH 16:2"/><verse number="3" style="v" sid="2CH 16:3"/>«ኔ ዓዶና ታ ዓዶና ማዼ ጎይፆ ኑ ዎላ ፑርቲንዱዋኣሢ ጫኣቆም፤ ሃያ ቢሮ ዓንጎና ዎርቆና ታ ኔኤም ዳኬሢ ኔኤም ዒንጎም ጌይኬ፤ ዬያሮ ዒስራዔኤሌ ካኣቲ ባዕሻ ፔኤኮ ፖኦሊሶ ታ ዓጫፓ ኬሳንዳጉዲ ኔ ታና ማኣዳኒ ሚና ቤርታ ኔ ዒዛና ዎላ ጫኣቄ ጫኣቁሞ ሃሻንዳጉዲ ታ ኔና ሺኢቃኔ።»<verse eid="2CH 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 16:4"/>ካኣቲ ቤንሃዳዴ ዓኣሳ ዒዛ ዖኦጬ ማሊፆ ኮሺኬ ጌይ ዔካዖ ዖሎ ዓሶ ዓይሣዞንሢና ዖሎ ዓሶና ዳኪ ዒስራዔኤሌ ካታሞ ዖሊሴኔ፤ ዬያሮ ዖሎ ዓሳ፦ ዒዮኔ፥ ዳኣኔንታ ዓቤልቤትማዕካ ጌይንታ ካታሞንሢና ኒፕታኣሌኤሜ ዓጮይዳ ጋሎንታ ዖሎ ዓንጋሞዋ ጌሦ ካታሞ ቢያ ዖሊ ባሺ ዓርቄኔ፤ <verse eid="2CH 16:4"/><verse number="5" style="v" sid="2CH 16:5"/>ካኣቲ ባዕሻ ዬያ ዋይዛዖ ራኣማይዳ ዋርዲዮ ኮሺፆ ዓርቄሢ ሃሼኔ፤ <verse eid="2CH 16:5"/><verse number="6" style="v" sid="2CH 16:6"/>ዬካፓ ካኣቲ ዓኣሳ ዓሶ ዪሁዳይዳፓ ቢያ ቡኩሲ፥ ካኣቲ ባዕሻ ራኣማይዳ ዋርዳኒ ጊኢጊሼ ሹጮንታ ሚፆንታ ቢያ ዒኢካፓ ዔኪ ሙካንዳጉዲ ዓይሤኔ፤ ዬያሮ ዓሳ ሹጮና ሚፆና ቢያ ራኣማይዳፓ ዔኪ ሙኪ ጌባዕኔና ሚፂጳ ካታሞናኮ ዙሎ ዋርዴኔ።<verse eid="2CH 16:6"/></para>
  <para style="s1">ፆኦሲ ማሊፆ ኬኤዛ ሃናኒ</para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 16:7"/>ዒማና ፆኦሲ ማሊፆ ኬኤዛ ሃናኒ ካኣቲ ዓኣሳ ኮይላ ሙካዖ፦ «ናንጊና ናንጋ ጎዳ ማዔ ኔ ፆኦዛሢና ጉሙርቂንቲፆ ሃሺ ሶኦሪያ ካኣቲ ኔ ጉሙርቄሢሮ ዒስራዔኤሌኮ ዖሎ ዓሳ ኔ ኩጫፓ ቶሌኔ፤ <verse eid="2CH 16:7"/><verse number="8" style="v" sid="2CH 16:8"/>ዒቶጲያና ሊቢያ ዓሶናኮ ሚርጌ ዖላ ዓሲንታ ሳርጌላ ዖይታንታ ፓሮና ዖላ ዓሲንታ ባኣዓዳ? ዒማና ኔኤኒ ፆኦሲ ጉሙርቄሢሮ ዖሎና ኔ ባሻንዳጉዲ ፆኦሲ ኔና ማኣዴኔ። <verse eid="2CH 16:8"/><verse number="9" style="v" sid="2CH 16:9"/>ናንጊና ናንጋ ጎዳ ዓጮ ጉቤ ኮሺ ዛጋዖ ጉቤ ዒኔና ዒዛ ጉሙርቃዞንሢም ቢያ ዶዱሞ ዒንጋኔ፤ ዓካሪ ኔኤኒ ዔኤያቶ ማዾ ማዼሢሮ ሃካፓ ሴካ ዖልዚ ኔኤፓ ሺኢካዓኬ» ጌዔኔ፤ <verse eid="2CH 16:9"/><verse number="10" style="v" sid="2CH 16:10"/>ዬይ ጌኤዛ ዓኣሳ ኮሺ ዻጋሴሢሮ ፆኦሲ ማሊፆ ኬኤዛሢ ካኒ ቢራታና ቱኪ ቱኡሲ ማኣሪ ጌልዜኔ፤ ዬማ ኬላፓ ዓርቃዖ ካኣቲ ዓኣሳ ዴሮ ባኣካፓ ፔቴ ፔቴ ዓሶ ሚጪንቱዋዖ ሜታሲሢ ዓርቄኔ።<verse eid="2CH 16:10"/></para>
  <para style="s1">ዓኣሳ ካኣቱሞኮ ጋፒንፆ</para>
  <para style="r">(<ref loc="1KI 15:23-24">1ካኣቶ. ማ 15፡23-24</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 16:11"/>ዓኣሳ ካኣታዼሢዳፓ ዴንዲ ጋፖ ሄላንዳኣና ማዺንቴ ባካ ቢያ ዪሁዳና ዒስራዔኤሌ ካኣቶ ሃይሶ ማፃኣፖይዳ ፃኣፒንቲ ዓኣኔ፤ <verse eid="2CH 16:11"/><verse number="12" style="v" sid="2CH 16:12"/>ካኣቲ ዓኣሳ ካኣታዼንቴ ሃይሢታሚ ታዞጳሶ ሌዖና ቶኪ ዒዛኮ ኮሺ ሃርጌኔ፤ ዬያይዲ ሃርጊንታዖ ዼኤሻ ዔራ ዓሶይዳፓዓቴም ፆኦሲ ዒዛ ማኣዳንዳጉዲ ዒ ኮዒባኣሴ፤ <verse eid="2CH 16:12"/><verse number="13" style="v" sid="2CH 16:13"/>ዓኣሳ ካኣታዼዖ ዖይዲታሚ ፔታሳ ሌዖና ሃይቄኔ። <verse eid="2CH 16:13"/><verse number="14" style="v" sid="2CH 16:14"/>ዒማና ሌዛ ዒዛኮ ዱማ ሳውቃ ቲሺንታ ዼኤሻናኣ ቲሽኪንቲ ዒዚ ቤርታ ፔኤሮ ዳውቴ ካታማ ላሌ ዓርሲ ኮሼ ዱኡፒ ዔቴይዳ ዱኡቴኔ፤ ዒዛ ቦንቾሮ ዓሳ ሚርጌ ሃንፂሌ ኩሊ ታሚ ዔኤሢ ዼኤፒ ዬኤፒ ዬኤኬኔ።<verse eid="2CH 16:14"/></para>
  <chapter eid="2CH 16"/>
  <chapter number="17" style="c" sid="2CH 17"/>
  <para style="s1">ዒዮሳፒፄ ዪሁዳይዳ ካኣታዼሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 17:1"/>ዒዮሳፒፄ ዓዶ፥ ዓኣሳ ቤዛ ጌሊ ካኣታዼኔ፤ ዬካፓ ዒስራዔኤሌ ዓሶ ዖላኒ ዎልቄ ዴንቄኔ፤ <verse eid="2CH 17:1"/><verse number="2" style="v" sid="2CH 17:2"/>ዙላ ኬልቂ ዲርቂንቴ ዪሁዳ ካታሞና ዙላ ዙላ ዓኣ ቤዛ ቢያ፥ ዬያጉዲ ሃሣ ዒዛኮ ዓዴ ካኣቲ ዓኣሳ ዖሎና ባሺ ዓርቄ ዔፕሬኤሜ ዓጫ ዓኣ ካታማኣ ዓቱዋንቴ ፖኦሊሴ ዴይሤኔ፤ <verse eid="2CH 17:2"/><verse number="3" style="v" sid="2CH 17:3"/>ዒዮሳፒፄ ዒዛኮ ዓዴ ፔ ካኣቱሞ ዎዶኮ ዓይፆይዳ ማዼ ጎይፆ ዳውቴ ማዼ ኮዦ ማዾ ማዼሢሮ ሃሣ ባዓኣሌ ጌይንታ ሜሌ ፆኦዞ ካኣሽኪባኣሢሮ ናንጊና ናንጋ ጎዳ ዒዛ ዓንጄኔ፤ <verse eid="2CH 17:3"/><verse number="4" style="v" sid="2CH 17:4"/>ዒዮሳፒፄ ፔ ዓዶ ፆኦዛሢም ማዼኔ፤ ዓይሢፆዋ ካፔኔ፤ ዒስራዔኤሌ ካኣታ ማዼ ጎይፆ ፑርቶ ማዾ ፔቴታዖ ማዺባኣሴ፤ <verse eid="2CH 17:4"/><verse number="5" style="v" sid="2CH 17:5"/>ዬያሮ ናንጊና ናንጋ ጎዳ ዒዮሳፒፄኮ ካኣቱማ ዶዳንዳጉዲ ማሄኔ፤ ዪሁዳ ዴራ ቢያ ዱማ ዱማ ዒዛም ዒንጎ ባኣዚ ዔኪ ሙካሢሮ ዒዚ ኮሺ ዖርጎጪ ቦንቺንታያ ማዔኔ፤ <verse eid="2CH 17:5"/><verse number="6" style="v" sid="2CH 17:6"/>ዒዚ ናንጊና ናንጋ ጎዳም ጎኔ ዒናፓ ማዼኔ፤ ዬያ ሌሊቱዋንቴ ጌሜራ ጌሜራ ዓኣ ሜሌ ዓሳ ካኣሽካ ቤዞና ዪሁዳይዳ ዓኣ ዓሼራ ጌይንታ ላኣሎ ፆኦዜሎ ማላቶ ቢያ ባይዜኔ።<verse eid="2CH 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 17:7"/>ዒዮሳፒፄ ካኣታዼንቴ ሃይሣሳ ሌዖና፦ ቤንሃይሌ፥ ዖብዲዩ፥ ዛካሪያሴ፥ ናትናዔኤሌና ሚኪያሴ ጌይንታ ዒዛኮ ዶንዞ ማዔ ቢታንታ ዓኣ ዓሳ ዪሁዳ ካታሞ ዓሶ ዔርዛንዳጉዲ ዳኬኔ። <verse eid="2CH 17:7"/><verse number="8" style="v" sid="2CH 17:8"/>ዬንሢና ዎላ ታዞጳ ሌዊ ዓሲና ላምዖ ቄኤሴስኬንሢያ ዓኣኔ፤ ሌዊ ዓሳ፦ ሼማዒያ፥ ኔታኒያ፥ ዜባዲያ፥ ዓሳሄሌ፥ ሼሚራሞቴ፥ ዪሆናታኔ፥ ዖዶኒያ፥ ፆቢያንታ ፆባዶኒያንታ ማዓዛ ቄኤሶንሢ ዔልሻማዔና ዪሆራሜናኬ፤ <verse eid="2CH 17:8"/><verse number="9" style="v" sid="2CH 17:9"/>ዔያታ ናንጊና ናንጋ ጎዳኮ ዎጎ ማፃኣፖ ዓርቂ፥ ዪሁዳ ካታሞ ቢያ ዴንዲ ዴንዲ ዴሮ ቢያ ዔርዜኔ።<verse eid="2CH 17:9"/></para>
  <para style="s1">ዒዮሳፒፄኮ ዼኤፑማ ዔርቴሢ</para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 17:10"/>ዪሁዳ ዓጮኮ ኮይላ ኮይላ ዓኣ ዓጮ ካኣታ ዒዮሳፒፄ ዖሉዋጉዲ ናንጊና ናንጋ ጎዳ ዔያቶይዳ ዒጊቹሞ ጌልዜኔ፤ <verse eid="2CH 17:10"/><verse number="11" style="v" sid="2CH 17:11"/>ፒሊስፄኤሜ ዓሶይዳፓ ፔቴ ፔቴሢ ሚርጌ ቢራና ሜሌ ዒንጊሢያ ካኣቲ ዒዮሳፒፄም ዒንጋዛ ፔቴ ፔቴ ዓሬቦ ዓሳ ጊንሣ ላንካይ ሺያና ላንካይ ፄኤታ ዓዴ ማራይ፥ ሃሣ ላንካይ ሺያና ላንካይ ፄኤታ ኮላይ ዔኪ ሙኬኔ። <verse eid="2CH 17:11"/><verse number="12-13" style="v" sid="2CH 17:12-13"/>ዬያሮ ዒዮሳፒፄ ሌዓ ሌዓ ሌካ ኮሺ ዼጊ ዼጊ ዓኣዼኔ፤ ዪሁዳ ዓጮ ጉቤይዳ ዋርዲዬ ቤሲንታ ሚርጌ ዺቢ ጋላና ዖልዚ ዓንጋሞና ቡኩሲ ጌሦንዶ ካታማኣ ማዤኔ።</para>
  <para style="p" vid="2CH 17:12-13">ዬሩሳላሜይዳ ዖልዚና ዱማ ዔራቶ ዓኣ ዖልዚ ዓሲ ዒ ጌሤኔ፤ <verse eid="2CH 17:12-13"/><verse number="14" style="v" sid="2CH 17:14"/>ዪሁዳ ፃጳፓ ኬሶና ፖኦሊሶኮ ዓይሣሢ ዓዲና ጌይንታሢኬ፤ ዒዛኮ ዴማ ሃይሦ ፄኤታ ሺያ ፖኦሊሴ ዓኣኔ፤ <verse eid="2CH 17:14"/><verse number="15" style="v" sid="2CH 17:15"/>ዒዛ ሄሊሳዖ ላምዓሳ ዴማሢ ዬሆሃናኔ ጌይንታሢኬ፤ ዒዛኮ ዴማ ላምዖ ፄኤታና ሳሊታሚ ሺያ ፖኦሊሴ ዓኣኔ፤ <verse eid="2CH 17:15"/><verse number="16" style="v" sid="2CH 17:16"/>ዬሆሃናኔ ሄሊሳዖ ሃይሣሳ ዴማሢ ማዒ ዖሎ ዓሶ ዓይሣሢ ዚኪሪ ናኣዚ ዓማስያኬ፤ ዒዛኮ ዴማ ላምዖ ፄኤታ ሺያ ፖኦሊሴ ዓኣኔ፤ ዒዚ ፔኤሮ ናሽኪ ናንጊና ናንጋ ጎዳ ማዾም ፔና ዱማሴ ዖልዚ ሱኡጌኬ፤ <verse eid="2CH 17:16"/><verse number="17" style="v" sid="2CH 17:17"/>ቢኢኒያሜ ፃጳፓ ኬስኬ ፖኦሊሶ ዓይሣ ሱኡጋሢ ዔሊያዳዔ ጌይንታያ ዒዛና ቤቃ ዓሲባኣ ዔርቴ ፖኦሊሴኬ፤ ዒዛኮ ዴማ ጊቲማና ሂኢሺና ዓርቄ ላምዖ ፄኤታ ሺያ ፖኦሊሴ ዓኣኔ፤ <verse eid="2CH 17:17"/><verse number="18" style="v" sid="2CH 17:18"/>ዒዛ ሄሊሳዖ ዒዛኮ ዴማ ላምዓሳያ ማዓሢ ዬሆዛባዴ ጌይንታ ዖሎ ዓሶ ዓይሣሢኬ፤ ዒዛ ዴማ ዖልዚም ጊኢጌያ ፔቴ ፄኤታና ሳሊታሚ ሺያ ፖኦሊሴ ዓኣኔ፤ <verse eid="2CH 17:18"/><verse number="19" style="v" sid="2CH 17:19"/>ዬንሢ ፖኦሊሳ ቢያ ካኣቲ ዒዮሳፒፄም ዬሩሳላሜይዳ ማዻያ ማዓዛ፥ ካኣቲ ቃሲ ሃሣ ሜሌ ዙላ ኬልቂ ዲርቂንቴ ካታማይዳ ዱማ ፖኦሊሴያኣ ጌሤኔ።<verse eid="2CH 17:19"/></para>
  <chapter eid="2CH 17"/>
  <chapter number="18" style="c" sid="2CH 18"/>
  <para style="s1">ፆኦሲ ማሊፆ ኬኤዛ ሚኪያሴ ካኣቲ ዓክዓቤም ኬኤዜ ባኮ</para>
  <para style="r">(<ref loc="1KI 22:1-28">1ካኣቶ. ማ 22፡1-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 18:1"/>ዪሁዳ ካኣቲ ዒዮሳፒፄ ቆሎና ዖርጎጪ ዔርቴያ ማዔ ዎዶና ዒዛና ዒስራዔኤሌ ካኣቲ ዓክዓቤ ማኣሮ ዓሶና ዎላ ዔፒና ዒጊንቴኔ። <verse eid="2CH 18:1"/><verse number="2" style="v" sid="2CH 18:2"/>ዻካ ሌዔኮ ጊንፃፓ ዒዮሳፒፄ ዓክዓቤ ማኣሪ ሳማሪያ ካታሞ ሾኦቹሞ ዴንዴኔ፤ ዒማና ዓክዓቤ ዒዮሳፒፄንታ ዒዛና ዎላ ዓኣ ዓሶንታ ቦንቺ ሚርጌ ማራይና ባይና ሹኪ ዼኤፒ ሙኡዚ ጊኢጊሼኔ፤ ዬካፓ ዓክዓቤ ጌሌዓዴይዳ ዓኣ ራሞቴ ካታሞ ዒዛና ዎላ ዖላንዳጉዲ ዒዮሳፒፄ ሺኢቃዖ፦ <verse eid="2CH 18:2"/><verse number="3" style="v" sid="2CH 18:3"/>«ራሞቴ ኔ ታኣና ዎላ ዴንዲ ዖልቴቴራ» ጌይ ዖኦጬኔ።</para>
  <para style="p" vid="2CH 18:3">ዒዮሳፒፄ ማሃዖ፦ «ኔኤኒ ጌዔያታቴ ታናኣ ማዖም ታ ዖሎ ዓሳ ጊኢጌያኬ፤ ኔና ማኣዳኒ ኑ ዖላንዳኔ፤ <verse eid="2CH 18:3"/><verse number="4" style="v" sid="2CH 18:4"/>ጋዓንቴ ናንጊና ናንጋ ጎዳ ዎዚ ጋዓቴያ ኑ ዖኦጮም» ጌዔኔ።<verse eid="2CH 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 18:5"/>ዬያሮ ዓክዓቤ ፓይዳ ዖይዶ ፄኤታ ማዔ፥ ዒዛም ሎንሦ ኬኤዛ ዓሶ ዔኤሊ፦ «ታኣኒ ራሞቴ ዴንዲ ዖሎንዶሞ፥ ሃሾንዶይ?» ጌይ ዖኦጬኔ።</para>
  <para style="p" vid="2CH 18:5">ዔያታኣ፦ «ዴንዲ ዖሌ፥ ፆኦሲ ኔና ባሺሲሳንዳኔ» ጌዔኔ።<verse eid="2CH 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 18:6"/>ዒዮሳፒፄ ጋዓንቴ፦ «ዒዛ ዛሎና ናንጊና ናንጋ ጎዳ ዎዚ ጋዓቴያ ኑ ዖኦጫንዳ፥ ፆኦሲ ማሊሢ ኬኤዛ ዓሲ ሜሌ ባኣዓዳ?» ጌዒ ዖኦጬኔ፤<verse eid="2CH 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 18:7"/>ዓክዓቤ ማሃዖ፦ «ዪምላ ጎዖሢ ናይ ሚኪያሴ ጌይንታያ ፆኦሲ ማሊሢ ኬኤዛስኬይ ዓኣኔ፤ ጋዓንቴ ታ ዒዛ ናሽኩዋሴ፤ ዓይጎሮ ጌዔቴ ዒዚ ቢያ ዎዴ ታ ዛላ ፑርታ ሎንሦ ኬኤዛፓዓቴም ኮሺ ኬኤዛኒ ኮዑዋሴ» ጌዔኔ።</para>
  <para style="p" vid="2CH 18:7">ዒዮሳፒፄ፦ «ኔ ዬያ ጌይፖ!» ጌዔኔ።<verse eid="2CH 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 18:8"/>ዬካፓ ካኣቲ ዓክዓቤ ዒዛኮ ዶንዞ ማዔ ቢታንታ ዓኣ ዓሶይዳፓ ፔቴያ ዔኤላዖ፦ «ሚኪያሴ ኮይ ዴንቂ፥ ዑኬ ሙኡሴ» ጌይ ዓይሤኔ።<verse eid="2CH 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 18:9"/>ዒማና ላምዖ ካኣታ ካኣቱሞ ዓፒሎ ማይንቲ ሳማሪያ ጌሎ ካሮኮ ዙሎ ዛላ ዓኣ ሃኣኮ ሺርኮ ቆይዳ ፔኤኮ ካኣቱሞ ዖይታ ዖይታ ዴዔኔ፤ ዔያቶም ፆኦሲ ማሊፆ ኬኤዛ ዓሳኣ ቢያ ዔያቶኮ ቤርታ ማዒ ሎንሦ ኬኤዛኔ፤ <verse eid="2CH 18:9"/><verse number="10" style="v" sid="2CH 18:10"/>ዔያቶይዳፓ ፔቴ፥ ኬናዒና ናኣዚ ሴዴቂያሴ ዓንጊ ጉራኒ ኮሺ ዓክዓቤም፦ «ናንጊና ናንጋ ጎዳ ‹ሃንሢ ጉራኖንሢና ሶኦሪያ ዓሶ ዖሊ ጉቤ ኔ ባሻንዳኔ› ጋዓኔ» ጌዔኔ። <verse eid="2CH 18:10"/><verse number="11" style="v" sid="2CH 18:11"/>ሃንጎ ፆኦሲ ማሊፆ ኬኤዛ ዓሳ ዒ ጌዔ ጎይፆማ፦ «ራሞቴ ዴንዲ ዖሌ፤ ኔኤኒ ባሻንዳኔ፤ ናንጊና ናንጋ ጎዳ ኔና ባሺሳንዳኔ» ጌዔኔ።<verse eid="2CH 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 18:12"/>ሚኪያሴ ዔኤላኒ ዴንዴ ኪኢቶ ዓሢ ዒማና ሚኪያሴም፦ «ሃንጎ ፆኦሲ ማሊፆ ኬኤዛ ዓሳ ቢያ ካኣቲ ዓክዓቤ ዖሎና ባሻንዳሢ ዔርዛ ሎንሦ ኬኤዜኔ፤ ዬያሮ ኔኤኒ ዒማጉዲ ኬኤዜቴ ኔኤም ኮሺኬ» ጌዔኔ።<verse eid="2CH 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 18:13"/>ሚኪያሴ ጋዓንቴ፦ «ናንጊና ናንጋ ጎዳ ሃይቆ! ፆኦሲ ታኣም ፔጋሲ ኬኤዛ ቃኣላ ሌሊ ታ ኬኤዛንዳኔ» ጌዔኔ።<verse eid="2CH 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 18:14"/>ዬካፓ ሚኪያሴ ካኣቲ፥ ዓክዓቤ ቤርቶ ሺኢካዛ ካኣቲ፦ «ሚኪያሴ! ካኣቲ ዒዮሳፒፄና ታኣና ዴንዲ ራሞቴ ዖሎንዶሞ ሃሾንዶ?» ጌዒ ዖኦጬኔ።</para>
  <para style="p" vid="2CH 18:14">ሚኪያሴ ማሃዖ፦ «ዖሌ! ጎኔ ኔኤኒ ባሻንዳኔ፤ ፆኦሲ ኔና ባሺሳንዳኔ» ጌዔኔ።<verse eid="2CH 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 18:15"/>ዓክዓቤ ዒማና፦ «ኔኤኒ ታኣም ናንጊና ናንጋ ጎዳ ሱንፆና ፆኦሲ ማሊሢ ኬኤዛኣና ‹ጎኔ ማዓንዳማ ኬኤዜቴራ!› ሂዚ ጌዒ ታ ኔኤም ዋኣዼ ማይንቲ ኬኤዛይ?» ጌዔኔ።<verse eid="2CH 18:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 18:16"/>ሚኪያሴ ማሃዖ፦ «ዒስራዔኤሌኮ ዖሎ ዓሳ ጉቤ ሄንቃ ዓሲባኣ ማራይጉዲ ጌሜሮይዳ ዜርቂንቲ ዓኣንቴ ታ ዛጋኔ፤ ናንጊና ናንጋ ጎዳ፥ ‹ሃያ ዓሶኮ ሱኡጌ ባኣሴ፤ ዬያሮ ፔ ማኣሪ ማኣሪ ኮሺ ማዒ ዴንዶንጎ› ጌዔኔ» ጌኤኔ። <note caller="-" style="x"><char style="xo" closed="false">18፡16 </char><char style="xt" closed="false"><ref loc="NUM 27:17">ፓይ. ማፃ 27፡17</ref>፤ <ref loc="EZK 34:5">ሂዚ. 34፡5</ref>፤ <ref loc="MAT 9:36">ማቲ. 9፡36</ref>፤ <ref loc="MRK 6:34">ማር. 6፡34</ref>።</char></note><verse eid="2CH 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 18:17"/>ዓክዓቤ ዒዮሳፒፄ ኮይላ፦ «ዒዚ ቢያ ዎዴ ታ ዛላ ፑርታፓዓቴም ኮሺ ባኣዚ ኬኤዚ ቤቂባኣሴ ታ ኔኤም ጌይባይ?» ጌዔኔ።<verse eid="2CH 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 18:18"/>ሚኪያሴ ዒ ኬኤዛ ፆኦሲ ማሊፆ ኬኤዛዖ፦ «ዓካሪ ናንጊና ናንጋ ጎዳ ጋዓሢ ዋይዜ! ናንጊና ናንጋ ጎዳ ጫሪንጫ ፔኤኮ ካኣቱሞ ዖይቶይዳ ዴዒ ኪኢታንቻ ቢያሢ ዒዛኮ ሚዛቆና ሻውሎናይዳ ዔቂ ዓኣንቴ ታ ዛጌኔ፤ <verse eid="2CH 18:18"/><verse number="19" style="v" sid="2CH 18:19"/>ናንጊና ናንጋ ጎዳ፥ ‹ዓክዓቤ ራሞቴ ዓኣዺ ዒኢካ ሃይቃንዳጉዲ ዴንዲ ዻቢሻኒ ዳንዳዓንዳይ ዖናዳይ?› ጌይ ዖኦጫዛ፥ ኪኢታንቾ ባኣካፓ ፔቴይ ፔቴ ባኣዚ፤ ባጋሢ ሃሣ ሜሌ ባኣዚ ፔጋሲ ኬኤዛያ ማዒ ዱማ ዱማ ባኣዚ ኬኤዜኔ፤ <verse eid="2CH 18:19"/><verse number="20" style="v" sid="2CH 18:20"/>ጋፒንፆይዳ ፔቴ ኪኢታንቾስኬይ ናንጊና ናንጋ ጎዳ ቤርቶ ሺኢካዖ፦ ‹ታ ዒዛ ዻቢሻኒ ዳንዳዓኔ› ጋዓዛ፥ ናንጊና ናንጋ ጎዳ ማሃዖ፥ ‹ዎዲ ኔ ዒዛ ዻቢሻኒ ዳንዳዓንዳይ?› ጌዔኔ፤ <verse eid="2CH 18:20"/><verse number="21" style="v" sid="2CH 18:21"/>ኪኢታንቻሢ ዒማና፦ ‹ታ ዴንዲጋፓ ዓክዓቤም ፆኦሲ ማሊፆ ኬኤዛ ዓሶ ቢያ ሉኡቂሳንዳኔ› ጌዔኔ፤ ናንጊና ናንጋ ጎዳ ዒዛም፦ ‹ሂዴቶ ዴንዲ ዒዛ ዻቢሼ፤ ኔኤም ጊኢጋንዳኔ› » ጌዔኔ።<verse eid="2CH 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 18:22"/>ዬካፓ ሚኪያሴ፦ «ዓካሪ ኔኤም ማሊንቴ ባካ ያዺኬ! ሃኣታ ኔኤም ፆኦሲ ማሊፆ ኬኤዛ ዓሳ ሉኡቂ ኬኤዛንዳጉዲ ማዼሢ ናንጊና ናንጋ ጎዳኬ፤ ዬያሮ ናንጊና ናንጋ ጎዳ ኔ ዑፃ ሜቶ ዔኪ ሙካኒ ፔኤሮ ማሌኔ» ጌዔኔ።<verse eid="2CH 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 18:23"/>ዒማና ኬናዒና ናኣዚ፥ ሴዴቂያሴ ሚኪያሴ ባንሢ ዶጫዖ ባዒጋፓ፦ «ዔኤካ! ፆኦሲ ዓያና ታ ኮርሳ ዴንዲ ዎይማና ኔኤም ኬኤዜይ?» ጌዔኔ።<verse eid="2CH 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 18:24"/>ሚኪያሴ ዒዛም፦ «ኔኤኒ ኮጮኮ ዙሌና ዓኣ ቆልዖ ጋሮ ዴንዲ ፑኔ ኬሎና ዬያ ኔ ዔራንዳኔ» ጌዔኔ። <verse eid="2CH 18:24"/><verse number="25" style="v" sid="2CH 18:25"/>ዒማና ካኣቲ ዓክዓቤ ዒዛኮ ዖሎ ዓሶ ዓይሣሢኮ ፔቴሢ፦ «ሚኪያሴ ዓርቂ ካታሞ ዎይሣ ዓሞኦኔና ካኣቲ ናኣዚ ዮዓሼና ኮይላ ዔኪ ዴንዴ! <verse eid="2CH 18:25"/><verse number="26" style="v" sid="2CH 18:26"/>ታኣኒ ዖላፓ ኮሺና ዬዓንዳያ ሄላንዳኣና ቱኡዞ ማኣሮ ጌልዚ፥ ዒዛም ሜልዚ ካሣና ዋኣሢና ሌሊ ዒንጊ ዒንጊ ዴይሣንዳጉዲ ታኣኒ ዓይሤኔ ጌዒ ዔያቶም ኬኤዜ» ጌይ ዓይሤኔ። <verse eid="2CH 18:26"/><verse number="27" style="v" sid="2CH 18:27"/>ሚኪያሴ፦ «ኔኤኒ ዖላፓ ኮሺና ማዔያታቴ ናንጊና ናንጋ ጎዳ ታ ዛሎና ኬኤዚባኣሴ ጌይሢኬ!» ጌዔኔ። ሃሣ ጊንሣ ዑኡዞ ፔኤኮ ዼጊዲ፦ «ሃይካ ዓኣ ዴራ ቢያ ታ ኬኤዜ ባኮ ቢያ ዒና ዔኪ ዋይዙዋቴ!» ጌዔኔ።<verse eid="2CH 18:27"/></para>
  <para style="s1">ዓክዓቤኮ ሃይቦ</para>
  <para style="r">(<ref loc="1KI 22:29-35">1ካኣቶ. ማ 22፡29-35</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="2CH 18:28"/>ዬካፓ ዒስራዔኤሌ ካኣቲ ዓክዓቤና ዪሁዳ ካኣቲ ዒዮሳፒፄና ጌሌዓዴ ዓጮይዳ ዓኣ ራሞቴ ዖላኒ ዴንዴኔ፤ <verse eid="2CH 18:28"/><verse number="29" style="v" sid="2CH 18:29"/>ዓክዓቤ ዒዮሳፒፄ ኮይላ፦ «ዖሎሮ ኑ ዴንዳኣና ታኣኒ ዱማ ዓሲ ማላኒ ሜሌ ማኣዖ ማይንታንዳኔ፤ ኔኤኒ ጋዓንቴ ኔኤኮ ካኣቱሞ ማኣዓሢ ማይንቴ» ጌዔኔ፤ ዬያይዲ ዒስራዔኤሌ ካኣቲ ዓክዓቤ ሜሌ ማኣዖ ማይንቲ ፔኑሞ ዓኣቺ ዖሎሮ ዴንዴኔ።<verse eid="2CH 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2CH 18:30"/>ዒማና ሶኦሪያ ካኣቲ፦ «ዒስራዔኤሌ ካኣቲ፥ ዓክዓቤ ዛጊ ዱማሲ ዱኩዋቴ፤ ሜሌ ዓይጎ ዓሲያኣ ዱኪፖቴ» ጌዒ ሳርጌሎ ዖይቶ ዒሻ ዓሶ ዓይሣ ዓሶም ኬኤዜኔ። <verse eid="2CH 18:30"/><verse number="31" style="v" sid="2CH 18:31"/>ዬያሮ ካኣቲ ዒዮሳፒፄ ዔያታ ዴንቃዖ ዔያቶም ዒስራዔኤሌ ካኣቲ ማሌሢሮ ዒዛ ዱካኒ ማንጌኔ፤ ጋዓንቴ ዒዮሳፒፄ ዒላቴኔ፤ ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢ ዔያቶ ኩጫፓ ዓይሲ ዒዛ ዻቂሼኔ፤ ዬያሮ ዔያታ ዒዛ ዱኩዋዖ ሃሼኔ። <verse eid="2CH 18:31"/><verse number="32" style="v" sid="2CH 18:32"/>ሳርጌሎ ዖይቶ ዒሻ ዓሶ ዓይሣዞንሢ ዒዮሳፒፄ ዒስራዔኤሌ ካኣቲቱዋኣሢ ዔራዖ ዒዛ ዳውሲፆ ሃሼኔ፤ <verse eid="2CH 18:32"/><verse number="33" style="v" sid="2CH 18:33"/>ዒማና ፔቴ ሶኦሪያ ፖኦሊሴስኬይ ማሊባኣዖ ሂኢዦና ዱካዛ ዖሎሮ ማኣዖና ዓንጎኮ ካኣማ ካሮና ጌሊ ዓክዓቤ ዓይዴኔ፤ ዬያሮ ካኣቲ ዓክዓቤ ሳርጌሎ ዖይቶ ዒሻሢ ኮይላ፦ «ታ ዱኡቴኔ! ሳርጌሎ ዖይቶ ዖሎ ቤዛፓ ማሂ ዔኪ ኬሴ!» ጌይ ዓይሤኔ። <verse eid="2CH 18:33"/><verse number="34" style="v" sid="2CH 18:34"/>ዖላ ዶዳዛ ካኣቲ፥ ዓክዓቤ ሶኦሪያ ዓሶኮ ሆታ ሳርጌሎ ዖይቶይዳ ጌኤቂንቲ ዴዒ ዓኣዖ ዴንዲ ዓባ ጌላኣና ሃይቄኔ።<verse eid="2CH 18:34"/></para>
  <chapter eid="2CH 18"/>
  <chapter number="19" style="c" sid="2CH 19"/>
  <para style="s1">ፆኦሲ ማሊፆ ኬኤዛ ዒዩ ዒዮሳፒፄ ጎሬሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 19:1"/>ዪሁዳ ካኣቲ፥ ዒዮሳፒፄ ዬሩሳላሜይዳ ዓኣ ካኣቱሞ ማኣሮ ኮሺና ማዒ ሙኬኔ፤ <verse eid="2CH 19:1"/><verse number="2" style="v" sid="2CH 19:2"/>ዒማና ሃናኒ ናኣዚ፥ ዒዩ ጎዖ ፆኦሲ ማሊፆ ኬኤዛሢ ካኣቲ ዒዮሳፒፄና ሙኪ ካኣማዖ፦ «ኔኤኒ ፑርቶ ዓሶ ማኣዴሢና ናንጊና ናንጋ ጎዳ ዒፃ ዓሶና ዎላ ፔቴ ማዒፃ ኔኤም ኮሺ ማላ? ሃይ ኔ ማዼ ፑርቶ ባካ ናንጊና ናንጋ ጎዳኮ ዻጎ ኔ ዑፃ ዔኪ ዬዔኔ፤ <verse eid="2CH 19:2"/><verse number="3" style="v" sid="2CH 19:3"/>ዬይ ያዺ ማዔቴያ ፔቴ ፔቴ ኮሺ ባኣዚ ኔ ማዼኔ፤ ዬይ ዓይጎዳይ ጌዔቴ ዴራ ካኣሽካ፥ ዓሼራ ጌይንታ ላኣሎ ፆኦዜሎ ማላሢ ቢያ ዓጫፓ ኔ ባይዜኔ፤ ፆኦሲኮዋ ማሊፆ ዱማሲ ዔሪ ኩንሣኒ ኔኤኒ ላቢ ማዼኔ» ጌዔኔ።<verse eid="2CH 19:3"/></para>
  <para style="s1">ዒዮሳፒፄ ማዺ ጊኢጊሼ ባኮ</para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 19:4"/>ካኣቲ ዒዮሳፒፄ ዎዚ ዬሩሳላሜይዳ ናንጋያ ማዔቴያ ዴሮ ፔኤኮ ቤርታኣ ዓዶንሢኮ ፆኦዛሢ ማዔ ናንጊና ናንጋ ጎዳ ባንሢ ማሃኒ ዾኦሎ ዛሎና ቤርሳቤፓ ዓርቃዖ ዴንዲ ኬዶ ዛሎኮ ጌሜራ ሚርጌ ዓኣ ዔፕሬኤሜ ዓጮ ጋፖ ሄላንዳኣና ሃንቲ ሃንቲ ቢያ ዎዴ ዴሮ ዞሪ ማሄኔ፤ <verse eid="2CH 19:4"/><verse number="5" style="v" sid="2CH 19:5"/>ዒዚ ዙሎ ኬልቂ ዲርቂ ዋርዲዮና ዪሁዳ ካታሞ ቢያሢዳ ሱኡጌ ዶኦራዖ፥ <verse eid="2CH 19:5"/><verse number="6" style="v" sid="2CH 19:6"/>ዔያቶም፦ «ዒንሢ ዎጌ ዎጋ ዎዶና ናንጊና ናንጋ ጎዳ ዒንሢና ዎላ ማዔሢ ዔሪ ኮሺ ዛጊ ዎጉዋቴ፤ ዒንሢ ዎጋሢ ዓሲምቱዋንቴ ፆኦሲምታሢሮ፤ <verse eid="2CH 19:6"/><verse number="7" style="v" sid="2CH 19:7"/>ፒዜ ዎጊሢ ሃሺሢ፥ ፔቴሢ ዛላ ማዒ ማኣዲ ጌስቲሢ፥ ዴሜና ሚኢሼ ዔኪሢ ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢ ኮይላ ዬይ ማዑዋያታሢሮ ናንጊና ናንጋ ጎዳ ዒጊጪ ፒዜ ዎጌ ዎጉዋቴ» ጌይ ዓይሤኔ።<verse eid="2CH 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 19:8"/>ናንጊና ናንጋ ጎዳኮ ዎጎ ዑሣ ዓኣዻያኮ፥ ጊንሣ ሃሣ ካታማ ናንጋ ዓሶ ባኣካ ማዢንታ ዎጌና ጌስቲንታንዳ ጌኤሲ ቢያ ሱኡጌ ማዒ ጌስታንዳጉዲ ሌዊ ዓሶንታ ቄኤሶንታ ዓጮ ጪማፓኣ ፔቴ ፔቴ ዔርቴያ ማዔ ዓሶ ዬሩሳላሜይዳ ካኣቲ ዒዮሳፒፄ ዶኦሬኔ፤ ዔያታ ዬሩሳላሜይዳ ዴዔኔ። <verse eid="2CH 19:8"/><verse number="9" style="v" sid="2CH 19:9"/>ዬካፓ ዒዚ ዔያቶም ሂዚ ጌዒ ዓይሤኔ፦ «ናንጊና ናንጋ ጎዳ ዒጊጪ ዒዛም ጉሙርቂንታያ ማዒ ፒዜ ዒኔና ማዾ ማዹዋቴ፤ <verse eid="2CH 19:9"/><verse number="10" style="v" sid="2CH 19:10"/>ዒንሢ ዓጮይዳ ዓኣ ዒንሢ ዓሶ ማዔ ዒጊኖ ቢያ ዎኖ ካታማፓኣ ማዖም ዓሲ ዎዺ፥ ዎጌ ዓይሡዋ ባኣዚ ማዺ፥ ዓይሢንቴ ዎጎ ማዺ ኩንሡዋዖ ሃሺሢና ዓርቂንቲ ዒንሢ ኮይላ ሺኢኬቴ ጎሜ ማዺ ዔያታ ናንጊና ናንጋ ጎዳ ዖዪሱዋጉዲ፥ ናንጊና ናንጋ ጎዳኮ ጎሪንታኣ ዒንሢንታ ዒንሢ ጌርሲንሢንታይዳ ሙኩዋጉዲ ላቲ ዔያቶም ኬኤዙዋቴ፤ ዬያ ዒንሢ ማዼቴ ዻቢንቲ ዒንሢኮ ማዓዓኬ። <verse eid="2CH 19:10"/><verse number="11" style="v" sid="2CH 19:11"/>ፆኦሲ ባኣዚ ዛላ ቢያ ዎጋኒ ቢታንታ ዓኣሢ ቄኤሶ ቢያኮ ዑፃሢ፥ ዓማሪያኬ፤ ዓጮ ካኣቶ ዛላ ባኣዚ ቢያ ዎጋኒ ቢታንታ ዓኣሢ ዪሁዳ ዓጮ ዎይሣ፥ ዒስማዔኤሌ ናኣዚ፥ ዜባዲያኬ፤ ሌዊ ዓሳ ዒንሢ ባኣካ ቢታንቶ ዓኣ ዓሲ ማዒ ማዻንዳኔ፤ ዒጊጩዋዖ ጫርቂ ማዹዋቴ! ናንጊና ናንጋ ጎዳ ኮሺ ማዾ ማዻ ዓሶና ዎላ ማዖንጎ!»<verse eid="2CH 19:11"/></para>
  <chapter eid="2CH 19"/>
  <chapter number="20" style="c" sid="2CH 20"/>
  <para style="s1">ዔዶኦሜ ዓሶ ዖሎና ዖሎ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 20:1"/>ዬካፓ ዓሞኦኔና ሞዓኣቤናኮ ዖሎ ዓሳ ዔያቶና ዎላ ዖልዚ ዖላኒ ጫኣቄ፥ ዔያቶኮ ላጎ ሜዑና ዓሶና ዎላ ዒዮሳፒፄ ዓጮ ዪሁዳ ዖላኒ ሙኬኔ፤ <verse eid="2CH 20:1"/><verse number="2" style="v" sid="2CH 20:2"/>ዒማና ዓሲ ሙኪ ካኣቲ፥ ዒዮሳፒፄም፦ «ኔናንታ ኔ ዓጮንታ ዖላኒ ኮሺ ዺቢ ዖልዚ ዓሲ ሶኦጎ ባዞኮ ሶንጌኖ ሱካ ዓኣ ዔዶኦሜይዳፓ ሙኬኔ፤ ሃይሾ ዔያታ ሙኪ ሃፄፆንታማሬ ሄሌኔ» ጌዒ ኬኤዜኔ፤ [ሃፄፆንታማሬኮ ባጎ ሱንፃ ዔንጌዲ ጌይንታኔ፤] <verse eid="2CH 20:2"/><verse number="3" style="v" sid="2CH 20:3"/>ዬያሮ ዒዮሳፒፄ ሚርጌና ዒጊጬሢሮ ናንጊና ናንጋ ጎዳ ፔ ማሊፆ ፔጋሲ ዔርዛንዳጉዲ ሺኢቄኔ፤ ዬካፓ ዓጮይዳ ዓኣ ዴራ ቢያ ሙኡዚ ሃሻንዳጉዲ ዓይሤኔ፤ <verse eid="2CH 20:3"/><verse number="4" style="v" sid="2CH 20:4"/>ዒማና ዪሁዳ ካታሞ ቢያሢዳፓ ናንጊና ናንጋ ጎዳ ዔያቶ ማኣዳንዳጉዲ ዖኦጫኒ ዴራ ዑካዺ ዬሩሳላሜ ሙኬኔ። <verse eid="2CH 20:4"/><verse number="5" style="v" sid="2CH 20:5"/>ዔያታ ሙካዖ ዬሩሳላሜይዳ ናንጋ ዓሶና ዎላ ፔቴይዳ ጌኤዦ ማኣሮኮ ዓኪ ጊኢጊሾና ዓሳ ቡካ ቤዞይዳ ቡኬኔ፤ ዒማና ካኣቲ ዒዮሳፒፄያ ሙኪ ዴሮ ቤርታ ዔቂ፥ <verse eid="2CH 20:5"/><verse number="6" style="v" sid="2CH 20:6"/>ዑኡዞ ፔኤኮ ዼጊዲ፦ «ኑኡኮ ቤርታኣ ዓዶንሢ ፆኦዛሢ ማዔ ናንጊና ናንጋ ጎዳሢዮ! ጫሪንጫ ዓኣዖ ዓጮ ካኣቶ ቢያ ዎይሣሢ ኔናኬ፤ ዎልቄና ቢታንቶና ቢያ ኔ ኩጫኬ፤ ኔና ቃዛኒ ዳንዳዓይ ዖኦኒያ ባኣሴ፤ <verse eid="2CH 20:6"/><verse number="7" style="v" sid="2CH 20:7"/>ኔ ኑኡኮ ፆኦሲኬ፤ ኔኤኮ ዴራ፥ ዒስራዔኤሌ ዓሳ ሃያ ዓጮ ጌሌ ዎዶና ቤርታ ሃይካ ናንጋ ሜሌ ዴሮ ኬሲ፥ ኔ ላጋሢ ዓብራሃሜ ዜርፆም ናንጊና ዔያቶ ዓጪ ማሂ ዒንጌሢ ኔናኬ፤ <note caller="-" style="x"><char style="xo" closed="false">20፡7 </char><char style="xt" closed="false"><ref loc="ISA 41:8">ዒሲ. 41፡8</ref>፤ <ref loc="JAS 2:23">ያይ. 2፡23</ref>።</char></note> <verse eid="2CH 20:7"/><verse number="8" style="v" sid="2CH 20:8"/>ኔኤኮ ዴራ ሃኖ ዓጮይዳ ሃኖ ሄላንዳኣና ናንጌኔ፤ ሃሣ ኔ ቦንቾም ጌኤሺ ማኣሪያ ማዤኔ፤ ዬያ ዔያታ ማዼሢ፦ <verse eid="2CH 20:8"/><verse number="9" style="v" sid="2CH 20:9"/>‹ኑና ኔ ሜታሳኒ ዖልዚ፥ ዱማ ዱማ ፑርታ ዶርዖታቴያ ናይዚ፤ ዬያጉዴ ሜቶ ኑ ጊዳ ኔ ዔኪ ዬዔቴ ኔ ሱንፃ ካኣሽኪንታ፥ ሃኖ ጌኤዦ ማኣሮ ቤርታ ኑ ሙኪ ዔቂ ኑ ሜታሢዳፓ ኑና ኔ ዓውሳንዳጉዲ ኔና ኑ ሺኢቃንዳኔ፤ ኔኤኒያ ኑኡኮ ሺኢጲፆ ዋይዚ ኑና ዓውሳንዳኔ› ጌዒኬ።<verse eid="2CH 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 20:10"/>«ሃይሾ ሃሢ ዓሞኦኔንታ ሞዓኣቤንታ ዔዶኦሜንታ ዴራ ኑና ዖሌኔ፤ ኑኡኮ ቤርታኣ ዓዶንሢ ጊብፄ ዓጫፓ ኬስኬ ዎዶና ዬያቶ ዴሮ ዓጮ ጌላንዳጉዲ ኔ ኮዒባኣሴ፤ ኑ ዓዶንሢ ዔያቶ ዓጮ ሺሪ ኮርሳ ዓኣዼያፓዓቴም ዔያቶ ዖሊ ባይዚባኣሴ፤ <note caller="-" style="x"><char style="xo" closed="false">20፡10 </char><char style="xt" closed="false"><ref loc="DEU 2:4-19">ላሚ. ዎማ 2፡4-19</ref>።</char></note> <verse eid="2CH 20:10"/><verse number="11" style="v" sid="2CH 20:11"/>ኑ ዔያቶም ማዼ ኮዦ ማዾ ዛሎ ዔያታ ኑም ዒንጋሢ ሃያኬ፤ ኔ ኑ ዓጪ ማሂ ዒንጌ ሳዓፓ ዳውሲ ኑና ዔያታ ኬሳኒ ሙኬኔ፤ <verse eid="2CH 20:11"/><verse number="12" style="v" sid="2CH 20:12"/>ኑ ፆኦዛሢዮ! ኑና ዖላኒ ሙኬ ሃያ ዺቦ ዖሎ ዓሶ ቢያ ቃዛኒ ኑ ዳንዳዑዋኣሢሮ ኔኤኒ ዔያቶ ፑርታና ዎጌ፤ ኑኡኒ ኔ ኑና ማኣዳንዳጉዲ ኔ ባንሢ ዛጊፓ ዓታዛ ዓይጎዋ ኑ ማዻኒ ዳንዳዑዋሴ» ጌዔኔ።<verse eid="2CH 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 20:13"/>ዒማና ዪሁዳ ዓሳ ቢያ ፔኤኮ ናኣቶንታ ላኣሎንታ ዎላ ጌኤዦ ማኣሮኮ ቤርታ ዔቂ ዓኣኔ፤ <verse eid="2CH 20:13"/><verse number="14" style="v" sid="2CH 20:14"/>ናንጊና ናንጋ ጎዳኮ ዓያና ዴሮና ዎላ ዓኣ ፔቴ ሌዊ ዓሲስኬያ ዑፃ ኬዴኔ፤ ዬይ ሌዊ ዓሢ ያሃዚዔኤሌ ጌይንታያ ዛካሪያሴ ናይኬ፤ ዒዚ ዓሳኣፔ ቶኦኪ ማዓዛ ማታኒያና ዪዒዔኤሌና ቤናያ ዛሎና፥ ሃሣ ጊንሣ ዒ ዓሳኣፔ ዜርሢኬ፤ <verse eid="2CH 20:14"/><verse number="15" style="v" sid="2CH 20:15"/>ያሃዚዔኤሌ፦ «ካኣቲዮ! ዒንሢ ሃይ ዪሁዳንታ ዬሩሳላሜንታ ዴራ ቢያ ዋይዙዋቴ! ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፤ ‹ሃጊ ማዓ ዎዛ ቲቂፖቴ፤ ሃያ ዺቦ ዖሎ ዓሶ ዖላኒ ዒጊጪፖቴ፤ ዖሎ ፆኦሲ ዖላንዳኔ፤ ዒንሢ ዖላዓኬ፤ <note caller="-" style="x"><char style="xo" closed="false">20፡15 </char><char style="xt" closed="false"><ref loc="DEU 20:1-4">ላሚ. ዎማ 20፡1-4</ref>።</char></note> <verse eid="2CH 20:15"/><verse number="16" style="v" sid="2CH 20:16"/>ዬያሮ ዚሮ ዔያታ ፂፄ ኮይሌና ዎላ ካኣሚ ዴንዳ ካሮ ሙካኣና ዔያቶ ዖሉዋቴ፤ ዪሩዔኤሌ ኮይላ ዓኣ ዓሲ ናንጉዋ ዳውሎ ዓጮ ዔኪ ዴንዳ ዶኦጮኮ ጋፖይዳ ዒንሢ ዔያቶ ዴንቃንዳኔ። <verse eid="2CH 20:16"/><verse number="17" style="v" sid="2CH 20:17"/>ዬያ ዖሎ ዖላንዳሢ ዒንሢቱዋሴ፤ ቤሲ ሌሊ ዓርቂጋፓ ካፑዋቴ፤ ናንጊና ናንጋ ጎዳ ዒንሢ ባሺሳንቴ ዒንሢ ዛጋንዳኔ፤ ዪሁዳና ዬሩሳላሜ ዓሲዮቴ! ዓልቱዋዖ ሃሣ ዒጊጩዋዖ ዚሮ ዴንዲ ዖዖሉዋቴ! ናንጊና ናንጋ ጎዳ ዒንሢና ዎላ ማዓንዳኔ!› » ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">20፡17 </char><char style="xt" closed="false"><ref loc="EXO 14:13-14">ኬሲ. ማፃ 14፡13-14</ref>።</char></note><verse eid="2CH 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 20:18"/>ዬካፓ ካኣቲ ዒዮሳፒፄና ዒዛና ዎላ ዓኣ ዪሁዳና ዬሩሳላሜናይዳ ናንጋ ዓሳ ቢያ ባሊቶ ሳዖ ሄሊሲ ናንጊና ናንጋ ጎዳም ዚጌኔ፤ <verse eid="2CH 20:18"/><verse number="19" style="v" sid="2CH 20:19"/>ዒማና ቄዓቴና ቆራሄ ቶኦኮ ማዔ፥ ሌዊ ዓሳ ዔቂ ዑኡዞ ፔኤኮ ዼጊዲ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ጋላቴኔ።<verse eid="2CH 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 20:20"/>ዴራ ዚሮ ጉቴሎ ጉቴ ዓማ ዔቂ ቴቆዓ ጌይንታ ቤሲስኬኖኮ ኮይላ ዓኣ ዓሲ ናንጉዋ ዳውሎ ዴንዴኔ፤ ዬያ ጎይፆ ዔያታ ዓኣዺፆይዳ ዓኣንቴ ዒዮሳፒፄ ዔያቶም፦ «ዒንሢ ዪሁዳና ዬሩሳላሜና ዓሳ! ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢ ጉሙርቁዋቴ፤ ዒዚ ዒንሢም ዎልቄ ዒንጋንዳኔ፤ ዒዛ ማሊፆ ኬኤዛዞንሢ ዒንሢም ኬኤዛ ባኮዋ ጉሙርቁዋቴ፤ ዒንሢም ጊኢጋንዳኔ» ጌዔኔ። <verse eid="2CH 20:20"/><verse number="21" style="v" sid="2CH 20:21"/>ካኣቲ ዒዮሳፒፄ ዴሮና ዎላ ዞርቴስካፓ ናንጊና ናንጋ ጎዳ ቦንቾም ዓይናዻ ዓሳ ዱማዼ ቦንቾ ኬሎና ማይንታ ማኣዓሢ ማይንቲ፦ «ዒዛኮ ናሹማ ናንጊና ናንጋያታሢሮ ፆኦሲ ጋላቱዋቴ!» ጌዒ ዓይናዺ ዓይናዺ ዖሎ ዓሶኮ ቤርታ ቤርታ ዓኣዻንዳጉዲ ዓይሤኔ።<verse eid="2CH 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 20:22"/>ዓይናዻ ዓሳ ዓይኑሞ ዓርቃኣና ዔያቶ ዖላኒ ሙኬ ዓሶይዳ ናንጊና ናንጋ ጎዳ ዔርቲባኣ ዖልዚ ቡሌም ዓሳ ባሺንቴኔ፤ <verse eid="2CH 20:22"/><verse number="23" style="v" sid="2CH 20:23"/>ዒማና ዓሞኦኔ ዓሶና ሞዓኣቤ ዓሶና ዔዶኦሜ ዓሶኮ ዖሎ ዓሶ ዖሊ ዎዺ ኩርሴኔ፤ ዬካፓ ጊንሣ ዎሊዳ ጌሊ ዎሊም ሚጪንቱዋዖ ዎሊ ዎዺ ኩርሴኔ፤ <verse eid="2CH 20:23"/><verse number="24" style="v" sid="2CH 20:24"/>ዪሁዳኮ ዖሎ ዓሳ ዓሲ ናንጉዋ ዳውላ ጴዻ ዼጌ ቤዞ ሙኪ ዔያቶኮ ሞርካ ዓኣ ባንፆ ዛጋንቴ ዔያቶኮ ሞርካ ቢያ ጋፒ ሌሲ ሌሊ ዓኣኔ፤ ፔቴታዖ ቶሊ ሼምፔና ዓቴ ዓሲ ባኣሴ።<verse eid="2CH 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 20:25"/>ዬካፓ ዒዮሳፒፄና ዒዛኮ ፖኦሊሶና ሞርኮኮ ዓኣ ባኮ ቢያ ዲዒ ዔካኒ ዴንዳዖ፦ ሚርጌ ባይ፥ ጋላንታ ዖልዚ ዓንጋሞንታ ማኣዖንታ ሻንቾናቴ ሚርጌ ሚኢሼ ኬሳንዳ ሜሌ ባኣዚ ዺቢ ዴንቄኔ፤ ዬያ ባኮ ዔያታ ቡኩሳኒ ሃይሦ ኬሊ ጉቤ ኩርሴኔ፤ ጋዓንቴ ዔያታ ዲዔ ባካ ኮሺ ሚርጌታሢሮ ቢያ ዔካኒ ዳንዳዒባኣሴ፤ <verse eid="2CH 20:25"/><verse number="26" style="v" sid="2CH 20:26"/>ዖይዳሳ ኬሎ ሃኖ ሄላንዳኣና «ዓንጆ ዶኦቺ» ጌይንታ ቤዛ ቡኪንቴኔ፤ ናንጊና ናንጋ ጎዳ ዔያቶም ማዼ ባኮ ዛሎዋ ቢያ ዔያታ ጋላቴኔ፤ ዬና ዶኦጬላ «ዓንጆ» ጌይንቲ ዔኤሊንቴሢ ዬያሮኬ። <verse eid="2CH 20:26"/><verse number="27" style="v" sid="2CH 20:27"/>ናንጊና ናንጋ ጎዳ ሞርኮ ዔያቶ ባሺሴሢሮ ዒዮሳፒፄ ዪሁዳንታ ዬሩሳላሜ ዓሶ ቢያ ዔኪ ዎዛና ዬሩሳላሜ ማዒ ዴንዴኔ። <verse eid="2CH 20:27"/><verse number="28" style="v" sid="2CH 20:28"/>ዔያታ ዬሩሳላሜ ሄላዖ ዛዬና ሹሉንጎና ሚርጌ ሻዦ ዴንሢ ዋርቆ ጎኦሎዋ ዋርቂ ዋርቂ ዎሊ ጊንፆ ጎዒ ጌኤዦ ማኣሪ ዴንዴኔ፤ <verse eid="2CH 20:28"/><verse number="29" style="v" sid="2CH 20:29"/>ናንጊና ናንጋ ጎዳ ዒስራዔኤሌኮ ሞርኮ ዎማይዲ ዖሊ ባሼቴያ ዋይዜ ካኣታ ቢያ ዒጊጪ ካራ ባይዜኔ። <verse eid="2CH 20:29"/><verse number="30" style="v" sid="2CH 20:30"/>ዬያሮ ዒዮሳፒፄ ዓጮ ዖልዚ ባኣያ ዎይሤኔ፤ ፆኦሲ ቢያ ዛሎና ዖልዚፓ ዒዛ ሃውሺሴኔ።<verse eid="2CH 20:30"/></para>
  <para style="s1">ዒዮሳፒፄኮ ካኣቱሞ ጋፒንፆ</para>
  <para style="r">(<ref loc="1KI 22:41-50">1ካኣቶ. ማ 22፡41-50</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="2CH 20:31"/>ዒዮሳፒፄ ዪሁዳይዳ ካኣታዼሢ ሌዓ ዒዛኮ ሃይሢታሚ ዶንጎ ማዓኣናኬ፤ ዒዚ ዬሩሳላሜይዳ ናንጊ ላማታሚ ዶንጎ ሌዔ ዎይሤኔ፤ ዒንዳ ዒዛኮ ዓዙባ ጌይንታያ ሺሊሂ ናይኬ፤ <verse eid="2CH 20:31"/><verse number="32" style="v" sid="2CH 20:32"/>ዒዮሳፒፄ ዒዛኮ ዓዶ፥ ዓኣሳጉዲ ናንጊና ናንጋ ጎዳ ቤርታ ኮሺ ማዔ ባኣዚ ቢያ ማዼኔ፤ <verse eid="2CH 20:32"/><verse number="33" style="v" sid="2CH 20:33"/>ጋዓንቴ ጌሜሮይዳ ዓኣ ሜሌ ዓሳ ፔ ፆኦዞ ካኣሽካ ቤዞ ባይዚባኣሴ፤ ዴራ ዔያቶኮ ቤርታኣ ዓዶንሢ ፆኦዛሢ ማዔ ናንጊና ናንጋ ጎዳ ባንሢ ጉቤ ዒናፓ ሃጊ ማዒባኣሴ።<verse eid="2CH 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2CH 20:34"/>ዒዮሳፒፄ ካኣታዼስካፓ ዓርቃዖ ዴንዲ ጋፖ ሄላንዳኣና ማዼ ሜሌ ባካ ቢያ ዒስራዔኤሌ ካኣቶ ሃይሳ ፃኣፒንቲ ዓኣ፥ ሃናኒ ናኣዚ ዒዩ ፃኣፔ ማፃኣፖይዳ ፃኣፒንቲ ዓኣኔ።<verse eid="2CH 20:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="2CH 20:35"/>ካኣቲ ዒዮሳፒፄ ሚርጌ ፑርታ ማዾ ማዼ ዒስራዔኤሌ ካኣቲ ዓካዚያሴና ዎላ ፔቱሞ ጌኤሲ ጌስቲ ቱኬኔ፤ <verse eid="2CH 20:35"/><verse number="36" style="v" sid="2CH 20:36"/>ዔያታ ላምዓሢ ዎላ ዔፂዮንጋብሬ ጌይንታ ባዞ ዓጫ ዋኣፆ ካኣሚላ ዔቃ ቤዞይዳ ዼኤፖ ባዞ ቲቂ ዴንዳንዳ ዋኣሢ ካኣሚሌ ዎላ ጊኢጊሼኔ፤ <verse eid="2CH 20:36"/><verse number="37" style="v" sid="2CH 20:37"/>ጋዓንቴ ማሬሻይዳ ሾይንቴ፥ ዶዳዋ ናኣዚ፥ ዔሊዔዜሬ ዒዮሳፒፄም፦ «ዓካዚያሴና ዎላ ፔቱሞ ጌኤዞ ጌስቲ ዒንሢ ቱኬሢሮ ናንጊና ናንጋ ጎዳ ኔኤኒ ማዼ ባኮ ቢያ ባይዛንዳኔ» ጌዒ ፆኦሲ ማሊሢ ኬኤዜኔ፤ ጌይንቴ ጎይፆ ዔያቶኮ ዋኣፆ ካኣሚላ ቢያ ሜቄኔ፤ ፔቴታዖ ባዞ ዑፃ ሃንቲ ማዻኒ ዳንዳዒባኣሴ።<verse eid="2CH 20:37"/></para>
  <chapter eid="2CH 20"/>
  <chapter number="21" style="c" sid="2CH 21"/>
  <para style="p">
    <verse number="1" style="v" sid="2CH 21:1"/>ዬካፓ ዒዮሳፒፄ ሃይቂ፥ ዳውቴ ካታማ ካኣታ ዱኡታ ቤዛ ዱኡቴኔ፤ ዒዛ ቤዛ ዒዛኮ ናኣዚ ዒዮራሜ ካኣታዼኔ።<verse eid="2CH 21:1"/></para>
  <para style="s1">ዪሁዳ ካኣቲ ዒዮራሜ</para>
  <para style="r">(<ref loc="2KI 8:17-24">2ካኣቶ. ማ 8፡17-24</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 21:2"/>ዪሁዳ ካኣቲ፥ ዒዮሳፒፄ ናኣዚ ዒዮራሜኮ ላሆ ጌርሲንሢ ዓኣኔ፤ ዬያታ፦ ዓዛሪያሴ፥ ዪሂዔኤሌ፥ ዛካሪያሴ፥ ዓዛሪያሴ፥ ሚካዔኤሌንታ ሼፓፂያንታኬ። <verse eid="2CH 21:2"/><verse number="3" style="v" sid="2CH 21:3"/>ዔያቶኮ ዓዴ ዔያቶም ሚርጌ ዎርቄንታ ቢራንታ፤ ዬያጉዲ ሻንቾቴ ሚርጌ ሚኢሼ ኬሳንዳ ዱማ ዱማ ባኣዚ ዒንጌኔ፤ ሃሣ ዙላ ኬልቂ ዲርቂንቴ ዪሁዳ ካታሞ ፔቴ ፔቴሢዳ ፔቴ ናይ ሱኡጌ ማሂ ዶኦሪ ዶኦሪ ጌሤኔ፤ ዒዮራሜ ቶይዶ ናዓሢ ማዔሢሮ ዓዴ ፔ ቤዛ ዒዛ ካኣታሤኔ፤ <verse eid="2CH 21:3"/><verse number="4" style="v" sid="2CH 21:4"/>ዒዮራሜ ፔኤኮ ካኣቱሞ ዶዲሺ ዴዔስካፓ ዒዛኮ ጌርሲንሢ ቢያ፤ ዬያጉዲ ፔቴ ፔቴ ዒስራዔኤሌ ዓሶ ባኣካ ቢታንታ ዓኣ ዓሲያኣ ዎዼኔ።<verse eid="2CH 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 21:5"/>ዒማና ዒዮራሜ ሃይሢታሚ ላምዖ ሌዔና ካኣታዼኔ፤ ዒዚ ዬሩሳላሜይዳ ናንጊ ሳሊ ሌዔ ዎይሤኔ፤ <verse eid="2CH 21:5"/><verse number="6" style="v" sid="2CH 21:6"/>ጋዓንቴ ዒ ዓክዓቤኮ ዉዱሮ ናኣቶፓ ፔቴ ዔካዖ ካኣቲ ዓክዓቤንታ ሜሌ ዒስራዔኤሌ ካኣታ ማዻ ፑርቶ ማዾ ማዺ ናንጊና ናንጋ ጎዳኮ ዓይሢፆ ሃሺ ጎማዼኔ፤ <verse eid="2CH 21:6"/><verse number="7" style="v" sid="2CH 21:7"/>ያዺ ማዔቴያ ናንጊና ናንጋ ጎዳ ዳውቴ ዜርፃ ካኣታዺ ዴዑዋጉዲ ባይዛኒ ኮዒባኣሴ፤ ናንጊና ናንጋ ጎዳ ዬያይዴሢ ቤርታ ዳውቴና ዎላ ጫኣቄሢሮኬ፤ ሃሣ ጊንሣ ዳውቴኮ ዜርፃ ካኣታዺ ካኣታዺ ናንጋንዳያታሢ ሃጊ ማዓንዳ ዎዛ ዳውቴም ዒንጌሢሮኬ። <note caller="-" style="x"><char style="xo" closed="false">21፡7 </char><char style="xt" closed="false"><ref loc="1KI 11:36">1ካኣቶ. ማ 11፡36</ref>።</char></note><verse eid="2CH 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 21:8"/>ዒዮራሜ ካኣታዺ ዓኣ ዎዶና ዔዶኦሜ ዪሁዳም ዋይዞ ዒፂ ፔኤሮ ፔና ዳንዳዒ ካኣቲ ካኣታሤኔ፤ <note caller="-" style="x"><char style="xo" closed="false">21፡8 </char><char style="xt" closed="false"><ref loc="GEN 27:40">ማዢ. ማፃ 27፡40</ref>።</char></note> <verse eid="2CH 21:8"/><verse number="9" style="v" sid="2CH 21:9"/>ዬያሮ ዒዮራሜ ፔኤኮ ዖሎ ዓሶ ሱኡጎና ሳርጌሎ ዖይቶና ዔኪ ዴንዲ ዔዶኦሜ ዓጮ ዖላኒ ዴንዲ ጌሊ ዓርቄኔ፤ ዒማና ዔዶኦሜኮ ዖሎ ዓሳ ዔያቶ ማንጌኔ፤ ጋዓንቴ ዒዮራሜና ዖሎ ዓሶና ዬያ ማንጌ ዓሶ ዖሊ ቶሊ ኬስኪ ዴንዴኔ፤ <verse eid="2CH 21:9"/><verse number="10" style="v" sid="2CH 21:10"/>ካኣቲ ዒዮራሜ ዒዛኮ ቤርታኣ ዓዶንሢኮ ፆኦዛሢ ማዔ ናንጊና ናንጋ ጎዳ ሃሼሢሮ ዬማፓ ዓርቃዖ ዔዶኦሜ ዪሁዳ ዴማፓ ኬስኪ ፔ ካኣቲ ዶኦሚ ዴዔኔ፤ ዒማና ሃሣ ሊቢና ካታማኣ ዪሁዳም ዋይዞ ዒፄኔ፤ <verse eid="2CH 21:10"/><verse number="11" style="v" sid="2CH 21:11"/>ዒዮራሜ ማዼ ባካ ዬያ ሌሊቱዋንቴ ዪሁዳ ዓጮኮ ጌሜሮይዳ ጌሜሮይዳ ሜሌ ዴራ ፔ ፆኦዞ ካኣሽካ ካኣዦ ቤዞ ማዤኔ፤ ሃሣ ዪሁዳንታ ዬሩሳላሜንታ ዴሮ ጎሜይዳ ዔኪ ጌልዚ ናንጊና ናንጋ ጎዳ ዖዪሴኔ።<verse eid="2CH 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 21:12"/>ዬካፓ ፆኦሲ ማሊፆ ኬኤዛ ዔኤሊያሴ ሂዚ ጋዓ ኪኢታ ፃኣፒ ዒዮራሜም ዳኬኔ፦ «ናንጊና ናንጋ ጎዳ ማዔ ኔ ዓዶ ዳውቴ ፆኦዛሢ ሂዚ ጋዓኔ፤ ‹ኔ ዓዴ ዒዮሳፒፄ ማዼ ጎይፆ፤ ጊንሣ ሃሣ ኔ ማዔ፥ ዓኣሳ ማዼ ኮዦ ማዾ ጎይፆ ኔ ማዺባኣሴ፤ <verse eid="2CH 21:12"/><verse number="13" style="v" sid="2CH 21:13"/>ጋዓንቴ ኔኤኒ ዒስራዔኤሌ ካኣታ ማዼ ፑርቶ ማዾ ጎይፆ ማዺ ዓዳ ኔ ዓዶ ዓክዓቤንታ ዒዛ ቤዛ ካኣታዼ ካኣታ ዒስራዔኤሌ ዴራ ናንጊና ናንጋ ጎዳም ጉሙርቂንቱዋጉዲ ማዼ ጎይፆ ቢያ ኔኤኒያ ዪሁዳንታ ዬሩሳላሜንታ ዴሮ ናንጊና ናንጋ ጎዳም ጉሙርቂንቱዋጉዲ ማሄኔ፤ ዬያ ሌሊቱዋንቴ ኔ ጊዳፓ ኮሺ ማዔ፥ ኔ ዓዶ ማኣራ ሾይንቴ ኔ ጌርሲንሢ ኔ ዎዼኔ፤ <verse eid="2CH 21:13"/><verse number="14" style="v" sid="2CH 21:14"/>ናንጊና ናንጋ ጎዳ ኔኤኮ ዴሮ፥ ኔኤኮ ናኣቶንታ ላኣሎንታይዳ ፑርታ ሜቶ ዓጋንዳኔ፤ ኔኤኮ ዓኣ ባካ ቢያ ባይቃንዳኔ፤ <verse eid="2CH 21:14"/><verse number="15" style="v" sid="2CH 21:15"/>ኔኤኒያ ኔኤኮ ሩቁንቶይዳ ጌላንዳ ፑርታ ዶርዖና ሩቁንታ ጎቺንቲ ዙላ ኬስካንዳያ ሄላንዳኣና ኬላ ኬላ ቃሲንቲ ዴንዳያና ኔ ሜታዻንዳኔ።› »<verse eid="2CH 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 21:16"/>ባዞ ዓጮይዳ ናንጋ ዒቶጲዮ ዓሶ ኮይላ ፒሊስፄኤሜ ዓሶንታ ዓሬቤ ዓሶንታ ናንጋኔ፤ ናንጊና ናንጋ ጎዳ ዬያቶ ዒዮራሜይዳ ሞርኬ ማሂ ዔቂሴኔ፤ <verse eid="2CH 21:16"/><verse number="17" style="v" sid="2CH 21:17"/>ዬያሮ ዬና ዓሳ ዪሁዳ ዓጮ ዖላኒ ሙኪ ጌሊ ዓርቃዖ ካኣቱሞ ማኣሮ ቡሬኔ፤ ዒዮራሜኮ ጋፒንሢ ዓካዚያሴ ጎዖስኬማ ሃሻዖ ዒዛኮ ላኣሎንታ ዓቲንቆ ናኣቶንታ ቢያ ቱኪ ዔኪ ዴንዴኔ።<verse eid="2CH 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 21:18"/>ዬያ ቢያ ባኮኮ ጊንፃፓ ናንጊና ናንጋ ጎዳ ፖዓኒ ዳንዳዑዋ ሩቁንቲ ዶርዖ ካኣቲ፥ ዒዮራሜይዳ ዓጌኔ፤ <verse eid="2CH 21:18"/><verse number="19" style="v" sid="2CH 21:19"/>ዬይ ዶርዓሢ ላምዖ ሌዔ ማዓያ ዶዲ ዶዲ ዓኣዼሢሮ ሩቁንታ ዙሌም ጎቺንቲ ኬስኬም ዒዚ ሜታሳ ሃርጌና ሃይቄኔ፤ ዒዚ ዱኡኪንታ ዓቦ ዴራ ዒዛኮ ቤርታኣ ዓዶንሢም ማዺንታ ጎይፆ ዒዛ ቦንቺ ሃንፂሌ ኩሊ ታሚ ዔኤሢባኣሴ።<verse eid="2CH 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 21:20"/>ዒዮራሜኮ ሌዓ ሃይሢታሚ ላምዖ ማዓኣናኬ ዒዚ ካኣታዼሢ፤ ዒዚ ዬሩሳላሜይዳ ናንጊ ሳሊ ሌዔ ዎይሤኔ፤ ዒዚ ሃይቃዛ ዖኦኒያ ዒዛ ዛሎ ዖዪባኣሴ፤ ዓሳ ዒዛ ዳውቴ ካታማ ዱኡኬኔ፤ ጋዓንቴ ዒዚ ካኣታ ዱኡታ ቤዛ ዱኡቲባኣሴ።<verse eid="2CH 21:20"/></para>
  <chapter eid="2CH 21"/>
  <chapter number="22" style="c" sid="2CH 22"/>
  <para style="s1">ዪሁዳ ካኣቲ ዓካዚያሴ</para>
  <para style="r">(<ref loc="2KI 8:25-29">2ካኣቶ. ማ 8፡25-29</ref>፤ <ref loc="2KI 9:21-28">9፡21-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 22:1"/>ዓሬቦ ዓሶና ዔያቶና ዎላ ዓኣ ዓሳ ዖሎሮ ሙካዖ ጉርዶ ዖሊ ዻኮ ናዖ ዓካዚያሴ ጌይንታማ ሃሻዖ ካኣቲ ዒዮራሜኮ ዓቲንቆ ናኣቶ ቢያ ዎዼኔ፤ ዬያሮ ዬሩሳላሜ ዴራ ዓካዚያሴ ዓዶ ቤዛ ካኣታሤኔ፤ <verse eid="2CH 22:1"/><verse number="2-3" style="v" sid="2CH 22:2-3"/>ዓካዚያሴ ሌዓ ላማታሚ ላምዖ ማዓኣና ካኣታዼኔ፤ ዒዚ ዬሩሳላሜይዳ ናንጊ ፔቴ ሌዔ ዎይሤኔ፤ ካኣቲ ዓክዓቤኮ ናዎ፥ ዒስራዔኤሌ ካኣቲ ዖምሪኮ ናኣዚ ናዎ ማዔ ዓታሊያ ጌይንታ ዒዛኮ ዒንዳ ፑርታ ማዾ ዒ ማዻንዳጉዲ ዞራሢሮ ዒዚ ካኣቲ ዓክዓቤ ማዻ ፑርቶ ማዾ ጎይፆ ማዼኔ፤ <verse eid="2CH 22:2-3"/><verse number="4" style="v" sid="2CH 22:4"/>ዒዛኮ ዓዴ ሃይቄስካፓ ዓክዓቤ ማኣሪ ዓሲ ማዔ ዓሳ ዒዛ ባይሲንታ ባንሢ ዞራያታሢሮ ዔያቶጉዲ ጎሜ ማዺ ናንጊና ናንጋ ጎዳ ዒዚ ዖዪሴኔ፤ <verse eid="2CH 22:4"/><verse number="5" style="v" sid="2CH 22:5"/>ዔያቶ ዞሮ ዔኪ ሶኦሪያ ካኣቲ ዓዛሄሌ ዖላኒ ዒስራዔኤሌ ካኣቲ ዒዮራሜ ዴንዳኣና ዒዚ ዎላ ዖሎሮ ዴንዴኔ፤ ዒማና ዖላ ጌሌዓዴይዳ ዓኣ ራሞቴ ኮይላ ዖሊንቴያታሢሮ ዖሎይዳ ዒዮራሜ ማኣሳኔኔ፤ <verse eid="2CH 22:5"/><verse number="6" style="v" sid="2CH 22:6"/>ዬያሮ ዒዮራሜ ማይሢንታኒ ማዒ ጊንሣ ዒይዚራዔኤሌ ካታሞ ዴንዴኔ፤ ዒማና ዓካዚያሴ ዒዮራሜ ዖኦጫኒ ዒኢካ ዓኣዼኔ።<verse eid="2CH 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 22:7"/>ዓካዚያሴ ዒዮራሜ ዖኦጫኒ ዴንዴሢ ዬማ ዒ ዴንዴ ቤዛ ዒዛኮ ባይቆ ኬሎ ማዓንዳጉዲ ናንጊና ናንጋ ጎዳ ዓይሤሢሮኬ፤ ዓካዚያሴ ዒኢካ ዴንዲ ዓኣንቴ ኒምሺ ናኣዚ ዒዩ ሙኬሢሮ ዓካዚያሴንታ ዒዮራሜንታ ዒዛ ጎይሣ ሞኦኪ ዔካኒ ኬስኬኔ፤ ዬይ ዒዩ ዓክዓቤ ዜርፃ ካኣታዺ ካኣታዺ ናንጉዋጉዲ ባይዞም ናንጊና ናንጋ ጎዳ ዶኦሜ ዓሲኬ፤ <verse eid="2CH 22:7"/><verse number="8" style="v" sid="2CH 22:8"/>ዒዩ ዓክዓቤ ዜርፆ ካኣቱሞይዳ ናንጊና ናንጋ ጎዳ ዓጌ ዎጎ ኩንሢፆይዳ ዓኣዖ ዓካዚያሴና ዎላ ሙኬ፥ ዪሁዳ ሱኡጎንታ ዓካዚያሴኮ ዒጊኖ ቢያ ዒኢካ ዴንቂ ቢያሢ ዎዼኔ። <verse eid="2CH 22:8"/><verse number="9" style="v" sid="2CH 22:9"/>ዬካፓ ዓካዚያሴ ኮዒ ዴንዴኔ፤ ዒዛ ዓሳ ሳማሪያይዳ ፑኒንቲ ዓኣንቴ ዴንቂ ዓርቃዖ፥ ዒዩ ኮይላ ዔኪ ሙኪ ዎዼኔ፤ ዔያታ ዒዛ ዱኡኩዋዖ ሃሻኒ ጌዔዖ ፔኤም ዳንዳዒንቴ ጎይፆ ጎዳም ዓይሢንቲ ማዼ፥ ዒዛኮ ማዖ፥ ካኣቲ ዒዮሳፒፄ ቦንቺ ሌዞ ዒዛኮ ዱኡኬኔ።</para>
  <para style="p" vid="2CH 22:9">ዓካዚያሴ ማኣሮ ዓሶይዳ ካኣቲ ማዓኒ ዳንዳዓ ዓሲ ፔቴታዖ ዓቲባኣሴ።<verse eid="2CH 22:9"/></para>
  <para style="s1">ዪሁዳይዳ ካኣታዼ ዓታሊያ ጎዖዞ</para>
  <para style="r">(<ref loc="2KI 11:1-3">2ካኣቶ. ማ 11፡1-3</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 22:10"/>ካኣቲ፥ ዓካዚያሴኮ ዒንዳ ዓታሊያ ፔኤኮ ናዓ ሃይቄሢ ዋይዜስካፓ ኔጉዋዖ ዪሁዳ ካኣቲ ማኣሮ ዓሳ ጉቤ ዎዺንታንዳጉዲ ዓይሤኔ። <verse eid="2CH 22:10"/><verse number="11" style="v" sid="2CH 22:11"/>ዓካዚያሴኮ ዪሆያዳዔ ጌይንታ ቄኤሴስኬያም ሌዔ ዪሆሼባዖ ጌይንታ ጌሮስኬና ዓኣኔ፤ ዒዛ ዓካዚያሴኮ ዓቲንቆ ናኣቶ ባኣካፓ ፔቴ ዒዮዓሴ ጎዖስኬማ ሱኡጋ ዎዻኒ ዑኬንቴ ዴሜና ቶሊሲ ዔኪ ዒማንታ ዒማ ዲቻ ዓሶማንታ ጌኤዦ ማኣሮ ኮይላ ዓኣ ቆልዓይዳ ዓኣቼኔ፤ ዬያይዲ ዓኣቺ ዓታሊያ ዒዛ ዎዹዋንቴ ዓይሴኔ፤ <verse eid="2CH 22:11"/><verse number="12" style="v" sid="2CH 22:12"/>ዓታሊያ ካኣታዺ ዓኣ ዎዶና ዒዮዓሴ ጌኤዦ ማኣሮይዳ ላሆ ሌዔ ዓኣሺንቲ ናንጌኔ።<verse eid="2CH 22:12"/></para>
  <chapter eid="2CH 22"/>
  <chapter number="23" style="c" sid="2CH 23"/>
  <para style="s1">ካኣቴሎ ዓታሊያ ዒፂ ማዾና ማዾ</para>
  <para style="r">(<ref loc="2KI 11:4-16">2ካኣቶ. ማ 11፡4-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 23:1"/>ላንካሳ ሌዖና ቄኤሳሢ፥ ዮዳሄ ፔቴ ባኣዚ ማዻኒ ማሌኔ፤ ዬያሮ ዒዚ ዖሎ ዓሶኮ ሱኡጌ ማዔ ዶንጎስኬንሢና ዎላ ጊኢጊ ጫኣቄኔ፤ ዬያታ ዖሎ ዓሶ ሱኡጋ፦ ዪሮሃሜ ናኣዚ ዓዛሪያሴ፥ ዬሆሃናኔ ናኣዚ ዒስማዔኤሌ፥ ዖቤዴ ናኣዚ ዓዛሪያሴ፥ ዓዳያ ናኣዚ ማዕሴያንታ ዚክሪ ናኣዚ ዔልሳፓፄንታኬ፤ <verse eid="2CH 23:1"/><verse number="2" style="v" sid="2CH 23:2"/>ዬያታ ዶንጎ ፖኦሊሶ ሱኡጋ ዪሁዳ ካታሞ ቢያ ዴንዲ ሌዊ ዓሶና ዱማ ዱማ ቶኦኮኮ ሱኡጎና ቢያ ዔኪ ዬሩሳላሜ ሙኬኔ።<verse eid="2CH 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 23:3"/>ዬይ ዓሳ ቢያ ፔቱሞና ጌኤዦ ማኣሮይዳ ቡኪ ካኣቲ ናኣዚ ዒዮዓሴና ዎላ ማዓኒ ጊኢጊ ጫኣቄኔ፤ ዒማና ቄኤሳሢ ዮዳሄ፦ «ናንጊና ናንጋ ጎዳ ዳውቴም ‹ኔ ናኣታ ካኣታዺ ካኣታዺ ናንጋንዳኔ› ጌዒ ጫኣቄ ጎይፆና ሃሢ ካኣታዻንዳያ ኮይሳሢ ዒዮዓሴኬ፤ <note caller="-" style="x"><char style="xo" closed="false">23፡3 </char><char style="xt" closed="false"><ref loc="2SA 7:12">2ሳሙ. 7፡12</ref>።</char></note> <verse eid="2CH 23:3"/><verse number="4" style="v" sid="2CH 23:4"/>ሃሢ ኑ ማዻንዳያ ኮይሳሢ ያዺኬ፤ ቄኤሶና ሌዊ ዓሶና ሃውሾ ኬሎ ማዾ ማዻኒ ሙካዖ ሃይሦ ቤሲ ማዒ ፓቂንቶንጎ፤ ዔያቶይዳፓ ፔቴ ቤዛ ፓቆና ዓሳ ጌኤዦ ማኣሪ ጌሎ ካሮ ካፖንጎ፤ <verse eid="2CH 23:4"/><verse number="5" style="v" sid="2CH 23:5"/>ላሚ ሃሣ ፓቆና ዓሳ ጌኤዦ ማኣሮ ካፖንጎ፤ ጋፒንፃ ሃይሣሶ ፓቆና ዓሳ ማኣሮ ዓይፆ ዾቆና ካሮ ጌይንታዞ ካፖንጎ፤ ዴራ ቢያ ጌኤዦ ማኣሮይዳ ዓሳ ቡካ ቤዛ ቡኪንቶንጎ፤ <verse eid="2CH 23:5"/><verse number="6" style="v" sid="2CH 23:6"/>ማዾ ማዻ ቄኤሶና ሌዊ ዓሶናፓ ዓቴም ሜሌ ዓይጎ ዓሲያ ጌኤዦ ማኣሪ ጌላንዳያ ኮይሱዋሴ፤ ቄኤሶና ሌዊ ዓሶና ጋዓንቴ ናንጊና ናንጋ ጎዳም ዱማዼያታሢሮ ጌላኒ ዳንዳዓኔ፤ ዓቴ ሃንጎ ዓሳ ጋዓንቴ ናንጊና ናንጋ ጎዳኮ ዓይሢፆ ኩንሢ ጌኤዦ ማኣሮኮ ዙላ ማዖንጎ። <verse eid="2CH 23:6"/><verse number="7" style="v" sid="2CH 23:7"/>ሌዊ ዓሳ ፔኤኮ ጬንቾ ዓፓሮ ቱጊ ዓርቂ ካኣቲ ኮይላ ዔቂ ካኣቲ ካፖንጎ፤ ካኣቲ ዓኣዻ ቤዞ ቢያ ዎላ ዴንዶንጎ፤ ጌኤዦ ማኣሪ ጌላኒ ኮዓ ዓይጎ ዓሲያ ቢያ ዎዎዾንጎ» ጌዔኔ።<verse eid="2CH 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 23:8"/>ዬያሮ ሌዊ ዓሶንታ ዪሁዳ ዓሶንታ ቄኤሳሢ፥ ዮዳሄ ዓይሤ ባኮ ቢያ ኩንሤኔ፤ ዮዳሄ ዒማና ፔኤኮ ማዾ ማዺ ሃውሾ ኬሎና ጉሪ ማዔ ሌዊ ዓሶ ፔ ማኣሪ ዳኪባኣሴ፤ ፖኦሊሴ ማዒ ካፓ ዓሶንታ ካፒ ፔ ኬሎ ጋፒሴዖ ዓኣ ዓሳኣ ዒኢካታሢሮ ፖኦሊሶ ዓይሣ ዓሶኮ ጊዳ ዓሲ ዓኣኔ፤ <verse eid="2CH 23:8"/><verse number="9" style="v" sid="2CH 23:9"/>ዒማና ዮዳሄ ጌኤዦ ማኣሮይዳ ጌሢንቲ ዓኣ ካኣቲ ዳውቴኮ ዎርፆና ጊቲሞና ዔኪ ፖኦሊሶ ሱኡጎም ዒንጌኔ፤ <verse eid="2CH 23:9"/><verse number="10" style="v" sid="2CH 23:10"/>ጬንቾ ዓፓሮ ቱጊ ዓርቂ ዓኣ ፖኦሊሳ ቢያ ካኣቲ ዔኤቢ ሄሉዋጉዲ ካፖም ፆኦሲም ዒንጎ ባኮ ሺኢሾ ቤዞ ዛሊና ጌኤዦ ማኣሮኮ ሆታ ዎሊ ጊንፆ ዔቂሴኔ። <verse eid="2CH 23:10"/><verse number="11" style="v" sid="2CH 23:11"/>ዬካፓ ዒዮዓሴ ዓኣ ቤዛፓ ኬስኪ ካኣቶኮ ቶኦካ ዓጎ ባኮ ዓጌኔ፤ ዒዚ ካኣታዻዖ ዛጊ ዎይሣንዳ ዎጎ ፃኣፖናያ ዒዛም ዒንጌኔ፤ ዬያይዲ ቄኤሳሢ፥ ዮዳሄንታ ናኣቶንታ ዒዮዓሴ ዶኦሚ ካኣታሤኔ፤ ዒማና ዴራ ዑኡዞ ዼጊዲ፦ «ካኣቲ ናንጊና ካኣታዾንጎ!» ጌዒ ፔኤኮ ዎዞ ዔርዜኔ።<verse eid="2CH 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 23:12"/>ዓታሊያ ዴራ ካኣቲም ዒላሼ ዒላሺፆና ዒላቶ ዋይዛዖ ዴራ ቡኬ፥ ጌኤዦ ማኣሮ ሩኡሪና ሙኬኔ። <verse eid="2CH 23:12"/><verse number="13" style="v" sid="2CH 23:13"/>ዒኢካ ዒዛ ሙኪ ሄሊ ዓኮ ካኣታሢ ዳምቦ ጎይፆና ካኣቶም ኮይሳ፥ ጌኤዦ ማኣሮኮ ጌሎ ካራ ዓኣ ቱርቱሮ ኮይላ ዒዛኮ ኮሮይዳ ፖኦሊሶ ሱኡጎና ዛያሢ ዋርቃ ዓሶና ዔቂ ዓኣንቴ ዴንቄኔ፤ ዴራ ቢያ ዒናፓ ዎዛዺ ዒላሻኔ፤ ዛያሢ ዋርቃ ዓሳኣ ዛያሢ ዋርቃኔ፤ ጌኤዦ ማኣሮይዳ ዓይናዻ ዓሳ ፔኤኮ ዓይኑሞ ዓንጎ ዋርቂ ዋርቂ ዬያ ቦንቾ ዳምቦ ኩንሢሳኔ፤ ዬያሮ ዓታሊያ ዲቃቲ ማኣዓሢ ፔኤኮ ዳርዛዖ፦ «ሃይ ታና ዒፂ ማዾ ጌኔ ማዾኬ! ጌኔኬ!» ጌይ ዒላቴኔ።<verse eid="2CH 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 23:14"/>ጌኤዦ ማኣሮ ዲሮ ጋራ ዓሳ ዓታሊያ ዎዻንዳጉዲ ዮዳሄ ኮይባኣሴ፤ ዬያሮ ፖኦሊሶ ሱኡጎ ዔኤላዖ፦ «ሻውሎና ሚዛቆ ዛሎናይዳ ዎሊ ጊንፆ ዔቂ ካፓ ፖኦሊሶ ባኣኪና ዔኪ ኬሱዋቴ፤ ዒዞ ዓውሳኒ ማላ ዓሲ ጴዼቴ ዎዎዹዋቴ» ጌዒ ዓይሤኔ።<verse eid="2CH 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 23:15"/>ዔያታ ዒዞ ዲውቺዲ ዓርቂ ካኣቱሞ ማኣሪ ዔኪ ዴንዲ ዒኢካ «ፓራሢ ጌላ ካሮ» ጌይንታ ቤዞይዳ ዎዼኔ።<verse eid="2CH 23:15"/></para>
  <para style="s1">ዮዳሄ ጊንሣ ኮሼ ባኮ</para>
  <para style="r">(<ref loc="2KI 11:17-20">2ካኣቶ. ማ 11፡17-20</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 23:16"/>ቄኤሳሢ፥ ዮዳሄ ፔኤሮ፤ ሃሣ ጊንሣ ካኣቲ ዒዮዓሴንታ ዴሮንታ ናንጊና ናንጋ ጎዳ ዴሬ ማዔሢ ላሚ ጊንሣ ዓካሲ ጫኣቂሴኔ፤ <verse eid="2CH 23:16"/><verse number="17" style="v" sid="2CH 23:17"/>ዬካፓ ቢያሢ ፔቱሞና ዴንዲ ባዓኣሌ ጌይንታ ሜሌ ፆኦዞ ካኣሽኮ ማኣሮ ሻሄኔ፤ ዬያ ፆኦዞም ዒንጎ ባኮ ዒንጎ ቤዞንታ ፆኦዞ ማሊሲ ኮሾና ባኮዋ ቢያ ሜንሤኔ፤ ማኣታኣኔ ጌይንታ ዬያ ፆኦዞኮ ቄኤሳሢያ ዒንጎ ባኮ ሺኢሾ ቤዞኮ ቤርታ ዎዼኔ።<verse eid="2CH 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 23:18"/>ዮዳሄ ቄኤሶንታ ሌዊ ዓሶንታ ጌኤዦ ማኣሮይዳ ማዾ ማዾኮ ሱኡጌ ማሄኔ፤ ዬያቶኮ ማዻ ካኣቲ፥ ዳውቴ ዔያቶ ማዾም ዓይሤ ባኮ ማዺሢና ሙሴ ዎጎ ጎይፆና ናንጊና ናንጋ ጎዳም ዒንጊንታ ባኮ ሚቺሢኬ፤ ዬያጉዲ ሃሣ ዳውቴ ዓይሤ ጎይፆና ዓይኑሞ ዓይናዺሢና ቦንቾ ኬሊ ዳምቤ ኩንሢሲሢ ዔያቶም ዒንጊንቴ ማዾኬ፤ <verse eid="2CH 23:18"/><verse number="19" style="v" sid="2CH 23:19"/>ዓይጎ ዓሲያ ማዖም ፔና ጌኤሺባኣ ዓሲ ጌኤዦ ማኣሪ ጌሉዋጉዲ ጌኤዦ ማኣሪ ጌሎ ካሮ ካሮ ካፓንዳ ዓሲ ዮዳሄ ጌሤኔ።<verse eid="2CH 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 23:20"/>ፖኦሊሶ ሱኡጋ፥ ዔርቴ ዓጮ ጪማ፥ ካኣቲ ዒንጌ ቢታንታ ዓኣ ዓሶንታ ሃንጎ ዴራ ጉቤ ዮዳሄና ዎላ ጌኤዦ ማኣራፓ ዴንዲ ካኣቱሞ ማኣሪ ሄላንዳኣና ዓኣዼኔ፤ ዔያታ ዒማና ካኣቱሞ ማኣሪ ጌሎ ዼኤፖ ካሮና ጌሌም ካኣቲ ፔኤኮ ካኣቱሞ ዖይታ ዴዔኔ፤ <verse eid="2CH 23:20"/><verse number="21" style="v" sid="2CH 23:21"/>ዴራ ቢያ ዼኤፒ ዎዛ ዎዛዼኔ፤ ዓታሊያ ዎዺንቴሢሮ ካታሞይዳ ሜታ ባኣያ ኮሺ ማዔኔ።<verse eid="2CH 23:21"/></para>
  <chapter eid="2CH 23"/>
  <chapter number="24" style="c" sid="2CH 24"/>
  <para style="s1">ዪሁዳ ካኣቲ ዒዮዓሴ</para>
  <para style="r">(<ref loc="2KI 12:1-16">2ካኣቶ. ማ 12፡1-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 24:1"/>ዒዮዓሴ ላንካይ ሌዔ ማዔያ ዻካ ናይ ዓኣዖ ዪሁዳይዳ ካኣታዼኔ፤ ዒዚ ዬሩሳላሜይዳ ናንጊ ዖይዲታሚ ሌዔ ዎይሤኔ፤ ዒዛኮ ዒንዳ ፂቢያ ጌይንታያ ቤርሳቤ ካታማ ሾይንቴያኬ፤ <verse eid="2CH 24:1"/><verse number="2" style="v" sid="2CH 24:2"/>ቄኤሳሢ ዮዳሄ ሼምፔና ዓኣ ዎዶና ቢያ ዒዮዓሴ ናንጊና ናንጋ ጎዳ ዎዛሳ ማዾ ማዼኔ፤ <verse eid="2CH 24:2"/><verse number="3" style="v" sid="2CH 24:3"/>ካኣቲ፥ ዒዮዓሴ ዔካንዳጉዲ ላምዖ ላኣሊ ዮዳሄ ዶኦሬም ዔኪ ዬንሢ ላኣሎፓ ዓቲንቄ ናይና ዉዱሮ ናይያኣ ሾዔኔ።<verse eid="2CH 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 24:4"/>ዒዮዓሴ ካኣታዼስካፓ ዻካ ጋዓዖ ጌኤዦ ማኣሮ ዓካሲ ማዣኒ ማሌኔ፤ <verse eid="2CH 24:4"/><verse number="5" style="v" sid="2CH 24:5"/>ዬያሮ ቄኤሶና ሌዊ ዓሶና ፔቴይዳ ዔኤላዖ፦ «ዪሁዳ ካታሞ ቢያ ዴንዲ ፆኦዛሢ ማኣሮ ሌዓ ሌዓ ዓካሲ ማዦንዶያ ጊዳ ሚኢሼ ዒስራዔኤሌ ዴሮ ቢያሢፓ ዑኬና ኬሲሱዋቴ» ጌዒ ዓይሤኔ፤ ሌዊ ዓሳ ጋዓንቴ ዬያ ቦሃዖ ማሊፆ ሃሺ ናጌኔ፤ <verse eid="2CH 24:5"/><verse number="6" style="v" sid="2CH 24:6"/>ዒማና ካኣቲ፥ ዒዮዓሴ ሌዊ ዓሶኮ ሱኡጋሢ ዮዳሄ ዔኤላዖ፦ «ናንጊና ናንጋ ጎዳ ዓይላሢ፥ ሙሴ ፆኦሲ ካኣሽኪንታ ዓፒሎና ማዢንቴ ማኣሮይዳ ማዺንቶ ባኮኮ ማዓንዳያ ሚኢሼ ዒስራዔኤሌ ዴራ ጊኢራንዳጉዲ ዓይሤሢ ሌዊ ዓሳ ዪሁዳና ዬሩሳላሜ ዴሮናፓ ኬሲሲ ዔኪ ዬዓንዳጉዲ ዓይጋ ኔ ዔያቶም ኬኤዙዋዖ ሃሼይ?» ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">24፡6 </char><char style="xt" closed="false"><ref loc="EXO 30:11-16">ኬሲ. ማፃ 30፡11-16</ref>።</char></note><verse eid="2CH 24:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 24:7"/>ዬኖ ዓታሊያ ጌይንታ ፑርቶ ላኣሌሎኮ ዓሳ ጌኤዦ ማኣሮ ፑርቲሴኔ፤ ጌኤዦ ማኣራ ማዺንቶ፥ ፆኦሲም ዱማዼ ሜሆዋ ዓቱዋዖ ዔኪ ባዓኣሌ ጌይንታ ፆኦዞ ካኣሽኮያ ማሄኔ።<verse eid="2CH 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 24:8"/>ካኣቲ፥ ዒዮዓሴ፦ «ሚኢሼ ዔኮንዶ ሳኣፂኔ ኮሺ ጌኤዦ ማኣሪ ጌሎ ዲሮ ካራ ዙሊና ጌሡዋቴ» ጌዒ ሌዊ ዓሶ ዓይሤኔ፤ <verse eid="2CH 24:8"/><verse number="9" style="v" sid="2CH 24:9"/>ዬካፓ ሌዊ ዓሳ ዬሩሳላሜና ዪሁዳ ዓጮ ቢያሢዳ ናንጋ ዓሳ ቢያ ናንጊና ናንጋ ጎዳ ዓይላሢ፥ ሙሴ ዓሲ ናንጉዋ ዳውሎይዳ ፔቴ ጌዒ ዒስራዔኤሌ ዴሮፓ ኬሲሲ ዔካንዳጉዲ ዓይሤ ጊኢሮ ናንጊና ናንጋ ጎዳም ዔኪ ዬዓዳንዳጉዲ ዓይሥሢ ዳኬኔ፤ <verse eid="2CH 24:9"/><verse number="10" style="v" sid="2CH 24:10"/>ዬይ ዓይሢፃ ዴሮና ዴሮኮ ሱኡጎና ቢያ ዎዛሴሢሮ ሚኢሾ ዔኪ ሙኪ ሳኣፂኖ ዓጊ ኩንሤኔ። <verse eid="2CH 24:10"/><verse number="11" style="v" sid="2CH 24:11"/>ዬያሮ ሌዊ ዓሳ ሳኣፂኖ ዔኪ ዔኪ ካኣቲ ቢታንቶ ዒንጌ ሱኡጎም ቢያ ኬሊ ዒንጋኔ። ዬይ ሚኢሻ ሳኣፂኖ ኩማማና ኩማማና ጌኤዦ ማኣራ ፃኣፖ ባኮ ፃኣፓሢና ቄኤሶ ሱኡጋሢ ዶኦሪ ጌሤም ዎላ ማዻ ዓሢና ሚኢሾ ዔኬስካፓ ማሂ ጊንሣ ሳኣፂኖ ቤዛ ጌሣኔ፤ ዬያይዲ ዔያታ ሚርጌ ሚኢሼ ቡኩሴኔ።<verse eid="2CH 24:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 24:12"/>ካኣቲና ቄኤሳሢ ዮዳሄና ሚኢሾ ዔካዖ ጌኤዦ ማኣሮ ዓካሳኒ ማዢሳ ሱኡጎም ዒንጋኔ፤ ዬያታ ሱኡጋ ዬያ ሚኢሾና ጌኤዦ ማኣሮ ሹጮና ኮሻ ዓሶ፥ ሚፆና ማዢ ኮሻ ዓሶንታ ዱማ ዱማ ዓንጎና ኮሻ ዓሶዋ ዔኪ ማዺሻኔ፤ <verse eid="2CH 24:12"/><verse number="13" style="v" sid="2CH 24:13"/>ዬይ ማዻ ዓሳ ዶዲ ማዺ ጌኤዦ ማኣሮ ቤርታኣሲ ጎይፆማ ጊንሣ ዓካሲ ኮሼኔ። <verse eid="2CH 24:13"/><verse number="14" style="v" sid="2CH 24:14"/>ዬይ ማዻ ጋፔስካፓ ዓቴ ሚኢሾ ካኣቲ ዒዮዓሴና ቄኤሳሢ ዮዳሄናም ዒንጌኔ፤ ዔያታ ዬያ ዓቴሢና ጌኤዦ ማኣሮይዳ ማዾ ማዺንቶ ሜሆና ዒንጎ ባካ ዒንጊንታንዳጉዲ ዔቶ ሳኣኖንታ ዱማ ዱማ ባኣዚያኣ ሻንቄኔ።</para>
  <para style="s1" vid="2CH 24:14">ዮዳሄ ዔኪ ዓኣዻ ጎይፃፓ ዔባ ላኣሚንቴሢ</para>
  <para style="p" vid="2CH 24:14">ዮዳሄ ሼምፔና ዓኣ ዎዶና ቢያ ኬሊ ጌኤዦ ማኣሮይዳ ናንጊና ናንጋ ጎዳም ዒንጎ ባካ ዒንጊንታኔ፤ <verse eid="2CH 24:14"/><verse number="15" style="v" sid="2CH 24:15"/>ዮዳሄ ጊዳንዳያ ሄላንዳኣና ጋርቺ ሌዓ ዒዛኮ ፄኤታና ሃይሢታሚ ማዓዛ ሃይቄኔ፤ <verse eid="2CH 24:15"/><verse number="16" style="v" sid="2CH 24:16"/>ዒዚ ዒስራዔኤሌ ዴሮም፤ ሃሣ ጊንሣ ፆኦሲንታ ጌኤዦ ማኣሮንታም ማዼ ማዾ ዛሎሮ ዳውቴ ካታማ ዓኣ ካኣታ ዱኡታ ቤዛ ዓሳ ዒዛ ዱኡኬኔ።<verse eid="2CH 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 24:17"/>ዮዳሄ ሃይቄስካፓ ጋዓንቴ ዪሁዳ ዓሶ ሱኡጋ ካኣቲ፥ ዒዮዓሴ ኮይላ ሙካዖ ዳዲ ባዒ ዔያታ ኮዓ ማሊፆ ኬኤዜኔ፤ ዒዚያ ዔያቶ ሃይሶና ዎላ ጊኢጌኔ፤ <verse eid="2CH 24:17"/><verse number="18" style="v" sid="2CH 24:18"/>ዬያሮ ዴራ ዔያቶኮ ቤርታኣ ዓዶንሢ ፆኦዛሢ ማዔ ናንጊና ናንጋ ጎዳኮ ጌኤዦ ማኣሮይዳ ዚጊፆ ሃሺ ዓሼራ ጌይንታ ላኣሎ ፆኦዜሎ ማሊሲ ማዦና ባኮንታ ሜሌ ፆኦዞማኣ ዚጊ ካኣሽኪሢ ዓርቄኔ። ዴራ ዬያ ጎሞ ማዼሢሮ ፆኦሲ ዪሁዳና ዬሩሳላሜናይዳ ዻጋዺ ዔቄኔ። <verse eid="2CH 24:18"/><verse number="19" style="v" sid="2CH 24:19"/>ናንጊና ናንጋ ጎዳ ፔ ባንሢ ማዓንዳጉዲ ዴሮም ላቲ ኬኤዛንዳ፥ ፆኦሲ ማሊሢ ኬኤዛ ዓሲ ዳኬኔ፤ ዬይ ዓሳ ኬኤዛዛ ዴራ ዔያቶሲ ዋይዚባኣሴ፤ <verse eid="2CH 24:19"/><verse number="20" style="v" sid="2CH 24:20"/>ዬካፓ ፆኦሲኮ ዓያና ቄኤሳሢ፥ ዮዳሄ ናኣዚ ዛካሪያሴይዳ ኬዴኔ፤ ዬያሮ ዒዚ ዴራ ዒዛ ዴንቃንዳ ዼጌ ቤሲዳ ኬስኪ ዔቃዖ፦ «ፆኦሲ ‹ታኣኮ ዓይሢፆ ዒንሢ ዓይጎሮ ኩንሦ ሃሻይ? ዒንሢዳ ዒንሢሮ ዒንሢ ባይሲንታ ዓይጎሮ ዔኪ ሙካይ?› ጌይ ዒንሢ ዖኦጫኔ፤ ዓካሪ ሃሢ ዒንሢ ዒዛ ሃሼሢሮ ዒዚያ ዒንሢ ሃሼኔ!» ጌዔኔ። <verse eid="2CH 24:20"/><verse number="21" style="v" sid="2CH 24:21"/>ዴራ ዒማና ዎላ ጫኣቂ ዔቂ፥ ካኣቲያ ዔያቶ ዓይሤም ጌኤዦ ማኣሮይዳ ዴራ ቡካ ጶኦኮይዳ ሹቻ ዹይ ዛካሪያሴ ዎዼኔ። <note caller="-" style="x"><char style="xo" closed="false">24፡21 </char><char style="xt" closed="false"><ref loc="MAT 23:35">ማቲ. 23፡35</ref>፤ <ref loc="LUK 11:51">ሉቃ. 11፡51</ref>።</char></note> <verse eid="2CH 24:21"/><verse number="22" style="v" sid="2CH 24:22"/>ካኣቲ፥ ዒዮዓሴ ዛካሪያሴኮ ዓዴ ዮዳሄ ዒዛም ማዼ ኮዦ ማዾ ማሉዋዖ ዛካሪያሴ ዎዺሼኔ፤ ዛካሪያሴ ሃይቃኒ ሳዛ ጋሽኪቤቃ፦ «ናንጊና ናንጋ ጎዳ ሃያ ጌኖ ማዾ ኔኤኮ ዛጊ ኔ ጊዳ ፑርታ ሜቶ ዓጎም!» ጌዔኔ።<verse eid="2CH 24:22"/></para>
  <para style="s1">ዒዮዓሴኮ ካኣታቶ ጋፒንፆ</para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 24:23"/>ዬኖ ሌዖኮ ሲላ ዓጊኒ ማዓኣና ሶኦሪያ ዓጮ ዖሎ ዓሳ ዪሁዳና ዬሩሳላሜ ዓጮና ዖሊ ሱኡጎ ቢያ ዎዼኔ፤ ዑሣ ዓኣዼ ሚርጌ ባኣዚያ ዲዒ ዔኪ ዴማስቆ ማዒ ዴንዴኔ፤ <verse eid="2CH 24:23"/><verse number="24" style="v" sid="2CH 24:24"/>ዒማና ሶኦሪያ ዓሶኮ ዖሎ ዓሶንሢ ዻካኬ፤ ጋዓንቴ ሚርጌ ዺቢ ማዔ ዪሁዳኮ ዖሎ ዓሶ ባሻንዳጉዲ ናንጊና ናንጋ ጎዳ ዓይሤኔ፤ ዬይ ያዺ ማዔሢ ዪሁዳ ዓሳ ዔያቶኮ ቤርታኣ ዓዶንሢ ፆኦዛሢ ማዔ ናንጊና ናንጋ ጎዳ ሃሼሢሮኬ፤ ያዺ ማዒፆና ዒዮዓሴይዳ ፒዜ ዎጌ ዎጊንቴኔ። <verse eid="2CH 24:24"/><verse number="25" style="v" sid="2CH 24:25"/>ዒዚ ዒማና ዖሎይዳ ማኣሳኒ ኪፃዼኔ፤ ሞርኮኮ ዖሎ ዓሳ ማዒ ዴንዳዛ ዒዛኮ ዶንዛ ማዒ ዓኣ፥ ዒዚ ቢታንቶ ዒንጌ ዓሶፓ ዛላ ዓሲ ዎላ ጌኔ ማዻኒ ማሊ ቄኤሳሢ ዮዳሄ ናኣዚ ሱጉፆ ማሂሢሮ ሻኣላ ላሂ ዓኣንቴ ዒዛ ዎዼኔ፤ ዒዚ ዳውቴ ካታማ ዱኡቴኔ፤ ጋዓንቴ ካኣታ ዱኡታ ቤዛ ዱኡቲባኣሴ። <verse eid="2CH 24:25"/><verse number="26" style="v" sid="2CH 24:26"/>ዬያይዲ ጌኔ ማሊሢና ካኣቲ ዎዼ ዓሳ ሺምዓቶ ጌይንታ ዓሞኦኔይዳ ሾይንቴ ዓሲስኬኖ ናኣዚ ዛባዴና ሺምሪቶ ጌይንታ ሞዓኣቤይዳ ሾይንቴስኬኖ ናኣዚ ዪሆዛባዴናኬ። <verse eid="2CH 24:26"/><verse number="27" style="v" sid="2CH 24:27"/>ዒዮዓሴ ናኣቶ ሃይሶንታ ዒዮዓሴም ኬኤዚንቴ ፆኦሲ ማሊፆንታ ዒዮዓሴ ጌኤዦ ማኣሮ ዎዲ ዓካሲ ማዤቴያ ካኣቶ ሃይሳ ፃኣፒንቲ ዓኣ ማፃኣፓ ፃኣፒንቲ ዓኣኔ፤ ዒዛ ቤዛ ዒዛኮ ናኣዚ ዓሜሲያሴ ካኣታዼኔ።<verse eid="2CH 24:27"/></para>
  <chapter eid="2CH 24"/>
  <chapter number="25" style="c" sid="2CH 25"/>
  <para style="s1">ዪሁዳ ካኣቲ ዓሜሲያሴ</para>
  <para style="r">(<ref loc="2KI 14:2-6">2ካኣቶ. ማ 14፡2-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 25:1"/>ዓሜሲያሴኮ ሌዓ ላማታሚ ዶንጎ ማዓዛ ካኣታዼኔ፤ ዒዚ ዬሩሳላሜይዳ ናንጊ ላማታሚ ታዞጳ ሌዔ ዎይሤኔ፤ ዒዛኮ ዒንዳ ዪሆዓዲኖ ጌይንታያ ዬሩሳላሜይዳ ሾይንቴያኬ፤ <verse eid="2CH 25:1"/><verse number="2" style="v" sid="2CH 25:2"/>ዓሜሲያሴ ናንጊና ናንጋ ጎዳ ዎዛሳ ባኣዚ ማዼኔ፤ ጋዓንቴ ፔቴ ፔቴና ዒ ማዻ ባኮ ዒናፓ ማዹዋሴ፤ <verse eid="2CH 25:2"/><verse number="3" style="v" sid="2CH 25:3"/>ዒዚ ካኣቱሞ ፔኤኮ ዶዲሺ ዴዔስካፓ ኔጉዋዖ ዒዛኮ ዓዶ ዎዼ፥ ቢታንቶና ዓኣ ዓሶ ጉቤ ዎዼኔ፤ <verse eid="2CH 25:3"/><verse number="4" style="v" sid="2CH 25:4"/>ጋዓንቴ ዬያ ዓሶኮ ናኣቶ ዎዺባኣሴ፤ ዓይጎሮ ጌዔቶ ናንጊና ናንጋ ጎዳ ሙሴ ዛሎና ዒንጌ ዎጎይዳ፦ «ሾዔ ዓሳ ናኣታ ማዼ ዻቢንቲና፤ ናኣታ ጊንሣ ሾዔ ዓሳ ማዼ ዻቢንቲና ዎዺንቶፓ። ዓሲ ዎዺንታኒ ኮይሳሢ ፔኤሮ ማዼ ዻቢንቲና ሌሊኬ» ጌይ ኬኤዜ ቃኣሎ ቦንቺኬ። <note caller="-" style="x"><char style="xo" closed="false">25፡4 </char><char style="xt" closed="false"><ref loc="DEU 24:16">ላሚ. ዎማ 24፡16</ref>።</char></note><verse eid="2CH 25:4"/></para>
  <para style="s1">ዔዶኦሜ ዓሶ ዖሎናሢ</para>
  <para style="r">(<ref loc="2KI 14:7">2ካኣቶ. ማ 14፡7</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 25:5"/>ካኣቲ ዓሜሲያሴ ዪሁዳንታ ቢኢኒያሜንታ ፃጶ ማዔ ዓቲንቆ ቢያ ቶኦኮና ቶኦኮና ፓቂ፥ ፓቆና ዓሶም ሺያ ዓሲ ዓይሣያና ፄኤታ ዓሲ ዓይሣ ሱኡጌ ዶኦሪ ጌሤኔ፤ ዬያ ፓቆና ዓሶኮ ሌዓ ላማታሚና ዬያፓ ዑሣ ማዔ ዓቲንቆ ቢያ ማዓዛ ሚርጉማ ዔያቶኮ ሃይሦ ፄኤታ ሺያኬ፤ ዔያታ ዖልዚም ጊኢጊንቴያ፥ ዎርሢና ጊቲማና ዓርቆ ጎይሢ ዔሬያ ዔርቴ ፖኦሊሴኬ፤ <verse eid="2CH 25:5"/><verse number="6" style="v" sid="2CH 25:6"/>ዓሜሲያሴ ሃሣ ሃይሦ ሺያና ዖይዶ ፄኤታ ኪሎ ማዓ ሹቺ ቢራና ዒስራዔኤሌ ፃጳፓ ፄኤታ ሺያ ፖኦሊሴ ሻንቄኔ፤ <verse eid="2CH 25:6"/><verse number="7" style="v" sid="2CH 25:7"/>ጋዓንቴ ፔቴ ፆኦሲ ማሊሢ ኬኤዛስኬይ ዓሜሲያሴ ኮይላ ሙኪ፦ «ሃኣቶ ዒስራዔኤሌ ፖኦሊሶ ዔኪ ዖሎ ኬስኪፖ፤ ዓይጎሮ ጌዔቴ ናንጊና ናንጋ ጎዳ ዒስራዔኤሌ ዓሶ ማዔ ዔፕሬኤሜ ዓሶፓ ዓይጎ ዓሲናኣ ዎላቱዋሴ፤ <verse eid="2CH 25:7"/><verse number="8" style="v" sid="2CH 25:8"/>ኔኤኒ ሃያ ዖላ ዖሎና ዒስራዔኤሌ ፖኦሊሳ ታና ማኣዳንዳኔ ጌዒ ኔ ማላኣ ናንዳኔ፤ ጋዓንቴ ባሻያና ባሺንቴያ ኔና ማሃሢ ፆኦሲ ሌሊኬ፤ ዬያሮ ሃሢ ዒዚ ኔ ሞርካ ኔና ባሻንዳጉዲ ማሃንዳኔ» ጌዔኔ።<verse eid="2CH 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 25:9"/>ዓሜሲያሴ ፆኦሲ ማሊፆ ኬኤዛሢ ኮይላ፦ «ቤርታዺ ታ ጪጌ ሚኢሻሾ? ዬያ ቢያ ታ ዎዎዳንዳይ?» ጌይ ዖኦጬኔ።</para>
  <para style="p" vid="2CH 25:9">ፆኦሲ ማሊፆ ኬኤዛሢ፦ «ናንጊና ናንጋ ጎዳ ዬያ ሚኢሻፓ ባሼ ኔኤም ዒንጋኒ ዳንዳዓኔ» ጌዔኔ። <verse eid="2CH 25:9"/><verse number="10" style="v" sid="2CH 25:10"/>ዬያሮ ዓሜሲያሴ ሻንቂ ዔኮና ፖኦሊሶ ፔኤኮ ናንጋ ቤዞ ቤዞ ዓኣዻንዳጉዲ ዳኬም፥ ዔያታ ዪሁዳ ዴሮይዳ ሚርጌና ዻጋዺ ጎሪንቲ ፔኤኮ ናንጎ ቤዞ ዓኣዼኔ።<verse eid="2CH 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 25:11"/>ዬካፓ ዓሜሲያሴ ጫርቂ ዔቂ ፔኤኮ ፖኦሊሶ ዔኪ ሶኦጌ ዶኦቺ ዴንዴኔ፤ ዒኢካ ዒዛኮ ፖኦሊሳ ዔዶኦሜ ዖሎ ዓሶ ዖሊ ታጶ ሺያ ፖኦሊሴ ዎዼኔ፤ <verse eid="2CH 25:11"/><verse number="12" style="v" sid="2CH 25:12"/>ዒማና ሜሌ ታጶ ሺያ ፖኦሊሴያኣ ዲዒ ዔኬኔ፤ ዬያቶ ቱኪ ዔኪ ሴላዔ ጌይንታ ካታሞ ኮይላ ዓኣ ማጎ ቶኦኮ ዔኪ ኬሳዖ ሂዒ ዳኬኔ፤ ቢያሢ ማጎኮ ዴማ ዓኣ ላላ ኬዲ ጳዺንቲ ሃይቂ ጋፔኔ።<verse eid="2CH 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 25:13"/>ዓሜሲያሴ ዒዛና ዎላ ዖሎ ዓኣዻንዳጉዲ ኮዒባኣ ዒስራዔኤሌ ፖኦሊሳ ሳማሪያና ቤትሆሮኔ ባኣካ ዓኣ ዪሁዳ ካታሞ ዖላዖ ሃይሦ ሺያ ዓሲ ዎዺ፥ ዑሣ ዓኣዼ ሚርጌ ባኣዚ ዲዒ ዔኬኔ።<verse eid="2CH 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 25:14"/>ዓሜሲያሴ ዔዶኦሜ ዓሶ ዖሎና ባሺ ማዓዖ ዔያቶኮ ካኣሽኮ ሜሌ ፆኦዞ ዔኪ ሙኬኔ፤ ዬያ ካኣሽኮ ፆኦዞ ማሂ ዔቂሲ ዚጊ ዬያቶ ካኣሽኬኔ፤ ዑንጄያ ጩቢሼኔ፤ <verse eid="2CH 25:14"/><verse number="15" style="v" sid="2CH 25:15"/>ዬይ ባካ ናንጊና ናንጋ ጎዳ ዻጋሴም ጎዳ ፔ ማሊፆ ኬኤዛ ዓሲ ዓሜሲያሴ ኮይላ ዳኬኔ፤ ዬይ ዓሢ ዓሜሲያሴ ኮራ፥ «ፔ ዓሶ ኔ ኩጫፓ ዓውሳኒ ዳንዳዒባኣ ሜሌ ፆኦዞ ዓይጋ ኔ ዚጊ ካኣሽካይ?» ጌይ ዖኦጬኔ።<verse eid="2CH 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 25:16"/>ዬይ ጌኤዞ ጋፒሱዋንቴ ዓሜሲያሴ፦ «ሃሢ ካኣቲኮ ዞራ ዶንዛ ማሂ ዓይዲ ኔና ኑ ዶኦሬዖ? ዬያ ጌኤዞ ሴካ ሃሼ፤ ሃንጎ ታ ኔና ዎዻንዳኔ!» ጌዔኔ።</para>
  <para style="p" vid="2CH 25:16">ዬይ ፆኦሲ ማሊፆ ኬኤዛሢ ጌስታ ጌኤዞ ዻካሮ ሃሼስካፓ፦ «ሃያ ቢያ ኔ ማዼሢ፤ ሃሣ ታ ዞሮዋ ዋይዞ ኔ ዒፄሢ ፆኦሲ ኔና ባይዛኒ ማሌሢሮታሢ ዓኣሪ ታ ዔሬኔ» ጌዔኔ።<verse eid="2CH 25:16"/></para>
  <para style="s1">ዒስራዔኤሌ ዓሶ ዖሎና ዖልዚ</para>
  <para style="r">(<ref loc="2KI 14:8-20">2ካኣቶ. ማ 14፡8-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 25:17"/>ዬካፓ ካኣቲ ዓሜሲያሴና ዒዛኮ ዶንዛ ዒስራዔኤሌ ዓሶም ጌኔ ማዾ ማዻኒ ዞርቴኔ፤ ዓሜሲያሴ ዒማና ዒዩኮ ናኣዚ ናዖ፥ ዒዮዓካኣዜ ናኣዚ ማዔ ዒስራዔኤሌ ካኣቲ ዮዓሴም፦ «ሂንዳ ሃኒ ሙኬ ኑ ዎሊ ዛጎም!» ጌዒ ኪኢታ ዳኪ ዖልዚም ዔቂሴኔ፤ <verse eid="2CH 25:17"/><verse number="18" style="v" sid="2CH 25:18"/>ካኣቲ፥ ዮዓሴ ጋዓንቴ፦ «ሊባኖኦሴ ዹኮይዳ ዓኣ ፔቴ ጋውዲ ዓንጊሢስኬና ሊባኖኦሴ ዚቢቆ ኮይላ፥ ‹ታ ናዓሢም ኔኤኮ ዉዱሮ ናዔሎ ዒንጌ› ጌይ ኪኢታ ዳኬኔ፤ ጋዓንቴ ሊባኖኦሴ ዹኮይዳ ዓኣ ፔቴ ቦዖ ዒኢና ዴንዲቤቃ ቶኪና ሄርቃዛ ዬና ጋውዴላ ሃይቄኔ» ጋዓኔ። <verse eid="2CH 25:18"/><verse number="19" style="v" sid="2CH 25:19"/>«ዔኤዛይ ዓሜሲያሴ! ኔኤኒ ዔዶኦሜ ዓሶ ዖሎና ባሼሢሮ ዖቶርቂ ሺራ? ኔ ባሼ ባሺፆማና ኔ ማኣራ ኔ ዴዒ ዚቲ ጌዔቴ ቃራኬ፤ ኔናንታ ኔ ዴሮንታ ባይዛንዳ ባኣዚ ዓይጋ ኔ ዓጊሢ ሺራይ?» ጌዔኔ።<verse eid="2CH 25:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 25:20"/>ዓሜሲያሴ ጋዓንቴ ዮዓሴ ዬያ ጌዔሢ ዔኤቢኬ ጌይባኣሴ፤ ዬይ ያዺ ማዔሢ ዓሜሲያሴ ዔዶኦሜ ዓሶ ፆኦዛሢ ካኣሽኬሢሮ ዒ ዖሎና ባሺንታንዳጉዲ ፆኦሲ ጌዔሢሮኬ፤ <verse eid="2CH 25:20"/><verse number="21" style="v" sid="2CH 25:21"/>ዬያሮ ካኣቲ ዮዓሴ ፔኤኮ ፖኦሊሶ ዔኪ ዓሜሲያሴ ዖላኒ ዴንዳዖ ዪሁዳይዳ ዓኣ ቤትሼሜሼ ጌይንታ ቤዛ ዖሎ ዓርቄኔ፤ <verse eid="2CH 25:21"/><verse number="22" style="v" sid="2CH 25:22"/>ዒማና ዪሁዳ ዓሳ ባሺንቴኔ፤ ፖኦሊሳኣ ቢያ ጳሽኪ ፔ ማኣሪ ማኣሪ ዴንዴኔ። <verse eid="2CH 25:22"/><verse number="23" style="v" sid="2CH 25:23"/>ዮዓሴ ዒማና ዓካዚያሴኮ ናኣዚ ናዖ፥ ዓሜሲያሴ ሼምፔና ዓኣንቴ ዓርቂ ዔኪ ዬሩሳላሜ ሄላኒ ዴንዴኔ፤ ዒኢካ ሄሄላዖ ዔፕሬኤሜ ኬኤሎ ዲፆ ካራፓ ዓርቃዖ ዴንዲ «ዎላ ካኣማ ኬኤሎ ዲፆ ካሮ» ጌይንታ ቤዞ ሄላንዳኣና ዖዶሱማ ዖይዶ ፄኤታ ዋዻ ማዓ ኬኤሎ ዲፆ ዶይሴኔ። <verse eid="2CH 25:23"/><verse number="24" style="v" sid="2CH 25:24"/>ዒኢካፓ ዒ ዴንቄ ዎርቆንታ ቢሮንታ ቢያ፥ ዖቤድዔዶኦሜ ዓሳ ካፓ ጌኤዦ ማኣሮይዳ ካኣዦ ካኣሽኮ ባኮ ቢያሢንታ ካኣቱሞ ማኣሮይዳ ዓኣ ባኮ ቢያ ጫኣኒ ሳማሪያ ማዒ ዴንዴኔ፤ ዓይሢ ማሂ ዒዚ ዲዔ ዓሶዋ ዔኪ ዓኣዼኔ።<verse eid="2CH 25:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 25:25"/>ዒስራዔኤሌ ካኣቲ፥ ዒዮዓካኣዜ ናኣዚ፥ ዮዓሴ ሃይቄስካፓ ዪሁዳ ካኣቲ ዮዓሴ ናኣዚ ዓሜሲያሴ ታጶ ዶንጎ ሌዔ ዴዔኔ፤ <verse eid="2CH 25:25"/><verse number="26" style="v" sid="2CH 25:26"/>ዓሜሲያሴ ማዼ ሜሌ ባካ ቢያ ዪሁዳ ካኣቶንታ ዒስራዔኤሌ ካኣቶ ሃይሳ ፃኣፒንታ ማፃኣፓ ፃኣፒንቲ ዓኣኔ። <verse eid="2CH 25:26"/><verse number="27" style="v" sid="2CH 25:27"/>ዓሜሲያሴ ናንጊና ናንጋ ጎዳም ዓይሢንቲፆ ዒፄ ዎዳፓ ዓርቃዖ ዒዛ ዎዻኒ ዬሩሳላሜይዳ ዓሲ ዎላ ዞርቴሢሮ ዒዚ ፑኒ ላኪሼ ካታሞ ዴንዴኔ፤ ዒዛኮ ሞርካ ጋዓንቴ ጊንፆ ዓሲ ዳኪ ዒኢካ ዒዛ ዎዺሼኔ፤ <verse eid="2CH 25:27"/><verse number="28" style="v" sid="2CH 25:28"/>ዬካፓ ሌዛ ዒዛኮ ፓሮና ጫኣኒንቲ ዬሩሳላሜ ሙኬኔ፤ ጋፒንፆይዳ ዳውቴ ካታማ ካኣታ ዱኡታ ቤዛ ዒ ዱኡቴኔ።<verse eid="2CH 25:28"/></para>
  <chapter eid="2CH 25"/>
  <chapter number="26" style="c" sid="2CH 26"/>
  <para style="s1">ዪሁዳ ካኣቲ ዖዚያ</para>
  <para style="r">(<ref loc="2KI 14:21-22">2ካኣቶ. ማ 14፡21-22</ref>፤ <ref loc="2KI 15:1-7">15፡1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 26:1"/>ዪሁዳ ዴራ ቢያሢ ታጶ ላሆ ሌዔ ማዔ፥ ዓሜሲያሴ ናኣዚ፥ ዖዚያ ዓዶ ቤዛ ካኣታዻንዳጉዲ ዶኦሜኔ። <verse eid="2CH 26:1"/><verse number="2" style="v" sid="2CH 26:2"/>[ዖዚያ ዔላቴ ካታሞ ዖሊ ጊንሣ ማሂ ዓርቂ ዓካሲ ማዤሢ ዓዴ ዓሜሲያሴ ሃይቄስካፓኬ።]<verse eid="2CH 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 26:3"/>ዖዚያ ታጶ ላሆ ሌዔ ማዓኣና ካኣታዼኔ፤ ዒዚ ዬሩሳላሜይዳ ናንጊ ዶንጊታሚ ላምዖ ሌዔ ዎይሤኔ፤ ዒንዳ ዒዛኮ ዪኮሊያ ጌይንታያ ዬሩሳላሜይዳ ሾይንቴያኬ። <verse eid="2CH 26:3"/><verse number="4" style="v" sid="2CH 26:4"/>ዖዚያ ዒዛኮ ዓዴ ማዼ ጎይፆ ኮሺ ማዾ ማዺ ናንጊና ናንጋ ጎዳ ዎዛሴኔ፤ <verse eid="2CH 26:4"/><verse number="5" style="v" sid="2CH 26:5"/>ፆኦሲ ባኣዚ ዛላ ዒዛ ዞራ፥ ዛካሪያሴ ሼምፔና ዓኣ ዎዶማና ዖዚያ ፆኦሲም ጉሙርቂንቲ ማዼኔ፤ ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢ ዒዛ ዓንጄኔ።<verse eid="2CH 26:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 26:6"/>ዒማና ዖዚያ ፒሊስፄኤሜ ዓሶ ዖሊ ጋኣቴ፥ ያብኔንታ ዓሽዶዴ ካታሞንታኮ ኬኤሎ ዲፆ ሻሄኔ፤ ዓሽዶዴ ኮይሎይዳ፥ ሃሣ ጊንሣ ፒሊስፄኤሜ ዓጮይዳ ዙላ ኬልቂንቲ ዲርቂንቴ ካታማኣ ማዤኔ። <verse eid="2CH 26:6"/><verse number="7" style="v" sid="2CH 26:7"/>ዒዚ ፒሊስፄኤሜ ዓሶንታ ጉርባዔሌይዳ ናንጋ ዓሬቦ ዓሶንታ ሜዑና ዓሶንታ ዖሊ ባሻንዳጉዲ ፆኦሲ ማኣዴኔ። <verse eid="2CH 26:7"/><verse number="8" style="v" sid="2CH 26:8"/>ዓሞኦኔ ዓሳኣ ዒዛም ጊኢሬኔ፤ ዒዚ ዑሣ ዓኣዼ ዎልቃዺ ዎልቃዺ ዴንዴሢሮ ዒዛኮ ሱንፃ ጊብፄ ዓጮ ሄላንዳኣና ዋይዚንቴኔ።<verse eid="2CH 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 26:9"/>ዖዚያ ኬኤሎ ዲፃ ዎላ ካኣማ ካሮንታ ዶኦጮ ኬኤሎ ዲሮ ካሮንታ ኬኤሎ ዲፃ ቃሳዺ ሺራሢዳ ዒኢካ ዔቂ ካፖንዶ ሹቺ ማኣሪ ማዢ ዬሩሳላሜኮ ዋርዲዮ ማዓ ኬኤሎ ዲፆ ዶዲሼኔ፤ <verse eid="2CH 26:9"/><verse number="10" style="v" sid="2CH 26:10"/>ዓባ ጌላ ዛሎይዳ ጌሜሮ ዴማ ዓኣ ቦኦሎይዳ ሚርጌ ባይ ዒዛኮ ዓኣሢሮ ካታሞኮ ዙላ ቦኦሎይዳ ዔቂ ካፖ ዼጌ ቤሲ ሹቺና ማዤኔ፤ ሚርጌ ቦቆሊያኣ ቦኦኬኔ፤ ዒዚ ጎሺ ጎሽኪሢ ናሽካሢሮ ጌሜራዻ ዓጮንታ ማሊ ማዔ ዓጮንታይዳ ዎይኔ ቱካ ዓሲና ጎሺ ጎሽካ ዓሲያኣ ዒዛኮ ዓኣኔ።<verse eid="2CH 26:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 26:11"/>ዖዚያኮ ዖልዚም ጊኢጊንቴያ ዺቢ ዖልዚ ዓሲ ዓኣኔ፤ ዬያ ዓሶኮ ሱንፆ ካኣቱሞ ማኣራ ፃኣፖ ባኮ ፃኣፓ ዪዒዔኤሌና ማዕሴያና ፃኣፓኔ፤ ዔያቶኮ ሱኡጋሢ ካኣቱሞ ማኣሮይዳ ማዻ ዓሶ ባኣካ ዓኣ ሃናኒያኬ። <verse eid="2CH 26:11"/><verse number="12" style="v" sid="2CH 26:12"/>ዒዛኮ ዖሎ ዓሶ ሱኡጋ ላምዖ ሺያና ላሆ ፄኤታ ማዓ ዱማ ዱማ ቶኦኮኮ ሱኡጌ ማዔያኬ፤ <verse eid="2CH 26:12"/><verse number="13" style="v" sid="2CH 26:13"/>ዬያቶኮ ዴማ ካኣቲኮ ሞርኮ ዖሊ ቃዛኒ ጊዳ ዔራቶ ዓኣ ሃይሦ ፄኤታና ላንካይ ሺያና ዶንጎ ፄኤታ ዔርቴ ፖኦሊሴ ዓኣኔ፤ <verse eid="2CH 26:13"/><verse number="14" style="v" sid="2CH 26:14"/>ዖዚያ ዒዛኮ ዖሎ ዓሶም ቢያ ጊቲማንታ ዎርሢንታ ዖሎሮ ቶኦኮና ዳዶናይዳ ዓጎ ባኮንታ ሂኢሺንታ ቆኦሲንታ ዎራንታ ዎራ ሹቺያ ጊኢጊሺ ዒንጌኔ፤ <verse eid="2CH 26:14"/><verse number="15" style="v" sid="2CH 26:15"/>ካኣቲ ዖዚያ ዬሩሳላሜይዳ ሃኣሚ ማዔ ዓሶ፦ ጊዒ ዴዒ ካፓኒ ሹጮና ዼጊዲ ማዦ ቤዞንታ ካታሞኮ ኬኤሎ ዲፃ ዎላ ካኣማ ካሮይዳ ሂኢሺንታ ዼኤፒ ዼኤፒ ሹቺ ዎራኒና ዱካኒያ ዳንዳዓ ዓንጋሞ ኮሺሴኔ፤ ናንጊና ናንጋ ጎዳ ዒዛ ማኣዴሢሮ ኮሺ ዒኢኒ ዶዴኔ፤ ዑሣ ዓኣዼ ዎልቃዻያ ማዔኔ፤ ሱንፃኣ ዒዛኮ ቢያ ቤዛ ዋይዚንቴኔ።<verse eid="2CH 26:15"/></para>
  <para style="s1">ዖዚያ ሄርሺንቶና ፔ ጊዳ ዔኪ ሙኬ ሜታሢ</para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 26:16"/>ካኣቲ ዖዚያ ካኣቱሞ ዶዲሻዖ ዖቶርቄኔ፤ ዬይ ዖቶርሙማ ዒዛ ዔኪ ሎንሤኔ፤ ዒዚ ናንጊና ናንጋ ጎዳም ዑንጆ ጩቢሾ ቤዛ ጩቢሻኒ ጌኤዦ ማኣሪ ጫርቂ ጌሊ ፆኦሲ ዖዪሴኔ፤ <verse eid="2CH 26:16"/><verse number="17" style="v" sid="2CH 26:17"/>ዒማና ቄኤሳሢ፥ ዓዛሪያሴንታ ዒዛና ዎላ ዒናፓ ዶዲ ማዻ ሳሊታሚ ቄኤሴ ዬያ ማዾሮ ዒዛ ጎራኒ ካኣቲ ጊንፆ ጌኤዦ ማኣሪ ጌሌኔ። <verse eid="2CH 26:17"/><verse number="18" style="v" sid="2CH 26:18"/>ዔያታ ዒዛ ኮራ፦ «ዖዚያ! ኔኤኒ ናንጊና ናንጋ ጎዳም ዑንጆ ጩቢሻኒ ኮይሱዋሴ፤ ዬያ ማዻኒ ጌሢንቴሢ ናንጊና ናንጋ ጎዳም ዱማዼ ዓኣሮኔ ዜርፆ ማዔ ቄኤሶ ሌሊኬ፤ ዬያሮ ሃያ ናንጊና ናንጋ ጎዳም ዱማዼ ቤዛፓ ኬስኬ፤ ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢ ኔኤኒ ዖዪሴኔ፤ ሃይ ኔኤኮ ማዻ ፆኦሲዳፓ ቦንቾ ኔኤም ጴዺሳያቱዋሴ» ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">26፡18 </char><char style="xt" closed="false"><ref loc="EXO 30:7-8">ኬሲ. ማፃ 30፡7-8</ref>፤ <ref loc="NUM 3:10">ፓይ. ማፃ 3፡10</ref>።</char></note><verse eid="2CH 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 26:19"/>ዖዚያ ዑንጆ ጩቢሻኒ ጩቢሾ ባኮ ዓርቂ ጌኤዦ ማኣሮ ጋሮይዳ ጩቢሾ ባኮ ጩቢሾ ቤዞ ኮይላ ዔቂ ዓኣዖ ቄኤሶይዳ ዻጋዺ ጎሪንቴኔ፤ ዒማና ኔጉዋዖ ዒዛኮ ባሊቶይዳ ዑፃ ኬስካ ዶርዓሢ ኬስኪ ጴዼኔ፤ <verse eid="2CH 26:19"/><verse number="20" style="v" sid="2CH 26:20"/>ዬያሮ ዓዛሪያሴንታ ሜሌ ቄኤሶንታ ኮሺ ዲቃታዖ ካኣቲኮ ባሊቶ ጊዥ ጌይ ዛጌኔ፤ ጌኤዦ ማኣራፓኣ ዒዛ ዑካሲ ኬሴኔ፤ ዒዚያ ናንጊና ናንጋ ጎዳ ዒዛይዳ ሜቶ ዓጌሢ ዔሪ ኬስካኒ ሩኡሬኔ።<verse eid="2CH 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 26:21"/>ካኣቲ ዖዚያ ሃይቃንዳያ ሄላንዳኣና ዬይ ዑፃ ኬስካ ዶርዓሢ ዒዛ ሃሺባኣሴ፤ ዬያሮ ዒዚ ዱማ ኬኤሢዳ ናንጌኔ፤ ዬካፓ ማይ ጌኤዦ ማኣሪ ጌላኒ ዒ ዳንዳዒባኣሴ፤ ዒዛኮ ናኣዚ ዒዮዓታሜ ካኣቱሞ ማኣሮይዳ ሱኡጌ ማዒ ዓጮ ዎይሤኔ።<verse eid="2CH 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 26:22"/>ካኣቲ ዖዚያ ካኣታዼ ዎዶና ማዼ ሜሌ ባካ ቢያ ዓሞፄ ናኣዚ፥ ፆኦሲ ማሊፆ ኬኤዛሢ፥ ዒሲያሴ ፃኣፔ ሃይሶይዳ ዓኣኔ። <verse eid="2CH 26:22"/><verse number="23" style="v" sid="2CH 26:23"/>ዬካፓ ዖዚያ ሃይቂ፥ ካኣታ ዱኡታ ቤዞ ኮይላ ዓኣ ቤስካ ዱኡቴኔ፤ ዒዚ ካኣታ ዱኡታ ቤዛ ዱኡቲባኣሢ ዑፃ ኬስካ ዶርዓሢ ዒዛ ዓርቄሢሮኬ፤ ዒዛ ቤዞይዳ ዒዛኮ ናኣዚ ዒዮዓታሜ ካኣታዼኔ። <note caller="-" style="x"><char style="xo" closed="false">26፡23 </char><char style="xt" closed="false"><ref loc="ISA 6:1">ዒሲ. 6፡1</ref>።</char></note><verse eid="2CH 26:23"/></para>
  <chapter eid="2CH 26"/>
  <chapter number="27" style="c" sid="2CH 27"/>
  <para style="s1">ዪሁዳ ካኣቲ ዒዮዓታሜ</para>
  <para style="r">(<ref loc="2KI 15:32-38">2ካኣቶ. ማ 15፡32-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 27:1"/>ዒዮዓታሜኮ ሌዓ ላማታሚ ዶንጎ ማዓኣና ካኣታዼኔ፤ ዒዚ ዬሩሳላሜይዳ ናንጊ ታጶ ላሆ ሌዔ ዎይሤኔ፤ ዒንዳ ዒዛኮ ዪሩሻ ጌይንታያ ሳዶቄ ናዎኬ። <verse eid="2CH 27:1"/><verse number="2" style="v" sid="2CH 27:2"/>ዒዮዓታሜ ዓዴ ማዼ ጎይፆ ናንጊና ናንጋ ጎዳ ዎዛሳ ባኣዚ ማዼኔ፤ ዓዴ ጌኤዦ ማኣሮይዳ ዑንጆ ጩቢሺ ማዼ ጎሞ ማዺባኣሴ፤ ዴራ ጋዓንቴ ጎሞ ማዺፆ ሃሾ ዒፄኔ።<verse eid="2CH 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 27:3"/>ዒዮዓታሜ ጌኤዦ ማኣሮኮ ኬዶ ዛሎ ካሮ ላሚ ዓካሲ ኮሼኔ፤ ሃሣ ጊንሣ ዖፔሌ ጌይንታ ጌሜራዻ ቤዞ ዙሎ ኬልቂ ዲርቂ ሚርጌ ማዾ ማዼኔ፤ <verse eid="2CH 27:3"/><verse number="4" style="v" sid="2CH 27:4"/>ዬያጉዲ ሃሣ ዪሁዳ ዓጫ ጌሜራ ዓኣ ካታሞ፥ ዴኤሎ ካያ ሚርጌ ዓኣ ቤዞኮዋ ዋርዲያንታ ኬኤሌ ዲሢያ ኮሼኔ። <verse eid="2CH 27:4"/><verse number="5" style="v" sid="2CH 27:5"/>ዒዚ ዒማና ዓሞኦኔ ካኣቲንታ ዖሎ ዓሶዋ ዖሊ ባሼኔ፤ ዬያሮ ዓሞኦኔ ዓሳ ሃይሦ ሌዔ ጉቤ ሌዓ ሌዓ ሃይሦ ሺያና ዖይዶ ፄኤታ ኪሎ ማዓ ሹቺ ቢራ፤ ፔቴ ሚሎኔ ኪሎ ማዓ ዛርጌና ፔቴ ሚሎኔ ኪሎ ማዓ ዔልዓኣ ጊኢሬኔ። <verse eid="2CH 27:5"/><verse number="6" style="v" sid="2CH 27:6"/>ዒዮዓታሜ ናንጊና ናንጋ ጎዳ ማዔ ፔኤኮ ፆኦዛሢም ጉሙርቂንታያ ማዔሢሮ ዎልቄ ዴንቂ ዶዲ ዶዲ ዓኣዼኔ። <verse eid="2CH 27:6"/><verse number="7" style="v" sid="2CH 27:7"/>ዒዮዓታሜ ካኣታዼ ዎዶና ማዺንቴ ሜሌ ባካ ቢያ፥ ዒ ዖሌ ዖሎንታ ዒ ዎይሤ ዎይሢፃ ቢያ ዒስራዔኤሌንታ ዪሁዳንታ ካኣቶ ሃይሳ ፃኣፒንታ ማፃኣፓ ፃኣፒንቴኔ፤ <verse eid="2CH 27:7"/><verse number="8" style="v" sid="2CH 27:8"/>ዒዮዓታሜ ካኣታዻኣና ሌዓ ዒዛኮ ላማታሚ ዶንጎኬ፤ ዒዚ ዬሩሳላሜይዳ ናንጊ ታጶ ላሆ ሌዔ ዎይሤኔ፤ <verse eid="2CH 27:8"/><verse number="9" style="v" sid="2CH 27:9"/>ዬካፓ ዒዚ ሃይቂ፥ ዳውቴ ካታማ ዱኡቴኔ፤ ዒዛ ቤዛ ዒዛኮ ናኣዚ ዓካኣዜ ካኣታዼኔ።<verse eid="2CH 27:9"/></para>
  <chapter eid="2CH 27"/>
  <chapter number="28" style="c" sid="2CH 28"/>
  <para style="s1">ዪሁዳ ካኣቲ ዓካኣዜ</para>
  <para style="r">(<ref loc="2KI 16:1-4">2ካኣቶ. ማ 16፡1-4</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 28:1"/>ዓካኣዜ ሌዓ ዒዛኮ ላማታሚ ማዓኣና ካኣታዼኔ፤ ዒዚ ዬሩሳላሜይዳ ናንጊ ታጶ ላሆ ሌዔ ዎይሤኔ፤ ዒዛኮ ማዔ፥ ዳውቴ ማዼ ኮዦ ማዾ ማዺፆ ሃሺ ናንጊና ናንጋ ጎዳ ዖዪሳ ባኣዚ ማዼኔ፤ <verse eid="2CH 28:1"/><verse number="2" style="v" sid="2CH 28:2"/>ዒዚ ዒስራዔኤሌ ካኣታ ማዻ ፑርቶ ማዾ ማዼኔ፤ ባዓኣሌ ጌይንታ ፆኦዞ ማላ ባኣዚ ዓንጊ ሼኤሺ ኮሼኔ፤ <verse eid="2CH 28:2"/><verse number="3" style="v" sid="2CH 28:3"/>ሄኖሜ ዶኦጮይዳ ዑንጄ ጩቢሼኔ፤ ቤርታ ዒስራዔኤሌ ዓሳ ዓጮ ሃጊ ጌላኣና ናንጊና ናንጋ ጎዳ ዒኢካፓ ዳውሲ ኬሴ ዴራ ማዻ ሻኣካ ማዾ ማዺ ፔኤኮ ዓቲንቆ ናኣቶዋ ሚቺ ዒንጎ ዒንጊሢ ማሂ ሜሌ ፆኦዞም ሺኢሼኔ። <verse eid="2CH 28:3"/><verse number="4" style="v" sid="2CH 28:4"/>ጌሜሮ ዑፆይዳ ዓኣ፥ ሜሌ ዓሳ ፔ ፆኦዞ ካኣሽካ ቤዞይዳ፤ ጊንሣ ሃሣ ሚሢኮ ሺቢዳ ሺቢዳ ዒንጎ ዒንጊሢ ዬያ ፆኦዞም ዒንጌኔ፤ ዑንጄያ ጩቢሼኔ።<verse eid="2CH 28:4"/></para>
  <para style="s1">ሶኦሪያና ዒስራዔኤሌ ዓሶና ዓካኣዜ ዖሌሢ</para>
  <para style="r">(<ref loc="2KI 16:5">2ካኣቶ. ማ 16፡5</ref>)</para>
  <para style="p">
    <verse number="5-6" style="v" sid="2CH 28:5-6"/>ካኣቲ ዓካኣዜ ጎሜ ማዼሢሮ ሶኦሪያ ካኣቲ ዖሎና ዒዛ ባሻንዳጉዲ፤ ሃሣ ሚርጌ ዓይሁዴ ዓሲያኣ ቱኪ ዔኪ ዴማስቆ ዴንዳንዳጉዲ ናንጊና ናንጋ ጎዳ ዓይሤኔ፤ ዬያጉዲ ጊንሣ ሬማሊያ ናኣዚ፥ ዒስራዔኤሌ ካኣቲ ፓቁሄ ዓካኣዜ ዖሊ ባሻንዳጉዲና ዖሎና ኮሺ ዔርቴያ ማዔ ዪሁዳ ፖኦሊሳፓ ፔቴ ኬሊ ፄኤታና ላማታሚ ሺያ ዎዻንዳጉዲ ናንጊና ናንጋ ጎዳ ዓይሤኔ፤ ዔያቶኮ ቤርታኣ ዓዶንሢ ፆኦዛሢ ማዔ ናንጊና ናንጋ ጎዳ ዬያ ማዺሼሢ ዪሁዳ ዓሳ ዒዛ ሃሼሢሮኬ። <note caller="-" style="x"><char style="xo" closed="false">28፡5-6 </char><char style="xt" closed="false"><ref loc="ISA 7:1">ዒሲ. 7፡1</ref>።</char></note> <verse eid="2CH 28:5-6"/><verse number="7" style="v" sid="2CH 28:7"/>ዒማና ዚክሪ ጌይንታ ፔቴ ዒስራዔኤሌ ፖኦሊሴስኬይ ካኣቲ ዓካኣዜኮ ናኣዚ፥ ማዕሴያንታ ካኣቱሞ ማኣሮ ዓሶ ሱኡጌ ማዒ ዎይሣ ዓዝራቃሜንታ ካኣቲኮ ዴማ ሄሊሲ ቢታንቶ ዓኣ ሂልቃናኣ ዎዼኔ፤ <verse eid="2CH 28:7"/><verse number="8" style="v" sid="2CH 28:8"/>ዬያ ሌሊቱዋንቴ ዓይሁዶ ዓሳ ዔያቶኮ ዒጊኒ ማዔቴያ ዒስራዔኤሌ ፖኦሊሳ ላምዖ ፄኤታ ሺያ ናይንታ ላኣሊንታ ቱኪ ዔኪ ሚርጌ ባኣዚያ ዎላ ዲዒ ሳማሪያ ዴንዴኔ።<verse eid="2CH 28:8"/></para>
  <para style="s1">ፆኦሲ ማሊፆ ኬኤዛ ዖዴዴ</para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 28:9"/>ፆኦሲ ማሊፆ ኬኤዛ፥ ዖዴዴ ጌይንታ ዓሲስኬይ ሳማሪያ ካታማ ናንጋኔ፤ ዒስራዔኤሌኮ ዖሎ ዓሳ ዓይሁዶ ዓሶ ቱኪ ዔኪ ሳማሪያ ካታሞ ጌሊፆይዳ ዓኣንቴ ዒዚ ዔያቶ ባንሢ ኬስካዖ፦ «ዒንሢኮ ቤርታኣ ዓዶንሢ ፆኦዛሢ ማዔ ናንጊና ናንጋ ጎዳ ዪሁዳ ዴሮይዳ ዻጋዼሢሮ ዒንሢ ዔያቶ ዖሎና ባሻንዳጉዲ ማሄኔ፤ ዒንሢ ጋዓንቴ ዓይሁዶ ዓሶ ሚጪንቱዋዖ ዎዺ ኩርሴኔ፤ <verse eid="2CH 28:9"/><verse number="10" style="v" sid="2CH 28:10"/>ዬይ ዒንሢም ጊዶ ዒፃዛ ዬሩሳላሜንታ ዪሁዳ ዓጮንታኮ ዓቲንቆና ላኣሎና ቢያ ዒንሢ ዓይሌ ማሂ ዔካኒ ማሌኔ፤ ዒንሢ ዬያይዲፆና ዔያቶጉዲ ጎሜ ማዺ ዒንሢኮ ፆኦዛሢ ማዔ ናንጊና ናንጋ ጎዳ ዖዪሲባኣዓዳ? <verse eid="2CH 28:10"/><verse number="11" style="v" sid="2CH 28:11"/>ሃሢ ዋይዙዋቴ! ናንጊና ናንጋ ጎዳኮ ዻጋ ዒንሢዳ ዔኤቴሢሮ ሃኣቶ ዒንሢ ቱኪ ዔኪ ዬዔ፥ ዒንሢኮ ዒሾንሢንታ ጌሮንሢንታ ዔያታ ናንጋ ቤዞ ዓኣዻንዳጉዲ ሃሹዋቴ» ጌዔኔ።<verse eid="2CH 28:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 28:12"/>ዬያጉዲ ሃሣ ዬሆሃናኔ ናኣዚ ዓዛሪያሴ፥ ሜሺሌሞቴ ናኣዚ ቤሬኪያ፥ ሻሉሜ ናኣዚ ዪሂዚቂያንታ ሃድላዬ ናኣዚ ዓማሳ ጌይንታ ዔርቴ ዖይዶ ዔፕሬኤሜ ዓጮ ዎይሣ ሱኡጌስኬንሢ ዬይ ዖሎ ዓሳ ማዼ ማዾ ዒፂ ማኬኔ፤ <verse eid="2CH 28:12"/><verse number="13" style="v" sid="2CH 28:13"/>ዔያታ ዒማና፦ «ሃኣቶ ቱኡዞ ዓሶ ሃይካ ዔኪ ዬይፖቴ! ሃያኮ ቤርታ ጎሜ ማዺ ናንጊና ናንጋ ጎዳ ኑ ዖዪሴሢሮ ዒዛኮ ጎሪንታ ኑና ሄሌኔ፤ ሃሣ ዻቢንቲዳ ዻቢንቲ ኑ ማዻንዳጉዲ ዒንሢ ኮዓ?» ጌዔኔ። <verse eid="2CH 28:13"/><verse number="14" style="v" sid="2CH 28:14"/>ዬያሮ ዖሎ ዓሳ ቱኡዞ ዓሶንታ ዲዒ ዔኪ ሙኮና ባኮዋ ዴሮና ዔያቶኮ ሱኡጎናም ዒንጌኔ። <verse eid="2CH 28:14"/><verse number="15" style="v" sid="2CH 28:15"/>ዬካፓ ዬንሢ ዖይዶ ዓሶንሢ ቱኡዞ ዓሶም ዲዒ ዔኪ ሙኮና ባካፓ ኮይሳ ባኣዚ ቢያ ዒንጋንዳጉዲ ዓይሢንቴኔ፤ ዬያሮ ዬንሢ ዓሳ ካሎ ማዔ ቱኡዞ ዓሶም ማኣዖንታ ዱርሲንታ፤ ዬያጉዲ ሃሣ ጊዳ ሙኡዚንታ ዋኣሢያ ዒንጌኔ፤ ዔያቶኮ ኪፆይዳኣ ሪሚቶ ዛይቶ ዋሂ ዔያቶ ማኣዴኔ፤ ቶኪና ሃንታኒ ዳንዳዒባኣ ላቤ ዓሶ ሃሬ ቶጊሴኔ፤ ዬካፓ ቱኡዞ ዓሶ ቢያ ዪሁዳይዳ ሜኤፄ ዺቢ ዓኣ፥ ዒያርኮ ካታሞ ጊንሣ ዔኪ ዓኣዻዛ ዬንሢ ዓሳ ፔ ናንጋ ካታሞ ሳማሪያ ማዒ ሙኬኔ።<verse eid="2CH 28:15"/></para>
  <para style="s1">ዓካኣዜ ዓሶኦሬ ካኣቲ ዒዛ ማኣዳንዳጉዲ ሺኢቄሢ</para>
  <para style="r">(<ref loc="2KI 16:7-9">2ካኣቶ. ማ 16፡7-9</ref>)</para>
  <para style="p">
    <verse number="16-17" style="v" sid="2CH 28:16-17"/>ዔዶኦሜ ዓሳ ዪሁዳ ዓጮ ላሚ ጊንሣ ጌሊ ዓርቂ ሚርጌ ዓሲ ዲዒ ዔኪ ዓኣዼኔ፤ ዬያሮ ካኣቲ ዓካኣዜ ዒዛ ማኣዳንዳጉዲ ዓሶኦሬ ካኣቲ፥ ቲግላት ፔሌሴሬ ሺኢቄኔ። <verse eid="2CH 28:16-17"/><verse number="18" style="v" sid="2CH 28:18"/>ዒማና ፒሊስፄኤሜ ዓሳ ዓባ ጌላ ዛላ ዓኣ ጌሜሮ ዴሞንታ ዾኦሎ ዛሎይዳ ዓኣ ዪሁዳኮ ዻኮ ዻኮ ካታሞ ጌሊ ዓርቄኔ፤ ዬንሢ ካታማ፦ ቤትሼሜሼ፥ ዓያሎኔ፥ ጌዴሮቴ፥ ሶኮ፥ ቲሚናንታ ጊምዞ ጌይንታ ካታሞ ኮይላ ዓኣ ጉርዶንታ ዖሊ ባሺ ዓርቂ ዒኢካ ናንጌኔ። <verse eid="2CH 28:18"/><verse number="19" style="v" sid="2CH 28:19"/>ዪሁዳ ካኣቲ፥ ዓካኣዜ ዓጮይዳ ፑርታ ማዾ ማዼሢሮ ሃሣ ናንጊና ናንጋ ጎዳም ጉሙርቂንቲፆዋ ፓጪሴሢሮ ናንጊና ናንጋ ጎዳ ዪሁዳ ዓጮይዳ ሜቶ ዔኪ ዬዔኔ። <verse eid="2CH 28:19"/><verse number="20" style="v" sid="2CH 28:20"/>ዓሶኦሬ ካኣቲ፥ ዓካኣዜ ማኣዶ ዒፂ ዒዛም ሜቶ ማዤኔ፤ <verse eid="2CH 28:20"/><verse number="21" style="v" sid="2CH 28:21"/>ዬያሮ ዓካኣዜ ናንጊና ናንጋ ጎዳኮ ጌኤዦ ማኣራፓ፥ ካኣቱሞ ማኣሮንታ ዴሮ ሱኡጎንታፓ ሚርጌ ዎርቄ ዔኪ ዬያ ካኣቲ ጌሻኒ ዳኬኔ፤ ጋዓንቴ ዬይ ዒዛ ማኣዴ ባኣዚ ባኣሴ።<verse eid="2CH 28:21"/></para>
  <para style="s1">ዓካኣዜ ማዼ ጎሞ</para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 28:22"/>ዓካኣዜ ሜታ ዒዛይዳ ዑሣ ዓኣዼ ዺቢ ዺቢ ዓኣዼሢሮ ፔቶ ጎሜ ማዺሢና ናንጊና ናንጋ ጎዳ ዖዪሴኔ። <verse eid="2CH 28:22"/><verse number="23" style="v" sid="2CH 28:23"/>ዓካኣዜ ሶኦሪያ ዓሳ ባሻንዳጉዲ ዔያቶ ማኣዴ፥ ሶኦሪያ ዓሶ ፆኦዛሢም ዒንጎ ባኣዚ ሺኢሼኔ፤ ዬያ ዒ ማዼሢ፦ «ሶኦሪያ ዓሶ ፆኦዛ ሶኦሪያ ዓሶ ማኣዴኔ፤ ታኣኒ ዒንጎ ባኣዚ ዒንጌቴ ታናኣ ማኣዳንዳኔ» ጌይ ማሊኬ፤ ዬይ ማዻ ዒዛና ዒዛኮ ዓጮናይዳ ባይሲንታ ዔኪ ዬዔኔ፤ <verse eid="2CH 28:23"/><verse number="24" style="v" sid="2CH 28:24"/>ቃሲ ሃሣ ዓካኣዜ ጌኤዦ ማኣሮኮ ሜሆ ቢያ ዔኪ ኬሲ ሜንሣዖ ጌኤዦ ማኣሮ ካሮ ዎዼኔ፤ ዬሩሳላሜይዳ ዱማ ዱማ ቤስካ ሜሌ ፆኦዞም ዒንጎ ባኣዚ ዒንጎ ቤሲ ኮሼኔ፤ <verse eid="2CH 28:24"/><verse number="25" style="v" sid="2CH 28:25"/>ዪሁዳ ካታሞ ቢያሢዳ ዓኣ ሜሌ ፆኦዞም ዑንጆ ጩቢሾ ቤዞ ጌሜሮይዳ ኮሼኔ፤ ዬያይዲ ዓካኣዜ ዒዛኮ ቤርታኣ ዓዶንሢ ፆኦዛሢ ማዔ ናንጊና ናንጋ ጎዳኮ ጎሪንቶ ፔ ጊዳ ዔኪ ሙኬኔ።<verse eid="2CH 28:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 28:26"/>ዓካኣዜ ካኣታዼማፓ ዓርቃዖ ጋፖ ሄላንዳኣና ማዺንቴ ሜሌ ባካ ቢያ ዪሁዳና ዒስራዔኤሌ ካኣቶናኮ ሃይሳ ፃኣፒንታ ማፃኣፓ ፃኣፒንቲ ዓኣኔ፤ <verse eid="2CH 28:26"/><verse number="27" style="v" sid="2CH 28:27"/>ዬካፓ ካኣቲ ዓካኣዜ ሃይቂ፥ ዬሩሳላሜይዳ ዱኡቴኔ፤ ጋዓንቴ ካኣታ ዱኡታ ቤዛ ዱኡቲባኣሴ፤ ዒዛ ቤዛ ዒዛኮ ናኣዚ ሂዚቂያሴ ካኣታዼኔ። <note caller="-" style="x"><char style="xo" closed="false">28፡27 </char><char style="xt" closed="false"><ref loc="ISA 14:28">ዒሲ. 14፡28</ref>።</char></note><verse eid="2CH 28:27"/></para>
  <chapter eid="2CH 28"/>
  <chapter number="29" style="c" sid="2CH 29"/>
  <para style="s1">ዪሁዳ ካኣቲ ሂዚቂያሴ</para>
  <para style="r">(<ref loc="2KI 18:1-3">2ካኣቶ. ማ 18፡1-3</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 29:1"/>ሂዚቂያሴኮ ሌዓ ላማታሚ ዶንጎ ሌዔ ማዓኣና ካኣታዼኔ፤ ዒዚ ዬሩሳላሜይዳ ናንጊ ላማታሚ ታዞጳ ሌዔ ዎይሤኔ፤ ዒዛኮ ዒንዳ ዓቢያ ጌይንታያ ዛካሪያሴ ናዎኬ፤ <verse eid="2CH 29:1"/><verse number="2" style="v" sid="2CH 29:2"/>ዒዛኮ ማዔ፥ ዳውቴ ማዼ ጎይፆ ሂዚቂያሴ ኮሺ ማዾ ማዺ ናንጊና ናንጋ ጎዳ ዎዛሴኔ።<verse eid="2CH 29:2"/></para>
  <para style="s1">ናንጊና ናንጋ ጎዳኮ ጌኤዦ ማኣሮ ጊንሣ ጌኤሾናሢ</para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 29:3"/>ሂዚቂያሴ ካኣታዼ ሌዖኮ ቤርታሳ ዓጊኖና ናንጊና ናንጋ ጎዳኮ ጌኤዦ ማኣሮ ካሮ ቡሊ ኬኤፆ ጊንሣ ዓካሲ ዒዚ ኮሼኔ፤ <verse eid="2CH 29:3"/><verse number="4" style="v" sid="2CH 29:4"/>ቄኤሶና ሌዊ ዓሶና ዓባ ኬስካ ዛሎና ዓኣ ጌኤዦ ማኣሮይዳ ዓሳ ቡካ ቤዛ ዒ ቡኩሲ፦ <verse eid="2CH 29:4"/><verse number="5" style="v" sid="2CH 29:5"/>«ዒንሢ ሌዊ ዓሳ! ዒንሢ ናንጊና ናንጋ ጎዳም ዱማሲ፤ ሃሣ ጊንሣ ዒንሢኮ ቤርታኣ ዓዶንሢ ፆኦዛሢ ማዔ ናንጊና ናንጋ ጎዳኮ ጌኤዦ ማኣሮ ጌኤሻንዳያ ኮይሳኔ፤ ጌኤዦ ማኣሮ ዒኢሴ ባኮ ቢያ ጌኤዦ ማኣራፓ ባይዛንዳያ ዒንሢም ኮይሳኔ። <verse eid="2CH 29:5"/><verse number="6" style="v" sid="2CH 29:6"/>ኑኡኮ ቤርታኣ ዓዶንሢ ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢም ጉሙርቂንቲፆ ፓጪሲ ዒዛ ዖዪሴኔ፤ ዒዛ ሃሺ፥ ዒ ናንጋ ማኣሮ ማዔ ቤዛፓ ፔ ዓኣፖ ካሮ ዔያታ ሺርሼኔ፤ <verse eid="2CH 29:6"/><verse number="7" style="v" sid="2CH 29:7"/>ጌኤዦ ማኣሮ ካሮዋ ቢያ ዔያታ ዎዼኔ፤ ፖዖዋ ዔያታ ባይዜኔ፤ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢኮ ጌኤዦ ማኣሮይዳ ዑንጆ ጩቢሺፆንታ ዒንጎ ባኮ ሺኢሺፆዋ ሃሼኔ፤ <verse eid="2CH 29:7"/><verse number="8" style="v" sid="2CH 29:8"/>ዬያሮ ናንጊና ናንጋ ጎዳኮ ዻጋ ዪሁዳና ዬሩሳላሜናይዳ ሙኬኔ፤ ዔያቶይዳ ሄሌ ባይሲንታ ቢያሢ ዒጊቻያና ዲቃሣያ ማዔኔ፤ ዒንሢ ዬያ ቢያ ኮሺ ዔራኔ፤ <verse eid="2CH 29:8"/><verse number="9" style="v" sid="2CH 29:9"/>ኑ ዓዶንሢ ዖልዚና ሃይቄኔ፤ ኑኡኮ ላኣሎና ናኣቶና ቱኡሲ ዓሲ ማዒ ዲዒንቲ ዔውቴኔ።<verse eid="2CH 29:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 29:10"/>«ማይ ናንጊና ናንጋ ጎዳኮ ዻጋ ኑና ሄሉዋጉዲ ሃሢ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢና ዎላ ጫኣቃኒ ማሌኔ፤ <verse eid="2CH 29:10"/><verse number="11" style="v" sid="2CH 29:11"/>ታ ናይዮቴ! ዒዛኮ ቤርታ ዔቂ ዒዛም ዒንሢ ማዻንዳጉዲና ዒዛም ማዻ ዓሲ ዒንሢ ማዓንዳጉዲ፤ ዒንጎ ባኮዋ ዒንጋንዳጉዲ ናንጊና ናንጋ ጎዳ ዒንሢ ዶኦሬሢሮ ዓካሪ ቤልፃዺፖቴ» ጌዔኔ።<verse eid="2CH 29:11"/></para>
  <para style="p">
    <verse number="12-14" style="v" sid="2CH 29:12-14"/>ዬያ ማዾ ማዻንዳጉዲ ጌይንቴ ዓሳ ሃካፓ ዴማ ሱንፃ ፓይዲንቴ ሌዊ ዓሶኬ፦</para>
  <para style="q" vid="2CH 29:12-14">ቄዓቴ ቶኦካፓ፦ ዓማሳዬ ናኣዚ ማሃቴና ዓዛሪያሴ ናኣዚ ዒዩዔኤሌ፤</para>
  <para style="q" vid="2CH 29:12-14">ሜራሪ ቶኦካፓ፦ ዓብዲ ናኣዚ ቂሼና ዪሃልዔኤሌ ናኣዚ ዓዛሪያሴ፤</para>
  <para style="q" vid="2CH 29:12-14">ጌርሾኔ ቶኦካፓ፦ ዚማ ናኣዚ ዮዓሄና ዮዓሄ ናኣዚ ዔዴኔ፤</para>
  <para style="q" vid="2CH 29:12-14">ዔሊፃፓኔ ቶኦካፓ፦ ሺምሪና ዪዒዔኤሌና፤</para>
  <para style="q" vid="2CH 29:12-14">ዓሳኣፔ ቶኦካፓ፦ ዛካሪያሴና ማታኒያና፤</para>
  <para style="q" vid="2CH 29:12-14">ሄማኔ ቶኦካፓ፦ ዪሂዔኤሌና ሺምዒና፤</para>
  <para style="q" vid="2CH 29:12-14">ዪዱቱኔ ቶኦካፓ፦ ሼማዒያና ዑዚዔኤሌናኬ።<verse eid="2CH 29:12-14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 29:15"/>ዬያታ ዓሳ ሌዊ ዓሶ ማዔ፥ ፔ ዒጊኖ ቡኩሲ ቢያሢ ጎዳ ዎጎ ጎይፆና ፔና ጌኤሼኔ፤ ዬካፓ ካኣቲ ዓይሤ ጎይፆና ሌዊ ዓሳ ናንጊና ናንጋ ጎዳ ዎጎ ጎይፆና ጌኤዦ ማኣሮ ጊንሣ ጌኤሼኔ፤ <verse eid="2CH 29:15"/><verse number="16" style="v" sid="2CH 29:16"/>ዒማና ቄኤሳ ጌኤዦ ማኣሮ ጌኤሻኒ ጋሮ ጌሌኔ፤ ዳምቦ ጎይፆና ጌኤሽኪባኣ ባኮ ቢያ ጌኤዦ ማኣሮይዳ ዓሳ ቡካ ቤዞ ዔኪ ኬሴኔ፤ ዬካፓ ሌዊ ዓሳ ዬያ ባኮ ካታሜሎኮ ዙላ ዔኪ ኬሲ ቄድሮኦኔ ዶኦጫ ኬኤሬኔ።<verse eid="2CH 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 29:17"/>ዬይ ጌኤሺፆ ማዻ ቤርታሳ ዓጊኖኮ ፄኤራፓ ዓርቃዖ ሳላሳ ኬሎና ጌኤዦ ማኣሪ ጌሎ ካራ ዓኣ ቆልዖንታ ቢያ ጌኤሽኪ ጋፔኔ፤ ዬካፓ ጌኤዦ ማኣሮይዳ ካኣዦ ዳምቦ ጊኢጊሻኒ ሄሊ ዓኣ ሳላሳ ኬሎይዳ፤ ጌይፃ፦ ዓጊና ፄኤሬንቴ ታጶ ላሃሳ ኬሎ ሄላንዳኣና ዔያታ ማዼኔ።<verse eid="2CH 29:17"/></para>
  <para style="s1">ጌኤዦ ማኣራ ላሚ ጊንሣ ፆኦሲም ዱማዼያ ማዔሢ</para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 29:18"/>ሌዊ ዓሳ ማዺንቴ ማዾ ዛሎ ካኣቲ ሂዚቂያሴም፦ «ሚቺ ዒንጎ ባኮ ናንጊና ናንጋ ጎዳም ዒንጎ ቤዞንታ ፆኦሲም ዱማዼ ካሦ ጌሦ ዼጌ ሎኦዦ ዖይቶንታ፤ ዬያቶና ዎላ ማዺንቶ ሜሌ ሜሆንታ ጌኤዦ ማኣሮ ዳምቦ ጎይፆና ቢያ ኑ ጌኤሼኔ፤ <verse eid="2CH 29:18"/><verse number="19" style="v" sid="2CH 29:19"/>ዬያጉዲ ካኣቲ ዓካኣዜ ናንጊና ናንጋ ጎዳም ጉሙርቂንቱዋያ ማዒ ናንጌ ሌዖይዳ ጌኤዦ ማኣራፓ ዔኬ ሜሆ ቢያ ጊንሣ ማሂ ዔኪ ሙኪ ፆኦሲም ዱማዼያ ኑ ማሄኔ፤ ዬይ ሜሃ ጉቤ ናንጊና ናንጋ ጎዳም ዒንጎ ባኮ ዒንጎ ቤዞኮ ቤርቶ ዛላ ዓኣኔ» ጌዒ ኬኤዜኔ።<verse eid="2CH 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 29:20"/>ዚሮ ጉቴሎ ጉቴ ዓማ ካኣቲ ሂዚቂያሴ ካታሞኮ ቢቶ ማዓ ዓሶ ቡኩሲ ዔያቶና ዎላ ጌኤዦ ማኣሪ ዴንዴኔ፤ <verse eid="2CH 29:20"/><verse number="21" style="v" sid="2CH 29:21"/>ዔያታ ካኣቲ ማኣሮ ዓሶንታ ዪሁዳ ዴሮንታኮ ጎሞ ጌኤሻንዳጉዲ፤ ዬያጉዲ ሃሣ ጌኤዦ ማኣሮ ጌኤሺፆ ዳምቦም ዒንጊሢ ማዒ ናንጊና ናንጋ ጎዳም ዒንጊንታንዳጉዲ ላንካይ ዚያ ጌማይ፥ ላንካይ ዓዴ ማራይ፥ ላንካይ ማራናይ ዓዴና ላንካይ ዻካ ኮላናይና ዔኪ ሙኬኔ፤ ካኣቲ ዓኣሮኔ ዜርፆ ማዔ ቄኤሳ ዬያ ቆልሞ ፆኦሲም ዒንጎ ቤዞይዳ ዒንጊሢ ማሂ ሹኪ ሺኢሻንዳጉዲ ዓይሤኔ፤ <verse eid="2CH 29:21"/><verse number="22" style="v" sid="2CH 29:22"/>ዬያሮ ቄኤሳ ቤርታዺ ዚዮ ጌማቶ፥ ሄሊሳዖ ዓዶ ማራቶ፥ ጋፒንፆይዳ ማራናኣቶ ሹኪ ፔቴ ፔቴ ቆልሞኮ ሱጉፆ ዒንጎ ባኮ ዒንጎ ቤዞይዳ ፑጬኔ፤ <verse eid="2CH 29:22"/><verse number="23" style="v" sid="2CH 29:23"/>ዬካፓ ካኣቲንታ ቡኪንቲ ዓኣ ዓሶንታም ዋናቶንሢ ሺኢሻዛ ዓሳ ኩጮ ዬንሢ ዑፃ ጌሤኔ። <verse eid="2CH 29:23"/><verse number="24" style="v" sid="2CH 29:24"/>ካኣቲ ዒስራዔኤሌ ዴሮ ጉቤሢ ዛሎ ሚቺ ዒንጎ ዒንጊፆና ጎሞ ጌኤሻኒ ዒንጎ ዒንጊፆም ማዓንዳ ባኮ ዒንጋንዳጉዲ ዓይሤሢሮ ቄኤሳ ዓይሢንቴ ጎይፆ ዋናቶንሢ ሹኪ ሱጉፆ ዒንጊሢ ማሂ ዒንጎ ባኮ ሺኢሾ ቤዞይዳ ዋሄኔ።<verse eid="2CH 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 29:25"/>ካኣቲ ሂዚቂያሴ ፆኦሲ ማሊፆ ኬኤዛ ጋኣዴና ናኣታኔ ዛሎና ካኣቲ ዳውቴም ኬኤዜሢንታ ዳውቴ ማዺ ኩንሤ ዓይሢፆ ጎይፆ ማዺ ዺቦ ሻዦና ዋርቆ ጎኦሎንታ ሂቻሢንታ ፔቴ ሻዦና ዋርቆ ጎኦሎዋ ዋርቂ ዔሬ ሌዊ ዓሶ ጌኤዦ ማኣራ ማዻንዳጉዲ ጌሤኔ፤ <verse eid="2CH 29:25"/><verse number="26" style="v" sid="2CH 29:26"/>ዬያሮ ሌዊ ዓሳ ዬያ ዳውቴ ማዺሻ ዓይኑሞ ዓንጋሞ ዔኪ፥ ቄኤሳ ዛዬ ዔኪ ዒኢካ ጌኤዦ ማኣሮ ጋራ ዔቄኔ፤ <verse eid="2CH 29:26"/><verse number="27" style="v" sid="2CH 29:27"/>ዒማና ካኣቲ ሂዚቂያሴ ሚቺ ዒንጎ ባኮ ናንጊና ናንጋ ጎዳም ሺኢሾ ቤዞይዳ ዒንጋንዳጉዲ ዓይሤኔ፤ ዒንጊፆ ዓርቃኣና ዴራ ጋላታ ዓይኑሞ ዓይናዼኔ፤ ዓይኑሞ ዓይናዻ ዓሳ ዛዬ ዋርቂ፤ ሃሣ ዳውቴኮ ዓይኑሞ ዓንጋሞዋ ዋርቂ ዋርቂ ዓይናዺሢ ዓርቄኔ፤ <verse eid="2CH 29:27"/><verse number="28" style="v" sid="2CH 29:28"/>ዒኢካ ዓኣ ዴራ ቢያ ዎሊ ዑፃ ፆኦሲም ዚጌኔ፤ ዒንጎ ባካ ቢያ ጋፒ ሚቺንታንዳያ ሄላንዳኣና ዓይኑሞ ዓይናዻ ዓሳ ዓይናዼኔ። <verse eid="2CH 29:28"/><verse number="29" style="v" sid="2CH 29:29"/>ዒንጎ ባኮ ፆኦሲም ዒንጊ ጋፔስካፓ ካኣቲ ሂዚቂያሴንታ ዒኢካ ዓኣ ዴራ ቢያ ጉምዓቲ ናንጊና ናንጋ ጎዳም ዚጌኔ። <verse eid="2CH 29:29"/><verse number="30" style="v" sid="2CH 29:30"/>ካኣቲንታ ዴሮኮ ሱኡጎ ቢያሢንታ ዳውቴና ፆኦሲ ማሊፆ ኬኤዛ ዓሳኣፔና ኬሴ ጋላቶ ዓይኑሞ ፆኦሲ ቦንቾም ዓይናዻንዳጉዲ ሌዊ ዓሶ ዓይሤኔ፤ ዬያሮ ቢያሢ ጉምዓቲ ዚጊፆይዳ ዓኣዖ ዼኤፒ ዎዛና ዓይናዼኔ።<verse eid="2CH 29:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2CH 29:31"/>ካኣቲ፥ ሂዚቂያሴ ዴሮ ኮይላ፦ «ዓካሪ ዒንሢ ናንጊና ናንጋ ጎዳም ዒንሢ ዱማሴሢሮ ናንጊና ናንጋ ጎዳም ጋላታ ሺኢሻኒ ዒንሢ ዒንጋ ባኮ ቢያ ፆኦሲኮ ጌኤዦ ማኣሪ ዔኪ ሙኩዋቴ!» ጌዔኔ፤ ዔያታ ካኣቲ ዔያቶ ዓይሤ ጎይፆ ማዼኔ፤ ፔቴ ፔቴ ዓሳ ፔ ሼኔና ሚቺ ዒንጎ ዒንጊሢ ማዓንዳ ቆልሞ ዔኪ ሙኬኔ፤ <verse eid="2CH 29:31"/><verse number="32" style="v" sid="2CH 29:32"/>ዬያይዲ ዴራ ናንጊና ናንጋ ጎዳም ሚቺ ዒንጎ ዒንጊሢ ማዓንዳጉዲ ዔኪ ሙኬ ቆልሞኮ ሚርጉማ ላንካይታሚ ዚያ ጌማይ፥ ፔቴ ፄኤታ ዓዴ ማራይና ላምዖ ፄኤታ ዓዴ ማራናይናኬ፤ <verse eid="2CH 29:32"/><verse number="33" style="v" sid="2CH 29:33"/>ሃሣ ጊንሣ ፔቱሞና ዒንጎ ዒንጊፆም ዱማሶና ቆልሞኮ ዺቡማ ላሆ ፄኤታ ዚያ ጌማይና ሃይሦ ሺያ ዓዴ ማራይናኬ፤ <verse eid="2CH 29:33"/><verse number="34" style="v" sid="2CH 29:34"/>ዬያ ቢያ ቆልሞ ቲቂ ሹካኒ ጊዳ ቄኤሴ ባኣሢሮ ማዻ ጋፓንዳያ ሄላንዳኣና፤ ሃሣ ዳምቦ ጎይፆና ጌኤሽኬ ቄኤሴ ጴዻንዳያ ሄላንዳኣና ሌዊ ዓሳ ዔያቶ ማኣዳኔ፤ ዎጋ ዓይሣ ጎይፆና ዳምቦና ጌኤሽኪፆ ዛሎኮ ቄኤሳፓ ባሼ ሌዊ ዓሳ ቢያ ዎዴ ጊኢጌያኬ። <verse eid="2CH 29:34"/><verse number="35" style="v" sid="2CH 29:35"/>ሚቺ ዒንጎ ዒንጊፆንታ ፔቱሞና ዒንጎ ዒንጊፆኮ ማሎንታ ዑዦ ዒንጊፆንታ ዒንጊንቴሢ ኮሺ ዺቤኔ።</para>
  <para style="p" vid="2CH 29:35">ዬያይዲ ጌኤዦ ማኣሮይዳ ማዺንታ ካኣዦ ዳምባ ጊንሣ ዓርቂንቴኔ፤ <verse eid="2CH 29:35"/><verse number="36" style="v" sid="2CH 29:36"/>ካኣቲ ሂዚቂያሴና ዴሮና ዬይ ቢያ ዑኬና ማዺንታንዳጉዲ ፆኦሲ ዔያቶ ማኣዴሢሮ ኮሺ ዎዛዼኔ።<verse eid="2CH 29:36"/></para>
  <chapter eid="2CH 29"/>
  <chapter number="30" style="c" sid="2CH 30"/>
  <para style="s1">ዑሣ ዓኣዺፆ ቦንቾ ቦንቻኒ ጊኢጊንቶናሢ</para>
  <para style="p">
    <verse number="1-3" style="v" sid="2CH 30:1-3"/>ዎጎ ጎይፆ ፔና ጌኤሼ፥ ጊዳ ቄኤሴ ባኣሢሮ፤ ሃሣ ዬሩሳላሜይዳ ሚርጌ ዴሬ ቡኪባኣሢሮ ዴራ ዑሣ ዓኣዺፆ ቦንቾ ቤርታ ማዺንታ ጎይፆ ቤርታሳ ዓጊኖና ቦንቻኒ ዳንዳዒባኣሴ፤ ዬያሮ ካኣቲ ሂዚቂያሴንታ ዒዛኮ ዶንዞ ማዔ ቢታንታ ዓኣ ዓሶንታ ዬሩሳላሜ ዴሮንታ ዑሣ ዓኣዺፆ ቦንቾ ላምዓሳ ዓጊኖና ቦንቻኒ ዎላ ጌስቲ ዔቂሴኔ፤ ያዺ ማዔሢሮ ካኣቲ ዒስራዔኤሌና ዪሁዳ ዴሮ ጉቤሢም፤ ዬያጉዲ ጊንሣ ዔፕሬኤሜንታ ሚናኣሴ ዴሮንታ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ቦንቻኒ ዑሣ ዓኣዺፆ ቦንቾሮ ዬሩሳላሜይዳ ዓኣ ጌኤዦ ማኣሪ ሙካንዳጉዲ ኪኢታ ዋርቃታ ዳኬኔ፤ <note caller="-" style="x"><char style="xo" closed="false">30፡1-3 </char><char style="xt" closed="false"><ref loc="NUM 9:9-11">ፓይ. ማፃ 9፡9-11</ref>።</char></note> <verse eid="2CH 30:1-3"/><verse number="4" style="v" sid="2CH 30:4"/>ካኣቲንታ ዴሮንታ ዬያ ማሊፆና ዎዛዼኔ። <verse eid="2CH 30:4"/><verse number="5" style="v" sid="2CH 30:5"/>ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢኮ ዑሣ ዓኣዺፆ ቦንቾ ሚርጌ ዎዴይዳ ዺቢ ዓሲ ሙኪ ቦንቺ ቤቂባኣሢሮ ኬዶ ዛሊና ዳኣኔፓ ዓርቃዖ ዾኦሎ ዛሊና ዴንዲ ቤርሳቤ ሄላንዳኣና ዓኣ ዒስራዔኤሌ ዓሳ ቢያ ቤርታ ቡኪንታ ቡኪንቶይዳፓ ቢያ ባሼ ዎጎ ጎይፆ ሚርጌና ሙኪ ዑሣ ዓኣዺፆ ቦንቾ ቦንቻንዳጉዲ ዔያታ ዔኤሊሢ ዳኬኔ። <verse eid="2CH 30:5"/><verse number="6" style="v" sid="2CH 30:6"/>ካኣቲንታ ዒዛኮ ዶንዞ ማዔ ቢታንታ ዓኣ ዓሳ ዓይሤ ዓይሢፆና ኪኢቶ ዓሳ ዪሁዳና ዒስራዔኤሌ ዓጮ ጉቤ ዓኣዼኔ።</para>
  <para style="p" vid="2CH 30:6">ዔያታ ዔኪ ዓኣዼ ኪኢታ፦ «ዒስራዔኤሌ ዓሲዮቴ! ዓሶኦሬ ካኣቲ ዲዒፆይዳፓ ዓቴ ዓሶ፥ ዒንሢ ባንሢ ዒዚ ማዓንዳጉዲ ዓብራሃሜንታ ዪሳኣቄንታ ያይቆኦቤንታኮ ፆኦሲ ባንሢ ማዑዋቴ፤ <verse eid="2CH 30:6"/><verse number="7" style="v" sid="2CH 30:7"/>ናንጊና ናንጋ ጎዳ ማዔ ዔያቶኮ ፆኦዛሢም ጉሙርቂንቲባኣ ዒንሢኮ ቤርታኣ ዓዶንሢንታ ዒንሢ ዒጊኖ ዒስራዔኤሌ ዓሶጉዲ ማዒፖቴ፤ ዒንሢ ዔራሢጉዲ ናንጊና ናንጋ ጎዳ ዔያቶ ባይሲንታም ዓኣሢ ዒንጌኔ፤ <verse eid="2CH 30:7"/><verse number="8" style="v" sid="2CH 30:8"/>ናንጊና ናንጋ ጎዳም ዓይሢንታያ ማዓንዳኣፓዓቴም ዔያቶጉዲ ዒና ባይቂ ዶጬያ ማዒፖቴ፤ ዒንሢ ፆኦሲም ዎርቃያ ማዑዋቴ፤ ናንጊና ዒዛሮ ማሂ ዒ ዱማሴ፥ ዬሩሳላሜይዳ ዓኣ ጌኤዦ ማኣሪ ሙኩዋቴ፤ ሃካፓ ሴካ ናንጊና ናንጋ ጎዳኮ ዻጋ ዒንሢ ሄሉዋጉዲ ዒዛ ሌሊ ካኣሽኩዋቴ፤ <verse eid="2CH 30:8"/><verse number="9" style="v" sid="2CH 30:9"/>ዒንሢ ናንጊና ናንጋ ጎዳ ባንሢ ማዔቴ ዬያታ፥ ዒንሢኮ ናኣቶንታ ዒጊኖንታ ዲዒ ዔኬ ዓሳ ዔያቶም ሚጪንቲ ዔያታ ናንጋ ቤዞ ማዒ ሙካንዳንጉዲ ዳካንዳኔ፤ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢ ኮሺ፤ ሃሣ ዓቶም ጋዓያ ማዔሢሮ ዒንሢ ዒዛ ባንሢ ማዔቴ ዒዚ ዒንሢ ዔካንዳኔ» ጋዓያኬ።<verse eid="2CH 30:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 30:10"/>ኪኢቶ ዓሶንሢ ዔፕሬኤሜንታ ሚናኣሴ ፃጶ ዓጮይዳ ዓኣ ካታሞ ቢያ፤ ዴንዲ ዛብሎኦኔ ፃጶ ዓጮኮ ኬዶ ዛሎ ሄላንዳኣና ዓኣዼኔ፤ ዬይ ዓሳ ጋዓንቴ ዔያቶ ቦሂ ሚኢጬኔ፤ <verse eid="2CH 30:10"/><verse number="11" style="v" sid="2CH 30:11"/>ጋዓንቴ ናንጊና ናንጋ ጎዳም ሼሌዒ ዬሩሳላሜ ሙካኒ ዔኤዔ ዓሲ ዓሴኤሬፓ፥ ሚናኣሴንታ ዛብሎኦኔንታ ፃጳፓ ፔቴ ፔቴ ዓኣኔ፤ <verse eid="2CH 30:11"/><verse number="12" style="v" sid="2CH 30:12"/>ዪሁዳ ዴሮም ናንጊና ናንጋ ጎዳ ሚርጌ ባኣዚ ማዻሢሮ ካኣቲንታ ቢታንታ ዓኣ ዓሶንታ ዓይሤ ዓይሢፆ ዔኤዒ ኩንሣኒ ፔቴ ማሊሢና ዔኤዓንዳጉዲ ፆኦሲ ዪሁዳ ዴሮ ዔቂሴኔ።<verse eid="2CH 30:12"/></para>
  <para style="s1">ዑሣ ዓኣዺፆ ቦንቻ ቦንቺንቴሢ</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 30:13"/>ላምዓሳ ዓጊኖና ላኣዶ ሙዒ ቦንቾ ኬሎ ቦንቻኒ ሚርጌ ዴሬ ዬሩሳላሜይዳ ቡኬኔ፤ <verse eid="2CH 30:13"/><verse number="14" style="v" sid="2CH 30:14"/>ዬሩሳላሜይዳ ሜሌ ፆኦዞም ዒንጎ ባኮ ዒንጋኒና ዑንጆዋ ጊዳ ጌሢ ጩቢሾ ባኮ ቢያ ዔኪ ቄድሮኦኔ ዶኦጫ ዓሳ ኬኤሬኔ፤ <verse eid="2CH 30:14"/><verse number="15" style="v" sid="2CH 30:15"/>ላምዓሳ ዓጊና ፄኤሬንቴ ታጶ ዖይዳሳ ኬሎና ማራናኣቶ ዑሣ ዓኣዺፆ ቦንቾ ኬሎም ዔያታ ሹኬኔ፤ ዒማና ዳምቦ ጎይፆና ፔና ጌኤሺባኣ ሌዊ ዓሶንታ ቄኤሶንታ ኮሺ ቦርሲንቴኔ፤ ዬያሮ ዔያታ ፔና ናንጊና ናንጋ ጎዳም ዱማሴስካፓ ጌኤዦ ማኣሮይዳ ሚቺ ዒንጎ ባኮ ፆኦሲም ዒንጋኒ ዳንዳዔኔ። <verse eid="2CH 30:15"/><verse number="16" style="v" sid="2CH 30:16"/>ፆኦሲ ዓሢ፥ ሙሴ ዓይሤ ዳምቦ ጎይፆጉዴያ ጌኤዦ ማኣሮይዳ ዔያቶ ማዾንጎ ጎዖና ቤዛ ዔያታ ዔቄኔ፤ ሌዊ ዓሳኣ ዒንጎና ባኮኮ ሱጉፆ ቄኤሶም ዔኪ ሺኢሻዛ፥ ቄኤሳ ዬያ ሱጉፆ ዒንጎ ባኮ ዒንጎ ቤዞ ዑፃ ፑጬኔ፤ <verse eid="2CH 30:16"/><verse number="17" style="v" sid="2CH 30:17"/>ዴሮ ባኣካ ሚርጌ ዓሲ ዎጎ ጎይፆና ፔና ጌኤሺባኣያ ማዔሢሮ ዑሣ ዓኣዺፆ ቦንቾ ኬሎም ማዓ ማራቶ ሹካኒ ዔያታ ዳንዳዑዋያ ማዔኔ፤ ዬያሮ ሌዊ ዓሳ ዔያቶ ዛሎ ማራናኣቶ ሹኪ ናንጊና ናንጋ ጎዳም ሺኢሼኔ፤ <verse eid="2CH 30:17"/><verse number="18" style="v" sid="2CH 30:18"/>ሃሣ ጊንሣ ዔፕሬኤሜፓ፥ ሚናኣሴፓ፥ ዪሳኮኦሬንታ ዛብሎኦኔንታ ፃጳፓ ሙኬ ሚርጌ ዓሲ ዎጎ ጎይፆና ፔና ጌኤሺባኣታዖ ዑሣ ዓኣዺፆ ቦንቾ ሙዔኔ፥ ጋዓንቴ ኮይሳሢ ጎይፆ ቦንቺባኣሴ፤ ዬያሮ ካኣቲ፥ ሂዚቂያሴ ዔያቶ ዛሎ፦ <verse eid="2CH 30:18"/><verse number="19" style="v" sid="2CH 30:19"/>«ዔያቶኮ ቤርታኣ ዓዶንሢ ፆኦዛሢ ማዔ ናንጊና ናንጋ ጎዳሢዮ! ዎዚ ሃይ ዓሳ ዎጎ ጎይፆና ፔና ጌኤሺባኣያ ማዔቴያ ሃኣዛጌ ዔያታ ሃሢ ጉቤ ዒኔፓ ኔና ካኣሽካኔ፤ ዬያሮ ኔ ኮሹሞና ዓቶንጎ ዔያቶም ጌዔ!» ጌይ ሺኢቄኔ፤ <verse eid="2CH 30:19"/><verse number="20" style="v" sid="2CH 30:20"/>ናንጊና ናንጋ ጎዳ ሂዚቂያሴኮ ሺኢጲፆ ዋይዚ ዓቶም ጌዔኔ፤ ፔቴታዖ ሜቶ ዓሶይዳ ሄሊሲባኣሴ። <verse eid="2CH 30:20"/><verse number="21" style="v" sid="2CH 30:21"/>ዒማና ዬሩሳላሜይዳ ቡኪንቴ ዴራ ላንካይ ኬሊ ጉቤ ላኣዶ ሙዒ ቦንቾ ቦንቾ ዼኤፒ ዎዛና ቦንቼኔ፤ ሌዊ ዓሶንታ ቄኤሶንታ ቢያ ኬሊ ዓይኑሞ ዓንጋሞ ዋርቂ ዋርቂ ዓይናዺሢና ፆኦሲ ጋላቴኔ፤ <verse eid="2CH 30:21"/><verse number="22" style="v" sid="2CH 30:22"/>ሂዚቂያሴያ ሌዊ ዓሳ ናንጊና ናንጋ ጎዳ ካኣሽኮ ካኣዦ ዳምቦ ኩንሢሲፆ ዔራቶና ማዼሢሮ ዔያቶ ጋላቴኔ።</para>
  <para style="p" vid="2CH 30:22">ዒማና ዴራ ዔያቶኮ ቤርታኣ ዓዶንሢ ፆኦዛሢ ማዔ ናንጊና ናንጋ ጎዳ ቦንቺ ላንካይ ኬሊ ፔቱሞና ዒንጎ ዒንጊፆ ዒንጊ ማዔስካፓ፥ <verse eid="2CH 30:22"/><verse number="23" style="v" sid="2CH 30:23"/>ቃሲ ጊንሣ ላንካይ ኬሊ ቦንቻኒ ፔቱሞና ዎላ ጌስቲ ዔቂሲ ቦንቾ ዎዛና ቦንቼኔ። <verse eid="2CH 30:23"/><verse number="24" style="v" sid="2CH 30:24"/>ካኣቲ ሂዚቂያሴ ዒማና ፔቴ ሺያ ዚያ ጌማይ፥ ላንካይ ሺያ ማራይና ዋኣሪና፤ ሃሣ ዒዛኮ ዶንዞ ማዔ ቢታንታ ዓኣ ዓሳ ፔቴ ሺያ ዚያ ጌማይ፥ ታጶ ሺያ ማራይና ዋኣሪና ዴራ ሹኪ ሙዓንዳጉዲ ዒንጌኔ፤ ፓይዳ ዑሣ ዓኣዻ ሚርጌ ቄኤሴያኣ ዎጎ ጎይፆና ፔና ናንጊና ናንጋ ጎዳም ዱማሴኔ፤ <verse eid="2CH 30:24"/><verse number="25" style="v" sid="2CH 30:25"/>ዬያሮ ዪሁዳ ዴራ፥ ቄኤሳ፥ ሌዊ ዓሳ፥ ኬዶ ዛሎ ዓጫፓ ሙኬ ዓሳ፥ ዒስራዔኤሌንታ ዪሁዳ ዓጮንታይዳ ሙኬ ዓሲ ማዒ ናንጋ ዴራ ቢያ ኮሺ ዎዛዼኔ። <verse eid="2CH 30:25"/><verse number="26" style="v" sid="2CH 30:26"/>ዳውቴ ናኣዚ ሴሎሞኔ ዎዳፓ ዓርቂ ዒማ ሄላንዳኣና ዬያጉዴ ቦንቾ ዬሩሳላሜይዳ ቦንቺንቲ ቤቂባኣሢሮ ዬሩሳላሜ ካታሞ ዴራ ኮሺ ዎዛዼኔ። <verse eid="2CH 30:26"/><verse number="27" style="v" sid="2CH 30:27"/>ቄኤሶና ሌዊ ዓሶና ዔቂ ፆኦሲኮ ዓንጃ ዴሮም ማዓንዳጉዲ ሺኢቄኔ፤ ፆኦሲያኣ ዒዚ ናንጋ፥ ፔኤም ዱማዼ ማኣሮ፥ ጫሪንጮይዳ ዓኣዖ ሺኢጲፆ ዔያቶኮ ዋይዜኔ።<verse eid="2CH 30:27"/></para>
  <chapter eid="2CH 30"/>
  <chapter number="31" style="c" sid="2CH 31"/>
  <para style="s1">ካኣቲ ሂዚቂያሴ ፆኦሲ ባኣዚ ማዾ ማዾ ዓካሴሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 31:1"/>ቦንቾ ኬላ ጋፔስካፓ ዒስራዔኤሌ ዴራ ዪሁዳ ካታሞ ጉቤ ዓኣዺ ሹጮና ሜሌ ፆኦዞ ማሊሲ ኮሾና ዻኣቦ ሜንሤኔ፤ ዓሼራ ጌይንታ ላኣሎ ፆኦዜሎ ሱንፆና ማዦና ባኮዋ ቲቂ ኬኤሬኔ፤ ዒንጎ ባኮ ዒንጎ ቤዞንታ ሜሌ ዓሳ ዚጊ ፔ ፆኦዞ ካኣሽካ ቤዞዋ ዶይሲ ባይዜኔ፤ ዬያጉዲ ዪሁዳ፥ ቢኢኒያሜንታ ዔፕሬኤሜንታ ሚናኣሴንታ ዓጫ ዓኣ ሜሌ ፆኦዞም ዚጎ ቤዞና ዒንጎ ባኮ ዒንጎ ቤዞዋ ሻሄኔ፤ ዬካፓ ዔያታ ናንጋ ቤዞ ቤዞ ማዒ ዴንዴኔ።<verse eid="2CH 31:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 31:2"/>ካኣቲ ሂዚቂያሴ ቄኤሶና ሌዊ ዓሳ ፔቱሞና ማዾ ማዻንዳ ዳምቦ ጊንሣ ጊኢጊሼኔ፤ ዬያ ፔቱሞና ማዾ ማዻንዳ ፔቴ ፔቴ ቄኤሶና ሌዊ ዓሶናኮ ዱማ ማዾ ዓኣኔ፤ ዬይ ማዻ፦ ሚቺ ዒንጎ ዒንጊፆንታ ፔቱሞና ዒንጎ ዒንጊፆንታ ጌኤዦ ማኣሮይዳ ማዺንታ ካኣዦ ዳምቦ ኩንሢሲሢንታ ጌኤዦ ማኣሮይዳ ሜሌ ዱማ ዱማ ፓቆና ቤዞይዳ ጋላቲሢና ሄርሺሢ ዓይኑሞ ዓይናዺሢንታኬ፤ <verse eid="2CH 31:2"/><verse number="3" style="v" sid="2CH 31:3"/>ቢያ ዎዴ ጉቴና ዒባኒና ሚቺ ዒንጎ ዒንጊፆም፥ ሃውሾ ኬሎ ዳምቦም፥ ዓጊኖ ፄኤሮንታ ፆኦሲ ዎጋ ዓይሣ ሜሌ ቦንቾ ኬሎም ዒንጊንታ ዒንጊፆኮ ካኣቲ ሂዚቂያሴ ፔ ቆሎ ማዔ ማራቶና ባኣቶናፓ ዒንጋኔ። <note caller="-" style="x"><char style="xo" closed="false">31፡3 </char><char style="xt" closed="false"><ref loc="NUM 28:1-29:30">ፓይ. ማፃ 28፡1—29፡30</ref>።</char></note><verse eid="2CH 31:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 31:4"/>ቃሲ ሃሣ ቄኤሶና ሌዊ ዓሶና ቢያ ኬላ ፆኦሲኮ ዎጋ ማዾም ጋዓሢጉዲ ዔያታ ማዻንዳጉዲ ዔያቶም ዒንጋኒ ኮይሳ ባኮ ቢያ ዬሩሳላሜ ዴራ ዔኪ ሙካንዳንጉዲ ካኣቲ ዓሶ ዓይሤኔ፤ <verse eid="2CH 31:4"/><verse number="5" style="v" sid="2CH 31:5"/>ዒስራዔኤሌ ዓሳ ዬያ ካኣቲ ዓይሢፆ ዋዋይዛዖ ዔያቶኮ ሃኣኮንታ ዎይኖ ዑዦንታ ሪሚታፓ ኮሾ ዛይቶንታ ዔኤዞና ሜሌ ዔያቶኮ ጎዦይዳፓ ቢያ ቤርቶ ዒንጊሢ ማሂ ሺኢሼኔ፤ ዔያቶኮ ዓኣ ቆሎይዳፓ ቢያ ኮሺ ማዔ ባኮኮ ታጶይዳፓ ፔቴማ ኬሲ ኬሲ ዔያታ ዒንጌኔ፤ <note caller="-" style="x"><char style="xo" closed="false">31፡5 </char><char style="xt" closed="false"><ref loc="NUM 18:12-13">ፓይ. ማፃ 18፡12-13</ref>፤<ref loc="NUM 18:21">21</ref>።</char></note> <verse eid="2CH 31:5"/><verse number="6" style="v" sid="2CH 31:6"/>ዪሁዳ ካታማ ናንጋ ዴራ ቢያ ዔያቶኮ ባኣቶና ማራቶናኮ ታጶይዳፓ ፔቴ ኬሲ ኬሲ ዒንጌኔ፤ ዬያጉዲ ሃሣ ናንጊና ናንጋ ጎዳ ማዔ ዔያቶኮ ፆኦዛሢም ዔያታ ዱማሴ ዒንጊፆ ዔኪ ሙኪ ቡኩሴኔ፤ <verse eid="2CH 31:6"/><verse number="7" style="v" sid="2CH 31:7"/>ዬያ ዔያታ ዒንጋ ባኮ ዔኪ ሙኮ ዓርቄሢ ማኣላ ቡሪንታ ሃይሣሳ ዓጊኖና ማዓዛ ጋፑዋዖ ዖይዶ ዓጊኒ ኩሙሢ ዔኪ ሙኪ ሙኪ ቡኩሲ ላንካሳ ዓጊኖና ጋፒሴኔ፤ <verse eid="2CH 31:7"/><verse number="8" style="v" sid="2CH 31:8"/>ዬካፓ ካኣቲ ሂዚቂያሴና ዒዛኮ ዶንዞ ማዔ ቢታንታ ዓኣ ዓሳ ሙኪ ዬያ ሚርጌ ዔኪ ሙኪ ቡኩሶና ባኮ ዛጌ ዎዶና ናንጊና ናንጋ ጎዳ ጋላቴኔ፤ ሃሣ ዒዛኮ ዒጊኖ ማዔ ዒስራዔኤሌ ዓሶዋ ዔያታ ዓንጄኔ። <verse eid="2CH 31:8"/><verse number="9" style="v" sid="2CH 31:9"/>ካኣቲ ዴሮይዳፓ ዒንጊንቴ ቡኩሶና ባኮ ዛሎ ቄኤሶና ሌዊ ዓሶና ዖኦጬኔ፤ <verse eid="2CH 31:9"/><verse number="10" style="v" sid="2CH 31:10"/>ዒማና ሳዶቄ ዜርሢ ማዔ፥ ቄኤሶ ቢያኮ ዑፃሢ፥ ዓዛሪያሴ ካኣቲም፦ «ዴራ ታጳሢዳፓ ፔቴማ ናንጊና ናንጋ ጎዳ ማኣሪ ዔኪ ሙኮ ዓርቄማፓ ሃንጋ ሃሢ ኑኡም ጊዳ ሙኡዚ ዓኣኔ፤ ዬያ ሌሊቱዋንቴ ኑኡም ጊዲያኣ ሚርጌ ዓቴኔ፤ ናንጊና ናንጋ ጎዳ ዴሮ ዓንጄሢሮ ሃሢ ሃያ ቢያ ሚርጌና ኑ ዴንቄኔ» ጌዔኔ።<verse eid="2CH 31:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 31:11"/>ዬያሮ ካኣቲ ሂዚቂያሴ ጌኤዦ ማኣሮ ዓጫ ሜሄ ጌሦንዶ ማኣሪ ማዢንቲ፥ <verse eid="2CH 31:11"/><verse number="12" style="v" sid="2CH 31:12"/>ዬይ ታጶይዳፓ ፔቴማ ዒንጎሢንታ ሜሌ ዒንጎ ባኮዋ ቢያ ዒኢካ ዛጊ ጌሢንታንዳጉዲ ዓይሤኔ፤ ሃሣ ጊንሣ ኮናኒያ ጎዖ ሌዊ ዓሢ ሜሆ ጌሦ ማኣሮኮ ሱኡጌ ማዒ ዶኦሪንታዛ ዒዛኮ ጌርሲ ሺምዒ ዒዛ ማኣዳያ ማዒ ዶኦሪንቴኔ፤ <verse eid="2CH 31:12"/><verse number="13" style="v" sid="2CH 31:13"/>ዔያቶኮ ዴማ ማዒ ማዻንዳጉዲ፦ ዪሂዔኤሌ፥ ዓዛዝያ፥ ናሃቴ፥ ዓሳሄሌ፥ ዪሪሞቴ፥ ዮዛባዴ፥ ዔሊዔኤሌ፥ ዩስማኪያ፥ ማሃቴና ቤናያ ጌይንታ ታጶ ሌዊ ዓሲ ጌሢንቴኔ። ዬያቶ ቢያ ዶኦሬሢ ካኣቲ ሂዚቂያሴና ቄኤሶኮ ዑፃሢ ማዔ ዓዛሪያሴናኬ፤ <verse eid="2CH 31:13"/><verse number="14" style="v" sid="2CH 31:14"/>ጌኤዦ ማኣሮኮ ዓባ ኬስካ ዛሎና ዓኣ ካሮ ካፓ ዓሶኮ ሱኡጋሢ ማዔ ሌዊ ዓሢ ዩሚና ናኣዚ፥ ቆሬሜ ናንጊና ናንጋ ጎዳም ዓሳ ፔ ማሊሢና ናሽኪ ዒንጋ ዒንጊፆ ቢያ ዔካንዳጉዲና ፓቂ ፓቂ ጊሽካንዳጉዲ ሱኡጌ ማሂ ዔያታ ዶኦሬኔ። <verse eid="2CH 31:14"/><verse number="15" style="v" sid="2CH 31:15"/>ቄኤሳ ናንጋ ሜሌ ካታሞይዳ ቆሬሜም ጉሙርቂንታያ ማዒ ዒዛ ማኣዳዞንሢ፦ ዔዴኔ፥ ሚንያሚኔ፥ ዒያሱ፥ ሼማዒያ፥ ዓማሪያንታ ሼካኒያ ጌይንታዞንሢኬ፤ ዔያታ ፔኤኮ ማዾ ጎይፆና ሙዖ ዔያቶኮ ዒጊኖ ማዔ ሌዊ ዓሶም ፒዜና ጊሽካኔ። <verse eid="2CH 31:15"/><verse number="16" style="v" sid="2CH 31:16"/>ቃሲ ሃሣ ዱማ ዱማ ኬላ ኬላ ዔያቶም ማዾንጎ ጎዖና ባኮ ማዻኒ ጌኤዦ ማኣሪ ጌላ፥ ሌዓ ሃይሦና ዬካፓ ዑሣ ማዔ ዓቲንቆም ማዾም ጌሦናሢጉዴያ ጉዴያ ዔያቶም ሄላ ባኮ ባኮ ዒንጋኔ፤ <verse eid="2CH 31:16"/><verse number="17" style="v" sid="2CH 31:17"/>ቄኤሳ ማዻንዳጉዲ ጌይንቴሢ ፔ ቶኦኮና ቶኦኮና ማዓዛ ሌዓ ላማታሚና ዬካፓ ዑሣ ማዔ ሌዊ ዓሶ ማዻ ጋዓንቴ ዔያታ ማዻ ማዾ ጎይፆጉዴያ ማዓኔ፤ <verse eid="2CH 31:17"/><verse number="18" style="v" sid="2CH 31:18"/>ዬንሢ ቄኤሶና ሌዊ ዓሶና ፆኦሲም ዱማዼ ማዾ ማዻኒ ዎማ ዎዴና ማዔቶዋ ጊኢጌያ ማዓኒ ኮይሳሢሮ ዔያታ ፃኣፒንታኣና ዔያቶኮ ላኣላ፥ ናኣቶንታ ዔያቶኮ ዴማ ማዒ ዎርቃ ዓሶንታ ቢያ ዎላኬ፤ <verse eid="2CH 31:18"/><verse number="19" style="v" sid="2CH 31:19"/>ዓኣሮኔ ዜርፆም ጌይንቴ ካታሞና ካታሞኮ ኮይላ ቆልማ ሄንቃ ቤዞናይዳ ናንጋ ቄኤሶ ባኣኮይዳ ቄኤሶ ማኣሮ ዓሶና ሌዊ ዓሶ ፃጶኮ ሱንፃ ፃኣፒንቲ ዓኣ ቤዞይዳ ፃኣፒንቴ ዓቲንቆም ቢያ ሙዖ ጊሽካንዳጉዲ ዶኦሮና ዓሲ ዓኣኔ።<verse eid="2CH 31:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 31:20"/>ካኣቲ ሂዚቂያሴ ዪሁዳ ዓጮ ጉቤይዳ ኮሺ ማዔ ባኣዚና ናንጊና ናንጋ ጎዳ ማዔ ዒዛኮ ፆኦዛሢ ዎዛሳ ባኣዚ ቢያ ማዼኔ፤ <verse eid="2CH 31:20"/><verse number="21" style="v" sid="2CH 31:21"/>ፆኦሲኮ ጌኤዦ ማኣሮይዳ ማዾሢታቴያ ሃሣ ፆኦሲኮ ዎጎና ዓይሢፆና ኩንሣኒ ዒ ማዼ ባካ ቢያ ጎኔ ዒናፓ ፔ ፆኦዛሢም ጉሙርቂንታያ ማዔሢሮ ዒዛም ቢያ ባካ ጊኢጌኔ።<verse eid="2CH 31:21"/></para>
  <chapter eid="2CH 31"/>
  <chapter number="32" style="c" sid="2CH 32"/>
  <para style="s1">ዓሶኦሬ ዓሳ ዬሩሳላሜ ዖላኒ ዚርቄሢ</para>
  <para style="r">(<ref loc="2KI 18:13-37">2ካኣቶ. ማ 18፡13-37</ref>፤ <ref loc="2KI 19:14-19">19፡14-19</ref>፤<ref loc="2KI 19:35-37">35-37</ref>፤ <ref loc="ISA 36:1-22">ዒሲ. 36፡1-22</ref>፤ <ref loc="ISA 37:8-38">37፡8-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 32:1"/>ካኣቲ ሂዚቂያሴ ናንጊና ናንጋ ጎዳም ጉሙርቂንቲ ሚርጌ ባኣዚ ማዼስካፓ ዓሶኦሬ ካኣቲ ሴናክሬሜ ዪሁዳ ዓጮ ዖላኒ ኬስኬኔ፤ ዒማና ዒዚ ዖሎና ባሻንዳሢ ጉሙርቂ ኬልቂ ዲርቆና ካታሞ ማንጋዖ ዒዛኮ ዖሎ ዓሳ ካታሞኮ ኬኤሎ ዲሮ ዶይሲ ጌላንዳጉዲ ዓይሤኔ። <verse eid="2CH 32:1"/><verse number="2" style="v" sid="2CH 32:2"/>ሴናክሬሜ ዬያይዲ ዬሩሳላሜ ዖላኒ ማሌሢ ካኣቲ ሂዚቂያሴ ዔራዖ፥ <verse eid="2CH 32:2"/><verse number="3-4" style="v" sid="2CH 32:3-4"/>ዒዛና ዒዛኮ ዶንዞ ማዔ ቢታንታ ዓኣ ዓሳ ካታሜሎኮ ዙላ ዓኣ ዓልቃ ዋኣፆና ዻዋሢ ዋኣፆ ዔኪ ዎቶ ጎይፆ ዲርቂ ባይዛኒ ዞርቴኔ፤ ዬያሮ ዔያታ ዒዛ ማኣዴኔ፤ ዬያ ዔያታ ማዼሢ ዓሶኦሬ ዓሳ ዬሩሳላሜ ባንሢ ሙካዖ ፔቴታዖ ዋኣሢ ዴንቁዋጉዲ ጌይኬ፤ ዬያሮ ቢታንታ ዓኣ ዓሳ ሚርጌ ዴሬ ዔኪ ዴንዲ ዓልቃ ዋኣፆይዳፓ ዋኣሢ ዎቱዋጉዲ ማሂ ዬንሢ ዓልቃ ዋኣፆንሢ ቢያ ሲንሢ ባይዜኔ። <verse eid="2CH 32:3-4"/><verse number="5" style="v" sid="2CH 32:5"/>ካኣቲ ሂዚቂያሴ ዲሮ ዓካሲ ዑፆይዳ ካፖንዶ ማኣሪ ሹቺና ማዢ ዲሮኮ ዙሎ ዛሎና ሜሌ ዲርሲ ኮሺሢና ካታሞ ካፖንዶ ቤዞ ዶዲሼኔ፤ ጊንሣ ሃሣ ሚና ቤርታ ዬሩሳላሜኮ ዓባ ኬስካ ባንፆና ዓኣ ባኣሲንቴ ቤዞይዳ ኮሾና ካፖ ቤዞዋ ዓካሴኔ፤ ሚርጌ ዎርሢንታ ጊቲማንታኣ ኮሼኔ። <verse eid="2CH 32:5"/><verse number="6" style="v" sid="2CH 32:6"/>ካታሜሎይዳ ናንጋ ዓቲንቆ ቢያ ዖሎ ዓሶ ሱኡጎ ቢታንቶኮ ዴማ ዔያታ ማዓንዳጉዲ ማሃዖ ካታሞ ዲሮኮ ጌሎ ካራ ዓኣ ፔጎ ጶኦካ ቡኩሴኔ፤ ዬካፓ፦ <verse eid="2CH 32:6"/><verse number="7" style="v" sid="2CH 32:7"/>«ዶዲ ዒኔና ኩሙሢ ማዑዋቴ፤ ዓሶኦሬ ካኣቲታቶዋ ዒዚ ዔኪ ዖሊሳ ዖሎ ዓሶዋ ዒጊጪፖቴ፤ ዒዛና ዎላ ዓኣ ዎልቃፓ ዑሣ ዓኣዼ ኑኡና ዎላ ዓኣ ዎልቃ ባሻያኬ፤ <verse eid="2CH 32:7"/><verse number="8" style="v" sid="2CH 32:8"/>ዒዛና ዓኣ ዎልቃ ዓሲ ዎልቄኬ፤ ኑኡና ዎላ ማዒ ኑና ማኣዳሢና ኑ ዛሎ ዖልታሢ ጋዓንቴ ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢኬ» ጌዒ ዶዲሻዛ፥ ዴራ ካኣቲ ዬያ ኬኤዜ ሃይሶና ዶዴኔ።<verse eid="2CH 32:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 32:9"/>ዬካፓ ዻካ ዎርቃዖ ካኣቲ ሴናክሬሜና ዖሎ ዓሶና ሃጊ ላኪሼ ጌይንታ ቤዛ ዓኣዖ ሂዚቂያሴና ዬሩሳላሜናይዳ ዓኣ ዪሁዳ ዴሮም፦ <verse eid="2CH 32:9"/><verse number="10" style="v" sid="2CH 32:10"/>«ታኣኒ ዓሶኦሬ ካኣቲ ሴናክሬሜ፥ ታኣኮ ዖሎ ዓሶና ታ ማንጊሴ ዬሩሳላሜይዳ ዒንሢ ዴዓኒ ማሌሢ ዖና ዒንሢ ጉሙርቄታቶዋ ዔራኒ ታ ኮዓኔ፤ <verse eid="2CH 32:10"/><verse number="11" style="v" sid="2CH 32:11"/>ሂዚቂያሴ፥ ‹ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢ ዓሶኦሬ ዓሶ ኩጫፓ ኑና ዓውሳንዳኔ› ዒንሢም ጋዓኔ፤ ጋዓንቴ ዒዚ ሂዚ ጋዓ ሃይሴና ዒንሢ ጌሺ ጌሺ ናዮና ዋኣፆ ዼኤቦና ዒንሢ ኩዳንዳጉዲ ዒንሢ ዒ ማሃኒኬ፤ <verse eid="2CH 32:11"/><verse number="12" style="v" sid="2CH 32:12"/>ሃያኮ ቤርታ ናንጊና ናንጋ ጎዳም ዱማዼ ዒዛ ካኣሽኮ ቤዞና ዒዛም ዒንጎ ባኮ ዒንጎ ቤዞዋ ሻሄሢ፥ ሃሣ ዪሁዳና ዬሩሳላሜና ዴራ ፔቴ ፆኦሲም ዒንጎ ቤስካ ሌሊ ዑንጆ ጩቢሺ ጩቢሺ ናንጋንዳጉዲ ማሄሢያ ሂዚቂያሴኬ፤ <verse eid="2CH 32:12"/><verse number="13" style="v" sid="2CH 32:13"/>ታኣኮ ቤርታኣ ዓዶንሢንታ ታናንታ ሜሌ ዓጮ ዴሮይዳ ኑ ማዼ ባኮ ዒንሢ ዔሩዋዓዳ? ዬያ ሜሌ ዴሮይዳፓ ፔኤኮ ዴሮ ዓሶኦሬ ካኣቲ ኩጫፓ ዻቂሺ ዓይሴይ ዔያቶኮ ካኣሽኮ ፆኦዛፓ ፔቴታዖ ዓኣ? <verse eid="2CH 32:13"/><verse number="14" style="v" sid="2CH 32:14"/>ታ ዓዶንሢ ባይዜ፥ ዬያ ዓጮኮ ካኣሽኮ ፆኦዛ ዻቂሺ ዓይሴ ዓጪ ዓኣ? ዓካሪ ዒንሢ ፆኦዛሢ ታ ኩጫፓ ዒንሢ ዎይቲ ዓውሳኒ ዳንዳዓንዳይ? <verse eid="2CH 32:14"/><verse number="15" style="v" sid="2CH 32:15"/>ዬያሮ ሂዚቂያሴ ዒንሢ ዬያ ጌይ ጌሾፓ! ዻቢንቲ ባንሢያ ዔኪ ዓኣዾፓ! ፔቴታዖ ዒዛሲ ጉሙርቂፖቴ፤ ዓይጎሮ ጌዔቴ ዎኖ ዴሮዋ ማዖም ዔያታ ካኣሽካ ሜሌ ፆኦዛሢ ፔኤኮ ዴሮ ዓሶኦሬ ዓጮ ካኣቶ ኩጫፓ ዻቂሼይ ባኣሴ፤ ዓካሪ ሃሢ ዒንሢ ፆኦዛሢያ ዒንሢ ዻቂሺንዱዋሢ ዒንሢም ዔርቴያ ማዖንጎ» ጋዓ ኪኢታ ዳኬኔ።<verse eid="2CH 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 32:16"/>ዬያ ሌሊቱዋንቴ ዓሶኦሬ ዓሶኮ ቢታንታ ዓኣ ዓሳኣ ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢና ዒዛም ማዻ ዓይላሢ ሂዚቂያሴናይዳ ዬያፓ ባሼ ፑርታ ባኣዚ ጌዒ ጌስቴኔ፤ <verse eid="2CH 32:16"/><verse number="17" style="v" sid="2CH 32:17"/>ዬይ ዓሶኦሬ ካኣቲ ፃኣፔ ዋርቃታ፦ «ሜሌ ዴሮኮ ካኣሽኮ ፆኦዛ ታ ኩጫፓ ፔኤኮ ዴሮ ዓውሲባኣኬ፤ ሃሢ ሂዚቂያሴ ፆኦዛሢ ፔ ዴሮ ታ ኩጫፓ ፔቴታዖ ዓውሳኒ ዳንዳዑዋኣኬ» ጋዓያ፥ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ቦሃያኬ፤ <verse eid="2CH 32:17"/><verse number="18" style="v" sid="2CH 32:18"/>ዬያ ሄርሺንቶ ሃይሶ ዓሶኦሬ ዓሶኮ ቢታ ዔብሬ ዓሶ ሙኡቺና ኬኤሎ ዲፆ ዑፃ ዓኣ ዬሩሳላሜ ዓሶም ዑኡዞ ዼጊዲ ኬኤዜኔ፤ ዬያ ዔያታ ማዼሢ ዴራ ዒጊጪ ካራ ባይዜም ዔያታ ካታሞ ሜታ ባኣያ ጌሊ ዓርቃኒ ማሊኬ። <verse eid="2CH 32:18"/><verse number="19" style="v" sid="2CH 32:19"/>ዓሲ ኩቺና ኮሺንቴ ሜሌ ዴራ ካኣሽካ ፆኦዞ ዑፃ ጫርቂ ዔያታ ጌስታ ጎይፆ ዬሩሳላሜ ፆኦሲዳኣ ጌስቴኔ።<verse eid="2CH 32:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 32:20"/>ዬካፓ ካኣቲ ሂዚቂያሴና ፆኦሲ ማሊፆ ኬኤዛ፥ ዓሞፄ ናኣዚ ዒሲያሴና ፆኦሲ ሺኢቄኔ፤ ዔያቶ ማኣዳንዳጉዲ ዶዲሺ ዒዛ ባንሢ ዔያታ ዒላቴኔ፤ <verse eid="2CH 32:20"/><verse number="21" style="v" sid="2CH 32:21"/>ናንጊና ናንጋ ጎዳ ዒማና ኪኢታንቻሢ ዳኪ ዓሶኦሬኮ ፖኦሊሶና ዖሎ ዓሶዋ ዓይሣ ሱኡጎ ባይዜኔ፤ ዬያሮ ዓሶኦሬ ካኣቲ ቦርሲንቲ ፔ ዓጮ ማዔኔ፤ ዒኢካ ፔቴ ኬሊ ዒ ፔኤኮ ካኣሽኮ ፆኦዞ ዚጊ ካኣሽኮ ቤዛ ዓኣንቴ ዒዛኮ ሾዖና ናኣታ ጬንቻ ዓፓሮና ዒዛ ዎዼኔ።<verse eid="2CH 32:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 32:22"/>ናንጊና ናንጋ ጎዳ ዬያይዲ ካኣቲ ሂዚቂያሴና ዬሩሳላሜ ዴሮ ዓሶኦሬ ካኣቲ ሴናክሬሜና ሜሌ ዔያቶኮ ሞርኮ ኩጫፓ ኬሲ ዓውሴኔ፤ ዬካፓ ዔያቶኮ ዓሺኖ ማዔ ዴሮና ቢያ ዎላ ኮሺ ናንጊሴኔ፤ <verse eid="2CH 32:22"/><verse number="23" style="v" sid="2CH 32:23"/>ሚርጌ ዴሬ ዒማና ናንጊና ናንጋ ጎዳም ዒንጎ ባኣዚ፥ ዬያጉዲ ሃሣ ካኣቲ ሂዚቂያሴማኣ ዒንጎ ባኣዚ ዔኪ ዬሩሳላሜ ሙኬኔ፤ ዬማፓ ዓርቃዖ ዴራ ቢያ ሂዚቂያሴ ዼጊዲ ቦንቺ ዛጊሢ ዓርቄኔ።<verse eid="2CH 32:23"/></para>
  <para style="s1">ሂዚቂያሴኮ ሃርጊንቲፆና ዒዛኮ ሄርሺንቶና</para>
  <para style="r">(<ref loc="2KI 2:1-3">2ካኣቶ. ማ 2፡1-3</ref>፤<ref loc="2KI 2:12-19">12-19</ref>፤ <ref loc="ISA 38:1-3">ዒሲ. 38፡1-3</ref>፤ <ref loc="ISA 39:1-8">39፡1-8</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 32:24"/>ዬኖ ዎዶና ካኣቲ ሂዚቂያሴ ሃርጊንቲ ሃይቃኒ ዑካዖ ናንጊና ናንጋ ጎዳ ሺኢቃዛ፥ ዒዚ ዒዛ ዓውሳንዳሢ ማላታና ዻዌኔ፤ <verse eid="2CH 32:24"/><verse number="25" style="v" sid="2CH 32:25"/>ያዺ ማዔቴያ ሂዚቂያሴኮ ዒና ዖቶርሙሞና ኩሜሢሮ ናንጊና ናንጋ ጎዳ ዒዛም ሚጪንቲ ማዼ ባኮሮ ቢያ ኮይሳሢጉዲ ጋላቲባኣሴ፤ ዬያሮ ዒዛንታ ዪሁዳና ዬሩሳላሜናይዳኣ ዶዲ ሜታ ሄሌኔ። <verse eid="2CH 32:25"/><verse number="26" style="v" sid="2CH 32:26"/>ጋዓንቴ ጋፒንፆይዳ ሂዚቂያሴንታ ዬሩሳላሜ ዴራ ፔና ሼሌዒሲሢና ዔያታ ፔ ቶኦኮ ሂርኪዴሢሮ ሂዚቂያሴ ሃይቃንዳያ ሄላንዳኣና ናንጊና ናንጋ ጎዳ ፔ ዴሮ ሜታሲባኣሴ።<verse eid="2CH 32:26"/></para>
  <para style="s1">ሂዚቂያሴኮ ዖርጎቹሞና ዔርቴ ዓሲ ማዒፆና</para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 32:27"/>ካኣቲ ሂዚቂያሴ ሚርጌና ዖርጎጬኔ፤ ዴራኣ ቢያ ዒዛ ቦንቼኔ፤ ዒዚ ዒዛኮ ዎርቃ፥ ቢራ፥ ሚዛጶ ሹጫ፥ ሳውቃ ዼኤሻ፥ ጊቲሞንታ ሜሌ ጴዹዋያ ማዔ ባኮ ጌሦንዶ ሜሄ ማኣሪያ ማዤኔ፤ <verse eid="2CH 32:27"/><verse number="28" style="v" sid="2CH 32:28"/>ቃሲ ሃሣ ዒዛኮ ሃኣኮና ዎይኖ ዑዦና ሪሚቶ ዛይቶና ጌሦንዶ ሜሄ ማኣሪንታ ባኣቶና ማራቶናኮዋ ባርታ ዲርቄኔ፤ <verse eid="2CH 32:28"/><verse number="29" style="v" sid="2CH 32:29"/>ዬያ ሌሊቱዋንቴ ፆኦሲ ዒዛም ሚርጌ ባይና ማራይ ቆሎንታ፤ ዬያጉዲ ሃሣ ሜሌ ሚርጌ ባኣዚ ዒንጌሢሮ ሚርጌ ካታማ ዒ ማዤኔ፤ <verse eid="2CH 32:29"/><verse number="30" style="v" sid="2CH 32:30"/>ኬዶ ዛሎና ዓኣ ጊዮኔኮ ዓልቃ ዋኣፃ ኬስካ ካሮ ቃዚ፥ ዋኣፆ ዻዎና ዔኪ፥ ዬሩሳላሜኮ ዓባ ጌላ ባንፆና ሳዖ ዴሚና ዎታንዳጉዲ ማሄሢ ሂዚቂያሴኬ፤ ሂዚቂያሴ ማዼ ሜሌ ባካ ቢያ ዒዛም ጊኢጌኔ፤ <verse eid="2CH 32:30"/><verse number="31" style="v" sid="2CH 32:31"/>ጋዓንቴ ዓጮይዳ ፆኦሲ ዎልቄና ማዺንታ ዓኮ ባኮ ዛሎ ዖኦጫንዳጉዲ ባብሎኔ ዓጮኮ ሱኡጋ ዳኬ ኪኢቶ ዓሳ ሙኪ ዓኣንቴ ናንጊና ናንጋ ጎዳ ሂዚቂያሴኮ ዒኖ ዛጋኒ ዒዛ ሃሼኔ።<verse eid="2CH 32:31"/></para>
  <para style="s1">ሂዚቂያሴ ካኣቱሞኮ ጋፒንፆ</para>
  <para style="r">(<ref loc="2KI 20:20-21">2ካኣቶ. ማ 20፡20-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 32:32"/>ካኣቲ ሂዚቂያሴ ማዼ ሜሌ ባካ ቢያ፥ ፆኦሲ ዛሎ ዒዛኮ ዓኣ ሚጪንታ ፆኦሲ ማሊፆ ኬኤዛ ዓሞፄ ናኣዚ ዒሲያሴም ፆኦሲ ፔጋሲ ዻዌ ባካ ፃኣፒንቴ ማፃኣፖና ዪሁዳና ዒስራዔኤሌ ዓሶናኮ ሃይሳ ፃኣፒንቴ ማፃኣፓ ፃኣፒንቲ ዓኣኔ። <verse eid="2CH 32:32"/><verse number="33" style="v" sid="2CH 32:33"/>ሂዚቂያሴ ሃይቂ፥ ኬዶ ዛሎና ዳውቴ ናኣታ ዱኡታ ካኣቶ ዱኡፖ ቤዛ ዱኡቴኔ፤ ዒማና ዪሁዳንታ ዬሩሳላሜ ዴሮንታ ቢያ ዼኤፒ ቦንቾና ዒዛ ዱኡኬኔ፤ ዬካፓ ዒዛ ቤዛ ዒዛኮ ናኣዚ ሚናኣሴ ካኣታዼኔ።<verse eid="2CH 32:33"/></para>
  <chapter eid="2CH 32"/>
  <chapter number="33" style="c" sid="2CH 33"/>
  <para style="s1">ዪሁዳ ካኣቲ ሚናኣሴ</para>
  <para style="r">(<ref loc="2KI 21:1-9">2ካኣቶ. ማ 21፡1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 33:1"/>ሚናኣሴ ዪሁዳ ዓጮይዳ ካታዻኣና ሌዓ ዒዛኮ ታጶ ላምዖኬ፤ ዒዚ ዬሩሳላሜይዳ ዴዒ ዶንጊታሚ ዶንጎ ሌዔ ዎይሤኔ፤ <verse eid="2CH 33:1"/><verse number="2" style="v" sid="2CH 33:2"/>ዒስራዔኤሌ ዓሳ ዔያቶም ዒንጎና ዓጬሎ ጌላ ዎዶና ናንጊና ናንጋ ጎዳ ዔያቶኮ ቤርታፓ ዳውሲ ኬሴ ሜሌ ዴሮኮ ሻኣካ ማዾ ማዺሢና ሚናኣሴ ማዼ ጎማ ናንጊና ናንጋ ጎዳ ዖዪሴኔ፤ <note caller="-" style="x"><char style="xo" closed="false">33፡2 </char><char style="xt" closed="false"><ref loc="JER 15:4">ዔር. 15፡4</ref>።</char></note> <verse eid="2CH 33:2"/><verse number="3" style="v" sid="2CH 33:3"/>ሚናኣሴ ዒዛኮ ዓዴ ሂዚቂያሴ ሻሄ፥ ሜሌ ዓሳ ዚጊ ካኣሽካ ቤዞ ጊንሣ ኮሼኔ፤ ዬይያኣ፦ ባዓኣሌ ጌይንታ ሜሌ ፆኦዞም ዒንጎ ቤዞንታ፤ ሃሣ ዓሼራ ጌይንታ ላኣሎ ፆኦዜሎኮዋ ማላቶ ዾቄኔ፤ ጊንሣ ጫሪንጮ ዦኦጋሢያ ዚጊ ካኣሽኬኔ፤ <verse eid="2CH 33:3"/><verse number="4" style="v" sid="2CH 33:4"/>ናንጊና ናንጋ ጎዳ ናንጊና ካኣሽኪንታንዳጉዲ ዓይሤ ቤዞ ጌይፃ፦ ዬሩሳላሜ ጌኤዦ ማኣሮይዳ ሜሌ ዓሳ ፔ ፆኦዞም ዒንጋ ቤሲ ኮሼኔ፤ <note caller="-" style="x"><char style="xo" closed="false">33፡4 </char><char style="xt" closed="false"><ref loc="2CH 6:6">2ፆኦሲ. ዓሃኬ 6፡6</ref>።</char></note> <verse eid="2CH 33:4"/><verse number="5" style="v" sid="2CH 33:5"/>ጌኤዦ ማኣሮኮ ዓሳ ቡካ ላምዖ ጶኦኮይዳ ጫሪንጮ ዦኦጋሢም ዒንጎ ባኣዚ ዒንጎንዶ ቤሲ ኮሼኔ፤ <verse eid="2CH 33:5"/><verse number="6" style="v" sid="2CH 33:6"/>ዬያ ሌሊቱዋንቴ ፔኤኮ ዓቲንቆ ናኣቶ ሄኖሜ ዶኦጮይዳ ሚቺ ዒንጎ ዒንጊሢ ማሂ ሺኢሼኔ፤ ዒ ፔኤሮ ጫኣቃያ ማርሻ ዓሲ ማዒ ዦዎና ጎርሞይቶና ኮራ ዦኦቻያ ማዔኔ፤ ዬያ ቢያና ዼኤፒ ጎሜ ማዼሢሮ ናንጊና ናንጋ ጎዳ ዒ ዻጋሴኔ። <verse eid="2CH 33:6"/><verse number="7" style="v" sid="2CH 33:7"/>ጌኤዦ ማኣሮ ጋሮይዳ ሜሌ ፆኦዞኮ ማላሢ ዾቄኔ፤ ዬይ ጌኤዦ ማኣራ ናንጊና ናንጋ ጎዳ ዳውቴና ዒዛኮ ናኣዚ ሴሎሞኔናም፦ «ሃይ ዬሩሳላሜይዳ ዓኣ ጌኤዦ ማኣራ ታ ሱንፃ ዔኤሊንታንዳጉዲ ታጶ ላምዖ ዒስራዔኤሌ ፃጶ ዓጫፓ ቢያ ታ ዶኦሬ ታኣም ዱማዼ ቤሲኬ፤ <verse eid="2CH 33:7"/><verse number="8" style="v" sid="2CH 33:8"/>ዒስራዔኤሌ ዓሳ ሙሴ ዛሎና ታ ዔያቶ ዓይሤ ታኣኮ ዎጎንታ ዳምቦንታ ሃሣ ታኣኮ ዓይሢፆዋ ቢያ ዛጊ ዔያታ ካፔያታቶ ዔያቶኮ ቤርታኣ ዓዶንሢም ዒንጌ ዓጫፓ ላሚ ታ ዔያቶ ዳውሲንቲ ኬስካንዳጉዲ ማሂንዱዋሴ» ጌዔሢኬ። <note caller="-" style="x"><char style="xo" closed="false">33፡8 </char><char style="xt" closed="false"><ref loc="1KI 9:3-8">1ካኣቶ. ማ 9፡3-8</ref>፤ <ref loc="2CH 7:12-18">2ፆኦሲ. ዓሃኬ 7፡12-18</ref>።</char></note> <verse eid="2CH 33:8"/><verse number="9" style="v" sid="2CH 33:9"/>ዒስራዔኤሌ ናኣታ ዔያቶም ዒንጎና ዓጬሎ ጌላ ዎዶና ናንጊና ናንጋ ጎዳ ዔያቶኮ ቤርታፓ ዳውሴ ዴራ ማዻሢዳፓ ባሼ ፑርታ ጎሜ ማዻንዳጉዲ ዪሁዳንታ ዬሩሳላሜንታ ዴሮ ሚናኣሴ ዔኪ ጎሜይዳ ጌልዜኔ።<verse eid="2CH 33:9"/></para>
  <para style="s1">ሚናኣሴ ፔ ማዼ ጎሞ ዔሪ ዖዬሢ</para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 33:10"/>ናንጊና ናንጋ ጎዳ ዒማና ሚናኣሴና ዴሮናም ዶዲሺ ላቲ ኬኤዜማኣ ዔያታ ዋይዞ ዒፄኔ፤ <verse eid="2CH 33:10"/><verse number="11" style="v" sid="2CH 33:11"/>ዬያሮ ናንጊና ናንጋ ጎዳ ዓሶኦሬኮ ዖሎ ዓሳ ዪሁዳ ኬስኪ ዖላንዳጉዲ ማሄኔ፤ ዬይ ዖሎ ዓሳ ሚናኣሴ ዲዒ ዒዛኮ ሲኢዾይዳ ዓንጊ ኪሬ ዓኣሢ፥ ካኒ ቢራታና ቱኪ ዔኪ ባብሎኔ ዓኣዼኔ። <verse eid="2CH 33:11"/><verse number="12" style="v" sid="2CH 33:12"/>ዒኢካ ሚናኣሴ ሜታዻዖ ፔ ቶኦኮ ሄርኪዲ ሼሌዑሞና ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢ ባንሢ ማዔኔ፤ ፆኦሲ ዒዛ ማኣዳንዳጉዲያኣ ዒ ሺኢቄኔ፤ <verse eid="2CH 33:12"/><verse number="13" style="v" sid="2CH 33:13"/>ናንጊና ናንጋ ጎዳ ሚናኣሴኮ ሺኢጲፆ ዋይዚ፥ ዒ ላሚ ጊንሣ ዬሩሳላሜ ማዒ ዎይሣንዳጉዲ ማሄኔ፤ ናንጊና ናንጋ ጎዳ ጎኔ ፆኦሲ ማዔሢ ዬያና ሚናኣሴ ዔሬኔ።<verse eid="2CH 33:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 33:14"/>ዬካፓ ሚናኣሴ ዳውቴ ካታሞኮ ዓባ ኬስካ ባንፆና ዓኣ፥ ዙሎ ኬልቂ ዲርቆ ዲሮ ሌካ ዼጊዲ ዖዶሲ ዲርቄኔ፤ ዬይ ኬኤሎ ዲራ ዶኦጫዻ ቤዞ፥ ጊዮኔ ዋኣፃ ዓልቃሢኮ ዓባ ኬስካ ዛሎና ጌዒ ኬዶ ዛሎኮ ዴንዲ ሞላሢ ኬኤሎ ዲሮ ካሮ ሄላንዳኣና ማዓዛ ካታሞኮ ኮይላ ዓኣ ዖፔሌ ጌይንታ ቤዞዋ ጊዳ ቃሳኔ፤ ዬያጉዲ ሃሣ ሚናኣሴ ኬልቂ ዲርቄ ዪሁዳኮ ፔቴ ፔቴ ካታሞም ቢያ ፔቴ ፔቴ ዖሎ ዓሶ ዓይሣ ሱኡጌ ጌሤኔ። <verse eid="2CH 33:14"/><verse number="15" style="v" sid="2CH 33:15"/>ዒማና ሚናኣሴ ሜሌ ፆኦዞና ዒዚ ፔኤሮ ጌኤዦ ማኣሮይዳ ዾቄ ካኣሽኮ ባኮ ማላሢ ጌኤዦ ማኣራፓ ሺኢሺ ኬሴኔ፤ ዬያጉዲ ሃሣ ዬሩሳላሜይዳ ጌኤዦ ማኣሮ ማዦና ጌሜሮና ሜሌ ቤዞይዳ ዓኣ ፆኦዞም ዒንጎ ቤዞ ቢያ ዶይሲ ባይዚ ዬያ ቢያ ዔኪ ካታሞኮ ዙላ ኬሲ ኬኤሬኔ፤ <verse eid="2CH 33:15"/><verse number="16" style="v" sid="2CH 33:16"/>ናንጊና ናንጋ ጎዳም ዒንጊ ካኣሽኪንታ ቤዞ ጊንሣ ዓካሲ ዒኢካ ፔቱሞና ዒንጎ ዒንጊፆንታ ጋላታ ዒንጊሢያ ሺኢሼኔ፤ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ካኣሽካንዳጉዲ ዪሁዳ ዴሮ ጉቤ ዒ ዓይሤኔ። <verse eid="2CH 33:16"/><verse number="17" style="v" sid="2CH 33:17"/>ዎዚ ዒማና ዴራ ዱማ ዱማ ካኣሽኮ ቤዞይዳ ዒንጎ ባኮ ዒንጊፆ ሃሺባኣቶዋ ዔያታ ዒንጋ ባኮ ሺኢሻሢ ናንጊና ናንጋ ጎዳ ማዔ ፆኦሲም ሌሊኬ።<verse eid="2CH 33:17"/></para>
  <para style="s1">ሚናኣሴ ካኣቱሞኮ ጋፒንፆ</para>
  <para style="r">(<ref loc="2KI 21:17-18">2ካኣቶ. ማ 21፡17-18</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 33:18"/>ሚናኣሴ ማዼ ሜሌ ባካ ቢያ፥ ዒ ፔኤኮ ፆኦዛሢ ሺኢቄ ሺኢጲፃ፥ ፆኦሲ ማሊሢ ኬኤዛ ዓሳ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ሱንፆና ዒዛም ኬኤዜ ሃይሳኣ ዓቱዋዖ ዒስራዔኤሌ ካኣቶ ሃይሶ ማፃኣፓ ፃኣፒንቲ ዓኣኔ፤ <verse eid="2CH 33:18"/><verse number="19" style="v" sid="2CH 33:19"/>ካኣቲ ሚናኣሴ ፆኦሲ ሺኢቄ ሺኢጲፃ፥ ፆኦሲ ዒዛኮ ሺኢጲፆ ዋይዚ ማሄሢ፥ ዒዚ ፔ ዻቢንቶ ዔሪ ዖያንዳሢኮ ቤርታ ዒ ማዼ ጎማ ቢያ፥ ጌይፃ፦ ዒ ዱማ ዱማ ማዼ ፑርቶ ማዻ፥ ዒዚ ፔ ቶኦኪና ኮሼ ሜሌ ዓሳ ካኣሽካ ቤዞንታ ዓሼራ ጌይንታ ላኣሎ ፆኦዜሎ ማላቶንታ፥ ዒዚ ካኣሽካ ሜሌ ባካ ቢያ ፆኦሲ ማሊፆ ኬኤዛ ዓሶ ሃይሶ ማፃኣፓ ፃኣፒንቲ ዓኣኔ። <verse eid="2CH 33:19"/><verse number="20" style="v" sid="2CH 33:20"/>ጋፒንፃ ዒዚ ሃይቂ፥ ዒዛኮ ካኣቱሞ ማኣሮ ዓጫ ዓኣ ቤዛ ዱኡቴም ዒዛ ቤዛ ዒዛኮ ናኣዚ ዓሞኦኔ ካኣታዼኔ።<verse eid="2CH 33:20"/></para>
  <para style="s1">ዪሁዳ ካኣቲ ዓሞኦኔ</para>
  <para style="r">(<ref loc="2KI 21:19-26">2ካኣቶ. ማ 21፡19-26</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 33:21"/>ዓሞኦኔኮ ሌዓ ላማታሚ ላምዖ ማዓዛ ዪሁዳይዳ ካኣታዼኔ፤ ዒዚ ዬሩሳላሜይዳ ናንጊ ላምዖ ሌዔ ዎይሤኔ፤ <verse eid="2CH 33:21"/><verse number="22" style="v" sid="2CH 33:22"/>ዒዚ ፔ ዓዶ ሚናኣሴጉዲ ጎሜ ማዺ ናንጊና ናንጋ ጎዳ ዖዪሴኔ፤ ዒዛኮ ዓዴ ካኣሽካ ሜሌ ፆኦዞ ካኣሽኬኔ፤ ዔያቶም ዒንጎ ባኣዚያ ሺኢሼኔ። <verse eid="2CH 33:22"/><verse number="23" style="v" sid="2CH 33:23"/>ዓዴ ዒዛኮ ማዼ ጎይፆ ቢያ ፔና ሂርኪዲ ሼሌዑሞና ናንጊና ናንጋ ጎዳ ባንሢ ማዒፆ ሃሺ ዓዶይዳፓ ባሼ ጎሜ ማዼኔ።<verse eid="2CH 33:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 33:24"/>ዓሞኦኔኮ ዶንዞ ማዔ፥ ቢታንታ ዓኣ ዓሳ ዒዛም ዋይዞ ዒፂ ዒዛኮ ካኣቱሞ ማኣራ ዒዛ ዎዼኔ፤ <verse eid="2CH 33:24"/><verse number="25" style="v" sid="2CH 33:25"/>ዪሁዳ ዴራ ዒማና ዓሞኦኔ ዎዼ ዓሶ ዎዺ ዒዛ ቤዛ ናኣዚ ዒዛኮ ዒዮሲያሴ ካኣታሤኔ።<verse eid="2CH 33:25"/></para>
  <chapter eid="2CH 33"/>
  <chapter number="34" style="c" sid="2CH 34"/>
  <para style="s1">ዪሁዳ ካኣቲ ዒዮሲያሴ</para>
  <para style="r">(<ref loc="2KI 22:1-2">2ካኣቶ. ማ 22፡1-2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 34:1"/>ዒዮሲያሴ ዪሁዳይዳ ካኣታዻ ዎዶና ሌዓ ዒዛኮ ሳሊኬ፤ ዒዚ ዬሩሳላሜይዳ ናንጊ ሃይሢታሚ ፔቴ ሌዔ ዎይሤኔ። <note caller="-" style="x"><char style="xo" closed="false">34፡1 </char><char style="xt" closed="false"><ref loc="JER 3:6">ዔር. 3፡6</ref>።</char></note> <verse eid="2CH 34:1"/><verse number="2" style="v" sid="2CH 34:2"/>ዒዮሲያሴ ናንጊና ናንጋ ጎዳ ዎዛሳ ባኣዚ ማዼኔ፤ ዒዛኮ ማዔ፥ ካኣቲ ዳውቴ ማዼ ኮዦ ማዾ ማላቶጉዲ ማዺ ፆኦሲኮ ዎጎ ቢያ ዛጊ ካፔኔ።<verse eid="2CH 34:2"/></para>
  <para style="s1">ዒዮሲያሴ ሜሌ ፆኦዞ ካኣሽኮ ቤዞ ባይዜሢ</para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 34:3"/>ዒዮሲያሴ ካኣታዼ ሳላሳ ሌዖና ሃጊ ናይ ዓኣዖ ዒዛኮ ማዖ፥ ዳውቴ ፆኦዛሢ ካኣሽኪሢ ዓርቄኔ፤ ዖይዶ ሌዔኮ ጊንፃፓ ሜሌ ዓሳ ፔ ፆኦዞ ካኣሽካ ቤዞ፥ ዓሼራ ጌይንታ ላኣሎ ፆኦዜሎ ማላቶንታ ሜሌ ካኣሽኮ ፆኦዞ ቢያ ዬሩሳላሜና ዪሁዳናይዳፓ ባይዚሢ ዓርቄኔ፤ <verse eid="2CH 34:3"/><verse number="4" style="v" sid="2CH 34:4"/>ባዓኣሌ ጌይንታ ፆኦዞም ዒንጊ ካኣሽኮ ቤዞንታ ዬያ ኮራ ዓኣ ዑንጆ ጩቢሾ ቤዞዋ ዒ ዓይሤም ዒዛ ዓሳ ሜንሤኔ፤ ዓሼራ ጌይንታ ላኣሎ ፆኦዜሎ ማላሢና ሜሌ ካኣሽኮ ፆኦዞዋ ቢያ ሲላሊ ማዓንዳኣና ሜንሢ ጋኣጬኔ፤ ዬካፓ ዬያ ሲላሎ ዔኪ ዬያ ካኣሽኮ ባኮም ሚቺ ዒንጎ ዒንጊፆ ሺኢሻ ዓሶኮ ዱኡፖ ዑፃ ላኣሌኔ፤ <note caller="-" style="x"><char style="xo" closed="false">34፡4 </char><char style="xt" closed="false"><ref loc="2KI 21:3">2ካኣቶ. ማ 21፡3</ref>፤ <ref loc="2CH 33:3">2ፆኦሲ. ዓሃኬ 33፡3</ref>።</char></note> <verse eid="2CH 34:4"/><verse number="5" style="v" sid="2CH 34:5"/>ዒዮሲያሴ ሜሌ ዓሶ ቄኤሶኮ ሜጌፆ ቢያ ዔያታ ዚጊ ካኣሽካ ሜሌ ፆኦዞም ዒንጎ ባኮ ሺኢሾ ቤዞይዳ ሚቼኔ፤ ዬያ ቢያ ማዺፆና ዪሁዳና ዬሩሳላሜና ላሚ ጊንሣ ዳምቦና ጌኤሽካንዳጉዲ ማሄኔ፤ <note caller="-" style="x"><char style="xo" closed="false">34፡5 </char><char style="xt" closed="false"><ref loc="1KI 13:2">1ካኣቶ. ማ 13፡2</ref>።</char></note> <verse eid="2CH 34:5"/><verse number="6" style="v" sid="2CH 34:6"/>ኬዶ ዛሎና ዴንዲ ኒፕታኣሌኤሜ ሄላንዳኣና ዓኣ ሚናኣሴ፥ ዔፕሬኤሜና ሲሞኦኔና ዓጮይዳ ዓኣ ካታሞ፤ ዬያጉዲ ሃሣ ዒ ባይዜ ጉርዶይዳኣ ዒማ ጎይፆ ማዼኔ። <verse eid="2CH 34:6"/><verse number="7" style="v" sid="2CH 34:7"/>ዬያ ሌሊቱዋንቴ ዒስራዔኤሌ ዓጮ ጉቤይዳ ዓኣ ሜሌ ፆኦዞም ዒንጎ ባኮ ሺኢሾ ቤዞንታ ዓሼራኮ ማላቶዋ ቢያ ሜንሤኔ፤ ካኣዦም ኮሾና ሜሌ ፆኦዞዋ ሲላሊ ማዓንዳያ ሄላንዳኣና ጋኣጬኔ፤ ዑንጆ ጩቢሾ ቤዞንታ ሜሌ ፆኦዞም ዒንጎ ባኮ ሺኢሾ ቤዞዋ ሜንሢ ኬኤሬኔ፤ ዬያይዴስካፓ ዒ ዬሩሳላሜ ማዒ ዴንዴኔ።<verse eid="2CH 34:7"/></para>
  <para style="s1">ፆኦሲኮ ዎጎ ማፃኣፓ ጴዼሢ</para>
  <para style="r">(<ref loc="2KI 22:3-20">2ካኣቶ. ማ 22፡3-20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 34:8"/>ዒዮሲያሴ ካኣታዼንቴ ታጶ ሳላሳ ሌዖና ሜሌ ዓሶኮ ካኣዦ ባይዚ፥ ዓጬሎንታ ጌኤዦ ማኣሮንታ ጌኤሼስካፓ ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢኮ ዬያ ጌኤዦ ማኣሮ ዓካሲ ኮሻንዳጉዲ ዓፃሊያ ናኣዚ ሳፓኔና ዬሩሳላሜ ካታሞ ዎይሣያ ማዔ ማዕሴያና ዒዮዓሃዜ ናኣዚ ካታሞኮ ፃኣፓሢ ዮዓሄና ዳኬኔ፤ <verse eid="2CH 34:8"/><verse number="9" style="v" sid="2CH 34:9"/>ጌኤዦ ማኣሮ ካፓ ሌዊ ዓሳ ጌኤዦ ማኣሮይዳ ቡኩሴ ሚኢሻ ጉቤ ቄኤሶ ቢያሢኮ ዑፃሢ ሂልቂያም ዒንጊንቴኔ፤ ዬይ ሚኢሻ ቡኩሲንቴሢ ዔፕሬኤሜይዳፓ፥ ሚናኣሴና ሃንጎ ዒስራዔኤሌ ዴሮናፓ፤ ዬያጉዲ ሃሣ ዪሁዳይዳፓ፥ ቢኢኒያሜና ዬሩሳላሜ ዴሮናፓኬ፤ <verse eid="2CH 34:9"/><verse number="10" style="v" sid="2CH 34:10"/>ዬይ ሚኢሻ ጌኤዦ ማኣሮ ዓካሲ ኮሺሳ ሱኡጎ ማዔ ዬንሢ ሃይሦ ዓሶንሢም ዒንጊንቴኔ፤ ዔያታ ሃሣ ፔ ዛሎና ዬያ ሚኢሾ ማዾ ማዻ ዓሶና፥ <verse eid="2CH 34:10"/><verse number="11" style="v" sid="2CH 34:11"/>ዪሁዳ ካኣታ ሻሂሴ ሹጮና ማዦና ማኣሮ ማዦም ማዓንዳ ሹቺና ሚሢና ሻንቃንዳጉዲ ሚፆና ማኣሮ ማዣ ዓሶና ሹጮና ማዣ ዓሶም ዒንጌኔ፤ <verse eid="2CH 34:11"/><verse number="12" style="v" sid="2CH 34:12"/>ዬያ ማኣሮ ሚፆና ማዣ ዓሶና ሹጮና ማዣ ዓሳ ማዾ ጉሙርቂንታያ ማዒ ማዼኔ፤ ዬያ ዓሶ ዛጊ ማዺሻሢ ሜራሪ ቶኦካፓ፦ ያሃቴና ዖባዲያና፥ ቄዓቴ ቶኦካፓ ዛካሪያሴና ሜሹላሜ ጌይንታ ዖይዶ ሌዊ ዓሲኬ፤ [ሌዊ ዓሳ ቢያ ዓይኑሞ ዓንጋሞና ዓይናዻኒ ኮሺ ዔራቶ ዓኣ ዓሲኬ፤] <verse eid="2CH 34:12"/><verse number="13" style="v" sid="2CH 34:13"/>ሃንጎ ሌዊ ዓሳ ሜሆ ኬዳዞንሢና ዱማ ዱማ ማዾም ጌሢንቴ ማዻ ዓሶኮ ሱኡጎና ዛጊ ማዺሻ ዓሶ ማዓዛ፥ ዛላ ጊንሣ ዔኤቢ ፃኣፓያና ጌኤዦ ማኣሮ ካፓያናኬ።<verse eid="2CH 34:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 34:14"/>ዒንጊንቴ ሚኢሾ ጌሦ ማኣራፓ ኬሳ ዎዶና ቄኤሶ ቢያኮ ዑፃሢ ሂልቂያ ናንጊና ናንጋ ጎዳ ሙሴም ዒንጌ ፆኦሲኮ ዎጎ ማፃኣፖ ዴንቄኔ፤ <verse eid="2CH 34:14"/><verse number="15" style="v" sid="2CH 34:15"/>ዒዚ ዒማና ዔቦ ፃኣፓ፥ ሳፓኔም፦ «ናንጊና ናንጋ ጎዳኮ ዎጎ ማፃኣፖ ሃይካ ጌኤዦ ማኣራ ታ ዴንቄኔ» ጌይ ማፃኣፓሢ ዒንጌኔ፤ <verse eid="2CH 34:15"/><verse number="16" style="v" sid="2CH 34:16"/>ሳፓኔ ማፃኣፓሢ ዔካዖ ካኣቲም፦ «ኔ ኑና ዓይሤ ባኮ ቢያ ኑ ማዼኔ፤ <verse eid="2CH 34:16"/><verse number="17" style="v" sid="2CH 34:17"/>ጌኤዦ ማኣሮይዳ ጌሢንቲ ዓኣ ሚኢሾ ኑ ዔኪ ማዾ ማዻ ዓሶና ዔያቶ ዛጊ ማዺሻ ዓሶም ዒንጌኔ» ጌዔኔ፤ <verse eid="2CH 34:17"/><verse number="18" style="v" sid="2CH 34:18"/>ሃሣ ዒ ኬኤዛዖ፦ «ሂልቂያ ታኣም ዒንጌ ማፃኣፓሢ ሃይሾ ታ ኩጫ ዓኣኔ» ጌዒ፥ ማፃኣፓሢ ካኣቲም ናባቤኔ።<verse eid="2CH 34:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 34:19"/>ካኣቲ ዒማና ማፃኣፓ ዒዛም ናባቢንታሢ ዋይዛዖ ዖዪ ፔኤኮ ማኣዓሢ ዳርዜኔ፤ <verse eid="2CH 34:19"/><verse number="20" style="v" sid="2CH 34:20"/>ዬካፓ ሂልቂያም፥ ሳፓኔ ናኣዚ ዓሂቃም፥ ሚኪያሴ ናኣዚ ዓብዶኔም፥ ካኣቶ ማኣሮኮ ፃኣፓሢ ሳፓኔና ካኣቲም ማዻያ ማዔ ዓሳያም ካኣቲ ሂዚ ጌዒ ዓይሤኔ፦ <verse eid="2CH 34:20"/><verse number="21" style="v" sid="2CH 34:21"/>«ዴንዲጋፓ ታኣና፤ ዬያጉዲ ሃሣ ዒስራዔኤሌና ዪሁዳይዳ ዓቴ ዓሶ ዛሎ ናንጊና ናንጋ ጎዳ ዖኦጩዋቴ፤ ሃኖ ማፃኣፖይዳ ዓኣ ባኮዋ ዔሩዋቴ፤ ኑኡኮ ቤርታኣ ዓዶንሢ ናንጊና ናንጋ ጎዳ ቃኣሎም ዓይሢንቲፆ ዒፄሢሮ፥ ሃይ ማፃኣፓ ዔያቶ ማዾንጎ ጋዓ ባኮ ቢያ ዔያታ ማዺ ኩንሢባኣሢሮ ናንጊና ናንጋ ጎዳኮ ዻጋ ኑ ጊዳ ኬዴኔ።»<verse eid="2CH 34:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 34:22"/>ዬያሮ ሂልቂያና ዬኖ ዓሶና ካኣቲ ዔያቶ ዓይሤ ጎይፆ ዬሩሳላሜ ካታሞ ጉርዶኮ ፔቴዞይዳ ናንጋ ሁልዳ ጌይንታ ፆኦሲ ማሊፆ ኬኤዛዞ ኮራ ዴንዲ ዔያቶ ዳኮና ባኮ ዛሎ ዖኦጬኔ፤ ዬኖ ፆኦሲ ማሊፆ ኬኤዛዜሎኮ ዓናሢ ሻሉሜ ጌይንታ ቲቅዋ ናይ፥ ሃርሃሴኮ ናኣዚ ናይ ማዓዛ ዒዚ ጌኤዦ ማኣሮይዳ ማይንቶ ማኣዓሢ ካፓ ሱኡጋሢኬ፤ ዬንሢ ኪኢቶና ሙኬ ዓሶንሢ ዬኖ ፆኦሲ ማሊፆ ኬኤዛዞም ዔቦ ፓይዲ ፓይዲ ኬኤዜኔ፤ <verse eid="2CH 34:22"/><verse number="23" style="v" sid="2CH 34:23"/>ዒዛ ማሃዖ፦ «ታ ባንሢ ዒንሢ ዳኬ ካኣቲ ኮይላ ማዒ ዓኣዺጋፓ፥ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦሲ ጌዔ ባኮ ካኣቲም ኬኤዙዋቴ» ጌዔኔ። <verse eid="2CH 34:23"/><verse number="24" style="v" sid="2CH 34:24"/>ዬይ ፆኦሲ ኬኤዜ ባካ፦ «ዪሁዳ ካኣቲም ናባቢንቴ ማፃኣፖይዳ ዓኣ ጋዳሞ ዬሩሳላሜና ዴሮናይዳ ቢያ ታ ሄሊሳንዳኔ፤ <verse eid="2CH 34:24"/><verse number="25" style="v" sid="2CH 34:25"/>ዔያታ ታና ሃሺ ሜሌ ፆኦዞም ዒንጎ ባኮ ሺኢሼኔ፤ ዬይ ዔያታ ማዼ ዻቢንታ ዻጎ ታኣኮ ዔቂሴኔ፤ ዓካሪ ዬሩሳላሜይዳ ታኣኮ ዔቄ ዻጋ ማዺንቲ ኩማንዳፓኣዓቴም ሺሚንዱዋሴ፤ <verse eid="2CH 34:25"/><verse number="26" style="v" sid="2CH 34:26"/>ዬያሮ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ካኣቲም ሂዚ ጋዓኔ፦ ‹ኔኤኒ ዬያ ማፃኣፖይዳ ኬኤዚንቴ ቃኣሎ ዋይዜኔ፤ <verse eid="2CH 34:26"/><verse number="27" style="v" sid="2CH 34:27"/>ታኣኒ ዬሩሳላሜና ዒዞኮ ዴሮዋ ዎዲ ባይዛንዳቴያ ኔ ዋይዜ ዎዶና ኔ ቶኦኮ ሂርኪዲ ዖዪ፥ ማኣዓሢ ኔኤኮ ዳርዚ፥ ዬኤኪ ጎሞ ኔኤኮ ኔ ቡኡፄኔ፤ ዬያሮ ታ ኔኤኮ ሺኢጲፆ ዋይዜኔ። <verse eid="2CH 34:27"/><verse number="28" style="v" sid="2CH 34:28"/>ዓካሪ ኔኤኒ ሼምፔና ዓኣንቴ ታኣኒ ዬሩሳላሜይዳ ሜቶ ሄሊሳዓኬ፤ ኔ ኮሺና ሃይቃንዳጉዲ ታ ማሃንዳኔ› ጋዓኔ ጎዑዋቴ» ጋዓያኬ።</para>
  <para style="p" vid="2CH 34:28">ዬያሮ ዬንሢ ኪኢቶ ዓሶንሢ ዬያ ኪኢቶ ዋይዚ ካኣቲ ዒዮሲያሴ ባንሢ ማዔኔ።<verse eid="2CH 34:28"/></para>
  <para style="s1">ዒዮሲያሴ ናንጊና ናንጋ ጎዳም ዓይሢንታኒ ጫኣቄሢ</para>
  <para style="r">(<ref loc="2KI 23:1-20">2ካኣቶ. ማ 23፡1-20</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 34:29"/>ካኣቲ ዒዮሲያሴ ዪሁዳና ዬሩሳላሜናኮ ዔርቴ ጋርቾ ቢያ ዔኤሊሲ ፔቴይዳ ቡኩሴኔ፤ <verse eid="2CH 34:29"/><verse number="30" style="v" sid="2CH 34:30"/>ዬያ ዔኤሊንቴ ዓሶንታ ካኣቲንታ ቄኤሶ፥ ሌዊ ዓሶ፤ ሃንጎ ዴሮ ጌይፃ፦ ዖርጎጮንታ ማንቆንታ ቢያ ዎላ ዔኪ ጌኤዦ ማኣሪ ዓኣዼኔ፤ ዒኢካ ቤርታ ባይቄዖ ጴዼ፥ ዴራ ናንጊና ናንጋ ጎዳና ዎላ ጫኣቄ ማፃኣፖይዳ ፃኣፒንቴ ባኮ ጉቤ ዴሮም ካኣቲ ናባቤኔ፤ <verse eid="2CH 34:30"/><verse number="31" style="v" sid="2CH 34:31"/>ካኣቲ ዒማና ቱርቱራሢ ኮይላ ዔቃዖ ጉቤ ዒኔና ማሊሢና ናንጊና ናንጋ ጎዳ ጎይፆ ሃንታኒና ዓይሢፆ ዒዛኮ ካፓኒ፤ ሃሣ ዬያ ማፃኣፖይዳ ፃኣፒንቴ ጫኣቁሞ ዓይሢንቲ ኩንሣኒ ናንጊና ናንጋ ጎዳ ቤርታ ዬያ ጫኣቁሞ ጊንሣ ዓካሴኔ። <verse eid="2CH 34:31"/><verse number="32" style="v" sid="2CH 34:32"/>ዬካፓ ቢኢኒያሜ ዴሮና ዬሩሳላሜ ሙኬ ሃንጎ ዓሳ ቢያ ፆኦሲና ጫኣቄ ጫኣቁሞ ካፓንዳጉዲ ጫኣቂሴኔ፤ ዬያይዲ ዬሩሳላሜ ዴራ ዔያቶኮ ቤርታኣ ዓዶንሢኮ ፆኦዛሢና ዎላ ዔያታ ጫኣቄ ጫኣቁማ ዔያቶ ማዻንዳጉዲ ጋዓ ባኮ ቢያ ዔያታ ማዺ ኩንሤኔ፤ <verse eid="2CH 34:32"/><verse number="33" style="v" sid="2CH 34:33"/>ካኣቲ ዒዮሲያሴ ዒስራዔኤሌ ዓጫ ዓኣ ሻኣካ፥ ካኣሽኮ ባኮ ቢያ ባይዚ ዴራ ናንጊና ናንጋ ጎዳ ማዔ ዔያቶኮ ፆኦዛሢም ማዻንዳጉዲ ማሄኔ፤ ዬያ ሌሊቱዋንቴ ዒ ካኣታዺ ዓኣ ዎዶና ቢያ ዴራ ናንጊና ናንጋ ጎዳ ማዔ ዔያቶኮ ቤርታኣ ዓዶንሢ ፆኦዛሢ ሃሺ ሺኢኪባኣሴ።<verse eid="2CH 34:33"/></para>
  <chapter eid="2CH 34"/>
  <chapter number="35" style="c" sid="2CH 35"/>
  <para style="s1">ዒዮሲያሴ ዑሣ ዓኣዺፆ ቦንቾ ኬሎ ቦንቼሢ</para>
  <para style="r">(<ref loc="2KI 23:21-23">2ካኣቶ. ማ 23፡21-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 35:1"/>ካኣቲ ዒዮሲያሴ ናንጊና ናንጋ ጎዳ ቦንቾም ዑሣ ዓኣዺፆ ቦንቾ ኬሎ ዬሩሳላሜይዳ ቦንቼኔ፤ ቤርታሳ ዓጊና ፄኤሬንቴ ታጶ ዖይዳሳ ኬሎና ዴራ ዑሣ ዓኣዺፆ ቦንቾ ኬሎም ሹኮ ማራቶ ሹኬኔ፤ <verse eid="2CH 35:1"/><verse number="2" style="v" sid="2CH 35:2"/>ቄኤሳ ጌኤዦ ማኣሮይዳ ማዻ ማዾ ኮይሳሢጉዲ ኬላ ኬላ ማዾም ካኣቲ ዔያቶ ዶዲሼኔ፤ <verse eid="2CH 35:2"/><verse number="3" style="v" sid="2CH 35:3"/>ዬያጉዲ ሃሣ ፔና ናንጊና ናንጋ ጎዳም ዱማሴ፥ ዒስራዔኤሌ ዓሶ ጉቤሢኮ ዔርዛዞንሢ ማዔ ሌዊ ዓሶም፦ «ናንጊና ናንጋ ጎዳም ዱማዼ ጫኣቁሞ ሳኣፂኖ ዳውቴ ናኣዚ ካኣቲ ሴሎሞኔ ማዢሴ ጌኤዦ ማኣሮይዳ ጌሡዋቴ፤ ሃካፓ ሴካ ዒንሢያ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢና ዒዛኮ ዴሮ ዒስራዔኤሌ ዓሶም ማዻንዳኣፓዓቴም ጫኣቁሞ ሳኣፂኖ ዒንሢኮ ጌኤታ ኬዲ ፔቴ ቤዛፓ ሜሌ ቤሲ ዔኪ ዓኣዻንዳያ ኮይሱዋሴ፤ <verse eid="2CH 35:3"/><verse number="4" style="v" sid="2CH 35:4"/>ካኣቲ ዳውቴና ዒዛኮ ናኣዚ፥ ካኣቲ ሴሎሞኔ ዒንሢ ዓይሤ ጎይፆና ቶኦኮና ቶኦኮና ማዒ ጌኤዦ ማኣሮይዳ ዒንሢኮ ማዾ ቤዞ ቤዞ ዓርቁዋቴ፤ <note caller="-" style="x"><char style="xo" closed="false">35፡4 </char><char style="xt" closed="false"><ref loc="2CH 8:14">2ፆኦሲ. ዓሃኬ 8፡14</ref>።</char></note> <verse eid="2CH 35:4"/><verse number="5" style="v" sid="2CH 35:5"/>ዒንሢ ሌዊ ዓሳ፦ ፔቴ ፔቴ ዒስራዔኤሌ ዓሶ ማኣሮ ማኣሮ ማኣዳኒ ፓቂንቲ ፓቂንቲ ናንጊና ናንጋ ጎዳም ዱማዼ ቤዞይዳ ዒንሢ ቤዛ ቤዛ ዒንሢ ጊኢጊሹዋቴ። <verse eid="2CH 35:5"/><verse number="6" style="v" sid="2CH 35:6"/>ዒንሢኮ ዒጊኖ ማዔ ዒስራዔኤሌ ዓሶም ናንጊና ናንጋ ጎዳ ሙሴ ዛሎና ዒንጌ ዳምቦ ዛጊ ዔያታ ማዻንዳጉዲ ዎጎ ጎይፆና ዒንሢ ቶኦኮ ጌኤሺጋፓ ዑሣ ዓኣዺፆ ቦንቾ ኬሎም ሹኮ ማራቶ ሹኩዋቴ» ጌይ ዓይሤኔ።<verse eid="2CH 35:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 35:7"/>ካኣቲ ዒዮሲያሴ ዒማና ዬኖ ዑሣ ዓኣዺፆ ቦንቾ ኬሎይዳ ሙኬ ዓሳ ናንጊና ናንጋ ጎዳም ዒንጊሢ ማሂ ሺኢሻንዳጉዲ ፔ ቆሎ ማዔ ባኣቶይዳፓ፤ ዬያጉዲ ሃሣ ማራቶና ዋኣሮናፓ ሃይሢታሚ ሺያ ዓዴ ማራናይና ኮላናይና፥ ሃይሦ ሺያ ዚያ ጌማይ ዒንጌኔ፤ <verse eid="2CH 35:7"/><verse number="8" style="v" sid="2CH 35:8"/>ካኣቲኮ ዶንዞ ማዔ ቢታንታ ዓኣ ዓሳ ናንጊና ናንጋ ጎዳም ዒንጎያ ማሂ ሺኢሾ ቆልሞ ዔያታ ፔ ሼኔና ናሽኪ ፆኦሲ ጉሙርቃ ዓሶም፥ ቄኤሶና ሌዊ ዓሶናም ዒንጌኔ፤ ሃሣ ጌኤዦ ማኣሮኮ ሱኡጎ ማዔ ቄኤሶ ቢያኮ ዑፃሢ ሂልቂያ፥ ዛካሪያሴንታ ዪሂዔኤሌንታ ዑሣ ዓኣዺፆ ቦንቾ ኬሎና ዒንጎ ዒንጊሢ ማሂ ሺኢካንዳ ላምዖ ሺያና ላሆ ፄኤታ ማራናይ ዓዴና ኮላናይና፤ ሃይሦ ፄኤታ ዚያ ጌማይና ቄኤሶም ዒንጌኔ። <verse eid="2CH 35:8"/><verse number="9" style="v" sid="2CH 35:9"/>ሌዊ ዓሶኮ ሱኡጎ ማዔ ኮናኒያና ዒዛኮ ጌርሲንሢ ሼማዒያና ኔታኒዔኤሌና፤ ዬያጉዲ ሃሣ ሃሻቢያ፥ ዪዒዔኤሌንታ ዮዛባዴንታ ሌዊ ዓሳ ዑሣ ዓኣዺፆ ቦንቾ ኬሎና ዒንጊፆ ማሂ ሺኢሾንዶ ዶንጎ ሺያ ማራናይ ዓዴና ኮላናይና፤ ዬያጉዲ ሃሣ ዶንጎ ፄኤታ ዚያ ጌማይ ዒንጌኔ።<verse eid="2CH 35:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 35:10"/>ዑሣ ዓኣዺፆ ቦንቾ ኬሎም ማዓ ባካ ጊኢጊንቴስካፓ ቄኤሶና ሌዊ ዓሶና ካኣቲ ዓይሤ ጎይፆ ዔያታ ፔኤኮ ማዻ ቤዞ ቤዞ ዓርቄኔ፤ <verse eid="2CH 35:10"/><verse number="11" style="v" sid="2CH 35:11"/>ዑሣ ዓኣዺፆ ቦንቾ ኬሎም ሹኪንቴ ማራናኣቶ ዓዶና ኮላናኣቶናኮ ዒልዖ ሌዊ ዓሳ ሹኪ ኬሳዛ፥ ቄኤሳ ሱጉፆ ፆኦሲም ዒንጎ ባኮ ሺኢሾሢ ዑፃ ፑጬኔ፤ <verse eid="2CH 35:11"/><verse number="12" style="v" sid="2CH 35:12"/>ሚቺ ዒንጎ ዒንጊፆም ዒንጊንቴ ቆልሞ ማኣሮ ዓሶና ዓሶና ፓቂንቴ ዴሮም ዔያታ ጊሽኬኔ፤ ዬያ ዔያታ ማዼሢ ሙሴ ዔርዜ ዎጎይዳ ዓይሢንቴ ጎይፆና ዒንጎ ዒንጊፆ ዓሳ ሺኢሻንዳጉዲኬ፤ ዚዮ ጌማቶዋ ዔያታ ዒማይዴኔ፤ <verse eid="2CH 35:12"/><verse number="13" style="v" sid="2CH 35:13"/>ሌዊ ዓሳ ዎጎ ዓይሢፆ ጎይፆና ዑሣ ዓኣዺፆ ቦንቾ ኬሎና ዒንጊንታ ባኮ ታሚዳ ሚቼኔ፤ ፆኦሲም ዱማዼ ዒንጊፆ ዼኤፒ ዖቲና፥ ሳኣሚ ዖቲና ዻካ ዖቲናይዳ ካሢ ቤዞማና ዴሮም ጊሽኬኔ፤ <note caller="-" style="x"><char style="xo" closed="false">35፡13 </char><char style="xt" closed="false"><ref loc="EXO 12:8-9">ኬሲ. ማፃ 12፡8-9</ref>።</char></note> <verse eid="2CH 35:13"/><verse number="14" style="v" sid="2CH 35:14"/>ዬካፓ ሌዊ ዓሳ ፔኤም፥ ሃሣ ዓኣሮኔ ዜርፆ ማዔ ቄኤሶም ዑሣ ዓኣዺፆ ቦንቾ ኬሎ ዒንጎ ዒንጊፆ ጊኢጊሼኔ፤ ዓይጎሮ ጌዔቴ ቄኤሳ ሚቺ ዒንጎ ዒንጊፆና ማሎና ጉቤ ዴንዲ ሳዓ ዓማንዳኣና ሚቺ ዒንጋሢሮኬ፤ <verse eid="2CH 35:14"/><verse number="15" style="v" sid="2CH 35:15"/>ሃካፓ ዴማ ሱንፃ ፃኣፒንቲ ዓኣ ሌዊ ዓሢ ዓሳኣፔ ቶኦኪ ማዔ፥ ናንጊና ናንጋ ጎዳ ቦንቾም ዓይኑሞ ዓይናዻዞንሢ ካኣቲ ዳውቴ ዓይሤ ዳምቦ ጎይፆ ዔያታ ማዻንዳጉዲ ጌሦና ቤዛ ዓኣኔ፤ ዬንሢያ፦ ዓሳኣፔ፥ ሄማኔንታ ካኣቲም ፆኦሲ ማሊፆ ኬኤዛ ዪዱታኔንታኬ፤ ሃንጎ ሌዊ ዓሳ ዑሣ ዓኣዺፆ ቦንቾ ኬሎም ዒንጎ ዒንጊፆ ዔያቶም ጊኢጊሻያ ማዔሢሮ ጌኤዦ ማኣሮ ካሮ ካፓ ዓሳ ዔያታ ካፓ ቤዛፓ ሺኢኩዋሴ፤ <note caller="-" style="x"><char style="xo" closed="false">35፡15 </char><char style="xt" closed="false"><ref loc="1CH 25:1">1ፆኦሲ. ዓሃኬ 25፡1</ref>።</char></note> <verse eid="2CH 35:15"/><verse number="16" style="v" sid="2CH 35:16"/>ዬያይዲ ናንጊና ናንጋ ጎዳ ካኣሽኮ ካኣዦ ዳምቦና ዑሣ ዓኣዺፆ ቦንቾ ኬሎና ሚቺ ዒንጎ ዒንጊፆ ዒንጎ ቤዞይዳ ሺኢሺፆ ማዻ ቢያ ካኣቲ ዒዮሲያሴ ዓይሤ ጎይፆ ዬኖ ኬሎ ማዺንቴኔ። <verse eid="2CH 35:16"/><verse number="17" style="v" sid="2CH 35:17"/>ዒማና ዒኢካ ዓኣ ዒስራዔኤሌ ዴራ ቢያ ዑሣ ዓኣዺፆ ቦንቾ ኬሎ ቦንቼኔ፤ ዬያጉዲ ሃሣ ላንካይ ኬሊ ላኣዶ ሙዒ ቦንቾ ቦንቾዋ ቦንቼኔ፤ <note caller="-" style="x"><char style="xo" closed="false">35፡17 </char><char style="xt" closed="false"><ref loc="EXO 12:1-20">ኬሲ. ማፃ 12፡1-20</ref>።</char></note> <verse eid="2CH 35:17"/><verse number="18" style="v" sid="2CH 35:18"/>ፆኦሲ ማሊፆ ኬኤዛ ሳሙዔኤሌ ዎዳፓ ዓርቃዖ ዑሣ ዓኣዺፆ ኬላ ዬያይዲ ቦንቺንቲ ቤቂባኣሴ፤ ካኣቲ ዒዮሲያሴ፥ ቄኤሳ፥ ሌዊ ዓሳ፥ ዒስራዔኤሌንታ ዪሁዳንታ ዬሩሳላሜንታይዳ ናንጋ ዴሮና ዑሣ ዓኣዺፆ ቦንቾ ኬሎ ቦንቼሢጉዲ ዬያኮ ቤርታ ካኣታዼ ካኣቶይዳ ቦንቼ ካኣቲ ፔቴታዖ ባኣሴ፤ <verse eid="2CH 35:18"/><verse number="19" style="v" sid="2CH 35:19"/>ዬይ ቦንቾ ኬላ ቦንቺንቴሢ ዒዮሲያሴ ካኣታዼንቴ ታጶ ሳላሳ ሌዖናኬ።<verse eid="2CH 35:19"/></para>
  <para style="s1">ዒዮሲያሴ ካኣቱሞኮ ጋፖ</para>
  <para style="r">(<ref loc="2KI 23:28-30">2ካኣቶ. ማ 23፡28-30</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 35:20"/>ካኣቲ ዒዮሲያሴ ጌኤዦ ማኣሮም ዬያ ቢያ ጊኢጊሺ ዶዲሼስካፓ ጊብፄ ካኣቲ ኒካዑ ዔፕራፂሴ ዎሮ ዓጫ ዓኣ ካርካሚሼ ጌይንታ ቤዛ ዖላኒ ዖሎ ዓሶ ዔኪ ሙካዛ፥ ዒዮሲያሴ ዒማና ዔያቶ ዖሊ ማሃኒ ኬስኬኔ፤ <verse eid="2CH 35:20"/><verse number="21" style="v" sid="2CH 35:21"/>ኒካዑ ጋዓንቴ ዒዮሲያሴም፦ «ዪሁዳ ካኣቲዮ! ኔኤና ታኣና ዑራሳንዳ ዓይጎ ባኣዚያ ባኣሴ! ታኣኒ ሙኬሢ ታኣኮ ሞርኮ ዖላኒ ማዓንዳፓዓቴም ኔና ዖላኒቱዋሴ፤ ታኣኒ ታ ሞርኮ ሩኡሪና ዖላንዳጉዲ ፆኦሲ ታና ዓይሤኔ፤ ፆኦሲ ታኣና ዎላታሢሮ ኔ ታና ማኪባኣቴ ቃራኬ፤ ኔ ዒፄቶ ጋዓንቴ ፆኦሲ ኔና ባይዛንዳኣኬ!» ጋዓ ኪኢታ ዒዮሲያሴም ዳኬኔ፤ <verse eid="2CH 35:21"/><verse number="22" style="v" sid="2CH 35:22"/>ዒዮሲያሴ ጋዓንቴ ዖሎ ዒዛና ዓርቃኒ ቱኡቲ ዔቄኔ፤ ፆኦሲ ካኣቲ ኒካዑ ዛሎና ኬኤዜሢ ዒ ዋይዛኒ ኮዒባኣሴ፤ ካኣቱሞ ማኣዓሢ ላኣሚ ሜሌ ዓሲ ማሊ ሜጌዶይዳ ዓኣ ቦኦላ ዖልታኒ ዓኣዼኔ።<verse eid="2CH 35:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 35:23"/>ዒማና ዖላ ኮሺ ዶዳዛ ካኣቲ ዒዮሲያሴ ጊብፄ ዓጮ ፖኦሊሳ ሂኢሺና ዱኬኔ፤ ዬያሮ ዒዚ ፔኤኮ ዖሎ ዓሶ ዓይሣ ዓሶም፦ «ታና ዱኪ ማኣሳንሦናሢሮ ዖሎ ቤዛፓ ታና ኬሱዋቴ!» ጌዔኔ፤ <verse eid="2CH 35:23"/><verse number="24" style="v" sid="2CH 35:24"/>ዔያታ ዒማና ዒዛኮ ሳርጌሎ ዖይታፓ ዒዛ ኬይሲ ዒኢካ ዓኣ ሜሌ ሳርጌላ ዖይታይዳ ዴይሢ ዬሩሳላሜ ዔኪ ዴንዳዛ ዒኢካ ዒ ሃይቂ፥ ካኣታ ዱኡታ ቤዛ ዱኡቴኔ፤ ዪሁዳና ዬሩሳላሜና ዴራ ቢያ ዒዛ ዬኤኬኔ።<verse eid="2CH 35:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 35:25"/>ዒማና ፆኦሲ ማሊፆ ኬኤዛ ዔርሚያሴ ካኣቲ ዒዮሲያሴ ሚጪንቲ ቃዬኔ፤ ዬያሮ ቃዮ ቃያ ላኣሎንታ ዓቲንቆንታ ዒዮሲያሴ ማሊ ዬኤካ ዎዶና ዬኖ ዔርሚያሴ ቃዬ ቃዬሎና ቃዪ ዬኤኪፃ ዒስራዔኤሌ ዓጮይዳ ዔርቴያ ማዔኔ፤ ዬይ ቃያሢ ዒስራዔኤሌ ዓሶኮ ሜታሢ ዬኤፖ ማፃኣፖይዳ ፃኣፒንቲ ዓኣኔ።<verse eid="2CH 35:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 35:26"/>ዒዮሲያሴ ማዼ ሜሌ ባካ ቢያ ናንጊና ናንጋ ጎዳ ዛሎ ዒዛኮ ዓኣ ዼኤፖ ናሹማ፤ ፆኦሲ ዎጎም ዓኣ ዔኤዒ ዓይሢንቲፃ፥ <verse eid="2CH 35:26"/><verse number="27" style="v" sid="2CH 35:27"/>ዓይፃፓ ጋፖ ሄላንዳኣና ዒዛ ሃይሳ ዓቱዋዖ ዒስራዔኤሌና ዪሁዳናኮ ካኣቶ ሃይሶ ማፃኣፖይዳ ፃኣፒንቲ ዓኣኔ።<verse eid="2CH 35:27"/></para>
  <chapter eid="2CH 35"/>
  <chapter number="36" style="c" sid="2CH 36"/>
  <para style="s1">ዪሁዳ ካኣቲ ዒዮዓሃዜ</para>
  <para style="r">(<ref loc="2KI 23:30-35">2ካኣቶ. ማ 23፡30-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 36:1"/>ዪሁዳ ዓሳ ዒዮሲያሴ ናኣዚ ዒዮዓሃዜ ዶኦሪ ዓዶ ቤዛ ዬሩሳላሜይዳ ካኣታሤኔ፤ <verse eid="2CH 36:1"/><verse number="2" style="v" sid="2CH 36:2"/>ዒዮዓሃዜ ዪሁዳይዳ ካኣታዻኣና ሌዓ ዒዛኮ ላማታሚ ሃይሦኬ፤ ዒዚ ዬሩሳላሜይዳ ናንጊ ሃይሦ ዓጊኒ ዎይሤኔ። <verse eid="2CH 36:2"/><verse number="3" style="v" sid="2CH 36:3"/>ዬካፓ ጊብፄ ካኣቲ ኒካዑ ዒዮዓሃዜ ካኣቱማፓ ኬይሲ ቱኡሲ ዓሲ ማሂ ዔኪ ዓኣዼኔ፤ ዒማና ዒዚ ዪሁዳ ዓሳ ሃይሦ ሺያና ዖይዶ ፄኤታ ኪሎ ማዓ ቢራና ሃይሢታሚ ዖይዶ ኪሎ ማዓ ዎርቄና ጊኢራንዳጉዲ ጊኢራ ዓጌኔ። <verse eid="2CH 36:3"/><verse number="4" style="v" sid="2CH 36:4"/>ጊንሣ ኒካዑ ዒዮዓሃዜኮ ጌርሲ ዔሊያቂሜ ዪሁዳና ዬሩሳላሜናይዳ ካኣታሢ ሱንፆ ዒዛኮ ዒዮዓቄሜ ጌይ ላኣሚ ጌሤኔ፤ ጋዓንቴ ዒዮዓሃዜ ዒዚ ቱኡሲ ዓሲ ማሂ ጊብፄ ዔኪ ዓኣዼኔ። <note caller="-" style="x"><char style="xo" closed="false">36፡4 </char><char style="xt" closed="false"><ref loc="JER 22:11-12">ዔር. 22፡11-12</ref>።</char></note><verse eid="2CH 36:4"/></para>
  <para style="s1">ዪሁዳ ካኣቲ ዒዮዓቄሜ</para>
  <para style="r">(<ref loc="2KI 23:36-24:7">2ካኣቶ. ማ 23፡36—24፡7</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 36:5"/>ዒዮዓቄሜ ዪሁዳይዳ ካኣታዻኣና ሌዓ ዒዛኮ ላማታሚ ዶንጎኬ፤ ዒዚ ዬሩሳላሜይዳ ናንጊ ታጶ ፔቴ ሌዔ ዎይሤኔ፤ ዒዚ ጎሜ ማዺ ናንጊና ናንጋ ጎዳ ማዔ ዒዛኮ ፆኦዛሢ ዖዪሴኔ፤<note caller="-" style="x"><char style="xo" closed="false">36፡5 </char><char style="xt" closed="false"><ref loc="JER 22:18-19">ዔር. 22፡18-19</ref>፤ <ref loc="JER 26:1-6">26፡1-6</ref>፤ <ref loc="JER 35:1-19">35፡1-19</ref>።</char></note> <verse eid="2CH 36:5"/><verse number="6" style="v" sid="2CH 36:6"/>ዬካፓ ባብሎኔ ካኣቲ ናብካዳናፆኦሬ ዪሁዳ ዓጮ ዖላኒ ኬስኬኔ፤ ዒዚ ዒዮዓቄሜ ዖሎና ባሺ ሞኦና ዓንጊፓ ኮሾና ካኒ ቢራታና ቱኪ ዔኪ ባብሎኔ ዓጮ ዓኣዼኔ።<note caller="-" style="x"><char style="xo" closed="false">36፡6 </char><char style="xt" closed="false"><ref loc="JER 25:1-38">ዔር. 25፡1-38</ref>፤ <ref loc="JER 36:1-32">36፡1-32</ref>፤ <ref loc="JER 45:1-5">45፡1-5</ref>፤ <ref loc="DAN 1:1-2">ዳኣኔ. 1፡1-2</ref>።</char></note> <verse eid="2CH 36:6"/><verse number="7" style="v" sid="2CH 36:7"/>ናብካዳናፆኦሬ ዒማና ጌኤዦ ማኣሮኮ ሜሆ ቡሪ ዔኪ ባብሎኔይዳ ፔኤኮ ፆኦዞ ካኣሽኮ ማኣራ ጌሤኔ፤ <verse eid="2CH 36:7"/><verse number="8" style="v" sid="2CH 36:8"/>ካኣቲ ዒዮዓቄሜ ማዼ ባካ ቢያ፥ ሻኣካያ ማዔ ዒዛኮ ማዾና ዒ ማዼ ፑርቶ ባካ ቢያ፥ ዒስራዔኤሌና ዪሁዳ ካኣቶና ሃይሶ ማፃኣፓ ፃኣፒንቲ ዓኣኔ፤ ዒዛ ቤዛ ናኣዚ ዒዛኮ ዮዓኪኔ ካኣታዼኔ።<verse eid="2CH 36:8"/></para>
  <para style="s1">ዪሁዳ ካኣቲ ዮዓኪኔ</para>
  <para style="r">(<ref loc="2KI 24:8-17">2ካኣቶ. ማ 24፡8-17</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 36:9"/>ዮዓኪኔ ዪሁዳይዳ ካኣታዻኣና ሌዓ ዒዛኮ ታጶ ሳሊኬ፤ ዒዚ ዬሩሳላሜይዳ ናንጊ ሃይሦ ዓጊኒና ታጶ ኬሊና ዎይሤኔ፤ ዬካፓ ዒዚ ጎሜ ማዺ ናንጊና ናንጋ ጎዳ ዖዪሴኔ። <verse eid="2CH 36:9"/><verse number="10" style="v" sid="2CH 36:10"/>ሲሎ ዓጊና ሄላዛ ካኣቲ ናብካዳናፆኦሬ ዮዓኪኔ ቱኡሲ ዓሲ ማሂ ባብሎኔ ዔኪ ዓኣዼኔ፤ ዬያ ሌሊቱዋንቴ ጌኤዦ ማኣሮኮዋ ሜሆ ቡሪ ዔኪ ዴንዴኔ፤ ዬካፓ ዮዓኪኔኮ ጌርሲ<note caller="+" style="f"><char style="fr" closed="false">36፡10 </char><char style="fq" closed="false">ጌርሲ </char><char style="ft" closed="false">ጋዓዛ፦ ዔብሬ ዓሶ ሙኡጮ ማፃኣፖይዳ ዓዶ ዒሾ ሃንጎ ዓዶ ጌኤዚ ማዓኒያ ዳንዳዓያኬ።</char></note> ሴዴቂያሴ ዪሁዳና ዬሩሳላሜናይዳ ዒ ካኣታሤኔ። <note caller="-" style="x"><char style="xo" closed="false">36፡10 </char><char style="xt" closed="false"><ref loc="JER 22:24-30">ዔር. 22፡24-30</ref>፤ <ref loc="JER 24:1-10">24፡1-10</ref>፤ <ref loc="JER 29:1-2">29፡1-2</ref>፤ <ref loc="JER 37:1">37፡1</ref>፤ <ref loc="EZK 17:12-13">ሂዚ. 17፡12-13</ref>።</char></note><verse eid="2CH 36:10"/></para>
  <para style="s1">ዪሁዳ ካኣቲ ሴዴቂያሴ</para>
  <para style="r">(<ref loc="2KI 24:18-20">2ካኣቶ. ማ 24፡18-20</ref>፤ <ref loc="JER 52:1-3">ዔር. 52፡1-3</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 36:11"/>ሴዴቂያሴ ዪሁዳይዳ ካኣታዻኣና ሌዓ ዒዛኮ ላማታሚ ፔቴኬ፤ ዒዚ ዬሩሳላሜይዳ ናንጊ ታጶ ፔቴ ሌዔ ዎይሤኔ፤ <note caller="-" style="x"><char style="xo" closed="false">36፡11 </char><char style="xt" closed="false"><ref loc="JER 27:1-22">ዔር. 27፡1-22</ref>፤ <ref loc="JER 28:1-17">28፡1-17</ref>።</char></note> <verse eid="2CH 36:11"/><verse number="12" style="v" sid="2CH 36:12"/>ዒዚያ ጎሜ ማዺ ናንጊና ናንጋ ጎዳ ማዔ ዒዛኮ ፆኦሲ ዖዪሴኔ፤ ሃሣ ፆኦሲ ማሊፆ ኬኤዛ ዔርሚያሴማኣ ሼሌዑሞና ዋይዚባኣሴ።<verse eid="2CH 36:12"/></para>
  <para style="s1">ዬሩሳላሜኮ ዶዒፆ</para>
  <para style="r">(<ref loc="2KI 25:1-21">2ካኣቶ. ማ 25፡1-21</ref>፤ <ref loc="JER 52:3-11">ዔር. 52፡3-11</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 36:13"/>ሴዴቂያሴ ዒዛም ጉሙርቂንታያ ማዓንዳጉዲ ፆኦሲ ሱንፆና ጫኣቂሴ ካኣቲ ናብካዳናፆኦሬም ዋይዞ ዒፄኔ፤ ዒዚ ጎሞ ቡኡፂ ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ባንሢ ማዒፆዋ ሃሺ ዒኖ ዶዲሺ ዒፄኔ። <note caller="-" style="x"><char style="xo" closed="false">36፡13 </char><char style="xt" closed="false"><ref loc="EZK 17:15">ሂዚ. 17፡15</ref>።</char></note> <verse eid="2CH 36:13"/><verse number="14" style="v" sid="2CH 36:14"/>ቃሲ ሃሣ ቄኤሶኮ ሱኡጎና ዴራኣ ሜሌ ፆኦዞ ካኣሽኪፆና ዔያቶኮ ኮይላ ዓኣ ሜሌ ዴሮኮ ፑርቶ ማዾ ማላቶ ዔኬኔ፤ ናንጊና ናንጋ ጎዳ ፔኤሮ ዱማሴ ጌኤዦ ማኣሮዋ ዔያታ ዒኢሴኔ፤ <verse eid="2CH 36:14"/><verse number="15" style="v" sid="2CH 36:15"/>ያዺ ማዔቴያ ናንጊና ናንጋ ጎዳ ማዔ ዔያቶኮ ቤርታኣ ዓዶንሢ ፆኦዛሢ ፔ ዴሮና ፔኤኮ ጌኤዦ ማኣሮና ባይሲንታፓ ዓይሳኒ ኮዔሢሮ ዔያቶም ላቲ ኬኤዞም ዒዛ ማሊፆ ኬኤዛ ዓሶ ዳኪፆ ሃሺባኣሴ። <verse eid="2CH 36:15"/><verse number="16" style="v" sid="2CH 36:16"/>ዒስራዔኤሌ ዴራ ጋዓንቴ ፆኦሲኮ ኪኢቶ ዓሶይዳ ዓማሌኔ፤ ዒዛ ማሊፆ ኬኤዛ ዓሶዋ ቦሂ፥ ናንጊና ናንጋ ጎዳኮ ቃኣሎዋ ዻካ ባኣዚ ማሄኔ፤ ዬያሮ ናንጊና ናንጋ ጎዳኮ ዻጋ ዴሮይዳ ኬዴኔ፤ ዒዛኮ ዼኤፖ ዻጋፓ ቶላኒ ዔያታ ዳንዳዒባኣሴ።<verse eid="2CH 36:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 36:17"/>ዬያሮ ባብሎኔ ካኣቲ ዔያቶ ዖላንዳጉዲ ናንጊና ናንጋ ጎዳ ማሄም፥ ጌኤዦ ማኣሮይዳ ዓኣ ዓሶዋ ዓይሱዋዖ ዪሁዳይዳ ዓኣ ዼጌ ዓቲንቆ ቢያ ጬንቻ ዓፓሮና ካኣቲ ዎዺ ኩርሴኔ፤ ናንጊና ናንጋ ጎዳ ናብካዳናፆኦሬም ዓኣሢ ዒንጌሢሮ ዼጌሢንታ ጋርቾ ዓቲንቆንታ ላኣሎንታ ዖናኣ ዱማሱዋዖ ጉቤሢ ሚጪንቲሢ ባኣያና ዎዺ ባይዜኔ። <note caller="-" style="x"><char style="xo" closed="false">36፡17 </char><char style="xt" closed="false"><ref loc="JER 21:1-10">ዔር. 21፡1-10</ref>፤ <ref loc="JER 34:1-5">34፡1-5</ref>።</char></note> <verse eid="2CH 36:17"/><verse number="18" style="v" sid="2CH 36:18"/>ዬያ ሌሊቱዋንቴ ካኣቲ ናብካዳናፆኦሬ ጌኤዦ ማኣሮሲንታ ካኣቲንታ ካኣቲኮ ዶንዞ ማዔ ቢታንታ ዓኣ ዓሶኮ ቆሎ ቢያ ዲዒ ዔኪ ባብሎኔ ዴንዴኔ፤ <verse eid="2CH 36:18"/><verse number="19" style="v" sid="2CH 36:19"/>ሃሣ ጌኤዦ ማኣሮ፥ ዬሩሳላሜ ካታሞ፥ ሹጮና ማዦና ካኣቱሞ ማኣሮንታ ዓኣ ቆሎዋ ሚቼኔ፤ ካታሞኮ ኬኤሎ ዲሮዋ ዶይሴኔ፤ <verse eid="2CH 36:19"/><verse number="20" style="v" sid="2CH 36:20"/>ጬንቾ ዓፓሮና ዎዺንቱዋዖ ቶሊ ዓቴዞንሢ ቢያ ዲዒ ዔኪ ባብሎኔ ዒ ዓኣዼኔ፤ ዬይ ዔኪ ዓኣዾና ዓሳ፦ ፓርሴ ካኣቲ ካኣታዼ ዎዶ ሄላንዳኣና ዒኢካ ባብሎኔ ዓጫ ካራሚ ማዒ ካኣቲ ናብካዳናፆኦሬና ዒዛኮ ዜርፆናም ማዼኔ። <verse eid="2CH 36:20"/><verse number="21" style="v" sid="2CH 36:21"/>ናንጊና ናንጋ ጎዳ ፔ ማሊፆ ኬኤዛ ዔርሚያሴ ዛሎና ቤርታ፦ «ዴራ ታኣኮ ሃውሾ ኬሎ ቦንቺባኣሢጉዴያ ዓጬላ ላንካይታሚ ሌዔ ዓሲ ናንጉዋያ ጉሪ ዓጪ ማዒ ናንጋንዳሢሮ ሃውሾ ኬሊ ዒዛ ዴንቃንዳኔ» ጌይ ኬኤዜ ሎንሦ ቃኣላ ዬያይዲ ኩሜኔ። <note caller="-" style="x"><char style="xo" closed="false">36፡21 </char><char style="xt" closed="false"><ref loc="JER 25:11">ዔር. 25፡11</ref>፤ <ref loc="JER 29:10">29፡10</ref>።</char></note><verse eid="2CH 36:21"/></para>
  <para style="s1">ካኣቲ ቂኢሮሴ ዓይሁዶ ዓሳ ዲዒንታፓ ማዓንዳጉዲ ዓይሤሢ</para>
  <para style="r">(<ref loc="EZR 1:1-4">ዒዝ. 1፡1-4</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 36:22"/>ናንጊና ናንጋ ጎዳ ፔ ማሊፆ ኬኤዛሢ፥ ዔርሚያሴ ዛሎና ቤርታ ኬኤዜ ሎንሣ ቂኢሮሴ ፓርሴ ካኣቲ ማዒ ካኣታዼ ቤርታሳ ሌዖና ኩሜኔ፤ ሃይካፓ ዴማ ዓኣ ዓይሢፆ ኬሳንዳጉዲና ዒ ካኣታዺ ዎይሣ ዓጮ ቢያ ፃኣፒ ዳኪ ዼግ ጌዔ ዑኡሲና ዴሮም ናባቢንቲ ኬኤዚንታንዳጉዲ ማሃኒ ናንጊና ናንጋ ጎዳ ቂኢሮሴ ዔቂሴኔ።<verse eid="2CH 36:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 36:23"/>ዬያ ፃኣፒንቴ ባኮኮ ማሊፃ፦ «ሃይ ፓርሴ ካኣቲ ቂኢሮሴ ዓይሥሢኬ፤ ጫሪንጮ ጎዳ ማዔ ፆኦዛሢ ዓጮ ቢያ ታና ዎይሣያ ማሄኔ፤ ዪሁዳ ዓጮይዳ ዓኣ ዬሩሳላሜ ካታማ ዒዛ ቦንቾም ጌኤሺ ማኣሪ ማዣንዳጉዲ ታና ዒ ዓይሤኔ፤ ዬያሮ ፆኦሲ ዓሲ ማዔ ዓሳ ዒንሢ ቢያ ዬሩሳላሜ ዓኣዹዋቴ፤ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢ ዒንሢና ዎላ ማዖንጎ» ጋዓያኬ። <note caller="-" style="x"><char style="xo" closed="false">36፡23 </char><char style="xt" closed="false"><ref loc="ISA 44:28">ዒሲ. 44፡28</ref>።</char></note><verse eid="2CH 36:23"/></para>
  <chapter eid="2CH 36"/>
</usx>
