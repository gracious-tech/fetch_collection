<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- MAALE Full Bible</book>
  <para style="h">ዓሞፄ ማፃኣፖ</para>
  <para style="toc1">ፆኦሲ ማሊፆ ኬኤዛ ዓሞፄ ማፃኣፖ</para>
  <para style="toc3">ዓሞ.</para>
  <para style="toc2">ዓሞፄ ማፃኣፖ</para>
  <para style="mt1">ዓሞፄ ማፃኣፖ</para>
  <para style="imt">ዓይፆ ካሮ</para>
  <para style="ip">ዓሞፄ ጌይንታ ዓሢ ፆኦሲ ማሊሢ ኬኤዚሢና ኮሺ ዔርቴ ዓሲቱዋሴ፤ ፆኦሲ ማሊሢ ኬኤዚሢ ዛላ ታማሪ ዔሬ ባኣዚያ ባኣሴ (7፡14)። ጋዓንቴ ኬዶ ዛሎ ዓጮ ካኣቶ ዴማ ዎርቃ ዴሮም ኪኢታ ዔኪ ዴንዳንዳጉዲ ናንጊና ናንጋ ጎዳ ዒዛ ዳካዛ ዪሁዳይዳ ቴቆዓ ጌይንታ፥ ዒዚ ናንጋ ጉርዶ ሃሺ ዴንዴኔ። ዬካፓ ጊንሣ ዒስራዔኤሌ ዓሶኮ ካኣዦ ካኣሽኮ ዔርቴ ቤዞ፥ ቤኤቴኤሌ ካታሞ ዴንዴኔ።</para>
  <para style="ip">ሃኖ ማፃኣፖይዳ ቤርታሲጋፓ ዓሞፄ ዬኖ ቤዞይዳ ዓኣ ሜሌ ዴሮ ዻቢንቴያ ማሂ ጎራኔ፤ ዬካፓ ሃሣ ዒስራዔኤሌ ዴሮ፥ ባሼና ጊንሣ ዖርጎቹሞና ሜታባኣያ ዖቶርቂ ናንጋ ዓሶ ጎራኔ። ዔያታ ዴሮ ቡራያ፤ ሃሣ ዓይሌ ማሂ ዎልቄና ዎይሣ ዓሲኬ። ዬያቶይዳፓ ባሼ ዓሳ ናንጊና ናንጋ ጎዳ ሃሺ ሜሌ ፆኦሲ ካኣሽካያ ማዔቴያ ናንጊና ናንጋ ጎዳ ዔያቶ ካፓንዳኔ ጌይ ዔያታ ጉሙርቃኔ። ዔያታ ማዼ ጎሞ ዛሎና ናንጊና ናንጋ ጎዳ ዔያቶይዳ ሜቶ ዓጋንዳያ ማዒፆ ዓሞፄ ዔያቶም ሂዚ ጌይ ኬኤዜኔ፦</para>
  <para style="ip">«ፑርታ ዒፁዋቴ፥ ኮሺ ናሽኩዋቴ፤ ዎጎ ዎጎ ጶኦኮይዳ ፒዜ ዎጊፆ ሃሺ ዎቢሺፖቴ፤ ዬያ ዒንሢ ማዼቴ ናንጊና ናንጋ ጎዳ ማዔ ቢያ ባኮ ዎይሣ ጎዳሢ ፒኢጫዺ ዓቴ ዒስራዔኤሌ ዓሶ ጎዖንቴ ማኣራንዳያናንዳኔ።» (5፡15)</para>
  <para style="iot">ማፃኣፔላ ዱማ ዱማ ዓርቄ ባኮ</para>
  <para style="io1">ሜሌ ዴራ ማዼ ጎሞ ዛሎ ዔካንዳ ሜቶ (1፡1—3፡2)</para>
  <para style="io1">ዒስራዔኤሌንታ ሳማሪያ ካታሞንታ ባይቃንዳሢ ዛሎ (3፡3—6፡14)</para>
  <para style="io1">ዒስራዔኤሌይዳ ዓጊንታንዳ ሜቶ ዛሎ ዓሞፄም ፆኦሲ ፔጋሲ ዻዌ ዶንጎ ባኣዚ (7፡1—9፡10)</para>
  <para style="io1">ዒስራዔኤሌም ሃጊ ቤርታ ዓኣ ጉሙርሳ ዎዛ (9፡11-15)</para>
  <chapter number="1" style="c" sid="AMO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1"/>ዖኦዚያ ጎዖሢ ዪሁዳይዳ፤ ዮዓኣሴ ናኣዚ ዒዮርቢዓሜ ዒስራዔኤሌይዳ ካኣታዺ ዓኣ ዎዶና ቴቆዓ ጉርዶይዳ ቆልሞ ሄንቃ ዓሶፓ ፔቴ፥ ዓሞፄ ጌይንታስኬይ ዒስራዔኤሌ ዓሶ ዛሎ ፆኦሲ ማሊሢ ሂዚ ጌይ ኬኤዜኔ፤ ዬያ ዒ ኬኤዛንዳሢኮ ላምዖ ሌዔኮ ቤርታ ዒኢካ ሳኣ ዓጊፄኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="2KI 15:1-7">2ካኣቶ. ማ 15፡1-7</ref>፤ <ref loc="2KI 14:23-29">14፡23-29</ref>፤ <ref loc="2CH 26:1-23">2ፆኦሲ. ዓሃኬ 26፡1-23</ref>።</char></note><verse eid="AMO 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2"/>ዓሞፄ ዒማና ሂዚ ጌዔኔ፦</para>
  <para style="q" vid="AMO 1:2">«ናንጊና ናንጋ ጎዳ ፂዮኔ ዹኮይዳ ዴይ</para>
  <para style="q2" vid="AMO 1:2">ጉጉዻ ዞቢጉዲ ዒጊቻ ዑኡሲ ዋይዚሳኔ፤</para>
  <para style="q2" vid="AMO 1:2">ዒ ጋዓ ባካ ዬሩሳላሜፓ ማኣሚ ዋይዚንታኔ፤</para>
  <para style="q2" vid="AMO 1:2">ቆልሞ ሄንቃ ዓሳ ሄንቃ ቤዛ ዓኣ ማኣታ ቆልሞኮ ሹላንዳኔ፤</para>
  <para style="q2" vid="AMO 1:2">ቄርሜሎሴ ዹኮይዳኣ ዋርቂ ዓኣ ባካኣ ቢያ ሜላንዳኔ።» <note caller="-" style="x"><char style="xo" closed="false">1፡2 </char><char style="xt" closed="false"><ref loc="JOL 3:16">ዒዩ. 3፡16</ref>።</char></note></para>
  <para style="s1" vid="AMO 1:2">ናንጊና ናንጋ ጎዳ ዒስራዔኤሌኮ ዓሺኒ ማዔ ዓጮይዳ ዓጌ ሜቶ</para>
  <para style="d" vid="AMO 1:2">ሶኦሪያ<verse eid="AMO 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ዴማስቆ ዴራ ማዼ ሃይማኬ ጌይንቱዋ ጎሞ ዛሎ ቲኢሩዋዖ ሜቶ ታኣኒ ዔያቶይዳ ዓጋንዳኔ፤ ዔያታ ዓቺ ማላ ሺራ ቶኪ ዓኣ ዓንጊና ሃኣኮ ሺርኮ ጎይሢ ጌሌዓዴ ዴሮኮ ጊዶ ሄርቂ ሃንቲ ሜቶ ቤኤዜኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡3 </char><char style="xt" closed="false"><ref loc="ISA 17:1-3">ዒሲ. 17፡1-3</ref>፤ <ref loc="JER 49:23-27">ዔር. 49፡23-27</ref>፤ <ref loc="ZEC 9:1">ዛካ. 9፡1</ref>።</char></note> <verse eid="AMO 1:3"/><verse number="4" style="v" sid="AMO 1:4"/>ካኣቲ ሃዛዔኤሌኮ ካኣቱሞ ባይዛንዳ ታሚ ታኣኒ ዓጋንዳኔ፤ ዬይ ታማ ካኣቲ፥ ቤንሃዳዴ ኬልቂ ኮሼ ዲፆ ሙዓንዳኔ። <verse eid="AMO 1:4"/><verse number="5" style="v" sid="AMO 1:5"/>ዴማስቆ ካታሞ ጌሎ ካሮ ዎዾ ዓንጎ ታኣኒ ቢያ ሜንሣንዳኔ፤ ዓዌኔ ዶኦጮይዳ ናንጋ ዴሮንታ ቤትዔዴኔ ካኣቲንታ ታኣኒ ባይዛንዳኔ፤ ሶኦሪያ ዴራ ዲዒንቲ ቂኢሬ ዓጮ ዔውታንዳኔ።»<verse eid="AMO 1:5"/></para>
  <para style="b"/>
  <para style="s1">ፒሊስፄኤሜ</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ጋኣዛ ካታሞ ዴራ ማዼ ሃይማኬ ጌይንቱዋ ጎሞ ዛሎ ቲኢሩዋዖ ሜቶ ታኣኒ ዔያቶይዳ ዓጋንዳኔ፤ ዔያታ ዲዒ ዔካ ዴሮ ቢያ ዔዶኦሜ ዓሶም ሻንቼኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡6 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">ዒሲ. 14፡29-31</ref>፤ <ref loc="JER 47:1-7">ዔር. 47፡1-7</ref>፤ <ref loc="EZK 25:15-17">ሂዚ. 25፡15-17</ref>፤ <ref loc="JOL 3:4-8">ዒዩ. 3፡4-8</ref>፤ <ref loc="ZEP 2:4-7">ሶፖ. 2፡4-7</ref>፤ <ref loc="ZEC 9:5-7">ዛካ. 9፡5-7</ref>።</char></note> <verse eid="AMO 1:6"/><verse number="7" style="v" sid="AMO 1:7"/>ዬያሮ ታኣኒ ጋኣዛ ካታሞኮ ኬኤሎ ዲፆይዳ ታሚ ዓጋንዳኔ፤ ዔያቶኮ ዬያ ዋርዲዮ ዬይ ታማ ሙዓንዳኔ። <verse eid="AMO 1:7"/><verse number="8" style="v" sid="AMO 1:8"/>ዓሽዶዴይዳ ናንጋ ዴሮንታ ዓስቄሎና ካኣቲንታ ታኣኒ ባይዛንዳኔ፤ ዔቅሮኦኔ ካታማ ናንጋ ዴሮይዳኣ ታኣኒ ሜቶ ዓጋንዳኔ፤ ፒሊስፄኤሜፓ ቶሊ ዓቴ ዓሳኣ ሃይቃንዳኔ።»<verse eid="AMO 1:8"/></para>
  <para style="b"/>
  <para style="s1">ፂኢሮሴ</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ፂኢሮሴ ካታሞ ዴራ ማዼ ሃይማኬ ጌይንቱዋ ጎሞ ዛሎ ቲኢሩዋዖ ታኣኒ ሜቶ ዔያቶይዳ ዓጋንዳኔ፤ ዔያታ ዎላ ሳላዼ ዴሮ ቦንቹዋዖ ዲዒ ዔኬ ዓሶ ዔዶኦሜ ዓሶም ሻንቼኔ። <verse eid="AMO 1:9"/><verse number="10" style="v" sid="AMO 1:10"/>ዬያሮ ፂኢሮሴ ካታሞኮ ኬኤሎ ዲፆይዳ ታሚ ታኣኒ ዓጋንዳኔ፤ ዔያቶኮ ዬያ ዋርዲዮ ዬይ ታማ ሙዓንዳኔ።» <note caller="-" style="x"><char style="xo" closed="false">1፡10 </char><char style="xt" closed="false"><ref loc="ISA 23:1-8">ዒሲ. 23፡1-8</ref>፤ <ref loc="EZK 26:1-28:19">ሂዚ. 26፡1—28፡19</ref>፤ <ref loc="JOL 3:4-8">ዒዩ. 3፡4-8</ref>፤ <ref loc="ZEC 9:1-4">ዛካ. 9፡1-4</ref>፤ <ref loc="MAT 11:21-22">ማቲ. 11፡21-22</ref>፤ <ref loc="LUK 10:13-14">ሉቃ. 10፡13-14</ref>።</char></note><verse eid="AMO 1:10"/></para>
  <para style="b"/>
  <para style="s1">ዔዶኦሜ</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ዔዶኦሜ ዴራ ማዼ ሃይማኬ ጌይንቱዋ ጎሞ ዛሎ ቲኢሩዋዖ ሜቶ ታኣኒ ዔያቶይዳ ዓጋንዳኔ፤ ዔያታ ፔኤኮ ዒጊኖ፥ ዒስራዔኤሌ ዓሶ ጬንቾ ዓራፖና ዎዺ ዎዺ ዳውሴኔ፤ ዔያቶ ዳውሲ ዓርቃዖዋ ሚጪንቲቃይዶ ዔያታ ዎዼኔ፤ ዔያቶይዳ ታኣኒ ዻጋዼ ዻጋ ታኣኮ ማዖ ዒፄኔ፤ <note caller="-" style="x"><char style="xo" closed="false">1፡11 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">ዒሲ. 34፡5-17</ref>፤ <ref loc="ISA 63:1-6">63፡1-6</ref>፤ <ref loc="JER 49:7-22">ዔር. 49፡7-22</ref>፤ <ref loc="EZK 25:12-14">ሂዚ. 25፡12-14</ref>፤ <ref loc="EZK 35:1-15">35፡1-15</ref>፤ <ref loc="OBA 1:1-14">ዓብዲ. 1-14</ref>፤ <ref loc="MAL 1:2-5">ሚል. 1፡2-5</ref>።</char></note> <verse eid="AMO 1:11"/><verse number="12" style="v" sid="AMO 1:12"/>ዬያሮ ቴማኣኔ ካታሞይዳ ታኣኒ ታሚ ዓጋንዳኔ፤ ዬይ ታማ ቦፂራ ዋርዲዮዋ ሙዓንዳኔ።»<verse eid="AMO 1:12"/></para>
  <para style="b"/>
  <para style="s1">ዓሞኦኔ</para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ዓሞኦኔ ዴራ ማዼ ሃይማኬ ጌይንቱዋ ጎሞ ዛሎ ቲኢሩዋዖ ሜቶ ታኣኒ ዔያቶይዳ ዓጋንዳኔ፤ ዔያታ ፔኤኮ ዓጮ ዳልጊሻኒ ዖሌ ዖሎና ጌሌዓዴይዳ ናንጋ፥ ጎጶይንዳሢኮ ጎጶ ዔያታ ዳርዚ ዳርዚ ላኣሌኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡13 </char><char style="xt" closed="false"><ref loc="JER 49:1-6">ዔር. 49፡1-6</ref>፤ <ref loc="EZK 21:28-32">ሂዚ. 21፡28-32</ref>፤ <ref loc="EZK 25:1-7">25፡1-7</ref>፤ <ref loc="ZEP 2:8-11">ሶፖ. 2፡8-11</ref>።</char></note> <verse eid="AMO 1:13"/><verse number="14" style="v" sid="AMO 1:14"/>ዬያሮ ታኣኒ ራኣባ ካታሞኮ ኬኤሎ ዲፆይዳ ታሚ ዓጋንዳኔ፤ ዬይ ታማ ዬያ ዋርዲዮ ሙዓንዳኔ፤ ያዺ ማዔስካፓ ዖሎ ዓቦና ሞርካ ዔያቶ ዎዺ ዎዺ ሜርቶ ሌሊ ሜርታያ ማዓንዳኔ፤ ዖሎ ዖላ ዓሳ ዓልጎ ዢባሬጉዲ ሩኡሪ ዔያቶይዳ ዬዓንዳኔ፤ <verse eid="AMO 1:14"/><verse number="15" style="v" sid="AMO 1:15"/>ዔያቶኮ ካኣቲንታ ዼኤፖ ዼኤፖ ቢታንታ ዓኣ ዓሶንታ ዲዒንቲ ዔውታንዳኔ።» ጋዓኔ ናንጊና ናንጋ ጎዳሢ።<verse eid="AMO 1:15"/></para>
  <chapter eid="AMO 1"/>
  <chapter number="2" style="c" sid="AMO 2"/>
  <para style="s1">ሞዓኣቤ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ሞዓኣቤ ዴራ ማዼ ሃይማኬ ጌይንቱዋ ጎሞ ዛሎ ቲኢሩዋዖ ሜቶ ታኣኒ ዔያቶይዳ ዓጋንዳኔ፤ ዔያታ ዔዶኦሜ ካኣቲኮ ሜጌፆ ዲቢንሢ ማሂ ታሚና ሚቼኔ፤ <note caller="-" style="x"><char style="xo" closed="false">2፡1 </char><char style="xt" closed="false"><ref loc="ISA 15:1-16:14">ዒሲ. 15፡1—16፡14</ref>፤ <ref loc="ISA 25:10-12">25፡10-12</ref>፤ <ref loc="JER 48:1-47">ዔር. 48፡1-47</ref>፤ <ref loc="EZK 25:8-11">ሂዚ. 25፡8-11</ref>፤ <ref loc="ZEP 2:8-11">ሶፖ. 2፡8-11</ref>።</char></note> <verse eid="AMO 2:1"/><verse number="2" style="v" sid="AMO 2:2"/>ዬያሮ ሞዓኣቤ ሳዖይዳ ታሚ ታኣኒ ዓጋንዳኔ፤ ዬይ ታማ ቂሪዮቴ ዋርዲዮ ሙዓንዳኔ፤ ዖሎሮ ሙካ ዓሳ ሜርቲ ሜርቲ፥ ዛዬ ዋርቂ ሃሣ ዲቃሣ ዑኡሲያ ዋይዚሲ ዋይዚሲ ሞዓኣቤ ዴሮ ዎዺ ኩርሳንዳኔ። <verse eid="AMO 2:2"/><verse number="3" style="v" sid="AMO 2:3"/>ሞዓኣቤ ዓጮ ዎይሣ ሱኡጎንታ ቢታንታ ዓኣ ዓሶንታ ታኣኒ ባይዛንዳኔ።» ጋዓኔ ናንጊና ናንጋ ጎዳሢ።<verse eid="AMO 2:3"/></para>
  <para style="b"/>
  <para style="s1">ዪሁዳ</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ዪሁዳ ዴራ ማዼ ሃይማኬ ጌይንቱዋ ጎሞ ዛሎ ቲኢሩዋዖ ታኣኒ ሜቶ ዔያቶይዳ ዓጋንዳኔ፤ ዔያታ ታኣኮ ዎጎ ቦንቺባኣሴ፤ ታኣኒ ዓይሤ ባኮዋ ካፒ ኩንሢባኣሴ፤ ዔያቶኮ ዓዶንሢ ካኣሽካ ሉኡዚ ማዔ ፆኦዛ ዔያቶ ዻቢሼኔ፤ <verse eid="AMO 2:4"/><verse number="5" style="v" sid="AMO 2:5"/>ዬያሮ ታኣኒ ዪሁዳ ሳዖይዳ ታሚ ዓጋንዳኔ፤ ዬሩሳላሜ ካታሞኮ ኬኤሎ ዲፆ ዬይ ታማ ሙዓንዳኔ።»<verse eid="AMO 2:5"/></para>
  <para style="s1">ናንጊና ናንጋ ጎዳ ዒስራዔኤሌ ዓጮይዳ ዓጌ ሜታሢ</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ዒስራዔኤሌ ዴራ ማዼ ሃይማኬ ጌይንቱዋ ጎሞ ዛሎ ቲኢሩዋዖ ታኣኒ ዔያቶይዳ ሜቶ ዓጋንዳኔ፤ ዔያታ ፂሎ ዓሶ ሚኢሼም፥ ማንቆ ዓሶዋ ዱርሲና ዖኦኪ ዖኦኪ ሻንቼኔ። <verse eid="AMO 2:6"/><verse number="7" style="v" sid="AMO 2:7"/>ዎልቃባኣ ዓሶና ማኣዳ ዓሲባኣ ዓሶዋ ሳዖይዳ ዔያታ ሎንሢ ቶኦኮ ሄርቄኔ፤ ዎልቃ ጌላያ ማዔ፥ ሄርቂንቲ ዎርቃ ዓሶም ፒዜ ዎጌ ዔያታ ዎጉዋሴ፤ ዓዶንታ ናዖንታ ፔቴ ላኣሊና ላሃኔ፤ ዬያ ዔያታ ማዺፆና ታኣኮ ዱማዼ ጌኤዦ ሱንፆ ዒኢሳኔ። <verse eid="AMO 2:7"/><verse number="8" style="v" sid="AMO 2:8"/>ጋሌ ጪጋኒ ዳንዳዒባኣ ማንቆ ዓሶኮ ዓፒሎ ዔያታ ዓይሢ ባኣዚ ማሂ ዔካኔ፤ ፆኦሲም ዒንጎ ባኮ ዒንጎ ቤዞ ኮይላ ዬያ ዓፒሎ ሂኢሢ ዔያታ ጊዳ ላላሃኔ፤ ጋሎ ጪጋኒ ዳንዳዒባኣ ዓሶ ዻቢሲ ዔያታ ዔኬ ዎይኖ ዑዦ ዔያቶኮ ፆኦሲ ማኣራ ዴይ ዔያታ ዑዑሽካኔ።<verse eid="AMO 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 2:9"/>«ታኣኒ ጋዓንቴ ዒስራዔኤሌ ዴሮ ሚጪንቲ ሊባኖኦሴ ሚፆጉዲ ዼኤፔ ዓሶ፥ ዎልቆናኣ ዼኤፒ ሻኣቢ ማዒ ዓኣ ዓሞኦራ ዓሶ ፃጳፓ ቱጊ ኬኤሪ ባይዜኔ፤ <note caller="-" style="x"><char style="xo" closed="false">2፡9 </char><char style="xt" closed="false"><ref loc="DEU 3:8-11">ላሚ. ዎማ 3፡8-11</ref>።</char></note> <verse eid="AMO 2:9"/><verse number="10" style="v" sid="AMO 2:10"/>ጊብፄ ዓጮፓ ታኣኒ ዒንሢ ዔኪ ኬሲ ዖይዲታሚ ሌዔ ጉቤ ዓሲ ናንጉዋ ዳውሎይዳ ጎይሢ ዒንሢም ቤኤዚ ዔኪ ሃንቴኔ፤ ዓሞኦራ ዓሶ ዓጮዋ ዒንሢ ዴኔ ማሂ ታኣኒ ዒንጌኔ። <verse eid="AMO 2:10"/><verse number="11" style="v" sid="AMO 2:11"/>ዒንሢኮ ዓቲንቆ ባኣካፓ ፔቴ ፔቴ ዓሶ ታ ማሊሢ ኬኤዛያ፥ ዒንሢኮ ዼጌሢ ባኣካፓኣ ፔቴ ፔቴ ናዝራ ዓሲ<note caller="+" style="f"><char style="fr" closed="false">2፡11 </char><char style="fq" closed="false">ናዝራ ዓሲ፦ </char><char style="ft" closed="false">ጋዓዞ ፓይ. ማፃ 6፡2ይዳ ዛጌ።</char></note> ማዓንዳያ ዶኦሪ ታኣኒ ኬሴኔ፤ ዒስራዔኤሌ ዴሬዮቴ! ዬይ ጎኔ ባኣዚቱዋዓዳ? ዬያ ጌዔሢ ታና፥ ናንጊና ናንጋ ጎዳኬ። <note caller="-" style="x"><char style="xo" closed="false">2፡11 </char><char style="xt" closed="false"><ref loc="NUM 6:1-8">ፓይ. ማፃ 6፡1-8</ref>።</char></note> <verse eid="AMO 2:11"/><verse number="12" style="v" sid="AMO 2:12"/>ዒንሢ ጋዓንቴ ናዝራ ዓሶ ዎይኖ ዑዦ ዑሺ ዻቢሼኔ፤ ታ ማሊፆ ኬኤዛ ዓሳኣ ዔኤቢ ኬኤዙዋጉዲ ዒንሢ ላኣጌኔ። <verse eid="AMO 2:12"/><verse number="13" style="v" sid="AMO 2:13"/>ዬያሮ ታኣኒ ዼኤፒ ሹቺ ኮላሶዛ ዴማ ዓኣ ባካ ዳኣፂንታሢጉዲ ሄርቂ ዒንሢ ዳኣፃንዳኔ። <verse eid="AMO 2:13"/><verse number="14" style="v" sid="AMO 2:14"/>ጳዦ ሩኡሪ ጳሽካሢ ጳሽኮ ባሺንታንዳኔ፤ ዶዶ ዓሶኮ ዎልቃ ባይቃንዳኔ፤ ዖሎ ዖላ ዓሳ ፔና ዓውሳኒ ዳንዳዓዓኬ። <verse eid="AMO 2:14"/><verse number="15" style="v" sid="AMO 2:15"/>ሂኢዦና ዱካ ዓሳ ቤዛ ዔቂ ዱኪ ቃዛዓኬ፤ ሩኡሪ ጳሽካ ዓሳኣ ጳሽኪ ቶላዓኬ፤ ፓራሢና ዖላ ዓሳኣ ፔ ሼምፓሢ ዓይሳዓኬ። <verse eid="AMO 2:15"/><verse number="16" style="v" sid="AMO 2:16"/>ዬኖ ኬሎና ዖሎና ዔርቴ ዓሳታዖ ፔኤኮ ዓንጋሞ ኬኤሪ ኬኤሪ ጳሽካንዳኔ» ዬያ ጌዔሢ ናንጊና ናንጋ ጎዳኬ።<verse eid="AMO 2:16"/></para>
  <chapter eid="AMO 2"/>
  <chapter number="3" style="c" sid="AMO 3"/>
  <para style="s1">ዒስራዔኤሌ ዓሶ ላሣኒ ፓይዲንቴ ማርካ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1"/>ዒስራዔኤሌ ዴሬዮቴ! ዒዚ ጊብፄፓ ዔኪ ኬሴ ዴሮ፥ ዒንሢ ቢያሢ ዛሎ ናንጊና ናንጋ ጎዳ ዻጋዺ ጌዔ ባኮ ዋይዙዋቴ፦ <verse eid="AMO 3:1"/><verse number="2" style="v" sid="AMO 3:2"/>«ዓጮ ቢያይዳ ናንጋ ዴሮፓ ቢያ ታኣኒ ዶኦሬሢ ዒንሢ ሌሊኬ፤ ዒንሢ ማዻ ጎሞ ዛሎሮ ቢያ ታ ዒንሢዳ ሜቶ ዓጋሢ ዬያሮኬ።»<verse eid="AMO 3:2"/></para>
  <para style="s1">ፆኦሲ ማሊሢ ኬኤዛ ዓሲ ፆኦሲፓ ዋይዚ ኬኤዛያ ማዒፆ</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 3:3"/>ሂንዳ ማሉዋቴ፤ ላምዖ ዓሲ ዎላ ጌስቲ ጊኢጉዋዖ ጎይሢ ዴንዳኒ ዳንዳዓኖ?<verse eid="AMO 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 3:4"/>ዞቢ ዴኤሊ ካይዚዳ ዔኤቢ ኬሚ ዓርቁዋዖ ጉሪ ጉዻኖ?</para>
  <para style="p" vid="AMO 3:4">ሃጊ ዔቃ ዞቢያኣ ፔቴታዖ ዔኤቢ ዴንቁዋ ዎርቃ ቤዛ ዓኣዖ ዑኡሲ ኬሳ?<verse eid="AMO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 3:5"/>ፒራ ፒሪንቲባኣንቴ ካፒ ጉሪ ዓዺንታ?</para>
  <para style="p" vid="AMO 3:5">ዔኤቢ ጊዳ ጌሉዋንቴ ፒራ ጉሪ ዶንቃ?<verse eid="AMO 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 3:6"/>ዖልዚሮ ጊኢጋንዳጉዲ ዛያ ካታሞይዳ ዋርቂንታኣና ዒጊጪ ጎጋይቁዋ ዴሬ ዓኣ?</para>
  <para style="p" vid="AMO 3:6">ናንጊና ናንጋ ጎዳ ጌይባኣንቴ ካታማይዳ ፑርታ ባኣዚ ሙኪ ሄላ?<verse eid="AMO 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 3:7"/>ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢ ፔ ማሊፆ ዒዛኮ ዓይሎም ፔጋሲ ዻውዋዖ ፔቴ ባኣዚታዎ ማዹዋሴ።<verse eid="AMO 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 3:8"/>ዞቢ ጉዻኣና ዋይዛዖ ዒጊጩዋኣይ ዖናዳይ?</para>
  <para style="p" vid="AMO 3:8">ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢ ፔ ማሊፆ ፔጋሲ ዻዋዛ ዒዛ ማሊሢ ኬኤዙዋይ ዖናዳይ?<verse eid="AMO 3:8"/></para>
  <para style="s1">ሳማሪያ ካታሞኮ ዶዒፆ</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 3:9"/>ዓሽዶዴ ካታሞና ጊብፄ ዓጮናይዳ ዓኣ ኬልቂ ዋርዲዮና ቤዛ ናንጋ ዓሶም ቢያ ሂዚ ጌይ ዑኡዞ ዼጊዲ ኬኤዙዋቴ፦ «ሳማሪያ ዹኮይዳ ቡኪንቱዋቴ፤ ዒኢካ ማዺንታ ጌኖ ማዾና ዣላሢያ ዛጉዋቴ።»<verse eid="AMO 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 3:10"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ዬይ ዴራ ኮሺ ባኣዚ ማዺሢ ዔሩዋሴ፤ ጌኔ ማዾና ዔያታ ቡሪ ዔኬ ቆሎና ፔኤኮ ኬኤሎ ዲፆ ጋሮ ኩንሤኔ፤ <verse eid="AMO 3:10"/><verse number="11" style="v" sid="AMO 3:11"/>ዬያሮ ሞርኬ ሙኪ ዔያቶኮ ዓጮ ማንጋንዳኔ፤ ኬኤሎ ዲፆ ዔያቶኮ ሻሂ ኬኤፆዋ ዔያቶኮ ቡራንዳኔ።» ጋዓኔ ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢ።<verse eid="AMO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ሳማሪያይዳ ናንጋ ዒስራዔኤሌ ዓሳ ሜቂሢ ሻኣላና ሹልጉዶ ዜዺና ዓኣያ ማዒ ቶሊ ዓታንዳኔ፤ ዬይያ፦ ቆልሞ ሄንቃ ዓሲ ዞቢ ሙይ ጋፒሴ ቆልሞኮ ላምዖ ቶኪና ዋይዚ ዱጲሢና ቶሊሲ ዔካያጉዲኬ።» <verse eid="AMO 3:12"/><verse number="13" style="v" sid="AMO 3:13"/>ቢያ ባኮ ዎይሣ ጎዳ ማዔ ፆኦዛሢ ሂዚ ጋዓኔ፦ «ታ ጋዓ ባኮ ዋይዙዋቴ፤ ያይቆኦቤ ዜርፃ ማዼ ባኮኮ ማርካ ታ ዒንሢ ፓይዳሢሮ ማርካዹዋቴ። <verse eid="AMO 3:13"/><verse number="14" style="v" sid="AMO 3:14"/>ዔያታ ማዼ ጎሞ ዛሎሮ ዒስራዔኤሌ ዴሮይዳ ታኣኒ ሜቶ ዓጋ ኬሎና ቤኤቴኤሌይዳ ዓኣ ዒንጎ ባኮ ዒንጎ ቤዞ ታኣኒ ሻሃንዳኔ፤ ዬያ ቤዞኮ ካኣሪ ማዒ ዓኣ ኮሺንቴ ባካ ሳዓ ሜቂ ኬዳንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">3፡14 </char><char style="xt" closed="false"><ref loc="2KI 23:15">2ካኣቶ. ማ 23፡15</ref>።</char></note> <verse eid="AMO 3:14"/><verse number="15" style="v" sid="AMO 3:15"/>ዔያታ ባርጎንታ ዖጎፆንታ ዒኢካ ዴይ ዓኣሣ ማኣሮ ቢያ ታ ዔያቶኮ ሻሃንዳኔ፤ ዳርዞ ዓጮና ሚዛጲሲ ኮሾና ማኣራ ቢያ ሻሂንታንዳኔ፤ ዼኤፖ ዼኤፖ ማኣራኣ ቢያ ዶዓንዳኔ» ጋዓኔ ናንጊና ናንጋ ጎዳሢ።<verse eid="AMO 3:15"/></para>
  <chapter eid="AMO 3"/>
  <chapter number="4" style="c" sid="AMO 4"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 4:1"/>ባኣሳኣኔ ዓጮይዳ ዓኣ ዲጮ ባኣቶ ዒንዶጉዲ ማሌ ሳማሪያ ካታሞ ላኣላ! ሃያ ባኮ ኮሺ ዋይዙዋቴ! ዒንሢ ላቤ፥ ዎልቃ ባኣ ዓሶ ዻውሲሳኔ፤ ማንቆ ዓሶኮ ዒንሢ ካራ ባይዛኔ፤ ዓኒንሢ ዒንሢም ቢያ ዎዴ ማሣ ዑሺ ዒንጋንዳጉዲ ዒንሢ ዖኦጫኔ። <verse eid="AMO 4:1"/><verse number="2" style="v" sid="AMO 4:2"/>ዬያሮ ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢ ፔኤኮ ዱማዼ ጌኤሹሞ ጌፒ ሂዚ ጌይ ጫኣቄኔ፦ «ዓንጊ ኪሬና ጎቺ ዔኤቢ ዔኮጉዲ ዒንሢ ዔውታንዳ ዎዴ ዬዓንዳኔ፤ ዒንሢዳ ዓታንዳ ዓሲ ባኣሴ፥ ዓቴኔ ጎዖና ዓሳኣ ሞሎጉዲ ዓንጊ ኪሬና ዓዺንቲ ዔውታንዳኔ። <verse eid="AMO 4:2"/><verse number="3" style="v" sid="AMO 4:3"/>ዒንሢ ፔቴ ፔቴሢ ሻሆና ኬኤሎ ዲፆኮ ፑልቶና ጎቺንቲ ዔውቲ ሃርሞኦኔይዳ ኬኤሪንታንዳኔ» ጋዓኔ ናንጊና ናንጋ ጎዳሢ።<verse eid="AMO 4:3"/></para>
  <para style="s1">ዒስራዔኤሌ ዓሳ ሪኢራኒ ዳንዳዒባኣሢ</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 4:4"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ዒስራዔኤሌ ዴሬዮቴ! ቤኤቴሌ ዴንዲጋፓ ጎሞ ማማዹዋቴ! ሃሣ ጌልጌላኣ ዴንዲጋፓ ኮይሴ ጎይሢ ጎሜ ማማዹዋቴ! ኬላ ኬላ ፆኦሲም ዒንጎ ባኮዋ ዒንጉዋቴ! ሃይሣሳ ኬሎና ታጳፓ ፔቴ ኬሲ ዒንሢ ዒንጋ ባኮ ዒንጉዋቴ። <verse eid="AMO 4:4"/><verse number="5" style="v" sid="AMO 4:5"/>ዒንሢ ማዻኒ ኮዓዛ ዬኖታሢሮ ጋላቶሮ ዒንሢ ዔኪ ሺኢሻ፥ ሙኑቆ ፃኣዞና ካሢንታ ካሦ ታኣም ሺኢሹዋቴ፤ ዒንሢ ሼኔና ዒንሢ ዔኪ ሙኪ ዒንጋ ባኮሮ ሆኦሊንቲ ጌስቱዋቴ።»<verse eid="AMO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 4:6"/>«ዻንጋይዳ ዒንሢ ዳካንዳ ሃኣኮ ባይዚ፥ ካታሞ ቢያይዳ ናይዚ ታኣኒ ዳኬኔ፤ ዒንሢ ጋዓንቴ ዬያና ሪኢሪ ታ ባንሢ ማዒባኣሴ። <verse eid="AMO 4:6"/><verse number="7" style="v" sid="AMO 4:7"/>ጎዣ ዒንሢኮ ካፁዋንቴ ሃይሦ ዓጊኒኮ ቤርታ ዒሮ ታኣኒ ዋርቁዋጉዲ ላኣጌኔ፤ ፔቴ ካታሞይዳ ዋርቃዖ ባጎይዳ ዋርቁዋጉዲ ታኣኒ ቃዜኔ፤ ፔቴሢ ጎዣ ዒራ ዋርቃዛ ባጋሢሲኮ ዒርዚ ባይቄም ሃኣኮ ዓቢ ሜልዜኔ። <verse eid="AMO 4:7"/><verse number="8" style="v" sid="AMO 4:8"/>ዓሳ ዋኣሢ ዑሽኮንዶያ ባይዚ ፔቴ ካታማፓ ሜሌ ካታሞ ዴንዴኔ፤ ጋዓንቴ ዬይ ዓሳ ጊዳንዳ ዋኣሢ ዴንቂባኣሢሮ ዑሽኪ ዼኤቦ ዛኣራኒ ዳንዳዒባኣሴ፤ ዬያ ዛጋዖ ዒንሢ ታ ባንሢ ማዒባኣሴ።<verse eid="AMO 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 4:9"/>«ሃኣኮ ዒንሢኮ ሜልዛንዳ ዶዲ ዢባሬ ታኣኒ ዢባርሺሴኔ፤ ዒንሢኮ ቱኮና ዱማ ዱማ ባኮንታ ዎይኖንታ፥ ቤሌሶ ሚፆንታ ዛይቶ ሪሚቶንታ ቢያ ዓቢሢ ሙዔኔ፤ ዬያሮታዎ ሪኢሪ ዒንሢ ታ ባንሢ ማዒባኣሴ።<verse eid="AMO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 4:10"/>«ጊብፄ ዓጮይዳ ታኣኒ ዳኬ ባይዛ ባኮጉዴ ባኣዚ ታ ዒንሢም ዳኬኔ፥ ዼጌሢ ታ ዒንሢኮ ጬንቾ ዓራፖና ዎዺሼኔ፥ ፓራሢያ ታ ዒንሢኮ ዲዒሴኔ፤ ጊንሣ ሃሣ ዒንሢኮ ጉርዶይዳ ሃይቄ ዓሶ ሌዞ ዛዖና ሲኢዾ ታኣኒ ዒንሢኮ ሹኡሜኔ፤ ዒንሢ ጋዓንቴ ታ ባንሢ ማዓኒ ዳንዳዒባኣሴ።<verse eid="AMO 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 4:11"/>«ሶዶኦሜና ጋሞኦራና ታኣኒ ባይዜሢጉዲ ዒንሢዳፓ ሚርጌ ዓሲ ታኣኒ ዎዺ ባይዜኔ፤ ዒንሢ ቶሊ ዓቴሢ ታሚ ጋውሌ ሚሢጉዲ ማዒኬ፤ ዬይ ቢያ ያዺ ማዔቴያ ታ ባንሢ ዒንሢ ማዒባኣሴ። <note caller="-" style="x"><char style="xo" closed="false">4፡11 </char><char style="xt" closed="false"><ref loc="GEN 19:24">ማዢ. ማፃ 19፡24</ref>።</char></note> <verse eid="AMO 4:11"/><verse number="12" style="v" sid="AMO 4:12"/>ዒስራዔኤሌ ዴሬዮቴ! ታኣኒ ዒንሢዳ ዬያጉዴ ፑርታ ሜቶ ዓጋንዳኔ፤ ዬያሮ ታና፥ ዒንሢኮ ፆኦዛሢና ዎላ ካኣማኒ ጊኢጉዋቴ!»<verse eid="AMO 4:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 4:13"/>ታኣኒ፦ ዹኮ ቢያ ማዤ፤ ሃሣ ዢባሮዋ ማዤያ</para>
  <para style="q" vid="AMO 4:13">ታኣኒ ማሌ ባኮ ዓሲም ፔጋሲ ዻዋያ</para>
  <para style="q2" vid="AMO 4:13">ሮኦሮ ፖዖ ዹሚ ማሂ ሺርሻያ</para>
  <para style="q" vid="AMO 4:13">ሳዖኮ ዼጌ ዼጌ ማዔ ጌሜሮይዳ ሃንታያ</para>
  <para style="q" vid="AMO 4:13">ሱንፃ ታኣኮ ቢያ ባኮ ዎይሣ ፆኦሲ ናንጊና ናንጋ ጎዳኬ።<verse eid="AMO 4:13"/></para>
  <chapter eid="AMO 4"/>
  <chapter number="5" style="c" sid="AMO 5"/>
  <para style="s1">ዒስራዔኤሌ ዴራ ጎሞ ቡኡፃንዳጉዲ ኬኤዚንቴሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1"/>ዒስራዔኤሌ ዴሬዮቴ! ታኣኒ ዒንሢዳ ሄላንዳ ባኮ ዛሎሮ ቃያ ቃዮ ዋይዙዋቴ፦<verse eid="AMO 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 5:2"/>ኩሙሢ ዉዱሮ ማዔዛ ዒስራዔኤሌ ሎኦሜኔ፤</para>
  <para style="q2" vid="AMO 5:2">ላሚ ዬኤፓ ዒዛ ዔቃኒ ዳንዳዑዋሴ።</para>
  <para style="q2" vid="AMO 5:2">ዒዞ ኬኤሊንቂ ዔቂሳንዳ ዓሲያ ባኣያ</para>
  <para style="q2" vid="AMO 5:2">ፔ ዓጮይዳ ኬኤሪንቴ ዓሲ ማዔኔ።<verse eid="AMO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3"/>ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢ ሂዚ ጋዓኔ፦ «ፔቴ ዒስራዔኤሌ ካታማፓ ሺያ ዓሲ ዖሎሮ ዴንዳንዳኔ፤ ሃይቁዋዖ ሼምፖና ዓታንዳዞንሢ ጋዓንቴ ፄኤታ ሌሊ ማዓንዳኔ፤ ሜሌ ካታማፓ ሃሣ ፄኤታ ዓሲ ዖሎሮ ዴንዳንዳኔ፤ ዬያቶፓኣ ቶሊ ሙካንዳዞንሢ ታጶ ሌሊ ማዓንዳኔ።»<verse eid="AMO 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ዒስራዔኤሌ ዴሬዮቴ! ታና ኮይ ታ ባንሢ ማዑዋቴ፤ ሼምፔና ዒንሢ ናንጋንዳኔ፤ <verse eid="AMO 5:4"/><verse number="5" style="v" sid="AMO 5:5"/>ቤርሳቤ ዴንዲፖቴ፤ ቤኤቴኤሌ ዶዒ ቤሲ ባይቃንዳኔ፤ ጌልጌላይዳ ናንጋ ዓሳኣ ዲዒንቲ ሜሌ ዓጪ ዔውታንዳኔ፤ ዬያሮ ቤኤቴሌያ ማዖም ጌልጌላ ዴንዳኒ ኮይፖቴ።»<verse eid="AMO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 5:6"/>ዬያ ሃሺጋፓ ናንጊና ናንጋ ጎዳ ባንሢ ማዑዋቴ፤ ሼምፔና ዒንሢ ናንጋንዳኔ፤ ዒንሢ ዬያይዲባኣቴ ናንጊና ናንጋ ጎዳ ታሚጉዲ ዮሴፔ ማኣሮ ሙዓንዳኔ፤ ዬይ ታማ ቤኤቴሌይዳ ናንጋ ዓሶ ሙይ ባይዛንዳኔ፤ ዬያ ታሞ ዎዻንዳ ዓሲ ጴዻዓኬ። <verse eid="AMO 5:6"/><verse number="7" style="v" sid="AMO 5:7"/>ዒንሢ ፒዜ ዎጊሢ ሃሺ ዎጎ ዎቢሻ ዓሳ፤ ጊንሣ ሃሣ ጎኑሞ ሉኡዙሞ ማሂ ሺርሺ ላኣማ ዓሳ ዒንሢና ባዴዔ!<verse eid="AMO 5:7"/></para>
  <para style="q">
    <verse number="8-9" style="v" sid="AMO 5:8-9"/>ፑንጫሮንታ ዛኣፖ ዦኦጋሢንታ</para>
  <para style="q2" vid="AMO 5:8-9">ዱማ ዱማ ዦኦጋሢ ማዤ፤</para>
  <para style="q2" vid="AMO 5:8-9">ዹሞ ካርዚ ፖዒሲ፥ ፖዔ ሮኦሮዋ ዹሚሲ</para>
  <para style="q" vid="AMO 5:8-9">ዼኤፖ ባዞ ዋኣፆዋ ፔ ሼና ጌዔ ጎይፆ ዓይሢ</para>
  <para style="q2" vid="AMO 5:8-9">ሳዖይዳ ጊንሣ ሾኦቲሳሢ</para>
  <para style="q2" vid="AMO 5:8-9">ዶዶ ዓሶ ዔርቲባኣንቴ ባይዛሢ</para>
  <para style="q2" vid="AMO 5:8-9">ኬልቂ ዲርቂ፥ ዋርዲዮና ካታሞዋ ዶይሲ ባይዛሢ</para>
  <para style="q" vid="AMO 5:8-9">ሱንፃ ዒዛኮ ናንጊና ናንጋ ጎዳኬ። <note caller="-" style="x"><char style="xo" closed="false">5፡8-9 </char><char style="xt" closed="false"><ref loc="JOB 9:9">ዒዮ. 9፡9</ref>፤ <ref loc="JOB 38:31">38፡31</ref>።</char></note><verse eid="AMO 5:8-9"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="10" style="v" sid="AMO 5:10"/>ዎጎ ዎጎ ጶኦኮይዳ ዞሪ ጎራ ዓሶ ዒንሢ ዒፄኔ፤ ጎኔ ጌስታ ዓሶዋ ዒንሢ ሼናዼኔ። <verse eid="AMO 5:10"/><verse number="11" style="v" sid="AMO 5:11"/>ማንቆ ዓሶ ዒንሢ ሄርቄኔ፤ ዎልቄና ዒንሢ ዔያቶ ሃኣኮ ጊኢሪሼኔ፤ ዓርሲ ኮሾና ሹቺና ማኣሮ ዒንሢኮ ዒንሢ ማዤኔ፤ ጋዓንቴ ዒንሢ ዒኢካ ናንጋዓኬ። ዎይኖ ዒንሢ ቱኬኔ፤ ጋዓንቴ ዬያኮ ካፄ ዓኣፖ ጩኡጲ ኮሾ ዑዦ ዒንሢ ዑሽካዓኬ። <verse eid="AMO 5:11"/><verse number="12" style="v" sid="AMO 5:12"/>ዻቢንታ ዒንሢኮ ዋኣዺ ዺቤቴያ ጎማኣ ዒንሢኮ ዎያይዲ ኩሜቴያ ታኣኒ ዔራኔ፤ ፂሎ ዓሶኮ ዒንሢ ካራ ባይዛኔ፤ ዴሜና ዒንጎ ሚኢሾ ዔኪ ዔኪ ዎጎ ዎጎ ጶኦኮይዳ ፒዜ ዎጊፆ ሃሺ ዒንሢ ዎቢሻኔ። <verse eid="AMO 5:12"/><verse number="13" style="v" sid="AMO 5:13"/>ዬይ ፑርታ ዎዴ ማዔሢሮ ማሊ ጶቂሣ ዓሲ ዬያጉዴ ዎዶና ዚቲ ጋዓኔ።<verse eid="AMO 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 5:14"/>ሼምፔና ናንጋኒ ኮሺ ባኣዚ ማዹዋቴ፥ ፑርታ ማዺፖቴ፤ ዒንሢ ዬማይዴቴ ዒንሢ ጌዔ ጎይፆጉዴያ ናንጊና ናንጋ ጎዳ ማዔ ቢያ ባኮ ዎይሣ ፆኦዛሢ ዒንሢና ዎላ ማዓንዳኔ። <verse eid="AMO 5:14"/><verse number="15" style="v" sid="AMO 5:15"/>ፑርታ ዒፁዋቴ፥ ኮሺ ናሽኩዋቴ፤ ዎጎ ዎጎ ጶኦኮይዳ ፒዜ ዎጊፆ ሃሺ ዎቢሺፖቴ፤ ዬያ ዒንሢ ማዼቴ ናንጊና ናንጋ ጎዳ ማዔ ቢያ ባኮ ዎይሣ ጎዳሢ ፒኢጫዺ ዓቴ ዒስራዔኤሌ ዓሶ ጎዖንቴ ማኣራንዳያናንዳኔ።<verse eid="AMO 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16"/>ናንጊና ናንጋ ጎዳ ማዔ ቢያ ባኮ ዎይሣ ጎዳሢ ሂዚ ጋዓኔ፦ «ካታሞ ሳዞ ጎይፆና ዴራ ቡካ ጶኦኮናይዳ ሜታዺ ዒላቶ ዑኡሲ ዋይዚንታኔ፤ ጎዦ ጎሽካ ዓሳኣ ዬኤፖሮ ዔኤሊንቲ ዬዒ፥ ቃዪ ዬኤካ ዓሶና ዎላ ሃይቄ ዓሶ ዬኤካንዳኔ። <verse eid="AMO 5:16"/><verse number="17" style="v" sid="AMO 5:17"/>ዎይኖ ቱኮ ጎዦይዳ ቢያ ዬኤፒ ዬኤኪንታንዳኔ፤ ዬይ ቢያ ያዺ ማዓንዳሢ ታኣኒ ዒኢና ዖኦኪ ዓኣዻንዳሢሮኬ» ዬያ ጌዔሢ ናንጊና ናንጋ ጎዳኬ።<verse eid="AMO 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="AMO 5:18"/>ናንጊና ናንጋ ጎዳ ሙካንዳ ኬሎ ዓፃዻ ዓሳ ዒንሢና ባዴዔቴ! ዬይ ኬላ ዹሚኬ፤ ፖዒቱዋኣሢሮ ዬያ ኬሎ ዎይታዛ ዒንሢ ዓፃዻይ? <verse eid="AMO 5:18"/><verse number="19" style="v" sid="AMO 5:19"/>ዬይ ኬላ ፔቴ ዓሲ ዞቢ ዳውሴም ጳሽኪ ዴንዲቤቃ ሜሌ ፑርታ ቦዖ ካኣሜም ዬያፓኣ ቶሊ ጳሽኪ ፔኤኮ ጋሮ ጌላዖ ኬኤፆኮ ኮጮይዳ ኩቺ ጌሣዛ ሾኦሺ ዻዔ ዓሲ ዒንሢ ማሃንዳኔ። <verse eid="AMO 5:19"/><verse number="20" style="v" sid="AMO 5:20"/>ናንጊና ናንጋ ጎዳ ዎጎ ዎጋ ኬሎና ዹዹማንዳኔ፥ ዒንሢም ፖዓዓኬ፤ ዬና ኬላ ፔቴታዖ ፖዒ ጴዹዋያ ሻኔ ዹሚ ኬሊ ማዓንዳኔ።<verse eid="AMO 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="AMO 5:21"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ሌዓ ሌዓ ዒንሢ ቦንቻ ቦንቾ ቢያ ታኣኒ ዒፂ ቶቶኦቻኔ፤ ዒንሢ ካኣዦሮ ቡካ ቡኪፃኣ ታና ዎዛሱዋሴ። <verse eid="AMO 5:21"/><verse number="22" style="v" sid="AMO 5:22"/>ሚቺ ዒንጎ ባኮንታ ሃኣኮ ዒንጊፆንታ ታኣም ዒንሢ ሺኢሺ ዒንጌቴያ ታኣኒ ዔካያቱዋሴ፤ ፔቱሞና ዒንጎ ዒንጊፆሮ ዒንሢ ሹካ ማሎ ቆልሞ ታኣኒ ሺሪ ዛጋዓኬ። <note caller="-" style="x"><char style="xo" closed="false">5፡22 </char><char style="xt" closed="false"><ref loc="ISA 1:11-14">ዒሲ. 1፡11-14</ref>።</char></note> <verse eid="AMO 5:22"/><verse number="23" style="v" sid="AMO 5:23"/>ታና ቦንቻኔ ጌይ ዒንሢ ዓይናዺ ዒላታ ዒላቶ ሃሹዋቴ፤ ዒንሢ ዋርቃ ጎኦሎ ዑኡዞዋ ታኣኒ ዋይዛዓኬ። <verse eid="AMO 5:23"/><verse number="24" style="v" sid="AMO 5:24"/>ዬያ ማዻኔ ጌይ ሺሪፆይዳፓ ፒዜ ዎጌ ዎርዚጉዲ፤ ጊንሣ ሃሣ ፂሉሞ ማዾዋ ዓልቂ ዎታ ዋኣሢጉዲ ጎዒሱዋቴ።<verse eid="AMO 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="AMO 5:25"/>«ዒስራዔኤሌ ዴሬዮቴ! ጎኔና ሂንዳ ዖይዲታሚ ሌዔ ዓሲ ናንጉዋ ዳውሎይዳ ዒንሢ ሃንቴያና ዱማ ዱማ ዒንጎ ባኣዚ ታኣም ዒንሢ ዒንጌኖ? <note caller="-" style="x"><char style="xo" closed="false">5፡25 </char><char style="xt" closed="false"><ref loc="ACT 7:42-43">ዳኪ. ማዾ 7፡42-43</ref>።</char></note> <verse eid="AMO 5:25"/><verse number="26" style="v" sid="AMO 5:26"/>ዒማና ዒንሢ ዒንሢሮ ኮሼ፥ ዒንሢ ፆኦዛሢ ሞሎኬም ዓፒሎና ማዢንቴ ካኣዦ ማኣሮንታ ሬፓኔ ጌይንታሢኮ ዦኦጎ ማሊሲ ዒንሢ ኮሼ ባኮ ኬዲ ኬዲ ሃንቴኔ። <verse eid="AMO 5:26"/><verse number="27" style="v" sid="AMO 5:27"/>ዬያሮ ዴማስቆይዳፓ ዲዒሲ ታ ዒንሢ ሃኬ ዓጪ ዔኪ ዳካንዳኔ» ዬያ ጌዔሢ ታና፥ ናንጊና ናንጋ ጎዳ ማዔ ቢያ ባኮ ዎይሣ ፆኦዛሢኬ።<verse eid="AMO 5:27"/></para>
  <chapter eid="AMO 5"/>
  <chapter number="6" style="c" sid="AMO 6"/>
  <para style="s1">ዒስራዔኤሌይዳ ዓጊንታኒ ጊኢጌ ሜቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 6:1"/>ዒስራዔኤሌ ዴራ ዔያቶኮ ሱኡጋ ዔያቶ ማኣዳንዳጉዲ ማኣዶ ኮይ ሙካኔ፤ ዬያታ ሱኡጋ ጋዓንቴ ፂዮኔይዳ ሜታባኣያ ኮንጋቲ ዴዒ፥ ሳማሪያ ዹኮይዳኣ ሂርጊሻ ባኣዚ ባኣያ ማዒ ናንጋሢሮ ዬያቶም ባዴዔ! <verse eid="AMO 6:1"/><verse number="2" style="v" sid="AMO 6:2"/>ሂንዳ ካልኔ ካታሞ ዴንዲ ዔኤቢ ዛጉዋቴ፤ ዬይና ጌይ ሃሣ «ሃማቴ» ጌይንታ ዼኤፖ ካታሜሎ ዴንዱዋቴ፤ ሃሣ ጊንሣ ፒሊስፄኤሜ ዓሶ ካታሞ ማዔዞ፥ ጋኣቴ ኬዲ ዛጉዋቴ፤ ዬንሢ ዒንሢኮ ላምዖ ካኣቶ ዓጮይዳፓ ባሻያዳ? ዔያቶኮ ዓጮ ዳልጉማ ዒንሢሲዳፓ ባሼ ዳልጋያዳ? <verse eid="AMO 6:2"/><verse number="3" style="v" sid="AMO 6:3"/>ዒንሢ፦ «ፑርታ ኬሊ ዑካዺ ሙኪንዱዋሴ» ጌይ ማሊ ዴሮ ሄርቂ ዎይሢፆይዳ ጳሽካኔ። <verse eid="AMO 6:3"/><verse number="4" style="v" sid="AMO 6:4"/>ዳርሲ ዓቺና ኮሾና ዓልጋይዳ ዒንሢ ላሃኔ፤ ጊንሣ ሃሣ ሂርኬ ማዔ ሚዛጶ ዓርሶይዳኣ ኮሽኪ ዒንሢ ዴዓኔ፤ ማራቶ ባኣካፓ ሃጊ ዔቃ ማራናይ፥ ባኣቶ ባኣካፓኣ ሃጊ ዲጫ ናኣሪ ሹኪ ሹኪ ሙይ ዒንሢ ዎዛዻኔ። <verse eid="AMO 6:4"/><verse number="5" style="v" sid="AMO 6:5"/>ዒንሢ ካኣቲ ዳውቴጉዲ ዓይኑሞ ኬሲ ኬሲ ጎኦላኣ ዋርቂ ኮርጋኔ። <verse eid="AMO 6:5"/><verse number="6" style="v" sid="AMO 6:6"/>ዎይኖ ዑዦ ዑሽኮ ዓንጎናቱዋንቴ ዖቶና ዒንሢ ዑሽካኔ፤ ሚርጌ ሚኢሼና ሻንቂንታ ሳውቃ ሼቶ ዒንሢ ቲሽታኔ፤ ዮሴፔ ዜርፆይዳ ሄሌ ባይሲንቶ ዛሎ ጋዓንቴ ዒንሢ ፔቴታዖ ዖዩዋሴ፤ ዬያ ባኮ ቢያ ዒንሢ ማዺሺራሢሮ ዒንሢና ባዴዔቴ! <verse eid="AMO 6:6"/><verse number="7" style="v" sid="AMO 6:7"/>ዬያሮ ዲዒንቶኮ ኮይሪ ዒንሢ ማዓንዳኔ፤ ዎዛዺ ኮርጊ ዒንሢ ናንጋ ናንጎኮ ዬማ ጋፖ ማዓንዳኔ።<verse eid="AMO 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8"/>ናንጊና ናንጋ ጎዳ ማዔ ቢያ ባኮ ዎይሣ ፆኦዛሢ፦ «ያይቆኦቤኮ ዖቶርሙሞ ታ ዒፄኔ፤ ካኣታ ናንጋ ሚዛጶ ማኣሮ ታ ዔያቶኮ ሻኣኪንቴኔ፤ ዬያሮ ታኣኒ ካታሜሎንታ ዒኢካ ናንጋ ዴሮንታ ቢያ ሞርኬም ዓኣሢ ዒንጋንዳኔ» ጌይ ፔ ሱንፆ ጌፒ ጫኣቄኔ።<verse eid="AMO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9"/>ፔቴ ማኣሪዳ ናንጋ ዓሲፓ ታጶ ዓሲ ዓቴቴያ ዔያታ ሃይቃንዳኔ። <verse eid="AMO 6:9"/><verse number="10" style="v" sid="AMO 6:10"/>ሃይቄ ዓሶኮ ዒጊኒ ማዓ ፔቴ ዓሲ ሌዞ ዔኪ ዱኡካኒ<note caller="+" style="f"><char style="fr" closed="false">6፡10 </char><char style="fq" closed="false">ዱኡካኒ፦ </char><char style="ft" closed="false">ጋዓዞ፦ ቤርታ ማፃኣፓ ፃኣፒንቴ ዔብሬ ዓሶ ሙኡጮና «ሚቻኒ» ጋዓኔ፤ ዬኖ ዎዶና ሃይቄ ሌሲ ሚቺሢ፥ ጊንሣ ሃሣ ታሚ ዔኤሥሢ ዬያ ዓሢ ቦንቺ ዱኡኪሢጉዴያኬ።</char></note> ሙካዖ፥ ዒኢካ ኬኤፃ ዓኣ ፔቴ ዓሲ ዔኤሊ፦ «ኔኤና ዎላ ዓቲ ዓኣ ሜሌ ዓሲ ዓኣ?» ጌይ ዖኦጫንዳኔ፤ ዬይ ዓሢ፦ «ፔቴታዖ ባኣሴ!» ጋዓንዳኔ፤ ዒማና ዬይ ዖኦጫ ዓሢ፦ «ዚቲ ጌዔ! ናንጊና ናንጋ ጎዳኮ ሱንፆ ፔጋሲ ኑ ዔኤላንዳያ ኮይሱዋሴ» ጋዓንዳኔ።<verse eid="AMO 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 6:11"/>ናንጊና ናንጋ ጎዳ ዓይሤም ዼኤፖ ዼኤፖ ኬኤፃ ዶዓንዳኔ፤ ዻኮ ዻኮ ኬኤፃኣ ዶዒ ቡርሺንቲ ቡርሺንቲ ኩማንዳኔ። <verse eid="AMO 6:11"/><verse number="12" style="v" sid="AMO 6:12"/>ፓሮ ቶጋ ዓሲ ሹቺ ዑሢዳ ሳጋራኒ ዳንዳዓ? ጎሺ ጎሽካ ዓሲ ሃሣ ዒኢካ ጌማይ ዋኣፂ ጎሽካኒ ዳንዳዓ? ዒንሢ ጋዓንቴ ፒዜ ዎጎ ዎጊፆ ዎዎዻ ዼኤሻ ማሂ፤ ጊንሣ ሃሣ ጎኑሞዋ ዋላንጋጉዲ ጫንቺ ባኣዚ ማሂ ላኣሜኔ።<verse eid="AMO 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 6:13"/>ዒንሢ ፓሡዋ ባኣዚና ዎዛዻኔ፤ ዎልቆዋ ዒንሢ ዒንሢሮ ዴንቄያ ዒንሢም ማላኔ።<verse eid="AMO 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 6:14"/>ናንጊና ናንጋ ጎዳ ማዔ ቢያ ባኮ ዎይሣ ፆኦዛሢ፦ «ዒስራዔኤሌ ዴሬዮቴ! ሃማቴ ካታሞ ጌሎ ካራፓ ዴንዲ ዓሬባ ዶኦጮ ሄላንዳኣና ካራ ዒንሢኮ ባይዚ ዖሊ ዒንሢ ሜታሳንዳ ዓሲ ታኣኒ ዒንሢዳ ዳካንዳኔ» ጋዓኔ።<verse eid="AMO 6:14"/></para>
  <chapter eid="AMO 6"/>
  <chapter number="7" style="c" sid="AMO 7"/>
  <para style="s1">ዓቢሢ ሙካንዳያ ማዒፃ ኬኤዚንቴሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1"/>ሃኣካ ጮኦሪንቲ ካኣቲም ዒንጎ ሃኣካ ዒንጊንቴስካፓ ቤዞይዳ ዉኡኬ ማዒ ባቃሌ ሃኣኮ ሙዓንዳ ዓቢሢ ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢ ቃንቂሳያ ታኣም ፔጋሲ ዻዌኔ፤ <verse eid="AMO 7:1"/><verse number="2" style="v" sid="AMO 7:2"/>ዬይ ዓቢፃ ሳዖይዳ ዓኣ ዓኣዔ ባኮ ሙይ ባይዜሢ ታ ዛጋዖ፦ «ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢዮ! ሃዳራ ዴሮኮ ዻቢንቶ ዓቶም ጌዔ! ኔ ዬያይዴቴ ያይቆኦቤ ዎይቲ ዓታንዳይ? ዒዚ ላኣፓቱዋዓዳ!» ጌይ ሺኢቄኔ።<verse eid="AMO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3"/>ዬያሮ ናንጊና ናንጋ ጎዳ ዔያቶ ሚጪንቲ፦ «ዬያ ኔ ዛጌ ባኮ ታ ማዻዓኬ፥ ዓቶንጎ!» ጌዔኔ።<verse eid="AMO 7:3"/></para>
  <para style="s1">ታሚ ዳኪንታንዳያ ማዒፃ ኬኤዚንቴሢ</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4"/>ሃሣ ጊንሣ ናንጊና ናንጋ ጎዳ ታሚ ሳዖይዳ ዓጋኒ ጊኢጊንቴያ፥ ዬይ ታማ ዼኤፖ ባዞ ዋኣፆ ጉቤ ሙይ ፃኣዺሲ ባይዚ ሳዖ ሙይሢ ዓርቄያ ታና ዒዚ ዻዌኔ። <verse eid="AMO 7:4"/><verse number="5" style="v" sid="AMO 7:5"/>ዬያሮ ሃሣ ታኣኒ፦ «ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢዮ! ዬያ ኔ ሃሻንዳጉዲ ታ ኔና ሺኢቃኔ! ኔ ዬያይዴቴ ያይቆኦቤ ዎይቲ ዓታንዳይ? ዒ ላኣፓቱዋዓዳ!» ጌይ ሺኢቄኔ።<verse eid="AMO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6"/>ዬያሮ ናንጊና ናንጋ ጎዳ ዔያቶ ሚጪንቲ፦ «ዓቶንጎ! ዬያኣ ታ ማዻዓኬ» ጌዔኔ።<verse eid="AMO 7:6"/></para>
  <para style="s1">ማኣሪ ማዢንታኣና ፒዜ ማዒፆ ሚፂ ዛጎ ዓንጊ (ቱምቢ)</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7"/>ዬያጉዲ ሃሣ ናንጊና ናንጋ ጎዳ ቱምቢ ጌይንታ ባኮና ሚፂ ዛጊ ማዦና ኬኤሌ ዲሢ ዓሽካ ዔቂ ዓኣያ፥ ኩጮይዳ ዬኖ ቱምቢ ጎዖ ባኬሎ ዓርቂ ዓኣያ ታኣም ፔጋሲ ዻዌኔ፤<figure style="fig" alt="Plumb line" file="HK00126B.TIF" size="col" ref="7፡7">ቱምቢ ጌይንታ ሚፂፆ ዓንጎ </figure> <verse eid="AMO 7:7"/><verse number="8" style="v" sid="AMO 7:8"/>ዒማና ናንጊና ናንጋ ጎዳ ታ ኮይላ፦ «ዓሞፄ! ኔኤም ዓይጌ ጴዻይ?» ጌይ ዖኦጬኔ።</para>
  <para style="p" vid="AMO 7:8">ታኣኒያ፦ «ቱምቢ ታ ዴንቃኔ» ጌዔኔ።</para>
  <para style="p" vid="AMO 7:8">ዬካፓ ናንጊና ናንጋ ጎዳ፦ «ቱምቢና ዛጊ ሚፂ ማዢንቲባኣ ኬኤሌ ዲሢጉዲ ታኣኮ ዴራ ዒስራዔኤሌ ዎቢ ታኣም ጴዼሢሮ ሃና ዓንጌላ ዒስራዔኤሌኮ ዎቢፆ ዻዋያኬ፤ ዬያሮ ታኣኒ ዔያቶይዳ ሜቶ ዓጉዋ ሃሻዓኬ። <verse eid="AMO 7:8"/><verse number="9" style="v" sid="AMO 7:9"/>ዪሳኣቄና ዒዛኮ ናኣቶኮ ናኣቶ ሄላንዳኣና ዔያታ ዚጊ ካኣሽካ ዼጌ ቤዛ ዶዒ ባይቃንዳኔ፤ ዒስራዔኤሌኮዋ ዱማዼያ ጌኤሺ ማዔ ቤዛ ሻሂንቲ ባዔ ቤሲ ማዓንዳኔ፤ ካኣቲ ዒዮርቢዓሜኮ ካኣቱሞ ታኣኒ ዶይሲ ባይዛንዳኔ» ጌይ ታኣም ኬኤዜኔ።<verse eid="AMO 7:9"/></para>
  <para style="s1">ዓሞፄና ዓሜሲያሴ ጌይንታ ዓሲስኬያና ዛላ ኬኤዚንቴ ሃይሴ</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10"/>ቤኤቴሌይዳ ቄኤሴ ማዒ ማዻ፥ ዓሜሲያሴ፦ «ዓሞፄ ጎዖሢ ዒስራዔኤሌ ዴሮ ባኣካ ዴዒ ኔኤም ዔቴ ቦኦካኔ፤ ዴራ ዒ ጋዓ ባኮ ቢያ ዋይዚ ዋይዚ ዴዓኒ ዳንዳዑዋሴ። <verse eid="AMO 7:10"/><verse number="11" style="v" sid="AMO 7:11"/>ዒዚ፦ ‹ዒዮርቢዓሜ ዖልዚዳ ሃይቃንዳኔ፤ ዒስራዔኤሌ ዴራኣ ፔ ዓጫፓ ዲዒንቲ ሜሌ ዓጪ ዔውታንዳኔ› ጋዓኔ።» ጋዓ ኪኢታ ዒስራዔኤሌ ዓጮ ካኣቲ ዒዮርቢዓሜም ዳኬኔ።<verse eid="AMO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12"/>ዓሜሲያሴ ዓሞፄም፦ «ፆኦሲ ፔጋሲ ዻዋ ባኮ ዛጋሦ! ማዒ ዪሁዳ ዴንዲጋፓ ዒኢካ ፆኦሲ ማሊፆ ኬኤዚ ኬኤዚ ኔኤም ዒንጎ ባኮ ሙይ ዒኢካ ናንጌ። <verse eid="AMO 7:12"/><verse number="13" style="v" sid="AMO 7:13"/>ቤኤቴኤሌ ጋዓንቴ ካኣቲ ዚጊ ፆኦሲ ካኣሽካ ቤሲ፤ ሃሣ ዺቦ ዴሮኮ ጌኤሺ ማኣሪ ማዔሢሮ ሃይካ ላሚ ፆኦሲ ማሊሢ ኬኤዚፖ» ጌዔኔ።<verse eid="AMO 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14"/>ዓሞፄ ማሃዖ፦ «ታኣኒ ሻኣቢ ማንፂ ሙዓያ፥ ሃሣ ቆልሞ ሄንቃያኬ፤ ፆኦሲ ማሊሢ ኬኤዛያና ፆኦሲ ማሊሢ ኬኤዛ ዓሲኮዋ ታኣኒ ናይቱዋሴ። <verse eid="AMO 7:14"/><verse number="15" style="v" sid="AMO 7:15"/>ታኣኒ ማራይ ሄንቃያታንቴ ዬይፓ ታና ዔኪ፦ ‹ዴንዴ፤ ታ ዴሮ ዒስራዔኤሌም ታ ማሊፆ ኬኤዜ› ጌይ ታና ዓይሤሢ ፔኤሮ ናንጊና ናንጋ ጎዳኬ። <verse eid="AMO 7:15"/><verse number="16" style="v" sid="AMO 7:16"/>ሃሢ ናንጊና ናንጋ ጎዳ ጋዓ ባኮ ዋይዜ፤ ኔኤኒ ጋዓንቴ፦ ‹ዒስራዔኤሌ ዓጮይዳ ፆኦሲ ማሊፆ ኬኤዚፖ፤ ዪሳኣቄ ዜርፆ ማዔ ዒስራዔኤሌ ዴሮም ፆኦሲ ቃኣሎ ኬኤዚፖ› ጌይ ታና ላኣጌኔ። <verse eid="AMO 7:16"/><verse number="17" style="v" sid="AMO 7:17"/>ዬያሮ ዓሜሲያሴ! ናንጊና ናንጋ ጎዳ ኔኤም ሂዚ ጋዓኔ፦ ‹ኔኤኮ ማቻ ካታሞይዳ ዞኦስካ ኮኦማያ ማዓንዳኔ፤ ዓቲንቆንታ ዉዱሮ ናኣቶንታ ኔኤኮ ዖልዚና ሃይቃንዳኔ፤ ኔኤኮ ዴኖ ሜሌ ፃንጎ ማዔ ዴራ ዎዳራ ጎቺ ፓቂንቲ ዔካንዳኔ፤ ኔኤኒ ሜሌ ዴሮ ዓጫ ዴንዲ ሃይቃንዳኔ፤ ዒስራዔኤሌ ዴራ ሉኡዙሞባኣያ ፔ ዓጫፓ ዲዒንቲ ዔውታንዳኔ› » ጌዔኔ።<verse eid="AMO 7:17"/></para>
  <chapter eid="AMO 7"/>
  <chapter number="8" style="c" sid="AMO 8"/>
  <para style="s1">ሚሢ ዓኣፒ ካፄያ ኮታ ኩሙሢ ፆኦሲ ዓሞፄም ዻዌሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1"/>ናንጊና ናንጋ ጎዳ ማዔ ፆኦሲ ሜሌ ባኣዚ ታኣም ፔጋሲ ዻዌኔ፤ ዬይ ዓይጎዳይ ጌዔቴ ኮታ ኩሙሢ፥ ሚሢ ዓኣፒ ካፄያ ታኣኒ ዛጌኔ፤ <verse eid="AMO 8:1"/><verse number="2" style="v" sid="AMO 8:2"/>ናንጊና ናንጋ ጎዳ ታና፦ «ኔኤም ዓይጌ ጴዻይ?» ጌይ ዖኦጬኔ።</para>
  <para style="p" vid="AMO 8:2">ታኣኒ፦ «ሚሢ ዓኣፒ ካፄያ ኮታ ኩሙሢ ዴንቃኔ» ጌይ ማሄኔ።</para>
  <para style="p" vid="AMO 8:2">ናንጊና ናንጋ ጎዳ፦ «ታ ዴሮ ዒስራዔኤሌኮ ጋፒንሢ ሄሌኔ፤ ሃይፓ ሴካ ማይ ታ ዔያቶይዳ ሜቶ ዓጉዋ ሃሻዓኬ።»<verse eid="AMO 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3"/>«ጌኤዦ ማኣሮይዳ ዔያታ ኮርጋ ኮፃ ዬኤፒ ባንሢ ሺራንዳኔ፤ ሚርጌ ዓሲኮ ሌሲ ቢያ ቤስካ፥ ዚቲ ጌይ ኬኤሪንታንዳኔ» ጌይ ታኣም ኬኤዜኔ።<verse eid="AMO 8:3"/></para>
  <para style="s1">ዒስራዔኤሌኮ ሎኦሚፆ</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 8:4"/>ዒንሢ ሜታዼ ዓሶ ሄርቂ ዎይሣ ዓሳ፤ ጊንሣ ሃሣ ማንቆ ዓሶ ዓጮይዳፓ ባይዛ ዓሳ! ዋይዙዋቴ! <verse eid="AMO 8:4"/><verse number="5" style="v" sid="AMO 8:5"/>ዒንሢ፦ «ሃኣኮ ኑኡኮ ኑ ሻንቾም ዓጊኖ ፄኤሮ ቦንቻ ዑኬና ጋፓኣባሽ! ዛርጋሢ ኑኡኮ ኑ ቦኦካ ሻንቾም ሃውሾ ኬላ ዑኬና ኩዳኣባሽ! ዬይ ቦንቾ ኬላ ጋፔቴ ሃኣኮ ማኮ ሙርሶ ኑ ዻኪሲ ዺቢ ሚኢሼ ኑ ዔካንዳኔ፤ ፒዜቱዋ ዴኤሡሞ ዔሮ ባኣዚና ዴሮ ኑ ጌሻንዳኔ፤ <verse eid="AMO 8:5"/><verse number="6" style="v" sid="AMO 8:6"/>ዛርጎኮ ሙርቶዋ ዓይሱዋዖ ኑ ሻንቻንዳኔ፤ ማንቆ ዓሶ ሚኢሼና፥ ጊንሣ ሃሣ ሜታዼ ዓሶ ፔቴ ዓሲ ዓኣሢንታ ዱርሲና ሻንቂ ዔኪ ኑኡም ማዺሻንዳኔ» ጋዓኔ።<verse eid="AMO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7"/>ያይቆኦቤና ዜርፆናም ሄርሺንቲ ጉሙርቆያ ማዔ፥ ናንጊና ናንጋ ጎዳ ፔ ሱንፆ ጌፒ ሂዚ ጌይ ጫኣቄኔ፦ «ዔያታ ማዼ ባኮ ቢያ ታኣኒ ዋላዓኬ። <verse eid="AMO 8:7"/><verse number="8" style="v" sid="AMO 8:8"/>ዬያ ዛሎና ሳዓ ዓጊፃንዳኔ፤ ዬኖ ሳዖይዳ ናንጋ ዓሳ ቢያ ዬኤካንዳኔ፤ ሳዓ ካራና ዓባዬ ዎሮጉዲ ፖኦጊ ሌካ ዔቃንዳኔ፤ ዬካፓኣ ጊንሣ ሊካ ሳዓ ኬዳንዳኔ።» <verse eid="AMO 8:8"/><verse number="9" style="v" sid="AMO 8:9"/>ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢ ሂዚ ጋዓኔ፦ «ሃጊ ዓባ ሳዛ ዓኣንቴ ዓቦ ታኣኒ ጌልዛንዳኔ፤ ዓባ ዹኡሲ ዓኣንቴ ሳዖ ታኣኒ ዹሚሻንዳኔ። <verse eid="AMO 8:9"/><verse number="10" style="v" sid="AMO 8:10"/>ዒንሢ ሌዖይዳ ቦንቺ ዎዛዻ ዎዞ ዖዪሢ ባንሢ፥ ኮፆዋ ዒንሢኮ ታኣኒ ዬኤፒ ባንሢ ሺርሻንዳኔ፤ ቢያሢ ዒንሢ ሲዬ ፓቲሌ ማይንታንዳጉዲ፥ ቶኦኮዋ ዒንሢኮ ዒንሢ ሜኤዳንዳጉዲ ታ ማዻንዳኔ፤ ዬኖ ኬሎ ናዖማ ፔቴ ሜቴታዖ ሃይቄ ዓሲ ዬኤካያጉዲ ፑርታ ሜቶ ኬሊ ታኣኒ ዒንሢም ማሃንዳኔ።»<verse eid="AMO 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 8:11"/>ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢ ሂዚ ጋዓኔ፦ «ሳዖይዳ ታኣኒ ናይዚ ዳካንዳ ዎዴ ዬዓንዳኔ፤ ዬኖ ዎዶና ዓሳ ናይዺንታንዳሢና ዼኤቢንታንዳሢ ታኣኮ ቃኣሎ ዴንቂ ዋይዞ ባሺንቲኬ፥ ሙዖ ባኣዚና ዋኣሢና ባይዚቱዋሴ፤ ዬያ ጌዔሢ ታና፥ ናንጊና ናንጋ ጎዳኬ። <verse eid="AMO 8:11"/><verse number="12" style="v" sid="AMO 8:12"/>ዬኖ ዎዶና ዴራ ቢያ ዓጮኮ ኬዴኖ ዛላፓ ዾኦሎ ዛሎ ባንሢ፥ ዓባ ኬስካ ባንፃፓ ዓባ ጌላሢ ባንሢ ታኣኮ ቃኣሎ ዴንቃኒ ሃንቲ ሃንቲ ጉሪ ጳሽኪ ሜታዻንዳኔ፤ ጋዓንቴ ዔያታ ዴንቃዓኬ። <verse eid="AMO 8:12"/><verse number="13" style="v" sid="AMO 8:13"/>ሚዛጶ ዉዱሮ ናኣቶንታ ዶዶ ዓቲንቆ ናኣቶንታ ዬያ ዋኣፆ ዼኤባፓ ዔቄያና ላቢ ቃኣያዻንዳኔ፤ <verse eid="AMO 8:13"/><verse number="14" style="v" sid="AMO 8:14"/>ሳማሪያይዳ ‹ዓሺማ› ጌይንታ ላኣሎ ፆኦዜላ ሃይቆ! ጌይ ጫኣቃ ዓሶንታ ‹ዳኣኔ ፆኦሲ ሃይቆ!› ጊንሣ ሃሣ ‹ቤርሳቤ ፆኦሲ ሃይቆ!› ጌይ ጌይ ጫኣቃ ዓሳ ቢያ ላሚ ፔቴታዖ ዔቃኑዋ ጎይሢ ጋፒ ሎኦማንዳኔ።»<verse eid="AMO 8:14"/></para>
  <chapter eid="AMO 8"/>
  <chapter number="9" style="c" sid="AMO 9"/>
  <para style="s1">ናንጊና ናንጋ ጎዳ ዒስራዔኤሌይዳ ዓጋኒ ጊኢጌ ሜቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1"/>ናንጊና ናንጋ ጎዳ ዒንጎ ባኮ ዒንጎ ቤዞ ኮይላ ዔቂ ዓኣንቴ ታ ዛጌኔ፤ ዒዚ ታና ሂዚ ጌይ ዓይሤኔ፦ «ፃጶ ሄሊ ዓጊፃንዳጉዲ ጌኤዦ ማኣሮኮ ቱርቱሮ ሙስኩሎ ጳርቄ፤ ሜቂ ዓሶኮ ሶፖይዳ ዶዓንዳጉዲ ጳርቂ ሜንሤ፤ ዬያይዳ ሃይቁዋዖ ቶሊ ዓቴ ዓሶ ታኣኒ ጬንቻ ዓራፖና ኩርሳንዳኔ፤ ዓይጎ ዓሲያ ጳሽኪ ቶሊ ዓታዓኬ። <verse eid="AMO 9:1"/><verse number="2" style="v" sid="AMO 9:2"/>ሳዖ ቦኦኪ ጌሊ ዔያታ ዱኡቴቴያ ታ ዔያቶ ዒኢፓ ጎቺ ኬሳንዳኔ፤ ሌካ ጫሪንጮ ዔያታ ኬስኬቴያ ታ ዔያቶ ዒኢካፓ ኬይሳንዳኔ። <verse eid="AMO 9:2"/><verse number="3" style="v" sid="AMO 9:3"/>ቄርሜሎሴ ዹኮኮ ቶኦኮ ኬስኪ ዒኢካ ዔያታ ፑኔቴያ ኬሚ ታ ዔያቶ ዒኢፓ ዑርዚ፥ ዓርቃንዳኔ፤ ታ ቤርታፓ ፑናኒ ዼኤፖ ባዞ ዔቶ ዔያታ ኬዴቴ ዒኢካ ዓኣ ሾኦዣ ዔያቶ ዻዓንዳጉዲ ታኣኒ ዓይሣንዳኔ። <verse eid="AMO 9:3"/><verse number="4" style="v" sid="AMO 9:4"/>ሞርካ ዔያቶ ዲዒ ዔኪ ዴንዴቴያ ዒኢካ ዔያቶ ታኣኒ ዎዺሻንዳኔ፤ ታ ዔያቶ ፑርታ ዓኣፒና ዛጋንዳኔ፥ ኮሺ ዓኣፒና ዛጋዓኬ።»<verse eid="AMO 9:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="AMO 9:5"/>ዓጪ ማዔ ካራና ቢያ ዓባዬ ዎሮጉዲ</para>
  <para style="q2" vid="AMO 9:5">ሌካ ፖኦጊ ዔቂ፥ ጊንሣ ሳዓ ኬዲ ጌይ ጌይ ዓጊፃኔ፤</para>
  <para style="q2" vid="AMO 9:5">ናንጊና ናንጋ ጎዳ ማዔ ቢያ ባኮ ዎይሣ ጎዳሢ ሳዖ ካኣማዛ ዓልቃንዳኔ፤</para>
  <para style="q2" vid="AMO 9:5">ዒኢካ ናንጋ ዓሳኣ ቢያ ዬኤካንዳኔ።<verse eid="AMO 9:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 9:6"/>ፔኤኮ ናንጎ ማኣሮ ጫሪንጫ ማዤሢ</para>
  <para style="q2" vid="AMO 9:6">ሳዖኮ ዑፆይዳ ሌካ ዼጌ ቤዞ ኮሺ ዒኢካ ዶዲሼሢ</para>
  <para style="q" vid="AMO 9:6">ዼኤፖ ባዞ ዋኣፆዋ ፔ ባንሢ ዔኤሊ</para>
  <para style="q2" vid="AMO 9:6">ሳዖይዳ ጊንሣ ሾኦቲሳሢ ዒዛኬ፤</para>
  <para style="q2" vid="AMO 9:6">ሱንፃኣ ዒዛኮ ናንጊና ናንጋ ጎዳኬ።<verse eid="AMO 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 9:7"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ዒስራዔኤሌ ዴሬዮቴ! ታ ቤርቶይዳ ዒቶጲያ ዓሳ ዒንሢፓ ላኣፒ ጴዹዋሴ፤ ዒንሢ ታኣኒ ጊብፄ ዓጫፓ ኬሴሢጉዲ ፒሊስፄኤሜ ዓሶ ቄርፄኤሴፓ፥ ሶኦሪያ ዓሶ ቂኢሬፓ ዔኪ ታኣኒ ኬሲባኣዓዳ? ዔኪ ታኣኒ ኬሲናኣኮኬ። <verse eid="AMO 9:7"/><verse number="8" style="v" sid="AMO 9:8"/>ታና፥ ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢኮ ዓኣፓ ጎሞ ማዻ ዒስራዔኤሌ ካኣቶ ዓጮ ዴንቄኔ፤ ሳዖይዳፓ ጋፒሲ ታ ባይዛንዳኔ፤ ያዺ ማዔቴያ ያይቆኦቤ ዜርፆ ቲፅዲ ታኣኒ ባይዛዓኬ። ዬያ ጌዔሢ ታና፥ ናንጊና ናንጋ ጎዳኬ።<verse eid="AMO 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 9:9"/>«ዒስራዔኤሌ ዴራ ሜሌ ዴሮ ባኣካ ዜርቂንታንዳጉዲ ታኣኒ ዓይሣንዳኔ፤ ዔያታ ዜርቂንታንዳሢ ሶኦራ ዓንዳና ሃኣኮ ሶኦሪንታሢጎይፆኬ፤ ሶኦሮ ዓንዳ ዛላዻኣና ዲልባ ዴንዳንዳኣፓዓቴም ፔቴ ዓኣፒታዎ ፒንፂ ዴንዳዓኬ። <verse eid="AMO 9:9"/><verse number="10" style="v" sid="AMO 9:10"/>‹ፔቴታዖ ፑርታ ባኣዚ ኑና ሄላዓኬ› ጋዓ ታ ዴሮ ባኣኮይዳ ዓኣ ጎሞ ዓሳ ቢያ ዖልዚና ሃይቃንዳኔ።»<verse eid="AMO 9:10"/></para>
  <para style="s1">ዒስራዔኤሌ ዴራ ፔ ዓጮ ጊንሣ ሙካንዳያ ማዒፆ</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ዳውቴ ማኣሮ ዶዔሢ ጊንሣ ታ ዔቂሳንዳኔ፤ ኬኤሎ ዲፆዋ ጊንሣ ታ ኮሻንዳኔ፤ ሻሂንቴሢያ ማሂ ታ ዓካሳንዳኔ፤ ሚና ቤርታ ዓኣ ጎይፆማጉዲ ማሂ ጊንሣ ታኣኒ ማዣንዳኔ። <verse eid="AMO 9:11"/><verse number="12" style="v" sid="AMO 9:12"/>ዬያሮ ዔዶኦሜፓ ፒኢጫዺ ዓቴ ዓሶ፤ ጊንሣ ሃሣ ታ ሱንፆና ዔኤሊንቴ ሜሌ ዴሮ ቢያ ዔያታ ዻካላንዳኔ» ጋዓኔ ዬያ ባኮ ቢያ ማዺ ኩንሣንዳ፥ ናንጊና ናንጋ ጎዳ። <note caller="-" style="x"><char style="xo" closed="false">9፡12 </char><char style="xt" closed="false"><ref loc="ACT 15:16-18">ዳኪ. ማዾ 15፡16-18</ref>።</char></note><verse eid="AMO 9:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="AMO 9:13"/>ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦</para>
  <para style="q2" vid="AMO 9:13">«ሃኣኮ ጮኦራ ዓሳ ጮኦሪ ጋፒሱዋንቴ</para>
  <para style="q2" vid="AMO 9:13">ጎሽካ ዓሳ ጎሽኮሮ ዬዓንዳ ዎዴ፤</para>
  <para style="q2" vid="AMO 9:13">ዎይኖ ዓኣፖ ጩኡጳ ዓሳ ጩኡጲ ጋፑዋንቴ</para>
  <para style="q2" vid="AMO 9:13">ዎይኖ ቱካ ዓሳ ቱኮሮ ዬዓንዳ ዎዴ ሙካንዳኔ።</para>
  <para style="q" vid="AMO 9:13">ዬኖ ዎዶና ዹካፓ ዓኣሢ ዎይኔ ዑሺ ዓልቃንዳኔ፤</para>
  <para style="q2" vid="AMO 9:13">ጌሜራፓኣ ቢያ ዎይኔ ዑሺ ጎዓንዳኔ።<verse eid="AMO 9:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 9:14"/>ታኣኮ ዴሮ፥ ዒስራዔኤሌ ፔ ዓጮ ማሂ ታ ዔኪ ዬዓንዳኔ፤</para>
  <para style="q2" vid="AMO 9:14">ዶዒ ሻሂንቴ ካታሞ ጊንሣ ዔያታ ማዢ ዒኢካ ናንጋንዳኔ፤</para>
  <para style="q2" vid="AMO 9:14">ዎይኔ ቱኪ ዬያ ዎይኖኮ ዓኣፖና ኮሾ ዑዦ ዔያታ ዑሽካንዳኔ፤</para>
  <para style="q2" vid="AMO 9:14">ሜሌ ዬያጉዲ ዱማ ዱማ ሚሢያ ቱኪ ዓኣፖ ዔያታ ሙዓንዳኔ።<verse eid="AMO 9:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 9:15"/>ታ ዴሮ፥ ዒስራዔኤሌ</para>
  <para style="q2" vid="AMO 9:15">ዔያቶም ታ ዒንጌ ዓጮይዳ ዾቂ ታኣኒ ፃጲ ዳኪሲሳንዳኔ፤</para>
  <para style="q2" vid="AMO 9:15">ላሚ ያፓ ዔያታ ቱጊንቲ ዴንዳዓኬ።»</para>
  <para style="q" vid="AMO 9:15">ዬያ ጌዔሢ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢ፥ ታናኬ።<verse eid="AMO 9:15"/></para>
  <chapter eid="AMO 9"/>
</usx>
