<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LEV" style="id">- MAALE Full Bible</book>
  <para style="h">ሌዊ ዓሶ ማፃኣፖ</para>
  <para style="toc1">ሌዊ ዓሶ ማዾ ዛሎ ኬኤዛ ማፃኣፖ</para>
  <para style="toc3">ሌዊ. ዓኬ</para>
  <para style="toc2">ሌዊ ዓሶ ማፃኣፖ</para>
  <para style="mt1">ሌዊ ዓሶ ማዾ ዛሎ ኬኤዛ ማፃኣፖ</para>
  <para style="imt">ዓይፆ ካሮ</para>
  <para style="ip">ሌዊ ዓሶ ዛሎ ኬኤዛ ማፃኣፓ ኬኤዛሢ፦ ሚናኣ ዎዶና ዒስራዔኤሌ ዓሳ ካኣሽካ ካኣዦ ዎጎና ካኣሽኮ ዳምቦ ዛላኬ፤ ዬያጉዲ ሃሣ ዬኖ ካኣዦ ዎጎ ማዺ ኩንሢሳኒ ቢታንታ ዓኣ፥ ቄኤሶ ማዔዞንሢ ዛሎዋ ኬኤዛኔ።</para>
  <para style="ip">ማፃኣፔሎኮ ዼኤፖ ማሊፃ፦ ፆኦሲ ዱማዼያ ማዔሢ ኬኤዛያኬ፤ ዬያጉዲ ሃሣ ዴራ ዬያ ዱማዼያ ማዔ፥ ዒስራዔኤሌ ፆኦዛሢና ዎላ ዑኬ ማዔ ዒጊንቶና ዎዲ ዒዛ ካኣሽካኒ ኮይሳቴያ ፓይዲ ፓይዲ ኬኤዛኔ።</para>
  <para style="ip">ሃኖ ማፃኣፖይዳ ሚርጌና ዔርቴ ዓይሢፃ ዬሱሴ «ሃና ላምዓሳ ዼኤፖ ዓይሢፆኬ» ጌዔዞኬ፤ ዬይ ዓይሢፃ ሃኖ ማፃኣፖኮ (ዓይሢ 19፡18ይዳ) ጴዻኔ። ዒዞይዳ «ዓሲ ቢያ ዓዳ ኔና ማሂ ናሽኬ» ጋዓኔ።</para>
  <para style="iot">ማፃኣፔላ ዱማ ዱማ ዓርቄ ባኮ</para>
  <para style="io1">ፆኦሲም ዒንጎ ባኮኮ ዎጌ ዛላ (1፡1—7፡38)</para>
  <para style="io1">ዓኣሮኔና ናኣቶናኮ ቄኤሴ ማዓንዳጉዲ ዶኦሪንቲፆ (8፡1—10፡20)</para>
  <para style="io1">ጌኤሺ ማዔያና ማዒባኣ ባኮ ዛላ ኬኤዚንቴ ዎጌ (11፡1—15፡33)</para>
  <para style="io1">ዓሶኮ ጎሞ ጌኤሾ ኬሎ ዛላ (16፡1-34)</para>
  <para style="io1">ፆኦሲም ዱማዺ ናንጎ ናንጊና ካኣሽኮ ዎጌ ዛላ (17፡1—27፡34)</para>
  <chapter number="1" style="c" sid="LEV 1"/>
  <para style="s1">ፆኦሲም ሚቺ ዒንጊ ካኣሽኮ ካኣዦ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 1:1"/>ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮይዳፓ ናንጊና ናንጋ ጎዳ ሙሴ ዔኤላዖ ሂዚ ጌይ ዓይሤኔ፦ <verse eid="LEV 1:1"/><verse number="2" style="v" sid="LEV 1:2"/>ዒስራዔኤሌ ዴራ ታኣም ዒንጋ ባኮ ዒንጋ ዎዶና ዔያታ ካፓኒ ኮይሳ ዎጋ ያዺኬ፦</para>
  <para style="p" vid="LEV 1:2">ፔቴ ፔቴ ዓሳ ዒንጎ ባኮ ታኣም ዒንጋ ዎዶና ፔኤኮ ባኣቶፓ፥ ማራቶፓ፥ ዋኣሮፓ ማዔቴያ ዒንጎንጎ፤ <verse eid="LEV 1:2"/><verse number="3" style="v" sid="LEV 1:3"/>ዬይ ዓሢ ባኣቶ ባኣካፓ ፔቴ ሚቺ ዒንጎ ዒንጊሢ ዒንጋኒ ኮዔቴ ዔኤቢ ቦሂሳ ባኣዚባኣ፥ ዚያ ጌማይ ዶኦሪ ዔኪ ሙኮንጎ፤ ዬይያ፦ ናንጊና ናንጋ ጎዳ ናሽኪ ዔካ፥ ሚቺ ዒንጎ ዒንጊሢ ማዓንዳጉዲ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮኮ ጌሎ ካሮ ዛሎና ዔኪ ሙኪ ዔቂሶንጎ። <verse eid="LEV 1:3"/><verse number="4" style="v" sid="LEV 1:4"/>ዬካፓ ዬይ ዓሢ ሚቺ ዒንጋኒ ዔኪ ሙኬ ባኮኮ ቶኦካ ፔ ኩጮ ጌሦንጎ፤ ዬይ ዒዛኮ ጎሞ ጌኤሻኒ ዳንዳዓ ሚቺ ዒንጎ ዒንጊሢ ዒዛም ማዓንዳኔ። <verse eid="LEV 1:4"/><verse number="5" style="v" sid="LEV 1:5"/>ዬይ ዓሢ ጌሜ ዒኢካ ሹኮንጎ፤ ዬካፓ ዓኣሮኔ ፃጳፓ ማዔ፥ ቄኤሳ ሱጉፆ ናንጊና ናንጋ ጎዳ ቤርቶ ዔኪ ሙካዖ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ጌሎ ካራ ዓኣ፥ ሚቺ ዒንጎ ባኮኮ ጎኦቦ ዛሎ ቢያ ፑጮንጎ። <verse eid="LEV 1:5"/><verse number="6" style="v" sid="LEV 1:6"/>ዬካፓ ዬይ ዓሢ ዒልዖ ሹኪ ዱማሲ፥ ዓሽኮዋ ሜኤሎና ሜኤሎና ቲቆንጎ፤ <verse eid="LEV 1:6"/><verse number="7" style="v" sid="LEV 1:7"/>ቄኤሳሢ፥ ዓኣሮኔ ፃጶ ማዔ ቄኤሳ ሚቺ ዒንጎ ቤዞይዳ ሃንፂሎ ጊኢጊሺ ታሚ ዔኤሦንጎ። <verse eid="LEV 1:7"/><verse number="8" style="v" sid="LEV 1:8"/>ዬያይዴስካፓ ቲቂንቴ ዓሽኮኮ ሜኤሎንታ ቶኦኮንታ፥ ሃሣ ማሎዋ ዔኤታ ታሞ ዑፃ ጌሦንጎ። <verse eid="LEV 1:8"/><verse number="9" style="v" sid="LEV 1:9"/>ዬይ ዓሢ ጎጶ ባኮና ጊንፆ ቶኮና ዔኪ ዋኣሢና ማስካዛ ዬኖ ዓቦ ማዻ ቄኤሳሢ ፆኦሲም ዒንጎ ቤዞይዳ ጉቤና ሚቾንጎ፤ ዬያይዲ ሚቺ ዒንጎ ባኮኮ ሳዋ ናንጊና ናንጋ ጎዳ ዎዛሳያ ማዓኔ።<verse eid="LEV 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 1:10"/>ሚቺ ዒንጎ ባካ ማራይ፥ ሃሣ ዋኣሪ ማዔቴ፦ ዔኤቢ ቦሂሳ ባኣዚባኣ፥ ዓዴ ማራናይ ሃንጎ ኮላይናይ ማዖንጎ። <verse eid="LEV 1:10"/><verse number="11" style="v" sid="LEV 1:11"/>ዬያ ዒንጎ ባኮ ዒንጎ ቤዞኮ ኬዶ ዛላ ፆኦሲ ቤርታ ሹኮንጎ፤ ዬካፓ ቄኤሳ ሱጉፆ ዔኪ ሚቺ ዒንጎ ቤዞኮ ጎኦቦ ዛሎ ቢያ ፑጮንጎ። <verse eid="LEV 1:11"/><verse number="12" style="v" sid="LEV 1:12"/>ዬይ ዒንጋ ዓሢ ሹኪንቴ ባኮ ሜኤሎና ሜኤሎና ቲቄሢኮ ጊንፃ ዬኖ ዓቦ ማዻ ቄኤሳሢ ሜኤሎ ዓሽኮንታ ቶኦኮንታ ማሎንታ ቢያ ፆኦሲም ዒንጎ ቤዞይዳ ጊኢጊሺንቲ ዔኤታ ታሞ ዑፆይዳ ጌሦንጎ፤ <verse eid="LEV 1:12"/><verse number="13" style="v" sid="LEV 1:13"/>ዬካፓ ዓሢ ጎጶ ባኮንታ ጊንፆ ቶኮንታ ዋኣሢና ማስካዛ፥ ቄኤሳሢ ዬያ ዒንጎ ባኮ ቢያ ፆኦሲም ሚቺ ዒንጎ ባኣዚ ማሂ ሺኢሺ ሚቺ ዒንጎ ቤዞይዳ ሚቾንጎ፤ ዬያይዲ ታሚና ሚቺ ዒንጎ ባኮኮ ሳዋ ናንጊና ናንጋ ጎዳ ዎዛሳያ ማዓኔ።<verse eid="LEV 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 1:14"/>ዒንጋ ዓሢ ሚቺ ዒንጎ ባኮ ካፖ ዜርፃፓ ዒንጋኒ ኮዔቴ ዶኦሌ ናይ ማዒባኣቴ ኪሬ ናይ ዔኪ ሺኢሻኒ ዳንዳዓኔ። <verse eid="LEV 1:14"/><verse number="15" style="v" sid="LEV 1:15"/>ቄኤሳሢ ዬያ ካፖ ዔኪ ሚቺ ዒንጎ ቤዞ ሺኢሼስካፓ ባቃኖ ዺዺ ዱኡዚ፥ ሚቺ ዒንጎ ቤዛ ዔኤታ ታሞይዳ ዓጊ ሚቾንጎ፤ ሱጉፃኣ ሚቺ ዒንጎ ቤዞኮ ጎኦቦ ዛላ ፆዾንጎ። <verse eid="LEV 1:15"/><verse number="16" style="v" sid="LEV 1:16"/>ጎጶ ባኮና ጋፓኖና ዱማሲ፥ ፆኦሲም ዒንጎ ባኮ ዒንጎ ቤዞኮ ዓባ ኬስካ ዛሎና ቢዲንፆ ላኣሎ ቤዞይዳ ኬኤሮንጎ። <verse eid="LEV 1:16"/><verse number="17" style="v" sid="LEV 1:17"/>ዬካፓ ጋኣዞንሢ ዓርቂ፥ ሄኮ ሾኦሎንጎ፤ ጋዓንቴ ሾኦሊ ዱማሲ ኬኬሶፓ። ቄኤሳሢ ሚቺ ዒንጎ ቤዞይዳ ዓኣ፥ ታማኣ ዓጊ ቢያ ሚቾንጎ፤ ዬያይዲ ሚቺ ዒንጎ ባኮኮ ሳውማ ናንጊና ናንጋ ጎዳ ዎዛሳያ ማዓኔ።<verse eid="LEV 1:17"/></para>
  <chapter eid="LEV 1"/>
  <chapter number="2" style="c" sid="LEV 2"/>
  <para style="s1">ፆኦሲም ዒንጎ ሃኣኮ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 2:1"/>ዓይጎ ዓሲታቴያ ናንጊና ናንጋ ጎዳም ሃኣኮ ዒንጋ ዎዶና ሺኢቺ ዎዾና ዺኢሊ ማዓኒ ኮይሳኔ፤ ዬያይዳ ሪሚቶ ዛይቶና ጩቢሾ ዑንጆዋ ዋሆንጎ፤ <verse eid="LEV 2:1"/><verse number="2" style="v" sid="LEV 2:2"/>ዬካፓ ዓኣሮኔ ዜርፆ ማዔ፥ ቄኤሶ ኮይላ ዔኪ ሙኮንጎ፤ ዬኖ ኬሎና ማዻ ቄኤሳሢ ዬያ ዺኢሎና ዛይቶናይዳፓ ሾኦፓ ኩሙሢ፥ ሃሣ ዑንጆ ቢያ ዔኪጋፓ ዬይ ቢያ ናንጊና ናንጋ ጎዳም ዒንጊንቴያ ማዔሢ ዔርዛኒ ሚቺ ዒንጎ ቤዞ ዑፃ ዓኣ፥ ታሞይዳ ሚቾንጎ፤ ዬያይዲ ዒንጎ ሙዖኮ ሳዋ ናንጊና ናንጋ ጎዳ ዎዛሳያ ማዓኔ። <verse eid="LEV 2:2"/><verse number="3" style="v" sid="LEV 2:3"/>ዬካፓ ዓቴ ሃኣኮኮ ዺኢላ ዓኣሮኔ ፃጶ ማዔ፥ ቄኤሶም ዒንጊንቶንጎ፤ ዬይ፥ ናንጊና ናንጋ ጎዳም ዒንጊንቴሢዳፓ ፓቂ ዔኪንቴያ ማዔሢሮ ፆኦሲም ዱማዼያኬ።<verse eid="LEV 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 2:4"/>ዬይ ዒንጊንታሢ ቦኦቆይዳ ጉኡፒ ላኣዲንቴያ ማዔቴ ሙኑቃ ፃኣዛ ጌሊባኣያ፥ ሪሚቶ ዛይቶና ዲርኪንቴ፥ ሺኢቺ ዺኢሊና ላኣዲንቴ ሻኣዣ ላኣዳ ማዖንጎ።<verse eid="LEV 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 2:5"/>ዒንጊንታ ባካ ቦኦቆይዳ ላኣዲንቴ ላኣዳ ማዔቴ ሙኑቃ ፃኣዛ ጌሊባኣ፥ ሪሚቶ ዛይቶና ዲርኪንቴ ሺኢቺ ዺኢሊና ላኣዲንቴያ ማዖንጎ፤ <verse eid="LEV 2:5"/><verse number="6" style="v" sid="LEV 2:6"/>ዬያ ቡንፂጋፓ ጊዳ ሪሚቶ ዛይቶ ዋሂ፥ ፆኦሲም ዒንጊንታ ሃኣኮ ማሂ ዒንጌ።<verse eid="LEV 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 2:7"/>ዬና ዒንጊንታ ባካ ታሚ ቦኦቆይዳ ላኣዲንቴ ላኣዳ ማዔቴ ሪሚቶ ዛይቶና ዲርኪንቴ፥ ሺኢጮ ዺኢሎ ላኣዶናያ ማዖንጎ። <verse eid="LEV 2:7"/><verse number="8" style="v" sid="LEV 2:8"/>ዬኖ ሃኣኮ ናንጊና ናንጋ ጎዳም ዒንጎ ዒንጊሢ ማሂ፥ ቄኤሳሢም ዒንጌ፤ ቄኤሳሢያ ፆኦሲም ዒንጎ ቤዛ ሺኢሺ ዒንጎንጎ። <verse eid="LEV 2:8"/><verse number="9" style="v" sid="LEV 2:9"/>ቄኤሳሢ ዬያ ዒንጊንቴ ባኮይዳፓ ዛሎ ዔኪ፥ ቢያሢ ናንጊና ናንጋ ጎዳም ዒንጊንቴያ ማዒፆ ዔርዛኒ ፆኦሲም ዒንጎ ባኮ ዒንጎ ቤዞይዳ ዓኣ፥ ታማኣ ሚቾንጎ። ዬያይዲ ታሚና ሚቺንቲ ዒንጊንታ ዒንጊፆኮ ሳዋ ናንጊና ናንጋ ጎዳ ዎዛሳያ ማዓኔ። <verse eid="LEV 2:9"/><verse number="10" style="v" sid="LEV 2:10"/>ዓቴ ሃኣኮ ዺኢላ ጋዓንቴ ቄኤሶም ዒንጊንቶንጎ፤ ዬይ፦ ናንጊና ናንጋ ጎዳም ዒንጊንቴሢዳፓ ፓቂ ዔኪንቴያ ማዔሢሮ ሚርጌና ፆኦሲም ዱማዼያኬ።<verse eid="LEV 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 2:11"/>ሚቺ ዒንጎ ዒንጊሢ ማዒ፥ ናንጊና ናንጋ ጎዳም ዒንጊንታ ባኮና ዎላ ሙኑቃ ፃኣዛታቴያ ዔኤሲ ታማ ሚቺንታኒ ኮይሱዋኣሢሮ ኔኤኒ ፆኦሲም ዒንጋ ሃኣካ ቢያ ፔቴታዖ ሙኑቃ ፃኣዛ ጌሊባኣያ ማዖንጎ፤ <verse eid="LEV 2:11"/><verse number="12" style="v" sid="LEV 2:12"/>ሌዓ ሌዓ ካፄ ሃኣኮኮ ቤርቲ ማሂ ዒንሢ ዒንጋ ባኮ ናንጊና ናንጋ ጎዳም ዔኪ ሙኩዋቴ፤ ዬይ ጋዓንቴ ፆኦሲም ዒንጎ ባኮ ዒንጎ ቤዛ ሳውማ ናንጊና ናንጋ ጎዳ ዎዛሳንዳጉዲ ጌይ ሚቺንቶፓ። <verse eid="LEV 2:12"/><verse number="13" style="v" sid="LEV 2:13"/>ፆኦሲም ዒንጋ ሃኣኮይዳ ቢያ ሶኦጌ ዓኣያ ማዖንጎ፤ ኔ ፆኦዛሢ ኔኤና ዎላ ጫኣቄ ጫኣቁሞ ሶኦጌ ባኣያ ጉሪ ዔኪ ሺኢሺፖ፤ ኔ ዒንጋ ሃኣኮ ዒንጊፆ ቢያ ሶኦጌና ጊኢጊሺ ዔኪ ሺኢሼ። <verse eid="LEV 2:13"/><verse number="14" style="v" sid="LEV 2:14"/>ሌዖ ሃኣኮኮ ቤርቶ ኔ ዒንጋ ዎዶና ሚቺ ቶርሾናያ ሃንጎ ሺርኮና ቲሾ ማዖንጎ። <verse eid="LEV 2:14"/><verse number="15" style="v" sid="LEV 2:15"/>ዬያይዳ ሪሚቶ ዛይቶንታ ዑንጆንታ ዋሄ፤ ዬይ ፆኦሲም ዒንጊንቴ ሃኣኮ ዒንጊሢ ማዓንዳኔ። <verse eid="LEV 2:15"/><verse number="16" style="v" sid="LEV 2:16"/>ቄኤሳሢ፥ ዬያኮ ዛሎ ዔኪ ናንጊና ናንጋ ጎዳም ዒንጊንቴያ ማዒፆ ዔርዛኒ ዛይቶንታ ዑንጆንታ ቢያ ሃኣኮና ዎላ ሚቾንጎ።<verse eid="LEV 2:16"/></para>
  <chapter eid="LEV 2"/>
  <chapter number="3" style="c" sid="LEV 3"/>
  <para style="s1">ፔቱሞና ፆኦሲም ዒንጎ ዒንጊሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 3:1"/>ዓይጎ ዓሲያ ፔኤኮ ባኣቶይዳፓ ፔቱሞና ፆኦሲም ዒንጊንታ ዒንጊፆ ዒንጋ ዎዶና ዔኤቢ ቦሂሳ ባኣዚባኣ፥ ፔቴ ጌማይታቴያ ዒንዴ ባይ ዶኦሪ ዔኪ ሙኮንጎ። <verse eid="LEV 3:1"/><verse number="2" style="v" sid="LEV 3:2"/>ዬይ ዒንጋ ዓሢ ፆኦሲም ዒንጎ ባኣዚ ማሂ ዒንጋ ባኮኮ ቶኦኮይዳ ፔ ኩጮ ጌሢ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮኮ ካሮይዳ ሹኮንጎ፤ ዬካፓ ዓኣሮኔ ዜርፆ ማዔ፥ ቄኤሳ ሱጉፆ ዔኪ ሚቺ ዒንጎ ቤዞኮ ጎኦቦ ዛሎ ቢያ ፑጮንጎ። <verse eid="LEV 3:2"/><verse number="3" style="v" sid="LEV 3:3"/>ዬያ ዓሽኮኮ ሃካፓ ሊካ ፓይዲንታ ቤዞንሢ ሙኡዚ ዒንጊሢ ማሂ ናንጊና ናንጋ ጎዳም ዒንጊንቶንጎ፤ ዬንሢያ፦ ጎጶ ባኮ ካንቄ ሃኣቦንታ ዒኢካ ዓኣ ማሎ ጉቤ፥ <verse eid="LEV 3:3"/><verse number="4" style="v" sid="LEV 3:4"/>ጳላሢና ዒኢካ ዓኣ ማሎ፤ ዬያጉዲ ሃሣ ማዮኮ ሻኣዣዻ ቤዞዋ ዔኪ ሺኢኮንጎ። <verse eid="LEV 3:4"/><verse number="5" style="v" sid="LEV 3:5"/>ዬካፓ ቄኤሳ ዬያ ቢያ ሚቺ ዒንጎ ባኮና ዎላ ማሂ ሚቺ ዒንጎ ቤዞይዳ ሚቾንጎ፤ ዬያ ዒንጎ ባኮኮ ሳዋ ናንጊና ናንጋ ጎዳ ዎዛሳያ ማዓኔ።<verse eid="LEV 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 3:6"/>ፔቱሞና ፆኦሲም ዒንጎ ዒንጊሢ ማዒ ዒንጊንታ ባካ ማራይ ሃሣ ዋኣሪ ማዔቴ፦ ቦሂሳ ባኣዚባኣ ዓዴ ማራይ፥ ኮላይ፤ ጊንሣ ሃሣ ዒንዴ ማራይታቴያ ዋኣሪ ዒማዺ ማዖንጎ። <verse eid="LEV 3:6"/><verse number="7" style="v" sid="LEV 3:7"/>ፔቴ ዓሲ ፆኦሲም ዒንጎ ባኣዚ ማሂ ዒንጋ ባካ ማራናይ ማዔቴያ ናንጊና ናንጋ ጎዳ ቤርቶ ዔኪ ሙኮንጎ። <verse eid="LEV 3:7"/><verse number="8" style="v" sid="LEV 3:8"/>ዬካፓ ኩጮ ማራናዖኮ ቶኦካ ጌሢ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮኮ ጌሎ ካራ፥ ቤርቶ ዛላ ሹኮንጎ፤ ቄኤሳ ዬያኮ ሱጉፆ ዔኪ፥ ሚቺ ዒንጎ ቤዞኮ ጎኦቦ ዛሎ ቢያ ፑጮንጎ። <verse eid="LEV 3:8"/><verse number="9" style="v" sid="LEV 3:9"/>ዬያይዴስካፓ ዓሽኮኮ ሃካፓ ሊካ ፓይዲንታ ቤዞንሢ ሙኡዚ ዒንጊሢ ማሂ ናንጊና ናንጋ ጎዳም ዒንጎንጎ፤ ዬንሢያ፦ ማሎንታ ጉይኖ ሜጌፆ ሄሊሲ ቲቂንቴ ዑንኮ ማላኣ፥ ጎጶ ባኮኮ ዑፃ ዓኣ ሃኣቦንታ ዒኢካ ዓኣ ማሎ ቢያ፥ <verse eid="LEV 3:9"/><verse number="10" style="v" sid="LEV 3:10"/>ጳላሢንታ ዒኢካ ዓኣ ማሎ፤ ዬያጉዲ ሃሣ ማዮኮ ሻኣዣዻ ቤዞ ዔኪ ሺኢሾንጎ። <verse eid="LEV 3:10"/><verse number="11" style="v" sid="LEV 3:11"/>ዬካፓ ቄኤሳሢ ዬያ ቢያ ናንጊና ናንጋ ጎዳም ሙኡዚ ዒንጊሢ ማሂ ዒንጊ፥ ሚቺ ዒንጎ ቤዛ ሚቾንጎ።<verse eid="LEV 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 3:12"/>ፔቴ ዓሲ ፆኦሲም ዒንጎ ባኣዚ ማሂ ዒንጋሢ ዋኣሪ ማዔቴያ ናንጊና ናንጋ ጎዳ ቤርቶ ዔኪ ሙኮንጎ። <verse eid="LEV 3:12"/><verse number="13" style="v" sid="LEV 3:13"/>ዬካፓ ዒዚ ፔኤኮ ኩጮ ዋኣራሢ ቶኦካ ጌሢጋፓ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮኮ ቤርቶ ዛላ ሹኮንጎ፤ ቄኤሳ ዬያ ሱጉፆ ዔኪ ሚቺ ዒንጎ ቤዞኮ ጎኦቦ ዛሎ ቢያ ፑጮንጎ። <verse eid="LEV 3:13"/><verse number="14" style="v" sid="LEV 3:14"/>ዬያ ዓሽኮኮ ሃካፓ ሊካ ፓይዲንታ ቤዞንሢ ሙኡዚ ዒንጊሢ ማሂ ፆኦሲም ዔኪ ሺኢሾንጎ፤ ዬንሢያ፦ ጎጶ ባኮ ካንቄ ሃኣቦንታ ዒኢካ ዓኣ ማሎ ጉቤ፥ <verse eid="LEV 3:14"/><verse number="15" style="v" sid="LEV 3:15"/>ጳላሢንታ ዔያቶ ካንቂ ዓኣ ማሎ ቢያ፤ ዬያጉዲ ሃሣ ማዮኮ ሻኣዣዻ ቤዞዋ ዔኪ ሺኢሾንጎ። <verse eid="LEV 3:15"/><verse number="16" style="v" sid="LEV 3:16"/>ዬካፓ ቄኤሳሢ ዬያኮ ሳዋ ናንጊና ናንጋ ጎዳሢ ዎዛሳ ዒንጊሢ ማዓንዳጉዲ ሚቺ ዒንጎ ቤዛ ሚቾንጎ፤ ማሊ ቢያ ናንጊና ናንጋ ጎዳም ዱማዼያ ማዖንጎ። <verse eid="LEV 3:16"/><verse number="17" style="v" sid="LEV 3:17"/>ዒስራዔኤሌ ዜርሢ ማዔ ዓሳ ጉቤ ማሊ ማዔ ዓሽኪ፤ ሃሣ ሱጉሢያ ሙዖፓ፤ ዬይ ዒስራዔኤሌ ዓሳ ናንጋ ቤዞና ናንጋ ዎዶይዳኣ ቢያ ናንጊና ካፒ ናንጋ ዎጌ ማዖም።<verse eid="LEV 3:17"/></para>
  <chapter eid="LEV 3"/>
  <chapter number="4" style="c" sid="LEV 4"/>
  <para style="s1">ዔሪባኣዖ ማዺንቴ ጎሜ ዛላ ዒንጊንታ ዒንጊሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 4:1"/>ናንጊና ናንጋ ጎዳ ሙሴም ሂዚ ጌይ ኬኤዜኔ፦ <verse eid="LEV 4:1"/><verse number="2" style="v" sid="LEV 4:2"/>«ዒስራዔኤሌ ዓሶም ሂዚ ጌዔ፤ ዓይጎ ዓሲያ ዔሪባኣዖ ጎሜ ማዼቴ፥ ሃሣ ጊንሣ ናንጊና ናንጋ ጎዳ ዓይሤ ዓይሢፆይዳፓኣ ፔቴ ዻቤያ ማዔቴ ሃካፓ ሊካ ፓይዲንታ ዳምቦ ኩንሦንጎ፤<verse eid="LEV 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 4:3"/>«ቄኤሶ ቢያኮ ሱኡጌ ማዒ ዶኦሪንቴሢ ጎሜ ማዺ ዓሶዋ ዻቢሼያ ማዔቴ ዔኤቢ ቦሂሳ ባኣዚባኣ፥ ፔቴ ዚያ ጌማይ ናንጊና ናንጋ ጎዳ ቤርቶ ዔኪ ሙኮንጎ፤ ዬካፓ ፔ ጎሞ ዛሎ ፆኦሲም ዒንጎ ባኣዚ ማሂ ሹኪ ዒንጎንጎ። <verse eid="LEV 4:3"/><verse number="4" style="v" sid="LEV 4:4"/>ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮኮ ካሮ ጌሜ ዔኪ ሙኪ ኩጮ ጌሜ ቶኦካ ጌሢጋፓ ናንጊና ናንጋ ጎዳ ቤርታ ሹኮንጎ፤ <verse eid="LEV 4:4"/><verse number="5" style="v" sid="LEV 4:5"/>ዬካፓ ቄኤሶ ቢያኮ ሱኡጋሢ ሱጉፃፓ ዻካ ዔኪ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ጌሊ፥ <verse eid="LEV 4:5"/><verse number="6" style="v" sid="LEV 4:6"/>ፔ ኬኤሎና ሱጉፃፓ ዔኪ ዔኪ ጌኤዦ ማኣሮኮ ጋራ ጎኦቢንቲ ዓኣ ዓፒሎኮ ቤርቶ ዛሎና ናንጊና ናንጋ ጎዳ ቤርታ ላንካይ ማይንቲ ዉፁርቆንጎ። <verse eid="LEV 4:6"/><verse number="7" style="v" sid="LEV 4:7"/>ዬካፓ ሃሣ ዻካ ሱጉሢ ዔኪ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮኮ ጋራ ዑንጆ ጩቢሶ ቤዞኮ ዖይዶ ዛሎይዳ ዓኣ ዻንኮንሢ ቲሽኮንጎ፤ ዓቴ ሱጉፆ ማኣሮኮ ጌሎ ካራ ዓኣ፥ ሚቺ ዒንጎ ባኮ ዒንጎ ቤዞ ዴማ ዋሆንጎ። <verse eid="LEV 4:7"/><verse number="8" style="v" sid="LEV 4:8"/>ዬያ ጌሜኮ ማሎ ቢያ ዔኮንጎ፤ ዬይያ፦ ጎጶ ባኮ ካንቂ ዓኣ ሃኣቦንታ ዒኢካ ዓኣ ማሎ ቢያ፥ <verse eid="LEV 4:8"/><verse number="9" style="v" sid="LEV 4:9"/>ጳላሢና ዒኢካ ዓኣ ማሎ፤ ዬያጉዲ ሃሣ ማዮኮ ሻኣዣዻ ቤዞዋ ዔኪ ሺኢሾንጎ። <verse eid="LEV 4:9"/><verse number="10" style="v" sid="LEV 4:10"/>ቄኤሶኮ ሱኡጋሢ ዬያ ማሎ ቢያ ዔኪ ሚቺ ዒንጎ ባኮ ዒንጎ ቤዞይዳ ሚቾንጎ፤ ማሎ ኬሲፆ ጎይፃ ፔቱሞና ዒንጎ ባኮኮ ማዺንቴ ጎይፆ ማዖንጎ። <verse eid="LEV 4:10"/><verse number="11" style="v" sid="LEV 4:11"/>ጋዓንቴ ዒልዓ፥ ዓሽካ፥ ቶኦኮንታ ቶኮንታ፥ ሩቁንታኣ፥ ጎጶ ባካ፥ ሶኦኮዋ ቢያ፥ <verse eid="LEV 4:11"/><verse number="12" style="v" sid="LEV 4:12"/>ጉርዳፓ ዙላ ኬሲ ቢዲንፆ ላኣሎ፥ ካኣዦ ዳምቦና ጌኤሺ ማዔ ቤዞ ዔኪ ዓኣዺ ኩሊንቴ ዲቢንፆ ዑፃ ታሚ ዔኤሢ ሚቾንጎ።<verse eid="LEV 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 4:13"/>«ጉቤ ዒስራዔኤሌ ዴራ ዔሩዋዖ ዻቢንቲ ጎሜ ማዼቴ፤ ሃሣ ናንጊና ናንጋ ጎዳ ዓይሤ ዓይሢፃፓ ፔቴ ፓጪሴቴ፥ ዬያ ዴሮም ዻቢንታ ዔርቲባኣያ ማዔቴያ ዔያታ ዻቢንቴያኬ። <verse eid="LEV 4:13"/><verse number="14" style="v" sid="LEV 4:14"/>ዴራ ዬያ ዻቢንቶ ዔሬ ዎዶና ኔጉዋዖ ጎሜ ዛላ ዒንጊንታ ዒንጊሢ ማዓ፥ ፔቴ ዚያ ጌማይ ዔኪ ሙኪ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮኮ ቤርቶ ዛላ ዔቂሶንጎ። <verse eid="LEV 4:14"/><verse number="15" style="v" sid="LEV 4:15"/>ዬካፓ ዴሮኮ ዶንዛ ፔኤኮ ኩጮ ጌሜ ቶኦካ ጌሤም ናንጊና ናንጋ ጎዳ ቤርቶይዳ ዬይ ባኣሢ ሹኪንቶንጎ። <verse eid="LEV 4:15"/><verse number="16" style="v" sid="LEV 4:16"/>ቄኤሶ ቢያኮ ሱኡጋሢ ጌሜ ሱጉፃፓ ዻካ ዔኪ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ጌሎንጎ። <verse eid="LEV 4:16"/><verse number="17" style="v" sid="LEV 4:17"/>ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮኮ ጋራ ጎኦቦና ዓፒሎኮ ቤርቶ ዛላ ዔቂ ፔ ኬኤሎና ሱጉፃፓ ዔኪ ዔኪ ላንካይ ማይንቲ ናንጊና ናንጋ ጎዳ ቤርታ ዉፁርቆንጎ። <verse eid="LEV 4:17"/><verse number="18" style="v" sid="LEV 4:18"/>ሃሣ ዻካ ሱጉሢ ዔኪ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮይዳ ዑንጆ ጩቢሶሢኮ ዖይዶ ዛሎይዳ ዓኣ ዻንኮንሢ ናንጊና ናንጋ ጎዳ ቤርታ ቲሽኮንጎ፤ ዬካፓ ዓቴ ሱጉፆ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮኮ ቤርቶ ዛላ ዓኣ ሚቺ ዒንጎ ባኮ ዒንጎ ቤዞ ዴማ ዋሆንጎ። <verse eid="LEV 4:18"/><verse number="19" style="v" sid="LEV 4:19"/>ዬካፓ ዬያ ጌሜኮ ማሎ ቢያ ዔኪ ሚቺ ዒንጎ ቤዞይዳ ሚቾንጎ። <verse eid="LEV 4:19"/><verse number="20" style="v" sid="LEV 4:20"/>ጎሞ ዛሎ ቤርታ ዒንጊንቴ ጌሜይዳ ማዺንቴ ጎይፆማ ዬያ ጌሜያ ዒማይዶንጎ፤ ዬያይዲ ቄኤሳሢ ዴሮኮ ጎሞ ዛሎ ዒንጌም ዴሮኮ ጎማ ጌኤሽካንዳኔ። <verse eid="LEV 4:20"/><verse number="21" style="v" sid="LEV 4:21"/>ዬካፓ ጌሜ ጉርዶኮ ዙሎ ኬሲ፥ ቤርታኣ ጌሜ ሚቼ ጎይፆማ ዬያኣ ሚቾንጎ፤ ዬይ ዴሮኮ ጎሞ ጌኤሻያ ማዓንዳኔ።<verse eid="LEV 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 4:22"/>«ዴሬኮ ዓርና ማዒ ዔኪ ዓኣዻ ፔቴ ዓሲ ዔሩዋዖ ዻቢንቲ ጎሜ ማዼቴ፥ ናንጊና ናንጋ ጎዳ ዓይሤ ባኮይዳፓኣ ፔቴ ባኣዚ ፓጪሲ ጴዼቴ ዒዚ ዻቤያ ማዓኔ። <verse eid="LEV 4:22"/><verse number="23" style="v" sid="LEV 4:23"/>ዒዚ ዻቢንቶ ፔኤሲ ዔሬቴ ኔጉዋዖ ዔኤቢ ቦሂሳ ባኣዚባኣ፥ ኮላይ ፔኤኮ ጎሞ ጌኤሻንዳ ዒንጎ ዒንጊሢ ማሂ ዔኪ ሙኮንጎ። <verse eid="LEV 4:23"/><verse number="24" style="v" sid="LEV 4:24"/>ዬካፓ ፔኤኮ ኩጮ ኮሌኮ ቶኦካ ጌሢ፥ ሚቺ ዒንጎ ቤዞኮ ኬዶ ዛላ ሚቺ ዒንጎ ቆልማ ሹኪንታ ቤዛ ናንጊና ናንጋ ጎዳ ቤርታ ሹኮንጎ፤ ዬይ ጎሞ ጌኤሻ ዒንጊሢ ማዓንዳኔ። <verse eid="LEV 4:24"/><verse number="25" style="v" sid="LEV 4:25"/>ቄኤሳሢ ኮሌኮ ሱጉፆይዳፓ ኬኤላና ዻካ ዔኪ ሚቺ ዒንጎ ቤዞኮ ዖይዶ ዛሎይዳ ዓኣ፥ ዻንኮ ቲሽኮንጎ፤ ዬካፓ ዓቴ ሱጉፆ ሚቺ ዒንጎ ቤዞኮ ዴማ ዋሆንጎ። <verse eid="LEV 4:25"/><verse number="26" style="v" sid="LEV 4:26"/>ፔቱሞና ዒንጊንታ ዒንጊፆ ሚቼ ጎይፆ ማሎ ጉቤ ሚቺ ዒንጎ ቤዛ ሚቾንጎ፤ ቄኤሳሢ ዬያይዲ፥ ዬያ ዓሢኮ ጎሞ ዛሎ ዒንጎንጎ፤ ዓሢኮዋ ጎማ ጌኤሽካንዳኔ።<verse eid="LEV 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 4:27"/>«ዴሮ ባኣካፓ ፔቴ ዓሲ ዔሩዋዖ ዻቢንቲ ጎሜ ማዼቴ፤ ሃሣ ናንጊና ናንጋ ጎዳኮዋ ዓይሢፆይዳፓ ፔቴ ፓጪሴያ ማዔቴ ዬይ ዓሢ ዻቢንቴያኬ፤ <verse eid="LEV 4:27"/><verse number="28" style="v" sid="LEV 4:28"/>ዒዚ ዻቢንቴያ ማዔሢ ዔዔራዖ ዔኤቢ ቦሂሳ ባኣዚባኣ፥ ዒንዴ ዋኣሪ ጎሞ ዛሎ ዒንጎ ባኣዚ ማሂ ዔኪ ሺኢሾንጎ። <verse eid="LEV 4:28"/><verse number="29" style="v" sid="LEV 4:29"/>ዬካፓ ፔኤኮ ኩጮ ዒ ዔኪ ሙኬ ዋኣሬሎ ቶኦካ ጌሢ፥ ሚቺ ዒንጎ ቤዞኮ ኬዶ ዛላ ሚቺ ዒንጎ ቆልማ ሹኪንታ ቤዛ ሹኮንጎ። <verse eid="LEV 4:29"/><verse number="30" style="v" sid="LEV 4:30"/>ዬያይዴስካፓ ቄኤሳሢ ዋኣሬሎኮ ሱጉፃፓ ዻካ ኬኤላና ዔኪ ሚቺ ዒንጎ ቤዞኮ ዖይዶ ዛላ ዓኣ፥ ዻንኮ ቲሽኮንጎ፤ ዬካፓ ዓቴ ሱጉፆ ሚቺ ዒንጎ ቤዞኮ ዴማ ዋሆንጎ። <verse eid="LEV 4:30"/><verse number="31" style="v" sid="LEV 4:31"/>ፔቱሞና ዒንጎ ቆልሞይዳፓ ዔኪንቴ ጎይፆ ዋኣሬሎ ማሎዋ ዒማይዲ ኬሶንጎ፤ ሳዋ ናንጊና ናንጋ ጎዳ ዎዛሳንዳጉዲ ቄኤሳሢ ሚቺ ዒንጎ ቤዛ ሚቾንጎ፤ ዬያይዲ ዬያ ዓሢኮ ጎሞ ዛሎ ዒንጊንታ ዒንጊፆ ዒንጎንጎ፤ ዬያ ዓሢኮዋ ጎማ ዓቶም ጌይንታንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡31 </char><char style="xt" closed="false"><ref loc="NUM 15:27-28">ፓይ. ማፃ 15፡27-28</ref>።</char></note><verse eid="LEV 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 4:32"/>«ፔቴ ዓሲ ጎሞ ዛሎ ማራናይ ዒንጋያ ማዔቴ ቦሂሳ ባኣዚባኣ፥ ዒንዴ ማራይ ሺኢሾንጎ። <verse eid="LEV 4:32"/><verse number="33" style="v" sid="LEV 4:33"/>ዬይ ዓሢ ዬኖ ማራዔሎኮ ቶኦካ ኩጮ ጌሢ፥ ሚቺ ዒንጎ ቤዞኮ ኬዶ ዛላ ሚቺ ዒንጎ ቆልሞ ሹኮ ቤዛ ሹኮንጎ። <verse eid="LEV 4:33"/><verse number="34" style="v" sid="LEV 4:34"/>ቄኤሳሢ ማራዖ ሱጉፃፓ ኬኤላና ዻካ ዔኪ ሚቺ ዒንጎ ቤዞኮ ዖይዶ ዛላ ዓኣ ዻንኮ ቲሽኮንጎ፤ ዬካፓ ዓቴ ሱጉፆ ቢያ ሚቺ ዒንጎ ቤዞኮ ዴማ ዋሆንጎ። <verse eid="LEV 4:34"/><verse number="35" style="v" sid="LEV 4:35"/>ዓሳ ፔቱሞና ዒንጌ ማራዖኮ ማሎ ኬሴ ጎይፆ ማሎ ቢያ ኬሶንጎ፤ ዬካፓ ቄኤሳሢ ሚቺ ዒንጎ ቤዞይዳ ናንጊና ናንጋ ጎዳ ዎዛሳያ ማዓንዳጉዲ ሚቾንጎ፤ ዬያይዲ ዓሢኮ ጎሞ ዛሎ ዒንጎ ባኮ ዒንጎንጎ፤ ዬያ ዓሢኮ ጎማ ጌኤሽካንዳኔ።»<verse eid="LEV 4:35"/></para>
  <chapter eid="LEV 4"/>
  <chapter number="5" style="c" sid="LEV 5"/>
  <para style="s1">ዔሩዋዖ ማዺንቴ ዻቢንቲ ዛላ ዒንጊንታ ዒንጊፃ ዓይጎሮ ማዔቴያ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 5:1"/>ናንጊና ናንጋ ጎዳ ሃሣ ኬኤዛዖ፦ «ፔቴ ዓሲ ዎጌ ዎጊንታ ቤሲዳ ማርካቶ ማርካዻንዳጉዲ ዔኤሊፃ ሄሌንቴ ዒ ዛጌ ባኮና ዔራ ባኮ ዛሎ ማርካዺፆ ዒፂ ሃሼቴ ዻቢንቴያ ማዒ ዖኦጪንታንዳኔ።<verse eid="LEV 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LEV 5:2"/>«ፔቴ ዓሲ ዔሩዋዖ ዓይጎ ባኣዚያ ማዖም ዳምቦ ጎይፆና ቄፄ ማዔ ባኣዚ ጌይፃ፦ ካይዚ ቦዖታቴያ ዓሲ ቆሌ ቆሎኮ ሃሣ ሳዓና ጎቺንቲ ሃንታ ቦዖኮ ሃይቄ ሌሲ ካኣሜቴ ዬይ ዓሢ ዒኢቲ፥ ዻቤያ ማዓኔ።<verse eid="LEV 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 5:3"/>«ፔቴ ዓሲ ዔሩዋዖ ዓሲ ዑስካፓ ሾኦታ ዓይጎ ባኣዚያ ማዖም ዒኢሳ ባኣዚ ሄሌቴ፥ ዒዚ ዻቤያ ማዓኔ።<verse eid="LEV 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 5:4"/>«ፔቴ ዓሲ ፑርቱሞም ማዔቴያ ኮሹሞም፥ ዓይጎ ባኣዚሮዋ ማዖም ማሊ ዔኩዋዖ ናኣቢ ናኣቤቴ ዒ ማዼ ማዻ ዻቢንቲ ዒዛም ማዓኔ።<verse eid="LEV 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 5:5"/>«ፔቴ ዓሲ ዬንሢዳፓ ፔቴማ ማዺ ዻቢንቴቴ ዎማ ማዺ ዻቤቴያ ኬኤዚ ቡኡፃንዳያ ኮይሳኔ። <verse eid="LEV 5:5"/><verse number="6" style="v" sid="LEV 5:6"/>ዒ ዻቤ ዻቢንቶ ዛሎሮ ዴንዲ ዒንዴ ማራይታቴያ ዋኣሪ ናንጊና ናንጋ ጎዳም ዒንጎ ባኣዚ ማሂ ዔኪ ሙኮንጎ፤ ዬካፓ ቄኤሳሢ ዬያ ዓሢኮ ጎሞ ዛሎ ሚቺ ዒንጎ ዒንጊሢ ማሂ ሹኪ ዒንጎንጎ።<verse eid="LEV 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 5:7"/>«ፔቴ ዓሲ ማራይ ማዔቴያ ዋኣሪ ዒንጋኒ ዳንዳዒባኣቴ ላምዖ ዶኦሌ ሃንጎ ላምዖ ኪሬ፤ ፔቴማ ጎሞ ዛሎ ዒንጊንታያ ማሂ፥ ላምዓሳማ ሚቺ ዒንጎ ዒንጊሢ ማሂ ናንጊና ናንጋ ጎዳም ሺኢሾንጎ። <verse eid="LEV 5:7"/><verse number="8" style="v" sid="LEV 5:8"/>ዒዚ ዬንሢ ዔኪ ሙኪ ቄኤሳሢም ዒንጎንጎ፤ ዬካፓ ቄኤሳሢ ላምዖ ካፖንሢ ፔቴማኮ ቶኦኮ ቲቁዋዖ ዺዺ ሜንሢ ዻቢንቲኮ ዒንጎ ዒንጊሢ ማሂ ሺኢሾንጎ። <verse eid="LEV 5:8"/><verse number="9" style="v" sid="LEV 5:9"/>ዬያ ሱጉፆይዳፓ ዻካ ዔኪ ሚቺ ዒንጎ ቤዞኮ ጎኦቦ ዛላ ፑጮንጎ፤ ዓቴ ሱጉፆ ሚቺ ዒንጎ ቤዞኮ ዴማ ዋሆንጎ፤ ዬይ ጎሞ ዛሎ ዒንጊንታ ዒንጊሢ ማዓንዳኔ። <verse eid="LEV 5:9"/><verse number="10" style="v" sid="LEV 5:10"/>ቄኤሳሢ፥ ሃንጎ ካፖማ ዎጋ ዓይሣ ጎይፆ ሚቺ ዒንጎ ዒንጊሢ ማሂ ሺኢሾንጎ፤ ዬያይዲ ዓሢኮ ጎሞ ዛሎ ዒንጊንታ ዒንጊፆ ዒንጎንጎ፤ ዻቤ ዓሢኮዋ ጎማ ጌኤሽካንዳኔ።<verse eid="LEV 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 5:11"/>«ዬይ ዓሢ ላምዖ ዶኦሎንሢና ላምዖ ኪሮንሢ ዔኪ ዒንጋኒ ዳንዳዒባኣያታቴ ፔቴ ኪሎ ማዓንዳ ሺኢቺ ዺኢሊ ዒ ማዼ ጎሞ ዛሎ ዒንጊንታያ ማሂ ዔኪ ሙኮንጎ፤ ዬይ ጎሜ ዛላ ዒንጊንቴያ ማዔሢሮ ዛይቴታቴያ ዑንጄ ጊዳ ዋሆፓ። <verse eid="LEV 5:11"/><verse number="12" style="v" sid="LEV 5:12"/>ዬካፓ ዔኪ ሙኪ ቄኤሳሢም ዒንጎንጎ፤ ቄኤሳሢ ዺኢሎይዳፓ ሾኦፓና ዔኪ ቢያሢ ናንጊና ናንጋ ጎዳም ዒንጊንቴያ ማዒፆ ዔርዛኒ ሙኡዚ ዒንጊሢ ማዒ ዒንጊንታ ዒንጊፆና ዎላ ሚቺ ዒንጎ ቤዞይዳ ናንጊና ናንጋ ጎዳም ታሚና ሚቾንጎ፤ ዬይ ጎሞ ዛሎ ዒንጊንቴ ዒንጊሢ ማዓንዳኔ። <verse eid="LEV 5:12"/><verse number="13" style="v" sid="LEV 5:13"/>ዓሢ ዬንሢዳፓ ፔቴማ ዻቢ ጎሜ ማዼቴ ቄኤሳሢ ዬያይዲ ጎሞ ዛሎ ዒንጊንታ ዒንጊፆ ዒንጌም፥ ጎማ ዓሢኮ ዓቶም ጌይንታንዳኔ፤ ዓቴ ዺኢላ ሃኣኮ ዒንጊፃ ማዺንታ ጎይፆ ቄኤሳሢሮ ማዖንጎ።»<verse eid="LEV 5:13"/></para>
  <para style="s1">ዻቢንቶ ዛሎ ጪጋኒ ዒንጊንታ ዒንጊሢ</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 5:14"/>ናንጊና ናንጋ ጎዳ ሙሴም ሃካፓ ሊካ ዓኣ ዳምቦ ኬኤዜኔ፦ <verse eid="LEV 5:14"/><verse number="15" style="v" sid="LEV 5:15"/>«ዓይጎ ዓሲያ ማዖም ናንጊና ናንጋ ጎዳም ዱማዼ ዒንጊሢ ዒንጎንዶንቴ ዔሩዋዖ ሃሺ ጎሜ ማዼቴ ዻቤ ዻቢንቶ ዛሎ ጪጊንታ ጋሌ ማሂ፥ ቆልሞ ባኣካፓ ዓዴ ማራይ ናንጊና ናንጋ ጎዳም ሺኢሾንጎ፤ ሃንጎ ዬማ ቆልሞማ ቄኤሳ ‹ያዺ ኬሳንዳኔ› ጌዔ ጎይፆና ሚኢሼ ዒዚ ጪጎንጎ፤ ዬይ ዻቢንቶኮ ዒንጊንቴያ ማዓንዳኔ። <verse eid="LEV 5:15"/><verse number="16" style="v" sid="LEV 5:16"/>ፆኦሲም ዱማዼ ባኮኮ ዒዚ ዒንጋንዳዖ ፓጪሴ ቤዞ ኩንሦንጎ፤ ጌይፃ፦ ዎንዴ ዒንጊንታንዳሢዳ ዶንጎ ኩቺፓ ፔቴ ማዓያ ቃሲ ዔኪ ሙኪ ቄኤሳሢም ዒንጎንጎ፤ ቄኤሳሢ ዬያ ባኮ ማራዓሢና ዎላ ዻቢንቶ ዛሎ ዒንጊንታ ዒንጊሢ ማሂ ሺኢሾንጎ፤ ዓሢኮዋ ጎማ ጌኤሽካንዳኔ።<verse eid="LEV 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 5:17"/>«ፔቴ ዓሲ ዔሩዋዖ ናንጊና ናንጋ ጎዳ ዓይሤ ዓይሢፆይዳፓ ፔቴ ፓጪሴቴ ዬይ ዓሢ ዻቢንቴያ ማዒ ዖኦጪንታንዳኔ። <verse eid="LEV 5:17"/><verse number="18" style="v" sid="LEV 5:18"/>ዒዚ ፔኤኮ ቆልሞ ባኣካፓ ቦሂሳ ባኣዚባኣ ዓዴ ማራይ ዻቢንቶ ዛሎ ጪጎ ዒንጊሢ ማሂ ቄኤሳሢም ዔኪ ሙኮንጎ፤ ዬይ ሻንቺንቲ ኬሳንዳ ሚኢሻ ‹ያዺ ኬሳንዳኔ› ጌይንቴ ጎይፆ ሚኢሼ ማዖም፤ ዬይ ዓሢ ዔሩዋኣዖ ዻቤ ዻቢንቶ ዛሎ ቄኤሳሢ፥ ዬያ ዒንጊንቴ ባኮ ናንጊና ናንጋ ጎዳ ቤርቶ ሺኢሾንጎ፤ ዬያ ዓሢኮዋ ጎማ ጌኤሽካንዳኔ። <verse eid="LEV 5:18"/><verse number="19" style="v" sid="LEV 5:19"/>ዓሢ ናንጊና ናንጋ ጎዳም ዋይዞ ዒፂ ዻቤ ዻቢንቶ ጌኤሻ ዒንጊሢ ዬይ ማዓንዳኔ» ጌዔኔ።<verse eid="LEV 5:19"/></para>
  <chapter eid="LEV 5"/>
  <chapter number="6" style="c" sid="LEV 6"/>
  <para style="p">
    <verse number="1" style="v" sid="LEV 6:1"/>ናንጊና ናንጋ ጎዳ ሃሣ ሙሴም ሃካፓ ሊካ ዓኣ ዳምቦ ኬኤዜኔ፦ <verse eid="LEV 6:1"/><verse number="2" style="v" sid="LEV 6:2"/>«ዓይጎ ዓሲያ ማዖም ዓሲ ኮርካፓ ታልዔ ባኣዚ፤ ሃሣ ጊንሣ ዒዛ ኮራ ጌሦና ባኣዚ ‹ታ ዔሩዋሴ› ጌይ ማሂ ዒንጎ ዒፂ፥ ጎሜ ማዺ ናንጊና ናንጋ ጎዳም ጉሙርቱዋያ ማዔቴ፥ ሃሣ ዓሲ ባኣዚ ጌሺ ቡሪ ዔኬቴ፥ <verse eid="LEV 6:2"/><verse number="3" style="v" sid="LEV 6:3"/>ዬያጉዲ ሃሣ ባይቄ ባኣዚ ዴንቂ ዔካዖ ‹ታ ዴንቂባኣሴ› ጌይ ሉኡዙሞና ጫኣቂ፤ ዓሲ ማዻ ዬያጉዴ ጎሞፓ ፔቴ ማዺ ዻቢንቴቴ፥ <verse eid="LEV 6:3"/><verse number="4" style="v" sid="LEV 6:4"/>ዓይጎ ዓሲታቴያ ዬያይዴቴ ዒዚ ዉኡቄ ባኮ፥ ጌሺ ቡሪ ዔኬ ባኮ፥ ማዒባኣ ካራና ዓሲሮ ዔኬ ባኮ፥ ዒዛ ኮራ ጌሦና ባኮ ዒ ዔኬሢ፥ ዓሲኮ ባይቄያታንቴ ዒ ዴንቂ ዔኬ ባኮ፥ <verse eid="LEV 6:4"/><verse number="5" style="v" sid="LEV 6:5"/>ሉኡዙሞና ዒ ጫኣቂ ዔኬ ባኮ ቢያ ማሆንጎ፤ ሃሣ ዒ ዻቢንቶ ዛሎ ናንጊና ናንጋ ጎዳም ዒንጋ ዎዶና ዒ ዔኬ ባኮኮ ዶንጎይዳፓ ፔቴ ኩቺ ማዓያ ቃሲ ዔቦ ዓዶም ማሂ ጪጎንጎ። <verse eid="LEV 6:5"/><verse number="6" style="v" sid="LEV 6:6"/>ዒ ዻቤ ዻቢንቶኮ ጋሎ ጪጎ ማዓንዳጉዲ ቆልማፓ ዔኤቢ ቦሂሳ ባኣዚባኣ፥ ዓዴ ማራይ ዒንጎ ባኣዚ ማሂ ናንጊና ናንጋ ጎዳም ዔኪ ሙኮንጎ፤ ዬያ ዔኪ ሙኪ ቄኤሳሢም ዒንጎንጎ፤ ዬይ ሻንቺንቲ ኬሳንዳ ሚኢሻ ‹ያዺ ኬሳንዳኔ› ጌይንታ ጎይፆ ሚኢሼ ማዖም። <verse eid="LEV 6:6"/><verse number="7" style="v" sid="LEV 6:7"/>ቄኤሳሢ ዬያ ዓሢኮ ጎሞ ዛሎ ዒንጎ ባኣዚ ማሂ ናንጊና ናንጋ ጎዳ ቤርቶ ሺኢሾንጎ፤ ዒዛ ዻቢንቴያ ማሄ ጎማኣ ጌኤሽካንዳኔ» ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">6፡7 </char><char style="xt" closed="false"><ref loc="NUM 5:5-8">ፓይ. ማፃ 5፡5-8</ref>።</char></note><verse eid="LEV 6:7"/></para>
  <para style="s1">ጉቤ ሚቺ ዒንጎ ዒንጊሢ ዛላ</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 6:8"/>ናንጊና ናንጋ ጎዳ ሃሣ ሂዚ ጌይ ሙሴ ዓይሤኔ፦ <verse eid="LEV 6:8"/><verse number="9" style="v" sid="LEV 6:9"/>«ዓኣሮኔና ዒዛኮ ናኣቶናም ሚቺ ዒንጎ ዒንጊፆ ዳምቦ ዛሎ ኔ ኬኤዛንዳሢ ያዺኬ፤ ሚቺ ዒንጎ ባካ ዋንቶ ጉቤ ሚቺ ዒንጎ ቤዞይዳ ማዔም ታማ ዔኤቴ ጎይሣ ዎርቆንጎ፤ <verse eid="LEV 6:9"/><verse number="10" style="v" sid="LEV 6:10"/>ቄኤሳሢ ሚዛጶ ሱኡፖና ኮሺንቴ ቃሚሾንታ ቆንፆዋ ማይንቲ ቱኡቴስካፓ ሚቺ ዒንጎ ቤዞይዳ ሚቺንቴ ቢዲንፆ ዓኣሢ ዔኪ ሚቺ ዒንጎ ቤዞኮ ኮይላ ላኣሎንጎ፤ <verse eid="LEV 6:10"/><verse number="11" style="v" sid="LEV 6:11"/>ዬካፓ ዓፒሎ ኬሲ፥ ሜሌ ማኣዖ ማይንቲጋፓ ዬያ ዲቢንፆ ዔኪ ጉርዶኮ ዙላ ዓኣ ካኣዦ ዳምቦና ጌኤሺ ማዔ ቤዛ ላኣሎንጎ። <verse eid="LEV 6:11"/><verse number="12" style="v" sid="LEV 6:12"/>ሚቺ ዒንጎ ቤዛ ዓኣ ታማ ቢያ ዎዴ ሃይቁዋዖ ዔኤቲ ዴዖንጎ፤ ቄኤሳሢ ጉቴ ጉቴ ሃንፂሎ ታማ ዓጎንጎ፤ ዬያ ታሞይዳ ሚቺ ዒንጎ ባኮ ጊኢጊሺ ጌሢ፥ ፔቱሞና ዒንጎ ባኮኮ ማሎ ዒኢካ ሚቾንጎ። <verse eid="LEV 6:12"/><verse number="13" style="v" sid="LEV 6:13"/>ዬይ ታማ ቢያ ዎዴ ሃይቁዋዖ ሚቺ ዒንጎ ቤዞይዳ ዔኤቶንጎ።»<verse eid="LEV 6:13"/></para>
  <para style="s1">ሃኣኮ ዒንጊሢ ዛላ</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 6:14"/>«ሃኣኮ ዒንጊሢ ዛላ ኬሲንቴ ዳምቦ ጎይፃ ያዺኬ፦ ዓኣሮኔ ፃጳፓ ማዔ ቄኤሳ ሃኣኮ ዒንጊፆ ሚቺ ዒንጎ ቤዞኮ ቤርቶ ዛላ ዔኪ ሙኪ ናንጊና ናንጋ ጎዳ ቤርታ ሺኢሾንጎ። <verse eid="LEV 6:14"/><verse number="15" style="v" sid="LEV 6:15"/>ዬካፓ ቄኤሳሢ ዛይቶና ዲርኪንቴ ዺኢላፓ ፔቴ ሾኦፓ ዔኪ፤ ሃሣ ዬያ ሃኣኮ ዒንጊፆይዳ ዓኣ ዑንጆ ጉቤ ዔኪ ፆኦሲም ዒንጊንቴያ ማዒፆ ዔርዛኒ ሚቺ ዒንጎ ቤዞይዳ ሚቾንጎ፤ ዬያኮ ሳዋ ናንጊና ናንጋ ጎዳ ዎዛሳ ዒንጊሢ ማዓንዳኔ። <verse eid="LEV 6:15"/><verse number="16-17" style="v" sid="LEV 6:16-17"/>ዓቴ ባኮ ቄኤሳሢ ሙዖንጎ፤ ዬያ ሙኑቃ ፃኣዛ ጊዳ ጌልዚባኣዖ ላኣዳ ላኣዲ ዓፒሎና ማዢንቴ፥ ታኣም ዱማዼ ማኣሮኮ ቤርቶ ዛላ ቃምዖ ጋራ ሙዖንጎ፤ ዓይጎሮ ጌዔቴ ዬያ ሙዖ ዒንጊፆ ሚቺ ዒንጎ ዒንጊፆና ዎላ ቄኤሶሮ ማዓንዳጉዲ ታኣኒ፥ ናንጊና ናንጋ ጎዳ ዓይሤኔ፤ ዬይ ጎሞ ዛሎ ዒንጎ ባኮንታ ዻቢንቶ ዛሎ ጪጎ ባኮጉዲ ሚርጌና ታኣም ዱማዼያኬ። <verse eid="LEV 6:16-17"/><verse number="18" style="v" sid="LEV 6:18"/>ሙካ ዎዶ ቢያይዳ ዓኣሮኔ ዜርፃፓ ሾይንቴ ዓቲንቄ ቢያ ታኣም ዒንጊንታ ባኮይዳፓ ዓቴሢ ዒዛሮታሢሮ ሙዓኒ ዳንዳዓኔ፤ ዓይጎዋ ማዖም ዬያ ባኮ ካኣማ ባኣዚ ቢያ ፆኦሲም ዱማዼያ ማዓንዳኔ።»<verse eid="LEV 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 6:19"/>ናንጊና ናንጋ ጎዳ ሃሣ ሂዚ ጌይ ሙሴ ዓይሤኔ፦ <verse eid="LEV 6:19"/><verse number="20" style="v" sid="LEV 6:20"/>«ቄኤሳ ዶኦሪንታ ኬሎና ቢያ ዎዴ ሃኣኮ ዒንጊፃ ዒንጊንታሢና ዎላ ሄኮ ማዔ ፔቴ ኪሎ ጊራኣሜ ማዓ ሺኢቺ ዺኢሊ ዔኪ ሙኮንጎ፤ ዬያኮ ዛላ ጉቴ፥ ዛላ ዒባኒ ታኣም ዒንጎያ ማዒ ሺኢኮንጎ። <verse eid="LEV 6:20"/><verse number="21" style="v" sid="LEV 6:21"/>ጊኢጊሺ ዛይቴና ዲርኪ ቦኦቆይዳ ላኣዲንቶንጎ፤ ዬካፓ ዬያ ሃኣኮ ዒንጊፆ ቡንፂ ሳዋ ታና ዎዛሳያ ማዓንዳጉዲ ሃኣኮ ዒንጊሢ ማሂ ዒንጊንቶንጎ። <verse eid="LEV 6:21"/><verse number="22" style="v" sid="LEV 6:22"/>ሙካ ዎዶ ቢያይዳ ቄኤሴ ማዒ ማዻ፥ ዓኣሮኔ ዜርፃ ቢያ ዬያ ዳምቦ ኩንሦንጎ፤ ዬይ ታኣም ዒንጊንታ ሚቺ ዒንጎ ዒንጊሢ ማዒ ጉቤ ሚቺንቶንጎ። <verse eid="LEV 6:22"/><verse number="23" style="v" sid="LEV 6:23"/>ቄኤሳሢ ዒንጋ ሃኣኮ ዒንጊፆይዳፓ ሙይንታይ ባኣያ ማዒ ቢያ ሚቺንታንዳያ ኮይሳኔ።»<verse eid="LEV 6:23"/></para>
  <para style="s1">ጎሜ ዛላ ናንጊና ናንጋ ጎዳም ዒንጎ ዒንጊሢ</para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 6:24"/>ናንጊና ናንጋ ጎዳ ሂዚ ጌይ ሙሴ ዓይሤኔ፦ <verse eid="LEV 6:24"/><verse number="25" style="v" sid="LEV 6:25"/>«ጎሞ ዛሎ ሚቺ ዒንጎ ዒንጊፆ ዛሎኮ ዓኣሮኔ ናኣቶም ኔ ኬኤዛንዳ ዳምባ ያዺኬ፤ ሚቺ ዒንጎ ቆልማ ሹኪንታ፥ ፆኦሲም ዒንጎ ባኮ ዒንጎ ቤዞኮ ኬዶ ዛላ ጎሞ ዛሎ ዒንጊንታ ቆልማ ናንጊና ናንጋ ጎዳ ቤርታ ሹኪንቶንጎ፤ ዬይ ሚርጌና ታኣም ዱማዼያ ማዓንዳኔ። <verse eid="LEV 6:25"/><verse number="26" style="v" sid="LEV 6:26"/>ቆልሞ ሺኢሺ ዒንጋ ቄኤሳሢ ዬያ ዓሽኮ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮኮ ቃምዖ ጋራ ታኣም ዱማዼ ቤዞይዳ ሙዖንጎ። <verse eid="LEV 6:26"/><verse number="27" style="v" sid="LEV 6:27"/>ዓሲታቴያ ዓይጎ ባኣዚያ ማዖም ዬያ ዓሽኮ ካኣሜቴ ዬይ ታኣም ዱማዼያ ማዓንዳኔ፤ ሃሣ ዓይጎ ዓፒላኣ ማዖም ዬይ ሱጉፃ ካኣሜቴ ታኣም ዱማዼ ቤዞይዳ ማስኪንቶንጎ። <verse eid="LEV 6:27"/><verse number="28" style="v" sid="LEV 6:28"/>ዓሽካ ካሢንቴሢ ዓይጎ ዖቲዳታቴያ ዬኖ ዖቶ ዎዻንዳያ ኮይሳኔ፤ ጋዓንቴ ዓሽካ ካሢንቴሢ ዓንጊ ዖቲዳ ማዔቴ ኮሺ ዶርቺ ዋኣሢና ማስኪንቶንጎ። <verse eid="LEV 6:28"/><verse number="29" style="v" sid="LEV 6:29"/>ቄኤሶ ማኣሮይዳፓ ማዔ፥ ዓቲንቄ ቢያ ዬያ ሙዓኒ ዳንዳዓኔ፤ ዬይ ሚርጌና ታኣም ዱማዼ ዒንጊሢኬ። <verse eid="LEV 6:29"/><verse number="30" style="v" sid="LEV 6:30"/>ጋዓንቴ ሱጉፃ ጎሞ ጌኤሺፆ ዳምቦሮ ዓፒሎና ማዢንቴ፥ ታኣም ዱማዼ ማኣሮ ዔኪ ጌሊንቴያ ማዔቴ ዬይ ዓሽካ ሙይንቱዋዖ ቢያ ታሚና ሚቺንቶንጎ።»<verse eid="LEV 6:30"/></para>
  <chapter eid="LEV 6"/>
  <chapter number="7" style="c" sid="LEV 7"/>
  <para style="s1">ዻቢንቲ ዛላ ጪጋ ማሂ ዒንጎ ዒንጊሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 7:1"/>ናንጊና ናንጋ ጎዳ ሃሣ ኬኤዛዖ፦ «ሚርጌና ታኣም ዱማዼያ ማዔሢሮ ዻቢንቶ ዛሎ ጪጋ ማሂ ዒንጎ ዒንጊፆ ጎይፃ ያዺ ማዖንጎ፦ <verse eid="LEV 7:1"/><verse number="2" style="v" sid="LEV 7:2"/>ዻቢንቶ ዛሎ ዒንጊንታ ቆልማ ፆኦሲም ዒንጎ ባኮ ዒንጎ ቤዞኮ ኬዶ ዛላ ዓኣ ቤዞይዳ ሹኪንቶንጎ፤ ሱጉፃ ሚቺ ዒንጎ ቤዞኮ ዖይዶ ዛሎ ጎኦቦይዳ ፑጪንቶንጎ። <verse eid="LEV 7:2"/><verse number="3" style="v" sid="LEV 7:3"/>ዬያኮ ማላ ቢያ ሹኪንቲ ዔውቲ ሺኢኮንጎ፤ ዬይያኣ፦ ዑንኮ ማላ፥ ጎጶ ባኮ ካንቄ ሃኣቦ ማላ፥ <verse eid="LEV 7:3"/><verse number="4" style="v" sid="LEV 7:4"/>ጳላሢና ዒኢካ ዓኣ ማላ፤ ዬያጉዲ ሃሣ ማዮኮ ሻኣዣዻ ቤዛኣ ሺኢሺንቶንጎ። <verse eid="LEV 7:4"/><verse number="5" style="v" sid="LEV 7:5"/>ቄኤሳሢ ናንጊና ናንጋ ጎዳም ሚቺ ዒንጎ ዒንጊሢ ማዓንዳጉዲ ሚቺ ዒንጎ ቤዞይዳ ጌሢ ዬያ ሚቾንጎ፤ ዬይ ዻቢንቲ ዛላ ዒንጊንታ ዒንጊሢ ማዓኔ። <verse eid="LEV 7:5"/><verse number="6" style="v" sid="LEV 7:6"/>ቄኤሶ ፃጳፓ ማዔ ዓቲንቃ ቢያ ዬያ ዓሽኮ ሙዓኒ ዳንዳዓኔ፤ ዬይ ሚርጌና ታኣም ዱማዼያታሢሮ ታኣም ዱማዼ ቤዛ ሙዖንጎ።<verse eid="LEV 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 7:7"/>«ጎሞ ዛሎ ዒንጊንታ ዒንጊፆና ዻቢንቶ ዛሎ ጪጋ ማሂ ዒንጎ ዒንጊፆኮ ዳምባ ፔቴኬ፤ ዬይያ፦ ዒንጊንቴ ባካ ዒንጎ ዳምቦ ኩንሤ ቄኤሳሢም ዒንጊንታኔ። <verse eid="LEV 7:7"/><verse number="8" style="v" sid="LEV 7:8"/>ዓይጎ ዓሲማኣ ማዖም ሚቺ ዒንጎ ዒንጊሢ ማዒ ዒንጊንቴ ቆልሞኮ ዒልዓ ሹኪንቲ ዬኖ ዒንጊፆ ፆኦሲም ዒንጌ ቄኤሳሢም ዒንጊንቶንጎ። <verse eid="LEV 7:8"/><verse number="9" style="v" sid="LEV 7:9"/>ቦኦቆይዳ ጉኡፒ ላኣዲንቴ ላኣዳ፥ ዖቲዳ ካሢንቴያ፥ ቦኦቆይዳ ጉሪ ላኣዶናያኣ ቢያ ዒንጎ ባኮ ፆኦሲም ዔኪ ሺኢሼ ቄኤሳሢም ዒንጊንቶንጎ። <verse eid="LEV 7:9"/><verse number="10" style="v" sid="LEV 7:10"/>ዛይቶና ዲርኪ ጊኢጊሾናሢ ማዔቴያ ሜሌ ጉሪ ዒንጊንቴ ሃኣኮ ዒንጊፃ ዓኣሮኔ ፃጶ ማዔ፥ ቄኤሶም ቢያ ዒንጊንቴም ዔያታ ሄኮ ጊሽቲ ዔኮንጎ።»<verse eid="LEV 7:10"/></para>
  <para style="s1">ፔቱሞና ፆኦሲም ዒንጎ ዒንጊሢ</para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 7:11"/>«ናንጊና ናንጋ ጎዳም ዒንጊንታ ፔቱሞና ዒንጎ ዒንጊፆኮ ዳምባ ያዺ ማዓንዳኔ፤ <verse eid="LEV 7:11"/><verse number="12" style="v" sid="LEV 7:12"/>ፔቴ ዓሲ ፆኦሲም ጋላታሮ ዒንጋ ዒንጊሢ ማዔቴ ዒዚ ዒንጋ ቆልሞና ዎላ ሙኑቃ ፃኣዛ ጌሊባኣ ላኣዳ፥ ዛይቴና ዲርኪ ሻኣዣሲ ላኣዶና ላኣዳ፥ ዛይቴና ዲርኮና ሺኢቺ ዺኢሊያ ሺኢሾንጎ። <verse eid="LEV 7:12"/><verse number="13" style="v" sid="LEV 7:13"/>ጋላቶሮ ዒንጊንታ ፔቱሞ ዒንጊፆና ዎላ ሙኑቃ ፃኣዛ ዋሂ ላኣዲንቴ ካሣ ሺኢሾንጎ። <verse eid="LEV 7:13"/><verse number="14" style="v" sid="LEV 7:14"/>ዱማ ዱማ ካሦኮ ቶኦካፓ ቶኦካፓ ፔቴ ፔቴ ዔኪ ናንጊና ናንጋ ጎዳም ዱማዼ ዒንጊሢ ማሂ ሺኢሾንጎ፤ ዬይ ባካ ቆልሞ ሱጉፆ ዔኪ ሚቺ ዒንጎ ቤዞኮ ጎኦቦ ፑጬ፥ ቄኤሳሢም ማዖንጎ። <verse eid="LEV 7:14"/><verse number="15" style="v" sid="LEV 7:15"/>ዬይ ዒንጊንቴ ዓሽካ ዒዞ ኬሎ ሙይንቲ ጋጋፖንጎ፤ ዓቲ ዎርቆፓ።<verse eid="LEV 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 7:16"/>«ፔቴ ዓሲ ናኣቤ ናኣባ ኩሜሢሮ ጌይ፤ ሃሣ ፔ ማሊሢና ዔኪ ዒንጋያ ማዔቴ ዒንጊንቴ ኬሎ ሙይንቶንጎ፤ ዓቴሢ ዚሮ ጉቴ ቢያ ሙይንቶንጎ። <verse eid="LEV 7:16"/><verse number="17" style="v" sid="LEV 7:17"/>ዬካፓ ዓቲ ሃይሣሳ ኬሎ ሄላንዳኣና ዴዔቴ ዓሽካ ታሚና ሚቺንቶንጎ። <verse eid="LEV 7:17"/><verse number="18" style="v" sid="LEV 7:18"/>ዓቴ ዓሽካ ሃይሣሳ ኬሎ ዎማይዲ ማዔቴያ ሙይንቴቴ ዬያ ዓሢኮ ዒንጊፆ ፆኦሲ ዔካያቱዋሴ፤ ዬይ ዒንጊፃኣ ዒንጊንቴያ ማዓዓኬ፤ ዬይ ዒኢቴ ባኣዚ ማዓንዳኔ፤ ዬያ ሙዔ ዓሢ ሜቶ ዔካንዳኔ። <verse eid="LEV 7:18"/><verse number="19" style="v" sid="LEV 7:19"/>ዒኢቴ ባኣዚና ካኣሜ ዓሽካ ሚሚቺንቶንጎ፥ ሙይንቶፓ።</para>
  <para style="p" vid="LEV 7:19">«ሜሌ ዓሽኮ ጋዓንቴ ካኣዦ ዳምቦ ጎይፆና ጌኤሺ ማዔ ዓይጎ ዓሲያ ሙሙዖንጎ፤ <verse eid="LEV 7:19"/><verse number="20" style="v" sid="LEV 7:20"/>ጋዓንቴ ፔቴ ዓሲ ዳምቦ ጎይፆና ጌኤሺቱዋዖ ዬያ ሙዔቴ ፆኦሲ ዴሮ ባኣኮይዳ፥ ፆኦሲ ዓሲ ማዒ ፔቴታዖ ፓይዲንቶፓ። <verse eid="LEV 7:20"/><verse number="21" style="v" sid="LEV 7:21"/>ዳምቦ ጎይፆና ጌኤሺ ማዒባኣ፥ ዓሲፓ ማዖም ቆልሞፓ ኬስካ ዒኢሳ ባኣዚ፤ ሃሣ ዓይጎዋ ዒኢሳ ባኣዚ ሄሌዖ ናንጊና ናንጋ ጎዳም ዒንጊንቴ፥ ፔቱሞና ዒንጎና ዒንጊፆኮ ዓሽኮ ሙዔቴ ዬይ ዓሢ ፆኦሲ ዴራፓ ዱማዺ ባባይቆንጎ» ጌዔኔ።<verse eid="LEV 7:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 7:22"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 7:22"/><verse number="23" style="v" sid="LEV 7:23"/>«ዒስራዔኤሌ ዴሮም ሂዚ ጌዔ፤ ባይና ማራይና ዋኣሪናኮ ማሊ ሙይፖቴ፤ <verse eid="LEV 7:23"/><verse number="24" style="v" sid="LEV 7:24"/>ጉሪ ሃይቄ ቆልሞንታ ቦዖ ዎዼ ቆልሞንታኮ ማላ ሜሌ ባኣዚ ማዺንቶንጎ፤ ዓሲ ሙሙዖፓ። <verse eid="LEV 7:24"/><verse number="25" style="v" sid="LEV 7:25"/>ፆኦሲም ሚቺ ዒንጎያ ማሂ ዒንጊንቴ ቆልሞኮ ማሎ ሙዓ ዓይጎ ዓሲያ ፆኦሲ ዴሮ ባኣካፓ ባይቆንጎ። <verse eid="LEV 7:25"/><verse number="26" style="v" sid="LEV 7:26"/>ዒስራዔኤሌ ዓሳ ዓንኮ ቤስካኣ ማዖም ናንጋ ቤዞ ቢያይዳ ካፒሮታቴያ ቆልሞ ሱጉሢ ሙዖፓ። <verse eid="LEV 7:26"/><verse number="27" style="v" sid="LEV 7:27"/>ዓይጎ ዓሲያ ማዖም ሱጉሢ ሙዓ ዓሲ ፆኦሲ ዴሮ ባኣካፓ ባይቆንጎ» ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">7፡27 </char><char style="xt" closed="false"><ref loc="GEN 9:4">ማዢ. ማፃ 9፡4</ref>፤ <ref loc="LEV 17:10-14">ሌዊ. ዓኬ 17፡10-14</ref>፤ <ref loc="LEV 19:26">19፡26</ref>፤ <ref loc="DEU 12:16">ላሚ. ዎማ 12፡16</ref>፤ <ref loc="DEU 23">23</ref>፤ <ref loc="DEU 15:23">15፡23</ref>።</char></note><verse eid="LEV 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 7:28"/>ናንጊና ናንጋ ጎዳ ሃሣ ሙሴም፦ <verse eid="LEV 7:28"/><verse number="29" style="v" sid="LEV 7:29"/>«ዒስራዔኤሌ ዴሮም ሂዚ ጌዔ፤ ዓይጎ ዓሲያ ማዖም ፔቱሞና ዒንጎ ዒንጊፆ ፆኦሲም ዒንጋቴ ዬያይዳፓ ፓቂ ፔ ዛሎ ዒንጎ ባኣዚ ማሂ ናንጊና ናንጋ ጎዳም ዔኪ ሺኢኮንጎ። <verse eid="LEV 7:29"/><verse number="30" style="v" sid="LEV 7:30"/>ዬያ ሚቺ ዒንጎ ዒንጊሢ ማሂ ፆኦሲም ፔ ኩቻ ዒንጎንጎ፤ ማሎ ዚኢሮና ዎላ ሺኢሺ፥ ዚኢሮዋ ዡጊ ናንጊና ናንጋ ጎዳም ዒንጊሢ ማሂ ሺኢሾንጎ። <verse eid="LEV 7:30"/><verse number="31" style="v" sid="LEV 7:31"/>ቄኤሳሢ ዬያ ማሎ ሚቺ ዒንጎ ቤዛ ሚቾንጎ፤ ዚኢሮ ጋዓንቴ ቄኤሶም ዒንጎንጎ። <verse eid="LEV 7:31"/><verse number="32" style="v" sid="LEV 7:32"/>ዬኖ ዒንጊፆኮ ሚዛቆ ዛሎ ላባዎ ዬያ ቄኤሳሢም ዒንጎንጎ፤ <verse eid="LEV 7:32"/><verse number="33" style="v" sid="LEV 7:33"/>ሚዛቆ ዛሎ ላባኣ ሱጉፆንታ ማሎንታ ዔኪ ፔቱሞ ዒንጊፆ ማሂ ፆኦሲም ሺኢሼ ቄኤሳሢ ዛላ ማዖንጎ። <verse eid="LEV 7:33"/><verse number="34" style="v" sid="LEV 7:34"/>ዡጊንቴ ዚኢሮና ዔኪ ሺኢሾና ላባዎ ዒስራዔኤሌ ዴራ ዒንጌ ዒንጊፆፓ ዔኪ፥ ቄኤሳሢ ዓኣሮኔና ዒዛኮ ናኣቶናም ናንጊና ዔያቶሮ ማዓንዳጉዲ ታ ዒንጌኔ» ጌዔኔ።<verse eid="LEV 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 7:35"/>«ዓኣሮኔና ናኣቶና ቄኤሴ ማዓንዳጉዲ ፆኦሲ ዶኦሬ ኬሎና ፆኦሲም ዒንጊንታ ሚቺ ዒንጎ ዒንጊፆኮ ቄኤሶ ዛሎ ማዓንዳጉዲ ዱማሶናሢ ዬያኬ። <verse eid="LEV 7:35"/><verse number="36" style="v" sid="LEV 7:36"/>ዬኖ ኬሎና ዬያ ዒንጊፆይዳፓ ቄኤሶ ሄላ ዛላ ዔያቶም ዒንጊንታንዳጉዲ ናንጊና ናንጋ ጎዳ ዓይሤኔ፤ ዬይ፦ ኬስካ ዎዶ ቢያይዳ ዒስራዔኤሌ ዓሳ ኩንሣኒ ኮይሳ ዳምቤኬ።»<verse eid="LEV 7:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 7:37"/>ዓካሪ፦ ሚቺ ዒንጎ ዒንጊፆ ዳምባ፥ ሃኣኮ ዒንጎሢሲ፥ ጎሞ ጌኤሻኒ ዒንጎ ዒንጊፆሲ፥ ዻቢንቶ ዛሎ ዒንጎ ዒንጊፆሲ፥ ቄኤሶ ዶኦሪፆም ጌይ ዒንጎ ዒንጊፆሲንታ ፔቱሞና ዒንጎ ዒንጊፆኮ ዳምባ ያዺኬ። <verse eid="LEV 7:37"/><verse number="38" style="v" sid="LEV 7:38"/>ዒስራዔኤሌ ዴራ ፆኦሲም ዒንጎ ባኮ ዒንጋንዳጉዲ ዓሲ ናንጉዋ ዳውሎኮ ሲና ዹኮ ኮይላ ዔያቶም ኬኤዚንቴያና ናንጊና ናንጋ ጎዳ ሙሴም ዬያ ዳምቦ ኬኤዜኔ።<verse eid="LEV 7:38"/></para>
  <chapter eid="LEV 7"/>
  <chapter number="8" style="c" sid="LEV 8"/>
  <para style="s1">ዓኣሮኔና ናኣቶና ቄኤሴ ማዓንዳጉዲ ዶኦሪንቲፆ</para>
  <para style="r">(<ref loc="EXO 29:1-37">ኬሲ. ማፃ 29፡1-37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 8:1"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 8:1"/><verse number="2" style="v" sid="LEV 8:2"/>«ዓኣሮኔንታ ዒዛኮ ዓቲንቆ ናኣቶንታ ዓፒሎና ማዢንቴ፥ ታኣኒ ዴሮና ካኣማ ማኣሮ ካሮ ዔኪ ዓኣዼ፤ ዒማና ቄኤሳ ማይንታ ዓፒላ፥ ቲዦ ዛይታ፥ ጎሜ ጌኤሻኒ ዒንጎ ጌሜ፥ ላምዖ ዓዶ ማራታ፥ ሙኑቆ ፃኣዛ ጌሊባኣ ላኣዳ ዓኣ ሌኤማቶዋ ዔኪ ሺኢሼ። <verse eid="LEV 8:2"/><verse number="3" style="v" sid="LEV 8:3"/>ሃሣ ዒስራዔኤሌ ዴሮ ቢያ ፔቴይዳ ዔኤሊ ዒኢካ ቡኩሴ» ጌዔኔ።<verse eid="LEV 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 8:4"/>ናንጊና ናንጋ ጎዳ ዓይሤ ጎይፆ ሙሴ ማዼኔ፤ ዴራኣ ሙኪ ቡካዛ፥ <verse eid="LEV 8:4"/><verse number="5" style="v" sid="LEV 8:5"/>ዒዚ ዔያቶም፦ «ሃሢ ታ ዒንሢኮ ቤርታ ማዻንቴ ዒንሢ ዛጋንዳሢ ናንጊና ናንጋ ጎዳ ታና ዓይሤ ባኮኬ» ጌዔኔ።<verse eid="LEV 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 8:6"/>ሙሴ ዓኣሮኔንታ ዒዛኮ ዓቲንቆ ናኣቶንታ ዓሶ ቤርቶ ሺኢሺ፥ ዋኣፆና ማስቲፆ ዳምቦ ኩንሣኒ ማስኬኔ። <verse eid="LEV 8:6"/><verse number="7" style="v" sid="LEV 8:7"/>ዬያይዴስካፓ ቄኤሳ ማኣዓ ዖዶዞ ቃሚሾ ዓኣሮኔ ማይሲ፥ ዼኤፒ ኮኦቴያ ማይሲ፥ ኬርና ቱኮ ባኮዋ ቱኡሲ፥ ዔፑዴ ጌይንታ ባቃና ዓጎ ባኮዋ ዓጊ፥ ዱማ ጎይሢና ሚዛጲሲ ኮሾና ቃልሾና ዬያ ዔፑዶ ዓይሢ ኬርና ቱኬኔ፤ <verse eid="LEV 8:7"/><verse number="8" style="v" sid="LEV 8:8"/>ዔፑዶኮ ጊዳ፦ ዳዶ ቡራሾ ሲኪ፥ ዑሪሜና ቱሚሜ<note caller="+" style="f"><char style="fr" closed="false">8፡8 </char><char style="fq" closed="false">ዑሪሜና ቱሚሜ </char><char style="ft" closed="false">ዬንሢ ባኮንሢ፦ ፆኦሲ ማሊፆ ዱማሲ ዔራኒ ዓጎ ባኣዚኬ።</char></note> ጌይንታ ባኮንሢ ጋራ ዓጌኔ፤ <verse eid="LEV 8:8"/><verse number="9" style="v" sid="LEV 8:9"/>ሃሣ ቶኦኮይዳ ዓፒላ ማሬኔ፤ ዬያኮ ባሊቶ ዛሎይዳ ናንጊና ናንጋ ጎዳ ዒዛ ዓይሤ ጎይፆና ዎርቄና ኮሺንቴ ፆኦሲም ዱማዼያ ማዒፆ ዔርዛ ማላታ ማዔ፥ ቦንቺሳ ቆኦቦ ዓጌኔ።<verse eid="LEV 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 8:10"/>ዬካፓ ሙሴ ቲዦ ዛይቶ ዔኪ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮንታ ጋራ ዓኣ ባኮዋ ቲሽኬኔ፤ ዬያይዲ ቢያ ባኮ ፆኦሲ ማዾም ዱማሴኔ። <verse eid="LEV 8:10"/><verse number="11" style="v" sid="LEV 8:11"/>ቲዦ ዛይቶይዳፓ ዻካ ዔኪ ፆኦሲም ዒንጎ ባኮ ዒንጎ ቤዞ ዑፃ ላንካይ ማይንቲ ፑጬኔ፤ ዬኖ ጎይፆ ፆኦሲ ማዾም ዱማዼያ ማዓንዳጉዲ ሚቺ ዒንጎ ቤዞና ዒኢካ ዓኣ፥ ማዺንቶ ሜሆ ቢያሢ፤ ሃሣ ዋኣፆ ማስቶ ሳኣኖንታ ጌሦ ቤዞዋ ቢያ ፑጬኔ። <verse eid="LEV 8:11"/><verse number="12" style="v" sid="LEV 8:12"/>ቲዦ ዛይቶ ዓኣሮኔ ቶኦካ ዋሂ፥ ዒዚ ፆኦሲ ማዾም ዱማዻንዳጉዲ ቲሽኬኔ። <verse eid="LEV 8:12"/><verse number="13" style="v" sid="LEV 8:13"/>ዬካፓ ሙሴ ናንጊና ናንጋ ጎዳ ዒዛ ዓይሤ ጎይፆና ዓኣሮኔኮ ዓቲንቆ ናኣቶ ዓሶ ቤርቶ ሺኢሺ፥ ቄኤሳ ማይንታ ዖዶዞ ቃሚሾ ማይሲ፥ ኬርኖ ቱኮ ቃልሾ ቱኪ፥ ቶኦኮይዳኣ ዔያቶም ቆኦቦ ዓጌኔ።<verse eid="LEV 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 8:14"/>ዬካፓ ሙሴ ጎሞ ጌኤሻኒ ዒንጊንቴ ጌሜ ዔኪ ሙካዛ፥ ዓኣሮኔና ናኣቶና ጌሜኮ ቶኦኮይዳ ኩጮ ጌሤኔ። <verse eid="LEV 8:14"/><verse number="15" style="v" sid="LEV 8:15"/>ዬያይዴስካፓ ሙሴ ጌሜ ሹካዖ ሱጉፆይዳፓ ኬኤላና ዔኪ ፆኦሲም ዱማዼያ ማዓንዳጉዲ ዒንጎ ባኮ ዒንጎ ቤዞኮ ዖይዶ ዛላ ዓኣ ዻንኮ ቲሽኪ ጌኤሺ፥ ዓቴ ሱጉፆ ዒንጎ ባኮ ዒንጎ ቤዞኮ ዴማ ዋሄኔ፤ ዬያይዲ ዒንጎ ባኮ ዒንጎ ቤዞ ፆኦሲም ዱማሴኔ። <verse eid="LEV 8:15"/><verse number="16" style="v" sid="LEV 8:16"/>ሃሣ ዒዚ ጌሜኮ ጎጶ ባኮ ዑፃ ዓኣ ማሎ ቢያ፥ ማዮኮ ሻኣዣዻ ቤዞንታ ጳላሢያኣ ዒኢካ ዎላ ዓኣ ማሎና ቢያ ዔኪ ሚቺ ዒንጎ ቤዛ ሚቼኔ። <verse eid="LEV 8:16"/><verse number="17" style="v" sid="LEV 8:17"/>ጌሜኮ ዒልዖ፥ ሃንጎ ዓሽኮ፥ ሩቁንቶንታ ሶኦኮዋ ዔኪ ናንጊና ናንጋ ጎዳ ዓይሤ ጎይፆ ጉርዶኮ ዙላ ኬሲ ሚቼኔ።<verse eid="LEV 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 8:18"/>ዬካፓ ሙሴ ሚቺ ዒንጎም ጊኢጊሺንቴ ማራዓሢ ዔኪ ሙካዛ፥ ዓኣሮኔና ናኣቶና ማራዓሢኮ ቶኦካ ኩጮ ጌሤኔ፤ <verse eid="LEV 8:18"/><verse number="19" style="v" sid="LEV 8:19"/>ዬያይዴስካፓ ሙሴ ማራዓሢ ሹኪ ሱጉፆ ሚቺ ዒንጎ ቤዞኮ ዖይዶ ዛሎ ፑጬኔ። <verse eid="LEV 8:19"/><verse number="20-21" style="v" sid="LEV 8:20-21"/>ማራዓሢኮ ዓሽኮ ሜኤሎና ሜኤሎና ቲቂ፥ ጎጶ ባኮንታ ጊንፆ ቶኮንታ ዋኣሣ ማስኬኔ፤ ዬካፓ ናንጊና ናንጋ ጎዳ ዒዛ ዓይሤ ጎይፆ ቶኦኮንታ ማሎንታ ማራዓሢኮ ዓቴ ዓሽኮዋ ቢያ ሚቺ ዒንጎ ቤዛ ሚቼኔ፤ ዬያ ሚቺ ዒንጎናሢኮ ሳዋ ናንጊና ናንጋ ጎዳ ዎዛሳ ሙኡዚ ዒንጊሢ ማዔኔ።<verse eid="LEV 8:20-21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 8:22"/>ቄኤሶ ዶኦሪፆ ዛሎ ላሚ ዒንጊንታ ማራዓሢ ዔኪ ሙካዛ፥ ዓኣሮኔና ናኣቶና ኩጮ ማራዓሢኮ ቶኦካ ጌሤኔ፤ <verse eid="LEV 8:22"/><verse number="23" style="v" sid="LEV 8:23"/>ዬካፓ ሙሴ ማራዓሢ ሹኪ ሱጉፃፓ ዻካ ዔኪ ዓኣሮኔኮ ሚዛቆ ዋዮ ቤርቶ፥ ሚዛቆ ኩጮና ቶኮናኮ ዶኦሞ ኬኤሎ ቲሽኬኔ፤ <verse eid="LEV 8:23"/><verse number="24" style="v" sid="LEV 8:24"/>ሃሣ ዓኣሮኔኮ ናኣቶ ዓሶኮ ቤርቶ ዔኪ ሺኢሻዖ ሚዛቆ ዋዮ ቤርቶ፥ ሚዛቆ ኩጮና ቶኮናኮ ዶኦሞ ኬኤሎ ዔያቶኮ ቲሽኬኔ፤ ዬያይዲ ዓቴ ሱጉፆ ፆኦሲም ዒንጎ ባኮ ዒንጎ ቤዞኮ ዖይዶ ዛሎ ጎኦቦ ፑጬኔ፤ <verse eid="LEV 8:24"/><verse number="25" style="v" sid="LEV 8:25"/>ዬያይዴስካፓ ማላኣ፥ ዑንኮ ማላ፥ ጎጶ ባኮ ካንቂ ዓኣ ማሎ ቢያ፥ ማዮኮዋ ሻኣዣዻ ቤዞ፤ ጳላሢንታ ዒኢካ ዓኣ ማሎንታ ሚዛቆ ዛሎ ላባዎዋ ዔኬኔ፤ <verse eid="LEV 8:25"/><verse number="26" style="v" sid="LEV 8:26"/>ፆኦሲም ዱማዼያ ማዔ፥ ሙኑቃ ፃኣዛ ጌሊባኣ ላኣዶ ጌሦ ሌማቶይዳፓ ፔቴ ላኣዳ ዔኪ፤ ዬያጉዲ ሃሣ ዛይቶና ዲርኪ ላኣዶና ላኣዳ፥ ሻኣዣ ላኣዳኣ ዔኪ ማሎና ላባዎ ዓሽኮናኮ ዑፃ ጌሤኔ። <verse eid="LEV 8:26"/><verse number="27" style="v" sid="LEV 8:27"/>ዬያ ሙዖ ቢያ ዔኪ ዓኣሮኔና ናኣቶናም ዒንጋዛ ዔያታ ዬያ ዡጊ፥ ናንጊና ናንጋ ጎዳም ዒንጌኔ። <verse eid="LEV 8:27"/><verse number="28" style="v" sid="LEV 8:28"/>ዬካፓ ሙሴ ካሦ ዔያቶ ኩጫፓ ዔኪ፥ ቄኤሶ ዶኦሪፆሮ ሚቺ ዒንጎ ባኮይዳ ቃሲ ጌሢ ሚቺ ዒንጎ ቤዛ ሚቼኔ፤ ዬያኮ ሳዋ ናንጊና ናንጋ ጎዳ ዎዛሳ ሙኡዚ ዒንጊሢ ማዔኔ። <verse eid="LEV 8:28"/><verse number="29" style="v" sid="LEV 8:29"/>ዬያይዴስካፓ ሙሴ ዚኢሮ ዔኪ ዡጊ፥ ናንጊና ናንጋ ጎዳም ዒንጌኔ፤ ዬይ ቄኤሶ ዶኦሪፆሮ ዒንጎ ማራዖኮ ሙሴ ሄላ ቤዞኬ፤ ሙሴያ ናንጊና ናንጋ ጎዳ ዒዛ ዓይሤ ጎይፆ ቢያ ባኮ ማዼኔ።<verse eid="LEV 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 8:30"/>ሃሣ ሙሴ ቲዦ ዛይቶና ዒንጎ ባኮ ዒንጎ ቤዛ ዓኣ ሱጉፃፓኣ ዻካ ዔኪ ዓኣሮኔና ናኣቶናኮ ዑፃ፤ ጊንሣ ሃሣ ዔያቶኮዋ ዓፒሎይዳኣ ቢያ ፑጬኔ፤ ዬያይዲ ዒዚ ዔያቶንታ ዔያቶኮ ዓፒሎንታ ናንጊና ናንጋ ጎዳም ዱማሴኔ።<verse eid="LEV 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 8:31"/>ዬካፓ ሙሴ ዓኣሮኔና ናኣቶናም «ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ካራ ዓሽኮ ካሡዋቴ፤ ናንጊና ናንጋ ጎዳ ታኣም ዓይሢ ኬኤዜ ጎይፆ ቄኤሶ ዶኦሪፆሮ ዒንጎ ካሦ ጌሦ፥ ሌኤማቶ ጋራ ዓኣ ካሦና ዎላ ሙዑዋቴ። <verse eid="LEV 8:31"/><verse number="32" style="v" sid="LEV 8:32"/>ዓቴ ዓሽኮ ማዔቴያ ላኣዶ ታሚና ሚቹዋቴ፤ <verse eid="LEV 8:32"/><verse number="33" style="v" sid="LEV 8:33"/>ዒንሢኮ ቄኤሶ ማሂ ዶኦሪፆ ዳምባ ማዺንቲ ኩማንዳሢ ላንካይ ኬሊዳታሢሮ ዬይ ማዺንቲ ጋፓንዳ፥ ላንካዎ ኬሎ ሄላንዳኣና ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ካራፓ ዓኣዺፖቴ። <verse eid="LEV 8:33"/><verse number="34" style="v" sid="LEV 8:34"/>ጎሞ ዒንሢኮ ጌኤሻኒ፥ ሃያ ኑ ሃኖ ማዼ ባኮ ኩንሣንዳጉዲ ናንጊና ናንጋ ጎዳ ኑና ዓይሤያኬ። <verse eid="LEV 8:34"/><verse number="35" style="v" sid="LEV 8:35"/>ዬያሮ ናንጊና ናንጋ ጎዳ ዓይሤ ባኮ ቢያ ማዺ ኩንሡዋቴ፤ ላንካዎ ኬሎዋ ጉቤ ዋንቴና ሮኦሪና ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ካራ ዴዑዋቴ፤ ዬያ ዒንሢ ማዺባኣቴ ጋዓንቴ ሃይቃንዳኣኬ፤ ዬይ ቢያ ናንጊና ናንጋ ጎዳ ታና ዓይሤ ዎጌኬ» ጌዔኔ። <verse eid="LEV 8:35"/><verse number="36" style="v" sid="LEV 8:36"/>ዓኣሮኔንታ ናኣቶንታ ናንጊና ናንጋ ጎዳ ሙሴ ዛሎና ዔያቶ ዓይሤ ባኮ ቢያ ማዺ ኩንሤኔ።<verse eid="LEV 8:36"/></para>
  <chapter eid="LEV 8"/>
  <chapter number="9" style="c" sid="LEV 9"/>
  <para style="s1">ዓኣሮኔ ናንጊና ናንጋ ጎዳም ዒንጎ ባኮ ዒንጌሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 9:1"/>ላንካይ ኬሊዳ ቄኤሶ ዶኦሪፆ ዳምባ ማዺንቲ ጋፔ ኬሎኮ ዚሮ ጉቴሎ ሙሴ ዓኣሮኔንታ ናኣቶንታ፤ ዬያጉዲ ሃሣ ዒስራዔኤሌ ዴሮኮዋ ሱኡጎ ዔኤሌኔ፤ <verse eid="LEV 9:1"/><verse number="2" style="v" sid="LEV 9:2"/>ዒማና ዒዚ ዓኣሮኔም፦ «ዔኤቢ ቦሂሳ ባኣዚባኣ፥ ፔቴ ዎፓናና ፔቴ ማራይ ዓዴና ዔኪ፤ ዎፓናሢ ጎሞ ጌኤሻኒ ዒንጊንታ ዒንጊሢ፥ ማራዓሢ ሚቺ ዒንጎ ዒንጊሢ ማሂ ናንጊና ናንጋ ጎዳም ሺኢሼ። <verse eid="LEV 9:2"/><verse number="3" style="v" sid="LEV 9:3"/>ዒስራዔኤሌ ዴራ ጎሜ ጌኤሺሢም ዒንጎ ዒንጊሢ ማዓ ፔቴ ኮላይ፤ ሃሣ ዓይጌያ ቦሂሳ ባኣዚባኣ፥ ፔቴ ሌዔ ማዔ ጌማናይ፥ ፔቴ ሌዔ ማዔ ዓዴ ማራናይ ሚቺ ዒንጎ ዒንጊፆም ዔኪ ሙካንዳጉዲ ኬኤዜ፤ <verse eid="LEV 9:3"/><verse number="4" style="v" sid="LEV 9:4"/>ዬያጉዲ ሃሣ ፔቴ ዚያ ጌማናይ፥ ዓዴ ማራናይ፤ ፔቱሞና ዒንጎ ዒንጊፆም ዔኪ ሙኮንጎ፤ ዬንሢ ዛይቴና ዲርኪንቴ ሃኣኮ ዒንጊፆና ዎላ ማሂ ናንጊና ናንጋ ጎዳም ዔያታ ሺኢሾንጎ፤ ዬያ ቢያ ማዾንጎ፤ ዓይጎሮ ጌዔቴ ሃኖ ናንጊና ናንጋ ጎዳ ዒንሢም ፔጋዺ ጴዻንዳኔ» ጌዔኔ።<verse eid="LEV 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 9:5"/>ዔያታ ሙሴ ዓይሤ ባኮ ቢያ ፆኦሲ ዴሮና ካኣማ ማኣሮ ካሮ ዔኪ ሙኬኔ፤ ዴራ ቢያ ዒማና ናንጊና ናንጋ ጎዳ ዚጊ ካኣሽካኒ ዒኢካ ቡኪ ዔቄኔ። <verse eid="LEV 9:5"/><verse number="6" style="v" sid="LEV 9:6"/>ዬካፓ ሙሴ ዔያቶም፦ «ዓኣፓ ዱካ፥ ናንጊና ናንጋ ጎዳኮ ቦንቾ ፖዓ፥ ዒንሢም ፔጋዺ ጴዻንዳሢሮ ዬያ ቢያ ማዻንዳጉዲ ዒዚ ዒንሢ ዓይሤኔ» ጌዔኔ። <verse eid="LEV 9:6"/><verse number="7" style="v" sid="LEV 9:7"/>ሃሣ ሙሴ ዓኣሮኔም፦ «ፆኦሲም ዒንጎ ባኮ ዒንጎ ቤዞ ባንሢ ዶጪ፥ ኔ ጎሞንታ ዴሮ ጎሞዋ ጌኤሻኒ ጎሞ ዛሎ ዒንጎ ባኮንታ ሚቺ ዒንጎ ዒንጊፆዋ ፆኦሲም ሺኢሼ፤ ዬያ ዒንጊንታ ባኮ ዴሮኮ ጎሞ ጌኤሺሳኒ ናንጊና ናንጋ ጎዳ ዓይሤ ጎይፆ ዒንጌ።» <note caller="-" style="x"><char style="xo" closed="false">9፡7 </char><char style="xt" closed="false"><ref loc="HEB 7:27">ዔብ. 7፡27</ref>።</char></note><verse eid="LEV 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 9:8"/>ዬካፓ ዓኣሮኔ ፆኦሲም ዒንጎ ቤዞ ዓኣዻዖ ቤርታሲ ፔ ጎሞ ጌኤሻኒ ዒንጊንታ ዎፓናሢ ሹኬኔ፤ <verse eid="LEV 9:8"/><verse number="9" style="v" sid="LEV 9:9"/>ዒዛኮ ናኣታ ሱጉፆ ዒዛም ዔኪ ሙካዛ፥ ዒዚ ሱጉፆ ኬኤሎና ዔኪ ዔኪ ፆኦሲም ዒንጎ ባኮ ዒንጎ ቤዞኮ ዖይዶ ዛላ ዓኣ፥ ዻንኮ ቲሽካዖ ዓቴ ሱጉፆ ዒንጎ ባኮ ዒንጎ ቤዞኮ ዴማ ዋሄኔ፤ <verse eid="LEV 9:9"/><verse number="10" style="v" sid="LEV 9:10"/>ዬካፓ ማሎንታ ጳላሢንታ ማዮኮዋ ሻኣዣዻ ቤዞ ዔኪ ናንጊና ናንጋ ጎዳ ሙሴ ዓይሤ ጎይፆ ፆኦሲም ዒንጎ ባኮ ዒንጎ ቤዞይዳ ሚቼኔ። <verse eid="LEV 9:10"/><verse number="11" style="v" sid="LEV 9:11"/>ዓሽኮና ዒልዖና ጋዓንቴ ጉርዶኮ ዙላ ኬሲ ሚቼኔ።<verse eid="LEV 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 9:12"/>ዬያይዴስካፓ ዓኣሮኔ ሚቺ ዒንጎ ዒንጊፆም ዔኪ ሺኢሾናሢ ሹካዛ፥ ዒዛኮ ናኣታ ሱጉፆ ዒዛም ዔኪ ሙኬም ፆኦሲም ዒንጎ ባኮ ዒንጎ ቤዞኮ ዖይዶ ዛሎ ዒ ፑጬኔ፤ <verse eid="LEV 9:12"/><verse number="13" style="v" sid="LEV 9:13"/>ሃሣ ዒዛኮ ናኣታ ቶኦኮንታ ዓቴ ዓሽኮኮ ሜኤሎ ሜኤሎ ኬሲ ዔኪ ሙካዛ፥ ዓኣሮኔ ዬያ ቢያ ሚቺ ዒንጎ ቤዛ ሚቼኔ። <verse eid="LEV 9:13"/><verse number="14" style="v" sid="LEV 9:14"/>ዬካፓ ሃሣ ጎጶ ባኮና ጊንፆ ቶኮ ዋኣሢና ማስካዖ፥ ሚቺ ዒንጎ ባኮኮ ዑፃ ጌሢ ዎላ ሚቼኔ።<verse eid="LEV 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 9:15"/>ዬያይዴስካፓ ዒዚ ዴሮ ዛሎ ዒንጎ ባኮ ሺኢሺ፥ ዓሶኮ ጎሞ ዛሎ ዒንጊንታ ኮሌ ቲቄኔ፤ ዬያኣ ቤርታ ዒ ፔ ጎሞ ዛሎሮ ማዼ ጎይፆ ማዺ ፆኦሲም ሺኢሼኔ። <verse eid="LEV 9:15"/><verse number="16" style="v" sid="LEV 9:16"/>ሃሣ ሚቺ ዒንጎ ዒንጊፆም ማዓ ቆልሞ ዳምቦ ጎይፆና ዔኪ ሙኪ ሹኪ ዒንጌኔ። <verse eid="LEV 9:16"/><verse number="17" style="v" sid="LEV 9:17"/>ሃኣኮ ዒንጊፆዋ ዔኪ ሙኪ፤ ዺኢሎይዳፓ ሾኦፓ ኩሙሢ ዑጪ ዔኪ፤ ጉቴ ጉቴ ዒንጊንታ ሚቺ ዒንጎ ዒንጊፆይዳ ቃሲ ሚቺ ዒንጎ ቤዛ ሚቼኔ። <verse eid="LEV 9:17"/><verse number="18" style="v" sid="LEV 9:18"/>ጌሜና ዓዶ ማራዓሢና ሹኪ፥ ዴራ ፔቱሞና ዒንጋ ዒንጊሢ ማሂ ዒንጌም ዒዛኮ ናኣታ ሱጉፆ ዒዛም ዔኪ ሙኬኔ፤ ዬያ ሱጉፆ ዒዚ ሚቺ ዒንጎ ቤዞኮ ዖይዶ ዛሎይዳ ፑጬኔ፤ <note caller="-" style="x"><char style="xo" closed="false">9፡18 </char><char style="xt" closed="false"><ref loc="LEV 3:1-11">ሌዊ. ዓኬ 3፡1-11</ref>።</char></note> <verse eid="LEV 9:18"/><verse number="19" style="v" sid="LEV 9:19"/>ዬካፓ ዒዚ ጌሜና ማራዓሢናኮ ማሎ ቢያ፤ ጌይፃ፦ ዑንኮ ማላ፥ ጎጶ ባኮ ካንቂ ዓኣ ሃኣባ፥ ጳላሢንታ ማዮኮዋ ሻኣዣዻ ቤዞዋ ቢያ ዔኪ፥ <verse eid="LEV 9:19"/><verse number="20" style="v" sid="LEV 9:20"/>ላምዖ ቆልሞንሢኮ ዚኢሮይዳ ጌሤስካፓ ሚቺ ዒንጎ ቤዞይዳ ማሎ ሚቼኔ፤ <verse eid="LEV 9:20"/><verse number="21" style="v" sid="LEV 9:21"/>ዚኢሮንሢንታ ሚዛቆ ዛሎይዳ ዓኣ ጊንፆ ቶኮንሢ ሙሴ ጌዔ ጎይፆና ቄኤሶ ዛላ ማዓንዳጉዲ ዡጊ፥ ናንጊና ናንጋ ጎዳም ሺኢሼኔ።<verse eid="LEV 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 9:22"/>ዓኣሮኔ ዬያ ባኮ ቢያ ዒንጊ ጋፒሴስካፓ ኩጮ ዴሮ ባንሢ ማሂ ዓንጃዖ፥ ሚቺ ዒንጎ ቤዛፓ ኬዴኔ። <note caller="-" style="x"><char style="xo" closed="false">9፡22 </char><char style="xt" closed="false"><ref loc="NUM 6:22-26">ፓይ. ማፃ 6፡22-26</ref>።</char></note> <verse eid="LEV 9:22"/><verse number="23" style="v" sid="LEV 9:23"/>ዬካፓ ሙሴና ዓኣሮኔና ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ጌሊ ዒኢካፓ ኬስካዖ ዴሮ ዓንጄኔ፤ ዒማና ናንጊና ናንጋ ጎዳኮ ቦንቻ ፔጋዺ ጴዻ፥ ዓኣፓ ዱካ ፖዓ ዴሮ ቢያሢም ፖዒ ጴዼኔ፤ <verse eid="LEV 9:23"/><verse number="24" style="v" sid="LEV 9:24"/>ናንጊና ናንጋ ጎዳ ኮሮ፥ ጫሪንጫፓ ታሚ ሙኪ ሚቺ ዒንጎ ቤዞይዳ ዓኣ፥ ዒንጎና ባኮንታ ማሎዋ ቢያ ሙዔኔ፤ ያኣዒ ማዓኣና ዴራ ቢያ ዬያ ዛጋዖ ዒላሺሢና ባሊቶ ሳዖ ሄሊሲ ዚጊ ፆኦሲ ካሽኬኔ።<verse eid="LEV 9:24"/></para>
  <chapter eid="LEV 9"/>
  <chapter number="10" style="c" sid="LEV 10"/>
  <para style="s1">ናኣዳኣቤና ዓቢሁና ዻቢንቲ ማዺ ሃይቄ ሃይቦ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 10:1"/>ናኣዳኣቤና ዓቢሁና ጌይንታ ላምዖ ዓኣሮኔ ናኣቶንሢ ፔኤኮ ታሞ ጩቢሾ ኩንዖይዳ ታሚ ቄንሢ ካኣሺ ዔኪ፥ ጊዳ ዑንጄ ዓጊ፤ ናንጊና ናንጋ ጎዳ ዓይሢባኣ ታሚ ዔኪ ናንጊና ናንጋ ጎዳ ቤርቶ ሺኢሼኔ፤ <verse eid="LEV 10:1"/><verse number="2" style="v" sid="LEV 10:2"/>ዬያሮ ዔርቲባኣንቴ ናንጊና ናንጋ ጎዳ ኮራፓ ታሚ ኬዲ ዔያቶ ሙዔሢሮ ዔያታ ሃይቄኔ። <verse eid="LEV 10:2"/><verse number="3" style="v" sid="LEV 10:3"/>ዬካፓ ሙሴ ዓኣሮኔ ኮራ፦ «ናንጊና ናንጋ ጎዳ ‹ታ ቤርቶ ሺኢኪ፥ ታኣም ማዻሢ ቢያ ታኣኮ ዱማዼያ ማዒፆ ጌኤሹሞ ቦንቾንጎ፤ ታኣኒ ታ ዴሮ ቢያሢ ቤርታ ቦንቺንቴያ ማዓንዳኔ› ጌይ ኬኤዜሢ ዬያቱዋዓዳ?» ጋዓዛ፥ ዓኣሮኔ ዔኤቢ ጎዑዋዖ ዚቲዮ ጌዔኔ።<verse eid="LEV 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 10:4"/>ዬካፓ ሙሴ ዓኣሮኔኮ ዓዶ ዒሾ፥ ዑዚዔኤሌ ጎዖስኬያኮ ናይ ሚሻዔኤሌና ዔልፃፓኔና ዔኤላዖ፦ «ሃኒ ዬይጋፓ ሃንሢ ዒንሢ ጌርሲንሢኮ ሌዞ ዓፒሎና ማዢንቴ፥ ፆኦሲም ዱማዼ ማኣራፓ ዔኪ ጉርዶ ዙሎ ኬሱዋቴ» ጌዔኔ። <verse eid="LEV 10:4"/><verse number="5" style="v" sid="LEV 10:5"/>ዔያታ ሙኪ ሙሴ ዔያቶ ዓይሤ ጎይፆ ሃይቄዞንሢኮ ቄኤሱሞ ማኣዓሢ ኬሱዋዖ ዎላ ኬዲ ዔኪ ጉርዶፓ ዙሎ ኬሴኔ።<verse eid="LEV 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 10:6"/>ዬካፓ ሙሴ ዓኣሮኔና ዒዛኮ ናኣቶ ዓላዜሬንታ ዒታማሬንታም፦ «ሲዪ፥ ቶኦኮ ዒንሢኮ ጉኡሊፖቴ፤ ማኣዓሢያ ዳርዚፖቴ፤ ዬያ ዒንሢ ማዼቴ ሃይቃንዳኣኬ፤ ናንጊና ናንጋ ጎዳ ዴሮ ዑፃ ዻጋዻንዳኔ፤ ጋዓንቴ ናንጊና ናንጋ ጎዳ ታሞና ባይዜ፥ ዒንሢኮ ዓሽኮ ማዔዞንሢ ዒስራዔኤሌ ዓሳ ዬኤካኒ ዳንዳዓኔ። <verse eid="LEV 10:6"/><verse number="7" style="v" sid="LEV 10:7"/>ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ሃሺ ዒንሢ ኬስኪፖቴ፤ ናንጊና ናንጋ ጎዳ ዓይሤ ጎይፆና ዛይቴና ቲሽኪንቲ ዒዛም ዒንሢ ዱማዼያታሢሮ ዒንሢ ያፓ ኬስኬቴ ሃይቃንዳኣኬ» ጋዓዛ፥ ዔያታ ሙሴ ዓይሤ ጎይፆማ ማዼኔ።<verse eid="LEV 10:7"/></para>
  <para style="s1">ቄኤሳ ማዺ ኩንሣንዳጉዲ ኬሲንቴ ዳምቤ</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 10:8"/>ናንጊና ናንጋ ጎዳ ዓኣሮኔም፦ <verse eid="LEV 10:8"/><verse number="9" style="v" sid="LEV 10:9"/>«ኔኤና ኔ ናኣቶና ዎይኖ ዑዦታቴያ ሜሌ ማሣ ዑሺ ዑሽኪ ዓፒሎና ማዢንቴ፥ ታኣኒ ዴሮና ካኣማ ማኣሮ ዒንሢ ጌሉዋጉዲ ዒንሢና ዔሩዋቴ፤ ዒንሢ ዬያይዴቴ ሃይቃንዳኣኬ፤ ዬይ ዒንሢንታ ዒንሢኮ ጊንፃፓ ሙካ ሾይንታ ካፓንዳ ዳምቤ ማዖንጎ። <verse eid="LEV 10:9"/><verse number="10" style="v" sid="LEV 10:10"/>ታኣም ዱማዼ ባኮንታ ዱማዺባኣ ባኮ፥ ዒኢቴ ባኮንታ ጌኤዦ ባኮንታኮ ባኣካ ዓኣ ዱሙሞ ዔሪ፥ <verse eid="LEV 10:10"/><verse number="11" style="v" sid="LEV 10:11"/>ሙሴ ዛሎና ታ ዒንሢም ዒንጌ ዳምቦ ቢያ ዒስራዔኤሌ ዓሶ ዔርዙዋቴ» ጌዔኔ።<verse eid="LEV 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 10:12"/>ዬካፓ ሙሴ ዓኣሮኔና ዒዛኮ ላምዖ ናኣቶ ዓላዜሬንታ ዒታማሬንታም፦ «ናንጊና ናንጋ ጎዳም ዒንጊንቴ ሃኣኮ ዒንጊፆይዳፓ ዓቴ ዺኢሎ ዔኪ ሙኑቃ ፃኣዛ ጌሊባኣ ላኣዳ ላኣዱዋቴ፤ ዬይ ዑሣ ዓኣዼ ፆኦሲም ዱማዼ ዒንጊሢ ማዔሢሮ ታኣም ዒንጎ ባካ ዒንጊንታ ቤዞ ኮይላ ሙዑዋቴ። <verse eid="LEV 10:12"/><verse number="13" style="v" sid="LEV 10:13"/>ዬይ ናንጊና ናንጋ ጎዳም ዒንጊንታ ሃኣኮ ዒንጊፆይዳፓ ፓቂንቲ ኔኤና ኔ ናኣቶና ዛላ ማዔሢሮ ፆኦሲም ዱማዼ ቤዛ ሙዑዋቴ፤ ያኣዼ ዒንሢ ማዻንዳጉዲ ናንጊና ናንጋ ጎዳ ታና ዓይሤኔ። <note caller="-" style="x"><char style="xo" closed="false">10፡13 </char><char style="xt" closed="false"><ref loc="LEV 6:14-18">ሌዊ. ዓኬ 6፡14-18</ref>።</char></note> <verse eid="LEV 10:13"/><verse number="14" style="v" sid="LEV 10:14"/>ዒስራዔኤሌ ዓሳ ፔቱሞና ዒንጋ ዒንጊፆይዳፓ ዒንሢ ዛሎ ማዒ ዒንጊንቴሢሮ ዡጎና ዚኢሮንታ ላባዎንታ ኔናንታ ኔኤኮ ዓቲንቆ ናኣቶንታ ዉዱሮ ናኣታኣ ቢያ ካኣዦ ዳምቦ ጎይፆና ጌኤሺ ማዔ ቤዛ ሙዑዋቴ። <verse eid="LEV 10:14"/><verse number="15" style="v" sid="LEV 10:15"/>ማላ ናንጊና ናንጋ ጎዳም ሙኡዚ ዒንጊሢ ማዒ ዒንጊንታ ዎዶና ላባዎንታ ዚኢሮንታ ዔያታ ዔኪ ሺኢሾንጎ፤ ዬይ ቢያ ናንጊና ናንጋ ጎዳ ዓይሤ ጎይፆና ኔኤና ኔ ናኣቶናም ናንጊና ዒንሢ ዛላ ማዓንዳኔ» ጌዔኔ።<verse eid="LEV 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 10:16"/>ሙሴ ጎሞ ጌኤሺፆሮ ዒንጊንቴ ዋኣራሢ ዎዎዲንቴቴያ ዖኦጪ ታማኣ ሚቾናያ ማዔሢ ዔራዖ ዓኣሮኔ ናኣቶ፥ ዓላዜሬና ዒታማሬና ዑፃ ዻጋዺ፥ <verse eid="LEV 10:16"/><verse number="17" style="v" sid="LEV 10:17"/>«ጎሞ ጌኤሾሮ ዒንጊንቴ ዒንጊፆ ዓይጎሮ ፆኦሲም ዱማዼ ቤዛ ዒንሢ ሙዑዋዖ ሃሼይ? ዬይ ዑሣ ዓኣዼ ፆኦሲም ዱማዼያኬ፤ ዬይ ዴሮኮ ጎሞ ጌኤሻያ ማዓንዳጉዲ ናንጊና ናንጋ ጎዳ ዒንሢም ዒንጌያኬ፤ <note caller="-" style="x"><char style="xo" closed="false">10፡17 </char><char style="xt" closed="false"><ref loc="LEV 6:24-26">ሌዊ. ዓኬ 6፡24-26</ref>።</char></note> <verse eid="LEV 10:17"/><verse number="18" style="v" sid="LEV 10:18"/>ዬያኮ ሱጉፃ ዓፒሎና ማዢንቴ፥ ፆኦሲም ዱማዼ ማኣሮ ጌሊባኣሢሮ ታ ዒንሢም ዓይሤ ጎይፆና ፆኦሲም ዱማዼ ቤዛ ዒንሢ ዬያ ዓሽኮ ሙሙዓንዳዖ ዓቴኔ!» ጌዔኔ።<verse eid="LEV 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 10:19"/>ዒማና ዓኣሮኔ ሙሴም፦ «ጎሞ ጌኤሻኒ ዒንጊንቴ ዒንጊፆ ሃኖ ታ ሙዔያ ማዔቴ ናንጊና ናንጋ ጎዳ ዎዛሳንዳያ ናንዳ? ዴራ ጎሞ ጌኤሺፆ ዛሎንታ ሚቺ ዒንጎ ዒንጊፆ ዛሎናሮ ዒንጎ ባኮ ሃኖ ዔኪ ዬዔኔ፤ ጋዓንቴ ያኣዼ ያኣዼ ባኣዚ ታና ሄሌኔ» ጌይ ኬኤዜኔ። <verse eid="LEV 10:19"/><verse number="20" style="v" sid="LEV 10:20"/>ሙሴ ዬያ ዋይዛዖ ዒ ጌዔ ባኮ ጎኔኬ ጌይ ዔኬኔ።<verse eid="LEV 10:20"/></para>
  <chapter eid="LEV 10"/>
  <chapter number="11" style="c" sid="LEV 11"/>
  <para style="s1">ዓሽኪ ሙይንታ ባኣዚና ሙይንቱዋ ባኣዚ</para>
  <para style="r">(<ref loc="DEU 14:3-21">ላሚ. ዎማ 14፡3-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 11:1"/>ናንጊና ናንጋ ጎዳ ሙሴና ዓኣሮኔናም፦ <verse eid="LEV 11:1"/><verse number="2" style="v" sid="LEV 11:2"/>«ዒስራዔኤሌ ዴሮም ሂዚ ጎዑዋቴ፤ ሳዖይዳ ናንጋ ባኮይዳፓ ዓሽኪ ዒንሢ ሙዓንዳዞንሢ ሃንሢኬ፦ <verse eid="LEV 11:2"/><verse number="3" style="v" sid="LEV 11:3"/>ሹቁላ ላምዖ ፓቂንቲ ዓኣ፥ ዓሌ ዻዓ ባኮንሢኮ ዓሽኮ ሙዑዋቴ፤ <verse eid="LEV 11:3"/><verse number="4-6" style="v" sid="LEV 11:4-6"/>ጋዓንቴ ጋኣሎንታ ሾኦኖንታ ዋሪሌንታ ዓሌ ዻዓያ ማዔቴያ ዔያቶኮ ቶኮ ሹቁላ ላምዖ ፓቂንቲባኣያ ማዔሢሮ ሙዒፖቴ፤ ዒንሢኮ ቄፄ ማዖንጎ። <verse eid="LEV 11:4-6"/><verse number="7" style="v" sid="LEV 11:7"/>ሃሣ ጉዱንሢያ ሙይፖቴ፤ ዔያቶኮ ሹቁላ ላምዖ ፓቂንቴያ ማዔቴያ ዓሌ ዔያታ ዻዑዋሢሮ ዒንሢኮ ቄፄ ማዖንጎ። <verse eid="LEV 11:7"/><verse number="8" style="v" sid="LEV 11:8"/>ዬይ ባካ ቄፄ ማዔሢሮ ዬያቶ ሙይፖቴ፤ ሃይቄ ሌዞዋ ዔያቶኮ ካኣሚፖቴ።»<verse eid="LEV 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 11:9"/>«ጋኣሲንታ ቁኡሪ ማላ ዒልዒንታ ዓኣ፥ ዼኤፖ ባዞና ዎሮናይዳ ናንጋ ሞላሢ ዜርፆ ዒንሢ ሙዓኒ ዳንዳዓኔ፤ <verse eid="LEV 11:9"/><verse number="10" style="v" sid="LEV 11:10"/>ጋዓንቴ ዋኣፆይዳ ናንጋ፥ ጋኣሲና ዒልዒናባኣ ሜሌ ማዢንታ ቢያ ሙይንታንዳያ ኮይሱዋሴ። <verse eid="LEV 11:10"/><verse number="11" style="v" sid="LEV 11:11"/>ዬያጉዴ ባካ ዒንሢኮ ቄፄ ማዓኒ ኮይሳኔ፤ ዬያቶ ሙይፃ ዓታዛ ሃይቄ ሌዞታዖ ዔያቶኮ ዒንሢ ካኣማንዳያ ኮይሱዋሴ፤ <verse eid="LEV 11:11"/><verse number="12" style="v" sid="LEV 11:12"/>ዬያሮ ዋኣፆይዳ ናንጋ ጋኣሲና ቁኡሪ ማላ ዒልዒናባኣ ማዢንታ ቢያ ዒንሢ ሻሻኣካ ባኣዚ ማዖንጎ።»<verse eid="LEV 11:12"/></para>
  <para style="p">
    <verse number="13-19" style="v" sid="LEV 11:13-19"/>«ካፖ ዜርፆይዳፓ ዒንሢም ቄፄ ማዒ፥ ሙይንታኒ ሻኣካንዳያ ኮይሳ ባኮንሢ ሃንሢኬ፦ ዚኢጊላ፥ ሃምፑራ፥ ኮኦኬ፥ ኪላንቄ፥ ዱማ ዱማ ዜኤጌ፥ ዱማ ዱማ ቁራኬ፥ ቱኡቴ፥ ሃንጋ ሃንጎ፥ ጫሬ ካፒ፥ ዱማ ዱማ ጋርማ ዜርሢ፥ ኩኩቴ፥ ሶኦሦ ሃምፑራ፥ ሙኡታሌ፥ ባዚ ካፒ፥ ቶኮ ኬኤላ ዎላ ካኣሜ ባዞ ካፓ፥ ጫውራ፥ ቦኦካ፥ ቆልሞና ሃንታ ቦኦሬ ካፓ፥ ማኣሎንታ ፓቃቴንታኬ።<verse eid="LEV 11:13-19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 11:20"/>«ጋኣሲ ዓኣያታዖ ዖይዶ ቶኪና ሃንታኒ ዳንዳዓ፥ ዻካ ባኣዚ ቢያ ዒንሢም ቄፄ ማዖንጎ፤ <verse eid="LEV 11:20"/><verse number="21" style="v" sid="LEV 11:21"/>ጋዓንቴ ዔያቶይዳፓ ሳዖይዳ ኮኦማ ጪጊቺ ዓኣ፥ ዻኮ ባካ ሙይንታኒ ዳንዳዓኔ፤ <verse eid="LEV 11:21"/><verse number="22" style="v" sid="LEV 11:22"/>ዬያታ ዓቢሢንታ ጎምቦንታ ማኮንታኬ። <verse eid="LEV 11:22"/><verse number="23" style="v" sid="LEV 11:23"/>ጋዓንቴ ጋኣሲ ዓኣያታዖ ዖይዶ ቶኪና ሃንታ፥ ዻኮ ባካ ጉቤ ዒንሢም ቄፄ ሃሣ ሻኣካያ ማዖንጎ።<verse eid="LEV 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 11:24"/>«ዬንሢ ባኮ ዒንሢ ካኣሜቴ ዒኢታንዳኣኬ፤ ዬንሢ ባኮኮ ሃይቄ ሌዞ ካኣሜ ዓሲ ሳዓ ዓማንዳያ ሄላንዳኣና ዒኢቴያ ማዖንጎ፤ <verse eid="LEV 11:24"/><verse number="25" style="v" sid="LEV 11:25"/>ዬያ ባኮኮ ሌዞ ዔኪ ሺኢሻ ዓሲ ቢያ ፔኤኮ ማኣዓሢ ማስኮንጎ፤ ያዺ ማዔቴያ ዴንዲ ሳዓ ዓማንዳያ ሄላንዳኣና ዒኢቴያ ማዓንዳኔ። <verse eid="LEV 11:25"/><verse number="26" style="v" sid="LEV 11:26"/>ቶኪ ሹቁሊ ዓኣያታዖ ሹቁላ ላምዖ ፓቂንቲ ባኣያ፥ ሃሣ ዓሌ ዻዑዋ ባኣዚ ቢያ ዒንሢኮ ቄፄ ማዖንጎ፤ ዬያ ባኮኮ ሌዞ ካኣሜ ዓሲ ቢያ ዒኢቴያ ማዖንጎ። <verse eid="LEV 11:26"/><verse number="27" style="v" sid="LEV 11:27"/>ዖይዶ ቶኪና ሃንታ ባኮይዳፓ ቢያ ፔ ቃኣቆና ሄርቂ ሃንታ ባካ ቢያ ዒንሢኮ ቄፄ ማዖንጎ፤ ዬያ ባኮኮ ሃይቄ ሌዞ ካኣማ ዓሲ ቢያ ሳዓ ዓማንዳያ ሄላንዳኣና ዒኢቴያ ማዖንጎ፤ <verse eid="LEV 11:27"/><verse number="28" style="v" sid="LEV 11:28"/>ዬያ ባኮኮ ሃይቄ ሌዞ ካኣማ ዓሲ ፔኤኮ ማኣዓሢ ማስኮንጎ፤ ያዺ ማዔቴያ ዴንዲ ሳዓ ዓማንዳያ ሄላንዳኣና ዒኢቴያ ማዓንዳኔ፤ ዬይ ባካ ዒንሢኮ ቄፄ ማዖንጎ።<verse eid="LEV 11:28"/></para>
  <para style="p">
    <verse number="29-30" style="v" sid="LEV 11:29-30"/>«ዖኦቻ፥ ሂኢፂ፥ ሂኢፂ ሶይና፥ ሞዻ፥ ጎርሻ፥ ጌኤጌ፥ ጉርጉራ፥ ጋኣሹንቾ፥ ጎኦሺ ጎጳ፤ ያኣቶንታ ያኣቶጉዴ ማዢንታ ቢያ ዒንሢኮ ቄፄ ማዖንጎ፤ <verse eid="LEV 11:29-30"/><verse number="31" style="v" sid="LEV 11:31"/>ያኣቶ ባኮኮ ዑፆታቴያ ሃይቄ ሌዞ ካኣማ ዓሲ ቢያ ሳዓ ዓማንዳያ ሄላንዳኣና ዒኢቴያ ማዖንጎ። <verse eid="LEV 11:31"/><verse number="32" style="v" sid="LEV 11:32"/>ዬያቶ ባኮኮ ሌዞ ካኣሜ ሜሄያኣ ቢያ ዒኢቴያ ማዖንጎ፤ ዬይ ሜሃ ሚሢፓ ኮሾና ባኣዚ፥ ማኣዓ፥ ዜዺ፥ ሱርባ፤ ያኣቶንታ ዬያጉዴ ባኮ ቢያ ማዓኒ ዳንዳዓኔ፤ ዬይ ሜሃ ዋኣሢዳ ዓጊንቲ ዴዖንጎ፤ ሳዓ ዓማንዳያ ሄላንዳኣና ዒኢቴያ ማዓንዳኔ። <verse eid="LEV 11:32"/><verse number="33" style="v" sid="LEV 11:33"/>ሌዛ ዔያቶኮ ዓጪፓ ማዦና ሜሄ ሄሌቴ ዬያ ባኮኮ ጋራ ዓኣ ባካ ዒኢቴያ ማዓሢሮ ዬያ ባኮ ዎዎዹዋቴ። <verse eid="LEV 11:33"/><verse number="34" style="v" sid="LEV 11:34"/>ዓይጎጉዴ ሙኡዚ ማዖም ዬያጉዴ ሜሃፓ ዋኣሢ ፆዺ ሄሌቴ ዬይ ሙዓ ዒኢቴያ ማዖንጎ፤ ዬያ ሜሆይዳ ዑሽኮ ዑሺ ዓኣቴያ ዒኢቴያኬ፤ <verse eid="LEV 11:34"/><verse number="35" style="v" sid="LEV 11:35"/>ዬያ ሃይቄ ባኮኮ ሌዞ ካኣሜ ባኣዚ ቢያ ዒኢቴያ ማዓሢሮ ቄፄ ማሂ ሻኣኪንቱዋቴ፤ ናኣቦ ማዔቴያ ዖቲታቴያ ዎዺ ኬኤሩዋቴ፤ <verse eid="LEV 11:35"/><verse number="36" style="v" sid="LEV 11:36"/>ዬንሢ ባኮኮ ሌዛ ካኣሜ ባኣዚ ቢያ ዒኢታያ ማዔቴያ ዋኣሢ ዓልቃ ቤሲና ዋኣሢ ዔቴና ዒኢታዓኬ፤ ጋዓንቴ ሌዞ ካኣማ ዓሲ ዒኢቴያ ማዓንዳኔ። <verse eid="LEV 11:36"/><verse number="37" style="v" sid="LEV 11:37"/>ዬንሢ ባኮኮ ሌዛ ዜርቃኒ ጊኢጊሾና ዜርሢ ካኣሜቴ ዜርፃ ዒኢታዓኬ፤ <verse eid="LEV 11:37"/><verse number="38" style="v" sid="LEV 11:38"/>ጋዓንቴ ዜርፆይዳ ዋኣሢ ዋሂንቴስካፓ ዬያ ባኮኮ ሌዛ ካኣሜቴ ዒንሢኮ ዬይ ዜርፃ ዒኢቴያ ማዖንጎ።<verse eid="LEV 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 11:39"/>«ዒንሢ ዓሽኮ ሙዓ ቆልማ ሃይቄም ሌዞ ካኣማ ዓሲ ሳዓ ዓማንዳያ ሄላንዳኣና ዒኢቴያ ማዓንዳኔ። <verse eid="LEV 11:39"/><verse number="40" style="v" sid="LEV 11:40"/>ዓይጎ ዓሲያ ማዖም ዬያ ቆልሞኮ ዓሽኮይዳፓ ሙዔያ ማዔቴ ማኣዓሢ ፔኤኮ ማስኮንጎ፤ ያዺ ማዔቴያ ዴንዲ ሳዓ ዓማንዳያ ሄላንዳኣና ዬይ ዓሢ ዒኢቴያ ማዓንዳኔ፤ ሃሣ ዓይጎ ዓሲያ ማዖም ዬያ ባኮኮ ሌዞ ካኣሚ ኬዴቴ ማኣዓሢ ፔኤኮ ማስኮንጎ፤ ዬይ ዓሢያ ዴንዲ ሳዓ ዓማንዳያ ሄላንዳኣና ዒኢቴያ ማዖንጎ።<verse eid="LEV 11:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LEV 11:41"/>«ሳዖይዳ ዳዶና ጎቺንቲ ሃንታ፥ ዻኮ ማዢንታ ቢያ ዒንሢኮ ቄፄ ማዒ፥ ሻኣካያ ማዖንጎ፤ ሙይፖቴ። <verse eid="LEV 11:41"/><verse number="42" style="v" sid="LEV 11:42"/>ሳዖይዳ ዳዶና ጎቺንቲ ሃንታ ባካ፥ ዖይዶ ቶኪናታዖ ጎቺንቲ ሃንታ ባኮንታ ሚርጌ ቶኪ ዓኣ ባኮንታ ቢያ ቄፄ ማሂ ሻኣኪንቱዋቴ፤ ሙይፖቴ። <verse eid="LEV 11:42"/><verse number="43" style="v" sid="LEV 11:43"/>ዬንሢ ባኮይዳፓ ዓይጎ ባኣዚያ ማዖም ሙዒ ዒንሢ ቶኦኮ ዒኢሲፖቴ፤ <verse eid="LEV 11:43"/><verse number="44" style="v" sid="LEV 11:44"/>ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢኬ፤ ታኣኒ ዱማዼያታሢሮ ዒንሢያ ዒንሢ ታኣም ዱማዼያ ማሁዋቴ፤ ሳዖይዳ ዳዶና ጎቺንቲ ሃንታ ዻኮ ማዢንቶ ሙዒ ዒንሢ ዒኢሲፖቴ። <note caller="-" style="x"><char style="xo" closed="false">11፡44 </char><char style="xt" closed="false"><ref loc="LEV 19:2">ሌዊ. ዓኬ 19፡2</ref>፤ <ref loc="1PE 1:16">1ጴፂ. 1፡16</ref>።</char></note> <verse eid="LEV 11:44"/><verse number="45" style="v" sid="LEV 11:45"/>ዒንሢኮ ፆኦሲ ማዓኒ ጊብፄ ዓጮይዳፓ ዒንሢ ዔኪ ኬሴ ናንጊና ናንጋ ጎዳሢ ታናኬ፤ ዬያሮ ታኣኒ ዱማዼያ ማዔሢሮ ዒንሢያ ታኣም ዱማዼያ ማዑዋቴ።<verse eid="LEV 11:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 11:46"/>«ዓካሪ ሃይ፥ ዋኣሢዳ ናንጋ ባኮንታ ሳዖይዳ ናንጋ ዻኮ ማዢንቶንታ፤ ሃሣ ካፖ ዛሎዋ ዒንሢም ኬሲንቴ ዎጌኬ፤ <verse eid="LEV 11:46"/><verse number="47" style="v" sid="LEV 11:47"/>ዎጎ ጎይፆና ቄፄ ማዔሢና ሻቲ ማዔ ባኮናኮ ባኣኮይዳ ዓኣ ዱሙሞ ዔራኒ ሙዖ ባኮና ሙዑዎ ባኮናኮ ባኣካ ዓኣ ዱሙሞ ኮሺ ዔሩዋቴ» ጌዔኔ።<verse eid="LEV 11:47"/></para>
  <chapter eid="LEV 11"/>
  <chapter number="12" style="c" sid="LEV 12"/>
  <para style="s1">ላኣሊ ሾዔስካፓ ኩንሣ ዳምቤ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 12:1"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 12:1"/><verse number="2" style="v" sid="LEV 12:2"/>« ዒስራዔኤሌ ዓሶም ሂዚ ጌዔ፤ ፔቴ ላኣሊ ጎጳዺ ዓቲንቄ ናይ ሾዔያ ማዔቴ ላኣሊኮ ሻቱሞ ጴዻዛ ማዺንታ ጎይፆ ላንካይ ኬሊ ሄላንዳኣና ዒዛ ዒኢቴያ ማዓንዳኔ። <verse eid="LEV 12:2"/><verse number="3" style="v" sid="LEV 12:3"/>ሳላሳ ኬሎና ናዖኮ ዓቲንቶ ቤርቶ ቲቃንዳያ ኮይሳኔ። <note caller="-" style="x"><char style="xo" closed="false">12፡3 </char><char style="xt" closed="false"><ref loc="GEN 17:12">ማዢ. ማፃ 17፡12</ref>፤ <ref loc="LUK 2:21">ሉቃ. 2፡21</ref>።</char></note> <verse eid="LEV 12:3"/><verse number="4" style="v" sid="LEV 12:4"/>ዬካፓ ዑፃ ዒዞኮ ፃኣዻንዳ፥ ሃይሢታሚ ሃይሦ ኬሊ ሄላንዳኣና ፆኦሲም ዱማዼ ዓይጎ ባኣዚያ ዒዛ ካኣማኒ ኮይሱዋሴ፤ ሃሣ ዒዞኮ ማስቲፆ ኬላ ጋፓንዳያ ሄላንዳኣና ታኣም ዱማዼ ማኣሮ ጌሎፓ።»<verse eid="LEV 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 12:5"/>«ዬያጉዲ ሃሣ ፔቴ ላኣሊ ዉዱሮ ናይ ሾዔቴ ላኣሊኮ ሻቱማ ጴዻኣና ማዺንታ ጎይፆ ታጶ ዖይዶ ኬሊ ሄላንዳኣና ዒዛ ዒኢቴያ ማዖንጎ፤ ዬካፓ ዑፃ ዒዞኮ ፃኣዺ፥ ማስቲፃ ጋፓንዳኣና ላሂታሚ ላሆ ኬሊ ዴዖንጎ።»<verse eid="LEV 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 12:6"/>«ዒዞኮ ማስቲፆ ኬላ ጋፔስካፓ ዓቲንቄ ናይ ማዔቴያ ዉዱሮ ናይ ዛላ ሚቺ ዒንጎ ዒንጊሢ ማዓንዳ፥ ፔቴ ሌዔ ማዔ ማራናይና ጎሞ ጌኤሺፆ ዛሎ ማዓ ፔቴ ዶኦሌ ማዔቴያ ፔቴ ኪሬ ናይ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ካሮ ዔኪ ሙኪ ዒኢካ ማዻ ቄኤሳሢም ዒዛ ዒንጎንጎ። <verse eid="LEV 12:6"/><verse number="7" style="v" sid="LEV 12:7"/>ቄኤሳሢያ ዒዛ ዒንጌ ባኮ ዔኪ ናንጊና ናንጋ ጎዳ ቤርቶ ሺኢሾንጎ፤ ዬካፓ ዒዞኮ ሱጉፃ ሾኦቴሢሮ ዒዛ ዒኢቴ ዒኢቲፃ ጋፔም ዒዞ ሻቲንቂሲፆ ዳምባ ያዺዲ ኩማንዳኔ፤ ዒዛ ጌኤሽኬያ ማዓንዳኔ፤ ዬይ፦ ላኣሊ ሾዔስካፓ ማዺ ኩንሣ ዳምቤ ማዓንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">12፡7 </char><char style="xt" closed="false"><ref loc="LUK 2:24">ሉቃ. 2፡24</ref>።</char></note><verse eid="LEV 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 12:8"/>«ላኣሌላ ማራናይ ዔኪ ሙካኒ ዳንዳዒባኣያ ማዔቴ ላምዖ ዶኦሌታቴያ ኪሬ ዔኪ ሙኮንጎ፤ ዔያቶይዳፓ ፔቴማ ሚቺ ዒንጎ ዒንጊሢ ማሂ ጊንሣ ዓቴማ ጎሜ ጌኤሻኒ ዒንጎ ዒንጊሢ ማሂ ዒንጎንጎ፤ ዬያይዲ ቄኤሳሢ ዒዞኮ ዒኢቲፆ ጋፒሲ፥ ዒዛ ሻቲንቃንዳ ዳምቦ ኩንሦንጎ፤ ዬካፓ ዒዛ ዎጎ ጎይፆና ዳምቦ ካፒ ኩንሢ ጌኤሽኬያ ማዓንዳኔ» ጌዔኔ።<verse eid="LEV 12:8"/></para>
  <chapter eid="LEV 12"/>
  <chapter number="13" style="c" sid="LEV 13"/>
  <para style="s1">ዓሲኮ ዑስካ ኬስካ ዶርዖ ዛላ ኬኤዚንቴ ዳምቤ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 13:1"/>ናንጊና ናንጋ ጎዳ ሙሴና ዓኣሮኔናም፦ <verse eid="LEV 13:1"/><verse number="2" style="v" sid="LEV 13:2"/>«ዓይጎ ዓሲያ ማዖም ፔኤኮ ዑፃ ዱንጫ ኬስኬቴ፥ ቃፃ ዓርቄቴ፤ ሃሣ ዑስካ ኬስካ ዶርዖ ማዒ ማዒ ዴንዳ ዒላንታ ጴዼቴ ዓኣሮኔ ፃጲ ማዔ፥ ቄኤሶ ኮራ ዓሳ ዒዛ ዔኪ ሙኮንጎ። <verse eid="LEV 13:2"/><verse number="3" style="v" sid="LEV 13:3"/>ዬካፓ ቄኤሳሢ ዬያ ዓሢኮ ዑፃ ዓኣ ኪፆ ዛጊ፥ ዬያ ኪፆይዳ ዓኣ ጋፓና ቦኦራያ ማዔቴ፤ ሃሣ ኪፆኮ ኮይሎይዳ ዓኣ ዑፃ ሃንጎ ዑፃፓ ቁልፒ ዔታዻያ ማዔቴ፥ ዬይ ዓሲዳፓ ዓሲ ዓርቃኒ ዳንዳዓ ዑስካ ኬስካ ዶርዖ ማዔሢሮ ዓሢ ካኣዦ ዳምቦና ዒኢቴያ ማዔሢ ዔርዞንጎ። <verse eid="LEV 13:3"/><verse number="4" style="v" sid="LEV 13:4"/>ጋዓንቴ ኪፃ ኮይላ ዓኣ ዑፆይዳፓ ቁልፒ ዔታዺ ጴዹዋያ ማዔቴ፤ ሃሣ ጋፓናኣ ቦኦሩዋያ ማዔቴ ቄኤሳሢ ዬያ ዓሢ ላንካይ ኬሊ ሄላንዳኣና ፔቴ ጋርሲዳ ዱማሲ ጌሢ ዛጎንጎ። <verse eid="LEV 13:4"/><verse number="5" style="v" sid="LEV 13:5"/>ዬካፓ ቄኤሳሢ ላንካሳ ኬሎና ዓሢ ላሚ ዛጎንጎ፤ ዒ ዛጋ ዎዶና ኪፃ ዱማዼ ባኣዚ ባኣያ ማዔቴ፥ ሃሣ ላንካይ ኬሊ ዱማሲ ዴይሦንጎ። <verse eid="LEV 13:5"/><verse number="6" style="v" sid="LEV 13:6"/>ሃሣ ቄኤሳሢ ላንካሳ ኬሎና ዓሢ ዛጎንጎ፤ ዒዚ ዛጋ ዎዶና ኪፃ ዳልጊፆይዳፓ ሹሊ ጴዼቴ ኪፃ ቃፃ ማዔሢ ኬኤዚ ዬይ ዓሢ ዳምቦ ጎይፆና ጌኤሺ ማዔሢ ዔርዞንጎ፤ ዬይ ዓሢ ዎጎ ጎይፆና ጌኤሽኪፆ ዔርዛኒ ማኣዓሢ ፔኤኮ ማስኮንጎ። <verse eid="LEV 13:6"/><verse number="7" style="v" sid="LEV 13:7"/>ጋዓንቴ ቄኤሳሢ ዬያ ዓሢ ዛጊ ጌኤሺኬ ጌዔስካፓ ኪፃ ዳልጊ ዳልጊ ዴንዳያ ማዔቴ ዓሢ ላሚ ቄኤሳሢ ቤርቶ ሺኢኮንጎ፤ <verse eid="LEV 13:7"/><verse number="8" style="v" sid="LEV 13:8"/>ዬካፓ ቄኤሳሢ ዒዛ ላሚ ዛጎንጎ፤ ዒ ዛጋንቴ ኪፃ ዳልጊ ዴንዳያ ማዔቴ ዬይ ዑፃኣ ኬስካ ዶርዓሢ ማዔሢሮ ዳምቦና ዒኢቴያ ማዔሢ ዔርዞንጎ።<verse eid="LEV 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 13:9"/>«ዓይጎ ዓሲያ ማዖም ዓሲፓ ዓሲ ዓርቃኒ ዳንዳዓ፥ ዑስካ ኬስካ ዶርዓ ዓርቄቴ ዬያ ዓዺንቴ ዓሢ ዓሳ ቄኤሳሢ ኮራ ዔኪ ዬዖንጎ፤ <verse eid="LEV 13:9"/><verse number="10" style="v" sid="LEV 13:10"/>ዬካፓ ቄኤሳሢ ዬያ ዓሢ ዛጎንጎ፤ ዑፃ ኬስኬ ባካ ዑርታንዳ ባኣዚጉዲ ዴዒ፥ ጊዳ ዓኣ ጋፓኖ ቦኦሪሻ ኪሢ ማዒ ጴዼቴ፥ <verse eid="LEV 13:10"/><verse number="11" style="v" sid="LEV 13:11"/>ዬይ ዑስካ ኬስካ ዶዲ ዶርዖ ማዔሢሮ ቄኤሳሢ ዬይ ሃርጌ ዓሢ ዒኢቴያ ማዔሢ ዔርዞንጎ፤ ዬያኮ ዒኢቲፃ ፔጌና ዔርቴሢሮ ዬያጉዴ ዓሲ ጋርሲዳ ዱማሲ ዛጎንዶያ ኮይሱዋሴ። <verse eid="LEV 13:11"/><verse number="12" style="v" sid="LEV 13:12"/>ዑፃ ኬስካ ዶርዓሢ ዓሢኮ ቶኮ ፁንጋፓ ዴንዲ ቶኦኮ ሄላንዳኣና ባይዚ ኬስኬያ ማዔሢ ዔሬቴ፥ <verse eid="LEV 13:12"/><verse number="13" style="v" sid="LEV 13:13"/>ቄኤሳሢ ላሚ ዒዛ ዛጎንጎ፤ ዓሢኮ ዑፆ ቢያይዳ ኬስኪ ዓኣያ ማዒ ጴዼቴ ዬይ ዓሢ ዎጎ ጎይፆና ጌኤሽኬያ ማዔሢ ዔርዞንጎ፤ ዑፃ ዒዛኮ ጉቤና ቦኦሬሢሮ ዳምቦ ጎይፆና ጌኤሽኬያ ማዓኔ። <verse eid="LEV 13:13"/><verse number="14" style="v" sid="LEV 13:14"/>ጋዓንቴ ላሚ ሃሣ ኔጉዋዖ ኪፃ ጊኢሺጉዲ ዴይ ጴዼያ ማዔቴ ዳምቦ ጎይፆና ዒ ዒኢቴያ ማዓኔ። <verse eid="LEV 13:14"/><verse number="15" style="v" sid="LEV 13:15"/>ዬያሮ ቄኤሳሢ ጊንሣ ዛጊ፥ ጊኢሺጉዲ ዴዒ ዓኣ ኪሢ ዴንቄቴ ዬይ ዓሢ ዳምቦ ጎይፆና ዒኢቴያ ማዔሢ ዔርዞንጎ፤ ዓይጎሮ ጌዔቴ ዬይ ኪፃ ዑፃ ኬስካ ዶርዓሢ ማዔሢሮ ዬይ ዓሢ ዒኢቴያኬ። <verse eid="LEV 13:15"/><verse number="16" style="v" sid="LEV 13:16"/>ኪፃ ፖዓዖ ላሚ ጊንሣ ቦኦሪ ናኬቴ ቄኤሳሢ ኮይላ ዓኣዾንጎ፤ <verse eid="LEV 13:16"/><verse number="17" style="v" sid="LEV 13:17"/>ቄኤሳሢ ላሚ ዒዛ ዛጊ ኪፃ ሹሊ ቦኦራያ ማዒ ጴዼቴ ዬይ ዓሢ ዳምቦ ጎይፆና ጌኤሽኬያ ማዓሢሮ ዓሢ ጌኤሺ ማዔሢ ዔርዞንጎ።<verse eid="LEV 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 13:18"/>«ፔቴ ዓሲኮ ዱንጫ ኪሢ ዓኣዖ ፓፂ ዲኢዳዼ ቤሲ ዓኣቶ፥ <verse eid="LEV 13:18"/><verse number="19" style="v" sid="LEV 13:19"/>ዻካ ጌዔስካፓ ዲኢዶ ቤዞይዳ ጊኢሺጉዴ ባኣዚ ዴዒ፤ ሃሣ ዑርታኒ ጋዓ ኪሢ ኬስኪ ጴዼቴ ዬይ ዓሢ ቄኤሳሢ ኮራ ዓኣዾንጎ፤ <verse eid="LEV 13:19"/><verse number="20" style="v" sid="LEV 13:20"/>ቄኤሳሢ ዒዛ ዛጊ ኪፃ ዓኣ ቤዛ ሜሌ ዑፆይዳፓ ቁልፒ ዔታዺ ጴዼቴ፤ ሃሣ ጊዳ ዓኣ ጋፓናኣ ቦኦራያ ማዔቴ፥ ዓሢ ዒኢቴያ ማዔሢ ዔርዞንጎ፤ ዓይጎሮ ጌዔቴ ዬይ ዱንጮ ኪፆና ማዒ ዓርቄ ዑስካ ኬስካ ዶርዖ ማዔሢሮኬ። <verse eid="LEV 13:20"/><verse number="21" style="v" sid="LEV 13:21"/>ቄኤሳሢ ዛጋንቴ ዒኢካ ዓኣ ጋፓና ቦኦሩዋያ፤ ሃሣ ሜሌ ዑፆይዳፓ ዱማዺ ቁልፒ ዔታዹዋያ፥ ሹላኒ ጋዓያ ማዔቴ ዓሢ ላንካይ ኬሊ ዱማሲ ጌሢ ዛጎንጎ። <verse eid="LEV 13:21"/><verse number="22" style="v" sid="LEV 13:22"/>ኪፃ ዓኣ ቤዛፓ ዳልጊ ዳልጊ ዓኣዻያ ማዔቴ ዬይ ዓሢ ዑፃ ኬስካ ዶርዓሢና ዓዺንቴያ ማዔሢሮ ዒኢቴያታሢ ዔርዞንጎ። <verse eid="LEV 13:22"/><verse number="23" style="v" sid="LEV 13:23"/>ጋዓንቴ ዱማዺ ዔርቱዋያ፤ ሃሣ ዑፆይዳ ዳልጊ ዳልጊ ዴንዱዋያ ማዔቴ ዱንጮ ኪፆኮ ዲኢዲ ማዔሢሮ ዎጎ ጎይፆና ጌኤሺ ማዒፆ ዓሢኮ ዔርዞንጎ።<verse eid="LEV 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 13:24"/>«ፔቴ ዓሲኮ ዑሢ ታሚ ሙዔም ታማ ሙዔ ቤዛ ቦኦሪ፤ ሃሣ ጊንሣ ዖዳልቃያ ማዒ ጴዼቴ፥ <verse eid="LEV 13:24"/><verse number="25" style="v" sid="LEV 13:25"/>ቄኤሳሢ ዬያ ዛጎንጎ፤ ኪፃ ዓኣ ቤዞይዳ ዓኣ ጋፓና ቦኦራያ ማዔቴ፥ ሃሣ ሃንጎ ዑፆይዳፓ ቁልፒ ዔታዻያ ማዔቴ ታማ ሙዔሢና ማዒ ዓርቄ፥ ዑፃ ኬስካ ዶርዓሢ ማዔሢሮ ዬይ ዓሢ ዒኢቴያ ማዔሢ ዔርዞንጎ። <verse eid="LEV 13:25"/><verse number="26" style="v" sid="LEV 13:26"/>ጋዓንቴ ዬያ ቤዞይዳ ኬስካ ጋፓና ቦኦሩዋያ ማዔቴ ሃሣ ዑፃ ሜሌ ዑፆይዳፓ ቁልፒ ዔታዹዋያ ጉሪ ዑፃ ላኣሚንቴያታቴ ቄኤሳሢ ዬያ ዓሢ ላንካይ ኬሊ ጋሮይዳ ዱማሲ ጌሢ ዛጎንጎ። <verse eid="LEV 13:26"/><verse number="27" style="v" sid="LEV 13:27"/>ዬካፓ ላንካሳ ኬሎና ቄኤሳሢ ላሚ ዓሢ ዛጎንጎ፤ ዒዛ ዛጋንቴ ኪፃ ዳልጊ ዴንዳያ ማዒ ጴዼቴ ዑፃ ኬስካ ዶርዓሢ ማዔሢሮ ዬይ ዓሢ ዒኢቴያ ማዔሢ ዔርዞንጎ። <verse eid="LEV 13:27"/><verse number="28" style="v" sid="LEV 13:28"/>ጋዓንቴ ኪፃ ዓኣ ቤዛፓ ዱማዹዋያ ማዒ፥ ጉሪ ዑፃ ላኣሚንቴያታቴ ዑፃ ኬስካ ዶርዓሢቱዋንቴ ታማ ሚቼ ዲኢዶ ማዔሢሮ ዬይ ዓሢ ዳምቦ ጎይፆና ጌኤሺ ማዔሢ ዔርዞንጎ።<verse eid="LEV 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 13:29"/>«ፔቴ ዓቲንቄኮ ማዔቴያ ላኣሊኮ ቶኦካ ማዖም ጋጋጫ ኪሢ ኬስኬቴ፥ <verse eid="LEV 13:29"/><verse number="30" style="v" sid="LEV 13:30"/>ቄኤሳሢ ዬያ ኪፆ ዛጎንጎ፤ ዬይ ቤዛ ኮይላ ዓኣ ዑፆይዳፓ ቁልፒ ዔታዻያ ማዔቴ፥ ሃሣ ዒኢካ ዓኣ ጋፓና ጉኡፃያ ማዒ ጋላፔቴ ዑፃ ኬስካ ዶርዓሢ ማዔሢሮ ዬይ ዓሢ ዒኢቴያ ማዔሢ ዔርዞንጎ። <verse eid="LEV 13:30"/><verse number="31" style="v" sid="LEV 13:31"/>ጋዓንቴ ቄኤሳሢ ዛጋ ዎዶና ኪፃ ኮይላ ዓኣ ዑፆይዳፓ ቁልፒ ዔታዹዋያ ማዔቴ፤ ሃሣ ዒኢካ ዓኣ ጋፓና ፒዜ ጋፓኔ ማዒባኣቴ ዬያ ዓሢ ላንካይ ኬሊ ዱማሲ ጌሢ ዛጎንጎ። <verse eid="LEV 13:31"/><verse number="32" style="v" sid="LEV 13:32"/>ዬካፓ ላንካሳ ኬሎና ላሚ ቄኤሳሢ ዛጋንቴ ኪፃ ዳልጉዋያ ማዒ፥ ጋፓናኣ ጋላፑዋያ ማዔቴ፤ ሃሣ ሜሌ ዑፆይዳፓ ቁልፒ ዔታዹዋያ ማዔቴ፥ <verse eid="LEV 13:32"/><verse number="33" style="v" sid="LEV 13:33"/>ኪፃ ዓኣ ቤዞ ሃሻዖ ሃንጎ ጋፓኖ ቢያ ሜኤዳዛ፥ ቄኤሳሢ ሃሣ ላንካይ ኬሊ ሄላንዳኣና ዒዛ ዱማሲ ጌሢ ዛጎንጎ። <verse eid="LEV 13:33"/><verse number="34" style="v" sid="LEV 13:34"/>ላንካሳ ኬሎና ላሚ ሃሣ ቄኤሳሢ ዬያ ኪፆ ዛጎንጎ፤ ዒ ዛጋንቴ ኪፃ ዳልጉዋያ ማዔቴ፥ ሃሣ ኪፃ ዓኣ ቤዛ ሜሌ ቤዛፓ ቁልፒ ዔታዺባኣያ ማዔቴ ዬይ ዓሢ ዳምቦ ጎይፆና ጌኤሺ ማዔሢ ዔርዞንጎ፤ ዬካፓ ዓሢ ፔኤኮ ዓፒሎ ማስኪ ጌኤሺ ማዖንጎ። <verse eid="LEV 13:34"/><verse number="35" style="v" sid="LEV 13:35"/>ጋዓንቴ ጌኤሺ ማዒፃ ኬኤዚንቴስካፓ ኪፃ ዳልጊ ዳልጊ ዓኣዻያ ማዔቴ፥ <verse eid="LEV 13:35"/><verse number="36" style="v" sid="LEV 13:36"/>ቄኤሳሢ ላሚ ዒዛ ዛጎንጎ፤ ዒዛ ዛጋንቴ ኪፃ ጎኔ ዳልጋያ ማዔቴ ጋላፒ ጋፓኔ ዓኣቴያ ባኣቴያ ዓሢ ዒኢቴያ ማዔሢ ዔርቴያኬ። <verse eid="LEV 13:36"/><verse number="37" style="v" sid="LEV 13:37"/>ጋዓንቴ ቄኤሳሢ ዛጌ ጎይፆና ኪፃ ሙይ ዳልጉዋያ፤ ሃሣ ቃራ ጋፓኔያ ኬስኪ ጴዼያ ማዔቴ ኪፃ ፓፄያ ማዔሢሮ ዳምቦ ጎይፆና ዓሢ ጌኤሺ ማዔሢ ዔርዞንጎ።<verse eid="LEV 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LEV 13:38"/>«ፔቴ ዓቲንቄ ማዔቴያ ላኣሊኮ ዑፆይዳ ዒላንታ ኬስኬቴ፥ <verse eid="LEV 13:38"/><verse number="39" style="v" sid="LEV 13:39"/>ቄኤሳሢ ዬያ ዛጎንጎ፤ ዬይ ኬስካ ባካ ሼኤማዼያ ማዒ ጴዼቴ ሚርጌ ሜታሱዋ ዑሢዳ ኬስካ ዒላንቶታሢሮ ዬይ ዓሢ ዳምቦ ጎይፆና ጌኤሺኬ። <verse eid="LEV 13:39"/><verse number="40-41" style="v" sid="LEV 13:40-41"/>ፔቴ ዓሲኮ ቶኦኪ ዼንካፓታቴያ ባሊታፓ ባሌያ ማዔቴ ዬይ ባሊፃ ዓሢ ዒኢቴያ ማሃኒ ዳንዳዑዋሴ። <verse eid="LEV 13:40-41"/><verse number="42" style="v" sid="LEV 13:42"/>ጋዓንቴ ባሎይዳ ዑርታንዳጉዴ ጊኢሺ ዓኣ ኪሢ ጴዼቶ ዬይ ዑፃ ኬስካ ዶርዓሢኬ። <verse eid="LEV 13:42"/><verse number="43" style="v" sid="LEV 13:43"/>ቄኤሳሢ ዬያ ዛጌም ዑፃ ኬስካ ዶርዓሢ ማላ፥ ዑርታንዳጉዴ ጊኢሺ ዓኣ ኪሢ ማዒ ጴዼቴ፥ <verse eid="LEV 13:43"/><verse number="44" style="v" sid="LEV 13:44"/>ዬይ ዓሢ ዒኢቴያ ማዔሢ ዔርዞንጎ፤ ዬያ ባሎና ማዒ ዓርቄ ዓሲፓ ዓሲ ዓርቃኒ ዳንዳዓ ዑፃ ኬስካ ዶርዓሢኬ።<verse eid="LEV 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LEV 13:45"/>«ዬያጉዴ ዑፃ ኬስካ ዶርዓሢ ዓርቄ ዓሲ ቱርጫዼ ማኣዖ ማይንቶንጎ፤ ቶኦኮዋ ፒፆፓ፤ ሃሣ ሙሱሮ ካንቂ ዓኣቺ ‹ታኣኒ ዒኢቴያኬ! ዒኢቴያኬ!› ጌይ ጌይ ዒላቶንጎ። <verse eid="LEV 13:45"/><verse number="46" style="v" sid="LEV 13:46"/>ዬይ ዓሢ ዶርዓሢ ፖዓንዳያ ሄላንዳኣና ዒኢቴያ ማዓሢሮ ዓሲዳፓ ዱማዺ፥ ዓሲ ናንጉዋ ቤስካ ፔኤኮ ዴዖንጎ።»<verse eid="LEV 13:46"/></para>
  <para style="s1">ማኣዖይዳ ኬስኪ ጴዻ ቡኡዒሢ ዛላ</para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 13:47"/>«ቡኡዔ ባኣዚ ማራይ ጋፓኔና ማዔቴያ ሱኡፔና ኮሺንቴ ዓፒላይዳ ጴዼቴ፥ <verse eid="LEV 13:47"/><verse number="48" style="v" sid="LEV 13:48"/>ዶርዜ ዹዔ ማኣዖይዳታቴያ ኩቻ ማዦና ማኣዖኮ ሻላሢዳ ማዔቴያ ቃጪኖይዳ፤ ዬያጉዲ ሃሣ ሱኡፔናኣ ማዖም ዒልዒና ኮሺንቴ ማኣዖይዳ ቡኡዒፃ ጴዼቴ፥ <verse eid="LEV 13:48"/><verse number="49" style="v" sid="LEV 13:49"/>ማኣዓሢኮ ዑፃ ጴዼ ቡኡዒፃ ጮልዔ፤ ሃንጎ ዞቃያ ማዔቴ ሜሌ ዓፒላ ዓርቃኒ ዳንዳዓያታሢሮ ቄኤሳሢ ዛጌቴ ቃራኬ። <verse eid="LEV 13:49"/><verse number="50" style="v" sid="LEV 13:50"/>ቄኤሳሢ ዛጊ፥ ዬንሢ ዓፒሎንሢ ላንካይ ኬሊ ሄላንዳኣና ፔቴ ቤስካ ዱማሲ ጌሢ ዛጎንጎ። <verse eid="LEV 13:50"/><verse number="51" style="v" sid="LEV 13:51"/>ላንካሳ ኬሎና ጊንሣ ዒ ዛጋ ዎዶና ቡኡዒፃ ዳልጊ ዳልጊ ዴንዳያ ማዔቴ ዬያጉዴ ማኣዓሢ ቢያ ዒኢቴያኬ። <verse eid="LEV 13:51"/><verse number="52" style="v" sid="LEV 13:52"/>ዬያጉዴ ማኣዓሢ ታሚና ሚቺንቶንጎ፤ ዬይ ቡኡዒፃ ዳልጊ ዳልጊ ዴንዳ ቡኡዒሢ ማዔሢሮ ቄኤሳሢ ሚቾንጎ።<verse eid="LEV 13:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LEV 13:53"/>«ጋዓንቴ ቄኤሳሢ ዛጋ ዎዶና ቡኡዒፃ ዳልጊ ዳልጊ ዓኣዻያ ማዒ ጴዺባኣቴ፥ <verse eid="LEV 13:53"/><verse number="54" style="v" sid="LEV 13:54"/>ዬይ ዓፒላ ማስኪንቲ ላንካይ ኬሊ ሄላንዳኣና ዱማዺ ጌሢንቴም ዛጎንጎ። <verse eid="LEV 13:54"/><verse number="55" style="v" sid="LEV 13:55"/>ዬካፓ ሃሣ ላሚ ዛጎንጎ፤ ዒ ላሚ ዛጋንቴ ቡኡዒፃ ዳልጊ ዴንዲባኣያ ማዔቴያ ማላሢ ቤዞማካ ዓኣቴ ዬይ ዒኢቴያ ማዔሢሮ ጋሮይዳ ማዖም ዙሎይዳ ቡኡዒሢ ጴዻ ማኣዓ ሚቺንቶንጎ። <verse eid="LEV 13:55"/><verse number="56" style="v" sid="LEV 13:56"/>ጋዓንቴ ቄኤሳሢ ላሚ ዛጋ ዎዶና ቡኡዒፃ ባይቃንዳ ጎይሢ ዻኪ ጴዼቴ ቡኡዒፃ ዓኣ ቤዞማ ሌሊ ዓፒሎይዳፓታቴያ ዒልዒ ማኣዖፓ ዳርዚ ኬሶንጎ። <verse eid="LEV 13:56"/><verse number="57" style="v" sid="LEV 13:57"/>ቡኡዒፃ ላሚ ጴዼቶ ጋዓንቴ ዬይ ዳልጊ ዳልጊ ዓኣዻንዳሢሮ ዔቦኮ ዓዴ ዬኖ ታሚዳ ሚቾንጎ። <verse eid="LEV 13:57"/><verse number="58" style="v" sid="LEV 13:58"/>ማኣዓሢ ማስኪንታ ዎዶና ቡኡዒፃ ባይቄቴ ላሚ ሃሣ ማስኮንጎ፤ ዬካፓ ዳምቦ ጎይፆና ጌኤሽኬያ ማዓንዳኔ» ጌዔኔ።<verse eid="LEV 13:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LEV 13:59"/>ዬይ ዓካሪ ኮሺ ሱኡፖና ማዔቴያ ማራይ ጋፓኔና፤ ሃሣ ዒልዒና ኮሾና ዓፒላኮ ቃጪኖይዳ ማዔቴ፥ ሻላሢዳ ጴዻ ቡኡዒሢ ዛላ ዒኢቴያ ሃሣ ሻቲ ማዒፆ ዔሮ ዎጌኬ።<verse eid="LEV 13:59"/></para>
  <chapter eid="LEV 13"/>
  <chapter number="14" style="c" sid="LEV 14"/>
  <para style="s1">ዑፃ ኬስካ ዶርዓሢ ጌኤሾ ጎይሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 14:1"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 14:1"/><verse number="2" style="v" sid="LEV 14:2"/>«ፔቴ ዓሲ ዑፃ ኬስካ ዶርዓሢዳፓ ፖዔያ ማዔቴ ጌኤሽኪፆ ዛሎ ዒንጊንቴ ዳምባ ያዺኬ፤ <note caller="-" style="x"><char style="xo" closed="false">14፡2 </char><char style="xt" closed="false"><ref loc="MAT 8:4">ማቲ. 8፡4</ref>፤ <ref loc="MRK 1:44">ማር. 1፡44</ref>፤ <ref loc="LUK 5:14">ሉቃ. 5፡14</ref>፤ <ref loc="LUK 17:14">17፡14</ref>።</char></note> <verse eid="LEV 14:2"/><verse number="3" style="v" sid="LEV 14:3"/>ቄኤሳሢ ዬያ ዓሢ ጉርዶኮ ዙላ ኬሲ ዛጎንጎ፤ ዓሢ ዶርዓስካፓ ፖዔያ ማዔቴ፥ <verse eid="LEV 14:3"/><verse number="4" style="v" sid="LEV 14:4"/>ዳምቦ ጎይፆና ሙይንታኒ ዳንዳዓ ላምዖ ካፒና ዴኤሊ ዚቢቂ ዻካ ሜንሢ ዔኪ፤ ሃሣ ዞቄ ሚዛጲ ፓቲሌና ሂሶጴ ጌይንታ ባኬሎኮ ዒላሺና ዎላ ዔኪ ዬዓንዳጉዲ ዓይሦንጎ። <verse eid="LEV 14:4"/><verse number="5" style="v" sid="LEV 14:5"/>ዬካፓ ዓሢ ካፖንሢዳፓ ፔቴማ ጊኢሲ ዓልቃ ዋኣሢ ዱይ ጌሢንቲ ዓኣ ታሚ ቦኦቆይዳ ሹካንዳጉዲ ቄኤሳሢ ዓይሦንጎ፤ <verse eid="LEV 14:5"/><verse number="6" style="v" sid="LEV 14:6"/>ዓቴ ካፖማ ዴኤሎ ዚቢቆ ሚፆ ሜቂፆማና ዞቄ ሚዛጶ ፓቲሌሎና ሂሶጴ ዒላዦና ዎላ ዔኪ ቤርታ ሹኪንቴ ሱጉፆይዳ ዓጎንጎ፤ <verse eid="LEV 14:6"/><verse number="7" style="v" sid="LEV 14:7"/>ዬያ ሱጉፆ፥ ዑፃ ኬስካ ዶርዓሢዳፓ ጌኤሽካ ዓሢ ዑፃ ላንካይ ማይንቲ ፑጮንጎ፤ ዬካፓ ዒ ጌኤሽኬያ ማዒፆ ዔርዞንጎ፤ ሃሣ ሼምፖና ዓኣ ካፖማ ባራኒ ዴንዳንዳጉዲ ዙላ ኬሲ ሃሾንጎ። <verse eid="LEV 14:7"/><verse number="8" style="v" sid="LEV 14:8"/>ዑፃ ኬስካ ዶርዓስካፓ ጌኤሽካ ዓሢ ማኣዓሢ ፔኤኮ ማስኮንጎ፤ ቶኦኮዋ ጉኡሎንጎ፥ ዑፆዋ ዋኣሢና ማስቶንጎ፤ ዬካፓ ዳምቦ ጎይፆና ዒ ጌኤሽኬያ ማዔሢሮ ጉርዶ ጌላኒ ዳንዳዓኔ፤ ጋዓንቴ ዴንዲ ላንካይ ኬሊ ሄላንዳኣና ፔ ኬኤፆ ጌሉዋዖ ዙላ ዴዖንጎ። <verse eid="LEV 14:8"/><verse number="9" style="v" sid="LEV 14:9"/>ላንካሳ ኬሎና ቶኦካኣ፥ ቡኡጫ፥ ሂኢፖ ጋፓና፤ ዬያጉዲ ዑፃ ዓኣ ጋፓኖ ቢያ ሜኤዲ ማኣዓሢያ ፔኤኮ ዋኣሢና ማስኪ ዑፆዋ ፔኤኮ ማስቶንጎ፤ ዬካፓ ዒ ዳምቦ ጎይፆና ጌኤሽኬያ ማዓንዳኔ።<verse eid="LEV 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 14:10"/>«ሳላሳ ኬሎና ዔኤቢ ቦሂሳ ባኣዚባኣ፥ ላምዖ ዓዴ ማራናይና ፔቴ ሌዔ ማዔ ዑዞ ማራናይ ዔኪ ሙኮንጎ፤ ዬያና ዎላ ሪሚቶ ዛይቶና ዲርኪንቴ ሃይሦ ኪሎ ማዓንዳ ሺኢቺ ዺኢሊና ዶሎዜኮ ጊዲሚሺ ማዒባኣ ዛይቴና ዔኪ ሙኮንጎ። <verse eid="LEV 14:10"/><verse number="11" style="v" sid="LEV 14:11"/>ቄኤሳሢ፥ ዬይ ዓሢ ዔኪ ሙኬ ባኮንታ ዓሢንታ ዎላ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ካሮ ናንጊና ናንጋ ጎዳ ቤርቶ ዔኪ ሺኢሾንጎ፤ <verse eid="LEV 14:11"/><verse number="12" style="v" sid="LEV 14:12"/>ዬካፓ ቄኤሳሢ፥ ላምዖ ዓዶ ማራቶ ናኣቶንሢፓ ፔቴማና ዶሎዞኮ ጊዲሚዦ ማዒባኣ ዛይቶና ዔኪ ዻቢንቶኮ ጪጋ ማሂ ዒንጎ ዒንጊፆ ማዓንዳጉዲ ሺኢሾንጎ፤ ሃሣ ዬይ ቄኤሳሢ ዛላ ማዓንዳጉዲ ዡጊ ናንጊና ናንጋ ጎዳም ዒንጎንጎ። <verse eid="LEV 14:12"/><verse number="13" style="v" sid="LEV 14:13"/>ጎሞ ጌኤሻኒ ሹኪ ዒንጊንታ ቆልማ ሹኪንታ፥ ፆኦሲም ዱማዼ ቤዛ ማራዓሢ ሹኮንጎ፤ ዬያ ዒ ማዻሢ ዻቢንቶ ዛሎ ጪጋ ማሂ ዒንጎ ባካ ጎሞ ጌኤሻ ዒንጊፆጉዲ ቄኤሳሢሮ ማዒ ዒንጊንታሢሮኬ፤ ዬይ ሚርጌና ፆኦሲም ዱማዼያኬ። <verse eid="LEV 14:13"/><verse number="14" style="v" sid="LEV 14:14"/>ቄኤሳሢ ማራናዓሢኮ ሱጉፃፓ ዻካ ዔኪ ጌኤሽኪፆይዳ ዓኣ ዓሢኮ ሚዛቆ ዋዮ ቤርቶ፥ ሚዛቆ ኩጮና ቶኮናኮ ዶኦሞ ኬኤሎ ቲሽኮንጎ። <verse eid="LEV 14:14"/><verse number="15" style="v" sid="LEV 14:15"/>ሃሣ ቄኤሳሢ ዛይቶይዳፓ ዻካ ዔኪ ፔኤኮ ሻውሎ ኩጮ ቃኣቆይዳ ዋሆንጎ፤ <verse eid="LEV 14:15"/><verse number="16" style="v" sid="LEV 14:16"/>ዬካፓ ሻውሎ ቃኣቃ ዓኣ፥ ዛይቶይዳ ፔኤኮ ሚዛቆ ኩጮ ኬኤሎ ዳኪ ዳኪ ናንጊና ናንጋ ጎዳ ቤርታ ላንካይ ማይንቲ ዉፁርቆንጎ፤ <verse eid="LEV 14:16"/><verse number="17" style="v" sid="LEV 14:17"/>ቃሲ ሃሣ ቃኣቆይዳ ዓኣ ዛይቶፓ ዻካ ዔኪ ጌኤሽኪፆይዳ ዓኣ ዓሢኮ ሚዛቆ ዋዮ ቤርቶና ሚዛቆ ኩጮና ቶኮናኮ ዶኦሞ ኬኤሎንሢ ዎንዴ ዻቢንቶ ዛሎ ጪጋ ማሂ ቲሽኮና ሱጉፆኮ ጊዳ ቲሽኮንጎ፤ <verse eid="LEV 14:17"/><verse number="18" style="v" sid="LEV 14:18"/>ዬካፓ ዒዛኮ ቃኣቃ ዓቲ ዓኣ ዛይቶንሢ ጌኤሽኪፆይዳ ዓኣ ዓሢኮ ቶኦካ ዋሆንጎ፤ ዬያይዲ ዓሢ ጌኤሺፆ ዳምቦ ናንጊና ናንጋ ጎዳ ቤርታ ኩንሦንጎ።<verse eid="LEV 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 14:19"/>«ዬያይዴስካፓ ቄኤሳሢ ዓሢኮ ጎሞ ጌኤሺፆሮ ዒንጎ ዒንጊፆ ዒንጊ ጎሞ ጌኤሺፆ ዳምቦ ኩንሦንጎ፤ ሄሊሳዖ ሃሣ ሚቺ ዒንጎ ዒንጊፆ ማዒ ዒንጊንቴ ቆልሞ ሹኮንጎ፤ <verse eid="LEV 14:19"/><verse number="20" style="v" sid="LEV 14:20"/>ዬያ ሃኣኮ ዒንጊፆ ማዔ ዒንጊፆና ዎላ ሚቺ ዒንጎ ቤዛ ጌሢ ሚቾንጎ፤ ዬያይዲ ጌኤሺፆ ዳምቦ ኩንሤም ዬይ ዓሢያ ዳምቦ ጎይፆና ጌኤሽኬያ ማዓንዳኔ።<verse eid="LEV 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 14:21"/>«ዓሢ ዬያ ባኮ ቢያ ዔኪ ሙካኑዋ፥ ማንቆ ማዔቴ ፔኤኮ ጌኤሽኪፆ ዛሎ ማዓ ፔቴ ዓዴ ማራናይ ሌሊ ዔኪ ሙኮንጎ፤ ዬይ ዻቢንቶ ዛሎ ጪጋ ማሂ ዒንጊንታ ዒንጊሢ ማዒ ዡጊ ዒንጎ ዒንጊሢ ማዓንዳኔ፤ ሃሣ ዛይቴና ዲርኪንቴ ፔቴ ኪሎ ማዓንዳ ሺኢቺ ዺኢሊ ሃኣኮ ዒንጊሢ ማሂ ዔኪ ሙኮንጎ፤ ዬያጉዲ ሃሣ ዶሎዞኮ ጊዲሚሺ ማዑዋ ዛይቶዋ ዔኪ ሺኢሾንጎ፤ <verse eid="LEV 14:21"/><verse number="22" style="v" sid="LEV 14:22"/>ሃሣ ዒዛም ዳንዳዒንታ ጎይፆ ላምዖ ዶኦሌ፥ ሃንጎ ላምዖ ኪሬ፤ ፔቴማ ጎሞ ጌኤሻ ዒንጊሢ ማሂ ፔቴማ ጊንሣ ሚቺ ዒንጎ ዒንጊሢ ማሂ ዔኪ ሙኮንጎ። <verse eid="LEV 14:22"/><verse number="23" style="v" sid="LEV 14:23"/>ጌኤሺፆ ዳምቦ ኩንሦ ሳላሳ ኬሎና ዬንሢ ቢያ ዔኪ ሙኪ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ካራ ናንጊና ናንጋ ጎዳ ቤርታ ቄኤሳሢም ዒንጎንጎ። <verse eid="LEV 14:23"/><verse number="24" style="v" sid="LEV 14:24"/>ዬካፓ ቄኤሳሢ ዻቢንቶ ዛሎ ጪጋ ማሂ ዒንጊንታ ማራናዖና ዛይቶና ዔኪ ዡጊ ናንጊና ናንጋ ጎዳም ሺኢሾንጎ። <verse eid="LEV 14:24"/><verse number="25" style="v" sid="LEV 14:25"/>ዬካፓ ዻቢንቶ ዛሎ ጪጋ ማሂ ዒ ዒንጌ ማራዓሢ ሹኮንጎ፤ ዬያ ሱጉፆ ዻካ ዔኪ ጌኤሽኪፆይዳ ዓኣ ዓሢኮ ሚዛቆ ዛሎ ዋዮ ቤርቶ፥ ሚዛቆ ኩጮና ቶኮናኮ ዶኦሞ ኬኤሎ ቲሽኮንጎ፤ <verse eid="LEV 14:25"/><verse number="26" style="v" sid="LEV 14:26"/>ዬያይዴስካፓ ቄኤሳሢ ዛይቶይዳፓ ዻካ ፔኤኮ ሻውሎ ኩጮ ቃኣቆይዳ ዋሂ ዔኮንጎ፤ <verse eid="LEV 14:26"/><verse number="27" style="v" sid="LEV 14:27"/>ዔኬስካፓ ሚዛቆ ኩጮ ኬኤሎና ዬያ ዛይቶፓ ዔኪ ዔኪ ላንካይ ማይንቲ ናንጊና ናንጋ ጎዳ ቤርታ ዉፁርቆንጎ። <verse eid="LEV 14:27"/><verse number="28" style="v" sid="LEV 14:28"/>ሃሣ ዬያ ዛይቶፓ ዻካ ዔኪ ቤርታ ዒ ሱጉፆ ቲሽኬ ቤዞ፤ ጌይፃ፦ ዓሢኮ ሚዛቆ ዋዮ ቤርቶና ሚዛቆ ኩጮና ቶኮናኮ ዶኦሞ ኬኤሎንሢ ቲሽኮንጎ። <verse eid="LEV 14:28"/><verse number="29" style="v" sid="LEV 14:29"/>ዬካፓ ቄኤሳሢ ፔ ኩጮይዳ ዓቴ ዛይቶ ዓሢኮ ቶኦካ ዋሆንጎ፤ ዬያይዲ ዓሢኮ ጎሞ ጌኤሺፆ ዳምቦ ኩንሦንጎ። <verse eid="LEV 14:29"/><verse number="30" style="v" sid="LEV 14:30"/>ዬያይዴስካፓ ዶኦሎንሢፓታቴያ ኪሮንሢፓ ፔቴማ ጎሜ ጌኤሺሢ ዛላ ማሂ፥ <verse eid="LEV 14:30"/><verse number="31" style="v" sid="LEV 14:31"/>ዓቴማ ሚቺ ዒንጎ ዒንጊሢ ማሂ ሃኣኮ ዒንጊፆና ዎላ ሺኢሾንጎ፤ ዬያይዲ ዓሢኮ ጎሞ ጌኤሺፆ ዳምቦ ኩንሦንጎ፤ <verse eid="LEV 14:31"/><verse number="32" style="v" sid="LEV 14:32"/>ዑፆይዳ ኬስካ ዶርዓ ዓኣ ዓሲ ዳምቦ ጎይፆና ጌኤሽኪፆሮ ዓይሢንታ ባኮ ማንቆ ማዒ ባሺንታያታቴ ማዺንታንዳ ዎጋ ያዺኬ» ጌዔኔ።<verse eid="LEV 14:32"/></para>
  <para style="s1">ማኣሪዳ ኬስካ ቡኡዒሢ ዛላ</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 14:33"/>ናንጊና ናንጋ ጎዳ ሙሴና ዓኣሮኔናም፦ <verse eid="LEV 14:33"/><verse number="34" style="v" sid="LEV 14:34"/>«ዒንሢሮ ማሂ ታ ዒንሢም ዒንጋንዳ፥ ካኣናኔ ዓጮ ዒንሢ ጌሌ ዎዶና ፔቴ ዓሲኮ ዎርቆ ማኣሮ ታኣኒ ቡኡዒሴያ ማዔቴ፥ <verse eid="LEV 14:34"/><verse number="35" style="v" sid="LEV 14:35"/>ማኣሮ ዓዴ ቄኤሳሢ ኮይላ ዓኣዺ ‹ታ ማኣሮይዳ ቡኡዒሢጉዴ ባኣዚ ታ ዴንቄኔ› ጌይ ኬኤዞንጎ። <verse eid="LEV 14:35"/><verse number="36" style="v" sid="LEV 14:36"/>ዬካፓ ቄኤሳሢ ዴንዲ ቡኡዒፆ ዛጊ ዔራንዳሢኮ ቤርታዺ ማኣራ ዓኣ ሜሆ ቢያ ዓሢ ኬሳንዳጉዲ ኬኤዞንጎ፤ ያዺ ማዒባኣያታቴ ጋራ ዓኣ ሜሃ ቢያ ዒኢታንዳኔ፤ ዬያይዴስካፓ ጋሮ ጌሊ፥ <verse eid="LEV 14:36"/><verse number="37" style="v" sid="LEV 14:37"/>ቡኡዒፃ ዓይጎታቴያ ዛጎንጎ፤ ዒዚ ዛጋንቴ ኮጮ ዶይሳኒ ጋዓ፥ ጮልዔ፤ ሃሣ ጊንሣ ዞቃንዳጉዴ ቡኡዒሢ ዓርቂ ጴዼቴ፥ <verse eid="LEV 14:37"/><verse number="38" style="v" sid="LEV 14:38"/>ዬኖ ኬኤፄሎፓ ኬስኪ ላንካይ ኬሊ ሄላንዳኣና ዬይ ዎዺንቲ ዴዓንዳጉዲ ማሆንጎ። <verse eid="LEV 14:38"/><verse number="39" style="v" sid="LEV 14:39"/>ላንካሳ ኬሎና ቄኤሳሢ ጊንሣ ዛጎንጎ፤ ዒ ዛጋንቴ ቡኡዒፃ ኮጮይዳ ዳልጊ ዳልጊ ዓኣዻያ ማዔቴ፥ <verse eid="LEV 14:39"/><verse number="40" style="v" sid="LEV 14:40"/>ቡኡዒፆና ዓዺንቴ ሹጮንሢ ቦኦኪንቲ ዔውቲ ጉርዶኮ ዙላ፥ ካንቶይዳ ኬኤሪንታንዳጉዲ ዓይሦንጎ። <verse eid="LEV 14:40"/><verse number="41" style="v" sid="LEV 14:41"/>ዬካፓ ኮጮኮ ጋሮ ዛላ ቢያ ዓርሲንቴም ዓርሲንቴ ባካ ቢያ ጉርዶ ዙላ ዒኢቴ ቤዛ ኬኤሪንታንዳጉዲ ማሆንጎ፤ <verse eid="LEV 14:41"/><verse number="42" style="v" sid="LEV 14:42"/>ዬያይዴስካፓ ቦኦኪንቲ ዔውቴ ሹጮንሢ ቤዛ ሜሌ ሹቺ ጌሢንቲ ሜሌ ዾቃሌና ዹይ ዓይሢንቶንጎ።<verse eid="LEV 14:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LEV 14:43"/>«ሹጫ ኬስኪ፥ ኮጫኣ ሜሌ ዾቃሌና ዹይንቴስካፓ ቡኡዒፆ ማላቴላ ላሚ ጴዼያ ማዔቴ፥ <verse eid="LEV 14:43"/><verse number="44" style="v" sid="LEV 14:44"/>ቄኤሳሢ ዴንዲ ዛጋንዳያ ኮይሳኔ፤ ዒ ዛጋንቴ ቡኡዒፃ ጋሮይዳ ዳልጊ ዳልጊ ዴዴንዳ ማዒ ጴዼቴ ዬና ማኣሬላ ዒኢቴያኬ። <verse eid="LEV 14:44"/><verse number="45" style="v" sid="LEV 14:45"/>ዬያሮ ዬና ማኣራ ሻሂንታንዳያ ኮይሳኔ፤ ሹጮንታ ሚፆንታ ሜኤቾና ባካኣ ቢያ ጉርዶኮ ዙላ ዒኢቴ ቤዛ ኬኤሪንቶንጎ። <verse eid="LEV 14:45"/><verse number="46" style="v" sid="LEV 14:46"/>ዬና ማኣሬላ ዎዺንቲ ዓኣንቴ ዓይጎ ዓሲያ ማዖም ዒኢካ ጌሌቴ ዴንዲ ሳዓ ዓማንዳያ ሄላንዳኣና ዒኢቴያ ማዓንዳኔ፤ <verse eid="LEV 14:46"/><verse number="47" style="v" sid="LEV 14:47"/>ዬኖ ማኣሬሎይዳ ጌሊ ላሄ ዓሲ ዓኣቴ፥ ሃሣ ሙኡዚ ዴዒ ሙዔ ዓሲ ዓኣቴ ማኣዓሢ ፔኤኮ ማስኮንጎ።<verse eid="LEV 14:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LEV 14:48"/>«ጋዓንቴ ማኣራ ዹይንቲ ኮሽኬስካፓ ቄኤሳሢ ሙኪ ዛጋ ዎዶና ቡኡዒፃ ዳልጊ ዴንዳያ ማዒባኣቴ ዬኖ ማኣሬሎ ቡኡዒፃ ሃሼም ዳምቦ ጎይፆና ጌኤሺ ማዔሢ ዔርዞንጎ፤ <verse eid="LEV 14:48"/><verse number="49" style="v" sid="LEV 14:49"/>ዬኖ ማኣሮ ጌኤሻኒ ላምዖ ካፒ፥ ዻካ ዴኤሊ ዚቢቂ ሜንሥሢ፥ ዞቄ ሚዛጶ ፓቲሎና ሂሶጴ ዒላሺያኣ ዔኪ ሺኢኮንጎ። <verse eid="LEV 14:49"/><verse number="50" style="v" sid="LEV 14:50"/>ካፖይዳፓ ፔቴማ ጊኢሲ ዋኣሢ ዓልቃ ቤስካፓ ዱዖና ዋኣሢ ዓኣ ታሚ ቦኦቆይዳ ሹኮንጎ፤ <verse eid="LEV 14:50"/><verse number="51" style="v" sid="LEV 14:51"/>ዬካፓ ዴኤሎ ዚቢቆ ሚፆና ሂሶጶ ዒላዦና ሃሣ ሚዛጶ ዞቄ ፓቲሎና ሼምፖና ዓኣ ካፖማንታ ዋኣፆና ሱጉፆናይዳ ዓጊጋፓ ማኣሮ ላንካይ ማይንቲ ፑጮንጎ። <verse eid="LEV 14:51"/><verse number="52" style="v" sid="LEV 14:52"/>ዬያይዲ ቄኤሳሢ ዬኖ ማኣሮ ካፖ ሱጉፆና ጌኤዦ ዋኣፆና ሼምፖና ዓኣ ካፖማና፤ ሃሣ ዴኤሎ ዚቢቆ ሚፆና ሂሶጴ ዒላዦና ዞቄ ሚዛጶ ፓቲሎናኣ ጌኤሾንጎ። <verse eid="LEV 14:52"/><verse number="53" style="v" sid="LEV 14:53"/>ዬካፓ ሼምፖና ዓኣ ካፖማ ጉርዶኮ ዙሎ ኬሲ ባራኒ ዴንዳንዳጉዲ ሃሾንጎ፤ ዬያይዲ ቡኡዒፃ ጴዼ ማኣሬሎ ጌኤሺፆ ዳምባ ኩማኔ፤ ማኣራኣ ዳምቦ ጎይፆና ጌኤሽኬያ ማዓንዳኔ።<verse eid="LEV 14:53"/></para>
  <para style="p">
    <verse number="54-56" style="v" sid="LEV 14:54-56"/>«ዬይ ቢያ ዑስካ ኬስካ ዶርዓ፥ ቃፃ፥ ዑስካ ኪፃ ባኣዚ፥ ዒላንታ፤ ዬያጉዲ ሃሣ ማኣዖና ማኣሪናይዳ ኬስኪ ጴዻ ቡኡዒሢ ዓርቄ ዎዶና ጌኤሺፆሮ ማዺ ኩንሦ ዎጌኬ። <verse eid="LEV 14:54-56"/><verse number="57" style="v" sid="LEV 14:57"/>ፔቴ ባኣዚ ጌኤሺ፤ ሃሣ ዒኢቴያ ማዒፃ ዬያ ዎጎና ዱማዺ ዔርታኔ» ጌዔኔ።<verse eid="LEV 14:57"/></para>
  <chapter eid="LEV 14"/>
  <chapter number="15" style="c" sid="LEV 15"/>
  <para style="s1">ዓሲኮ ዑስካፓ ሾኦቲ ዓሲ ዒኢሳ ባኣዚ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 15:1"/>ናንጊና ናንጋ ጎዳ ሙሴና ዓኣሮኔናም፦ <verse eid="LEV 15:1"/><verse number="2" style="v" sid="LEV 15:2"/>«ዒስራዔኤሌ ዴሮም ሂዚ ጌዔ፤ ዓይጎ ዓሲኮዋ ማዖም ሃርጌ ዛላና ዓቲንቴይዳፓ ዓልቃ ባኣዚ ኬስኬቴ ዬይ ዓሢ ዒኢቴያኬ፤ <verse eid="LEV 15:2"/><verse number="3" style="v" sid="LEV 15:3"/>ዓሢኮ ዑፃፓ ዓልቃ ባካ ዓልቃ ጎይሣታቴያ ሃሼቴያ ዬይ ዓሢ ዒኢቴያኬ፤ ዬይ ዓልቃ ባካ ዒኢሳያ ማዓሢ ያዺዲኬ፦ <verse eid="LEV 15:3"/><verse number="4" style="v" sid="LEV 15:4"/>ዬይ ዓሢ ላሄ ቤዛ ቢያ ዒኢቴያ ማዓንዳኔ፤ ሃሣ ዴዔ ባካኣ ቢያ ዒኢቴያ ማዓንዳኔ። <verse eid="LEV 15:4"/><verse number="5" style="v" sid="LEV 15:5"/>ዒዚ ላሃ ሻኣሎ ካኣሜ ዓሲ ዓኣቴ፥ <verse eid="LEV 15:5"/><verse number="6" style="v" sid="LEV 15:6"/>ሃሣ ዒ ዴዔ ባኣዚ ቢያይዳ ዴዓ ዓሲ ቢያ ማኣዓሢ ፔኤኮ ማስኪ ዑፆዋ ማስቶንጎ፤ ማዔቴያ ዴንዲ ሳዓ ዓማንዳያ ሄላንዳኣና ዒኢቴያ ማዓንዳኔ። <verse eid="LEV 15:6"/><verse number="7" style="v" sid="LEV 15:7"/>ዬኖ ዓልቃ ባኮና ዓኣ ዓሢ ካኣማ ዓሲ ቢያ ማኣዓሢ ፔኤኮ ማስኪ ዑፆዋ ማስቶንጎ፤ ማዔቴያ ዴንዲ ሳዓ ዓማንዳያ ሄላንዳኣና ዒኢቴያ ማዓንዳኔ። <verse eid="LEV 15:7"/><verse number="8" style="v" sid="LEV 15:8"/>ዬይ ሃርጋ ዓሢ ጌኤሺ ማዔ ዓሲ ዑስካ ጩቺ ጩቴያ ማዔቴ ጩቲንቴ ዓሢ ማኣዓሢ ፔኤኮ ማስኪ፥ ዑፆዋ ማስቶንጎ፤ ማዔቴያ ዴንዲ ሳዓ ዓማንዳያ ሄላንዳኣና ዒ ዒኢቴያ ማዓንዳኔ። <verse eid="LEV 15:8"/><verse number="9" style="v" sid="LEV 15:9"/>ዬይ ሃርጋ ዓሢ፦ ቶጋኣና ዴዔ ኮኦራሢና ዖይቶና ቢያ ዒኢቴያኬ፤ <verse eid="LEV 15:9"/><verse number="10" style="v" sid="LEV 15:10"/>ሃሣ ዒ ዴዔ ባኮ ቢያ ካኣማ ዓሲ፤ ዬያጉዲ ሃሣ ዬያ ባኮ ዔኪ ሺኢሻ ዓሲ ማኣዓሢ ፔኤኮ ማስኪ ዑፆዋ ማስቶንጎ፤ ማዔቴያ ዴንዲ ሳዓ ዓማንዳያ ሄላንዳኣና ዒኢቴያ ዒ ማዓንዳኔ። <verse eid="LEV 15:10"/><verse number="11" style="v" sid="LEV 15:11"/>ዬይ ሃርጋ ዓሢ ኩቺ ማስቱዋዖ ፔቴ ዓሲ ካኣሜቴ ዬይ ካኣሚንቴ ዓሢ ማኣዓሢ ፔኤኮ ማስኪ ዑፆዋ ማስቶንጎ፤ ማዔቴያ ዴንዲ ሳዓ ዓማንዳያ ሄላንዳኣና ዒ ዒኢቴያ ማዓንዳኔ። <verse eid="LEV 15:11"/><verse number="12" style="v" sid="LEV 15:12"/>ዬይ ሃርጎና ዓኣ ዓሢ ካኣሜ ዓይጎ ባኣዚያ ማዖም ዓጪና ማዦና ሜሄ ቢያ ሃሃይቆንጎ፤ ሚሢና ኮሺንቴ ሜሄ ማዔቴ ጋዓንቴ ዋኣሢና ማስኪንቶንጎ።»<verse eid="LEV 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 15:13"/>«ዬይ ሃርጋ ዓሢ ዬኖ ዓልቂሳ ሃርጌሎይዳፓ ዻቄ ዎዶና ዎጎ ጎይፆ ጌኤሽኬያ ማዓኒ ላንካይ ኬሊ ሄላንዳኣና ዴዖንጎ፤ ሃሣ ማኣዓሢያ ፔኤኮ ማስኪ ዑፆዋ ጌኤሺ ዋኣሢና ማስኮንጎ፤ ዬካፓ ዒ ዳምቦ ጎይፆና ጌኤሽኬያ ማዓንዳኔ። <verse eid="LEV 15:13"/><verse number="14" style="v" sid="LEV 15:14"/>ሳላሳ ኬሎና ላምዖ ዶኦሌ ሃንጎ ላምዖ ኪሬ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ካሮ ዔኪ ሙኪ ናንጊና ናንጋ ጎዳ ቤርታ ቄኤሳሢም ዒንጎንጎ። <verse eid="LEV 15:14"/><verse number="15" style="v" sid="LEV 15:15"/>ዬያይዴስካፓ ቄኤሳሢ፥ ፔቴማ ጎሜ ጌኤሻኒ ዒንጎ ዒንጊሢ ማሂ ዓቴማ ጊንሣ ሚቺ ዒንጎ ዒንጊሢ ማሂ ሺኢሾንጎ፤ ዬያይዲ ቄኤሳሢ ዓሢ ጌኤሺፆ ዳምቦ ናንጊና ናንጋ ጎዳ ቤርታ ኩንሦንጎ።»<verse eid="LEV 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 15:16"/>«ዓይጎ ዓሲኮዋ ማዖም ዓሲ ሾይዣ ዜርፃ ዑፃፓ ኬስኪ ላኣሊንቴያ ማዔቴ ዬይ ዓሢ ዑፆ ቢያ ዋኣሢና ማስቶንጎ፤ ማዔቴያ ዒ ሳዓ ዓማንዳያ ሄላንዳኣና ዒኢቴያ ማዓንዳኔ። <verse eid="LEV 15:16"/><verse number="17" style="v" sid="LEV 15:17"/>ዬይ ዜርፃ ሄሌ፥ ዓይጎ ማኣዖዋ ማዖም ዜዺ ዋኣሢና ማስኪንቶንጎ፤ ማዔቴያ ዬይ ባካ ሳዓ ዴንዲ ዓማንዳያ ሄላንዳኣና ዒኢቴያ ማዓንዳኔ። <verse eid="LEV 15:17"/><verse number="18" style="v" sid="LEV 15:18"/>ፔቴ ዓሲ ላኣሊና ላሄቴ ላምዖንሢ ቢያ ዑፆ ዋኣሢና ማስቶንጎ፤ ማዔቴያ ዴንዲ ሳዓ ዓማንዳኣና ዒኢቴያ ዔያታ ማዒ ዴዓንዳኔ።<verse eid="LEV 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 15:19"/>«ላኣሊኮ ሻቱሞ ሙኪ ጴዼ ዎዶና ላንካይ ኬሊ ሄላንዳኣና ዒዛ ዒኢቴያ ማዖንጎ፤ ዬኖ ዓሴሎ ካኣማ ዓይጎ ዓሲያ ዴንዲ ሳዓ ዓማንዳኣና ዒኢቴያ ማዓንዳኔ። <verse eid="LEV 15:19"/><verse number="20" style="v" sid="LEV 15:20"/>ዒዞኮ ሻቱሙማ ጴዼ ዎዶና ዒዛ ዴዓ ባኮና ላሃ ባኮና ቢያ ዒኢቴያ ማዓንዳኔ። <verse eid="LEV 15:20"/><verse number="21-23" style="v" sid="LEV 15:21-23"/>ዒዛ ላሃ ሻኣሎ ማዔቴያ ዒዛ ዴዓ ባኮ ካኣሜ ዓሲ ቢያ ማኣዓሢ ፔኤኮ ማስኪ ዑፆዋ ፔኤኮ ማስቶንጎ፤ ማዔቴያ ዴንዲ ሳዓ ዓማንዳያ ሄላንዳኣና ዒኢቴያ ዒዛ ማዓንዳኔ። <verse eid="LEV 15:21-23"/><verse number="24" style="v" sid="LEV 15:24"/>ሻቱማ ዒዞኮ ሙኪ ዓኣንቴ ዒዞና ዎላ ላሄ ዓቲንቄ ዓኣቴ ዬይ ዓሢ ላንካይ ኬሊ ሄላንዳኣና ዒኢቴያ ማዓንዳኔ፤ ዒዚ ላሃ ሻኣላኣ ዒኢቴያ ማዓንዳኔ።<verse eid="LEV 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 15:25"/>«ፔቴ ላኣሊኮ ሻቱሞ ማዒ ሾኦታ ኬላፓ ዑሣ ዓኣዺ ሾኦታ ሱጉሢ ጴዼቴ ዬይ ጋፓንዳያ ሄላንዳኣና ሻቱማ ጴዻኣና ማዓሢጉዲ ዒኢቴያ ዒዛ ማዓንዳኔ። <verse eid="LEV 15:25"/><verse number="26" style="v" sid="LEV 15:26"/>ዬማና ዒዛ ላሃ ሻኣሎ ማዔታቴያ ዴዓ ባካ ቢያ ዒኢቴያ ማዓንዳኔ፤ <verse eid="LEV 15:26"/><verse number="27" style="v" sid="LEV 15:27"/>ዬንሢ ባኮንሢያ ካኣማ ዓሲ ቢያ ዒኢቴያ ማዓሢሮ ፔኤኮ ማኣዓሢ ማስኪ ዑፆዋ ማስቶንጎ፤ ማዔቴያ ዴንዲ ሳዓ ዓማንዳኣና ዒኢቴያ ማዓንዳኔ። <verse eid="LEV 15:27"/><verse number="28" style="v" sid="LEV 15:28"/>ሻቱማ ዒዞኮ ሙኪፆ ሃሼስካፓ ላንካይ ኬሊ ሄላንዳኣና ዒዛ ዴዖንጎ፤ ዬካፓ ዎጎ ዳምቦ ጎይፆና ዒዛ ጌኤሽኬያ ማዓንዳኔ። <verse eid="LEV 15:28"/><verse number="29" style="v" sid="LEV 15:29"/>ሳላሳ ኬሎና ዒዛ ላምዖ ዶኦሌታቴያ ላምዖ ኪሬ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ካሮ ዔኪ ሙኪ ቄኤሳሢም ዒንጎንጎ። <verse eid="LEV 15:29"/><verse number="30" style="v" sid="LEV 15:30"/>ዬካፓ ቄኤሳሢ ፔቴማ ጎሜ ጌኤሻ ዒንጊሢ ማሂ፥ ዓቴማ ሚቺ ዒንጎ ዒንጊሢ ማሂ ዒንጎንጎ፤ ዬያይዲ ላኣሌሎኮ ጌኤሽኪፆ ዳምቦ ናንጊና ናንጋ ጎዳ ቤርታ ኩንሦንጎ።<verse eid="LEV 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 15:31"/>«ጉርዶ ባኣካ ዔያቶኮ ዓኣ፥ ዓፒሎና ማዢንቴ ፆኦሲ ዴሮና ካኣማ ማኣሮ ዔያታ ዒኢሱዋጉዲ፤ ሃሣ ዬያ ዒኢሲ ዔያታ ሃይቁዋጉዲ ዒስራዔኤሌ ዓሶ ዒኢሳ ባኣዚፓ ዱማሱዋቴ» ጌይ ኬኤዜኔ።<verse eid="LEV 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 15:32"/>ሃርጌ ዛላና ዓቲንቴይዳፓ ዓልቃ ባኣዚ ኬስካ ዓሲ፤ ሃሣ ጊንሣ ዓሲ ሾይዣ ዜርፃ ላኣሊንቴም ዒኢቴያ ማዔ ዓሲ፥ <verse eid="LEV 15:32"/><verse number="33" style="v" sid="LEV 15:33"/>ሻቱሞ ሙኬ ላኣሊ ዛላ፥ ዑስካፓ ሾኦታ ባኣዚ ኬስካ ዓቲንቄ ዛላኣ ማዖም ላኣሊ ዛላ፤ ዬያጉዲ ሻቱሞ ዛላና ዒኢቴ ላኣሊና ላሃ ዓሲም ቢያ ማዺንታ ዎጋ ያዺኬ።<verse eid="LEV 15:33"/></para>
  <chapter eid="LEV 15"/>
  <chapter number="16" style="c" sid="LEV 16"/>
  <para style="s1">ጎሜ ጌኤሺሢ ኬሊ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 16:1"/>ዓኣሮኔኮ ላምዖ ዓቲንቆ ናኣቶንሢ ፆኦሲም ዱማዺባኣ ታሞ ናንጊና ናንጋ ጎዳም ሺኢሻኔ ጌይ ሃይቄስካፓ ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 16:1"/><verse number="2" style="v" sid="LEV 16:2"/>«ጫኣቁሞ ሳኣፂኖኮ ጎሞ ጌኤሽኪፆ ዔርዛ ጉኡፖ ዑፃ ሻኣሬና ታኣኒ ፔጋዺ ጴዻንዳሢሮ ጎኦቦ ዓፒሎ ጊዴና ዖኦኪ ዓኣዺ ታኣም ዑሣ ዓኣዼ ዱማዼ ቤዞ ቢያ ኬሊቱዋንቴ ፔቴ ዔርቴ ኬሊና ጌላኒ ኮይሳያታሢ ኔ ጌርሲ ዓኣሮኔም ኬኤዜ፤ ዬያ ዒ ማዺባኣቴ ሃይቃንዳኣኬ። <note caller="-" style="x"><char style="xo" closed="false">16፡2 </char><char style="xt" closed="false"><ref loc="HEB 6:19">ዔብ. 6፡19</ref>።</char></note> <verse eid="LEV 16:2"/><verse number="3" style="v" sid="LEV 16:3"/>ታኣም ዑሣ ዓኣዼ ዱማዼ ቤዞ ጌላኒ ዒ ዳንዳዓሢ ጎሞ ጌኤሺፆም ማዓ ፔቴ ዚያ ጌማይ፤ ሚቺ ዒንጎ ዒንጊፆም ፔቴ ማራይ ዓዴ ዔኪ ሙኪኬ። <note caller="-" style="x"><char style="xo" closed="false">16፡3 </char><char style="xt" closed="false"><ref loc="HEB 9:7">ዔብ. 9፡7</ref>።</char></note><verse eid="LEV 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 16:4"/>«ዒዚ ታኣም ዑሣ ዓኣዼ ዱማዼ ቤዞ ጌላንዳሢኮ ቤርታ ዑፆ ፔኤኮ ማስቲ፥ ሚዛጶ ሱኡፓሢና ኮሺንቴ ቃሚሾ ማኣዒ፥ ቆንፃሢያ ቱኡቶንጎ፤ ሃሣ ሚዛጶ ሱኡፓሢና ኮሺንቴ ቃልሾዋ ቱኪ፤ ጊንሣ ሱኡፓሢና ኮሺንቴ ቶኦካ ማሮ ባኮዋ ማሮንጎ፤<verse eid="LEV 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 16:5"/>«ዬያይዴስካፓ ዒስራዔኤሌ ዴራ ጎሞ ጌኤሺፆ ዛሎ ላምዖ ኮላይ፤ ሚቺ ዒንጎ ዒንጊሢም ማዓ ፔቴ ዓዴ ማራይ ዔኪ ዒዛም ሙኮንጎ። <verse eid="LEV 16:5"/><verse number="6" style="v" sid="LEV 16:6"/>ዬካፓ ዒዚ ፔ ጎሞና ፔ ማኣሮ ዓሶ ጎሞ ጌኤሻኒ ፔቴ ዚያ ጌማይ ሚቺ ዒንጎ ዒንጊሢ ማሂ ሺኢሾንጎ፤ <verse eid="LEV 16:6"/><verse number="7" style="v" sid="LEV 16:7"/>ዬያይዴስካፓ ላምዖ ዋኣሮንሢ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ካሮ ዔኪ ዓኣዺ ናንጊና ናንጋ ጎዳ ቤርታ ዒ ሺኢሾንጎ። <verse eid="LEV 16:7"/><verse number="8" style="v" sid="LEV 16:8"/>ዬካፓ ፔቴማ ናንጊና ናንጋ ጎዳም፤ ዓቴማ ጊንሣ ዓዛዜሌም<note caller="+" style="f"><char style="fr" closed="false">16፡8 </char><char style="fq" closed="false">ዓዛዜሌ </char><char style="ft" closed="false">ጋዓዞኮ፦ ዔብሬ ዓሶ ሙኡጮና ቡሊፃ ፔጋዺ ዔርቱዋያኬ፤ ጋዓንቴ ቦኦሊዳ ዓኣ ፃላሄ ዓያና ሱንሢ ማዑዋዖ ዓታዓ ጌይንታኔ።</char></note> ማዓሢ ዔራኒ ላምዖ ሹቺ ዔኪ ዒፃ ዓጎንጎ። <verse eid="LEV 16:8"/><verse number="9" style="v" sid="LEV 16:9"/>ዬያይዲ ዔሬስካፓ ናንጊና ናንጋ ጎዳም ማዔ ዋኣራሢ ጎሞ ጌኤሻኒ ዒንጎ ዒንጊሢ ማሂ ሺኢሾንጎ። <verse eid="LEV 16:9"/><verse number="10" style="v" sid="LEV 16:10"/>ዓዛዜሌም ማዔ ዋኣራሢ ሳዛና ዓኣንቴ ናንጊና ናንጋ ጎዳ ቤርቶ ሺኢሺ፥ ዴሮኮ ጎሞ ዔኪ ዓኣዻንዳጉዲ ዓሲ ናንጉዋ ዳውሎ ዳኮንጎ።<verse eid="LEV 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 16:11"/>«ዬካፓ ፔ ጎሞና ፔ ማኣሮ ዓሶ ጎሞ ጌኤሻያ ማሂ ጌሜ ዔኪ ሙኪ ሹኮንጎ፤ <verse eid="LEV 16:11"/><verse number="12" style="v" sid="LEV 16:12"/>ናንጊና ናንጋ ጎዳም ሚቺ ዒንጎ ቤዞይዳፓ ታሚ ቄንሢ ዑንጆ ጩቢሶ ቦኦቆይዳ ኩንሢ፥ ካኣሺ ዔኪ፤ ሃሣ ዑዲንቲ ሺኢቴ ዑንጆ ፔቴ ሾኦፓና ዔኪ ታኣም ዑሣ ዓኣዼ ዱማዼ ቤዞ ጌልዞንጎ። <verse eid="LEV 16:12"/><verse number="13" style="v" sid="LEV 16:13"/>ዒኢካ ናንጊና ናንጋ ጎዳ ቤርታ ታሞይዳ ዑንጆ ዋሆንጎ፤ ዒዚ ጎሞ ጌኤሺፆ ዔርዛ ጉኡፖ ዛጊ ሃይቁዋጉዲ ዑንጆኮ ጩባ ዬያ ጉኡፖ ባይዛያ ማዖንጎ፤ <verse eid="LEV 16:13"/><verse number="14" style="v" sid="LEV 16:14"/>ሃሣ ጌሜኮ ሱጉፃፓ ዻካ ዔኪ ጎሞ ጌኤሽኪፆ ዔርዛ ጉኡፖይዳ ዓባ ኬስካ ባንፆና ኬኤላና ዉፁርቆንጎ፤ ሃሣ ጫኣቁሞ ሳኣፂኖ ቤርታኣ ላንካይ ማይንቲ ዒማ ዛሎና ዉፁርቆንጎ።<verse eid="LEV 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 16:15"/>«ዬካፓ ዴሮኮ ጎሞ ጌኤሻኒ ዒንጊንቴ ዋኣራሢ ሹኪ፥ ሱጉፆዋ ታኣም ዑሣ ዓኣዼ ዱማዼ ቤዞ ጌልዚ፥ ጌሜ ሱጉፆና ማዼ ጎይፆ ጎሞ ጌኤሽኪፆ ዔርዛ ጉኡፖ ዑፆይዳ፤ ጊንሣ ሃሣ ጫኣቁሞ ሳኣፂኖ ቤርቶይዳ ዉፁርቆንጎ። <note caller="-" style="x"><char style="xo" closed="false">16፡15 </char><char style="xt" closed="false"><ref loc="HEB 9:12">ዔብ. 9፡12</ref>።</char></note> <verse eid="LEV 16:15"/><verse number="16" style="v" sid="LEV 16:16"/>ዬያይዲ ታኣም ዑሣ ዓኣዼ ዱማዼ ቤዛ ዒስራዔኤሌ ዴሮኮ ዻቢንቶና ጎሞናይዳፓ ቢያ ዱማዺ ጌኤሽኬያ ማዓንዳጉዲ ጌኤሺፆ ዳምቦ ኩንሦንጎ፤ ዎጎ ጎይፆ ዳምቤና ጌኤሺ ማዒባኣ ጉርዳ ሳዛይዳ ዓኣ፥ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ዛሎዋ ዒዞ ጎይፆ ማዾንጎ። <verse eid="LEV 16:16"/><verse number="17" style="v" sid="LEV 16:17"/>ዓኣሮኔ ጌኤሺፆ ዳምቦ ኩንሢፆሮ ፔ ጎሞና ፔ ማኣሮ ዓሶ ጎሞና፤ ሃሣ ዒስራዔኤሌ ዓሶ ጎሞዋ ጌኤሻኒ ታኣም ዑሣ ዓኣዼ ዱማዼ ቤዞ ጌሌማፓ ዴንዲ ዒ ኬስካንዳያ ሄላንዳኣና ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮይዳ ዖኦኒያ ጴዾፓ። <verse eid="LEV 16:17"/><verse number="18" style="v" sid="LEV 16:18"/>ዬካፓ ዒ ኬስካዖ ናንጊና ናንጋ ጎዳ ቤርታ ዓኣ፥ ሚቺ ዒንጎ ቤዞ ሙኪ ዬኖ ቤዞዋ ጌኤሾንጎ፤ ዒማና ጌሜና ዋኣራሢናኮ ሱጉፃፓ ዻካ ዻካ ዔኪ ሚቺ ዒንጎ ቤዞኮ ዖይዶ ዛላ ዓኣ፥ ዻንኮ ቲሽኮንጎ፤ <verse eid="LEV 16:18"/><verse number="19" style="v" sid="LEV 16:19"/>ዒስራዔኤሌ ዴሮኮ ዻቢንቶና ጎሞናይዳፓ ታኣም ዒንጎ ባኮ ሺኢሾ ቤዞ ጌኤሺ፥ ዱማሳኒ ሱጉፆይዳፓ ኬኤላና ዔኪ ዔኪ ላንካይ ማይንቲ ዒኢካ ዉፁርቆንጎ።»<verse eid="LEV 16:19"/></para>
  <para style="s1">ዴሮኮ ጎሞ ዔኪ ዓሲ ናንጉዋ ዳውሎ ዳኪንታ ዋኣራሢ</para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 16:20"/>«ዬካፓ ዓኣሮኔ ዑሣ ዓኣዼ ዱማዼ ቤዞ፥ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮንታ ፆኦሲም ዒንጎ ባኮ ሺኢሾ ቤዞ ጌኤሺፆ ዳምቦ ኩንሤስካፓ ዓሲ ናንጉዋ ዳውሎ ዳኪንታኒ ዶኦሪንቴ ዋኣራሢ ናንጊና ናንጋ ጎዳ ቤርቶ ሺኢሾንጎ። <verse eid="LEV 16:20"/><verse number="21" style="v" sid="LEV 16:21"/>ዬያይዴስካፓ ፔኤኮ ላምዖ ኩጮ ዋኣራሢ ቶኦካ ጌሢ ዒስራዔኤሌ ዴሮኮ ዻቢንታ፥ ጎማ፥ ፑርቱሞንታ ቢያ ዬያ ዋኣራሢ ዑፃ ማዓንዳጉዲ ቡኡፂ፤ ዬያ ዋኣራሢ ዬኖ ማዾ ማዻንዳጉዲ ጌይንቴ ዓሢ ዓሲ ናንጉዋ ዳውሎ ዔኪ ዓኣዻንዳጉዲ ዳኮንጎ፤ <verse eid="LEV 16:21"/><verse number="22" style="v" sid="LEV 16:22"/>ዬይ ዋኣራሢ ዔያቶኮ ጎሞ ቢያ ዔኪ ዓሲ ናንጉዋ ዳውሎ ጉሮ ቦኦላ ዳኪንታኔ ጌይሢኬ፤ ዬይ ዓሢ ዋኣራሢ ዔኪ ዴንዲ ቦኦሎ ጉራ ዳኪ ሃሾንጎ።<verse eid="LEV 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 16:23"/>«ዬካፓ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ዓኣሮኔ ጌሊ ዎንዴ ዑሣ ዓኣዼ ዱማዼ ቤዞ ጌላኒ ጋዓዖ ማኣዔ ማኣዓሢ ኬሲ ዒኢካ ሃሾንጎ፤ <note caller="-" style="x"><char style="xo" closed="false">16፡23 </char><char style="xt" closed="false"><ref loc="EZK 44:19">ሂዚ. 44፡19</ref>።</char></note> <verse eid="LEV 16:23"/><verse number="24" style="v" sid="LEV 16:24"/>ታኣም ዱማዼ ቤዞይዳ ዑፆ ፔኤኮ ማስቲ፥ ቢያ ዎዴ ዒ ማኣዓ ማኣዓሢያ ማይንቶንጎ፤ ዬካፓ ኬስኪ ፔ ጎሞና ዴሮ ጎሞ ጌኤሻኒ ሚቺ ዒንጎ ዒንጊፆ ሺኢሾንጎ። <verse eid="LEV 16:24"/><verse number="25" style="v" sid="LEV 16:25"/>ጎሞ ጌኤሻኒ ዒንጊንቴ ቆልሞኮ ማሎ ሚቺ ዒንጎ ቤዞይዳ ሚቾንጎ፤ <verse eid="LEV 16:25"/><verse number="26" style="v" sid="LEV 16:26"/>ቦኦሎ ዳኪንቴ ዋኣራሢ ዔኪ ዓኣዼ ዓሢ ጉርዶ ጌላንዳሢኮ ቤርታ ማኣዓሢ ፔኤኮ ማስኪ፥ ዑፆዋ ፔኤኮ ማስቶንጎ፤ <verse eid="LEV 16:26"/><verse number="27" style="v" sid="LEV 16:27"/>ጎሞ ጌኤሻኒ ቲቂ ሱጉፆ ዔኮና ቆልሞንሢ ጉርዳፓ ዙሎ ኬሲ ታሚና ሚቺንቶንጎ፤ ዔያቶኮ ዒልዓ፥ ዓሽካ፥ ጎጶ ባኮንታ ሶኦካኣ ቢያ ዓቱዋዖ ሚቺንቶንጎ። <note caller="-" style="x"><char style="xo" closed="false">16፡27 </char><char style="xt" closed="false"><ref loc="HEB 13:11">ዔብ. 13፡11</ref>።</char></note> <verse eid="LEV 16:27"/><verse number="28" style="v" sid="LEV 16:28"/>ዬያ ሚቼ ዓሢ ማዒ ጉርዶ ጌላንዳሢኮ ቤርታ ፔኤኮ ማኣዓሢ ማስኪ ዑፆዋ ማስቶንጎ።»<verse eid="LEV 16:28"/></para>
  <para style="s1">ጎሜ ጌኤሺሢ ዳምቤ ኩንሥሢ ኬሊ</para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 16:29"/>«ሃካፓ ሊካ ኬኤዚንታ ዳምቦንሢ ኬስካ ዎዶ ቢያይዳ ማዺ ኩንሢ ካፑዋቴ፤ ላንካሳ ዓጊኖኮ ታጳሳ ኬሎና ዒስራዔኤሌ ዓሶንታ ዔያቶና ዎላ ናንጋ ሜሌ ዓጮ ዓሳ ሙኡዚ ሃሺ ሺኢቃንዳያ ኮይሳኔ፤ ዬኖ ኬሎና ዓይጎ ማዾዋ ማዾፓ። <note caller="-" style="x"><char style="xo" closed="false">16፡29 </char><char style="xt" closed="false"><ref loc="LEV 23:26-32">ሌዊ. ዓኬ 23፡26-32</ref>፤ <ref loc="NUM 29:7-11">ፓይ. ማፃ 29፡7-11</ref>።</char></note> <verse eid="LEV 16:29"/><verse number="30" style="v" sid="LEV 16:30"/>ዬኖ ኬሎ ዎጎ ጎይፆና ጌኤሺፆ ዳምባ ዔያቶም ማዺንታንዳሢሮ ዎጎ ጎይፆና ናንጊና ናንጋ ጎዳ ቤርታ ዔያታ ዳምቦና ጌኤሽኬያ ማዓንዳኔ። <verse eid="LEV 16:30"/><verse number="31" style="v" sid="LEV 16:31"/>ዬና ሙዖ ሃሺንታዞና ማዾ ማዺንቱዋ ኬሌላ ታኣም ዱማዼያ ማዓንዳኔ፤ ዬንሢ ዳምቦንሢ ሙካ ዎዶ ቢያይዳ ካፒንቲ ናንጋያ ማዖንጎ። <verse eid="LEV 16:31"/><verse number="32" style="v" sid="LEV 16:32"/>ዓዶ ቤዞይዳ ቄኤሶ ቢያኮ ሱኡጋሢ ማዒ ዶኦሪንቴ ቄኤሳሢ፥ ዬያ ጌኤሺፆ ዳምቦ ኩንሦንጎ፤ ዒዚያ ሱኡፓሢና ኮሺንቴ ቄኤሶ ማኣዓሢ ማኣዒ፥ <verse eid="LEV 16:32"/><verse number="33" style="v" sid="LEV 16:33"/>ዑሣ ዓኣዼ ዱማዼ ቤዞ፥ ዓፒሎና ማዢንቴ ፆኦሲ ዴሮና ካኣማ ማኣሮ፥ ፆኦሲም ዒንጎ ባኮ ዒንጎ ቤዞንታ ቄኤሶንታ ዴሮዋ ቢያ ጌኤሺፆ ዳምቦ ማዺ ኩንሦንጎ። <verse eid="LEV 16:33"/><verse number="34" style="v" sid="LEV 16:34"/>ዬንሢ ዳምባ ሙካ ዎዶ ቢያይዳ ካፒንቲ ናንጋያ ማዖም፤ ዬይ ጌኤሺፆ ዳምባ ዴሮ ጎማፓ ቢያ ጌኤሻኒ ሌዔይዳ ፔቴና ማዺንታያ ማዖንጎ» ጌዔኔ።</para>
  <para style="p" vid="LEV 16:34">ናንጊና ናንጋ ጎዳ ዓይሤ ጎይፆማ ሙሴ ዔቦ ማዺ ኩንሤኔ።<verse eid="LEV 16:34"/></para>
  <chapter eid="LEV 16"/>
  <chapter number="17" style="c" sid="LEV 17"/>
  <para style="s1">ሱጉሢ ሙይንቱዋጉዲ ላኣጊንቲፆ</para>
  <para style="p">
    <verse number="1-2" style="v" sid="LEV 17:1-2"/>«ዓኣሮኔና ናኣቶናም፤ ሃሣ ዒስራዔኤሌ ዴሮ ጉቤሢም ሃካፓ ሊካ ዓኣ ዳምቦ ኬኤዛንዳጉዲ ናንጊና ናንጋ ጎዳ ሙሴ ዓይሤኔ፤ <verse eid="LEV 17:1-2"/><verse number="3-4" style="v" sid="LEV 17:3-4"/>ዒስራዔኤሌ ዓሲ ማዔ ዓይጎ ዓሲያ ማዖም ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ካራ ማዒባኣንቴ ሜሌ ቤስካ ባይ፥ ማራይ፤ ሃሣ ዋኣሪ ማዔቴያ ሹኪ ታኣም ዒንጎ ዒንጊሢ ማሂ ዒንጌቴ ዬይ ዎጎ ዻቤያ ማዓንዳኔ፤ ሱጉሢ ጉሪ ላኣሌያ ማዔሢሮ ታ ዴሮ ባኣካ ማዒ ዒ ፓይዲንታንዳያ ኮይሱዋሴ።<verse eid="LEV 17:3-4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 17:5"/>«ዬያሮ ዒስራዔኤሌ ዴራ ዓይጎ ቆልሞዋ ማዖም ቦኦሊዳ ጉሪ ሹኪሢ ሃሺ ታ ቤርቶ ዔኪ ሺኢሻንዳያ ኮይሳኔ፤ ዬያ ዒንጎ ባኮ ዔያታ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ካሮ ቄኤሳሢ ኮራ ዔኪ ሙኪ ፔቱሞና ዒንጎ ዒንጊሢ ማሂ ሹኮንጎ። <verse eid="LEV 17:5"/><verse number="6" style="v" sid="LEV 17:6"/>ዬካፓ ቄኤሳሢ ሱጉፆ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ካሮይዳ ዓኣ፥ ሚቺ ዒንጎ ቤዞኮ ጎኦቦ ቢያ ፑጮንጎ፤ ሃሣ ታና ዎዛሳ ሳውሞ ዓኣያ ማዓንዳጉዲ ማሎ ሚቾንጎ። <verse eid="LEV 17:6"/><verse number="7" style="v" sid="LEV 17:7"/>ዒስራዔኤሌ ዴራ ታና ዔያታ ጉሙርቃ ጉሙርቂፆፓ ዻቢሻያ ማዔ ፑርቶ ዓያኖም ቆልሞ ፔኤኮ ሹኪ፥ ታና ናንጊና ናንጋ ጎዳሢም ዓይሢንቲሢ ዒፃንዳያ ኮይሱዋሴ፤ ዬያ ዒስራዔኤሌ ዴራ ማዾንዶ ዳምቤ ማሂ ሙካ ዎዶ ቢያይዳ ካፖንጎ።<verse eid="LEV 17:7"/></para>
  <para style="p">
    <verse number="8-9" style="v" sid="LEV 17:8-9"/>«ዒስራዔኤሌ ዓሶ ባኣካፓ ዓይጎ ዓሲያ ማዖም ዔያቶ ባኣካ ናንጋ ሜሌ ዓጪ ዓሲያኣ ማዖም ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ካራቱዋንቴ ሜሌ ቤስካ ታኣም ሚቺ ዒንጎ ባኣዚ ማዔቴያ ሜሌ ዒንጊሢ ዒንጊ ጴዼቴ ዬይ ታ ዴሮ ባኣካ ማዒ ፓይዲንታንዳያ ኮይሱዋሴ።<verse eid="LEV 17:8-9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 17:10"/>«ዒስራዔኤሌ ዓሶይዳፓ ዓይጎ ዓሲያ ማዖም ዔያቶ ባኣካ ናንጋ ዓሲታቴያ ሱጉሢ ሙዓያ ማዔቴ ታኣኒ ሚርጌና ዒዛ ዒፃ ዓሲ ዒ ማዓንዳኔ፤ ታ ዴሮ ባኣካ ማሂ ታ ዒዛ ፓይዳዓኬ። <note caller="-" style="x"><char style="xo" closed="false">17፡10 </char><char style="xt" closed="false"><ref loc="GEN 9:4">ማዢ. ማፃ 9፡4</ref>፤ <ref loc="LEV 7:26-29">ሌዊ. ዓኬ 7፡26-29</ref>፤ <ref loc="LEV 19:26">19፡26</ref>፤ <ref loc="DEU 12:16">ላሚ. ዎማ 12፡16</ref>፤ <ref loc="DEU 23">23</ref>፤ <ref loc="DEU 15:23">15፡23</ref>።</char></note> <verse eid="LEV 17:10"/><verse number="11" style="v" sid="LEV 17:11"/>ዓይጎዋ ማዖም ሼምፓ ዓኣ ማዢንቶኮ ቢያ ሼምፓሢ ዓኣሢ ሱጉሢዳኬ፤ ዴሮኮ ጎሞ ጌኤሻንዳጉዲ ዒንጎ ባኮ ዒንጎ ቤዞኮ ጎኦቦይዳ ሱጉፃ ዋሂንቶም ታኣኒ ጌዔሢ ዬያሮኬ፤ ሼምፓ ዓኣ ሱጉሢ ጎሜ ጌኤሻኒ ዳንዳዓኔ። <note caller="-" style="x"><char style="xo" closed="false">17፡11 </char><char style="xt" closed="false"><ref loc="HEB 9:22">ዔብ. 9፡22</ref>።</char></note> <verse eid="LEV 17:11"/><verse number="12" style="v" sid="LEV 17:12"/>ዒስራዔኤሌ ዴሮ ማዔቴያ ዔያቶኮ ባኣካ ናንጋ ሜሌ ዓጮ ዓሳ ሱጉሢ ሙዑዋጉዲ ታኣኒ ላኣጌሢ ዬያሮኬ።<verse eid="LEV 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 17:13"/>«ዒስራዔኤሌ ዓሲ ማዔቴያ ዔያቶ ባኣካ ናንጋ ሜሌ ዓጪ ዓሲ ዎጎ ጎይፆና ሙይንታኒ ዳንዳዓ ቦዖታቴያ ካፒ ኬሚ ዎዼቴ ሹኪ ሱጉፆ ሳዓ ላኣላዖ ዓጪና ሱጉፆ ሲንሦንጎ፤ <verse eid="LEV 17:13"/><verse number="14" style="v" sid="LEV 17:14"/>ፔቴ ፔቴ ሼምፓ ዓኣ ማዢንቶኮ ሼምፓሢ ዓኣሢ ሱጉፆይዳታሢሮ ዒስራዔኤሌ ዴራ ሱጉሢ ሙዑዋጉዲ ታ ላኣጌሢ ዬያሮኬ፤ ዬያ ሙዔ ዓይጎ ዓሲያ ታ ዓሶ ባኣካ ማዒ ፓይዲንታዓኬ።<verse eid="LEV 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 17:15"/>«ዒስራዔኤሌ ዓሲ ማዔቴያ ዔያቶ ባኣካ ናንጋ ሜሌ ዓጪ ዓሲያኣ ማዖም ሃይቄ ቆልሞታቴያ ቦዖ ዎዼ ቆልሞኮ ዓሽኪ ሙዔቶ ማኣዓሢ ፔኤኮ ማስኪ ዑፆዋ ማስቲ ዴንዲ ሳዓ ዓማንዳያ ሄላንዳኣና ዒኢቴያ ማዖንጎ፤ ዬካፓ ዒ ዳምቦ ጎይፆና ጌኤሽኬያ ማዓንዳኔ፤ <verse eid="LEV 17:15"/><verse number="16" style="v" sid="LEV 17:16"/>ዒዚ ዬያይዲባኣያታቴ ጎሜ ማዼሢሮ ዒዛይዳ ሄላ ሜቶ ዒ ዔካንዳኔ» ጌዔኔ።<verse eid="LEV 17:16"/></para>
  <chapter eid="LEV 17"/>
  <chapter number="18" style="c" sid="LEV 18"/>
  <para style="p">
    <verse number="1" style="v" sid="LEV 18:1"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 18:1"/><verse number="2" style="v" sid="LEV 18:2"/>«ዒስራዔኤሌ ዴሮም ሂዚ ጌዔ፤ ‹ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢኬ፤ <verse eid="LEV 18:2"/><verse number="3" style="v" sid="LEV 18:3"/>ቤርታ ዒንሢ ናንጌ፥ ጊብፄ ዓጮ ዓሳ ማዻ ጎይፆ ማዺፖቴ፤ ሃሣ ታ ዒንሢ ጌልዛኒ ዔኪ ዓኣዻ፥ ካኣናኔ ዓጮ ዓሳ ማዻ ጎይፆ ጊኢጉዋ ማዾ ማዺፖቴ፤ <verse eid="LEV 18:3"/><verse number="4" style="v" sid="LEV 18:4"/>ታኣኮ ዎጎ ቢያ ካፑዋቴ፤ ታ ዓይሢፆዋ ኩንሡዋቴ፤ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢኬ። <verse eid="LEV 18:4"/><verse number="5" style="v" sid="LEV 18:5"/>ታኣኒ ዒንሢም ዒንጋ ዳምቦና ዎጎና ጎይፆ ማዹዋቴ፤ ዬያይዴቴ ዒንሢ ሼምፓሢ ዒንሢኮ ዓውሳንዳኔ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ› » ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">18፡5 </char><char style="xt" closed="false"><ref loc="NEH 9:29">ኔሄ. 9፡29</ref>፤ <ref loc="EZK 18:9">ሂዚ. 18፡9</ref>፤ <ref loc="EZK 20:11-13">20፡11-13</ref>፤ <ref loc="LUK 10:28">ሉቃ. 10፡28</ref>፤ <ref loc="ROM 10:5">ሮሜ 10፡5</ref>፤ <ref loc="GAL 3:12">ጋላ. 3፡12</ref>።</char></note><verse eid="LEV 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 18:6"/>ናንጊና ናንጋ ጎዳ ኬኤዛዖ፦ «ዒንሢዳፓ ዖና ማዔቴያ ዒጊኒና ላሃንዳያ ኮይሱዋሴ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ። <verse eid="LEV 18:6"/><verse number="7" style="v" sid="LEV 18:7"/>ኔ ዒንዶና ላሂ ኔ ዓዶ ቦርሲሲፖ፤ ኔ ዒንዶዋ ዻውሲሲፖ። <verse eid="LEV 18:7"/><verse number="8" style="v" sid="LEV 18:8"/>ኔኤኮ ዒንዶ ሌጎንሢናኣ ላሂ ኔ ዓዶ ቦርሲሲፖ፤ <verse eid="LEV 18:8"/><verse number="9" style="v" sid="LEV 18:9"/>ኔ ጌሮናኣ ላሂፖ፤ ሃሣ ኔኤና ዎላ ዲጬ፥ ኔ ዒንዳ ሜሌ ዓሲፓ ሾዔያ ማዔቴያ ኔ ዓዴ ሜሌ ዓሲፓ ሾዔያ ማዔ ኔ ጌሮና ላሂፖ። <note caller="-" style="x"><char style="xo" closed="false">18፡9 </char><char style="xt" closed="false"><ref loc="LEV 20:17">ሌዊ. ዓኬ 20፡17</ref>፤ <ref loc="DEU 27:22">ላሚ. ዎማ 27፡22</ref>።</char></note> <verse eid="LEV 18:9"/><verse number="10" style="v" sid="LEV 18:10"/>ዻውሲንቲ ኔኤኮ ማዑዋጉዲ ኔኤኮ ናኣዚ ናዎና ላሂፖ፤ ሃሣ ኔ ናዎኮ ናዖና ማዔቴያ ላሂፖ። <verse eid="LEV 18:10"/><verse number="11" style="v" sid="LEV 18:11"/>ኔ ዒንዶ ሌጋ ሾዔ ዉዱሮ ናይ ኔኤኮ ጌሮታሢሮ ዒዞና ላሂፖ። <verse eid="LEV 18:11"/><verse number="12-13" style="v" sid="LEV 18:12-13"/>ኔኤኮ ዓዶ ጌሮና ዒንዶ ጌሮና ኔ ዓዶና ኔ ዒንዶናኮ ዑኬ ዒጊኒ ማዔሢሮ ዬያቶናኣ ላሂፖ። <verse eid="LEV 18:12-13"/><verse number="14" style="v" sid="LEV 18:14"/>ኔ ዓዶ ዒሾ ማቾናታቴያ ኔ ዓዶ ጌኤዚ ማቻ ኔኤኮ ዒንዶ ማዔያታሢሮ ዔያቶና ላሂፖ። <note caller="-" style="x"><char style="xo" closed="false">18፡14 </char><char style="xt" closed="false"><ref loc="LEV 20:19-20">ሌዊ. ዓኬ 20፡19-20</ref>።</char></note> <verse eid="LEV 18:14"/><verse number="15" style="v" sid="LEV 18:15"/>ኔኤኮ ናኣዚ ማቾናኣ ላሂፖ። <note caller="-" style="x"><char style="xo" closed="false">18፡15 </char><char style="xt" closed="false"><ref loc="LEV 20:1">ሌዊ. ዓኬ 20፡1</ref>።</char></note> <verse eid="LEV 18:15"/><verse number="16" style="v" sid="LEV 18:16"/>ሃሣ ጌርሲ ማቾ ማዔ፥ ዎይሞናኣ ላሂፖ። <note caller="-" style="x"><char style="xo" closed="false">18፡16 </char><char style="xt" closed="false"><ref loc="LEV 20:21">ሌዊ. ዓኬ 20፡21</ref>።</char></note> <verse eid="LEV 18:16"/><verse number="17" style="v" sid="LEV 18:17"/>ኔ ዞኦስካ ዎላ ኮኦማ ላኣሊኮ ናዎ ማዔቴያ ዒዞኮ ናኣዚ ናኣ ኔኤና ዒጊንቴያታሢሮ ዔያቶና ላሂፖ። <note caller="-" style="x"><char style="xo" closed="false">18፡17 </char><char style="xt" closed="false"><ref loc="LEV 20:14">ሌዊ. ዓኬ 20፡14</ref>፤ <ref loc="DEU 27:23">ላሚ. ዎማ 27፡23</ref>።</char></note> <verse eid="LEV 18:17"/><verse number="18" style="v" sid="LEV 18:18"/>ማቻ ኔኤኮ ሳዛና ዓኣንቴ ኔኤኮ ማቾኮ ጌሮ ጊንፃኣ ማቾ ማሂ ዔኪፖ፤ ዒዞና ላሂያ ላሂፖ።<verse eid="LEV 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 18:19"/>«ሻቱሞ ሙኪ ዓኣ፥ ላኣሊና ላሂፖ፤ ዓይጎሮ ጌዔቴ ዎጎ ጎይፆና ዒዛ ዒኢቴያታሢሮኬ። <verse eid="LEV 18:19"/><verse number="20" style="v" sid="LEV 18:20"/>ሜሌ ዓሲኮ ላኣሊና ላሂ ኔና ዒኢሲፖ። <note caller="-" style="x"><char style="xo" closed="false">18፡20 </char><char style="xt" closed="false"><ref loc="LEV 20:10">ሌዊ. ዓኬ 20፡10</ref>።</char></note> <verse eid="LEV 18:20"/><verse number="21" style="v" sid="LEV 18:21"/>ናኣቶይዳፓ ኔኤኮ ዓይጎ ናይያ ማዖም ሞሎኬ ጌይንታ ፆኦዞም ሚቺ ዒንጎ ባኣዚ ማሂ ዒንጊ ኔ ፆኦሲኮ ሱንፆ ዒኢሲፖ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ። <note caller="-" style="x"><char style="xo" closed="false">18፡21 </char><char style="xt" closed="false"><ref loc="LEV 20:1-5">ሌዊ. ዓኬ 20፡1-5</ref>።</char></note> <verse eid="LEV 18:21"/><verse number="22" style="v" sid="LEV 18:22"/>ፆኦሲ ዒፃ ባኣዚታሢሮ ላኣሊና ላሃ ጎይፆ ዓቲንቄና ላሂፖ፤ <note caller="-" style="x"><char style="xo" closed="false">18፡22 </char><char style="xt" closed="false"><ref loc="LEV 20:13">ሌዊ. ዓኬ 20፡13</ref>።</char></note> <verse eid="LEV 18:22"/><verse number="23" style="v" sid="LEV 18:23"/>ዓይጎ ዓሲ ዓቲንቄታቴያ ላኣሊ ቆልሞና ላሆፓ፤ ዬያጉዴ ዻውሲሳ ባኣዚ ማዺፃ ዳምቦ ጎይፆና ዒኢቴያ ማሃኔ። <note caller="-" style="x"><char style="xo" closed="false">18፡23 </char><char style="xt" closed="false"><ref loc="EXO 22:19">ኬሲ. ማፃ 22፡19</ref>፤ <ref loc="LEV 20:15-16">ሌዊ. ዓኬ 20፡15-16</ref>፤ <ref loc="DEU 27:21">ላሚ. ዎማ 27፡21</ref>።</char></note><verse eid="LEV 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 18:24"/>«ዔያቶኮ ዓጮ ዔኪ ኔና ጌልዛኒ ታኣኒ ዳውሴ፥ ሜሌ ዴራ ፔና ዬያ ባኮና ዒኢሴያታሢሮ ኔኤኒ ዬያ ባካፓ ፔቴማታዎ ማዺ ኔና ዒኢሲፖ። <verse eid="LEV 18:24"/><verse number="25" style="v" sid="LEV 18:25"/>ዔያቶኮ ማዻ ሳዖ ዒኢቴያ ማሄሢሮ ታኣኒ ዬኖ ሳዖም ሜቶ ዓጌኔ፤ ዬያሮ ዬና ሳዓ ዒኢካ ናንጋ ዓሶ ፔ ዻንጋፓ ጩቴኔ። <verse eid="LEV 18:25"/><verse number="26-27" style="v" sid="LEV 18:26-27"/>ዔያታ ዬያ ፑርቶ ባኮ ቢያ ማዺፆና ሳዖ ዒኢሴኔ፤ ዒንሢ ጋዓንቴ ዬያ ባኮ ቢያ ማዺፖቴ፤ ዒስራዔኤሌ ዓሶዋ ማዖም ዒኢካ ናንጋ ሜሌ ዓሲ ማዔቴያ ቢያሢ ዬያ ዎጎና ዳምቦና ዒንሢ ካፓንዳያ ኮይሳኔ። <verse eid="LEV 18:26-27"/><verse number="28" style="v" sid="LEV 18:28"/>ዒንሢያ ዔያቶ ጎይፆ ሳዖ ዒኢሴያ ማዔቴ ዒንሢኮ ቤርታ ዓኣ ዓይሁዴ ማዒባኣ ዓሶ ሳዓ ፔ ዻንጋፓ ጩቴ ጎይፆ ዒንሢያ ጩታንዳኔ። <verse eid="LEV 18:28"/><verse number="29" style="v" sid="LEV 18:29"/>ዬንሢ ቦርሲሳ ባኮይዳፓ ፔቴማታዖ ማዻሢ ታኣኮ ዴሮ ባኣካ ማዒ ፓይዲንታኒ ኮይሱዋሴ።<verse eid="LEV 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 18:30"/>«ታኣኮ ዓይሢፆ ቢያ ኩንሡዋቴ፤ ዬያኮ ቤርታ ሳዔሎይዳ ናንጋ ዓሳ ማዻ ፑርቶ ማዾ ፔቴታዖ ማዺፖቴ፤ ዬያ ማዺሢና ዒንሢ ዒኢሲፖቴ፤ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢኬ» ጌዔኔ።<verse eid="LEV 18:30"/></para>
  <chapter eid="LEV 18"/>
  <chapter number="19" style="c" sid="LEV 19"/>
  <para style="s1">ዱማ ዱማ ዎጌ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 19:1"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 19:1"/><verse number="2" style="v" sid="LEV 19:2"/>«ዒስራዔኤሌ ዴሮም ሂዚ ጌዔ፤ ‹ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢ ዱማዼያታሢሮ ዒንሢያ ታኣም ዱማዼያ ማዑዋቴ፤ <note caller="-" style="x"><char style="xo" closed="false">19፡2 </char><char style="xt" closed="false"><ref loc="LEV 11:44-45">ሌዊ. ዓኬ 11፡44-45</ref>፤ <ref loc="1PE 1:16">1ጴፂ. 1፡16</ref>።</char></note> <verse eid="LEV 19:2"/><verse number="3" style="v" sid="LEV 19:3"/>ዒንሢ ፔቴ ፔቴሢ ዒንሢኮ ዓዶና ዒንዶና ቦንቹዋቴ፤ ታኣኒ ሃውሾንጎ ጌዔ ኬሎ ካፒ ቦንቹዋቴ፤ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢኬ።› <note caller="-" style="x"><char style="xo" closed="false">19፡3 </char><char style="xt" closed="false"><ref loc="EXO 20:8">ኬሲ. ማፃ 20፡8</ref>፤ <ref loc="EXO 12">12</ref>፤ <ref loc="DEU 5:12">ላሚ. ዎማ 5፡12</ref>፤ <ref loc="DEU 16">16</ref>።</char></note><verse eid="LEV 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 19:4"/>«ታና ሃሺ ሜሌ ፆኦዞ ካኣሽኪፖቴ፤ ዓንጊና ኮሾና ካኣሽኮ ባኣዚያ ማዢ ካኣሽኪፖቴ፤ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢኬ። <note caller="-" style="x"><char style="xo" closed="false">19፡4 </char><char style="xt" closed="false"><ref loc="LEV 20:15-16">ሌዊ. ዓኬ 20፡15-16</ref>፤ <ref loc="DEU 5:19-20">ላሚ. ዎማ 5፡19-20</ref>።</char></note><verse eid="LEV 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 19:5"/>«ፔቱሞና ዒንጊንታ ዒንጊፆ ታኣም ዒንሢ ዒንጋ ዎዶና ዒንሢኮ ዒንጊፆ ታ ዔካያ ማዓንዳጉዲ ማሂ ሺኢሹዋቴ። <verse eid="LEV 19:5"/><verse number="6" style="v" sid="LEV 19:6"/>ሹኪንቴ ዓሽካ ሹኪንቴ ዓቦ፥ ሃንጎ ዚሮ ጉቴ ሙይንታንዳያ ኮይሳኔ፤ ሃይሣሳ ኬሊ ሄላንዳኣና ዓቲ ዴዔቴ ዓሽካ ታሚና ሚቺንቶንጎ፤ <verse eid="LEV 19:6"/><verse number="7" style="v" sid="LEV 19:7"/>ሃይሣሳ ኬሎና ሙይንቴቴ ዬይ ዒኢቴያኬ፤ ዬያ ታ ዔካ ዒንጊሢቱዋሴ። <verse eid="LEV 19:7"/><verse number="8" style="v" sid="LEV 19:8"/>ዬያ ሙዔ ዓሢ ታኣም ዱማዼ ባኮ ሼሌዔ ባኣዚ ማሂ ዛጌሢሮ ዻቢንቲ ዒዛኮ ማዓንዳኔ፤ ዬይ ዓሢ ታ ዴሮ ባኣካ ማዒ ፓይዲንታዓኬ።<verse eid="LEV 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 19:9"/>«ዒንሢ ዒንሢኮ ማኣሎ ቡራ ዎዶና ጎዦኮ ዓጮ ዛሎይዳ ዓኣ ሃኣኮ ዔኪፖቴ፤ ቶሊ ዓቴ ሃኣኮዋ ጊንሣ ማዒ ዚንጊፖቴ፤ <verse eid="LEV 19:9"/><verse number="10" style="v" sid="LEV 19:10"/>ዎይና ካፄም ኔ ማንፃ ዎዶና ዓቴ ዓኣፖንታ ሳዓ ዲኢኔሢንታ ላሚ ጊንሣ ሺሪ ማንፂፖ፤ ዬያ ቢያ ማንቆ ዓሶና ሜሌ ዓጪፓ ሙኬ ዓሶናም ሃሼ፤ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢኬ።<verse eid="LEV 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 19:11"/>«ዉኡቂፖቴ፤ ዓሲ ጌሺፖቴ፤ ሉኡቂፖቴ። <verse eid="LEV 19:11"/><verse number="12" style="v" sid="LEV 19:12"/>ኔኤኒ ማዻኑዋ ባኣዚ ታ ሱንፆና ጫኣቂፖቴ፤ ዒንሢ ዬያይዳያ ማዔቴ ዒንሢኮ ፆኦዛሢ ሱንፆ ዒንሢ ዒኢሳኔ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ። <note caller="-" style="x"><char style="xo" closed="false">19፡12 </char><char style="xt" closed="false"><ref loc="EXO 20:7">ኬሲ. ማፃ 20፡7</ref>፤ <ref loc="DEU 5:11">ላሚ. ዎማ 5፡11</ref>፤ <ref loc="MAT 5:33">ማቲ. 5፡33</ref>።</char></note><verse eid="LEV 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 19:13"/>«ኔ ላጋሢም ፑርታ ማዺፖ፤ ሃሣ ዒዛኮ ዓኣ ባኣዚያ ቡሪ ዔኪፖ፤ ዬያጉዲ ሚኢሼ ዒንጊ ኔ ማዺሻ ዓሢኮ ሚኢሾ ፔቴ ዓቢያ ኔ ኮይላ ዎይሡዋዖ ቤዞና ዒዛም ጪጌ። <note caller="-" style="x"><char style="xo" closed="false">19፡13 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">ላሚ. ዎማ 24፡14-15</ref>።</char></note> <verse eid="LEV 19:13"/><verse number="14" style="v" sid="LEV 19:14"/>ዋይዚ ባይቄ ዓሲ ጫሽኪፖ፤ ዓኣፒ ባይቄ ዓሲኮ ቤርታ ዹቃንዳ ባኣዚ ጌሢፖ፤ ኔኤኮ ፆኦዛሢ ዒጊጬ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ። <note caller="-" style="x"><char style="xo" closed="false">19፡14 </char><char style="xt" closed="false"><ref loc="DEU 27:18">ላሚ. ዎማ 27፡18</ref>።</char></note><verse eid="LEV 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 19:15"/>«ዓሲም ጌስቲ ኔ ዎጋ ዎዶና ጉሙርቂንታያ ሃሣ ፒዜ ማዔ፤ ቢያሢም ሄኮ ዎጌ፤ ማንቃሢም ማንቃቶሮ ጌይ ዖርጎጫሢ ዖርጎቹሞሮ ጌይ ዱማሲ ዎጊፖ። <note caller="-" style="x"><char style="xo" closed="false">19፡15 </char><char style="xt" closed="false"><ref loc="EXO 23:6-8">ኬሲ. ማፃ 23፡6-8</ref>፤ <ref loc="DEU 16:19">ላሚ. ዎማ 16፡19</ref>።</char></note> <verse eid="LEV 19:15"/><verse number="16" style="v" sid="LEV 19:16"/>ዓሲ ባኣካ ሃንቲ ሃንቲ ዓሲ ዾንኪ ሺሪፖ፤ ሃሣ ዓሲኮ ሼምፖ ባይዛኒ ዳንዳዓ ባኣዚያ ማዺ ሺሪፖ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ።<verse eid="LEV 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 19:17"/>«ኔኤኮ ጌርሲ ዒኔና ዒፂፖ፤ ዒ ዻቤ ባኣዚ ዓኣቴ ኔኤኮዋ ዬይ ዻቢንቲ ማዑዋጉዲ ፔጌና ጎሪ ዒዛ ዞሬ። <note caller="-" style="x"><char style="xo" closed="false">19፡17 </char><char style="xt" closed="false"><ref loc="MAT 18:15">ማቲ. 18፡15</ref>።</char></note> <verse eid="LEV 19:17"/><verse number="18" style="v" sid="LEV 19:18"/>ኔ ዓሶ ዓዳ ኔና ማሂ ናሽኬ፤ ኮሜ ኮፂፖ፤ ሃሣ ኮሜ ዓርቂያኣ ዴዒፖ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ። <note caller="-" style="x"><char style="xo" closed="false">19፡18 </char><char style="xt" closed="false"><ref loc="MAT 5:43">ማቲ. 5፡43</ref>፤ <ref loc="MAT 19:19">19፡19</ref>፤ <ref loc="MAT 22:39">22፡39</ref>፤ <ref loc="MRK 12:31">ማር. 12፡31</ref>፤ <ref loc="LUK 10:27">ሉቃ. 10፡27</ref>፤ <ref loc="ROM 13:9">ሮሜ 13፡9</ref>፤ <ref loc="GAL 5:14">ጋላ. 5፡14</ref>፤ <ref loc="JAS 2:8">ያይ. 2፡8</ref>።</char></note><verse eid="LEV 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 19:19"/>«ታኣኮ ዳምቦ ካፑዋቴ፥ ዱማ ዱማ ቶኦኪ ማዔ ቆልሞ ሾዓንዳጉዲ ዎላ ካንሢ ቤኤሊሲ፥ ሃሣ ዓኪሲሲፖ፤ ጎሺዳ ላምዖ ቶኦኪ ማዓ ሃኣኮ ዜርቂፖ፤ ሃሣ ላምዖ ባኣዚ ዎላ ካንሢ ሱኪ ዹይሶና ማኣዖዋ ማይንቲፖ። <note caller="-" style="x"><char style="xo" closed="false">19፡19 </char><char style="xt" closed="false"><ref loc="DEU 22:9-11">ላሚ. ዎማ 22፡9-11</ref>።</char></note><verse eid="LEV 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 19:20"/>«ፔቴ ዓሲ ፔኤም ማዻ ዉዱሮ ናይ ሜሌ ዓሲም ጊኢጊሼስካፓ ናዔሎ ዔካሢ ሚኢሾ ጪጊ ዱኡዙዋንቴ ዒንጋ ዓሢ ዉዱሮ ናዔሎና ላሄቴ ላምዖንሢ ዎጎ ዻቤያ ማዒ ዖኦጪንታንዳኔ፤ ጋዓንቴ ዒዛ ዓሢ ማኣራፓ ጋፒ ኬስኪባኣሢሮ ዎዺ ዔያቶ ዎዻኒ ዳንዳዑዋሴ። <verse eid="LEV 19:20"/><verse number="21" style="v" sid="LEV 19:21"/>ዬይ ዓሢ ዻቢንቲ ዛላ ዒንጊንታ ዒንጊሢ ማዓ፥ ፔቴ ዓዴ ማራይ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ካሮ ታ ቤርቶ ዔኪ ሙኮንጎ። <verse eid="LEV 19:21"/><verse number="22" style="v" sid="LEV 19:22"/>ዬካፓ ቄኤሳሢ ዬያ ዓሢኮ ጎሞ ጌኤሻኒ ዒንጎ ዒንጊፆ ዳምቦ ጎይፆና ዒንጊ ጌኤሺፆ ዳምቦ ኩንሦንጎ፤ ጎማኣ ዒዛኮ ዓቶም ጌይንታንዳኔ።<verse eid="LEV 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 19:23"/>«ካኣናኔ ዓጮ ጌላዖ ዓይጎዋ ማዖም ዓኣፒ ዓኣፓ ሚሢ ዒንሢ ቱኬ ዎዶና ሚፆኮ ዓኣፓ ዴንዲ ሃይሦ ሌዔ ሄላንዳኣና ሙይንቱዋጉዲ ላኣጊንቴሢሮ ሙይፖቴ። <verse eid="LEV 19:23"/><verse number="24" style="v" sid="LEV 19:24"/>ዖይዳሳ ሌዖና ዓኣፔ ዓኣፖ ታና ዒንሢ ጋላታንዳ፥ ታኣም ዒንጊንታ ዱማዼ ዒንጊሢ ማዖንጎ። <verse eid="LEV 19:24"/><verse number="25" style="v" sid="LEV 19:25"/>ዶንጋሳ ሌዖና ጋዓንቴ ሚፆኮ ዓኣፖ ሙዑዋቴ፤ ዒንሢ ዬያይዴቴ ሚፃ ዒንሢኮ ቢያ ዎዴ ዓኣፓንዳኔ፤ ታኣኒ ናንጊና ናንጋ ጎዳ ዒንሢኮ ፆኦሲኬ።<verse eid="LEV 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 19:26"/>«ሱጉሢ ዓኣ ዓሽኪ ሙይፖቴ፤ ዦዋቶታቴያ ማርሻኣ ማርሺፖቴ። <note caller="-" style="x"><char style="xo" closed="false">19፡26 </char><char style="xt" closed="false"><ref loc="GEN 9:4">ማዢ. ማፃ 9፡4</ref>፤ <ref loc="LEV 7:26-27">ሌዊ. ዓኬ 7፡26-27</ref>፤ <ref loc="LEV 17:10-14">17፡10-14</ref>፤ <ref loc="DEU 12:16">ላሚ. ዎማ 12፡16</ref>፤ <ref loc="DEU 23">23</ref>፤ <ref loc="DEU 15:23">15፡23</ref>፤ <ref loc="DEU 18:10">18፡10</ref>።</char></note> <verse eid="LEV 19:26"/><verse number="27" style="v" sid="LEV 19:27"/>ቶኦኮ ጋፓኖኮ ዴሞ ታይዚ ዛኣሪፖቴ፤ ቡኡጮዋ ዒንሢኮ ቃሚሢ ታይዚፖቴ፤ <verse eid="LEV 19:27"/><verse number="28" style="v" sid="LEV 19:28"/>ዑፃኣ ዒንሢኮ ኮንኮ ጫርጊፖቴ፤ ሃሣ ሃይቄ ዓሶሮዋ ዑፆ ዒንሢኮ ቲቂ ኪፃሲፖቴ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ። <note caller="-" style="x"><char style="xo" closed="false">19፡28 </char><char style="xt" closed="false"><ref loc="LEV 21:5">ሌዊ. ዓኬ 21፡5</ref>፤ <ref loc="DEU 14:1">ላሚ. ዎማ 14፡1</ref>።</char></note><verse eid="LEV 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 19:29"/>«ዓይሁዴ ማዒባኣ ዓሶኮ ካኣዦ ማኣራ ማዺንታሢጉዲ ዉዱሮ ናዖ ኔኤኮ ዬያ ማዺሺ ዒኢሲፖ፤ ኔኤኒ ዬያይዴቴ ሜሌ ካኣሺ ኔ ካኣሽካኔ ጌይሢኬ፤ ሳዓኣ ዒኢቴ ማዾና ኩሜያ ማዓንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">19፡29 </char><char style="xt" closed="false"><ref loc="DEU 23:17">ላሚ. ዎማ 23፡17</ref>።</char></note> <verse eid="LEV 19:29"/><verse number="30" style="v" sid="LEV 19:30"/>ታኣኒ ሃውሾንጎ ጌዔ ኬሎ ካፒ ቦንቹዋቴ፤ ታኣም ዱማዼ ማኣሮዋ ቦንቹዋቴ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ። <note caller="-" style="x"><char style="xo" closed="false">19፡30 </char><char style="xt" closed="false"><ref loc="LEV 26:2">ሌዊ. ዓኬ 26፡2</ref>።</char></note><verse eid="LEV 19:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 19:31"/>«ኔኤኒ ዒኢቱዋጉዲ ሶይናሢና ዦዎና ኮራ ዓኣዺፖ፤ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ኔ ፆኦዛሢኬ። <note caller="-" style="x"><char style="xo" closed="false">19፡31 </char><char style="xt" closed="false"><ref loc="DEU 18:11">ላሚ. ዎማ 18፡11</ref>፤ <ref loc="1SA 28:3">1ሳሙ. 28፡3</ref>፤ <ref loc="2KI 23:4">2ካኣቶ. ማ 23፡4</ref>፤ <ref loc="ISA 8:19">ዒሲ. 8፡19</ref>።</char></note><verse eid="LEV 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 19:32"/>«ጋርቼ ዓሲም ዴዔ ቤዛፓ ዔቂ፥ ቦንቼ፤ ታናኣ ዒጊጪ ቦንቼ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ።<verse eid="LEV 19:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 19:33"/>«ዒንሢ ኮይላ ናንጋ፥ ሜሌ ዓጪፓ ሙኬ ዓሲም ጌኔ ማዺፖቴ፤ <verse eid="LEV 19:33"/><verse number="34" style="v" sid="LEV 19:34"/>ዒንሢ ዓሶም ዒንሢ ማዻማጉዲ ኮሺ ባኣዚ ማዹዋቴ፤ ዓዳ ዒንሢ ማሂ ዔያቶ ናሽኩዋቴ፤ ሃያኮ ቤርታ ዒንሢ ጊብፄ ዓጮይዳ ሙኬ ዓሲ ማዒ ናንጌሢ ማሉዋቴ፤ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢኬ። <note caller="-" style="x"><char style="xo" closed="false">19፡34 </char><char style="xt" closed="false"><ref loc="EXO 22:21">ኬሲ. ማፃ 22፡21</ref>፤ <ref loc="DEU 24:17-18">ላሚ. ዎማ 24፡17-18</ref>፤ <ref loc="DEU 27:19">27፡19</ref>።</char></note><verse eid="LEV 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 19:35"/>«ዒንሢ ማካ ባኮና ማዖም ዒንሢ ሚፃ ባኮና ዓሲ ጌሺ ማዾ ባኣዚ ማዺፖቴ። <verse eid="LEV 19:35"/><verse number="36" style="v" sid="LEV 19:36"/>ዒንሢ ማካ ባኮና ሚፃ ባካ ጉሙርቂንታያ ሃሣ ጎኔ ባኣዚ ማዖንጎ፤ ጊብፄ ዓጫፓ ዒንሢ ዔኪ ኬሴሢ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢ ታናኬ። <note caller="-" style="x"><char style="xo" closed="false">19፡36 </char><char style="xt" closed="false"><ref loc="DEU 25:13-16">ላሚ. ዎማ 25፡13-16</ref>፤ <ref loc="PRO 20:10">ኮኦኪ. 20፡10</ref>።</char></note> <verse eid="LEV 19:36"/><verse number="37" style="v" sid="LEV 19:37"/>ዒንሢም ታኣኒ ዒንጌ ዳምቦንታ ዎጎንታ ማዺ ኩንሣያ ማዑዋቴ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ» ጌዔኔ።<verse eid="LEV 19:37"/></para>
  <chapter eid="LEV 19"/>
  <chapter number="20" style="c" sid="LEV 20"/>
  <para style="s1">ጎሜ ዛላና ሙካ ሜቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 20:1"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 20:1"/><verse number="2" style="v" sid="LEV 20:2"/>«ዒስራዔኤሌ ዴሮም ሂዚ ጌይ ኬኤዜ፤ ዒንሢ ባኣካፓ ማዔቴያ ዒንሢና ዎላ ናንጋ ሜሌ ዓይጎ ዓሲያ ማዖም ሞሎኬ ጌይንታ ፆኦዞም ፔኤኮ ናኣቶይዳፓ ፔቴ ሚቺ ዒንጎ ዒንጊሢ ማሂ ዒንጋ ዓሢ ዴራ ሹቻ ዹይ ዎዾንጎ፤ <verse eid="LEV 20:2"/><verse number="3" style="v" sid="LEV 20:3"/>ፔኤኮ ናዖ ሞሎኬም ዒንጊፆና ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ጌኤዦ ማኣሮ ዒኢሳያ ማዔቴ ሃሣ ታኣኮ ሱንፆዋ ጫሽኪሳያ ማዔቴ ዬያ ዓሢኮ ታኣኒ ሞርኬ ማዓንዳኔ፤ ታ ዴሮ ባኣካፓ ታ ዒዛ ባይዛንዳኔ። <verse eid="LEV 20:3"/><verse number="4" style="v" sid="LEV 20:4"/>ጋዓንቴ ዬይ ዓሢ ማዼ ባኮ ቢያ ዴራ ዻኪሲ ዛጊ ዎዹዋዖ ሃሼቴ፥ <verse eid="LEV 20:4"/><verse number="5" style="v" sid="LEV 20:5"/>ታኣኒ ታኣሮ ዬያ ዓሢና ዒዛኮ ማኣሮ ዓሶ ጉቤ፥ ሃሣ ታኣም ጉሙርቂንቱዋያ ማዒ ሞሎኬ ካሽኪ፥ ዒዛና ዎላ ፔቴ ማዓ ዓሶይዳ ቢያ፤ ዼኤፒ ሜቶ ታ ዔኪ ዬዓንዳኔ፤ ታ ዓሶ ባኣካፓኣ ታ ዔያቶ ባይዛንዳኔ።»<verse eid="LEV 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 20:6"/>«ዓይጎ ዓሲያ ማዖም ዓሶ ሙዓ ዓሶና ዦኦና ኮይላ ዔኤቢ ዖኦጫኒ ዓኣዼቴ ዼኤፒ ሜቶ ታ ዒዛይዳ ዔኪ ዬዓንዳኔ፤ ታኣኮ ዴሮ ባኣካፓኣ ታ ዒዛ ባይዛንዳኔ። <verse eid="LEV 20:6"/><verse number="7" style="v" sid="LEV 20:7"/>ዒንሢኮ ዑፆ ጉቤ ታኣም ዱማዼያ ማሁዋቴ፤ ዓይጎሮ ጌዔቴ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢታሢሮኬ። <verse eid="LEV 20:7"/><verse number="8" style="v" sid="LEV 20:8"/>ታኣኮ ዓይሢፆ ካፒ ማዻያ ማዑዋቴ፤ ዓይጎሮ ጌዔቴ ታኣኒ ዒንሢ ታኣም ዱማሳ፥ ናንጊና ናንጋ ጎዳኬ።»<verse eid="LEV 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 20:9"/>«ፔ ዓዶና ፔ ዒንዶናም ጋዳንቃ ዓሲ ሹቻ ዹይንቲ ሃይቆም፤ ዬያ ሃይቦይዳ ዒ ጌላሢ ፔ ዻቢንቶናኬ።» <note caller="-" style="x"><char style="xo" closed="false">20፡9 </char><char style="xt" closed="false"><ref loc="DEU 21:17">ላሚ. ዎማ 21፡17</ref>፤ <ref loc="MAT 15:4">ማቲ. 15፡4</ref>፤ <ref loc="MRK 7:10">ማር. 7፡10</ref>።</char></note><verse eid="LEV 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 20:10"/>«ፔቴ ዓሲ ዓሲ ማቾና ላሄቴ ዒዛንታ ዒዞንታ ሹቻ ዹይንቲ ሃይቆንጎ። <note caller="-" style="x"><char style="xo" closed="false">20፡10 </char><char style="xt" closed="false"><ref loc="EXO 20:14">ኬሲ. ማፃ 20፡14</ref>፤ <ref loc="LEV 18:20">ሌዊ. ዓኬ 18፡20</ref>፤ <ref loc="DEU 5:18">ላሚ. ዎማ 5፡18</ref>።</char></note> <verse eid="LEV 20:10"/><verse number="11" style="v" sid="LEV 20:11"/>ፔቴ ዓሲ ፔኤኮ ዒንዶ ሌጎና (ዒንዶና) ላሄቴ ዒዛንታ ዒዞንታ ሹጮና ዹይንቲ ሃይቆንጎ፤ ዬያይዲ ዔያታ ሃይቃሢ ዔያቶ ዻቢንቶናኬ። <verse eid="LEV 20:11"/><verse number="12" style="v" sid="LEV 20:12"/>ፔቴ ዓሲ ናኣዚ ማቾና ላሄቴ ላምዖንሢ ሹጮና ዹይንቲ ሃይቆንጎ፤ ዬያይዲፆና ዔያታ ፔኤኮ ዒጊንቶ ዒኢሴሢሮ ዔያታ ሃይቃሢ ፔ ዻቢንቶናኬ። <verse eid="LEV 20:12"/><verse number="13" style="v" sid="LEV 20:13"/>ፔቴ ዓሲ ዓቲንቄና ላሄቴ ላምዖንሢ ቦርሲሳ ባኣዚ ማዼሢሮ ላምዓሢ ሹጮና ዹይንቲ ሃይቆንጎ፤ <verse eid="LEV 20:13"/><verse number="14" style="v" sid="LEV 20:14"/>ዬያይዲ ዔያታ ሃይቃሢ ዔያቶ ዻቢንቶናኬ። ፔቴ ዓሲ ዒንዶንታ ናዎንታ ዎላ ዔኬያ ማዔቴ ዬያ ዒ ማዼ ዻውሲሳ ማዾሮ ሃይሣሢ ታሚና ሚቺንቲ ሃይቆንጎ፤ ዬያጉዴ ማዾ ዒንሢ ባኣካ ማዺንታኒ ኮይሳያቱዋሴ። <note caller="-" style="x"><char style="xo" closed="false">20፡14 </char><char style="xt" closed="false"><ref loc="LEV 18:17">ሌዊ. ዓኬ 18፡17</ref>፤ <ref loc="DEU 27:23">ላሚ. ዎማ 27፡23</ref>።</char></note> <verse eid="LEV 20:14"/><verse number="15" style="v" sid="LEV 20:15"/>ፔቴ ዓሲ ቆልሞ ዒኢሴቴ ዬያ ዓሢንታ ቆልሞማንታ ዎላ ሹጮና ዹይንቲ ሃይቆንጎ፤ <verse eid="LEV 20:15"/><verse number="16" style="v" sid="LEV 20:16"/>ፔቴ ላኣሊ ቆልሞና ዒኢቴያ ማዔቴ ዒዞንታ ቆልሞማንታ ዎላ ቢያ ሹጮና ዹይንቲ ሃይቆንጎ፤ ዔያታ ሃይቃሢያ ፔ ዻቢንቶናኬ። <note caller="-" style="x"><char style="xo" closed="false">20፡16 </char><char style="xt" closed="false"><ref loc="EXO 22:19">ኬሲ. ማፃ 22፡19</ref>፤ <ref loc="LEV 18:23">ሌዊ. ዓኬ 18፡23</ref>፤ <ref loc="DEU 27:21">ላሚ. ዎማ 27፡21</ref>።</char></note><verse eid="LEV 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 20:17"/>«ፔቴ ዓሲ ፔ ዓዶ ናይ፤ ጊንሣ ሃሣ ዒንዳ ሜሌ ቤስካፓ ሾዔ ጌሮ ዔኬያ ማዔቴ ዴሮ ቤርቶ ሺኢኪ፥ ዻውሲሳ ማዻ ዒዛኮ ዔርቴም ዴሮ ባኣካፓ ዴንዲ ባይቆም፤ ፔ ጌሮና ላሂ፥ ዻውሲንቴ ዻውሲንቶ ዒ ፔኤኮ ዳንዳዖም። <note caller="-" style="x"><char style="xo" closed="false">20፡17 </char><char style="xt" closed="false"><ref loc="LEV 18:9">ሌዊ. ዓኬ 18፡9</ref>፤ <ref loc="DEU 27:22">ላሚ. ዎማ 27፡22</ref>።</char></note> <verse eid="LEV 20:17"/><verse number="18" style="v" sid="LEV 20:18"/>ፔቴ ዓሲ ሻቱሞ ሙኪ ዓኣ ላኣሊና ላሄቴ ላምዖንሢ ዴሮ ባኣካፓ ዱማዺ ባይቆንጎ፤ ዓይጎሮ ጌዔቴ ዒኢቲፆ ዔርዛ ዎጎኮ ዔያታ ዑሣ ዓኣዼሢሮኬ። <note caller="-" style="x"><char style="xo" closed="false">20፡18 </char><char style="xt" closed="false"><ref loc="LEV 18:19">ሌዊ. ዓኬ 18፡19</ref>።</char></note><verse eid="LEV 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 20:19"/>«ፔቴ ዓሲ ዓዶ ጌሮና ማዖም ዒንዶ ጌሮና ላሄቴ ላምዖንሢ ዒጊኒታዖ ዬያ ማዼሢሮ ዬያ ዛሎ ዓጊንታ ሜቶ ዔያታ ዔካንዳኔ፤ <verse eid="LEV 20:19"/><verse number="20" style="v" sid="LEV 20:20"/>ፔቴ ዓሲ ዓዶ ዒሾ ማቾና ማዖም ዓዶ ጌኤዚ ማቾና፤ ሃሣ ዓቦ ማቾና ላሄያ ማዔቴ ዬያ ማዺፆና ዬኖ ዓሶ ዻውሲሴያ ማዔሢሮ ዬያ ዛሎ ዒጊንታ ሜቶ ዔያታ ዔካንዳኔ፤ ናይ ሾውዋዖዋ ዔያታ ሃይቃንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">20፡20 </char><char style="xt" closed="false"><ref loc="LEV 18:12-14">ሌዊ. ዓኬ 18፡12-14</ref>።</char></note> <verse eid="LEV 20:20"/><verse number="21" style="v" sid="LEV 20:21"/>ፔቴ ዓሲ ፔኤኮ ጌርሲ ማቾ ጌርሲ ሃይቁዋንቴ ዔኬቴ ዬይ ዓሢ ዒኢቴያ ማዓኔ፤ ሃሣ ጌርሲያ ዒ ዻውሲሴሢሮ ናይ ባኣያ ማዒ ዓታንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">20፡21 </char><char style="xt" closed="false"><ref loc="LEV 18:16">ሌዊ. ዓኬ 18፡16</ref>።</char></note><verse eid="LEV 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 20:22"/>«ዒንሢ ናንጋንዳጉዲ ታኣኒ ዒንሢ ጌልዛንዳ፥ ካኣናኔ ዓጫ ፔ ዻንጋፓ ዒንሢ ጩቱዋጉዲ ታኣኮ ዳምቦና ዎጎና ካፒ ማዻያ ማዑዋቴ፤ <verse eid="LEV 20:22"/><verse number="23" style="v" sid="LEV 20:23"/>ዒንሢኮ ቤርታፓ ታ ዳውሳንዳ፥ ዒኢካ ናንጋ ዓሳ ማዻ ባኮ ማዺፖቴ፤ ዔያታ ዬያ ባኮ ቢያ ማዻሢሮ ታ ዔያቶ ሻኣኪንቴኔ። <verse eid="LEV 20:23"/><verse number="24" style="v" sid="LEV 20:24"/>ዔኤዞና ዲኢቆና ኩሜ፥ ማሎ ዓጬሎ ዒንሢ ዻካልሳኒ ታኣኒ ጫኣቄኔ፤ ዒንሢ ዓጪያ ማሂ ታ ዒንሢም ዒንጋንዳኔ፤ ሜሌ ዴሮይዳፓ ዒንሢ ዱማሴሢ ታና፥ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢኬ። <verse eid="LEV 20:24"/><verse number="25" style="v" sid="LEV 20:25"/>ዬያሮ ሙይንታንዳ፥ ሻቲ ማዔሢንታ ማዒባኣ ቆልሞና ቦዖና ካፖዋ ዱማሲ ዔሩዋቴ፤ ሙይንታኑዋ ቄፄ ማዔ ቆልሞ፥ ካዮ ቦዖንታ ካፖንታ ሙይፖቴ፤ ዒኢቴ ባኣዚ ማዔሢ ታ ዒንሢም ኬኤዜሢሮ ዔያቶ ሙዔቴ ዒንሢ ዒኢታንዳኔ። <verse eid="LEV 20:25"/><verse number="26" style="v" sid="LEV 20:26"/>ዒንሢ ታኣም ዱማዼያ ማዑዋቴ፤ ዓይጎሮ ጌዔቴ ታኣኒ ዱማዼያኬ፤ ዒንሢ ታ ዴሬ ማዓንዳጉዲ ሜሌ ዴሮ ባኣካፓ ታ ዒንሢ ዶኦሬኔ።<verse eid="LEV 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 20:27"/>«ዓሶ ሙዓ ዓሶና ዦኦና ኮራ ዔኤቢ ዖኦጫኒ ዓኣዼ፥ ዓቲንቄ ማዔቴያ ላኣሊ ሹጮና ዹይንቲ ሃይቆንጎ፤ ዬይ ዓሳ ዬያይዲ ሃይቃሢ ፔ ዻቢንቶናኬ» ጌዔኔ።<verse eid="LEV 20:27"/></para>
  <chapter eid="LEV 20"/>
  <chapter number="21" style="c" sid="LEV 21"/>
  <para style="s1">ቄኤሶም ዓይሢንቴ ዳምቤ</para>
  <para style="p">
    <verse number="1-4" style="v" sid="LEV 21:1-4"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ «ዓኣሮኔ ፃጳፓ ማዔ ቄኤሶም ሂዚ ጌዔ፤ ቄኤሴ ማዔ ዓይጎ ዓሲያ ዒጊኒ ሃይቄ ዎዶና ዒንዶ፥ ዓዶ፥ ዓቲንቆ ናዖ፥ ዉዱሮ ናዖ፥ ጌርሲንታ ሌዒ ባኣዖ ጋራ ዓኣ ጌሮንታኮ ሌሲ ማዒባኣንቴ ዔፒ ዛላና ዒጊንቴ ዒጊኒኮ ሌሲ ካኣሚ ፔና ዒኢሶፓ።»<verse eid="LEV 21:1-4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 21:5"/>«ዓይጎ ቄኤሴ ማዔቴያ ሃይቄ ዓሲ ዛላ ሲዪ፥ ፔኤኮ ቶኦኮ ጉኡሎፓ፤ ቡኡጮዋ ቲቂ ቃሚሢ፥ ዑፆዋ ፔኤኮ ሙርቶፓ፤ <note caller="-" style="x"><char style="xo" closed="false">21፡5 </char><char style="xt" closed="false"><ref loc="LEV 19:27-28">ሌዊ. ዓኬ 19፡27-28</ref>፤ <ref loc="DEU 14:1">ላሚ. ዎማ 14፡1</ref>።</char></note> <verse eid="LEV 21:5"/><verse number="6" style="v" sid="LEV 21:6"/>ቄኤሴ ቢያ ታኣም ዱማዼያ ማዒ ሱንፆ ታኣኮ ጫሽኪሱዋያ ማዖንጎ፤ ሃሣ ዒዚ ታኣም ሙዖ ዒንጊፆ ዒንጋያ ማዔሢሮ ታኣም ዱማዼያ ማዓኔ። <verse eid="LEV 21:6"/><verse number="7" style="v" sid="LEV 21:7"/>ቄኤሴ ማዔ ዓሲ ካኣዦ ማኣሮይዳ ናንጋ ላኣሎ ማዔቴያ ዞኦዛ ኮኦማ ላኣሊ ማዔቴያ ሃሣ ዓንጂንቲ ኬስኬ ላኣሊ ዔኮፓ፤ ዓይጎሮ ጌዔቴ ቄኤሴ ቢያ ታኣም ዱማዼያ ማዓኒ ኮይሳሢሮኬ። <verse eid="LEV 21:7"/><verse number="8" style="v" sid="LEV 21:8"/>ቄኤሴ ታኣም ሙኡዚ ዒንጊሢ ዒንጋያታሢሮ ዴራ ታኣም ዱማዼያ ማሂ ዔያቶ ዛጎንጎ፤ ታኣኒ ዒንሢ ታኣም ዱማሳ፥ ናንጊና ናንጋ ጎዳሢ ዱማዼያታሢሮ ዔያታ ዒንሢ ቤርታ ታኣም ዱማዼያ ማዖንጎ። <verse eid="LEV 21:8"/><verse number="9" style="v" sid="LEV 21:9"/>ቄኤሴኮ ዉዱሮ ናይ ካኣዦ ማኣራ ናንጊ ዞኦስካ ኮኦማያ ማዔቴ ዓዶ ዒዛ ዻውሲሳሢሮ ታሚና ሚቺንቲ ሃይቆንጎ።»<verse eid="LEV 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 21:10"/>«ቄኤሶ ቢያኮ ሱኡጋሢ ዛይቶ ቲዦና ቲሽኪንቴያ፤ ቄኤሶ ማኣዓሢያኣ ማይንታንዳጉዲ ታኣም ዱማዼያ ማዔሢሮ ዓሲ ሃይቄ ዎዶና ሲዬ ዔርዛኒ ቶኦኮ ፔኤኮ ጉኡሊንቲ ማኣዓሢያ ዳርዞፓ፤ <verse eid="LEV 21:10"/><verse number="11-12" style="v" sid="LEV 21:11-12"/>ዒዚ ታኣም ዱማዼያታሢሮ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣራፓ ኬስኪ ዴንዲ፥ ሃሣ ዓዶኮ ማዔቴያ ዒንዶኮ ሌሲ ዓኣ ቤሲታቴያ ሜሌ ዓሲ ሌሲ ዓኣ ቤሲ ጌሊ ፔና ዒኢሶፓ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ። <verse eid="LEV 21:11-12"/><verse number="13" style="v" sid="LEV 21:13"/>ዬይ ቄኤሳሢ ኩሙሢ ዉዱሮ ናይ ዔኮንጎ፤ <verse eid="LEV 21:13"/><verse number="14" style="v" sid="LEV 21:14"/>ዓኒ ሃይቄ ላኣሊ፥ ዓንጂንቲ ኬስኬ ላኣሊታቴያ፤ ሃሣ ካኣዦ ማኣራ ናንጋ፥ ዞኦዛ ኮኦማ ላኣሊያ ዔኮፓ፤ ጋዓንቴ ፔ ዴሮ ባኣኮይዳፓ ኩሙሢ ዉዱሮ ናይ ዔኮንጎ። <verse eid="LEV 21:14"/><verse number="15" style="v" sid="LEV 21:15"/>ዬይ ያዺ ማዒባኣያታቴ ታኣም ዱማዼያ ማዓኒ ኮይሳ፥ ዒዛኮ ናኣታ ዳምቦ ጎይፆና ዒኢቴያ ማዓንዳኔ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ፤ ዒዛ ታኣም ዱማሳሢ ታናኬ» ጌዔኔ።<verse eid="LEV 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 21:16"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 21:16"/><verse number="17" style="v" sid="LEV 21:17"/>«ዓኣሮኔም ሂዚ ጌይ ኬኤዜ፤ ‹ኔ ፃጶይዳፓ ጉንዖ ማዔ ዓሲ ታኣም ሙኡዚ ዒንጊሢ ሺኢሺ ዒንጋኒ ኮይሱዋሴ፤ ዬይ ዳምባ ሙካ ዎዶ ቢያይዳ ካፒንቲ ናንጋያ ማዖንጎ፤ <verse eid="LEV 21:17"/><verse number="18" style="v" sid="LEV 21:18"/>ጉንዖ ማዔ ዓይጎ ዓሲያ ጌይፃ፦ ዓኣፒ ባይቄ ዓሲ፥ ዎቦ ማዔቴያ ሚዛጱዋ ዓሲ፥ <verse eid="LEV 21:18"/><verse number="19" style="v" sid="LEV 21:19"/>ኩቺ ማዔቴያ ቶኪ ዎቦ ዓሲ፥ <verse eid="LEV 21:19"/><verse number="20" style="v" sid="LEV 21:20"/>ጊኢሬ ዎቤ ዓሲታቴያ ቃሚሢ ዓሲ፥ ዓኣፒ ሃርጌ ዓኣ ዓሲ፥ ዱማ ዱማ ዑሢዳ ኬስካ ዶርዓ ዓርቄ ዓሲ፤ ሃሣ ዓሽቲሚ<note caller="+" style="f"><char style="fr" closed="false">21፡20 </char><char style="fq" closed="false">ዓሽቲሚ </char><char style="ft" closed="false">ዬኖ ቤዞይዳ ኬኤዚንቴሢ ዓሲ ዹይ ዓሽቲንሤ ዓቲንቄ ዛላኬ።</char></note> ሙኡዚ ዒንጊሢ ታኣም ሺኢሺ ዒንጋንዳያ ኮይሱዋሴ። <verse eid="LEV 21:20"/><verse number="21" style="v" sid="LEV 21:21"/>ቄኤሳሢ ዓኣሮኔ ፃጳፓ ጉንዖ ማዔ፥ ዓይጎ ዓሲያ ሙኡዚ ዒንጊሢ ታኣም ሺኢሺ ዒንጋኒ ዳንዳዑዋሴ። <verse eid="LEV 21:21"/><verse number="22" style="v" sid="LEV 21:22"/>ዬያጉዴ ዓሢ ታኣም ዱማዼ ሙዖና ዑሣ ዓኣዼ ታኣም ዱማዼያ ማዔ፥ ታኣም ሺኢሺንቴ ሙዖ ሙዓኒ ዳንዳዓኔ። <verse eid="LEV 21:22"/><verse number="23" style="v" sid="LEV 21:23"/>ጋዓንቴ ዒዛኮ ጉንዖ ማዔ ዑሢ ዓኣሢሮ ታኣም ዱማዼ ማኣሮ ዒኢሱዋጉዲ ታኣም ዱማዼ፥ ጎኦቦና ዓፒሎና ሚቺ ዒንጎ ቤዞና ባንሢ ዑኮፓ፤ ቄኤሶ ታኣም ዱማሴሢ ታና ናንጊና ናንጋ ጎዳኬ› » ጌዒ ኬኤዜኔ።<verse eid="LEV 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 21:24"/>ዬያ ባኮ ቢያ ዓኣሮኔና ናኣቶናም፤ ሃሣ ዒስራዔኤሌ ዴሮማኣ ቢያ ሙሴ ኬኤዜኔ።<verse eid="LEV 21:24"/></para>
  <chapter eid="LEV 21"/>
  <chapter number="22" style="c" sid="LEV 22"/>
  <para style="s1">ፆኦሲም ዱማዼ ዒንጊሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 22:1"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 22:1"/><verse number="2" style="v" sid="LEV 22:2"/>«ዓኣሮኔና ዒዛኮ ናኣቶናም ሂዚ ጌዔ፤ ታኣኮ ዱማዼ ሱንፆ ዒንሢ ጫሽኪሱዋጉዲ ዒስራዔኤሌ ዴራ ታኣም ዒንጋ ባኮ ቢያ ቦንቺ ዔኪጋፓ ታኣም ዱማዼያ ማሂ ካፑዋቴ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ። <verse eid="LEV 22:2"/><verse number="3" style="v" sid="LEV 22:3"/>ዒንሢ ፃጳፓታዖ ዒኢቴ ዓሲ ዒስራዔኤሌ ዴራ ታኣም ዱማሲ ዒንጌ ዒንጊፆ ባንሢ ጫርቂ ዑኬቴ፥ ታ ቤርታፓ ዬይ ባይቆንጎ፤ ዬይ ዳምባ ሙካ ዎዶ ቢያይዳ ካፒንቲ ናንጋያ ማዖንጎ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ።»<verse eid="LEV 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 22:4"/>«ዓኣሮኔ ፃጳፓ ማዔ ዓይጎ ዓሲታቴያ ዑስካ ኬስካ ዶርዓ ዓኣያ ማዔቴ፤ ሃሣ ሃርጌ ዛላና ዑስካፓ ዓልቃ ባኣዚ ዓኣ ዓሲ ዳምቦ ጎይፆና ጌኤሽካንዳያ ሄላንዳኣና ታኣም ዱማዼ ሙዖ ሙዖፓ፤ ዬያጉዲ ሃሣ ሌሲ ካኣሚ ዒኢቴ ባኣዚታቴያ ሾይዣ ዜርፃ ሾኦቴ ዓሲ ካኣሜቴ፥ <verse eid="LEV 22:4"/><verse number="5" style="v" sid="LEV 22:5"/>ዒኢሳያ ማዔ፥ ሳዓና ጎቺንቲ ሃንታ ባኮታቴያ ዒኢቴያ ማዔ ዓሲ ካኣሜቴ፥ <verse eid="LEV 22:5"/><verse number="6" style="v" sid="LEV 22:6"/>ዬያጉዴ ባኮ ቢያ ካኣሜ ቄኤሳሢ ዴንዲ ዒባኒ ሄላንዳኣና ዒኢቴያ ማዓንዳኔ፤ ዑፆ ዋኣሢና ማስቲባኣቴ፥ ታኣም ዱማዼ ዒንጊፆ ዒ ሙዖፓ። <verse eid="LEV 22:6"/><verse number="7" style="v" sid="LEV 22:7"/>ዓባ ጌሌስካፓ ዒ ጌኤሺ ማዓንዳሢሮ ታኣም ዱማዼ፥ ሃኣኮ ዒንጊፆ ዒዛሲ ዒ ሙዓኒ ዳንዳዓኔ፤ <verse eid="LEV 22:7"/><verse number="8" style="v" sid="LEV 22:8"/>ሃይቄያ፥ ሃሣ ቦዖ ዎዼ ባኣዚኮ ዓሽኪ ሙዖፓ፤ ዬያ ሙዔቴ ዒዛ ዒኢሳንዳኔ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ።»<verse eid="LEV 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 22:9"/>«ቄኤሳ ቢያ ታኣኒ ዔያቶም ዒንጌ ዳምቦ ካፖንጎ፤ ዬያ ዔያታ ካፒባኣቴ ጋዓንቴ ዓይሢንቲፆ ዒፂፃ ዻቢንቲ ዔያቶኮ ማዔም ዔያታ ሃይቃንዳኔ፤ ታኣኒ ዔያቶ ታኣም ዱማሳ፥ ናንጊና ናንጋ ጎዳኬ።<verse eid="LEV 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 22:10"/>«ታኣም ዱማዼ፥ ዒንጊንቴ ባኮ ሙዓኒ ዳንዳዓሢ ቄኤሳሢ ማኣሮ ዓሶ ሌሊኬ፤ ቄኤሳሢኮ ሾኦቺ ማዔቴያ ሚኢሼ ጪጊንቴም ዒዛም ማዻ ዓሲያ ሙዖፓ። <verse eid="LEV 22:10"/><verse number="11" style="v" sid="LEV 22:11"/>ጋዓንቴ ቄኤሳሢ ፔኤኮ ሚኢሼና ሻንቂ ዔኬያና ዒዛኮ ማኣራ ሾይንቴያ ማዔ፥ ዒዛም ማዻ ዓሳ ቄኤሳሢሮ ማዔ ሙዖ ሙዖንጎ። <verse eid="LEV 22:11"/><verse number="12" style="v" sid="LEV 22:12"/>ቄኤሴ ማዒባኣ ዓሲም ሌዔ፥ ቄኤሳሢኮ ናይ ታኣም ዱማዼ ሙዖ ሙዎፓ። <verse eid="LEV 22:12"/><verse number="13" style="v" sid="LEV 22:13"/>ጋዓንቴ ዬና ናዔላ ናይ ሾዑዋንቴ ዓኒ ሃይቄያ ማዔም ዓኒ ማኣራፓ ዓንጂንቲ ኬስኪ ዓዶ ኮይላ ሙኪ ናንጋ ቄኤሴ ናይታቴ ቤርታ ናይ ዓኣዖ ዒዛ ማዻሢጉዲ ዓዶ ዛሎ ማዔ፥ ታኣም ዱማዼ ሙዖ ሙዎንጎ፤ ዬያ ጎይፆና ታኣም ዱማዼ ባኮ ሙዓኒ ዳንዳዓ ዓሳ ቄኤሳሢ ማኣሮ ዓሶ ሌሊኬ።<verse eid="LEV 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 22:14"/>«ቄኤሴ ማኣሪ ዓሲ ማዒባኣ ዓይጎ ዓሲያ ማዖም ዔሩዋዖ ታኣም ዱማዼ ሙዖ ሙይ ጴዼቴ ዒንጊንቴ ባኮኮ ዶንጎ ኩቺፓ ፔቴ ማዓያ ጊዳ ቃሲ ቄኤሳሢም ማሆንጎ። <verse eid="LEV 22:14"/><verse number="15" style="v" sid="LEV 22:15"/>ዒስራዔኤሌ ዴራ ታኣም ዒንጋ፥ ዱማዼ ዒንጊፆ ቄኤሳ ዒኢሳንዳያ ኮይሱዋሴ፤ <verse eid="LEV 22:15"/><verse number="16" style="v" sid="LEV 22:16"/>ጌይፃ፦ ታኣም ዱማዼ ዒንጊፆ ሙዓኒ ኮይሱዋ ዓሲም ዒንጊ ዓሢ ሜቶይዳ ጌልዙዋጉዲኬ፤ ዒንጊፆ ቢያ ታኣም ዱማሳሢ ታና፥ ናንጊና ናንጋ ጎዳሢኬ» ጌዔኔ።<verse eid="LEV 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 22:17"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 22:17"/><verse number="18" style="v" sid="LEV 22:18"/>«ዓኣሮኔና ዒዛኮ ናኣቶና፤ ሃሣ ዒስራዔኤሌ ዴሮም ቢያ ሃይፓ ዴማ ዓኣ ዳምቦ ኬኤዜ፤ ዒስራዔኤሌ ዓሲ ማዔቴያ ዔያቶ ባኣካ ናንጋ ሜሌ ዓጪ ዓሲ ፆኦሲም ናኣቤ ናኣቢ ኩሜም፥ ሃሣ ፔ ሼኔና ታኣም ሚቺ ዒንጎንዶ ባኣዚ ዔኪ ሺኢሻያ ማዔቴ ዒንጊንታ ባካ ዓይጌያ ቦሂሳ ባኣዚ ባኣያ ማዖንጎ። <verse eid="LEV 22:18"/><verse number="19" style="v" sid="LEV 22:19"/>ዒዛኮ ዒንጊፆ ታ ዔካያ ማዓንዳጉዲ ዔኤቢ ቦሂሳ ባኣዚባኣያ ባይ፥ ማራይ፥ ዋኣሪ ማዔቴ ጌማይ ሃንጎ ዓዴ ዔኪ ሺኢሾንጎ፤ <verse eid="LEV 22:19"/><verse number="20" style="v" sid="LEV 22:20"/>ዔኤቢ ቦሂሳ ባኣዚ ዓኣ፥ ዓይጎ ቆልሞዋ ዒንሢ ታኣም ዒንጌቴ ዬያ ታ ዔካዓኬ። <note caller="-" style="x"><char style="xo" closed="false">22፡20 </char><char style="xt" closed="false"><ref loc="DEU 17:1">ላሚ. ዎማ 17፡1</ref>።</char></note> <verse eid="LEV 22:20"/><verse number="21" style="v" sid="LEV 22:21"/>ዓይጎ ዓሲኮዋ ናኣቤ ናኣባ ኩሜም፤ ሃሣ ፔ ሼኔና ዒንጎ ባኣዚ ፔቱሞና ዒንጎ ዒንጊሢ ማሂ ዒንጋቴ ታኣኒ ዬያ ዔካያ ማዓንዳጉዲ ቦሂሳ ባኣዚባኣያ ማዖንጎ። <verse eid="LEV 22:21"/><verse number="22" style="v" sid="LEV 22:22"/>ዓኣፒ ባይቄያ፥ ሜቄያ፥ ቶኪ ዱጴያ፤ ዬያጉዲ ሃሣ ጊኢሽካ ኪሢ ዓኣያ፥ ቃፃ ዓርቄያንታ ዑፃ ሜሌ ኪሢ ዓኣ ቆልሞ ታኣም ዒንጎ ዒንጊሢ ማሂ ዔኪ ሺኢሾፓ፤ ዬንሢጉዴ ቆልሞ ሚቺ ዒንጎ ቤዞይዳ ሙኡዚ ዒንጊሢ ማሂ ዒንጊፖ። <verse eid="LEV 22:22"/><verse number="23" style="v" sid="LEV 22:23"/>ባይታቴያ ማራይ ዎቦ ማዔ ቆልሞ ዓሲ ፔ ሼኔና ዒንጋ ዒንጊሢ ማሂ ዒንጋኒ ዳንዳዓኔ፤ ጋዓንቴ ናኣቢ ኩንሥሢ ማሂ ዬይ ዒንጊንታኒ ዳንዳዑዋሴ። <verse eid="LEV 22:23"/><verse number="24" style="v" sid="LEV 22:24"/>ፂኢቄ ዹይንቴ ቆልሞንታ ጌኒንቴ ቆልሞ ማዔቴያ ታኣም ዒንጎ ባኣዚ ማሂ ዔኪ ሺኢሺፖቴ፤ ዬያጉዴ ባኣዚ ዒንሢ ዓጫ ታኣም ሺኢሺ ዒንጊፖቴ።<verse eid="LEV 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 22:25"/>«ዬያጉዴ ቆልሞ ሜሌ ዓጪ ዓሲዳፓ ዔኪ ታኣም ሙኡዚ ዒንጊሢ ማሂ ዒንጊፖቴ፤ ዬያ ቆልሞኮ ቦሂሳ ባኣዚ ዓኣያታሢሮ ታኣኒ ዬያ ዒንጊፆ ዔካያቱዋሴ» ጌዔኔ።<verse eid="LEV 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 22:26"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 22:26"/><verse number="27" style="v" sid="LEV 22:27"/>«ናኣሪታቴያ ማራናይ፤ ሃሣ ዋናናይ ሾይንቴ ዎዶና ላንካይ ኬሊ ሄላንዳኣና ዒንዶና ዎላ ዴዖንጎ፤ ጋዓንቴ ሳላሳ ኬላፓ ዓርቃዖ ሙኡዚ ዒንጊሢ ማዒ ታኣም ዒንጊንታኒ ዳንዳዓኔ።<verse eid="LEV 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 22:28"/>«ሾዔ ባይ ናኣሮማና ዎላ፥ ማራይታቴያ ዋኣሪ ናዖና ዎላ ሚቺ ዒንጎ ዒንጊሢ ማሂ ፔቴ ኬሊዳ ሹኪፖ። <verse eid="LEV 22:28"/><verse number="29" style="v" sid="LEV 22:29"/>ጋላታ ዒንጊሢ ታኣም ዒንሢ ዒንጋ ዎዶና ዒንጊፆ ታ ዔካያ ማዓንዳ ጎይሢ ማሂ ሺኢሹዋቴ። <verse eid="LEV 22:29"/><verse number="30" style="v" sid="LEV 22:30"/>ዚሮ ሄላንዳኣና ዓይሱዋዖ ዒንጊንቴ ኬሎና ዓሽኮ ጋፒሲ ሙዑዋቴ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ።<verse eid="LEV 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 22:31"/>«ታኣኮ ዓይሢፆ ካፒ ማዻያ ማዑዋቴ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ። <verse eid="LEV 22:31"/><verse number="32" style="v" sid="LEV 22:32"/>ታኣኮ ዱማዼ ሱንፆ ጫሽኪሲፖቴ፤ ዒስራዔኤሌ ዴራ ቢያ ታኣኒ ዱማዼያታሢ ዔሪ ታና ቦንቾንጎ፤ ዒንሢ ታኣም ዱማሳሢ፥ ታና ናንጊና ናንጋ ጎዳኬ። <verse eid="LEV 22:32"/><verse number="33" style="v" sid="LEV 22:33"/>ታ ዒንሢኮ ፆኦሲ ማዓኒ ጊብፄ ዓጫፓ ዒንሢ ዔኪ ኬሴኔ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ» ጌዔኔ።<verse eid="LEV 22:33"/></para>
  <chapter eid="LEV 22"/>
  <chapter number="23" style="c" sid="LEV 23"/>
  <para style="s1">ካኣሺ ኬሊ ማሂ ቦንቺንታ ቦንቾ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 23:1"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 23:1"/><verse number="2" style="v" sid="LEV 23:2"/>«ዒስራዔኤሌ ዓሶም ሂዚ ጌዔ፤ ‹ፆኦሲ ካኣሽካኒ ቡኪንቶ ቦንቾ ኬሊ› ጌይ ዒንሢ ዱማሲ ቦንቻንዳ ኬላ ሃኣቶኬ፦ <verse eid="LEV 23:2"/><verse number="3" style="v" sid="LEV 23:3"/>ላሆ ኬሊ ማዾ ዒንሢኮ ማዹዋቴ፤ ላንካሳ ኬላ ጋዓንቴ ሃውሺ ቦንቾ ኬሊታሢ ዔሩዋቴ፤ ዬማ ኬሎ ታና ካኣሽካኒ ሌሊ ቡኪንቱዋቴ፥ ሜሌ ማዾ ማዺፖቴ፤ ዒንሢ ናንጋ ቤዞ ቢያይዳ ሃውሾ ኬላ ታኣም ዱማዼያኬ።» <note caller="-" style="x"><char style="xo" closed="false">23፡3 </char><char style="xt" closed="false"><ref loc="EXO 20:8-10">ኬሲ. ማፃ 20፡8-10</ref>፤ <ref loc="EXO 23:12">23፡12</ref>፤ <ref loc="EXO 31:15">31፡15</ref>፤ <ref loc="EXO 34:21">34፡21</ref>፤ <ref loc="EXO 35:2">35፡2</ref>፤ <ref loc="DEU 5:12-14">ላሚ. ዎማ 5፡12-14</ref>።</char></note><verse eid="LEV 23:3"/></para>
  <para style="s1">ዑሣ ዓኣዺፆ ቦንቾንታ ላኣዳ ሙዒ ቦንቾ ኬሎ</para>
  <para style="r">(<ref loc="NUM 28:16-25">ፓይ. ማፃ 28፡16-25</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 23:4"/>«ፔቴ ፔቴ ቦንቾ ኬላ ዔርቴም፤ ናንጊና ናንጋ ጎዳ ቤርታ ዒንሢ ቡኪ ቡኪ ቦንቻንዳ ዼኤፖ ዼኤፖ ኬሎንሢ ሃኣቶኬ፦ <verse eid="LEV 23:4"/><verse number="5" style="v" sid="LEV 23:5"/>ናንጊና ናንጋ ጎዳ ቦንቺንታንዳ፥ ዑሣ ዓኣዺፆ ኬላ ቦንቺንቶ ዓርቃሢ ቤርታሳ ዓጊኖኮ ታጶ ዖይዳሳ ኬሎ ዓባ ጌሊ ሳዓ ሃባርታዛኬ፤ <note caller="-" style="x"><char style="xo" closed="false">23፡5 </char><char style="xt" closed="false"><ref loc="EXO 12:1-13">ኬሲ. ማፃ 12፡1-13</ref>፤ <ref loc="DEU 16:1-2">ላሚ. ዎማ 16፡1-2</ref>።</char></note> <verse eid="LEV 23:5"/><verse number="6" style="v" sid="LEV 23:6"/>ታጶ ዶንጋሳ ኬሎ ላኣዶ ሙዒ ቦንቾ ኬላ ቦንቺንቶ ዓርቃኔ፤ ዬማፓ ዴንዲ ላንካይ ኬሊ ሄላንዳኣና ሙኑቃ ፃኣዛ ጌሊባኣ ላኣዳ ሙዑዋቴ። <verse eid="LEV 23:6"/><verse number="7" style="v" sid="LEV 23:7"/>ዬያቶ ኬሎኮ ቤርታሳ ኬሎ ታና ካኣሽካኒ ቡኪንቱዋቴ፤ ዒንሢ ማዾ ማዺፖቴ። <verse eid="LEV 23:7"/><verse number="8" style="v" sid="LEV 23:8"/>ላንካይ ኬሊ ሄላንዳኣና ሙዖ ዒንጊፆ ታኣም ሺኢሹዋቴ፤ ሳላሳ ኬሎና ዒንሢ ማዾ ሃሺ ታና ካኣሽካኒ ቡኩዋቴ» ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">23፡8 </char><char style="xt" closed="false"><ref loc="EXO 12:14-20">ኬሲ. ማፃ 12፡14-20</ref>፤ <ref loc="EXO 23:15">23፡15</ref>፤ <ref loc="EXO 34:18">34፡18</ref>፤ <ref loc="DEU 16:3-8">ላሚ. ዎማ 16፡3-8</ref>።</char></note><verse eid="LEV 23:8"/></para>
  <para style="s1">ቤርቲ ዒንጊሢ ቦንቾ ኬሊ</para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 23:9"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 23:9"/><verse number="10" style="v" sid="LEV 23:10"/>«ዒስራዔኤሌ ዴሮም ሂዚ ጌዔ፤ ታኣኒ ዒንሢም ዒንጋ ሳዔሎ ጌላዖ ጎሽኪ ማኣሎ ዒንሢ ቡራ ዎዶና ቤርታሳ ናኣሮ ቄኤሳሢም ዔኪ ዬይ ዒንጉዋቴ፤ <verse eid="LEV 23:10"/><verse number="11" style="v" sid="LEV 23:11"/>ዬካፓ ዬያ ታ ዔኬያ ማዓንዳጉዲ ቄኤሳሢ ናኣሮ ዡጊ ታኣም ዱማዼ ዒንጊሢ ማሂ ዒንጎንጎ፤ ዬያ ዒዚ ዒንጋኒ ኮይሳሢ ሃውሾ ኬሎኮ ዚሮ ጉቴ ማዖንጎ። <verse eid="LEV 23:11"/><verse number="12" style="v" sid="LEV 23:12"/>ዒንሢ ሃኣኮ ዒንጊፆ ዒንጋ ኬሎና ቦሂሳ ባኣዚባኣ፥ ፔቴ ሌዔ ማዔ ዓዴ ማራናይ ሚቺ ዒንጎ ዒንጊሢ ማሂ ሃኣኮና ዎላ ዔኪ ናንጊና ናንጋ ጎዳም ሺኢሹዋቴ። <verse eid="LEV 23:12"/><verse number="13" style="v" sid="LEV 23:13"/>ሃሣ ዬያና ዎላ ሪሚቶ ዛይቶና ዲርኪንቴ፥ ላምዖ ኪሎ ማዓ ሺኢቺ ዺኢሊ ሙኡዚ ዒንጊሢ ማሂ ዔኪ ሺኢሹዋቴ፤ ዬያኮ ሳዋ ታና ዎዛሳ ሚቺ ዒንጎ ዒንጊሢ ማዖንጎ፤ ሃሣ ፔቴ ዶሎዜ ማዓንዳ ዎይኔ ዑሺያ ዔኪ ሙኪ ዒንጉዋቴ። <verse eid="LEV 23:13"/><verse number="14" style="v" sid="LEV 23:14"/>ዬያ ዒንሢ ታኣም ዒንጋንዳሢኮ ቤርታ ዓኮ ሃኣኮኮ ቲሻሢ ዓኣዔ ማዔቴያ ሻኣቂ፤ ሃሣ ዎዺ ላኣዲያ ሙይፖቴ፤ ዬይ ዒንሢ ናንጋ ቤዞ ቢያይዳ ሙካ ሾይንታ ካፒ ናንጋ ዳምቤ ማዖንጎ።»<verse eid="LEV 23:14"/></para>
  <para style="s1">ሃኣኮ ቡሮ ዎዶና ቦንቾ ኬሊ</para>
  <para style="r">(<ref loc="NUM 28:26-31">ፓይ. ማፃ 28፡26-31</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 23:15"/>«ዡጊ ዒንጊንታ ዒንጊፃ ዒንጊንቴ ኬላፓ ሴካ ላንካይ ቃልሾ ኬሊ ፓይዱዋቴ። <verse eid="LEV 23:15"/><verse number="16" style="v" sid="LEV 23:16"/>ላንካሳ ቃልሾኮ ዶንጊታሚ ኬሊ ማዓ ዓቦና ላሚ ዬኖ ዓኮ ሃኣኮይዳፓ ሙኡዚ ዒንጊሢ ታኣም ዒንጉዋቴ፤ <verse eid="LEV 23:16"/><verse number="17" style="v" sid="LEV 23:17"/>ዒዞ ኬሎና ፔቴ ፔቴ ዓሳ ፔ ማኣራፓ ላምዖ ኪሎ ማዓ ዛይቴና ዲርኪንቴ ዺኢሊ፥ ሙኑቃ ፃኣዛ ዋሂ ላምዖ ኪሎ ማዓ ሺኢቺ ዺኢሊና ላኣዶና ላኣዳ ዡጊ ዒንጊንታ ዒንጊሢ ማሂ ዒንጎንጎ፤ ዬያ ሃኣኮኮ ቤርቶ ዒንጊፆ ማሂ ታኣም ዔኪ ሺኢሾንጎ። <verse eid="LEV 23:17"/><verse number="18" style="v" sid="LEV 23:18"/>ዬያ ካሦና ዎላ ቦሂሳ ባኣዚባኣ፥ ፔቴ ሌዔ ኩሜ ላንካይ ዓዴ ማራናይ፥ ፔቴ ጌማናይና ላምዖ ዓዴ ማራይ ዒስራዔኤሌ ዴራ ዔኪ ሺኢሾንጎ፤ ዬያታ ሃኣኮ ዒንጊፆና ዎይኖ ዑዦና ዎላ ሚቺ ዒንጎ ዒንጊሢ ማዒ ታኣም ዒንጊንቶንጎ፤ ዬያኮ ሳዋ ታና ዎዛሳያ ማዓንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">23፡18 </char><char style="xt" closed="false"><ref loc="EXO 23:16">ኬሲ. ማፃ 23፡16</ref>፤ <ref loc="EXO 34:22">34፡22</ref>፤ <ref loc="DEU 16:9-12">ላሚ. ዎማ 16፡9-12</ref>።</char></note> <verse eid="LEV 23:18"/><verse number="19" style="v" sid="LEV 23:19"/>ዬያጉዲ ሃሣ ጎሜ ጌኤሻ ዒንጊሢ ማዓ ፔቴ ኮላይ፥ ፔቴ ሌዔ ማዔ ላምዖ ዓዴ ማራናይ፤ ፔቱሞና ዒንጎ ዒንጊሢ ማሂ ሺኢሹዋቴ። <verse eid="LEV 23:19"/><verse number="20" style="v" sid="LEV 23:20"/>ዬካፓ ቄኤሳሢ ካሦንሢና ላምዖ ማራናኣቶንሢና ዎላ ዡጊ፥ ታኣም ዱማዼ ዒንጊሢ ማሂ ዒንጎንጎ፤ ዬይ ቄኤሳሢ ዛላ ማዓያ ማዓንዳኔ፤ ዬንሢያ ታኣም ዱማዼ ዒንጊሢኬ። <verse eid="LEV 23:20"/><verse number="21" style="v" sid="LEV 23:21"/>ዬኖ ኬሎ ታና ካኣሽካኒ ቡኪንቱዋቴ፤ ሜሌ ማዾ ማዺፖቴ፤ ዬይ ዒንሢ ናንጋ ቤዞ ቢያይዳ ሙካ ሾይንታ ካፓ ዳምቤ ማዖንጎ።<verse eid="LEV 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 23:22"/>«ዒንሢ ማኣሎ ቡራ ዎዶና ጎዦኮ ዓጮይዳ ዓጮይዳ ዓኣ ሃኣኮ ዔኪፖቴ፤ ሃሣ ቶሊ ዓቴሢ ጊንሣ ዚንጊፖቴ፤ ዬያ ማንቆ ዓሶና ሜሌ ዓጫፓ ሙኬ ዓሶናም ሃሹዋቴ፤ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢኬ።» <note caller="-" style="x"><char style="xo" closed="false">23፡22 </char><char style="xt" closed="false"><ref loc="LEV 19:9-10">ሌዊ. ዓኬ 19፡9-10</ref>፤ <ref loc="DEU 24:19-22">ላሚ. ዎማ 24፡19-22</ref>።</char></note><verse eid="LEV 23:22"/></para>
  <para style="s1">ዓኮ ሌዖ ቦንቾ ኬሊ</para>
  <para style="r">(<ref loc="NUM 29:1-6">ፓይ. ማፃ 29፡1-6</ref>)</para>
  <para style="p">
    <verse number="23-24" style="v" sid="LEV 23:23-24"/>ናንጊና ናንጋ ጎዳ ዒስራዔኤሌ ዓሶም ሙሴ ሂዚ ጌዒ ኬኤዛንዳጉዲ ዓይሤኔ፦ «ላንካሳ ዓጊኖኮ ቤርታሳ ኬሎ ዱማ ቦንቾ ኬሊ ማሂ ቦንቹዋቴ፤ ዛዬ ዋርቂንቴ ዎዶና ታና ካኣሽካኒ ዒዞ ኬሎ ቡኪንቱዋቴ። <verse eid="LEV 23:23-24"/><verse number="25" style="v" sid="LEV 23:25"/>ዬኖ ኬሎ ታኣም ሙኡዚ ዒንጊሢ ዒንጉዋቴ፤ ሜሌ ዒንሢኮ ማዾ ማዺፖቴ»<verse eid="LEV 23:25"/></para>
  <para style="s1">ጎሜ ጌኤሾ ኬሊ</para>
  <para style="r">(<ref loc="NUM 29:7-11">ፓይ. ማፃ 29፡7-11</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 23:26"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 23:26"/><verse number="27" style="v" sid="LEV 23:27"/>«ላንካሳ ዓጊኖኮ ታጳሳ ኬሎና ዴሮኮ ጎሞ ጌኤሾ ኬሊ ማዖንጎ፤ ታና ካኣሽካኒ ቡኪንቲ፥ ፔቴታዖ ዔኤቢ ሙዑዋዖ ፔኤቁዋቴ፤ ታኣም ሙኡዚ ዒንጊሢያ ዒንጉዋቴ። <verse eid="LEV 23:27"/><verse number="28" style="v" sid="LEV 23:28"/>ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢ ቤርታ ዬና ኬሌላ ዴሮኮ ጎሞ ጌኤሾ ዳምባ ኩንሢንታ ኬሎታሢሮ ዬኖ ኬሎ ዓይጎ ማዾዋ ማዺፖቴ። <verse eid="LEV 23:28"/><verse number="29" style="v" sid="LEV 23:29"/>ዬኖ ኬሎና ሙኡዚ ሙዔ ዓሲ ታ ዓሶ ባኣካፓ ባይቆንጎ፤ <verse eid="LEV 23:29"/><verse number="30" style="v" sid="LEV 23:30"/>ዬያጉዲ ዓይጎ ማዾዋ ማዖም ማዼ ዓሲ ታኣኒ ታ ዴሮ ባኣካፓ ባይዛንዳኔ። <verse eid="LEV 23:30"/><verse number="31" style="v" sid="LEV 23:31"/>ዬያሮ ፔቴታዖ ዒዞ ኬሎና ማዾ ማዺፖቴ፤ ዬይ ዒንሢ ናንጋ ቤዞ ቢያይዳ ሙካ ሾይንታ ካፓ ዳምቤ ማዖንጎ። <verse eid="LEV 23:31"/><verse number="32" style="v" sid="LEV 23:32"/>ዬኖ ዓጊኖኮ ታዞጳሳ ኬሎ ዓባ ጌሌማፓ ዴንዲ ዚሮ ዓባ ጌላንዳኣና ዓይጎ ባኣዚያ ሙዑዋዖ ዬኖ ኬሌሎ ዱማ ሃውሺሢ ኬሊ ማሂ ቦንቹዋቴ» ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">23፡32 </char><char style="xt" closed="false"><ref loc="LEV 16:29-34">ሌዊ. ዓኬ 16፡29-34</ref>።</char></note><verse eid="LEV 23:32"/></para>
  <para style="s1">ዉልሾ ዴማ ዴዒ ቦንቾ ኬሎ</para>
  <para style="r">(<ref loc="NUM 29:12-40">ፓይ. ማፃ 29፡12-40</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 23:33"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 23:33"/><verse number="34" style="v" sid="LEV 23:34"/>«ዒስራዔኤሌ ዴሮም ሂዚ ጌዔ፤ ላንካሳ ዓጊኖኮ ታጶ ዶንጋሳ ኬላፓ ዓርቂ ላንካይ ኬሊ ሄላንዳኣና ዉልሾ ዴማ ዴዒ ቦንቺንታ፥ ታ ኬሎ ቦንቹዋቴ፤ <verse eid="LEV 23:34"/><verse number="35" style="v" sid="LEV 23:35"/>ዬንሢ ኬሎይዳፓ ቤርታሳ ኬሎ ቡኪ ታና ካሽኩዋቴ፤ ሜሌ ዓይጎ ማዾዋ ማዺፖቴ፤ <verse eid="LEV 23:35"/><verse number="36" style="v" sid="LEV 23:36"/>ዬንሢ ላንካዎ ኬሎንሢ ቢያይዳ ሙዖ ዒንጊፆ ታኣም ሺኢሹዋቴ፤ ሳላሳ ኬሎና ታና ካኣሽካኒ ቡኪንቱዋቴ፥ ሙዖ ዒንጊፆዋ ታኣም ዒንጉዋቴ፤ ዬና ጋፒንሢ ቡኪንቲ ኬሊ ማዔሢሮ ሜሌ ማዾ ዒንሢኮ ማዺፖቴ።» <note caller="-" style="x"><char style="xo" closed="false">23፡36 </char><char style="xt" closed="false"><ref loc="DEU 16:13-15">ላሚ. ዎማ 16፡13-15</ref>።</char></note><verse eid="LEV 23:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 23:37"/>«ሚቺ ዒንጎ ዒንጊፆ፥ ሙዖ ዒንጊፆ፥ ዑዦ ዒንጊፆንታ ሜሌ ሜሌ ዒንጊፆዋ ታኣም ኮይሳሢ ጎይፆ ቢያ ኬሊ ዒንጊ ታና ዒንሢ ካኣሽካንዳ ታኣኮ ቦንቾ ኬሎንሢ ዬንሢኬ። <verse eid="LEV 23:37"/><verse number="38" style="v" sid="LEV 23:38"/>ዬንሢ ባኮ፥ ታኣኮ ቦንቾ ኬሎና ዒንሢ ዒንጋ ዒንጊፆይዳ፥ ናኣቦ ዒንሢ ዒንጋ ዒንጊፆይዳ፤ ሃሣ ዒንሢ ሼኔና ዒንሢ ዒንጋ ዒንጊፆይዳ ቃሲ ዒንሢ ዒንጋንዳ ባኣዚኬ።»<verse eid="LEV 23:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 23:39"/>«ማኣሎ ዒንሢ ቡሬስካፓ ላንካሳ ዓጊኖኮ ታጶ ዶንጋሳ ኬላፓ ዓርቃዖ ላንካይ ኬሊ ሄላንዳኣና ዎዛ ቦንቾ ታ ቤርታ ቦንቹዋቴ፤ ዬያቶይዳፓ ቤርታሳ ኬሎማና ሳላሳ ኬሎና ዱማ ሃውሺሢ ኬሊ ዒንሢም ማዖም። <verse eid="LEV 23:39"/><verse number="40" style="v" sid="LEV 23:40"/>ዬኖ ቤርታሳ ኬሎይዳ ዒንሢ ቱኬ ኮዦ ሚፆ ዓኣፖንታ ሜኤፄ ዒላሺንታ ሃሣ ዓኣዔ ሚሢ ዋላሺ ሜንሢ ዔኪ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢ ቤርታ ላንካይ ኬሊ ሄላንዳኣና ዎዛዹዋቴ። <verse eid="LEV 23:40"/><verse number="41" style="v" sid="LEV 23:41"/>ዬኖ ቦንቾ ሌዓ ሌዓ ናንጊና ናንጋ ጎዳ ቤርታ ላንካይ ኬሊ ሄላንዳኣና ቦንቹዋቴ፤ ዬይ ዒንሢኮ ናኣቶኮ ናኣቶና ናንጋ ዳምቤ ማዖንጎ፤ ላንካሳ ዓጊኖና ዓጊኖና ቦንቹዋቴ። <verse eid="LEV 23:41"/><verse number="42" style="v" sid="LEV 23:42"/>ዒስራዔኤሌ ዴራ ጉቤ ላንካይ ኬሊ ሄላንዳኣና ዉልሻ ዴንካ ዴዖንጎ፤ <verse eid="LEV 23:42"/><verse number="43" style="v" sid="LEV 23:43"/>ዬያይዲፆና ታኣኒ ዒስራዔኤሌ ዴሮ ጊብፄ ዓጫፓ ኬሳኣና፥ ዴራ ዋዦ ዴንካ ናንጋንዳጉዲ ማሄሢ ዒንሢኮ ናኣታ ዔራንዳኔ፤ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢኬ» ጌዔኔ።<verse eid="LEV 23:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 23:44"/>ናንጊና ናንጋ ጎዳ ዔያታ ካኣሽኪ ቦንቻንዳ ኬሎ ዒስራዔኤሌ ዓሶም ሙሴ ዬያይዲ ዔርዜኔ።<verse eid="LEV 23:44"/></para>
  <chapter eid="LEV 23"/>
  <chapter number="24" style="c" sid="LEV 24"/>
  <para style="s1">ፆኦሲ ካኣሽኪንታ ማኣሮ ጋራ ፖዓ ፖዒ</para>
  <para style="r">(<ref loc="EXO 27:20-21">ኬሲ. ማፃ 27፡20-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 24:1"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 24:1"/><verse number="2" style="v" sid="LEV 24:2"/>«ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮ ጋራ ዓኣ ፖዓ ቢያ ዎዴ ፖዒ ዴዓንዳጉዲ ሪሚቶ ዓኣፖ ጩኡጲ ጊሶና ዛይቶ ኔኤም ዔኪ ዬዓንዳጉዲ ዒስራዔኤሌ ዴሮም ኬኤዜ። <verse eid="LEV 24:2"/><verse number="3" style="v" sid="LEV 24:3"/>ዬካፓ ዓኣሮኔ ዋንቶ ዋንቶ ዓፒሎና ማዢንቴ፥ ፆኦሲ ዴሮና ካኣማ ማኣሮኮ ጋራ ዓኣ ታኣቦቶኮ ቤርቶ ዛላ፥ ጎኦቦና ዓፒሎኮ ዙላ ታ ቤርቶይዳ ሳዓ ካራንዳያ ሄላንዳኣና ዔኤሤ ጎይሣ ዎይሦንጎ፤ ዬይ ዳምባ ሙካ ሾይንታ ቢያ ካፒ ማዻያ ማዖንጎ። <verse eid="LEV 24:3"/><verse number="4" style="v" sid="LEV 24:4"/>ዓኣሮኔ ዬንሢ ፖዖንሢ ጌኤሺ ዎርቄና ኮሺንቴ ሻርኖይዳ ጊኢጊሺ ጌሦንጎ፤ ዬንሢ ፖዓ ታ ቤርቶይዳ ቢያ ዎዴ ዔኤቲ ዴዓያ ማዓሢ ዛጎንጎ።»<verse eid="LEV 24:4"/></para>
  <para style="s1">ፆኦሲም ዒንጎ ላኣዳ</para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 24:5"/>«ዬያጉዲ ሃሣ ታጶ ላምዖ ኪሎ ማዓንዳ ሺኢቺ ዺኢሊ ዔኪ፥ ታጶ ላምዖ ዻካ ዻካ ላኣዳ ላኣዴ፤ <verse eid="LEV 24:5"/><verse number="6" style="v" sid="LEV 24:6"/>ዬንሢ ላኣዶንሢ ታ ቤርቶይዳ ዓኣ፥ ጌኤዦ ዎርቆና ጳርቆና ዼጌ ሎኦዦ ዖይቶይዳ ላሆንሢ ፔቴ ዛላ፥ ዓቴ ላሆንሢያ ባጎ ዛላ ዎሊ ቤኤዚ ጌሤ። <note caller="-" style="x"><char style="xo" closed="false">24፡6 </char><char style="xt" closed="false"><ref loc="EXO 25:30">ኬሲ. ማፃ 25፡30</ref>።</char></note> <verse eid="LEV 24:6"/><verse number="7" style="v" sid="LEV 24:7"/>ታኣም ሚቺ ዒንጎ ዒንጊፆ ማሊሳ ላኣዳ ዒንጊሢ ማዔሢ ዔርዛኒ ጌኤሺ ዑንጄ ላምዖ ዎሊ ቤኤዚ ጌሦና ላኣዶኮ ኮራ ኮራ ጌሤ፤ <verse eid="LEV 24:7"/><verse number="8" style="v" sid="LEV 24:8"/>ዬይ ሙካ ዎዶይዳ ሃውሾ ኬሎ ኬሎ ናንጊና ናንጋ ጎዳ ቤርታ ጌሢንቲ ዴዖንጎ፤ ዬይ ዒስራዔኤሌ ዓሳ ቢያ ዎዴ ማዺ ኩንሣኒ ኮይሳ ጫኣቁሞ ዳምቤኬ። <verse eid="LEV 24:8"/><verse number="9" style="v" sid="LEV 24:9"/>ዬይ ካሣ ዓኣሮኔና ዒዛኮ ናኣቶናም ማዓያኬ፤ ዔያታ ታኣም ዱማዼ ቤዞይዳ ሙዖንጎ፤ ዬይ ሚቺ ዒንጎያ ማሂ ሺኢሾና ዒንጊፃ ታኣም ዱማዼያ፥ ዔያቶ ዛላ ማዓያኬ» ጌዒ ዓይሤኔ። <note caller="-" style="x"><char style="xo" closed="false">24፡9 </char><char style="xt" closed="false"><ref loc="MAT 12:4">ማቲ. 12፡4</ref>፤ <ref loc="MRK 2:26">ማር. 2፡26</ref>፤ <ref loc="LUK 6:4">ሉቃ. 6፡4</ref>።</char></note><verse eid="LEV 24:9"/></para>
  <para style="s1">ፆኦሲ ጫሽኬ ዓሲዳ ዎጊንታ ዎጌ</para>
  <para style="p">
    <verse number="10-11" style="v" sid="LEV 24:10-11"/>ዒንዳ ዒስራዔኤሌ ዓሲ ዓዴ ጊብፄ ዓሲ ማዔ፥ ፔቴ ዓሲ ዓኣኔ፤ ዒዛኮ ዒንዶ ሱንፃ ሴሎሚቶኬ፤ ዒዛ ዳኣኔ ዜርፃፓ ማዔያ ዲብሪ ጎዖሢኮ ናይ ማዔ ዒስራዔኤሌ ዓሲኬ፤ ዬይ ዓሢ ጉርዶይዳ ፔቴ ዒስራዔኤሌ ዓሲና ዎላ ዑራዺ፥ ዑሮይዳፓ ዔቄያና ናንጊና ናንጋ ጎዳኮ ሱንፆ ጫሽኬሢሮ ሙሴ ቤርቶ ዓሳ ዒዛ ዔኪ ዬዔኔ፤ <verse eid="LEV 24:10-11"/><verse number="12" style="v" sid="LEV 24:12"/>ዒዛ ዎዻኒ ኮይሳቴ ናንጊና ናንጋ ጎዳ ዔያቶም ኬኤዛንዳያ ሄላንዳኣና ቱኡሲ ማርካ ጌሢ ካፓ ዓሲና ዒዛ ዔያታ ካፒሴኔ።<verse eid="LEV 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 24:13"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 24:13"/><verse number="14" style="v" sid="LEV 24:14"/>«ታና ጫሽኬ ዓሢ ጉርዳፓ ዙሎ ኬሴ፤ ዒዚ ጫሽካኣና ዋይዜ ዓሳ ቢያ ዬይ ዓሢ ዻቢንቴያ ማዔሢ ማርካዻኒ ቢያ ዓሳ ፔቴና ኩጮ ዒዛ ቶኦካ ጌሦንጎ፤ ዬካፓ ዴራ ቢያ ዒዛ ሹቻ ዹይ ዎዾንጎ። <verse eid="LEV 24:14"/><verse number="15" style="v" sid="LEV 24:15"/>ዒስራዔኤሌ ዓሶም ሂዚ ጌዔ፤ ዓይጎ ዓሲያ ፔኤኮ ፆኦሲ ጫሽኬሢ ጎሜ ማዼሢሮ ዬያ ዛሎ ዒዛይዳ ዓጊንታ ባኮ ዒ ዔካንዳኔ፤ <verse eid="LEV 24:15"/><verse number="16" style="v" sid="LEV 24:16"/>ታኣኮ ሱንፆ ጫሽካ ዓሲ ዎዎዺንቶንጎ፤ ዒስራዔኤሌ ዓሲ ማዔቴያ ሜሌ ዓጪ ዓሲ ማዔ ዓሲ ቢያ ታ ሱንፆ ጫሽኬቴ ዒስራዔኤሌ ዴራ ዬያ ዓሢ ሹቻ ዹይ ዎዾንጎ።»<verse eid="LEV 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 24:17"/>«ዓሲ ዎዻ ዓሲ ዖና ማዔቴያ ሃይቃንዳጉዲ ዎጊንቶንጎ፤ <note caller="-" style="x"><char style="xo" closed="false">24፡17 </char><char style="xt" closed="false"><ref loc="EXO 21:12">ኬሲ. ማፃ 21፡12</ref>።</char></note> <verse eid="LEV 24:17"/><verse number="18" style="v" sid="LEV 24:18"/>ሜሌ ዓሲኮ ቆልሞ ዎዼ ዓሲ ዒማጉዴ ቆልሞ ማሂ ጪጎንጎ፤ ዬይ ዎጋ ሼምፖ ዛሎ ሼምፖ ጪጎም ጌይሢኬ።»<verse eid="LEV 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 24:19"/>«ዓይጎ ዓሲያ ማዖም ፔቴ ዓሲዳ ፑርታ ባኣዚ ማዼያ ማዔቴ ዒማጉዴ ባኣዚ ዬያ ዓሢዳ ማዺንቶንጎ፤ ጌይፃ፦ <verse eid="LEV 24:19"/><verse number="20" style="v" sid="LEV 24:20"/>ዬይ ዓሢ ዓሲኮ ሜጌሢ ሜንሤያ ማዔቴ ዒዛኮዋ ሜጌፃ ሜንሢንቶም፤ ሜሌ ዓሲኮ ዓኣፒ ዎዼያ ዒ ማዔቴ ዓኣፓ ዎዺንቶም፤ ሃሣ ዓቺ ሜንሤያታቴ ዓጫ ዒዛኮ ሜቆም፤ ዬያጉዲ ሜሌ ዓሲ ዑሢዳ ዓይጎ ባኣዚያ ዒ ማዼ ባካ ዒዛይዳኣ ማዺንቶንጎ፤ <note caller="-" style="x"><char style="xo" closed="false">24፡20 </char><char style="xt" closed="false"><ref loc="EXO 21:23-25">ኬሲ. ማፃ 21፡23-25</ref>፤ <ref loc="DEU 19:21">ላሚ. ዎማ 19፡21</ref>፤ <ref loc="MAT 5:38">ማቲ. 5፡38</ref>።</char></note> <verse eid="LEV 24:20"/><verse number="21" style="v" sid="LEV 24:21"/>ቆልሞ ዎዼሢ ቤዛ ሜሌ ጪጎንጎ፤ ጋዓንቴ ዓሲ ዎዼሢ ሃይቃንዳጉዲ ዎጊንቶንጎ። <verse eid="LEV 24:21"/><verse number="22" style="v" sid="LEV 24:22"/>ሃይ ዎጋ ዒንሢ ዒስራዔኤሌ ዓሶንታ ዒንሢኮ ባኣካ ናንጋ ሜሌ ዓሶንታም ቢያ ሄኮ ማዻያ ማዖንጎ፤ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦሲኬ» ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">24፡22 </char><char style="xt" closed="false"><ref loc="NUM 15:16">ፓይ. ማፃ 15፡16</ref>።</char></note><verse eid="LEV 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 24:23"/>ሙሴ ዬያ ቢያ ዴሮም ኬኤዚ ጋፒሳዛ ዔያታ ዬያ ዓሢ ጉርዳፓ ዙሎ ኬሲ፥ ሹቻ ዹይ ዎዼኔ፤ ናንጊና ናንጋ ጎዳ ሙሴ ዓይሤ ጎይፆ ዒስራዔኤሌ ዴራ ማዼኔ።<verse eid="LEV 24:23"/></para>
  <chapter eid="LEV 24"/>
  <chapter number="25" style="c" sid="LEV 25"/>
  <para style="s1">ላንካሳ ሌዖና ሃውሾ ሃውሺፆ</para>
  <para style="r">(<ref loc="DEU 15:1-11">ላሚ. ዎማ 15፡1-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 25:1"/>ናንጊና ናንጋ ጎዳ ሙሴም ሲና ዹኮይዳ፦ <verse eid="LEV 25:1"/><verse number="2" style="v" sid="LEV 25:2"/>«ዒስራዔኤሌ ዓሶም ሂዚ ጌዔ፤ ናንጊና ናንጋ ጎዳ ዒንሢም ዒንጋንዳ ዓጮ ዒንሢ ጌሌ ዎዶና ላንካሳ ሌዖይዳ ፔቴታዖ ጎሺ ጎሽኩዋዖ ሃሺ ናንጊና ናንጋ ጎዳ ቦንቹዋቴ። <verse eid="LEV 25:2"/><verse number="3" style="v" sid="LEV 25:3"/>ላሆ ሌዔ ሄላንዳኣና ጎዦ ዒንሢኮ ጎሽኩዋቴ፤ ዎይኖኮዋ ፑርቴ ካኣፖ ካሪ ኮሹዋቴ፤ ካፄ ሃኣኮዋ ማኣላፓ ቡሪ ዔኩዋቴ። <verse eid="LEV 25:3"/><verse number="4" style="v" sid="LEV 25:4"/>ላንካሳ ሌዓ ጋዓንቴ ታኣም ዱማዼያ ማዖንጎ፤ ዬኖ ሌዖይዳ ጎዦ ዒንሢሲ ጎሽኪፖቴ፤ ሃሣ ዎይኖኮዋ ፑርቴ ካኣፖ ካሪ ካሪ ኮሺፖቴ። <verse eid="LEV 25:4"/><verse number="5" style="v" sid="LEV 25:5"/>ማኣሎይዳ ጉሪ ባቃሊ ካፄ ሃኣኮ ዔኪፖቴ፤ ሃሣ ፑርቴ ካኣፖ ካሪ ኮሺንቲባኣ ዎይኖይዳፓ ዓኣፖ ዔኪፖቴ። ዬና ሌዓ ጎዣ ዒንሢኮ ጎሽኪንቱዋ ሌዔ ማዖንጎ። <verse eid="LEV 25:5"/><verse number="6" style="v" sid="LEV 25:6"/>ዬኖ ሌዖይዳ ዒንሢ ጎዦ ጎሽኩዋያ ማዔቴያ ዒንሢኮ ማኣሎይዳ ጉሪ ካፄ ባካ ዒንሢንታ ዒንሢም ማዻ ዓሶንታም፥ ሃሣ ዒንሢ ሚኢሼ ጪጊ ማዺሻ ዓሶንታም፤ ዬያጉዲ ዒንሢና ዎላ ናንጋ ሜሌ ዓጮ ዓሶም፤ <verse eid="LEV 25:6"/><verse number="7" style="v" sid="LEV 25:7"/>ዒንሢኮ ቆልሞና ካዮ ቦዖናም ሙኡዚ ማዖንጎ። »<note caller="-" style="x"><char style="xo" closed="false">25፡7 </char><char style="xt" closed="false"><ref loc="EXO 23:10-11">ኬሲ. ማፃ 23፡10-11</ref>።</char></note><verse eid="LEV 25:7"/></para>
  <para style="s1">ዓይሉሞፓ ኬስኪሢንታ ሻንቂንቲ ዔውቴ ሳዓ ማሂሢንታ ሌዔ ዛላ</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 25:8"/>«ላንካይ ሃውሾ ሌዔ ላንካይ ማይንቲ ፓይዴ፤ ዬያ ኔ ፓይዳዛ ሌዓ ዎሊ ዑፃ ዖይዲታሚ ታዞጳ ሌዔ ማዓኔ። <verse eid="LEV 25:8"/><verse number="9" style="v" sid="LEV 25:9"/>ዬካፓ ላንካሳ ዓጊኖኮ ታጳሳ ኬሎና ቦንቺንታ ጎሞ ጌኤሺፆ ኬሎ ዒንሢ ዓጮ ቢያይዳ ዛዬ ዋርቃንዳ ዓሲ ዳኩዋቴ፤ <verse eid="LEV 25:9"/><verse number="10" style="v" sid="LEV 25:10"/>ዬያይዲ ዶንጊታማሳ ሌዖ ታኣም ዱማሲ፥ ዓጮይዳ ቢያ ናንጋ ዓሶም ዓይሌ ማዒ ሻንቺንቴሢ ዓይሉማፓ ኬስኪ ፔ ዒጊኖ ባንሢ ዴንዳንዳጉዲ፥ ሃሣ ሻንቺንቴ ጎሺያኣ ሻንቼ ዓሢም ማዓንዳጉዲ ኬኤዙዋቴ፤ <verse eid="LEV 25:10"/><verse number="11" style="v" sid="LEV 25:11"/>ዬኖ ሌዖና ጎዦ ዒንሢኮ ጎሽኪፖቴ፤ ሃሣ ዒንሢ ጎሽኪባኣንቴ ማኣሎይዳ ጉሪ ባቃሊ ካፄ ሃኣኮ ዔኪፖቴ፤ ዬያጉዲ ፑርቴ ካኣፓ ካሪ ጊኢጊሺንቲባኣ ዎይኖ ዓኣፖዋ ማንፂ ዔኪፖቴ። <verse eid="LEV 25:11"/><verse number="12" style="v" sid="LEV 25:12"/>ዬና ሌዓ ጉቤ ታኣም ዱማዼያ ማዖንጎ፤ ዒንሢ ጎሽኪባኣንቴ ማኣሎይዳ ጉሪ ባቃሊ ካፄ ሃኣኮ ዒኢካ ማኣላፓ ዔኪ ሙዑዋቴ።<verse eid="LEV 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 25:13"/>«ዬያኮ ቤርታ ሻንቺንቴ ጎሺ ዬኖ ሌዖይዳ ሻንቼ ጎዦ ዓዳሢም ማሂ ዒንጊንታያ ማዖንጎ። <verse eid="LEV 25:13"/><verse number="14" style="v" sid="LEV 25:14"/>ዒንሢኮ ፃጲ ማዔ ዓሲም ሳዓ ዒንሢ ሻንቼቴ፤ ሃሣ ጊንሣ ሻንቄያ ዒንሢ ማዔቴ ፔቴይ ባጋሢም ጌኔ ማዾ ማዾፓ። <verse eid="LEV 25:14"/><verse number="15" style="v" sid="LEV 25:15"/>ሻንቺንቴ ሳዓ ማዓ ሌዓ ሄላንዳኣና ዓኣ ሌዖኮ ፓይዶ ዔሪ፥ ኔ ፃጳሢፓ ሻንቄ፤ ዒዚያ ዬኖ ሌዖ ጋራ ዓኣ፥ ሃኣካ ካፃንዳ ሌዖኮ ፓይዶ ዔሪ ሻንቾንጎ። <verse eid="LEV 25:15"/><verse number="16" style="v" sid="LEV 25:16"/>ዬኖ ሌዖኮ ፓይዳ ሚርጌቴ ሚርጌ ሚኢሼ ዒንጌ፤ ሌዖኮ ፓይዳ ዻካ ማዔቴ ዻካ ሚኢሼ ዒንጌ፤ ዓይጎሮ ጌዔቴ ዒ ሳዖ ሻንቻሢ ጎዣ ካፂሳንዳ ሃኣኮ ጎይፆታሢሮኬ። <verse eid="LEV 25:16"/><verse number="17" style="v" sid="LEV 25:17"/>ፔቴ ዒስራዔኤሌ ዓሲ ፔ ባጋሢም ጌኔ ማዾ ማዾፓ፤ ዒንሢኮ ፆኦዛሢ ዒጊጩዋቴ፤ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢኬ።<verse eid="LEV 25:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 25:18"/>«ዒንሢ ናንጋ ዓጮይዳ ኮሺ ናንጋኒ ታኣኮ ዎጎና ዓይሢፆና ካፒ ኩንሣያ ማዑዋቴ። <verse eid="LEV 25:18"/><verse number="19" style="v" sid="LEV 25:19"/>ዒንሢኮ ሳዓ ዒንሢም ጊዳ ሃኣኮ ካሣንዳሢሮ ሙዓንዳ ባኣዚ ዴንቂ ሜታባኣያ ዒንሢ ናንጋንዳኔ።<verse eid="LEV 25:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 25:20"/>«ጋዓንቴ ዒንሢ፥ ኑኡኒ ጎሺ ጎሽኪ ሃኣኮ ዓርሢባኣቴ ዬኖ ላንካሳ ሌዖ ዓይጎ ሙዓንዳይ?» ጌይ ዖኦጫያናንዳኔ፤ <verse eid="LEV 25:20"/><verse number="21" style="v" sid="LEV 25:21"/>ላሃሳ ሌዖና ታኣኒ ዒንሢኮ ሳዖ ሚርጌና ዓንጃንዳሢሮ ሃይሦ ሌዔም ጊዳንዳ ሃኣኮ ካፃንዳኔ። <verse eid="LEV 25:21"/><verse number="22" style="v" sid="LEV 25:22"/>ሳላሳ ሌዖይዳ ማዔቴያ ጎዦ ዒንሢ ጎሽካ ዎዶና ዒንሢ ሙዓንዳሢ ቤርታኣ ሃኣኮኬ፤ ዬያ ሃኣኮ ታዞጳሳ ሌዖ ሃኣኮ ዓርሣንዳያ ሄላንዳኣና ሙዒ ሙዒ ዒንሢ ዴዓንዳኔ።<verse eid="LEV 25:22"/></para>
  <para style="s1">ሻንቂንቲ ዔውቴ ባኣዚ ማሂሢ ዛላ</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 25:23"/>«ሳዖ ዒንሢኮ ማሂንቱዋ ጎይሢ ፔቶ ሻንቺፖቴ፤ ዓይጎሮ ጌዔቴ ሳዓ ዒንሢሮቱዋንቴ ታኣሮታሢሮኬ፤ ዒንሢ ሙኬ ዓሲጉዲ ማዒ ዒኢካፓ ጴዻ ባኮ ሙዓንዳጉዲ ታ ዓይሤኔ።<verse eid="LEV 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 25:24"/>«ሳኣ ዒንሢ ሻንቃ ዎዶና ዬይ ሻንቼ ዓሢ ሳዖ ጊንሣ ማሂ ሻንቂ ዔካኒ ላኣጋ ባኣዚ ባኣያ ማዓኒ ኮይሳኔ። <verse eid="LEV 25:24"/><verse number="25" style="v" sid="LEV 25:25"/>ፔቴ ዒስራዔኤሌ ፃጲ ማዔያ ማንቂ፥ ሳዖ ፔኤኮ ሻንቻያ ማዔቴ ዒዛኮ ዑኬ ማዔ ዒጊኒ ዒዛኮ ሳዖ ዒዛም ጪጊ ማሂሳኒ ዳንዳዓኔ። <verse eid="LEV 25:25"/><verse number="26" style="v" sid="LEV 25:26"/>ዬያ ማዻንዳ ዑኬ ዒጊኒ ባይቄቴ ዒዚ ናንጊቤቃ ቆሎ ዴንቃዖ ጪጊ ፔኤኮ ሳዖ ማሂሳኒ ዳንዳዓኔ፤ <verse eid="LEV 25:26"/><verse number="27" style="v" sid="LEV 25:27"/>ዬያ ዒ ማዻኒ ዳንዳዔ ዎዶና ሻንቺንቴ ባኮ ማሂፆ ሌዓ ሄላንዳኣና ጋራ ዓኣ ሌዖ ፓይዲ ዔሬስካፓ ዓቴ ሌዖ ሚኢሾ ዓሢም ማሂ ፔ ሳዖ ዔኮንጎ። <verse eid="LEV 25:27"/><verse number="28" style="v" sid="LEV 25:28"/>ጋዓንቴ ዒዚ ጪጊ ማሂሲ ዔካንዳ ሚኢሼ ዴንቂባኣያ ማዔቴ ሳዓ ዒዛሲ ሻንቂንቴ ባኮ ማሂፆ ሌዓ ሄላንዳኣና ዬያ ሻንቄ ዓሢሮ ማዒ ዴዖንጎ፤ ዬና ሌዓ ሄሌስካፓ ሳዓ ዒዛሮ ማዖንጎ።<verse eid="LEV 25:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 25:29"/>«ፔቴ ዓሲ ሹቺና ኬልቂ ዲርቆና ካታማይዳ ማኣሪ ሻንቼቴ፥ ሻንቺንቴ ኬላፓ ዴንዲ ፔቴ ሌዔ ማዓ ጋርሲዳ ጪጊ ማሂ ዔካኒ ዳንዳዓኔ። <verse eid="LEV 25:29"/><verse number="30" style="v" sid="LEV 25:30"/>ጋዓንቴ ዒ ፔቴ ሌዔ ጋርካ ጪጊ ማሂ ዔካኒ ዳንዳዒባኣቴ ጪጊ ማሂ ዔካኒ ዳንዳዑዋያ ማዔም ዬና ማኣራ ናንጊና ዬያ ሻንቄ ዓሢና ናኣቶናሮ ማዒ ዓታንዳኔ፤ ሻንቂንቴ ባኮ ማሂፆ ሌዖናታዖ ማሂ ዒ ዔካኒ ዳንዳዑዋሴ። <verse eid="LEV 25:30"/><verse number="31" style="v" sid="LEV 25:31"/>ሹቺና ኬልቂ ዲርቂንቲባኣ፥ ጉርዳ ባኣካ ዓኣ ማኣሪ ሻንቻሢ ጋዓንቴ ጎሺ ሻንቼያጉዲ ማሂ ጪጊ ዔካኒ ዳንዳዓኔ፤ ሃሣ ሻንቺንቴ ባኮ ማሂፆ ሌዖይዳ ዒ ማሂ ዔካኒ ዳንዳዓኔ። <verse eid="LEV 25:31"/><verse number="32" style="v" sid="LEV 25:32"/>ዬይ ያዺ ማዔቴያ ሌዊ ፃጶ ማዔ ዓሳ ዔያቶ ካታሞይዳ ዓኣ ማኣሮ ፔኤኮ ዓይጎ ዎዴናኣ ማዖም ጪጊ ማሂ ዔካኒ ላኣጋ ባኣዚ ባኣያ ማዓኔ። <verse eid="LEV 25:32"/><verse number="33" style="v" sid="LEV 25:33"/>ፔቴ ሌዊ ፃጲ ማዔ ዓሲ ካታማይዳ ማኣሪ ሻንቻዖ ማሂ ጪጊ ዔካኒ ዳንዳዒባኣያ ማዔቴ ሻንቺንቴ ባኮ ማሂፆ ሌዖይዳ ዒዛም ማዓኒ ዳንዳዓኔ፤ ዓይጎሮ ጌዔቴ ሌዊ ፃጶ ማዔ ዓሳ ዔያቶ ካታሞይዳ ማዣ ማኣራ ቢያ ዎዴ ዔያቶሮ ማዒ ናንጋሢሮኬ። <verse eid="LEV 25:33"/><verse number="34" style="v" sid="LEV 25:34"/>ዔያቶኮ ካታሞ ዓጮይዳ ዓኣ ቆልማ ሄንቃ ቤዛ ፔቴታዖ ሻንቺንቱዋሴ፤ ዬይ ናንጊና ዔያቶሮ ማዒ ናንጋያኬ። »<verse eid="LEV 25:34"/></para>
  <para style="s1">ማንቆ ዓሲ ማኣዲሢ ዛላ</para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 25:35"/>«ዒንሢ ባኣካ ናንጋ፥ ዒንሢ ፃጲ ማዔ ዒስራዔኤሌ ዓሲ ማንቂ ፔና ማኣዳኒ ዳንዳዒባኣቴ ዒንሢ ባኣካ ናንጋኒ ሜሌ ዓጪፓ ሙኬ ዓሲም ዒንሢ ማዻ ጎይፆ ዒዛም ኮይሳ ባኮ ናሹሞና ማዹዋቴ። <note caller="-" style="x"><char style="xo" closed="false">25፡35 </char><char style="xt" closed="false"><ref loc="DEU 15:7-8">ላሚ. ዎማ 15፡7-8</ref>።</char></note> <verse eid="LEV 25:35"/><verse number="36" style="v" sid="LEV 25:36"/>ዒንሢኮ ፃጲ ማዔ ዓሢ ዒንሢና ዎላ ናንጊሹዋቴ፤ ሃሣ ዓይጎ ባኣዚያ ዑሣ ዓኣሢ ሾይቺና ዒንሢም ዒንጋንዳጉዲ ዔኤቢ ማዺፖቴ፤ ዒንሢኮ ፆኦዛሢ ዒጊጩዋቴ። <verse eid="LEV 25:36"/><verse number="37" style="v" sid="LEV 25:37"/>ዒንሢ ታልዓ ሚኢሾ ሾይቺና ማሃንዳጉዲ ጌይ ታልዒፖቴ፤ ሙኡዚ ዒዛም ዒንሢ ሻንቻ ዎዶና ዑሣ ዓኣሢ ዺቢ ሚኢሼም ሻንቺፖቴ፤ <note caller="-" style="x"><char style="xo" closed="false">25፡37 </char><char style="xt" closed="false"><ref loc="EXO 22:25">ኬሲ. ማፃ 22፡25</ref>፤ <ref loc="DEU 23:19-20">ላሚ. ዎማ 23፡19-20</ref>።</char></note> <verse eid="LEV 25:37"/><verse number="38" style="v" sid="LEV 25:38"/>ካኣናኔ ዓጮ ዒንሢም ዒንጋኒ፥ ዒንሢኮ ፆኦሲ ማዓኒ ጊብፄ ዓጫፓ ዒንሢ ዔኪ ኬሴሢ ታና ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢኬ።»<verse eid="LEV 25:38"/></para>
  <para style="s1">ዓይላቶፓ ኬስኪሢ ዛላ</para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 25:39"/>«ዒንሢ ባኣካ ናንጋ፥ ዒንሢ ፃጲ ማዔ ዒስራዔኤሌ ዓሶይዳፓ ፔቴ ዓሲ ማንቆ ማዒ ኔኤም ዓይሌ ማሂ ፔና ሻንቼቴ ዓይሌ ማሂ ዒዛ ማዺሺፖ። <verse eid="LEV 25:39"/><verse number="40" style="v" sid="LEV 25:40"/>ሻንቺንቴ ባኮ ማሂፆ ሌዓ ሄላንዳኣና ሚኢሼ ጪጊንቴም ማዻ ዓሲጉዲ ኔኤም ማዺ ማዺ ናንጎንጎ፤ <verse eid="LEV 25:40"/><verse number="41" style="v" sid="LEV 25:41"/>ዬና ሌዓ ሄላዛ ዒዛንታ ናኣቶንታ ዓይላታፓ ኬስኪ ፔ ማኣሮ ዓሶና ዒዛኮ ዓኣ ባኮና ባንሢ ዓኣዾንጎ። <verse eid="LEV 25:41"/><verse number="42" style="v" sid="LEV 25:42"/>ዒስራዔኤሌ ዴሮ ጊብፄ ዓጫፓ ታኣኒ ዔኪ ኬሴያ፥ ታኣም ማዻያታሢሮ ዔያታ ዓይሌ ማዒ ሻንቺንታንዳያ ኮይሱዋሴ። <verse eid="LEV 25:42"/><verse number="43" style="v" sid="LEV 25:43"/>ዔያቶ ዎልቄና ሄርቂ ዎይሢፖቴ፤ ታና ዒንሢኮ ፆኦዛሢ ዒጊጪ ታኣም ዓይሢንታያ ማዑዋቴ። <verse eid="LEV 25:43"/><verse number="44" style="v" sid="LEV 25:44"/>ዒንሢም ማዻ ዓሲ ዒንሢ ኮዔያ ማዔቴ ዒንሢ ኮይላ ዓኣ፥ ሜሌ ዴሮፓ ሻንቂ ዔኩዋቴ። <verse eid="LEV 25:44"/><verse number="45" style="v" sid="LEV 25:45"/>ሃሣ ዬያጉዲ ዒንሢ ባኣካ ናንጋ ሜሌ ዓጪፓ ሙኬ ዓሶና ዔያቶኮ ናኣቶናይዳፓ ማዻ ዓሲ ሻንቃኒ ዒንሢ ዳንዳዓኔ፤ ዔያታኣ ዒንሢሮ ማዖንጎ። <verse eid="LEV 25:45"/><verse number="46" style="v" sid="LEV 25:46"/>ዒንሢኮ ናኣቶም ዔያቶ ዒንሢ ዻካልሳኒያ ዳንዳዓኔ፤ ዔያታ ናንጋ ዎዶ ቢያይዳ ዒንሢ ናኣቶም ማዻያ ማዖንጎ፤ ዒንሢኮ ፃጶ ማዔ፥ ዒስራዔኤሌ ዓሶ ባኣካፓ ዓይጎ ዓሲያ ማዖም ዎልቄና ሄርቂ ዎይሢፖቴ። <note caller="-" style="x"><char style="xo" closed="false">25፡46 </char><char style="xt" closed="false"><ref loc="EXO 21:2-6">ኬሲ. ማፃ 21፡2-6</ref>፤ <ref loc="DEU 15:12-18">ላሚ. ዎማ 15፡12-18</ref>።</char></note><verse eid="LEV 25:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 25:47"/>«ዒንሢ ባኣካ ናንጋ፥ ሜሌ ዓጪፓ ሙኬ ዓሲታዖ ዖርጎቺ ማዔም ዒንሢ ባኣካፓ ፔቴ ዓሲ ማንቂ ዬያ ዓሢም ማዔቴያ ዒዛ ፃጲ ማዔያም ዓይሌ ማዒ ሻንቺንቴቴ፥ <verse eid="LEV 25:47"/><verse number="48" style="v" sid="LEV 25:48"/>ዒዚ ሻንቺንቴስካፓ ሚኢሻ ጪጊንቲ ማዔም ዓይላታፓ ኬስካኒ ዒ ዳንዳዓኔ፤ ዬያሮ ዬያ ዓሢኮ ፃጶ ማዔ ዓሶፓ ፔቴ፥ <verse eid="LEV 25:48"/><verse number="49" style="v" sid="LEV 25:49"/>ጌይፃ፦ ዒዛኮ ዓዶ ዒሾታቴያ ዓዶ ጌኤዚ፤ ሃሣ ዬያቶኮ ናኣታ፤ ሃንጎ ሃሣ ዒዛኮ ዑኬ ዒጊኒ ማዔያ ሚኢሾ ማሂ ጪጊ ዒዛ ዓይሉማፓ ኬሳኒ ዳንዳዓኔ፤ ሃንጎታቴ ዒዚ ቆሎ ዴንቄስካፓ ሚኢሾ ማሂ ጪጊ ኬስካኒ ዳንዳዓኔ። <verse eid="LEV 25:49"/><verse number="50" style="v" sid="LEV 25:50"/>ያዺ ማሃኒ ዒ ኮዓ ዎዶና ሻንቄ ዓሢና ዎላ ዞርቶንጎ፤ ዒዚ ፔና ሻንቼ ሌዓፓ ዓርቃዖ ዴንዲ ሻንቺንቴ ባኮ ማሂፆ ሌዖ ሄላንዳኣና ዓኣ ሌዖ ፓይዶንጎ፤ ዒዛ ዓይላታፓ ኬሳኒ ዳንዳዓ ሚኢሾ ዬንሢ ሌዖንሢዳ ፔቴ ዓሲ ሌዔና ሌዔና ማዼም ጪጎ ሚኢሼጉዴያ ማሊንቲ ዓርቂንቶንጎ። <verse eid="LEV 25:50"/><verse number="51-52" style="v" sid="LEV 25:51-52"/>ሃጊ ቤርታ ማዻንዳዖ ዓቴ ሌዖኮ ሚኢሾይዳፓ ዛላ ሚኢሼ ማሂ ጪጎንጎ። <verse eid="LEV 25:51-52"/><verse number="53" style="v" sid="LEV 25:53"/>ዬይ ያዺ ማዓኒ ኮይሳሢ ሌዔይዳ ሚኢሼ ጪጊንቴም ማዻ ዓሲ ማሊንቲኬ፤ ዒዛ ዎይሣ ዓሢ ዒዛ ዎልቄና ሄርቂ ዎይሦፓ። <verse eid="LEV 25:53"/><verse number="54" style="v" sid="LEV 25:54"/>ዬያይዲ ዓይላታፓ ዒ ኬስካኒ ዳንዳዒባኣቴ ሻንቺንቴ ባኮ ማሂፆ ሌዓ ሄላዛ ዒዛና ዒዛኮ ናኣቶና ዓይላታፓ ኬስኮንጎ። <verse eid="LEV 25:54"/><verse number="55" style="v" sid="LEV 25:55"/>ዒስራዔኤሌ ዓሳ ታኣም ማዻያ ማዔሢሮ ዒስራዔኤሌ ዓሲ ማዔ ዓይጎ ዓሲያ ማዖም ናንጊና ዓይሌ ማዒ ሻንቂንቲ ናንጋንዳያ ኮይሱዋሴ፤ ዓይጎሮ ጌዔቴ ዒስራዔኤሌ ዓሳ ጊብፄ ዓጫፓ ታኣኒ ኬሴ ዓሲኬ፤ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦሲኬ» ጌዔኔ።<verse eid="LEV 25:55"/></para>
  <chapter eid="LEV 25"/>
  <chapter number="26" style="c" sid="LEV 26"/>
  <para style="s1">ናንጊና ናንጋ ጎዳም ዓይሢንቲሢና ጴዻ ዓንጆ</para>
  <para style="r">(<ref loc="DEU 7:12-24">ላሚ. ዎማ 7፡12-24</ref>፤ <ref loc="DEU 28:1-14">28፡1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 26:1"/>ናንጊና ናንጋ ጎዳ ኬኤዛዖ፦ «ዚጊ ካኣሽካኒ ዓይጎ ባኣዚያ ማዖም ፆኦዞ ማሂ ማዢፖቴ፤ ዔኤቢ ማሊሲ ኮሾና ባኣዚያ ማዖም ሹቺና ዻኣቦዋ ካኣሽካኒ ዻኣቢፖቴ፤ ሹቺ ዓርሲያኣ ካኣሽኮ ባኣዚ ማሂ ጌሢፖቴ፤ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢኬ። <note caller="-" style="x"><char style="xo" closed="false">26፡1 </char><char style="xt" closed="false"><ref loc="EXO 20:4">ኬሲ. ማፃ 20፡4</ref>፤ <ref loc="LEV 19:4">ሌዊ. ዓኬ 19፡4</ref>፤ <ref loc="DEU 5:8">ላሚ. ዎማ 5፡8</ref>፤ <ref loc="DEU 16:21-22">16፡21-22</ref>፤ <ref loc="DEU 27:1">27፡1</ref>።</char></note> <verse eid="LEV 26:1"/><verse number="2" style="v" sid="LEV 26:2"/>ታኣኒ ቦንቺንቶንጎ ጌዔ ኬሎ ካፒ ቦንቹዋቴ፤ ታኣም ዱማዼ ማኣሮዋ ቦንቹዋቴ፤ ታኣኒ ናንጊና ናንጋ ጎዳሢኬ።<verse eid="LEV 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 26:3"/>«ታ ዎጎ ኩንሢ ዒንሢ ናንጋያ፤ ሃሣ ታ ዓይሢፆዋ ካፓያ ማዔቴ፦ <verse eid="LEV 26:3"/><verse number="4" style="v" sid="LEV 26:4"/>ሳዓ ዒንሢኮ ሃኣኮ ካፂሳንዳጉዲ ዒንሢ ቱካ ሚፃኣ ዓኣፓያ ማዓንዳጉዲ ዒሮ ኮይሳ ዎዶና ዒንሢም ታ ዋርቂሳንዳኔ። <verse eid="LEV 26:4"/><verse number="5" style="v" sid="LEV 26:5"/>ሃኣካ ዒንሢኮ ሚርጌና ካፃንዳሢሮ ሃኣኮ ዒንሢ ማኣላፓ ቡሪ ጋፑዋንቴ ዎይና ካፃ ዎዳ ሄላንዳኔ፤ ዎይኖኮ ዓኣፖ ዒንሢ ዔኪ ጋፑዋንቴ ጎዦ ጎሽኮ ዎዳ ሄላንዳኔ፤ ዒንሢ ሙዓንዳ ባኣዚያ ዴንቂ፥ ሳዖይዳ ኮሺ ናንጊ ናንጋንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">26፡5 </char><char style="xt" closed="false"><ref loc="DEU 11:13-15">ላሚ. ዎማ 11፡13-15</ref>፤ <ref loc="DEU 28:1-14">28፡1-14</ref>።</char></note><verse eid="LEV 26:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 26:6"/>«ዒንሢ ዓጮም ኮሹሞ ታ ዒንጋንዳኔ፤ ዖናኣ ዒጊጩዋዖ ሂርጋባኣያ ዒንሢ ጊንዓንዳኔ፤ ፑርታ ማዔ ቦዖ ዒንሢ ዓጫፓ ታ ባይዛንዳኔ፤ ዒንሢ ዖላ ዓሲያኣ ባኣያ ማዓንዳኔ። <verse eid="LEV 26:6"/><verse number="7" style="v" sid="LEV 26:7"/>ዒንሢኮ ሞርኮ ዒንሢ ባሻንዳኔ፤ <verse eid="LEV 26:7"/><verse number="8" style="v" sid="LEV 26:8"/>ዒንሢዳፓ ዶንጎ ዓሲ ሞርኮኮ ፄኤታ ዓሲ ዖሊ ባሻንዳኔ፤ ጊንሣ ሃሣ ሞርኮኮ ታጶ ሺያ ዓሲ ዒንሢኮ ፄኤታ ዓሲ ዖሊ ባባሻንዳኔ። <verse eid="LEV 26:8"/><verse number="9" style="v" sid="LEV 26:9"/>ታ ዒንሢ ዓንጃንዳኔ፤ ሚርጌ ናይያ ታ ዒንሢም ዒንጋንዳኔ፤ ታ ዒንሢና ዎላ ጫኣቄ ጫኣቁሞዋ ዋሉዋዖ ካፓንዳኔ። <verse eid="LEV 26:9"/><verse number="10" style="v" sid="LEV 26:10"/>ሌዓፓ ሌዖ ሄላ፥ ሴሚ ሃኣኮ ዒንሢኮ ዓኣያ ማዓንዳኔ፤ ዬያሮ ዓኮ ሃኣኮ ዓርሣኒ ሴሞ ሃኣኮ ኮናፓ ኬሲ ዒንሢ ላኣላንዳኔ። <verse eid="LEV 26:10"/><verse number="11" style="v" sid="LEV 26:11"/>ዓፒሎና ማዢንቴ፥ ታ ማኣሮይዳ ዴዒ ዒንሢ ባኣካ ታኣኒ ናንጋንዳኔ፤ ፔቴታዖ ታ ዒንሢ ዒፂ ሻኣኪንታዓኬ። <verse eid="LEV 26:11"/><verse number="12" style="v" sid="LEV 26:12"/>ዒንሢ ባኣካ ታኣኒ ሃንታንዳኔ፤ ዒንሢኮ ታ ፆኦዛሢ ማዓንዳኔ፤ ዒንሢያ ታ ዴሬ ማዓንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">26፡12 </char><char style="xt" closed="false"><ref loc="2CO 6:16">2ቆሮ. 6፡16</ref>።</char></note> <verse eid="LEV 26:12"/><verse number="13" style="v" sid="LEV 26:13"/>ጊብፄ ዓጫ ዓይሌ ማዒ ዒንሢ ናንጉዋጉዲ ታ ዒንሢ ኬሴ፥ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ታኣኒ ፆኦዛሢኬ፤ ባቃናኣ ዒንሢኮ ዓጎና ዓይሉሞ ቃምባሮ ሜንሢ፥ ዼግ ጌይሲ ታ ዒንሢ ሃንቲሴኔ» ጌዔኔ።<verse eid="LEV 26:13"/></para>
  <para style="s1">ፆኦሲም ዓይሢንቲ ዒፂሢ ዔኪ ሙካ ሜቶ</para>
  <para style="r">(<ref loc="DEU 28:15-68">ላሚ. ዎማ 28፡15-68</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 26:14"/>ናንጊና ናንጋ ጎዳ ኬኤዛዖ «ዒንሢ ታኣም ዋይዞ ዒፂ ታኣኮ ዓይሢፆዋ ካፒ ኩንሡዋያ ማዔቴ፥ <verse eid="LEV 26:14"/><verse number="15" style="v" sid="LEV 26:15"/>ታኣኮ ዎጎና ዓይሢፆና ካፖ ዒፂ፥ ታ ዒንሢና ዎላ ጫኣቄ ጫኣቁሞ ዒንሢ ሃሼቴ፥ <verse eid="LEV 26:15"/><verse number="16" style="v" sid="LEV 26:16"/>ታ ዒንሢ ሂዲ ሜታሳንዳኔ፤ ዬይያ፦ ዓኣፖ ዒንሢኮ ባይዛንዳያ፥ ዑፆ ዒንሢኮ ዖኦፒሳንዳያ፥ ጋፑዋ ቆሢ ዶርዖ ታ ዒንሢም ዳካንዳኔ፤ ዒጊቹሞ ሂርጋኣ ታ ዒንሢዳ ጌልዛንዳኔ፤ ዒንሢ ጎሽኬ ሃኣኮ ሞርካ ሙዓንዳሢሮ ጉሪ ዒንሢ ጎሽኪ ላባያ ማዓንዳኔ። <verse eid="LEV 26:16"/><verse number="17" style="v" sid="LEV 26:17"/>ታ ዒንሢም ዋይዞ ዒፃንዳሢሮ ዒንሢኮ ሞርካ ዒንሢ ባሻያ ማዓንዳኔ፥ ዔያታ ዒንሢ ዎይሣንዳኔ፤ ሚርጌና ዲቃታያ ዒንሢ ማዓንዳሢሮ ዒንሢ ዳውሳ ዓሲ ባኣንቴ ጉሪ ዒንሢ ጳሽካያ ማዓንዳኔ።<verse eid="LEV 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 26:18"/>«ዬይ ያዺ ማዔንቴያ ዒንሢ ታኣም ዓይሢንቱዋያ ማዔቴ ዬያጉዴ ሜቶ ላንካይ ጳንጬ ማሂ ታ ዒንሢዳ ሄሊሳንዳኔ። <verse eid="LEV 26:18"/><verse number="19" style="v" sid="LEV 26:19"/>ዒንሢኮ ዖቶርሙሞ ታ ባይዛንዳኔ፤ ዒርዚ ዒንሢም ዋርቂንዱዋኣሢሮ ሳዓ ዒንሢኮ ሜሊ ዓንጊ ማዓንዳኔ። <verse eid="LEV 26:19"/><verse number="20" style="v" sid="LEV 26:20"/>ላቢ ዒንሢ ማዻ ባካ ቢያ ዒንሢ ማኣዱዋያ ማዓንዳኔ፤ ዓይጎሮ ጌዔቴ ሳዓኣ ዒንሢኮ ሃኣኮ ካሢንዱዋኣሢሮ፤ ሃሣ ዒንሢ ቱካ ሚፃኣ ዓኣፒንዱዋኣሢሮኬ።<verse eid="LEV 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 26:21"/>«ዬይ ቢያ ማዔንቴ፥ ታኣም ዓይሢንቲፆ ዒፂፆ ሃሹዋያ ዒንሢ ማዔቴ ዒንሢ ማዻ ጎሞ ሚርጉሞ ጎይፆ ሜታሢ ላንካይ ጳንጬ ማሂ ዒንሢም ታ ቃሳንዳኔ። <verse eid="LEV 26:21"/><verse number="22" style="v" sid="LEV 26:22"/>ዒንሢ ባኣኮ ፑርታ ቦዖ ታ ዳካንዳኔ፤ ዬይ ቦዓ ናኣቶ ዒንሢኮ ሙዓንዳኔ፤ ባኣቶዋ ዒንሢኮ ሙይ ባይዛንዳኔ፤ ዻካ ዓሲ ሌሊ ዒንሢፓ ዓታንዳሢሮ ጎይፃ ዒንሢኮ ሴማንዳኔ።<verse eid="LEV 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 26:23"/>«ያዺ ማዔንቴያ ዒንሢ ታኣም ዋይዞ ዒፄቶ፥ <verse eid="LEV 26:23"/><verse number="24" style="v" sid="LEV 26:24"/>ታ ዒንሢዳ ዻጋዺ ዎንዳስካፓ ዑሣ ዓኣዼ ላንካይ ጳንጬ ማዔ ሜቶ ዒንሢዳ ታ ሄሊሳንዳኔ። <verse eid="LEV 26:24"/><verse number="25" style="v" sid="LEV 26:25"/>ታኣና ዎላ ጫኣቄ ጫኣቁሞ ዒንሢ ሃሼሢሮ ዒንሢ ሜታሳኒ ዖልዚ ታ ዔኪ ዬይሳንዳኔ፤ ሜታ ባኣያ ኮሺ ናንጋንዳኔ ጌይ ካታሞይዳ ዒንሢ ቡኪንቴቴያ ሃሹዋ ዶርዖ ታ ዒንሢም ዳካንዳኔ፤ ዒንሢ ሞርኮም ባሺንቲ ኩቺ ዒንሢ ዒንጋንዳኔ። <verse eid="LEV 26:25"/><verse number="26" style="v" sid="LEV 26:26"/>ዒንሢ ሙዓንዳ ባኣዚ ታ ባይዛንዳሢሮ ታጶ ላኣሊ ፔቴ ቦኦቆይዳ ሌሊ ላኣዳንዳኔ፤ ዬይ ካሣ ጊዳንዳቴያ ጊዲንዱዋቴያ ዓርቂ ዛጊ ዔያታ ጊሽካንዳኔ፤ ዬያ ዒንሢ ሙዓንዳኔ ጋዓንቴ ሚሽካዓኬ።<verse eid="LEV 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 26:27"/>«ዬይ ቢያ ያዺ ማዔንቴያ ታና ዒፂ፤ ሃሣ ታኣም ዓይሢንቶዋ ዒንሢ ዒፃያ ማዔቴ፥ <verse eid="LEV 26:27"/><verse number="28" style="v" sid="LEV 26:28"/>ታኣኒ ዒንሢዳ ዻጋዺ፥ ቤርታ ሄሊሴ ሜታሢዳፓ ዑሣ ዓኣዼ ሜቶ ላንካይ ጳንጬ ማዓያ ዒንሢዳ ዔኪ ዬዓንዳኔ። <verse eid="LEV 26:28"/><verse number="29" style="v" sid="LEV 26:29"/>ናያ ዒንሢ ሚርጌና ባሻንዳሢሮ ናኣቶ ዒንሢኮ ዒንሢ ሙዓንዳኔ። <verse eid="LEV 26:29"/><verse number="30" style="v" sid="LEV 26:30"/>ጌሜራ ጌሜራ ዒንሢኮ ዚጊ ካኣሽኮ ቤዞ ታ ሻሃንዳኔ፤ ዑንጆ ጩቢሶ ቤዞዋ ዒንሢኮ ታ ዶይሲ ባይዛንዳኔ፤ ሌዞ ዒንሢኮ ታኣኒ ዒንሢ ካኣሽካ ባኮኮ ሻሂ ኬኤሮናሢዳ ኬኤራንዳኔ፤ ሃሣ ዒናፓ ታ ዒፂ ሻኣኪንታንዳኔ። <verse eid="LEV 26:30"/><verse number="31" style="v" sid="LEV 26:31"/>ዒንሢ ናንጋ ካታሞ ታኣኒ ዶይሳንዳኔ፤ ዒንሢ ካኣሽካ ቤዞዋ ዒንሢኮ ታ ባይዛንዳኔ፤ ዒንሢ ታኣም ሚቺ ዒንጋ ባኮዋ ታ ዔካዓኬ። <verse eid="LEV 26:31"/><verse number="32" style="v" sid="LEV 26:32"/>ዓጮ ታ ዒንሢኮ ጉቤና ባይዛንዳኔ፤ ዒኢካ ናንጋ ዒንሢኮ ሞርካ ዬያና ዲቃቲ ሄርሻንዳጉዲ ታ ማሃንዳኔ። <verse eid="LEV 26:32"/><verse number="33" style="v" sid="LEV 26:33"/>ዖልዚ ታ ዒንሢዳ ዔቂሲ ሜሌ ዴሮ ባኣካ ዒንሢ ታ ዜርቃንዳኔ፤ ዬያሮ ዓጫ ዒንሢኮ ዓሲ ናንጉዋያ፥ ካታማኣ ዒንሢኮ ዶዔያ ማዓንዳኔ። <verse eid="LEV 26:33"/><verse number="34" style="v" sid="LEV 26:34"/>ሳዔላ ጉሪ ማዓ ዎዶና፤ ዒንሢኮ ሞርኮ ዓጮ ዒንሢ ዓኣዼ ዎዶና ሳዓ ጎሽኪንቱዋያ ሌዖይዳ ሃውሼሢሮ ዎዛዻንዳኔ፤ <verse eid="LEV 26:34"/><verse number="35" style="v" sid="LEV 26:35"/>ዒንሢ ዒዞይዳ ናንጋኣና ሃውሾ ኬሎናታዖ ዒዛ ሃውሺባኣሴ፤ ጉሪ ዒዛ ማዔ ዎዶና ጋዓንቴ ዬያ ቢያ ዒዛ ዴንቃንዳኔ።<verse eid="LEV 26:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LEV 26:36"/>«ዒንሢዳፓ ሼምፔና ዓቴ ዓሶ፤ ሃሣ ሞርኮ ዓጫ ዴንዲ ዓኣ ዓሶይዳ ዒጊቹሞ ታ ጌልዛንዳኔ፤ ዢባራ ዓጊሣ ቡኡሮ ዑኡዛ ዔያቶ ዲቃሣያ ማዓንዳኔ፤ ዔያቶ ዳውሳ ዓሲ ባኣንቴ ዖልዚሮ ዓኣሺንታ ዓሲጉዲ ጳሽኪ ሎኦሚ ዔያታ ሜቃንዳኔ። <verse eid="LEV 26:36"/><verse number="37" style="v" sid="LEV 26:37"/>ዔያቶ ዳውሳ ዓሲ ባኣንቴ ዖልዚፓ ቶላኒ ጳሽካ ዓሲጉዲ ጳሽኪ ፔቴይ ባጋሢዳ ዹቂንቲ ሎኦማንዳኔ፤ ዒንሢኮ ሞርኮ ቤርታ ዒንሢ ዶዲ ዔቃኒ ዳንዳዓዓኬ። <verse eid="LEV 26:37"/><verse number="38" style="v" sid="LEV 26:38"/>ሜሌ ዴሮ ባኣካ ዒንሢ ሃይቂ ጋፓንዳኔ፤ ዒንሢኮ ሞርኮ ዓጮይዳኣ ዒንሢ ዓኣዺ ዓታንዳኔ። <verse eid="LEV 26:38"/><verse number="39" style="v" sid="LEV 26:39"/>ዒንሢኮ ሞርኮ ዓጮይዳ ሃይቁዋዖ ዓታንዳ ዻኮ ዓሶንሢ ዔያቶ ጎሞና ዔያቶኮ ቤርታኣ ዓዶንሢ ጎማፓ ዔቄያና ዖኦፒ፥ ዻቁዋያ ማዓንዳኔ።<verse eid="LEV 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 26:40"/>«ጋዓንቴ ዒንሢ ፃጶ ማዔ ዓሳ ፔ ጎሞና ዔያቶኮ ዓዶንሢ ጎሞ ቡኡፄቴ፥ <verse eid="LEV 26:40"/><verse number="41" style="v" sid="LEV 26:41"/>ዬይያ፦ ታኣኒ ዔያቶ ዑፃ ዻጋዻንዳጉዲና ዔያቶኮ ሞርኮ ዓጮ ዔያቶ ታ ዳካንዳጉዲ ማሄ ጎሞ ዔያታ ቡኡፄቴ፥ ዋይዞ ዒፂ ዶዳ ዒና ዔያቶኮ ሺኢቴቴ፤ ሃሣ ዔያታ ማዼ ጎሞ ዛሎ ዒንጊንታ ሜቶ ዔካያ ማዔቴ፥ <verse eid="LEV 26:41"/><verse number="42" style="v" sid="LEV 26:42"/>ታኣኒ ያይቆኦቤና ዪሳኣቄና ሃሣ ዓብራሃሜና ዎላ ጫኣቄ ጫኣቁሞ ጶቂሣንዳኔ፤ ዓጮማኣ ዔያቶኮ ታ ማላንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">26፡42 </char><char style="xt" closed="false"><ref loc="GEN 17:7-8">ማዢ. ማፃ 17፡7-8</ref>፤ <ref loc="GEN 26:3-4">26፡3-4</ref>፤ <ref loc="GEN 28:13-14">28፡13-14</ref>።</char></note> <verse eid="LEV 26:42"/><verse number="43" style="v" sid="LEV 26:43"/>ሳዔላ ዔያታ ሃሺ ዓኣዼሢሮ ጉሪ ማዒ ዓታንዳኔ፤ ዔያታ ባኣያ ማዔሢሮ ጉሪ ማዒ ናንጋሢሮና ሃውሺ ዴዔሢናሮ ዎዛዻንዳኔ፤ ታኣኮ ዎጎ ዔያታ ሼሌዒሲ ዛጊ፥ ሃሣ ታኣኮ ዓይሢፆዋ ቦሂፆና ዔያቶኮ ጎሞ ዛሎ ዒንጊንታ ሜቶ ዔያታ ዔካንዳኔ። <verse eid="LEV 26:43"/><verse number="44" style="v" sid="LEV 26:44"/>ዬይ ያዺ ማዔቴያ ዔያቶና ዎላ ታ ጫኣቄ ጫኣቁሞ ሃሺ ዔያታ ፔኤኮ ሞርኮ ዓጫ ዓኣቴያ ፔቶ ዔያታ ባይቃንዳያ ሄላንዳኣና ታ ዒፂ ሃሻዓኬ፤ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዔያቶኮ ፆኦዛሢኬ። <verse eid="LEV 26:44"/><verse number="45" style="v" sid="LEV 26:45"/>ታኣኒ ዔያቶኮ ፆኦዛሢ ማዓኒ ሜሌ ዴራ ዛጋንቴ ጊብፄ ዓጮይዳፓ ታኣኒ ኬሴ፥ ዔያቶኮ ዓዶንሢና ዎላ ጫኣቄ ጫኣቁሞ ዔያቶሮ ጌይ ታ ጶቂሣንዳኔ፤ ታኣኒ ናንጊና ናንጋ ጎዳኬ» ጌዔኔ።<verse eid="LEV 26:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 26:46"/>ሙሴ ሲና ዹኮይዳ ዓኣንቴ ዒዚ ዒስራዔኤሌ ዴሮም ኬኤዛንዳጉዲ ናንጊና ናንጋ ጎዳ ዒዛም ዔርዜ ዎጎንታ ዳምቦንታ ያዺኬ።<verse eid="LEV 26:46"/></para>
  <chapter eid="LEV 26"/>
  <chapter number="27" style="c" sid="LEV 27"/>
  <para style="s1">ፆኦሲም ዒንጊሢ ዛላ ኬኤዛ ዎጌ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 27:1"/>ናንጊና ናንጋ ጎዳ ሙሴም፦ <verse eid="LEV 27:1"/><verse number="2" style="v" sid="LEV 27:2"/>«ዒስራዔኤሌ ዴሮም ሂዚ ጌዔ፤ ዓይጎ ዓሲያ ማዖም ናንጊና ናንጋ ጎዳም ዓሲ ዒንጋኒ ናኣቤያ ማዔቴ ሃካፓ ሊካ ዓኣ ሚኢሾ ዓሢ ዛሎ ጪጎንጎ፤ <verse eid="LEV 27:2"/><verse number="3-7" style="v" sid="LEV 27:3-7"/>ሌዓ ላማታሚፓ ዴንዲ ላሂታሚ ሄላ ጋራ ዓኣ ዓሲ ማዔቴ ጌኤዦ ማኣሮይዳ ሹጮ ቢሮኮ ዴኤሡሞ ዔሮ ባኮና ላሆ ፄኤታ ጊራኣሜ ማዓ ሹቺ ቢራ፤ ዬኖ ሌዖ ጋራ ዓኣ ላኣሊም ሃይሦ ፄኤታ ጊራኣሜ ማዓ ሹቺ ቢራ፤ ሌዓ ዶንጊታሚፓ ዴንዲ ላሂታሚ ሄላ ጋራ ዓኣ ዓቲንቄ ናይም ላምዖ ፄኤታ ጊራኣሜ ማዓ ሹቺ ቢራ፤ ሃሣ ዬኖ ሌዖ ጋራ ዓኣ ዉዱሮ ናይም ፄኤታና ታጶ ጊራኣሜ ማዓ ሹቺ ቢራ፤ ሌዓ ሃሣ ፔቴ ዓጊኒዳፓ ዴንዲ ዶንጎ ሌዔ ማዔ ዓቲንቄ ናይም ዶንጊታሚ ዶንጎ ጊራኣሜ ማዓ ሹቺ ቢራ፤ ዬኖ ሌዖ ጋራ ዓኣ ዉዱሮ ናይም ሃይሢታሚ ዶንጎ ጊራኣሜ ማዓ ሹቺ ቢራ፤ ሌዓ ላሂታሚፓ ዑሣ ዓኣዼ ማዔ ዓቲንቄም ፄኤታና ላንካይታሚ ጊራኣሜ ማዓ ሹቺ ቢራ፤ ዬኖ ሌዖ ጋራ ዓኣ ላኣሊም ፄኤታና ታጶ ጊራኣሜ ማዓ ሹቺ ቢራ ጪጎንጎ።»<verse eid="LEV 27:3-7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 27:8"/>«ጋዓንቴ ናኣቦ ናኣቤ ዓሢ ዬያ ጌይንቴ ሚኢሾ ጪጋኒ ዳንዳዑዋያ ማዔቴ ዒዚ ዒንጌ ዓሶማ ቄኤሳሢ ኮይላ ዔኪ ዒ ሙካዛ፥ ቄኤሳሢ ዒዚ ጪጋኒ ዳንዳዓሢጉዴያ ዓርቂ ዻካ ጪጊሶንጎ።»<verse eid="LEV 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 27:9"/>«ናኣቦና ናኣባ ፆኦሲም ዒንጎ ዒንጊሢ ማዓኒ ኮይሳ ቆልሞ ማዔቴ ዒንጊንቴ ዒንጊፃ ቢያ ናንጊና ናንጋ ጎዳም ዱማዼያ ማዖንጎ። <verse eid="LEV 27:9"/><verse number="10" style="v" sid="LEV 27:10"/>ዬይ ዓሢ ዒንጊንቴ ኮሺ ቆልሞ ሜሌ ፑርታ ዔኪ ሙኪ ላኣሚ ዒንጋኒ ኮይሱዋሴ፤ ሃሣ ፑርታ ዒንጌዖዋ ኮሺና ላኣማኒ ኮይሱዋሴ፤ ዬያይዳኒ ዔኪ ሙኪንቴቴ ላምዖ ቆልሞንሢ ቢያ ናንጊና ናንጋ ጎዳም ዱማዼያ ማዖንጎ። <verse eid="LEV 27:10"/><verse number="11" style="v" sid="LEV 27:11"/>ዒንጊንቴሢ ዳምቦ ጎይፆና ናንጊና ናንጋ ጎዳም ዒንጊንታኒ ኮይሱዋ ቆልሞ ማዔቴ ዓሢ ዬያ ዒንጊንቴ ባኮ ዔኪ ቄኤሳሢ ኮይላ ሙኮንጎ፤ <verse eid="LEV 27:11"/><verse number="12" style="v" sid="LEV 27:12"/>ዬካፓ ቄኤሳሢ ዒንጊንቴ ቆልማ ኮሺታቴያ ፑርታታቴያ ዛጊ ዔካንዳ ሚኢሾ ዓርቂ ኬኤዞንጎ፤ ዬይ ሚኢሻ ቄኤሳሢ ጌዔሢጉዲ ማዓንዳኔ። <verse eid="LEV 27:12"/><verse number="13" style="v" sid="LEV 27:13"/>ቆልሞ ዒንጌ ዓሢ ፔኤሮ ሻንቃኒ ኮዔቴ ዒንጎንጎ ጌይንቴ ሚኢሾ ዑፃ ዶንጎፓ ፔቴ ኩቺ ቃሶንጎ።<verse eid="LEV 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 27:14"/>«ፔቴ ዓሲ ፔኤኮ ማኣሮ ናንጊና ናንጋ ጎዳም ዱማዼያ ማሂ ዒንጌቴ ቄኤሳሢ ዬና ማኣሬላ ኮሺታቴያ ፑርታ ማዒፆኮ ጊቶ ዛጊ ኬሳንዳ ሚኢሾ ዓርቆንጎ፤ ቄኤሳሢ ጌዔ ጎይፆ ዬይ ማዓንዳኔ። <verse eid="LEV 27:14"/><verse number="15" style="v" sid="LEV 27:15"/>ዬኖ ማኣሬሎኮ ዓዳሢ ማሂ ሻንቃኒ ኮዔቴ ዒንጎንጎ ጌይንቴ ሚኢሾይዳ ዶንጎፓ ፔቴ ኩቺ ቃሶንጎ።<verse eid="LEV 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 27:16"/>«ፔቴ ዓሲ ፔኤኮ ሳዖይዳፓ ፓቂ ናንጊና ናንጋ ጎዳም ዱማዼ ዒንጊሢ ማሂ ዒንጌቴ ሳዔላ ዒኢካ ዜርቂንታኒ ዳንዳዓ ዜርፆ ጎይፆ ሚኢሻ ዓርቂንቶንጎ፤ ላማታሚ ኪሎ ማዓ ዔልዓ ዜርቂንታንዳ ሳዓኮ ዶንጊታሚ ሹቺ ቢራ ጪጎንጎ፤ <verse eid="LEV 27:16"/><verse number="17" style="v" sid="LEV 27:17"/>ዬይ ዓሢ ሳዖ ፔኤኮ ሻንቂንቴ ባኮ ማሂፆ ሌዓ ዒንጌያ ማዔቴ ጌይንቴ ሚኢሾ ቢያ ጪጋንዳያ ኮይሳኔ። <verse eid="LEV 27:17"/><verse number="18" style="v" sid="LEV 27:18"/>ጋዓንቴ ዒ ዒንጌሢ ሻንቂንቴ ባኮ ማሂሲፆ ሌዓ ዓኣዼንቴ ኔጌዖ ዒንጌያ ማዔቴ ቄኤሳሢ ሻንቂንቴ ባኮ ማሂፆ ሌዓ ሄላንዳሢኮ ጋራ ዓኣ ዓቴ ሌዖ ሌሊ ማሊ ሚኢሾ ዓርቆንጎ፤ ዬያሮ ሚኢሻ ፓጬ ማዓንዳኔ። <verse eid="LEV 27:18"/><verse number="19" style="v" sid="LEV 27:19"/>ሳዖ ዒንጌ ዓሢ ፔኤሮ ሻንቃኒ ኮዔቴ ዒንጎንጎ ጌይንቴሢዳ ዶንጎፓ ፔቴ ኩቺ ቃሶንጎ፤ <verse eid="LEV 27:19"/><verse number="20" style="v" sid="LEV 27:20"/>ዬይ ዓሢ ሳዔሎ ሚኢሼ ጪጊ ማሂሲ ዔኩዋዖ ዓሲም ሻንቼያ ማዔቴ ዬኖ ዒ ማሂ ዔካኒ ዳንዳዑዋሴ፤ <verse eid="LEV 27:20"/><verse number="21" style="v" sid="LEV 27:21"/>ሳዔላ ሻንቺንቴ ባኮ ማሂፆ ሌዖይዳ ናንጊና ናንጋ ጎዳም ዱማዼያ ማዒ ዓታ ቤሲ ማዔም ቄኤሳ ዔካ ቤሲ ማዓንዳኔ።<verse eid="LEV 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 27:22"/>«ፔቴ ዓሲ ባጋሢዳፓ ሻንቂ ዔኬ ሳዓ ናንጊና ናንጋ ጎዳም ዱማዼ ዒንጊሢ ማሂ ዒንጌቴ፥ <verse eid="LEV 27:22"/><verse number="23" style="v" sid="LEV 27:23"/>ቄኤሳሢ ሳዔሎ ዛጋዖ ሻንቂንቴ ባኮ ማሂፆ ሌዖ ሄላንዳኣና ጋራ ዓኣ ሌዖ ማሊ ኬሳንዳ ሚኢሾ ኬኤዛዛ ዓሢ ጌይንቴ ሚኢሾ ናንጊና ናንጋ ጎዳም ዒንጋያ ማሂ ዬኖ ኬሎ ጪጎንጎ። <verse eid="LEV 27:23"/><verse number="24" style="v" sid="LEV 27:24"/>ሻንቂንቴ ባኮ ማሂፆ ሌዖና ሳዔላ ቤርታ ሻንቼ ዓሢም ማዔቴያ ዒዛኮ ዜርፆም ማዓንዳኔ።<verse eid="LEV 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 27:25"/>«ፔቴ ፔቴ ባካ ‹ያዺ ዔካንዳኔ› ጌይንቲ ዔርታሢ ጌኤዦ ማኣሮይዳ ሚኢሾኮ ዴኤሡሞ ዔሮ ባኮና ዛጊንቲኬ።<verse eid="LEV 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 27:26"/>«ቆልሞኮ ቤርታ ሾይንቴ ናይ ናንጊና ናንጋ ጎዳሮ ማዔሢሮ ዖናታቴያ ፔ ማሊሢና ናሽኪ ዒንጋ ዒንጊሢ ማሂ ዒንጋኒ ዳንዳዑዋሴ፤ ናኣሪታቴያ ማራናይ፤ ዬያጉዲ ሃሣ ዋናናይያኣ ቤርታዺ ናንጊና ናንጋ ጎዳም ዱማዼያኬ። <verse eid="LEV 27:26"/><verse number="27" style="v" sid="LEV 27:27"/>ዎጎ ጎይፆና ናንጊና ናንጋ ጎዳም ዒንጊንታኒ ዳንዳዑዋ ቆልሞኮ ቤርቲ ናይ ማዔቴ ዒንጌ ዓሢ ‹ያዺ ኬሳንዳኔ› ጌይንቴ ሚኢሾ ዑፃ ዶንጎፓ ፔቴ ኩቺ ቃሲ ጪጊ ማሂ ዔካኒ ዳንዳዓኔ፤ ዔቦኮ ዓዴ ማሂ ዔካኒ ኮይባኣቴ ጋዓንቴ ‹ያዺ ኬሳንዳኔ› ጌይንቴ ሚኢሾና ሜሌ ዓሲ ሻንቆንጎ።<verse eid="LEV 27:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 27:28"/>«ፔቴ ዓሲ ዓሲ ማዔቴያ ቆልሞ፤ ጊንሣ ሃሣ ሳዓ ጉቤና ናንጊና ናንጋ ጎዳም ዱማዻንዳጉዲ ማሄስካፓ ሻንቻኒያ ማሂ ሻንቃኒያ ኮይሱዋሴ። <note caller="-" style="x"><char style="xo" closed="false">27፡28 </char><char style="xt" closed="false"><ref loc="NUM 18:14">ፓይ. ማፃ 18፡14</ref>።</char></note> <verse eid="LEV 27:28"/><verse number="29" style="v" sid="LEV 27:29"/>ዓሲ ማዔቴያ ሃይቃንዳጉዲ ዎጊንቴስካፓ ላሚ ጊንሣ ማሂ ሻንቃኒ ኮይሱዋሴ፤ ያዺ ጌይንቴ ዓሢ ዎዎዺንታንዳያ ኮይሳኔ።<verse eid="LEV 27:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 27:30"/>«ጎዣፓ ጴዼ ሃኣኮ ማዔቴያ ቱኪ ዓኣፒሶና ሚፆ ዓኣፖኮ ታጶይዳፓ ፔቴማ ናንጊና ናንጋ ጎዳሮ ማዒ ዒዛም ዱማዼያኬ። <verse eid="LEV 27:30"/><verse number="31" style="v" sid="LEV 27:31"/>ዬያ ዒንጊንቴ ባኮ ዓይጎዋ ማዖም ማሂ ሻንቂ ዔካኒ ኮዓ ዓሲ ‹ያዺ ኬሳንዳኔ› ጌይንቴ ሚኢሾይዳ ዶንጎፓ ፔቴ ኩቺ ቃሳንዳያ ኮይሳኔ። <verse eid="LEV 27:31"/><verse number="32" style="v" sid="LEV 27:32"/>ቆልሞ ዒንሢኮ ዒንሢ ፓይዳንዳቴ ታጶ ኩሜቴ ፔቴማ ናንጊና ናንጋ ጎዳሮኬ፤ ዬማ ቆልሞማ ናንጊና ናንጋ ጎዳም ዱማዼያ ማዓኔ። <verse eid="LEV 27:32"/><verse number="33" style="v" sid="LEV 27:33"/>ቆልሞ ዒንጌ ዓሣሢ ዒንጊንታ ቆልሞ ኮዦ ፑርቶፓ ፑርቶዋ ኮዦፓ ዱማሶፓ፤ ጊንሣ ማሂ ሃሣ ቤዛ ሜሌ ቆልሞ ዒንጎፓ፤ ዬያይዲ ላኣማኒ ዔኪ ሺኢሼቴ ላምዖንሢ ናንጊና ናንጋ ጎዳም ዱማዼያ ማዖንጎ፤ ማሂ ጊንሣ ዬይ ዓሢ ሻንቂ ዔካኒ ዳንዳዑዋሴ» ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">27፡33 </char><char style="xt" closed="false"><ref loc="NUM 18:21">ፓይ. ማፃ 18፡21</ref>፤ <ref loc="DEU 14:22-29">ላሚ. ዎማ 14፡22-29</ref>።</char></note><verse eid="LEV 27:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LEV 27:34"/>ዒስራዔኤሌ ዴሮም ኬኤዚንታንዳጉዲ ሙሴ ሲና ዹኮይዳ ዓኣንቴ ናንጊና ናንጋ ጎዳ ዒዛ ዔርዜ ዎጎና ዳምቦና ያዺኬ።<verse eid="LEV 27:34"/></para>
  <chapter eid="LEV 27"/>
</usx>
