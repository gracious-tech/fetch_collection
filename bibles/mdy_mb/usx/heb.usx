<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- MAALE Full Bible</book>
  <para style="h">ዔብሬ ዓሶም</para>
  <para style="toc1">ዔብሬ ዓሶም ዳኪንቴ ኪኢቶ</para>
  <para style="toc3">ዔብ.</para>
  <para style="toc2">ዔብሬ ዓሶም</para>
  <para style="mt1">ዔብሬ ዓሶም ዳኪንቴ ኪኢቶ</para>
  <para style="imt">ዓይፆ ካሮ</para>
  <para style="ip">ሃይ ኪኢታ ዔብሬ ዓሶም ፃኣፒንቴሢ ሚርጌ ዓሳ ዒፂ ማካያ ማዔም ፔኤኮ ጉሙርቂፆ ሃሻኒ ዑኬ፥ ኪሪስቶሴ ጉሙርቃ ዓሶምኬ፤ ሃኖ ኪኢቶ ፃኣፔ ዓሢ ፆኦሲ ፔኑሞ ጎናሲ ፔጌና ዻዌሢ ዬሱስ ኪሪስቶሴና ማዒፆ ዓማኔ ዔብሬ ዓሶም ዻዊ፥ ዔያታ ጉሙርቂፆና ዶዳንዳጉዲ ዔያቶ ዞራኔ፤ ዬያ ዒ ዞራ ዎዶና ሃይሦ ጎኑሞ ባኣዚ ዔርዛኒ ኮዔኔ፤ ዬንሢያ፦</para>
  <para style="ip">1. ሜታዼ ሜቶ ዛሎና ፆኦሲ፥ ዓዳሢም ጎኔና ዓይሢንታያ ማዔ ኪሪስቶሴ ናንጊና ናንጋ ፆኦሲ ናይኬ፤ ዒዚ ፆኦሲ ናይ ማዒፆና ሚናኣ ጫኣቃሢ ማፃኣፓ ዓኣ፥ ፆኦሲ ማሊፆ ኬኤዛ ዓሶይዳፓ፥ ፆኦሲ ኪኢታንቾይዳፓ ሃሣ ሙሴይዳፓኣ ሚርጌና ባሻያኬ።</para>
  <para style="ip">2. ዬሱሴ ሚናኣ ጫኣቃሢ ማፃኣፖይዳ ዓኣ ቄኤሳፓ ሚርጌና ባሻያ ናንጊና ናንጋ ቄኤሴ ማዒፆ ፆኦሲ ፔ ቶኦኪና ኬኤዜኔ።</para>
  <para style="ip">3. ዬሱሴ ዛሎና ፆኦሲ ጉሙርቃ ዓሲ ጎሜይዳፓ፥ ዒጊቹሞና ሃይቢናይዳፓ ዻቃንዳኔ፤ ዬሱሴ ቄኤሶኮ ጉቤ ዑሢ ማዔሢሮ ዔብሬ ዓሶ ካኣዦ ዳምቦ ጎይፆና ቆልሞ ሹኪ ዒንጊፃ ዻቂንቶኮ ሺቢ ማዒ ዓኣያታንቴ ዒዛና ጎናዺ ዔርቴኔ፤ ጋዓያኬ።</para>
  <para style="ip">ሃኖ ኪኢቶ ፃኣፔ ዓሢ ዒስራዔኤሌ ዓሶ ዛሎ ኬኤዚንታ ሃይሶናኣ ዔያቶ ባኣካፓ ዔርቴ ዓሶኮ ጉሙርቂፆ ኮኦኪንሢ ማሂ (ዓይ. 11ይዳ) ናባባ ዓሳ ፔኤኮ ጉሙርቂፆና ዶዳንዳጉዲ ዞራኔ፤ ዬያጉዲ ሃሣ ዓይ. 12ይዳ ናባባ ዓሳ ዬሱሴ ኮሺ ዛጊ፥ ፔኤኮ ጉሙርቂፆና ዶዳንዳጉዲና ዎዚ ዔያቶ ሜቶንታ ዋኣዪሢንታ ሄሌቴያ ጊቢ ዳንዳዓንዳጉዲ ዞራኔ፤ ጋፒንፆይዳ ዞሮና ላቲሢ ባኣዚና ኬኤዚ ጋፒሴኔ።</para>
  <para style="iot">ማፃኣፔላ ዱማ ዱማ ዓርቄ ባኮ</para>
  <para style="io1">ዓይሢ ካራ ፆኦሲ ፔኑሞ ኪሪስቶሴና ፔጋሲ ዻዌሢ ዛሎ (1፡1-3)</para>
  <para style="io1">ኪሪስቶሴኮ ፆኦሲ ኪኢታንቾይዳፓ ባሼ ማዒፆ (1፡4—2፡18)</para>
  <para style="io1">ኪሪስቶሴኮ ሙሴና ዒያሱናይዳፓ ባሼ ማዒፆ (3፡1—4፡13)</para>
  <para style="io1">ኪሪስቶሴኮ ቄኤሶይዳፓ ቢያ ዑሣ ማዒፆ (4፡14—7፡28)</para>
  <para style="io1">ፆኦሲ ፔ ዓሶና ጫኣቄ ጫኣቁማፓ ኪሪስቶሴኮ ባሼ ማዒፆ (8፡1—9፡28)</para>
  <para style="io1">ፆኦሲም ሺኢሺ ዒንጎ ዒንጊፆይዳፓ ኪሪስቶሴኮ ባሼ ማዒፆ (10፡1-39)</para>
  <para style="io1">ጉሙርቂፆና ቤርታዼ ዓሶ ዛሎ (11፡1—12፡29)</para>
  <para style="io1">ፆኦሲ ዎዛሲሢ ዛላ (13፡1-19)</para>
  <para style="io1">ሺኢጲሢ ሺኢቆናያ (13፡20-21)</para>
  <para style="io1">ጋፒንሢ ሃይሴ (13፡22-25)</para>
  <chapter number="1" style="c" sid="HEB 1"/>
  <para style="s1">ፆኦሲ ፔ ናዓሢ ዛሎና ኬኤዜሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1"/>ፆኦሲ ሚና ዱማ ዱማ ጎይሢና፥ ፔ ማሊፆ ኬኤዛ ዓሶ ዛሎና፥ ኑ ዓዶንሢም ሚርጌ ዎዴ ኬኤዜኔ፤ <verse eid="HEB 1:1"/><verse number="2" style="v" sid="HEB 1:2"/>ሃሢ ጋዓንቴ ሃኖ ጋፒንፆ ዎዶና ቢያ ባኮ ዒዛም ዒ ማሄ፥ ፔ ናዓሢ ዛሎና ኑም ኬኤዜኔ፤ ዓጫ ቢያ ማዢንቴሢ ዒዛናኬ። <verse eid="HEB 1:2"/><verse number="3" style="v" sid="HEB 1:3"/>ዒዚ ፆኦሲ ቦንቾኮ ማላታ ሃሣ ዒዛኮ ዓኣ ዖኑማኣ ፆኦሲና ዎላ ፔቴ ማዓያኬ፤ ጊንሣ ሃሣ ቢታንታ ዓኣ ቃኣሎና ሳዖንታ ዓኣ ባኮ ቢያ ፔቴይዳ ዒ ዓርቄያኬ፤ ዓሶኮዋ ዒ ጎሞ ጌኤሼስካፓ ጫሪንጮይዳ ዼኤፖ ፆኦዛሢኮ ሚዛቆ ዛላ ዴዔኔ።<verse eid="HEB 1:3"/></para>
  <para style="s1">ፆኦሲ ናዓሢኮ ኪኢታንቾይዳፓ ባሼ ማዒፆ</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4"/>ዒዛም ጌሢንቴ ሱንፃ ኪኢታንቾ ሱንፆይዳፓ ባሼ ማዔ ጎይፆና ፆኦሲኮ ናዓሢ ኪኢታንቾይዳፓ ቢያ ባሻያኬ። <verse eid="HEB 1:4"/><verse number="5" style="v" sid="HEB 1:5"/>ዎይቲ ጌዔቴ ፆኦሲ ኪኢታንቾ ባኣካፓ፦</para>
  <para style="q" vid="HEB 1:5">«ኔኤኒ ታኣኮ ናዓሢኬ፤ ታ ኔኤኮ ሃኖ ዓዶ ማዔኔ።»</para>
  <para style="m" vid="HEB 1:5">ሃሣ ጊንሣ፦</para>
  <para style="q" vid="HEB 1:5">«ታ ዒዛኮ ዓዶ ማዓንዳኔ፤ ዒ ታኣኮ ናኣዚ ማዓንዳኔ»</para>
  <para style="m" vid="HEB 1:5">ጌዔይ ፔቴታዖ ባኣሴ። <note caller="-" style="x"><char style="xo" closed="false">1፡5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">ዓይኑ. 2፡7</ref>፤ <ref loc="2SA 7:14">2ሳሙ. 7፡14</ref>፤ <ref loc="1CH 17:13">1ፆኦሲ. ዓሃኬ 17፡13</ref>።</char></note> <verse eid="HEB 1:5"/><verse number="6" style="v" sid="HEB 1:6"/>ፆኦሲ ፔኤኮ ቶይዶ ናዓሢ ዓጮ ዳካኣና፦</para>
  <para style="q" vid="HEB 1:6">«ፆኦሲ ኪኢታንቻ ቢያ ዒዛም ዚጎንጎ» ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡6 </char><char style="xt" closed="false"><ref loc="DEU 32:43">ላሚ. ዎማ 32፡43</ref>።</char></note><verse eid="HEB 1:6"/></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7"/>ኪኢታንቾ ዛሎ ጋዓንቴ፦</para>
  <para style="q" vid="HEB 1:7">«ኪኢታንቾ ዢባሬ፥</para>
  <para style="q2" vid="HEB 1:7">ዒዛም ማዻ ዓሶዋ ታሚ ሎስቶ ታ ማሃንዳኔ» ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡7 </char><char style="xt" closed="false"><ref loc="PSA 104:4">ዓይኑ. 104፡4</ref>።</char></note><verse eid="HEB 1:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8"/>ፔ ናዓሢ ዛሎ ጋዓንቴ፦</para>
  <para style="q" vid="HEB 1:8">«ፆኦሲዮ! ኔኤኮ ካኣቱሞ ዖይታ ናንጊና ባይቁዋዖ ናንጋንዳኔ፤</para>
  <para style="q2" vid="HEB 1:8">ኔኤኮ ካኣቱሞ ፂሉሞና ኔ ዔኪ ዓኣዻንዳኔ፤<verse eid="HEB 1:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 1:9"/>ፂሉሞ ኔ ናሽኪ ፑርቱሞ ኔ ዒፄኔ፤</para>
  <para style="q" vid="HEB 1:9">ዬያሮ ፆኦሲ፥ ኔ ፆኦዛሢ ኔና ዶኦሬኔ፤</para>
  <para style="q2" vid="HEB 1:9">ኔኤኮ ላጎይዳፓ ባሼ ዎዛ ዺቢሺ ኔኤም ዒዚ ዒንጌኔ» ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡9 </char><char style="xt" closed="false"><ref loc="PSA 45:6-7">ዓይኑ. 45፡6-7</ref>።</char></note><verse eid="HEB 1:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10"/>ዬያጉዲ ሃሣ፦</para>
  <para style="q" vid="HEB 1:10">«ጎዳሢዮ! ኔኤኒ ቤርታ ሳዖ ማዤኔ፤</para>
  <para style="q2" vid="HEB 1:10">ጫሪንጮዋ ኔ ኩቻ ኔ ማዤያኬ።<verse eid="HEB 1:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="HEB 1:11"/>ዬያታ ቢያ ባይቃንዳኔ፤</para>
  <para style="q" vid="HEB 1:11">ኔኤኒ ጋዓንቴ ናንጊና ናንጋንዳኔ፤</para>
  <para style="q2" vid="HEB 1:11">ዔያታ ዓፒላጉዲ ጪንቃንዳኔ።<verse eid="HEB 1:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="HEB 1:12"/>ሃሣ ኔ ዔያቶ ዼኤፒ ኮኦቴጉዲ ጳንጫንዳኔ፤</para>
  <para style="q2" vid="HEB 1:12">ዓፒላጉዲ ዔያታ ላኣሚንታንዳኔ፤</para>
  <para style="q" vid="HEB 1:12">ኔኤኒ ጋዓንቴ ቢያ ዎዴ ኔናኬ፤</para>
  <para style="q2" vid="HEB 1:12">ፔቴታዖ ኔ ጋርቹዋያኬ» ጋዓኔ። <note caller="-" style="x"><char style="xo" closed="false">1፡12 </char><char style="xt" closed="false"><ref loc="PSA 102:25-27">ዓይኑ. 102፡25-27</ref>።</char></note><verse eid="HEB 1:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13"/>ፆኦሲ ፔኤኮ ኪኢታንቾ ባኣካፓ፦</para>
  <para style="q" vid="HEB 1:13">«ኔ ሞርኮ ታ ኔና ባሺሳንዳያ ሄላንዳኣና</para>
  <para style="q2" vid="HEB 1:13">ታኣኮ ሚዛቆ ዛላ ዴዔ» ጌዔያ ፔቴታዖ ባኣሴ። <note caller="-" style="x"><char style="xo" closed="false">1፡13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ዓይኑ. 110፡1</ref>።</char></note><verse eid="HEB 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14"/>ዓካሪ ኪኢታንቻ ዻቃዞንሢ ማኣዳኒ ፆኦሲፓ ዳኪንቲ ማዻ፥ ዓያኖቱዋዓዳ?<verse eid="HEB 1:14"/></para>
  <chapter eid="HEB 1"/>
  <chapter number="2" style="c" sid="HEB 2"/>
  <para style="s1">ዼኤፖ ዻቂንቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1"/>ዬያሮ ኑ ዋይዜ ባኮይዳፓ ዻቢንቲ ኬስኩዋጉዲ ኑ ዋይዜ ባኮ ኮሺ ጉሙርቂ ዓርቃንዳያ ኮይሳኔ። <verse eid="HEB 2:1"/><verse number="2" style="v" sid="HEB 2:2"/>ቤርታ ፆኦሲ ኪኢታንቾ ዛሎና ኬኤዚንቴ ባካ ጎኔ ማዒ ዔርቴኔ፤ ዬያ ኬኤዚንቴ ባኮይዳፓ ዑሣ ዓኣዼሢና ዬያ ዓይሢንቴ ባኮ ኩንሡዋኣሢ ኮይሳ ሜቶ ዔካኔ፤ <verse eid="HEB 2:2"/><verse number="3" style="v" sid="HEB 2:3"/>ዓካሪ ኑኡኒ ሃሢ ሃያ ዼኤፖ ዻቂንቶ ቦሂ ሃሻያ ማዔቴ ዎዲ ኑ ቶሊ ዓታንዳይ? ሃያ ዻቂንቶ ቤርታዺ ጎዳ ኑም ፔኤሮ ኬኤዜኔ፤ ዋይዜ ዓሳኣ ጎኔ ማዒፆ ኑም ዔርዜኔ። <verse eid="HEB 2:3"/><verse number="4" style="v" sid="HEB 2:4"/>ፆኦሲያ ማላታና ዲቃሣ ባኣዚና ሃሣ ዱማ ዱማ ፔ ዎልቄና ማዺንታ ዓኪ ባኣዚ ማዺሢና ዬያጉዲ ሃሣ ዒና ናሽኬሢጉዴያ ዓያኖ ጌኤዦ ዒንጌ ዒንጊፆ ዛሎና ፔኤሮ ማርካዼኔ።<verse eid="HEB 2:4"/></para>
  <para style="s1">ዻቂንቶ ባንሢ ዔኪ ዓኣዻ ዓርናሢ</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5"/>ፆኦሲ «ሃጊ ሙካንዳኔ» ጌዒ ኑኡኒ ኬኤዛ ዓጮ ኪኢታንቻ ዎይሣንዳጉዲ ጌይባኣሴ፤ <verse eid="HEB 2:5"/><verse number="6" style="v" sid="HEB 2:6"/>ዬያ ዛሎና ጌኤዦ ማፃኣፖይዳ ፔቴ ቤስካ፦</para>
  <para style="q" vid="HEB 2:6">«ኔ ማሊ ጶቂሣንዳጉዲ ዓሲንሢ ዓይጎ ባኣዚዳይ?</para>
  <para style="q2" vid="HEB 2:6">ኔ ዔያቶ ዛሎ ማላንዳጉዲ ዓሲ ዓይጎ ባኣዚዳይ?<verse eid="HEB 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="HEB 2:7"/>ኪኢታንቾይዳፓ ዻካ ኔ ዔያቶ ሂርኪሴኔ፥</para>
  <para style="q2" vid="HEB 2:7">ቦንቺንታያና ጋላቲንታያና ማዒፆ ዔርዛ፥ ቦንቾ ባኮ ኔ ዔያቶ ቶኦካ ዓጌኔ፤<verse eid="HEB 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="HEB 2:8"/>ቢያ ባኮዋ ዔያታ ዎይሣንዳጉዲ ኔ ማሄኔ»</para>
  <para style="m" vid="HEB 2:8">ጌይንቴ ባኣዚ ዓኣኔ። ቢያሢ ዔያታ ዎይሣንዳጉዲ ማሃ ዎዶና ዔያታ ዎይሣንዳጉዲ ማሁዋዖ ሃሾና ባኣዚ ዓይጌያ ባኣሴ፤ ጋዓንቴ ሃሢ ቢያ ባኮ ዔያታ ዎይሣሢ ኑ ሃጊ ዛጊባኣሴ። <note caller="-" style="x"><char style="xo" closed="false">2፡8 </char><char style="xt" closed="false"><ref loc="PSA 8:4-6">ዓይኑ. 8፡4-6</ref>።</char></note> <verse eid="HEB 2:8"/><verse number="9" style="v" sid="HEB 2:9"/>ሃሢ ጋዓንቴ ኪኢታንቾይዳፓ ዻካ ሂርኪዶና፥ ዬሱሴ ሃይቢ ሜቶ ዔኬያታሢሮ ቦንቺንታያና ጋላቲንታያ ማዒፆ ዔርዛ፥ ቦንቾ ባኮ ቶኦካ ዓጊ ዓኣንቴ ኑ ዛጋንዳኔ፤ ፆኦሲ ዒዛም ዒንጌ ዒንጊፆና ዒዚ ኑ ዛሎሮ ሃይቄኔ። <verse eid="HEB 2:9"/><verse number="10" style="v" sid="HEB 2:10"/>ቢያ ባካ ዒዛም ሃሣ ዒዛና ናንጋ ፆኦዛሢ ሚርጌ ናኣቶ ፔ ቦንቾ ባንሢ ዔኪ ሙካኒ ጌዒ ዻቂንቶኮ ዓርና ማዔ፥ ዬሱሴ ሜቶና ሜታሲ ጊኢጌያ ማሃኒ ኮይሳያ ማዔም ማዼኔ።<verse eid="HEB 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11"/>ዓሶ ፆኦሲም ዱማሳሢና ዒዛ ዛሎና ፆኦሲም ዱማዼያ ማዔ ዓሶና ፔቴ ዓዶ ናይኬ፤ ዬያሮ ዬሱሴ ዔያቶ «ታ ዒጊኖንሢዮቴ» ጋዓኒ ሴልቁዋሴ። <verse eid="HEB 2:11"/><verse number="12" style="v" sid="HEB 2:12"/>ዬያ ዛሎ ጌኤዦ ማፃኣፖይዳ፦</para>
  <para style="q" vid="HEB 2:12">«ኔ ማዼ ባኮ ታ ዒጊኖም ታ ኬኤዛንዳኔ፤</para>
  <para style="q2" vid="HEB 2:12">ቡኪንቶ ባኣኮይዳ ዓይኑሞና ታ ኔና ጋላታንዳኔ» ጋዓኔ። <note caller="-" style="x"><char style="xo" closed="false">2፡12 </char><char style="xt" closed="false"><ref loc="PSA 22:22">ዓይኑ. 22፡22</ref>።</char></note><verse eid="HEB 2:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13"/>ዬያጉዲ፦</para>
  <para style="q" vid="HEB 2:13">«ታ ዒዛ ጉሙርቃንዳኔ» ጋዔኔ። ሃሣ ጊንሣ፦</para>
  <para style="q" vid="HEB 2:13">«ሃይሾ፥ ታኣና ፆኦሲ ታኣም ዒንጌ ናኣቶና» ጋዓኔ። <note caller="-" style="x"><char style="xo" closed="false">2፡13 </char><char style="xt" closed="false"><ref loc="ISA 8:17-18">ዒሲ. 8፡17-18</ref>።</char></note><verse eid="HEB 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14"/>ዬያሮ ናኣታ ዓሽኪና ሱጉሢና ዓኣ ዓሲ ማዔ ጎይፆ፥ ዬሱሴያ ዔያቶጉዲ ዓሲ ማዔኔ፤ ዬያ ዒ ማዼሢ ሃይቂ፥ ሃይቢዳ ቢታንቶ ዓኣ ፃላሄ ባይዛኒኬ። <verse eid="HEB 2:14"/><verse number="15" style="v" sid="HEB 2:15"/>ዬያጉዲ ሃሣ ፔ ናንጎ ዎዶ ቢያይዳ ሃይቢ ዒጊጪሢና ሃይቢ ዒጊቹሞም ዓይሌ ማዒ ናንጋ ዓሶ ዬያይዳፓ ኬሳኒኬ። <verse eid="HEB 2:15"/><verse number="16" style="v" sid="HEB 2:16"/>ዒዚ ሙኬሢ ኪኢታንቾ ማኣዳኒቱዋንቴ ዓብራሃሜ ዜርፆ ማኣዳኒ ማሊኬ፤ <verse eid="HEB 2:16"/><verse number="17" style="v" sid="HEB 2:17"/>ዬያሮ ቢያ ባኣዚና ፔ ዒሾንሢንታ ሚሾንሢንታጉዲ ማዓኒ ዒዛ ኮይሳያ ማዔም ማዼኔ፤ ዬያ ዒ ማዼሢ ዓቶም ጋዓያና ጉሙርቂንታ፥ ቄኤሶኮ ዑሢ ማዒ ፆኦሲም ማዻኒና ዓሶኮ ቢያ ጎሞ ባይዛኒኬ። <verse eid="HEB 2:17"/><verse number="18" style="v" sid="HEB 2:18"/>ዒዛ ጌሺ ዛጎና ዎዶና ዒ ሜቶ ዔኬያታሢሮ ሃሢ ጌሺፆና ዛጎዞንሢ ዒ ማኣዳኒ ዳንዳዓኔ።<verse eid="HEB 2:18"/></para>
  <chapter eid="HEB 2"/>
  <chapter number="3" style="c" sid="HEB 3"/>
  <para style="s1">ዬሱሴኮ ሙሴፓ ባሼ ማዒፆ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1"/>ፆኦሲኮ ዔኤሊፆ ዋይዚ ዔኪ ዒዛም ዱማዼያ ማዔ፥ ታ ዒሾንሦ! ታ ሚሾንሦ! ኑ ጉሙርቃንዳጉዲ ኬኤዞም ፆኦሲፓ ዳኪንቴያ ማዔሢና ኑ ካኣሽካ ካኣዦኮዋ ቄኤሶ ቢያፓ ዑሣ ማዔ፥ ዬሱሴ ዛሎ ማሉዋቴ። <verse eid="HEB 3:1"/><verse number="2" style="v" sid="HEB 3:2"/>ሙሴ ፆኦሲ ዴሮ ዔኪ ዓኣዻዖ ማዼ ማዾና ቢያ ፆኦሲም ጉሙርቂንቴያ ማዔሢጉዲ ዬሱሴ ዒዛ ዶኦሬ፥ ፆኦሲም ጉሙርቂንቴያኬ። <verse eid="HEB 3:2"/><verse number="3" style="v" sid="HEB 3:3"/>ማኣሪ ማዣ ዓሢ ማኣሮይዳፓ ባሼ ቦንቺንታሢጉዲ ዬሱሴያ ሙሴይዳፓ ባሼ ቦንቺንታኒ ኮይሳያ ማዒ ጴዼኔ፤ <note caller="-" style="x"><char style="xo" closed="false">3፡3 </char><char style="xt" closed="false"><ref loc="NUM 12:7">ፓይ. ማፃ 12፡7</ref>።</char></note> <verse eid="HEB 3:3"/><verse number="4" style="v" sid="HEB 3:4"/>ጎኔኬ ፔቴ ፔቴ ማኣሮ ማዤ ዓሲ ዓሲ ዓኣኔ፤ ጋዓንቴ ቢያ ባኮ ማዤሢ ፆኦሲኬ። <verse eid="HEB 3:4"/><verse number="5" style="v" sid="HEB 3:5"/>ሙሴ ሃጊ ኬኤዚንታንዳ ባኮ ዛሎ ማርካዺ ማርካዺ ፆኦሲ ዓሶ ዔኪ ዓኣዻዖ ማዻ ማዾና ጉሙርቂንታ ማዻ ዓሲ ማዒ ማዼኔ። <verse eid="HEB 3:5"/><verse number="6" style="v" sid="HEB 3:6"/>ኪሪስቶሴ ጋዓንቴ ማዻሢ ፆኦሲ ማኣሮይዳ ጉሙርቂንታ ናይጉዲ ማዒኬ፤ ዬይ ማኣራ ኑናኬ፤ ኑ ዒዛኮ ማኣሮ ማዓንዳሢ፦ ኑ ጉሙርቃ ባኮና ኑ ዖቶርቃ፥ ሃጊ ማዓንዳ ዎዞ ዶዲሺ ዓርቄቴኬ።<verse eid="HEB 3:6"/></para>
  <para style="s1">ፆኦሲ ዓሶም ሃውሾ ጴዻንዳሢ</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7"/>ዓያኖ ጌኤዣ ጋዓ ጎይፆ፦</para>
  <para style="q" vid="HEB 3:7">«ሃኖ ዒንሢ ፆኦሲኮ ዑኡዞ ዋይዛያ ማዔቴ፥ <note caller="-" style="x"><char style="xo" closed="false">3፡7 </char><char style="xt" closed="false"><ref loc="PSA 95:7-11">ዓይኑ. 95፡7-11</ref>።</char></note><verse eid="HEB 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="HEB 3:8"/>ዓሲ ናንጉዋ ዳውሎይዳ ዒንሢኮ ዓዶንሢ ‹ታ ዎይታቴያ› ጌዒ ማዼ ዎዶና</para>
  <para style="q2" vid="HEB 3:8">ዔያታ ዋይዞ ዒፄ ጎይፆ</para>
  <para style="q2" vid="HEB 3:8">ዒንሢኮ ዒኖ ዶዲሺ ዋይዞ ዒፃያ ማሂፖቴ።<verse eid="HEB 3:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 3:9"/>ዒንሢኮ ዓዶንሢ ዒ ዎይታቴያ ጌዒ ሚርጌ ባኣዚ ማዼኔ፤</para>
  <para style="q2" vid="HEB 3:9">ሃሣ ዖይዲታሚ ሌዔ ታ ማዼ ባኮዋ ዔያታ ዛጌኔ»</para>
  <para style="m" vid="HEB 3:9">ጋዓኔ ፆኦሲ።<verse eid="HEB 3:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="HEB 3:10"/>«ዒማና ታ ዔያቶይዳ ዻጋዺ፥</para>
  <para style="q2" vid="HEB 3:10">‹ዒና ዔያቶኮ ቢያ ዎዴ ዻቢንታኔ፤</para>
  <para style="q2" vid="HEB 3:10">ታ ጎይፆዋ ዔያታ ዔሪባኣሴ›» ጌዔኔ።<verse eid="HEB 3:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="HEB 3:11"/>ሃሣ፦ « ‹ታኣኒ ዔያቶም ዒንጋንዳኔ ጌዔ፥</para>
  <para style="q2" vid="HEB 3:11">ሃውሾ ቤዞ ፔቴታዖ ዔያታ ጌላዓኬ› ጌዒ</para>
  <para style="q2" vid="HEB 3:11">ዻጋና ታ ጫኣቄኔ» ፆኦሲ ጋዓኔ።<verse eid="HEB 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12"/>ታ ዒሾንሦ! ታ ሚሾንሦ! ዒንሢዳፓ ዖኦኒያ ናንጊና ባይቁዋ ፆኦዛሢዳፓ ሃኪሳያና ፑርታ፥ ሃሣ ጉሙርቁዋ ዒናና ዓኣያ ማዒ ጴዹዋጉዲ ዒንሢና ዔሩዋቴ። <verse eid="HEB 3:12"/><verse number="13" style="v" sid="HEB 3:13"/>ዒንሢ ባኣካፓ ዖኦኒያ ጎሜና ጌሺንቴም ዒና ዋይዚ ዒፂ ዶዳያ ማዑዋጉዲ፤ «ሃኖ» ጌይንታሢ ዓኣ ጎይሣ ዓኣንቴ ቢያ ኬሊ ዎላ ዞርቲ ዎሊ ዶዲሹዋቴ። <verse eid="HEB 3:13"/><verse number="14" style="v" sid="HEB 3:14"/>ቤርታ ኑኡኮ ዓኣ ጉሙርቂፆ ጋፒንፆ ሄላንዳኣና ኑ ዶዲሺ ዓርቃያ ማዔቴ ኪሪስቶሴና ዎላ ማዾ ባኮ ኑ ማዻያ ማዓንዳኔ። <verse eid="HEB 3:14"/><verse number="15" style="v" sid="HEB 3:15"/>ዬይያ፦</para>
  <para style="q" vid="HEB 3:15">«ሃኖ ዒንሢ ፆኦሲኮ ዑኡዞ ዋይዛያ ማዔቴ፥</para>
  <para style="q2" vid="HEB 3:15">ዒንሢኮ ዓዶንሢ ዋይዞ ዒፄ ጎይፆ</para>
  <para style="q2" vid="HEB 3:15">ዒኖ ዒንሢኮ ዶዲሺ ዋይዚ ዒፃያ ማሂፖቴ»</para>
  <para style="m" vid="HEB 3:15">ጌይንቴሢጉዲኬ።<verse eid="HEB 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16"/>ዓካሪ ዬንሢ ዑኡዞ ዋይዚ ዓይሢንቶ ዒፄዞንሢ ዖናንሢዳይ? ሙሴ ጊብፄፓ ዔኪ ኬሴ፥ ዓሶ ቢያሢቱዋዓዳ? <verse eid="HEB 3:16"/><verse number="17" style="v" sid="HEB 3:17"/>ዖይዲታሚ ሌዔ ጉቤ ፆኦሲ ዻጋሲ ናንጌ ዓሳ ዋኣቶዳይ? ዬያታ ጎሞ ማዼም ሌዛ ዓሲ ናንጉዋ ዳውሎይዳ ኬኤሪንቲ ዓቴዞንሢቱዋዓዳ? <verse eid="HEB 3:17"/><verse number="18" style="v" sid="HEB 3:18"/>ሃሣ «ታኣኮ ሃውሾ ቤዞ ጌላዓ» ጌዒ ጫኣቆናዞንሢ ዎንሢዳይ? ዬንሢ ዓይሢንቶ ዒፄዞንሢቱዋዓዳ? <verse eid="HEB 3:18"/><verse number="19" style="v" sid="HEB 3:19"/>ዓካሪ ጌላኒ ዔያታ ዳንዳዒባኣሢ ጉሙርቁዋዖ ዓቲፆና ማዔሢ ሃሢ ኑ ዛጋኔ።<verse eid="HEB 3:19"/></para>
  <chapter eid="HEB 3"/>
  <chapter number="4" style="c" sid="HEB 4"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1"/>ዓካሪ ዒዚ ኑም ዒንጋ ሃውሾይዳ ጌላንዳጉዲ ጌዒ ኑም ዒንጎና ሃጊ ማዓንዳ ዎዛ ሃጊ ዓኣ ጎይሣ ዓኣሢሮ ዒንሢዳፓ ዖኦኒያ ዬኖ ሃውሾይዳ ጌሉዋዖ ዓቱዋጉዲ ቢያሢ ሂርጊ ኑና ኑ ካፖም። <verse eid="HEB 4:1"/><verse number="2" style="v" sid="HEB 4:2"/>ዓይጎሮ ጌዔቴ ኮዦ ሃይሶ ዬኖ ዎዶና ዔያታ ዋይዜ ጎይፆ ኑኡኒያ ዋይዜኔ፤ ጋዓንቴ ዔያታ ዋይዜ ባኮ ጉሙርቂ ዔኪባኣሢሮ ዔያቶ ማኣዲባኣሴ። <verse eid="HEB 4:2"/><verse number="3" style="v" sid="HEB 4:3"/>ፆኦሲ፦</para>
  <para style="q" vid="HEB 4:3">«ታኣኒ ዔያቶም ዒንጋንዳ ሃውሾ ቤዜሎ</para>
  <para style="q2" vid="HEB 4:3">ፔቴታዖ ዔያታ ጌላዓ ጌዒ ዻጋና ታ ጫኣቄኔ» ጌዔኔ።</para>
  <para style="p" vid="HEB 4:3">ፆኦሲኮ ማዻ ሳዓ ማዢንቴሢዳፓ ዓርቃዖ ማዺንቲ ኩሜያ ማዔቴያ ኑኡኒ ጉሙርቃ ዓሳ ጋዓንቴ ዬኖ ሃውሾ ቤዜሎ ጌላንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡3 </char><char style="xt" closed="false"><ref loc="PSA 95:11">ዓይኑ. 95፡11</ref>።</char></note> <verse eid="HEB 4:3"/><verse number="4" style="v" sid="HEB 4:4"/>ዎይቲ ጌዔቴ ላንካሳ ኬሎ ዛሎ ፔቴ ቤሲዳ «ፆኦሲ ላንካሳ ኬሎና ማዾ ሃሼኔ» ጌይንቲ ፃኣፒንቴኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡4 </char><char style="xt" closed="false"><ref loc="GEN 2:2">ማዢ. ማፃ 2፡2</ref>።</char></note> <verse eid="HEB 4:4"/><verse number="5" style="v" sid="HEB 4:5"/>ዬያጉዲ ላሚ ሃሣ፦</para>
  <para style="q" vid="HEB 4:5">«ታ ዔያቶም ዒንጋ ሃውሾይዳ ፔቴታዖ ዔያታ ጌላዓ» ጋዓኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡5 </char><char style="xt" closed="false"><ref loc="PSA 95:11">ዓይኑ. 95፡11</ref>።</char></note><verse eid="HEB 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6"/>ዔያታ ኮዦ ሃይሶ ቤርታ ዋይዚ ዓይሢንቲባኣሢሮ ፆኦሲ ዔያቶም ዒንጋኒ ጌዔ ሃውሾ ቤዞ ዔያታ ጌሊባኣሴ፤ ጋዓንቴ ዒኢካ ጌላንዳጉዲ ጌይንቴ ፔቴ ፔቴ ዓሲ ዓኣኔ። <verse eid="HEB 4:6"/><verse number="7" style="v" sid="HEB 4:7"/>ቤርታ ዳውቴ ዛሎና፥</para>
  <para style="q" vid="HEB 4:7">«ሃኖ ዒንሢ ፆኦሲኮ ዑኡዞ ዋይዛያ ማዔቴ፥</para>
  <para style="q2" vid="HEB 4:7">ዒኖ ዒንሢኮ ዶዲሺ ዋይዚ ዒፃያ ማሂፖቴ»</para>
  <para style="m" vid="HEB 4:7">ጌይንቴሢጉዲ፥ ፆኦሲ ሚርጌ ዎዴኮ ጊንፃፓ «ሃኖ» ጌይ ሜሌ ኬሊ ጌሤኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡7 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">ዓይኑ. 95፡7-8</ref>።</char></note><verse eid="HEB 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8"/>ዒያሱ ፆኦሲ ዔያቶም ዒንጋንዳኔ ጌዔ ሃውሾ ዔያቶም ዒንጌያ ማዔያታቴ ፆኦሲ ሃሣ «ሃኖ» ጌዒ ሜሌ ኬሊ ኬኤዚንዱዋያታንቴኬ። <note caller="-" style="x"><char style="xo" closed="false">4፡8 </char><char style="xt" closed="false"><ref loc="DEU 31:7">ላሚ. ዎማ 31፡7</ref>፤ <ref loc="JOS 22:4">ዒያ. 22፡4</ref>።</char></note> <verse eid="HEB 4:8"/><verse number="9" style="v" sid="HEB 4:9"/>ዓካሪ ፆኦሲ ዴሮኮ ዓይሁዶ ዓሶ ሃውሾ ኬሎ ማላ ሃውሾ ኬሊ ሃጊ ዓኣኔ፤ <verse eid="HEB 4:9"/><verse number="10" style="v" sid="HEB 4:10"/>ዬያሮ ፆኦሲ ማዾ ሃሼሢጉዲ ፆኦሲ ዒንጋ ሃውሾይዳ ጌላሢያ ማዾ ሃሻንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">4፡10 </char><char style="xt" closed="false"><ref loc="GEN 2:2">ማዢ. ማፃ 2፡2</ref>።</char></note> <verse eid="HEB 4:10"/><verse number="11" style="v" sid="HEB 4:11"/>ዓካሪ ዬንሢ ዓሶንሢ ዓይሢንቶ ዒፄሢጉዲ ማዒ ኑ ዓቱዋጉዲ ፆኦሲ ዒንጋ ሃውሾይዳ ጌላኒ ኑ ዶዶም።<verse eid="HEB 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12"/>ፆኦሲኮ ቃኣላ ናንጊና ናንጋያ ሃሣ ማዾዋ ማዻያኬ፤ ላምዖ ዛላ ጉቤ ዓጬ ማዔ፥ ጬንቻ ዓፓሮይዳፓ ባሼ ዓጫያኬ፤ ሼምፓሢና ዓያኖና፥ ሻዦና ጪጊጫ ካኣማ ካሮዋ ዱማሳንዳያ ሄላንዳኣና ቲቃያኬ፤ ዒናይዳ ዓኣ ማሊሢና ሱኡኬና ዔሪ ዎጋያኬ። <verse eid="HEB 4:12"/><verse number="13" style="v" sid="HEB 4:13"/>ፆኦሲ ቤርቶይዳፓ ዓኣሺንታ፥ ዓይጎ ማዢንቲያ ባኣሴ፤ ዒዛ ቤርታ ቢያ ባኣዚ ፔጋዼያ ሃሣ ካሎ ማዒ ጴዻያኬ፤ ኑኡኒያ ኑ ዖኦጪንታ ባኮ ማሂ ኬኤዛኒ ኮይሳሢ ዒዛ ቤርቶይዳኬ።<verse eid="HEB 4:13"/></para>
  <para style="s1">ዬሱሴ ቄኤሶኮ ዑፃ ዼኤፒ ማዒፆ</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14"/>ዓካሪ ሌካ ጫሪንጮ ኬስኬ፥ ቄኤሶኮ ዑፃ ማዔ፥ ዼኤፒ ኑኡኮ ዓኣሢሮ ኑኡኮ ጉሙርቂፆ ዶዲ ኑ ዓርቆም፤ ዬይያ ፆኦሲ ናዓሢ፥ ዬሱሴኬ። <verse eid="HEB 4:14"/><verse number="15" style="v" sid="HEB 4:15"/>ኑኡኮ ዓኣ ቄኤሶኮ ዑፃሢ ማዔሢ ኑ ላቤቴ ሚጪንቲ ኑና ማኣዳኒ ዳንዳዓያኬ፤ ዒዚ ቢያ ባኣዚና ኑጉዲ ዻቢሻኒ ጌሾያይዳ ጌሌያኬ፤ ጋዓንቴ ዒ ዓይጎ ጎሜያ ማዺባኣሴ። <verse eid="HEB 4:15"/><verse number="16" style="v" sid="HEB 4:16"/>ዓካሪ ጎሜኮ ዓቶም ጌይሢ ኑ ዴንቃንዳጉዲና ኑም ኮይሳ ዎዶና ኑና ማኣዳ ፆኦሲ ኮሹሞ ዒንጊፆ ኑ ዴንቃንዳጉዲ ዒዛኮ ኮሹማ ጴዻ ካኣቱሞ ዖይቶ ባንሢ ጉሙርቂሢና ኑ ሺኢኮም።<verse eid="HEB 4:16"/></para>
  <chapter eid="HEB 4"/>
  <chapter number="5" style="c" sid="HEB 5"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1"/>ቄኤሶኮ ቢያ ዑሢ ማዓ ፔቴ ፔቴ ዓሳ ፔ ዓሶ ባኣካፓ ዶኦሪንታኔ፤ ዬያታ ፆኦሲም ማዺንታ ባኮና ዓሲ ዛላ ዔቂ ጎሜ ዓቶም ጌይሳ ዒንጊፆ ዒንጋኒ ዶኦሪንታኔ። <verse eid="HEB 5:1"/><verse number="2" style="v" sid="HEB 5:2"/>ዒዚ ፔ ቶኦኪና ላቢንታያ ማዔሢሮ ዔሩዋ ዓሶና ላቢንታ ዓሶናም ሚጪንቲ ማኣዳኒ ዳንዳዓኔ። <verse eid="HEB 5:2"/><verse number="3" style="v" sid="HEB 5:3"/>ዒዚ ፔ ጎሞና ሜሌ ዓሶ ጎሞና ዛሎ ዒንጎ ባኮ ዒንጋኒ ዒዛ ኮይሴሢ ዬያ ዛሎናኬ። <note caller="-" style="x"><char style="xo" closed="false">5፡3 </char><char style="xt" closed="false"><ref loc="LEV 9:7">ሌዊ. ዓኬ 9፡7</ref>።</char></note> <verse eid="HEB 5:3"/><verse number="4" style="v" sid="HEB 5:4"/>ዓኣሮኔጉዲ ፆኦሲ ዔኤሊባኣያ ማዔቴ ዖኦኒያ ዬያ ቦንቾ ፔኤሮ ዴንቃ ዓሲ ባኣሴ፤ <note caller="-" style="x"><char style="xo" closed="false">5፡4 </char><char style="xt" closed="false"><ref loc="EXO 28:1">ኬሲ. ማፃ 28፡1</ref>።</char></note><verse eid="HEB 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5"/>ዬያጉዲ ኪሪስቶሴ ቄኤሶኮ ቢያ ዑሢ ማሃ፥ ቦንቾ ፔኤሮ ዔኪ ቦንቺንቲባኣሴ፤ ጋዓንቴ ዒዚ ቄኤሶኮ ቢያ ዑሢ ማሃ ቦንቾ ዔኬሢ፦</para>
  <para style="q" vid="HEB 5:5">«ኔኤኒ ታኣኮ ናዓሢኬ፤</para>
  <para style="q2" vid="HEB 5:5">ታኣኒ ኔኤኮ ሃኖ ዓዶ ማዔኔ» ጌዔ ፆኦዛሢዳፓኬ። <note caller="-" style="x"><char style="xo" closed="false">5፡5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">ዓይኑ. 2፡7</ref>።</char></note><verse eid="HEB 5:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6"/>ዬያጉዲ ሃሣ ሜሌ ቤስካ ፆኦሲ፦</para>
  <para style="q" vid="HEB 5:6">«ሜልኬፃዲቄ ቄኤሴ ማዒ ዶኦሪንቴሢጉዲ</para>
  <para style="q2" vid="HEB 5:6">ኔኤኒ ናንጊና ናንጋንዳ ቄኤሴኬ» ጋዓኔ። <note caller="-" style="x"><char style="xo" closed="false">5፡6 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ዓይኑ. 110፡4</ref>።</char></note><verse eid="HEB 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7"/>ዬሱሴ ዓሲ ማዒ ሃያ ሳዖይዳ ናንጌ ዎዶና ሃይቢዳፓ ዒዛ ዻቂሻንዳ ፆኦዛሢ ዼኤፒ ዒላቲና ሃሣ ዬኤኪ ዬኤኪ ፔ ማሊፆ ኬኤዚ ሺኢቄኔ፤ ዒዚ ሼሌዑሞና ዓይሢንቴሢሮ ፆኦሲ ዒዛኮ ዒማና ሺኢጲፆ ዋይዜኔ። <note caller="-" style="x"><char style="xo" closed="false">5፡7 </char><char style="xt" closed="false"><ref loc="MAT 26:36-46">ማቲ. 26፡36-46</ref>፤ <ref loc="MRK 14:32-42">ማር. 14፡32-42</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22፡39-46</ref>።</char></note> <verse eid="HEB 5:7"/><verse number="8" style="v" sid="HEB 5:8"/>ዎዚ ዒ ፆኦሲ ናይ ማዔቴያ ዒዛ ሄሌ ሜታሢ ዛሎና ዓይሢንቲሢ ዒ ዔሬኔ። <verse eid="HEB 5:8"/><verse number="9" style="v" sid="HEB 5:9"/>ዬያና ዒ ጊኢጌያ ማዒ ጴዼስካፓ፥ ዓይሢንታዞንሢም ቢያ ናንጊና ዻቂንታኮ ካራ ማዔኔ። <verse eid="HEB 5:9"/><verse number="10" style="v" sid="HEB 5:10"/>ሜልኬፃዲቄ ዶኦሪንቴሢጉዲ ፆኦሲ ዒዛ ቄኤሶኮ ቢያ ዑፃሢ ማሂ ዶኦሬኔ።<verse eid="HEB 5:10"/></para>
  <para style="s1">ጉሙርቂፆና ዓሳ ዶዳንዳጉዲ ላቲ ኬኤዚንቴ ባኣዚ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11"/>ዬያ ዛሎ ሚርጌ ኑ ኬኤዛንዳ ባኣዚ ናንጊታንቴ ዑኬ ዒንሢም ዔኤቢ ጌሉዋኣሢሮ ዒንሢም ኬኤዚ ዔርዛኒ ሜቶኬ። <verse eid="HEB 5:11"/><verse number="12" style="v" sid="HEB 5:12"/>ሄኤዶ ሄሊ ዒንሢ ናንጌ ጎይፆና ሴካ ዓሲ ዔዔርዛንዳያታዖ ፆኦሲ ቃኣሎኮ ዓይፆ ካሮ ሜሌ ዓሲ ሃጊ ዒንሢ ዔርዛንዳያ ኮይሳኔ፤ ዬይ ዒንሢም ኮይሳሢያ ዲኢቂ ማዓንዳኣፓዓቴም ዶዲ ሙኡዚቱዋሴ። <verse eid="HEB 5:12"/><verse number="13" style="v" sid="HEB 5:13"/>ዓይጎሮ ጌዔቴ ዲኢቂ ሺሺንቂ ዑሾሢ ቢያ ናይ ማዔሢሮ ፂሉሞ ዛላ ዔራቶ ባኣዚ ሃጊ ዔሪባኣያኬ። <note caller="-" style="x"><char style="xo" closed="false">5፡13 </char><char style="xt" closed="false"><ref loc="1CO 3:2">1ቆሮ. 3፡2</ref>።</char></note> <verse eid="HEB 5:13"/><verse number="14" style="v" sid="HEB 5:14"/>ዶዲ ሙኡዚ ኮይሳሢ ጋዓንቴ ኮዦና ፑርቶና ዱማሲ ዛጊ ዔሬ ዒናዼ ዓሲምኬ።<verse eid="HEB 5:14"/></para>
  <chapter eid="HEB 5"/>
  <chapter number="6" style="c" sid="HEB 6"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1"/>ኪሪስቶሴ ዛሎ ኬኤዚንቴ፥ ቤርታሳ ዔርዚፆ ሃሺ ሚርጌና ዔርዛ ዔርዚፆ ባንሢ ኑ ዓኣዾም፤ ፓሡዋ ማዾ ማዔ፥ ጎሜ ቡኡፂሢ ዛላና ፆኦሲ ጉሙርቂሢ ዛላና ጊንሣ ኑ ሺሪ ሺሪ ዒዞ ዒንሢም ኬኤዛዓኬ። <verse eid="HEB 6:1"/><verse number="2" style="v" sid="HEB 6:2"/>ዬያጉዲ ዋኣሢ ማስቲሢ ዛላ፥ ኪሪስቶሴ ጉሙርቃ ዓሶ ዑፃ ኩቺ ጌሥሢ ዛላ፥ ሃይቄ ዓሶኮ ዔቂሢ ዛላ፥ ፆኦሲ ናንጊና ዎጋንዳ ዎጎ ዛሎ ላሚ ዒንሢም ኑ ኬኤዛኒ ኮይሱዋሴ። <verse eid="HEB 6:2"/><verse number="3" style="v" sid="HEB 6:3"/>ፆኦሲ ጌዔቴ ዬያ ኑ ማዻንዳኔ።<verse eid="HEB 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4"/>ጉሙርቂፆ ሃሺ፥ ፆኦሲ ጎይፃፓ ኬስኬ ዓሶ ላሚ ፆኦሲ ባንሢ ማሃኒ ዳንዳዒንቱዋያኬ፤ ዬያቶም ሃያኮ ቤርታ ፖዒ ፖዔያኬ፤ ሃሣ ዔያታ ጫሪንጫፓ ዒንጊንታ ዒንጊፆዋ ዔኪ ዛጌያ፥ ዓያኖ ጌኤዦናኣ ዎላ ፔቴ ማዔያኬ፤ <verse eid="HEB 6:4"/><verse number="5" style="v" sid="HEB 6:5"/>ሃሣ ዔያታ ፆኦሲኮ ኮዦ ቃኣሎና ሃጊ ሙካንዳ ዓጮኮ ዎልቆ ዛጊ ዔሬያኬ፤ <verse eid="HEB 6:5"/><verse number="6" style="v" sid="HEB 6:6"/>ዬያ ቢያ ዛጌስካፓ ጉሙርቂፆ ሃሺ፥ ኬስኬ ዓሶ ላሚ ጊንሣ ፆኦሲ ባንሢ ማሃኒ ዳንዳዒንቱዋሴ፤ ዓይጎሮ ጌዔቴ ዔያታ ፆኦሲኮ ናዓሢ ላሚ ጊንሣ ሱፂ፥ ዒዛኮ ቶኦኪያ ባይዚሳሢሮኬ።<verse eid="HEB 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7"/>ሚርጌ ዎዴ ዒዞይዳ ዋርቃ ዒሮ ዑሽካያ፤ ሃሣ ዒዞ ጎሽካሢም ኮይሳ ባኣዚ ባቃልሳያ ማዔ ሳዔሎ ፆኦሲ ዓንጃኔ። <verse eid="HEB 6:7"/><verse number="8" style="v" sid="HEB 6:8"/>ዓንጊሢና ጋውዲና ባቃልሳ ሳዔላ ጋዓንቴ ፓሣ ባኣዚ ባኣያ ጉሪ ማዓንዳኔ፤ ሃሣ ዒዛ ጋዳንቂንታኒያ ዑኬኔ፤ ጋፒንፃ ዒዞኮ ታሚና ሚቺንቲ ማዓንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">6፡8 </char><char style="xt" closed="false"><ref loc="GEN 3:17-18">ማዢ. ማፃ 3፡17-18</ref>።</char></note><verse eid="HEB 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9"/>ዒጊኖንሢዮቴ! ዎዚ ኑ ያዺ ጌዔቴያ ዒንሢኮ ዻቂንቶና ዎላ ዒንሢም ዒንጊንቴ ኮሺ ባኣዚ ዓኣሢ ኑ ዔራኔ። <verse eid="HEB 6:9"/><verse number="10" style="v" sid="HEB 6:10"/>ፆኦሲ ፒዜ ዎጋያታሢሮ ቤርታ ማዔቴያ ሃሢ ዒዛም ዱማዼ ዓሶ ናሽኪ፥ ዒዛ ሱንፆሮ ዒንሢ ማኣዴ ማኣዲፆ ዒ ዋሊንዱዋሴ። <verse eid="HEB 6:10"/><verse number="11" style="v" sid="HEB 6:11"/>ዒንሢ ቢያሢ ሃጊ ማዓንዳ ዎዞ ጌሢ ካፓ ባኮ ዴንቃንዳያ ሄላንዳኣና ዒንሢ ዶዲ ማዻ ማዾ ጋፒንሢ ሄሊሲ ማዻንዳጉዲ ኑ ኮዓኔ፤ <verse eid="HEB 6:11"/><verse number="12" style="v" sid="HEB 6:12"/>ኑ ኮዓሢ ጉሙርቂሢና ጊቢ ዳንዳዒሢና ዶዲ ሃጊ ማዓንዳ ዎዛ ማሂ ዔያቶም ዒንጊንቴ ባኮ ዴንቄ ዓሶጉዲ ማዖም ጌዒ ማዓንዳኣፓዓቴም ዋይዜ ባኮ ዑኬና ዔኩዋ ዓሲ ዒንሢ ማዓንዳጉዲቱዋሴ።<verse eid="HEB 6:12"/></para>
  <para style="s1">ፆኦሲ ዒንጌ ሃጊ ማዓንዳ ዎዛ ሉኡቁዋያ ማዔሢ</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13"/>ፆኦሲ ዓብራሃሜም ሃጊ ማዓንዳ ዎዞ ዒንጋ ዎዶና ዒ ሜሌ ዔኤሊ ጫኣቃንዳ ባኣዚ ባኣሢሮ ፔና ዔኤሊ፦ <verse eid="HEB 6:13"/><verse number="14" style="v" sid="HEB 6:14"/>«ጎኔና ታ ኔና ዓንጃንዳኔ፤ ኔኤኮ ዜርፆዋ ታ ሚርጊሻንዳኔ» ጌዒ ጫኣቄኔ። <note caller="-" style="x"><char style="xo" closed="false">6፡14 </char><char style="xt" closed="false"><ref loc="GEN 22:16-17">ማዢ. ማፃ 22፡16-17</ref>።</char></note> <verse eid="HEB 6:14"/><verse number="15" style="v" sid="HEB 6:15"/>ዓብራሃሜ ጊቢ ዳንዳዒ ካፒ፥ ዒዛም ዒንጊንታንዳኔ ጌይንቲ ሃጊ ማዓንዳ ዎዛ ማሂ ኬኤዚንቴ ባኮ ዴንቄኔ። <verse eid="HEB 6:15"/><verse number="16" style="v" sid="HEB 6:16"/>ዓሲ ጫኣቃዖ ፔ ጊዳፓ ዑሣ ባሼ ማዔ ባኣዚ ዔኤሊ ጫኣቃኔ፤ ዔያታ ጫኣቃ ጫኣቁማ ዔያቶ ባኣካ ዓኣ ጌኤዞ ጎናሳሢሮ ዔያቶኮ ማርማሢ ጋፓኔ። <verse eid="HEB 6:16"/><verse number="17" style="v" sid="HEB 6:17"/>ዬኖ ጎይፆ ፆኦሲ ጌዔ ባኮ ሺርሺ ላኣሙዋያ ማዔሢ ዔርዛኒ ሃጊ ማዓንዳ ዎዞ ዴንቃ ዓሶም ዬያ ዎዞ ጫኣቁሞና ጎናሴኔ። <verse eid="HEB 6:17"/><verse number="18" style="v" sid="HEB 6:18"/>ፆኦሲ ፔቴታዖ ሉኡቁዋያኬ፤ ዒዚ ላምዖ ዬንሢ ላኣሚንቱዋ ባኮንሢና ኑኡኮ ቤርታ ሃጊ ዓኣ ዎዞ ኑ ዴንቃኒ ዒዛ ባንሢ ዓኣሺንቲ ጌሌ ዓሶ፥ ኑም ዼኤፒ ዶዱሞ ዒዛፓ ዴንቃንዳጉዲ ኑና ማሄኔ። <verse eid="HEB 6:18"/><verse number="19" style="v" sid="HEB 6:19"/>ዬይ ሃጋኣ ዎዛ ኑኡኮ ናንጎ ዓጊፁዋያ ማሃ ጉሙርሳ ቱርቱሪኬ፤ ዬይያ፦ ጎኦቦና ዓፒሎ ጊዴና ዓኣዺ ጌኤዦ ማኣሮኮ ጋራ ዓኣ ጋሮ ጌላኔ። <note caller="-" style="x"><char style="xo" closed="false">6፡19 </char><char style="xt" closed="false"><ref loc="LEV 16:2">ሌዊ. ዓኬ 16፡2</ref>።</char></note> <verse eid="HEB 6:19"/><verse number="20" style="v" sid="HEB 6:20"/>ዬያ ጌኤዦ ማኣሮ ዬሱሴ ሜልኬፃዲቄጉዲ፥ ቄኤሴ ማዒ ዶኦሪንቲ ኑ ዛሎሮ ቤርታዺ ቄኤሴኮ ቢያ ዑሢ ማዒ ናንጊና ማዻኒ ዒኢካ ጌሌኔ።<verse eid="HEB 6:20"/></para>
  <chapter eid="HEB 6"/>
  <chapter number="7" style="c" sid="HEB 7"/>
  <para style="s1">ቄኤሳሢ ሜልኬፃዲቄ ዛላ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1"/>ዬይ ሜልኬፃዲቄ ጎዖሢ ሳላሜ ጌይንታ ካታሞኮ ካኣቲ፤ ሃሣ ዼኤፖ ፆኦዛሢማኣ ማዻ ቄኤሴኬ፤ ዬይ ዓሢ ሚና ዓብራሃሜ ካኣቶ ዖሎና ባሺ፥ ማዒ ሙካንቴ ጎይፃ ካኣሚ ዓብራሃሜ ዓንጄኔ። <verse eid="HEB 7:1"/><verse number="2" style="v" sid="HEB 7:2"/>ዓብራሃሜያ ዒማና ዔኪ ሙኬ ባካፓ ታጶይዳፓ ፔቴማ ኬሲ ኬሲ ዒዛም ዒንጌኔ፤ ዒዛ ሱንፆኮ ቡሊፃ ላምዖኬ፤ ፔቴዛ፦ «ፂሉሞ ካኣቲ» ጌይንታዛ፥ ባጋ፦ «ሳላሜ ካታሞ ካኣቲኬ»፥ ዬና ጌይፃ ኮሹሞ ካኣቲ ጌይሢኬ። <verse eid="HEB 7:2"/><verse number="3" style="v" sid="HEB 7:3"/>ሜልኬፃዲቄኮ ዓዶና ዒንዶና ሃሣ ዒ ሾይንቴ ዜርሢያ ባኣያኬ፤ ዒዚ «ዬማፓ ዬማ ሄላንዳኣና ናንጌኔ» ጌይንቲ ዔርቱዋያ፥ ናንጎኮ ዒዛኮ ጋፒንሢ ባኣያኬ፤ ዒዚ ፆኦሲ ናዓሢኮ ኮኦኪንሢ ማዒ ናንጊና ቄኤሴ ማዒ ናንጋኔ።<verse eid="HEB 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4"/>ሂንዳ ዬይ ዓሢ ዎማዒ ዼኤፒታቴያ ዛጉዋቴ! ዒስራዔኤሌ ማኣሮ ዓሶ ፃጶኮ ዓዳሢ ማዔ፥ ዓብራሃሜታዖ ዒዚ ዖሎና ዲዒ ዔኬ ባኮይዳፓ ታጶይዳፓ ፔቴማ ዒዛም ዒንጌኔ። <verse eid="HEB 7:4"/><verse number="5" style="v" sid="HEB 7:5"/>ቄኤሴ ማዓንዳጉዲ ጌሢንቴ ሌዊ ዜርፃ ፔ ዓሶይዳፓ ታጶፓ ፔቴማ ፔቴማ ዔካንዳጉዲ ዔያቶም ዓይሢንቴኔ፤ ዬይ ያዺ ጌይንቴሢ ዓብራሃሜ ዜርፃፓ ዔካንዳጉዲኬ። <note caller="-" style="x"><char style="xo" closed="false">7፡5 </char><char style="xt" closed="false"><ref loc="NUM 18:21">ፓይ. ማፃ 18፡21</ref>።</char></note> <verse eid="HEB 7:5"/><verse number="6" style="v" sid="HEB 7:6"/>ዬይ ሜልኬፃዲቄ ሌዊ ዜርፃፓ ማዒባኣያታቴያ ዓብራሃሜ ዒንጌ ታጳሢዳፓ ፔቴማ ፔቴማ ዔኬኔ፤ ሃሣ ሃጊ ማዓንዳ ዎዛ ዒንጊንቴ ዓብራሃሜያ ዒ ዓንጄኔ። <verse eid="HEB 7:6"/><verse number="7" style="v" sid="HEB 7:7"/>ዓንጆ ዓንጂንታሢዳፓ ዓንጃሢ ባሼ ማዒፃ ዔርቴያኬ። <verse eid="HEB 7:7"/><verse number="8" style="v" sid="HEB 7:8"/>ቄኤሳ ማዻ ጎይፆና ታጳፓ ፔቴማ ፔቴማ ዔካዞንሢ ሃይቃ ዓሲ ማዔ፥ ሌዊ ዓሶኬ፤ ፔቴ ዛሎና ጊንሣ ታጶይዳፓ ፔቴማ ፔቴማ ዔካሢ ባይቁዋያ ማዒ ናንጋያታሢ ማርካዺንቴ ሜልኬፃዲቄኬ። <verse eid="HEB 7:8"/><verse number="9" style="v" sid="HEB 7:9"/>ዓካሪ ታጶይዳፓ ፔቴማ ዔካንዳያ ኮይሳሢ ሌዊ ፔ ቶኦኪና ዓብራሃሜ ዛሎና ሜልኬፃዲቄም ዒንጌኔ ጌይሢኬ። <verse eid="HEB 7:9"/><verse number="10" style="v" sid="HEB 7:10"/>ዎይቲ ጌዔቴ ሜልኬፃዲቄ ዓብራሃሜና ካኣሜ ዎዶና ሌዊ ሃጊ ፔ ዓዶ፥ ዓብራሃሜይዳፓ ሾይንቲ ባኣያታሢሮኬ።<verse eid="HEB 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11"/>ዓካሪ ዒስራዔኤሌ ዴሮም ዎጋ ዒንጊንቴሢ ሌዊ ዜርፃ ቄኤሴ ማዒ ማዻ ዳምቦናኬ፤ ዬይ ዜርፃ ቢያ ባኮ ኩንሢ ማዻኒ ዳንዳዔያ ማዔያታቴ ዓኣሮኔ ቄኤሴ ማዒ ማዼ ጎይፆቱዋንቴ ሜልኬፃዲቄጉዲ ዶኦሪንቴ ሜሌ ቄኤሴ ሙካኒ ኮይሲንዱዋያታንቴኬ። <verse eid="HEB 7:11"/><verse number="12" style="v" sid="HEB 7:12"/>ሃሢ ጋዓንቴ ቄኤሳ ላኣሚንቲ፥ ሜሌ ሙካኣና ዎጋኣ ላኣሚንታንዳያ ኮይሳኔ። <verse eid="HEB 7:12"/><verse number="13" style="v" sid="HEB 7:13"/>ሃይ ቢያ ዒዛ ዛሎ ኬኤዚንቴ ቄኤሳሢ ሜሌ ፃጳፓኬ፤ ዬኖ ፃጳፓ ዖኦኒያ ፆኦሲም ዒንጊ ካኣሽኮ ቤዛ ሙኪ ፆኦሲም ማዼይ ባኣሴ። <verse eid="HEB 7:13"/><verse number="14" style="v" sid="HEB 7:14"/>ኑ ጎዳሢ ዪሁዳ ዜርፃፓ ሙኬሢ ዔርቴያኬ፤ ጋዓንቴ ሙሴ ቄኤሶ ዛሎ ኬኤዛዖ ዪሁዳ ማኣሮ ዛሎ ኬኤዜ ባኣዚ ፔቴታዖ ባኣሴ።<verse eid="HEB 7:14"/></para>
  <para style="s1">ዬሱስ ኪሪስቶሴ ሜልኬፃዲቄጉዲ ቄኤሴ ማዔሢ</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15"/>ዬይ ባካ ኮሺ ፔጋዺ ዔርታንዳሢ ሜልኬፃዲቄጉዴያ ሜሌ ቄኤሴ ሙካዛኬ፤ <verse eid="HEB 7:15"/><verse number="16" style="v" sid="HEB 7:16"/>ዒዚ ቄኤሴ ማዔሢ ዓሲ ዎጌና ዶኦሪንቲቱዋንቴ ባይቁዋያ ማዔ፥ ናንጊና ናንጋ ዎልቄና ዶኦሪንቲኬ፤ <verse eid="HEB 7:16"/><verse number="17" style="v" sid="HEB 7:17"/>ዎይቲ ጌዔቴ፦</para>
  <para style="q" vid="HEB 7:17">«ሜልኬፃዲቄ ቄኤሴ ማዒ ዶኦሪንቴሢጉዲ፥</para>
  <para style="q2" vid="HEB 7:17">ኔኤኒ ናንጊና ናንጋንዳ ቄኤሴኬ»</para>
  <para style="m" vid="HEB 7:17">ጌይንቲ ዒዛ ዛሎ ማርካዺንቴኔ። <note caller="-" style="x"><char style="xo" closed="false">7፡17 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ዓይኑ. 110፡4</ref>።</char></note> <verse eid="HEB 7:17"/><verse number="18" style="v" sid="HEB 7:18"/>ቤርታኣ ዎጋ ዶዲ ማዒ ዴዓኒ ዳንዳዒባኣሢሮ ሃሣ ፓሡዋያ ማዔሢሮ ዓቴኔ፤ <verse eid="HEB 7:18"/><verse number="19" style="v" sid="HEB 7:19"/>ዓይጎሮ ጌዔቴ ሙሴ ዔርዜ ዎጋ ዓይጎ ባኣዚያ ፒዚሲ ጊኢጊሻኒ ዳንዳዒባኣሢሮኬ፤ ሃሢ ጋዓንቴ ፆኦሲ ባንሢ ዒዛና ኑ ዑካንዳያ ባሼ ኮሺ ማዔ፥ ሃጊ ማዓንዳ ዎዛ ኑም ሙኬኔ።<verse eid="HEB 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20"/>ዬይ ቄኤሴ ማዒፃ ዒዛም ፆኦሲ ጫኣቂባኣንቴ ማዔያቱዋሴ፤ ሜሌ ቄኤሳ ጋዓንቴ ሃያኮ ቤርታ ቄኤሴ ማዓሢ ጫኣቆና ባኣዚ ባኣንቴኬ፤ <verse eid="HEB 7:20"/><verse number="21" style="v" sid="HEB 7:21"/>ዒዚ ቄኤሴ ማዔሢ ዒዛም ጫኣቆምኬ፤ ዎይቲ ጌዔቴ፦</para>
  <para style="q" vid="HEB 7:21">«ጎዳ ‹ኔኤኒ ናንጊና ናንጋ ቄኤሴኬ› ጌዒ ዒዛም ጫኣቄኔ፤</para>
  <para style="q2" vid="HEB 7:21">ዬያ ማሊፆ ዒ ሺርሹዋሴ»</para>
  <para style="m" vid="HEB 7:21">ጌይንቲ ዒዛ ዛሎ ኬኤዚንቴያኬ። <note caller="-" style="x"><char style="xo" closed="false">7፡21 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ዓይኑ. 110፡4</ref>።</char></note><verse eid="HEB 7:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 7:22"/>ዬያ ጫኣቁሞ ዛሎና ዬሱሴ ቢያፓ ባሼ ማዔ፥ ፆኦሲ ጫኣቁሞኮ ዖኦጪንታኒ ዔቄያ ማዔኔ።<verse eid="HEB 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23"/>ፔቴ ቄኤሴ ሃይቁዋዖ ማዺ ማዺ ናንጋኒ ዳንዳዒባኣሢሮ ቤርታ ዎንዴ ማዼ ቄኤሶኮ ፓይዳ ሚርጌኬ፤ <verse eid="HEB 7:23"/><verse number="24" style="v" sid="HEB 7:24"/>ዬሱሴ ጋዓንቴ ናንጊና ናንጋያ ማዔሢሮ ቄኤሴ ማዒፃ ዒዛኮ ላኣሚንቱዋያኬ። <verse eid="HEB 7:24"/><verse number="25" style="v" sid="HEB 7:25"/>ዬያሮ ዒዛ ባንሢ ሙካ ዓሶ ዛሎ ሺኢቃኒ ናንጊና ባይቁዋያ ማዒ ናንጋሢሮ ዒዛ ዛሎና ፆኦሲ ባንሢ ሙካዞንሢ ቢያ ጎኔና ዻቂሻኒ ዒ ዳንዳዓኔ።<verse eid="HEB 7:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26"/>ዓካሪ፤ ኑም ኮይሳያ፥ ፆኦሲም ዱማዼያ፥ ቦሂሳ ባኣዚ ባኣያ ማዔያ፥ ጌኤሺ ማዔያ፥ ጎሞ ዓሶፓ ዱማዼያ፥ ጫሪንጮኮ ዑፃ ዼግ ጌዒ ቦንቺንቴያ፤ ያዺ ማዔ፥ ቄኤሴኮ ዑሢ ማዔያኬ ኑም ኮይሳሢ። <verse eid="HEB 7:26"/><verse number="27" style="v" sid="HEB 7:27"/>ዒዚ ሜሌ ቄኤሶኮ ዑፃ ማዔ ዓሶጉዲ ቤርታዺ ፔ ጎሞ ዛሎሮ፥ ዬካፓ ዴሮ ጎሞ ዛሎሮ ቢያ ኬሊና ፆኦሲም ዒንጎ ባኮ ዒንጋኒ ዒዛ ኮይሱዋያኬ፤ ዓይጎሮ ጌዔቴ ዒዚ ፔና ዒንጎ ባኣዚ ማሂ ዒንጌ ዎዶና ዬይ ባካ ላሚ ማይ ማዺንቱዋጉዲ፥ ፔቴና ማዺ ዬያ ኩንሤሢሮኬ። <note caller="-" style="x"><char style="xo" closed="false">7፡27 </char><char style="xt" closed="false"><ref loc="LEV 9:7">ሌዊ. ዓኬ 9፡7</ref>።</char></note> <verse eid="HEB 7:27"/><verse number="28" style="v" sid="HEB 7:28"/>ሙሴ ዔርዜ ዎጋ ቄኤሶኮ ዑፃ ማሂ ዶኦራሢ ላቤያ ማዔ ዓሶኬ፤ ዎጎኮ ጊንፃፓ ሙኬ ፆኦሲ ጫኣቁማ ጋዓንቴ ናንጊና ናንጋያ ማዔ፥ ፒዜ ፆኦሲ ናዓሢ ዶኦሬኔ።<verse eid="HEB 7:28"/></para>
  <chapter eid="HEB 7"/>
  <chapter number="8" style="c" sid="HEB 8"/>
  <para style="s1">ዬሱሴ ዓኮ ጫኣቁሞኮ ዼኤፒ ቄኤሴ ማዒፆ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1"/>ኑኡኒ ሃሢ ጌስታ ባኮኮ ዼኤፖ ባካ ሃያኬ፤ ዬይያ፦ ጫሪንጮይዳ ዼኤፖ ፆኦዛሢኮ ካኣቱሞ ዖይቶኮ ሚዛቆ ዛላ ቦንቺንቲ ዴዔያ፥ ቄኤሴኮ ቢያ ዑሢ ማዓያ ኑኡኮ ዓኣያ ማዔሢ ዛሎኬ። <note caller="-" style="x"><char style="xo" closed="false">8፡1 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ዓይኑ. 110፡1</ref>።</char></note> <verse eid="HEB 8:1"/><verse number="2" style="v" sid="HEB 8:2"/>ዒዚ ማዻሢ ጎኔ ማዔ፥ ዓፒላፓ ማዦና ማኣሮይዳኬ፤ ዬያ ዓፒላፓ ማዦና ማኣሮ ዾቄሢ ዓሲቱዋንቴ ፆኦሲኬ።<verse eid="HEB 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3"/>ፔቴ ፔቴ ቄኤሶኮ ዑፃ ማዓ ዓሳ ዶኦሪንታሢ ፆኦሲም ዒንጎ ባኮ ዒንጋኒኬ፤ ዬያሮ ዬያ ቄኤሶኮዋ ፔቴ ዒንጎ ባኣዚ ዎይቴቴያ ዓኣያ ማዓኒ ኮይሳኔ። <verse eid="HEB 8:3"/><verse number="4" style="v" sid="HEB 8:4"/>ዒዚ ሳዖይዳታቴ ቄኤሶኮ ዑሢ ማዒንዱዋያታንቴኬ፤ ዓይጎሮ ጌዔቴ ሙሴ ዔርዜ ዎጎ ጎይፆና ዒንጎ ባኮ ፆኦሲም ዒንጋ ሃንጎ ቄኤሳ ዓኣሢሮኬ። <verse eid="HEB 8:4"/><verse number="5" style="v" sid="HEB 8:5"/>ዔያታ ማዻሢ ጫሪንጫ ማዺንታ ባኮኮ ኮኦኪንሢ ማዓያና ዬያ ባኮኮ ሺቢ ማዔያኬ፤ ዬይያ፦ ሙሴ ዓፒላፓ ማዢንቴ ማኣሮ ኮሻኒ ጌዔ ዎዶና ፆኦሲ፦ «ዹኮይዳ ኔኤም ጴዼም፥ ኔ ዛጌ ጎይፆ ቢያ ባኮ ኮሺ ዛጊ ማዼ» ጌዒ ዓይሤ ጎይፆናኬ። <verse eid="HEB 8:5"/><verse number="6" style="v" sid="HEB 8:6"/>ሃሢ ጋዓንቴ ዬሱሴ ፆኦሲና ዓሲናኮ ባኣካ ማዔ፥ ጫኣቁማ ቤርታኣስካፓ ባሼ ማዔሢጉዲ ዒ ሃሢ ማዻ ማዻኣ ዔያቶ ማዾይዳፓ ባሼኬ፤ ዬይ ዓርቂንቲ ማዺንታሢ ሚርጌና ኮሺ ማዔ፥ ዒንጊንቴ ሃጊ ማዓንዳ ዎዞ ቃኣሎናኬ።<verse eid="HEB 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7"/>ዎንዳኣ ጫኣቁሞይዳ ፔቴታዖ ፓጬ ባኣዚ ባኣያ ማዔያታቴ ላምዓሳ ጫኣቁማ ሃሢ ኮይሲንዱዋያታንቴኬ። <verse eid="HEB 8:7"/><verse number="8" style="v" sid="HEB 8:8"/>ዓይጎሮ ጌዔቴ ፆኦሲ ዴሮይዳ ፓጬ ባኣዚ ዓኣሢ ዴንቄሢሮ፥</para>
  <para style="q" vid="HEB 8:8">«ዓካሪ ታኣኒ ዒስራዔኤሌ ዴሮና ዪሁዳ ዴሮና ዎላ</para>
  <para style="q2" vid="HEB 8:8">ዓኪ ጫኣቁሞ ጫኣቃንዳ ዎዴ ሙካንዳኔ፤ ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">8፡8 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">ዔር. 31፡31-34</ref>።</char></note><verse eid="HEB 8:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 8:9"/>ዬይ ጫኣቁማ ዔያቶ ታ ጊብፄይዳፓ</para>
  <para style="q2" vid="HEB 8:9">ኩጮ ዔያቶኮ ዓርቂ ኬሴ ዎዶና</para>
  <para style="q2" vid="HEB 8:9">ዔያቶኮ ዓዶንሢና ዎላ ታ ጫኣቄ ጫኣቁሞጉዲቱዋሴ፤</para>
  <para style="q" vid="HEB 8:9">ዓይጎሮ ጌዔቴ ዔያታ ታኣኒ ጫኣቄ ጫኣቁሞ ዶዲ ካፒባኣሢሮ</para>
  <para style="q" vid="HEB 8:9">ታ ዔያቶ ቶኦዛዺ፥ ዙሌ ዔያቶም ጌሤኔ።<verse eid="HEB 8:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="HEB 8:10"/>ዓካሪ ሃካፓ ሴካ ዒስራዔኤሌ ዴሮና ዎላ</para>
  <para style="q2" vid="HEB 8:10">ታ ጫኣቃንዳ ጫኣቁማ ያዺኬ፤ ጋዓኔ ጎዳ።</para>
  <para style="q" vid="HEB 8:10">ታኣኒ ታ ዎጎ ዔያቶ ዒና ጌሣንዳኔ፤</para>
  <para style="q2" vid="HEB 8:10">ዔያቶኮ ማሊፆይዳ ታ ፃኣፓንዳኔ፤</para>
  <para style="q" vid="HEB 8:10">ታ ዔያቶኮ ፆኦዛሢያ ማዓንዳኔ፤</para>
  <para style="q2" vid="HEB 8:10">ዔያታ ታ ዴሬ ማዓንዳኔ።<verse eid="HEB 8:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="HEB 8:11"/>‹ፆኦሲ ዔሬ› ጌዒ ፔ ዓጪ ዓሲም ማዖም</para>
  <para style="q2" vid="HEB 8:11">ፔ ጌርሲምታቴያ ዔርዛንዳይ ባኣሴ፤</para>
  <para style="q" vid="HEB 8:11">ዓይጎሮ ጌዔቴ ዻኮ ዓሶ ጌይንታስካፓ ዴንዲ ዼኤፖ ሄላንዳኣና</para>
  <para style="q2" vid="HEB 8:11">ቢያሢ ታና ዔራንዳኔ።<verse eid="HEB 8:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="HEB 8:12"/>ዔያቶኮ ዻቢንቶ ታ ዓቶም ጋዓንዳኔ፤</para>
  <para style="q2" vid="HEB 8:12">ጎሞዋ ዔያቶኮ ሃካፓ ሴካ ታ ዋላንዳኔ» ጎዳ ጋዓኔ።<verse eid="HEB 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13"/>ዓካሪ፦ «ዓኪ ጫኣቁሞ» ጌይፆና ቤርታኣ ጫኣቁሞ ጪንቄያ ማሄኔ ጌይሢኬ፤ ዬያሮ ማዺ ጪንቄ ባካ ቢያ ባይቃንዳ ዎዳ ዑኬኔ።<verse eid="HEB 8:13"/></para>
  <chapter eid="HEB 8"/>
  <chapter number="9" style="c" sid="HEB 9"/>
  <para style="s1">ሳዓ ፆኦሲ ካኣሽኮ ጎይፆና ጫሪንጫ ካኣሽኮ ጎይፆ ዛላ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1"/>ሚናኣ ጫኣቃሢኮ ፆኦሲ ካኣሽኮ ጎይሢና ዬያኮ ሳዓ ማዢንቴ ጌኤሺ ማኣሪያ ዓኣኔ። <verse eid="HEB 9:1"/><verse number="2" style="v" sid="HEB 9:2"/>ዬይ ማዢንቴ ማኣራ ላምዖ ጋርሲ ዓኣ ዓፒላና ማዢንቴ ማኣሪኬ፤ ዬኖኮ ቤርታሳ ጋሮይዳ ዼጌ ሎኦዤ ዖይታንታ፥ ፖዒ ጌሦ ሻርናንታ ፆኦሲም ዒንጊንቴ ካሣንታ ጌሢንታያኬ፤ ዬና ቤዛ «ፆኦሲም ዱማዼ ጋርሲ» ጌይንታኔ። <note caller="-" style="x"><char style="xo" closed="false">9፡2 </char><char style="xt" closed="false"><ref loc="EXO 26:1-30">ኬሲ. ማፃ 26፡1-30</ref>፤ <ref loc="EXO 25:31-40">25፡31-40</ref>።</char></note> <verse eid="HEB 9:2"/><verse number="3" style="v" sid="HEB 9:3"/>ላምዓሳ፥ ጎኦቦ ዓፒሎኮ ሶንጌኖ ጋራ ሜሌ ጋርሲ ዓኣኔ፤ ዬና ጋሬላ «ዑሣ ዓኣዼ ፆኦሲም ዱማዼ ጋርሲ» ጌይንታኔ። <note caller="-" style="x"><char style="xo" closed="false">9፡3 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">ኬሲ. ማፃ 26፡31-33</ref>።</char></note> <verse eid="HEB 9:3"/><verse number="4" style="v" sid="HEB 9:4"/>ዬኖ ጋሬሎይዳ ዑንጆ ጩቢሶ ቤዞንታ ዎርቆና ዑፃ ጳርቂንቴ ታኣቦቶንታ ዓኣኔ፤ ዬኖ ታኣቦቴሎ ጋራ «ማና» ጌይንታ ሙኡዚ ዓርቄያ ዎርቄፓ ኮሺንቴ ሌማቴንታ ዓኣዒ፥ ቶሺ ዓኣ ዓኣሮኔ ኮኦሎንታ ፆኦሲኮ ጫኣቁማ ፃኣፒንቲ ዓኣ ሹጮ ቆኦቂ ፃኣፖና ዓርሲንቴ ሹጫኣ ዓኣኔ። <note caller="-" style="x"><char style="xo" closed="false">9፡4 </char><char style="xt" closed="false"><ref loc="EXO 30:1-6">ኬሲ. ማፃ 30፡1-6</ref>፤ <ref loc="EXO 25:10-16">25፡10-16</ref>፤ <ref loc="EXO 16:33">16፡33</ref>፤ <ref loc="NUM 17:8-10">ፓይ. ማፃ 17፡8-10</ref>፤ <ref loc="EXO 25:16">ኬሲ. ማፃ 25፡16</ref>፤ <ref loc="DEU 10:3-5">ላሚ. ዎማ 10፡3-5</ref>።</char></note> <verse eid="HEB 9:4"/><verse number="5" style="v" sid="HEB 9:5"/>ታኣቦቶ ዑፃ ዓኣ፥ ጎሞ ጌኤሺፆ ዔርዛ ጉኡፖ ጋኣዞና ካንቃ ቦንቺንታ ኪሩቤሌ ጌይንታዞንሢ ዓኣኔ፤ ጋዓንቴ ዬያ ባኮ ኑ ቢያ ፓይዲ ፓይዲ ኬኤዚ ጋፒሳኒ ዳንዳዑዋሴ። <note caller="-" style="x"><char style="xo" closed="false">9፡5 </char><char style="xt" closed="false"><ref loc="EXO 25:18-22">ኬሲ. ማፃ 25፡18-22</ref>።</char></note><verse eid="HEB 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6"/>ቢያ ባካ ያዺዲ ጊኢጌሢኮ ጊንፃ ቄኤሳ ማዻ ማዾ ማዻኒ ዓፒሎና ማዢንቴ ማኣሮኮ ቤርታሳ ጋሬሎ ቢያ ኬሊ ጌላኔ። <note caller="-" style="x"><char style="xo" closed="false">9፡6 </char><char style="xt" closed="false"><ref loc="NUM 18:2-6">ፓይ. ማፃ 18፡2-6</ref>።</char></note> <verse eid="HEB 9:6"/><verse number="7" style="v" sid="HEB 9:7"/>ሶንጌኖ ጋራ ዓኣ ላምዓሳ ጋሬሎ ጌላሢ ቄኤሶ ቢያኮ ሱኡጋሢ ሌሊኬ፤ ዒዚ ጌላሢ፦ ሌዔይዳ ፔቴና ሌሊኬ፤ ዒዚ ፔ ጎሞና ዴራ ዔሩዋዖ ማዼ ጎሞሮ ፆኦሲም ዒንጎ ሱጉሢ ዔኩዋኣዖ ዒኢካ ጌሉዋሴ። <note caller="-" style="x"><char style="xo" closed="false">9፡7 </char><char style="xt" closed="false"><ref loc="LEV 16:2-34">ሌዊ. ዓኬ 16፡2-34</ref>።</char></note> <verse eid="HEB 9:7"/><verse number="8" style="v" sid="HEB 9:8"/>ዓፒሎና ማዢንቴ ቤርታሳ ማኣሬላ ዓኣ ጎይሣ ዓኣንቴ ዑሣ ዓኣዼ ፆኦሲም ዱማዼ ቤዜሎ ባንሢ ዔኪ ጌልዛ ጎይፃ ሃጊ ፔጋዺ ዔርቲባኣያ ማዒፆ ዓያኖ ጌኤዣ ዻዋኔ። <verse eid="HEB 9:8"/><verse number="9" style="v" sid="HEB 9:9"/>ዬይ ሃሣኣ ዎዶኮ ኮኦኪንሢኬ፤ ዬያ ጎይፆና ፆኦሲም ዒንጊንታ ዒንጊፃ ዒንጋ ዓሢኮ ዒኖ ጌኤሺ፥ ፒዚሳኒ ዳንዳዑዋሴ፤ <verse eid="HEB 9:9"/><verse number="10" style="v" sid="HEB 9:10"/>ዬይ ቢያ ዓኮ ማዻ ሙካንዳያ ሄላንዳኣና ማዺንታንዳ ዓጪ ዳምቤኬ፤ ዬንሢ ባካ ሙኡዚና ዑሺና ዛላ ሃሣ ዱማ ዱማ ዑሢ ጌኤሺሢ ዛላ ማዺንታ ዳምቤ ሌሊኬ።<verse eid="HEB 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11"/>ጋዓንቴ ኪሪስቶሴ ሃሢ ማዺንታ<note caller="+" style="f"><char style="fr" closed="false">9፡11 </char><char style="fq" closed="false">ሃሢ ማዺንታ፦ </char><char style="ft" closed="false">ጋዓዞ ፔቴ ፔቴ ማፃኣፓ «ሃጊ ሙካንዳሢኮ» ጋዓኔ።</char></note> ኮዦ ባኮኮ ቄኤሶ ቢያፓ ዑሢ ማዒ ሙኬኔ፤ ዓፒሎና ማዢንቴ፥ ዒዚ ጌሌ ማኣራ ዼኤፒ ሃሣ ፓጬ ባኣዚ ባኣያኬ፤ ዬና ማኣራ ዓሲ ማዢባኣያ ሃሣ ጊንሣ ሃያ ዓጮ ባኣዚና ማዢንቲባኣያኬ። <verse eid="HEB 9:11"/><verse number="12" style="v" sid="HEB 9:12"/>ዒዚ ዑሣ ዓኣዼ ፆኦሲም ዱማዼ ጋሬሎ ላሚ ማዺሱዋ ጎይሢ ፔ ሱጉፆ ዔኪ ጌሊ ኩንሤያፓዓቴም ዋኣሮና ዚዮ ጌማቶ ሱጉፆ ዔኪ ጌሊባኣሴ፤ ዬያይዲ ናንጊና ዻቂንታ ኑም ዒ ጴዺሼኔ። <verse eid="HEB 9:12"/><verse number="13" style="v" sid="HEB 9:13"/>ዋኣሮና ጌማቶ ዚዮ ሱጉፆ ሃሣ ቢዲንሢ ማሂ ሚቾ ባኣቶ ማራሢ ቢዲንፆ ዻቢንቲ ዒኢቴ ዓሶ ዑፆይዳ ፑጪፃ ዔያታ ዓሽኮና ማዺ ዻቢንቴ ዒኢቲፆይዳፓ ጌኤሺ ፆኦሲም ዔያቶ ዱማሳያ ማዔቴ፥ <note caller="-" style="x"><char style="xo" closed="false">9፡13 </char><char style="xt" closed="false"><ref loc="LEV 16:15-16">ሌዊ. ዓኬ 16፡15-16</ref>፤ <ref loc="NUM 19:9">ፓይ. ማፃ 19፡9</ref>፤<ref loc="NUM 19:17-19">17-19</ref>።</char></note> <verse eid="HEB 9:13"/><verse number="14" style="v" sid="HEB 9:14"/>ናንጊና ናንጋ ዓያኖ ዛሎና ፔና ዾንኪሳ ባኣዚ ባኣ፥ ፆኦሲም ዒንጎ ባኣዚ ማሂ ፔና ዒንጌ፥ ኪሪስቶሴኮ ሱጉፃ ባይቁዋ ፆኦዛሢም ኑ ማዻንዳጉዲ ኑኡኮ ዒኖ ዬያ ሃይቄያ ማዔ ማዾይዳፓ ዑሣ ዓኣዼ ዎዚ ጌኤሻንዳይ!<verse eid="HEB 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15"/>ዔኤሊንቴዞንሢ ፆኦሲ ሃጊ ማዓንዳ ዎዞና ዒንጌ ናንጊና ናንጎ ቤዞ ዴንቃንዳጉዲ ኪሪስቶሴ ፆኦሲና ዓሲናኮ ባኣካ ዓኮ ጫኣቁሞ ጊኢጊሼሢ ማዔኔ፤ ዬይ ያዺ ማዔሢ ዓሳ ቤርታኣ ጫኣቁሞ ዎጎ ጎይፆ ናንጌ ዎዶና ማዼ ጎሞይዳፓ ዻቂሻኒ ዔያቶ ዛሎ ዒዚ ሃይቄሢሮኬ።<verse eid="HEB 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16"/>ዔልቃሚ ዔልቃሚንቴቴ ዔልቃሜ ዓሢ ሃይቄያ ማዒፃ ዔርታኒ ኮይሳኔ፤ <verse eid="HEB 9:16"/><verse number="17" style="v" sid="HEB 9:17"/>ዓይጎሮ ጌዔቴ ዔልቃማ ዔልቃሚ ማዓሢ ዔልቃሜ ዓሢ ሃይቄቶኬ፤ ዔልቃሜ ዓሢ ሼምፔና ዓኣቴ ዬና ዔልቃማ ጉሪ ማዓኔ። <verse eid="HEB 9:17"/><verse number="18" style="v" sid="HEB 9:18"/>ዬያ ጎይፆ ቤርታኣ ጫኣቁማታዖ ሱጉሢ ባኣያ ጎኔ ጫኣቁሞ ማዑዋያኬ። <verse eid="HEB 9:18"/><verse number="19" style="v" sid="HEB 9:19"/>ሙሴ ፆኦሲ ዒንጌ ዓይሢፆ ቢያ ቤርታ ዴሮም ኬኤዜስካፓ ጌማቶ ዚዮና ዋኣሮ ሱጉፆናይዳ ዋኣሢ ዋሂ፥ ዎጎ ማፃኣፖና ዴሮ ዑፆናይዳ ቢያ ሂሶጴ ዒላዦና ዞቄ ማራቶኮ ጋፓኖና ዔኪ ዔኪ ፑጬኔ። <verse eid="HEB 9:19"/><verse number="20" style="v" sid="HEB 9:20"/>ዒዚ ፑጬሢያ፦ «ፆኦሲ ዒንሢ ካፓንዳጉዲ፥ ዒንሢ ዓይሤ ጫኣቁሞ ሱጉፃ ሃያኬ» ጌይኬ። <note caller="-" style="x"><char style="xo" closed="false">9፡20 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">ኬሲ. ማፃ 24፡6-8</ref>።</char></note> <verse eid="HEB 9:20"/><verse number="21" style="v" sid="HEB 9:21"/>ዬኖ ጎይፆ ዓፒሎና ማዢንቴ ማኣሮንታ ጋራ ማዾ ሜሆ ቢያሢዳ ሱጉፆ ዒ ፑጬኔ። <note caller="-" style="x"><char style="xo" closed="false">9፡21 </char><char style="xt" closed="false"><ref loc="LEV 8:15">ሌዊ. ዓኬ 8፡15</ref>።</char></note> <verse eid="HEB 9:21"/><verse number="22" style="v" sid="HEB 9:22"/>ጎኔ ሙሴ ዔርዜ ዎጎና ዻካ ባኣዚዳፓ ዓታዛ ቢያ ባካ ሱጉሢና ጌኤሽካኔ፤ ሱጉሢ ላኣሊንቲባኣንቴ፥ ጎሜ ዓቶም ጌይንቱዋያኬ። <note caller="-" style="x"><char style="xo" closed="false">9፡22 </char><char style="xt" closed="false"><ref loc="LEV 17:11">ሌዊ. ዓኬ 17፡11</ref>።</char></note><verse eid="HEB 9:22"/></para>
  <para style="s1">ኪሪስቶሴኮ ዒንጎ ባኣዚ ማዒ ዒንጊንቲፃ ጎሜ ጌኤሻያ ማዒፆ</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23"/>ጫሪንጫ ማዺንታ ባኮኮ ኮኦኪንሢ ማዔ ባካ ቢያ ዬያ ዎጎና ያዼይዲ ጌኤሽካያ ማዔኔ፤ ጫሪንጮ ባካ ጋዓንቴ ዬያፓ ዑሣ ዓኣዼ፥ ፆኦሲም ዒንጎ ባኣዚና ጌኤሽካኒ ኮይሳኔ። <verse eid="HEB 9:23"/><verse number="24" style="v" sid="HEB 9:24"/>ኪሪስቶሴ ጎኔ ማዔ፥ ፆኦሲም ዱማዼያ ማዔ ጋሬሎኮ ኮኦኪንሢ ማዔያ ሃሣ ዓሲ ማዤ ጋሬሎ ጌሊባኣሴ፤ ጋዓንቴ ዒዚ ሃሢ ኑ ጋይቴ ፆኦሲ ቤርቶይዳ ዔቃኒ ጎኔና ዑሣ ዓኣዼ ፆኦዛሢም ዱማዼያ ማዔ፥ ጫሪንጮ ዓኣዼኔ። <verse eid="HEB 9:24"/><verse number="25" style="v" sid="HEB 9:25"/>ዓይሁዶ ዓሶኮ ቄኤሶ ሱኡጋሢ ፔ ሱጉሢ ማዒባኣ ሱጉሢ ዔኪ ሌዓ ሌዓ ዑሣ ዓኣዼ ፆኦሲም ዱማዼ ቤዞ ጌላያኬ፤ ኪሪስቶሴ ጋዓንቴ ፔና ሚርጌ ዎዴ ሺርሺ ሺርሺ ዒንጎ ባኣዚ ማሂ ዒንጋኒ ዒኢካ ጌሊባኣሴ። <verse eid="HEB 9:25"/><verse number="26" style="v" sid="HEB 9:26"/>ያዺ ማዔያታቴ ዓጫ ማዢንቴማፓ ዓርቃዖ ሜቶ ዔኪ ዔኪ ናንጋንዳያ ዒዛም ኮይሳንዳያታንቴኬ፤ ሃሢ ጋዓንቴ ዎዶኮ ጋፒንፆይዳ ጎሜ ጌኤሻኒ፥ ፔና ፆኦሲም ዒንጎ ባኣዚ ማሂ ዒንጋኒ ላሚንቱዋ ጎይሢ ፔቴና ሙኪ ጴዼኔ። <verse eid="HEB 9:26"/><verse number="27" style="v" sid="HEB 9:27"/>ዓሲ ፔቴና ሃይቂ፥ ዬካፓ ጋፒንሢ ዎጌም ሺኢካንዳጉዲ ጌይንቴያኬ። <verse eid="HEB 9:27"/><verse number="28" style="v" sid="HEB 9:28"/>ዬያጉዲ ኪሪስቶሴ ሚርጌ ዓሶኮ ጎሞ ጌኤሻኒ ፔቴና ሃይቄኔ፤ ላሚ ዓሲኮ ጎሞ ፔ ዑፃ ማሃኒቱዋንቴ ጉሙርቂ ዒዛ ካፓዞንሢ ሃይቢፓ ዓውሳኒ ላሚሣ ዒዚ ሙካንዳኔ። <note caller="-" style="x"><char style="xo" closed="false">9፡28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">ዒሲ. 53፡12</ref>።</char></note><verse eid="HEB 9:28"/></para>
  <chapter eid="HEB 9"/>
  <chapter number="10" style="c" sid="HEB 10"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1"/>ሙሴ ዔርዜ ዎጋ ሃጊ ሙካንዳ ኮዦ ባኮኮ ኮኦኪንሢ ማዓንዳኣፓዓቴም ጎኔ ዬያ ኮዦ ባኮቱዋሴ፤ ዬያሮ ሌዓ ሌዓ ቢያ ዎዴ ፆኦሲም ዒንጊንታ ባካ ዒንጋ ዓሶ ጌኤሺ፥ ፒዚሳኒ ዳንዳዑዋሴ። <verse eid="HEB 10:1"/><verse number="2" style="v" sid="HEB 10:2"/>ዬይ ዎጋ ዎንዴ ጌኤሺ፥ ፒዚሳኒ ዳንዳዓያ ማዔቴ ዔያታ ፆኦሲም ዒንጎ ባኮ ሃሼያ ናንዳንቴኬ፤ ዎይቲ ጌዔቴ ካኣዦሮ ጌላ ዓሳ ላሚሱዋ ጎይሢ ጎማፓ ጌኤሽኬያ ማዓንዳሢሮ ዔያቶ ዒኖይዳ ጎሜ ዔያቶኮ ባኣያ ማዔሢ ዔያቶም ዔርታንዳኔ። <verse eid="HEB 10:2"/><verse number="3" style="v" sid="HEB 10:3"/>ዬይ ፆኦሲም ዒንጎ ባካ ጋዓንቴ ሌዖይዳ ሌዖይዳ ዔያቶኮ ጎሞ ጶቂሣያኬ። <verse eid="HEB 10:3"/><verse number="4" style="v" sid="HEB 10:4"/>ዎይቲ ጌዔቴ ጌማቶ ዚዮና ዋኣሮናኮ ሱጉፃ ጎሜ ጌኤሻኒ ዳንዳዑዋኣሢሮኬ።<verse eid="HEB 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5"/>ዬያሮ ኪሪስቶሴ ዓጮ ሙኬ ዎዶና፦</para>
  <para style="q" vid="HEB 10:5">«ኔኤኒ ኔኤም ዒንጎ ባኣዚ ኮይባኣሴ፤</para>
  <para style="q2" vid="HEB 10:5">ጋዓንቴ ኔ ታኣም ዓሲ ዑሢ ዒንጌኔ። <note caller="-" style="x"><char style="xo" closed="false">10፡5 </char><char style="xt" closed="false"><ref loc="PSA 40:6-8">ዓይኑ. 40፡6-8</ref>።</char></note><verse eid="HEB 10:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="HEB 10:6"/>ኔኤም ሚቺ ዒንጎ ባኮና</para>
  <para style="q2" vid="HEB 10:6">ጎሜ ጌኤሻኒ ዒንጎ ባኮናኣ ኔ ዎዛዺባኣሴ፤<verse eid="HEB 10:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="HEB 10:7"/>ዬማና ታ፦</para>
  <para style="q" vid="HEB 10:7">‹ታ ፆኦዛሢዮ! ማፃኣፖይዳ ታ ዛሎ ፃኣፒንቴሢጉዲ</para>
  <para style="q2" vid="HEB 10:7">ኔ ማሊፆ ኩንሣኒ ሃይሾ ታ ሙኬኔ› » ጌዔኔ።<verse eid="HEB 10:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8"/>ዎጋ ዬይ ማዺንታንዳጉዲ ዓይሤቴያ ዒዚ ጋዓንቴ ቤርታ፦ «ፆኦሲም ዒንጎ ዱማ ዱማ ባኮንታ ሚቺ ዒንጎ ባኮ፥ ዬያጉዲ ሃሣ ጎሞ ዛሎ ዒንጎ ባኮዋ ኔ ኮይባኣሴ፤ ዬያና ሃሣ ኔ ዎዛዺባኣሴ» ጌዔኔ። <verse eid="HEB 10:8"/><verse number="9" style="v" sid="HEB 10:9"/>ዬካፓ ሃሣ፦ «ሃይሾ ኔ ማሊፆ ኩንሣኒ ታ ሙኬኔ» ጌዔኔ፤ ዬያይዲ ላምዓሶ፥ ፆኦሲም ዒንጎ ጎይፆ ቤዞ ጌልዛኒ ቤርታ ፆኦሲም ዒንጎ ጎይፆ ላኣሜኔ። <verse eid="HEB 10:9"/><verse number="10" style="v" sid="HEB 10:10"/>ዬሱስ ኪሪስቶሴ ፔ ዑፆ ላሚ ዒንጊንቱዋ ጎይሢ ፔቴና ፆኦሲም ዒንጎ ባኣዚ ማሂ ሺኢሼሢሮ ኑኡኒ ፆኦሲም ዱማዼያ ማዔኔ፤ ዬኖ ፆኦሲ ዒ ማዻንዳጉዲ ኮዔ ማሊፆኬ።<verse eid="HEB 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11"/>ፔቴ ፔቴ ዓይሁዶ ዓሶኮ ቄኤሳ ጎሜ ጌኤሻኒ ዳንዳዑዋ ዬንሢ ዒንጊፆንሢ ቢያ ኬሊ ዒንጊ ዒንጊ ዓቱዋዖ ማዻኔ። <note caller="-" style="x"><char style="xo" closed="false">10፡11 </char><char style="xt" closed="false"><ref loc="EXO 29:38">ኬሲ. ማፃ 29፡38</ref>።</char></note> <verse eid="HEB 10:11"/><verse number="12" style="v" sid="HEB 10:12"/>ኪሪስቶሴ ጋዓንቴ ናንጊና ዒንጊንቴያ ማዓ፥ ዒንጊፆ ፔቴና ዒንጌስካፓ ፆኦሲ፥ ዓዳሢኮ ሚዛቆ ዛላ ቦንቺንቲ ዴዔኔ። <verse eid="HEB 10:12"/><verse number="13" style="v" sid="HEB 10:13"/>ዬማፓ ዓርቃዖ ዴንዲ ዒዛኮ ሞርኮ ፆኦሲ ዒዛ ባሺሳንዳያ ሄላንዳኣና ዒኢካ ዴዒ ዒ ካፓኔ፤ <note caller="-" style="x"><char style="xo" closed="false">10፡13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ዓይኑ. 110፡1</ref>።</char></note> <verse eid="HEB 10:13"/><verse number="14" style="v" sid="HEB 10:14"/>ዓይጎሮ ጌዔቴ ፆኦሲም ዱማዼዞንሢ ፔቴና ፆኦሲም ዒንጎ ዒንጊፆ ዛሎና ናንጊና ዔያቶ ዒ ጌኤሺ፥ ፒዚሴሢሮኬ።<verse eid="HEB 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15"/>ዓያኖ ጌኤዣ ዬያ ባኮ ዛሎ ኑም ማርካዻዖ ቤርታዺ፦<verse eid="HEB 10:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="HEB 10:16"/>«ዬካፓ ታ ዔያቶና ዎላ ጫኣቃንዳ ጫኣቁማ ያዺኬ፤</para>
  <para style="q" vid="HEB 10:16">ታኣኮ ዎጎ ዒና ታ ዔያቶኮ ጌሣንዳኔ፤</para>
  <para style="q2" vid="HEB 10:16">ማሊፆይዳኣ ታ ዔያቶኮ ፃኣፓንዳኔ።» <note caller="-" style="x"><char style="xo" closed="false">10፡16 </char><char style="xt" closed="false"><ref loc="JER 31:33">ዔር. 31፡33</ref>።</char></note><verse eid="HEB 10:16"/></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17"/>ሃሣ፦</para>
  <para style="q" vid="HEB 10:17">«ዔያቶኮ ጎሞንታ ፑርቶ ማዾንታ ሃካፓ ሴካ ታ ጶቂሣዓኬ»</para>
  <para style="m" vid="HEB 10:17">ጎዳ ጋዓኔ፤ ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">10፡17 </char><char style="xt" closed="false"><ref loc="JER 31:34">ዔር. 31፡34</ref>።</char></note><verse eid="HEB 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 10:18"/>ዬያሮ ጎሜ ጌኤሽኬሢኮ ጊንፃ ጎሜ ጌኤሻኒ ፆኦሲም ዒንጊንታ ዒንጊሢ ዓታንዳኔ።<verse eid="HEB 10:18"/></para>
  <para style="s1">ፆኦሲ ባንሢ ኑ ሙካንዳያ ኮይሳያ ማዒፆ</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19"/>ዓካሪ ታ ዒሾንሦ! ታ ሚሾንሦ! ዬሱሴ ሱጉፆ ዛሎና ፆኦሲም ዑሣ ዓኣዼ ዱማዼ ጋሬሎ ጌልዛንዳ ጉሙርሳ ባኣዚ ኑ ዴንቄኔ፤ <verse eid="HEB 10:19"/><verse number="20" style="v" sid="HEB 10:20"/>ኑኡኒ ጌላንዳሢ ጎኦቦ ዓፒሎይዴና ጌይፃ፥ ዒዛኮ ዑፆ ጊዴና ዒ ኑም ቡሌ፥ ዓኪ ሃሣ ናንጊና ናንጋያ ማዔ ጎይፆናኬ። <verse eid="HEB 10:20"/><verse number="21" style="v" sid="HEB 10:21"/>ፆኦሲ ማኣሮ፥ ጫሪንጮሲዳ ቢታንቶ ዓኣ ዼኤፒ ቄኤሴ ኑኡኮ ዓኣኔ፤ <verse eid="HEB 10:21"/><verse number="22" style="v" sid="HEB 10:22"/>ዬያሮ ኑኡኮ ፑርቶ ዒና ጌኤሽካንዳጉዲ ዒኖ ፑጪንቲ፥ ዑፆዋ ኑኡኮ ጌኤሺ ዋኣሢና ማስቲ፥ ፒዜ ዒናና ሃሣ ጎኔ ጉሙርቂሢና ፆኦሲ ባንሢ ኑ ሙኮም። <note caller="-" style="x"><char style="xo" closed="false">10፡22 </char><char style="xt" closed="false"><ref loc="LEV 8:30">ሌዊ. ዓኬ 8፡30</ref>፤ <ref loc="EZK 36:25">ሂዚ. 36፡25</ref>።</char></note> <verse eid="HEB 10:22"/><verse number="23" style="v" sid="HEB 10:23"/>ኑም ሃጊ ማዓንዳ ዎዞ ቃኣሎ ዒንጌ ፆኦዛሢ ጉሙርቂንታያ ማዔሢሮ ሃሢ ኑ ጉሙርቂ ማርካዻ፥ ሃጊ ማዓንዳ ዎዞ ዶዲሺ ኑ ዓርቆም። <verse eid="HEB 10:23"/><verse number="24" style="v" sid="HEB 10:24"/>ናሹሞና ኮሺ ማዾ ማዺሢና ጴጪ ኑ ናንጋንዳጉዲ ፔቴይ ባጋሢ ጴቻያ ማዖንጎ። <verse eid="HEB 10:24"/><verse number="25" style="v" sid="HEB 10:25"/>ቢያ ዎዴ ዎላ ኑ ካኣሚ ካኣሚ ዎሊ ኑ ዶዲሾም፤ ጋዓንቴ ፔቴ ፔቴ ዓሳ ማዻ ጎይፆ ኑኡኮ ዎላ ቡኪንታ ቡኪንቶ ኑ ሃሺባኣያታቴ ቃራኬ፤ ጎዳኮ ሙኮ ኬላ ዑኬሢ ዒንሢ ዛጋያታሢሮ ዬያ ባኮ ዑሣ ዓኣዼ ማዹዋቴ።<verse eid="HEB 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26"/>ጎኔ ማዔ ባኮ ኑ ዔሬሢኮ ጊንፃ ዔሬዖ ኑ ጎሜ ማዼቴ ሃካፓ ሴካ ጎሜ ዛላ ፆኦሲም ዒንጊንታንዳ ባኣዚ ዓይጌያ ኑም ባኣሴ። <verse eid="HEB 10:26"/><verse number="27" style="v" sid="HEB 10:27"/>ጋዓንቴ ኑና ካፔሢ ሃጊ ሙካንዳ፥ ዒጊቻ ፆኦሲኮ ዎጊፆና ዒዛ ዒፃ ሞርኮ ዒ ሚቻንዳ ዒጊቻ ዼኤፖ ታሞናኬ። <note caller="-" style="x"><char style="xo" closed="false">10፡27 </char><char style="xt" closed="false"><ref loc="ISA 26:11">ዒሲ. 26፡11</ref>።</char></note> <verse eid="HEB 10:27"/><verse number="28" style="v" sid="HEB 10:28"/>ሙሴ ዔርዜ ዎጎ ዻቤ ዓሲዳ ላምዖ ሃንጎ ሃይሦ ዓሲ ማርካዼቴ ሃሺሢ ባኣያ ዬያ ዓሢ ዎዎዾኔ። <note caller="-" style="x"><char style="xo" closed="false">10፡28 </char><char style="xt" closed="false"><ref loc="DEU 17:6">ላሚ. ዎማ 17፡6</ref>፤ <ref loc="DEU 19:15">19፡15</ref>።</char></note> <verse eid="HEB 10:28"/><verse number="29" style="v" sid="HEB 10:29"/>ዬይ ያዺ ማዓያ ማዔቴ ፆኦሲ ናዓሢ ቦሄሢ፤ ሃሣ ፆኦሲም ዱማዼ ጫኣቁሞ ሱጉፆ ፓሡዋ ባኣዚ ማሂ ዛጌሢ፤ ጊንሣ ሃሣ ኮሹሞና ዒንጊንቴ ዓያኖ ጫሽኬሢ ዎማዺ ፑርታ ዎጌ ሄላንዳያ ዒንሢም ማላይ? <note caller="-" style="x"><char style="xo" closed="false">10፡29 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ኬሲ. ማፃ 24፡8</ref>።</char></note> <verse eid="HEB 10:29"/><verse number="30" style="v" sid="HEB 10:30"/>ዎይቲ ጌዔቴ፦ «ኮሜ ዔካሢ ታናኬ፤ ኮሞ ታ ማሃንዳኔ» ጌዔሢ ዖና ማዔቴያ ኑ ዔራኔ፤ ዬያጉዲ ሃሣ፦ «ፆኦሲ ፔ ዴሮይዳ ዎጋንዳኔ» ጋዓኔ። <note caller="-" style="x"><char style="xo" closed="false">10፡30 </char><char style="xt" closed="false"><ref loc="DEU 32:35-36">ላሚ. ዎማ 32፡35-36</ref>።</char></note> <verse eid="HEB 10:30"/><verse number="31" style="v" sid="HEB 10:31"/>ናንጊና ናንጋ ፆኦዛሢና ዎጊንቲሢ ሚርጌ ዒጊቻያኬ።<verse eid="HEB 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32"/>ፖዓ ዒንሢም ፖዔሢኮ ጊንፃ ሚርጌ ሜቶ ዒንሢ ዔኪ፥ ዳንዳዒ ዓኣሤ፥ ዬንሢ ቤርታኣ ዎዶንሢ ማሊ ጶቂሡዋቴ። <verse eid="HEB 10:32"/><verse number="33" style="v" sid="HEB 10:33"/>ፔቴ ፔቴ ዎዴና ዓሲ ቤርቲዳ ዒንሢ ጫሽኪንቴኔ፤ ሚርጌ ሜቶዋ ዒንሢ ዛጌኔ፤ ሃሣ ዬያጉዴ ሜታሢ ሄሌ ዓሶና ዎላ ፔቴ ማዒ ዔያቶ ሜታሢ ዒንሢያ ዔኬኔ። <verse eid="HEB 10:33"/><verse number="34" style="v" sid="HEB 10:34"/>ዒንሢ ባሼ ኮሺ፥ ሃሣ ቢያ ዎዴ ናንጋ ቆሎ ጫሪንጮይዳ ዓኣሢ ዔሬሢሮ ቱኡቴ ዓሶ ሚጪንቲ ዒንሢ ማኣዴኔ፤ ቆላ ዒንሢኮ ቡሪንቲ ዔውቴ ዎዶና ዎዛና ዒንሢ ዬያ ጊቢ ዳንዳዔኔ። <verse eid="HEB 10:34"/><verse number="35" style="v" sid="HEB 10:35"/>ዓካሪ ዬያ ዒንሢ ማዼሢ ዛሎ ዒንጎንዶ ዼኤፖ ባኮ ዴንቃኒ ጉሙርቂ ዒንሢ ጫርቃ ጫርሹሞ ሃሺፖቴ። <verse eid="HEB 10:35"/><verse number="36" style="v" sid="HEB 10:36"/>ፆኦሲኮ ማሊፆ ኩንሢ ፆኦሲ ዒንሢም «ዒንጋንዳኔ» ጌዒ ጫኣቄ ባኮ ዴንቃኒ ዶዳንዳያ ዒንሢም ኮይሳኔ። <verse eid="HEB 10:36"/><verse number="37" style="v" sid="HEB 10:37"/>ዓይጎሮ ጌዔቴ፦</para>
  <para style="q" vid="HEB 10:37">«ሙካኒ ኮይሳሢ ዻካ ዎዴኮ ጊንፃ ሙካንዳኔ፤</para>
  <para style="q2" vid="HEB 10:37">ኔጊንዱዋሴ፤<verse eid="HEB 10:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="HEB 10:38"/>ፂሎ ዓሲ ጋዓንቴ ጉሙርቂሢና ሼምፖ ዴንቃንዳኔ፤</para>
  <para style="q2" vid="HEB 10:38">ጊንሢም ሎኦሼቴ ጋዓንቴ</para>
  <para style="q2" vid="HEB 10:38">ዬይ፥ ታና ዎዛሳያቱዋሴ»</para>
  <para style="m" vid="HEB 10:38">ጌይንቲ ፃኣፒንቴኔ። <note caller="-" style="x"><char style="xo" closed="false">10፡38 </char><char style="xt" closed="false"><ref loc="HAB 2:3-4">ዒምባ. 2፡3-4</ref>።</char></note> <verse eid="HEB 10:38"/><verse number="39" style="v" sid="HEB 10:39"/>ጋዓንቴ ኑኡኒ ጉሙርቂ ዻቃ ዓሶ ዛላ ማዔያኬ፤ ጊንሢም ሎኦሺ ባይቃ ዓሶ ዛላ ማዔያቱዋሴ።<verse eid="HEB 10:39"/></para>
  <chapter eid="HEB 10"/>
  <chapter number="11" style="c" sid="HEB 11"/>
  <para style="s1">ጉሙርቂሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1"/>ጉሙርቂሢ ጌይሢ ሃጊ ማዓንዳ ዎዛ ጌሢ ኑ ካፓ ባኮ ኑ ዴንቃንዳያታሢ ዔሪሢ፤ ሃሣ ኑ ዛጊባኣ ባኮ ዓኣያ ማሂ ዛጊሢኬ። <verse eid="HEB 11:1"/><verse number="2" style="v" sid="HEB 11:2"/>ቤርታኣ ዓሶም ማርካዺንቴሢ ዔያታ ጉሙርቄሢሮኬ።<verse eid="HEB 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3"/>ሳዖንታ ጫሪንጮንታ ጊዳ ዓኣ ባካ ቢያ ፆኦሲ «ማዖንጎ» ጌዔሢና ማዢንቴያ ማዔሢ ኑ ዔራሢ ጉሙርቂሢናኬ፤ ዬያሮ ኑም ሃሢ ጴዻ ባካ ቢያ ጴዹዋ ባኣዚዳፓ ማዢንቴሢ ዬያና ኑ ዔራኔ። <note caller="-" style="x"><char style="xo" closed="false">11፡3 </char><char style="xt" closed="false"><ref loc="GEN 1:1">ማዢ. ማፃ 1፡1</ref>፤ <ref loc="PSA 33:6-9">ዓይኑ. 33፡6-9</ref>፤ <ref loc="JHN 1:3">ዮሃ. 1፡3</ref>።</char></note><verse eid="HEB 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4"/>ዓኣቤኤሌ ቃኣዔኤሌ ፆኦሲም ዒንጌ ዒንጊፆይዳፓ ባሻያ ፆኦሲም ዒንጌሢ ጉሙርቂሢናኬ፤ ፆኦሲ ዓኣቤኤሌ ዒንጌ ዒንጊፆ ዎዛና ዔኬ ዎዶና ዓኣቤኤሌ ጉሙርቂፆና ፂሎ ማዔሢ ማርካዺንቴኔ፤ ዓኣቤኤሌ ሃይቄያ ማዔቴያ ሃኖ ሄላንዳኣና ዒዛኮ ጉሙርቂፆ ዛሎና ዒ ኬኤዚ ኬኤዚ ዓኣኔ። <note caller="-" style="x"><char style="xo" closed="false">11፡4 </char><char style="xt" closed="false"><ref loc="GEN 4:3-10">ማዢ. ማፃ 4፡3-10</ref>።</char></note><verse eid="HEB 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5"/>ሄኖኬ ሃይቢ ሃይቁዋጉዲ ሌካ ጫሪንጮ ዔውቴሢ ዒ ጉሙርቄሢሮኬ፤ ፆኦሲ ዒዛ ዔኬሢሮ ዒ ጴዺባኣሴ፤ ዒ ዔውታንዳሢኮ ቤርታ ፆኦሲ ዒ ዎዛሴያ ማዔሢ ማርካዺንቴኔ። <note caller="-" style="x"><char style="xo" closed="false">11፡5 </char><char style="xt" closed="false"><ref loc="GEN 5:21-24">ማዢ. ማፃ 5፡21-24</ref>።</char></note> <verse eid="HEB 11:5"/><verse number="6" style="v" sid="HEB 11:6"/>ጉሙርቂሢ ባኣንቴ ፆኦሲ ዎዛሳኒ ዳንዳዒንቱዋሴ፤ ዓይጎሮ ጌዔቴ ፆኦሲ ባንሢ ሙካሢ ፆኦሲ ዓኣያ ማዔሢና ዒዛ ዒናፓ ኮዓዞንሢም ዒ ዒንጋንዳ ባኣዚ ዓኣሢ ጉሙርቃንዳያ ኮይሳሢሮኬ።<verse eid="HEB 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7"/>ሃጊ ጴዺባኣ ባኮሮ ፆኦሲ ላቲ ዒዛም ኬኤዜ ዎዶና ኖሄ ፆኦሲ ዒጊጪሢና ማኣሮ ዓሶ ዻቂሻኒ ዋኣፆ ካኣሚሎ ኮሼሢ ጉሙርቂሢናኬ፤ ዬያ ጉሙርቂፆና ዓጮ ዓሶ ቢያ ዻቢንቴያ ማሂ ዒዚ ሃሼኔ፤ ጉሙርቂፆና ጴዻ ፂሉሞዋ ዒ ዴንቄኔ። <note caller="-" style="x"><char style="xo" closed="false">11፡7 </char><char style="xt" closed="false"><ref loc="GEN 6:13-22">ማዢ. ማፃ 6፡13-22</ref>።</char></note><verse eid="HEB 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8"/>ዓብራሃሜ ፔ ዓጪ ማሂ ዔካንዳ ቤዞ ዓኣዻንዳጉዲ ፆኦሲ ዒዛ ዔኤሌ ዎዶና ዓንኮ ዓኣዻቴያ ዔሪባኣያታዖ «ዔኤዔ» ጌዒ ዓይሢንቲ ዓኣዼሢ ጉሙርቂሢናኬ። <note caller="-" style="x"><char style="xo" closed="false">11፡8 </char><char style="xt" closed="false"><ref loc="GEN 12:1-5">ማዢ. ማፃ 12፡1-5</ref>።</char></note> <verse eid="HEB 11:8"/><verse number="9" style="v" sid="HEB 11:9"/>ሃሣ ዒዛጉዲ ሃጊ ማዓንዳ ዎዞ ዴንቃንዳ፥ ዪሳኣቄና ያይቆኦቤና ዎላ ሃጋኣ ዎዛ ማሂ ዒንጎና ዓጬሎይዳ ሙኬ ዓሲ ማዒ፥ ዓፒላና ማዢንቴ ማኣሮይዳ ዒ ናንጌሢ ጉሙርቂሢናኬ። <note caller="-" style="x"><char style="xo" closed="false">11፡9 </char><char style="xt" closed="false"><ref loc="GEN 35:27">ማዢ. ማፃ 35፡27</ref>።</char></note> <verse eid="HEB 11:9"/><verse number="10" style="v" sid="HEB 11:10"/>ዓይጎሮ ጌዔቴ ዶዲ ቦኦኮሎና ማዢንቴ፥ ፆኦሲ ማዣኒ ዓርቂ ማዤ ካታሞ ዒ ካፓያታሢሮኬ።<verse eid="HEB 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11"/>ዓብራሃሜ ዎዚ ጋርቼያ ማዔቴያ ሃሣ ሳኣራ ዞኦኮ ማዔቴያ ሃጊ ማዓንዳ ዎዞ ዒንጌሢ ጉሙርቂንታያ ማሂ ዒ ዛጌሢሮ ጉሙርቂሢና ናይ ዓዶ ማዔኔ። <note caller="-" style="x"><char style="xo" closed="false">11፡11 </char><char style="xt" closed="false"><ref loc="GEN 18:11-14">ማዢ. ማፃ 18፡11-14</ref>፤ <ref loc="GEN 21:2">21፡2</ref>።</char></note> <verse eid="HEB 11:11"/><verse number="12" style="v" sid="HEB 11:12"/>ዬያሮ ዬያ ሃይቄያጉዲ ማዔ፥ ዓብራሃሜይዳፓ ጫሪንጮ ዦኦጋሢጉዲ ሚርጌያ ሃሣ ባዞ ዓጫ ዓኣ ፓይዲንቱዋ ማኣሻሎጉዴ ዺቢ ዜርሢ ዒዛይዳፓ ኬስኬኔ። <note caller="-" style="x"><char style="xo" closed="false">11፡12 </char><char style="xt" closed="false"><ref loc="GEN 15:5">ማዢ. ማፃ 15፡5</ref>፤ <ref loc="GEN 22:17">22፡17</ref>፤ <ref loc="GEN 32:12">32፡12</ref>።</char></note><verse eid="HEB 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13"/>ዬያታ ቢያ ሃይቄሢ ጉሙርቃ ጎይሣ ዓኣዖኬ፤ ፆኦሲ ዔያቶም ዒንጋኒ ጫኣቄ ጫኣቁሞ ባኮዋ ዔያታ ዴንቂባኣሴ፤ ጋዓንቴ ሃኬና ዛጊ፥ ዓዳ ዴንቄያ ማሂ ዔያታ ዎዛዼኔ፤ ሳዖይዳኣ ሾኦቺ ሃሣ ሙኬ ዓሲ ማዔያታሢያ ዔያታ ዔሪ ማርካዼኔ። <note caller="-" style="x"><char style="xo" closed="false">11፡13 </char><char style="xt" closed="false"><ref loc="GEN 23:4">ማዢ. ማፃ 23፡4</ref>፤ <ref loc="1CH 29:15">1ፆኦሲ. ዓሃኬ 29፡15</ref>፤ <ref loc="PSA 39:12">ዓይኑ. 39፡12</ref>።</char></note> <verse eid="HEB 11:13"/><verse number="14" style="v" sid="HEB 11:14"/>ያዺ ጌዒ ማላ ዓሳ ዔያቶም ማዓ ዓጪ ዓኣያ ማዔም ዔያታ ካፓያታሢ ዔርታኔ። <verse eid="HEB 11:14"/><verse number="15" style="v" sid="HEB 11:15"/>ዬኖ፥ ዔያታ ዎንዴ ሃሺ ኬስኬ ዓጬሎ ሄኤዶ ጶቂሢ ማላያታቴ ዒዞ ባንሢ ማዒ ዴንዳንዳያታዖኬ። <verse eid="HEB 11:15"/><verse number="16" style="v" sid="HEB 11:16"/>ሃሢ ጋዓንቴ ባሼ ማዔያ፤ ሃሣ ጫሪንጮይዳ ዓኣ ዓጮ ዔያታ ጶቂሢ ማላኔ፤ ዬያፓ ዔቄያና ፆኦሲ ዔያቶም ካታማ ጊኢጊሼሢሮ «ኑ ፆኦዛሢ» ጌዒ ዔያታ ዔኤሌቴ ዒዛ ቦርሳያቱዋሴ።<verse eid="HEB 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17"/>ዓብራሃሜ ዎይታቴያ ዛጋኒ ፆኦሲ ማዼ ዎዶና ዒዚ ዪሳኣቄ ፆኦሲም ዒንጎ ባኣዚ ማሂ ዒንጌሢ ጉሙርቂሢናኬ፤ ሃጊ ማዓንዳ ዎዞ ዴንቄ፥ ዓብራሃሜ ፔኤኮ ፔቴ ናዓሢ ጎኔ ሹካኒ ዒማና ጊኢጌኔ። <note caller="-" style="x"><char style="xo" closed="false">11፡17 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">ማዢ. ማፃ 22፡1-14</ref>።</char></note> <verse eid="HEB 11:17"/><verse number="18" style="v" sid="HEB 11:18"/>ዬይ ናዓሢ «ኔ ዜርፃ ዪሳኣቄ ሱንፆና ዔኤሊንታንዳኔ» ፆኦሲ ዒዛም ጌዔሢኬ። <note caller="-" style="x"><char style="xo" closed="false">11፡18 </char><char style="xt" closed="false"><ref loc="GEN 21:12">ማዢ. ማፃ 21፡12</ref>።</char></note> <verse eid="HEB 11:18"/><verse number="19" style="v" sid="HEB 11:19"/>ፆኦሲ ሃይቄ ዓሶ ሃይቢዳፓ ዔቂሳኒ ዳንዳዓሢ ዓብራሃሜ ጉሙርቄሢሮ ዒማና ዪሳኣቄ ሃይቢዳፓ ዔቄያ ማሂ ዒ ዛጌኔ።<verse eid="HEB 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20"/>ዪሳኣቄ ሃጊ ማዓንዳ ባኮ ማሊ ያይቆኦቤና ዔኤሳዎና ዓንጄሢ ጉሙርቂሢናኬ። <note caller="-" style="x"><char style="xo" closed="false">11፡20 </char><char style="xt" closed="false"><ref loc="GEN 27:27-29">ማዢ. ማፃ 27፡27-29</ref>፤<ref loc="GEN 27:39-40">39-40</ref>።</char></note><verse eid="HEB 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21"/>ያይቆኦቤ ሃይቃኒ ዑካዖ ዮሴፔ ናኣቶ፥ ፔቴ ፔቴሢ ዓንጄሢ ሃሣ ዒ ኮኦላዺ ሃንታ ኮኦሎና ዔቂ ፆኦሲም ዚጌሢያ ጉሙርቂሢናኬ። <note caller="-" style="x"><char style="xo" closed="false">11፡21 </char><char style="xt" closed="false"><ref loc="GEN 47:31-48:20">ማዢ. ማፃ 47፡31—48፡20</ref>።</char></note><verse eid="HEB 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22"/>ዮሴፔ ሃሣ ሃይቃኒ ዑካዖ ዒስራዔኤሌ ዓሶም ዔያታ ጊብፄ ዓጮይዳፓ ኬስካንዳያ ማዒፆ ኬኤዜሢ ሃሣ ዒዛኮ ሜጌፆ ዔያታ ዎዳንዳቴያ ዓይሤሢ ጉሙርቂሢናኬ። <note caller="-" style="x"><char style="xo" closed="false">11፡22 </char><char style="xt" closed="false"><ref loc="GEN 50:24-25">ማዢ. ማፃ 50፡24-25</ref>፤ <ref loc="EXO 13:19">ኬሲ. ማፃ 13፡19</ref>።</char></note><verse eid="HEB 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23"/>ሙሴ ሾዔ ዓሳ ዒ ሾይንቴ ዎዶና ሚዛጲ ናይ ማዔሢ ዛጋዖ፥ ካኣቲ ዓይሤ ዓይሢፆ ዒጊጩዋዖ ሃይሦ ዓጊኒ ዒዛ ዓኣቼሢ ጉሙርቂሢናኬ። <note caller="-" style="x"><char style="xo" closed="false">11፡23 </char><char style="xt" closed="false"><ref loc="EXO 2:2">ኬሲ. ማፃ 2፡2</ref>፤ <ref loc="EXO 1:22">1፡22</ref>።</char></note><verse eid="HEB 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24"/>ሙሴ ዒማና ዲጬሢኮ ጊንፃ፦ «ጊብፄ ዓጮ ካኣቲኮ ናዎ ናኣዚ» ጌይንቲ ዔኤሊንቲፆ ዒፄሢ ጉሙርቂሢናኬ። <note caller="-" style="x"><char style="xo" closed="false">11፡24 </char><char style="xt" closed="false"><ref loc="EXO 2:10-12">ኬሲ. ማፃ 2፡10-12</ref>።</char></note> <verse eid="HEB 11:24"/><verse number="25" style="v" sid="HEB 11:25"/>ዒዚ ዻካ ዎዴሮ ጎሜ ማዺ ማዺ ዴንቆ ዎዞይዳፓ ባሼ ፆኦሲ ዴሮና ዎላ ሜቶ ዔካኒ ኮዔኔ። <verse eid="HEB 11:25"/><verse number="26" style="v" sid="HEB 11:26"/>ሃጊ ዒዛም ዒንጊንታንዳ ባኮ ዒ ዔሬሢሮ ጊብፄ ዓጮ ቆሎይዳፓ ባሼ ሜሲሄ ዛሎሮ ቦሂንቲፃ ባሼ ቆሎ ማዔሢ ዒ ዛጌኔ።<verse eid="HEB 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27"/>ዒዚ ሃሣ ካኣቲኮ ጎሪንቶ ዒጊጩዋዖ ጊብፄ ዓጮይዳፓ ኬስኬሢ ጉሙርቂሢናኬ፤ ጴዹዋ ፆኦዛሢ ዴንቄያ ማሂ፥ ዒ ፔ ማሊፆና ዶዴኔ። <note caller="-" style="x"><char style="xo" closed="false">11፡27 </char><char style="xt" closed="false"><ref loc="EXO 2:15">ኬሲ. ማፃ 2፡15</ref>።</char></note> <verse eid="HEB 11:27"/><verse number="28" style="v" sid="HEB 11:28"/>ቶይዶ ናኣቶ ዎዻንዳጉዲ ዒማና ዓይሢንቴ ኪኢታንቻሢ ዒስራዔኤሌ ዓሶኮ ቶይዶ ናኣቶ ዎዹዋጉዲ ዑሣ ዓኣዺፆ ዎጎና ካሮ ዑፃ ሱጉፆ ፑጪፆ ዎጎዋ ዒ ኩንሤሢ ጉሙርቂሢናኬ። <note caller="-" style="x"><char style="xo" closed="false">11፡28 </char><char style="xt" closed="false"><ref loc="EXO 12:21-30">ኬሲ. ማፃ 12፡21-30</ref>።</char></note><verse eid="HEB 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29"/>ዒስራዔኤሌ ናኣታ ፃኣዺ ሳዓይዳ ሃንቶጉዲ ሃንቲ ዞቄ ባዞና ፒንቄሢ ጉሙርቂሢናኬ፤ ጊብፄ ዓሳ ጋዓንቴ ዔያቶጉዲ ፒንቃኒ ማሌ ዎዶና ቢያሢ ዋኣፆና ሙይንቴኔ። <note caller="-" style="x"><char style="xo" closed="false">11፡29 </char><char style="xt" closed="false"><ref loc="EXO 14:21-31">ኬሲ. ማፃ 14፡21-31</ref>።</char></note><verse eid="HEB 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30"/>ዒስራዔኤሌ ዓሳ ዒያርኮ ካታሞኮ ሹጮና ኬልቂ ዲርቆና ዲሮ ዙሎ ላንካይ ኬሊ ሺሬሢኮ ጊንፃ ዬያ ዲሮ ዔያታ ዶይሴሢ ጉሙርቂሢናኬ። <note caller="-" style="x"><char style="xo" closed="false">11፡30 </char><char style="xt" closed="false"><ref loc="JOS 6:12-21">ዒያ. 6፡12-21</ref>።</char></note> <verse eid="HEB 11:30"/><verse number="31" style="v" sid="HEB 11:31"/>ዞኦዛ ኮኦማ፥ ሬዓባ ጎዖዛ ዒስራዔኤሌይዳፓ ሙሮ ሙኬ ዓሶ ሾኦቺንሢ ዔኪፆና ፆኦሲም ዓይሢንቱዋ ዓሶና ዎላ ሃይቁዋዖ ዓቴሢ ጉሙርቂሢናኬ። <note caller="-" style="x"><char style="xo" closed="false">11፡31 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">ዒያ. 2፡1-21</ref>፤ <ref loc="JOS 6:22-25">6፡22-25</ref>።</char></note><verse eid="HEB 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32"/>ዓካሪ ዬካፓ ዑሣ ታ ዎዚ ጎዖንዶይ! ጌዲዮኔ፥ ባርቄ፥ ሶምሶሜ፥ ዮፕታኣሄ፥ ዳውቴ፥ ሳሙዔኤሌንታ ፆኦሲ ማሊፆ ኬኤዛ ዓሶንታ ዛሎ ታ ኬኤዚ ጋፒሳኒ ዳንዳዑዋሴ። <note caller="-" style="x"><char style="xo" closed="false">11፡32 </char><char style="xt" closed="false"><ref loc="JDG 6:11-8:32">ሱኡጎ. ማፃ 6፡11—8፡32</ref>፤ <ref loc="JDG 4:6-5:31">4፡6—5፡31</ref>፤ <ref loc="JDG 13:2-16:31">13፡2—16፡31</ref>፤ <ref loc="JDG 11:1-12:7">11፡1—12፡7</ref>፤ <ref loc="1SA 1:1-2:11">1ሳሙ. 1፡1—1ካኣቶ. ማ 2፡11</ref>።</char></note> <verse eid="HEB 11:32"/><verse number="33" style="v" sid="HEB 11:33"/>ዔያታ ጉሙርቂሢና ካኣቶ ዖልዚና ባሼኔ፥ ፒዜ ዎጊሢና ዓሶ ዎይሤኔ፥ ፆኦሲ ዔያቶም ዒንጌ ሃጊ ማዓንዳ ዎዞ ባኮዋ ዴንቄኔ፥ ዞቦኮዋ ዻንጎ ዓይሤኔ፤ <note caller="-" style="x"><char style="xo" closed="false">11፡33 </char><char style="xt" closed="false"><ref loc="DAN 6:1-27">ዳኣኔ. 6፡1-27</ref>።</char></note> <verse eid="HEB 11:33"/><verse number="34" style="v" sid="HEB 11:34"/>ታሚ ዎልቄያ ባሼኔ፥ ጬንቾ ዓፓሮና ሃይቂፆይዳፓ ቶሌኔ፥ ላቢፃፓ ዶዴኔ፥ ዖልዚና ዔርቴያ ማዔኔ፥ ዔያቶ ዖላኒ ሙኬ ሞርኮኮ ፖኦሊሶ ዳውሴኔ፤ <note caller="-" style="x"><char style="xo" closed="false">11፡34 </char><char style="xt" closed="false"><ref loc="DAN 3:1-30">ዳኣኔ. 3፡1-30</ref>።</char></note> <verse eid="HEB 11:34"/><verse number="35" style="v" sid="HEB 11:35"/>ላኣላ ፔኤኮ ሃይቄ ዒጊኖ ሃይባፓ ዔቄም ዴንቄኔ። ሜሌ ዓሳ ሃይቢፓ ዔቂ ባሼ ናንጊ ዴንቃንዳኔ ጌዒ ዱማ ዱማ ሜቶ ዔኬኔ፤ ዬያይዳፓ ቶሊ ሜታ ባኣያ ናንጋኒያ ኮይባኣሴ። <note caller="-" style="x"><char style="xo" closed="false">11፡35 </char><char style="xt" closed="false"><ref loc="1KI 17:17-24">1ካኣቶ. ማ 17፡17-24</ref>፤ <ref loc="2KI 4:25-37">2ካኣቶ. ማ 4፡25-37</ref>።</char></note> <verse eid="HEB 11:35"/><verse number="36" style="v" sid="HEB 11:36"/>ፔቴ ፔቴ ዓሳ ዓሲኮ ዓማሊ ማዒ ዢራፓና ጳርቂንቴኔ፤ ሃንጎዋታ ሃሣ ዓንጊ ዱፄና ቱኡቲ ቱኡሲ ማኣሪ ጌሌኔ፤ <note caller="-" style="x"><char style="xo" closed="false">11፡36 </char><char style="xt" closed="false"><ref loc="1KI 22:26-27">1ካኣቶ. ማ 22፡26-27</ref>፤ <ref loc="2CH 18:25-26">2ፆኦሲ. ዓሃኬ 18፡25-26</ref>፤ <ref loc="JER 20:2">ዔር. 20፡2</ref>፤ <ref loc="JER 37:15">37፡15</ref>፤ <ref loc="JER 38:6">38፡6</ref>።</char></note> <verse eid="HEB 11:36"/><verse number="37" style="v" sid="HEB 11:37"/>ሹቺናኣ ዹይንቴኔ፥ ማጋኣዜ ጌይንታ ዓንጎና ሄኮ ጳሊንቴኔ፥ ጬንቾ ዓፓሮናኣ ጫርጊንቲ ሃይቄኔ፥ ማራይና ዋኣሪናኮ ዒልዒ ማይንቲ ሜታዺ ሃንቴኔ፥ ማንቆ ሃሣ ቤሲባኣ ዓሲያ ማዒ ሃንቴኔ፤ <note caller="-" style="x"><char style="xo" closed="false">11፡37 </char><char style="xt" closed="false"><ref loc="2CH 24:21">2ፆኦሲ. ዓሃኬ 24፡21</ref>።</char></note> <verse eid="HEB 11:37"/><verse number="38" style="v" sid="HEB 11:38"/>ዓሲ ናንጉዋ ዳውሎይዳ፥ ዹኮይዳ ሃሣ ዴኔ ዔቴንታ ዛሬንታይዳ ዎርቂ ዎርቂ ሃንቴኔ፤ ዬያሮ ዓጫ ዔያቶም ኮይሳ ቤሲ ማዒ ጴዺባኣሴ።<verse eid="HEB 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39"/>ዬያታ ቢያ ፔ ጉሙርቂፆና ማርካዺንቴያታቴያ ዔያቶም ዒንጊንቴ ሃጊ ማዔ ዎዞ ጋዓንቴ ዔያቶይዳ ዴንቄይ ባኣሴ። <verse eid="HEB 11:39"/><verse number="40" style="v" sid="HEB 11:40"/>ፆኦሲ ኑም ዑሣ ዓኣዼ ኮሺ ማዔ ባኣዚ ጊኢጊሼሢሮ ዔያታ ኑኡና ዎላ ማዓንዳኣፓዓቴም ዔያቶና ሌሊ ፆኦሲ ማሊፃ ኩማያቱዋሴ።<verse eid="HEB 11:40"/></para>
  <chapter eid="HEB 11"/>
  <chapter number="12" style="c" sid="HEB 12"/>
  <para style="s1">ፆኦሲ ኑኡኮ ዓዶ ማዒፆ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1"/>ዬያጉዴ ሻኣሬ ማዔ፥ ሚርጌ ማርካ ኑኡኮ ዓኣሢሮ ኑኡኒያ ኬዲ ኑም ማዔ ባኮ ቢያ፤ ሃሣ ኑና ቱኪ ዓርቄ ጎሞይዳፓ ዱማዺ ኑኡኮ ቤርታ ዓኣ ጳዦ ጊቢ ዳንዳዒሢና ዶዲ ኑ ጳሽኮም። <verse eid="HEB 12:1"/><verse number="2" style="v" sid="HEB 12:2"/>ኑ ጳሽካንዳሢያ፦ ኑኡኮ ጉሙርቂፆኮ ካራ ማዔሢና ኩንሣያ ማዔ፥ ዬሱሴ ዛጊኬ፤ ሃጊ ዒ ዴንቃንዳ ዎዞሮ ፑርቶ ዓሶ ሱፆ ሚፆይዳ ዓኣ ዻውሲንቶ ሃይቦ ዔኤቢ ማሂ ዛጉዋዖ ሃሣ ዒኢካ ዒ ሃይቄ ሃይቦና ሜታሢና ጉቤ ዳንዳዒ ፆኦሲኮ ካኣቱሞ ዖይቶ ኬስኪ፥ ዒዛኮ ሚዛቆ ዛላ ቦንቾና ዴዔኔ።<verse eid="HEB 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3"/>ዓካሪ ዒንሢ ቶኦዛዹዋያ ሃሣ ሃጊ ማዓንዳ ዎዛባኣ ዓሲጉዲያ ማዒፖቴ፤ ጋዓንቴ ዬያ ቢያ ጎሞ ዓሳ ዒዛ ዒፂ ማዼ ባኮ ጊቢ ዳንዳዔ፥ ዬሱሴ ዛጉዋቴ። <verse eid="HEB 12:3"/><verse number="4" style="v" sid="HEB 12:4"/>ዒንሢ ጎሜ ዒፂ፥ ሃይቢ ሄላንዳኣና ማሹምቦ ዓርቂባኣሴ። <verse eid="HEB 12:4"/><verse number="5" style="v" sid="HEB 12:5"/>ፆኦሲ ዒንሢ ፔኤኮ ናኣቶ ማሂ፦</para>
  <para style="q" vid="HEB 12:5">«ታ ናዓሢዮ! ጎዳ ጎራ ጎሮ ቦሂፖ፤</para>
  <para style="q2" vid="HEB 12:5">ዒ ኔና ሜቶና ጎራ ዎዶና ሃጋኣ ዎዛ ባኣያ ማዒፖ፤<verse eid="HEB 12:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="HEB 12:6"/>ዓይጎሮ ጌዔቴ፦ ጎዳ ፔ ናሽካሢ ጎራኔ፤</para>
  <para style="q2" vid="HEB 12:6">ፔ ናይ ማሂ ዛጋሢያ ዒ ፁንቃኔ»</para>
  <para style="m" vid="HEB 12:6">ጌዒ ዞሬ ዞሮ ዒንሢ ዋሌኔ። <note caller="-" style="x"><char style="xo" closed="false">12፡6 </char><char style="xt" closed="false"><ref loc="JOB 5:17">ዒዮ. 5፡17</ref>፤ <ref loc="PRO 3:11-12">ኮኦኪ. 3፡11-12</ref>።</char></note> <verse eid="HEB 12:6"/><verse number="7" style="v" sid="HEB 12:7"/>ፆኦሲ ዒንሢ ፔኤኮ ናይ ማሂ ዛጋሢሮ ዒዚ ሜቶና ዒንሢ ጎራ ዎዶና ጊቢ ዳንዳዑዋቴ፤ ዓዴ ጎሪ ጳርቁዋ ናይ ዓኣ? <verse eid="HEB 12:7"/><verse number="8" style="v" sid="HEB 12:8"/>ናኣቶ ማዔዞንሢ ዔካ ሜታሢ ዒንሢ ዔኩዋያ ማዔቴ ዓሌ ናይ ዒንሢ ማዓንዳኣፓዓቴም ሾዖና ናይቱዋሴ። <verse eid="HEB 12:8"/><verse number="9" style="v" sid="HEB 12:9"/>ዬይ ዓታዛ ኑና ቢያሢ ጎሪ ፁንቃ፥ ኑና ሾዔ ዓዶንሢ ዓኣኔ፤ ያዺ ማዔቴያ ኑ ዔያቶ ቦንቻኔ። ዓካሪ ሼምፖና ናንጋኒ ኑኡኮ ዓያኖ ዓዳሢም ባሼ ዓይሢንታንዳያ ኑም ኮይሱዋዓዳ? <verse eid="HEB 12:9"/><verse number="10" style="v" sid="HEB 12:10"/>ኑ ዓዶንሢ ዔያቶም ኮሺ ማዒ ጴዼ ጎይፆ ዻካ ዎዴም ኑና ጎሪ ፁንቃኔ፤ ፆኦሲ ጋዓንቴ ዒዛና ዎላ ኑ ጌኤሺ ማዓንዳጉዲ፥ ኑና ማኣዳ ባኣዚሮ ሜቶና ኑና ፁንቃኔ። <verse eid="HEB 12:10"/><verse number="11" style="v" sid="HEB 12:11"/>ጎሪ ፁንቆ ፁንቃ ቢያ ዒማና ዖዪሳያኬ፥ ዎዛሳያቱዋሴ፤ ጊንፃፓ ጋዓንቴ ጊቢ ዳንዳዒ ዔሬ ዓሶም ኮሹሞ ኩሜ፥ ፂሉሞ ናንጊ ጴዺሻኔ።<verse eid="HEB 12:11"/></para>
  <para style="s1">ዞሮና ላቲሢና</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12"/>ዬያሮ ዒንሢ ዓያኖ ዛሎና ላቤ ላቢፃፓ ዶዱዋቴ። <note caller="-" style="x"><char style="xo" closed="false">12፡12 </char><char style="xt" closed="false"><ref loc="ISA 35:3">ዒሲ. 35፡3</ref>።</char></note> <verse eid="HEB 12:12"/><verse number="13" style="v" sid="HEB 12:13"/>ዎቦ ማዔሢ ዻቂ ፒዛንዳጉዲ ማዓንዳኣፓዓቴም ፔቶ ዣኣሉዋጉዲ ዒኖ ዒንሢኮ ፒዜ ጎይሢ ዔኪ ዓኣዹዋቴ። <note caller="-" style="x"><char style="xo" closed="false">12፡13 </char><char style="xt" closed="false"><ref loc="PRO 4:26">ኮኦኪ. 4፡26</ref>።</char></note><verse eid="HEB 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14"/>ዓሲ ቢያና ኮሺ ናንጋኒ ማሉዋቴ፤ ፆኦሲም ዱማዼያ ማዓኒያ ዶዱዋቴ፤ ዓይጎሮ ጌዔቴ ፆኦሲም ዱማዺባኣዖ ዖኦኒያ ዒዛ ዛጋኒ ዳንዳዑዋኣሢሮኬ። <verse eid="HEB 12:14"/><verse number="15" style="v" sid="HEB 12:15"/>ዒንሢዳፓ ዖጊዳኣ ፆኦሲ ኮሹሞና ዒንጋ ዒንጊፃ ፓጪ ጴዹዋጉዲ ዒንሢና ዔሩዋቴ፤ ዬያጉዲ ሃሣ ዓይጎ ዓሲያ ዒንሢ ባኣካ ጫንቃ ሚሢጉዲ ማዒ ኬስኪ ዒንሢ ሜታሱዋጉዲና ሚርጌሢ ፑርቲሱዋጉዲ ዒንሢና ዔሩዋቴ። <note caller="-" style="x"><char style="xo" closed="false">12፡15 </char><char style="xt" closed="false"><ref loc="DEU 29:19">ላሚ. ዎማ 29፡19</ref>።</char></note> <verse eid="HEB 12:15"/><verse number="16" style="v" sid="HEB 12:16"/>ዒንሢ ባኣካ ፔቴና ሙዖ ሙኡዚሮ ጌዒ ቶይዱሞ ሻንቼ፥ ዔኤሳዎጉዲ ዻቢንታያ ሃሣ ጊንሣ ፆኦሲ ቦንቺሱዋያ ማዔ ዓሲ ጴዹዋጉዲ ዒንሢና ዔሩዋቴ። <note caller="-" style="x"><char style="xo" closed="false">12፡16 </char><char style="xt" closed="false"><ref loc="GEN 25:29-34">ማዢ. ማፃ 25፡29-34</ref>።</char></note> <verse eid="HEB 12:16"/><verse number="17" style="v" sid="HEB 12:17"/>ጊንፃፓ ዔኤሳዎ ዓንጆ ዔካኒ ኮዔ ዎዶና ዓንጆ ዒዚ ላኣጊንቴሢ ዒንሢ ዔራኔ፤ ዎዚ ዒ ዬኤኪ ዬኤኪ ዬኖ ዓንጆ ዶዲ ኮዔቴያ ዴንቃኒ ዒ ዳንዳዒባኣሴ፤ ዓይጎሮ ጌዔቴ ዒ ቤርታ ዻቤ ዻቢንቶ ቡኡፆንዶ ካራ ዒዛም ጴዺባኣሢሮኬ። <note caller="-" style="x"><char style="xo" closed="false">12፡17 </char><char style="xt" closed="false"><ref loc="GEN 27:30-40">ማዢ. ማፃ 27፡30-40</ref>።</char></note><verse eid="HEB 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18"/>ዒንሢ ኩቻ ዓርቂንታኒ ዳንዳዑዋያ ሃሣ ጊንሣ ታማ ዔኤታ ሲና ዹኮ ሄሊባኣሴ፤ ጌይፃ፦ ቃኣያሢ ቤዞ፥ ዹሞ ቤዞ፥ ዓልጋሢ ዔቄ ቤዞ፥ <verse eid="HEB 12:18"/><verse number="19" style="v" sid="HEB 12:19"/>ዛዮ ዑኡዛ ጊንሣ ሃሣ ጌይንታ ባካ ዋይዚንታ ዑኡዛ ዓኣ ቤዞ ባንሢ ዒንሢ ሄሊባኣሴ፤ ዬያ ባኮ ዋይዜ ዓሳ፦ «ሃይፓ ሴካ ሜሌ ባኣዚ ኑም ኬኤዚንቶፓ» ጌይ ሺኢቄኔ። <note caller="-" style="x"><char style="xo" closed="false">12፡19 </char><char style="xt" closed="false"><ref loc="EXO 19:16-22">ኬሲ. ማፃ 19፡16-22</ref>፤ <ref loc="EXO 20:18-21">20፡18-21</ref>፤ <ref loc="DEU 4:11-12">ላሚ. ዎማ 4፡11-12</ref>፤ <ref loc="DEU 5:22-27">5፡22-27</ref>።</char></note><verse eid="HEB 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 12:20"/>ዓይጎሮ ጌዔቴ፦</para>
  <para style="q" vid="HEB 12:20">«ዹኮ ቆልሞ ሄሌቴታዖ</para>
  <para style="q" vid="HEB 12:20">ሹቺና ዹይንቲ ሃይቆንጎ»</para>
  <para style="m" vid="HEB 12:20">ጋዓ ዓይሢፃ ዔያቶም ዴኤፄሢሮ ዔካኒ ዔያታ ዳንዳዒባኣሢሮኬ። <note caller="-" style="x"><char style="xo" closed="false">12፡20 </char><char style="xt" closed="false"><ref loc="EXO 19:12-13">ኬሲ. ማፃ 19፡12-13</ref>።</char></note><verse eid="HEB 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 12:21"/>ዬካ ጴዻ ባካ ሚርጌ ዒጊቻያ ማዔሢሮ ሙሴታዖ</para>
  <para style="q" vid="HEB 12:21">«ታ ዒጊጪ፥ ጎጋይቄኔ» ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">12፡21 </char><char style="xt" closed="false"><ref loc="DEU 9:19">ላሚ. ዎማ 9፡19</ref>።</char></note><verse eid="HEB 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22"/>ዒንሢ ጋዓንቴ ፂዮኔ ዹኮ ባንሢ ሙኬኔ፤ ዬይያ፦ ባይቁዋ ፆኦዛሢ ካታሞ ማዔ፥ ጫሪንጮ ዬሩሳላሜኬ፤ ዒኢካ ዎዛና ቡኪንቴ፥ ፓይዲንቱዋ ዺቦ ኪኢታንቾ ባንሢ ዒንሢ ሙኬኔ። <verse eid="HEB 12:22"/><verse number="23" style="v" sid="HEB 12:23"/>ሃሣ ሱንፃ ዔያቶኮ ጫሪንጮይዳ ፃኣፒንቴ፥ ኪሪስቶሴ ጉሙርቃ ሺኢጲፆ ማኣሮ ዓሶኮ ቶይዶ ማዔ፥ ኪሪስቶሴ ጉሙርቃ ዓሶ ቡኪንቶ ባንሢ ጊንሣ ሃሣ ቢያሢም ዎጋያ ማዔ፥ ፆኦዛሢና ፆኦሲ ዔያቶ ማዖም ጌዔ ጎይፆ ማዔ፥ ኮዦ ዓሶ ዓያኖና ባንሢ ዒንሢ ሙኬኔ፤ <verse eid="HEB 12:23"/><verse number="24" style="v" sid="HEB 12:24"/>ሃሣ ፆኦሲና ዓሲናኮ ባኣካ ዓኣ ዓኮ ጫኣቁሞ ጊኢጊሼ፥ ዬሱሴ ባንሢ፤ ዬያጉዲ ሃሣ ዓኣቤኤሌ ሱጉፃፓ ባሼ ኬኤዛ፥ ጎሜ ጌኤሻኒ ፑጪንቴ ዒዛኮ ሱጉፆ ባንሢ ዒንሢ ሙኬኔ። <note caller="-" style="x"><char style="xo" closed="false">12፡24 </char><char style="xt" closed="false"><ref loc="GEN 4:10">ማዢ. ማፃ 4፡10</ref>።</char></note><verse eid="HEB 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25"/>ዬያ ኬኤዛ ባኮ ዒንሢ ዒፁዋጉዲ ዒንሢና ዔሩዋቴ፤ ዓይጎሮ ጌዔቴ ዬያታ ሳዓፓ ዔያቶም ኬኤዛ ዎዶና ዒፂ ዔያታ ቶሊ ዓቲባኣያ ማዔቴ፥ ጫሪንጫፓ ኑም ኬኤዛሢዳፓ ኑ ሃኬቴ ዎይቲ ኑ ቶላንዳይ! <note caller="-" style="x"><char style="xo" closed="false">12፡25 </char><char style="xt" closed="false"><ref loc="EXO 20:22">ኬሲ. ማፃ 20፡22</ref>።</char></note> <verse eid="HEB 12:25"/><verse number="26" style="v" sid="HEB 12:26"/>ዒማና ዒዛኮ ዑኡዛ ሳዖ ዓጊሤኔ፤ ሃሢ ጋዓንቴ፦ «ሳዖ ሌሊቱዋንቴ ፔቴና ላሚ ጫሪንጮንታ ዎላ ታ ዓጊሣንዳኔ» ጌዒ ጫኣቄኔ። <note caller="-" style="x"><char style="xo" closed="false">12፡26 </char><char style="xt" closed="false"><ref loc="HAG 2:6">ሃኣጌ 2፡6</ref>።</char></note> <verse eid="HEB 12:26"/><verse number="27" style="v" sid="HEB 12:27"/>ዬይ «ፔቴና ላሚ» ጌይንቴ ባካ ዔርዛሢ ዓጊፁዋ ባካ ዶዲ ናንጋንዳጉዲ ሃሣ ዓጊፃያ ማዔ፥ ማዢንቴ ባካ ባይቃንዳያ ማዔሢኬ።<verse eid="HEB 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28"/>ዓካሪ ኑኡኒ ዓጊፁዋ ቤዞ፥ ፆኦሲ ዎይሣሢዳ ጌላንዳሢሮ ዒዛ ኑ ጋላቶም፤ ሃሣ ዒ ዎዛዻ ጎይሢ ዒዛ ቦንቺሢና ዒጊጪሢና ዒዛ ኑ ካኣሽኮም። <verse eid="HEB 12:28"/><verse number="29" style="v" sid="HEB 12:29"/>ዓይጎሮ ጌዔቴ ኑ ፆኦዛሢ ሚቺ ባይዛ ታሚ ማዔሢሮኬ። <note caller="-" style="x"><char style="xo" closed="false">12፡29 </char><char style="xt" closed="false"><ref loc="DEU 4:24">ላሚ. ዎማ 4፡24</ref>።</char></note><verse eid="HEB 12:29"/></para>
  <chapter eid="HEB 12"/>
  <chapter number="13" style="c" sid="HEB 13"/>
  <para style="s1">ፆኦሲ ዎዛሳ ጎይሢ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1"/>ቢያ ዎዴ ዎሊኮ ጌርሲ ሃሣ ጌሮጉዲ ናሽኪንቱዋቴ፤ <verse eid="HEB 13:1"/><verse number="2" style="v" sid="HEB 13:2"/>ሾኦቺ ሾኦቺንሢ ዔኪሢ ዋሊፖቴ፤ ዓይጎሮ ጌዔቴ ዬያጉዲ ሾኦቺ ሾኦቺንሣ ዓሳ ዔሩዋዖ ፆኦሲ ኪኢታንቾ ሾኦቺንሢ ዔኬኔ። <note caller="-" style="x"><char style="xo" closed="false">13፡2 </char><char style="xt" closed="false"><ref loc="GEN 18:1-8">ማዢ. ማፃ 18፡1-8</ref>፤ <ref loc="GEN 19:1-3">19፡1-3</ref>።</char></note> <verse eid="HEB 13:2"/><verse number="3" style="v" sid="HEB 13:3"/>ቱኡዞ ማኣራ ቱኡቴ ዓሶና ዎላ ዒንሢያ ቱኡቴ ዓሲ ማዒ ዔያቶም ማሉዋቴ፤ ሃሣ ዔያቶና ዎላ ሜታዻያ ማዒ ሜታሢዳ ዓኣ ዓሶም ማሉዋቴ።<verse eid="HEB 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4"/>ላኣሊ ዔኪ ዎላ ናንጎ ናንጎ ቢያሢ ቦንቻያ ማዖንጎ፤ ዓኒና ማቾና ዎሊ ጉሙርቁዋያ ማዒ፥ ዎሊ ዔኪ ናንጎ ናንጎ ዒኢሶፓ፤ ዓይጎሮ ጌዔቴ ፆኦሲ ዞኦስካ ኮኦማ ፑርቶ ሱኡኮና ዓኣ ዓሶንታ ዓኒ ሃሣ ማቾ ማዒባኣ ዓሶና ላሃ ዓሶዋ ፑርታና ዎጋንዳሢሮኬ።<verse eid="HEB 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5"/>ሚኢሼ ፔቶ ናሽኪሢ ሃሹዋቴ፤ ዒንሢኮ ዓኣ ባኮና ዎዛዺ ናንጉዋቴ፤ ዓይጎሮ ጌዔቴ ፆኦሲ፦</para>
  <para style="q" vid="HEB 13:5">«ማሊ ታ ኔና ኬኤራዓኬ፤ ሃሻዓኬ» ጌዔኔ። <note caller="-" style="x"><char style="xo" closed="false">13፡5 </char><char style="xt" closed="false"><ref loc="DEU 31:6">ላሚ. ዎማ 31፡6</ref>፤ <ref loc="DEU 8">8</ref>፤ <ref loc="JOS 1:5">ዒያ. 1፡5</ref>።</char></note><verse eid="HEB 13:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 13:6"/>ዬያሮ ጉሙርቂ፦</para>
  <para style="q" vid="HEB 13:6">«ጎዳ ታና ማኣዳሢኬ፥ ታ ዒጊጫዓ፤</para>
  <para style="q2" vid="HEB 13:6">ዓሲ ታና ዓይጎ ዎኦታንዳይ?» ኑ ጋዓኔ። <note caller="-" style="x"><char style="xo" closed="false">13፡6 </char><char style="xt" closed="false"><ref loc="PSA 118:6">ዓይኑ. 118፡6</ref>።</char></note><verse eid="HEB 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7"/>ቤርታ ዒንሢም ፆኦሲ ቃኣሎ ኬኤዜ፥ ዓርና ማዔ ዓሶ ዋሊፖቴ፤ ዔያቶኮ ናንጎና ዔያታ ማዼ ማዾኮ ዓኣፖ ጶቂሢ ሃሣ ዔያታ ጉሙርቄ ጎይፆ ጉሙርቁዋቴ። <verse eid="HEB 13:7"/><verse number="8" style="v" sid="HEB 13:8"/>ዬሱስ ኪሪስቶሴ ዚጊኖዋ ሃኖዋ ሃጋ ናንጊና ዓኣ ጎይፆማኬ፤ ላኣሚንቱዋሴ። <verse eid="HEB 13:8"/><verse number="9" style="v" sid="HEB 13:9"/>ዱማ ዱማ ዔርቲባኣ ዔርዞ ዔርዚሢና ዲዒንቲ ዔውቲፖቴ፤ ዒና ኑኡኮ ሙኡዚ ዳምቤ ካፒሢናቱዋንቴ ፆኦሲ ኮሹሞና ዒንጌ ዒንጊፆና ዶዴቴ ቃራኬ፤ ዓይጎሮ ጌዔቴ ዬያ ሙዖ ዳምቦ ካፔ ዓሶ ዬይ ዓይጎዋ ማኣዲባኣሢሮኬ።<verse eid="HEB 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10"/>ኑኡኮ ፆኦሲም ዒንጎ ባኮ ሺኢሾ ቤሲ ዓኣኔ፤ ጋዓንቴ ዓፒሎና ማዢንቴ ማኣሮኮ ጋሮይዳ ማዻ ቄኤሳ ዬኖ ፆኦሲም ዒንጎ ቤዞይዳ ዓኣ ሙዖ ዔኪ ሙዓንዳጉዲ ዓይሢንቲባኣሴ። <verse eid="HEB 13:10"/><verse number="11" style="v" sid="HEB 13:11"/>ዓይሁዶ ዓሶ ቄኤሶኮ ዑፃሢ ጎሜ ጌኤሻ፥ ቆልሞ ሱጉፆ ዔኪ ፆኦሲም ዑሣ ዓኣዼ ዱማዼ ቤዜሎ ጌላኔ፤ ቆልሞኮ ዓሽካ ጋዓንቴ ጉርዶ ዙላ ኬሲ ሚቺንታኔ። <note caller="-" style="x"><char style="xo" closed="false">13፡11 </char><char style="xt" closed="false"><ref loc="LEV 16:27">ሌዊ. ዓኬ 16፡27</ref>።</char></note> <verse eid="HEB 13:11"/><verse number="12" style="v" sid="HEB 13:12"/>ዬያጉዲ ዬሱሴ ዴሮኮ ፔ ሱጉፆና ጎሞ ጌኤሻኒ ካታሞኮ ዙላ ሃይቦ ሜታሢ ዔኬኔ። <verse eid="HEB 13:12"/><verse number="13" style="v" sid="HEB 13:13"/>ዬያሮ ኑኡኒ ጉርዳፓ ዙሎ ኬስኪ፥ ዒዛ ባንሢ ዴንዶም፤ ዒዛና ዎላ ቦሂንቲ፥ ቦሂንቲፆ ኑዋ ዔካያ ማዖም። <verse eid="HEB 13:13"/><verse number="14" style="v" sid="HEB 13:14"/>ዓይጎሮ ጌዔቴ ኑ ሃጊ ሙካ ካታሞ ካፓኣፓዓቴም ሃይካ ሳዓ ባይቁዋዖ ዶዲ ናንጋ ካታማ ኑኡኮ ባኣሴ። <verse eid="HEB 13:14"/><verse number="15" style="v" sid="HEB 13:15"/>ዓካሪ ዬሱስ ኪሪስቶሴ ዛሎና ጋላታ ፆኦሲም ዒንጎ ባኣዚ ማሂ ቢያ ዎዴ ኑ ዒዛም ዒንጎም፤ ዬይያ ዒዛ ሱንፆ ዛሎ ኑ ዻንጎና ኑ ማርካዻ ጋላቶኬ። <verse eid="HEB 13:15"/><verse number="16" style="v" sid="HEB 13:16"/>ሃሣ ኮሺ ባኣዚ ማዺሢና ዒንሢኮ ዓኣ ባኮ ሜሌ ዓሶም ጊሽኪ ዒንጊሢ ዋሊፖቴ፤ ዓይጎሮ ጌዔቴ ፆኦሲ ዎዛሳ ዒንጊፃ ዬያጉዴ ዒንጊፆ ማዔሢሮኬ።<verse eid="HEB 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17"/>ዒንሢኮ ዓርኖ ማዔ ዓሶም ዓይሢንቲ፥ ዔያቶም ዎርቃያ ማዑዋቴ፤ ዓይጎሮ ጌዔቴ ዔያታ ማዻ ማዾ ዛሎ ሚርጌና ዔያታ ዖኦጪንታንዳያ ማዔሢሮ ዒንሢ ሼምፖ ዛሎ ቢያ ዎዴ ዔያታ ዶዲ ማዻኔ፤ ዒንሢ ዔያቶም ዓይሢንታያ ማዔቴ ዔያታ ፔኤኮ ማዾ ዎዛና ማዻንዳኔ። ያዺ ማዒባኣያታቴ ማዻ ዔያቶኮ ዖዪሢና ማዓንዳኔ፤ ዬይ ዒንሢም ጊኢጋዓኬ።<verse eid="HEB 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18"/>ኑም ሺኢቁዋቴ፤ ቢያ ጎይሢና ኮሺ ናንጊ ናንጋኒ ኮዓ፥ ጌኤሺ ማሊሢ ኑኡኮ ዓኣሢ ኑ ዔራኔ። <verse eid="HEB 13:18"/><verse number="19" style="v" sid="HEB 13:19"/>ባሼ ዶዲ ዒንሢ ሺኢቃንዳጉዲ ታ ጋዓሢ ዑኬና ዒንሢ ኮይላ ታ ማዒ ሙካንዳጉዲኬ።<verse eid="HEB 13:19"/></para>
  <para style="s1">ጋፒንሢ ሺኢጲሢ</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20"/>ናንጊና ናንጎ ጫኣቁሞ ሱጉፆና ማራቶኮ ዼኤፒ ሄንቃያ ማዔ ኑ ጎዳሢ ዬሱሴ ሃይባፓ ዔቂሴ ኮሹሞኮ ፆኦዛሢ፥ <verse eid="HEB 13:20"/><verse number="21" style="v" sid="HEB 13:21"/>ዒዛ ማሊፆ ኩንሣያ ዒንሢ ማዓንዳጉዲ ኮሺ ባኣዚ ማዻያ ዒንሢ ማሆንጎ፤ ሃሣ ዒዛ ዎዛሳ ባኣዚ ዬሱስ ኪሪስቶሴ ዛሎና ዒ ኑ ጊዳ ማዾንጎ፤ ዬሱስ ኪሪስቶሴም ናንጊና ቦንቾ ማዖንጎ፤ ዓኣሜን።<verse eid="HEB 13:21"/></para>
  <para style="s1">ጋፒንሢ ሃይሴ</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22"/>ታ ዒሾንሦ! ታ ሚሾንሦ! ሃይ ታ ዒንሢም ፃኣፔ ኪኢታ ዻካ ማዔሢሮ ሃያ ታኣኮ ዞሮ ሃይሶ ጊቢ ዳንዳዒ ዒንሢ ዔካንዳጉዲ ታ ዒንሢ ሺኢቃኔ። <verse eid="HEB 13:22"/><verse number="23" style="v" sid="HEB 13:23"/>ኑ ዒሻሢ፥ ፂሞቴዎሴ ቱኡዞ ማኣራፓ ቡሊንቴሢ ዒንሢ ዔራንዳጉዲ ታ ኮዓኔ፤ ሃሢ ዑኬና ዒ ሃይካ ሙኬቶ ዒዛና ዎላ ሙኪ ታ ዒንሢ ዛጋንዳኔ።<verse eid="HEB 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24"/>ዒንሢኮ ዓርኖና ፆኦሲም ዱማዼ ዓሶናም ቢያ «ኮሺዳ?» ጋዓኔ፥ ጎዑዋቴ። ዒፃሊያ ዓጮይዳፓ ሙኪ፥ ታኣና ዎላ ዓኣ ኪሪስቶሴ ጉሙርቃ ዓሳ «ኮሺዳ?» ዒንሢ ጋዓኔ።<verse eid="HEB 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25"/>ፆኦሲኮ ኮሹሞ ዒንጊፃ ዒንሢ ቢያሢና ዎላ ማዖንጎ።<verse eid="HEB 13:25"/></para>
  <chapter eid="HEB 13"/>
</usx>
