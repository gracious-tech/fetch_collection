<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Gedeo Bible</book>
  <para style="h">2 Yohaannisixxa Erga</para>
  <para style="toc1">Ergemaallo Yohaannisixxa Langaxxa Erga</para>
  <para style="toc2">2 Yohaannisixxa Erga</para>
  <para style="toc3">2 Yoh.</para>
  <para style="mt1">Ergemallo Yohaannisixxa Langaxxa Erga</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Langaxxi Yohaannisixxi eriga borreessendeeki geercho erganjo Yohaanisi darre'ni kaddaa wodda isi borreesseekinna filendeexxe baaba'aanna oose isexxeteni. Akimagaada mitte Mageniinxe tuutaanna unuwwa isexxee kada gophphabaan. Tinn harumaaxxi eriga borreessendechchi insa'ne weli'aanni weli eenaashsha qali assateenna dhariyye barsiissanuwwanaa'ninna insa'nexxe baranonaa'ni ifi xexxe'antaashshaten.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">E'yichcho <char style="ior"><ref loc="2JN 1:1-3">1-3</ref> </char></para>
  <para style="io1">Jalala duuchchiinxenaa'n saxxaani <char style="ior"><ref loc="2JN 1:4-6">4-6</ref> </char></para>
  <para style="io1">Dharinxe barannoxxe xexxe'achchiisa <char style="ior"><ref loc="2JN 1:7-11">7-11</ref> </char></para>
  <para style="io1">Muuxxa <char style="ior"><ref loc="2JN 1:12-13">12-13</ref> </char></para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="s1">Nage'a</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />Geerchokenaa'n.</para>
  <para style="b" vid="2JN 1:1" />
  <para style="p" vid="2JN 1:1">Dhugaati eeyyaannexxe ane calla kadeebo'nok dhugaa ege'neek duuchchi isee eeyya'neexxee filendeexxe baaba'anna oose isexxee; <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />No'o giddo hexxa'neexxe dhugaanaa'ni kexxeexxa;<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />Mageno Aabinna Aabike Belto kadeeke Yessuusi Kiristoosik badhaadhi, marartenna nage'i dhugaatinna jaalalati no'onni welti hedhaan.<verse eid="2JN 1:3" /></para>
  <para style="s1">Dhugaanna Jaalala</para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />Atixxe oose giddii'ni mitte mitte Aabibaa'ni no'aa uwwemeeke ajajishanni dhugaat ti'ni hine me'inaa'naa afeenexxe'e yo'oshsha gammadeennen. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />Tee baaba, edo hedhemmaka malee'e haaroka ajaja ta'a ati'aa borreessa'ebe'non; kuninna no'oo weli'aani weli eenonna'aaten. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />Tinni jaalalanna isike ajajuwwixxe aadashshanni he'nannoshshaten. Ajaji isikinna sirende'ni laqqineemmashshanni jaalalati hexxinaashshaten.<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />Yessuusi Kirisitoosi maalik dageexxa amanabaak heddi deedisaak manni butta duuchcha'n wo'meen. Iitta hedheek huun manjinna dedhisaakenna Kiristoosi'i gareeraaken. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />Ha'noonna elootineemmaka hira gophphinabaashsha, yaane kinni wo'ma gica adhdhitinaashsha umo ha'nooge xexxe'atte. <verse eid="2JN 1:8" /><verse number="9" style="v" sid="2JN 1:9" />Kiristoositoosixxe barachchiisa'ni hedhebaakinna eettene barachchiisa'ni fulaaki duuchchinna Mageni afebaan. Kiristoosixxe barachchiisa'ne hedhaak kinni Mageno Aabiinna Weldii'i afeedheeni. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />Ayyinna ha'noobaa dagoole tenne barachchiisa iyyedagaa gophoole mine ha'nooke'n isoo adhdhitinoqqe; nage'akanna isoo aaxxinoqqe. <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />Isoo adhdhaki manjinna isixxe fuggoxxe hujexxee qoodemmaan.<verse eid="2JN 1:11" /></para>
  <para style="s1">Muuxxatika Nage'a</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />Ha'no'aa borreessonaa halchaannexxi heddo yaane hexxemman; kaddo malee'e woraqatake'ninna tiikoti borreessonaa hasabeno; tenne irra gammashsho no'oxxi wo'mate kaddo'aa ha'nooba dagennexxi ha'noonni afeme'e kulannoxxa addattannon.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />Iitti filendeexxe atixxe dayyoxxi oose nage'a ati'aa dhaanda'neen.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>