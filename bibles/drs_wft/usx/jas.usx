<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Gedeo Bible</book>
  <para style="h">Ya'iqoobixxaa Erga</para>
  <para style="toc1">Ya'iqoobixxaa Erga</para>
  <para style="toc2">Ya'iqoobixxaa Erga</para>
  <para style="toc3">Ya'i.</para>
  <para style="mt1">Ya'iqoobixxaa Erga</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Tinni Ya'iqoobixxi erga barra barraxxe hedhoxxe akeete'a kadaaka yaaduwwa affeexxe kadda wodda borresendeekinna butta duuchcha'ni xeeremeeke tommenna lame gosati minike Magenike ardi'aten; Tenne ergaki borresanji beekuma hita hujete'n hosinsannoke maalixxee, kiristoositotixxe manna adhdha hasissaa qiconna adabiinxe akeette kaddaaxxa yaanuwwa ca'a hiyye leellake haaso'uwwinni shiqishshaan: hiyyummatixxeenna karratixxee, hega uudeemmatixxee, eloke adabbixxee, gaabbetixxee, amanatixxeenna eloxxe hujexxee, arrabiinxe ellexxena fuggoxxe'e, beekuminxe, weli'an wel lolenshatixxe'e, hollatixxena shaqquntexxe'e, wele manna'ni muratixxe'e, ifi saadatixxe'e, ossuntetixxe'e, soodachotixxe, kirsitaan dayyuwi gaddacha'neke yaanuwwaxxe mitte mitteti borrese'en.</para>
  <para style="ip">Ergatinna kirsitoositotixxe hedho'ni amana hujeti leelshatik jeeja farri asse'e leelshan.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">E'yichcho <char style="ior"><ref loc="JAS 1:1">1:1</ref></char></para>
  <para style="io1">Amanatanna beekuma <char style="ior"><ref loc="JAS 1:2-8">1:2-8</ref> </char></para>
  <para style="io1">Hiyyumanna duruma <char style="ior"><ref loc="JAS 1:9-11">1:9-11</ref> </char></para>
  <para style="io1">Hega uushsho <char style="ior"><ref loc="JAS 1:12-18">1:12-18</ref> </char></para>
  <para style="io1">Mageniinka hiyyichcho laqanna hujete'ni hosisaa <char style="ior"><ref loc="JAS 1:19-27">1:19-27</ref> </char></para>
  <para style="io1">Gamissiyyo hasisabaaxxa uwwendeexxa xexxe'achchiisa <char style="ior"><ref loc="JAS 2:1-13">2:1-13</ref> </char></para>
  <para style="io1">Amanattanna huje <char style="ior"><ref loc="JAS 2:14-26">2:14-26</ref> </char></para>
  <para style="io1">Kirsitoosittonna iseka laagada <char style="ior"><ref loc="JAS 3:1-18">3:1-18</ref> </char></para>
  <para style="io1">Kirisitoosittonna tenne butta <char style="ior"><ref loc="JAS 4:1-5:6">4:1—5:6</ref> </char></para>
  <para style="io1">Gargari gargar hexxeexxe yanuwwa'a uwwemeka gorsa <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref> </char></para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="s1">Nage'a</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />Mageniinkenna Gootta Yessuusi Kiristoosike erganjo kaddeeke Ya'iqoobi xexxerendeexxe tommenna lame gosati minuwwi'a; nage'i ha'no'a kadowaal.<verse eid="JAS 1:1" /></para>
  <para style="s1">Rakkonna Hega Uushsho</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />Anke dayyuwwaa! Ha'no'ni garigar, garigarit hexxexxe hega uushsho geltaa wodda wo'ma gammashoshsha laakko'we. <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />Tinninna kaddeechchi ha'nooxxe amanaxxi hega uudema ossa ha'no'aa afissaaxxa egendinaan. <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />Mittiilchinna ha'noo'n xe'yengeechchi hedhebak hara wo'ma kaddinaashsha ossa huje ifixxa huccitowwaal.<verse eid="JAS 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 1:5" />Ha'no giddii'n ayyinna beekumiinxa xa'ya afo'ole ci'mabelo arjumati duuchchiinge uwwaaka Mageno kadhatowwaal; isi'anna uwwendaan. <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />Yaane kinni mamebaang amanat kadhatowwaal; tinni kaddeechchinna mamaak manji diidalloti dhiibemmaakenna elqe kayya lele'mammake abbaayyatike danbala'ishshaten. <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />Iiki manji Goottakenaa'n mitteechchonna alfanno hiyye hedoqqe. <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />Isi lame yaada'ni abidemeekenna ora duuchcha'n elqe kayya higaken.<verse eid="JAS 1:8" /></para>
  <para style="s1">Hiyyummanna Durumma</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />Salphateek dayyi Mageni isoo lummisaammaxxee gammadowwaal. <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />Manjiinxi karra bada'atike daraarsha saxxaammaxxe'e galduma ifike'ni duroomek dayyi Mageni isoo galdumik hojoggi assaa wodda gammadowwaal. <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />Arishsho holatik fuldaa wodda badda'aa bassitaan; daraarkinna harca'aan; daraarrixxi danchummanna baxxaan. Iittanni dureessi manjichchi ifixxe barra barraxxe huje'ni fajjisemmeeshshanni ba'aan.<verse eid="JAS 1:11" /></para>
  <para style="s1">Manjoke'n Geltaaxxa Hegaa Uushsho</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />Hega uudemate'ni ossaak manji eebisemeken; tinninna kaddeechchi hega uushote'n isi osse sa'aa wodda Mageni eeyyaakeri'a uwwaaxxe addachchiisaka, hedhotika kallalcha alfaan. <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />Ayyinna hega uudema wodda «Mageni ane hega uudeeni» hiyyoqqe; Mageni elobaaxxenni hega uudabaan; isi umi ifikinn ayyeenna hega uudabaan. <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />Yaane kinni mitti mitting manji hega uudemaak ifixxe fuggoxxe gaabenni harkisema woddanna sobemaa woddan. <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />Ookkoonechchi uduma fuggoxxi halcha siila'witeexxi cubbo ildaan; cubbotinna nophphite'e reyo ildaani.<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />Eeyendinneke anke dayyuwwaa! Mee sobeeme! <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />Eloxxi uwwanna wo'ma eeba duuchcha iimii'n ifuwwiinke Annanaa'ni dirritaan; tininna daggaak gaadiddo jijjirendammashsha yookaan jijjiirensh aafebaake ifiinke Anna kadeeke Magenokenaa'niten. <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />No'o dada isixxe duuchchik angafuwwa kandanoshsha Mageni fedhii ifixxen, ifike dhugaatike hiyyichchinni no'o i'le.<verse eid="JAS 1:18" /></para>
  <para style="s1">Laqatanna Lanqeexxa Hujete'ni Hosisa</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />Eeyendineeke anke dayyuwwaa! Tenne'e qalbeefatte; manji duuchchi laqatee ariifateke, haaso'akenna hekki hiyyeeke, mufeteena muddamabaake kaddowwaal. <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />Tinninna akadeechchii manjiinxi mufe Mageniinxa qullumma iyyedaggabaan. <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />Tennexxe battummatanna faqqeexxa fuggo duuchcha fugustineexxi Mageni qalbe ha'nooxxe'n kaasexxa lubbo ha'nooxxa anjira dande'aaka hiyyichcho shaqqunteti adhdhe.<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />Hiyyichchi haaso'aaxxa asse malee'e ifi dedhisina'n laqqinaake kaddinoqqe'e. <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />Hiyyichcho laqeexxi hiyyichchi hiyyaaxxa assabaak manji alba ifika daa'witeti uuxxedhaake manjishshaten. <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />Iikki manjichchi alba ifika da'witete'ni uudeexxi me'aan; albi isik maa fakkaataxxa iikki woddi dedhaan. <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />Yaane kinni iso leexxa fulchaaka wo'ma seera uudeexxi iso'n jabaataki laqeexxa hujete'n hosisaakinna dedhabaak huje isixxenni eebisemmeeke kadaan.<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />Arrabo ifika ifi heqqedhebaangi, qalbe ifixxa dedhissa'n ifi ammaangummate afeene hiyyaki manji ifi dedhisaan; ammaangumma isixxinna toliinxen. <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />Mageni Aabi edo luqqitenna battotebaaxxi ammaangumma, hadi insa'neki reyeexxa oosenna aro'i insa'neki reyeexxa melaale rakko insa'nexxe'ni gargaarra, butta duuchchixxe battummanaa'ni ifi heqqaten.<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s1">Gamissiyyo Hasissabaaxxa</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />Anke dayyuwwaa! Ulfiniinke Gootta Yessuusi Kiristoosi'n amandineemmaxxee gamissinoqqe'e. <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />Worqetixxa qube uggudheekinna eloxxa seemma oddo'wek manji ha'nooxxe bukki giddi'aa dagoole, iittanni xurte seemma oddo'week hiyyeesi manji e'yoole, <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />ookkene eloxxa seemma oddo'weeke manjichchi'aa ulfinna uwwati, «Konne eloke booncho'ni ofo'li» hitnoolenna hiyyeesa manjichcho kinni, «Ati ookko uuri» yookaan «Anxe lekka unda butta ofo'li» hitinooele; <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />ha'nooxxe oddo'ni gamissiyyo assaa gophphineetaa? Iittanna fuggoke yaaddinni abidendineeki muralluwwa kadatebaataa?<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />Eeyendineeke anke dayyuwwaa! Laqqe, Mageni amanati dureeyete kandaashshanna isoo eeyyakeri'aa addatema uwweemmaxxa mootumma dhaalashsha tenne butta duuchchaxxa hiyyeeyye isi filebaan hiyyoteetaa? <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />Ha'noo kinni hiyyeeyye salphisine'een. Ha'noo wixxirri assitaaxxi dureeyyetebaataa? Murtetike minibaa ha'noo harlkisa'neek insa'netabaataa? <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />Ha'noonni ye'emma'neeka ulfichcha summa yowwina'neeki insa'netebaataa?<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />Woyyichcha maxaafa'ni, «Jaalo ifika umo ifikishsha assite'e eeyyi!» hiyyemme borreessemmeeka ulfichcha seera muuxxinoole eloxxe assate'ni hexxineen. <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />Gamisinoole kinni cubbo hujjine'een hiyyoten; seeri edonna seera qaxxaammuraakishsha uudendinaan. <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />Tinninna kaddeek seera duuchcha muuxaki yaane kinni mitteke'ni guggufataak hedhoole duuchchiinga seera qaxxaammureeshsha uudeman. <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />«Yabaabuldoxxe'e» hiyyeek iikki Gootti iittanni, «Shilittoxxee» hiyyeemmaxxeten. Tennexxee yabaabula gophphotolenna midde shilitoottole seera qaxxaammurteetten. <verse eid="JAS 2:11" /><verse number="12" style="v" sid="JAS 2:12" />Haasotinaa woddanna kadi, hujinna wodda leexxumma uwwaake seerinni murema'neeke mannishsha kadde. <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />Tinninna kaddeechchi mararabaak duuchcha'ni mararte belo iso'ni murendaan. Mararte murte injiffataan.<verse eid="JAS 2:13" /></para>
  <para style="s1">Amananna Huje</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />Anke dayyuwwaa! Manji mitti «Anii amanaa afeenneni» hiyyoole huje kinni afa gopheexxe kaddoole maa la'o affe'e? Iitta hexxeexxi amanata isoo anjira dandeetaataa? <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />Mitti dayyi yookaan mitte dayyo oddo'winaaxxa seemmanna kadi indaachcho gonphee'naa, <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />ha'noo giddii'ni miitti insa'ne, «Nage'iki me'ee! Meenni boojo'we; godde» hiyyoole yaane kinni biso insa'eke hasissaachcho uwwaa gonphoole maa la'o anfe'e? <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />Iittanni huje affebaaxxi amana umo isengee rerteexxeni.<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />Yaane kinni mitti manjii, «Ati amanaa affeeteni; Ani eloxxa huje afeeneni» hiyyaan.</para>
  <para style="p" vid="JAS 2:18">Amanaa atixxa hujetenaa'n gargar hiisite'e ani'aa leelshi, aninna amanaa anxaa hujenni ate'ni leelshannon hiyyannon. <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />Ati Magen mitteke kadeexxa amandatton. Tinni eloxxen! Amanatenna kaddoole fuggichchi hafuuruwwinna tenne amanaan; insa'nenna alanne culphinsaan. <verse eid="JAS 2:19" /><verse number="20" style="v" sid="JAS 2:20" />Ati gowwi manji, eloxxe huje beloo hexxeexxi amana atixxi gumma affebaaxxe egendottaa hassaate? <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />Anni no'oki Abirihaami belto ifika Yisaaqii'i tolchimalchoke'n shiqishshee wodda, eloxxe hujenni qulloommeemmabaataa? <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />Tennenni amanaa huje isexxe welt mitteba hexxeemmaxxanna isixxi huje wo'mate kaddeexxa uudaaboxxoo. <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />«Abirihaaminna Mageno amaneen; amana isixxinna qullumate kadde isi'aa laakko'ende» hiyyaak Woyyichchi maxaafik hiyyichchi muuxeme. Konne orinni Abirhaami Mgeniinke jaalo hiyyemeen. <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />Yoonna amana callinnite kaddeebaang hujeti manji qulloommaaxxa uudaaten. <verse eid="JAS 2:24" /><verse number="25" style="v" sid="JAS 2:25" />Iittanni Re'aabi hiyyendaammaxxi yababulto ookkone erganjuwwa adhdhiteexxi wele ora meinaashsha assitee wodda eloxxe hujenni qullitete kadebaataa? <verse eid="JAS 2:25" /><verse number="26" style="v" sid="JAS 2:26" />Lubbotena'ni garga higeek bisi reyammashsha iittanni hujenaa'n gargar higgeexxi amana reriteexxen.<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s1">Arabo Leenjisa</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />Anke dayyuwwaa! Ha'noo giddii'ni heddi barsisalluwwake kadoqqe'e; tinninna kaddeechchi lumoxxa murte adhdhinannoxxa egendine'een; <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />No'o duuchchiingi heddo yaane'n dedhake'n inbanon. Haaso'ake haaso'a'ni dedhake'n ibabaki hedheexxe kaddoole isi biso ifika duuchcha hira dande'eeke wo'ma manjon. <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />Fadhadi no'aa ajajemaashsha afo'oke'ni bixaala e'yinshanno wodda ookkene fadhadika biso duuchcha akeeka dandeennanon; <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />yookaan ha'noo marka uudde. Fedhee qico midde lumoxxenna jabaaxxe diidallonni oofemmaake kandoolna, isoo oofammak manjichchi shiixxoxxe marenni ookkone markaba eeyyebaa akeekaan.<verse eid="JAS 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 3:5" />Iittanni arraabi shiixxoke bisiinke qoola kadeen hedhee lomollamma yaanuwwa'ni ifi saadaan. Lumoka gongoma shiixxoxxi giira ittee birataa qico qalbeefatte. <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />Arrabikinna iittanni giiratishshateni; isi no'oke bisiinke qooluwwi giddo afemaake fuggitte buttan; isi biso no'oka battoosaan; iittanni gehaanme giddii'ni fuldaammaxxe giirashsha hedho no'oxxika me'injo duuchcha gubaan. <verse eid="JAS 3:6" /><verse number="7" style="v" sid="JAS 3:7" />Heene bifaki binchuwwi, ci'aa, iittanna buttate'n godobiki me'aachchuwwi, abbaaya giddo hexxaaxxi dada duuchcha leenjisema dandende'eedaan; manjikinna konnelchuwwa lenjise'een. <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />Yaane kinni arrabo dande'e leenjisaak ayyinna hedhebaan. Shiltaaxxi ha'laa isi giddo wo'miteekenna hafuura adhitabaxxe fuggoxxe yaanen. <verse eid="JAS 3:8" /><verse number="9" style="v" sid="JAS 3:9" />Arrabo no'okenni Gootta no'okanna Mageno Aabi eebinsanon; isinninna Mageniinxe fakkenni dademeeka manna bandannon. <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />Mitte afo'onaa'ni eebatinna badino fuldaani. Anke dayyuwwaa! Tinni kadiyyo hasisabaan. <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />Mitte muummena'ni xe'maakinna qararaak wodi'i meyaa fulaa dande'aataa? <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />Anke dayyuwwaa! Balasetik haqqichchi ejersiinxa gumma yookaan weyinetik hiddichchi balasetixxa gumma gummisate'e dande'aataa? Iittanni maxinetike wode'enaa'n xe'maaki wodi'i afema dande'abaani.<verse eid="JAS 3:12" /></para>
  <para style="s1">Iimika Beekuma</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />Ha'noo giddii'n beekinna wodaniik manji ha'nooxxe oddo'ni ayyetee? Beekakenna eloke manjo kada isixxa elooke adabininna eloxxe hujenni leelishshowwaal. <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />Yaane kinni qaraarito gaabenna umo ifika ifi eeyya ha'nooxxe qalbe'n hexxoole tennexxe mee ifi saadde; dhugaate'n waakaatinoqqe'e. <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />Iitta hedhdheki beekumi iimi'n dageekebaan; yaane kinni butta duuchchike, maalinkenna fuggichchi hafuurken. <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />Gaabetinna umo ifika eeyya hexxeeba ookko weekenshanna fuggoxxi huje hexxaan. <verse eid="JAS 3:16" /><verse number="17" style="v" sid="JAS 3:17" />Yaane kinni iimate'naa'ni dagaak beekumi kinni sirte'ni ca'ichchak, higgeen nage'aa eeyyaake, shaqqake, ajajemaake, mararitenna eloxxi gumma wo'miteeke, gamisanna holla hexxebaaken. <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />Qullummatixxi gumma nage'aa eeyyaake manni'a nage'iki facaassendaani.<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s1">Butta Duuchchanni Jaaloma</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />Ha'noo giddo hedheek bagedinna weli giba habaan'ni dageexxe? Ha'nooke bisi giddo lolenda'neexxe ha'nooxxe gaabenaa'nitebaataa? <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />Mitte yaane alfitino'a halchitinaan; yaane kinni alfitinabaan. Tennexxee manjo shiltinaan; haristinaani alfa dandetinabaan. Lolindinaani, weli aatinaani ha'noo soodachcho gophphinaammaxxe'e halsitinaaxxa yaane alfitinabaan. <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />Soodatinaa wodda soodachchotika hiissichcho alfa gophphinaachchi eettene soodatineemmaxxa yaane maaliinxe gammashsho'n hosilsate'ee fuggoke yaadinni soodatinaammaxxeten.<verse eid="JAS 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 4:4" />Koo ha'noo yabaabuluwwaa! Tenne butta duuchchanni jaaloma Mageniinke naaphpha kadate kaddeexxa egendinebaata? Yoona butta duuchchake jaalo kada eeyak duuchchi Magniinke naapha kade'een. <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />Iittanni Woyyichchi maxaafa, Magen no'o giddo uggeeki hafuuri isi callalinni he'nonnaa jaba qicinni hinaafaan hiyyek tolange ha'no'n labbe'ee? <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />Yaane kinni Mageni badhaadha bira sa'isse'e uwwaan woyyichchi Maxaafinna,</para>
  <para style="q1" vid="JAS 4:6">«Mageni ifi dukaaka manna gareeraani</para>
  <para style="q2" vid="JAS 4:6">shaqqake manni'a kinni badhaadha uwwaan»</para>
  <para style="q1" vid="JAS 4:6">Hiyyeeki tennexxeeten.<verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />Yoona ifi Magenoke hirissiise! Durrissa kinni gareere; isinna ha'noona'ninna baajani. <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />Mageniinbaa shiqqe; isinna ha'noobaa shiqaani; ha'noo cubbaalleeye anga ha'nooxxa luqqi assedhe; ha'noo lame yaadinni daaqinaak qalbe ha'nooxxa ca'a assedhe. <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />Wixixxi hiyye, yaade, oodhe; osso'lichcho ha'nooka yaadotibaa, gammashsho ha'nooxxinna yaadotiba jijjiirendowwaal. <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />Gootti edo ifi heeshshi asse; isinna ha'noo iimi'a qophphi assaan.<verse eid="JAS 4:10" /></para>
  <para style="s1">Dayyoke'ni Mura Gopha</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />Dayyuwwaa! Weli'aani weli fugoxxa haasotinoqqe; dayyoke'ni fuggoxxa haaso'aaki, yookaani dayyoke'ni muraaki seerake'ni fuggoxxa haaso'aan. Seerake'ninna muraan; ati seerake'ni murtottole ati murtaateke malee'e seerakee ajajendaattekebaan. <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />Seera uwwaakinna muraaki mitte Mageno callannni; isinna anjiranna balleesa dande'aaken. Tennexxe ati jaaloke'ni murataatek ati aayyetee?<verse eid="JAS 4:12" /></para>
  <para style="s1">Ifi Dukate'e Uwwendeexxa Xexxe'achchiisa</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />Ha'noo «Telcho yookaani soodo ookkone qachchibaa mare'e mitte wogga ofo'lanon; ookko'o daddalnexxi ibilsinannon» hitina'neki laqqe. <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />Soodo kaddaaxxa midde egendinebaani; hedho ha'nooxxi isenni maachcho? Ha'noo heenooxxe yanna leelitexxi hirbange'n ba'aamake fincinke hafuurshaten. <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />Tenne erra ha'no'o hiyya hassissaaxxi «Magniinxe fedhi kaddoolenna he'naanole tenne yookaan eettene assinnannon» hiyyaa hassissaan. <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />Ta'a kinni ha'noo holla ha'nooxxenni kijibina'neen. Iittaa hexxeexxi ifi duka duuchchi fuggoxxen. <verse eid="JAS 4:16" /><verse number="17" style="v" sid="JAS 4:17" />Yoonna eloxxe kaddeexxa yaane assa hasisaaxxa ege'na'ninni hedhee assabaak manji cubbo hujaan.<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s1">Dureeyyetee Uwwendeexxa Xexxe'achchiisa</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />Yoonna ha'noo Ta'a dureeyye laqqe! Ha'noo'n geltaaxxe jabaxxe rakkoxxe'e oodhdhe, hunbaashshe. <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />Karra ha'nooxxi aloote'een; seemma ha'nooxanna bile itte'een. <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />Ha'nooxxi worqenna biretik sblji ha'nook ciile'een. Tinni ciilanna ha'noo'ni dhugaate kaddaan, maala ha'nokanna giiratisha ittaan. Ha'noo udumike bari'a karra tuulitine'een. <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />Ha'noo qalbeefatte midhaa ha'nooxxa haamemma'ni hoseemake hujalluwwi'a uutinebaak gateek rundi ha'noo'ni raara'neen; haamemmake mannixxi raarenna dada duuchcha ajajaake Duuchchi Woddik Gootti Magenixxe mansha'ni laqende'een. <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />Ha'noo buttate'ni danqashanna gammashshoti hexxina'een. Dulematixxe barra'a qalbe ha'nooxxa furdilsitine'een. <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />Ha'noo gibebaaka balleesa afebaaka manna balleesanjoke assitine'een; insa'neenna shiltine'een.<verse eid="JAS 5:6" /></para>
  <para style="s1">Ossanna Soodachcho</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />Yoonna dayyuwwaa! Goottiink dagi qico'ni ossitine heqqedhdhe. Fichcha huccaaki buttinni eloxxa gumma uwwaa qico'ni hittaaa oossaaxxa edikanna udumika xeena hittaa heqqedhaaxxa qalbeefatte. <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />Ha'noonna iittanni osse; qalbe ha'nooxanna dhuudhedhdhe; tinninna kaddeechchi Goottiink dagi shiqeemmaxxeten. <verse eid="JAS 5:8" /><verse number="9" style="v" sid="JAS 5:9" />Yoonna dayyuwwaa! Ha'noo weli'aanni weli maammuqinoqqe; iitta kada gophphoole ha'noo'ni murendaan. Kunse muraake hulate'ni uure'een. <verse eid="JAS 5:9" /><verse number="10" style="v" sid="JAS 5:10" />Yoonna dayyuwwaa! Goottiinke summinni raaga raageemmakaara rakkotikenna ossuntetike fakkeenna assitine insa'ne uudde. <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />Yoona ossati ti'ni hiyyeekara eebiseemmekeera hinaanenni. Iyyoobi hittaa osseexxa laqqine'een; Goottikinna uduma isi'aa asseexxa uudine'een. Gootti hara o'wallokenna mararraloken.<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />Anke dayyuwwaa! Duuchchiinxi erra iimate'ni yookaan buttatte'n yookaan hee'ne yaane'ninna midde kakatinoqqe'e. «Eeti» kaddoole «Eeti» kaddowwaal; «waawwo» kaddoole «waawwo» kaddowaal; iittate kada gophphoole ha'noo'ni murendaan.<verse eid="JAS 5:12" /></para>
  <para style="s1">Amanati Soodachcho</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />Ha'noo giddii'ni rakko gelteek manji hedhee? Isi soodattowwaal; gammada'neeke hedhee? Glatiinxa faaro farsowwaal. <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />Ha'noo giddo ela gophpheeki manji hedhee? Isi Mageniinxe tuutaxxa geedhdhe ye'edhowwaali; insa'nenna Goottiinke summinni zayite hariireexxi isi'aa soodantowwaal. <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />Amanati assendaaxxi soodachcho ela gophpheeka manjo fayyisaan; Goottikinna isoo ke'isaan; cubbo hujeexxe kaddoolenna isi'a gattowaal hiyyendaan. <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />Tennexxe cubbo ha'nooxxa weli'aanni weli faaci'we; fayyitino'aanna mitti mittekee soodatowwaal. Qullichchi manjixxe soodachcho hunna affe'een; jabaxxa yaanenna assitaan. <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />Eelyaasi no'oshshanni manjokemmani. Isinna xeeni ganabaashsha jabeesseexxi soodate; bogake'ninna sase wogganna gamisa xeeni ganebaan. <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />Higgeeni isinna soodate xeenikinna iimi'ni gane; buttatinna gumma uute.<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />Anke dayyuwwaa! Ha'noo giddii'n mitti manji dhugaatenaa'ni dedhee'naa weli isoo dhugatibaa hiisoole, <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" />tenne qalli hiyye; cubbichcha dedhemake oranaa'ni hiisaak manji lubbo ookkene cubbichchi manjixxa reyotenaa'ni gatisaan; isixxa heddo cubbonna buqedhdhaan.<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>