<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Gedeo Bible</book>
  <para style="h">Ergameeyyetixxaa Huje</para>
  <para style="toc1">Ergameeyyetixxaa Huje</para>
  <para style="toc2">Ergameeyyetixxaa Huje</para>
  <para style="toc3">Erg. Huj.</para>
  <para style="mt1">Ergameeyyetixxaa Huje</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Eregameeyyetixxi huje Luqaasixxe wengeelenaa'n itti aande'eexxi konne maxaafik umi yaadi itti edixxi Yesuusixxi hordofeeyye Hafuura isikenni akeekemeexxi isixxee haasotaaxxa eloxxe oddoka hiyyichcho Yerusaalemi'n Yihudake boga duuchcha'n Samarya'n buttatixxe gabal qioc'n (1:8) wengeele hitta geessisseexxa haaso'ateten; Kunni maxaafi Kirsitoositotixxe amana Yihudiinxe oddo'n saffeexxi butta duuchchike ardixxe amana kadda qico hitta ba'lateexxa haasotaaxxe jirten; Borreessanjikinna Kiristoosito Romika moyanjimmatixxa mootumma haaso'ati giddo sho'ik daba hujaake manna insa'ne kandebaaxxanna kiristoostotixxi amana Ayihudiinxa amana wo'mate kaddaashsha assitaaxxa leellishatee jabaxxi wo'laancho assende'een; Ergameeyyetixxi huje Yesuusixxee haaso'aak hiyyichchi geyaaba yanna yana'ninni ba'lata'ne me'eexxanna beetekirstaanetixxi kaasensha ifisaaxxe sase umo kutuwwa'n dhaabema dande'aan 1. Kirsitoostotixxi amana Yessuusixxe iimi'a me'ati uduma Iyyerusaalimi giddo saffeexxa. 2. Isiraalike boga duucha'n gayatixxa 3. Roominni welti abideexxi Medtiryaanixxe abbaayyaxxe dowwa'n hedheeke boguwwa'n ba'lateexxa. Ergameeyyetixxe huje giddo adda fakande leellitaaxxi Woyyichchi Hafuurixxe huje kaddaa wodda onde tomeessoxxe barra'n Iyyerusaalemi goddo hexxemmaxxa amaanne'n hunnati darreexxa, iittanni konne maxaafi giddo ifisendeexxe hujuwwa duuchcha'n leellitemmashshanni Woyyichchi Hafuur beete kirsitaane giddonna iseka akeekisanjuwwanna akeekeexxanna jajjabeessaxxanna itti lebaan. Olmike baro'n shiqeemmaxxi kiristoostixxi erga gargar hedheek lalabuwwi giddo umo yaaduwwinni shiqe'een; Ergameeyyetixxe huje'n kaddeexxi yaanuwwa itti erga amaaneeke mannixxe hedho'ninna beete kiristaanexxi mittumma'n hexxemmaxxa hunna hittee qico lumoxxe kaddeexxa barrissaan.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Dhugaa kula isixxixxa qixxeffachcho <char style="ior"><ref loc="ACT 1:1-26">1:1-26</ref> </char></para>
  <para style="io1">Yessuusi muuxamake'n uwweeka ajajuwwanna addachchiisa <char style="ior"><ref loc="ACT 1:1-14">1:1-14</ref> </char></para>
  <para style="io1">Yihudaxxe bakka'n tukkeesemeeka <char style="ior"><ref loc="ACT 1:15-26">1:15-26</ref> </char></para>
  <para style="io1">Dhugaa kula Iyyerusaalem giddo <char style="ior"><ref loc="ACT 2:1-8:3">2:1—8:3</ref> </char></para>
  <para style="io1">Dhugaa kula Yihuda giddonna Samaara giddo <char style="ior"><ref loc="ACT 8:4-12:25">8:4—12:25</ref> </char></para>
  <para style="io1">Phawuloosixxa Ergallummatixxa ergatensha <char style="ior"><ref loc="ACT 13:1-28:31">13:1—28:31</ref> </char></para>
  <para style="io2">Siretixxa ergallummatixxa me'a <char style="ior"><ref loc="ACT 13:1-14:28">13:1—14:28</ref> </char></para>
  <para style="io2">Iyyerusaalemixxa tuuta <char style="ior"><ref loc="ACT 15:1-35">15:1-35</ref> </char></para>
  <para style="io2">Lqngaxxa ergallummatixxa me'a <char style="ior"><ref loc="ACT 15:36-18:22">15:36—18:22</ref> </char></para>
  <para style="io2">Sakkaxxa ergallummatixxa me'a <char style="ior"><ref loc="ACT 18:23-21:16">18:23—21:16</ref> </char></para>
  <para style="io2">Phawuloosixxa Iyyerussalemi giddo, Qissarya'ninna Roomi'n usurensha <char style="ior"><ref loc="ACT 21:17-28:31">21:17—28:31</ref> </char></para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />Ulfeessende'eteke Tewofiloosi!<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="LUK 1:1-4">Luq. 1:1-4</ref>. </char></note></para>
  <para style="p" vid="ACT 1:1">Yessuusi hujeteenna barrachchiisatee safeexxa yaane duuchcha ediseeke anke maxaafa'n borreesseennen. <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />Borreessennekinna Yessuusi iimi'a adhdhemmaqico'n fi'leemmaxxe ergameeyye'a Woyyichchi Hafuuri darree'n insa'ne'a uwwemmake ajajan. <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />Isi heddo rakko adhdhe reye ke'eechchi uduma hedhotike kadeexxa heddo orinni insa'ne'n kokeesse; shoole tomme barra duuchcha insa'ne'n leella'n Mageniixxa mootummaxxee insa'nee barachchiise. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />Insa'nenni welti hedhemma wodda hiyyeexxi insa'nee ajajee qici, «Ani kule'naa laqinemmaxxa Annakenaa'ni uwwendeexxa addachchiisa adhdhitinaa qico heqqedhdhe malee Iyyerusaaleminaa'n fuldinoqqe'e.<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="LUK 24:29">Luq. 24:29</ref>. </char></note> <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />Yohaannisi wode'eke'n ha'noo xammaqeen; yaane kinni shiixoxxe barra uduma Woyyichchi Hafuurinni xammaqendinaan» hiyye.<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="MAT 3:11">Mat. 3:11</ref>; <ref loc="MRK 1:8">Mar. 1:8</ref>; <ref loc="LUK 3:16">Luq. 3:16</ref>; <ref loc="JHN 1:3">Yoh. 1:3</ref>. </char></note><verse eid="ACT 1:5" /></para>
  <para style="s1">Yessuusi Iimi'a Me'e</para>
  <para style="r">(<ref loc="MRK 16:19-20">Mar. 16:19-20</ref>; <ref loc="LUK 24:50-53">Luq. 24:50-53</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />Hordofeeyye Yessuusinni welti bukki hitee wodda, «Goottaa mootumma Isira'eeli'a illee iima hiissitattoxxi yanna ta'atee?» hite isoo qorte. <verse eid="ACT 1:6" /><verse number="7" style="v" sid="ACT 1:7" />Yessuusinna insa'ne'ni hiyyeexxi hiissee qici, «Anni baallooma ifikenni mureexxa yannanna baro egendino'a ha'no'a uwwendeba'an. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />Yaane kinni Woyyichchi Hafuuri ha'no'n dirraa wodda hunna adhdhitinaan; eettne yanna Iyyerusaalemi'n Yihudake boga duuchcha'n Semaariya'ninna buttatixxe gabala duuchcha'n dhugaa kula anxe kaddinaan»<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="MAT 28:19">Mat. 28:19</ref>; <ref loc="MRK 16:15">Mar. 16:15</ref>; <ref loc="LUK 24:47-48">Luq. 24:47-48</ref>. </char></note> hiyye.<verse eid="ACT 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9" />Tenne hiyyeechchi uduma insa'ne uunda'naanni iimi'a adhdheme; duumanchikinna ille insa'nexxenaa'ni isoo sho'e.<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="MRK 16:19">Mar. 16:19</ref>; <ref loc="LUK 24:50-51">Luq. 24:50-51</ref>. </char></note><verse eid="ACT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10" />Isi iimi'a adhdhemee wodda insa'nee iimi'a dhaphphi hine unda'neegge'ni golalamma seemma oddo'weeke lami manni insa'ne bira uurreexxi, <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />Insa'nee, «Ha'no Geliilake mannaa iimi'a uudina'n mayeete uurritine'neek? Kunni uudina'naa iimi'a adhdheemeek Yessuusi iimi'a adhdhemena'a uudinemma qicinninni iittan illee iima higee dagaan.»<verse eid="ACT 1:11" /></para>
  <para style="s1">Yihudaxxe Bakka'n Maatiyaasi Filemeexxa</para>
  <para style="r">(<ref loc="PSA 109:8">Far. 109:8</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />Ookkoneechchi uduma ergameeyye Debire zeyitixxe koobanaa'n Iyyerusaalemi'a illee iima higge. Tinni koobanna Iyyerusaaleminaa'n edike sanbatike<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">Edike sanbatik or mitte kiilo meetire calla bayyataan</char></note> ori qico bayyataaxxemman. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />Iyyerusaaleminna dangeexxi he'naammaxxe fooqe iimi'a da'mine. Insa'nenna Pheexiroosi, Yohaannisi, Ya'iqoobi, Indiryaasi, Filiphphoosi, Toomaasi, Bertelomewoosi, Maatoosi, Ilfiyoosik belt Ya'iqoobi hinaafalli Simi'ooninna Ya'iqoobike belto Yihudatemman.<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="MAT 10:2-4">Mat. 10:2-4</ref>; <ref loc="MRK 3:16-19">Mar. 3:16-19</ref>; <ref loc="LUK 6:14-16">Luq. 6:14-16</ref>. </char></note> <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />Kunni duuchchingi duuchchi wodda soodachchotee'e bukki hiyyaamman; insa'nenni welt mitte mitte melaalle, Yessuusixxi ama Maaraminna Yessuusik dayyuwwi hedhemman. <verse eid="ACT 1:14" /><verse number="15" style="v" sid="ACT 1:15" />Eettene yanna Pheexiroosi dhibbanna lamme tomme qicixxe ammanexxe oddo'ni uurrexxi hiyyee qici: <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />«Anke dayyuwwa Yessuusi'i abideemmake mannik akeekallo kadeemmake Yihudaxxee Woyyichchi Hafuuri Daawwitike afo'o'n haaso'eemmak woyyichchi maxaafik hiyyichchi muuxema hasissamman, <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />Yihuda no'onaa'n mittinsha lakko'emeexxi tenne ergatensha no'onni ergatema'neemman.» <verse eid="ACT 1:17" /><verse number="18" style="v" sid="ACT 1:18" />Yaane kinni kunni manjichchi ifixxe fuggoxxe hujenni alfeeke maalaqinni boga hidhdhe: albikinna gonbiseemeexxi godoba dareme; qochchummi isikinna lo'o hiyye.<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="MAT 27:3-8">Mat. 27:3-8</ref>. </char></note> <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />Tinni yaanenna Iyyerusaalemi giddo hedhemmake manna duuchcha'ni ege'nende. Tennexxee iikki bogi insa'neke laagadinni Akeldaama hiyyeme; tika isexxinna Mundeti bogan hiyyaten.<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />Pheexxiroosinna lebeexxi hiyyee qici, «Tinninna kaddeechchi faarotike maxaafa'n,</para>
  <para style="q1" vid="ACT 1:20">« ‹Isixxi bakka onake kaddowwaali;</para>
  <para style="q2" vid="ACT 1:20">ayyinna ookko hedhoqqe'e,› higgenni,</para>
  <para style="q1" vid="ACT 1:20">‹Ittanni baallooma isika weli manji adhdhowwaal!›</para>
  <para style="q2" vid="ACT 1:20">hiyyendexxi borreessendemmaxxeten.<note caller="-" style="x"><char style="xo" closed="false">1:20</char><char style="xt" closed="false"><ref loc="PSA 69:25">Far. 69:25</ref>; <ref loc="PSA 109:8">109:8</ref>. </char></note><verse eid="ACT 1:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ACT 1:21" />Tennexxee Gootti Yessuusi no'oxxe oddo'ni mammaremmammaxxa yanna duuchcha no'onni welti hedhemmake manninaa'ni, <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />iitanni Yohaannisike ximmaqattixxe yannanaa'ni safee Gootti Yessuusi iimi'a adhdhemeexxe barra qico'n no'onni welti hedhemmake konne manni giddii'ni mitti no'onni welti isixxe ke'axxe dhugaa kula kada hasissaan.»<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 3">Mat. 3</ref>; <ref loc="MAT 16">16</ref>; <ref loc="MRK 1:9">Mar. 1:9</ref>; <ref loc="MRK 16:19">16:19</ref>; <ref loc="LUK 3:21">Luq. 3:21</ref>; <ref loc="LUK 24:51">24:51</ref>. </char></note><verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />Tennexxee insa'ne lame manna shiqinshe; kunniirinna Bersiyaan, yookaan Iyyosixoosi hiyyemmaaka Yooseefinna Maatiyaasitemman. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />Ookkonneechchinni uduma insa'ne hina'n soodantee qici, «Manji duuchchixxa qalbe egendetteke Goottaa! Konne lame manninaa'ni ati ayyee fildettexxa no'o'ni egee'nish! <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />Yihuda ifike boonchiba'a me'atee waaleexxe ergatensha'ninna ergameeyyumma'n isoo baaloons.» <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />Ookkonneechchi uduma hixa ibinsee wodda hixi Maatiyaasi'n ibe; tennexxe isi eettene tommenna mitte ergameeyyenni welti laakko'eme.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s1">Woyyichchi Hafuuri Hordofeyyete'ni Dirreexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />Ayihudiink sa'atik ayyaani sa'ee'naa onde tomme barra'ni ulfeessema'neeke Phenxeqoositeke ayyaana'ni hordofeyye duuchcha mittenba mitte booncho'ni bukki hiteemman.<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">Lew. 23:15-21</ref>; <ref loc="LEV 16:9-11">Lew. 16:9-11</ref>. </char></note> <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />Dedhange'n jabaaxxe diidaloke luuljo fakkaataaki luulji iimi'n dageexxi ofolemmake mine duuchcha'n wo'me.<verse eid="ACT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 2:3" />Ookkonneechchinni uduma giiratike bubenjo fakkaataak arrabuwwi insa'ne'n leelle; qoqqodemeexxinna insa'nee mitte mittingi hana ofo'le. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />Insa'ne duuchchiingi Woyyichchi Hafuurinni wo'mi'ne; Woyyichchi Hafuuri haasonaashsha insa'ne'a uwwemma qicinni wele laagaduwwinni haaso'ate'n ke'ne.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />Ookkonee wodda iimati butta hedha'neemmake gosa gosake arda duuchchanaa'ni dage'eemmak, Mageno soodata'emmak Ayihudiink ardi Iyyerusaalemi hedha'nemman. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />Konne canca laqeeki ardi duuchchi bukki hiyye; iikki manni insa'nee mitti mittingike laagadinni haaso'aa'naa lanqee wodda mekki hine. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />Insa'nenna saanda'ninna mambe'a hinaa'ni hinee qici, «Isi kunni iitta haaso'a'neek duuchchi Geliilange mannabaata? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />Iitta kaddeexxenni no'o duuchchingi ifi ifike laagadinni insa'ne haasonaa'naa lanqaanneki hittateta? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />No'o Phaartek, Meedikinna, Elaamik manni, Mesiphexoomiyaa, Yihudaa, Qeephphedooqiyaa, Phanxoosii, Issiyaa, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />Firgiyaa, Phinfilyaa, Gibtsee, Qereenaa bira hedheeke Liibiyake boguwwa'n he'naannekeeran; Ittanni no'o Roomii'n dangennek Ayihudiink manninna Ayihudummatibaa jijjiremeennekinna he'nennen; <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />Ayihudikinna Ayidummatibaa e'yineennek no'o Qerixxeesikenna Arebiinke manna kandanno wodda kunni manni Mageniixa lumooxxa huje no'oke laagadinni haaso'aa'naa lanqaannen!» <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />Tennexxee duuchchingi maso hiyyati mekkineexxi weli'anni weli, «Tinni yaane maachcho?» hine. <verse eid="ACT 2:12" /><verse number="13" style="v" sid="ACT 2:13" />Yaane kinni insa'nenaa'n mitti mitti, «Insa'ne woyinetixxa booka ha'wine machchone'een!» hina'n insa'ne'ni gacifante.<verse eid="ACT 2:13" /></para>
  <para style="s1">Pheexxiroosika Haaso'a</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />Ookkone wodda Pheexiroosi tommenna mittik welti urreexxi qonqo gikki asse'e ardake'n hiyyeexxi haaso'ee qici: «Ha'no Yihudake bogik manninna Iyyerusaalemi hexxinaaki duuchchi tennee kaddeexxa yaane egendino'a haaso'a anka laqqe. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />Ta'a reefi gorsiixxe sase saate kademmaxxee ha'no heddina'neeshsha kunni manni machcho'eekeba'a! <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />Yaane kinni tinni kaddeechchi wabeekichchi Iyyu'eeli konneechchi butta haaso'eek hiyyichchi muuxemmaashshaten:<verse eid="ACT 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17" />« ‹Mageni udumixxe barra'ni kaddaan hiyya'nee qici,</para>
  <para style="q2" vid="ACT 2:17">Hafuura anka manjo duuchcha'ni dunannon.</para>
  <para style="q1" vid="ACT 2:17">Ha'noxxi labbaxxinna meyyaxxi oose raaga haasotaan.</para>
  <para style="q2" vid="ACT 2:17">Ha'noxxi dargaggeeyye edi'a kaddaaxxa waleella uuddaan,</para>
  <para style="q2" vid="ACT 2:17">ha'nook geedhe oojjo oojjotaan.<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="JOL 2:28-32">Iyu. 2:28-32</ref>. </char></note><verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />Iittaanni eettenne barruwwa'ni labba meyyake anke erganjuwwi hana</para>
  <para style="q2" vid="ACT 2:18">Hafuura Anka dunannon;</para>
  <para style="q2" vid="ACT 2:18">insa'nenna raaga haasonnaan.<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />Ale iimate'n maso yaanuwwa</para>
  <para style="q2" vid="ACT 2:19">kaba buttate'ninna beessissuwwa</para>
  <para style="q2" vid="ACT 2:19">iittani munde, giiratanna wiliiletika qayyoota leellishannon.<verse eid="ACT 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20" />Lumoxxi ulfeessendeexxi Goottiinxi barra dagebaa edidarre</para>
  <para style="q2" vid="ACT 2:20">arishsho dukkandaan:</para>
  <para style="q2" vid="ACT 2:20">agenjikinna mundetishsha diimmataan.<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />Goottiinka summa ye'aaki duuchchi kinni</para>
  <para style="q2" vid="ACT 2:21">anjiremaan.› »<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />«Koo Isira'eelike mannaa! Konne haaso'a laqqe: Mageni isi darree'n oddo ha'noxxe'n mambe'uwwa masooranna beessisuwwa assiyyoti Naazireetik Yessuusi ha'no'n ege'nisheexxa ha'no umo ha'nongenninni egendine'een. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />Isoo Mageni olima muremmake ifike yaadinninna edixxe ifixxe ege'naashsha ha'noxxe anga'ni sa'isse. Ha'nonna isoo cubbaleeyyetixxe anga'ni fannisemaashshanna reyaashsha assitine.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MAT 27:35">Mat. 27:35</ref>; <ref loc="MRK 15:24">Mar. 15:24</ref>; <ref loc="LUK 23:33">Luq. 23:33</ref>; <ref loc="JHN 19:18">Yoh. 19:18</ref>. </char></note> <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />Yaane kinni Mageni reyotixxe ciiniinto fuggusseexxi reyotenaa'n isoo ke'isseen; reyo abiddeexxi isoo gatisa dandeeteba'a.<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="MAT 28:5-6">Mat. 28:5-6</ref>; <ref loc="MRK 16:6">Mar. 16:6</ref>; <ref loc="LUK 24:5">Luq. 24:5</ref>. </char></note> <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />Daawwitinna isixxee hiyyee qici:</para>
  <para style="q1" vid="ACT 2:25">« ‹Gootta duuchchi wodda Ani edo uudaannen:</para>
  <para style="q2" vid="ACT 2:25">isi midda anke'ni hedhemmaxxee</para>
  <para style="q2" vid="ACT 2:25">haranga lele'mabennon.<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />Tennexxe qalbe anxi gammada'neen; haaso'a anke'n gammashsho wo'miteen</para>
  <para style="q2" vid="ACT 2:26">ittanni manjunte anxinna addeti hexxaan.<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />Lubbo anxanna moogi giddo waaldabexxo;</para>
  <para style="q2" vid="ACT 2:27">Woyyichchi atikinna moogi giddo alo'e gataashsha assitabexxo.<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />Hedhotika ora ege'nannoshsha assitette;</para>
  <para style="q2" vid="ACT 2:28">ati edo ane'n gammashsho wonshitatton.›<note caller="-" style="x"><char style="xo" closed="false">2:28 </char><char style="xt" closed="false"><ref loc="PSA 16:8-11">Far. 16:8-11</ref>. </char></note><verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />«Anke dayyuwwa! Edike annuwwi giddii'n mitti Daawwiti reyexxanna moogemeexxa moogi isikinna telchi qico'ni no'o bira hedheexxa ca'a asseennexxi ha'no'n kuloo! <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />Yaane kinni Daawwiti tennee haaso'echchi wabeekake kademmaxxenna Mageni «Horte atixxenaa'ni mitte moote atixxe'ni ofo'lishshannon» hiyyeexxi isi'a kakate uwweeka addachchiisatika haaso'a ege'nemmaxxeten.<note caller="-" style="x"><char style="xo" closed="false">2:30 </char><char style="xt" closed="false"><ref loc="PSA 132:11">Far. 132:11</ref>; <ref loc="2SA 7:12-13">2 Sam. 7:12-13</ref>. </char></note> <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />Tennenaa'n kexxeexxa Kiristoosi moogi giddo gatabaaxxanna maali isiki alo'abaaxxa ediseexxi uudemmaxxee reyotenaa'ni ke'a Kiristoosixxee haaso'een. <verse eid="ACT 2:31" /><verse number="32" style="v" sid="ACT 2:32" />Yessuusii konne'e Mageni moogokenaa'ni ke'isseen; no'o duuchchinigi tenne yaane'a dhugaa kulaten. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />Tennexxe isi Mageniinke midda'ni ulfaate ofo'leechchi uduma Woyyichchi Hafuurixxa addachchiisa Annakenaa'n adhdheexxi tennee uudina'neexxanna laqqina'neexxa no'o'a duneexxi uwwe'een. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />Daawwiti iimi'a me'ebaan;</para>
  <para style="q1" vid="ACT 2:34">Isi umo ifingenninni hiyyeexxi haaso'ee qici,</para>
  <para style="q2" vid="ACT 2:34">« ‹Gootti, Gootta anka<verse eid="ACT 2:34" /></para>
  <para style="q2">
    <verse number="35" style="v" sid="ACT 2:35" />Naapha atika atixxe lekkake uggidhisanjo assanno qico'ni</para>
  <para style="q2" vid="ACT 2:35">Midda anke'ni ofo'li! Hiyye.› »<note caller="-" style="x"><char style="xo" closed="false">2:35 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Far. 110:1</ref>. </char></note><verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />«Yoona, ha'noo konne fannote'ni fannissinemmaka Yessuusi'i, Mageni, Goottakenna Kiristoosite asseexxa Isira'eelik ardi duuchchi dhugaati ege'nowwaal!»<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />Mannkinna tenne laqee wodda, qalbe insa'neexxi lumooshsha tuqende'naa Pheexiroosi'ninna wele ergameeyye'n, «No'oke dayyuwwa! Yoona no'o'ta maasinnano?» hiyye.<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />Pheexiroosinna hiyyee qici, «Aadde aage, cubbo ha'noxxinna gattowwaali hiyyendaashsha mitti mitti ha'nongi Yessuusi Kiristoosike summinni Xamaqemme! Mageniixe uwwa kadeeka Woyyichcha Hafuuranna adhdhitinaani. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />Mageni uwweexxi addachchiisa ha'no'a, ha'noxxe oose'anna bayya hedhemmaake manni duuchchi'aten; iittani Gootti Mageni no'ok ifiba'a ye'aake manni duuchchi'aten.»<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />Pheexxiroosi lebeexxi «Wele heddo hiyyichchinni xexe'achchiisa'ni tenne fuggaalete ilanaa'n anjiremme» hiyyeexxi insa'nee gorse. <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />Insa'nenaa'ni heddi manni hiyyichcho isika adhdheexxi xamaqeme; eettenne barra'n sase kuma geyyaaki manni amane insa'ne'ni lebeme.<verse eid="ACT 2:41" /></para>
  <para style="s1">Amane Mannixxa Mittoominxa Hedho</para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42" />Insa'nenna ergameeyyetixxe barachchiisa baranta'ni, dayyummati mitteba he'naa'ni, itatanna mitteba indaa'nee, soodachchote'n jabaanta'neemman. <verse eid="ACT 2:42" /><verse number="43" style="v" sid="ACT 2:43" />Ergameeyyetixxe anga'ni heddo massuwwanna beessisuwwi hujemeemmaxxee duuchchinge manna'ni soda'a galde. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />Amaneeki duuchchi mittummaati mitteba hedha'nemmaan; anfeexxi yaane duuchcha mittummatixxemman.<note caller="-" style="x"><char style="xo" closed="false">2:44 </char><char style="xt" closed="false"><ref loc="ACT 4:32-35">Erga. Huj. 4:32-35</ref>. </char></note> <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />Boguwwakanna karruwa insa'neexxa gurgurra'ni maalaqa ookkonee mitte mittengee hasee qicika qoonda'neemman. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />Barra barrande'ni woyyichchi galmi giddo mitteba bukki hinnaa'n mine mine insa'neeke'ni gammashshotinna gugurto afebaaxxe qalbenni itta inda'nemman. <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />Magenokanna saanda'nemman manni duuchchinna insa'nee ulfeesa'nemmani; Goottikinna barra barrande'ni anjirememmak manna insa'ne'ni leba'nemani.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s1">Naafa Manjiichchixxa Fayya</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />Barra mitte Pheexiroosinna Yohaannisi barrixxe salaane saate'n soodachchotixxa yanna Woyyichchi Galmiba'a me'ina'nemmani. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />«Dancha Hula» hiyyendaaxxe Woyyichchi Galmiixxe baxxe'ni mitti ilemeexxenni naafake kadeemmaki manjichchi hedhemman. Manni barra barrande'ni isoo iyyedagaa'ni ugga'naa isi ookko ofo'leexxi Woyyichchi Galmibaa e'yaake manninaa'ni maallaqa kadhata'nemmani. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />Kunni manjichchi, Pheexiroosinna Yohaannisi Woyyichchi Galmi giddi'aa e'yinaa'naa uudeexxi maallaqa insa'nee kadhate. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />Pheexiroosinna Yohaannisishshanni isoo dhaphphi hiyye uudeexxi, «Koo no'obaa uudi!» hiyye. <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />Isinna uuna'neechcho hedheenni hiyya'ni insa'nee dhaphphi hiyyexxi uude. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />Yaane kinni Pheexiroosi «Ani birreti sibiljonna worqe afebe'non; afeneechcho kinni ati'a uwwaannen; Naazireetike Yessuusi Kiristoosike summinni kexxettexxi maremi!» hiyye. <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />Ookkonneechchi uduma isinna isixxa middixxa anga abideexxi isoo ke'isse; hirbangge'n lekka isixxinna mikiti isiki jabaate.<verse eid="ACT 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 3:8" />Isinna qophphi hiyye ke'eexxi lekka iifixxenni uureexxi maremate'ni ke'e. Ookkonneechchi uduma isi insa'nenni welti Woyyichchi Galmi giddi'aa e'yeexxi marema'ninna utaala'ni Mageno galatefata'nemman. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />Ardi duuchchi isi marema'naanna Mageno galatefata'naa afe. <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />Mannikinna Woyyichchi Galmixxe hula bira, «Dancha Hula» hiyyemmaammaba ofo'leexxi maalaqa kadhataammaki isote kadeexxa ege'neexxi iso'ni kaddeexxe yaane'ni massote, mambe'a hiyye.<verse eid="ACT 3:10" /></para>
  <para style="s1">Woyyichcha Galimi Giddo Pheexxiroosika Haaso'a</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />Fayyemmaki manjichchi Pheexiroosinaa'ninna Yohaannisinaa'n gargar higabe'noni hiyye'naa manni mambe'a hiyyeexxi, «Mammarenshatixxe Solomoonixxe soro» hiyyemaaba'a insa'nebaa gonge mare. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />Pheexiroosi konnee manna uude insa'nee hiyyee qici, «Ha'no Isira'eelike mannaa! Tenne yaane'n mayee mambe'a hitina? Mayee no'oo hubatine uudina? No'o, no'oxxe hunnaanni yookaan no'oxxe eloxxe hujeni kunni manjichchi mammaremaashsha assinennelcho ha'no'n fakkaata'nee? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />Abirihaamik, Yisaaqik, Ya'iqoobik Mageni no'oke annuwwiki Mageni, belto ifika Yessuusi'i ulfeese'een. Ha'no kinni isoo Philaaxoosi edo sa'issitineexxi uutineen. Philaaxoosi isoo wocci asso'a hassee wodda midde Hansabe'no hitineen.<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EXO 3:15">Fula. 3:15</ref>. </char></note> <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />Ha'noo ookkone Woyyichchanna qullichcha Hansabe'no hitineexxi manjo shiyeemmaka manjichcho ha'no'a tikaashsha Philaaxxoosii'i kadhatineen.<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 27:15-23">Mat. 27:15-23</ref>; <ref loc="MRK 15:6-14">Mar. 15:6-14</ref>; <ref loc="LUK 23:13-23">Luq. 23:13-23</ref>; <ref loc="JHN 19:12-15">Yoh. 19:12-15</ref>. </char></note> <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />Ha'noo ookkonee hedho uwwaka shiltineen. Mageni kinni isoo reyotenaa'ni ke'isseen; tennexxee dhugaa kula no'ote. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />Kunni uudina'neekinna egendineek manjichchi fayyeexxi jabeenna alfeechchi Yessuusike summa'ni amanatiten. Ha'no duuchchingi uudina'neeshshanni fayye ca'aayaashsha asseek Yessuusike summanna isi darree'n afendaaxxe amanan.»<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />«Ta'anna anke dayyuwwaa! Ha'nonna ha'noke sooresuwwishanni haakiti Yessuusi hana tennee hujineexxa ege'neennen. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />Mageni kinni isike kadeek Kiristoosi rakko adhdhaaxxa ediseexxi wabeek duuchchike afo'o'n haaso'eemmaxxa muuxedheen. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />Cubbo ha'nooxxi ansheendeexxi baxxo'aa aadde aagineexxi Magenbaa illee iima higge. <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />Yoona Goottik hafuura adhdhitinaaxxi bara ha'no'aa daggaashsha Mageni edise ha'no'a fileemeeka Yessuusi Kiristoosii'i ergaan. <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />Isi iimate'ni turaak Mageni ediseexxi ifixxe Woyyitte wabeekoke afo'o'ni haaso'emashshanni butta duuchcha haaronsaa qici'aaten. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />Muusenna hiyyeemma qici, ‹Gootti Mageni ha'noki anee ke'iseemmasha iittanni ha'nooke dayyuwwi giddii'ni wabeekichcha ha'no'aa ke'issaan. Isi hiyyaaxxa yaane duuchcha laqqe.<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="LEV 18:15">Lew. 18:15</ref>, <ref loc="LEV 18:18">18</ref>. </char></note> <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />Fedheek manji kunni wabeekichchi hiyyaaxxa laqabaaki Mageniinke ardi giddii'ni gargari higgeexxi kuttemowwaal.›<note caller="-" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="LEV 18:19">Lew. 18:19</ref>. </char></note><verse eid="ACT 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24" />«Saamu'eelinaa'n saffee kexxeemmaxxi wabeeko duuchchi konne barixxee haasote'een. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />Ha'noonna wabeekotixxe ooseen; iittanni Mageni Abirihaamii'i, ‹Horte atixxenni buttatik arduwwi duuchchi eebbisemaan› hiyyeexxi aageemmaxxa kako dhaaldinaakeeran.<note caller="-" style="x"><char style="xo" closed="false">3:25 </char><char style="xt" closed="false"><ref loc="GEN 22:18">Dada. 22:18</ref>. </char></note> <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />Tennexxe Mageni belto ifika ke'isseexxa yanna mitte mitte ha'nonga fuggo ha'noxxenaa'n illeema hiisseexxi ha'no eebbiso'a ediseexxi isoo ha'noba'a ergeen.»<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s1">Pheexxiroosinna Yohaannisi Ayihudinxe Songo Edo Shinqe</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />Pheexxiroosinna Yohaannisi mannake'n haasona'nenge'ni qeese<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">Mitte mitte mirqisanjo maxaafuwwi «qeesetike sooressa» hiyyaan</char></note>, Woyyichchi Galmke heqqanjuwwik ajajalli, iittanni Seduuqito insa'nebaa dage. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />Tinni lame ergameeyye arda barachchiiseemmaxxeenna Yessuusinni afendeexxe reyeeke mannixxe ke'axxee lallabbeexxee lumoshsha mufaante. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />Tennexxee insa'nee abindeexxi bogi hashshemmaxxee soodaa qico'n insa'nee ookkoo usuriinke mine'ni turraashsha assine. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />Yaane kinni kula insa'nexxa laqeeke mannanaa'n heddi manni amane. Amaneke mannik laakkoossinna onde kumiba'a geye.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />Langaxxa barra Ayihudiinki sooresuwwi geedhetinna Muusseke seerik barachchiisalluwwi Iyyerusaalemi bukki hine. <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />Ookkoo bukki hiyyeeke manni giddii'n qeesetik sooreessi Haanna, Qeyyaafa, Yohaannisi, Isikindiroosinna weli qeesetike sooreesik mini hadi duuchchi hedhemman. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />Insa'nenna eettenee lamiinxa ergameeyye insa'ne edo uurrinseexxi «Ha'noo tennee assitineek mayiinxxe hunnanninna ayyike summinite?» hine qorre. <verse eid="ACT 4:7" /><verse number="8" style="v" sid="ACT 4:8" />Pheexiroosi Woyyichchi Hafuurinni wo'meexxi insa'ne'aa hiyyee qici, «Ha'no ardiinke sooresuwwanna geedhee! <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />Techcho no'o qoremmaannelchi konne naafi manjichchixxee hujeendeexxe eloxxe hujexxeenna isi hitta hedheeke toorinni fayye hiyyatiten. <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />Kunni manjichchi fayyeexxi ha'no edo uurre'eek ha'no fannissine'naa Mageni reyotenaa'ni ke'isseeke Naazireetike Yessuusi Kiristoosike summinnite kaddeexxa ege'ne! Isira'eelik ardi duuchchinna tennee ege'nowwaal! <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />Ha'noo miniink ijaaralluwwi</para>
  <para style="q1" vid="ACT 4:11">« ‹Tuffatineexxi hundineeki kinji</para>
  <para style="q2" vid="ACT 4:11">isoten;</para>
  <para style="q2" vid="ACT 4:11">yaane kinni isi dhaaddotike kinjo kade.›<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="PSA 118:22">Far. 118:22</ref>. </char></note><verse eid="ACT 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12" />Manni anjiremo'a Mageni mannakee uwweeki weli summi imati buttti'a hedhebaan. Tennexxee anjirema iso'nite malee weleke'ni hexxebaan» hiyye.<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />Songotiki manni Pheexiroosinna Yohaannisi soda'a belo haasonneexxa uudeexxa yanna baratebaake manna kandeexxa ege'neexxi mambe'a hiyye. Insa'nenna Yessuusinni welti he'nemmaxxanna qalli hinne. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />Yaane kinni fayyemmaki manjichchi Pheexxiroosinninna Yohaansinni welti uurre'naa uundeemmaxxee mittelchonna hiyya dandeenneba'a. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />Tennexxee insa'nee songo giddii'ni fulchineexxi weli'anni weli hinaa'n mari'antee qici, <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />«Konne manna maa assinaanno? Insa'nexxe anga'n kunni lumoki mambe'i kadeexxa Iyyerusaalemi hedheeki manni duuchchi ege'ne'een; waakata dandennabe'non. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />Tinni yaane kinni ardiinxe oddo'ni ba'lata'ni me'itabaashsha langaxxa Yessuusike summinni haraanga ayye'ninna haasonnabaashsha jabeessinennexxi insa'nee ajanjo!» <verse eid="ACT 4:17" /><verse number="18" style="v" sid="ACT 4:18" />Ookkonneechchi uduma insa'nee ye'neexxi Yessuusike summinni haraanga haasonnabaashsha yookaan barachchiinsabaashsha jabeessineexxi insa'nee ajaanje. <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />Pheexiroosinna Yohaannisi kinni hiissineexxi hiinee qici, «Amme ha'no'ni murre! Magenokee ajajemati irra ha'no'a ajajema Mageni edo seerakee? <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />No'ote kandonnole uundennexxanna lanqennexxa haaso'atenaa'n sammi hiyya dandennabe'no.» <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />Ardiinki sooresuwwinna songotik manni Pheexxiroosiinna Yohaannisii'i mura woxxissaaxxa mitte yaanenna afa gopheemmaxxee iittanni tennee kaddeexxe yaane'a ardi Mageno galateefataammaxxee higgeenna jabeessine xexe'achchiinseexxi insa'nee wocci assine. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />Konne mambe'inni fayyeemmaak manjichchi shoole tomme woga sa'aakemman.<verse eid="ACT 4:22" /></para>
  <para style="s1">Amaane Soodatteexxa Soodachcho</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />Pheexxiroosinna Yohaannisi wocci assemmee wodda ifixxe gamuwwaba'a dangeexxi qeesetik sooresuwwinna geedhuwwa insa'ne'ni hiteexxa yaane duuchcha kulle. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />Insa'ne tenne lanqee wodda hafuura gikki assineexxi mitte qalbenni Magenba'a hine soodantee qici, «Iimatanna butta abbaayyattanna ise giddo hedheechcho duuchcha daddeetteke no'oke Lumoke Goottaa! <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />Woyyichchi Hafuuri ga'mii'ni erganjo atike anna no'oke Daawwitti'n ati hite haasotetta qici,</para>
  <para style="q1" vid="ACT 4:25">« ‹Gosa gosak ardi mayee mufate?</para>
  <para style="q2" vid="ACT 4:25">ardi mayee tolanga diinake'n ke'e?<verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />Kaba buttatiki moyanjuwwi mitteba higeexxi</para>
  <para style="q2" vid="ACT 4:26">galchalluwwikinna mitteba bukki hiyyeexxi</para>
  <para style="q2" vid="ACT 4:26">Goottake'ninna isi hariireemmake'n›</para>
  <para style="q2" vid="ACT 4:26">naaphuummati ke'e.<verse eid="ACT 4:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27" />Dhugaaten, Heeroodisinna Phanxiyoosi Philaaxoosi Ayihudake kadebaake mannininna Isira'eelike ardinni welti konne qachcha'ni bukki hineexxi ati hariitetteke woyyichcha atika erganjo Yessuusi'ni ke'neen. <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />Tinninna kaddeechchi ati atixxe hunnanninna fedhii atixxenni edo murtetexxat muuxendo'aten. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />Ta'anna no'oke Goottaa! Haasona'neexxa daabbachcho uudi! No'o erganjuwwi atiki haaso'a atika soda'a belo afo'o wo'mine haasonnannoshsha assi! <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />Woyyichcha belto atike Yessuusike summinni dhibemeekiir fayyaashsha, mambe'ikinna beessisuwwi assemaashsha anga atixxa diriirisi!»<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />Insa'ne soodante ke'neechchi uduma he'nemmaki boonchi lele'me; duuchchingi Woyyichchi Hafuurinni wo'meexxi Mageniinka hiyyichcho soda'a belo afo'o wo'meexxi haaso'e.<verse eid="ACT 4:31" /></para>
  <para style="s1">Edixxe Ammaanexxa Mittoomiinxa Hedho</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />Ammaanye duuchcha mitte qalbenna mitte heduma affe'eemman. Ayyinna «Kunni ankeni» hiyyaaxxi yaane hexxemmabaan; insa'nexxe oddo'ni duuchchinxi yaane qabetixxemman. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />Ergameeyyetinna Gootti Yessuusixxa reyotenaa'ni ke'a lumoxxe hunnanni dhugaa kulda'nemman; insa'ne duuchchinge'ni lumooki Mageniink badhaadhi hedhemman. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />Boga yookaan mine afeeki duuchchi gurgurra'ni maallaqa iyyedagaammaxxee oddo insa'nexxe'n mitti rakkichchinna hedhemmaba'a. <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />Gurgurremaka maallaqanna eyyedangeexxi ergameeyyetixxe lekka hunda uggurra'nemman; insa'nee mitte mittenge'e ookkonee maallaqa hasissaa qico qoonda'nemma'n.<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />Ilenshati Qophphiroosike bogik Yooseefi hiyyemaaki mitti Leewwichchi hedhemman. Ergameeyyetinna isoo'o Bernabaasi hita'nee yexxaammani; tika isixxinna, «Dayyeessatik belto» hiyyaten. <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />Isinna boga ifika gurgure'e maallaqa iyyedageexxi ergameeyyetixxe lekka hunda uggure.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s1">Hanaaniyyanna Sephphiiraa'a</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />Hanaaniya hiyyemaaki mitti manjichchi Sephphira hiyyendaaxxe ifixxe arenni welti boga gurgure. <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />Are isixxi egendee'naanni bogi gurguremeeke maallaqinaa'ni gamisa gatise'e wele iyyedageexxi ergameeyyetixxe lekka hunda ugge. <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />Ookkonneechchi uduma Pheexiroosinna, «Koo Hanaaniya, Woyyichcha Hafuura'ni dhara haasotattoshshanna bogi gurguremeeke maallaqinaa'n gamisa gatissattoshsha duurrisi atixxxe qalbe'n mayee wo'mee? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />Boga gurgurtebexxo edo iikki bogi atingemmabaa? Gurgurtettelchinni uduma maallaqikinna atingemmabaa? Iittate kaddeexxenni tenne yaane hujiyyotee mayeeta qalbe atixxe'ni heddetee? Dhara haasotettek Magenoke'nite malee manjoke'nitebaan» hiyye. <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />Hanaaniya konne haaso'aa laqee wodda butta ibeexxi reye. Tenne yaane laqeeki manni duuchchi lumo qico sodaate. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />Dargaggeeyye dagge rensha isika mirqite iyyemarte moogge.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />Sase saatenni udumia Hanaaniyyaxxi are ookko'aa dagge. Isenna aro'oo iseke'ni gelteexxa yaane egendemmabaan. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />Pheexiroosinna isee'e, «Amo ane'ni kuli, boga ha'nooka gurgurtineeki konne maallaqa'ni calla?» hiyye. Isenna, «Eetti konne qiconi» hite.<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />Tennexxee Pheexiroosi ise'n hiissexxi, «Goottiinka Hafuura hega uudino'aa atinna atiki aro'i mayee mitte afo'oo kaddinee? Aro'oo atika mooge higa'neeki manni kunni hulande'n hedheeni; ateenna iyyemare moogaan» hiyye. <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />Isenna hirbange'n Pheexxiroosixxe lekka hunda ibbe rerte. Dargaggeeyye mini'aa e'yitaa wodda isee rerte'naa afeexxi iyyemarte iseke aro'i moogi bira iseenna moogge. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />Mageniinxe tuuta duuchcha'ninna tennee yaane laqeeke manna duuchcha'ni lumooxxi soda'aa kadde.<verse eid="ACT 5:11" /></para>
  <para style="s1">Eergameeyyetixxe Anga'ni Heddi Manni Fayye</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />Heddo mambe'uwwinna beessissuwwi ardiinxe oddo'ni ergameeyyetixxe anga'ni hujema'nemman. Amaneeki duuchchi mitte qalbenni mammarenshatixxe Solomoonixxe soro hiyyemaake booncho'ni bukki hiyyemmani. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />Insa'ne gadhi darre hedheeke mannanaa'ni mittikinna insa'nenni welti karseme mitteke kado'a shenne hiyyaammak ayyinna midde hedhemmabaan. Kaddo malee manni insa'nee ulfeesa'nemman. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />Goottake'n amaneeke labbakikinna meyyakiki laakkoosi lumo qico lebema'ni me'aamman. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />Tennexxee dhibemeeka heddo manna orinbaa fulchina'ni algake'ninna rarete'n diiphisa'nemman. Tennenna iitta assineechchi Pheexiroosi ookkone ora sa'aa wodda gaadido isixxi midde insa'ne'ni hana gaadise'naa fayyino'atemman. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />Iyyerusaalemi qarqara hedheeke qachchuwwanaa'ni dhibemeekaranna fuggichchi hafuurinni abara uudammakaara iyyedanga'n manni bukki hiyya'emman; iyyedangemak manni duuchchinna fayya'emman.<verse eid="ACT 5:16" /></para>
  <para style="s1">Eergameeyyetixxa Rakkonna Shorreensha</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />Qeesetik sooresinna isinni welti hedhemmake Seduuqitotixxi gamo duuchchi fuggoxxe gaabbe insa'ne'n wo'mitee'naa <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />ergameeyye abindeexxi usurinke mine'ni e'yinshe. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />Yaane kinni eettene hashsha iimik erganji dage usurriinke minixxa hula bane insa'nee fulcheexxi <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />«Marre, Woyyichchi Galmi giddo uurritineexxi konnee hedhotika hiyyichcho duuchcha ardake'n kulle!» hiyye.<verse eid="ACT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 5:21" />Ergameeyyetinna ajajemmeexxi gorrsaan Woyyichchi Galmi giddi'aa e'yetteexxi barsiisate'ni sanfe. Ookkone wodda qeesetiki sooresinna isinni welti hedhemakiir dangeexxi songotixxa gamonna Isira'eelixxa geedhe duuchcha bukki assine; ergameeyyetanna insa'ne'a iyyedangaashsha manna usurriinke minibaa ergine. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />Yaane kinni ergeme mareeki manni usurriinke mine'ni ergameeyye gonphe illee iima hinge dangeexxi <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />«Usurriinke minixxi hula jaba qicinni danqarendemman; heqqaammakiiruwwinna hulati edo uurre'naa anfeennen. Usurriinke minixxi hula bannanno wodda kinni mini giddo mittekanna anfebe'non» hine kulle. <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />Woyyichcha Galma heqqaammakaara ajajammakinna qeesetiki sooresuwwi tenne lanqee wodda; «Tinni yaane maachcho hiyyote!» hiyyati mambe'aa hineexxi insa'nexxee hinaanxa gonphe. <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />Ookkoneechchi uduma mitti manjichchi dageexxi: «Laqqee! Usurriinke mine'ni e'yishinemmaki manni Woyyichchi Galmi giddo uurreexxi arda barsiisa'neen» hiyyeexxi insa'ne'ni kule.<verse eid="ACT 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 5:26" />Iikki woddi Woyyichcha Galma heqqaammakaara ajajammakinna ergameeyye mare insa'nee aadhe dage; insa'neenna aa'ne dangeek kinni ardi insa'nee kinjiki cancaqabaashsha sodaantemmaxxee insa'nenni hunnantetemmabaan.<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />Ergameeyye iyyedangeexxi songoti edo uurrinsee'na'a qeesetik umi insa'nee hiyye qoree qici, <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />«Ha'no Yessuusike summinni barsiisinabaashsha jabeessinennexxi ha'noo ajanjeennabaa? Ha'n'noqqa ta'a Iyyerusaalemi barsiisa ha'nooxxeni wonshitineen; ha'no ookkone manjichchixxe mundeexxee no'o qoremona'a hasinan'een.»<verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />Pheexiroosinna wele ergameeyye hite hiissite haasotee qici, «No'o manjokee ajajemiyyoti irra Magenokee ajajemiyyote hasissaan. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />No'oke annuwwik Mageni ha'noo haqichchi hana fannissineexxi shiltineeka Yessuusi'i reyotenaa'ni ke'isseen. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />Isinna Isira'eelik ardi aadde agee'naa cubbo insa'neexxa gattowwaal hiyyo'aa Mageni Yessuusii'i duuchchiingike umonna anjirallo asseexxi midda ifike'ni ulfinnik ofo'lishe. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />No'o tenne yaanexxee dhugaa kulan. Mageno ajajemaake duuchchi'aa uwweeki Woyyichchi Hafuurinna dhugaa kulaten» hine. <verse eid="ACT 5:32" /><verse number="33" style="v" sid="ACT 5:33" />Songotixxi gedhee tennee laqqee wodda aarte bubbi hiteexxi ergameeyye shilto'a hasse. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />Yaane kinni manna duuchcha'n ulfeessemee'eki Muuseke seeriike barachchiisallo kadeek Gemaaliyaal hiyyemaak mitti Feerisichchi songote'n urreexxi ergameeyye shiixxoxxe yanna'aa songo giddii'n fuldaashsha assino'aa ajaje. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />Ookkoneechchi uduma songotixxa gamo isi hiyyee qici, «Isira'eelik mannaa, konne manna'ni ha'noo maa assa hassisaaxxa heqqedhdhee! <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />Konneechchi edi darre Tewodaasi hiyyemaak manjichchi, ani lumoke manjon hiyyeexxi ke'eemman; shoole dhibba geyaak manni isinni welti mittomeemman. Kaddo malee isoo shineen; hordofeeyye isixxinna midde xexxeerendeeshshanni gatte. Yaadi isikinna woyi fulebaake kade. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />Ookkonneechchi uduma ardi laakkoo'eme sane Geliilak Yihuda ke'eexxi heddi manni isoo hordofaashsha asseemman; isoonna shinneeni. Isoo hordofammaki duuchchi xexxeremeen. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />Yoona ta'a ani ha'no'ni hiyyaannexxi konne mannanaa'ni bayyatinaashanna insa'nee waaldinaashshaten. Mayee hitinoole; tinni yaane yookaan tinni huje manjinbaa'nite kaddoole kinni ba'a baxxaan. <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />Yaane kinni Mageniibaa'nite kaddoole insa'nee balleesiyyo dandeetinaba'a; akimagaada Mageniink welti ha'noo lolendinaan» <verse eid="ACT 5:39" /><verse number="40" style="v" sid="ACT 5:40" />Insa'nenna Gemaliyaalika gorsa adhdhine ergameeyye ifibaa ye'neexxi jadhanfe. Yessuusike summinninna haranga haasonabaashsha ajanjeexxi wocci assine. <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />Ergameeyye kinni Yessuusike summi'a salphinne adhdhatee gelteemmaxxee gammanda'ni songotenaa'ni fulde me'ite. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />Barra barrande'n Woyyichcha Galmi giddonna mine mine'n Yessuusi isi Kiristoosite kadeexxa barachchiisanna lallaba haranga uurriseemmabaan.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s1">Torbaane Daaqonexxa Fileensha</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />Hordofeeyyetik laakkoossi bira sa'a'ni me'eexxe eettene yanna'n Girkeeka afo'o haaso'ammak Ayihudiik manni, Ayhudiike boga'n ilemeeke Ayihudiike manna'n maamuqate'n ke'e; tinninna kaddeechchi barra barrande'n qoondemmake gargaarsa'n hiyyeettuwwa insa'nexxa miincemmaxxeeten. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />Tennexxee tommenna lamiinxi ergameeyye wele hordofeeyye bukki assiteexxi hitee qici, «No'o ita qoodatee hinennexxi Mageniinka hiyyichcho barsiisatixxa no'oxxa huje waala hasissabaan. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />Tennexxee no'oke dayyuwwaa, eloke adaba insa'nekenni ege'nemeeka Woyyichchi Hafuurinninna beekumik wo'meeka torbaane manna ha'no giddii'ni fille; insanee tenne huje'a baallonsinannon. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />No'o kinni soodachchote'ninna Mageniinka hiyyichcho barsiisate'n siinnannon» hine.<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />Kunni haaso'i duuchchiinga gammachchiise. Tennexxee insa'ne amanatinna Woyyichchi Hafuuri iso'n wo'meeka Isxifaanoosii'i, Filiphphoosii'i, Phirokoorosii'i, Niqaroonaa'a, Ximoonaa'a, Phermenaaninna, iittanni Yihudummatiba'a jijjiremeemmaka Antsookiyichcho Niqolawoosii'i fille. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />Insa'neenna ergameeyyeti edo uurrisee'naa'a, ergameeyye konne manni hana anga uggurte soodatte.<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />Konne qicinni Mageniinki hiyyichchi ba'lataa'ni me'e; Iyyerusaalemi giddonna hordofeeyyetik laakkoossi yo'oshsha bira sa'a'ni me'e; heddo qeesenna amande.<verse eid="ACT 6:7" /></para>
  <para style="s1">Isixxifaanoosixxa Abidensha</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />Isxifaanoosi badhadhikinna hunnati wo'meexxi mambe'inxa yaanuwwanna lumollamma beessisa ardi giddo assamman. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />Ookkone wodda leexa fulatike hiyyemaake Ayihudiinke magenoonfachchotike mini manninaa'n Qereenaa'ninna, Isikindiriyaa'n, Kilqiyaa'ninna Issiyaa'n dageek Ayihudiink mitti mitti manni Isxifaanoosii'i gibati moromate'ni ke'e <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />Yaane kinni Isixxifaanoosi haaso'o'a uwwemeemmaka beekumanna Hafuura injifata dandeennebaan. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />Ookkonneechchi uduma insa'ne, «Kunni manjichchi Muuseenna Mageno yowwa'naa lanqeennen» hiyyaaka manna sho'ik ke'issine. <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />Tennexxe insa'ne arda geedhetanna Muuseke seerika barachchiisalluwwa ke'issine; Isixxifaanosibanna mare isoo abindeexxi songotibaa iyyedange. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />Ookkonneechchinni udumi'a insa'nenna iso'ni dharik dhugaa kulaaka mitte mitte manna aaneexxi dange; dharik dhugaa kulaammak manni hinee qici, «Kunni manji konne Woyyichcha Galmanna Muusseka seera duuchchi wodda yowwaan. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />‹Kunni Naazireetik Yessuusi konnee Woyyichcha Galma diigan; Muuse no'o'a uwwemmaxxa aada jijjiraan› hiyyaa'na'aa lanqeennen» hine. <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />Ookkonne wodda songote'ni ofo'lemmaaki manni duuchchi Isixxifaanoosii'i dhaphphi hiyyeexxi uudaa wodda albi isiki iimike erganjinke albishsha hedhe'naa uude.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s1">Isixxifaanoosika Haaso'a</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />Ookkonneechchi uduma qeesetik sooresi Isixxifaanoosi'i hiyyee qici, «Isi tinni hiyyenda'neexxi yaane dhugaandee?» hiyyyexxi qore.<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />Isixxifaanoosinna hiyye hiisse haaso'ee qici, «Anke annuwwanna anke dayyuwwa ani hiyyaannexxa laqqe; anni no'oki Abirihaami Karaani me'eeba edi darre, Mesiphexoomiyanni hedhee'naa Ulfiniiki Mageni iso'ni leelleexxi, <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />‹Boga atikanna arda atika waaldettexxi ani ate'n leellishshannoke bogibaa me'i!› hiyye.<verse eid="ACT 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 7:4" />«Tennexxe isi Kelaaditotike boganaa'n fuleexxi Karanike boga'ni ofo'le. Anni isik reyechchinni udumi'a Magen isoo Karaanike boganaa'ni fulcheexxi telcho hexxina'neeke bogiba'a iyyedage. <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />Kaddomalee lekka uggaanga qadaada midde isi'a uwwemabaan. Konne boga isi'aanna isixxe sanne'aa uduma qadaadake asseexxi uwwaxxa kinni isi'a kako ageemman. Mageni tenne kako aagaa wodda Abirhaami oose i'leemmaba'a. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />Mageni Abirhaami'i: ‹Horte atixxi wele mannike boga'ni marteexxi hexxaan; ookkone boga'ni shoole dhibba wogga garbaake asse'nee insa'nee miinicaan. <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />Yaane kinni garbumaati insa'nee galchemmak ardi mura woxashsha assannon; insa'nenna ookkone boginaa'n fulleexxi konne booncho'ni anee magenoonfantaan.› <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />Ookkonneechchi uduma Mageni Abirihaami'a beessisake kaddo'a jila ofo'latixxa kako uwween; Abirihaami Yisaaqii'i i'lemmaxxee saddeetixxe barra'ni jila ofo'lsheen. Iittanni Yisaaqi Ya'iqoobi i'le; Ya'iqoobinna tommenna lame gosati minika annuwwa i'le.<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />«Isira'eelixxe gosake minik annuwwi Yooseefii'i fuggoxxe gaabbenni gaabbemmaxxee Gibtseeke boga'ni garbummatee gurgure. Yaane kinni Mageni isinni welti hedheemmaxxee, <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />isoo rakko duuchchanaa'ni fulche. Isi Gibtseeke moyanjii edo elletanna beekkuma uwwemmaxxee moyanji Feri'ooni Gibtseke boga'ninna ifike motommatike mine duuchcha'ni ajajalloke asse.<verse eid="ACT 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11" />«Gibtseeke'ninna Kenaanike boga duuchcha'ni lumooxxa rakko idageeki solo'i kadee wodda, annuwwi no'ok indaachcho alfa dande'eba'a. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />Ya'iqoobi Gibtseeke boga'n midha hexxeexxa laqee wodda sirete'n annuwwa no'ka ookko'aa erge. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />Insa'nenna langaxxa Gibtse'aa me'inee wodda, Yooseefi ifike dayyuwwa'n ayyumma ifixxa kule, Feri'ooninna Yoosefike firixxa yaane ege'ne. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />Ookkonneechchi uduma Yooseefi anna ifika Ya'iqoobinna ifika mini hado duuchcha ifibaa iyyedagise; insa'ne duuchchiing torbaane tommenna onde mannamman. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />Ookkonneechchi uduma Ya'iqoobi Gibtse'aa me'e. Isinna annuwwi no'ok ookko'o renne. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />Rensha insa'neeka Sekemi iyyemareexxi Abirihaami Emoorixxe oosenaa'n ifike maallaqinni hiremmake hirreesa'n moonge.<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />«Mageni Abirihaami'aa kakoti addachchisemmake bari muuxema shiqee wodda Gibtse hedhemmake no'oke mannixxi horte bira saxxa'ni me'ite. <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />Ookkonneechchi uduma Yooseefii'i ege'nebaak weli moyanji Gibtseeke boga'n moye. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />Isinna arda no'oke'ni shokkoti ke'eexxi annuwwi no'oki illeexxa oose gadhi'a fulche hunna'na'a rertaashsha annuwwa no'oka wixixi asse.<verse eid="ACT 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 7:20" />«Eettene yanna'n Muuse ileme, isinna Mageni edo elle affeexxe dancha annomman; sase ageenjo anniinke mine'ni heqqema'ni tureexxi <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />isi gadho hunemee wodda Feri'oonixxi belto isoo affe. Isenna anno tennee adhdhiteexxi belto ifike assexxe nossexxe. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />Muusenna Gibtseke bogika beekkuma duuchcha barateexxi haaso'ikinna hujeti jabaateeke kade.<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />«Muuse shoole tomme wogga wo'mee wodda dayyuwwa ifika, Isira'eelixxa oose mareexxi uudo'aa mudhdhe. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />Isinna mitti Gibtsek manji dayyuwwi giddii'ni mitteke'ne fuggoxxa assa'naa uudeexxi Gibtsichcho shiyeexxi ookkone miidhememmakixxa halo fule. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />Mageni isi gami'ni insa'nee garbummatenaa'ni fulchaaxxa dayyuwwi isik ege'neechcho iso'ni labbeemman. Yaane kinni insa'ne tenne ege'na gonphe. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />Langa baro gorsa lami Isira'eeliki manni weli'aanni weli lolemaa'naa afe'e araarso'a hasseexxi, ‹Koo mannaa! Isi ha'no dayyuwwange kaddineexxi mayee loleendinaa'ne?›<verse eid="ACT 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 7:27" />«Yaane kinni iikki dayyo gannammaak manjichchi Muuse'e gamake'ni dhiibeexxi, ‹Atee no'oo galchitatoshanna no'o'n murtatoshsha asseeki ayyete? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />Bereqe Gibtsichcho shilteteshshanni annenna shiltotta'a hassaate?› <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />Muuse tennee laqe wodda Gibtsee'ni baaje'e Miidiyaamike boga'ni mareexxi alagake kade ofo'le. Isinna ookko'o lame labbaxxa oose i'le.<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />«Ookkone boga'ni shoole tomme wogga ofo'lechchi uduma Siinaxxe kooba bira qiilla gammoojje'n qosorro mitte'ni ha'yaneeke bubenji giddo iimik erganji iso'ni leelle. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />Muuse tenne uudeexxi mambe'a hiyye. Isinna tenne yaane hubateexxi uudo'a maraa wodda Goottiinka haaso'a laqe. Goottikinna: <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />‹Ani atike annuwwike Abirihaamike, Yisaaqikenna Ya'iqoobike Magenon› hiyye. Muuse tenne laqee wodda alayye roqoonseexxi uudatee sodaate.<verse eid="ACT 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 7:33" />«Ookkonneechchi uduma Goottikinna isoo hiyyee qici, ‹Ati kunni uurritetteki boonchi woyyomeeke kadeemmaxxee kophphe lekkatenaa'ni fulchedhi! <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />Ani Gibtseke boga'ni hedheeke anke ardika abara dhugaateni uudeennen. Insa'nee jaba qico rakkantee raarraa'naa laqeenen. Tennexxe Ani insa'nee anjironnaa dirre dageennen. Amo ta'aa! Ani atee Gibtse'a ergaannen.›<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />«Isira'eelik ardi Muusee ‹Ati no'oo galchitatoshshanna murte murtatooshsha asseeki ayyete?› hiyya'ni isoo gibeemman: kaddo malee'e Mageni konne Muuse qosorro giddo iso'n leelleke iimike erganji gammii'ni galchallokenna wodalloke asseexxi insa'neba'a isoo ergeen. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />Isinna akeekeexxi insa'ne Gibtsee'n fulche; Gibtse, diimooxxe abbaayya'ninna qiilla gammoojje'n shoole tomme wogga maso yaanuwwanna mambe'a beessisuwwa asse.<verse eid="ACT 7:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 7:37" />« ‹Mageni anee ke'issemmashsha ha'noo giddii'n ha'no'a wabeekichcha ke'issaani› hiyyeexxi Isira'eelike manna'ni haaso'emmaaki, konne Muusen. <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />Isi Qiilla gammoojjeke boga'n hedheemmake ardinni welti, Siinaxxe kooba'ni haaso'emmaki iimik erganjinni weltinna iittanni annuwwa no'okenni welti hedheemman. Mageniinka hedhotika hiyyichchonna no'aa sa'isseek konne Muusen.<verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />«Yaane kinni annuwwi no'oki isoo gareereexxi isi'a ajajema gibe; qalbe ifixxenninna Gibtse'a illee iima hinge. <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />Insa'nenna Aaroonii'i, ‹Kunni no'oo Gibtsee'n fulcheek Muuse maa kadeexxa egennebe'non. No'o edi edii'n me'aaka magenuwwa kexxe no'aa giissi!› hine. <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />Eettene yanna insa'ne jabbetixxe fakkexxa misile giissineexxi tolcha shiqinshe; ifixxe angaxxe huje'ninna gammande. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />Yaane kinni Mageni insa'nenaa'ni gargarti hige; iimixxa urjuwwa magenoonfanto'aa insa'nee sa'isse uwwe; tinninna wabeekotike maxaafa'n hiyyende borreesendemma qici:</para>
  <para style="q1" vid="ACT 7:42">« ‹Koo ha'noo Isira'eelike manna shoole tomme wogga qiilla gammoojje'ni hexxinemma wodda</para>
  <para style="q2" vid="ACT 7:42">tolchakanna uwwa shiqishinemmak ani'atemmata?<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />Tenne irra ha'noo magenooffatino'aa giissexxineemmaka Molokika duunkaananna</para>
  <para style="q2" vid="ACT 7:43">ha'nooke dharichcha mageno,</para>
  <para style="q2" vid="ACT 7:43">Reefaamixxe urjexxa misile dulkitine me'itineen;</para>
  <para style="q1" vid="ACT 7:43">Tennexxe aninna ha'no booji'endineexxi Baabiloon widdo me'itinashsha assannon.›<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />«Mageni Muuse'n leellishemma qicishshanna ajajemma qicishsha giissemeemmak dhugaa kulatik duunkaani no'oke annuwwinni welt qiilla gammoojje'n hedhemman. <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />Anuwwi no'okinna ookkone duunkaana aa'neechchi uduma Mageni Iyyaasuxxe akeetenni shorrishshemmaka Ayihudake kadebaake mannika boga dhaalle wodda ookkone dunkaana abixxene e'yine; iikki dunkaaninna Daawwitike bari qico'ni ookkone bogi giddo hedhemman. <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />Daawwiti Magenii edo elle alfeexxi Ya'iqoobike Mageni'a mine ijaaro'a soodate. <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />Yaane kinni Magenokee mine ijaareek Solomoonitemman.<verse eid="ACT 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48" />«Kaddo malee Lumok Mageni manjiinxi anga ijaarteeke mine'n hedhabaan. Tinninna wabeekichchi konneechchi butta hiyyee borreesse qicinniten:<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />« ‹Iima moote anxenni;</para>
  <para style="q2" vid="ACT 7:49">buttatinna lekka anxa uggudhannoban;</para>
  <para style="q1" vid="ACT 7:49">Iitta kaddeexxenni ha'noo ani'aa ijaartinaak mini hitta hedheeke?</para>
  <para style="q2" vid="ACT 7:49">Hiyya'neen Dada Duuchchiki Gootti</para>
  <para style="q2" vid="ACT 7:49">yookaan ani hafuura adhdhannobi habatetaa? Hiyyeexxi borreessemma qicishshaten.<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />Tenne yaane duuchcha hujenneeki anga anxennitebaata?› hiyya'neeni Duuchchi Woddik Gootti.<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />«Ha'noo halo callik qalbe duude'eekiir! Mansha ha'nooxxinna laqqabaak! Ha'noonna annuwwa ha'nookishshanni duuchchi wodda Woyyichcha Hafuura gareertinaan. <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />Annuwwa ha'noki giddii'n wabeeko shorrisheebaaki ayyete hedhee? Insa'ne ookkone qullichchixxa daga edisseexxi kuldeemmaxxa wabeeko shinneen; ha'noonna ta'a konne qullichcha sa'issitineexxi uwwati isoo shilltineen. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />Ha'noo Iimike erganji gamii'n uwwemeeka seera adhdhitineemman; yaane kinni seera ookkonee heqqexinebaan.»<verse eid="ACT 7:53" /></para>
  <para style="s1">Isixxifaanoosi Kinjki Cancaqeme Reyeexxa</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />Songotixxe bukki'n hedheemmakiir tenne laqee wodda lumooshsha aarre; suummettanna iso'ni ga'me'ne. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />Yaane kinni Isixxifaanoosi'ni Woyyichchi Hafuuri wo'mee'naa iimi'a dhaphphi hiyye uudaa wodda Mageniinka ulfinna, iittanni Yessuusii'i Mageniinke midda'n uurree'naa afe. <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />Isinna, «Kunnise, iima banedeenaa Manjink Beltinna Mageniinke midda'n uurre'naa afaannen» hiyye.<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />Eettene yanna insa'ne lumoshsha cancina'ni mansha ifixxa buqe'neexxi insa'ne duuchchiing mitteba ke'neexxi isibaa gongine. <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />Qachchakenaa'ninna harkinse gadhi'a fulchineexxi kinjki isoo cancaqqe. Iikki dhugaa kulemmakiirinna seemma ifi ifixxa Sa'ooli hiyyemaake dargaggeessi bira heqqashsha uggine. <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />Isxifaanoosinna kinjik cancaqema'inni hedheexxi, «Gootta Yessuusii! Lubbo anxa adhdhi» hiyya'n soodate. <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />Ookkonneechchi uduma isi gulufateexxi, «Anke Goottaa! Balleessa insa'neexxa laakkotoxxee hiyya'n hafuura gikki asseexxi raare» Isinna tennee hiyyeeshanni reye.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="s1">Sa'ooli Ammanye Shorrisheexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />Sa'oolinna Isixifaanoosixxe shiyema'a weli aagemman. Eettenne barra'ni Iyyerusaalemixxe Mageniinxe tuuta'n lumoki shorrichchi ke'e; ergameeyye malee ammanye duuchcha Yihudakenna Semaariyake bogibaa xexxeerende.<verse eid="ACT 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 8:2" />Mageniinxe yaane'n si'eek manninna Isxifaanoosi mooge; isinna lumo qico oodha'ni hunbaashshe. <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />Yaane kinni Sa'ooli Mageniinxa tuuta balleessatee'e ka'le ke'eemman. Duuchchingike minibaa e'ya'ni amaneeka labbakanna meyyaka harkise fulcha'ni usurrinke mine'ni e'yishsha'nemman.<verse eid="ACT 8:3" /></para>
  <para style="s1">Filphoosi Samaariyaake Boga'ni Wengeele Lallabeexxa</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />Ammanyetinna xexxerendeexxi martee booncho duuchcha'n Mageniinka hiyyichcho barachchiisa'nemman. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />Filiphphoosi Semaariyake qachcha'n mareexxi Kiristoosixxee mannake'ni barachchiise. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />Mannikinna Filiphphoosika haaso'a laqee woddanna isi hujammaka mambe'a uudee wodda mitte heduminni dho'o hiyyee'e isi hiyyaaxxa laqa'nemman. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />Fuggichchi hafuuruwwinna lumooxxe raarenni heddo manninaa'ni fula'nemmani. Iittanni heddi naafuwwinna gogeekiir fayya'nemmani. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />Tennexxe Samaariyaake qachcha'ni lumooxxe gammashsho kadde.<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />Konne Semaariyake qachcha'n mitti Simi'ooni hiyyemaak manjichchi hedhemmani; kunni manjichchi qachchi giddo goja'ni Samaariyaaka manna mambe'a assa'ni, ifinna lumoke manjo assee uuda'emman. <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />Mann duuchchi shixxo lumoki, «Kunni manjichchi lumoxxe hiyyendeexxe Mageniinxe hunnan» hiyya'ni xexxe'achchoti isi hiyyaaxxa laqa'nemmani. <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />Tinninna kaddeemmalchi lumoxxe yannanaa'ni ke'isseexxi gojo ifixxenni insa'ne'a mambe'a yaanuwwa assemmaxxeteni. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />Yaane kinni Filiphphoosi Mageniinxe mootummaxxeenna Yessuusi Kiristoosike summixxee eloxxa odo kulaa'naa laqee wodda labba meyyaki amaane xamaqeme. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />Simi'ooni midde gatebaangi umo ifingeenninni amane xamaqemeexxi Filiphphoosii'i hordofate'n ke'e. Isinna asseemma'emmaka beessisuwwanna lumollama manbe'uwwa uuda'ni jaja'nemman.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />Iyyerusaalemi hexxemmaxxi ergameeyye Semaariyak manni Mageniinka hiyyichcho adhdheexxa laqqe; tennexxee insa'ne Pheexiroosiinna Yohaannisii'i insa'nebaa ergine. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />Pheexxiroosinna Yohaannisi Samaariyaaki manni Woyyichcha Hafuura adhdhaashsha marreexxi insa'ne'a soodante. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />Manni kunni Yessuusi Kirsitoosike summini xamaqemema malee Woyyichchi Hafuuri mitteke'ninna dirre'emmabaan. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />Pheexxiroosinna Yohaannisi anga ifixxa konne mani hana uggine'naa manni Woyyichcha Hafuura adhdhe. <verse eid="ACT 8:17" /><verse number="18" style="v" sid="ACT 8:18" />Ergameeyye anga ifixxa insa'ne hana uggitee'na Woyyichchi Hafuuri mannakee uwwema'neexxa Simi'ooni afee wodda maallaqa insa'ne'a aadhe dageexxi <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />«Aninna anga hana ugganooki manji Woyyichcha Hafuura adhdhashsha konne baallooma ani'a uwwe» hiyye.<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />Pheexiroosinna hiisseexxi hiyyee qici, «Mageniinxa uwwa maallaqiki alfatee hasseetaxxee maallaqi atiki atinninni welti ba'owwaali! <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />Qalbe atixxi Magenii edo toggi hiyya gophpheemmaxxee ati no'oxxe huje'ni bakka yookaan qoobbo affebexxon.» <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />«Yoona konne fuggoke yaada atike'e yaaddetexxi aadde aagi! Akimagaada iitta hexxeexxa yaane heda atixxee gattowwaal hiyyaashsha Mageno soodat! <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />Tinninni kaddeechchi fuggo yaadi ate'n wo'meenaa cubbotinna sagarende hexxe'naa'a atee uudaannexxeeten.» <verse eid="ACT 8:23" /><verse number="24" style="v" sid="ACT 8:24" />Ookkonneechchi uduma Simi'ooninna hiisseexxi, «Ta'a ha'no haasotinexxenaa'ni mittilchinna midde anee geyabaashsha ha'noonni ani'a soodate!» hiyye. <verse eid="ACT 8:24" /><verse number="25" style="v" sid="ACT 8:25" />Pheexiroosinna Yohaannisi Goottinka hiyyichcho ifinse dhugaa kuleechchi uduma heddo Semaariyake ola'uwwa'n wengeele lassina'n Iyyerusaalemi'a illeema hinge.<verse eid="ACT 8:25" /></para>
  <para style="s1">Filphoosi Tophiyichcho Middisa Xamaqe</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />Iimik erganji Filiphphoosii'i, «Kexxetexxi Iyyerusaalemii'n Gaaza iyyemaraake qiilla gammoojjeke oriba'a bita'i'a me'i» hiyye. <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />Filphoosinna ke'eexxi mare. Isinna mitti Tophiyichchi midisi Magenoke kumbu hiyyeexxi Iyyerusaalemii'n illeema higaa'naa afemme. Kunni manjichchi Hindekke hiyyendaaxxe Tophiyiinxe moottitexxe mootumma giddo baallooma afe'ekenna ise affeeka maallaqa duuchcha abidaakemman. <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />Isinna hadi'a higa wodda sarageellake'n ofo'leexxi wabeekichcha Issayaasika Maxaafa haasesa'nemani. <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />Woyyichchi Hafuuri Filiphphoosii'i «Marte konne sarageellibaa shiqi!» hiyye. <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />Ookkonneechchi uduma Filiphphoosi rake'e ookkone sarageelliba mare'e, Tophiychchi wabeekichcha Issayaasika Maxaafa haasesaa'na'a laqeexxi, «Konne haasesitaateeke boonchixxi tika ate'ni aaga'ninni hexxee?» hiyyexxi qore. <verse eid="ACT 8:30" /><verse number="31" style="v" sid="ACT 8:31" />Isi kinni «Ani'a ifise kulaaki manji hedhebaangi hitta ege'naa dande'anno?» hiyyeexxi Filiphphoosii'i «Sarageella da'mite'e aninni welti ofo'li!» hiyye. <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />Isi haaseesamaake maxaafixxi bakka konnneechchinni butti'a hexxeexxen:</para>
  <para style="q1" vid="ACT 8:32">«Isi gedhdhechiishsha dulemamaba'a oofeme;</para>
  <para style="q2" vid="ACT 8:32">gedhebiinke buruusi orda cirrammak edo sammi hiyyammasha</para>
  <para style="q2" vid="ACT 8:32">iittanni isi mitteelchonna bucuqi hiyyebaan.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />Isi salphateen; seeriinxi murtenna isi'a gophendeen;</para>
  <para style="q2" vid="ACT 8:33">hedho isixxi tenne buttanaa'n adhdhendeemmaxxee</para>
  <para style="q2" vid="ACT 8:33">isixxe hortexxee ayyete haaso'a dande'aa?»<verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />Middisichchinna hiissexxi Filiphphoosii'i, «Wabeekichchi kunni tennee haaso'a'neek ayyixxeete? Umo ifikixxeetemo yookaan weliinxeete? Ballo'o ane'n kuli!» hiyye. <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />Ookkonneechchi uduma Filiphphoosi Maxaafa konnenaa'ni ke'isseexxi Yessuusixxa eloxxa odo iso'n kule. <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />Insa'nenna me'ina'ni wodi'i hedhee booncho genne. Middisikinna, «Ta'a wodi'i kunnse; xammaqemabe'noshsha anee hoyyaachchi maachcho?» hiyyeexxi qore. <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />Filiphoosinna, «Mitte godobinni amandoottole xammaqamaa dandeetattoni» hiyye. Middisiknna, «Ani Yessuusi Kirsitoosi Magenke Belto kadeexxa amananno» hiyye. <verse eid="ACT 8:37" /><verse number="38" style="v" sid="ACT 8:38" />Tennexxee middisi iikki sarageelli uurraashsha ajaje; lamingi wodi'i giddi'a e'yine'naa Filiphphoosi middisa ookkone xamaqe. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />Insa'nenna wodi'i giddii'ni fulchee uduma Goottiinki Hafuuri Filiphphoosii'i adhdhe; Middisi langaxxa isoo uudebaani; yaane kinni isi gammada'ni ora ifika me'e. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />Filiphphoosinna Azaaxooni afeme; isinna Qiisaariya'a dagaa qico'ni duuchchiinge qachchuwwa'ni wengeele lallaba'nemman.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s1">Sa'ooli Kiristoosi'n Amane</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />Ookkone wodda Sa'ooli Goottiinxa hordofeeyye shiyo'a daabbata'ni qeesetike sooresibaa mare. <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />Isinna Goottiinka ora hordofaaka manna labbaka meyyaka afoole usura'n Iyyerusaalemi'a iyyedaga dandeessisaaka borreessuwwa Demaasiqoke Ayihudiinke magenoonfachchotike minuwwi'a borreesemeexxi uwwemaashsha umo qeesichcho laqe. <verse eid="ACT 9:2" /><verse number="3" style="v" sid="ACT 9:3" />Isinna Demaasiqo'a shiqee wodda dedhange'ni isike qarqaraa'ni ifi iimi'ni dagee iso'ni xabe. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />Isinna ookkone wodda butta ibee'naa; «Sa'oolii! Sa'oolii! Mayee'e anee shorrishshaatee?» Hiyyaaka haasso'a laqee. <verse eid="ACT 9:4" /><verse number="5" style="v" sid="ACT 9:5" />Sa'oolinna «Anke Goottaa! Ati ayyete?» hiyye. Isinna hiisseexxi «Ati shorrishshaatek ante Yessuusiten. <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />Kexxeettexxi qachchinba missi hiyyi! Maa assitattoxxanna ookko ate'n kulendaan.»<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />Sa'oolinni welti me'aammak manni haaso'a ookkonee laqo malee mitteelchonna uuda gophe wodda hiyyaaxxa gopheexxi sammi hiyye uure. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />Sa'oolinna ibeeba'ni ke'eexxi ille baqqi assee wodda mitteelchonna uuda dande'aa gopheemmaxxee manni anga isixxa abidee akeeka'ni Demaasiqo iyyemare. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />Sase barra qico'ni afa dande'ebaan; isinna eettenne barra giddo mitteelchonna itebaan yookaani ha'webaan.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />Demaasiqo Hanaaniya hiyyemaak mitt hordofalli hedhemman. Gootti iso'ni waleellati, «Koo Hananiyya» hiyyeexxi e'ye. Isinna «Anke Goottaa! Ani kunna'a» hiyye.<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />Goottikinna iso'n hiyyee qici, «Kexxetexxi toggichcha ora hiyyemaakibaa mari! Ookko Yihudake mine'n Sa'ooli hiyyemaaka Xerseesika manjichcho mitte hasi! Ta'a isi Mageno soodachchote'ni hedheen. <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />Sa'oolinna ille isixxi higgeen afaa dandeetaashsha Hanaaniya hiyyeemmaki manjichchi isibaa mareexxi anga isoi hana uggaa wodda waleellati uude.»<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />Hanaaniyanna hiyyeexxi hiissee qici, «Anke Goottaa, kunni manjichchi Iyyerusaalemi hexxeemmaaxxe atixxe woyyoole'n heddo fuggoxxa yaane assa isixxa heddo manninaa'ni laqeennen. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />Isinna summa atika ye'aaka duuchcha usuro'aa qeesetike sooressuwwinaa'ni baalloma adhdheexxi kaba'a dage'een.»<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />Yaane kinni Gootti Hanaaniyya'n hiyyee qici, «Kunni manjichchi Ayihudake kadebaake arda'niinna moyanjuwwi edo iittanni Isira'eelike ardi edo summa anka ba'edho'aa ani'aa filemeeke anke miyani, kexxe isiba mari. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />Isi anke summixxee hitteeka abara adhdhaaxxa ani umo angenninni iso'ni leellishshannon.»<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />Ookkonneechchi uduma Hanaaniyanna Sa'ooli hedheemmake mine'ni mare e'yeexxi anga ifixxa Sa'ooli hana uggati, «Sa'ooli, anke dayyoo! Kabaa dagga'naa orake'ni ate'ni leellek, Gootti Yessuusii anee atibaa erge'een. Isi umo ifingenninni anee atiba ergeechchi afaa dandeetattoshshanna Woyyichchi Hafuuri ate'n wo'maashshateni» hiyye. <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />Hirbange'ni qonnonno labaachchi Sa'oolixxe illenaa'ni ibe'naa afa dande'een. Ookkonneechchi udumana ke'eexxi xammaqeme. <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />Isinna itattanna iteexxi jabaate; heddo barra qici'a Demaasiqo hexxeemmaaxxe Yessuusixxe hordofeeyyenni welti ture.<verse eid="ACT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20" />Sa'oolinna iikki woddi Ayihudiinke magenoonfachchotike mine'ni «Yessuusi Mageniinke Belton» hiyya'ni lallabate'n ke'e. <verse eid="ACT 9:20" /><verse number="21" style="v" sid="ACT 9:21" />Laqeeki manni duuchchi tenne mambe'a hiyya'ni «Isi kunni manjichchi Iyyerusaalemi giddo Yessuusika summa ye'aaka duuchcha bira'emmakemmaba'a? Isinna kaba dage'echchi amaanye usura'ni qeesetike sooresuwwibaa iyyemaro'atebaa?» hiyye. <verse eid="ACT 9:21" /><verse number="22" style="v" sid="ACT 9:22" />Sa'ooli kinni caala jabaata'ni me'e; Yessuusi isi Kiristoosite kadeexxa kokeessa'n Demaasiqo giddo hedheemmaka Ayihudiinka manna hiyyaaxxa haakisaamman.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />Heddo barranni uduma Ayihudiink manni Sa'oolii'i shiyatee mari'ate. <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />Isi kinni yaada insa'neeka ege'neemman; insa'nenna isoo shiyyatee hashshanna barra ookkone qachchixxa huluwwa heqqina'nemman. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />Mitte hashsha kinni Sa'oolxi hordofeeyye isoo agalade giddo uggiteexxi kinjiinke dalla'i haanii'ni sa'issiteexxi butti'a dirrisse.<verse eid="ACT 9:25" /></para>
  <para style="s1">Sa'ooli Iyyeerusaalemi Mare</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />Sa'ooli Iyyerusaalemi mareexxi hordofeeyyet welti karsemo'a hase; yaane kinni Sa'oolxi Kiristoosi'ni amana insa'ne'n dhugaate fakkaata gophemmaxxee insa'ne duuchchiingi sodaante. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />Yaane kinni Bernabaasi Sa'oolii'i ergameeyyetibaa shiqisheexxi, Sa'ooli orake'ni Gootta hitta uudeexxa Goottikinna iso'ni hitta haaso'eexxanna, ittanni Sa'ooli Demaasiqo Yessuusike summinni soda'a belo barachchiiseexxa Barinabaasi insa'ne'ni ifise kule. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />Tennexxee Sa'ooli insa'nenni welti hedhati Iyyerusaalemi giddo duuchcha'ni maremaa'ni soda'a belo Goottiinke summinni barachchiisa'nemman.<verse eid="ACT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 9:29" />Isinna Girkeeke laagadinni haaso'amaake Ayihudinke manninni welti haaso'a'ni welt moroma'nemman; insa'ne kinni isoo shinno'a hansa'nemmaan. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />Amaanye dayyuwwinna tennee laqee wodda Sa'ooli'i Qiisaariya'a aadheexxi ookko'n Xerseesi'a me'aashsha asse. <verse eid="ACT 9:30" /><verse number="31" style="v" sid="ACT 9:31" />Ookkonneechchi uduma Yihudake boga'n, Geliillanna Semaariya hexxeexxi Mageniinxi tuuta nage'ik hedhate'n kexxe, jabaatte; iittanni Mageniinxe soda'anni mammarenda'ninna Woyyichchi Hafuurinni dayyeefatta'ni laakkossiki bira saxxa'ni me'ite.<verse eid="ACT 9:31" /></para>
  <para style="s1">Eeniyaanxa Fayya</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />Pheexiroosi boga duuchcha'ni marema'ni Liidake qachcha'n hexxemmaxxe ammanyeba mare. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />Ookkonna saddeeta wogga duuchcha ela gonpheti ma'na hedheeka Eeniya hiyyyemaaka gogeeka manjichcho afe. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />Pheexiroosinna isoo, «Koo Eeniyaa! Yessuusi Kiristoosi atee fayyisaan, kexxetexxi ma'na atixxa fa'i!» hiyye. Hirba ookkone'ninni Eeniyaanna ke'e. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />Liidakinna Saaroonak manni duuchchi isoo uudeexxi Goottake'ni amane.<verse eid="ACT 9:35" /></para>
  <para style="s1">Pheexxiroosi Xaabbita'a Reyotenaa'ni Ke'isse</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />Iyyoophpheke qachcha'ni Xaabbita hiyyendaaxxi mitte manjichcho hexxemman. Summi isekinna Giriketike laagadinni «Dorqa» hiyyemaa wodda isixxi tikanna «Buddanne» hiyyaten. Isenna eloxxa yaane hujjaa'ni hiyyeeyye gargaarati yanna ifixxa duuchcha sa'issitaammaxxe manjichchomman. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />Ookkone wodda dhibendeexxi rerte; rensha iseka anshineexxi fooqete'ni hexxeexxe mitte kuta'ni uggine. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />Liida Iyyoophphe'a shiqqaammaxxee Iyyoophphe hexxeemmaxxi hordofeeyye Pheexiroosi Liida hedheexxa laqqeexxi, «Maganneten rakketexxi dagi» hiyyeexxi ye'aaka lame manjo Pheexxiroosibaa ergite. <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />Pheexiroosi erga isibaa maremaake manninni welti ke'eexxi dage. Isinna dageexxi geyyee wodda fooqete'ni hexxexxe kutaba'a isoo iyyemarre; aro'o shi'witeexxi melaalle duuchcha Pheexxiroosi'i elqe kayyii'ni buqqee ooxxa'n Dorqa lubboti insa'nenni welti hexxeemma wodda hujjeemmaxxa qamisuwwanna seemmuwwa iso'ni leelshaa'ni ooxxa'nemmaan. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />Yaane kinni Pheexiroosi duuchchiinga gadhi'a fulche'e, gulufateexxi Mageno soodate: isinna ookkonneechchi uduma renshinbaa wirri hiyyeexxi «Xaabbitaa ke'i» hiyye. Isenna Ille baqqi assiteexxi Pheexxiroosi'i uuda'n kexxeexxi ofolde. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />Isinna anga ifixxenni isee abide ke'isseexxi ammanyetanna aro'o shi'witeemmaxxa melaale ye'eexxi isee hedhondinni hexxeexxa insa'ne edo shiqishe. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />Iyyoophpheke qachcha duuchcha'ni tinni odo laqeende; heddi manninna Goottake'ni amane. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />Pheexxiroosinna goga duugammaake Simi'ooni hiyyemaamake manjichchinni heddo barra Iyyoophphe ofo'le.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s1">Pheexxiroosinna Qoorinelewwoosi'i</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />Qiisaariyake qachcha'n Qornelewoosi hiyyemaake majichcho hedhemman. Isinna Ixaaliyike loliinke mannixxe kuta giddo dhibba loliinke mannike ajajallomman. <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />Isinna ifike mini hadi duuchchinni welti amanate'n jabateekenna Mageno sodata'emmake, hiyyeeyyeteenna heddo uwwa uwwammake, Magenokanna duuchchi wodda soodata'emmakemman. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />Mitte barra barrixxa sallaane saate geyamma wodda, iimik erganji isibaa dageexxi, «Qornelewoosi» hiyyeexxi isoo ye'aa'naa waleellati uude. <verse eid="ACT 10:3" /><verse number="4" style="v" sid="ACT 10:4" />Iimike erganjiba'a hubate uude alayyeexxi «Maye anke Gootta?» hiyye. Iimik erganjinna hiisseexxi, «Soodachcho atixxanna hiyyeeyyetee uutaattaxxi atixxi uwwa qalliyyatee'e Magenii edo shiqqe'een. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />Ta'anna manna Iyyoophphe'a ergitettexxi Pheexiroosi hiyyemeeka Simi'oonii'i ye'isi! <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />Ta'a isi abbaayyati qarqara hedheeke goga duugaake Simi'oonike mine'n keesumumma ofo'le'een» hiyye. <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />Tennexxee Qoornelewwoosi, haasseessemmak iimiki erganji isonaa'ni gargar higeexxi me'eechchi uduma, ifike erganjuwwinaa'n lame mannanna, iittanni amanate'n jabaateeka isi'aa xuurameesa kadeeka mitte loliinka manjichcho ye'isseexxi, <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />duuchchiinxa yaane insa'ne'n kuleechchi uduma insa'nee Iyyoophphe'a erge.<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />Insa'nenna Langa baro me'inaa'ni Iyyophphe shinqee wodda, Pheexiroosi barrixxe jaane saate wodda hedheemmaxxe fooqe hana soodato'a iimi'a fuleemman. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />Ookkonne wodda isi solo'weemmaxxee'e ito'aa yore. Isinna itaa qixxeesseemmate'ni hexxe'naani waleella uude. <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />Isinna uudeexxi leella iima banende'naa mitte lumoxxa naxaliinxe seemma labbaachchi shoolnge ifike kasi darree'n abideemmeexxi butti'a daggaa'naa afennen. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />Tennee naxaliinxe seemma giddo gargari gargari hedheek shoole lekkaki biniinchi, godobik me'aachchuwwinna ci'a hexxemman. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />Ookkonneechchi uudma, «Koo Pheexiroosi! Kexxettexxi konnera dulda'n iti!» hiyyaak haaso'i laqeme. <verse eid="ACT 10:13" /><verse number="14" style="v" sid="ACT 10:14" />Pheexiroosinna hiisseexxxi, «Anke Goottaa! Kaddabaan; ani batto'eechcho yookaan diiqachchiisaachcho ite ege'nebe'non» hiyye.<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />«Mageni luqqi asseechcho ati batto'eechcho hiyya dandetabexxon» hiyyaak haaso'i higgeen laqeme. <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />Tinni yaane sasele iitta kaddeechchi uduma iikki naxaliinxe seemmashsha hedheechchi hirbange'ni iimi'a adhdheme.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />Pheexiroosi tennee waleellaxxi tika maachcho hiyya'ni heduma ifikenni wixxixxi hiyyaa'naa'a Qornelewoosi ergemaaki manni qodhdha'ni Simi'oonika mine anfeexxi hulati edo uurre'eemman. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />Insa'nenna ookkone mini hado ye'neexxi, «Pheexiroosi hiyyemeek Simi'ooni keesumummati kaba hedhee?» hina'n qorre. <verse eid="ACT 10:18" /><verse number="19" style="v" sid="ACT 10:19" />Pheexiroosinna tennee iso'n leelliteemmaxxa yaane heda'nenge'ni Woyyichchi Hafuuri iso'n hiyyee qici, «Atee sasi manni hasa'neen. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />Konne manna ergeenneki ante kadeennaxxee kexxe dirritettexxi mandebexxong insa'nenni welti me'i.» <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />Pheexiroosinna dirre'e ookkone manniibaa mareexxi «Hassinaa'neek manji anten; ha'noo mayeette daggineechchi?» hiyye.<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />Mannikinna, «No'oo dangeennek dhibba loliinka manna ajajammak Qornelewoosi darree'niten. Iso'o Ayihudiink manni duuchchi ulfeesa'neke Ayhudotiinke seera'ninna Mageno sagada'neeke eloke manjon. Isinna atee ifike minibaa ye'iseexxi ati hitaattoxxa laqaashsha Woyyichchi iimik erganji iso'n leelleen» hiyye. <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />Pheexxiroosi insa'nee mini'aa e'yisheexxi keesunse galche. Isi barriisanna ke'eexxi insa'nenni welti me'e. Iyyoophphe hedhaammake amanye dayyuwwinaa'ni mitti mitti insa'nenni welti me'e. <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />Langaxxa baranna Qiisaariya genne; Qornelewoosinna firuwwa ifikanna shiqika ifika jaaluwwa bukki asseexxi Pheexxiroosii'i heqqa'nemman.<verse eid="ACT 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 10:25" />Pheexiroosinna mini'a e'yee wodda Qornelewoosi isiba shiqe'e lekka isixxe'n ibeexxi isi'aa sagade. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />Yaane kinni Pheexiroosi, «Iimi'a ke'i! Aniqqa atishshanni manjoken» hiyyeexxi isoo ke'isse. <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />Pheexxiroosinna isinni haaso'a'ni giddi'a e'yaa wodda heddi manni bukki hiyye'naa afe. <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />Pheexxiroosinna insa'ne'n, «Mitti Ayihudiink manji Ayihudake kadebaakenni welti afema yookaan insa'nek mine'n e'ya seeri no'oki ajajabaaxxa ha'noonni egendine'een. Yaane kinni ani ayyeenna batto'eke yookaan ca'aa hiyyekebaan hiyyabe'noshsha Mageni ane'ni leellishe'een» hiyye. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />«Tennexxee ergitinee wodda ani waawoti hiyyebo'nongi ke'enneexxi dageennen; ha'noo qoro, anibaa ergitineechchita mayeete?»<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />Qornelewoosinna hiisseexxi hiyyee qici, «Shoole barra edo tenne yanna'ni sallaane saate'ni anke mine'ni soodata'eennan; cala cala hiteexxa seemma oddo'weeki manji dedhange'ni ani edo uurreexxi, <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />‹Qornelewoosi! Mageni soodachcho atixxa laqe'een. Ati hiyyeeyyetee uutettexxi uwwanna qalliyyatee Mageni edo shiqe'een. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />Iyyoophphe'a manjo ergitettexxi Pheexiroosi hiyyemeeka Simi'oonii'i ye'isi! Ta'a isi abbaayyati qarqara hedha'neeke, goga duugaake Simi'ooni hiyyemaake manjichchike mine'n keesumuma ofo'le'eeni.› <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />Tennexxe hirbange'ni erganjuwwa atibaa ani ergeneen; dagiyyo atixxinna eloxen. Mageni haasotattoshsha ajajeexxa duuchcha laqatee'e no'oo duuchchiingi Mageni edo bukki hineennen.»<verse eid="ACT 10:33" /></para>
  <para style="s1">Pheexxiroosika Haaso'a</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />Pheexiroosinna ke'eexxi hiyyee qici, «Mageni ayyi'anna gamisabaaxxa dhugaaten ani ta'aa hubatennen. <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />Fedheeke bogike manjonna kadoole Mageno sodaataakenna dhugaa hujaake kadoole Mageni isoo eeyyaan. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />Mageni duuchchiingike Gootta kadeeke Yessuusi Kiristoosi darree'n Isira'eelike ardi'a ergeexxi nage'iinxi eloxxi odonna tennenden. <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />Iittanni Yohaannisi xamaqatixxee lallabeechchi uduma Geliila'naa'n Yihudake boga duuchcha'ni kaddeexxa yaane ha'noo egendine'een. <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />Mageni Yessuusii'i Naazireetika Woyyichchi Hafuurinninna hunnanni isoo harirreen; isinna Mageni isinni welti hedheemmaxxee mare geyee booncho duuchcha'n eloxxa assa'n, durriisinke baallomi hunda hedheekaaranna fayyise. <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />Isi Ayihudiinke boga'n hadi giddonna Iyyerusaalemike qachcha'ni asseexxe yaane duuchchi'a no'oo dhugaa kullannoken. Manni kinni isoo haqichchiinxe fanno'ni fanniseexxi shiye. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />Yaane kinni sakkaxxa barra Mageni isoo'o reyotenaa'ni ke'isseexxi leellashsha asse. <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />Isi leeleeki duuchcha manjo'nite kaddebaangi, reyotenaa'n ke'eechchi uduma isinni welti indee ha'winneenneke, Magenikinna ediseenni no'oo fi'leemmakee, dhugaa kula isixxe kandeenneeke'niten. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />Ardakee lallanbannoshshanna hedheeke'ninna reyeeke'ni muraashsha Mageni baallonseek isote kadeexxa dhugaa kullannoshsha isi umo ifingenninni no'oo ajaje'een. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />Iso'ni amanaaki duuchchi summa isikenni cubbotixxa gattowwaali'i alfaaxxa wabeeko duuchcha isixxee dhugaa kuldaan.»<verse eid="ACT 10:43" /></para>
  <para style="s1">Ayihudake Kadebaak Manni Woyyichcha Hafuura Adhdhe</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />Pheexiroosi haaso'ande'n hedhee'naa hiyyichcho isika laqeeke manna duuchcha'ni Woyyichchi Hafuuri dirre. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />Pheexiroosinni welti Iyyophphee'ni daggeemmaxxi Ayihudiinxi ammanye Mageni uwwa ifixxa Woyyichcha Hafuura Ayihudake kadebaake manna'ninna dhangalaasseemmaxxee mambe'a hite. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />Tinni kaddeechchinna wele laagaduwwinni haasona'naanna Mageno galateeffanta'naa'a, insa'ne lanqemmaxxeeten. Eettene yanna Pheexiroosi hiyyee qici, <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />«Kunni manni no'oshshanni Woyyichcha Hafuura adhdheemmaxxee yoona wodi'ik xammaqemmabaashsha hoyyaak ayyete?» <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />Tennexxee insa'neenna Yessuusi Kiristoosike summinni xammaqeemmaashsha insa'ne ajaje. Ookkonneechchi uduma Pheexxiroosi insa'nenni welti shiixxoxxa barra turaashsha isoo kadhante.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s1">Pheexxiroosi Ayihudake Kadebaake Mannibaa Mareexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />Ergameeyyetinna Yihudake boga'n hedheemmak dayyuwwi Ayihudake kadebaak manni Mageniinka hiyyichcho adhdheexxa laqe. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />Tennexxee Pheexxiroosi Iyyerusaalemi ale maree wodda, jila ofo'leeke mannixxe gamo kaddeexxi ammanye Pheexiroosii'i, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />«Mayee jila ofo'lebaake mannike mine'ni martettexxi insa'nenni welti ittette?» hiyyati isoo moronde. <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />Pheexiroosinna duuchchiinxa yaane insa'ne'n aanchi aanchik kulate'ni ke'e: <verse eid="ACT 11:4" /><verse number="5" style="v" sid="ACT 11:5" />«Ani Iyyoophpheke qachcha'n hedhennexxi soodata'na laxanxa seemma labaachchi shoolnge ifike kasi darree'n abidemeexxi iimatenaa'n aniba'a butti'a dagaa'naa waleellati uudennen. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />Aninna konnechcho dhaphphi hiyye uudanno wodda konnee naxaliinxa seemma labaachcho'n shoole lekka'n me'aak hore biniincha, godobiki me'itaaxxa daduwwanna ci'aa uudennen. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />Ookkonneechchi uduma ‹Koo Pheexiroosi! Kexxettexxi konnera dulidaa'ni iti!› hiyaaki hafuuri laqeme.<verse eid="ACT 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 11:8" />«Ani kinni, ‹Anke Goottaa! Waawwoti kaddabaan; battoteexxi yookaan diqqachchiissaaxxi yaane ijje afo'o anke'n maqe ege'nebe'no› hiyyennen.<verse eid="ACT 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 11:9" />«Yaane kinni langaxxa yanna, ‹Mageni luqqi asseechcho ati battoossa dandeetabexxon› hiyyaak haaso'i iimatenaa'ni dage. <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />Tinni yaane sasele kaddeechchi udumi'a iitti naxaliinxa seemma fakkaattaaxxi yaane iimi'a adhdhende.<verse eid="ACT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 11:11" />«Ookkone hirba'ninni Qiisaariyaa'n anibaa ergemeeki sasi manni no'oo he'neennake miniba dage. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />Mitte mamibelo insa'nenni welti me'onnaa Woyyichchi Hafuuri ane'ni kule. Kunni jaaniigi dayyuwwi aninni welti me'e; manjichchiink mine'ninna e'yinneenneni. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />Isinna iimik ergaanji mine ifike'n uurre'naa uudeexxanna ‹Iyyoophphe'a manjo ergiteettexxi Pheexiroosi hiyyemeeka Simi'oonii'i ye'isi! <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />Isi atinna atik mini hadi duuchchi anjirendinaaka hiyyichcho ate'n kulaan› hiyyeexxa no'o'ni kule.<verse eid="ACT 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15" />«Aninna haaso'a safenne wodda, Woyyichchi Hafuuri edo sirete'ni no'o'ni dirreemmashshanni insa'ne'ninna dirre. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />Ookkoone wodda ‹Yohaannisi wode'ik xamaqeen ha'no kinni Woyyichchi Hafuuurini xammaqendinaan› hiyyaati Gootti haaso'emmaka haaso'a kassi hiyyeenne. <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />Gootta Yessuusi Kiristoosi'ni amannannoke no'oo'a Mageni uwweexxa uwwa insa'ne'anna uwwoole yoonata Mageno hoyya dande'annok ani ayyete?»<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />Insa'nenna tennee lanqee wodda, «Mageni Ayihudake kadebaaka mannanna anjirematee'e geessissaaxxa aadde aangaashsha asse'een» hiyyati Mageno saande.<verse eid="ACT 11:18" /></para>
  <para style="s1">Antsookiya Hexxeemmaxxa Mageniinxa Tuuta</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />Isxifaanoosi cancaqemeexxi reyee wodda ke'eeke shorrichchinaa'ni kexxeexxa xexxerendeexxi ammanye Finqe qico'n, Qophphiroosi qico'ninna Antsookiya qico'n me'ite. Insa'nenna hiyyichcho Mageniinka Ayihudiinke manna'n malee'e weleke'n kulla'neemmabaani. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />Kaddoo malee Qophphiroosinaa'ninna Qereenaa'n daggeexxi mitte mitte ammanye Antsookiya marteexxi Girkeeke manna'ninna Gootta Yessuusixxa eloxxa odo kulde. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />Goottinxi hunnanna insa'neenni welti hexxeemman; heddi manninna amaneexxi Goottiinbaa hige. <verse eid="ACT 11:21" /><verse number="22" style="v" sid="ACT 11:22" />Iyyerusaalemi hexxemmaaxxi ammanye tenne odo laqqee wodda Bernabaasii'i Antsookiya'a ergite. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />Barinnaabaasinna ookko geyeexxi Mageni badhaadha ifiken asseexxa afee woda gammade; duuchching wo'ma qalbenni Gootta addatati jabaantaashsha insa'nee gorse. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />Isi Woyyichchi Hafuurinna amana iso'n wo'miteeke manjomman; heddi manninna Goottinba'a hige. <verse eid="ACT 11:24" /><verse number="25" style="v" sid="ACT 11:25" />Ookkonneechchi uduma Barinabaasi Sa'oolika hasito Xerseesi'a me'e. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />Barinnaabaasinna Sa'ooli'i afeechchi uduma isoo Antsookiya'a iyyedage. Lamingi mitte wogga duuchcha ookko hexxeexxe Mageniinxe tuutanni welti mitteba he'neexxi heddo manna barachchiinse; Hordofeeyyetinna sirete'n Antsookiyya «Kiristoosito» hiyyendeexxi ye'endeen.<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />Ookkone wodda mitte mitte raagole Iyyerusaalemi'ni Antsookiya'a me'ite. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />Insa'ne giddii'n mitti Agaboosi hiyyemaaki wabeek ke'eexxi, «Butta duuchcha'ni lumoki solo'i iba'neen» hiyya'ni Woyyichchi Hafuurixxe kulanni raagaa haaso'e. Kunni kulemeek solo'i kadeeki Qelaawudewwoosi hiyyemaake Roomike lumooke moyanjike baro'nitemman. <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />Tennexxee duuuchchiinxi hordofeeyye umo umonge'ni dandeetee qico maallaqa fulchite'naa Yihudake boga'n hedheke dayyuwwi'a gargaarsi ergemaashsha mudhdhite. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />Insa'nenna ookkonee buunseemaka maalaqa Bernabaasixxenna Sa'oolixxe anga'ni Mageniinxe tuutaxxe geedheba'a ergine.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s1">Ammanyete'n Gelteexxa Shorrensha</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />Ookkone baro'ni moyanji Heeroodisi Mageniinxe tuutanaa'n mitte mitte ammanye shorrichchoke'n ke'e. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />Isi Yohaannisika dayyo Ya'iqoobii'i wolaantichchiki shilchiise. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />Heroodisi tinni yaane Ayihudiinka manna gammachchiisseexxa uudee wodda Pheexiroosinna abidise. Tinninna kaddeek Ayihudiinka kebbotika ayyaana ulfeesinammaxxe yannuwwa'niteman. <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />Isinna Pheexxiroosi'i usuriinke mine'ni e'yshshechi uduma, shoole shoole loliinke manna kanda'n isoo heqqinashsha, shoole heqqatixxe yanna'n dhaabemeeke loliinke manna'n sa'isse uwwe. Tennenna asseechchi sa'atiki ayyaani sa'eechchi uduma isoo ardii edo fulcheexxi iso'n murte uwwendaashsha hedeeten. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />Tennexxee Pheexiroosi usurriinke mine'ni heqqema'nemman; yaane kinni Mageniinxi tuuta isixxee'e Mageniinbaa jabeessiteexxi soodata'nemmani.<verse eid="ACT 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />Heeroodisi Pheexiroosii'i ardii edo shiqisho'aa hedee'naa Pheexxiroosi eettene hashsha lame haachchabinni usuremeexxi lame loliinke mannixxe oddo'ni dhiipheemman. Usuriinke miniki heqqanjuwwinna eettene usurriinke minixxe hula'ni uurreemman. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />Iimiki erganjinna dedhange'ni leelle; ifikinna ookkone usurriinke mine'ni ife. Erganjikinna Pheexiroosika cinaachcha tuqe dammaseexxi isoo, «Rakketeexxi ke'i!» hiyye. Haachchabuwwikinna hirbange'ni Pheexxiroosixxe anganaa'ni ibe. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />Ookkonneechchi uduma Iimik eriganjinna isoo, «Seemmatanna oddo'wi! Kophetanna uggudhi!» hiyye. Pheexxiroosinna isi ajajemmashshaani asse. Iimiki erganjinna higgeenni isoo, «Seemma atixxa fugatettexxi anxa duuka amoo!» hiyye. <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />Pheexxiroosinna usurriinke minenaa'ni fuleexxi isoo hordofe. Iso'ni waleella uuda'neechcho fakkaateemma malee iimiki erganji asseexxi yaane duuchchi iso'n dhugaate fakkaatemmabaan. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />Insa'nenna taakabanna langaba heqqaamaka loliinka manna sa'neexxi qachchiinba'a fulchitaammaxxe sibiljiinxe hulaba genne. Kunni cufaninna kinsebaangi iittanni baneme'naaa fulle me'ine. Insa'nenna mitte lumoke ora'n fulleexxi shiixxo qico me'ineeshshanni dedhange'ni iikki iimiki erganji Pheexxiroosinaa'n gargar hige.<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />Ookkonneechchi uduma Pheexiroosinna reefi wodani giddi'aa higeexxi «Mageni Iimika eriganjo ergeexxi Heeroodisixxe anga'naa'ni iittanni Ayihudiink manni hedeemmaxxxe yaane duuchchanaa'ni anee gatiseexxa dhugaaten ta'a reefi kokeennen» hiyye.<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />Isinna tennee kokeechchi uduma, heddi manni mitteba bukki hiyyeexxi soodatamaba'a, Maariqoosi hiyyemeeke Yohaannisixxa ama, Maaramike miniba'a me'e. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />Pheexxiroosik miniibaa geyeexxi gadhii'ni hula ganganaa wodda mitte Rooda hiyyendaaxxi mini giddo ergataammaxxi jale dagge. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />Isenna tinni Pheexiroosixxe qonqo kaddeexxa egendee wodda gammashshotixxe bira sa'nenaa'ni kexxeexxa hulatanna midde bandebaangi mini'a gongite marteexxi «Pheexxiroosi hulate'ni uurre'eeni» hite kulde. <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />Insa'nenna isee «Maraateteni» hine. Roodda kinni, «Dhugaaten isondeni» hita'ni lebbe lebbeexxi insa'ne'ni kulde; insa'nenna «Isike iimike erganjo labe'eeni» hine.<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />Yaane kinni Pheexiroosi hula ganganande'ni hedhemmani; insa'nenna hula banneexxi uundaa wodda mambe'aa hine. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />Pheexxirosinna insa'nee sammi hinaashsha angati qiphe kuleexxi; Mageni usurrii mininaa'ni isoo hitta asseexxi fulcheexxa insa'ne'ni kule. Ookkonneechchi uduma isi, «Tenne yaane Ya'iqoobi'ninna amaanye dayyuwwa'ni kulle!» hiyya'ni insa'nenaa'ni gargari higeexxi welebaa me'e.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />Langaxxa barra «Pheexiroosi maa kade?» hiyyati loliinke manna duuchcha'ni lumooxxe weekkensha kadde. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />Heeroodisinna Pheexxiroosi'i hasiseexxi gophee wodda, ookkone hula heqqammakaara qore qo'niseechchi uduma insa'ne shiyemmaashsha ajaje. Ookkonneechchi uduma Heeroodisi Yihudaa'n Qiisaariya'a me'eexxi ookko ofo'le.<verse eid="ACT 12:19" /></para>
  <para style="s1">Heeroodisixxa Reyo</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />Heeroodisi Xiroosike'ninna Sidoonake manna'n yo'oshsha mufateemman; insa'nenna mittenba bukki hine dangeexxi moyanjokee ergatemamaki manjichchi Bilasixoosi moyanjiki welti araarsaashsha kadhanteechchi uduma moyanjo araara lanqqe. Insa'nenna tennee assineechchi ardi itaachcho alfaammaki moyanjiinke boginaa'nite kaddeemmaxxeteni.<verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />Yaane uudeendo'a murendeexxa barra Heeroodisi mootummatixxa seemma odo'we'e mootete'n ofo'leexxi ardake'n haaso'a safe.<verse eid="ACT 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 12:22" />Ardikinna, «Kunni Mageniinke haaso'a malee manjiinkebaani» hiyya'n canice.<verse eid="ACT 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 12:23" />Heeroodisi Magenokee ulifinna uwwa gopheemmaxxee hirbange'ni Mageniink iimik eriganji isoo ganee'naa'a coroqo'eexxi reye.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />Yaane kinni Mageniinki hiyychchi nophpha'ninna ba'lata'ni me'a'neemmani. <verse eid="ACT 12:24" /><verse number="25" style="v" sid="ACT 12:25" />Bernabaasinna Sa'ooli ergemeemmaxxa insa'nexxa huje birreexxi Iyyerusaalemii'ni Anitsookiya'a hinge. Insa'nenna Maariqoosi hiyyemeeka Yohaannisii'i adhdhineexxi dange.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">Barnabaasinna Sa'ooli Woyyichchi Hafuurini Filemeexxi Barachchiisatee Ergeeme</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />Antsookiyixxe Mageniinxe tuuta giddo wabeekonna barachchiisalluwwi hedheemman. Insa'nenna Bernabaasi, iikki Xilloke hiyyemeek Simi'ooni, Qereenake qachchik Lukkiyoosi, bogiinka galchallo Heeroodisinni welti mitteba nophpheeke Minaaheenna Sa'oolitemmani. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />Insa'nenna Gootta magenoonfanta'naanna agabo goddo honsaa'naa Woyyichchi Hafuur, «Ani insa'ne'e fi'lenneexxe huje'a ha'no Bernabaasinna Sa'ooli'i ani'a gargari fowwe!» hiyye. <verse eid="ACT 13:2" /><verse number="3" style="v" sid="ACT 13:3" />Insa'nenna agabo goddo honsenna soodanteechchi uduma anga ifixxa insa'ne hana uggineexxi me'inaashsha assine.<verse eid="ACT 13:3" /></para>
  <para style="s1">Barinnaabasinna Sa'ooli Qophphiroosi Giddo</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />Barinnaabaasinna Sa'ooli Woyyichchi Hafuurinni ergemeexxi Selewuqiya'a me'ine; insa'nenna ookko'ni hobolote'ni ofolleexxi Qophphiroosi'a me'ine. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />Selamiisika qachcha gennee wodda Ayihudiinke magenoonfachchotike mine'n Mageniinka hiyyichcho barachchiinse. Maarqoosi hiyyemeek Yohaannisi insa'ne'n welti hedheexxi insa'nee gargaara'neemman.<verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />Insa'nenna Qophphiroosika oddoola mitte kasanaa'n mitti kasi qico'n me'ineexxi Phaafu gennee wodda, ookko Beriyesuusi hiyyemaaka mitti moraaka Ayihudichcho anfe. Isi dharichcha wabeekichchommna. <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />Kunni manjichchi Sergiyoosi Phawuloosi hiyyemaake qalbaamessa boga galchallo manjichchinni welti hedhemman. Kunni boga galchalli Mageniinka hiyyichcho laqo'aa haseexxi Bernabaasinna Sa'oolii'i ye'ise. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />Yaane kinni Girikeke laagadinni «Elimaasi» hiyyemee ye'emaaki moralli Baariyessuusi, iikki boga galchaamak amanabaashsha haseexxi Barinnaabaasinna Sa'oolii'i morome. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />Ookkonneechchi uduma Phawuloosi hiyyeemmeek Sa'ooli kinni Woyyichchi Hafuurinni wo'me'e konne manjichcho dhaphphi hiyye uudeexxi hiyyee qici, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />«Ati bada durriissiink belti qullumatike naaphi, shokkonna fuggoxxi yaane duuchcha ate'ni wo'mite'eek, toggichcha Mageniinka ora dassatenaa'n higgabeexxo? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />Mageniinxi anga ate'e gandaan. Ati balla'ake kaddaton, konneechchinni edi'a arshotinga ifa midde uudaboxxon.» Hirbange'ni Eelimaasixxa ille dukkanatinna hurre buqqe. Isinna anga isixxa abideexxi akeekaa manjo ookkone qarqara'n halsate'ni ke'e. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />Kunn boga galchammaak manjichchi tenne kaddeexxa yaane uudee wodda, Goottiinxa barachchiisa saadeeexxi Yessuusi Kirsitoosi'ni amane.<verse eid="ACT 13:12" /></para>
  <para style="s1">Barinnaabaasinna Phawuloosi Phisidiya Giddo</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />Phawuloosinna jaaluwwi isik Phaafunaa'n ke'neexxi Phinfilya hexxeexxe Pherge'a me'ine. Ookkoo Maariqoosi hiyyemeek Yohaannisinna insa'nenaa'n gargariti higeexxi Iyyerusaalemi'a illee iima hige me'e. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />Insa'ne kinni Phergenaa'n ke'neexxi Phisidiya giddo hexxeexxe Antsookiya'a me'ine; insa'nenna Edike Sanbatiinxa barra Ayihudiinke magenoonfachchotike mine'ni marre ofolle. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />Muusek seerkinna wabeekotik maxaafi haasessemeechchi uduma Ayihudiinke magenoonfachchotike miniki sooresuwwi, «No'oke dayyuwwaa! Arda dayyeesaaka gorsiinka haaso'a affino'oole haaso'we!» hiyya'n Phawuloosimmaba'a manjo erge.<verse eid="ACT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16" />Tennexxee Phawuloosi ke'e uurreexxi anga le'misa'n arda hiyyee qici: «Ha'no Isira'eelik manninna Mageno sodaatinak duuchchi laqqe! <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />Konne Isira'eelike ardik Mageni annuwa no'oka fi'leen; isi Gibtseeke boga'n he'nee'naa'a insa'nee kubbise; jabaxxe ifixxe hirrenninna ookko'ni insa'nee fulche. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />Shoole tomme wogga qici'aanna qiilla gammoojjeke boga'ni insa'nee ba'edheen. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />Mageni torbaane mootummaka arda Kenaanike boginaa'n balleeseexxi insa'neka boga Isira'eelike ardi'a dhaalchiseeni. <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />Tinni duuchcha muuxendeek shoole dhibbanna onde tomme wogga qico'nitemman.</para>
  <para style="p" vid="ACT 13:20">«Ookkonneechchi uduma wabeekichcho Saamu'eelike bari qico'ni hayyoole insa'ne'a uwween. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />Ookkonneechchi uduma ardi moyanjo insa'ne'a filaashsha Mageno kadhate; Magenikinna Biinyaamike gosati minika manjo Qiisika belto Sa'oolii'i shoole tomme wogga'aa insa'ne'n moyanjoke asse. <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />Isinna Sa'oolii'i hoyyeechchi uduma Daawwiti insa'nen moyashsha asse. Magenikinna Daawwitixxee baassa'n hiyyee qici, ‹Fedhi anxa duuchcha assaaka anxe qalbeka manjo Isseyika belto Daawwitii'i alfe'eennen.›<verse eid="ACT 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 13:23" />«Magenikinna addachchiiseemmashanni konne manjichchixxe hortena'ni anjiralloke kade'eeka Yessuusi'i Isira'eeli'aa iyyedage. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />Yessuusi dagebaa edi gama Yohaannisi Isira'eelike ardi'a aadde aagatixxa xamaqa lalabe. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />Yohaannisi huje biro'a shiqeemma wodda, ‹Ha'no anee ayyete hitinaa'ne? Aniqqa isoteba'a; yaane kinni Ani isixxe kopheka usurra tikatee midde geyyabe'nok, ani udumii'n dagaan› hiyya'nemman.<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />«Ha'noo Abirihaamixxe hortena'ni ilendineek dayyuwwinna ha'noo Mageno sodaatinaake ardaa! Kunni anjirenshatik hiyyichchi ergemeek no'aateni. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />Iyyerusaalemi giddo hedhammak manninna sooresuwwi insa'neek Yessuusi'i ege'neemmabaan; ege'na gonpheemmaxxeenna edike Sanbata Sanbatuwwa'n haasesseemaak wabeekotik hiyyichchi muuxemo'aa iso'ni murre. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />Insa'nenna reyotee isoo geessisaaxxa yaane iso'n afa gonphoolenna midde reyotixxa murte iso'ni muro'a Philaaxoosi'i kadhanteen. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />Insa'nenna isixxee borreessendeexxa yaane duuchcha muunxechchi uduma isoo fannotenaa'ni dirrinseexxi moonge. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />Yaane kinni Mageni isoo reyotenaa'n ke'isse. <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />Geliilaa'n Iyyerusaalemi qico isinni welti hedhemmake manna'n heddo barra leelle; insa'nenna ta'a ardakee isixxee dhugaa kulaan.<verse eid="ACT 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32" />«No'onna Mageni no'oke edike annuwwi'a addachchiisemmaka eloxxe odoke hiyyichcho ha'no'aa lallabaannen. <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />Mageni Yessuusi'i reyotenaa'ni ke'issiyyoti isi insa'ne'aa addachchiisemmaka hiyyichcho ta'a no'oo'o oose insa'nexxee muuxe'een: tinninna langaxxe faaro'ni hiyyende borreseendee qici:</para>
  <para style="q1" vid="ACT 13:33">« ‹Ati anke Belton;</para>
  <para style="q2" vid="ACT 13:33">techcho ani atee i'leennen›<verse eid="ACT 13:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34" />Iittanni isi alo'abaaxxanna Mageni isoo reyotenaa'ni ke'issaaxxa kokeessatee hiyyee qici:</para>
  <para style="q1" vid="ACT 13:34">« ‹Woyyitetanna addatendeexxa Daawwitixxa eebba ha'no'aa uwwannon.›<verse eid="ACT 13:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35" />Higgeeni wele faarotike maxaafa'ni:</para>
  <para style="q1" vid="ACT 13:35">« ‹Ati woyyichcha belto atika alo'aashsha assitabexxon› hiyyende'eeni.<verse eid="ACT 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36" />«Daawwiti ifike baro'n Mageniinxe fedhee'aa ergatemmeechchi uduma reyedheen; annuwwa ifikenni weltinna moogemee'naa maali isiki alo'eedheen. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />Yaane kinni Mageni reyotenaa'ni ke'isseemmaka isoo ookkonee ijjenda alo'aa geltebaan.<verse eid="ACT 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38" />«Yoona anke dayyuwwa cubbotee gattowwaali afendaaki Yessuusi darree'nite kaddeexxa ha'no'a lallabendeexxa ege'ne! <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />Iso'ni amanaak duuchchi Muusek seeri darre'ni alfa dande'endebaaxxa qullumma alfaan. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />Tennexxee wabeeko konnechchi butta hiteexxi borreessiteemmaxxi yaane ha'no'ni geltabaasha heqqedhe!<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />« ‹Ha'noo tuffatina'neek uuddee!</para>
  <para style="q2" vid="ACT 13:41">Mambe'a hitinenna ba'wee!</para>
  <para style="q1" vid="ACT 13:41">Ayyinna ha'noo'ni haaso'eele</para>
  <para style="q2" vid="ACT 13:41">Ha'noo amandinabaaxxa huje</para>
  <para style="q2" vid="ACT 13:41">Ani baro ha'nooke'ni hujannon.› »<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />Phawuloosinna Barinnaabaasi Ayihudiinke magenoonfachchotike minenaa'n fullee wodda manni «Dagaaka edi Sanbatanna ha'no daggineexxi tenne yaane higgeeni no'o'ni kulle!» hiyyeexxi insa'nee kadhate. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />Ayihudiinke magenoonfachchotike minki ya'i xeeremee wodda, heddi Ayihudiink manninna iittanni Ayihudummatixxe amanaba'a higeexi Mageno magenoonfachchote'n jabaateeki manni Phawuloosinna Bernabaasii'i hordofe. Phawuloosinna Barinnaabaasi konne manna barachchiisat Mageniinke badhaadha'ni jabaanteexxi he'naashsha insa'nee gorsine.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />Langaake edi Sanbatixxe barra'ni qachchi giddo hedheemmaake manninaa'ni heenooki manni calli gate'naa'a duuchchiingi Mageniinka hiyyichcho laqo'a bukki hiyye. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />Ayihudiink manni ardiinxa birasaa'ne uudee wodda foggoxxe gaabbenni wo'meexxi isika haaso'a moroma'ni Phawuloosii'i yowwa'nemman.<verse eid="ACT 13:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 13:46" />Ookkoneechchi uduma Phawuloosinna Bernabaasi afo'o wo'mine hinee haasonee qici: «Mageniink hiyyichcho no'o sirete'ni ha'no'aa kula hassisaan; ha'noo kinni adhdhinabe'no hitineemmaxxeenna duuchchi woddixxi hedho ha'no'aa hasissabaashsha ha'noo umo ha'nooke'n murtineemmaxxee no'o Ayihudake kadebaake mannibaa alba wirri hinannon. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />Gootti no'o hiyyee ajajee qici:</para>
  <para style="q1" vid="ACT 13:47">« ‹Butta duuchchik manni atinni anjiremaashsha</para>
  <para style="q2" vid="ACT 13:47">Yihudake kadebaake manni'a atee ifake assenneen.› »<verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />Ayihudake kadebaaki manni tennee laqee wodda tenne'ni gammade; Goottiinka hiyyichchonna ullfeesse. Duuchchi woddixxe hedho'aa filemeek duuchchinna amane.<verse eid="ACT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49" />Goottiink hiyyichchinna ookkone boga duuchcha'ni ba'laate. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />Yaane kinni Ayihudink akeekisanjuwwi Ayihudiinxa amana hordofammaxxa ulfeessendeexxa melaallenna qachchi giddika lumollamma manna Phawuloosi'ninna Bernabaasi'n diiniki ke'issineexxi boga ifikenaa'n insa'nee shorrinshe. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />Tennexxee Phawuloosinna Barinnaabaasi no'o darrexxa bidhineenen hina'n ifixxe lekkaxxa buko ganga'nineexxi Iqoniyooni'a me'ine. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />Hordofeeyyetinna gammashshotinna Woyyichchi Hafuurinni wo'mite.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s1">Phawuloosinna Barinnaabaasi Iqonyonike Qachcha'ni</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />Iqoniyoonike qachcha'n Phawuloosinna Barinnaabasi welti Ayihudiinke magenoonfachchotike mine'ni e'yine. Insa'nenna ookko hasissaa qico barachchiinseemmaxxee Ayihudiinkenaa'ninna Girkeeke manninaa'n heddi amane. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />Yaane kinni amanebaaki Ayihudiink manni Ayihudake kadebaaka manna diiniki duuchchiisseexxi ammaanye dayyuwwa gibaashsha asse. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />Tennexxe Phawuloosinna Barinnaabaasi Goottiinxee afo'o wo'mine haasonna'ni ookkoo lummooxxa yanna turre; Goottikinna mambe'uwwakanna beessisuwwa anga insa'nexxe'ni huja'n, ifike badhaadhiike hiyyichchiixxa dhugaalessumma kokeessa'nemman. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />Qachchiinki manni kinn lameba qoodemeexxi gamisi Ayihudiinke manninni welti, gamisi ergameeyyet welti hige.<verse eid="ACT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5" />Ayihudake kadebaak manninna Ayihudiink manni ifi fike soorrsuwwinni welti mitteba higeexxi Phawuloosiinna Barinnaabaasii'i geebe geeraro'aanna kinjik cancaqo'a hase. <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />Yaane kinni insa'ne lamingi tenne egenee wodda Lisixxiranna Derbe hiyyemake Liqa'ooniyake qachchuwwiba'aanna qarqarake'n hedheeke bogiba'a baanje. <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />Insa'nenna ookko wengeele lallanbe.<verse eid="ACT 14:7" /></para>
  <para style="s1">Phawuloosinna Barinnaabaasi Lisixxirake'ninna Darbeke Qachcha'ni</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />Lisixxirake qachcha'ni lekka goge'eeki mitti manjichchi hedhemmaan. Isi ilemeexxeninni naafake kadeemmaxxee lekkati me'exxi ege'nemmabaani. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />Phawuloosi haaso'amma wodda isi ofo'le caqasa'nemmani. Phawuloosinna konne manjichcho dhaphphi hiyye uudeexxi isoo fayyatee geessissaaxxa amana afeexxa uudee wodda, <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />hafuura gikki asseexxi «Toggi hitettexxi lekka atixxenni uurri!» hiyye. Manjichchikinna qophphi hiyyeexxi tarikafata'ni me'ate'ni ke'e. <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />Manni tennee Phawuloosi asseexxa yaane uudee wodda hafuura gikki asseexxi, «Magenuwwi manjo fakkaateexxi no'obaa dirre'een» hiyya'n ifike Liqa'ooniyake laagadinni haaso'e. <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />Insa'nenna Bernabaasii'i «Diiyya» hine summa fulchine. Umi haaso'alli Phawuloosite kadeemmaxxee isoo «Hermeen» hine. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />Qachchii gadhdhi darre hedheeke Diiyyake Galmik qeesichchi jiboottattanna daraaro ookkone qachchixxe hulaba'a iyyedageexxi ardik welti Phawuloosi'anna Barinnaabaasi'a tolcho'a hase.<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />Ergameeyye Phawuloosinna Bernabaasi tennee yaane lanqee wodda seemma ifi ifixxa yaadoti darreexxi raara'ni ardiinbaa gongineexxi, <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />«Koo mannaa! Mayyee tennee assitina? No'oqqa ha'nooshshaanni manjoken. No'o kaba dangeenneelchi ha'noo tenne dhariinxe yaane duuchchanaa'ni bayyatineexxi iimatanna butta, abbaayyaatanna ise giddo hedheechcho duuchcha dadeeke hedhoke Mageniba'a higginaashsha eloxxa odo ha'no'n kullonna'aaten. <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />Isi sa'eeke baruwwa'n gosa gosak ardi duuchchi ifi ifinge ora'n me'aashsha waaleen. <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />Kaddo malee isi hitta hedheeke arjaa Mageno kadeexxa dhugaa kuldaaxxa eloxxa huje hujatenaa'ni udumi'aa higebaan. Isi iimii'ni xeena ha'no'aa gansiise; mayetixxa yannanna ha'no'aa uwwe; itatinna gammashshoti qalbe ha'nooxxa wonshe.» <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />Konne haaso'a duuchcha haasonneexxi ardi insa'ne'aa tolchabaashsha waalchinseek jaba qicinnittemman.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />Mitti mitti Ayihudiink manni Antsookiyii'ninna Iqoniyoonii'n ookko'aa dageexxi manni Phawuloosi'ni ke'aashshanna isoo kinjki cancaqaashsha asse; reyeechcho labbee'naanna harkinseexxi qachchi giddi'ni fulchine. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />Hordofeeyye kinni daggeexxi Phawuloosike qarqara'n qoqqobbe uurrite'naa Phawuloosi ke'eexxi qachchi giddi'a e'ye. Langa barranna Bernabaasinni welti Derbeke qachchibaa me'ine.<verse eid="ACT 14:20" /></para>
  <para style="s1">Phawuloosinna Barinnaabaasi Antsookiya'a Hinge</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />Phawuloosinna Barinnaabaasi Derbeeke qachcha'ni eloxxa odo lallabeexxi heddo manna hordofeeyyete assineechchi uduma Lisixxira'aa, Iqoniyooni'aanna Antsookiya'aa ille iima hinge. <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />Ookko hordofeeyyetixxa qalbe jajjabeessatinna amana ifixxe'n ti'ni hineexxi uurrinaashsha gorsati «Mageniinxe mootumma'ni e'yatee no'o rakko lummoxxi giddo sa'a hasissaan» hinaa'ni insa'nee barachchiinse. <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />Mageniixxe mitte mittende tuutta'n geedhdhe insa'ne'aa baallonsineechchi uduma, agabo goddonna soodanteechchi uduma ookkone amanneemmake insa'neke Mageno'n maganne insa'nee uune.<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />Phisidiya giddii'ninna sa'neexxi Phinfilya'a ame'ine. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />Insa'nenna Phergeke qachcha'n Mageniinka hiyyichcho lallanbeechchi uduma Axaaliya'a adadde me'ine. <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />Ookkonneechchi uduma Axaaliyanaa'ninna hunjeemmaxxe hujexxee Magenike badhaadha'n maganne uwweemmeemmake Antsookiyake qachchiba'a markabiki hingeexxi me'ine.<verse eid="ACT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27" />Antsookiyya gennee wodda Mageniixxi tuutta mitteba bukki hiteexxi Magen insa'nenni welti hedhe'e hujeexxa duuchcha iittanni Ayihudake kadebaak manninna amanaashsha Mageni hitta ora baneexxa insa'ne'n kulle. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />Insa'nenna ookkonna heddo barra hordofeeyyeti welti turre.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s1">Iyyerusaalemika Haagana</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />Mitti mitti manni Yihudanaa'n Antsookiyyaa aade marreexxi, «Muuseke seerishsha jila ofoldinebaaki anjirema dandeetinabaan» hiyya'ni amaanye barachchiisa safe. <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />Tinni yaanenna Phawuloosinna Bernabaasii'i insa'nenni welti jabaxxe moronshabaanna loliinbaa geessisse. Tennexxee Phawuloosinna Barinnaabaasi wele kirisitoositon welti Iyyerusaalemi'a mareexxi tenne yaanexxee ergameeyyetanna geedhe qorraashsha murnde.<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />Tennexxee Mageniinxi tuutta insa'nee ergitee'naa me'ine. Finqenna Semaariya giddii'n sa'nee wodda Ayihudake kadebaak manni amaneexxi Mageniiba'a hitta higeexxa haasoonne. Tinni odonna amaanye duuchcha gammachchiisse. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />Iyyerusaalemi dange gennee wodda Mageniinxi tuuta, ergameeyyetinna geedhdhe insa'nee qophphexxe adhdhite. Ergeme'emmak manninna Mageni insa'nenni welti hedheexxi hujeexxa huje duuchcha insa'ne'n odeesse. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />Yaane kinni Feerisitotixxe gamonaa'n amaneemmak mitti mitti manni ke'e uurreexxi, «Ayihudake kadebaaki manni jila ofo'lanna Muuseka seera heqedhaashsha assa hassissaan» hiyye.<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />Eergameeyyetinna geedhdhe tenne yaane mari'atto'aa mitteba bukki hite. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />Lumooxxa mari'e mari'antechchi uduma Pheexiroosi ke'e uurreexxi hiyyee qici, «Anke dayyuwwa! Ayihudake kadebaaki manni ani gami'ni wengeeltika hiyyechcho laqeexxi amanaashsha konnechchi edi darre Mageni ha'nooxxe oddoo'ni anee fileexxa egendine'een. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />Qalbe manjiiinxa ege'neeki Mageni no'aa uwweemmashanni insa'ne'aanna woyyichcha Hafuura uwwati insa'nee ifike assedheexxa kokeesse'een. <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />Insa'nexxa qalbe amanat luqqi assati no'oxxe'ninna insa'nexxe oddo'n gargarunte assebaan, <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />Mayeeta annuwwi no'okinna no'o ba'edha dandeennebe'noka qanbara hordofeeyyetixxe quce hana ba'issati mayee ta'a Mageno hega uudinna? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />No'onna anjiremeennek insa'neshshanni Gootta Yessuusike badhaadhinnite kaddeexxa amanaannen.»<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />Bukki hiyyeemmak manninna tennee yaane duuchcha Bernabaasinna Phawuloosi Mageni insa'ne ga'mii'ni Ayihudake kadebaake mannixxe oddo'ni asseeka mambe'anna beessiisa duuchcha haasonnaa wodda ca'li hiyyee caqasa'neemman. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />Lamingi haaso'a birree wodda Ya'iqoobi hiyyee qici: «Anke dayyuwwa hiyyaannexxa laqqe <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />Mageni Ayihudake kadebaake manninaa'n ifi'a kadaaka arda ediseexxi hitta fi'leexxa Simi'ooni no'o'aa barrise'een. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />Konne yaadinni welti wabeekotik hiyyichchi weli'aagaan; isinna hiyyemmeexxi borreessemmeemaa qici,<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />« ‹Ookkonneechchchi uduma illee iima higennexxi</para>
  <para style="q2" vid="ACT 15:16">Ibeeka Daawwitika duunkaana ijaarannoni;</para>
  <para style="q1" vid="ACT 15:16">Isixxa olenna qammalchaannexxi</para>
  <para style="q2" vid="ACT 15:16">haaroba isoo uurrisannon.<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />Tinninna wele getteexxi manjiinxi sanne Gootta halsitaashsha</para>
  <para style="q2" vid="ACT 15:17">summa ankenni ye'emeek gosa gosak ardi duuchchi anee halsaashshaten;</para>
  <para style="q1" vid="ACT 15:17">Hiyya'neen tennee yaanuwwa assaa'neek Dada Duuchchik Gootti;›<verse eid="ACT 15:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ACT 15:18" />yaannuwwatanna olminaa'n ege'nisheek Gootti.<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />«Tennexxe ank yaadi Mageniibaa higeeka Ayihudake kadebaaka manna rakkinsabe'noshshaten. <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />Tenne irra dharchcha mogeni'a tolcheendeexxa ita ittinoqqe'e, Yabaabulletenaa'ni bayyette, gorra'emebaak reyeeka hore biniinchiinka maala ittinnoqqe'e, mundetanna ittinoqqe'e hineennexxi insa'ne'aa borreessa no'oo hassissaan. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />Tinninna kaddaachchi Muusek seeri olminaa'n Edi Edi Sanbata'n Ayihudiinke magenoonfachchotike mine'n haasessemma'ninna qachcha qachcha'ninni lalabemma'n hedheemmaxxeten.»<verse eid="ACT 15:21" /></para>
  <para style="s1">Ayihudake Kaddebaaxxe Eettene Amaanye'a Ergemeeka Borreessa</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />Ookkonneechchi uduma ergameeyye, geedhetinna amaanye duuchchi mitteba bukki hiteexxi insa'ne giddii'n manna filde'e Phawuloosinninna Bernabaasinni welti Antsookiyake qachchiba'a ergito'aa mudhdhite; insa'nenna amaanyet giddii'ni akeekisanjuwwake kadeeka Bersiyaan hiyyemeeke Yihudanna Sillaasitemman.<verse eid="ACT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 15:23" />Borreesakanna borreesineexxi insane'n ergine; boorreesi iikkinna hiyyaamma qici, «No'o ergameeyye, geedhetinna ha'nook dayyuwwi Antsookiya, Sooriyanna, Kilqiya hexxineeke Ayihudake kaddinebaake no'oke dayyuwwi'a nage'a shiqinshaannen. <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />No'oxxe oddonaa'ni mitti mitti manni no'oo insa'nee ajanjebe'nong ha'noba'a dageexxi ha'no'n barachchiiseexxe yaannenni ha'noo rakkiseexxi mekki asseexxa lanqeennen. <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />Tennexxee mitteba bukki hinennelchinni uduma ergeme dagaaka manna fillennexxi eeyyemeeka no'oka dayyuwwa Bernabaasinninnaa Phawuloosinni welti ha'noobaa erginonna'a weli angeennen. <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />Barinnaabaasiinna Phawuloosii Gootta Yessuusi Kiristoosixxe huje'a hedho ifixxa sa'isseexxi uwwe'eeke mannan. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />Murreennexxi borreesinennexxa yaane afo'ikinna ha'noo'ni kullaashsha Yihudaanna Sillaasii'i ergineennen. <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />Konnechchi butta hedheeka hasisaake seera kadoole malee wele hauritaaxxa ba'o ha'noo'ni ba'insaabe'noshsha Woyyichchi Hafuurinna no'oo weli'aangeennen; tinninna <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />Dharichchi mageni'a tolchendeexxa ita itinoqqe'e; gorra'emebaak reyeeka hore biniinchika maala itinoqqe'e; mundetanna ittinoqqe'e; yababulletenaa'ni bayyatte; tenne yaane duuchchanaa'ni ifi heqqeexxinoole eloxxenni; nage'ik hedhdhe.»<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />Iikki ergemeemmaki manninna geegeseme'e Antsookiya'a me'eexxi amaanye bukki aseechchi uduma ookkonee borreesa insa'ne'ni uwwe. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />Amaanyeteinna ookkonee borreesa haasessitee wodda isi sa'iseexxe jajabeessitaaxxe erga'ni lumooshsha gammadde. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />Yihudanna Sillaasi wabeekote kandeemmaxxee heddo haaso'inni eettene amaanye gorsineexxi jajjabeesine. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />Shiixxoxxa barranna ookko turreechchi uduma amaanyeti dayyuwwi nage'ik insa'nee geegesinee'naa insa'nee ergemmake mannibaa illee iima hinge.<verse eid="ACT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 15:34" />Sillaasi kinni ookkonni gato'a mudhdhe.<note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="ft" closed="false">Mitti mitti olmik borreessuwwi konne laakkosika hiyyicho afeba'a</char></note> <verse eid="ACT 15:34" /><verse number="35" style="v" sid="ACT 15:35" />Phawuloosinna Bernabaasi wele heddo amaanyenni welti Goottiinka hiyyichcho barachiinsa'ninna lallanba'n Antsookiya offolle.<verse eid="ACT 15:35" /></para>
  <para style="s1">Phawuloosixxanna Barinnaabaasixxa Gargar Higa</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />Heenooxxe barra udumi'a Phawuloosi Bernabaasii'i, «Amo konnechchi edo Goottiinka hiyyichcho lallanbenneke qachchuwwi duuchchibaa illee iima hingennexxi amaanye dayyuwwi maye'n hedheexxa uundo» hiyye. <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />Bernabaasinna Maariqoosi hiyyemeek Yohaannisi insa'nenni welti me'aashsha hase. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />Phawuloosi kinni kunni manjichchi insa'nenni welti me'aaxxa eeyyebaan; eeyyagibeechchinna isi Phinfilya giddo insa'nenaa'n gargar higeexxi gateemmaxxeenna hujetibaa insa'nenni welti muuxamii qico'n me'aa gopheemmaxxeeten. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />Tennenaa'n kexxeexxa insa'nexxe oddo'n jabaxxi weli aaggo gonphe kexxee'naa welinaa'ni gargar hinge. Tennexxee Bernabaasi Maariqoosii'i adhdheexxi markabik Qophphiroosi'a me'e. <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />Phawuloosi kinni Sillaasii'i fi'le; amaanye dayyuwwinna Phawuloosii'i Goottiinke badhaadha'n maganne uuneechchi uduma ke'e me'e. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />Phawuloosinna Mageniinxa tuuta jajjabeessa'n Sooriyaa'ninna Kilqiya giddii'n sa'e.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s1">Phawuloosinninna Sillaasinni Welti Ximootoosixxa Me'a</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />Phawuloosi Derbeke qachcha'ninna Lisixxiraanike qachchibaa me'e; Lisixxiraanike qachchi giddonna Ximotoosi hiyyemaake amaanyichcho hedhemman; ama isixxinna amaanye Ayihudichchomman; anni isiki kinni Girkiichchokemman. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />Ximootoosi Lisixxiraanike'ninna Iqoniyoonike amaanye dayyuwwa duuchcha'ni eloke summa afe'eemmani. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />Phawuloosi Ximootoosii'i adhdhexxi me'aa haseemmaxxee iso'o jila ofo'lishshe. Tennee asseechchinna ookkone booncho'ni hedhemmake Ayihudiinke mannixxe buuto'aten. Tinninna Ayihudiinki manni Ximootoosiki anni Girkiichchoke kadeexxa egenneemmaxxeeten. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />Phawuloosinna Sillaasi qachchakenaa'n qachchinba'a me'inaamma wodda Iyyerusaalemi hexxeexxi ergameeyyenna geedhe murtemmaka seera amaanyete'n ege'nisha'nemman; hujete'n hosinso'aanna xexxeachchinsa'nemman. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />Tennexxee Mageniinxi Tuuta amaanyummate'n jajjabata'ni me'ite; laakkoossi insa'neekinna barra barrande'n lebema'n me'e.<verse eid="ACT 16:5" /></para>
  <para style="s1">Phawuloosi Meqedooniyake Manjichchixxee Uudeexxa waleella</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />Phawuloosinna Sillaasi Issiyake boga'ni hiyyichcho Mageniika kullabaashsha Woyyichchi Hafuuri insa'nee hoyyemmaxxee Firgiyakee'ninna Gelaatiyake bogi giddii'n sa'ne me'ine. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />Misiyake bogixxe gabalaba gennee wodda Bitaaniya'a me'ino'a wo'lanneemma; yaane kinni Yessuusik Hafuuri me'inabaashsha asse. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />Tennexxee Misiya darree'n sa'neexxi adadde Xiro'aada'a me'ine. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />Eettene hashsha mitti Meqedooniyak manjichchi uurreexxi isoo, «Meqedooniya'a daggetexxi no'oo qarqaari!» hiyya'ni kadhataa'naa Phawuloosi waleellati uude. <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />Phawuloosinna tennee waleella uuddeechchi uduma Mageni wengeele insa'ne'n lallanbonna'a no'oo ye'eedhe'n hine mudhdhati hirbange'ni Meqedooniya'a me'a hansenne.<verse eid="ACT 16:10" /></para>
  <para style="s1">Filphisiyus Qachcha'ni Lidiyya Kirisitoosi'ni Amande</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />Xiro'aadaa'n markabake'n gulunfennexxi toggichcha ora Saamotiraaqe'a me'inenne; langaxxa barranna Naaphule'a me'innenne. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />Ookko'ni ke'neennexxi Filphisiyuusi gennennen. Filphiyusi Meqedooniyaxxe galchake umo qachchanna Roomik manni ifike baallomi hunda assedheexxi itti hedhammake qachchamman. Ookkonna heddo barra honseennen. <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />Edi Sanbati barranna soodachchotixxa bakka hasito qachchiinxe hullanaa'n fullennexxi mitte galaanibaa me'innen; ookkonna ofolleneexxi bukki hiteemmaxxe melaalle'n Mageniinka hiyyichcho haaso'aten ke'nenne. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />Haaso'a no'oka laqqaammaxxe melaallenaa'ni mitte Tiyyaxiroonike qachcha'n baddeesitte seemma daddaldaammaxxi Lidiya hiyyendaammaxxe manjichcho hexxemman. Isenna Mageno magenoonfattaammaxxe manjichchomman. Goottikinna wodana iseka baneemmaxxee Phawuloosi haaso'aammaxxa qalbeeffachchot laqqa'neemman. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />Isenna iseke mine'ni hedhdheek manni duuchchi xammaqemme. Xammaqemmeechchinni uduma isee «Goottake'ni amanaa anxa wo'mitineechchinni anke mine'ni daggine offo'le» hiteexxi jaba qico no'oo kadhatte.<verse eid="ACT 16:15" /></para>
  <para style="s1">Filphisuyusike Qachcha'ni Phawuloosixxanna Sillaasixxa Usurensha</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />Mitte barra soodachchotike boonchibaa me'inaa'naa mitte mini giddo ergatendaammaxxi jale belto orake'ni no'oo affe. Tinni belto heger kaddaaxxa yaane morotike hafuurinni raaga haasota'eexemman; isexxe moronninna ifike goottuwwi'a lumook maalaqi dagaashsha assitaamman. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />Ise Phawuloosinna no'oo hordofaa'n, «Kunni manni anigirematika ora ha'no'n kulaake duuchchiingenaa'n sa'aake Mageniinke erganjuwwan» hita'n cancita'nemman.<verse eid="ACT 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 16:18" />Tenneenna heddo barra higgeeggeenni haasota'nemman. Phawuloosi kinni hifateexxi udumi'a wirri hiyye'e konne fuggichcha hafuura, «Yessuusi Kiristoosike summinni isenaa'ni fuldattoshsha ajajaannen!» hiyye. Fuggichchi hafuurinna hirbaniga'n isanaa'n fule.<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />Tenne beltok goottuwwi maallaqa alfatixxi adde gateexxa uudee wodda insa'nenna Phawuloosiinna Sillaasii'i abinde harkinsa'ni dikkotiba galchatik manni hedheeba iyyemarre. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />Insa'neenna Roomake galchatik mannibanna iyyedangeexxi hinee qici, «Kunni manni Ayihudiinke mannan; qachcha no'okanna daassa'neeken. <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />No'o Roomik manni adhdhinabe'nokanna assinabo'noka galduma insa'ne barchiinsa'neen.» <verse eid="ACT 16:21" /><verse number="22" style="v" sid="ACT 16:22" />Ardi duuchchi mitteba higeexxi insa'ne'n ke'e. Arda ookkonee galchaammaki manninna Phawuloosinaa'ninna Sillaasinaa'n seemma fulchineexxi ganemmaashsha ajanje. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />Insa'neenna fuggo ganemmeechchi uduma usurrini mine'ni e'yinsheexxi usurrinke miniki heqqanji insa'nee xexxe'ate heqqaashsha ajanje. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />Heqqanji konne ajaja adhdheechchi uduma usurri minixxe giddixxe kuta'n insa'nee e'yishe. Lekka insa'neexxanna lame jirmixxe oddo'ni silli asse duudhe usure.<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />Hashsha wodhak geyyaa wodda Phawuloosinna Sillaasi soodanta'ninna faarsina'n Mageno galateefanta'nemman; weli usuremeemak manninna insa'nee caqasa'nemman. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />Dedhange'ni usurrinke minixxi booso sheke sheke hitaa qioc'n jaba qico buttinni lele'me; eettenne yanna usurriinke minixxi hula duuchcha banende; duuchchiing usurememmak haachchabinna tikeme. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />Usurriinke miniki heqqanjinna diiphokenaa'n dammaqeexxi usurriinke minixxi hula banende'naa uude wodda usurememmaki manni baajechcho fakkaatte'naa ifi shiyo'aa haseexxi wolaantichcha dobe. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />Phawuloosi kinni canica'n, «No'o duuchchiingi kabanni he'nenenn; mitte miidhenshanna ifi'ni geessissoxxe'e» hiyye.<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />Heqqanjikinna xassa iyyedagiseexxi gonga'ni giddi'aa e'ye; roqonsaa'ninna Phawuloosixxenna Sillaasixxe lekka edo wabbi hiyye. <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />Insa'nenna gadhdhi'a fulcheexxi insa'nee «Goottuwwaa! Anjiremona'a ani maassa hasiissa?» hiyyexxi qore. <verse eid="ACT 16:30" /><verse number="31" style="v" sid="ACT 16:31" />Insa'nenna «Gootta Yessuusi'ni aman anjirendatton; atik mini hadinna anjiremaan» hine. <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />Mageniinka hiyyichchonna isi'aannaa isike mine'ni hedheeke duuchchi'a kulle. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />Eettenne yanna hashshati iikki uusurriinke miniki heqqanji insa'nee adhdheexxi me'eexxi mada insa'nexxa anshe; iikki woddi isinnaa isik mini hadi duuchchinni welti xammaqeme. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />Ifike mi'ne'ninna iyyemareexxi ita insa'ne'a shiqishe; Mageno amanemmaxxeenna ifike mini hadi duuchchinni welti lumo qico gammade.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />Boginna soodee wodda iikki boga galchammak manni «Konne manna tikke wocci assi» hiyya'n ifika ja'laabuwwa ookkone usurriinke minike heqqanjo'n erge. <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />Usurriinke miniki heqqanjinna «Ha'noo wocci assendinaashsha galchalluwwi ajaje'een; yoona fuldineexxi nage'iki me'e» hiyya'n Phawuloosi'ni kule. <verse eid="ACT 16:36" /><verse number="37" style="v" sid="ACT 16:37" />Phawuloosi kinni insa'nen, «No'o Roomi bogike manna kandanno wodda seeri belo no'oo ardii edo jadhanfeexxi usurrii mine'ni e'yinsheen. Ta'a kinni sho'ik usurrii minenaa'ni no'o fullannoshsha assinaata? Tinni kaddabaan; insa'ne umo insa'nengenninni dangeexxi no'oo fulchinowwaal.»<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />Iikki ja'laabuwwinna tenne yaane ookkone boginke galchalluwwa'n kulle; insa'nenna Phawuloosinna Sillaasi Roomi bogike manna kandeexxa egennee wodda sodaante. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />Tennexxee dangeexxi insa'nee gattowwaali'i lanqe; usurrii minenaa'ninna insa'ne fulchineenaa qachchakenaa'ni fullee me'inaashsha insa'nee kadhante. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />Phawuloosinna Sillaasi usurrii minenaa'ni fuleexxi Lidiyake mine'n e'yine; ookkonna amaanye dayyuwwa anfeexxi insa'nee jajjabeessineechchi udumanna me'ine.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s1">Phawuloosinna Sillaasi Teseloonqeke Qachcha'n</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />Phawuloosinna Sillaasi Anifiphoolisi'ninna Aphpholooniya giddii'n sa'neexxi Teseloonqe marre; ookkonna Ayihudiinke magnoonfachchotike mine hedhemman. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />Phawuloosinna baratemmashanni ookkone Ayihudiinke magnoonfachchotike mine'n e'yeexxi weli duuka sase Edi Sanbaatuwwi'a Woyyichcha Maxaafanaa'n bariissa'n ardakee haaso'e. <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />Kiristoosinna rakko adhdhiyyo hasissaaxxanna reyotenaa'ni ke'a hasissaaxxa ifisa'n «Kunni ani ha'no'n lallabaannek Yessuusi isi Kiristoositen,» hiyya'nemman. <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />Mitti mitti Ayhudik manni laqemmaka konnee haaso'a adhdhiyyoti Phawuloosinninna Sillaasinni welti mitteba hinge; iittanni Mageno magenoonfataammaki heddi Girkeek manninna ege'nendeexxi heenobaaxxi melaalle haaso'a konne adhdhiteexxi insa'nenni mitteba hinge.<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />Ayihudiink manni kinni gaabbeexxi, baashe manna dikkotenaa'n bukki assine qachchi giddo weekensha ke'issine; Phawuloosinna Sillaasi'i iyyedangeexxi ookkone arda'n shiqishatee Iyyasoonike minibaa mudamma'n me'ine. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />Yaane kinni insa'nee afa dandeeneba'a; tennexxee Iyyasooninna wele amaanye dayyuwwa ookkone qichchike baallomike mannibaa harkisa'n «Kunni butta duuchcha daasseki manni ta'a no'oba dage'een. <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />Iyyasooninna insa'nee ifike mine'n adhdhe'een; insa'nenna, ‹Yessuusi hiyyemaak weli moyanji hedheen› hina'n Qeesaarika ajaja xaa'nina'neen.»<verse eid="ACT 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 17:8" />Ardikinna qachchiinke baallomik manni tenne laqee wodda raanke. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />Iyyasooniinna ookkone wele manna waase ye'inseexxi wocci assine.<verse eid="ACT 17:9" /></para>
  <para style="s1">Phawuloosinna Sillaasi Beeriyaake Boga'n</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />Iikki woddi amaanye dayyuwwi Phawuloosinna Sillaasi'i hashsha Beeriya'a me'inaashsha asse. Ookkonna gennaa wodd, Ayihudiinke magnoonfachchotike mine'n e'yine. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />Beeriyya hedhemmak manni Teseloonqe hedhemmake manni irra wodani insa'neek banemeeke kadeemmaxxee hiyyichcho Mageniinka araada'emman; konnee Phawuloosi kuleeka Magniinka hiyyichcho kokeesatee barra barrande'ni Woyyichcha Maxaafa qo'nisa'emman. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />Tennexxee insa'nenaa'n heddi manni amane; iittanni insa'nen welti egenendeexxi Girkeexxi melaallenna heenoobaak Giriikik labballi amane. <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />Teseloonqe hedhemmak Ayihudiink manni kinni Phawuloosi Beeriyake boga'ni Mageniika hiyyichcho lallabeexxa egeenee wodda manna tirtirsina'ninna loli ke'aashsha assina'n ookko'a me'ine. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />Ookkone wodda amanye dayyuwwi rakeexxi Phawuloosi abbaayyati qarqari'a me'aashsha assine. Sillaasinna Ximotoosi kinni ookko Beeriyaanni gante. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />Phawuloosi geegesseeki manni Ateena qico'ni isoo geessise. «Sillaasinna Ximotoosi rankeexxi anba'a dangowwaal» hiyyaaka Phawuloosika ajajika dhaansa aa'neexxi Beeriya'a illee iima hinge.<verse eid="ACT 17:15" /></para>
  <para style="s1">Phawuloosi Ateennake Qachcha'ni</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />Phawuloosi Ateena hedheexxi Sillaasinnaa Ximootoosi'i heqaa'ni qachchi giddo magoonfachchotixxi fakkuwwa wo'miteexxa uudee wodda irri isoo jinne. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />Tennexxee is Ayihudinke magenoonfachchotike mine'n Ayihudiinke mannininna Mageno magenoonfatammake wele manninni welti, ittanni dikkotixxe bakka'n barra barra'n afemammake manninni welti haaso'a'emman. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />Epikurositonna Istoyikooto hiyyemaake beekkumike manni giddii'n mitti mitti isiba'a dangeexxi insa'ne moroma'emman; mitti mittikinna «Isi kunni maa hiyya'n lallaba'neechcho?» hiyyaa wodda, weli kinni, «Haaroke magenuwwixxe yaane haaso'a'neeke labaa'neen» hiyya'emman. Tenneenna hineechchi, Phawuloosi Yessuusixxeenna reyotenaa'n ke'atixxee eloxxa odo lallabemmaxxeeten. <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />Ariyoosifagoosi hiyyemaake booncho'ni Phawuloosi'i aa'nee mareexxi «Tinni ati barachchiisaetexxi tinni haarooxxi barachchiisa maachcho kadeexxa egennonnaa hansaannen. <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />Mitte mitte haarooxxe yaane no'o'n laqisaa'eten; tinni yaanuwwa maachcho kaddeexxa kinni egennonnaa hansaannen» hine. <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />Tenne hineechchi Ateenak manninna Atena giddo hedhaak alagi manni duuchchi yanna ifixxa sa'isinaammak harooxxa yaanexxee haaso'iyyotitenna laqiyyotite malee wele yaane'nite'n kada gopheemmaxxeten.<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />Ookkone wodda Phawuloosi Ariyoosifagoosi bukki hiyyeeke manni edo uurreexxi hiyyee qici: «Ha'noo Ateenake manna! Duuchchinni ga'mi'ni magenuwwa magenoonfachcho eettina'neeke manna kaddineexxa uuda'ennen. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />Tinninna, ani ha'nooke qachcha'ni mammareemma'n ha'noo magenoonfatina'neechchuwwa uudennee wodda, ‹Ege'nemebaake Mageni'a› hiyyeme borreessemeeka tolchimalcho afeennen; Yoona, ta'a ani ha'no'aa kulaannexxi hano konne egendinebaangi magenoonfatina'neeke Magenixeeten. <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />Isi butta duuchchanna buttate'ni hedheechcho duuchcha dadeeken; isi iimikinna buttiki Gootti manji ijaareeke galmuwwa'n hedhabaan. <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />Hedhotanna hafuura, wele yaane duuchchanna manji duuchchi'a uwaake kadeemmaxxee mitte yaannenna isi'a xe'yitaaxxi hedha gopheemmaxxe manjiinxe angak gargaarsi isi'a hasisabaan. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />Isi manjiinxa sanne duuchcha mitte manjonaa'ni dadeexxi boga duuchcha'ni he'naashsha asse; he'naake barrixxa qixxenna he'naaka boonchuwwa insa'ne'aa mure. <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />Tenneenna asseechchi, manni Mageno halseexxi, akimagaada isoo alfa dande'ashshaten. Kaddo malee Mageni mitte mitte no'ongenaa'ni bayyate'ekebaan. <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />Tinninna kaddeechchi ha'noki meelliinke manni giddii'n mitti mitti ‹No'onna oose isixxen› hiyyemmashsha, ‹no'o hedho alfineennek, lele'minannekinna he'nennek isinnite kaddeemmaxxeeten› hine.<verse eid="ACT 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29" />«Yoona no'oo isixxe oose kandeennechchinni Mageni manjiinxe angaxxe oggenninna heduminni hujendeexxe worqexxa, yookaan birretik sibljixxa, yookaan kinjijiinxa misile fakkaataan hine no'o hediyyo hasissabaan. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />Yoona Mageni iitta hedheeka haakitinka baro ossunteti sa'edheen; ta'a kinni boga boga duuchcha'ni hedheeki manni duuchchi aadde aagaashsha ajajje'een. <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />Isi fileeke manji darree'n buttike manjo duuchcha'ni dhugaatixxa murte muraaxxa barra mudhe'een; isoonna reyotenaa'n ke'issat manjo duuchcha'n tenne kokeesse'een» hine.<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />Reyotenaa'ni ke'ate hiyyemeeka haaso'a lanqee wodda mitti mitti gacifate; weli kinni «Konne yaada wele barra langaxxa haasote'na'a lanqoona'a hansa'ennen» hiyye. <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />Eettene yanna Phawuloosi eettene bukki giddii'ni fuleexxi me'e. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />Mitti mitti manni kinni Phawuloosi hiyyeexxa adhdhate amane; amaneeke manni giddii'n Ariyyosifaagoosixxe tuutaxxe gamo kade'emmak Diyonasiyoosi hiyyemaak manjichchinna Deemaarisi hiyyendaaxxi manjichchonna wele manninna hedhemman.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s1">Phawuloosi Qorontoosike Qachchi Giddo</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />Ookkonneechchi uduma Phawuloosi Ateenake qachchanaa'ni fuleexxi Qorontoosi'a me'e. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />Ookkonna Phanxoosike bogika Aqila hiyyemaaka mitte Ayihudichcho afe, isinna Roomik lumok moyanji Qelaawudewwoosi, Ayihudiink manni duuchchi Roomike qachchanaa'n fulaashsha ajajemmaxxee Aqila are ifixxe Phirsiqilanni welti reefi Ixaaleyiinke boganaa'n dangeemman. Phawuloosinna insa'ne'e uudo'a mare. <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />Phawuloosixxi huje insa'neshshanni duunkaana gobate kaddeemmaxxee insa'nebaa hedha'ni insa'nenni welti huja'nemman. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />Edi Sanbati Sanbati baro Ayihudiinke magnoonfachchotike mine'n afema'n Ayihudiinkanna Girkeeka manna amannaashsha assate wo'lana'nemman.<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />Sillaasinna Ximotoosi Meqedooniyanaa'n dangee wodda Phawuloosi «Yessuusi isi Kiristoositen» hiyya'n Ayihudiinke manna'n cichche lallaba'n yanna ifixxa duuchcha barsiisate'n sa'isa'nemman. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />Ayihudiink manni kinni Phawuloosi'i gareeree yowwe wodda seemma ifixxa hargulfa'n «Yoona gibineexxenni ha'no'n geltaxxe yaane duuchchi laaqendinaak hano'nden; ani laqemannoxxi yanne hexxeba'a; yoona ta'inni edi'a Ayihudake kadebaake manniba'a me'annon» hiyye. <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />Ookkone boonchonaa'n fuleexxi Ayihudiink magenoonfachchotike mini bira hedhemmake Titosi Iyyosixxoosi hiyyemaake manjichchike miniba'a e'ye. Kunni manjichchi Mageno magenonfatammakemman. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />Qersiphoosi hiyyemaaki Ayihudiinke magenoonfachchotike minik sooresi ifike mini hadi duuchchinninni Goottake'ni amane. Heddi Qorontoosik manninna Phawuloosi haaso'aa wodda laqe amaneexxi xamaqeme.<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />Mitte hashsha Gootti Phawuloosi'n waleellati, «Mee sodaat haaso'i malee ca'li hitooxxe'e!» hiyye. <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />«Ani atinni welti hedhennaxxee ayyinna ate'n ke'eexxi miidhensha ate'n geessisaak hedhebaan; ani konne qachcha'n heddo arda afe'ennen» hiyye. <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />Tennexxee Phawuloosi Mageniinka hiyyichcho ardake'n barsiisa'ni mitte wogganna gamisa ookko ture.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />Galiyoosi Akkaayiyaaka boga galcho'a hariiremee wodda Ayihudiink manni mitteba higeexxi Phawuloosi'ni ke'e; murtetixxe songobanna iyyemareexxi, <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />«Kunni manjichchi seeri uwwabaake orinni manni Mageno magenoonfantaashsha assa'neen» hine. <verse eid="ACT 18:13" /><verse number="14" style="v" sid="ACT 18:14" />Phawuloosi haaso'o'a qixxeefateeke'n Gaaliyoosi Ayihudiinka manna hiyyee qici, «Ha'no Ayihudiinke manna ku'la ha'nooxxi hujendeexxe balleessatixxe yookaan wonjalinxeete kadde'ele ossunteti caqasannan. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />Yaane kinni ha'noxxi moronsha hiyyichchuwwiinxe, summuwixxeenna ha'noke seerixxee kaddemmaxxee ise ha'no birre; ani iitta hexxeexxe yaane'ni murte muronna'a hasabe'non» hiyye. <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />Tenne hiyyechchinni uduma insa'nee murtetixxe songo edii'n fulche. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />Eettene yanna insa'ne duuchchiingi Soositensi hiyyemaaka Ayihudiinke magenoonfachchotike minika sooresa abindeexxi songoti edo ganne. Iitta assinna wodda Gaaliyoosi mittechchishshanna uudebaan.<verse eid="ACT 18:17" /></para>
  <para style="s1">Phirsiqila Aqilanna Aphiloosi'i</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />Phawuloosinna heddo barra Qoroontoosi ofo'le; ookkonneechchi udma amanye dayyuwa'n «Nage'ik hedhdhe» hiyyeexxi Phirsiqilanninna Aqilanni welti lumoxxe hobolonni Sooriya'a me'e; wereegeek wereeg hedheemmaxxee Kinkira'oosi hiyyemaake booncho'n umo haaxxe. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />Efesoonika qachcha gennee wodda Phirisiqilanna Aqilaa'a ookkonni waale. Isi kinni Ayihudotinke magenoonfachchotike mine'ni e'yeexxi Ayihudiinke manninni welti haaso'a'nemman. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />Insa'nenni welti qeerraaxxa yaana turo'a kadhantee wodda isi eeyyeba'a. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />Yaane kinni «Mageniinxe fedhii kaddoole wele wodda ha'noba'a illee iima higeeneexxi dagannooni» hiyye. Ookkonechchi uduma lumoxxe hobolo'ni ofo'leexxi Efesoonii'n fuleexxi me'e.<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />Qiisaariya geyyechchi uduma ookko'ni Iyyerusaalemi mare; amaanye nage'a aadheechchi uduma illeema higeexxi adadde Antsookiya'a me'e. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />Ookkonna shiixxoxxa yanna tureechchi uduma ookko'n ke'eexxi Gelaatiyakenna Firgiyake boguwwi giddo mitte boonchinaa'n mittinba'a mammarema'n hordofeeyye duuchcha jajjabeesse.<verse eid="ACT 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />Isikindiriyake qachchik ilemeek Aphiloosi hiyyemaake Ayihudichchi manjichchi Efesooni'a dage. Isi barateekenna Woyyichcha Maxaafixxa qunxu asse ege'neemmakemman. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />Kunni manjichchi Goottiniinka ora barateek, Yessuusixxee toggi asse haaso'ammakenna ifinge irrinni barsiisa'emmakemman; kaddo malee isi ege'nemalchi Yohaannisixxe xamaqa callamman. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />Ayihudotinke magenoonfachchotike mine'ninna soda'a belo haaso'ate'n ke'e; Phirsiqilanna Aqila isixxa lanqee wodda kinni ifike mine'ni adhdhine me'ineexxi Mageniinka ora edi irra toggi assine iso'n ifinse. <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />Aphiloosi Akkaayiyaa'a me'o'a hedee wodda amaanye dayyuwwai isoo jajjabeese; ookko hexxeexxi hordofeeyye isoo eloo qico adhdhi taashshanna borro isi'a borreesinne.</para>
  <para style="p" vid="ACT 18:27">Isi ookko mareexxi geyechchinni uduma Mageniinke badhaadhinni amaneeka manna lumo qico gargaaremman. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />Tinninni kaddeechchi, woyyichchi maxxafinaa'n hiyyichcho ifisa'n Yessuusi, isi Kiristoosite kadeexxa Ayihudiinke manninni jaba qico moroma'n insa'nee injifata'emman.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s1">Phawuloosi Efeesoonike Qachcha'ni</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />Aphiloosi Qorontoosi hedhema wodda Phawuloosi alike bogi giddii'n sa'eexxi Efesooni'a dage. Ookkonna heenooxxa hordofeeyye afeexxi <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />«Amandinee wodda woyyichcha Hafuura adhdhitineema'a?» hiyyeexxi insa'ne qore. Insa'ne kinni «Waawo'o, Woyyichchi Hafuuri hedheexxa midde lanqe'e egenebe'non» hine hiisine haasonne.<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />Phawuloosinna «Heene xammaqemanni xammaqendineemmata?» hiyye qore; Insa'nenna «Yohaannisixxe xammaqanite» hineexxi hiissine haasonne.<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />Phawuloosinna «Yohaannisixxi xammaqa aadde aagatixxe xammaqamman; Yohaannisi ardake'n, ‹Ani udumi'a dagaake'n amanne!› hiyya'emmam; isinna Yessuusiten» hiyye.<verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />Tenne lanqee wodda Gootta Yessuusike summinni xamaqemme. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />Phawuloosi anga ifixxa insa'ne hana uggee wodda woyyichchi Hafuuri insa'ne hana dirree'naa wele laagadinni haasonne; raagakanna haasoonne. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />Iikki manninna tommenna lamii qicomman.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />Phawuloosi Ayihudiinke magenoonfachchotike mine'ni e'ya'n Mageniinxe mootummaxxee inse'nee moroma'ninna amanichchiinsa'n sase agenjo duuchcha soda'a belo haso'nemman. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />Yaane kinni mitti mitti murumi hiyye amanaake kadeexxi Goottiinke ora ardi edo boshshina'emman; tennexxee Phawuloosi insa'nenaa'ni gargar hige me'e; Hordofeeyyetanna qofitinni adhdheexxi Xiraanoosike barachchotike galmi giddo barra barra'n insa'nee barsiisa'n insa'nenni welti haaso'a'emman. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />Phawuloosinna tenne iitta asseek lame wogga'nitemman; tennexxee Issiyake aurajja'n hedheemmake Ayihudikinna Girkeek manni duuchchi Goottiinka hiyyichcho laqa dandeenne.<verse eid="ACT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />Magen Phawuloosixxe anga'n maso mambe'uwwa huja'nemman. <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />Tennexxee Phawuloosika biso tuqqeexxa seemmanna maarrabe ela gepheeke manna'n iyyemarraa wodda iikki ela gophpheeki manni dhukubakenaa'ni fayyya'nemman; fuggichchi hafuuruwwinna insa'nenaa'n fulaa'nemman. <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />Fuggichcha hafuuruwwa fulcha'ni booncho booncho'n maremaammake Ayihudiinke manni giddii'n mitti mitti, «Phawuloosi lallabammake Yessuusike summinni fuldinaashsha ha'noo ajanja'ennen» hiyya'ni fuggichcha hafuuruwwa mannakenaa'n fulchatee wo'laana'nemman. <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />Ayihudiinke umo qeesichcho kadeeke Asiqewwaxxi labbaxxi torbaane oosenna tennende assitaamman. <verse eid="ACT 19:14" /><verse number="15" style="v" sid="ACT 19:15" />Fuggichchi hafuurinna, «Yessuusi ege'neennen; Phawuloosinna ege'neennen; ha'noo kinni ayeera?» hiyye.<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />Fuggichcha hafuura afeemaki manjichchi insa'ne'ni utaale hudhe abideexxi duuchchinga injifate. Insa'nenna maddoneexxi duuwwinni minii'ni baanje fulle. <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />Tinni yaane Efesooni hedhemmake Ayihudiinke manna'ninna Girkeeke manna'n laqendee wodda duuchchiinge'n soda'a galde. Gootti Yessuusik summinna lumo qico ulfeesseme. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />Amanyet giddi'ni heddi manni dagga'ni hujemmaxxa ifixxa cubbo ifise faaci'a'n danga'emman. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />Heddi moraamaak manni morotika ifi ifika maxaafuwwa bukki assine iyyedangeexxi ardi edo giirate'n gube. Ookkone insa'neke maxaafuwwi hir hedemaa wodda onde tomme kuma birret sibljo kade. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />Konne qicinni Goottiinki hiyyichchi hunnati ba'lata'ninna injifata'n me'a'nemman.<verse eid="ACT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />Tinni duuchcha kadeechchinni uduma Phawuloosi Meqedooniyaanii'ninna Akkaayiyaa giddii'n sa'eexxi Iyyerusaalemi'a me'o'a irrik mudhdheexxi «Ookko geyeennechchi uduma Roomika qachchanna mare uuda anee hasissaan» hiyye. <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />Tennexxee ifike erganjuwwinaa'n lame Ximotoosinna Erasixoosii'i Meqedooniya'a ergeexxi isi ifi'a Issiyake awuraajji giddo shiixxoxxa yanna ture.<verse eid="ACT 19:22" /></para>
  <para style="s1">Efesoon Giddo Kaddeexxa Weekensha</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />Eettene yanna Goottiinke orixe buuto'a jabaxxi weekensha kexxe. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />Dimexiroosi hiyyemaak birretika sibljo tumaammak manjichchi Arxemisike galmixxa misile giissa'n tumammake manni'a yo'osha lumooxxa la'o afisa'emman. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />Tennexxee kunni majichchi kone tumammaka mannanna tenne labbaaxxe wele huje'n bobba'eeka manna bukki asseexxi hiyyee qici, «Koo manna no'o maallaqa alfinaannek tenne hujennite kaddeexxa egendine'een. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />Phawuloosi hiyyema'neek kunni manji ‹Manjiinxi anga hujjeexxi misiluwwa magenuwwakebaan› hiyya'n Efesoonike qachchi giddo calla kaddebaangi heenooko bogi gadhi darre malee Issiyake awuraajja duuchcha'ni hittee qico arda barachchiise dedhiseexxa ha'no umo ha'nongenninni uudineexxenna laqqineexxen. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />Tenne huje no'oxxik elok summi ba'a calla kaddebaak Issiyake auraajji duuchchinna butta duuchchi isee magenoonfanta'neexxi Lumoki Arxemisik galmi tola gataake kadaan; iittanni isek ulfinninna tola gataan.»<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />Mannikinna tennee laqee wodda mufateexxi, «Efeesoonixxi Arxemisi lumoxxen» hiyya'ni cance. <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />Iikki qachchi duuchchi weekeme; ardikinna Meqedooniyake bogika manna Phawuloosinni welti me'a'emmaka isika jaaluwwa Gayiyoosinna Arsixirokoosii'i, abinde'e harkinsaa'ni ardi bukki hiyyamma boonchi'a gongine. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />Phawuloosinna umo ifingenninni ardiinbaa maro'a hassee wodda hordofeeyye marabaashsha isoo hoyyite. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />Phawuloosike jaaluwwa kade'eeke Isiyyake bogike akeekisanjuwwanaa'ni mitti mitti manjo ergine, «Iittanna ookkone geebo da'wantammaxxe bakkaba'a marabaashsha» Phawuloosii kadhdhate. <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />Ardiinxe oddo'n raanki lumook hedhemmaxxee bira sa'aak manni mayye'e ookko bukki hiyyemannixxa egenemmaba'a. Mitti, mitte yaane hiyya'ni cancaa wodda, weli wele hiyya'nee canca'emman. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />Ayihudiink manninna Isikindir ardiinxe oddonaa'n dhiibeexxi edi'a sa'issee wodda ardi giddii'n mitti, isi insa'nee'a haaso'aashsha cancine; isinna insa'ne'a moromo'a haseexxi insa'ne sammi hino'a angati qiphe. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />Yaane kinni Isikindiroosi Ayihudichchoke kadeexxa ardi duuchchi ege'nee wodda «Efeesoonixxi Arxemisi lumooxxen» hiyya'ni lame saate qico'ni duuchchingi mittenba cance.<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />Udumi giddii'n ookkone qachchiinke umik borreesanji ke'eexxi arda sammi asseexxi hiyyee qici, «Ha'no Efeesoonik mannaa lumoxxe Arxemisik galminna iiminaa'n daggeexxe isixxe misilek heqanji Efeesoonke qachchike arda kadeexxa ege'nebaaki aayyete hedhe? <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />Tenne'e ayyinna moromaak hedha gopheexxenni, ta'a ha'noo sammi hitinaashshanna mitte yaanenna wiinamik assatenaa'n ifi heqqedha ha'noo haasissaan. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />Galma saamebaakanna no'oke mageno Arxemisi'n yowwichiinka afo'o fulchedhebaaka manna abidine kaba idagineen. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />Dimexiroosinna isinni welti hedheek tumatixxe ogek manni ayye'ninna ku'la afeexxe kaddoole murttek minni banake; baaloomiiki manninna hedheen; ookkonna ku'la dandenaan. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />Tenneeri gadhi darre shiqishino'a hasina'neexxi wele yaane hexxeexxe kaddoole isee ardinxe songo'n uudendaan. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />Iittate kada gophphoole telcho kadeexxe weekensha buutoxxe ku'lemanno hinee sodaantanon; tinni weekensha mayee kadde hiyyemme qoremmonnole buutote kadaaka godisaaka yaada afa gonphaannaxxee geyaaka hiissichcho hiissa dandeennabe'non» <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />Tenne hiyyeechchi uduma ookko bukki hiyyeemmaka manni xeeremmaashsha asse.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s1">Phawuloosi Meqeedoniya'anna Girike'aa Me'eexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />Canci iikki ca'li hiyyeechchi uduma Phawuloosi hordofeeyye mitteba ye'eexxi insa'nee goorse; «Nage'ikinna hedhdhe» hiyya'n Meqedooniya'a me'e. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />Ookkone giddii'n sa'emmake boonchuwwa'n ardakee heddo hiyyichchinni gorsa uwwa'n Girkeka boga geye. <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />Ookkonna sase ageenjo ture; lumoxxe hobolo'ni Sooriya'a me'o'a qixxeefataa wodda Ayihudiink manni iso'n fuggoxxa asso'a mari'atee hedhemmaxxa ege'nemmaxxee Meqedooniya darree'n sa'eexxi illeema higo'a mudhe. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />Phiirhuusik belti Soophaxiroosi Beeriyake qachchanaa'n, Arsixirokoosinna Sikonduusi Tenselooqenaa'n, Gayiyoosi Derbenaa'n, Ximotoosi, Tikiqoosinna Xirofimoosi, Issiyake awurajjinaa'n isinni welti me'ine. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />Insa'ne edinse sa'neexxi Xiro'aada no'oo heqqine. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />No'o kinni kebbotike ayyaanii uduma Filphisiyuusinaa'n lumoxxe hobolo'n ofollennexxi onde barra uduma insa'ne he'neeba Xiro'aada genneneexxi ookko torbaane barra turrenne.<verse eid="ACT 20:6" /></para>
  <para style="s1">Xiro'ada Giddo Awuxeeqis Reyotenaa'n ke'e</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />Torbatixxe taakkesoxxe barra'n galgala mittumat budeena indonna'a bukki hine'naa Phawuloosi langa baro me'ammaxxe'e bukki hiyyeeke manna'ni haaso'a'emma; haaso'akanna wodhdhaakiin qico'n qeerrise. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />No'o bukki hineennexxe fooqe'n heddi xassuwwi hedhemman. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />Ewwixekis hiyyemaak dargaggeesi mitti masikootete'ni ofo'leemman. Phawuloosi haaso'a qeerrise wodda, dargaggeessi kunni ha'ureeka mugo muge; diiphenna cokkoki hiyyeemmaxxee sakkaxxe fooqonaa'n butti'a ibe; mannikinna iso'o reyeenaa ke'isse.<verse eid="ACT 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 20:10" />Phawuloosi kinni butti'a dirreexxi dargaggeessa konne hana wabbiyye luu'medheexxi, «Mee alaayye! Lubbo hedhenni hedheen» hiyye. <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />Phawuloosi fooqete'n iimi'a illee iima higeexxi amaanyet welti ita ite; soodaa qico'ni manniki welti haaso'a'ni tureechchi udumanna ke'e me'e. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />Mannikinna fayyeemmaka ookkone dargaggeesa mine iyyemareexxi ookkonna lumo qico dayya'e.<verse eid="ACT 20:12" /></para>
  <para style="s1">Phawuloosi Efesoonixxa Geedhe Na'ge'ik Hedhdhe Hiyye</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />No'o Phawuloosi'i ookko'n qophe'nonna'a edinse markabiinbaa me'innene; ookko'ninna markabake'n Asoosi'a gulunfenne; tenne assinennechchi Phawuloos Asoos qico'n lekkati me'o'a hedeemmaxxeenna tennenna assinannoshsha isi no'oo ajajemmaxxeeten. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />Isinni welti Asoosii afemeenne wodda isoo lumoxxe hobolote'ni ofo'linshenneexxi Miixiliini'a welti me'innenne. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />Langaxxa barranna ookko'ni markabik me'inennexxi Kiyoosike oddoolike kallachcha'n hexxexxe bakka'n gennene. Iitti andaaxxa barranna Saamoosike oddoolbaa foonfenne; ookkoo'n itti andaaxxa gorsanna Miliixi gennenne. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />Phawuloosi Issiyake awuraajji giddo tura hasa gopheemmaxxee Efesooni gorebaang sa'e me'a hase. Tenneenna asseechchi dandeessisoole onde tomme barrake ayyana'ni Iyyerusaalemi afemo'a wiinamammaxxeteen.<verse eid="ACT 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />Miliixinaa'n Phawuloosi manjo Efeesooni'a ergeexxi Efesoonixxe Mageniinxe tuutaxxa geedhdhe ye'ise. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />Geedhetinna dagee wodda insa'ne'n hiyyee qici, «Issiyake awuraajja'n e'yennexxe barranaa'ni duuchchi wodda ha'nonni welti hitta hedha'ennaxxa ha'nonni egeendine'een. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />Ayihudiinxe shokkonaa'n kexxeexxa rakko ane'ni gelteexxe kaddoolenna midde ani lumoxxe shaquntenninna indidoti Gootta ergatemaannan. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />Manni bukki hiyyaa boncho'ninna kaddo'o mine mine mammaremma'n ha'noo barachchciisatenaa'ninna la'o ha'no'aa affaan hiyye hedennexxa lalabatenaa'n udumaa higebe'non. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />Ayihudiinke mannanna kado'o Girkeek aadde aageexxi Mageniinbaa higaashshanna Gootta Yessuusi'n amanaashsha jabeesse kuleenneni.<verse eid="ACT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22" />«Ta'anna ookko gewonnoole ane'ni maachchi geyyaaxxa ege'nebe'nongi Woyyichchi Hafuurinni ajajeme'e Iyyerusaalemi'a me'onaaten. <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />Kaddo malee qachcha qachcha'ninni usurikinna rakko ane'ni geltaaxxa Woyyichchi Hafuuri ane'ni kule'een. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />Yaadi ank badhaadhiinxa wengeleexxa eloxxa odo dhugaa kulati Gootti Yessuusi Kiristoosi ane'n uwweexxa huje hujeneexxi biratee gongichcho anka muuxonna'a ani'a hedho anxi mitteelchishsha laako'endabaaxxenna wayi fuldabaaxxe yaaneshshaten.<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />«Ta'atenna kaddoole ha'nooxxe oddo'ni marema'ni Mageniinxe mootummaxxa yaane ha'no'n kuleennek, ha'noo duuchchiing konneechchi edi'a anee affinabaaxxa ege'neennen. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />Tennexxee ha'noo giddii'ni mitti midde ba'eexxe kaddoole ani laqemabe'noxxa telchixxe barra'ni ha'no'ni ege'nishshaannen. <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />Mageniinka yaada duuchchanna ha'no'ni kuleennen; mittetinna gatisenneexxi yaane hexxebaan. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />Woyyichchi Hafuuri ha'noo ifike gedhebixxe alaalsanno asseexxi baallonse'een; Yoona umo ha'nookanna gedhebo isika duuchcha heqqe; Mageni ifike beltixxe reyonni wodeexxa isixxa beete kiristaane heqqe. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />Ani me'enelchini buttaaxxi yayye daggeexxi ha'nooxxe oddo'ni luuxxe e'yitaaxxanna Mageniinxe tuuta'a marartabaaxxa ege'neenneni. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />Ha'noo giddii'ninna midde ifixxa hordofeeyye bira sa'isatee'e dhugaa dassaak manni ke'aan. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />Tennexxee ifi heqqedhdhe; sase woga hashshanna barra uurrisa belo indiidoo dunat ha'no xexxe'achchiisennexxa kassi hiyye!<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />«Ta'anna ha'noo ijaaraake'ninna woyyoole ifixxi giddo ha'no'a qadaada uwwa dande'aake Mageno'ninna isike badhaadhiinke hiyyichcho'n ha'noo maganne uwwaane. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />Ani ayyika biretika siblijo yookaan worqe yookaani seemma gaabebe'non. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />Anga anxenni hucca'n ifinna aninni welti hedhemmakaara gargaarennexxa ha'noo umo ha'noongenninni egendine'eeni. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />‹Adhdhaak irra uwwaak eebbiseme'eeken› hiyyaaka Gootta Yessuusika hiyyichcho qaabatati anga no'oxxenni huccina'n rakkiyye gargaara no'oo hasissaaxxa ha'noo'n heddo orinni leelliinsheennen.»<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />Ookkoneechchi uduma Phawuloosi insa'ne duuchchingeenninni welti guluffateexxi soodate. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />Insa'ne duuchchiingi hiiqqinse oo'na'n Phawuloosi'n marxemmee sunqe'ne. <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />Hara lumo qico yaandeechchi, «Yoona konnechchinni edi'a anee uudinabaan» hiyyemmaxxeten. Markabii qico'ninna isoo geegeesine.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s1">Phawuloosixxa Iyyerusaalemi'a Me'a</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />Insa'nenaa'ni gargarti hingeennechi uduma markabi giddo ofollenneexxi toggi hine Qoosi hiyyendaaxxe giddichchobaa me'ineennen. Langa xxa barranna Ruudixxe giddichchoba gennenne. Ookko'ninna Phaaxirake qachchibaa me'innenne. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />Ookkoneechchi uduma Finqe'aa fooffa'neeka markaba anfe'e iso'ni ofollennexxi calli hine me'innenne. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />Qophphiroosixxa giddichcho bita'i darre'ni gatinse'e Sooriya'a me'innennexxi Xiroosike qachcha'n dirrinnenne. Tinninna markabake'ni feeneemmaka fe'issa ookkoo dirrinsaammaxxeeten. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />Ookkonna hordofeeyye anfennexxi insa'nenni welti torbaane barra turreennen. Insa'nenna Woyyichchi Hafuurinni akeekemeexxi Phawuloosi'n «Iyyerusaalemi'a martoxxe'e» hineexxi kulle. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />Yaane kinni ookko turrannoxxi yanna muddee wodda insa'nenaa'n gargari hingenneexxi ke'ne calli hine me'innenne. Duuchchiinxi hordofeeyye ifi ifixxe aruwwanninna ifi ifixxe oosenni welti hexxeexxi ookkone qachchi gadhi darree qico'n no'oo geegeessite. Abaayyati qarqaranna guluffantenneexxi soodantenne. <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />Weli welinna nage'ik hedhdhe hinneennexxi markabi giddo e'yinnenne; insa'nenna ifi fike minbaa illee iima hinge.<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />Xiroosinaa'n ke'nennexxi me'ina'ninni Phexelemayisi gennenne. Ookko amaanye duuchchinni welti afeemmennexxi nage'a weli aa'nennechchi uduma insa'neenni welti mitte barra sa'issinnenne. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />Langa barra gorsa ookkoo'ni fullenneexxi Qiisaariya'a me'innenne. Ookko'ni wengeellawichcho Filiphphoosibaa marreennexxi isinni welti isike mine'ni ofollenne. Isinna Iyyerusaalemi fileendeemmaxxe torbaanne daaqone giddii'ni mitti isotemman. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />Filiphoosinna raaga haaso'aaka shoole dubbara afeemmaan. <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" />Heddo barra'a ookko offollennechchi uduma Agaboosi hiyyemaak wabeek Yihudake boganaa'n dage. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />Kunni wabeekichchi no'obaa shiqe'e Phawuloosika hanfaala aadhe anga lekka ifixxa usudhdheexxi «Woyyichchi hafuuri hiyya'nee qici, ‹Konne hanfalika anna Iyyerusaalemi hedheek Ayihudiink manni iitta usureexxi Ayihudake kadebaake manna'n sa'isseexxi uwwaan hiyya'neen› » hiyye.<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />Tenne lanqenne wodda no'onna ookko hedhaammaki manni Iyyerusaalemi marabaashsha Phawuloosii kadhantenne. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />Phawuloosi kinni, «Iitta ooxxina'ni mayyee qalbe anxa hojoggi assitinaa? Ani Gootta Yessuusike summi'a Iyyerusaalemi usurema calla kaddebaak reyoteenna midde qixxeefatenneen» hiyye. <verse eid="ACT 21:13" /><verse number="14" style="v" sid="ACT 21:14" />Isinna gorsa no'oka adhdha gibee wodda «Yoona Mageniinxe fedhiishsha kaddowwaalta'a» hine waallenne. <verse eid="ACT 21:14" /><verse number="15" style="v" sid="ACT 21:15" />Ookkonechchi uduma qixxeeffantennexxi Iyyerusaalemi'a me'inenne. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />Qiisaariya hexxeexxe hordofeeyyenaa'n mitte mitte no'onni welti dagge. Insa'nenna Minasoonike mine'n ofollannoshsha no'oo isike miniba'a akeenke, no'onna ookko ofolenne. Kunni manjichchi edise amaanemmaake Qophphiroosike bogike manjo kadaa wodda siretixxe hordofeeyyenaa'n mittekemman.<verse eid="ACT 21:16" /></para>
  <para style="s1">Phawuloosi Iyyerusaalemi Geye</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />Iyyerusaalemi gennenne wodda amaanye dayyuwwi no'oo gammashshoti adhdhe. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />Langaxxa barra Phawuloosi no'onni welti Ya'iqoobiba mare; Mageniinxe tuutaxxi geedhe duuchchanna ookko hexxemman. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />Phawuloosi duuchchinga nage'a aadheechchinni udumi'a isixxe ergatensha darre'n Mageni Ayihudake kadebaake mannixxe oddo'ni asseexxa yaane duuchcha mitte mittendinni insa'ne'ni kule. <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />Insa'nenna tenne lanqee wodda duuchchingi Mageno galateffante. Insa'nenna ookkonechchi uduma Phawuloosi'n hinee qici, «No'oke dayyoo, heddi kuma'n laakko'endaaxxi amaanye Ayihudiinxe gosa'n hexxeexxanna insa'ne duuchchiing Muuseke seeri'a hinanfa'neexxa uuda dandetatton. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />Ati'a Ayihudake kadebaake mannixxe oddo'ni hedhdhemmaka Ayihudiinka manna duuchcha ‹Oose ha'noxxa jila ofo'lishshinoqqe'e› yookaan ‹Ayihudiinke galdumi'a ajajjendinoqqe'e› hita'ni barachchiisati Muuseka seera jijjiiraashsha assitaaten hiyyenda'naa lanqe'een. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />Insa'ne daga atixxa lanqaaxxi kokaken, ta'a no'o maa assa woyya? <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />Tennexxee no'o hinnanoxxa assi; no'oxxe oddo'ni werreega werreege'eek shoole manna hedheen. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />Konne manna aaxxe insa'nenni welti luqqi hiyyatika seera muuxxi; insa'ne umo haaxxatee laqqemaaka maallaqanna uwwi; tenne assitottole atixxee odeesendeexxi yaane duuchcha dharake kaddeexxanna ati umo attingenninni Muuseke seeri'a ajajendeteke kaddeteexxa duuchchingi ege'naan. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />Ayihudiinke manna kaddebaaxxe aamanye'a kinni, ‹Dharichchi magenuwwi'a tolchemeechcho ittinoqqe'e; mundetanna ittinoqqe'e; gorra'emebaak reyeeka hore biniinchika maala ittinoqqe'e; yabaabulletenaa'ni bayyaate› hine murreneke borreesa insa'ne'a ergineennen» hine.<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />Phawuloosinna langaxxe barraxxa gorsa ookkone manna aadhe mare; insa'nenni welti isinna luqqi hiyyatixxa aada muuxe; ookkonechchi uduma luqqi hiyyatixxi aada haano muuxendaaxxanna insa'nee duuchchingixxi uwwanna haano shiqqaxxa ege'nishatee Woyyichchi Galmi giddi'a e'ye.<verse eid="ACT 21:26" /></para>
  <para style="s1">Phawuloosi Abideme</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />Torbaaxxi barra mudo'a shiqqee wodda Issiyake aurjinaa'n dagemmaki Ayihudiink manni Phawuloosii'i Galmi giddo hedhe'na'a afeexxi arda diinik ke'issati Phawuloosii'i abideexxi, <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />hiyya'ni cancee qici, «Koo Isira'eelike manna, amme no'o gargaarre; arda no'oka, seera no'okanna booncho konnee gareera'n boga duuchcha'ni hedheeka arda duuchcha barachchiisa'nemmak konne manjon. Tinninna hanqatee'naa Girkeeka manna midde Woyyichcha Galmi giddii'a iyyeedagati konne Woyyichcha booncho battoseen» hiyye. <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />Insa'ne tenneenna hineechchi konnechchi edi darree Efeesoonike qachchik manji Xirofimoosi Phawuloosinni welti hedhee'naa qachchi giddo isoo uundemmaxxeenna Phawuloosi isoo adheexxi Woyyichchi Galmi giddo e'yeechcho insa'ne'n labbemmaxxeeten. <verse eid="ACT 21:29" /><verse number="30" style="v" sid="ACT 21:30" />Tennexxee qachchi duuchchi weekkeme; Ardi duuchchi gonga'n mitteba dageexxi Phawuloosi'i abide harkisaa'ni Woyyichchi Galmi giddii'ni fulche; ookkonne hirbaa'ninni Woyyichchi Galmixxi huluwwanna cufende.<verse eid="ACT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 21:31" />Iikki manni Phawuloosi'i shiyo'a hiyya'neenge'n Iyyerusaalemik qachchi duuchchi weekkemeen hitaaxxi erga Roomek loliinke mannike ajajallo'n gelte. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />Isinna hirbaange'ni mitte mitte loliinka ja'laabuwwanna loliinka manna adhdheexxi adadde insa'neebaa gonga'n mare. Iikki manninna loliinke mannika ajajallonna loliinka manna afee wodda Phawuloosii'i gana waale. <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />Iikki Loliinke mannik ajajallinna Phawuloosiba'a shikki hiyyeexxi isoo abideechchi uduma isi lame haachchabinni usuremaashsha ajaje. Ookkonechchi uduma isi ayyete kadeexxanna maa asseexxa qore. <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />Ardi giddii'ni mitte mitte yaane hiyyaa wodda weli kinni wele yaane hiyya'nemmaa; ardiinke cancinaa'ni kexxeexxa iikki loliinke mannik ajajalli konne cancixxa dhugaatixxa yaane ege'na dande'a gopheemmaxxee Phawuloosii'i loliinxe kaanbeba'a aa'ne me'inaashsha ajaje. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />Ardiinxe raankanaa'ni kexxeexxa Phawuloosi miniinxe hulake hadhisanjiba geyee wodda loliink manni Phawoloosii duke. <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />Udumii'n hordofaammaki ardinna, «Isi shiyemowwaal» hiyya'n canca'neman.<verse eid="ACT 21:36" /></para>
  <para style="s1">Phawuloos Ardake'n Haaso'e</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />Loliink manninna eettene kaanbeba'a Phawuloosii e'yisho'a shiqee wodda Phawuloosi loliinke mannika ajajallo, «Mitte yaane ate'ni haaso'onnaa ani'a eetii uutato?» hiyye.</para>
  <para style="p" vid="ACT 21:37">Loliinke mannik ajajallinna hiseexxi «Ati Girkeeka afo'o adda egende'ete? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />Ati konne edo ardake'n lele'ma ke'issati shoole kuma manna adhitettexxi qiilla gammoojje giddi'a baajeetek Gibtsichchi atetebaata?» hiyye.<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />Phawuloosinna, «Aniqqa, Kilqiyake awuraaji giddo hedheeke ege'nemeeke Xerseesike qachcha'n ilemenneke Ayihudichchon. Konne arda'n haaso'ona'a ani'a eetii uwwi» hiyye.<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />Haaso'atee loliinke mannike ajajallinaa'n eeti alfeechchi uduma Phawuloosi hulatike ookkone qephphinna'ni uurreexxi angati ardi sammi hiyyaashsha qiphe; ardikinna sammi hiyyee wodda Ibirayisixike laagadinni insa'ne'n haaso'e.<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />«Anke dayyuwwanna anke annuwwa ani ta'a ha'no'n haaso'aanneka faachefachotika haaso'a laqqe!»<verse eid="ACT 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 22:2" />Insa'nenna isi Ibirayisixike afo'inni haaso'a'naa lanqe wodda woldi irra sammi hine.</para>
  <para style="p" vid="ACT 22:2">Ookkonechchi uduma Phawuloosi hiyya'n haaso'ee qici: <verse eid="ACT 22:2" /><verse number="3" style="v" sid="ACT 22:3" />«Ani Kilqiyake auraaj giddo hedheeke Xersesike qachcha'n ilemenneke Ayihudichchon; nophphenebinna konne Iyyerusaalemike qachcha'niten; no'ooke annuwwika seeranna Gemaaliyaxxe lekka hunda offo'lee co'asse barateennen; ha'noo telcho Magenokee hinaafina'neeshshanni aninna Magenokee hinaafaannakemnan. <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />Konne ora hordofaakaara reyoti qico'n shorrisha'n labba mayyaka abida'n usuriinke mi'ne'n e'yishaannakemman. <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />Tinninna dhugaate kaddeexxa qeesetik uminna Geedhetik ya'i duuchchi dhugaa kula dande'aan. Insa'nenaa'ninna borreessa adhdhennexxi Demaasiqo hedheeke insa'neke Ayihudiinke dayyuwwiba marat ookkone manna abidennexxi Iyyerusaalemi iyyedagati mura insa'nee woxisatee ookko'aa me'aannan.<verse eid="ACT 22:5" /></para>
  <para style="s1">Phawuloosi Kirsitoosiba'a Hitta Higeexxa</para>
  <para style="r">(<ref loc="ACT 9:1-19">Erga. Huj. 9:1-19</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />«Jaane saate kadamma wodda me'aande'n hedhenneke'n Demaasiqo'a shiqennexxa yanna dedhange'n jabak ifi iimatenaa'n qarqara anke'n wa'a hiyyeen. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />Aninna butta ibeennen; ibeeneenba hedhee'na ‹Sa'ooli! Sa'ooli! Mayee anee shorrishaate?› hiyyaaka haaso'a laqeennen.<verse eid="ACT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 22:8" />« ‹Aninna, Goottaa! Ati ayyete?› hiyye qorenne.</para>
  <para style="p" vid="ACT 22:8">« ‹Isinna ani ati shorrishshateke Naazireetike Yessuusin,› hiyyeexxi hiisse haaso'e. <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />Aninni welti hedhemmaki manni ifa ookkonee uudo malee isi ane'n haaso'eeka haaso'a laqebaan.<verse eid="ACT 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 22:10" />« ‹Aninna anke Goottaa! Maa assanno?› hiyye qorenne.</para>
  <para style="p" vid="ACT 22:10">« ‹Goottikinna misii hiiye› kexxettexxi, ‹Demaasiqo mari; assittottaa hassissaaxxi duuchcha ookko ate'ni kulendaani.› <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />Ookkone ifinike wa'innixxe birasa'nenaa'n kexxeexxa ille anxi afa gophpheemmaxxee aninni welti hedhemmak manni anga anee abide akeeka'n Demaasiqo geesise.<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />«Ookkonna Hanaaniya hiyyemmak mitti manjichchi anee uudo'a anibaa dage; isinna seera xexxe'achchoti heqqedhaake. Damaasiqo hedhaammake Ayihudiinke manni duuchchi edo ulfeessemmeeke manjomman. <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />Isi ani bira dage ani bira uurreexxi anee, ‹Dayyo Sa'oolii, ille atixxi affowwaal!› hiyye. Ookkonne hirba'ninni ille anee affee'na isoo uudennen.<verse eid="ACT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 22:14" />«Ookkoneechchi uduma isinna anee hiyyee qici: ‹No'oke annuwwiki Mageni fedhii isixxa egendottaa, Ookkone qullichchanna uudotaanna afo'oo isikenaa'n hiyyichcho laqqotaa atee fi'le'een. <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />Mageni tenneenna asseechchi uuddettexxenna laqqeettexxa yaanexxee manji duuchchi edo isixxe dhugaa kula kaddota'aaten. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />Ta'ata maa heqqitaate? Kexxettexxi summa isika yexxa'ni xammaqemi, cubbo atixxenaa'ninna anshedhi.›<verse eid="ACT 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />«Aninna Iyyerusaalemi'a illee iima hige'e Woyyichcha galmi giddo soodachchote'n se'ennexxi waleella uudenne. <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />Goottikinna ane'n haaso'aa'naa afenne. Isinna, ‹Anxee kuldattoxxa dhugaa adhdha gophaammaxxee rakketeexxi Iyyerusaaleminaa'n fuli› hiyye.<verse eid="ACT 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 22:19" />«Aninna, ‹Gootta, ani Ayihudiinke maganoonfachchotike mine duuchcha'n mara'n atee amanammaka manna usura'ni ganaannaxxa kunni manni ege'ne'een. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />Atixxee dhugaa kula kadeemmak Isxifaanoosi shiyemee wodda ani umo anigenninni shiyammake manninni weli'aagennexxi ookko bira uurrati shiyemmake mannixxa seemma heqqaannan.›<verse eid="ACT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 22:21" />«Goottikinna, ‹Bayya, Ayihudake kadebaake mannibaa ate erga'ennaxxee kexxe me'i.› »<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />Konne hiyyichchi qico'n ardi duuchchi Phawuloosika haaso'a laqa'nemman; ookkonechchi uduma «Iitta hedheek manji buttatenaa'n fuggussemowwaal; lubboti hedha isoo hasissabaan!» hiyya'ni hafuura gikki asseexxi cance.<verse eid="ACT 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 22:23" />Insa'nenna cancina'n seemma ifi fixxanna iimi'a dharbina'n bukotanna iimi'a xeera'nemman. <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />Ajajallikinna tennee uudee wodda Phawuloosii'i loliinke mannixxe kaanbe'n iyyemarraashsha ajaje. Ardi iso'ni mayyee konne qico canca'neexxa ege'nateenna jadhafema'n qoremaashsha ajaje. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />Phawuloosinna genni assine usurre jadhanfo'a qixxeefantaa wodda isi bira uurreeka dhibbiinka ajajallo, «Mitte Roomike bogika manjo murte belo jadhaffino'a seeri ha'no'aa uwwa?» hiyye.<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />Iikki dhibbiink ajajajlinna tenne laqqee wodda loliinke mannike ajajallibaa shikki hiyyeexxi: «Maa assita'ettexxa egende'ete?» hiyye isinni hiisseexxi, «Manjichchiqqa kuniqa Roomike bogike manjo» hiyye.<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />Ajajallikinna Phawuloosiba'a shikki hiyyeexxi, «Amoo ane'n kuli, ati Roomike bogike manjo?» hiyye.</para>
  <para style="p" vid="ACT 22:27">Phawuloosi, «Eeti» hiyye.<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />Ookkonenechchi uduma ajajallikinna hiyyee qici, «Ani Roomeke manjo kadeenneek lumoka maallaqqa uwweten» hiyye.</para>
  <para style="p" vid="ACT 22:28">Phawuloosi kinni, «Ani ilenshandinni Roomeke manjon» hiyye.<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />Tennexxee isoo qore qo'niso'a qixxeeffatemak manni iikki woddi isinaa'n baaje. Ajajallikinna Pha'uloosi Roomike manjo kadeeka ege'nee wodda Roomika manjo haachchabik usureemmaxxee sodaate.<verse eid="ACT 22:29" /></para>
  <para style="s1">Phawuloosi Ayihudiinxe Songo Edo</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />Langaxxa barra ajajalli Ayihudiink manni Phawuloosi'i mayiinxe button ku'lemmeexxa toggitte yaane ege'no'aa haseemmaxxee iso usurakenaa'n tike. Ookkonneechchi uduma qeesetik sooresuwwinna Ayihudixxe songok manni duuchcha bukki hiyyaashsha ajaje. Phuwuloosinna iyyedageexxi insa'ne edo uurse.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />Phawuloosi songotika manna dhaphphi hiyye uudeexxi hiyyee qici, «Anke dayyuwwa! Telchi qico'ni ani Mageni edo eloxxe sammonni ergateme'eennen.» <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />Hanaaniya hiyyemaak qeesetik umi qeesichchi Phawuloosi bira uurreemmaki manni Phawuloosika afo'o gannashsha ajaje. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />Eettene yanna Phawuloosi Hananiya'a, «Koo ati bada nooriki isendeexxe gimoshsha hexxeteek! Ateenna Mageni ganna ganaan! Seeriinke orinni ane'n murtottaa ofoldeenni hexxe'e, seeri belo ane ganisiiseettaxxee atinni seera diigeeten.»<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />Ookko Phawuloosi bira hedhemmaak manni Phawuloosii'i, «Ati Mageniinxe qeeseka umo qeesichcho yowwitebexxootaa?» hiyye.<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />Phawuloosinna «Anke dayyuwwa, qeesetike umo qeesichcho kadeexxa ege'neennabaan; ‹Atike ardike sooreessuwwa'n fuggoka haaso'a fulchexxoxxe› hiyyende borreesende'een.»<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />Ookko hedheemmak manni gamisi Seduuqito gamisi Feerisitote kadeexxa Phawuloosi ege'neexxi, «Anke dayyuwwa, ani Feriisichchi i'leeke Feriisichchon; ani ta'a murtetee shiqeennelchi reyyek mannixxa ke'a'ni adde afennexxeeten» hiyya'n songotike ya'i giddo hafuura gikki asse haaso'e.<verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />Phawuloosi tenne hiyyee wodda Feerisitotixxenna Seduuqitotixxe oddo'n moronsha kexxeenaa'a songotik ya'i lameba qoodeme. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />Seduuqito, «Reyotinaa'n ke'aa hexxebaan, ergannatinna hexxebaan, hafuuruwwikinna hedhebaan, hita'neexxeran; Feerisito kinni kunnichchi duuchchi hedheen» hita'nee amandaan. <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />Tennexxee canci jabak ke'e; Feerisitotenaa'n mitti mitti Muuseke seerk barachchiisalluwwi ke'e uurreexxi, «No'o konne manjo'ni mitte elobaaxxa yaane anfebe'noni; hafuuri yookaan iimik erganj iso'ni haaso'eexxe kaddu, no'o egennannota?» hiyya'n morome.<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />Loli eebbaa'ni me'emmaxxe'e ajajalli Phawuloosii ninniffaanxee sodaate; tennexxee loliinka manna aade maritineexxi manniinxe oddonaa'ni Phawuloosi'i buttine fulchitineexxi loliinke mannixxe kaanbe giddo iidagaashsha ajaje.<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />Langaxxe barraxxa hashsha Gootti Phawuloosi bira uurreexxi «Jabaati! Iyyerusaalemi'n dhugaa ani'a kuldetteshshaani, iittanni Roomike qachcha'ninna ani'a dhugaa kuldattoni» hiyye.<verse eid="ACT 23:11" /></para>
  <para style="s1">Phawuloosi'i Shiyaatee Assenddeexxa Shokko</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />Langaxxe barraxxa gorsa Ayihudiink manni bukki hiyyeexxi shokkoti, «Phawuloosi'i shinnebe'nok midhatanna indabe'no wodde'ekanna ha'winabe'no» hiyyeexxi kakate. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />Konne diinaa'ni weli ageeke mannk laakkoosi shoole tommenna'ni sa'eekema'a. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />Insa'nenna qeesetike akeekisanjuwwibaanna geedhetiba marreexxi hinee qici, «Phawuloosi'i shinnebe'nok midha wode'e no'oke afo'inni manqabe'noshsha kakanteenen. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />Yoona ha'noo songotike ya'inni welti hexxinee isoo hudhudhdhi assiitineexxi qortine qo'nissina'neeshsha assati Phawuloosii ha'noobaa iyyedagaasha ajajallo laqqe; No'oo isi kaba geyyebaa edi darre isoo shinnona'a qixxeeffanteennen.»<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />Yaane kinni Phawuloosixxe dayyoki belti shokko tenne'e laqe'e lolinke mannixxe kaanbe'n mareexxi Phawuloosi'ni kule. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />Phawuloosinna dhibba lolinka manna ajajamakerranaa'ni mitte ye'eexxi «Kunni belti lolinka mannike ajajalo'n haaso'a'neexxe yaane hexxeni, isiba'a shiqishshi!» <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />Iikki dhibbink ajajalli ookkone belto ookkone bagedo ajajammakibaa iyyemareexxi iso'n, «Iikk useremammak Phawuloosi anee ye'eexxi kunni dargaggeessi ate'n kula'neexxe yaane hexxemmaxxee atiba'a isoo shiqishanoshsha anee kadhateen.» <verse eid="ACT 23:18" /><verse number="19" style="v" sid="ACT 23:19" />Lolinka manna ajajammakinna ookkone dargageessixxa anga abide qofibaa gamake'n isoo hiisseexxi, «Ane'n kuldota'a hassaattexxi yaane maachcho?» hiyye isoo qore.<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />Iikki beltinna hiyyee qici, «Ayihudiink manni Phawuloosixxa yaane hudhuudhdhi asse'e qore qo'nissa'neeshsha fakkeeseexxi soodo ati isoo songote'n shiqishshatoshsha atee laqo'a weli aage'een. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />Tennexxee insa'ne hinaaxxa ishshi hitoxxee; tinninna kaddeechchi insa'ne giddii'n Shoole tommenaa'n sa'aaki manni isoo shiyatee orake'n ripheexxi isoo heqate'n hedhemmaxxeten; iittanni isoo shinaa qico'n midhdha wode afo'oke'n maqa gophatee kakante'een; ta'anna qixxeefanteexxi atike hiissicho heqedhate'n he'neen.»<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />Loliinka manna ajajammakinna konne belto «Ane'ni kuldettexxa tennee yaane mitteke'ninna kuldoxxe'e!» hiyyexxi isoo me'ashsha asse.<verse eid="ACT 23:22" /></para>
  <para style="s1">Phawuloosi Qiisari'a Ergeme</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />Ookkonneechchi uduma ookkone dhibba loliinka manna ajajaammakerinaa'ni lame ye'eexxi hiyyee ajajee qici, «Dokko hashshixxa sase saate kadaa wodda Qiisaariya'a me'aaka lame dhibba loliinka manna, torbaane tomme fadhadik lolaaka mannanna lame dhibba bagedik lolaaka manna qixxeesse. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />Phawuloosi'anna fadhachcho qixxeesitineexxi boga galchallo Filkisibaa nage'ik geyaashsha asse.»<verse eid="ACT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 23:25" />Isinna hiyyeexxi borreessa borreesee qici, <verse eid="ACT 23:25" /><verse number="26" style="v" sid="ACT 23:26" />«Qelaawudewwoosii'i Luusiyoosikenaa'n Ulfeesendeetteka bogiinka galchallo Filkisi'aa, nage'i ati'aa kadowwaal. <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />Konne manjichcho Ayihudiink manni abide shiyo'atemman; ani kinni isi Roomike manjo kadeexxa ege'neennaxxee anke sannachchinni welti dhaqabennexxi isoo gatiseenneni. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />Mayee isoo ku'lineexxa ege'nonnaa haseneexxi insa'neexxe songobaa isoo shiqisheennan. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />Isoo ku'lineechchi kinni seera insa'neeka uudaaxxe yaane'ate malee reyotee yookaan usurrakee isoo geessissaaxxi yaane hexxeebaaxxa wo'menne. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />Konne manjo shiyatee shokko assineexxa laqenne wodda hirbangee'ni atibaa isoo erigeenneni. Isoo ku'leemmaki manninna ati edo dageexxi isoo ku'laaxxa ku'la shiqishaashsha insa'ne'ni kuleeneen.» <verse eid="ACT 23:30" /><verse number="31" style="v" sid="ACT 23:31" />Tennexxee loliink manninna ajajememma qicinni Phawuloosi'i hashshaani aadhe iyyemareexxi Antiphaxiriisike qachcha'n geessise. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />Langa baro loliinki manni Phawuloosi'i fadhadiinke loliinke manninni welti me'aashsha asseexxi kaanbeti'ba illee iima hige. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />Kunni fadhadhiink loliinik manninna Qiisaariya geyee wodda eettene borronna bogiinke galchallo'n uwwa'n Phawuloosii isi edo shiqishe. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />Iikki bogiink galchallinna borro haasoseech uduma Phawuloosi'i «Ati hoone awuraajinaa'nite?» hiyyeexxi qore; Kilqiyake awuraajike manjo kadeexxanna ege'nee wodda, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />iso'n, «Atixxa yaane ate ku'leek manni daggaa wodda laqannon» hiyye. Ookkonneechchi uduma Phawuloosi Heerodisike mootummatike dalla'i giddo heqqemaashsha ajaje.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s1">Phawuloosi Filkisi Edo Shiqe</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />Onde barranni udumi'a qeesetike umi qeesichchi Hanaaniya mitte mitte gedhenninna murtetika seera ege'neeke Xerxeluusi hiyyemaake xabaqichchinni welti Qisaariyaa me'e. Insa'nenna Phawuloosi'i ku'lnenneexxa ku'la bogiinka galchallo Filkisi'n shiqinshe. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />Phawuloosinna ye'emeexxi dagee wodda, Xerxeluusi hiyya'n ku'le eettene shiqishee qici, «Ulifeessendeeteke Filkisii, atike galchatike baro'n nage'i lumoshsha no'aa afeme'een; atixxe lumoxxe qalbeefachchonna konne ardi'a jijjirensha iyyedage'een. <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />Ati lummoshsha ulfeesendeetek Filkisi, atixxa tenne eloxxa huje booncho duuchcha'ninna yanna yanna'n lumoke galatinni adhdhinannon. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />Ta'a kinni ani atee lumoshsha turseebe'nongi harumaa qico'n ku'laannexxa yaane laqqotaa shaqqunteti atee kadhataanen. <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />Kunni manjichchi butta duuchcha'n hedheeke Ayihudi duuchchi giddo rakko ila'ni weekkensha iyyedaga'neeke, Naaziriito hiyyendaaxxe gamoke akeekisanjon. <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />Iittanni Woyyichcha galmanna battooso'a hiyya'neeke'n isoo abindeenen; no'oke seerishanna iso'n murrona'a hende'enan. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />Yaane kinni loliinka manna ajajammaki Luusiyoosi dageexxi hunnati bute isoo adheeni; isoo ku'laaki manninna atiba'a dagaashsha ajaje.<note caller="+" style="f"><char style="fr" closed="false">24:7 </char><char style="ft" closed="false">Mitti mitti olmik borreessuwwi laakkossa 6 kanna 7 laakossa afebaan.</char></note> <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />Yoona ati umo atinge'ninni isoo qorte qo'nissetexxi no'o isoo ku'lneennexxi yaane duuchcha dhugaate kaddeexxa kokeesa dandeetatton.» <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />Ayihudikinna, «Tinni yaane duuchcha dhugaaten» hiyya'n tenne ku'l'a weli aage.<verse eid="ACT 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />Ookkone boga galchaammak Phawuloosi'i angati qiphe ye'eexxi haaso'aashsha asse. Phawuloosinna hiyya'n hiise haasoee qici, «Heddo wogga'aa konne boga galchiteteke kaddettexxa ege'neennaxxee ani ku'lemeennexxe yaaneka faachchefachotika hiissichcho ati edo shiqishanno wodda lumoke gammadinniten. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />Ani sagadonnaa Iyyerusaalemi'a dagenek tommenna lame barra edi darre kadeexxa atinni umo atingeenninni shollaa qico'n koka dandeetattoni. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />Kunni anee ku'la'neek manni Woyyichchi galmi giddo ayyinninna moroma'naa, yookaan Ayihudiinke magnoonfachchotike mine'n yookaan qachchi giddo hoone booncho'inna ardi weekkemaashsha assa'naa anee afebaan. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />Ta'anna anee ku'linna'neexxi ku'la duuchcha dhugaate kaddeexxa kokessitaaxxa mitte yaanenna midde ate'n shiqisha dandeennebaan. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />Kaddo mallee, mitte dhugaate kaddeexxa insa'ne ku'linna'neexxa yaane ate'ni farri asse kulonnole, insa'ne ifi darre'n dhariinke ora hineexxi henda'neeke ora'n no'oke annuwwika Mageno magenoofataanne. Muuseke seera'ninna wabeekotike maxaaffa'ni borreessendeexxa duuchcha amanaanne. <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />Aninna konne mannishshanni quliiyyetinna cubbaleeyye reyotenaa'ni kexxaaxxa Magenoke'n adde afeenneni. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />Tennexxee Mageni edonna manji edo quliite sammo afonaa duuchchi wodda cichchanno.<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />«Iyyerusaaleminaa'n fulennexxe heddo wogga uduma hiyyeeyye anke ardixxee kadaaka gargarsanna Magenokee uwwendaaxxa uwwa aadhennexxi Iyyerusaalemi'a dagene. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />Insa'ne anee Woyyichchi Galmi giddo anfeek konne luqqi hiyyatika seera assa'naate malee aninni welt bukki hiyyeek ardinna hedhemabaan; weekensha mittenna ke'issebe'no. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />Yaane kinni Issiyake awuraajinaa'n dageemmaki Ayihudiink manni ookko hedhemman. Insa'ne anee ku'lina'neexxa yaane anfe'exxe kaddoole ati edo shinqeexxi haasonnowwaal. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />Yookaan ani songotike ya'i edo shiqeenna wodda ane'n anfendeexxi balleesa hexxeexxe kaddoole kunni manni haaso'owwaali. <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />Ani insa'nexxe oddo'n uurreenna wodda ‹Ani telcho ku'leme ha'no edo uurreenneka reyeeki manni reyotenaa'n ke'aan hiyyennexxi hafuura gikki asse haaso'eeneke haaso'a kaddoole malee wele balleessa afebe'no.› »<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />Filkisi kinni Goottiinka ora adda ege'nemmake kadeemmaxxe'e «Loliinka manna ajajammaki Luusiyoosi daggaa wodda ha'nooxxe yaanexxa murte uwwannon» hiyyeexxi yaane wele barra'aa sa'isse. <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />Ookkoneechchi uduma Phawuloosi'a shiixxoka furga'aa uwwa'n isoo heqqashanna jaaluwwi isikinna isi'a hasisaachcho duuchcha aadhe dagaa wodda insa'nee hoyyabaashsha dhibba loliinke mannika ajajallo ajaje.<verse eid="ACT 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />Heenoxxe barrani udumi'a Filkisi Diruusilla hiyyendaaxxe Ayihudichcho are ifixxenni welti dage. Isinna Phawuloosi ye'iseexxi Yessuusi Kiristoosi'ni amanatixxee'e isinaa'n laqe. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />Phawuloosi qulummatixxe'e ifi hiratixxee, heger daggaaxxe murtexxee haaso'ee wodda Filkisi sodaateexxi, «Ta'a'a tinni gelte'een, me'i, ane'n eldaaxxe yanna'n atee ye'issannon.» <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />Filkis Phawuloosinaa'n matta adhdha haseemmaxxee heddo yanna ye'issa'ni Phauloosii'i yaansisa'nemman.<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />Lame wogga uduma Filkisixxe bakka'n Phorqiyoosi Fisixoosi tukkeesseme. Filkisinna Ayihudiinka manna gammachchiso'a Phawuloosii'i usurrange'n waale.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s1">Phawuloosi Fisixxoosi Edo Shiqe</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />Fisixoosi ookkone ifike awuraaji giddo geyeexxe sase barra uduma Qiisaariyanaa'n Iyyerusaalemi'aa me'e. <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />Qeesetik sooreesuwwinna Ayihudiink akeekisanjuwwi isi edo shinqeexxi Phawuloosii'i ku'line. <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />Phawuloosi'i orake'n heqqineexxi shinno'aa hanseemmaxxee Fisixxoosi insa'ne'aa gamisaashshanna Iyyerusaalemi'a isoo iyyedagisaashsha jaba qico isoo kadhante. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />Fisixoosi kinni hiyyeexxi hiisse haaso'ee qici, «Phawuloosi Qiisaariya usurrinke mine'ni hedheen, aninna ta'a umo angenninni shiqoxxe yanna'ni ookko'a me'onaaten. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />Tennexxe ha'nooke galchaluwwi giddii'ni mitti mitti aninni welti Qeesaariyya marruuni; Phawuloosi asseexxi balleesa hexxeexxe kaddoole ookko isoo ku'linowwaal.» <verse eid="ACT 25:5" /><verse number="6" style="v" sid="ACT 25:6" />Fisixxoosi saddeeta barra yookaan tomme barra insa'nenni welti tureechchi uduma adadde Qiisaariya'a me'e. Langa baro murtetike barcuma'n ofo'leexxi Phawuloosii'i isibaa shiqinsaashsha ajaje. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />Phawuloosinna shiqee wodda Iyyerusaalemii'n dagemmak Ayihudi isoo qoqqobeexxi dhugaate kaddeexxa kokeessa dandesissabaaxxa heddo jajjabba ku'lanna isoo ku'le. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />Phawuloosinna, «Ani Ayihudiinke seera'n yookaan Woyyichcha Galma'n, yookaan Roomeka moyanjo Qeesaari'n assennexxi mitte balleessa hexxebaan» hiyya'ni ifinaa'n faachcheeffachchotika hiissichcho hiisse.<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />Fisixoosi kinni Ayihuda gammchchiisa haaseexxi Phawuloosii'i «Tennee yaane'a Iyyerusaalemi martetexxi ookkoo ani edo murte adhdha hasaate?» hiyye.<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />Phawuloosi kinni hiisseexxi, «Kunse murte ane'n murema hassissaaxxe Qeesaarixxe murtetixxe mootte edo uurre hedhennen; atinna adda egendeteshshanni Ayihudake'n assennexxi mitte balleessa hexxebaan. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />Balleessanjoke kado'oonole, yookaan reyote'e geessissaaxxa balleessa hujo'oonole, reyatenaa'n gato hiyyabeno. Yaane kinni insa'nexxi ku'la dharake kaddo'oole ayyinna anee insa'ne'n sa'isseexxi uwwa dande'aak hedhebaan. Anxe yaane'aa anna, Roomeka moyaanjo Qeesaarii afeennen hiyyeennen.»<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />Fisixoosi ifike mari'etike manninni welti haaso'echchi uduma Phawuloosii'i «Ati atixxe yaane'aa ‹Anna, Roomeka moyanjo Qeesaarii afeennen› hitetaxxee moyanjo Qeesaariba'a me'itatton» hiyye.<verse eid="ACT 25:12" /></para>
  <para style="s1">Fisixxoosi Moyanjo Agirphaa, Mari'e Qodhdhe</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />Heenooxxe barra uduma moyaanji Agirphanna Beerniqe Fisixoosii'i baga nage'iki daggeete hiyyatee Qiisaariyake qachchibaa dange. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />Insa'ne Ookkonna heddo barra turreechchi uduma Fisixoosi Phawuloosixxa yaane moyaanjo Agirphaa'ni ke'isse hiyyee qici: «Usuremeeshshanni Filkisi usuriinke mine'n waaleek mitti manji kaba hedheen. <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />Ani Iyyerusaalemi marenne wodda qeesetik sooresuwwinna Ayihudiinxi geedhe iso'ni isoo ku'liteemman.<verse eid="ACT 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 25:16" />«Ani kinni Ku'lemeek manji ku'lemmake manni edo uurreexxi ku'lemeexxe yaane'a faachcheeffachchotika hiissichcho uwwebaak ookkone ku'lemeemmaka manjo sa'isse uwwa Roomixxe mootummake seerabaan hiyyennexxi insa'ne'n hiisse haaso'enne. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />Tennexxee isoo ku'lemmak manni bukki hiyyeexxi aniba dagee wodda turessebo'nong langaxxa barra murtetixxe moote'ni ofo'leneexxi kunni manjichchi ani edo shiqo'a ajajenne. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />Isoo ku'lemmak manni uurreexxi haaso'ee wodda ani hedeneshsha isoo jabaxxa ku'la ku'linebaan. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />Tenne irra insa'ne isinn moroma'emmachchi ifixxe amanaxxeenna Phawuloosi kinni, Hedhaake hiyya'neeke manjo ookkone reyemmake Yessuusi hiyyemeemmakiixxeetemman. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />Aninna iitta hexxeexxa yaane qorqora anee rakkisemmaxxe Phawuloosi'i tenne yaane'a Iyyerusaalemi marteetexxi murte adhdha eettaate? Hiyyyennexxi isoo qorenne. <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />Phawuloosi kinni tennee isixxa yaane Roomek moyanji Qeessaari uudo'a hasseexxi Annake afeennen hiyyemaxxee isoo ookko'a erganno qico'n ookkonni usurriniige mine'n hekki hiyaashsha ajajenne.»<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />Agirphanna Fisixoosii'i, «Kunni manjichchi haaso'aa wodda aninna hiyyaaxxa laqonna'a hasaanneni» hiyye. Fisixxoosinna «Soodo hiyyaaxxa laqqatoni» hiyye hiisse haaso'e.<verse eid="ACT 25:22" /></para>
  <para style="s1">Phawuloosi Moyanjo Agirpha Edo</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />Tennexxee langa baro Agirphanna Beerniqe lumooke ulfinninni dangeexxi, lumollamma loliinke ja'laabuwwinninna ookkone qachchiinke lumollamma manninni murtet lumoxxe kutta'n e'yine. Fisixoosike ajajinni Phawuloosi'i dagaashsha asseme. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />Eettene yanna Fisixoosi hiyyee qici, «Moyanjo Agirphaa, iittanni ha'no no'onni welti kaba hexxineek duuchchi, kone manjo uuddina'nee? Iyyerusaalemi giddonna kaba Qisariyya hedheek Ayihudi duuchchi, kunni manjichchi ta'anni edi'a isi lubbo hedha hasissabaan hiyya'n cancik anee kadhateen. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />Ani kinni isoo reyote'e geessissaaxxa mitte balleessanna iso'n afebe'no. Yaane kinni isi Roomika moyanjo qophateemmaxxee isoo Roomi'a ergonna'a mudhenne. <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />Kaddo malee isixxee anke goottibaa borreessanoxxa kokeesendeexxa mitte yaanenna afebe'no; tennexxee isi qoremeechchi uduma isixxee borreessannoxxa yaane alfaannooni hiyyati ha'noo edo giddii'ninni moyaanjo Agirphaa, ati edo isoo shiqishe'eennen. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />Tinninna mitti usuremeek manji Roome'a ergemaa wodda isi mayee ku'lemeexxa buuto barrise borreesa gopha seeribelote ane'n labbeemmaxxeeten.»<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s1">Phawuloosi Faachcheeffachchotika Haaso'a Haaso'e</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />Agirphaa Phawuloosi'i, «Ifixxee haasottotaa eetti ati'aa uwwendeen» hiyye.</para>
  <para style="p" vid="ACT 26:1">Eettene yanna Phawuloosinna anga diriirseexxi faachcheeffachchotika hiissichcho hiyya'n haaso'ee qici: <verse eid="ACT 26:1" /><verse number="2" style="v" sid="ACT 26:2" />«Moyanjo Agirphaa Ayihudi anee ku'leexxe ku'laa duuchchiinxee telcho ati edo faachcheeffachchotika hiissichcho uwwa dande'eennexxee lumoshsha gammadaannen. <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />Tinninna, giddii'ninni ati Ayihudiinke mannika seeranna moronsha duuchcha aadda egendeettaxxeeten. Tennexxee ossati haaso'annexxa laqqattoshsha atee kadhataannen.<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />«Reefi oosummate'ni hedhennaxxe yannanaa'ni ilemeneke bogi giddo kadi Iyyerusaalemi giddo hitta hedhaannaxxa Ayihudi duuchchi ege'ne'een. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />Dhuggaa haaso'na'neexxe kaddoole ani sirendenaa'ninni amanaa no'oxxika galduma jaba qico duuteexxi seera heqqexxaaxxe Feerisitotixxe gamo giddi'nite kadennexxa egenne'een. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />Ta'a kinni kaba murte adhdhatee uurrenechchi Mageni annuwwa no'okee addachchiisemmaxxa addexxeeten. <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />No'ok tommenna lami gosatik minuwwi Mageno hashsha barra mitte godobinni magenoofata'n muuxendee'naa uudo'a jaba qicinni heqqe'naammaxxi addachchiisa tenneten. Koo moyanjoo, Ayihudiink manni anee ku'la'neechchi tenne addexxe buuto'aten. <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />Mageni reyeka manna ke'issaaxxa ha'noo kaba hexxineek mayeete dandeessissabaaxxe yaane assitine uudina'neek?<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />«Ani umo angenninni ookkone Naazireetika Yessuusika summa dande'enneke ori duuchchinni xaa'nona'a mudhdheennan. <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />Iyyerusaalemi giddonna assenneexxi tennendemman; qeesetike sooresuwwanaa'n ani'a uwwemeeke baallominni woyyoole giddii'n heddo manni usurrii mine e'yashsha assenne; insa'ne shiyemmaa woddanna shiyammakeerinni weli aagenne. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />Insa'ne'ni mura wonxaashshanna heddo yanna mitte Ayihudiinke magenoonfachchotike mininaa'n mittiinbaa mara'n Magenoke'n yowwichchiinka afo'o fulche'naashsha insa'nee hunnati ke'eenne; lumoshshanna insa'ne'n mufate'e wele bogike qachchuwwi giddo mara'n insa'nee shorrishenne.<verse eid="ACT 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />«Konne qicinni qeesetike sooresuwwinnaa'n baallomiikinna ajaji ani'aa uwwemee'naa mitte barra Demaasiqo'aa me'aa'naa, <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />koo moyanjo barra saafo'a orange'n me'ande'ni hedhe'naa wa'inni arishshotike ifinaa'n sa'aak ifi qarqara anike'ninna aninni welti me'aammaake manni qarqara'n iimatenaa'n ifaa'naa afenne. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />No'oo duuchchiing butta inbenneba he'nee'naa Ibirayisixike afo'inni, ‹Sa'ooli koo Sa'ooli mayee anee shorrishshaate? Otaaka sibiljo dhiittotole ati miidhendatto› hiyyaka haaso'a laqenneen.<verse eid="ACT 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 26:15" />«Ookkonneechchi uduma aninna, ‹Gootta, ati ayyete?› hiyyennen.</para>
  <para style="p" vid="ACT 26:15">« ‹Goottikinna, ati shorrishshaateke,› Ante Yessuusiten hiyye. <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />‹Ta'anna iima'a kexxe lekkati uurri; ati anxee uuddettexxeenna edi'anna uuddattoxxee yaanexxee erganjokenna dhugaa kulate kaddotta'a atee baallonsatee ate'ni leelle'ennen. <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />Atee atike ardinaa'ninna insa'ne giddi'a ergannoke Ayihudake kadebaak ardinaa'n anjirannon. <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />Atinna ille insa'nexxa bandattoshsha, dukkanatenaa'ni ifiinba'a insa'nee fulchitattoshshanna durrisiinke baallominaa'n Magenba'a insa'nee hiissitattoshsha assannoni. Insa'nenna ifixxe cubboxxa gattowwaal alfinaan; ane'ni amanatinna woyyoomeeke manni giddo qadaada alfinaan.›<verse eid="ACT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />«Tennexxee moyaanjo, Agirphaa! Iiminaa'n ane'n leelliteexxe waleella'a ajajemabe'non hiyyebe'no. <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />Yaane kinni edisennexxi Demaasiqo hedheekeera'n ookko'n Iyyerusaalemi'ninna Yihudake'n hedheeke duuchcha'n ookkonneechchi udma Ayihudake kadebaake manna'n, aade aangeexxi Mageniiba hingaashsha, aadde aaga ifixxa leellishshaaxxa yaanenna assinaashsha adda insa'ne'ni kulenne. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />Tennenaa'ni kexxeexxe'niteni Ayihudi Woyyichchi galmi giddo anee abideexxi shiyatee yoreemmak. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />Telchi qico'ni kinni Mageni anee gargaare'naa kaba uurrennexxi shiixxo lumoke'n dhugaa kulaannen. Wabeekonna Muuse kaddaan hine'e edinseexxi haasonnemmake haaso'i gadhi darre wele mittetanna haaso'enexxi hexxebaan. <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />Insa'nenna haasoneemmaxxi yaane, Kiristoosi abara adhaaxxa, reyotenaa'ni edike kade ke'at arda ifikee Isira'eeli'anna Ayihudake kadebaake ardi'a ifa lallabaaxxen.»<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />Phawuloosi tennee haaso'a'neege'n Fisixoosi, «Koo Phawuloosi qalbe saxxeeten laqi!» Isinna hafuura gikki asseexxi, «Barachchotixxi birasa'ne atee maraachchite'een.»<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />Phawuloosi kinni hiisse heyyee haaso'e qici, «Ulfeessendeeteke Fisixoosii, ani haaso'annexxi dhugaatixxenna toggite yaane malee ani maraatakebaan. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />Tenne ani haaso'annexxa ati moyanji egendeettenxe kaddeemmaxxee ati edo wo'ma qalbenni haaso'aanen; iittanni sho'ik assendeexxi yaane mittetinna hedha gophphaammaxxee tenne yaanennaa'n mittetinna ate'n sho'ondaaxxi hexxebaaxxa ani koke'ennen. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />Moyaanjo Agirphaa wabeeko amandaateshshandebaata? Amanda'etexxa ege'nennen.»<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />Ookkonneechchi uduma Agirphanna Phawuloosi'i, «Ati iitta sholla qicinninni anee Kiristoositote assitottaatee?» hiyye.<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />Phawuloosinna «Heenooxxe yanna'nite kaddo'o qeerraxxe yanna'n aten calla kaddebexxongi telcho konne anka haaso'a laqaak duuchchi, konne ani usuremenneke haachchabi gadhi darre anishsha kando'a Mageno kadhataannen» hiyye.<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />Ookkonneechchi uduma moyaanji Agirpha, bogiinke galchallinna, Beerniqe, isinni welti ofo'leemmak manni duuchchinna iimi'a ke'e. <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />Ookko'ninna fulleexxi me'inaa wodda weli'anni weli, «Kunni manjichchi reyote waalini usurakee geessissaaxxa asseexxi mitte yaanenna hexxebaan» hina'n haasonne.<verse eid="ACT 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 26:32" />Agirphanna Fisixoosi'n, «Kunni manjichchi anna Qeesaarii'i afeenne hiyya gopheele silaa wocci asseemmaman» hiyye.<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s1">Phawuloosi Markabik Roomi'aa Me'eexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />Ixaaliyaa markabik me'innonnaa murendeechchi uduma Phawuloosiinna weli usuremeeemmak manni moyanjiinxe bagediinxe kutaxxe gamo kade'eeke Yuliyoosi hiyyemaake dhibbiinke ajajallo'n sa'issemme uwwemme. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />Issiyake awurjixxe abbaayyake qarqara'n hedheemmake qachchuwwibaa me'a'neeke Adiramiixiisike markaba'n ofo'lennexxi ke'ne me'innenne. Teseloonqeke qachcha'ni hedhemmak Meqedooniyake bogik Arsixirokoosi hiyyemaak manjichchinna no'onni welti hedhemaan. <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />Langaxxa barra Sidoona gennenne; Yuliyoosi Phawuloosi'a eleexxi Phawuloosi ifike jaaluwwiba'a mareexxi qarqaarsa alfo'a eetti isi'aa uwwe. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />Ookko'ni ke'nenneexxi diidallo no'o edi'ni no'obaa diidalleessitaammaxxee Qophphiroosixxa giddichcho gollake asse'nennexxi markabik ke'ne me'innenne. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />Kilqiyakenna Phinfilyake qarqara'n hexxemmaxxa abbaayya foonfennechchi uduma Liqiyake bogi giddo Mura hiyyemaake qachcha'n gennenne. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />Ookkonna dhibbiink ajajalli Ixaaliya'a me'a'neekaa Isikindiriyaka markaba afeexxi iso'ni no'oo ofo'lishshe.<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />Heddo barra laana me'inna'n Qeenidoosike qachchika loola abark gennenne. Diidallotinna edi'a me'inabe'noshsha kutteexxa yanna Selmuunake bogi darree'n Qerxeesika oddoola gollante me'innenne. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />Jabaaxxe rakkonni abbaayyati hana kasakenaa'ni sa'nennechchi uduma Laasiyake qachchi bira «Markabiinke uurrichchi'a eloke booncho» hiyyendaaxxe bakka'n gennenne.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />Me'inaa'naa'nni heddo barra saxxemaxxeenna agabo goddo hosatixxi yanna muddeemmaxxee eettene yanna markabik abbaayyati hana me'a rakkissaaxxe kaddeemmaxxee Phawuloosi welti me'aammake manni'a hiyyeexxi gorsa uwwee qici, <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />«Koo manna yoona konneechchinni edi'a hexxeexxi no'oxxi me'a rakko affexxe kaddeexxa ane'ni leellita'neen; rakko tinni fe'emeechcho'ninna markaba callaa'nite kaddebaangi no'oxxe hedho'ninna jabaaxxe ba'nenna miidheensha geltaan.» <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />Iikki dhibbiink ajajalli kinni Phawuloosike gorsi irra eettene markaba oofamakinna markabiink anni hinaaxxa laqa'nemman. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />Haarso ookkone ookko sa'issatee iikki oddooli elabaake kadeemmaxxee heddi manni Finqe hiyyemaake oddoola'n geyeexxi ookko turatee addatiyyot me'a no'oxxa edi'a me'inanoshsha mudhdhinenne; Iikki oddolinna Qerxeesike bita'i darreke dhidhiminaa'ninna middi darreke dhidhimi darree'ni kallachchake'n hedheeke boonchomman.<verse eid="ACT 27:12" /></para>
  <para style="s1">Abbaayyatika Danbala'a</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />Hara jabaatebaaxxi bita'ixxi diidallo diidalleesate'ni kexxee wodda insa'ne hendeexxi kaddachcho labbe'naa markaba uurrishiinka mahaaliq hiyyemaaka sibiljo gonsheexxi Qerxeesi gaminaa'n sa'ne me'ine. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />Yaane kinni heenoxxe yanna uduma, Awuraaqisi hiyyendaaxxi hobonbalte abbayyati hana insa'ne darre'n dagge. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />Diidallo markaba kayyi'aa dhiibba'naa edi'a me'aa dande'a gonpheennaxxee ora waale'e diidallo adhiteexxi me'iteenba'a me'innenne. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />Qeeda hiyyemaaka oddoolla gollake asse'nenneexxi me'inanno wodda markaba lubbo gatisatixxa shiixxoxxa hobolo kandeennexxa kande anjira dandeennenne.<verse eid="ACT 27:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 27:17" />Shiixxooxxa hobolo harkinisse iimi'a fulchinneechchi uduma markaba diigendabaashsha qarqara wodaroti xaanxe usurree; Surtisi hiyyendaaxxe cirraachchiinxe tullo'n mare ganemabaashsha soddanteemmaxxee tenne markaba shara dirrinseexxi iittanni diidalloti oofema'ni me'ine. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />Hobonbalte no'o'ni itti jabaatta'ni me'itemmaxxee langaxxa barra feenemmaka mi'a abbaayya giddi'a hunate'ni ke'ne. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />Sakkaxxz barra markabakee la'oo uwwaammaka mi'a anga ifixxenninni darbina'n hunne. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />Heddo barra'a arishsho urjuwwatanna uuda gonpheennaxxeenna diidallo no'o'n jabaatta'ni me'iteemmaxxee yoona gantabe'non hiyyati godoba kultinnenne.<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />Manni heddo barra iteengeechchi hedhebaangi ture; tennexxee Phawuloosi ke'e uurreexxi insa'nee, «Koo mannaa! Ani hiyyeneexxa laqine'ee Qerxeesii'n ke'aa gophphinneele tinni miidhenshanna ba'ne silaati ha'noo'ni geltaammabaan. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />Ta'atenna kaddoole mee co'oo hiyyee ha'noo gorsaannen; tenne markaba calla enqemaa malee ha'noo giddii'n mitte manjixxi lobbo midde baxxabaan. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />Ani isike kadeennekinna magenoofataanneke Magenik, iimik erganji beno hashsha ani bira uurreexxi anee, <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />‹Koo Phawuloosi, mee sodaati; ati Qeesaari edo uurra hassissaan; atinni welti me'a'neeka manna duuchchanna Mageni atixxee hiyyexxi lubbo insa'neexxa gatise'een› hiyyee ane'n kule'een. <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />Tennexxee koo mannaa sodaatinoqqe; Mageni tennee ane'ni kuleexxa yaane assaaxxa amanannon. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />Kaddo malee'e, diidallo no'oo aaxxe mitte oddolike qaraqara'n iyyemarte hundaan.»<verse eid="ACT 27:26" /></para>
  <para style="s1">Markabake'n Gelteexxa Rakko</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />Tommenna sholigaxxe hashsha Adiryaxxe abbaayya hanna diidallo elqekayya no'oo raassa'naa hashsha wodhakiinbaa markaba oofammake manna'n buttinbaa shinqeechcho insa'ne'n labbeen. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />Abbaayyatixxa dhi'mo mikatixxa wodaronna abbaayya giddi'a darbinee wodda wodi'inxi dhi'mo shoole tomme meetire qico kadde afeende. Shiixxoo qico turreexxi higgeenna wodaro darbinee wodda dhi'mo sase tomme meetre qico kadde. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />Carete'n gannemmabaashsha sodaanteexxi shoole lumoxxa hoboloka uurrishatika sibljo markabii udumii'ni butti'a wocci assine; bogikinna soodo'a soodanta'nemman.<verse eid="ACT 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 27:30" />Markaba oofaammak manni markabi edi darre'ni uurrisatika sibilo butti'a woddi'i giddi'a wocci assa'neeshsha kadeexxi hobolo abbaayate'n dirrisati lumoxxe hobolonaa'n fuleexxi baajo'a yore. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />Phawuloosinna dhibbiinke ajajallo'ninna loliinke manna'n, «Konne markaba oofaak manni ca'li hiyye markabi giddo ofo'laa gophoole ha'noo ba'netenaa'n gata dandetinabaan.» <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />Eettene yanna iikki loliink manni hobolo usurendemmaxxa wodaro kuteexxi hobolo ibbe wodii hana shelleellisso'a waale.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />Bogi soodo'a shiqeemma wodda duuchchiingi ita indaashsha Phawuloosi insa'nee hiyyeexxi kadhatee qici, «Mittelchonna itinebaangi heqqeexxina'n turtineexxenni telchi tommenna shoolgaxxe barran. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />Tennexxee midha itino'a ha'noo kadhataannen; tinni ha'no'aa uduudake kaddaan. Mitti ha'nooke umik ordichchinna midde ba'abaan.» <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />Tenne hiyyeechchi uduma kebboo adhe'e duuchchiinge manni edo Mageno galateefatati shaashateexxi itate'n ke'e.<verse eid="ACT 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 27:36" />Eettene yanna duuchchiingi dayyeefateexxi sagale ita ite. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />Markabi giddo hedheemmak duuchchiingi lame dhibbanna torbaane tommenna jaane manjomman. <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />Duuchchiingi iteexxi goddeechchi uduma fe'endeemmaxxa dinne abbaayya giddi'a hunati markaba shollinshe.<verse eid="ACT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />Bogi soodee wodda genneemmak buttini habate kadeexxa egeneemmabaan. Yaane kinni buttiinxe oddo'n shatte e'yiteexxe abbaayyake qarqara'n maanchi hedheexxa bakka tama assine anfeexxi, dandeennoole lumoxxa hobolo ookko geessinso'a mudhdhinne. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />Tennexxee markaba uurrishatika sibiluwwa tinkee abbaayyati giddi'a wocci assine; eetteneenni yanna shafisuwwa usurremmaxxa woddaruwwa tinke; ookkonneechchi uduma lumoxxa abbaayya diidallo dhiibeexxi kasake'n geessissaashsha hobolotika edi darreka shara iimi'a qeernse ba'lataasha assine. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />Yaane kinni iikki markabi tullubememmake mancha'n ganendeexxi butta gelte; hobolo albi darree'n maanchi giddo lixxeexxi lele'ma gophphe; Tennexxee hoboloti udumi darre kinni diidallo jaba qicinni gandeemmaxxee enqemate'n kexxe. <verse eid="ACT 27:41" /><verse number="42" style="v" sid="ACT 27:42" />Loliink manninna usuremeemmake manninaa'n mittikinna daakeexxi baaje fulabaashsha manna shinna shinno'a mudhinne. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />Iikki dhibbiink ajajalli kinni Phawuloosi'i anjira hasemmaxxee hendemmaxxa assinabaashsha insa'nee hoyye. Daaka dande'ak manni markabakenaa'ni utaala'n ediseexxi abbayyatenaa'n buttinbaa fulaashsha, <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />weli gateek manni kinni becuwwatenaa'n yookaan wele wele markabiink enqemalchuwwi ha'na hedheexxi fulaashsha ajaje. Konne qicinni no'o duuchchiingi nage'ik abbayyatenaa'n buttinake'ni gennenne.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s1">Phawuloosi Maltake Oddolli Giddo</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />Nage'ik abbaayyatenaa'n buttinake'n gennennechchi uduma oddooli iikki Maalta hiyyemaaxxa egennenne. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />Konne oddola'n hedhaammak manni mambe'a hiyyissaaxxa arjumma no'aa asse. Xeeni genne'naa boojjessa'emaxxee giira ha'insheexxi no'oo keessunsine. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />Phawuloosi haasume bukki asseexxi giirate'n uggee wodda eebbinjokenaa'n kexxeexxa buute mitte giddii'n fuldeexxi Phawuloosixxa anga iddite. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />Maltake oddoolk manni Phawuloosixxe anga'n buute rarraate'naa afee wodda «Kunni manji manjo anga sa'a isixxi kokaken; abbaayyatike danbala'anaan nage'ik fuloolenna midde dhugaatixxe murteken hiyyemeek mageni isi hedhoti hedho'a isoo waalebaan.» <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />Phawulloosi kinni buute hargufeexxi giirate'n fixxe; mitte midhenshshanna iso'ni gelteba'a. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />Iikki manninna «Haanonna haanota bisi isik darshuu yookaan dedhangen ibe reyuu» hiyya'n isoo heqa'neman; yaane kinni heddo yanna heqqineexxi mitte midhenshanna midde iso'n geltebaaxxa uundee wodda yaada ifika jijjirreexxi, «Kunni manjichchiqqa adana magenoken» hine.<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />Ookkone he'nennake boonchi bira Puplyoosi hiyyemaake ookkone oddolike galchallike boga hedhemman. Kunni manjichchi mine ifike'n adhdheexxi sase barra elo qico no'oo keessunseen. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />Eettene yanna Puplyoosik anni eebbijikinna albaateeti ela gopheeman; Phawuloosinna isibaa mareexxi isi'aa soodate. Angatanna isi hana uggeexxi isoo fayyise. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />Tinni kaddee wodda oddola ookkone'n weli dhibemeemmaki manni daga'n fayye. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />Heddo oruwwinninna no'oo ulfeesine; insa'ne markabake'ni me'a ke'nenne wodda no'aa hasisaachcho duuchcha markabake'ni no'aa feene.<verse eid="ACT 28:10" /></para>
  <para style="s1">Phawuloosi Roomi Geye</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />Sase agenjo Malta turrennelchi uduma haarso duuchcha ookkone oddola'n tureeke Isikindiriyake markaba'n ofolle ke'ne me'innenne. Kunn markab Isikindiriyake kadaa wodda isi hananna ookkone Lakko magenuwwik yookaan Diyosiqoroosike baandira hedheemman. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />Sirakuusika qachcha genneennexxi ookko'o sase barra turrenne. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />Ookko'n markabik me'inneenneexxi Regiyuumi hiyyemaake qachcha'ni gennenne; langaxxa barra bita'ixxi diidallo didalleessiteemmaxxee Putiyoluusika qachcha genneennek itti aandaaxxe barra'nitemman. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />Ookkoonna amaayne dayyuwwa anfenne; insa'nenna torbaane barra insa'nenni welti turrannoshsha no'oo kadhante. Ookkonneechchi uduma Roomi'a me'inneenne. <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />Roomike qachcha'ni hedheemmak amaanye dayyuwwi no'oxxa daga laqeexxi Afiyusi Faruusi qico'ninna «Sase galduma» hiyyemaake boonchi qico'n no'oo qophedho'a dage; Phawuloosinna insa'nee afee wodda Mageno galateeffateexxi dayyeeffate.<verse eid="ACT 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />Roomi e'yinnennechchi uduma Phawuloosi isoo heqaake mitte loliinke manjichchinni welti qofitinni ookkoo hedhaashsha asseme.<verse eid="ACT 28:16" /></para>
  <para style="s1">Phawuloosi Usuriinke Mine'n Roomi Hedheexxi Lallabeexxa</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />Sase barra uduma Phawuloosi Roomike qachcha'n hedhaammaka Ayihudiinka akeekisanjuwwa ye'ise. Bukki hinee woddanna insa'ne'n hiyyee qici, «Anke dayyuwwa, ani Isira'eelike ardika yookaan anke annuwwixxa aada gareertaaxxa mitte yaanenna assebe'nongi Iyyerusaalemi anee usurreexxi Roomike mannixxe anga'n anee sa'isiine une'een. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />Roomik manni anee qoreechchi uduma reyote'e geessissaaxxa balleessa ane'ni afa gopheemmaxxee anee tola wocci asso'a hasseemman. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />Ayihudi xaa'nee wodda kinni anxe yaane'a annaa Qeesaarii'i afeennen hiyyenne malee arda anka ku'lannoxxi yaane hexxemmabaan. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />Ha'noo uudateenna haaso'atee ye'eennechchi tenne buutoxxeeten; ani konne haachchabinni usuremennechchi Isira'eeli'a uwwendeexxe addachchiisaxxe buutoxxeeten.»<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />Insa'nenna hiissine hine haasonee qici, «Atixxee borreessendeexxi mitte borro Yihudake boginaa'n no'o'n geltebaan. Ookkoo'n dageeke dayyuwwinna atixxee shiqiseexxi yookaan mittetinna elobaaxxi yaane hexxebaan. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />Kaddo malee manni tenne haarooxxa amana booncho duuchcha'ni manni giba'neexxa egenneennaxxee tenne yaanexxee atiki yaadi maachcho kadeexxa lanqonna'a enaannen.»<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />Barratanna isi'a abindeechchi uduma heddo manna kandeexxi Phawuloosi hedhammake minibaa dange. Isinna gorsii'ni hashshi qico'ni Mageniinxe moottumaxxee insa'ne'n dhugaa kula'n ifisa'neemman. Yessuusixxee Muuseke seerinaa'ninna wabeekotike Maxaafinaa'n haaso'a'n insa'nee amannashsha assatee wo'laane. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />Mitti mitti Phawuloosi hiyyemmaxxa amane adhdhe, weli kinni amaneba'a. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />Insa'nenna weli aaga gonphemmaxxee Phawuloosinna konneechchin butti'a hedheeka muuxatika haaso'a haaso'ee wodda gargar hinge; isinna hiyyeexxi haaso'ee qici, «Woyyichchi Hafuuri annuwwa ha'nookee wabeekichcha Issayaasi darree'n haaso'ee wodda dhugaate haaso'een.<verse eid="ACT 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26" />«‹Konne ardiba marte insa'nee hitatto qici,</para>
  <para style="q1" vid="ACT 28:26">«Laqa, laqa laqqinaan yaane kinni qalbeefaatinabaan;</para>
  <para style="q2" vid="ACT 28:26">uudatanna uuddinaan yaane kinni hubatinabaan.»<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />Tinninna kaddeechchi konne ardixxi qalbe dillote'eemmaxxeeten;</para>
  <para style="q2" vid="ACT 28:27">insa'ne mansha ifixxanna duuchche'ne'eemmaxxeeten;</para>
  <para style="q2" vid="ACT 28:27">ille ifixxanna himmi asse'ne'eemmaxxeeten;</para>
  <para style="q1" vid="ACT 28:27">Iittate kada gophee'ya ille ifixxenni anfeexxi,</para>
  <para style="q2" vid="ACT 28:27">mansha ifixxenni lanqeexxi,</para>
  <para style="q2" vid="ACT 28:27">qalbee ifixxenninna qalbeeffanteexxi</para>
  <para style="q1" vid="ACT 28:27">hinge'naa silat ani insa'nee fayyisannan.›<verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />«Tennexxee Mageniinxi anjira Ayihudake manna kadebaake manni'a ergendeexxa egendino'a eeyyannen; insa'nenna lanqaan!» <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />Tennee haaso'eechchi uduma Ayihudiinki manni jaba qico weli anni weli moroma'n me'e.<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />Phawuloosinna lame wogga duuchcha kireeffate'eemake mine'n ofo'lee; isiba'a daga'aammaka manna duuchchanna gammsahshot keesunsa'nemman. <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />Ayyinna isoo hoyya'nebaangi Mageniinxa mootumma lallaba'n Gootta Yessuusi Kiristoosixxee lumooshsha ifisee barachchiisa'nemman.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>