<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Gedeo Bible</book>
  <para style="h">Roomeke Manni'a</para>
  <para style="toc1">Ergemallo Phawuloosixxaa Erga</para>
  <para style="toc2">Roomeke Manni'a</para>
  <para style="toc3">Rom.</para>
  <para style="mt1">Roomeke Manni'a</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Ergemallo Phawuloosxi erga Roomeke mannibaa borresendeechchi Phawuloos Room hexxeemmaxxa Mageniinxa tuuta mareexxi uudatika yaado afe'eemmaxxee qixxeefanteexxi isoo heqqinaashsha assateetemman. Phawuloosiki yaadi Roomi hexxeemmaxxe Kiristoositoti welt heenoxxe yanna hujeechchi uduma innsa'neke gargaarsinni Ispeeni'a me'aatemman; kiristoositotixxe amananxee ege'neexxanna kiristoosito ifixxe hedho'n hujet hosisa hassissaaxxe Kiristoositotixxe barrachchoxxee barrisee borreese'een; kunni maxaafi Phawuloosixxi erga wo'ma qicinni afendaaken; Phawuloosi Roomi hexxeexxe amaagne'a nage'a dhaameechchi udumanna insa'ne'a soodato'aanna insa'nee addachchiiseechchi uduma tenne ergaka ha'nura yaadi «Wengeele Magen manjo qullonsaak amanatite, sirtenaa'n muuxamii qico'n amanatite kaddeexxa kuldaan» 1:17 hiyyaake hiyyichcho kadeexxa leellishaan. Ookkoneechchi udma Phwuloosi konneenni yaada ba'la qicinni borreessa; Ayihudike mannanna kadi Ayihudake kadebaak manni duuchchi cubbotee hiremeemmaxxee Magenik araarema insa'nee hassissaan; manji Magenik araarema dande'aakinna Yessuusi Kiristoosi'n amanatiten; tennee Magenik welti mitteba anfeennexxe mittummaxxi gumma haaroxxe hedho kaddeexxa Phawuloosi ba'la qicnni ifisaan; amaagne Magenik welt nage'a affaan; Mageniinke Hafuur darree'ninna cubbotixxenna reyotixxe hunnaa'n leexa fuldaan; hafuura adhdhaa 5-8 qico'n Phawuloosi Mageniinka seeranna amaagnetixxe hedho'n hujaake Mageniinke Hafuurixxe hunnak yaadi maachcho kadeexxa leellishaan; tenne'n itti aancheexxi Phawuloos Magen manjiinxe sanne'a afeeke yaadi giddo hitta Ayihudikinna Ayihudake kadebaak manni qaba dandee'a? Hiyyaake qortumi'a hiissichcho uwwo'a fiiddi hiyyaan.</para>
  <para style="ip">Higgeenni Ayihudi Yessuusi Kiristoosii'i amanebaang gataa Mageniinke yaadan; tinninna kaddeechchi Yessuusi Kiristoos darree'n Mageni leelisheeke badhaadha'n manjiinxi sanne duuchchi bakka affaashsha assateeten; kaddo malee'e Ayihudik manni Yessuusii'i amanaaxxi yanna daggaaxxa Phawuloosi amanaan. Muuxamaken Phawuloos amanatixxe hedho'n Kiristoosito hitta hedha hassissaaxxa, giddiinni amaagne weli'aanni weli affeexxi mittumma jaalalatika ora hordofa hassissaaxxa dhuudhee haaso'aan. Mageno ergatematixxee, Kiristoosito ifike bogixxeenna weli weli assa hassissaaxxe yaanexxeenna sammotixxe buutonni ke'aake qortumuwwixxee barrisee kulaan.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Konnee Maxaafika gumma yaadika e'yichcho <char style="ior"><ref loc="ROM 1:1-17">1:1-17</ref></char></para>
  <para style="io1">Anjirema manjiinke belti'a hassissaaxxe kaddeexxa <char style="ior"><ref loc="ROM 1:18-3:20">1:18—3:20</ref></char></para>
  <para style="io1">Mageniinka anjiratika ora <char style="ior"><ref loc="ROM 3:21-4:25">3:21—4:25</ref> </char></para>
  <para style="io1">Kirstoosinni afendaaxxa haaroxa hedho <char style="ior"><ref loc="ROM 5:1-8:39">5:1—8:39</ref></char></para>
  <para style="io1">Isira'eeli Mageniinke yaada'n <char style="ior"><ref loc="ROM 9:1-11:36">9:1—11:36</ref></char></para>
  <para style="io1">Kiristoositotixxa Huje <char style="ior"><ref loc="ROM 12:1-15:13">12:1—15:13</ref> </char></para>
  <para style="io1">Muuxamakanna nage'a dhaamaa <char style="ior"><ref loc="ROM 15:14-16:27">15:14—16:27</ref></char></para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />Yessuusi Kiristoosike erganjo kade'eeke, ergammallumatee ye'emeeke, Mageniinxe wengeele'aanna foyemeeke Phawuloosinaa'n ergendeexxa erga.<verse eid="ROM 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 1:2" />Tinni wengele Mageni wabeeko ifixxi darree'n woyyichcha maxaafuwwa'n ediseexxi uwweemake addachiisatike hiyyichchon. <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />Tinni wengeelenna Mageniink belti manjuma ifixxe darree'n, Daawwitixxe sannenaa'n ilemeexxa haasotaaxxen; <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />iittanni no'ok Gootti Yessuusi Kiristoosi woyumatike Hafuurinni<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">yookaan </char><char style="fqa" closed="false">Ifixxe woyyummake Hafuurinni </char></note> reyotenaa'n ka'ati Magenke Belto kadeexxa lumoxxe hunnanni ege'nende. <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />Kiristoosi ga'mii'n Ayihudake kadebaake ardi duuchchi giddii'n manna isike summa'n amanat afendaaxxe ajajemabaa ye'atee badhaadhakanna ergammallumma adhineennen.<verse eid="ROM 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 1:6" />Ha'noonna Yessuusi Kiristoosike kaddino'a ookkone Mageni ye'emake manni giddii'niten. <verse eid="ROM 1:6" /><verse number="7" style="v" sid="ROM 1:7" />Magenoke'n eeyyendineexxi woyyoole kadatee ye'endineenek Roomi giddo hexxineeke duuchchchi'a nage'ekinna badhaadhi Mageno no'oke anninaa'ninna Gootta Yessuusi Kiristoosinaa'n ha'noo'a kadowwaal.<verse eid="ROM 1:7" /></para>
  <para style="s1">Roomii'i Uudatee Pawuloosixxa Halcha</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />Butta duuchcha'n hedheeke manna'n ha'nooxxi amana haaso'endeemmaxxee edisennexxi Yessuusi Kiristoosi ga'mii'ni ha'noo duuchchiingixxee Mageno anka galateefataannen. <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />Duuchchi wodda soodachchoti ha'noo qaabataannexxa, isike Beltixxa wengeele lallabat wo'ma qalbenni ergatemaannek Magen dhuga kula anxen. <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />Iittanni ta'a udunse ha'nobaa dagatee'e fidhii Mageniinxenni ora ani'a qajeelo'a duuchchi wodda soodataannen. <verse eid="ROM 1:10" /><verse number="11" style="v" sid="ROM 1:11" />Jabaatinaashsha ha'noo assitaaxxa Hafuuriinxa uwwa ha'no'aa qoodonaa ha'noo uudatee halchaannen. <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />Tenneenna hiyya anxi ani ha'nooxxe amananni, ha'noonna anxe amananni weli weli dayyeesinnannoshshaten.<verse eid="ROM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13" />Anke dayyuwwaa, Ayihudake kadebaake wele manni giddo heddo Mageno amanaaka manna alfennashshanni iitanni ha'noo giddonna Mageno amanaaka manna alfatee haseennan; yaane kinni ha'noobaa dagatee heddo yanna qixxeefatennexxi ta'i qico hoyyemeennexxa egendino'a eeyyaannen. <verse eid="ROM 1:13" /><verse number="14" style="v" sid="ROM 1:14" />Girkeeke manna kadeekeeri'anna kadebaakeeri'a, beekoleteenna qalbeeffachcho afebaake manni'a magannete afe'eennen. <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />Tennexxeeten, ha'noo Roomi giddo hexxina'neeke'n wengeele lallaba halchaanechchi.<verse eid="ROM 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />Ani wengeelete'n shookabe'no; tinni wengeele ediseexxi Ayihudiinka manna ookkoneechchi uduma Ayihudake kadebaaka duuchcha anjirtaaxxe Mageniinxe hunnanni. <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />Mageniinxa qullumma wengeele kulde'een; «Qullichchi amanat hedhaan» hiyyendeexxi borreesendemmashsha tinni qullumma siretenaa'n muuxamii qico'n kaddeek amanatiten<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">yookaan amanatenaa'n amanatibaa</char></note>.<verse eid="ROM 1:17" /></para>
  <para style="s1">Mannake'n Mageniinxa Mufe</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />Fuggaalessumma ifixxenni dhugaa buqaakeera'n insa'nexxe xaqaro'ninna fuggaalessumma duuchcha'n Mageniinxi mufe iimii'n insa'ne'n daggaan.<verse eid="ROM 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 1:19" />Mageni umo ifingenninni insa'ne Mageniinxee ege'na hassissaaxxa yaane insa'ne'n ifiseemmaxxe insa'ne eettene yaane duuchcha egene'een. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />Buttini dadendee woddinaa'n lellabaak Mageniinki adab, kuinninna duuchchi woddixxi isixxi hunnanna isixxi Magenumma isi dadeexxe dada darree'n ca'a hiteexxi leellitaammaxxee ifi'a balleesaaxxe balleesa'a manni aalataachchi hedhaba'a. <verse eid="ROM 1:20" /><verse number="21" style="v" sid="ROM 1:21" />Insa'ne Mageno egeneenni he'neexxi isoo isixxe magenummaa hasisaaka ulfinnanna galata uunebaan; yaada ifiken wayi fulabaake kande, qalbeefachcho affebaaxxi insa'exxi qalbenna dukkande. <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />«No'o beekoleten» hina'ni gowwolete kande. <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />Duuchchi woddike Magenika gaachchanna reyaake manjixxe'n ci'atixxe'n, horiinxe'ninna godobik me'aachuwwixxe dadaxxe fakke'n jijjiirre.<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />Tennexxee Magen cubboti wo'miteexxe insa'nexxe qalbexxe gaabbenni weli'aan weli ifika biso salphinso'a insa'nee battitte yabaabbule'a sa'isse uwwe. <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />Tinninna kaddeechchi dhugaa Mageniinxa dharake'n jijjiireexxee, dadeeke Magenixxe bakka dademeechcho magenooffanteemmaxxeenna konneechchwwi'a ergateemmeexxeeten. Magen kinni duuchchii woddi'a galateefatemeeken. Hamiin.<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />Tennexxee Mageni insa'nee hara shookkisaaxxe gaabe'a sa'isseexxi uwwe. Melaalle insa'nexxi midde ege'nemeeka maaliinxe afenshaka ora ege'nemebaake'n jijjiirte. <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />Iittanni labbalikinna ege'nendeexxa maaliinxa afensha melaalleti afensha waaleexxi weli'a weli maaliinxe afenshaxxe gaabbenni jammi hiyye. Labbak labbakenni welt shookkishshaaxxa asseexxi tenne ifixxe fuggoxxe hujeexxeenna geltaaxxa mura woxa ifike umo'n adhdhaan. <verse eid="ROM 1:27" /><verse number="28" style="v" sid="ROM 1:28" />Tenne'ni hana insa'ne yaada ifik giddo Mano ege'naa wayi fuldabaan hiyyat assema hassissabaaxxa yaane assinaashsha Magen wayif fuldabaaxxe sammo'a insa'nee sa'isse uwwe. <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />Tennexxee xaqaro duuchcha, fuggoo assaa, kajjeella, haaphphaalessummanna fuggaalessumma insa'ne'n wo'mite; hinaaffee, manjo anga sa'aa, lolemaa, sobinna, shokko assa, insa'nen womiteekeeran; hamataakeera <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />manjo summa balleessaa, Mageno gibaa, manjo yowwaa, hollaa, ifi dukaakeeran, fuggoxxa assatika ora dadaakeeran; hadokee ajajemmabaan; <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />qalbefatabaake, wel aageexxa digaakeera, mararte afebaakeeranna jaba godobike mannan. <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />Tenne yaanuwwa assaaki duuchchi «Reya hassissa» hiyyaaka Mageniika seera egena'inni tennee duuchcha assinaan; tennee assa calla kaddebaak, tennee asso'a welekanna tittirsinaan.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s1">Mageniinxa Qulte Murte</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />Tennexxee weleke'n murta'etek ati gattowaal affebexxon; weleke'n murtatto wodda ati umo atinge'n murtaatte hiyyaten; tinninna iikki muretaatek manaji assa'neemanxe yaane atinna assittaattaxxeeten. <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />Tenne assake duuchcha'ninna Mageniinxi murte seeriinxe kaddeexxa egenneennen. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />Ati iitta assaake manna'n murta'n insa'ne assinammaxxa assittatto wodda ati Mageniinxe murtenaa'ni gattattochcho labbaata? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />Yookaan Mageniinxa marartenna bira saxxeexxa ossunte isixxa tuffattutuuta? Magen ele ifixxa ati'a bira sa'iseek ati aadde aaggota'aate kaddeexxa egendebexxoota? <verse eid="ROM 2:4" /><verse number="5" style="v" sid="ROM 2:5" />Yaane kinni ati aadde aaggo gophatinna godoba jabaatati dhugaatixxi Mageniinxi murte kaddaaxxa barra'a ati ifi'n Mageniixa aare tuu'litaaten. <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />Mageni mitte mittengee'e isixxe huje hujeshanni uwwaan. <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />Eloxxe huje'ni jabaatati galatakanna ulfinna iittanni baxxabaaxxa hedho halsaakeeri'a Mageni duuchchii woddixxa hedho uwwaan. <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />Yaane kinni ifixxa calla halsaakeeria'aanna dhugaa gibeexxi fuggoxxa hordofaakeera'n Mageniixi mufenna aare daggaani. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />Fuggoxxa assaake duuchchiinge'n ediseexxi Ayihudake'n ookkoneechchi uduma Ayihudake kadebaakeera'n rakkonna wixxixxi hiyya kaddaan. <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />Yaane kinni eloxxa assaake duuchchiinge'n ediseexxi Ayihudakee ookkoneechchi uduma Ayihudake kadebaakee galati ulfinnikinna nage'i insa'ne'a kadaan. <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />Tinninna kaddaachchi Mageni manjoke'n ille uushsho assake kada gopheemmaxxeeten.<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />Seera afebaang cubbo hujeek duuchchi seerbelo ba'aan. Seera afeenn hedheexxi cubbo hujeek duuchchi ookkenne seerinninni murte adhdhaan. <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />Tinni kaddeechchi Mageni edo qulliyyete hiyyemaakiir seerakee ajajemeekeera malee seera laqeekeerabaan. <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />Ayihudake kadebaak manni seera afeba'a; yaane kinni seeri ajajaaxxa yaane daduma ifikenn assinamaxxee seera afa gophexxeenna insa'ne umo insanege'ninni seeraken. <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />Sammo insa'nexxi dhugaa insa'ne'n kuldaan; yaadi insa'nekinna insa'nee ku'laan; iittanni insa'nee'a faachefataan; tinninna seer ajajaaxxi yaane duuchchi qalbe insa'nexxe'n borreesendeexxa leellishshaan. <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />Tinninna kaddaak ani wengeeleti birachchiisenneshsha Magen manjinxe qalbe'n sho'ondeexxa yaane Yessuusi Kiristoosi darree'n muraaxxe barra'niten.<verse eid="ROM 2:16" /></para>
  <para style="s1">Ayihudiinka Mannanna Seeraa</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />Ati ta'a «Ani Ayihudichchoken» hitta'etten; Muusseke seera'n irkatta'etten; Mageniinke kaddeetexxeenna hollitta'etten. <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />Ati seerik akeekendetexxi fedhii isixxa egende toggitte yaane foote abixxittootole, <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />ati balla'uwwiinke akeekallo, dukkana giddo hedheekeer'a ifake kaddeettexxa egendootole, <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />konne serinaa'n alfittetexxi ege'nanaa'ninna dhugaanaa'n kexxeexxa ege'nebaakeeri'a gorsalloke annooleteenna barachchiisalloke kaddo'ootole, <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />yoona ati wele barachchiisa'eetek atika umo ifi barachchiisabexxoota? Mortoxxe'e hittetexxi lallabatok ati morta'etekebaataa? <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />Ati manji yaabaabula hassissabaan hittaattek, ati yabaabuldaatekebaata? Ati dharcha mageno diqqattaatek Woyyichcha Galma sanda'etekebataa? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />Ati Mageniinke seerinni hollita'eetek seera diigati Mageno salphisaatekebaata? <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />Tinninna, «Ha'noo Ayihudiinke mannixxe buuttoxxee Mageniink summi Ayihudake kadebaake manni giddo yowwemaan» hiyyendee borreesendemmashshaten.<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />Jila ofodha ati'a la'o affaachchi seerakee ajajendotoleten. Seera diiggotole kinni atixxi jila ofo'la jila offo'la gophatishsha laakko'endaan. <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />Tennexxee jila ofo'lebaak yaane kinni seeri hiyyaaxxa ajajemeeke kadoole jila ofo'la gopha isixxi isi'a jila ofo'le'eeshsha laakko'endabaata? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />Ati borreesemeeka seera affeenni hexxe'e jila ofoldeetenge kadde'e seera diiggotole yaane kinni jila ofo'lebaang seera ajajemaak ate'n muraan. <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />Tennexxee summi callinni Ayihudichchoke kadeek dhugaatike Ayihudichchoba'a; iittanni gadhi darrexxa maaliinke bisixxa jila ofo'la dhugaatixxe jila ofo'laba'a. <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />Dhugaatik Ayihudichchii giddixxe ifixxe hedhonn Ayihudichchoke kade'eeken; dhugaatixxa jila ofo'laa Mageniinke Hafuurinni kaddaaxxe qalbetixxa jila ofo'la malee'e Muuseke seera'n borreesendema qicinni maaliinke bisixxe jila ofo'laba'a. Iitta hedheeke manji galata alfaak Magenokenaa'nite malee'e manjokena'nitebaan.<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="s1">Mageniinxa Xurameessumma</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />Yoonata Ayihudichchi Ayihudake kadebaakemaa'n mayik sa'a? Yookaan jila ofo'latixi la'o maachchota? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />Duuchchiinge orinni la'o heddoten! Duuchchiinxenaa'n taakkaxxi Mageni hiyyichcho ifika Ayihudake'n maganne uwwaten.<verse eid="ROM 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 3:3" />Ayihudikenaa'n mitti mitti amana gophoole, insa'nexxi amana gopha Mageniinxa xurameessumma gattissaataa? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />Haranga gattissaba'a! «Haaso'a atikenaa'n kexxeexxa dhugaalessumma atixxi kokeesendaan; murteti edonna injifatalloke kaddaton» hiyyendee borreesendemaxxee manji duuchchi dharichchake, Magen kinni xurameesake kaduun. <verse eid="ROM 3:4" /><verse number="5" style="v" sid="ROM 3:5" />Yaane kinni no'oxxi cubbo Mageniinxa qullumma leellishshaaxxe kaddeexxenni yoonata maa hiyya dandeennanno? Manjiinxe moromashsha Magen ifixxa mufe no'o'n iyyedaga dhugaat murebaan hiyyateetaa? Tennee hiyya anxi manjiinke yaadishsha hiyyeeten. <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />Haranga iitta kaddaba'a; iittate kadde'eele Magen buttate'n hitta mura dande'a? <verse eid="ROM 3:6" /><verse number="7" style="v" sid="ROM 3:7" />«Yaane kinn anxi dharichchumma Mageniinxa dhugaalessumma hara lumissaaxxe, isika gaachchannanna lebbaaxxe kaddoole cubbaalesake hiyyemennexxi ta'a qico mayee ane'n murendaa?» hiyyat moromaak manji hedhaaxxe hexxeen. <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />Tinniqaa, «Eloxxi kaddaashsha elobaaxxa assino» hina'neen hiyyati mitti miiti manni no'oxxee odeessemmashshaten. Tennexxee konne manna'n murendaaxxi murte dhugaatixxen.<verse eid="ROM 3:8" /></para>
  <para style="s1">Mittikinna Qullichchi Hedheba'a</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />Yoona maa hinanno? No'o insa'naa'n sa'nannota? Haranga waawwo'o! Manji duuchchi Ayihudake kadi Ayihudake kadebaak, duuchchiing cubbot hunda hedheexxa edinseenni kokeesinneennen.<verse eid="ROM 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 3:10" />Hiyyendeexxi borreesendeemma qici, «Mittikinna qullichchi hedheba'a; mitti manjinna midde hedheba'a;<verse eid="ROM 3:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="ROM 3:11" />qalbeefataak mitti hedheba'a;</para>
  <para style="q2" vid="ROM 3:11">Magenonna halsaak mittikinna hedheba'a.<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />Duuchchiing dhugatike orinaa'n fule'een;</para>
  <para style="q2" vid="ROM 3:12">mittemba wayi fullabaake kande'een;</para>
  <para style="q1" vid="ROM 3:12">Eloxxa huje hujaa'neek hedheba'a</para>
  <para style="q2" vid="ROM 3:12">mittikinna midde.»<verse eid="ROM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />«Manjo miidhaaka haaso'a haaso'atee'e afo'i insa'nek moogiinxe baleshsha haanni hiyyeeken;</para>
  <para style="q2" vid="ROM 3:13">arabo ifikenn manjo gurgurra»</para>
  <para style="q1" vid="ROM 3:13">«Suume insa'nexxe'n buutetixxe ha'la hexxe.»<verse eid="ROM 3:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ROM 3:14" />«Insa'neke afo'o'n badinotinna fuggoxxi wo'mite'een.»<verse eid="ROM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />«Lekka insa'nexxi munde dunatee wiinandaaxxen;<verse eid="ROM 3:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16" />Insa'neke ora'ninna ba'netinna abara hexxeen.<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />Nage'iinka ora egenneba'a.»<verse eid="ROM 3:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18" />«Insa'nexxe ille'n Mageno soda'a hexxeba'a.»<verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />Yoonna afo'i duuchchi buqemo'aanna butta duuchcha Mageniinxe murte hunda hexxo'a, seeri haaso'aaxxi duuchchi ookkone seerii hunda hedheekeeri'aate kadeexxa egenneennen. <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />Tennexxee ayyinna Muuseka seera heqqedhat Magenii edo qullichchake hiyyeema dande'aba'a; seeri assaachchi manji duuchchi cubbichchake kadeexxa ege'nishateeten.<verse eid="ROM 3:20" /></para>
  <para style="s1">Amanat Afendaaxxa Qullumma</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />Ta'a kinni Muusek seerinna wabeeko isexxee dhugaa kuldeexxi Muuseke seeri gadhi darre kadde'eexxi Mageniinxi qulluma leellite'een. <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />Tinni Mageniinxu qullumma Yessuusi Kiristoosi'ni amanat afendaaxxe qulluman; gargarumma hexxeba'a; <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />tinninna kaddeechchi duuchchiing cubbo huje'een; Mageniink ulfinninna insa'nenaa'n xe'ye'een. <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />Tennexxee manji Yessuusi Kiristoosi darree'n kaddeexxe wodonni tolanga Mageniinke badhaadhanni qulloome'een. <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />Mageni Yessuusi Kiristoosii'i tolchake asseexxi shiqiseek iso'n amanaak duuchchi isixxe mundenni ifixxe cubboxxa gattowwaal alfo'aaten; Mageni tennee asseechchi edo hujendeemmaxxa cubbo mura woxisebaang osseexxi sa'at ifixxa qullumma leellisho'aaten. <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />Ta'ike barro'n Mageni tennee asseechchi qullima ifixxa tinninna isi umo ifikenni qullichchake kadeexxi Yessuusi'n amanaakaara qulloonsaake kadeexxa leellisho'aaten. <verse eid="ROM 3:26" /><verse number="27" style="v" sid="ROM 3:27" />Yoona ifi duka haba hexxe? Ise gatte'een; hoone seerini? Hujetike sseriniteetaa? Waawwo'o, amanatike seerinite malee. <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />Tennexxee Mageni manjo qulloonsaak manji seera asseexxeete kaddebaak amanatite kaddeexxa kokeesinaannen. <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />Yookaan Mageni Ayihudiinke Mageno callataa? Is Ayihudake kadebaake manni'aanna Magenongebaataa? Eet is Ayihudake kadebaake mannike Magenon. <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />Jila ofo'leeka amanat jila ofo'lebaakanna eettene amananninni qulloonsaak mitti Mageno callan. <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />Iittate kaddooleta amanatixxe buutonni seera wayi fulabaake kadaashsha assinnaannuutaa? Haranga waawwo'o; seera jabeesinaanne malee'e.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s1">Abirihaami Amanat Qulloomeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />Tennexxee no'ok edik maaliink anni Abirihaami maachcho alfee hinnanno? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />Abirihaami qulloomeek hujetite kaddeele, hollaaxxa yaane afe'eemma'a, kaddo malee'e Magen edo holla dande'aba'a. <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />Woyyichchi Maxaafi maa hiyya? «Abirihaami Mageno amaneen; isixxi amananna isi'a qullumate kaddeexxi laakko'ende.» <verse eid="ROM 4:3" /><verse number="4" style="v" sid="ROM 4:4" />Mitti manji hujeexxe huje'a rundi isik isi'a hasisaake hira malee uwwatishsha laakko'emaba'a. <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />Yaane kinni hujebaaka cubbichcha manjo qullichchake assaake Mageno'n amanaake manji'a mana isixxi, isi'a qullumma kadde'ee laakko'endaan. <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />Daawwitinna qullumma huje belo isi'a laakko'endaake manjixxee eebbisensha'a haaso'e wodda hiyyee qic,<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />«Insa'nexxa balleessa Magen insa'ne'a gattowwaali hiyyeek,</para>
  <para style="q2" vid="ROM 4:7">cubbo insa'nexxanna insa'ne'a bireek</para>
  <para style="q2" vid="ROM 4:7">iikki manni insa'ne eebbisemeeken.<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />Mageni isixxa cubbo iso'n laakko'abaak manji</para>
  <para style="q2" vid="ROM 4:8">isi eebbisemeeken.»<verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />Tinni eebbisensha jila ofo'leekeeri calli'aate moo? Yookaan jila ofo'lebaakeerini'aate? «Abirihaamixxi amana Abirihaami'a qullumate kaddeexxi laakko'endeen» hine'eennen. <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />Hittata isi'a laakko'ende? Jila ofo'lebaa edi darre moo yookaan jila ofo'leechchi uduma? Isi'a laakko'endeek jila ofo'lebaa edi darre malee'e jila ofo'leechchi udumaba'a. <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />Abirhaami jila ofo'lebaang isixxi amana isi'a qullumate kaddeexxi laakko'endeexxa kokeesaake beesisa kado'a jila ofo'le. Tennexxee jila ofo'lebaang amanaakeeri'aanna amana insa'nexxi insa'ne'a qullummate kaddeexxi laakko'endaake duuchchiingee annaken. <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />Iittanni Abirihami jila ofo'leekeeri'aanna annaken; jila ofo'leekeeri'aate calla kadebaak anni no'ok Abirihaami jila ofo'lebaa edi darre afe'eemmaxxa isixxe amanaxxa faana hordofaake duuchchiiri'aanna annaken.<verse eid="ROM 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />Butta duuchcha dhaalo'a, Abirihaami'aanna isixxe horte'a Mageni addachchiisa uwweek isi amanati lafeexxe qullunnite malee seera muuxemmaxxeetebaan. <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />Seera muuxaakiiri dhaalanjuwwake kadoole amana la'o affaba'a; iitti addachchiisanna toliinxe. <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />Seeri Mageniinxe mufe iyyedaga; seer hedhebaaba kinni seera sa'atixxe balleesa hexxaba'a.<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />Tennexxee iitti addachchiisa amanat dagge'een; tinninna iitti addachchiisa Abirihaamixxe horte duuchchi'a badhaadhik uwwendeexxe kaddeexxa tennenni kokeesende'een. Tinninna seera horodofaake calli'ate kaddebaak Abirhaamishsha amaneeke duuchchi'aten; konne qicinni isi no'oo duuchchiingik annan.<verse eid="ROM 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 4:17" />Tinninna, «Heddo gosa gosa ardike anna atee assannon» hiyyendeexxi borreesendeemmashaten. Isinna reyeekee hedho uwwaaxxa, hedhebaachchonna hedhaashsha assaaxxa amaneemake Magen edo isi no'oke annan.<verse eid="ROM 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 4:18" />Horte atixxi bira saxxaan hiyyendeexxi iso'n kulendeemma qicinni mitte addachchiissaxxi yanne hexxebaaxxe yanna'n Abirihaami addachchiisate'n amaneexxi heddo gosa gosa ardike anna kade. <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />Isi dhibba woggake manjo kadeenni hedheexxi ifike bisixxanna kadi Saarake gadaameessixxa corco hiyya ege'neenni hedheexxi amanate'n goofeba'a. <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />Tenne caala amanate'n jabaata'n Mageno ulfeesse malee eettene Mageni uwweexxa addachchiisa'n mamaba'a. <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />Tinninna kaddeechchi Mageni uwweemmaxxa addachchiisa muuxa dande'aaxxa wo'ma qalbenni amanemaxxeeten. <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />Tennexxeetemman amana Abirhaami'a qullumate kaddeexxi laakko'endeemmachchi. <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />Yaane kinni «Isi'a qullunma kaddeexxi laakko'endeen» hiyyaaki hiyyichchi borreesemeek Abirhami'a calli'aatebaan; <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />yaane kinni Magen qullumma no'aa laakko'aak Gootta no'oka Yessuusii'i reyotenaa'n ke'isseeke Mageno'n ammanna'enneke no'onninni mittebaten.<verse eid="ROM 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 4:25" />Gootti no'ok Yessuusinna cubbo no'oxxee reyo'a sa'isemeexxi uwwemeeke, no'oonna qulloonsatee reyotenaa'n ke'eeken.<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s1">Amanat afemaaka Nage'anna Gammashsho</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />Yoona amanat qulloommennexxi Gootta no'oke Yessuusi Kiristoosi darree'n Magenik welti nage'a anfeennen. <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />Isi darree'n ta'a uurrineenneke badhaadhibaa amanat e'ya dandeeneennen; Mageniinka ulfinnanna addantennexxi gammandanno. <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />Tenne calla'nite kaddebaak no'oxxe rakko'ninna gammandannon; tinninna kaddaachchi rakkotenaa'n ossa affendaaxxa egenneennexxeeten. <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />Ossatenaa'n jabeenni, jabeennekenaa'n hega uudemeek adab, hega uudemeek adabinaa'n adde afenda. <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />Magen jaalala ifixxa no'oxxe qalbe'n Woyyichchi Hafuur ga'mii'n wonshemaxxee tinni adde no'oo shookkishshaba'a.<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />Ifi gonphende'n he'ne'naa iitti murendeexxi yanna geltee wodda Kiristoosi cubbaaleyyetee reye. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />Qullichchi manji'a reyaaka manjo afa lumooshsha rakkissaan; qajeeli manji'a hiyyeexxi reyatee shene'e hiyyaak manji akimagaada afema dande'aan. <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />Yaane kinn no'o cubbaaleyeende kandeenni he'nennaxxe yanna'n Kiristoosi no'oxxee reye; tinnenni Mageni no'aa afeexxa ifixxa jaalala leellishsha.<verse eid="ROM 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 5:9" />Ta'a munde isixxenni qulloommennexxenni no'o isi darree'n Magenuunxe mufenaa'n hittata caala anjiremagonphannota! <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />No'o Mageniinke naapha kandeenn he'nee'naa Magenik welti isike beltixxe reyonni araarremmennexxenni, araara alfinennechchi uduma isixxe hedhonnita anjirema no'oxxi hittata caala kokeesndeexxe kada gophphata! <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />Tenne callabaan; yaane kinni ta'a araara alfinnenneke Gootta no'oke Yessuusi Kiristoosi darree'n Magenoke'n ifisaandanno.<verse eid="ROM 5:11" /></para>
  <para style="s1">Rewo Addaami Darree'n Hedho Kiristoosi Darree'n</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />Tennexxee cubbo, mitte manjixxe buutonni tenne butta'n e'yittemmashsha iittanni reyotinna cubboti darree'n e'yiteen; konne qicinni reyo manji duuchchibaa dagge; tinni kaddeechchi duuchching cubbo hujemmaxxeeten. <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />Muusek seeri uwwemebaa edi darre cubbo kaba butta hexxeman; kaddo malee seer hedhammabaa wodda cubbo cubbotishsha laakko'endeba'a. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />Yaane kinn Addaamixxe yannanaa'n Muuse qico'n Addamishsha seera enqeexxi cubbo hujebaake duuchcha'n midde reyo mootonde. Addaaminna ookkone dagaake kiristoosike fakkeennamman.<verse eid="ROM 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 5:15" />Yaane kinni Mageniinxi uwwa eettene qaxaamurixxe qixxeshshateba'a. Mitte manjixxe cubboxxee heddi manni reyechchinni, Mageniink badhaadhinna mitte manjinni, kuninna Yessuusi Kiristoosike badhaanni daggeexxi iitti uwwa hittata heddi manni'a caala bira sa'a gophphata! <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />Iittanni, Mageniink badhaadhi mitti manjixxi cubbo iyyedaggaaxxe yaanenni mikemakebaan; tinninna iitti murte mitte manjixxe cubboxxe buuto'a murte uwwende, yaane kinni iitti uwwa heddo balleesaxxe buuto'a qulluma iyyedagge. <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />Mitte manjixxe balleesaxxe buuttonn reye ookken manji darree'n mooteexxe kaddoole Magniinka hara bira asa'eeka badhaadhanna qullummatixxa uwwa adheekiir, ookkone mitte manjo Yessuusi Kiristoosi darree'n hittata caala hedho moya gophphata!<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />Yoona mitte manjixxe balleesanaa'n kexxeexxa murte duuchchingee manjo'n murendeemmashshanni, iittanni mitte qullichchixxe hujenni manjo duuchchi'a hedho uuttaaxxi qulluma afende. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />Ookkone mitte manjixxe ajajema gophabaa'ni kexxeexxa heddi manni cubbaleeyyete kadeemmashshanni iittanni mitte manjixxe ajajenshanaa'n kexxeexxa heddi manni qullichchake kada. <verse eid="ROM 5:19" /><verse number="20" style="v" sid="ROM 5:20" />Seeriinxe uwweshshanni qaxaamura bira saxxe. Yaane kinni cubbo bira saxxeexxe qixxe'n badhaadhi caala bira sa'eeke kade. <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />Tinni kaddeechchi cubbo reyoti darree'n mootteemmashshanni iittanni Yessuusi Kiristoosi darree'n duuchchi woddixxe hedho afendo'a badhaadhi qullummat moyo'aten.<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s1">Cubbote Reyat Kiristoosi'a Hedhaa</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />Yoona maa hinnanno? Badhaadhi bira sa'aashsha cubbo hunja'ni he'noo? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />Haranga waawwo'o, no'o cubbotee renneennen, hittata edi'a cubbo hunja'n he'nanno? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />Yessuusi Kiristoosinni welti mitteke kandonna'a xammaqqemmeennek duuchchi, isixxe reyonni mitteka kandonna'a xammaqqemmennexxa egendineebaata? <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />Tennexxee Kiristoosi Aabike ulfinninni reyotenaa'n keemmashshanni iittanni no'onna haaroxxe hedhonni he'nonnaa xammaqematixxe reyonni isinni welti mooggemmeennen.<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />Isixxe reyonn isinni welti mitteke kandennechchinni isixxe ke'anni iittanni isinni welti mittoommannoxxi kokaken. <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />Yoona cubbotixxe garboole kandabe'noshshanna no'oxxi cubbotixxi manjumma baxxaashsha dullate no'oxxi manjumma Kiristoosinni welti fannisendeexxa egenneennen. <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />Tinninna kaddaachchi reyeek manji cubbotenaa'n leexa fuleemmaxxeeten.<verse eid="ROM 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 6:8" />Yoona Kiristoosinni welti renno'oonnole isininni welti hedhoti he'nannoxxa amanaannen. <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />Kiristoosi reyotenaa'ni keemmaxxee, langaxxa reyabaaxanna reyo iso'n langaxxa mootabaaxxa egenneennen. <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />Isi cubbote langaxxa reyabaa qicinni mittele reyedheen; ta'a hedhoti hedhaa kinni Magnokee hedha. <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />Iittanni ha'no cubbotee rertine'eeshsha, yaane kinni Yessuusi Kiristoosi darree'n Magenokee hedhoti hexina'neeshsha ifi uudde!<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />Tennexxee fuggoxxa isixxa halcha muuxxino'a reyaake ha'noke maala'n cubbo mootaashsha assitnoqqe'e. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />Iittanni ha'nooke bisika qooluwwa fuggoxxa assatike miya assitineexxi cubbotee shiqishshinoqqe'e; Yaane kinni reyotenaa'n kexxineexxi hedhoti hexxineeshsha ifi uudati Magnokee ifi uwwe; ha'noxxe bisika qooluwwanna qullumatike miya assitine Magenokee ifi shiqishshe. <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />Ta'a ha'no hexxina'neek badhaadhi hunda malee'e Muuseke seeri hunda kada gophpheemmaxxee cubbo ha'no'n mootoqqe'e.<verse eid="ROM 6:14" /></para>
  <para style="s1">Qullummatika Garba</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />Yoona heente kadda? Seeri hunda kada gophati badhaadhii hunda he'nennexxee cubbo hunjoota? Haranga waawwo'o. <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />Mitte manji'a garbake kaddine ajajendino'aa ifi uutinaa wodda ookkone ajajendina'neeke manji'a garba kaddineexxa egendineebaata? Iittanni cubbotee ajajendinaa wodda reyote'n ha'noo geessissaaxxe cubbo'a garbake kaddinaan; Magenoke ajajendinaa wodda kinni qullumma alfitinaan. <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />Yaane kinni ha'no edo cubbotixxe karboole kadineemmake kaddinoole midde ta'a adhitineexxe barachcho'a wo'ma qalbenni ajajendineeke kaddineemmaxxee galat Magenokee kadowwaal. <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />Cubbitixxe garbumanaa'ni leexa fuldineexxi qullummatixxe garboole kaddine'een.<verse eid="ROM 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 6:19" />Ha'no maalik qalbeefachchotixxe gonphe affineemmaxxee manjiinke haaso'ishsha haaso'aannen. Edo ha'no ha'noke bisika qooluwwa garbummati battumateenna bira saxxa'n me'itaaxxe fuggaalessuma'a shiqishinenmashshanni iittani ta'a ha'nooke bisik qooluwwi qullooma'a qullumatike garba assine shiqishshe. <verse eid="ROM 6:19" /><verse number="20" style="v" sid="ROM 6:20" />Cubbote'e garbake kadineemma wodda qullumatenaa'n leexa fuldineemman. <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />Ta'a ha'no itti shookkina'neexxe yaane'n ookkone wodda isenaa'n maa la'o afineemma'a? Eettene yaanek muuxami reyoten. <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />Ta'a kinn cubbotixxe garbumanaa'ni leexa fulat Magniinke erganjuwwa kadat qullumma alfitinaan; qullummati muuxaminna duuchchi woddixxe hedhon. <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />Cubbotik rund reyote. Mageniinxi uwwa kinn Gootta no'oke Yessuusi Kiristoosi darree'n duuchchi woddixxe hedhon.<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s1">Seerakenaa'n Tikeme'enexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />Anke dayyuwwaa, seera ege'neeke manna'n haaso'aannen seer mitte manjo'n baallooma afaak manjichchi hedhot hedhee qico calla kaddeexxa egendinebaata? <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />Fakkeenakee, mitte heerundeexxi manjichcho ifike aro'inni seerik userendaak isi hedhoti hedhee qico'niten; aro'i isek reyoole kinni ookkone aadha heerumatike Muusek seerinaa'n tikende'een. <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />Tennexxee aro'i isek hedhoti hedhe'na'a wele labballo'n heerundoole yabaabultote hiyyendaan, aro'i isek eryena'a wele laballo'n herundoole kinni aadha herumatike seerakenaa'n tikendemaxxe yababultote hiyyendaba'a.<verse eid="ROM 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 7:4" />Tennexxe anke dayyuwwaa, ha'nonna Kiristoosike bisidarre'n seerake rertine'een; tinninna no'o Magenoke guma guminsona'a, ha'no wele ookone reyotinaa'n ke'eke isike kaddino'aten. <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />Maalnxe fedhi hunda gallana wodda reyote gumma gummisanosha seer dammaseexxe cubbotixxi halcha no'oke bisinke qooluwwa'n hujja'eman. <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />Ta'a kinni ediwodda no'oo'o ookene usuremake'e rennexxi seerakenaa'n tikeme'enen; tinninna dullacha borresemamake seernte kaddebaak haaroke kade'eeke Hafuurke orni ergatemona'aten.<verse eid="ROM 7:6" /></para>
  <para style="s1">Cubboti Wolaancho Abixxa</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />Yoona maata hinanno? Seer umo ifiken cubboteeta? Haranga waawo! Yaan kinni seerndarre'n kadagophe'a silat cubbo maacho kaddeexxa ege'nanaba'a. Seer «Gaabbitoxxe» hiyyagophe'a gaabbe maacho kaddeexxa hara ege'nannaba'a. <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />Cubbo kinni seer darre'n qo'a alfite ani giddo duuchinxe fuggoxxa gaabbe dammasitte; seer hedhgophe'a cubbo reyeechoman. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />Seer hedhemaba wodda ani umo anigee'e hedhoti hedhanan, seernk ajaji dagee wodda kinni cubbo hedho alfite; ani kinni reyenne. <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />Hedhotee uwwemeek seeriink ajaji ane'n reyo idageexxa ege'nenne. <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />Cubbo seer darre'n afemeeka qo'a alfeexxi anee sobbe; seerindarre'ninna ane'e shilte.<verse eid="ROM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12" />Tennexxe Muusk seer woyyichchake, ajajikinna woyyichake, qullichakenna eloke. <verse eid="ROM 7:12" /><verse number="13" style="v" sid="ROM 7:13" />Tinni eloxxe kaddexxi yaaneta ane'ni reyo idagge hiyyoteeta? Haranga waawo! Yaane kinni cubbo cubbumati egendo'a eloxxe kaddeexxe yaane ane'n reyo idagge; tinninna cubbo ajajidarre'n qubasaxxashaten.<verse eid="ROM 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />Muusek seer hafuurnxe yaane kadeexxa ege'neenen, ani kinn cubbotike garba kadona'a gurguremeenek maalinke manjon. <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />Ani maa assa'enexxa ege'nebe'no. Tinninna eeyanexxa yaane assa waalenexxi eetene jibbanaxxa yaane assa'enaxxeten. <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />Assa eeyabe'noxxa yaane assanole seer elocho kadeexxa adhdha'enne. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />Iitate kaddeechinni tenne assa'eenxi ani giddo hexxa'nexxe cubbo male anteba'a. <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />Ane'n yookaan cubbalessa kadeeke anke cubbichi dadumi giddo eloxxi mitti yaanenna hexxabaxxa ege'ne'enen; eloxxa assatee halcha afe'enen yaane kinni eetene yaane assa dande'abe'no. <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />Assanexxi assona'a halchenexelxe eloxxa yaaneba'a; yaane kinni asson'a hasebe'noxxe fugguxxe yaane assanon. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />Assona'a hassabenoxxa yaane assanelchinni tenne assa'enek ante kadebe'nok ani giddo hexxa'nexxe cubbon.<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />Yoona eloxxa assa eeya'ni fuggoxxa assa'enechinni kunni cubbotik seer hujate'n hedheexxa age'nenen. <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />Ani giddixxe anxe hedhonni Mageniike seera'n gammadanne. <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />Yaane kinni anke bisike qooluwwi giddo huja'neeke cubbotik seer'a ane'e booji'emanosha assaak, anxe sammoke seern welt lolemaak wel seer anke bisike qooluwwi giddo huja'na'a uda'enen. <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />Isi ani hitata cuqurto'eneke manjike manjo! Konne reyote uwwemeeke bisinaa'n ayete ane'e anjira? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />Gootta no'oke Yessuusi Kiristoosi darre'n galti Magnoke kadowaal.</para>
  <para style="p" vid="ROM 7:25">Yoona ani sammo anxenni Magenke seerke garba kadenexxi anke cubbichi daduma'n kinni cubbotike seeri'a garban.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s1">Woyyichcha Hafuura'n Akeekenda'neexxa Hedho</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />Tennexxe Yessuus Kiristoosi'n hedheekri'a ta'a insa'n murendaba'a. <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />Tinninna kaddeechi hedho uwwak Woyyichchi Hafuur seer Yessuusi Kiristoosi darre'n cubbotike seernaa'ninna reyotike seernaa'n no'o'o tikemaxxeten. <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />Seer, maalnke dadumike adabinaa'n keexxeexxa ifigopheexxi assatee dande'agopheemaxxa yaane Mage belto ifika cubbote tolchemo'a cubbichi maanlxe fakke'n ergiyot ookkone isike maala giddo cubbote'n mure. <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />Tinneneenna asseek no'o'o maalnxenite fedhenite kaddebaag Hafuurxe fedhinni he'naa'neke'n seer hasa'nexxi qulluma womaqicinni muuxendo'aten.<verse eid="ROM 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 8:5" />Maalnxe fedhisha hedhaakir qalbe ifixxa maalinxe halcha'n uggura; Hafuurnxe fedhisha hedhaakir kinni qalbe ifixxa Hafuurnxe halcha'n uggura. <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />Malnxa yaane hediyyo reyoten. Hafuurinxa yaane hediyyo kinni hedhotenna nage'aken. <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />Tennexxe maalnxa yaane hedaaki manji Magenoke naaphan; isinna Magenoke seeri'a hiremaba'a, hiremanna dande'aba'a. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />Manlxe fedhisha hedhakir Mageno gamachiisa dande'aba'a.<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />Ha'no kinni Magenk Hafuur ha'no giddo hedheexxe kaddoole maalnxe fedhishate kaddebaag Hafuurnxe fedhisha hexxina; ayyinna Kirstoosika Hafuura afebaak is Kiristoosi keba'a. <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />Yaane kinni Kiristoosi hano giddo hedhoole bisi ha'noke cubbotixxe buuto'a reyeeke kadoolenna irri ha'nok kinni qullumatee buutonni hedhoti hedha. <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />Yessuusi'i reyotenaa'n ke'iseek isik Hafuur ha'no giddo hadha'noole, Kiristoosi'i reyotenaa'n ke'iseek ha'no giddo hedha'neeke isike hafuur reyaake ha'noek maali'a hedho uwwaan.<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />Tennexxe anke dayyuwwa no'o idake anfe'ene; yaane kinni kunni idi maalnxe fedhisha he'nonna maalaketabaa'a. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />Malnxe fedhisha hexxinoole rertinaan; yaane kinni Hafuurk maalnxa huje shiltinoole hedhot hexxina. <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />Tinni kaddaachchi Mageniik Hafuurnni akeekemaak duuchchi Magenxe oose kademaxxeten. <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />Soda'ati hexxinaasha haaroba ha'no'o garbake assaaka Hufuura adhitine'ebaan; yaane kinni adhdhitineek Hafuur, «Annayyo» hitina'n yexxinaasha assaake beltumatika Hafuuran. <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />Mageniixe oose kandeenexxa iikki Hafuur no'oke irrni welt mitteba higeexxi dhuga kula. <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />Yoona Mageniinxe oose kandeenexxinni no'o isike dhaalnjuwanni, ittayotinna no'o Magenke dhalnjuwwan; Kiristoosinni weltinna dhaalanon; ta'a Kirsitoosn welti rakko adhinonole uduma iska ulfinna isin welt adhdhinano.<verse eid="ROM 8:17" /></para>
  <para style="s1">Hegerka Ulfinna</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />Konne barrixxi rakko edi'a no'o heqita'neeke ulfinni welti hergendoole mittelchishanna lakko'endabaaxxa ege'ne'ene. <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />Dada duuchcha Mageniixxe oosexxe leella lumoxxe halchanni heqqexxa'nen. <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />Dada duuchchi way fulagophate'e hirendaashsha assende'een; Tininna dada fedhi ifixxenite kadebaak addet hirendaashsha assikixxe fedhinten. <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />Tinni addachisanna dada umo ifikeninni ba'netixxe garbuntenaa'ni leexa fuldeexxi Mageniixxe oose kadaaxxe leexumaba'anna ulfiniba'a geltaashaten.<verse eid="ROM 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 8:22" />Telchiqico'n dada duuchcha cintoti wixxiyanni aadiyyote'n hexxeexxa egene'enen. <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />Yaane kinni aadiyyote'n hexxexxi dada calla kaddebaag no'onna uminxa Hoyyichchi Hafuurxa gumma alfinenek Magenxe oosumake ulfinna kade'eeka biso no'okixxa wodensha halchaati heqe'na'n ifik giddo aanda'enen. <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />No'o tenne addachisaan anjirem'een; yaane kinn addantaxxi leeltaaxxe yaane kadoole addeteba'a. Anga hexxeexxa yaane aate adde assedhata? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />Yaane kinni anga no'oxxen hexxebaan yaane addantole, eetene yaane ossunteti heqqe'nanon.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />Iittanni Hafuur ifi gonphe no'oxxe'n no'o'o gargaraan; no'o hitta soodata haasissaqico ege'nagonbe'no; Hafuur kinni tennete hiyyeme haaso'emabaake ornni no'oxxa bado aadinoti no'o'a sodataan. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />Qalbe no'oxxa qorqooraak Magen Hafuurnka yaada ege'nedhen; tinninna kaddaachchi Woyyichchi Hafuur Manjixxe fedhisha woyyolete insa'nexxa bado insa'ne'a soodatamaxxeten.<verse eid="ROM 8:27" /></para>
  <para style="s1">Injifatemakerinnaa'n Caala</para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />Mageno eeyakeri'a isixxe fedhisha ye'emeekeri'a Magen yaane duuchchi insa'ne'a eloxxe kaddasha assaaxxa egen'enen. <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />Tinninna kaddeechchi Magenik edise ege'nemakar Belto isika lanbasha ediseen mure; tinninna heddo dayyuwwi giddo isi angafake kadaashaten. <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />Belto isika lanbasha ediseen muremakaranna ye'e, ye'emakaranna qullonse, qullonsemakara ulfeesse.<verse eid="ROM 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />Yoona tenne yaane'a maa hinanno? Mageni no'onni welti hedhoole ayyete no'o gareera? <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />Ifike mitte belti'a mararebaang no'o duuchchinge iso'o sa'ise uwweexxenni hitata belto ifiken welt duuchinxa yaane no'o'a tola uwwagophata? <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />Mageni fi'leeka manna aate insa'ne kula? Insa'ne'e qullonsaak Magenoken. <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />Insa'ne'n muraak aateta? Reyeek reotenaa'ninna ke'eek, Magenike midda'n ofoolek, Kiristoosi Yessuusi no'oxxa bado no'o soodataan. <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />Kiristoosixxe eeyumanaa'n no'o gargar hissa dande'aak ayye ayyike? Rakko yookaan wixxiyya yookaan shorsha yookaan solo'i yookaan daar yookaan sodachisaxxi yaane yookaan wolaantchake? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />Tinninna «Atixxe barra barra'ninni renne gantenne; dullamaake gedhebisha kandenne laakko'emenne» hiyyende borreesendemashshaten. <verse eid="ROM 8:36" /><verse number="37" style="v" sid="ROM 8:37" />No'o'o mittilchinna gargar hissachi hedheba'a; no'oo eeyeke Kirstoosinni konnechuwwa duuchcha injifachot injifatemakernaa'n sa'nanon. <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />Reyoteena kaddo hedho, ergana kaddo duriisa<note caller="+" style="f"><char style="fr" closed="false">8:38 </char><char style="ft" closed="false">Duriis iimatixi hunnuwwa, ta'axxenna kaddo daggaaxxi yokaan hiinni hunnuwwanna kaddi.</char></note> <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />xungot kaddo dhi'mo yookaan hiini dadana Gootti no'ok Yessuusi Kiristoosi darre'n alfinenexxe Mageniinxe eeyuntenaa'n mittichinna no'oo gargar hissachi hedhebaaxxa wo'meenen.<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s1">Phawuloos Arda Ifikee Hitta Wixxixxiyyeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />Ani Kiristoosike hedhenexxi dhuga haaso'no; sammo anxi Woyyichchi Hafuurinni ani dhara hasisabe'noxxa ane'n kokesitaan. <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />Jabaxxi yaadonna uurcho affebaaxxi wixxixxiyya qalbe anxe'n hexxen. <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />An anke dayyuwwa kade'eke anke ardixxe hiyye badinemeke kadonanna Kiristoosinaa'n gargarg higeexxi unemeeneke kadona'a ee'ya'enan. <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />Kaunni maninna Isira'eelike ardan; Magenxe oose kada, Magenke ulfina leella, kako aaggo, seernxi uwwensha, Woyyichi galmix aadanna addachiisa uwwendeemak insa'ne'atenman. <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />Edik annuwwinna insa'neken; maaldarre'n Kiristoosinna dageeke insa'nenaa'nten; isi duuching cala kadeeke duuchchi woddi'a saademeeke Magenon; Ameen.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />Yaane kinni Magenk hiyyichchi jijiremeen hiyyoteba'a; Isira'eelixxe sannenaa'n ilemeeke duuchhci Isira'eeliteba'a. <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />Iittanni Abirihaamixxi sanne kadeek duuchchi isixxe ooseba'a; tinninna kadagophe'eechi Mageni Abirihamii'i, «Horte atixxi Yisaaqi darree'n ye'endaan» hiyyemaxxeten. <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />Iittayyo Magenxe oose hiyyemeek Abirihaamike gudeedixxi horte kaddebaag isixxe horte hiyyendaaxxi addachiiatike hiyyichchixxe oosen. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />Tinninna kaddeechi «Yanna geltoole higee daganon; Saaranna labba belto ildaan» hiyyendemaxxeten. <verse eid="ROM 9:9" /><verse number="10" style="v" sid="ROM 9:10" />Tenne calla kadebaag Ribqaxxi oose mitte anna afe'en; isinna anna no'oke Yisaaqiten.<verse eid="ROM 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 9:11" />Iitti lakkanno ilndebaang yookaan elo yo'oxxa assitebaang Magnk yaadi filati kadaasha, <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />hujet darre'n kadebang ye'ak darre'nte kaddaammaxxe «Angaf maa'nake ergatemowaal» hiyyende ise'n kulende. <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />Tinnanna, «Ya'iqoobi eeyyenne, Eesawu kinni gibene» hiyyende borresendemashaten.<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />Yoona maata hinanno? Mageni gamisaata? Harnga waawo. <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />Tinninna kaddeechi Mageni Muuse'n, «Mararona'a haseneke maranon; owwona'a haaseneke owwanon» hiyye'eman. <verse eid="ROM 9:15" /><verse number="16" style="v" sid="ROM 9:16" />Yoona tinni manjiinke hasitisha yookaan hujeshate kaddebang Magenxe mararteshaten. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />Tinninni kaddeechi Maxaafi Feri'oonixxee, «Hunna anxa ate'ni leelishatenna summi anki butta duuchcha'ni ege'nemasha ate'e tennexxee motatosha assene» hiyyemashaten. <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />Tennexxe Magen mararo'a haseeke marara, godoba jabeso'a hasaaka godoba jabeessa. <verse eid="ROM 9:18" /><verse number="19" style="v" sid="ROM 9:19" />Ha'no giddii'ni mitti ane'e, «Magenixa fedhi giba dandeesisa gophenexxinni Mageni mayeeta manjo ta'iqico aalata?» hiyye qoraak hedhaxxe hexxeen. <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />Yaane kinni koo manjo ati Magenoke'n mornshatika hissicho haasotota'a isi aate? Mitte huje isee hujemaka manjo, «Maye ane'e tenne bifa'n» hujjete hitata? <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />Yookaan faarinka miyik hujall mitti miya ulfaatexxe bakka'a mitti kinni anfeeba uggumaaka miya giisatika baaloma afebaata? <verse eid="ROM 9:21" /><verse number="22" style="v" sid="ROM 9:22" />Mageni mufe ifixxa ege'nisho'anna hunna ifixxa leelisho'a haseexxi mufe ifixxa insa'ne'n leelishaaka, ba'nete qixxesemeeka manna insa'ne osu'u maa egendette? <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />Tenneena asseechi ediseexxi ulfinnixxe bakka'a qixxesemake ookkone mararte ifixxa leelisha'neke manna'n ifike ulfixxi duruma ege'nedo'a asso'oolena'a maa egendette? <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />Magen ye'eek Ayihudike manni calla kaddebaak no'o Ayihudake kadebe'nokenabaata? <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />Tinninna Hoose'i giddo</para>
  <para style="q1" vid="ROM 9:25">«Anke arda kadeemabaaka, ‹Anke arda!› hiyyee'e ye'anon,</para>
  <para style="q2" vid="ROM 9:25">eeyemebaaka anka arda ‹Eeyemeke› hiyyee'e ye'anon» hiyyendemashaten.<verse eid="ROM 9:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="ROM 9:26" />Insa'nenna, «Ha'no anke ardabaan</para>
  <para style="q1" vid="ROM 9:26">Hiyyeme kullememake ookone booncho'ni,</para>
  <para style="q2" vid="ROM 9:26">‹Heddoke Magenxe oose› hiyyeme</para>
  <para style="q2" vid="ROM 9:26">ye'emaan» hiyye.<verse eid="ROM 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 9:27" />Issayaasinna Isira'elixxee'e hafuura gikkaseexxi hiyye haaso'eqic:</para>
  <para style="q1" vid="ROM 9:27">«Isira'eelike ardik laakkossi abbayatike maanchishsha bira sa'ollenna</para>
  <para style="q1" vid="ROM 9:27">Insa'nenaa'n hafe calli anjirendaan.<verse eid="ROM 9:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ROM 9:28" />Tinninna Gotti murte ifixxa</para>
  <para style="q2" vid="ROM 9:28">butta'n rakeexxi muuxaminxe yanna'n muraan.»<verse eid="ROM 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ROM 9:29" />Tinnina edo Issayaasi,</para>
  <para style="q2" vid="ROM 9:29">«Dada duuchcha ajajaak Duuchchi Woddik Gootti no'aa horte gatisa gopheele</para>
  <para style="q1" vid="ROM 9:29">Soodomishsha kandeenan</para>
  <para style="q2" vid="ROM 9:29">Gomoranna sila fakkantenan»</para>
  <para style="q1" vid="ROM 9:29">Hiyye'e haso'emashate.<verse eid="ROM 9:29" /></para>
  <para style="s1">Isira'eelke Manxa Amanagopha</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />Yoonata maa hinanno? Amanat dagaaxxa qulluma, qulluma alfatee elo'ebaak Ayihudake kadebaak manni alfe. <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />Yaane kinni seera heqecat daggaxxa qulluma halsemak Isira'eeli ardi eetene qullumma alfeba'a. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />Tinni mayee kadde? Insa'ne'e qullumma alfate hanseek amanatite kaddebaak hujeti kaddesha halsenemaxxeten. Tennexxe insa'ne gufotike kinjo'n gufante. <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />Tinninna</para>
  <para style="q1" vid="ROM 9:33">«Kunse manjo gufatasha assaaka kinjo Tsiiyooni'n uggurannon;</para>
  <para style="q2" vid="ROM 9:33">iso'nininna amanaaki shookabaan» hiyyende boresendeshaten.<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="s1">Isira'el Mageniika Ora Hordofa Gopheexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />Anke dayyuwwa Isira'eelixee anxe qalbexxi halcha Magenokanna soodataannek insa'ne anjirremaashaten. <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />Insa'ne Magenoke hinaafa'nexxa insa'nexxe dhuga kula'nen danda'anon; yaane kinni insa'nexxi hinaafe ege'nabeloxxe. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />Mageniba'n daggaxxa qullumma ege'nagopheyyotinna ifika qullummaika ora halsa hanseexxe Mangexxee qulluma ifi uuneba'a. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />Iso'n amanaak duuchchi anjiremo'a Kiristoosi seeriinke muuxaman.<verse eid="ROM 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />Muuse Seerdarre'n daggaaxxe qullumaxxee «Seer ajajeexxa assaak ookkone seern hedhaan» hiyye'een. <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />Amanati daggaxxi qulluma kinni hitaaqic, «Qalbe giddo, ‹Ayyete iimi'a me'a?› hitoxxee!» Tinninna Kiristoosi'i iimi'n dirrisaten. <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />«Yookaan, ‹Qalbe giddo wiiddi hundixxe balle'n butta ayyete mara?› hitoxxe, tinninna Kiristoosi'i reyotenaa'n ke'isateeten.» <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />Higgeen hiyyende borreesendeeqic, «Magenk hiyyichchi iti bira hedheen; matanga afo'o atoke'ninna qalbe atixxi giddo hedheen» kunninna no'o lalanba'eneke amanatike hiyyichon.<verse eid="ROM 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 10:9" />«Yessuusi Goottaken» hite'e afo'i atikenni dhugaa kuldotole, Magenikinna iso'o reyotenaa'n ke'iseexxa qalbe atixxi giddo amandotole anjirendatto. <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />Tinninna kaddeechchi manji qalbe ifixxi giddo amanoole qulloma, afo'o ifikeninna dhugaa kuloole anjiremamaxxeeten. <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />Woyyichchi Maxaaf hiyya'neqic, «Iso'ni amanaak duuchchi shookaba'a.» <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />Ayihudikenna Ayihudake kadebaake mannixxe oddo'n gargarumma hexxeba'a; iikki mitti Gootti duuchingike kademaxxe isoo ye'akaka duuchchanna birasa'ise eebisa. <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />Tinninna kaddeechchi, «Goottinka summa ye'aak duuchchi anjiremaan» hiyyende borresendemaxxeeten.<verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />Amannebaakata hitta isoo ye'a dandeena? Lsixxe lanqebaank hitta iso'n amana dandeena? Insa'ne'n lalabaak hedhebaak hitta laqa dandeena? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />Ergemmebaak hitta lalaba dandeenna? Tinninna, «Eloxxa odo lalabaake mannixxa daga hittatta oloxxe» hiyyendeexxi borresendemashaten. <verse eid="ROM 10:15" /><verse number="16" style="v" sid="ROM 10:16" />Yaane kinn Issayaasi, «Anke Gootta no'oxxa erga ayyete adhdhe?» hiyyeexxi haaso'emashaqicinni tenne eloxxa odo duuchchi adhdheba'a. <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />Yoonna amana daggaak erga lataqatenaa'nten; tinni ergak hiyyichinna Kiristoosixxe kulemeeke hiyyechinaa'niten.<verse eid="ROM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 10:18" />Ani qore, insa'ne hiyyicho lanqeeban hiyyoteteta? Dugaten, laga lanqeneen;</para>
  <para style="q1" vid="ROM 10:18">«Hiyyichchi insa'nek butta duuchcha'n laqis,</para>
  <para style="q2" vid="ROM 10:18">haaso'i insa'nekinna buttatixxe gabalaqico'n geye.»<verse eid="ROM 10:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />Higeenn qoro, Isira'eelik ardi qalbefatebayoteeta? Muuse eediseen,</para>
  <para style="q1" vid="ROM 10:19">«Anke arda kadebaake ardinni ha'noo hinaafinshsha assanon;</para>
  <para style="q2" vid="ROM 10:19">qalbeefatabaake ardinninna ha'no mufachiisano»<verse eid="ROM 10:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />Issayaasinna, «Ane'e hasebaake manni'a afemenne, qorebaakeri'anna leellenne» hiyye afo'o wo'me haaso'edheen.<verse eid="ROM 10:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21" />Yaane kinni Isira'eelike ardixxee isi, «Ajajemabaakenna</para>
  <para style="q2" vid="ROM 10:21">xaqartchi ardi anibaa dagaasha insa'neba'a</para>
  <para style="q2" vid="ROM 10:21">barra duuchcha anga anxa diriirisene» hiyya.<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s1">Magen Isira'eelka Arda Haranga Wale'ebaaxxa</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />Yoona higeenna laqoo! Mageni arda ifika wale'eeta? Harnga waawwo'o, ani umo angeninni Isira'eelichcho Biiniyaamike gosati minike Abirihaamixxe horten.<verse eid="ROM 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 11:2" />Magen edise fi'lemaka arda waale'eba'a. Eelyaasi Isira'eelika arda Magenoke'n ku'lemaxxa Woyyichchi maxaafi isixxee maa hiyyeexxa ege'nagophitnaata? <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />Goottaa, wabeeko atixxa shine'een; tolchimalchuwwa atikaranna diinge'een; ani calli qofigatenen; aneneenna shino'a hansa'neen. <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />Yaane kinni Mage maata hiyye iso'n hisse haaso'e? «Ba'aal sagadebaka torbaane kuma manna ani ifi'a gatlseenen» hiyye. <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />Ta'ike barro'inna iittanni Magen badhaadha ifike'n fi'leexxi hafe hexxeen. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />Yoonna badhaadhikete kaddoole hujetiteba'a. Hujetite kadde'ya badhaadhi badhaadhake kadda silat gate'eman. <verse eid="ROM 11:6" /><verse number="7" style="v" sid="ROM 11:7" />Yoona maachota? Isira'eeli jaba qicinni halsiteecho alfiteba'a; fi'leemake manni kinni alfe; wel mannixxi qalbenna dillootte.<verse eid="ROM 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 11:8" />Tinninna konechi butti'a hiyyende borresendeqic,</para>
  <para style="q1" vid="ROM 11:8">«Ille insa'nexxi affabaashsha</para>
  <para style="q2" vid="ROM 11:8">mansha insa'nexxinna laqqabaashsha</para>
  <para style="q2" vid="ROM 11:8">Magen telchqio'n</para>
  <para style="q1" vid="ROM 11:8">Dillo'atika irra insa'ne'n woccasse»<verse eid="ROM 11:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="ROM 11:9" />Daawwitinna hiyyeqic:</para>
  <para style="q1" vid="ROM 11:9">«Qore insa'nexxe'n insa'ne abidaxxe foxoronna ribbo</para>
  <para style="q2" vid="ROM 11:9">itti gugufanta guffonna assineexxe fuggoxxeenna insa'neke hira kaddowwal.<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />Ille insa'nexxi affabashanna himmitowwal!</para>
  <para style="q2" vid="ROM 11:10">hidhi insa'nekinna duuchchi woddi'a xukkowaal.»<verse eid="ROM 11:10" /></para>
  <para style="s1">Meshqendeexxi Damuwwaxxa Illeema Hige Lattaaxxa</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />Ayihudoot gugufate ibeeke ke'abaqico'niteta? Hiyye higgen qoraane? Harnga waawwo; yaane kinni Isira'eel hinaafasha assatee insa'nexxe balleesaxxe buutonni Ayihudake kadeebake manni'a anjirasha dagge. <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />Yaane kinni balleessa insa'nexxi buttate eeba idaggeechinni insa'nexxi ibanna Ayihudake kadebaake manni'anna eeba idageechinni insa'nexxi womaqicinni i'leema higa hiteqicota birsaxxexxa eebba idaguta!<verse eid="ROM 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />Koo Yihudake kaddinebaake manna ta'a ha'no'n haaso'enen; ani Ayihudake kadebaake mannike ergamallo kadennexxenni ergatensha anxa lumisannon. <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />Tinninna anka manna hinaanfaashsha damasennexxe insa'ne giddii'n heenoka manna anjiranoxxa addateten. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />Insa'nexxi waalensha buttate'e aarara idageechinni insa'nxi Magenoke'n adhdhensha reyotenaa'n ke'atishaten hiyyati gadhidarre wele maayya dandeesisata? <verse eid="ROM 11:15" /><verse number="16" style="v" sid="ROM 11:16" />Mitte liixxenaa'n umi Magenoke uwwemeexxi woyyichchke kadoole gattexxi liixxe duuchchi woyyitete; haqichik hiddi woyyichke kadoole isixxi damuwwanna woyitte kadda.<verse eid="ROM 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 11:17" />Eettene dumuwwaa'n mitte mitte meshqendoole ati gongomiike zayitetike ejesaka kaddene'n hexxe wele dumuwaxxe oddo'n eyyit itti dhaphphi laetexxi ookkone zayitetike ejrsike hiddinaa'n daggaxxa la'o alfitetchinni, <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />tenne damuwwa'n hoolitoxe; hollitotole kinni heddiyyo hassixxi yaane ati hidda ba'itebexxo hiiddake ate'e ba'edhe malee. <verse eid="ROM 11:18" /><verse number="19" style="v" sid="ROM 11:19" />Yoona at «Iitti damuwwa mesheqendechchi ani eetne isexxe bakka'n e'yona'aaten» hitatoxe hexxeen. <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />Iitta ati hiyya dhugaaten; yaane kinni insa'ne mesheqemeechi amanagophatenaa'niten. Ati amanatenaa'n kexxeexxa uurte'eten. Sodaati malee ifisaadoxxe. <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />Mage'n eetene dadumiinxe damuwwa kademakeeri'a maramra gophpheechinni ha'no'anna mararbaan.<verse eid="ROM 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 11:22" />Yoona Mageniixxa mararanna isixxa godoba jaabbat hubati; jabeene isik ibekkeraniten; marrte isixxi kinni isixxe mararte giddo hexxetqico'n ati'aten; iittate kaddagophoole kinni atinaa kutendaton. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />Insa'nenna amamangopha ifixxa waaleexxi ileema hingoole Mageniginna insa'ne edike inseke booncho'n hissa dade'aan. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />Gongomike kade'eeke zaitetike egrsinke haqichinaa'n kardetexxi atike dadumike kadebaake ookkone eloke ejersa'n haqico'n ee'yitetechinni daduumik ifixxe damuwwa kade'eekir iikki ifike zayitetike ejersa'n e'yiyota hittata dandesagophata!<verse eid="ROM 11:24" /></para>
  <para style="s1">Isira'elto Duuchchi Anjirendaaxxa</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />Anke dayyuwwa no'o egene'eneke hitineexxi ifisaadinoqe, ha'no tenne buuqo yaane egendinebaag gattino'a ani eeyabe'non; Ayihudake kadebaake filemeek manni duucchchi dagaqico Isira'eelike arda'n mitte mitte darre'n dillo'a kadde. <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />Tennexxee Isira'eelik ardi duuchchi enjirema; tinninna hiyyende borresendemashanni:</para>
  <para style="q1" vid="ROM 11:26">«Anjiralli Tsiiyooninaa'n dagaan.</para>
  <para style="q2" vid="ROM 11:26">Ya'iqoobixxe horte duuchchanaa'n fuggaalessumma fuggusaan.<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />Tinninna ani insa'nexxa cubbo insa'nenaa'n fuggusano wodda</para>
  <para style="q2" vid="ROM 11:27">insa'ne'a aaganoxxe kakon.»<verse eid="ROM 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28" />Wengelt darree'n insa'ne ha'noxxee la'o'a Magenokee naaphake; filensha darre'n kinni insa'ne annuwwa ifikixxe buuton eeyemekera. <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />Magenxi uwwanna isik ye'yinji hansha afeba'a. <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />Ha'nonna edo Magenoke ajajendinamabaak ta'a insa'nexxe ajajemagohanaa'n kexxeexxa gattowwal alfinemaqisha <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />insa'nenna Magen ha'no'a gattowwaal hiyyatenaa'n kexxeexxa gattowaal alfino'a ta'a ajajemabaake kande'een. <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />Tinninna kadde'elchi Mageni duuchchinge gattowaal hiyyo'a manji duuchchi ajajemagopha giddo hedhaasha asse'een.<verse eid="ROM 11:32" /></para>
  <para style="s1">Magenoke Shiqeeka Galata</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />Hayi hoola Magenike beekuma isixxe marartenna isixxe ege'na!</para>
  <para style="q2" vid="ROM 11:33">murte isixxa ayyinna qo'nisaba'a</para>
  <para style="q2" vid="ROM 11:33">Ora isikinna ayyinna ege'na dande'aba'a<verse eid="ROM 11:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34" />«Goottinka yaada ege'neeke aate?</para>
  <para style="q2" vid="ROM 11:34">Yookaan is'a mari'e uwwa dande'aak aate?»<verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />«Yookaan Magen isi'a hissaashsha</para>
  <para style="q2" vid="ROM 11:35">Magenoke edise liqeeseek aate?»<verse eid="ROM 11:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="ROM 11:36" />Duuchchinxa yaane insibaa'n, isidarre'ninna isi'ate kaddemaxxe</para>
  <para style="q2" vid="ROM 11:36">isi'a duuchchchi woddinaa'n duuchhci woddi'a ulfinni isi'a kadowaal! Ameen.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s1">Hedhoka Tolcha</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />Yoona anke dayyuwwa Manjunte ha'noxxi Mageno gammachisaaxxenna hedhoke woyyichcha tolcha assitineexxi Magenoke'e shiqishinaasha Mageniixxe mararenni ha'no'o kadhataanen. Tinninna aanne affeexxa dhugaatixxa magenooffachcho. <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />Eloxxa, gamachisaxxanna luqqitte Magenxa fedhi maacho kaddeexxa hubatine egendinno'a giddixxe ha'noxxe qalbexxe haroma'n jijireme male tenne butta labbinoqe'e.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />Ha'no mitte mittenge Magen uwweexxe amanaxxe qixxe'n, hexxeneqicisha ifi uudde malee hexxineba'a iimidarre ifi caaqasiten heddinabaashsha ani'a uwweemeke Magenke badhaadhidhinni ha'no'o gorsa uwwaanen.<verse eid="ROM 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 12:4" />Mitti mitti no'ong mitte biso'n heddo qooluwwa anfeenen; kunni mitti mitting bisiink qoolwwinna mitte mitte bifaxxa huje anfemabaashanni, <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />iittanni no'o heddokke kandeenni he'nenexxi Kiristoosi darre'n mitte bison; no'o mitti mittig wele manjike bisike qoola. <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />No'o'a uwwemeeke dadhaadhishanni gargaritti hexxeexxe uwwa anfe'enne. Mitteke uwwendeexxi uwwa raaga haaso'ate kaddoole ifixxe amanaxxe qixxe'n wabeekuma haaso'owaal. <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />Ergatemate kaddo'oole ergatemowaal; barssisate kaddo'ole barsiisowaal; <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />Uwwendeexxi uwwa gorsa uwwate kaddo'oole gorsowaal; gopheeke qoodate kaddo'ole birsa'ise qoodowaal; galchate kaddo'oole jabaate galchowaal; mararate kaddo'oole gammashot mararowaal.<verse eid="ROM 12:8" /></para>
  <para style="s1">Eeyya</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />Eeyya ha'noxxi dhugaatike kaddowaal; fuggoxxa yaane xireefatte; eloxxe yaanenni guduunfemme. <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />Dayyuwwinsha wel wel jabeesitine eeyye; mitte wele umo ifikenaa'n sa'isat wel wel ulfeesse. <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />Gootta ergatematee Hafuurnxi hedhonni finiqqitineeke kadde malee konne ergatenshatike si'inaa'n uduma higginoqe'e. <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />Magen uwweexxe addachiisa'n gammaddee; rakkoti wodda ossee! Jaabatine soodattee! <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />Rakkiyye amaange dayyuwwa gargaarre; keesumatanna adhdhe.<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />Ha'no shorshaaka eebisse; eebisse malee'e badindinoqe. <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />Gammadakern welt gammadde; oodhakerninna oodhdhe. <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />Weli aagineexxi hedhdhe; heenoxxa hedho hedheekirn welt hedhdhe male'e hollitnoqe'e; ifinna saadinoqqe.<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />Ayyi'anna fuggoxxixxa bado fuggoxxa hissitinoqe; manji duuchchi edo eloxxa kaddeexxa yaane asse. <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />Manji duuchchinn welti nage'ik hedhatee ifi darre'n ha'no dandeesissaxxa asse. <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />Anke dayyuwwa mufe Magenoke waalle male'e halo fuldinoqe'e; «Halo anxenni; halotanna fulamok anten» hiyyende borresende'een. <verse eid="ROM 12:19" /><verse number="20" style="v" sid="ROM 12:20" />Tennexxe halo fulatixxa bado solo'woole naapha atika itis; dheebe'wolenna ha'wis; tenne assittotole umo isike'n giiratika kashilo tuuldato. <verse eid="ROM 12:20" /><verse number="21" style="v" sid="ROM 12:21" />Fuggoxxa eloxxenni ijifati malee fuggoxxen injifatendoqe'e.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s1">Baalomiike Manni'a Ajajema</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />Huun baalominna afemeek Magnxe fedhinnite kaddemaxxe manji duuchching baalomike manni'a ajajema hississaan; ta'a hedheeka baalomik mannanna baalonseek Magenoken. <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />Tennexxe mottumma gareeraak duuchchi Magenxa aada gareeraan; iitta assak manninna murte ifi'n idaqqan. <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />Galchalluwwi fuggoxxa assakri'ate malee eloxxa assakeri'a soddaachisake kadaba'a. Baalomake'n hedheeka manna sodaatagophota'a eeta'etteta? Yoonna eloxxa assi isinna atee galatefataan. <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />Tinni kaddeechinna isi ati'a eloxxa assatee baalomeeke Mageniike erganjo kademaxxeten; yaane kinni fuggoxxa assittotole sodaat; tinni kaddaachi baalomeke manji wolaaticho ka'leechi iittan toolangeetebaan; fuggoxxa assakara'n mura woxxisatee mufetike mi'a kade'eeke Magenike erganjo. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />Tennexxe muratixxe soda'a calla kaddebaak sammo ha'noxxi eloyoxxa gargar hisite ha'no kuldaamaxxe baalomike manni'a ajajema hassissaxxenn. <verse eid="ROM 13:5" /><verse number="6" style="v" sid="ROM 13:6" />Irbotanna uutina'neek tennexxeenden; kunni baalomiik manni wo'ma yanna tenne huje huja'neechi Mageno ergatemateeten. <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />Tennexxe baaloomike manji'a assemiyyo hassissaaxxa duuchcha asse; irbo hasisaake'e irbo, qaraxa hasisaake'e qaraxxa, sodatemiyo hasisaake'e soda'a, ulfinni hasisaakee'e ulfinna uwwe.<verse eid="ROM 13:7" /></para>
  <para style="s1">Manjo Eyaak Seera Muuxeke Kadeexxa</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />Weli'aan weli eeyyat gadhidarre ayyik liqinna ha'no'n hedhoqe'e; wele manjo eeyaak isi seera muuxeekenn. <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />«Yabaabuldoxxe, shiltoxxee'e, moortoxxee'e, gaabitoxxee'e» hiyyaak ajajinna weli ajaji duuchchi, «Wele manjo umi ifikishsha eeyyi!» hiyyaake konne mitti ajaji giddo bukkassemeen. <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />Wele manjo eeyak duuchchi ookone eeyaake manjo'n elobaaxxa yaane assabaan; tennexxe manjo eeyak duuchchi seera duuchcha muuxedhen hiyyoten.<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />Diiphokenaa'n dammaqinaaxxi yanna gelteexxa tenne ege'ne; anjirensha no'oxxi edo amnanenexxe barra irra caala ta'a no'oba'a shiqeen. <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />Hashsha saxxo'aten barratinna shiqqe'een. Tennexxe dukanatixxa huje waaledinexxi ifinka lolii miya ka'lino. <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />Barra mamaremanesha eloqicinni mamaremo; olkatinna ma'cho'at kaddoqqe'e; yabaabulatinna qilmisat kaddoqe'e; welgonpetinna gaabeti kaddoqqe'e. <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />Tenne irra Gotta Yessuusi Kiristoosi oddo'we malee'e halcha ifixxa muuxashsha maalinke yaadi'a ifi uutinoqe'e.<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s1">Dayyo Atike'n Murgopha</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />Hanoxxe oddo'n amanat goofi manji mornsisaaxxe yaane'a afeeke yaadda'n murtinebaang adhdhe. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />Mitti manji afeenxa yaane itatee'e eeti uwwendeesha amanak hedhe; amaat jabaatebaake wele manji kinni hiddichcho calla ita. <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />Tennexxe duuchinxa yaane itaak manjichchi itaamabaaka tufatoqqe'e; itabaakinna itamake'n muroqqe'e; tinni kaddaachi Mageni iso'o gibe'eeke manjo kadgophemaxeten. <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />Ati wele manjike erganjo'ni murtek isi ati aate? Isi iboole yookaan uuroole ifike ookkone gootti'aten; yaane kinni Magen iso'o uursa dande'amaxxe isi uuraan.<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />Mitti manji mitte barra mittetenaa'n caala eloxxe kadeesha heddaan; wel kinni duuchinxi barra mittette kadeexxa hedhaan; mitti mitting manji ifika yaada kokowaal. <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />Mitte barra wele barranaa'n sa'ise ulfeesak hedheexxe kaddoole isi tenne assa'neeke Goottakeeyeten; heene itanna itaak Goottinke ulfinni'a hiyye itaan; eetene itaaxxe ita'anna Mageno galateefataan; itabaakinna Goottakeeye hiyye itaba'a; itagophateenna Mageno galateefata. <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />No'onaa'ni ayyinna ifi hedhaakinna ifi reyaak hedheba'a. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />He'nonolenna Goottake'e he'nanon, rennonolenna Goottake'e rennanon, tennexxee he'nonolenna rennonole no'o Goottinken.<verse eid="ROM 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 14:9" />Tenne yaanexxee buuto'a Kiristoosi hedheeke mannikenna reyeeke mannike Gootta kado'a reyedheen, hedhokenna kadeedheen. <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" />Meeteta ati dayyo atike'n murtaatee? Yookaan mayeetta dayyo atika tufataatte? No'o duuchching Magenxe murtetixxe mootte edo shinqano.<verse eid="ROM 14:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ROM 14:11" />Tinninna,</para>
  <para style="q1" vid="ROM 14:11">« ‹Ani hedhanoke kadenaxxe›</para>
  <para style="q1" vid="ROM 14:11">‹Manji duuchchi ani edo gulubo ifikenni gulufataan,</para>
  <para style="q2" vid="ROM 14:11">arabo ifikinna ani Magenoke kadenexxa kulaan› hiyya'neen Gootti» hiyyende borresendemashaten.<verse eid="ROM 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 14:12" />Tennexxe no'o'o mitti mitti umi no'okixxe huje'a Mageni edo shinqenexxi hisicho is'a uunanon.<verse eid="ROM 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />Tennexxe weli'an weli mitti mitteke'n mura waallo. Tenne irra ayyinna ifike dayyike ora'n gufachiseexxa yookaan takaldaxxa yaane uggurabaashsha mudhowaal. <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />Gootta Yessuusinni hedhe'nexxi umo ifikenn mitte battoteexxi ita hexxebaaxxa ege'ne'enen; yaane kinni mitti manji mittie yaane'e battottesha asse uudeexxe kaddoole itti yaane isi'a battotteexxen. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />Itatenaa'n kexxeexxa amaagne atika dayyo yaadisaatole eeyate'n hexxetekeba'a. Kiristoosi isi'a reyeeka atika dayyo itatenaa'n kexxeexxa ba'aasha assitoxxee! <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />Iittanni ati elochonni hite heddaatechi fuggochcho hiyyemeexxi uudemaashsha assitoxxe. <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />Magenxi moottumma Woyyichchi Hafuuri afendaxxa qullumma nege'anna gamasho malee'e itatixenna ha'wiinxe yaaneba'a. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />Konne orni Kiristoosi'a ergatemak manji Mageno gammachiisan; manjoke'ninna galateefatemeeken.<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />Tennexxe nage'i afemo'anna weli jaarona'a dandenenexxa duuchcha assino. <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />Itatixxe buuto'a Magenxa huje diiggoxxe'e; duuchchinxi ita ca'iteten; yaane kinni wele manjo gugufachissaxxa ita itiyyo dhedhake. <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />Atika amaagene dayyo gugufachiisa gophatee maala ita gopha yookaan woyinetixxa booka ha'wagopha yookaan heene gugufachisaaxxa yaanenna assagopha eloxxe.<verse eid="ROM 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 14:22" />Yoona tenne yaanuwwaxxe afe'etexxi amana Magen edo ati'anni kaddowaal. Kokeesexxe yaane ifi'n murabaak maji isi eebisemeek. <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />I'nata'n itaak manji kinni amanatite kadgophemaxxe iso'n murendaan; amanati assendebaaxxi yaane duuchcha cubbote.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="s1">Wele Manna Gammachchiisa!</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />No'o amanat jabake kande'enek ifigopheeke mannixxa gonphe ba'edha no'o'o hassissa malee ifi gammachinsanoke kada hasisaba'a. <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />Mitti mitti no'ong mitti manji amanate'n jaaremo'a iso gammachisaxxanna isi'a la'o utaaxxa yaanne assa no'o'a hassissaan. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />Kiristoosinna umo ifika gammachise'emabaan. Yaane kinni, «Ate'e yowwineemak yowichchi ane'n geyeen» hiyyendeexxi borreesendemashanni iso'n kadde. <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />Woyyichchi maxaafi uwwaaxxe oossunteninna dayefachonni adde anfannona'a edo borresendemaxxi duuchchi no'o barsisate borresende'enen. <verse eid="ROM 15:4" /><verse number="5" style="v" sid="ROM 15:5" />Oosumatanna dayyefachcho uwwaak Magen Kiristoosi Yessusii'i hordofina wodda oddo ha'noxe'n mittumati hexxinaaka mitte yaada ha'no'a uwwo'a. <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />Tinninna mitte qalbenna afo'o mitte kaddine'e no'oka Gootta Yessuusi Kiristoosika Annanna Mageno ulfeesitino'aten.<verse eid="ROM 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />Yoona Magenokee galati kado'a Kiristoosi ha'no adhdhemashsha ha'nonna wel wel adhdhe. <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />Tinninna kaddeechchi annuwwakee uwwemeeke addetika hiyyicho kokeeso'a Magenxe dhuga'a hiyyeexxi Kiristoosi Ayihudieke erganjo kadeexxa ha'no'n kulona'aten. <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />Iittanni Ayihudake kadebaak manni Mageno mararte isixxe galateefato'aten.</para>
  <para style="q1" vid="ROM 15:9">Tinninna, «Isira'elke arda kadebake mannixxe giddo ate'e galateefantannon,</para>
  <para style="q2" vid="ROM 15:9">summa atikanna faarsanno» hiyyende borresendemashaten.<verse eid="ROM 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 15:10" />Ittanni,</para>
  <para style="q1" vid="ROM 15:10">«Ha'no Isira'elke arda kaddinebaak manni,</para>
  <para style="q1" vid="ROM 15:10">Magenike ardinni welti gammadde» hiyyende'e borresende'en.<verse eid="ROM 15:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ROM 15:11" />Higgeen</para>
  <para style="q1" vid="ROM 15:11">«Ha'no Isra'elke arda kaddinebaak manni duuchchi Mageno galateefatte;</para>
  <para style="q2" vid="ROM 15:11">Arduwwi duuchchinna iso'o galateefattee» hiyyendee'e borresende'en.<verse eid="ROM 15:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />Ittanni Issayaasinna</para>
  <para style="q1" vid="ROM 15:12">«Gosa gosake arduwwa duuchcha'n mowaak</para>
  <para style="q2" vid="ROM 15:12">Isseyik Hiddi dagaan;</para>
  <para style="q2" vid="ROM 15:12">Ayihudake kadebbak ardinna iso'n addataan» hiyye'een.<verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />Iso'n amandinemashanni addetik Magen gamashotanna na'ge'a womaqicinni ha'no'a uwwo'waal; tinninna Woyyichchi Hafuurxe hunnanni adde birsa'e ha'no wo'mito'aten.<verse eid="ROM 15:13" /></para>
  <para style="s1">Ayidake Kadebaake Manka Ergamallo Phawuloos'i</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />Anke dayyuwwa ha'no umo ha'nonge'n elle wo'miteexxa, ege'na duuchinni wo'mitexxanna mitti wele gorsatixxa dande'a affineeke kaddineexxa ani umo anginenenni koke'enen. <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />Magen ani'a uwweeke badhaadhiqicnni higgeenna ha'no'n qallasona'a mitti mitti yaada'n afo'o ho'me ha'no'a borreesenne. <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />Kunni badhaadhinna ani'a uwwemeechi Magenxa wengele Ayihudake kadebaake manna'n lalabate Yessuusi Kiristoosi'i qeesumat ergatemona'aten; tinninna Ayhudake kadebaak manna Hafuur Woyyichchiki woyyomeexxi Magenedo edo gamachhisake tolcha kade'e shiqo'aten.<verse eid="ROM 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 15:17" />Tennexxe Mageno ergatama dande'nexxe Yessuusi Kiristoosi'n ifisaadaanen. <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />Tinni kaddeechinna Kiristoosi anke haaso'ininna assenexxe yaane darre'n Ayiudake kadebaak manni Magenoke ajajemaashsha, Kirstoos ane'n hedheexxe asseexxe yaane gadhidarre wele yaane afo'i wo'me haaso'abe'noxxeten. <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />Tinninna kaddeek woyyichchi Hafuurixxe hunnanni, beesisuwwikinna manbe'uwwikiteman. Konneqicnni Iyyerusaaleminaa'n Iliwariqoon qico'n Kiristoosixxa wengeele wo'miqicinn lalabe'enen. <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />Weli manji jaarexxe booso hana jaarbe'nosha hiyyati Kiristoosik summa laqisemebaake booncho wongel lalaba, anxe duuchchi woddixxe halchaman.<verse eid="ROM 15:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ROM 15:21" />Tinninna</para>
  <para style="q1" vid="ROM 15:21">«Isixxee'e kulendebaak manni afaan</para>
  <para style="q2" vid="ROM 15:21">Isexxee'e laqebaakinna qalbeefataan» hiyyendee borresendemashaten.<verse eid="ROM 15:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="ROM 15:22" />Ta'iqico'n ha'noba'a dagebe'noshsha hoyyemenek tennenaa'n kexxeexxinniten.<verse eid="ROM 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 15:23" />Ta'a kinn konne loola'n assaanexxi huje hedhegophemaxxe, iittanni heddo wogga'anna ha'no uudona'a halcha'anaxxe, <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />konne yaada Isipeeni'a me'annoxxa yaana muuxanoxxa heda'nen; sa'ano woddanna ha'no uude ha'non welti heenoxxa yanna turenexxi halcha anxa bidhenechi uduma anxe me'a'a kadaaka gargaarsa ani'a assitinaaxxa addatano. <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />Ta'a kinni ookko hexxeexxa qulliyye ergatematee Iyyerusaalemi'a me'ate'n hedhenen. <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />Tinninna kaddeechchi Meqedooniyanna Akkaayiyaa Iyyerusaalemi giddo hexxeexxaa qulliyye garggaro ke'nemaxxeten. <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />Konne gargarsanna eeyuma ifixxenni uunechi insa'ne assa hasisaaxxe gattabaaxxe yaane kaddeexxetene. Tinninna Yihudootake kadebak manni Yihudotinxa hafuurn darrexxa eeba insa'ne welt qoodemeechinni insa'nenna ifixxe maaldarrexxe eebanni Ayihudoota gargara hasissaxxenna gattabaaxxe kaddemaxxeten. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />Tennexxe konne bukkaseemeka gargarsinka maalaqa Iyerusalemi iyyemare uwwatixxa huje muuxenlchi uduma ha'no ga'miin Isipeeni'a sa'anon. <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />Ha'nobanna daganno wodda Kiristoosixxe wo'ma eebbanni daganoxxa ege'ne'ene.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />Anke dayyuwwa ani'a Mageniba'a soodatina'n aninna welt cicitinaasha Gootta Yessuusi Kiristoosixxenninna Woyyichchi Hafuurixxe eeyumanni ha'no'o kadhataanen. <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />Ani'a kadhatinalchinna Yihudake boga'n hedheeke Mageno amanebaake mannixxe anganaa'n gatannoshanna Iyyerusaalemi giddo ergatemanoxxi ergatensha qulliyye gammachisaxxe kaddashsha soodate. <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />Tinninna Mageniike fedhi kaddoole gammashoti ha'noba dagenexxi ha'nonni welti hafuura adhono'aten. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />Nage'ink Mageni ha'no duuchchingeninni welti hedhowaal. Ameen.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s1">Phawullosi Dhameeka Nage'a</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />Kinkira'oosi giddo hexxeexxe Mageniinxa tuuta ergatenda'neexxa dayyo no'oxxe Feebenii egendino'a eeyyanen. <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />Ise anenna wele heddo manna gargarteemaxxee'e, qulliyye keesumma adha hassissamaqicnni ise Goottinke summinni adhitiineexxi hassissaaxe yaane duuchinni ise'e gargartinaasha ha'no maganeyaanne.<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />Yessuusi Kiristoosixxa huje aninni welti hujamake Pirsqila'ninna Aqila'n anka nage'ann kulle. <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />Insanne anxe hineexxi ifi reyote sa'isne uuneen; ane callann kaddebe'nok Ayihudake kadebaaxxi Magenxi tuuta duuchchinna insa'ne galateefata'neen. <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />Insa'neke mine'n hexxeexxe Magenxe tuuta'a nage'a ani'a kulle; Issiyake bogi giddo sirete'n Kiristoosi'n aamaneeke jaalo anke Ephenexoosi'a naga'a anka kulle. <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />Ha'no'a lumoqico eloottemmaxxe Maarami'n nage'a anka kulle. <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />Aninni welti usureme'emakeri'nna ergameeyye giddo gura fulle'emakera fira anke Andironiqoosi'aanna Yuniyaasi'a nage'a anka kullee; insa'ne ani'a edinsexxi Kiristoosi'i amaneekeran. <verse eid="ROM 16:7" /><verse number="8" style="v" sid="ROM 16:8" />Goottik eeyaneke Amiphilaxoosi'a nage'a anka kullee. <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />Kiristoosixxe huje aninni hujeeke Urbaanoosi'anna jaallo anke Isxakuusi'a nage'a kulle. <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />Kiristoosike kadeexxa hega uudemeexxi kokeesemeeke Aphpheliisi'a nage'a kulle. Arsixobuloosike mini haddi'anna nage'a anka kulle. <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />Heerodiyoo'o Ayihudichcho anke jaalo'n nage'a ani'a kulle; Narsiseesi mini hadinaa'n Gootta amaneekera'n nage'a ani'a kulle. <verse eid="ROM 16:11" /><verse number="12" style="v" sid="ROM 16:12" />Goottake'n hexxe'e jaba qicinni ergatenda'neexxa melaalle, Pirofimonaanna Xirofimosaa'a nage'a anka kullee; Gottake'n hexxe'e hara jaba qicinni ergatendeexxe, eettene eeyendeexxe Xersiida'a nage'a anka kulle. <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" />Gootti fi'leeke Ruufoosi'aanna ani'a amate kaddaaxxe isixxe ama'a nage'a anka kulle. <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />Asiqerixooni'a, Filegooni'a, Hermeesi'a, Phatirobaasi, Herman'anna insa'nenni welt hedheke amaagne dayyuwi'a nage'a kullee. <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />Filologoosi'a, Yuuliiya'a, Neeriya'aanna isixxe dayyo'a nage'a ani'a kulle; iittanni Olumpoosi'aanna insa'nenni welti hedheek amaagne dayyuwwi'a nage'a ani'a kulle. <verse eid="ROM 16:15" /><verse number="16" style="v" sid="ROM 16:16" />Woyyitte sunqexxinni wel sunqexina'n nage'a weli aadhdhe. Kiristoosixxi duuchinxi Magenxe tuuta ha'no'a nage'a dhanda'neen.<verse eid="ROM 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />Anke dayyuwwa hano baratineexxxa baracho gareerat ha'no giddo gargar higanna gufo hexxaashsha assa'neeke manninaa'n ifi heqedhe; insa'enaa'ninna bayyatte. <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />Iitta hedheek manni ergatema'neek Yessusi Kiristoosi'a kaddebaak ifike godoban. Insa'ne xa'maakenna kookinshine haaso'ini ba'lake mannixxa qalbe dedhinsaan. <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />Ha'noxxa ajajensha duuchching laqe'een; tenne'n aninna ha'no'n lumoosha gamade'enen; kaddomalee eloxxe yaane'a beekole fuggoxxe kinni ba'lake kaddino'a eeya'nen.<verse eid="ROM 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 16:20" />Nage'ink Mageni durrisa lekka ha'noxxi hunda rake cancaqaan.</para>
  <para style="p" vid="ROM 16:20">No'oka Gootti Yessuusik badhaadhi ha'no'n welt hedhowaal.<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />Aninni welti hujete'n hedhek Ximotoosi nage'a ha'no'a dhaame'een. Iittanni Ayihudike manninaa'n anke fira kade'eek Luqiyoosi, Iyyasooninna Sosiphaxiroosi nage'a ha'no'a dhaame'een.<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />Tenne erga borresenek ani Xerxiyoosi Goottik nage'a ha'no'a dhaamenen.<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />Aneenna kaba hexxeexxa Magenxa tuuta keensusaak Gayiyoosi nage'a ha'no'a dhaamedhen.</para>
  <para style="p" vid="ROM 16:23">Ookko qachchixxe karra duuchik soores Erasixoosi dayyi no'ok Qu'arxoosi nage'a no'o'a dhaame'een. <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />Gootti no'oke Kirsitosik badhadhi ha'no duuchchingini welti hedhowaal. Ameen.<verse eid="ROM 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />Ani kulaanexxi wengele Yessuusi Kiristoosixxe kulenda'neexe erganna edike barruwinaa'n sho'ende turteexxi ta'a kinni lifisendeexxe dhuga darre'n isi ha'o amana ha'noxxe jabatiine urtinaashsha assa dandeaake isi'a ulfinni kadowaal. <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />Ta'a kinni iitti sho'endeemaxxi buqo yaane ifisende'een; Duuchci woddike Magenike aajajiqicisha duuching amaneexxi ajajemaashsha wabeekotike maxaafi darre gosa gosak arduwwi duuchchi ege'naasha assendeen. <verse eid="ROM 16:26" /><verse number="27" style="v" sid="ROM 16:27" />Isin calli beekake kade'eek Magen, Yessuusi Kiristoosi darre'n duuchchin woddi'a ulfaatowaal. Ameen.<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>