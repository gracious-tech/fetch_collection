<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Gedeo Bible</book>
  <para style="h">3 Yohaannisixxa Erga</para>
  <para style="toc1">Ergemaallo Yohaanisixxa Sakkaxxa Erga</para>
  <para style="toc2">3 Yohaannisixxa Erga</para>
  <para style="toc3">3 Yoh.</para>
  <para style="mt1">Ergemallo Yohaannisixxa Sakkaxxa Erga</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Sakkaxxi Yohaannisixxa erga borreesseek «Ookkone ergammallo geercho Yohaanisinaa'nite» kadaa borreesseekinna Gaayiyoosi hiyyemaake Mageniinxe tuutake akeekisanji'atemman; kunni borreessanji mitte darrena'ni Gaayiyoosi wele kirsitoositonna gargaarat isoo galatefataan; iittanni wele darrena'ni Diyotirefis hiyyemaake xaqartichcha manjonaa'ni isi ifi heqqedhaashsha isoo xexxe'achchiisaan.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">E'yichchoo <char style="ior"><ref loc="3JN 1:1-4">1-4</ref> </char></para>
  <para style="io1">Gaayiyoosixxa galateefatema <char style="ior"><ref loc="3JN 1:5-8">5-8</ref> </char></para>
  <para style="io1">Diyoxiraaxisixxa gibensha <char style="ior"><ref loc="3JN 1:9-10">9-10</ref> </char></para>
  <para style="io1">Dimeexxiroosixxa galatefatema <char style="ior"><ref loc="3JN 1:11-12">11-12</ref> </char></para>
  <para style="io1">Muuxama <char style="ior"><ref loc="3JN 1:13-15">13-15</ref> </char></para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Iikki Geerchi;</para>
  <para style="b" vid="3JN 1:1" />
  <para style="p" vid="3JN 1:1">Dhugaat eeyyannek eeyyemeeke anka jaalo Gaayiyoosi'a.<verse eid="3JN 1:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />Anke jaaloo! Lubboti elo qico hexxeteshshanni fayyatinna elo qico hexxatoshshanna yaane duuchchi ati'a qajeeldo'a soodataannen. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Dhugaatee xuurameesake kaddettexxanna marendaatekinna dhugaate'nite kaddemmaxxee mitti mitti dayyuwwi dageexxi atixxee dhugaa kulaa wodda ani lumoshsha gammadennen. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Anxi oose dhugaate'n mammarenda'naa laqati iimi darre caldaaxxa gammashsho ani afebe'no.<verse eid="3JN 1:4" /></para>
  <para style="s1">Gayiyoosixxa Galateefatema</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Koo jaaloo! Ati'a keessummate kandoolenna midde dayyuwwakee assitaatexxe yaane duuchchinni ati xuurameesaken. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />Insa'ne ati affeetexxe jaalalaxxee Mageniixxe tuuta edo dhugaa kulleen; Mageno gammachchinsaa qicinni ati insa'neke ora insa'ne gargartottole eloxxe assitaton. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Insa'ne Kiristoosii'i ergatemo'aa fulee wodda Kirstoosii'i amanebaake mannanaa'n mittechchonna adhdhinebaakiten. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Yoona welti dhugaatee mitteba hunjannoshsha iitta hedheeka manna no'o gargaara hassissaan.<verse eid="3JN 1:8" /></para>
  <para style="s1">Diyoxiraaxisixxanna Dimeexiroosixxa Galateefatema</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Mageniinxe tuuta'a borreesseennan; yaane kinni akeekisanjoke kado'a eeyyaaki iikki Diyotirefiiisi yaada no'oka adhdhebaan. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Tennexxee ani dagonnole isi fuggoke haaso'inni summa no'oka balleesso'a assaaxxa duuchcha duuchchinge'n haaso'annon. Tinninna isoo hanqatee'naa dayyuwwa adhdhabaan; insa'nee adhdho'a hassaaka duuchcha hoyyaan; Mageniinxe tuuta giddii'ni insa'nee fulchaan.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Koo jaaloo! Eloxxe kaddeexxa malee fuggoxxa labboxxe'e; elooxxe kaddeexxa assaki duuchchi Magenokenaa'niten; fuggoxxa assaaki kinni Mageno uudeebaan.<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />Dimexiroosi'a manji duuchchi dhugaa kulaan; dhugaa ifinge umininni isi'a dhugaa kuldaan; no'onna isi'a dhugaa kullannon; ha'nonna dhugaa kula no'oxxi dhugaate kaddeexxa egendinaan.<verse eid="3JN 1:12" /></para>
  <para style="s1">Muuxamiinka Nage'a</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Ati'a borreessa hasaannexxi heddo yaane afeennan; kaddo malee'e woraqatake'ni borreessonnaa eeyyabe'non. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />Shiqoxxe yanna'ni atee uudonnoxxa addataannen; ookkone woddanna welti afemmennexxi haasonnannon.<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />Nage'i ati'a kadowwaal; jaaluwwikinna ati'a nage'a dhaama'neen; atinna jaaluwwa mitte mittengee nage'a anka shiqishi.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>