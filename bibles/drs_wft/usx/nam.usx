<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Gedeo Bible</book>
  <para style="h">Naahoomikaa Raaga</para>
  <para style="toc1">Naahoomikaa Raaga</para>
  <para style="toc2">Naahoomikaa Raaga</para>
  <para style="toc3">Nah.</para>
  <para style="mt1">Naahoomikaa Raaga</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Naahoomiki raagi sirendenaa'ni Isira'eeli'a naapha kadeek Asoorike bogi giddo umoke kedeeke Neenewweke qachchixxe diigenshaxxee gammadiki borreeseemeeke gammadiinke borreesani. Isexxee'e kunni Nenewweki qachchi kirisittoosixxe ilensha edi darre torbaane dhibba wogga'ni muuxamake'ni digema isexxi, Duuchchi Woddi Gootti fuggaalleeyye kadeeke manna'ninna hollaameeyye arda'ni hitta muree qico leelishaa'neeke borreesani.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Sodaachchisaaxxa Mageniinxa mufe <char style="ior"><ref loc="NAM 1:1-6">1:1-6</ref> </char></para>
  <para style="io1">Asoori'ni murendeexxi merte Isira'eelke ari'a addatensha afiseexxa <char style="ior"><ref loc="NAM 1:7-15">1:7-15</ref> </char></para>
  <para style="io1">Asoorik umi qachchixxa Nenewwexxa ba'ne <char style="ior"><ref loc="NAM 2:1-3:19">2:1—3:19</ref> </char></para>
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />Nenewexxe ba'nexxe'e kulemeeke hiyyichchixxe; Elqooshichcho Nahoomixxa leella kulaaki maxaafi konneten.<note caller="-" style="x"><char style="xo" closed="false">1:1—3:19 </char><char style="xt" closed="false"><ref loc="ISA 10:5-34">Isa. 10:5-34</ref>; <ref loc="ISA 14:24-27">14:24-27</ref>; <ref loc="ZEP 2:13-15">Sof. 2:13-15</ref>. </char></note><verse eid="NAM 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2" />Duuchchi Woddiki Gootti hinnaatichchakenna halo fulaake Magenon;</para>
  <para style="q2" vid="NAM 1:2">Duuchchi Woddiki Gootti jabaxxe mufe ifixenni naapha ifike'ninna bala itti ibisaan.<verse eid="NAM 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3" />Duuchchi Woddiki Gootti ossalloke; hunna isixxinna lumoxxen; yaane kinn</para>
  <para style="q2" vid="NAM 1:3">Duuchchi Woddiki Gootti balleessanjo xixebaak waalabaan;</para>
  <para style="q1" vid="NAM 1:3">Isinna hobonbalte giddonna danbala'i giddo ora afe'een;</para>
  <para style="q2" vid="NAM 1:3">duumachikinna isixxe lekkaxxe bukon.<verse eid="NAM 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4" />Isinna Abbayya xixee bassaan;</para>
  <para style="q2" vid="NAM 1:4">wodu'uwwa duuchchannna xo'o assaan,</para>
  <para style="q1" vid="NAM 1:4">Baasaninna Qermeeloosi qoorraan;</para>
  <para style="q2" vid="NAM 1:4">Libaanoosik daraaruwwinna harca'aan.<verse eid="NAM 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5" />Koobuwwatinna isi edo linqisse;</para>
  <para style="q2" vid="NAM 1:5">tullichchuwwikinna isi edo baqe;</para>
  <para style="p" vid="NAM 1:5">Bogikinna isi edo;</para>
  <para style="q1" vid="NAM 1:5">Buttatinna isi giddo hedhaachchi duuchchi lele'me.<verse eid="NAM 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6" />Mufe isixxi edo ayyete dande'e uurra?</para>
  <para style="q2" vid="NAM 1:6">Jabbaxxa isixxa aare ayyete ba'edha dande'a?</para>
  <para style="q1" vid="NAM 1:6">Aare isixxi giiruffa dunde'een;</para>
  <para style="q2" vid="NAM 1:6">rassuwwatinna isi edo hacaqqi hitee xexxeerendaan.<verse eid="NAM 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7" />Duuchchi Woddiki Gootti eloken;</para>
  <para style="q2" vid="NAM 1:7">rakkotixxa barranna gollaken;</para>
  <para style="q1" vid="NAM 1:7">Isoo'o amanaakeeri'a xexxe'ataan.<verse eid="NAM 1:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="NAM 1:8" />Nenewwe kinni</para>
  <para style="q1" vid="NAM 1:8">Birasa'eeke lola'inni balleessaan;</para>
  <para style="q2" vid="NAM 1:8">naapha ifikanna dukkana giddi'a shorraan.<verse eid="NAM 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9" />Insa'nenna Duuchchi Woddike Gootta'n jallinoole,</para>
  <para style="q2" vid="NAM 1:9">isi ballesaan;</para>
  <para style="q2" vid="NAM 1:9">rakkotinna langaxxa kexxabaan.<verse eid="NAM 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10" />Insa'ne utete'n sagaremmaan;</para>
  <para style="q2" vid="NAM 1:10">ifixxe woyinetixxe booka'ninna machchoonaan;</para>
  <para style="q2" vid="NAM 1:10">giiratinna insa'nee huuriinsha ittaan.<verse eid="NAM 1:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="NAM 1:11" />Tee Nenewwe! Duuchchi Woddike Gootta'n jallataakinna,</para>
  <para style="q2" vid="NAM 1:11">fuggoxxeenna mari'achisaak,</para>
  <para style="q2" vid="NAM 1:11">ati giddii'ni ke'eedheen.<verse eid="NAM 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 1:12" />Duuchchi Woddiki Gootti hiyya'nee qici,</para>
  <para style="q1" vid="NAM 1:12">«Insa'ne fedhee qiconna hunnaameeyyetenna jirake kandoolenna,</para>
  <para style="q2" vid="NAM 1:12">kuttemmaan; ba'naan;</para>
  <para style="q1" vid="NAM 1:12">Koo Yihuda konneechchi edo atee wixixxi assoonnolenna,</para>
  <para style="q2" vid="NAM 1:12">konneechchinni edi'aa atee wixixxi assabo'non.<verse eid="NAM 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13" />Ta'anna qanbara insa'neka gooba atikenaa'n enqannon;</para>
  <para style="q2" vid="NAM 1:13">usurende'etteka haachchabanna tanshe hunannon.»<verse eid="NAM 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14" />Tee Nenewwe Duuchchi Woddiki Gootti atixxee'e hiyye ajajee qici,</para>
  <para style="q2" vid="NAM 1:14">«Summa ha'nooka e'yisaaxxa ila affinabaan;</para>
  <para style="q1" vid="NAM 1:14">Ha'nooke magenoonfachchotike mine'ni hexxeexxa fakkuwwa,</para>
  <para style="q2" vid="NAM 1:14">baqisende giisendeexxa misilluwwa bakka balleessannon;</para>
  <para style="q1" vid="NAM 1:14">Ati fuggichchake kaddettaxxe'e</para>
  <para style="q2" vid="NAM 1:14">ati'a moogiinxa bakka qixxeessannon»<verse eid="NAM 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15" />Kunse eloxxa odo iyyedagaak,</para>
  <para style="q2" vid="NAM 1:15">nage'akanna lallabaake manjiinxi lekka,</para>
  <para style="q2" vid="NAM 1:15">koobuwwate'n hexxeen;</para>
  <para style="q1" vid="NAM 1:15">Koo Yihuda ayyaanuwwa atika ulfeesi</para>
  <para style="q2" vid="NAM 1:15">werreegga atikanna muuxi;</para>
  <para style="q1" vid="NAM 1:15">Ta'anni edi'a fuggaalleeyye atee'e injifattabaan;</para>
  <para style="q2" vid="NAM 1:15">insa'nenna hara ba'naan.<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">Isa. 52:7</ref>. </char></note><verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="s1">Nenewwexxa Iba</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1" />Tee Nenewwe atee miidhaki ate'ni dageedheen</para>
  <para style="q2" vid="NAM 2:1">gollo atixxa heqqedhi;</para>
  <para style="q2" vid="NAM 2:1">ora atikanna gaadi;</para>
  <para style="q2" vid="NAM 2:1">hidha atika usudhdhi;</para>
  <para style="q2" vid="NAM 2:1">hunna atixxa adda jabeessedhi<verse eid="NAM 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2" />Balleessammak manni mulqedhoolenna,</para>
  <para style="q2" vid="NAM 2:2">insa'neke woyinettike hiddichchika fichchanna ballesinoolenna</para>
  <para style="q1" vid="NAM 2:2">Isira'eelike gaachchannishshanni,</para>
  <para style="q2" vid="NAM 2:2">Duuchchi Woddiki Gootti Yaa'iqoobika gaachchanna hiissaan.<verse eid="NAM 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3" />Isike loliinke mannixxi wontuwwa diimoxxen</para>
  <para style="q2" vid="NAM 2:3">loliink manninna dhiile seema oddo'we'een;</para>
  <para style="q1" vid="NAM 2:3">Insa'ne qixxeffanteexxe barra'ni,</para>
  <para style="q2" vid="NAM 2:3">sarageeluwwink siblji cala cala hiyyaan;</para>
  <para style="q2" vid="NAM 2:3">fadhado gulufeek loliink manni loliinka sibiljo qeeffata'ne irbaan.<verse eid="NAM 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4" />Iikki sarageelluwwinna orake'n elqe kayya didaan;</para>
  <para style="q2" vid="NAM 2:4">oruwwake'ninna qolcha'n</para>
  <para style="q1" vid="NAM 2:4">Bubaake xassa labaan;</para>
  <para style="q2" vid="NAM 2:4">banquffa darbemmaan.<verse eid="NAM 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5" />Ifika ege'nemeeka loliinka mannanna ye'aan;</para>
  <para style="q2" vid="NAM 2:5">yaane kinni insa'ne orake'n gugguffantaan;</para>
  <para style="q1" vid="NAM 2:5">Ookkone qachchike dalla'ibaa gonginaan;</para>
  <para style="q2" vid="NAM 2:5">iitti faachcheffachchotixxi wonte bakkate'n hexxeen.<verse eid="NAM 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6" />Ookkone galaanxi hulanna adda banende;</para>
  <para style="q2" vid="NAM 2:6">iikki mootommatiki mininna ibe.<verse eid="NAM 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7" />Iikki qachchi booji'eme adhdhemaa isixxi gattabaaxxa,</para>
  <para style="q2" vid="NAM 2:7">edonni kulende'een;</para>
  <para style="q1" vid="NAM 2:7">Meyyaxxi isexxi garboole guugenjoshsha yuusaan;</para>
  <para style="q2" vid="NAM 2:7">qoma ifixxanna ga'ninaan.<verse eid="NAM 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8" />Nenewe baleesiinshaten,</para>
  <para style="q2" vid="NAM 2:8">iseki wodi'inna bagaan,</para>
  <para style="q1" vid="NAM 2:8">Insa'nenna «Uurri! Uurri» hina'ni cancinaan,</para>
  <para style="q2" vid="NAM 2:8">yaane kinni udumi'a higaak hedhebaan.<verse eid="NAM 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9" />Ookkone birretika sibljonna saamme;</para>
  <para style="q2" vid="NAM 2:9">eettenee worqenna mulqedhdhe;</para>
  <para style="q1" vid="NAM 2:9">Masseccatike mine'n tuulendeexxa</para>
  <para style="q2" vid="NAM 2:9">karra tennete hiyyendaaxxebaan.<verse eid="NAM 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10" />Nenewwe saamende'een mulqende'een duwwixxe kadde'en;</para>
  <para style="q2" vid="NAM 2:10">qalbetinna holboqqeen; gulbikinna giligili hiyye;</para>
  <para style="q2" vid="NAM 2:10">bisikinna roqoonse;</para>
  <para style="q1" vid="NAM 2:10">Manji duuchchinna wekkello'een.<verse eid="NAM 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11" />Ta'ata ookkone neenquwwixxi wolo'o,</para>
  <para style="q2" vid="NAM 2:11">beltanna ifixxa ittilsaammabi,</para>
  <para style="q1" vid="NAM 2:11">Labbakinna meyyak neenquwwi me'ammabi,</para>
  <para style="q2" vid="NAM 2:11">iitti neenqiinxi beltannuwwanna soda'abelo bobbaa'ataamak boonchi haba hedhee?<verse eid="NAM 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12" />Iikkii neenqi beltanna ifixxee'e geyaaka shi'we aadhe dage;</para>
  <para style="q2" vid="NAM 2:12">ifike meyyaxxeenna ittaaka shi'we aadhe dage;</para>
  <para style="q1" vid="NAM 2:12">Shiyeemmaachcho galammaxxe bakka'ni</para>
  <para style="q2" vid="NAM 2:12">bulteechchuwwa ifixxe welo'o'ni wonsheen.<verse eid="NAM 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13" />Dada duucchchik Lumok Duuchchi Woddik Gootti hiyya'nee qici,</para>
  <para style="q1" vid="NAM 2:13">«Tee Nenewwee ani ate'ni ke'eenen;</para>
  <para style="q2" vid="NAM 2:13">sarageeluwwa ha'nooka gubee wililiichchannon;</para>
  <para style="q1" vid="NAM 2:13">Ha'nooka oosichcha neenquwwanna wolantichchi itaan</para>
  <para style="q2" vid="NAM 2:13">ittinaachchonna buttate'n ha'no'a gatisabo'non;</para>
  <para style="q1" vid="NAM 2:13">Ha'nooke erganjuwwiki hafuurinna</para>
  <para style="q2" vid="NAM 2:13">konneechchinn edi'a laqemabaan» hiyye.<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1" />Mundiinke qachchi'a aanne'e;</para>
  <para style="q2" vid="NAM 3:1">dharik,</para>
  <para style="q1" vid="NAM 3:1">Mulqeca ise giddo wo'mite'eeken;</para>
  <para style="q2" vid="NAM 3:1">mucuqedha ise giddo gophende egendebaan;<verse eid="NAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2" />Jiraafetik hafuur,</para>
  <para style="q2" vid="NAM 3:2">moluwwatixxi kakawweette,</para>
  <para style="q1" vid="NAM 3:2">Qolchiinke fadhaduwwikk hirbi,</para>
  <para style="q2" vid="NAM 3:2">sarageeluwwiink hafuurinna laqemeedheen.<verse eid="NAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3" />Fadhado gulufemmak manni edi'a guulaan,</para>
  <para style="q2" vid="NAM 3:3">wolaantichchi cala cala hiyyaan</para>
  <para style="q2" vid="NAM 3:3">bagedi wara wara hiyya</para>
  <para style="q1" vid="NAM 3:3">Heddi manni reyemmaxxee,</para>
  <para style="q2" vid="NAM 3:3">renshi insa'neekinna tuulemedheen;</para>
  <para style="q1" vid="NAM 3:3">Renshuwwiinxe birasa'nenaa'ni kexxeexxa,</para>
  <para style="q2" vid="NAM 3:3">ookkone ora sa'aak manni hedhebaan.<verse eid="NAM 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4" />Kunnichchi duuchchi kaddeechchi hara quba saxxeexxen,</para>
  <para style="q2" vid="NAM 3:4">dedhissaaxxenna gojaameette kaddeexxixxe yababultoxxe buutonniten;</para>
  <para style="q1" vid="NAM 3:4">Ise ifixxe yabaabullenn gosa gosaka arduwwa,</para>
  <para style="q2" vid="NAM 3:4">moro ifixxeninna arduwwakanna garbake asseexxeeten.<verse eid="NAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5" />Dada duuchchik Lumok Duuchchi Woddik Gootti hiyya'nee qici, «Ani ate'ni naaphe ke'eennen»</para>
  <para style="q2" vid="NAM 3:5">Seemma atixxa iimi'a atike albiqico'ni quncisannon.</para>
  <para style="q1" vid="NAM 3:5">«Atixxa duwwi gatanna gosa gosake arda'ni farrassannon;</para>
  <para style="q2" vid="NAM 3:5">saala atikanna moyanjuwwake'n leellishannon.<verse eid="NAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6" />Kora ate'ni dunannon;</para>
  <para style="q2" vid="NAM 3:6">tuffatendattoshsha assannon;</para>
  <para style="q2" vid="NAM 3:6">ceeggatendattoshsha assannon.<verse eid="NAM 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7" />Atee uudeeki duuchchinna atenaa'ni baaja'ni;</para>
  <para style="q2" vid="NAM 3:7">‹Nenewe diigende'een ayyete ise'aa oodhaa?› hinaan;</para>
  <para style="q2" vid="NAM 3:7">atee dayyeessaaka habaa'ni afanno?»<verse eid="NAM 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8" />Ati abbaayike galaana qarqara'n hexxemmaxxe,</para>
  <para style="q2" vid="NAM 3:8">wodi'ik buqendemmaxxee,</para>
  <para style="q2" vid="NAM 3:8">No'i, Amoonii'n caaldatto?</para>
  <para style="q1" vid="NAM 3:8">Ise'a galaan gollake,</para>
  <para style="q2" vid="NAM 3:8">wodi'ikinna ise'aa gimoten.<verse eid="NAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9" />Tophyikinna Gibtsee gabala affebaaxxe isexxe hunnan,</para>
  <para style="q2" vid="NAM 3:9">Fuuxinna Libiya iseke gargaarsanjuwwamman.<verse eid="NAM 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10" />Kaddo malee'e ise booji'ende;</para>
  <para style="q1" vid="NAM 3:10">Shorrendenna me'ite.</para>
  <para style="q2" vid="NAM 3:10">Weldeenna weldeennande'ni,</para>
  <para style="q2" vid="NAM 3:10">annoole isexxi dayende;</para>
  <para style="q1" vid="NAM 3:10">Hayyoole isexxe'ni hixi iblseme;</para>
  <para style="q2" vid="NAM 3:10">isek jajjabi manni duuchchanna haachchabik usurende.<verse eid="NAM 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NAM 3:11" />Atinna kinni machchoottatton;</para>
  <para style="q2" vid="NAM 3:11">suuqendatton;</para>
  <para style="q2" vid="NAM 3:11">naaphakenaa'ninna gollatatee halsitatton.<verse eid="NAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12" />Atixxi wolo'uwwa duuchcha itematee shiqqeexxe,</para>
  <para style="q2" vid="NAM 3:12">umiinxe balasettixxe gummuwwashshaten;</para>
  <para style="q1" vid="NAM 3:12">Lellemisendaaxxa yanna,</para>
  <para style="q2" vid="NAM 3:12">itti gumma italiinke afo'ni ibbaan.<verse eid="NAM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13" />Kunse atik loliink manni duuchchi</para>
  <para style="q2" vid="NAM 3:13">melaalleten;</para>
  <para style="q1" vid="NAM 3:13">Atike bogixxi huluwwanna,</para>
  <para style="q2" vid="NAM 3:13">atike naaphuwwi'a benqe hitee bande'een;</para>
  <para style="q2" vid="NAM 3:13">isika cufanuwwanna giira itte'een.<verse eid="NAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14" />Buqematixxee wode ikki'li;</para>
  <para style="q2" vid="NAM 3:14">golluwwa atikaranna jabeessedhi;</para>
  <para style="q1" vid="NAM 3:14">Faariinka buttina halsi;</para>
  <para style="q2" vid="NAM 3:14">dhoqqetanna hirbeessi;</para>
  <para style="q2" vid="NAM 3:14">xuubetanna qabadi.<verse eid="NAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15" />Ookkonna ate'e giira ittaan;</para>
  <para style="q2" vid="NAM 3:15">wolaantichchikinna atee woxxaan,</para>
  <para style="q2" vid="NAM 3:15">awwaanessiinshanna ate'e tuuqataan;</para>
  <para style="q1" vid="NAM 3:15">Shiixxaramma awwaanessishshanna faqi;</para>
  <para style="q2" vid="NAM 3:15">lumola awwaanessishshanna hori.<verse eid="NAM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16" />Iimixxe urjuwwa caala bira saxxaa qico'ni,</para>
  <para style="q2" vid="NAM 3:16">atike daddaliinke mannika laakkossa bira sa'isitette;</para>
  <para style="q1" vid="NAM 3:16">Ookkonee boga kinni iawwaansinsha inde ca'a assine</para>
  <para style="q2" vid="NAM 3:16">ookko'inna phirri hine me'ine.<verse eid="NAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17" />Atik heqqanjuwwinna awwaanessiinsha,</para>
  <para style="q2" vid="NAM 3:17">atik ja'laabuwwinna boojjetixxa barra,</para>
  <para style="q2" vid="NAM 3:17">dalla'i giddo qubantammake shiixaramma awwaanessishshaten;</para>
  <para style="q1" vid="NAM 3:17">Isi'aanna arishsho fuldaa wodda phirri hine me'inaan;</para>
  <para style="q2" vid="NAM 3:17">haba gennaaxxa ege'nemmabaan.<verse eid="NAM 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NAM 3:18" />Koo! Asoorike moyanjo atixxi allalisano mugge'een;</para>
  <para style="q2" vid="NAM 3:18">atiki jalqabuwwi sammi hiyyee diipheen;</para>
  <para style="q1" vid="NAM 3:18">Atiki ardi bukki assaaka gopheexxi,</para>
  <para style="q2" vid="NAM 3:18">koobuwwate'ni xexxereme'een,<verse eid="NAM 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19" />Atixxa mada fayyisa dande'aak hedhebaan;</para>
  <para style="q2" vid="NAM 3:19">enqeshsha tixxinna reyotee gesisaaxxen;</para>
  <para style="q1" vid="NAM 3:19">Atixxe'e laqeeki duuchchi</para>
  <para style="q2" vid="NAM 3:19">atixxe iba'ni gammadee calaani;</para>
  <para style="q2" vid="NAM 3:19">atixxe mararte beloxxe hujenaa'ni baaje fuleek manji ayyete?<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>