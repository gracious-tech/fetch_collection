<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Gedeo Bible</book>
  <para style="h">Jaalalatikaa Maxaafa</para>
  <para style="toc1">Jaalalatikaa Maxaafa</para>
  <para style="toc2">Jaalalatikaa Maxaafa</para>
  <para style="toc3">Jal.</para>
  <para style="mt1">Jaalalatikaa Maxaafa</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">«Jaalalatixxe Faaroxxe Gence» hiyyemeeki maxaafixxe bifa bifaxxe genceni. Tenne gencuwwanaa'n bira saxxaaxxi borreesendeek faarotixxe bifanite kaddaa wodda, labbaki meyyaxxee, meyyaxxi kinni labbakee shiqishsheexxen. Heddo tikuwwa'n maxaafi kunni «Solomoonixxe Faaro» yookaan «Faaruwwa duuchchanaa'n yo'oshsha quba saxxeexxi faaro» hiyyemati ege'nedaan. Tinninna kaddeechchi Ibiraawotike laagadixxe tika'ni «Solomoonixxe Faaro» hiyyemati ege'nendaan.</para>
  <para style="ip">Tinni Faaro Kirstoosixxenna Mageniixe tuuttaxxe oddo'ni hexxeexxa jaalala leellishshaak mammaassi giddo afemaan. Yihudiink manni kinni kunni maxaafi «Mageniinxenna Isira'eelike ardixxe oddo'n hexxeexxa jaalala leellishshaaka fakkeennuwwa giddo abide'eeke» hinaan.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Jaalala woyinetixxe bookanaa'n saxxaan <char style="ior"><ref loc="SNG 1:1-2:7">1:1—2:7</ref> </char></para>
  <para style="io1">Jaalala duuchiinxa yaane danchoossitaan <char style="ior"><ref loc="SNG 2:8-3:5">2:8—3:5</ref> </char></para>
  <para style="io1">Aadhanna heeruma <char style="ior"><ref loc="SNG 3:6-4:5">3:6—4:5</ref> </char></para>
  <para style="io1">Aadhanna Heerumiinxa mittumma <char style="ior"><ref loc="SNG 4:6-5:16">4:6—5:16</ref> </char></para>
  <para style="io1">Jaalala duuchchingeechchonaa'n saxxaan <char style="ior"><ref loc="SNG 6:1-7:6">6:1—7:6</ref> </char></para>
  <para style="io1">Aninna atin calli <char style="ior"><ref loc="SNG 7:7-8:4">7:7—8:4</ref> </char></para>
  <para style="io1">Jaalalatixxa Saadino <char style="ior"><ref loc="SNG 8:5-14">8:5-14</ref> </char></para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="s1">Waajubichcho</para>
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />Faaro duuchchanaa'n hara quba saxxeexxa Solomoonixxa faaruwwa.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1KI 4:32">1 Moy. 4:32</ref>. </char></note><verse eid="SNG 1:1" /></para>
  <para style="sp">Waajubitte</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2" />Ifixxe suumexxe sunqecanni anee sunqedhuun;</para>
  <para style="q2" vid="SNG 1:2">jaalala atixxi woyineti caala gammachchiissa'neexxen.<verse eid="SNG 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3" />Shitto atixxixxi fishshe anee gammachchiisse;</para>
  <para style="q2" vid="SNG 1:3">summi atik dunedammaxxe shittoxxe fishsheshshaten;</para>
  <para style="q2" vid="SNG 1:3">danchoole atee eetooleta maachchota mambe'a assitaaxxi!<verse eid="SNG 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4" />Adhdhite ane me'i; wiinammoo!</para>
  <para style="q2" vid="SNG 1:4">Moyanji ifixxe goodhebaa anee iyyedaqqe'een.</para>
  <para style="sp" vid="SNG 1:4">Isixxa Jaaluwwa</para>
  <para style="q1" vid="SNG 1:4">Ate'n gammada'ennen; ililisaannen;</para>
  <para style="q2" vid="SNG 1:4">woyineti caalanna jaalala atixxa faarsanno.<verse eid="SNG 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5" />Ha'no tee Iyyerusaalemixxe dubartee;</para>
  <para style="q2" vid="SNG 1:5">ani xilloxen; kadonnolenna danchate;</para>
  <para style="q1" vid="SNG 1:5">Xillinni anki Qeedarike fooquwwishsha</para>
  <para style="q2" vid="SNG 1:5">Solomoonike mootomatike minike seemmatike goluwwishshaten.<verse eid="SNG 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6" />Bifia anxa xilliseechchi arishshote kaddeemmaxxee'e</para>
  <para style="q2" vid="SNG 1:6">Xilloxxe kada anxa uuddinoqqe'e;</para>
  <para style="q1" vid="SNG 1:6">Dayyuwwa anxi mitte godobixxi ane'n mufatte;</para>
  <para style="q2" vid="SNG 1:6">woyyinetike hiddichchixxe bakkake heqqanjonna anee assine;</para>
  <para style="q2" vid="SNG 1:6">aninna ifike woyintike hiddichchixxa bakka waalenne.<verse eid="SNG 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7" />Koo anke eeyyamallo, atika hore habaa bobbaassaattexxa</para>
  <para style="q2" vid="SNG 1:7">waaretanna haba ciisaashsha assitaattexxa</para>
  <para style="q2" vid="SNG 1:7">maganneten ane'n kuli.</para>
  <para style="q1" vid="SNG 1:7">Mayeete ani jaaluwwa atikike hori udumii'n</para>
  <para style="q2" vid="SNG 1:7">alba haguuqiteexxi gadaadotaaxxe manjo kada'ennechchi?<verse eid="SNG 1:7" /></para>
  <para style="sp">Iseka Jaaluwwa</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8" />Tee ati melaalle duuchchiinaa'n caalla danchoondeettexxee, ege'na gophphoottole,</para>
  <para style="q2" vid="SNG 1:8">gedhebiinxa faana hordof;</para>
  <para style="q1" vid="SNG 1:8">Atixxe re'exxa beltannanna</para>
  <para style="q2" vid="SNG 1:8">allalsaanjiinke duunkaani bira bobbaalsi.<verse eid="SNG 1:8" /></para>
  <para style="sp">Labbaka Waajubichcho</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9" />Tee anxe eeyemalloo! Feri'oonixxa fadhadiinxa gaarre harkisammake</para>
  <para style="q2" vid="SNG 1:9">fadhaduwwanaa'n mitte danchitte darmichchonn atee fakkeessenne;<verse eid="SNG 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10" />Boqo atixxik boqotixxe gutichchinni</para>
  <para style="q2" vid="SNG 1:10">Goobi atikinna fiixxeexxe elelluwwanni danchoomeedheen.<verse eid="SNG 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11" />No'o ati'a heddo cammarreka</para>
  <para style="q2" vid="SNG 1:11">worqetika gutichchuwwa ati'a giisinannon.<verse eid="SNG 1:11" /></para>
  <para style="sp">Waajubichcho</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12" />Moyanji qorete'n hedheenaa</para>
  <para style="q2" vid="SNG 1:12">shitto anxixxi fishshe fa'a hite.<verse eid="SNG 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13" />Eeyyemalli anki ani'a anke lame ununixxe oddo'n hexxeexxe</para>
  <para style="q2" vid="SNG 1:13">gudunfendeexxe karbeshshaten.<verse eid="SNG 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14" />Anki eeyyemalli ani'a Eenigeedi hiyyemaake woyinetike hiddichchiinke boonchii'n</para>
  <para style="q2" vid="SNG 1:14">dageeke daraariinke luuphphisishshaten.<verse eid="SNG 1:14" /></para>
  <para style="sp">Labbaka Waajubichcho</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15" />Tee anxe eeyyamallo ati hittata danchate!</para>
  <para style="q2" vid="SNG 1:15">Hittata danchitte!</para>
  <para style="q2" vid="SNG 1:15">Ille atixxi guugenjotishsha danchaten.<verse eid="SNG 1:15" /></para>
  <para style="sp">Waajubichcho</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16" />Koo anke eeyemallo hittata danchake;</para>
  <para style="q2" vid="SNG 1:16">hittata biiffa'ette;</para>
  <para style="q2" vid="SNG 1:16">taqe no'oxxinna quffeexxe arsoshshaten.<verse eid="SNG 1:16" /></para>
  <para style="sp">Labbaka Waajubichcho</para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17" />No'oke minik dagalisanjuwwi birbirsuwwake;</para>
  <para style="q2" vid="SNG 1:17">heellichcho no'oxxinna hi'neesiinxe haqqexxen.<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="sp">Waajubichcho</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1" />Ani Saaroonike Tsigeereda</para>
  <para style="q1" vid="SNG 2:1">Dhooqa giddike daraaroqqa.<verse eid="SNG 2:1" /></para>
  <para style="sp">Labbaka Waajubichcho</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />Qu'muudotixxe oddo'n hedheeke dancha daraarishsha</para>
  <para style="q2" vid="SNG 2:2">eeyyemallo anxinna danchalluwwatixxe oddo'n iittanden.<verse eid="SNG 2:2" /></para>
  <para style="sp">Waajubichcho</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />Gongomiinxe haqqexxe oddo'n hedheemmake appiletike haqichchishsha</para>
  <para style="q2" vid="SNG 2:3">eeyyemalli ankinna dargageeyyetixxe oddo'n iittanden;</para>
  <para style="q1" vid="SNG 2:3">Isixxe gaaddiddo hunda offo'la anee eeyyisa;</para>
  <para style="q2" vid="SNG 2:3">isixxe gummaxxi xe'menna anee goddisaan.<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />Isinna ifixxe jilake mine'ni anee iyyemare;</para>
  <para style="q2" vid="SNG 2:4">ane'ni afeek yaadinna jaalalaten.<verse eid="SNG 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5" />Jaalala isixxi anee abiddee'naa dhibemennaxxee</para>
  <para style="q2" vid="SNG 2:5">Zebiibe itissina'n mikita anee jabeesse;</para>
  <para style="q2" vid="SNG 2:5">Apiletanna itissina'n anee gammachchiisse.<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />Isixxa bita'ixxa anga boraafateennen</para>
  <para style="q2" vid="SNG 2:6">middixxi isixxi anganna anee hanqalfitaan.<verse eid="SNG 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />Tee Iyyerusaalemixxe dubartee,</para>
  <para style="q2" vid="SNG 2:7">jaalala umo ifingenninni yorte'e kexxaa qico'n</para>
  <para style="q1" vid="SNG 2:7">Jaalala le'misinabaashsha yookaan dammasitinabaashsha</para>
  <para style="q2" vid="SNG 2:7">xaaxinkenninna qiilla gammoojjek gadansiinke summinni ha'no kadhatenne;<verse eid="SNG 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8" />Kunse anke eeyyemallik hafuur</para>
  <para style="q2" vid="SNG 2:8">koobuwwa hanii'ni utaala'n</para>
  <para style="q1" vid="SNG 2:8">Gooruwwati hanii'ninna xogga'n</para>
  <para style="q2" vid="SNG 2:8">ane'n dage.<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />Ank eeyyemalchi xaaxa yookaan qiilla gammoojjeke gadansa labbaan;</para>
  <para style="q2" vid="SNG 2:9">kunse, no'oke minixxe gimo uduma uurreedheen;</para>
  <para style="q1" vid="SNG 2:9">Maskootetenaa'n sammi hiyye mini'a uuda'neen;</para>
  <para style="q2" vid="SNG 2:9">qo'akeenaa'ninna ceeqqisa'neen.<verse eid="SNG 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10" />Anke eeyyemalli anee hiyyee qici,</para>
  <para style="q2" vid="SNG 2:10">«Tee anxe jaalala ke'i;</para>
  <para style="q2" vid="SNG 2:10">tee anxe danchilee aniba'a amo.<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />Kunse haarsi sa'een;</para>
  <para style="q2" vid="SNG 2:11">xeenikinna caame sa'eedheen.<verse eid="SNG 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12" />Daraaruwwi bogi giddo leelleen;</para>
  <para style="q2" vid="SNG 2:12">meellatixxi yanna dageen</para>
  <para style="q1" vid="SNG 2:12">Guugenotik hafuur</para>
  <para style="q2" vid="SNG 2:12">no'oke bogi giddo laqeme.<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />Balase gumma gummisse'e</para>
  <para style="q2" vid="SNG 2:13">daraarteexxi woyyinuwwanna fishshe fa'a assite.</para>
  <para style="q1" vid="SNG 2:13">Tee anxe eeyyemallo kexxe amo;</para>
  <para style="q2" vid="SNG 2:13">tee anxe danchilee anibaa amo.»<verse eid="SNG 2:13" /></para>
  <para style="sp">Labbaka Waajubichcho</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />Rassatike baqaquwwa'n</para>
  <para style="q2" vid="SNG 2:14">koobuwwa giddo sho'omatixxe bakkaara'n hexxettexxe tee anxe guugenjoo!</para>
  <para style="q1" vid="SNG 2:14">Alba atika ane'n leellishshaata;</para>
  <para style="q2" vid="SNG 2:14">Haaso'i atik xe'make</para>
  <para style="q1" vid="SNG 2:14">Bifa atixxinna biiffaammaxxee</para>
  <para style="q2" vid="SNG 2:14">hafuura atikanna ane'n laqissaata.<verse eid="SNG 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />No'ok woyinetike hiddichchixxa bakka</para>
  <para style="q2" vid="SNG 2:15">daraaroke'n hedheeka no'oka woyinetik hiddichchixxa bakka</para>
  <para style="q1" vid="SNG 2:15">Balleessita'neexxa yayyuwwa;</para>
  <para style="q2" vid="SNG 2:15">eettene shiixxaramma yayyuwwa no'o'a fonxoroti abidde.<verse eid="SNG 2:15" /></para>
  <para style="sp">Waajubichcho</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />Ank eeyyemalli anke, aninna isixxe;</para>
  <para style="q2" vid="SNG 2:16">isi hore ifika danchallamma daraaruwwi giddo bobbaalsa.<verse eid="SNG 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17" />Boro haachchabbebaa edo</para>
  <para style="q2" vid="SNG 2:17">dukkanatinna saxxebaang;</para>
  <para style="q1" vid="SNG 2:17">Koo anke eeyyemalloo</para>
  <para style="q2" vid="SNG 2:17">xaaxxuffa yookaan</para>
  <para style="q1" vid="SNG 2:17">Bobboqqe koobuwwa ha'nii'n xoggitammaxxe</para>
  <para style="q2" vid="SNG 2:17">gadansiinxe beltanjoshsha labi.<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1" />Hashsha duuchcha taqete'n hedhe'e</para>
  <para style="q2" vid="SNG 3:1">eeyyemallo anka yorenne;</para>
  <para style="q2" vid="SNG 3:1">yorenne malee kinni alfebo'no.<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />Ke'ennexxi qachchi giddo maro;</para>
  <para style="q2" vid="SNG 3:2">lumolla oruwwa'ninna woldeenna weldeenna'n mammarema'n;</para>
  <para style="q1" vid="SNG 3:2">Eeyyemallo anka hasannon;</para>
  <para style="q2" vid="SNG 3:2">hasennen; yaane kinni isoo afebo'no.<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />Qachchi giddo mammaremma'neek</para>
  <para style="q2" vid="SNG 3:3">qachcha heqqaammaki manni anee afe.</para>
  <para style="q2" vid="SNG 3:3">Aninna, «Eeyyemallo anka afinee?»</para>
  <para style="q2" vid="SNG 3:3">insa'nee hiyyene.<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />Insa'nebaa'n heene qico edi'a sa'enneshshanni</para>
  <para style="q2" vid="SNG 3:4">eeyyemallo anka alfenne, abixxenne</para>
  <para style="q1" vid="SNG 3:4">Anxe amake mine'n isoo iyyedagannoxxee</para>
  <para style="q2" vid="SNG 3:4">godoba anee ba'exxeemmaxxixxe kuta giddo iyyedaganno qico'ni</para>
  <para style="q2" vid="SNG 3:4">isoo wocci assebe'no.<verse eid="SNG 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />Tee Iyyerusaalemixxe dubartee</para>
  <para style="q2" vid="SNG 3:5">jaalala umo ifingenninni yorte'e kexxaa qico'n</para>
  <para style="q1" vid="SNG 3:5">Jaalala lele'missinabaashsha yookaan dammassitinabaashsha</para>
  <para style="q2" vid="SNG 3:5">xaaxiinkenninna qiilla gammoojjeke gadansike summinni ha'no kadhatenne.<verse eid="SNG 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />Karbetinna hixaanik</para>
  <para style="q2" vid="SNG 3:6">daddaltotixxe qurunfuduwwa duuchchinni qophpheesendeexxe shittoshsha</para>
  <para style="q1" vid="SNG 3:6">Isexxi fishshe fa'a hita'neexxi</para>
  <para style="q2" vid="SNG 3:6">wiliilletishsha gammoojje qiillinaa'n fulda'nexxi tinni aate ise?<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">Qiillinaa'n fulda'nexxi tinni ayyete ise? Yookaan qiilla gammojjenaa'n daga'neelchi maachcho?</char></note><verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />Kunse Solomoonixxi fadhadiinxe gaarre;</para>
  <para style="q2" vid="SNG 3:7">ege'nemeeke Isira'eelike ja'laabuwwinaa'n</para>
  <para style="q2" vid="SNG 3:7">jaane tomme loliinki manni buqee'naa daga'neen.<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />Insa'ne duuchchiing wolantichcha ka'le'eekenni;</para>
  <para style="q2" vid="SNG 3:8">duuchchiing adhe barate'eeken.</para>
  <para style="q1" vid="SNG 3:8">Hashshanna buuto ilaanchonna faachcheffatatee</para>
  <para style="q2" vid="SNG 3:8">wolaantichcha hidhake'n ka'line'een.<verse eid="SNG 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9" />Moyanji Solomooni ifi'a fadhadiinxa gaarre giisedhe;</para>
  <para style="q2" vid="SNG 3:9">giisedheekinna Libaanoosii'n daggeexxe haqqenniten.<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />Isika utuphuwwanna birretike sibljinni giisse;</para>
  <para style="q2" vid="SNG 3:10">isixxa boraatenna worqeti giisse.</para>
  <para style="q1" vid="SNG 3:10">Barcumi isikinna baddeessitte haarrenni buqemeeken;</para>
  <para style="q2" vid="SNG 3:10">isi giddi kinni Iyyerusaalemixxe dubarte'e</para>
  <para style="q1" vid="SNG 3:10">Jaalalati buqemeeken.<verse eid="SNG 3:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="SNG 3:11" />Tee ha'no Iyyerussaalemmixxe dubartee fulle.</para>
  <para style="q1" vid="SNG 3:11">Solomooni kallachcha uggudhdheen uudde;</para>
  <para style="q2" vid="SNG 3:11">kunni kallachchinna isi qalbeti yo'oshsha gammadeexxe</para>
  <para style="q1" vid="SNG 3:11">Eettene isixxe aadha baro</para>
  <para style="q2" vid="SNG 3:11">ama isixxi iso'n uggiteeken.<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="sp">Labbaka Waajubichcho</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1" />Tee anxe eeyyemallo, ati hittata biifeettexxe;</para>
  <para style="q2" vid="SNG 4:1">hittata danchoondeettexxe</para>
  <para style="q1" vid="SNG 4:1">Alba buqe'eetexxe sharbe giddo illuwwa atixxi</para>
  <para style="q2" vid="SNG 4:1">guugenjotixxe illuwwashshaten.</para>
  <para style="q1" vid="SNG 4:1">Umi atikik ordichchinna Gele'adixxe Kobanaa'n adadde</para>
  <para style="q2" vid="SNG 4:1">yaa'ammake re'etike bobba'ishshaten.<verse eid="SNG 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2" />Atixxi isso iikki woddi orda cirendee'naa</para>
  <para style="q2" vid="SNG 4:2">anshemeebaa'n fuleeke gedhebishshaten;</para>
  <para style="q1" vid="SNG 4:2">Duuchchiing gedhebi lakko lakko ile'eeke,</para>
  <para style="q2" vid="SNG 4:2">isi giddonna maseeni mitti hedhebaaken.<verse eid="SNG 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3" />Suume atixxi diimmoxxe haarreka shimala labbaan;</para>
  <para style="q2" vid="SNG 4:3">haasottatto wodda yo'oshsha gammachchiisa'nen;</para>
  <para style="q1" vid="SNG 4:3">Alba buqqexxeettaxxe sharbe giddo lamiinxi atixxi boqo</para>
  <para style="q2" vid="SNG 4:3">welinaa'n shatendeexxe roomaanetixxe lame qame labbaan.<verse eid="SNG 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4" />Goobi atik danchoosseme giissemeeka</para>
  <para style="q2" vid="SNG 4:4">isi hananna loliinke mannixxi wontuwwa duuchchi itti hexxeexxa</para>
  <para style="q1" vid="SNG 4:4">Kuma wontuwwa itti fannisendeexxa</para>
  <para style="q2" vid="SNG 4:4">heqqatixxa Daawwitixxe xellephpho labbaan.<verse eid="SNG 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5" />Atik lami ununuwwi lakko ilendeexxe</para>
  <para style="q2" vid="SNG 4:5">dancha daraaruwwixxe oddo'n bobbaateexxe</para>
  <para style="q2" vid="SNG 4:5">geedummatixxe lame beltanna labbaan.<verse eid="SNG 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6" />Boro haachchabbebaa edo</para>
  <para style="q2" vid="SNG 4:6">dukkanatinna saxxebaang,</para>
  <para style="q1" vid="SNG 4:6">Karbetixxa kooba</para>
  <para style="q2" vid="SNG 4:6">hixaaniinxa gooronna marannon.<verse eid="SNG 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7" />Tee anxe eeyyemalloo danchumma ate'n gunde'een;</para>
  <para style="q2" vid="SNG 4:7">unshinaachchonna affeboxxon.<verse eid="SNG 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8" />Tee anxe waajubichcho Libaanoosinaa'n aninni welti dagi;</para>
  <para style="q2" vid="SNG 4:8">eeye, Libanosinaa'n aninni welti dagi.</para>
  <para style="q1" vid="SNG 4:8">Neenquwwiinxe majoonaa'n</para>
  <para style="q2" vid="SNG 4:8">qeedhanchiinxe koobaa'n</para>
  <para style="q1" vid="SNG 4:8">Ermoonixxe qaccee'n, Seneerixxe xungonaa'n,</para>
  <para style="q2" vid="SNG 4:8">Amaanaxxe koobaxxe xungonaa'ni dirri.<verse eid="SNG 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9" />Tee anxe dayyo, anxe waajubichchoo qalbe anenaa'n boojiteetten;</para>
  <para style="q2" vid="SNG 4:9">mitte atixxe qe'lenchonni,</para>
  <para style="q1" vid="SNG 4:9">Marte atike goobikkinni,</para>
  <para style="q2" vid="SNG 4:9">qalbe anee boojiteetten.<verse eid="SNG 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10" />Tee anxe dayyo, anxe waajubichchoo ati anee hittata gammachchisa'ette!</para>
  <para style="q2" vid="SNG 4:10">Ati anee eeyyissaatte qici woyinetixxe booka caala</para>
  <para style="q1" vid="SNG 4:10">Anee hittatata gammachchiisa'ne.</para>
  <para style="q2" vid="SNG 4:10">Atixxe shittoxxi fishshe wele qurunfuduwwanaa'n caaldaan.<verse eid="SNG 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11" />Tee anxe waajubichcho atixexe summexxi sunqecca malemiinxe la'eshsha xe'mita'neen;</para>
  <para style="q2" vid="SNG 4:11">afo'i atik malemokenna adoten.</para>
  <para style="q2" vid="SNG 4:11">Seemma atixxixxi fishshenna Libaanoosixxe fishsheshshaten.<verse eid="SNG 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12" />Tee anxe dayyo anxe waajubichcho ati dalla'i giddixxe eloke hiddichchiinxe bakka</para>
  <para style="q2" vid="SNG 4:12">dalla'i giddixxe muume, gollendeexxe gooton.<verse eid="SNG 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13" />Atik Roomanike hiddichchixxi</para>
  <para style="q2" vid="SNG 4:13">filendeexxi gummuwwa</para>
  <para style="q2" vid="SNG 4:13">heenanna naardoosixxe'n.<verse eid="SNG 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14" />Iittanni naardoosixxinna qeegaki welti,</para>
  <para style="q2" vid="SNG 4:14">basso billanna qarafa,;</para>
  <para style="q2" vid="SNG 4:14">gargar gargar hedheeke hixaanuwwixxa heqqe</para>
  <para style="q2" vid="SNG 4:14">karbetixxenna qaraaranjo haqichchixxe</para>
  <para style="q2" vid="SNG 4:14">yo'oshsha eloxxe gargar gargar hexxeexxe qurunfuduwwa duuchchixxen.<verse eid="SNG 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15" />Ati hiddichuwwiinxe eloxxe bakkaxxe gooton;</para>
  <para style="q2" vid="SNG 4:15">yaa'aake wodixxe balen;</para>
  <para style="q2" vid="SNG 4:15">Libaanoosixxe Koobanaa'n adadde phu'isammake wodixxe muummen.<verse eid="SNG 4:15" /></para>
  <para style="sp">Waajubichcho</para>
  <para style="p">
    <verse number="16" style="v" sid="SNG 4:16" />Tee middixxe diidalloo ke'i;</para>
  <para style="q2" vid="SNG 4:16">ati bita'ixxi diidllonna amo</para>
  <para style="q1" vid="SNG 4:16">Fishshe anke fichcixxi ha'la kuttaashsha,</para>
  <para style="q2" vid="SNG 4:16">anke hiddichchixxe bakkaba'a diidalleessi;</para>
  <para style="q1" vid="SNG 4:16">Ank eeyyemalli ifike hiddichchi giddi'a dageexxi</para>
  <para style="q2" vid="SNG 4:16">gammachchiisaaxxa ookkone fichchixxa gummuwwanna itowwaal.<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">Labbaka Waajubichcho</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1" />Anxe dayyo anxe waajubichchoo anke hiddichchinxe bakkabaa dagenne;</para>
  <para style="q2" vid="SNG 5:1">anxe karbenna anxe shitotike haqqichchixxa gummuwwa qocedhenne;</para>
  <para style="q1" vid="SNG 5:1">Anxa malebiinxa dhaaba la'endinni iteeneni;</para>
  <para style="q2" vid="SNG 5:1">anxa woyinetixxa bookanna anxa ado ha'weeneni.</para>
  <para style="sp" vid="SNG 5:1">Jaaluwwi</para>
  <para style="q1" vid="SNG 5:1">Jaaluwwi itte ha'we;</para>
  <para style="q2" vid="SNG 5:1">ha'no koo waajubichchonna tee waajubichcho jaalalti he'e hitinaa qico ha'we.<verse eid="SNG 5:1" /></para>
  <para style="s1">Waajubichcho</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2" />Ani diipheennen; qalbe anxi kinni diiphphebaan;</para>
  <para style="q2" vid="SNG 5:2">caqasse! Eeyyemalli ank hula gangana'n hiyya'ne qici,</para>
  <para style="q1" vid="SNG 5:2">Anxe eeyyemalloo, anxe dayyoo, anxe guugenjo</para>
  <para style="q2" vid="SNG 5:2">tee anxe muxuuxee hula ani'a bani.</para>
  <para style="q1" vid="SNG 5:2">Umo anka qori</para>
  <para style="q2" vid="SNG 5:2">umiinka anka ordichchonna hashshik woji shanshe corco asseen.<verse eid="SNG 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />Seemma woldo fulchedhenen;</para>
  <para style="q2" vid="SNG 5:3">hittata langaxxa oddo'wanno?</para>
  <para style="q1" vid="SNG 5:3">Lekka woldo anshedhennen</para>
  <para style="q2" vid="SNG 5:3">hittata langaxxa xureessedhanno?<verse eid="SNG 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />Ank eeyyemalli anga qo'akenaa'ni lussee wodda</para>
  <para style="q2" vid="SNG 5:4">godobi anee isi'a raafemate'n ke'e.<verse eid="SNG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5" />Anke eeyyemalli'a banonaa ke'enne;</para>
  <para style="q2" vid="SNG 5:5">karbetike shamininni corco hiteexxe anxe anganni</para>
  <para style="q1" vid="SNG 5:5">Duneddemmaxxe karbenni coo'mi hiteemmaxxe anxe qubbuwwanni</para>
  <para style="q2" vid="SNG 5:5">hulatika banisanjo abideenne.<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />Eeyyemallo anekee hula banenne;</para>
  <para style="q2" vid="SNG 5:6">eeyyemalli ank kinni me'eemman; hedhemmabaan.</para>
  <para style="q2" vid="SNG 5:6">Me'aammaxxee qalbe anixxi moornde.</para>
  <para style="q1" vid="SNG 5:6">Isoo jabeesse hasenne yaane kinni afebe'no;</para>
  <para style="q2" vid="SNG 5:6">isoo ye'enne yaane kinni heeyebaan.<verse eid="SNG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />Ookkone qachcha heqqaammak manni</para>
  <para style="q2" vid="SNG 5:7">qachchi giddo mammarema'n qachcha heqqaammake manna'n leellenne.</para>
  <para style="q1" vid="SNG 5:7">Iikki qachcha heqqaammak manni</para>
  <para style="q2" vid="SNG 5:7">anee ganne madeessine;</para>
  <para style="q2" vid="SNG 5:7">Seemma anxanna mulqe'ne.<verse eid="SNG 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />Ha'no tee Iyyerusaalemixxe dubartee</para>
  <para style="q1" vid="SNG 5:8">Eeyyemalli anki ha'no'n leello'oole</para>
  <para style="q2" vid="SNG 5:8">jaalala isixxenni ani jammi hiyyennexxa iso'n kuldinaashsha</para>
  <para style="q2" vid="SNG 5:8">ha'noo maganne hiyyaannen.<verse eid="SNG 5:8" /></para>
  <para style="sp">Isexxa Jaaluwwa</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />Tee ati melaalle duuchchinaa'n caala danchoondeettexxee</para>
  <para style="q2" vid="SNG 5:9">atik eeyyemalli wele eeyyemmalluwwinaa'ni danchumma haba caalammalete?</para>
  <para style="q1" vid="SNG 5:9">Konne qico'o no'oo magannissa'ettechchi</para>
  <para style="q2" vid="SNG 5:9">eeyyemalli atik welekenaa'n danchumma haba caale'naate?<verse eid="SNG 5:9" /></para>
  <para style="sp">Meyyaxxa waajubichcho</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />Eeyyemalli ank unde'naanna goddisabaake,</para>
  <para style="q2" vid="SNG 5:10">isi kuma labballo ginbaaken.<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />Umi iski ca'a hiteexxe worqe</para>
  <para style="q2" vid="SNG 5:11">isike umink ordichchi luuccakenna</para>
  <para style="q2" vid="SNG 5:11">qodhandiinsha xilloke quca.<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />Ille isixxir</para>
  <para style="q2" vid="SNG 5:12">muummeti qarqara hexxeexxe guggenjuwwashsha</para>
  <para style="q1" vid="SNG 5:12">Adotishsha gola'litaaxxe</para>
  <para style="q2" vid="SNG 5:12">qubbi qubbi hiyyeeke seesuwwishannaten.<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />Isixxe lamiinxe boqoxxe fishshexxi elle</para>
  <para style="q2" vid="SNG 5:13">gargar gargar hexxeexxe qurunfudduwwa hiddichchiinxe bakka fakkaattaan;</para>
  <para style="q1" vid="SNG 5:13">Suume isixxinna karbetixxe shittoxxi fishshe fa'a assaammake</para>
  <para style="q2" vid="SNG 5:13">dancha daraarishshaten.<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />Hirre isixxi fiixeeke kinjinni danchossendeexxe</para>
  <para style="q2" vid="SNG 5:14">worqetixxe zange labba;</para>
  <para style="q1" vid="SNG 5:14">Bisi isikinna senpeeri hiyyemaake fiixeeke kinjike seesinni</para>
  <para style="q2" vid="SNG 5:14">danchoossende'e giissendeexxe daane'iinxe isso labbaan.<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />Lekka isixxiir ca'itte worqeke uremalcho'n kaasemeeke</para>
  <para style="q2" vid="SNG 5:15">cabbetishsha hedheeke fiixeeke kinjike utuphuwwa labba.</para>
  <para style="q1" vid="SNG 5:15">Dhagga isixxinna Libaanoosixxe kooban;</para>
  <para style="q2" vid="SNG 5:15">eettene koobbaxxe birbiirsixxe haqqeshshanna filemeeken.<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />Afo'i isiki hara xe'me birasa'eeke</para>
  <para style="q2" vid="SNG 5:16">hedho isixxi duuchchinna halchissaaken;</para>
  <para style="q1" vid="SNG 5:16">Tee ha'no'o Iyyerusaalemixxe dubartee</para>
  <para style="q2" vid="SNG 5:16">yoona konnete ank eeyyeamalli; jaali ankinna isoten.<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">Isexxa jaaluwwa</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />Tee ati melaalle duuchchinaa'n caala danchondeettexxee</para>
  <para style="q2" vid="SNG 6:1">atik eeyyalli haba hedhe?</para>
  <para style="q1" vid="SNG 6:1">Atinni welti hansonna'a</para>
  <para style="q2" vid="SNG 6:1">eeyyemalli atik me'eebi hoone darre'nite?<verse eid="SNG 6:1" /></para>
  <para style="sp">Meyyaxxa Waajubichcho</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2" />Eeyyemalli anki hore ifika bobbaalsatee</para>
  <para style="q2" vid="SNG 6:2">dadanchoole daraaro bukki assedhatee</para>
  <para style="q1" vid="SNG 6:2">Fishshallo qurunfuuduwwa hexxeeba</para>
  <para style="q2" vid="SNG 6:2">aade ifike hiddichchuwwike boonchibaa mareen.<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />Ani anke eeyyalixxen ank eeyyalinna anken;</para>
  <para style="q2" vid="SNG 6:3">isi hore ifika daraarteexxe suufe giddo bobbaalsaan.<verse eid="SNG 6:3" /></para>
  <para style="sp">Labbak Waajubichi</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4" />Tee anxe eeyyemalloo, Tirtsake qachchishsha ati danchate;</para>
  <para style="q2" vid="SNG 6:4">Iyyerusaalemishshanna eldaatten;</para>
  <para style="q2" vid="SNG 6:4">baandira abixxe fuleeke sannachishshanna gaachchanniik sodaachchissaattexxen.<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />Insa'ni anee boojiinmaxxee'e;</para>
  <para style="q2" vid="SNG 6:5">ille atixxa anenaa'n hoyyedhi</para>
  <para style="q1" vid="SNG 6:5">Atike umik ordichchi Gele'adixxe Koobanaa'n adadde ya'eeke</para>
  <para style="q2" vid="SNG 6:5">horiinke bobba'ishshaten.<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />Atixxi issoori</para>
  <para style="q2" vid="SNG 6:6">ansheme fuleeka gedhebo,</para>
  <para style="q1" vid="SNG 6:6">Duuchching lakko lakko ileekenna</para>
  <para style="q2" vid="SNG 6:6">isi giddii'ninna mittikinna maseenni hedhemabaakishshaten.<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />Buqecatixxe sharbe giddii'n atixxi lamiinxi boqo</para>
  <para style="q2" vid="SNG 6:7">welinaa'n shatendeexxe roomaanetixxe lame qame labbaan.<verse eid="SNG 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />Jaane tomme mootittuwwa,</para>
  <para style="q2" vid="SNG 6:8">saddeeta tomme garba aruwwanna</para>
  <para style="q2" vid="SNG 6:8">laakkossi birra sa'eeki heddi dubaruwwi hedha dande'aan;<verse eid="SNG 6:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="SNG 6:9" />Yaane kinni busheeshshinaachcho affebaaxxi anxi guuggenjo ise gargar hexxeexxen;</para>
  <para style="q2" vid="SNG 6:9">isenna amatee filendeexxe,</para>
  <para style="q2" vid="SNG 6:9">ildeexxi ama isexxinna mittelchoten;</para>
  <para style="q1" vid="SNG 6:9">Dubarrikinna isee uudeexxi, «Atixxa wodo!» hite;</para>
  <para style="q2" vid="SNG 6:9">mootittuwwatinna garba aruwwanna isee'e faarsiteen.<verse eid="SNG 6:9" /></para>
  <para style="sp">Isexxa jaaluwwa</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />Soodimariinke ifishsha turuffi hiteexxi,</para>
  <para style="q2" vid="SNG 6:10">agenjiinshanna wa'a hite, arishshotishsha iffeexxi,</para>
  <para style="q2" vid="SNG 6:10">Baandira abixxe googeessa fuleeke sannachchishsha, gaachchanni isek sodaachchisa'neexxi tinni ise ayyete?<verse eid="SNG 6:10" /></para>
  <para style="sp">Labbaka Waajubichcho</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />Dhooqa giddo lateeka reefika hiddichchuwwa uushshotee,</para>
  <para style="q2" vid="SNG 6:11">woyinetinna luuphisse;</para>
  <para style="q2" vid="SNG 6:11">roomaanenna daraartexxa uudate</para>
  <para style="q2" vid="SNG 6:11">adadde hiddichchiinka fichcha marenne.<verse eid="SNG 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12" />Tennee ege'nebe'no edi darre</para>
  <para style="q2" vid="SNG 6:12">halcha anxi anee anke ardixxe moyanjiinxe fadhadiinxe gaaruwaxxe oddo'n anee offo'lishshe.<verse eid="SNG 6:12" /></para>
  <para style="sp">Jaaluwwa Isexxa</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13" />Tee Sulaamaaxi, higge dagi, higge dagi ballo'o</para>
  <para style="q2" vid="SNG 6:13">atee uundonnaa higge dagi, maganneten higge dagi.</para>
  <para style="sp" vid="SNG 6:13">Labbak Waajubichchi</para>
  <para style="q1" vid="SNG 6:13">Mehanayimika sirba uudamake manjishsha,</para>
  <para style="q2" vid="SNG 6:13">Sulamaxisi'i uudina'eechchi mayeete?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1" />Tee ja'laabiinxe beltoo,</para>
  <para style="q2" vid="SNG 7:1">kophe giddo atixxi lekka hittata elda'nee!</para>
  <para style="q1" vid="SNG 7:1">Biifa'neek atik tafiir beetto anga ifixxenni gisiteeke</para>
  <para style="q2" vid="SNG 7:1">fiixa seesuwwa labbaan.<verse eid="SNG 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2" />Ha'nura atixxi wo'ma woyinetixxi eloxxi booka</para>
  <para style="q2" vid="SNG 7:2">giddo hexxeexxe gugu'mitte buuda labbaan.</para>
  <para style="q1" vid="SNG 7:2">Hidhi atik bukki assende usurendeexxe</para>
  <para style="q2" vid="SNG 7:2">dinnetixxe ladde labbaan.<verse eid="SNG 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3" />Atik lamiing unun</para>
  <para style="q2" vid="SNG 7:3">lakko gadansiinxe beltanna labbaan.<verse eid="SNG 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4" />Goobi atik Daane'iinxe issonni seesendeexxe, xelleephpho labbaan.</para>
  <para style="q1" vid="SNG 7:4">Ille atixxir Bati Reebike qachchike dalla'ixxe hulake</para>
  <para style="q2" vid="SNG 7:4">Haseebonike baleesuwwa labbaan.</para>
  <para style="q1" vid="SNG 7:4">Sano atixxi Demasiqo darre'n alba wirri hiteexxe</para>
  <para style="q2" vid="SNG 7:4">Libaanoosixxe xelleephphoshshaten.<verse eid="SNG 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5" />Atik umi ati hana Qermeeloosixxe Koobashsha ati'a gaachchannake kadde'een;</para>
  <para style="q2" vid="SNG 7:5">ordichchi atike umik haarreti shimalixxe camarre labaan;</para>
  <para style="q2" vid="SNG 7:5">moyanjikinna atike shurrubbike shaggummaa booji'emeen.<verse eid="SNG 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6" />Ati hittata danchate! Hittata eldaattexxe!</para>
  <para style="q2" vid="SNG 7:6">Tee anxe eeyyemalloo, ati gammaachchisaatexxen.<verse eid="SNG 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7" />Hojja atixxi meexxetishsha tagaggi hiteexxen;</para>
  <para style="q2" vid="SNG 7:7">ununi atikinna isenxe rogge labaan.<verse eid="SNG 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8" />Aninna, «Eettenee meexxe da'me da'mannon;</para>
  <para style="q2" vid="SNG 7:8">gumma isexxa qocedhannon» hiyyenne.</para>
  <para style="q1" vid="SNG 7:8">Ununi atikir woyinetixxe roddeshshaten,</para>
  <para style="q2" vid="SNG 7:8">atike hafuurxi fishshenna Apletixxe gummakishsha kaduun.<verse eid="SNG 7:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="SNG 7:9" />Suume atixxinna eloxxe woyinetixxe bookashsha xe'mituun.</para>
  <para style="sp" vid="SNG 7:9">Meyyaxxi Waajubichcho</para>
  <para style="q1" vid="SNG 7:9">Yoona iitti eloxxi woyinetixxi booka</para>
  <para style="q2" vid="SNG 7:9">laana dhuqudhuqu hita'n</para>
  <para style="q2" vid="SNG 7:9">anke eeyyemallike afo'i giddi'a issotixxe oddonaa'n saxxuun.<verse eid="SNG 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10" />An anke eeyyallixen;</para>
  <para style="q2" vid="SNG 7:10">isixxi yortenna anenden.<verse eid="SNG 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11" />Koo anke eeyyallo, amo hadi giddi'a me'ino;</para>
  <para style="q2" vid="SNG 7:11">ookkonna baxxe mare gallo.<verse eid="SNG 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12" />Bariisa woyinetike hiddichchika fichcha marro;</para>
  <para style="q2" vid="SNG 7:12">woyine luuphisseexxa,</para>
  <para style="q1" vid="SNG 7:12">Daraartenna pha'a hiteexxa,</para>
  <para style="q2" vid="SNG 7:12">roomanetinna gummiseexxa uundo;</para>
  <para style="q2" vid="SNG 7:12">Ookkonna jaalalati ani ifi ati'aa uwwannon.<verse eid="SNG 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13" />Turunguwwatinna fishshe fa'a assiteen;</para>
  <para style="q2" vid="SNG 7:13">reefi qocendeexxe kadi raxxeexxi</para>
  <para style="q1" vid="SNG 7:13">Xe'maxxi gumma duuchcha,</para>
  <para style="q2" vid="SNG 7:13">baxxe no'oxxe'n wo'miteen;</para>
  <para style="q2" vid="SNG 7:13">tinniirinna koo anke eeyyemallo, ani ati'a uggeennen.<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1" />Maa hedhe silaati, mitte amaka ununa unu'nineennele</para>
  <para style="q2" vid="SNG 8:1">anke dayyo kaddeetele!</para>
  <para style="q1" vid="SNG 8:1">Ookkoo'n atee gadho afe'eennele,</para>
  <para style="q2" vid="SNG 8:1">silaati atee sunqedhannan;</para>
  <para style="q2" vid="SNG 8:1">ayyinna anee tuffatammabaan.<verse eid="SNG 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2" />Ati, edo me'a'n</para>
  <para style="q2" vid="SNG 8:2">anee barsiisseemmaxxe,</para>
  <para style="q2" vid="SNG 8:2">anixe amake minibaa atee iyyemarannan;</para>
  <para style="q1" vid="SNG 8:2">Ha'wittatoxxa xe'maxxa woyintixxa booka,</para>
  <para style="q2" vid="SNG 8:2">roomaanetika bulbulonna ati'a uwwannan.<verse eid="SNG 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3" />Bita'ixxa anga isixxa boraafateennen;</para>
  <para style="q2" vid="SNG 8:3">middixxi anga isixxinna anee hanqalfiteen.<verse eid="SNG 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4" />Tee Iyyerusaalemixxe dubartee,</para>
  <para style="q2" vid="SNG 8:4">jaalala umo ifikenni eete kexxa qico'n</para>
  <para style="q2" vid="SNG 8:4">jaalala nunnussitinabaashsha ha'noo maganne hiyyaannen.<verse eid="SNG 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5" />Ifike eeyyallixxe dugummo'n irkatteexxi</para>
  <para style="q2" vid="SNG 8:5">qiilla gammoojjenaa'n alalle dagete'n hexxeexxi isi tinni ayyete?</para>
  <para style="sp" vid="SNG 8:5">Meyyaxxa Waajubichcho</para>
  <para style="q1" vid="SNG 8:5">Qara ama atixxi ate'e godoba horatte ildeemmabaan,</para>
  <para style="q2" vid="SNG 8:5">ookko Apletike haqichchi hunda atee dammassenne.<verse eid="SNG 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6" />Qalbe giddo maatamiinsha</para>
  <para style="q2" vid="SNG 8:6">anga atixxe'ninna qabbantetishsha anee uggudhdhi;</para>
  <para style="q1" vid="SNG 8:6">Jaalala reyoti caala jabachchon;</para>
  <para style="q2" vid="SNG 8:6">hinaafa isexxinna hirreessi caalanna gakki hitaan;</para>
  <para style="q1" vid="SNG 8:6">Tallissammaxxe giirashsha</para>
  <para style="q2" vid="SNG 8:6">jaba qico bubeniinshanna bubbaan.<verse eid="SNG 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7" />Jirak wodi'i isee habushshi assabaan;</para>
  <para style="q2" vid="SNG 8:7">abbaayyatik wodi'inna isee ca'la ca'la assabaan;</para>
  <para style="q1" vid="SNG 8:7">Manji karra afeexxa duuchcha</para>
  <para style="q2" vid="SNG 8:7">jaalaltee'e uwweexxe kaddeele</para>
  <para style="q2" vid="SNG 8:7">manni isoo ceeggaan.<verse eid="SNG 8:7" /></para>
  <para style="sp">Jaaluwwi Isik</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8" />Ununi guntutebaaxxe</para>
  <para style="q2" vid="SNG 8:8">dayyo shiixxoxxe anfeennen;</para>
  <para style="q1" vid="SNG 8:8">Isee laqe'naaxxa barra</para>
  <para style="q2" vid="SNG 8:8">ise'a maa assa dandeenna'neelaati?<verse eid="SNG 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9" />Ise silaati dalla'ake kaddeele</para>
  <para style="q2" vid="SNG 8:9">ise hana birretike sibljixxe xelleephpho ijaarraa'naa</para>
  <para style="q1" vid="SNG 8:9">Ise silaati hulate kaddeele</para>
  <para style="q2" vid="SNG 8:9">birbirsiinke cufaninni isee bunqaannani.<verse eid="SNG 8:9" /></para>
  <para style="sp">Meyyaxxa Waajubichcho</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10" />Kunse, ani dalla'ake'n</para>
  <para style="q2" vid="SNG 8:10">ununi anikinna xelleephphuwwatishshaten;</para>
  <para style="q1" vid="SNG 8:10">Aninna ille isixxe'n</para>
  <para style="q2" vid="SNG 8:10">nage'i isi'a afemaaxxe manjo kadenne.<verse eid="SNG 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11" />Solomooni woyinetike hiddichchika fichcha Ba'aalhamooni afeemmaan;</para>
  <para style="q2" vid="SNG 8:11">ookkone woyinetika fichchanna hiddichchiinke heqqanjuwwin maallaqakee uwween;</para>
  <para style="q1" vid="SNG 8:11">Mitti mitting heqqanjuwwinna ookkone fichchixxe gummake hiri'a</para>
  <para style="q2" vid="SNG 8:11">mitte mitte kuma birretika sibljo iyyedanga'emman.<verse eid="SNG 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12" />Yaane kinni ani umi ankenne woyinetike hiddichchika fichcha afeenen;</para>
  <para style="q2" vid="SNG 8:12">koo Solomooni, mitti kumi birretik siblji ati'anni;</para>
  <para style="q2" vid="SNG 8:12">lami dhibbinna woyinetike fichchixxa gumma heqqamakeri'anni kaduun.<verse eid="SNG 8:12" /></para>
  <para style="sp">Labbaka Waajubichcho</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13" />Tee ookkone hiddichchiinke fichchi giddo hexxettexxee;</para>
  <para style="q2" vid="SNG 8:13">jaaluwwi ank haaso'a atika caqansa'neen,</para>
  <para style="q2" vid="SNG 8:13">ballo'o aninna haaso'a atika laqo.<verse eid="SNG 8:13" /></para>
  <para style="sp">Meyyaxxi Waajubichcho</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14" />Koo anke eeyyemalloo, rakke anibaa dagi;</para>
  <para style="q2" vid="SNG 8:14">qimametik hiddichchuwwi fuldaaxxe koobuwwa'ni</para>
  <para style="q2" vid="SNG 8:14">utaaldammaxxe</para>
  <para style="q2" vid="SNG 8:14">geedumma yookaan gadansiixxa beltanna ani'a kadi.<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>