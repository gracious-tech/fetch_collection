<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Gedeo Bible</book>
  <para style="h">1 Qorontoosike Manni'a</para>
  <para style="toc1">Ergemallo Phawuloosixxa Siretixxaa Erga Qorontoosike Manni'a</para>
  <para style="toc2">1 Qorontoosike Manni'a</para>
  <para style="toc3">1 Qor.</para>
  <para style="mt2">Ergemallo Phawuloosixxa Siretixxaa Erga</para>
  <para style="mt1">Qorontoosike Manni'a</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Phawuloos Qorontoosike manni'a borresseexxi siretixxe erga borresendeek Qorontoos'n uureseexxe Mageniinxe tuuta giddo kirstoositotixxe hedhoxxeenna amanaxxee ke'e'emaxxe rakkoxxe ora leelishatee hadiyotiten. Ookkone wodda Qorontoos butta duuchchike Girkeke qachcha kadati iimi darre Akayya hiyyendaaxxe Roommexxe galcha'a umo qachchaman. Kunni qachchi lumoxxe kaddeexxe daddalatixxe lelema'n, nopheeke galadumini, lumoo qico ba'lata'n me'aammake adabixxe fuggachchininna gargar hedheeka magenuwwa magenoonfatatixxe birasa'ne'n ege'nemeekeman.</para>
  <para style="ip">Ergemalli giddii'n ille uggeek eetten Mageniinxi tuutta giddo hexxeemmaxxe qoqodensha'n hexxeemmaxxe adabiinxe ba'nexxe hedho'a, yababuletixxenna haadha herumixe, beetekirstaanexxe aadaxxe, Woyyichi Hafuurxe uwwarixxenna reyotenaa'n ka'atixxerateman; iitanna kunni erallammi eloxxe odoka hiyyichcho konne qortumauwwa hana dhuudhati xexe'achoti shiqishaan.</para>
  <para style="ip">«Eyumma» Magen arda ifike uwweexxe uwwarinaa'n saxxaaxxe kaddeexxa kulaal tommenna sakkaxxi hafuura adhdha konne maxaafi giddi'n hara lumooqica e'genemeeke kaddeexxa kulendaan.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">E'yichcho <char style="ior"><ref loc="1CO 1:1-9">1:1-9</ref> </char></para>
  <para style="io1">Kirstoostotik giddo kexxeexxa qoqodensha <char style="ior"><ref loc="1CO 1:10-4:21">1:10—4:21</ref> </char></para>
  <para style="io1">Adabixxa bunshexxenna mini hadixxa hedho <char style="ior"><ref loc="1CO 5:1-7:40">5:1—7:40</ref> </char></para>
  <para style="io1">Kirstoositonna Kirstoositotixxa amana adhdhebaakerxe <char style="ior"><ref loc="1CO 8:1-11:1">8:1—11:1</ref> </char></para>
  <para style="io1">Mageniinxe tuuttaxxe hedhoxxeenna magenoonfachchotixxa aada <char style="ior"><ref loc="1CO 11:2-14:40">11:2—14:40</ref> </char></para>
  <para style="io1">Kirstoosixxanna amanetixxa reyotenaa'n ka'a <char style="ior"><ref loc="1CO 15:1-58">15:1-58</ref> </char></para>
  <para style="io1">Yihuda giddo hexxeexxe kirstoosito rakkiyye'a gargaarsa <char style="ior"><ref loc="1CO 16:1-4">16:1-4</ref> </char></para>
  <para style="io1">Muuxama <char style="ior"><ref loc="1CO 16:5-24">16:5-24</ref> </char></para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />Mageniinxe fedhinni Yessuusi Kiristoosike erganjo kado'a ye'emeeke Pha'wuloosinaa'ninna dayyo no'oke Soositensinaa'n.<verse eid="1CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 1:2" />Qorontoosik qachchi giddo afendaaxxe Magenxe tuuta'a, Yessuusi Kiristoosinni woyyichchka kedeexxi Magenokee woyyichchake kado'a ye'emeekeri'a, iittanni booncho booncho'n insa'ne'aanna no'o'a Gootta kadeeke Yessuusi Kirstoosika summa ye'aake duuchchi'a.<verse eid="1CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />Mageno Anna no'okenna Gootta Yessuusi Kiristoosike badhaadhinni nage'i ha'no'a kadowwaal.<verse eid="1CO 1:3" /></para>
  <para style="s1">Magenoke Galata</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />Yessuus Kiristoosi badhadha ifika ha'no'a uwweexxe duuchchi wodda Mageno galateefata'enne. <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />Tinninna duuchchiinxe yaanenni, haaso'i duuchchinn, eege'na duuchchinni, Kirsitoosi darre'n durreeyette kaddinaashsha assendine'een.<verse eid="1CO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 1:6" />Kiristoosixxe ha'no'n kullenexxa yaane dhugaalessumma isexxa kokese'een. <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />Tennexxee Gootta no'oka Yessuusi Kiristoosixxa leella halcati heqqexxina'n hexxinaa wodda hiin hafuurnxi uwwanna ha'no'naa'n xe'yitabaan.<verse eid="1CO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 1:8" />Isinna Gootta Yessuusi Kiristoosixxe dagatixxe barra qico'n mitte ci'me mabelo hexxinaashsha ha'no jabeessaan. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />Belto ifike Gootta no'oke Yessuus Kiristoosinni welt mittumma afinaashsha ha'no'o ye'eek Magen addatemeeken.<verse eid="1CO 1:9" /></para>
  <para style="s1">Qorontoosixxe Mageniinxe Tuuta Giddo Kaddeexxa Qoqqoodensha</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />Anke dayyuwwa ha'no duuchching mitti afo'a haaso'tino'a mitti qalbe mitte yaada afinaasha weli aagino'a malee'e ha'no giddo weli qoodensha hexxabaashsha Gootta Yessuus Kiristoosike summinni ha'no kadhataanen. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />Anke dayyuwwa ha'noxxe oddo'n welgiba hexxeexxa Qelo'eke mini hadinnaan laqe'enen. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />Tinninna ha'no giddo mitti, «Ani Phawuloosiken» hiyya wodda weli kinni, «Ani Aphiloosiken» hiyya'neen; iittanni welinna «Ani Keefaken» hiyya wodda welkinna «Ani Kiristoosiken» hiyya'neen.<verse eid="1CO 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 1:13" />Isi Kiristoosi qoodeme'eta? Isi Pawuloosi ha'no'aa fansemeeta? Yookaan Phawuloosike summinni xammaqendineeta? <verse eid="1CO 1:13" /><verse number="14" style="v" sid="1CO 1:14" />Ani Qersiphoosinna Gayiyoosi gadhi darre ha'nonaa'n ayyeenna xammaqa gopheennaxxe Mageno galateefataannen. <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />Tennexxe summa ankenna xammaqenexxa haaso'aak ayyinna hedhebaan. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />Eeti Isxifaanosika mini hado xammaqeennen; konne gadhi darre weli xammaqenek manji hedheexxa qalli hiyyabo'non. <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />Kiristoosi ane'e ergeek wonegeel lallalbonaate malee'e xammaqonaatebaan; Kirstoosixxi wengel butta gatteexxe kaddabaashsha manjike haaso'inke beekuminni lallababo'non.<verse eid="1CO 1:17" /></para>
  <para style="s1">Kirstoos Magnke Beekumanna Hunnan</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />Kirstoosxe fannisenshaak haaso'i ba'aake manni'a gowwumatishsha uudema; no'oo anjiremmeneke kinni Mageiinxe hunnan.<verse eid="1CO 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 1:19" />Tinninna, «Beekoletika beekuma balleesanon</para>
  <para style="q2" vid="1CO 1:19">Ege'na afeemake mannixxa ege'nanna tolaa gatisanon» hiyyendeexxi borresendeemmashaten.<verse eid="1CO 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20" />Yoona beeki haba hedhetaa? Muxxali haba hedhetaa? Konne barki qo'nsalinna haba hedhetaa? Magen tenne buttaka beekum gowwumate asse'ebaataa? <verse eid="1CO 1:20" /><verse number="21" style="v" sid="1CO 1:21" />Mageniike beekuminaa'n kexxeexxa butta ifike beekuminni Mageno ege'naa dande'a gopheemmaxxe'e lallabatixxe gowwuma'n amanaakara anjiro'a Magniinxe fedhi kadde'en. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />Ayihudi mambe'iinka beesisuwwa uudo'a hasaan; Girkeek manninna beekuma yoraan. <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />No'o kinni fannisemeeke Kiristoosi lallanbannon; tinninna Ayihudakee gufo, Ayidake kadabaake kinni gowwumate.<verse eid="1CO 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 1:24" />Magen ye'eeke Ayihudake kadi Girkeeke manni'a, Kiristoosi Mageniinxe hunnanna Mageniinke beekuman. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />Tinninna kadde'eechi Mageniinxe gowwuman hiyyend hedendaaxxi yaane manjiinke beekumanaa'n saxxamaxxeten; Magniinxe hunna goha hiyyende hedendaaxxi yaanenna manjiinxe hunanaa'n saxxaaxxe kaddeemmaxxeten.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />Anke dayuwwa ye'endinema wodda hitta hexxinemake manna kadineemmaxxee amme hedde; manjiinxe uushoshsha ha'noonaa'n heddi manni beekuma afe'emabaake; heddi manninna jajjabakemabaan; ilenshatinna gurra fuleeke hado naa'nitemmabaan. <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />Yaane kinn Magen beekole shookishatee buttate'n gowwooletishsha uudemamaka manna fi'le; jajjabba mannanna shookishatee buttate'n hedheeka gophaalsa manna file. <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />Magen ulfatteexxa yaane hexxebashsha assatee tenne buttixxa yuukkitexxanna tuffatendeexxa yaane, wayifuldabaaxxa yaanenna fi'le. <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />Tennennenna asseechchi ayyinna isi edo hollabaashaten. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />Ha'no kinni Yessuus Kiristoosinni welti mittumma afatee geltineechi isinaa'n kexxeexxiniten; tennexxe Mageni Yessuusi'i beekuma no'oke, qullumma no'oxxe, woyyumma no'oxxeenna wodo no'oxxe'e kadaashsha asse. <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />Yoonna, «Ifi saadaak Goottik ifi saadowaal» hiyyendee borresendeemmashaten.<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s1">Mageniinxa Murte</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />Anke dayyuwwa ani ha'nobaa dagene wodda Mageniinxa buqqo yaane anke haaso'ixxa dandee'anni yookaan quba sa'eeka beekuminni hano'n leelishate dagebo'non. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />Tenne assenelchi ha'noonni hedhenna wodda Yessuus Kiristoosi gadhi darre, giddii'ninni fannote'n fanniseme reya isixxa malee wele yaane ege'nabo'noshsha mudhdheennaxxeten. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />Ani ha'nooba dageenaki anxe ifi gonphenninna soda'ati, iittanni lumoxxe culphisanteman. <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />Haaso'i ankinna lallaba anxi Woyyicchhi Hafuurixxa hunna leellishaammaxxe malee'e sossobatike beekumiinke haaso'amabaan. <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />Tennenna asseneelchi ha'nooxxi amana Mageniinxe hunna'nite malee'e manjiinke beekuma'n irkatteexxe kaddabaashaten.<verse eid="1CO 2:5" /></para>
  <para style="s1">Woyyichchi Hafuurka Beekuma</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />Yaane kinni hafuurinxe hedhonni jabaateke manna'n beekumiinke haaso'a haasonnanon; kaddo malee'e kunni beekum tenne buttake yookaan konne barike ba'e gataake galchalluwwike beekumabaan.<verse eid="1CO 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 2:7" />No'o haasona'enek kinni Magen ediseenni baruwwi edi darre ulfinna no'oke mureemmakanna buqeme hedhemaka Magniinxe buqo yaaneke beekuman. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />Tenne buttake galchalluwwinaa'n mittikinna konne beekuma ege'nebaa; egene'eele silaati ulfinka Gootta fannisamabaan. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />Kaddo malee'e</para>
  <para style="q2" vid="1CO 2:9">«Ille affebaaxxa</para>
  <para style="q2" vid="1CO 2:9">mansha laqqebaaxxa</para>
  <para style="q2" vid="1CO 2:9">manjiinxi qalbe'ninna hedendebaaxxa yaane</para>
  <para style="q2" vid="1CO 2:9">Magen iso'o eeyakeri'a qixxeese'een» hiyyendee borresendeemmashaten.<verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />Yaane kinni Magen Hafuura ifik darre'n tenne no'o'n ege'nishsheen.</para>
  <para style="p" vid="1CO 2:10">Kunni Hafuur Mageniinxi dhimo yaane midde gattebaang duuchchiinxe qorqoraan. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />Isi giddo hedheek irri gadhi darre mitte manji giddo hedheeka yaada ege'naak manji aatte? Iittanni Mageniinke Hafuur gadhi darre Mageniinka yaada ege'naak ayyinna hedhebaan.<verse eid="1CO 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 2:12" />No'o Mageiinke Hafuura malee tenne buttaka hafuura adhinebe'no; tinninna Magen no'o'a tolanga uwweemmaxxa yaanuwwa egenanoshshaten. <verse eid="1CO 2:12" /><verse number="13" style="v" sid="1CO 2:13" />Tennexxe no'o haasonaanexxi yaane tinni manjiinke beekuminaa'n baranniteenexxe kadebaak Woyyichchi Hafuuranaa'n barnteneke hiyyichchinni haasonanon; hafuurinxa dhugaanna leelinshnok hafuuriinxe ifisaniten. <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />Mageniinka Hafuura afebaak manji Mageniinke Hafuurixxa yaane adhdha dande'abaa; iitta hexxexxi yaane ookkone manji'a gowwumaten; tinninna kaddachchi hafuuriinxi yaanuwwa qo'nisendaak Woyyichchi Hafuur afeeke manna calla kaddeemmaxxe isi tenne yaanuwwa qalbeefata dande'a gophaammaxxeten. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />Mageniinka Hafuura afeek manji duuchchiinxa yaane qorqoraan; isoo kinni ayyinna qorqorabaan.<verse eid="1CO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CO 2:16" />«Goottiinxa qalbe ayyete eg'naa dande'aa?</para>
  <para style="q2" vid="1CO 2:16">isi'anna gorsa uwwa dandea'aak aatte?» hiyyende borresendeshaten.</para>
  <para style="m" vid="1CO 2:16">No'ok kinni Kiristoosixxe qalbe anfeenneni.<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s1">Mageniinxe Tuuta Giddo Kadeexxa Weli Giba</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />Anke dayyuwwa Kiristoosi darre'n reefi annoole kaddineemmaxxe maalnke mannishsha malee'e hafuurnke mannishsha ha'noo'ni haaso'a dandebo'non. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />Ookkone wodda jabata gophphineemmaxxe'e adote malee'e jabaxxa ita ha'no'o itisebo'non; ta'atenna kaddoole ha'no eettene jabaxxa ita itiyyo danedetinebaan.<verse eid="1CO 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 3:3" />Ta'anna ha'no'o ookkne maalnke mannan; ha'noxxe oddo'n gaabenna weli gonphe hexxeemmaxxe'e ha'no ta'anna ookkone maalnke mannabaata? Assitina'neexxi yaane duuchchi tenne buttaki manni assaammanxebaata? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />Tinninna mitti, «Ani Phawuloosike» weli kinni «An Aphiloosike» hiyyaa wodda ha'no maalnke manna hiyyondebaata? <verse eid="1CO 3:4" /><verse number="5" style="v" sid="1CO 3:5" />Isinni Aphiloosi maachcho? Phawuloosinna maachcho? Insa'neqqa ha'no amandinaasha assineeke erganjuwwan; mitti mitti insa'nek ergatema'neek Gootti insa'ene'a uwweexxe ifi fixxe hujeniten. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />Ani kaasenne, Aphiloosi wode'e ha'wise; Mageni kinni nosse. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />Tennexxe nosseemmaki Mageno malee'e kaasek yookaan wode'e ha'wiseek mitteelchonabaan. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />Kaasakinna wode'e ha'wisaak qixxenden; mitti miitng hujemaxxe hujexxe qixxe'n hira alfaan.<verse eid="1CO 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 3:9" />No'o Magenoke mitteba huja'neke erganjuwwan; ha'no Mageniinke fichchanna Mageniinke minen.<verse eid="1CO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 3:10" />Magen ani'a uwweeke badhaadhinni miniinke ijaarsixxa oge afeeke mitte beeki manjishsha umennexxi booso ofolishenne; wele manji eettene booso hana ijaaraan. Yaane kinni mitti mitting hitta ijaarxa xexxe'achcho hasisaan. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />Eettene woldo umende ofo'lishendexxa booso malee ayyinna wele booso ume ofo'lisha dande'aak hedhebaan; tinni boosonna Yessuus Kiristoositen. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />Tenne booso hana ayyinna worqeti yookaan birreti sibljinni yookaan fixxe kinonni yookaan haqqeti, buuyoti yookaan huurk ijaark hedheexxe kaddole, <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />mitti mittinge manjixxi huje hitta ifisendaaxxe murtetixxi barra daggaan eettene barra mitti mittinge manjixxi huje hittate kaddeexxa giirate'ni e'yite higa uudendaan. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />Mitti manji ijaaremmaxxi huje baxxebaang hexxemashanni gattoole badhaasa alfaan. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />Huje isixxi giirate'n gubate baxxak kinni badhasa alfaba'a; kaddo malee isi umo ifikenni giira giddo e'yeexxi gubatebaang gatamake manjishsha anjiremaan.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />Ha'no umo ha'noongeninna Mageniink galma kaddineexxanna Mageniink Hafuur ha'no giddo hedhaaxxa e'gena gophphinetaa? <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />Ayyiinna Mageniinka Galma diigoole Magenkinna iso'o diigan; Mageniink Galmi woyyichchaken; iikki galminna ha'nooten.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />Ayyinna ifi soboqqe'e; ha'no giddii'n ayyinna tenne buttake beekumixxe mikenni beekuma afe'esha ifi hedhoole beekake kaddo'a ifi gowwak assee uuda hassissaan. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />Tenne buttak beekumi Mageni edo gowwumate kadeemmaxxe'e hiyyende borreesendee qic, «Magen beekole insa'nexxe shokkoninni abiddan» hiyyende'een. <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />Iittanni wele booncho'ni kinni, «Gootti beekoetik yaada wayi fulabaake kadeexxa ege'naan» hiyyendee borresende'een.<verse eid="1CO 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 3:21" />Tennexxe duuchchiinxi yaane ha'nooxxe kaddeemmaxxee'e ayyinna manjoke'n ifi saadoqqe'e. <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />Phawuloosite kadi Aphiloosi yookaan Keefanna yookaan butta tennete kaddo hedho yookaan reyo ta'a hexxeexxe yaanuwwa kaddo'o hegeri daggaaxxi duuchchi ha'nooxxen. <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />Ha'noonna Kiristoosiken; Kiristoosinna Mageniinken.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s1">Kiristoosixxa Ergameeyye</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />Yoona manji duuchchi no'oo Kiristoosike erganjuwwanna buqendeexxe Mageniinxe yaanexxi maganne no'o'ni uwwendeeke kandeennexxa ege'naa hassissaan. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />Iikki maganne insa'ne'n itti uwwendeke manninna xuurakeesak kande afema hasissa. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />Ha'noonna kaddi murtetixxe songo'n ayyinna ane'n muroole ani'a maachchonabaan; ani midde ifi'n mura dande'abo'non. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />Sammo anxi giddo ane'e qoxxo assitaaxxi mitte yaane hexxeba; iitta hiyyo kinni ane'e balleesabeloke manjo assitabaa. Ane'n muraak kinni Goottaken. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />Tennexxe itti murendexxi yanna geltebaank ayye'ninna murtinoqqe'e; Gootti dagaaxxe heqqe; isi dukkana giddo buqendeexxa ifiake'n iyyedagaan; manjiinxe qalbe giddo hedheeka yaadanna ifise leelishaan. Ookkone wodda mitti mitting ifi ifi'a galata Goottakenaa'n alfaan.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />Anke dayyuwwa ha'nooxxe la'o'aa hiyyenexxi tenne yaane Anenna Aphiloosi Fakkeena asse haaso'aane; tinninna «Borreesendeexxenaa'n saxxoxxe» hiyya maachcho kadeexxa no'onaa'n baratino'a hasenexxeten; tennexxe mitte manjo'n welkenaa'n caalchisineexxi isinni ifi saadinoqqe. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />Ati welekenaa'n caaldattoshsha asseek isi aate? Welekenaa'ni adhhditebexxoxxi ifixxe hitaboxxoxxi yaane haba hexxe? Ati duuchchiinxa yaane adhdhiteetek welkenaa'n kaddoole adhdhebaaake manjishsha mayee'e ifi saadaate?<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />Ta'aa ha'no'aa hasisaaxxa yaane duuchcha alfitine'een; ha'no dureeyyetenna kaddine'een; no'obelonna mootine'een! Silaati dhugaati mootine'eechonna kadde'eele no'oonna ha'no'n moonannani.<verse eid="1CO 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 4:9" />Tinni kaddeechchi; Magen no'oo isixxa ergameeyye reyo itti murendeemmake mannishsha manji duuchchinaa'n udunse udumike dalla'n no'oo uggeechcho ane'ni labbaa; no'onna butta duchchi'a, erganateenna manjiinxe daa'we'a dagoo'miyyo kandeenen. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />No'o Kiristoosixxe hine'e gowwoolten; ha'no kinni Kiristoosinn beekolete kaddine'een; no'o ifi gonpheeneke ha'no kinni worbaken, ha'no ulfaatineke; no'o kinni salphaante'eneken. <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />Telchi qico'n no'o solo'winaanen, dheebo'winaanen, daaraane, ganemmaanen, umo ugginaanoba gonphee doonsakiyya hinaanen. <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />Anga no'oxxenni huccine kurbi hinaanen; no'oo badinnaa wodda eebisaanen; no'o shorrinshaa wodda ossinaane.<verse eid="1CO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 4:13" />No'oo summa balleesinaa wodda insa'ne'ni eeloke afo'o hiisinaanen; ta'i qico'ni tenne buttake koranna fiyeme hunemamacho kande'eenen.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />Ani tenne ha'no'a borreesenek anxe eeyendeexxe oosesha uude ha'no gorsate malee shookishshonaatebaan. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />Fedhee qiconna Kiristoosinni heddo akeekisano affinoolenna heddo annuwwa affinebaan; ani kinn Kirisitoosi Yessuusixxe wemgeelenn hanoo i'leenen.<verse eid="1CO 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 4:16" />Tennexxe anka fakkeenna hordofino'a ha'no kadhataane.<verse eid="1CO 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 4:17" />Yoonna Goottake'n eeyemeekanna addateemeka anka belto Ximotoosi ha'nooba ergenelchi tennexxeeten. Isi booncho booncho'n hexxeexxe Mageniinka tuuta duuchcha'n ani barsiisanexxe barachchonni weli aagaaxxa, Yessuus Kiristoosi'n alfenexxe hedhoka galduma ha'noo'n qalli asaan.<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />Yaane kinni ha'oo giddii'ni mitti mitti Ani dagaabo'noolcho labbee'naa ifi duke'een. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />Kaddo malee ani Goottiinxe fedhi kaddoole rakke ha'nooba daganon; ookkonneechchi uduma Ani ookkene ifi dukekee mannike haaso'a calla kaddebaang hunna insa'nexxanna ege'nonna'a hasaaenen. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />Mageniinxi moottumma haaso'iinxe yaane kaddabaabg Mageniinxe hunnanni. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />Isi ha'no hassina'neelchi maachchoo? Kuta adhdhee dagano moo yookaan jaalalatinna shaquntetike irrinni dagannoo hassina'nee?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s1">Shookishaxxa Cubbo Betekrstaanete'n</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />Ha'nooxxe oddo'n yabaabulletik battoomi hexxeexxa dhugaandinni haaso'enda'neen; iitta hexxeexxi battitte yaane amana'nebaake manni giddo midde kadde egendeexxebaan. Tinninna ifixxa langa ama aadheek manji hedheen. <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />Ha'no ifi dukkine'een; tenne irra ha'no yaadiyyo hasisammabataa? Tenne iitta hexxeexxa yaane asseek manji ha'no giddii'n fuggusemowwaal. <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />Ani fedhee qiconna ha'noon welti hedha gophonolenna midde irrik ha'noon welti hedhenen. Tennexxe ha'nooni welti hedhenelchishsha tenne asseke manjo'n ta'a tenne mureenne. <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />Ha'no bukki hitinaa wodda aninna irrik ha'nooxxe oddo'ni hedhaannaxxee Gootta no'oke Yessuus Kirstoosike suminninna ha'nooxxe oddo'n hexxeexxe Gootta no'oke Yessuus Kirstoosixxe hunnanni, <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />Cubbo callinni wo'meeki konne manjik maali ba'ee'naa lubbo isixxi Gootta Yessuusixxe barra'ni anjirendaashsha iitta hedheek manji dursakee sa'isseme uwwemowwaal.<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />Ha'nooxxi ifi saada eloxebaan; heenooxxi lebele liixxe duuchcha ke'istaaxxa egendineexxebataa? <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />Yoonna ta'a lebele belo hexxinemmashsha duuchcha haaroxxe lixe kaddino'a dullate lebele fugusse. Sa'atike ayyaank beltanji Kiristoosi no'aa tolcheemmedheen. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />Tennexxe konne ayaanna xaqaronna fuggo wo'miteexxee dullatte lebele kaddeebaak lebele affeebaaxxe kebboonni qajeelumatinna dhugaati ulfeesino.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />Konne edo ha'no'a borresenexxe anxe borro'n yabaabuluwwakenaa'n gargar higginaasha borreesseenan. <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />Tennenna hiyyanno wodda madada tenne buttake yabaabuluwwanaa'n, yookaan haafamuwwakenaa'n, bokkaammetenaa'n, fakkuwwa magenoonfatamakeeranaa'n, gagar higge hiyyonaatebaan; iittate kaddeele silaat tenne buttanaa'n harnga ha'no fula hasisaman. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />Yaane kinni ani ha'no'aa borreessenk amaagne dayyuwwa kadeexxi yaababulake'n, yookaan haafamaken yookaan fakkuwwa magenoonfateke, yookaan yowwaken, yookaan machcho'aak yookaan bokkaammeti welti gudditinabaashaten. Iitta hedheeke manjinni welti ita midde welt ittinoqe. <verse eid="1CO 5:11" /><verse number="12" style="v" sid="1CO 5:12" />Mageniinxe tuuta gadho hedheeke manna'ni maachcho anee'e e'yishshaa? Mageniixxe tuuta giddo hedheeke manna'ni ha'no murte uutinabaa?<verse eid="1CO 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 5:13" />Mageniinxe tuuta gadhi darre hedheeke'ni muraak kinni Magenoken. «Yoona fuggichcha manjo oddo ha'nooxxenaa'ni fuggusse.»<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s1">Weli Ku'la Ammaagneti Giddo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />Mitti manji ha'no giddii'n mittik weli gonphe afe'oole, eettene yaane ammaagne dayyuwwa'n shiqishshamaaxa bakka hitta amanebaake manni edo murtete shiqaa? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />Qulliyye buttate'n murtaaxxa egendineen hexxinbaata? Butta duuchcha'ni murtina'neelchinni tenne heenooxxe yaane'a muratee geya gophinaata? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />Tenne buttatixxe yaanuwwa'n waalin erganate'n midde murrannoxxa egendineen hexxinebataa? <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />Yoonna iitta hexxeexxi yaane ha'noo'n kaddaa wodda Mageniinxe tuuta'n tuffatemeeke amanebaake manni edo murte uwwendo'a hitta shiqinnaa?<verse eid="1CO 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 6:5" />Tenne hiyyaanek ha'no shookino'a hiyyeeten. Eega ha'no giddo ammaagne dayyuwwa murte uwwa dande'aak mitti beek manji hedha gophetaa? <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />Yaane kinni ammaagne dayyi ammaagne dayyo ifika ku'lo'a murteti mine mara'neen; kuninna ammaagnete kadabaake manna'n! <verse eid="1CO 6:6" /><verse number="7" style="v" sid="1CO 6:7" />Yoonna ha'nooxxe oddo'ni weli ku'la hedhandi ha'nooxxe iba leelishshaan. Tenne irra ha'noo miidhendineele maye hedhee? Sobendineele maye hedhee? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />Ha'no umi ha'nooginninni balleesitina'neen, sobbina'neen; iikkinna aammaagne dayyuwwa ha'nooka. <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />Fuggaaleeyye Mageniinxa moottumma dhaaldabaaxxa egendineen hexxinebataa? Tenne yaanuwwa'n mee dedhake'n ibbe; qii'misuwwi, dharcha magenuwwa magenoonfatamakir, yabaabulluwwi, yookaan labbak labbakenni yabaabulaakir, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />yookaan moodhalsheti, yookaan maalaqake haafemakir, machcho'aluwwi, yookaan summa manjiinka balleesakir, yookaan bokkaame Mageniinxa mootumma dhaaldabaan. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />Ha'no giddii'n mitti mitti iitta hexxineemman. Yaane kinni ta'a Gootta Yessuus Kiristoosike summininna no'oke Magnike Hafuurinn ha'no anshexxine'een, woyyichchake kaddine qulloondine'een.<verse eid="1CO 6:11" /></para>
  <para style="s1">Yabaabulletixxa Cubbo</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />«Duuchchiinxe yaane ani'a eetti uwwendeen;» Kaddo malee duuchchiinxi yaane ani'a la'o affeexxebaan; «Duuchchiinxe yaane'ni ani'a eetti uwwende'een;» kaddo malee'e heene yaanne'anna ani garbake kade hiremabo'non. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />«Ita godobakeeten godobi itateeten» Yaane kinni Magen lamiinga balleessa. Kaddo malee'e bisi no'ok Gootta Yessuusi'aa, Gootti Yessuusinna biso no'okeete kadeemmaxxe'e biso no'oka yabaabulltee'e hosisa hassissabaan. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />Magen Gootta Yessuusii'i reyotenaa'n ke'isseemmashsha, no'oonna iittanni hunna ifixxenni reyoenaa'ni ke'issaan.<verse eid="1CO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15" />Bisi ha'nook Kiristoosike bisike qoola kadeexxa egendinebataa? Eega, Kiristoosike bisika qoola aadhe eettene yabaabulto manjichchoke bisike qooluwwinni welti mitte kaddaashsha assanotaa? Haranga hassissabaan. <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />Yookaan yabaabulto manjichchonni welti diiphak manji isenni mitte biso kadeexxa egendineebataa? «Iikki lamiing mitte biso kandaan» hiyyende borresendeemmashshaten. <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />Yaane kinni Gootta Yessuusinni welti mittoommaak manji isinni welti Hafuurk mitte kadaan. <verse eid="1CO 6:17" /><verse number="18" style="v" sid="1CO 6:18" />Tennexxe Ha'no yabaabulletenaa'n baaje. Manji hujaaxxi cubbo duuchcha ifike bisi gadhi darre hujendaaxxen; yaane kinni yabaabulaak manji biso ifike'n hanaa cubbo hujaan. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />Ha'nook bisi ha'noo giddo hedha'neeke Woyyichchi Hafuurke Galma kadeexxa egendineebataa? Kunni Hafuurinna ha'no Magenokenaa'ni adhdhitineeken. Ha'noonna umi ha'nooginn ifikebaan. <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />Ha'no hirki hirendine'eeken. Tennexxe biso ha'nookenni Mageno ulfeesse.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s1">Aadhanna Heeruma Uudaxxenni</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />Borreesitine qortineemmaxxe yaanexxee'e, manji melaaltibaa gamata gopheele<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="ft" closed="false">Mitte mitte tika manji meyyaxxen diipha gophe'ya eloxxen hittaan. </char></note> eloxxen. <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />Yaane kinni yabaabulletenaa'n gatatee'e mitti mitting manji ifi ifinixxa are afowaal; mitte mittendi melaallenna ifi ifinga aro'o affowaal. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />Aro'i are ifixxee hasissaaxxa yaane duuchcha ise'a assiyyo hasissaan; iittanni aretinna aro'o ifikee hasissaaxxa yaane duuchcha isi'a assiyyo hasissaan.<verse eid="1CO 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 7:4" />Are ifike biso'ni baaloma afebaan, isike biso'n baaloma afe'eek iseke aro'on; iittanni aro'i biso ifike'n baaloma afebaan; isike biso'n baaloma affeexxi are isixxen. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />Sooddachchote'n ciccatee'e weli aagine yannaate'e kaddoole malee, weli'aan weli hoyyexxinoqqe'e. Ifi heqqedhaa gophati duriis ha'no hega uudabaashsha haaroba mitteba hedhdhe. <verse eid="1CO 7:5" /><verse number="6" style="v" sid="1CO 7:6" />Ani tennee hiyyaanki ajajiinshate kaddeebang gorsa uwwatishshaten.<verse eid="1CO 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 7:7" />Manji duuchchi anishsha hedheele eeyanan. Yaane kinni mitti mitting manji Magenokenaa'n adhdheexxa ifi ifinxe uwwa afe'een; mitti mitte uwwa afaa wodda, weli kinni wele uwwa afe'een. <verse eid="1CO 7:7" /><verse number="8" style="v" sid="1CO 7:8" />Aadhebaake labbali'aanna aro'o shi'witeemmaxxe melaallexxe hiyyaanexxi insa'ne anishsha he'neele eloxxeman. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />Yaane kinni dandeennee ifi heqqedhaa gonpha'noole halchati gubatati mannii'n aadhanna heeruma woyyan. <verse eid="1CO 7:9" /><verse number="10" style="v" sid="1CO 7:10" />Aadhe heerummeekeri'a uwwaanke kunni ajaji Goottiinke malee ankebaan. Are ifike aro'inaa'n gargar higgoqqe; <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />yaane kinni ise gargar higgoole heerendebaang hexxowwaal; kada gophphoole ifike aro'inni araarendowwaal. Iittanni aro'ikinna ifixxa are tikoqqe'e.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />Welekanna hiyyaanen; tenne hiyyaanek ante malee'e Goottakebaan. Amandebaaxxa are afeedheek ammaagne dayyi hedheelenna iitti are isinni welti hedhate'e hassa'noole, isee tikoqqe'e. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />Amanebaaka aro'o affe'eexxi manjichcho hexxeexxe kaddoolenna isi isenni welti hedho'a hasa'noole isoo tikkoqqe. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />Amanebaak aro'i ifixxe arenni woyyo'eedhe'en; amandeebaaxxi are amaneeke ifike aro'o'ni woyyoote'een. Iitta kada gophpheele oose ha'nooxxi battoolete silaa kaddamman; ta'a kinni insa'ne woyyooleten. <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />Yaane kinni amanabaak manjichchi yookaan manjichcho gargar higa haseexxe kaddoole gargar higowwaal. Iitte wodda aro'o kaddo are konne orinni usurremeeban; Magen no'o'o ye'eechchi nage'ik he'nonaaten. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />Tee manjichcho; atika aro'o anjirtattoxxe hexxeen maa egendeettetaa? Yookaan koo manjichcho atixxa are akimagaada anjirtatoxxi hexxuun maagendetee?<verse eid="1CO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />Mitti mitting Gootti isi'a muremaa qicinni, Magen iso'o ye'aa wodda hedhemaa qicinninni hedhowaal. Ani Mageniinxe tuuta duuchchi'a konne seera uwweenen. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />Huunni manji jila offo'leechchi udmuma ye'emeexxe kaddoole jila ofo'lebaa manjishsha kado'a hedoqqe. Ayyinna jila ofo'lebaang ye'emeexxe kaddoole jila ofo'loqqe. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />Jila ofo'la yookaan ofo'la gopha la'o affebaan. Hasendaaxxi yaane Mageniinka ajaja muuxaten. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />Mitti mittingi manji ye'emee wodda hedhemaa qicinninni jabaate hedhowwaal.<verse eid="1CO 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 7:21" />Ati ye'endettaa wodda garbakemmaa? Kaddoottolenna mee yaadi; leexxa fulatixxa bado alfittatoo wodda kinni eettenne leexxa fula adhdhi. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />Tinninna kaddeechchi isi garbake kadeenni hedhe'e isi Goottiin darree'ni ye'emeek, Goottik leexxa fulee manjonn; iittanni isi ye'emaa wodda'ni leexxa hedheeke manjon Kiristoosike garban. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />Magen ha'noo'o hirk hidheen; tennexxe ha'noo manjiink garbuwwa kaddinoqqe'e. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />Anxe aammaagne dayyuwwaa, mitti mittink manji Magni iso'o ye'ee wodda hedhemaa qicinni Magenki welti hedhowwaal.<verse eid="1CO 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />Herundebaaxxe dubarte uudaaxxenni Goottake'naa'n adhdhenek ajaji hedhebaa; kaddo malee Mageniinxe marartenaa'n kexxeexxinni ani xuurameesi manjishsha, anka gorsa uwwaanen. <verse eid="1CO 7:25" /><verse number="26" style="v" sid="1CO 7:26" />Ta'a hexxeexxe rakkonaa'n kexxeexxa hexxinemaa qicinninni hedha ane'n eloxxe labbaan. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />Ati aaxxeeteke kaddootole tika hassoxxe'e; aaxxebexxoke kaddootolenna aadhdhatee haasoxxe'e. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />Iittanni ati aaxxo'otole cubbo hujete hiyyotebaan; dubarchotinna heerundoole cubbo hujjeen hiyyotebaan; kaddo malee aadhaakerninna herumakera'n tenne butta'n heddo rakko geltaan. Anxi halcha ha'no tenne rakkonaa'n gatino'aten. <verse eid="1CO 7:28" /><verse number="29" style="v" sid="1CO 7:29" />Anke aammaagne dayyuwwa ani hiyyaane qici tenneten, bar haru'me'een; yoona are afeekiir afebaakishsha kadeexxi hedhowwaal. <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />Oodhaakiir oodhabakeerishsha, gammadaakiirinna gammadabakeerishsha kadowwaal; miya hidhaakiirinna iikki hidhdhineemachchi ifike kadebaashsha assine uundowwaal. <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />Tenne buttaxxa yaanuwwa la'ofatakirna la'onfatabakeerishsha kadowwaal. Tinninna tenne buttaxxi jiro saxxaaxxe kaddemaxxeeten. <verse eid="1CO 7:31" /><verse number="32" style="v" sid="1CO 7:32" />Tennexxe ani ha'no wixxixxibelo hexxino'a eeya'ne. Aadhebaak manji Gootta gammachchiso'a Goottiinxe yaane hedaan. <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />Yaane kinni aadheek manji are ifixxa gammashiisatee tenne buttixxe yaane hedaan. <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />Konne qicinni yaadi isik lameba hige'een. Iittanni heerundebaaxxi manjo yookaan dubarichcho Goottiinxe yaane heddaan; yaadi isekinna maalikinni irriki Goottakee'e woyyoommaten. Yaane kinni heerundeexxi manjichcho aro'o ifika gammachchiiso'a tenne buttaxxe yaane heddaan. <verse eid="1CO 7:34" /><verse number="35" style="v" sid="1CO 7:35" />Ani tenne hiyyaanechchi ha'no'aa eldaaxxe hedeete malee'e ha'no rakkisonaatebaan; anki yaadi qalbe ha'nooxxi qoqqodeddebaang Goottake'n jabaatineexxi hasisaa qicinni hexxinaashshaten.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />Mitti manji kadhateexxa dubarichcho seerki abixxa gophoole, isenna woggati lummexxa'ni me'itoole, isinna isee'e aadho'a hedoole eeyyexxa assowwaal; cubbo afa gophpheemmaxxe'e weli aa'nowwaal. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />Yaane kinni tenne yaane'ni qalbe ifixxa ti'ni asse daaqa belo, umo ifika hirati duuddo dubarichcho aadha gophatee mudhdheek manji eloxxe assse'en. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />Tennexxe kadhateexxa dubarichcho aadhaak eloxxe asse, aadhebaakinna caalla eloxxe assaan. <verse eid="1CO 7:38" /><verse number="39" style="v" sid="1CO 7:39" />Mitte manjo aro'o isek lubbo hedhee qico'n adhdhanna heerumiinke seerinni isinn welt usurendeexxenni. Yaane kinn aro'i isiki reyeechchi uduma kinni ise eetteke'ni heeruma dandeetaan; iikki heerndaki manji kinni aamaagnete kada hasissaan. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />Anishate kaddoole iitti manjichcho heerundebaang iittanni hexxoole caala gammashshoti hexxaan. Mageniink Hafuur ane'ni hedheechcho labba'neen.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s1">Dharichchi magenuwwi'aa Tolchemeeka Maala Itatixxanna Ita Gophatixxa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />Fakkuwwatee'e tolchemeeke maalxa no'o duuchchiing ege'na anfeenexxa egeneennen, yaane kinni ege'na ifidukisaan; jaalala kinni ijaartaan. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />Ege'neenen hiyyeexxi hedaak manji isi ege'niyyo hasissama qico ege'nebaan. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />Mageno eeyak manji kinni Magenoke'n ege'nemeeke kadaan. <verse eid="1CO 8:3" /><verse number="4" style="v" sid="1CO 8:4" />Yoonna fakkuwwatee tolchemeeka maala itatixxe ani hiyyaane qici tenne butta'n fakkuwwa wayi fulabaachcho kaddeexxanna mitte Mageni gadhi darre wele magenuwwi hedhebaaxxa egeneennen.<verse eid="1CO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 8:5" />Haanonna heddo magenuwwinna heddi goottuwwi hedheei; iimate'ninna buttate'ni mageno hiyyemme ye'ema'nek magenuwwi hedhoolenna, <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />no'aa kinni duuchchiinxi yaane isi darree'niten kaddeek no'onna isike kande'enek mitte Mageno Anna anfeenen; iittanni duuchchiinxi yaane isi darre'n kaddeeka no'onna isi darre'ni he'nanoka mitte Gootta Yessuusi Kiristoosii'i anfeennen. <verse eid="1CO 8:6" /><verse number="7" style="v" sid="1CO 8:7" />Yaane kinni tenne yaane ege'neek duuchcha manjobaan. Mitti mitti manni ta'i qico'ni fakkuwwa magenoonfachcho barateemmaxxee'e fakkuwwate tolcheemmeeka maala itaa wodda fakkuwwatee'e tolcheemmeeshsha hedaan. Yaadi insa'nekinna goofake kadeemmaxxee'e battonaan. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />Yaane kinni ita no'oo Mageniibaa iyyedagabaan, ita gonphoonolenna no'onaa'ni xe'itaaxxi yaane hexxebaan, indonolenna le'phinanoxxi yaane hexxebaan.<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />Yaane kinni ha'nooxxe leexxa fulanaaa'ni kexxeexxa amanate'n jabaatebaake manni'a gufote kaddabaashsha heqedhdhe. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />Ati iitta hexxeexxa ege'naa affeenni hexxe'e, jabaatebaaxxa sammo afeeka manjo fakkuwwatik mene'ni hexxe ittaa'naa uudole fukkuwwatee'e tolchendeexxa ita itatee'e tinni isoo tirtirisa gophphaata? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />Tennexxe Kiristoosi isi'a reyeek kunni amanati jabaatebaak manji atixxe ege'naxxe buutonni ba'een hiyyoten.<verse eid="1CO 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 8:12" />Konne orinni aammaagne dayyuwwa ha'nookka balleesiyyotinna jabaatebaaxxa insa'nexxa sammo madeesati Kiristoosi balleesitinaan. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />Tennexxe ani itaanexxi yaane dayyo anka guggufachchiisa'nexxe kaddeechchinni dayyo anka guggufachchiisabo'noshsha harnga maala itabo'non.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s1">Ergameeyyetee'e Uwwendeexxa Deette</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />Ani leexxa fuleeneke manjobaataa? Ani ergemallongebataa? Ani Gootta no'oka Yessuusi uudebe'noketaa? Ha'noo Goottik anxe elonni afendineexxe gummabaata? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />Welekee ergemmalloke kada gophoonolenna midde ha'no'aa dhugaandinni ani ergemmalloke kadeenaxxee Goottiki anxe ergemmallumaatik maxxansi ha'nnooten. <verse eid="1CO 9:2" /><verse number="3" style="v" sid="1CO 9:3" />Anee qo'nisa'neekee uwwaaneke hiissichchi koneten. <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />No'o isi itatixxanna ha'watixxa deette hanfebeno hiyyateeta? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />Wele ergameeyyesha Goottinke dayyuwwishshanna Keefashsha no'oxxa aammaagne are adhine marematixxa deette anfebe'no hiyyateeta? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />Yookaan galduma no'oke huccinabe'noshsha deette anfebe'nok ergameyetenaa'n Bernabaasinna ane callata?<verse eid="1CO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 9:7" />Maalaqa ifikenni loliinke manjo kade ergatemaak aatte? Yookaan kaaseexxi gumma itabaak aatte? Yookaan hore alala'n ado ha'wabaak aatteta? <verse eid="1CO 9:7" /><verse number="8" style="v" sid="1CO 9:8" />Tenne haaso'enek manjiinke yaadi callinteeta? Muusek seerinna hiyya'neexxi tennedebaata? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />«Uxxitaaxxa qotiyyo afo'o usurtoxxe'e» hiyyendeexxi Muuseke seera'n borreesende'een. Mageni tennee hiyye'eechchita'a qotiyyotee'e heddiyotiteeta? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />Mageni tennee hiyyeechchi no'andebaata? Wiilsak manijji addet wiilsashsha, uxxaaki manninna addet uxxashshanna konne orinn duuchching ifi fika qoobo alfatee addet huja hassissaaxxa leellishshati no'oxxe borresende'een. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />No'o ha'no giddo hafuuriinxa yaane facaansennexxe kaddo'oole, maalakee kaddaaxxa yaane haa'minenele lumoxxe yaane kaddeni hiyyoteeta? <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />Weli tenne yaane ha'noonaa'n alfatixxa deette afeechchinni no'o tennenaa'n saaxxa alfa hassissamabaata? No'o kinni tenne uwwendeexxa deette la'onfanetebe'no; tenne irra Kiristoosixxi wengeele guggufatabaashsha hediyyot duuchchiinxa yaanenn ossinene malee'e.<verse eid="1CO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 9:13" />Woyyichcha Galmi giddoo ergatemaakiir ita ookkone Woyyichch Galminaa'n alfaaxxa, iittanni tolchimalchoke'n tolcha shiqishaakiirinna ookko tolchemeechchirinaa'n qoodemaaxxa egendinebaata? <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />Iittanni wengeele lallabaakiir galduma ifikee hasisaachchuwwa wengeeletenaa'n alfinaashsha Gootti ajaje'een.<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />Ani kinn tenne uwwendeexxe deettuwwa'naan mittetanna midde la'onfatebe'no; ta'anna tenne ha'no'a borreesanek tenneersha hexxeexxi yaanuwwa ani'a assitinaan hiyyatixxe addentebaan; ayyinna ifi saada anxa woyifuldababaaxxe asseexxi mannii'n ani'a reyo woyyan. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />Wengeele lallabanoshsha Magen anee ajajeexxe kaddemmaxxee, isee lallaba anxe'n ifi saadabe'no; wengeele lallaba gophonole ani'a aane'e! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />Tenne wengeel fedhii anxenni lallabenole hirake afe'ennen; fedhiite kada gophphoole kinni assa'ennexxi yaane ane'n uwwendeexxa maganne muuxate calla kaddaan. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />Yoona anxe hujeke hirita maachcho? Anik hiriqqaa wengeele lallabanno wodda ani'a uwwendeexxa deette la'oonfatebe'nok wengeele tola lallabonoleten.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />Ani leexxa manjonni ayyike garbannabaan; yaane kinni heddo manna Kirstoosibaa iyyedagatee ani manji duuchchi'a ifi garbake asse'eennen. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />Ayihudoota hiissonna'a Ayidichchoke kadenne; ani seer hunda hedhebe'nog seer hunda hedheekaara hiissonna'a ookkone seer hunda hedheekishaara kadenne. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />Ani umo anigeninni Magenke seer hunda hedhebe'nokenna, Kiristoosike seeri'a hiremanoke kadoonnolenna seera afebaakaara hiissonna'a seera afebaake manjishsha kadenne. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />Amanati ifi gopheekaara hiissonna'a ifi gopheekeerishsha kadenne; dandeesisaake or duuchchinni mitte mitte anjironna'a duuchchingen welti duuchchiinxa yaane kadenne. <verse eid="1CO 9:22" /><verse number="23" style="v" sid="1CO 9:23" />Tenne duuchcha assennek wengeeltixxa eebba qoodematee wengeeltixxe hiyyeeten.<verse eid="1CO 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24" />Gonigiichchiinxe hokkokke'n gongaak heddo manna kadeexxanna badhaasa adhdhaak kinni mitte calla kadeexxa egendineenni hexxinebaata? Tennexxe ha'noonna ookkone badhaasa adhdhitino'a gonge. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />Gonigichchik hokkokkisaaki duuchchi ifi jaba qico leenjisaan; insa'ne iitta elooneechchi sa'aakanna ba'aaka kallacha alfino'aaten; no'o eloona'enneechch kinni baxxabaaxxanna duuchchi woddixxa hedho alfateeten. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />Ani kinni mare geyaaba ege'nebaak gongamake manjishsha tola gongabe'non; iittanni diidallo tuntummoti ganamake manjishsha tola wolaancho abixxabe'no. <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />Yaane kinni welekee lallabenechchi uduma ani umo ankenni hunemeenneke kadabe'noshsha manjunte anixxa ifi xexxe'ata'n ani'a hirendaashsha assannon.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s1">Isira'eeli'n Gelteexxi No'o'n Geltabaashsha Uwwendeexxa Xexxe'achchiisa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />Anke aammaagne dawwa annuwwi no'ok duuchchi duummanchii hunda he'nemaxxanna abbaayyaa giddo foonfeexxa egendino'a eeyyaannen. <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />Insa'ne duuchching Muusenni mitteke kadatee duummanchake'ninna abbaayyate'n xammaqqemme. <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />Insannee duuchchiing mitte hafuuriinxe itanaa'n inde. <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />Insa'ne duuchchiingi mitte hafuuriinke ha'wonaa'n ha'wine; ha'wineekinna insa'nee hordoffa'ammaxxe hafuuriinxe rassanaa'niten; itti raasanna Kiristoositemman. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />Kaddo malee Mageni bira sa'eeke insa'neke manna'n gamada gophemmaxxee rensh insa'neke qiilla gammoojje'n ibeeba gate.<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />Insa'ne fuggoxxa yaane halchineemmashsha no'onna halchinabe'noshsha tinni yaane no'o'aa xexxe'achchisatike fakkeennake kadde'een. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />«Ardi ite ha'wo'aa ofo'le; siribbo'aanna ke'e» hiyyeende borreessendeemmashsha insa'nenaa'n mitti mitti manni asseemmashsha fakkuwwa magenoofatinoqqe'e. <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />Inissa'nee giddii'n mitti mittii yabaabulatixxa cubbo hujeexxi barra mitte'n lame tommenna sase kumi manni reyemashsha no'onna yabaabbulonnoqqe'e. <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />Insa'ne giddii'ni mitti mitti Gootta hega uude'e bofake'n iddemeexxi mudemmashsha, no'onna Gootta<note caller="+" style="f"><char style="fr" closed="false">10:9 </char><char style="fqa" closed="false">Gootta</char><char style="ft" closed="false">Mitti mitti kirkik maxaafuwwi Kirstoosi hiyyaan.</char></note> hega uundonnoqqe'e! <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />Insa'ne giddii'n mitti mitti maamuqee'naa'a iimak erganjinni insa'ne biremmashsha ha'noonna maamuqinoqqe'e. <verse eid="1CO 10:10" /><verse number="11" style="v" sid="1CO 10:11" />Tinni duuchcha fakkeenake kaddo'a insa'ne'n gelte; udumike barro'n he'naaneka no'oo xexxe'achchisateenna borreesende. <verse eid="1CO 10:11" /><verse number="12" style="v" sid="1CO 10:12" />Tennexxee uureeke labaak manji ibabaashsha xexxe'atowwaal. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />Manjoke'n geltamanxe hega uushsho malee'e wele hega uushsho ha'noo'ni gelteba'a. Xuurameesi Magen dandeetinabaa iimi darre hexxeexxi hega uushshoo ha'noo'n gelto'a waalabaan. Hega uudendinnaa woddanna eetten hega uushsho'n ossitinaasha fuldinaaka ora ha'noo'a qophpheessaan.<verse eid="1CO 10:13" /></para>
  <para style="s1">Magenooffachchotixxe Fakkuwwanni Mittoomma Gopha</para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />Tennexxe anke jaaluwwa fakkuwwa magenooffattatenaa'n baajje. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />Ani tennee ha'no'n hiyyenechchi qalbeefatinaake manna kaddineemmaxxeeten; ani haaso'aneka haaso'ixxee umo ha'noonokenni ha'nonni murre! <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />No'o Mageno galateefante qoodemaannexxi eebatixxi buuda Kiristoosixxe mundenni welti mittumma affeenxebaata? Kukultinaanek budeen Kiristoosike maalinni welt mittumma afeengebaata? <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />Iikki budeen mitteke kaddemmaxxee no'oonna konne mitte budeeninaa'n qoodemaaneke kandennaxxee heddoke kandeen he'ne'e no'o mitte bison.<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />Isira'eelik ardi asseeexxa ammee hedde! Ookkonee shiqaamaka tolcha itaamak manni ookkone tolchimalchik welti mittumma afemangebaata? <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />Iitta hiyyanno wodda fakkuwwatee tolchemeechchonna kaddi yookaan umo isikenni iitti fakke la'o afeechcho hiyyeenne hiyyateeta? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />Waawwo'o! Ayihudake kadebaak manni tolchaamak Mageno kadebaag fuggichchi hafuuruwwi'aten; ha'no fuggichchi hafuuruwwinni welt mittondino'a ani eeyyabe'no. <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />Goottiinxe buudanaa'n ha'witina'n fuggichchi hafuurixxe budanaa'ninna ha'watee'e dandeetinabaan. Goottiinxe qorenaa'ninna fuggichchuwwa hafuurixxe qorenaa'n ita dandetinabaan. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />Tenne assat Gootti hinaafaashsha assinanota? No'o jabeenik isoo sa'na'nota?<verse eid="1CO 10:22" /></para>
  <para style="s1">Ammaagnetixxa Leexxumma</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />«Duuchchiinxa yaane assa dande'annon» yaane kinni «duuchchiinxi yaane la'o afeba'a» duuchchiinxi yaane assatixxa deette afe'eennen kaddo malee'e duuchchiinxi yaane gargaartaaxxeba'a. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />Mitti mitting manji la'o wele manjixxanna hedo malee'e ifike umixxa la'o calla halsoqqe'e!<verse eid="1CO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25" />Sammo ha'nooxxe'n daggaaxxa i'nachcho waldineexxi dikkote'n gurguremaaka maala itte! <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />Tinninna kaddaachchi buttatinna ise giddo hedheechchi duuchchi Goottiinke kademaxxeten.<verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />Amaneebaak manji ha'noo'o itatre ye'e'naa'a marti'noole ha'nooxxe sammo'n daggaaxxa i'nachcho duuchcha waldineexxi ha'no'a shiqeechcho duuchcha itte. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />Mitti manji kinni «Maal kunni magenooffachchotixxe fakkuwwa'a tolchemeeken» hiyye ha'no'n kuleexxe kaddoole konee ha'no'n kulemake manjixxeenna sammoxxee ookkone maala ittinoqqe'e. <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />Sammotte hiyya anxi ookkone manjixxe sammo hiyyatete malee'e ha'noxxe sammo hiyyatebaan; wele manjixxe sammonni leexxumma anxi murendaachchi maayeette? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />Ani Mageno galateefatta'ni itoonole eettene Mageno galateefatennexxe yaane'a mayeeta ane'n murenda?<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />Yoona ittinaa woddanna kaddo'o ha'witina wodda yookaan heene yaanenna assitinaa wodaa duuchchiinxa Magenike ulfinni'a asse. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />Ayihudakeenna kado'o Girkeeke manni'a yookaan Mageniinxe tuuta'a gufote kaddinoqqe'e. <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />Duuchchiing anjiremo'a weliinxa la'o malee ifixxa la'o halsa waalenexxi assanoxxe duuchchanni manjo duuchcha gammachchiisatee hasannashsha ha'nonna iittanni asse.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />Ani Kiristoosika fakkeenna hordofaaneshsha ha'noonna anka fakkeenna hordoffe.<verse eid="1CO 11:1" /></para>
  <para style="s1">Magenooffachchotika Seera</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />Duuchchi wodda yaane duuchchinn anee qalli hitina'neexxeenna ha'noo'a sa'isse uwwenexxa barrachcho jabeesitine abixxitineexxe'e ha'no galateefataannen.<verse eid="1CO 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 11:3" />Yaane kinni labbake duuchchik umi Kiristoosite, meyyaxxik uminna labbake; Kiristoosik uminna Magenoke kadeexxa egendino'a eeyyaannen. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />Umo haguuqeexxi soodataak yookaan raaga haaso'aak huuni labbakinna umo ifike kadeeka Kiristoosii'i salphisaan. <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />Iittanni haguuqiatebaang soodattaaxxi yookaan raaga haasotaaxxi meyyaxxi ifike umo kadeeka labbaka salphissaan; haguuqitaaxxi melaalle umo haaxiteeshsha uudendaan. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />Meyyaxxi ifika umo haguuqa gophpha'noole ifike umika ordichcho woxxexxowaal; yaane kinni ifike umika ordichcho haaxxa yookaan woxxecca isee salphisa'nexxe kaddoole umo haguuqitowwaal.<verse eid="1CO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 11:7" />Labbak Mageniinxe fakkeenna ulfinna kadeemmaxxee'e umo haguuqa hasissabaan; meyyaxxi kinni labbakike ulfinnan. <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />Meyyaaxxi labbakenaa'n afendee malee'e labbak meyyaxxenaa'n afemebaan. <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />Iittaanni meyyaxxi labbakee dadendee malee'e labbak meyyaxxee'e dademebaan. <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />Tennexxeenna ergannatixxee buutoxxee meyyaxxi baaloomi hunda hexxeexxa leelishaaka beesisa umo haguuqitowwaal. <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />Yaane kinni Goottik anfenexxe hedho'n meyyaxxi labbake belo labbakinna meyyaxxi belo hedhaba'a. <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />Tinninna kaddeechchi meyyaxxi labbakenaa'ni afendeemmashshanni iittanni labbakinna ilemeek melaalletinaa'nite kaddeemmaxxeten; yaane kinni duuchchiinxi yaane afendeek Magenokenaa'nte. <verse eid="1CO 11:12" /><verse number="13" style="v" sid="1CO 11:13" />Amme mee ha'nonni murre, meyyaxxi umo haguuqitebaak Magenibaa soodachcho isee hassissaataa? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />Labbak ifike umika ordichcho qeerlseexxe kaddoole shookishshaaxxe yaane kaddeexxa umo ifingeninni dada ha'no'n ege'nisha'nebaata? <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />Meyyaxxee, kinni isek umik ordichchi ise'a uwweemeechchi ifi buqqexxo'aate kaddeemmaxxee ifika umika ordichcho qeerlsiteexxe kaddoole ise'a ulfinnake. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />Tenne yaane'n moroma hassa'neek manji hedheexxe kaddoole, no'ote kadi yookaan Mageniinxi tuuta tennenaa'n gargar hexxeexxa aada anfebe'no.<verse eid="1CO 11:16" /></para>
  <para style="s1">Goottiinka Hirbaata</para>
  <para style="r">(<ref loc="MAT 26:26-29">Mat. 26:26-29</ref>; <ref loc="MRK 14:22-25">Mar. 14:22-25</ref>; <ref loc="LUK 22:14-20">Luq. 22:14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />Yaane kinni bukki hitinaa wodda miitaaxxeete malee'e eloxxeete kada gophpheemmaxxee ha'no'n konne ajaja uwwanno wodda ha'no galateefata'neetebaan. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />Duuchchiinxe edi darre, Mageniinxe tuutanni bukki htinaa wodda, oddo ha'nooxxe'n gargar higa hexxeexxa laqqeennen; tinni kada dandeettaaxxanna wele orinni aninna amananno. <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />Ha'noonaa'n dhugaate'n hedheekiir ayyeera kadeexxa gargar higati ege'nemo'a oddo ha'nooxxe'n gargar higa hedha hassissaaxxe. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />Bukki hitinaa wodda ittina'neek Goottiinke hirbaataba'a. <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />Ittinaa wodda, mitti mitte heqqebaang hirbaata ookkone itaammaxxee mitti solo'wa'naa'a wel machcho'a. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />Isi ha'no ittinaakanna ha'witinaak mine affineebaata? Yookaan isi ha'no Mageniinxa tuuta tuffatati mittechchonna afebaakaara shookishinaata? Yoona ani ha'noo maa hiyyannoo? Tenne yaanene'n ha'noo'o galateefatannotaa? Haranga ha'noo'o galateefatabe'no.<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />Gootta Yessuusinaa'n adhennexxinna ha'no'n sa'isse uwweennexxi barachcho konneechinni butti'a hexxeexxeen: Gootti Yessuusi sa'isseme uwwemeexxa hashsha budeenna aadhdhe'e, <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />Mageno galateefatteechchi uduma kukuteexxi «Kunni ha'no'a kadaake anke maalan. Tennee anxe kassii'a assedhdhe!» <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />Iittanni hirbaati uduma buuda aadheexxi, «Tinni buuda munde anxen kadda'neexxe haaroxe kakon. Isenaa'n ha'witinaa wodda duuchcha anxe kassi assedhdhe!» hiyye. <verse eid="1CO 11:25" /><verse number="26" style="v" sid="1CO 11:26" />Konee budeena ittinna woddanna tennee buudana'n ha'witinaa wodda duuchcha Yessuusi dagaa qico'n reyo isixxa lallabinaan.<verse eid="1CO 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27" />Tennenaa'n kexxeexxa fedheek manji kadabaake jeeji giddo konee budeena itoolenna yookaan Goottiinxe buudanaa'n ha'woole, Goottiinka maalanna munde shollishat balleesanjoke kadaan. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />Manji duuchchi konee budeena itebaa edi darrenna tenne buuddanaa'n ha'webaa edi darre ifi qorqora hassissaan. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />Tinninna kaddaachchi ayyinna Goottiink maal maachcho kaddeexxa gargar hiisse ege'nebaang <note caller="+" style="f"><char style="fr" closed="false">11:29 </char><char style="ft" closed="false">gargar hiise ege'nebaang</char><char style="ft" closed="false">yookaan qalbeefatebaang hiyyaten</char></note> Goottinka maala itoolenna Goottinxe buudanaa'n ha'woole ifike umo'n murte iyyedaqaan. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />Ha'nooxxe oddo'n heddi manni ela gopheechchinna ifi gopheechchi, mitti mittikinna eryeechchi tennenaa'ni kexxeexxeeniten. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />No'oke umo'n mureennele silaat no'o'n murendamaba'a. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />Yaane kinni buttatik manninni welti no'o'n murendabaashsha Gootti ta'a no'o'ni mureexxi no'oo'o toggi assa'neen.<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />Yoona anke dayyuwwaa! Goottiinxe hirbaati'a bukk hitinaa wodda wel wel heqqe! <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />Ha'noxxi bukki hiyya ha'no'n murte iyyedaggaxxe kaddabaashsha ha'no giddii'n so'lo'weeki manji hedhoole ifinge mine'n itowwaal. Gatteexxe yaanexxee daganno wodda akeette uwwannon.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s1">Woyyichchi Hafuurxa Uwwaara</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />Anke dayyuwwa ta'a Woyyichchi Hafuurxe uwwaxxee egendino'a hasaanen. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />Mageno amandinemabaa wodda dhariinxe yaanebaa oofendina'n haaso'a danideettabaaxxe eettene fakkuwwa hordofina'emmaxxa egendine'een. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />Tennexxee Mageniinke Hafuurinni haaso'a'n Yessuussi badinemeeken hiyyaak ayyinna hedhabaan. Iittanni Woyyichchi Hafuurinnitte kaddoole malee'e, «Yessuusi Goottaken» hiyyaaki ayyinna hedhabaaxxa ha'noo'n kulaanneni.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />Gargar gargar hexxeexxi Woyyichchi Hafuurixxi uwwa hexxeen, Hafuurikinn mittengenni. <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />Gargar gargar hexxeexxi ergatenshauwwa hexxeen Goottikinna mittengen. <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />Gargar gargar hexxeexxi Woyyichchi Hafuurxe hujuwwa hexxeeni; yaane kinni duuchchiinxa huje duuchchiinge'n hujaak ookkone mitte Magenon. <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />Yaane kinni mitte mittengee'e Woyyichchi Hafuurxi ifisatixxi huje uwwendaak qabetixxe la'o'aaten. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />Woyyichchi Hafuuri mitte manji'a beekumik haaso'atixxa dande'a uwwaan. Iikki Hafuuri iittanni wele manji'a ege'nati haaso'atixxa dande'a uwwaan. <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />Iikkinni Hafuur mittekee amanatixxa, welekee fayyisatixxa uwwa, <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />iittanni mittekee mambe'a hujatixxa, welekee iittanni raaga haaso'atixxa, welekee hafuuruwa gargar hiisse e'ge'natixxa, iittanni welekee gargar gargar hedheeke laagadinni haaso'atixxa, weleekee iittanni gargar gargar hedheeke laagadinni haaso'endeexxa tikatixxa uwwa uwwaan. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />Kaddo malee'e tennee duuchcha assaak ookkone mittenge Hafuuran. Woyyichchi Hafuur eeyyeeshsha mitte mittengee gargar gargar hexxeexxa uwwa uwwaan.<verse eid="1CO 12:11" /></para>
  <para style="s1">Mitte Biska Garar Gargar Hedheeka Qooluwwa</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />Mitti bisi heddo bisiinka qoolluwwa afeexxe kadoolenna mitte bisonni; yaane kinni qoolluwwi heddoke kadoolenna bisi mitteken; Kiristoosinna iittanni mitte bisishaten. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />Iittanni Ayihudake kandoonnole, Girkeeke manna kandoonnole, garbake kandoonnole yookaan leexxa manna kandoonnole no'o duuchchiing mitte biso kandoonna'a mitte Hafuurinni xammaqemeennen; no'o duuchchiing konne mitte Hafuura ha'wineennen.<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />Bisi dademeek heddo qoolluwwike kadeete malee mitte qoolike calla kadeetebaan. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />Fakkeenakee lekka, «Ani angate kada gopheennaxxee bisiinke qoolabaan» hitoole iitta hiteexxee'e bisiinke qoola kada isixxi gattaata? <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />Manshatinna, «Ani illete kada gopheennaxxee bisiinke qoolabaan» hitoole iitta hiteexxee bisiinke qoola kada isixxi gattaata? <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />Bisi duuchcha ille calla kadde'eele mayik laqa dandeessissamma'a? Bisi duuchchi mansha calla kadde'eele mayik ulata dandeessissamma'a? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />Yaane kinni Mageni eeyyeesha mitti mitting qooli bisoke'n hedhaasha asse'een. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />Kunni duuchchi mitte qoola calla kade'eele wo'm bis haba hedhemmata? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />Yoonna bisiink qooluwwi heddoken bisi kinni mittengen.<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />Tennexxee ille angaa, «Ati ani'a hassissabexxon» hiyya dandeetabaan; iittanni umi lekkaa, «Ati ani'a hassissabexxon» hiyya dande'abaan. <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />Wele waalin ifi gopheeke labaak bisiink qoolluwwi caala hasisaakeeran. <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />Tufateemeeke labaaka no'oka bisiinka qooluwwa lumo qico ulfeesinnannon; iittanni no'o shookishaaka no'oke bisika qoolluwwa caala ulfeesinee xexxe'antannon. <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />Shoonkabe'noke no'oke bisiinke qoolluwwi'a kinn tinni duuchchi hassissabaan. Mageni kinn bisiinka qooluwwa mitteba abidiseexxi ulfinni xe'yeemmake bisiinke qoolluwwi'a caala ulfinna uwwe'een. <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />Tenneenna iitta assechchi bisiinke qoolluwwixxe oddo'n gargar higa hexxebaang qixxe weli'anni weli hishshi hiyyaashshaten. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />Mitti bisiink qoolli abara uudaa wodda weli bisiink qoolluwwi duuchchi isinni welti abara uudaan. Mitti bisiik qool ulfeesemaa wodda wel bisiink qoolluwwi isinni welti gammadaan.<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />Ha'no duuchchiing Kiristoosike bison; Mitti mitting ha'no isik bisike qoolluwwan. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />Tennexxee Mageniinxe tuuta giddo ediseexxi ergameeyye, langakaba wabeeko, sakkaba barachchiisalluwwa, itti aanseexxi mambe'a hujaaka manna, fayyisatixxa uwwa afe'eeka manna, wele gargaaratixxa uwwa afe'eeka manna, lebeexxi galchatixxa uwwa afe'eeka mannanna gargar gargar hedheeke haaroke laagadinni haasoa'atixxa uwwa afe'eeka manna ugge'een. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />Duuchchiing ergameeyyeteeta? Duuchchiing wabeekoteeta? duuchchiing barachchiisalluwwakeeta? Duuchchiing mambe'a aassakeerata? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />Duuchchiing fayyisatixxa uwwa afe'eekeerata? Duuchchiing haaroke laagadinni haaso'atixxa dande'a afe'eekeerata? Duuchchiing tikatixxa dande'a afe'eekeerata? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />Tennexxee duuchchiinxenaa'n saxxaaxxa uwwa alfatee jaba qicinni halsee! Ta'a iittanni duuchchingenaa'n sa'aaka ora ha'no'a leelishaannen.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s1">Dhugaattixxa jaalala</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />Manjiinke laagadinni, yookaan ergannatike laagadinni haaso'iinxi dande'a ane'ni hexxeelenna jaalala gophoonole qililisammake sibilshanna, yookaan raaramake bilibilsha kade'eennen. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />Raaga haaso'atixxa uwwa afeenellenna buqo yaane duuchchanna ege'naa duuchcha ege'noonole, kooba fottosite welebaa sa'issitaaxxa amana afo'oonole jaalala gophoonole kinni ani toliinke. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />Afeneechcho duuchcha hiyyeeyetee qoodonole, biso anka midde giirate'n gubato'a sa'isennexxi uwwonole, jaalala kinni gophoonole ani toliinken.<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />Jaalala ossita, arjatte, gaabbitaba'a, hollitaba'a ifinna dukaba'a, <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />hassissabaaxxa assitaba'a, umo ifikee calla kaddaaxxa halstaba'a, hifattaba'a, ballees godoba uggudhitaba'a. <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />Jaala dhugaate'n gammaddaa malee'e fuggoxxe'ni gammadaba'a. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />Jaalala duuchchii wodda ossitaan, duuchchii wodda amnadaan, duuchchii wodda addataan, duuchchii wodda ti'ni hitee urritaan.<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />Jaalala duuchchii woddi'a ibbaba'a, raagake kadoole gata; haaroke laagadinni haaso'ate kaddoole uurta; ege'nate kaddoolenna gatta. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />Tinninna kadaachchi egenneennek hanii'nite'n; raagakanna haasonnaannek hanii'niten kaddeemmaxxeeten. <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />Yaane kinni wo'ma kaddeexxi yaane daggaa wodda xe'yate kaddeexxi yaane gatta. <verse eid="1CO 13:10" /><verse number="11" style="v" sid="1CO 13:11" />Ani oossumma hedhennaa wodda oosetishsha haaso'aannan, oosetishsha hedaannan, oosetishshanna hede herregaannan. Lumo manjo kadenne wodda kinni oosetishsha kada waaleennen. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />Ta'a no'o daa'witete'n adda leellitabaaxxa yaane uundannashsha undaannen; eettene yanna kinni albii edo uundannon. Ta'a ani ege'neennek hanii'niten; eettene yanna kinni Magenoke'n ege'nemenne qicnni wo'ma ege'na afannon. <verse eid="1CO 13:12" /><verse number="13" style="v" sid="1CO 13:13" />Yoonna amanaa, addee, jaalalaa, tinni sase yaane ti'ni hitee hexxaan; yaane kinni tenne sase giddii'n caldaaxxi jaalalaten.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s1">Raagiinxanna Wele Laagadinni haaso'atixxa Uwwa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />Jaalala hordoffe; Woyyichchi Hafuurixxa uwwaara giddii'ninni raaga haaso'atixxa uwwa jaba qicinni halse. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />Wele laagadinni haaso'aak manji Magenokee malee'e manjokee haaso'abaan. Buqqo kaddeexxa yaane woyyichchi Hafuuri haaso'ammaxxee ookkonee haaso'a wel ege'naak manji hedhebaan. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />Raaga haaso'aak kinni wele manna ijaratee jabeesateenna dayyesatee ragaan. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />Wele laagadinni haaso'aaak ifi umo calla ijaaraan; raaga haaso'aak kinni manna duuchcha ijaaraan.<verse eid="1CO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5" />Ha'noo duuchchiing wele laagadinni haasotinoole eeyyannon, tenne caala raaga haasotinoole eeyyannon; Mageniinxi tuuta ijaarendashsha wele laagadinni haaso'endeexxi tikema gophpha'noole wele laagadinni haaso'ati mannii'n raaga haaso'a woyyan. <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />Yoonna anke dayyuwwaa! Ha'noobaa daganno wodda wele laagadinni haaso'onnole leellati yookaan ege'nati yookaan raagik, yookaan barachchiisati ha'no'n akula gopha'onole, maa la'o ha'noa uwwanno? <verse eid="1CO 14:6" /><verse number="7" style="v" sid="1CO 14:7" />Suusu'letishshanna kirariinsha hedheek lubbo afebaak faarotik miyuwwike hafuuri midde gargar gargar hedheeke hafuuruwa afa gophoole iitti suusu'leti ufuufendeexxi yookaan kiraarik ganendeexxi faaro hitta ege'nema dandeeta? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />Malagati ege'nemebaake hafuurinni ufuufemeexxe kaddoole lolakee'e ayyete qophpheefata? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />Iittanni ha'no manjoke'n aagaaka haaso'a gophphinoole ha'no haasotinaaxxa ayyete ege'na dande'aa? Diiddalotee haasotina'neeshsha kaddinaan. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />Tenne butta'n heddo laagada hedheen, tika afebaak laagadi mittikinna hedhebaan. <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />Yoona mitti manji haaso'a'neeke haaso'ixxa tika ani ege'na gophonnole ookkone haaso'emmake manji'a keessummatte kadannon; isinna ani'a keessummate kadaan. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />Iittanni ha'no Woyyichchi Hafuurixxa uwwa halstinaake kaddinemmaxxee Mageniinxa tuuta ijaartaaxxa uwwa caala halse.<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />Tennexxee wele laagadinni haaso'aak manji haaso'emmaxxa tikatixxi dande'a afaashsha soodattowwaal. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />Wele laagadinni soodattaanno wodda hafuuri anki soodataan; sammo anxi kinn gumma belo gatta. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />Yoona ani maa assa hassissa? Anke hafuurinni soodataannon; iittanni anxe sammoninna sodataannon; anke hafuurinni faarsaannon iittanni anxe sammonninna faarsaannon. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />Iittate kadgophooleta ati hafuurik Mageno galateeffattatto wodda ati hitaattexxe yaane'a keessummate kadeek manji ati haasottaatexxa ege'na gophoole hitata atixxe galatiinxe soodachcho «Hamiin» hiyya dande'a? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />Ati darree'n Mageno hassissaa qico galateeffatteeten; tinni atixxi soodachcho kinni wele manjo ijaartaba'a.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />Ani ha'no duuchchiing caala wele laagadinni haaso'annaxxee Mageno galateefattannon. <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />Yaane kinni Mageniinxe tuuta giddo wele manna baraachchiisatee tomme kuma hiyyichcho wele laagadinni haaso'ati mannii'n onde hiyyichcho ege'nemeeke laagadinni haaso'a eeyyanno.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />Anke dayyuwwa fuggoxxe yaane'a oosete kadde malee'e ha'noke heduminni oosete kaddinnoqqe'e! Ha'noke hedumik kinni lummexxineeke kadde. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />Tinninna Seeri giddo,</para>
  <para style="q1" vid="1CO 14:21">«Laagadi insa'neke ege'nemebaake manninninna</para>
  <para style="q2" vid="1CO 14:21">alagiinke afo'inni</para>
  <para style="q1" vid="1CO 14:21">Konne arda'n haaso'annon;</para>
  <para style="q2" vid="1CO 14:21">iittatenna kaddoole ardi anki hiyyichcho anka laqabaan;»</para>
  <para style="q2" vid="1CO 14:21">hiyya'neen Gootti hiyyendee borresende'een.<verse eid="1CO 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22" />Tennexxee wele laagadinni haaso'a beesisake kaddaak amanabaake manni'aate malee'e amanaaketebaan; raaga haaso'aak kinni beesisake kaddaak amanaake manni'ate malee'e amanabaaketebaan. <verse eid="1CO 14:22" /><verse number="23" style="v" sid="1CO 14:23" />Ammaagne bukki hitaa wodda mitte mittende ammaagne wele laagadinni haasotaa'naa ege'nebaak yookaan amanebaak manni konne haaso'a laqaa wodda «Kunni manni maraate'een» hiyyabaata? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />Yaane kinni duuchchiing raaga haaso'aa'naa amanebaak yookaan ege'nebaak manji dagoole laqaake hiyyichcho duuchcha'n cubbichchak kada ifixxa ege'naa'n; iittanni laqaake hiyyichchi duuchchinna iso'n muraan. <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />Isixxe qalbe sho'ondeexxi yaanenna leellite'naa, «Mageni ha'nooxxe oddo'ni hedheen!» hiyyat kumbu hiyye Mageno sagadaan.<verse eid="1CO 14:25" /></para>
  <para style="s1">Seeriinxa Magenooffachcho</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />Anke dayyuwwa yoona maa assa hasissaa? Soodachchotee bukki hitinaa wodda ha'no giddii'n mitti faarsatixxa uwwa afe'een; mitti barachchiisatixxa uwwa afe'een, mitti buqo yaane leellishatixxa uwwa afe'een, mitti wele laagadinni haaso'atixxa uwwa afe'een, weli tikatixxa uwwa afe'een; tinni duuchchiinxi uwwa Mageniinxa tuuta ijaarateete kaddowwaal. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />Eele laagadinni haaso'a'neekiir hedhoole, lami yookaan heddatoole sasi bado badonni haaso'owwaal; insa'ne haassonneexxanna weli manji tikowwaal. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />Tikaaki manji hedha gopheexxe kaddoole kinni wele laagadinni haaso'ammak manji bukki giddo sammi hiyyeexxi ifike umi'anna Magenokee calla haaso'owwwaal.<verse eid="1CO 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 14:29" />Raaga raagakiir lame yookaan sase kande'e haasonnowwaal; weli kinn haaso'endeexxa caqaseexxi memmekisowwaal. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />Ookko ofo'leeke wele manjo'n mitte yaane Megenibaa'n leeliteexxe kaddoole edise haaso'eemmak manji sammi hiyyowwaal. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />Ha'no mitti mitting baratinaashsha mitti mitting jabaatinaashsha ha'no duuchchiing bado badonni raaga haaso'a dandeetinaan. <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />Wabeekotik hafuur wabeekotee ajajemaan. <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />Mageni nage'iinke Mageno malee'e canciinke Megenobaan.</para>
  <para style="p" vid="1CO 14:33">Magenike ardixxe tuuta duuchcha'ninna iittanden. <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />Melaalle soodachchotixxe bukki giddo sammi hitowwaali; Muusek seerinna hiyya'neeshshanni melaalle ajajendaashate malee'e haasotaashsha seeri insa'ne'a uwweebaan. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />Melaalle egendo'a hassaaxxi mitte mitte yaane hexxoole ifi ifika aro'o mine qortowwaal; tinninna kaddaachchi soodachchotixxe bukki wodda melaalle haassoto'a hassissabaan.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />Hitate isi? Mageniik hiyyichchi dageek ha'noo'niteeta? Yookaan Mageniik hiyyichchi geyeebi ha'noba callata? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />«Ani wabeekaken» yookaan «Ani hafuuriinxa uwwa afeeneni» hiyyaak manji hedhoole tinni ha'no'a borreessenneexxi yaane Goottiinke ajaja kaddeexxa ege'nowwaali! <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />Tenne ege'nabaake kadoole isinna ege'neemmoqqe'e!<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />Tennexxee anke dayyuwwaa raaga haaso'atee lumo qico halse! Wele laagadinni haasso'aakaaranna hoyyitinoqqe'e! <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />Yaane kinni duuchchiinxi yaane eloke orininna seerik kaddowwaal!<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s1">Kiristoosixxa Reyotenaa'n Ke'a</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />Ta'a anke dayyuwwa ha'no'a lallabe'naa adhdhitineemmaxxa, ise'ninna jabaatineexxi uurritinemmaxxa wengeele ha'no kassi assonaa haseennen. <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />Ani ha'no'a lalabennekaichcho jabaatineexxi abixitinoole tenne wengeelenni anjirendinaan; iittate kada gophphoole amana ha'nooxxi toliinxe. <verse eid="1CO 15:2" /><verse number="3" style="v" sid="1CO 15:3" />Ani adhdheennexxa umoke kaddeexxa yaane ha'no'a sa'isse'eennen. Sa'issennexxi yaanenna Woyyichcha maxaafa'n borreessendeemmashshanni, Kiristoosi no'oxxe cubboxxee reye, <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />moogeme; Woyyichcha maxaafa'n borreesendeemmashshanni sakkaxxa bara moogokenaa'n ke'eedheen. <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />Ookkoneechchi uduma Keefa'n<note caller="+" style="f"><char style="fr" closed="false">15:5 </char><char style="ft" closed="false">Pheexxiroosi hiyyaten</char></note> leelle; ookkoneechchi uduma eettene tommenna lame ergameyye'n leelle. <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />Ookoneechchi uduma onde dhibba saxxaaxxee ifixxe hordofeeyye'n mitte yanna'n leelle. Insa'nenaa'ninna heddi manni ta'i qico'n lubbo hedheen; mitti mitti kinn reyeedheen.<verse eid="1CO 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 15:7" />Ookkoneechchi uduma Ya'iqoobi'n leelle; uddumii'n ergaemeeyye duuchcha'ninna leelle. <verse eid="1CO 15:7" /><verse number="8" style="v" sid="1CO 15:8" />Duuchchiinge'n leelleechchi uduma kinni anee gufoti ilendeexxe annoshsha hedheneke'n leelle. <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" />Ani Magenxa tuuta shorsheennaxxee ergameeyye duuchchinaa'n shiixedheennekenna ergamalloke hiyyeme ye'ema ani'a hassissabaaken. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />Yaane kinni ta'a kadeenne qico kade'eennek Mageniike badhaadiniten; ani'a uwwemeek badhaadhinna gumma beloke kadeba'a; wele waalini welekenaa'n caala si'ik huje'eenne. Yaane kinni tennee asseek aninni welti hedheeke Mageniinke badhaadha malee'e antebaan. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />Yoonna antenna kadi insa'ne lallanbaannexxi tennenden; ha'nonna amandineeke tennenden.<verse eid="1CO 15:11" /></para>
  <para style="s1">Reyeeke Mannixxa Ke'a</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />Kiristoosi reyotenaa'n ke'eexxa lallabendeechchinni ha'no giddii'n mitti mitti hittatta, «Reyotenaa'n ke'a hexxebaan» hiyyaa? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />Reyotenaa'n ke'a hedha gophpha'noole kiristoosinna reyotenaa'n ke'ebaan hiyyatentaa! <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />Kiristoosi reyotenaa'n ke'a gophoodhoole no'oxxi lallaba, ha'nooxxi aamananna toliinxen. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />Iittanni, «Mageni Kiristoosii'i reyotenaa'n ke'ise'een» hine no'o dhuka kulat dhariyye Mageniinxe dhuga kula kande afeemmeennen hiyyaten; reyeek manni reyotenaa'n ke'a gopha'noole Magen Kiristoosii'i reyotenaa'n ke'isebaani hiyyaten. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />Tinninna kaddaachchi reyeeki manni reyotenaa'n ke'a gophoole Kiristoosinna reyotenaa'n ke'ebaan hiyyaten. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />Kiristoosi reyotenaa'n ke'a gopheele amana ha'nooxxi toliinxen! Ha'no ta'i qico cubbo ifinxi giddo hexxiine'een hiyyaten! <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />Iittanni Kiristoosi'n amane reyeekiiri ba'een hiyyatentaa! <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />Kiristoosi'i tenne buttixxe hedho calli'a addantaanole manni duuchchi irra manni no'aa yaadake mannan hiyyaten.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />Yaane kinni Kiristoosi reyeeke manni'a umoke kade'e reyotenaa'n ke'a dhugaate'n. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />Reyo mitte manji darree'n daggemmaxxee reyotenaa'n ka'atinna manji darre'n kadde'een. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />Duuchchiing Addaami darree'n reyammashsha iittanni duuchchiing Kiristoosi darree'n hedhotike kadaan. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />Tinni kadaak mitte mittenge'n bado badonniten; ediseexxi umoke kadeek Kiristoosi, ookkoneechchi uduma isi dagaa wodda isike kadeekir reyotenaa'n ke'aan. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />Ookkoneechchi uduma galcha baalomakanna hunna duuchcha balleeseechchi uduma moottumma Mageno Aabi'a sa'isseexxi uwwa wodda eettene yanna muuxamake kadaan. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />Naapha isika duuchcha lekka isixxi hunda sa'isaa qico'n isi moya hassissaan. <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />Injifatemeexxi udu'me ba'aak naaphi reyoten. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />«Duuchixxa yaane Mageni balloomma isik hund hirendaashsha asse'een» hiyyendee borresende'een; Yaane kinni «Duuchchiinxi isike baaloomi hunda kadde'een» hiyyendaa wodda duuchchiinxa yaane isike baaloomi hunda kaddaashsha asseeka Mageno Aabi'a gadhi darre hiyyaten. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />Duuchinxi yaane Kiristoosike baaloomi hunda kaddeechchi uduma Magen Aabi duuchchiinxe yaane'n baalooma afaashsha Kiristoosi isike umininni duuchchiinxa yaane isike baaloomi hiuda asseemmake Mageno Aabi hunda hedhaan. Duuchchiingechchinna Mageno Aabike baaloomi hunda hedhaan.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />Yoona reyeek manni reyotenaa'n ke'a gopha'noole reyeeke mannixxee xammaqema'neeke mannik hiri maachcho? Reyeeki manni haranga ke'a gopha'noole manni insa'nexxa bakka mayeeta xammaqema? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />No'onna duuchchi wodda sodachchiisaaka galduma galla'ennek mayeete? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />Anke dayyuwwa ani barra barra'ninni reyaannen; tenneenna Gootta no'oke Yessuusi Kiristoosi darre'n ha'no'n afennexxe ifi saadanni kokeesaannen. <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />Manjiinke yaadishsha calla kaddoole Efesooni giddo biniinchik welti wolaa'ncho abixxa ani la'o maachcho? Reyeek manni reyotenaa'n ka'a gopha'noole, «Soodo rena'ennaxxee amme indo amme ha'wino» hiyyendemmashsha kandeennen. <verse eid="1CO 15:32" /><verse number="33" style="v" sid="1CO 15:33" />Mee soobbemme; «Elobaaxxi jaalumma eloka adaba balleesitaan.» <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />Ca'ichchi hedumibaa higge; cubbotanna hujinoqqe'e; Mageno ege'nebaak manni hedhemmaxxe tenne hiyyaa'nek ha'noo shookishonnaa hiyyeeten.<verse eid="1CO 15:34" /></para>
  <para style="s1">Reyotenaa'n Ke'atika Biso</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />Yaane kinni «reyeek manni hita ke'a? Reyotenaa'n ke'aa wodda insa'ne anfaak bisi hita hedheeke?» Hiyyeexxi qoraak manji hedha dande'aan. <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />Ko ati bada gowwi rokkatoxxi midha reya gophoole hedho affebaan. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />Ati rokkattoxxi dinnetixxe yookaan wele midhatixxe sanne malee'e dokko mudhaake mudhobaan. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />Magen kinni eeyyeeshsha eettene sanne'a biso uwwaan; mitte mittende sanne'a isenga biso ise'a uwwaan. <verse eid="1CO 15:38" /><verse number="39" style="v" sid="1CO 15:39" />Maal duuchhci mittekbaan; manjiin maal kinni mitte bifaken; biichiink maal wele bifaken; ci'atike maalinna wele bifaken; qulxumetiki maalinna wele bifaken. <verse eid="1CO 15:39" /><verse number="40" style="v" sid="1CO 15:40" />Iitanni iimatike biso hedheen; buttatik bisinna hedheen; yaane kinni iimatike bisik ulfinni mitte bifake; buttatike bisik ulfinni wele bifaken. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />Arishshotik ulfinni mitte bifan; agenjiink ulfinni weleke; urjuwwatik ulfininna welengen; mitte urjek ulfinni wele urjeke ulfinninaa'n gargar hedheeken.<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />Reyotenaa'ni ke'aak manninna iittanden; alo'aake biso kade rokemeek alo'abaake biso kadee ke'aan. <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />Saliphphinik rokemeek ulfinnik ke'aan; gonpheti rokemeek hunnatike kadee ke'aan. <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />Maaliink bisi rokemaan hafuuriink bisi ke'aan. Maaliink bisi hedheexxenni hafuuriink bisinna hedheen. <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />Tennexxee «Iikki siretik manji Addaami hedho affexxe dada kade'een» hiyyendee borresende'een: udumik Addaami kinn hedho uwwaake hafuura kade. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />Yaan kinni sirte'ni dageek ookkone maaliinke malee'e hafuuriinkebaan; iikki hafuuriink dageek ookkone maaliinkee udu'meeten. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />Iikki sirtik manji dademeek buttinakenaa'nite; iikki udumik manji dageek iimatenaa'niten. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />Buttatike kadeekiir ookkone buttatenaa'n dademeemmakishshaten; iimatike kadeekiirinna ookkone iimitenaa'n dageemmakishshaten. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />Ookkone buttatike manjixxa bifa oddo'winnenneshshanni iittanni ookkone iimatike manjixxa bifanna oddo'winnannon.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />Anke dayyuwwa ha'noo'ni mitte kulaannexxi, maalikinna munde Mageniinxa mootumma dhaaldabaan. Iikki reye ba'aak bisi ookkone ba'abaaka hedhotika biso dhaalabaan.<verse eid="1CO 15:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51" />Yoona mitte buqo yaane ha'no'n kulaannene. No'o duuchchiingi rennabe'no; yaane kinni no'o duuchchiinge jijjiiremmannon. <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />No'o jijjiiremmannokinna iikki udumik malagati ufuufemaa wodda dedhanga ille himmi hite baqqitammaxxe yanna giddon. Malagatikinna ufuufemaan, reyeek manninna alo'abaake kade ke'aan; no'onna jijjiiremmannon. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />Kunni ba'aak ookkonee ba'abaaka kunni reyaakinna ookkonee reyaaka oddo'wa hasissaan. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />Kunni ba'aak ookkonee ba'abaaka kunni reyaakinna ookkonee reyabaaka oddo'waaxxa yanna «Reyo injifatendeexxi liqiinsende» hiyyemee borreesemeek hiyyichchi muuxxemmaan. <verse eid="1CO 15:54" /><verse number="55" style="v" sid="1CO 15:55" />Iittanni, «Tee reyoo injifachcho atixxa haba hexxee? Tee reyoo manjo miitattoxxi atixxi hunna haba hexxee?» hiyyende'een. <verse eid="1CO 15:55" /><verse number="56" style="v" sid="1CO 15:56" />Manjo miidhatixxi reyotixxi hunna cubboten; cubbotixxi hunnanna seeraken. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />Yaane kinni Gootta Yessuusi Kiristoosi darree'ni injifachcho no'aa uwwaake Mageni'aa galati geyowwaal. <verse eid="1CO 15:57" /><verse number="58" style="v" sid="1CO 15:58" />Tennexxee eeyyendineeke anke dayyuwwaa Goottakee elo'a ha'nooxxi toliinxe kaddabaaxxa eegendineemmaxxee ti'ni hitine uurre; fedheexxe yaane'ninna weekendinnoqqe'e; Goottiinxa huje'n duuchchi wodda sitineeke kadde.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s1">Iyyerussaalemmixxe Ammaagne'a Bukki Asseemmeeka Maalaqa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />Ta'a ammaagnattee asseemmaaka maalaqa bukki assatixxee Gelaatiyaxxe aammaagne'a uwweennake ajajishsha assee. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />Ani daganno wodda tinni maalaqiinxi bukki assa ookkone wodda kaddabaashsha ha'no giddii'ni mitti mitting torbatixxe siretixxe barra'n alfaaxxe qixxe'n gargar hissa'n ca'mowwaal. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />Daganno wodda ha'no filiddinaak manni bukki assitinemmaka maalaqa adheexxi Iyyerusaalemi maraashsha insa'nee ege'nishshaaxxe borronni welti insa'nee ergannon. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />Anxi me'a hasissaaxxe kadde afendoole insa'ne aninni welti me'inaan.<verse eid="1CO 16:4" /></para>
  <para style="s1">Phawuloosika Yaada</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />Meqodooniyake bogi giddii'n sa'e me'a anixxi gata gophphaammaxxee Meqedooniya geyeennechchi uduma ha'noobaa dagannon. <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />Haba'anna me'annoxxe anxe me'a'n anee gargartinaashsha akimagaada ha'nooba turannoxxe yookaan konnee haarso ha'noonni welti sa'issannoxxe hexxe. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />Ta'a tenne lekkanni gorennexxi ha'noo uudatee hasabe'no. Gootti eettii uwwoole qeeraxxe yanna ha'nooni welti turatee addataanne. <verse eid="1CO 16:7" /><verse number="8" style="v" sid="1CO 16:8" />Yaane kinni Penxeqoosixxeke ayyaanii qico'ni Efesooni turannon. <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />Heddo huje hexxeexxi lumoxxi hula ani'a banende'eeni, anee xa'naakiiri kinni heddoke.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />Ximotoosi ha'nooba dagaa wodda soda'abelo ha'nooni welti ofo'laasha iso'o qarqaarree! Isinna anishshanni Goottiinxa huje hujaan. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />Tennexxee ayyinna iso'o tuffatabaashsha; isi dayyuwwik welti anibaa dagaashsha heqqaanaxxee'e isi anibaa naage'ik hige dagaashsha oriinxe me'aa hasisaachcho isoo gargaarre. <verse eid="1CO 16:11" /><verse number="12" style="v" sid="1CO 16:12" />Dayyi no'oki Aphiloosi wele dayyuwwinni welti ha'nobaa dagaashsha jabeese'e isoo kadhateenan. Yaane kinn isi ta'aa ha'noobaa dagatee'e hasebaan. Isi'a eliddoole kinn dagaaan.<verse eid="1CO 16:12" /></para>
  <para style="s1">Muuxamiinka Gorsanna Nage'a</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />Dammaqqee! Amanatte'ni jabaatine uurree! Worbee! <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />Assitinaaxxe duuchcha jaalalati assee! <verse eid="1CO 16:14" /><verse number="15" style="v" sid="1CO 16:15" />Isxifaanosik mini hadi Akkaayiyaake boga'ni siretixxe ammaagne kaddeexxanna insa'ne Mageniink manni'aa ergatatee umo ifika sa'isinee uunexxa ha'noonna egendine'een. <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />Iitta insa'neshsha hedheek manni'aanna insa'neninni welti hujete'n elo'eeke manni duuchchi'a ajajendinaashsha jabeesse ha'noo kadhataanen. <verse eid="1CO 16:16" /><verse number="17" style="v" sid="1CO 16:17" />Isxifaanosi, Ferdonaaxisinna Akkayiqoosi anibaa dangeexxee'e gammadeenen; tinni kaddeechchi ha'noo kaba hedhaa gophati insa'ne xe'yiteemmaxxa yaane ani'aa wonshine'een. <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />Insa'ne anikanna ha'nooka irre hafuura adhdhinse'een. Tennexxe iita insa'neshsha hedheeka manna ha'no ege'ne.<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />Issiya hexxeexxi Mageniixi tuutta nagi'a ha'no'aa shiqishsha'neen. Aqilanna Pirsiqila insa'neke mine'n bukki hiteexxi kiristoosito duuchcha ulfaateka nage'aa Goottiinke summinni ha'no'aa shiqinsha'neen. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />Kaba hexxeexxi kirsitoosito duuchcha nage'a ha'no'aa shiqinsha'neen. Ha'noonna woyyitte sunqecanni weli sunqexxinna'ni nage'aa weli weli aadhee!<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />Ani Phawuloosi konnee nage'aa anga anixxeninni ha'no'aa borreessenen. <verse eid="1CO 16:21" /><verse number="22" style="v" sid="1CO 16:22" />Gootta Yessuusi'i eeyya'nebaak hedheexxe kaddoole badinemmeeken. «Maaraanatta» Tikatinna «Gootta no'oke Amoo!» hiyyoten. <verse eid="1CO 16:22" /><verse number="23" style="v" sid="1CO 16:23" />Gootta Yessuusik badhaadhi ha'noonni welti hedhowwaali! <verse eid="1CO 16:23" /><verse number="24" style="v" sid="1CO 16:24" />Jaalala anxi Yessuusi Kiristoosi ga'mii'ni ha'noo duuchchinginninn welti hexxowwaali. Hamiini.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>