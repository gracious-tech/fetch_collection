<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Gedeo Bible</book>
  <para style="h">Yohaannisixxa Waleella</para>
  <para style="toc1">Yohaannisixxa Waleella</para>
  <para style="toc2">Yohaannisixxa Waleella</para>
  <para style="toc3">Wal.</para>
  <para style="mt1">Yohaannisixxa Waleella</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Yohaannisixxi Waleella borreessendeek kiristoosito Yessuusi Kiristoosi Gootta insa'neke kadeexxa addantemaxxee buutoxxee shorrichchokanna rakko inisa'ne'ni geltammaxxe yanna'nitemman. Borreessanji umoke asseek yaadi haasessamaki adde insa'neexxi wo'mate kaddaashsha jajjabeessateenna insa'ne'ni gelteexxe shorrichchinxe rakko giddo addata ifixxe'ni jabaantaashsha tirtirsateeten.</para>
  <para style="ip">Maxaafinxi heddo kuta baca weli duuka hexxeexxa waleella abide'eexxen; leelluwwatinna ookkone baro'ni hexxeexxe amaanye'a aagaake orinni, wele kinni buqo kadde turtaaxxe fakkesatike haaso'inni shiqqexxeeran. Faarotixxa azimaachche hiissine faarsinammashsha konne maaxafiki ke'ituwwi gargar hexxeexxe waleelluwwa darree'ni heddo bifanni hiissende shiqqe'een. Konne maxaafixxe tikenshaxxe'e gargar hedheek yaadinna hedheexxe kaddoollenna umi yaadi farri hiyye'eeken; tinninna Mageni, Gootta Yessuusi darree'ni higgabaa qicinni muuxami qico'ni durriisik welti naaphuwwa isika duuchcha injifataan: injifateechchi uduma addatendeexxe isixxe gamo'a haaroxxe iimaka haaroxxe buttaxxa eebba insa'ne'a dhaalchisaan hitaaxen.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">E'yichcho <char style="ior"><ref loc="REV 1:1-8">1:1-8</ref> </char></para>
  <para style="io1">Waleelatixxa tikanna torbaane Mabeniinxa tuutaari'aa ergendeexxa erga <char style="ior"><ref loc="REV 1:9-3:22">1:9—3:22</ref> </char></para>
  <para style="io1">Maxaafakanna torban maxxansuwwa <char style="ior"><ref loc="REV 4:1-8:1">4:1—8:1</ref> </char></para>
  <para style="io1">Torbaane malagatuwwa <char style="ior"><ref loc="REV 8:2-11:19">8:2—11:19</ref> </char></para>
  <para style="io1">Jawwenna lame biniichcha <char style="ior"><ref loc="REV 12:1-13:18">12:1—13:18</ref> </char></para>
  <para style="io1">Gargar hexxeexxa waleeluwwa <char style="ior"><ref loc="REV 14:1-15:8">14:1—15:8</ref> </char></para>
  <para style="io1">Torbaane Mageniinxe mufexxa buuduwwa <char style="ior"><ref loc="REV 16:1-21">16:1-21</ref> </char></para>
  <para style="io1">Baabilonixxa ba'ne, biniichcha, dharchcha wabeekkichchixxanna durriisiinxa injifatema <char style="ior"><ref loc="REV 17:1-20:10">17:1—20:10</ref> </char></para>
  <para style="io1">Muuxaminxa murte <char style="ior"><ref loc="REV 20:11-15">20:11-15</ref> </char></para>
  <para style="io1">Haaroxa iimanna haarooxxa butta, haarooxxa Iyyerusaaleme <char style="ior"><ref loc="REV 21:1-22:5">21:1—22:5</ref> </char></para>
  <para style="io1">Muuxa <char style="ior"><ref loc="REV 22:6-21">22:6-21</ref> </char></para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="s1">Konne Maxaafika E'yichcho</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />Rakke kada hasissaaxxa yaane ifike erganjuwwa'n leellisho'a Mageni Yessuusi Kiristoosi'a uwweexxi waleella konneechchi butta hexxeexxen. Yessuusinna iimika ifika erganjo ergeexxi ifika erganjo Yohaannisi'n tennee waleella ifise. <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />Yohaanisinna Mageniinke hiyyichchixxeenna Yessuusi Kiristoosixxe dhugaa kulaxxee afeexxa duuchcha dhugaa kule. <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />Barra shiqqe'een, yoona konnee raagiika hiyychcho haassessaak eebbisemeeken; tennee laaqaakiirinna isi giddo borreessendeexxanna heqedhaakiir eebbisemeeken.<verse eid="REV 1:3" /></para>
  <para style="s1">Nage'akanna Saadinoo</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4" />Yohaannisinaa'n.</para>
  <para style="b" vid="REV 1:4" />
  <para style="p" vid="REV 1:4">Issiyake awuraaja'n hexxeexxe eettene torbaane Mageniinxe tuutaari'a.</para>
  <para style="b" vid="REV 1:4" />
  <para style="p" vid="REV 1:4">Hedheekeen, hedhemmakenaa'ninna dagaakenaa'n, isixxe mootte edo hedhemmake ookkone torbaane hafuuruwanaa'n, <verse eid="REV 1:4" /><verse number="5" style="v" sid="REV 1:5" />iittanni xuurameessa dhugaa kula, reyotenaa'n ke'ati angafa kade'eekenna buttatike moyanjuwwike galchallo kade'eeke Yessuusi Kiristoosinaa'n badhaadhikinna nage'i ha'no'aa kadowwaal.</para>
  <para style="b" vid="REV 1:5" />
  <para style="p" vid="REV 1:5">No'oo eeyyeekeenna no'oxxe cubbonaa'n leexa no'oo fulcheekee'e, <verse eid="REV 1:5" /><verse number="6" style="v" sid="REV 1:6" />Yessuusi Kiristoosika Magenonna Anna ergatemmonnaa no'oo moyanjuwwakenna qeesete asseeke, Yessuusi Kiristoosi'a ulfinnikinna hunna duuchchi woddanaa'n duuchchii woddi'a kaddowwaal. Hamiin.<verse eid="REV 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 1:7" />Kunnise, isi duumanchik dagaan;</para>
  <para style="q2" vid="REV 1:7">iikki isoo oteekiir midde gatebaang manji</para>
  <para style="q1" vid="REV 1:7">duuchchi isoo udaan;</para>
  <para style="q2" vid="REV 1:7">buttatik arduwwi duuchchi isinaa'n kexxeexxa odhaan;</para>
  <para style="qc" vid="REV 1:7">Eeti tinni duuchchiinxi kaddaan. Hamiin.<verse eid="REV 1:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8" />Hedheek hedhemmakinna dagaak duuchchiinxa dande'aak Gootti Mageni, «Alfaana Oomeega edikinna udumik anten» hiyyaan.<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">Alfana Omega hiyya Girkike laagadinni edikenna udumike hiyyaten. </char></note><verse eid="REV 1:8" /></para>
  <para style="s1">Yessuusi Kiristoosixxa Waleella</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />Ani dayyi ha'nook Yohaannisi ha'nonni welti mitteba Yessuusixxa rakkonna isixxa mootumma, isixxa ossanna qoodema'eennek ani, Mageniinke hiyyichchixxeenna dhugaa kula Yessuusixxee Fiximo hiyyemaake oddool giddo usuremee hedhennan. <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />Goottinxe barra'n ani Hafuurk hedhennan; malagatiinka hafuura fakkataaka jabaka hafuura ifi uduma laqeennen. <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />Kunni hafuurinna anee, «Uuddatteexxa mirqesanjo maxaafa'n borreessitetexxi Efesooni'n, Semirneesi'n, Phergamoo'ni'n, Tiyyaxirooni'n, Serdeesi'n, Filaadelfiya'ninna Lodoqiya'n hexxeexxe eettene torbaane Issiyaxxe Mageniinxe tuutuwwabaa ergi» hiyye.<verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />Aninna ookkonee ane'n haaso'ammaka hafuura uudatee udumaa wirri hiyyenne; wirri hiyyenne wodda torbaane worqetika xasii uggemalcho afenne. <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />Ookkone xasiinke uggemalchuwwixxe oddo'n manjiinka belto fakkaataaka afenne; isinna lekka isixxe qico'n qeerrexxeexxa oddoono oddo'we'eeke, ifixxa qomanna woreqeti sabbatinni usudhe'eemmakemman. <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />Isik uminna isike uumiink ordichchi golalooxxe gedhebiinxe ordashsha, kaadetishshanna golalookeemman; isixxi illeerinna giirati bubenjo labba'eemman. <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />Isixxi lekkaarinna giirati kashilo'n finiineeke sageetotike sibljo fakkaata'eemman; isik hafuurinna heddo gooto woddi'ike luuljishshatemman. <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />Ifixxe middixxe anga'n torbaane urjuwwa afe'eemman; isike afo'onaa'ninna laamii darree'n qara afeedheek wolaantichchi fula'eemman; isik albi duuchchi lumoshsha wa'a hiteexxi xabbammaxxe arishshoshatemma'a.<verse eid="REV 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 1:17" />Ani isoo afenne wodda reyeeke manjishsha isixxe lekka hunda ibenne; isinna middixxa ifixxa anga ani hana uggeexxi ane'n hiyye qici, «Mee sodaati, edikinna udumik anten. <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" />Ani hedhanoken; reyedhennan, kunse ta'a duuchchii woddanaa'n duuchchii woddi qico'n ani hedhannoken; reyotixxinna wiida balexxi qulfe anxe anga'n hexxeen. <verse eid="REV 1:18" /><verse number="19" style="v" sid="REV 1:19" />Tennexxee uuddaattexxa ta'a hexxeexxanna uduma kaddaaxxa borreessi. <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" />Anxe middixxe anga'n uuddeettaaxxa iitti torbaane urjuwwanna ookkone torbaane worqeti xassi uggemalchixxi buqo yaane tinni: iitti torbaane urjuwwa eettene torbaane Mageniinxe tuutaxxe ergannan<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">yookaan erganjuwwan.</char></note>; torbaani xassi uggemalchuwwi iittanni torbaane Mageniinxe tuutan.»<verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s1">Erga Efesooni'n Hexxeexxe Mageniinxe Tuuta'a</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />Efesooni hexxeexxe Mageniinxe tuutake iimike erganji'a hitetexxi borreesittato qici: Torbaane urjuwwa ifixxe middixxe anga'n afe'eek, torbaane worqeti xassike uggemalchixxe oddo'n mammarema'neeke hiyya'nee qici: <verse eid="REV 2:1" /><verse number="2" style="v" sid="REV 2:2" />Huje atixxa, elo'a atixxa, ossa atixxa ege'neennen; fuggaleeyyetanna gaga'mi hittetexxi insa'nee waaldettexxa, ergameeyyete kandebaang no'o ergameeyyeten hiyya'neekaaranna qo'nissetexxi insa'ne dhariyyete kandeexxa affeettexxa ege'neennen. <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" />Iittanni ti'ni hite'e ossitettexxanna anke summixxee rakko adhdhitteettexxa ege'neennen; tennee duuchcha'n ko'witebexxon.<verse eid="REV 2:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="REV 2:4" />Kaddomalee atee'e ci'maannexxe yaane hexxeen; tinninna edixxa atixxa jaalala waaldeeten. <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" />Yoona habaa'n ibbettexxa hedi; aaddetanna aaggettexxi edo assitataxxa yaane assi; aadde aaggo gophphotole atika xassiinka uggemalcho isxxe bakkanaa'n adhdhannon. <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" />Yaane kinni ati affe'eettexxi eloxxi yaane, tinninna ani gibannoxxa Niqolaatotixxa huje atinna gibbe'eeten.<verse eid="REV 2:6" /></para>
  <para style="pm">
    <verse number="7" style="v" sid="REV 2:7" />Hafuuri Mageniinxe tuuta'a haaso'aaxxa mansha afe'eek laqowwaal. Injifataak, Mageniinke eloke hiddichchixxe bakka'n hedheeke hedhoti haqichchinaa'n itaashsha assannon.<verse eid="REV 2:7" /></para>
  <para style="s1">Seemirnesixxe Hexxeexxe Mageniinxe Tuuta'a</para>
  <para style="m">
    <verse number="8" style="v" sid="REV 2:8" />«Semirneesi hexxeexxe Mageniinxe tuutake iimike erganji'a hite borreesittatto qici:</para>
  <para style="pm" vid="REV 2:8">Edikinna muuxamiink, reyeexxi hedhaake kadeek <verse eid="REV 2:8" /><verse number="9" style="v" sid="REV 2:9" />rakko atixxanna hiyyumma atixxa ege'neennen; kaddoo malee'e ati dureessaken; Ayihudake kadebaang ani Ayihudake hiyya'n atee summa balleessa'neekaara ege'neennen. Insa'ne kinni duuriisiinke maabaran. <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" />Ate'n gelto'a hexxeexxa rakko mee sodaati; kunse duurriisi ha'noo hega uudo'a ha'noo giddii'n mitte mitte usurriinke mine'n darbaan; tomme barranna rakko adhdhitinaan; reyoti qioco'ninna xuurameesake kadi; hedhotika kallachcha ati'a uwwannon.<verse eid="REV 2:10" /></para>
  <para style="pm">
    <verse number="11" style="v" sid="REV 2:11" />Hafuuri Mageniinxe tuuta'a haaso'aaxxa mansha afe'eek laqowwaal; Injifataak langaxxe reyonni harnga miidhemaba'a.<verse eid="REV 2:11" /></para>
  <para style="s1">Pherigamoon Hexxeexxe Mageniinxe Tuuta'a</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />«Phergamooni hexxeexxe Mageniinxe tuutake iimike erganji'a hittettexxi borreessittatto qici:</para>
  <para style="pm" vid="REV 2:12">Lamiin darree'n qara afe'eeka wolaantichcha afe'eek hiyya'nee qici: <verse eid="REV 2:12" /><verse number="13" style="v" sid="REV 2:13" />Ati duurriisiinxi moote hexxeeba hexxaattexxa ege'neennen; kaddo malee'e anka summa duutee abixxiteetten; duurriisi hedha'neeke ha'nooke qachcha'n ookkone shiyeemeeka ank xuurameessi dhugaa kula, Antiphaasi hedhemmake barro'n midde ane'n afe'eettaxxa amana midde waakkattebexxon.<verse eid="REV 2:13" /></para>
  <para style="pm">
    <verse number="14" style="v" sid="REV 2:14" />Kaddo malee'e ate ci'maannexxa heenoxxa yaane afe'eennen; Isira'eelito dharichchi magenuwwi'a tolchendeexxa ita itto'aanna itteexxi yabaabuldo'a insa'ne edo gugguffachcho ugguro'a Baalaaqi barachchiisemmaxxa eettenee Bele'aamixxa Barachcho hordofaak mitti mitti manni atinni hedheen. <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" />Iittanni Niqolaatotixxa barachcho hordofaak manni atinni welti hedheen. <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" />Tennexxee aadde aagi; kada gophphoole ate'n rakkee dagannon; anke afo'iike wolaantichchinni ha'noo otannon.<verse eid="REV 2:16" /></para>
  <para style="pm">
    <verse number="17" style="v" sid="REV 2:17" />Hafuuri Mageniinxe tuuta'a hiyyaaxxa mansha afe'eek laqowwaal; injifataakee ookkone sho'omeeke menninaa'n isi'a uwwannon; iittanni isoo adhdhaake manjo kadoole malee'e ayyinna isoo ege'nabaaka haarok summi itti borreessemeeka golalooka kinjo isi'a uwwannon.<verse eid="REV 2:17" /></para>
  <para style="s1">Erga, Tiyaxiroon Hexxeexxe Mageniinxe Tuuta'a</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />«Tiyyaxirooni hexxeexxe Mageniinxe tuutake iimike erganji'a hittettexxi borreesittatto qici:</para>
  <para style="pm" vid="REV 2:18">Giirati bubenjishsha hexxeexxa illeeranna giirati kashilo'n finiineeka sageettoti sibljo fakkattaaxxa lekkaara afe'eek Mageniink Beti hiyya'nee qici: <verse eid="REV 2:18" /><verse number="19" style="v" sid="REV 2:19" />Huje atixxa, jaalala atixxa, amana atixxa, atixxa ergatenshanna ossa atixxa ege'neennen; iittanni edixxe atixxe huje caala ta'ixxi saxxaaxxa ege'neennen.<verse eid="REV 2:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="REV 2:20" />Kaddo malee'e atee ci'maannexxe yaane afe'eennen; ani wabeekake hita'neexxa manjichcho Elzabeelii'i ga'mami hitee walde'eeten; ise ank erganjuwwi yabaabulo'aanna dharichcha magenuwwi'a tolchendeexxa ita ito'a barachcho ifixxenni insa'nee dedhisa'neen. <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" />Ifixxe yabaabulanaa'ninna aadde aaggo'a ise'a yanna uwwennan; ise kinni gara gibbe. <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" />Tennexxee rakkotixxe taqe hana isee hunannon; ise'n yabaabulaakaara iseke ornaa'n aadde aaga gonphoole rakko jabaxxa insa'ne'en iyyedagannon. <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" />Isexxa oosenna reyoti ganannon; ookkoneechchi uduma duuchchiinxi Mageniinxi tuutaari ani qalbetanna yaada qo'nisannoke kadennexxa qalbeefantaan; ha'noo mitte mittengee ha'nooxxe huje hujeshshanni hira ha'no'aa uwwannon. <verse eid="REV 2:23" /><verse number="24" style="v" sid="REV 2:24" />Barachcho isexxa hordofinemmabaakeenna duuriisinxe dhi'mo buqo yaane hiyyendaaxxa isexxa barrachchiisa adhdhitinemabaak Tiyyaxirooni gatinemmaake ha'no'a kinni hiyyaannexxi tenneten: Ha'no'n lebennexxi wele ba'o fe'abe'non. <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" />Ani daganno qici'a affine'eexxa yaane duutine abbixxe.<verse eid="REV 2:25" /></para>
  <para style="pm">
    <verse number="26" style="v" sid="REV 2:26" />Injifateekenna huje anxa muuxami qica'a muuxakeenna Ayihudake kadebaake manni hana baallooma isi'a uwwannon; isinna<verse eid="REV 2:26" /></para>
  <para style="qm1">
    <verse number="27" style="v" sid="REV 2:27" />‹Insa'ee sibljinxe siqichchonni moyaan;</para>
  <para style="q2" vid="REV 2:27">faariinke miyishshanna insa'nee bulleessaan;›</para>
  <para style="q1" vid="REV 2:27">Tinninna ani Anna ankenaa'n</para>
  <para style="q2" vid="REV 2:27">baallooma adhdhena qicishshate. <verse eid="REV 2:27" /><verse number="28" style="v" sid="REV 2:28" />Aninna soodimarinka bakalcha isi'a uwwannon. <verse eid="REV 2:28" /><verse number="29" style="v" sid="REV 2:29" />Hafuuri Mageniinxa tuuta'a hiyyaaxxa mansha afeeke laqowwaal.<verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s1">Erga Serdeesi Hexxeexxe Mageniinxe Tuuta'a</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />«Serdeesi hexxeexxe Mageniinxe tuutake ergaji'a hitettexxi borreesstatto qici:</para>
  <para style="pm" vid="REV 3:1">Ookkone torbaane Mageniinka Hafuuruwwanna eettene torbaane urjuwwa ifixxe anga'n afe'eekenaa'n kulendeexxen:</para>
  <para style="pm" vid="REV 3:1">Summi callinni hedho hexxete, yaane kinni rerteetten. <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" />Tennexxee dammaqi; rerto'a shiqqeexxa wele yaanuwwa dhuudhdhi; atixxi huje anke Mageni edo wo'mate kaddee'naa afebe'non. <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" />Yoona adhdhitettexxanna laqqettexxa qalli hiyyi; iseenna ajajemi; aaddetanna aagi; dammaqa gophphotole kinni moodhachchiinsha ate'n dagannon; heene yannanna dagannoxxa egendabexxon.<verse eid="REV 3:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="REV 3:4" />Yaane kinni ifixxa seemma battoossedhebaak heenok manni atinni welti Serdeesi hedheen; insa'nenna golallooxxa seemma odo'wineexxi aninni welti me'inaan; tinninna kaddaachchi isnsa'ne'a hassissaaxxe kaddeemmaxxeeten. <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" />Injifateek insa'neshsha golallooxxa seemma oddo'waan; ani Anna anke edonna isixxe erganna edo isi'a dhugaa kulannon; isika summanna hedhotike maxaafinaa'n balleessabe'no. <verse eid="REV 3:5" /><verse number="6" style="v" sid="REV 3:6" />Hafuuri Mageniinxe tuutaarii'a haaso'aaxxa mansha afeek laqowwaal.<verse eid="REV 3:6" /></para>
  <para style="s1">Erga, Filaadelfiya Hexxeexxe Mageniinxe Tuuta'a</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />«Filaadelfiya hexxeexxe Mageniinxe tuutake iimike erganji'a hitettexxi borreessitatto qici:</para>
  <para style="pm" vid="REV 3:7">Kunni Woyyichchakenna Dhugaatike kade'eek Daawwitixxa qulfenna ifixxe anga'n afe'eekenaa'n kulendeexxen: Isi baneeka ayyinna cufa dande'aba'a; isi cufeekanna ayyinna bana'a dande'aba'a. <verse eid="REV 3:7" /><verse number="8" style="v" sid="REV 3:8" />Huje atixxa egene'ennen; kunse ayyinna cufa dande'abaaxxa bandeexxa hula ati edo uggureennen; hunna atixxi heenoxxe kaddeexxa ege'neennen; kaddo malee'e anka hiyyichcho heqqexxe'eetten; anka summanna waakkatebexxo. <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" />Kunse Ayihudake kadebaangi no'o Ayihudaken hiyya'n dhara haaso'aakaara, duriisinike maabara kade'eekaar ha'noba'a dagaashsha atixxe lekka hunda sagadaashsha ani atee eeyyennexxanna egenaashsha assannon. <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" />Ossatte ti'nni hitattoshsha atee ajajeeneka anka ajaja heqqexxetaxxee aninna buttate'n hedheekaara hega uuddo'a hexxaaxxe hega uushshotixxe yannanaa'n atee heqqennon.<verse eid="REV 3:10" /></para>
  <para style="pm">
    <verse number="11" style="v" sid="REV 3:11" />Rakee dagannon; ayyinna atika kallachcha ate'naa'n adhdhabaashsha affetechcho duute abixxi. <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" />Injifateeke anke Goottike galmi giddo isoo utuphake assannon; ookkone'ninna haranga fulabaan; anke Magenika summanna anke Megnike qachchika summa kunninna, anke Magenibaa'n butta dagaaxxe harooxxe Iyyerusaalemika summa isi hana borreessannon; anka haaroka summanna isi hana borreessannon. <verse eid="REV 3:12" /><verse number="13" style="v" sid="REV 3:13" />Hafuuri Mageniinxe tuuta'a haaso'aaxxa mansha afeek laqowwaal.<verse eid="REV 3:13" /></para>
  <para style="s1">Erga, Lodoqiya Hexxeexxe Mageniinxe Tuuta'a</para>
  <para style="m">
    <verse number="14" style="v" sid="REV 3:14" />«Lodoqiya hexxeexxe Mageniinxe tuutake iimike erganji'a hitettexxi borreessitatto qici:</para>
  <para style="pm" vid="REV 3:14">Hamiinite kade'eek iittanni xuurameessakenna dhugaatixxe dhugaa kula kade'eek Mageniinxe dadake galchallo kade'eek hiyya'nee qici: <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" />Qiidake yookaan eebbake kadde'ebexxoxxa ani atixxa huje ege'neennen; qiidake yookaan eebbake kadde'eettele silaan atee eeyyannan. <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" />Yoona huffi hite'eeteke malee'e qiidake yookaan eebbake kada gophphettaxxee anke afo'onaa'n fulchennexxi atee tufonnaaten. <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" />Ati, ‹Ani dureessaken; qabeenna afeennen; mittechchinna ani'a hasissachchi hedheba'a› hita'eten. Yaane kinni cuqurtichcha, buxaanjo, hiyyeessa, balla'akanna duwwi qulle kada atixxa egedebexxon. <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" />Tennexxee dureesake kadatee giirate'n hega uudendeexxa worqe anenaa'n hidhdhitotta'a, atixxe duwwi gataka shooko buqeccatee golalloxxa seemma oddo'witotta'a, affa dandeetattoshsha illetika qorsa hidhdhitettexxi isexxattoshsha ati'a gorsa uwwaannen.<verse eid="REV 3:18" /></para>
  <para style="pm">
    <verse number="19" style="v" sid="REV 3:19" />Ani eeyyannokaara gorsannon, xixannon; tennexxee dammaqi; aaddetanna aagi. <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" />Kunse ani hulate'n uurree ganganaannen; ayyinna anka hafuura laqeexxi ani'a hula banoole isibaa e'yennexxi isinni welti itannon; isinna aninni welti itaan.<verse eid="REV 3:20" /></para>
  <para style="pm">
    <verse number="21" style="v" sid="REV 3:21" />Ani injifatennexxi anke Anninni welti isixxe moote'n ofo'leneshsha injifataakinna aninni welti anxe moote'n ofo'laashsha assannon.<verse eid="REV 3:21" /></para>
  <para style="pm">
    <verse number="22" style="v" sid="REV 3:22" />Hafuuri Mageniinxe tuutaari'a haaso'aaxxa mansha afeek laqowwaal.»<verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s1">Magenooffachcho, Iima Moote'n Offo'leekee</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />Ookkoneechchi uduma kunse iimatte'n banedeexxa hula afenne; Sirete'n malagatiinke hafuurishsha ane'n haaso'aa'naa laqennek hafuuri anee, «Amo kaba iimi'a! Konneechchi uduma kada hassissaaxxa yaane ate'n leellishshannon» hiyye. <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />Aninna hirbange'n hafuurik hedhennan; kunse moote iimate'n uurrite'een; tenne moote'ninna ofo'le'eeke hedhemman. <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />Mootete'n offo'leexxi hedhemmakinna Iyasephidinikenna Serdinoke fiixa kinjo fakkata'emman; Mergidike fiixa kinjo fakata'eemmak dowwichchinna eettene moote qarqara'n dowweemman. <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />Iittanni eettene moottexxe dowwe'n wele lame tommenna shoole mootuwwa hexxemman; tennee moottuwwa hananna golallamma seemma oddo'weemmakiirinna ifi ifike umo'n worqetika kallachcha uggudheemmak lame tommenna shoole geedhe ofoldeemman. <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" />Eettene mootenaa'n banqo dindinsonna balaqi fulaamman; mooteti edo torbaane ifuwwi ifa'emman; kunniirinna torbaane Mageniinke Hafuuruwwan. <verse eid="REV 4:5" /><verse number="6" style="v" sid="REV 4:6" />Iittanni eettene moote edo luqqitte warawara hitaaxxi daa'witetixxi abbaayya hexxemman; eettene mootetixxe oddo'n, isexxe dowwe'ninna edi udumii'n ille itti wo'mite'eexxi shoole daduwwa hexxemman. <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />Iitti taakaxxi dada neeqa, langaaxxi jibichcha fakkaata'eemman; sakkaxxi manjiinka alba labaake alba afe'eemman; sholgaxxinna phirri hiyaake sinbira fakata'eemman. <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />Tinni shooliinxi daduwwa mitte mittendi jaane jaane keeluwwa afe'eemman; konne keeluwwixxe dowwe'ninna giddi darreera'n ille itti wo'mite'eemman; hashshanna barra</para>
  <para style="q2" vid="REV 4:8">«Woyyichchi woyyichchi woyyichchi</para>
  <para style="q2" vid="REV 4:8">duuchchiinxa dande'aak,</para>
  <para style="q2" vid="REV 4:8">hedheemmak, hedhaakkinna dagaak</para>
  <para style="q2" vid="REV 4:8">Gootti Mageni!» hiyya uurrisa'emmaba'a.<verse eid="REV 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="REV 4:9" />Tinni hedho affe'eexxi dadaar ookkone mooteti hana ofo'leemmakeenna duuchchii woddanaa'n duuchchii woddi'a hedhoke kadeexxi hedhaakee ulfinna gaachchanna galata isi'a uunaa wodda, <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />iitti lame tommenna shoole geedhe ookkone mootete'n ofo'leek edo albik gonbisemmeexxi duuchchii woddinaa'n duuchchii woddi'a hedhoke kadeexxi hedhaakee saganda'emman; ifi ifika kallachchuwwanna eettene moote edo uggurreexxi,<verse eid="REV 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11" />«No'oke Goottanna no'oke Magenoo,</para>
  <para style="q2" vid="REV 4:11">ulfinnikinna gaachchanii, hunnatinna sadino ati'a hassissaan;</para>
  <para style="q1" vid="REV 4:11">Ati duuchiigeechcho daddeetaxxee</para>
  <para style="q2" vid="REV 4:11">fedhi atixxen kunnichchiirinna dademeexxi</para>
  <para style="q2" vid="REV 4:11">hedhaake kade'een.»<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s1">Mirqisanjo Maxaafanna Ookkone Gedhechcho</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />Eettene Moote'n offo'leemmak giddonna gadho itti borreessemeexxi torbaane maxxansik buqemeeka mirqisanjo maxaafa middixxe anga'n afee'naa afenne. <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />Mitte worbi iimik erganji jabake hafuurinni, «Maxansuwwa tikateenna ookkone maxaafa banatee dande'a afeek ayyete? Hiyya'n lallaba'naa afenne» <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />Yaane kinni iimate'nite kaddoo buttate'n buttati hundi darrenna ookkonee maxaafa banateenna diriiseexxi uudatee dande'a afeek mittikinna hedhemmaba'a. <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />Aninna ookkonee mirqisanjo maxaafa banatee yookaan diriirisseexxi uudatee dande'a afeek hedha gophemmaxxee lumooshsha oodhenne. <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />Ookkoneechchi uduma eettene geedhe giddii'n mitti anee, «Mee oodhi, kunse Yihudake gosati minik neenqi Daawwitik hiddi injifate'een; isinna maxaafa ookkone bano'anna torbaanniinga maxansuwwa tika dande'aan» hiyye.<verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />Ookkoneechchi uduma eettene mootexxe oddo'ninna eettene shooliinxe hedho affe'eexxe dadawwaxxe oddo'n, iittanni eettene geedhexxe oddo'n dulemeeke fakkataak gedhechchi uurreenaa afenne; iikki gedhechchinna torbaane gaafuwwanna torbaane ille afe'eemman; kunniirinna butta duuchcha'n ergeme'eemmake ookkone torbaane Mageniinke Hafuuruwwan. <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />Isinna dageexxi eettene moote'n ofo'leemmakenaa'n middixxe anganaa'n ookkone maxaafa aadhdhe; iikki Gedhechchinna dageexxi ookkone mootete'n ofo'leekixxe middixxe anganaa'n ookkonee maxaafa aadhdhe. <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />Ookkone maxaafanna aadhdhee wodda itti shoole hedho affeexxi daduwwanna iitti lame tommenna shooliinxi gedhe ookkone gedhichchi edo ifi fike albinni gonbisende; kunniir mitti mittiing woyyoletixxe soodachcho kade'eechcho baganakanna hixaan itti wo'meexxa worqetixxa qore anga anfeemman. <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />Haaroxxa faaronna kunniir hina'n faarsinee qici:</para>
  <para style="q" vid="REV 5:9">«Atixxe mundenni gosa gosati mininaa'n,</para>
  <para style="q2" vid="REV 5:9">laagadi laagadinaa'n, anchi anchinaa'n, gosa gosa ardi duuchchinnaa'n</para>
  <para style="q" vid="REV 5:9">manna Magenokee wodatee</para>
  <para style="q2" vid="REV 5:9">ati duulendeetaxxee</para>
  <para style="q2" vid="REV 5:9">ookkenee mirqisanjo maxaafa aadhdhateenna</para>
  <para style="q2" vid="REV 5:9">maxansuwwa tikatee atee dandeessissaan.<verse eid="REV 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10" />Ati insa'nee no'oke Magenixxe mootummaxxe qeese assiteeten;</para>
  <para style="q2" vid="REV 5:10">insa'nenna buttate'n moonaan.»<verse eid="REV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />Ookkoneechchi uduma uudennen; heddo laakkossixxe ergannaka hafuura laqenne; laakkossi insa'neekinna heddo kumuwwanna heddo miloone'n laakko'emaakemman; kunnichchuwwinna eettene moote'ninna eettene hedho affeexxe daduwwa'n, eetene geedheexxe dowwe'n doowweemman. <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />Kunnichchuwwinna jabake hafuurin hiyyee qici:</para>
  <para style="q1" vid="REV 5:12">«Duleemeeke gedhichchi hunna durumma,</para>
  <para style="q2" vid="REV 5:12">beekkuma uduuda,</para>
  <para style="q2" vid="REV 5:12">ulfinna gaachchannanna, galata</para>
  <para style="q2" vid="REV 5:12">adhdha is'a hasissaan.<verse eid="REV 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13" />Konnechchi uduma iimate'ninna buttate'n, buttati hundi darree'ninna abbaayyate'n konnechchuwwi giddo hexxexxi daduwwa duuchchinna:</para>
  <para style="q1" vid="REV 5:13">Eettene moote'n ofo'leekeenna ookkene gedhechchi'a</para>
  <para style="q2" vid="REV 5:13">galatikinna gaachchanni, ulfinnikinna hunna</para>
  <para style="q3" vid="REV 5:13">duuchchi woddinaa'n duuchchi woddi'a isi'a kaddowwaal» hita'n faarsitaa wodda laqenne.<verse eid="REV 5:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="REV 5:14" />Iitti shooliinxe hedho affeexxi daduwwa «Ameene» hite; iitti geedhenna ififike albinni kumbu hiteexxi magenooffatte.<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s1">Torbaane Maxxansixxa Tikensha</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />Ookkonechchi uduma gedhechchinna torbaane maxxansinaa'n sirtixxi tika bandaa'na afe'een; ookkonechchi uduma eettene shoole hedho affeemmaxxe daduwwnaa'n mitti dindinso fakkata'eek hafuurinni «Amo» hiyyanaa'a laqenne. <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />Aninna uudennen, kunnise golalooke fadhachchi uureemman; iso'ninna ofo'leemmak anga gabe afeemman; kallachchikinna isi'a uwweme; isinna injifatalloke kade fule.<verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />Gedhechchi langaka maxansa tikaa woda langaxxi hedho afeemmaxxi dada «Amo» hiyyaa'na laqenne. <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />Wele kashilo fakatak diimok fadhachchi fule; iso'n ofoleemmank nage'a buttatenaa'n adhdhashshanna manni weli'aa weli duulaashsha assatee isi'a baallomi uwweme; lumok wolantichchiknna isi'a uwweme.<verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />Gedhechchi sakkaka maxxansa banee wodda sakkaxxi hedho affeexxi dada, «Amo!» hitaa'naa laqenne; aninna uudenne, xillok fadhachchi uurre'naa afenne; iso'n offo'lemmakinna anga kiilo afeemman. <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />Ookkone shoolinxe hedho affemmaxxe dadanaa'n mitti, «Gamisa kiilo dinne mitte barraka runda, mitte kiilonna gamisa so'a mitte barrake runda kadowwaal; zayitetanna woyine kinni miitoxxe» hiyyaaka hafuura laqenne.<verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />Gedhechchi sholgaka maxxansa banee wodda sholigaxxi hedho affeexxe dadaki, «Amoo!» hiyya'naa laqennen. <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />Aninna uudenne, kunnise bifa isixxi wekkeliteeki fadhachchi uurre'naa uudenne; iso'n ofo'lemmakinna summi reyotemman; reyemak manni hedhemmaxxi buttanna isoo hordofa'emman; kunnichchuwwinna wolaantichchik, solo'iinxe ballaninna buttatike biniichchinni shinnaashsha, buttixxe sholgaxxe anga'n baallomi konelchuwwi'a uwwemeen.<verse eid="REV 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />Gedhechchikinna ondeesoka manxansa tikee wodda Magenike hiyyichchixxenna kulemmaxxe dhugaa kulaxxe dulemeeke mannixxa lubbuwwa ookkone tolchimalchi hunda afenne. <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />Insa'nenna jabake hafuurinni «Duuchinga galchitattoke Woyyichchikinna dhugaati Gootta, murteboxxok haani qici'ate? Buttate'n hedheekeera'n no'oxxe mundexxee halo fulda'eeboxxoki haani qici'ate?» <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />Okkoone uduma mitte mittengee golalooxxi seemma uwwende; edi'a insa'neshshanni shiyemaake erganjuwwi jaaluwwinna insa'neke dayyuwwiki laakkosi wo'maa qico heenoxxa yanna ossinaashsha insa'ne'n kulende.<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />Gedhechchikinna jiyaka maxxansa tikaa'na'a uudenne; lummoxxi buttiniixxi lele'manna kadde. Arshotinna yaadotixxe seemmashsha xillexxe; agenjikinna mundetishsha diimmedhe. <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />Ode'inka haqicho jabaxxi diidallo lele'missammashsha raxemmabaaxxi gummanna isonaa'n harcaatammashsha iimatixxi urjuwwanna butti'a harcaate. <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" />Iimatinna mirqisanji maxaafishsha mirqende baxxe; koobuwwatinna oddooluwwi ififixxe bakkanaa'n fuggussemme. <verse eid="REV 6:14" /><verse number="15" style="v" sid="REV 6:15" />Ookkonechchi uduma buttatik moyanjuwwinna galchalluwwi, bagedink ja'laabuwwi, dureeyye, jajjabuwwi, garbuwwikinna goottuwwi duuchchi wolo'uwate'ninna koobuwwatixxe rassuwwa giddo sho'omme. <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" />Insa'nenna koobuwwatanna rassuwwate'n hinee qici: «No'o hana ibbe! Ookkone mootete'n offo'lemmak edo, ookkone gedhechixxe mufenaa'n no'oo sho'we. <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />Lummoxxi mufetixxi barra dagemmaxxee aateta dande'e uurraa?» hine.<verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s1">Dhibbinna Shoole Tomminna Shoole Kumi Manni Maxxansemeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />Ookkoneechchi uduma shoole erganna sholinge buttatike kasa'n uurritee'na'a afene; ergannatinna diidallo buttate'n yookaan abbaayyate'n yookaan hoone haqichocho'ni diidaleestabaashsha eettene shoolinxa buttatixxa diidalluwwa abinde. <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />Ookkoneechchi uduma hedhaake Magenika maxxansa afeek weli iimik erganji borotenaa'n dagaa'naa afenne; isinna buttatanna abbaayya miidhatee baallomi insa'ne'a uwwemmeexxa shoolinxa eetene erganna lumoke hafuurinni, <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />«No'oke Magenike erganjuwwike alba'n maxxansa maxxasinanno qico'n butta yookaan abbaayya yookaan haqichchuwwa miitinnoqe'e» hine.<verse eid="REV 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 7:4" />Ookkone maxxansemeeke mannika laakkossanna laqqene; insa'nenna Isira'eelitotike gosati mini mini hadi duuchanaa'n dhibbanna shoole tommenna shoole kumamman. <verse eid="REV 7:4" /><verse number="5" style="v" sid="REV 7:5" />Yihudake gosati minenaa'n tommenna lami kumi, Roobeelike gosati minenaa'n tommenna lami kumi, Gaadike gosati minenaa'n tommenna lami kumi, <verse eid="REV 7:5" /><verse number="6" style="v" sid="REV 7:6" />Aseerike gosatike minenaa'n tommenna lami kumi, Niftaleemike gosati minenaa'n tommenna lami kumi, Minaaseke gosati minenaa'n tommenna lami kumi, <verse eid="REV 7:6" /><verse number="7" style="v" sid="REV 7:7" />Simi'oonike gosati minenaa'n tommenna lami kumi, Leewwike gosati minenaa'n tommenna lami kumi, Yisakoorike gosati minenaa'n tommenna lami kumi, <verse eid="REV 7:7" /><verse number="8" style="v" sid="REV 7:8" />Zaabilloonike gosati minenaa'n tommenna lami kumi, Yooseefike gosati minenaa'n tommenna lami kumi, Biiniyaamike gosati minenaa'n tommenna lami kumi manni maxansemme.<verse eid="REV 7:8" /></para>
  <para style="s1">Golalooxxa Seemma Oddo'weeka Hara Birasa'eeka Arda</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />Ookkoneechchi uduma uudenne; eettene moote edonna ookkone gedhechchi edo ayyinna laakko'eexxi dande'aabaake ardakenaa'n, gargar gargar hexxexxe gosa gosake minenaa'n, anchi anchiike mannanaa'n, laagaduwwa duuchchanaa'n hara bira sa'eek manni uurre'emman; insa'nenna golalooxxa seemma odo'wineexxi meexxetika shafa anga anfeemman. <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />Insa'nenna jabake hafuurinni,</para>
  <para style="q1" vid="REV 7:10">«Anjira mootete'n ofo'leeke</para>
  <para style="q2" vid="REV 7:10">no'oke Magenixxenna ookkone gedhechchixxen» hine.<verse eid="REV 7:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="REV 7:11" />Iitti erganna duuchanna eetene mootenna eettene geedhe edo shoolinxe hedho affeexxe daduwwaxxe dowwe'n uurrite'emman; insa'nenna eettene mootte edo albik kumbu hiteexxi Magenoke magenooffante.<verse eid="REV 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 7:12" />Insa'nenna hina'emma qici,</para>
  <para style="q1" vid="REV 7:12">«Ameen,</para>
  <para style="q1" vid="REV 7:12">Saadinotinna ulfinni,</para>
  <para style="q1" vid="REV 7:12">Beekkumi, galatikinna gaachchanni,</para>
  <para style="q1" vid="REV 7:12">Hunnatinna uduudi</para>
  <para style="q1" vid="REV 7:12">Duuchchi woddinaa'n duuchchi woddi'a Mageno no'oke kadowwaal,</para>
  <para style="q1" vid="REV 7:12">Ameen.»<verse eid="REV 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />Ookkonechchi uduma geedhetenaa'ni mitti anee, «Kunni golalooxxa seemma oddo'week ayyeteera? Habaa'n dange?» hiyye qore.<verse eid="REV 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14" />Aninna iso'n, «Goottaa atete ege'ndete» hiyyenne.</para>
  <para style="p" vid="REV 7:14">Isinna hiisseexxi, «Kunni lummoxxe rakkonaa'ni dageekeeran; seemma ifi ifixxanna ookkone gedhechchixxe mundenni anshe'neexxi ca'a assene'een. <verse eid="REV 7:14" /><verse number="15" style="v" sid="REV 7:15" />Tennexxee,</para>
  <para style="q1" vid="REV 7:15">«Insa'ne Mageniixxe moote edo he'neexxi</para>
  <para style="q2" vid="REV 7:15">hashsha barra galma isike'n isi'a ergatammaan;</para>
  <para style="q1" vid="REV 7:15">Mootete'n ofo'leekinna ifika dunkaana</para>
  <para style="q2" vid="REV 7:15">insa'ne hana diriisaan.<verse eid="REV 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="REV 7:16" />Ta'anni edi'a insa'ne solo'winaba'a;</para>
  <para style="q2" vid="REV 7:16">konnechchi udumanna dhebowinaba'a.</para>
  <para style="q1" vid="REV 7:16">Arsho insa'nee gandaba'a,</para>
  <para style="q2" vid="REV 7:16">holati duuchchinna insa'ne gubaba'a.<verse eid="REV 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 7:17" />Tinni kaddaachchinna eettene mootexxe oddo'n hedheek</para>
  <para style="q2" vid="REV 7:17">gedhechchi insa'neeke allalsanjo kadaan;</para>
  <para style="q1" vid="REV 7:17">Hedhotike wode'ixxe muummeba'anna insa'ne'e akeekaan;</para>
  <para style="q2" vid="REV 7:17">Mageni indiddo duuchchanna ille insa'neexxenaa'n fiyaan.»<verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s1">Torbeesoke Maxxansixxanna Worqetika Balcho</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />Gedhechchi torbeesoka maxxansa tikee wodda, gamisa saate qico iimate'n cuqqeessi gopheme. <verse eid="REV 8:1" /><verse number="2" style="v" sid="REV 8:2" />Ookkonechchi uduma Mageni edo uurriteexxa eettene torbaane erganna afenne; torbaani malagatinna eettene torbaannixe ergana'n uwweme.<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />Wele iimik erganji werqetike hixaanika balcho aadhe dageexxi tolchimalchi birra uure; eettene moote edo hedheeke worqetike tolchimalchi hana woyyoletixxi soodachchonni welti shiqishaashsha heddi hixaani isi'a uwweme. <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />Ookkone hixaanixxi wiliilenna eettene woyyoletixxe sooddachchonni welti ookkone iimike erganjixxe anga'n Mageniibaa iimi'a fulde. <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" />Iikki iimik erganjinna hixaaniike balcho aadheexxi tolchimalchixxa giira itti wonsheexxi iso'o butti'a darbe; dindinso, luulji, banqonna buttatixxi lele'ma kadde.<verse eid="REV 8:5" /></para>
  <para style="s1">Torbaane Malagatuwwa</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />Ookkonechchi uduma torbaane malagata anga affeexxi torbaane erganna ufuufatee qixxeeffatte.<verse eid="REV 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />Taakessok iimik erganji ookkone malagata ufuufe, munde karsendeexxi kaadena giira buttati'a woccai assende; buttatixxi sakkaxxi anganna gubatte; haqichchuwwinxi sakkaxxi anganna gubatte; quffeemmaxxi bada'a duuchchinna gubbatte.<verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />Langak iimik erganjinna malagata ifika ufuufe, lumoxxa kooba fakkataaxxi yaane giirati ha'ita'n abbaayyate'n hunende; abbaayyatixxi sakkaxxi anganna mundete'n jijjiirende. <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />Eettene abbaayya giddo hexxeexxe hedho affeexxe daduwwanaa'n sakkaxxi anga rerte; lumoxxe hoboluwwanaa'ninna sakkaxxi anga baxxe.<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />Iikki Sakkak iimik erganjinna malagata ifika ufuufe; gooliinsha gubbata'neexxi lumoxxi urje wode'uwwiinxe sakkaxxe anga'ninna wodiinxe muummuwwa'n iimi'n ibe. <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />Eettene urjeki summinna «Qararanjo» hiyyemaan; ookkone wode'ik sakkaxxi anganna qaaraanjoke kadde; wode'i qaranjoke kadatenaa'n kexxeexxa heddi manni reye.<verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />Sholgeessok iimik erganji malagata ifika ufuufe, arshotixxi sakkaxxi anga, agenjixxi sakkaxxi anga, urjuwatixxi sakkaxxi anganna ganende; tennexxee konnelchuwwixxi sakkaxxi anga dukkande; konne qicinni barratinna sakkaxxa anga hashshatinna sakkaxxa anga ifi belo hexxaashsha assende.<verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />Ookoneechchi uduma uudenne; mitti sinbir iimatixxe oddo'n phirri hiyyemman; lumooke haafurinninna «Iitti gatteexxi wele sase erganna malagata ufuufammaxxi buttate'n hedhaakeeri'a aanne'e!, aanne'e! Aanne'e!» hiyyaanaa laqenne.<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />Ondeessok iimik erganji malagata ifika ufuufe; iimi'ni butti'a ibbeexxa urje uudenne; tinne urje'ninna eettene dhi'mo baleexxi qulfe iso'ni uwwende. <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />Eettene dhi'mo balenna banee wodda giddii'n lumoxxe booso giddii'n fuldammaxxe wiliilleshsha hexxeexxi wiliille fulde. Eettene bale giddii'n fuldeexxe wiliillenni arshonna iima dukkande. <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />Wiliille giddii'n awwaanessi fuleexxi buttate'n offo'le; buttattixxe gaadduwwake baalloomishsha hedheeke baalloomi ookkonne aawwanessuwwa'a uwweme. <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />Kunni awwaanessuwwinna buttatixxa bada'a yookaan hoone quffeeka hiddichcho yookaan haqichcho miidhabaashsha, yaane kinni Mageniik maxxanissi alba insa'neeke'n hedhebaaka manna calla miidhaashsha ookkone awwaanessuwwa'n kulende. <verse eid="REV 9:4" /><verse number="5" style="v" sid="REV 9:5" />Insa'nenna kunni awwaanessuwwi onde agenjo miidhaashate malee shiyaashsha baalle konne awwaanessuwwi'a uwwendeba'a; awwaanessuwwikinna majoke'n geessissaaxxe seldo qiilla gammoojje gaaddo idditeexxi manjoke'n idagammaxxe seldoshsha hexxeexxe seldon. <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />Eettene barraara'n manni reyote halsaan, yaane kinni alfaba'a. Reyateenna halchaan yaane kinni reyo insa'nenaa'n bayyatta.<verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />Iikki awwaanessuwwi lolakee qixxeessemeeke fadhado fakkata'emman; umoke'ninna worqetika kallachcha fakkataachcho uggudhe'emman; albikinna majiinke alba fakkata'emman. <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />Umiinki ordichchinna melaalletike umi ordichcho, issotinna neenqiixxe isso fakkaatta'emman. <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />Sibljiinxi qomatixxe seemma fakkaattaaxxa seemma anfe'emman; keeluwwi isikik hafuurinna lolinba'a guulaammake heddo fadhadikenna sarageelliinke hafuura fakkaata'emman. <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />Qiilla gammoojjexxe gaadoxxe eegeshsha hexxeexxa eegenna idditaachcho afee'emman; iittanna manjo onde agenjo seldo idagaaxxi hunna eege isixxe'n hexxemman. <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />Kunni awwaanessuwwinna ifike moyanjo afe'emman; isinna dhi'mo balleke ergajon; summi isikinna Ibirayisixike afo'inni «Abadoon» iittanni Giriikikenninna «Aphpholiyoon» hiyyemaan.<verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />Taakkaxxi aannee! Saxxe'een; kunnise ta'anni udumi'a lame aannuwwa daggaan.<verse eid="REV 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />Jiyaki iimik erganji malagata ifika uufuufe; Mageni edo hexxeexxxe worqetike tolchimalchike gaafuwwinaa'n hafuuri daga'naa laqennen. <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />Kunni hafuurinna malagata afeeke jiyake iimke erganjo'n, «Lumoke Eefiraaxisike galaana'n usurendeexxa eettene shoole erganna tiki» hiyye. <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />Manjiinxe sannenaa'n sakkaxxa anga shinaashsha, tenne sa'ate'anna barra'a iittanni konne agenji'anna wogga'a qixxessemeexxi hedhemmakiir tenne yanna'anna tenne barra'a, konne agenji'anna tenne wogga'a qixxesende hexxemmaxxi iitti shoole erganna tikende. <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />Ookkone fadhadinke sannachchik laakkossi lame dhibba miloonemman; aninna laakkossa konne fadhadika laqenne. <verse eid="REV 9:16" /><verse number="17" style="v" sid="REV 9:17" />Anxe leellanni afenek fadhadininna hana gulfeemmak manni konnechchi butta hedheeshsha hedhemman: konne gulufemmake mannixxe qoma'n hexxeemmaxxi sibljiinxe seemma giiratishsha diimooxxe, yaakinet hiyyemaake fiixa kinjishshanna iimatixxe bifaxxe, diine hiyyeme ye'emak gubaak kinjishsha we'lite bifa fakkataa'emman; ookkone fadhadiink uminna neenquwwiinke umo fakkata'emman. Ookkone fadhaduwwike afo'uwwinaa'ninna giira, wiliillenna diine hiyyemaak fiixi kinji fula'emman. <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />Konne fadhaduwwike afo'inaa'n fuldeexxe sase balanaa'n tinninna girat, wiliillenna diine hiyyemaake fiixi kinjinni manjinxi sannexxa sakkaxxi anga shiyende. <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />Tinni kaddeechchinna konne fadhadixxi hunna afo'oke'ninna eegete'n hexxemman; eegetinna bofa fakkaata'emman; kunni fadhaduwwi umuwwa affeemmaxxe miidhensha geessissa'emmaki konne ummuwwinnitemman.<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />Tenne balaarini sheyemebaak gateek manni ta'anna ifixxe angaxxe hujenaa'n hingeexxi ta'anna aadde angeba'a; fuggichcha hafuuruwwa iittanni uuda yookaan laqa yookaan me'a dande'abaaka worqetika, biretike siljika, sageettotike sibljkaa, kinjinkanna haqichchiinxa fakkuwwa magenooffachcho waaleba'a. <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />Iittanni insa'ne manjo anga sa'atenaa'n, morotixxe hujenaa'n, yabaabulletixxe battomanaa'n yookaan mooriinxe hujenaa'n aadde angebaan.<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s1">Iimika Erganjonna Ookkone Shiixxoka Mirqisanjo Maxaafa</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />Ookkoneechchi uduma weli worbi iimik erganji duumancha oddo'weexxi iimii'n dirraa wodda afennen; isinna ifike umi iimii darre dowwichcho afe'emman; albi isik arshotishsha, lekkuwwa isixxi giiratike utuphuwwishsha hexxemman. <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />Anga ifixxe'ninna banemeeka mirqisanjo shiixoka maxaafa afeemman; middixxi isixxi lekkanna abbaayyate'n bita'ixxa isixxa lekkanna buttate'n uggudhdhe. <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />Baroodaake neenqishshanna hafuura gikk asse cance; cance'exxa yanna torbaane dindinsoki hafuuruwwinna haasoe'e. <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />Iitti torbaane dindinso haasotee wodda borreessona'a qixxeeffatenne; yaane kinni «Torbaannixxi didinso haasotemmalcho maxxansik cufi malee'e borreessitoxxe» hiyyaaka haaso'a iiminaa'n laqenne.<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />Ookkonechchi uduma abbaayyate'ninna buttinake'ni uurre'naa afennak iimik erganji middixxa ifixxa anga iimi'a ke'ise. <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />Isinna duuchchin woddanaa'n duuchchi woddi'a hedhaake iimanna ise giddo hedheechcho buttatanna ise giddo hedheechcho abbaayyatanna ise giddo hedheechcho dademmake iso'n kakate. Hiyyenna kakatee qici, «Ta'anni edi'a hekki hiyya hexxeba'a! <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />Yaane kinni torbeesok iimik erganji malagati ufuufemaaxxe barruwwa'n ifika erganjuwwa wabeekko, insa'ne'a ifissemaxxe qixenni Mageniinxi buqo yaane muuxendaan.»<verse eid="REV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8" />Ookkoneechchi uduma iiminaa'n laqennak hafuuri haaroba ane'n, «Missi abbaayyate'ninna buttate'n uurre'eke iimike ergajixxe anganaa'n banemeeka mirqisanjo maaxxaafa adhdhi» hiyye haaso'e.<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />Aninna ookkone iimike ergajiba'a marennexxi, «Ookkone shiixoka mirqisanjo maxaafa ane'ni uwwi» hiyye iso'o qorenne; isinna anee, «Adhdhitettexxi isoo iti, godobaa atikanna qararaanjoke assaan; afo'o atike'n kinni maleminsha xe'maan» hiyye. <verse eid="REV 10:9" /><verse number="10" style="v" sid="REV 10:10" />Aninna ookkone shiixoka maxafa iimik erganjixxe anganaa'n aadhennexxi isoo itenne; isinna afo'o anke'n malebuffa xe'me; itennelchi uduma kinni godobi ank qaraaranjoke kade. <verse eid="REV 10:10" /><verse number="11" style="v" sid="REV 10:11" />Ookkoneechchi uduma ani, «Heddo arduwwixxee, aanchi aanchike mannixxee, gargar hedheeke laagaduwwixxeenna moyanjuwwiixxee haaroba raaga haaso'a atee hassissaan» hiyyemenne.<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s1">Lame Dhugaa Kula</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />Ookkoneechchi uduma shonbooqo fakkataaxxi mikisanjo siqqichcho ane'n uwwendenaa, «Maretettexxi Magniinka galmanna tochi malcho miki; ookko magenooffataakaaranna laakko'i» hiyyemenne. <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" />Yaane kinni gadhika ba'lina kinni waal, isi Ayihudake kadebaake manni'a uwwemeeke kademmaxxee mikkoxxee; insa'ne woyyichcha qachcha shoole tomme agenjuwwa hirbeessinaa'n. <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />Eettene lame anxe dhugaa kula'a hunna uwwannon; insa'nenna yaaddotixxa seemma oddo'wineexxi mitte kumanna lame dhibbanna jaane tomme barra raaga haasonnaan.<verse eid="REV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4" />Insa'nenna buttatike Gootti edo uurraake lame ejersinke haqichchuwwanna lame xassike uggemalchuwwan. <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />Ayyinna insa'nee miidho'a hasoole, giira afo'o insa'neekenaa'n fuldeexxi naaphaa insa'neeka balleessitaan; insa'nee miidho'a hasaak duuchchi reyaak konne qiicinten. <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />Kunni manni raaga haaso'aaka agenjuwwa xeeni ganabaashsha iima cunfo'a baalloma anfe'een; iittanni wodu'uwwa mundete'n jijiiratee hansaaxxa yanna duuchcha buttatanna heene balanni ganno'a baalloma anfe'een.<verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />Dhugaa kula ifixxa bidhineechchi uduma iikki dhi'motenaa'n fulaak biniichi insa'ne'a lolaan; insa'neenna injifataan; insa'neenna shiyaan. <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />Renshi insa'neekinna ookkone lumoke qachchike ba'line'n hunemaan; kunni qachchinna fakkeennik Soodominna Gibtse hiyyemee ye'emeekenna insa'nek goottinna ookko fannisememmabanni. <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />Aanchi aanchike mannanaa'n gosa gosake minnenaa'n laagaddi laagadanaa'ninna gosa gosake ardanaa'n dageek manni rensha insa'neeka sasenna gamisa barra da'wataan. Renshi insa'neekinna moogemabaashsha hoyyaan. <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />Tinni lame wabeekko buttatike manna'n seldo iyendangeemmaxxee buttate'n hedhamaki manni insa'ne'n gelteexxe yaane'a gammande; weli wel'anna uwwa uunaan. <verse eid="REV 11:10" /><verse number="11" style="v" sid="REV 11:11" />Eettene sase barranna gamisi uduma kinni hedhotik hafuuri Magniinbaa'n dageexxi insa'ne'n e'ye; insa'neenna ke'neexxi ifi ifixxe lekkanni uurrine; insa'nee daa'wataammake manna'ninna lumoxxi soda'a insa'ne abidde. <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />Ookkoneechchi uduma, «Kaba iimi'a amme!» hiyyaaka lumooka hafuura iimatenaa'n lanqe; naaphi insa'nekinna insa'nee uuda'naa'n duumanchik iimi'a me'ine. <verse eid="REV 11:12" /><verse number="13" style="v" sid="REV 11:13" />Eettene yanna'n lumoxxi buttatixxi lele'ma kadde; ookkone qachchixxi tommixxi anga ibbe; eetene lele'ma'ninna torbaani kumi manni reye; reyotenaa'n gateekiriinaa lumooshsha sodaante; iimike Mageni'anna ulfinna uune.<verse eid="REV 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14" />Iitti langaxxi aanenna sa'xxe'een; kunse sakkaxxi aanne rakkee daggaan.<verse eid="REV 11:14" /></para>
  <para style="s1">Torbeessoka Malagata</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />Torbeessok iimik erganji ifika malagata ufuufe; iiminaa'ninna, «Butta duuchchixxi mootumma Gootta no'okixxenna Kiristoosi'i isikixxe kadde; isinna duuchchi woddinaa'n duuchchi woddi'a moyaan» hiyyende. <verse eid="REV 11:15" /><verse number="16" style="v" sid="REV 11:16" />Magenii edo ifi ifixxe mootuwwa'n ofoldeemmaxxi iitti lame tommenna shoole geedhe ifi ifike albinni kumbu hiyye Mageno magenooffanta'n <verse eid="REV 11:16" /><verse number="17" style="v" sid="REV 11:17" />Hitee qici,</para>
  <para style="q1" vid="REV 11:17">«Hexxetekinna hexxa'etak,</para>
  <para style="q2" vid="REV 11:17">duuchchiinxa dandeetatok</para>
  <para style="q1" vid="REV 11:17">Gootta Magenoo! Atee galateeffanta'ennen;</para>
  <para style="q2" vid="REV 11:17">tinni kaddachchinna ati lumoxxe hunna atixxe adhdhitettexxi moote'eten.<verse eid="REV 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18" />Gosa gosak arduwwi mufate'emman;</para>
  <para style="q2" vid="REV 11:18">atixxi mufenna dagge;</para>
  <para style="q1" vid="REV 11:18">Reyeeke manna'n murtatoxxi,</para>
  <para style="q2" vid="REV 11:18">erganjuwwa atike wabeeko'anna</para>
  <para style="q1" vid="REV 11:18">Qulliyyetenna summa atika sodaatakeeri'a,</para>
  <para style="q2" vid="REV 11:18">lumokeenna shiixarammake'e hira uutatoxxi,</para>
  <para style="q1" vid="REV 11:18">Butta balleessemmakaaranna balleessitatok bari dage.»<verse eid="REV 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />Ookkoneechchi uduma iima hedheek Magenik galmi baneme; galmi giddonna kakotik taabot leelle; xassiink uggemalchi, hafuuri, dindinso, buttatixxi lele'manna lumoxxi kaade kadde.<verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s1">Manjichchotanna Eettene Jawwe</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />Ookkoneechchi uduma lumokinna maso beessissi iimate'n leelle; arishsho oddo'witeexxi agenjokanna lekka ifixxi hunda hexxeexxinna ifike umi hananna tommenna lame urjuwwa afeeka kallachcha uggudhiteexxi mitte manjichcho leelite. <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />Isenna siila'witeemmaxxemman; ildo'a ciniintot rakkatte raarte. <verse eid="REV 12:2" /><verse number="3" style="v" sid="REV 12:3" />Ookkoneechchi uduma weli beessissi iima leelle; kunnise torbaane umuwwanna tomme gaafuwwa affe'emmaxxi, ifike umuwwa'ninna torbaane kallachchuwwa uggudhiteemmaxxi diimoxxi jawwe leellite. <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />Isexxi eegenna urjuwwatixxa sakkaxxa anga iimi'n butti'a harkise ibisse; iitti manjichcho ildaa wodda belto iseka liqinsto'a hasseexxi iitti jawwe eettene ildammaxxe manjochcho edo uurrite. <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />Arduwwa duuchcha sibljiinxe siqichchonni galchaaka labbaka belto ilde; beltikinna Mageniinba'anna Magenixxe mooteba'a iimi'a adhdheme. <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />Iitti manjichchonna mitte kumanna lame dhibbanna jaane tomme barra ise la'isendo'a Mageni ise'a qixxeessexxee bakkaba'a qiilla gammoojjeba'a baajje.<verse eid="REV 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7" />Iimate'ninna loli kade; Mika'eelinna isixxi erganna eettene jawwen lolemme; jaweetinna isixxi erganna wirri assite Mika'eellinna isixxi erganna lolde. <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />Yaane kinni iitti jawwenna isexxi erganna injifatemmeexxi iimate'n anfemmaxxa bakkanna gonphe. <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" />Iitti lumoxxi jawwe, olmik bofi huneme: isinna daabiloosi yookaan seexana hiyyeme ye'emeeke butta duuchcha dedhisaaken; isinna butti'a huneme; isixxi ergannanna isinni welti hunende.<verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />Ookkoneechchi uduma lumok haaso'i iimi'n hiyya'naa laqenne qici,</para>
  <para style="q1" vid="REV 12:10">«Kunnisee! No'oke Magenixi anjira hunnanna mootumma,</para>
  <para style="q2" vid="REV 12:10">isike Kiristoosik baallominna dage'een.</para>
  <para style="q1" vid="REV 12:10">No'oke dayyuwwiki ku'lanji</para>
  <para style="q2" vid="REV 12:10">hashsha barra Mageno no'ok edo insa'nee ku'laaammak</para>
  <para style="q2" vid="REV 12:10">ibe'een.<verse eid="REV 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 12:11" />Insa'ne ookkone gedhechchixxe munden,</para>
  <para style="q2" vid="REV 12:11">ifixxe dhugaa kulake hiyyichchinni</para>
  <para style="q2" vid="REV 12:11">iso'o injifante;</para>
  <para style="q1" vid="REV 12:11">Reyoti qico'n midde</para>
  <para style="q2" vid="REV 12:11">lubbo ifixxa ginbe.<verse eid="REV 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 12:12" />Tennexxee tee iimmuwwa</para>
  <para style="q2" vid="REV 12:12">koo isse giddo hexxineekeera,</para>
  <para style="q1" vid="REV 12:12">Gammadde;</para>
  <para style="q2" vid="REV 12:12">buttateenna abbaayyatee aanne'e, tinninna kaddeechchi duriisi heenok bari calli</para>
  <para style="q1" vid="REV 12:12">Gatteexxa ege'nemmaxxee</para>
  <para style="q2" vid="REV 12:12">jabaxxe mufenni butti'a ha'nobaia dirre'een.»<verse eid="REV 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />Jawwe iittinna butti'a hunemeexxa affeexxi eettene labbaka belo ilde'mmaxxa manjichcho shorrishe. <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />Manjichchotinna qiilla gamoojje giddo ise'a qixxessendemmaxxe bakkaba'a phirri hite me'itaashsha lumoke sinbiriink lami keeli ise'a uwweme; tinni kaddeechchinna bofakenaa'n bayyateexxi barokee, baruwwakeenna bariinke gamisi'a la'isendaashshaten. <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />Iikki bofinna manjichcho wodi'ik adhdhendaashsha galaaniishsha hedheeka wode'e afo'okenaa'n tufe. <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />Butta kinni manjichcho qarqaarite; afo'okanna haani hiteexxi iitti jawwe afo'o haani hitte tufemaka wode'e liqiinsite. <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />Jawwetinna eettenee manjichchote'n mufatteexxi isexxe wele oosenni lolendo'a me'ite; tinninni oosenna Mageniinka ajajuwwa heqedhaakeeranna Yessuusixxa dhugaa kula duudheexxi abixekeeran; <verse eid="REV 12:17" /><verse number="18" style="v" sid="REV 12:18" />Iitti jawwenna abbaayyati qarqara uurrite'eman.<verse eid="REV 12:18" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s1">Abbaayyatenaa'n Fuleeka Biniichcha</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />Ookkoneechchi uduma mitti biniichchi abbaayyatenaa'n fulaanaa afenne; isinna tomme gaafuwwanna torbaane umuwwa afe'emman; gaafuwwake'ninna tomme kallachchuwwa, umoke'ninna yowwichchiinke summuwwa afe'emman. <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />Kunni afennek biniichchinna qeedhanchake fakkaata'emman; yaane kinni lekkuwwa isixxi dibi hiyyemaa biniinchchixxa, afo'i isikinna neenqiinke afo'o fakkaata'emman; jawwetinna ifixxa hunna ifixxa moote, iittanni ifika baallooma ookone biniichchi'a uute. <verse eid="REV 13:2" /><verse number="3" style="v" sid="REV 13:3" />Ookkone biniichchike ummuwwanaa'ni mitteke'n reyotee'e geessissaaxxa mada afe'eeke fakkaata'emman. Yaane kinni itti isoo reyotee geessissaaxxa mada fayyite'na'a butta duuchchinna saadinoti isoo hordoffe. <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />Mannikinna eettene jawwe'a kumbu hiyye; tinni kaddeechchinna baallooma ifika ookkone biniichchi'a uuetemmaxxeeten; ittanni biniinchcha konne fakkaataak ayyete hedhe? Iso'o dande'e lolaak ayyete? Hinaa'n ookone biniinchchi'a kumbu hine.<verse eid="REV 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5" />Ookkone biniinchi'anna ifi dukatikanna yowwichchiinka hiyyichcho haaso'atik afo'i isi'a uwweme; shoole tommenna lame agenjuwwa baalloomik hujaashsha isi'a eeti uwwende. <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />Isinna Mageno yowwo'a iittanni Mageniinka summanna isika galduma, iimate'n hedha'neekaaranna yowwo'a afo'o haan hiiyye. <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />Qulliyye lola'n insa'ne injiffato'a hunna isi'a uwwende; gosa gosatike mine'n, gargar hedheeke laagaduwwa'ni, aanchi aanchike manna duuchcha'ni baalloomi isi'a uwweme. <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />Butta duuchchi dadendeexxe yannanaa'n safendeexxi dulemeeke gedhechchike maxaafa'n summi insa'neki borreessemebaak buttatik manni duuchchi ookkene biniinchchi'a kumbu hiyyaan.<verse eid="REV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9" />Laqqaaxxa mansha afeek hedhoole laqowwaal. <verse eid="REV 13:9" /><verse number="10" style="v" sid="REV 13:10" />Ayyinna booji'ematee hedemeek hedhoole isinna booji'emaan; ayyiinna walaantichchik shiyemaak hedhoole isinna wolaantichchik shiyemaan; tinninna qulliyyetixxi ossanna amana leellitaak te'ne'nite kaddeexxa kokeessitaan.<verse eid="REV 13:10" /></para>
  <para style="s1">Buttatenaa'n Fuleeka Biniincha</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />Ookkonechchi uduma weli biniinchi buttinni giddii'ni fulaa'naa afene; isinna gedhebiinsha lame gaafa afeeman; yaane kinni jawwetishsha haaso'a'emman. <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />Isinna ookkone edike biniinchinke summinni wo'ma baalloominni huja'nemman; buttatinna ise giddo hedhemalchi duuchchi, isoo reyotee geessassammaxxe madanaa'ni fayyemmaka ookkone edi woddika biniincha magenooffantaashsha asse. <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />Kunni langaki biniinchi manni duuchchi edo giira iimi'ni buttate'n dirrisaa qico'ni lumollamma beessisuwwa asse. <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />Edisemmake biniinchik summinni beessisuwwa assaashsha baalloomi'a isi'a uwwemaaxxee buttate'n hedhemmaka manna duuchcha dedhise; wolaatichchikinna mado'eexxi fayyemmake ookkene biniinchike ulfinni'a misile giissinaashshanna insa'ne ajaje. <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />Iittanni langake biniinchixxe misile'a hedhotika hafuura uwwaashsha baalloomi isi'a uwweme; isi'a baalloomi uwwemeechchinna iitti misile haaso'a dandeto'anna isi'a kumbu hiyyabaaka duuchcha shiyemmaashsha assateeten. <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />Iittanni lumollinna shiixarri dureeyyetinna hiyyeeyye, goottuwwikinna garbuwwi duuchchi ififexe middixxe anga'ni yookaan xabanake'n beessisa uggudhaashsha insa'ne'n hunnate. <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />Tinninna kaddeechchi ookkone biniichik beessisi kunninna summi isikikenna iseke summik laakkossa afebaaka huuni manjinna hidhdha gurgudhdha dande'abaashshaten. <verse eid="REV 13:17" /><verse number="18" style="v" sid="REV 13:18" />Tinni beekkuma laqqaaxxe; sammo afeek huuni manjinna ookkene biniichchika laakkossa laakkowwaal; tinninna kaddaachchi kunni laakkossi manjinke kademmaxxeeten; kunni laakkossinna jaane dhibbanna jaane tommenna jaaneken.<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s1">Ookkoene Gedhechchonna Ookkone Mitte Dhibbanna Shoole Tommenna Shoole manna</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />Ookkonechchi uduma afenne kunnise iikki gedhechchi Tsiiyoonnixxe kooba'n uurre'emman; isinni welti summi isikinna isike Annik summi insa'exxe xiyyo xiyyo'ni borreessememmak mitte dhibbanna shoole tommenna shoole kuma manna hedhemman. <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />Iiminaa'ni lumoxxe gootoke luuljishshanna lumoxxe dindinsoshsha hedheeka luuljo laqenne; kunni laqennek luuljinna bagana ganammak manni ganammake luuljishsha hedheekemman. <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />Insa'nenna eettene moote edonna eettene shoole hedhotixxe daduwwa edonna iittanni eettene geedhe edo haaroxxa faaro faarsine; buttatenaa'n wodemeeke ookkone dhibbanna shoole tommenna shoole kumi manni gadhi darre tenne faaro ayyinna barata dande'ebaan. <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />Insa'ne melaalleti ifi battonsebaake mannan; ifixxa ca'unte heqqene'een; insa'ne iikki gedhechchi me'aaba duuchcha isoo hordonfaan; Magenokeenna ookkone gedhechchi'a angafoole kandaashsha manji giddii'n wodemeeke mannan. <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />Afo'o insa'neeke'n mitti dharinna afemebaan; mitti ci'minaachinna insa'nen hedhebaan.<verse eid="REV 14:5" /></para>
  <para style="s1">Eettene Sase Iimixxa Ergannaxxa Erga</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />Ookkonechchi uduma weli iimik erganji iimii'n phirri hiyye me'aa'naa afennen; isinna buttate'n hedhaake gosa gosatike mini'a, gargar hedheeke laagaduwwi'a, aanchi aanchike manna duuchchi'a lallanbaaxxa duuchchi woddixxa wengeele abixxeemman. <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />Isinna hafuura gikki asseexxi, «Mageno sodaatte! Ulfinnakanna isi'a uwwe; murtetixxi yanna galte'een; iimmanna butta abbaayyatanna wodi'iinxa muummuwwa duuchcha dadeekee kumbu hiyye» hiyye. <verse eid="REV 14:7" /><verse number="8" style="v" sid="REV 14:8" />Weli langak iimik erganjinna, «Ardi duuchchi ifixxe yabaabulexxe mufetixxa booka ha'waashsha assitemmaxxi lumoxxi Baabiloon, ibbe! Ibbe!» hiyya'ni isoo hordofe.<verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />Weli sakkak iimik erganjinna hafuura gikki asse ookkone lame iimika erganjuwwa hordofa'n hiyyee qici, «Ayyinna ookkone biniinchi'anna misile'a kumbu hiyyaak, beessisa isikanna angate'n yookaan xiyyote'ni uggudhaak hedhoole, <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />isi kinni mittilchinna makemebaaka isixxe mufexxe buuda giddo wo'miteexxa Mageniinxe mufexxa booka ha'waan; eettene qulliyye erganna edonna ookkone gedhechchi edo giirate'ninna gubbaaxxe diinne hiyyemaake gubaake kinjinni rakko adhdhaan. <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />Insa'neexxe rakkoxxi wiliilleenna duuchchi woddinaa'n duuchchi woddi'a iimi'a tuqu tuqu hitaan; ookkene biniinchi'anna isixxe misile'a magenoonfataakiir yookaan isike summika beessisa adhdhaakiir duuchchi hashsha barra hafuura adhdha hexxaba'a.»<verse eid="REV 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12" />Mageniinka ajajuwwa heqqedhaakiirinna Yessuusinna amanati ossate'ni jabaataaxxe woyyoole ege'nedaak tennenniten.<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />Ookkonechchi uduma, «Ta'inni edi'a Goottake'ni hedhe reyaakiir eebbisemeeken hitettexxi borreessi» hiyyaaka haaso'a iiminaa'n laqenne.</para>
  <para style="p" vid="REV 14:13">Hafuurikinna «Eeti elotenaa'n» hafuura adhdhino'a «ifixxi huje insa'nee hordofaan» hiyyaan.<verse eid="REV 14:13" /></para>
  <para style="s1">Buttatixxa Haamatixxa Maye</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />Ookkonechchinni uduma uudennen, kunnise ani edo golalook duummachi hedhemman; isi hananna Manjiinka Belto fakkataak ofo'leemman; isinna umoke'ni worqetika kallachcha uggudheexxi qaraxxa haanto anga afeemman. <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />Weli iimk erganjinna woyyichchi Galmi giddii'n dageexxi duummachii hana ookkone ofo'lemmake'e «Haamatixxi yanna geltemmaxxee atixxa haanto adhdhitetexxi haami; buttixxi haamatixxi maye gelte'een» hiyya'n hafuura gikki asse haaso'e. <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />Tennexxee iikki duumanchake'n ofo'leemmaki haanto ifixxa butti'a wocci asseen; buttatinna haamende.<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />Weli iimik erganjinna iimate'n hedheeke Galminaa'n fule; isinna iittanni qaraxxe haanto afeemman. <verse eid="REV 14:17" /><verse number="18" style="v" sid="REV 14:18" />Giirate'n baallooma afeek weli iimik erganji tolchimalchokenaa'n fuleexxi eettene qaraxxa haanto afeeka «Rodde raxxemmaxxee atixxa qaraxxa haanto adhdhitetexxi buttate'n hexxeexxa woyinetixxa rodde bukki assi» hiyya'ni hafuura gikki asse haaso'e. <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />Iikki iimik erganjinna eettene ifixxa haanto butti'a wocci asse; buttatixxe woyinexxa rodde bukki asseexxi lumoke Magenixxe mufexxa woyine miincammaxxe bakka'ni insa'nee hune. <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" />Iitti woyinna ookkone qachchi gadho woyinetixxe miicenshaxxe bakka giddo hirbeesende; woyintixxe miicenshaxxi ejuma fadhadiinke bixaali qico'n geyaak qeerrinnikinna sase dhibba kiilo meetire qico geltaaxxi munde eettene miicatixxe bakkanaa'n fulde.<verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s1">Torbaane Ergannanna Torbaane baluwwa</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />Wele lumokanna maso beessissa iimate'n afenne; eettene udumixxa heddo bala afeexxa torbaane erganna afenne; iitti udumixxe hiyyendeexxi Mageniixxi mufe muuxenda'neek tenne heddo bala darre'nite kaddemmaxxeeten.<verse eid="REV 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2" />Giirati welti makendeexxa daa'witetixxa abbaayya fakkaattaaxxa afenne; abbaayyati qarqaranna biniincha, isixxa misilenna isike summika laakkossi injifateekaara uurree'naa afennen; insa'nenna Magenokena'n insa'ne'a uwwemeeka bagana abixxineexxi, <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />Mageniinke garbichcho kadeemmake Muusexxa faaronna ookkone gedhechchiixxa faaro hina'n faarsinaamma qici,</para>
  <para style="q1" vid="REV 15:3">«Duuchchinxa dandeettattok Gootta Magenoo!</para>
  <para style="q2" vid="REV 15:3">huje atixxi lumoxxenna sadendaaxxenni;</para>
  <para style="q1" vid="REV 15:3">Bari duuchchike moyanjoo</para>
  <para style="q2" vid="REV 15:3">atik ori qullumatenna dhugaaten.<verse eid="REV 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4" />Koo Goottaa! Ate sodaatabakinna</para>
  <para style="q2" vid="REV 15:4">summa atika ulfeessabaak ayyete?</para>
  <para style="q1" vid="REV 15:4">Ati calli woyyichchaken;</para>
  <para style="q1" vid="REV 15:4">Qullumma atixxixxi huje leellitemmaxxee</para>
  <para style="q2" vid="REV 15:4">arduwwi duuchchi dagaan;</para>
  <para style="q1" vid="REV 15:4">Ati edonna magenoffataan.»<verse eid="REV 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />Ookkonechchi uduma uudenne; yoona dhugaa kulatike duunkaana kadeeki iima hedhemmak Woyyichchi Galmi baneme. <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />Torbaane bala anga abixxiteemmaxxi iitti torbaane erganna Galmi giddii'ni fulde; insa'nenna layinootixxa luqqitte calalaqaaxxe seemma oddo'witeexxi qoma ifixxenninna worqetika sabbata ka'lteemman. <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />Ookkonechch uduma ookkone hedho affeemmaxxe daduwwa giddii'n mitti duuchchi wodddinaa'n duuchchi woddi'a hedhaake Mageniinxi mufe itti wo'miteeka torbaane worqetixxa buuduwwa eettene torbaane erganna'n uwwe. <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />Iikki Galminna Mageniinke ulfinninna isixxi hunna fuldeexxe wiliillenni wo'me; eettene torbaane ergannak torbaane bala muuxenda qico'n ayyinna Galmi giddi'a e'yaa dande'abaan.<verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s1">Torbaane Mageniinxe Mufexxa Buudu</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />Ookonechchi uduma eettene torbaane erganna'a, «Martineexxi eettene torbaane Mageniinxe mufexxa buuda buttate'n dhangalaasse» hiyyaaka lumoka hafuura Galmi giddi'ni ani laqenne.<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />Taakak iimik erganji abideemmaxxa buuda buttate'n dhangalaase; ookkene biniinchika beessissa adhdhemmakeera'ninna biniinchixxe misile'ni kumbu hiyyamake manna'n fuggoshsha rakkissaaxxi mada fulde.<verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />Langak iimik erganjinna abidemmaxxa buuda abbaayyate'n dhangalaase; abbaayyatinna reyeeke manjishsha munde kadde; abbaayyatenni hedhechchi lubbo afeechchi duuchchi reye.<verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />Sakkak erganjinna abidemmaxxa buuda galaaniwwake'inna wodiiinxe muummuwwa'n dhangalaase; kunnichchuwwinna munde kade. <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />Ookkone uduma wode'uwwake'n baallooma afeek iimik erganji hiyya'naa laqennee qici,</para>
  <para style="q1" vid="REV 16:5">«Hexxetekinna hexxeetake koo woyyichcha</para>
  <para style="q2" vid="REV 16:5">iitta murtetaxxee</para>
  <para style="q1" vid="REV 16:5">Ati qullichchaken.<verse eid="REV 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 16:6" />Insa'ne woyyoletixxanna qulliyyetixxa munde dhangalaansemmaxxee;</para>
  <para style="q2" vid="REV 16:6">munde insa'nee ha'wisseten; tinni insa'ne'a hasissaaxxen.»<verse eid="REV 16:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="REV 16:7" />Iittanni ookkone tolchimalchinaa'n;</para>
  <para style="q1" vid="REV 16:7">«Ee, duuchchinxa dandetattoke Gootta Magenoo!</para>
  <para style="q2" vid="REV 16:7">Murte atixxi dhugaatenna qullummaten» hiyya'n haaso'aka ye'injo laqenne.<verse eid="REV 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />Sholgak iimik erganji abidemmaxxa buuda arshote'ni dangalaase; arshotinna manjo giirati gubbaashsha ise'a hunna uwwende. <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />Mannikinna jabake holatinni gubate; tenne baluwwa'ni baallooma afeeka Mageniinka summa yowwinee malee aadde angeba'a; ulfinnakanna isi'a uuneba'a.<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />Ondik iimik erganjinna abidemmaxxa buuda ookkone biniinchinxe moote hana laase; ookkone biniinchixxi mootummatinna dukkande; mannikinna abarakenaa'ni kexxeexxa arrabo ifika corqedhaa'emman. <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />Iittanni insa'ne seldonaa'ninna insa'nexxe madaa'n kexxeexxinni iimika Mageno yowwinee malee'e ifixxe hujexxe aadde angaba'a.<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />Jiyak iimik erganji abidemmak buuda lumoke Eefiraaxisike galaana'ni dhangalaase; borotenaa'n dagaake moyanjuwwi'a ori qixxeessatee ookkone galaanik wodi'i bage. <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />Ookkonechchi uduma eettene jawwetike afo'inaa'n, ookkone biniinchinke afo'inaa'ninna dharichchi wabeeka afo'inaa'n raachcha fakkaataak sasi fuggichchi hafuuruwwi fulaa'na'a afenne. <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />Tinniirinna beessissuwwa assitaaxxe fuggichcha hafuuruwwan; duuchchinxa dande'aake Mageniinxe lumoxxe barra'n kadaake bagdi'a manna bukki assito'a butta duuchchike moyanjuwwiba'a me'inaan.<verse eid="REV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15" />«Kunnise ani moodhalchishsha dagannon; duwwi gatabaashshanna saala ifika leellabaashsha dammaqeexxi seemma ifixxa heqqedhaak manji eebbisemeeken.»<verse eid="REV 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16" />«Ookkonechchi udma iikki fuggichchi hafuuruwwi moyanjuwwa Ibirayisixiken laagadinni Armaagedoon hiyyendaaxxe bakkaba'a bukki asse.»<verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />Torbaak iimik erganjinna abidemmaxxa buuda ayyeerte'n dhangalaase; ookkone Galami giddo hexxemmaxxe eettene mootenaa'n «Muxende» hiyyemmeek lumok hafuur fule. <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" />Ookkenechchi uduma banqo, luulji, dindinsonna jabaxxi buttatixxi lele'ma kadde; manji buttate'n dademeexxe barranaa'n iitta hexxeexxi buttatixxi lele'ma kadde egendeba'an; isenna lumoshsha bira saxxeexxemman. <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />Lumok qachchinna saseba qoodeme; arduwwink qachchuwwinna diigeme; Magenikinna eettene lumoxxa Baabiloon qaabate; ise'ni jabaxxe mufenni wo'miteexxa bookatixxa buuda uwwe. <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" />Oddooluwwa duuchchanna baaje; koobuwwatinna afendeba'aan. <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" />Kiilote'ninna mikendoole shoole tommenna onde kiilo giraama kaddaaxxi jabaxxi kaade iimatenaa'n manjoke'n ibbe; tinni balanna hara lummoshsha rakkissaaxxe kaddemmaxxee mannikinna iitti kaade geessisseexxe seldonaa'n kexxeexxa Mageno yowwe.<verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s1">Yabaabulto Manjichchonna Biniicha</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />Eetenne torbaane buuduwwa anga afeemmake iimike erganjuwwanaa'n mitti dageexxi ane'ni hiyyee qici, «Amo heddo wodu'uwwa'n hana ofolde'emmaxxe lumoxxe yabaabulto manjichchoxxa murte ate'ni leellishannon. <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />Buttatiki moyanjuwwi isenni welti yabaabuleen; buttate'n hedhemmakiirina isexxe yabaabullexxee woyinetixxe bookanni machchoone.»<verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />Ookoneechchi uduma iimik erganji Hafuurik qiila gammoojje giddi'a anee imare; ookkonna mitte manjichcho yowwichchink summi itti wo'meexxe torbaane umuwwanna tomme gaafuwwa afeeke diimoke biniincha'n hana ise ofoldeena'a afenne. <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />Iitti manjichchonna baddeesitenna diimoxxa seemma oddo'wite'emman; iittanni worqeti, inquute hinaxxe ulfaattexxe kinonninna hiri fiixxexe kinonni danchessexxeemman; diqachiisaachchonna ifixxe yabaabulaxxi battumma itti wo'miteexxa worqetixxa buuda anga abixxiteemman. <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />Isexxe xiyyo'ni borreesseme'emmak buqok summi hiyyaamma qici, «Tee lumoxxe Baabiloon, yababulluwwixxenna buttatixxe battuwwaxxe ama» <verse eid="REV 17:5" /><verse number="6" style="v" sid="REV 17:6" />Iitti manjichchonna qulliyyettixxe mundenninna Yessuusixxe dhugaa kuluwwaxxe mundenni machchote'naa afenee; ise afenne woddanna lumoshsha mambe'a hiyyenne. <verse eid="REV 17:6" /><verse number="7" style="v" sid="REV 17:7" />Ookkoneechchi uduma iikk iimik erganji anee: «Mambe'a hitaattelchi mayeete? Tenne manjichchoxxa buqo yaanenna ise itti hana ofoldemmakika, iittanni torbaane umuwwanna tomme gaafuwwa afeemmakike ookkene biniinchixxa buqo yaane ate'ni kulannon. <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" />Iikki afettak biniinchi edonni hedhemman ta'a kinni hedhebaan; uduma dhimo balenaa'n fulaan; ba'netibaanna me'aanni; butta duuchcha dadendeexxe yannanaa'n insa'ne summi hedhotike maxaafa'n borreessemee leellabaak buttatik manni iikki biniinchi edonni hedheeke ta'a kinni hedhebaake uduma dagaake kaddeexxa undaa wodda manba'a hinaan.<verse eid="REV 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9" />«Beekkuma affeexxi sammo hasendaaxxi iitee woddan; iikki torbaani umuwwi iitti manjichcho itti ofoldaaxxe torbaane koobuwwan. <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />Tinni koobuwwanna torbaane moyanjuwwan; ondi ibe'een, mitti hedheen; weli ta'i qico dageebaa; dagaa wodda kinni turaak heenoxxe yanna'aaten. <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />Edo hedhemmakinna ta'a hedhebaak iikki biniinchi saddeetike moyanjon; isinna ookkone torbaanenaa'n mitteke kadaa wodda, ba'netiba'a me'aan.<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />«Iikki affeettak tomme gaafuwwi mooyebaake tomme moyanjuwwan; yaane kinni ookkone biniinchinni welti mitte saate moonashsha iikki moyanjuwwi baallooma adhdhaan. <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />Kunni tommi moyanjuwwinna mitte yaada anfeen; hunna ifixxanna baalloma ifika ookene biniichi'a uunaan. <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />Kunni moyanjuwwinna gedhechcho ookkene lollaan; gedhechchi kinni konne moyanjuwwa injifataan; tinninna kaddachchinna isi goottoletike Goottanna moyanjuwwinke moyanjon; isinni welti hedhe hedhemmakiir ye'ememmakiir filememmakiirinna xuurameessake kadeemmakiir isinni welti injifataan.»<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />Iiki iimik erganjinna hiyyee qici, «Iitti yaabaabulto manjichcho itti hana ofolde'naa affettak wodu'uwwi, aanchi aanchik manni, heddi manni, ardikinna gargar gargari afo'uwwa haaso'ammakeeran. <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />Iikki biniinchinna iikki affettak tommi gaafuwwi eettene yabaabulto ginbaan; saalibelonna gatinsa; maala isekanna indaan; giirate'n isee gunbaan. <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />Mageniink hiyyichchi muuxemaa qico'ni yaada ifika muunxo'a iittanni mitte yaada'n weli aangashshanna ififika baaloomuwwanna ookkene biniinchi'a uuno'a konne yaada qalbe insa'neexxi giddo uggeeki Magenoken. <verse eid="REV 17:17" /><verse number="18" style="v" sid="REV 17:18" />Iitti ati affettaxxi manjichcho buttatike moyanjuwwa'ni mootaaxxe ookkone lumoke qachchan.»<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s1">Baabiloonnixxa Iba</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />Ookkoneechchinni uduma jabaka baalooma afe'ek weli lumok iimik erganji iimi'ni dagaa wodda afennen; isike gaachchannanaa'n kexxeexxinni butta wa'a hite iffe. <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" />Iisinna hafuura gikki asseexxi hiyya'ni cancee qici, «Iitti Lumoxxi Baabiloon ibbe! Ibbe!, Fuggoke hafuuruwwi galdumi, battuwwati hafuuruwwi duuchchi irko, battuwwatixxinna diqachchiissaaxxe ci'uwwa duuchchike galduma kadde. <verse eid="REV 18:2" /><verse number="3" style="v" sid="REV 18:3" />Arduwwi duuchchi isexxe yabaabulexxee mufetexxa woyinetixxa booka ha'wemmaxxe buttatik moyanjiwwi isenni welti yababule'een; buttatixxi daddaltonna isexxe danqasha galanaa'ni kexxeexxa duronde'een.»<verse eid="REV 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />Ookkone uduma iiminaa'n weli haaso'i hiyya'naa laqenne,</para>
  <para style="q1" vid="REV 18:4">«Anke arda isexxe cubbonni mittondinabaashsha</para>
  <para style="q2" vid="REV 18:4">isexxe balanaa'ninna qoodendinabaashsha</para>
  <para style="q2" vid="REV 18:4">ise giddii'n fulle.<verse eid="REV 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5" />Cubbo isixxe iimi qico'n tuulende'een,</para>
  <para style="q2" vid="REV 18:5">Magenikinna xaqaro isexxa qaabate'een.<verse eid="REV 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6" />Uutemmaxxe qixxe'n badoo ise'a hiissenne;</para>
  <para style="q2" vid="REV 18:6">hujemmaxxe duuchchiinxeenna dachcha'a anga ise'a uwwenne;</para>
  <para style="q2" vid="REV 18:6">makkemmaxxe buuda'n lame anga ise'a makke.<verse eid="REV 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7" />Ise umo ifika ifi ulfeessanna danqasha gala uutemmaxxe qixxen</para>
  <para style="q2" vid="REV 18:7">saldotanna yaaddo ise'a uwwe.</para>
  <para style="q1" vid="REV 18:7">Isenna qalbe giddo hitee qici,</para>
  <para style="q2" vid="REV 18:7">‹Giitettishsha ofo'lenne;</para>
  <para style="q1" vid="REV 18:7">Ani aro'okanna shiwwiteexxe manjobaan› hita'n ifi dukke.<verse eid="REV 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8" />Tennexxee baluwwa mitte barra ise'n dagga;</para>
  <para style="q2" vid="REV 18:8">reyo yaadotinna solo'i ise'n geyaan;</para>
  <para style="q1" vid="REV 18:8">Ise'n muraak Gootti Mageni lumoke kademmaxxee</para>
  <para style="q2" vid="REV 18:8">ise giirate'ni gubattaan.<verse eid="REV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />«Isenni welti yabaabulekiirinna danqasha galeek buttatik moyanjuwwi ise gubataa wodda iimi'a tuqutuqu hitaaxxa wiliille undaa wodda isexxee oo'naan; yaandaan. <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />Isexxa seldonna sodaatiyyot bayya uurrineexxi hinaa qici,</para>
  <para style="q1" vid="REV 18:10">« ‹Koo ati lumoke qachcha ati'a aanne'e! Ati'a aanne'e!</para>
  <para style="q2" vid="REV 18:10">Ati koo Baabiloonike lumoke qachcha</para>
  <para style="q1" vid="REV 18:10">Murte ate'ni mitte sa'aate giddo dage'een› hina'n haasonaan.<verse eid="REV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />«Ifixxe hoboluwwaxxa ba'o ta'inni edi'a insa'nee'ni hidhdhaak hedha gophemmaxxee buttatixxi dadaltonna isexxee ooxxaan, yaadaan. <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />Hoboluwwa insa'nexxe'ni fenemmalchuwwi worqe, birreti sibiljo, hiri fiixeeka kinjo, fiixeek ulfaateek kinji, eloxxa layinotixxa semma, badeesite seemma, haarretixxi seemma, diimoxxa seemma, fishaallo haqquwwa duuchchi, arbiinxe issonna'ni, fiixxa haqqichchuwwina'ni, sageetotena'ninna sibljokenaa'n cabbetike golalook kinjinni hujemeek miyuwwi duuchchi. <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />Qarafa, qurunfuduwwa fishshaaka haqichcho, karbe, hixaani, woyinetixxa booka, ejersiinxa zayite, bulle, dinne, horuwwi, gedhebi, fadhadi, fadhdinxi gaaruwwa, garbuwwinna wele mannaramman.<verse eid="REV 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 18:14" />«Daddaltotinna isee, ‹Ati halchitettexxi elola yaane atenanaa'ni bayyateen; karra atixxinna elolammi atik dancheefachchotik miyi duuchchi ba'edheen; ta'anni edi'a konnelchuwwa hara alfitabexxo› hittaan. <verse eid="REV 18:14" /><verse number="15" style="v" sid="REV 18:15" />Konnelchuwwa duuchcha gurgudhdhitanni isenni duroondeexxi daddalto seldo isixxa sodaateexxi bayyate uurritaan; insa'nenna oonaan; yaandaan. <verse eid="REV 18:15" /><verse number="16" style="v" sid="REV 18:16" />Insa'nenna hafuurakanna gikki assiteexxi,</para>
  <para style="q1" vid="REV 18:16">« ‹Eloxxi layinotixxe seemma, baddeesitenna diimooxxa seemma oddo'witemmaxxi</para>
  <para style="q2" vid="REV 18:16">worqe, fiixa ulfattexxa kinonna dancha inqute hinaak fiixa kinjinni danchoomeemmake</para>
  <para style="q2" vid="REV 18:16">ookkone lumoke qachchi'a aanne'e! Aanne'e!<verse eid="REV 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 18:17" />Iitti karra duuchchi mitte sa'aate giddo baxxeen.›</para>
  <para style="p" vid="REV 18:17">«Hoboluwwatiki ajajalluwwi duuchchi hobuluwate'n me'ammak manni duuchchi hoboluwwate'n abbaayyate'n hujaak hujalluwwi duuchchi bayyante uurrinaan. <verse eid="REV 18:17" /><verse number="18" style="v" sid="REV 18:18" />Ise gubataa wodda tuqu tuqu hitaaxxa wiliille undaa wodda ‹Iitta hedheek lumok qachchi hara haba hedhe?› hina'nee rarraan. <verse eid="REV 18:18" /><verse number="19" style="v" sid="REV 18:19" />Insa'nenna ifi ifike umo'ni buko fiffilxina'n oona'ninna yaandaa'n</para>
  <para style="q1" vid="REV 18:19">« ‹Abbaayyate'ni hana hobolo afeedheek duuchchi</para>
  <para style="q2" vid="REV 18:19">isexxe karranni duromeekiir</para>
  <para style="q2" vid="REV 18:19">ookkone lumoke qachchi'a aanne'e! Aanne'e!</para>
  <para style="q1" vid="REV 18:19">Mitte saate giddo baxxeen.<verse eid="REV 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="REV 18:20" />Tee iima ise hana gammadi!</para>
  <para style="q2" vid="REV 18:20">ha'no woyyoole wabeekonna ergameeyye gammadde.</para>
  <para style="q1" vid="REV 18:20">Ise hoo'ni geessissemmaxxe yaane'a Mageni ise'ni mureen› » hiyye.<verse eid="REV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />Ookkoneechchi uduma mitti lumk iimik erganji lumooka daamiinika kinjo fakkataaka kinjo aadheexxi abbaayyate'n darba'n hiyyee qici:</para>
  <para style="q1" vid="REV 18:21">«Iikki lumok qachchi Baabiloon</para>
  <para style="q2" vid="REV 18:21">iitta hexxeexxe hunnanni darbemaan;</para>
  <para style="q2" vid="REV 18:21">ta'anni edi'a haranga afemabaan.<verse eid="REV 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="REV 18:22" />Bagana gana'neekiirinna sirbiinke mannik hafuuri</para>
  <para style="q2" vid="REV 18:22">suusulletikinna malagata ufuufammake mannik hafuuri</para>
  <para style="q1" vid="REV 18:22">Ta'anni edi'a ati giddo hara laqemaba'a;</para>
  <para style="q2" vid="REV 18:22">angatixxe ogek manni</para>
  <para style="q1" vid="REV 18:22">Ati giddo langaxxa afemaba'a;</para>
  <para style="q2" vid="REV 18:22">daamiik hafuurinna</para>
  <para style="q2" vid="REV 18:22">ta'anni edi'a ati giddo laqemaba'a.<verse eid="REV 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="REV 18:23" />Xassiink ifi</para>
  <para style="q2" vid="REV 18:23">ta'anni edi'a ati giddo hara ifeemabaan;</para>
  <para style="q1" vid="REV 18:23">Waajubichchinkinna waajubichchotik hafuuri</para>
  <para style="q2" vid="REV 18:23">ta'anni edi'a ati giddo laqemaba'a;</para>
  <para style="q1" vid="REV 18:23">Dadalto atixxir lumollamma butta duuchchike mannamman;</para>
  <para style="q2" vid="REV 18:23">atixxe gojonninna arduwwa duuchcha dhedhake'ni ibesse'een.<verse eid="REV 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="REV 18:24" />Ise giddo wabeekkotixxinna qulliyyetixxi iittanni</para>
  <para style="q2" vid="REV 18:24">buttate'n shiyemeeke mannixxi munde duuchchi afende» hiyye.<verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />Ookkoneechchi uduma heddo mannika hafuura fakkataaki lumok hafuuri iimate'ni hiyya'naa laqenne qici:</para>
  <para style="q1" vid="REV 19:1">«Halleeluyaa!</para>
  <para style="q1" vid="REV 19:1">Anjira ulfinnikinna hunna no'oke Magenixxen.<verse eid="REV 19:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="REV 19:2" />Murte isixxi dhugaatenna qullitteten;</para>
  <para style="q1" vid="REV 19:2">Yabaabulle ifixxenni butta battossiteemmaxxa</para>
  <para style="q2" vid="REV 19:2">eettene lumoxxe yabaabulto'n muredeen;</para>
  <para style="q1" vid="REV 19:2">Ifike erganjuwwixxe mundexxee ise'n halo fule'een.»<verse eid="REV 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 19:3" />Ookkoneechchi uduma insa'ne</para>
  <para style="q1" vid="REV 19:3">«Halleeluyaa!</para>
  <para style="q1" vid="REV 19:3">Wililiille isenaa'n duuchchinni woddanaa'n duuchchi woddi'a tuqu tuqu hitaan» hine.<verse eid="REV 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 19:4" />Iitti lame tommenna shoole geedhenna hedho affeemmaxxi iitti shoole daduwwa mootete'n ookkene ofo'leeke Mageni'a kumbu hineexxi</para>
  <para style="q1" vid="REV 19:4">«Ameneen, Halleeluyaa!» hina'ni magenooffantaan.<verse eid="REV 19:4" /></para>
  <para style="s1">Gedhechchiinxe Aadhaxxa Jila</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />Ookkoneechchi uduma,</para>
  <para style="q1" vid="REV 19:5">«Ha'no isi erganjuwwi duuchchi</para>
  <para style="q2" vid="REV 19:5">isoo sodaatinaakiir</para>
  <para style="q1" vid="REV 19:5">Shiixxo lumok</para>
  <para style="q2" vid="REV 19:5">Mageno no'oka saadde» hiyyaaki hafuuri mootetenaa'n fule.<verse eid="REV 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 19:6" />Iittanni heddi mannike ardike hafuurishsha, jirake wodi'ik hafuursha, jabaxxe dindinsoke luujishsha,</para>
  <para style="q1" vid="REV 19:6">«Hallee luyaa!</para>
  <para style="q2" vid="REV 19:6">Duuchchinxa dande'aak no'ok Gootti Magen moyedheen» hiyyaa'naa laqennen.<verse eid="REV 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 19:7" />Ookkone gedhechchixxe aadhaxxi jila gelteemmaxxee</para>
  <para style="q2" vid="REV 19:7">isixxi waajubichchonna ifi qixxessexxemmaxxee</para>
  <para style="q1" vid="REV 19:7">Gammando, ililinso,</para>
  <para style="q2" vid="REV 19:7">isoonna ulfeessinno.<verse eid="REV 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 19:8" />Calacala hitaaxxanna ca'itte</para>
  <para style="q2" vid="REV 19:8">eloxxe layinoxxa seemma oddo'wito'a ise'ni uwwende;</para>
  <para style="q2" vid="REV 19:8">eloxxe layinoxxi seemma woyyooltixxe qullitte hujen.<verse eid="REV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />Iikki iimmik erganjinna anee, «Gedhechchiinxe aadhatixxe jilaba'a ye'eemmekiir eebbisemeeken hite borreessi» hiyye. Isinna lebeexxi anee, «Kunni dhugaatike Magenike hiyyichchuwwan» hiyye. <verse eid="REV 19:9" /><verse number="10" style="v" sid="REV 19:10" />Aninna iso magenooffatonnaa lekka isixxi hunda kumbu hiyyenne; isi kinni anee «Waali tenne assitoxxee; aninna atinni welti, Yessuusixxa dhugaa kula afeeke atike dayyuwwinni welti erganjoken; Mageno magenooffante; Yessuusixxe dhugaa kula raagiinke hafuuran» ane hiyye.<verse eid="REV 19:10" /></para>
  <para style="s1">Golalooke Fadhachcho'n Ookkone Ofo'leekixxee</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />Ookkoneechchi uduma iima banedee'na'a afenne; kunnise mitti golalook fadhachchi hedhemman; faadhachchoke'ni hana xuurameesikinna dhugaatike hiyyememmak itti offo'lemman; isinna qullummati muraan; lolakanna lolaan. <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />Ille isixxi giiratike bubenjishshaten; umo ifiki hannanna heddo kallachchuwwa afe'een; isi gadhi darre ayyinna egenabaak summi isi hana borreesseme'een. <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />Isi mundeti laaqendeexxa semma odho'wedheen; summi isikinna Mageniinke hiyyichchon. <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />Iimmik sannachchuwwi golaloxxa, ca'ittenna eloxxe layinoxxa seemma oddo'weexxi golallamma fadhado'ni ofo'leexxi isoo hordofa'nemman. <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" />Arduwwakanna ganaak qaraki wolaantichchi afo'o isikena'ni fulaan; «Sibljinxe siqqichchonninna insa'nee galchaan» Isi duuchchiinxa dande'aake Lumoke Mageniinxxa jabaxxe aarexxa woyinetixxa miinccammaka hirbeessaan. <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />Seemma isixxe'ninna gudeeda isike'n «Moyanjuwwiinke moyanjinna goottuwwiinke Gootta» hiyyemaak summi borreessemedheen.<verse eid="REV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />Ookkoneechchi uduma mittti iimik erganji arishshoti hana uurre'naa afenne; isinna iima phirri hite me'itaaxxe ci'a duuchchi'a hafuura gikki asseexxi, «Amme eetenne Mageniinxe lumoxxe jilaba'a bukki hiyye! <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />Bukki hitina'neelchinna moyanjuwwiinka maala, bagediinke ajajalluwwika maala, jajjaba mannika maala, fadhadiinkanna fadhado gulufatammake mannika maala, iittanni manni duuchchika kunninna goottuwwiinkanna garbuwwiinka, lumollamiinkanna shiixxeramiinka maala ittino'aten.»<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />Iitanni iikki biniinchi buttatik moyanjuwwi, insa'neeki loliinki manninna golalooke fadhachchi hana ofo'lemmake'ninna isike loliinke sannachchin welti lolakee bukki hinee'naa afenne. <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" />Yaane kinni iikki biniinchi abideme; isinni weltinna isi edo beessisuwwa assa'emmak dharichchi wabeek abideme; konne beessisuwwinni ookkone biniichika beessisa adhdheekaaranna isixxe misile kumbu hiyyeekara dedhake'ni ibisaa'emman. Kunni lamiing hedhoti he'neeshshanni dinneti hiyyemaake ha'yitaamaxxe kinjixxe giiratixxe abbaayya'n hunemme. <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />Weli gatemmak loliink manninna ookkone golalooke fadhachcho'n hana ofo'lemmakike afo'onaa'ni fula'neeke wolaantichchinni shiyemme; ci'a duuchchanna maala insa'neeka itte goddite.<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s1">Kuma Woggaxxa Mootumma</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />Eettene dhimotixxa qulfenna lumooka haachchaba anga abixe'eeki iimik erganji iimatenaa'n butti'a dagaa'naa afenne. <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />Isinna olmika bofa eettenee jawwe ookkonee duriisa yookaan Seexana abideexxi kuma wogga isoo usure. <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />Kuma wogga muddaa qico'ni arduwwa dedhake'ni ibisabaashsha eettene dhi'mo'n isoo huneexxi itti cufe, maxxansakanna itti hana maxxanse; ookkoneechchi uduma heenoxxe yanna'a isi tikema hasissaan.<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />Ookkoneechchi uduma mootuwwa afenne; eettene mootuwwa'ni murte muratee baalloomi uwweme'emmak manni itti ofo'leemman; iittanni Yessuusi Kiristoosixxa dhugaa kulatixxenna Magniinke hiyyichchi'a goobi insa'nek kutemeeke mannixxa lubbuwwa afenne; insa'ne ookkone biniinchi'a yookaan isixxe misile'a kumbu hineba'a; ifike alba'n yookaan ifixxe anga'n ookkene biniinchika beessisa uggudhineba'a; insa'nenna reyotenaa'n ke'neexxi Kiristoosinni welti kuma wogga moone. <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />Weli reyotenaa'n ke'ebaangi gateek kinni kumma wogga mudda qico'n reyotenaa'n ke'neba'a; tinni taakkessoxxe ke'ani. <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />Taakkaxxe ke'a'ni qoodemaak duuchchi eebbisemmeekenna woyyooleten; langaxi reyo insa'ne'n baallooma affebaan; yaane kinni insa'ne Mageniinxenna Kiristoosixxe qeese kandaan; isinni weltinna kuma wogga moonaan.<verse eid="REV 20:6" /></para>
  <para style="s1">Durisiinxa Injifatema</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />Iitti kuma wogga muuxendaa wodda Seexani usurrakenaa'n tikemaan. <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />Shoolinge buttatike kasa'ni hedheeka arduwwa: Googiinna Magoogii'i dedhisa'n insa'nee bagediinbaa bukki asso'a fulaan; laakkossi insa'neekinna abbaayyati qarqara hedheeke maanchishshaten. <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />Insa'nenna butta duuchcha'n fulleexxi qulliyyetixxa kaambenna ookkone eeyyemeeka qachcha bunqe. Yaane kinni giira iimatenaa'n dirrite daggee insa'nee itte. <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />Insa'nee dedhake'n ibisemmak durriis, iikki biniinchinna iikki dharichchi wabeek hedheexxe diinni hiyyemake ha'yaake kinjixxe giirraxxe abbaayya giddo hunemme; insa'nenna hashsha barra duuchchi woddanaa'n duuchchi woddi'a abara uundaan.<verse eid="REV 20:10" /></para>
  <para style="s1">Reyemmake Manna'ni Murte Murende</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />Ookkoneechchi udum lumoxxa golalooxxa mootenna ise hananna ofo'leeka afenne; iimatinna butta hedhatixxi bakka gophendaa qico'ni isi edii'ni baajje. <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />Reyemmaka manna shiixarammakanna lumollama eettene moote edo uurrineena'a afenne; maxaafuwwikinna banemme; weli maxaafinna kuninna hedhotik maxaafinna baneme; reyeek manninna ookkone maxaafuwwa'ni borreessememma qicishsha ifi ifixxe hujeshsha insa'ne'n murende. <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />Abbaayyatinna ise giddo hedhemmaka reyemmaka manna uute; reyotinna reyemmak manni hedhemak buttik wiidi ifi ifi giddo hedhemaka reye manna uune; mitti mittingi ifi ifixxe hujeshsha murte adhdhe.<verse eid="REV 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 20:14" />Ookoneechchi uduma reyotinna reyemaki manni hedhaammaki buttinnii hundik wiiddi giiratixxe abbaayya giddo hunemme; Tinni abbaayyatixxi giiranna langaxxe reyon. <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />Summi isik hedhotike maxaafa'ni borreessemexxi afemebaak duuchchi giiratixxe abbaayay'ni huneme.<verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s1">Haaroxxa Iimanna Butta</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />Ookkoneechchi uduma haaroxxa iimanna haaroxxa butta afenne, iitti siretixxi buttanna siretixxi iima sa'xxe'emman; abbaayyatinna ta'anni edi'a hexxabaan. <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" />Iikki woyyichchi qachchi iitti haaroxxi Iyyerusaalemi ifike aro'i'aa seefateemmaxxe waajubichchoshsha qixxeffateexxi iimi'n Mageniinba'n butti'a dagaa wodda afenne. <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />Iittanni lumok hafuur eettene mootenaa'n hiyya'n fulaanaa laqenne qici: «Kunnise Mageniink galdum manjink weltiten; isinna insa'nenni welti hedhaan; insa'nenna isike arda kandaan; Mageni umo ifiken insa'nenni welt hedhaan; isinna Gootta insa'neeke kadaan. <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />Indiddo insa'neexxa duuchchanna insa'nexxe illetenaa'ni fiyaan; edixxi aadda saxxemmaxxee ta'anni edi'a reyo yookaan yaaddo yookaan oodhishsha yookaan seldo insa'ne'ni hexxabaan.»<verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />Eettene moote hana ofo'lemmak, «Kunnise ani yaane duuchcha haarooxxe assannon» hiyye; higgenni anee, «Kunni hiyyichchi xuurameessakenna dhugaatike kademmaxxee borreessi» hiyye.<verse eid="REV 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 21:6" />Isinna anee hiyyee qici: «Muuxende; Alfanna Oomega, edikinna udumik anten; dhebo'weekee hedhotika wode'e hiri belo isi'a uwwannon. <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />Injifataak duuchchi tenne dhaalaan; Aninna isike Gootta kadannon; isinna anke belto kadaan. <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />Yaane kinni yaruwwi, amanabaakiir, batto'uwwi, manjo anga sa'aakiir, yabaabuluwwi, gojaameeyye, dhariicha magenuwwa magenoofataakiir, dharchchuwwii duuchchiik boonchi diine hiyyemmake ha'yake kinjo'ninna giiratixxe abaayya giddo hunemate kaddaan. Tinninna langaxxe reyon.»<verse eid="REV 21:8" /></para>
  <para style="s1">Haaroxxa Iyyerusaalemi</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />Iitti muuxamiinxi torbaan baluwwa itti wo'miteexxa eettene torbaane buuduwwa anga abixiteexxe torbaane ergannanaa'n mitti daggeexxi ane'e «Amo ookkone gedhechchiinxxe are kaddeexxa waajubichcho ate'ni leellishannon» hiyye. <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />Hafuuriki anee mitte lumoxxe qeerraxxe koobaba'a iyyemareexxi, iikki woyyichchi qachchi Iyyerusaalemi iimatenaa'n Mageniinbaa'n butti'a daggaa wodda anee'n leellishe. <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />Isenna Mageniinke gaachchanninni iffaamman; iseke ifiki wa'inninna hara lumoshsha fixxa kinjo Iyyasiphidishsha daa'witetishsha ca'a hiyyeemmakemman. <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />Tommenna lame huluwwa affeexxa qeerraxxa lumollamma dalla'uwwa affeemman; eettene huluwwa hana tommenna lame erganna uurrite'naa Isira'eelike gosa gosake minike summuwwinna itti borreessemeemman. <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />Borote'ni sase huluwwa middake'n sase huluwwa bita'ake'n sase huluwwa, dhidhimake'n sase huluwwa hexxemman. <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />Ookkonne qachchik dalla'i tommenna lame boosuwwa afe'emman; tenne boosuwwa'ninna tommenna lame ookkone gedhechchixxi ergameeyyeke summa itti borreessemeemman.<verse eid="REV 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 21:15" />Ane'ni haaso'a'n hedhemmak iimik erganji ookkone qachcha, qachchiinxa huluwwanna dala'uwwa mika'emmaxxe worqetixxe zange afeemman. <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />Ookkone qachchik qeerrininna godobi weliqixxete kadeexxi shoole kasikemman; isinna ookkone qachcha zangeti mike; qeerinni isikinna lame kumanna shoole dhibba kiilo meetire kade; godobi isikinna ejumi isik iitanni kadde. <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />Iittanni ookkone qachchika dalla'a mike; qeerinni isikinna ookkone iimike erganjike mika'emmake manjinke mikisanjinni dhibbanna shoole tommenna shoole ciqilemman. <verse eid="REV 21:17" /><verse number="18" style="v" sid="REV 21:18" />Iikki dalla'i ijaaremeemmak Iyyasiphedixxe fiixa kinjinitemman; qachchichikinna daa'witetishsha ca'ateexxe ca'itte worqenni giissemeemman. <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />Qachchichiinke dalla'ixxi boosuwwa duuchchinge bifake fiixeeke kinjinni danchchossende'emman; taakaxxe booso Iyyasiphid, lamngaxxik senpere, sakkaxxik kelqedon, sholgaxxik meregi, <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />ondixxik serdonkis jiyaxxik, serfiyoon, torbaxxik kiristilobee, sadeetixxik, biraale, sallanixxik, werawire, tommixxik kirisphirasisi, tommenna mittessoxxik yakinet, tomenna langaxxik ametesixinositemman. <verse eid="REV 21:20" /><verse number="21" style="v" sid="REV 21:21" />Temmnenna lamiinxi huluwwa tommenna lame lame golalooka fiixa dancha kinjo affeemman; mitti mittinxi hula mitte mitte golalooke dancha fiixa kinjinni giissendeemman; qachchiink lumo ori daa'witetishsha ifa ifi giddii'n sa'isaake ca'itte worqemman. <verse eid="REV 21:21" /><verse number="22" style="v" sid="REV 21:22" />Duuchchiinxa dande'aak Gootti Mageninna iikki gedhechchi ookkone qachchike Galma kademmaxxee ookkone qachchi giddo Galma afebe'non.<verse eid="REV 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="REV 21:23" />Mageniike gaachchanni isi'a ifisammaxxee, gedhechchikinna isike ifa kademmaxxee iikki qachchi arsho yookaan agenji isi'a ifiso'a hassissabaan. <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />Arduwwi isike ifa'ni mammaremaan; buttatik moyanjuwwinna ifi ifika ulfinna isi'a iyyedangaan. <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />Ookkonna hashsha hedha gopheemmaxxee hula isixxi heene barra'ninna cufendabaan. <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />Ardiink gaachchanninna ulfinni isiba'a dagaan. <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />Gedhechchiinke hedhotike maxaafa'ni borreessemekeer gadhi darre battite yaane assa'neekinna dhara haaso'aaki duuchchi isibaa e'yabaan.<verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="s1">Hedhotika Galaana</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />Ookkonechchi uduma iikki iimik erganji Magenokenaa'ninna gedhechchinxe mootenaa'ni fula'neeka daa'witetishsha ca'a hiyyeeka hedhotika wode'e ane'ni leellishe. <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />Kunni wodi'inna ookkone qachchike lumoke orixxe oddonaa'n sa'eexxi yaa'aamman; konne wodi'ike middi bitta'a'ninna agenjo agenjo'ni gummisa'ni woggate'n tommenna lamele gummisaak hedhotike haqichcho hedhemman; konne haqichchuwwi shafuwwinna ardakee fayya iyyedagaamman. <verse eid="REV 22:2" /><verse number="3" style="v" sid="REV 22:3" />Ta'anni edi'a hiini badinonna hexxabaan; Magenikinna ookkene gedhechchixxi moote konne qachchi giddo hexxaan; isik eranjuwwinna isoo magenoffantaan. <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />Insa'nenna alba isika anffaan; summi isikinna xabana insa'neke'ni hedhaake kada. <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />T'a'anni edi'a hashsha hexxaba'a; Gootti Mageni insa'ne'a ifisammaxxee ifi yookaan arishshotik ifinni insa'ne'a hasisabaa; insa'nenna duuchchi woddinaa'n duuchchi woddi'a moonaan.<verse eid="REV 22:5" /></para>
  <para style="s1">Yessuusixxa Laangaxxa Daga</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />Iikki iimik erganjinna ane'ni, «Kunni hiyyichchuwwi xuurameessakenna dhugaatiken; wabeekotike hafuuruwwik Gootti Mageni shiqo kaddaaxxa yaane ifike erganjuwwi'a leellisho'a ifika iimika erganjo ergeen» hiyye.<verse eid="REV 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7" />«Kunse rakee dagannon; konnee maxaafika ragiinka haaso'a heqedhaak eebbisemeeken.» <verse eid="REV 22:7" /><verse number="8" style="v" sid="REV 22:8" />Tennee yaannuwwa laqennekinna afennek ante Yohaannisiten; tenne yaanuwwa laqenne woddanna afenne wodda tenne yaanuwwa ane'n leellisheeke iimike erganjo magenooffatonnaa isixxe lekka hunda kumbu hiyyenne. <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />Isi kinni anee, «Waali tenne assitoxxe! Ani atinninna atike dayyuwwa wabeekoti welti iittanni konne maxaafika hiyyichchuwwa heqedhaake duuchchinni welti erganjoken; Magenokee kumbu hiyyi» hiyye. <verse eid="REV 22:9" /><verse number="10" style="v" sid="REV 22:10" />Ookkoneechchi uduma lebenna anee hiyyee qici: «Yanna geltammaxxee konne maxaafika raagiinka hiyyichcho maxxansik cuffoxxe'e. <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />Xaqaritichchi ifixxe xaqaronninni me'owwaal; battichchikinna batto'owwaal; qullichchikinna qulloomowwaal; woyyichchikinna woyyichchake kadowwaal.»<verse eid="REV 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />Kunnise ani rake dagannon; mitti mittingee isixxe hujeshshanni uwwannok hiri anxe anga'n hedheen. <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" />Alfanna Omeega, edikinna udumik, siretikinna muuxamiink anten. <verse eid="REV 22:13" /><verse number="14" style="v" sid="REV 22:14" />Hedhotike haqichchiba'a geyateenna eettene huluwwwa darree'n ookkone qachchiba'a e'yatika baallooma alfaashsha seemma ifixxa anshedhaakiir eebbisemeekeeran. <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />Wonshi, gojaaleeyye, yabaabuluwwi, manjo anga sa'aakiir, dharichcha magenuwwa magenoffatammakiir, dhara eeyyaakiirinna assaak duuchchi ookkone qachchi gadho hedhaan.<verse eid="REV 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />«Ani Yessuusi, tenne yaanuwwa dhugaa kulo'a iimika anka erganjo Mageniinxe tuuta'a erge'ennen; ani Daawwitike hiddanna daalon; ifisaake soodimariinke bakkalchan.»<verse eid="REV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />Hafuurikinna iitti waajubichcho, «Amoo!» hinaan; laqaakinna «Amoo» hiyyowwaal; dhebo'week duuchchinna dagowwaal; hasaak duuchchinna konne hedhotika wode'e hiri belo adhdhowwaal.<verse eid="REV 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />Konne maxaafika raagiiinka hiyyichcho laqaaka duuchcha xexxe'achisaannen; ayyinna konne hiyyichcho'n mitte yaanenna leboole Mageni konne maxaafi giddo borreessendeexxa balaara iso'n lebaan. <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />Ayyinna konnee raagiinke maxaafa'n borreessemeeke hiyyichchinaa'n mittechcho xe'esheexxe kaddoole Mageni konne maxafa'n borreessemeeke hedhotike haqichchonaa'ninna ookke woyyichchi qachchinaa'n qoobbo isika xe'ishaan.<verse eid="REV 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />Tenne yaanuwwa dhugaa kula'neek, «Eeti, rakee dagannon» hiyya'neen;</para>
  <para style="q2" vid="REV 22:20">Ameen Gootta Yessuusi amo. <verse eid="REV 22:20" /><verse number="21" style="v" sid="REV 22:21" />Gootta Yessuusik badhaadhi Mageniike ardinni welti hedhowwaal. Ameen.<verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>