<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JER" style="id">- Gedeo Bible</book>
  <para style="h">Eermiyaasikaa Raaga</para>
  <para style="toc1">Ermiyaasikaa Raaga</para>
  <para style="toc2">Ermiyaasikaa Raaga</para>
  <para style="toc3">Erm.</para>
  <para style="mt1">Eermiyaasikaa Raaga</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Wabeeki Eermiyaas, Kiristoossixxe ilensha edo torbaxxe dhibba woggake muuxama'ninna jiyaaxxe gattowwaal beloxxe woggake ke'ito'n hedhemmakeni: Ermiyaasi tenne qeerraxxe yannaxxe ergatensha'n: fakke magenooffantemmaxxenna cubbo insa'nexxixxe buuto'a Duuchchi Woddike Goottike arda'ni jabaxxi ba'ne insa'ne'n gelta'nemmaxxe xexxe'achchiisaammani: haaso'eeke wabeekumi giddo isi hedhemmake baro'n konnechchinni butti'a hexxexxa huje mann hujaa'na'a uude'eni. Eermiyaasi Babiloonki moyaanji Nabukedenetsoor Yerusalemika qachcha lole abideexxi, qachchakanna Woyyichcha Galma diigeexxanna Yihudiinka moyanjo heddi ardinni welti booji'eexxi Babiloon'a adhdhe me'a'na uude'eni. Ittani Eermiyaasi, ardi baqate me'emmabaa'n higaaxxanna Isra'elixxi mootummanna haarrooba uurritaaxxa ediseeni haaso'eeni.</para>
  <para style="ip">Wabeekichchi Ermiyaasiki Maxaafi shoole kutuwwa'n qoodema dande'aani.</para>
  <para style="ip">1. Iyyosiyaasi, Iyyo'aqem, Yo'akininna Sedeqiyaasi moonemmake baro'ni Yihudike ardi'anna akeekisanjuwwa insa'neke'e Duuchchi Woddike Goottabaa'n dageeka hiyyichcho.</para>
  <para style="ip">2. Gargar hedheek wabeekoletik hiyyichchinna Eermiyaasixxe hedho'ni muuxendeexxi umo umo kaddeexxa yaanuwwa welti abiddeexxi Eermiyaasike borreessanjo Baaroki borreessammake mazigaba'ni afendeexxi borruwwa.</para>
  <para style="ip">3. Gargari hedheeke wele bogike arduwi'a Duuchchi Woddike Goottibaa'n ergemeeka wabeekuminka hiyyichcho.</para>
  <para style="ip">4. Iyyerusaalemi abidendaaxxanna ardi booji'eme Baabilooni'a adhdhemeexxa itti lebbe kuldaaxxe jirteni.</para>
  <para style="ip">Eermiyaasi arda ifika jaba qico eeyyaakenna insa'ne'a ba'netixxa murte sa'issa yo'oshsha eeyyabaake manjommani.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Magen Ermiyaasi'i f'leexxa <char style="ior"><ref loc="JER 1:1-19">1:1-19</ref> </char></para>
  <para style="io1">Magen Yihudakanna Isira'eelika arda mura woxisaaxxa <char style="ior"><ref loc="JER 2:1-25:38">2:1—25:38</ref> </char></para>
  <para style="io1">Dhariyye wabeekkole'n Ermiyaasixxa gareereera <char style="ior"><ref loc="JER 26-29">26—29</ref> </char></para>
  <para style="io1">Magen arda insa'neke bogibaa illeema hissaake kadeexxa <char style="ior"><ref loc="JER 30-33">30—33</ref> </char></para>
  <para style="io1">Ermiyaasixxa gargar gargar hexxeexxa ergatensha <char style="ior"><ref loc="JER 34-38">34—38</ref> </char></para>
  <para style="io1">Iyyerussaalemixxe ibaxxeenna Yihudik giddo kaddeexxa yaanuwwa <char style="ior"><ref loc="JER 39-42">39—42</ref> </char></para>
  <para style="io1">Ermiyaasi Gibtseke boga'n <char style="ior"><ref loc="JER 43-44">43—44</ref> </char></para>
  <para style="io1">Baaroki'a ergendeexxa erga <char style="ior"><ref loc="JER 45">45</ref> </char></para>
  <para style="io1">Wabeekichchi gargar gargar hedheeke arduwwixxee haaso'eexxa wabeekumma <char style="ior"><ref loc="JER 46-51">46—51</ref> </char></para>
  <para style="io1">Iyyerussaalemixxe ibaxxee lebende kulendeexxa yaane <char style="ior"><ref loc="JER 52">52</ref> </char></para>
  <chapter number="1" style="c" sid="JER 1" />
  <para style="p">
    <verse number="1" style="v" sid="JER 1:1" />Kelqiyaasik belti Eermiyaasi haaso'eeki haaso'i konneechchi butta hedheeken; anni isikinna Biniyaamike bogiba Anaatooti giddo hexxeexxe qeesenaa'n mittekemman. <verse eid="JER 1:1" /><verse number="2" style="v" sid="JER 1:2" />Yihudak moyanji Amooniki belti Iyyosiyaasi moyeexxe tommenna sakkaxxe wogga'ni Duuchchi Woddike Goottiki hiyyichchi Ermiyaasibaa dage.<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="2KI 22:3-23:27">2 Moy. 22:3—23:27</ref>; <ref loc="2CH 34:8-35:19">2 Odo. 34:8—35:19</ref>. </char></note> <verse eid="JER 1:2" /><verse number="3" style="v" sid="JER 1:3" />Higgeen Yihudik moyanjo'ni Iyyosiyaasik belto Iyyo'aaqemi moyeeke baro'ni; iittanni Yihudiinki moyanji, Iyyoosiyasiki belti Sedeqiyaasi moyemmake baro'ni, tommenna mittixxe woggake muuxami qico'n Iyyerusaalemik ardi booji'emeexxi me'eexxe woggake ondike agenjii qico'n iso'ni haaso'eemman.<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="2KI 23:36-24:7">2 Moy. 23:36—24:7</ref>; <ref loc="2KI 24:18-25:21">24:18—25:21</ref>; <ref loc="2CH 36:5-8">2 Odo. 36:5-8</ref>; <ref loc="2CH 11:21">11:21</ref>. </char></note><verse eid="JER 1:3" /></para>
  <para style="s1">Eermiyaasixxa Ye'ensha</para>
  <para style="p">
    <verse number="4" style="v" sid="JER 1:4" />Duuchchi Woddike Goottik hiyyichchi anibaa dage hiyyee qici:<verse eid="JER 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 1:5" />«Anixxe amake godobi giddo atee'e dadebe'nogi ege'neennen;</para>
  <para style="q2" vid="JER 1:5">ilendebexxo edi darre atee fi'leennen;</para>
  <para style="q2" vid="JER 1:5">gosa gosake ardi'a wabeeka kaddattoshsha atee'e hariireenneni.»<verse eid="JER 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 1:6" />Aninna hiissennexxi «Ee dada duuchchike Duuchchi Woddike Goottaa, ani hitta haasso'aanno qico ege'nennekebaan; ani ooseten» hiyyenne.<verse eid="JER 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 1:7" />Duuchchi Woddiki Gootti kinni anee hiyyee qici, « ‹Ani ooseten hitoxxe'e› ani atee ergannobaa duuchcha martetexxi, ani atee ajajennexxa duuchcha haasottattoni. <verse eid="JER 1:7" /><verse number="8" style="v" sid="JER 1:8" />Ani atee anjironna'a atinninni welti hedhennen insa'nee sodaattoxxe'e» hiyya'neen Duuchchi Woddik Gootti.<verse eid="JER 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 1:9" />Duuchchi Woddiki Goottinna anga ifixxa qeerrise'e suume anixxa tuqeexxi hiyyee qici: «Kunnise hiyyichcho anka afo'o atike'ni uggeennen. <verse eid="JER 1:9" /><verse number="10" style="v" sid="JER 1:10" />Yoona, goshshottaanna diiggottaa; balleessitottaanna findiggottaa, kaassottaanna ijaartottaa atee gosa gosake arda'ninna moyanjuwwa'ni techcho atee hariireennen,»<verse eid="JER 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 1:11" />Duuchchi Woddike Goottiki hiyyichchi; «Koo Eermiyaasi, uudaattechchi maacho?» hiyya'n anibaa dage.</para>
  <para style="p" vid="JER 1:11">Aninna, «Lewizetixxa siqqichch uudannen» hiyyenneni.<verse eid="JER 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 1:12" />Duuchchi Woddiki Goottinna ane'n, «Dhugaande uudetten; hiyyichchi ankinna muuxemaa qico'ni hubatee uudannon» hiyye.<verse eid="JER 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 1:13" />Higgeenna Duuchchi Woddiki Goottiki hiyyichchi, «Maachcho uudaatte?» hiyya'n anibaa dage.</para>
  <para style="p" vid="JER 1:13">Aninna, «Mitte daanfita'neexxa odolcho uudannen; isek afo'inna middii'n konne darre'ni heeshshi hiyye'een» hiyyenne.<verse eid="JER 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 1:14" />Duuchchi Woddiki Goottinna ane'ni hiyyee qici, «Middi darrenaa'n ookkone bogake'n hedheeke duuchcha'n dedhanga bala insa'ne'ni ibbaan. <verse eid="JER 1:14" /><verse number="15" style="v" sid="JER 1:15" />Yoonna middi darreke moyanjuwwika arda duuchcha ye'annon» hiyya'neen Duuchchi Woddik Gootti.</para>
  <para style="q1" vid="JER 1:15">«Insa'nek moyanjuwwi dagaan;</para>
  <para style="q2" vid="JER 1:15">insa'ne Iyyerusaalemi'a e'yatixxe huluwwa'ni,</para>
  <para style="q1" vid="JER 1:15">Dalla'uwwa iseke qarqara duuchcha'ni,</para>
  <para style="q2" vid="JER 1:15">Yihudiinke qachchuwwa duuchcha'ninna ifixxa mootuwwa offo'lishinaan.<verse eid="JER 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 1:16" />Anee waalleexxi fuggoxxa hunjemmaxxee,</para>
  <para style="q2" vid="JER 1:16">wele magenuwwi'a hixaana gubemmaxxee,</para>
  <para style="q1" vid="JER 1:16">Anga ifixxinn giissinemmachcho'ni magenooffatemmaxxee,</para>
  <para style="q2" vid="JER 1:16">anke arda'ni murte anixxa lallabeennen.<verse eid="JER 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 1:17" />«Ati kinn hidha atika usudhdhi; kexxettexxi atee ajajennexxa duuchcha insa'ne'n kuli; insa'nee'e mee sodaat; kada gophphoole ati insa'nee sodaattattoshsha assanon. <verse eid="JER 1:17" /><verse number="18" style="v" sid="JER 1:18" />Yoonna, techcho boga duuchcha'n atee'e ke'issaannen; tinninna Yihudiinka moyanjuwwa, insa'neka sooreessuwwa, qeesenna bogi duuchchika arda injifattattoshsha kinjiinke dalla'inni ijaaremeeke qachchishsha sibiljiinke utuphishshanna sageettotike dalla'ishsha atee asseennen. <verse eid="JER 1:18" /><verse number="19" style="v" sid="JER 1:19" />Insa'ne atee lollaani yaane kinni anjironnaa ani atinni welti hedhennenn insa'nenna atee injifatabaan» hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 1:19" /></para>
  <chapter eid="JER 1" />
  <chapter number="2" style="c" sid="JER 2" />
  <para style="s1">Magen Isra'elika Arda Kubbiseexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 2:1" />Duuchchi Woddik Goottik hiyyichchi anibaa dage hiyyee qici: <verse eid="JER 2:1" /><verse number="2" style="v" sid="JER 2:2" />«Martettexxi hafuura gikki assite tenneee Iyyerusaalemi lallabi;</para>
  <para style="q1" vid="JER 2:2">« ‹Duuchchi Woddik Goottinna hiyya'nee qici:</para>
  <para style="q2" vid="JER 2:2">ka'umumma hexxette wodda affetaxxa xuurameesumma,</para>
  <para style="q1" vid="JER 2:2">Waajubummate'n hitta anee eetettexxa,</para>
  <para style="q2" vid="JER 2:2">qiilla gammooje mittilchchi latabaake boga'ni;</para>
  <para style="q2" vid="JER 2:2">hittee qico anee hordoffettexxa kassi hiyyaanen.<verse eid="JER 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 2:3" />Isira'eel Duuchchi Woddiki Gootti'a woyyotemman;</para>
  <para style="q2" vid="JER 2:3">umoke'ni aasse'nammaxxe miidhamman;</para>
  <para style="q1" vid="JER 2:3">Iteeki duuchchi balleessanote kade;</para>
  <para style="q2" vid="JER 2:3">bala insa'ne'ni ibbeen› »</para>
  <para style="q2" vid="JER 2:3">hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 2:3" /></para>
  <para style="s1">Isira'eelik Edik Annuwwi Hujeexxa Cubbo</para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 2:4" />Koo Ya'iqoobike mine; Isira'eelike minixxe gamo duuchcha;</para>
  <para style="q2" vid="JER 2:4">Duuchchi Woddike Goottika hiyyichcho laqqe.<verse eid="JER 2:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="JER 2:5" />Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 2:5">«Ediki ha'nook annuwwi anenaa'ni bayyateechchi,</para>
  <para style="q2" vid="JER 2:5">woyi fuldabaaxxa fakke hordofeek,</para>
  <para style="q1" vid="JER 2:5">Insa'ne ifi'aanna baffantebaang ganteechchi,</para>
  <para style="q2" vid="JER 2:5">ane'ni maa balleessa hexxammalete?<verse eid="JER 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 2:6" />Insa'nenna, ‹Gibtseeke boganaa'n no'o fulcheek;</para>
  <para style="q2" vid="JER 2:6">qiilla gammoojjek gongoma'ni,</para>
  <para style="q1" vid="JER 2:6">Bobboqichcha qiilla gammoojje boga'n,</para>
  <para style="q2" vid="JER 2:6">gomalete'ninna dimma dukkana booncho'ni,</para>
  <para style="q1" vid="JER 2:6">Mitti manji mammaremabaakenna hedhabaake booncho'n,</para>
  <para style="q2" vid="JER 2:6">no'oo akeekeek Duuchchi Woddiki Gootti haba hedhe?› hine lanqebaan.<verse eid="JER 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 2:7" />Ani, misseexxa midhanna ittino'o</para>
  <para style="q2" vid="JER 2:7">shaqqake bogibaa ha'noo iyyedagenen;</para>
  <para style="q1" vid="JER 2:7">Ha'no kinn daggine boga anka battoossitineen;</para>
  <para style="q2" vid="JER 2:7">geego ankanna xureessitine.<verse eid="JER 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 2:8" />‹Duuchchi Woddiki Gootti haba hedhe?› hite,</para>
  <para style="q2" vid="JER 2:8">qeese laqqeebaan;</para>
  <para style="q1" vid="JER 2:8">Seera ege'nammakir anee ege'nebaan</para>
  <para style="q2" vid="JER 2:8">akeekisanjuwwi ane'n jallateen</para>
  <para style="q1" vid="JER 2:8">Raagoletinna Ba'aali hinaake dharichcha magenuwwinke summinn raaga haasotte,</para>
  <para style="q2" vid="JER 2:8">wayi fuldabaaxxa fakkuwwanna magenoonfatte.»<verse eid="JER 2:8" /></para>
  <para style="s1">Duuchchi Wooddiki Gootti Arda Ifika Ku'lee qico</para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 2:9" />«Tennexxe ani ha'noonni welti moromate afeennen»</para>
  <para style="q2" vid="JER 2:9">«Ha'nooxxe oosexxe oosenninna moromaannen.</para>
  <para style="q4" vid="JER 2:9">Hiyya'neeni Duuchchi Woddik Gootti.<verse eid="JER 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 2:10" />Kitimike oddoolika fooffine uude;</para>
  <para style="q2" vid="JER 2:10">Qeedari'a manjo ergitine qo'nissine qorre,</para>
  <para style="q2" vid="JER 2:10">iita hexxeexxi yaane kaddee egendeexxe kaddoole kokke.<verse eid="JER 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 2:11" />Dhugaatike magenuwwa kada gophoolenna midde;</para>
  <para style="q2" vid="JER 2:11">ifika magenuwwa jijjiidheki gosa gosak ardi hedhee laati?</para>
  <para style="q1" vid="JER 2:11">Ardi anki kinni anee'e insa'nek gaachchanna kadenneka,</para>
  <para style="q2" vid="JER 2:11">wayi fulabaachcho'ni jijjiidhdhineen.<verse eid="JER 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 2:12" />Tee iimmuwwa, tennee mambe'a hiyye;</para>
  <para style="q2" vid="JER 2:12">jaba qico soda'anni roqonse»</para>
  <para style="q2" vid="JER 2:12">hiyya'neeni Duuchchi Woddik Gootti.<verse eid="JER 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 2:13" />«Ardi anki lame cubbo huje'en:</para>
  <para style="q1" vid="JER 2:13">Hedhake muummeti wode'e kadenneka,</para>
  <para style="q2" vid="JER 2:13">anee'e waale'een,</para>
  <para style="q1" vid="JER 2:13">Wodi'i giddo kiphattabaxxa lugoo affeexxa wode'e cammammaxxa baluwwa,</para>
  <para style="q2" vid="JER 2:13">ifi'a qolte'neeni.<verse eid="JER 2:13" /></para>
  <para style="s1">Amana Gopha Iyyedaggeechcho</para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 2:14" />Isira'eel garbakebaan yookaan mine ilemeeke garbabaan;</para>
  <para style="q2" vid="JER 2:14">eega, mayeeta saamematixxe assende?<verse eid="JER 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 2:15" />Neenquwwi iso'ni;</para>
  <para style="q2" vid="JER 2:15">hafuura gikki asse ittannoole.</para>
  <para style="q1" vid="JER 2:15">Boga isikanna urummake assine'en;</para>
  <para style="q2" vid="JER 2:15">qachchuwwi kinna gubate mude'e one'een.<verse eid="JER 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 2:16" />Higgeenna Memifisikinna Xaafinaasike manni</para>
  <para style="q2" vid="JER 2:16">umo atike'n bante uggine.<verse eid="JER 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 2:17" />Ora ati'a akeekamaka,</para>
  <para style="q2" vid="JER 2:17">Duuchchi Woddika Gootta atika Mageno waaldeettaxxe'e;</para>
  <para style="q2" vid="JER 2:17">tennee umo atike'ni iyyedageboxxoota?<verse eid="JER 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 2:18" />Shiihorike galaanika wodee'e ha'witottaa,</para>
  <para style="q2" vid="JER 2:18">atitaa mayee Gibtsee'a martette?</para>
  <para style="q1" vid="JER 2:18">Efiraaxike galaanika wode'e ha'witottaa,</para>
  <para style="q2" vid="JER 2:18">Asoori'a me'aa mayee'e ati'aa hasisse?<verse eid="JER 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 2:19" />Fuggoxxi huje xixichcho ate'ni geessissan;</para>
  <para style="q2" vid="JER 2:19">dudduro wirri hiyya atixxinna fuggoxxa atte'ni iyyedaggaan.</para>
  <para style="q1" vid="JER 2:19">Dada Duuchcha Ajajaka Duuchchi Woddika Gootta atika Mageno waaldatto wodda;</para>
  <para style="q2" vid="JER 2:19">aneenna sodaatta waaldatto wodda</para>
  <para style="q1" vid="JER 2:19">Hittee qico ani hara fuggichchakenna qaraartaaxxe ate'ni kaddaaxxa,</para>
  <para style="q2" vid="JER 2:19">qalbeeffatte uudi ballo»</para>
  <para style="q2" vid="JER 2:19">hiyya'neen dada duuchchik Duuchchi Woddiki Gootti.<verse eid="JER 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 2:20" />«Olimii'ni ke'isse rakko atenaa'ni hoyyeennen</para>
  <para style="q2" vid="JER 2:20">usurra kenaa'ni ate'ee fulcheennen</para>
  <para style="q2" vid="JER 2:20">atinna, ani'a ‹Ergatemabo'non!› hiteten;</para>
  <para style="q1" vid="JER 2:20">Tullichchuwwi duuchchi hunda;</para>
  <para style="q2" vid="JER 2:20">mitte mitte shafa bira sa'eeke haqichchi hunda,</para>
  <para style="q2" vid="JER 2:20">dharichcha magenuwwa magenoonfattetten.<verse eid="JER 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 2:21" />Ani filemeeke woyinetike hiddichchishsha</para>
  <para style="q2" vid="JER 2:21">eloxxe sanne asse atee'e kaaseennani</para>
  <para style="q1" vid="JER 2:21">Corroqo'eke badda'a giddike woyinetike hiddichcho kaddettexxi;</para>
  <para style="q2" vid="JER 2:21">hitta kadde'e ane'ni jijjiirendettetaa?<verse eid="JER 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 2:22" />Haranjik anshexxoole</para>
  <para style="q2" vid="JER 2:22">heddo saamunuwwa la'onfattottolenna,</para>
  <para style="q2" vid="JER 2:22">balleessa atixxi farrie hite ta'anna ani edo hexxeen»</para>
  <para style="q2" vid="JER 2:22">hiyya'neeni Duuchchi Woddiki Gootti.<verse eid="JER 2:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="JER 2:23" />« ‹Batto'eebo'non,</para>
  <para style="q2" vid="JER 2:23">Ba'aalinna magenooffatebo'non› hitta hitatto?</para>
  <para style="q1" vid="JER 2:23">Dhooqa giddo maa hujjeette</para>
  <para style="q2" vid="JER 2:23">amo hedi,</para>
  <para style="q1" vid="JER 2:23">Maa assiteettexxa kassi hiyyi,</para>
  <para style="q2" vid="JER 2:23">elqenna kayya dida'nee gaala kaddeetten.<verse eid="JER 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 2:24" />Qiilla gammooje giddo barattetteshshanni,</para>
  <para style="q2" vid="JER 2:24">korma hallisita'n foole aaxxe diddammaxxe badda'a giddixxe harreshshaten;</para>
  <para style="q2" vid="JER 2:24">koromme hasseexxa isee'e ayyete abide uurrisa dande'aa?</para>
  <para style="q1" vid="JER 2:24">Koromme isee harsitaaxxi duuchcha elo belo,</para>
  <para style="q2" vid="JER 2:24">harisiteeke agenjo'n ikki woddi kormoole futti hitaan.<verse eid="JER 2:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 2:25" />Lekka atixxenaa'ni kophe muddaa qico'ni gongitoxxe;</para>
  <para style="q2" vid="JER 2:25">qonqo atixxinna wode'e dheebotte baggaa qico'ni doonsa kiyya hitoxxe.</para>
  <para style="q1" vid="JER 2:25">Ati kinn, ‹Tola eloottoxxe,</para>
  <para style="q2" vid="JER 2:25">dharrichcha magenuwwa eeyyeennen;</para>
  <para style="q2" vid="JER 2:25">insa'nee hordofannon› hitetten.<verse eid="JER 2:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="JER 2:26" />«Moodhalchi abidemee wodda shookammashsha,</para>
  <para style="q2" vid="JER 2:26">Isira'eeliki mininna shooke'en;</para>
  <para style="q1" vid="JER 2:26">Insa'ne, moyanjuwwi insa'nekinna akeekisanjuwwa,</para>
  <para style="q2" vid="JER 2:26">qeese insa'nexxinna raagole insa'nexxi ittanni shookkaan.<verse eid="JER 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 2:27" />Haqichhco, ‹Ati anke annani›</para>
  <para style="q2" vid="JER 2:27">kinjo kanna, ‹Ati no'o'o ildetten› hine;</para>
  <para style="q1" vid="JER 2:27">Alba insa'neke kadebaang,</para>
  <para style="q2" vid="JER 2:27">dudduro ane'ni wirri hineemmaxxe'e;</para>
  <para style="q1" vid="JER 2:27">Rakko insa'ne'ni geltaa wodda kinni,</para>
  <para style="q2" vid="JER 2:27">‹Daggettexxi no'o anjiri!› hinaan.<verse eid="JER 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 2:28" />Yoona, magenooffatotaa giissexxeettak magenuwwi atik haba hedhe?</para>
  <para style="q2" vid="JER 2:28">Rakko ate'n geltaa wodda anjira dandeenna'noole,</para>
  <para style="q2" vid="JER 2:28">koo Yihuda dange atee'e anjirowwaal;</para>
  <para style="q1" vid="JER 2:28">Qachchuwwi atikike lakkosishshann</para>
  <para style="q2" vid="JER 2:28">magenuwwi atikiki laakkossinna ittanni bira sa'eeken.<verse eid="JER 2:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="JER 2:29" />«Mayee'e anee elobaake assitina?</para>
  <para style="q2" vid="JER 2:29">Ha'no duuchchiing ane'n jallattine'eken»</para>
  <para style="q2" vid="JER 2:29">hiyya'neen Duuchchi Woddik Gootti.<verse eid="JER 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 2:30" />«Oose ha'noxxe'ni tola boddichcha mura woxisenne;</para>
  <para style="q2" vid="JER 2:30">insa'nenna balleessatenaa'n hingebaan;</para>
  <para style="q1" vid="JER 2:30">Wolaantichchi ha'nook solo'weeke neenqishsha</para>
  <para style="q2" vid="JER 2:30">wabeekole ha'noxxa kutti asse'en.<verse eid="JER 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JER 2:31" />«Koo ha'no konne barike manna Duuchchi Woddike Goottika hiyyichcho qalbeeffatte;</para>
  <para style="q1" vid="JER 2:31">«Ani Isira'eelike ardi'a qiilla gammoojje,</para>
  <para style="q2" vid="JER 2:31">yookaan dimma dukkana hexxeeke boga kadenne?</para>
  <para style="q1" vid="JER 2:31">Anki ardi, ‹Fedhii no'oxxishshann kandona'a hansaanneni›</para>
  <para style="q2" vid="JER 2:31">hinge atibaa dangabe'non mayee'e hiyya'ne?<verse eid="JER 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 2:32" />Isinni dancha ifika seesa,</para>
  <para style="q2" vid="JER 2:32">waajubichcho ifixxa wajubummatixxa seemma deeta?</para>
  <para style="q1" vid="JER 2:32">Anki ardi kinn,</para>
  <para style="q2" vid="JER 2:32">laakonne dhaqqanbabaaxxa barra anee'e dedheen.<verse eid="JER 2:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 2:33" />Ati'a jononaano'a assatee hitta hitta barattettexxe?</para>
  <para style="q2" vid="JER 2:33">Adabi elobaakixxi fuggoxxi melaalle midde atenaa'n heddo elobaaxxa barattaan.<verse eid="JER 2:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 2:34" />Moorake'ni abideboxxoxxi</para>
  <para style="q2" vid="JER 2:34">qullitte hiyyeeyyexxi munde,</para>
  <para style="q2" vid="JER 2:34">seemmuwwa atixxe'ni afendeen.</para>
  <para style="q1" vid="JER 2:34">Tenne duuchcha assiteen hexxe'e:<verse eid="JER 2:34" /></para>
  <para style="q2">
    <verse number="35" style="v" sid="JER 2:35" />‹Ani qullitteten;</para>
  <para style="q2" vid="JER 2:35">dhugaandinni mufe anee'e geltabaan› hitaatten.</para>
  <para style="q1" vid="JER 2:35">‹Ani kinn ate'ni muraanneni;</para>
  <para style="q2" vid="JER 2:35">cubbo hujeebo'non› hiteettaxxeeten.<verse eid="JER 2:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 2:36" />Dharichchi magenuwwibaa;</para>
  <para style="q2" vid="JER 2:36">mayee'e gongitaatte?</para>
  <para style="q1" vid="JER 2:36">Asoorik mann ate'e salphisemmashshanni;</para>
  <para style="q2" vid="JER 2:36">Gibtseeki manninna ittan ate salphisaani.<verse eid="JER 2:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 2:37" />Ati addattettaka Duuchchi Woddiki Gootti salphiseemmaxxe;</para>
  <para style="q2" vid="JER 2:37">insa'ne atee'e gargaarra gophaammaxxe'e;</para>
  <para style="q1" vid="JER 2:37">Anga atixxa umo atike'ni uggudhdhite;</para>
  <para style="q2" vid="JER 2:37">ookko'n fuldattoni.»<verse eid="JER 2:37" /></para>
  <chapter eid="JER 2" />
  <chapter number="3" style="c" sid="JER 3" />
  <para style="s1">Isira'eelixxa Addatema Gopha</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 3:1" />«Manj are ifixxa waaloole;</para>
  <para style="q2" vid="JER 3:1">isenna me'ite wele labbalo'n heerundoole;</para>
  <para style="q1" vid="JER 3:1">Ise'e langaxxa aassedhata?</para>
  <para style="q2" vid="JER 3:1">Tenne'e assooleta bogi batto'abaa?</para>
  <para style="q1" vid="JER 3:1">Ati kinn atee'e eeyyeeke heddo labbalinn yabaabuldetten;</para>
  <para style="q2" vid="JER 3:1">ta'a ane'n aaggotta'a hassaate?»</para>
  <para style="q2" vid="JER 3:1">hiyya'neeni Duuchchi Woddiki Gootti.<verse eid="JER 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 3:2" />«Amo qokki hite'e tulluchchuwwa uudi;</para>
  <para style="q2" vid="JER 3:2">ati yabaabulete'e irkateboxxo boonchi hedhee isi?</para>
  <para style="q1" vid="JER 3:2">Gonggomi giddo hedhammake arabike mannisha</para>
  <para style="q2" vid="JER 3:2">atinna orinqarqara ofolde jaaluwwa atika heqqexxetten.</para>
  <para style="q1" vid="JER 3:2">Yabaabuletinna fuggo atixxenni,</para>
  <para style="q2" vid="JER 3:2">ookkone boga battossiteten.<verse eid="JER 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 3:3" />Tennexxee umiinki xeen foyeme;</para>
  <para style="q2" vid="JER 3:3">udumik xeeninna gate;</para>
  <para style="q1" vid="JER 3:3">Ati kinn ta'anna yabaabuletika jeejja affeetten;</para>
  <para style="q2" vid="JER 3:3">ille atixe'n shooki hedhebaan.<verse eid="JER 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 3:4" />Ta'anna ati anee'e ye'exxe:</para>
  <para style="q2" vid="JER 3:4">‹Anke anna; oosummatike anke jaalo<verse eid="JER 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 3:5" />Duuchchi wodda mufattatton?</para>
  <para style="q2" vid="JER 3:5">Aare atixxinata duuchchi woddi'a teesi?› anee hite boxxota?</para>
  <para style="q1" vid="JER 3:5">Ati haasotteetta qici iittanden;</para>
  <para style="q2" vid="JER 3:5">kaddo malee'e dandeettettexxa fuggo duuchcha assitatton» hiyye.<verse eid="JER 3:5" /></para>
  <para style="s1">Aadete'e Isira'elixanna Yihudaxxa Ye'ensha</para>
  <para style="p">
    <verse number="6" style="v" sid="JER 3:6" />Moyanji Iyyosiyaasi moyemmake baro'ni Duuchchi Woddik Gootti ane'e hiyyee qici, «Isira'eeli'i addatendabaaxxi maa assiteexxa uudeette? Ise qeerrarramma tulluwwa duuchchi hana saxxeexxi bankaraareeke haqichchi hunda duuchcha marteexxi ookko'o yaababulde.<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="2KI 22:1-23:30">2 Moy. 22:1—23:30</ref>; <ref loc="2CH 34:1-35:27">2 Odo. 34:1—35:27</ref>. </char></note> <verse eid="JER 3:6" /><verse number="7" style="v" sid="JER 3:7" />Tenne duuchcha assitelchchi uduma anibaa'a higgaan hiyyeennan; kaddo malee'e anibaa higgebaan; finqilto isexxi dayyo Yihudanna tenneen uude. <verse eid="JER 3:7" /><verse number="8" style="v" sid="JER 3:8" />Isira'eeli addatendebaaxxi assiteexi yabaabulle duuchchi'a ise'e waalatixxa borro uwwennexxi shorrennen; finqilto isexxi dayyo Yihudanna tenneen uuda'ninn sodaattebaaxxa afennen; isenna me'ite yabaabulde. <verse eid="JER 3:8" /><verse number="9" style="v" sid="JER 3:9" />Yabaabulle isexxike shollinninn boga battoossite; kinjikinna haqichchink yabaabulde. <verse eid="JER 3:9" /><verse number="10" style="v" sid="JER 3:10" />Tinni duuchcha kaddaa'naani finqilto isexxi dayyo Yihuda anibaa'a higgeexxe fakkaateek sobbete malee'e mitte godobinetebaan» hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 3:11" />Duuchchi Woddik Gootti ane'n hiyyee qici, finqilto Yihuda caala addatendabaaxxi Isira'eeli qullitteten. <verse eid="JER 3:11" /><verse number="12" style="v" sid="JER 3:12" />Martte konneechinn butti'a hexxeexxa erga middike manna'n hite lallabbatto qici:</para>
  <para style="q1" vid="JER 3:12">« ‹Tee addatendaboxxoxxe Isira'eeli aniba'a higi› hiyya'neeni Duuchchi Woddik Gootti.</para>
  <para style="q2" vid="JER 3:12">‹Ani gattowwaaltike kadennaxxe'e,</para>
  <para style="q1" vid="JER 3:12">Ta'inn edi'a mufetixxe illenn ate'e uudabo'non›</para>
  <para style="q2" vid="JER 3:12">hiyya'neen Duuchchi Woddik Gootti. ‹Duuchchi woddi'a mufatabo'non.<verse eid="JER 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 3:13" />Ati Mageno atike Duuchchi Woddke Gootta'ni jallatat,</para>
  <para style="q2" vid="JER 3:13">ulfinna atika anafeeke magenuwwi'a,</para>
  <para style="q1" vid="JER 3:13">Bankaraareeke haqichuwwi hunda gaachchanna atika sa'issite uwwiyyot;</para>
  <para style="q2" vid="JER 3:13">ani'a ajajema gonpheti,</para>
  <para style="q2" vid="JER 3:13">balleessanjote kaddeetexxa tenne mitte yaane calla ege'ni› »</para>
  <para style="q2" vid="JER 3:13">hiyya'neen Duuchch Woddiki Gootti.<verse eid="JER 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 3:14" />«Ha'no addatendinabaake arda, ani aro'o ha'nooke kadeennaxxe'e anibaa'a higge» hiyya'neen Duuchchi Woddik Gootti «Ani ha'no'o mitte qachchanaa'n mitte gosatike mannanaa'n lame filleennexxi Tsiyooni'a iyyedagannon. <verse eid="JER 3:14" /><verse number="15" style="v" sid="JER 3:15" />Anee'e godobi aageexxa, ege'natinna qalbeeffachchot ha'noo akeekaaxxa allalisano ha'no'a uwwannon. <verse eid="JER 3:15" /><verse number="16" style="v" sid="JER 3:16" />Ha'noo laakkosi ookkone boga'ni hara bira sa'aan» hiyya'neen Duuchchi Woddiki Gootti hiyya'nee qici; «Ookkone baro'ni manni ‹Duuchchi Woddi Goottike kakoti taabota hiyyeexxi konnechchin edi'a isoo'o summisabaan› qallinna hiyyaba, qaabbataba'a, welikinna giissemaba. <verse eid="JER 3:16" /><verse number="17" style="v" sid="JER 3:17" />Eettene yanna Iyyerusaalemi'i, ‹Duuchchi Woddike Goottixxi moote› hiyyende ye'endaan; gosa gosak arduwwi duuchchinna Duuchchi Woddike Goottika summa ulfeesso'a Iyyerusaalemi bukki hiyyaan; ookkonechchinn udumi'a ifike godobika fuggoka yaadanna hordofabaan. <verse eid="JER 3:17" /><verse number="18" style="v" sid="JER 3:18" />Ookkone baro'ni Yihudakinna Isira'eelki ardi mitteba higeexxi middike boganaa'n ani annuwwa insa'neke geegoke kado'a uwwenneke bogiba'a dangaan.<verse eid="JER 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 3:19" />«Aninna hiyyenne qici,</para>
  <para style="q1" vid="JER 3:19">« ‹Tee Isira'eli filemeeka boga,</para>
  <para style="q2" vid="JER 3:19">huuni gosa gosak ardinna alfebaaka hara elle calli boga geego ati'a uwwonna'a.›</para>
  <para style="q1" vid="JER 3:19">Atee'e anxe labbaxxe ooseshsha hitta gammadik uudanno hiyyennen:</para>
  <para style="q1" vid="JER 3:19">Atinna ‹Annayyo› hite ane'e ye'exxatek;</para>
  <para style="q2" vid="JER 3:19">annena hordofatenaa'n udumi'a higgatolchcho ane'ni labbeemman.<verse eid="JER 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 3:20" />Koo Isira'eelke arda; aro'o iseke'e addatendebaaxxe areshsha,</para>
  <para style="q2" vid="JER 3:20">ha'no ane'e sobbina'ni turtine'e»</para>
  <para style="q2" vid="JER 3:20">hiyya'neeni Duuchchi Woddike Gootti.<verse eid="JER 3:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JER 3:21" />Insa'ne Duuchchi Woddika Gootta Mageno dedhati</para>
  <para style="q2" vid="JER 3:21">ora insa'neka gorsinemmkaxxe'e,</para>
  <para style="q1" vid="JER 3:21">Isira'eelike ardixxi raare,</para>
  <para style="q2" vid="JER 3:21">insa'nexxi jabaxxi waakino qiila gammoojjeke tulluchuwwa'n laqende.<verse eid="JER 3:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="JER 3:22" />«Ha'no finqila arda higge;</para>
  <para style="q2" vid="JER 3:22">finqilumma ha'noxxenaa'n ani ha'noo'o fayyisannon.»</para>
  <para style="b" vid="JER 3:22" />
  <para style="q1" vid="JER 3:22">«Ati Duuchchi Woddike Gootta no'oke Mageno kaddettaxxe'e</para>
  <para style="q2" vid="JER 3:22">no'o ta'a, atibaa'a dangannon.<verse eid="JER 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 3:23" />Dhugaanden tulluchuwwi hana,</para>
  <para style="q2" vid="JER 3:23">ittan koobuwwati hana; Iizi! Hine fulle canca no'oxxi soboken;</para>
  <para style="q1" vid="JER 3:23">Dugaandinni Isira'eeli anjirema,</para>
  <para style="q2" vid="JER 3:23">Duuchchi Woddike Gootta Mageninniten.<verse eid="JER 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 3:24" />No'o oosummatike baronaa'n telchqico'n,</para>
  <para style="q2" vid="JER 3:24">edike annuwwi no'okixxe eloxxa gumma,</para>
  <para style="q1" vid="JER 3:24">Gedhebo insa'nekanna lalo insa'neka,</para>
  <para style="q2" vid="JER 3:24">labbaxxanna meyyaxxa insa'nexxa oose; itte'en battichcha magenuwwan hiyye.<verse eid="JER 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 3:25" />Yoona shooko no'oka oddo'wine amme diinpho,</para>
  <para style="q2" vid="JER 3:25">salphinni no'okinna no'o'ni buyyemowaal,</para>
  <para style="q1" vid="JER 3:25">No'onna annuwwi nokinna</para>
  <para style="q2" vid="JER 3:25">Duuchhci Woddika Gootta no'oka Mageno balleessinennaxxe'e</para>
  <para style="q1" vid="JER 3:25">No'oxxe oosummanaa'ni telchiqico'n;</para>
  <para style="q2" vid="JER 3:25">Duuchchi Woddike Gootta no'oke Mageni'a ajajemebo'non» hitine.<verse eid="JER 3:25" /></para>
  <chapter eid="JER 3" />
  <chapter number="4" style="c" sid="JER 4" />
  <para style="s1">Aadde Aagiyyotika Ye'injo</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 4:1" />«Koo Isira'eelike arda; higgettele,</para>
  <para style="q2" vid="JER 4:1">anibaa higgetele,»</para>
  <para style="q2" vid="JER 4:1">hiyya'neen Duuchchi Woddiki Gootti:</para>
  <para style="q1" vid="JER 4:1">«Diqachchisa'neexxa attixxa fakkuwwa ani edi'ni fugusitottole,</para>
  <para style="q2" vid="JER 4:1">elqekayya daaqa gophe uuritottolenna,<verse eid="JER 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 4:2" />Dhugaati, qajeelummatinna qullummati,</para>
  <para style="q2" vid="JER 4:2">‹Hedhaake Duuchchi Woddike Goottixxa!› hite'e kakattottole,</para>
  <para style="q1" vid="JER 4:2">Gosa gosaki ard duuchchi isinn eebbisemaan</para>
  <para style="q2" vid="JER 4:2">Isinninna ifi jajaan» hiyye.<verse eid="JER 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 4:3" />Duuchchi Woddiki Gootti Yihudakanna Iyyerusaalemika arda hiyya'nee qici:</para>
  <para style="q1" vid="JER 4:3">«Galemmanga boga ko'we</para>
  <para style="q2" vid="JER 4:3">qumiddo giddo midha facaassinoqqe.<note caller="-" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="HOS 10:12">Hos. 10:12</ref>. </char></note><verse eid="JER 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 4:4" />Ha'no Yihudake manna, Iyyerusaalemi'i hexxina'neek arda,</para>
  <para style="q2" vid="JER 4:4">Duuchchi Woddike Gootti'a jila offo'le,</para>
  <para style="q2" vid="JER 4:4">qalbe ha'noxxika fuggoka yaada ifi giddii'n fugusse;</para>
  <para style="q1" vid="JER 4:4">Iitta kada gophphoole ha'no hujjineexxe foggoxxe hujexxe</para>
  <para style="q2" vid="JER 4:4">mufe anixxi giiratishsha bubbaan;</para>
  <para style="q2" vid="JER 4:4">dande'enna ise'e xolsaak hedhebaan.»<verse eid="JER 4:4" /></para>
  <para style="s1">Middii'n Daggeexxa Ba'ne</para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 4:5" />«Boga duuchcha'ni malagata ufuufe; Yihuda giddo kulle; Iyyerusaalemi giddonna lallabbe:</para>
  <para style="q2" vid="JER 4:5">qonqo gikki assitine ookone boga'ni hitina'ni raartinaa qici:</para>
  <para style="q1" vid="JER 4:5">‹Mitteba bukki hiyye;</para>
  <para style="q2" vid="JER 4:5">dalla'inkee qachchuwibaa'a amme banjo!›<verse eid="JER 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 4:6" />Tsiyooni'a giddi'a e'yate'e baandira iimi'a ke'isse;</para>
  <para style="q2" vid="JER 4:6">rakkine baqattine fulle;</para>
  <para style="q1" vid="JER 4:6">Middi darree'n bala,</para>
  <para style="q2" vid="JER 4:6">jabaxxa ba'nenna ha'no'ni iyyedagaannen» hiyye.<verse eid="JER 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JER 4:7" />Neenqi badda'a giddii'ni fuleen;</para>
  <para style="q2" vid="JER 4:7">gosa gosaka arda biraakinna boba'adheen;</para>
  <para style="q1" vid="JER 4:7">Boga ha'noka uruma asso'a,</para>
  <para style="q2" vid="JER 4:7">hedhemmabaa'ninna fule'een.</para>
  <para style="q1" vid="JER 4:7">Qachchuwwi ha'nok diigemaan;</para>
  <para style="q2" vid="JER 4:7">oonenna gattaan.<verse eid="JER 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 4:8" />Tennexxee dooniya oddo'we,</para>
  <para style="q2" vid="JER 4:8">yaade; woo woo hitina'ni oodhdhe,</para>
  <para style="q1" vid="JER 4:8">Duuchchi Woddike Goottixxi jabaxxi mufe;</para>
  <para style="q2" vid="JER 4:8">no'onaa'ni illeema higa gophpheen.<verse eid="JER 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JER 4:9" />«Eettene barra» hiyya'neen Duuchchi Woddik Gootti,</para>
  <para style="q2" vid="JER 4:9">«Moyanjuwwikinna ja'laabbuwwik godobi raafemaan;</para>
  <para style="q1" vid="JER 4:9">Qeesetinna alalte qexer hitaan;</para>
  <para style="q2" vid="JER 4:9">raagolettinna roqoonsitaan» hiyye.<verse eid="JER 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 4:10" />Ookkonechchi uduma aninna, «Koo Lumoke Duuchchi Woddike Gootta wolaantichchi ina'ne'n dage'e godoba geyee'na'a, ‹nage'iki hexxinaan› hitettexxi konne Iyyerusaalemika arda mayee'e gowwissette?»<verse eid="JER 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 4:11" />Eetene yanna konne arda'ninna Iyyerusaalemi'n hiyyende haaso'endaaqic, «Dudhishshaaxxe malee'e hafarsitaaxxe yookaan qulleessitaaxxe kaddebaaxxi bagoxxi diidallo qiilla gammoojje hedheeke urma tulluchuwwanaa'n anke hadiba'a gandaan. <verse eid="JER 4:11" /><verse number="12" style="v" sid="JER 4:12" />Anke ajajinninna jabaqicinni sortaan; aninna murte anxa inisa'ne'ni lallabannon.»<verse eid="JER 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 4:13" />Kunnise naaphi duumanchiishsha buqe dagaan;</para>
  <para style="q2" vid="JER 4:13">insa'nexxi fadhadin gaaruwwa hobonbaltetishsha fiiggaan;</para>
  <para style="q1" vid="JER 4:13">Fadhaduwwi insa'nekinna sinbirii caala qolchaan;</para>
  <para style="q2" vid="JER 4:13">ba'nenden no'a aanne!<verse eid="JER 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 4:14" />Tee Iyyerusaalemi anjirendotta'a fuggoxxa godobii'n anshedhi;</para>
  <para style="q2" vid="JER 4:14">haaniqico'ni fuggoki yaadi ate'ni hedha?<verse eid="JER 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 4:15" />Daanike qachchanaa'n lallabaak hafuur;</para>
  <para style="q2" vid="JER 4:15">Efireemixxe koobuwwa'ninna ba'ne kulaan.<verse eid="JER 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 4:16" />«Tennexxee gosa gosake arda'n kulle;</para>
  <para style="q2" vid="JER 4:16">Iyyerusaalemi'ninna hitine lassitinaaqici:</para>
  <para style="q1" vid="JER 4:16">‹Erqe kayyii'n buqeexxi rakkisaakir bayike boganaa'n dagaan;</para>
  <para style="q2" vid="JER 4:16">Yihudiinke qachchuwwa'ninna geeraraan.<verse eid="JER 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 4:17" />Ardi isiki ane'ni jallateemmaxxe'e;</para>
  <para style="q2" vid="JER 4:17">midha heqedhammake mannishsha erqe kayii'ni ise'e bunqaan,› »</para>
  <para style="q2" vid="JER 4:17">hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 4:18" />Koo Yihudike arda «Me'inji ha'nokinnna huje ha'noxxi;</para>
  <para style="q2" vid="JER 4:18">tennee ha'no'n iyyedaggeen;</para>
  <para style="q1" vid="JER 4:18">Tinninna mura ha'noxxen;</para>
  <para style="q2" vid="JER 4:18">hittata qaraareeke;</para>
  <para style="q2" vid="JER 4:18">hitta godoba haraxxi assaake!»<verse eid="JER 4:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JER 4:19" />Diino anke abara! Diino anke abara'a!</para>
  <para style="q2" vid="JER 4:19">Elagonphe anenaa'n kexxebaan;</para>
  <para style="q1" vid="JER 4:19">Diino qalbe anxixxe yaaddo!</para>
  <para style="q2" vid="JER 4:19">Qalbe anee'e fuggo dhiqqissa'neen:</para>
  <para style="q2" vid="JER 4:19">sammi hiyya dande'abe'non;</para>
  <para style="q1" vid="JER 4:19">Malagatiink hafuur,</para>
  <para style="q2" vid="JER 4:19">loliinka canca laqeennen.<verse eid="JER 4:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 4:20" />Ba'ne ba'nede'n hana lebendaan;</para>
  <para style="q2" vid="JER 4:20">kunni boginna one gataan;</para>
  <para style="q1" vid="JER 4:20">Dunkaane anxi dedhange'n,</para>
  <para style="q2" vid="JER 4:20">qoorchi ankinna ikki woddi diigeme.<verse eid="JER 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 4:21" />Haani qico'nita lolinka baanidira uudanno?</para>
  <para style="q2" vid="JER 4:21">Haani qico'nta malagatiinka hafuura laqanno?<verse eid="JER 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 4:22" />«Anki ardi gowwaken;</para>
  <para style="q2" vid="JER 4:22">aneenna ege'nebaan.</para>
  <para style="q1" vid="JER 4:22">Insa'ne hedumi xe'yeeke,</para>
  <para style="q2" vid="JER 4:22">qalbeeffachcho affebaake mannani.</para>
  <para style="q1" vid="JER 4:22">Insa'ne fuggoxxa assatee'e beekkole,</para>
  <para style="q2" vid="JER 4:22">eloxxa huja kinn egeneba'a» hiyye.<verse eid="JER 4:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="JER 4:23" />Ani butta uudennen,</para>
  <para style="q2" vid="JER 4:23">isenna bifa affebaaxxe duwwixemman;</para>
  <para style="q1" vid="JER 4:23">Iimmuwatanna uudennen,</para>
  <para style="q2" vid="JER 4:23">ifi iimuwatikinna hedhemmaba'a.<verse eid="JER 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 4:24" />Koobuwwatanna uudennen,</para>
  <para style="q2" vid="JER 4:24">isenna linqisa'nemman;</para>
  <para style="q1" vid="JER 4:24">Tulluchuwwi duuchchanna raasemme.<verse eid="JER 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 4:25" />Uudennen, manji hedhemmabaan:</para>
  <para style="q2" vid="JER 4:25">ci'uwwa duuchcha me'ite luggiteemman.<verse eid="JER 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 4:26" />Uudennen, midhatik bogi qiilla gammoojje kade;</para>
  <para style="q2" vid="JER 4:26">qachchi duuchchinna Duuchchi Woddike Gootti edo</para>
  <para style="q2" vid="JER 4:26">jabaxxe isixxe mufenaa'n kexxeexxinni diigeme.<verse eid="JER 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 4:27" />Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 4:27">«Bogi duuchchi urimmake kadaan,</para>
  <para style="q2" vid="JER 4:27">kaddo malee kinni ijje isixxa balleessabo'no.<verse eid="JER 4:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 4:28" />Tennexxee butta ooxaan;</para>
  <para style="q2" vid="JER 4:28">iimmuwatinna dukkandaan</para>
  <para style="q1" vid="JER 4:28">Ani haaso'eennen yaada anka jijjiirabo'no;</para>
  <para style="q2" vid="JER 4:28">mudheennen udumi'a higabo'no» hiyye.<verse eid="JER 4:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="JER 4:29" />Fadhado gulufammakenna gabe darbammake mannike cancanaa'n kexxeexxa,</para>
  <para style="q2" vid="JER 4:29">qachchi giddiki manni duuchchi baajaani;</para>
  <para style="q1" vid="JER 4:29">Mitti mitti bada'a giddi'a e'yaan;</para>
  <para style="q2" vid="JER 4:29">welinna kinjuwwi hana da'maani</para>
  <para style="q1" vid="JER 4:29">Qachchuwwi duuchchi oneexxi gate'een;</para>
  <para style="q2" vid="JER 4:29">isi giddonna hedhaaki hedhebaan.<verse eid="JER 4:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="JER 4:30" />Tee ati ba'nete geltettexxe Iyerussaalemi; maa kaddaateta?</para>
  <para style="q2" vid="JER 4:30">diimoxxa atixxa qeerraxxa seemma maye oddo'witette?</para>
  <para style="q2" vid="JER 4:30">Mayeeta worqeti ifi seefattette?</para>
  <para style="q1" vid="JER 4:30">Ille atixxa maye qarqaranna buudhite seefattette?</para>
  <para style="q2" vid="JER 4:30">seefachcho atixxi toliinxe kaddemmaxxe'e;</para>
  <para style="q1" vid="JER 4:30">Weli jaalattettakiir ate'e tuffate;</para>
  <para style="q2" vid="JER 4:30">ate'e shinno'a hasa'neen.<verse eid="JER 4:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="JER 4:31" />Gorommummatixxa ila ilatee'e ciiniifatammaxxe,</para>
  <para style="q2" vid="JER 4:31">ilate'ninna rakkattammaxxe manjichchoke hafuurishsha;</para>
  <para style="q1" vid="JER 4:31">Tsiyoonixxi belto hafuur qucci hita'ni,</para>
  <para style="q2" vid="JER 4:31">anga bande,</para>
  <para style="q1" vid="JER 4:31">«Aane ani'a mulqemeennen,</para>
  <para style="q2" vid="JER 4:31">manjo anga sa'emmake mannixxe anga'ni ibennen» hita'na'a laqennen.<verse eid="JER 4:31" /></para>
  <chapter eid="JER 4" />
  <chapter number="5" style="c" sid="JER 5" />
  <para style="s1">Iyyerussaalemixxa Balleessa</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 5:1" />«Iyyerusaalemike oruwwa'ni amme fulle; alalle adadde dirre;</para>
  <para style="q2" vid="JER 5:1">qarqara isekanna to'atine uudde;</para>
  <para style="q2" vid="JER 5:1">weldeenna weldeenna isexxe'ninna hasse</para>
  <para style="q1" vid="JER 5:1">Dhugaa harsaakanna qajeelummati me'aaka,</para>
  <para style="q2" vid="JER 5:1">mitte manjo midde affinoole,</para>
  <para style="q2" vid="JER 5:1">ani konne qachchi'a gattowwaal hiyyannon.<verse eid="JER 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 5:2" />Iso'n ‹Hedhaake Duuchchi Woddike Goottixxa!› hinoolenna,</para>
  <para style="q2" vid="JER 5:2">kakanta'neek dharikiten» hiyye.<verse eid="JER 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 5:3" />Koo Duuchchi Woddike Gootta ille atixxi isi dhugaa uuddaaxebaata?</para>
  <para style="q2" vid="JER 5:3">ati insa'nee'e gandetten; insaa'nenni kinni mitteelchonna labbebaan;</para>
  <para style="q1" vid="JER 5:3">Insa'nee bulleessite'etten; insa'ne kinni jiila gibe'e itti jabaante malee'e;</para>
  <para style="q2" vid="JER 5:3">aadde aaganna hanseba'a.<verse eid="JER 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 5:4" />Aninna godobi giddo; «kunni manni hiyyeeyye yookaan boose'akenna;</para>
  <para style="q2" vid="JER 5:4">gowooleyyeten;</para>
  <para style="q1" vid="JER 5:4">Duuchchi Woddike Goottika oranna,</para>
  <para style="q2" vid="JER 5:4">Mageno insa'nekika seera ege'na gonphemmaxxeten.<verse eid="JER 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 5:5" />Tennexxee akeekisanjuwwinba marennexxi;</para>
  <para style="q2" vid="JER 5:5">insa'ne'ninna kulannon;</para>
  <para style="q1" vid="JER 5:5">Dhugaandinn insa'ne Duuchchi Woddike Goottika ora,</para>
  <para style="q2" vid="JER 5:5">Mageno insa'nekika seera egennaan» hiyyenne.</para>
  <para style="q1" vid="JER 5:5">Yaane kinn insa'nenna ookkonerishshanni Duuchchi Woddike Goottike baalloomatike qanbar hundii'n baanjeexxi;</para>
  <para style="q2" vid="JER 5:5">usurra isikanna tanshe'ne'een.<verse eid="JER 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 5:6" />Insa'ne lumo qico jallantemmaxxe heddolenna finqilleemmaxxee;</para>
  <para style="q2" vid="JER 5:6">gongom giddi'ni yayye fulde insa'ne bubbuttaan;</para>
  <para style="q1" vid="JER 5:6">Leemmi hiyyaaka manjo duuchcha ninnifate'e;</para>
  <para style="q2" vid="JER 5:6">qeedhanchi qachchuwwi insa'nekika qarqar harqaani;</para>
  <para style="q1" vid="JER 5:6">Xaqaro insa'nexxi jabaxxe,</para>
  <para style="q2" vid="JER 5:6">waakino insa'nexxinna heddoten.<verse eid="JER 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JER 5:7" />«Eega, hitta ani gattowwaal hiyya dande'anno?</para>
  <para style="q2" vid="JER 5:7">oose atixxi ane'e waalde'en;</para>
  <para style="q2" vid="JER 5:7">dhugaatika Mageno kadebaake magenuwwike summinni kakante'een;</para>
  <para style="q1" vid="JER 5:7">Goddine hee'e hinnaa qico'ni insa'ne itise ha'wisennen;</para>
  <para style="q2" vid="JER 5:7">insa'ne kinni yabaabullete'ni hingeen;</para>
  <para style="q2" vid="JER 5:7">maallaqake ifi gurgurtammaxxe melaalleke mine'ni yaannen.<verse eid="JER 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 5:8" />Falemeeke labake kormi fadhachchi meyaaxxe himimmisammashsha</para>
  <para style="q2" vid="JER 5:8">mitti mitting annafeexxa are yorre'e isenni qili'mise.<verse eid="JER 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 5:9" />Tenne yaanuwwaxxeri'a ani insa'ne'e xixabo'noota?»</para>
  <para style="q2" vid="JER 5:9">hiyya'neen Duuchchi Woddik Gootti.</para>
  <para style="q1" vid="JER 5:9">«Ani ifi'anni iitta hedheeke gosa gosake arda'ni</para>
  <para style="q2" vid="JER 5:9">halo fulabo'noota?<verse eid="JER 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 5:10" />Anke ardike woyinetika hiddichchinke boonchchiba'a martine balleesse;</para>
  <para style="q2" vid="JER 5:10">yaane kinn woyinetika hiddichcho hara songate assitinoqqe;</para>
  <para style="q1" vid="JER 5:10">Kunnichchi Duuchchi Woddike Goottixxe kada gopheemmaxxe'e</para>
  <para style="q2" vid="JER 5:10">damuwwa isexxa cirtine birre.<verse eid="JER 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 5:11" />Isira'eelikinna Yihudak ardi</para>
  <para style="q2" vid="JER 5:11">haranga ani'a addatema gopheen»</para>
  <para style="q2" vid="JER 5:11">hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 5:11" /></para>
  <para style="b" />
  <para style="s1">Duuchchi Woddiki Gootti Isira'eli'i Waalee qico</para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 5:12" />Insa'ne Duuchchi Woddike Gootta'ni dhara haasonna'n;</para>
  <para style="q2" vid="JER 5:12">hineeqicinna, «Isi mittelchonna assabaan!</para>
  <para style="q1" vid="JER 5:12">Fuggoxxi no'o'ni geltabaan;</para>
  <para style="q2" vid="JER 5:12">wolaantichchakanna solo'o uundabo'non;<verse eid="JER 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 5:13" />Raagolettinna haaso'i diiddalloten;</para>
  <para style="q2" vid="JER 5:13">haasonnaaxi duuchchi dharaken;</para>
  <para style="q2" vid="JER 5:13">hineexxi duuchcha insa'ne'ninn higgowwaal» hine.<verse eid="JER 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 5:14" />Tennexxee lumok Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 5:14">«Ardi iitta haaso'emmaxxe'e</para>
  <para style="q2" vid="JER 5:14">afo'o atike'n hiyyichcho anka giirate,</para>
  <para style="q2" vid="JER 5:14">konne ardanna haqqete assannon</para>
  <para style="q2" vid="JER 5:14">giiratinna insa'nee ittaan.<verse eid="JER 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 5:15" />Koo, Isira'eelike arda,»</para>
  <para style="q2" vid="JER 5:15">hiyya'neen Duuchchi Woddiki Gootti:</para>
  <para style="q2" vid="JER 5:15">«Bayyii'ni gosa gosa arda ha'noo'ni ha'no'o lolaaka iyyedagannon;</para>
  <para style="q2" vid="JER 5:15">kunni ardi qara hedhekenna jabake,</para>
  <para style="q2" vid="JER 5:15">isika laagada ha'no egendinebaake</para>
  <para style="q2" vid="JER 5:15">haaso'a isikanna ha'no qalbeeffatinabake ardan.<verse eid="JER 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 5:16" />Gabe insa'nexxik gonofi haani hiyyeeke hiyyeerishshaten;</para>
  <para style="q2" vid="JER 5:16">insa'ne duuchching jajjabba loliinke mannani.<verse eid="JER 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 5:17" />Insa'nee atixxa fichchiinxa midhanna aassitetexxa midha inde kutti assinaan;</para>
  <para style="q2" vid="JER 5:17">labbaxxanna meyyaxxa atixxa oose birraan;</para>
  <para style="q1" vid="JER 5:17">Gedhebokanna lalo atika kutti assinaan;</para>
  <para style="q2" vid="JER 5:17">woyinetika hiddichuwwanna balasetika haqichchuwwa kurbi asinaan;</para>
  <para style="q1" vid="JER 5:17">Addateettaka kinjiinke dalla'ikka qachuwwa wolaatichchik balleessaan.<verse eid="JER 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 5:18" />«Kaddo malee'e, ookkone baro'n midde» hiyya'neen Duuchchi Woddik Gootti: «Ani ijje ha'nooxxa birannon. <verse eid="JER 5:18" /><verse number="19" style="v" sid="JER 5:19" />Ardi kinna ‹Duuchchi Woddiki Gootti no'oki Magen tenne duuchcha no'o'ni asseechchi mayeete?› hiyye qorroole ‹Anee'e, waaldineexxi ha'noke boga'ni annaffeeka magenuwwa magenooffantemmashanni, ittann ha'noke kadebange boga'ni annaaffee manni'a hujinaan hiyya'neen› hitatton.<verse eid="JER 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 5:20" />«Ya'iqoobixxe horte'n tenne kulle;</para>
  <para style="q2" vid="JER 5:20">Yihudake ardi'anna lallabbe.<verse eid="JER 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 5:21" />Ha'no ille affineeni affinabaak;</para>
  <para style="q2" vid="JER 5:21">manisha affineen laqqinabaaki,</para>
  <para style="q2" vid="JER 5:21">gowwoolenna qalbeeffatinabaak manni hiyyanexxa laqqe.<note caller="-" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">Isa. 6:9-10</ref>; <ref loc="EZK 12:2">Hiz. 12:2</ref>; <ref loc="MRK 8:18">Mar. 8:18</ref>. </char></note><verse eid="JER 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 5:22" />Ha'no anee sodaattinammabaa?» hiyya'neen Duuchchi Woddik Gootti;</para>
  <para style="q2" vid="JER 5:22">«Ha'no ani edo culphisa hasissabaata?</para>
  <para style="q1" vid="JER 5:22">Duuchchi woddi'a saxxe me'itabaashsha,</para>
  <para style="q2" vid="JER 5:22">maancha abbayatixxe gabala assenneni;</para>
  <para style="q1" vid="JER 5:22">Danbala'i isek guule dage ganemoole ookkoo'n sa'abaan</para>
  <para style="q2" vid="JER 5:22">luuloolenna iso'o qaxxaamurabaan.<note caller="-" style="x"><char style="xo" closed="false">5:22 </char><char style="xt" closed="false"><ref loc="JOB 38:8-11">Iyo. 38:8-11</ref>. </char></note><verse eid="JER 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 5:23" />Kunni ardi kinni finqileekanna jajjalcha godoba afe'en;</para>
  <para style="q2" vid="JER 5:23">anenaa'ninna udumi'a hige me'eedheen.<verse eid="JER 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 5:24" />Insa'ne godobi ifiki giddonna;</para>
  <para style="q2" vid="JER 5:24">‹Edikanna udumika xeena yannate'n uwwaaka</para>
  <para style="q1" vid="JER 5:24">Mayetanna yannate'ni no'a iyyedagaaka,</para>
  <para style="q2" vid="JER 5:24">Duuchchi Woddika Gootta no'oka Mageno sodaanto› hinebaan.<verse eid="JER 5:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 5:25" />Balleessa ha'nooxxi tenneera ho'nonaa'ni gatisse'een.</para>
  <para style="q2" vid="JER 5:25">Cubbo ha'nooxxinna elolla yaane alfitinabaashsha hoyyite'en.<verse eid="JER 5:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="JER 5:26" />«Anke ardi giddo fuggoke manna hedheen;</para>
  <para style="q2" vid="JER 5:26">insa'ne'e ci'a fonxoroti abidammake mannishsha</para>
  <para style="q2" vid="JER 5:26">fonxoro farri asse manjo abidammake mannishsha rinphaan.<verse eid="JER 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 5:27" />Ci'uwwa giddo wo'miteeke ci'atike minishsha;</para>
  <para style="q2" vid="JER 5:27">saamelchinn mini insa'nek wo'maken;</para>
  <para style="q1" vid="JER 5:27">Insa'nenna dureeyyetenna hunaameeyyete kandeeni.<verse eid="JER 5:27" /></para>
  <para style="q2">
    <verse number="28" style="v" sid="JER 5:28" />Insa'ne furdante'en cululunqeen,</para>
  <para style="q1" vid="JER 5:28">Insa'nexxi fuggonna tennete hinaaxxeban;</para>
  <para style="q2" vid="JER 5:28">annanna ama afebaake'e seera heqqinsebaan;</para>
  <para style="q2" vid="JER 5:28">rakkiyyetenna dhugaati murte murrebaan.<verse eid="JER 5:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 5:29" />Tenne yaanuwaxxerata ani insa'nee xixabo'noota?»</para>
  <para style="q2" vid="JER 5:29">hiyya'neen Duuchchi Woddik Gootti.</para>
  <para style="q1" vid="JER 5:29">Iita hedheeka gosa gosatika arda</para>
  <para style="q2" vid="JER 5:29">ani umo anigeninn halo fulabo'noota?<verse eid="JER 5:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="JER 5:30" />«Sodaachchisaxxinna alalshitaaxxi yaane,</para>
  <para style="q2" vid="JER 5:30">konne boga'ni kadde'en:<verse eid="JER 5:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 5:31" />Wabeeko dhariinka raaga raaga'neen;</para>
  <para style="q1" vid="JER 5:31">Anki ardinna iitta hexxeexxa yaane eeyaan;</para>
  <para style="q2" vid="JER 5:31">egedhi muuxamiinxi yanna geltaa wodda maa assitinutaa?»<verse eid="JER 5:31" /></para>
  <chapter eid="JER 5" />
  <chapter number="6" style="c" sid="JER 6" />
  <para style="s1">Iyyerusaalemi'i Naaphi Buqee qico</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 6:1" />«Koo Biniyaamike arda; fuggoxxi yaane,</para>
  <para style="q2" vid="JER 6:1">jabaxxi ba'nenna middii'n dedhanga daggammaxxe'e,</para>
  <para style="q1" vid="JER 6:1">Iyyerusaalemi giddii'n fuldine baajje;</para>
  <para style="q2" vid="JER 6:1">Teqo'a qachchi giddo malagata ufuuffe;</para>
  <para style="q1" vid="JER 6:1">Beetihakaaremi'ninna giddonna lolinka beessisa iimi'a abidde.<verse eid="JER 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 6:2" />Eeyyemekanna shaggichcha</para>
  <para style="q2" vid="JER 6:2">Tsiyoonika qachcha balleessannon.<verse eid="JER 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 6:3" />Allalisano ifika hore ookko'a adhdhite idagaan;</para>
  <para style="q2" vid="JER 6:3">isi qarqaranna dunkaanne oltitaan</para>
  <para style="q2" vid="JER 6:3">mitti mittingi ifi ifika hore hedhemma darre'n ise'ni.»<verse eid="JER 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JER 6:4" />Insa'nenna «Iyerussaalemi'i lollona'a qopheeffanitto;</para>
  <para style="q2" vid="JER 6:4">ke'wee! Barra banteessa lole'e ise'e miino;</para>
  <para style="q1" vid="JER 6:4">Hoola abbo! Bogi hashsheeqqa!</para>
  <para style="q2" vid="JER 6:4">gaaddiddotinna qeerrexxa'n me'ite'een.<verse eid="JER 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 6:5" />Yoona ke'weta hashsha lolle miino</para>
  <para style="q2" vid="JER 6:5">kinjiinka iseka dalla'uwwa diingo!»<verse eid="JER 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 6:6" />Lumok Duuchchi Woddiki Gootti hiyya'nee qici,</para>
  <para style="q1" vid="JER 6:6">«Haqichchuwwa woxxe;</para>
  <para style="q2" vid="JER 6:6">Iyyerusaalemike qarqara'ninna buttina tullubbe</para>
  <para style="q1" vid="JER 6:6">Konne qachcha'ni miicami bira sa'eemmaxxe'e;</para>
  <para style="q2" vid="JER 6:6">mura woxxowwaal.<verse eid="JER 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 6:7" />Bale giddii'n wodi'i burqammashsha,</para>
  <para style="q2" vid="JER 6:7">Iyerussaalemi giddii'n fuggoxxi yaane burqitaan;</para>
  <para style="q1" vid="JER 6:7">Xaqarotinna ba'ne ise giddo laqendaan;</para>
  <para style="q2" vid="JER 6:7">isexxi elagonphenna mada duuchchi wodda ani edo leellitaan.<verse eid="JER 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 6:8" />Koo Iyyerusaalemike arda;</para>
  <para style="q2" vid="JER 6:8">xexxe'achchiisa anxa adhe kada gophphoole dudduro ha'noo'n wirri hiyyannon;</para>
  <para style="q1" vid="JER 6:8">Ayyinna iso'n hedhabaa qico'n;</para>
  <para style="q2" vid="JER 6:8">qachcha ha'nooka qiilla gammooje asse; onchannon» hiyye.<verse eid="JER 6:8" /></para>
  <para style="s1">Isira'eelixxa Xaqaro</para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 6:9" />Lumok Duuchchi Woddiki Gootti hiyya'nee qici,</para>
  <para style="q1" vid="JER 6:9">«Woyinetixxa gumma feshshilende qocendammashsha</para>
  <para style="q2" vid="JER 6:9">Isira'eelinaa'n gateeka manna ittan feshshillaan.</para>
  <para style="q1" vid="JER 6:9">Woyine qocammake manjishsha;</para>
  <para style="q2" vid="JER 6:9">anga atixxa higgeeni isexxe damuwwabaa'a diriirs» hiyye.<verse eid="JER 6:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 6:10" />Ayye'ni haaso'anotaa? Ayyee'e xexxe'achchiisannotaa?</para>
  <para style="q2" vid="JER 6:10">Ayyete anixxa laqataa?</para>
  <para style="q1" vid="JER 6:10">Kunnisete ani hiyyaannexxa lanqabaasha,</para>
  <para style="q2" vid="JER 6:10">insa'nexxi manshsha duuddoten.</para>
  <para style="q1" vid="JER 6:10">Duuchchi Woddike Goottike hiyyicho'ni qacifanta'neen</para>
  <para style="q2" vid="JER 6:10">iso'ninna gammanda'nebaan.<verse eid="JER 6:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 6:11" />Insa'ne'ni hana Duuchchi Woddike Goottixxe mufenni ani wo'meennen;</para>
  <para style="q2" vid="JER 6:11">ifi giddo uggudhdha dande'ebo'non.</para>
  <para style="b" vid="JER 6:11" />
  <para style="q1" vid="JER 6:11">«Orake'ni hexxeexxe oose'ni,</para>
  <para style="q2" vid="JER 6:11">mitteba bukki hiteexxe dargageeyye'ne hana mufe anxa dhangalaasi;</para>
  <para style="q1" vid="JER 6:11">Arenna aro'ikinna,</para>
  <para style="q2" vid="JER 6:11">cindeexxi geedhenna cimme bo'lo'leekir baaje fulabaan.<verse eid="JER 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 6:12" />Bogi konne giddo hedha'nekera'ni,</para>
  <para style="q2" vid="JER 6:12">anga anxa wirri assanno wodda</para>
  <para style="q1" vid="JER 6:12">Fichchi insa'nekinna aruwwa insa'nexxi gattebang</para>
  <para style="q2" vid="JER 6:12">minuwwi insa'neki wele mannike kadaan»</para>
  <para style="q2" vid="JER 6:12">Hiyya'neen Duuchchi Woddik Gootti.<verse eid="JER 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 6:13" />«Lumokenaa'ni shiixxoki qico'ni hedheek duuchchi</para>
  <para style="q2" vid="JER 6:13">la'o ifixe'e diipho gopha'neen;</para>
  <para style="q1" vid="JER 6:13">Raagolettinna qeesoletinna gattebaang</para>
  <para style="q2" vid="JER 6:13">duuchchingi sobaalessaken.<verse eid="JER 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 6:14" />Anke ardixxa mada sholinshe uunde'en;</para>
  <para style="q2" vid="JER 6:14">fayyitaashanna seeriki dhukkunsisebaan;</para>
  <para style="q1" vid="JER 6:14">Nage'i hedhebaangi,</para>
  <para style="q2" vid="JER 6:14">‹Nage'aaken, nage'aaken› hinaan.<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="EZK 13:10">Hiz. 13:10</ref>. </char></note><verse eid="JER 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 6:15" />Tenne xireeffachchisa'neexxe insa'nexxe hujexxe'e;</para>
  <para style="q2" vid="JER 6:15">meya shoonke'e? Waawwo haranga shooko anfebaan,</para>
  <para style="q2" vid="JER 6:15">shookonge hinaachchi maachcho kadeexxa midde egennebaan;</para>
  <para style="q1" vid="JER 6:15">Tennexxe'e labbakeerinn welti inbaan;</para>
  <para style="q2" vid="JER 6:15">insa'nee xixanoxxa yanna salphantaan»</para>
  <para style="q2" vid="JER 6:15">hiyya'neen Duuchchi Woddik Gootti.<note caller="-" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="JER 8:10-12">Erm. 8:10-12</ref>. </char></note><verse eid="JER 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 6:16" />Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 6:16">«Weldeennate'ni uurritine uudde;</para>
  <para style="q2" vid="JER 6:16">elokanna olmika ora qodhdhe;</para>
  <para style="q1" vid="JER 6:16">Iso'ninna me'we.</para>
  <para style="q2" vid="JER 6:16">Lubbo ha'noxxi hafuura adhdhitaan;</para>
  <para style="q2" vid="JER 6:16">ha'no kinn, iso'ni ‹Me'inabo'no› hitineen.<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="MAT 11:29">Mat. 11:29</ref>. </char></note><verse eid="JER 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 6:17" />Ha'noo heqqaaka manna uggennen;</para>
  <para style="q2" vid="JER 6:17">‹Malagatakanna ufuunfa wodda laqqe› hiyyeen</para>
  <para style="q2" vid="JER 6:17">ha'no kinn ‹Lanqabo'non› hitine.<verse eid="JER 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 6:18" />Tennexxee koo gosa gosake arda laqqe;</para>
  <para style="q2" vid="JER 6:18">ha'noonna koo dhugaa kuldinaake manna</para>
  <para style="q2" vid="JER 6:18">mayi insa'nenn dagaaxxa hubatte.<verse eid="JER 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 6:19" />Tee butta laqi;</para>
  <para style="q2" vid="JER 6:19">insa'ne hiyyichcho anka laqa gonphemmaxxe'e</para>
  <para style="q2" vid="JER 6:19">seera ankanna tuffantemmaxxe'e,</para>
  <para style="q1" vid="JER 6:19">Konne arda'ni ifike yaadika hira,</para>
  <para style="q2" vid="JER 6:19">ba'ne insa'ne'ni idagannon.<verse eid="JER 6:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 6:20" />Saabake boga'ni hixaana;</para>
  <para style="q2" vid="JER 6:20">fishshitaaxxa shuuta shufuruwwa bayyike boganaa'n idangoole,</para>
  <para style="q2" vid="JER 6:20">maa la'o ani'a uutaa?</para>
  <para style="q1" vid="JER 6:20">Ha'noka ciinco'aaka tolcha adhdhabo'noni;</para>
  <para style="q2" vid="JER 6:20">weli ha'nook tolchuwwinna anee'e gammachchisabaan.»<verse eid="JER 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 6:21" />Tennexxee Duuchchi Woddik Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 6:21">«Ani konne ardi edo guggufachcho uggannon;</para>
  <para style="q2" vid="JER 6:21">annuwwikinna labbaxxi oose mitteba, iso'ni guggufantaan;</para>
  <para style="q2" vid="JER 6:21">olla'uwikinna jaaluwwikinna mundaan.»<verse eid="JER 6:21" /></para>
  <para style="s1">Middi Darree'n Daga'neeka Lola</para>
  <para style="p">
    <verse number="22" style="v" sid="JER 6:22" />Duuchchi Woddik Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 6:22">«Kunnise loliink manni,</para>
  <para style="q2" vid="JER 6:22">middike boganaa'ni dagate'ni hedheen;</para>
  <para style="q1" vid="JER 6:22">Buttatixxe gabalanaa'ni,</para>
  <para style="q2" vid="JER 6:22">lumok gosa gosatik ardi qophpheeffatate'ni hedheen.<verse eid="JER 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 6:23" />Gabetanna bagedo abixxe'eken;</para>
  <para style="q2" vid="JER 6:23">godoba jabakenna mararte afebaake mannanni;</para>
  <para style="q1" vid="JER 6:23">Fadhado insa'neka gulunfaa wodda;</para>
  <para style="q2" vid="JER 6:23">hirbi abaayatike danbala'ike luuljishshaten;</para>
  <para style="q1" vid="JER 6:23">Tee Tsiyoonixxe belto, insa'ne duulokee qophpheeffanteexxi</para>
  <para style="q2" vid="JER 6:23">atee lollo'a dangaan» hiyye.<verse eid="JER 6:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="JER 6:24" />Iyyerussaalemike ardixxe'e oddo lanqenneni</para>
  <para style="q2" vid="JER 6:24">hirre no'oxxinna lo'o hite'en;</para>
  <para style="q1" vid="JER 6:24">Ciniifatta'nexxe manjichchoshsha</para>
  <para style="q2" vid="JER 6:24">wixixxi hine rakkantenne.<verse eid="JER 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 6:25" />Naaphi wolaantichcha ka'le'en</para>
  <para style="q2" vid="JER 6:25">booncho booncho'ninn weekenisha hexxeen</para>
  <para style="q1" vid="JER 6:25">Tennexxee gadhi'a fuldinoqqe;</para>
  <para style="q2" vid="JER 6:25">orake'ninna marendinoqqe'e.<verse eid="JER 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 6:26" />Koo anke ardaa; dooniya oddo'witine;</para>
  <para style="q2" vid="JER 6:26">bululoke'n gangalatte;</para>
  <para style="q1" vid="JER 6:26">Mitte belti'a oodhammake mannijjisha</para>
  <para style="q2" vid="JER 6:26">hiiqqise oodhdhe;</para>
  <para style="q2" vid="JER 6:26">no'o biraaki dedhange'ni no'o'n dago'aten.<verse eid="JER 6:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="JER 6:27" />«Sibilji hega uudemammashsha,</para>
  <para style="q2" vid="JER 6:27">anike ardika oranna,</para>
  <para style="q1" vid="JER 6:27">Me'injo insa'neka hega uuddatoke,</para>
  <para style="q2" vid="JER 6:27">atee hegiinke asse'eennen.<verse eid="JER 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 6:28" />Insa'ne duuchching hametee'e mammaremammake,</para>
  <para style="q2" vid="JER 6:28">jabake xaqartichcha mannan;</para>
  <para style="q1" vid="JER 6:28">Baaldudiinke sibilo kade'eeke,</para>
  <para style="q2" vid="JER 6:28">adabi elobaakike mannani.<verse eid="JER 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 6:29" />Irsaasete hiyyemaaka sibilo baqisate,</para>
  <para style="q2" vid="JER 6:29">finiinaashsha jabaqicinni buufe;</para>
  <para style="q1" vid="JER 6:29">Fuggaaleeyye fugussende luqqi hiyya gophemmaxxe'e,</para>
  <para style="q2" vid="JER 6:29">baqisama insa'nexxi toliinxe eloni.<verse eid="JER 6:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 6:30" />Duuchchi Woddik Gootti insa'nee tuffateemmaxxee</para>
  <para style="q2" vid="JER 6:30">insa'ne hunemeeke birretike sibiljo hiyyemaan» hiyye.<verse eid="JER 6:30" /></para>
  <chapter eid="JER 6" />
  <chapter number="7" style="c" sid="JER 7" />
  <para style="s1">Erimiyaasi Galmi Giddo Barsiissee qico</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 7:1" />Ermiyaasiba'a dageek Duuchchi Woddiki Goottiki hiyyichi: <verse eid="JER 7:1" /><verse number="2" style="v" sid="JER 7:2" />«Duuchchi Woddike Goottike minixxe hula'ni uuri; ookkonna hita'n lallabatto qici:</para>
  <para style="p" vid="JER 7:2">« ‹Duuchchi Woddika Gootta magenooffachchotee'e tenne huluwwanaa'n e'yitina'neeke ha'no Yihudiinke arda duuchchaa Duuchchi Woddike Goottika hiyyichcho laqqe. <verse eid="JER 7:2" /><verse number="3" style="v" sid="JER 7:3" />Lumoke Duuchchi Woddik Gootti Isira'eelik Mageni hiyya'nee qici: Me'injo ha'nookanna huje ha'nooxxa giisedhdhe; aninna ha'noo konne booncho'ni hexxinaashsha assannon. <verse eid="JER 7:3" /><verse number="4" style="v" sid="JER 7:4" />Kunni, «Duuchchi Woddike Goottike galman, kunni Duuchhci Woddike galman, Kunni Duuchchi Woddike galman hitina'n!» dhariinke hiyyichcho'n addatinoqqe. <verse eid="JER 7:4" /><verse number="5" style="v" sid="JER 7:5" />Me'injo ha'nookanna huje ha'nooxxa dhugaati giissexxinoole, wele'anna wel qajeelummati hexxinoole <verse eid="JER 7:5" /><verse number="6" style="v" sid="JER 7:6" />bogake'e keessumma manna amanna anna affebaaxxa oose, aro'o shi'witeexxa melaaluwwa miica gophphinoole, konne booncho'ni balleessa afee manjixxa munde duna gophphinoole, ho'noo miidhaaka wele magenuwwa fordofa gophphinoole, <verse eid="JER 7:6" /><verse number="7" style="v" sid="JER 7:7" />duuchchi woddi'a annuwwa ha'nooke uwwenneke boga'n, konne booncho'ni hexxinaasha assannoni. <verse eid="JER 7:7" /><verse number="8" style="v" sid="JER 7:8" />Ha'noo kinniwayifulabaake dharichcha hiyyichcho'ni addatina'neen.<verse eid="JER 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 7:9" />« ‹Moortina'neen; manjo shiltina'neen; yabaabuldina'neen; dhariki kakattina'neen; Ba'aali'a hixaana gubbina'neen; egendinebaaka wele magenuwwanna hordofina'neen. <verse eid="JER 7:9" /><verse number="10" style="v" sid="JER 7:10" />Summi ank ye'emaneeke konne minibaa daggine ani edo uurritineexxi, «No'o nagi'aken» hitina'ni tennee battitte yaane hujjina'neen. <verse eid="JER 7:10" /><verse number="11" style="v" sid="JER 7:11" />Summi anki ye'ema'neek kunni mini moodhalshetixxe wolo'o ha'no'a kadee? Kunnise assitina'neexxa yaane uudenneni! Hiyya'neen Duuchchi Woddik Gootti.<note caller="-" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="MAT 21:13">Mat. 21:13</ref>; <ref loc="MRK 11:17">Mar. 11:17</ref>; <ref loc="LUK 19:46">Luq. 19:46</ref>. </char></note><verse eid="JER 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 7:12" />« ‹Yoona ani edise'e anke summike galduma assedhennaka boonchiba'a Seelo'a martine'e arda anke Isira'eelixxe fuggaalessummanaa'n kexxeexxa ookko assennexxanna uudde. <verse eid="JER 7:12" /><verse number="13" style="v" sid="JER 7:13" />Ha'no tenne duuchcha assitinaa wodda ani lebe lebe'e ha'no'n haaso'ennen ha'noo kinni laqqinebaan; ha'no'o ye'enneni ha'no kinni cuqqi hitinebaan; hiyya'neen Duuchchi Woddik Gootti. <verse eid="JER 7:13" /><verse number="14" style="v" sid="JER 7:14" />Tennexxee Seelo'n assenashshanni ta'anna summi ank ye'ema'neeke booncho'ni, ha'no addatina'neeke galma'ni, annuwwa ha'nookeenna ha'no'a uwwenneke konne boonicho'n ittanni assannon.<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="JOS 18:1">Iya. 18:1</ref>; <ref loc="PSA 78:60">Far. 78:60</ref>; <ref loc="JER 26:6">Erm. 26:6</ref>. </char></note> <verse eid="JER 7:14" /><verse number="15" style="v" sid="JER 7:15" />Ha'nooka dayyuwwa Efireemika arda duuchcha fugussenaashshanni ha'noonna ifi edii'ni fugussannon.›<verse eid="JER 7:15" /></para>
  <para style="s1">Ardnxa Ajajema Gopha</para>
  <para style="p">
    <verse number="16" style="v" sid="JER 7:16" />«Koo Ermiyaasi hitattoxxa laqa gophaannaxxe'e, konne ardi'a soodattoxxe'e, kadhattoxxe'e, insa'nexxe'e ane'e magannissoxxe'e. <verse eid="JER 7:16" /><verse number="17" style="v" sid="JER 7:17" />Insa'ne Yihudake qachchuwwa'ninna Iyyerusaalemike oruwwa'ni assina'neexxa ati uuda'ni hexxebexxoo? <verse eid="JER 7:17" /><verse number="18" style="v" sid="JER 7:18" />Iimatixxe mootite'a kebbo kebbisatee, oose haqqe qoccaan; annuwwi giira ha'ishaan; melaalletinna buko bukeessitaan insa'ne anee mufachchiinso'a wele magenuwwi'anna ha'watika tolcha shiqinshaan.<note caller="-" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="JER 44:7-19">Erm. 44:7-19</ref>. </char></note> <verse eid="JER 7:18" /><verse number="19" style="v" sid="JER 7:19" />Tenne assina'neechchi ane'e mufachchiinso'ate? Hiyya'neen Duuchchi Woddik Gootti Saxxeexxin insa'ne'ni geya'neek saliphinni miidhemmaaki insa'nedebaa?<verse eid="JER 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 7:20" />« ‹Tennexxee Duuchchi Woddiki Goottinna Konne booncho'n manjoke'ninna horeke'ni, haqquwate'inna bogake'ni hexxeexxe midha duuchhca'n mufe anixxanna bala lolaasanonon; bubbaan xoxxabaan.<verse eid="JER 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 7:21" />« ‹Isira'eelik Duuchchi Woddiki Gootti Mageni hiyya'nee qici: Cincatike ha'noke Tolcha'n wele tolchanna lebbine maallakana ifi'aanni itte! <verse eid="JER 7:21" /><verse number="22" style="v" sid="JER 7:22" />Edika ha'noka annuwwa Gibtsee'n fulichenne wodda, tolchuwwinxeenna ciincatike tolchixxe ani ha'noo'ni haaso'enabaan; ajajeennaaan. <verse eid="JER 7:22" /><verse number="23" style="v" sid="JER 7:23" />Yaane kinni ajaja anka laqqe; aninna ha'nooke Mageno kadannon ha'noonna arda anke kaddinaan; eloxxi ha'no'a kaddo'a ajajenneke ora duuchcha'ni me'e; hiyye insa'nee ajajennen. <verse eid="JER 7:23" /><verse number="24" style="v" sid="JER 7:24" />Insa'ne kinni lanqeeban mitte godobin caqansebaan; lanqqaaxxa waalin halo abixine fuggoka yaada ifika hordonfe; edi'a me'inammaxxa waalle udumaa hinge. <verse eid="JER 7:24" /><verse number="25" style="v" sid="JER 7:25" />Edike annuwwi ha'nooki Gibtsee'n boganaa'n fulleexxe yannanaa'n ta'iqico'ni; barra barra'ninn hifatebo'nong; erganjuwwa anka raagole insa'ne'a ergennen. <verse eid="JER 7:25" /><verse number="26" style="v" sid="JER 7:26" />Insa'ne kinni ani hiyyennexxa lanqebaai; mitte godobini laqa hansebaan; godoba jabeesse'ne; edik annuwwi insa'nek hunjeexxi irra saxxeexxa fuggoxxa hunje.›<verse eid="JER 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 7:27" />«Tenne'e duuchcha kuldatton insa'ne kinni atixxa lanqabaan; yexxatton cuqqi hinabaan. <verse eid="JER 7:27" /><verse number="28" style="v" sid="JER 7:28" />Tennexxee insa'nee hitatto qici, ‹Kunni ardi Duuchchi Woddike Gootti Mageni'a ajajemebaake, gorsaakanna adhdha gibeeke ardan; dhuga insa'ne giddo hexxebaan afo'o insa'nekenaa'n baxxe'en.<verse eid="JER 7:28" /></para>
  <para style="s1">Hinonixxe Dhooqa'n Assendeexxa Fuggoxxa Yaane</para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 7:29" />Duuchchi Woddik Gootti tenne ila'ni mufate tuffate waalemmaxxe'e umo haaxxite huni; urmeeke tulluchchuwwi hana uurrite boochchisi.<verse eid="JER 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 7:30" />« ‹Yihudiink ardi fuggoxxe yaane ani edo asse'en; hiyya'neen Duuchchi Woddik Gootti; batto'eechcho summa anika ye'neeke mine'n uggine battoonsineen. <verse eid="JER 7:30" /><verse number="31" style="v" sid="JER 7:31" />Ani ajajebo'noxxa ijje hedebo'noxxa labbaxxanna meyyaxxa insa'nexxa oose giirate'ni ciincessine'e tolchakee Heenomike beltixxe dhooqa'ni Toofeeti hinaaka magenoofantaaka tulluchuwwa giissine.<note caller="-" style="x"><char style="xo" closed="false">7:31 </char><char style="xt" closed="false"><ref loc="LEV 18:21">Lew. 18:21</ref>; <ref loc="2KI 23:10">2 Moy. 23:10</ref>; <ref loc="JER 32:35">Erm. 32:35</ref>. </char></note> <verse eid="JER 7:31" /><verse number="32" style="v" sid="JER 7:32" />Tennexxee qalbeeffatte hiyya'neen Duuchchi Woddik Gootti; boonni hanqataa qico'n rensha Toofeti hinaa bonicho'ni moongammaxxe'e duliinxe dhooqa hinaa malee'e konneechchin edi'a Toofeeti yookaan Heenomike beltixxe dhooqa hinabaaxxi yanna daggaan. <verse eid="JER 7:32" /><verse number="33" style="v" sid="JER 7:33" />Konne ardiki renishi allaattetikenna biniinchuwixxe ita kadaan; mittikinna shorraaki hedhebaan. <verse eid="JER 7:33" /><verse number="34" style="v" sid="JER 7:34" />Gammashshotikinna ilileettetiki hafuur waajubichchinkanna waajubichchotika hafuura Yihudiinke qachchuwanaa'ninna Iyyerusaalemike oruwwanaa'n balleessannon; bogikinna urumee gataan.<note caller="-" style="x"><char style="xo" closed="false">7:34 </char><char style="xt" closed="false"><ref loc="JER 16:9">Erm. 16:9</ref>; <ref loc="JER 25:10">25:10</ref>; <ref loc="REV 18:23">Wal. 18:23</ref>. </char></note><verse eid="JER 7:34" /></para>
  <chapter eid="JER 7" />
  <chapter number="8" style="c" sid="JER 8" />
  <para style="p">
    <verse number="1" style="v" sid="JER 8:1" />« ‹Eettenee yanna'ni, hiyya'neen Duuchchi Woddik Gootti; Yihudiinke moyanjuwwixxinna ja'laabuwwiinxi miqe, qeesoletixxinna raagoletixxi miqe, Iyyerusaalemike ardixxi miqe moonge moongemmabaa'ninni fuldaan. <verse eid="JER 8:1" /><verse number="2" style="v" sid="JER 8:2" />Insa'ne eene ergatemmammake ittanni hordofammake; inisa'ne gorsammakenna magenooffantammaxxa arishsho, baatenna iimatixxa urjuwwa duuchchi edo fayendaan; bukki hitabaan yookaan moogendabaan: yaane kinn hunemeeke korishsha bogake'ni xeerendaan. <verse eid="JER 8:2" /><verse number="3" style="v" sid="JER 8:3" />Konne fuggoke gosa gosake ardanaa'n gateeki duuchchi, xexxeerreeneeke bonicho duuchcha'ni hedhoti hedhati iirra reyo eeyaan: hiyya'neen Duuchchi Woddik Gootti.›<verse eid="JER 8:3" /></para>
  <para style="s1">Cubbo Iyyedaggeeka Xixichcho</para>
  <para style="p">
    <verse number="4" style="v" sid="JER 8:4" />«Insa'ne hitatto qoci, Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="p" vid="JER 8:4">« ‹Manni iboole, ibeeba'ni ke'abaa?</para>
  <para style="q2" vid="JER 8:4">Manji dedhe udumi'a higoole, dedha ifikenaa'ni higaaba?<verse eid="JER 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 8:5" />Mayeeteta, kunni ardi ane'ni dudduro wirri hiyya'ne?</para>
  <para style="q2" vid="JER 8:5">Mayeete Iyyerusaalemi duuchchi wodda udumi'a higgeechchi?</para>
  <para style="q1" vid="JER 8:5">Xaqaro goggoddo godhanteen;</para>
  <para style="q2" vid="JER 8:5">aniba higa ginbe.<verse eid="JER 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 8:6" />Ani dho'o hiyye insa'ne caqasennen,</para>
  <para style="q2" vid="JER 8:6">yaane kinni dhuga'a haasonnebaan;</para>
  <para style="q1" vid="JER 8:6">Ayyaanna ifixxe balleessa'a aadde aageek hedhebaan,</para>
  <para style="q2" vid="JER 8:6">«Ani maa balleessenne?» hiyyaan.</para>
  <para style="q1" vid="JER 8:6">Bagediinba gulunfammake fadhachchishsha</para>
  <para style="q2" vid="JER 8:6">mitti mitting ifi ifinge oribaa me'a'neen.<verse eid="JER 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 8:7" />Huummo midde iimate'ni,</para>
  <para style="q2" vid="JER 8:7">ise'a murendexxa yanna egende'en;</para>
  <para style="q1" vid="JER 8:7">Faachinixxi ama, guugenjonna urungo,</para>
  <para style="q2" vid="JER 8:7">shorrinaaxxa yanna egenneen;</para>
  <para style="q1" vid="JER 8:7">Yaane kinn anki ardi,</para>
  <para style="q2" vid="JER 8:7">Duuchchi Woddike Goottika seera ege'nebaan.<verse eid="JER 8:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JER 8:8" />« ‹Borreessanjuwwi ha'nookixxi dhariinxi tiikko dhara borreessita'na hitta, «No'o beekaken,</para>
  <para style="q1" vid="JER 8:8">Duuchchi Woddike Goottika seera anfeennen» hitinata?<verse eid="JER 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 8:9" />Beekkole shookkaan,</para>
  <para style="q2" vid="JER 8:9">saliphattaan; fonxoroti abidemaan.</para>
  <para style="q1" vid="JER 8:9">Duuchchi Woddike Gootika hiyyichcho tuffaniteen,</para>
  <para style="q2" vid="JER 8:9">hitta hedheeke beekkuma anfe'e hiyyoteta?<verse eid="JER 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 8:10" />Tennexxee insa'nexxa aruwwa wele labbali'a uwwannon;</para>
  <para style="q2" vid="JER 8:10">fichchuwwa insa'neka wele bogike mani'a uwwannon;</para>
  <para style="q1" vid="JER 8:10">Shiixxokenaa'ni lumiki qico'n,</para>
  <para style="q2" vid="JER 8:10">duuchching la'o fulabaachchi'a fiidi hinaan;</para>
  <para style="q1" vid="JER 8:10">Raagolettinna qeesole ittanni</para>
  <para style="q2" vid="JER 8:10">duuchching sobaaleyyeten.<verse eid="JER 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 8:11" />Ardi anikixxa mada sholinshe uundemmaxxe;</para>
  <para style="q2" vid="JER 8:11">fayyinsa'nebaangee ci'looman;</para>
  <para style="q1" vid="JER 8:11">Nage'i hedhebang «Nage'aken, nage'aken» hinaan.<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="EZK 13:10">Hiz. 13:10</ref>. </char></note><verse eid="JER 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 8:12" />Batte yaane hunjaa wodda shoonkemma?</para>
  <para style="q2" vid="JER 8:12">Waawwo! Ijje shoonkebaan;</para>
  <para style="q1" vid="JER 8:12">Shooking maachcho kadeenxa egeneban.</para>
  <para style="q2" vid="JER 8:12">Tennexxee ibeekinn welti inbaan;</para>
  <para style="q2" vid="JER 8:12">insa'nee mura woxisanno wodda salphantaan»</para>
  <para style="q2" vid="JER 8:12">hiyya'neen Duuchchi Woddik Gootti.<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="JER 6:12-15">Erm. 6:12-15</ref>. </char></note><verse eid="JER 8:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JER 8:13" />« ‹Huccinemalcho duuchcha insa'nena'ni adhdhannon;</para>
  <para style="q2" vid="JER 8:13">hiyya'nen Duuchchi Woddik Gootti,</para>
  <para style="q2" vid="JER 8:13">woyinetike hiddichcho'ni woyinetixxi gumma hexxabaan;</para>
  <para style="q1" vid="JER 8:13">Balasetike haqichcho'n gumma afendabaan;</para>
  <para style="q2" vid="JER 8:13">shafuwwikinna harca'ee luggaan.</para>
  <para style="q1" vid="JER 8:13">Ani uwwenalchi duuchchi;</para>
  <para style="q2" vid="JER 8:13">insa'nenaa'n adhdhemaan› » hiyye.<verse eid="JER 8:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 8:14" />«Mayee'e kaba ofo'leenne?</para>
  <para style="q2" vid="JER 8:14">Mitteba bukki hiyye!</para>
  <para style="q1" vid="JER 8:14">Dalla'inke qachchuwwiba baqanto;</para>
  <para style="q2" vid="JER 8:14">oko'o marre mundo!</para>
  <para style="q1" vid="JER 8:14">No'o isi edo cubbo hunjennaxxe;</para>
  <para style="q2" vid="JER 8:14">Duuchchi Woddiki Gootti no'oki Mageni mundannoshsha no'o asseeni;</para>
  <para style="q2" vid="JER 8:14">ha'la wode'e ha'winannoshsha asse'en.<verse eid="JER 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 8:15" />No'o nage'i kadaani hine'e addanteennan;</para>
  <para style="q2" vid="JER 8:15">eloxxi yaane kinn no'o'a kaddebaani;</para>
  <para style="q1" vid="JER 8:15">Fayyatixxa yanna halchinenneni;</para>
  <para style="q2" vid="JER 8:15">yaanne kinn no'o'n raankensha calli kadde.<verse eid="JER 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 8:16" />Naaphinke fadhadixxi koqa,</para>
  <para style="q2" vid="JER 8:16">Daani'ni laqissaani;</para>
  <para style="q1" vid="JER 8:16">Insa'neke fadhadixxi himimmeettenni,</para>
  <para style="q2" vid="JER 8:16">bogi duuchchi lele'meen.</para>
  <para style="q1" vid="JER 8:16">Iikki boginna ise giddo hedheechchi duuchchi</para>
  <para style="q2" vid="JER 8:16">ookkone qachchuwwanna ise giddo he'na'neecho duuchcha</para>
  <para style="q2" vid="JER 8:16">birro'a dange.»<verse eid="JER 8:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JER 8:17" />«Kunnisee! Ha'no giddo ha'la callika bofuwwa,</para>
  <para style="q2" vid="JER 8:17">gojaameessinxi gojo dandeettabaaxxa;</para>
  <para style="q2" vid="JER 8:17">buutuwwa ha'nooba wocci assannon;</para>
  <para style="q2" vid="JER 8:17">ha'noonna idditaan»</para>
  <para style="q2" vid="JER 8:17">hiyya'neeni Duuchchi Woddiki Gootti.<verse eid="JER 8:17" /></para>
  <para style="b" />
  <para style="s1">Erimiyaasi Ardake Yaadee qico</para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JER 8:18" />Koo yaadanno wodda dayyeessitatteke;</para>
  <para style="q2" vid="JER 8:18">ani giddo hunna hexxebaan<verse eid="JER 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 8:19" />Konneechinni butta hexxeexxa anike ardixxa raare</para>
  <para style="q2" vid="JER 8:19">bayyike boganaa'ninn laqi;</para>
  <para style="q1" vid="JER 8:19">«Duuchchi Woddiki Gootti Tsiyooni hedhebaa?</para>
  <para style="q2" vid="JER 8:19">Moyanji ookko hedha'nebaa?»</para>
  <para style="b" vid="JER 8:19" />
  <para style="q1" vid="JER 8:19">«Giissendeexxe fakkuwwa insa'nexxa,</para>
  <para style="q2" vid="JER 8:19">itaani woyi fulabaake ege'nemebaake magenuwwa'ni mayee ane'e mufachchiinsa'ne?»<verse eid="JER 8:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 8:20" />«Midha yanna saxxe;;</para>
  <para style="q2" vid="JER 8:20">bonikinna uurre,</para>
  <para style="q2" vid="JER 8:20">no'o kinni anjiremmebo'non.»<verse eid="JER 8:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JER 8:21" />Ardi ank mado'a wodda,</para>
  <para style="q2" vid="JER 8:21">aninna mado'enneni;</para>
  <para style="q2" vid="JER 8:21">alayye oodhdhenneni;<verse eid="JER 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 8:22" />Gele'adi boga'ni ganaaki qorsi hedhebaa?</para>
  <para style="q2" vid="JER 8:22">Yookani okko'o ci'leessi hedhebaa?</para>
  <para style="q1" vid="JER 8:22">Ardi ankixxe mada,</para>
  <para style="q2" vid="JER 8:22">mayee fayyisaachchi gopheme?<verse eid="JER 8:22" /></para>
  <chapter eid="JER 8" />
  <chapter number="9" style="c" sid="JER 9" />
  <para style="q1">
    <verse number="1" style="v" sid="JER 9:1" />Shiyemeeke anke ardi'a</para>
  <para style="q2" vid="JER 9:1">hashsha barra oodhonna</para>
  <para style="q1" vid="JER 9:1">Maye hedhe, umi anki wodi'iinxe muume kadeel!</para>
  <para style="q2" vid="JER 9:1">Maye hedhe, ille anixxi indidottixxe muume sila kadeele!<verse eid="JER 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 9:2" />Arda anka waale bayyate me'onnaa'a,</para>
  <para style="q2" vid="JER 9:2">qiilla gammoojje'n keessummatika galduma ayyete ani'a uwwumadu!</para>
  <para style="q1" vid="JER 9:2">Duuchchiing yabaabula,</para>
  <para style="q2" vid="JER 9:2">sobi calli wo'me'eeke kadeeni!<verse eid="JER 9:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="JER 9:3" />«Insa'ne dhara haaso'ate,</para>
  <para style="q2" vid="JER 9:3">arrabo insa'neka gabetishsha qophpheessenne;</para>
  <para style="q1" vid="JER 9:3">Dhugaatite kaddebaaki,</para>
  <para style="q2" vid="JER 9:3">dharki bogake'n gurra fulle;</para>
  <para style="q1" vid="JER 9:3">Balleessande'n balleesa itti lenba'n me'ine;</para>
  <para style="q2" vid="JER 9:3">aneenna ege'na gonpheeni»</para>
  <para style="q2" vid="JER 9:3">hiyya'neeni Duuchchi Woddiki Gootti.<verse eid="JER 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 9:4" />«Mitti mitting dayyi dayyo ifinga soba'neen;</para>
  <para style="q2" vid="JER 9:4">jaaling jaalonga hamataammaxxee;</para>
  <para style="q1" vid="JER 9:4">Dayyi ifinga dayyo heqqedhowwaal,</para>
  <para style="q2" vid="JER 9:4">jaali jaalonga addatoqqe.<verse eid="JER 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 9:5" />Jaaling ifika jaalo soba'neen;</para>
  <para style="q2" vid="JER 9:5">dhugaa'a haaso'aneeki hedhebaan;</para>
  <para style="q1" vid="JER 9:5">Dhara haaso'atee arrabi insa'neki muxxe fuleeken;</para>
  <para style="q2" vid="JER 9:5">cubbo hunja'n ifi kurbu assine.<verse eid="JER 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 9:6" />Galdumi atik miicami giddon;</para>
  <para style="q2" vid="JER 9:6">insa'ne hunjammake miicaminaa'ni kexxeexxa ane'e ege'no'a hansebaan»</para>
  <para style="q2" vid="JER 9:6">hiyya'neen Duuchchi Woddik Gootti.<verse eid="JER 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 9:7" />Tennexxee Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 9:7">«Sibiliinsha insa'ne'e ca'a assannon; hega uudannon</para>
  <para style="q2" vid="JER 9:7">anke ardixxe cubbo'a,</para>
  <para style="q2" vid="JER 9:7">konnechchi gadho maa assannoo?<verse eid="JER 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 9:8" />Arrabi insa'neke qarsineeke mogidishshaten;</para>
  <para style="q2" vid="JER 9:8">sobo haaso'aan</para>
  <para style="q1" vid="JER 9:8">Duuchching jaal ifikinn welti eloxxa haaso'aan;</para>
  <para style="q2" vid="JER 9:8">godobi giddo fuggoxxinni gaadaan.<verse eid="JER 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 9:9" />Eega tenne yaane duuchchixxee ani ins'ane xixabo'noo?»</para>
  <para style="q2" vid="JER 9:9">hiyya'neen Duuchchi Woddik Goott;</para>
  <para style="q1" vid="JER 9:9">Hiyya'neen Duuchchi Woddik Gootti;</para>
  <para style="q2" vid="JER 9:9">iita hedheke arda'n ani halo fulabo'noo?<verse eid="JER 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 9:10" />Koobuwwatee woo woo hiyye oodhennen;</para>
  <para style="q2" vid="JER 9:10">qiilla gammoojje hore alla'dhinammake boonchi'a yaadaneen;</para>
  <para style="q1" vid="JER 9:10">Manji me'abaake orumma kade gateen;</para>
  <para style="q2" vid="JER 9:10">horiinxi ma'la laqendabaan;</para>
  <para style="q1" vid="JER 9:10">Ci'uwwa baajeen;</para>
  <para style="q2" vid="JER 9:10">biniichchuwwikinna baqate luggeen.<verse eid="JER 9:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="JER 9:11" />«Iyyerusaalemi oletixxe tullon;</para>
  <para style="q2" vid="JER 9:11">jeedali burraaqaxxe bakka assannon;</para>
  <para style="q1" vid="JER 9:11">Yihudiink qachchuwwi,</para>
  <para style="q2" vid="JER 9:11">manji hedhabaake ona assannon» hiyye.<verse eid="JER 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 9:12" />Tenne ege'na dande'aak beeki manji ayyete? Duuchchi Woddik Gootti ifisee'na tenne'e ca'asse kula dande'aak ayyete? Bogi mitti manjinna giddo mammaremmabaakenna qiilla gammoojje mayee kade gate? Mayee urume?<verse eid="JER 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 9:13" />Duuchchi Woddiki Goottinna hiyya'nee qici, «Tinni kaddeechchi ani uwwenneka waalle ani'a ajajema gonphemmaxxeenna galduma anka hordofa gophphemmaxxeten. <verse eid="JER 9:13" /><verse number="14" style="v" sid="JER 9:14" />Tennexxa bakka godobake'n halo abixxine annuwwi insa'nek insa'neka barsiisinemmaka Ba'aali hinaaka magenuwwa hordonfe» <verse eid="JER 9:14" /><verse number="15" style="v" sid="JER 9:15" />Tennexxee Isira'eelik Duuchchi Woddiki Gootti Magen hiyya'nee qici, «Konne arda'ni qaraartaaxxa sagale itisannon; ha'la giddo hedheeka wode'e ha'wisannon. <verse eid="JER 9:15" /><verse number="16" style="v" sid="JER 9:16" />Insa'nete kando annuwwa insa'nek egenebaake gosa gosake ard giddi'a insa'ne xeerannon; kuttiassanno qico'ni wolaatichchik insa'nee shorrannon» hiyye.<verse eid="JER 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 9:17" />Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 9:17">«Yoona, qalbeeffatte, oodhishshaaxxa melaalle ye'we</para>
  <para style="q2" vid="JER 9:17">boochchisaake muxxeera idaggaashsha asse.<verse eid="JER 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 9:18" />Insa'nenna ranke dangowwaal;</para>
  <para style="q2" vid="JER 9:18">ille no'oxxenaa'n indiddo yaataa qico'ni</para>
  <para style="q1" vid="JER 9:18">Gaari no'oki indiddoti coo'mi hiyyaa qico'n,</para>
  <para style="q2" vid="JER 9:18">no'oxxe'e boochchissowwaal.<verse eid="JER 9:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 9:19" />Tsiyooni'ni hine hunbaashshinaa qici:</para>
  <para style="q2" vid="JER 9:19">‹Fuggo inbenen!</para>
  <para style="q2" vid="JER 9:19">Yo'oshsha salphatennen!</para>
  <para style="q1" vid="JER 9:19">Minuwwi no'oki diigemeemmaxxee</para>
  <para style="q2" vid="JER 9:19">boga no'oka waalle'e me'ino› » hiyye.<verse eid="JER 9:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 9:20" />Tee melaalle, ha'no Duuchchi Woddike Goottika hiyyichcho laqqe,</para>
  <para style="q2" vid="JER 9:20">mansha ha'nooxxa isike afo'ina'ni fulaake hiyyichchi'a banne;</para>
  <para style="q1" vid="JER 9:20">Dubarte ha'nooxxi wi'lishsha,</para>
  <para style="q2" vid="JER 9:20">ha'noo giddi'ni mitti wele boochchisa barsiisse.<verse eid="JER 9:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 9:21" />Reyo mini mini hedheeshshann e'yite;</para>
  <para style="q2" vid="JER 9:21">kollifantennexxe kollobaanna gelteen;</para>
  <para style="q1" vid="JER 9:21">Oosuwwa ora orana'inn;</para>
  <para style="q2" vid="JER 9:21">dargageeyyetanna weldeena welideenana'inn bukki assine adhdhinaan.<verse eid="JER 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JER 9:22" />Hitinaa qici; «Duuchchi Woddik Gootti;</para>
  <para style="q1" vid="JER 9:22">« ‹Renshi manjiinki,</para>
  <para style="q2" vid="JER 9:22">diidake'ni hunneeke korishsha;</para>
  <para style="q1" vid="JER 9:22">Ayyinna bukki assammabaakishsha;</para>
  <para style="q2" vid="JER 9:22">midha haammaa'na udumaa ibbammaxxe deeggeshsha ibbaan› » hiyye.<verse eid="JER 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 9:23" />Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 9:23">«Beeki beekkuma ifikeni ifidukoqe'e;</para>
  <para style="q2" vid="JER 9:23">hunnaamessi ifixxe hunnanni holloqqe;</para>
  <para style="q2" vid="JER 9:23">dureessikinna afeexxe karra'ni irkatoqqe;<verse eid="JER 9:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 9:24" />Hollaaki kinn,</para>
  <para style="q2" vid="JER 9:24">ani Duuchchi Woddik Gootta kadennexxa ege'ne;</para>
  <para style="q1" vid="JER 9:24">Bogake'ni gattowwaali, dhugaanna qullumma assa'enneke kadennexxa ege'neexxi;</para>
  <para style="q2" vid="JER 9:24">tenneni hollowwaali; ani tenne yaanuwwa'ni gammadannon»</para>
  <para style="q2" vid="JER 9:24">hiyya'neen Duuchchi Woddike Gootti.<note caller="-" style="x"><char style="xo" closed="false">9:24 </char><char style="xt" closed="false"><ref loc="1CO 1:31">1 Qor. 1:31</ref>; <ref loc="2CO 10:17">2 Qor. 10:17</ref>. </char></note><verse eid="JER 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 9:25" />Duuchchi Woddiki Gootti hiyya'nee qici: «Summi cali'a jila ofo'leeka duuchcha xixannoxxe barra daggaan; <verse eid="JER 9:25" /><verse number="26" style="v" sid="JER 9:26" />Insa'nenna, Gibtseeka, Eedoomika, Amoonika Yihudaka, Mo'aabikanna umo ifika qooxo haaxxe qiilla gammoojje hedha'neeki kunni ardi duuchchi dhugaatixxa jila ofo'le gopheemmaxxee; iitan Isira'eelik gosa gosak ardinna dhugaatixxa jila ofo'la gophemmaxxee duuchchinga mitte bifanni xixaannon» hiyye.<verse eid="JER 9:26" /></para>
  <chapter eid="JER 9" />
  <chapter number="10" style="c" sid="JER 10" />
  <para style="s1">Dhariinxa Magenooffachchonna Dhugaatixxa Magenooffachcho</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 10:1" />Koo Isira'eelike ardaa; Duuchchi Woddiki Gootti ha'no'a hiyya'neexxa laqqe; <verse eid="JER 10:1" /><verse number="2" style="v" sid="JER 10:2" />Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 10:2">«Wele gosa gosake ardika galduma hordofinoqqe'e;</para>
  <para style="q2" vid="JER 10:2">insa'ne iimatika beessisuwwa sodaantaan;</para>
  <para style="q2" vid="JER 10:2">ha'no kinni weekendinoqqe.<verse eid="JER 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 10:3" />Wele ardiki galdumi toliinken;</para>
  <para style="q2" vid="JER 10:3">haqqe gongomakenaa'ni wonxaan;</para>
  <para style="q2" vid="JER 10:3">haqqe boce giissammaki manni seesa giisaan;<verse eid="JER 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 10:4" />Insa'nenna biretike siblininna woriqeti itti hana seesa giissinaan;</para>
  <para style="q2" vid="JER 10:4">ibabaashsha,</para>
  <para style="q2" vid="JER 10:4">misimaare faaseti ganne abidinsaan.<verse eid="JER 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 10:5" />Fakkuwwa insa'nexxi baaquluwwinke fichchi giddo ci'a sodaachchissatee giissinne uurrissa'nemman;</para>
  <para style="q2" vid="JER 10:5">insa'nennaa haaso'atik dande'a anfebaan;</para>
  <para style="q1" vid="JER 10:5">Me'a dande'a gonphammaxxee,</para>
  <para style="q2" vid="JER 10:5">utuphi insa'ne'a hasisaan;</para>
  <para style="q1" vid="JER 10:5">Manjo miidha yookaani la'o uwwachchuwwa kadagophphemmaxxee</para>
  <para style="q2" vid="JER 10:5">konnechchuwwa haranga sodatinoqqe'e» hiyye.<verse eid="JER 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 10:6" />Ee Duuchchi Woddike Goottaa: atishsha hedheek ijje hedhebaan;</para>
  <para style="q2" vid="JER 10:6">ati lumoken;</para>
  <para style="q2" vid="JER 10:6">atiki summik baalomi lumoken.<verse eid="JER 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 10:7" />Koo gosa gosa duuchchike moyanjoo;</para>
  <para style="q2" vid="JER 10:7">ata'e sodatabaaki ayyete?</para>
  <para style="q2" vid="JER 10:7">Ulfinni ati'a hasisaammaxxee.</para>
  <para style="q1" vid="JER 10:7">Buttatixxe beekkole duuchchina'ni</para>
  <para style="q2" vid="JER 10:7">insa'nek moyanjuwwi duuchchi giddo</para>
  <para style="q2" vid="JER 10:7">atishsha hedheek hedhebaan.<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="REV 15:4">Wal. 15:4</ref>. </char></note><verse eid="JER 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 10:8" />Woyi fulabaaxxe haqichchiinxi fakkexxa baranno barataak duuchchi;</para>
  <para style="q2" vid="JER 10:8">insa'ne gowwooletenna hawwawwaken.<verse eid="JER 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 10:9" />Ganganne giissineexxi birretik sibilji Terseesii'ni</para>
  <para style="q2" vid="JER 10:9">worqetinna Afeezii'ni daggaan.</para>
  <para style="q1" vid="JER 10:9">Angatixe ogekinna baqise giissammak hunjeemmachcho,</para>
  <para style="q2" vid="JER 10:9">beetto giissitemmachcho duuchcha,</para>
  <para style="q2" vid="JER 10:9">cuqullitenna baddeessitte seemma fuganteen.<verse eid="JER 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 10:10" />Duuchchi Woddiki Gootti dhugaatike Magenon;</para>
  <para style="q2" vid="JER 10:10">Isi hedhaake Mageno, duuchchi woddike moyanjon;</para>
  <para style="q1" vid="JER 10:10">Mufataa wodda butta shekesheke hitaan,</para>
  <para style="q2" vid="JER 10:10">mootummuwwatinna mufe isixxa hoyya dandeettabaan.<verse eid="JER 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 10:11" />«Ha'noonna, ‹Kunniir iimuwwatanna butta dadebaak dharichchi magenuwwi buttatenaa'ninna iimaatenaa'n ba'aan› hitinaan» hiyye.<verse eid="JER 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 10:12" />Duuchchi Woddik Gootti kinn boga hunna ifixxinna dade;</para>
  <para style="q2" vid="JER 10:12">butta duuchcha beekkumi ifikenni ofo'lishshe</para>
  <para style="q2" vid="JER 10:12">iimuwwatanna ege'na ifixenni dhise.<verse eid="JER 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 10:13" />Hafuur isiki dindimaa wodda</para>
  <para style="q2" vid="JER 10:13">iimuwwate'ni hedheeki bukki hiyyaan;</para>
  <para style="q2" vid="JER 10:13">hurre buttatixxe gabalabaa'ni iimi'a me'itaashsha assaan;</para>
  <para style="q1" vid="JER 10:13">Bange xeenixxa duuka ibbaashsha assaan;</para>
  <para style="q2" vid="JER 10:13">diidallotanna tuulemmabaa'ni fulchaan.<verse eid="JER 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 10:14" />Mitti mitting gowwooletenna ege'na afebaakeran.</para>
  <para style="q2" vid="JER 10:14">Worqe baqise giissammakir hujammaxxe fakkuwa'ni shooke'en;</para>
  <para style="q1" vid="JER 10:14">Bonce giissinemmaxxi fakkuwwa dhariinxen;</para>
  <para style="q2" vid="JER 10:14">hafuurakanna afeerabaan.<verse eid="JER 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 10:15" />Kunnichuwwi la'o afebaake mi'uwwan</para>
  <para style="q2" vid="JER 10:15">murte insa'ne'ni murendaa wodda ba'naani.<verse eid="JER 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 10:16" />Ya'iqoobik Magen kinni konneechuwwishatebaan;</para>
  <para style="q2" vid="JER 10:16">Isi duuchhcingechcho dadeeken.</para>
  <para style="q1" vid="JER 10:16">Isira'eeliki ardinna geego isiken.</para>
  <para style="q2" vid="JER 10:16">Summi isikinna Duuchchi Woddike Gootta Magenon.<verse eid="JER 10:16" /></para>
  <para style="s1">Daga'neeka Shorrichcho</para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 10:17" />Ati erqe kayyii'ni buqendeexxi;</para>
  <para style="q2" vid="JER 10:17">hexxemmabaa'ni karra atixxa bukki asse'dhi.<verse eid="JER 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 10:18" />Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q2" vid="JER 10:18">«Konne boga'ni hedha'neeka</para>
  <para style="q2" vid="JER 10:18">ta'a tennee gadhi'a fugussannon;</para>
  <para style="q1" vid="JER 10:18">Miidhensha insa'ne'ni laqendaashsha,</para>
  <para style="q2" vid="JER 10:18">rakkote'ni insa'nee ibisannon»<verse eid="JER 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 10:19" />Aane enqensha anxe;</para>
  <para style="q2" vid="JER 10:19">mada anxinna fayyitaaxxebaan</para>
  <para style="q1" vid="JER 10:19">Kaddo malee'e ani ifi'an</para>
  <para style="q2" vid="JER 10:19">«tinni anixxe dhibeen</para>
  <para style="q2" vid="JER 10:19">dande'a ani'a hasissaan»<verse eid="JER 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 10:20" />Dunkaanna ankanna oltatee;</para>
  <para style="q2" vid="JER 10:20">goluwwi anki duuchcha kukkutendeen;</para>
  <para style="q1" vid="JER 10:20">Oose ane'e waalde me'ite'en, higgabaan;</para>
  <para style="q2" vid="JER 10:20">dunkaan anka oltonnaa;</para>
  <para style="q2" vid="JER 10:20">goluwwa anka gollatee mittikinna midde gateeki hedhebaan.<verse eid="JER 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 10:21" />Allalisano wodana affeexxebaan;</para>
  <para style="q2" vid="JER 10:21">Duuchchi Woddika Gootta laqennabaan</para>
  <para style="q1" vid="JER 10:21">Tennexxee insa'ne'a qajeeldebaan</para>
  <para style="q2" vid="JER 10:21">bobba'ikinninna xeereme'en.<verse eid="JER 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 10:22" />Middi boganaa'ni lummoxxi weekensha</para>
  <para style="q2" vid="JER 10:22">kadda'neexxe oodhishshatixxa odo caqasse</para>
  <para style="q1" vid="JER 10:22">Yihudiink qachchuwwi urumme</para>
  <para style="q2" vid="JER 10:22">jeedaluwwinke galduma assaan.<verse eid="JER 10:22" /></para>
  <para style="s1">Ermiyaasixxa Soodachcho</para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 10:23" />Ee Duuchchi Woddike Goottaa manjiinxi hedho ifixxe anga'ni hexxemmabaashsha,</para>
  <para style="q2" vid="JER 10:23">ora ifika ifixxe hunnan qajeelcha</para>
  <para style="q2" vid="JER 10:23">dande'abaaxxa ege'ne'ennen.<verse eid="JER 10:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 10:24" />Ee, Duuchchi Woddike Goottaa; ane'ni mura ibisi; heenoo qicinni anee xixi malee'e</para>
  <para style="q2" vid="JER 10:24">ijje ba'abe'noshsha,</para>
  <para style="q2" vid="JER 10:24">mufe atixxenni ane'ni daggoxxe'e.<verse eid="JER 10:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 10:25" />Mufe atixxa ate ege'nebaakenna,</para>
  <para style="q2" vid="JER 10:25">gibaake gosa gosake arda'n lolaasi;</para>
  <para style="q1" vid="JER 10:25">Kunni ardi atika arda bire'eken;</para>
  <para style="q2" vid="JER 10:25">no'o duuchchingi bakka ba'nanoshsha asseexxi boga'no'oka duwwi gatise'en.<verse eid="JER 10:25" /></para>
  <chapter eid="JER 10" />
  <chapter number="11" style="c" sid="JER 11" />
  <para style="s1">Erimiyaasinna Magenxa Kako Aaga</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 11:1" />Duuchchi Woddiki Gootti Ermiyaasii'n hiyyee qici konnechchinni butti'a hedheen: <verse eid="JER 11:1" /><verse number="2" style="v" sid="JER 11:2" />«Tenne kakoka hiyyichcho caqasi; Yihudake ardi'anna Iyyerusaalemike hedha'neek manni'a kuli, <verse eid="JER 11:2" /><verse number="3" style="v" sid="JER 11:3" />Isira'eelik Duuchchi Woddiki Gootti Magen hiyya'neen hitatto qici: ‹Konne kakotike hiyyichi'a ajajemabaak manji badinemeeke kadowwaal; <verse eid="JER 11:3" /><verse number="4" style="v" sid="JER 11:4" />Kunni ajajinna edike ha'nooaka annuwwa Gibtseeke boganaa'ni, sibilo baqinsammaxxa laangonaa'ni fulchennexxa yanna insa'ne ajajenneken› Aninna insa'ne, ‹ani'a ajajendine ajaja anka duuchcha asse; ha'no anke arda kaddinaan; aninna ha'nooke Mageno kadannon. <verse eid="JER 11:4" /><verse number="5" style="v" sid="JER 11:5" />Telchonna kaddemmashshanni shamoka boga edike annuww ha'nooke uwwonaa kakatennaxxa kako muuxannon› » hiyyeen hitine kulle.</para>
  <para style="p" vid="JER 11:5">Aninna, «Duuchchi Woddike Gootta kadduun» hiyye hiissennen.<verse eid="JER 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 11:6" />Duuchchi Woddiki Gootti anee hiyyee qici, «Konne hiyyichcho duuchcha Yihudiinke qachchuwwa'ninna Iyyerusaalemike oruwwa'ni marte hitatto qici ‹Tenne kakoka hiyyichcho caqasse; hujete'ni hosisse. <verse eid="JER 11:6" /><verse number="7" style="v" sid="JER 11:7" />Edika annuwwa ha'nooka Gibtseeke bogana'n fulchennexxe yannanaa'ni telchi qico'ni «ani'a ajejemme» hiyye lebe ha'noo'o xexxe'achchiseennan. <verse eid="JER 11:7" /><verse number="8" style="v" sid="JER 11:8" />Insa'ne kinn halo godoba uggudhine xaqaro me'ine malee'e ani'a ajajemmebaann, ani hiyyenexxa lanqebaan; tennexxee anee hordofaashsha ajaje'naa assinebaaxxa tenne kakoka duuchcha insa'ne'ni ibisenneen› » hiyye.<verse eid="JER 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 11:9" />Duuchchi Woddiki Gootti ane'e hiyye qici, «Yihudakenna Iyyerusaalemike arda'ni ane'ni holleen. <verse eid="JER 11:9" /><verse number="10" style="v" sid="JER 11:10" />Hiyyichcho anka laqa gibemmake edike insa'neke annuwwishshanni cubbo hunjeen; wele mageno magenooffo'a hordonfe; Isira'eelikinn Yihudiinki ardi edike annuwwi insa'nekinn welti aagennexxa kako diinge. <verse eid="JER 11:10" /><verse number="11" style="v" sid="JER 11:11" />Tennexxee Duuchchi Woddiki Gootti hiyya'ne qici: ‹Ani baqante fullabaaxxa ba'ne insa'ne'ni idagannon; anibaa raarrolenna insa'nexxa raare laqabo'non. <verse eid="JER 11:11" /><verse number="12" style="v" sid="JER 11:12" />Yihudiinki qachchuwwinna Iyyerusaalemik ardi hixaana guphphinammake magenuwibaa me'ine raaranni iikki magenuwwi insa'ne rakkantaa wodda hara insa'nee gargaara dande'abaan. <verse eid="JER 11:12" /><verse number="13" style="v" sid="JER 11:13" />Koo, Yihuda atike magenuwwik laakkosi atike qachchuwwik laakkosi maree geyeexxe qixxeshshann geyeen; shookishshaaxxe fakkuwwa'a, Ba'aali hiyyemmaake dharichcha magenuwwi'a hixaana gubbammachcho giissitetteki; tolchimmalchi laakossi Iyyerusaalemik oruwwi geyeeshshanni geyeen› hiyye.<verse eid="JER 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 11:14" />«Rakkante anibaa raarraa wodda aninna laqabo'non; atinna konne ardi'a soodattoxxe, kadhatanna kadhattoxxee, aneenna yexxoxxe.<verse eid="JER 11:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 11:15" />«Anixxi jaalo, heddimannin welti xaqaro hujja'ni,</para>
  <para style="q2" vid="JER 11:15">anke mini giddo maa yaada affe'e?</para>
  <para style="q1" vid="JER 11:15">Werreeg yookaan tolchiink maali</para>
  <para style="q2" vid="JER 11:15">xixenshatenaa'n ate'e gatisaa?</para>
  <para style="q2" vid="JER 11:15">Konnechchuwwa assite gammada dandeetatto?»<verse eid="JER 11:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JER 11:16" />Duuchchi Woddik Gootti Eloxxa gumma afeeke,</para>
  <para style="q2" vid="JER 11:16">shafi callike ejersinke haqichcho ise'a hiyyeemman;</para>
  <para style="q1" vid="JER 11:16">Ta'a kinn jabaxxe hobonbalteke hafuurinni</para>
  <para style="q2" vid="JER 11:16">giira ise'ni ha'ishaan</para>
  <para style="q2" vid="JER 11:16">damuwwatinna enqedaan.<verse eid="JER 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 11:17" />Isira'eelikinna Ya'iqoobik mini Ba'aali hinaake magenuwwi'a hixaana gunbe hunjeexxe fuggoxxe hujenni anee'e mufachchiisemmaxxee; atee haqichchinsha karseek Duuchchi Woddiki Gootti Magen fuggoxxa ate'a lallabeen.<verse eid="JER 11:17" /></para>
  <para style="s1">Ermiyaasi Shiyatee'e Mari'anteexxa Mari'e</para>
  <para style="p">
    <verse number="18" style="v" sid="JER 11:18" />Duuchchi Woddik Gootti insa'ne sho'ik assino'a hendeexxa ani'a farri asse; aninna ege'neenneni; eettene yanna'n huje insa'nexxa ane'ni leellisheemman. <verse eid="JER 11:18" /><verse number="19" style="v" sid="JER 11:19" />Aninna dullo'a adhdhine me'inammake beltanjishshatemman; insa'nenna,</para>
  <para style="q1" vid="JER 11:19">«Haqichcho gummandinn karro;</para>
  <para style="q2" vid="JER 11:19">hedhoti he'nammaxxe buttana'n balleesino</para>
  <para style="q2" vid="JER 11:19">konnechchinn edi'a summi dedhemuun»</para>
  <para style="q2" vid="JER 11:19">hine ani'a mari'anteexxa ege'neennabaan.<verse eid="JER 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 11:20" />Manjiinka godobanna wodana memmekisse affaattek;</para>
  <para style="q2" vid="JER 11:20">qullumati murtattoke dada duuchchik lumoke Duuchchi Woddike Gootta;</para>
  <para style="q1" vid="JER 11:20">Yaane anixxa ate'ni uggudhdheennen;</para>
  <para style="q2" vid="JER 11:20">insa'ne'ni fuldaattexxa halo uudo.<verse eid="JER 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 11:21" />«Yoona hedho ifixxa balleesso'a hasa'neekenna ‹Duuchchi Woddike Goottike summinni raaga raagginoqqe; kada gophphoole anga no'oxxe'ni womikaddatton› hiyya'neeke Anaatootike manni'a Duuchchi Woddik Gootti hiyya'nee qici; <verse eid="JER 11:21" /><verse number="22" style="v" sid="JER 11:22" />Tennexxee dada duuchcha ajajaaki Duuchchi Woddik Gootti ‹Ani insa'ne'e xixannon lumolla insa'neka wolaantichchik, labbaxxinna meyyaxxi oosuwwa insa'nexxi solo'ik rertaan. <verse eid="JER 11:22" /><verse number="23" style="v" sid="JER 11:23" />Xixemaaxxe wogga'ni Anaatootike manna'n bala insa'ne'ni ibisaannaxxee insa'ne giddii'ni mitti manji midde gatabaan› » hiyye.<verse eid="JER 11:23" /></para>
  <chapter eid="JER 11" />
  <chapter number="12" style="c" sid="JER 12" />
  <para style="s1">Ermiyaasixxa Gungunso</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 12:1" />Ee, Duuchchi Woddike Gootta; yaane anixxa ati edo shiqishennek,</para>
  <para style="q2" vid="JER 12:1">ati qullishshake kaddettexxa ege'na'needen;</para>
  <para style="q1" vid="JER 12:1">Fuggaaleeyyetee yaane duuchchi qajeelda'neechchi mayeete?</para>
  <para style="q2" vid="JER 12:1">Cubbaaleeyyetee galdumi elegopheechchi maayeete?<verse eid="JER 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 12:2" />Ati insa'nee kaasseeten; insa'nenna hidda oltinne'en</para>
  <para style="q2" vid="JER 12:2">nophphinee; gummanna gumminseen.</para>
  <para style="q1" vid="JER 12:2">Duuchchi Wodda ate'e afo'i callinni ulfeessina'neen</para>
  <para style="q2" vid="JER 12:2">qalbeti kinni atinni he'nebaan.<verse eid="JER 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 12:3" />Ee Duuchchi Woddike Goottaa; ati ane'e egende'etten; uuddatteni;</para>
  <para style="q2" vid="JER 12:3">ani ati'a afeenneka yaada memmekisse affaatten.</para>
  <para style="q1" vid="JER 12:3">Dulokee adhdhine me'inammake gedhebishsha insa'nee oofi;</para>
  <para style="q2" vid="JER 12:3">duliinxe barra qico'n qofin foyi.<verse eid="JER 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 12:4" />Bogi xeena gophe gubata'neechchi?</para>
  <para style="q2" vid="JER 12:4">Badda'a duuchcha bagge gattaaki, haani qico'nite?</para>
  <para style="q1" vid="JER 12:4">Ookko hedha'neeke mannixxe fuggona'ni kexxeexxa</para>
  <para style="q2" vid="JER 12:4">horkinna ci'uwwa kutti hiyyeen;</para>
  <para style="q1" vid="JER 12:4">Ardi,</para>
  <para style="q2" vid="JER 12:4">«No'o'ni kaddaaxxa uuda'nebaan» hiyye'en.<verse eid="JER 12:4" /></para>
  <para style="s1">Mageniinka Hiissichcho</para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 12:5" />Duuchchi Woddiki Gootti hiyya'nee qici: «Gongaake mannin gongitee'na</para>
  <para style="q2" vid="JER 12:5">insa'ne atee injifantoole;</para>
  <para style="q2" vid="JER 12:5">fadhado gulufaake manninni welti hitta hokkokisa dandeetatto?</para>
  <para style="q1" vid="JER 12:5">Nage'ii boga'ni dandeette uurra gophphottole</para>
  <para style="q2" vid="JER 12:5">Yordaanoosike gongomi giddo hitta uuritatto?<verse eid="JER 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 12:6" />Dayyuwwi atikinna atiki mini hadi,</para>
  <para style="q2" vid="JER 12:6">insa'ne midde ate'ni fuggoxxinni</para>
  <para style="q2" vid="JER 12:6">ate'n cancinna'neen;</para>
  <para style="q1" vid="JER 12:6">Eloxxa atixxa haasonoolenna midde</para>
  <para style="q2" vid="JER 12:6">insa'ne addattoxxee.<verse eid="JER 12:6" /></para>
  <para style="s1">Ardiinxe Ballessa'a Duuchchi Woddika Gootta Yaadisee qico</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JER 12:7" />«Mine ankanna karra anixxa wocci asse waaleennen</para>
  <para style="q2" vid="JER 12:7">anka qadaada hunanno;</para>
  <para style="q1" vid="JER 12:7">Eeyyaannexxa iseen;</para>
  <para style="q2" vid="JER 12:7">naaphiinxe anga'ni sa'isse uwwannon.<verse eid="JER 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 12:8" />Anke geego kadeeki ardi anki, badda'ate'ni hedheeke neenqishsha</para>
  <para style="q2" vid="JER 12:8">ane'ni ke'e;</para>
  <para style="q1" vid="JER 12:8">Ane'ni raaren;</para>
  <para style="q2" vid="JER 12:8">tennexxee isoo gibennen.<verse eid="JER 12:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 12:9" />Anka geego wele joluwwa,</para>
  <para style="q2" vid="JER 12:9">itto'a buqqeexxe,</para>
  <para style="q2" vid="JER 12:9">ciichcho kaddeeba?</para>
  <para style="q1" vid="JER 12:9">Martine; biniichchuwwa duuchcha bukki asse;</para>
  <para style="q2" vid="JER 12:9">insa'neenna itto'a iyyedagge.<verse eid="JER 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 12:10" />Heddo allalisano anixxa woyinetike hiddichchika booncho balleessite'en;</para>
  <para style="q2" vid="JER 12:10">fichcha ankanna hirbeessineen;</para>
  <para style="q1" vid="JER 12:10">Ani gammadannaka boga anka,</para>
  <para style="q2" vid="JER 12:10">urmake assinaan.<verse eid="JER 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 12:11" />Ani edo urma,</para>
  <para style="q2" vid="JER 12:11">qiilla gammoojjenna onake kade gataan;</para>
  <para style="q1" vid="JER 12:11">Iikki bogi duuchchi gongomake kadaan;</para>
  <para style="q2" vid="JER 12:11">konne bogi'a mittikinna aane'e hiyyaaki hedebaan.<verse eid="JER 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 12:12" />Qilla gammoojje'ni hedheeka uruma tuluchchuwwa,</para>
  <para style="q2" vid="JER 12:12">balleessaaki manni dagaan;</para>
  <para style="q1" vid="JER 12:12">Duuchchi Woddiki Goottiki wolaantichchi kasa bogiikenaa'ni kasii qico'ni;</para>
  <para style="q2" vid="JER 12:12">mittekanna gatisebaang biraan;</para>
  <para style="q2" vid="JER 12:12">gataakinna hedhebaan.<verse eid="JER 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 12:13" />Dinne wiilse'naa'ni ute haa'minaani;</para>
  <para style="q2" vid="JER 12:13">yo'oshsha eloonnani alifinaachchi kinn hedhebaan;</para>
  <para style="q1" vid="JER 12:13">Duuchchi Woddike Goottixxe jabaxxe mufenaa'ni kexxeexxa</para>
  <para style="q2" vid="JER 12:13">midha baxxemmaxxee shookkinaan» hiyye.<verse eid="JER 12:13" /></para>
  <para style="s1">Duuchchi Woddiki Gootti Isira'elke Oolla'ike Bogixxe'e Haaso'eka Haaso'a</para>
  <para style="p">
    <verse number="14" style="v" sid="JER 12:14" />Duuchchi Woddiki Gootti hiyya'nee qici, «Arda anke Isira'eeli uwweennaka geego abidaaka fuggoka insa'neka olla'a duuchcha; boga insa'nekenaa'n shorrannon; Yihudiinka arda insa'ne giddii'ni fulchannon; <verse eid="JER 12:14" /><verse number="15" style="v" sid="JER 12:15" />Bogii'n fulchennechchi uduma kinni haaroba'a gattowwaal hiyyannon; duuchhcinga arda ifi ifike bogibaanna geegiba idagee hiissannon. <verse eid="JER 12:15" /><verse number="16" style="v" sid="JER 12:16" />Anke ardika me'injo baranteelenna arda anka Ba'aali hiyyemake magenuwwike summinn kakachchiisemmashshann, ‹Hedhaaki Duuchchi Woddike Goottike summin› hine anke summin kakantoole; ookkone wodda anke ardi giddo he'naashsha assannon. <verse eid="JER 12:16" /><verse number="17" style="v" sid="JER 12:17" />Ani hiyyaannexxa laqabaaka arda kinn mitti gatebaang shorrannon bakka isexxa balleesaannon» hiyya'neen Duuchchi Woddike Gootti.<verse eid="JER 12:17" /></para>
  <chapter eid="JER 12" />
  <chapter number="13" style="c" sid="JER 13" />
  <para style="s1">Layinotixxe Seemmann Giissemeeka Hanfala</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 13:1" />Duuchchi Woddiki Gootti ane'e «Layinotixxe seemmanni giissemeeka hanfala marte hidhdhi; hidhakanna usudhdhi; yaane kinn wode'e tuqissoxxe» ane'e hiyye. <verse eid="JER 13:1" /><verse number="2" style="v" sid="JER 13:2" />Tennexxee Duuchchi Woddiki Gootti anee ajejemmashshanni hanfalakanna hidhenne hidhake'ninna usudhenne. <verse eid="JER 13:2" /><verse number="3" style="v" sid="JER 13:3" />Duuchchi Woddiki Gootti hiyyichchi higee aniba dageexxi, <verse eid="JER 13:3" /><verse number="4" style="v" sid="JER 13:4" />«Hidhdhite ka'littetaka hanfala adhdhite Efiraaxisi'a me'i; ookko'ona kinjiinke holli giddo iso'o sho'i» hiyye. <verse eid="JER 13:4" /><verse number="5" style="v" sid="JER 13:5" />Tennexxe'a Duuchchi Woddiki Gootti ane'e ajejemaashshann Efiraaxisi marennexi iso'o sho'eneni.<verse eid="JER 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 13:6" />Heddo barra uduma Duuchchi Woddiki Gootti «Kexxetexxi Efiraaxisi'a me'i ookko'o sho'i hiyyennaka hanfala aaxxe dag» anee'e hiyye. <verse eid="JER 13:6" /><verse number="7" style="v" sid="JER 13:7" />Aninna Efiraaxisi'a mare hanfala sho'ennabaa'n ume fulchennen; hanfalkinna kukkuteme ba'eemman.<verse eid="JER 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 13:8" />Duuchchi Woddike Goottik hiyyichchi anibaa dageexxi, <verse eid="JER 13:8" /><verse number="9" style="v" sid="JER 13:9" />«Duuchchi Woddik Gootti hiyyee qici ‹Yihudiinke ardixxa hullanna Iyyerusaalemike ardika mittooma konneechchishshann balleessannon. <verse eid="JER 13:9" /><verse number="10" style="v" sid="JER 13:10" />Hiyyichcho anka laqa ginbe godoba xaqaro uggudhdhine mammaremati heeshshi qokki hina'n magenooffanto'a wele fakkuwwa hordofaaki Kunni fuggichchi ardi konne kukkuteme ba'eke sabbatishsha ittan ba'naani. <verse eid="JER 13:10" /><verse number="11" style="v" sid="JER 13:11" />Hanfala hidhake'n usudhdhinammashann Isira'eeliki ardi duuchchinna Yihudiink ardi aninni welti mittoome summa ankee galatakanna ulfinna anke arda kadaashsha assedheennan; anki ardi kinni laqebaan› hiyya'neen Duuchchi Woddik Gootti.<verse eid="JER 13:11" /></para>
  <para style="s1">Woyinetixxe Bookaka Waaba</para>
  <para style="p">
    <verse number="12" style="v" sid="JER 13:12" />«Duuchchi Woddiki Gootti Magen insa'ne hiyya'neeqic, ‹Waabi duuchchi woyinetixxe bookanni wo'maan› hiyya'neen. Insa'nenna ‹Waaba duuchcha'n woyinetixxi booka wo'mataaxxa egenebe'nochcho ate'n labbe?› atee hinoole; <verse eid="JER 13:12" /><verse number="13" style="v" sid="JER 13:13" />Insa'nee hitattoqic, ‹Duuchchi Woddiki Goottinna Daawwitixxe moote'ni ofolda'neexxa moyanjuwwa, qeesole raagole, Iyyerusaalemii hedha'neeka arda duuchcha ittanni konne boga'ne hedha'neeke duuchcha machchoosannon. <verse eid="JER 13:13" /><verse number="14" style="v" sid="JER 13:14" />Mitti mitteke'ne anna beltoke'ni ke'isannon; hiyya'neen Duuchchi Woddik Gootti; marartebelonna gattowwaal belo insa'ne birannon› » hiyye.<verse eid="JER 13:14" /></para>
  <para style="s1">Shorrichchi Dagaake'e Xexxee'achchiissa</para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 13:15" />Duuchchi Woddiki Gootti haaso'edheen,</para>
  <para style="q2" vid="JER 13:15">laqqe, godoba galchedhdhe,;</para>
  <para style="q2" vid="JER 13:15">holla waalle.<verse eid="JER 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 13:16" />Dukkansebaang,</para>
  <para style="q2" vid="JER 13:16">dukkandaaxxe koobuwwa'n</para>
  <para style="q1" vid="JER 13:16">Ha'noxxi lekkuwwa guggufattinebang,</para>
  <para style="q2" vid="JER 13:16">Duuchchi Woddika Gootta ha'nooka Mageno ulfeesse.</para>
  <para style="q1" vid="JER 13:16">Ha'no ifa addatina,</para>
  <para style="q2" vid="JER 13:16">isi kinni ifa dukkanate'n jijjiira;</para>
  <para style="q2" vid="JER 13:16">dimma dukananna assaan.<verse eid="JER 13:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 13:17" />Lanqabe'no hitineexxe kaddoole kinni</para>
  <para style="q2" vid="JER 13:17">holla ha'nooxxe'e ille anxi,</para>
  <para style="q2" vid="JER 13:17">sho'ondee ooxxaa;</para>
  <para style="q1" vid="JER 13:17">Duuchchi Woddike Goottiki ardi booji'emeemmaxxe'e</para>
  <para style="q2" vid="JER 13:17">ille anxi hiiqqise oodhannen;</para>
  <para style="q2" vid="JER 13:17">indiddo anixxinna ca'li hite'e dunedaan.<verse eid="JER 13:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JER 13:18" />Moyanjokena mootittete ittanni moyanjinxe ama,</para>
  <para style="q2" vid="JER 13:18">«Ulfinnink ha'nook kallachchi</para>
  <para style="q1" vid="JER 13:18">Ha'noona'ni ibammaxxe</para>
  <para style="q2" vid="JER 13:18">moote ha'noxxenaa'n dirre» hiyye.<verse eid="JER 13:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 13:19" />Negeebi hedheeki qachchuwwi cufemaan;</para>
  <para style="q2" vid="JER 13:19">ayyinna iso'o banaaki hedhebaan</para>
  <para style="q1" vid="JER 13:19">Yihudiinki ardi duuchchi booji'eman luggaan;</para>
  <para style="q2" vid="JER 13:19">duuchching hedheshshanni cufema.<verse eid="JER 13:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 13:20" />Tee Iyyerussaalem, ille hanoxxenni kokkine,</para>
  <para style="q2" vid="JER 13:20">middii'n daga'neeka naaphuwwa uude.</para>
  <para style="q1" vid="JER 13:20">Ati'a uwwemeek bobba'a;</para>
  <para style="q2" vid="JER 13:20">kubbissaattaki atiki gedheb haba hedhee?<verse eid="JER 13:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 13:21" />Jaaluwwa atike kado'a</para>
  <para style="q1" vid="JER 13:21">Barsisetakir,</para>
  <para style="q2" vid="JER 13:21">ate'een moyaa wodda maa hitatto?</para>
  <para style="q1" vid="JER 13:21">Ildammaxxe manjichchoshsha</para>
  <para style="q2" vid="JER 13:21">ciniinfattaboxxe?<verse eid="JER 13:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 13:22" />«Tinni ane'ni gelteechchi mayeete?» hitettexxi</para>
  <para style="q2" vid="JER 13:22">ifi qo'litottole,</para>
  <para style="q1" vid="JER 13:22">Seemma darendee'na duwwi saalibelo gattettechchi</para>
  <para style="q2" vid="JER 13:22">barse uuddetechchi,</para>
  <para style="q2" vid="JER 13:22">cubbo atixxi bira saxxemmaxxeeten.<verse eid="JER 13:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 13:23" />Tophiyiink manji bifa ifixxa,</para>
  <para style="q2" vid="JER 13:23">qeedhanchi barro ifixxa jijjiidhdha dande'a?</para>
  <para style="q1" vid="JER 13:23">Ha'no elobaaxxa assa baratineemmaxxe'e</para>
  <para style="q2" vid="JER 13:23">eloxxa assa dandeetinabaan.<verse eid="JER 13:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="JER 13:24" />«Qiila gammoojjexxi diidallo huura xeerte birtammashsha</para>
  <para style="q2" vid="JER 13:24">ittanni aninna ha'noo xeerannon.<verse eid="JER 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 13:25" />Anee deete;</para>
  <para style="q2" vid="JER 13:25">woyi fulabaaka magenuwwa addatteettaxxee;</para>
  <para style="q1" vid="JER 13:25">Ati'a lallabeennaka</para>
  <para style="q2" vid="JER 13:25">atika qoobbi mureennen»</para>
  <para style="q2" vid="JER 13:25">hiyya'neen Duuchchi Woddik Gootti.<verse eid="JER 13:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 13:26" />«Saali atik leellashsha,</para>
  <para style="q2" vid="JER 13:26">seemma atixxa quncise duwwi gatisannon.<verse eid="JER 13:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 13:27" />Tulluwwate'ninna diiduwwake'ni,</para>
  <para style="q2" vid="JER 13:27">battitte atixxa huje,</para>
  <para style="q1" vid="JER 13:27">Yabaabulletee affeettaxxe yortenni,</para>
  <para style="q2" vid="JER 13:27">shookibelo yabaabulda'na uudennen.</para>
  <para style="q1" vid="JER 13:27">Tee Iyyerusaalemi ati'a aanne'e!</para>
  <para style="q2" vid="JER 13:27">Battummatenaa'n hanoo qulloondattota?»<verse eid="JER 13:27" /></para>
  <chapter eid="JER 13" />
  <chapter number="14" style="c" sid="JER 14" />
  <para style="s1">Bange, Beela, Wolaantichcha</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 14:1" />Bangetixxee Ermiyaasi'ni Duuchchi Woddiki Gootti hiyyeeki hiyyichchi konneechchinn butti'a hedheeken:<verse eid="JER 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 14:2" />«Yihuda oodhaan;</para>
  <para style="q2" vid="JER 14:2">qachchiinki ardinna waye uudaan;</para>
  <para style="q1" vid="JER 14:2">Buttinake'ni ofo'le wiigaan;</para>
  <para style="q2" vid="JER 14:2">raare Iyyerusaalemii'n gadho laqisse.<verse eid="JER 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 14:3" />Hayyoole erganjuwwa ifika wede'e hasso'a ergitaan;</para>
  <para style="q2" vid="JER 14:3">insa'nenna wodi'inexxe baluwabaa adadde me'inaan;</para>
  <para style="q2" vid="JER 14:3">Yaane kinni wode'eng hinaachcho affabaan;</para>
  <para style="q1" vid="JER 14:3">Shoonkenna godoba kultineexxi</para>
  <para style="q2" vid="JER 14:3">haguuqineteexxi</para>
  <para style="q2" vid="JER 14:3">duwwixxa odolcho adhdhine hingaan.<verse eid="JER 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 14:4" />Bogake'ni xeeni hedha gophemmaxxee,</para>
  <para style="q2" vid="JER 14:4">buttini lameba hashakki hiyyeen;</para>
  <para style="q1" vid="JER 14:4">Wiisalluwikinna shooke,</para>
  <para style="q2" vid="JER 14:4">haguuqqe hangulli hiyye'en.<verse eid="JER 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 14:5" />Badda'atixxe gophenshanaa'n kexxeexxa,</para>
  <para style="q2" vid="JER 14:5">golji midde,</para>
  <para style="q2" vid="JER 14:5">ileexxa beltanjo diidi giddo hune me'aan.<verse eid="JER 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 14:6" />Diidi giddixxi harre uruma tulluchuwwa'ni uurrite,</para>
  <para style="q2" vid="JER 14:6">jeedaluwinsha raartaan;</para>
  <para style="q1" vid="JER 14:6">Arso hedha gophphemmaxxee</para>
  <para style="q2" vid="JER 14:6">illetinna garjiteen.»<verse eid="JER 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JER 14:7" />Koo Duuchchi Woddike Gootta atenaa'ni baanje turreennen;</para>
  <para style="q2" vid="JER 14:7">ate'ni jallineennen;</para>
  <para style="q1" vid="JER 14:7">Cubbo no'o'ni birasaxxe no'o qoxxi assitoolenna midde,</para>
  <para style="q2" vid="JER 14:7">summa atingee hite no'o gargaar.<verse eid="JER 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 14:8" />Ati Isira'eelixxi adde;</para>
  <para style="q2" vid="JER 14:8">rakkoti woddanna isexxi anjira,</para>
  <para style="q1" vid="JER 14:8">Mayee bogake'ni alagiinsha,</para>
  <para style="q2" vid="JER 14:8">yabaabulto manjoshsha orimalchoke kaddaattee?<verse eid="JER 14:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 14:9" />Dommi hiyyeeke manjishsha,</para>
  <para style="q2" vid="JER 14:9">wodatee hunna gopheeke lolii manjishsha kaddaatte?</para>
  <para style="q1" vid="JER 14:9">Ee Duuchchi Woddike no'oke Gootta ati no'oninni hexxetten;</para>
  <para style="q2" vid="JER 14:9">atinge summinni ye'emmennen;</para>
  <para style="q2" vid="JER 14:9">ballo'o no'o'o waaldoxxe'e.<verse eid="JER 14:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="JER 14:10" />Duuchchi Woddiki Gootti konne ardixxee hiyya'neeqic,</para>
  <para style="q1" vid="JER 14:10">«Doonsa kiyya hiyya yo'oshsha eena'neene,</para>
  <para style="q2" vid="JER 14:10">me'ine gonphabaan;</para>
  <para style="q1" vid="JER 14:10">Tennexxee Duuchchi Woddik Goott insa'ne'ni gammada'nebaan</para>
  <para style="q2" vid="JER 14:10">balleessa insa'nexxa qaabbataan;</para>
  <para style="q2" vid="JER 14:10">insa'nexxe cubbo'a insa'nee'e xixaani» hiyye.<verse eid="JER 14:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 14:11" />Duuchchi Woddiki Gootti ane'e hiyyee qici,</para>
  <para style="q2" vid="JER 14:11">«Konne ardixxee ane'ee soodatoxxe'e; <verse eid="JER 14:11" /><verse number="12" style="v" sid="JER 14:12" />Agabo goddo honsoolenna insa'nexxa oodhishsha laqabe'non; ciincatika tolchanna kaddi midhatika tolcha shiqinshoolenna insa'nenaa'ni adhdhabe'non; yaane kinn wolaantichchik, solo'ikinna dhukubik mundaashsha assannon» hiyye.<verse eid="JER 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 14:13" />Aninna, «Koo, Duuchchi Woddike Gootta waabeeko ‹Wolaantichcha uuddinabaan; solo'i hedhabaan duuchchi woddika nage'a ha'no'a uwwannon› hiyya'neen; hinaan» hiyyeennen.<verse eid="JER 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 14:14" />Duuchchi Woddiki Gootti anee'e hiyyee qici; «Waabeeko anke summin dhariinka raaga rangaan; ani insa'nee ergabe'non; insa'neenna ajajeebe'non insa'ne'ni midde haaso'ebe'non. Dhariinxa waleellanna moro woyi fulabaaka haaso'anna godoba anfeeka ifi ifika yaada insa'ne'a lalanbaan. <verse eid="JER 14:14" /><verse number="15" style="v" sid="JER 14:15" />Tennexxee anke summinni dhariinka raaga raaga'neexxe wabeeko'a Duuchchi Woddiki Gootti hiyya'nee qici, ani ergebe'nongi ‹Wolantichikinna beeli konne boga'n dagabaani› hita'nexxi tinn wabeeko wolaantichchikinna beeliki muddaani. <verse eid="JER 14:15" /><verse number="16" style="v" sid="JER 14:16" />Raagi insa'ne'a kulemeemmaki ard wolaantichchakenaa'ninna beelakenaa'n kexxeexxa Iyyerusaalemi giddo hedheeke oruwwa'n renshi insa'neki ibaani; insa'nenna aruwwa insa'nexxa yookaani labbaxxanna meyyaxxa oose insa'nexxa moogaaki hedhebaani. Balleessinemmaxxe qixxe'n insa'ne xixannoni.<verse eid="JER 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 14:17" />«Konne hiyyichcho insa'ne'n hite kuldatto qici:</para>
  <para style="q1" vid="JER 14:17">« ‹Duuddo dubaarichcho anki ardi,</para>
  <para style="q2" vid="JER 14:17">jabaxxe midhenshanni,</para>
  <para style="q1" vid="JER 14:17">Jabaxxe mada madoottemmaxxee</para>
  <para style="q2" vid="JER 14:17">ille anxi hashsha barra</para>
  <para style="q2" vid="JER 14:17">urrissebaangi indiddo dunaa'ennen.<verse eid="JER 14:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 14:18" />Hadi giddi'a maranno wodda,</para>
  <para style="q2" vid="JER 14:18">wolaantichchiki shiyeme'eke mannika rensha uudenneni;</para>
  <para style="q1" vid="JER 14:18">Qachchi giddi'anna e'yanno wodda solo'we shaqqee ibeeka afenneni;</para>
  <para style="q2" vid="JER 14:18">Wabeekichchikinna qeesichchi,</para>
  <para style="q1" vid="JER 14:18">Egennebaake bogibaa'a baanjeeni.› »<verse eid="JER 14:18" /></para>
  <para style="s1">Ardi Duuchchi Woddika Gootta Soodateeqico</para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 14:19" />Yihuda'a harange gibbette hiyyote'e?</para>
  <para style="q2" vid="JER 14:19">Tsiyoonik jibbitetteshshann gattetteni hiyyote'e?</para>
  <para style="q1" vid="JER 14:19">Fayyinabe'noqico'n,</para>
  <para style="q2" vid="JER 14:19">mayee fuggo no'o gandette?</para>
  <para style="q1" vid="JER 14:19">Nage'a alfinannon hine'e addantee'naan;</para>
  <para style="q2" vid="JER 14:19">kaddo malee'e eloxxa yaane alfineebe'noni;</para>
  <para style="q1" vid="JER 14:19">Foora alfinanon hine'e heqe'nenneni;</para>
  <para style="q2" vid="JER 14:19">yaane kinni ruphphi calla kadde.<verse eid="JER 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 14:20" />Koo Duuchchi Woddike Gootta balleessa no'oxxa egenneenneni;</para>
  <para style="q2" vid="JER 14:20">edike no'oke annuwixxa balleessa kassi hineenneni;</para>
  <para style="q2" vid="JER 14:20">dhugaaten, ati edo cubbo hunjeenneni.<verse eid="JER 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 14:21" />Summa atingee hite'e no'o tuffattoxxe;</para>
  <para style="q2" vid="JER 14:21">ulfinninxa atixxa moote salphissoxxe;</para>
  <para style="q1" vid="JER 14:21">No'o'a aagetaxxa kako qaabbati</para>
  <para style="q2" vid="JER 14:21">male'e diiggoxxe'e.<verse eid="JER 14:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 14:22" />Gosa gosake woyyi fulabaake dharichchuwwa magen giddii'n xeena gansiisa dande'aaki hedhee?</para>
  <para style="q2" vid="JER 14:22">Iimatinna fedhii ifixxinn kiifo gansiisa dandeetta?</para>
  <para style="q1" vid="JER 14:22">Waawwoti! Dandeettabaani; Duuchchi Woddike Gootta no'oke Mageno;</para>
  <para style="q2" vid="JER 14:22">tenne duuchcha assitattoki atenden</para>
  <para style="q2" vid="JER 14:22">tennexxee adde no'oxxinna ate'niten.<verse eid="JER 14:22" /></para>
  <chapter eid="JER 14" />
  <chapter number="15" style="c" sid="JER 15" />
  <para style="s1">Yihudake Arda'n murendaaxxa Murte</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 15:1" />Duuchchi Woddiki Gootti anee hiyyee qici: «Muusenna Saamu'eeli midde ani edo uurrinoole konne ardi'a godobi anki marara gophaammaxxee ani edii'n me'inaashsha assi.<note caller="-" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="EXO 32:11-14">Fula. 32:11-14</ref>; <ref loc="NUM 14:13-19">Lak. 14:13-19</ref>; <ref loc="1SA 7:5-9">1 Sam. 7:5-9</ref>. </char></note> <verse eid="JER 15:1" /><verse number="2" style="v" sid="JER 15:2" />Insa'neena atee'e, ‹Habaa'ata me'inanno?› hinoole; insa'ne'n hite kuldato qici: ‹Duuchchi Woddiki Gootti hiyya'nee qic:</para>
  <para style="q1" vid="JER 15:2">« ‹Dhukubiki reyaashsha murte uwwendeeki dhukubiki reyaan;</para>
  <para style="q1" vid="JER 15:2">Wolaantichchik reyaashsha murte uwwendeeki wolaatichinginn reyaan,</para>
  <para style="q1" vid="JER 15:2">Solo'iki reyaashsha murte uwwendeeki solo'iki reyaan;</para>
  <para style="q1" vid="JER 15:2">Booji'emaashsha murte uwwendeeki booji'eme'e me'aan.›<note caller="-" style="x"><char style="xo" closed="false">15:2 </char><char style="xt" closed="false"><ref loc="REV 13:10">Wal. 13:10</ref>. </char></note><verse eid="JER 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 15:3" />«Aninna shoole insa'ne biraachcho ergannoni,» hiyya'neen Duuchchi Woddik Gootti, «Kunnchchuwinna insa'ne shiye biraaka wolaantichcha rensha harkisaaka worsha; ittanni itte birtaaxxa allaattuwwanna binichchuwakeeran. <verse eid="JER 15:3" /><verse number="4" style="v" sid="JER 15:4" />Yihudiink moyanji Hiziqiyaasik belti Minaase Iyyerusaalemi giddo hujeexxe balleessanaa'n kexxeexxa insa'ne'n iyyedagannoxxa yaane bogi duuchchik moyanjuwwi uude sodataashsha asannoni.<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="2KI 21:1-16">2 Moy. 21:1-16</ref>; <ref loc="2CH 33:1-9">2 Odo. 33:1-9</ref>. </char></note><verse eid="JER 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 15:5" />«Tee, Iyyerusaalemi ayyete ati'a marara?</para>
  <para style="q2" vid="JER 15:5">Ayyete ati'a oodha?</para>
  <para style="q2" vid="JER 15:5">Ayyete atibaa gore'e nage'a ate'e aadha?<verse eid="JER 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 15:6" />Ane'e gibbeetteni,» hiyya'neeni Duuchchi Woddiki Gootti.</para>
  <para style="q2" vid="JER 15:6">«Dudduro wirri hiteetteni;</para>
  <para style="q1" vid="JER 15:6">Tennexxee anga anixxenn ate'e ganee balleessannon;</para>
  <para style="q2" vid="JER 15:6">ta'anni edi'a ati'a mararabe'no.<verse eid="JER 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 15:7" />Midha diidallote'ni darbina'naa diidalessitammashsha,</para>
  <para style="q2" vid="JER 15:7">bogi giddike qachchuwwa duuchcha'n insa'ne xeerannon;</para>
  <para style="q1" vid="JER 15:7">Fuggoxxa assa waala gibeemmaxxe'e,</para>
  <para style="q2" vid="JER 15:7">arda anke'n yaaddo worannon;</para>
  <para style="q2" vid="JER 15:7">balatanna insa'ne'ni ibisannon.<verse eid="JER 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 15:8" />Aro'i reyeexxe melaalleka laakkossa,</para>
  <para style="q2" vid="JER 15:8">abbaayyatike maanchi caala bira sa'issannon;</para>
  <para style="q1" vid="JER 15:8">Barra saafo'a dargageeyyetixxe amuwwa'n,</para>
  <para style="q2" vid="JER 15:8">ba'ne iyyedannon;</para>
  <para style="q1" vid="JER 15:8">Weekenshanna alayyo;</para>
  <para style="q2" vid="JER 15:8">dedhange'n insa'ne'n ibisannoni.<verse eid="JER 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 15:9" />Torbaane ifixxa oose gopheexxi ama gaggabbaani,</para>
  <para style="q2" vid="JER 15:9">hafuura hiisedha dandettabaani;</para>
  <para style="q1" vid="JER 15:9">Barrandi ise'n hashshitaani;</para>
  <para style="q2" vid="JER 15:9">isenna salphatte shookkaani;</para>
  <para style="q1" vid="JER 15:9">Lubboti gatemmaka naaphi insa'neki edo,</para>
  <para style="q2" vid="JER 15:9">wolaantichchake sa'isse uwwannoni»</para>
  <para style="q2" vid="JER 15:9">hiyya'neni Duuchchi Woddiki Gootti.<verse eid="JER 15:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 15:10" />Anixxamayyoo! Bogi duuchchi'a,</para>
  <para style="q2" vid="JER 15:10">moronshatikenna loli callike manjo kadenneka ane'e mayee'e, ildette!</para>
  <para style="q1" vid="JER 15:10">Ayyi'ana liqa uwweebe'non; ayyenaa'ninna liqeessedheebe'non;</para>
  <para style="q2" vid="JER 15:10">yaane kinni manji duuchchi ane'e yowa'neen.<verse eid="JER 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 15:11" />Duuchchi Woddiki Gootti hiyyee qici:</para>
  <para style="q1" vid="JER 15:11">«Ee'e ate'e eloke yaadi'a woxxeenneken;</para>
  <para style="q2" vid="JER 15:11">rakkote'ninna fuggoxxe yanna'ni,</para>
  <para style="q2" vid="JER 15:11">dhugaandinn naaphi ate'e safataashsha assannon.<verse eid="JER 15:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JER 15:12" />«Manji sibilo, middii'ni dageeka;</para>
  <para style="q2" vid="JER 15:12">sageettotika sibilo enqa dande'a?<verse eid="JER 15:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 15:13" />Boga atike duuchcha'n,</para>
  <para style="q2" vid="JER 15:13">hexxeexxe cubbo atixxe duuchcha'a,</para>
  <para style="q1" vid="JER 15:13">Karranna qabeenna duuchcha,</para>
  <para style="q2" vid="JER 15:13">tola boddichcha boojinaashsha assannon.<verse eid="JER 15:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 15:14" />Mufe anixxi ha'no'ni,</para>
  <para style="q2" vid="JER 15:14">giiratishsha ha'noo'ni bubbaan;</para>
  <para style="q1" vid="JER 15:14">Egendebexxoke boga'ni;</para>
  <para style="q2" vid="JER 15:14">naapha atike garba kadattoshsha assannon.»<verse eid="JER 15:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JER 15:15" />Koo Duuchchi Woddike Gootta ati egende'etten;</para>
  <para style="q2" vid="JER 15:15">yoona ati ane'e hedhi; anee to'ati;</para>
  <para style="q2" vid="JER 15:15">anee shorrammakeera'ni halo fuli.</para>
  <para style="q1" vid="JER 15:15">Ati ossaamessake kaddeettaxxe'e ba'annoshsha assitoxxe'e;</para>
  <para style="q2" vid="JER 15:15">kunni yowwichchi duuchchi ane'e geye'eki atixxe buuto'a kadeexxa hedi.<verse eid="JER 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 15:16" />Hiyyichchi atiki aniba dagee wodda gammadik adhdhennen;</para>
  <para style="q2" vid="JER 15:16">Koo Duuchchi Woddike Gootta Mageno;</para>
  <para style="q1" vid="JER 15:16">Summi atiki ye'ennaxxee,</para>
  <para style="q2" vid="JER 15:16">hiyyichchi atik ilileetetenna gammashshote ani'a kade.<verse eid="JER 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 15:17" />Shaa shanbalaqqi hiyyaake manninni welti guddeebe'non;</para>
  <para style="q2" vid="JER 15:17">insa'nenni burraaqebe'noni;</para>
  <para style="q1" vid="JER 15:17">Anga atixxi ane'ni hana hexxemmaxxe'e, mufe atixxa ane'ni wonshiteettaxxe'e,</para>
  <para style="q2" vid="JER 15:17">qofinni ofo'lennen.<verse eid="JER 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 15:18" />Dhibo ane'ni mayee jabaatte?</para>
  <para style="q2" vid="JER 15:18">Mada anixxi bukki hita'nebaachchi? Mayeete fayyita'nebaachchi mayeete?</para>
  <para style="q1" vid="JER 15:18">Ati baxxa'neexxe gootoshsha,</para>
  <para style="q2" vid="JER 15:18">dedhissammaxxe muumme mayee ane'e haakissatto?<verse eid="JER 15:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 15:19" />Tennexxee Duuchchi Woddiki Gootti hiyya'nee qici,</para>
  <para style="q1" vid="JER 15:19">«Heduma atika anibaa hiissitottole aninna ati'a higannon;</para>
  <para style="q2" vid="JER 15:19">ani'aanna ergattatton;</para>
  <para style="q1" vid="JER 15:19">La'o afeeka haaso'a la'o afebaakenaa'n gargar hissite haasottottole,</para>
  <para style="q2" vid="JER 15:19">ati anke afo'o kaddatton;</para>
  <para style="q1" vid="JER 15:19">Ardi atibaa'a higa male,</para>
  <para style="q2" vid="JER 15:19">ati ardib'a martabexxon.<verse eid="JER 15:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 15:20" />Konne ardi'a sageettotike sibiljike dalla'a,</para>
  <para style="q2" vid="JER 15:20">kollifantammake sageettotike dalla'ike sibiljo atee'e assannon;</para>
  <para style="q1" vid="JER 15:20">Atee anjironnaanna wodonna'a;</para>
  <para style="q2" vid="JER 15:20">ani atin welti hedhennaxxe'e,</para>
  <para style="q1" vid="JER 15:20">Ate'e lolloolenna midde</para>
  <para style="q2" vid="JER 15:20">ate'e injifantabaan»</para>
  <para style="q2" vid="JER 15:20">hiyya'neen Duuchchi Woddik Gootti.<verse eid="JER 15:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 15:21" />«Fuggaaleyyetenaa'ni ate'e wodannon;</para>
  <para style="q2" vid="JER 15:21">mararte afebaakerana'n atee anjirannon.»<verse eid="JER 15:21" /></para>
  <chapter eid="JER 15" />
  <chapter number="16" style="c" sid="JER 16" />
  <para style="s1">Ermiyaasixxe Hedhoxxe'e Duuchchi Woddike Goottixxa Fedhi</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 16:1" />Duuchchi Woddike Goottiki hiyyichchi anibaa dageexxi, <verse eid="JER 16:1" /><verse number="2" style="v" sid="JER 16:2" />«Konne boonchonaa'ni dubarte aaxoxxe'e; labbaxxanna meyyaxxa oose i'litoxxe'e» <verse eid="JER 16:2" /><verse number="3" style="v" sid="JER 16:3" />konne boga'ni ilendaaxxe labbaxxenna meyyaxxe oose'a</para>
  <para style="q2" vid="JER 16:3">ittanni insa'neke annuwwixxeenna amuwwaxxee'e Duuchchi Woddik Gootti, <verse eid="JER 16:3" /><verse number="4" style="v" sid="JER 16:4" />«Duuchching fuggoke dhukkubinn mudaan; insa'ne'anna oo'nabaan;</para>
  <para style="q2" vid="JER 16:4">insa'neenna moongabaani; rensha insa'neka koriinsha hunnaani. Wolaantichikinna beelik mundaan; rensha insa'neka allaattenna biniinchake itaan» hiyye.<verse eid="JER 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 16:5" />Duuchchi Woddik Goottinna, «Eebba, jaalalanna gattowwaal anixxa konne ardanaa'n bayyiseennaxxe'e; oodhishshati mine e'yitottexxe; yaadda'ni ooxxota'a martoxxe» hiyya'nen Duuchchi Woddik Gootti. <verse eid="JER 16:5" /><verse number="6" style="v" sid="JER 16:6" />«Konne boga'n hedheeki shiixxo lumoki reyaan; oodhaakanna moogaaka alfinabaan; insa'ne'a yaadexxi ifi ci'laakinna umo haaxxaaki hedhabaan. <verse eid="JER 16:6" /><verse number="7" style="v" sid="JER 16:7" />Manjo shi'weeka jajjabeessate'e qore ra'isse iyyemaraaki hedhebaan; anna ama shi'weeka jajjabessatee ha'winaachcho iyyemaraaki hedhebaan.<verse eid="JER 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 16:8" />«Insa'nenni welti ofolde ittottaanna ha'witottaa jila hexxee mine'ni e'yitoxxe; <verse eid="JER 16:8" /><verse number="9" style="v" sid="JER 16:9" />Ani dada duuchcha ajajanoki Duuchchi Woddiki Gootti Isira'eliki Magen hiyyannexxa caqasi: ati hexxetteke konne baro'ni; gammashshotikinna ilileettetik, meellatike sirbik hafuuri konne booncho'ni laqemabaashsha assannoni.<verse eid="JER 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 16:10" />«Tenne duuchcha konne ardi'n kuldatto wodda insa'ne; ‹Duuchchi woddiki Gootti tenne lumoxxa ba'ne no'on mayee'e lallabe? Balleessa no'oxxi maachcho? Duuchchi Woddike Goota no'oke Mageno'ni hunjennexxi cubbo heente?› hine'e ate'e qorroole; <verse eid="JER 16:10" /><verse number="11" style="v" sid="JER 16:11" />Ookkone wodda atinna insa'ne'e hittato qici, ‹Ha'nok edik annuwwi ane'e waalemaxeeten› hiyya'neen Duuchchi Woddik Gootti ‹Wele magenuwwa hordofiyyoti ergatememmaxxeenna magenooffantemaxeeten; insa'ne ane'e waaleexxi finqille; seera ankanna heqqe'neba'a. <verse eid="JER 16:11" /><verse number="12" style="v" sid="JER 16:12" />Ha'no kinni edike ha'noke annuwwi caala fuggoxxa assitine; mitti mitti ha'nong ani'a ajajendinammaxxa bakka godoba ha'noke'n fuggoxxa abixxitine me'itina'neexxa uudde. <verse eid="JER 16:12" /><verse number="13" style="v" sid="JER 16:13" />Tennexxee ha'noo konne boginaa'n fulchennexxi ha'notenna kadde ha'noki annuwwa egendinebaake boga'n ha'no'o fugussannon; ha'no'a gattowwaal hiyyabe'non; ookkonna wele dharichcha magenuwwa hashshanna barra magenooffattinaan.<verse eid="JER 16:13" /></para>
  <para style="s1">Isira'eliki Ardixxa Boo'ji'otenaa'n Higa</para>
  <para style="p">
    <verse number="14" style="v" sid="JER 16:14" />«Tennexxee manni, ‹Isira'eel'i Gibtsee'ni fulcheeki hedhaake Duuchchi Woddiki Goottaa› hiyye kakatabaak bari dagaan; hiyya'neen Duuchchi Woddik Gootti. <verse eid="JER 16:14" /><verse number="15" style="v" sid="JER 16:15" />Yaane kinn ‹Isira'eelika ardi middike boganaa'inna insa'ne'e xexeeremmake wele boga duuchchanaa'n fulcheeke hedhaak Duuchchi Woddike Goottaa› hinaan; edike annuwwa insa'neke uwwennake bogibaa insa'ne hiissannon.»<verse eid="JER 16:15" /></para>
  <para style="s1">Daga'neeka Xixxichcho</para>
  <para style="p">
    <verse number="16" style="v" sid="JER 16:16" />«Ta'a kinn heddo quluxu'me abidaaka manna ergannon» hiyya'neen Duuchchi Woddiki Gootti; «Insa'neenna abindaan. Okkonechchi uduma heddo adamaaka manna ergannon; insa'nenna kooba koobanaa'ni tullichchuwwi duuchchanaa'ni kinjuwiinxe wolo'uwwanaa'ni insa'ne adammee abindaan. <verse eid="JER 16:16" /><verse number="17" style="v" sid="JER 16:17" />Assina'neexxa duuchcha uudannen; ani edo sho'ondaaxxi hexxebaan; cubbo insa'nexxi ani'a barraten. <verse eid="JER 16:17" /><verse number="18" style="v" sid="JER 16:18" />Boga anka renchiishsha kaddeexxe battitte fakkuwwanni battoossinemmaxxe'e geego anka shookkishshaaxxe yaanuwanni wonshinemmaxxe'e hunjeexxe fuggoxena cubboxxe lame anga insa'ne'e xixannon» hiyye.<verse eid="JER 16:18" /></para>
  <para style="s1">Ermiyaasixxa Soodachcho</para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 16:19" />Jabeenna ankenna kollo anixxee,</para>
  <para style="q2" vid="JER 16:19">rakkotixxa barra irkote kaddeetteke Duuchchi Woddike Goottaa,</para>
  <para style="q1" vid="JER 16:19">Gosa gosaki ardi boginxe gabalanaa'ni,</para>
  <para style="q2" vid="JER 16:19">atiba'a dageexxi hiyyaaqic,</para>
  <para style="q1" vid="JER 16:19">«Ediki no'oki annuwwi mitte la'o fulabaaxxe,</para>
  <para style="q2" vid="JER 16:19">toliinxe fakkuwa'a dharichcha magenuwwa ifike asse'ne.<verse eid="JER 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 16:20" />Manni umo ifike'e magenuwwa giissedhaa?</para>
  <para style="q2" vid="JER 16:20">Giissedha dande'aan iita hedheechchuwi kinni magenuwakebaan» hiyye.<verse eid="JER 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 16:21" />«Tennexxee insa'nee barsiisannon</para>
  <para style="q2" vid="JER 16:21">hunna anixxanna lumminne anka</para>
  <para style="q2" vid="JER 16:21">ta'a insa'ne'a barsiisannon</para>
  <para style="q1" vid="JER 16:21">Summi anki Duuchchi Woddike Gootta</para>
  <para style="q2" vid="JER 16:21">kadeexxa konkaan» hiyye.<verse eid="JER 16:21" /></para>
  <chapter eid="JER 16" />
  <chapter number="17" style="c" sid="JER 17" />
  <para style="s1">Yihudake Ardixxa Cubbonna Insa'ne'n Geyeeka Xixichcho</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 17:1" />«Yihudaxxi cubbo sibiljnxe tiikkonni,</para>
  <para style="q2" vid="JER 17:1">afo'o qa'latteexxe Almaazi hinaake fiixe kinjinni, borreessendee'en;</para>
  <para style="q1" vid="JER 17:1">Godobi insa'neki giddo,</para>
  <para style="q2" vid="JER 17:1">insa'neke tolchimalchike cunnuchchuwwa'n borreesse'ne'en.<verse eid="JER 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 17:2" />Oosuwwa insa'nexxi midde gatteebaang,</para>
  <para style="q2" vid="JER 17:2">shafi callixxe haqqe hunda,</para>
  <para style="q1" vid="JER 17:2">Qeerrake tulluchchuwwi hana hedheeka,</para>
  <para style="q2" vid="JER 17:2">tolchimalchuwwanna Asheera hiyyendaaxxe fukkuwwa hendaan.<verse eid="JER 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 17:3" />Boga atike duuchcha'ni hujenedeexxe cubbonaa'ni kexxeexxa,</para>
  <para style="q2" vid="JER 17:3">boga atike'ni hexxeexxe kooba anxe'ni,</para>
  <para style="q1" vid="JER 17:3">Horattetteechcho duuchcha,</para>
  <para style="q2" vid="JER 17:3">magenooffattattaxxe tulluchchiwwininni,</para>
  <para style="q2" vid="JER 17:3">saamemaashsha assannon.<verse eid="JER 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 17:4" />Hujjetaxxe balleessa'a</para>
  <para style="q2" vid="JER 17:4">ati'a uwwennaka geego gophphatton;</para>
  <para style="q1" vid="JER 17:4">Egendeboxxoke boga'n,</para>
  <para style="q2" vid="JER 17:4">naapha atike garba atee assannon;</para>
  <para style="q1" vid="JER 17:4">Duuchchi woddi'a ha'itaaxxa,</para>
  <para style="q2" vid="JER 17:4">mufe anxixxa giira ati ha'ishetten» hiyye.<verse eid="JER 17:4" /></para>
  <para style="s1">Gargar Hedheeka Hiyyichchuwwa</para>
  <para style="p">
    <verse number="5" style="v" sid="JER 17:5" />Duuchchi Woddiki Gootti hiyya'nee qici,</para>
  <para style="q1" vid="JER 17:5">«Manjoke'ni adde assedhaak,</para>
  <para style="q2" vid="JER 17:5">manjoke'ni irkataak,</para>
  <para style="q2" vid="JER 17:5">godobik Duuchchi Woddike Goottana'n bayyataak badinemmeeken.<verse eid="JER 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 17:6" />Qiilla gammoojje'ni hedheeke waaccoshsha kadaan;</para>
  <para style="q2" vid="JER 17:6">eloxxa yaane uudabaan;</para>
  <para style="q1" vid="JER 17:6">Manji hedhebaake maxinetike boga'ni,</para>
  <para style="q2" vid="JER 17:6">mittichchi hedhebaake qiilla gammoojje giddo hedhaan.<verse eid="JER 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JER 17:7" />«Yaane kinn Duuchchi Woddika Gootta adde assedhaak,</para>
  <para style="q2" vid="JER 17:7">adde isixxinna Duuchchi Woddike Gootta kaddeek manji eebbiseme'eken.<verse eid="JER 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 17:8" />Isi galaani qarqara lateemmakenna,</para>
  <para style="q2" vid="JER 17:8">hidda wodi'i giddo olteeke haqichchishshaten;</para>
  <para style="q1" vid="JER 17:8">Jabaxxi arishsho gandaa wodda sodaatabaan;</para>
  <para style="q2" vid="JER 17:8">shafikinna duuchchi wodda haanjedha'n hedhaani,</para>
  <para style="q1" vid="JER 17:8">Xeeni ganammabaake baro'ni midde ruphphi hiyyabaan;</para>
  <para style="q2" vid="JER 17:8">gummatanna gummisa'ne hedhaan» hiyye.<note caller="-" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="PSA 1:3">Far. 1:3</ref>. </char></note><verse eid="JER 17:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JER 17:9" />«Manjiinka godoba ayyete ege'na;</para>
  <para style="q2" vid="JER 17:9">xaqartichchakenna hara fuggoken</para>
  <para style="q2" vid="JER 17:9">ayyete ege'naak?<verse eid="JER 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 17:10" />«Ani Duuchchi Woddiki Gootti manjo duuchcha me'inji isikishshanni,</para>
  <para style="q2" vid="JER 17:10">huje isixika hira uwwatee,</para>
  <para style="q1" vid="JER 17:10">Godobi giddika yaada memmekisannon;</para>
  <para style="q2" vid="JER 17:10">wodana isikanna geeqqishshanon» hiyye.<note caller="-" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="PSA 62:12">Far. 62:12</ref>; <ref loc="REV 2:23">Wal. 2:23</ref>. </char></note><verse eid="JER 17:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 17:11" />Oribeloxxa karra bukki assedhaak manji,</para>
  <para style="q2" vid="JER 17:11">ifike kadebaaka quuphphe kabbexxee quqquussitammaxxe'e gogorreshshaten;</para>
  <para style="q1" vid="JER 17:11">Harumaanxe wogga'ni waale me'aan;</para>
  <para style="q2" vid="JER 17:11">gowwumma ifixxinna uduma iso'o'n leellitaan.<verse eid="JER 17:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JER 17:12" />Galmi ho'noki hedheek boonchi,</para>
  <para style="q2" vid="JER 17:12">olmii'ninn lumoxxe ulfinnixxe moote'niten.<verse eid="JER 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 17:13" />Koo Isira'eeli'a adde kaddeettek Duuchchi Woddike Gootta;</para>
  <para style="q2" vid="JER 17:13">atenani finqile me'aaki duuchchi salphataan;</para>
  <para style="q1" vid="JER 17:13">Dudduro ate'ni wirri hiyyeek duuchchi butta wabbi hiyyaan;</para>
  <para style="q2" vid="JER 17:13">hedhotike wodi'ixxa muumme,</para>
  <para style="q2" vid="JER 17:13">Duuchchi Woddika Gootta waalemmaxxeten.<verse eid="JER 17:13" /></para>
  <para style="s1">Ermiyaasi Duuchchi Wooddika Gootta Addato'a Soodatee qico</para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 17:14" />Koo Duuchchi Woddike Gootta ati anee fayyissottole fayyisi,</para>
  <para style="q2" vid="JER 17:14">anjirtottole anjiremannon;</para>
  <para style="q2" vid="JER 17:14">atee galateeffatonnaa'a.<verse eid="JER 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 17:15" />Insa'nenna lenbe lebeexxi,</para>
  <para style="q2" vid="JER 17:15">«Duuchchi Woddike Goottiki hiyyichchi habata hedhe?</para>
  <para style="q2" vid="JER 17:15">Ta'ani kunn muuxemowwaali» ane'e hinaani.<verse eid="JER 17:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 17:16" />Allalsanjoke kade ati'a ergatematenaa'n udumi'a higebo'noni;</para>
  <para style="q2" vid="JER 17:16">fuggoxxa hedebo'noxxa atinni egendeetteni;</para>
  <para style="q2" vid="JER 17:16">anke afo'onaa'n fulda'neexxi ate'n sho'ondeexxebaani.<verse eid="JER 17:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 17:17" />Ati rakkotixxe barrake anke golla kaddettaxxee,</para>
  <para style="q2" vid="JER 17:17">ane'e bararassitattoke kaddoxxe.<verse eid="JER 17:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 17:18" />Anee shorra'neekiri shookowwaali;</para>
  <para style="q2" vid="JER 17:18">ane kinn shookishshoxxe;</para>
  <para style="q1" vid="JER 17:18">Insa'ne alannaashsha assi;</para>
  <para style="q2" vid="JER 17:18">ane kinn alayyokenaa'n gatisi;</para>
  <para style="q1" vid="JER 17:18">Fuggoxxi insa'ne'n geltaashsha assi;</para>
  <para style="q2" vid="JER 17:18">jabaxxa ba'ne insa'ne'n geessisi.<verse eid="JER 17:18" /></para>
  <para style="s1">Sanbatinxa Barra Ulfeessatixxee</para>
  <para style="p">
    <verse number="19" style="v" sid="JER 17:19" />Duuchchi Woddiki Gootti ane'e hiyyee qici, «Martettexxi Yihudiinki moyanjuwwi fulammaxxenna e'yammaxxe ardiinxe hula'n, wele Iyyerusaalemixxe huluwwa duuchcha'n uurri. <verse eid="JER 17:19" /><verse number="20" style="v" sid="JER 17:20" />Insa'ne hitatto qici, ‹Tenne huluwa'n e'yitina'neeke Yihudiinke moyanjuwwa; Yihudinke ardanna Iyyerusaalemi giddo hexxina'neeki duuchchi; Duuchchi Woddike Goottika hiyyichcho laqqe. <verse eid="JER 17:20" /><verse number="21" style="v" sid="JER 17:21" />Duuchchi Woddiki Gootti hiyya'nee qici, «Sanbatiinxa barra ba'o ba'exxine Iyyerusaalemixxe huluwwa'ni e'yishinabaashsha ifi'a heqqedhdhe.<note caller="-" style="x"><char style="xo" closed="false">17:21 </char><char style="xt" closed="false"><ref loc="NEH 13:15-22">Neh. 13:15-22</ref>. </char></note> <verse eid="JER 17:21" /><verse number="22" style="v" sid="JER 17:22" />Edika ha'noka annuwwa ajajennashshanni; sanbatiinxi barra woyyitette kaddeemmaxxe ulfeesse malee'e sanbatiinxa barra ba'o ba'exxinnee ifiifinge minenaa'ni ba'o ba'exxine fuldinnoqqe'e; mitte hujenna hujinnoqqee» hiyye.<note caller="-" style="x"><char style="xo" closed="false">17:22 </char><char style="xt" closed="false"><ref loc="EXO 20:8-10">Fula. 20:8-10</ref>; <ref loc="LEV 5:12-14">Lew. 5:12-14</ref>. </char></note> <verse eid="JER 17:22" /><verse number="23" style="v" sid="JER 17:23" />Insa'ne kinn hiyyichcho anka lanqebaan; kassinna hinebaani; godobake'n fuggoxxa uggudhdhine ani'a ajajema ginbe.<verse eid="JER 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 17:24" />« ‹Yaane kinni ifi xexxe'achchoti an'a ajajendina'noole hiyya'neeni Duuchchi Woddiki Gootti; sanbatiinxa barra konne qachchixxe huluwaa'n ba'o ba'exxine e'ya gophphinoole; sanbatiniinxa barra mittechchonna hujjinebaang woyyoossitinoole; <verse eid="JER 17:24" /><verse number="25" style="v" sid="JER 17:25" />Daawwitixxe moote'n hana ofo'lammaki moyanjuwwinna insa'neki jalqabuwwi konne qachchixxe huluwwa'n e'yinaani; fadhaduwwake'ninna fadhadiniinxe gaaruwwa'n ofole Yihudiinkinna Iyyerusaalemiki manni erqe kayyi'ni qoqqobee'na dangaani; kunni qachchinna duuchchi wodda ard hedhaake qachcha kadaan. <verse eid="JER 17:25" /><verse number="26" style="v" sid="JER 17:26" />Ardi Yihudiinke qachchuwwanaa'n, Iyyerusaalemike qarqarii'n, Biniyaamike boganaa'n, qiilla gammoojjena'ninna Suubbichcha boganaa'n ittanni Negebii'n ciincatika tolchanna wele tolcha, midhatika tolcha, hixaanakanna galatinka tolcha abixxine Duuchchi Woddike Goottike minba'a dangaani. <verse eid="JER 17:26" /><verse number="27" style="v" sid="JER 17:27" />Yaane kinni sanbatiniinxa barra Woyyitte barra assa gophphine; sanbatiniinxa barra ba'o ba'exxine Iyyerusaalemike qachchixxe huluwwaa'n e'yitine'e ajaja anka gibbinoole; Iyyerussaalemixxe huluwwa'ni kolluwwa ittaaxxa; xoxxabaaxxa giira ha'ishannoni.› »<verse eid="JER 17:27" /></para>
  <chapter eid="JER 17" />
  <chapter number="18" style="c" sid="JER 18" />
  <para style="s1">Ermiyaasi Odolcho Giissinammake Mine'n</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 18:1" />Duuchchi Woddike Goottana'ni Ermyaasiba'a dageeka hiyyichcho; <verse eid="JER 18:1" /><verse number="2" style="v" sid="JER 18:2" />«Kexxe odolcho giissammake manjichchike mine'n mari; ookko hittattochcho ate'n kulannon» hiyye. <verse eid="JER 18:2" /><verse number="3" style="v" sid="JER 18:3" />Aninna odolcho giissammakike manijichchike minibaa marenneni; isinna faarinka miyanna moleti hana hujaa'na'a uudenneni. <verse eid="JER 18:3" /><verse number="4" style="v" sid="JER 18:4" />Dhoqqeti faarinka miya hujaammaxxi huje gorte; odolcho giissammakinna haseexxe wele bifa'ni higgeen giisse.<verse eid="JER 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 18:5" />Duuchchi Woddiki Gootti hiyyichchi anibaa hiyya'n dageeqic: <verse eid="JER 18:5" /><verse number="6" style="v" sid="JER 18:6" />«Koo, Isira'eelike ardaa odolcho giissammak assemmashshanni, aninna ha'no'n assa dande'abe'nota?» hiyya'neen Duuchchi Woddik Gootti; «Koo Isira'elike arda dhoqqe odolcho giissammakixxe anga'ni hexxemmashshanni ha'nonna ittanni anxe anga'ni hexxineen. <verse eid="JER 18:6" /><verse number="7" style="v" sid="JER 18:7" />Ani mitte gosaka arda yookaan moyanjo hoyyonna'a, diigemashshanna xereme ba'aasha haaso'ennexxe yanna'n, <verse eid="JER 18:7" /><verse number="8" style="v" sid="JER 18:8" />Xexxe'achchiisennek gosa gosak ardi fuggoxxenaa'ni higoole, ani assona hedennexxa fuggoxxa yaane'e waalannon. <verse eid="JER 18:8" /><verse number="9" style="v" sid="JER 18:9" />Wele wodda mitte gosa gosak arda yookaan moyanjo jabeesse kaasonnaa haaso'e'na'a, <verse eid="JER 18:9" /><verse number="10" style="v" sid="JER 18:10" />ani edo fuggoxxa assoolenna ani'a ajejema gophoole, isi'a assannon hiyye hedennaxxa eloxxa yaane waalannon.<verse eid="JER 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 18:11" />«Ta'anna yoona Yihudake ardi'anna Iyyerusaalemi'i hedha'neeke hitattoqic, ‹Duuchchi Woddik Gootti yoona ba'ne ha'no'a qophpheessate'ni hedhennen fuggoxxa yaane ha'noo'ni i'lannoni. Tennexxee ha'no duuchching fuggoxxe hujenaa'ni higge. Me'injo ha'nokanna huje ha'nooxxa giissedhdhe.› <verse eid="JER 18:11" /><verse number="12" style="v" sid="JER 18:12" />Insa'ne kinn, ‹Tola eloottoxxe. No'o hendennexxe'n itti jabaantannon mitti mitting fuggoka no'oka yaada hordonfaannen hinaan.› »<verse eid="JER 18:12" /></para>
  <para style="s1">Isira'elik Ardi Duuchchi Woddika Gootta Waaleexxa</para>
  <para style="p">
    <verse number="13" style="v" sid="JER 18:13" />Tennexxee Duuchchi Woddiki Gootti hiyya'nee qici,</para>
  <para style="q1" vid="JER 18:13">«Abboo gosa gosaka arda,</para>
  <para style="q2" vid="JER 18:13">tenne labbaaxxi yaane ha'no giddo laqqine egende? Hitine qorre.</para>
  <para style="q1" vid="JER 18:13">Duuddo dubarichcho Isira'eeli,</para>
  <para style="q2" vid="JER 18:13">hara fuggoxxe yaane assiteen.<verse eid="JER 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 18:14" />Libaanoosixxe koobanaa'ni lumollanna</para>
  <para style="q2" vid="JER 18:14">kaade gophendee'e egendee?</para>
  <para style="q1" vid="JER 18:14">Koobatenaa'ni yaa'ak qiidaki wodi'i</para>
  <para style="q2" vid="JER 18:14">yaa'a waala?<verse eid="JER 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 18:15" />Anki ardi kinni ane'e dedheen;</para>
  <para style="q2" vid="JER 18:15">woyi fulabaachchuwwi'a hixaana gubeen;</para>
  <para style="q1" vid="JER 18:15">Ifike yaada'n gorre,</para>
  <para style="q2" vid="JER 18:15">edike oranaa'ni guggufante;</para>
  <para style="q1" vid="JER 18:15">Dhuqidhuqqiyeeke ora'n,</para>
  <para style="q2" vid="JER 18:15">giissemebaaka elobaaka orainna me'ineen.<verse eid="JER 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 18:16" />Bogi insa'neki duuchchi woddi'a,</para>
  <para style="q2" vid="JER 18:16">urume gataan;</para>
  <para style="q1" vid="JER 18:16">Ookkone sa'aki duuchchi mambe'a hiyya'ni</para>
  <para style="q2" vid="JER 18:16">afo'o abixxe umo wirsaan.<verse eid="JER 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 18:17" />Boroti darree'n gandammaxxe diidalloshsha,</para>
  <para style="q2" vid="JER 18:17">insa'nenge naaphi edo xeerannon;</para>
  <para style="q1" vid="JER 18:17">Ba'ne insa'ne'ni geltaaxxa barra,</para>
  <para style="q2" vid="JER 18:17">dudduro malee'e alba anka insa'ne'ni leellishabe'non» hiyye.<verse eid="JER 18:17" /></para>
  <para style="s1">Ermiyaasi'a Mari'anteeka Daba</para>
  <para style="p">
    <verse number="18" style="v" sid="JER 18:18" />«Insa'nenna, Seeri qeesoletenaa'ni, gorsikinna beekoletenaa'n, hiyyichchikinna wabeekkoletena'ni gophemabaaxxe amme mee Eermiyaasixxe mallo: ammeyya: afo'iki miino, isi haaso'a'neexxa duuchcha laqa waalo» hiyye.<verse eid="JER 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 18:19" />Koo Duuchchi Woddike Gootta ani hiyyaanexxa laqi;</para>
  <para style="q2" vid="JER 18:19">naaphi anee hiyya'neexxa caqasi.<verse eid="JER 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 18:20" />Eloxxa hujeekik galati fuggoxxe?</para>
  <para style="q2" vid="JER 18:20">Insa'ne'n kinn bale ani'a qonte;</para>
  <para style="q1" vid="JER 18:20">Insa'ne'ni mufataboxxoshsha,</para>
  <para style="q2" vid="JER 18:20">ani ati edo uurre,</para>
  <para style="q2" vid="JER 18:20">insa'nexxe'e haaso'enaxxa hedi.<verse eid="JER 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 18:21" />Tennexxee oose insa'nexxa solo'okeenna,</para>
  <para style="q2" vid="JER 18:21">wolaantichchakee sa'issite uwwi;</para>
  <para style="q1" vid="JER 18:21">Aruwwa insa'nexinna ila belo maseentotenna aro'i shi'witeexxe hiyyeette kanduun;</para>
  <para style="q2" vid="JER 18:21">labballi insa'nek qooma reyowwaal;</para>
  <para style="q2" vid="JER 18:21">ka'umikinna bagedoke'ni wolaantichchik mudowwaal.<verse eid="JER 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 18:22" />Ani'e abishotee'e bale qonteemmaxxe'e</para>
  <para style="q2" vid="JER 18:22">lekka anixxee sho'ik fonxoro fannemmaxxe'e</para>
  <para style="q1" vid="JER 18:22">Keekkantebaaba lolii manna ergitatto wodda;</para>
  <para style="q2" vid="JER 18:22">mini insa'nekenaa'ni raare kexxowwal.<verse eid="JER 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 18:23" />Ati kinni Koo Duuchchi Woddike Gootta,</para>
  <para style="q2" vid="JER 18:23">ane'e shinno'a mari'anteexxe mari'e duuchcha egendeetten;</para>
  <para style="q1" vid="JER 18:23">Balleessa insa'nexanna gattowwaal hitoxxe;</para>
  <para style="q2" vid="JER 18:23">cubbo insa'nexxa deetoxxe;</para>
  <para style="q1" vid="JER 18:23">Insa'ne'e ati edo jibbemeke kandowwaal;</para>
  <para style="q2" vid="JER 18:23">mufattatto wodda insa'ne'a marartoxxe.<verse eid="JER 18:23" /></para>
  <chapter eid="JER 18" />
  <chapter number="19" style="c" sid="JER 19" />
  <para style="s1">Reyeeke Waabika Faakkeenna</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 19:1" />Duuchchi Woddiki Gootti hiyya'neeqic, «Martettexxi faarinka miya giissammakenaa'ni odoolcho hiri; ardi giddii'ninna qeesoleti giddii'n lumolla kadeeka mitte mitte adhdhite; <verse eid="JER 19:1" /><verse number="2" style="v" sid="JER 19:2" />Faarinka miya giissammakixxe e'yinammaxxe hula bira hedheeke Heenomike beltixxe dhooqaba'a mari. Ookko ani atenn kulannoka hiyyichcho lallabi,<note caller="-" style="x"><char style="xo" closed="false">19:2 </char><char style="xt" closed="false"><ref loc="2KI 23:10">2 Moy. 23:10</ref>; <ref loc="JER 7:30-32">Erm. 7:30-32</ref>; <ref loc="JER 32:34-35">32:34-35</ref>. </char></note> <verse eid="JER 19:2" /><verse number="3" style="v" sid="JER 19:3" />Hitattoqici ‹Yihudake moyanjuwwinna Iyyerusaalemi hexxina'neeke koo arda; Duuchchi Woddiki Goottika hiyyichcho caqasse; Isira'eeliki Duuchchi Woddik Gootti Magenikinna laqeeke duuchchaa mansha gibbaaxxa fuggoxxa yaane konnebooncho'ni iyyedagannon. <verse eid="JER 19:3" /><verse number="4" style="v" sid="JER 19:4" />Ani waaleexxi tenne bakka wele ege'nemebaaka dharichcha magenuwwa magenooffataaxxe booncho asse'nemmaxxeten insa'nenna kadi edik annuwwi insa'neki Yihudiinki moyanjuwwinna egennebaake dharichcha magenuwwi'a tolcha tolchineen konne boonchonna qajeeli mannixxi munde dhangalaateen. <verse eid="JER 19:4" /><verse number="5" style="v" sid="JER 19:5" />Ani ajajebo'noxxa, insa'ne'ni hiyyebo'noxxa ijje hedebo'noxxa ifixxa labbaaxxa oose giirate'ni ciincessino'a Ba'aali hiyyemaake magenuwwa magenooffanto'a tullichchuwwa giissineen.<note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="EXO 18:21">Fula. 18:21</ref>. </char></note> <verse eid="JER 19:5" /><verse number="6" style="v" sid="JER 19:6" />Tennexxee manni tenne bakka duuliinxe dhooqa malee'e konneechchin edi'a Toofeeti yookaan Heenomike beltixxe dhooqa hinabaak bari dagaan hiyya'neen Duuchchi Woddik Gootti.<verse eid="JER 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 19:7" />« ‹Konne booncho'ni Yihudakinna Iyyerusaalemike ardik hedumi muuxemabaashsha assannon; insa'neke naaphi edo lubbo insa'nexxa wolaantichchik balleesso'a hasa'neeke mannixxe anga'ni ibbaashsha assannon; rensha insa'nekanna allaattuwwatinna biniinchuwwi ito'a uwwannon. <verse eid="JER 19:7" /><verse number="8" style="v" sid="JER 19:8" />Konne qachcha bakka isixxa balleessannon; mambe'a hinaashsha assannon; okko'n sa'aaki duuchchi qachchake'ni kaddeexxa uude hoola abbo! Hina'ni gacifantaan. <verse eid="JER 19:8" /><verse number="9" style="v" sid="JER 19:9" />Labbaxxenna meyyaxxe ifixxe ooseka maala indaashsha assannon; insa'nexxa lubbo balleessate hasa'neek naaphuwwi insa'nek erqe kayyii'ni buqe rakkisaa wodda, mitti mittinka maala itaan.›<verse eid="JER 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 19:10" />«Okkone waabakanna atinni welti me'emmake manni edo shiltatton; <verse eid="JER 19:10" /><verse number="11" style="v" sid="JER 19:11" />Insa'neenna hitattoqici, ‹Duuchchi Woddiki Gootti Magenikinna faarinka miya giissammakiki waabi reyemmashshanni hiissine xaasa dandenammabaashshann, konne ardanna konne qachcha ittan enqannon; moogginxi bakka gophende'na rensha Toofeeti moongaan; konne booncho'ninna ookko'o hedha'neera'ni tenneen assanon. <verse eid="JER 19:11" /><verse number="12" style="v" sid="JER 19:12" />Konne booncho'ninna konne giddo hedha'neera'ni tenneen assannon hiyya'neen Duuchchi Woddiki Gootti. Konne qachcha Toofeetishshanna assannon. <verse eid="JER 19:12" /><verse number="13" style="v" sid="JER 19:13" />Heelchote'ninna iimatixxe daduwwa'a hixaana gunbemmaxxenna dharichcha magenuwi'a ha'watika tolcha qophpheessendeeke Iyyerusaalemiki minuwinna Yihudake moyanjuwwike minuwwi Toofeetishshanna batto'aan.› »<verse eid="JER 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 19:14" />Ermiyaasinna Duuchchi Woddiki Gootti raaga raago'a ergeemabaa'ni Toofeeti'ni hige; Duuchchi Woddike Goottike galmixxe baxxe'ni uurreexxi arda duuchcha'ni hiyyeeqic <verse eid="JER 19:14" /><verse number="15" style="v" sid="JER 19:15" />«Isira'eeliki Duuchchi Woddiki Gootti Magen hiyya'neeqic, ‹Yoona godoba jabeefante hiyyichcho anka laqa gonpheemmaxxe'e konne qachcha'ninna qarqarake'ni hedheeke olla'uwa'ni ibisonna'a hedeennexxa ba'ne iyyedagannon› » hiyye.<verse eid="JER 19:15" /></para>
  <chapter eid="JER 19" />
  <chapter number="20" style="c" sid="JER 20" />
  <para style="s1">Ermiyaasi Qeesichcho Phaasikori'i Moromeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 20:1" />Duuchchi Woddike Goottike Galm giddo umoke kadeemmak Imeerik belti qeesichchi Pashihuur tennee yaanuwwa Ermiyaasi raaga raageexxa laqeexxa yanna, <verse eid="JER 20:1" /><verse number="2" style="v" sid="JER 20:2" />wabeekichcho Ermiyaasi'i ganeexxi Duuchchi Woddike Goottike galmixxe alidarrexxe Biniyaamixxe hula'n jirmik lekka usuremaashsha asse; <verse eid="JER 20:2" /><verse number="3" style="v" sid="JER 20:3" />langa baro phashihuur Ermiyaasi'i usuremeeke jirmi giddii'n fulcheexxi hiyyeeqic, «Ta'anni elqi'a Duuchchi Woddik Gootti summa atika Magorimisabib hiyya malee'e Pasikoor hiyyabaan <verse eid="JER 20:3" /><verse number="4" style="v" sid="JER 20:4" />Tennexxeetemman Duuchchi Woddik Gootti ‹Atee'e atike umi'anna atike jaaluwwi duuchchi'a weekenshatike assannon; ille atixxi uuddaa'naann naapha insa'nekiki wolaantichchi insa'ne'e itaan; Yihudaka arda duuchchanna wolaantichchik shiyaake yookaan Baabilooni'a booji'aake Baabiloonke moyanjiinxe anga'n sa'isse uwwannon. <verse eid="JER 20:4" /><verse number="5" style="v" sid="JER 20:5" />Konne qachchixxa karra duuchcha elo isixxa Yihudake moyanjuwwiinka fiixa mi'uwwanna horanteechcho duuchcha naapha insa'nekixxe anga'n sa'isse uwwannon; isinna booji'eexxi Baabilooni'a adhdhe me'aan. <verse eid="JER 20:5" /><verse number="6" style="v" sid="JER 20:6" />Koo phashihuur atinna atike mine'n hedheek duuchchi Baabilooni'a booji'endinaan; atinna dharik wabeekumma insa'ne'a haasottettak atik jaaluwwi duuchchi ookko rertinee'e moogendinaan› hiyye'emmachchi» hiyye.<verse eid="JER 20:6" /></para>
  <para style="s1">Ermiyaasi Mageno Aallateeqico</para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 20:7" />Koo Duuchchi Woddike Gootta anee'e baseessitette; aninna baseeffatenne;</para>
  <para style="q2" vid="JER 20:7">ani caal hunnaamessake kaddetten; injifattette;</para>
  <para style="q1" vid="JER 20:7">Barra duuchchanna gacifachchotike kadenne;</para>
  <para style="q2" vid="JER 20:7">duuching anee osso'le.<verse eid="JER 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 20:8" />Haaso'anno wodda duuchcha oodhanno;</para>
  <para style="q2" vid="JER 20:8">«xaqaro hujendaan ba'netinna daggaan» hiyye lallabenne;</para>
  <para style="q1" vid="JER 20:8">Tennexxee Duuchchi Woddike Goottik hiyyichchi,</para>
  <para style="q2" vid="JER 20:8">barra duuchcha yowwematanna cee'mema ane'n ile.<verse eid="JER 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 20:9" />Yaane kinni «Ta'anni elqi'a summa isika ganabe'no;</para>
  <para style="q2" vid="JER 20:9">summa iskininna haaso'abe'no» hiyyonnole,</para>
  <para style="q1" vid="JER 20:9">Hiyyichchi isik qalbe anxi giddo giiratishsha,</para>
  <para style="q2" vid="JER 20:9">miqe anxe giddonna xurenoke kade;</para>
  <para style="q1" vid="JER 20:9">Ifi giddo buqe'e abixxa gophenne;</para>
  <para style="q2" vid="JER 20:9">haranga dande'ebe'no.<verse eid="JER 20:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 20:10" />Bakka bakka'ni weekeshate hexxeen;</para>
  <para style="q2" vid="JER 20:10">iso'o fugusse; fugussino</para>
  <para style="q2" vid="JER 20:10">hina'n hashanshaa wodda laqenne;</para>
  <para style="q1" vid="JER 20:10">Anxa iba halcheexxi</para>
  <para style="q2" vid="JER 20:10">anke jaaluwwa kade'emmak duuchchi,</para>
  <para style="q1" vid="JER 20:10">«Isi baseeffataaxxe hexxeen,</para>
  <para style="q2" vid="JER 20:10">ookkone wodda iso injifantannon;</para>
  <para style="q2" vid="JER 20:10">halotanna iso'n fullannon» hinaan.<verse eid="JER 20:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 20:11" />Yaane kinni Duuchchi Woddik Gootti janni goottishsha aninni welt hedheen;</para>
  <para style="q2" vid="JER 20:11">tennexxe anee'e shorredhaakiruwwi guggufate ibaa malee'e, insa'ne'a injifatabaan;</para>
  <para style="q1" vid="JER 20:11">Fuggo salphantaa malee injifantaba'a;</para>
  <para style="q2" vid="JER 20:11">salphinni insa'nekinna hara dedhemaba'a.<verse eid="JER 20:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 20:12" />Qulliyye hega uuddattokee, manjixxa qalbenna sammo memmekisse uuddattokee</para>
  <para style="q2" vid="JER 20:12">koo Lumoke Duuchchi Woddike Goottaa,</para>
  <para style="q1" vid="JER 20:12">Yaane anxa ate'n uwwedheennaxxe'e,</para>
  <para style="q2" vid="JER 20:12">insa'nen halo ani'a fulda'naa'a uudannoke assi.<verse eid="JER 20:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JER 20:13" />Duuchchi Woddika Gootta faarse;</para>
  <para style="q2" vid="JER 20:13">Duuchhci Woddike Gootti'anna galata uwwe;</para>
  <para style="q1" vid="JER 20:13">Isi rakkiyyetixxa lubbo,</para>
  <para style="q2" vid="JER 20:13">fuggaaleyyetenaa'n gatiseedheen.<verse eid="JER 20:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 20:14" />Ilemenexxe barra'a ise'a hoola; badinendeexxe kaddowwaal!</para>
  <para style="q2" vid="JER 20:14">Ama anxi anee'e ildeexxe eettene barra'a eldoqqe'e.<verse eid="JER 20:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 20:15" />«Labbak belto i'lite'etten» hiyyeexxi</para>
  <para style="q2" vid="JER 20:15">anna anke'n danbooba isoo'o kuleek</para>
  <para style="q2" vid="JER 20:15">iso'o gammachchiiseeke manji isi'a hoola.<verse eid="JER 20:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 20:16" />Ikki manji, Duuchchi Woddik Gootti mararte belo</para>
  <para style="q2" vid="JER 20:16">balleesemake qachchuwwishsha kadowwaal;</para>
  <para style="q1" vid="JER 20:16">Isi bariisa raare,</para>
  <para style="q2" vid="JER 20:16">saafo'ake'ninna bagediinxa weekensha laqowwaal.<verse eid="JER 20:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 20:17" />Ama anxik godobi hirreessa anke kaddo'a giddo gate'ennelena'a;</para>
  <para style="q2" vid="JER 20:17">ama anxik godobi duuchchi woddi'a lumoke kade hedho'a,</para>
  <para style="q2" vid="JER 20:17">silaan gadaamessi giddi'n fulebe'nok anee'e shiye'eelena'a.<verse eid="JER 20:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 20:18" />Rakkotanna abara uudonna'a</para>
  <para style="q2" vid="JER 20:18">bari anki salphinik muuxxemo'a</para>
  <para style="q2" vid="JER 20:18">mayee'e ilemenne?<note caller="-" style="x"><char style="xo" closed="false">20:18 </char><char style="xt" closed="false"><ref loc="JOB 3:1-19">Iyo. 3:1-19</ref>. </char></note><verse eid="JER 20:18" /></para>
  <chapter eid="JER 20" />
  <chapter number="21" style="c" sid="JER 21" />
  <para style="s1">Iyyerussaalemixxe Injfatema'a Haaso'endeexxa Wabeekumma</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 21:1" />Yihudik moyanji Sedeqiyaasi, Melkiyaake belto Phashihuurinna Ma'iseyaaka belto qeesichcho Sofoonyaasi'i isiba ergaa wodda, Duuchchi Woddike Goottik hiyyeechchi Ermiyaasiba'a dage: <verse eid="JER 21:1" /><verse number="2" style="v" sid="JER 21:2" />Iikki ergememmak manninna, «Baabiloonik moyanji Nabukadanatsoor no'oo lolate'e kaddemmaxxe'e, maganneten Duuchchi Woddika Gootta no'o'a laqi; akimagaada moyanji no'onaa'n higaashsha Duuchchi Woddiki Gootti qarishshanni mambe'a no'o'a assaaxxe hexxeen.»<note caller="-" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="2KI 25:1-11">2 Moy. 25:1-11</ref>; <ref loc="2CH 36:17-21">2 Odo. 36:17-21</ref>. </char></note><verse eid="JER 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 21:3" />Ermiyaasi kinni insa'nee, «Sedeqiyaasi'n hitinaaqic, <verse eid="JER 21:3" /><verse number="4" style="v" sid="JER 21:4" />‹Duuchchi Wooddik Gootti Isira'eelik Magen hiyya'nee qici: dalla'in gadhidarre ha'no'o buqeeka Baabiloonika moyanjonna Baabilonika manna loldino'a abixxitineek loliink miyi ha'noonni wirri hiyye miidhashsha assannon; loliinka miyanna konne qachchi giddi'a bukki hiyyaashsha aasannon. <verse eid="JER 21:4" /><verse number="5" style="v" sid="JER 21:5" />Ani umi aningenninni anga anxa iimi'a aadhe jabaxxe hirrenni, mufet, bubbaaxxe aarenninna jabaxxe balanni ha'no'o lolannon.<note caller="-" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="MAT 23:38">Mat. 23:38</ref>; <ref loc="LUK 13:35">Luq. 13:35</ref>. </char></note> <verse eid="JER 21:5" /><verse number="6" style="v" sid="JER 21:6" />Konne qachchi giddo hedha'neeka, manjo hore duucha gane'naa'a jabaxxe balanni mudaan. <verse eid="JER 21:6" /><verse number="7" style="v" sid="JER 21:7" />Ookonnechi uduma hiyya'nen Duuchchi Woddik Gootti, Yihudiinka moyanjo Sedeqiyaasinna ja'laabuwwa isika, konne qachchika, balatenaa'n wolaantichchakenaa'inna solo'okenaa'n gateeka arda lubbo insa'nexxa balleesso'a hasaake naapha'n, Nabukadanatsoori'i Baabiloonike moyanjo'n sa'isse uwwannon; isinna insa'ne'a godoba shaqqabaan; insa'ne'a mararabaan; insa'neenna hilabaan.›<verse eid="JER 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 21:8" />«Higgeenn konne arda'n hitattoqic, ‹Duuchchi Woddik Gootti hiyya'neeqic: Ani kunniseten ha'no edo hedhotikanna reyotika ora uggeennen; <verse eid="JER 21:8" /><verse number="9" style="v" sid="JER 21:9" />Konne qachchi giddo gataaki duuchchi wolaantichchik, solo'ikinna dhukkubik reyaan; fuleexxi buqemmake Baabiloonike manni'a anga uwwaak kinni reyabaan; hedho ifixxanna gatilsaan. <verse eid="JER 21:9" /><verse number="10" style="v" sid="JER 21:10" />Ani konne qachcha'ni eloxxe kaddebaak fuggoxxa assonna'a mudhdheenen: kunni qachchi Baabiloonike moanjiinxe anga'n sa'isseme'e uwwemaan; isinna iso'o giirat balleessaan, ani Duuchchi Woddik Gootti tenne'e haaso'eennen› hiyye.<verse eid="JER 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 21:11" />«Yihudiinke mootummatike mini hado'ninna hitattoqic, ‹Duuchchi Woddike Goottika hiyyichcho caqasse;<note caller="-" style="x"><char style="xo" closed="false">21:11 </char><char style="xt" closed="false"><ref loc="2KI 23:31-34">2 Moy. 23:31-34</ref>; <ref loc="2CH 36:1-4">2 Odo. 36:1-4</ref>. </char></note> <verse eid="JER 21:11" /><verse number="12" style="v" sid="JER 21:12" />Tee Daawwitixxe horteeri Duuchchi Woddik Gootti hiyya'neeqic:</para>
  <para style="q1" vid="JER 21:12">« ‹Assitineexxe fuggonaa'n kexxeexxa,</para>
  <para style="q1" vid="JER 21:12">Anxi mufe ha'no'n ha'yitabaashshanna,</para>
  <para style="q2" vid="JER 21:12">ayyinna xolsabaaqico'n bubbabaashsha,</para>
  <para style="q1" vid="JER 21:12">Barra duuchcha'ni dhugaa murre;</para>
  <para style="q2" vid="JER 21:12">mulqemeeka manjonna,</para>
  <para style="q2" vid="JER 21:12">iso'o miicemmakixxe anganaa'n gatisse.<verse eid="JER 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 21:13" />Dhooqati alidarre,</para>
  <para style="q2" vid="JER 21:13">rassatike tullichchi hana hexxetteke koo</para>
  <para style="q2" vid="JER 21:13">Iyyerusaalemike qachcha ani ate'n ke'ennen hiyya'neen Duuchchi Woddik Gootti.</para>
  <para style="q1" vid="JER 21:13">«Ayyete dage no'o'n ke'aak?</para>
  <para style="q2" vid="JER 21:13">Ayyete no'o he'nenneba dande'e e'yaak?» hitinaakee,<verse eid="JER 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 21:14" />Ani huje ha'nooxxishshanni ha'noo xixannon;</para>
  <para style="q2" vid="JER 21:14">hiyya'neen Duuchchi Woddik Gootti.</para>
  <para style="q1" vid="JER 21:14">Gongoma ha'noke'inna giira wocci assee'naa,</para>
  <para style="q2" vid="JER 21:14">qarqarake'n hedheechcho duuchchanna ittaan› » hiyya'neen Duuchchi Woddik Gootti.<verse eid="JER 21:14" /></para>
  <chapter eid="JER 21" />
  <chapter number="22" style="c" sid="JER 22" />
  <para style="s1">Ermiyaasi Yihudake Mowetike Mini Haduwwa'n Haaso'eeka Hiyyichcho</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 22:1" />Duuchchi Woddiki Gootti hiyya'neeqic, «Yihudake mootommatike miniba'a adadde dirrite erga konnechchi butti'a hexxeexxa hite'e haasottattoqic, <verse eid="JER 22:1" /><verse number="2" style="v" sid="JER 22:2" />‹Daawwitixxe moote'n ofoldetteke, koo Yihudake moyanjoo, atinna ja'laabuwwi atikinna konne bituma'n e'yaak atik ardi duuchchi Duuchchi Woddike Goottika hiyyichcho laqqe. <verse eid="JER 22:2" /><verse number="3" style="v" sid="JER 22:3" />Duuchchi Woddiki Gootti hiyya'neeqic, dhugaanna qullumma hujje; mulqemeeka miicemmakixxe anganaa'n gatisse; keessummumma ofo'leeka manjo, anna ama affeebaaxxa oosenna aro'o shi'witeexxa melaalle miicinoqqe; rakkissinoqqe; konne booncho'n balleessa afebaake manjixxa munde dundinoqqe'e. <verse eid="JER 22:3" /><verse number="4" style="v" sid="JER 22:4" />Ha'no'o konne ajajuwwa xexxe'achchoti heqqexxinoole, Daawwitixxe moote'n ofo'laak moyanjuwwi fadhadinxe gaare'ninna fadhadoke'n ofo'leexxi, ja'laabuwwi insakinna ardi insa'nek insa'nee'e qoqobee'na'a konne mootomatike minike bitumiba'a e'yina'nee'e fullaan. <verse eid="JER 22:4" /><verse number="5" style="v" sid="JER 22:5" />Yaane kinni konne ajajuwwa heqqedha gophphinoole, kunni mootomatik mini findigemaaxxa ani Duuchchi Woddik Gootti ifi'n kakate'eennen› hiiyye'een.»<verse eid="JER 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 22:6" />Tennexxee Duuchchi Woddik Gootti Yihudake moyanjiinxe mootomatike minixxee hiyya'nee qici:</para>
  <para style="q1" vid="JER 22:6">«Ati Gele'adishshanna</para>
  <para style="q2" vid="JER 22:6">Libaanoosixxe koobuwwaxxe xungoshsha ani'a danchondottolenna,</para>
  <para style="q1" vid="JER 22:6">Dhugaaten, ani atee'e qiilla gammoojje,</para>
  <para style="q2" vid="JER 22:6">manji giddo hedhammabaake qachchuwwishsha atee'e assannon.<verse eid="JER 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 22:7" />Atee'e balleessatee mitti mittingi lolinka miya abixxeeka manna,</para>
  <para style="q2" vid="JER 22:7">ate'n dagaashsha assannon;</para>
  <para style="q1" vid="JER 22:7">Insa'nenna danchoole atika birbirsinka haqichchuwwa kukkuntee</para>
  <para style="q1" vid="JER 22:7">Giirate'n takki assinaan.<verse eid="JER 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 22:8" />«Heddo gosa gosak ardi ookkone qachchibaa'n sa'aa woddaa, ‹Duuchchi Woddiki Gootti konne lumoke qachcha'n mayee iitta asse?› hina'n weli'a weli qorraan; <verse eid="JER 22:8" /><verse number="9" style="v" sid="JER 22:9" />Insa'nenna ookkonechchi uduma, ‹Insa'ne Duuchchi Woddike Gootta ifike Magenixxa kako waalleexxi wele dharichcha magenuwwa magenooffanteemmaxxeenna ergatemmeemmaxxeten hinaan.› »<verse eid="JER 22:9" /></para>
  <para style="s1">Ermiyaas Moyanjo Shaalomixxee'e Haaso'eexxa Wabeekumma</para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 22:10" />Illeema higa gophammaxxee</para>
  <para style="q2" vid="JER 22:10">yookaan langaxxa ilemeeka boga uuda gophammaxxee</para>
  <para style="q1" vid="JER 22:10">Booji'emeeke moyanji'a hiiqqissine oodhdhe malee'e,</para>
  <para style="q2" vid="JER 22:10">reyemmakee'e ooxxinoqqe'e; yaaddinoqqe'e.<verse eid="JER 22:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="JER 22:11" />Anxe bakka'n Yihuda'n moyemmake, konne boonchonaa'ninna booji'eme adhdhememmake, Shelumi Iyyosiyaasik beltixxee Duuchchi Woddiki Gootti: «Isi kaba'a illeema higabaan. <verse eid="JER 22:11" /><verse number="12" style="v" sid="JER 22:12" />Booji'eme me'emmake boga'ninni reyaa malee'e langaxxa konne boga uudabaan.»<verse eid="JER 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 22:13" />«Ifika mootomatika mine seeribeloke orinni ijaadhdhake,</para>
  <para style="q2" vid="JER 22:13">ifike mini hana mine seerbelo ijaadhdhake,</para>
  <para style="q1" vid="JER 22:13">Tola boddichcha manjo hujisaakee</para>
  <para style="q2" vid="JER 22:13">elo'emmake mannika hira uwwabaake isi'a aanne'e!<verse eid="JER 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 22:14" />‹Ani ba'lalamma</para>
  <para style="q2" vid="JER 22:14">kutuwwaka mootomatika mine hana ijaadhdhannon hiyyaake isi'a aanne'e!›</para>
  <para style="q1" vid="JER 22:14">Isi ba'lallamma maskootuwwa mine okkone'a giissaan;</para>
  <para style="q2" vid="JER 22:14">ejersinke haqichchinni danchoossaan;</para>
  <para style="q2" vid="JER 22:14">diimmoxxa boo'enna itti issaan.<verse eid="JER 22:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JER 22:15" />«Ejersiinke haqqenni mine ijaadhdhitettexxee'e</para>
  <para style="q2" vid="JER 22:15">mootattochcho ate'n labbee?</para>
  <para style="q1" vid="JER 22:15">Anni atik dhugaanna qullumma hujeemmaxxe</para>
  <para style="q2" vid="JER 22:15">itaachchinna ha'waachchi isinaa'n xe'yeemma'a?</para>
  <para style="q2" vid="JER 22:15">Tenne asseexxee duuchchinx isa'a qajeelda'emman.<verse eid="JER 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 22:16" />Isi hiyyeeyyeteenna rakkiyyetee dhugaa mureen;</para>
  <para style="q2" vid="JER 22:16">tennexxee duuchiinxi yaane isi'a qajeelde;</para>
  <para style="q1" vid="JER 22:16">Anee ege'nate hiyyo tennetebaata?»</para>
  <para style="q2" vid="JER 22:16">hiyya'neen Duuchchi Woddik Gootti.<verse eid="JER 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 22:17" />«Yaane kinni Ille atixxi uuda'neexxinna godobi atik halcha'neek</para>
  <para style="q2" vid="JER 22:17">dabik la'o alfatee'e</para>
  <para style="q1" vid="JER 22:17">Balleessa afebaake mannixxa munde dunati</para>
  <para style="q2" vid="JER 22:17">manjo miicanna miidha calla'aten.»<verse eid="JER 22:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="JER 22:18" />Tennexxee Duuchchi Woddiki Gootti Yihudaka moyanjo Iyyo'aaqemii'i Iyyosiyaasike beltixxee hiyya'nee qici:</para>
  <para style="q1" vid="JER 22:18">«Manni ‹Woo woo, anke dayyoo! Woo woo, anxe dayyoo!›</para>
  <para style="q2" vid="JER 22:18">hiyye'e isi'a oodhabaan:</para>
  <para style="q1" vid="JER 22:18">‹Woo woo, anke gootta! Aanne'e isixxe moyanjumma'a!›</para>
  <para style="q2" vid="JER 22:18">hine'e isi'a oo'nabaan.<note caller="-" style="x"><char style="xo" closed="false">22:18 </char><char style="xt" closed="false"><ref loc="2KI 23:36-24:6">2 Moy. 23:36—24:6</ref>; <ref loc="2CH 36:5-7">2 Odo. 36:5-7</ref>. </char></note><verse eid="JER 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 22:19" />Isi rerteexxe harreshsha harkisemeexxi Iyyerusaalemike dalla'i gadhi darre hunemaan.»<verse eid="JER 22:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 22:20" />«Koo Iyyerussaalemike arda Libaanoosi hana martine raarre;</para>
  <para style="q2" vid="JER 22:20">hafuura gikki assitine'e Baasani giddo hunbaashshe,</para>
  <para style="q1" vid="JER 22:20">Abaarim hexxinenna raarre;</para>
  <para style="q2" vid="JER 22:20">jaaluwwi ha'nok duuchchi mude'een.<verse eid="JER 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 22:21" />Nage'ik hexxinnemma woda ani ha'noo xexxe'achchiisenne;</para>
  <para style="q2" vid="JER 22:21">ha'no kinni, ‹Lanqabe'non› hitine;</para>
  <para style="q1" vid="JER 22:21">Oosummadenaa'ninni safe ori atiki konnedemman;</para>
  <para style="q2" vid="JER 22:21">hiyyichcho ankanna laqqeebexxon.<verse eid="JER 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 22:22" />Akeekisanjuwwi ha'nok duuchchi diidallo adhdheemman;</para>
  <para style="q2" vid="JER 22:22">huura adhdhite me'itammashsha booji'emee adhdhemaan;</para>
  <para style="q1" vid="JER 22:22">Ha'noxxe fuggoxxe huje duuchchinaa'n kexxeexxa</para>
  <para style="q2" vid="JER 22:22">shookkinaan; salphattinaan.<verse eid="JER 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 22:23" />Koo ha'no ‹Libaanoosi› giddo hexxina'neeke,</para>
  <para style="q2" vid="JER 22:23">galduminxa bakkanna ejersinke haqichinni ijaadhdhitine'eekee</para>
  <para style="q1" vid="JER 22:23">Ciniinfattammaxxe manjichchoshsha,</para>
  <para style="q2" vid="JER 22:23">rakko ha'no'n daggaa wodda hitta raartinuta!<verse eid="JER 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 22:24" />«Ani hedhaanneke kada anxe'ni kakaatannen» hiyya'neen Duuchchi Woddik Gootti, «Yihudake moyanjo, Iyyo'aaqemike belto, Ikooniyaa, dhugaa'a anee'e hedhannoke Duuchchi Woddik Goottixxa! Ati anxe middixxe angaxxe qube kaddeettelenna midde, atee fulchee hunanno.<note caller="-" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="2KI 24:8-15">2 Moy. 24:8-15</ref>; <ref loc="2CH 36:9-10">2 Odo. 36:9-10</ref>. </char></note> <verse eid="JER 22:24" /><verse number="25" style="v" sid="JER 22:25" />Atee'e shiyo'a hasa'neekenna insa'nee'e sodaata'etteke Baabiloonike manna'inna Nabukadanatsoori'i Baabiloonike moyanjiinxe anga'n sa'isse atee'e uwwannon. <verse eid="JER 22:25" /><verse number="26" style="v" sid="JER 22:26" />Ateenna atee ildeexxa ama ilendinebaake wele boga'n fugussee'na'a ha'no laming okko rertinaan; <verse eid="JER 22:26" /><verse number="27" style="v" sid="JER 22:27" />Higgino'a halchitinammake bogiba'aanna ijje higginabaan.»<verse eid="JER 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 22:28" />Kunni Ikooniyaan hiyyemeek manjichchi rerte jibbendeexxe oddolchooshsha</para>
  <para style="q2" vid="JER 22:28">ayyinna iso'o hasabaake miya is?</para>
  <para style="q1" vid="JER 22:28">Isinna oose isixxi mayeete gadhi'a hunnemeechchi?</para>
  <para style="q2" vid="JER 22:28">egennebaake boga'n mayeete darbemmeechchi?<verse eid="JER 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 22:29" />Tee buttaa, tee buttaa, tee bauttaa!</para>
  <para style="q2" vid="JER 22:29">Duuchchi Woddiki Goottika hiyyichcho laqi!<verse eid="JER 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 22:30" />Duuchchi Woddik Gootti hiyya'neeqic,</para>
  <para style="q1" vid="JER 22:30">«Konne manjixxe hortenaa'n mittekeenna qajeeldabaak,</para>
  <para style="q2" vid="JER 22:30">mittekinna Daawwitixxe moote'n ofo'labaake</para>
  <para style="q1" vid="JER 22:30">Yookaan Yihudaka boga mowe galchaaka afebaake kademmaxxe'e</para>
  <para style="q2" vid="JER 22:30">isi hedho isixxike baro duuchcha'n yaane isi'a qajeeldebaake</para>
  <para style="q2" vid="JER 22:30">middisa manjon hitine borreesse.»<verse eid="JER 22:30" /></para>
  <chapter eid="JER 22" />
  <chapter number="23" style="c" sid="JER 23" />
  <para style="s1">Hegerixxa Adde</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 23:1" />«Anxe bobaarisaxxe bakka'n hedheeka anka gedhebo balleessitinaaxxeenna xeertina'neexxe allalisano'a aanne'e» hiyya'neen Duuchchi Woddiki Gootti. <verse eid="JER 23:1" /><verse number="2" style="v" sid="JER 23:2" />Tennexxee Duuchchi Woddiki Gootti Isira'eelik Mageni arda anka heqqita'neexxa allalisano, «Gedhebo anka xeertinemmaxxe'e, shorritinemmaxxenna hore ankee xexxe'ata gophphinemmaxxe'e fuggoxxe ha'noxxe hujexxee ha'no'o xixannon» hiyya'neen Duuchchi Woddiki Gootti. <verse eid="JER 23:2" /><verse number="3" style="v" sid="JER 23:3" />«Gateeka anka hore xexxeerenneke boga duuchchanaa'n ani ifi'aan bukki asse'e allalemaaba'a hiissedhannon; ookkonna horre bira sa'naan. <verse eid="JER 23:3" /><verse number="4" style="v" sid="JER 23:4" />Insa'ne heqqitaaxxa allalisano uggannon; ta'anni elqi'a sodaantabaan; bararanqabaan; insa'ne giddii'n mittikinna xe'yabaan» hiyya'neen Duuchchi Woddik Gootti.<verse eid="JER 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 23:5" />«Kunniseten Daawwitixxe hortenaa'n</para>
  <para style="q2" vid="JER 23:5">qullichcha moyanjo idagannoxxe barra daggaan;</para>
  <para style="q1" vid="JER 23:5">Isinna dhugaanna qullumma assan,</para>
  <para style="q2" vid="JER 23:5">beekkumik galchaak kadaan» hiyya'neen Duuchchi Woddik Gootti.<verse eid="JER 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 23:6" />Isi galchaake baro'n Yihuda anjiremaan;</para>
  <para style="q2" vid="JER 23:6">Isira'eelik ardinna nage'ik hedhaan;</para>
  <para style="q1" vid="JER 23:6">Isinna ye'emaak summi</para>
  <para style="q2" vid="JER 23:6">Duuchchi Woddiki Gootti no'oxxe qullumman hiyyemaake kada.<note caller="-" style="x"><char style="xo" closed="false">23:6 </char><char style="xt" closed="false"><ref loc="JER 33:14-16">Erm. 33:14-16</ref>. </char></note><verse eid="JER 23:6" /></para>
  <para style="b" />
  <para style="m">
    <verse number="7" style="v" sid="JER 23:7" />«Tennexxee manni, ‹Isira'eelika arda Gibtse'en fulcheek hedhaak Duuchchi Woddiki Gootti ege'neexxa› hiyye'e kakatabaaxxe bara daggaan hiyya'neen Duuchchi Woddik Gootti. <verse eid="JER 23:7" /><verse number="8" style="v" sid="JER 23:8" />Yaane kinni insa'ne hinee qici, ‹Isira'eeli'i middi boganaa'inna insa'nee'e xexxeeremmaake wele boganaa'ni fulcheek hedhaak Duuchchi Woddik Gootti ege'neexxa› ookkonechchi uduma insa'ne ifinge boga'n he'naan.»<verse eid="JER 23:8" /></para>
  <para style="s1">Dhariyye Wabeekkolexxee Haaso'emeeka Wabeekkumma</para>
  <para style="p">
    <verse number="9" style="v" sid="JER 23:9" />Wabeekoletixxee,</para>
  <para style="q1" vid="JER 23:9">Godobi anee'e gubate,</para>
  <para style="q2" vid="JER 23:9">mikiti anee gilgile;</para>
  <para style="q1" vid="JER 23:9">Duuchchi Woddike Goottixxeenna</para>
  <para style="q2" vid="JER 23:9">woyyichcha hisike hiyyichchixxee,</para>
  <para style="q1" vid="JER 23:9">Woyinetik bulbulo ha'we,</para>
  <para style="q2" vid="JER 23:9">machcho'eeke manjishsha kadenne.<verse eid="JER 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 23:10" />Boga duuchcha'n yabaabulle wo'mite;</para>
  <para style="q2" vid="JER 23:10">Mageniinke yowwichchonaa'n kexxeexxa bogi duuchchi yaadaan;</para>
  <para style="q2" vid="JER 23:10">qiila gammoojje'ni hexxeexxi arso bagge'een.</para>
  <para style="q1" vid="JER 23:10">Wabeekkoletinna fuggo ora me'iteexxi</para>
  <para style="q2" vid="JER 23:10">baalle ifixxanna seeribaabelo la'ooffateen.<verse eid="JER 23:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 23:11" />«Wabeekkichchikinna, qeesichchi qullummatike ora'n me'inebaan;</para>
  <para style="q2" vid="JER 23:11">anke galmi giddo midde insa'nexxa fuggoxxa huje uudennen,»</para>
  <para style="q2" vid="JER 23:11">hiyya'neen Duuchchi Woddik Gootti.<verse eid="JER 23:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 23:12" />«Tennexxee ori insa'nek salaqaake kadaan;</para>
  <para style="q2" vid="JER 23:12">dukkana giddi'a hunemmeexxi,</para>
  <para style="q2" vid="JER 23:12">tintimmenna inbaan;</para>
  <para style="q1" vid="JER 23:12">Insaa'nee xixannoxxe wogga'n,</para>
  <para style="q2" vid="JER 23:12">bala insa'ne'n ibisannon,»</para>
  <para style="q2" vid="JER 23:12">hiyya'nen Duuchchi Woddiki Gootti.<verse eid="JER 23:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JER 23:13" />«Semaariya hexxeexxe wabeeko'n,</para>
  <para style="q2" vid="JER 23:13">manjo jibbissaaxxa yaane uude'ennen;</para>
  <para style="q1" vid="JER 23:13">Insa'ne Ba'aalike summinni wabeekkumma haasonna'n,</para>
  <para style="q2" vid="JER 23:13">arda anka Isira'eli'i dedhinse.<verse eid="JER 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 23:14" />Iyyerusaalemi hexxeexxe wabeekkoluwwa'n,</para>
  <para style="q2" vid="JER 23:14">cori gibissaaxxa yaane uude'ennen;</para>
  <para style="q2" vid="JER 23:14">yabaabulle, dhark haasonnaan</para>
  <para style="q1" vid="JER 23:14">Ayyinna fuggoxxenaa'n higabaashsha</para>
  <para style="q2" vid="JER 23:14">fuggaaleeyye fuggoxxe'e tirtisa;</para>
  <para style="q1" vid="JER 23:14">Insa'ne'e duuchchi ani'a Soodoomishsha,</para>
  <para style="q2" vid="JER 23:14">Iyyerussaalemik ardinna Gomorashshaten» hiyye.<note caller="-" style="x"><char style="xo" closed="false">23:14 </char><char style="xt" closed="false"><ref loc="GEN 18:20">Dada. 18:20</ref>; <ref loc="EZK 16:49">Hiz. 16:49</ref>. </char></note><verse eid="JER 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 23:15" />Tennexxee Lumok Duuchchi Woddiki Gootti tenne wabeekkolexxee,</para>
  <para style="q1" vid="JER 23:15">«Iyyerusaalemixxe wabeekkole</para>
  <para style="q2" vid="JER 23:15">boga duuchcha'a battitte yaane geessissemmaxxee'e</para>
  <para style="q1" vid="JER 23:15">Qaraartaaxxa ita indaashsha,</para>
  <para style="q2" vid="JER 23:15">ha'la afe'eka wode'enna ha'winaashsha assannon» hiyye.<verse eid="JER 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 23:16" />Lumok Duuchchi Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 23:16">«Tinni Wabeeko ha'no'n raaga'neeka raagaa laqqinoqqe'e;</para>
  <para style="q2" vid="JER 23:16">dharinxa addachiisa ha'no'n haasonnaan;</para>
  <para style="q1" vid="JER 23:16">Duuchchi Woddike Goottike haaso'eeke kadebaak</para>
  <para style="q2" vid="JER 23:16">ifi'ke godobika yaada haasonnaan.<verse eid="JER 23:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 23:17" />Insa'ne hiyyannoxxa laqabaake mannan,</para>
  <para style="q2" vid="JER 23:17">‹Ha'no'o Duuchchi Woddik Gootti nage'ik hexxinaan hiyye'en› hinaan;</para>
  <para style="q1" vid="JER 23:17">Ifike godobobika fuggoka yaada hordofaaka manna duuchchanna</para>
  <para style="q2" vid="JER 23:17">‹Elobaaxxi ha'no'o kissabaan hiyya'neen› hinaan.<verse eid="JER 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 23:18" />Tenne wabeekkole giddii'n hiyyichcho isika laqateenna uudatee'e,</para>
  <para style="q2" vid="JER 23:18">ayyeeramma Duuchchi Woddike Goottixxi mari'e hexxeeba uurre'emmakilaati?</para>
  <para style="q2" vid="JER 23:18">Hiyyichcho iskanna laqe'e caqaseek ayyetemmaraata?<verse eid="JER 23:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 23:19" />Kunniseten, Duuchchi Woddike Goottixxi mufe jabaxxinni</para>
  <para style="q2" vid="JER 23:19">hobonbalteshsha daggaan,</para>
  <para style="q1" vid="JER 23:19">Lumoki danbala'inna,</para>
  <para style="q2" vid="JER 23:19">fuggaaleyyetika umo ganaan.<verse eid="JER 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 23:20" />Duuchchi Woddik Goottixxi mufe godoba isikika yaada</para>
  <para style="q2" vid="JER 23:20">wo'maa qicinni muuxxaqici'on</para>
  <para style="q2" vid="JER 23:20">udumi'a higgabaan;</para>
  <para style="q1" vid="JER 23:20">Ha'nonna udumike baro'n</para>
  <para style="q2" vid="JER 23:20">tenne'e adda qalbeeffattinaan.<verse eid="JER 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 23:21" />Ani tenne wabeekkole ergeebo'non;</para>
  <para style="q2" vid="JER 23:21">insa'ne kinni ifi'aann erga ifixxa adhine gongine;</para>
  <para style="q1" vid="JER 23:21">Insa'ne'n haaso'ebe'nong,</para>
  <para style="q2" vid="JER 23:21">wabeekummatanna haasonne.<verse eid="JER 23:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 23:22" />Silaan mari'e anxi hexxeeba afemme'eele,</para>
  <para style="q2" vid="JER 23:22">hiyyichcho anka arda ankee'e lallanbamman;</para>
  <para style="q1" vid="JER 23:22">Arda anka fuggoke oranaa'ninna,</para>
  <para style="q2" vid="JER 23:22">elobaaxxe hujenaa'n hissinamman.<verse eid="JER 23:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="JER 23:23" />«Ani shiqike Mageno callata?»</para>
  <para style="q2" vid="JER 23:23">hiyya'neen Duuchchi Woddik Gootti,</para>
  <para style="q2" vid="JER 23:23">«Bayyikennabaata?<verse eid="JER 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 23:24" />Ani afabe'noshsha,</para>
  <para style="q2" vid="JER 23:24">qoonne bakka'n sho'oma dande'aak hedheeta?»</para>
  <para style="q2" vid="JER 23:24">hiyya'neen Duuchchi Woddik Gootti.</para>
  <para style="q2" vid="JER 23:24">«Iimanna butta wo'meennek antebaata?»</para>
  <para style="q2" vid="JER 23:24">hiyya'neen Duuchchi Woddik Gootti.<verse eid="JER 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 23:25" />«Ani ‹Oojjo oojjotenne! Oojo oojjotenne!› hita'n anke summinni dharinka raaga raagga'neexxe wabeekoka hiyyichcho laqeennen. <verse eid="JER 23:25" /><verse number="26" style="v" sid="JER 23:26" />Tinni yaane ifixxe halchaka dharichcha yaada raaga raagga'neexxe dhariyye wabeekkoxxe sammo'nita hedha'n hedhaanneek haaniqici'ate? <verse eid="JER 23:26" /><verse number="27" style="v" sid="JER 23:27" />Annuwwi insa'nek Ba'aali'i magenooffanta'n anee'e deenaashsha, insa'ne haasonna'neexxe oojjonni ank ardi anee'e dedhaashsha assineechcho insa'ne'n fakkatta'neen. <verse eid="JER 23:27" /><verse number="28" style="v" sid="JER 23:28" />Oojjo oojjoteek wabeekkichchi eetteneenn ifixxa oojjo haaso'owwaal; hiyyichcho anka laqeek kinni addatenshati ookkoneenni hiyyichcho haaso'owwaal; huurikinna midha mitteteeta?» hiyya'neen Duuchchi Woddik Gootti. <verse eid="JER 23:28" /><verse number="29" style="v" sid="JER 23:29" />«Hiyyichchi ank giiratishshateba,» hiyya'nen Duuchchi Woddik Goottii, «hiyyichchi anki kinjo bulleessammake burrisishshatebaata?<verse eid="JER 23:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 23:30" />«Tennexxee hiyyichcho anka weli welinaa'n moorteexxi anenaa'n laqe'eeshsha haasotta'neexxe wabeekkole'n ke'annon» hiyya'neen Duuchchi Woddik Gootti. <verse eid="JER 23:30" /><verse number="31" style="v" sid="JER 23:31" />Ifinga yaada, «kunni Duuchchi Woddik Gootti hiyyichchon hita'n haasottaaxxe wabeekkole gibannon, ‹hiyya'nen Duuchchi Woddik Gootti.› <verse eid="JER 23:31" /><verse number="32" style="v" sid="JER 23:32" />Kunniseten ani dharinxa oojjonni raaga raaggaaxxe wabeeko gibannon» hiyya'neen Duuchchi Woddiki Gootti, «Ani insa'nee'e ergebe'nong yookaan hariirebe'nong soda'abelo dhara haasonna; arda ankanna dedhinsa; insa'ne konne ardi'a mittelchonna woyi fullabaan» hiyya'nen Duuchchi Woddiki Gootti.<verse eid="JER 23:32" /></para>
  <para style="s1">Dhariyye Wabeekkoleka Wabeekkumma</para>
  <para style="p">
    <verse number="33" style="v" sid="JER 23:33" />Duuchchi Woddik Gootti ane'e hiyyeqici, «Koo Eermiyaasi! Kunni ardi yookaan wabeeka mitti yookaan qeesichchi mitti, ‹Duuchchi Woddike Goottixxi erga maachcho?› hine atee qorroole atinna insa'ne'e, ‹Duuchchi Woddik Goottixxi erga ha'noote kaddinemmaxxee ifi edii'n ha'no fugussannon› hite insa'ne'a kuli. <verse eid="JER 23:33" /><verse number="34" style="v" sid="JER 23:34" />Wabeeki yookaan qeesichchi yookaan ayyinna, ‹Tinni Duuchchi Woddike Goottixxe erga hiyyoole,› ookkone manjonna isika mini hado ani mura woxisannon. <verse eid="JER 23:34" /><verse number="35" style="v" sid="JER 23:35" />Mitti mitting jaalo ifika yookaan fira ifika: ‹Duuchchi Woddik Gootti maa hissichcho uwwe?› yookaan ‹Duuchchi Woddik Gootti maa haaso'e?› hiyye qora ati'a hasissaan. <verse eid="JER 23:35" /><verse number="36" style="v" sid="JER 23:36" />Ta'in elqi'a kinni ‹Duuchchi Woddik Goottixxe erga hitine haasottinoqqe'e› haasottinabaachchinna, manji duuchchi'a ifi'ann haaso'emmak hiyyichchi isinxe kadammaxxee ha'no hedhaake Magenika, Lumoke Duuchchi Woddik Gootta no'oke Magenika hiyyichcho dassinammaxxeten. <verse eid="JER 23:36" /><verse number="37" style="v" sid="JER 23:37" />Tennexxee wabeekkichchoke'ni: ‹Duuchchi Woddik Gootti ate'n maa hiissichcho uwwe› yookaan ‹Duuchchi Woddik Gootti maa hiyye ate'n haaso'e?› Hite'e isoo qor. <verse eid="JER 23:37" /><verse number="38" style="v" sid="JER 23:38" />‹Duuchchi Woddike Goottixxe ba'on› hitineexxe kaddoole midde, Duuchchi Woddik Gootti ‹Ani, «Duuchchi Woddike Goottixxe ba'oni» hitinoqqe'e› hiyye ha'nonni kulee'naanni, ha'no ‹Duuchchi Woddike Goottixxe ba'oni› hitine'een. <verse eid="JER 23:38" /><verse number="39" style="v" sid="JER 23:39" />Tennexxe ha'no'o, ittanni edike ha'noke annuwi'a uwwenneka qachchinni welti ha'no dedhannon; alba anke edi'inna ha'no'o fugussannon. <verse eid="JER 23:39" /><verse number="40" style="v" sid="JER 23:40" />Ani duuchchin woddi'a dedhemmabaaka shooko, duuchchi woddika salphinnenn ha'no'n idagannon.»<verse eid="JER 23:40" /></para>
  <chapter eid="JER 23" />
  <chapter number="24" style="c" sid="JER 24" />
  <para style="s1">Lame Qiricco Balasetixxe Gummaka Fakkeenna</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 24:1" />Baabilonik moyanji Naabukadanatsoorii, Iyyo'aaqemika belto Yihudaka moyanjo Ikooniyaaninna isika ja'laabuwwa ittanni Yihudaka haqqetixxa oge afe'ekanna sibilo tumammaka manna Iyyerusaalemi'n Baabilooni'a booji'eechchi uduma, Duuchchi Woddiki Gootti lame qiricco balase galmi edi darre hexxee'na'a ane'n leelishe.<note caller="-" style="x"><char style="xo" closed="false">24:1 </char><char style="xt" closed="false"><ref loc="2KI 24:12-16">2 Moy. 24:12-16</ref>; <ref loc="2CH 36:10">2 Odo. 36:10</ref>. </char></note> <verse eid="JER 24:1" /><verse number="2" style="v" sid="JER 24:2" />Mitte qiriccoxxi rakke raxxeexxe balase fakkaattaaxxe elolla gumma hexxemman; langaxxe qiricco'n kinni itatee'e eldabaaxxe elobaaxxe belase hexxemman.<verse eid="JER 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 24:3" />Okkoneechchi uduma Duuchchi Woddiki Goottinna anee'e, «Koo, Ermiyaasi affa'ettelchchi kunni maachcho?» hiyye qore.</para>
  <para style="p" vid="JER 24:3">Aninna, «Balasete afa'enne; elollamma yo'oshsha eloxxen; elobaaxxi kinni itissabaaxxe yo'oshsha elobaaxxen.»<verse eid="JER 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 24:4" />Higgeenn Duuchchi Woddike Goottik hiyyichchi anibaa dageexxi: <verse eid="JER 24:4" /><verse number="5" style="v" sid="JER 24:5" />«Isira'eelik Duuchchi Woddiki Gootti Mageni: ‹Tenne eloxxe balaseshsha, konne boonchinaa'n Baabilooni'a boojji'm'o'a wocci assenneka Yihudaka manna eloxxen uudannon. <verse eid="JER 24:5" /><verse number="6" style="v" sid="JER 24:6" />Eloxxenni ille anxi insa'nee'e uuddaan; konne bogibaanna insa'nee'e idagannon; ijaaranno malee insa'nee diigabe'no; kasanno malee insa'ne'e goshabe'no. <verse eid="JER 24:6" /><verse number="7" style="v" sid="JER 24:7" />Ani Duuchchi Woddike Gootta kadennexxa anee'e egenaaxxa qalbe insa'ne'a uwwannon; mitte godobinni anibaa hingammaxxe'e, insa'ne anike arda kandaan; aninna insa'neke Mageno kadannon.<verse eid="JER 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 24:8" />« ‹Yaane kinni itissammabaaxxe elobaaxxe balaseshsha Yihudak moyanji Sedeqiyaasinna isik ja'laabuww ittanni Iyyerusaalemi gatemmake'inna Gibtsee hedhammake manna'n iittan assannon hiyya'neen Duuchchi Woddik Gootti. <verse eid="JER 24:8" /><verse number="9" style="v" sid="JER 24:9" />Ani insa'nee'e butta duuchchixxe moottummuwwa duuchchi edo diqatemmakenna, jibbemmaake assannon; insa'nee'e xexxeerannoke booncho duuchcha'n cee'memmaashanna mammaakemmaake, qacifatemmashshanna yowwemmaashsha assannon. <verse eid="JER 24:9" /><verse number="10" style="v" sid="JER 24:10" />Insa'ne'anna insa'neke annuwwi'a uwwennake boganaa'ni ba'naaqici'a bagedo, solo'okanna dhukkuba insa'ne'n ergannon.› »<verse eid="JER 24:10" /></para>
  <chapter eid="JER 24" />
  <chapter number="25" style="c" sid="JER 25" />
  <para style="s1">Torbaane Tomme Booji'otixxa Wogguwwa</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 25:1" />Yihudak moyanji Iyyosiyaasik belti Iyyo'aaqemi moyeexxe sholgaxxe wogga'n, tinninna Baabiloonke moyanjo Naabukadanatsoori moyeexxe siretixxe wogga'n, duuchinge Yihudake ardixxee'e Duuchchi Woddike Goottik hiyyichchi Ermiyaasiba'a dage.<note caller="-" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="2KI 24:1">2 Moy. 24:1</ref>; <ref loc="2CH 36:5-7">2 Odo. 36:5-7</ref>; <ref loc="DAN 1:1-2">Dan. 1:1-2</ref>. </char></note> <verse eid="JER 25:1" /><verse number="2" style="v" sid="JER 25:2" />Tennexxee wabeekichchi Eermiyaas Yihudake arda duuchcha'ninna Iyyerusaalemi hedha'neeke duuchcha'n hiyye haaso'ee qici, <verse eid="JER 25:2" /><verse number="3" style="v" sid="JER 25:3" />Yihudak moyanji Amoonik belti Iyyosiyaasi moyeexxe tommenna sakkeessoxxe wogganaa'n telchi qico'n lame tommenna sase wogga duuchcha, Duuchchi Woddike Goottik hiyyichchi aniba'a dageen, aninna lebe lebe'e ha'noo'n kulennee; ha'no kinni laqqinebaan.<verse eid="JER 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 25:4" />Duuchchi Woddiki Gootti raagole ifixxa erganjuwwa duuchcha lebe lebe'e ha'nobaa ergeen; kaddo malee'e ha'no caqassinebaan; qalbeeffatinebaan. <verse eid="JER 25:4" /><verse number="5" style="v" sid="JER 25:5" />Insa'nenna «Ha'no mitti mitting elobaake oranaa'ninna elobaaxxe hujenaa'n higge; Duuchchi Woddiki Gootti ha'no'anna ha'noke annuwwi'a uwwemmake boga'n duuchchi woddi'a hexxinaan. <verse eid="JER 25:5" /><verse number="6" style="v" sid="JER 25:6" />Wele magenuwwa hordofina'n magenooffattinoqqe; anga ha'noxxi hujjeechchininna anee'e mufachchisinoqqe; aninna ha'noo'n elobaaxxa assabe'non» hine.<verse eid="JER 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 25:7" />«Yaane kinn ani hiyyaannexxa laqinebaan» hiyya'neen Duuchchi Woddiki Gootti «Anga ha'noxxi hujjeechchini anee'e mufachchiissine; ifi'ninni fuggoxxa iyyedaqqitine.»<verse eid="JER 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 25:8" />Tennexxee Lumok Duuchchi Woddik Gootti hiyya'neeqic: «Ha'no hiyyichcho anka caqasa gophphinemmaxxe'e, <verse eid="JER 25:8" /><verse number="9" style="v" sid="JER 25:9" />middika arda duuchchanna, erganjo anka Baabiloonika moyanjo Naabukadanatsoorii ye'annon» hiyya'neen Duuchchi Woddik Gootti, insa'nenna, «konne boga'n isi giddo hedheeke arda'ninna, qarqarake'ni hedheeke arda duuchcha'n iyyedagennexxi ijje insa'nexxa balleessannon; diqatemmashshanna gacifatemmaashsha, duuchchi woddi'a insa'ne'e onake assannon. <verse eid="JER 25:9" /><verse number="10" style="v" sid="JER 25:10" />Gammadikinna illilleettetik cuqqeessi, waajubichchinkinna wajubichchotiki cuqqeessi, daamink cuqqeessinna xassiink ifi hedhabaashsha assannon.<note caller="-" style="x"><char style="xo" closed="false">25:10 </char><char style="xt" closed="false"><ref loc="JER 7:34">Erm. 7:34</ref>; <ref loc="JER 16:9">16:9</ref>; <ref loc="REV 18:22-23">Wal. 18:22-23</ref>. </char></note> <verse eid="JER 25:10" /><verse number="11" style="v" sid="JER 25:11" />Bogi duuchchi one duwwike kadaan; kunni gosa gosak arduwwinna torbaane tomme wogga Baabiloonike moyanji hunda galaan.<note caller="-" style="x"><char style="xo" closed="false">25:11 </char><char style="xt" closed="false"><ref loc="2CH 36:21">2 Odo. 36:21</ref>; <ref loc="JER 29:10">Erm. 29:10</ref>; <ref loc="DAN 9:2">Dan. 9:2</ref>. </char></note><verse eid="JER 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 25:12" />«Yaane tinni torbaane tomme wogga muuxendeechchi uduma, Baabiloonika moyanjonna isika arda, Baabiloonike mannika boga Baabiloonike mannixxe balleessaxxe'e xixannon,» hiyya'neen Duuchchi Woddik Gootti., «Baabloonika boganna duuchchi woddi'a onake assannon. <verse eid="JER 25:12" /><verse number="13" style="v" sid="JER 25:13" />Ani konne boga'n iyyedagonna'a haaso'ennexxa duuchcha, tinninna konne maxaafa'n borreessendeexxa Ermiyaasi gosa gosake arda duuchcha'n haaso'emmaxxa wabeekkumma konne bogake'n kaddaashsha assannon. <verse eid="JER 25:13" /><verse number="14" style="v" sid="JER 25:14" />Insa'ne'e umo insa'negenninni heddo gosa gosake arduwwi'anna lumollamma moyanjuwwi'a garba kandaan; huje insa'nexxishshanni hira insa'ne'a uwwannon.»<verse eid="JER 25:14" /></para>
  <para style="s1">Magen Gosa Gosake Arda Xixaaxxa</para>
  <para style="p">
    <verse number="15" style="v" sid="JER 25:15" />Duuchchi Woddiki Gootti Isira'eelik Magen anee'e hiyyeeqic: «Ank mufetik bulbul wo'meexxa buuda anxe anganaa'n aaxxe'e ani atee'e ergannoke gosa gosake ardiba'a marete insa'ne'n ha'wisi. <verse eid="JER 25:15" /><verse number="16" style="v" sid="JER 25:16" />Ha'winaawodda gatantarraan; bagedo insa'ne giddo ke'issannaxxeenna maraantaan.»<verse eid="JER 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 25:17" />Tennexxee tennee buuda Duuchchi Woddike Goottixxe angaa'n aadhennexxi isi ergemmake gosa gosake ardiba'a marennexxi ise'ne ha'winaashsha assenne. <verse eid="JER 25:17" /><verse number="18" style="v" sid="JER 25:18" />Iyyerusaaleminna Yihudak qachchuwwi, isik moyanjuwwinna isik ja'laabuwwi telcho kadeeshsha onakenna manjo diqachchiisaake gacifatemakenna badinemeeke kadaashsha <verse eid="JER 25:18" /><verse number="19" style="v" sid="JER 25:19" />Gibtseeka mayanjo, isika erganjuwwa, isika ja'laabuwwanna isika arda duuchcha, <verse eid="JER 25:19" /><verse number="20" style="v" sid="JER 25:20" />Ookko hedha'neeka anaffeeke bogika manna duuchcha, Tsoosike bogika moyanjuwwa duuchcha, Filisixeemike bogika moyanjuwwa duuchcha, Asiqeloonake qachchika, Gaazaka, Aqaroonikinna Ashidoodi giddo hafe gateek arda, <verse eid="JER 25:20" /><verse number="21" style="v" sid="JER 25:21" />Eedoomi, Mo'aabi, Amooni, <verse eid="JER 25:21" /><verse number="22" style="v" sid="JER 25:22" />Xiroosikanna Sidoonaka moyanjuwwa duuchcha, abbaayyati wido hedheeke bogi duuchchika moyanjuwwa, <verse eid="JER 25:22" /><verse number="23" style="v" sid="JER 25:23" />Dedaanika, Teemaaka, Buuzika, umo ifika qooxxo haaxaka arda duuchcha, <verse eid="JER 25:23" /><verse number="24" style="v" sid="JER 25:24" />Arabika moyanjuwwa duuchchinna, qiilla gammoojje giddo hedha'neeke mako ardika moyanjuwwa duuchcha, <verse eid="JER 25:24" /><verse number="25" style="v" sid="JER 25:25" />Zemirka Elaamikanna Meedoonika moyanjuwwa duuchcha, <verse eid="JER 25:25" /><verse number="26" style="v" sid="JER 25:26" />shiqikenna<note caller="+" style="f"><char style="fr" closed="false">25:26 </char><char style="ft" closed="false">Shiishaak Baabilonke wele summan</char></note> bayyike middika moyanjuwwa duuchcha lebe buttate'n hedheeka moyanjuwwa duuchcha buuda tenne giddii'n ha'wisse; konneer duuchchi uduma Shiishaakik moyanji ha'waan.<verse eid="JER 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 25:27" />«Okkonechi uduma insa'ne'n hite haasottattoqic, ‹Lumok Duuchchi Woddiki Gootti Isira'eelik Magen hiyya'neeqic: bagedo ha'no'n ergaannaxxee'e ha'we, machcho'we, honqo'we; kexxinabaaqico'ninna ibbe.› <verse eid="JER 25:27" /><verse number="28" style="v" sid="JER 25:28" />Yaane kinn insa'nee atixxe anganaa'ni buuda aa'neexxi ha'wa ginboole, ‹Lumok Duuchchi Woddik Gootti hiyya'neeqi: eetinebang ha'witinaan! <verse eid="JER 25:28" /><verse number="29" style="v" sid="JER 25:29" />Kunniseten summa ankenn ye'ema'neeke qachcha'n balleessa afeennaxxe'e ha'no xixebe'nok gattinaachcho labbee? Ani buttate'n hedheeke duuchchi hana bagedo ye'a'ennaxxe'e xixendinebaak gatinabaan, hiyya'neen Lumok Duuchchi Woddiki Gootti hiyyi.›<verse eid="JER 25:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 25:30" />«Koo Ermiyaas konnechchinni butti'a hedheeka hiyyicho duuchcha insa'ne'n raagaa raagge'e hitattoqic:</para>
  <para style="q1" vid="JER 25:30">« ‹Duuchchi Woddiki Gootti iima hedhe'e harqaan;</para>
  <para style="q2" vid="JER 25:30">woyyichcha ifike galdumanaa'ninna dindimaan;</para>
  <para style="q2" vid="JER 25:30">ifike boga'ininna jbaqqicinn dindimaan;</para>
  <para style="q1" vid="JER 25:30">Woyinetika bulbuloke miicammak mannikishsha</para>
  <para style="q2" vid="JER 25:30">buttate'n hedha'neeke duuchcha'n ifika jabaka hafuura laqisaan.<verse eid="JER 25:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 25:31" />Duuchchi Woddiki Gootti gosa gosake arda xixaaxxa yanna</para>
  <para style="q2" vid="JER 25:31">isike jabake hafuurik aadigalii buttatixxe gabalaqico'n laqisaan;</para>
  <para style="q1" vid="JER 25:31">Isi manjinke belto duuchcha'n muraan;</para>
  <para style="q2" vid="JER 25:31">fuggaaleyyetanna bagedokee uwwaan› hiyyi»</para>
  <para style="q2" vid="JER 25:31">hiyya'nen Duuchchi Woddik Gootti.<verse eid="JER 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 25:32" />Lumok Duuchchi Woddiki Gootti hiyya'neeqic,</para>
  <para style="q1" vid="JER 25:32">«Kunnise,</para>
  <para style="q2" vid="JER 25:32">ba'ne mitte gosake ardibaan mitte gosakiba'a saxxa'n daggeen;</para>
  <para style="q1" vid="JER 25:32">Jabaxxi hobonbalte</para>
  <para style="q2" vid="JER 25:32">buttatixxe gabalanaa'n kexxeen»<verse eid="JER 25:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="JER 25:33" />Eettenne yanna'n Duuchchi Woddik Gootti shiyeeke mannik renshi buttatike kasinaa'n buttatike kasiqico'n leellaan; koriinsha buttinake'n hunemaa malee, insa'ne'a oodhaak hedhebaan; rensha insa'nekinna bukki assemabaan, moogemabaan.<verse eid="JER 25:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="JER 25:34" />Ha'no allalisano, hiiqqissine oodhdhe;</para>
  <para style="q2" vid="JER 25:34">ha'no ardiink akeekisajuwwi bululoke'n gangalatte;</para>
  <para style="q1" vid="JER 25:34">Gorra'endinaaxxi barra geltemmaxxee</para>
  <para style="q2" vid="JER 25:34">waatinke fiixa miyishsha ibbine buttutinaan.<verse eid="JER 25:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 25:35" />Allalisano baajaabi,</para>
  <para style="q2" vid="JER 25:35">akeekisano ardinxi miliqqe fuldaaxxi bakka hexxabaan.<verse eid="JER 25:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 25:36" />Duuchchi Woddik Gootti insa'nexxa boba'inxa bakka balleessemmaxxe'e,</para>
  <para style="q2" vid="JER 25:36">allalisanotixxa oodhishsha,</para>
  <para style="q2" vid="JER 25:36">ardike akeekisanjixxa yiikkette laqqe.<verse eid="JER 25:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 25:37" />Duuchchi Woddike Goottixxe jabaxxe mufenaa'n kexxeexxa,</para>
  <para style="q2" vid="JER 25:37">naageelichchi insa'nek bogi onee gataan.<verse eid="JER 25:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 25:38" />Isi neenqinsha galamabaa'n fule'een;</para>
  <para style="q2" vid="JER 25:38">miicammake mannike bagedinaa'ninna,</para>
  <para style="q1" vid="JER 25:38">Isixxe jabaxxe mufenaa'n kexxeexxa,</para>
  <para style="q2" vid="JER 25:38">bogi insa'nek one gataan.<verse eid="JER 25:38" /></para>
  <chapter eid="JER 25" />
  <chapter number="26" style="c" sid="JER 26" />
  <para style="s1">Ermiyaasi Reyotee'e Ku'lemeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 26:1" />Yihudaki moyanj, Iyyosiyaasik belti Iyyo'aaqemi moyeexxe woggake ke'ito'n Duuchchi Woddike Goottik hiyyichchi dageexxi,<note caller="-" style="x"><char style="xo" closed="false">26:1 </char><char style="xt" closed="false"><ref loc="2KI 23:36-24:6">2 Moy. 23:36—24:6</ref>; <ref loc="2CH 36:5-7">2 Odo. 36:5-7</ref>. </char></note> <verse eid="JER 26:1" /><verse number="2" style="v" sid="JER 26:2" />anee'e «Duuchchi Woddike Goottike minnixxe baxxe'n uurritettexxi, magenooffatto'a Duuchchi Woddike Goottike miniba'a Yihudake qachchuwwanaa'n daga'neeke arda duuchcha'n haaso'i; mitte hiyyichcho giddii'n gatissebexxong ani atee'e ajajaannexxa duuchcha insa'ne'ni kuli. <verse eid="JER 26:2" /><verse number="3" style="v" sid="JER 26:3" />Akimagaada mitti mitting laqeexxi fuggoke ifike oranaa'n higaaxxe hexxeen; aninna assinemmaxxe fuggo'a insa'ne'n iyyedagonna'a hedennexxa ba'ne waalannon. <verse eid="JER 26:3" /><verse number="4" style="v" sid="JER 26:4" />Insa'nee hitattoqic, ‹Duuchchi Woddiki Gootti ani hiyyaannexxa laqa gibbinoolenna uwweennaka seera hordofa gophphinoole, <verse eid="JER 26:4" /><verse number="5" style="v" sid="JER 26:5" />ha'noba'a higgeggeenn ergennexxe anxe raagole erganjuwwika hiyyichcho laqa gibbinoole, <verse eid="JER 26:5" /><verse number="6" style="v" sid="JER 26:6" />konne mine Seelo assenneshsha assannon; konne qachchanna buttatike gosa gosake ardi duuchchi edo yowwemeeke assannon hiyyi› » hiyye.<note caller="-" style="x"><char style="xo" closed="false">26:6 </char><char style="xt" closed="false"><ref loc="JOS 18:1">Iya. 18:1</ref>; <ref loc="PSA 78:60">Far. 78:60</ref>; <ref loc="JER 7:12-14">Erm. 7:12-14</ref>. </char></note><verse eid="JER 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 26:7" />Qeese, wabeekkoletinna ardi duuchchi konne hiyyichcho Ermiyaasi Duuchchi Woddike Goottike min giddo haaso'aa wodda laqe. <verse eid="JER 26:7" /><verse number="8" style="v" sid="JER 26:8" />Yaane kinni Duuchchi Woddiki Gootti ardake'n haso'aashsha ajajemmaxxa duuchcha Ermiyaasi haaso'e bireeshshanni qeesole, wabeekkoletinna ardi duuchchi iso'o abideexxi, «Ati shiyendatton! <verse eid="JER 26:8" /><verse number="9" style="v" sid="JER 26:9" />Kunni mini Seeloshsha kadaan; kunni qachchinna giddo hedhaak gophemee'na'a one gataan hite'e raagaa Duuchchi Woddike Goottike summinn mayee'e raaggette?» hiyyeexxi ardi duuchchi Duuchchi Woddike Goottike mini giddo Eermiyaasike qarqara'n bukki hiyye.<verse eid="JER 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 26:10" />Yihudak ja'laabuwwi tenne'e kaddeexxa yaane duuchcha laqee wodda, mootomatike minenaa'n alalle Duuchchi Woddike Goottike miniba mareexxi, Haaroxxe hula hiyyendaaxxe Duuchchi Woddike Goottike minixxe hulaba ofo'le. <verse eid="JER 26:10" /><verse number="11" style="v" sid="JER 26:11" />Qeesoletinna wabeekko ja'laabuwwake'ninna arda duuchcha'n, «Mansha ha'noxxen laqqinemmashshanni kunni manjichchi konne qachcha'n wabeekkumma haaso'emmaxxe'e shiyemuun» hine.<verse eid="JER 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 26:12" />Okkonechinni udmi'a Ermiyaasi, ja'laabuwwake'inna arda duuchcha'n, «Hiyyaa'na'a laqqineexxa duuchcha Duuchchi Woddik Gootti konne mine'ninna konne qachcha'ni raaga raagonna'a anee'e ergeen. <verse eid="JER 26:12" /><verse number="13" style="v" sid="JER 26:13" />Ta'anna me'a ha'noxxanna huje ha'noxxa jijjiidhdhitineexxi, Duuchchi Woddike Gootta ha'noke Mageni'a ajajemme; Duuchchi Woddik Goottinna ha'no'n iyedago'a haaso'emmaxxa fuggoxxa yaane walaan. <verse eid="JER 26:13" /><verse number="14" style="v" sid="JER 26:14" />Ante kadonnole kinni kunnise anga ha'noxxe'n hedhennen, eloxxenna seerinxe hitinaaxxa duuchcha ane'n asse. <verse eid="JER 26:14" /><verse number="15" style="v" sid="JER 26:15" />Yaane kinni haaso'a'na'a laqqineeka konnee hiyyichcho duuchcha ha'no'n haaso'onna'a Duuchchi Woddik Gootti anee'e ergemmaxxe'e anee shiltine'e, balleessa afebaake manjixxa munde dunati ifi, konne qachchanna giddo hedheeka duuchcha balleessanjoke assitinabaashsha heqqedhdhe» hiyye.<verse eid="JER 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 26:16" />Ookkonechinni udumi'a ja'laabuwwikinna ardi duuchchi qeesoletenna wabeekko, «Kunni manjichchi Duuchchi Woddike Gootta no'oke Mageninke summinni no'o'n haaso'emmaxxe'e shiyemabaan» hiyye.<verse eid="JER 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 26:17" />Bogi giddo hexxemmaxxe geedhuwwanaa'n mitte mitte ke'eexxi bukki hiyye'eke manna duuchcha'n, <verse eid="JER 26:17" /><verse number="18" style="v" sid="JER 26:18" />«Moreesheetike qachchiki Mikiyaasi, Hiziqiyaasi Yihudake mowajo kade'emmake baro'n. Yihudake manni duuchcha'n, ‹Lumok Duuchchi Woddik Gootti hiyyee qici:</para>
  <para style="q1" vid="JER 26:18">« ‹Tsiyooni fichchishsha ko'insaan;</para>
  <para style="q2" vid="JER 26:18">Iyyerusaaleminna oletixxe tuulo kaddaan;</para>
  <para style="q2" vid="JER 26:18">galmi hedhemmaxxe kooba'inna, badda'a daggaldaan kadaan.›<note caller="-" style="x"><char style="xo" closed="false">26:18 </char><char style="xt" closed="false"><ref loc="MIC 3:12">Mik. 3:12</ref>. </char></note><verse eid="JER 26:18" /></para>
  <para style="b" />
  <para style="m">
    <verse number="19" style="v" sid="JER 26:19" />«Moyanji Yihudaki Hiziqiaasinna Yihudak ardi duuchchi, Mikiyaasi'i shine'eemmata'a? Hiziqiyaasi Duuchchi Woddika Gootta sodaatiyyoti gattowwaal hiyyo'a kadhate'emmabaata? Duuchchi woddiki Gottinna kinni insa'ne'n iyyedago'a hede'emmaxxa ba'ne waalebaata? No'oqqa, no'oxxe anganninni jabaxxa ba'ne ifi'ni iyyedaqqinonna'aate!»<verse eid="JER 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 26:20" />Okkone baro'n Qiriyatiyi'aarimike bogik manji Shemayaak belti Uuriya Duuchchi Woddike Goottike summinni konne qachcha'inna konne boga'n Ermiyaasishshanni wabeekkumma haaso'eemman. <verse eid="JER 26:20" /><verse number="21" style="v" sid="JER 26:21" />Moyanji Iyyo'aaqemi, isika lolinka manna ajajammakirinna isik jalqaabuwwi duuchchi Ooriyo hiyyeexxa lanqee wodda, moyanji Uuriya shiyemo'a hede; Ooriyonna tenne laqee wodda alayyeexxi Gibtse'a baaje. <verse eid="JER 26:21" /><verse number="22" style="v" sid="JER 26:22" />Kaddo malee moyanji Iyyo'aaqemi Akiboorika belto Elinataanii'i wele manninn welti Gibtsee'a erge: <verse eid="JER 26:22" /><verse number="23" style="v" sid="JER 26:23" />Insa'ne'nna Uuriya'a Gibtsee'n aa'ne dangeexxi, moyanjo Iyyo'aaqemiba iyyemarre; moyanjikinna wolaantichik isoo shiyeexxi rensha isikanna tuffatemeek manni moogemaake hirreesi booncho'n hunsiisse.<verse eid="JER 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 26:24" />Yaane kinn Saafaanik belti Ahiqaami, Ermiyaasi'a baassemmaxxe'e, Ermiyaasi shiyemo'a ardiinxe anga'n sa'isseme uwwemeba'a.<verse eid="JER 26:24" /></para>
  <chapter eid="JER 26" />
  <chapter number="27" style="c" sid="JER 27" />
  <para style="s1">Ermiyaasi Qanbara Ba'edhe</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 27:1" />Yihudaki moyanji, Iyyosiyaasik belti Sedeqiyaasi moyeeke barike ke'ito'n Duuchchi Woddik Goottik kunni hiyyichchi ane'e Ermiyaasiba'a dageexxi,<note caller="-" style="x"><char style="xo" closed="false">27:1 </char><char style="xt" closed="false"><ref loc="2KI 24:18-20">2 Moy. 24:18-20</ref>; <ref loc="2CH 36:11-13">2 Odo. 36:11-13</ref>. </char></note> <verse eid="JER 27:1" /><verse number="2" style="v" sid="JER 27:2" />Duuchchi Woddik Gootti anee'e hiyyeeqic: «Haqichchinka qanbara giissite'e goginke fannisanjo'ni abidisse'e gooba atike'n usudhdhi. <verse eid="JER 27:2" /><verse number="3" style="v" sid="JER 27:3" />Sedeqiyaasi'i Yihudake moyanjiba, Iyyerusaalemi dagemmake manna'n Eedoomike, Mo'aabike, Amoonike, Xiroosikenna Sidoonake moyanjuwwa'n erga sa'issi. <verse eid="JER 27:3" /><verse number="4" style="v" sid="JER 27:4" />Tenne erga insa'ne ifi ifike goottuwwa'ni kullaashsha Dada duuchcha ajajaake Duuchchi Woddiki Gootti Isira'eelik Magen hiyya'neeqic: «Ha'noke goottu'wa'n, <verse eid="JER 27:4" /><verse number="5" style="v" sid="JER 27:5" />Ani Lumoxxe anxe hunnaninna jabbaxxe anxe hirrenni buttatanna ise giddo hedhaaka arda hore biniincha dadeennen; butta anee gamachchiiseekee uwwannon. <verse eid="JER 27:5" /><verse number="6" style="v" sid="JER 27:6" />Ta'anna konne boguwwa duuchcha erganjo anke Baabiloonike moyanjo Naabukedentsoori'a uwwannon; biniinchuwwi midde gatebaang isi'a hiremaashsha assannon. <verse eid="JER 27:6" /><verse number="7" style="v" sid="JER 27:7" />Isika boga wel gosa gosak moyanjuwwi dage galchaa qico'n gosa gosak arduwwi duuchchi isi'a, isike belti'anna isike beltinke belti'a hiremaan; ookkoneechchi udumi'a heddo gosa gosak arduwwinna jajjabbi moyanjuwwi isoo galchaan.<verse eid="JER 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 27:8" />« ‹ «Yaane kinni Naabukedentsoorii Baabiloonike moyanji hunda galabaaka, umo ifika heeshshi asse'e isika qanbara ba'edhabaaka gosa gosaka arda isi anga ifixxenni balleessaashsha assannoqico'n insa'nee'e wolaantichchik, solo'okinna bala ibisee'e xixannon hiyya'neen Duuchchi Woddik Gootti. <verse eid="JER 27:8" /><verse number="9" style="v" sid="JER 27:9" />Tennexxee ‹Baabiloonik moyanji'a ergatendinabaashsha hoyyitaaxxa ha'noxxe wabeeko, ha'noxxe moraameyyeka, ha'noxxe oojjoleyyeka, hanoke ekedha yaansassammake mannikanna ha'noxxe gojaaleyyeka haaso'a laqqinoqqe'e. <verse eid="JER 27:9" /><verse number="10" style="v" sid="JER 27:10" />Insa'ne ha'no boga ha'nokee'n fuldinaashshanna ani ha'noo balleessannoshsha dhariinka raaga ha'no'n raangaan. <verse eid="JER 27:10" /><verse number="11" style="v" sid="JER 27:11" />Yaane kinni Baabiloonike moyanjiinke qanbar hunda ifi heeshshi asseexxi isi'a ergatemaaka hooninna gosa gosaka ardi ifike boga'n galeexxi hucca'n hedhaashsha assannon hiyya'neen Duuchchi Woddik Gootti.» › »<verse eid="JER 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 27:12" />Aninna tenneenni erga Sedeeqiyaasi'i Yihudake moyanjo'n hiyye kulenneqic, «Umo ha'noka Baabiloonike moyanji qanbar hunda heeshshi assitine'e isi'anna isike ardi'a ergatemme; hedhoti hexxinaan. <verse eid="JER 27:12" /><verse number="13" style="v" sid="JER 27:13" />Atinna ardi atik Duuchchi Woddik Gootti Baabiloonike moyanjiinke qanbar hunda heeshshi hiyye ergatemabaaka arda xexxe'achchiisemmake wolaantichinni, solo'ikinna balati mayee muddina? <verse eid="JER 27:13" /><verse number="14" style="v" sid="JER 27:14" />Dharichcha raaga ha'no'n raangaammaxxee, ‹Baabiloonike moyanji'a ergatendinoqqe'e› hitaaka wabeekotika hiyyichcho laqqinoqqe'e. <verse eid="JER 27:14" /><verse number="15" style="v" sid="JER 27:15" />‹Ani insa'ne'e ergebe'non› hiyya'neen Duuchchi Woddik Gootti, ‹Insa'ne dhariink raaga anke summinn raangemmaxxe ani ha'noonna ha'no'a raaga raaggemmaxxa wabeekko bogii'n fulchannon; ha'nonna baxxinaan.› »<verse eid="JER 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 27:16" />Ookkonechchi uduma ani qeesolete'ninna konne arda duuchcha'n, «Duuchchi Woddiki Gootti hiyya'neeqic: Dharik Duuchchi Woddike Goottike minik mi'i, ‹Baabilooninaa'n rakke illeema hissemaan› hitaaxxe wabeekkotike hiyyichcho kademmaxxe'e laqqinoqqe. <verse eid="JER 27:16" /><verse number="17" style="v" sid="JER 27:17" />Tennexxee insa'ne hinaaxxa laqawaaldineexxi Baabiloonike moyanji'a ergatendine'e lubbo galle; ajajema gophphinee'na'a kunni qachchi mayee oletixxe tuulo kadaa? <verse eid="JER 27:17" /><verse number="18" style="v" sid="JER 27:18" />Insa'ne dhugaatixxe wabeekko kandoolenna Duuchchi Woddik Goottik hiyyichchi insa'ne'ni hedhoole Duuchchi Woddike Goottike mine'n Yihudake moyanjiinke moyetike mine'ninna Iyyerusaalemi gate'eeke mi'uwi Baabilooni'a boji'emabaashsha Lumoke Duuchchi Woddike Goottiba'a soodantaqqata! <verse eid="JER 27:18" /><verse number="19-20" style="v" sid="JER 27:19-20" />Baabilooniki moyanji Naabukedentsoori Yihudaka moyanjo Iyyo'aaqemika belto Ikkooniyaani'i, Yihudakenna Iyyerusaalemike ja'laabuwwin welti booji'e'e Baabilooni'a adhdhe me'ee wodda, utuphuwwa, sageettotike sibiljinn giissemeeka wodinga goginga, moletixxe lekkaka ofo'lisanjuwwanna wele mi'uwwa aadhebaang waalee'na'a Iyyerusaalemike qachchake'n gate'emmake mi'uwwa kadeemmaxxee, <verse eid="JER 27:19-20" /><verse number="21" style="v" sid="JER 27:21" />Konne Duuchchi Woddike Goottike mine'n, Yihudiinke moyanjike mootomatike mine'ninna Iyyerusaalemi gate'eemmake mi'uwwixxee, Lumok Isira'eelik Duuchchi Woddiki Gootti hiyya'neeqic, <verse eid="JER 27:21" /><verse number="22" style="v" sid="JER 27:22" />‹Kunni mi'uwwi Baabilooni'a booji'eme adhdhemaan; ani iso'o illeema hissannoxxi barra geltaqico'ninna ookkonn hedhaan› hiyya'neen Duuchchi Woddik Gootti. ‹Ookkonechi uduma ani konne mi'uwwa haaroba hedhemmaxxe bakka'n hissannon.› »<verse eid="JER 27:22" /></para>
  <chapter eid="JER 27" />
  <chapter number="28" style="c" sid="JER 28" />
  <para style="s1">Ermiyaasinna Wabeekkichcho Hanaaniya'a</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 28:1" />Eettene wogga'ninni Yihudiink moyanji Sedeeqiyaasi moweeshshanni sholgaxxe woggake, ondeessoke agenjo'n Gaba'oonik qachchik manji, Azuuriki belti wabeekkichchi Hanaaniya Duuchchi Woddike Goottike mine'n qeesoleti edonna ardi duuchchi edo,<note caller="-" style="x"><char style="xo" closed="false">28:1 </char><char style="xt" closed="false"><ref loc="2KI 24:18-20">2 Moy. 24:18-20</ref>; <ref loc="2CH 36:11-13">2 Odo. 36:11-13</ref>. </char></note> <verse eid="JER 28:1" /><verse number="2" style="v" sid="JER 28:2" />«Lumok Duuchchi Woddiki Gootti Isira'eelik Magen hiyyeen hiyye'e anee Ermiyaasi'n haaso'eeqic, ‹Baabiloonik moyanji ha'no'n fe'eeka qanbara enqannon; <verse eid="JER 28:2" /><verse number="3" style="v" sid="JER 28:3" />Baabilooniki moyanji Naabukedentsoori Duuchchi Woddike Minenaa'n Baabilooni'a adhdhe me'emmaka mi'uwwa duuchcha lame wogga giddo illeema hisse iyyedagannon. <verse eid="JER 28:3" /><verse number="4" style="v" sid="JER 28:4" />Yihudiinka moyanjonna Iyyo'aaqemika belto Ikkooniyaani'i, wele Yihudii'n Baabilooni'a booji'eme adhdhememmaka duuchcha konne boonchiba'a illeema hissannon; Baabiloonik moyanji ha'non fe'emmaka qanbaranna enqannon› hiyya'neen» hiyye. <verse eid="JER 28:4" /><verse number="5" style="v" sid="JER 28:5" />Aninna qeesoleti eddonna Duuchchi Woddike Goottike miniba uurredheeke ardi duuchchi edo, wabeekkichcho Hanaaniya'n hiyye hissichcho uwweenne qici. <verse eid="JER 28:5" /><verse number="6" style="v" sid="JER 28:6" />«Ameen! Duuchchi Woddiki Gootti ati hitetteshshanni assowwaal! Booji'ememmaka Duuchchi Woddike Goottike minika mi'uwwa duuchchanna, booji'ememmaka manna duuchcha Baabilooninaa'n illeema hissiyyoti haasottetteka hiyyichcho muuxowwaalita'a. <verse eid="JER 28:6" /><verse number="7" style="v" sid="JER 28:7" />Kaddomale ate'inna konne arda'n hiyyaannexxa laqi: <verse eid="JER 28:7" /><verse number="8" style="v" sid="JER 28:8" />Olominaa'n ati'anna ani'a edisaaxxi wabeekko, heddo boguwa'ninna lumolluwwa mootummuwwa'n bagedinxee, ba'netixxeenna, balatixxee wabeekkumma haassotteemman. <verse eid="JER 28:8" /><verse number="9" style="v" sid="JER 28:9" />Yaane kinni nage'iinxee wabeekkumma haaso'eek wabeekkichchi dhugaati Duuchchi Woddiki Gootti ergeeke kadeexxa ege'nendaak haaso'emmaxxi wabeekkumma dhugottooleten.»<verse eid="JER 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 28:10" />Ookkonechinni udumi'a wabeekkichchi Hanaaniya qanbara wabeekkichcho Ermiyaasixxe qucenaa'n aadhe enqeexxi, <verse eid="JER 28:10" /><verse number="11" style="v" sid="JER 28:11" />ardi duuchchi edo, «Duuchchi Woddik Gootti hiyya'neeqic: ‹Lame woggaxxe yanna giddo Naabukedentsoorii Baabiloonike moyanjika qanbara ardi duuchchixxe qucenaa'n iittan enqannon› » ookkone wodda wabeekkichchi Ermiyaasi ookkkoo'n ke'eexxi ora ifika me'e.<verse eid="JER 28:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 28:12" />Wabeekkichchi Hanaaniya wabeekkichcho Erimyaasixxe qucenaa'n qanbara aadhe enqeexxe harumaxxe yanna uduma, Duuchchi Woddike Goottik hiyyichchi Ermiyaasiba'a dageexxi: <verse eid="JER 28:12" /><verse number="13" style="v" sid="JER 28:13" />«Martettexxi Hanaaniya'n Duuchchi Woddik Gootti hiyya'nee hitattoqic, ‹Ati haqichchinke qanbara enqiteetten; ani kinni isixxa bakka sibiljiinke qanbara hissannon hiyye'een. <verse eid="JER 28:13" /><verse number="14" style="v" sid="JER 28:14" />Lumok Duuchchi Woddik Gootti Isira'eeliki Magen hiyya'neeqic: Baabiloonika moyanjo Naabukedentsoori'a ergatemo'a konne gosa gosake arda duuchcha'n sibiljinka qanbara fe'e'naa'a isi'a ergatemaan; biniinchikinna midde isi'a hiremaashsha assannon.› »<verse eid="JER 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 28:15" />Ookkonechchi udumi'a wabeekkichchi Ermiyaasi wabeekkichcho Hanaaniya'n hiyyeeqic, «Koo, Hanaaniyan laqi! Duuchchi Woddiki Gootti atee'e ergebaang kunni gosa gosak ardi dhara addataashsha assiteetten. <verse eid="JER 28:15" /><verse number="16" style="v" sid="JER 28:16" />Tenne'e Duuchchi Woddik Gootti: ‹Atee'e buttatenaa'n fugusannon; Duuchchi Woddike Gootta'n ardi jallataashsha assitettexxee'e tenne wogga'ninni rertatton.› »<verse eid="JER 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 28:17" />Wabeekkichchi Hanaaniyaninna eettene woggake torbeessoke agenjo'ninni reye.<verse eid="JER 28:17" /></para>
  <chapter eid="JER 28" />
  <chapter number="29" style="c" sid="JER 29" />
  <para style="s1">Booji'ote'ni Heedheeke Manni'a Ergendeexxa Borro</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 29:1" />Wabeekkichchi Ermiyaasi booji'ende adhdhende lubboti hexxeexxe geedhe'a, qeesete, wabeekkoteenna Naabukedentsoori Iyyerusaalemii'ni Baabilooni'a booji'e adhdhemmake ardi duuchchi'a borreesse ergeexxe ergak hiyyichchi konnechinn butti'a hedheeken; <verse eid="JER 29:1" /><verse number="2" style="v" sid="JER 29:2" />Tenne borronna borreesseek moyanji Ikkooniyaani, mootitte isixxi amanna isike mootomatike minik ja'laabuwwi, Yihudakinna Iyyerusaalemik akeekisanjuwwi, haqqetixxe ogekinna sibilo tumammak manni booji'eme Iyyerusaalemii'n adhdhemeechchi udumatemman.<note caller="-" style="x"><char style="xo" closed="false">29:2 </char><char style="xt" closed="false"><ref loc="2KI 24:12-16">2 Moy. 24:12-16</ref>; <ref loc="2CH 36:10">2 Odo. 36:10</ref>. </char></note> <verse eid="JER 29:2" /><verse number="3" style="v" sid="JER 29:3" />Isinna tenne borro Yihudak moyanji Sedeeqiyaasi Baabiloonika moyanjo Nabukedentsooriba'a ergeemmake erganjuwwa'n, Saafaanika belto Eli'aasa'ninna Hilqiyaaka belto Gemaariya'n erge; borrotinna hitaammaqic,<verse eid="JER 29:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="JER 29:4" />Lumok Duuchchi Woddik Gootti Isira'eelik Magen Iyyerusaaleminaa'n Baabilooni'a booji'emmaashsha assemmake duuchcha hiyya'neeqic, <verse eid="JER 29:4" /><verse number="5" style="v" sid="JER 29:5" />«Mine ijaadhdhitine hedhdhe; hiddichchuwwakanna kaalsitine gummatanna itte; <verse eid="JER 29:5" /><verse number="6" style="v" sid="JER 29:6" />Aaxxine labbaxxanna meyyaxxa oose i'le; labbaxxanna meyyaxxa ha'noxxa oose aadhisine heerunsisse; insa'nenna labbaxxa meyyaxxa oose i'linowwaal; laakkossi ha'nok ookkone boga'n birasa'o'o malee'e heeno'moqqe'e. <verse eid="JER 29:6" /><verse number="7" style="v" sid="JER 29:7" />Booji'enidene ookko'a me'itino'a assennake qachchi'a nage'akanna dananumma halche; iikk qachchi danana'oole ha'nonna danane hexxinammaxxe'e, isixxee Duuchchi Woddike Goottiba'a soodatte» hiyye. <verse eid="JER 29:7" /><verse number="8" style="v" sid="JER 29:8" />Eet, Lumok Duuchchi Woddiki Gootti Isira'eelik Magen «Ha'no giddo hexxeexxi wabeekkonna moralluwwi ha'noo dedhisoqqe'e; insa'ne ha'no'a oojjontaaxxa oojjonna caqassinnoqqe'e. <verse eid="JER 29:8" /><verse number="9" style="v" sid="JER 29:9" />Insa'ne summa anken dharik raaga raanga'nee malee'e ani Duuchchi Woddiki Gootti insa'ne erge'ebe'non» hiyye. <verse eid="JER 29:9" /><verse number="10" style="v" sid="JER 29:10" />Duuchchi Woddiki Gootti hiyya'neeqic, «Baabilooni hexxinaaxxi torbaane tomme woga muddeechchi uduma ani ha'noo uudannon ha'no'o konne boonchiba illeema hiissonna'a addachchiisenneka anka eloka hiyyichcho ha'no'a muuxannon.<note caller="-" style="x"><char style="xo" closed="false">29:10 </char><char style="xt" closed="false"><ref loc="2CH 36:21">2 Odo. 36:21</ref>; <ref loc="JER 25:11">Erm. 25:11</ref>; <ref loc="DAN 9:2">Dan. 9:2</ref>. </char></note> <verse eid="JER 29:10" /><verse number="11" style="v" sid="JER 29:11" />Ha'no'a afeenneka yaada anende age'nenen; kunni yaadinna hegere ha'no'a eldaashsha addachisaake yaada malee'e ha'no'o midhakebaan; <verse eid="JER 29:11" /><verse number="12" style="v" sid="JER 29:12" />ha'nonna anee'e ye'exxinaan; shiqqinenna aniba'a soodattinaan; aninna soodachcho ha'noxxa laqannon. <verse eid="JER 29:12" /><verse number="13" style="v" sid="JER 29:13" />Ha'no anee'e halsitinaan; mitte godobinni anee'e halsitinoole anee'e alfitinaan.<note caller="-" style="x"><char style="xo" closed="false">29:13 </char><char style="xt" closed="false"><ref loc="LEV 4:29">Lew. 4:29</ref>. </char></note> <verse eid="JER 29:13" /><verse number="14" style="v" sid="JER 29:14" />Aninna ha'no'a afemanno, ani Duuchchi Woddik Gootti booji'otenaa'n ha'no hissanno; ha'noo xexeerennake bogiba'ninna booncho duuchchinaa'n ha'no'o hiissannon; booji'endine fuldinaashsha assennake bogiba'a ha'no'o hissannon, ani Duuchchi Woddik Gootti tenne haaso'ennen» hiyye. <verse eid="JER 29:14" /><verse number="15" style="v" sid="JER 29:15" />Ha'no «Duuchchi Woddiki Gootti Baabiloon giddo wabeekko no'o'a uwwe'een» hitinaan. <verse eid="JER 29:15" /><verse number="16" style="v" sid="JER 29:16" />Duuchchi Woddik Gootti kinni Daawwitixxe moote'n ofo'laake mowajixxeenna ha'no welti booje'emebaak gatemmake konne qachchi giddike ha'noke ardi duuchchixxee hiyyaannexxa laqqe. <verse eid="JER 29:16" /><verse number="17" style="v" sid="JER 29:17" />Lumok Duuchchi Woddiki Gootti hiyya'neeqic: «Kunniseten ani insa'ne'n bagedo, solo'okanna bala ibisennexxi insa'ne'ee itatee'e eldabaaxxe elobaaxxe balasexxe gummashsha assannon. <verse eid="JER 29:17" /><verse number="18" style="v" sid="JER 29:18" />Ani insa'ne'e bagedik solo'ikinna balati shorrannon; buttatixxe mootumma duudchchi edo manjo jibbisiinsaake assannon; giddi'a xexxeerannoke arduwwi duuchchi edo badineme'eke, majani hinaaxxi yaane insa'ne'n geltaake, osso'lemeekenna gaccifatemaake assannon. <verse eid="JER 29:18" /><verse number="19" style="v" sid="JER 29:19" />Insa'ne'e ani erganjuwwa anxe wabeekko darree'n higgeggeen ergenneka anka hiyyichcho laqa ginbemmaxxee tinni insa'ne'n gelte'een» hiyya'neen Duuchchi Woddik Gootti, «Ha'no boji'endineek manninna ani hiyyennexxa laqinebaan,» hiyya'ne Duuchchi Woddik Gootti. <verse eid="JER 29:19" /><verse number="20" style="v" sid="JER 29:20" />Tennexxee koo Iyyerusaaleminaa'n Baabilooni'a booji'enedinaashsha assenneke manna Duuchchi Woddike Goottika hiyyichcho laqqe. <verse eid="JER 29:20" /><verse number="21" style="v" sid="JER 29:21" />Dada Duuchcha ajajaaki Duuchchi Woddik Gootti Isira'eelik Magen anik summinni dharik raaga raanga'neeke, Aki'aabika belto Qolayaxxeenna Ma'iseyaaka belto Sedeeqiyaasixxee hiyya'nee qici, «Ani insa'ne'e Naabukadanatsoori'i Baabiloonike moyanjiinxe anga'n s'aisse uwwannon; isinna ille ha'noxxi uudda'naa'n insa'nee shiyaan. <verse eid="JER 29:21" /><verse number="22" style="v" sid="JER 29:22" />Insa'ne'n gelteexxe yaanenaa'n kexxeexxa Baabiloon booji'eme hedheek Yihudak manni duuchchi weli yowwaa wodda, ‹Duuchchi Woddiki Gootti, atee'e Baabiloonik moyanji giirate'n gubemmake Sedeeqiyaasishanna Aki'aabishsha atee gubo'o› hiyyaan. <verse eid="JER 29:22" /><verse number="23" style="v" sid="JER 29:23" />Insa'ne'e wele mannixxe arenn welti yabaabulatinna ani haaso'ebe'noxxa anke summinni dhara haaso'iyyoti Isira'eeli giddo salphitte yaane assine'een; Tennee ege'neennen; ani dhugaa kulannoken» hiyye Duuchchi Woddik Gootti.<verse eid="JER 29:23" /></para>
  <para style="s1">Shamiyaba'a Ergendeexxa Erga</para>
  <para style="p">
    <verse number="24" style="v" sid="JER 29:24" />Nehelaamike bogike manjo'n, Shemaya'n hite kuldattoqic, <verse eid="JER 29:24" /><verse number="25" style="v" sid="JER 29:25" />«Dada Duuchcha ajajaaki Duuchchi Woddik Gootti Isira'eelik Magen Iyyerusaalemi hedheeke arda duuchcha'n, qeesichcho Ma'iseyaake belto Sofooniyaasi'ninna wele qeesole duuchcha'n atike summi borruwwa ergiteettexxi Sofoniyaasi'i hite'eteqic, <verse eid="JER 29:25" /><verse number="26" style="v" sid="JER 29:26" />‹Duuchchi Woddike Goottike mine'ni sooressa kaddotta'a Duuchchi Woddik Gootti qeesichcho Yoodaahexxe bakka'n atee'e qeesichchoke asse hariire'dheen; ani wabeekkichchoken hiyya'n wabeeekkumma haaso'a'neeka, mitte mitte maraateeka manna lekka jirmake'n, goobakanna haachchabik ati usuriyyo hassissaan. <verse eid="JER 29:26" /><verse number="27" style="v" sid="JER 29:27" />Mayeeta wabeekkichchinsha haaso'a'neeka Anaattotike bogika manjo, Ermiyaasi'i xixa gophphette? <verse eid="JER 29:27" /><verse number="28" style="v" sid="JER 29:28" />Kunni manji, Ha'noxxi booji'otixxi yaane qeerraxxe kaddemmaxxee mine ijaadhdhitine ofo'le; hiddichuwakanna kaalsitine'e gumma itte hiyyeexxi Baabilooni'a erga no'o'n erge'een› » hite'etten. <verse eid="JER 29:28" /><verse number="29" style="v" sid="JER 29:29" />Qeesichchi Sofooniyaasinna tenne borro anne'e, Ermiyaasi'a haasesse. <verse eid="JER 29:29" /><verse number="30" style="v" sid="JER 29:30" />Ookkonechchi uduma Duuchchi Woddike Goottik hiyyichchi ane'n dageexxi hiyyee qici, <verse eid="JER 29:30" /><verse number="31" style="v" sid="JER 29:31" />«Tenne erga booji'eme hedheeke duuchcha'n hite ergitatto qic, ‹Nehelaamixxe'e, Shemayaxxe'e, ani Duuchchi Woddik Gootti ergebe'nong Shemaaya wabeekkumma ha'no'n haaso'eexxi dhara addattinaashsha assemmaxxee, <verse eid="JER 29:31" /><verse number="32" style="v" sid="JER 29:32" />ani Duuchchi Woddiki Gootti Nehelaamichcho Shemayanna horte isixxa xixannon; isi ardi ane'n jallo haaso'aashsha assemmaxxee manji isik konne ardi giddo lubbo gateexxi ani anke ardi'a assannoxxa eloxxa yaane uudaaki mittikinna hedhabaan Ani Duuchchi Woddik Gootti tenne'e haaso'ennen› » hiyye.<verse eid="JER 29:32" /></para>
  <chapter eid="JER 29" />
  <chapter number="30" style="c" sid="JER 30" />
  <para style="s1">Duuchchi Woddik Gootti Arda Ifikee Uwweexxa Addachchiisa</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 30:1" />Duuchchi Woddike Goottik hiyyichchi Ermiyaasiba'a dageexxi: <verse eid="JER 30:1" /><verse number="2" style="v" sid="JER 30:2" />«Duuchchi Woddiki Gootti Isira'eeliki Magen hiyyeeqic: ‹Ate'n haaso'enneka hiyyichcho duuchcha Maxaafake'n borreessi. <verse eid="JER 30:2" /><verse number="3" style="v" sid="JER 30:3" />Kunniseten arda anka Isira'eeli'anna Yihuda'a› hiyya'neen Duuchchi Woddik Gootti, ‹annuwa insa'neke uwwennake bogiba'a insa'ne illeema hissannoxxi yanna shiqe'een insa'nenna boga ookkone'e dhaallaan› hiyya'neen Duuchchi woddik Gootti.»<verse eid="JER 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 30:4" />Duuchchi Woddiki Gootti Isira'eelikenna Yihudake ardixxee haaso'a'n: <verse eid="JER 30:4" /><verse number="5" style="v" sid="JER 30:5" />«Duuchchi Woddik Gootti hiyyee qici:</para>
  <para style="q1" vid="JER 30:5">« ‹Sodda'atikinna weekenshati hafuur laqeme'een;</para>
  <para style="q2" vid="JER 30:5">nage'ikinna hedhebaan.<verse eid="JER 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 30:6" />Amme hubattine uudde;</para>
  <para style="q2" vid="JER 30:6">isi labbaki ilaata?</para>
  <para style="q1" vid="JER 30:6">Mayeeteta labballi duuchchi ciniffatteexxe manjichoshsha</para>
  <para style="q2" vid="JER 30:6">anga hidhake'n uggudhdhe'e,</para>
  <para style="q2" vid="JER 30:6">alba xilledheena'a uuda'ennek?<verse eid="JER 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 30:7" />Aanne'e! Itti barra hittata sodaachchissaaxxe!</para>
  <para style="q2" vid="JER 30:7">Iitta hexxeenxi barra hexxabaan;</para>
  <para style="q1" vid="JER 30:7">Ise Ya'iqoobixxe horte'a rakkotixxe yanna kaddaan;</para>
  <para style="q2" vid="JER 30:7">yaane kinni insa'ne anjiremaan.»<verse eid="JER 30:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JER 30:8" />« ‹Eettene barra› dada duuchchik Duuchchi Woddiki Gootti hiyya'nee qici,</para>
  <para style="q2" vid="JER 30:8">‹Ani eettene barra insa'nexxe quce'naa'n qanbara enqannon;</para>
  <para style="q1" vid="JER 30:8">Usurakena'ninna insa'ne tikannon;</para>
  <para style="q2" vid="JER 30:8">konneechchini edi'a alagi insa'nee garbumma galchabaan.<verse eid="JER 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 30:9" />Yaane kinni insa'ne Duuchchi Woddike Gootta ifike Mageni'anna</para>
  <para style="q2" vid="JER 30:9">ani insa'ne'n mo'waashsha assannoke</para>
  <para style="q2" vid="JER 30:9">Daawwiti'i ifike moyanji'a hiremaan.<verse eid="JER 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 30:10" />« ‹Tennexxxee koo anke erganjo Ya'iqoobi sodaattoxxe'e;</para>
  <para style="q2" vid="JER 30:10">koo Isra'elike arda mee alayyi!›</para>
  <para style="q2" vid="JER 30:10">hiyya'neen Duuchchi Woddik Gootti.</para>
  <para style="q1" vid="JER 30:10">‹Ani ha'no'o bayyike boginaa'n,</para>
  <para style="q2" vid="JER 30:10">horte ha'noxxanna booji'endeeke bogibaa'n hissannon;</para>
  <para style="q1" vid="JER 30:10">Yaa'iqobixxi horte haaroba nage'iki ti'ni hitee'e ofoldaan,</para>
  <para style="q2" vid="JER 30:10">insa'nee'e allalshaakinna hedhabaan.<verse eid="JER 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 30:11" />Ani ha'nonni hedhee ha'no'o anjirannon,›</para>
  <para style="q2" vid="JER 30:11">hiyya'neen Duuchchi Woddik Gootti.</para>
  <para style="q1" vid="JER 30:11">‹Ha'no gosa gosaka ardi giddo xeereennan;</para>
  <para style="q2" vid="JER 30:11">ookkone gosa gosaka arda bakka isixxa balleessannon;</para>
  <para style="q2" vid="JER 30:11">ha'no kinni bakka ha'noxxa balleessabe'non;</para>
  <para style="q1" vid="JER 30:11">Seerinke xixichcho ha'no'o xixanno malee'e</para>
  <para style="q2" vid="JER 30:11">xixichchi belo ha'no'o waalabe'non.›<verse eid="JER 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 30:12" />«Duuchchi Woddiki Gootti hiyya'neeqic:</para>
  <para style="q1" vid="JER 30:12">« ‹Mada ha'noxxi fayyitabaaxxe,</para>
  <para style="q2" vid="JER 30:12">miidhensha ha'noxxinna jabaxxen.<verse eid="JER 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 30:13" />Ha'no'a haaso'aak hedhebaan;</para>
  <para style="q2" vid="JER 30:13">mada ha'noxxenna qorsi afemebaan;</para>
  <para style="q2" vid="JER 30:13">ha'nonna fayyitinabaan.<verse eid="JER 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 30:14" />Jaaluwwi ha'nok duuchchi ha'no dedhe'een;</para>
  <para style="q2" vid="JER 30:14">habanna gattinee hiyyabaan;</para>
  <para style="q1" vid="JER 30:14">Balleessa ha'noxxi lumooxxe kaddemmaxxeenna</para>
  <para style="q2" vid="JER 30:14">cubbo ha'nooxxi bira saxxemmaxxe'e,</para>
  <para style="q1" vid="JER 30:14">Naapha gannammashsha ani ha'noo ganeennen;</para>
  <para style="q2" vid="JER 30:14">mararte belonna ha'noo'o xixenne.<verse eid="JER 30:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 30:15" />Fayyitabaaxxe ha'nooxxe dhibo'a,</para>
  <para style="q2" vid="JER 30:15">mada ha'nooxxee meyeee raartina?</para>
  <para style="q1" vid="JER 30:15">Balleessa ha'nooxxi lumooxxen,</para>
  <para style="q2" vid="JER 30:15">cubbo ha'nooxxinna birasaxxeemmaxxe'e iitta ha'noo xixeennen.<verse eid="JER 30:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JER 30:16" />« ‹Yaane kinni ha'noo itemmakir duuchchi insa'nenna iittanni itemmaan;</para>
  <para style="q2" vid="JER 30:16">naaphuwwi ha'nooki duuchchi booji'eme adhdhemaan;</para>
  <para style="q1" vid="JER 30:16">Ha'noo saamammakir saamemaan;</para>
  <para style="q2" vid="JER 30:16">ha'noo mulqedhemmak miicama duuchchinna mulqemaan.<verse eid="JER 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 30:17" />Ha'nook naaphi hunendeexxe,</para>
  <para style="q2" vid="JER 30:17">ayyinna isee'e qaabbatabaaxxe Tsiyooni,›</para>
  <para style="q2" vid="JER 30:17">hiyye'een.</para>
  <para style="q1" vid="JER 30:17">‹Ani kinni haaroba ha'no'a fayya hissannon;</para>
  <para style="q2" vid="JER 30:17">mada ha'nooxxanna fayyisannon;›</para>
  <para style="q1" vid="JER 30:17">Ani Duuchchi Woddik Gootti tenne haaso'eennen.<verse eid="JER 30:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 30:18" />«Duuchchi Woddiki Gootti hiyya'neeqic:</para>
  <para style="q1" vid="JER 30:18">« ‹Kunse ani Ya'iqoobixxe horte inisa'neenge bogibaa ille iima hissannon;</para>
  <para style="q2" vid="JER 30:18">he'ne he'neeba insa'ne'a o'wannon;</para>
  <para style="q1" vid="JER 30:18">Iyyerusaalemik qachchi diigememmaxxe bakka'ninni ijaaremaan;</para>
  <para style="q2" vid="JER 30:18">mootomatik mininna edinge ifinge booncho'n ijaaremaan.<verse eid="JER 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 30:19" />Ookko hedhaak manni galatiinxa faaro farsaan;</para>
  <para style="q2" vid="JER 30:19">gammashshotinna ilillissaan;</para>
  <para style="q1" vid="JER 30:19">Ani insa'nee bira sa'issannon,</para>
  <para style="q2" vid="JER 30:19">laakkossi insa'neekinn shixedhabaan;</para>
  <para style="q1" vid="JER 30:19">Ulfaantaashsha assannon,</para>
  <para style="q2" vid="JER 30:19">tuffatemmeke kandabaan.<verse eid="JER 30:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 30:20" />Oose insa'neexxi edike insa'neeke annuwwishsha kaddaan;</para>
  <para style="q2" vid="JER 30:20">orgi insa'neekinna an edo jabeesseme hedhaan;</para>
  <para style="q2" vid="JER 30:20">insa'nee miicaaka duuchcha xixannon.<verse eid="JER 30:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 30:21" />Insa'nee akeekaak insa'neeke kadaan;</para>
  <para style="q2" vid="JER 30:21">insa'nee galchaakinna insa'nee giddii'ninni ilemaan;</para>
  <para style="q1" vid="JER 30:21">Ani isoo ifibaa shiqilshannon,</para>
  <para style="q2" vid="JER 30:21">isinna aniba'a shiqaan;</para>
  <para style="q2" vid="JER 30:21">Iittate kada gophphee'ya ayyete sheneti anba'a shiqammata?›</para>
  <para style="q2" vid="JER 30:21">Hiyya'nee Duuchchi Woddiki Gootti.<verse eid="JER 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 30:22" />« ‹Tennexxee ha'no anke arda kaddinaan;</para>
  <para style="q2" vid="JER 30:22">aninna ha'nooke Mageno kadannon.› »<verse eid="JER 30:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="JER 30:23" />Kunnise Duuchchi Woddike Goottixxi hobonbalte,</para>
  <para style="q2" vid="JER 30:23">mufeti kexxaani;</para>
  <para style="q1" vid="JER 30:23">Sodaachchissaaxxi diidallonna,</para>
  <para style="q2" vid="JER 30:23">fuggaleeyyetike umo'n bubuwwissaan.<verse eid="JER 30:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 30:24" />Ifixxe qalbeka yaada muuxebaak,</para>
  <para style="q2" vid="JER 30:24">Duuchchi Woddike Goottixxi aare,</para>
  <para style="q2" vid="JER 30:24">illeema higgabaan;</para>
  <para style="q1" vid="JER 30:24">Dagaake baruwwa'inna,</para>
  <para style="q2" vid="JER 30:24">ha'no tenne'e hubattinaan.<verse eid="JER 30:24" /></para>
  <chapter eid="JER 30" />
  <chapter number="31" style="c" sid="JER 31" />
  <para style="s1">Isira'eelik Ardi Ifike Bogiba'a Higaaxxa</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 31:1" />«Ookkone baro» hiyya'neen Duuchchi Woddiki Gootti, «Ookkone baro'n ani Isira'eelixxe gosake minuwwi duuchchike Magno kadannon insa'nenna anke arda kandaan.»<verse eid="JER 31:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 31:2" />Duuchchi Woddiki Gootti hiyya'neeqic,</para>
  <para style="q1" vid="JER 31:2">«Wolantichchakenaa'n gateeki ardi,</para>
  <para style="q2" vid="JER 31:2">qiilla gammoojje giddo anenaa'n elle alfaan;</para>
  <para style="q2" vid="JER 31:2">Aninna Isira'eeli'i hafuura adhdhisonna'a dagannon.»<verse eid="JER 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 31:3" />Duuchchi Woddiki Gootti bayyii'n no'o'n leelleexxi,</para>
  <para style="q1" vid="JER 31:3">«Ani duuchchi woddixxe jaalalanni ha'no'o eeyyeennen;</para>
  <para style="q2" vid="JER 31:3">tennexxee mararte anxenni ha'no'o ifi biri'a shiqilsenne.<verse eid="JER 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 31:4" />Koo anke arda Isira'eeli haaroba ha'no'o ijaarannon;</para>
  <para style="q2" vid="JER 31:4">ha'nonna ijaarendinaan;</para>
  <para style="q1" vid="JER 31:4">Haaroba okole ha'nooka adhdhitineexxi</para>
  <para style="q2" vid="JER 31:4">burraaqaakerni welt gammaddina'n burraaqqinaan.<verse eid="JER 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 31:5" />Haaroba Semaariyaxxe koobuwwa'n,</para>
  <para style="q2" vid="JER 31:5">woyyinetika hiddichcho kaalsitinaan;</para>
  <para style="q1" vid="JER 31:5">Kaalsemmak hujalluwwi hiddichchuwwa</para>
  <para style="q2" vid="JER 31:5">konnexxe gumma'n gammadaan.<verse eid="JER 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 31:6" />Heqanjuwwi Efireemixxe kooba hana</para>
  <para style="q2" vid="JER 31:6">hedhee hafuura gikki asseexxi,</para>
  <para style="q1" vid="JER 31:6">‹Amme, Tsiyooni'a Duuchchi Woddike Gootta</para>
  <para style="q2" vid="JER 31:6">no'oke Mageniba'a me'ino! Hiyyaaxxe barra daggaan.› »<verse eid="JER 31:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 31:7" />Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 31:7">«Ya'iqoobixxe hortexxee'e gammadik faarse;</para>
  <para style="q2" vid="JER 31:7">angafa gosa gosatike ardikee,</para>
  <para style="q1" vid="JER 31:7">Galatakanna shiqishshe;</para>
  <para style="q2" vid="JER 31:7">‹Ee, Duuchchi Woddike Gootta,</para>
  <para style="q2" vid="JER 31:7">arda atika Isira'eelixxa hafe anjiri› hiyye.<verse eid="JER 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 31:8" />Kunse ani insa'nee'e middike boganaa'n iyyedagannon;</para>
  <para style="q2" vid="JER 31:8">buttatixxe gabalabaa'ininna insa'nee bukki assannon;</para>
  <para style="q1" vid="JER 31:8">Insa'nee giddo balla'uwwi, naafuwwi,</para>
  <para style="q2" vid="JER 31:8">siiliinxirinna ciniffattaaxxiri hexxaan;</para>
  <para style="q2" vid="JER 31:8">heenobaake ardanna kandee illeema hingaan.<verse eid="JER 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 31:9" />Insa'nenna oo'na'ni dangaan,</para>
  <para style="q2" vid="JER 31:9">aninna jajjabeessa'ni insa'nee iyyedagannon;</para>
  <para style="q1" vid="JER 31:9">Ani Isira'eeli'a annake kadennexxeenna,</para>
  <para style="q2" vid="JER 31:9">Efireemi anke sooreessa belto kademmaxxee,</para>
  <para style="q1" vid="JER 31:9">Ani insa'nee'e wodu'uwwiinxe muummeke,</para>
  <para style="q2" vid="JER 31:9">guggufantabaake eloke ora'n akeekannon.<verse eid="JER 31:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 31:10" />«Koo gosa gosake arda, Duuchchi Woddike Goottika hiyyichcho laqqe,</para>
  <para style="q2" vid="JER 31:10">bayya hexxeexxe abbaayya qarqaruwwa'n hedheeke arduwwa'ninna,</para>
  <para style="q1" vid="JER 31:10">‹Isira'eelika arda xeereek isinni insa'nee'e bukki assaan;</para>
  <para style="q2" vid="JER 31:10">hore ifika alalisanji heqqedhammashsha insa'nee'e heqqaan› hitina'n lasse.<verse eid="JER 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 31:11" />Duuchchi Woddiki Gootti Ya'iqoobixxa horte fulchaan;</para>
  <para style="q2" vid="JER 31:11">isa'nee'e caalaake mannixxe anganaa'inna insa'nee'e wodaan.<verse eid="JER 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 31:12" />Insa'nenna dangeexxi Tsiyoonixxe kooba hana gammashoti farsinaan;</para>
  <para style="q2" vid="JER 31:12">Duuchchi Woddike Gootti insa'ne'a badhaaseexxe</para>
  <para style="q1" vid="JER 31:12">Midha'n, woyinetike bulbulo'n, Ejerisiinxa zayite'n,</para>
  <para style="q2" vid="JER 31:12">re'etike'ninna gedhebiinke buruusa'n, jibichake'ninna raadate'n gammandaan;</para>
  <para style="q1" vid="JER 31:12">Insa'ne geyaaka wode'e alfeeke hiddichchiinke boonchisha kandaan;</para>
  <para style="q2" vid="JER 31:12">ta'inni eliqi'a yaandabaan.<verse eid="JER 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 31:13" />Ookkoneechchi uduma dubarri insa'neek gammada'nee sirbaan,</para>
  <para style="q2" vid="JER 31:13">dargaggeeyye insa'neexxinna labbaxxi geedhe insa'neexxi burraaqqaan.</para>
  <para style="q1" vid="JER 31:13">Oodhishsha insa'neexxa gammashshote'n jijjiiranno;</para>
  <para style="q2" vid="JER 31:13">yaaddotenaa'n insa'nee jajjabeessanno, gammashshotanna insa'ne'a uwwanno.<verse eid="JER 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 31:14" />Qeese bira sa'isse eebbisanno;</para>
  <para style="q2" vid="JER 31:14">arda ankanna arjuma anxenni goddisanno,»</para>
  <para style="q2" vid="JER 31:14">hiyya'neen Duuchchi Woddik Gootti.<verse eid="JER 31:14" /></para>
  <para style="s1">Duuchchi Woddiki Gootti Isira'eeli'a Marareexxa</para>
  <para style="p">
    <verse number="15" style="v" sid="JER 31:15" />Duuchchi Woddiki Gootti hiyya'neeqici,</para>
  <para style="q1" vid="JER 31:15">«Oodhishshanna hunbaasha,</para>
  <para style="q2" vid="JER 31:15">Raamake qachchanaa'n laqende;</para>
  <para style="q1" vid="JER 31:15">Oose ifixxa gophphemmaxxe'e,</para>
  <para style="q2" vid="JER 31:15">Raaheeli ooxxe;</para>
  <para style="q2" vid="JER 31:15">dayyeeffachchonna gibbe.»<note caller="-" style="x"><char style="xo" closed="false">31:15 </char><char style="xt" closed="false"><ref loc="GEN 35:16-19">Dada. 35:16-19</ref>; <ref loc="MAT 2:18">Mat. 2:18</ref>. </char></note><verse eid="JER 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 31:16" />Duuchchi Woddiki Goottinna hiyya'neeqic,</para>
  <para style="q1" vid="JER 31:16">«Oodhishsha atixxa uurrisi;</para>
  <para style="q2" vid="JER 31:16">indiddotanna fi'wi.</para>
  <para style="q1" vid="JER 31:16">Raaheelii'i elo atixxi tola gatagophphammaxxee»</para>
  <para style="q2" vid="JER 31:16">hiyya'neen Duuchchi Woddiki Gootti.</para>
  <para style="q2" vid="JER 31:16">«Oose atixxi naaphiinke boginaa'n illeema higge daggaan.<verse eid="JER 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 31:17" />Tennexxee ati hegeri adde afeetten,»</para>
  <para style="q4" vid="JER 31:17">hiyya'neen Duuchchi Woddiki Gootti.</para>
  <para style="q2" vid="JER 31:17">«Oose atixxi ifike bogiba illeema higgaan.<verse eid="JER 31:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JER 31:18" />«Efireemike ardixxe oodhishshaxxa hinqilfachcho dhugaaten laqeennen;</para>
  <para style="q2" vid="JER 31:18">‹Lenjisemebaake jibichchishsha ati no'oo xixeetten;</para>
  <para style="q2" vid="JER 31:18">no'onna xixemmeennen;</para>
  <para style="q1" vid="JER 31:18">Ati Duuchchi Woddike Gootta no'ooke Mageno kaddettaxxee,</para>
  <para style="q2" vid="JER 31:18">no'o hiissi, no'onna hingannon.<verse eid="JER 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 31:19" />Atenaa'n bayyantennechchi uduma,</para>
  <para style="q2" vid="JER 31:19">wirri hine gaabbinen.</para>
  <para style="q1" vid="JER 31:19">Yaane no'o'n aageechchi uduma,</para>
  <para style="q2" vid="JER 31:19">yaaddoti qoma ifi ga'ninenne;</para>
  <para style="q1" vid="JER 31:19">Dargaggeessummate'n assinennaxxe balleessanaa'n kexxeexxa</para>
  <para style="q2" vid="JER 31:19">salphanteennen hangulli.›<verse eid="JER 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 31:20" />«Efireemi anke belto eeya'enneken,</para>
  <para style="q2" vid="JER 31:20">iso'n gammada'nekebata?</para>
  <para style="q1" vid="JER 31:20">Heddole iso'o aallatte haaso'onnolenna,</para>
  <para style="q2" vid="JER 31:20">hige hige'e isoo hedannon;</para>
  <para style="q1" vid="JER 31:20">Tennexxee godobi anki isi'a raafemaan;</para>
  <para style="q2" vid="JER 31:20">lumoshshanna isoo mararannon,»</para>
  <para style="q4" vid="JER 31:20">ani Duuchchi Woddiki Gootti tennee haaso'eennen.<verse eid="JER 31:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JER 31:21" />«Koo Isira'eelike arda oriinka beesisa uurlse;</para>
  <para style="q2" vid="JER 31:21">ora akeekaalchonna olte;</para>
  <para style="q1" vid="JER 31:21">Me'itina'neeka oranna,</para>
  <para style="q2" vid="JER 31:21">ookkonee lumoka hodhichanna hubatte;</para>
  <para style="q1" vid="JER 31:21">Tee dubarrichcho Isira'eeli, illeema higi;</para>
  <para style="q2" vid="JER 31:21">qachchuwwa atikibaanna oriibi'aa ileema higi.<verse eid="JER 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 31:22" />Koo addatendinebaake,</para>
  <para style="q2" vid="JER 31:22">Isira'eelike arda haaniqico'n doonsakiyya hitina'n hexxina?</para>
  <para style="q1" vid="JER 31:22">Ani Duuchchi Woddiki Gootti buttate'n haaroxxa,</para>
  <para style="q2" vid="JER 31:22">yaane assannon tinninna melaalle labbakee gollake kaddaan.»<verse eid="JER 31:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 31:23" />Dada duuchcha ajajaak Duuchchi Woddiki Gootti Isira'eelilk Mageni hiyya'neeqic: «Ani insa'nee booji'otenaa'ni wirri assee hissanno wodda Yihudiinke bogikinna isike qachchuwwiki ardi haaroba: ‹Tee qullummatike galduma kaddeettexxe woyyitte kooba, Duuchchi Woddiki Gootti atee'e eebbiso'o!› hiyyaan. <verse eid="JER 31:23" /><verse number="24" style="v" sid="JER 31:24" />Wiisaluwwikinna hore horataaki manni Yihudi giddonna isike qachchuwwa'n mitteba hedhaan. <verse eid="JER 31:24" /><verse number="25" style="v" sid="JER 31:25" />Ani shaqqeeka manna hunna haroonsannon; gaggabeekaranna jabeessannon.» <verse eid="JER 31:25" /><verse number="26" style="v" sid="JER 31:26" />Eettene yanna diiphii'n dammaqee erqe kayya uudenne; diiphikinna yo'osha ane'ni xe'meemman.<verse eid="JER 31:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 31:27" />«Isira'eelikanna Yihudiinke boga'n» hiyya'neen Duuchchi Woddiki Gootti. «Manjokanna hore wonshannoxxe yanna daggaan, <verse eid="JER 31:27" /><verse number="28" style="v" sid="JER 31:28" />Insa'ne xuqqi hiyyemmashshanna diigemmaashsha, fedenshemmashanna ba'naashsha, insa'ne'n rakko daggaashsha assennashanni, ittanni insa'ne ijaarremmashshanna uurrinaashsha assannon» hiyya'neen Duuchchi Woddiki Gootti. <verse eid="JER 31:28" /><verse number="29" style="v" sid="JER 31:29" />«Ookkone baro'n ardi langaxxa,</para>
  <para style="q1" vid="JER 31:29">« ‹Annuwwi raxxebaaxxa woyinetixxa gumma itemmaxxee'e,</para>
  <para style="q2" vid="JER 31:29">insa'neexxe oosexxi isso bukkurte hiyyaaka mammaassa mammaakabaan.›<note caller="-" style="x"><char style="xo" closed="false">31:29 </char><char style="xt" closed="false"><ref loc="EZK 18:2">Hiz. 18:2</ref>. </char></note><verse eid="JER 31:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="JER 31:30" />Yaane kinni mitti mitting manji ifinxe cubboxxee reyaan; raxxebaaxxa woyinetixxa gumma itaak duuchchi ifinxe isso bukkurtaan.<verse eid="JER 31:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 31:31" />«Ani Isira'eelikenna</para>
  <para style="q2" vid="JER 31:31">Yihudake ardi'a» hiyya'ne Duuchchi Woddiki Gootti,</para>
  <para style="q1" vid="JER 31:31">«Haaroxxa kako aagannoxxe</para>
  <para style="q2" vid="JER 31:31">yaanna daggaan.<note caller="-" style="x"><char style="xo" closed="false">31:31 </char><char style="xt" closed="false"><ref loc="MAT 26:28">Mat. 26:28</ref>; <ref loc="MRK 14:24">Mar. 14:24</ref>; <ref loc="LUK 22:20">Luq. 22:20</ref>; <ref loc="1CO 11:25">1 Qor. 11:25</ref>; <ref loc="2CO 3:6">2 Qor. 3:6</ref>. </char></note><verse eid="JER 31:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 31:32" />Tinni kakonna Gibtsee'ni insa'nee fulchonnaa,</para>
  <para style="q2" vid="JER 31:32">anga insa'neexxa abide akeekennaxxa yanna,</para>
  <para style="q1" vid="JER 31:32">Annuwwa insa'neekee aagennaxxe kakoshsha,</para>
  <para style="q2" vid="JER 31:32">hexxeexxebaan;</para>
  <para style="q1" vid="JER 31:32">Ani insa'neeke aro'o kadee'naanni</para>
  <para style="q2" vid="JER 31:32">insa'ne kako anxa diinge'emman,»</para>
  <para style="q2" vid="JER 31:32">hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 31:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 31:33" />«Yaane kinni eettene yaanna uduma,</para>
  <para style="q2" vid="JER 31:33">Isira'eelike ardi'a aagaannexxi kako tenneten» hiyya'nen Duuchchi Woddiki Gootti.</para>
  <para style="q1" vid="JER 31:33">«Seera anka qalbe insa'neexxi giddo uggannon;</para>
  <para style="q2" vid="JER 31:33">godoba insa'neeki giddonna borreessannon;</para>
  <para style="q1" vid="JER 31:33">Ani insa'neeke Mageno kadanno;</para>
  <para style="q2" vid="JER 31:33">insa'nenna anke arda kandaan.<note caller="-" style="x"><char style="xo" closed="false">31:33 </char><char style="xt" closed="false"><ref loc="HEB 10:16">Ibr. 10:16</ref>. </char></note><verse eid="JER 31:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 31:34" />Ta'anni edi'aa ayyinna jaalo ifika,</para>
  <para style="q2" vid="JER 31:34">yookaan dayyo ifika ‹Duuchchi Woddika Gootta ege'ni,› hiyyeexxi barachchiisabaan;</para>
  <para style="q1" vid="JER 31:34">Shiixxokenaa'n lumokiqico'n hedheeki</para>
  <para style="q2" vid="JER 31:34">duuchchiing anee'e ege'nammaxxe;</para>
  <para style="q2" vid="JER 31:34">hiyya'neen Duuchchi Woddik Gootti.</para>
  <para style="q1" vid="JER 31:34">«Ani balleessa insa'neexxa gattowwaali hiyyannon;</para>
  <para style="q2" vid="JER 31:34">cubbo insa'neexxanna hige hedabe'non.»<note caller="-" style="x"><char style="xo" closed="false">31:34 </char><char style="xt" closed="false"><ref loc="HEB 10:17">Ibr. 10:17</ref>. </char></note><verse eid="JER 31:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 31:35" />Barra iffaashsha,</para>
  <para style="q1" vid="JER 31:35">Arishsho uggeek,</para>
  <para style="q1" vid="JER 31:35">Hashshanna iffaashsha</para>
  <para style="q2" vid="JER 31:35">agenjokanna urjuwwa ajajeek,</para>
  <para style="q1" vid="JER 31:35">Danbala'i luulaashsha,</para>
  <para style="q2" vid="JER 31:35">abaayya raasendaashsha asseek,</para>
  <para style="q2" vid="JER 31:35">Summi isik dada duuchcha ajajake Duuchchi Woddike Gootta kade'eeki hiyya'nee qici:<verse eid="JER 31:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 31:36" />«Kunni seeri ani edii'n jijjiiremoole»</para>
  <para style="q2" vid="JER 31:36">hiyya'neen Duuchchi Woddiki Gootti,</para>
  <para style="q1" vid="JER 31:36">«Eettenee yanna calla Isira'eelixxe horteke,</para>
  <para style="q2" vid="JER 31:36">arda kada duuchchii woddi'aa ani edii'n gattaan.»<verse eid="JER 31:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 31:37" />Tinni maachcho hiyya'neen Duuchchi Woddiki Gootti:</para>
  <para style="q1" vid="JER 31:37">«Iimate'n, iima mikenda'noole,</para>
  <para style="q2" vid="JER 31:37">butta buttatixxi booso qorqorende ege'nenda'noole callan,</para>
  <para style="q1" vid="JER 31:37">Assitemmaxxe balleessaxxe ani Isira'eelixxa horte waalannok»</para>
  <para style="q2" vid="JER 31:37">ani Duuchchi Woddiki Gootti tennee haaso'eennen.<verse eid="JER 31:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JER 31:38" />«Kunniseteni Iyyerusaalemik qeerrake kinji minenaa'ni ke'e Hanaani'eelixxe xeleephobaa'n kasiinxe dalla'iinxe hulaqico'n» hiyya'neen Duuchchi Woddiki Gootti, «konnee qachcha ani'aa qammalchemaaxxe barra daggaan; <verse eid="JER 31:38" /><verse number="39" style="v" sid="JER 31:39" />Gabalatinna ookkoo'n kexxeexxi toggi hite'e Gareebike tullichchiba'a me'iteexxi Go'abaa gortaan. <verse eid="JER 31:39" /><verse number="40" style="v" sid="JER 31:40" />Renshikinna bululi hunemammaxxi dhooqa duuchchi, boroti darre'n Qeediroonxe dhooqanninni, fadhadiinxe hulake kasiqico'n hedheeki boonchi duuchchi, Duuchchi Woddike Gootti'a woyyoome'eeke kadaan; ta'inni edi'a Iyyerusaalemik qachchi langaxxa findigemabaan; diigemabaan.»<verse eid="JER 31:40" /></para>
  <chapter eid="JER 31" />
  <chapter number="32" style="c" sid="JER 32" />
  <para style="s1">Ermiyaasi Boga Hidhdheexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 32:1" />Yihudaki moyanji Sedeqiyaasi moyeexxe tommeessoxxe wogga'n, tininna Baabiloonike moyanji Nabukadanatsoori moyeexxe tommenna saddeeteessoxxe wogga'n Ermiyaasiba'a dageeki Duuchchi Woddike Goottiki hiyyichchi konnechchin butti'a hedheeken.<note caller="-" style="x"><char style="xo" closed="false">32:1 </char><char style="xt" closed="false"><ref loc="2KI 25:1-7">2 Moy. 25:1-7</ref>. </char></note> <verse eid="JER 32:1" /><verse number="2" style="v" sid="JER 32:2" />Eettene yaanna Baabiloonike moyanjiki, loliinki manni Iyyerusaalemii'i buqeemman; waabeekichchi Eermiyaasinna Yihudake mootomatike minixxe baxxeke heqanjuwwike mini giddo cufemee hedha'emman.<verse eid="JER 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 32:3" />Yihudiink moyanji Sedeqiyaasi, Ermiyaasii Magen haaso'emmaxxa yaane iso'n haaso'emmaxxee iso usursiiseemmaxxi itti yaane «Mayeete, ‹Kunnise, Duuchchi Woddiki Gootti, konnee qachcha Baabiloonike moyanjixxe anga'n sa'isse uwwaan; isinna booji'aan. <verse eid="JER 32:3" /><verse number="4" style="v" sid="JER 32:4" />Yihudiinki moyanji Sedeqiyaasinna Baabiloonike mannixxe anganaa'n baaje fulabaan; yaane kinni Baabiloonike moyanjixxe anga'n sa'issemee uwwemaan; isi edonna uurreexxi illeti iso'o uuda'n welti haaso'aan. <verse eid="JER 32:4" /><verse number="5" style="v" sid="JER 32:5" />Isi Sedeqiyaasi'i Baabilooni'a iyyemaraan, ani murte iso'n iyyedaganno qico'n ookkonni hedhaan; ha'no Baabiloonike manninni lolendinoolenna ha'no'a qajeeldabaan hiyyeen› hittettechchi mayeete?» hiyye. <verse eid="JER 32:5" /><verse number="6" style="v" sid="JER 32:6" />Duuchchi Woddike Goottiki hiyyichchi anee Ermiyaasiba'a dage. <verse eid="JER 32:6" /><verse number="7" style="v" sid="JER 32:7" />Isinna ane'n «Anniinka dayo, Shalumiki belti Anaami'eeli, atiba dageexxi, ‹Shiqike anke fira kadiyyoti fichcha anka wodatika seera ati'a uwweemmaxxee'e Anaatooti hedheeka anka fichcha anenaa'n hidhdhi› hiyyaan» hiyye. <verse eid="JER 32:7" /><verse number="8" style="v" sid="JER 32:8" />Duuchchi Woddiki Gootti ane'n haaso'emmashshanni anike dayyik belti Anaami'eeli aniba'a, heqqanjuwwiinke minixxe baxxeba'a dageexxi, anee'e «Woddiyyotti ifixxe karra assedhatiki seer ati'a uwwamaxxee Anaattoti giddo Biniyaamike boga'n hedheeka anka fichcha hidhdhite'e ifike assedhi» hiyye; tennenaa'n kexxeexxa aninna, kunni Duuchchi Woddike Goottike hiyyichcho kadeexxa ege'nenne. <verse eid="JER 32:8" /><verse number="9" style="v" sid="JER 32:9" />Tennexxee Anaattoti hedheeka ookkonee fichcha Anami'eeli'i anike dayyike beltinaa'n, hira, lame kiilo kadaaka birretika sibilijjo isi'a uwwe hidhdhenne. <verse eid="JER 32:9" /><verse number="10" style="v" sid="JER 32:10" />Hira weli aagatixxe borro'n beessisa uggennexxi buqenne; birretikka sibilijjonna dhugaa hexxeeba kiilote'n kiilenne. <verse eid="JER 32:10" /><verse number="11" style="v" sid="JER 32:11" />Hiriinxe weli aagoxxa borro, buqendeexxanna buqendebaaxxa aadhennexxi, <verse eid="JER 32:11" /><verse number="12" style="v" sid="JER 32:12" />anke annike dayyike belti eddonna weli aaggotixxe borro'n beessisa uggemmake dhugaa kulatike manni eddo, iittanni heqqanjuwwi heqqammaxxe ussuriinke minixxe baxxe'n ofo'leemmake Ayihudiinke manni eddo duuchcha Maahiseyaaka akka'o, Neeryaka belto Baarooki'n uwwenne.<verse eid="JER 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 32:13" />Insa'nee edo Baarooki'i hiyye ajajenneqici: <verse eid="JER 32:13" /><verse number="14" style="v" sid="JER 32:14" />‹Dada duuchcha ajajaak Duuchchi Woddiki Gootti Isira'eeliki Mageni hiyya'neeqic: ‹Buqendeexxinna buqendebaaxxi hira wel aaggotixxi borro, qeerraxxe yanna'a turtaashsha faariinke mi'yi giddo uggi. <verse eid="JER 32:14" /><verse number="15" style="v" sid="JER 32:15" />Manni konne boga'n minuwwa, fichchuwwa, woyyinetike hiddichchuwwika booncho haaroba hiraani hiyye'een.›<verse eid="JER 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 32:16" />«Hira weli aaggotixxa borro Baarooki'i Neeryake belto'n uwwennechchi uduma Duuchchi Woddike Goottiba'a hiyye soodatennee qici:<verse eid="JER 32:16" /></para>
  <para style="pm">
    <verse number="17" style="v" sid="JER 32:17" />«Ee dada duuchcha ajajatoke Duuchchi Woddike Goottaa, ati iimatanna butta atixxe lumoxxe hunnanninna atixxe jabaxxe hirrenni daddeetten; dandettabexxoxxi mitte yaanenna hexxebaan. <verse eid="JER 32:17" /><verse number="18" style="v" sid="JER 32:18" />Jaalalanna arjumma atixxa heddo kuminni laako'emaake manni'a leellishshatto; kaddomalee annuwwi hujemmaxxe balleessa, uduma, oose insa'neexxa xixxatto; summi atiki Lumoke Duuchchi Woddike Gootta kadeeke, lumokenna hunnaameessa Magenoo, <verse eid="JER 32:18" /><verse number="19" style="v" sid="JER 32:19" />yaadi atiki lumoken; huje atixxinna jabbaxxen; ille atixxi manji assaaxxa duuchcha affaan; mitte mittengee me'a isixxishshanna huje huje isixxishshanni hira uuttatto. <verse eid="JER 32:19" /><verse number="20" style="v" sid="JER 32:20" />Gibtsee giddo manbe'anna maso yaanuwwa assitettexxi, telchiqico'ninna Isira'eel giddonna manji duuchchi giddo iitanni assatte'n hexxeten, telchonna summi atiki gurra fule'eeken. <verse eid="JER 32:20" /><verse number="21" style="v" sid="JER 32:21" />Masonna mambe'a assita'n atixxe hunnaameette anganninna atixxe jabaxxe hirrenni, lumooshsha sodaachchisaake atike gaachchanninni atika arda Isira'eeli'i Gibtsee'n fulchittette. <verse eid="JER 32:21" /><verse number="22" style="v" sid="JER 32:22" />Edike insa'neeke annuwwi'a uutotta'a kako aaggetteke, konne shamoka goddiinka boga insa'ne'a uutee'na'a, <verse eid="JER 32:22" /><verse number="23" style="v" sid="JER 32:23" />dange konne boga dhaaleen; yaane kinni ati'a ajajemmebaan, seera atikanna heqqe'neba'a, insa'nee ajajjettexxa yaanenna assa ginbe; tennexxee ba'ne tennee duuchcha insa'ne'ni iyyedaggette.<verse eid="JER 32:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 32:24" />«Kunniseten ati, qachchi abidemo'a qarqarake'n buttinni tullubemeedheen; wolaantichchakenaa'n, solo'okenaa'ninna dhukkubakenaa'n kexxeexxa qachchi iso'o lolaake Baabiloonike mannixxe anga'ni sa'isseme uwwemaan hitetteshshanni, uuddaatteshshanni haasottettaxxi muuxende'een. <verse eid="JER 32:24" /><verse number="25" style="v" sid="JER 32:25" />Ati kinni Duuchchi Woddike Gootta, Mageno qachchi Baabiloonike mannixxe anga'n sa'isseme uwwema'naanni, ‹Ookkonee boga birretike sibiljinni hiri; ookkonee hiranna dhugaa kulaake manni edo muuxi› anee hiteetten.»<verse eid="JER 32:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 32:26" />Ookkonechchi uduma Duuchchi Woddike Goottiki hiyyichchi anee Eermiyaasibaa dageexxi, <verse eid="JER 32:26" /><verse number="27" style="v" sid="JER 32:27" />«Kunnise, ani manjinke belti duuchchike, Duuchchi Woddike Gootta Magenon; isi anee'e dandeessissabaaxxi yaane hexxeeta? <verse eid="JER 32:27" /><verse number="28" style="v" sid="JER 32:28" />Kunnise ani konnee qachcha Baabiloonke mannixxenna Nabukadanatsoorii'i Baabiloonke moyanjixxe anga'n sa'isse uwwannon; isinna iso'o abidaan.<note caller="-" style="x"><char style="xo" closed="false">32:28 </char><char style="xt" closed="false"><ref loc="2KI 25:1-11">2 Moy. 25:1-11</ref>; <ref loc="2CH 36:17-21">2 Odo. 36:17-21</ref>. </char></note> <verse eid="JER 32:28" /><verse number="29" style="v" sid="JER 32:29" />Konnee qachcha lolatee Baabiloonik manni isi giddi'a e'yeexxi qachcha gubaan; manni anee'e mufachchiiso'a ifike minixxe heellichcho hana Ba'aali'aa hixaana guba'ammake minuwwira'inna wele magenuwwi'a ha'watika tolcha giddo tolchaammake mannike mine duuchcha'n giira woraan.<verse eid="JER 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 32:30" />«Isira'eelikinna Yihudaki ardi oosummandenaa'n safeexxi fuggoxxa yaane malee'e ani edo mitte eloxxa yaane assebaan; dhugaanden, Isira'eelik ardi anga ifixxenni asseexxe yaanenni anee'e mufachchiise'een; <verse eid="JER 32:30" /><verse number="31" style="v" sid="JER 32:31" />Kunni qachchi ijaaremeexxe yannanaa'n telchiqico'n isik ardi anee'e mufachchissaaxxanna aarsitaaxxa yaane assemmaxxe ille anxe edii'n konne qachcha fugussanon. <verse eid="JER 32:31" /><verse number="32" style="v" sid="JER 32:32" />Isira'eelikinna Yihudaki ardi, insa'neek moyanjuwwi, insa'neek ja'laabuwwi, insa'neexxi qeesoolenna insa'neexxi waabeeko, Yihudaki manninna Iyyerusaalemi giddo hedhaak manni asseexxe fuggoxxe duuchchinni anee'e mufachchiise'een. <verse eid="JER 32:32" /><verse number="33" style="v" sid="JER 32:33" />Insa'nenna dudduro malee'e alba ane'n wirri hineba'a; higgegge insa'nenni gorsa'naanni lanqeba'a; xixichcho ankanna adhdhineba'a. <verse eid="JER 32:33" /><verse number="34" style="v" sid="JER 32:34" />Ank summi ye'ememmake mine'n battitte fakkuwwa uggudhdhineexxi iseenna battoossine.<note caller="-" style="x"><char style="xo" closed="false">32:34 </char><char style="xt" closed="false"><ref loc="2KI 23:10">2 Moy. 23:10</ref>; <ref loc="JER 7:30-31">Erm. 7:30-31</ref>; <ref loc="JER 19:1-6">19:1-6</ref>. </char></note> <verse eid="JER 32:34" /><verse number="35" style="v" sid="JER 32:35" />Ifixxa Labbaxxanna meyyaxxa oose giirate'n gunba'n Moleeki'a tolchino'a Ben Heenomixxe dhooqa giddo Ba'aali'a tolchiin booncho giissine; yaane kinni insa'ne Yihudaka arda cubbo hujisiyyotee tennee battitte yaane assino'a ani insa'nee ajajebe'non, kunni ani giddo hedhemake yaadannaba'a» hiyye.<note caller="-" style="x"><char style="xo" closed="false">32:35 </char><char style="xt" closed="false"><ref loc="LEV 18:21">Lew. 18:21</ref>; <ref loc="2KI 23:10">2 Moy. 23:10</ref>; <ref loc="JER 7:31">Erm. 7:31</ref>. </char></note><verse eid="JER 32:35" /></para>
  <para style="s1">Magen Uwweexxa Addachchiisa</para>
  <para style="p">
    <verse number="36" style="v" sid="JER 32:36" />« ‹Ardi kunni qachchi Wolaantichchik, solo'ikinna dhukkubik Baabiloonike moyanjixxe anga'n sa'isse uwwemaan› hiyya'neexxee'e Duuchchi Woddiki Gootti Isira'eelik Magen konne qachchixxee hiyya'neeqic: <verse eid="JER 32:36" /><verse number="37" style="v" sid="JER 32:37" />Kunnise, anxe jabaxxe mufenninna lumoxxe balanni xeereennaka arda, bogi duuchchii'n bukki assannexxi konne boonchibaanna hissanon; nage'ikinna he'naashsha assannon. <verse eid="JER 32:37" /><verse number="38" style="v" sid="JER 32:38" />Insa'nenna arda anke kandaan; aninna ina'neeke Mageno kadannon. <verse eid="JER 32:38" /><verse number="39" style="v" sid="JER 32:39" />Insa'ne'anna, uduma insa'neexxe oose'a eloxxi kaddaashsha, duuchchii wodda anee sodaanto'a mitte godobanna mitte heduma insa'ne'a uwwannon. <verse eid="JER 32:39" /><verse number="40" style="v" sid="JER 32:40" />Eloxxa yaane insa'ne'a assa waalabe'non, anenaa'n bayyantabaashshanna giddixxe hedhonn anee sodaantaashsha assa'n, insa'ne'a duuchchii woddixxa kako aaganno. <verse eid="JER 32:40" /><verse number="41" style="v" sid="JER 32:41" />Ani insa'ne'a eloxxa assate'n gammadannon; anke wo'ma yaadinninna anxe wo'ma hedhonni konne boga'n jabeessee insa'nee kaasannon.<verse eid="JER 32:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JER 32:42" />«Konne arda'n tennee ba'ne duuchcha iyyedagenneshshanni iittanni insa'ne'a assonna addachchiisennexxa elolla yaanuwwa duuchchanna insa'ne'a uwwannon. <verse eid="JER 32:42" /><verse number="43" style="v" sid="JER 32:43" />Ha'nonna, ‹Baabiloonike manni'a sa'isseme uwwememmaxxee'e manji hori hedhabaake urma bogan› hitinemmake konne boga'n haaroba fichchi hidhdhemaan. <verse eid="JER 32:43" /><verse number="44" style="v" sid="JER 32:44" />Booji'o insa'ne'a hissannaxxe'e Biniyaamike boga'n, Iyyerusaalemike qarqara'n hedheeke olla'uwwa'n, Yihudake qachchuwwa'ninna kooba callike bogike qachchuwwa'n, dhidhimiinxe koobuwwake hundidarre'ninna Bita'ake'n hedheeke qachchuwwa'n fichchi birretike sibiljinni hidhdhemman; hira gurgursiisakenni weli aagotixxe borro'n beessis uggemeexxi dhuga'a abixxememmake manni edo borro buqendaan, ani Duuchchi Woddiki Gootti tennee haaso'eennen.»<verse eid="JER 32:44" /></para>
  <chapter eid="JER 32" />
  <chapter number="33" style="c" sid="JER 33" />
  <para style="s1">Wele Uwwendeexxa Addachchiisa</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 33:1" />Eermiyaasi usuriinke minike heqanjuwwinxe baxxe'n usuremeba hedhee'naa Duuchchi Woddike Goottik hiyyichchi langaxxa iso'n dageexxi: <verse eid="JER 33:1" /><verse number="2" style="v" sid="JER 33:2" />«butta dadeek, bifa affaashsha asseekinna bakka isexxe'n ooffo'lisheek Duuchchi Woddiki Gootti, summi isikinna Duuchchi Woddike Gootta kadeeki isi hiyya'neeqic: <verse eid="JER 33:2" /><verse number="3" style="v" sid="JER 33:3" />‹Anee ye'edhi, aninna ati'a heeyyannon; ati egendebexxoxxa lumoxxanna hunnameete yaane ate'n leellishshannon› <verse eid="JER 33:3" /><verse number="4" style="v" sid="JER 33:4" />Isira'eelik Duuchchi Woddiki Gootti Magen Baabiloonik manni qarqarake'n qoqqobe buttinna tullubiyyoti lola ke'isseemma wodda diigememmake konnee qachchike minuwwixxeenna Yihudaki moyanjuwwixxe mootomatike minixxee hiyya'neeqic <verse eid="JER 33:4" /><verse number="5" style="v" sid="JER 33:5" />‹Qachchiink manni Baabiloonik manninni lolemo'a fulaan; yaane kinni isa'ne konne qachchi giddo assinemmaxxe fuggo duuchchi'a alba isonaa'n sho'edhannaxxee, mufe anxeninna bala anxenni shiyannoke mannik renshi giddo wo'maan.<verse eid="JER 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 33:6" />« ‹Kaddo malee'e isi'a foorakanna fayyunte haaroba uwwannon; arda ankanna fayyisannon; bira sa'eeke nage'inni ti'ni hine he'naashsha assannon. <verse eid="JER 33:6" /><verse number="7" style="v" sid="JER 33:7" />Yihudakanna Isira'eelika booji'ememmaka manna illeema hiissannon; edo he'nemmaxxe jiro'n he'naashsha assannon. <verse eid="JER 33:7" /><verse number="8" style="v" sid="JER 33:8" />Anee balleesinemmaxxe cubbo duuchchanaa'n insa'nee'e ca'a assannon; ane'n jallantemmaxxa cubbo insa'neexxa duuchchanna gattowaal hiyyannon. <verse eid="JER 33:8" /><verse number="9" style="v" sid="JER 33:9" />Ani konne qachchi'a assennexxe eloxxe yaane duuchchaa laqaake buttatik gosa gosake ardi duuchchi edo ani iso'n gammadannoke, galateeffatemannokenna ulfeessemannoke kadaan; isi'a uwwannoxxe bira saxxeexxe karranaa'inna nage'inaa'n kexxeexxa gosa gosaki ardi sodaate culphisaan› hiyye.<verse eid="JER 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 33:10" />«Duuchchi Woddiki Gootti hiyya'neeqic: ‹Ha'no kunni boonchi, «manji hori hedhabaake urman hitinaan» yaane kinni manji hori hedhammabaakenna urma kade'eeke Yihudake qachchuwwa'inna Iyyerusaalemike oruwwa'n, haaroba hafuuri laqemaan. <verse eid="JER 33:10" /><verse number="11" style="v" sid="JER 33:11" />Ililleettetikinna gammashshotik hafuuri waajubichchikinna waajubbichchotik hafuuri,</para>
  <para style="q1" vid="JER 33:11">« ‹ «Ittanni Duuuchchii Woddiki Gootti eloke kademmaxxeenna</para>
  <para style="q2" vid="JER 33:11">jaalala isixxi duuchchii woddixxe kaddemmaxxee</para>
  <para style="q2" vid="JER 33:11">Lumoka Duuchchi Woddika Gootta galateeffatte» hiyyaak.</para>
  <para style="m" vid="JER 33:11">Galatinka tolcha abixxe Duuchchi Woddiki Goottike miniba'a dagaake manniki hafuuri laqemaan; konne bogii'n booji'ememmaki manni edishsha hedhaashsha illeema hissannon› ani Duuchchi Woddik Gootti tenne haasoennen. <note caller="-" style="x"><char style="xo" closed="false">33:11 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 Odo. 16:34</ref>; <ref loc="2CH 5:13">2 Odo. 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Izr. 3:11</ref>; <ref loc="PSA 100:5">Far. 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 130:1">130:1</ref>. </char></note><verse eid="JER 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 33:12" />«Lumoki Duuchchi Woddiki Gootti hiyya'neeqic: ‹Hori manji hedhammabaaxxa konne duwwi booncho duuchcha'n, qachchuwwa duuchcha'n allalisano hore ala'litaaxxi bakka haaroba hexxaan. <verse eid="JER 33:12" /><verse number="13" style="v" sid="JER 33:13" />Koobatike bogike qachchuwwa'n, dhidhimi darrexxe koobuwwa aadidarreke qachchuwwa'ninna Bita'ake'n hedheeke qachchuwwa'n, Biniyaamike bogi giddonna, Yihudiinke qachchuwwa'n iittanni Iyyerusaalemike qarqara'n hedheeke olla'uwwa'n allalisano haaroba hore ifika lako'wita'n towwattaan› ani Duuchchi Woddiki Gootti tenne haaso'eennen.<verse eid="JER 33:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 33:14" />« ‹Yihudiinke ardi'a addachchiisennaka hiyyichcho muuxxannoxxe yanna daggaan› hiyya'neen Duuchchi Woddiki Gootti.<note caller="-" style="x"><char style="xo" closed="false">33:14</char><char style="xt" closed="false"><ref loc="JER 23:5-6">Erm. 23:5-6</ref>. </char></note><verse eid="JER 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 33:15" />« ‹Okkone barixxe eettene yanna'n,</para>
  <para style="q2" vid="JER 33:15">Daawwitixxe sannenaa'n qullitte kichcho lachchiisannon;</para>
  <para style="q2" vid="JER 33:15">isinna bogake'n dhugaatanna qullumma assaan.<verse eid="JER 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 33:16" />Ookone baro'n Yihudiink ardi anjiremaan;</para>
  <para style="q2" vid="JER 33:16">Iyyerusaaleminna nage'ik hexxaan;</para>
  <para style="q1" vid="JER 33:16">Duuchchi Woddiki Gootti no'ooxxe qullumman› hiyyemaake summininna ye'endaan.<verse eid="JER 33:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="JER 33:17" />Dawwitixxe sannenaa'n Isira'eelixxe moote'n hana ofo'laaki haranga gophemabaan;<note caller="-" style="x"><char style="xo" closed="false">33:17 </char><char style="xt" closed="false"><ref loc="2SA 7:12-16">2 Sam. 7:12-16</ref>; <ref loc="1KI 2:4">1 Moy. 2:4</ref>; <ref loc="1CH 1:11-14">1 Odo. 1:11-14</ref>. </char></note> <verse eid="JER 33:17" /><verse number="18" style="v" sid="JER 33:18" />iittanni ciincatika tolcha shiqishatee, midhatika tolchcha cinceessateenna wele tolchuwwa tolchatee'e Leewwike manninaa'n qeesete kade'e duuchchii wodda ani edo uurraaki manji gophemabaan» hiyye.<note caller="-" style="x"><char style="xo" closed="false">33:18 </char><char style="xt" closed="false"><ref loc="NUM 3:5-10">Lak. 3:5-10</ref>. </char></note> <verse eid="JER 33:18" /><verse number="19" style="v" sid="JER 33:19" />Duuchchi Woddike Goottik hiyyichchi Eermiyaasi'n dageexxi, <verse eid="JER 33:19" /><verse number="20" style="v" sid="JER 33:20" />Duuchchi Woddiki Gootti, «Ani hashshatinna barra, hashshite sooddaashsha murennexxi aada muuxendabaashsha hoyya dadeessissoole, <verse eid="JER 33:20" /><verse number="21" style="v" sid="JER 33:21" />ookene wodda callan erganjo anke Daawwiti'a aagennexxi kako, iittanni ani edo qeessummati ergatemaake Leewwike manni'a aagennaxxi kako diigendaak; iittanni ookene wodda callan Daawwitiinna ta'anni edi'a moote ifixxe'n moyaaka sanne ifixxinaa'n afabaak. <verse eid="JER 33:21" /><verse number="22" style="v" sid="JER 33:22" />Erganjo anke Daawwitixxa sannenna ani'a ergataaka Leewwika manna iimixxe urjeshsha lako'emabaakenna abbaayyatike maanchishsha bira sa'issannon» hiyye.<verse eid="JER 33:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 33:23" />Duuchchi Woddiki Gootti hiyyichchi Eermiyaasi'n dageexxi hiyyeeqic: <verse eid="JER 33:23" /><verse number="24" style="v" sid="JER 33:24" />«Kunni ardi, ‹Duuchchi Woddiki Gootti fi'lemmaka Isireelixxenna Yihudaxxe mootummaka arda waale'een› hiyya'n haaso'a'neexxa hubattineenni hexxinebaata? Insa'ne anka arda tuffante'een; ardiinshanna laakonneebaan. <verse eid="JER 33:24" /><verse number="25" style="v" sid="JER 33:25" />Duuchchi Woddik Gootti hiyye qici ‹Hashshatinna barra hexxaashsha kakoti mura gophoonnole, iimateenna buttatee aada uggeenneki ante kada gophoonnole, <verse eid="JER 33:25" /><verse number="26" style="v" sid="JER 33:26" />Ya'iqoobixxanna erganjo anke Daawwitixxa sanne waalanno; oose isixxinaa'inna, Abirihaamixxe, Yisaaqixxenna Ya'iqoobixxe horte'n mootaashsha filabe'no; ani tenne hiyyaanneki booji'o insa'neexxa illeema hissannexxeenna insa'ne'a o'wanaxxeeten› » hiyye.<verse eid="JER 33:26" /></para>
  <chapter eid="JER 33" />
  <chapter number="34" style="c" sid="JER 34" />
  <para style="s1">Sedeqiyaasixxee Haaso'endeexxa Wabeekumma</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 34:1" />Baabiloonik moyanji Nabukadanatsoorinna isiki loliink manni duuchchi, galcha isixxi hunda hexxemmaxxi mootummuwwanna arduwwi duuchchi, Iyyerusaaleminna qarqara iseke'n hedheeka qachchuwwa lollammaxxa yanna, Duuchchi Woddiki Gootti hiyyichchi Eermiyaasi'n dageexxi:<note caller="-" style="x"><char style="xo" closed="false">34:1 </char><char style="xt" closed="false"><ref loc="2KI 25:1-11">2 Moy. 25:1-11</ref>; <ref loc="2CH 36:17-21">2 Odo. 36:17-21</ref>. </char></note> <verse eid="JER 34:1" /><verse number="2" style="v" sid="JER 34:2" />«Duuchchi Woddiki Gootti Isira'eelik Mageninna Martettexxi Yihudake moyanjo Sedeqiyaasii'i Duuchchi Woddiki Gootti, ‹Ani konnee qachcha Baabiloonike moyanjixxe anga'n sa'issee uwwonaaten, isinna isoo giirati gubaan. <verse eid="JER 34:2" /><verse number="3" style="v" sid="JER 34:3" />Atinna abidendetexxi isixxe anga'n sa'issende uwwendatto malee'e isixxe anga'naa'n fuldabexxon; ati Baabiloonika moyanjo ille atixxenninn uuda'n isinni welti haasottatton; okkonechchi uduma Baabilooni'a me'ittatton hiyye.<verse eid="JER 34:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 34:4" />« ‹Yaane kinni, Yihudiinke moyanjo koo Sedeqiyaasi! Duuchchi Woddike Goottika hiyyichcho laqi; Duuchchi Woddiki Gootti atee, Wolaantichchiki rertabexxon; <verse eid="JER 34:4" /><verse number="5" style="v" sid="JER 34:5" />Nage'inginni rertatton. Ardi, ati edidarre hedhemmaka moyanjuwwa atika annuwwa ulfeessate'e mooggo insa'eneek baro giira ha'ishshammashsha, atike mooggi baronna atee ulfeessatee'e giira ha'inshaan; «Woo, woo gootta no'ookee!» hina'ninna ati'a oo'naan; ani Duuchchi Woddiki Gootti tennee haaso'eennen› » hiyye.<verse eid="JER 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 34:6" />Wabeekichchi Eermiyaasi tennee duuchcha Yihudiinke moyanjo'n Sedeqiyaasi'n Iyyerusaalemi kule. <verse eid="JER 34:6" /><verse number="7" style="v" sid="JER 34:7" />Konne wodda Baabiloonik moynjik manni Iyyerusaalemii'i, iittanni gateeka Yihudiinka qachchuwwa Lakishiinna Azeeqa lolate'n he'nemman; Lakishiinna Eezeqahi Yihuda giddo kinjiinke dalla'uwwike qachchuwwinaa'n gateemmak ison callaman.<verse eid="JER 34:7" /></para>
  <para style="s1">Garbummatenaa'n Fuleeke Garbuwwixxa Garbummatibaa Higa</para>
  <para style="p">
    <verse number="8" style="v" sid="JER 34:8" />Moyanji Sedeqiyaasi garbummatenaa'n garbuwwa fulcho'a Iyyerusaalemike ardi duuchchinni welti kako aageechchi uduma Duuchchi Woddike Goottiki hiyyichchi Ermiyaasi'n dage.<verse eid="JER 34:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 34:9" />Mitti mitting Ibiritotixxe gosak manji, Ibiritotixxe gosa kadeeka labbaka garbichchanna Ibiritotixxe gosaxxa meyyaxxa garbitte garbumma galchatenaa'n wocci asso'atemman; ayyinna ifika, Ayihudiinxe gosaka manjo garbumma galchashshatemabaan. <verse eid="JER 34:9" /><verse number="10" style="v" sid="JER 34:10" />Tennexxee tennee kakonni mitte afo'o kadeek ja'laabuwwinna ardi duuchchi ifi ifi'a galchammaka labbaka garbuwwanna meyyaxxa garbittuwwa garbummatenaa'n wocci assaashshanna, ta'anni edi'aanna haaroba insa'nee'e garbumma galchinabaashsha weli aangeexxi garbummatenaa'n insa'nee fulchine. <verse eid="JER 34:10" /><verse number="11" style="v" sid="JER 34:11" />Yaane kinni turreexxi, garbummatenaa'n wocci assinemmanga ifi ifika garbuwwa, higaashsha assineexxi, haaroba garbumma galchine. <verse eid="JER 34:11" /><verse number="12" style="v" sid="JER 34:12" />Ookkoneechchi uduma Duuchchi Woddike Goottiki hiyyichchi Eermiyaasi'n dageexxi: <verse eid="JER 34:12" /><verse number="13" style="v" sid="JER 34:13" />«Duuchchi Woddiki Gootti Isira'eelik Mageni hiyya'nee qici: ani edika ha'nooka annuwwa garbumma galamabaa'n Gibtsee'n fulchene wodda insa'ne'a kako aagennexxi, <verse eid="JER 34:13" /><verse number="14" style="v" sid="JER 34:14" />‹garbummatee ha'no'ni ifi gurgudheeka Ibiritotixxe gosaka manjo jaane wogga ha'no'a ergatemmeechchi uduma, mitti mitti ha'nook torbaane torbaane wogga'n garbummatenaa'n insa'ne'e wocci asse.› Annuwwi ha'nooki kinni anxa lanqeba'a; manshshatanna aniba'a wirri assineeba'a.<note caller="-" style="x"><char style="xo" closed="false">34:14 </char><char style="xt" closed="false"><ref loc="EXO 21:2">Fula. 21:2</ref>; <ref loc="DEU 15:12">Lan. 15:12</ref>. </char></note> <verse eid="JER 34:14" /><verse number="15" style="v" sid="JER 34:15" />Ha'no ta'a aadde aaggineexxi ani edo eloxxa yaane assitineen; mitti mitti ha'noong, garbake assexxinemmaka ha'nooxxe gosaka manjo garbummatenaa'n wocci assitineen; summi anki ye'emaake mine'n ani edo kako aaggineen. <verse eid="JER 34:15" /><verse number="16" style="v" sid="JER 34:16" />Yaane kinni wirri hitineexxi summa anka battoositineen; garbummatenaa'n fule fedhe hedho'a wocci assitinemmaka labbaka ha'nooka garbuwwanna meyyaxxa ha'noxxa garbittuwwa wirri assitine haaroba garbake assexxine'een.<verse eid="JER 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 34:17" />«Tenne'a ha'no ani'a ajajema gophphine'e: ha'nooxxe gosaka Isira'eelika manna leexumma fulo'a lallaba gophphinemmaxxe'e ani'a ajajendinebaan. Kunseten ani ‹leexumma fula› ha'no'a lallabeennen Duuchchi Woddik Gootti. Tinninna ha'no wolaantichchake'n, dhukkubake'ninna solo'oke'n wocci assendinaaxxe ‹leexuma› fulan. Buttatiki gosa gosak ardi duuchchii uudeexxi bajabaja hiyyaaxxa yaane ha'no'n assannon. <verse eid="JER 34:17" /><verse number="18" style="v" sid="JER 34:18" />Kako anxa diigeekanna aagemmaxxe kako muuxa gopheeka manna, insa'ne kako aagatee dulleexxi, maala isika lameba dhaanbe'e oddo giddii'n sa'nemmake ookone jibichcha'n, insa'ne assinammashshanni aninna iitanni insa'ne'n assannon. <verse eid="JER 34:18" /><verse number="19" style="v" sid="JER 34:19" />Yihudakanna Iyyerusaalemika akeekisanjuwwa, mootummatike minika ja'laabuwwa, qeesoletanna jibichchinke maalixxe dhaabuwwaxxe oddo'n sa'eeka arda duuchcha, <verse eid="JER 34:19" /><verse number="20" style="v" sid="JER 34:20" />Naaphi insa'ne'e shiyyo'a halsa'neekixxe anga'n insa'nee sa'isee uwwannon; maali insa'nekinna biniichinkenna allaatettixxe ita kadaan.<verse eid="JER 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 34:21" />«Yihudiinka moyanjo Sedeqiyaasinna isika jalqabuwwa shiyo'a halsaaka naapha, kunninna yannatee ha'no'o lola waale'eeke Baabiloonike moyanjike loliinke mannixxe anga'n ha'no'o sa'isse uwwannon. <verse eid="JER 34:21" /><verse number="22" style="v" sid="JER 34:22" />Kunseten ani insa'nee'e ajajenexxi konne qachchibaa hingaashsha assannon; insa'nenna kone qachcha lolle abindeexxi giirati gunbaan; ani Yihudake bogika qachchuwwa onsennexxi manji hedhabaake assannon; ani Duuchchi Woddik Gootti tenne haaso'eennen.»<verse eid="JER 34:22" /></para>
  <chapter eid="JER 34" />
  <chapter number="35" style="c" sid="JER 35" />
  <para style="s1">Ermiyaasinna Rekabixxe Gosaka Manna</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 35:1" />Yihudaki moyanji Iyyosiyaasik belti Iyyo'aaqemi moyemake baro'n Duuchchi Woddike Goottiki hiyyichchi Eermiyaasi'n dageexxi hiyyee qici, <verse eid="JER 35:1" /><verse number="2" style="v" sid="JER 35:2" />«Rakaabixxe gosake minniba martettexxi insa'ne Duuchchi Woddike Goottike minba'a aaxxe dagi, mitte kuta giddonna e'yishshettexxi woyinetika bulbulo ha'wino'a uwwi.»<verse eid="JER 35:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 35:3" />Tennexxe Eermiyaasika belto Azaaniyaanii'i, Kabaasika belto, dayyuwwa isikanna labbaxxa isixxa oose duuchcha, mittenba Rakaabixxe gosaka manna duuchcha ye'enne. <verse eid="JER 35:3" /><verse number="4" style="v" sid="JER 35:4" />Duuchchi Woddiike Goottike miniba'a insa'ne iyyedagennexxi Hanaanixxe labbaxxe oosexxe kuta giddo e'yishenne; Haanaani kunni Agidaaliyaak belti, Mageniinke manjomman; kuta isixxinna jalqabuwiinxe kuta bira, hulatika heqqanjo Ma'iseyaaka belto Shelumixxe kuta aadi darremman. <verse eid="JER 35:4" /><verse number="5" style="v" sid="JER 35:5" />Rakaabike manni edo wo'ma waaba woyinetika bulbulo shiqishenne; ha'winaaxxa buuduwwanna insa'ne'n uwwennexxi «Konee woyinetika bulbulo ha'we» hiyyenne.<verse eid="JER 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 35:6" />Insa'ne kinni ane'n, «No'o woyinetika bululo ha'wnabo'non; anni no'ooki Iyyonaadaabi Rekaabik belti, no'oo'o, ‹Ha'nonna oose ha'nooxxinna haranga woyoinetika bulubulo ha'witinoqqe'e. <verse eid="JER 35:6" /><verse number="7" style="v" sid="JER 35:7" />Mine ijaadhdhitinnoqqe'e, midha wiilsitinnoqe'e, woyinetika hiddichchonna kaalsitinnoqqe'e; duuchchiin wodda duunkaani giddo hedhdhe malee'e konnechchuwwanaa'n mittelchonna affinoqqe'e; iittate kaddoole konne keessummumma ofoldineeke boga'n qeerrake baro hexxinaan› hiyye'emman. <verse eid="JER 35:7" /><verse number="8" style="v" sid="JER 35:8" />No'o, anni no'ooki Rekaabik belti Iyyoonadabi no'oo'o ajajeexxa duuchcha muuxeennen; no'onna aruwwa no'ooxxi, no'ooxxi labbaxxinna meyyaxxi oosuwwa woyinetika bulbulo ha'wine egennebo'no. <verse eid="JER 35:8" /><verse number="9" style="v" sid="JER 35:9" />He'nannoka mine ijaadhdhinebo'no; woyinetika fichcha, midha huccinannoxxa bakka, yookaan midhatixxa sanne afebe'no. <verse eid="JER 35:9" /><verse number="10" style="v" sid="JER 35:10" />Duunkaani giddo he'nee'naa anni no'ook Iyyoonaadaabi no'oo'o ajajemmaxxa duuchcha heqqne'eennen. <verse eid="JER 35:10" /><verse number="11" style="v" sid="JER 35:11" />Yaane kinni Baabiloonik moyanji Nabukadanatsoor konne boga lolee wodda, no'o weli'aanni weli, ‹Amme Iyyerusaalemi'a baanjo› hinennexxi Baabiloonike loliinke mannanaa'ninna Sooriyake loliinke manninaa'n baanje Iyyerussaalemi dange ofollenne» hine.<verse eid="JER 35:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 35:12" />Duuchchi Woddiki Gootti hiyyichchi Eermiyaasi'n dageexxi: <verse eid="JER 35:12" /><verse number="13" style="v" sid="JER 35:13" />«Yihudakenna Iyyerusaalemike ardiba martetexxi insa'ne'n, Lumoki Duuchchi Woddik Gootti Isira'eelik Mageni, ‹Ha'nota mayee hiyyichcho anka laqqine baratagophphinata?› hiyyi. <verse eid="JER 35:13" /><verse number="14" style="v" sid="JER 35:14" />‹Rekaabik belti Iyyoonadabi ifixxa oose woyinetika bulbulo ha'witabaashsha ajaje; kunni ajajinna heqqemeen; insa'nenna annakee ajajemmemmaxxe'e ta'i qico'n insa'ne woyinetika bulbulo ha'winaabaa. Ha'no kinni ani heggeggeen ha'no'n haaso'eenaani ani'a ajajjendinebaan. <verse eid="JER 35:14" /><verse number="15" style="v" sid="JER 35:15" />Erganjuwwa anka raagole duuchcha higgeggeenni ha'nooba'a ergenne. Insa'nenna ha'nonna, «Mitti mitting elobaake oranaa'n higge; eloxxa yaane asse; ha'nonna annuwwa ha'nokee uwwennake boga'n hexxinaan, wele magenuwwa hordoffina'n isi'a ergatendinoqqe'e» hineen. Ha'no kinni mansha ha'nooxxa anibaa wirri assitinebaan; hiyyennexxanna laqqinebaan. <verse eid="JER 35:15" /><verse number="16" style="v" sid="JER 35:16" />Rekaabika belto Iyoonadabixxi horte kinni insa'neeki anni uwwemmaka seera heqqexxe'een; kunni ardi kinni ani'a ajajemmebaan.›<verse eid="JER 35:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 35:17" />«Tnne'a ani Duuchchi Woddiki Gootti Isira'eelik Mageni, kunseten Yihudake'ninna Iyyerusaalemi hedheeke arda duuchcha'n iyyedagona'a hiyyennaxxa ba'ne duuchcha iyyedagannon; insa'ne ‹ani haaso'enne wodda lanqebaan; ye'enne woddanna heenebaan› » <verse eid="JER 35:17" /><verse number="18" style="v" sid="JER 35:18" />Ookkoneechchi uduma ani Ermiyaasi Rakaabike manna'n «Dada duuchcha ajajaak Duuchchi Woddiki Gootti Isira'eelik Mageni, ‹Ha'no anna ha'nooke Iyyonadabika ajaja heqqexxinemmaxxe'e, isi ha'noo bariisemmaxxa duuchchanna muuxxinemmaxxee, <verse eid="JER 35:18" /><verse number="19" style="v" sid="JER 35:19" />Dada duuchcha ajajaak Duuchchi Woddik Gootti Magen, ha'no Iyyoonadabixxe horte giddii'n ani'a ergatemaak manji duuchchii woddi'a gophemabaan› hiyyeen» hiyyenne.<verse eid="JER 35:19" /></para>
  <chapter eid="JER 35" />
  <chapter number="36" style="c" sid="JER 36" />
  <para style="s1">Baarook Mirqisanjo Maxaafa Ardakee'e Haassoseexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 36:1" />Yihudak moyanji Iyyosiyaasik belti Iyyo'aaqemi moyeexxe sholgaxxe wogga'n Duuchchi Woddike Goottiki hiyyichchi anee'e Ermiyaasi'n dageexxi, <verse eid="JER 36:1" /><verse number="2" style="v" sid="JER 36:2" />«Mirqisanjo maxaafa aaxxettexxi, Isira'eelike ardixxe'e, Yihudake ardixxeenna wele gosa gosake arduwwixxee, ani ate'ni haaso'ate'n ke'eennexxe Iyyosiyaasi moyeexxe yannanaa'n telchi qico'n ani ate'n haaso'enneka hiyyichcho duuchcha isi giddo borreessi. <verse eid="JER 36:2" /><verse number="3" style="v" sid="JER 36:3" />Akimagaada Yihudaki ardi ani insa'ne'n iyyedagonnaa heddennexxa ba'ne duuchcha laqeexxi, mitti mitting elobaake ifike orinaa'ni illeema higaaxxe hexxeen; aninna fuggo insa'nexxanna cubbo insa'nexxa gattowwaal hiyyaannon.»<verse eid="JER 36:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 36:4" />Tennexxee Ermiyaasinna Neeryaka belto Baarookii'i ye'e; Baarookinna Duuchchi Woddiki Gootti haaso'emmaka hiyyichcho duuchcha Ermiyaasi kulaa'na'a mirqisanjo maxaafa'n borresse. <verse eid="JER 36:4" /><verse number="5" style="v" sid="JER 36:5" />Eermiyaasinna Baarooki'n hiyyee qici, «Duuchchi Woddike Goottike Galmi giddi'a e'yabe'noshsha hoyyemennaxxee e'yaabe'non. <verse eid="JER 36:5" /><verse number="6" style="v" sid="JER 36:6" />Tenne'a Duuchchi Woddike Gootike Galmi giddo martettexxi, kulaa'na'a mirqisanjo maxaafa'n borreesitettaka Duuchchi Woddike Goottika hiyyichcho agabo goddoxxe soodachchotixxe barra baroo bukki hiyyeke ardi'a haassessi; ifi ifike qachcuwwinaa'n dageeke, Yihudake ardi duuchchi'a haassessi. <verse eid="JER 36:6" /><verse number="7" style="v" sid="JER 36:7" />Duuchchi Woddiki Gootti konnee arda xixo'aa mufetinna jabaxxe aarenni haaso'eeke kademmaxxee'e, akimagaada ardi kunni Duuchchi Woddika Gootta soodatiyyoti fuggoke me'injinaa'n illeema higaaxxe hexxeen» hiyye. <verse eid="JER 36:7" /><verse number="8" style="v" sid="JER 36:8" />Neeryak belti Baarooki raagichchi Ermiyaasi kulemmaxxa duuchcha asse; Duuchchi Woddike Goottike Galmi giddonna Duuchchi Woddike Goottika hiyyichcho mirqisanjo maxaafinaa'n haassosse. <verse eid="JER 36:8" /><verse number="9" style="v" sid="JER 36:9" />Yihudake moyanjik Iyyosiyaasik belti Iyyo'aaqemi moyeexxe ondixxe woggake sallanike agenjo'n Iyyerusaalemi hedheek ardi duuchchinna Yihudake qachchuwwinaa'n dageek Duuchchi Woddike Gootti edo agabo goddo honsaaxxa yanna lassine. <verse eid="JER 36:9" /><verse number="10" style="v" sid="JER 36:10" />Baarookinna mirqisanjo maxaafa'n Ermiyaasi haaso'a'naa borreessememmaka hiyyichcho, Duuchchi Woddike Goottike Galmixxe alidarrexxe baxxe'n haaroxe hula hiyyendaaxxe Galmixxe baxxe'n hexxeexxe, barsiisanjo Saafaanika belto Gamaariyaxxe kuta giddo hedheexxi ardi duuchchi'a haassosse. <verse eid="JER 36:10" /><verse number="11" style="v" sid="JER 36:11" />Saafaanik akka'i Gamaaryaak belti Mikiyaasi mirqisanjo maxaafanaa'n haassossemeeka Duuchchi Woddike Goottika hiyychcho duuchcha laqeexxi, <verse eid="JER 36:11" /><verse number="12" style="v" sid="JER 36:12" />Mootomatike mini giddo ja'labuwwi duuchchi hedheexxe borreesanjixxe kuttaba'a adadde mare; ookko Elishaama'i borreesanji, Shemayaak belti Delaayya, Akiboorik belti Elnaataan, Saafaanik belti Gamaariyya, Hanaaniyaki belti Sedeeqiyaasinna iittanni welti ja'laabuwwi duuchchi ofo'leemman. <verse eid="JER 36:12" /><verse number="13" style="v" sid="JER 36:13" />Mikiyaasi, Baarooki ardakee'e mirqisanjo maxaafinaa'n haassessaa wodda laqeexxa duuchcha insa'ne'ni kuleechchi uduma, <verse eid="JER 36:13" /><verse number="14" style="v" sid="JER 36:14" />Ja'labuwwi duuchchi Naataanika belto, Shelemiyaamika akka'o, Kuushika obottoro, Yihudii'i, «Ardakee'e haassessitettaka mirqisanjo maxaafa aaxxe daggattoshsha» hina'n Baarookiba ergine; Neeryaki belti Baarookinna mirqisanjo maxaafa aadheexxi insa'nebaa dage. <verse eid="JER 36:14" /><verse number="15" style="v" sid="JER 36:15" />Insa'nenna «Ofoldetexxi no'o'a haassessi» hine. Baarookinna insa'ne'a haasseesse. <verse eid="JER 36:15" /><verse number="16" style="v" sid="JER 36:16" />Insa'nenna konnee hiyyichcho duuchcha lanqeexxi, soda'ati weli'aanni weli uunda'n, Baarooki'i, «No'o konnee hiyyichcho duuchcha moyanjoke'n kullannoken» hine. <verse eid="JER 36:16" /><verse number="17" style="v" sid="JER 36:17" />Ookkonechchi udumanna lenbeexxi, «Konnee hiyyichcho duuchcha hitta borreessa dandeettettexxa no'o'n kuli, Ermiyaasi ate'n kula'naatemma'a?» hine Baarooki'i qorre. <verse eid="JER 36:17" /><verse number="18" style="v" sid="JER 36:18" />Baarookinna «Eeti, isi ane'n hiyyichcho mitti mittik kulaa'na'a, aninna mirqisanjo maxaafa'n qalameti borreessennen» hiyye <verse eid="JER 36:18" /><verse number="19" style="v" sid="JER 36:19" />Ja'labuwwikinna Baarooki'i, «Yoona atinna Ermiyaasi me'itine shoomme; haba hexxineexxa ayyinna ege'noqqe'e» hine.<verse eid="JER 36:19" /></para>
  <para style="s1">Moyanji Mirqisanjo Maxaafa Gubeexxa</para>
  <para style="p">
    <verse number="20" style="v" sid="JER 36:20" />Mirqisanjo maxaafa Elishaama'ii borreesanjiinxe kutta'n uggineechchi uduma moyanji hedheexxe baxxe'n marreexxi kaddeexxa yaane duuchcha iso'ni kulle. <verse eid="JER 36:20" /><verse number="21" style="v" sid="JER 36:21" />Moyanjikinna mirqisanjo maxaafa iyedangaashsha Yihuda erge; Yihudinna borreesanjo Elishaama'ixxe kutta giddi'n mirqisanjo maxaafa aadhe iyyedageexxi moyanjokeenna moyanjii bira uurreemmake ja'labuwwa duuchchi'a haassesse. <verse eid="JER 36:21" /><verse number="22" style="v" sid="JER 36:22" />Sallaniki agenjo kadeemmaxxee moyanji haarsika agenjo sa'issedhammake mine'n giira ha'yita'neexxe laangoxxe booso edi darre ofo'leemman. <verse eid="JER 36:22" /><verse number="23" style="v" sid="JER 36:23" />Yihuudi mirqisanjo maxaafinaa'n sase yookaan shoole borro kuta haassesse bireeshshanni, moyanji haassossemeeka mirqisanjo borressanjixxe haadonni haninaa'n wowwoxxa'ni giira giddi'a darba'emman; konnee qicinni ookkone'e mirqisanjo maxaafa duuchcha gube bire. <verse eid="JER 36:23" /><verse number="24" style="v" sid="JER 36:24" />Moyanjokenna kadi konne hiyyichcho duuchcha laqeek ja'laabuwwi duuchchi riffinna hiyyeba'a; yaadenna ifixxa seemma daddarebaan. <verse eid="JER 36:24" /><verse number="25" style="v" sid="JER 36:25" />Moyanji Mirqisanjo maxaafa gubabaashsha iso'o Elinaatani, Delaayanna Gamaariya kadhantee wodda midde insa'nexxa laqebaan. <verse eid="JER 36:25" /><verse number="26" style="v" sid="JER 36:26" />Moyanjikinna lebeexxi borreessanjo Baarookinna anee'e raagichcho Ermiyaasi'i abinde usuraashsha moyanjika belto Yirehiimi'eeli'i, Aziri'eelika belto, Seraayaanna Abidi'eelika belto Shelemiya'a ajaje; Duuchchi Woddiki Gootti kinni no'oo'o sho'e.<verse eid="JER 36:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 36:27" />Ani Erimiyaasi kula'na'a Baarooki borreessanji, borreesseeka mirqisanjo maxxaafa moyanji gubeechchi uduma Duuchchi Woddike Goottik hiyyichchi ane'n dageexxi, <verse eid="JER 36:27" /><verse number="28" style="v" sid="JER 36:28" />«Wele mirqisanjo aaxxettexxi, Yihudiink moyanji Iyyo'aaqemi gubeeke edike mirqisanjo'n hedhemmaka hiyyichcho duuchcha hana borreessi. <verse eid="JER 36:28" /><verse number="29" style="v" sid="JER 36:29" />Yihudaka moyanjo Iyyo'aaqeminna, ‹Ati Ermiyaasii, dhugaandinni Baabiloonik moyanji daga dagaan; konne boganna bogi giddo hedheeka manjokanna hore biraan «mayee'e hitettexxi borreesitette? Hita'n mirqisanjo maxaafa gubbeetten hiyyi» hiyye. <verse eid="JER 36:29" /><verse number="30" style="v" sid="JER 36:30" />Tenne'a Duuchchi Woddiki Gootti Iyyo'aaqemi'i Yihudake moyanjixxee haaso'a'n, Sanne isixxe giddii'n Daawwitixxe moote'n ofo'laak manji hedhabaan; rensha isik gadhi'a hunnemeexxi barra arishshotike qeniqeninna hashsha qorrake'ni qaqemaan. <verse eid="JER 36:30" /><verse number="31" style="v" sid="JER 36:31" />Isoo'o, oose isixxanna isika ja'labuwwa, assinemmaxxe fuggo insa'nee xixannon; hiyyennexxa laqa gonpheemmaxxee insa'ne'n iyyedagonaa haaso'ennaxxa ba'ne duuchcha insa'ne'ninna Iyyerusaalemi hedheeke Yihudiinke arda'ni iyyedagannon.› »<verse eid="JER 36:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 36:32" />Tenne'a ani Ermiyaasi, wele mirsanjo aadhennexxi Neeryake belto borreesanjo Baarooki'n uwwenne; Baarookinna Yihudiink moyanji Iyyo'aaqemi giirat gubemmake mirqisanjo'n hedhemmaka hiyyichcho duuchcha ani kulaa'naa'a borreesse; iittanni edike maxaafike hiyyichchuwwa'n heddi fakkaataaki weli hiyyichchuwwi lebeme.<verse eid="JER 36:32" /></para>
  <chapter eid="JER 36" />
  <chapter number="37" style="c" sid="JER 37" />
  <para style="s1">Sedeqiyaasi Ermiyaasi'n Shiqisheeka Qortuma</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 37:1" />Baabiloonik moyanji Naabukadanatsoori Iyyosiyaasika belto Sedeqiyaasi'i Yihuda'n moosise; isinna Iyyo'aaqemike belto Ikooniyyaxxe bakka'ni moye.<note caller="-" style="x"><char style="xo" closed="false">37:1 </char><char style="xt" closed="false"><ref loc="2KI 24:17">2 Moy. 24:17</ref>; <ref loc="2CH 36:10">2 Odo. 36:10</ref>. </char></note> <verse eid="JER 37:1" /><verse number="2" style="v" sid="JER 37:2" />Yaane kinni isi yookaan ja'laabuwwi, bogiink ardi ani Ermiyaasi insa'ne'n haaso'enneke Duuchchi Woddike Goottike hiyyichchi'a ajajjemmebaan. <verse eid="JER 37:2" /><verse number="3" style="v" sid="JER 37:3" />Moyanji Sedeqiyaasinna, «Duuchchchi Woddike Gootta no'oke Magenibaa no'o'a soodati» hiyyeexxi Shelemiyaka belto Hukaalinninna qeesichcho Ma'iseyaaka belto Sofooniyaasi'i anibaa erge. <verse eid="JER 37:3" /><verse number="4" style="v" sid="JER 37:4" />Eettenee yanna ani Ermiyaasii usurrii mine'ni usurma gopheennaxxee ardi giddo eeyenneshsha fula'nee higa'ennan. <verse eid="JER 37:4" /><verse number="5" style="v" sid="JER 37:5" />Fare'oonik sannachchi Gibtsee'ni fuleemmaxxee, Iyyerusaalemi buqeemmak Baabiloonik manni tennee laqee wodda Iyyerusaalemi'i waaleexxi me'e. <verse eid="JER 37:5" /><verse number="6" style="v" sid="JER 37:6" />Ookkonechchi uduma Duuchchi Woddike Goottik hiyyichchi anee Ermiyaasi'ni dageexxi, <verse eid="JER 37:6" /><verse number="7" style="v" sid="JER 37:7" />Isira'eelik Duuchchi Woddiki Gootti Mageni, «Anee'e qodhdho'aa anibaa ergitinemmaka Yihudaka moyanjo ‹Ha'no gargaaro'a dagaammak Feri'oonik sannachchi Gibstee'a, ifike bogibaa higaan. <verse eid="JER 37:7" /><verse number="8" style="v" sid="JER 37:8" />Baabiloonik manninna higeexxi konnee qachcha lole abideexxi gubaan› hiyye. <verse eid="JER 37:8" /><verse number="9" style="v" sid="JER 37:9" />Duuchchi Woddik Gootti hiyya'ne qici ‹Baabiloonik manni no'o'o waalee me'an› hitina'n heddinoqqe'e; ifinna sobbinoqqee; insa'ne hinge me'inabaan. <verse eid="JER 37:9" /><verse number="10" style="v" sid="JER 37:10" />Ha'noo lola'neeka Baabiloonka manna duuchcha injifattineenaa, mado'eek manni calli dunkaan giddo gatoolenna midde, iikki manni dageexxi konnee qachcha gubaan» hiyye.<verse eid="JER 37:10" /></para>
  <para style="s1">Ermiyaasi Abidemee Usuremeexxa</para>
  <para style="p">
    <verse number="11" style="v" sid="JER 37:11" />Baabiloonik loliink manni Feri'oonke loliinike manninaa'n kexxeexxa Iyyerusaalemii'n fuleechchi uduma, <verse eid="JER 37:11" /><verse number="12" style="v" sid="JER 37:12" />ani Ermiyaasi anke ardike jeejinaa'n anee geyaaka qoobbo adhdhonnaa, Iyyerusaaleminaa'n Biniyaamike mannike bogibaa me'a ke'enne. <verse eid="JER 37:12" /><verse number="13" style="v" sid="JER 37:13" />Yaane kinni ani Biniyaamike bitumibaa e'yinammaxxe hulaba geyanno wodda, heqqanjuwwiink sooreessi Shelemiyaak belti Hanaaniki akka'i Yuriyaate hiyyemaak, «Ati Baabilooni'a finqilde me'itotta'aaten!» hiyya'n anee abide.<verse eid="JER 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 37:14" />Aninna hiissennexxi, «Waawwo'o! Ani ati hita'etteshsha Baabilooni'a finqile me'onna'atebaan» hiyyenne; Yaane kinni Yuriyaa hiyyennexxa laqa gibeexxi, anee usuree, ja'labuwwiba iyyemare. <verse eid="JER 37:14" /><verse number="15" style="v" sid="JER 37:15" />Ja'labuwwikinna yo'ooshsha aare'e anee gane ke'eexxi ookkone usurriinke mine'n asse'neemmaka borreessanjo Yoonaataanike mine'n anee ussurre. <verse eid="JER 37:15" /><verse number="16" style="v" sid="JER 37:16" />Aninna buttini hundixxe bale giddike minixxe kuta giddo ofo'lannoshsha assemennexxi qeerraxxa yanna ookko turenne. <verse eid="JER 37:16" /><verse number="17" style="v" sid="JER 37:17" />Ookkonechchi uduma moyanji Sedeqiyaasi manjo erge'e mootomatike miniba'a dagannoshsha asseexxi qofiba anee'e iyyemare'e, «Duuchchi Woddiki Gootti ate'n haaso'eechchi hedhee laati?» hiyye anee qore; aninna «Eeti hedheen; ati, Baabiloonike moyanjixxe anga'n sa'issende uwwendatton» hiyyenne.<verse eid="JER 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 37:18" />Ookkoneechchi uduma ani Ermiyaasi moyanjo Sedeqiyaasi'i «Anee usudhdhitineegelchi ate'n, atike ja'labuwwa'ninna yookaan konne arda'n maa balleessa hujannalete? <verse eid="JER 37:18" /><verse number="19" style="v" sid="JER 37:19" />‹Baabiloonik moyanji ha'noonna, konnee boganna lolabaan› hitta'n wabeekumma ati'a haasotteemmaxxi wabeeko haba hexxeta? <verse eid="JER 37:19" /><verse number="20" style="v" sid="JER 37:20" />Ta'atenna kadoole anke gootta moyanjoo ballo'o hiyyaannexxa laqi; maganneten kadhata'annen caqasi; ookko reyonna'a Yoonaataanike borreesanjiinke miniba'a anee'e illeema hissitoxxe'e» hiyyenne.<verse eid="JER 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 37:21" />Moyanji Sedeqiyaasinna, ani Ermiyaasi heqqanjuwwixxe baxxe giddo heqema'n hedha'noshsha qachchi giddii'n daabbo mudde'eemmaqico daabbo ra'issammake mannibaa'n barra barra'ninni mitte mitte daabbo ani'a uwwendaashsha ajaje; Tennexxee ani Ermiyaasi heqanjuwwixxe baxxe'n heqqema'n turenne.<verse eid="JER 37:21" /></para>
  <chapter eid="JER 37" />
  <chapter number="38" style="c" sid="JER 38" />
  <para style="s1">Ermiyaasi Bale Giddo Hunemeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 38:1" />Mataanik belti Sefaaxiyaa, Phasikoorik belti Gadaliyaasi, Shelemiyak belti Huukaali iittanni Melkiyaaki belti Phasikoori ani Ermiyaasi ardake'n haaso'ennexxa duuchcha lanqe; <verse eid="JER 38:1" /><verse number="2" style="v" sid="JER 38:2" />Hiyye haaso'enneqic, Duuchchi Woddiki Gootti, «Konne qachcha'n gataaki duuchchi wolaantichchik, dhukkubik yookaan solo'ik reyaan; konnee booncho waale'e Baabiloonike manniba'a me'ak duuchchi lubbo gataan, hedhotinna hedhaan; <verse eid="JER 38:2" /><verse number="3" style="v" sid="JER 38:3" />Dhugaten, kunni qachchi Baabiloonike moyanjike sannachcha'n sa'issemee uwwemaan; insa'nenna isoo'o abixxinaan» hiyyeexxa insa'ne'n kulenne.<verse eid="JER 38:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 38:4" />Ookonechinni uduma ja'laabuwwi moyanjo, «Kunni manjichchi haaso'a'neexxi yaane, qachchi giddo gateek loliinki manninna ardi duuchchi hophpholaashsha assitaaxxe kaddemmaxxee isi shiyemuun; kunni manjichchi ardakee'e fuggoxxa malee'n eloxxa gaabbaakebaan» hine. <verse eid="JER 38:4" /><verse number="5" style="v" sid="JER 38:5" />Moyanji Sedeqiyaasinna, «Kunniseten isi anga ha'nooxxe'n hedhemmaxxee ani ha'no hitinaaxxa gibe'e assannoxxi mittetinna hexxebaan» hiyye. <verse eid="JER 38:5" /><verse number="6" style="v" sid="JER 38:6" />Tennexxee insa'ne anee aa'neexxi mootomatike minixxe baxxe giddo hexxeexxe moyanjinka belto Melkiyaaxxa wodi'iinxe bale giddo wodarot butti'a wocci assine; Bale giddo dhoqqe malee'e wodi'i hedhemmabaan; dhoqqetinna anee'e liqi'mi assite. <verse eid="JER 38:6" /><verse number="7" style="v" sid="JER 38:7" />Mootomati mini giddo huje afe'eek Tophiyiink manji, Abemeelek, anee'e bale giddo hunneexxa laqe; eettene yanna Moyanji Biniyaamike bitumiba'a e'yinammaxxe hula bira ofo'leemman. <verse eid="JER 38:7" /><verse number="8" style="v" sid="JER 38:8" />Abemeelekinna mootamatike mininaa'n fule mareexxi moyanjo, <verse eid="JER 38:8" /><verse number="9" style="v" sid="JER 38:9" />«Koo gootta moyanjoo, kunni manni wabeekichcho Ermiyaasi'n asseexxi yaane duuchchi fuggoxxen; qachchi giddo indaachchi gophemeexxe yanna'n solo'ik reyaashsha bale giddo isoo hunne'een» hiyye. <verse eid="JER 38:9" /><verse number="10" style="v" sid="JER 38:10" />Okkoonechinni udumi'a Moyanji Abemeeleki'i Tophiyiichcho, «Kabaa'n sase tomme manna adhdhite me'ite'e, reyebaang Ermiyaasii waabeekichcho bale giddii'n fulchi» hiyye ajaje. <verse eid="JER 38:10" /><verse number="11" style="v" sid="JER 38:11" />Tennexxee Abemeelek manna aadheexxi mootummatike miyike mini hunda hexxeexxe kuta giddo mareexxi, mudde'eexxe seemmuwwaka shurqa ookoo'n aadheexxi Ermiyaasiba'a bale giddi'a wodarot butti'a wocci asse. <verse eid="JER 38:11" /><verse number="12" style="v" sid="JER 38:12" />Tophiyiichchi Abemeelek anee'e, «Wodaro atee'e woxxabaashsha tenne muddexe seemaka curqa bobati hunda uggudhdhi» hiyye. Aninna isi hiyyemmashshanni assenne. <verse eid="JER 38:12" /><verse number="13" style="v" sid="JER 38:13" />Insa'nenna anee'e wodarot iimi'a harkinse bale giddii'n fulchinee'naa mootommatike minixxe heqqanjuwwixxe kuta giddo heqqemenne.<verse eid="JER 38:13" /></para>
  <para style="s1">Sedeqiyaasi Higgeen Ermiyaasii Gorso'a laqedheexxa</para>
  <para style="p">
    <verse number="14" style="v" sid="JER 38:14" />Moyanji Sedeqiyaasi anee Ermiyaasiba manjo ergeexxi Duuchchi Woddike Gootike galmixxe sakkaxxe hulaba anee'e iyyedangaashsha asseexxi, «Mitte yaane atee'e qoraa'ennen, ittanna anee'e shoxxoxxe» hiyye. <verse eid="JER 38:14" /><verse number="15" style="v" sid="JER 38:15" />Aninna Sedeqiyaasi'i, «Dhuga haaso'onnole anee'e shiya waaldabexxon; Gorsennelenna gorsa anka adhitabexxon» hiyyenne. <verse eid="JER 38:15" /><verse number="16" style="v" sid="JER 38:16" />Moyanji Sedeqiyaasi, «Ani hedhot hedhono'a hedho uwweeke Duuchchi Woddike Goottixxa! Atee shiyabe'non; shiyaake mannixxe anga'inna sa'issenna atee uwwabe'non» hiyya'n sho'ik kakate. <verse eid="JER 38:16" /><verse number="17" style="v" sid="JER 38:17" />Okkonechchinni uduma ani Sedeqiyaasi'n «Lumoki Duuchchi Woddiki Gootti Isira'eelik Magen, ‹Ati Baabiloonike moyanjuwike ja'laabuwwi'a anga uutottole, lubbo gattatton; kunni qachchinna gubatabaan; atinna atik mini hadi hedhoti hexxinaan. <verse eid="JER 38:17" /><verse number="18" style="v" sid="JER 38:18" />Baabiloonike moyanjiwike ja'laabuwi'a anga uwwa gophphottole kinni kunni qachchi Baabiloonike mannixxe anga'n sa'isseme uwwemaan; insa'nenna isoo'o gunbaan; atinni umi ating insa'neexxe anganaa'n fuldabexxon› hiyya'neen» hiyyenne. <verse eid="JER 38:18" /><verse number="19" style="v" sid="JER 38:19" />Moyanji Sedeqiyaasinna «Ani Baabiloonik manni no'o giddii'n finqile Baabilooni'a me'emmake no'ooke Ayihudiinke mannixxe anga'n anee sa'isse uwwe'naa'a insa'ne ane'n gacifantuun hiyya'nee sodaata'ennen» hiyya'n ane'n hiisse haaso'e.<verse eid="JER 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 38:20" />«Meeco'o insa'ne atee'e sa'issine uunabaan» hiyyeexxi Ermiyaasi iso'ni hiisse haaso'e. «Ani ate'n kula'anneka konnee Duuchchi Woddike Goottike hiyyichchi calli'a ajajemi; ookone wodda eloxxi ati'a kaddaan; lubbotanna gattatton. <verse eid="JER 38:20" /><verse number="21" style="v" sid="JER 38:21" />Anga uwwa gibbottole kinni Duuchchi Woddiki Gootti ane'ni leellisheexxe yaane hexxeen. <verse eid="JER 38:21" /><verse number="22" style="v" sid="JER 38:22" />Tinninna, Yihudake mootumatike mine'ni gattemmaxxi melaalle duuchchi Baabiloonike ja'laabuwwiba'a adhdhendaan; iitti melaallenna atee'e:</para>
  <para style="q1" vid="JER 38:22">« ‹Ikki addettettak atik ja'laabuwwi,</para>
  <para style="q2" vid="JER 38:22">atee'e dedhise injifateen;</para>
  <para style="q1" vid="JER 38:22">Lekka atixxi dhoqqete'n lixxeen,</para>
  <para style="q2" vid="JER 38:22">jaaluwwi atikinna atee'e walee me'een› hitaan.<verse eid="JER 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 38:23" />«Aruwwa atixxinna oose atixxi duuchcha Baabiloonike manniba'a adhdhendaan; atinna umi atingi Baabiloonike moyanjixxe anga'n ibbatto malee'e anga insa'nexxenaa'n fuldabexxon; kunni qachchinna giirati gubataan» hiyyenne.<verse eid="JER 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 38:24" />Sedeqiyaasinna Ermiyaasii'i, «Tennee haasonnexxa yaane ayyinna afaak hedhoqqe'e; kadagophphoole shiyendaton. <verse eid="JER 38:24" /><verse number="25" style="v" sid="JER 38:25" />Ja'laabuwwi ani atinni welt haaso'ennexxa laqee atiba dageexxi, ‹Moyanjoke'n maa hitettexxa, moyanjikinna ate'n maa hiyyeexxa shoxxebexxong no'o'n kuli; kula gophphottole atee shinnanon› hinoole, <verse eid="JER 38:25" /><verse number="26" style="v" sid="JER 38:26" />ati ‹Ookko reyabe'noshsha Yoonaataanike mine'n anee'e illeema hissitoxxe hiyya'n moyanjo kadhata'anan› hite insa'ne'n kuli» hiyye. <verse eid="JER 38:26" /><verse number="27" style="v" sid="JER 38:27" />Ja'laabuwwi duuchchi aniba dageexxi anee'e qore; aninna moyanji kulona'a ajajemaxxa duuchcha insa'ne'n kulenne; aninna moyanjik welti haaso'eneka haaso'a laqeeki mittikinna hedhagophemaxxee okonechcinni udumi'a anee'e yaansisebaan. <verse eid="JER 38:27" /><verse number="28" style="v" sid="JER 38:28" />Aninna Iyyerusaalemi abidendeexxe barraqico'n mootomatike minixxe baxxe'n heqanjuwwinke mini giddo heqema'n offolenne.<verse eid="JER 38:28" /></para>
  <chapter eid="JER 38" />
  <chapter number="39" style="c" sid="JER 39" />
  <para style="s1">Naaphiinxe Anga'n Iyerusaalemixxa Iba</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 39:1" />Yihudiink moyanji Sedeqiyaasi moyeexxe sallanixxe woggake tommike agenjo'n, Baabiloonik moyanji Nabukadanatsoori ifika sannachcha duuchcha bukki assedhe dageexxi Iyyerusaalemi'i buqe. <verse eid="JER 39:1" /><verse number="2" style="v" sid="JER 39:2" />Sedeqiyaasi moyeexxe tommenna mittixxe woggake sholgake agenjixxe sallanixxe barra'n qachcha buqemmaki manni qachchiinka dalla'a enqe. <verse eid="JER 39:2" /><verse number="3" style="v" sid="JER 39:3" />Iyyerussaalemi qachchi abidemeexxa yanna Baabiloonike moyanjik Ja'laabuwwi duuchchi: Saamigar naabo Nergaali, Shaaretser, umiink ajajalli Naboserisekimi, sooreessi ja'laabi Eergeeli Saraasarinna iittanni weli Baabiloonike moyanjk ja'laabuwwi duuchchi e'yeexxi oddotixxe bitumixxe baxxe'n bakka abixxe ofo'le. <verse eid="JER 39:3" /><verse number="4" style="v" sid="JER 39:4" />Yihudiink moyanj Sedeqiyaasinna isik loliinki manni duuchchi insa'nee anfee wodda hashshati baanje moyanjiinke hiddichchiinke fichchi darree'n lame dalla'ixxe oddonaa'n qachchi giddi'n fule Araba'a me'ine.<verse eid="JER 39:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 39:5" />Yaane kinni Baabilooniki loliinki manni udumii'n hordofe insa'ne shorre'e Iyyaarikoke diida'n Sedeqiyaasi; dhaqqabe abideexxi Hamaatike boga'n hedheeke Riblake qachcha'n Nabukadanatsoori'i Baabiloonike moyanjiba iyyemarre; okonna murte iso'n murende. <verse eid="JER 39:5" /><verse number="6" style="v" sid="JER 39:6" />Baabiloonik moyanji konne Riblake qachcha'n Sedeeqiyaasixxa labbaxxa oose Sedeqiyaasi uda'naa'n insa'nee gorra'e; Yihudiinka Ja'laabuwwa duuchchanna shiye. <verse eid="JER 39:6" /><verse number="7" style="v" sid="JER 39:7" />Ookkoneechchi udumi'a Sedeqiyaasixxa ille giddi'n fulchiseexxi, Baabilooni'a iyemarsiiso'a Sageetotike haachchabinni usursiise. <verse eid="JER 39:7" /><verse number="8" style="v" sid="JER 39:8" />Baabilooniki manninna Sedeqiyaasika mootummatika minenna ardiinka minne giirat gube; Iyyerusaalemika dalla'anna diige. <verse eid="JER 39:8" /><verse number="9" style="v" sid="JER 39:9" />Baabiloonka moyanjo heqqamake heqqanjuwwik ajajalli Nabuzardaani qachchi giddo gatemaka arda duuchchanna edisexxi anga isi'a uwwemaka duuchchanna mittenba booji'eexxi Baabiloni'a adhdhe me'e. <verse eid="JER 39:9" /><verse number="10" style="v" sid="JER 39:10" />Karra affeebaxxa hiyyeeyye kinni kunni moyanjiinke heqqanjuwwik ajajalli Nabuzardaani Yihudiinke boga'ninni waaleexxi woyinetike hiddichchika fichchanna huccinaaka boga insa'ne'a uwwe.<verse eid="JER 39:10" /></para>
  <para style="s1">Ermiyaasixxa Tikensha</para>
  <para style="p">
    <verse number="11" style="v" sid="JER 39:11" />Baabiloonik moyanji Nabukanatsoori ifike heqqanjuwwika ajajallo Nabuzerdaanii'i Ermiyaasixxee ajajje'e, <verse eid="JER 39:11" /><verse number="12" style="v" sid="JER 39:12" />«Marte Ermiyaasii'i ifibaa aaxxettexxi eloxxen isoo uudi; haseexxa duuchcha isi'a muuxi malee'e isoo miitoxxe'e» hiyye. <verse eid="JER 39:12" /><verse number="13" style="v" sid="JER 39:13" />Tennexxee moyanjike heqqanjuwwiki ajajalli Nabuzerdaani, ja'laabuwwiink sooreessi Nabusheezibaani, Ja'laabuwwiinki umi Nergaali Sharetseri, iittanni weli Baabiloonike moyanjik Ja'laabuwwi duuchchi, <verse eid="JER 39:13" /><verse number="14" style="v" sid="JER 39:14" />manjo ergineexxi anee'e Ermiyaasii'i mootummatike minixxe baxxe'ni heqqanjuwwiinxe kuta giddii'n fulchinseexxi Safaaniki aka'i Ahiqaamik belti Godoliyaasi anke miniba iyyemarro'a anee'e maganne iso'n uune; aninna arda anki giddo ofo'lenne.<verse eid="JER 39:14" /></para>
  <para style="s1">Abemeeleki'a Uwendeexxa Addachchiisa</para>
  <para style="p">
    <verse number="15" style="v" sid="JER 39:15" />Ani Eermiyaasi mootummatike minixxe heqqanjuwwixxe baxxe'n usurii mine hedhenna wodda Duuchchi woddiki Gootti hiyyichchi ane'n dageexxi, <verse eid="JER 39:15" /><verse number="16" style="v" sid="JER 39:16" />anee'e «Tophiyiichcho Abemeelekiba martettexxi Dada Duuchcha ajajak Duuchchi Woddiki Gootti Isira'eelik Magen, ‹Konne qachcha'n qananumate kadebaak idagonna'a hiyyenexxa ba'ne muuxannon; ookkone wodda atixxi ille uuddaa'naa'a tinni muxxendaan. <verse eid="JER 39:16" /><verse number="17" style="v" sid="JER 39:17" />Ani Duuchchi Woddik Gootti kinni atee'e eettene barra gatisannon; sodaattatoke mannixxe anga'ninna sa'isende uwwendabexxon; <verse eid="JER 39:17" /><verse number="18" style="v" sid="JER 39:18" />atee anjirannoni; ane'n addattettaxxee'e baaje'e lubbo hexxatto malee'e wolaantichchoke'n rertabexxon; tenne'e haaso'eneke ante Duuchchi Woddike Goottan› hiyyi» hiyye.<verse eid="JER 39:18" /></para>
  <chapter eid="JER 39" />
  <chapter number="40" style="c" sid="JER 40" />
  <para style="s1">Gedaaliyanni Welti Ermiyaasixxa Hedha</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 40:1" />Baabilooinike moyanjike heqqanjuwwik ajajalli Nabuzardaani anee'e Ermiyaasii'i Iyyerusaalemi'ninna Yihudii'ni Baabiloonibaa booji'eme me'emmake manni duuchchi giddo Raama haachchabik usuremee'na'a afeexxi tikise; ookkonechchi uduma Duuchchi Woddiki Goottik hiyyichchi ane'n dage. <verse eid="JER 40:1" /><verse number="2" style="v" sid="JER 40:2" />Mootummatike mine heqqanjuwwi ajajalli anee qofinni aadhe me'exxi hiyyee qici, «Duuchchi Woddiki Gootti atiki Mageni konne boga'n tinne ba'ne geltaaxxa haaso'een. <verse eid="JER 40:2" /><verse number="3" style="v" sid="JER 40:3" />Duuchchi Woddiki Goottinna tenneen idage; haaso'emmashshanni asse. Tinni duuchchi kaddeelchi ha'no Duuchchi Woddike Gootta'n cubbo hujjinemmaxxeenna isi'a ajajema gophphinemmaxxeeteni. <verse eid="JER 40:3" /><verse number="4" style="v" sid="JER 40:4" />Kunse telcho aniga atixxenna'n haachchaba tikeene; eetotole aninni welti Baabilooni'a dage'naa ati'a hasisaaxxa assanon; gibbotole kinni daggoxxe; bogi duuchchi anga atixxe'n hedhemmaxxe'e eeteteba'a me'i» hiyye. <verse eid="JER 40:4" /><verse number="5" style="v" sid="JER 40:5" />Ani hiisichcho uwwebe'nong Naabuzeredaan lebeexxi, «Baabiloonik moyanji Yihudaka qachchuwwa galchaasa hariiremake Saafaanike aka'o Ahiqaamika belto Gadaliyaasiba'a illeema hige; isinni welti ardiinxe oddo'ni ofo'li; yookaan ani'a elaan hitato boonchiba'a me'i» hiyye. Ookkoneechchi uduma heqqanjuwwink ajajalli gala'atakanna uwwa ani'a uwweexxi me'annoshsha asse. <verse eid="JER 40:5" /><verse number="6" style="v" sid="JER 40:6" />Aninna Ahiqaamik belti Gadaliyaasi hedheeba Mitsiphaa me'ennexxi isinni welti bogi giddo gatemmake ardi giddo ofo'lenne.<verse eid="JER 40:6" /></para>
  <para style="s1">Godoliyaasixxa Shiyensha</para>
  <para style="r">(<ref loc="2KI 25:22-24">2 Moy. 25:22-24</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="JER 40:7" />Yihudik, Baabilooni'a boji'emebaak ja'laabuwwinna loliinki manni duuchchi, Baabilooni'a booji'emebaake bogi giddo gateeka hiyyeessa labballo, melaallenna oose'e moye galcho'a Baabiloonik moyanji Ahiqaamika belto Godoliyaasi'i hariire baalle uwweexxa lanqe; <verse eid="JER 40:7" /><verse number="8" style="v" sid="JER 40:8" />tennexxee Nataaniyaak belti Isimaa'eeli, Qaareehaxxi labbaxxi oose Yohaanaaninna Yoonaataani, Tanihuumeetiki belti Seraaya, Nexofawichcho Eefaayixxi labbaxxi oose, Maa'ikamichiink belti Yazaanyaani inasa'neke manni duuchchinni welti Mitsiphaa Gadaliyaasiba marre. <verse eid="JER 40:8" /><verse number="9" style="v" sid="JER 40:9" />Safaaniki aka'i Ahiqaamik belti Godoliyaasi kakateexxi insa'neninna insa'neke manna'n hiyye, «Baabiloonike manni'a hunda gala sodaatinnoqqe; ookkone bogi giddo ofoldine'e Baabiloonike moyanji'a ergattemme; yaane ha'no'a eldaan.<note caller="-" style="x"><char style="xo" closed="false">40:9 </char><char style="xt" closed="false"><ref loc="2KI 25:22-24">2 Moy. 25:22-24</ref>. </char></note> <verse eid="JER 40:9" /><verse number="10" style="v" sid="JER 40:10" />Ani umi anigennin no'ooba daga'neeke Baabiloonke mannike moyanji edo ha'no'a uurronnaa, Mitsiphaa ofo'lannon; ha'no kinni woyine, ejersiinxa zayite, wele hiddichchuwwiixxa gumma hucce; assexxinamake mi'yuwwi giddonna tuu'le; abixxitine'e abixitinemmange qachchuwwa'n ofo'le» hiyye. <verse eid="JER 40:10" /><verse number="11" style="v" sid="JER 40:11" />Mo'aabike, Amoonike, Eedoomikenna wele boguwwa duuchcha'ni hedhemmak Yihudiink manni duuchchi, Baabiloonik moyanji manna Yihudake boga'ni gatiseexxanna insa'ne'e galcho'a Saalfika aka'o Ahiqaamik belto Godoliyaasi harireexxa lanqe. <verse eid="JER 40:11" /><verse number="12" style="v" sid="JER 40:12" />Tennexxee Duuchchiing xexxeeremme he'nammake bogi duuchchi'naa'n Yihudake bogibaa illeema hinge; Mitsiphaa hedheeke Godoliyaasiba'a dange; woyinetanna wele hiddichchuwwixxa gumma yo'oshsha assine tuulle.<verse eid="JER 40:12" /></para>
  <para style="s1">Godoliyaasixxa Shiyensha</para>
  <para style="r">(<ref loc="2KI 25:25-26">2 Moy. 25:25-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JER 40:13" />Qaareyaamik belti Yohaanaaninna anga Baabilooni'a uwweemmabaak loliink ja'laabuwwi duuchchi Mitsiphaa Godoliyaasiba'a dageexxi, <verse eid="JER 40:13" /><verse number="14" style="v" sid="JER 40:14" />«Amoonike mannik moyanji Ba'aalisi atee'e shiyo'a Naataaniyaka belto Isimaa'eelii ergeexxa egendebexxoo?» hine qorre. Ahiqaamik belti Godoliyaasi kinni hineexxa adhdha gibe. <verse eid="JER 40:14" /><verse number="15" style="v" sid="JER 40:15" />Qaareehak belti Yohaanaani, «Ayyinna ege'nebaang Naataaniyaka belto Isimaa'elii mare shiyo; baaje atiba'a dageek Yihudiink manni xexxeeremashsha, Yihudi giddo gateekinna ba'aashsha mayee'e atee shiya?» hiyyeexxi Mitsiphaa Godoliyaasi'n sho'ik kule. <verse eid="JER 40:15" /><verse number="16" style="v" sid="JER 40:16" />Ahiqaamik belti Godoliyaasi kinni Qaareehaka belto Yohaanaani'i «Ati Isimaa'eeli'i uuddaaxxen haasota'etexxi duuchchi dhugaate kadda gophphemmaxxe tenne yaane assitoxxe'e» hiyye.<verse eid="JER 40:16" /></para>
  <chapter eid="JER 40" />
  <chapter number="41" style="c" sid="JER 41" />
  <para style="p">
    <verse number="1" style="v" sid="JER 41:1" />Moyanjiinke mini hado kadeek moyanjiinke ja'laabuwwi giddii'n mitti, Elishaama'ike beltik belti Naataaniyak belti Isima'eeli torbake agenjo'n, tomme manninni welti Mitsipha'a Ahiqaamika belto Godoliyaasibaa dage; ookkonna mittenba offolleexxi ita inda'neenge'n, <verse eid="JER 41:1" /><verse number="2" style="v" sid="JER 41:2" />Naataaniyak belti Isimaa'eelinna tommi isinni welti hedhemmak manni ke'eexxi Baabiloonik moyanji boga galchaashsha hariiremmaka Saafaanika aka'o Ahiqaamika belto Godoliyaasi'i wolaantichchik shinne. <verse eid="JER 41:2" /><verse number="3" style="v" sid="JER 41:3" />Isima'eeli Mitsiphaa Godoliyaasin welti hedhemmaka Ayihudiinka manna duuchcha, ookkonna hedhemmaka Baabiloonika loliinka manna shiye.<note caller="-" style="x"><char style="xo" closed="false">41:3 </char><char style="xt" closed="false"><ref loc="2KI 25:25">2 Moy. 25:25</ref>. </char></note><verse eid="JER 41:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 41:4" />Godoliyaasi shiyemeexxa gorsa ayyinna ege'nebaang, <verse eid="JER 41:4" /><verse number="5" style="v" sid="JER 41:5" />saddeeti tommi manni areeda haaxxeexxi yaade'xxa ege'nishatee seemma ifi ifixxa dadarexxi biso ifi hoqe'neexxi, midhatika tolchanna hixaana abixxineexxi Sekemii'n, Seelo'ninna Semaariyaanaa'n Duuchchi Woddike Goottike miniba'a dange. <verse eid="JER 41:5" /><verse number="6" style="v" sid="JER 41:6" />Naataaniyak belti Isimaa'eeli insa'nee qophedha Mitsiphaa'n fule oodha'n me'a'n afemeexxi insa'ne'e, «Ahiqaamika belto Godoliyaasiba'a amme» hiyye. <verse eid="JER 41:6" /><verse number="7" style="v" sid="JER 41:7" />Insa'ne qachchi giddi'a e'yinee wodda, Yonataanik belti Isimaa'eelinna isinni welti hedhemmaki manni insa'ne'e shiyeexxi wode'e cammammaxxe bale giddo hunne. <verse eid="JER 41:7" /><verse number="8" style="v" sid="JER 41:8" />Ookkone shiyemeeke saddeeti tommi manninni welti hedhemmaki tommi manni kinni Isima'eeli'i, «No'ooke fichchi giddo sho'neennexxi dinnenna so'i, ejersiinxi zayitenna malebi hedhemmaxxee ballo'o no'o'o shiltoxxe'e!» hiyye; isinna insa'nee wele manninni shiyebaang waale. <verse eid="JER 41:8" /><verse number="9" style="v" sid="JER 41:9" />Isima'eeli shiyeeke mannika rensha giddo hunemmaxxinna Godoliyaasinna shiyemmake mannika rensha giddo hunemmaxxi itti wode'e cammamaxxi bale moyanji Aasa Isira'eelika moyanjo Ba'isha sodaatemmaxxe'e isoo ifi iimii'ni hoyyedhate hujisa'emaxxeman; tenne bale'n Yonataank belti Isima'eel rensha wonshe. <verse eid="JER 41:9" /><verse number="10" style="v" sid="JER 41:10" />Isima'el Mitsiphaa gateeka arda duuchcha booji'e; insa'nenna moyanjik meyyaxxa oosenna weli ooko'o gateki manni duuchchi Nabuzerdaan moyanjo Baabiloonike looliinke mannik ajajalli Ahiqaamika belto Godoliyaasi'i hariire'e insa'ne galcho'a asse'emman; Naataaniyak belti Isimaa'eel konne manna duuchcha booji'eexxi Amoonike mannike bogiba'a foofo'a ke'e. <verse eid="JER 41:10" /><verse number="11" style="v" sid="JER 41:11" />Qaareehak belti Yohaanaaninna isin welti hedhemak loliinke mannika ja'laabuwwi duuchchi Yohanaaniki belti Isima'eeli assexxa fuggo duuchcha lanqeexxi, <verse eid="JER 41:11" /><verse number="12" style="v" sid="JER 41:12" />Yohanaanika belto Isima'eeli'i lollo'a insa'neeka loliinka manna duuchcha adhdhine me'ine'e Gaba'oon hedheeke lumoke baleessi bira dhaqanbe. <verse eid="JER 41:12" /><verse number="13" style="v" sid="JER 41:13" />Isimaa'eeli abide adhdhe me'emak manni duuchchi, Qaareehaka belto Yohaanaaninna isinne welti hedhemmaka loliinka ja'laabuwwa unde wodda gamande. <verse eid="JER 41:13" /><verse number="14" style="v" sid="JER 41:14" />Isimaa'eeli Mitsiphaa'n booji'e adhemak manni duuchchi angii'n fulchedhe Qareyake belto Yohanaanba'a me'e. <verse eid="JER 41:14" /><verse number="15" style="v" sid="JER 41:15" />Naataaniyak belti Isima'eeli kinni welti hedhemake saddeeta manni welti Yohaanaanixxe anganaa'n fulchedhe; Amoonike mannibaa baaje. <verse eid="JER 41:15" /><verse number="16" style="v" sid="JER 41:16" />Qareyank belti Yohaanaaninna isin welti hedhemak looliink jaa'laabuwwi duuchhi Naataaniyak belti Isimaa'eel, Ahiqaamika belto Gadaliyaasi'i shiyeechchi uduma Mitsiphaa'n boji'eena'a gatemaka manna hissineexxi adhdhine me'ine; kunni manni loliinke manna, melaalle oosetaanna Gaba'ooni'n aadhe dagemake mootomatike moinike ja'labuwwaman. <verse eid="JER 41:16" /><verse number="17" style="v" sid="JER 41:17" />Insa'nemenna ooko'n ke'neexxi Gibtse'e me'ine Beeteliheem bira hedheeke Kimihaami hiyyemake booncho'n offolle. <verse eid="JER 41:17" /><verse number="18" style="v" sid="JER 41:18" />Insa'ne'e Gibtse'a me'inemalchi Baabiloonike manninaa'ni baanje fullo'ateman. Insa'ne Baabiloonika manna soda'ante'emalchi Naataaniyak belti Isima'eeli Baabiloonik moyanji boga galcho'a haariire moyaashsha asseeka Ahiqaamika belto Godoliyaasi'i shiyemaxxeten.<verse eid="JER 41:18" /></para>
  <chapter eid="JER 41" />
  <chapter number="42" style="c" sid="JER 42" />
  <para style="s1">Ermiyaasi Mageno Soodataashsha Ardi Iso'o Laqeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 42:1" />Qaareehak belt Yohaanaani, Hoshayaak belti Azaaryaasini mitteba loliinki jaa'labuwwi duuchchi ittanni ardi duuchchi shixxokenaa'n lumokiqico'n shiqeexxi, <verse eid="JER 42:1" /><verse number="2" style="v" sid="JER 42:2" />anee'e hineqic, «Atee'e kadhanta'enexxa yaane no'o'a assi Duuchchi Woddika Gootta atike Magenba'a no'o'a soodati; edo no'o heddo mannamman ta'a kinni uddaatteshshanni gante'ennek heenoken. <verse eid="JER 42:2" /><verse number="3" style="v" sid="JER 42:3" />Duuchchi Woddiki Gootti atik Magen haba'a me'innannoxxa, maa assinnannoxxa no'o'n kulaashsha no'o'a soodati» hine. <verse eid="JER 42:3" /><verse number="4" style="v" sid="JER 42:4" />Aninna insa'nee'e «Kadduun, hitineeshshanni Duuchchi Woddika Gootta ha'nooke Mageniba'a soodatannon; is ane'n hiyyeexxa duuchchanna mittetanna gatisebe'nong ha'no'n kulannon» hiyye hisse haaso'ene. <verse eid="JER 42:4" /><verse number="5" style="v" sid="JER 42:5" />Insa'nenna ane'n hineeqic, «Duuchchi Woddiki Gootti atik Magen ati darree'n no'o'a hiyyaaxxa duuchcha muuxagonphonnole Duuchchi Wodik Gotti umi isingenin no'o'n dhugaatixxenna addatendeexxe naqaashe kaddowwaal. <verse eid="JER 42:5" /><verse number="6" style="v" sid="JER 42:6" />Duuchchi Woddike Gootta no'oke Mageni'a ajajjemee'na'a eloxxi no'a kaddo'a, yaane no'o'a eldonna elannagophoole atee'e isiba'a erginenneka Duuchchi Woddika Gootta Mageno no'okee ajajjemmannon» hine.<verse eid="JER 42:6" /></para>
  <para style="s1">Sooddachcho Ermiyaasixxee'e Duuchchi Woddike Goottika Hissichcho</para>
  <para style="p">
    <verse number="7" style="v" sid="JER 42:7" />Tomme barra uduma Duuchchi Woddik Goottik hiyyichchi ane'n dage; <verse eid="JER 42:7" /><verse number="8" style="v" sid="JER 42:8" />tennexxee Qaareehaka belto Yohaanaaninna isinni welti hedhemmaka loliinka ja'laabuwwa duuchcha ittanni arda duuchcha shixxokenaa'n lumokiqico'n hedheeka ye'ennexxi: <verse eid="JER 42:8" /><verse number="9" style="v" sid="JER 42:9" />Insa'ne'e hiyyeneqic, «Kadha ha'nooxxa isi edo shiqishona'a isiba'a anee'e ergitinemaki Isira'eelk Duuchchi Woddiki Gootti Mageni: <verse eid="JER 42:9" /><verse number="10" style="v" sid="JER 42:10" />‹Ha'no konne boga'n ofoldinoole ha'noo'o ijaaranno malee diigabe'no; ha'noo'o kaasanno malee goshabe'no; ba'ne ha'no'n iyyedagennexxee ani yaadeennen. <verse eid="JER 42:10" /><verse number="11" style="v" sid="JER 42:11" />Ta'a konne sodaatina'neka Baabiloonika moyanjo sodaatinoqe'e; ani ha'no welti hedhenaxxee'e ha'no'o anjirannon; anga isixxenaa'n ha'no'o fulchannon; iso'o sodaatinnoqe'e. <verse eid="JER 42:11" /><verse number="12" style="v" sid="JER 42:12" />Isi ha'no'a owe'eexxi boga ha'nokiba'a ha'no hisaashsha ani ha'no'a o'wannon.›<verse eid="JER 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 42:13" />«Ha'no kinni ‹Konne boga'n ofolabe'no› hitineexxi Duuchchi Wooddike Gootta ha'noke Magen'a ajajema gibbinoole, <verse eid="JER 42:13" /><verse number="14" style="v" sid="JER 42:14" />ittanni kinni, ‹No'o bagedo unda'be'noba yookaan malagata bagediinxe odoka lanqabe'nobanna soloi'winabe'noba Gibtsee boga me'inee ookko he'nannon› hitinoole, <verse eid="JER 42:14" /><verse number="15" style="v" sid="JER 42:15" />ha'no koo, Yihudiinke boga'n hafe gatineeke arada, Duuchchi Woddiki Gootti hayya'nexxa laqqe. Dada Duuchcha ajajaak Duuchchi Woddiki Gootti Isira'eelki Mageni: ‹Gibtsee'a me'atee'e mudhdhitine'e ookko hexxino'a me'itinoole, <verse eid="JER 42:15" /><verse number="16" style="v" sid="JER 42:16" />Sodaatinemake wolaantichinni ookkonni afendina; isixxee culphisinemmak solo'i Gibtsee qico'n ha'noo hordofe dagaan, ookkonna rertinaan. <verse eid="JER 42:16" /><verse number="17" style="v" sid="JER 42:17" />Gibtsee'a me'e'e ookko hedho'a mudhdheek duuchchi wolaantichik, solo'ikinna dhukubik reyaan; ani insa'ne'n idaganoxxe ba'nenaa'n mittikinna midde gataak yookaan isenaa'n fulaak hedhabaani› hiyye. <verse eid="JER 42:17" /><verse number="18" style="v" sid="JER 42:18" />Dada Duuchcha ajajaak Duuchchi Woddiki Gootti Isira'eeliki Magen: ‹Mufe anxinna bala anxi Iyyerusaalemi hedhammake duuchcha'n lolaatemmashanni, ittani Gibtsee e'yitinaa wodda bala anxi ha'no'n lolaataan; ha'nonna ce'mendinaake, uunde henkekki hinaake, yowwichchinkenna oso'lchchiinke beessisa kaddinaan; konne boonchonna langaxxa uuddinabaan.›<verse eid="JER 42:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 42:19" />«Ha'no koo Yihudiinke boga'n gatineexxe hafe Duuchchi Woddiki Gootti, ‹Gibtsee'a me'itinoqqe'e› ha'noo hiyyeeni; aninna telcho ha'noo'o xexxe'achchiisaannexxa adda ege'ne: <verse eid="JER 42:19" /><verse number="20" style="v" sid="JER 42:20" />‹Duuchchi Woddike Gootta Mageni no'okiba'a no'o'a soodati; isi ate'n hiyyeexxa duuchcha no'o'n kuli; no'onna isi'a ajajemanoni› hitine'e Duuchchi Woddike Gootta Mageno ha'nookibaa anee ergitinee wodda hedho ha'nooxxa balleessaake dedha hujjineen. <verse eid="JER 42:20" /><verse number="21" style="v" sid="JER 42:21" />Kunniseten ani telcho ha'non kulleneni; ha'no kinni Duuchchi Woddiki Gootti ha'nooki Magen anee ergee'naa ha'no'n kullennexxa duuchcha ajajendinebaan. <verse eid="JER 42:21" /><verse number="22" style="v" sid="JER 42:22" />Yoona me'itineexxi hexxino'a hasina'neeke booncho'n bagediki, solo'ikinna dhukkubik rertinaaxxa ege'ne» hiyyene.<verse eid="JER 42:22" /></para>
  <chapter eid="JER 42" />
  <chapter number="43" style="c" sid="JER 43" />
  <para style="s1">Ermiyaasixxa Gibtsi'a Adhdhensha</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 43:1" />Ani Ermiyaasi, Duuchchi Woddiki Gootti insa'ne'n kulonna'a anee'e ergemmaka hiyyichcho duuchcha ardake'n haaso'e birenne wodda, <verse eid="JER 43:1" /><verse number="2" style="v" sid="JER 43:2" />Hoshayaak belti Azaariyaassi, Qaareehak belti Yohaananna hollaameeyye kade'ek manni duuchchi Ermiyaasi'i, «Soba'neeten! Duuchchi Woddiki Gootti no'o'ok Magen ‹Gibtsee'a me'itine ookko hexxinoqqe'e› hite kuli hiyye atee'e ergebaan. <verse eid="JER 43:2" /><verse number="3" style="v" sid="JER 43:3" />Yaane kinni Baabilooniki manni no'o'o shiyo'a yookaan booji'eexxi Baabilooni'a adhdhe'e me'o'a insa'nexxe anga'n no'o'o sa'isite uuttota'a Neeryaki belti Baarooki ate'e no'o'n tirtirse'een.»<verse eid="JER 43:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 43:4" />Tennexxee Qaareehak belti Yohaananna loliinke mannik ja'laabuwwi duuchchi iittanni ardi duuchchi, Duuchchi Woddiki Gootti Yihudiinke boga'n he'naashsha ajajemmaka hiyyichcho lanqebaa. <verse eid="JER 43:4" /><verse number="5" style="v" sid="JER 43:5" />Yaane kinni Qaareehak belti Yohaananinna loliinke mannik ja'laabuwwi duuchchi, Yihudake boga'n ofo'latee'e xexxerememake gosa gosake ardi giddi'n illeema hige dagemmaka manna duuchcha aa'ne me'ine; <verse eid="JER 43:5" /><verse number="6" style="v" sid="JER 43:6" />Insa'nenna labballo, melaalle, oosenna, mootumatike minike heqqanjuwwik ajajalli, Nabuzerdaan, Ahiqaamika belto Godoliyaasixxe anga'n gallo'a waalemmaxxa moyanjiinxa meyyaxxa oosenna, ittanni anee'e wabeekichcho Ermiyaasinna Neeryaka belto Baarookii'i aa'ne me'ine. <verse eid="JER 43:6" /><verse number="7" style="v" sid="JER 43:7" />Insa'ne'e Duuchchi Woddike Goottike hiyyichcho ajajema ginbe'e Gibtsee e'yineexxi Xaafinaasi qico'n me'ine.<note caller="-" style="x"><char style="xo" closed="false">43:7 </char><char style="xt" closed="false"><ref loc="2KI 25:26">2 Moy. 25:26</ref>. </char></note> <verse eid="JER 43:7" /><verse number="8" style="v" sid="JER 43:8" />Xaafinaasi hedhee'na'a Duuchchi Woddiki Gootti hiyyichch anee Ermiyaasi'n dagee hiyyeeqic, <verse eid="JER 43:8" /><verse number="9" style="v" sid="JER 43:9" />«Lumolla kino aaxxettexxi Xaafinaasi'i hedheeke Feri'oonike mootomatike minixxe hula'n Ayihudiink manni uudanaa faariinke miyini giissende butta fayendeexxe fawo giddo mooggettexxi, <verse eid="JER 43:9" /><verse number="10" style="v" sid="JER 43:10" />insa'nee ‹Lumoki Isira'eelik Duuchchi Woddiki Gootti Mageni: erganjo anka Baabiloonika moyanjo Nabukadanatsoori'i dagaashsha assannon; moote isixxanna konne kaba moogetexxe kinuwwa'n hana ofo'lishaashsha assanon; isinna mootumma ifixxika seemati giisemeeka fooqa ooko hana olitaan. <verse eid="JER 43:10" /><verse number="11" style="v" sid="JER 43:11" />Isinna dageexxi Gibtsee lolaan; reyotee muremeekir shiyemaan, booji'ote muremeekir booji'emaan, wolaantichakee muremeekir wolaantichangee'e sa'iseme uwwemaan. <verse eid="JER 43:11" /><verse number="12" style="v" sid="JER 43:12" />Isi Gibtseexxe fakkuwwake magenooffachchotike minuwwa'ni giira woree, gubaan; magenuwwa insa'nekaranna booji'ee adhdhaan; allalisanji fugate seemma hana lephphammashsha Gibtseeka boga lephpheexxi ookkoo'n nage'ik me'an. <verse eid="JER 43:12" /><verse number="13" style="v" sid="JER 43:13" />Isi Gibtseeke bogi giddo hedheeka arshotike magenuwwike fakkuwwake minuwwixxa sooddo buttuchee biraan; Gibtseke magenuwwika fakkuwwatika minenna giirat gubaan.› »<verse eid="JER 43:13" /></para>
  <chapter eid="JER 43" />
  <chapter number="44" style="c" sid="JER 44" />
  <para style="s1">Gibtsi Hedheeke Isira'eelike Ardi'a Kulemeeka Mageniinka Hiyyichcho</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 44:1" />Gibtseeke middike bogi giddo hedheeke Migidooli, Xaafinaasinna Memifisi iittann Gibtseke bita'n hedha'neeke Ayihudiinke ardixxee Duuchchi Woddiki Gootti hiyyichchi anee'e Ermiyaasi'n dage: <verse eid="JER 44:1" /><verse number="2" style="v" sid="JER 44:2" />«Lumok Duuchchi Woddik Gootti Isira'eelik Magen Iyyerusaalemikenna Yihudake qachchuwwa duuchcha'n iyyedagennexxa jabaxxa ba'ne ha'no uudine'een; telcho kunni qachchuwwi ayyinna giddo hedhabaake urmake kadedheen. <verse eid="JER 44:2" /><verse number="3" style="v" sid="JER 44:3" />Tinni kaddeelchi insa'ne assineexxe fuggo'aaten; insa'netenna kando ha'no yookaani annuwwi ha'nooki ege'nebaaka wele magenuwwi'a hixaana gubatinna isoo magenooffatati anee'e mufachchiinse'een. <verse eid="JER 44:3" /><verse number="4" style="v" sid="JER 44:4" />Aninna insa'ne'e, ‹Tenne ani gibaanexxa battitte yaane assitinoqqe› hiyya'n raagole anxa erganjuwwa higge higgeen insa'neeba ergennen. <verse eid="JER 44:4" /><verse number="5" style="v" sid="JER 44:5" />Insa'ne kinni lanqebaan; qalbeefantebaan; ifixxe fuggoxxe hujena'inna hingeba'a; wele magenuwwi'a hixaana guba waallebaan. <verse eid="JER 44:5" /><verse number="6" style="v" sid="JER 44:6" />Tennexxee bala anixinna mufe anxi lolaateexxi Yihudake qachchuwwa'inna Iyyerusaalemike oruwwa'n ha'yite; telcho uuddina'neeshshanni ayyinna hedhabaake onuwwanna oluwwa assiteen.<verse eid="JER 44:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 44:7" />«Ta'anna Lumoki Duuchchi Woddiki Gootti Isira'eelik Mageninna Sanne ha'nooxxi gattabashsha labballinna melaalle, oosetinna annoole Yihudake boga'n afendabaashsha iitta hexxeexxa jabaxxa ba'ne mayee ifi'n iyyedaqqitinee? <verse eid="JER 44:7" /><verse number="8" style="v" sid="JER 44:8" />Hexxino'a daggineeke konne Gibtseeke bogi giddo wele magenuwwi'a hixaana gubati, anga ha'noxxi giisiteexxe yaanuwwanni mayee'e anee'e mufachchisinaa? Butta'te'n hedheeke gosa gosake arduwwi duuchchi edo badinotikenna gacifachotike kaddino'a ifinni ifi balleessitinaata? <verse eid="JER 44:8" /><verse number="9" style="v" sid="JER 44:9" />Yihudiinke boga'ninna Iyyerusaalemike oruwwa'n ediki ha'nooki annuwwi, Yihudiink moyanjuwwinna insa'neexxi aruwwa, iittanni ha'nonna ha'nooxxi aruwwa assitineexxa fuggo deetinee'si? <verse eid="JER 44:9" /><verse number="10" style="v" sid="JER 44:10" />Telchiqico'n ifi heeshshi assinebaan; edike ha'nooke anuwwi edonna ha'noo edo uggenneka anka seeranna anxa aada hordonfebaan.<verse eid="JER 44:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 44:11" />«Tennexxe'e Lumok Duuchchi Woddik Gootti Isira'eeliki Mageninna ha'no'n ba'ne iyedagona'anna Yihuda duuchcha bironna'a mudhdheennen. <verse eid="JER 44:11" /><verse number="12" style="v" sid="JER 44:12" />Gibtseeke boga'n mare ofo'latee'e mudhdheeka booji'otenaa'n gateeka Yihudiinka arda duuchcha birannon; insa'ne Gibtsike boga'n wolaantichchik rennaan; solo'o'ik mundaan; lumokenaa'ni shiixokiqico'n wolaantichikinna solo'ik rennaan; ce'memaake, insa'ne'e uunde henkeki hiyyaakenna oso'lichinke kandaan. <verse eid="JER 44:12" /><verse number="13" style="v" sid="JER 44:13" />Iyyerusaalemii'i xixeneshshanni, Gibtsee hedheekanna wolaantichik, solo'ikinna dhukkubik xixannon. <verse eid="JER 44:13" /><verse number="14" style="v" sid="JER 44:14" />Gibtsee'a dageek boojjotenaa'n gateeke, Yihudak manni Yihudi'a higo'a halchoolenna heenoke booji'emeeke manna malee'e baajeexxi yookaan lubbo gate'e Yihudike bogibaa higaak mitti manjinna hedhabaan.»<verse eid="JER 44:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 44:15" />Aruwwa insa'nexxi wele magenuwwi'a hixaana gubbeexxa ege'neek labballuwwi duuchchi, ookko hexxemmaxxi melaalluwwa duuchchi, bita'ixxenna middixxe Gibtsee'n hedheek ardi duuchchi anee'e Ermiyaasii'i hiyyeeqic, <verse eid="JER 44:15" /><verse number="16" style="v" sid="JER 44:16" />«Ati Duuchchi Woddike Goottike summinni no'o'n haasottettaxxa erga lanqabe'non! <verse eid="JER 44:16" /><verse number="17" style="v" sid="JER 44:17" />Assinnanon, hinennexxa duuchcha assinnano; edik anuwwi no'oki, moyanjuwwi no'okinna ja'laabuwwi no'ok Yihudiinke qachchuwa'ninna Iyyerusaalemike oruwwa'n assinemashanni no'onna iimatixxe mootitte'a hixaana gunbanno; ha'watika tolchanna ise'a tolchinnanno; iitta assinnanna wodda indannolchi wo'meemman; eloqica he'nenna malee'e mitte fuggoxxi no'oo miitaaxxi geltebaan. <verse eid="JER 44:17" /><verse number="18" style="v" sid="JER 44:18" />Yaane kinni iimatixxe mootitte'a hixaana gubanna ha'watika tolcha isi'a tolcha waalenechinni kayyi'a, duuchchingecho gonpheenen; wolaatichchikinna solo'ik mudate'n he'nennen» <verse eid="JER 44:18" /><verse number="19" style="v" sid="JER 44:19" />Melaalletinna, «Iimatixxe mootitte'a hixaana gubaanexxa yannanna ha'watika tolcha ise'a tolchinnanna wodda, ra'isinennaxxa isexxe misileshsha hexxeexxa kebbonna lolaanseenneka ha'watika tolcha aro'uwwi no'ook ege'neenni hedhemman» hite. <verse eid="JER 44:19" /><verse number="20" style="v" sid="JER 44:20" />Ani Ermiyaasi hissichcho konne'e uwweeke arda labballokanna, melaalle duuchcha'n hiyyeeqic, <verse eid="JER 44:20" /><verse number="21" style="v" sid="JER 44:21" />«Ha'nonna edik ha'nok annuwwi, moyanjuwwi ha'nokinna ja'laabuwwi ha'nok ittanni bogiink ardi Yihudake qachuwwa'ninna Iyyerusaalemike oruwwa'n gubbineeka hixaana Duuchchi Woddiki Gootti qaabbata'nebaakenna dedheechcho ha'no'n labbee? <verse eid="JER 44:21" /><verse number="22" style="v" sid="JER 44:22" />Duuchchi Woddiki Gootti assitineexxa fuggonna hujjineexxa battitte yaane ossa dande'a gophemaxxe'e, telcho bogi ha'nok badinemeekenna manji hedhabaake ona boga kade'een. <verse eid="JER 44:22" /><verse number="23" style="v" sid="JER 44:23" />Ha'no hixaana wele magenuwwi'a gubiyyoti Duuchchin Woddike Gootta'n cubbo hujjinemaxxenna hiyyichcho isika heqqedha gophphinemmaxxe'e seera, gorsatanna ajaja isika ulfeessa gophphinemmaxxee telcho uudina'neeshshanni ba'ne ha'no'n dagge'een.»<verse eid="JER 44:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 44:24" />Ookkonechchi uduma ani arda duuchcha giddii'inni melaalle hiyyee qici: «Gibtseeke boga'n hexxina'neeke Yihudiinke arda duuchcha, Duuchchi Woddike Goottika hiyyichcho laqqe. <verse eid="JER 44:24" /><verse number="25" style="v" sid="JER 44:25" />Dada duuchcha ajajaake Duuchchi Woddike Gootik Isira'eelik Magen hiyya'nee qici: ha'nonna aruwwa ha'nooxxi, ‹Eettene iimatixxe mootitte'a hixaana gubbateenna ha'watika tolcha ise'a tolchatee werreegenneka werreega muunxanno› hitinee haasotinemmashshanni muuxxine'een.»</para>
  <para style="p" vid="JER 44:25">«Elo qica'n yoona mee udumi'a higge; uutino'a werreeginemaka werreeganna muuxxe! <verse eid="JER 44:25" /><verse number="26" style="v" sid="JER 44:26" />Gibtsee hexina'neeke Yihudiinke manna duuchcha Duuchchi Woddike Goottika hiyyichcho laqqe: Duuchchi Woddiki Gootti hiyya'nee qici: Konnechchinni edi'a fedheeki Gibtsike boga'ni hedha'neeki huuni Yihudiink manjinna, ‹Hedhaake Duuchchi Woddike Goottixxa!› hiyye summa anka ganabaashshanna, kakatabaasha lumoke anke summin kakateennen. <verse eid="JER 44:26" /><verse number="27" style="v" sid="JER 44:27" />Eloxxe kaddebaak fuggo ha'no'n kaddo'a assannaxxee Gibtseeke boga'n hedhaak Yihudiink manni mittikinna gatabaa qico'n wolaantichchikinna dhukkubik mudaan. <verse eid="JER 44:27" /><verse number="28" style="v" sid="JER 44:28" />Wolaantichchokenaa'ni gateexxi, Gibtsee'in Yihudiinke bogiba'a higaakir heenoke kadaan; Gibtsike boga'ni hedhatee dageek hafe gateek Yihudiki ardi duuchchi, anike yookaan insa'neeke hiyyichchi giddii'n huuni dhugaate kadeexxa ege'naan.<verse eid="JER 44:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 44:29" />« ‹Isi Ha'no'n iyyedaganno hiyyenaxxa fuggoxxa yaane muuxannoxxa egendinaashsha konne booncho'n ha'noo xixannoxxi tinni hano'a beessisake kaddowwaal› hiyya'neen Duuchchi Woddiki Gootti. <verse eid="JER 44:29" /><verse number="30" style="v" sid="JER 44:30" />Tinninna ‹Yihudaka moyanjo Sedeqiyaasi'i naaphi iso'o shiyo'a hasa'neeke Baabiloonike moyanjo Nabukadanatsoorixxe anga'n sa'isse uwwenneshshanni, iittanni Gibtseek moyanjo Feri'oonii'i Hofiraani shiyo'a hasa'neeke isike naaphuwwa'n iso'o sa'isse uwwannon.› »<note caller="-" style="x"><char style="xo" closed="false">44:30 </char><char style="xt" closed="false"><ref loc="2KI 25:1-7">2 Moy. 25:1-7</ref>. </char></note><verse eid="JER 44:30" /></para>
  <chapter eid="JER 44" />
  <chapter number="45" style="c" sid="JER 45" />
  <para style="s1">Magen Baarooki'a Haaso'eexxa Erga</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 45:1" />Yihudiinke moyanjik Iyyosiyaasik belti Iyyo'aaqemi moye galchamma baro'n sholgeessoxxe wogga'n, ani Ermiyaasi haaso'enneka hiyyichcho Baarooki mirqisanjoke'n hana borreessechchi uduma, ani Neeryaka belto Baarooki'n hiyye haaso'eeqic,<note caller="-" style="x"><char style="xo" closed="false">45:1 </char><char style="xt" closed="false"><ref loc="2KI 24:1">2 Moy. 24:1</ref>; <ref loc="2CH 36:5-7">2 Odo. 36:5-7</ref>; <ref loc="DAN 1:1-2">Dan. 1:1-2</ref>. </char></note> <verse eid="JER 45:1" /><verse number="2" style="v" sid="JER 45:2" />«Koo Baarooki, Lumoki Duuchchi Woddiki Gootti Isira'eeliki Mageni atee'e: <verse eid="JER 45:2" /><verse number="3" style="v" sid="JER 45:3" />ati, ‹Duuchchi Woddiki Gootti dhibo anixe'ninni hana yaaddo ane'n lebe'een, ani'a aane'e; oodhishshatixxe birasa'nenaa'ni kexxeexxa shaqqeennen; hafuura adhdhebe'non› » hiteeten.<verse eid="JER 45:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 45:4" />Duuchchi Woddiki Gootti, «isoo'o hiyyeeqic: ‹Duuchchi Woddiki Gootti hiyya'neqici: boga duuchcha'n ijaarennexxa yaane diigannon; kaasennelcho goshannon. <verse eid="JER 45:4" /><verse number="5" style="v" sid="JER 45:5" />Ani manjo duuchcha'n ba'ne iyyedaga'annexxe'e gargar hexxeexxa eloxxa yaane ati'a assonna'a yortatte? Yortoxxe'e; yaane kinni marte geltetteba duuchcha lubbo gattattoshsha assannon; ani Duuchchi Woddiki Gootti tenne haaso'eennen› » hiyye.<verse eid="JER 45:5" /></para>
  <chapter eid="JER 45" />
  <chapter number="46" style="c" sid="JER 46" />
  <para style="s1">Duuchchi Woddiki Gootti Gibtse'n Mureexxa Murte</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 46:1" />Gosa gosake ardixxe'e Duuchchi Woddiki Gootti hiyyichchi ane'e Ermiyaasi'n dageexxi hiyyeeqic, konneechchinni butti'a hedheen. <verse eid="JER 46:1" /><verse number="2" style="v" sid="JER 46:2" />Gibtseexxe'e, Yihudake moyanjike Iyyosiyaasike belto Iyyo'aaqemi moyeexxe sholgeessoxxe wogga'n Efiraaxisike galaan qarqara Karikeemishshi hiyyendaaxxe bakka'n Baabiloonik moyanji Nabukadanatsoori lole'e injifateek Gibtseke moyanjo Feri'ooni Nikaa'uke sannachchuwwa'n erga kulendeen;<note caller="-" style="x"><char style="xo" closed="false">46:2 </char><char style="xt" closed="false"><ref loc="ISA 19:1-25">Isa. 19:1-25</ref>; <ref loc="EZK 29:1-32:32">Hiz. 29:1—32:32</ref>. </char></note><verse eid="JER 46:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 46:3" />«Lumoxxanna shiixxoxxa wonte qophpheffatte;</para>
  <para style="q2" vid="JER 46:3">lolakeenna fulle!<verse eid="JER 46:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 46:4" />Fadhado koodhe;</para>
  <para style="q2" vid="JER 46:4">hananna gulufe;</para>
  <para style="q1" vid="JER 46:4">Umoke'n sibiliinxa gulle uggudhdhitineexxi,</para>
  <para style="q2" vid="JER 46:4">ififixxe bakka ha'nooxxe'ni uurre;</para>
  <para style="q1" vid="JER 46:4">Bagedo ha'nookanna qadhdhe;</para>
  <para style="q2" vid="JER 46:4">sibiliinxa seemmanna lolakee'e oddo'we.<verse eid="JER 46:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 46:5" />Yaane uudaneelchi kunni maachcho?</para>
  <para style="q2" vid="JER 46:5">Yo'ooshsha sodaante'een;</para>
  <para style="q1" vid="JER 46:5">Udumi'a higate'n he'neen;</para>
  <para style="q2" vid="JER 46:5">jabaki insa'nek loliinki manni injifateme'een;</para>
  <para style="q1" vid="JER 46:5">Udumi'a wirri hiyye uudebaang,</para>
  <para style="q2" vid="JER 46:5">lekka wonshine baqake'n he'neen;</para>
  <para style="q2" vid="JER 46:5">duuchchi darre'n weekensha hexxeen;» hiyya'neen Duuchchi Woddik Gootti.<verse eid="JER 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 46:6" />«Yo'oshsha gongaak dande'e baajabaan;</para>
  <para style="q2" vid="JER 46:6">jajjabikinna baaje fulabaan;</para>
  <para style="q1" vid="JER 46:6">Insa'ne midda Efiraaxisike galaan bira,</para>
  <para style="q2" vid="JER 46:6">guggufante inbaan.<verse eid="JER 46:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JER 46:7" />«Dageeke Abbayike galaanishsha utalaak;</para>
  <para style="q2" vid="JER 46:7">wo'me danbala'ammake galaanishsha ya'aak kunni ayyete?<verse eid="JER 46:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 46:8" />Gibtsee dageeke Abbayike galaanishsha utaldaan;</para>
  <para style="q2" vid="JER 46:8">wo'me danbala'ammake gaalaanishsha finxirqisaan;</para>
  <para style="q1" vid="JER 46:8">Ise, ‹Ani qophphi hiyye'e ke'annonnni; buttatanna buqannon;</para>
  <para style="q2" vid="JER 46:8">qachchuwwa giddo hedhemmange manninni balleessannon› hittaan.<verse eid="JER 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 46:9" />Koo fadhaduwwa guluffineeke manna ke'e fulle! Fadhadiinxe gaarruwwaki manninna qolchisse;</para>
  <para style="q2" vid="JER 46:9">wonte abixxitine'eek Tophiyiikinna Fuuxiki manni,</para>
  <para style="q1" vid="JER 46:9">Ha'no gabe qassine'eek Luudik,</para>
  <para style="q2" vid="JER 46:9">ha'no jajjabbi loliink manni kexxine duulle.<verse eid="JER 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 46:10" />Itti barra kinn lumoke Duuchchi Woddike Goottixxe barran;</para>
  <para style="q1" vid="JER 46:10">Ifike naapha'ni halo fula'neexxe halotixxe barran.</para>
  <para style="q1" vid="JER 46:10">Wolaantichchi isikinna godde dee'ifataa qico'ni itaan;</para>
  <para style="q2" vid="JER 46:10">dheebo fulaa qico'ni munde ha'waan.</para>
  <para style="q1" vid="JER 46:10">Middi darreke Efiraaxisike galaanike bogi bira</para>
  <para style="q2" vid="JER 46:10">lumoki Duuchchi Woddiki Gootti Magen tolcha qophpheese'en.<verse eid="JER 46:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 46:11" />«Tee Gibtseexxe duuddo dubarrichcho;</para>
  <para style="q2" vid="JER 46:11">Gele'adike bogibaa'a fuli; hariirrannoka qorsanna iyyedagi;</para>
  <para style="q1" vid="JER 46:11">Yaane kinni tolanga qorsa bira sa'isitaatten tola;</para>
  <para style="q2" vid="JER 46:11">fayyitabexxon.<verse eid="JER 46:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 46:12" />Gosa gosaki arduwwi salphinne atika laqaan;</para>
  <para style="q2" vid="JER 46:12">oodhishsha atixxinna butta duuchcha'ni geltaan,</para>
  <para style="q1" vid="JER 46:12">Mitti loliinki manji mitteke'n guggufataan;</para>
  <para style="q2" vid="JER 46:12">lamiing weli abixxe ibaan» hiyye.<verse eid="JER 46:12" /></para>
  <para style="s1">Nabukedentsoorika Dago</para>
  <para style="p">
    <verse number="13" style="v" sid="JER 46:13" />Baabiloonik moyanji Nabukadanatsoori dageexxi Gibtsee lola'neexxa, Duuchchi Woddiki Gootti wabeek Ermiyaasi'ni haaso'emmaxxi erga konnechchin butti'a hexxeen:<note caller="-" style="x"><char style="xo" closed="false">46:13 </char><char style="xt" closed="false"><ref loc="JER 43:10-13">Erm. 43:10-13</ref>. </char></note><verse eid="JER 46:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 46:14" />«Tennee Gibtseeke boga'ni haaso'e; Migidoolimii laqise;</para>
  <para style="q2" vid="JER 46:14">Memifisinna Xaafinaasi hine lallabee qici:</para>
  <para style="q1" vid="JER 46:14">‹Booncho booncho ha'nooge'ni uure;</para>
  <para style="q2" vid="JER 46:14">qophpheeffatte qarqara ha'nooke'n hedheeka wolaantichchi itaani.›<verse eid="JER 46:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 46:15" />Lolinki atike manni mayee'e ferri hiyyesi?</para>
  <para style="q2" vid="JER 46:15">Duuchchi Woddiki Gootti dhiibe insa'nee hunaammaxxe'e; uurra dandeennabaan.<verse eid="JER 46:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 46:16" />Insa'ne higge higgeen gugguffantaan;</para>
  <para style="q2" vid="JER 46:16">mitti mitteke'n hana ibaan,</para>
  <para style="q1" vid="JER 46:16">‹Ke'we alalle me'ino;</para>
  <para style="q2" vid="JER 46:16">ardi no'okibana ilemenge bogiba'a hingo;</para>
  <para style="q2" vid="JER 46:16">naaphiinke wolantichchanaa'ninna banjo› hinaan.<verse eid="JER 46:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 46:17" />Ookone wodda ‹Gibtseeka moyanjo Feri'ooni</para>
  <para style="q2" vid="JER 46:17">isi'a uwwendeexxe yanna'ni la'ote'n hosebaake,</para>
  <para style="q2" vid="JER 46:17">anee malee'e hiyya'neeke caaqaleesa!› Hine isoo ye'naan.<verse eid="JER 46:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 46:18" />Summikinna dada duuchcha ajajaak Duuchchi Woddike Gootta kade'eek moyanji hiyya'nee qici:</para>
  <para style="q2" vid="JER 46:18">«Ani hedhaaneke kada anxe'ni kakataanen.</para>
  <para style="q1" vid="JER 46:18">Koobuwwatixxe oddo'ni hedheeka Taaborixxa kooba labbaa'nexxa,</para>
  <para style="q2" vid="JER 46:18">abbaayati qarqar hedheeka Qermeeloosixxa kooba fakkaate daga'neechcho hedheen.<verse eid="JER 46:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 46:19" />Koo, Gibtsee hexxina'neeke ardaa,</para>
  <para style="q2" vid="JER 46:19">booji'endine me'itino'a mi'ya ha'nooka qophpheesedhe;</para>
  <para style="q1" vid="JER 46:19">Memifisi diigendeexxi,</para>
  <para style="q2" vid="JER 46:19">manji hedhebaake ona kaddaan.<verse eid="JER 46:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 46:20" />«Gibtsee munde eldeexxe raadashshaten,</para>
  <para style="q2" vid="JER 46:20">yaane kinn woraanchi,</para>
  <para style="q2" vid="JER 46:20">middi darree'ni iddo'a dagaan.<verse eid="JER 46:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 46:21" />Kinjiinka dalla'a heqqammak lolinki manninna,</para>
  <para style="q2" vid="JER 46:21">ha'yo afeeke jibootishshaten,</para>
  <para style="q1" vid="JER 46:21">Xixemaaxxi yanna insa'ne'a geltemmaxxe'e,</para>
  <para style="q2" vid="JER 46:21">ba'netixxi barra insa'ne'a shiqqemaxxe'e,</para>
  <para style="q1" vid="JER 46:21">Insa'nenna udumi'a hingeexxi mitteba baanjan,</para>
  <para style="q2" vid="JER 46:21">ifi ifike booncho'inna itti jabaante ifi iimi'ni hoyyedha dandeennabaan.<verse eid="JER 46:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 46:22" />Naaphi hunnat isibaa dagaa wodda,</para>
  <para style="q2" vid="JER 46:22">Gibtse baqata'neexxe buuteshsha fiissitaan;</para>
  <para style="q1" vid="JER 46:22">Haqqe kara'neeke mannishsha,</para>
  <para style="q2" vid="JER 46:22">meesano aa'ne fullaan.<verse eid="JER 46:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 46:23" />Haqqe wo'miteeke gongomanna kadoole; gaaro annaani»</para>
  <para style="q2" vid="JER 46:23">hiyya'nen Duuchchi Woddik Gootti.</para>
  <para style="q2" vid="JER 46:23">«Laakkossi insa'neeki koro'mosinke haaganiinshaten;</para>
  <para style="q1" vid="JER 46:23">Ayyinna laakko'e dhaqqababaan.<verse eid="JER 46:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 46:24" />Gibtseexxi dubarcho shookiinxe kaddaan;</para>
  <para style="q2" vid="JER 46:24">middike ardixxe anga'ninna sa'issendinee uwwendaan.»<verse eid="JER 46:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 46:25" />Dada Duuchcha ajajaaki Duuchchi Wodddiki Gootti Isira'eeliki Magen hiyya'neeqic: «Tebeesiki mageni Amooni'ni, Feri'ooni'ni, Gibtsee'ninna isenge magenuwwa'ni, moyanjuwwake'n iittann Feri'ooni'ni adde assa'neera xixannon: <verse eid="JER 46:25" /><verse number="26" style="v" sid="JER 46:26" />Shiyo'a hasa'neeke Baabiloonike moyanjo Naabukadanatsoori'anna loliinke isike ja'laabuwwixxe anga'ni sa'isse uwwannon: shiixxoxxe yanna uduma kinni Gibtse edi woddike barishshann haaroba'a manji hedhaaxxe bakka kaddaan,» hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 46:26" /></para>
  <para style="s1">Duuchchi Wooddiki Gootti Arda Ifika Anjiraaxxa</para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 46:27" />«Koo anke erganjo Ya'iqoobi; sodaattoxxe'e;</para>
  <para style="q2" vid="JER 46:27">Koo, Isira'eli daddaaqqoxxe'e;</para>
  <para style="q1" vid="JER 46:27">Atee'e bayyike boonchonaa'ni,</para>
  <para style="q2" vid="JER 46:27">sanne atixxanna booji'ende me'itemmake boganaa'n anjiranoon.</para>
  <para style="q1" vid="JER 46:27">Ya'iqoobi higeexxi nage'ikinna salaliki ofo'laan: iso'o sodaachchisaachchi mittilchinna hedhabaan.<note caller="-" style="x"><char style="xo" closed="false">46:27</char><char style="xt" closed="false"><ref loc="JER 30:10-11">Erm. 30:10-11</ref>. </char></note><verse eid="JER 46:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 46:28" />Koo anike erganjo Ya'iqoobi; sodaattoxxe'e;</para>
  <para style="q2" vid="JER 46:28">ani atinni welti hedhennen» hiyya'neen Duuchchi Woddiki Gootti.</para>
  <para style="q1" vid="JER 46:28">«Atee'e xexxeeremmaka gosa gosaka arda duuchcha;</para>
  <para style="q2" vid="JER 46:28">booso insa'neexxa balleessonnolenna midde;</para>
  <para style="q2" vid="JER 46:28">atee'e kinn ittanna balleessabe'non.</para>
  <para style="q1" vid="JER 46:28">Hasissaaxxa mura woxa ati'a uwwanno malee'e;</para>
  <para style="q2" vid="JER 46:28">tola boddichcha atee waalabe'non» hiyye.<verse eid="JER 46:28" /></para>
  <chapter eid="JER 46" />
  <chapter number="47" style="c" sid="JER 47" />
  <para style="s1">Filisxeemike Ardixxe'e Kulemeeka Wabeekumma</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 47:1" />Feri'oon Gaaza'a loli injifateechchi edo, Filsixeemike mannixxee Duuchchi Woddiki Gootti wabeekichcho Ermiyaasi'ni haaso'eek hiyyichchi konneechchinn butti'a hedheen;<note caller="-" style="x"><char style="xo" closed="false">47:1 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">Isa. 14:29-31</ref>; <ref loc="EZK 25:15-17">Hiz. 25:15-17</ref>; <ref loc="JOL 3:4-8">Iyu. 3:4-8</ref>; <ref loc="AMO 1:6-8">Amo. 1:6-8</ref>; <ref loc="ZEC 9:5-7">Zek. 9:5-7</ref>. </char></note> <verse eid="JER 47:1" /><verse number="2" style="v" sid="JER 47:2" />Duuchchi Woddiki Gootti hiyyee qici:</para>
  <para style="q1" vid="JER 47:2">«Kunse, middi darre'n wodi'i wo'me,</para>
  <para style="q2" vid="JER 47:2">jabake lola'a kadaan;</para>
  <para style="q1" vid="JER 47:2">Bogakanna bogi giddo hedheelcho duuchcha</para>
  <para style="q2" vid="JER 47:2">qachchuwwa konne giddo hedhemmaka arda duuchcha buqaan.</para>
  <para style="q1" vid="JER 47:2">Ardikinna hafuura gikki asseexxi raare dhanga ganaani;</para>
  <para style="q2" vid="JER 47:2">buttate'n hedheeki manni duuchchi woo woo hiyya'n hiiqqisan.<verse eid="JER 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 47:3" />Fadhaduwwiinke hirbanaa'n,</para>
  <para style="q2" vid="JER 47:3">naaphinxe fadhadiinxe gaaruuwwatik hirbinna gaaruwwatixxe</para>
  <para style="q2" vid="JER 47:3">mole weli rigematenaa'ni kexxeexxa,</para>
  <para style="q1" vid="JER 47:3">Annuwwi ifixxa oose gargaro'a udumi'a wirrinna hiyyabaan;</para>
  <para style="q2" vid="JER 47:3">anga insa'nexxinna jimoote gattaan.<verse eid="JER 47:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 47:4" />Filisixeemika manna duuchcha biratee'e;</para>
  <para style="q2" vid="JER 47:4">reyotenaa'n gate insa'ne'e gargara'neekara duuchcha,</para>
  <para style="q1" vid="JER 47:4">Xiroosinna Sidoonii'n gatisate'e kutemme gantaaxxi,</para>
  <para style="q2" vid="JER 47:4">barra shiqe'en</para>
  <para style="q1" vid="JER 47:4">Duuchchi Woddiki Gootti Kafitoor qarqaara'n gateekara; Filsixeemika arda biro'a ke'edheen</para>
  <para style="q2" vid="JER 47:4">ke'eedhen.<verse eid="JER 47:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 47:5" />Gaaza yaadeti umo haaxitaan,</para>
  <para style="q2" vid="JER 47:5">Asiqeloonna afo'o abixitee sammi hitaan.</para>
  <para style="q1" vid="JER 47:5">Tee Medaammaxxe dhooqa giddo hexxettexxe Tirrufaan:</para>
  <para style="q2" vid="JER 47:5">haani qico'ni biso ha'nooka hoqooqqexina'nesi?<verse eid="JER 47:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JER 47:6" />« ‹Koo, Duuchchi Woddike Goottike wolaanticha› sammi hiyya,</para>
  <para style="q2" vid="JER 47:6">‹gopha atixxi haanqici'ate?</para>
  <para style="q1" vid="JER 47:6">Gonofi giddi'a higgettexxi;</para>
  <para style="q2" vid="JER 47:6">sammi hite haafura adhdhite ofo'li› hitinaan.<verse eid="JER 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 47:7" />Yaane kinni Duuchchi Woddiki Gootti Asiqeloninna abbayyatika qarqara,</para>
  <para style="q2" vid="JER 47:7">lolaashsha isi ajaja uwwaa wodda,</para>
  <para style="q1" vid="JER 47:7">Muuxaashanna ajaja uwwaa'na</para>
  <para style="q2" vid="JER 47:7">habaa'ni sammi assissa?» hiyye.<verse eid="JER 47:7" /></para>
  <chapter eid="JER 47" />
  <chapter number="48" style="c" sid="JER 48" />
  <para style="s1">Mo'aabixxe'e Kulendexxa Erga</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 48:1" />Mo'aabixxa Ba'ne.</para>
  <para style="b" vid="JER 48:1" />
  <para style="p" vid="JER 48:1">Dada Duuchcha ajajaak Duuchchi Woddiki Gootti Isira'eelik Mageni hiyya'nee qici:</para>
  <para style="q1" vid="JER 48:1">«Aanne'e Neebo'a ba'nenden.</para>
  <para style="q2" vid="JER 48:1">Qiriyaataminna abidende salphattaan;</para>
  <para style="q2" vid="JER 48:1">jabaxxi kolluwwa diigendaan.<note caller="-" style="x"><char style="xo" closed="false">48:1 </char><char style="xt" closed="false"><ref loc="EZK 25:8-11">Hiz. 25:8-11</ref>; <ref loc="ZEP 2:8-11">Sof. 2:8-11</ref>. </char></note><verse eid="JER 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 48:2" />Konneechchi edi'a Mo'aabixxi saadendabaan;</para>
  <para style="q2" vid="JER 48:2">gosa gosaki ardinna Haseeboni'ni ofo'le;</para>
  <para style="q2" vid="JER 48:2">‹Amme ookkone boga balleessino› hine fuggoxxa ise'n mari'antaan.</para>
  <para style="q1" vid="JER 48:2">Tee Medimeen; ateenna bucuqqi hitaboxxoshsha assinaan;</para>
  <para style="q2" vid="JER 48:2">wolaantichchikinna shorrinaani.<verse eid="JER 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 48:3" />Horonayimii'ni laqenda'neexxa,</para>
  <para style="q2" vid="JER 48:3">jabaxxe ba'nexxinna diigenshatixxa rare caqasse!<verse eid="JER 48:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 48:4" />Mo'aabi baxxaan;</para>
  <para style="q2" vid="JER 48:4">oose isexxina raartaan.<verse eid="JER 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 48:5" />Insa'nenna heeqinse oo'na'ni</para>
  <para style="q2" vid="JER 48:5">Luuhiti'i qabantaan;</para>
  <para style="q1" vid="JER 48:5">Insa'ne'ni gelteexxe ba'nexxe hunbaashshina'ni oo'na'ni;</para>
  <para style="q2" vid="JER 48:5">Horonayimii'ni butti'a dirrinaan.<verse eid="JER 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 48:6" />Baqatine lubbo ha'noxxanna gatese!</para>
  <para style="q2" vid="JER 48:6">qiilla gammoojje'ni hexxeexxe qu'muudoshsha kadde.<verse eid="JER 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 48:7" />Huje ha'nooxxe'ninna karra ha'nooxxe'n addatinammaxxe'e</para>
  <para style="q2" vid="JER 48:7">ha'noonna booji'endinaan</para>
  <para style="q1" vid="JER 48:7">Kaamoshinna qeesoletinna jalqabuwwik welti;</para>
  <para style="q2" vid="JER 48:7">boojin adhdhine me'inaan.<verse eid="JER 48:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 48:8" />Mitti mittinge qachchuwa'ni balleesanji dagaan;</para>
  <para style="q2" vid="JER 48:8">mitti qachchinna gatabaan.</para>
  <para style="q1" vid="JER 48:8">Duuchchi woddiki Gootti haaso'eexxi;</para>
  <para style="q2" vid="JER 48:8">dhooqatinna diidi urime gataan;<verse eid="JER 48:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 48:9" />Phirri hiyye baaje fulo'a;</para>
  <para style="q2" vid="JER 48:9">Mo'aabi'a keela uwwe.</para>
  <para style="q1" vid="JER 48:9">Qachchuwwi mittichchinna hedhabaqico'ni;</para>
  <para style="q2" vid="JER 48:9">uruma kade gataan.<verse eid="JER 48:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 48:10" />«Duuchchi Woddike Goottixxa huje ga'ma'mi hiyya'ni hujaaki yowwemeeke kadun;</para>
  <para style="q2" vid="JER 48:10">isika ajajee'na'a wolaantichik munde dunabaasha hoyyaaki yowwemeeken!<verse eid="JER 48:10" /></para>
  <para style="s1">Moa'bike Qachchuwwixxa Diigensha</para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 48:11" />«Mo'aabi kotofik hedheeke woyinetike bulbulo;</para>
  <para style="q2" vid="JER 48:11">oosummandenaa'ni ke'isse ititee hedhemman;</para>
  <para style="q1" vid="JER 48:11">Mitte miyanaa'ni wele miya'ni fulchinebaan;</para>
  <para style="q2" vid="JER 48:11">booji'eme ege'nebaan;</para>
  <para style="q1" vid="JER 48:11">Anjatinn hexxemmashshanni hexxeen;</para>
  <para style="q2" vid="JER 48:11">xe'me isexxinna jijjirendebaang hexxeen.<verse eid="JER 48:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 48:12" />Tennexxee mitte miyana'ni weleke'ni fulchaaka manna;</para>
  <para style="q2" vid="JER 48:12">erganoxxe yanna daggaan»</para>
  <para style="q1" vid="JER 48:12">Hiyya'neen Duuchchi Woddik Gootti.</para>
  <para style="q1" vid="JER 48:12">«Insa'nenna isoo dunnaan;</para>
  <para style="q1" vid="JER 48:12">Miyakanna duwwi gatinsaan;</para>
  <para style="q2" vid="JER 48:12">manqorqoruwakanna enqine birraana.<verse eid="JER 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 48:13" />Isira'eelik manni;</para>
  <para style="q2" vid="JER 48:13">Beeteli'ni addate shookemashshan,</para>
  <para style="q2" vid="JER 48:13">Mo'aabinna Kaamoshi hinaaxxe magenoofatamaxxe fakke'ni shookan.<verse eid="JER 48:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 48:14" />«Ha'no koo Mo'aabike manna, ‹No'o lolinke mannanna</para>
  <para style="q2" vid="JER 48:14">lolake no'o jabake mannani hiyya hitta dandetine›?<verse eid="JER 48:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 48:15" />Mo'aabi ba'aan, qachchuwwikinn diigeman;</para>
  <para style="q2" vid="JER 48:15">elolla dargageeyenna gorraano'a aa'ne me'inaan»</para>
  <para style="q2" vid="JER 48:15">hiyya'neen summi lumoke Duuchchi Woddike Gootta kadde'ek moyanji.<verse eid="JER 48:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 48:16" />«Mo'aabixxi iba shiqqe'en;</para>
  <para style="q2" vid="JER 48:16">ba'netinna iso'ni ikki woddi dagga'neen.<verse eid="JER 48:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 48:17" />Qarqarake'ni hexxina'neek duuchchi;</para>
  <para style="q2" vid="JER 48:17">gurra iseka egendineeki duuchchi isi'a oodhe,</para>
  <para style="q1" vid="JER 48:17">‹Baalletixxi jabbaxxi bokko,</para>
  <para style="q2" vid="JER 48:17">ulfiniinxi siqqo hitta enqema dandeette!›<verse eid="JER 48:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JER 48:18" />«Mo'aabi'i balleesaki,</para>
  <para style="q2" vid="JER 48:18">ate'n dagaan;</para>
  <para style="q2" vid="JER 48:18">Kinjike dalla'ikka atika qachchuwwina isinni balleesan;</para>
  <para style="q1" vid="JER 48:18">Tee Diboonxe meyyaxxe belto;</para>
  <para style="q2" vid="JER 48:18">ulfiniixxe bakkanaa'n dirri;</para>
  <para style="q2" vid="JER 48:18">bagoke buttina'ni ofo'le.<verse eid="JER 48:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 48:19" />Tee Aro'erii'i hexxaatexxe</para>
  <para style="q2" vid="JER 48:19">orin qarqara uurrite uudi baqate'neeka labbaka,</para>
  <para style="q1" vid="JER 48:19">Baaje fulda'neexxa meyyaxxa,</para>
  <para style="q2" vid="JER 48:19">‹kaddeexxi yaane maachcho isi?› hite qore.<verse eid="JER 48:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 48:20" />Mo'aabi iba ifixxe'n shooke'eni;</para>
  <para style="q2" vid="JER 48:20">woo hitina'ni; raare</para>
  <para style="q1" vid="JER 48:20">Mo'aabixxa ole kada,</para>
  <para style="q2" vid="JER 48:20">Arinooni bira ege'nishshe.<verse eid="JER 48:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 48:21" />Murte Abike boga'ni,</para>
  <para style="q2" vid="JER 48:21">Holooni, Yaasanna Mefa'aati'ni,<verse eid="JER 48:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="JER 48:22" />Dibooni'n, Neebo, Beeti Dibilatayi'n,<verse eid="JER 48:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="JER 48:23" />Qeriyaatami'n, Beeti Gaamuli'n, Beetime'ooni'ni,<verse eid="JER 48:23" /></para>
  <para style="q2">
    <verse number="24" style="v" sid="JER 48:24" />Qeryooti'ninna Bootsira'ni; bayyanna shiqa, hedheke Mo'aabike qachchuwwi duuchcha'n dage'een.<verse eid="JER 48:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 48:25" />Mo'aabixxi hunna enqende'en;</para>
  <para style="q2" vid="JER 48:25">aniga isixxinna kutende'en,»</para>
  <para style="q2" vid="JER 48:25">hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 48:25" /></para>
  <para style="s1">Mo'aabika Salphinne</para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="JER 48:26" />«Duuchchi Woddiki Gootti tuffatemaaxxe'e,</para>
  <para style="q2" vid="JER 48:26">Mo'aabii'i ha'wisine machchoosse.</para>
  <para style="q1" vid="JER 48:26">Mo'aabi ifixxe honqo'o'ni hana gangalataan;</para>
  <para style="q2" vid="JER 48:26">osollemeeke kadaan.<verse eid="JER 48:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 48:27" />Isira'eeli'ni gacifataataba?</para>
  <para style="q2" vid="JER 48:27">Isexxe haasotetexxe qixxe'ni,</para>
  <para style="q1" vid="JER 48:27">Umo atika le'misaatak,</para>
  <para style="q2" vid="JER 48:27">moodhalshite welti uggita'na meya ise'e dhaqqabutashsha?<verse eid="JER 48:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 48:28" />Ha'no Mo'aabike qachcha'n hexxina'neke manna;</para>
  <para style="q2" vid="JER 48:28">qachchakenaa'n fuldine rassat giddo hedhdhe;</para>
  <para style="q1" vid="JER 48:28">Guuggenjo bowwa'i qarqara;</para>
  <para style="q2" vid="JER 48:28">mine ijadhdhitammashsha kadde.<verse eid="JER 48:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="JER 48:29" />«Mo'aabi holla'neexxe,</para>
  <para style="q2" vid="JER 48:29">ifi lummisse caaqa'neexxe;</para>
  <para style="q1" vid="JER 48:29">Ifi duke kijibeexanna;</para>
  <para style="q2" vid="JER 48:29">godoba jabeesse'exxanna lanqeenen.<verse eid="JER 48:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 48:30" />Ani isexxa ifi duka ege'neennen yaane kinn toliinxen,»</para>
  <para style="q2" vid="JER 48:30">hiyya'neen Duuchchi Woddik Gootti.</para>
  <para style="q2" vid="JER 48:30">«Tolange ifi saada'neen.<verse eid="JER 48:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 48:31" />Tennexxee Mo'aabi'a oodha'nen;</para>
  <para style="q2" vid="JER 48:31">Mo'abike bogi duuchchi'a woo hiyyaanen;</para>
  <para style="q2" vid="JER 48:31">Qiirheresike manni'anna gaaddannon.<verse eid="JER 48:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 48:32" />Sibimake woyinetike hiddichcho;</para>
  <para style="q2" vid="JER 48:32">Iyyazeeri'a oodhane caala midde ati'a oodhanon;</para>
  <para style="q1" vid="JER 48:32">Damooletinna abbaayatiqico'ni daalde'en;</para>
  <para style="q2" vid="JER 48:32">Iyyazeriqico'n gelte'en;</para>
  <para style="q1" vid="JER 48:32">Haama gelteexxa midha atixxanna woyinetika hiddichcho atika,</para>
  <para style="q2" vid="JER 48:32">balleessaaki dageen.<verse eid="JER 48:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 48:33" />Mo'aabike hiddichchuwinke fichchike boonchonna'n;</para>
  <para style="q2" vid="JER 48:33">gammadikinna ilileete bayyate'en;</para>
  <para style="q1" vid="JER 48:33">Woyintika bulubulo miicamake miyi giddii'ni fulaabasha basse'enen;</para>
  <para style="q2" vid="JER 48:33">ilillisa'ni miicaki afemabaan;</para>
  <para style="q1" vid="JER 48:33">Ookkona hafuuri laqemoolenna;</para>
  <para style="q2" vid="JER 48:33">ililleettetika hafurabaan.<verse eid="JER 48:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 48:34" />«Haseebonii'n Eli'aal qico'ninna Yaaheesi qico'ni;</para>
  <para style="q2" vid="JER 48:34">Tso'aari'ni Horonayimi qico'ni Egilaati Shelishi qico'ni;</para>
  <para style="q1" vid="JER 48:34">Insa'nexxi raare adda laqisaan;</para>
  <para style="q2" vid="JER 48:34">Nimiirimik wodi'inna midde bage'en.<verse eid="JER 48:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 48:35" />Magenoofantammake tulluchuwa'ni tolchinammaka;</para>
  <para style="q2" vid="JER 48:35">ifike magenoofantamake magenuwwi'a hixaana gubaaka</para>
  <para style="q1" vid="JER 48:35">Mo'aabii'ni balleesanon,»</para>
  <para style="q2" vid="JER 48:35">hiyya'nene Duuchchi Woddiki Gootti.<verse eid="JER 48:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 48:36" />«Tennexxee qalbe anxi Mo'aabi'a;</para>
  <para style="q2" vid="JER 48:36">Qiirheresike ardi horatechcho duuchcha gophemaxxe'e;</para>
  <para style="q2" vid="JER 48:36">reyotiba susuu'le afunfa'na'a oodhammake mannishsha ins'ane'a oodha'enen.<verse eid="JER 48:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 48:37" />Mitti mittinge manji uminna;</para>
  <para style="q2" vid="JER 48:37">areedi duuchchi hademeen;</para>
  <para style="q1" vid="JER 48:37">Aniga duuchchi madooteen;</para>
  <para style="q2" vid="JER 48:37">hidha duuchcha'inna yaaddotixxa seemmanna usu'dhineen.<verse eid="JER 48:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 48:38" />Mo'aabi'ke minuwwixxi heellcho duuchcha'ni;</para>
  <para style="q2" vid="JER 48:38">ardi bukku hiyyammaba</para>
  <para style="q1" vid="JER 48:38">Yaaddo malee'e wele lanqaachchi hedhebaan;</para>
  <para style="q2" vid="JER 48:38">hunnemaxxe odolchoshsha Mo'abii'i enqeenen,»</para>
  <para style="q2" vid="JER 48:38">hiyya'ne Duuchchi Woddik Gootti.<verse eid="JER 48:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="JER 48:39" />«Hitta kadee enqeme!</para>
  <para style="q2" vid="JER 48:39">Hitteeqico isi'a oo'ne!</para>
  <para style="q1" vid="JER 48:39">Mo'aabi hitta kade dudduro wirri hiyye!</para>
  <para style="q2" vid="JER 48:39">Mo'abi oso'lematike,</para>
  <para style="q2" vid="JER 48:39">qarqarake'n hedheeke duuchchi'a alayyiineke beessisa kade.»<verse eid="JER 48:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JER 48:40" />Duuchchi Woddik Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 48:40">«Yoona sinbiriinsha guule iso'ni hana iba'ni,</para>
  <para style="q2" vid="JER 48:40">keelakanna Mo'aabi'ni farri assaan.<verse eid="JER 48:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="JER 48:41" />Qachchuwwakanna lolle abindaan;</para>
  <para style="q2" vid="JER 48:41">kolluwwatanna abindan;</para>
  <para style="q1" vid="JER 48:41">Eettene barra Mo'aaabiki loliink manni qalbe;</para>
  <para style="q2" vid="JER 48:41">ciniiffattaaxxe manjichchoshsha kaddaan.<verse eid="JER 48:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 48:42" />Mo'aabi Duuchchi Woddika Gootta tuffattemmaxxemma ba'aan;</para>
  <para style="q2" vid="JER 48:42">moyanjumma isixxinna gattaan.<verse eid="JER 48:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 48:43" />Koo, Mo'aabike arda;</para>
  <para style="q2" vid="JER 48:43">weekenshanna balen, fonxorotinna ate'e heqqitaen»</para>
  <para style="q2" vid="JER 48:43">hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 48:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="JER 48:44" />«Weekenshatenaa'n baajaki duuchchi,</para>
  <para style="q2" vid="JER 48:44">bale giddo ibaan;</para>
  <para style="q1" vid="JER 48:44">Baletenaa'n fulaaki</para>
  <para style="q2" vid="JER 48:44">fonxoroti abidemaan;</para>
  <para style="q1" vid="JER 48:44">Mo'aabii'i xixannoxxi wogga daggaan,»</para>
  <para style="q2" vid="JER 48:44">hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 48:44" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="45" style="v" sid="JER 48:45" />«Mo'aabika alba,</para>
  <para style="q2" vid="JER 48:45">gamo isixxixxa sammo gubbaaxxi</para>
  <para style="q1" vid="JER 48:45">Giira Haseboo'ni,</para>
  <para style="q2" vid="JER 48:45">bubenjikinna Sihoonike minenaa'ni fule'en;</para>
  <para style="q1" vid="JER 48:45">Baqatammakir Haseebonike gaaddisi hunda,</para>
  <para style="q2" vid="JER 48:45">gollifate kadaaxa gopher uure'en.<verse eid="JER 48:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 48:46" />Koo, Mo'aabi aane ati'a!</para>
  <para style="q2" vid="JER 48:46">Kaamoshik ardi kutti hiyye'en;</para>
  <para style="q1" vid="JER 48:46">Labbaxxi atixxi oosenna booji'ende mete'en;</para>
  <para style="q2" vid="JER 48:46">meyyaxxi atixxi oosenna adheende me'iteen.<verse eid="JER 48:46" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="47" style="v" sid="JER 48:47" />«Yaane kinni udumi uduma,</para>
  <para style="q2" vid="JER 48:47">Mo'aabixxa booji'o hiisannon,»</para>
  <para style="q2" vid="JER 48:47">hiyya'neen Duuchchi Woddiki Gootti.</para>
  <para style="p" vid="JER 48:47">Mo'aabi'ni murendeexxi murte tenneten.<verse eid="JER 48:47" /></para>
  <chapter eid="JER 48" />
  <chapter number="49" style="c" sid="JER 49" />
  <para style="s1">Amoonixxee Haaso'endeexxa Erga</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 49:1" />Amoontotee:</para>
  <para style="b" vid="JER 49:1" />
  <para style="p" vid="JER 49:1">Duuchchi Woddiki Gootti Amoonixxee hiyyee qici,</para>
  <para style="q1" vid="JER 49:1">«Isira'eel labbaxxa oose afebaa?</para>
  <para style="q2" vid="JER 49:1">isee dhaalaakara afebaa?</para>
  <para style="q1" vid="JER 49:1">Miilikoom Gaadii'i mayee dhaale?</para>
  <para style="q2" vid="JER 49:1">Iski manni mayye'e qachchuwwi giddo hedha'nee?<note caller="-" style="x"><char style="xo" closed="false">49:1 </char><char style="xt" closed="false"><ref loc="EZK 21:28-32">Hiz. 21:28-32</ref>; <ref loc="EZK 25:1-7">25:1-7</ref>; <ref loc="AMO 1:13-15">Amo. 1:13-15</ref>; <ref loc="ZEP 2:8-11">Sof. 2:8-11</ref>. </char></note><verse eid="JER 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 49:2" />Tennexxee Amoonitotike qachcha'n Raabati'n hana,</para>
  <para style="q2" vid="JER 49:2">lolinke canca,</para>
  <para style="q1" vid="JER 49:2">Laqemaaxxi yanna daggaani»</para>
  <para style="q2" vid="JER 49:2">hiyya'neeni Duuchchi Woddiki Gootti,</para>
  <para style="q1" vid="JER 49:2">«Isenna oletixxe tuulo kadaani;</para>
  <para style="q2" vid="JER 49:2">qarqara iseke'n hedheeke ola'uwi gubataani;</para>
  <para style="q1" vid="JER 49:2">Isira'eelina ise'e bogakenaa'ni fulchchemmaka;</para>
  <para style="q2" vid="JER 49:2">iseenna boga ifikenaa'n fulchchitaani»</para>
  <para style="q2" vid="JER 49:2">hiyya'neeni Duuchchi Woddiki Gootti.<verse eid="JER 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 49:3" />«Koo Asebooni; Gaayi diigendemmaxxe'e woo hitine oodhe;</para>
  <para style="q2" vid="JER 49:3">koo Raaba hexxineeke dubarruwwa raarre;</para>
  <para style="q1" vid="JER 49:3">Yaqadotixxa seemma oddo'witine oodhe;</para>
  <para style="q2" vid="JER 49:3">Milkool qeesoletinna jalqabuwwik welti,</para>
  <para style="q1" vid="JER 49:3">Boojie'emme me'inaan;</para>
  <para style="q2" vid="JER 49:3">dalla'i giddo elqe kayya gonge.<verse eid="JER 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 49:4" />Tee finqildeetexxe belto,</para>
  <para style="q2" vid="JER 49:4">dhooquwwa atixxe'ni mayee'e hollitaate?</para>
  <para style="q1" vid="JER 49:4">Karra callixxe atixxe dhooqaxe'e mayee'e ifi saadate?</para>
  <para style="q2" vid="JER 49:4">Durumma adde assexxe,</para>
  <para style="q2" vid="JER 49:4">‹Ayyete ane'e tuqa dande'aki?› hitaaten.<verse eid="JER 49:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 49:5" />Qarqara atike'ni hedheeki duuchchi</para>
  <para style="q2" vid="JER 49:5">weekemmaashsha assannon»</para>
  <para style="q2" vid="JER 49:5">hiyya'neen lumoki Duuchchi Woddiki Gootti.</para>
  <para style="q1" vid="JER 49:5">«Mitti mitti ha'noog shorredinaan;</para>
  <para style="q2" vid="JER 49:5">baqake'n hedheeka manna bukki assak hedhebaan.<verse eid="JER 49:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JER 49:6" />«Ookkonechchi uduma kinn Amoonike mannixxa booji'o hiisannon»</para>
  <para style="q1" vid="JER 49:6">Hiyyaa'neen Duuchchi Woddiki Gootti.<verse eid="JER 49:6" /></para>
  <para style="s1">Eegoomixxe'e Kulemeeka Hiyyichcho</para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 49:7" />Eedoomixxe'e.</para>
  <para style="b" vid="JER 49:7" />
  <para style="p" vid="JER 49:7">Lumoki Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 49:7">«Temaani'ni beekkum gopheme'e?</para>
  <para style="q2" vid="JER 49:7">Gorsi beekkoletena'ni bayyete'e?</para>
  <para style="q1" vid="JER 49:7">Beekumi insa'nenaa'ni mude'e?<note caller="-" style="x"><char style="xo" closed="false">49:7 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">Isa. 34:5-17</ref>; <ref loc="ISA 63:1-6">63:1-6</ref>; <ref loc="EZK 25:12-14">Hiz. 25:12-14</ref>; <ref loc="EZK 35:1-5">35:1-5</ref>; <ref loc="AMO 1:11-12">Amo. 1:11-12</ref>; <ref loc="HEB 1:14">Ibr. 1:14</ref>; <ref loc="MAL 1:2-5">Mil. 1:2-5</ref>. </char></note><verse eid="JER 49:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 49:8" />Eesaawu'u xixannoxxa yanna,</para>
  <para style="q2" vid="JER 49:8">ba'ne geesisaanaxxe'e;</para>
  <para style="q1" vid="JER 49:8">Ha'no Diidani'i hexxina'neke;</para>
  <para style="q2" vid="JER 49:8">udumi'a higinne baaje; qeeraxxe bale giddo sho'omme.<verse eid="JER 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 49:9" />Woyinetixxa gumma qocedhammakir atibaa dagoole;</para>
  <para style="q2" vid="JER 49:9">shiixxoxxa woyinetixxa gumma ati'a gatisabaa?</para>
  <para style="q1" vid="JER 49:9">Moodhalshe hashsha daggoole,</para>
  <para style="q2" vid="JER 49:9">harsinaachcho calla moodhinabaa?<verse eid="JER 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 49:10" />Ani kinni Eesaawu'u duwwi gatisannon;</para>
  <para style="q2" vid="JER 49:10">sho'oma dande'abaasha</para>
  <para style="q2" vid="JER 49:10">sho'omeemmaka booncho farri assannon;</para>
  <para style="q1" vid="JER 49:10">Oose, firuwikinna olla'uwwi isiki ba'aani;</para>
  <para style="q2" vid="JER 49:10">isi umi ifinginn hedhabaan.<verse eid="JER 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 49:11" />Anna ama affeebaaxxa oose waali; ani insa'nexxe lubbo'a xexxe'atannon; aro'i reyemaxxi melaaluwwa ane'ni addatowwaal» hiyye.<verse eid="JER 49:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 49:12" />Duuchchi Woddiki Gootti hiyya'nee qici: «Buudatenaa'ni ha'wa hasissaabake ha'wa insa'ne'a hasissa'noole, ati hittaatta xixxichchibelo gattatto? Xixema atixxi gattabaan; ha'wa ati'a hasissaan. <verse eid="JER 49:12" /><verse number="13" style="v" sid="JER 49:13" />Bootsira diigende alayiinxe, oso'lichinxenna yowwinke beesisa kaddaaxxa ani ifi'a kakateenen» hiyya'neen Duuchchi Woddiki Gootti. «Qachchuwwi iseki duuchchinna duuchchii woddi'a urme gataan»<verse eid="JER 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 49:14" />Duuchchi Woddike Gootti erge'exxa mitte erga laqe'enen;</para>
  <para style="q2" vid="JER 49:14">«Edomike lollo'a bukki hine!</para>
  <para style="q1" vid="JER 49:14">Duulo fulle!»</para>
  <para style="q2" vid="JER 49:14">hiyyaak erganji gosa gosake arduwwibaa ergeme'en.<verse eid="JER 49:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JER 49:15" />«Yoona; gosa gosake arduwwi giddo maa'na,</para>
  <para style="q2" vid="JER 49:15">manniixxe oddo'ninni tuffatendeeteke assannon.<verse eid="JER 49:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 49:16" />Ati rassa callike bowwa'nni hexxaateki,</para>
  <para style="q2" vid="JER 49:16">koobatixxe xuungo qico'ni gelteetek;</para>
  <para style="q1" vid="JER 49:16">Sodaachchisa atixxinna</para>
  <para style="q2" vid="JER 49:16">qalbeti giddo hollitaattexxi holla atee sobbeen;</para>
  <para style="q1" vid="JER 49:16">Mine xungote'n sinbriinsha ijaadhitotolenna;</para>
  <para style="q2" vid="JER 49:16">ookko'ni butti'a atee'e ibisannon»</para>
  <para style="q2" vid="JER 49:16">hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 49:17" />«Eedoomi alayyiinke beessisa kaddaan;</para>
  <para style="q2" vid="JER 49:17">gelteexxe ba'ne duuchchanaa'n kexxeexxa,</para>
  <para style="q2" vid="JER 49:17">ookkone ora sa'aaki duuchchi mambe'a hiyya'ni cee'man.<verse eid="JER 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 49:18" />Qarqara insa'neke'n hedheeke qachchuwwinn welti;</para>
  <para style="q2" vid="JER 49:18">Soodoominna Gomora baxxemmashshan,»</para>
  <para style="q2" vid="JER 49:18">hiyya'neen Duuchchi Woddik Gootti.</para>
  <para style="q1" vid="JER 49:18">Iittanni ayyinna ookko'o hedhabaan;</para>
  <para style="q2" vid="JER 49:18">mitti manjinna ookko'o hedhabaan.<note caller="-" style="x"><char style="xo" closed="false">49:18 </char><char style="xt" closed="false"><ref loc="GEN 19:24-25">Dada. 19:24-25</ref>. </char></note><verse eid="JER 49:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JER 49:19" />«Neenqi Yordaanoosike gongomibaa'n;</para>
  <para style="q2" vid="JER 49:19">hore allallammake diidibaa fullammashsha;</para>
  <para style="q1" vid="JER 49:19">Aninna dedhange'n Edoomi'n dagannon; bogakena'ninna isoo shorrannon.</para>
  <para style="q2" vid="JER 49:19">Ani fi'leenneka isixxe bakka'ni hariirannon; anishsha hedheek ayyete?</para>
  <para style="q1" vid="JER 49:19">Ayyete anee hoyya dande'aki?</para>
  <para style="q2" vid="JER 49:19">Hoone allalissanjo anee uursa dande'aak?»<verse eid="JER 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 49:20" />Tennexxee Duuchchi Woddiki Gootti Eedoomi'ni afeeka yaada;</para>
  <para style="q2" vid="JER 49:20">Temaani'n hedha'nekera hede'eka yaada laqqe;</para>
  <para style="q1" vid="JER 49:20">Shishshiixarramma horiinka haagana harkinse adhdhine me'inaan;</para>
  <para style="q2" vid="JER 49:20">insa'nexxe buuton allallaammaxxa bakka ca'asse balleesan.<verse eid="JER 49:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 49:21" />Iba insa'nexike hafuurnni buttini linqi linqi hiyyaan;</para>
  <para style="q2" vid="JER 49:21">insa'nexxi raarenna Diimmoxxe Abaaya qico'ni laqissaan.<verse eid="JER 49:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 49:22" />Kunnise Sinbiriinsha guule ise'ni ibaan;</para>
  <para style="q2" vid="JER 49:22">keelakanna Bootsira'ni farri assaan;</para>
  <para style="q1" vid="JER 49:22">Eettenee barra Eedoomike loliinke mannixxi qalbe;</para>
  <para style="q2" vid="JER 49:22">ciniifatammaxxe manjichchoxxe qalbeshsha kaddaan.<verse eid="JER 49:22" /></para>
  <para style="s1">Deemaasiqqoxxee Haaso'endeexxa Erga</para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 49:23" />Demasiqoxxee;</para>
  <para style="q1" vid="JER 49:23">«Elobaaxxa odo lanqemmaxxee;</para>
  <para style="q2" vid="JER 49:23">Hamaatinna Arifaadi alane'een;</para>
  <para style="q1" vid="JER 49:23">Abbaayatike danbala'ishsha daanqe'en;</para>
  <para style="q2" vid="JER 49:23">qalbetinna weekkende'een.<note caller="-" style="x"><char style="xo" closed="false">49:23 </char><char style="xt" closed="false"><ref loc="ISA 17:1-3">Isa. 17:1-3</ref>; <ref loc="AMO 1:3-5">Amo. 1:3-5</ref>; <ref loc="ZEC 9:1">Zek. 9:1</ref>. </char></note><verse eid="JER 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 49:24" />Demasiqo gophphe'en;</para>
  <para style="q2" vid="JER 49:24">baajo'a udumi'a higge;</para>
  <para style="q2" vid="JER 49:24">soda'a abidde,</para>
  <para style="q1" vid="JER 49:24">Ciniifatammaxxe manjichchoshsha,</para>
  <para style="q2" vid="JER 49:24">rakkotinna abari giddo e'yite.<verse eid="JER 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 49:25" />Ani gammadaaneki;</para>
  <para style="q2" vid="JER 49:25">ege'nemmeek qachchi hitta gibeme?<verse eid="JER 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 49:26" />Dhugaandinni labbaxxi dargaggeeyyuwwa weldeena weldeenade'n ibbaan;</para>
  <para style="q2" vid="JER 49:26">eettenne barra'n lolinnki manni duuchchi ibaan»</para>
  <para style="q2" vid="JER 49:26">hiyya'neen lumoki Duuchchi Woddiki Gootti.<verse eid="JER 49:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 49:27" />«Demasiqoke dalla'a'ni giira worannon;</para>
  <para style="q2" vid="JER 49:27">Beenihadaadika utupha giira ittaan» hiyye.<verse eid="JER 49:27" /></para>
  <para style="s1">Qedaarxenna Hatsoorixxe'e Kulndeexxa Erga</para>
  <para style="p">
    <verse number="28" style="v" sid="JER 49:28" />Baabiloonik moyanji Nabukadanatsoori insa'ne lolemmaxxee Qeedarixxenna Hatsoorixxe mootummuwwa kulendeexxi. Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 49:28">«Ke'we, Qedaarii loldine'e</para>
  <para style="q2" vid="JER 49:28">borotika arda birre.<verse eid="JER 49:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 49:29" />Insa'neki dunkaaninna horiiniiki haagan insa'neki adhdhemaa;</para>
  <para style="q2" vid="JER 49:29">fooqo insa'nekanna gaaluwwi gatebaang;</para>
  <para style="q2" vid="JER 49:29">miyuwinginn adhdhinaan manni,</para>
  <para style="q1" vid="JER 49:29">Manni ‹Ori orinaa'inn weekensha insa'ne'ni daggeen!›</para>
  <para style="q2" vid="JER 49:29">hina'nee insa'ne'ni cancinaan.<verse eid="JER 49:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 49:30" />«Koo Hasoor'ni hexxina'neeri,</para>
  <para style="q2" vid="JER 49:30">rakkine baajje! Qeerraxxe bale giddo sho'omme»</para>
  <para style="q4" vid="JER 49:30">hiyya'neen Duuchchi Woddiki Gootti.</para>
  <para style="q1" vid="JER 49:30">«Baabiloonik moyanji Nabukadanatsoori ha'nooxxe mari'attemmaxxenna:</para>
  <para style="q2" vid="JER 49:30">fuggoxxa ha'no'aa hedeen.<verse eid="JER 49:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 49:31" />«Ke'we, mitte riffii belo ofo'leeka;</para>
  <para style="q2" vid="JER 49:31">ifi'ni addate hedha'neka gosa gosaka arda lolle»</para>
  <para style="q4" vid="JER 49:31">hiyya'neen Duuchchi Woddik Gootti.</para>
  <para style="q1" vid="JER 49:31">«Cufannakanna danqarissanjo afebaake;</para>
  <para style="q2" vid="JER 49:31">qoftinni hedha'neke gosa gosake arda'ni duulle.<verse eid="JER 49:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 49:32" />Gaaluwwa insa'neka boojinaan;</para>
  <para style="q2" vid="JER 49:32">horuwwa insa'neka bukki assine oolfinaani;</para>
  <para style="q1" vid="JER 49:32">Umo qooxxo haaxxeeka manna ora ora'ninni uggannoni;</para>
  <para style="q2" vid="JER 49:32">ori orinaa'ni ba'ne insa'ne'ni geessisannoni»</para>
  <para style="q4" vid="JER 49:32">hiyya'neeni Duuchchi Woddiki Gootti.<verse eid="JER 49:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 49:33" />«Hatsoori jeedali burraqaaba,</para>
  <para style="q2" vid="JER 49:33">duuchchii woddi'a gongoma kaddaan</para>
  <para style="q1" vid="JER 49:33">Ayyinna ookkoo hedhdhabaani;</para>
  <para style="q2" vid="JER 49:33">okkonna ofo'laaki afemabaani.»<verse eid="JER 49:33" /></para>
  <para style="s1">Elaamxxee Kulendeexxa Erga</para>
  <para style="p">
    <verse number="34" style="v" sid="JER 49:34" />Yihudiinki moyanji Sedeeqiyaasi moyemmake baro'n sirende'ni wabeekichcho Ermiyaasibaa dageek Duuchchi Woddike Goottik hiyyichchi konneten:<verse eid="JER 49:34" /></para>
  <para style="b" />
  <para style="p">
    <verse number="35" style="v" sid="JER 49:35" />Dada Duuchcha Ajajaaki Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 49:35">«Kunni hunnatixxa booso;</para>
  <para style="q2" vid="JER 49:35">Elaamixxa gabe enqannoni.<verse eid="JER 49:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 49:36" />Shoole iimatike kasuwwanaa'n;</para>
  <para style="q2" vid="JER 49:36">Elaami'n shoole diidallo idagannoni;</para>
  <para style="q1" vid="JER 49:36">Shooliinxe diidallobaa insa'ne xexxerannoni;</para>
  <para style="q2" vid="JER 49:36">Elaamii'ni booji'emeekiir ginnabaak;</para>
  <para style="q2" vid="JER 49:36">bogi hedhabaani.<verse eid="JER 49:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 49:37" />Lubbo insa'nexxa shiwo'a hasaake naaphphi insa'neki edo,</para>
  <para style="q2" vid="JER 49:37">Elaamiki culphisashsha assannoni;</para>
  <para style="q1" vid="JER 49:37">Insa'ne'ni ba'nenna mufe anixxa insa'ne'ni dirrisannoni»</para>
  <para style="q3" vid="JER 49:37">hiyya'neeni Duuchchi Woddiki Gootti.</para>
  <para style="q1" vid="JER 49:37">«Insa'ne'e kutti asse biranno qico'ni</para>
  <para style="q2" vid="JER 49:37">wolaantichchik shorrannon.<verse eid="JER 49:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 49:38" />Moote anixxa Elaami'i uggadhdhannon;</para>
  <para style="q2" vid="JER 49:38">moyanjuwwakanna jalqabuwwa birannon»</para>
  <para style="q3" vid="JER 49:38">hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 49:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="JER 49:39" />«Yaane kinni udumi uduma;</para>
  <para style="q2" vid="JER 49:39">Elaamixxa booji'o hiissannoni»</para>
  <para style="q3" vid="JER 49:39">hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 49:39" /></para>
  <chapter eid="JER 49" />
  <chapter number="50" style="c" sid="JER 50" />
  <para style="s1">Baabiloonixxee Kulemeeka Wabeekumma</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 50:1" />Duuchchi Woddik Gootti Baabiloonixxenna Baabiloiniike bogixxe'e; waabeekichcho Ermiyaasi hiyye haaso'ee qici:<note caller="-" style="x"><char style="xo" closed="false">50:1—51:64 </char><char style="xt" closed="false"><ref loc="ISA 13:1-14:23">Isa. 13:1—14:23</ref>; <ref loc="ISA 47:1-15">47:1-15</ref>. </char></note><verse eid="JER 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 50:2" />«Gosa gasake arda duuchchixxe oddo'ni haaso'e,</para>
  <para style="q2" vid="JER 50:2">ege'nishshe beesisnka baandira iimi'a abidinexxi lallabbe;</para>
  <para style="q2" vid="JER 50:2">Haranga mittelchonna gatissinebaang hitinaa qici,</para>
  <para style="q1" vid="JER 50:2">‹Baabiloon abidenda'neen;</para>
  <para style="q2" vid="JER 50:2">Beeli salphataan;</para>
  <para style="q2" vid="JER 50:2">Marduuki weekeman;</para>
  <para style="q1" vid="JER 50:2">Fakkuwwa salphattaan;</para>
  <para style="q2" vid="JER 50:2">magenoofantammalchchuwwiri weekemaan.›<verse eid="JER 50:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 50:3" />Middii'ni moyanji dage lolaan;</para>
  <para style="q2" vid="JER 50:3">bogakanna urumake assaan;</para>
  <para style="q1" vid="JER 50:3">Ookko hedhaaki hedhabaan manjinna horuwwi baqate luggaan.<verse eid="JER 50:3" /></para>
  <para style="s1">Isira'eelixxa Illeema Higa</para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JER 50:4" />«Ookkone baro'ni; eettene yanna'ninna»</para>
  <para style="q2" vid="JER 50:4">hiyya'neen Duuchchi Woddiki Gootti.</para>
  <para style="q1" vid="JER 50:4">«Isira'eelik ardinna Yihudiink ardi mitteba dagaan</para>
  <para style="q2" vid="JER 50:4">Insa'neeka Duuchchi Woddika Gootta Mageno harsinaa'ni oo'na'ni dangaan.<verse eid="JER 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 50:5" />Tsiyooni'i geessisaka ora qo'dhdhinaan;</para>
  <para style="q2" vid="JER 50:5">ookkone ora me'inaan.</para>
  <para style="q1" vid="JER 50:5">Dangeexxi hara dedhendabaaxxa,</para>
  <para style="q2" vid="JER 50:5">duuchchi woddixxe kakonni,</para>
  <para style="q2" vid="JER 50:5">Duuchchi Woddike Goottin welti mittoommaan.<verse eid="JER 50:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JER 50:6" />«Ardi anki ba'eke gedhebo kadeen;</para>
  <para style="q2" vid="JER 50:6">insa'neexxi lallalisano insa'ne dedhiseen;</para>
  <para style="q2" vid="JER 50:6">koobuwwate'ni xeeremme ba'naashsha assine koobate'n;</para>
  <para style="q1" vid="JER 50:6">Tulluchchuwwake'n doonsakiyya hine;</para>
  <para style="q2" vid="JER 50:6">goodhe ifixxanna dedheen.<verse eid="JER 50:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 50:7" />Futti hiyyeechchi insa'nee itaan;</para>
  <para style="q2" vid="JER 50:7">naaphuwwi insa'nek, ‹No'o belleessanotbaan; insa'ne edike annuwwi;</para>
  <para style="q1" vid="JER 50:7">Insa'nekixxa adde Duuchchi Woddika Gootta;</para>
  <para style="q2" vid="JER 50:7">dhugaatike insa'neke galduma kadee'eka; Duuchchi Woddika Gootta balleesine'en› ha'no hiyye.<verse eid="JER 50:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JER 50:8" />«Baabilooni'ni baajine;</para>
  <para style="q2" vid="JER 50:8">Baabilonke mannika boga waale;</para>
  <para style="q2" vid="JER 50:8">hori edo me'aammake recco kadde.<note caller="-" style="x"><char style="xo" closed="false">50:8 </char><char style="xt" closed="false"><ref loc="REV 18:4">Wal. 18:4</ref>. </char></note><verse eid="JER 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 50:9" />Jajjaba gosa gosake moyanjuwinka orga;</para>
  <para style="q2" vid="JER 50:9">middii'ni Baabiloni'ni ke'isanon;</para>
  <para style="q1" vid="JER 50:9">Insa'nenna Baabilooni'n duulan danigeexxi abidaan,</para>
  <para style="q2" vid="JER 50:9">insa'nenna ise'ni duullaani;</para>
  <para style="q1" vid="JER 50:9">Gabuwwa insa'nexxi duwwixxe anganni higgabaasha;</para>
  <para style="q2" vid="JER 50:9">tola higgaamasha adhe barateke loliinke mannishshaten.<verse eid="JER 50:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 50:10" />Baabilooni bogi saamemaan;</para>
  <para style="q2" vid="JER 50:10">saamammaki alfeechcho duuchcha geyaaqico'ni adhdhaan»</para>
  <para style="q3" vid="JER 50:10">hiyya'nen Duuchchi Woddiki Gootti.<verse eid="JER 50:10" /></para>
  <para style="s1">Baabiloonxa Iba</para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 50:11" />«Ha'no karra anxa saandineeki;</para>
  <para style="q2" vid="JER 50:11">gammadineexxenna ililissinemmaxxe'e;</para>
  <para style="q1" vid="JER 50:11">Diidake'ni burraaqqammake goronsishsha;</para>
  <para style="q2" vid="JER 50:11">kormi fadhachchisha himimmisinemmaxxe'e;<verse eid="JER 50:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 50:12" />Ama ho'nooxxi yo'oshsha shookan;</para>
  <para style="q2" vid="JER 50:12">ha'no ildemmaxxinna salphattaan.</para>
  <para style="q1" vid="JER 50:12">Isenna qiila gammooje'ni; bagoke boginna umoke'na;</para>
  <para style="q2" vid="JER 50:12">gosa gosake moyanjuwwa duuchchana'ni shiixexxeexxe kaddan.<verse eid="JER 50:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 50:13" />Duuchchi Woddike Goottixxe mufenaa'ni kexxeexxa urumake kaddaa malee'e;</para>
  <para style="q2" vid="JER 50:13">ookko'o ayyinna hedhabaan;</para>
  <para style="q1" vid="JER 50:13">Baabiloon'ni gelteexxe ba'ne duuchchixxe buuto'a;</para>
  <para style="q2" vid="JER 50:13">ooko'ni sa'aki duuchchi mambe'a hiyya'ni cooraan.<verse eid="JER 50:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 50:14" />«Ha'no gabe darbatinake duuchchi;</para>
  <para style="q2" vid="JER 50:14">Baabiloonii'i elqe kayyii'n buqqe;</para>
  <para style="q1" vid="JER 50:14">Mogiduwwa duuchcha gatissinebaang darbe;</para>
  <para style="q2" vid="JER 50:14">Duuchchi Woddike Gootti edo cubbo hujjeemmaxxeeten.<verse eid="JER 50:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 50:15" />Erqe kayyii'ninn Baabilooni'ni raarre!</para>
  <para style="q2" vid="JER 50:15">Anga uutaan kinjiinki dalla'uwwinna ibaan;</para>
  <para style="q2" vid="JER 50:15">dalla'uwikinna diigeman.</para>
  <para style="q2" vid="JER 50:15">Tinni Duuchchi Woddiki Gootti halo fula'neexxen;</para>
  <para style="q1" vid="JER 50:15">Baabiloni'ni halo fulle;</para>
  <para style="q2" vid="JER 50:15">wele manna'ni assitemmashshanni ha'noonna Baabilooni'n asse.<verse eid="JER 50:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 50:16" />Baabilooni'ni midha facaasaka;</para>
  <para style="q2" vid="JER 50:16">haamatixxe yanna'ni haanto abixxe haamamaka birre;</para>
  <para style="q1" vid="JER 50:16">Balleessake wolaantichanaa'ni kexxeexxa;</para>
  <para style="q2" vid="JER 50:16">mitti mitting ifi ifike ardiba higowaali;</para>
  <para style="q2" vid="JER 50:16">ifi ifike bogiba'a baajjowwaal.<verse eid="JER 50:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JER 50:17" />«Isira'eeli neenquwwi shorreeke;</para>
  <para style="q2" vid="JER 50:17">xexxeeremeke hornke bobba'an;</para>
  <para style="q1" vid="JER 50:17">Taakaba Asoorik moyanji;</para>
  <para style="q2" vid="JER 50:17">ninnife iteeni;</para>
  <para style="q1" vid="JER 50:17">Okkoneechchi uduma Baabiloonik moyanji Naabukadanatsoor;</para>
  <para style="q2" vid="JER 50:17">micco anniise.»<verse eid="JER 50:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="JER 50:18" />Tennexxee Dada Duuchcha ajajaak Duuchchi woddiki Gootti Isira'eelik Mageni hiyya'nee qici:</para>
  <para style="q1" vid="JER 50:18">«Asoorika moyanjo xixenneshshanni</para>
  <para style="q2" vid="JER 50:18">Baabiloonika moyanjonna boga isika xixaannon.<verse eid="JER 50:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 50:19" />Isira'eelinna bobbaalsinaba'a hiissannon;</para>
  <para style="q2" vid="JER 50:19">Qeermeeloosi'ninna Baasani'a bobba'an;</para>
  <para style="q1" vid="JER 50:19">Efreemixxe kooba'ninna Gele'adi'n</para>
  <para style="q2" vid="JER 50:19">goddaqico'ni itaan.<verse eid="JER 50:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 50:20" />Ettenne yannana'ninna ookkone baro'ni,» hiyya'neen Duuchchi Woddik Gootti,</para>
  <para style="q2" vid="JER 50:20">«Isira'eelixxenna Yihudaxxe mootumma giddii'ni,</para>
  <para style="q1" vid="JER 50:20">Hafe gattaashsha asseenneke mannixxa,</para>
  <para style="q2" vid="JER 50:20">cubbo gattowwaal hiyyaannaxxe'e,</para>
  <para style="q1" vid="JER 50:20">Cubbonna balleessa insa'ne'ni hanse anfabaan.</para>
  <para style="q2" vid="JER 50:20">Hiyya'neen Duuchchi Woddik Gootti.<verse eid="JER 50:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JER 50:21" />«Miratayiimka boga,</para>
  <para style="q2" vid="JER 50:21">Feqoodi giddo he'na'neeka,</para>
  <para style="q1" vid="JER 50:21">Shoorishshe, insa'ne'e shiltine birre, bakka insa'nexxa balleese,»</para>
  <para style="q3" vid="JER 50:21">hiyya'neni Duuchchi Woddiki Gootti.</para>
  <para style="q2" vid="JER 50:21">«Ani ha'noo ajajennexxa duuchcha asse.<verse eid="JER 50:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 50:22" />Bogake'n loliinki cancci,</para>
  <para style="q2" vid="JER 50:22">jabaaxxe ba'neki haafuri laqeme.<verse eid="JER 50:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 50:23" />Bogi duuchchiki burrisi,</para>
  <para style="q2" vid="JER 50:23">hitta enqeme! Hitta kade bullo'e!</para>
  <para style="q1" vid="JER 50:23">Gosa gosake ardi giddo;</para>
  <para style="q2" vid="JER 50:23">Baabiloon hitta kade urimake kade!<verse eid="JER 50:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 50:24" />Tee, Baabiloon! Fonxoro ati'a fayyenneni,</para>
  <para style="q2" vid="JER 50:24">atina egendebexxongi abidendeeteni;</para>
  <para style="q1" vid="JER 50:24">Duuchchi Woddike Gootta'n fugoxxini kexxe;</para>
  <para style="q2" vid="JER 50:24">afeendetaxxe, abidendeeteni.<verse eid="JER 50:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 50:25" />Duuchchi Woddiki Gootti mi'yinka mine bane'en;</para>
  <para style="q2" vid="JER 50:25">mufetika lolinka miya fulche'en;</para>
  <para style="q1" vid="JER 50:25">Lumoki Duuchchi Woddilki Gootti;</para>
  <para style="q2" vid="JER 50:25">Baabiloonke baga'ni hujete afe'en.<verse eid="JER 50:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 50:26" />Bayyii'ni daggine Baabilooni'ni duule;</para>
  <para style="q2" vid="JER 50:26">doone midha aase'nammaxxa banne;</para>
  <para style="q2" vid="JER 50:26">midha tuullammashsha tuulle.</para>
  <para style="q1" vid="JER 50:26">Hara kutti assitine birre</para>
  <para style="q2" vid="JER 50:26">iseelchi mittilchinna gatoqqe'e.<verse eid="JER 50:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 50:27" />Dullammabaa'a iyyemartine'e!</para>
  <para style="q2" vid="JER 50:27">Iseka jiboota duuchcha dulle;</para>
  <para style="q1" vid="JER 50:27">Xixxichcho adhdhinaaxxi yanna,</para>
  <para style="q2" vid="JER 50:27">barra insa'nexxi gelteemaxxe'e insa'ne'a aane!<verse eid="JER 50:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 50:28" />Duuchchi Woddiki Gootti no'ok Mageni halo fulemmaka;</para>
  <para style="q2" vid="JER 50:28">galma ifike fulemmaxxa halo;</para>
  <para style="q1" vid="JER 50:28">Baabilooni'n booji'eme dagemmakinna shorremeemmakir,</para>
  <para style="q2" vid="JER 50:28">Tsiyooni'i haasonna'neexxa laqe.<verse eid="JER 50:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 50:29" />«Gabe darbatamakar,</para>
  <para style="q2" vid="JER 50:29">gabetika manna duuchcha Baabilooni'a ye'we;</para>
  <para style="q1" vid="JER 50:29">Mitti manjinna baaje fulabaasha;</para>
  <para style="q2" vid="JER 50:29">ookone qarqara duuchchanna erqe kayyi'ni buqqe;</para>
  <para style="q1" vid="JER 50:29">Isira'eelika Woyyichcha;</para>
  <para style="q2" vid="JER 50:29">Duuchchi Woddika Gootta tuffatemmaxxe'e;</para>
  <para style="q1" vid="JER 50:29">Huje isexxishshann ise'a bado hiise;</para>
  <para style="q2" vid="JER 50:29">weleke'ni assitemmashshann ise'ninna asse.<note caller="-" style="x"><char style="xo" closed="false">50:29 </char><char style="xt" closed="false"><ref loc="REV 18:6">Wal. 18:6</ref>. </char></note><verse eid="JER 50:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 50:30" />Tennexxee labbaxxi isexxi dargaggeeyye weldeenna weldeenade'ni ibbaan;</para>
  <para style="q2" vid="JER 50:30">eettenee barra loliink manni duuchchi ibaan,»</para>
  <para style="q2" vid="JER 50:30">hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 50:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 50:31" />«Koo hollaameesi; kunse ate'ni ke'eennen,»</para>
  <para style="q2" vid="JER 50:31">hiyya'neen lumoki Duuchchi Woddiki Gootti,</para>
  <para style="q1" vid="JER 50:31">«Ati xixxichcho adhitatoxxi yanna; barra atixxi gelte'een.<verse eid="JER 50:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 50:32" />Hollaamesi guggufate ibaan</para>
  <para style="q2" vid="JER 50:32">iso'o ke'isaakinna hedhebaan;</para>
  <para style="q1" vid="JER 50:32">Qarqara isike'ni hedheeka duuchcha ittaaxxi giira</para>
  <para style="q2" vid="JER 50:32">qachchuwwi giddii'ni ke'issannon.»<verse eid="JER 50:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JER 50:33" />Lumoki Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q2" vid="JER 50:33">«Isira'eelikinna Yihudaki ardi miiceme'een;</para>
  <para style="q1" vid="JER 50:33">Insa'ne booje'emaki duuchchi goggodo insa'ne'n godhateen;</para>
  <para style="q2" vid="JER 50:33">wocci assinabo'non hiyye gibeen.<verse eid="JER 50:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 50:34" />Yaane kinni insa'ne'e gargaara'nik hunnaameessaken;</para>
  <para style="q2" vid="JER 50:34">summi isikinna lumoke Duuchchi Woddike Goottan.</para>
  <para style="q1" vid="JER 50:34">Boga insa'neeke'e hafuura adhdhiso'a</para>
  <para style="q2" vid="JER 50:34">jabaqicin insa'ne'a baasan;</para>
  <para style="q2" vid="JER 50:34">Baabiloon hedha'neekiir kinn nage'a alfinabaan.<verse eid="JER 50:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="JER 50:35" />«Wolaantichchi Baabiloonike arda'ni dage»</para>
  <para style="q2" vid="JER 50:35">hiyya'neen Duuchchi Woddiki Gootti.</para>
  <para style="q1" vid="JER 50:35">«Baabilooni hedha'neeke arda'n ja'laabuwwa insa'neke'inna beekole insa'nexe'n wolaanti ke'owaal!<verse eid="JER 50:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 50:36" />Dhariyye wabeekoole'n wolaantchchi dage;</para>
  <para style="q2" vid="JER 50:36">insa'nenna gowwolete kandaani;</para>
  <para style="q1" vid="JER 50:36">Insa'neke lolinke manna'ni wolaantichcha wirri assine;</para>
  <para style="q2" vid="JER 50:36">insa'nena sodaante culphphinsaani.<verse eid="JER 50:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 50:37" />Wolaantichchi fadhdhaduwwake'ninna gaaruwate'ni,</para>
  <para style="q2" vid="JER 50:37">insa'ne giddo hedheke alaga magenuwik lolinke manna duuchcha'n dage!</para>
  <para style="q1" vid="JER 50:37">Insa'nenna melaalletishsha kandaani;</para>
  <para style="q2" vid="JER 50:37">wolaantichchi karra insa'neexxe'n dage! Karra insa'neexxina saamendaani.<verse eid="JER 50:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 50:38" />Bogi soda'ati weekemake magenuwini,</para>
  <para style="q2" vid="JER 50:38">magenoffantammaxxe fakuwwani wo'memaxxe'e;</para>
  <para style="q2" vid="JER 50:38">galaanuwwi iseki bagowwaali.<verse eid="JER 50:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="JER 50:39" />«Tennexxee qiilla gammoojjeke binniichkenna worraabeesi aagaaba,</para>
  <para style="q2" vid="JER 50:39">urungotinna galdaaba kadaani.</para>
  <para style="q1" vid="JER 50:39">Konnechchinni edi'a ayyina oko'o hedhabaani</para>
  <para style="q2" vid="JER 50:39">ilatenaa'ni ilati qico'n okko ofo'laaki afemabaani.<note caller="-" style="x"><char style="xo" closed="false">50:39 </char><char style="xt" closed="false"><ref loc="REV 18:2">Wal. 18:2</ref>. </char></note><verse eid="JER 50:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JER 50:40" />Mageni Soodoominna Gomoraa'a;</para>
  <para style="q2" vid="JER 50:40">qarqara insa'neeke'n hedheeka qachchuwwa mitti manjinna hedhabaake assemashshani,»</para>
  <para style="q3" vid="JER 50:40">hiyya'neni Duuchchi Woddiki Gootti.</para>
  <para style="q1" vid="JER 50:40">«Itaanni okko'o ayyinna hedhdhabaani,</para>
  <para style="q2" vid="JER 50:40">okko'o ofo'lakina afemabaani.<note caller="-" style="x"><char style="xo" closed="false">50:40 </char><char style="xt" closed="false"><ref loc="GEN 19:24-25">Dada. 19:24-25</ref>. </char></note><verse eid="JER 50:40" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="41" style="v" sid="JER 50:41" />«Kunniseten loliinki mann middii'ni daga'neeni;</para>
  <para style="q2" vid="JER 50:41">mitti jabaki moyanjina gosa gosaki moyanjuwi;</para>
  <para style="q2" vid="JER 50:41">bogiinxe gabalanaa'n ke'eeni.<verse eid="JER 50:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 50:42" />Gabetanna bagedo abxxineeni;</para>
  <para style="q2" vid="JER 50:42">mararte afebaakenna godoba jabake mannani</para>
  <para style="q1" vid="JER 50:42">Fadhado gulunfe danga wodda;</para>
  <para style="q2" vid="JER 50:42">haafuri insa'neki abayatike danbala'ishshateni.</para>
  <para style="q1" vid="JER 50:42">Tee Baabiloonxe belto!</para>
  <para style="q2" vid="JER 50:42">Atee lolo'a qophpheeffateeki loliink manni atiba'a daga'neeni.<verse eid="JER 50:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 50:43" />Baabiloonik moyanji insa'ne danga'neexxa laqqee wodda;</para>
  <para style="q2" vid="JER 50:43">anga isixxi gogge gatteen;</para>
  <para style="q1" vid="JER 50:43">Yaade wixxirri hiyye;</para>
  <para style="q2" vid="JER 50:43">ciniifattammaxxe manjichchoshsha rakkateni.<verse eid="JER 50:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="JER 50:44" />Yordaanoosi gongomi giddii'n neenqi dedhanga fule'e</para>
  <para style="q2" vid="JER 50:44">bada'a qufeeke didiba'a dagamashsha;</para>
  <para style="q1" vid="JER 50:44">Aninna Baabilooni keekkattebaangi boga isekenaa'n isee shoorrannoni;</para>
  <para style="q2" vid="JER 50:44">ani fi'leneka isse galchcho'a harriirannoni;</para>
  <para style="q1" vid="JER 50:44">Aninni herregemaaki ayyete?</para>
  <para style="q2" vid="JER 50:44">Anee mayee iitta assitette hiyyaaki hedhdhee?</para>
  <para style="q2" vid="JER 50:44">Hoone alalisanjo anee hoyya dande'aki?»<verse eid="JER 50:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="JER 50:45" />Tennexxee Duuchchi Woddiki Gootti Baabilooni'a mari'atexxa,</para>
  <para style="q2" vid="JER 50:45">Baabiloonike bogi'a hedeexxa laqqe;</para>
  <para style="q1" vid="JER 50:45">Horriinke bobbaasuma'n beltanna harikkinse adhdhinaani;</para>
  <para style="q2" vid="JER 50:45">insa'neexxe buutonni ala'linaammaba hara ballesaani.<verse eid="JER 50:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 50:46" />Baabiloonxe abidenshaxxi odo laqendaa wodda buttini lele'maan;</para>
  <para style="q2" vid="JER 50:46">isexxi raarenna gosa gosake arda'n laqendaani.<verse eid="JER 50:46" /></para>
  <chapter eid="JER 50" />
  <chapter number="51" style="c" sid="JER 51" />
  <para style="s1">Baabilooni'n Geltaaxxa Wele Murte</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 51:1" />Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 51:1">«Kunni Baabilooninna boga iseka;</para>
  <para style="q2" vid="JER 51:1">balleessitaaxxa jabaxxa diidallo ke'issannoni.<verse eid="JER 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 51:2" />Ani Baabilooni'ii midhatishsha sore'e ballessaaka,</para>
  <para style="q2" vid="JER 51:2">alaga Baabiloni'nni erganon;</para>
  <para style="q1" vid="JER 51:2">Rakkotixxe barra'n;</para>
  <para style="q2" vid="JER 51:2">elqe kayyii'n bunqe'e insa'nee rakkinsaani.<verse eid="JER 51:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 51:3" />Gabetikna gabe xamaxxo'a,</para>
  <para style="q2" vid="JER 51:3">loliinxa seemmanna odo'wwo'a yanna uutinoqqe'e;</para>
  <para style="q1" vid="JER 51:3">Meenni dargaggeyye insa'neexxe mararre;</para>
  <para style="q2" vid="JER 51:3">loliinka iseka sannachcha kutti asse.<verse eid="JER 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 51:4" />Baabiloonge boga'n gorra'eme,</para>
  <para style="q2" vid="JER 51:4">weldeenna weldenna'ninni jaba qico madoonne inbaani.<verse eid="JER 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 51:5" />Bogi insa'neeki Isira'eelike woyyichchi edo,</para>
  <para style="q2" vid="JER 51:5">balleessa bira saxxeeke kaddoolenna,</para>
  <para style="q1" vid="JER 51:5">Isra'eelinna Yihuda Mageni insa'neek,</para>
  <para style="q2" vid="JER 51:5">Lumoki Duuchchi Woddiki Gootti waalebaani.<verse eid="JER 51:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JER 51:6" />« ‹Baabiloon giddii'n baajjine fulle;</para>
  <para style="q2" vid="JER 51:6">rakkine baajjine lubbo ha'nooxxa gatirse;</para>
  <para style="q2" vid="JER 51:6">cubbotixxe buutonni baxxinoqqe.</para>
  <para style="q1" vid="JER 51:6">Duuchchi Woddiki Gootti halo fula'neexxe yannani;</para>
  <para style="q2" vid="JER 51:6">isinna huje isexxika hira uwwa'neeni.<verse eid="JER 51:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 51:7" />Baabilooni Duuchchi Woddike Goottixxe anga'n worqetixxe buuda kadde;</para>
  <para style="q2" vid="JER 51:7">boga iseka duuchcha machcheessite;</para>
  <para style="q1" vid="JER 51:7">Gosa gosaki ardi iseka woyinetika bagoka bulibulo ha'we;</para>
  <para style="q2" vid="JER 51:7">tennexxee ta'a insa'ne marratee'eni.<note caller="-" style="x"><char style="xo" closed="false">51:7 </char><char style="xt" closed="false"><ref loc="REV 17:2-4">Wal. 17:2-4</ref>; <ref loc="REV 18:3">18:3</ref>. </char></note><verse eid="JER 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 51:8" />Baabilooni dedhdhange'n ibbe enqendaani</para>
  <para style="q2" vid="JER 51:8">ise'a woo hiyye!</para>
  <para style="q1" vid="JER 51:8">Akimagaada fayya dandeetaani;</para>
  <para style="q2" vid="JER 51:8">mada isexxe'n buurraaka qorsa ise'a hasse.<verse eid="JER 51:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JER 51:9" />« ‹Baabilooni'i fayyinsonnaa wolaaneenani;</para>
  <para style="q2" vid="JER 51:9">ise kinni fayya dandetabaani;</para>
  <para style="q1" vid="JER 51:9">Murite ise'n murendeexxi iimi qico'n geltemaxxe;</para>
  <para style="q2" vid="JER 51:9">iima duummanchi qico'n lummexxexxe kademaxxe;</para>
  <para style="q2" vid="JER 51:9">waalenexxi ifi ifinge no'oke bogiba'a me'ino.›<note caller="-" style="x"><char style="xo" closed="false">51:9 </char><char style="xt" closed="false"><ref loc="REV 18:5">Wal. 18:5</ref>. </char></note><verse eid="JER 51:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 51:10" />« ‹Duuchchi Woddiki Gootti qajeelumma no'ooxxa dhugaa kule;</para>
  <para style="q2" vid="JER 51:10">amme! Duuchchi Woddiki Gootti no'ooki Mageni asseexxa duuchcha;</para>
  <para style="q2" vid="JER 51:10">Tsiyooni'n kullo› hine.<verse eid="JER 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 51:11" />«Mogiduwwa ha'nooka qarre;</para>
  <para style="q2" vid="JER 51:11">wontuwwatanna qophpheeffatte;</para>
  <para style="q1" vid="JER 51:11">Duuchchi Woddikie Gootti Baabilooni'i balleesso'a hasemmaxxe'e;</para>
  <para style="q2" vid="JER 51:11">Meedoonika moyanjuwwa ke'ise'en;</para>
  <para style="q1" vid="JER 51:11">Duuchchi Woddiki Gootti halo fulaan;</para>
  <para style="q2" vid="JER 51:11">galmi isikxxe'e halo fulaani.<verse eid="JER 51:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 51:12" />Baabiloonike kinjiinke dallaa'a'n beesisa otte!</para>
  <para style="q2" vid="JER 51:12">Jabaatine heqqe;</para>
  <para style="q1" vid="JER 51:12">Heqqaaka manna ugge;</para>
  <para style="q2" vid="JER 51:12">riphphe lolaaka lolnka manna qophpheesse;</para>
  <para style="q1" vid="JER 51:12">Duuchchi Woddiki Gootti Baabiloonke arda'n;</para>
  <para style="q2" vid="JER 51:12">asso'a mureemmaka yaada muuxxo'aateni.<verse eid="JER 51:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 51:13" />Ati lumollamma galaanuwwi qarqara hexxaattexxi;</para>
  <para style="q2" vid="JER 51:13">tee karrati duroondettexxe;</para>
  <para style="q1" vid="JER 51:13">Kutendattoxxi yanna dagee'eni;</para>
  <para style="q2" vid="JER 51:13">ba'netina ati'a shiqe'eni.<note caller="-" style="x"><char style="xo" closed="false">51:13 </char><char style="xt" closed="false"><ref loc="REV 17:1">Wal. 17:1</ref>. </char></note><verse eid="JER 51:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 51:14" />Lumoki Duuchchi Woddiki Gootti ifi'ani hiyye kakatee qici;</para>
  <para style="q2" vid="JER 51:14">awwaneessiinke bobba'ishsha laakkossi bira sa'eeki loliinki manni boga atike'ni wo'maani;</para>
  <para style="q2" vid="JER 51:14">insa'nenna atee injiffatati ate'ni geerarraani.<verse eid="JER 51:14" /></para>
  <para style="s1">Magenokee Shiqqeexxa Gaalatiinxa Faaro</para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 51:15" />«Duuchchi Woodiki Gootti butta ifixxe hunnanni giisseek,</para>
  <para style="q2" vid="JER 51:15">butta beekkumi ifikenni dade;</para>
  <para style="q2" vid="JER 51:15">iimuwwatanna ege'na ifixeni dhise dadeeki isoteni.<verse eid="JER 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 51:16" />Isiki hafuuri dindimaa wodda iima hedheeki wodi'uwwi luulaan;</para>
  <para style="q2" vid="JER 51:16">isi duumancha buttatixxe gabalanaa'n iimi'a fulaashsha assaani;</para>
  <para style="q1" vid="JER 51:16">Xeeniki weltinna banqo gansisaani;</para>
  <para style="q2" vid="JER 51:16">diidallo tulemake minenaa'n fulchaani.<verse eid="JER 51:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JER 51:17" />«Mitti mittngi manji gowwakenna ege'na afebaakeni;</para>
  <para style="q2" vid="JER 51:17">worqe baqise giissammaki duuchchi giissemmaxxe magenooffantammaxxe fakkuwwaxxe shooke'eni;</para>
  <para style="q1" vid="JER 51:17">Qunqumme giisseexxi fakkuwwa toliinxeni;</para>
  <para style="q2" vid="JER 51:17">hafuurakanna afebaani.<verse eid="JER 51:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 51:18" />Kunnichchuwwi toliinke roorrotike miyiwwan;</para>
  <para style="q2" vid="JER 51:18">murte insa'ne'n murro'a dagaa wodda ba'naanni.<verse eid="JER 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 51:19" />Ya'iqoobik Magen kinni konnechchuwwishshatebaan;</para>
  <para style="q2" vid="JER 51:19">isi duuchchingeechcho dadeeken;</para>
  <para style="q1" vid="JER 51:19">Isra'eelxi gosanna isike geegonni;</para>
  <para style="q2" vid="JER 51:19">summi isikinna lumoke Duuchchi Woddike Goottani.<verse eid="JER 51:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 51:20" />«Tee Baabilon! Ati anke burrisanna,</para>
  <para style="q2" vid="JER 51:20">anke loolnke miyyaan;</para>
  <para style="q1" vid="JER 51:20">Ati darree'n gosa gosaka arda bulleessannoni;</para>
  <para style="q2" vid="JER 51:20">ati darree'n moyanjuwa birannoni;<verse eid="JER 51:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 51:21" />Ati darree'n fadhadokanna fadhdoo gulfemmakaranna bulleessannoni;</para>
  <para style="q2" vid="JER 51:21">ati darree'n fadhadixxa gaarruwwanna oofammaka bulleessannoni.<verse eid="JER 51:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 51:22" />Ati darree'n melaallenna labballo;</para>
  <para style="q2" vid="JER 51:22">geedhetanna dargaggeyye;</para>
  <para style="q2" vid="JER 51:22">ati darree'n qee'lonna dubbarra bulleessaannoni.<verse eid="JER 51:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 51:23" />Ati darre'n allalisanjokanna hore</para>
  <para style="q2" vid="JER 51:23">ati darre'n hiislokanna qoxxiyyo,</para>
  <para style="q2" vid="JER 51:23">atidarre'n galchalluwwakanna ja'laqabuwwa balleessannon.<verse eid="JER 51:23" /></para>
  <para style="s1">Baabiloonxa Xixensha</para>
  <para style="p">
    <verse number="24" style="v" sid="JER 51:24" />«Tsiyooni'ni geessinsemmaxxe balleessa duuchchi'a; Baabilooni'anna Baabilooni'ni hedhaa'neeke duuchchi'a; ille ha'nooxxi uuda'naani insa'neeka hira ani uwwannon» hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 51:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 51:25" />«Tee boga duuchcha balleessiteettaxxee;</para>
  <para style="q2" vid="JER 51:25">tee balleessanjo kooba, ani ate'ni ka'lee ke'eennen»</para>
  <para style="q2" vid="JER 51:25">hiyya'neen Duuchchi Woddiki Gootti;</para>
  <para style="q1" vid="JER 51:25">«Anga anxa ate'ni ke'issaannen;</para>
  <para style="q2" vid="JER 51:25">bowwa'akenaa'ni ate'e butti'a goggo'mishannon;</para>
  <para style="q2" vid="JER 51:25">gubateexxe koobashsha ate'e assannon.<verse eid="JER 51:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 51:26" />Atenaa'n dhaaddote'e kadaaki kinji</para>
  <para style="q2" vid="JER 51:26">boosoteena kadaak kinji afemabaan;</para>
  <para style="q2" vid="JER 51:26">ati duuchchii woddi'a urma kaddatton;»</para>
  <para style="q2" vid="JER 51:26">hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 51:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="JER 51:27" />«Boga duuchcha'ni beessisiinka baandira iimi'a ke'isse!</para>
  <para style="q2" vid="JER 51:27">Gosa gosake ardixxe oddo'ni malagata ufuuffe!</para>
  <para style="q1" vid="JER 51:27">Gosa gosak arduwwi Baabilooni'i lolaashsha qophpheesedhe;</para>
  <para style="q2" vid="JER 51:27">Araaratika, Minaanikanna Ashikenaazika moyanjuwwa,</para>
  <para style="q2" vid="JER 51:27">yexxinexxi ookkoni bukki asse;</para>
  <para style="q1" vid="JER 51:27">Loliinka manna ajajaaka ajajalluwwa ise'ni baallonse;</para>
  <para style="q2" vid="JER 51:27">fadhaduwwakanna awwaanesiinke haaganishsha, ookko'a wocci asse.<verse eid="JER 51:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 51:28" />Meedoonika moyanjuwwa,</para>
  <para style="q2" vid="JER 51:28">galchalluwwakanna ja'laabuwa duuchcha,</para>
  <para style="q1" vid="JER 51:28">Galcha insa'nexxi hunda hedheeka boga duuchcha,</para>
  <para style="q2" vid="JER 51:28">konne gosa gosaka arda Baabiloonii'i lolo'a qophpheesse.<verse eid="JER 51:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 51:29" />Manji ookko hedha dande'abaa qico'ni,</para>
  <para style="q2" vid="JER 51:29">Baabiloonika boga urma asso'a,</para>
  <para style="q1" vid="JER 51:29">Duuchchi Woddiki Gootti Baabilooni'ni hedemmaxxa muuxammaxxee,</para>
  <para style="q2" vid="JER 51:29">butta girgiri hitaan; le'mitaan.<verse eid="JER 51:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 51:30" />Baabiloonik loliinki manni lola waaleen;</para>
  <para style="q2" vid="JER 51:30">ifixxe jabaxxe kollo giddo ofo'ledheen;</para>
  <para style="q1" vid="JER 51:30">Hunna insa'exxi xo'oteen;</para>
  <para style="q2" vid="JER 51:30">melaalletishsha kandeen;</para>
  <para style="q1" vid="JER 51:30">Galduma insa'neke'ni giira worende'e;</para>
  <para style="q2" vid="JER 51:30">insa'neke dalla'ixxe hulaka danqarsanjuwwi enqineen.<verse eid="JER 51:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 51:31" />Qachchi duuchchi abidemmeexxa,</para>
  <para style="q2" vid="JER 51:31">Baabiloonke moyanjo'ni kulatee'e,</para>
  <para style="q1" vid="JER 51:31">Mitti odichchi wele odichcha'n,</para>
  <para style="q2" vid="JER 51:31">mitti erganji wele erganjo'ni kuloi'a gongaan.<verse eid="JER 51:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 51:32" />Naaphink sannaichchi galaana foonfammaba abideexxi</para>
  <para style="q2" vid="JER 51:32">heqanjuwwiinka golli gubemeexxa</para>
  <para style="q2" vid="JER 51:32">Baabiloonik moyanjuwwinna alayye culphisseexxa ise'n kullo'a gonginaan» hiyye.<verse eid="JER 51:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JER 51:33" />Isira'eelik lumok Duuchchi Woddik Gootti Magen hiyya'nee qici,</para>
  <para style="q1" vid="JER 51:33">«Baabiloonixxi meyyaxxi belto</para>
  <para style="q2" vid="JER 51:33">midha uxxatixxi aldumene;</para>
  <para style="q2" vid="JER 51:33">isexxe mayetik aganjinna rakee geyaan.»<verse eid="JER 51:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="JER 51:34" />«Baabiloonik moyanji Naabukadanatsoor no'o iteen;</para>
  <para style="q2" vid="JER 51:34">butuchche no'oo bire; duwwike waabishsh no'o asse;</para>
  <para style="q1" vid="JER 51:34">Jawwetishshanna no'o liqiinse;</para>
  <para style="q2" vid="JER 51:34">xe'maalchishsha no'o ite godoba wonshedhe;</para>
  <para style="q2" vid="JER 51:34">ookkonechchi uduma aakkiyye no'oo tufe.<verse eid="JER 51:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 51:35" />Tsiyooni hedhammakir hiyyaa qici,</para>
  <para style="q2" vid="JER 51:35">«No'o'ni gelteemmaxxi fuggoxxi Baabilooni'ni geltowwaal,»</para>
  <para style="q1" vid="JER 51:35">Iyyerusaaleminna,</para>
  <para style="q2" vid="JER 51:35">«No'ooxxi munde Baabiloonike boga'ni hedha'neekara daaffuun,» hitaan.<verse eid="JER 51:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JER 51:36" />Tennexxe Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 51:36">«Kunse ani ati'a baasannon;</para>
  <para style="q2" vid="JER 51:36">halo atixxanna aninni fulannon;</para>
  <para style="q1" vid="JER 51:36">Abbaayatanna bassannon;</para>
  <para style="q2" vid="JER 51:36">muummuwwa isexxanna xo'oo assannon.<verse eid="JER 51:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 51:37" />Baabilooni'ni oletixxe tuulo,</para>
  <para style="q2" vid="JER 51:37">jeedaluwwi burraaqabaan,</para>
  <para style="q1" vid="JER 51:37">Alayyiinxenna oso'lematike beessisa kaddaan;</para>
  <para style="q2" vid="JER 51:37">ayyinna ookko hedhabaan.<verse eid="JER 51:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 51:38" />Baabiloonik ardi duuchchi geyeeke neenqiinsha baroodaan;</para>
  <para style="q2" vid="JER 51:38">oosichchi neeqishshanna gurura'aan.</para>
  <para style="q1" vid="JER 51:38">Qonqo insa'nexxi baggaa wodda,</para>
  <para style="q2" vid="JER 51:38">itatixxa jila insa'ne'a qophpheessannon;</para>
  <para style="q2" vid="JER 51:38">machchoonnaashsha assennexxi.<verse eid="JER 51:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="JER 51:39" />Oso'la'ni gammanda'ni,</para>
  <para style="q2" vid="JER 51:39">duuchchii woddi'a dammanqabaaka diipho diinphaan»</para>
  <para style="q4" vid="JER 51:39">hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 51:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JER 51:40" />«Gedhebiinke buruusishshanna,</para>
  <para style="q2" vid="JER 51:40">re'etixxe korbeeyyeshsha gedhebiinxe korbeyyeshsha,</para>
  <para style="q2" vid="JER 51:40">duuliinbaa adhdhine me'inaashsha assannon.<verse eid="JER 51:40" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="41" style="v" sid="JER 51:41" />«Shiishaaki hitta booji'ende!</para>
  <para style="q2" vid="JER 51:41">Iitta boga duuchcha'n saadedeexxi, hitta abidendee!</para>
  <para style="q1" vid="JER 51:41">Baabilooni gosa gosake arda duuchcha'ni,</para>
  <para style="q2" vid="JER 51:41">hittee qico bajabaja assitaaxxi kadde.<verse eid="JER 51:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 51:42" />Abbaayya Baabilooni'n hana yaataan;</para>
  <para style="q2" vid="JER 51:42">danbala'ikinna ganema'ni buqaan.<verse eid="JER 51:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 51:43" />Qachchuwwikinna manji giddo hedhabaake,</para>
  <para style="q2" vid="JER 51:43">wili manjinna hedhabaake,</para>
  <para style="q1" vid="JER 51:43">Bagoke qiilla gammoojje booncho,</para>
  <para style="q2" vid="JER 51:43">uruma boganna kadaan.<verse eid="JER 51:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="JER 51:44" />Beeli'i Baabilooni giddo xixannon;</para>
  <para style="q2" vid="JER 51:44">itemaalchonna honqoshshannon;</para>
  <para style="q1" vid="JER 51:44">Gosa gosak ardi konnechchinn edi'aa isibaa yaa'abaan;</para>
  <para style="q2" vid="JER 51:44">Baabiloonik kinjiink dalla'i fottoqaan.<verse eid="JER 51:44" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="45" style="v" sid="JER 51:45" />«Koo, anke ardaa! Ookkoo'n fulle!</para>
  <para style="q2" vid="JER 51:45">Lubbo ha'nooxxa gatilse!</para>
  <para style="q2" vid="JER 51:45">Eettene sodaachchissaaxxe Duuchchi Woddike Goottixxe mufenaa'ni baajiine fulle.<verse eid="JER 51:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 51:46" />Odo bogake'ni laqendaa wodda,</para>
  <para style="q2" vid="JER 51:46">godoba guggudhitine hooddinoqqe'e;</para>
  <para style="q1" vid="JER 51:46">Moyanji mitti weleke'n ke'asixxa,</para>
  <para style="q2" vid="JER 51:46">jallo bogake'ni hexxaamaxxe'e</para>
  <para style="q2" vid="JER 51:46">karinno mitte odo; dagaasanenna welennxe daggaan.<verse eid="JER 51:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="JER 51:47" />Baabiloon magenooffatammaxxa fakkuwwa xixanoxxa yanna,</para>
  <para style="q2" vid="JER 51:47">dhugaandinni daggaan.</para>
  <para style="q1" vid="JER 51:47">Bogi isik duuchchi salphataan;</para>
  <para style="q2" vid="JER 51:47">gorraannek duuchchi bogi iseki giddo ibbaan.<verse eid="JER 51:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="JER 51:48" />Iimanna butta ise giddo hedheelchi duuchchi,</para>
  <para style="q2" vid="JER 51:48">Baabilooni'ni ilili hiyyaan;</para>
  <para style="q1" vid="JER 51:48">Balleessanjuwwi middii'ni fuleexxi</para>
  <para style="q2" vid="JER 51:48">isee lolaan;»</para>
  <para style="q2" vid="JER 51:48">hiyya'neen Duuchchi Woddik Gootti.<note caller="-" style="x"><char style="xo" closed="false">51:48 </char><char style="xt" closed="false"><ref loc="REV 18:20">Wal. 18:20</ref>. </char></note><verse eid="JER 51:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="JER 51:49" />«Boga duuchcha'ni gorra'emmeeki duuchchi,</para>
  <para style="q2" vid="JER 51:49">Baabiloonixxe buutonni inbeexxa,</para>
  <para style="q2" vid="JER 51:49">Baabilooninna Isira'eel giddo gorra'emeemakixxe, buutoxxe iba isi'a hasisaan.<note caller="-" style="x"><char style="xo" closed="false">51:49 </char><char style="xt" closed="false"><ref loc="REV 18:24">Wal. 18:24</ref>. </char></note><verse eid="JER 51:49" /></para>
  <para style="s1">Baabilon Hedheke Isira'eelike Manni'a Ergendexxa Erga</para>
  <para style="q1">
    <verse number="50" style="v" sid="JER 51:50" />Wolaantichchokenaa'n baajjinekee,</para>
  <para style="q2" vid="JER 51:50">me'wee! Yanna tola gubbinoqqe'e;</para>
  <para style="q1" vid="JER 51:50">Bayyi boga'ni hexxineer Duuchchi Woddika Gootta qaabbatte;</para>
  <para style="q2" vid="JER 51:50">Iyyerusaalemii'i kassi hiyye.»<verse eid="JER 51:50" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="51" style="v" sid="JER 51:51" />«Wele bogik mannni ookkone woyyichchake kadeeke,</para>
  <para style="q2" vid="JER 51:51">Duuchchi Woddike Goottike mine'ni e'yineenmmaxxee,</para>
  <para style="q2" vid="JER 51:51">no'o yowwemmeennen</para>
  <para style="q1" vid="JER 51:51">Shoonke hangullu hineennen;</para>
  <para style="q2" vid="JER 51:51">salphantee luggineennen.»<verse eid="JER 51:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="JER 51:52" />«Yoona Baabiloon magenooffatammaxxa fakkuwwa xixannoki bari dagaan;»</para>
  <para style="q2" vid="JER 51:52">hiyya'neen Duuchchi Woddiki Gootti;</para>
  <para style="q1" vid="JER 51:52">«Baabiloonke boga duuchcha'ni</para>
  <para style="q2" vid="JER 51:52">mado'eeki manni aadaan.<verse eid="JER 51:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="JER 51:53" />Baabiloon iimi'a fuldoolenna,</para>
  <para style="q2" vid="JER 51:53">qeerraka kinjiinka dalla'a jabeessexxe ijaadhdhitoolenna,</para>
  <para style="q2" vid="JER 51:53">ise'e balleessaaka manna ookko'a ergannon;»</para>
  <para style="q2" vid="JER 51:53">hiyya'neen Duuchchi Woddiki Gootti.<verse eid="JER 51:53" /></para>
  <para style="s1">Baabilooni'ni Geltaaxxa Wele Murte</para>
  <para style="b" />
  <para style="q1">
    <verse number="54" style="v" sid="JER 51:54" />«Baabiloonixxe raarenaa'ni,</para>
  <para style="q2" vid="JER 51:54">Baabiloonke mannike boganaa'ni,</para>
  <para style="q2" vid="JER 51:54">jabaxxe ba'neki hafuuri laqemaan.<verse eid="JER 51:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="JER 51:55" />Duuchchi Woddiki Gootti Baabiloonii'i balleessaan;</para>
  <para style="q2" vid="JER 51:55">jabaxxa isexxa raarenna sammi assaan.</para>
  <para style="q1" vid="JER 51:55">Abbaayyatike danbala'ishsha dhuqataakki sannachchi,</para>
  <para style="q2" vid="JER 51:55">dedhange'nni Baabiloonibaa geyeexxi raare dhanga ganaan.<verse eid="JER 51:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="JER 51:56" />Baabilooni'i lole balleessaaki dagaan;</para>
  <para style="q2" vid="JER 51:56">loliinka mannanna boojinaan;</para>
  <para style="q2" vid="JER 51:56">gabe insa'nexxinna enqendaan;</para>
  <para style="q1" vid="JER 51:56">Duuchchi Woddiki Gootti fuggoxxe'ni halo fulaake,</para>
  <para style="q2" vid="JER 51:56">hasissaaxxa duuchcha hira uwwaake Magenon.<verse eid="JER 51:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="JER 51:57" />Jalqabuwwa isekanna beekkole,</para>
  <para style="q2" vid="JER 51:57">galchalluwwakanna ja'laabuwwa, loliinka iseka manna ha'wisse machchoossannon;</para>
  <para style="q1" vid="JER 51:57">Duuchchii woddi'aanna diinphaan dammanqabaan,»</para>
  <para style="q2" vid="JER 51:57">hiyya'neen summi isik dada duuchcha ajajaake Duuchchi Woddike Gooatta Mageno kadeeki moyanji.<verse eid="JER 51:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JER 51:58" />Lumoki Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="JER 51:58">«Ba'laki Baabiloonik kinjiinki dalla'i diigeme olete kadaan;</para>
  <para style="q2" vid="JER 51:58">qeerraramma dalla'ixxi huluwwa giirati gubattaan;</para>
  <para style="q1" vid="JER 51:58">Ardiinxi elo tolange gattaan;</para>
  <para style="q2" vid="JER 51:58">gosa gosaki arduwwi elo'emmaxxi elo duuchcha giira itte birtaan» hiyye.<verse eid="JER 51:58" /></para>
  <para style="s1">Ermiyaas Baabilooni'a Ergeexxa Erga</para>
  <para style="p">
    <verse number="59" style="v" sid="JER 51:59" />Yihudaki moyanji Sedeqiyaasi moyeexxe tommenna sholgaxxe wogga'ni, moyanjiinxa baxxe e'ya kutaammaki Maahiseyaaki akka'i Neeryaki belti Seraaya moyanjik welti Baabilooni'a me'ee wodda, raagichchi Ermiyaasi ergeexxe ergan. <verse eid="JER 51:59" /><verse number="60" style="v" sid="JER 51:60" />Ermiyaasi Baabiloonixxee borreesse uggeexxa duuchcha, Baabilooni'ni dagga'neexxe ba'ne duuchchi'a mirqisanjoke'ni hana borreesseen: <verse eid="JER 51:60" /><verse number="61" style="v" sid="JER 51:61" />Isinna Seraayaa'ni hiyyee qici, «Baabiloonii'i geltetteshshann, konnee hiyyichcho duuchcha qonqo gikki assitte haasessa deetoxxe'e, <verse eid="JER 51:61" /><verse number="62" style="v" sid="JER 51:62" />Hitatoo qici; ‹Koo, Duuchchi Woddike Gootta: konnee booncho manjikinna kado hori biniinchi hedhabaa qico'ni duuchchii woddi'a urma kadde gattattoshsha assannon hiteettan.› <verse eid="JER 51:62" /><verse number="63" style="v" sid="JER 51:63" />Konne mirqisanjo haasesite birtetelchi uduma, kinoti usurte Efiraaxisike galaani giddi'a darbitexxi. <verse eid="JER 51:63" /><verse number="64" style="v" sid="JER 51:64" />Ookkonechchi uduma hitattoo qici, ‹Baabilooninna ani ise'ni geessisannoxxe ba'nenaa'ni kexeexxa, iitan liqiinsedaan; ta'inni udumi'a kexxabaan; ardi kinni ibaan.› »</para>
  <para style="p" vid="JER 51:64">Ermiyaasiki hiyyichchi konnon muuxemeen.<note caller="-" style="x"><char style="xo" closed="false">51:64 </char><char style="xt" closed="false"><ref loc="REV 18:21">Wal. 18:21</ref>. </char></note><verse eid="JER 51:64" /></para>
  <chapter eid="JER 51" />
  <chapter number="52" style="c" sid="JER 52" />
  <para style="s1">Iyyerusaalemixxa Iba</para>
  <para style="r">(<ref loc="2KI 24:18-20">2 Moy. 24:18-20</ref>; <ref loc="2KI 25:1-7">25:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 52:1" />Sedeqiyaasi moyaa wodda lame tommenna mitte woggamman; Iyyerusaalemi'ni tommenna mitte wogga moye; ama isixxiki summinna Amixaalite hiyyenda'emman; isenna Libiinake bogike manjixxe Ermiyaasixxe beltomman. <verse eid="JER 52:1" /><verse number="2" style="v" sid="JER 52:2" />Sedeqiyaasi Iyyo'aaqemi assemmashshanni Duuchchi Woddike Gootti edo elobaaxa yaane isinna asse. <verse eid="JER 52:2" /><verse number="3" style="v" sid="JER 52:3" />Duuchchi Woddiki Gootti Iyyerusaalemi'inna Yihuda'ni tennee duuchcha geessiseelchinna muuxamake'n isi edo insa'nee balleesseelch mufatemmaxxeetemman.</para>
  <para style="p" vid="JER 52:3">Sedeqiyaasinni Baabiloonike moyanjo'n jalle. <verse eid="JER 52:3" /><verse number="4" style="v" sid="JER 52:4" />Tennexxee Sedeqiyaasi moyeexxe sallaneessoxxe wogga'n tommeesoke agenjo'n, tommeessoxxe barra'nni, Baabiloonik moyanji Nabuukadanatsoori ifika sannachchuwwa duuchcha ka'lisheexxi Iyyerusaalemi'a duule; qachchakanna buqe; qarqarake'ninna buttin iimi'a tullube.<note caller="-" style="x"><char style="xo" closed="false">52:4 </char><char style="xt" closed="false"><ref loc="EZK 24:2">Hiz. 24:2</ref>. </char></note> <verse eid="JER 52:4" /><verse number="5" style="v" sid="JER 52:5" />Qachchikinna moyanji Sedeqiyaasi moyeexxe tommenna taakkeessoke moyetike bariqico'n buqendeemman.<verse eid="JER 52:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 52:6" />Sholgeessoke agnjixxe sallaneessoxxe barra'n qachchi giddo beeli itti jabaate hedhemmaxxee; ardi itaachcho gopheexxi: <verse eid="JER 52:6" /><verse number="7" style="v" sid="JER 52:7" />Qachchiink dalla'i enqeme; sannachchi duuchchi edii'ni baaje. Baabilooniki manni qachchin qarqara he'noolenna, moyanjinke hiddichchuwinke boonchi bira lame dalla'ixxe oddo'ni hedheeke cufaniba hashshunte qachcha waaleexxi baanje; Araba'ana ke'ne me'ine.<note caller="-" style="x"><char style="xo" closed="false">52:7 </char><char style="xt" closed="false"><ref loc="EZK 33:21">Hiz. 33:21</ref>. </char></note> <verse eid="JER 52:7" /><verse number="8" style="v" sid="JER 52:8" />Yaane kinn Baabiloonike mannik sannachchi moyanji Sedeqiyaasi duuka shorra'n mareexxi Iyyaarikoke diidiba dhaqqabe; loliink isiki manni duuchchinna isiba'n gargarti he'nee'na, moyanjo abixxine.<verse eid="JER 52:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 52:9" />Isinna Hamaatike boga'ni Ribla hedheeke Baabiloonike moyanjiba adheme; Baabiloonik moyanjinna ookkone iso'ni mure. <verse eid="JER 52:9" /><verse number="10" style="v" sid="JER 52:10" />Ribla Baabiloonike moyanjo, Sedeqiyaasixxa labbaxxa oose annini edo gorra'e; ittann Yihudaka jalqabuwwa duuchcha shiye; <verse eid="JER 52:10" /><verse number="11" style="v" sid="JER 52:11" />Okkoneechchi uduma Sedeqiyaasixxa illuwwa giddii'n fulche; sageettotike sibljike haachchabin usureexxi Baabilooni'a adhdhe me'e; ookkona reyaaxxe barraqico'n usurii mine'ni turse.<note caller="-" style="x"><char style="xo" closed="false">52:11 </char><char style="xt" closed="false"><ref loc="EZK 12:13">Hiz. 12:13</ref>. </char></note><verse eid="JER 52:11" /></para>
  <para style="s1">Woyyichchi Galmxa Findigensha</para>
  <para style="r">(<ref loc="2KI 25:8-17">2 Moy. 25:8-17</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JER 52:12" />Baabilooniki moyanji Naabukadanatsoori moyeexxe tommenna sallanixxe wogga'n ondesoke agenjixxe tommeessoxxe barra'n, Baabiloonik moyanji mootummatike minike heqqanjike ajajallo kadeek Nabuzardaan Iyyerusaalemi dage. <verse eid="JER 52:12" /><verse number="13" style="v" sid="JER 52:13" />Duuchchi Woddike Goottik galminna, moyajiink mootetik mini ittanni Iyyerusaalemi hedhemmaka minuwwa duuchcha giirat gube. Wele kinoti ijaaremeeka qeeraramma minenna giirat kutti asse.<note caller="-" style="x"><char style="xo" closed="false">52:13 </char><char style="xt" closed="false"><ref loc="1KI 9:8">1 Moy. 9:8</ref>. </char></note> <verse eid="JER 52:13" /><verse number="14" style="v" sid="JER 52:14" />Mootummatika mine heqqammake ajajalli hunda hedhemmaki Baabiloonike manniki sannachchuwwi duuchchi Iyyerusaalemike qarqara'n hedheeka dalla'a duuchcha diinge birre. <verse eid="JER 52:14" /><verse number="15" style="v" sid="JER 52:15" />Mootummatike miniki heqqanjik ajajalli Nabuzerdaan mitte mitte hiyyeeyyenna qachchi giddo gateeki ardi, angatixxa oge afemmaka mannanna baaje Baabiloonike moyanjiba shiqeekara adhdhe me'e. <verse eid="JER 52:15" /><verse number="16" style="v" sid="JER 52:16" />Yaane kinni mootummatike miniki heqqanjuwwik ajajalli Nabuzerdaan wele bogi giddo hiyyeeyye kade hedhemmaka woyine kansaashshann fichcha huccinaashsha ookkone gatilse.<verse eid="JER 52:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 52:17" />Baabiloonik manni Duuchchi Woddike Goottike galmi giddo hedhammaka sibiljiinxe sageettoka utuphuwwa, elqenna kayya hiisa'neeka ofo'lisanjuwwanna sibljinxe sageeton hunje'eka wode'iinka gonga enqine butuchchine; sageetto duuchcha Baabiloonike moyanjba aa'ne me'ine.<note caller="-" style="x"><char style="xo" closed="false">52:17 </char><char style="xt" closed="false"><ref loc="1KI 7:15-47">1 Moy. 7:15-47</ref>. </char></note> <verse eid="JER 52:17" /><verse number="18" style="v" sid="JER 52:18" />Konneechchuwwi gadho odo'wa, hixaana guphphinammaxxa galuwwa, sibiljiinka hubura, akkaafiinsha hedheeka faafasunjo, mooqquwwa galmi giddo la'oonfattammaka sageettotike sibiljika miyuwwa duuchcha adhdhine. <verse eid="JER 52:18" /><verse number="19" style="v" sid="JER 52:19" />Mootummatika mine heqqammak ajajalli ca'itte worqeninna ca'itte sibiljo birrenn hujemeeeka miyuwwa duuchcha hubbuqqitte qore, hixaana gunbammalchuwwa, sibiljiinika hubura, torbaane dhankoka xasiika ofe'lemalcho, ba'laxxa mooqqonna tolcha shqinshaaxxa qoruwwa kaddaaxxa qallasuma duuchcha adhdhine me'ine.<verse eid="JER 52:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 52:20" />Moyanji Solomooni Duuchchi Woddike Goottike galmi'a sibiljo birren hujisemmaxxi; lami utuphuwwa, lumoke wode'iink gongi, isi hundii'ni hedheeki tommenna lami jibootinna elqenna kayya higaak ufo'lisanjuwwik a'urrinna kiilotixxe mike iima; <verse eid="JER 52:20" /><verse number="21" style="v" sid="JER 52:21" />Mitti mitting utuphuwwiinki qephphinni tommenna saddeeta ciqilen; kasi kasii'n tommenna lame ciqilemman; oddo duwwi hedhemmaxxe'e mitti mitting ba'linni furdinni shoole taakkomman. <verse eid="JER 52:21" /><verse number="22" style="v" sid="JER 52:22" />Mitte utuphiin umi hana tuulende hexxeexxi sageetto sibiljiinxi ejuma onde ciqile kadaa wodda qarqara duuchcha'n Roomaanixxa bifa afeeka sibljo sageettotixxi gargar hexxeexxi elolla bifa afeemmakemman; weli utuphi Roomaanixxe gargar hexxeexxa bifa afeenn hedhe konnen wele fakkaataamman. <verse eid="JER 52:22" /><verse number="23" style="v" sid="JER 52:23" />Gadhi darree'ni sallane tommenna jaani Roomaanuwwa farri hite leellitaa wodda; qarqarake'ni hexxe biifa'neexxi iimi darre hexxeexxe Roomaanuwwik laakkossi mitte dhibbamman.<verse eid="JER 52:23" /></para>
  <para style="s1">Yihudk Ard Babilooni'a Adhdhemeexxa</para>
  <para style="r">(<ref loc="2KI 25:18-21">2 Moy. 25:18-21</ref>, <ref loc="2KI 25:27-30">27-30</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="JER 52:24" />Mootummatika mine heqammake ajajalli qeesooletik sooreessa kadeemmak Serayaani, langaba iitti aane'eka qeesichcho Sofooniyaasiinna sasiinga cufana heqqammakara usureexxi adhdhe me'e: <verse eid="JER 52:24" /><verse number="25" style="v" sid="JER 52:25" />Qachchi giddo gateeki ardi lolammake mannike sooreessa kade'emmaka ajajallo, torbaaniinga moyanjuwwika gorsalluwwa bogi giddike ardi giddii'n loliinke'e kadaaka manna fi'leemmaka ajajallo, borreessanjokanna qachchuwwi giddo leelleeka wele jaane tomme manna aadhdhe. <verse eid="JER 52:25" /><verse number="26" style="v" sid="JER 52:26" />Mootummatika mine heqqammak ajajalli Nabuzardaan konnee manna duuchcha aadheexxi Baabiloonike moyanji hedhemabaa'a Ribla'a adhdhe dage. <verse eid="JER 52:26" /><verse number="27" style="v" sid="JER 52:27" />Moyanjikinna Hamaatike boga'ni anfeeke Ribla hiyyemaaba shinne birre.</para>
  <para style="p" vid="JER 52:27">Konne qicini Yihudaanna ifike boganaa'ni booji'ende adhdhende. <verse eid="JER 52:27" /><verse number="28" style="v" sid="JER 52:28" />Naabukadanatsoori booji'exxi adhdhemmake manniki laakkossi konneechchi butta hedheen:</para>
  <para style="b" vid="JER 52:28" />
  <para style="li" vid="JER 52:28">Moyeexxe torbaaxxe wogga'n,</para>
  <para style="li2" vid="JER 52:28">Sase kumanna leme tommena sase Ayihudiinka manna;<verse eid="JER 52:28" /></para>
  <para style="li">
    <verse number="29" style="v" sid="JER 52:29" />Naabukadanatsoor moyeexxe tommenna</para>
  <para style="li2" vid="JER 52:29">Saddeetixxe wogga'n, saddeeta dhibbanna sase tommenna lame manna Iyyerusaalemii'n;<verse eid="JER 52:29" /></para>
  <para style="li">
    <verse number="30" style="v" sid="JER 52:30" />Naabukadanatsoori moyeexxe lame tommenna sase wogga'ni, mootummatike minike heqqanjik ajajallo Naabuzerdaan</para>
  <para style="li2" vid="JER 52:30">Torbaane dhibbanna shoole tommenna onde Ayihudiinka manna boji'e adhdheen;</para>
  <para style="li2" vid="JER 52:30">Laakkossi insa'neekinna shoole kumanna jaane dhibba mannamman.<verse eid="JER 52:30" /></para>
  <para style="s1">Yu'aakinixxa Tikensha</para>
  <para style="p">
    <verse number="31" style="v" sid="JER 52:31" />Yihudaki moyanji Ikooniyaani booji'emeexxe sase tommenna torbaxxe wogga'ni, Yoormaroodeki Baabilooni'n moye; tenne wogga'ni tommenna langake agenjo'ni lame tommenna ondixxe barra'ni Yihudak moyanji Ikooniyaani'i hede; usuriinke minenaa'inna iso'o tikise. <verse eid="JER 52:31" /><verse number="32" style="v" sid="JER 52:32" />Eloke hiyyichchinn isoo yaansise; ifi bira Baabilooni booji'eme hedhemmake moyanjuwwi iimi darre ulfini booncho'ni iso'o ugge. <verse eid="JER 52:32" /><verse number="33" style="v" sid="JER 52:33" />Yu'akiini usurii mine'n hedhemma wodda oddo'wammaxxa semma fulchedhe hune; lubboti hedhee bariqico duuchcha'n moyanjiinxe qorenaa'n itaake kade. <verse eid="JER 52:33" /><verse number="34" style="v" sid="JER 52:34" />Baabiloonik moyanjinna Yu'akiini reyaaqico'n, lubboti hedheek baro duuchcha'n kuta belo barra barra'inna itaacho isi'a uwwaamman.<verse eid="JER 52:34" /></para>
  <chapter eid="JER 52" />
</usx>