<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Gedeo Bible</book>
  <para style="h">Mikiyyaasikaa Raaga</para>
  <para style="toc1">Mikiyaasikaa Raaga</para>
  <para style="toc2">Mikiyaasikaa Raaga</para>
  <para style="toc3">Mik.</para>
  <para style="mt1">Mikiyaasikaa Raaga</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Mikiyaasi Issayaasike baro'n hedhemmake raagichchi kadaa wodda; Isi ilememmabi Bita'ixxe Yihudixxe Galichcha giddo hedheeke mitte hadi giddike qachchi giddomman. Middixxe Galchaka arda Mageni mufeti ganaaxxa Amootsi raaga raagemashanni Mikiyaasinna tennee buutoo'an Yihudixxe Galchaka arda Mageni mufeti ganaaxxa raaga raagen. Ardi dhugaa dassati huja'neexxe fuggoxxe hujeexxee Mageni mufeti gana'neexxa xexxe'achchisa'nemman. Kaddo malee Mikiyaasike raagi giddo edi'a kaddaaxxi eloolla yaane hexxeexxa ege'nishshaaki heddi haaso'i hedhemman.</para>
  <para style="ip">Gidii'ninni duudheme haaso'emeek haa'so'uwwiri Mageniinxe mootummaxxe galcha hunda butta duuchcha'ni nage'i heedhaxxa (4:1-4 qico'ni) Iittanni Daawwitixxe boosoxxe galcha'ni Lumok moyanji ke'eexxi ardake nage'a uwwaaxxa; (5:2-4 qico'ni) Iittanni Isira'eelixxi raagole raageke raaga'ni yaada duuchcha mitteba bukki asse abide'eeki mitti laakkossi (6:8 qico'ni) «Isi no'o assinonna'a kule'exxa dhugaa dassinabo'noshsha qajellumma eenannooshsha shaqqunteti Mageniki welti me'inannoshshaten» hiyyaaken.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Duuchchi Woddiki Gootti Arda Ifika Ganaaxxa <char style="ior"><ref loc="MIC 1:1-2:11">1:1—2:11</ref> </char></para>
  <para style="io1">Edi'a kadaaka Addachchiisemeeka yaada <char style="ior"><ref loc="MIC 2:2-13">2:2-13</ref> </char></para>
  <para style="io1">Mageni fuggoxxa Akekkisanuwwanna Dhariyye raagole Mufeti ganaan <char style="ior"><ref loc="MIC 3:1-12">3:1-12</ref> </char></para>
  <para style="io1">Haaroxxe Isira'eeli'a Haaroka Galma <char style="ior"><ref loc="MIC 4:1-5:15">4:1—5:15</ref> </char></para>
  <para style="io1">Isira'eelike Ardixxi Balleesaanjumma Ege'nema <char style="ior"><ref loc="MIC 6:1-7:7">6:1—7:7</ref> </char></para>
  <para style="io1">Mageniba'a Ardiixxa Higa <char style="ior"><ref loc="MIC 7:8-20">7:8-20</ref> </char></para>
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="s1">Samaariyyaxxanna Iyyerusalemmixxa Oodhishsha</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />Iyyo'ataami, Akazinna Hiziqiyaasi weli duuka Yihudaka boga moonee galchinaamma sane Duuchchi Woddik Gootti Moreesheetichcho Mikiyaasi'ni Samaariyaaxxeenna Iyyerusaalemixxee leelishshee'na'a uudeexxi waleelle konneechchi butti'a hexxeexxen.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 15:32-16:20">2 Moy. 15:32—16:20</ref>; <ref loc="2KI 18:1-20:21">2 Moy. 18:1—20:21</ref>; <ref loc="2CH 27:1-7">2 Odo. 27:1-7</ref>; <ref loc="2CH 28:1-32:33">28:1—32:33</ref>. </char></note><verse eid="MIC 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 1:2" />Koo arda ha'no duuchching laqqe!</para>
  <para style="q2" vid="MIC 1:2">Tee buttaa, ise giddo hexxineek duuchchinna caqasse!</para>
  <para style="q1" vid="MIC 1:2">Duuchchi Woddik Gootti ifike woyyichcha Galmanaa'nl,</para>
  <para style="q2" vid="MIC 1:2">Lumok Duuchchi Woodiki Gootti iima ha'no'n dhugaa kula'neen.<verse eid="MIC 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3" />Kunnise Duuchchi Woddiki Gootti ifike galdumanaa'ni daga'neenni;</para>
  <para style="q2" vid="MIC 1:3">dirre dageexxinna buttatixxe koobuwwa hana mareemmaan.<verse eid="MIC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4" />Iitti koobuwwanna isi hunda baqqaan;</para>
  <para style="q2" vid="MIC 1:4">dhooquwwatinna hashaki hitaan;</para>
  <para style="q1" vid="MIC 1:4">Giirati edo hexxeexxe gagashsha</para>
  <para style="q2" vid="MIC 1:4">tarbatenaa'n adade yaa'amake wodi'ishsha kaddaan.<verse eid="MIC 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5" />Tinni duuchcha kaddaak Ya'iqoobixxe balleessaxxe,</para>
  <para style="q2" vid="MIC 1:5">Isira'eelike ardixxe cubboxxeeten.</para>
  <para style="q1" vid="MIC 1:5">Ya'iqoobixxi balleessa maachcho?</para>
  <para style="q2" vid="MIC 1:5">Samaariyaatebaata?</para>
  <para style="q1" vid="MIC 1:5">Yihudak qephphitte magenoonfachchotixxi bakka maachcho?</para>
  <para style="q2" vid="MIC 1:5">Iyyerusaalemitebaata?<verse eid="MIC 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6" />«Tennexxee ani Samaariyaa oletixxe tuulo,</para>
  <para style="q2" vid="MIC 1:6">weyine kaasendaaxxe bakka assannon;</para>
  <para style="q1" vid="MIC 1:6">Kino isexxanna dhooqa giddi'a lolaasannon;</para>
  <para style="q2" vid="MIC 1:6">booso isexxanna xuddi assannon.<verse eid="MIC 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7" />Isexxa fakkuwwa duuchchanna butuchchannon;</para>
  <para style="q2" vid="MIC 1:7">iseke galmixxi uwwaarinna giirati itendaan;</para>
  <para style="q2" vid="MIC 1:7">isexxa misiluwwa duuchchanna balleessannon.</para>
  <para style="q1" vid="MIC 1:7">Ifi'a uwwa yaababulleti bukki assexxemmashsha</para>
  <para style="q2" vid="MIC 1:7">ta'anna bukki assexxemmaxxi uwwa ise yabaabulle ifixxe adhitaake hira kadaan.<verse eid="MIC 1:7" /></para>
  <para style="s1">Yihuda'n daggaaxxa rakko</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8" />Ookkonneechchi udumi'a Mikiyaasi yaadenexxi oodhanon;</para>
  <para style="q2" vid="MIC 1:8">lekka duwwixxenni saali belo hedhannon;</para>
  <para style="q1" vid="MIC 1:8">Jeedaliishsha raaranoni,</para>
  <para style="q2" vid="MIC 1:8">urungotishsha yuusa'ni oodhaannen.<verse eid="MIC 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9" />Saamariyaxxi mada fayyitaaxxebaan,</para>
  <para style="q2" vid="MIC 1:9">tinninni rakko Yihudaana gelte;</para>
  <para style="q1" vid="MIC 1:9">Anke ardixxe e'yatixxe hulanaa'ni</para>
  <para style="q2" vid="MIC 1:9">Iyyerusaalemi qico'ni geliteen» hiyye.<verse eid="MIC 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10" />No'o'ni gelteexxa rakko Gaati hedheke no'oke naphuwwa'ni kuldinoqqe'e.</para>
  <para style="q2" vid="MIC 1:10">Iittanna Ookko ooxxinooqqe.</para>
  <para style="q1" vid="MIC 1:10">Betioofira hedheeke no'oke manni giddo,</para>
  <para style="q2" vid="MIC 1:10">bukote'ni gangalatinna'ni oodhe.<verse eid="MIC 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11" />Ha'no Shaafiriki ardi booji'endine,</para>
  <para style="q2" vid="MIC 1:11">saali belo hexxinaa'ni shookkina'ni me'e.</para>
  <para style="q1" vid="MIC 1:11">Tsa'inaaki ardinna ifike qachchanaa'ni gadhi'a fuloqqe.</para>
  <para style="q2" vid="MIC 1:11">Beti'elinaa'n fulle;</para>
  <para style="q1" vid="MIC 1:11">Umo isenge'ninni oodhishshatixxe bakka kaddammaxxee</para>
  <para style="q2" vid="MIC 1:11">Beti'etseeli giddo golatinaaxxi bakka hexxabaan.<verse eid="MIC 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12" />Rakkotenaa'ni gatiyyotixxe yortenni,</para>
  <para style="q1" vid="MIC 1:12">Maarotii hedheek ardi wixxir hiyyati,</para>
  <para style="q2" vid="MIC 1:12">wixirataan;</para>
  <para style="q1" vid="MIC 1:12">Iyyerusaalemixxe hula qico'ni</para>
  <para style="q2" vid="MIC 1:12">fuggoxxe yaane Duuchchi Woddike Goottanaa'ni dagge'een.<verse eid="MIC 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13" />Ha'noo koo Lakishi hexxineekir,</para>
  <para style="q2" vid="MIC 1:13">fadhaduwwa sarageelik welti abidisse;</para>
  <para style="q1" vid="MIC 1:13">Tsiyoonixxi meyyaxxi belto,</para>
  <para style="q2" vid="MIC 1:13">cubbotixxe siretixxe amamman;</para>
  <para style="q1" vid="MIC 1:13">Isira'eelixxi balleessa,</para>
  <para style="q2" vid="MIC 1:13">ha'no'ni afende'een.<verse eid="MIC 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14" />Koo Yihudak arda, ha'no Moreesheti Gaati'a,</para>
  <para style="q2" vid="MIC 1:14">nage'iki hedhi hiyyatixxa uwwa uutinaan; Akizibiki ardinna Isira'eelika moyanijuwwa sobaan.<verse eid="MIC 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15" />Ha'no koo Meriisa hexxina'neeke arda!</para>
  <para style="q2" vid="MIC 1:15">Ha'no'o injifataaka naapha iyyedagannon;</para>
  <para style="q1" vid="MIC 1:15">Iikki Isira'eelik ulfinna kade'eek</para>
  <para style="q2" vid="MIC 1:15">Adulamixxe wo'lo'o'ni sho'ommaan.<verse eid="MIC 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16" />Ha'no eetinaaxxe ha'nooxxe oosexxee</para>
  <para style="q2" vid="MIC 1:16">yaadoti umo ha'noka haaxxe;</para>
  <para style="q1" vid="MIC 1:16">Umo hanoka allaatetike umishsha qunca'we;</para>
  <para style="q2" vid="MIC 1:16">insa'ne ha'nonaa'ni booji'oti adhdhemmaan.<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="s1">Hiyyeeyye Miicaake Manna'ni Geltaaxxa Rakko</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1" />Elobaaxxa assatee heda'ni diipheenbaa hedhee,</para>
  <para style="q2" vid="MIC 2:1">foggoxxee malaake manni'a aanne'e isi'a!</para>
  <para style="q1" vid="MIC 2:1">Hendeemmaxxa assatte dandennammaxxee bogi sooda woddaa isee muunxaan.<verse eid="MIC 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2" />Mitte annika fichcha gabinoole hunanidinni abixxinani;</para>
  <para style="q2" vid="MIC 2:2">minekanna gaabbinoole adhdhinaan;</para>
  <para style="q1" vid="MIC 2:2">Manjokee'n mine</para>
  <para style="q2" vid="MIC 2:2">karrandinni seeri belo mulqe'naan.<verse eid="MIC 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3" />Tennexxee Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="MIC 2:3">«Kunnise ookkone arda'ni ba'ne iyyedagannon;</para>
  <para style="q2" vid="MIC 2:3">ha'nonna ookko'ni baajine fula dandeetinabaan;</para>
  <para style="q1" vid="MIC 2:3">Rakkotixxe yanna kaddemmaxxee'e</para>
  <para style="q2" vid="MIC 2:3">ta'inni elqi'a hollati mammarendinabaan.<verse eid="MIC 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4" />Eettenne barra manni ha'no'ni qagifataan;</para>
  <para style="q2" vid="MIC 2:4">insa'ne yaadotixxe oodhishshanni hina'ni ha'no coorraa qici,</para>
  <para style="q1" vid="MIC 2:4">‹No'o ijje ba'ne'ennen;</para>
  <para style="q2" vid="MIC 2:4">Duuchchi Woddiki Gootti boga no'a'oka qoodeen;</para>
  <para style="q1" vid="MIC 2:4">Anenaa'ni bute aadhdhexxi,</para>
  <para style="q2" vid="MIC 2:4">karra no'oxxanna no'o booji'emmake manni'a qoqqoodeen.› »<verse eid="MIC 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5" />Tennexxee Duuchchi Woddik Gootik ya'i giddo</para>
  <para style="q2" vid="MIC 2:5">fichcha hixik qoqqoodemaak ayyinna hedhabaan.<verse eid="MIC 2:5" /></para>
  <para style="s1">Dhariyye Wabeekole</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6" />Wabeekko insa'nexxi: «Raaga no'o'ni raagge;</para>
  <para style="q2" vid="MIC 2:6">tenne yaanuwwaxxee raaga raaggoxxee;</para>
  <para style="q2" vid="MIC 2:6">salphinni no'o'ni geyabaan» hinaan.<verse eid="MIC 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7" />Koo Ya'iqoobike mini hado iitta hiyya ati'a hasissaata? Higgeenna haasonna'ni,</para>
  <para style="q2" vid="MIC 2:7">«Duuchchi Woddike Goottik hafuur ossabaakeeta?»</para>
  <para style="b" vid="MIC 2:7" />
  <para style="q1" vid="MIC 2:7">«Ori isik toggichchake kadeekee,</para>
  <para style="q2" vid="MIC 2:7">hiyyichchi anki eloxxa yaane assabata?<verse eid="MIC 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8" />Duuchchi Woddik Goottinna muuxamake'ni</para>
  <para style="q2" vid="MIC 2:8">anke arda'ni ha'no naaphake kaddine</para>
  <para style="q1" vid="MIC 2:8">Kexxineen;</para>
  <para style="q2" vid="MIC 2:8">insa'ne loliinka yaada anffebaangi,</para>
  <para style="q1" vid="MIC 2:8">Lolakenaa'ni higee nage'ake hiyya'ne manna</para>
  <para style="q2" vid="MIC 2:8">qeerraxxa seemmanna fugantammaxxa muliqeexineen.<verse eid="MIC 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9" />Insa'ne eloke ifike minenaa'ni</para>
  <para style="q2" vid="MIC 2:9">anke ardixxa melaale afeexxe karranaa'ni fulchitineen.</para>
  <para style="q1" vid="MIC 2:9">Ulfina anka oose insa'nexxenaa'ni,</para>
  <para style="q2" vid="MIC 2:9">duuchchi woddi'a gataashsha assitineeni.<verse eid="MIC 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10" />Kunni ha'no foorfatinaake booncho kada gopheemmaxxee</para>
  <para style="q2" vid="MIC 2:10">kabaa'ni kexxine me'e hiyye;</para>
  <para style="q1" vid="MIC 2:10">Buutotinna insa'ne battone'een;</para>
  <para style="q2" vid="MIC 2:10">fuggoxxen gara ba'ne'een.<verse eid="MIC 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11" />Mitti manji dharik dageexxi,</para>
  <para style="q2" vid="MIC 2:11">‹Heddo woyinetik bulbulixeenna machchosake ha'wixxee ha'no'a raaga raaga'ennen› hiyyoole,</para>
  <para style="q2" vid="MIC 2:11">konne ardi'a wabeekko kadaak isoten.»<verse eid="MIC 2:11" /></para>
  <para style="s1">Anjirenshanna Addachchiisa</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12" />«Koo Isira'eelike arda! Dhugaandinni ha'no duuchchinga bukki assaannen;</para>
  <para style="q2" vid="MIC 2:12">Isira'eelike ardana'ni gatteexxa hafe mitteba bukki asse iyyedagaannen;</para>
  <para style="q1" vid="MIC 2:12">Goodhe giddo hedheeke gedhebishsha bobba'e dheeda fuleeke horiinke haaganishsha mitteba ha'noo bukki assannon;</para>
  <para style="q2" vid="MIC 2:12">boonchikinna ardik wo'maan.<verse eid="MIC 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13" />Enqaak dageexxi ha'no edo me'aan;</para>
  <para style="q2" vid="MIC 2:13">insa'nenna cufana enqinee fullee me'inaan;</para>
  <para style="q1" vid="MIC 2:13">Duuchchi Woddiki Gootti insa'nee akeeka'n</para>
  <para style="q2" vid="MIC 2:13">insa'nek moyanijnna ediseen insa'ne edo me'aan.»<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="s1">Akeekisanjuwwinna Wabeeko Xixende</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1" />Ookkonneechchinni uduma ani insa'ne'e hiyyenee qici:</para>
  <para style="q1" vid="MIC 3:1">«Ha'no Ya'iqoobike ardik akeekisanjuwwi;</para>
  <para style="q2" vid="MIC 3:1">ha'no Isira'eelik minik galchaluwwi laqqe</para>
  <para style="q1" vid="MIC 3:1">Dhugatixxa murte ege'na ha'no'a hasissaabata?<verse eid="MIC 3:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="MIC 3:2" />Ha'no kinni eloxxa gibbinee fuggoxxa eetineen;</para>
  <para style="q1" vid="MIC 3:2">Ardi ankika goga duldineen;</para>
  <para style="q2" vid="MIC 3:2">maala insa'nekanna soqqinee miqqe fulchitineen.<verse eid="MIC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3" />Anke ardika maala ittineen;</para>
  <para style="q2" vid="MIC 3:3">gogakanna duldineen;</para>
  <para style="q2" vid="MIC 3:3">micco insa'neekanna enqitineen;</para>
  <para style="q1" vid="MIC 3:3">Odolchote'ni ganfammashsha maala insa'neekanna kukkutineen.»<verse eid="MIC 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4" />Insa'nenna Duuchchi Woddike Gootibaa raarraan;</para>
  <para style="q2" vid="MIC 3:4">yaane kinn isi raarre insa'neexxa laqabaan.</para>
  <para style="q1" vid="MIC 3:4">Insa'ne hunjeexxe fuggoxxe hujenaa'ni kexxeexxa;</para>
  <para style="q2" vid="MIC 3:4">ookkone wodda isi alba ifika insa'nenaa'n hoyyedhaan.<verse eid="MIC 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5" />Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="MIC 3:5">«Arda anka dedhissa'neexxe dharameeyye wabeekkonaa'ni</para>
  <para style="q2" vid="MIC 3:5">manni insa'nee itise ha'wisaa wodda ‹Nage'i hedheen› hinaan;</para>
  <para style="q2" vid="MIC 3:5">Itinse ha'wisa gonphoole kinni.</para>
  <para style="q2" vid="MIC 3:5">Bogake'n bagedo lassino'a ke'naan.<verse eid="MIC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6" />Tennexxee hashsha waleella belo,</para>
  <para style="q2" vid="MIC 3:6">dukkanatinna mitte haaso'i belo,</para>
  <para style="q2" vid="MIC 3:6">insa'ne'n daggaan;</para>
  <para style="q1" vid="MIC 3:6">Wabeekote'n arishsho dukkandaan;</para>
  <para style="q2" vid="MIC 3:6">baratinna insa'ne'ni dukkandaan.<verse eid="MIC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7" />Mageni hiissichcho insa'ne'a uwwa gophemmaxxee</para>
  <para style="q2" vid="MIC 3:7">waleella udamaakiir shookaan;</para>
  <para style="q1" vid="MIC 3:7">Edi'a kaddaaxxa kulamakiirinna salphataan;</para>
  <para style="q2" vid="MIC 3:7">duuchchingi alba ifika buqedhaan» hiyye.<verse eid="MIC 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8" />Ani kinni;</para>
  <para style="q2" vid="MIC 3:8">Ya'iqoobi'a balleessa isixxa; Isira'eeli'anna cubbo isixxa kulannoshsha</para>
  <para style="q1" vid="MIC 3:8">Hunna Duuchchi Woddike Goottike hafuurinn;</para>
  <para style="q2" vid="MIC 3:8">dhugaatixxe murtenninna hunati wo'meennen.<verse eid="MIC 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9" />Ha'no Ya'iqoobike minike akeekisanjuwwa;</para>
  <para style="q2" vid="MIC 3:9">ha'no Isira'eelike minki galchanjuwwi;</para>
  <para style="q1" vid="MIC 3:9">Dhugaatixxa murte tuffatinaak;</para>
  <para style="q2" vid="MIC 3:9">toggite yaane duuchcha dassitinaak laqqe.<verse eid="MIC 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10" />Ha'no Tsiyoonixxa munde dunati</para>
  <para style="q2" vid="MIC 3:10">Iyyerusaalemika qachcha dabik ijartinaak laqqe.<verse eid="MIC 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11" />Akeekisanjuwwi isek murte uwwa'neek mattikiten;</para>
  <para style="q2" vid="MIC 3:11">qesetinna rundakee hite barsiissa'neen;</para>
  <para style="q1" vid="MIC 3:11">Waabeekkoletinna maalaqi belo wabeekkuma haasota'nebaan;</para>
  <para style="q2" vid="MIC 3:11">yaane kinni Duuchchi Woddike Gootta'n irkanteexxi he'ne;</para>
  <para style="q1" vid="MIC 3:11">«Duuchchi Wooddiki Gootti no'on hedhebaata?</para>
  <para style="q2" vid="MIC 3:11">heene bifaxxi fuggoxxi yaane no'o'n geltabaani» hinaani.<verse eid="MIC 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12" />Tennexxee ha'noxxe buuttonaa'ni keexxexxa;</para>
  <para style="q2" vid="MIC 3:12">Tsiyooni huccinammake fichchishsha kaddaani;</para>
  <para style="q1" vid="MIC 3:12">Iyyerusaalemi oletixxe tuulo kaddaan;</para>
  <para style="q2" vid="MIC 3:12">Woyyichchi Galmi ijaarememmak tulchchi urimee gataan.<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="JER 26:18">Erm. 26:18</ref>. </char></note><verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="s1">Nagelitte Duuchchi Wooddike Goottixxe Mottumaxxa Daga.</para>
  <para style="r">(<ref loc="ISA 2:1-4">Isa. 2:1-4</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 4:1" />Udumike barro'n</para>
  <para style="q2" vid="MIC 4:1">Duuchchi Woddike Goottiki Galmi ijaaremeexxi Kooba</para>
  <para style="q2" vid="MIC 4:1">wele Koobuwwa duuchchanaa'ni caaldee leellita</para>
  <para style="q2" vid="MIC 4:1">Tulluwwa duuchchanaa'ni lummexxe quba saxxan</para>
  <para style="q2" vid="MIC 4:1">arduwwikinna iseba'a dhi'maan.<verse eid="MIC 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 4:2" />Tennexxee heddo gosaki ardi dage hiyyaa qici,</para>
  <para style="q1" vid="MIC 4:2">«Ammee Duuchchi Woddike Goottixxe Koobabaa;</para>
  <para style="q1" vid="MIC 4:2">Ya'iqoobike Magenike Galmba'anna me'ino</para>
  <para style="q2" vid="MIC 4:2">ora Isikanna no'o'n barsiisaan»</para>
  <para style="q1" vid="MIC 4:2">Seeri Tsiyooni'n dagaan;</para>
  <para style="q2" vid="MIC 4:2">Duuchchi Woddike Goottiki hiyyichchinna Iyyerusaalemi'n.<verse eid="MIC 4:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3" />Isi heddo ardu'wwixxe oddo'n murte muraan</para>
  <para style="q1" vid="MIC 4:3">Shiqqonna bayya hedheeke jajjabba arduuwwixxe oddo'n</para>
  <para style="q2" vid="MIC 4:3">hexxeexxa weli gonphphe balleessaan</para>
  <para style="q1" vid="MIC 4:3">Ardi wolantichcha ifika qotto</para>
  <para style="q2" vid="MIC 4:3">bagedokenna haantote asse giisaan.</para>
  <para style="q2" vid="MIC 4:3">Mitte bogiki ardi wele bogike arda'n wolantichcha ke'isabaan;</para>
  <para style="q2" vid="MIC 4:3">ookkonneechchi uduuma bagedinxa baranno barrataki hedhebaan.<note caller="-" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="JOL 3:10">Iyu. 3:10</ref>. </char></note><verse eid="MIC 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4" />Mitti mittingi manji ifike woyinetike hiddichchi hunda;</para>
  <para style="q2" vid="MIC 4:4">ifixxe Belesetike gaddissi hunda ofo'laan;</para>
  <para style="q1" vid="MIC 4:4">Insa'ne sodaachisaak hedhebaan;</para>
  <para style="q2" vid="MIC 4:4">Dada duuchcha ajajaak Duuchchi Woddik Gootti Mageni tennee haaso'e'en.<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="ZEC 3:10">Zek. 3:10</ref>. </char></note><verse eid="MIC 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5" />Gosa gosaki Ardi duchchi;</para>
  <para style="q2" vid="MIC 4:5">ifi ifike dharichcha mageno magenoonfataan</para>
  <para style="q1" vid="MIC 4:5">No'o kinni Duuchchi Wooddike Gootta no'oke Magenike summinni;</para>
  <para style="q2" vid="MIC 4:5">duuchchi woddanaa'ni duuchchi woddi qico'n me'inaanen.<verse eid="MIC 4:5" /></para>
  <para style="s1">Booji'otenaa'ni Isira'elike Ardixxa Illee Iima Higa</para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 4:6" />Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="MIC 4:6">«Eettene barra nafuuwwakanna bukki assannoni;</para>
  <para style="q2" vid="MIC 4:6">Ani booji'emeekanna rakko geltashsha assennaka;</para>
  <para style="q2" vid="MIC 4:6">mitte bakkaba'a insa'nee iyyedagannon.<verse eid="MIC 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7" />Hafe gatemmak Naafuwwi,</para>
  <para style="q2" vid="MIC 4:7">hunememmaka jabake arda assannoni;</para>
  <para style="q1" vid="MIC 4:7">Eettene barranaa'ni ke'isse duuchchi woddi qico'n;</para>
  <para style="q2" vid="MIC 4:7">Duuchchi Woddik Gootti Tsiyoonixxe Kooba hana insa'ne'ni moyaannon.<verse eid="MIC 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8" />Tee hore heqqatixxe Xelleephpho!</para>
  <para style="q2" vid="MIC 4:8">Ati Tsiyoonixxe dubarichchoke tulichcha</para>
  <para style="q1" vid="MIC 4:8">Edi woddixxi galcha atixxi ati'a higgaani;</para>
  <para style="q2" vid="MIC 4:8">mootummatiki baalloomi Iyyerusaalemixxe belto'aa kadaani.»<verse eid="MIC 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9" />Ta'a ati itta raaritatelchi mayye'ate?</para>
  <para style="q2" vid="MIC 4:9">moyanji ati'a hedheba?</para>
  <para style="q1" vid="MIC 4:9">Ciniifata'nexxe manjichchoshsha rakkattetek;</para>
  <para style="q2" vid="MIC 4:9">atee gorsammakiir mudeexxeete?<verse eid="MIC 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10" />Tee Tsiyoonixxe belto;</para>
  <para style="q2" vid="MIC 4:10">ciniifata'neexxe manijichchoshsha rakkati;</para>
  <para style="q1" vid="MIC 4:10">Ta'a qachchakenaa'n fuldettexxi</para>
  <para style="q2" vid="MIC 4:10">umo ugginaabi hedheeba'a marte ofo'li</para>
  <para style="q1" vid="MIC 4:10">Baabilooni'aanna me'itatton;</para>
  <para style="q2" vid="MIC 4:10">ookkonna naaphinxe anganaa'ni anjirendatton;</para>
  <para style="q1" vid="MIC 4:10">Duuchchi Woddiki Gootti ookko</para>
  <para style="q2" vid="MIC 4:10">atike naaphuwwanaa'ni ate gargaaraani.<verse eid="MIC 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11" />Ta'a kinni heddo gossaki arduwwi</para>
  <para style="q2" vid="MIC 4:11">ate'n bukki hiyye'een</para>
  <para style="q1" vid="MIC 4:11">Insa'nenna «Ise batoteexxe kadduuni;</para>
  <para style="q2" vid="MIC 4:11">ille no'oxxen Tsiyooni'i qacifanta'ni uundannon» hinaan.<verse eid="MIC 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12" />Yaane kinni insa'ne Duuchchi Woddike Goottika yaada egennebaan.</para>
  <para style="q2" vid="MIC 4:12">Alduumete'ni ladde bukki assinammashsha</para>
  <para style="q1" vid="MIC 4:12">Insa'nee bukki assaaka;</para>
  <para style="q2" vid="MIC 4:12">isika yaada qalli hinabaan.<verse eid="MIC 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13" />«Tee Tsiyoonixxe belto; kexxettexxi uxxi;</para>
  <para style="q2" vid="MIC 4:13">siblinka gaafa ati'a uwwannon;</para>
  <para style="q1" vid="MIC 4:13">Sageetotixxa kotte ati'a uwannon;</para>
  <para style="q2" vid="MIC 4:13">gosa gosaka arda bulleessitatton»</para>
  <para style="q1" vid="MIC 4:13">Dabiki bukki assinemmaxxa karra Duuchchi Woddike Gootti'a</para>
  <para style="q2" vid="MIC 4:13">duruma insa'neexxa butta duuchchike gootti'a shiqishatton.<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 5:1" />«Ati lolinke mannike Qachcha!</para>
  <para style="q2" vid="MIC 5:1">Sannachcha atika qophpheessi.</para>
  <para style="q1" vid="MIC 5:1">No'o buqemeennen;</para>
  <para style="q2" vid="MIC 5:1">Isira'eelika akeekisanjonna</para>
  <para style="q2" vid="MIC 5:1">siqqoti boqo gannaan.»<verse eid="MIC 5:1" /></para>
  <para style="s1">Betelheemi'ni Ke'ake Moyaniji'a Kulemeeka Waabekkuma</para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2" />Mageni hiyya'nee qici, «Tee Efiraatake bogixxe Beeteliheemi!</para>
  <para style="q2" vid="MIC 5:2">Ati Yihudi giddo hedheeke shiixaaramma qachchuwwanaa'ni tenna kaddotole,</para>
  <para style="q1" vid="MIC 5:2">Hundaayye Isixxi,</para>
  <para style="q2" vid="MIC 5:2">edo olmii'ni kexxeexxa,</para>
  <para style="q1" vid="MIC 5:2">Isira'eelika galchallo moyanjo</para>
  <para style="q2" vid="MIC 5:2">ifi'a ke'issedhannon» hiyye.<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 2:6">Mat. 2:6</ref>; <ref loc="JHN 7:42">Yoh. 7:42</ref>. </char></note><verse eid="MIC 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3" />Tene'a ama isoo ciniiffatte ildaa qico'ni,</para>
  <para style="q2" vid="MIC 5:3">Isira'eeli waalenda;</para>
  <para style="q1" vid="MIC 5:3">Gateek isik dayyuwwinna,</para>
  <para style="q2" vid="MIC 5:3">illeema higeexxi booji'emeeki isixxe gosaki ardi gosa ifixxiba'a higaan.<verse eid="MIC 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4" />Isi Duuchchi Woddikie Goottixxe hunnanni,</para>
  <para style="q2" vid="MIC 5:4">ookkone Duuchchi Woddike Goottike summike lumminninni,</para>
  <para style="q2" vid="MIC 5:4">ti'ni hiyyee uurran; arda isikanna allala;</para>
  <para style="q1" vid="MIC 5:4">Eettene yanna isik lumminni buttatixxe gabala qico'n geyammaxxee,</para>
  <para style="q2" vid="MIC 5:4">insa'ne'e soda'a belo he'naan.<verse eid="MIC 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5" />Isinna nage'a insa'neke kadaan.</para>
  <para style="s1" vid="MIC 5:5">Anjiranna Ba'ne</para>
  <para style="q2" vid="MIC 5:5">Asoorik manni lolo'a no'oke boga'ni daga wodda,</para>
  <para style="q2" vid="MIC 5:5">qachcha no'okika dala'a tansaase e'yoole,</para>
  <para style="q1" vid="MIC 5:5">Torbaane heqaaka mannanna</para>
  <para style="q2" vid="MIC 5:5">matanga sadeeta akeekisanjuwwa insa'ne'ni woci assinannoni.<verse eid="MIC 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6" />Asoorka boga wolaantichchik,</para>
  <para style="q2" vid="MIC 5:6">Namiruudika boganna lolle injifante abindaan;</para>
  <para style="q1" vid="MIC 5:6">Asoorik manni no'o lolee,</para>
  <para style="q2" vid="MIC 5:6">boga no'oka abidoole,</para>
  <para style="q2" vid="MIC 5:6">isi no'o insa'neexxe aniganaa'ni gatisaan.<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="GEN 10:8-11">Dada. 10:8-11</ref>. </char></note><verse eid="MIC 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7" />Reyotenaa'ni gateeki Isira'eelik ardi,</para>
  <para style="q2" vid="MIC 5:7">giddo hedheke heddo gosake arduwi'a,</para>
  <para style="q1" vid="MIC 5:7">Duuchchi Woddik Gootti iimi'ni uwwammake wojishsha,</para>
  <para style="q2" vid="MIC 5:7">bada'ate'ni kiiffammaxxe kiifoshsha,</para>
  <para style="q1" vid="MIC 5:7">Manjo heqqammabaake,</para>
  <para style="q2" vid="MIC 5:7">manjiinka beltonna adamabaake manjishsha kada.<verse eid="MIC 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8" />Heddo biniichchuwwi giddo hedheeke neenqisha,</para>
  <para style="q2" vid="MIC 5:8">lekka ifixxenni maxaqi assa'ni me'ammake,</para>
  <para style="q1" vid="MIC 5:8">Buttuchemmakanna ayyinna isonaa'ni butte aadha dandeessisemmabaake,</para>
  <para style="q2" vid="MIC 5:8">gedheebi giddo hedheeke,</para>
  <para style="q1" vid="MIC 5:8">Oosichcha neenqishsha</para>
  <para style="q2" vid="MIC 5:8">Ya'iqoobike ardixxi hafe, gosa gosake arda'n, heddo arduwwi giddonna iitta kaddaan.<verse eid="MIC 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9" />Isira'eelxi hunna naaphuwwake'n injiifachchoti kexxaan;</para>
  <para style="q2" vid="MIC 5:9">atik naaphi duuchchinna ba'a.<verse eid="MIC 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10" />«Eettene yanna» Duuchchi Woddik Gootti,</para>
  <para style="q1" vid="MIC 5:10">«Ha'noka loliinka fadhado ha'no giddii'n balleessanno;</para>
  <para style="q2" vid="MIC 5:10">hanoxxa gaaruwwanna birano.<verse eid="MIC 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11" />Boga ha'nokika qachchuwwa bakka balleessanno;</para>
  <para style="q2" vid="MIC 5:11">ha'noka kinjinka dalla'uwwanna diiganno.<verse eid="MIC 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12" />Ha'nooxxa moronna balleesanno;</para>
  <para style="q2" vid="MIC 5:12">ta'anni edi'anna mortinaba'a.<verse eid="MIC 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13" />Ha'nooxxa gissendeexxa misiluwwa,</para>
  <para style="q2" vid="MIC 5:13">magnoonfatinammaxxa ha'noxxa soodduwwanna, ha'no giddii'n balleessanno;</para>
  <para style="q1" vid="MIC 5:13">Ta'anni edi'a anga ha'noxxixxe huje'a</para>
  <para style="q2" vid="MIC 5:13">ha'no sagadinaba'a.<verse eid="MIC 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14" />Asherate hiyyendaaxxa sooddotixxa misile ha'no giddii'ni goshanno;</para>
  <para style="q2" vid="MIC 5:14">ha'nooka qachchuwwanna bakka balleessanno.<verse eid="MIC 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15" />Ani'a ajajemabaaka gosa gosaka arduwwa,</para>
  <para style="q2" vid="MIC 5:15">aaretinna balati insa'ne'n halo fulanno.»<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="s1">Duuchchi Wooddiki Gootti Isria'lika Arda Ku'le qico</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1" />Duuchchi Woddiki Gootti hiyya'neexxa laqqe:</para>
  <para style="q1" vid="MIC 6:1">«Ke'we ha'noka yaada</para>
  <para style="q2" vid="MIC 6:1">tullichchuwwikinna hano hitinaaxxa laquun:<verse eid="MIC 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2" />Ha'no tee koobuwwa Duuchchi Woddike Goottixxa ku'la caqasse;</para>
  <para style="q2" vid="MIC 6:2">ha'nonna jabaxxi buttatixxi boosuwwanna caqasse;</para>
  <para style="q1" vid="MIC 6:2">Duuchchi Woddik Gootti arda ifike'ni moronshate afe'een;</para>
  <para style="q2" vid="MIC 6:2">Isira'eelinna daabata'neexxe yaane afe'een.<verse eid="MIC 6:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3" />«Anke arda ani atee maassenne?</para>
  <para style="q2" vid="MIC 6:3">ate'ni ba'ote kadene qicitta hitate?</para>
  <para style="q2" vid="MIC 6:3">amo ani'a hiissichcho uwwi.<verse eid="MIC 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4" />Ani ha'noo Gibtsee'n fulchenne;</para>
  <para style="q2" vid="MIC 6:4">garbummatike boganaa'ni ha'no'o wodenne;</para>
  <para style="q1" vid="MIC 6:4">Ha'noo akeenkaashanna Muuse,</para>
  <para style="q2" vid="MIC 6:4">Aarooniinna Maaryaamii'i ha'no'a ergenne.<verse eid="MIC 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5" />Koo anke ardaa,</para>
  <para style="q2" vid="MIC 6:5">Mo'aabik moyanji Balaaqi mari'atemmaxxa,</para>
  <para style="q2" vid="MIC 6:5">Bi'oork belti Bele'aaminna uwwemmaka hiisichchonna amme hedde;</para>
  <para style="q1" vid="MIC 6:5">Duuchchi Woddike Goottixxa qullumatixxa huje egendino'a,</para>
  <para style="q2" vid="MIC 6:5">Shiximinaa'n Geligeela qico'n me'itinemmaka ha'noka me'injo amme hedde.»<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="NUM 22:2-24:25">Lak. 22:2—24:25</ref>; <ref loc="JOS 3:1-4:19">Iya. 3:1—4:19</ref>. </char></note><verse eid="MIC 6:5" /></para>
  <para style="s1">Duuchchi Wooddik Gootti Ardi Ifiki Maa Asso'a Eyaa'neexxa</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6" />Maa abixxee Duuchchi Wooddike Gootti edo shiqanno?</para>
  <para style="q2" vid="MIC 6:6">Lumoke Mageni edo sagadanno?</para>
  <para style="q1" vid="MIC 6:6">Ciincatika tolcha</para>
  <para style="q2" vid="MIC 6:6">mitte woggaka jibbichcha abixxe isi edo shiqoota?<verse eid="MIC 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7" />Kuma gedhebiinxe korbeeyyen,</para>
  <para style="q2" vid="MIC 6:7">tomme kuma dhangalasendaaxxe ejersiinxe zayite'n Duuchchi woddik Gootti gammadaata?</para>
  <para style="q1" vid="MIC 6:7">Anxe balleessaxxee anka angafa belto,</para>
  <para style="q2" vid="MIC 6:7">anxe lubboxxe cubboxxee anke godobixxa gumma isi'aa shiqishshannota?<verse eid="MIC 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8" />Koo manjo, isi eloxxe kaddeexxa ate'ni leellishe'een;</para>
  <para style="q2" vid="MIC 6:8">Duuchchi Woddik Gootti atenaa'ni hasaachchi maacho?</para>
  <para style="q1" vid="MIC 6:8">Dhugaa hujjota'a, mararittotanna eetota'a,</para>
  <para style="q2" vid="MIC 6:8">atike Mageni edonna ba'lunteti me'ittatobaata?<verse eid="MIC 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9" />Summa atika sodaatiyyo beekkumaken;</para>
  <para style="q2" vid="MIC 6:9">caqasse! Duuchchi Woddik Gootti konne qachcha hiyya'ni ye'a'nee qici,</para>
  <para style="q2" vid="MIC 6:9">«Tenne siqqichcho hedde,</para>
  <para style="q2" vid="MIC 6:9">ise qophpheseekinna aate kadeexxa qaabante.<verse eid="MIC 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10" />Koo fuggoke ardaa,</para>
  <para style="q2" vid="MIC 6:10">seeri belo afendeexxa ha'noxxa karra,</para>
  <para style="q2" vid="MIC 6:10">dharchcha saffarsanjinni bukk asexxineexxa diqachchiissaaxxa yaane ani dedhanota?<verse eid="MIC 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11" />Seeri beloxxa kiilo afeeka manjo,</para>
  <para style="q2" vid="MIC 6:11">dharitte kiiloka kiilsanjo kollonjo'n gudunfedheeka manna ani uuda'n waalannota?<verse eid="MIC 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12" />Dureeyye isexxi fuggoxxa assitaaxxen;</para>
  <para style="q2" vid="MIC 6:12">isek manninna dharichchake;</para>
  <para style="q2" vid="MIC 6:12">insa'nek arabinna lameken.<verse eid="MIC 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13" />Tennexxee atee balleessanno;</para>
  <para style="q2" vid="MIC 6:13">cubbo atixxenaa'ninna kexxeexxa ate'e diigannon.<verse eid="MIC 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14" />Ittatton yaane kinni godditaboxxon;</para>
  <para style="q2" vid="MIC 6:14">godobi atikinna hedheeshshanni duwwike kadaan;</para>
  <para style="q1" vid="MIC 6:14">Tuu'litatton yaane kinni ati'a qusemabaan;</para>
  <para style="q2" vid="MIC 6:14">bukki assexxetelcho ani wolaantichchake sa'isse uwwannon.<verse eid="MIC 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15" />Wiilstatton, yaane kinni aassexxaboxxo;</para>
  <para style="q2" vid="MIC 6:15">woyinetixxa atixxa zayite miicexxatton, yaane kinni zayite eetene issattaboxxo;</para>
  <para style="q2" vid="MIC 6:15">woyinetanna woxxexxatton, yaane kinni woyinetixxa booka ha'witaboxxo.<verse eid="MIC 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16" />Ha'no Omirxa aada,</para>
  <para style="q2" vid="MIC 6:16">mowanjo Aki'aabika adaba duuchcha hordoffinemmaxxeeten;</para>
  <para style="q2" vid="MIC 6:16">insa'neka galdumanna hordofina'neen;</para>
  <para style="q1" vid="MIC 6:16">Tennexxe ha'noo balleessatee,</para>
  <para style="q2" vid="MIC 6:16">atika ardanna qacifachotee sa'isse uwwanno;</para>
  <para style="q2" vid="MIC 6:16">gosa gosak ardinna ate'ni qere qere hiyyaan.»<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="1KI 16:23-34">1 Moy. 16:23-34</ref>; <ref loc="1KI 21:25-26">21:25-26</ref>. </char></note><verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="s1">Isira'eelike Ardixxa fuggoxxa Huje</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1" />Aanne'e ani'a!</para>
  <para style="q1" vid="MIC 7:1">Woyinetixxi gumma qocendammaxxa yanna</para>
  <para style="q2" vid="MIC 7:1">bonixxa woyinetixxa gumma feshshilammake manjo kadeennen;</para>
  <para style="q1" vid="MIC 7:1">Itatee eldaaxxi woyinetixxi rodde hexxebaan;</para>
  <para style="q2" vid="MIC 7:1">ani halchannoxxi umoke'ni geltaaxxi balasenna hexxebaan.<verse eid="MIC 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2" />Mageno sodaataak manji buttate'ni gophemeen;</para>
  <para style="q2" vid="MIC 7:2">mittikinna midde qajeeli manji hedhebaan;</para>
  <para style="q1" vid="MIC 7:2">Manji duuchchi munde dhangalaaso'a gaadaan;</para>
  <para style="q2" vid="MIC 7:2">mitti mitting ififika dayyo marabeti fonxoraan.<verse eid="MIC 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3" />Duuchchingixxi anga fuggoxxa assatee muxxe fuldeexxe;</para>
  <para style="q2" vid="MIC 7:3">galchalli anga ibirsha hasaan;</para>
  <para style="q1" vid="MIC 7:3">Murte muraakinna matta adhdhaan;</para>
  <para style="q2" vid="MIC 7:3">hunnatikiirnna eeyyeexxa assa;</para>
  <para style="q2" vid="MIC 7:3">duuchchingi fugoxxa assatee mala.<verse eid="MIC 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4" />Insa'nenaa'ni woyya hiyyemaak hagalake,</para>
  <para style="q2" vid="MIC 7:4">hara qajeeltotenni hiyyendaaxxi qu'mudotishshate;</para>
  <para style="q1" vid="MIC 7:4">Ha'noke erganjuwwa'ni barra dagge'een;</para>
  <para style="q2" vid="MIC 7:4">Magenixxi murtetixxi barranna shiqqe'een;</para>
  <para style="q2" vid="MIC 7:4">insa'nexxi weekenshshatixxi yannanna shiqqe'een.<verse eid="MIC 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5" />Ollalcho atika mee aman;</para>
  <para style="q2" vid="MIC 7:5">jaalo atikanna addatoxxe'e;</para>
  <para style="q1" vid="MIC 7:5">Welti galdattoxxe are atixxe'ni midde</para>
  <para style="q2" vid="MIC 7:5">haasottatoka hiyyichcho xexxe'ati.<verse eid="MIC 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6" />Belti labbak anna ifika tuffata;</para>
  <para style="q2" vid="MIC 7:6">belto meyyaxxi ama ifixxe'ni</para>
  <para style="q1" vid="MIC 7:6">Beltiinxi ballo ifixxe'ni kexxa;</para>
  <para style="q2" vid="MIC 7:6">manjik naaphi ifike minike hado kada.<note caller="-" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="MAT 10:35-36">Mat. 10:35-36</ref>; <ref loc="LUK 12:53">Luq. 12:53</ref>. </char></note><verse eid="MIC 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7" />Ani kinni Duuchchi Woddika Gootta adatannon;</para>
  <para style="q2" vid="MIC 7:7">anjirallo anke kadeeka Mageno heqqedhanno;</para>
  <para style="q2" vid="MIC 7:7">Mageni ank hiyyannoxxa laqaan;</para>
  <para style="q1" vid="MIC 7:7">Isira'eeli qophphi hitaan.<verse eid="MIC 7:7" /></para>
  <para style="s1">Fayyunte Mageniba'niten</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8" />Anke naapha ane'ni gelteexxe yaane'ni mee gammad!</para>
  <para style="q2" vid="MIC 7:8">ibonnolenna midde ke'anno;</para>
  <para style="q1" vid="MIC 7:8">Dukkanate'n ofo'lonolenna midde,</para>
  <para style="q2" vid="MIC 7:8">Duuchchi Woddik Gootti anke ifa kadaan.<verse eid="MIC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9" />Isoo balleessenaxxe,</para>
  <para style="q2" vid="MIC 7:9">ane'e ku'lineexxa ku'la uudee qico,</para>
  <para style="q1" vid="MIC 7:9">Ani'anna muraa qico,</para>
  <para style="q2" vid="MIC 7:9">Duuchchi Woddike Goottixxa aare adhdhanon;</para>
  <para style="q1" vid="MIC 7:9">Isinna ifiiba'a anee fulchaan;</para>
  <para style="q2" vid="MIC 7:9">aninna quullumma isixxa uudannon.<verse eid="MIC 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10" />Naaphi anikinna tennera uuda uuda;</para>
  <para style="q2" vid="MIC 7:10">salphinnekanna oddo'wa;</para>
  <para style="q1" vid="MIC 7:10">«Duuchchi Woddik Gootti atik Magenita haba heedhe?»</para>
  <para style="q2" vid="MIC 7:10">hiyyammaka</para>
  <para style="q1" vid="MIC 7:10">Anxi ille naaphinxa iba uudda;</para>
  <para style="q2" vid="MIC 7:10">tenne ta'a midde,</para>
  <para style="q2" vid="MIC 7:10">ori giddixxe dhoqqeshsha hirbeessemma.<verse eid="MIC 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11" />Ha'noka dalla'uwwa ijaartinaaxxi,</para>
  <para style="q2" vid="MIC 7:11">ha'noxxa gaballuwwaranna ba'lissitinaaxxi barra daggaan.<verse eid="MIC 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12" />Eettene barra,</para>
  <para style="q2" vid="MIC 7:12">Asoorinaa'ni Gibtseke qachchuwwi qico'ni,</para>
  <para style="q1" vid="MIC 7:12">Gibtsenaa'ni Efiraxis qico'ni,</para>
  <para style="q2" vid="MIC 7:12">abbaayyatenaa'ni abbaayyatiba'a</para>
  <para style="q2" vid="MIC 7:12">koobatenaa'n koobatiba'a ha'noba dangaan.<verse eid="MIC 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13" />Butta kinni huje insa'neexxenaa'ni kexxeexxa,</para>
  <para style="q2" vid="MIC 7:13">ise giddo hedheekixxe buutonni onake kaddaan.<verse eid="MIC 7:13" /></para>
  <para style="s1">Mageni Isira'eelike Ardi'a Mararee qico</para>
  <para style="p">
    <verse number="14" style="v" sid="MIC 7:14" />Qofitinni gongomi giddo,</para>
  <para style="q2" vid="MIC 7:14">quffeexxe bakka'n hedhaakiri,</para>
  <para style="q1" vid="MIC 7:14">Atike qadaadike gedhebo kadeeka,</para>
  <para style="q2" vid="MIC 7:14">atika arda atixxe siqqonni heqqi;</para>
  <para style="q1" vid="MIC 7:14">Ookkone olmike barishsha,</para>
  <para style="q2" vid="MIC 7:14">Baasanni giddi'anna Gele'adi giddi'a bobba'uun.<verse eid="MIC 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15" />«Gibtseenaa'ni fuldeteke barishsha,</para>
  <para style="q2" vid="MIC 7:15">mambe'a anka insa'ne'n leellishanno.»<verse eid="MIC 7:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16" />Gosa gosak arduwwi uudaan, salphataan;</para>
  <para style="q2" vid="MIC 7:16">hunna ifixxa duuchcha gophaan;</para>
  <para style="q1" vid="MIC 7:16">Anga afo'o ifike'n tuphedha;</para>
  <para style="q2" vid="MIC 7:16">mansha insa'nexxinna duudda.<verse eid="MIC 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17" />Godobik me'itammaxxe daduwwashshanna,</para>
  <para style="q2" vid="MIC 7:17">bofiinsha buko araaphinaan;</para>
  <para style="q1" vid="MIC 7:17">Ifi fixxe wolo'o giddii'n culphinsa'ni fulla;</para>
  <para style="q2" vid="MIC 7:17">soda'atinna Duuchchi Woddike Gootta ifike Magenba'a illee iima hinga;</para>
  <para style="q2" vid="MIC 7:17">ha'noonna sodaantaan.<verse eid="MIC 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18" />Ifike qadaadixxe hafexxa</para>
  <para style="q2" vid="MIC 7:18">cubbo gattowwaal hiyye, walaak,</para>
  <para style="q2" vid="MIC 7:18">atishsha hedheek Mageni aate?</para>
  <para style="q1" vid="MIC 7:18">Ati duuchchi woddi'a mufataboxxo;</para>
  <para style="q2" vid="MIC 7:18">yaane kinni mararte leellishate'ni gammaadatton.<verse eid="MIC 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19" />Wirri hitee no'o'a o'witatto;</para>
  <para style="q2" vid="MIC 7:19">cubbo no'oxxa duuchchanna lekka atixxenni haxxatton;</para>
  <para style="q2" vid="MIC 7:19">balleessa no'oxxa duuchchanna abbaayyatixxe dhi'mo'ni dhidhinsitatton.<verse eid="MIC 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20" />Edike baruwwanaa'ni</para>
  <para style="q2" vid="MIC 7:20">annuwwa no'oke kako aageteshshanni,</para>
  <para style="q1" vid="MIC 7:20">Ya'iqoobi'anna addatensha atixxa,</para>
  <para style="q2" vid="MIC 7:20">Abiraami'anna mararte atixxa leellishatton.<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>