<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">- Gedeo Bible</book>
  <para style="h">Sofooniyaasikaa Raaga</para>
  <para style="toc1">Sofooniyaasikaa Raaga</para>
  <para style="toc2">Sofooniyaasikaa Raaga</para>
  <para style="toc3">Sof.</para>
  <para style="mt1">Sofooniyaasikaa Raaga</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Wabeekichchi Soofooniyaasi raaga haaso'eek Kirsitoosixxe ilenishsha edo torbaane dhibba woggake langake gamisa'nite kaddaa wodda, akimaagaada itti yanna moyanj Iyyoosiyaasi Kirsitoosixxe ilensha edo jaane dhibbanna lamme tommenna mitte wogga kako aaggotixxa haaronsa assebaa edi darre kada dandetaan. Kunni maxaafi wele Waabeko haasottemmmaka raaga abide'eeken. Kunni raaguwwinna Yihudak ardi dhaarichcha magenuwwa magenoofatemmaxxe butto'a iso'n mura woxa gelta'nemmaxxa yanna ba'netinna enqensha iso'n gelta'nemmaxxa leellisha'neemmakemman. Iittanni ookkone wodda Mageni wele gosa gosaka arduwwa mura woxisa'nemmaxxa kulaan, Iyyeerusaalemike qachcha'n diigenshatixxi rakko gelteexxe kaddoolenna yannati udumma kunni qachchi ifike edike jeejibaa ille iima higaan. Qaajellumanna quulumma hordofaak ardi isi giddonna hedhaan.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Yihudaka arda'n geltaaxxa murte <char style="ior"><ref loc="ZEP 1:1-18">1:1-18</ref> </char></para>
  <para style="io1">Aadde Aagaa <char style="ior"><ref loc="ZEP 2:1-3">2:1-3</ref> </char></para>
  <para style="io1">Duuchchi Woddiki Goottinaa'n Isira'eelike olla'uwwa'n geltaaxxa murte <char style="ior"><ref loc="ZEP 2:4-15">2:4-15</ref> </char></para>
  <para style="io1">Yihudakanna wele gosa gosak arduwwi Duuchhci Wooddik Goottibaa higaaxxa <char style="ior"><ref loc="ZEP 3:1-20">3:1-20</ref> </char></para>
  <chapter number="1" style="c" sid="ZEP 1" />
  <para style="s1">Mageniinxe murtexxa Barra</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1" />Sofooniyaasi Kuushike belto kadaa wodda Kushshi kinni Gadaaliyake, Amaariyake, Amaariyake moyanjo Hiziqiyaasike belton; Amoonik belti Iyyosiyaasi Yihudiinka boga moye galchamma sane Duuchchi Woddiki Gootti Sofooniyaasi'n haaso'eeki raagi konneechchi butta hedheeken.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 22:1-23:30">2 Moy. 22:1—23:30</ref>; <ref loc="2CH 34:1-35:27">2 Odo. 34:1—35:27</ref>. </char></note><verse eid="ZEP 1:1" /></para>
  <para style="s1">Duuchchi Woddike Goottixxa Mufetixxa Barra</para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 1:2" />«Duuchchiinxa yaanenna,</para>
  <para style="q2" vid="ZEP 1:2">butta duuchchanaa'ni balleessannoni»</para>
  <para style="m" vid="ZEP 1:2">hiyya'neen Duuchchi Woddik Gootti.<verse eid="ZEP 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 1:3" />«Manjo hore, biniincha balleessannon</para>
  <para style="q2" vid="ZEP 1:3">iimate'n hexxeexxa ci'a,</para>
  <para style="q2" vid="ZEP 1:3">abbaayya giddixxa qulxu'me birannon;</para>
  <para style="q2" vid="ZEP 1:3">ani manjiinxa sanne buttatenaa'n kutti assano wodda,</para>
  <para style="q1" vid="ZEP 1:3">Fuggaaleeyye oletixxe tuulo kaddaan»</para>
  <para style="q4" vid="ZEP 1:3">hiyya'neen Duuchchi Woddik Gootti.<verse eid="ZEP 1:3" /></para>
  <para style="s1">Yihudake Ardixee Kulndeexxa Ba'ne</para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 1:4" />«Anga anxa Yihudiinke arda'ni,</para>
  <para style="q2" vid="ZEP 1:4">Iyyerusaalemi giddo hedheeke duuchcha'ni ke'isannon;</para>
  <para style="q1" vid="ZEP 1:4">Ba'aali hiyyema magenixxa hafenna</para>
  <para style="q2" vid="ZEP 1:4">fakkuwwa magenoofachchotixxe qeeseka summa konne boonchinaa'ni balleessannon.<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">Isa. 14:29-31</ref>; <ref loc="JER 47:1-7">Erm. 47:1-7</ref>; <ref loc="EZK 25:15-17">Hiz. 25:15-17</ref>; <ref loc="JOL 3:4-8">Iyu. 3:4-8</ref>; <ref loc="AMO 1:6-8">Amo. 1:6-8</ref>; <ref loc="ZEC 9:5-7">Zek. 9:5-7</ref>. </char></note><verse eid="ZEP 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 1:5" />Iimate'n hexxeexxa daduwwa magenoofatatee,</para>
  <para style="q2" vid="ZEP 1:5">fooqeti iima qabateexxi sagadakaara,</para>
  <para style="q1" vid="ZEP 1:5">Duuchchi Woddike Gootti'a saganda'ni isik summinn kakanta'ni</para>
  <para style="q2" vid="ZEP 1:5">Miilkomike summinni kakataakaara,<verse eid="ZEP 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 1:6" />Duuchchi Woddika Gootta hordoffatenaa'ni udumi'a higaakaara,</para>
  <para style="q2" vid="ZEP 1:6">Duuchchi Woddika Gootta halsabaakaara insa'nee gargaarona'a anee laqedhabaakaara balleessannon.<verse eid="ZEP 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 1:7" />Dada duuchchike Duuchchi Woddik Gootti edo ha'no sammi hiyye;</para>
  <para style="q2" vid="ZEP 1:7">Duuchchi Woddike Goottixxi barra shiqqe'een.</para>
  <para style="q1" vid="ZEP 1:7">Duuchchi Wodik Gootti tolcha qophphesse'een</para>
  <para style="q2" vid="ZEP 1:7">isi ye'eekaara woyyonse'een.<verse eid="ZEP 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 1:8" />Duuchchi Woddike Goottixxe tolchiinxe barra'ni</para>
  <para style="q2" vid="ZEP 1:8">Eeettene hayyoolenna moyanjiinka arda</para>
  <para style="q2" vid="ZEP 1:8">iittanni alagiinke galdumixxa seemma oddo'wakaara mura woxisannon.<verse eid="ZEP 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 1:9" />Eettenne barra'ni,</para>
  <para style="q2" vid="ZEP 1:9">ookkone qephphinni hana burraaqaaka duuchcha,</para>
  <para style="q1" vid="ZEP 1:9">insa'neeke magenuwwike mine'n,</para>
  <para style="q2" vid="ZEP 1:9">xaqarotanna soba itti wo'nshaaka duuchcha mura woxisannon.<verse eid="ZEP 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 1:10" />«Eettene barra» Duuchchi Woddik Gootti hiyya'nee qici:</para>
  <para style="q2" vid="ZEP 1:10">«Qulxu'metixxe hula darree'ni raare kexxaan</para>
  <para style="q2" vid="ZEP 1:10">langake ba'linana'ni hunbaashsha,</para>
  <para style="q2" vid="ZEP 1:10">tulluchchiwwake'ninna lumoxxi weekensha laqendaan.<verse eid="ZEP 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 1:11" />Ha'no Mekiteeshike qachchi giddo hexxina'neek woo hiyye;</para>
  <para style="q2" vid="ZEP 1:11">daddalto ha'nooxxi duuchchi kutti hitaan;</para>
  <para style="q1" vid="ZEP 1:11">Birretika sibiljo dadda'laak duuchcha reyaan.<verse eid="ZEP 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 1:12" />Eettene barra Iyyerusaalemi xassik findigee hasannoni;</para>
  <para style="q2" vid="ZEP 1:12">danqasha galaakaara,</para>
  <para style="q2" vid="ZEP 1:12">booro'e hunda gateeke woyinetike bulubulika atala kadeekaara,</para>
  <para style="q1" vid="ZEP 1:12">‹Elobaaxxenna kaddo eloxxa</para>
  <para style="q2" vid="ZEP 1:12">Duuchchi Woddiki Gootti mittechchonna assabaan› hiyya'ni ga'ma'mi hiyyaakaara mura woxisannon.<verse eid="ZEP 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 1:13" />Karra insa'neexx saamendaan;</para>
  <para style="q2" vid="ZEP 1:13">minuwwi insa'neekinna findigemaan;</para>
  <para style="q1" vid="ZEP 1:13">Eettene yanna minuwwa ijaadhinaani;</para>
  <para style="q2" vid="ZEP 1:13">yaane kinni insa'ne giddo he'nabaan;</para>
  <para style="q1" vid="ZEP 1:13">Woyinetika hiddichcho kalsinaan;</para>
  <para style="q2" vid="ZEP 1:13">isexxa booka kinni ha'winabaan.»<verse eid="ZEP 1:13" /></para>
  <para style="s1">Jabaxxi Duuchchi Woddike Goottixxi Barra Shiqqe'een</para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14" />«Jabaxxi Duuchchi Woddike Goottixxi barra bayya hexxeebaan;</para>
  <para style="q2" vid="ZEP 1:14">shiqo hexxeen; isenna rakke daggaan:</para>
  <para style="q1" vid="ZEP 1:14">Duuchchi Woddike Goottixxe barra'ni laqendaaxxi oodhishsha qaraartotten;</para>
  <para style="q2" vid="ZEP 1:14">ookko loliink manninna hiiqisee oodhaan.<verse eid="ZEP 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15" />Iitti barra aaretixxe barra,</para>
  <para style="q2" vid="ZEP 1:15">rakkotixxenna wixxi hiyyatixxi barra,</para>
  <para style="q1" vid="ZEP 1:15">Weekenshatixxenna ba'netixxe barra,</para>
  <para style="q2" vid="ZEP 1:15">dukkanatixxenna cuguggotixxe barra,</para>
  <para style="q2" vid="ZEP 1:15">duumanchiinxexnna dimmi dukkanaxxe barra kaddaan:<verse eid="ZEP 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 1:16" />Eettene barra kinotik dalla'inni ijaaremeeke qachchuwwinna</para>
  <para style="q1" vid="ZEP 1:16">Qeerrarama kinjiinke minuwwa'ni,</para>
  <para style="q2" vid="ZEP 1:16">malagatiink hafuurinna loliinxe raafemaxxi raare laqendaaxxe barra kaddaan.<verse eid="ZEP 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17" />Insa'ne balla'iinsha timminsaashsha,</para>
  <para style="q2" vid="ZEP 1:17">mannake'ni rakko iyyedagannon;</para>
  <para style="q2" vid="ZEP 1:17">insa'ne Duuchchi Woddike Gootta'ni cubbo hunjemmaxxee,</para>
  <para style="q1" vid="ZEP 1:17">Munde insa'neexxi lola'iinsha lolaataan;</para>
  <para style="q2" vid="ZEP 1:17">renshi insa'neek koriinsha afeemba hunemaan.<verse eid="ZEP 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18" />Duuchchi Woddike Goottixxe eettene mufexxa barra,</para>
  <para style="q2" vid="ZEP 1:18">manna worqetinna birreti sibili insa'neek</para>
  <para style="q1" vid="ZEP 1:18">Insa'ne anjira dande'abaan;</para>
  <para style="q2" vid="ZEP 1:18">butta duuchcha giiratishsha hexxeexxe isixxe hinaafenni ittendaan;</para>
  <para style="q1" vid="ZEP 1:18">Tinninna kaddaachchi buttate'ni hedheeki manni duuchchi,</para>
  <para style="q2" vid="ZEP 1:18">dedhange'n mudaake kademmaxxeeten.»<verse eid="ZEP 1:18" /></para>
  <chapter eid="ZEP 1" />
  <chapter number="2" style="c" sid="ZEP 2" />
  <para style="s1">Aadde Aagatee Mageniika Ye'injo</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 2:1" />Ha'noo shookinabaak koo gosa gosake arda</para>
  <para style="q2" vid="ZEP 2:1">mitteba bukki hiyye; gumme;<verse eid="ZEP 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 2:2" />Iitti murendeexxi yanna geltebaang,</para>
  <para style="q2" vid="ZEP 2:2">barra iitti huuriinsha ha'noo filtebaangi,</para>
  <para style="q1" vid="ZEP 2:2">Duuchchi Woddike Goottixxi jabaxxi mufe ha'no'ni daggebaang</para>
  <para style="q2" vid="ZEP 2:2">Duuchchi Woddike Goottixxi balatixxi barra</para>
  <para style="q1" vid="ZEP 2:2">Ha'no'ni dagge geltebaagi bukki hiyye.<verse eid="ZEP 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 2:3" />Ha'no buttatik qajeeluwwi duuchchi,</para>
  <para style="q2" vid="ZEP 2:3">ajaja isika muuxina'neekiir Duuchchi Woddika Gootta halse;</para>
  <para style="q1" vid="ZEP 2:3">Qullumatanna qajeelumma halse;</para>
  <para style="q2" vid="ZEP 2:3">jabaxxe Duuchchi Woddike Goottixxe mufetixxe barra'ni,</para>
  <para style="q2" vid="ZEP 2:3">gattinaaxxe hexxeen.<verse eid="ZEP 2:3" /></para>
  <para style="s1">Wele Arda'ni Uwwendeexxa Murte</para>
  <para style="p">
    <verse number="4" style="v" sid="ZEP 2:4" />Gaaza samendee urmite gattaan;</para>
  <para style="q2" vid="ZEP 2:4">Asiqeloonanna diigendaan;</para>
  <para style="q1" vid="ZEP 2:4">Ashidoodike qachchik ardi barra saafo'a shorremaan:</para>
  <para style="q2" vid="ZEP 2:4">Aqaroonike ookkone qachchik ardinna qachchakenaa'n goshemee fulaan.<verse eid="ZEP 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 2:5" />Ha'no abbaayyati qarqara hexxineek,</para>
  <para style="q2" vid="ZEP 2:5">koo Keelitootike arda ha'noo'a aane'e;</para>
  <para style="q1" vid="ZEP 2:5">Filisixeemike ardik boga tee Kenaani;</para>
  <para style="q2" vid="ZEP 2:5">ate'ni kulemeeki Duuchchi Woddike Goottik hiyyichchi hiyya'nee qici;</para>
  <para style="q1" vid="ZEP 2:5">«Haranga atee balleesannon;</para>
  <para style="q2" vid="ZEP 2:5">ati giddo hedha'neeke manninaa'ni mittikinna gataak hedhebaashsha asse atee balleesannon.»<verse eid="ZEP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 2:6" />Qerxesik manni hedheeba abbaayyatike</para>
  <para style="q2" vid="ZEP 2:6">qarqara'n hedheek bogi,</para>
  <para style="q2" vid="ZEP 2:6">allalsanotike galdumanna gedhebiinke galdumixxe bakka kaddaan.<verse eid="ZEP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 2:7" />Kunni bogi Yihudake ardixxe hafe'a uwwemaan;</para>
  <para style="q2" vid="ZEP 2:7">insa'nenna ookko hore ifika bobbaalsinaaba alfinaan;</para>
  <para style="q2" vid="ZEP 2:7">Asiqelonike mini giddonna,</para>
  <para style="q1" vid="ZEP 2:7">Hashsha diinphaan;</para>
  <para style="q2" vid="ZEP 2:7">Duuchchi Woddik Gootti insa'nek Mageni insa'nee heqqaan,</para>
  <para style="q2" vid="ZEP 2:7">booji'o insa'neexxanna insa'ne'a hiissaan.<verse eid="ZEP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 2:8" />«Ani Mo'aabike ardika yowwichcho Amoonitotixxa cee'manna laqeennen;</para>
  <para style="q1" vid="ZEP 2:8">Arda anka insa'ne cee'mine'een;</para>
  <para style="q2" vid="ZEP 2:8">boga insa'nenaa'ninna adhdhatee dhaadante'een.<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="ISA 15:1-16:14">Isa. 15:1—16:14</ref>; <ref loc="ISA 25:10-12">25:10-12</ref>; <ref loc="JER 48:11-49:6">Erm. 48:11—49:6</ref>; <ref loc="EZK 21:28-32">Hiz. 21:28-32</ref>; <ref loc="EZK 25:1-11">25:1-11</ref>; <ref loc="AMO 1:13-15">Amo. 1:13-15</ref>. </char></note><verse eid="ZEP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 2:9" />Tennexxee hedhaaneke kada anxe'ni kakataannen,»</para>
  <para style="q2" vid="ZEP 2:9">hiyya'neen dada duuchcha ajajaak Duuchchi Woddik Gootti Isira'eelik Mageni.</para>
  <para style="q1" vid="ZEP 2:9">«Mo'aabii'i Soodoomishsha,</para>
  <para style="q1" vid="ZEP 2:9">Amoonika ardinna Gomorashsha,</para>
  <para style="q2" vid="ZEP 2:9">bada'a liqinsiteexxe bakkashshanna</para>
  <para style="q1" vid="ZEP 2:9">maxinetixxe baleshsha duuchchi woddi'a urmake kandee gantaan;</para>
  <para style="q2" vid="ZEP 2:9">anke ardanaa'n gateekiir insa'nee saamaan</para>
  <para style="q1" vid="ZEP 2:9">Anxe gosake manninaa'n gateekiir boga insa'neka,</para>
  <para style="q2" vid="ZEP 2:9">dhaalaan.» <note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="GEN 19:24">Dada. 19:24</ref>. </char></note><verse eid="ZEP 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 2:10" />Insa'nexxe ifisadanaa'n kexxeexxa insa'ne'n geltaaxxi,</para>
  <para style="q2" vid="ZEP 2:10">dada duuchcha ajajaake Duuchchi Woddike Goottika arda,</para>
  <para style="q2" vid="ZEP 2:10">yowwinee insa'ne'n gacifanteemmaxxeten.<verse eid="ZEP 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ZEP 2:11" />Duuchchi Woddik Gootti ookkone bogika magenuwwa,</para>
  <para style="q2" vid="ZEP 2:11">duuchcha biraaxxa yanna, isi konnechchuwwa'n sodaatemaake kadaan;</para>
  <para style="q1" vid="ZEP 2:11">Abbaayyati qarqara'ninna oddoolluwwake'n hedhaak gosa gosak ardi,</para>
  <para style="q2" vid="ZEP 2:11">mitti mitting hedhe hedheenba isi'a sagadaan.<verse eid="ZEP 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 2:12" />Ha'no Tophiyiinke ardaa</para>
  <para style="q2" vid="ZEP 2:12">ha'nonna anke wolaanitichchinni shiyendinaan.<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="ISA 18:1-7">Isa. 18:1-7</ref>. </char></note><verse eid="ZEP 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEP 2:13" />Middi bogibaa anga ifixxa diriirisse'e</para>
  <para style="q2" vid="ZEP 2:13">Asoorinna balleessaan;</para>
  <para style="q1" vid="ZEP 2:13">Nenewee onake assaan;</para>
  <para style="q2" vid="ZEP 2:13">qiilla gammoojjeshshanna bagoxxe assaan.<verse eid="ZEP 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 2:14" />Gedhebikinna lali,</para>
  <para style="q2" vid="ZEP 2:14">gargar gargar hexxeexxi dada duuchchi ise giddo ciisa;</para>
  <para style="q1" vid="ZEP 2:14">Urungotinna dhaddo,</para>
  <para style="q2" vid="ZEP 2:14">iseke utuphuwwi hana galda'n</para>
  <para style="q1" vid="ZEP 2:14">raaretanna maskoote maskotenaa'n laqisa;</para>
  <para style="q2" vid="ZEP 2:14">oletinna hula hula'ninni tuulenda;</para>
  <para style="q2" vid="ZEP 2:14">birbirsiinke haqichchik dagalsanjuwwinna banqara.<verse eid="ZEP 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 2:15" />Danqansha galeek,</para>
  <para style="q2" vid="ZEP 2:15">iikki gammashoti qachchi konete;</para>
  <para style="q1" vid="ZEP 2:15">Isinna qalbe ifixxi giddo,</para>
  <para style="q2" vid="ZEP 2:15">«Ane callanni; ani gadhi darre ayyinna hedheba'a» hiyyemmak,</para>
  <para style="q1" vid="ZEP 2:15">Hittata biniinchi itti ciisaaxxe,</para>
  <para style="q2" vid="ZEP 2:15">ona bakka kade gate?</para>
  <para style="q1" vid="ZEP 2:15">Isike qarqarinaa'n sa'aak duuchchi,</para>
  <para style="q2" vid="ZEP 2:15">iso'n gacifata'n qubichcho ifika iso'n wirsaan.<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="ISA 10:5-34">Isa. 10:5-34</ref>; <ref loc="ISA 14:24-27">14:24-27</ref>; <ref loc="NAM 1:1-3:19">Nah. 1:1—3:19</ref>. </char></note><verse eid="ZEP 2:15" /></para>
  <chapter eid="ZEP 2" />
  <chapter number="3" style="c" sid="ZEP 3" />
  <para style="s1">Iyyerusaalemixxa Balleessanna Heger Alfitaaxxa Woddensha</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 3:1" />Xaqartichchakeenna battoo'eeke</para>
  <para style="q2" vid="ZEP 3:1">Iyyerusaalemike qachchi'a aanne!<verse eid="ZEP 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 3:2" />Isi ayyi'anna ajajemebaan;</para>
  <para style="q2" vid="ZEP 3:2">ayyika gorsanna adhdhebaan;</para>
  <para style="q1" vid="ZEP 3:2">Isi Duuchchi Woddika Goottanna addatebaan;</para>
  <para style="q2" vid="ZEP 3:2">ifike Magenibaanna shiqabaan.<verse eid="ZEP 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 3:3" />Ja'laabuwwi isik ittanaake neenqa,</para>
  <para style="q2" vid="ZEP 3:3">galchalluwwi isikinna soodixxa heddabaaxxe</para>
  <para style="q2" vid="ZEP 3:3">hashshixxe yayyeshaten.<verse eid="ZEP 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 3:4" />Wabeeko isixxi hollaammeyyetenna</para>
  <para style="q2" vid="ZEP 3:4">sobi callixxen;</para>
  <para style="q1" vid="ZEP 3:4">Qeese isixinna Woyyichcha Galama battossitaan;</para>
  <para style="q2" vid="ZEP 3:4">ookkone seera'ninna jallitaan.<verse eid="ZEP 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 3:5" />Isi giddo hedheeki</para>
  <para style="q2" vid="ZEP 3:5">Duuchchi Woddiki Gootti qullichchaken,</para>
  <para style="q1" vid="ZEP 3:5">Isi haranga dedha hujaba'a;</para>
  <para style="q2" vid="ZEP 3:5">gorsa gorsa'ninni toggitte murte muraan:</para>
  <para style="q1" vid="ZEP 3:5">Bara bara'ninni tennee assebaak gatabaan;</para>
  <para style="q2" vid="ZEP 3:5">fuggaaleyye kinni shooko egendeba'a.<verse eid="ZEP 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 3:6" />«Ani gosa gosaka arda fuguseennen</para>
  <para style="q2" vid="ZEP 3:6">kolluwwa insa'nexxinna olete kade'een;</para>
  <para style="q2" vid="ZEP 3:6">ayyinna ookko'ni sa'abaashsha</para>
  <para style="q2" vid="ZEP 3:6">ora insa'neka urmake asseennen</para>
  <para style="q1" vid="ZEP 3:6">Qachchuwwa inisa'neka diigennen:</para>
  <para style="q2" vid="ZEP 3:6">mitti manjinna ookko hedhabaan; ookko hedhaakinna haranga afemabaan.<verse eid="ZEP 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 3:7" />Aninna ookkone qachcha,</para>
  <para style="q2" vid="ZEP 3:7">dhugaaten anee sodaataton;</para>
  <para style="q2" vid="ZEP 3:7">‹Barachchotanna adhdhiitaton› hiyyennen;</para>
  <para style="q1" vid="ZEP 3:7">Tennexxee galdumi isiki ba'abaan</para>
  <para style="q2" vid="ZEP 3:7">xixichchi anki duuchchinna isoo geyabaan.</para>
  <para style="q1" vid="ZEP 3:7">Ardi anki kinni assaaxxe yaane duuchcha'ni,</para>
  <para style="q2" vid="ZEP 3:7">fuggoxxa muuxati miidheme.»<verse eid="ZEP 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 3:8" />Duuchchi Woddiki Gootti hiyya'nee qici,</para>
  <para style="q2" vid="ZEP 3:8">«Ani inisa'ne'ni murannoxxi barra geltaa qico'ni;</para>
  <para style="q2" vid="ZEP 3:8">anee heqqe;</para>
  <para style="q1" vid="ZEP 3:8">Gosa gosak anka arda mitteba hiissonaa;</para>
  <para style="q2" vid="ZEP 3:8">moyanjuwwakanna bukki assonaa,</para>
  <para style="q1" vid="ZEP 3:8">Balatanna jabaxxa mufe anxa,</para>
  <para style="q2" vid="ZEP 3:8">insa'ne'ni hana dunonnaa mudhdheennen;</para>
  <para style="q1" vid="ZEP 3:8">Butta duuchcha anxe hinaaffexxe mufexxe giiranni;</para>
  <para style="q2" vid="ZEP 3:8">gubattee baxxaan.<verse eid="ZEP 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 3:9" />«Eettene yanna ardi duuchchi Duuchchi Woddike Goottika summa ye'aashsha,</para>
  <para style="q2" vid="ZEP 3:9">mittomik isoo ergatemaashsha;</para>
  <para style="q2" vid="ZEP 3:9">haaso'a insa'neka jijjiirannoni.<verse eid="ZEP 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 3:10" />Tophiyiinke galaanuwwi wido,</para>
  <para style="q2" vid="ZEP 3:10">ane magenoofataak xexxeeremeeki anki ardi</para>
  <para style="q2" vid="ZEP 3:10">uwwatika tolcha ani'a aadhe dagaan.<verse eid="ZEP 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 3:11" />Ane'ni hujjineexxe balleessa duuchchanaa'ni kexxexxa,</para>
  <para style="q2" vid="ZEP 3:11">eettene barra ha'no shookinabaan;</para>
  <para style="q1" vid="ZEP 3:11">Holla insa'nexxe'ni gammada'nekaara;</para>
  <para style="q2" vid="ZEP 3:11">ookkone qachchana'ni fugusaannaxxee</para>
  <para style="q1" vid="ZEP 3:11">Konneechchinni edi'a,</para>
  <para style="q2" vid="ZEP 3:11">woyyitte kooba anxe'ni hollitinaba'a.<verse eid="ZEP 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 3:12" />Ha'no Duuchchi Woddike Goottike summa'ni amandina'neek</para>
  <para style="q2" vid="ZEP 3:12">ifi heeshshi assaaka qajeelanna arja manna</para>
  <para style="q2" vid="ZEP 3:12">ha'nooxxe oddo'ni gatisanno.<verse eid="ZEP 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 3:13" />Booji'emebaak gateeke Isira'eelike ardixxi hafe,</para>
  <para style="q2" vid="ZEP 3:13">dharakanna haasotabaan;</para>
  <para style="q2" vid="ZEP 3:13">afo'o insa'neke'ninna xaqaro afendabaan.</para>
  <para style="q1" vid="ZEP 3:13">Insaa'ne indaani, nage'iki diinphaan;</para>
  <para style="q2" vid="ZEP 3:13">insa'nee sodaachisaachchi hedhebaan.»<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="REV 14:5">Wal. 14:5</ref>. </char></note><verse eid="ZEP 3:13" /></para>
  <para style="s1">Gammashshotixxa Faaro</para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14" />Koo Tsiyoonike arda gammadiki faarsi;</para>
  <para style="q2" vid="ZEP 3:14">Tee Isira'eel ilillisi;</para>
  <para style="q1" vid="ZEP 3:14">Koo Iyyerusaalemike ardaa;</para>
  <para style="q2" vid="ZEP 3:14">mitte godobinni gammadde; ilillinna hiyye.<verse eid="ZEP 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15" />Duuchchi Woddiki Gootti mura woxa atixxa fugusse'een;</para>
  <para style="q2" vid="ZEP 3:15">naapha atika atenaa'ni hiise'een.</para>
  <para style="q1" vid="ZEP 3:15">Isira'eelk moyanji Duuchchi Wodik Gootti atinni welti hedheen;</para>
  <para style="q2" vid="ZEP 3:15">konneechchinni edi'a mittetanna fuggoxxa yaane sodatabexxo.<verse eid="ZEP 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16" />Eetene barra Iyyerusaalemii'i</para>
  <para style="q2" vid="ZEP 3:16">hinaa qici;</para>
  <para style="q1" vid="ZEP 3:16">«Koo Tsiyoonike arda sodaatinoqqe;</para>
  <para style="q2" vid="ZEP 3:16">anguwwa ha'nooxxinna gophphoqqee.<verse eid="ZEP 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17" />Duuchchi Woddiki Gootti atiki Mageni oddo atixxe'ni hedheen;</para>
  <para style="q2" vid="ZEP 3:17">isi jabake anjirallon.</para>
  <para style="q1" vid="ZEP 3:17">Isi ate'ni yo'oshsha gammadaan;</para>
  <para style="q2" vid="ZEP 3:17">jaalala ifixxenn atee foorfachchiisaan;</para>
  <para style="q2" vid="ZEP 3:17">faarotinna ate'ni ulfaate'e gammadaan.»<verse eid="ZEP 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 3:18" />«Ulfaateeke atike ayyaani'a mekki hite doonsa kiyya hiteettexxa</para>
  <para style="q2" vid="ZEP 3:18">yowwichchiinxa ba'o;</para>
  <para style="q2" vid="ZEP 3:18">atenaa'ni fugussannon.<verse eid="ZEP 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19" />Eettene barra,</para>
  <para style="q2" vid="ZEP 3:19">atee wixixxi asseemakaara duuchcha mura woxissannon;</para>
  <para style="q1" vid="ZEP 3:19">Naafekaara anjirannon;</para>
  <para style="q2" vid="ZEP 3:19">xeeremeemmakaaranna bukki assannon;</para>
  <para style="q1" vid="ZEP 3:19">Salphantemmake boga duuchcha'n,</para>
  <para style="q2" vid="ZEP 3:19">saalphinne insa'neka ulfinikenna saadinotike assannon.<verse eid="ZEP 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20" />Eetene yaanna ha'noo bukki assannon;</para>
  <para style="q2" vid="ZEP 3:20">ookkone wodda ha'noke bogibaa ha'noo hiisannon;</para>
  <para style="q1" vid="ZEP 3:20">Ille ha'nooxxi uuda'naann</para>
  <para style="q2" vid="ZEP 3:20">booji'o ha'nooxxa ani hiissanno wodda</para>
  <para style="q1" vid="ZEP 3:20">Saadematanna ulfaata</para>
  <para style="q2" vid="ZEP 3:20">butta duuchchike gosa gosake ardixxe oddo'ni ha'no'a uwwannon»</para>
  <para style="q2" vid="ZEP 3:20">hiyya'nen Duuchchi Woddik Gootti.<verse eid="ZEP 3:20" /></para>
  <chapter eid="ZEP 3" />
</usx>