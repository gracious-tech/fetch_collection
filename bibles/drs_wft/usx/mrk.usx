<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Gedeo Bible</book>
  <para style="h">Marqoosixxaa Wengeele</para>
  <para style="toc1">Marqoosi Borreesseexxa Gootta No'oke Yessuusi Kirstoosixxaa Wongeele</para>
  <para style="toc2">Marqoosixxaa Wengeele</para>
  <para style="toc3">Mar.</para>
  <para style="mt1">Marqoosi Borreesseexxa</para>
  <para style="mt2">Gootta No'oke Yessuusi Kirstoosixxa Wongeele</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Marqoosixxa wengeele «Kunni Mageniinke belto Yessuusi Kiristoosixxe eloxxe odoke ke'iton» hita'nee saffaan; tenne wengeele giddo Yessuusi hujetikenna baallomiinke manjo kadee shiqeen; isik baallominna ifixxe barsiisan, fuggoke hafuura'n afeexxe hunnanninna majiinxa cubbo gattowaal hiyyati leelliteen. Yessuusi «Manjo cobbotixxe garbummanaa'n leexa fulchati hedho ifixxa saisse uwwatee dageenneke Manjiinke Belton» hiyyati isi umo ifingenninni haaso'edheen; Marqoosi Yessuusixxa jirte shiqisheek toggichchikinna hunna wo'miteeke orniite kadda wodda isi duudhe haaso'exxi Yessuusike hiyyichcho'ninna barrisa'nite kaddebaak isi asseexxe manba'a hujuwwa'niten xammaqallo Yohaanisixxe jirte, Yessuusixxe xammaqaxxeenna isixxe hega uudemiyyoxxe harumaaka e'yichcho uwweechchi uduma borresanji Yessuusixxe barssiisaxxeenna isixxe fayyisatixxe ergatenshaaxxe ifisaan. Yannati uduma Yessuusixxi hordoffeeyye Yessuusi'i caala egenda'ni me'iteexe qixxe'ni Yessuusi'i gareeraammakir caala isoo ginba'n me'e; udu'mitaaxxi hafuura adhdhuwwa'ni Yessuusixxe hedhoke muuxamiinxe torba giddo assendeemmaxxe yaanuwwa giddii'n isixxe fannsenshaxxanna isixxe ke'axxa haaso'aakeran. Hafuura adhdha tommenna jaane laakkoossa saddeetike langake gamisinna laakkoosa sallanekenaa'ni leme tommi qico'ni hexxeexxi kutuwwa edixxe mirqisanjo maxaafi giddo calla afendaaxxeran.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Tenne wengeelka ke'ito <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref> </char></para>
  <para style="io1">Yessuusi ergatensha Galiila safeexxa <char style="ior"><ref loc="MRK 1:14-9:50">1:14—9:50</ref> </char></para>
  <para style="io1">Iyyerussaalemi ergatemeexxa <char style="ior"><ref loc="MRK 10:1-52">10:1-52</ref> </char></para>
  <para style="io1">Iyyerussaalemi'ninna qaraqarake'n muuxamiinxe torbaxxa ergatensha <char style="ior"><ref loc="MRK 11:1-15:47">11:1—15:47</ref> </char></para>
  <para style="io1">Gootiinxa Reyotenaa'n ke'a <char style="ior"><ref loc="MRK 16:1-8">16:1-8</ref> </char></para>
  <para style="io1">Reyotenaa'n ke'eeke Goottixxa leellanna isixxa iimi'a me'a <char style="ior"><ref loc="MRK 16:9-20">16:9-20</ref> </char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s1">Xammaqanjo Yohansixxa Lallaba</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat. 3:1-12</ref>; <ref loc="LUK 3:1-18">Luq. 3:1-18</ref>; <ref loc="JHN 1:19-28">Yoh. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Mageniinke Beltixxe Yessuusi Kiristoosixxe eloxxe odoxxa safa.<verse eid="MRK 1:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="MRK 1:2" />Wabeekichcha Issayaasike maxaafa'n, hiyyende borreesende qic:</para>
  <para style="q1" vid="MRK 1:2">«Kunse ora atika giissaaka erganjo anka</para>
  <para style="q2" vid="MRK 1:2">ati edo ergannoni.»<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />«Duuchchi Woddike Goottika ora qophpheesse!</para>
  <para style="q1" vid="MRK 1:3">‹Hodhdhichakanna toggi asse,</para>
  <para style="q2" vid="MRK 1:3">hiyya'ni qiilla gammoojje giddo raara'neeke manjichchixxa qonqo.› »<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />Tennexxee xammaqanji Yohaannisi «Cubbote'e gattowwali'i alfitinaashsha aadde aagine xammaqemme» hiyaya'ni qiilla gammoje'ni lassa'ni dage.<verse eid="MRK 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 1:5" />Yihudake bogik manni duuchchinna Iyyerusaalemike qachchik manni duuchchi isibaa dagaamma: insa'nenna cubbo ifi ifixxa faaci'wina'n isixxe anga'ni Yordanoosike galaaniba xammaqemaammani. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />Yohaannisi gaaliinxe ordanni hujendeexxa seemma oddo'wa'ni hidhake'ninna gogiinke sabbata usudhdha'ni awwaaneessakenna daamoti malebo itaamman. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Yohaannisinna hiyyaamma qici, «Ani heeshshi hiyye Isixxe kopheka usurra tika dande'abe'noki anee sa'aaki ani uduma dagaani. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Ani ha'noo wede'ik xammaqaannen; isi kinni Woyyichchi Haafurinni ha'noo xammaqaan» hiyya'nemman.<verse eid="MRK 1:8" /></para>
  <para style="s1">Yessusixxa Xmmaqenshanna Hega Uudema</para>
  <para style="r">(<ref loc="MAT 3:13-17">Mat. 3:13-17</ref>; <ref loc="MAT 4:1-11">4:1-11</ref>; <ref loc="LUK 3:21-22">Luq. 3:21-22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Ookkone wodda Yessuusi Geliilake bogibaa Naazireetike qachchibaa dageexxi Yordanoosike galaana'n Yohaannisixxe anga'ni xammaqemme. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Yessuusinna galaanakena'ni fule wodda iimuwwa banendee'na Woyyichchi Hafuuri guugenjotishsha Iso'ni ofo'la'naa uude. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />«Eeyaanneki anki belti ateteni; ate'ni gammadaanneni» hiyyaaki hafuuri iimii'ni laqeme. <verse eid="MRK 1:11" /><verse number="12" style="v" sid="MRK 1:12" />Hirbange'ni Woyyichchi Hafuuri qiilla gammoojjebaa Yessuusi'i aadhe me'e. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Isinna durrisake'ni hega uudema'ni shoole tomme barra qiilla gammoojje'ni ture; binniichuwwikinna isinni welti hedhemma; ergannatinna isi'a ergatende.<verse eid="MRK 1:13" /></para>
  <para style="s1">Siretixxe Hordofeeyyexxa Ye'ensha</para>
  <para style="r">(<ref loc="MAT 4:14-17">Mat. 4:14-17</ref>; <ref loc="LUK 4:14-15">Luq. 4:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Yohaannisi usurrii mine'n e'yeechchi uduma, Yessuusi Mageniinxa eloxxa odo lassa'ni Geliila'a mare. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />Bari muuxemeen, «Mageniinxi mootumma shiqqe'eni; aadde aagge; eloxxe odo'ninna amanne!» hiyya'ni lassaamman.<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Yessuusi Galiilixxe Abbaayya birii'ni sa'a'ni; Simi'ooninna dayyi isiki Indiryaasi qulxu'me abindamalcho Abaayya giddi'a darbinaa'na insa'ne'e afe. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Yessuusinna insa'nee, «Amme Anee hordoffe; manna aniba bukki assitinaashsha assannoni» hiyye. <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Insa'nenna hirbaange'ni qulxu'me abindammalcho waalleexxi isoo hordonfe. <verse eid="MRK 1:18" /><verse number="19" style="v" sid="MRK 1:19" />Isinna shiixo qico sa'e me'echi uduma, Zabidewoosixxi oose Ya'iqoobinna dayyi isiki Yohaannisi hobolote'ni he'ne marabe ifixxa giise'naa'na afeexxi; <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />ikki woddi insa'nee ye'e. Insa'nenna anna ifika Zebidewoosii'i isinni hujaammaake manninni welti hoboloti giddo waalleexxi Yessuussi'i hordoonfe.<verse eid="MRK 1:20" /></para>
  <para style="s1">Yessuusssi Fuggichcha Hafuura Fulcheexxa</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luq. 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Insa'nenna Qifirnahoomi'a me'ine; Yessuussinna iikki woddi edike sanbatixxe barra'ni Muuseka seera barantaammake mine'ni e'yeexxi barisiisa safe. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Muuseke seerixxe borreessisano barsiissaammashate kaddebaangi; baaloommeke manjishsha arda barsiiseemmaxxe'e ardi isixxe barisiisa'ni mambe'a hiyye.<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />Ookkonne wodda Muuseka seera barantaammake mini giddo hedheemmaki fuggichchi hafuuri giddo hedhemmaki mitti manjichchi, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />«Naazireetike Yessuusi ati no'onni welti maa affette? No'oo balleessitottaa daggette? Ani ati ayyete kaddeettexxa ege'neennen; ati Mageniinke Woyyichchan!» hiyya'ni raare. <verse eid="MRK 1:24" /><verse number="25" style="v" sid="MRK 1:25" />Yessuusinna fuggichcha hafuura, «Sammi hiyyi! Konne manjichchonaa'ni fuli!» hiyye xixe.<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />Fuggichchi hafuurinna manjichcho gangancheechi uduma hafuura gikki assee'e raara'ni isonaa'ni fule. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />Manni duuchchi mambe'a hiyyeexxi; «Tinni yaane maachcho? Baalleti fuggichcha hafuura ajajaan; insa'nenna isi'a ajajemaan; tinni haaroxi baranno maachcho?» hina'ni weli'an weli qorra'ni mambe'a hine. <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />Iikki woddi gurri Isiki Geliilake qarqara'ni hedheeke booncho duuchcha'ni geye.<verse eid="MRK 1:28" /></para>
  <para style="s1">Yessuussi Elagopheeka Heddo Manna Fayyise</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mat. 8:14-17</ref>; <ref loc="LUK 4:38-41">Luq. 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Insa'nenna iikki woddi Muuseke seerike barachchotike minenaa'ni fulleeshanni Ya'iqoobinninna Yohaannisinni welti Simi'oonikenna Indiryaasike mine'ni e'yine. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Simi'oonixxi ballo eebishe giissa gophee'na diiphpheemmani; insa'nenna ela gonphe isexxanna Iso'ni kulle. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Tennexxee Yessuusi ise diipheemmaba marreexxi anga isexxa abideexxi ke'isse; eebbinjikinna iikki woddi ise waalee'naa iima kexxeexxi insa'nee keessunsite. <verse eid="MRK 1:31" /><verse number="32" style="v" sid="MRK 1:32" />Arishsho e'yiteechchi uduma hashshee wodda; loolake'ni hedheemmak manni elagopheekanna fuggichchi hafuuruwwi abideeka manna duuchcha Yessuusibaa aa'ne dange. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Ookkone qachchiki ardi duuchchi ookkone minixxe hula'ni bukki hiyyeemman. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Yessuusinna gargar gargar hedheeke dhukkubinni elagopheemmaka heddo manna fayyise; heddo fuggichcha hafuuranna fulche; yaane kinni fuggichchi hafuuruwwi Yessuusixxa ayyumma ege'neemaxxee insa'ne haasoonnabaashsha hoyye.<verse eid="MRK 1:34" /></para>
  <para style="s1">Yessuusi Galiila'ni Wengeele Barsiiseexxa</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luq. 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Soodimaro boro haachchabbebaang Yessuusi minii'ni fuleexxi qiilla gammoojje'ni mare soodate. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Simi'ooniinna welti hedheemmaka isik jaaluwwi isoo hasito ke'ne: <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />insa'nenna isoo anfee wodda, «Manji duuchchi atee hasa'neni!» hine. <verse eid="MRK 1:37" /><verse number="38" style="v" sid="MRK 1:38" />Yessuusinna hiisseexxi, «Ani dageennelchi barsiisonnate kaddemmaxxee shiqa hedheeke olla'uwwibaa me'ino!» insa'nee hiyye. <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />Tennexxee Isi Muuseka seera barsiinsammake mine'ni e'ya'ni lassati fuggichcha hafuuruwwa fulcha'ni Geliilake boga duuchcha'ni marema'nemmani.<verse eid="MRK 1:39" /></para>
  <para style="s1">Yessuusi Soomo'eeka Manjichcho Soomakenaa'ni Ca'asse</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mat. 8:1-4</ref>; <ref loc="LUK 5:12-17">Luq. 5:12-17</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Mitti soomiinke dhukkubinni abidemeemmak manjichchi Yessuusiba dage Isi edo gulufateexxi; «Eettattole ane'e ca'assi» hiyyeexxi Isoo kadhate.<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Yessuusinna manjichokee marareexxi anga ifixxa farri asse qaqqabeexxi, «Eeti'i uwweeneni ca'ayyi» hiyye. <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Manjichchikinna soomiinke dhukkubana'ni ikki woddi ca'ayyeexxi dhukkubakenaa'ninna fayye.<verse eid="MRK 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 1:43" />Yessuusinna manjichcho jabeessee xexxe'achiisati hiyye geegessee qici; <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />«Tenne yaane ayye'ninna midde kuldaboxoshsha ifi heqqedhi!; Yaane kinni fayyunte atixxi insa'ne'a dhugaate kaddaashsha martettexxi manjunte atixxa qeesichchoke'ni leellishi!; Ca'a hiyya atixxeenna Muuse ajajeemmaka tolcha shiqishi!» hiyya'ni isoo ajaje. <verse eid="MRK 1:44" /><verse number="45" style="v" sid="MRK 1:45" />Manjichchi kinni mareeba duuchcha tennee yaane manna duuchcha'ni haaso'e; odotanna loola duuchcha'ni geesise. Tenne buutonni Yessuusi hoone qachcha'ninna manji uuda'naa e'ya dande'ebaani. Tennena'ni kexxeexxa Yessuusi qachchakenaa'ni bayyate qoone booncho'ni hedha'nemmani; manni kinn booncho boonchongenaa'ni Isi hedheebaa daga'nemmani.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s1">Yessuusi Gogeeka Manjichcho Fayyise</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mat. 9:1-8</ref>; <ref loc="LUK 5:17-26">Luq. 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Heenoxxe barra uduma Yessuusi Qifirnahoomik qachchibaa hige dage mini'a e'yeexxa ardi laqe. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Tennexxee minxi soro duuchcha midde gattebang boonchi gophemaa qico'ni heddi ardi bukki hiyye: Isinna Mageniinka hiyyichcho insa'ne'a lasse. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Ookkonechi uduma heenoki manni mitte gogeeka manjichcho shoole manjo'ni dukinsee Isibaa aa'ne idange <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Insa'nenna aradiinxe bira sa'nenaa'ni kexxeexxa konnee majichcho Yessuusi hedheebaa idagatee dande'a gonpheexxi; miniinxe guutonaa'ni isi hedhemma darree'ni heellicho iimi'ni qo'a fulchineexxi gogeedhemaki manjichchi diipheemmaxxa rare ookkoo'ni butti'a dirrinse. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Yessuusinna insa'neexxa adde uudeexxi konnee gogeemmaka manjichcho, «Koo belto cubbo atixxi gattowaali hiyyendeeni» hiyye. <verse eid="MRK 2:5" /><verse number="6" style="v" sid="MRK 2:6" />Ookko ofo'le hedheemmak mitti mitti Muuseke seerxxi borreessano tenne yaanexxee godob insa'neeki giddo, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />«Kunn manjichchi mayee iitta heyye? Isiqqa Magenoke'ni yowwichiinka haaso'a mayee fulchedha'ne? Mageno mitte malee'e ayyete cubbo gattowwali hiyya dande'aki?» hine hende.<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Yessuusinna hirbange'ni insa'nee godobik henda'neexxa irriki ege'neexxi; «Mayee'e iita heddina'ne? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Gogeeka manjichcho ‹Cubbo atixxi gattowwaali hiyyende'eeni› hiyyatena'ninna ‹Kexxettexxi rare atixxa dulkitetexxi me'i!› hiyyatena'ni heente shollexxa? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Yaane kinni Manjiinki Belti buttate'ni cubbo gattowaali hiyyate'e baallooma afeexxa egendinaashsha» hiyyati gogeemmaka manjichcho; <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />«Kexxe rare atixxa dulkitettexxi mine atikiba'a me'i!» hiyye. <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />Manjichchi kinna ke'eexxi duuchchiingi uudda'na rare ifixxa dulkeexxi me'e; ookkone booncho'ni hedhemmak duuchchi tenne kaddeexxe yaane'ni mambe'a hiyyeexxi; «Iitta hexxeexxa yaane hara uunde egennebo'noni» hina'ni Mageno galateeffante.<verse eid="MRK 2:12" /></para>
  <para style="s1">Yessuusi Leewi'i Ye'e</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mat. 9:9-13</ref>; <ref loc="LUK 5:27-31">Luq. 5:27-31</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Higgeenn Yessuusi Galiilixxe abbaayyati qarqari'a me'e; heddi ardi Isiba'a dagee'na barsiise. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Ookko'ni sa'a'ni Ilfiyoosik belti Leewwi qarxa bukki assinammake booncho'ni ofo'le'naa uudeexxi, «Anee hordofi» hiyye. Isinna ke'eexxi Isoo hordofe. <verse eid="MRK 2:14" /><verse number="15" style="v" sid="MRK 2:15" />Yessuusinna Leewike mine'ni ita ito'a ofo'lee'na, heddi qaraxa bukki assaammaki manninna cubbaaleeyye isoo hordofa'n Yessuusinninna hordofeeyye ifixxinni welti ofolle indaamman.<verse eid="MRK 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 2:16" />Feerisitotixxe gamo kaddeexxi Muuseke seerixxi borrissisano cubbaaleeyyetinna qaraxa bukki assammake manninni welti Yessuusi itaa'naa uundeexxi hordofeeyye isixxa, «Qaraxa bukki assammake manninninna cubbaaleeyyeti welti mayee Isi ita'ne?» hine qorre. <verse eid="MRK 2:16" /><verse number="17" style="v" sid="MRK 2:17" />Yessuusinna insa'nee haasonna'nexxa laqeexxi, «Elagopheeke manni'a malee'e fayya hedheekee ci'leessi hasisabaani. Ani cubbaaleeyyete malee qulliyye aadde aago'a ye'onna dageebo'non» hiyye.<verse eid="MRK 2:17" /></para>
  <para style="s1">Agabo Goddoxxee Shiqeeka Qortuma</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mat. 9:14-17</ref>; <ref loc="LUK 5:33-39">Luq. 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Yohaannisixxi hordofeeyyenna Feerisito agabo goddo honsa'nemmani. Mitti mitti manni dageexi Yessuusi'i, «Yohaannisixxinna Fariisitotixxi hordofeeyye agabo goddo hossaa'naa'a atixxi hordofeeyye agabo goddo hossabaachchi mayeete?» hine. <verse eid="MRK 2:18" /><verse number="19" style="v" sid="MRK 2:19" />Yessuusinna insa'nee, «Waajubichch insa'nenni welti hedhee'naa jaaluwwi agabo goddo hosa dande'a? Waajubichchi insa'nenni welti hedhee'na'a agabo goddo hosa dandeennabaan. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Yaane kinni waajubichchi insa'neexxe oddonaa'ni adhdhemaaxxe yanna daggaani; ookkone wodda agabo goddo honsaani. <verse eid="MRK 2:20" /><verse number="21" style="v" sid="MRK 2:21" />Fedheeki dullatte seemma'ni haarooxxa seemma eribaaki ayyinna hedhebaani; eribendoole kinni haarooxxi seemma dullatte daddarenshatinna edi irra ba'lataan. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Iittanni fedheeki duullatte qalqalo'ni reefika woyinetika bulibulo uggaaki hedhebaani; uggoole woyinetiki bulbuli qalqallo dhoosaan; woyinetiki bulbulinna dunemaan qalqallotinna baxxaani. Tennexxee haarooka woyinetik bulbulo ugga hasissaak haarooxxe qalqalo'niten» hiyye hiisse.<verse eid="MRK 2:22" /></para>
  <para style="s1">Sanbatiinxee Shiqeeka Qortuma</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mat. 12:1-8</ref>; <ref loc="LUK 6:1-5">Luq. 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Edike Sanbatixxe barra'ni Yessuussi midhatike fichchi giddii'ni sa'a'naa Isinni welti me'itaammaxxi hordofeeyye tisha haa'mate'ni kexxe. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Feerisitotinna, «Edike sanbatixxe barra'ni hoyyendeexxa yaane mayee assita'ne?» hite Isoo qorte. <verse eid="MRK 2:24" /><verse number="25" style="v" sid="MRK 2:25" />Yessuusinna insa'nee, «Daawwiti solo'wee woddanna itaacho harseemma wodda, isinni welti hedheemmake manninni maa asseexxa ha'no haaseessitinebaa? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Qeesoletike akeekisanjo Abiyaataarike baro'ni Mageniike mine'ni e'ye qeesoletee malee weli manni itaashsha eeti'i uwwendebaaxa woyyoommeka xalta ifi'a ite isinni welti hedheemmake manni'anna uwwe» hiyye. <verse eid="MRK 2:26" /><verse number="27" style="v" sid="MRK 2:27" />Higgeenni Yessuusi insa'nee hiyyyee qici, «Edik Sanbati manjokee dademee malee; manji edike Sanbati'a dademebaani. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Tennexxee Manjiinki Belti edike Sanbati'a Goottakeni» insa'ne'a hiyye.<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s1">Yessuusi Anga Gogeeka Manjichcho Fayyise</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mat. 12:9-14</ref>; <ref loc="LUK 6:6-11">Luq. 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Higgeen Yessuusi Muuseka seera barsiinsammake mine'ni e'ye; ookko anga gogeeki manji hedhemmani. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Iso'ni yaane hasaammaki manni, edike Sanbatixxe barra'ni manjichcho konnee fayyisa'neexa uundo'a heqqe'naamman. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Isinna anga gogeeka manjichcho, «Bukki hiyyeeke ardi edo kexxe uurri!» hiyye. <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Yessuusinna, «Edike Sanbatixxe barra'ni eeti uwwendeek eloxxa assatemo yookaani elobaaxxa assate? Manjiinxa lubbo anjiratemo yookaani shiyate?» hiyye insa'ne'e laqe. Insane kinni sammi hine. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />Yessuusinna qalbe insa'neexxixxe duudaa yaadeexxi; qarqara isike'ni uurreemmaka manna mufeti uudeexxi; ookkonee manjichcho «Anga atixxa diriirsi!» hiyye. Manjichchikinna anga diriirsse; anga isixxinna fayyite. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Feerisitotinna iikki woddi Yessuusi'i hitta assine shinnaaxxa Heeroodisixxe gamo kadeeke manninni welti mari'atatte'ni ke'ne.<verse eid="MRK 3:6" /></para>
  <para style="s1">Heddi Ardi Yessuusi'i Hordofe</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Yessuusi hordofeeyye ifixxenni welti abbaayyatiba me'e; Geliilanaa'ninna Yihudanaa'n dageemak heddi ardi isoo hordofe; <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />Isi huja'neexxa yaane laqeemmak manni Yihudaa'n, Iyyerusaalemi'ni, Edoomiyaaasii'ni, Yordanoosike galaani wido hedheeke boganaa'ni ittanni Xiroosi'ninna Sidoona qarqarii'n Isibaa dange. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Bukki hiyyeek ardi isoo dhiibabaashsha shiixxoxxa hobolo hordofeeyye isixxi giissitaashsha ajaje. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Isinna heddo manna fayyiseemmaxxee; elagonpe'e abara uudaammaki duuchchi angati Isoo kisatee hokkokisaamman. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Fuggichchi hafuurruwwi isoo uudeexxe qixxe'ni Isi edo inba'ni, «Ati Mageniinke Beltoni» hiyya'ni raarrammani. <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />Isi kinni ayyumma ifixxa ege'nishabaashsha jabeesse insa'nee xixaamman.<verse eid="MRK 3:12" /></para>
  <para style="s1">Tommenna Lame Ergameeyyexxa Baallooma</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mat. 10:1-4</ref>; <ref loc="LUK 6:12-16">Luq. 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Yessuusi koobatee'ni fuleexi eettenee isi eeyyeexxa ifiba'a dangaasha ye'e; insa'nenna isibaa dange. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Insa'nenna isinni welti he'naashsha, insa'neenna lallabateenna ergo'a tommenna lamiinga baalloonse; insa'neenna ergameeyye hiyye summa fulche<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">mitte mitte tikuwwa insa'nee ergameeyye hiyye summa fulche hiyyaaka hiyyichcho affeba'a</char></note>. <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />Insa'nenna fuggichcha hafuurruwwa fulchinashsha baalloonse. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />Hariiremeeke tommenna lame hordofeeyye, Pheexiroosi hiyye summa fulcheek Simi'ooni, <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Bo'aanergeesi yookaan dindimiinxe oose hiyye summa fulcheek Zebidewoosixxa labbaxxa oose Ya'iqoobinna dayyo isika Yohaannisi, <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />Indiryaasi, Filiphphoosi, Bartelomewoosi, Maatoosi, Toomaasi, Ilfiyoosik belti Ya'iqoobi, Taadewoosi, hinaafalli Simi'ooni; <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />Iittanni Yessuusi'i sa'isse uwweeki Asiqorootuke Yihudamman.<verse eid="MRK 3:19" /></para>
  <para style="s1">Yessuusinna Bi'eelzeebuli</para>
  <para style="r">(<ref loc="MAT 12:22-32">Mat. 12:22-32</ref>; <ref loc="LUK 11:14-23">Luq. 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Ookkonechchi uduma Yessuusi mitte mine'ni e'ye. Isinna hordofeeyye ifixxi ita itatee dandeennabaaqico'ni higgeenni heddi ardi bukki hiyye. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Tennee laqeeki Isik firi, «Yessuusii maraateeni hinaaxxa odo laqeexxi» Iso'o abixxino'a dange. <verse eid="MRK 3:21" /><verse number="22" style="v" sid="MRK 3:22" />Iyyerusaalemii'n daggeemmak Muuseke seerk barachchiissalluwwi, «Isi Bi'eelzebuuli afeedheen Isinna fuggichcha hafuura fulcha'neek; konne fuggichchi hafuurike akeekisanjo kadeeke Bi'eelzeebulinniten!» hine.<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Yessuusinna insa'nee, «Durriisi durriisa hitta fulcha dande'a? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Weli'an weli qoqqoodendaaxxi moottumma jabaatte uurra dandeettabaan. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Mitti minihadi weli'an weli gargar higoole jabaate hedha dande'abaani. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Ittanni durriisi weli giba'noolenna weli qodema'noole ibaaxxa malee uurra dande'abaan. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />Tennenaa'ni kexxeexxa mitti manji edise hunnaameessa manjo usurebaangi; hunnaameessa manjichchike minibaa e'yo'anna karra isixxa saama dande'abaan. Mine isika saama dandeenaak hunnaameessa manjichcho usuraa wodda callaan. <verse eid="MRK 3:27" /><verse number="28" style="v" sid="MRK 3:28" />Dhugaate ha'no'a hiyyaanne; manjiinxe oose'a cubbonna yowwinaake yowwichchi duuchchi'a gattowwali hiyyendaan. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Yaane kinni Woyyichcha Hafuura'ni yowwichiinka hiyyichcho haaso'aaki duuchchi; duuchchi woddixxe cubboke ida kada melee; duuchchi woddi'a isi'a gattowwaali hiyyendabaan» insa'nee hiyye. <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />Yessuusinna tenne hiyyeechchi; «Iso'ni fuggichcha hafuura hedheeni» insa'ne hineemmaxxeetemmani.<verse eid="MRK 3:30" /></para>
  <para style="s1">Yessuusixxa Amanna Dayyuwwa Isika</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mat. 12:46-50</ref>; <ref loc="LUK 8:19-21">Luq. 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Ookkonechchi uduma Yessuusixxi amanna dayyuwwi isiki; Isibaa dange; insa'nenna gadho uurrineexxi; manjo isiba eriginne ye'inse. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Qarqara isike'ni ofo'leemmaki heddi manni, «Ama atixxinna dayyuwwi atiki gadho uurrinee atee hansa'neeni» iso'ni hine. <verse eid="MRK 3:32" /><verse number="33" style="v" sid="MRK 3:33" />Isinna hiisseexxi «Ama anxi ayyete dayyuwwi ankisi ayyeera?» insa'nee hiyye. <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Isinna qarqara ifike'ni ofo'lemmake mannibaa uuda'ni, «Ama anxinna dayyuwwi anki konneterani! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Mageniinxa fedhi wonshaaki duuchchi; isi dayyo anke, dayyo anxenna ama anxeni» hiyye.<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s1">Wiisalliinka Mammaassa</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mat. 13:10-17</ref>; <ref loc="LUK 8:4-8">Luq. 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Yessuusi higgeenni abbaayyati qarqara barsiisa safe. Isike qarqara'ni heddi ardi bukki hiyyeemmaxxee; isi abbaayyate'ni hexxeexxe hobolo'ni e'yeexxi ofo'le; ardi duuchchi abbaayyati qarqara hedhemmake booncho'ni bukki hiyyeemmani. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Isinna heddo yaane mammaassiki, <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />«Laqqe! Mitti wiisalli midha facaalso'a fule. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Isinna midha facaalsaa wodda; mitte mitte gumma orin qarqara ibbe; ci'atinna qocexxe itte. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Wele gummanna buttini hedhebaa booncho'ni carete'ni ibbe; heenooki buttini hedhemmaxxee hirbange'ni fulde. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Yaane kinni arishsho fuldee wodda qoorte; hidda olta gophphemmaxxee bagge. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Wele gumma kinni utetixxe oddo'ni ibbe; utetinna nophphiteexxi gummatika hiddichcho buqqeemmaxxee gumma gummissebaan gatte. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Wele gumma kinni shamoke buttina'ni ibbeemmaxxee nophphite gummatanna gummisse; mitte sase tomme, mitte jaane tomme, mittetinna dhibba gumma gummisse» hiyya'ni barsiisaamman.<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Lebeexxi Yessuusi, «Laqqaaxxa mansha afeeki laqowwaali!» hiyye.<verse eid="MRK 4:9" /></para>
  <para style="s1">Yessuusi Mayee Mammaassik Haaso'eexxa</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mat. 13:10-17</ref>; <ref loc="LUK 8:9-10">Luq. 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Yessuusi qofittinni hedhee wodda, isoo hoordofaammaki manninna tommenna lame isixxi hordofeeyye mammaasiinxee isoo qorre. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Isinna hiisseexxi, Mageniinxe mootummaxxa sho'ondeexxe yaanexxi ege'na ha'no'a uwwendeeni. Gadho hedheeke mannii'a kinni yaane duuchcha mammaassik insa'ne'a kulendaani; <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />Tinninna insa'ne,</para>
  <para style="q1" vid="MRK 4:12">« ‹Uunda'ninni qalbeeffantabaani;</para>
  <para style="q2" vid="MRK 4:12">lanqa lanqa'inni</para>
  <para style="q1" vid="MRK 4:12">Qalbeeffante hingabashshanna cubbo insa'neexxi</para>
  <para style="q2" vid="MRK 4:12">insa'ne'a gattowwaal hiyyendabaashshaten.› »<verse eid="MRK 4:12" /></para>
  <para style="s1">Wiisallichchiinke Mammaassiixxa Tika</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mat. 13:18-23</ref>; <ref loc="LUK 8:11-15">Luq. 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Ookkonechchi uduma Yessuusi insa'ne'a, «Kunni mammaassi ha'no'ni aageebaa? Hittata wele mammaassuwwa duuchcha ege'na dandeettina? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Midha facaasaaki konnee hiyyichcho facaasaani. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Mitti mitti manni orin qarqara ibbeexxe gumma fakkaataan; insa'nenna konnee hiyyichcho lanqaa wodda durriisi ikki woddi dage'e qalbe insa'nexxe'ni facaasemeeka ookkonee hiyyichcho adhdhaan. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Ittanni weli carete'ni hana facaasendeexxi gumma fakkaantaani; insa'nenna konnee hiyyichcho lanqaa wodda gammadiki adhdhinaan; <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />yaane kinni yannate malee insa'ne hidda anfebaan; insa'nenna konne hiyyichchixxe daafe'a rakko yookaani shorrichchi geyaa wodda iikki woddi guggufantaan. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Wele kinni utetixxe oddo'ni facaanseexxe gumma fakkaanta; insa'nenna konnee hiyyichcho laqa lanqaan; <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />Yaane kinn tenne buttake yaadi'a heda; durummatixxee yora, iittanni toliinxee fiiddiyya hiyyichcho buqqe abidde'e gumma gummissabashsha assitaan. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Wele shamoke buttinaa'ni facaasendeexxe gumma fakkaantaan; insa'nenna konnee hiyyichcho lanqeexxi galche'naakenna sase tomme, jaane tomme, dhibba gumma gummisaaki konneerani» hiyye.<verse eid="MRK 4:20" /></para>
  <para style="s1">Ifiinka Mammaassa</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luq. 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Yessuusinna, «Xassa agaladeti hunda yookaani taqeti hunda ugginaa? Ugginaaki qephichcha booncho'niteba? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Tennexxee shoo'omeexxi leellabaachchi, buqeme ifake'ni fulabaachchi hedhabaan. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Yoona, laqqaaxxa mansha afeeki laqowwaali!» insa'nee hiyye.<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />Higgenni Yessuusi insa'nee hiyyee qici, «Laqqinaaxxe yaane'a ifi xexxe'atte! Safartineenge safaranjo'ni ha'no'a safarendaani; ittanni caala ha'no'a lebendaani. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Afeeke manji'a lebendaan; afebaakenaa'ni kinni afemmaxxi midde adhdhendaani» hiyye.<verse eid="MRK 4:25" /></para>
  <para style="s1">Nophphitaaxxe Gummaka Mammaassa</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Ookkonechchi uduma Yessuusi, «Mageniinxi mootumma tenne butta'ni gumma facaasaake manjo fakkaataani. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Kunni manjichchi hashsha diiphaani; soodoole ke'aani; yaane kinni isi ege'nebaangi iitti gumma fulde'e nophphitaani. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Buttinikinna ifi'aanni edisse'e mudho, lebbeexxi dame, ookko'ninna dametike daalo'ni gumma afisaani. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Gumma raxxeeshshanni mayetixxi yanna gelteemmaxxee manjichchi hirbange'ni haantoti haama safaan» hiyye.<verse eid="MRK 4:29" /></para>
  <para style="s1">Shaaniinxe Gummaka Mammaassa</para>
  <para style="r">(<ref loc="MAT 13:31-34">Mat. 13:31-34</ref>; <ref loc="LUK 13:18-19">Luq. 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Higgeenni Yessuusi, «Mageniinxa mootumma mayiki welti herreganno? Yookaani mayiinke fakkeenninni kulanno? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Buttate'ni facaasendaaxxe gumma duuchchana'ni hara shiixxexxeexxa shaaniinxe gumma fakkaataan. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Isenna facaasende nophphiteelchi uduma kinni; hiddichuwwa duuchcha saxxaan. Ci'uwatinna lulmolla damuwwa isexxi hunda mine ijaadhdhitee hexxaan» hiyye.<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Yessuusinna mannake'ni aaggaa qico'ni konnee fakkataka heddo mammaassuwwa mammaaka'ni kule. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Isinna mammaassi belo mittelchonna insa'nenni kulaammaban. Isinna isixxi hordofeeyye calli he'na wodda kinni duuchchinxa yaane mitte mittendinni insa'ne'a aaggaa qico'ni kula'nemmani.<verse eid="MRK 4:34" /></para>
  <para style="s1">Yessuusi Danbala'a Sammi Asse</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mat. 8:23-27</ref>; <ref loc="LUK 8:22-25">Luq. 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Isinna eettene barraxxa hashsha hordofeeyye ifixxa, «Ke'we abaayyati widi'a foonfo!» hiyye. <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Insa'nenna arda ookoo waalleexxi isoo hobolote'ni adhdhine me'ine; wele hoboluwwanna isinni welti hexxemmani. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Ookkone wodda jabaxxi hobonbalte kexxe; danbala'ikinna wodi'i hobolote'ni wo'maa qico'ni hobolo erqe kayya gana'nemman. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Yessuusi hoboloti udumi ga'mii'ni boraafatee diipheemmani; hordofeeyyetinna isoo dammassiteexxi «Barsiisanjo! No'o mundaa'naa sammitatto?» hite.<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Isinna dammaqeexxi diidallo xixe; abbaayyatanna «Sammiyyi!» hiyye. Diidallotinna hirbaange'ni sammi hite; lumoki ca'lini kade.<verse eid="MRK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40" />Isinna hordofeeyye ifixxa: «Mayee iitta sodaattine? Konne qico'ni amana affinebaa hiyyotee?» hiyye.<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Insa'nenna lumo qico sodaanteexxi, «Diidallotinna abbaayya midde ajajenda'neeki kunni maa manjike manjo?» weli'an weli hine.<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s1">Yessuussi Fuggichcha Hafuuruwwa Manjichokenaa'ni Fulche</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mat. 8:28-34</ref>; <ref loc="LUK 8:26-39">Luq. 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Insa'nenna Geliilaxxa abbaayya foonfe Gergeesenoon hiyyemaake bogibaa dange. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Yessuussinna hobolotenaa'ni dirreeshshanni; fuggichchi hafuurinni abideme'eeki manjichchi hirreesi giddii'ni fule isibaa dage. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Kunni manjichchi hirreesi giddo hedha'nemmakenna; fedheeki midde isoo haachchabiki usurra dande'aaki ayyinna hedhemmabaani. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Isinna heddo yanna lekkatike sibljinninna haachchabiki usuremaammani; yaane kinni angatika haachchaba tansha'ninna lekkatika sibljo enqa'ni huna'nemmani. Tennexxee isoo huuni manjinna uurrisa dande'aaki fedhemmabaan. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Heddo yanna hashshanna barra hirreessi giddonna koobuwwate'ni marema'ni raara'nemmani; biso ifikanna kinjki wowwoxxa'nemmani.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Kunni manjichchi Yessuusii'i bayyanni uudee wodda isibaa gongeexxi guluffate'e isoo sagade. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Lummise raara'ni, «Ati lummedheeke Mageniinke Belto Yessuusii! Ati ane'n maa affette? Magenke summini ate kadhataneni; magaaneteni ane'e abara uudissoxxe!» hiyye. <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Manjichchikinna tenneenna hiyyeechchi Yessuussi, «Ati fuggichchi hafuuri konne manjichchonaa'ni fuli!» hiyyeemmaxxeeten. <verse eid="MRK 5:8" /><verse number="9" style="v" sid="MRK 5:9" />Ookkonechchi uduma Yessuussi, «Summi atiki ayyete?» hiyyeexxi isoo qore.</para>
  <para style="p" vid="MRK 5:9">Isinna hiisseexxi, «No'o heddoke kandeennaxxee summi anki Leegooniten<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="fqa" closed="false">Leegoon </char><char style="ft" closed="false">Leegoon hiyyo jaane kuma lekkati lolaammaka loliinka mannanna mitte dhibbanna lame tomme fadhaduwwa abidaake loliinke mannike summan.</char></note>» hiyyeexxi hiisse. <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Isinna ookkone boganaa'ni shorrabaashsha Yessuussi'i jabeesse kadhate.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Qarqarake'ni hedheeke tullichcha'ni heddi booyyetiki bobba'i ookko'o dheedaamman. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Tennexxee fuggichchi hafuuruwwi Yessuussii, «No'o Booyyuwwate'ni e'yinonnaa eetii no'a uwwi» hine iso'o kadhante. <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Yessuussinna insa'ne'a eetii uwwe. Fuggichchi hafuuruwwinna fuleexxi booyyuwwate'ni e'ye. Lame kuma geltaaxxi booyyuwwa irigakenaa'ni butti'a ibbeexxi abbaayyati giddo lixxe.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Booyyetixxi allalsano kexxe bajje; insa'nenna odotanna qachchake'ninna hadi giddo geessinse; ardikinna tennee yaane uudo'a hedhe hedhemmabaa'ni dage. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Insa'nenna Yessuusibaa dangeexxi iikki fuggichchi hafuurinni abidemeemmaaki manjichchi maraatummatenaa'ni fayye, seemmatanna oddo'we ookkoo ofo'leenaa uunde sodaante. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Tenne uudeeki manni fuggichchi hafuurinni abidemeemmake manjichchi'a assendeexxanna booyyuwwate'ni kaddeexxa yaane duuchcha ardakee odeessine. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Ookkonechchi uduma ookkone bogiki manni; Yessuussi insa'neeka boga waale me'aashsha kadhante. <verse eid="MRK 5:17" /><verse number="18" style="v" sid="MRK 5:18" />Yessuussi eettene hobolote'ni e'ya'nee wodda iikki fuggichchi hafuurinni abidemeemmaki manjichchi, Yessuussinni welti me'o'a kadhate. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Yessuussi kinni eeti'i isi'a uwwebaan; yaane kinni, «Kexxe mine atikibaa me'i; hado atike'e Gootti lumoxxa yaane ati'a asseexxanna hitta atee marareexxa marte hado atikee kuli!» hiyye. <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Manjichchikinna me'eexxi, Yessuusi isi'a asseexxa yaane duuchcha «Tomme qachchuwwa hiyyemaake boga'ni» odeessate'ni ke'e; tennee laqeeki manni duuchchinna mambe'a hiyye.<verse eid="MRK 5:20" /></para>
  <para style="s1">Rerteemmaxxa Beltonna Elagophpheemmaxxa Manjichcho</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mat. 9:18-26</ref>; <ref loc="LUK 8:40-56">Luq. 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Higgeenn Yessuusi hoboloti abbaayyati widi'a foofee wodda; heddi mann bukki hiyye. Isinni abbaayyati qarqara hedhee'naa; <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Muuseka seera barantaammake mine'ni akeekisanjuwwakenaa'ni mitti Iyya'iroosi hiyyemaak manjichchi ookko dage Yessuussixxe lekka'ni ibeexxi, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />«Shiixxoxxi anxi belto rerto'aten; isenna fayyite hedhoti hexxaashsha ballo'o dagettexxi anga atixxa ise'ni hana uggi!» hiyyeexxi jabeesse kadhate. <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />Yessuussi ke'eexxi isinni welti me'e; heddi manninna Yessuussi'i hordofeexxi qoqqobe me'a'ni weli dhiiba'nemmani.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />Tommenna lame wogga munde dunnendaa'naa hexxemmaxxi manjichcho ookko hexxemmani. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />Isenna mitte ci'leessibaa'ni wele ci'leessibaa me'ita'ni affeeka maallaqa iseka duuchcha birtoolenna dhibo ise'ni bira saxxa'ni me'ite malee'e foora alfiteemmabaani. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Isenna Yessuusika gurra laqqe ardi giddi'ni udumii'ni daggeexxi Yessuussixxa seemma tuqqe. <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />Isenna tennee assiteechchi; «seemma isixxa calla tuqonnole fayyanooni» hitee amandeemmaxxeeten. <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />Isenaa'ni dunnendaammaxxi munde hirbange'ni uurrite; dhibo isexxenaa'ni fayyiteexxa manjunte isexxe'ni laqende. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Yessuusi kinni hirbange'ni hunna isonaa'ni fuldeexxa ege'ne; ardiinbaa wirri hiyyeexxi «Ayyete seemma anxa tuqeeki?» hiyyeexxi qore. <verse eid="MRK 5:30" /><verse number="31" style="v" sid="MRK 5:31" />Hordofeeyye isixxinna, «Ardi atee dhiibaa'naa uuda'ni mayee'e ‹Anee tuqeeki ayyete› hitaatte?» isoo hine. <verse eid="MRK 5:31" /><verse number="32" style="v" sid="MRK 5:32" />Yessuussinna tenne assek ayyete kadeexxa uudo'a udumi'a wirri hiyye uude. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Ookkonechchi uduma manjichchotinna ifi'ni kaddeexxa yaane egendeemmaxxee sodaatte culphissa'ni, isi edo dagge'e ibbe'e; kaddeexxa duuchcha dhugaa iso'ni haassootte. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Isinna hiisseexxi, «Anxe belto; amanaa atixxi atee fayyisseeni; nage'iki me'i! Abara atikenaa'ni fayyi!» hiyye.<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Yessuussi tennee haaso'a'neenge'ni; manni Muusseka seera barantaammake minike akeekisanjo Iyyayiroosike minenaa'ni dageexxi; «Belto atixxi reriteeni» insa'nenna «mayee barsiisanjo eloossitatto?» hine. <verse eid="MRK 5:35" /><verse number="36" style="v" sid="MRK 5:36" />Yessuusinna tennee laqeexxi akeekisanjokee, «Amani malee, sodaattoxxe'e!» hiyye. <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Isinna Pheexiroosii, Ya'iqoobiinna iittanni Ya'iqoobika dayyo Yohaannisii'i malee'e ayyinna isoo hordofaashsha eeti uwwebaan. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Insa'nenna Muusseka seera barantaammake minike akeekisaanjike minibaa genneeshshanni Yessuussi manni weekema'ni, oodha'ni hunbaashaa'naa uude. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Isinna mini'a e'yeexxi insa'neenni «Tinni weekenshanna oodhishsha duuchchi mayiinxe? Belto diiphphee malee, rertebaaqqa» hiyye. <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />Mannikinna Iso'ni oso'le. Isinna manna duuchcha minii'ni fulcheechchi uduma beltotika annanna ama ittanni isinni welti daggeemmaxxa hordofeeyye adhdheexxi belto hexxeeke mini giddi'a e'ye. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Ookkonechchi uduma isi beltotixxa anga abideexxi «Xaaliita uurri!» hiyye. Tikatinna «Tee belto ke'i» hiyyoteni. <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />Beltotinna ikki woddi kexxe uurriteexxi elqekayya mammarende; wogga isexxinna tommenna lametemman. Mannikinna tennee yaane'ni lumoqico mambe'a hiyye. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Yessuussinna tennee yaane mittikinna ege'nabaashsha ajajeexxi insa'ne xexxe'achchiiseexxi ittaachchonna ise'a uuno'a insa'ne'ni kule.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s1">Wabeek Ifike Boga'n Ulfeessemaba'a</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mat. 13:53-58</ref>; <ref loc="LUK 4:16-30">Luq. 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Ookkonechchi uudma Yessuusssi ifike bogiba dage; hordofeeyyetinna isoo hordoffe. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Edike Sanbatixxa barra Muuseka seera barantaammake mine'ni barsiisa safe; tennee isixxa barsiisa laqeemmak heddi manni mambe'a hiyya'ni.</para>
  <para style="p" vid="MRK 6:2">«Kunni manjichchi tenne yaane duuchcha habaa'ni alfe?» insa'nenna hiissineexi «Maa beekkuma Isi'a uwwemee? Konne manmbe'uwwa huja'neeki isi hitaate! <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Isi kunni haqichcho bocaammakenna Maaramike belto, Ya'iqoobikenna Yoosake, Yihudakenna Simi'oonike dayyobaa? Isixxi Dayyuwwanna no'on bira hexxebaa?» isoo hine. Tennena'ni kexxeexxa insa'nenna tuffet baracho isixxa adhinebaangi gante.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />Yessuusinna insa'nee, «Wabeek ulfeessemabaak ifike boga'ni, ifike fira'ninna ifike mini hado'nite callani» insa'ne'e hiyye. <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />Isinna ookkoo heenoke elagopheeke manna'ni anga ifixxa hana ugge fayyise malee'e; wele mambe'a yaane hujebaani. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Isinna amana gopha insa'neexxee lumo qico mambe'a hiyye.</para>
  <para style="p" vid="MRK 6:6">Ookkoneechchi udumii'a Yessuussi ola'uwwake'ni marema'ni barisiisa'ne'mmani.<verse eid="MRK 6:6" /></para>
  <para style="s1">Yessuussi Tommennna Lamiinga Erge</para>
  <para style="r">(<ref loc="MAT 10:5-15">Mat. 10:5-15</ref>; <ref loc="LUK 9:1-6">Luq. 9:1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />Isinna tommenna lame hordofeeyye ifiba'a ye'eexxi lame lame asseexxi erge; fuggichcha hafuuruwwa'ni baallooma insa'ne'a uwwe. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />Yessuussinna insa'nee, «Ora me'itinaakee siqqo malee'e gala'a, yookaan subba, yookaani maallaqakanna abixitinoqqe'e; <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />lekka ha'noxxe'ni kophe uggudhdhe; yaane kinni odo'witineexxe seemma'ni hana lephphitine oddo'witinoqqe'e. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Fedheeke booncho'ni martine e'yitinaa wodda; hoone mine'ninna e'yitinoole ookone qachcha waaldine fuldinaqico'ni ookkoni turre. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Manni ha'nooxxa laqa'nebaakenna ha'no adhabaake kadoole ookkone boonchonaa'ni fuldiina wodda; lekka ha'noxixxa buko ganiga'nitine ookko'ni fulle. Tinninna insa'ne'a xexxe'achchiisatike beesisa kaddaan» hiyye'e ajaje.<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Insa'nenna ookkoo'ni fulleexxi mann aade agaasha lassine. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Insa'nenna heddo fuggichcha hafuuruwwa fulchine; heddo elagopheeke manna'ninna zayite isinaa'ni fayyinse.<verse eid="MRK 6:13" /></para>
  <para style="s1">Xamaqaammaake Yohaannisixxa Gorra'ensha</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mat. 14:1-12</ref>; <ref loc="LUK 9:7-9">Luq. 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Yessuussiki summi ege'nema'ni dagemaxxe'e moyanji Heeroodisi tennee laqe. Mitti mitti manninna, «Xammaqammak Yohaannisi rewotenaa'ni ke'edheeni; tennexxee kunni mambe'i duuchchi kada'neeki isi gamii'niteni» hina'nemman.<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Weli manni; «Eelyaasiteni» hiyya'nemmani; weli kinni, «Edixxe wabeekotenaa'n mitteken» hina'nemmani. <verse eid="MRK 6:15" /><verse number="16" style="v" sid="MRK 6:16" />Heeroodisi tennee yaane laqee wodda kinni; «Ani gooba gorrasiseennake Yohaannisi rewotenaa'ni ke'eeni» hiyye. <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />Heeroodisi ifike dayyixxa Filiphphoosixxa are Heerodiyaadaa'a adheemmaxxe'e; isexxe buutonni isi Yohaannisi'i abindaashsha ajajeexxi usursiiseemman. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Yohaannisi Heeroodisii'i, «Atike dayyixxa are ati ifi'a aadhiyyote'e Muusek seeri hoyyaani» hiyya'nemman.<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />Tennenna asseelchi Heerodiyaada tenne yaane'ni haloonfatte'e Yohaannisi'i shilchiisso'a hassa'nemmani; yaane kinni dandeettebaan. <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />Dande'a gophpheechchinna Yohaannisi qullichchakenna woyyichcha manjo kadeexxa Heerodisi ege'neemmaxxee isoo sodaata'ni ifi heqqedha'nemani. Isinna Yohaannisi haaso'a'nexxa Heeroodisi laqaa wodda kunni yaadi iso'ni a'urroolenna gammashshoti laqa'nemmani.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Heeroodisi ilemeexxa barra ulfaateeka ja'laabuwwa loliinka manna ajajaammakanna Geliilake bogi giddo ege'nemeeke lumolli manni'a ita qophpheesse: tinni yanna Heeroodiyaada'a eloxxe yanna ise'a kadde. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Heerodiyaadaxxi belto itatike mine'ni e'yiteexxi siribita'ni Heeroodisinna isinni welti itate'ni hedheemmaka manna gammachchiise. Moyanji tennee belto; «Eeteteexxa yaane duuchcha anee laqqottole ati'a uwwannoni» isee hiyye; <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Isinna higgeen; «Anxe mootummaka gamisa kadoolenna midde; laqqettelcho duuchcha ati'a uwwannoni» hiyye ise'a kakate.<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />Isenna ifixxe amabaa marteexxi; «Maacho isoo laqanno?» isee hite. Ama isexinna; «Xammaqanjo Yohaannisika gooba woxxe umo» ani'a uwwemowwali hite.<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Beltotinna moyanjiinba'a rakke marteexxi; «Xammaqanjo Yohaannisika umo ta'a qorete'ni uggite'e ani'a uutattosha hasaanneni» isoo hite. <verse eid="MRK 6:25" /><verse number="26" style="v" sid="MRK 6:26" />Moyanji tennee yaane'ni lumooshsha yaade; konnee itatee ye'endeexxe keessumma edo kakateexxe kako'a ise laqqeexxa yaane hoyyedha dande'ebaani. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Tennexxee moyanji hirbaange'ni heqqaammake sannachchi giddii'ni mitte ergeexxi Yohaannisika umo woxeexxi iyyedagaashsha ajaje; sannachchikinna usurriinke mine'ni mareexxi Yohaannisika umo woxe. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />Isinna woxeemmaka umo qorete'ni ugge beltotee uwwe; beltotinna amatee uute. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Yohaannisixxi hordofeeyye tennee laqqeeshshanni daggeexxi Yohaannisika rensha aaxeexxi moogge.<verse eid="MRK 6:29" /></para>
  <para style="s1">Yessuussi Onde Kuma Manna Itise</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat. 14:13-21</ref>; <ref loc="LUK 9:10-17">Luq. 9:10-17</ref>; <ref loc="JHN 6:1-14">Yoh. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Ergameeyyetinna Yessuusike qarqara'ni bukki hite assiteexxanna barsiisseexxa duuchcha iso'ni kulde. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Yessuussinna; «Ha'no qofittinni manji hedhebaaba Aninni welti me'inee'na ookko shiixxo qico hafuura adhdhe!» hiyye. Ookkonechchi uduma heddi manni dagga'ni me'aammaxxee insa'ne ita midde itatee yanna anfeemmabaan. <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Tennexxee insa'ne qofiti ha'naabaa hobolote'ni gulunfe'e me'ine. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />Kaddo malee insa'ne me'ina'neenge'ni heddi manni insa'ne'e uude'e ege'ne; tennexxee qachcha duuchchanaa'ni manni fuleexxi gonge sa'eexxi edise geye. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Yessuussi eettene hobolonaa'ni dirree wodda heddi ardi bukki hiyyee'na uude; insa'nenna allalisanjo afebaake gedhebishsha kandeexxa uudeexxi insa'ne'a yaade; isinna heddo yaane insa'nee barsiisate'ni ke'e. <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />Bogi hashshee wodda; hordofeeyye isibaa shikki hiteexxi, «Kunni boonchinna qiilla gammoojjeni; bogikinna hashsheeni; <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />insa'nenna qarqarake'ni hedheeke olla'i giddi'a me'ineexxi indaachcho hidhine indaashsha konnee manna geegeessi» isoo hine. <verse eid="MRK 6:36" /><verse number="37" style="v" sid="MRK 6:37" />Yaane kinni Yessuussi, «Indaachcho ha'nonni insa'ne'a uwwe!» hiyye.</para>
  <para style="p" vid="MRK 6:37">Insa'nenna isoo «Marrennexxi lame dhibba birrenni Diinaarenni<note caller="+" style="f"><char style="fr" closed="false">6:37 </char><char style="fqa" closed="false">Mitte Diinare </char><char style="ft" closed="false">Mitti hujali'a barra mitteke rundaman.</char></note> indaacho hirrennexxi uunannota?» hine.<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />Yessuussinna insa'nee, «Me'e so'iinxa kebbo afine'ei?» isinna «Amme, martineexxi uudde!» hiyye.</para>
  <para style="p" vid="MRK 6:38">Insa'nenna uundeexxi, «Onde so'iinxa kebbonna lame qulxu'me hexxeeni» hine.<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />Yessuussinna konnee arda quffeexxe anso'ni qorbi qorbiki ofo'linshaashsha ajaje. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Tennexxee ardikinna dhibbi dhibbikinna onde tomme kada'ni qoqqoodemeexxi ofo'le. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Yessuussi onde so'iinxa kebbonna lame qulxu'me aadhe iimi'a uuda'ni galateeffateexxi so'iinxa kebbonna kukkuteexxi mannakee qoqqoondaashsha ifixxe hordofeeyye'ni uwwe. Ookkoonechchi uduma Isinna lamiinxa qulxu'me duuchchiingee qoode. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Duuchchiingi ite godde. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Hordofeeyyetinna inda'naa gatteexxa so'iinxa kebbonna qulxu'me tommenna lame qore wo'ma hanba bukki assite. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Tenne so'iinxa kebbo iiteek manninna onde kuma labballomman.<verse eid="MRK 6:44" /></para>
  <para style="s1">Yessuussi Abbaayyate'ni Hana Tarkaafata'ni me'e</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mat. 14:22-33</ref>; <ref loc="JHN 6:15-21">Yoh. 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Ookkone hirba'ni Yessuussi arda geegesa'na hordofeeyye ifixxi hoboloti Beete Sayida'a isi'a edisse fooffaasha ajaje. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Ookkoo'ni Isi insa'nee ookkonni waaleexxi soodato'a koobatibaa fule. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />Bogi hashshee wodda hobolo abbaayyatixxe oddo'ni hexxemmani; Yessuussinna qofitti gadho bagoba hedhemmani. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Insa'ne'ni diidallo itti jabaatteemmaxxee hordofeeyye shaffisik ooffa'ni rakkanta'naa uuddexxi hashshixxe sallaanne saatenaa'ni tommenna lame saateqico'ni hexxeexxe yanna'ni abbaayyati hana tarkaafat'ni insa'neebaa dage. Isinna insa'nee birii'ni sa'e me'o'aatemmaani. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Yaane kinni insa'ne Yessuussi abbaayyate'ni hana tarkkaafate me'a'naa uundeexxi; geelate hina'ni raarre. <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />Insa'ne duuchchingi Isoo uunde alanne.</para>
  <para style="p" vid="MRK 6:50">Isi kinni hirbange'ni; «Mee co'o, Anten sodaattinooqe'e!» hiyye. <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Isinna hobolote'ni hana gulufe insa'nenni welti ofo'le diidallotinna uurrite. Insa'nenna tenne yaane'ni lomoqico mambe'a hine. <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />Insa'ne so'iinxe kebbo'ni hujemeeka mambe'a kassi hiyya gonpheemmaxxee qalbe insa'neexxi duuddemman.<verse eid="MRK 6:52" /></para>
  <para style="s1">Yessuussi Gensereexi'ni Elagopheeka Manna Fayyiseexxa</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mat. 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Insa'nenna abbaayya fonfeexxi Geensareexxike bogibaa dange genne. Eettene hobolo ookkonni uurrinse. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Hobolotenaa'ni dirrineeshshanni ardi Yessuussi'i uude ege'ne. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Insa'nenna loola duuchcha'ni gongina'ni elagopheeka manna rarete'ni dunke Yessuussi hedheebaa idanga'nemman. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Isi geyeeke olla'a yookaan qachchake'ni yookaan hadi giddo duuchcha elagopheeka manna loola loolake'ni uggina'ni seemma Isixxiki kasi tuqaashsha manni isoo kadhataamman; tuqeeki duuchchinna fayyaammani.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s1">Yessuussi Ayihudiinka Seera Morome</para>
  <para style="r">(<ref loc="MAT 15:1-9">Mat. 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Feerisitotinna Iyyerusaalemii'n dageemmak mitti mitti Muuseke seerixxi barsiisano Yessuussi bira bukki hite. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />Insa'nenna hordofeeyye isixxe giddii'ni mitte mitte anga anshexxebaangi so'iinxa kebbonna indaa'na uunde. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />Feerisitotinna Ayihudi duuchchi edike annuwwika seera heqqedhatee hine anga ifixxa ca'a asse'ne anshe'nebaaki indaammabaani. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Insa'ne dikko marre hingaa wodda anshe'ne ifi ca'a asse'noole malee'e indammabani. Iittanni wode'e ha'winaaka qasha, odolcho, qoretanna taqe anshati wele heddo seeruwwa heqqe'na'nemmani.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Tennexxee Feerisitotinna Muuseke seerixxi barsiisano, «Hordofeeyye Atixxi edike annuwwike seershshanni hedha insa'ne'a hasissaa wodda mayee anga anshexxebaangi so'iinxa kebbo indaa?» hine Yessuussi'i qorre.<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Isinna insa'nee, «Ha'no bada gadho danchuwwi giddo bushuwwi! Wabeek Issayaasi insa'neexxee:</para>
  <para style="q1" vid="MRK 7:6">« ‹Kunni ardi afo'i callinni anee ulfeessa'neen;</para>
  <para style="q2" vid="MRK 7:6">qalbe insa'nexxi kinni anenaa'ni bayyatteexxeni.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Insa'ne anee tola bodichanga magenooffanta'een;</para>
  <para style="q2" vid="MRK 7:7">barsiisa insa'neexxinna manjiinxe aada callishshaten› hiyye borreesseexxi dhugateni.<verse eid="MRK 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MRK 7:8" />Ha'no Mageniinka ajaja waaldineexxi manjiinka seeranna aada heqqexxinaani.»<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Yessuussinna higgeenni insa'nee: «Seera ha'nooka heqqedhatee hitine Mageniinka ajaja waaldinaani. <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Muuse, ‹Anna atikanna ama atixxa ulfeessi; anna ifikanna yookaan ama ifixxa yowwaaki manji reyowwaali› hiyyeemman.<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Fula. 20:12</ref>; <ref loc="EXO 21:17">21:17</ref>; <ref loc="LEV 20:9">Lew. 20:9</ref>; <ref loc="DEU 5:16">Lan. 5:16</ref>. </char></note> <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Ha'no kinni: ‹Mitti manji anna ifika yookaani ama ifixxa, qarqaaraammaxxa bakka; annakeenna amatee assiyyo hasissaammaxxa yaane duuchcha› assano hiyyoole, (Magenokee shiqishaanneke tolcha) <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />Ookkoneechchi uduma ha'no kunni mnjichchi anna ifikekeenna kado ama ifixxee konnechchinni edi'a mittelchonna assabaashsha eetii uutinabaan. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Tennexxee ila ha'nooxxee sa'issitinaaxxe aadanni Mageniinka hiyyichcho jijjiirtinaan; iittanni tennee fakkaattaaxxa heddo yaane assitinaani.»<verse eid="MRK 7:13" /></para>
  <para style="s1">Yessuussi Manjo Battoossitaaxxi Yaane Maachcho Kadeexxa Kule</para>
  <para style="r">(<ref loc="MAT 15:10-20">Mat. 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Higgeeni Yessuussi manna ifibaa ye'eexxi, «Ha'no duuchchiingi Ani hiyyaannexxa qalbeeffattine laqqe. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Manjo battoossitaaxxi manjokenaa'ni fuldaaxxe malee gadhii'ni manji giddi'a e'yitaaxebaan!» <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />Yoona laqqaaxxa mansha afeeki laqowwaali!<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">Mitte mitte hundaayetixxe biraanixxe borruwwa konne laakosa 16 affebaan.</char></note><verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Yessuussi manna waleexxi mini'a e'yee wodda hordofeeyye isixxi konne mammaasixxee iso'o qorte. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Yessussinna lebeexxi, «Tinni yaane ha'no'ni aagga'nebaa? Gadhii'ni manji giddi'a e'yitaaxxi yaane manjo battoonsatee dandeettaaxxi mitte yaanenna hexxebaan. <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Mayee hitinoole; manji giddi'a e'yitaaxxi yaane godobi giddii'ni saxxe gadhi'a fulda maleee; qalbeti giddi'a me'itabaani» insa'ne'a hiise. Tennexxee Yessuussi ita duuchcha qullittete kaddeexxa konne orinni kulle.<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Isinna lebeexxi: «Manjokenaa'ni fuldaaxxi iitti manjo battoossitaan; <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />manjiinxe qalbe giddii'ni fulaaki elobaaki hedumi, samaamura, moora, manjo shiya, yabaabule, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />Haafema, xaqaro, soba, qiliphphisa, diina, manjiinka summa balleessa, hollatenna booso'ummaten. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Tinni elobaaxxi yaane duuchcha manjiinxe qalbenaa'ni fuldaani; manjokanna battoonsitaani.»<verse eid="MRK 7:23" /></para>
  <para style="s1">Siroofiniiqichcho Manjichcho</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mat. 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Yessuussi Xiroosike qachchike qarqara'ni hedheeke looluwwibaa me'e; isinna mitte mine'ni e'yeexxi ookko hedheexxxa ayyinna egenabaashsha hase; kaddo malee ookko'o sho'omatee dande'ebaani. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Hirbange'ni isexxi shiixxoxxi belto fuggichchi hafuurinni abidendeexxi mitte manjichcho Yessuussixxee laqqeexxi dagge'e lekka isixxe'n ibbe. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Manjichchotinna Girkiichchote kaddeexxi ilenshatinna Sirofiniiqichchotemman. Isenna Yessuussi belto isexenaa'ni fuggichcha hafuura fulchaashsha kadhate.<verse eid="MRK 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27" />«Oosetixxa ita aa'ne worshakee uwwa seerake kada gophpheemmaxxee» isi kinni, «edisse'e oosendi godite ittowwaali» ise'a hiyye.<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />«Dhugaandeni anke Gootta» manjichchotinna hiisiteexxi, «yaane kinni worshikinna qoreti hunda hedhee oose itta'naa harca'emmaka itaani» isoo hite.<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Okkonechchi uduma Yessussinna, «Tennee hiteettaxxee me'i; fuggichchi hafuurna atixxe beltonaa'ni fuleeni» ise'a hiyye.<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Isenna ifike minibaa higgee wodda belto isexxenaa'ni fuggichchi hafuuri fulee'naa belto taqete'ni diiphee'na affe.<verse eid="MRK 7:30" /></para>
  <para style="s1">Mansha Laqabaakennn Afo'o Duudeemmake Manjiichixxa Fayya</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Ookkonechchi uduma Yessuussi Xiroosike boganaa'ni ke'eexxi Sidoona darree'n sa'eexxi tomme qachchuwwa hiyyemaake bogibaa kute Galiilixxe abbaayyabaa dage. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Ookkoo manni mansha laqammabaakanna afo'o duudeeka manjichcho isibaa idange; insa'nenna anga isixxa konne manjichcho'ni hana uggaashsha kadhante.<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />Yessuussinna konnee manjichcho ardiinxe oddonaa'ni qofittinni fulcheexxi; qubba ifixxa konne manjichchixxe mansha giddo uggeexxi; ookkonechchi uduma hancufa biciqeexxi; manjichchiinka arrabo tuqe. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Yessuussinna iimi'a uudeexxi jabaqicinni foo'leexxi, «Efitaahi!» tikatinna, «Banemi» hiyyoteni. <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />Hirbange'ni mansha banende; arrabi isikinna tikeme; qulleesseexxi haaso'ate'ni ke'e.<verse eid="MRK 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36" />Yessuussi tennee yaane mitteke'ninna kulabaashsha manna ajaje; kaddo malee isi haasoonnabaashsha ajajeemmaxxe qixxe'ni insa'ne yaane bira sa'issineexxi odeessina'nemani. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Ardikinna lomoqico mambe'a hiyyiyyoti. «Isi asseexxi yaane duuchchiinxi eloxen; mansha laqabaak laqaashsha; afo'o duudeeki haaso'aashsha midde asseen.»<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s1">Yessuussi Shoole Kuma Manna Itise</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mat. 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Ookkone wodda higgeenni heddi manni bukki hiyye. Insa'nenna indacho mittelchona afa gonpheemmaxxee; Yessuussi hordofeeyye ifibaa ye'eexxi; <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />«Kunni manni aninni welti sase barra tureemmaxxeenna indaachcho afa gopheemmaxxee kunni manni anee mararsa'neeni. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Insa'ne giddii'ni mitti mitti bayyi boganaa'ni dangeemmaxxee agabonni ifi ifike minibaa me'inaasha assonnole orake'ni shaqqine inbaan» insa'nee hiyye. <verse eid="MRK 8:3" /><verse number="4" style="v" sid="MRK 8:4" />Hordofeeyye isixxinna hiissiteexxi isoo, «Konne qiilla gammoojje'ni konne manni duuchchi'a itisatee geltaaxxi so'iinxa kebbonna habaa'ni afenda?» hite.<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Yessuussinna insa'nee «me'e so'iinxa kebbo afinee?» hiyye qore.</para>
  <para style="p" vid="MRK 8:5">Insa'nenna «Torbaane» hine hiissine. <verse eid="MRK 8:5" /><verse number="6" style="v" sid="MRK 8:6" />Isinna ardi ofo'laasha ajaje; eettene torbaane so'iinxa kebbo aadheexxi galateeffateechchi uduma shashshateexxi ardakee qoondaashsha hordofeeyyete'n uwwe. Insa'nenna ardakee qoonde. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Heenoxxi shiixxaramma qulxu'muwwa hexxemman; Yessuussinna qulxu'muwwa aadheexxi galateeffateechchini uduma hordofeeyye isixxi ardakee qoodo'a ajaje. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Ardi duuchchi ite godde; ookkonechchi uduma hordofeeyye isixxi indaa'na'a gatteexxa hamba torbaane qore wo'ma bukki assite. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Ookkonna shoole kuma geyaaki ardi hedhemman; isinna insa'nee geegeeseechchi udumi'a; <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Hordofeeyye ifixxenni welti Dalmanuuta hiyyemaake boonchibaa me'e.<verse eid="MRK 8:10" /></para>
  <para style="s1">Masuwwa Uudate'e Shiqeeka Qortuma</para>
  <para style="r">(<ref loc="MAT 16:1-4">Mat. 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Feerisitotinna daggeexxi Yessuussinni welti moromate'ni kexxe. Insa'nenna isoo hega uuddo'a hasseexxi iimi'ni mitte beessisa insa'ne'a leellishaashsha qorte. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Yessuussi hafuura gikki asse foo'leexxi, «Tinni ila mayee beessisa halsita'nelchi? Dhugaate hiyyaanneni; tenne ilaa mitti beessisi uwwemabaan!» hiyye. <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />Ookkonechchi uduma isi insa'nsa'nee waaleexxi hobolote'ni ofo'leexxi widi'a foofe.<verse eid="MRK 8:13" /></para>
  <para style="s1">Farisitotixxanna Heroodisixxa fuggo</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mat. 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Iitti hordofeeyye ita abixxa deetemmaxxee mitte so'iinxa kebbo malee hoboloti giddo mittelchonna affeemmabani. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Yessuussinna, «Ifi xexxe'atte, Feerisitotenaa'ninna Heeroodisixxe lebelenaa'n ifi heqqedhdhe!» hiyye.<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Insa'nenna weli'aan weli, «Isi no'o iitta hiyya'neechchiqa so'iinxa kebbo abixxa gonpheennaxxeten» hine. <verse eid="MRK 8:16" /><verse number="17" style="v" sid="MRK 8:17" />Yessuussinna insa'neeka heduma ege'neexxi; «So'iinxa kebbo afa gonpheennaxxeteni hitina'ni haassottina'neelchi mayeete? Ta'anna ha'no kassi hitinabaa? Qalbeeffatinabaa? Yookaani qalbe ha'nooxxi dillottee? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Ille affineenni hexxinee uudina'nebaa? Mansha affineenni hexxine laqqina'nebaa? Kassi hitina'nebaa? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Onde so'iinxa kebbo onde kuma manni'a shashshateenne wodda; me'e qore wo'ma hanba gatteexxa bukki assitine?» insa'nee hiyye. Insa'nenna, «Tommenna lame qoremman» hine.<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />«Iittanni torbaane so'iinxa kebbo shoole kuma manni'a kukkutenne wodda; me'e qore hanba gatteexxa bukki assitine?» insa'nee hiyye.</para>
  <para style="p" vid="MRK 8:20">Insa'nenna iso'ni «Torbaane» hine hiissine.<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Isinna insa'nee, «Ta'anna kassi hitineeba hiyyotee?» insa'nee hiyye.<verse eid="MRK 8:21" /></para>
  <para style="s1">Beetesayida'ni Ila Afebaake Manjichchixxa Fayya</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Ookkonechchi uduma insa'ne Beete Sayida dange, heenoki manni ille ba'eeka mitte manjichcho Yessuussibaa idangeexxi angati qaqqabaashsha kadhante. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Isinna konne ille ba'eemmake manjichchixxa anga abideexxi olla'i gadho fulche manjichchiinxe ille'ni hancufa tufeexxi angatanna iso'ni hana uggeexxi, «Maachcho ate'ni leella'neechchi hedhe?» hiyyeexxi isoo qore.<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />Isinna toggi hiyye uudeexxi, «Manni haqqetishsha lele'maa'naa uudaannen» hiyye. <verse eid="MRK 8:24" /><verse number="25" style="v" sid="MRK 8:25" />Higgenni Yessuussi manjichchinxe ille'ni hana anga ugge; ookkone wodda manjichchi dhaphphi hiyyeexxi uude; isinna fayyeexxi duuchchiinxa yaane qulleesseexxi uudate'ni ke'e. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Ookkonechchi uduma Yessuussi, «Manjichcho olla'i giddi'a e'yitoxxe, olla'i giddonna ayye'ninna kuldoxxe'e» hiyyeexxi ifike minibaa geegeesse.<verse eid="MRK 8:26" /></para>
  <para style="s1">Pheexiroosi Yessuussixxee Afeemmaxxa Ege'na</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mat. 16:13-20</ref>; <ref loc="LUK 9:18-21">Luq. 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Yessuusinna ifixxe hordofeeyyenni welti Filphoosi Qiisaariya olla'uwwibaa me'e; insa'nenna orange'ni he'nee'naa hordofeyyetanna: «Manni Anee ayyete hiyya'ne?» hiyyeexxi insa'nee qore.<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />Insa'nenna, «Mitti mitti cuuphaammake Yohaannisiten hiyyaakiiri hedheen; weli kinni Atee Eelyaasiten hiyya'neeni, weli kinni wabeekoleti giddii'ni mittekeni hina'neeni» hineexxi iso'ni hiissine. <verse eid="MRK 8:28" /><verse number="29" style="v" sid="MRK 8:29" />Higgeenni Yessuussinna insa'nee, «Ha'nota Anee ayyete hitina'ne?» hiyyeexxi qore. Pheexiroosinna, «Ati Kiristoositen» hiyye. <verse eid="MRK 8:29" /><verse number="30" style="v" sid="MRK 8:30" />Yessuussinna insa'ne'nee isixxee ayye'ninna haasoonnabaashsha xexxe'achchiise.<verse eid="MRK 8:30" /></para>
  <para style="s1">Yessuussi Reyeexxi Ke'aaxxa Taakkaxxa Haaso'e</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mat. 16:21-28</ref>; <ref loc="LUK 9:22-27">Luq. 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />«Manjiiki Belti heddo rakko adhdhaan, geedhuwate'ni, Qeesoletike akeekisanjuwa'ni, Muusseke seerixxe barsiisano'ni shiyemaan, sase barra uduma rewotena'ni ke'a hasissaan» hiyya'ni insa'ne'ni barsiisate'ni ke'e. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Isinna tennee yaane insa'ne'ni farri asse kule. Eettenee yanna Pheexiroosi Yessuussii qofitti adhdhe me'eexxi xixe. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />Yessuussi kinni wirri hiyyeexxi hordofeeyye ifixxa uuda'ni Pheexiroosii, «Ati duriissa anenaa'ni udumi'a higi!» isinna hiisseexxi «Ati manjiinxa malee Mageniinxa yaane heddaabexxoni» hiyye isoo xixe.<verse eid="MRK 8:33" /></para>
  <para style="s1">Yessuussii Hordofatee Hasisaaka Tolcha</para>
  <para style="r">(<ref loc="MAT 10:38-39">Mat. 10:38-39</ref>; <ref loc="MAT 16:24-28">16:24-28</ref>; <ref loc="LUK 9:23-27">Luq. 9:23-27</ref>; <ref loc="LUK 14:25-27">14:25-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Ookkonechchi uduma Yessuussi arda ifixxe hordofeeyyenni welti ifibaa ye'eexxi, «Anee hordofatee eeyyaaki hedhoole ifi hunowwaal; fanno ifixxa dulkeexxi anee hordofowwaal; <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />hedho ifixxa anjiratee eeyyaaki duuchchi hedho ifixxannxa balleessaani; anxenna eloxxe odoxxee hedho ifixxa balleessaaki duuchchi kinni hedho ifixxa anjiraani. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Manji butta tennee duuchcha ifixxe assedhe'e lubbo ifixxa balleesseexxe kaddoole; isi'a maa la'oonda? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Manjingi lubbo ifixxa wodo'a maa hira uwwiyyo dande'a? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Tenne amana gibba'neekixxenna cubbaaleeyye ilaxxe oddo'ni Ane'ninna hiyyichcho Anke'ni shookaaki duuchchi; Manjinki Belti ifike annike ulifinninna iimixxe woyyoole Ergannanni welti dagaa wodda; iso'ni shookaani» insa'ne'a hiyye.<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Lebeexxi Yessuussi insa'ne'a, «Dhugaate hiyya'enneni; Mageniinxi mootumma lumooxxe hunnanni daggaa'naa uundaaqico'ni ta'a kaba butta hedheeke mannixxe oddonaa'ni mitti mitti reyabaakera hedheeni» insa'ne'a hiyye.<verse eid="MRK 9:1" /></para>
  <para style="s1">Yessuussixxi Bifa Jijjiirendeexxa</para>
  <para style="r">(<ref loc="MAT 17:1-13">Mat. 17:1-13</ref>; <ref loc="LUK 9:28-36">Luq. 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Jaane barra uduma Yessuusi Pheexiroosii, Ya'iqoobinna Yohaannisii'i adhdheexxi mitte qerraaxxe koobaba qabate; insa'nenna qofittinni he'nemman; bifa isixxinna insa'ne edo jijjiirende. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />Yessuussixxi seemmanna fedheeki manji borce ca'a assa dande'abaqico'ni hara golalooxxe kadde. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Ookkoo Eelyaasinna Muuse Yessuusinni welti haasoonna'ni insa'ne'a leelline.<verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />Pheexiroosinna Yessuusii'i, «Barsiisanjo no'oke kabanni he'nennele no'o'a eloxxeni. Tennexxee mitte fooqa ati'a, mitte Muuse'a, mitte Eelyaasi'a kadaaka sase fooqa ijaarro!» hiyye. <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Insa'ne yo'osha sodaanteemmaxxee; Pheexiroosi haaso'a'neexxa ege'naammabaan.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Ookkonechchi uduma duumanchi dageexxi insa'nee golle; duumanchi giddii'ni, «Kunni ani eeyyannok anke beltoni; isi hiyyaaxxa laqqe!» hiyyaaki hafuuri laqeme.<verse eid="MRK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8" />Insa'nenna hirbange'ni qarqara ifika wirri hinne uundee wodda; Yessuusii malee'e insa'nenni welti ayyinna hedhemmabaa.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Insa'nenna koobatenaa'ni dirrina wodda, Yessuussi insa'ne'ni Manjiinki Belti rewotenaa'ni ke'aqico'ni tenne uuddineexxa yaane mitteke'ninna kuldinoqqe'e hiyye ajaje. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />Insa'nenna Isi haaso'eemmak hiyyichcho godoba galche'ne; yaane kinni «Rewotenaa'ni ke'a» maa hiyyote kaddeexxa weli'anni weli haasona'nemman. <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />Insa'nenna; «Muuseke seerxi barsiisano mayeete edisse Eelyaasi daga'neeni hita'neeki?» hine isoo qorte. <verse eid="MRK 9:11" /><verse number="12" style="v" sid="MRK 9:12" />Yessuussinna insa'nee; «Dhugaate, Eelyaasi edise dageexxi duuchchiinxa yaane edo hexxemmashshanni assaan; kaddo malee, Manjiinki Belti lumoxxa rakko adhdhaaxxanna tuffatemaaxxa borreesendeechchi mayeete ha'no labba'ne? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Yaane kinni Ani ha'no'a hiyyaanneni; Eelyaasiqqa ediseenni dageemmani; mannikinna isixxee borreesendemmashshanni insa'nee hanseexxa duuchcha iso'ni asseeni» insa'ne'a hiyye.<verse eid="MRK 9:13" /></para>
  <para style="s1">Fuggichchi Hafuurini Abidemeek Belt Fayyise</para>
  <para style="r">(<ref loc="MAT 17:14-21">Mat. 17:14-21</ref>; <ref loc="LUK 9:37-43">Luq. 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Insa'nenna gatteexxe hordofeeyyebaa hinge dangee wodda; heddi ardi insa'nee buqe Muuseke seerixxi barsiisanuwwa eettenee gatteemmaxxe hordofeeyenni welti moroondaa'naa uunde. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Ardi duuchchi Yessussii uudee wodda mambe'a hiyyeexxi nage'a aa'no'a isibaa gongine. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />Yessuussinna, «Insa'nenni welti morondinaammaki mayiinxeteemma?» hiyye qore. <verse eid="MRK 9:16" /><verse number="17" style="v" sid="MRK 9:17" />Ardiinxe oddonaa'ni mitti manjichchi isoo hiyyeeqici; «Barsiisanjo; fuggichchi hafuuri giddo galee'naa afo'o duudeeka anka belto Atibaa idageennani; <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />kunni hafuuri ke'issedhaa wodda duuchcha isoo ibisaani, afo'okenaa'ninna honba yaasaani; isso ifixxanna qaraani, bisi isikinna bagaani; konnee fuggichcha hafuura fulchitaashsha hordofeeyye atixxa laqenneni; yaane kinni insa'ne dandeennebaani» hiyye.<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Yessuussinna insa'ne'a hiisseexxi; «Ha'no amandinabaaxxe ila! Haaniqico'ni Ani ha'nonni welti hedhanno? Haaniqico'nita ha'noo ossano? Ookkonne belto Anibaa idagge!» hiyye. <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Mannikinna ookkonee belto Yessuussibaa idage; fuggichchi hafuurinna Yessuussii uudee wodda; belto hirbange'ni butta ganganlche; beltikinna buttinake'ni ibeexxi gangalata'ni honba yaasate'ni ke'e. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />Yessuussi beltiinka anna; «Tinni dhibo abiddeexxenni hitteexxe yanna?» hiyye qore. Annikinna; «Oosummandenaa'niteni; <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />isoo shiwo'a haseexxi heddo yanna giirate'ninna wode'eke'ni ibisaani; yaane kinni ati dandeettattole ballo'o no'o'a mararte'e no'o gargaari!» isoo hiyye. <verse eid="MRK 9:22" /><verse number="23" style="v" sid="MRK 9:23" />Yessuusinna; «Mayee dandeessissa'noole hitatto? Amanaake manji'a duuchchiinxi yaane dandeesissaan» isi'a hiyye. <verse eid="MRK 9:23" /><verse number="24" style="v" sid="MRK 9:24" />Hirbange'ni beltiinki anni raara'ni, «Ani amanaannen; amana gopha anxee anee gargaari!» hiyye. <verse eid="MRK 9:24" /><verse number="25" style="v" sid="MRK 9:25" />Yessuusi ardi ookko'a raanka'ni isibaa dagaa'naa uudee wodda; «Ati mansha laqqabexxokinna afo'o duuddeetteki hafuuri isonaa'ni fuli! Konnechchinni udumi'a iso'ni higgabexxoshsha atee Ani ajajaannen!» hiyye fuggichcha hafuura xixe. <verse eid="MRK 9:25" /><verse number="26" style="v" sid="MRK 9:26" />Fuggichchi hafuurinna raara'ni belto fuggo gangalcheechchi uduma beltokena'ni fule; heddi manni «Belti reyedheen» hinaaqico'ni belti reyeechchishsha kade. <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Yaane kinni Yessuusi beltiinxa anga abideexxi ke'isse; beltikinna ke'e uurre.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Yessuussi mini'a e'yee wodda hordofeeyye isixxi qofittinni; «Konnee fuggichcha hafuura no'o fulchatee dande'a gonpheennelchi mayeete?» hiteexxi isoo qorte. <verse eid="MRK 9:28" /><verse number="29" style="v" sid="MRK 9:29" />Yessuussinna, «Iitta hedheeki fuggichchi hafuuruwwi fula dande'aak soodachchoti callan» hiyye insa'ne'a haaso'e.<verse eid="MRK 9:29" /></para>
  <para style="s1">Yessuussi Reyeexxi Ke'aaxxa Langaxxa Haaso'e</para>
  <para style="r">(<ref loc="MAT 17:22-23">Mat. 17:22-23</ref>; <ref loc="LUK 9:43-45">Luq. 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Insa'nenna ookko'ni ke'neexxi Geliila darreee'ni sa'ne; Yessussinna insa'nee hebeka booncho ayyinna ege'no'a hasebaan; <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />Isinna hordofeeyye ifixe'ni «Manjiinki Belti manniinxe anga'ni sa'isseme uwwemaani; insa'nenna isoo shinnaani; isinna sakkaxxe barra uduma ke'aan» hiyya'ni insa'nee barsiisaammani. <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Hordofeeyete'ni tennee yaane qalbeeffateemmabaani; insa'nenna isoo qorrummaxxe'e sodaante.<verse eid="MRK 9:32" /></para>
  <para style="s1">Duuchiingenaa'ni sa'aaki Ayyete?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mat. 18:1-5</ref>; <ref loc="LUK 9:46-48">Luq. 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Insa'nenna ookkonechchi uduma Qifirnahoomi'a dange. Yessuussinna mine e'yeechchi uduma; «Woldo orake'ni weli morondinaammaxxi yaane maachchomma'a?» hiyye insa'nee qore.<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />Insa'ne kinni orake'ni morommaammalchi duuchchiingenaa'ni sa'aaki ayyete hina'nemmaxxee sammi hine. <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />Yessuussinna ofoleechchi uduma tommenna lamiinxa ifibaa yeexxi; «Siretike kado'a hasaaki; duuchchiingenaa'ni udu'meekenna duuchchiingike erganjo kadowwaal» hiyye. <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />Isinna insa'nee shiixxoka belto aadheexxi oddo insa'neexxe'ni uurrise; belto konnee luu'meexxi; <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />«Iitta hexxeexxe shiixxaramma annoolenaa'ni mitte anke summinni adhdhaaki duuchchi; anee adhdhaani; aneenna adhdhaaki duuchchi kinni adhdha'neeki anete kaddebaaki anee ergeemmake adhdhaani» hiyye.<verse eid="MRK 9:37" /></para>
  <para style="s1">No'o Gareeraak No'onni Hedheekeni</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luq. 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Yohaannisi Yessuussii, «Barsiisanjo! Mitti manjichchi summa atikenni fuggichcha hafuura fulchaa'naa uundeenneni; yaane kinni isinna no'o hordofa gopheemmaxxee hoyyineenneni» hiyye. <verse eid="MRK 9:38" /><verse number="39" style="v" sid="MRK 9:39" />Yessuusi kinni, «Waalle hoyyitinoqqe summa ankenni mambe'a huje'e iikki woddi ane'ni elobaaxxa haaso'a dande'aaki hedhebaani; <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />no'oo gareeraaki no'onninni hedheekeni; <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />dhugaate ha'no'a hiyyaanneni: ha'no Kiristoosike kaddineemmaxxee mitte qasha wodde'e Anke summinni ha'no'a uwwaaki duuchchi: hira ifka gophabaani» hiyye.<verse eid="MRK 9:41" /></para>
  <para style="s1">Welekee Gufote Kadatixxa</para>
  <para style="r">(<ref loc="MAT 18:6-9">Mat. 18:6-9</ref>; <ref loc="LUK 17:1-2">Luq. 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />Yessuussinna lebeexxi hiyyee qici, «Ane'ni amanaake konne shiixxarammanaa'ni mitte dedhisaaki duuchchi lumoki daammiinki kinji gooba isike'ni usuremee'naa abbaayyate'ni hunemeel isi'a eldammani. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Tennexxee anga atixxi atee dedhissoole; isee kutte huni! Lame anga affe'e gaanametixxe giirabaa me'ati irra tutumake kadde hedhotibaa e'ya ati'a woyyani. <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />(Gaanemi'ni corroqa isixxi retaba: giira isixxi xoxxabaabani.)<note caller="+" style="f"><char style="fr" closed="false">9:44 </char><char style="ft" closed="false">Sirtike addatemek mirqisanjo maxaafa'ni kunni yaadi afemabaan. </char></note> <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Lekka atixxi atee dedhissoole; isee kutte huni! Lame lekka affe'e gaanamete'ni hunemati irra; naafake kadde hedhotibaa e'ya ati'a woyyani. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />(Gaanemi'ni; corroqa isixxi rertabaa; giira isixxi xoxxabaan.) <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Ille atixxi atee dedhissoole; isee fulchitettexxi huni! Lame ille affe'e gaanamete'ni hunemati irra mitte ille affe Mageniinxe mootumma'ni aaga ati'a woyyani. <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />Gaanemi'ni</para>
  <para style="q1" vid="MRK 9:48">«Corroqa isixxi rertaba'a;</para>
  <para style="q1" vid="MRK 9:48">giira isixxi xoxxaba'a.<verse eid="MRK 9:48" /></para>
  <para style="m">
    <verse number="49" style="v" sid="MRK 9:49" />Manji duuchchi giirati hega uudemaan.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />«Maxxine eloochchoni; yaane kinni maxine bushsheexxi xe'me isexxa gophphoole; mayiki xe'mitaashsha assitina? Ha'noo giddo maxinetixxi xe'me hexxowaali! Ha'no weli aaggine nage'iki hedhdhe.»<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s1">Aretixanna Aro'iinxa Weli Tika</para>
  <para style="r">(<ref loc="MAT 19:1-12">Mat. 19:1-12</ref>; <ref loc="LUK 16:18">Luq. 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Yessuusi ookko'n ke'eexxi Yihudake bogibaanna Yordanoosike galaani wido hedheeke boonchibaa me'e. Ardikinna higgeenni isike qarqara'ni bukki hiyye; isinna konneechchi edo assaammashshanni insa'nee barsiise. <verse eid="MRK 10:1" /><verse number="2" style="v" sid="MRK 10:2" />Feerisitotinna isiba shiqqeexxi; «Manji ifixxa are tika hasissaa?» hine isoo hega uundo'a qorre. <verse eid="MRK 10:2" /><verse number="3" style="v" sid="MRK 10:3" />Yessuussinna insa'nee; «Muuse ha'noo maa hiyyee ajaje'e?» hiyye. <verse eid="MRK 10:3" /><verse number="4" style="v" sid="MRK 10:4" />Ookkonechchi uduma insa'nenna «Muuseqqa tika ege'nishshaaxxa borro uwweexxi isee tiko'a ajajeen» hine. <verse eid="MRK 10:4" /><verse number="5" style="v" sid="MRK 10:5" />Yessuusinna insa'nee hiyyee qici; «Muuse konne seera ha'no'a borreeseechchi qalbe ha'nooxi jabaxxe kaddemmaxxeeten. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Yaane kinni siretixxe dadanaa'ni safeexxi; Mageni labbakenna meyyaxxe asse insa'nee dade. <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />Tennexxee manji anna ifikanna ama ifixxa waaleexxi are ifixxini welti mitteke kandaan. <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />Insa'ne lamiingi mitte kandaani; ta'inni edi'a yoona insa'ne mitte biso malee lamekebaan; <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />tennexxee Mageni mitteba gudunfeeka; manji gargarti hiissoqqe» hiyye.<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Insa'nenna higgeenni mini'a e'yinee wodda; hordofeeyye isixxi tenne yaanxee isoo qorite. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Isinna; «Are ifixxa tikeexxi wele mellaale aadhaaki are isixxi hedhoti hexxemmaxxee isi yabaabuleeni hiyyoteni. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Iittanni isenna aro'o iseka tikkeexxi wele labballo'ni heerundoole yabaabuldaan» hiyyoten.<verse eid="MRK 10:12" /></para>
  <para style="s1">Yessuussi Oose Eebbisse</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mat. 19:13-15</ref>; <ref loc="LUK 18:15-17">Luq. 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Yessuussi angati qaqqabaashsha manni oose isibaa idage: hordofeeyye isixxi kinni oose idaggeemmaka manna xixxe hoyyite. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Yessuusi tennee uudee mufateexxi ifixxa hordofeeyye hiyyee qici «Oose anibaa dagguuni: insa'nee hoyyitinoqqe'e: Mageniinxi mootumma iitta insa'neeshsha hedhakixxeni. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Dhugaate ha'no'a hiyyaanneni: Mageniinxa mootumma oosetishsha kadeexxi adhdhabaaki duuchchi: Mageniinxe mootumma'ni hara e'yabaani» hiyye. <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Isinna ettenee oose lu'medheexxi anga ifixxanna insa'ne'ni hana uggeexxi eebbise.<verse eid="MRK 10:16" /></para>
  <para style="s1">Mitte Dureessa Manjo</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mat. 19:16-30</ref>; <ref loc="LUK 18:18-30">Luq. 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Yessuussi ookkoo'ni ke'eexxi me'a'neenge'ni, mitti manji isibaa gonga'ni dage: isi edo guluffateexxi, «Eloke barsiisanjo! Duuchchi woddixxa hedho alfonaa ani'a maa assiyyo hasissa?» hiyye isoo qore. <verse eid="MRK 10:17" /><verse number="18" style="v" sid="MRK 10:18" />Yessuusinna, «Mayee anee eloke hitatto? Mitte Mageno malee eloki hedhebaani: <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />atinna ajajuwwa egendeetteni: shiltoxxe'e, yabaabuldoxxe'e, moortoxxee, dhariki dhugaa kuldoxxe'e, dassitoxxe'e, anna atikanna ama atixxa ulifeesi» hiyye hiisse'e iso'ni haaso'e. <note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">Fula. 20:12-16</ref>; <ref loc="DEU 5:16-20">Lan. 5:16-20</ref>. </char></note> <verse eid="MRK 10:19" /><verse number="20" style="v" sid="MRK 10:20" />Manjichchikinna iso'ni, «Barsiisanjo konnee ajajuwwa duuchcha oosumandenaa'ni heqqedheeneni» hiyye. <verse eid="MRK 10:20" /><verse number="21" style="v" sid="MRK 10:21" />Yessuusinna isoo uudeexxi eeyye: «Yoona mitte yaane ati'a xe'yiteen: marte affetelcho duuchcha gurgurtettexxi hiyyeeyyetee uwwi! Atinna iimate'ni tuulendeexxa karra affatooni. Isinna ookkonechchi udumi'a dagge anee hordofi» hiyye.<verse eid="MRK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 10:22" />Manjichchikinna tennee laqee wodda yo'oshsha yaade: isinna lumoxxa karra afeemmaxxee yaada'ni me'e. <verse eid="MRK 10:22" /><verse number="23" style="v" sid="MRK 10:23" />Yessuusi elqe kayya uuda'ni hordofeeyye ifixe'ni, «Dureeye Mageniinxa mootumma e'ya hitta tatta a'urtaaxxe!» insa'ne'ni hiyye. <verse eid="MRK 10:23" /><verse number="24" style="v" sid="MRK 10:24" />Hordofeeyye isixxinna konne isike haaso'a'ni mambe'a hite: Yessuusi kinni higgeenni lebeexxi insa'nee, «Tee oose! Mageniinxe moottumma'ni e'ya hitta ttaa a'urta! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Dureesi maniinji Mageniinxe mootumma'ni e'yati irra gaali marfetike qo'i giddii'ni sa'a shollexxaani» hiyye. <verse eid="MRK 10:25" /><verse number="26" style="v" sid="MRK 10:26" />Hordofeeyye isixxinna weli'ann weli saaddeexi, «Yoona ayyete anjirema dande'a?» hite. <verse eid="MRK 10:26" /><verse number="27" style="v" sid="MRK 10:27" />Yessuusinna insa'nebaa uudeexxi, «Tinni Magenoke'nite malee manjin darree'ni dandeessissabaan: Magenokee kinni duuchchinxi dandeessiissaani» insa'ne'ni hiyye. <verse eid="MRK 10:27" /><verse number="28" style="v" sid="MRK 10:28" />Pheexiroosinna isoo, «Kunni no'o duuchchiinxa yaane waaleennexxi atee hordonfeenneni» hiyye. <verse eid="MRK 10:28" /><verse number="29" style="v" sid="MRK 10:29" />Yessuusinna hiisseexxi, «Ani dhugaate ha'no'a hiyyaanneni; anxeenna eloxxe odoxxe hiyyeexxi mine yookaani dayyuwwakanna dayyuwwa yookaani ama yookaani anna yookaani oose yookaani fichcha waalaaki duuchchi: <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />ta'a konne baro'ni midde shorremat welti minuwwa, dayyuwwa kanna dayyuwwa amuwwa, oose, fichcha waalaaki dhibba dachcha'a adhdhabaaki dagake baro'ninna duuchchi woddixxa hedho alfaabaaki manji hedhebaan. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Yaane kinni ta'a ediseeki udu'maan; ta'a udu'meeki kinni edisaan» hiyye.<verse eid="MRK 10:31" /></para>
  <para style="s1">Yessuussi Reyeexi Ke'aaxa Sakkaxxa Kule</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mat. 20:17-19</ref>; <ref loc="LUK 18:31-34">Luq. 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Insa'nenna Iyyerusaalemi'a me'aammake ora'ni he'nee'naa'a, Yessuusi hordofeeyye isixxi edo me'a'nemmani: insa'nenna mambe'a hine; weli isoo hordofaammakiir sodaateemmani. Higgeenna isi tommenna lamiinga ardi giddi'ni gargar hiisseexxi iso'ni geltaaxxa yaane insa'ne'a kula'ni hiyyee qic, <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />«Yoona Iyyerusaalemi'a qabantaanneni: Majiinki Belti qeesoletike akeekisanjuwwa'ninna Muuseke seerixxe barreessano'ni sa'isseme uwwemaani: insa'nenna rewotixxa murte iso'ni murraani: Yihudoota kadebaake manna'ni isoo sa'isine uunaani: <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />Isoo gacifantaan, iso'ni hancufakanna tunfaani, isoo jadhanfaani, ookko'ninna isoo shinnaani: isi kinni sakkaxxe barra uduma ke'aani» hiyye.<verse eid="MRK 10:34" /></para>
  <para style="s1">Ya'iqoobikanna Yohaannisika Qortuma</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mat. 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Ookkonechchi uduma Zebidewoosixxi labbaxxi oose Ya'iqoobinna Yohaannisi isiba shinqeexxi, «Barsiisanjo, Atee kadhantaaneexxa duuchcha no'aa assitotta'a hansaanneni» hine. <verse eid="MRK 10:35" /><verse number="36" style="v" sid="MRK 10:36" />Isinna insa'ne'ni hiisseexxi, «Maa assonnaa hassina'ne?» hiyye. <verse eid="MRK 10:36" /><verse number="37" style="v" sid="MRK 10:37" />Insa'nenna isoo, «Moottumma Atixxe'ni, mitti no'oki midda Atike'ni; mitti no'oki bita'a atike'ni ofollannoshsha no'o'a eetii uwwi» hine. <verse eid="MRK 10:37" /><verse number="38" style="v" sid="MRK 10:38" />Yessuusi kinni insa'nee, «Kadhatina'neexxa egendinebaani; ani ha'wanoxxe buudanaa'ni ha'witino'a, ani cuuphemaannexxa cuuphensha ha'no cuuphema dandeettinaa?» hiyye. <verse eid="MRK 10:38" /><verse number="39" style="v" sid="MRK 10:39" />Insa'nenna isoo, «Eeti dandeenannoni» hine. Yessuusi insa'nee hiyyee qici, «Ani ha'wannoxxe buudanaa'ni ha'witinani: Ani cuuphemaannexxa cuuphensha ha'nonna cuuphendinaani. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Yaane kinni midda anke'ni yookaan bita'a anke'ni ofo'laaki bakka iitti qixxesendeekiri'ate malee uwwannoki antebaan» hiyye.<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Gatteexxi tomme hordofeeye Ya'iqoobi'ninna Yohaannisi'ni mufatte. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Yessuusi kinni insa'nee duuchchiinga mitteba ifiba bukki asse'e hiyyee qici, «Mageno ege'nebaake ardiki akeekisanjuwwi ardiinke galchalluwwa hiyyemme'e ye'emaaxanna insa'neeki akeekisanjuwwi insa'ne'ni baallooma anfeexxa ha'no egendineen. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Ha'nooxxe oddo'ni kinni iittatebaan: ha'nooxxe odd'ni lumoke kado'a hasaaki duuchchi ergatemaake kadowwaal. <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />Iittani ha'nooxxe oddonaa'ni sa'eeke kado'a hasaaki duuchchi duuchchiingike garba kadowwaali: <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Manjiinki Belti dageechchi, ergatemo'anna heddi manni'a wodote kado'a dagee malee; isi'a erigatemmo'a dagebaan» hiyye.<verse eid="MRK 10:45" /></para>
  <para style="s1">Yessuussi Ille Ba'eemaka Barxemewosi'i Fayyise</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mat. 20:29-34</ref>; <ref loc="LUK 18:35-43">Luq. 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Ookkonechchi uduma insa'ne Iyyarkoke qachchibaa dange. Yessuussinna hordofeeyye isixxi heddi ardinni welti Iyyaarikoo'ni fulla'neengge'ni; ille ba'eeki Xemewoosik belti Berxemewoosi orake'ni ofo'le kadhata'nemmani. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Ookko'ni sa'a'neek Naazireetike Yessuusi kadeexxa laqee wodda, «Daawwitike belto Yessuussi ballo'o; ani'a marari!» hiyya'ni raare. <verse eid="MRK 10:47" /><verse number="48" style="v" sid="MRK 10:48" />Heddi manni sammi hiyyi hina'ni xinxe: isi kinni, «Daawwitike belto ballo'o ani'a marari!» hiyya'ni woldi irra raare. <verse eid="MRK 10:48" /><verse number="49" style="v" sid="MRK 10:49" />Yessuusinna uurreexxi insa'nee, «Isoo ye'we!» hiyye. Insa'nenna ille ba'eemmaka manjiichcho, «Mee co'o ke'i! Atee ye'a'neeni!» hine. <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />Isinna seemma ifixxa huneexxi utaale ke'eexxi Yessuusibaa dage. <verse eid="MRK 10:50" /><verse number="51" style="v" sid="MRK 10:51" />Yessuusinna isoo, «Maa ati'a assonnaa hassaatte?» hiyye. Ille ba'eemmakinna, «Barsiisanjo afonnaa hasaannen!» hiyye. <verse eid="MRK 10:51" /><verse number="52" style="v" sid="MRK 10:52" />Yessuusinna isoo, «Misiyyi! Amana atixxi atee fayyisse'eni» hiyye. Iikki woddi ille afate'e dande'e: isinna Yessuussixxa duuka hordofa'ni me'e.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s1">Yessuussi Lumoke Ulfinninni Iyyerussaalemi'a E'ye</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat. 21:1-11</ref>; <ref loc="LUK 19:28-40">Luq. 19:28-40</ref>; <ref loc="JHN 12:12-19">Yoh. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Insa'nenna Iyyerusaalemi'a shinqee wodda Debrezeyitixxe kooba bira hexxeexxe Beetefaagenna Biitaaniya gennee wodda Yessuusi ifixxe hordofeeyye giddi'ni lame hiyye ergee qici: <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />«Ha'no edi darre hedheeke ola'ibaa me'e! Ookko'o geltineeshshanni hirbange'ni huuni manji ofo'lebaaka harretika beltanjo usuremee'naa affinaani: isoo tikkineexxi idagge! <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Huuni manjinna: ‹Maassitino'aate?› ha'no hiyyoole: ‹Goottakee hasissaammaxxeeteni; isinna hirbange'ni isoo wirri asse hiissaan!› hiyyee hitine kulle» <verse eid="MRK 11:3" /><verse number="4" style="v" sid="MRK 11:4" />Insa'nenna me'ineexxi mine mitteke hula'ni orake'ni harretik beltanji usuremee'naa anfeexxi tinke. <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />Ookkoo uurreemmake manni giddii'ni mitti mitti insa'nee: «Beltanjo mayeete tikkina'neek?» hine. <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />Hordofeeyye isixxinna Yessuusi insa'ne'n hiyyeemmaxxa mannake'n kulde: mannikinna eeti insa'ne'a uwwe. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Hordofeeyetinna ookkone harretika beltanjo Yessuusibaa iyyedangeexxi seemma ifi ifixxa haratike beltanjiinke dudduro'n hana uggine: Yessuussinna iso'ni hana ofo'le. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Heddi manni ifi ifixxa seemma orake'ni fayeemmaani: welkinna haqichchinka shafa enqa'ni fayyaamman. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Isi edii'ninna me'aammakirinna isi udumii'ni hordofaammakiir hafuura gikki assine: «Hoosa'inna! Goottiinke summinni dagaaki eebbisemeekeni! <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />Gootiinke summinni dagga'neexxi anni no'okixxi Daawwitixxi moottumma eebbisendeexxeni! Hoosa'inna ale iima!» raarra'emman.<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Yessuusi Iyyerusaalemi geye; Woyyichchi Galmi giddi'aa e'ye: isinna loolake'ni hexxeexxa yaane duuchcha uude: bogi hashsheemmaxxee tommenna lame hordofeeyye isixxenni welti Biitaaniya'a me'e.<verse eid="MRK 11:11" /></para>
  <para style="s1">Yessuussi Yowweeka Odi'inka Haqichcho</para>
  <para style="r">(<ref loc="MAT 21:18-19">Mat. 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Insa'nenna gorsa Biitaaniyii'n fullee wodda Yessuussi solo'we. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Isinna shafi caallika odi'inka haqichcho bayyii'ni uudeexxi akimagaada gummate alfannoni hiyya'ni odi'inke haqichiinbaa mare: yaane kinni odi'i gummisabaxxe yanna kada gophpheemmaxxee shafa malee mittelchonna ise'ni afebaani. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Isinna ookkonechchi uduma ookkone odi'iinka haqichcho: «Techchinni edi'a duuchchi woddi'a fedheekinna gumma atenaa'ni itoqqe'e!» hiyye.</para>
  <para style="p" vid="MRK 11:14">Isinna tennee haaso'a'naa isixxi hordofeeyyenna laqqe.<verse eid="MRK 11:14" /></para>
  <para style="s1">Yessuussi Woyyichchi Galmi Giddo Mootomeexxa Mootoma</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mat. 21:12-17</ref>; <ref loc="LUK 19:45-48">Luq. 19:45-48</ref>; <ref loc="JHN 2:13-22">Yoh. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Insa'nenna Iyyerusaalemi'i genne wodda Yessuusi Woyyichchi Galmi giddi'a e'yeexxi ookko'o hidhdhammakanna gurgudhdhaammaka manna fulchate'ni ke'e. Maallaqa jijjiidhdha'neeka mannanna guuggenjuwwa gurguraammake mannika beera gonbise. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Isinna fedheeki manji miya dulkeexxi Woyyichchi Galmike dalla'i giddii'ni sa'abaashsha hoyye. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Iyyessuussinna barsiisaamma wodda insa'nee: « ‹Mini anki gosa gosak ardi duuchchi Mageno soodantaake mine hiyyemaan!› hiyyende borreesendeebaa? Ha'no kinni moodhalshetixxe wolo'o assitineeni!» hiyye. <verse eid="MRK 11:17" /><verse number="18" style="v" sid="MRK 11:18" />Qeesoletiki akeekisanjuwwinna Muuseke seerixxi borreessano, tennee laqqee wodda hitta assine isoo shinnaaka mala, malate'ni ke'ne: ardi duuchchi barsiisa isixxa saadeemmaxxee insa'nenna isoo shiyatee sodaate. <verse eid="MRK 11:18" /><verse number="19" style="v" sid="MRK 11:19" />Yessuussinna isixxi fordofeeyye hashshaa wodda ookkone qachchi giddii'ni fulle me'ine.<verse eid="MRK 11:19" /></para>
  <para style="s1">Odi'inke Haqichchixxa bange</para>
  <para style="r">(<ref loc="MAT 21:20-22">Mat. 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Insa'nenna langa baro gorsa ora ookkonee sa'naa wodda iikki odi'inki haqichchi hiddinginni bagee'na uunde. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Pheexiroosi kassi hiyyeexxi Yessuussi'i: «Barsiisanjo! Ati Yowwitetteki odi'inki haqichchi bage'een!» hiyye. <verse eid="MRK 11:21" /><verse number="22" style="v" sid="MRK 11:22" />Yessuusinna higgeenn insa'nee: «Ha'no Magenoke'ni amanne! <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Dhugaate ha'no'ni hiyyaanneni: fedheeki manji tennee kooba ‹Kabaa'ni kexxe abbaayya giddi'a darbemi› hiyyoolenna tenne qalbe ifixxexenni mamibelo amannoole isi'a kaddaani. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Tennexxee soodachchoti heenee yaanenna kadhattinoole ha'no'a muuxenedeeshsha assitine amanne; kadhattinaachchi duuchchi ha'no'a uwwendaan. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Iittanni ha'no soodachchotee kexxinaa wodda, iimik ha'nook Anni cubbo ha'nooxxa ha'no'a gattowwaali hiyyaashsha, ha'nonna manijoke'ni affineexxa kajjo gattowwal hiyye. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />Yaane kinni ha'nonna weliinxa balleessa gattowaali hiyya gophphinoole: iima hedheeki ha'nooki Anni ha'nooxxa balleessa gattowwaali hiyyabaani»<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">Mitte mitte addatemeeke miriqisanjo maxaafa'ni kunni lami tommanna jaan laakosi afemabaan</char></note> hiyye.<verse eid="MRK 11:26" /></para>
  <para style="s1">Yessuussike Baaloomixxee Shiqeeka Qortuma</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mat. 21:23-27</ref>; <ref loc="LUK 20:1-8">Luq. 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Insa'nenna higgeenni Iyyerusaalemi'a dange: Yessuusi Woyyichcha Galmike dalla'i giddo mammaremaa wodda qeesoletiki akeekisanjuwwi, Muuseke seerixi borreessano, ardiinxi geedhe isibaa daggeexxi: <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />«Ati tennee yaane duuchcha assitaatteki hoone baalloominnite?» insa'nenna «Tennee assitottaa atee baalloonseek ayyete?» hine. <verse eid="MRK 11:28" /><verse number="29" style="v" sid="MRK 11:29" />Yessuusinna higgeenni insa'nee: «Aninna mitte qortuma ha'noo qoro ani'a hiisse: aninna tennee yaanuwwa hoone baalloomminni assaannexxa ha'no'a kulannon. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Yohaannisixxi cuupha iimi'nitemo yookaan manjin darree'nite? Ani'a hiisseyya» hiyye.<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Insa'nenna weli'anni weli hinee qici: « ‹Iimi'niten› hinonnole ‹Yoona mayeeta iso'ni amana gophphine› no'oo hiyyaan: <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />‹Manjiinbaa'niteni› hinanno?» yaane kinni ardi duuchchi Yohaannisi dhugaatike wabeeka kadeexxa amanaammaxxee insa'ne arda sodaante.<verse eid="MRK 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 11:33" />Tennexxee insa'nenna Yessuusi'n: «No'o egennebo'noni» hineexxi hiissine.</para>
  <para style="p" vid="MRK 11:33">Yessuussinna insa'nee: «Yoona aninna tennee yaanuwwa hoone baalloominni assaannexxa ha'no'a kulabo'noni» hiyye.<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s1">Woyinetike Boonchikanna Wiisaluwwixee Mammaassa</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mat. 21:33-46</ref>; <ref loc="LUK 20:9-19">Luq. 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Ookkonechchi uduma Yessuussi insa'nee mammaaka'ni haaso'ee qici: «Mitti manji woyinetika hiddichcho kaase qarqara iseke'ni dalla'a ijaare: woyinetixxi gumma miicendaaxxa bale umeexxi isee heqqinaaxxa xeleepho ijaare. Ookkonechchi uduma isi konnee woyinetika booncho buttinna hujaammake manni'a uwweexxi wele bogiba'a me'e. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Isinna raxxeexxa woyintixxa gumma isi'a idangaashsha erganjuwwi giddi'ni mitte fichcha hujaammake wiisalluwwibaa erge. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Yaane kinn wiisaluwwi isoo abinde ganneexxi duwwixxe anganni shorrine. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Higgeenni isi wele ergataammaka manjichcho erge. Wiisalluwwikinna umo isika dhodhdhoonse, salphinse shorrine. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Isinna higgeenni wele manjo erge: konneenna shinne: iittanni heddo erganjuwwa ergee wodda insa'ne giddii'ni mitte mitte ganne: wele kinni shinne.»<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />«Isi higgeenni wele ergaake hedhemman: iikki isi eeyyammake ifike belto: ‹Insa'nenna belto anka ullifeessinaan› hiyya'ni duuchchiingee'ni udunse isoo erge.<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />«Yaane kinni buttina hujaammaki manni weli'ani weli: ‹Kunnifa'i karra isixxa dhaalaaken: amme isoo shinno! Karra isixxi no'oxxe kaddaani› hine. <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Tennexxee insa'nenna isoo abinde shinne: woyinetike fichchi giddii'ni iso aa'ne hunne.<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />«Yoona woyinetike hiddichchiki fichchiink anni maa assaachcho ha'no'ni labba? Isi umi ifingenninni dagaani buttina hujaammaaka mannanna shiyaani. Woyinetika hiddichchonna welekee uwwaani. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Meya,</para>
  <para style="q2" vid="MRK 12:10">mine ijaaraammaaki manni tuffateemmaaki kinji:</para>
  <para style="q1" vid="MRK 12:10">« ‹Ijaaraammak manni tufateemmak kinji</para>
  <para style="q2" vid="MRK 12:10">isi dhaaddotike kinjo kadeeni; hiyyende borreessendeexxa haaseessitineba.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />Tinninna Mageniixe hujeni</para>
  <para style="q2" vid="MRK 12:11">ille no'oxxe'ni mambe'akeni› » hiyyaaka woyyichchi Maxaafika hiyyichcho haaseessitinebaa?<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Yihudiinki akeekisanjuwwi Yessuussi mammaakeeki mammaassi insa'ne'aate kaddeexxa egennemmaxxee isoo abindo'a hanse. Yaane kinni insa'ne arda sodaanteemmaxxee isoo waalle me'ine.<verse eid="MRK 12:12" /></para>
  <para style="s1">Irbo Uwwatee Shiqeeka Qortuma</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mat. 22:15-22</ref>; <ref loc="LUK 20:20-26">Luq. 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Ookkonechchi uduma Yessuussi haaso'aake haaso'inni isoo abidatee Feerisitotenaa'ninna Heeroodisixxe gamonaa'n manna isibaa ergine. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Insa'nenna isibaa dangeexxi: «Barsiisanjo, ati dhugaatike manjo kaddeettexxa egennenneni: manjiinka alba uuda'ni gamisaaboxxoni: Mageniinka oranna dhugaati barsiissaatteni: yoona Qeesaari'a irbo uwwiyyo hasissaaxxemo hasissaaxxeba? No'ota irbo uunanomo yaakan waallanno?» <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />Yessuussinna kinni ifi uggudhdha insa'nexxa ege'neexxi: «Maye'e ane'e abidatee hassina'ne? Amme mitte diinaare ane'ni uwwe uudo» hiyye. <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />Insa'nenna diinaare indange: isinna «Tenne diinaare'ni hana hexxeexxi fakke ayyixxe? Borreessemeeki summi ayyike?» hiyyeexxi qore.</para>
  <para style="p" vid="MRK 12:16">Insa'nenna, «Qeesaarikeni» hine.<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Yessuusinna: «Yoona Qeesaarika Qeesaari'a: Mageniinka Magenokee uwwe!» hiyyeexxi hiisse.</para>
  <para style="p" vid="MRK 12:17">Insa'nenna tennee hiissa isixxe'ni mambe'a hine.<verse eid="MRK 12:17" /></para>
  <para style="s1">Reyeeke Mannixxa Ke'a</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mat. 22:23-33</ref>; <ref loc="LUK 20:27-40">Luq. 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Ookkonechchi uduma reyeeke mannixxi ke'a hexxebaani hiyyaaki Seduuqito Yessuussibaa dageexxi: <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />«Barsiisanjo insa'nenna Muuse mitti manji oose are ifixxenaa'ni ilebaangi rewoti gargaritti higgoole: dayyi isiki ettenee manjichcho dhaaleexxi dayyo ifikee sanne gatisowwaali hiyyeexxi Muuse Maxaafake'ni borreesseeni. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Torbaani dayyuwwi hedhemmani: angafi insa'neeki aadheexxi oose i'lebaangi reye. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Dayyi isikinna eetteneenni manjichcho dhaaleexxi i'lebaangi reye: sakkakinna ittanni kade. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Torbaaniingi tennee manjichcho aa'neeni: yaane kinni duuchchiingi isenaa'n i'linebaangi renne: duuchchiingi reyeechchi uduma manjichchotinna rerte. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Yoona torbaaniingi dayyuwwi isee adheexxe yoona tinni manjichcho rewotenaa'ni ke'ati wodda torbaane dayyuwwanaa'ni hoone'a arete kadda?» hine.<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Yessuusi insa'nee hiyye hiissee qici: «Ha'no deetina'neechchiqa Woyyichcha Maxaafuwanna Mageniinxa hunna ege'na gophphineemmaxxeteni! <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Reyeeki manni rewotenaani ke'a wodda iimixxe Ergannashsha kandaani malee: weli aa'naba'a heerumaba'a. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Reyotenaa'n ke'atixxee kinn, Mageni Muuse'n ha'yitaammaxxe qosorro giddo maa haaso'eexxa Muuseka maxaafa haaseessitinebaa? Tinninna: ‹Ani Abirihaamike Yisaaqike, Ya'iqoobike Magenoni› hiyyeexxen. <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Mageni hedhaake mannike Mageno malee reyeeke mannike Magenobaani: tennexxee ha'no lumoqico deetineeni» hiyye.<verse eid="MRK 12:27" /></para>
  <para style="s1">Duuchchiingenaa'ni Sa'aka Ajaja</para>
  <para style="r">(<ref loc="MAT 22:34-40">Mat. 22:34-40</ref>; <ref loc="LUK 10:25-28">Luq. 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Muuseke seerixxe barsiisanona'ni mitti moroma insa'neexxa laqa'nemmani: Yessuussi'i qorreeke qortumi'a isi eloke orinni insa'ne'a hiissa hiisseexxa ege'neexxi: «Ajaja duuchchiingenaa'ni sa'aaki ajaji hoonte?» hiyyeexxi Yessuussi'i qore.<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Yessuusinna iso'n hiyye hiisseexxi: «Ajajuwwi duuchchana'ni sa'aaki siretik ajaji ‹Tee Isira'eeli laqi! Mageni Gootti no'oki mitte Goottani; <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />atinna mitte godobinni, mitte hedhonni, mitte heduminni, mitte hunnanni Mageno Gootta atika eeyyi!› hiyyaakeni.<note caller="-" style="x"><char style="xo" closed="false">12:30 </char><char style="xt" closed="false"><ref loc="DEU 6:4-5">Lan. 6:4-5</ref>. </char></note> <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Langaki ajajinna konnelabaaken, ‹Wele mannanna umi atikishshanni eeyyi!› Konne lame ajajanaa'ni sa'aaki ajaji hedhebaani» hiyye.<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />Muuseke seeriinki barsiisanjinna Isoo hiyyee qici: «Barsiisanjo! Elonxe hiteetten: Mageni mitteken isoo malee weli Mageni hedhebaani hite haasoottettexxi dhugaateni. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Isoo mitte godobinni, mitte heduminni<note caller="+" style="f"><char style="fr" closed="false">12:33 </char><char style="ft" closed="false">Addatemek edike mirriqisanjo'ni mitte hedumini hitaaxxi hiyya weleke'ni hexxeexxeban.</char></note>, mitte hunnanni eeyya iittanni wele mannanna umi ifikishshanni eeyya ciinco'aake tolcha duuchchana'ninna wele tolchuwwanaa'ni saxxaan» hiyye.<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />Yessuusinna Muuseke seeriink barsiisanji beekkumiki hiissexxa uudeexxi: «Ati Mageniinxe mootummanaa'ni bayyatteettekebaani» hiyye. Ookkonechchini uduma Yessuussi'i afo'o wo'me qoreeki hedhebaan.<verse eid="MRK 12:34" /></para>
  <para style="s1">Kirsittoosi Ayyike Belto</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mat. 22:41-46</ref>; <ref loc="LUK 20:41-46">Luq. 20:41-46</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Yessuusi Woyyichchi Galmixxe baxxe'n barsiisa'ni hiyye qoree qici, «Muuseke seerixxi barsiisano hitta Kiristoosi Daawwitike belton hitaatte? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Daawwiti Woyyichchi Hafuurinni akekemeexxi haaso'ee qici:</para>
  <para style="q1" vid="MRK 12:36">« ‹Gootti Gootta anka:</para>
  <para style="q2" vid="MRK 12:36">«Naapha atika lekka atixxi hunda hirbeessitattoshsha</para>
  <para style="q1" vid="MRK 12:36">Assanno qico'ni</para>
  <para style="q2" vid="MRK 12:36">midda anke'ni ofo'li hiyye.» ›<verse eid="MRK 12:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="MRK 12:37" />Daawwitinna umo ifingeninni isoo ‹Anke Gootta› hiyyoole; hittata isi higeexxi belto isike kadatee dande'a?»</para>
  <para style="p" vid="MRK 12:37">Heddi ardinna Yessuussi hiyyeexxa gammashshoti laqa'nemmani.<verse eid="MRK 12:37" /></para>
  <para style="s1">Muuseke Seer Barsiisanonna Faarisito Gibemeexxa</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mat. 23:1-36</ref>; <ref loc="LUK 20:45-47">Luq. 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />Yessuusi barisiisa'ni hiyyee qici, «Muuseke seerixxe barsiisanonaa'ni ifi heqqedhdhe! Insa'ne qeerrarramma seemma odo'wineexxi elqe kayya mammaremate eenaani. Insa'nenna dikko giddonna ulfinniinka nage'a eeyyaakeraani. <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />Iittanni insa'ne Muuseka seera barantaammaake mine'ni ulfinniinxe moote'ni, itatike booncho'ninna ulfinniinke booncho halsinaani: <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />qeerraxxa yanna soodanta'ni aro'o shi'witeexxe melaalleka mine duwwi gatinsaan: tennee assaakera'ni jabaxxe murte murendaani» hiyye.<verse eid="MRK 12:40" /></para>
  <para style="s1">Hiyyeette Manjichchoxxa Uwwa</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luq. 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Yessuussi maallaqa bukki assinaammabaa edonni ofo'lee'naa heddi ardi ifi ifixxa uwwa Woyyachcha Galmike mine'ni maallaqa ugginaammaxxe saaxine giddo ugginaa wodda uuda'neemmani. Hoddo dureeyye lumoka maallaqa ookko'o uggita'nemmani: <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Mitte hiyyeette manjicho kinni daggeexxi lame shiixxaramma sageettotika maallaqa uute. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />Yessuussinna hordofeeyye ifixxa ye'eexxi hiyyee qici: «Dhugaate ha'no'a hiyya'enneni: tinni aro'o shi'witeexxi hiyyeette saaxine giddo maallaqa uggeeke wele mannanaa'ni sa'aaka uggiteen. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Kunni manni duuchchi ifi'a wo'me gateekena'ni uwwen: ise kinni hiyyeettende kadde'e ifi'a gatirsitebaangi affeechcho duuchcha uuteeni!»<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s1">Muuxxamiinxe Barraka Beessisuwwa</para>
  <para style="r">(<ref loc="MAT 24:1-51">Mat. 24:1-51</ref>; <ref loc="LUK 21:5-36">Luq. 21:5-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Yessuussi Woyyichchi Galmi giddii'ni fule dagaa'naa hordofeeyyete'ni mitti, «Barsiisanjo! Tinni kinonna kunni kinjiink minuwwi hittata ela'neexxa uudi!» hiyye. <verse eid="MRK 13:1" /><verse number="2" style="v" sid="MRK 13:2" />Yessuusinna hiisseexxi, «Konnee lumolla kinoti ijaaremeeka minuwwa uudda'i hexxette? Tinni kino kinote'n hana hexxemmaba diigendebaangi gattabaan» hiyye.<verse eid="MRK 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Yessuussi Woyyichchi Galmi edi darre Dabire Zayitixxe kooba'ni ofo'le'na'a Pheexiroosi, Ya'iqoobi, Yohaannisinna Indiryaasi isoo hine qorree qici: <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />«Tinni yaane haano kaddaaxxa no'o'aa kuli: tenne yaane duuchchi muuxematik beessisi maachcho?» hine.<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Yessuusinna insa'nee: «Fedheekinna ha'noo dedhisabaashsha ifi xexxe'atte. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Heddi manni, ‹Ani Kirsittoositeni,› hiyya'ni summi Ankeni dangaani: insa'nenna heddo manna dedhinsaani. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Ha'no bagedokanna bagedinxa odo laqinna wodda mee sodaatte: tinni yaane duuchchi kada isexxi kokaken; kaddo malee muuxami edi'ateni. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Ardi ardake'ni, mootumma mootummate'ni bagedo ke'issitaani: booncho boonchonge'ni buttiniinxi lele'manna solo'i kadaani; tinni duuchcha ciniitotixxe abaraxxe safan.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />«Ha'nonna ifi'ani ifi heqqedhdhe: manni ha'noo muritetixxe songo'ni sa'issineexxi uunaani: insa'nenna Muuseka seera barantammake mine'ni ha'noo jadhanfaani: ani'a dhugaa kula anxe kaddiinaashsha, anxe buutonni arda galchamake moyanjuwwi edo murtetee uurritinaani. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Tinni duuchcha kaddebaangi tenne buttake ardi duuchchi'a eloxa odo lassemiyo hasissaan. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Manni ha'no'o abideexxi muritetibaa shiqishaa wodda: eettennee yanna ha'no'a uwwemaaka haaso'a haaso'we malee maa haasonnanno hitine edissine'e heddinoqqe'e: haaso'naneki Woyyichcha Haafura malee ha'notebaan.<verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />«Dayying ifika dayyo anni ifika belto, rewotee sa'isse uwwaani: oose hado ifke'ni naaphunteti kexxaani: insa'nenna hado ifika shinnaani. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Ha'nonna anxe buutonni manji duuchchi edo jibbendineeke kaddinaani: muuxami qico'ni osseeki kinn anjiremaan.<verse eid="MRK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />«Ba'netixxi battitte yaane hasissabaake booncho'ni hexxee'naa uuddinoole: tinninna maachcho kaddeexxa haaseessaammaki tennee qalli hiyyowwaal: ookkone wodda Yihudake boga'n hedheeki manni koobatibaa baajowaali. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Ifike miniink heellichcho'ni hedheeki butti'a dirroqqe'e: horateelcho adhdho'a ifike minibaa e'yoqqe'e. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Fichchi giddonna hedheeki manni seemma ifixxa adhdhatee udumi'a higoqqe'e. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Eettene barra'ni siila'witeexxe melaalle'anna unuunsitaaxxee aanne'e! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Tinni duuchcha haarso kaddabaashsha soodatte. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Edise Mageni dada duuchcha dadeexxe yannanaa'ni kadde egendebaaxxi edi'anna kaddabaaxxi jabaxxi rakko kaddaan. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Gootti eettene barruwwa harunsa gopheele ayyinna anjiremammabaan. Yaane kinni isi fi'leemmake mannixxe'e hiyye'e eettene barruwwa haruunse. <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />Ookkone wodda fedheekinna ha'noo: ‹Kiristoosi kaba hedheeni!› hiyyoole yookaan ‹Ookko'o hedheeni› hiyyoole amandinoqqe'e. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Dhariinxi Kiristoositonna dhariinxi wabeekole kexxe beessisuwwakanna masuwwa assitaan; insa'ne'a dandeessisseele midde Mageni fileemmaka manna dedhinsaan. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Tennexxee ha'no ifi'anni ifi heqqedhdhe: yanna geltebaang duuchchiinxa ha'no'a kuleenneni.<verse eid="MRK 13:23" /></para>
  <para style="s1">Kiristoosika Langaka Dago</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mat. 24:29-31</ref>; <ref loc="LUK 21:25-28">Luq. 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />«Yaane kinni eettene yannuwwa'ni rakko uduma</para>
  <para style="q1" vid="MRK 13:24">« ‹Arishsho dukkandaan: agenjikinna ifa uwwabaani:<verse eid="MRK 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25" />Urijuwwatinna iimii'ni butti'a ibbaani;</para>
  <para style="q2" vid="MRK 13:25">iimixxi hunnuwwa lele'mitaani.›<verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />«Ookkonechchi uduma Manjiinki Belti lumooxxe hunnanninna lumooke ulfinninni duumanchake'ni dagaa wodda insa'ne uundan. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Isinna ifixxa iimixxa Erganna ergaan: insa'nenna shool darre'ni me'ine buttatixxe gabalanaa'ni iimixxe gabala qico'ni hexxeexxa isi'a fi'leemmaka manna bukki assaani.<verse eid="MRK 13:27" /></para>
  <para style="s1">Gootiinka Dago Kulaake Ode'iinke Haqichchika Mammaassa</para>
  <para style="r">(<ref loc="MAT 24:32-36">Mat. 24:32-36</ref>; <ref loc="LUK 21:29-33">Luq. 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />«Ha'no mammaassakanna odi'inke haqichchonaa'ni baratte: damuwwatinna shafi iseki haanjedhaa wodda: ha'no boni shiqeexxa egendinaani. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Iittanni kinni ha'no tinni yaane duuchcha muuxendaa'na uuddinaa wodda dagi isik shiqe'e huddummete'ni hedheexxa ege'ne. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Dhugaate ha'no'a hiyya'enneni: tinni yaane duuchcha muuxendaa qico'ni tinni ila saxxabaan. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Iimatinna butta sa'a saxxaani: hiyyichchi anki kinni duuchchi woddi'a hedhaani.<verse eid="MRK 13:31" /></para>
  <para style="s1">Barratanna Yanna Ayyinna Ege'nabaaxxa</para>
  <para style="r">(<ref loc="MAT 24:36-44">Mat. 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />«Yaane kinni eettenee barranna eettenee yanna Annake kaddole malee iimixxi ergannanna kaddo, Beltokenna kado, fedheekinna ege'nabaani. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Tennexxee yanna iitti haanote kaddeexxa ha'no ege'na gophphineemmaxxee ifi heqqedhdhe, jabaatte. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Kunninna mine ifika erganjuwwa ifikee waaleexxi mitti mittinga erganjuwwa insa'neexxe huje hujeke qoobbishshanni bobbaaseexxi heqqanjikinna hula dammaqe heqqaashsha ajaje me'eeke manjo fakkaataani.<verse eid="MRK 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35" />«Yoona miniink anni dagaaxxa yanna ha'no ege'na gophphineemmaxxe'e: akimagaado hashshunte, yookaan galgala, yookaani lukko gandaa wodda, yookaani gorsa bariisa dagaaxxe hexxeene jabaattine ifi heqqedhdhe. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Dedhange'ni isi dagaa wodda ha'no diiphphinee'naa afabashsha tennexxee xexxe'atte. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Ani ha'no'ni haaso'annexxa manji duuchchi'a haaso'annon: ‹ha'no jabaattine heqqedhdhe!› »<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s1">Yessuussii Shiyatee Assemeeka Diina</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat. 26:1-5</ref>; <ref loc="LUK 22:1-2">Luq. 22:1-2</ref>; <ref loc="JHN 11:45-53">Yoh. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Sa'atikinna xaltiinki ayyaani ulfeessemo'a lame barra gattee'naa: qeesoletikinna Muuseke seerixxi barsiisano Yessuussii abindaakanna shiltaaka toora hansaammani. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Yaane kinni insa'ne; «Ardi lola ke'issabaashsha tinni ayyaani barra kaddoqe'e» hinaamman.<verse eid="MRK 14:2" /></para>
  <para style="s1">Yessuussi'ni Shitto Issiteexxa Manjichcho</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat. 26:6-13</ref>; <ref loc="JHN 12:1-8">Yoh. 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Yessuussinna Biitaaniya soomi abideeke Simi'oonike mine'n itate'ni hedhee'na'a: manjichcho mitte hiri yo'oshsha fiixxeexxa mako afebaaxxa naardoosixxi shitto<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">Naardosi hiyyemake hiddichi shitto hujendaak fiixek hiddichon. </char></note> wo'miteexxa albaasxxiroosixxa bilqaaxe aaxxe dagge enqiteexxi eettenee shitto Yessuussike umo'ni dunde. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />Ookko'o hedheemmake manni giddii'ni mitti mitti tennee assiteexxe yaane'n mufante weli'anni weli: «Tinni shitto mayee tola baxxa? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Shitto tinni sase dhibba Diinaare<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="fqa" closed="false">Mitte Diinar hiyyo </char><char style="ft" closed="false">Manji mitti barra mitte'ni huje alfamake barratik runda hiyyoten.</char></note> iima gurgurende'e sila maallaqa ookkonee hiyyeeyyetee uwwa dandessissamman!» hine tennee manjichcho cee'mine.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />Yessuusi kinni insa'nee: «Waalle! Isee'e mayee rakkisina? Ise ani'a eloxxe yaane assiteen. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Hiyyeeyyete kaddoole, duuchchi woddanni ha'nonni welti hexxeen hassineexxe yanna'ni insa'nee gargaara dandeettinaani: ani kinni duuchchi wodda ha'nonni welt hedhabo'noni. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Tinni manjichcho ise'e dandeessisseeqico ani'a assiteeni; moogemmebo'nong edi darre maala anke'n shitto issiteeni. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Ani ha'noo dhugaate hiyyaanneni: tinni eloxxi odo butta duuchcha'ni kulendaammake booncho'ni: ise ani'a assiteexxi yaane qaabbete kadde'e isexxee kulendaani» hiyye.<verse eid="MRK 14:9" /></para>
  <para style="r">(<ref loc="MAT 26:14-16">Mat. 26:14-16</ref>; <ref loc="LUK 22:3-6">Luq. 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Ookkonechchi uduma tommenna lame hordofeeyye giddii'ni mitti Asiqorootuk Yihuda, Yessuussii sa'isse uwwo'a qeesoletike akeekisanjiba'a mare. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Insa'nenna tennee lanqee wodda gammande: maallaqa isi'a uwwiyyotee weli aange: tennexxee isi Yessuussii sa'isseexxi uwwo'a eldaaxxa yanna heqqedha'nemman.<verse eid="MRK 14:11" /></para>
  <para style="s1">Yessuussi Sa'atike Ayyanixxa Ita Hordofeeyyeti Welti Iteexxa</para>
  <para style="r">(<ref loc="MAT 26:17-26">Mat. 26:17-26</ref>; <ref loc="LUK 22:7-14">Luq. 22:7-14</ref>, <ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yoh. 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Sa'atike ayyaanik gedhechchi duleemmamake kebbotike ayyaanixxe siretixxe barra'ni, hordofeeyye isixxi Yessuussiba shiqqeexxi: «Sa'atike ayyanixxa ita haba marree ati'a qophpheessinonnaa hassaatte?» hite isoo qorte. <verse eid="MRK 14:12" /><verse number="13" style="v" sid="MRK 14:13" />Isinna hordofeeyye giddii'ni lame erge insa'nen hiyyee qici, «Ha'no qachchibaa marre! Ookko wodiinxa odolcho dulkeeke manjichchinni futti hitinaan: <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />isinna e'yaake mine'ni duuka e'ye: ookkone minika gootta, ‹Barsiisanji anxe hordofeeyyenni welti sa'atike ayyaanixxa hashshixxa ita itaak keessummatik mini habate?› hiyya'neeni hiyye. <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Isinna fooqete'ni hedheeka giissemeekanna fayemeeka ba'laka mine ha'no'a leellishaani: ha'nonna ookko'o ani'a qophpheesse» hiyye.<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Isixxi hordofeeyyenna ookkoo'ni kexxeexxi qachchiinbaa marte: insa'ne'ni duuchchiinxa yaane Yessuussi kulemmashshanni kaddee'na anfe: insa'nenna sa'atike ayyaanixxa itanna qophpheessine. <verse eid="MRK 14:16" /><verse number="17" style="v" sid="MRK 14:17" />Hashshee wodda Yessuussi tommenna lamiinxe ifixxe hordofeeyyenni welti dage. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Insa'nenna itate'ni he'nee'naa, «Yessuusinna dhugaate ha'no'n hiyyaannen ha'no giddii'ni mitti aninninni welti ita'neeke anee sa'isse uwwaani» hiyye. <verse eid="MRK 14:18" /><verse number="19" style="v" sid="MRK 14:19" />Insa'nenna mitti mitting tenne yaane'ni yaandeexxi, «Ante kadunnu?» hina'ni weli'ani weli qorre. <verse eid="MRK 14:19" /><verse number="20" style="v" sid="MRK 14:20" />Isinna insa'nee hiyyee qici, «Tommenna lame giddii'ni mitti aninni anga qorete'ni ugga'neeken. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Manjiinki Belti isixxee borreesendemmashshanni reya reyaani. Yaane kinni Manjiinka Belto sa'isseexxi uwwaake ookkone manji'a aanne'e: iikki manji ilema gopheele woyyammani» hiyye.<verse eid="MRK 14:21" /></para>
  <para style="s1">Goottiinka Hirbaata</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mat. 26:26-30</ref>; <ref loc="LUK 22:14-20">Luq. 22:14-20</ref>; <ref loc="1CO 11:23-25">1 Qor. 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Insa'nenna itande'ni he'nee'naanni isi daabbotanna aadheexxi galateeffate: isinna shashshateexxi hordofeeyye ifixxee uwweexxi: «Yawwe kunni anke maalani» hiyye.<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Ookkonechchi uduma isi buuda aadheexxi: galateeffate'e insa'ne'a uwwe: duuchchiingi eettene buudana'ni ha'we.<verse eid="MRK 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 14:24" />Yessuussi insa'ne'n hiyyee qici, «Tinni, heddi mannixxee dunenda'neexxe haaroxxe kakoxxe anxe mundeni.»<verse eid="MRK 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 14:25" />«Ani dhugaate ha'no'a hiyyaanneni: Mageniinxe mootumma'ni haaroxxe woyinexxe gummaka bulubulo ha'wannoqico'n langaxxa tennee ha'wa ha'wabo'noni» hiyye.<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Insa'nenna ookkonechchi uduma faaro faarsineexxi Dabire Zayitexxe koobabaa fulle.<verse eid="MRK 14:26" /></para>
  <para style="s1">Pheexiroosi Isoo Ege'nebe'noni Hiyyaaxxa Yessuussi Ediseexxi Haaso'eexxa</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat. 26:31-35</ref>; <ref loc="LUK 22:31-34">Luq. 22:31-34</ref>; <ref loc="JHN 13:36-38">Yoh. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Yessuusinna, « ‹Allalisanjo ganannon, gedhebi xeremaan;› hiyyende borreessendemmaxxee duuchchiing ha'no anee waaldinaan;<verse eid="MRK 14:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28" />Yaane kinni ani rewotenaa'ni ke'ennelchi uduma ha'no'a edise'e Geliila'a me'annoni.» <verse eid="MRK 14:28" /><verse number="29" style="v" sid="MRK 14:29" />Pheexiroosinna, «Weli duuchchiingi atee waaloole midde ani hara atee waalabe'noni» hiyye.<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Yessuusinna isoo: «Dhugaate ati'a hiyyaanne tennee hashsha'ni lukkichchi lamele baroodebaangi ati sasele anee ege'nebo'noni hitatton» hiyye.<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />Pheexiroosinna hiisseexxi: «Ani atinni welti reyonnole midde hara atee waakkatabo'non» hiyya'ni jabaateexxi haaso'e.</para>
  <para style="p" vid="MRK 14:31">Wele hordofeeyyenna iittanni hite.<verse eid="MRK 14:31" /></para>
  <para style="s1">Yessuussi Geetesemaaneke Booncho'n Soodateexxa</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mat. 26:36-46</ref>; <ref loc="LUK 22:39-46">Luq. 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Ookkonechchi uduma insa'nee Geetesemaani hiyyemaake boonchiba me'ine: Yessuussinna hordofeeyye ifixxa: «Ani soodataannen; ha'no kabanni turre» hiyye. <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Isinna Pheexiroosii'i, Ya'iqoobiinna Yohaannisii'i adhdheexxi me'e: isinna yo'oshsha yaada'ni wixixxi hiyyate'ni ke'e. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Higgenni, «Lubbo anxi lumooxxe yaaddonni rewotee shiqqeeni; ha'no kabanni turtineexxi jabaattine heqqe» hiyye.<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Isinna shiixxo qico insa'nee sa'e me'e buttinake'ninna ibeexxi dandeessissoole iitti yanna isinaa'ni saxxaashsha soodateexxi, <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />«Anke Anna! Duuchchiinxi yaane ati'a dande'endammaxxee tennee anee'ni gelta'neexxa rakkotixxa buuda anenaa'ni bayyisi: yaane kinni anke hasitishshate kaddebaang atike hasitishsha kaddowwaali» hiyye.<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Yessuussi illeema hige'e hordofeeyye isixxi diiphphee'naa afexxi, Pheexiroosii hiyyee qici, «Koo Simi'ooni diiphpheette? Mitte yanna midde jabaatte heqqa dandeettebexxoo? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Hega uudemate'ni e'yitinabaashsha jabaattine soodatte; irri qophpheeffateeni; maali kinni gophaaleessakeni.»<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Higgeenna isi me'exxi sirete'n hiyye soodatemanga hiyyichcho lebeexxi soodate. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Higgeenn isi hordofeeyyetiba'a illeema hige dagee wodda: ille insa'neexxi mugiki ha'urteemmaxxee; diinphee'na'a afe: insa'nenna hina'neexxa egenna'nemmabaani.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />Isinna sakkaxxa yanna dageexxi insa'nee hiyyee qici, «Ta'anna diiphphinee hafuura adhdhande'n hexxinee? Yoona gelte'e! Yannatinna gelte! Manjiinki Belti cubbaaleeyyetixxe anga'ni sa'issemeexxi uwwemaaxxi yanna gelte'eeni. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Ke'we me'ino! Anee sa'isseexxi uwwa'neeki dage'eeni» hiyye.<verse eid="MRK 14:42" /></para>
  <para style="s1">Yessuussixxa Abidensha</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat. 26:47-56</ref>; <ref loc="LUK 22:47-53">Luq. 22:47-53</ref>; <ref loc="JHN 18:3-12">Yoh. 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Yessuussi tenne haaso'a'neenge'n: tommenna lame hordofeeyye giddii'n mitti Yihuda dage: isinni welti wolaantichchakanna meena abixxeekiir qeesetike akeekisanjuwwinaani, Muuseke seerike barachchiisalluwwinaa'ninna geedhe giddii'ni ergemeeki heddi manni hedheemmani.<verse eid="MRK 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 14:44" />Sa'isse uwwammaki Yihudanna, «Ani sunqedhannoki manji isoteni abidde; xexxe'achchotinna isoo adhdhitineexxi me'e» hiyyeexxi ediseenni hedhe'e insa'ne'a beessisa uwweemmani. <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />Yihuda dageeshshanni hirbange'ni Yessuussibaa shiqeexxi «Barachchiisalloo!» hiyyeexxi isoo sunqedhe, <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Ookkonechchi uduma manni dage'e Yessuussii abideexxi usure. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Ookko bira uurremmake manni giddii'n mitti wolaantichcha gosheexxi qeesetike akeekisanji'a ergataammake manjichchixxa mansha woxe.<verse eid="MRK 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48" />Yessuusinna insa'nen hiyyee qici, «Ha'no moodhalcho abiddina'neeshsha wolaantichchakanna meena abixxitineexxi anee abiddino'a dagginee? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Heddo barra Woyyichchi Galmi giddo barsiisa'n ha'nonni welti hedhenne wodda anee abiddineemmabaani; Maxaafiinki hiyyichchi muuxxemasha tinni kaddeeni.» <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />Ookkonechchi uduma duuchchiingi isoo waaleexi baaje.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Saala ifika buqedhate'e bayyanii calla odo'weeki dargaggeessi mitti kinni Yessuussii hordofa'nemmani. Iikki manninna konnee dargaggeessa belto abido'a hiyyee wodda: <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />Isinna bayyaanii ka'leemmaxxa huneexxi duwwittinni baaje.<verse eid="MRK 14:52" /></para>
  <para style="s1">Yessuussi Murtetixxe Songo Edo Shiqeexxa</para>
  <para style="r">(<ref loc="MAT 26:57-68">Mat. 26:57-68</ref>; <ref loc="LUK 22:54-55">Luq. 22:54-55</ref>, <ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yoh. 18:13-14</ref>, <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Insa'nenna Yessuusii'i qeesetike akeekisanjibaa adhdhine me'ine: ookko qeesetiki akeekisanjuwwi, geedhetinna Muuseke seerik barachchiisalluwwi duuchchi bukki hiyye. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Pheexiroosinna isoo bayyii'ninni hordofa'ni qeesoletike akeekisanjike dalla'iqico'ni me'e: isinna ookko ofo'leexxi heqqanjuwwik welti giira gubadhdha'nemmani.<verse eid="MRK 14:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55" />Qeesetik akeekisanjuwinna songotixxi geedhe duuchcha Yessuusii shinno'a dhugaa kulaaka manjo hanse: yaane kinni afa dandeenneba'a. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Heddi manni dhariki iso'n dhuga kulaa'naa hiyyichchi insa'neeki weli qabeba'a.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Mitti mitti manni dhariki dhugaa iso'ni ke'exxi kulaammaa qici, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />«Konnee, ‹Manji ijaareka Woyyichcha Galma diigeennexxi, sase barra giddo wele manjiinxe anganni ijaaremebaaka ijaarannoni› hiyyaa'naa lanqeenneni.» <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Iittanna kaddoole dhugaa insa'neexxi mitte afo'o kaddebaani.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Ookkonechchi uduma qeesoletiki akeekisanji insa'nee edo ke'e uurreexxi: «Kunni manni atee ku'la'neexxi ku'la maachcho? Hiissichcho affebexxoo?» hiyyexxi Yessuusii qore. <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />Yessuussi kinni sammi hiyye mittelchonna hiissebaani. Qeesetiki akeekisanjinna higgeenni isoo'o «Eebbisemeeke Magenik Belti Kiristoosi atette?» hiyyeexxi isoo qore.<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />Yessuusinna hiisseexxi: «Eeti anedeni; Manjiinki Belti Mageniinke midda'ni ofo'laa'naanna iimatenaa'n duumanchiki dagaa'naa uuddinaani» hiyye.<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Qeesoletiki akeekisanjinna mufeti seemma ifixxa dareexxi «Yoona wele dhugaa kula no'aa mayee hassissa? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Ha'no yowwaa'naa laqqineeni: yoona ha'no'n maa fakkaatta?» Insa'nenna rewote isi'a hasissaani hine'e mitte afo'o kandeexxi iso'n murre. <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />Ookkonechchi uduma mitti mitti manni iso'ni hancufa tufate'n ke'e: ille isixxanna seemmati bunqeexxi tuntummoti isoo gana'n isoo'o, «Amo mee raaga haaso'i» hina'neemmani. Heqqamaki manni kinni kabaloti isoo gana'ni aadheexxi me'e.<verse eid="MRK 14:65" /></para>
  <para style="s1">Pheexiroosi Yessuussii Waakkateexxa</para>
  <para style="r">(<ref loc="MAT 26:69-75">Mat. 26:69-75</ref>; <ref loc="LUK 22:56-62">Luq. 22:56-62</ref>; <ref loc="JHN 18:15-18">Yoh. 18:15-18</ref>, <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Pheexiroosi dalla'i giddo aadi darree'ni hedhe'naa qeesetike umi'a ergataammake dubarri giddii'n mitte dagge. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Pheexiroosi giira guba'laa'naa dhaphphi hite isoo uuddeexxi: «Atinnaqqa Naazireetike Yessuusinni welti hexxettani» hite.<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Isi kinni: «Ati hitaatenga ani ege'nebo'non, isoonna qalli hiyyabe'non» hiyyeexxi waakkate. Ookkoo'ni isi e'yinammaxxe hulabaa'n gadhi'a fule; eettene yanna lukko baroodde.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />Iitti ergatendammaxxi dubarrichcho Pheexiroosii uudee wodda ookko uurreeke mannaa'ni: «Kunni manjichchi insa'ne giddii'ni isi mitteken» hita'n langaxxa insa'ne'ni haasootte. <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Isi kinni higgeenni isoo ege'nebe'noni hiyye waakkate.</para>
  <para style="p" vid="MRK 14:70">Shiixxoxxe yanna uduma ookko uurreeki manni Pheexiroosii'i, «Ati Geliilake manjo kada atixxi kokaken; ati insa'ne giddii'ni mitteken» hiyye.<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Isi kinni «Konnee hitina'neeka manjichcho ani ege'nebe'ni» hiyya'ni ifi bada'ni kakate.<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Ookkone hirba'ninni lukko langaxxa barroodde; Pheexiroosinna, «Lukko lamele barroddebaa ediga'ma sasele anee waakkattatton» hiyyeexxi Yessuusi haaso'eemmaka haaso'a qaabbate; ookkoo'ninna hiiqise oodhe.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s1">Yessuussii Philaaxosibaa Adhdhemeexxa</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mat. 27:1-2</ref>, <ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luq. 23:1-5</ref>; <ref loc="JHN 18:28-38">Yoh. 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Gorsa bariisa qeesoletiki akeekisanjuwwi, geedhuwwa, Muuseke seerixxi barachchiissalluwwinna, songotixxe gedhee duuchchinni welti iikki woddi mari'anteechchi uduma Yessuusii'i usurreexxi Philaaxoosi'n sa'issine uune. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />Philaaxoosinna Yessuussii'i «Ati Ayihudiinke moyanjo?» hiyyeexxi qore.</para>
  <para style="p" vid="MRK 15:2">Yessuussinna, «Ati hitetteshshanden» hiyye. <verse eid="MRK 15:2" /><verse number="3" style="v" sid="MRK 15:3" />Qeesetiki akeekisanjuwwinna Yessuussii'i heddo yaane'a isoo ku'laamman. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Tennexxee Philaaxoosi isoo'o «Mayee hiissichcho uwwa gophphaatte? Heddo yane'a atee ku'lineen» hiyyeexxi higgeenni isoo qore. <verse eid="MRK 15:4" /><verse number="5" style="v" sid="MRK 15:5" />Yessuusi kinni mittechchonna hiissebaan: Philaaxoosi tenne yaane'ni mambe'a hiyye.<verse eid="MRK 15:5" /></para>
  <para style="r">(<ref loc="MAT 27:15-26">Mat. 27:15-26</ref>; <ref loc="LUK 23:13-25">Luq. 23:13-25</ref>; <ref loc="JHN 18:39-40">Yoh. 18:39-40</ref>; <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Ookkone ayyana'ni ardi tikemo'a qoraak manji tikeme wocci assematik seeri hedhemman. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Ookkone wodda fuggoxxinni ke'xxe'e manjo anga saxxeexxe fuggaaleyyenni welti usuremeek Berbaan hiyyemaake mitti manjichchi hedhemman. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Ardkinna dageexxi isi konnechchi edo baratendemmashshani insa'ne'a tikaashsha Philaxoosii kadhate. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />Isinna insa'nee, «Ayihudiinka moyanjo ha'no'a tikonnaa hassina'nee?» hiyyeexxi qore. <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Tenneenna asseelchi qeesetiki akeekisanjuwwi Yessuussii'i sa'isse uwweechchi hinaaffetite kaddeexxa isi ege'neemman. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />Yaane kinni qeesetik akeekisanjuwwi, «Isixxa bakka Berbaanii no'aa tikemowwaal» hiyyeexxi ardi Philaaxoosii qoraashsha manna fuggoxxenni ke'isse. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />Philaaxoosinna higgeenni, «Yoona ha'no konnee Ayihudiinke moyanjo hitina'neeka isoo ani maa assonnaa hassina'ne?» hiyyeexxi manna laqe.<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Insa'nenna, «Isoo fannisi!» hina'ni hoginse.<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Philaaxoosinna insa'nen, «Mayeete isi hujeexxi balleessa hexxee?» hiyye.</para>
  <para style="p" vid="MRK 15:14">Insa'ne kinni, «Isoo fannisi!» hina'ni yo'oshsha hoginse.<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Philaaxoosi arda gammachchiiso'a hiyye'e Berbaanii'i insa'ne'a tike wocci asse. Isi kinni Yessuusii'i jadhafe'e fannisemaashsha sa'isseexxi uwwe.<verse eid="MRK 15:15" /></para>
  <para style="s1">Looliinki Manni Yessuussi'ni Gacifateexxa</para>
  <para style="r">(<ref loc="MAT 27:27-31">Mat. 27:27-31</ref>; <ref loc="JHN 19:2-3">Yoh. 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Looliinki manninna Yessuussii Pirayitoorite hinaake boga galchammakike dalla'i giddi'a aa'ne me'ine: sannaachcha duuchchanna mitteba bukki assine. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Insa'nenna baddeessitte seemma iso'ni oddeessine; uteti sagarre'e giisineeka kallachchanna umo isike'ni uggine. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Ookkonechchi uudma insa'ne: «Koo Ayihudiinke moyanjoo nage'i ati'a kadowaali!» hina'ni isoo nage'a lanqe. <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Insa'nenna siqqoti umo isika ganna'n hancufakanna iso'ni tunfe: gacifanta'ninna isi edo guluffante sagande. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Iso'ni gacifanteechchi uduma baddeessitte seemma isona'ni fulchineexxi isinxa seemma oddeessine. Ookkonechchi uduma isoo fanniso'a adhdhine me'ine.<verse eid="MRK 15:20" /></para>
  <para style="s1">Yessuussixxa Fannisensha</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mat. 27:32-44</ref>; <ref loc="LUK 23:26-43">Luq. 23:26-43</ref>; <ref loc="JHN 19:17-27">Yoh. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Alekisandiroosikinna Ruufoosik anni Simi'ooni hiyyemeek mitti Qereenake bogik manjichchi hadi giddii'n daga'neenge'n Yessuussixxa fanno dukaashsha iso'n hunnante. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Ookkonechchi uduma insa'ne Yessuussii'i tika isixxinna, «Umiinke qoonjo» hiyyeme ye'emaake Golgootike boonchibaa iyyemarre. <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Isinna ookko geyee wodda karbeti<note caller="+" style="f"><char style="fr" closed="false">15:23 </char><char style="ft" closed="false">Yo'osha qaraarak hiddichon. </char></note> welti karsendeexxa woyinetixxa booka iso'n uune; yaane kinni isi adhdhebaani. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Ookonechchi uduma insa'ne isoo fanninse; seemma isixe'ninna ayyii ma dhdhaaxxa hixa ibilsineexxi qoodemme. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />Isoo fannise wodda yanna gorsixxe sase saatemmani. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Ku'lemeexxe ku'lak borreesi, «Isi Ayihudiinke moyanjo» hiyyaakemman.<verse eid="MRK 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 15:27" />Ookkonechchi uudma isinni welti lame bokkaame mitte midda isike'ni mitte bita'a isike'ni fanninse. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />(Maxaafake'ni, «Isi fuggaaleeyyeti welti laakko'emeeni» hiyyendeexxi muuxende.)<note caller="+" style="f"><char style="fr" closed="false">15:28 </char><char style="ft" closed="false">Kunni yaadi sirtike addatemeek mirqisanjo maxaafa'ni hedhebaan. </char></note> <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />Ora ookkonee sa'aammaki manninna umo le'misa'ni isoo hiyya'ni yowwaamma qici, «Ee! Ati Woyyichcha Galma diiggettexxi sase barra'ni ijaartattoki, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />amo mee! Ta'a fannotenaa'ni dirrite'e umo atika anjir!»<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Iittanni qeesetiki akeekisanjuwwinna Muuseke seerik barachchiisalluwwi isoo coora'ni weli'anni weli hiyyee qici, «Isi wele manna anjire'een; umo ifika kinni anjira dande'ebaani; <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Isi Kiristoosi Isira'eelike moyaanjo kado'oole, ta'a fannotenaa'ni dirrowaali; no'onna uunde iso'ni amanno!»</para>
  <para style="p" vid="MRK 15:32">Iittani isinni welti fannisemeemakiirinna isoo yowwa'nemmani.<verse eid="MRK 15:32" /></para>
  <para style="s1">Yessuussixxa Rewo</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat. 27:45-56</ref>; <ref loc="LUK 23:44-49">Luq. 23:44-49</ref>; <ref loc="JHN 19:28-30">Yoh. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Jaane saatenaa'ni sallane saate qico'ni bogi duuchchi dukkane. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Sallane saate geye wodda Yessuusi hafuura gikki asse'e: «Elohe! Elohe! Laama sabaqitaani?» hiyye. Tika isexxinna «Anke Mageno! Anke Mageno! Mayee anee waaldette?» hiyyateni. <verse eid="MRK 15:34" /><verse number="35" style="v" sid="MRK 15:35" />Ookko uurreemmake mannanaa'ni mitti mitti tenne laqee wodda, «Isi Eelyaasii'i ye'a'neeni» hiyye. <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />Inisa'ne giddii'ni mitti manji gonge mareexxi majaja'neexxa woyintixxa booka giddo Ispoonje cuupheexxi siqqichchotixxe qacce'ni ugge'e ha'waashsha Yessuussi'a shiqisheexxi «Waalle Eelyaasi dageexxi isoo dirrisaaxxe uundannoni!» hiyye.<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Ookkonechchinni uduma Yessuusi hafuura gikki assee raareexxi lubbo ifixxa sa'isse'e uwwe.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Woyyichchi Galmiki seemmati golinna iimi'ni butta geyaa qico'ni lameba dareme. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Fanno Yessuussixxi edo uurreemmaki dhibba loliinka manna ajajammak Yessuussi raareexxi lubbo ifixxa iitta sa'isse uwwe'naa uudee wodda: «Kunni manjichchi dhugaandini Mageniinke Beltommani» hiyye.<verse eid="MRK 15:39" /></para>
  <para style="s1">Golgoota Hexxemmaxxa Melaalle</para>
  <para style="r">(<ref loc="MAT 27:55-56">Mat. 27:55-56</ref>; <ref loc="JHN 19:25-27">Yoh. 19:25-27</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Ookkone wodda melaalle bayyanni hexxe tennee uudaamman. Insa'nee giddii'n Megidelixxi Maarami, shiixxoke Ya'iqoobixxinna Yoosaxxi ama Maarami iittanni Seeloomeer ookkoo he'nemmani. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Tinni melaalle duuchcha Yessuusi Geliila hedhemma wodda: isoo hordonfa'ni isi'a ergatendaammaxxeramman. Higgeenni isinni welti Iyyerusaalemi'a daggeexxi wele heddo melaalle hexxemmani.<verse eid="MRK 15:41" /></para>
  <para style="s1">Yessuussixxa Moogensha</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat. 27:57-61</ref>; <ref loc="LUK 23:50-56">Luq. 23:50-56</ref>; <ref loc="JHN 19:38-42">Yoh. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Bogi hashsha wodda edike sanbati'a qixxeeffantammaxxe yanna kadde. <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Ookkone wodda ulfeessemeek Yihudiinxe songoxxe geedhenaa'ni mitti Mageniinxa moottumma heqqedhaammak Armatiyaasike qachchik manji Yooseefi soda'a belo Philaaxoosibaa mareexxi Yessuusika rensha uwwi hiyye isoo kadhate. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Philaaxoosinna iikki woddi reeyeexxa laqeexxi mambe'a hiyye. Isinna dhibba loliinka manna ajajaammaka manjichhco ye'eexxi isi reyeexxenni hitteexxa yanna geyeexxa isoo qore. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Isinna Yessuussixxa rewo dhibba loliinka manna ajajaamamkenaa'ni laqe qullesseechchi uduma rensha Yooseefi'ni uwwe. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Yooseefinna isoo mirqaaxxa seemma hire; isinni Yessuussika rensha fannotenaa'ni dirriseexxi seemmati miriqeechchi uduma kino qontede giisseendeke hirreessa'ni ugge; hirreessiinxa hulananna kinjik cufe. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Megidelixxi Maaraminna Yoosaxxi ama Maarami, Yessuussi'i haba uggineexxa uundaammani.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s1">Yessuussi Rewotenaa'ni Ke'eexxa</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mat. 28:1-8</ref>; <ref loc="LUK 24:1-12">Luq. 24:1-12</ref>; <ref loc="JHN 20:1-10">Yoh. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Edike sanbatixxi barra saxxeechchi uduma, Megidelixxi Maarami, Ya'iqoobixxi ama Maaraminna Seeloomeera kandeexxi Yessuussike rensha'ni fiffinxaaxxa shitto hirre. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Torbatixxa siretixxa barra gorsa bariisa arishsho fuldeeshshanni insa'nee moogiinbaa me'inaaman; <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />insa'nenna, «Ayyete no'o'a moogiinxe balenaa'ni kinjo goggo'misha?» hina'ni weli'anni weli haasonnaammani. <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Yaane kinni insa'ne toggi hine uundaa wodda, iikki heenobaaki kinji mooggiinxe hulanaa'ni goggo'mee'naa uunde. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Insa'nenna hirreessi giddi'a e'yineeshshanni, golalooxxa seemma oddo'week dargaggeesi middi darree'ni ofo'lee'na'aa uundeexxi alanne. <verse eid="MRK 16:5" /><verse number="6" style="v" sid="MRK 16:6" />Isi kinni insa'nee hiyyee qici, «Alaltinoqqe'e; ha'no hassina'neeki fannisemeemmake Naazireetike Yessuusin. Isi mooggokenaa'ni ke'edheeni; kaba hedhebaani; isoo moongeemmak boonchi kunse uudde! <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Yaane kinni ha'no martineexxi hordofeeyyete'ninna Pheexiroosi'n, ‹Isi ha'no'a edise Geliila'a me'aani. Isi ha'no'ni kuleemmashshanni ookko isoo affinaani› hitine insa'ne'ni kulle.» <verse eid="MRK 16:7" /><verse number="8" style="v" sid="MRK 16:8" />Melaalletinna alayyik roqonsita'n hirreessinbaa'n baajje fulde: insa'nenna lumo qico sodaanteemmaxxee ayye'ninna mittechchonna haasonnebaani.<verse eid="MRK 16:8" /></para>
  <para style="s1">Yessuusi Megideelike Bogixxe Maarami'n Leelleexxa</para>
  <para style="r">(<ref loc="MAT 28:9-10">Mat. 28:9-10</ref>; <ref loc="JHN 20:11-18">Yoh. 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />Yessuussinna torebatixxe sirtixxe barra'ni, gorsa bariisa reyotenaa'ni ke'echchi uduma torbaane durriissa ise giddii'ni fulcheemmaaxxe Megidelixxi Maarami'ni sire leelle. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Isenna marteexxi isinni welti hedheemmakiir yaada'ni oodha'naa isi rewotena'ni ke'eexxi hedhoti hedheexxanna ise'ni leelleexxa insa'ne'n kulde. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Insa'ne kinni iseka haaso'a amanneba'a.<verse eid="MRK 16:11" /></para>
  <para style="s1">Yessuussi Lame Hordofeeye'n Leelleexxa</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luq. 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Ookkonechchinni uduma hordofeeyye isixxi giddii'n lame hadi giddi'a me'itaa'naa wele bifanni insa'ne'n leelle. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Insa'nenna illeema hingeexxi wele gatteemmaxxee hordofeeyye'ni kulle; kaddo malee insa'ne kulleexxanna amanneba'a.<verse eid="MRK 16:13" /></para>
  <para style="s1">Yessuussi Tommenna Mitte Ergameeyye'ni Leelleexxa</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat. 28:16-20</ref>; <ref loc="LUK 24:36-49">Luq. 24:36-49</ref>; <ref loc="JHN 20:19-23">Yoh. 20:19-23</ref>; <ref loc="ACT 1:6-8">Erga. Huj. 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Ookkonechchinni uduma Yessuussi tommenna mitte hordofeeyye ifixxi itate'ni hexxeeba insa'ne'n leelle: «Isi rewotenaa'ni ke'eechi uduma isoo uuddeeki manni insa'ne'n kuleexxa amanna gonpheemmaxxee isi amana gopha insa'neexxanna qalbe insa'neexxika jabeenna uudeexxi insa'nee xixe.» <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />Yessuussinna insa'ne'n hiyyee qici, «Butta duuchcha'n me'e; eloxxa odonna manjo duuchcha'ni lallabbe. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Amaneekinna xammaqemeek anjiremaan; amanebake'ni kinni murte iso'n murendaani. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Ane'ni amanaaki duuchchi mambe'a assatika beessisuwwa alfaan: insa'nenna anke summinni fuggichcha hafuura fulchinaani: harrooke laagadinninna haassonnaani. <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />Insa'ne bofuwwa angati abindaan; shiltaaxxa ha'la ha'winoolenna midde insa'ne'e miittabaani; angatanna elagopheeke manni hana ugginaa wodda mannikinna fayyaani.»<verse eid="MRK 16:18" /></para>
  <para style="s1">Yessuussi Iimi'a Adhdhemeexxa</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luq. 24:50-53</ref>; <ref loc="ACT 1:9-11">Erga. Huj. 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Gootti Yessuusi tennee insa'ne'n kuleechchi uduma iimi'a me'e. Isinna Mageniinke midda'ni ofo'le. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Ookkonechchi uduma hordofeeyye isixxi booncho booncho duuchcha'ni mammarenda'ni lallabe. Goottikinna insa'nenni welti huja'nemaani. Insa'ne'aanna beessisuwwa hunjaaka baallooma uwwati insa'nee barachchiiseemmaxxi barachcho dhugaatixxe kaddeexxa kokeessaamman.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>