<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EZK" style="id">- Gedeo Bible</book>
  <para style="h">Hiziqi'eelikaa Raaga</para>
  <para style="toc1">Hiziqi'eelikaa Raaga</para>
  <para style="toc2">Hiziqi'eelikaa Raaga</para>
  <para style="toc3">Hiz.</para>
  <para style="mt1">Hiziqi'eelikaa Raaga</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Wabeeki Hiziqi'eli Iyyerussaalemi Kirsitosixxe ilensha edi darre 586 wogga'ni diigendebang edi gamanna diigendebaa uduma baqiki Baabilon hedhaamman: isiki wabeekumatik hiyyichchi haso'emeeki Baabilon'i baqiki hedheemmakenna Iyyerussaalemi giddo hedha'neke ardi'atemman. Wabekichchi Hiziqi'eelik maxaafi shoole umo umo affeeka kutuwwa afeedhen.</para>
  <para style="ip">1. Duuchchi Woddike Goottixxi murte ardake'ni daga shiqqeexxa, Iyyerussaalemixxa abidenshanna diigensha shiqqeexxa xexxe'achchiisaaxxa ergaa.</para>
  <para style="ip">2. Duuchchi Woddik Gootti arda ifika miicekanna dedhiseeka garigarti hexxeexxi mootumma xixenda'neexxa kulemeek hiyyichcho.</para>
  <para style="ip">3. Iyyerussaalemixxe iba uduma Isira'eeli jajjabeessatee uwwendeexxa erganna edi'a eloxxe kaayonni futti hinaaxxa addachchiisee haasao'emeeka hiyyichcho.</para>
  <para style="ip">4. Woyyichchi Galminna Iyyerussaalemixxi mootumma ediba'a higgaaxxa Hiziqeeli fakketti qopheessexeeran.</para>
  <para style="ip">Hiziqi'eel jabaxxa amananna qalbefachchotike manjomman. Heger kaddaxxa yaane yo'oshsha uudeke akitokko leellatixxe bifannitemman: isixxe erga giddii'ni saxxeexxiir ca'a hiteexxe mammaassinshatemman. Hiziqi'eel ca'a asse leellisheexxi giddixxe qalbekanna hafuurinxi jijjirensha hasisaaxxe kaddeexxa mitti mitting manji umo ifikixxe cubbo'a qorma'neexxa, tennenninni mitteba ardiinxi hedho jijjirendaaxxa addachchiise barrise'en; Hiziqi'eel qeesichchokenna wabeekake kadeemmaxxee woyyichcha galminxenna woyyumatixxee gargar hedheeka yaada leellisheen.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Hiziqi'eel Duuchchi Woddik Goottika ulfinna uudeexxanna isi wabeekake kade filemeexxa <char style="ior"><ref loc="EZK 1:1-3:27">1:1—3:27</ref> </char></para>
  <para style="io1">Yihudanna Iyyerussaalemi diigenda'nexxa Hiziqi'eel fakkeennik aaggashsha kuleexxa <char style="ior"><ref loc="EZK 4:1-5:17">4:1—5:17</ref> </char></para>
  <para style="io1">Ba'ne gelteexxa <char style="ior"><ref loc="EZK 6:1-7:27">6:1—7:27</ref> </char></para>
  <para style="io1">Duuchchi Woddik Goottik ulfinni cubbitte Iyyerussaalemi waaleexxa <char style="ior"><ref loc="EZK 8:1-11:25">8:1—11:25</ref> </char></para>
  <para style="io1">Yihudaxxanna Iyyerussaalemixxa iba <char style="ior"><ref loc="EZK 12:1-24:27">12:1—24:27</ref> </char></para>
  <para style="io1">Wele boguwa'ni saxxeexxa murte <char style="ior"><ref loc="EZK 25:1-32:32">25:1—32:32</ref> </char></para>
  <para style="io1">Ardi ifixxe cubbonaa'ni higaashsha Hiziqi'eel xexxe'achchiisa hasisaaxxa <char style="ior"><ref loc="EZK 33:1-20">33:1-20</ref> </char></para>
  <para style="io1">Iyyerussaalemixxe ibaxxa odo <char style="ior"><ref loc="EZK 33:21-22">33:21-22</ref> </char></para>
  <para style="io1">Arda ifika hiissa'nexxanna Yihudaa anjira'neexxa Duuchchi Woddik Gootti addachchiisee qico <char style="ior"><ref loc="EZK 34:1-37:28">34:1—37:28</ref> </char></para>
  <para style="io1">Googi injifateme'na Isira'eel higga'neexxa <char style="ior"><ref loc="EZK 38:1-39:29">38:1—39:29</ref> </char></para>
  <para style="io1">Hiziqi'eel edi'a hujema'neeke woyyichchi galmixxe'e uudeexxa waleella <char style="ior"><ref loc="EZK 40:1-46:24">40:1—46:24</ref> </char></para>
  <para style="io1">Woyyichchi Galmi hundii'ni yaa'a'neeke wedi'ixxee <char style="ior"><ref loc="EZK 47:1-12">47:1-12</ref> </char></para>
  <para style="io1">Isira'eeltote'e higaaka siretike geegixxa gabalanna gosa gosake ardi'a assemeeka qooddo <char style="ior"><ref loc="EZK 47:13-48:35">47:13—48:35</ref> </char></para>
  <chapter number="1" style="c" sid="EZK 1" />
  <para style="s1">Hiziqi'eeli Edise Udeexxa waleella, Duuchchi Woddike Goottixxa Moote</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 1:1" />Sase tomme wogga'n sholgake agenjixxe ondixxe barra'n Kebaarike galaani qarqara booji'emeemmake mannixxe oddo'n hedhee'naa, iimmuwwa banende; aninna Mageniinxa waleella uuddenne.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="REV 19:11">Wal. 19:11</ref>. </char></note><verse eid="EZK 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZK 1:2" />Moyanji Iyo'aakinni booji'emeexxe ondixxe wogga'n sholgake agenjixxe ondixxe barra'n,<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="2KI 24:10-16">2 Moy. 24:10-16</ref>; <ref loc="2CH 36:9-10">2 Odo. 36:9-10</ref>. </char></note> <verse eid="EZK 1:2" /><verse number="3" style="v" sid="EZK 1:3" />Baabiloonke mannike boga'n Kebaarike galaani bira Duuchchi Woddike Goottik hiyyichchi Buuzike belto'n anee qeessichcho Hiziqeeli'n dage; ookkonna Duuchchi Woddike Goottixxi hunna ane'ni hexxemman. <verse eid="EZK 1:3" /><verse number="4" style="v" sid="EZK 1:4" />Aninna tammi asse uudenne wodda hobonbalte middi darrenaa'n dagge; tinninna jabaki ifinninni elqe kayyii'n buqqeexxe, banqo balaaqisaammak ha'uraake duumanchamman; eettene giiraxxe oddo giddi holateeke sibiljo fakkaata'nemman. <verse eid="EZK 1:4" /><verse number="5" style="v" sid="EZK 1:5" />Ise giddonna shoole manjo fakkaattaaxxi dada hexxemman.<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="REV 4:6">Wal. 4:6</ref>. </char></note> <verse eid="EZK 1:5" /><verse number="6" style="v" sid="EZK 1:6" />Yaane kinni mitti mittiing shoole albanna shoole keela afeeman. <verse eid="EZK 1:6" /><verse number="7" style="v" sid="EZK 1:7" />Lekka konneechchiirixxi toggi hiteexxemman; lekkattixxi faannanna jabbettixxe kotteshsha hexxeexxe kaddaa wodda lekkattinna morondemeeke sagetootike sibilsha cala cala hitaa'emman. <verse eid="EZK 1:7" /><verse number="8" style="v" sid="EZK 1:8" />Eetten Shoolii darre'n manjo fakkaattammaxxe daduwwa keelluwwi hunda manjiinxe anga fakkaattaaxxe anguwwa hexxemman; koonneechchuwwik shooliingi albuwwinna keelluwwa afe'eeman. <verse eid="EZK 1:8" /><verse number="9" style="v" sid="EZK 1:9" />Konneechchuwwik keelluwwinna weli'aanni weli tuqa'eemman; mitti mittingi toggi hiyye edi'a me'aa'nemman; udumi'aanna wirri hiyye uunda'emabaan. <verse eid="EZK 1:9" /><verse number="10" style="v" sid="EZK 1:10" />Konneechchuwwik albuwwinna labaama qici: shooliingi mitti mitti edi darre'n manjiinka alba afe'eemmaaran; middi darree'n neenqiinka alba, bita'i darree'ninna jibbichchiinka alba afe'eemaaran; mitti mittingi kinnichchiiri udumii'n sinbiriinka alba afe'eemmaaran.<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="EZK 10:14">Hiz. 10:14</ref>; <ref loc="REV 4:7">Wal. 4:7</ref>. </char></note> <verse eid="EZK 1:10" /><verse number="11" style="v" sid="EZK 1:11" />Yooni kunni qici albi konneechchuwwik fakkaataamma qicon. Konneechchuwwik Keelluwwinna iimi'a farri hiyyeemman; kunni mitti mittingichchuwwi lame lame keela afe'eemman; mitti mittiniingik keeli weliinka keela tuqa'eemman; konneechchuwwik lami lami keeluwwi biso konneechchuwwika buqa'emman. <verse eid="EZK 1:11" /><verse number="12" style="v" sid="EZK 1:12" />Mitti mittiniingi kunnichchuwwi edi'a toggi hiyye me'a'neemman; udumi'aanna wirri hiyyebaangi Mageniink hafuuri me'aammaba duuchchiinbaa me'a'neemman. <verse eid="EZK 1:12" /><verse number="13" style="v" sid="EZK 1:13" />Tenne hedho affeexxe daduwwaxxi bifa ha'yita'neexxe giirake kashilo yookaan buba'neeke bubanjo fakkaata'eemman; eettene daduwwaxxe oddo'ninna giira elqenna kayya higa'n ha'yaammake qaqqassunjishsha lele'mita'emman; ifikkinna wa'a hiyyeemmakeemman; eettene giira giddii'ninna banqo fulda'nemman. Elqe kayya darbenda'emmani. <verse eid="EZK 1:13" /><verse number="14" style="v" sid="EZK 1:14" />Iitti hedho affe'eexxi daduwwanna banqotike balaqishsha elqe kayya xalqise. <verse eid="EZK 1:14" /><verse number="15" style="v" sid="EZK 1:15" />Tenne hedho affe'eexxa daduwwa tammi asse uudenne wodda eettene shoole albuwwa afe'eemmaxxe mitte mittende dada bira butti darree'n mitte mitte mole afenne.<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="EZK 10:9-13">Hiz. 10:9-13</ref>. </char></note> <verse eid="EZK 1:15" /><verse number="16" style="v" sid="EZK 1:16" />Eettene mitte mittende molexxi bifanna giissendeemma qici: fiixe'eeke kinjishsha cala cala hitaa'eemman; iitti shooliinxi mole weli labbaaxxe kaddeexxi mitte mittend mole wele mole giddo sikkendeexxi giissendeexxe fakkaatta'nemman. <verse eid="EZK 1:16" /><verse number="17" style="v" sid="EZK 1:17" />Me'itaamma woddanna daduwwa welebaa wirri hitebaang shoolii darre duuchcha'n me'a dandeeta'eemman; daduwwa me'itaa woddanna moluwwa elqe kayyi'a hita'eemmabaan. <verse eid="EZK 1:17" /><verse number="18" style="v" sid="EZK 1:18" />Moluwwatinna lumoxxenna sodaachissaaxxemman; shooliinxe moluwwake kasike qarqara'ni illuwwa wo'mitteemman.<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="REV 4:8">Wal. 4:8</ref>. </char></note> <verse eid="EZK 1:18" /><verse number="19" style="v" sid="EZK 1:19" />Iitti hedho affe'eexxi daduwwa lele'mitaa wodda qarqara konneechchuwwike'n hexxeexxi moluwwanna lele'miitaamman; iitti hedho affe'eexxi daduwwa buttii'n iimi'a qophphi hitaa wodda iittti moluwwanna weltinni iimi'a qophphi hita'eemman. <verse eid="EZK 1:19" /><verse number="20" style="v" sid="EZK 1:20" />Daduwwa Mageniink Hafuuri me'ee boonchi duuchchibaa me'itaamman; iikki hedhotik Hafuuri moluwwa giddo hedheemmaxxee moluwwa insa'nenni welti kexxaamman. <verse eid="EZK 1:20" /><verse number="21" style="v" sid="EZK 1:21" />Daduwwa lele'mitaa wodda moluwwa lele'mitaan; hedho affeexxi daduwwa uurritaa wodda moluwwatinna uurritaan; daduwwa butti'n iimi'a qophiphi hita wodda moluwwa giddo hedhotik Hafuur hedhemaxxee'e moluwwatinna daduwwati welti iimi'a qophphi hitaan. <verse eid="EZK 1:21" /><verse number="22" style="v" sid="EZK 1:22" />Hedho affeexxe daduwwa umi iimi darre sodaachisachchinna daa'witetishsha calacala hiyye ille siphphi siphphi assaachchi dhisendeexxe iima fakataachchi isi iimi darre hedheman.<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="REV 4:6">Wal. 4:6</ref>. </char></note> <verse eid="EZK 1:22" /><verse number="23" style="v" sid="EZK 1:23" />Dhisendeexxe iima butti darrenna mitte mittendi dada keeluwwa welekiba'a farri hiyyeekanna biso ifika buqexxaaxxa lame keela affe'eemman. <verse eid="EZK 1:23" /><verse number="24" style="v" sid="EZK 1:24" />Hedho affeexxi daduwwa me'itaa wodda keela isekika luuljo laqenne; luuljikinna dageemmake wedi'ike luuljishsha Dada Duuchcha ajajaake Magenixxe dindinsoshshanna loliinke mannike cancishshatemman; me'a waaldaa wodda keeluwwa ifika bukki assexxaan. <verse eid="EZK 1:24" /><verse number="25" style="v" sid="EZK 1:25" />Me'a waaldeexxi keeluwwa bukki assexxeeshshanni umo iseki iimi darre hexxeexxe dhisendeexxe iima iimi darree'n hafuuri laqeme.<note caller="-" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="REV 1:15">Wal. 1:15</ref>; <ref loc="REV 19:6">19:6</ref>. </char></note> <verse eid="EZK 1:25" /><verse number="26" style="v" sid="EZK 1:26" />Umi isek iimii darre hexxeexxe dhisendeexxe iima iimi darre senpheere hiyyemaake fiixxeke kinjixxe moote fakaataachchi hedhemman; mooteti hananna manjiinxa bifa fakkaataki hedhemani. <verse eid="EZK 1:26" /><verse number="27" style="v" sid="EZK 1:27" />Hidha isike fakkaatachchinni iimi'a giirattixxe oddo'n hedheeke holateeke sibiljishsha, hidhiki butti'a giira fakkaata'naa uudenne; wa'a hiyyeek ifinna qarqara isike'n hedhemman.<note caller="-" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="EZK 8:2">Hiz. 8:2</ref>. </char></note> <verse eid="EZK 1:27" /><verse number="28" style="v" sid="EZK 1:28" />Xeeniinxa barra duummanchi giddo leellammake dowwichchiinsha qarqara isike'n hedhemmak wa'a hiyyeek ifi ittandemman.</para>
  <para style="p" vid="EZK 1:28">Kunninna Duuchchi Woddike Goottike ulfinnike fakkeennamman. Aninna isoo uuddenne wodda albikii buttinake'n gonbisemennexxi haasoa'neeke mitte manjika hafuura laqenne.<verse eid="EZK 1:28" /></para>
  <chapter eid="EZK 1" />
  <chapter number="2" style="c" sid="EZK 2" />
  <para style="s1">Hizqi'eelixxa Ye'ensha</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 2:1" />Isinna anee'e, «Koo manjiinke belto iimi'a kexxettexxi uurri; ani ate'ni haaso'aannen» hiyye. <verse eid="EZK 2:1" /><verse number="2" style="v" sid="EZK 2:2" />Isinna haaso'aa wodda Mageniink Hafuuri ani giddo e'yeexxi lekkati anee'e uurrisseexxi ane'ni haaso'aa'naa laqenne. <verse eid="EZK 2:2" /><verse number="3" style="v" sid="EZK 2:3" />Isinna ane'ni hiyyee qici: «Koo manjiinke belto ane'n jalleeke ookkone jallichcha Isira'eelike ardibaa atee erga'enneni; insa'nenna annuwwi insa'nek telchi qico'n ane'n jalline'een. <verse eid="EZK 2:3" /><verse number="4" style="v" sid="EZK 2:4" />Kunni ardinna alba gudunfaakenna hinaaxxa laqabaaken; ani atee insa'nebaa ergaannen; atinna ‹Lumok Duuchchi Woddik Gootti hiyya'nee qici› hita'n insa'ne'ni kuli. <verse eid="EZK 2:4" /><verse number="5" style="v" sid="EZK 2:5" />Insa'ne jallaameessa arda kandemmaxxee, hitattoxxa lanqoolenna laqanna gonphoole oddo insa'nexxe'n wabeekkichchi hedheexxa egennaan. <verse eid="EZK 2:5" /><verse number="6" style="v" sid="EZK 2:6" />Koo manjinike belto ati insa'nee yookaan haaso'a insa'neka sodaattoxxee; qarqara atike'n hagalakenna qu'muudo hexxeenaa gaadduwwattixxe oddo'n ofoldotolenna sodaattoxxee. Insa'ne jallichcha arda kandoolenna ati insa'ne hinaaxxe yaane'ni insa'nee sodaattoxxee; insa'ne atee mee alalishshinowwaali. <verse eid="EZK 2:6" /><verse number="7" style="v" sid="EZK 2:7" />Insa'ne jalichcha arda kandeemmaxxee; lanqolenna laqa gonphoole ati hiyyichcho anka insa'ne'a kuli. <verse eid="EZK 2:7" /><verse number="8" style="v" sid="EZK 2:8" />Ati kinni koo manjiinke belto; ani atee hiyyaannexxa laqi; ookkone jallaameessa ardishsha atinna jallittoxxe'e; afo'o atika haanni hiyyi, ate'ni uwwaannechchonna iti» hiyye. <verse eid="EZK 2:8" /><verse number="9" style="v" sid="EZK 2:9" />Ookkonechchi uduma tami asse uudanno wodda mitte anga anba'a diriirte'naa afenne; ise giddonna mirqisanjo Maxaafa hedhemman. <verse eid="EZK 2:9" /><verse number="10" style="v" sid="EZK 2:10" />Isinna maxaafa ani edo farri asse; Maxaafake'ni giddi gadhii'ni, wi'lishatiki, yaaddottikinna hunbaashshatik hiyyichchuwwi itti borreesseme'emman.<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="REV 5:1">Wal. 5:1</ref>. </char></note><verse eid="EZK 2:10" /></para>
  <chapter eid="EZK 2" />
  <chapter number="3" style="c" sid="EZK 3" />
  <para style="p">
    <verse number="1" style="v" sid="EZK 3:1" />Isinna ane'n «Koo manjiinke beltoo! Ati edo hedheeka iti; konnee mirqisanjo Maxaafa ittee martettexxi Isira'eelike arda'n haaso'i» hiyye.<note caller="-" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="REV 10:9-10">Wal. 10:9-10</ref>. </char></note> <verse eid="EZK 3:1" /><verse number="2" style="v" sid="EZK 3:2" />Tennexxee afo'o haanni hiyyenne; isinna mirqisanjo Maxaafa itonnaa'a uwwe. <verse eid="EZK 3:2" /><verse number="3" style="v" sid="EZK 3:3" />Ookkoneechchi uduma isinna anee, «Koo manjiinke beltoo! Ani ati'ni uwwaanneka konne mirqisanjo Maxaafa ittee godoba wonshedhi» hiyye; aninna iso'o itenne; isinna afo'i giddo ane'ni malebiinsha xe'me. <verse eid="EZK 3:3" /><verse number="4" style="v" sid="EZK 3:4" />Isinna ookkoneechchi uduma ane'ni hiyyee qici: «Koo manjiinke belto kexxettexxi Isira'eelike ardibaa mari; hiyyichcho ankanna insa'ne'ni kuli. <verse eid="EZK 3:4" /><verse number="5" style="v" sid="EZK 3:5" />Ati Isira'eelike ardi baate malee'e haaso'i rakkisaakenna laagada egendebexxoke ardibaa ergende'ebexxon. <verse eid="EZK 3:5" /><verse number="6" style="v" sid="EZK 3:6" />Haaso'i insa'nek rakkisaakenna laagada insa'neka egendabexxoke, hiyyichchi insa'nekinna ate'n aagabaake hedi ardibaa atee ergebo'non. Insa'nebaaat atee ergene'enele dhugaaten insa'nee ati hitattoxxa lanqamman. <verse eid="EZK 3:6" /><verse number="7" style="v" sid="EZK 3:7" />Yaane kinni Isira'eeliki ardi duuchchi alba gudunfeekkenna hiyyendeexxa laqabaake kadeemmaxxee ani hiyyeennexxa lanqo'a gammandebaan; tennexxee Isira'eelik ardi ati hitattoxxa laqabaan. <verse eid="EZK 3:7" /><verse number="8" style="v" sid="EZK 3:8" />Yaane kinni ani atee insa'neshshyanni rifattabexxokenna alba gudunfiteeteke assannon. <verse eid="EZK 3:8" /><verse number="9" style="v" sid="EZK 3:9" />Ani atee rifataboxxoke, cabbetike kinji caala jabake assannoni. Insa'ne jallaameessa arda kandoolenna midde insa'nee mee sodaati; yookaan insa'ne'a alalittoxxe'e.»<verse eid="EZK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 3:10" />Isinna anee «Koo manjiinke belto! Ani ate'ni hiyyaaneka hiyyichcho duuchcha xexxe'achchoti laqi; godobanna galchedhi. <verse eid="EZK 3:10" /><verse number="11" style="v" sid="EZK 3:11" />Kexxettexxi booji'emeeke atike bogike manniba'a martettexxi insa'ne'a kuli; lanqoole laqqanna gonphoole ‹Lumok Duuchchi Woddiki Gootti hiyya'nee qici› hite insa'ne'ni kuli» <verse eid="EZK 3:11" /><verse number="12" style="v" sid="EZK 3:12" />Ookkoneechchi uduma Mageniink Haafuuri anee'e iimi'a qophphi assee ke'isse; Duuchchi Woddike Goottiki ulfinni galiduma ifikixxe bakkanaa'n ke'ate'ni hedhee'naa ani udumi'n lumoxxa gigi'weete laqenne.<note caller="+" style="f"><char style="fr" closed="false">3:12 </char></note> Mitte mitte tikuwwa Duuchchi Woddik Gootti gaduma ifikixxe bakka'ni saademowwaal. <verse eid="EZK 3:12" /><verse number="13" style="v" sid="EZK 3:13" />Kunninna hedho affeexxe daduwwak keeluww weli'aani weli ganemaa woddanna qarqara insa'neeke'ni hexxemmaxxi moluwwa laqisaammaxxi jabaxxe gigiweettemman. <verse eid="EZK 3:13" /><verse number="14" style="v" sid="EZK 3:14" />Mageniink Hafuurinna anee iimi'a qophphi asse aadhe me'e; aninna hifotinna aareti me'enne; Duuchchi Woddike Goottixxi jabaxxi hunna ane'ni hexxemman. <verse eid="EZK 3:14" /><verse number="15" style="v" sid="EZK 3:15" />Ookkoneechchi uduma booji'emeexxi Keboorike galaani bira Teeli'abibi giddo hedhammake manniba marenne; alayyik hawwi hiyyeennexxi torbaane bara insa'ne giddo insa'nenni welti ofo'lenne.<verse eid="EZK 3:15" /></para>
  <para style="s1">Hiziqi'eeli Heqanjummatee Hariremeexxa</para>
  <para style="r">(<ref loc="EZK 33:1-9">Hiz. 33:1-9</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 3:16" />Torbaane barra uduma Duuchchi Woddike Goottiki hiyyichchi ane'n dagee hiyyee qici: <verse eid="EZK 3:16" /><verse number="17" style="v" sid="EZK 3:17" />«Koo manjiinke beltoo! Ani atee Isira'eelike ardike heqqanjo asseennen; tennexxee hiyyaannexxa laqi; ate'n kulannoxxa anxa xexxe'achchiisa insa'ne'ni sa'issite kuli. <verse eid="EZK 3:17" /><verse number="18" style="v" sid="EZK 3:18" />Ani cubballeessa manjo ‹Dhugaadinni rertaton› hiyyeennexxa yanna ati iso'o xexxe'achiisa gophphottole, lubbo ifixxanna fayyirso'a fuggoxxe hujenaa'n higaashsha iso'ni kula gophphotole, iikki cubbichchi cubbo ifixxenninni reyyaani; isixxe reyo'a atee qorannon. <verse eid="EZK 3:18" /><verse number="19" style="v" sid="EZK 3:19" />Yaane kinni cubbichchi manji xexxe'achchiise'naa'n cubbotenaa'ninna fuggoke oranaa'n higa gophphoole, isi cubbo ifinxee reyaani; atinna kinni lubbo atixxa anjidhitatton.<verse eid="EZK 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 3:20" />«Qulchi manji kinni qulumma ifixxenaa'n udumi'a higeexxi cubbo hujoole, aninna isi edo gugguffachcho uggoonnole reyaan; atinna xexxe'achchiisa gophpheettaxxe'e cubbo ifixxenni reyaan; asseemmaxxi qullummanna isi'a hedendabaan; isixxe reyo'a ani atee qorannoni. <verse eid="EZK 3:20" /><verse number="21" style="v" sid="EZK 3:21" />Yaane kinni qullichchi manji cubbo hujabaashsha xexxe'achchiise'naa isinna cubbo huja gophphoole, xexxe'achcho adhdheemmaxxee dhugaate'n hedhoti hedhaan; atinna lubbo atixxa anjidhitatton.»<verse eid="EZK 3:21" /></para>
  <para style="s1">Hiziqi'eelike Ardixxa Abidensha.</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 3:22" />Ookkonna Duuchchi Woddike Goottixxi hunna ane'ni hexxemman; isinna anee, «Kexxettexxi dhooqatibaa mari; ookkoo ate'ni haaso'annon» hiyye. <verse eid="EZK 3:22" /><verse number="23" style="v" sid="EZK 3:23" />Aninna ke'ennexxi dhooqatibaa marrenne; tami asse uuddanno wodda Keboorike galaani bira uudeennake ulfinnika ulfinna, Duuchchi Woddike Goottik ulfinni ookko uurreemman; aninna albik edi'a gonbisemenne.<verse eid="EZK 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 3:24" />Mageniink Hafuuri ani giddo e'yeexxi lekkati anee uurrise ane'ni hiyyee qici: «Atiba mini'a e'yitee hula culfi. <verse eid="EZK 3:24" /><verse number="25" style="v" sid="EZK 3:25" />Koo manjiinke beltoo! Atee golleenabaa'n fulde ardi giddo mammarendabexxoshsha wodaroti atee usurraan. <verse eid="EZK 3:25" /><verse number="26" style="v" sid="EZK 3:26" />Tennexxee jallaameessa arda kandeemmaxxeenna insa'nee xixxaboxxoshsha arrabo atika burqake'ni abidissannon; afo'okanna duuddatton. <verse eid="EZK 3:26" /><verse number="27" style="v" sid="EZK 3:27" />Yaane kinni ani ate'ni haaso'anno wodda afo'o atika banannon; atinna, ‹Lumoki Duuchchi Woddiki Gootti hiyya'nee qici› hita'n insa'ne'ni haasottatton. Insa'ne jallaameessa arda kandeemmaxxee laqaaki laqowaali; laqabaakinna laqoqqe'e.<verse eid="EZK 3:27" /></para>
  <chapter eid="EZK 3" />
  <chapter number="4" style="c" sid="EZK 4" />
  <para style="s1">Iyyerusaalemi Naaphixxi Buqensha Fakkeenniik Kulema</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 4:1" />«Koo manjiinke belto faarinxa mitte xuube aaxxee ati albi edi darre uggitee Iyyerusaalemike qachchika kaarta itti giissi. <verse eid="EZK 4:1" /><verse number="2" style="v" sid="EZK 4:2" />Ookkoneechchi uduma lolinki manni isee buqeemmashsha assite buqi; ayyinna fulabaashsha dalla'a iseke qarqara'n giissi, loliinke mannixxa kollo dalla'i gadhi darre'n giissi, iimi qico'n buttinakanna tullub; dalla'a iseka diigaatika lumoke haqichchika gubbo qarqara isike'ni uggi. <verse eid="EZK 4:2" /><verse number="3" style="v" sid="EZK 4:3" />Sibljiinxa she'la aaxxettexxi atixxenna qachchiinxe oddo'n sibljinke dalla'ishsha uurrisi; fuggoxxe illenni ise'e uudi; isinna buqemeeke kadaan; atinna isoo buqqatton; tinni Isira'eelike ardi'a xexxe'achchiisatike beessisa kaddaan.<verse eid="EZK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 4:4" />«Ookkoneechchi uduma bita'ike cinaachcha'n diiphi; tinninna Isira'eelike ardi cubbo ifixxe xixeemaaxxa beessisake kaddaan; konne bita'ike cinaachcha'n irkattoxxee bariinke laakkossixxe qixxe'ni Isiraa'eeli ardi hitta xixeemaaxxa leellishshatton. <verse eid="EZK 4:4" /><verse number="5" style="v" sid="EZK 4:5" />Isira'eelik ardi cubbo ifixxee hitta xixeemaaxxa leellishatee 390 barruwwa irkattotta'a atee murronseennen; mitte mittendi itti barra mitte mitte xixichchiinxe wogga leellishshaan.<verse eid="EZK 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 4:6" />«Tennee iitta assa muuxxeteelchi uduma kinni Yihuda ardi cubbo ifixxee hitta xixeemaaxxa leellishatee middike cinaachcha'n iittanni 40 barra'a irkattotta'a ani atee murroonse'eennen; mitti mittendi barra insa'neke xixichchixxe mitte mitte wogga leellishaan. <verse eid="EZK 4:6" /><verse number="7" style="v" sid="EZK 4:7" />Alba atika Iyyerusaalemixxe buqenshaba'a wirri hiyyi; angatanna tunutumeessite ise'n raaga raagi. <verse eid="EZK 4:7" /><verse number="8" style="v" sid="EZK 4:8" />Buqenshatixxi barruwwanna muuxendaa qico'n mitti cinaachchinaa'ni mittinba'a wirri hitabexxoshsha wodaroti atee usurannon.<verse eid="EZK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 4:9" />«Dinnetanna so'a, baaqelakkanna misira iittanni mishinqanna darga'e aaxxe'e oddoolcho giddo uggitee ookkoneechchi uduma umo atengee ita ra'isedhi; sase dhibbanna sallane tomme barra cinaachik irkattatto wodda isee'e ittatton. <verse eid="EZK 4:9" /><verse number="10" style="v" sid="EZK 4:10" />Barra barra'nde'n oobo mitte, mikka'ni murendeexxe yanna'n ittaton. <verse eid="EZK 4:10" /><verse number="11" style="v" sid="EZK 4:11" />Ha'witattoka wode'enna mikka'ni barrate'ni lame bekeedhe murendeexxe yanna'n ha'witatton. <verse eid="EZK 4:11" /><verse number="12" style="v" sid="EZK 4:12" />Bageeke manjiinke fooli'a'ni giira ha'ishetexxi ardi duuchchii edo isoo so'iinke buddeenishsha ra'issexxe ittatton. <verse eid="EZK 4:12" /><verse number="13" style="v" sid="EZK 4:13" />Duuchchi Woddiki Goottinna, «Konne qicinni Isira'eelika arda gosa gosake ardi giddi'a xeerranno wodda battootteexxa ita itaan» hiyye.<verse eid="EZK 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 4:14" />Aninna hiisse hiyyeene qici, «Ee! dada Duuchchike duuchchi Woddike Goottaa! Haranga batto'e ege'nebo'non; oosummandenaa'n telchi qico'n reyeeka yookaan biniichchi shiyeeka ite ege'nebo'non; batto'eeka maalanna afo'o anke'n maqebo'non.»<verse eid="EZK 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 4:15" />Duuchchi Woddik Goottinna anee'e, «Eloxxen, eega manjiinke foolo'ixxa bakka horiinxa faando adhdhitettexxi isoo ha'ishshe buddeena ra'issitattoshsha assannon» hiyye.<verse eid="EZK 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 4:16" />Isinna ookkoneechchi uduma anee: «Koo manjiinke beltoo! Qalbeeffati, Iyyerusaalemibaa daggammaxxi ita gattaashsha assona'aten; ardikinna murendeexxa ita rakkoti itaan; mikemeeka wode'enna ruphphi hiyya'nek ha'waan. <verse eid="EZK 4:16" /><verse number="17" style="v" sid="EZK 4:17" />Tinninna itattixxenna wodi'iinxi gophensha hexxaammaxxe'e ardi weli'aanni weli uudaa wodda alayyaan; hunjeemmaxxe cubbonaa'n kexxeexxa shonqoroorree lugginaan.<verse eid="EZK 4:17" /></para>
  <chapter eid="EZK 4" />
  <chapter number="5" style="c" sid="EZK 5" />
  <para style="s1">Hiziqeel Umo Haaxxeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 5:1" />«Koo manjiinke belto qaraka wolaantichcha aaxxettexxi areediinxe haadoshsha umo atikkanna areeda atika haaxxi; atike umika ordichcho kiilote'n kiildee sasebaa qoodi. <verse eid="EZK 5:1" /><verse number="2" style="v" sid="EZK 5:2" />Atixxi buqatixxi yanna muuxendaa wodda umiinxe sakkaxxe anganaa'ni mitte giissiteteka Iyyerusaalemike qachchikee kaarti giddo gubi; langaxxa anga qachchiinke kartinke qarqara duuchcha'n wolaantichchik kami; gateemmaxxa sakkaxxa anga diidallo adhdhite me'ito'a xeeri; aninna wolaantichchik insa'ne'ee shorrannon. <verse eid="EZK 5:2" /><verse number="3" style="v" sid="EZK 5:3" />Iitanni umiinke ordichchonaa'n shiixxoka aaxxettexxi seemma atixxike kasa'n gudunfi. <verse eid="EZK 5:3" /><verse number="4" style="v" sid="EZK 5:4" />Higgeenna ookkonenaa'n shiixxoka aaxxettexxi giirati giddo uggite gubi; giirattinna ookkoo'n kexxeexxi Isira'eelike ardi duuchchibaa geltaan.<verse eid="EZK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 5:5" />«Lumok Duuchchi Woddik Gootti hiyya'nee qici: Gosa gosake ardixxe oddo'ni ofo'lshineexxi boga duuchcha qarqara iseke duuchcha'n uggeennexxi Iyyerusaalemi tenneten. <verse eid="EZK 5:5" /><verse number="6" style="v" sid="EZK 5:6" />Yaane kinni ise seera anke'ninna aada anxe'ni jallatte; qarqara iseke'n hedheeke gosa gosake bogike ardi caala fuggo me'ite; tinninna seera anke'ni jalateemmaxxeenna aada anxa hordofa gibbeemmaxxeeten.<verse eid="EZK 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 5:7" />«Tennexxee Lumok Duuchchi Woddik Gootti hiyya'nee qici: Qarqara ha'nooke'ni hedheeke gosa gosake ardi caala seeri gadho galdine'een; aada anxanna hordofinebaan; seera ankeenna ajajendinebaan; qarqara ha'nooke'ni hedheek gosa gosak ardi heqqedheeka seera midde heqqexxinebaan.<verse eid="EZK 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 5:8" />«Tennexxee Lumok Duuchchi Woddik Gootti hiyya'nee qici: Kunnise ani umi angenninni atee Iyyerusaalemi'ni ke'eennen; gosa gosake ardi edonna murte ate'ni murannon. <verse eid="EZK 5:8" /><verse number="9" style="v" sid="EZK 5:9" />Diqachchiisa'neexxe atixxe magenooffachchoxxe buuto'a konneechchi edo ate'ni assebe'noxxa, konneechchinni udumi'anna assabe'noxxa ate'ni assannon. <verse eid="EZK 5:9" /><verse number="10" style="v" sid="EZK 5:10" />Tennexxee Iyyerusaalemi giddo annuwwi oose ifixxa oosetinna annuwwa ifika ittaan; konnee qicinni duuchchinge'ni murannon; gateeka manna boga duuchcha'ni xeerannon.<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="LAM 4:10">Erm. Wiiga. 4:10</ref>. </char></note> <verse eid="EZK 5:10" /><verse number="11" style="v" sid="EZK 5:11" />Tennexxee Lumok Duuchchi Woddik Gootti hiyya'nee qici: dhugaandinni ani duuchchi wodda hedha anixxe'ni kakataannen; galma anka battoossitineemmaxxe fakkuwwa'ninna diqachchiisaaxxe ha'nooxxe huje duuchchanni battoossitineemmaxxee ha'no'o cire'e birannon; ha'noo'a o'wabe'no yookaan ha'noobaa higabe'no. <verse eid="EZK 5:11" /><verse number="12" style="v" sid="EZK 5:12" />Ardi atik sase angannaa'ni mitte anga dhukkubik reyaan; ati giddonna solo'ik mudaan; mitte langaxxi anga atike dalla'i gadhi darre wolaantichchoke'ni ibbaan; gateexxa mitte sakkaxxa anga kinni boga duuchcha'ni xeerannon; dobemeeke wolaatichchinninna insa'nee shorrannon.<verse eid="EZK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 5:13" />«Ookkoneechchi uduma mufe anxi qiidaan; insa'ne'ni iyyedagennexxi anxi bala illeema higgaan; halo insa'ne'n fulanno wodda habushshi hiyyannon; insa'ne'ni bala anxa ibisenneelchi uduma ani Duuchchi Woddik Gootti hinaaffet haaso'ennexxa egenaan.<verse eid="EZK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 5:14" />«Qarqara ha'nooke'n hedheeke gosa gosake ardixxe oddo'ni ha'no birii'n elqe kayya sa'aak duuchchi edo onakenna oso'lchiinke assannon. <verse eid="EZK 5:14" /><verse number="15" style="v" sid="EZK 5:15" />Mufetinna balati iittanni jabake xixichchinni ha'noo'n muranno wodda qarqara ha'nooke'ni gosa gosake arda'ni oso'lendineekenna gacifatematike, xexxe'achchiisatikenna alayyiinke beessisa kaddinaan; ani Duuchchi Woddik Gootti tennee haaso'eennen. <verse eid="EZK 5:15" /><verse number="16" style="v" sid="EZK 5:16" />Gabetishsha shiyaaka solo'o ha'noo'n idaganeelchi ha'no'o balleessona'aten; Solo'ong'ni hana solo'o ha'noo'ni iyyedagannon; midha daggabaa'ninna gattaasha assannon. <verse eid="EZK 5:16" /><verse number="17" style="v" sid="EZK 5:17" />Solo'okanna biniichcha ha'noo'ni ergee'naa oosebelo gattinaan; dhukkubikinna mundetixxi dunema ha'noo giddo bira saxxaan; bagedo ha'noo'ni iyyedaggannon; ani Duuchchi Woddike Goottti haaso'eennen.»<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="REV 6:8">Wal. 6:8</ref>. </char></note><verse eid="EZK 5:17" /></para>
  <chapter eid="EZK 5" />
  <chapter number="6" style="c" sid="EZK 6" />
  <para style="s1">Isira'eelike Tulchuwwixxe'e Haaso'emeeka Wabeekkumma</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 6:1" />Duuchchi Woddike Goottik hiyyichchi ane'ni daggeexxi: <verse eid="EZK 6:1" /><verse number="2" style="v" sid="EZK 6:2" />«Koo manjiinke beltoo! Tullichchi callixxa Isira'eeli'i elobaaxxe illenni udda'ni wabeekkumma tullichuwwake'ni hite wabeekuma insa'ne'ni haaso'i <verse eid="EZK 6:2" /><verse number="3" style="v" sid="EZK 6:3" />hitatto qici: ‹Ha'no Isira'eelike tullichuwwa Lumoke Duuchchi Woddike Goottika hiyyichcho laqqe; Lumok Duuchchi Woddik Gootti tullichchuwwanna goorruwwa dareerruwwanna dhooqquwwa hiyya'nee qici: Bagedo ha'noo'ni iyyedagannon, ha'no giddo magenoonfachchotika qephphichcha boonchuwwa balleessannon. <verse eid="EZK 6:3" /><verse number="4" style="v" sid="EZK 6:4" />Tolchiink boonchi ha'nook diigemaan; hixaana ha'no gubbinaachchuwwi bututaan; han'nooka dulemeemaka manna magenoonfachchottixxe fakkuwwa edo ibisannon. <verse eid="EZK 6:4" /><verse number="5" style="v" sid="EZK 6:5" />Isira'eelika rensha insa'nexxe magenoonfachchotixxe fakkuwwa edo kitinsannon; miqe ha'nooxxanna ha'nooke tolchike bonchuwwi qarqara xeerannon. <verse eid="EZK 6:5" /><verse number="6" style="v" sid="EZK 6:6" />Ha'no hexxinaammake booncho duuchcha'n ha'nooki qachchuwwinna ha'nooxxi magenoonfachchottixxi goorruwwa diigendaan; iittanni ha'nook tolchiink qephphichchi boonchuwwi batto'aan, diigemaan; magenoonfachchotixxi ha'nooxxi fakkuwwa enqendaan; hixaana guphphitinaachchuwwi bullo'aan; anga ha'nooxxenni giissitinemalchi duuchchi bundulli hiyye ba'aan. <verse eid="EZK 6:6" /><verse number="7" style="v" sid="EZK 6:7" />Dulememak ha'nok manni ha'no giddo hunemaan, aninna Duuchchi Woddike Gootta kadeennexxa egendinaan.<verse eid="EZK 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 6:8" />« ‹Yaane kinni gosa gosake ardi bogi giddo xexxeerendinaa wodda ha'nonaa'n mitte mitte wolaantichchakenaa'n fuleeka heenoka mannanna gatisannon. <verse eid="EZK 6:8" /><verse number="9" style="v" sid="EZK 6:9" />Kunni wolaantichchakeenaa'n fuleek, anenaa'ni bayyatteexxi insa'nexxe yabaabbulto qalbenninna magenoonfachchotixxa fakkuwwa hordofa'emmaxxee insa'nexxe illenni qalbe anxa hittee qico gunbeemmaxxee booji'emmeeke gosa gosake ardike bogi giddo he'nee anee qaabantaan; assineemmaxxe fuggoxxeenna hunjeemmaxxe diqqachchissaaxxe insa'nexxe magenoonfachchotixxe fakkuwwanaa'n kexxeexxa ifinna xireeffantaan. <verse eid="EZK 6:9" /><verse number="10" style="v" sid="EZK 6:10" />Insa'nenna ani Duuchchi Woddike Gootta kadeennexxa egennaan; tenne fuggoxxa yaane insa'ne'ni idaganno hiyye haaso'ennek tolakebaan.<verse eid="EZK 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 6:11" />« ‹Lumok Duuchchi Woddik Gootti anee: Isira'eelik manni asseexxe fuggoxxe hujeexxeenna diqqachchiisaaxxe yaane duuchchi'a wolaantichchik, solo'ikinna dhukkubik mundaammaxxee aareti anga calda'ni lekkatinna hirbeesita'ni «Aane'e!» hite raare hiyye. <verse eid="EZK 6:11" /><verse number="12" style="v" sid="EZK 6:12" />Bayya hedheekiir dhukkubik reyaan; shiqa hedheekiirinna wolaantichchik mudaan; lubbo gateekiirinna solo'ik mudaan; konnee qicinni bala anixxa insa'ne'ni ibissannon. <verse eid="EZK 6:12" /><verse number="13" style="v" sid="EZK 6:13" />Dulemeemak insa'nek manni tolchimmalchik qarqara'ni insa'nexxe magenoonfachchotixxe fakkuwwaxxe oddo'ni, qeerraramma gooruwwa duuchcha'ninna koobbuwwatixxe xunguwwa duuchcha'ni, shafi qufeeke haqichchuwwi duuchcha'inna shafik bankaraarake qilxi hunda duuchcha iittanni fakkuwwate'e fishshaake foolika tolcha tolchineemmaxxe bakka duuchcha'ni rensh hunnee'naa uunda wodda ani Duuchhci Woddike Gootta kadeenexxa egennaan. <verse eid="EZK 6:13" /><verse number="14" style="v" sid="EZK 6:14" />Ani anga anxa insa'ne'ni ke'issennexxi, he'nammaka booncho duuchcha bita'ii'ni qiilla gammoojenaa'n midha Reebilake qachchii qico'n boga onake assannon; eetene yanna ani Duuchchi Woddike Gootta kadeennexxa egennaan.› »<verse eid="EZK 6:14" /></para>
  <chapter eid="EZK 6" />
  <chapter number="7" style="c" sid="EZK 7" />
  <para style="s1">Ba'ne Shiqeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 7:1" />Duuchchi Woddike Goottik hiyyichchi ane'n dagee hiyyee qici: <verse eid="EZK 7:1" /><verse number="2" style="v" sid="EZK 7:2" />«Koo manjiinke beltoo! Lumoki Duuchchi Woddik Gootti Isira'eelike bogixxee: Ba'ne! Shoolinge boginke kasa'n kunnise ba'ne dage'een. <verse eid="EZK 7:2" /><verse number="3" style="v" sid="EZK 7:3" />Koo Isira'eelike ardaa ba'ne ta'a kunni ha'no'n dagge'een; mufe anxa ha'no'n dhangalaasannon; ha'nooxxe me'ashshanni ha'no'n murannon; ha'nooxxe diqachchiisaxxe magenoonfachcho duuchchixxee geyaaka xixichcho ha'noo xixannon. <verse eid="EZK 7:3" /><verse number="4" style="v" sid="EZK 7:4" />O'wiinxe illenni ha'noo uudabe'non; ha'no'anna gattowaal hiyyabo'non; ha'noxxe me'ashshanni ha'no'n murannon; ha'no giddo hexxeexxa diqachchiissaxxa magenoonfachcho leellishannon; eettene yanna ani Duuchchi Woddike Gootta kadennexxa egendinaan.<verse eid="EZK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 7:5" />«Lumoki Duuchchi Woddiki Gootti hiyya'nee qici: Bala! Kadde egendebaaxxi bala kunnise daggaan. <verse eid="EZK 7:5" /><verse number="6" style="v" sid="EZK 7:6" />Muuxami dage'een! Muuxami dage'een ha'no'n qophphi hiyye'een; kunse dage'een. <verse eid="EZK 7:6" /><verse number="7" style="v" sid="EZK 7:7" />Koo ha'no bogake'n hexxineekee ba'netixxi murte ha'no'n dagge'een; yanna gelte'een; tulluwwate'n ililleette kaddebaak weekkensha laqendaaxxi barra shiqe'een. <verse eid="EZK 7:7" /><verse number="8" style="v" sid="EZK 7:8" />Kunnise ani aare anxa shiqoxxe barra'n ha'no'n bidhannon; mufe anxanna ha'no'n dhanigalaasannon; me'injo ha'nokishshanna ha'no'n murannon; ha'nooxxe diqachchiissaaxxe magenoonfachcho duuchchi'anna geyaaka xixichcho ha'no'o xixannon. <verse eid="EZK 7:8" /><verse number="9" style="v" sid="EZK 7:9" />O'witaaxxe ille iima ha'noo uudabe'non; ha'no'anna gattowaal hiyyabe'non; ha'nooxxe me'a'ashshanna ha'no'n muranno; ha'no giddo hexxeexxe diqachchiisaxxa magenoonfachcho leellishannon; eettene yanna ha'noo xixaannek ante Duuchchi Woddike Gootta kadennexxa egendinaan.<verse eid="EZK 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 7:10" />«Kunnise barra kunnise dage'een! Ha'nooxxi ba'ne shiqe'een; xaqaro luphphise'een; siqqotinna luphphise'een; ifi dukatinna daraarte'een. <verse eid="EZK 7:10" /><verse number="11" style="v" sid="EZK 7:11" />Xaqaro nophphite'e fuggo xixatixxe siqichcho kadde; ardakenaa'n karra insa'nexxenaa'ninna insa'ne ulfantashsha assamalchonaa'n mittilchinna gatabaan. <verse eid="EZK 7:11" /><verse number="12" style="v" sid="EZK 7:12" />Kunni yanna dage'een; barratinna shiqe'een! Aare anxi arda duuchcha'n dage'emaxxee hedhaak gammadoqe'e; gurgudhaakinna yaadoqe'e. <verse eid="EZK 7:12" /><verse number="13" style="v" sid="EZK 7:13" />Lamiingi lubboti he'nee qico gurgudheeki gurgudhemalchibaa illee iima higoqe'e; iittanni Isira'eelike arda duuchcha'n kulendeexxi tinni leelisha jijirendabaan; cubbo insa'nexxenaa'n kexxeexxa lubbo ifixxa dande'e gatilsaak mittikinna afemabaan. <verse eid="EZK 7:13" /><verse number="14" style="v" sid="EZK 7:14" />Aare anxi arda duuchcha'n dagemmaxxee malagata ufuunfoole, duuchchiinxa yaane qopheesinoolenna lolakee me'aak mittikinna midde afemabaan.<verse eid="EZK 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 7:15" />«Gadhii'n wolaantichchi, giddo kinni dhukkubinna solo'i hedheen; qachchii gadhi darre hedheekiir wolaantchoke'n ibaan; qachchi giddo hedheekir solo'ikinna dhukkubik mudaan. <verse eid="EZK 7:15" /><verse number="16" style="v" sid="EZK 7:16" />Lubbo gateekiir dhooqa gidd'n baajee tullichchi hana hexxe gungundamaxxe guugenjoshsha tullichi hana he'neexxi cubbo ifixxee gunguma'ni oo'naan. <verse eid="EZK 7:16" /><verse number="17" style="v" sid="EZK 7:17" />Insa'nexxi anga duuchchi lo'otaan; soda'ati gulubi giligilee'naa ifi iima shi'ninaan. <verse eid="EZK 7:17" /><verse number="18" style="v" sid="EZK 7:18" />Insa'ne yaadotixxa seemma oddo'winaan; weekenshatinna insa'ne'ni daggaan; duuchchiingik albi salphinnik xiledhe; duuchchiing umokanna haxxaan. <verse eid="EZK 7:18" /><verse number="19" style="v" sid="EZK 7:19" />Ifika birretika sibilijo ora ora'inni hunnaan; worqe ifixxinna battitte yaaneshsha udendaan. Insa'ne'ek birretik sibilijinna insa'nexxi worqe insa'nee Duuchchi Woddike Goottixxe jabaxxe mufexxa barra baro insa'nee anjirtabaan; cubbote'n insa'ne'e ibbisatee buutote kaddeek insa'nek biretik sibiljonna worqe godoba goddatee yookaan godoba wonshedhatee isee indabaan. <verse eid="EZK 7:19" /><verse number="20" style="v" sid="EZK 7:20" />Insa'ne ifike ifi danchosatike miyinni ifi saandeexxi konnelchiwwixxa diqachchisa'nexxa magenoonfachchonna shookishshaaxxa fakkuwwaxxa misile ifi'a giise'ne; tennexxee ani konne ifi danchoosatik miyi insa'ne'n batto'aashsha assannon. <verse eid="EZK 7:20" /><verse number="21" style="v" sid="EZK 7:21" />Insa'neka worqetika sibiljonna worqe alagi mulqedhaashsha, buttatixxi fuggaaleyyenna sandaashsha sa'isse uwwannon; insa'nenna isoo battosinaan. <verse eid="EZK 7:21" /><verse number="22" style="v" sid="EZK 7:22" />Aninna alba weleba wirri hiyyannon; insa'nena e'yineexxi ulfate'eke anka galma battossinaan.<verse eid="EZK 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 7:23" />«Dhugaatixxi murte bogake'n hedha gophatenaa'n kexxeexxa munde duna, qachchake'ninna xaqaro wo'mitemaxxee usuriinka haachchaba qophpheessi. <verse eid="EZK 7:23" /><verse number="24" style="v" sid="EZK 7:24" />Gosa gosake ardika hara fuggichchuwwa manna iyyedagennexxi insa'neka minuwwa adhaashsha assannon; jajjabiinxa ifi dukanna balleessannon; galmuwwa insa'nekanna battossinaan. <verse eid="EZK 7:24" /><verse number="25" style="v" sid="EZK 7:25" />Weekemaa wodda nage'a halsinaan yaane kinni alfinabaan. <verse eid="EZK 7:25" /><verse number="26" style="v" sid="EZK 7:26" />Ba'nende'n ba'ne, odonde'n odo daggaan; insa'nee waleella wabeekakenaa'n alfino'a halchinaan; barachcho seerii qeesichokenaa'n gorsikinna geerchokenaa'n ba'aan. <verse eid="EZK 7:26" /><verse number="27" style="v" sid="EZK 7:27" />Moyanji oodhaan; hayyichchikinna alayyee hophpholaan; bogiinke ardixxi anganna soda'ati gilgildaan; me'injo insa'nekishshanni insa'nee ganannon; insa'ne weleke'n murrammake seerishshanni aninna insa'ne'n murannon; eettene yanna ani Duuchchi Woddike Gootta kadennexxa egenaan.»<verse eid="EZK 7:27" /></para>
  <chapter eid="EZK 7" />
  <chapter number="8" style="c" sid="EZK 8" />
  <para style="s1">Magenii Galmi Giddo Fakkuwwa Magenoonfachcho</para>
  <para style="r">(<ref loc="EZK 8:1-10:22">8:1—10:22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 8:1" />Jiyaxxe wogga'ni, jiyake agenjixxe ondixxe barra'n, anigge mine'ni ofo'lenbaa Yihudiinxxi geedhe ani edo ofolde'naa eettene yanna'n Lumooke Duuchchi Woddike Goottixxi hunna ane'ni hana dagge. <verse eid="EZK 8:1" /><verse number="2" style="v" sid="EZK 8:2" />Aninna tami asse uudenne wodda kunnise manjiinka belto labbaxxe fakke hexxemman; hidha iseke laba'nelchinni butti'a giiratishsha hexxemman; hidha isike laba'nelchinni iimi'anna holateeke sibilishsha wa'a hiyyeemman.<note caller="-" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="EZK 1:28">Hiz. 1:28</ref>. </char></note> <verse eid="EZK 8:2" /><verse number="3" style="v" sid="EZK 8:3" />Isinna anga fakkaatachcho iimi'a ke'isse umo ankika ordichcho abide; Hafuurikinna anee'e buttixxenna iimatixxe odo'n iimi'a ke'isse; isinna Mageniinxa hinaafete ke'issitaaxxi fakke uurriteba giddixxe baxxeba e'yatiba middixxe hulaba Iyyerusaalemi Duuchchi Woddike Goottixxe waleellanni anee iyyemarre. <verse eid="EZK 8:3" /><verse number="4" style="v" sid="EZK 8:4" />Tami asse uudenne wodda dhooqa giddo waleellati uudennak Duuchchi Woddike Gootti Isira'eelik ulfinni ookko hedhemman.<verse eid="EZK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 8:5" />Isinna anee «Koo manjiinke beltoo! Midi'a uudi» hiyye; aninna uudennen; kunnise tolchimalchixxe hulaba'n middi darre'n e'yichchinba tinni Mageniinxa hinaaffe ke'issitaaxxi fakke hexxemman.<verse eid="EZK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 8:6" />Higgeen anee, «Koo manjiinke beltoo! Isira'eeliki manni woyyitte anxe bakkanaa'n anee bayyinso'a kaba assina'neexxa hara diqachchisaaxxe magenoonfachcho uuda'ninni hexxette? Tennena'inna caldaaxxa diqachchissaaxxa magenoonfachcho uudaton» hiyye. <verse eid="EZK 8:6" /><verse number="7" style="v" sid="EZK 8:7" />Ookkoneechchi uduma baxxetiba'a e'yatixxe hulabaa anee iyyedage; aninna kinjiinka dalla'a uudenne; tami asse uudanno wodda dalla'ikinna qo'a afeemman. <verse eid="EZK 8:7" /><verse number="8" style="v" sid="EZK 8:8" />Isinna anee, «Koo manjiinke beltoo! Kinjiinke dalla'ika konne qo'a ba'lisse uri» hiyye; aninna kinjiinke dalla'ika ookkone qo'a ba'lisenne wodda mitte hula afenne. <verse eid="EZK 8:8" /><verse number="9" style="v" sid="EZK 8:9" />Isinna anee «Gidi'a e'yittetexxi ookko assiina'neexxa fuggoxxa diqachchisaneexxa magenoffachcho uudi» hiyye. <verse eid="EZK 8:9" /><verse number="10" style="v" sid="EZK 8:10" />Aninna e'yennexxi tami asse uudenne wodda, godobik me'ita'neexxi daduwwanna diqachchisaaka gargar gargar hedheeka biniinchuwwa duuchcha, Isira'eelike minnixxa magenoonfachchotixxa fakkuwwa duuchcha kinjiinke dalla'a qarqara duuchcha'n konnechchuwwixxi bifa dallaake'n qunqumme giissinena'a afenne. <verse eid="EZK 8:10" /><verse number="11" style="v" sid="EZK 8:11" />Konnechchuwwi edonna Isira'eelike minnixxi torbaane tomme geedhe uurrite'emman; insa'nexxe oddo'n Safaaniki belti Azaanya uurre'eman; insa'ne mitti mittingi hixaana gunbamalcho anga abinde'een, eloke foolik hixaanixxi wiliillenna iimi'a tuqu tuqu hita'nemman. <verse eid="EZK 8:11" /><verse number="12" style="v" sid="EZK 8:12" />Isinna ane'e «Koo manjiinke belto Isira'eelik mannixxi geedhe mitte mittendi ififixxe fakkuwwa gaadi giddo dukkanate'n assina'neexxa uudettene? Insa'ne ‹Duuchchi Woodik Gootti no'o'o afabaan; Duuchchi Woddik Gootti boga wale'een hinaan› » hiyye <verse eid="EZK 8:12" /><verse number="13" style="v" sid="EZK 8:13" />Higgeenna, «anee tennenaa'n caldeexxa diqachchisa'nexxa magenoonfachcho uudatton» hiyye. <verse eid="EZK 8:13" /><verse number="14" style="v" sid="EZK 8:14" />Ookkoneechchi uduma middi darre'n hedheeke Duuchchi Woddike Goottike minixxe middixxe baxxeba anee iyyedage; tama asse uudanno wodda ookkonna melaalle ofldeexxi Temuzi hiyyendaaxxe fakke'a ooxxanaa afenne. <verse eid="EZK 8:14" /><verse number="15" style="v" sid="EZK 8:15" />Isinna anee «Koo manjiinke belto tenneenna uudete? Tennenaa'n caldaaxxa diqachchissaneexxa magenoonfachcho uuddatton» hiyye. <verse eid="EZK 8:15" /><verse number="16" style="v" sid="EZK 8:16" />Iittanni Duuchchi Woddike Gootti minike giddixxe baxxe'ni anee idage; kunnise ookkonna galmixxe soro'ninna tolchimalchnchi oddo'n lame tommenna ondi manni qici hedhemman; insa'nenna dudduro Duuchchi Woddike Goottike galmiba'a alba kinni borotiba'a wirri hinee fuldaaxxe arsho'a heeshshi qokki hina'emman. <verse eid="EZK 8:16" /><verse number="17" style="v" sid="EZK 8:17" />Isinna anee «Koo manjiinke belto tenne uudeten? Yihudak manni tenne bakka'n assa'neexxi diqachchisa'neexxi magenoffachcho shollaxxe yaane isi? Insa'ne bogake'n xaqarotixxa yaane assati duuchchi wodda anee mufachchisiiyyo hasissaata? Kunnise insa'ne anee yowwina'neexxanna anee mufachchisatee dandenneexxa yaane duuchcha assina'neexxa uudi. <verse eid="EZK 8:17" /><verse number="18" style="v" sid="EZK 8:18" />Tennexxee ani insa'ne'n mufeti ke'annon; mararitetixxe illenni insa'nee uudabe'no; aniba'a raarolenna laqabe'non.»<verse eid="EZK 8:18" /></para>
  <chapter eid="EZK 8" />
  <chapter number="9" style="c" sid="EZK 9" />
  <para style="s1">Fakkuwwa Magenoffatemmake Mannixxa Shiyema</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 9:1" />Ookkoneechchi uduma ani laqa'naa'nni hafuura gikki assee «Mitti mitting looliinka miya anga abixeek konne qachcha gano'a ergemeekiir kaba'a daga'neen» hiyye. <verse eid="EZK 9:1" /><verse number="2" style="v" sid="EZK 9:2" />Tami asse uudanno wodda balleesatee looliinka miya anga abixxe'eek jaani manni middi darrexxe hulake oribaa'n dage; insa'ne giddo mitti layinotixxa seemma odo'week, hidhake'n borreeessatike miyixxa buuda abixxeek mitti manji hedhemman; insa'nenna e'yineexxi sageetotike sibiljik tolchimalchi bira uurrine.<verse eid="EZK 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 9:3" />Ookkoneechchi uduma Isira'eelike Mageniink gaachchanni hedhemmabaa'n Kirubeeli hanii'n ke'eexxi galmiinxe hulaba'a me'eedhemman; Duuchchi Woddik Goottinna layinotixxa seemma oddo'weexxi hidhake'n borreessatike miyixxa buuda anga abixxeemmaka manjichcho ye'ee. <verse eid="EZK 9:3" /><verse number="4" style="v" sid="EZK 9:4" />«Iyyerusaalemik qachchi giddo duuchcha me'etettexxi isi giddo hujenda'neexxe diqachchisa'neexxi yaane'a yaada'ninna oodha'ne hedhemmake mannike alba'n beessisa uggi» hiyye.<note caller="-" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="REV 7:3">Wal. 7:3</ref>; <ref loc="REV 9:4">9:4</ref>; <ref loc="REV 14:1">14:1</ref>. </char></note> <verse eid="EZK 9:4" /><verse number="5" style="v" sid="EZK 9:5" />Aninna laqa'naanni isi wele manna «Qachchi giddo isoo hordofine mammarendina'n shiwwe; marartinoqqe'e yookaan owitinoqqe'e. <verse eid="EZK 9:5" /><verse number="6" style="v" sid="EZK 9:6" />Geercho dargageessa, dubarchotanna melaalle oose haranga birre; yaane kinni beessisa afeeka manjo tuqqinoqqe'e; anke galmi giddii'n saffe.» Tennexxee insa'ne galmi edi darree hexxeexxe geedhuwwaa'n shiyya sanfe. <verse eid="EZK 9:6" /><verse number="7" style="v" sid="EZK 9:7" />Ookkoneechchi uduma isinna insa'nee «Marre, galma anka battoosse; baxxe galaminxe'inna rensha wonshe» hiyye; insa'nenna dangeexxi qachchi giddo duuchcha mammarema'n shiyya sanfe. <verse eid="EZK 9:7" /><verse number="8" style="v" sid="EZK 9:8" />Insa'ne shina'n he'ne'naa ani qofi hedhee albik gonbisemennexxi oodhe hunbaashsha'n «Aane'e, koo Lumoke Duuchchi Woddike Goottaa Iyyerusaalemi'n bala atixxa ibisati Isira'eelixxa hafe duuchcha biritattota?» hiyyenne. <verse eid="EZK 9:8" /><verse number="9" style="v" sid="EZK 9:9" />Isinna ane'n «Isira'eelikenna Yihudake ardixxi cubbo hara bira saxxe'een; bogikinna mundeti mundete kade'een; qachchake'ninna xaqaro assa wo'mite'een; insa'nee ‹Duuchchi Woddik Gootti boga waaledheen; Duuchchi Woddik Gootti afa'nebaan› hina. <verse eid="EZK 9:9" /><verse number="10" style="v" sid="EZK 9:10" />Tennexxee ani insa'ne hunjeexxa huje insa'ne'n wirri assannon malee insa'nee o'witeexxe illenni uudabe'non» hiyye hiisse haaso'e. <verse eid="EZK 9:10" /><verse number="11" style="v" sid="EZK 9:11" />Ookkoneechchi uduma layinotixxa seemma ode'weexxi hidhake'n borreesatika miyixxa buuda anga abixxeemmak manjichchi illeema higeexxi «Ati anee ajajeteshshanni muuxeennen» hiyye.<verse eid="EZK 9:11" /></para>
  <chapter eid="EZK 9" />
  <chapter number="10" style="c" sid="EZK 10" />
  <para style="s1">Mageniink Gaachchanni Galmakenaa'n Gargar Higeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 10:1" />Aninna uudenne, kunse Kirubeelike umi iimi darre hexxeexxe dhisendeexxe iima iimi darre fiixe'eeke Senperke kinijiinxe moote labaachchi hedhemman. <verse eid="EZK 10:1" /><verse number="2" style="v" sid="EZK 10:2" />Duuchchi Woddik Gootti layino oddo'emmaka manjicho «Kirubeeleti hunda hexxeexxe molluwwa giddo e'yitettexxi Kirubeeletixxe oddo'n hedheeke kashilinaa'n anga wonshitee guunsitee qachchi giddi'anna xeeri» hiyye; majichchikinna ani uudana'n e'ye.<note caller="-" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="REV 8:5">Wal. 8:5</ref>. </char></note><verse eid="EZK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 10:3" />Manjichchikinna e'yaa wodda Kirubeeli galmi giddo bitta'i darre'n uurte'emman; duumanchikinna giddi darrexxa baxxe wo'meemman. <verse eid="EZK 10:3" /><verse number="4" style="v" sid="EZK 10:4" />Duuchchi Woddike Goottiki gaachchanninna kirubeelinaa'n ke'eexxi galminxe hulaba'a me'e; duumanchikinna galma wo'me; baxxete'ninna Duuchchi Woddi Goottike gaachchannike ifinninni wo'mite. <verse eid="EZK 10:4" /><verse number="5" style="v" sid="EZK 10:5" />Kirubeelike keeluwwik hafuuri, Dada Duuchcha ajajaak Magen haaso'aa wodda laqemaamake hafuursha gadhi darrexxe baxxe qico'ni laqisa'emman.<verse eid="EZK 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 10:6" />Duuchchi Woddik Goottinna layino oddo'weemmaka manjichcho, «Kirubeeliti hunda hexxemmaxxe moluwwaxxe oddonaa'n giira aadhi» hiyyeexxi isoo ajajee wodda manjichchikinna giddi'a e'yeexxi mitte mole bira uurre. <verse eid="EZK 10:6" /><verse number="7" style="v" sid="EZK 10:7" />Kirubeeltenaa'ninna mitti eettene kirubeelixxe oddo'n hexxemmaxxe giiraba'a anga qeerrise aadhee. Isinna layino oddo'weemmake manjichchiinxe anga'n uggenaa, manjichchikinna giira aadhe fule. <verse eid="EZK 10:7" /><verse number="8" style="v" sid="EZK 10:8" />Kirubeelike keeluwwi hundi darrenna manjiinxa anga labaalchi leelle.<verse eid="EZK 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 10:9" />Aninna uudennen, kunnise kirubeele bira shoole moluwwa, mitte mittende kirubeele bira mitte mitte mole hexxemman; moluwwatixxi bifanna fiixeeke kinjishsha calacala hitaamman. <verse eid="EZK 10:9" /><verse number="10" style="v" sid="EZK 10:10" />Shoollnxixxe moluwwaxxi bifa wele labba'amman; mitte mittendi mole, mole giddo hexxexxe labba'emman. <verse eid="EZK 10:10" /><verse number="11" style="v" sid="EZK 10:11" />Moluwwa me'itee wodda kirubeeli alba wirri hiteeke shoolinii darre duuchcha'ni me'ita'emman; kirubeeli me'itee wodda moluwwa elqe kayyi'a wirri wirri hitebaang kirubele alba wirrite hitee darre duuchcha'n me'ita'nemma. <verse eid="EZK 10:11" /><verse number="12" style="v" sid="EZK 10:12" />Eettene kirubeeluwake biso duuchcha'n, dudduruwwake'n, anguwwate'ninna lekkuwwate'n, shooliinxe isexxe moluwwa'n hexxemmashsha ille wo'mite'emman.<note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="REV 4:8">Wal. 4:8</ref>. </char></note> <verse eid="EZK 10:12" /><verse number="13" style="v" sid="EZK 10:13" />Moluwwatinna ani laqa'naanni «Goggo'mitaaxxe moluwwa» hiyyende. <verse eid="EZK 10:13" /><verse number="14" style="v" sid="EZK 10:14" />Mitte mittendi kirubeele shoole alba afe'emman: taakkak albi kirubeeletike, langak manjiinke, sakkak neeqiinke, sholgak sinbiriinke albamman.<note caller="-" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="EZK 1:10">Hiz. 1:10</ref>; <ref loc="REV 4:7">Wal. 4:7</ref>. </char></note><verse eid="EZK 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 10:15" />Kirubeelinna iimi'a qophphi hite kexxe; tinni kirubeluwwinna Kebaarike galaani bira uude'nenaxxe hedho afe'eexxe daduwwan. <verse eid="EZK 10:15" /><verse number="16" style="v" sid="EZK 10:16" />Kirubeele me'itee wodda iseke cinaachchi hexxemmaxxi moluwwanna me'ita'emman; kirubeele butti'n iimi'a kexxo'a keeluwwa bandaa wodda moluwwa kirubeeltike cinachchinaa'n qoota'emmabaan. <verse eid="EZK 10:16" /><verse number="17" style="v" sid="EZK 10:17" />Kirubeele uurritee wodda moluwatinna uurta'emman; kirubeele butti'n kexxaa wodda moluwatinna kirubeleti welti kexxa'emman; tinni kaddeechchi hedho affexxe daduwwak hafuuri moluwwa giddo hedhemmaxxeeten.<verse eid="EZK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 10:18" />Ookkoneechchi uduma Duuchchi Woddike Goottik gaachchanni galmiinxe hudumme hanii'n ke'eexxi Kirubeele iimi darre uurre. <verse eid="EZK 10:18" /><verse number="19" style="v" sid="EZK 10:19" />Kirubeele ani uuda'naa'n keela bandeexxi buttii'n kexxeexxi me'ite; moluwwatinna isenni welti me'iteexxi Duuchchi Woddike Goottike minixxe boroti darrexxa hudumme gelte uurte; Isira'eelike Mageniink gaachchanninna ise hana hedhemman.<verse eid="EZK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 10:20" />Tinniir ani Kebaarike galaani bira Isira'eelike Mageni hunda uudennaxxe hedho affeexxe dadawwamman, iseeri Kirubeelete kaddeemmaxxa qalbeefatenne. <verse eid="EZK 10:20" /><verse number="21" style="v" sid="EZK 10:21" />Mitti mittendi shoole albanna shoole keeluwwa affe'emman; konne keeluwwi butti drrenna manjiinxa anga labaachchi hedhemman. <verse eid="EZK 10:21" /><verse number="22" style="v" sid="EZK 10:22" />Albuwwi konnerikinna Kebaaarike galaani qarqara uudeneke albuwwinni weli laba'emman; mitti mittend kirubele toggi hitee edi'a me'ita'emman.<verse eid="EZK 10:22" /></para>
  <chapter eid="EZK 10" />
  <chapter number="11" style="c" sid="EZK 11" />
  <para style="s1">Isira'eelike bogike Akeekisanjuwwa'n Murendeexxa Murte</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 11:1" />Mageniink Hafuurinna anee iimi'a qophphi asseexxi borroti darrexxe Duuchchi Woddike Goottixxe hulaba iyyedage; hulatibaa e'yinammaba lame tommenna onde manna hedhemman; insa'ne giddo ardiinka akeekisanjuwwa Azuurika belto Azaaninna Banayaaka belto Felaxiyaasi'i afenne. <verse eid="EZK 11:1" /><verse number="2" style="v" sid="EZK 11:2" />Duuchchi Woddik Goottinna, «Koo manjiinke belto kunni manni fuggoxxa hedaakenna konne qachcha'n figgoxxa mari'ataake mannann. <verse eid="EZK 11:2" /><verse number="3" style="v" sid="EZK 11:3" />Insa'nenna ‹minuwwi ijaaremexxi yannata shiqotebaata? Kunni qachchi oddolchote, no'o kinni maalinsha oddolcho giddo heqqemmenne› hine'een. <verse eid="EZK 11:3" /><verse number="4" style="v" sid="EZK 11:4" />Tennexxee raaga insa'ne'n raagi; koo manjiinke belto raaga raagi.»<verse eid="EZK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 11:5" />Ookkoneechchi uduma Duuchchi Woddike Goottik Hafuurinna ane'ni dageexxi hiyyi hiyyee qici: «Duuchchi Woddik Gootti hiyya'nee qici: Koo Isira'eelike arda ha'no tenne yaane haasotine'een, ani ha'noke godobika yaada ege'neennen. <verse eid="EZK 11:5" /><verse number="6" style="v" sid="EZK 11:6" />Konne qachcha'n ha'no heddo manna shiltineexxi ora isike'n rensha wonshitine'een.<verse eid="EZK 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 11:7" />«Tennexxee Lumok Duuchchi Woddik Gootti hiyya'nee qici: Ookko hundine'ek renshuwwi isi maalaken; kunni qachchinna oddolchoten; ani kinni ha'noo isi gidd'n fulchannon. <verse eid="EZK 11:7" /><verse number="8" style="v" sid="EZK 11:8" />Ha'no wolaantichcha sodatine'een; ani wolaantichcha ha'no'n ergannon hiyya'een Lumok Duuchchi Woddik Gootti. <verse eid="EZK 11:8" /><verse number="9" style="v" sid="EZK 11:9" />Qachchakenaa'n ha'noo fulchenneexxi ha'noo alagiinxe anga'n sa'issannon; murte anxanna ha'no'n murannon. <verse eid="EZK 11:9" /><verse number="10" style="v" sid="EZK 11:10" />Wolaantichchoke'n rertinaa'n; Isira'eelike bogi giddo ha'no'n murannon; ookkone wodda ani Duuchchi Woddike Gootta kadennexxa egendinaan. <verse eid="EZK 11:10" /><verse number="11" style="v" sid="EZK 11:11" />Kunni qachchi ha'no'a oddolchote kadabaan; ha'nonna isi giddo maaliishsha kaddinabaa; ani ha'no'n Isira'eelike bogi giddo murannon. <verse eid="EZK 11:11" /><verse number="12" style="v" sid="EZK 11:12" />Ookkone wodda ani Duuchchi Woddike Gootta kadennexxa egendinaan; ha'noo qarqara ha'noke'n hedheeke gosa gosak ardika seera hordofinee malee ajaja anka muuxinebaan; seera anka heqexxinebaan.»<verse eid="EZK 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 11:13" />Aninna raaga raagande'n hedhe'naan Banayaak belti Felaxiyaa reye; aninna albik butta gonbisemennexxi, «Koo Dada Duuchchike Duuchchi Woddike Gootta aane'e Isira'eelike ardixxa hafe haranga balleessitatota?» hiyya'n hafuura gikki asse oodhenne.<verse eid="EZK 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 11:14" />Duuchchi Woddike Gootti hiyyichchi anee dageexxi, <verse eid="EZK 11:14" /><verse number="15" style="v" sid="EZK 11:15" />«Koo manjiinke belto atike dayyuwwixxee, atike firuwwixxenna Isira'eelik ardi duuchchixxee ‹Insa'nee Duuchchi Woddike Goottinaa'n bayyante'een› kunni bogi geegoke kadee'e ‹no'o'a uwwemedheen hiyyeexxi Iyyerusaalemi hedhammak manni haaso'edheen› hiyye.<verse eid="EZK 11:15" /></para>
  <para style="s1">Isira'eelixxe Illee Iima Higaxxa Addachchiisa</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 11:16" />«Tennexxee Lumok Duuchchi Woddik Gootti hiyya'nee qici: ‹Gosa gosake ardi giddo insa'ne'e me'inashshanna assonnole, boga boga duuchcha'ninna insa'ne'e xeeronnolenna heenoxxe yanna'a insa'ne'a galmake kade'ennan› hiyye.<verse eid="EZK 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 11:17" />«Tennexxee Lumok Duuchchi Woddik Gootti hiyya'neenni hitato qici: ‹Ani insa'nee gosa gosake ardi giddii'n insa'nee bukki assannon: xexeerremmemmakee boguwwinaa'n insa'ne'e illeema hissannon; Isira'eelika boganna haaroba ha'no'a uwwannon› hiyye.<verse eid="EZK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 11:18" />«Konne bogibaa hingaaxxa yanna battotteexxa diqachchiissaxxa yaanuwwa bogakenaa'n fugusinaan. <verse eid="EZK 11:18" /><verse number="19" style="v" sid="EZK 11:19" />Ani insa'ne'a mitte godobanna haaroka hafuura insa'ne giddo uggurannon; kinjiinka godoba insa'ne giddi'n fulchennexxi ajajenda qale insa'ne'a uwwannon.<note caller="-" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="EZK 36:28">Hiz. 36:28</ref>. </char></note> <verse eid="EZK 11:19" /><verse number="20" style="v" sid="EZK 11:20" />Tennexxee insa'ne ajaja anka muunxaan; seera ankanna heqqe'naan; insa'nenna arda anke kandaan; aninna insa'neeke Mageno kadannon. <verse eid="EZK 11:20" /><verse number="21" style="v" sid="EZK 11:21" />Yanne kinni godoba ifike'n battitte fakkuwwaba'anna diqachchisaaxxe miisilewwabaa wirri hiyyaakaara huje insa'nexxishshanni insa'ne'a uwwannon hiyya'neen Duuchchi Woddik Gootti.»<verse eid="EZK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 11:22" />Eettenne yanna Kirubeele keela ifika bande; moluwwatinna ise bira hexxemman; Isira'eelike Mageniink gaachchanninna ise hana hedhemman. <verse eid="EZK 11:22" /><verse number="23" style="v" sid="EZK 11:23" />Duuchchi Woddike Goottik gaachchanninna qachchi giddii'n keexxi alalle me'e; qachchakenaa'n borroti darre'n hexxeexxe kooba hana uurre.<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="EZK 43:2-5">Hiz. 43:2-5</ref>. </char></note> <verse eid="EZK 11:23" /><verse number="24" style="v" sid="EZK 11:24" />Mageniink Hafuurikinna ane'e iimi'a qophphpi asseexxi Mageniike Hafuurinni uwweendeexxe waleellanni Baabiloonke boga'n booji'eme hedhemmake manniba anee iyyedage; ookkoneechchi uduma uudennaxxi waleella aneenaa'n me'ite. <verse eid="EZK 11:24" /><verse number="25" style="v" sid="EZK 11:25" />Aninna Duuchchi Woddik Gootti ane'ni leelishemmaxxa yaane duuchcha booji'eme hedhemmake manna'n haaso'enne.<verse eid="EZK 11:25" /></para>
  <chapter eid="EZK 11" />
  <chapter number="12" style="c" sid="EZK 12" />
  <para style="s1">Booji'o Fakkeennik Kulendeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 12:1" />Duuchchi Woddike Goottik hiyyichchi ane'n dageexxi <verse eid="EZK 12:1" /><verse number="2" style="v" sid="EZK 12:2" />«Koo manjiinke belto jallichcha ardi giddo hexxeten; insa'ne jallichcha arda kandeemmaxxee uuddaneexxe ille anfe'een yaane kinni anfabaan: lanqaaneexxe mansha anfe'een yaane kinni lanqabaan.<note caller="-" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">Isa. 6:9-10</ref>; <ref loc="JER 5:21">Erm. 5:21</ref>; <ref loc="MRK 8:18">Mar. 8:18</ref>. </char></note><verse eid="EZK 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 12:3" />«Tennexxee koo manjiinke belto insa'ne atee uunda'naan barra banteessa booji'eme me'ammake manjishsha mi'ya atika bukki assexxi hexxetebaa'n kexxettexxi wele boonchiba'a me'i; jallichcha arda kandoolenna akimagaada tennee qalbeeffantaaxxe hexxeen. <verse eid="EZK 12:3" /><verse number="4" style="v" sid="EZK 12:4" />Barra atee unda'naa booji'emeeke manjishsha miya atika bukki assedh; bogi siphphi hiyyamma wodda insa'ne ate uunda'naa'a booji'emeeke manji fulammashsha fuli. <verse eid="EZK 12:4" /><verse number="5" style="v" sid="EZK 12:5" />Insa'ne uunda'naa'n dalla'a enqittetexxi ookko'n miya atika gadhi'a fulchi. <verse eid="EZK 12:5" /><verse number="6" style="v" sid="EZK 12:6" />Insa'ne atee uunda'naan miya atika gurummote'n dulkite hashsha fuli; Isira'eelike ardi'a atee beessisake asseennaxxee boga uuddabexxoshsha alba buqedhi.»<verse eid="EZK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 12:7" />Aninna ajejemennashshanni assenne; barra miya anka bukki assedhennexxi booji'emeeke manjishsha mi'ya anka gadhi'a fulchenne; hashshaa woddanna kinjiinka dala'a anga anxenni enqennen; ane'e uunda'naa'n hashshati miya anka gurummote'n dulkennexxi gadhi'a fulchenne.<verse eid="EZK 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 12:8" />Langa barro gorsa Duuchchi Woddik Goottik hiyyichchi ane'n dageexxi <verse eid="EZK 12:8" /><verse number="9" style="v" sid="EZK 12:9" />«Koo manjiinke belto jallichchi Isira'eelik ardi ‹Kunni assitateechi maachcho?› hiyye atee qore'emman.<verse eid="EZK 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 12:10" />«Insa'ne'n hitato qici: ‹Lumok Duuchchi Woddik Goottinna kunni wabeekumiik hiyyichchi Iyyerusaalemi hedheeke ja'labixxeenna ookko afemaake Isira'eelike ardi duuchchixxeeten› hiyye. <verse eid="EZK 12:10" /><verse number="11" style="v" sid="EZK 12:11" />Insa'ne'e ‹Ani hano'a beessisaken› hiyyi.</para>
  <para style="p" vid="EZK 12:11">«Ani assenashshanni insa'ne'ninna iittanni assendaan. Booji'emmexxi adhdhemme me'inaan.<verse eid="EZK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 12:12" />«Insa'ne giddo hedheek jallaabinna hashsha miya ifika gurummote'n dulkeexxi fulaan; gadhii'n luuxxe sa'ashsha kinjika dalla'a insa'ne isi'a enqinaan; boga afabaashshanna alba buqe'naan. <verse eid="EZK 12:12" /><verse number="13" style="v" sid="EZK 12:13" />Ani fonxoro anxa isi'a uggannon; isinna fonxoro anxe'n abidemaan; aninna isoo Kaladaanike bogibaa Baabiloonike qachchibaa iyyedagannon; yaane kinni boga ookkone uudebaang ookko reyaan.<note caller="-" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="2KI 25:7">2 Moy. 25:7</ref>; <ref loc="JER 52:11">Erm. 52:11</ref>. </char></note> <verse eid="EZK 12:13" /><verse number="14" style="v" sid="EZK 12:14" />Qarqara isike'n hedheeka isika gargaarsanjuwwanna isika loliinka manna duuchchin darre'n xeerannon; wolaantichchikinna insa'ne'e shorannon.<verse eid="EZK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 12:15" />«Gosa gosake ardi giddo insa'nee xeeranno woddanna boga duuchcha'n insa'nee facaasanno wodda, ookkone wodda ani Duuchchi Woddike Gootta kadennexxa egennaan. <verse eid="EZK 12:15" /><verse number="16" style="v" sid="EZK 12:16" />Yaane kinni insaneeke gosa gosake ardi giddo diqachchiisaaxxa insa'nexxa huje haasonnashsha insa'nenaa'n heenoka manna wolaantichchokenaa'n solo'okenaa'inna balatenaa'n gatisannon; ookkone wodda ani Duuchchi Woddike Gootta kadennexxa egenaan.»<verse eid="EZK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 12:17" />Duuchchi Woddike Goottik hiyyichchi higgena ane'n dageexxi, <verse eid="EZK 12:17" /><verse number="18" style="v" sid="EZK 12:18" />«Koo manjiinke belto ittatto wodda alayyik iti; ha'witatto woddanna sodatta'ninna culphissa'n ha'wi. <verse eid="EZK 12:18" /><verse number="19" style="v" sid="EZK 12:19" />Boginke arda'ninna ‹Lumok Duuchchi Woddik Gootti Iyyerusaaleminna Isira'eelike boga'n hedha'neekaara hiyya'nee qici: Ookko hedha'neeke manni duuchchixxe xaqaronaa'n kexxeexxa bogi insa'nek duwwi gatamaaxxee ita ifixxa abarat indaan; wode'ekanna alayyik ha'winaan. <verse eid="EZK 12:19" /><verse number="20" style="v" sid="EZK 12:20" />Manji hedhammaki qachchuwwi diigemaan; bogikinna onake kadaan; eettene yanna ani Duuchchi Woddike Gootta kadennexxa egendinaan› hiyyi.»<verse eid="EZK 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 12:21" />Duuchchi Woddike Goottik hiyyichchi higgeen ane'n dageexxi: <verse eid="EZK 12:21" /><verse number="22" style="v" sid="EZK 12:22" />«Koo manjiinke belto Isira'eelike boga'n ‹Bari qeeredhe'een; waleella duuchchanna wayi fuldabaaxxe kadde'een; hitina'neek tinni hiyya maachcho?› <verse eid="EZK 12:22" /><verse number="23" style="v" sid="EZK 12:23" />Ati insa'nee ‹Luomok Duuchchi Woddik Gootti tenne hiyya ani gatisannon; Isira'eelike boga'n langaxxa haaso'ake'n isoo la'ofantabaan› hitato qici, ‹leella duuchcha muuxendaaxxi barra shiqqe'een. <verse eid="EZK 12:23" /><verse number="24" style="v" sid="EZK 12:24" />Isira'eelike ardi giddo dhariinxi waleellanna elle alfatee dhariinxa moro mora hexxabaan. <verse eid="EZK 12:24" /><verse number="25" style="v" sid="EZK 12:25" />Yaane kinni ani Duuchchi Woddik Gootti haaso'annon; haaso'annoka hiyyichchinna turebaang muxemaan; koo ha'no jalliyye arda haaso'ennexxa duuchcha ha'noke barro'n muuxannon› hiyye ani Duuchchi Woddik Gootti haaso'ennen.»<verse eid="EZK 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 12:26" />Duuchchi Woddike Goottik hiyyichchi ane'n higgeen dageexxi, <verse eid="EZK 12:26" /><verse number="27" style="v" sid="EZK 12:27" />«Koo manjiinke belto Isira'eelik ardi ‹Kunni manjichchi uuda'neexxi waleella edi'a qeerrake baro'n kaddaaxxen; haaso'aneexxi wabeekummanna qeerrake barixxen› hiyyaan.<verse eid="EZK 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 12:28" />«Tennexxee hitatto qici, ‹Lumok Duuchchi Woddik Gootti haaso'enneke hiyyichchinaa'n ta'anni edi'a hekki hiyyaak hedhebaan; haaso'annoxxi duuchchi muxendaan› hiyya'neen Duuchchi Woddik Gootti.»<verse eid="EZK 12:28" /></para>
  <chapter eid="EZK 12" />
  <chapter number="13" style="c" sid="EZK 13" />
  <para style="s1">Dhariyye Wabeekole'n Murte Uwwende</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 13:1" />Duuchchi Woddike Goottik hiyyichchi ane'n dageexxi: <verse eid="EZK 13:1" /><verse number="2" style="v" sid="EZK 13:2" />«Koo manjiinke belto raaga raagga'neexxe Isira'eelixxe wabeeko'n raaga raagi yaada ifika raaga raagaakaara: ‹Duuchchi Woddike Goottika hiyyichcho laqqe! <verse eid="EZK 13:2" /><verse number="3" style="v" sid="EZK 13:3" />Lumok Duuchchi Woddik Gootti: Mittelchonna afebaang ifika yaada hordofaaxxe gowwa wabeeko'a aanne'e! <verse eid="EZK 13:3" /><verse number="4" style="v" sid="EZK 13:4" />Koo Isira'eelike ardaa wabeekole ha'noxxi oleti giddo hexxammaxxe yayyuwwashshaten. <verse eid="EZK 13:4" /><verse number="5" style="v" sid="EZK 13:5" />Duuchchi Woddike Goottixxe barrake lola'n jabaante uurrinaashsha diigemeeka kinjiinka dalla'a Isira'eelike ardi'a qammalchitino'a alalle martineba'a. <verse eid="EZK 13:5" /><verse number="6" style="v" sid="EZK 13:6" />Insa'ne uunda'neexxi leellanna dharaken; moro insaneexxinna sobaken; Duuchchi Woddik Gootti insa'nee ergebaang, «Duuchchi Woddik Gootti hiyya'nee qici» hinaan; yaane kinni haasonemmaxxi muuxendo'a heqqenaa'n. <verse eid="EZK 13:6" /><verse number="7" style="v" sid="EZK 13:7" />Ani haaso'ebe'nong «Duuchchi Woddik Gootti hiyya'nee qici» hitinaa wodda dharitte waleella uudinebaata? Dharinxa moro mortinebaata?<verse eid="EZK 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 13:8" />« ‹Tennexxee Lumok Duuchchi Woddiki Goottinna hiyyichchi ha'nok dharake, leella ha'noxxinna sobake kaddemmaxxee ani ha'no'n ke'eennen; ani Lumoke Duuchchi Woddik Gootti tenne haasoe'ennen <verse eid="EZK 13:8" /><verse number="9" style="v" sid="EZK 13:9" />Dharinxa waleella uuddaxxe'ninna sobik mortaaxxe wabeekole'n ani ke'annon; Insa'ne arda ankixxe songo giddo he'nabaan; Isira'eelike ardi boreessemmake maxaafa'ninna borreesamabaan; Isira'eelike boga'inna e'yinabaan; ookkone wodda ani Lumoke Duuchchi Woddike Gootta kadennexxa egendinaan.<verse eid="EZK 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 13:10" />« ‹Tinni wabeekole nage'i hedhebaang «Nage'aken» hita'n arda anka dedhissemmaxxee insa'ne dooqqexxe gimo'n boo'e issati qammalcheeke hujalluwwa lanbaa.<note caller="-" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="JER 6:14">Erm. 6:14</ref>; <ref loc="JER 8:11">8:11</ref>. </char></note> <verse eid="EZK 13:10" /><verse number="11" style="v" sid="EZK 13:11" />Tennexxee gimo itti ibaaxxa boo'e issammakera'n kuli. Baradi xeeni ganaan; jabaxxa kaadenna wocci assannon; hobonbaltetinna isoo gandaan. <verse eid="EZK 13:11" /><verse number="12" style="v" sid="EZK 13:12" />Dalla'i ibaa wodda ardi ha'noo «Iso'n isitinemmaxxi boo'e haba hexxe hiyye ha'noo qorabaata?» hiyye.<verse eid="EZK 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 13:13" />«‹Tennexxee Lumok Duuchchi Woddik Goottinna aare anxenni hobonbalte baradakannna kaade eettenne gimo'n wocci assee isoo diigannon. <verse eid="EZK 13:13" /><verse number="14" style="v" sid="EZK 13:14" />Ha'nooxxa noora issitinemmaxxa gimonna diigannon; booso isixxi banqarte leellitaa qico'n buttink buttinake assannon; gimo ibaa wodda ha'nonna isi giddo muddinaan; ookkone wodda ha'nonna ani Duuchchi Woddik Gootta kadennexxa egendinaan. <verse eid="EZK 13:14" /><verse number="15" style="v" sid="EZK 13:15" />Aare anxi qiida qico'n gimote'n boo'e isseeke manna xixannon; dalla'akanna diigannon; ookkonechchi uduma ani ha'no'n, «Gimo ittinna ise'n boo'e issemmak manni hedhebaan hiyyannon. <verse eid="EZK 13:15" /><verse number="16" style="v" sid="EZK 13:16" />Iyyerusaalemi'a wabeekumma haasotemmaxxinna nage'i hedhebaang nage'inxa waleella ise'a uuddemmaxxi tenne Isira'eelixxe wabeekkolen; hiyya'neen Luomk Duuchchi Woddike Gootti.» ›<verse eid="EZK 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 13:17" />«Ta'anna koo manjiinke belto yaada ifikenaa'n raaga raaggaaxxe atike ardixxe dubarteba'a alba wirri hitee insa'ne'n raaga raagi <verse eid="EZK 13:17" /><verse number="18" style="v" sid="EZK 13:18" />hitatto qici, ‹Lumok Duuchchi Woddik Goottinna: Ardinxa lubbo fonxoratee gojotika qudhaama ifixxe angake mikita duuchcha'n gobilsitaaxxeri'anna gargar gargar hexxeexxe qeerrinixxa umo buqecatixxa boonde giissexxaaxxe melaalle'a aanne'e! Ha'no anke ardixxa lubbo addandina'n kinni ifixxa lubbo anjidhitinaata? <verse eid="EZK 13:18" /><verse number="19" style="v" sid="EZK 13:19" />Oobo wo'mabaake so'i'anna kutisanjo buddeeni'a hitineexxi dhara laqaaka anka arda sobbiyyoti reyammabaakaara shiyiyyoti, hedhiyyo hasisabaakaara gatisiyyoti arda anki giddo anee salphissine'een.<verse eid="EZK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 13:20" />« ‹Tennnexxe Lumok Duuchchi Woddik Gootti Ardinxa lubbo ci'atishsha fonxortineeke qudhaama'n ke'edhennen; ha'noxxe angake mikitinaa'inna isoo dadarannon; ci'atishshanna fonxortineeka ardanna ha'noxxe anga'n fulchannon. <verse eid="EZK 13:20" /><verse number="21" style="v" sid="EZK 13:21" />Ha'noka umo buqecatixxa boondenna daddarennexxi arda anka ha'noxxe anganaa'n anjirannon; ta'inni edi'a insa'ne ha'no unda galabaan; eettene yanna ani Duuchchi Woddike Gootta kadennexxa egendinaan. <verse eid="EZK 13:21" /><verse number="22" style="v" sid="EZK 13:22" />Ani yaadisebe'noka qulcha manjo dharik yaadissinemmaxxee, fuggichchi fuggoke orinaa'n higeexxi lubbo ifixxa anjirabaashsha cubbote'n tirtirsitnemmaxxee, <verse eid="EZK 13:22" /><verse number="23" style="v" sid="EZK 13:23" />Ta'anni edi'a tinni melaalle dharnixa waleella uuddinaba'a; morotanna mortinaba'a; arda anka ha'nooxxe anganaa'n anjirannon; eettene yanna ani Duuchchi Woddike Gootta kadennexxa egendinaan.› »<verse eid="EZK 13:23" /></para>
  <chapter eid="EZK 13" />
  <chapter number="14" style="c" sid="EZK 14" />
  <para style="s1">Fakkuwwa Magnooffatammake'n Murte Murende</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 14:1" />Isira'eelixxe geedhuwwanaa'n mitte mitte anba dageexxi ani edi darre ofolde; <verse eid="EZK 14:1" /><verse number="2" style="v" sid="EZK 14:2" />Duuchchi Woddike Goottik hiyyichchi ane'n dageexxi, <verse eid="EZK 14:2" /><verse number="3" style="v" sid="EZK 14:3" />«Koo manjiinke belto kunni manni magenoonfatammaxxa fakkuwwa godoba masse'ne'een; ifixxa fuggonna gugufachotike kinjishsha ifi edo uggudhine'een. Hittata ane'e mise yaane laqqe'naata? <verse eid="EZK 14:3" /><verse number="4" style="v" sid="EZK 14:4" />Tennexxe ati insa'ne'n ‹Lumok Duuchchi Woddik Gootti huuni Isira'eelik ardi magenoonfachchotixxa fakke godobi giddo abixxeexxi fuggo ifixxanna gugufachchotike kinjishsha ifi edo uggudheexxi wabeekichchinba'a maroole ani Duuchchi Woddik Gootti ookkone manjixxe fakkuwwaxxe birasa'neshshanni isi'a geyaaka hiissichcho uwwannon. <verse eid="EZK 14:4" /><verse number="5" style="v" sid="EZK 14:5" />Tenne'e assannochchinna fakkuwwa magenofatati anenaa'n gargar higeemmake Isira'eelike ardi duuchchika godoba aniba'a wirri assona'aten.›<verse eid="EZK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 14:6" />«Tennexxee Isira'eelike arda'n Lumok Duuchchi Woddik Gootti hiyya'ne'n hitatto qici, ‹Aade aagineexxi ha'noxxe fakkuwwanaa'n illeema higge; diqachchiissa'neexxa ha'noxxa magenofachchonna waalle.›<verse eid="EZK 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 14:7" />« ‹Huuni Isira'eelik manji yookaan Isira'eeli giddo hedheek alag ifi anenaa'n gargar hiissati fakkuwwa godoba abixxoole, fuggotanna guggufachchotike kinjishsha ifi edo uggudheexxi anee laqedho'a wabekichchiba'a dageexxe kaddoole, ani Duuchchi Woddik Gootti umo angeninni hissichcho isia'a uwwannon. <verse eid="EZK 14:7" /><verse number="8" style="v" sid="EZK 14:8" />Alba anka fuggoxxenni ookkone manjo'n wirri assannon; beessisakeenna mammakemaake assannon; anke ardi giddi'ninna isoo fuggussanon; eettene yanna ani Duuchchi Woddike Gootta kadennexxa egendinaan.<verse eid="EZK 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 14:9" />« ‹Mitti wabeekichchi wabeekumma haaso'o'a sobemoole, ookkone wabeekichcho sobennek ante Duuchchi Woddike Goottan; hirre anxa iso'n ke'ennexxi arda anke Isira'eeli giddi'n isoo balleessannon. <verse eid="EZK 14:9" /><verse number="10" style="v" sid="EZK 14:10" />Wabeekichchikinna isoo qodhdho'a dageekeerinna welti qixxe balleessanjoke kandemmaxxee balleesa insa'nexxee insa'ne xixemmaan. <verse eid="EZK 14:10" /><verse number="11" style="v" sid="EZK 14:11" />Ta'anni edi'a Isira'eelik ardi dedheexxi aninaa'n gargar higabaan; higgenna cubbo ifixxe duuchchinni ifi battoossabaan; insa'ne anke arda kandaan; aninna insa'neke Mageno kadannon; hiyya'neen Lumok Duuchchi Woddik Gootti› » hiyye.<verse eid="EZK 14:11" /></para>
  <para style="s1">Fullabaaxxa Murte</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 14:12" />Duuchchi Woddik Goottik hiyyichchi ane'n higgeen dageexxi, <verse eid="EZK 14:12" /><verse number="13" style="v" sid="EZK 14:13" />«Koo manjiinke belto mitte bogik manni ani'a addatema gophiyyoti anee balleessoolenna aninna anga anxa iimi'a adhee ita insa'neexxixxa muumme bassonnole, solo'okanna iyyedagennexxi manjo hore isa'neka bironnole, <verse eid="EZK 14:13" /><verse number="14" style="v" sid="EZK 14:14" />Nohi, Dani'eelinna Iyoobi kunni sasi manni ookkone boggi giddo he'neelenna midde insa'ne qullumma ifixxenni anjirraak umo ifinge callamman; tenne haaso'ek Duuchchi Woddik Goottan.<verse eid="EZK 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 14:15" />«Yookaan fuggichcha biniichcha bogake'n wocci asse'naa boga ardi belo gatisoolenna biniichchakenaa'n kexxeexxa bogi manji giddii'n sa'abaake onake kadoole, <verse eid="EZK 14:15" /><verse number="16" style="v" sid="EZK 14:16" />Duuchchi Woddike Gootta hedhaa'neke kadenneshshanni kunni sasi manni ookkone boga'n hedheexxenna kaddoole midde ifixxa labbaxxanna meyyaxxa oose anjira dandeenabaan insa'ne calla anjiremmaan; bogi ikki kinni onake kadaan.<verse eid="EZK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 14:17" />«Ookkone boga bagedo erge, ‹hore manjo birennele› <verse eid="EZK 14:17" /><verse number="18" style="v" sid="EZK 14:18" />ani Duuchchi Woddik Gootti hedhaannekixxa kunni sasi manni ookkone bogi giddo hedhoole midde umo ifinge calla anjira malee ifixxa labbaxxanna meyyaxxa oose dande'e anjirabaan.<verse eid="EZK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 14:19" />«Yookaan ookkone boga'n bala ibisonolenna aare anxa munde dhangalaase'e hore manjo birennele, <verse eid="EZK 14:19" /><verse number="20" style="v" sid="EZK 14:20" />ane'e hedhaanneke Duuchchi Woddike Goottixxa, Nohi, Dani'eelinna Iyyoobi ookkone bogi giddo he'noole midde qullumma ifixxenni umo ifinge calla anjirra malee ifixxa labbaxxanna meyyaxxa oose anjira dandeennabaan.<verse eid="EZK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 14:21" />«Lumok Duuchchi Woddik Gootti hiyya'nee qici, hore manjo ise'nenaa'n bironna'a anxa bajabaja assitaaxxa shoole murtuwwa: bagedo, solo'o, fuggichcha biniichchanna bala Iyyerusaalemi'n iyyedaganno woddafa'a hittatta fuggattuta! <verse eid="EZK 14:21" /><verse number="22" style="v" sid="EZK 14:22" />Yaane kinni ookko'n gateexxi fulaak labba meyyak hedha; insa'nenna ha'noba'a dangaan; ha'nonna insa'neka fuggoka me'injonna fuggoxxa huje insa'nexxa uuddinaa wodda ani Iyyerusaalemi'n idagenexxe ba'ne duuchcha uuddaaxxenni baganni hitinaan. <verse eid="EZK 14:22" /><verse number="23" style="v" sid="EZK 14:23" />Insa'neka fuggoka me'injo insa'nekanna insa'nexxa fuggoxxa huje uuddinaa wodda ani mitte yaanenna insa'ne'n tola boddichcha assebe'noxxa wo'mitinammaxxee baganni hitinaan; Lumok Duuchchi Woddik Gootti tennee haaso'edheen.»<verse eid="EZK 14:23" /></para>
  <chapter eid="EZK 14" />
  <chapter number="15" style="c" sid="EZK 15" />
  <para style="s1">La'o Afebaaka Woyyinetike Haqichchika Fakkeenna</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 15:1" />Duuchchi Woddike Gootti hiyyichchi higgenni ane'n dageexxi, <verse eid="EZK 15:1" /><verse number="2" style="v" sid="EZK 15:2" />«Koo manjiinke belto woyinetik haqichchi gongomi giddo hedheeke haqichchuwwixxe damuwwanaa'n mayik woyyo'aa? <verse eid="EZK 15:2" /><verse number="3" style="v" sid="EZK 15:3" />La'o afeechcho giissemak haqichchi woyinetike haqichchinaa'n aadheme ege'neeta? Miyi fannisemaak fannisajjo isinaa'n giissemaachota? <verse eid="EZK 15:3" /><verse number="4" style="v" sid="EZK 15:4" />Ha'yaashsha giirate'n uggemeechchi uduma giira qacce isixxe'n bubbi hittee'na'a oddo giddo gubatoole mitte yaane la'o uwwaxxi hexxeeta? <verse eid="EZK 15:4" /><verse number="5" style="v" sid="EZK 15:5" />Yoona gubatebaa edi darre mitteelchi'anna la'o uwwa gopheechchinni giira itte'na'a gubateechchi udumata hitta la'o uwwa dande'ataa?<verse eid="EZK 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 15:6" />«Tennexxee Lumok Duuchchi Woddik Gootti hiyya'nee qici: Gongomiinxe haqqe giddii'n woyinetika haqichcho giira ittaashsha uwwenneshshanni iittanni Iyyerusaalemi giddo hedheeka manna sa'isse uwwannon. <verse eid="EZK 15:6" /><verse number="7" style="v" sid="EZK 15:7" />Alba ankanna fuggoxxenni insa'nebaa wirri assannon; giiratenaa'n fulloolenna giira insa'nee ittaan; ani fuggoxxenni insa'nebaa alba anka wirri assanno wodda ha'no ani Duuchchi Woddike Gootta kadennexxa egendinaan. <verse eid="EZK 15:7" /><verse number="8" style="v" sid="EZK 15:8" />Addatema gophiyyo insa'nexxenaa'n kexxeexxa bogga konne onake assannon hiyya'neen, Lumok Duuchchi Woddik Gootti.»<verse eid="EZK 15:8" /></para>
  <chapter eid="EZK 15" />
  <chapter number="16" style="c" sid="EZK 16" />
  <para style="s1">Iyyerusaalemi Addatema Gophphe</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 16:1" />Duuchchi Woddike Goottik hiyyichchi higgeen ane'n dageexxi, <verse eid="EZK 16:1" /><verse number="2" style="v" sid="EZK 16:2" />«Koo manjiinke belto Iyyerusaalemi assiteexxa diqachchiissaaxxa huje ise'ninni kokeessi; <verse eid="EZK 16:2" /><verse number="3" style="v" sid="EZK 16:3" />Lumok Duuchchi Woddik Goottinna Iyyerusaalemixxee hiyya'ne hitatto qici, ‹Hundaayye atixxinna ilendettebi Kenaanitotike boga'n, anni atiki Amooritote, ama atixxinna Hiititotemman. <verse eid="EZK 16:3" /><verse number="4" style="v" sid="EZK 16:4" />Ilendettexxa barra ha'nurendebexxo; ca'a hitotta'anna wodi'ik anshendebexxo; maxinetinna dhidhibendebexxo; seemmatinna bukki assendebexxo. <verse eid="EZK 16:4" /><verse number="5" style="v" sid="EZK 16:5" />O'wiinxe illenni atee uudeexxi yookaan ati'a yaadeexxi konneechchuwwinaa'n mittekanna midde ati'a asseek mitti manjinna hedhemmabaan; ilendettexxa barra tuffatendeetexxi diidake'n hunendette malee.<verse eid="EZK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 16:6" />« ‹Aninna ookko'n sa'a'n ilendetteke gadabi giddo gangalataa'naa afenne; gadabi giddo hexxee'na'a ate'e «Lubbo gali» hiyyenne. <verse eid="EZK 16:6" /><verse number="7" style="v" sid="EZK 16:7" />Fichchi giddixxe lattoshsha atee nophitattoshsha assenne; atinna nophphitette; danchootette; ununi atikinna guntute; umi atikinna nophphe; yaane kinni duwwi hexxetaan.<verse eid="EZK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 16:8" />« ‹Langaxxa ati birii'n sa'anna wodda atibaa uudenne; halchematee gelteettexxa afenne wodda fuggateennaxxa seemmanni atee teele'e saala atika buqennexxi atee aadhona'a danchoossennexxi atinni weli aagenne, atinna anxe kaddette, tenne haaso'eek Duuchchi Woddike Gooottan.<verse eid="EZK 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 16:9" />« ‹Wodi'ik atee anshennexxi gadabokenaa'n luqqi assennexxi zayitetanna ate'n issenne. <verse eid="EZK 16:9" /><verse number="10" style="v" sid="EZK 16:10" />Eloke kuulixxa qamise ate'n oddeessenne; yo'oshsha eloxxa goginxa kophe ate'n uggurenne; dancha layinotixxa boonde umo atike'n qaarenne; fiixxeeka kaabbanna ha'na lebe ate'n oddeessenne. <verse eid="EZK 16:10" /><verse number="11" style="v" sid="EZK 16:11" />Seesuwwikinna atee danchoosenne: atixxe anga'n sageetto gooba atike'ninna uggeenne. <verse eid="EZK 16:11" /><verse number="12" style="v" sid="EZK 16:12" />Sano atixxe'ninna sanotixxa qube, manshate'inna gutichcha umo atike'ninna biifaaka kallachcha uggenne. <verse eid="EZK 16:12" /><verse number="13" style="v" sid="EZK 16:13" />Worqetinnaa birretike siblijinni danchoondette; seemma atixxinna biiffaxxa layino, haarretixxanna ganendeexxe kuula elokixxe seemmamman; atixxi itanna yo'oshsha eloxxa bulle, malebokenna ejersiinxe zayitemman; ati qubasaxxe danchoondette; mootitte kadateenna geltette. <verse eid="EZK 16:13" /><verse number="14" style="v" sid="EZK 16:14" />Ani ati'a uwweneke gaachchanninaa'n kexxeexxinni danchumma atixxi qubasaxxeexxe kaddemmaxxee gosa gosake ardi giddo gurra fuldette, tennee haaso'eek Lumoke Duuchchi Woddike Goottan.<verse eid="EZK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 16:15" />« ‹Yaane kinni ati danchumma atixxa addattette; gurra atikanna yabaabulletee la'onfattette; ora sa'aake duuchchinni yabaabula bira saxxette, danchumma atixxinna welekee hosse. <verse eid="EZK 16:15" /><verse number="16" style="v" sid="EZK 16:16" />Seemmuwwa atixxenaa'n mitte mitte aaxxettexxi isenni atixxe magenoonfachchotixxa bakka danchoossite ookkonna yaababuldette; iitta hexxeexxi yaane konne edi darre kadde egendeba'a, edi'anna kaddaba'a. <verse eid="EZK 16:16" /><verse number="17" style="v" sid="EZK 16:17" />Ati'a uwwennexxa anxe worqekanna anke birretike siblijuwwika elollamma seesuwwa aaxxettexxi labbakixxe misile'n fakke ifi'a giissexxe weltinna yabaabuldette. <verse eid="EZK 16:17" /><verse number="18" style="v" sid="EZK 16:18" />Elolla kuuliixxa atixxa seemmuwwanna aaxxettexxi tenne misiluwwa'n buyyitette; anxa zayitenna anka hixaanna tenne misiluwwa edo shiqishshette. <verse eid="EZK 16:18" /><verse number="19" style="v" sid="EZK 16:19" />Ittotta'a ati'a uwwennexxa ita, tinnirinna yo'oshsha eloxxa bulle, malebokanna ejersiinxa zayiteera, fishshake foolike hixaannishsha tenne misiluwwi'a shiqishshette; iitta hexxeexxe yaane assende'een; Lumok Duuchchi Woddik Gootti tenne haaso'edheen.<verse eid="EZK 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 16:20" />« ‹Ani'a ildettexxa labbaxxanna meyyaxxa oose aaxxettexxi itto'a tenne misiluwwa'a tolchitette; yababula atixxi shixxexxemaletee? <verse eid="EZK 16:20" /><verse number="21" style="v" sid="EZK 16:21" />Oose anxaaranna duuldettexxi fakkuwwatee ciincessite shiqishitte. <verse eid="EZK 16:21" /><verse number="22" style="v" sid="EZK 16:22" />Tenneera atixxe diqachchiissaaxxe hujuwwanninna atixxe yabaabulle duuchchanni ama atixxike godobinaa'n fuldeteshsha duwwi hexxe'e ilendeteke gadabi giddo gangallata'n hexxetta woddixxa atixxa oosummatixxa yanna qalli hitebexxo.<verse eid="EZK 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 16:23" />« ‹Lumok Duuchchi Woddik Gootti aanne'e! Aanne ati'a, hiyya'neen; assitettaxxe wele fuggo duuchchi hana lebbettexxi, <verse eid="EZK 16:23" /><verse number="24" style="v" sid="EZK 16:24" />qephphichcha booncho ifi'a giissexxetexxi weldeenna weldeena'n magenoonfachchotika tullichcha giissitette. <verse eid="EZK 16:24" /><verse number="25" style="v" sid="EZK 16:25" />Ora orike kurba'n fakkuwwa magenoonfachchotika qephphichcha boncho giissitette; ora sa'ake duuchchi'a biso atika uwwiyyoti yabaabulle birasa'issita'n danchumma atixxa battoossitette. <verse eid="EZK 16:25" /><verse number="26" style="v" sid="EZK 16:26" />Yabaabulati kutegate'eke ola'a atike Gibtseeke manninni welti yabaabuldette; atixxe yabaabulaxxi birasa'ne mufatannoshsha assite. <verse eid="EZK 16:26" /><verse number="27" style="v" sid="EZK 16:27" />Tennexxee anga anxa atee'n iimi'a adhdhee atike boginaa'n xe'ishenne; atike fuggoke adabixxee atixxe shooka'neexxe naapha atike Filisixeemixxe dubartexxe anga'n atee sa'isse uwwenne. <verse eid="EZK 16:27" /><verse number="28" style="v" sid="EZK 16:28" />Ati ta'anna godda gophphettaxxee Asoorike manninninna yabaabuldette; ookkoneechchi udumanna midde godditebexxo. <verse eid="EZK 16:28" /><verse number="29" style="v" sid="EZK 16:29" />Yabaabulle atixxanna Baabilooni daddaltuwwatike bogi qco'n birassa'isitette; kaddomalee ta'anna godditebexxo.<verse eid="EZK 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 16:30" />« ‹Ille inqaxxa itte'eexxi yabaabulto manjichcho assitaaxxa duuchcha assiteeten, hitta hexxeexxa gophaalette qalbe afeettexxe manjo ati! Hiyya'neen Lumok Duuchchi Woddik Gootti. <verse eid="EZK 16:30" /><verse number="31" style="v" sid="EZK 16:31" />Ori orike gorsuma'n qephphicha boncho giissexxettexxi weldenna weldena'ninna tolchiinka boncho ijaartetten; kaddoolenna wele yabaabulto meelaalleshsha ate'n hedhemmakenaa'n maallaqa adhdhitebexxo.<verse eid="EZK 16:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 16:32" />« ‹Ati aro'o ifike'n hexxe'e wele labballinni hossammaxxe yabaabulto manjichchon! <verse eid="EZK 16:32" /><verse number="33" style="v" sid="EZK 16:33" />Yabaabulto melaalle duuchchi isenni hosemmakenaa'n maallaqa adhdhita; ati kinni atee jaalateekeeri duuchi'a maallaqa giccato; ori orii'ni manji dageexxi atinni yabaabulo'a safatatixxa uwwa insa'ne'a uutatton. <verse eid="EZK 16:33" /><verse number="34" style="v" sid="EZK 16:34" />Tennexxe'e atixxi yabaabulle wele dubartexxenaa'n gargar hexxeexxe; ate'ni hedho'a hasaak ayyinna atee ori'eexxi laqedhiyyo hassissaba'a; atete maallaqa uutato malee ati'a uwwemaba'a; ati wele yabaabulitto dubartexxenaa'n tenne yaanen haranga gargarite.<verse eid="EZK 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 16:35" />« ‹Tennexxe'e tee yabaabultoo! Duuchchi Woddik Goottika hiyyichcho laqi! <verse eid="EZK 16:35" /><verse number="36" style="v" sid="EZK 16:36" />Lumok Duuchchi Woddik Gootti hiyya'nee qici: Kara atixxa dundettaxxee, atike jaaluwwinni yabaabuldetexxenna saala atika buqedha gophphettaxxee, atixxe diqachchiissaaxxe fakkuwwa duuchchixxeenna atixxe oosexxa munde tenne fakkuwwa'a tolchitettexxee, <verse eid="EZK 16:36" /><verse number="37" style="v" sid="EZK 16:37" />tenne buuto'a jaaluwwa atika, itti gammaddatakaara, eetattakaaranna jibbitatakaara duuchcha bukki assannon; insa'ne'e ori ori'naa'n qarqara atike'n bukki assannon; insa'ne edonna atee duwwi gatiseena'a insa'ne saala atika duuchcha uundaan. <verse eid="EZK 16:37" /><verse number="38" style="v" sid="EZK 16:38" />Yabaabulto mellale'ninna manjiinxa lubbo shilteexxe mellaale'n muremiyyo hassisaaxxa murte ani murte ate'n murannon; anxe aarenninna anxe hinaaffenni munde atixxa dune'e ate'n halo fulannon. <verse eid="EZK 16:38" /><verse number="39" style="v" sid="EZK 16:39" />Jaaluwwa atikixxe anga'n atee sa'isse uwwanno; insa'nenna atika qephphichcha boonchuwwanna atika magenofachchotixxa bakkuwwa diingaan; seemmatanna atenaa'n mulqe'naan; dancha seessuwwa atikanna adhdhinaan, saalibelonna anga duwwi atee gatinsaan. <verse eid="EZK 16:39" /><verse number="40" style="v" sid="EZK 16:40" />Insa'ne tuuta ate'n ke'issinaan; tuutatinna kinjikinna atee cancanqaan; wolantichchikinna atee kukkuntaan. <verse eid="EZK 16:40" /><verse number="41" style="v" sid="EZK 16:41" />Minuwwa atikanna gunbaan; heddo melaalle edonna ate'e mura woxxinsaan; yabaabulle atixxa waaldattoshsha assanno, ta'anni edi'aa ani yabaabuldota'a jaaluwwa atikee maallakqa uutabexxon. <verse eid="EZK 16:41" /><verse number="42" style="v" sid="EZK 16:42" />Ookkoneechhchi uduma aare anxi atenaa'n qiiddaan; hinaaffe anxenni ate'n mufatabe'no; aare anxanna qiidifatanon; ta'anni edi'anna ate'n mufatabe'non.<verse eid="EZK 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="EZK 16:43" />« ‹Ati tenne yaanuwwan anee mufachchiisette malee atika oosummatika baro qaabatebexxon; tennexxee huje atixxika hira ati'a uwwannon; hiyya'neen Lumok Duuchchi Woddik Gootti; wele atixxe diqachchiissaaxxe huje hana yabaabulle lebbe'ebexxoota?<verse eid="EZK 16:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 16:44" />« ‹Mammaakaaki duuchchinna: «Belto amande'n fulda» hiyya'n atixxee mammakaan. <verse eid="EZK 16:44" /><verse number="45" style="v" sid="EZK 16:45" />Ati aro'o ifikanna oose ifixxa diqattammaxxe atixxe ama'ninni fuldette; ati aro'o ifikanna oose ifixxa tuffatamaxxe atixxe dayyuwa'inni fuldette; anni ha'nok Keexichchoke ama ha'noxxinna Amoorichchotemman. <verse eid="EZK 16:45" /><verse number="46" style="v" sid="EZK 16:46" />Atixxi angafa dayyo atenaa'n middi darre'n ifixxe meyyaxxe oosenn hexxa'neexxe Semaariyate; atixxi maa'na dayyonna atenaa'n bitta'i darre'n ifixxe meyyaxxe oosenni hexxa'neexxe Soodoomite. <verse eid="EZK 16:46" /><verse number="47" style="v" sid="EZK 16:47" />Ati insa'neka ora me'anna insa'nexxa diqachchiissaaxxa huje assa calla kaddebaak ikki woddi elobaake adabinni insa'nee caaldetexxe kaddette. <verse eid="EZK 16:47" /><verse number="48" style="v" sid="EZK 16:48" />Ane'e hedhaaneke Dada Duuchchike Duuchchi Woddike Goottixxa, atinna oose atixxi meyyaxxi assitteexxa dayyo atixxi Soodoominna isexxi mayyaxxi oose midde assiteba'a.<verse eid="EZK 16:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="EZK 16:49" />« ‹Dayyo atixxe Soodoomi assita'emmaxxi cubbo: isenna isexxi mayyaxxi oose ifi duka, godoba eeneshsha goddanna fedhe galatemman; isenna hiyyeeyyetanna rakkiyye gargaratemmaba'n. <verse eid="EZK 16:49" /><verse number="50" style="v" sid="EZK 16:50" />Insa'nee hollameyyetamman; ani edonna diqachchiissaxxa yaane assineexxa afennexxi ifi edi'n insa'ne fuggussenne. <verse eid="EZK 16:50" /><verse number="51" style="v" sid="EZK 16:51" />Semaariya ati hujjettexxe cubboka gamisa midde hujjebaan; ati insa'ne caala hara diqachchiisseexxa yaane assiyyot, tenne huje duuchchinni dayyuwwa atixxa qulliyyete labbaashsha assitette. <verse eid="EZK 16:51" /><verse number="52" style="v" sid="EZK 16:52" />Dayyuwwa atixxi qulliyyete lanbaashsha assitettexxe shookko oddo'wi, cubbo atixxi insa'nexxenaa'n hara diqachchiissaxxe kaddemmaxxe'e insa'ne ati caala qulliyyete lanbe; tennexxee dayyuwwa atixxa qulliyyete lambaashsha assitettexxee shooko oddo'wi.<verse eid="EZK 16:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="EZK 16:53" />« ‹Yaane kinni Soodoomixxenna isexxe meyyaxxe oosexxa, ittanni Samaariyaaxxenna isexxe meyyaxxe oosexxa booji'o hissannon; atixxa booji'onna insa'nexxa hiissanno wodda hiissannon. <verse eid="EZK 16:53" /><verse number="54" style="v" sid="EZK 16:54" />Tinni iitta kaddaachchi ati assitettexxe huje duuchchanni insa'ne baseefantake kandaashsha assitettaxxe'e salphattattoshshanna assitettexxe duuchcha'n shookkattoshshaten. <verse eid="EZK 16:54" /><verse number="55" style="v" sid="EZK 16:55" />Atixxi dayyuwwa Soodoomi'ninna isexxi meyyaxxe oose'n, ittanni Semaariya'ninna isexxe meyyaxxe oose'n edi wodda he'nemaxxe jiroba'a insa'ne'n higgaan; ate'ninna atixxe meyyaxxe oose'n edi wodda hexxinemmaxxe jiro'n ha'no higginaan. <verse eid="EZK 16:55" /><verse number="56" style="v" sid="EZK 16:56" />Ifi dukaattaka sane dayyo atixxe Soodoomika summa midde afo'o atikenni tuqqa'atabaan. <verse eid="EZK 16:56" /><verse number="57" style="v" sid="EZK 16:57" />Iikki woddinna cubbo atixxi farri hite leellitebaa edi darremman. Ta'a kinni atike qarqara'n hexxe'e atee tuffataaxxe Edoomixxe<note caller="+" style="f"><char style="fr" closed="false">16:57 </char><char style="ft" closed="false">heddo olmixxe Ibirayisixxennenninna wele Sursixxe tikaarinni welti weli aaggoolenna heddo Ibirayisixxi, Valgeetixxi torbaane tomme beekolexxi tikaar kinni Aaraami hitaan</char></note> meyyaxxe oose'anna isek olla'uwwi duuchchi'a, iittaanni Filisixeemixxe meyyaxxe oose'a Sodomishsha gacifachchotixxe kaddeeten. <verse eid="EZK 16:57" /><verse number="58" style="v" sid="EZK 16:58" />Atixxe yabaabullexxeenna atixxe diqachchiissaaxxe hujexxee xixendatton; hiyya'neen Duuchchi Woddike Gootti.<verse eid="EZK 16:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="EZK 16:59" />«‹Lomok Duuchchi Woddik Gootti hiyya'enee qici: Kako anxa diigati afo'o sa'a anxa tuffatettexxee ate'e geyaaka xixichcho xixannon. <verse eid="EZK 16:59" /><verse number="60" style="v" sid="EZK 16:60" />Kaddo malee oosumma atixxi wodda ati'a aagennexxa kako qaabatannon; duuchchi woddi'anna hexxaaxxa kako ati'a aagannon. <verse eid="EZK 16:60" /><verse number="61" style="v" sid="EZK 16:61" />Ati'a angaffaaxxaranna ati'a maa'nitaaxxa atixxa dayyuwwara ati'a meyyaxxe oose kandaashsha uwwano wodda, ati me'injo atika qalli hitettexxi shookkatton; tinni kaddaak kinni ati'a aagennaxxe anxe kakoxxeetebaan. <verse eid="EZK 16:61" /><verse number="62" style="v" sid="EZK 16:62" />Tennexxee ati'a aagennexxa kako anxa qamalchannon; hiyya'neen Duuchchi Woddiki Gootti; ookkone wodda ani Duuchchi Woddike Gootta kadennexxa egendatton. <verse eid="EZK 16:62" /><verse number="63" style="v" sid="EZK 16:63" />Assitettexxe duuchchi'a ati'a gattowaal hiyyano wodda balleessa ifixxa qalli hitettexxi shookkatton; salphphine atikenaa'ninna kexxeexxa mittelchonna buccuqqi hitabexxo; tenne haaso'eek Lumoke Duuchchi Woddike Goottan.› »<verse eid="EZK 16:63" /></para>
  <chapter eid="EZK 16" />
  <chapter number="17" style="c" sid="EZK 17" />
  <para style="s1">Lame Sinbiriinkanna Woyyinetika Fakkeenna</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 17:1" />Duuchchi Woddike Goottik hiyyichchi higge'n ane'n dageexxi, <verse eid="EZK 17:1" /><verse number="2" style="v" sid="EZK 17:2" />«Koo manjiinke beltoo hibbo tenne'e Isira'eelike arda'n mammaasik, <verse eid="EZK 17:2" /><verse number="3" style="v" sid="EZK 17:3" />Insa'ne'n hitatto qici: ‹Dada Duuchchik Duuchchi Woddik Gootti hiyya'nee qici, lumoka keelanna bisi isikixxi guchchenna taltalle calla kade'eek lumok sinbiri Libaanoosi dageexxi mitte birbirsiinxa qacce enqe aadhe, <verse eid="EZK 17:3" /><verse number="4" style="v" sid="EZK 17:4" />qaccetenaa'ninna iimixxa reefixxa kichcho kute aadhe iyyemareexxi daddaltotike boga'n daddaltotike mitte qachchi giddo kaase.<verse eid="EZK 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 17:5" />« ‹Sinbir ikkinna Isira'eelike boganaa'n sanne aadheexxi shaqqake buttina'n gayaak wodde'e alfitaxxe bakka'n hokokotike haqichchishsha kaase. <verse eid="EZK 17:5" /><verse number="6" style="v" sid="EZK 17:6" />Isenna lattee wodda hojja haru'meexxi dagale daaleeke woyyinetike hiddichcho kadde; damuwwa isixxinna sinbiri darre'n nophphite; hidduwwi isik kinni isinni hundi'a nophphe. Tennexxee woyyinetike hiddichcho kadeexxi damuwwatanna daddadhdhe shafuwwakanna fulche.<verse eid="EZK 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 17:7" />« ‹Iittanni lumoke keeluwwikinna biso isikixxi guchchenna taltalle calla kadeek weli lumook sinbiri hedhemman; iikki woyyinetik hiddichchi wode'e alfiyyotee kaasememmaxxe bakka'naa'n hidduwwa konne sinbiri darre'n yaase; damuwwatanna isi darre'n daalche. <verse eid="EZK 17:7" /><verse number="8" style="v" sid="EZK 17:8" />Kunni woyyintik hiddichchi damuwwa daddadhaashsha, gumma gummisashshanna eloke woyyinteke hiddichcho kadaashsha geyaake wodi'i bira shaqake buttina'n kaasemeemman.›<verse eid="EZK 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 17:9" />«Innsa'ne'ni hitatto qici, ‹Lumok Duuchchi Woddik Gootti hiyya'neen hitatto qici: Kunni woyinetik hiddichchi abixaata? Goshemeexxi gumma harcaate'naa bagabaata? Kichchuwwa isixxi duuchchinna baggaan; iso'o hiddik goshiyyotee lumoxxi hunna yookaan heddi manni hasisabaan. <verse eid="EZK 17:9" /><verse number="10" style="v" sid="EZK 17:10" />Wele bakka'n gosheme kaasemeele midde nophphaata? Boroti darree'n qilla gamoojjee'n gandaaxxi diidallo gandoole kaaseme hedhemmaba'a mitteshshumma bage gatabaata?› hiyya'neen.»<verse eid="EZK 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 17:11" />Ookkoneechchi uduma Duuchchi Woddik Goottik hiyyichchinna higge'n ane'n dageexxi: <verse eid="EZK 17:11" /><verse number="12" style="v" sid="EZK 17:12" />«Konne jallichcha arda'n hitato qici, ‹Tenne yaanuwwaxxi tika maachcho kaddeexxa egendine'e?› Insa'ne'n hitato qici: ‹Baabiloonik moyanji Iyyerusaalemi mareexxi iseka moyanjonna iseka ja'laabuwwa booji'e insa'nee aadheexxi Baabilooni'a illeema hige. <verse eid="EZK 17:12" /><verse number="13" style="v" sid="EZK 17:13" />Ookkoneechchi uduma Moyanjummatike mini hadinaa'n mitte aadheexxi isinni welti weli aage; isi'anna addatemeeke kadaashsha kakachchiise; bogiikinka akeekisanjuwwa booji'e adhdhe. <verse eid="EZK 17:13" /><verse number="14" style="v" sid="EZK 17:14" />Tenneenna assechchi Yihudaxxi mootumma salphateexxi weli aaggo isixxa heqqexxa'n hexxaashshanna langaxxa nammi hitabaashsha assiyyoteetemman. <verse eid="EZK 17:14" /><verse number="15" style="v" sid="EZK 17:15" />Yaane kinni haarok Yihudak moyanji iso'n ke'e; fadhadokanna heddo sannachcha alfiyyotee erganjuwwa ifika Gibtsee'a erge; tinni isi'a qajeeldaata? Iitta hexxeexxa yaane assek manji fulaata? Weli aago diigeek xixemebaak gataata?<verse eid="EZK 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 17:16" />« ‹Dhugaa ani hedhaanekixxa! Hiyya'een Lumok Duuchchi Woddike Gootti! Kunni moynji weli aago isixxa tufatemmakike, kako isixxa diigemmakikenna isoo moyaashsha assemmakike moyanjike boga'n Baabiloon reyaan. <verse eid="EZK 17:16" /><verse number="17" style="v" sid="EZK 17:17" />Baabiloonk manni heddo lubbo biryotee qachcha qoqobe'e buttinna tullubaaxxanna kollo giissaaxxa yanna Feri'ooni ifike jajjabba sannachinninna heddo ifike loliinke manninni isoo lolik gargaara dande'abaan. <verse eid="EZK 17:17" /><verse number="18" style="v" sid="EZK 17:18" />Kako diigiyyoti afo'o sa'emmaxxa yaane tuffatemmaxxenna anga uwweechchi uduma tenne duuchcha assemmaxxee fulabaan.<verse eid="EZK 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 17:19" />« ‹Tennexxee Lumok Duuchchi Woddik Gootti hiyya'nee qici: Ani hedhaaneke kadeneshanni! Anke summinni kakatemmaxxa kako tuffatee aagemmaxxa kako diigemmaxxee kako itti iso'ni geltaashsha assanon. <verse eid="EZK 17:19" /><verse number="20" style="v" sid="EZK 17:20" />Fonxoro anxa isi'a fayyannon; fixi ankinna isoo abidaan; Baabilooninna isoo idagennexxi ane'n finqilemmaxxee ookko iso'n murannon. <verse eid="EZK 17:20" /><verse number="21" style="v" sid="EZK 17:21" />Baajaak isik loliink manni duuchchirinna wolaantichchik shiyemaan; wele gateekaaranna ora ora'n xexeremaan; ookkone wodda ani Duuchchi Woddik Gootti haaso'eennexxa egendinaan.<verse eid="EZK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 17:22" />« ‹Lumok Duuchchi Woddik Goottinna hiyya'nee qici: qeerrake birbissiixxe qaccenaa'n ani umo angenninni iimixxa reefixxa kichcho aadhennexxi isee kaasannon; eettene kichchuwwa giddi'ninna mitte kutennexxi hojja yo'oshsha qeerraxxe koobaxxe xungo'n isee kaasannon. <verse eid="EZK 17:22" /><verse number="23" style="v" sid="EZK 17:23" />Yo'oshsha qeerraxxe Isira'eelixxe kooba hana isee kaasannon; isenna damuwwatanna daddadhittaan; gummatanna gummissaan; gurra fuleeke birbirsanna kaddaan; gargar gargar hexxeexxe sanne duuchchixxi ci'uwwanna ookko galdaan; damuwwa isixxike gaaddisi hundanna hafuura adhdhitaan. <verse eid="EZK 17:23" /><verse number="24" style="v" sid="EZK 17:24" />Gongomiinka haqqichuwwa duuchcha, qeerraka haqichcho harunsannok, haru'meeka haqqichchonna qeerrisanok, ante Duuchchi Woddike Gootta kadennexxa ege'naan; ani haanjaka haqqichcho bassannok bageekanna haanjisannon.</para>
  <para style="p" vid="EZK 17:24">« ‹Ani Duuchchi Woddik Gootti haaso'eennen; haaso'eennexxanna assannon.› »<verse eid="EZK 17:24" /></para>
  <chapter eid="EZK 17" />
  <chapter number="18" style="c" sid="EZK 18" />
  <para style="s1">Cubbo Hujjaaxxi Lubbo Rertaan</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 18:1" />Duuchchi Woddik Goottik hiyyichchi higgeen ane'n dageexxi: <verse eid="EZK 18:1" /><verse number="2" style="v" sid="EZK 18:2" />«Isira'eelike bogixxee;</para>
  <para style="q1" vid="EZK 18:2">« ‹Annuwwi dhangaggoteexxe woyinexxa gumma iteen;</para>
  <para style="q2" vid="EZK 18:2">oosetixxa issonna tutunsite hitina'n mammakina'nek mammaasi maa hiyyoteete›?<verse eid="EZK 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 18:3" />«Dhugaa anee hedhaanekixxa! Ta'inni edi'a konnee mammaasa Isira'eelike boga'n mammaakinabaan; hiyyannen Duuchchi Woddik Gootti. <verse eid="EZK 18:3" /><verse number="4" style="v" sid="EZK 18:4" />Kunnise lubbo duuchcha anxen; annixxi lubbo anxe kaddemmashshanni beltiinxi lubbonna anxen; cubbo hujjaaxxi lubbo ise rertaan.<verse eid="EZK 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 18:5" />«Dhugaatanna qullumma hujaak</para>
  <para style="q2" vid="EZK 18:5">qullichchi manji afemeele,<verse eid="EZK 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 18:6" />Koobuwwate'n magenoonfatendaaxxe fakkuwwa'a tolchemeechcho itaba'a;</para>
  <para style="q2" vid="EZK 18:6">yookaan Isira'eelik ardixxa fakkuwwanna magenoonfatabaan;</para>
  <para style="q1" vid="EZK 18:6">Jaalo ifikixxa areninna yabaabulaba'a;</para>
  <para style="q2" vid="EZK 18:6">aada dubartetixxe'n hexxeexxe manjichchonni welti diiphabaan.<verse eid="EZK 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 18:7" />Ayeenna miicabaan;</para>
  <para style="q2" vid="EZK 18:7">yaane kinni liqeesatee abixxemalcho liqefatemmakee illee iima hiissa;</para>
  <para style="q1" vid="EZK 18:7">Solo'wekee itaalcho uwwa;</para>
  <para style="q2" vid="EZK 18:7">daareekee seemma uwwa malee'e hunnat mulqedhabaan.<verse eid="EZK 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 18:8" />Dhalakee liqesabaa;</para>
  <para style="q2" vid="EZK 18:8">yookaan serbeloke orinni lephpha adhdhabaan;</para>
  <para style="q1" vid="EZK 18:8">Fuggoxxa yaane huja giba;</para>
  <para style="q2" vid="EZK 18:8">manji manjiinxe oddo'n dhugaate mura.<verse eid="EZK 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 18:9" />Seera anka hordofaan;</para>
  <para style="q2" vid="EZK 18:9">ajaja ankanna addatemati heqedha;</para>
  <para style="q1" vid="EZK 18:9">Kunni manji qullichchaken;</para>
  <para style="q2" vid="EZK 18:9">dhugaaten isi hedhoti hedhaan;</para>
  <para style="q2" vid="EZK 18:9">hiyya'neen Lumok Duuchchi Woddik Gootti.<note caller="-" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="LEV 18:5">Lew. 18:5</ref>. </char></note><verse eid="EZK 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 18:10" />«Yaane kinni kunni manjichchi mulqedhaakee yookaan munde manjiixxa dunaaka yookaan tenne cubbuwwanaa'n heenee cubbonna hujaaka belto afo'oole, <verse eid="EZK 18:10" /><verse number="11" style="v" sid="EZK 18:11" />anni isik qullichchi asseexxa duuchchanna assagophoole,</para>
  <para style="q1" vid="EZK 18:11">«Belt isik kinni koobuwwate'n fakkuwwatee tolchemeelcho itoole,</para>
  <para style="q1" vid="EZK 18:11">Jaalo ifikixxe arenni yabaabuloole,<verse eid="EZK 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 18:12" />Hiyyeeyyetanna rakkiyye micoole,</para>
  <para style="q1" vid="EZK 18:12">Hunnati mulqedhoole,</para>
  <para style="q1" vid="EZK 18:12">Liqeesatee abixxemalcho liqefatemakee illeema hiissa gophoole,</para>
  <para style="q1" vid="EZK 18:12">Fakkuwwanna magenoonfatoole,</para>
  <para style="q1" vid="EZK 18:12">Diqachchiissa'neexxa yaanuwwa assoole,<verse eid="EZK 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 18:13" />Dhalakee yookaan lephpho'a liqqeesoole,</para>
  <para style="m" vid="EZK 18:13">Iitta hedheek manji hedhoti hedhaata? Haranga hedhabaan; diqachchiissa'neexxa tennee yaanera assemmaxxee dhugaaten isi reyaan; munde ifixxeenna laqemaak umo isingen.<verse eid="EZK 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 18:14" />«Kunni belti isinna belto i'leenna kunni belti anni asseenxa cubbo duuchcha uudee kaddomalee huja gophoole; tinninna:<verse eid="EZK 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 18:15" />«Koobuwwate'n fakkuwwatee tolchemeechcho ita gophoole,</para>
  <para style="q2" vid="EZK 18:15">Isira'eeli ardixxa fakkuwwanna magenonfata gophoole,</para>
  <para style="q1" vid="EZK 18:15">Jaalo ifikixxa areninna yabaabula gophoole,<verse eid="EZK 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZK 18:16" />Ayeenna miica gophoole,</para>
  <para style="q2" vid="EZK 18:16">liqeesate abixxemalcho liqefatemakee illeema hiissa gophoole,</para>
  <para style="q1" vid="EZK 18:16">Hunnati mulqedha gophoole,</para>
  <para style="q2" vid="EZK 18:16">yaanne kinni itaachcho solo'weekee,</para>
  <para style="q2" vid="EZK 18:16">seemma ifixxanna daarekee uwwoole,<verse eid="EZK 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZK 18:17" />Hiyyeyyete'n elobaaxxa assa gophoole,</para>
  <para style="q2" vid="EZK 18:17">lephpho'a yookaan dhalakee liqeessa gophoole,</para>
  <para style="q1" vid="EZK 18:17">Seera anka heqedhoole, ajaja anka hordofoole,</para>
  <para style="m" vid="EZK 18:17">Isi hedhoti hedhaa malee annixxe cubboxxee reyabaan. <verse eid="EZK 18:17" /><verse number="18" style="v" sid="EZK 18:18" />Anni isik kinni manjo balleessemmaxxee, dayyo ifikee'n hunnati mulqedhemmaxxeenna ardi ifik giddo fuggoxxa assemmaxxee ifixxe cubboxxee reyaan.<verse eid="EZK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 18:19" />«Ha'no kinni, ‹Belti anna ifikixxe cubbo'a mayee xixema gophaa?› hitine qortina. Belti isik dhugaatixxanna seeriinxa yaane assemmaxxee, ajaja ankanna duuchchanna xonxomate heqedhemmaxxee dhugaten hedhoti hedhaan. <verse eid="EZK 18:19" /><verse number="20" style="v" sid="EZK 18:20" />Rertaaxxi cubbo hujjeexxe lubbon. Belti anna ifikixxe cubboxxee xixemabaan; annikinna belto ifikixxe cubboxxee xixemabaan; qullichchi ifixxee qullummatike hira alfaan; cubbichchikinna ifixxe cubboke hira alfaan.<note caller="-" style="x"><char style="xo" closed="false">18:20 </char><char style="xt" closed="false"><ref loc="LEV 24:16">Lew. 24:16</ref>. </char></note><verse eid="EZK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 18:21" />«Cubbichchi hujemmaxxe cubbo duuchchinaa'n illee iima higeexxi seera anka duuchcha heqedhoole, dhugatanna qajeelto yaane assoole dhugaaten isi, hedhoti hedhaa malee reyabaan. <verse eid="EZK 18:21" /><verse number="22" style="v" sid="EZK 18:22" />Assemmaxxi balleessa duuchcha isi'a gattowaal hiyyendaan; hujemmaxxe qullummaxxee hedhoti hedha. <verse eid="EZK 18:22" /><verse number="23" style="v" sid="EZK 18:23" />Dhugaandinni cubbichchiixxe reyo'n gammadannota? Cubbotenaa'n illema higeexxi hedhoti hedhooleteba gammadannok? Hiyya'neen Lumok Duuchchi Woddik Gootti.<verse eid="EZK 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 18:24" />«Qullichchi manji kinni qullumatenaa'n higeexxi cubbo hujoole, cubbichchi manji assemmaxxa diqachchiissaxxa yaanenna assoole, kunni manji hedhoti hedhaata? Assexxe qullummaxxe yaanuwwanaa'n mittettinna qaabatendabaan; addatemeeke kada gophemmaxxeenna hujemmaxxe cubboxxee reyaan.<verse eid="EZK 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 18:25" />«Hano kinni, ‹Duuchchi Woddike Goottik ori dhugaatikebaan› hitina. Koo Isira'eelike arda laqqe: ori ank dhugatikebaa? Dhugaatike kadebaak ha'noke orabaa? <verse eid="EZK 18:25" /><verse number="26" style="v" sid="EZK 18:26" />Qullichchi qullummatenaa'n illeema higeexxi cubbo hujoole cubbo ifixxee reyaan; balleesseexxe balleessaxxeenna reyaan. <verse eid="EZK 18:26" /><verse number="27" style="v" sid="EZK 18:27" />Cubbichchi manji kinni assemmaxxe fuggonaa'n illeema higeexxi dhugaatixxanna seerinxa yaane assoole lubbo ifixxa anjira. <verse eid="EZK 18:27" /><verse number="28" style="v" sid="EZK 18:28" />Balleessemmaxxe balleessa duuchchanaa'n hubateexxi illeema higemmaxxee dhugaaten, hedhoti hedhaan; reyabaan. <verse eid="EZK 18:28" /><verse number="29" style="v" sid="EZK 18:29" />Yaane kinni Isira'eelik ardi, ‹Duuchchi Woddik Goottik ori dhugatikeba'a› hiyya'neen; koo Isira'eelike arda! Ank or dhugaatikebaa? Dhugaatike kadabaaki ha'nokebaata?<verse eid="EZK 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 18:30" />«Tennexxe'e koo Isira'eelike arda ha'noxxe huje hujeshshanni mitte mitte ha'no'nge'n murannon; hiyya'neen Lumok Duuchchi Wodik Gootti. Yoona aade aagge; cubbo ha'noxxi ha'noo balleessitabaashsha cubbotenaa'n illeema higge hiyya'neen Lumok Duuchchi Woddik Gootti. <verse eid="EZK 18:30" /><verse number="31" style="v" sid="EZK 18:31" />Balleessitineexxa balleessa duuchcha ifinaa'n fuggusse; haaroka hedumanna haaroxxa qalbe horatte; koo Isira'eelike arda mayee rertattota? <verse eid="EZK 18:31" /><verse number="32" style="v" sid="EZK 18:32" />Ani ayyixxe reyo'ninna gammada gophannaxxe'e aadde aagineexxi hedhoti hedhdhe hiyyanneen Lumok Duuchchi Woddik Gootti.<verse eid="EZK 18:32" /></para>
  <chapter eid="EZK 18" />
  <chapter number="19" style="c" sid="EZK 19" />
  <para style="s1">Isra'elike Akeekisanjuwwi'a Fuleeka Boochchisa</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 19:1" />«Isira'eelixxe Hayyoolexxee boochchisa <verse eid="EZK 19:1" /><verse number="2" style="v" sid="EZK 19:2" />hite fulchitatto qici:</para>
  <para style="q1" vid="EZK 19:2">« ‹Ama atixxi neenquwwi giddo hitatta</para>
  <para style="q2" vid="EZK 19:2">hexxeexxe neenqamma'a!</para>
  <para style="q1" vid="EZK 19:2">Neenquwwinxe lummexxeexxe beltanaxxe odo'n wexxi hiteexxi</para>
  <para style="q2" vid="EZK 19:2">beltanna ifixxa nossexxe.<verse eid="EZK 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 19:3" />Ifixxe beltanna giddii'n mitte nossite,</para>
  <para style="q2" vid="EZK 19:3">isinna worba neenqa kade;</para>
  <para style="q1" vid="EZK 19:3">Adame ninnifa barate;</para>
  <para style="q2" vid="EZK 19:3">manjokanna ite.<verse eid="EZK 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 19:4" />Odo isixxinna gosa gosake arda'n laqende;</para>
  <para style="q2" vid="EZK 19:4">insinna insa'ne qontexxe balle giddo abideme;</para>
  <para style="q1" vid="EZK 19:4">Insa'nenna isoo haachchabik usurre,</para>
  <para style="q2" vid="EZK 19:4">Gibtsee boga'n iyyemarre.<verse eid="EZK 19:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="EZK 19:5" />« ‹Heddeexxi yaane wo'mitebaaxxa,</para>
  <para style="q2" vid="EZK 19:5">addatteexxinna baxxeeexxa isenna udde wodda,</para>
  <para style="q1" vid="EZK 19:5">Ifixxe beltannuwanaa'n wele aaxxeexxi,</para>
  <para style="q2" vid="EZK 19:5">worba neenqa aasite nossite.<verse eid="EZK 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 19:6" />Isinna neenquwwi giddo mammareme,</para>
  <para style="q2" vid="EZK 19:6">worbakenna kade;</para>
  <para style="q1" vid="EZK 19:6">Adame ninnifatanna barate;</para>
  <para style="q2" vid="EZK 19:6">manjokanna ite.<verse eid="EZK 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 19:7" />Kinjiinka insa'neka dalla'uwwanna diige;</para>
  <para style="q2" vid="EZK 19:7">qachchuwwa insa'nekaaranna findige;</para>
  <para style="q1" vid="EZK 19:7">Bogi ookkonna giddo hedhemmak manni duuchchi,</para>
  <para style="q2" vid="EZK 19:7">isixxe ittansonaa'n kexxeexxa culphise;<verse eid="EZK 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 19:8" />Qarqarake'n hedheek gosa gosak ardi iso'n ke'e;</para>
  <para style="q2" vid="EZK 19:8">boga boga duuchchinaa'n iso'n bukkiyye;</para>
  <para style="q1" vid="EZK 19:8">Fonxoro ifixxanna isi'a fanne;</para>
  <para style="q2" vid="EZK 19:8">isinna insa'ne qonteexxe bale giddo e'ye abideme.<verse eid="EZK 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 19:9" />Haachchabik usurreexxi,</para>
  <para style="q1" vid="EZK 19:9">Isoo Baabiloonike moyanjiba iyyedange;</para>
  <para style="q2" vid="EZK 19:9">haafuri iski langaxxa Isira'eelixxe koobuwwa hana,</para>
  <para style="q2" vid="EZK 19:9">laqemabaashsha, usurinke mini giddo isoo e'yinshe.<verse eid="EZK 19:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="EZK 19:10" />« ‹Ama atixxi wode'inii qarqara kaasemeeke, fichchake'n hedheeke,</para>
  <para style="q2" vid="EZK 19:10">wodde'inxe birasa'nenaa'n kexxeexxa,</para>
  <para style="q1" vid="EZK 19:10">Barqaaqe gummiseeke woyyinetike hiddichcho</para>
  <para style="q2" vid="EZK 19:10">fakkaatteemman.<verse eid="EZK 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 19:11" />Damuwwa iseexxi galchalixxe bokko'a,</para>
  <para style="q2" vid="EZK 19:11">kaddaaxxe jabaxxeramman;</para>
  <para style="q1" vid="EZK 19:11">Isenna bankararteexxe ifixxe damuwwa giddo,</para>
  <para style="q2" vid="EZK 19:11">ejjuma qeerreexxeexxi ifixxe damuwwake,</para>
  <para style="q2" vid="EZK 19:11">tagagginninni adda leellita'nemman.<verse eid="EZK 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 19:12" />Yaane kinni aareti goshende buttinake'n hunnende;</para>
  <para style="q2" vid="EZK 19:12">butti'anna hunde;</para>
  <para style="q1" vid="EZK 19:12">Boroti darreexxi qiilla gammoojjexxi diidallo isee bassite;</para>
  <para style="q2" vid="EZK 19:12">gumma iseexxanna harcaasse;</para>
  <para style="q1" vid="EZK 19:12">Jabaxxi isexxi damuwwanna bagge'naa,</para>
  <para style="q2" vid="EZK 19:12">giiratinna isee itte.<verse eid="EZK 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 19:13" />Ta'a shamini wode'i hedhebaake bagoke boga'n,</para>
  <para style="q2" vid="EZK 19:13">qiilla gammoojje giddo kaaseende.<verse eid="EZK 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 19:14" />Umoke kaddeexxe isexxe damenaa'ni giira fulde;</para>
  <para style="q2" vid="EZK 19:14">giiratinna gumma isexxanna itte;</para>
  <para style="q1" vid="EZK 19:14">Galchaliixxe bokko'a kaddaaxxi</para>
  <para style="q2" vid="EZK 19:14">mitte jabaxxi damenna ise'n gattebaan.›</para>
  <para style="m" vid="EZK 19:14">Kunni boochchisaken; wi'lishshatishshatenna kaddan.»<verse eid="EZK 19:14" /></para>
  <chapter eid="EZK 19" />
  <chapter number="20" style="c" sid="EZK 20" />
  <para style="s1">Jallitte Isira'eeli</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 20:1" />Booji'emennexxe torbaxxe woggake, ondike agenjiinxe tommixxe barra'n Isira'eelixxe geedhe giddii'n mitti mitti Duuchchi Woddike Gootta qodhdhatee dangeexxi ani edonna ofole. <verse eid="EZK 20:1" /><verse number="2" style="v" sid="EZK 20:2" />Duuchchi Woddike Goottik hiyyichchi ane'n dageexxi, <verse eid="EZK 20:2" /><verse number="3" style="v" sid="EZK 20:3" />«Koo manjiinke beltoo, Isira'eelike akeekisanjuwwa'n ‹Lumok Duuchchi Woddik Gootti hiyya'neen hitatto qici: Anee qodhdhitino'a dagginee? Dhugaa anee hedhaannekixxa, anee qodhdhitino'a eeti ha'no'aa uwwa'ebo'no hiyya'neen Lumok Duuchchi Woddik Gootti.›<verse eid="EZK 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 20:4" />«Koo manjiinke beltoo konne manna'n mura murtatto? Insa'ne'n murtabexxo? Insa'neke edik annuwwi assemmaxxa diqachchiissaaxxa huje insa'ne'n ege'nish. <verse eid="EZK 20:4" /><verse number="5" style="v" sid="EZK 20:5" />Insa'ne'ninna ‹Dada Duuchchik Duuchchi Woddik Gootti hiyya'een hitatto qici: Isira'eeli'i fi'lennexxa barra, Ya'iqoobixxe horte'n Gibtsee giddo ifi ege'nishshati anga iima ke'issennexxi insa'ne'aa, «Ani Duuchchi Woddike Gootta ha'noke Magenon» hiyye kakatenne. <verse eid="EZK 20:5" /><verse number="6" style="v" sid="EZK 20:6" />Eettene barra, ani isa'ne Gibtseeke boganaa'n fulchennexxi insa'ne'aa qophpheesseneke ado callikenna malebi callike boga duuchchanaa'ninna hara danchake kadeeke ookkone boga'n insa'nee aassonaa kakatene.<note caller="-" style="x"><char style="xo" closed="false">20:6 </char><char style="xt" closed="false"><ref loc="EXO 6:2-8">Fula. 6:2-8</ref>. </char></note> <verse eid="EZK 20:6" /><verse number="7" style="v" sid="EZK 20:7" />Aninna insa'nee, «Ha'no mitti mittiingi ille uggudhitine'eexxa battitte fakkuwwa fugusse; Gibtseexxe fakkuwwanninna ifi battoossitinoqqe'e; Ani Duuchchi Woddike Gootta ha'nooke Magenon» hiyyenne.<verse eid="EZK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 20:8" />« ‹Insa'ne kinni ane'n jallineen; haaso'a ankanna laqa ginbeen; ille itti uggudhineemmaxxa battitte fakkuwwa fugusinebaan; Gibtseexxa fakkuwwanna waalebaan. Tennexxe'e aninna ookkoonni Gibtseke boga'n aare anxa insa'ne'n dhangalaasanno mufe anxanna insa'ne'n wocci assonnaa mureenan. <verse eid="EZK 20:8" /><verse number="9" style="v" sid="EZK 20:9" />Yaane kinni giddo he'nammakenna Gibtsee'n Isira'eeli fulchona'a haaso'enna wodda, ifi leelisheneke gosa gosake ardi edo summi anki battoo'abaashsha anke summi'a hiyye inisa'ne Gibtse'n fulcheennen. <verse eid="EZK 20:9" /><verse number="10" style="v" sid="EZK 20:10" />Tennexxee inisa'nee Gibtsee'n fulcheennexxi qiilla gammoojjeba iyyedagenne. <verse eid="EZK 20:10" /><verse number="11" style="v" sid="EZK 20:11" />Isi'a ajajemeekaa manjo hedhoti hedhisaaxxa anxa aaduwwa insa'ne'aa uuwwene; seeruwwa ankanna insa'ne'aa ege'nishshennen.<note caller="-" style="x"><char style="xo" closed="false">20:11 </char><char style="xt" closed="false"><ref loc="LEV 18:5">Lew. 18:5</ref>. </char></note> <verse eid="EZK 20:11" /><verse number="12" style="v" sid="EZK 20:12" />Iittanni Ani Duuchchi Woddiki Gootti insa'ne woyyonseneexxa ege'naashsha anxenna insa'nexxe oddo'n beessisake kado'a anka Sanbata insa'ne'aa uwwenne.<note caller="-" style="x"><char style="xo" closed="false">20:12 </char><char style="xt" closed="false"><ref loc="EXO 31:13-17">Fula. 31:13-17</ref>.</char></note><verse eid="EZK 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 20:13" />« ‹Yaane kinni Isira'eelik ardi qiilla gammoojje'n ane'n jalle; manji ise'a ajajemati hedhoti hedhaaxxa anxa aada insa'ne heqe'nebaa; seera anke'ninna me'inebaa; Sanbata ankanna hara battoossine; tennexxee aninna aare anxe'n insa'nee gananno, qiilla gammoojje'ninna insa'nee bironno hiyyenne. <verse eid="EZK 20:13" /><verse number="14" style="v" sid="EZK 20:14" />Yaane kinni insa'ne giddii'n Isira'eeli'i fulcha'naa uudemmake gosa gosake ardi edo ank summi batto'abaashsha summa ankixxee tennee assenne. <verse eid="EZK 20:14" /><verse number="15" style="v" sid="EZK 20:15" />Iittanni boga duuchchanaa'ninna hara danchake kadeeke ookkone ado callikenna malebi callike boga insa'ne'a uwwanno hiyyenneke'n insa'ne aassabo'noxxa qiilla gammoojje giddo anga iimi'a ke'issennexxi kakatennen. <verse eid="EZK 20:15" /><verse number="16" style="v" sid="EZK 20:16" />Tenneenna assennechchi insa'ne seera anke'n me'a gonpheemmaxxee, ajajuwwa ankanna heqedha gonpheemmaxxeenna Sanbata ankanna battoosinemmaxxeeten; insa'ne godobik fakkuwwa ifixxebaa he'neen. <verse eid="EZK 20:16" /><verse number="17" style="v" sid="EZK 20:17" />Ani kinni insa'ne'a maraarenne malee insa'nee balleessebo'no qiilla gammoojje giddonna insa'nee birebo'non. <verse eid="EZK 20:17" /><verse number="18" style="v" sid="EZK 20:18" />Ani qiilla gammoojje giddo oose insa'nexxe'n, «Annuwwi ha'nookixxa aaduwwa hordofinoqqe; seera insa'nekanna heqqexxinoqqe; insa'nexxe fakkuwwanninna ifi battoossitinoqqe'e. <verse eid="EZK 20:18" /><verse number="19" style="v" sid="EZK 20:19" />Ani Duuchchi Woddike Gootta ha'nooke Magenon; aada anxa hordoffe; seera ankanna xexxe'achchoti heqqedhe. <verse eid="EZK 20:19" /><verse number="20" style="v" sid="EZK 20:20" />Anixxenna ha'nooxxe oddo'n beessisake kadaashsha Sanbata anka woyyitte barra asse; ani Duuchchi Woddike Gootta ha'nooke Mageno kadeennexxanna egendinaan» hiyyenne.<verse eid="EZK 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 20:21" />« ‹Yaane kinni oose insa'nexxi ane'ni jallite; ise'a ajajemeek manji hedhot hedhaaxxa anxa aada insa'nee heqqe'nebaa; seera anke'n me'ate'n jabaantebaan; Sanbata ankanna battoossine; tennexxee aninna qiilla gammoojje'n aare anxenni insa'nee gananno, mufe anxanna insa'ne'n bidhdhanno hiyyenne. <verse eid="EZK 20:21" /><verse number="22" style="v" sid="EZK 20:22" />Yaane kinni Isir'a'eeli Gibtse'n fulchennexxa uudemmake gosa gosake ardi edo summi ank battoo'abaashsha tenne assebe'non. <verse eid="EZK 20:22" /><verse number="23" style="v" sid="EZK 20:23" />Iittanni gargar hedheeke boguwwa'n gosa gosake ardi giddo insa'nee xeere xeelagonnaa qiilla gammoojje giddo anga iimi'a ke'isse kakatenne.<note caller="-" style="x"><char style="xo" closed="false">20:23 </char><char style="xt" closed="false"><ref loc="LEV 26:33">Lew. 26:33</ref>.</char></note> <verse eid="EZK 20:23" /><verse number="24" style="v" sid="EZK 20:24" />Tenne assennechchi insa'ne aada anxa xireeffante Sanbata anka battoonsine male'e seera anka heqqedha gonpheemmaxxeten; ille insa'neke annuwwixxe fukkuwwa'n uggineen. <verse eid="EZK 20:24" /><verse number="25" style="v" sid="EZK 20:25" />Aninna eloloxxe kaddebaaxxe aadda'ninna hedhoti insa'nee hedhissabaake seera'n insa'nee sa'isse uuwwenne. <verse eid="EZK 20:25" /><verse number="26" style="v" sid="EZK 20:26" />Ani Duuchchi Woddike Gootta kadennexxa egenaashsha insa'nee alalishshonnaa angafa ifika belto duuchcha ciincessati battoonaashsha assennen.›<verse eid="EZK 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 20:27" />«Tennexxee koo manjiinke beltoo Isira'eelike arda'n hitatto qici, ‹Lumok Duuchchi Woddik Gootti hiyya'nee qici: Annuwwi ha'nok anee waaliyyoti tennenni anee salphinse: <verse eid="EZK 20:27" /><verse number="28" style="v" sid="EZK 20:28" />Insa'ne'a uwwonaa kakatenneke boga'n insa'ne iyyedagenne wodda, lumollamma goorowwa duuchchanna shafi barqaaqeeka haqichchuwwa duuchcha uundeexxi ookko tolchuwwa ifika tolchine, tolchuwwa tolchiyyotinna anee mufachchiinse; eloke foolika ifika hixaanuwwanna gunbe; ifika ha'watika tolchanna dhibaanse. <verse eid="EZK 20:28" /><verse number="29" style="v" sid="EZK 20:29" />Ookkoneechchi uduma aninna insa'ne'ee: ha'no isebaa martina'neexxi tinni lumollamma gooruwwa ise maachcho?› » telchi qico'n ookkone boonchik summi Baama<note caller="+" style="f"><char style="fr" closed="false">20:29 </char><char style="fqa" closed="false">Baama </char><char style="ft" closed="false">Hiyyo Ibirawotinke laagadinni </char><char style="fqa" closed="false">Goorote </char></note> hiyyemee ye'emaan.<verse eid="EZK 20:29" /></para>
  <para style="s1">Xixxichchokanna Illee Iima Higa</para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 20:30" />«Tennexxee Isira'eelike arda'n Duuchchi Woddik Gootti hiyya'neen hitatto qici: ‹Ha'nok annuwwi ifi battoossemmake orike orinni mayee ifi battoossitina? Insa'nexxe battitte misilluwwa hordofate'e halchitinaa? <verse eid="EZK 20:30" /><verse number="31" style="v" sid="EZK 20:31" />Uwwa ha'nooxxa shiqishshinaa wodda oose ha'noxxanna cincesati ha'noxxe fakkuwwa duuchchanni telchii qico'n batto'ate'n hexxineen. Koo Isira'eelike ardaa anee qodhdhitino'a eeti ha'no'aa uuwanota? Dhugaa anee hedhaanekixxa anee qodhdhitino'a eeti ha'no'aa uwwabo'non, hiyya'neen Lumok Duuchchi Woddik Gootti.<verse eid="EZK 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 20:32" />« ‹Ha'noonna, «Haqichchokanna kinjo magenoonfatamake gosa gosake ardishsha, buttate'n hedheeke ardi duuchchishshanna kandanno» hitineen; yaane kinni godobi giddo heddineexxi hara ha'no'aa kaddabaan. <verse eid="EZK 20:32" /><verse number="33" style="v" sid="EZK 20:33" />Dhugaa anee hedhaannekixxa, hiyya'neen Lumok Duuchchi Woddik Gootti jabaaxxe anxe anga'ninna qeererxxeexxe anxe hirrenni aare anxenni ha'noo ganee ha'no'n moyannon. <verse eid="EZK 20:33" /><verse number="34" style="v" sid="EZK 20:34" />Gosa gosake ardi giddii'n ha'noo fulchannon; jabaaxxe anxe anganninna qeerraaxe anxe hirrenni aare anxenni gane xexxeerendinemmake bugguwwi duuchchinaa'n ha'noo bukki assannon. <verse eid="EZK 20:34" /><verse number="35" style="v" sid="EZK 20:35" />Gosa gosake ardixxe qiilla gammoojje giddo ha'noo iyyedaganon; ookkonna uudinaa'naanni ha'no'n murannon. <verse eid="EZK 20:35" /><verse number="36" style="v" sid="EZK 20:36" />Gibtseeke bogixxe qiilla gammoojje'n edike ha'noke annuwwa'n murennashshanni ha'no'ninna murannon tenne haaso'eek Duuchchi Woddike Goottan. <verse eid="EZK 20:36" /><verse number="37" style="v" sid="EZK 20:37" />Ani ha'noo anxe mootumma hunda galdinaashsha assannon; anxe kakkoxxe giddisaba'anna ha'noo iyyedagannon. <verse eid="EZK 20:37" /><verse number="38" style="v" sid="EZK 20:38" />Ane'ni jalleexxi anee balleessakaara ha'no giddi'n fugusannon; ta'a hexxineeke boganaa'n insa'nee fulchannon; insa'ne Isira'eelike boga'n kinni e'yinabaan; eettene yanna ani Duuchchi Woddike Gootta kadeennexxa egendinaan.<verse eid="EZK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="EZK 20:39" />« ‹Koo Isira'eelik ardaa Duuchchi Woddiki Gootti ha'noxxee hiyya'nee qici: Ani hiyyannexxa laqa gophina'noole, ha'no mitti mittingi martineexxi ha'nooxxa fakkuwwa magenoonfatte! Yaane kinni ha'nooxxe uwwanninna ha'noxxe fakkuwwanni woyyichcha anka summa ta'anni edi'a battoossitinoqqe'e. <verse eid="EZK 20:39" /><verse number="40" style="v" sid="EZK 20:40" />Woyyitte anxe kooba'n, qeerraxxe Iisira'elixxe kooba hana, ookkone boga'n Isira'eeliki ardi duuchchi anee magenoffata; aninna ookko insa'nee qophedhannon; uutinaachcho, ha'nooxxa umiixxa uwwa ha'nooke woyyichchi tolchinni welti ookko ha'nonaa'n heqedhannon. Hiyya'neen Duuchchi Woddik Gootti. <verse eid="EZK 20:40" /><verse number="41" style="v" sid="EZK 20:41" />Gosa gosake ardi giddii'n ha'noo fulchanno wodda xexxeerendinemmake boguwwinaa'ninna ha'noo bukki assannoxxa yanna fishshake hixaanishsha ha'noo qophedhannon; ha'no giddo woyyichchake kadeennexxa gosa gosake ardi edo leellishshannon. <verse eid="EZK 20:41" /><verse number="42" style="v" sid="EZK 20:42" />Ha'nooke edike annuwwi'a uwwona'a anga iimi'a ke'isse kakatenneke Isira'eelike boga'n ha'noo iyyedaganno wodda ani Duuchchi Woddike Gootta kadennexxa egendinaan. <verse eid="EZK 20:42" /><verse number="43" style="v" sid="EZK 20:43" />Ookkonna assitinemmaxxa yaanuwwanna ifi battoosinemmaxxa ha'nooxxa huje qaabatinaan; assitinemmaxxe fuggo duuchchi'anna ifi diqatinaan. <verse eid="EZK 20:43" /><verse number="44" style="v" sid="EZK 20:44" />Koo Isira'eelike ardaa ha'noxxe fuggoxxe me'ashanna ha'nooxxe elobaaxxe hujeshshate kadebaak anke summi'a hiyye ha'noo uudanno wodda ani Duuchchi Woddike Gootta kadeennexxa egendinaan hiyya'neen Lumoki Duuchchi Woddiki Gootti.› »<verse eid="EZK 20:44" /></para>
  <para style="s1">Bita'ike Boga'n Kulendeexxa Wabeekumma</para>
  <para style="p">
    <verse number="45" style="v" sid="EZK 20:45" />Duuchchi Woddike Goottiki hiyychchi higgeenni ane'n dageexxi: <verse eid="EZK 20:45" /><verse number="46" style="v" sid="EZK 20:46" />«Koo manjiinke belto bita'i darre'n alba wirri hiyyi; bita'ake'ninna lallabi; bita'ike bogike gongoma'n raaga raagi. <verse eid="EZK 20:46" /><verse number="47" style="v" sid="EZK 20:47" />Bita'ike gongoma'n: ‹Duuchchi Woddike Goottika hiyyichcho laqi hiyyi. Lumok Duuchchi Woddiki Gootti hiyya'nee qici: Ate'n giira haa'ishonnaaten; giiratinna atika shamoka haqichchuwwanna atika bagoka haqichchuwwa duuchcha ittaan; eettene giirak tallisak bubenjinna xo'abaan; giiratinna bita'ii'n middi qico'n hedheeka manjo duuchcha ittaan. <verse eid="EZK 20:47" /><verse number="48" style="v" sid="EZK 20:48" />Manji duuchchi ani Duuchchi Woddike Gootti haa'ishenneshsha uudaan; isenna xoxxabaan.› »<verse eid="EZK 20:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="EZK 20:49" />Aninna, «Lumooke Duuchchi Woddike Gootta ba'ennenii! Insa'ne anee ‹Isi mamaassa calla mammaaka'n hedhaan› hinaan» hiyyenne.<verse eid="EZK 20:49" /></para>
  <chapter eid="EZK 20" />
  <chapter number="21" style="c" sid="EZK 21" />
  <para style="s1">Mageniinka Wolaantichcha</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 21:1" />Duuchchi Woddike Goottiki hiyyichchi higgeen ane'n dage hiyyee qici, <verse eid="EZK 21:1" /><verse number="2" style="v" sid="EZK 21:2" />«Koo manjiinke beltoo, Iyyerusaalemi darre'n alba wirri hiyyi magenoonfachchotixxe bakkuwwa'n lallabi. Isira'eelike boga'n raaga raagi; <verse eid="EZK 21:2" /><verse number="3" style="v" sid="EZK 21:3" />hitatto qici: ‹Duuchchi Woddiki Gootti hiyya'nee qici: ani ate'n ke'ennen; wolaantichcha ankanna gonofakenaa'n luqqilsaannen; qulichchakanna, fuggokanna ati giddii'n fugusanoon. <verse eid="EZK 21:3" /><verse number="4" style="v" sid="EZK 21:4" />Qulichcha fuggichcha fugusannaxxe'e bita'i'ni middi qico'n hedhdheke arda duuchcha'n wolaantichchi anki gonofakenaa'n goshemeeshanni hedhaan. <verse eid="EZK 21:4" /><verse number="5" style="v" sid="EZK 21:5" />Anka wolaantichcha gonofakenaa'n luqqisennek ante Duuchchi Woddike Gootta kadennexxa ardi duuchchi ege'naan; wolaantichchikinna gonofi giddi'a illee iima higabaan› hiyye.<verse eid="EZK 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 21:6" />«Tennexxee koo manjiinke belto aadi; enqendeexxe qalbenninna qaraartaaxxe yaaddonni insa'ne edo aadi. <verse eid="EZK 21:6" /><verse number="7" style="v" sid="EZK 21:7" />Insa'nenna atee, ‹Mayee fooxxitaatte?› hine qorroole, ‹Dagga'neexxe elobaaxxe odoxxeeten; godobi duuchchi culphisa; anga duuchchi shaqqita; hedho duuchcha wode'eke kadde mikiti duuchchi gilligilan› insa'ne'a hiyyi. Tinni dagga'neen; muxxendaan; hiyya'neen Lumok Duuchchi Woddik Gootti.»<verse eid="EZK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 21:8" />Duuchchi Woddike Goottiki hiyyichchi higgeen ane'n dageexxi: <verse eid="EZK 21:8" /><verse number="9" style="v" sid="EZK 21:9" />«Koo manjiinke belto raaga raagi, ‹Duuchchi Woddik Gootti hiyya'neen hitatto qici:</para>
  <para style="q1" vid="EZK 21:9">« ‹Wolaantichchi! Wolaantichchi,</para>
  <para style="q2" vid="EZK 21:9">qaremeek morodemeek.<verse eid="EZK 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 21:10" />Qaremeek shiwo'a,</para>
  <para style="q2" vid="EZK 21:10">morodemeekinna banqotishsha calacala hiyyo'aten!</para>
  <para style="p" vid="EZK 21:10">« ‹Yoona no'o gammandannoxxeeta?</para>
  <para style="q2" vid="EZK 21:10">Walaantichchi beltiixxa mootummatixxa siqqichcho wele siqqichchoshsha tuffate'een.<verse eid="EZK 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 21:11" />«‹Wolaantichchi anga abixxemo'a,</para>
  <para style="q2" vid="EZK 21:11">morodemaashsha uwwe'een;</para>
  <para style="q1" vid="EZK 21:11">Shiyalli anga abixxo'a</para>
  <para style="q2" vid="EZK 21:11">qaremedheen; morodeemeen.<verse eid="EZK 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 21:12" />Koo manjiinke belto tinni arda anke'n,</para>
  <para style="q2" vid="EZK 21:12">Isira'eelixxe hayyoole duuchcha'ninna daggeemmaxxee,</para>
  <para style="q2" vid="EZK 21:12">ooxxa'n, woo woo hiyyi.</para>
  <para style="q1" vid="EZK 21:12">Ardi ankinni welti,</para>
  <para style="q2" vid="EZK 21:12">wolaantichchik insa'ne rennaan.</para>
  <para style="q1" vid="EZK 21:12">Tennexxee ifi hoqqedhi.<verse eid="EZK 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 21:13" />« ‹Dhuganden hega uushsho daggaan; wolaantichcha tuffatteexxi itti mootummatixxi siqqichcho hegere gophphoolena'a? Hiyya'neen Duuchchi Woddiki Gootti›<verse eid="EZK 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 21:14" />«Tennexxee koo manjiinke belto raaga raagi.</para>
  <para style="q2" vid="EZK 21:14">Angatinna cali;</para>
  <para style="q1" vid="EZK 21:14">Wolaantichchikinna lamele,</para>
  <para style="q2" vid="EZK 21:14">sakkaxxa yannanna daguun;</para>
  <para style="q1" vid="EZK 21:14">Yo'oshsha biraake,</para>
  <para style="q2" vid="EZK 21:14">shiyateenna,</para>
  <para style="q2" vid="EZK 21:14">ora elqe kayyii'ni insa'ne buqaake wolaantichchon.<verse eid="EZK 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 21:15" />Godobi insa'nek culphisaashsha,</para>
  <para style="q2" vid="EZK 21:15">ribbi hiyyakiriinna bira sa'aashsha,</para>
  <para style="q1" vid="EZK 21:15">Insa'nexxe hulluwwa duuchcha'n</para>
  <para style="q2" vid="EZK 21:15">shiyaaka wolaantichcha uggenneen.</para>
  <para style="q1" vid="EZK 21:15">Aanne'e! Wolaantichi Calacala hiyyo'a morodeme'een;</para>
  <para style="q2" vid="EZK 21:15">shiyo'anna gonofake'n uggeennen.<verse eid="EZK 21:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZK 21:16" />Koo wolaantichcha qari atik wirri hiyye darre duuchcha'n,</para>
  <para style="q2" vid="EZK 21:16">middi'anna,</para>
  <para style="q2" vid="EZK 21:16">bita'i'a woxi.<verse eid="EZK 21:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZK 21:17" />Aninna mufet anga calannon;</para>
  <para style="q2" vid="EZK 21:17">aare anxinna qiiddaan;</para>
  <para style="q1" vid="EZK 21:17">Ani Duuchchi Woddiki Gootti tenne haaso'eennen.»<verse eid="EZK 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 21:18" />Duuchchi Woddike Goottiki hiyychchi higgeen ane'n dage hiyyee qici: <verse eid="EZK 21:18" /><verse number="19" style="v" sid="EZK 21:19" />«Koo manjiinke belto Baabiloonike moyanji wolaantichchi ifikenni dagaaka lame orika karta giissi; laminge orik ke'it mitte boginaa'nten; oruwwi gargari higgaabanna beessisa oti. <verse eid="EZK 21:19" /><verse number="20" style="v" sid="EZK 21:20" />Amoonitotike qachcha Rabaatiba dagaake wolaatichchi'a takake ora'n beessisa uggi; Yihudaba'anna Iyyerusaalemi'i kinjiinke dalla'ike qachchibaa dagaake wolaantichchi'a langake ora'n beessisa ugi. <verse eid="EZK 21:20" /><verse number="21" style="v" sid="EZK 21:21" />Baabiloonik moyanji orii isi'a qajeelo'a kaayyo uuxxedhiyyotee weldenate'n lami ori afemaaba uurraan; gabuwwa wirrissa'n hixxa ibirsaan; fakkuwwa ifixxenaa'ninna gorsa qodhdha'n; mooro'o faro uuxxedhdhaan. <verse eid="EZK 21:21" /><verse number="22" style="v" sid="EZK 21:22" />Dalla'a diigaatika lumoke haqichchika gubbo iyyedage uuriso'a, shiyatee ajaja uuwwo'a, geeraraashsha asso'a, dalla'a diigaatika lumoke haqichchika gubbo hulate'n uggo'a, buttina tullube giiso'anna kollo ijaaro'a Iyyerusaalemi'n ibaaka hixxa ifixxe middixxe anga'ni fulchaan. <verse eid="EZK 21:22" /><verse number="23" style="v" sid="EZK 21:23" />Tinni mitti mittingi manji isi'a addatema gopheeke kadabaashsha kakatemakeeri'a dhariinxe moro labbaan; isi kinn insa'ne balleessa ifixxa qalli hinaashsha assaan; booji'enna insa'ne adhdhe me'a.<verse eid="EZK 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 21:24" />«Tennexxee Lumok Duuchchi Woddiki Gootti hiyya'nee qici: ‹Ha'no assitinaaxxe duuchchanni cubbo ha'nooxxa leellishinemmaxxee, leelli shiyyotinna xaqaro ha'nooxxi qalli hiyyendaashsha assitinemmaxxee, tenne assitinemmaxxee booji'endinaan.<verse eid="EZK 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 21:25" />« ‹Ati fuggallesinna battichchi, muuxamiinxi atixxi mura woxatixxi barra gelte'eke koo Isira'eelike ja'laaba <verse eid="EZK 21:25" /><verse number="26" style="v" sid="EZK 21:26" />Lumok Duuchchi Woddiki Goottinna umokenaa'ni ruufa hoyyedhdhi kallaachcha atikanna huni: konnechchi edo kaddamaashshtebaan heeshshi hiyyemak ulfataan ulfatemmakinna heeshshi hiyyaan. <verse eid="EZK 21:26" /><verse number="27" style="v" sid="EZK 21:27" />Murtetixxa deette afeek dagee'naa anga isixxe'n sa'isse uwwanno qico'n edo haranga kade ege'nebaaka urma Iyyerusaalemik qachchi urmaashsha assanno.›<verse eid="EZK 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 21:28" />«Koo manjiinke belto raaga raagi, ‹Amoonitotixxeenna insa'neke yowwichchixxee Duuchchi Woddik Gootti hiyya'neen hitatto qici:</para>
  <para style="q1" vid="EZK 21:28">« ‹Wolaantichchi! Wolaantichchi!</para>
  <para style="q2" vid="EZK 21:28">Shiyo'a goshemeek,</para>
  <para style="q1" vid="EZK 21:28">Biro'anna fiyemeek,</para>
  <para style="q2" vid="EZK 21:28">banqotishsha calacala hiyyo'a morodemeeken!<note caller="-" style="x"><char style="xo" closed="false">21:28 </char><char style="xt" closed="false"><ref loc="JER 49:1-6">Erm. 49:1-6</ref>; <ref loc="EZK 25:1-7">Hiz. 25:1-7</ref>; <ref loc="AMO 1:3-15">Amo. 1:3-15</ref>; <ref loc="ZEP 2:8-11">Sof. 2:8-11</ref>.</char></note><verse eid="EZK 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="EZK 21:29" />Koo wolaanticha ati'a uudendeexxi dhariinxi leella,</para>
  <para style="q2" vid="EZK 21:29">ati'a morendeexxi dhariinxi moro,</para>
  <para style="q1" vid="EZK 21:29">Barra insa'nexxi gelteeke,</para>
  <para style="q2" vid="EZK 21:29">xixemmo'a yannanna dagge shiqqe'eexxe</para>
  <para style="q1" vid="EZK 21:29">Gorra'emiyyo hassissaneexxe fugalleeyyeke,</para>
  <para style="q2" vid="EZK 21:29">gooba'n wolaantichchi uggemaan.<verse eid="EZK 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="EZK 21:30" />Wolaantichcha gonofi giddi'a hiissi;</para>
  <para style="q1" vid="EZK 21:30">Koo wolaantichcha,</para>
  <para style="q2" vid="EZK 21:30">Dadendeteke boncho'n,</para>
  <para style="q1" vid="EZK 21:30">Ilendeteke boga'n,</para>
  <para style="q2" vid="EZK 21:30">ookko ate'n murannon.<verse eid="EZK 21:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="EZK 21:31" />Aare anxenni atee ganannon;</para>
  <para style="q2" vid="EZK 21:31">anxe mufexxa giiranna ate'n ha'ishannon;</para>
  <para style="q1" vid="EZK 21:31">Birat muxxe fuleeke</para>
  <para style="q2" vid="EZK 21:31">mararabaake mannixxe anga'n ate'e saisse uwwannon.<verse eid="EZK 21:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="EZK 21:32" />Giiratee haqqete kaddatto;</para>
  <para style="q2" vid="EZK 21:32">munde atixxi boga atingi giddo dhangalata;</para>
  <para style="q1" vid="EZK 21:32">Ookkoneechchi udumi'a ayyinna atee qaabatabaan;</para>
  <para style="q2" vid="EZK 21:32">tenne haaso'eneki ante Duuchchi Woddike Goottan.› »<verse eid="EZK 21:32" /></para>
  <chapter eid="EZK 21" />
  <chapter number="22" style="c" sid="EZK 22" />
  <para style="s1">Iyyerusaalemike Ardixxa Cubbuwwa</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 22:1" />Duuchchi Woddike Goottik hiyyichchi higgeen ane'n dageexxi, <verse eid="EZK 22:1" /><verse number="2" style="v" sid="EZK 22:2" />«Koo manjiinke belto murtabexxoo? Manjo anga sa'eek mannike konne qachcha'n murtabexoo? Diqachchisa'neexxa huje isixxa iso'n farrasite kuli; <verse eid="EZK 22:2" /><verse number="3" style="v" sid="EZK 22:3" />iso'ninna hitatto qici: ‹Lumok Duuchchi Woddik Goottinna oddo atixxe'n manjiinxa munde dhangalaasatokinna fakkuwwa giissita'n ifi battoossati murte ifi'ni iyyedaqitaateek qachchaa, <verse eid="EZK 22:3" /><verse number="4" style="v" sid="EZK 22:4" />dhangalaassetaxxe mundexxee ati balleessanjo kaddeeten; hujjetexxe fakkuwwanni battooteeten; barra atixxa shiqilshitee'eten; baro atikanna haruunsexeeten. Tennexxee ani atee gosa gosake arda'n gacifachchotike, boginke arda duuchcha'n tuffatendeeteke assannon. <verse eid="EZK 22:4" /><verse number="5" style="v" sid="EZK 22:5" />Koo summa baxxe'etekenna weekensha wo'mite'eekee qachchaa, shiqikinna bayyik ate'n gacifataan.<verse eid="EZK 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 22:6" />« ‹Ati giddo hedheek mitti mittingi Isira'eelik akeekisanjuwwi baalloma ifika manjiinxa munde dhangalaasatee la'onfanta'neen. <verse eid="EZK 22:6" /><verse number="7" style="v" sid="EZK 22:7" />Ati giddo annuwwikinna amuwwa salphatte; ati giddo hedheek alagi sobeme'een, ati giddo anna affebaaxxi oosenna aro'o shi'witeexxi melaalle miicende.<note caller="-" style="x"><char style="xo" closed="false">22:7 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Fula. 20:12</ref>; <ref loc="EXO 22:21-22">22:21-22</ref>; <ref loc="LEV 5:16">Lew. 5:16</ref>; <ref loc="LEV 24:17">24:17</ref>. </char></note> <verse eid="EZK 22:7" /><verse number="8" style="v" sid="EZK 22:8" />Anka woyyichcha miyuwwa tuffatette; Sanbatuwwa ankanna battoossiteeten.<note caller="-" style="x"><char style="xo" closed="false">22:8 </char><char style="xt" closed="false"><ref loc="LEV 19:30">Lew. 19:30</ref>; <ref loc="LEV 26:2">26:2</ref>. </char></note> <verse eid="EZK 22:8" /><verse number="9" style="v" sid="EZK 22:9" />Manjiinxa munde dangalaasatee dhara odeesakiir ati giddo hedhemma'a; koobat hana fakkuwwatee tolchemeeka itaakiirinna fuggoke adabikiriinna atinni giddo hedhe. <verse eid="EZK 22:9" /><verse number="10" style="v" sid="EZK 22:10" />Annuwwa ifikixxe areni welti diiphaakiir ati giddo hedheen; aadatike seerishsha qulootebaxxe yanna'n dubartetixxe aadanni hexxe'naa hunnat melaalleti welti diiphaakiir ati giddo hedheen. <verse eid="EZK 22:10" /><verse number="11" style="v" sid="EZK 22:11" />Ati giddo mitti jaalo ifikixxe arenni yabaabula; weli belto ifikixxe are battoossa; weli ifike annixxe beltonni dayyo ifixxenni diipha.<note caller="-" style="x"><char style="xo" closed="false">22:11 </char><char style="xt" closed="false"><ref loc="LEV 18:7-20">Lew. 18:7-20</ref>. </char></note> <verse eid="EZK 22:11" /><verse number="12" style="v" sid="EZK 22:12" />Ati giddo manjiinxa munde dhangalaaso'a manni matta adhdha; atinna dhalakeenna lephphatee liqeesat jaalo atika miice seeribeloxxa la'o gudhitette; aneenna deetette hiyya'neen Duuchchi Woddiki Gootti.<note caller="-" style="x"><char style="xo" closed="false">22:12 </char><char style="xt" closed="false"><ref loc="EXO 22:25">Fula. 22:25</ref>; <ref loc="EXO 23:8">23:8</ref>; <ref loc="LEV 25:36-37">Lew. 25:36-37</ref>; <ref loc="LEV 16:19">Lew. 16:19</ref>; <ref loc="LEV 23:19">23:19</ref>.</char></note><verse eid="EZK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 22:13" />« ‹Seeriblo alfitetexxe la'oxxeenna atixxe oddo'n dundettexxe manjinxe mundexxee anga mufeti ate'n calannon. <verse eid="EZK 22:13" /><verse number="14" style="v" sid="EZK 22:14" />Ate'n muronnaa ke'annoxxa bara godoba dandeette jabaatatto? Yookaan hirre atixxa jabeessexxato? Ani Duuchchi Woddik Gootti tennee'e haaso'ennen: haaso'ennexxanna muuxannon. <verse eid="EZK 22:14" /><verse number="15" style="v" sid="EZK 22:15" />Gosa gosake ardi giddo atee xeerannon; boga boga duuchcha'ninna atee xeelagannon; battumma atixxanna atenaa'n qurubbi assanno. <verse eid="EZK 22:15" /><verse number="16" style="v" sid="EZK 22:16" />Gosa gosake ardi edo battoondatto wodda ani Duuchchi Woddike Gootta kadennexxa egendatton› » hiyye.<verse eid="EZK 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 22:17" />Ookkoneechchi uduma Duuchchi Woddike Goottik hiyyichchi ane'n dageexxi, <verse eid="EZK 22:17" /><verse number="18" style="v" sid="EZK 22:18" />«Koo manjinke belto, Isira'eelik ardi ani'a wayifulabaake kade'een; insa'ne duuchchiingi ani'a sibliji baqeechchi uduma finiini gatammake sageettotike sibljike, qorqoorotike, addichcha siblikikenna maalde'inke finiina kande'een. <verse eid="EZK 22:18" /><verse number="19" style="v" sid="EZK 22:19" />Tennexxee Lumok Duuchchi Woddiki Gootti hiyya'nee qici, ‹Ha'no duuchchiing siblinke finiina kaddineemmaxxee Iyyerusaalemi ha'noo bukki assannon. <verse eid="EZK 22:19" /><verse number="20" style="v" sid="EZK 22:20" />Manji birretika siblo, sageetotika siblo, addichcha siblonna maalde'a ittanni qorqooro basso'a boosumma giddo bukki assammashsha aninna iitanni mufe anixinninna aare anixxinni ha'no qachchi giddo bukki assannon; ookkonna ha'no bassannon. <verse eid="EZK 22:20" /><verse number="21" style="v" sid="EZK 22:21" />Aninna Ha'noo bukki assennexxi aare anxixxa giira ha'noo'ni busse ha'ishanno; ha'nonna ookko giddo baqqinaan. <verse eid="EZK 22:21" /><verse number="22" style="v" sid="EZK 22:22" />Birretik siblji boosumma giddo baqammashsha iittanni ha'nonna qachchi giddo baqqinaan, ani Duuchchi Woddik Gootti aare anxa ha'noo ganennexxa egendinaan.› »<verse eid="EZK 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 22:23" />Higgeenna Duuchchi Woddike Goottik hiyyichchi ane'n dageexxi, <verse eid="EZK 22:23" /><verse number="24" style="v" sid="EZK 22:24" />«Koo manjiinke belto, ookkone boga hitatto qici, ‹Ati luqqi hitebexxoken aaretixxa barranna xeeni ate'n ganebaake bogan› hiyyi. <verse eid="EZK 22:24" /><verse number="25" style="v" sid="EZK 22:25" />Isixxi Hayyoole adamemmalcho ita'n ininifammake neeqishsha mitte afo'o kadde kakatte; insa'nee ardake shinne'een, karranna wele fiixxeexxa yaanuwwa mulqe'ne'een; haddo melaallenna aro'i belo gatinse'een.<note caller="+" style="f"><char style="fr" closed="false">22:25 </char><char style="ft" closed="false">Isixxi Hayyoole Ibirawotink laagadinni wabeekote hiyyende'en. </char></note> <verse eid="EZK 22:25" /><verse number="26" style="v" sid="EZK 22:26" />Qeese isixxinna seera anke'n jallitee; woyyichcha anka miyuwwanna battoosite; woyyitte yaanuwwa battootexxenaa'n gargar hiissiteba'a; xuritte yaanuwwa ca'itetenaa'n gargarumma affebaashsha barsiisse; sanbatuwwa ankenaa'n ille hoyye'ne; aninna oddo insa'nexe'n tuffatemenne<note caller="-" style="x"><char style="xo" closed="false">22:26 </char><char style="xt" closed="false"><ref loc="LEV 10:10">Lew. 10:10</ref>. </char></note> <verse eid="EZK 22:26" /><verse number="27" style="v" sid="EZK 22:27" />Isi giddo hedheek ja'laabuwwi adandeexxa ninifammaxxe yayyuwwashshaten; seeribeloxxa la'o alfatee munde dhangalaaseexxi manjo anga sa'ne. <verse eid="EZK 22:27" /><verse number="28" style="v" sid="EZK 22:28" />Isi giddo hexxeexxi wabeekole tenne cubbo duuchcha sobiinxe waleellanninna dharite moronni buqqa; Duuchchi Woddik Goottinna haaso'ebaangi, ‹Lumok Duuchchi Woddik Gootti hiyya'nee qici› hita'n haasotta. <verse eid="EZK 22:28" /><verse number="29" style="v" sid="EZK 22:29" />Ookkone bogik ardi mucuqe, mulqedhe, seera xe'ishiyyot hiyyeessakanna rakkichcha miice; alagakanna rabe. <verse eid="EZK 22:29" /><verse number="30" style="v" sid="EZK 22:30" />Boga ookkone'e balleessabe'noshsha dalla'a ijaara'n, diigemeexxe bakka'n ookkone bogixxee ani edo uurraaka manjo insa'ne giddo hasenne; yaane kinni mittekanna afebe'no. <verse eid="EZK 22:30" /><verse number="31" style="v" sid="EZK 22:31" />Tennexxe aare anxe'n insa'ne gananno; mufe anxixxe giiraninna insa'ne birenne; assinemmaxxi duuchchanna insa'ne'ninni higgaashsha assenne, hiyya'neen Lumok Duuchchi Woddik Gootti.»<verse eid="EZK 22:31" /></para>
  <chapter eid="EZK 22" />
  <chapter number="23" style="c" sid="EZK 23" />
  <para style="s1">Yabaabulitto Lame Dayyuwwa</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 23:1" />Duuchchi Woddike Goottik hiyyichchi ane'n dageexxi: <verse eid="EZK 23:1" /><verse number="2" style="v" sid="EZK 23:2" />«Koo manjiinke belto mitte amanaa'n ilendeexxi lame dubarte hexxemman. <verse eid="EZK 23:2" /><verse number="3" style="v" sid="EZK 23:3" />Insa'nenna ka'umumma he'nemma wodda Gibtsee yabaabulletee qii'misseexxi yabaabulle; ookkone boga'ni guntuti insa'nek qaqqabeme; ookkonna dubarummatixxi insa'nexxi bobanna hanqalfende. <verse eid="EZK 23:3" /><verse number="4" style="v" sid="EZK 23:4" />Angaffatik summi Ohoola, isixxe dayyotik summinna Ohoolibatemmani; insa'ne lamiing anke kande; labbaxxanna meyyaxxa oose ani'a ille. Ohoolak summi Semaariyate, Ohoolibakinna Iyyerusaalemite.<verse eid="EZK 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 23:5" />«Ohoola anxe kaddeenni hexxeexxi yabaabulati qii'misse; ise jaalateeke Asooritotike loliinke manninni yabaabulde. <verse eid="EZK 23:5" /><verse number="6" style="v" sid="EZK 23:6" />Insa'ne yo'oshsha biifonsitaxxa baddeessite seemma odo'winammake, galchalluwwakenna ajajaluwwake, duuchchiingi danchallamma dargaggeeyyenna fadhado gulufe'emmakeeramman. <verse eid="EZK 23:6" /><verse number="7" style="v" sid="EZK 23:7" />Isenna gurrafule'eeke Asoorik manni duuchchinni yababulletee ifi sa'issite uute; welti yabaabuldemmake mannixxe fakkuwwa duuchchinninna ifi battoossite. <verse eid="EZK 23:7" /><verse number="8" style="v" sid="EZK 23:8" />Gibtsee saffemmaxxa yaabaabulle waaldebaan; ookkoo oosumat hexxemma wodda labballi isenni welti diiphe; dubarrummatika iseka guntuttanna qaqqabe; yabaabbulle ifixxanna ise'n bidhine.<verse eid="EZK 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 23:9" />«Tennexxe'e welti yababuldemmake iseka jaaluwwa'n, halchitemmake Asoorike mannixxe anga'n isee sa'isse uwwenne. <verse eid="EZK 23:9" /><verse number="10" style="v" sid="EZK 23:10" />Insa'nenna isee saalibelo gatinse; labbaxxanna meyyaxxa isexxa oose adhdhine; wolaantichchikinna isee shinne; melaalle duucha'ninna mammaasiinxe kadde; xixichchikinna ise'n muuxeme.<verse eid="EZK 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 23:11" />«Dayyo isexxi Ohoolibanna tenne uude'emman, kaddo malee qii'misatinna yaabaabuleti dayyo ifixxa caalde. <verse eid="EZK 23:11" /><verse number="12" style="v" sid="EZK 23:12" />Isenna galchalluwwikinna ajajalluwwik, kittetixxa seemma oddo'weeke loliinke manninni, fadhado gulufe'ekeerinninna, duuchchiinxe danchallamma dargaggeeyye kadde'exxe Asooritoti welti yaabaabulde. <verse eid="EZK 23:12" /><verse number="13" style="v" sid="EZK 23:13" />Isenna battooteexxa afenne; lamingi insa'ne mitte ora me'ine.<verse eid="EZK 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 23:14" />«Yaane kinni Ohooliba Yabaabullet qubasaxxa'n me'itte; gimote'n diimoxxe boo'enni giissendeexxa Kalaadottotike labbalixxa misile affe. <verse eid="EZK 23:14" /><verse number="15" style="v" sid="EZK 23:15" />Tinne misuluwak labballi hidhake'ni sabata ka'le'ekenna umoke'n rarraateexxa ruufa mirqedhe'eekemman; duuchchiing Kaladototike boga'n ilemeeke Baabiloonike loliinke mannixxe fadhadinxe gaaruwwake ajajalluwwa laba'emmakeeramman. <verse eid="EZK 23:15" /><verse number="16" style="v" sid="EZK 23:16" />Isenna tenne misiluwwa uuddee wodda welti yababuldo'a hasseexxi tinni misile hexxeeke Kalaadinike boga'n manna ergite. <verse eid="EZK 23:16" /><verse number="17" style="v" sid="EZK 23:17" />Baabiloonik manninna dage isenni diiphe isee battoosse; isenna battoteechchi uduma insa'nee diqateexxi insa'nenaa'n illee iima higge. <verse eid="EZK 23:17" /><verse number="18" style="v" sid="EZK 23:18" />Ba'linake'n yaababuliyyoti saala ifi buqedha gophphee wodda dayyo isexxenaa'n illee iima higennashshanni diqatennexxi isenaa'ninna illee iima higenenni. <verse eid="EZK 23:18" /><verse number="19" style="v" sid="EZK 23:19" />Ise kinni Gibtsee giddo yabaabuldemmaxxa ka'umummatixxa yanna qallita'n bira saxxe yabaabulde. <verse eid="EZK 23:19" /><verse number="20" style="v" sid="EZK 23:20" />Ookkonna bisi insa'nek harretikishsha, insa'nek sannetik wodi'inna fadhadiinkishsha hedheeke ifike jaaluwwinni welti yabaabulde. <verse eid="EZK 23:20" /><verse number="21" style="v" sid="EZK 23:21" />Tee Ohoolibaa, Gibtsee giddo boba atixxi qushendemmaxxanna ka'imummatik atik guntuti qaqqabememma woddixxa ka'imummatixxa qii'misa yortette.<verse eid="EZK 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 23:22" />«Tennexxee, tee Ohoolibaa Lumok Duuchchi Woddik Gootti hiyya'nee qici: diqatte'e insa'nenaa'n illeema higgetaka atika jaaluwwa ate'n kissannon; elqe kayyi'ninna ate bunqashsha iyyedagannon. <verse eid="EZK 23:22" /><verse number="23" style="v" sid="EZK 23:23" />Isa'nenna Baabiloonitotanna Keledaanito duuchcha, Feqoodika manna, Sho'aanikanna Qo'aka manna, insa'nenni welti Asoorito duuchcha. Isa'nenna danchallamma darggaggeeyye kanda woda duuchchingi galchalluwwakenna ajajulluwwake, fadhadiinxe gaaruwwake ajajaluwwanna jabaxxe baaleke mannamman. <verse eid="EZK 23:23" /><verse number="24" style="v" sid="EZK 23:24" />Insa'nenna loliinka mi'yuwwa, loliinke fadhadinxa gaaruwwanna gaaruwwat abixxeeke, heddo arda kandeexxi ate'n dangaan; ba'lalammanna odditte wontuwwa abixxine siblinxa gulluwwanna umoke'n uggudhdhine ori orii'n atee qoqqobaan; aninna xixendota'a atee anga insa'eneexxe'n sa'isse uwwannon; insa'nenna aada ifixxishsha ate'n murraan. <verse eid="EZK 23:24" /><verse number="25" style="v" sid="EZK 23:25" />Anxe hinaaffexxe mufenni ate'n mufatannon; insa'nenna ate'n mufeti ke'naan; sano mansha atixxanna wonxaan; atixxe gamonaa'n gateekiirinna wolaantichchake'n reyaan. Labba meyyaxxa atixxa oose adhdhinaan; gateeka atika manjonna giira ittaan. <verse eid="EZK 23:25" /><verse number="26" style="v" sid="EZK 23:26" />Seemuwwa atixxanna atenaa'n mulqe'naan; elollamma atika seesuwwanna atenaa'n adhinaan. <verse eid="EZK 23:26" /><verse number="27" style="v" sid="EZK 23:27" />Gibtseeke boga'n saffettaxxa yabaabullummanna qii'misumma atenaa'n gatisannon; atinna tenne yaanuwwaba'a uudabexxo; ta'ini edi'anna Gibtse yortabexxo.<verse eid="EZK 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 23:28" />«Lumok Duuchchi Woddik Gootti hiyya'nee qici: kunnise gibbetekiirixxe diqatetekixxe anga'n insa'nenaa'n illee iima higgetekiirixxe anga'n atee sa'isse uwwonna'aten. <verse eid="EZK 23:28" /><verse number="29" style="v" sid="EZK 23:29" />Insa'nenna atee gibati ate'n ke'naan; huccitetechcho duuchchanna atenaa'n adhdhinaan; ilendetebarishsha duwwinna atee gatinsaan; yabaabulle atixxik saalinna leellaan; qii'misa atixxinna yabaabulle atixxi <verse eid="EZK 23:29" /><verse number="30" style="v" sid="EZK 23:30" />ate'n tenne'e iyyedage'een; gosa gosake manninni welti yababuldettexxi fakkuwwa insa'nexxenninna battotettaxxee. <verse eid="EZK 23:30" /><verse number="31" style="v" sid="EZK 23:31" />Dayyo atixxike ora'n me'ite'eten, tennexxee ise ha'witemmaxxe buuda'n xixichcho ha'witattoshsha assanno.<verse eid="EZK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 23:32" />«Lumok Duuchchi Woddik Gootti hiyya'nee qici:</para>
  <para style="q1" vid="EZK 23:32">«Ba'laxxenna hubbuqitte</para>
  <para style="q2" vid="EZK 23:32">dayyo atixxixxe buudanaa'n atinna ha'witaton;</para>
  <para style="q1" vid="EZK 23:32">Jirachcho aaxxammaxxee yowwichchokaanna gacifachcho</para>
  <para style="q2" vid="EZK 23:32">isenaa'n godditatton.<verse eid="EZK 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="EZK 23:33" />Dayyo atixxe Semaariyaxxa buuda,</para>
  <para style="q2" vid="EZK 23:33">diigematixxenna ba'netixxe buudanaa'n,</para>
  <para style="q2" vid="EZK 23:33">yo'oshsha machchootenna yaaddaton.<verse eid="EZK 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="EZK 23:34" />Isenaa'n ha'witatton; giddii'ninna cingirsittexxi,</para>
  <para style="q2" vid="EZK 23:34">isenna butuchchitatton;</para>
  <para style="q2" vid="EZK 23:34">Atika ununaaranna hoqqexxatto;</para>
  <para style="m" vid="EZK 23:34">Ani Lumok Duuchchi Woddik Gootti tennee haaso'eennen.<verse eid="EZK 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 23:35" />«Tennexxee Lumok Duuchchi Woddik Goottinna anee deetettaxxee, ifi udumi'anna anee laffi assitettexxee, atixxe qili'meetekanna yabaabuleka hira ba'edhi.»<verse eid="EZK 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EZK 23:36" />Duuchchi Woddik Goottinna ane'n hiyya'nee qici: «Koo manjiinke belto, Ohoola'ninna Ohooliba'n murtota'atte? Yoona diqachchiissaaxxa huje insa'nexxa insa'ne'n kuli. <verse eid="EZK 23:36" /><verse number="37" style="v" sid="EZK 23:37" />Yabaabullemmaxxee insa'ne mundiinke manjon; fakkuwwa ifixxenni yabaabulle; ani'a illeexxa ifixxa oosenna midde fakkuwwa eetteeneeri'a itate kaddo'a ciincessine'een. <verse eid="EZK 23:37" /><verse number="38" style="v" sid="EZK 23:38" />Wele insa'ne ane'n hunjeexxi yaane: eettennen barra woyyitte anxa bakka bottoosine; Sanbatuwwa ankaaranna shollinshe. <verse eid="EZK 23:38" /><verse number="39" style="v" sid="EZK 23:39" />Oose ifixxa fakkuwwa ifixxee tolchineenxe barra'ninni woyyitte anxe bakka'n e'yineexxi isee battoossine. Tinni insa'nee anke mini giddo assineexxe yaanen.<verse eid="EZK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EZK 23:40" />«Wele waalin labballi bayyii'n insa'ne'a dago'a manna erge'ne, mannikinna dage. Atinna insa'ne'a biso anshexxe, illetike gaara'ninna hallo buu'litettexxi seesuwwikinna seefattette. <verse eid="EZK 23:40" /><verse number="41" style="v" sid="EZK 23:41" />Qore hana hexxeeke beeri edo ulfateexxe taqe'ninna ofoldee, anka hixaananna anxa ejersinxa zayite ookkone beeri hana uggitette.<verse eid="EZK 23:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="EZK 23:42" />«Fenxeya'neke heddi mannik canci qarqara iseke'n hedhemman; insa'ne welti qiilla gammoojjenaa'n dagemmak machcho'alli manninna hedhemman; kunni macho'alli manninna hirre isexxe'ninna isexxe dayyoxxe'n hirboora, umo insa'neke'ninna sesemeeka kallachchuwwanna uggure. <verse eid="EZK 23:42" /><verse number="43" style="v" sid="EZK 23:43" />Aninna hedho isexxi yabaabulleti muddeexxe eettene manjoxxee, ‹Woldonni isexxi hedha yabaallateete kaddemmaxxee kunni labballi isenni yabaabulaqata› hiyyenne. <verse eid="EZK 23:43" /><verse number="44" style="v" sid="EZK 23:44" />Insa'nenna isenni welti diinphe; manji yabaabulto manjonni diiphammashshanni insa'ne tenne qii'mito melaalle, Ohoolanna Ohoolibanni welti diinphe. <verse eid="EZK 23:44" /><verse number="45" style="v" sid="EZK 23:45" />Tinni melaalle yabaabuldexxenna mundiinxe kaddemmaxxee qulliyye kinni yabaabultote'ninna mundiinxe melaalle'n murendaaxxa murte tenne melaalle'n murtaan.<verse eid="EZK 23:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="EZK 23:46" />«Lumok Duuchchi Woddik Gootti hiyya'nee qici: Lele'misse insa'nen ke'o'a arda iyyedag; saammemo'anna weekkemo'a insa'nee sa'issite uwwi. <verse eid="EZK 23:46" /><verse number="47" style="v" sid="EZK 23:47" />Ardikinna insa'nee kinjik cancaqaan; wolaantichchikinna insa'nee kochchisaan; labba meyyaxxa insa'nexxa oose shiyaan; minuwwa insa'nekaranna gubaan.<verse eid="EZK 23:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="EZK 23:48" />«Tennexxee melaalle duuchchi xexe'ato'anna insa'neshsha yabaabula gophpho'a qii'misumma ookkone boginaa'n gatisannon. <verse eid="EZK 23:48" /><verse number="49" style="v" sid="EZK 23:49" />Ha'noonna qii'misumma ha'noxxika hira adhdhitinaan; fakkuwwa magenoonfatinemmaxxe cubboka xixichonna badhaatinaan; ookkone wodda ani Lumoke Duuchchi Woddike Gootta kadeennexxa egendinaan.»<verse eid="EZK 23:49" /></para>
  <chapter eid="EZK 23" />
  <chapter number="24" style="c" sid="EZK 24" />
  <para style="s1">Distetika Fakkeenna</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 24:1" />Booji'emennexxe Sallanixxe wogga'n tommike agenjixxe tommixxe barra'n Duuchchi Woddike Goottik hiyyichchi ane'n dageexxi: <verse eid="EZK 24:1" /><verse number="2" style="v" sid="EZK 24:2" />«Koo manjiinke belto, Baabiloonik moyanji tennee barra'n Iyyerusaalemika qachcha buqeen; telchiixxe barraxxa barraka summa borreesi. <verse eid="EZK 24:2" /><verse number="3" style="v" sid="EZK 24:3" />Konne jallichcha ardiinxe mammaaka'ni: Lumok ‹Duuchchi Woddiki Gootti insa'nee hiyya'neen hitatoo qici:</para>
  <para style="q1" vid="EZK 24:3">« ‹Disite booso uggi;</para>
  <para style="q2" vid="EZK 24:3">wode'ekanna iti wori.<verse eid="EZK 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 24:4" />Maalakena'ni guma,</para>
  <para style="q2" vid="EZK 24:4">elolaamma wowwoxemee maala duuchcha, luka, haye,</para>
  <para style="q1" vid="EZK 24:4">Filendexxa miqqenna ise'n wonshi.<verse eid="EZK 24:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="EZK 24:5" />Filemeeka gedhebokenaa'n aadhi;</para>
  <para style="q1" vid="EZK 24:5">Miqe isixxinna raxxo'a disteti hunda, haqqe tuuli;</para>
  <para style="q2" vid="EZK 24:5">raxxe musukki hittaashsha assi;</para>
  <para style="q2" vid="EZK 24:5">miqqe isixxinna raxxowaal.<verse eid="EZK 24:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="EZK 24:6" />Tennexxee Lumok Duuchchi Woddik Gootti hiyya'nee qici:</para>
  <para style="q1" vid="EZK 24:6">« ‹Ookkone munde manjiinxa dhangalaaseeke qachchi'a aanne'e!</para>
  <para style="q2" vid="EZK 24:6">isi ciilakenaa'ninna luqqitebaaxxe disteshaten;</para>
  <para style="q2" vid="EZK 24:6">munde dhangalaaseke qachchi'a aanne'e;</para>
  <para style="q1" vid="EZK 24:6">Gargar hiissitatoka hixa ibissebexong,</para>
  <para style="q2" vid="EZK 24:6">mitti mittinga maala giddii'n fulchite disite duwwi gatis.<verse eid="EZK 24:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="EZK 24:7" />Dhangalaatexxi munde qachchi giddo hexxeen;</para>
  <para style="q2" vid="EZK 24:7">qachchiink manni care duwwixxe'n munde dune malee'e;</para>
  <para style="q1" vid="EZK 24:7">Bukko buqa dandeetake,</para>
  <para style="q2" vid="EZK 24:7">buttina'n dhangalaaseba'a.<verse eid="EZK 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 24:8" />Aare anxi bubbe'na'a halo fulonna'a,</para>
  <para style="q2" vid="EZK 24:8">munde itti buyyendabaa qico'n,</para>
  <para style="q2" vid="EZK 24:8">care duwwixxe'n dhangalaataashsha assenne.<verse eid="EZK 24:8" /></para>
  <para style="b" />
  <para style="m">
    <verse number="9" style="v" sid="EZK 24:9" />Tennexxee Lumok Duuchchi Woddik Gootti hiyya'nee qici:</para>
  <para style="q1" vid="EZK 24:9">« ‹Munde manjiinxa dhangalaaseeke qachchi'a aanne'e!</para>
  <para style="q2" vid="EZK 24:9">Aninna, iittanni isi gubataaxxa haqqe tuulannon.<verse eid="EZK 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 24:10" />Haqqetanna tuuli;</para>
  <para style="q2" vid="EZK 24:10">giiratanna itti ha'ishshi;</para>
  <para style="q1" vid="EZK 24:10">Maalakanna adda gafi;</para>
  <para style="q2" vid="EZK 24:10">qimamuwwatanna iso'n wori;</para>
  <para style="q2" vid="EZK 24:10">miqetinna gubatowaal.<verse eid="EZK 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 24:11" />Xuri isek ke'o'a</para>
  <para style="q2" vid="EZK 24:11">ciili isekinna gubato'a,</para>
  <para style="q1" vid="EZK 24:11">Eebbitaa qici'a duwwixa disite</para>
  <para style="q2" vid="EZK 24:11">maalde'i isekinna diimmata qici'a kashiloke'n uggi.<verse eid="EZK 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 24:12" />Jaba qico eloosiseek isek ciil,</para>
  <para style="q2" vid="EZK 24:12">bira sa'netenaa'n kexxeexxa,</para>
  <para style="q2" vid="EZK 24:12">giiratinna midde ba'ebaan.<verse eid="EZK 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 24:13" />« ‹Ati battotetek atixxe qii'misanniten; ani atee luqqi assonna'a wo'laanenen yane kinni ati luqqitebexxo, mufe anxa ate'n bidhano qici'a ta'anni edi'a luqqitabexxo.<verse eid="EZK 24:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="EZK 24:14" />« ‹Ani Duuchchi Woddik Gootti haaso'ennen. Hujannoxxi yannanna gelte'een. Udumi'a higabo'no; mararabo'no, hoodatanna hoodabo'no. Me'injo atikishshanna huje atixxishshaani ate'n murannon; hiyya'neen Lumok Duuchchi Woddiki Gootti.› »<verse eid="EZK 24:14" /></para>
  <para style="s1">Hiziqi'eelixxe Arexxa Reyo</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 24:15" />Duuchchi Woddike Goottik hiyyichchi ane'n higgeen dageexxi: <verse eid="EZK 24:15" /><verse number="16" style="v" sid="EZK 24:16" />«Koo manjiinke belto ati ille uggiteetexxa ikki woddi atenaa'n adhdhonaaten; kinni ooxxoxxe'e; indidotanna fulchitoxxe'e. <verse eid="EZK 24:16" /><verse number="17" style="v" sid="EZK 24:17" />Fiixisi malee reyeekee ooxxoxxe'e. Ruufatanna umokenaa'n hoyyitoxxee; leekatenaa'ninna kophe fulchchitoxxe'e; yaaddo leellishatee suumeti qico'n buqexxoxxe'e; haqaqotanna ittoxxe'e.»<verse eid="EZK 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 24:18" />Aninna ardake'n gorsa haaso'ennen; galgala eetteneen are anxinna rerte; langa baro gorsa aninna ajajemennexxa assenne.<verse eid="EZK 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 24:19" />Ardiknna, «Assitettexxi tinni yaane no'o'a maa erga affe'eexxa no'o'n kuldabexxoo?» hiyye anee qore.<verse eid="EZK 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 24:20" />Aninna insa'ne'n hiyyennee qici: «Duuchchi Woddike goottik hiyyichchi ane'n dageexxi: <verse eid="EZK 24:20" /><verse number="21" style="v" sid="EZK 24:21" />Isira'eelike arda'n hiyyi hiyyee qici: ‹Ani ha'nooxxe hollaxxee hunna hiyya'nen Duuchchi Woddik Gootti: ha'no ille uggudhitine'ekanna ha'noxxe qalbexxe gammashsho kade'eeka anka galma battosona'aten. Waaldine me'itinemmaxxi ha'nooxxi labba meyyaxxi oose wolaantichchoke'n rertaan. <verse eid="EZK 24:21" /><verse number="22" style="v" sid="EZK 24:22" />Ha'nonna ani assennashsha assitinaan. Yaaddo leelshate suumeti qico'n buqexxinabaan, haqaqotanna itinabaan. <verse eid="EZK 24:22" /><verse number="23" style="v" sid="EZK 24:23" />Ruufatanna umokenaa'n hoyyexxinaba'a, kophetanna leekkatenaa'n fulchchexxinaba'a. Cubbo ha'nooxxenaa'n kexxeexxa tallalootina; weli'a fiixisinaa malee oodhishsha afoldinabaan yookaan ooxxinabaan. <verse eid="EZK 24:23" /><verse number="24" style="v" sid="EZK 24:24" />Hiziqeeli ha'no'aa beesisake kadaan; isi assemmashsha ha'noonna assitinaan tinni kaddaa wodda ani Lumoke Duuchchi Woddike Gootta kadennexxa egendinaan.›<verse eid="EZK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 24:25" />«Atinna, koo manjiinke belto, insa'nexxa hunna, gammachcho insa'nexxanna gaachchanna insa'neka, insa'ne ille uggudhinnaaxxa insa'nexxa ifi duka kade'aka galmanna labba meyyaxxa oose insa'nexxenninni insa'nenaa'n aadhdhannoxxa barra <verse eid="EZK 24:25" /><verse number="26" style="v" sid="EZK 24:26" />eettene barra ba'netenaa'n gateek manji tenne odo ate'n oddeeso'a dagaan. <verse eid="EZK 24:26" /><verse number="27" style="v" sid="EZK 24:27" />Eettene barra afo'i atik baneme'naa isinni haasottatton; ookkoneechchi uduma afo'o duudake kaddabexxon; ardakeenna beessisake kaddatton; insa'nenna ani Duuchchi Woddike Gootta kadennexxa egennaan.»<verse eid="EZK 24:27" /></para>
  <chapter eid="EZK 24" />
  <chapter number="25" style="c" sid="EZK 25" />
  <para style="s1">Amoon'n Daga'neechchixxe'e Kulendeexxa Wabeekumma</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 25:1" />Duuchchi Woddike Goottik hiyychchi ane'n dageexxi:<note caller="-" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="JER 49:1-6">Erm. 49:1-6</ref>; <ref loc="EZK 21:28-32">Hiz. 21:28-32</ref>; <ref loc="AMO 1:13">Amo. 1:13</ref>; <ref loc="ZEP 2:8-11">Sof. 2:8-11</ref>. </char></note> <verse eid="EZK 25:1" /><verse number="2" style="v" sid="EZK 25:2" />«Koo manjiinke belto alba Amoonitotibaa wirri hitettexxi raaga insa'nexxe'e raagi. <verse eid="EZK 25:2" /><verse number="3" style="v" sid="EZK 25:3" />Insa'ne'n hite haasotatto qici, ‹Lumoke Duuchchi Woddike Goottika hiyyichcho laqqe. Lumok Duuchchi Woddike Gootti hiyya'nee qici: Galmi anki battoo'emma wodda, Isira'eelik bogi urmake kadeemma wodda, Yihudiink ardi booji'emeemma wodda: «Hashshu» hitinemmaxxee, <verse eid="EZK 25:3" /><verse number="4" style="v" sid="EZK 25:4" />tennexxee borotike ardi'a hirendino'a anga insa'nexxe'n ha'no'o sa'isse uuwwannen. Insa'nenna ha'nooxxe oddo'ni kaambuwwa giisse'neexxi dunkaana ookko oltinaan; ha'no wilissitineechcho duuchcha indaan ha'noxxa adonna ha'winaan. <verse eid="EZK 25:4" /><verse number="5" style="v" sid="EZK 25:5" />Ani Rabaaka qachcha gaaluwwinke bobba'i, Amoonika boganna gedhebi ciisake assannon; ookkone wodda ani Duuchchi Woddike Gootta kadennexxa egendinaan. <verse eid="EZK 25:5" /><verse number="6" style="v" sid="EZK 25:6" />Tennexxee Dada Duuchchik Duuchchi Woddiki Gootti hiyya'ne qici: Godoba afinemmake fuggoke yaadinaa'n kexxeexxa, Isira'eelike boga'n ba'ne geltee wodda gammadat anga caldinnemmaxxeenna utaldina'n qeexaldinemmaxxe'e, <verse eid="EZK 25:6" /><verse number="7" style="v" sid="EZK 25:7" />tennexxe'e irre anxa ha'no'n ke'issennexxi gosa gosak ardinna ha'noo assamaashsha assannon; arduwwiinxe oddona'inna ha'no'o qurbi assannon; boguwwakenaa'ninna ha'no'o balleessannon. Ookkone wodda ani Duuchchi Woddike Gootta kadennexxa egendinaan.› »<verse eid="EZK 25:7" /></para>
  <para style="s1">Mo'abi'n Daga'nechchixxee Kulendeexxa Wabeekumma</para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 25:8" />«Lumok Duuchchi Woddik Gootti hiyya'nee qici: ‹Mo'aabinna Seyiiri «Kunnise Yihudak ardi wele gosa gosake ardi duuchchishshande kadde'een» hine'een.<note caller="-" style="x"><char style="xo" closed="false">25:8 </char><char style="xt" closed="false"><ref loc="ISA 15:1-16:14">Isa. 15:1—16:14</ref>; <ref loc="ISA 25:10-12">25:10-12</ref>; <ref loc="JER 48:1-47">Erm. 48:1-47</ref>; <ref loc="AMO 2:1-3">Amo. 2:1-3</ref>; <ref loc="ZEP 2:8-11">Sof. 2:8-11</ref>.</char></note> <verse eid="EZK 25:8" /><verse number="9" style="v" sid="EZK 25:9" />Tennexxe'e Ba'aalme'oonike bogixxe gabala'n isi'a gaachchannake kade'eeka qachchuwwa, Beetiyeshimootii'n, Be'aalimewo'niininna Qiryaatayimii'n safennexxi Mo'aabixxa kollo banqara assannon. <verse eid="EZK 25:9" /><verse number="10" style="v" sid="EZK 25:10" />Mo'abikanna Amoonka manna mittenba borotike ardi'a hiremo'a insa'nexxe anga'n sa'isse uwwannon. Amoonik ardinna gosa gosake ardixxe oddo'n qaabatemaba'a; <verse eid="EZK 25:10" /><verse number="11" style="v" sid="EZK 25:11" />aninna Mo'aabi'i xixannon; eettene yanna ani Duuchchi Woddike Gootta kadennexxa egennaan› » hiyye.<verse eid="EZK 25:11" /></para>
  <para style="s1">Edomi'n Dagaachchixxee'e Hasso'emeeka Wabeekumma</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 25:12" />«Duuchchi Woddik Gootti hiyya'nee qici: ‹Eedoomik ardi Yihudake arda'n halo fuliyyot, yo'oshsha balleessanjoke kademmaxxee, <verse eid="EZK 25:12" /><verse number="13" style="v" sid="EZK 25:13" />tennexxee Duuchchi Woddik Gootti hiyya'nee qici: Hirre anxinni Eedoomi'n ke'annon; isika hore manjo shiyennexxi boga urmake assannon. Temaanike qachchinaa'n Dedaanke qachchi qico'n ardi wolaantichchik mudaan. <verse eid="EZK 25:13" /><verse number="14" style="v" sid="EZK 25:14" />Arda anke Isira'eel gamii'n Eedoomi'n halo fulannon; Insa'nenna anxe mufexxe qixxe'ninna anxe aarexxe qixxe'n Edoomike arda'n halo fullaan; Edoomik manninna anxa halo fula ege'naan hiyya'neen Lumok Duuchchi Woddik Gootti› » hiyye.<verse eid="EZK 25:14" /></para>
  <para style="s1">Filsixeemi'n Daga'neechchixxee Kulendeexxa Wabeekumma<note caller="-" style="x"><char style="xo" closed="false">25:12-14 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">Isa. 34:5-17</ref>; <ref loc="ISA 63:1-6">63:1-6</ref>; <ref loc="JER 49:7-22">Erm. 49:7-22</ref>; <ref loc="EZK 35:1-15">Hiz. 35:1-15</ref>; <ref loc="AMO 1:1-12">Amo. 1:1-12</ref>; <ref loc="HEB 1:14">Ibr. 1:14</ref>; <ref loc="MAL 1:2-5">Mil. 1:2-5</ref>.</char></note></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 25:15" />«Lumok Duuchchi Woddik Gootti hiyya'nee qici: ‹Filisixeemik ardi godoba abixxemmaxxe fuggoxxenni ke'eexxi halo fulemmaxxeenna hosse galdeexxe naaphuntenni Yihudaka ardanna biro'a yoremmaxxee,<note caller="-" style="x"><char style="xo" closed="false">25:15 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">Isa. 14:29-31</ref>; <ref loc="JER 47:1-7">Erm. 47:1-7</ref>; <ref loc="JOL 3:4-8">Iyu. 3:4-8</ref>; <ref loc="AMO 1:6-8">Amo. 1:6-8</ref>; <ref loc="ZEP 2:4-7">Sof. 2:4-7</ref>; <ref loc="ZEC 9:5-7">Zek. 9:5-7</ref>. </char></note> <verse eid="EZK 25:15" /><verse number="16" style="v" sid="EZK 25:16" />tennexxee Dada Duuchchik Duuchchi Woddik Goottinna kunnise hirre anxa Filisixeemitote'n ke'issonnaten; Kelitotanna birannon; abbaayyatike kasike boga'n gatemmakaaranna kutti assannon. <verse eid="EZK 25:16" /><verse number="17" style="v" sid="EZK 25:17" />Jaba qico insa'ne'n halo fulannon; anxe balanninna insa'nee xixanno wodda, ookkone wodda ani Duuchchi Woddike Gootta kadennexxa egennaan.› »<verse eid="EZK 25:17" /></para>
  <chapter eid="EZK 25" />
  <chapter number="26" style="c" sid="EZK 26" />
  <para style="s1">Xiroosi'n Kulendeexxa Wabeekumma</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 26:1" />Boji'emmennexxe tommenna mitteesoxxe woggaxxe, sirtixxe barra'n, Duuchchi Woddike Goottik hiyyichchi ane'n dageexxi:<note caller="-" style="x"><char style="xo" closed="false">26:1 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">Isa. 23:1-18</ref>; <ref loc="JOL 3:4-8">Iyu. 3:4-8</ref>; <ref loc="AMO 1:9-10">Amo. 1:9-10</ref>; <ref loc="ZEC 9:1-4">Zek. 9:1-4</ref>; <ref loc="MAT 11:21-22">Mat. 11:21-22</ref>; <ref loc="LUK 10:13-14">Luq. 10:13-14</ref>. </char></note> <verse eid="EZK 26:1" /><verse number="2" style="v" sid="EZK 26:2" />«Koo manjiinke beltoo, Xiroosi Iyyerusaalemi'i, ‹Baganni! Gosa gosak ardixxi huddumme enqende; isek cufanuwwinna ani'a baneme'een, yoona ise diigendemmaxxee ani'a wo'mitaan› hitemmaxxee, <verse eid="EZK 26:2" /><verse number="3" style="v" sid="EZK 26:3" />tennexxee Lumok Duuchchi Woddik Goottinna tee Xiroosi, ani ate'n ke'eenne; abbaaya danbala'a dukke ke'issitammashsha, aninna heddo gosa gosaka arda ate'n ke'issannon. <verse eid="EZK 26:3" /><verse number="4" style="v" sid="EZK 26:4" />Insa'nenna Xiroosika dalla'uwwa diingaan; isexxa xeleephphuwwa findigaan; ani buttina iseka fiye aadhennexxi isee rassa duwwixxe assannon. <verse eid="EZK 26:4" /><verse number="5" style="v" sid="EZK 26:5" />Ani Lumok Duuchchi Woddik Gootti haaso'ennaxxee, abbaayyatixxe giddichcho'n ise qulxumetixxe marabexxe fayenshatixxe bakka kaddaan; gosa gosak ardi'a saamematixxe kaddaan; <verse eid="EZK 26:5" /><verse number="6" style="v" sid="EZK 26:6" />Abayatike kasike qarqarik olla'uwwik isek manni walaantichik shiyemaan. Eettene yaana ani Duuchchi Woddike Gootta kadennexxa egennaan» hiyye.<verse eid="EZK 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 26:7" />«Dada Duuchchik Duuchchi Woddik Goottinna ani moyanjuwwinka moyanjo kade'eka, Baabiloonika moyanjo Naabukadanatsoori'i, fadhadikinninna fadhadinxe gaaruwwanni, fadhado gulufeekeerinninna heddo loliinke manninni welti middii'n Xiroosi'n idagannon. <verse eid="EZK 26:7" /><verse number="8" style="v" sid="EZK 26:8" />Abbayyatike kasike qarqarik olla'uwwik iseka manna walaantichchik shiyaan; qarqara atike'ninna qoqoba giissaan; atike dalla'ixxe xungo qico'n buttina tulubeexxi ate'n wonte qeefata. <verse eid="EZK 26:8" /><verse number="9" style="v" sid="EZK 26:9" />Dalla'a diigatika ifika lumoka haqichchike gubbuwwinni atike dalla'a gawwisaan; miya ifikenninna atixxa xellephuwwa diigaan. <verse eid="EZK 26:9" /><verse number="10" style="v" sid="EZK 26:10" />Fadhado isikixxe bira sa'nenaa'n kexxeexxa ke'isexxi buko atee'e buqqaan; dalla'i diigemeeke qachcha'n manni e'yamma woddishsha isi atixxe hulaanaa'n e'yaa wodda, loliinke fadhadixxe, gaaruwwatixxenna fadhadiinxe gaaruwaxxe kakaweettena'n kexxeexxa dalla'uwwi atik sheke sheke hiyyaan. <verse eid="EZK 26:10" /><verse number="11" style="v" sid="EZK 26:11" />Ifike fadhadixxe kottenni oruwwa atika duuchcha hirbeessaan; arda atikanna wolaantichchik shiyaan; jajjabbi atik utuphuwwinna butti'a ibaan. <verse eid="EZK 26:11" /><verse number="12" style="v" sid="EZK 26:12" />Qabeenna atika duuchcha samaan; atika daddalatika miyanna boojinaan, dalla'uwwa atikanna diingaan, elolla atika minnuwwanna findigaan, kino atixxanna, atixxa maluwwanna kinjinka minuwwixxa ole abbaayyate'n hunnaan. <verse eid="EZK 26:12" /><verse number="13" style="v" sid="EZK 26:13" />Atike sirbika hoga sammi assannon; ta'inni edi'a atike kiraaruwwik hafuur laqemabaan.<note caller="-" style="x"><char style="xo" closed="false">26:13 </char><char style="xt" closed="false"><ref loc="REV 18:22">Wal. 18:22</ref>. </char></note> <verse eid="EZK 26:13" /><verse number="14" style="v" sid="EZK 26:14" />Atee rassa duwwixxe assannon; qulxu'metixxi marabe fayendaaxe bakka kaddatton; haranga langaxxa qammachchendabexxon; ani Duuchchi Woddik Gootti tennee haaso'ennen hiyyeexxi Lumok Duuchchi Woddik Gootti haaso'een.<verse eid="EZK 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 26:15" />«Lumok Duuchchi Woddik Gootti Xiroosi'i hiyya'nee qici, ‹Mado'eek aada woddanna ati giddo weli bira hexxaa wodda, atixxixxe ibake luuljinaa'n kexxeexxa giddichchuwwa lele'mitabaata? <verse eid="EZK 26:15" /><verse number="16" style="v" sid="EZK 26:16" />Abbaayyatike kasixxi hayyoole duuchchi ifixxe mootenaa'n dirritaan; fugantemmaxxa seemmuwwa ifinaa'n hunnaa; seesuwwi gobemeexxa seemmuwwa fulche'naan; culphinseexxi butta ofo'liyyoti ate'n gelteexxe yaanuwwanaa'n kexxeexxa duuchchi wodda weekemma'n he'naan.<note caller="-" style="x"><char style="xo" closed="false">26:16 </char><char style="xt" closed="false"><ref loc="REV 8:9-10">Wal. 8:9-10</ref>. </char></note> <verse eid="EZK 26:16" /><verse number="17" style="v" sid="EZK 26:17" />Ati'a boochchisa boochchinsa'n hinaa qici,</para>
  <para style="q1" vid="EZK 26:17">« ‹Abbaayyate'n manni giddo hedhammakee,</para>
  <para style="q2" vid="EZK 26:17">koo gura fuldeetteke qachcha! Hittatta baxxette!</para>
  <para style="q1" vid="EZK 26:17">Ati giddo hedhammake manninni welti,</para>
  <para style="q2" vid="EZK 26:17">ati abbaayyuwwati hana hunnaameessakemman;</para>
  <para style="q1" vid="EZK 26:17">Abbaayyatike kasa'n hedhammakaa duuchchaaranna</para>
  <para style="q2" vid="EZK 26:17">culphiissisattakemman.<verse eid="EZK 26:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZK 26:18" />Ta'a atixxe ibbaxxe barra'n,</para>
  <para style="q2" vid="EZK 26:18">giddichchuwwa lele'mite;</para>
  <para style="q1" vid="EZK 26:18">Atixxe digenshanaa'n kexxeexxa,</para>
  <para style="q2" vid="EZK 26:18">giddichchuwwa giddo hedhammak manninna gilgile.›<verse eid="EZK 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 26:19" />«Lumok Duuchchi Woddik Goottinna manji giddo hedhabaake ona qachcha atee assanno wodda, lumoxxe abbayyaka dhi'mooti wode'e ati hana idage'naa atee liqiinsaa wodda, <verse eid="EZK 26:19" /><verse number="20" style="v" sid="EZK 26:20" />olimik ardi e'yemmaxxe bale'n butti'a e'yemmakeerinni welti butti'a e'yittattoshsha atee assanno; bale giddi'a e'yammakeerinni welti olmixxe ole'n, hundike wiidda boga'n hexxattoshsha assanno. Ookkoneechchi uduma hedhot hedhaak manni hedhaaxxe buttaba'a illee iima higgabexxo. <verse eid="EZK 26:20" /><verse number="21" style="v" sid="EZK 26:21" />Alayyiinke atee assannon; ta'inni eldi'anna hexxabexxo; hasendatton haranganna afendabexxo» hiyya'neen Lumok Duuchchi Woddik Gootti.<note caller="-" style="x"><char style="xo" closed="false">26:21 </char><char style="xt" closed="false"><ref loc="REV 18:21">Wal. 18:21</ref>.</char></note><verse eid="EZK 26:21" /></para>
  <chapter eid="EZK 26" />
  <chapter number="27" style="c" sid="EZK 27" />
  <para style="s1">Xiroosi'a Fuleeka Boochchisa</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 27:1" />Duuchchi Woddike Goottik hiyyichchi ane'n dageexxi: <verse eid="EZK 27:1" /><verse number="2" style="v" sid="EZK 27:2" />«Koo manjiinke belto Xiroosi'a boochchisa boochchisi; <verse eid="EZK 27:2" /><verse number="3" style="v" sid="EZK 27:3" />Abbayyatixxe hulaba heexxaammaxxanna heddo giddichchuwwake ardinni dadda'lendeexxe Xiroosi'n hitatto qici, ‹Lumok Duuchchi Woddik Gootti hiyya'neen hitatto qici:</para>
  <para style="q1" vid="EZK 27:3">« ‹Tee, Xiroosi!</para>
  <para style="q2" vid="EZK 27:3">«Ani danchummat muxuuxxeten» hite'etten.<verse eid="EZK 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 27:4" />Gabala atixxi abbayyatixxe oddo;</para>
  <para style="q2" vid="EZK 27:4">ate ijaareekirnna atee danchosse muxuuxe fulche;<verse eid="EZK 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 27:5" />Atixxa becuwwa duuchchanna</para>
  <para style="q2" vid="EZK 27:5">Seneerii'n dageeke hi'neesike haqichuwixxe assinne;</para>
  <para style="q1" vid="EZK 27:5">Utupha ati'a giissino'a,</para>
  <para style="q2" vid="EZK 27:5">Libaanoosii'n birbirsa iyyedange.<verse eid="EZK 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 27:6" />Baasanii'n dageeke qilxika,</para>
  <para style="q2" vid="EZK 27:6">hobolotika shaffisa ati'a giissine;</para>
  <para style="q1" vid="EZK 27:6">Qophiroosi'n dageeke birbirsixxa</para>
  <para style="q2" vid="EZK 27:6">atixxa fawo dana'iinxe issonni seense giisine.<verse eid="EZK 27:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 27:7" />Atixxe lummoxxe hoboluwwak shari,</para>
  <para style="q2" vid="EZK 27:7">Gibtseeke bogixxe layinnonn ganeemekemman.</para>
  <para style="q1" vid="EZK 27:7">Kunninna ati'a baandiirinxa la'o uwwa'nemman;</para>
  <para style="q2" vid="EZK 27:7">atik goluwwinna Elishaxxe giddichuwwanaa'n dage'eke,</para>
  <para style="q1" vid="EZK 27:7">Cuqulliissite bifakkenna baddeessitetikemman.<verse eid="EZK 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 27:8" />Markaba atika shaffisaak manni Sidoonikinna Arewaardi hinaake qachchuwwanaa'ni dagekeeran;</para>
  <para style="q2" vid="EZK 27:8">koo, Xiroosi atixxi beekkole atixxe lumollamma hoboluwake akeesanjuwwamman.<verse eid="EZK 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 27:9" />Angatixxa oge afeek Gebbaalik manni,</para>
  <para style="q2" vid="EZK 27:9">atixxa lumolla hoboluwwa duuchcha woddi'i e'yabaashsha qammalchate'e ati giddo hedhemman;</para>
  <para style="q1" vid="EZK 27:9">Abbaayyatixxi lumolla hoboluwwanna isee oofammakiir duuchchi</para>
  <para style="q2" vid="EZK 27:9">atenaa'n hidhdho'anna ate'n gurgudho'a daga'emman.<verse eid="EZK 27:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="EZK 27:10" />« ‹Faarsik, Lidiyaakinna Fuuxiki manni loliinke manna</para>
  <para style="q2" vid="EZK 27:10">kadnee atike sannachchi giddo ergateme;</para>
  <para style="q1" vid="EZK 27:10">Insa'ne ati biifondatoshsha,</para>
  <para style="q2" vid="EZK 27:10">wonte ifixxanna ifixxa sibiliinxa gulle, atike kasa'n fannisse.<verse eid="EZK 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 27:11" />Arewaadinna Heleekik manni,</para>
  <para style="q2" vid="EZK 27:11">atike dalla'ike qarqara duuchcha'ni hedhemman;</para>
  <para style="q1" vid="EZK 27:11">Gammaadik manninna, atike dalla'ixxe xeeleepho giddo hedhemman.</para>
  <para style="q2" vid="EZK 27:11">Insa'nenna ifixxa wonte atike dalla'i qarqara duuchcha'n fanninsse;</para>
  <para style="q1" vid="EZK 27:11">Atixxa danchummanna quba sa'isinne.<verse eid="EZK 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 27:12" />« ‹Atixxe bira saxxeexxe durumanaa'n kexxeexxa,</para>
  <para style="q2" vid="EZK 27:12">Tersesinni weli iima dada'litina'nemman;</para>
  <para style="q1" vid="EZK 27:12">Ise sibljo birreninna siblik,</para>
  <para style="q2" vid="EZK 27:12">qorqoorotike siblinninna irsaase hiyyemmake siblinni miya atenaa'n hidhite'amma.<verse eid="EZK 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 27:13" />« ‹Ati Yaawaninni, Tubbali'ninna Meesheekinni weli iima dada'litina'eman; insa'ne'e garbikinna sageetotike sibilinni miya atenaa'n hidhina'emman.<verse eid="EZK 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 27:14" />« ‹Ati Beeti Togaarmak manninninna wei iima dada'litina'emman; insa'nenna hujetike fadhadinni, loliinke fadhadinninna loliinxe gaangenni miya atenaa'n hidhina'emman.<verse eid="EZK 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 27:15" />« ‹Ati Dedaanike manninni weli iima dada'litina'neman; heddo giddichchuwwa manninna weli iima dada'lina'emmake atike jaaluwwan; insa'ne dana'iinxe issonninna zophi hiyyemaake xilloke jabake haqichchinni miya atenaa'n hidhina'nemman.<verse eid="EZK 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 27:16" />« ‹Huccitetechchixxe bira sa'nenaa'n kexxeexxa Sooriyanni weli iima dada'litina'neman; isenna bulur hiyyemaake fiixeek kinjinni, baddeessitte seemanni, seesuwwi gobemeexxa semmanninna, layinotixxe seemmanni, elellatinninna fiixeeke diidiimoke kinjinni atenaa'n miya hidhina'nemman.<verse eid="EZK 27:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 27:17" />« ‹Yihudanna Isira'eeli atinni weli iima dada'lina'nemman; insa'ne Miniitike bogixxa dinne, xe'mallo kebbo, malebo, ejersixxa zayitenna balasaane hiyyemake haqichchixxa madate'n isemaaka gora idagga'n atenaa'n miya hidhina'neman.<verse eid="EZK 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 27:18" />« ‹Huccitetechchixxe bira sa'nenaa'n kexxeexxa, Demasiqo ardi Keliboonii'n daggeexxe woyinetixxe bookanninna Zaahari'n daggeexxe gedhebiinxe ordanni atenaa'n miya hidhina'nemman.<verse eid="EZK 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 27:19" />« ‹Oseeli hedhammak Wendaanikinna Yaawanik manni dangeexxi atinni weli iima dada'la'nemman; insa'ne tumemeeke siblinni, dakadhatinna hanxaxet miya atenaa'n hidhina'nemman.<verse eid="EZK 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 27:20" />« ‹Dedaanik manni ati'a gilaase idaga'n atinni weli iima dada'litina'nemman.<verse eid="EZK 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 27:21" />« ‹Arabikinna Qeedariki akeekisanjuwwi duuchcha gedhebika buruusa, gedhebinxa korbeeyyenna, re'etixxa korbeeyye idagati ate'n dada'lina'neemman.<verse eid="EZK 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 27:22" />« ‹Saabake mannixxinna Ra'imake mannixxi dadalto yo'oshsha eloxxe gargar gargar hexxeexxa qurunfuduwwa duuchcha, fiixe'eka kinjuwwanna worqenni atinni weli iima dada'lna'nemman.<verse eid="EZK 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 27:23" />« ‹Karaanik manni, Kaanek, Edeenik, Saabake bogixxi daddalto, Asoorikinna Kilimaadiki manni ate'n dada'lina'nemman. <verse eid="EZK 27:23" /><verse number="24" style="v" sid="EZK 27:24" />Biiffaxxa seemmuwwa, cuqullichcha kaaba, seesiki gobendeexxa seemmuwwa, gargara gargar hexxeexxe bifaxxe wodaronni duudhende ganedeexxa racho atixxe dikko'n ate'n dadda'lina'nemman.<verse eid="EZK 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="EZK 27:25" />« ‹Terseesi bogixxi lumolla hoboluwwa</para>
  <para style="q2" vid="EZK 27:25">mi'uwwa atika feeta'nemaani;</para>
  <para style="q1" vid="EZK 27:25">Abbaayyatixxe oddo'n</para>
  <para style="q2" vid="EZK 27:25">a'urtaxxi ba'o ate'n wo'mitemman.<verse eid="EZK 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="EZK 27:26" />Atixxa lumolla hoboluwwa shafisik oofamakiir</para>
  <para style="q2" vid="EZK 27:26">abbaayyatixxee oddo'n ate'e iyyemarre;</para>
  <para style="q1" vid="EZK 27:26">Borotibaa'n gandammaxxi diidallo kinni</para>
  <para style="q2" vid="EZK 27:26">abbaayyatixxe oddo'n atee enqitaan.<verse eid="EZK 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="EZK 27:27" />Lumoxxe hobol'o'n ba'ne geltaaxxa bara,</para>
  <para style="q2" vid="EZK 27:27">atik qabeenni, atik daddalatik miyuwwi,</para>
  <para style="q1" vid="EZK 27:27">Atixxe lumollamma hoboluwwak shafisaluwwi, giddo ergatamaakiirinna isee qamalchammakiir,</para>
  <para style="q2" vid="EZK 27:27">atixxi dadaltuwwanna atik duuchching loliink manni,</para>
  <para style="q1" vid="EZK 27:27">Hoboloti giddo hedheek duuchchi,</para>
  <para style="q2" vid="EZK 27:27">abbaayaytixxe dhimmo giddi'a linxaan.<verse eid="EZK 27:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="EZK 27:28" />Atixxe lumoxxe hobolo giddo hedhemmak manni raaraa wodda,</para>
  <para style="q2" vid="EZK 27:28">lumoxxe abbaayya qarqarik bogi duuchchi lele'maan.<verse eid="EZK 27:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="EZK 27:29" />Lumolla hoboluwwak oofalluwwi duuchchi,</para>
  <para style="q2" vid="EZK 27:29">oonfammaxxa lumoxxa hobolo waale'e me'inaan;</para>
  <para style="q1" vid="EZK 27:29">Hoboluwatik ajajaluwwinna gargarsanjuwwi duuchchi</para>
  <para style="q2" vid="EZK 27:29">dirrineexxi abbayyati qarqara uurrinaan.<verse eid="EZK 27:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="EZK 27:30" />Insa'ne hafuura gikki assineexxi,</para>
  <para style="q2" vid="EZK 27:30">Umo ifike'n buko fiffilxine'e</para>
  <para style="q1" vid="EZK 27:30">Bululoke'n gangalanta'n</para>
  <para style="q2" vid="EZK 27:30">hiiqqinse ati'a oo'naan.<verse eid="EZK 27:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="EZK 27:31" />Ati'a umo haaxinee</para>
  <para style="q2" vid="EZK 27:31">doonya seemanna oddo'winaan;</para>
  <para style="q1" vid="EZK 27:31">Yo'oshshanna yaandeexxi,</para>
  <para style="q2" vid="EZK 27:31">ati'a hiiqinse oo'naan.<verse eid="EZK 27:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="EZK 27:32" />Ati'a oo'nee boochchisa'n oo'no'a;</para>
  <para style="q2" vid="EZK 27:32">wi'lishina'ninna,</para>
  <para style="q1" vid="EZK 27:32">«Abbaayyate'n liqinseme gateek,</para>
  <para style="q2" vid="EZK 27:32">Xiroosike qachchishsha aate?» hina.<verse eid="EZK 27:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="EZK 27:33" />Atik daddalink miyuwwi abbayyatenaa'ni foofe dagaamma wodda,</para>
  <para style="q2" vid="EZK 27:33">heddo gosa gosaka arda goddisaattan;</para>
  <para style="q1" vid="EZK 27:33">Atike lumoke qabeenninna atike dadalinke miyuwwinni</para>
  <para style="q2" vid="EZK 27:33">buttatka moyanjuwwa duronsitaattan.<verse eid="EZK 27:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="EZK 27:34" />Ta'a kinni dhi'moo abbaayya giddo,</para>
  <para style="q2" vid="EZK 27:34">enqende gateetten;</para>
  <para style="q1" vid="EZK 27:34">Atik feemek miyinna ati'a ergatammaki duuchchi,</para>
  <para style="q2" vid="EZK 27:34">atinninni welti lixe'een.<verse eid="EZK 27:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="EZK 27:35" />Abbaayyatike qarqarike boga'n hedhaneek duuchchi,</para>
  <para style="q2" vid="EZK 27:35">ate'ni kaddeexxe yaanenaa'n kexxeexxa alanne;</para>
  <para style="q1" vid="EZK 27:35">Insa'neki moyanjuwwi culphise;</para>
  <para style="q2" vid="EZK 27:35">alba insa'neeke'ni alayyi egenishe.<verse eid="EZK 27:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="EZK 27:36" />Gosa gosak ardi giddo hexxeexxi daddalto ate'n qacifattaan;</para>
  <para style="q2" vid="EZK 27:36">muuxami atikinna alalshaake kade;</para>
  <para style="q2" vid="EZK 27:36">langaxxa afendabexxo hinaan.› »<verse eid="EZK 27:36" /></para>
  <chapter eid="EZK 27" />
  <chapter number="28" style="c" sid="EZK 28" />
  <para style="p">
    <verse number="1" style="v" sid="EZK 28:1" />Duuchchi Woddike Goottik hiyyichchi higgeen ane'n dageexxi: <verse eid="EZK 28:1" /><verse number="2" style="v" sid="EZK 28:2" />«Koo manjiinke belto Xiroosike galchallo'n, ‹Lumok Duuchchi Woddik Gootti hiyya'nen hitatto qici:</para>
  <para style="q1" vid="EZK 28:2">« ‹Atixxi qalbe hollati,</para>
  <para style="q2" vid="EZK 28:2">«Ani magenoken;</para>
  <para style="q1" vid="EZK 28:2">Mageniinxe moote hana,</para>
  <para style="q2" vid="EZK 28:2">abbaayuwwatixxe oddo'n ofo'lee'ennen» hiteten.</para>
  <para style="q1" vid="EZK 28:2">Fedhee qiconna ifi mageniishsha beekake assite heddotolenna midde</para>
  <para style="q2" vid="EZK 28:2">ati manjoke malee magenokebaan.<verse eid="EZK 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 28:3" />Ati Dani'eeli caalla beekake kadeteichcho ate'n labba'neen;</para>
  <para style="q2" vid="EZK 28:3">atenaa'n mitte yaane sho'endebaashsha heddaaten.<verse eid="EZK 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 28:4" />Beekumi atikenninna ege'na atixxenni,</para>
  <para style="q2" vid="EZK 28:4">qabeenna alfite'eten;</para>
  <para style="q1" vid="EZK 28:4">Worqetanna birret sibljo,</para>
  <para style="q2" vid="EZK 28:4">atike miya massatike minuwwa'n ca'miteten.<verse eid="EZK 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 28:5" />Atixxe daddalatixxe ogexxe bira sa'nenaa'n kexxeexxa</para>
  <para style="q2" vid="EZK 28:5">qabeennage'n qabeenna lephphitete;</para>
  <para style="q1" vid="EZK 28:5">Atike qabeenninna'ninna kexxeexxanna</para>
  <para style="q2" vid="EZK 28:5">holliteeten.<verse eid="EZK 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 28:6" />« ‹Tennexxee Lumok Duuchchi Woddik Gootti hiyya'nee qici,</para>
  <para style="q1" vid="EZK 28:6">« ‹Ani mageniishsha beekaken; hitetexxi</para>
  <para style="q2" vid="EZK 28:6">heddaataxxee,<verse eid="EZK 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 28:7" />Alagiinke mannanaa'n yo'oshsha godoba jabbaka manna,</para>
  <para style="q2" vid="EZK 28:7">ate'n iyyedagonna'aten;</para>
  <para style="q1" vid="EZK 28:7">Insa'nenna atike beekumixxe danchumma wolaantichchike, balleesinaan;</para>
  <para style="q2" vid="EZK 28:7">atika gaachchanna battoossinaan.<verse eid="EZK 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 28:8" />Ateenna bale giddi'a sa'issinaan;</para>
  <para style="q2" vid="EZK 28:8">abbaayyatixxe oddo'n,</para>
  <para style="q2" vid="EZK 28:8">Fuggoxxa reyo rertatton.<verse eid="EZK 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 28:9" />Atee shiyo'a dagaake manni edo,</para>
  <para style="q2" vid="EZK 28:9">«Ani magenoken» hitattota?</para>
  <para style="q1" vid="EZK 28:9">Atee shiyaakeerixxe anga'ni ibbatto wodda,</para>
  <para style="q2" vid="EZK 28:9">ati manjoke malee magenokebaan.<verse eid="EZK 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 28:10" />Alagiinxe anga'n,</para>
  <para style="q2" vid="EZK 28:10">salphitte reyo rertatton;</para>
  <para style="m" vid="EZK 28:10">Tenne haaso'ennek ante Lumoke Duuchchi Woddike Goottan.› »<verse eid="EZK 28:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="EZK 28:11" />Duuchchi Woddike Goottik hiyyichchi higgeen ane'n dageexxi: <verse eid="EZK 28:11" /><verse number="12" style="v" sid="EZK 28:12" />«Koo manjiinke belto Xiroosike moyanji'a boochchisa fulchite hitatto qici: ‹Lumok Duuchchi Woddik Gootti hiyya'neen hitatto qici:</para>
  <para style="q1" vid="EZK 28:12">« ‹Beekumi ate'n wo'meemmake danchummatinna ate'n gunde gugunde'naa</para>
  <para style="q2" vid="EZK 28:12">tenneerinni geyati fakkeennakemma'a.<verse eid="EZK 28:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 28:13" />Duuchchi Woddike Goottike hiddichchuwwiinke fichcha'n</para>
  <para style="q2" vid="EZK 28:13">Edeeni'ni hexxetan;</para>
  <para style="q1" vid="EZK 28:13">Mitte mittingi fiixe'ek kinji atee seese'emman;</para>
  <para style="q2" vid="EZK 28:13">kunni fiixek kinjuwwinna serdiyon, tophaaziyoon, almaaze,</para>
  <para style="q2" vid="EZK 28:13">mergidi, iyasipeedi, senpher,</para>
  <para style="q2" vid="EZK 28:13">beluur, birletinna fiixeek kinji.</para>
  <para style="q1" vid="EZK 28:13">Atixxi seemma konne fiixeke kinnjinni danchoondeexxe worqetixxemma'a;</para>
  <para style="q2" vid="EZK 28:13">dadendeetaxxe barra'naa'n kunnichchuwwi duuchchi ati'a qophpheseme'emman.<verse eid="EZK 28:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 28:14" />Ati heqitotta'a hariirende'etake kirubelimman;</para>
  <para style="q2" vid="EZK 28:14">ani atee tennexxee baalloonse'e'naa;</para>
  <para style="q1" vid="EZK 28:14">Mageniixe woyyitte kooba hana hexxetta'a;</para>
  <para style="q2" vid="EZK 28:14">Giiratishsha xalaqqisa'neexxe kinoxxe oddo'ninna mammarendeeten.<verse eid="EZK 28:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 28:15" />Dadendettexxe barrana'n,</para>
  <para style="q2" vid="EZK 28:15">fuggoxxi ate'n afendee qico'n,</para>
  <para style="q2" vid="EZK 28:15">me'injo atike'n balleessa belo hexxaattan.<verse eid="EZK 28:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZK 28:16" />Daddaliinxi atixxi huje ba'lateemmaxxe,</para>
  <para style="q2" vid="EZK 28:16">xaqaro ate'n wo'mite;</para>
  <para style="q2" vid="EZK 28:16">cubbotanna hujjeten;</para>
  <para style="q1" vid="EZK 28:16">Tennexxee Mageniinxe koobanaa'n battitte yaaneshsha atee hunenne;</para>
  <para style="q2" vid="EZK 28:16">koo iimike heqqanjo kuruubi, giiratishsha hexxeexxe, kinoxxe,</para>
  <para style="q2" vid="EZK 28:16">oddonaa'n atee fulcheenne.<verse eid="EZK 28:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZK 28:17" />Atixxe danchummaxxee,</para>
  <para style="q2" vid="EZK 28:17">qalbe giddo hollitette;</para>
  <para style="q1" vid="EZK 28:17">Ulfinna halsatena'inna kexxeexxa,</para>
  <para style="q2" vid="EZK 28:17">beekuma atika balleessexxette.</para>
  <para style="q1" vid="EZK 28:17">Tennexxee atee butti'a darbenne;</para>
  <para style="q2" vid="EZK 28:17">moyanjuwwikinna atee da'wataashsha assennen.<verse eid="EZK 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZK 28:18" />Cubbo atixxe birra sa'nenninna daddalak addatensha gophiyyo atixxenni,</para>
  <para style="q2" vid="EZK 28:18">magenoffachchotixxa atixxa bakkuwwa battoossitette.</para>
  <para style="q1" vid="EZK 28:18">Tennexxee giira atenaa'n fuldaashsha assenne;</para>
  <para style="q2" vid="EZK 28:18">isenna atee itte;</para>
  <para style="q1" vid="EZK 28:18">Atee daa'wata'neeke duuchchi edo,</para>
  <para style="q2" vid="EZK 28:18">buttate'n atee bululoke assenne.<verse eid="EZK 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="EZK 28:19" />Ate ege'neke gosa gosaka arda duuchchi,</para>
  <para style="q2" vid="EZK 28:19">ate'n gelteexxe yaanexxee qexxerri hiyye;</para>
  <para style="q1" vid="EZK 28:19">Atk muuxxaminna alalshaake kade;</para>
  <para style="q2" vid="EZK 28:19">konnechchinni edi'a hexxabexxon.› »<verse eid="EZK 28:19" /></para>
  <para style="s1">Siidoonni'n Kulndeexxa Wabeekuma</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 28:20" />Duuchchi Woddike Goottiki hiyychchi aniba dageexxi:<note caller="-" style="x"><char style="xo" closed="false">28:20 </char><char style="xt" closed="false"><ref loc="JOL 3:4-8">Iyu. 3:4-8</ref>; <ref loc="ZEC 9:1-2">Zek. 9:1-2</ref>; <ref loc="MAT 11:21-22">Mat. 11:21-22</ref>; <ref loc="LUK 10:13-14">Luq. 10:13-14</ref>.</char></note> <verse eid="EZK 28:20" /><verse number="21" style="v" sid="EZK 28:21" />«Koo manjiinke belto Sidooniba'a alba wirri assi; raagakanna ise'ni raagi <verse eid="EZK 28:21" /><verse number="22" style="v" sid="EZK 28:22" />hitatto qici: ‹Dada Duuchchik Duuchchi Woddiki Gootti hiyya'neen hitatto qici:</para>
  <para style="q1" vid="EZK 28:22">« ‹Tee Sidooni, ate'n ke'eennen,</para>
  <para style="q2" vid="EZK 28:22">ati giddonna ulfaatannon;</para>
  <para style="q1" vid="EZK 28:22">Murte anxa ise'n muranno woddanna,</para>
  <para style="q2" vid="EZK 28:22">Woyyumma anxanna ise giddo leellishanno wodda,</para>
  <para style="q2" vid="EZK 28:22">ani Duuchchi Woddike Gootta kadennexxa egennaan.<verse eid="EZK 28:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="EZK 28:23" />Sidoona'ninna bala anxa ibisannon;</para>
  <para style="q2" vid="EZK 28:23">iseke ora duuchcha'n munde dundaashsha assannon;</para>
  <para style="q1" vid="EZK 28:23">Duuchinni darrenaa'n ke'aake bagedinni</para>
  <para style="q2" vid="EZK 28:23">gora'eemmekiir ise giddo ibaan;</para>
  <para style="q1" vid="EZK 28:23">Ookkoneechchi uduma ani Duuchchi Woddike Gootta kade'ennexxa egennaan.<verse eid="EZK 28:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 28:24" />« ‹Ta'anni elqi'a Isira'eeliki ardi insa'nee utetishshanna hagaliinsha rakkisaaka olla'a anfabaan. Ookkoneechchi uduma ani Lumoke Duuchchi Woddike Gootta kade'ennexxa egennaan.<verse eid="EZK 28:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 28:25" />« ‹Lumok Duuchchi Woddik Goottinna Isira'eelika arda xerememmake boguwwi giddii'n bukki assanno wodda gosa gosak ardi uuda'naan woyyumma anxa insa'ne giddo leellishannon. Ookkoneechchi uduma insa'ne ifike boga'n; ani erganjo anke Ya'iqoobi'a uwwennake he'naan. <verse eid="EZK 28:25" /><verse number="26" style="v" sid="EZK 28:26" />Insa'nenna ookko nage'ik he'naan; minuwwakanna ijaadhinaan; woyinetika hiddichchonna kalsinaan. Insa'nee tuffatammaka insa'neka olla'uwwa duuchcha xixanno wodda insa'ne nage'ik he'naan. Ookkoneechchi uduma ani Duuchchi Woddike Gootta insa'neke Mageno kadennexxa egennaan.› »<verse eid="EZK 28:26" /></para>
  <chapter eid="EZK 28" />
  <chapter number="29" style="c" sid="EZK 29" />
  <para style="s1">Gibtsee'n Kulndeexxa Wabeekuma</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 29:1" />Booji'emmennexxe tommixxe wogga'n, tommeessoke agenjo'n, tommenna langaxxe barra'n Duuchchi Woddike Goottik hiyyichchi aniba dage hiyyee qici:<note caller="-" style="x"><char style="xo" closed="false">29:1—32:32 </char><char style="xt" closed="false"><ref loc="ISA 19:1-25">Isa. 19:1-25</ref>; <ref loc="JER 46:2-26">Erm. 46:2-26</ref>. </char></note> <verse eid="EZK 29:1" /><verse number="2" style="v" sid="EZK 29:2" />«Koo manjiinke belto Gibtseeke moyanjo Feri'ooniba'a alba wirri hiyyi,</para>
  <para style="q2" vid="EZK 29:2">iso'ninna Gibtseke arda duuchcha'n raaga raagi. <verse eid="EZK 29:2" /><verse number="3" style="v" sid="EZK 29:3" />Dada Duuchchik Duuchchi Woddik Gootti Gibtseeke moyanji'a hiyya'neen hitatto qici:</para>
  <para style="q1" vid="EZK 29:3">« ‹Atike galaanike yaasumuwwixxe oddo'n ciisseetteke galaanike</para>
  <para style="q2" vid="EZK 29:3">lumoke biniinchaa Gibtseke moyanjo koo Feri'ooni ate'n ke'eennen;</para>
  <para style="q1" vid="EZK 29:3">«Abbayik galaan anken;</para>
  <para style="q2" vid="EZK 29:3">ifi'aana hucceenen» hitaatten.<verse eid="EZK 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 29:4" />Yaane kinn qeqqeshsha atike'n fixa uggannon;</para>
  <para style="q2" vid="EZK 29:4">galaaninka yaasumuwwa atikixxa qulxu'muwwanna atike biso'n mexxi assannon;</para>
  <para style="q1" vid="EZK 29:4">Atike bisike hommorrichcha goga'n mexxi assenexxe quluxu'muwwa duuchchin welti</para>
  <para style="q2" vid="EZK 29:4">atike galaanike yaasumuwwi giddi'n atee harkise fulchannon.<verse eid="EZK 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 29:5" />Ateenna atike galaanike yaasumuwwixxa quluxu'muwwa duuchcha,</para>
  <para style="q2" vid="EZK 29:5">qiila gammooje'n hunannon;</para>
  <para style="q1" vid="EZK 29:5">Atinna diidake'n ibbatton;</para>
  <para style="q2" vid="EZK 29:5">Ate'e bukki assaak, ke'isaakinna hedheba'a.</para>
  <para style="q1" vid="EZK 29:5">Biniichchuwakeenna ci'uwatee</para>
  <para style="q2" vid="EZK 29:5">itate kaddatoshsha ate uwwannon.<verse eid="EZK 29:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="EZK 29:6" />Ookkoneechchi uduma Gibtsee hedheek duuchchi</para>
  <para style="q2" vid="EZK 29:6">ani Duuchchi Woddike Gootta kadeeneexxa ege'naan.</para>
  <para style="b" vid="EZK 29:6" />
  <para style="p" vid="EZK 29:6">« ‹Ha'no Isira'eelike ardi'a woyi fuldabaaxxe shonbooqiinxe siqqichcho kaddine'een.<note caller="-" style="x"><char style="xo" closed="false">29:6 </char><char style="xt" closed="false"><ref loc="ISA 36:6">Isa. 36:6</ref>.</char></note> <verse eid="EZK 29:6" /><verse number="7" style="v" sid="EZK 29:7" />Anga ifixxen atee abindee wodda, qosho'mi hitee boba insa'nexxa otteten; ate'n irkantee woddanna qurubi hitee dudduro insa'neke duuchchinni miciremmaashsha assitette.<verse eid="EZK 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 29:8" />« ‹Tennexxee lumok Duuchchi Woddik Gootti hiyya'nee qici: bagedo ate'n idagannon; manjo atikanna horuwwa insa'neka birannon. <verse eid="EZK 29:8" /><verse number="9" style="v" sid="EZK 29:9" />Gibtseek bogi urummakenna olete kadaan;</para>
  <para style="q2" vid="EZK 29:9">ookkoneechchi uduma ani Duuchchi Woddike Gootta kadeennexxanna egenaan.</para>
  <para style="p" vid="EZK 29:9">« ‹Tinninna kaddaachchi isi hiyyee qici, «Abbayik galaan anken; ante isoo giisennen,» hitee'etten. <verse eid="EZK 29:9" /><verse number="10" style="v" sid="EZK 29:10" />Tennexxe kunse ani ate'ninna atike galanike yaasumuwwa'n mufeti ke'enne; Gibtseeka boganna Migidooli'n Asiwaan qico'n ookko'ninna Tophiyiinxe gabala qico'n haranga oletanna urumake assannon. <verse eid="EZK 29:10" /><verse number="11" style="v" sid="EZK 29:11" />Lekka manjiinxi yookaan hori ise giddii'n sa'abaan; shoole tomme wogga qico'n ayyinna ise giddo hedhabaan. <verse eid="EZK 29:11" /><verse number="12" style="v" sid="EZK 29:12" />Urmmemake boguwwishsha Gibtseeka boga urumake assannon; diigememmake wele qachchuwwishsha isek qachchuwwi shoole tomme wogga olete kadaan. Aninna Gibtseka manna gosa gosake ardi giddo xeerannon; boga boga'ninna insa'ne xeelagannon.<verse eid="EZK 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 29:13" />« ‹Dada Duuchchik Duuchchi Woddik Gootti hiyya'nee qici: shoole tomme wogga uduma Gibtseeka manna xeeremeke gosa gosake ardi giddii'n bukki assannon. <verse eid="EZK 29:13" /><verse number="14" style="v" sid="EZK 29:14" />Booji'otenaa'n insa'nee illeema hissennexxi hundaayye ifixxike boga'n Phaxxiroosi insa'nee iyyedagannon. Ookkonna insa'nee salphatexxe mootumma kandaan. <verse eid="EZK 29:14" /><verse number="15" style="v" sid="EZK 29:15" />Wele Mootumuwwa duuchchanaa'n caala salphateexxe kaddaan; ta'anni edi'a wele gosa gosake ardi caala ifi lumisaba'a. Wele gosa gosake arda'n haranga langaxxa mootabaashsha. Ani isee hara gophaaletette assannon. <verse eid="EZK 29:15" /><verse number="16" style="v" sid="EZK 29:16" />Isira'eelik ardi gargarsa halsa Gibtse mare wodda isee insa'ne'n assitemmaxxa balleessa qalli hiyyaa malee ta'inn edi'a Isira'elik ardi Gibtse addatabaan. Ookkonechchi uduma ani Duuchchi Woddike Gootta kadeneexa egennaan.› »<verse eid="EZK 29:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 29:17" />Boji'emennexxe lame tommenna torbeesoxxe wogga'n taakesoke agenjixxe siretixxe barra'n Duuchchi Woddike Goottik hiyyichchi ane'n dage hiyyee qici: <verse eid="EZK 29:17" /><verse number="18" style="v" sid="EZK 29:18" />«Koo manjiinke belto Baabiloonik moyanji Naabukadanatsoor Xiroosi'i lolatee umi insa'nek luqa'eexxi dugumo insa'nexxi madoota qico'n ifike loliinke manna'n a'uraaka miya ba'isseen. Kaddo male'e moyanjikinna kaddi isiki sannachchi tenne duuchchanaa'n alfineexxi la'o hexxeba'a. <verse eid="EZK 29:18" /><verse number="19" style="v" sid="EZK 29:19" />Tennexxee Dada Duuchchik Duuchchi Woddik Gootti hiyya'nee qici: Kunse ani Gibtseeke boga'n Baabiloonike moyanjo Naabukadanatsoorixxe anga'n sa'isse uwwe'na'a isinna ifike loliinke manni'a rundiinshsha uwwo'a Gibtsee bogika qabeena booji'e adhdhaan. <verse eid="EZK 29:19" /><verse number="20" style="v" sid="EZK 29:20" />Isinna isik loliink manni ani'a ergatememmaxxee isike eloke hiri'a Gibtsee isi'a uwwe'ennen; tenne haaso'ennek ante lumoke Duuchchi Woddike Goottan.<verse eid="EZK 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 29:21" />«Eettene barra Isira'eelike mannixxa hunna jabeesannon; koo Hiziqeel insa'nexxe oddo'n afo'o wo'mite haasotattoshsha assannon; ookkoneechchi uduma ani Duuchchi Woddike Gootta kade'ennexxa egenaan.»<verse eid="EZK 29:21" /></para>
  <chapter eid="EZK 29" />
  <chapter number="30" style="c" sid="EZK 30" />
  <para style="s1">Gibtsexxee Fuleeka Boochchisa</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 30:1" />Duuchchi Woddike Goottik hiyyichchi aniba dage hiyyee qici: <verse eid="EZK 30:1" /><verse number="2" style="v" sid="EZK 30:2" />«Koo manjiinke belto hita'n raaga raagatto qici: Lumok Duuchchi Woddik Gootti hiyya'nee qici:</para>
  <para style="q1" vid="EZK 30:2">« ‹Woo woo! Hiyyi, hitatto qici,</para>
  <para style="q2" vid="EZK 30:2">«Aanne eettene barra'a!»<verse eid="EZK 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 30:3" />Barra shiqqe'een,</para>
  <para style="q2" vid="EZK 30:3">Duuchchi Woddike Goottixxi barra shiqoten</para>
  <para style="q1" vid="EZK 30:3">Iitti duumanchiinxi barra gosa gosake ardi'a ba'netixxe yannan.<verse eid="EZK 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 30:4" />Gibtsee'n bagedi dagaan;</para>
  <para style="q2" vid="EZK 30:4">Tophiyikinna weekemaan.</para>
  <para style="q1" vid="EZK 30:4">Manni Gibtsee giddo shiyemaa wodda</para>
  <para style="q2" vid="EZK 30:4">qabeenni isekinna adhdhema;</para>
  <para style="q2" vid="EZK 30:4">booso isexxinna digendaan.<verse eid="EZK 30:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="EZK 30:5" />Tophiyikinna Fuuxxi, Lidiyaanna Arabi'a duuchcha, Libiyaanna kakotike bogik ardi Gibtsenni welti mitteba bagedoke'n mundaan.<verse eid="EZK 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 30:6" />« ‹Duuchchi Woddik Gootti hiyya'nee qici:</para>
  <para style="q1" vid="EZK 30:6">« ‹Gibtsee kiphammakiir mudaan.</para>
  <para style="q2" vid="EZK 30:6">Isee hollissaammaxxi isexxi hunna gopha'n daggan.</para>
  <para style="q1" vid="EZK 30:6">Migidoolii'n Asiwaani qico'n</para>
  <para style="q2" vid="EZK 30:6">ise giddo manni shiyemaan;</para>
  <para style="q4" vid="EZK 30:6">tenne haaso'eek Lumoke Duuchchi Woddike Goottan.<verse eid="EZK 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 30:7" />« ‹Gibtsek urumi boguwwi</para>
  <para style="q2" vid="EZK 30:7">caala urmake kadaan;</para>
  <para style="q1" vid="EZK 30:7">Qachchuwwi isekinna,</para>
  <para style="q2" vid="EZK 30:7">findigememmake qachchuwwishsha findigemaan.<verse eid="EZK 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 30:8" />Ookkoneechchi uduma insa'ne Gibtsee'ni giira ha'ishanno wodda,</para>
  <para style="q2" vid="EZK 30:8">isee gargarammak duuchchi hunna enqema,</para>
  <para style="q2" vid="EZK 30:8">eettenne yanna ani Duuchchi Woddike Gootta kadennexxa egenaan.<verse eid="EZK 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 30:9" />« ‹Eettene barra anki erganjuwwi lumoxxe hobolonni marreexxi soda'a belo hedheeka Tophiiyaa sodaachchisaan. Gibtsee'a dukkanate kaddaaxxa barra Tophiyi wixixxi hiyyaa; iitti barra daggaaxxi kokaken.<verse eid="EZK 30:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="EZK 30:10" />« ‹Dada Duuchchak Duuchchi Woddik Gootti hiyya'nee qici:</para>
  <para style="q1" vid="EZK 30:10">« ‹Baabiloonike moyanjo Naabukadanatsoorxe anganni,</para>
  <para style="q2" vid="EZK 30:10">laakkossi bira sa'eeka Gibtseeka arda birannon.<verse eid="EZK 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 30:11" />Gosa gosake ardi duuchchanaa'n hara godoba jabake kande'eek Nabukanatsoorinna isik loliink manni</para>
  <para style="q2" vid="EZK 30:11">boga balleessatee dangaashsha assannon;</para>
  <para style="q1" vid="EZK 30:11">Wolaantichcha insa'nenna Gibtsee'n gorshe'naan</para>
  <para style="q2" vid="EZK 30:11">bogake'n renshi wo'mashsha assina.<verse eid="EZK 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 30:12" />Aninna abbayike gaalanika yaasumuwwa bassennexxi;</para>
  <para style="q2" vid="EZK 30:12">bogakanna fuggaaleeyye mannixxe anga'n sa'isannon;</para>
  <para style="q1" vid="EZK 30:12">Alagiinxe anganni,</para>
  <para style="q2" vid="EZK 30:12">ise giddo hedheechcho duuchcha birennexxi boga urmake assannon;</para>
  <para style="m" vid="EZK 30:12">Ani Duuchchi Woddik Gootti tennee haaso'ennen.<verse eid="EZK 30:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="EZK 30:13" />« ‹Dada Duuchchik Duuchchi Woddik Gootti hiyya'nee qici:</para>
  <para style="q1" vid="EZK 30:13">« ‹Fakkuwwa balleesannon;</para>
  <para style="q2" vid="EZK 30:13">Memifsite hexxeexxa misluwwanna hexxemmabaashsha assannon.</para>
  <para style="q1" vid="EZK 30:13">Ta'anni edi'a Gibtsee galchaak hedhaba'a;</para>
  <para style="q2" vid="EZK 30:13">bogake'ninna soda'a ibisannon.<verse eid="EZK 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 30:14" />Phaxxiroosi'i urmake assannon;</para>
  <para style="q2" vid="EZK 30:14">Xaaniwoosi'ni giira ha'ishannon;</para>
  <para style="q2" vid="EZK 30:14">Teebisiinna xixannon.<verse eid="EZK 30:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZK 30:15" />Gibtsee kollifachcho kadde'eeke</para>
  <para style="q2" vid="EZK 30:15">Siinike qachcha mufe anxenni ganannon;</para>
  <para style="q2" vid="EZK 30:15">Laakkossi bira sa'eka Teebisika arda birannon.<verse eid="EZK 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZK 30:16" />Gibtsee'n giira ha'ishannon;</para>
  <para style="q2" vid="EZK 30:16">Siinik qachchinna wixixxi hiyya;</para>
  <para style="q1" vid="EZK 30:16">Teebisike qachchik dalla'i digemaan;</para>
  <para style="q2" vid="EZK 30:16">Memifisike qachcha'n urritabaaxxe wixxixxi geltaan.<verse eid="EZK 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZK 30:17" />Heliyootuke qachchixxinna Bubaasitukixxi dargageeyye,</para>
  <para style="q2" vid="EZK 30:17">bagedoke'n muddaani;</para>
  <para style="q2" vid="EZK 30:17">konne qachchuwwik manninna booji'eme adhdhemaan.<verse eid="EZK 30:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZK 30:18" />Gibtseexxe galcha gatisannoxxa yanna</para>
  <para style="q2" vid="EZK 30:18">Xaafinaasike qachcha'n barrandi haashshate kadda;</para>
  <para style="q2" vid="EZK 30:18">ookkonechchi uduma ise hollisammaxxi isexxi hunna baxxaan.</para>
  <para style="q1" vid="EZK 30:18">Duumanchikinna isee buqaan;</para>
  <para style="q2" vid="EZK 30:18">iseke qarqarik olla'uwwi booje'eme adhdhemaan.<verse eid="EZK 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="EZK 30:19" />Konne qicinni ani Gibtsee xixannon;</para>
  <para style="q2" vid="EZK 30:19">insa'nenna ani Lumoke Duuchchi Woddike Gootta kadennexxa egenaan.› »<verse eid="EZK 30:19" /></para>
  <para style="s1">Fari'onixxi Hirre Enqende</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 30:20" />Boji'emmennexxe tommenna mittixxe woga'n, siretike agenjixxe torbeesooxxe barra'n, Duuchchi Woddike Goottiki hiyyichchi higgeen ane'ni dageexxi, <verse eid="EZK 30:20" /><verse number="21" style="v" sid="EZK 30:21" />«Koo manjiinke belto, Gibtseeke moyanjo Feri'oonixxa hiirre enqeenneni; fayyito'anna ayyinna isee usueraba'a; jabate bagedo abidashshanna leemmik xaasseendeba'a. <verse eid="EZK 30:21" /><verse number="22" style="v" sid="EZK 30:22" />Tennexxee Dada Duuchchik Duuchchi Woddiki Gootti hiyya'nee qici: Gibtseeke moyanjo Feri'ooni'ni ke'ene; fayya hexxemmaxxanna enqendemmaxxa isixxa laminxa hirre enqannexxi bagedikinna anga isixenaa'n ibaashsha assannon. <verse eid="EZK 30:22" /><verse number="23" style="v" sid="EZK 30:23" />Aninna Gibtseeka arda gosa gosake ardi giddo xeelagannon; boga boga'nini insa'ne xeerannon. <verse eid="EZK 30:23" /><verse number="24" style="v" sid="EZK 30:24" />Babilonke moyanjixxa hirre jabeesannoni; bagedo ankanna abixxaashsha assanno; Feri'oonixxa hirre enqena'a isi fuggo mado'eke manjishsha Baabiloonike moyanji edo o'aan. <verse eid="EZK 30:24" /><verse number="25" style="v" sid="EZK 30:25" />Baabiloonike moyanjixxa hirre jabeesannoni; Feri'oonixxa hirre kinni gophisannon; bagedo anka Babiloonik moyanji abixxashsha asse'naa isinna Feri'ooni'i Gibtseeka moyanjo Gibtseeke boga'n lolaa wodda, insa'nenna ookkone wodda ani Duuchchi Woddike Gootta kadennexxa egenaan. <verse eid="EZK 30:25" /><verse number="26" style="v" sid="EZK 30:26" />Aninna Gibtseeka arda gosa gosake ardi giddo xeelaganno; boga boga'ninni insa'ne xeeranno; ookonechchi uduma ani Duuchchi Woddike Gootta kadennexxa egenaan.»<verse eid="EZK 30:26" /></para>
  <chapter eid="EZK 30" />
  <chapter number="31" style="c" sid="EZK 31" />
  <para style="s1">Gibtse Qilxiink Haqichcho'ni Fakkeesendeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 31:1" />Booji'emmennexxe tommenna mittixxe woga'n, sakaake agenjo'n, taakeesooxxe barra'n Duuchchi Woddike Goottiki hiyyichchi ane'n dageexxi hiyyee qici: <verse eid="EZK 31:1" /><verse number="2" style="v" sid="EZK 31:2" />«Koo manjiinke belto Gibtseeke moyanjo Feri'ooni'ninna lakkoossa bira sa'eke isike arda'n hitatto qici:</para>
  <para style="q1" vid="EZK 31:2">« ‹Luminnik atinni qixxo'aak ayyete?<verse eid="EZK 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 31:3" />Asoori uudi ise damuwwa isixxinna gongomakee gaddisa kadeeka elolamma damuwwa afeeke,</para>
  <para style="q2" vid="EZK 31:3">yo'oshsha qeerredhdheke,</para>
  <para style="q1" vid="EZK 31:3">Qacce isixxik qeerrinni iima geyyeke</para>
  <para style="q2" vid="EZK 31:3">Libaanoosike birbirisishaten.<verse eid="EZK 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 31:4" />Woddiiknna isoo nosseen;</para>
  <para style="q2" vid="EZK 31:4">dhi'mo muumuwwanna isoo nossite;</para>
  <para style="q1" vid="EZK 31:4">Wode'uwwikinna yaa'e;</para>
  <para style="q2" vid="EZK 31:4">hiddichchuwwa isikika qarqara duuchcha lashshi assine</para>
  <para style="q1" vid="EZK 31:4">Diidake'ni hedheke haqichchi duuchchibaa</para>
  <para style="q2" vid="EZK 31:4">wodi'uwwi yaa'asha assine ha'wissa'nemman.<verse eid="EZK 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 31:5" />Tennexxee gongomi giddo hedheeke haqqichchuwwa duuchchanaa'n</para>
  <para style="q2" vid="EZK 31:5">yo'oshsha hojjati qeerredhe;</para>
  <para style="q1" vid="EZK 31:5">Dammolee isixxinna qeerexxe; bira saxxe;</para>
  <para style="q2" vid="EZK 31:5">woddiinxe bira sa'nenaa'n kexxexxanna furdatte; shanande.<verse eid="EZK 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 31:6" />Ci'a duuchchi</para>
  <para style="q2" vid="EZK 31:6">damuwwate'ni mine ijaadhite;</para>
  <para style="q1" vid="EZK 31:6">Biniichchuwwi duuchchi;</para>
  <para style="q2" vid="EZK 31:6">damuwwati hunda beltanuwwa ile</para>
  <para style="q1" vid="EZK 31:6">Lumollama gosa gosak ardi duuchchi</para>
  <para style="q2" vid="EZK 31:6">konne haqichchike gaaddisi hunda hedha'nemaani.<verse eid="EZK 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 31:7" />Barqaaqeexxe damuwwanni welti,</para>
  <para style="q2" vid="EZK 31:7">danchumma eloxxemman;</para>
  <para style="q1" vid="EZK 31:7">Heddi wodi'i hedheebaa</para>
  <para style="q2" vid="EZK 31:7">hiddi isik giddi'a yaa'eemman bayyateman.<verse eid="EZK 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 31:8" />Magenike hiddichchuwwinxe bakka'n hedhdheek birbirsuwwi</para>
  <para style="q2" vid="EZK 31:8">konne birbirsini morka dandenabaan;</para>
  <para style="q1" vid="EZK 31:8">Hi'neesiink haqichchuwwi,</para>
  <para style="q2" vid="EZK 31:8">insa'nexxi damuwwa weli qixxotabaan</para>
  <para style="q1" vid="EZK 31:8">Asinate hiyyemaake haqichchixxi damuwwa</para>
  <para style="q2" vid="EZK 31:8">isixxe damuwwanni qixxootebaan;</para>
  <para style="q1" vid="EZK 31:8">Magenixxe hiddichchuwwiinxe bakka'n hedheek haqichchuwwi duuchchi</para>
  <para style="q2" vid="EZK 31:8">danchummati konne birbisishsha hedhemmak hedhebaan.<note caller="-" style="x"><char style="xo" closed="false">31:8 </char><char style="xt" closed="false"><ref loc="GEN 2:9">Dada. 2:9</ref>. </char></note><verse eid="EZK 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 31:9" />Heddo damuwwa;</para>
  <para style="q2" vid="EZK 31:9">eldashsha asse hujennen;</para>
  <para style="q1" vid="EZK 31:9">Magenike hiddichchuwwinke boncho'n</para>
  <para style="q2" vid="EZK 31:9">Gannatete'n hedheek haqqichchuwwi duuchchi isoo hinaafe.<verse eid="EZK 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 31:10" />« ‹Tennexxee Duuchchi Woddik Goottinna hojja qeerredhe iima geyyiyyotinna qace isixxi iima duumanchake'n xalli hiyyot hollemmaxxee, <verse eid="EZK 31:10" /><verse number="11" style="v" sid="EZK 31:11" />fuggoxxe huje isixishshanni hujetika hira adda isi'a uwo'a, gosa gosake ardike galchallixxe anga'n isoo sa'isse uwwennen. Aninna isoo gibeennen. <verse eid="EZK 31:11" /><verse number="12" style="v" sid="EZK 31:12" />Gosa gosake ardik yo'oshsha godoba jabaki galchalli isoo karee ibise; koobuwwate'ninna dhooquwwa duuchcha'n damuwwa isixxi ibe; iittanni wele isixxi damuwwanna ookkone bogike wode'uwwa duuchcha'n ibbe buttutte. Buttatik gosa gosak ardi duuchchi konne birbirisike gaaddisi hunda hedhemmaba waale me'e. <verse eid="EZK 31:12" /><verse number="13" style="v" sid="EZK 31:13" />Ci'a duuchcha ookkone ibemmake haqichcho'n galdeemman; biniinchuwwi duuchchinna isixxe damuwwa hana hedhemman. <verse eid="EZK 31:13" /><verse number="14" style="v" sid="EZK 31:14" />Tennexxee wodi'i qaraqara hedheek huuni haqichchi ifixxe hojjake qeerrinne'n hollabashsha, qace ififixxanna iima dumanchuwwi giddo gessisabaashsha; ta'anni edi'anna wele wode'e geeya qico'n ha'wisemeeke haqichchuwwi konne qeerrine qeerredhabaashsha, duchching reyeexxi buttinii hundike wiida'n sa'ammake manninni afemo'a murte iso'n murende'een.»<verse eid="EZK 31:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 31:15" />« ‹Lumok Duuchchi Woddik Gootti hiyya'nee qici: Iikki haqichchi karemeexxi buttini hundike wiida'n sa'eexxa yanna isixxe dhi'motixxe muummuwwa'n yaaddo wonshenne; muummuwwatiki wode'uwwinna ya'abaashsha uurrise'na'a henobaak wodi'i ya'ebaangi gate; isixxe buuto'a Libaanoosi dukkansenne; gongomiink haqichchuwwi duuchchinna bage. <verse eid="EZK 31:15" /><verse number="16" style="v" sid="EZK 31:16" />Reyeexxi buttinii hundike wiida'n sa'ammake manjishsha buttinii hunda sa'ashsha assennaxxa yanna isixxe ibake luuljonaa'n kexxeexxa gosa gosak ardi culphise; Ookkonechchi uduma Edeenike hiddichchuwwixxe bakkaki haqichchuwwi duuchchinna, hedheen hiyyemaakinna elolammi Libaanoosik haqichchuwwi, wode'e geyaa qico'n ha'wisemeek haqichchuwwi duuchchi, hedhemmaba buttinii hunda dayyefante. <verse eid="EZK 31:16" /><verse number="17" style="v" sid="EZK 31:17" />Gosa gosake ardi giddii'n isoo gargaremmakinna gaaddisi isik hunda galemmakiir, bagedik shiyemmakeerinni afemo'a isinni welti buttinii hunda wiiddake'n sa'edheen.<verse eid="EZK 31:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 31:18" />« ‹Edeenike hiddichchuwwinke haqichchuwanaa'n danchummatinna lumminniki isenni qixxo'ak hoonte? Kaddo malee atinna iittanni Edenike hiddichchuwinke haqichuwwinni welti buttinnii hunda wiidake'n saxxatton; bagedik shiyememmake jila offo'lemmabakeerinni irkatota'a wiidda hundike'n ssaxxatton.</para>
  <para style="p" vid="EZK 31:18">« ‹Feri'ooni'ninna isike laakkossi bira sa'eeke loliinke manna'n daggaaxxi yaane tenneten, hiyya'ne Lumok Duuchchi Woddik Gootti.› »<verse eid="EZK 31:18" /></para>
  <chapter eid="EZK 31" />
  <chapter number="32" style="c" sid="EZK 32" />
  <para style="s1">Gibtsek Moyanji Lumooxxe Abbaayya Giddike Biniinchinni Fakkeesema</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 32:1" />Boji'emmennexxe tommeenna langaxxe wogga'n, tommenna langake agenjixxe siretixxe barra'n Duuchchi Woddike Goottik hiyyichchi anibaa dagee hiyyee qici: <verse eid="EZK 32:1" /><verse number="2" style="v" sid="EZK 32:2" />«Koo manjiinke belto Gibtseeke moyanjo Fari'ooni'a boochchisa boochchise iso'ni hitatto qici;</para>
  <para style="q1" vid="EZK 32:2">« ‹Ati gosa gosake ardixxe oddo'n ifi Neenqinsha uuddete;</para>
  <para style="q2" vid="EZK 32:2">yaane kinni ati lumoolla abbaayyuwwa giddo burraqa'n sodaachchiisammake galaani giddike lumoke biniichchishshaten;</para>
  <para style="q1" vid="EZK 32:2">Gaalanuwwi atiki giddo ga'nitaatek;</para>
  <para style="q2" vid="EZK 32:2">wode'e leekkati ga'nitaatek;</para>
  <para style="q2" vid="EZK 32:2">muummuwwa booreesitete.<verse eid="EZK 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 32:3" />« ‹Lumoki Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="EZK 32:3">« ‹Ani heddo arda bukki asse;</para>
  <para style="q2" vid="EZK 32:3">marabe anxa ate'n darbannon;</para>
  <para style="q2" vid="EZK 32:3">insa'nenna anxe marabenni atee harkinsee fulchchinaan.<verse eid="EZK 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 32:4" />Buttinake'n atee ibisannoni;</para>
  <para style="q2" vid="EZK 32:4">diidake'ninna atee fanxaraarisannon;</para>
  <para style="q1" vid="EZK 32:4">Allaattuwwa duuchchi ate'n bukki hitaashsha assannoni;</para>
  <para style="q2" vid="EZK 32:4">bininchchuwwi duuchchi atee'e ninnifee itaan.<verse eid="EZK 32:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 32:5" />Maala atika koobuwwate'n xexxerannoni;</para>
  <para style="q2" vid="EZK 32:5">gatemmakanna dhooquwwate'n wonshannon.<verse eid="EZK 32:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 32:6" />Koobati qico'ni heheeke ora duuchcha'ni</para>
  <para style="q2" vid="EZK 32:6">duneda'neexxe atixxe mundeni ookkone boga lashshi assiteten;</para>
  <para style="q2" vid="EZK 32:6">dhooqate'ninna wo'mitaan.<verse eid="EZK 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 32:7" />Ani ate'e bakka atixxa balleessanno wodda iimuwwa buqannon;</para>
  <para style="q2" vid="EZK 32:7">urijuwwatinna iffabaashsha assannon;</para>
  <para style="q1" vid="EZK 32:7">Arishshotanna duumanchchik buqannoni;</para>
  <para style="q2" vid="EZK 32:7">agenjikinna iffa ifisabaan.<note caller="-" style="x"><char style="xo" closed="false">32:7 </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isa. 13:10</ref>; <ref loc="MAT 24:29">Mat. 24:29</ref>; <ref loc="MRK 13:24-25">Mar. 13:24-25</ref>; <ref loc="LUK 21:25">Luq. 21:25</ref>. </char></note><verse eid="EZK 32:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="EZK 32:8" />Imate'n ifaaka iffuwwa duuchcha,</para>
  <para style="q2" vid="EZK 32:8">ate'n dukkanaashsha asannoni;</para>
  <para style="q2" vid="EZK 32:8">boga atike'n dukkanna dukandaashsha asannoni;</para>
  <para style="q2" vid="EZK 32:8">hiyya'neeni Lumooki Duuchchi Woddiki Gootti.<verse eid="EZK 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 32:9" />Egendeboxxoke boga'n</para>
  <para style="q2" vid="EZK 32:9">gosa gosake ardixxe oddo'n ba'ne ate'n geessisanno wodda,</para>
  <para style="q2" vid="EZK 32:9">heddi ardik godobi raafemaan.<verse eid="EZK 32:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 32:10" />Heddi ardi ate'n geltaaxxe ba'nenaa'n kexxeexxa</para>
  <para style="q2" vid="EZK 32:10">alanne qexeri hinaashsha asannoni;</para>
  <para style="q2" vid="EZK 32:10">wolaantichchi ankinni insa'ne uunda'naa'a ate'n ke'anno wodda</para>
  <para style="q1" vid="EZK 32:10">Ate'n gelteexxe yaanena'n kexxeexxa;</para>
  <para style="q2" vid="EZK 32:10">moyanjuwwi insa'neki alaayye culphise.</para>
  <para style="q1" vid="EZK 32:10">Atinna ibattoxxa barra,</para>
  <para style="q2" vid="EZK 32:10">mitti mittingi ifi ifinxe lubbo'a sodaante roqonsinaan.<verse eid="EZK 32:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 32:11" />« ‹Lumooki Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="EZK 32:11">« ‹Baabiloonik moyanji atee lolo'a dagaan,<verse eid="EZK 32:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 32:12" />Gosa gosake arda duuchchanaa'ni jajjaba mannike wolaantichcha'n,</para>
  <para style="q2" vid="EZK 32:12">bukki assiteteka atika lolinka manna shiyyemaashsha assanon;</para>
  <para style="q1" vid="EZK 32:12">Gibtseexxa holla balleessinaan,</para>
  <para style="q2" vid="EZK 32:12">laakkosi bira sa'eeke lolink isek manninna mudaan.<verse eid="EZK 32:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 32:13" />Heddi wode'i bira hedheeka horiinka bobba'a balleesannon;</para>
  <para style="q2" vid="EZK 32:13">atinni udumi'a manjiinxinna horniixi lekka isoo booressitaba'a.<verse eid="EZK 32:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 32:14" />Ookko'n wodu'uwwaa iseka quloonsannon;</para>
  <para style="q2" vid="EZK 32:14">wodu'uwwa isekanna zayitetishsha tululli hiyya'n yaa'ashsha assannon;</para>
  <para style="q1" vid="EZK 32:14">Hiyya'neen Duuchchi Woddik Gootti. <verse eid="EZK 32:14" /><verse number="15" style="v" sid="EZK 32:15" />Gibtsee urumake assanno wodda;</para>
  <para style="q2" vid="EZK 32:15">boga iseke'n hedhaachcho duuchcha gophphe ondaa wodda;</para>
  <para style="q1" vid="EZK 32:15">Ookkonna hedha'nekaara biranno wodda;</para>
  <para style="q2" vid="EZK 32:15">Eettene yanna ani Duuchchi Woddike Gootta kadennexxa insa'nenna egenaan.›<verse eid="EZK 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 32:16" />«Kunni isexxee'e boochchinsaaka boochchisa gosa gosake ardi xxi dubarte wi'lishitaan; Gibtseexxeenna heddo iseke lolinke manni duuchchi'a boochchisaan; hiyya'neen lumok Duuchchi Woddik Gootti» hiyye.<verse eid="EZK 32:16" /></para>
  <para style="s1">Buttati Wiiddi Hunda Sa'aake Mannixxa</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 32:17" />Boji'emmennexxe tommenna langaxxe wogga'n siretike agenjixxe tommenna ondixxe barra'n Duuchchi Woddik Goottik hiyyichchi aniba gage hiyyee qici: <verse eid="EZK 32:17" /><verse number="18" style="v" sid="EZK 32:18" />«Koo manjinke belto heddo Gibtseeke lolinke mannixxe'e oodhi; reyemmak manni e'yammake buttati hundike wiidda'n isenna jajjabba gosa gosaka manna sa'na'ashsha assi. <verse eid="EZK 32:18" /><verse number="19" style="v" sid="EZK 32:19" />Insa'ne'e hitatto qici, ‹Danchummati ha'no wele mannana'n caldinaata? Butti'a sa'we; Mageno addatebake manninn moogemme.› <verse eid="EZK 32:19" /><verse number="20" style="v" sid="EZK 32:20" />Insa'nenna wolaantichchik shiyemeemake manninni welti shiyemaan; wolaantichcha gonofakenaa'n fulchine'een; heddo iseke lolinke manni duuchchinni welti harkisemmowaal. <verse eid="EZK 32:20" /><verse number="21" style="v" sid="EZK 32:21" />Buttati hundike wiidda'n jajjabbi akeekisanjuwwi Gibtsexxeenna isenni welti guddammakeerixxe'e,</para>
  <para style="q2" vid="EZK 32:21">‹Moogiinxe bale giddi'a e'yine'een wolaantichchik shinnemmakeerinninna Mageno addatabaake manninni welti irkate'een› hina'neen.<verse eid="EZK 32:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 32:22" />«Asoori iseke lolinke manni duuchchinni ookkonni hexxe; wolaantichchik reyemmakinna gorranemmake iseke mannik hirreesi oddote'n isee buqeen. <verse eid="EZK 32:22" /><verse number="23" style="v" sid="EZK 32:23" />Mooggi ins'nekinna hundike wiiddike wiiddi giddon; lolink isek manninna iseke mooggi qarqara ibe'een. He'nammaxxe butta'n manna culphisashsha assammak duuchchi wolaantichchik shiyyemmedheen.<verse eid="EZK 32:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 32:24" />«Laakkonne dhaqqanbabaak Elaamike ardik mooggi ookko'o qarqara iseke'n hedheen; duuchchingi wolaantichchik gorra'emmee mundeen. He'nammaxxe butta'n manna culphisammak duuchchi Mageno addatebang butinni hundike wiidda'n sa'ne'een; bale giddo moogememmakeerinni welti shooko oddo'wine'een. <verse eid="EZK 32:24" /><verse number="25" style="v" sid="EZK 32:25" />Hirreessi iseke qarqara'n hedheeke lolinke manninni welt, gorra'emeeke mannixxe oddo'n bakka qopheende'een. Insa'ne duuchching Mageno addantebaakenna wolaantichchik sheyemme'ekeerin; manna culphisiisa insa'nexxi he'naaxxe butta'n oodesendemmaxxe'e moogemammakinni welti shooko oddo'winaan; wolaantichchik shiyememmakixxe oddo'ninna irkantaan.<verse eid="EZK 32:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 32:26" />«Meesheekikinna Tubbalik moogi heddi insa'neke lolinke mannik mooginni erqe kayyii'n qoqqobeme hedheen; insa'ne duuchching Mageno ege'na gonpheemmaxxe'e, he'nammaxxe butta'n manjo culphisinsemmaxxe wolaantichchik shiyeme'een. <verse eid="EZK 32:26" /><verse number="27" style="v" sid="EZK 32:27" />Baruwwi edi darre reyemmaki jajjabi mann; ookko wolaantichcha boraaffante; wonte qomate'n uggu'dhine lolinka miya ka'line'eshshanni moogemeeke manninni welti moogemmaba? Ookko lolinke mannixxi manna culphisiisa ha'nammaxxe butta'ni hedheeke jajjaba'n geltoolenna cubbo insa'nexxik hiri insa'nenden.<verse eid="EZK 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 32:28" />«Atinna Koo Fare'ooni atinna insa'neshshann enqendatton wolaantichchik shiyememmake Mageno ege'nebaakenni welti moogendatton.<verse eid="EZK 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EZK 32:29" />«Eedoomik ardik moyanjuwwinna akeekisanjuwwi duuchchi ookko'o he'neen; hunna anfoolenna wolaantichchik shiyemeekiirinni welti moogemme'een; bale giddo moogemmeek Mageno ege'nebaake manninni welti buttati hunda wiiddake'n sa'ne'een.<verse eid="EZK 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 32:30" />«Middi darrek moyanjuwwi duuchchi Sidoonk manni duuchchi ookkoo he'neen; konneechchi edo hunna insa'nexxixxe buutonni manna culphisiinsolenna gorraanemmakiirinni shiyyemme, Mageno ege'nebaake bagedik shiyemeekiirinni moogemaan; bale buttati hunda wiiddake'n shooko oddo'winaan.<verse eid="EZK 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EZK 32:31" />«Feri'oonninna isik lolink manni duuchchi insa'nee uundaa wodda isi wolaantichchik shiyemeeke ifke laakkossi bira sa'eeke lolinke manni duuchchixxee yaaddo waalle dayyeenfataan, hiyya'neen lumok Duuchchi Woddik Gootti. <verse eid="EZK 32:31" /><verse number="32" style="v" sid="EZK 32:32" />He'nammaxxe butta'n manna culphisiissashsha eeti'i isi'a uwwoole midde, Feri'oonninna isik lumok sannachchi duuchchi wolaantichchik shiyemeekiirinni welti Mageno ege'nebaake mannixxe oddo'n moogemman; hiyya'neen Lumok Duuchchi Woddik Gootti» hiyye.<verse eid="EZK 32:32" /></para>
  <chapter eid="EZK 32" />
  <chapter number="33" style="c" sid="EZK 33" />
  <para style="s1">Heqqanjo Hiziqeeli'i</para>
  <para style="r">(<ref loc="EZK 3:16-21">Hiz. 3:16-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 33:1" />Duuchchi Woddik Gootti ane'ni hiyyee qici: <verse eid="EZK 33:1" /><verse number="2" style="v" sid="EZK 33:2" />«Koo manjiinke belto! Atike ardi'a hitatto qici: ‹Ani bogake'n bagedo iyyedaganno wodda, bogiink ardinna insa'ne giddi'n mitte manjo fi'line ifike heqqanjo asse'noole, <verse eid="EZK 33:2" /><verse number="3" style="v" sid="EZK 33:3" />heqqanjikinna bagedi dageexxa uudeexxi arda xexxe'achchiisatee'e malagata ufuufoole, <verse eid="EZK 33:3" /><verse number="4" style="v" sid="EZK 33:4" />ookkoneechchi uduma huuni manji malagatinka hafuura laqeexxi ifi xexxe'ata gophoole, bagedi dageexxi isoo shiyoole, munde isixxee isonde qoreman. <verse eid="EZK 33:4" /><verse number="5" style="v" sid="EZK 33:5" />Malagatiinka hafuura laqeexxi ifi haqqedha gopheemmaxxee shiyemiyyotee geessiseeki ifinge dedhan. Ifi heqqedheele kinni ifixxa hedho gatirsamman. <verse eid="EZK 33:5" /><verse number="6" style="v" sid="EZK 33:6" />Yaane kinni heqqammak bagedi dageexxa uudeexxi, arda xexxe'achchisate'e malagata ufuufebaang gatee'na insa'nexxe oddonaa'ni naaphi dage mitte manjo bagedi shiyoole iikki manjichchi reyeek isixxe cubbonniten. Ani kinni ookkone manjichchixxa munde heqqanjo laqannon.›<verse eid="EZK 33:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 33:7" />«Koo manjiinke belto atee Isira'eelike ardike heqqanjo assennen: tennexxee hiyyaannexxa laqi; anxa xexxe'achchiisa insa'ne'n haaso'i. <verse eid="EZK 33:7" /><verse number="8" style="v" sid="EZK 33:8" />Cubbaaleessa manjo, ‹Koo ati cubbaaleessa manjo dhugaadinni rertaton› hiyyanno wodda isinna fuggoke oranaa'ni higaashsha assa gophphotole, iikki fuggichchi manji cubbo ifinxeninni reyaan; ati kinni munde isixxee laqendatton. <verse eid="EZK 33:8" /><verse number="9" style="v" sid="EZK 33:9" />Yaane kinni fuggichcha manjo fuggoke oranaa'n higaashsha xexxe'achchiisee'naa'a higa gophoole, isi ifinxe cubboxxee reyaan; ati kinni ifixxa hedho gatirsitatton.<verse eid="EZK 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 33:10" />«Koo manjiinke belto, Isira'eelika arda hitatto qici, ‹Ha'noonna hitina'nee qici: «Balleessa no'oxxinna cubbo no'oxxi ha'urte'een, tennenaa'n kexxexxa yayate'ni he'nennen; habata ganta'enne?» › <verse eid="EZK 33:10" /><verse number="11" style="v" sid="EZK 33:11" />Insa'ne'e hitatto qici, ‹Ani hedhannoke kadeennaxxee; fuggoke ora ifikenaa'n hingeexxi hedhoti he'naashshate male'e cubbaaleeyyetixxi reyo anee gammachchiisabaan. Hiyya'neen Lumooki Duuchchi Woddiki Gootti. Higgee! Fuggoke ha'nooke oranaa'n higge! Koo Isira'eelike arda; maa rertinata?›<verse eid="EZK 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 33:12" />«Higgeen koo manjiinke belto; atike boga'n hedheeke arda'n hitatto qici, ‹Qullichchi manji anka seera sa'oole edi woddixxi eloxxi huje isoo anjirtabaan; cubbaaleessi manji cubbo ifixenaa'n higo'oole edixxe fuggoxxe huje isixenaa'n kexxeexxa ba'abaan. Qullichchi manji cubbo hujoole edi wodda huje'exxi qullumma reyotenaa'n isoo gatissabaan.› <verse eid="EZK 33:12" /><verse number="13" style="v" sid="EZK 33:13" />Qullichcha manjo dhugaadinni lubbot hexxatton hiyye'naa isinna ifixxa qullumma addateexxi cubbo hujoole; hujemmaxxi qullumma mittetinna isi'a hedendabaan; isixxe cubboxxe buutonni reyaan. <verse eid="EZK 33:13" /><verse number="14" style="v" sid="EZK 33:14" />Iittanni fuggoka manjo, ‹Dhugaandinni rertatton,› hiyye'naa isinna hujammaxxa cubbo waale'e eloxxanna qajeela yaane hujoole, <verse eid="EZK 33:14" /><verse number="15" style="v" sid="EZK 33:15" />liqeesemmake liqi'a abixxemmaka miya hiisoole, mooremmalchonna hiisoole; hedho uwwaaka ajajuwwa hordofoole; fuggoxxa yaanenna assa gophoole; dhugandinni isi hedhondinni hedhaan; reyabaan. <verse eid="EZK 33:15" /><verse number="16" style="v" sid="EZK 33:16" />Hujemmaxxe cubbonaa'n mittetinna laakko'endabaan; eloxanna qajeelto yaane asse'een, dhugaandinni hedhondinni hedhaan.<verse eid="EZK 33:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 33:17" />«Atike bogik manni, ‹Lumoke Duuchchi Woddike Goottik ori qajeelakebaan› hiyatte'n hedheen. Qajeelake kada gopheek kinni insa'neke oran. <verse eid="EZK 33:17" /><verse number="18" style="v" sid="EZK 33:18" />Qullichchi manji qullumma hujammaxxa waaleexxi fuggoxxa hujoole hujemmaxxe cubboxee reyaan. <verse eid="EZK 33:18" /><verse number="19" style="v" sid="EZK 33:19" />Fuggichchi manji fuggoxxa huja waleexxi eloxxanna dhugaatixxa yaane assoole tenne eloxxa assemmaxxee hedhoti hedhaan. <verse eid="EZK 33:19" /><verse number="20" style="v" sid="EZK 33:20" />Kaddo malee'e koo Isira'eelike ardaa, ‹Lumoke Duuchhi Woddike Goottik ori qajeelakebaan› hiyyate'n hexxineen. Yaane kinni mitte mitte hannoge'n huje huje ha'nooxxishanni ani murte murannon.»<verse eid="EZK 33:20" /></para>
  <para style="s1">Iyyerusaalemixxa Iba</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 33:21" />Booji'emmennexxe tommenna langaxxe wogga'n tommike agenjo'n ondixxe barra'n Iyyerusaalemii'n baaje dageek mitti manji anibaa dageexxi ane'n, «Qachchi naaphiinxe anga'n ibe!» hiyyeen.<note caller="-" style="x"><char style="xo" closed="false">33:21 </char><char style="xt" closed="false"><ref loc="2KI 25:3-10">2 Moy. 25:3-10</ref>; <ref loc="JER 39:2-8">Erm. 39:2-8</ref>; <ref loc="JER 52:4-14">52:4-14</ref>. </char></note> <verse eid="EZK 33:21" /><verse number="22" style="v" sid="EZK 33:22" />Manjichchi soodishsha dagaa'naa eettene hashsha Duuchchi Woddike Goottixxi hunna ane'n hexxemman; soodimaro manjichchi aniba dagebaa edi darre Duuchchi Woddik Gootti afo'o anka bane; afo'i ankinna baneme; ookkoneechchi uduma sammi hiyyebo'nonn.<verse eid="EZK 33:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 33:23" />Ookko'ninna Duuchchi Woddike Goottik hiyyichchi aniba dageexxi: <verse eid="EZK 33:23" /><verse number="24" style="v" sid="EZK 33:24" />«Koo manjiinke belto Isira'eelike boga'n oletixxe tuulo giddo hedha'nek ardi, ‹Abirihaami qofitti hedhemman ikki mitti ookkone boga dhaale; no'o kinni heddoken; dhugaadinni iikki bogi geego no'oke asseme uuneme'en› hinaa'neen. <verse eid="EZK 33:24" /><verse number="25" style="v" sid="EZK 33:25" />Tennexxee insa'nee hitato qici, ‹Lumok Duuchchi Woddik Goottinna Munde giddo hexxeeka maala ittina'neen; ille ha'nooxxanna magenoonfatinammaxxe fakkuwwaba'a hisitine'een; manjokanna anga saxxina'neen; konne qicinni ookkone boga dhaaldino'a heddina'neeta? <verse eid="EZK 33:25" /><verse number="26" style="v" sid="EZK 33:26" />Wolaantichcha ha'nooka addatine hollitina'neen; battitte yaanuwwa hujina'neen; mitti mitti ha'noogi ha'nooke jaaluwwixxa are battoonsitina'neen; eegata konne qicinni ookkonee boga dhaaldinaata?›<verse eid="EZK 33:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 33:27" />«Insa'neenna hitatto qici: ‹Lumok Duuchchi Woddik Gootti hiyya'nee qici: ani hedhaaneke kadeennaxxee ifi'n kakataannen; oletixxe tuulo giddo gateekiir wolaantichchake'n reyaan; qachchi gadho hadi giddo hedheekaara biniinchi ninnife itaashsha assannon; kollote'ninna wolo'oti giddo hedheekiir dhukkubik mudaan. <verse eid="EZK 33:27" /><verse number="28" style="v" sid="EZK 33:28" />Bogakanna urmakenna duwwike assannon; Isira'eelito ifi saadammaxxa hunna isexanna gophphaashsha assannon; Isira'eelixxi koobuwwanna ondee'naa ayyinna ookko'n sa'aak hedhabaan. <verse eid="EZK 33:28" /><verse number="29" style="v" sid="EZK 33:29" />Hunjemmaxxe diqachchisaaxxe yaanenaa'n kexxeexxa bogakanna urmake assanno wodda ani Duuchchi Woddike Gootta kadennexxa tenne'n egennaan.›<verse eid="EZK 33:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 33:30" />«Koo manjiinke belto atike bogik ardi ifi ifike minixxe hula'ninna ora ora'n afemeeba atixee'e insa'ne hina'ni weli'anni weli haasona'nee qici, ‹Amme Duuchchi Woddik Gootti no'o'a hiyya'neeka hiyyichcho lanqo.› <verse eid="EZK 33:30" /><verse number="31" style="v" sid="EZK 33:31" />Guremee ardi atibaa'a dagaan: hiyyichcho atika laqatee ati edo ofo'laan; yaane kinni hitaatexxa duuchcha muunxabaan, eeyya insa'nexxi suume callixxen; godobi insa'nek seeribeloxxe la'o hendaan. <verse eid="EZK 33:31" /><verse number="32" style="v" sid="EZK 33:32" />Hiyyichcho atika lanqe hujete'n hosissammabaaxee ati insa'ne'a meelinxe qonqonni jaalalatika sirba sirbaakenna, elo qica faarotike miyyinni sirbammaka sirballo insa'ne'a kaddeetten.<verse eid="EZK 33:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 33:33" />«Ati haasotetaxxi duuchchi dhugaati muuxxendaa wodda eettene yanna wabeekichchi insa'nexxe oddo'n hedheexxa egennaan.»<verse eid="EZK 33:33" /></para>
  <chapter eid="EZK 33" />
  <chapter number="34" style="c" sid="EZK 34" />
  <para style="s1">Allallisanonna Gedhebo</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 34:1" />Duuchchi Woddike Goottik hiyyichchi ane'ni dage hiyyee qici: <verse eid="EZK 34:1" /><verse number="2" style="v" sid="EZK 34:2" />«Koo manjinke beltoo! Isira'eelike akekisanjuwwa'n raaga raagi; hite, insa'ne'n raagatto qici: ‹Lumok Duuchchi Woddiki Gootti hiyya'nee qici, ifi calla kookirsexxa'neexxe Isira'elixxe allallisanuwwa'a aanne! Allallisanjuwwi gedhebo bobbaasa hasisamabata? <verse eid="EZK 34:2" /><verse number="3" style="v" sid="EZK 34:3" />Ha'no adotanna ha'witinaan; oridati hunjeexa fuuttiinxa seemma odo'witinaan. Eloxxa munde afeeka du'litineen; yaane kinni gedhebo elo qicinni abidinebaani. <verse eid="EZK 34:3" /><verse number="4" style="v" sid="EZK 34:4" />Gopheeka jabeessitinebaan; elagopheeka dhukkussiisinebaan; enqemeeka xaassinebaan. Milqeeka hiissitinebaan; ba'eka hassinebaan; hunnatinna miicamik konne gedhebo mootineen. <verse eid="EZK 34:4" /><verse number="5" style="v" sid="EZK 34:5" />Tennexxee allallak hedha gophemmaxxee gedhebi xeeremeen; tenne buutonni biniinchuwwi iteen.<note caller="-" style="x"><char style="xo" closed="false">34:5 </char><char style="xt" closed="false"><ref loc="NUM 27:17">Lak. 27:17</ref>; <ref loc="1KI 22:17">1 Moy. 22:17</ref>; <ref loc="MAT 9:36">Mat. 9:36</ref>; <ref loc="MRK 6:34">Mar. 6:34</ref>. </char></note> <verse eid="EZK 34:5" /><verse number="6" style="v" sid="EZK 34:6" />Gedhebi anki tullichchuwwa duuchcha'ninna koobuwwate'n jeekki hiyye. Boga duuchcha'ni xeereme; hasito me'ekinna haba gante hiyyek hedhebaan.<verse eid="EZK 34:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 34:7" />« ‹Tennexxeenna ha'no allallisanuwa, Duuchchi Woddike Goottika hiyyichcho laqqe. <verse eid="EZK 34:7" /><verse number="8" style="v" sid="EZK 34:8" />Ani hedhanneke kadennexxee, hiyya'neen lumok Duuchchi Woddiki Gootti allalisanjuwwi gedhebo anka hasito fula gophemmaxxee, gedhebi anki irra ifi xoo'mamik uundemmaxxee, anki gedhebi allallisanjo afa gophe butemeen; biniichuwwi duuchchi'a itate kadeen. <verse eid="EZK 34:8" /><verse number="9" style="v" sid="EZK 34:9" />Tennexxee ha'no allallisanjuwwi Duuchchi Woddike Gootti haaso'a'neexxa laqqe. <verse eid="EZK 34:9" /><verse number="10" style="v" sid="EZK 34:10" />«Ani Lumok Duuchchi Woddik Gootti anke gedhebixxe allallisanuwwa'n moronshate afeennen. Gedhebokanna allallisanotenaa'ni aadhennexxi allallabaashsha assannon. Telchinni elqi'a alalsanuwwi gedhebo anka allallabaashshanna ittabaashsha anka gedhebo afo'o insakenaa'ni hunsiisannon» hiyye.<verse eid="EZK 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 34:11" />« ‹Lumok Duuchchi Woddiki Gootti hiyya'nee qici, ani ifi'anni gedhebo anka harsannon; xexxe'atenna heqqedhannoni. <verse eid="EZK 34:11" /><verse number="12" style="v" sid="EZK 34:12" />Allallisanji xeremeeke gedhebi giddii'ni ba'eeka harsedhammashsha aninna anka gedhebo harsedhannon. Duumanchiinxenna dimma dukkana barra'ni xexerememmake booncho duuchchana'n gedhebo anka anjirannon. <verse eid="EZK 34:12" /><verse number="13" style="v" sid="EZK 34:13" />Konne qicin ani anka arda gosa gosake ardi giddii'ninna boga bogana'ni bukki assee fulchennexxi insa'neke bogibaa idagannon. Isira'eelixxe koobuwwa'n wode'uwwinxe dhooquwwa'n bogi giddo he'nemmaxxe bakka duuchcha'n insa'nee bobbaasannon. <verse eid="EZK 34:13" /><verse number="14" style="v" sid="EZK 34:14" />Eloke booncho'ni gedhebo bobbaalsannoni; bobba'aabinna Isira'eelixxe koobuwwake tullchchuwwa'ni kadaan. Gedhebikinna Isira'elixxe koobuwwa'ni hana eloba anso dheede eloxxe anso hana ciisaan. <verse eid="EZK 34:14" /><verse number="15" style="v" sid="EZK 34:15" />Ani ifi'anni gedhebo anka bobalsannon; ti'ni hinaashsha assannon. Hiyya'neen lumok Duuchchi Woddik Gootti. <verse eid="EZK 34:15" /><verse number="16" style="v" sid="EZK 34:16" />Ba'eka halsannon; milqeeka hiisannon. Enqemeeka xaasannon; gopheeka jabesannoni; Ani dhugaatike allallisanjo kadenaxxee furdateekanna uduuda jabaateeka kinni ballessannon.<verse eid="EZK 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 34:17" />« ‹Anke gedhebo kaddineeka ha'no lumok Duuchchi Woddiki Gootti hiyya'nee qici, elokenna fuggoke gedhebinxe oddo'ni; gedhebinxe korbeyye'nina re'etixxe korbeyyexxe oddo'ni murte anxa muraannen. <verse eid="EZK 34:17" /><verse number="18" style="v" sid="EZK 34:18" />Eloke boncho'ni allalendine qici hanqate'natteta? Gateeka ha'no allalendinaba lekkat hirbeessa hasissaata? Ca'ichcha wode'e ha'witinechchin gateeka lekkat booressa ha'no'a hasissaataa? <verse eid="EZK 34:18" /><verse number="19" style="v" sid="EZK 34:19" />Konne qicin weli ank gedhebi ha'no lekkati hiribeesitineexxa bada'a ittanni ha'no lekkati booreesitineeka wode'e ha'wa hasissaata?<verse eid="EZK 34:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 34:20" />« ‹Tennexxee lumok Duuchchi Woddiki Gootti ifika gedhebo ani ifi'anni ha'yakenna huqqateeke gedhebi ankixxe oddo'ni murannon. <verse eid="EZK 34:20" /><verse number="21" style="v" sid="EZK 34:21" />Ha'no hunna afebaaka gedhebo cinaachchikinna dugomoti dhiibina'n fulchitinammaxxee, gophaaleesa gaafik tundine bayyisinee shorritina'mmaxxee, <verse eid="EZK 34:21" /><verse number="22" style="v" sid="EZK 34:22" />Yaane kinni ani gedhebo anka anjirannon, langaxxa ayyinna dannabe adhdhabaan. Ani elokenna fuggoke gedhebixxe oddo'ni murannoni. <verse eid="EZK 34:22" /><verse number="23" style="v" sid="EZK 34:23" />Anke erganji Daawwitishsha hedheeka mitte allallisanjo anke ardi'a ke'iisannon. Isinna insa'nee xoo'mamik heqqaan. <verse eid="EZK 34:23" /><verse number="24" style="v" sid="EZK 34:24" />Ani Duuchchi Woddike Gootta insa'neeke Mageno kadannoni; erganji anki Daawwitinna oddo insa'nexxe'ni galchallo kadan. Tennee haaso'ennek ante Duuchchi Woddike Goottan.<verse eid="EZK 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 34:25" />« ‹Aninna insa'ne nage'ik he'naashsha insa'ne'a kako aagaannon; fuggoke kadeeka biniinchcha anke ardike boganaa'n fugussannon. Tennexxee gedhebi anki gongomake'ninna kado booncho duuchcha'n nage'ik diiphaan. <verse eid="EZK 34:25" /><verse number="26" style="v" sid="EZK 34:26" />Insa'neenna anxe koobake qariqara'ni hedheka boonchuwwa eebisannon. Xeenakanna mayete'ni ganissiisannon; kunni xeeninna goddiinke kadaan. <verse eid="EZK 34:26" /><verse number="27" style="v" sid="EZK 34:27" />Fichchi giddixxi gargarti hexxeexxi haquwwa gummisaan; bogikinna missaaxxa midha fulchaan. Ardinna ifike boga'ni nage'ik hedhaan. Insa'neka qanbara enqano wodda insa'ne miicammake mannixxe anganaa'ni qullo fulchanno wodda, Ani Duuchchi Woddike Gootta kadenexxa egenaani. <verse eid="EZK 34:27" /><verse number="28" style="v" sid="EZK 34:28" />Ookknechchi uduma wele bogike gosa gosak ardi'a insa'nee mulqe'nabaan; biniinchuwikinna insa'nee ninnifabaan; insa'ne sodachisake hedheban nage'iki he'naan. <verse eid="EZK 34:28" /><verse number="29" style="v" sid="EZK 34:29" />Misseexxa midha fulchati ege'nemeeka boga insa'ne'a qopheessannon; insa'ne langaxxa solo'okee sa'issemmabaan; gosa gosake arda'ninna oso'lemmabaan. <verse eid="EZK 34:29" /><verse number="30" style="v" sid="EZK 34:30" />Insa'nenna ani Duuchchi Woddiki Gootti insa'neki Mageni insa'nenni welti hedhennexxanna Isira'eelik ardi anke arda kadeexxa egennaani. Ani lumok Duuchchi Woddik Gootti tenne'e haaso'eennen. <verse eid="EZK 34:30" /><verse number="31" style="v" sid="EZK 34:31" />Ha'no ani alla'lannoke anke gedhebon; Aninna ha'noke Magenon, hiyya'neen lumok Duuchchi Woddik Gootti› » hiyye.<verse eid="EZK 34:31" /></para>
  <chapter eid="EZK 34" />
  <chapter number="35" style="c" sid="EZK 35" />
  <para style="s1">Edomi'n Kulemeeka Wabeekuma</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 35:1" />Duuchchi Woddike Goottik hiyyichchi ane'ni dage hiyyee qici: <verse eid="EZK 35:1" /><verse number="2" style="v" sid="EZK 35:2" />«Koo manjinke belto; alba atika kobuwwatike Seyiirike bogiba'a<note caller="+" style="f"><char style="fr" closed="false">35:2 </char><char style="ft" closed="false">Koobuwatik Seyirike boga hiyyo Edomitotike bogan</char></note> wirri assite iso'ni raaga raagi. <verse eid="EZK 35:2" /><verse number="3" style="v" sid="EZK 35:3" />Hitatto qici: ‹Dada Duuchchik Duuchchi Woddiki Gootti hiyyaanee qici; koo koobuwwatike Seyiirike boga ani ate'ni naaphunteti ke'enneni; anga anxa ate'ni hana ke'issannon; boga atika onakenna urume gataashsha assannon. <verse eid="EZK 35:3" /><verse number="4" style="v" sid="EZK 35:4" />Qachchuwwa atika olete assannon; urmee gataan; Ookko'ni Ani Duuchchi Woddike Gootta kadennexxa egendatton.<verse eid="EZK 35:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 35:5" />« ‹Isira'eelike ardik xixichchi hara yo'oshsha qararaake kade hunnati iimi darre hexxeexxi rakko geltee wodda, qara hexxemmaxxa halo waala gophe insa'nee wolantichchake'n sa'issite uutetaxxee, <verse eid="EZK 35:5" /><verse number="6" style="v" sid="EZK 35:6" />Ani hedhannoke kadenneshsha atika arda shiyaake mannixxe anga'ni sa'isse uwwe'naa shorrinaan. Atik ardi munde dhangalaasa giba gophammaxxee anga sa'aaki manni insa'nee shorraan; hiyya'neen lumok Duuchchi Woddik Gootti. <verse eid="EZK 35:6" /><verse number="7" style="v" sid="EZK 35:7" />Koobuwwatik Seyiirik bogi urmenna one gataashsha assannon; ookko'ni sa'aaka duuchcha shiyannon. <verse eid="EZK 35:7" /><verse number="8" style="v" sid="EZK 35:8" />Koobuwwa atixxe'ni rensha eleeqqi assannon; wolaantichchik shiyemeek duuchchi, koobuwwate'n, dhooquwwa atixxe'ninna wodi'ink yaasuma duuchcha'ni inbaan. <verse eid="EZK 35:8" /><verse number="9" style="v" sid="EZK 35:9" />Duuchchi woddi'a urma kadde hexxattoshsha assannon; atike qachchuwwa'ni manji hedhabaan. Ookko'ni ani Duuchchi Woddike Gootta kadennexxa atinna egendatton.<verse eid="EZK 35:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 35:10" />« ‹Ani Duuchchi Woddik Gootti ookkonni hedhe'naa, «Kunni lami gosa gosak ardinna lami bogi anke kadaan; aninna dhaalannon» hitetten. <verse eid="EZK 35:10" /><verse number="11" style="v" sid="EZK 35:11" />Tennexxee ani lumoki Duuchchi Woddik Gootti hedhaneke kadennesahshanni ha'no Seeyrike bogik ardi insa'ne giba ha'noxxena'n kexxeexxa insa'ne'ni leellishinexxe mufeshshanna hinaafesha ha'no'n ani muranon: ha'no'ni murano wodda, ayyumma anixxi insa'nexxe oddo'ni ege'nendaashsha assannon. <verse eid="EZK 35:11" /><verse number="12" style="v" sid="EZK 35:12" />Ookko'ni Isira'eelixxi koobuwwa onde gette'een; ninniffe indannoshsha insa'ne no'o'a uwwemme'een hite tuffeti haasotettexxa Ani Duuchchi Woddik Gootti laqeennexxa, «ha'nonna ookone wodda egendinaan» <verse eid="EZK 35:12" /><verse number="13" style="v" sid="EZK 35:13" />Ane'ni hana kijibinenna harqitine haasotineexxa laqeennen. <verse eid="EZK 35:13" /><verse number="14" style="v" sid="EZK 35:14" />Duuchchi Woddiki Gootti hiyya'nee qici: Butta duuchcha gammaddaa wodda ha'noka boga urma assannon. <verse eid="EZK 35:14" /><verse number="15" style="v" sid="EZK 35:15" />Isira'eelike ardik geegi urume gatee wodda; gammadetaxxee, aninna iittanni ate'ni assannon. Koo koobatike Seyiirike boga atinna Eedoomik bogi duuchchi urmake kaddinaani. Ookkonechchi uduma Ani Duuchchi Woddike Gootta kadennexxa egennaan.› »<verse eid="EZK 35:15" /></para>
  <chapter eid="EZK 35" />
  <chapter number="36" style="c" sid="EZK 36" />
  <para style="s1">Isra'eli Ifike Bogiba'a Higgaaxxa</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 36:1" />«Koo manjike belto Isira'eelixxe koobuwa'a raaga raagi; hitatto qici, ‹Tee Isira'elixxe koobuwwa Duuchchi Woddike Goottika hiyyichcho laqqe. <verse eid="EZK 36:1" /><verse number="2" style="v" sid="EZK 36:2" />Lumok Duuchchi Woddiki Gootti hiyya'nee qici: Naaphi ha'noxxee, «Hashshuu! Tinni olmixxi gooruwwa no'oke geego kade'een hiyye'een.» › <verse eid="EZK 36:2" /><verse number="3" style="v" sid="EZK 36:3" />Tennexxee raaga hite raagatto qici, ‹Lumok Duuchchi Woddiki Gootti hiyya'nee qici: tee Isira'elixxe koobuwwa gateeki gosa gosake ardi bogi duuchchi ha'noke geegon kaddeeshshanna ardi ha'no hamata'n qacifatashsha naaphi elqenna kayyi'ni ha'noo bunqe lole urmake asseen. <verse eid="EZK 36:3" /><verse number="4" style="v" sid="EZK 36:4" />Tennexxee tee Isira'eelixxe koobuwwa, lumoke Duuchchi Woddike Goottika hiyyichcho caqasse: lumok Duuchchi Woddik Gootti koobuwwatenna tullichchuwwake, dareeruwwakenna dhooquwwate, findigeme uruma kadeekenna wele qarqara ha'noke'ni hedheeke gosa gosake ardi mulqedhe qacifateke qachchuwwa'n hiyya'nee qici, <verse eid="EZK 36:4" /><verse number="5" style="v" sid="EZK 36:5" />Lumok Duuchchi Woddik Goottinna jabaxxe anxe hinaafenni gateeke gosa gosake arda duuchcha'ninna Eedoomike arda duuchcha'n haaso'ennen; insa'ne godobi mittinni gammandenna haranga cee'mine anka boga hunnati ifi'a adhine ifike horike allaletike boga asse'ne.› <verse eid="EZK 36:5" /><verse number="6" style="v" sid="EZK 36:6" />Tennexxee Isira'eelika boga uudaaxxinni raaga raage'e, tullichchuwwakee, wodi'inke yaasumuwanna dhooquwwatee, hitatto qici: ‹Lumok Duuchchi Woddiki Goottinna hiyya'nee qici: gosa gosake ardixxe qacififachonni bajabaja hitinemmaxxee anxe mufenninna anxe hinaafenni haaso'aannen. <verse eid="EZK 36:6" /><verse number="7" style="v" sid="EZK 36:7" />Tennexxee Lumok Duuchchi Woddik Gootti hiyya'nee qici: qarqara ha'noke'n hedheeki gosa gosak ardinna ifi'anni salphataxxa jabeese kakataannen.<verse eid="EZK 36:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 36:8" />« ‹Insa'ne ta'a shiqonni ifigge bogiba'a illeema hinga'emmaxxee tee Isira'eelixxe koobuwwa, ha'no haqichchuwwi anka arda Isira'eeli'a dame daddadhaan; gummatanna gummisaan. <verse eid="EZK 36:8" /><verse number="9" style="v" sid="EZK 36:9" />Tee Isira'elixxe koobuwwa ani ha'no'a xexe'ata'ennen; eloxxen ha'no'o uudannon; ha'no hunjendinaa'n midha ha'non facaasendaan. <verse eid="EZK 36:9" /><verse number="10" style="v" sid="EZK 36:10" />Isira'eelike mannik laakkossi ha'no'n bira sa'issanonn. Qachchuwwake'n manji hedhaan; findigemeenk qachchuwwinna ijaremaan. <verse eid="EZK 36:10" /><verse number="11" style="v" sid="EZK 36:11" />Ha'no'ni manjinkanna horinka laakkossa bira sa'issannon; horashsha assannon; edi woddishshanni manni ha'no giddo hedhaashshanna edi irra duroomaashsha assannon. Ookko'ni ani Duuchchi Woddike Gootta kadennexxa egendinaan. <verse eid="EZK 36:11" /><verse number="12" style="v" sid="EZK 36:12" />Anka arda Isira'eeli ha'no giddo mammaremmashsha assannon; ha'no dhaalaani; ha'nonna geego insa'neke kaddinaan; ta'inni edi'a oose insa'nexxi ha'no hana langaxxa solo'ik midhendaba'a.<verse eid="EZK 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 36:13" />« ‹Lumok Duuchchi Woddiki Gootti hiyya'nee qici: ardikinna ha'noxxee, «Gossa gosa ardi ha'no'o Isira'eelixxi koobuwwa manjo birtaaxxen; ookko hedaaka ardakanna oose belo gatinsaan,» hinemaxxee, <verse eid="EZK 36:13" /><verse number="14" style="v" sid="EZK 36:14" />Tee Isira'eelixxe Koobuwwa ha'no ta'inni edi'a manjo birtinabaan; ookko hedhaaka ardanna oose belo gatissinabaan; tenne haaso'ennek ante Lumoke Duuchchi Woddik Gootti. <verse eid="EZK 36:14" /><verse number="15" style="v" sid="EZK 36:15" />Ta'inni udumi'a gosa gosak ardika yowwichcho wila laqinabaashsha assannon; ardinke yowwichchinni laalefatina'ni hexxinabaan; konnechchinni edi'a ha'no hana hedhaake ardi'a gufo kadinabaan; tenne haaso'enek ante Lumoke Duuchchi Woddik Goottan.› »<verse eid="EZK 36:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 36:16" />Duuchchi Woddike Goottik hiyyichchi higgeen ane'ni dage hiyyee qici: <verse eid="EZK 36:16" /><verse number="17" style="v" sid="EZK 36:17" />«Koo manjinke belto Isira'eeliki ardi ifike boga'n hedhamma wodda hujetinna galdumik boga ookkone'e battessemman; adabi insa'nekinna ani edo, meyyaxxi agenjiixxi aada dagamma wodda battottammashshandemman. <verse eid="EZK 36:17" /><verse number="18" style="v" sid="EZK 36:18" />Tennexxee ifike boga'n munde dunnemmaxxenna fakkuwwa insa'nexxe'ni battesinemmaxxe'e anxe mufenni insa'nee ganenne. <verse eid="EZK 36:18" /><verse number="19" style="v" sid="EZK 36:19" />Gosa gosake ardi giddo insa'ne xeernneni; insa'nenna boga duuchcha'ni xexxereme; adabi insa'nekishshanna huje insa'nexxeke hirishanni insa'ne'a murennen. <verse eid="EZK 36:19" /><verse number="20" style="v" sid="EZK 36:20" />Ardi duuchchi ha'no, ‹Kunni Duuchchi Woddike Goottik ardan kinni isike boganaa'n fuleeke› hiyya'n haaso'emmaxxe martine geltine boncho duuchcha'n gosa gosake ardi giddo woyyichcha anka summa battoossine. <verse eid="EZK 36:20" /><verse number="21" style="v" sid="EZK 36:21" />Isira'eelik ardi mareeba duuchcha gosa gosake ardi giddo woyyichcha summa anka batto'aashsha assine; anik kinni summa anke xexe'atannon.<verse eid="EZK 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 36:22" />«Tennexxee Isira'eelike arda'n hitatto qici, ‹Lumok Duuchchi Woddiki Gootti koo Isira'eelike arda tenne duuchcha assannok ha'noxxeete kaddebaak, martinge gosa gosake ardi giddo bottoossitinemmake woyyichcha anke summixeteen. <verse eid="EZK 36:22" /><verse number="23" style="v" sid="EZK 36:23" />Gosa gosake ardi giddo batto'eeka, ha'no insa'ne edo battonsitineeka, lumoke anke summika woyyooma leellishannon; ookko'ni ille insa'nexxi uuda'naani ha'no darree'ni ifi woyyonse ege'nishanno wodda, gosa gosak ardinna ani Duuchchi Woddike Gootta kadennexxa egennaan; hiyya'neenni Lumok Duuchchi Woddiki Gootti.<verse eid="EZK 36:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 36:24" />« ‹Gosa gosake ardi giddi'ni ha'no'o fulchannon; boga duuchchinaa'ni ha'noo bukki assannon; ha'noge bogiba'a wirri asse idagannon. <verse eid="EZK 36:24" /><verse number="25" style="v" sid="EZK 36:25" />Ca'ichcha wode'e ha'no'ni fixannon; ha'nonna ca'a hitinaan; battummatena'ninna magenonfatinammaxxe ha'nooxxe fakkuwwa duuchchanaa'ni qullonsannon. <verse eid="EZK 36:25" /><verse number="26" style="v" sid="EZK 36:26" />Haaroxxa qalbe ha'no'a uwwannon; haaroka hafuura ha'no giddo uggannon; kinjiinxa qalbe ha'nona'ni hoyyannon; shaqqaxxa qalbe ha'no'a uwwannon. <verse eid="EZK 36:26" /><verse number="27" style="v" sid="EZK 36:27" />Hafuura anka ha'no giddo uggannon; aada anxa hordofinashshanna seera anka xonxommatina'ni heqqexxinaashsha assannoni. <verse eid="EZK 36:27" /><verse number="28" style="v" sid="EZK 36:28" />Edike ha'noke annuwwi'a uwwennake bogiba hexxinaan; anke ardanna kaddinaan; Aninna Mageno ha'noke kadannon. <verse eid="EZK 36:28" /><verse number="29" style="v" sid="EZK 36:29" />Battumma ha'no duuchchinaa'n hoyyee ha'noo anjirannon; midha missaashsha ajajannon; solo'okanna ha'no'ni idagabo'no. <verse eid="EZK 36:29" /><verse number="30" style="v" sid="EZK 36:30" />Solo'okenaa'ni kexxeexxa gosa gosake ardi giddo salphatinabaashsha, hiddichchii fichchixxi gummanna midha missashsha assannon. <verse eid="EZK 36:30" /><verse number="31" style="v" sid="EZK 36:31" />Ookko'n elobaaka ora ha'nokanna battitte huje ha'nooxixxa qabatinaan; cubbo ha'nooxxena battite ha'noxe hujexee ifinni diqatinaan. <verse eid="EZK 36:31" /><verse number="32" style="v" sid="EZK 36:32" />Ani tenne'e assa'ennek ha'noxxe hiyyeete kaddebaaxxa tenne egendino'a hasaannen; koo Isira'eelike arda huje ha'noxxee shookkine ifi salphisse; hiyya'neen Lumok Duuchchi Woddik Gootti.<verse eid="EZK 36:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 36:33" />« ‹Lumoki Duuchchi Woddiki Goottinna: ani cubbo ha'noxxe duuchchanaa'ni ha'noo ca'a assannoxxa barra, qachchuwwa ha'noka haaroba manji giddo hedhaake assanno. Diigememmakiirinna qammalchemaan. <verse eid="EZK 36:33" /><verse number="34" style="v" sid="EZK 36:34" />Alallenna adadde uuda'ni sa'ammake manji duuchchixxe ille'ni urma boga huyyememmak hujemaan. <verse eid="EZK 36:34" /><verse number="35" style="v" sid="EZK 36:35" />Insa'nenna, «Urme'emmak kunni bogi Edeenike hiddichchuwwinke boga labe: findigememmak olete kade'emmak, urma kademmak qachchuwwi ta'a jabake kinjike dalla'ike manji hedhaake kadde'een» hinaan. <verse eid="EZK 36:35" /><verse number="36" style="v" sid="EZK 36:36" />Ookko'ni qarqara ha'noke'ni gateemmak gosa gosak manni diigememmaka hiisse ijarennexxa, banxo'e ba'emmaka haanjisennek Ante Duuchchi Woddike Gootta kadennexxa egennaan. Ani Duuchchi Woddik Gootti tenne haaso'ennen: Aninni muuxannon.›<verse eid="EZK 36:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="EZK 36:37" />«Lumok Duuchchi Woddiki Gootti hiyya'nee qici: Isra'eelike arda gargaarannoshsha haroba Isira'eelike arda'n hassemannon; arda insa'nekanna gedhebiinsha horoba assannon. <verse eid="EZK 36:37" /><verse number="38" style="v" sid="EZK 36:38" />Ayyaaniixxa barra Iyyerusaalemi tolchake shiqammake gedhebinni wo'mitammashsha kunni diigemeek qachchuwwi ardik wo'maan. Yoona! Diigememmak qachchuwwi heddi mannike galduma kadaan: Ookko'ni ani Duuchchi Woddike Gootta kadeneexxa insa'nenna egennaan.»<verse eid="EZK 36:38" /></para>
  <chapter eid="EZK 36" />
  <chapter number="37" style="c" sid="EZK 37" />
  <para style="s1">Dhooqati Giddo Tuulendeexxa Bagoxxa Miquwwa</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 37:1" />Duuchchi Woddike Goottiki Hafuur ane'ni dageexxi anee adhdheexxi dhooqa giddo ugge; dhooqatinna tuulendeexxe heddo miqenni wo'mitemman. <verse eid="EZK 37:1" /><verse number="2" style="v" sid="EZK 37:2" />Miquwwati giddo erqenna kayya anee mammarensiise; eettenne dhooqa giddonna yo'oshsha baggeexxi heddo miqe hexxemman. <verse eid="EZK 37:2" /><verse number="3" style="v" sid="EZK 37:3" />Isinna «Koo manjinke belto: tinni miqe langaxxa hedhoti hedha dandeeta?» hiyye anee qore.</para>
  <para style="p" vid="EZK 37:3">Aninna «Koo Lumoke Duuchchi Woddike Gootta; tenne egendattok ate callan» hiyyennen.<verse eid="EZK 37:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 37:4" />Ookkonechchi uduma isinna anee, «Tenne miqe'ni raaga hite raagatto qici, ‹Ha'no tee bagoxxe miqe Duuchchi Woddike Goottika hiyyichcho caqasse! <verse eid="EZK 37:4" /><verse number="5" style="v" sid="EZK 37:5" />Duuchchi Woddik Gootti tenne miqe: Ani ha'no'ni hafuura uggannon ha'nonna hedhoti hexxinaan. <verse eid="EZK 37:5" /><verse number="6" style="v" sid="EZK 37:6" />Mikitinka hidda ha'no'n uggennexxi maala hana oddeese gogik buqannon; ha'no giddonna hafuura uggannon; hedhoti hexxinaan Ani Duuchchi Woddike Gootta kaddennexxa egendinaan› hiyyi» hiyye ane'n haaso'e.<verse eid="EZK 37:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 37:7" />Tennexxee ajajemenneshanni wabeekumma haaso'ennen; raaga raagano wodda qaqa'weete laqende; miquwwatinna mitteba higge; miqe miqeti welti qence gence hiyyate'n kexxe. <verse eid="EZK 37:7" /><verse number="8" style="v" sid="EZK 37:8" />Aninna uudennen; tenne miqu'wwa'n miktinke hiddi hedhemmaba; maalikinna tenne miquwwa'n leelle'na'a gogikinna buqende; yanne kinni tenne miqquwwa giddo hafuur hedhemmaba'a.<verse eid="EZK 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 37:9" />Ookko'ninna ane'e hiyyee qici, «Koo manjinke belto; raaga raagi diidalote'ninna raaga raagi diidalotanna hite hitatto qici, ‹Lomok Duuchchi Woddik Goottinna tee diidallo; shoolinni darrexxe diidallo amo: kunni shiyemeer hedhot hedhaasha insa'ne'ni anee uffuu hiyyi› » hiyye. <verse eid="EZK 37:9" /><verse number="10" style="v" sid="EZK 37:10" />Tennexxee anee ajajemmashanni wabeekumma haaso'enneni: uffu hiyyememmaki hafuurinna insa'ne'ni e'yeen: hedhoti he'naake kande: yo'oshsha jabakenna lumo sannachcha kande ifixxe lekkan uurrine.<note caller="-" style="x"><char style="xo" closed="false">37:10 </char><char style="xt" closed="false"><ref loc="REV 11:11">Wal. 11:11</ref>. </char></note><verse eid="EZK 37:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 37:11" />Ookkoo'ni anee hiyyee qici: «Koo, manjinke belto Isira'eelik ardi duuchchi tenne miqeshshaten. Insa'ne, ‹Miqe no'oxxinna bagge'een; no'o hegere anfebe'no; yoona no'o'a ba'nenden.› <verse eid="EZK 37:11" /><verse number="12" style="v" sid="EZK 37:12" />Tennexxee raaga raagi, insa'nete hitato qic: ‹Lumok Duuchchi Woddik Gootti: Koo anke arda hirreessa ha'noka banannon, hireessa ha'nok giddii'ni ha'no fulchannon; Isira'eelike bogibaa illeema ha'no'o idagannon. <verse eid="EZK 37:12" /><verse number="13" style="v" sid="EZK 37:13" />Ookko'ninna koo anke arda hirreessa ha'noka banee ha'no'o fulchanno wodda ani Duuchchi Woddike Gootta kadennexxa egendinaan. <verse eid="EZK 37:13" /><verse number="14" style="v" sid="EZK 37:14" />Anka Hafuura ha'no giddo ugganon; ha'noona hedhoti hexxinaan; ha'nonge boga'n ofo'lishanon: Ooko'ni Ani Duuchchi Woddik Gootti haaso'eneshanni, muuxenexxa egendinaan Duuchchi Woddik Gootti tennee haaso'een.› »<verse eid="EZK 37:14" /></para>
  <para style="s1">Mitte Moyanjika Mitte Arda</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 37:15" />Duuchchi Woddike Goottik hiyyichchi ane'ni dage hiyyee qici: <verse eid="EZK 37:15" /><verse number="16" style="v" sid="EZK 37:16" />«Koo manjinke belto siqqichcho mitte aaxxetexxi ise hana, ‹Yihudaxxenna isike jaaluwwa Isira'eelike ardixxen› hite borreessi. Ookko'ninna wele siqqichcho aaxxetexxi ise hana, ‹Efreemixxe, Yooseefixxenna isike jaaluwwa Isira'eelike arda duuchchixxen› hite borreessi. <verse eid="EZK 37:16" /><verse number="17" style="v" sid="EZK 37:17" />Anga atixxe'n mitte siqqo kandaashsha tenne lame siqqo qence assite abid.<verse eid="EZK 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 37:18" />«Atike bogik ardi, ‹Iitta hiyyo atixxi maa hiyyote kaddeexxa kuldaboxo?› hine atee lanqaa wodda, <verse eid="EZK 37:18" /><verse number="19" style="v" sid="EZK 37:19" />insa'nee hitatto qici: ‹Lumok Duuchchi Woddik Gootti hiyya'nee qici: Efireemixxe anga'ni hexxexxa Yooseefixxa siqqichchonna jaaluwi isikixxa Isira'eelike mini hadiixxa siqqo aadhannon: Yihudaxxe siqqon welti mitteba qence asse mitte bifaxxe siqqo insa'nee assannon; Insa'nenna anxe anga'ni mitte siqqo kandaan.› <verse eid="EZK 37:19" /><verse number="20" style="v" sid="EZK 37:20" />Itti hana borreessitetaxxa siqqichchuwwa insa'nexxe anga abixxi. <verse eid="EZK 37:20" /><verse number="21" style="v" sid="EZK 37:21" />Insa'nenna hitatto qici: «Lumok Duuchchi Woddik Gootti hiyya'nee qici: ‹Isira'eelik ardi me'emmake gosa gosake ardixxe oddonaa'ni insa'nee fulchannon, booncho boonchogenaa'ni bukki asse insa'nenge bogiba'a idagannon. <verse eid="EZK 37:21" /><verse number="22" style="v" sid="EZK 37:22" />Isira'eelike ardike bogixxe koobuwwa'n mitte arda kandaashsha assannon; madada insa'neke'ni mitti moyanji calli mowaan: ta'in udumi'a lame arda kandabaan; ta'anni edi'anna lame lame mootummanna kandabaan. <verse eid="EZK 37:22" /><verse number="23" style="v" sid="EZK 37:23" />Miseelchchixxe fakkuwwa insa'nexxe'ni elobaxxe ifixxe hujuwwan insa'nexxe'ni yookaan wele cubbo'ninna kaddo ifi battosinabaan; Yaane kinni anee waalle hunjemmaxxe cubbo duuchchanaa'ni insa'nee anjirannon; qullonsannon. Insa'ne anke arda kandaan aninna Mageno insa'neke kadannon.<verse eid="EZK 37:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 37:24" />« ‹Anka garbichcha Daawwitishsha hedheek moyanji ha'no'n mowaan: duuchching mitte allalisanjo anfaan: seera ankanna hordofaan: anxa aadanna xonxommante heqqe'naan.<note caller="-" style="x"><char style="xo" closed="false">37:24 </char><char style="xt" closed="false"><ref loc="EZK 34:24">Hiz. 34:24</ref>. </char></note> <verse eid="EZK 37:24" /><verse number="25" style="v" sid="EZK 37:25" />Edik annuwwi ha'nok hedhemmake, garbichcho Ya'iqoobi'a uwwennake boga'ni he'naan. Ookkonna insa'ne, oose insa'nexxinna oose insa'nexxixxi oose, duuchchi woddi'a hexxaan; garbichcha anke Daawwitishsha hedheek moyanj duuchchi woddi'a insa'neke moyanjo kadaan. <verse eid="EZK 37:25" /><verse number="26" style="v" sid="EZK 37:26" />Insa'nenni welti nageiinxa kako aagannon; kako anixxinna duuchchi woddi'a hexxaan. Insa'nenna jabeessannon; biranna sa'issannon; galma ankanna insa'nexxe oddo'ni duuchchi woddi'a hedhaashsha assannon. <verse eid="EZK 37:26" /><verse number="27" style="v" sid="EZK 37:27" />Galdumi ankinna insa'nenni welti kadaan; aninna Mageno insa'neke kadannon; insa'nenna anke arda kandaan.<note caller="-" style="x"><char style="xo" closed="false">37:27 </char><char style="xt" closed="false"><ref loc="2CO 6:16">2 Qor. 6:16</ref>; <ref loc="REV 21:3">Wal. 21:3</ref>. </char></note> <verse eid="EZK 37:27" /><verse number="28" style="v" sid="EZK 37:28" />Galmi ankinna duuchchi woddi'a insa'nexxe oddo'ni hedhaa wodda, gosa gosak ardi ani Duuchchi Woddik Gootti Isira'eeli'i woyyonsa'ennexxa ege'nan.› »<verse eid="EZK 37:28" /></para>
  <chapter eid="EZK 37" />
  <chapter number="38" style="c" sid="EZK 38" />
  <para style="s1">Googi'ni Kulemeeka Wabeekumma</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 38:1" />Duuchchi Woddike Gootik hiyyichchi aniba'a dage hiyyee qici <verse eid="EZK 38:1" /><verse number="2" style="v" sid="EZK 38:2" />«Koo manjinke belto, ille atixxa Googi'ninna Maagogike boga'ni hedheeke Meesheekikininna tubbalike umo akeekisanjo'n Goggi'n: iso'ninna raaga raagi;<note caller="-" style="x"><char style="xo" closed="false">38:2 </char><char style="xt" closed="false"><ref loc="REV 20:8">Wal. 20:8</ref>. </char></note> <verse eid="EZK 38:2" /><verse number="3" style="v" sid="EZK 38:3" />Hitatto qici; Dada Duuchchiki Duuchchi Woddik Gootti hiyya'nee qici; ‹Koo, Moosahina Tubbalike umo akeekisanjo Googi ani ate'n ke'ennen. <verse eid="EZK 38:3" /><verse number="4" style="v" sid="EZK 38:4" />Ani ate'e udumi'a hiisannon, qeqqeshsha atike'ninna lugaama uggennexxi heddi sannachchinni welti, fadhaduwwa atika, fadhado qolchakaara, lolinka miya ba'edheeraraa, lumokanna shiixoka wonte abixeekaara, wolantichcha fi'weka duuchchinga fulchannon. <verse eid="EZK 38:4" /><verse number="5" style="v" sid="EZK 38:5" />Wonte abixeekaaranna umoke'n gulle uggu'dheeka duuchcha, Faarsi, Tophiyinna Fuuxxi insa'neni welti he'nann. <verse eid="EZK 38:5" /><verse number="6" style="v" sid="EZK 38:6" />Higgeen Goomeri'a lolinke sannachchi insa'nekinni welti, Beti Togaarmake qachchik middike sannachchinni welti hedhexxexxe heddo gosa gosaka arda atinni welti fulchannon.<verse eid="EZK 38:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 38:7" />« ‹Atinna qarqara atike'ni bukki hiyyeki duuchchi ke'we: qophpheefatte; atinna insa'neke akeekisanjo kadi. <verse eid="EZK 38:7" /><verse number="8" style="v" sid="EZK 38:8" />Heddo barra uduma lolake'e ye'endatton. Udumike baro'ni lolakenaa'n hafuura adhdhiteexxe, iseke gosa gosake heddi ardi giddii'ni fuleexxi, heddo yanna'a ona kaddemmake Isira'eelixe kooba'ni hana bukki hiyyeke ardike bogiba'a daganno. Insa'ne heddo gosa gosake ardi giddii'ni fulle kunni duuching ta'a nage'ik he'na'neen. <verse eid="EZK 38:8" /><verse number="9" style="v" sid="EZK 38:9" />Atinna atik lolink manni duuchchi atinni welti hedheeki heddi gosa gosak ardi danbala'insha dagaan; duumanchiishshanna boga buqqinaan.<verse eid="EZK 38:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 38:10" />« ‹Lumok Duuchchi Woddik Goottinna eettene barra hedumi ate'ni qalbete'ni dagaan; fuggo yaane assatee heddatton. <verse eid="EZK 38:10" /><verse number="11" style="v" sid="EZK 38:11" />Atinna; «Dalla'a afebaaka qachchuwwike bogi'a dagannon: duuchching dalla'i belo, cufani belonna sibiljinke danqarsanji belo hedha'neka, nage'inkanna soda'a belo hedheeka arda lolannon: <verse eid="EZK 38:11" /><verse number="12" style="v" sid="EZK 38:12" />Edi wodda urmake kedemmake qachchuwwa'n hedheeka, gosa gosake ardi giddii'ni bukki hiyye'eka, horkinna gargar hedheeke miyinni duromeeka buttatixxe ha'nurake bogi giddo hedheka arda lolannon, booji'annon mulqedhannon» hittatton. <verse eid="EZK 38:12" /><verse number="13" style="v" sid="EZK 38:13" />Saabanna Dedaani, Terseesixxi daddalisanonna olla'uwwik qachchuwwi duuchchi ate'e hiyyaa qici, «Mulqitotta'a daggete? Boojitotta'a sannachcha bukki assexxeette, worqenna sibljo birre, hore, daddalatika miyuwwa gudhdhite me'itota'a, heddolchcho bojitotaate?» › hiyye.<verse eid="EZK 38:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 38:14" />«Tennexxee koo manjinke belto, raaga raagi: Googinna hitatto qici, ‹Dadada Duuchchik Duuchchi Woddik Goottinna eettene barra Isira'eelik anki ardi nage'ik ofo'leexxa egendeboxxo? <verse eid="EZK 38:14" /><verse number="15" style="v" sid="EZK 38:15" />Middi darree'n bayya hedheeke boonchonaa'n daggatton: atinna atinni welti heddi gosa gosak ardi jabak hunnaameesi sannachchi duuchching fadhado gulufinne dagginaan. <verse eid="EZK 38:15" /><verse number="16" style="v" sid="EZK 38:16" />Duumanchi boga buqqammashsha arda anke Isira'eeli'ni bobbatatton. Koo Googi insa'ne edii'ni woyyumma anxa leellishanno wodda gosa gosak ardi ane'e ege'naashsha udumike baro'ni boga anke'ni atee idaganon.<verse eid="EZK 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 38:17" />« ‹Dada Duuchchik Duuchchi Woddik Goottinna edike baro'ni garboole anxe Isira'eelixxi wabeekko haasonaki ikki manjichchi atendemmabaataa? Eettene yanna'ni atee insa'ne'ni ergaaxxa heddo wogga wabeekumma haasonnene. <verse eid="EZK 38:17" /><verse number="18" style="v" sid="EZK 38:18" />Eettene yanna'ni, Googi Isira'eelika boga lollaa wodda, jabaxxi anxi mufenna kexxaan hiyya'neeni lumok Duuchchi Woddik Gootti. <verse eid="EZK 38:18" /><verse number="19" style="v" sid="EZK 38:19" />Eettene yanna'ni hinaaffe anixxenna mufe anxenni Isira'eeli'n jabaxxi buttiniinxi lele'ma kaddaan hiyyee haaso'ennan. <verse eid="EZK 38:19" /><verse number="20" style="v" sid="EZK 38:20" />Abbayya giddixxi quluxu'muwwa, iimatixxi ci'uwwa, bogi giddo hedheek biniichuwwinna hori, butta harkisenda'nexxi daduwwa, iittanni buttate'n hedheek manji duuchchi ani edo culphisaan koobuwwa fottoqqaan bowa'uwwikinna tigaan; kinjik dalla'uwwi duuchinna fottoqaan. <verse eid="EZK 38:20" /><verse number="21" style="v" sid="EZK 38:21" />Koobuwwa anxe duuchcha'ni Googi'n wolaantichcha ergannon; hiyya'neen lumok Duuchchi Woddik Gootti; mitti mittinge manjik wolaantichchi dayyo ifinge itaan. <verse eid="EZK 38:21" /><verse number="22" style="v" sid="EZK 38:22" />Shiyaaka dhukuba idagatinna munde dhangalaasati iso'ni murannon; jabaka xeena, kaadetanna giiratishsha ha'itaaxxa dinne<note caller="+" style="f"><char style="fr" closed="false">38:22 </char><char style="ft" closed="false">Jinne hiyyemachi baaxxit bifaxxe, ikki woddi giirate'n rakke ha'yacho hixanisha hexxeexxe bullen. </char></note> iso'ninna lolinke sannachcha isike'ni, ittanni isinni welti hehdeeke gosa gosatike arda'ni ibisannon. <verse eid="EZK 38:22" /><verse number="23" style="v" sid="EZK 38:23" />Ookko'o lumminne ankanna woyyumma anxa leellishannon; heddo gosa gosake ardi edo ifi ege'nishannon; ooko'ninna Ani Duuchchi Woddike Gootta kadennexxa egennaan› hiyye.<verse eid="EZK 38:23" /></para>
  <chapter eid="EZK 38" />
  <chapter number="39" style="c" sid="EZK 39" />
  <para style="p">
    <verse number="1" style="v" sid="EZK 39:1" />«Koo manjinke belto, Googi'ni raaga raagi hitatto qici: ‹Dada Duuchchik Duuchchi Woddik Gootti: Koo Meesheekikenna Tubbalike umo akeekisanjo koo Googi; ani ate'ni qophphi hiyye ke'ennen. <verse eid="EZK 39:1" /><verse number="2" style="v" sid="EZK 39:2" />Ate'e udumi'a hiisannon; iittanni middi darree'n bayyii'n harkisa'ni idage Isira'eelixxe iimixxe koobabaa atee shorrannon. <verse eid="EZK 39:2" /><verse number="3" style="v" sid="EZK 39:3" />Bita'ixxe anga atixxe'ni hexxeexxa gabe angii'ni ganannon; middixxe anga'ni abiddeteka mogiduwwa ibisannon. <verse eid="EZK 39:3" /><verse number="4" style="v" sid="EZK 39:4" />Atinna loliink atik manni duuchchi, atinni welti hedhemmak gosa gosak ardiir Isira'eelixxe kooba'ni mundaan. Allaattuwwanna biniichuwwi ha'noo itaashsha sa'isse uwwannon. <verse eid="EZK 39:4" /><verse number="5" style="v" sid="EZK 39:5" />Atinna ba'linake'n rertatton: tenne haaso'ennekinna anten hiyya'neen lumok Duuchchi Woddik Gootti. <verse eid="EZK 39:5" /><verse number="6" style="v" sid="EZK 39:6" />Maagoginna soda'a mittebelo abbayyati qarqara'ni hedha'nekeera'ni giira worannon; insa'nenna ani Duuchchi Woddike Gootta kadennexxa egennaan.<verse eid="EZK 39:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 39:7" />« ‹Woyyichchi anki summi arda anke Isira'eeli'ni ege'nemaashsha assannon; Ta'inni udumi'a woyyichchi anki summi cee'memo'anna, diqqaatemo'a hasabe'non; gosa gosak ardinna ani Duuchchi Woddik Gootta Isira'elike woyyichcha kadennexxa ege'naan. <verse eid="EZK 39:7" /><verse number="8" style="v" sid="EZK 39:8" />Yoona tinni yaanuwwa daggaan; dhugandinni muuxxendaan; hiyya'nen lumok Duuchchi Woddik Gootti; iitti hiyyennaxxi barra tenneten.<verse eid="EZK 39:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 39:9" />« ‹Ookko'ninna Isira'eelike qachcha'ni hedha'neer duuchchi dageexxi lolinka imaana ifika, lumollamanna shishiixaramma wonte, gabuwwa, mogiduwwa, lollinxa siqqonna bagedo bukki asse'naan; torbaane wogga'anna haqqete la'onffantaan. <verse eid="EZK 39:9" /><verse number="10" style="v" sid="EZK 39:10" />Insa'ne loliinka ifika imaanuwwa giidhinammaxxee; woldeennatenaa'n haqqe qocanna gongomakenaa'ni haqichcho kadhdha insa'ne'a hasisaabaan. Insa'ne mulqemmakeeranaa'n insa'nenna mulqe'naan; insa'nee booji'emmakeeranaa'ninna insa'nenna boojinaan: tenne haaso'ek Duuchchi Woddike Goottan.<verse eid="EZK 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 39:11" />« ‹Eettene barra'ni ardi dhidhimii darree'ni abbaayyatiba'a me'inammaxxe dhooqaba, Googi'a mooginka booncho Isira'eeli'ni uwwannon. Googinna isik sannachchuwwi duuchchi ookkonni moogemammaxxe ora cunfee'naa me'ammaki manni sa'aba gophaan; Tennexxee eettene bakka Hamon Googixxe<note caller="+" style="f"><char style="fr" closed="false">39:11 </char><char style="ft" closed="false">Hamon Googi hiyyo Googike sannachcha hiyyoten. </char></note> dhooqa hiyyennan.<verse eid="EZK 39:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 39:12" />« ‹Boga qullo fulchate'e Isira'eelik ardi torbaane agenjo duuchcha insa'neka rensha moongaan. <verse eid="EZK 39:12" /><verse number="13" style="v" sid="EZK 39:13" />Bogi giddik ardi duuchchi rensha moogaan; ani ulfatannoxxa yanna insa'ne hedemmaaxxe barra kaddaan; tenne haaso'ek lumoke Duuchchi Woddike Goottan.<verse eid="EZK 39:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 39:14" />« ‹Boga qullossatee gateeka renshuwwa barra barra'n hasakaaranna moogaa manna dhaanbaan. Torbaane agenji udumanna moogemebaak gateekaara qullesatee hasitto ke'naan. <verse eid="EZK 39:14" /><verse number="15" style="v" sid="EZK 39:15" />Kunni manni hasito ma'a wodda manjiinka rensha afoole moogaki manni dageexxi Hamon Googixxe dhooqa'n moogaa qico'n renshii qarqara beesissa ugginaan. <verse eid="EZK 39:15" /><verse number="16" style="v" sid="EZK 39:16" />Ookkonna Haamo hiyyemaak qachchi hedhaan; konne qicinin boganna qulleensinaan.›<verse eid="EZK 39:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 39:17" />«Koo manjinke belto; Dada Duuchchk Duuchchi Woddik Gootti hiyya'nee qici: Gargar hexxeexxe ci'anna biniincha duuchcha ye'i: ‹konnechchuwwanna erqe kayyii'ni bukki hitineexxi ani ha'no'a qixxeessannoke tolchibaa amme; tinninna Isira'eelixxe kooba'ni kadaake lumoke tolchan. Ookkone maala ittinaan; mundetanna ha'witinaan.<note caller="-" style="x"><char style="xo" closed="false">39:17 </char><char style="xt" closed="false"><ref loc="REV 19:17-18">Wal. 19:17-18</ref>. </char></note> <verse eid="EZK 39:17" /><verse number="18" style="v" sid="EZK 39:18" />Gedhebinke korbeessika gedhebinke buruusika; re'etike korbesika kormika, maala indammashsha jajaba mannika maala iitinaan; buttatike ja'labuwwixxa mundenna ha'witinaan; insa'ne duuchchi ha'yeeke Baasanike horishshaten. <verse eid="EZK 39:18" /><verse number="19" style="v" sid="EZK 39:19" />Ani qopheessannoke tolcha'ni ha'yotanna godditinaxe'e ittinan: machootinaa qico'n mundetanna ha'witinaan. <verse eid="EZK 39:19" /><verse number="20" style="v" sid="EZK 39:20" />Anxe qore'ni fadhadokanna fadhado qolchammakaara, jajjabba hunnameessa mannanna gosa gosanaa'ni filemeeka lolinka manna godditinaaxee ittinaan› Tenne haaso'ek lumoke Duuchchi Woddike Goottan.<verse eid="EZK 39:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 39:21" />«Ulfinna anka gosa gosake ardi giddo leellishannon: gosa gosak ardi duuchchinna insa'ne'ni geessisenneka xixichchonna insa'ne'ni hunnameette anxe anganni hitta murannoxxa uundaan. <verse eid="EZK 39:21" /><verse number="22" style="v" sid="EZK 39:22" />Eettene yannanaa'ni Isira'eelik ardi ani Duuchchi Woddike Gootta insa'neke Mageno kadennexxa egennaan. <verse eid="EZK 39:22" /><verse number="23" style="v" sid="EZK 39:23" />Gosa gosak ardi Isira'eelik ardinna hujemmaxxe cubbonaa'ni kexxeexxa ane'ni addatema gophexxi shorremeexxa egennaan; Tennexxee aninna insa'ne'n duduro sho'edhenne; aninna naapha insa'negee sa'isse uwwennen; duuchchingi wolaantichchake'n munde. <verse eid="EZK 39:23" /><verse number="24" style="v" sid="EZK 39:24" />Aninna battumma insa'nexxishshanninna cubbo insa'nexxishshanni murennen; dudurokanna insa'ne'n wirri hiyyenne.<verse eid="EZK 39:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 39:25" />«Tennexxee Dada Duuchchk Duuchchi Woddik Gootti hiyya'nee qici, Ya'iqoobixxa horte ta'a shorremmebaa'n hiissannon: Isira'eelik ardi duuchchi'a mararannon; woyyichcha anke summixxe hinaafanno. <verse eid="EZK 39:25" /><verse number="26" style="v" sid="EZK 39:26" />Mitti insa'ne sodaachchisaachchi hedhebangi boga insa'neke'ni nage'iki he'naa wodda, salphinne insa'nekanna ane'ni addatema gophati he'neeka baro deenaani. <verse eid="EZK 39:26" /><verse number="27" style="v" sid="EZK 39:27" />Gosa gosake ardike boganaa'ni insa'nee hiisse idaganno wodda, naaphuwwa insa'nekike boganaa'ni bukki assannoxxa yanna anxa woyyummanna insa'ne darree'ni heddo gosa gosake ardi edo leellishannon. <verse eid="EZK 39:27" /><verse number="28" style="v" sid="EZK 39:28" />Gosa gosake ardi giddo shorremashsha assonnolenna, mittikinna gantebang ifike bogiba'a insa'ne'e hiissannon; Ookko'ninna ani Duuchchi Woddike Gootta insa'neeke Mageno kadennexxa egennaan. <verse eid="EZK 39:28" /><verse number="29" style="v" sid="EZK 39:29" />Ta'inni udumi'a duduro insa'ne'n wirri hiyyabo'non; Hafuura ankanna Isira'eelike arda'n wonshannon; tenne haaso'ek lumoke Duuchchi Woddike Goottan» hiyye.<verse eid="EZK 39:29" /></para>
  <chapter eid="EZK 39" />
  <chapter number="40" style="c" sid="EZK 40" />
  <para style="s1">Haaroke Galmixxa Waleella</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 40:1" />Boji'emmennexxe lame tommenna ondixxe wogga'ni, woggatike siretike agenjo'n, tommeesoxxe barra'ni, Iyerusalemik qachchi ibeexxe tommenna shoolgaxxe wogga'ni, eettene barra'ninni Duuchchi Woddike Goottixxi hunna ane'ni hexxemman; Isinna ookko'a ane'e idage. <verse eid="EZK 40:1" /><verse number="2" style="v" sid="EZK 40:2" />Magen waleellati Isira'eelike bogibaa anee iyyemare: yo'oshsha qeerraxxe kooba'ni anee uggen; koobateba'n bita'i darre'n, qachcha fakkaataak qeerrarrammi kinjiink minuwwi hedhemman.<note caller="-" style="x"><char style="xo" closed="false">40:2 </char><char style="xt" closed="false"><ref loc="REV 21:10">Wal. 21:10</ref>. </char></note> <verse eid="EZK 40:2" /><verse number="3" style="v" sid="EZK 40:3" />Ookko'anna anee iyemare; bifa sageetotike sibljishsha ifaaka manjichcho uudenne; isinna suqemeeke fuutixxa wodaronna miketixxa siqichcho abixxe wudumete'n uurre'emman.<note caller="-" style="x"><char style="xo" closed="false">40:3 </char><char style="xt" closed="false"><ref loc="REV 11:1">Wal. 11:1</ref>; <ref loc="REV 21:15">21:15</ref>. </char></note> <verse eid="EZK 40:3" /><verse number="4" style="v" sid="EZK 40:4" />Manjichchikinna anee hiyyee qici, «Koo manjinke belto uudi: mansha atixxinni laqi: leellishaannexxanna duuchcha qalbeeffati; tennexxeeten Mageni kaba atee idage'eechchi; tennee uudettexxa duuchcha Isira'eelike arda'n haaso'i» hiyye.<verse eid="EZK 40:4" /></para>
  <para style="s1">Boroti Darrexxa, Siretike Dalla'ixxa Wuddume</para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 40:5" />Galmiinxa dowwe duuchcha buqeeka dalla'a uudennen; manjichiinxe anga'ninna qeerrinni jaane ciqilenna taakko gelteexxa miketixxa siqichcho uudennen; mitte mittendi ciqile taakko affe'emman; isinna dalla'a mikee wodda furdinne mitte miketixxa siqichcho, hojjatinna iittanni mitte miketixxa siqichcho kadde.<note caller="-" style="x"><char style="xo" closed="false">40:5—42:20 </char><char style="xt" closed="false"><ref loc="1KI 6:1-38">1 Moy. 6:1-38</ref>; <ref loc="2CH 3:1-9">2 Odo. 3:1-9</ref>. </char></note><verse eid="EZK 40:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 40:6" />Ookkoo'n boroti darre edo hexxeexxe wudumeba dage; hulatika hadhisanjo da'meexxi wundumetixxe hulaxxa buttixxe gubaneka godoba mike; isenna mitte miketixxe siqichchomman. <verse eid="EZK 40:6" /><verse number="7" style="v" sid="EZK 40:7" />Heqqanjuwwiink minuwwi, ejjuma mitte mitte miketixxe siqichcho, furdinenna mitte mitte miketixxe siqichchomman; minuwwinxe oddo oddo'ni hexxeexxe mitte mitte gimok furdinninna onde onde ciqilemman. Galmiba'a me'iyyotee buttike hadhisanjixxe sorok godobi mitte miketixxe siqichchomman.<verse eid="EZK 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 40:8" />Ookko'ni e'yatixxe hulaxxe wuddummexxa soro mike; <verse eid="EZK 40:8" /><verse number="9" style="v" sid="EZK 40:9" />Godobikinna saddeetta ciqile, iseke utuphuwwik furdinninna lame ciqilemman. E'yatixxe hulake wuddummexxi soro, galminii albi edomman.<verse eid="EZK 40:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 40:10" />Dalla'inxe hulaxxa boroti darrexxa heqanjuwwiinxe kuttuwwaxxi middixxinna bita'ixxi kutuwwa weli qixxete kaddeexxi lami darre'n sase sase heqqanjuwwinke minuwwa hedhemman; minuwwinxe oddo oddo'n hexxemmaxxe gimoxxi mike welqixxetemman. <verse eid="EZK 40:10" /><verse number="11" style="v" sid="EZK 40:11" />Ookko'ni e'yatixxe hulaka godoba tomme ciqile, iseen giddi'a me'aake orika godobanna tommenna sase ciqile mike. <verse eid="EZK 40:11" /><verse number="12" style="v" sid="EZK 40:12" />Mitte mittinge heqqanjuwinke mini edi darre qeerrinne mitte mitte ciqile furdinne mitte mitte ciqile kaddaaxxe gimo hexxemman; mitte mitte kutak duuchchi darrek qeerinni jaane jaajne ciqilemman. <verse eid="EZK 40:12" /><verse number="13" style="v" sid="EZK 40:13" />Ookko'n mitte heqanjinke minixxe udumixxe gimonaa'n wele gimo qico'n hexxeexxa e'yatixxe hulaxxa kuta mike; mitte kutaxxe udumixxe gimonaa'n ise kallachcha'n hexxeexxe kutaxxe udumixxe gimo qico'n hedheek bayyinni lame tommenna onde ciqilemman. <verse eid="EZK 40:13" /><verse number="14" style="v" sid="EZK 40:14" />Galmiba'a e'yatixxe hulaxxe soro gami gamixxa gimo mike; mitte mitte gimok qeerrinni jaane jaane tomme ciqilemman; mikemebinna wuddumeti edi darre hexxeexxe soron. <verse eid="EZK 40:14" /><verse number="15" style="v" sid="EZK 40:15" />Edixxe eyatixxe wuddumenaa'n giddixxe hulaxxe soroti qico hedheek qeerrinni onde tomme ciqilemman. <verse eid="EZK 40:15" /><verse number="16" style="v" sid="EZK 40:16" />Heqanjuwwiinxi kutuwwanna isixxi gimuwwa giddi darre dowwe'n sorote'n hexxemmaxxixxa shixxaramma masikootuwwa affe'een. E'yatixxe hulake middi bita'ixxi gi'mo'n meexxetike haqichchixxe misile giissende'emman.<verse eid="EZK 40:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 40:17" />Ookko'ninna siretike dalla'ixxe baxxeba'a anee idage; ookkonna wuddummetixxe dowwe'n ijaarendeexxa kutuwwanna kinji fayemeeka ora uudennen; ookkone orixe dowwe'n sase tomme kutuwwa hexxemman. <verse eid="EZK 40:17" /><verse number="18" style="v" sid="EZK 40:18" />Ikki or aadi darre dala'inxi hulanni welti abidiseme hujemeeke kadaa wodda godobikinna dalla'inxe hulake qeerrininni qixxetemman. <verse eid="EZK 40:18" /><verse number="19" style="v" sid="EZK 40:19" />Ookko'ni aadi darrexxe hulabaa'n, langaxxe wuddume qico'n hedheeka bayyinne mike; kunninna boroti darre'ninna kadi middi darre'n hedheek bayyinni mitte dhibba ciqilemman.<verse eid="EZK 40:19" /></para>
  <para style="s1">Middixxa Hula</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 40:20" />Ookko'ninna middi darre edo hexxeexxi siretixxe wuddumeba'a geessissaaxxe hulaxxa qeerrinnenna godoba mike. <verse eid="EZK 40:20" /><verse number="21" style="v" sid="EZK 40:21" />Tinni heqajuwwinxi wuddumenna middi bita'n sase sase kuttuwwa affe'emman; kutuwwatixxe oddo oddo'n hexxeexxi gimonna hulatixxe sorok siretixxe wuddummexxe mikenni qixxetemman; qeerrinnikinna onde tomme ciqile godibi lame tommenna onde ciqile. <verse eid="EZK 40:21" /><verse number="22" style="v" sid="EZK 40:22" />Isixxi masikootuwwa, wuddumetixxi soronna meexxetixxe haqquwwaxxe misilexxi mike borotixxe hulaxxenni qixxetemman. Ookko'a qabatatee torbaane hadhisanjo hedhemman; hadhisanjii albi edi darre dalla'inixe wuddumeke kasa'n sorote hexxemman. <verse eid="EZK 40:22" /><verse number="23" style="v" sid="EZK 40:23" />Middi darrexxe hulaxxe soroke kallachcha'n, boroti darrexxe hula'n hexxeexxi wele langaxxe wuddumeba geessissaaxxe hula hexxemman; manjichchikinna tenne lame hulaxxe oddo'n hedheeka bayyine mikee wodda dhibba ciqile kade.<verse eid="EZK 40:23" /></para>
  <para style="s1">Bita'ixxa Hula</para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 40:24" />Ookko'ninna bita'i darre'n anee idage: ooko'ninna bita'i darre'ni wirri hiteexxa hula uudennen; Iseka utuphanna wuddummexxa soro mike; miketinna wele hulaxxe gimonninna utuphinni qixxetemman. <verse eid="EZK 40:24" /><verse number="25" style="v" sid="EZK 40:25" />Heqqanjuwwinxe hula'ininna wuddummetixxe qarqara'ni masikoote affeemman: qeerrinne onde tomme ciqile; godobi lame tommenna onde ciqilemman. <verse eid="EZK 40:25" /><verse number="26" style="v" sid="EZK 40:26" />Wuddumetixxe soroke kallacha'n hedheek torbaan iimi'a da'minammak hadhisanji e'yatixxe hulaba'a geessisaan; gami gamii'ni hedheek hulatixxe gomo'n meexxetixxi misile hexxeen. <verse eid="EZK 40:26" /><verse number="27" style="v" sid="EZK 40:27" />Langaxxi wuddume kinni bita'i kinni welti weli fakkaataxxa hula afeen; isinna tenne hulanaa'ni ke'isse bita'i darre'n hexxexee gadhixxe hula qico'ni mike; tinninna mitte dhibba ciqilemman.<verse eid="EZK 40:27" /></para>
  <para style="s1">Langaxxe Wuddummexxa Huluwwa</para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 40:28" />Ookko'ninna bita'ixxe hula darre'n langaxxe wuddume giddi'a anee idage; bita'i darrexxa hulanna mikee wodda wele huluwwanni qixxetemman. <verse eid="EZK 40:28" /><verse number="29" style="v" sid="EZK 40:29" />E'yatixx ehula heqqanjuwwik minuwwinni welti, oddo oddote'n hexxemmaxxi gimuwwanna soro wele huluwanni qixxetemman. E'yinammaxxi hulanna isexxi soro dowwete'n masikootuwwa affe'emmani. Heqqanjuwiinke minuwwinna isixxe sorok qeerrinni onde tomme ciqile, godobi lame tommenna onde ciqilemman. <verse eid="EZK 40:29" /><verse number="30" style="v" sid="EZK 40:30" />Langaxxe wuddume qarqara'ni hexxeexxe edixxe hulatixxe soruwwak qeerrini lame tommenna onde ciqilen, godobi kinn onde ciqilemman. <verse eid="EZK 40:30" /><verse number="31" style="v" sid="EZK 40:31" />E'yatixxe hula heqqanjuwiinke minuwwixxi soro takkaxxe wuddume albi edomman; meexetike haqichchi utuphuwwi hana giissemeemman; e'yatixxe hulaba geessisaak saddeeta lekati hadhisanjo hedhemman.<verse eid="EZK 40:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 40:32" />Ookko'ninna boroti darree'n langaxxe wuddumeba'a anee idagee e'yinammaxxa hulanna mike wodda wele huluwwanni qixxetemman. <verse eid="EZK 40:32" /><verse number="33" style="v" sid="EZK 40:33" />E'yatixxe hulak heqqanjuwwike minnuwwinni welti, oddo oddote'n hexxemaxxi gimuwwanna soro wele huluwwanni qixxetemman; e'yatixxi hula heqqanjuwwiinke minuwwanna gimmuwwaxxe dowwe'n maskotuwwa hexxemman; isek qirrinni onde tomme ciqilen, godobi lame tomme ciqilemman. <verse eid="EZK 40:33" /><verse number="34" style="v" sid="EZK 40:34" />E'yatixxe hula heqqanjuwiinke minuwwixxi soro taakkaxxe wuddume albinnii edomman; meexxetike ehaqichchike utuphuwwi hana giissende'emman; e'yatixxe hulaba geessisaak saddeeta lekati hadhisanjo hedhemman.<verse eid="EZK 40:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 40:35" />Ookko'ninna middi darrexxe hulaba'a anee aadhe dage mikee wodda wele huluwwanni qixxetemman. <verse eid="EZK 40:35" /><verse number="36" style="v" sid="EZK 40:36" />E'yatixxi hula heqqanjuwwike minuwwin welti, oddo oddote'n hexxemmaxxi gimuwwanna soro wele huluwwanni qixxetemman. Hexxemaxxi gimuwwa dowwete'n masikotuwwa affemman; soro wele huluwwanni qixxetemman; qeerrinni onde tomme ciqile, godobikinna lame tommenna onde ciqilemman. <verse eid="EZK 40:36" /><verse number="37" style="v" sid="EZK 40:37" />E'yatixxe hula heqqaanjuwinke minuwwixxi soro taakkaxxe wuddume albinnii edomman; meexxetike haqichchi utuphuwwi hana gisende'emman; e'yatixxe hulaba geessisaak saddeeta lekati hadhisanjo hedhemman.<verse eid="EZK 40:37" /></para>
  <para style="s1">Tolcha Qopheessatixxa Kutuwwa</para>
  <para style="p">
    <verse number="38" style="v" sid="EZK 40:38" />Mitte mittendi giddi darre e'yatixxe hulaxxe wuddumetixxe soro bira, ciincatika tolcha anshecatixxe kutaxxi hula hexxeen. <verse eid="EZK 40:38" /><verse number="39" style="v" sid="EZK 40:39" />E'yatixxe hula'n hexxeexxe wuddummexxe soro hunda middi bita'ii'n ciincessinaaka tolcha, cubbotikanna balleessati tolcha dullaab lami lami beeruwwi hedheen. <verse eid="EZK 40:39" /><verse number="40" style="v" sid="EZK 40:40" />E'yatixxe hula'n hexxeexxe wuddummexxe sorobaa'n gadhi darrexxe gimo'n middi darrexxe hulake hadhisanji bira middi bita'ii'ni lami lami beeruww hedheen. <verse eid="EZK 40:40" /><verse number="41" style="v" sid="EZK 40:41" />Tennexxee mitte darre'ni shooli wele darre'n shooli beeruwwi tolchiinka hore hana gora'ate mitteba saddeeta beeruwwa hedhemman. <verse eid="EZK 40:41" /><verse number="42" style="v" sid="EZK 40:42" />Ciincatike tolchi'a la'o uwwa'neka miyuwwa, bonceexxe kinonaa'ni hunjeexxa shooli beeruwwi hedhemman: mitti mittingixxi ejjuma mitte ciqile; godobinna qeerrinni mitte ciqilenna gamisa; konne beeruwwi hana ciinceessina'neke tolchanna wele tolcha gorra'atee kaadkinna miyuwwi hedhaamman. <verse eid="EZK 40:42" /><verse number="43" style="v" sid="EZK 40:43" />Iittanni mitte taako kadaak lame dhanko afe'ek cunnichchuwwi gimotixxe dowwe'ni rarra'emman; beeruwwikinna tolchinka maala ugginammake boonchomman.<verse eid="EZK 40:43" /></para>
  <para style="s1">Qeesoletee Uwwendeexxa Kutuwwa</para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 40:44" />Giddi darrexxe wuddume'n giddixxe hula gadho, lame kuta hexxemman; mitti bita'ii'ni albinii edo middixxe hula darree'ni, weli middii'ni albinii edo bita'ixxe hula darre'nitemman. <verse eid="EZK 40:44" /><verse number="45" style="v" sid="EZK 40:45" />Isinna ane'e hiyyee qic, «Bita'i darre'n wirri hiteexxi kuta galmi giddo ergatendammaxxe qeeseke, <verse eid="EZK 40:45" /><verse number="46" style="v" sid="EZK 40:46" />middi darre'n wirri hiteexxi kuta kinni tolchimalchi hana ergatenda'neexxe qeesolexxen. Tinniirinna Saadoqixxe oose kaddaa wodda, Duuchchi Woddike Gootti edo shiqqe ergatema dandeettaxxi leewwitotenaa'n insa'ne callan» hiyye.<verse eid="EZK 40:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="EZK 40:47" />Ookko'ni wuddumme mike; qeerrine lame dhibba ciqile, godobikinna dhibba ciqileke shoolini kasi weli qixxetemman. Tolchimalchikinna galminii albi edo hedhemman.<verse eid="EZK 40:47" /></para>
  <para style="s1">Woyyichcha Galma</para>
  <para style="p">
    <verse number="48" style="v" sid="EZK 40:48" />Manjikinna galmiinxe soroba'a anee idage; sorotika utuphuwwa mikee wodda mitte darre'n onde ciqile wele darre'ninna ittanni onde ciqilemman. E'yatixxi hulak godobi tommenna shoole ciqile, gama gamake'n hexxeexxe gimok ba'linni mitte darre'ni sase ciqile, wele darre'ninna ittanni sase ciqilemman. <verse eid="EZK 40:48" /><verse number="49" style="v" sid="EZK 40:49" />Sorotixxe wuddume qeerrini lame tome ciqile, edii'ni udumi qico'ni hedheek godobink ba'linni tommenna lame ciqile, edii'ni udumi qico'ni hedheek godobi tommenna lame ciqilemman. Galmi giddi'a e'yatike hadhisanjo afe'eken; erqenna kayyiki kasa kasake'n utuphuwwi hedhemman.<verse eid="EZK 40:49" /></para>
  <chapter eid="EZK 40" />
  <chapter number="41" style="c" sid="EZK 41" />
  <para style="p">
    <verse number="1" style="v" sid="EZK 41:1" />Ookkonechchi uduma ane'e galmi giddi'a e'yisheexxi utuphuwwakanna mike; utuphuwwiik godobi mitte darre'ni jaane ciqile, wele darre'ninna jaane ciqilemman. <verse eid="EZK 41:1" /><verse number="2" style="v" sid="EZK 41:2" />Hulatik godobinna tomme ciqile kadaa wodda, gami gamiinxe gimok godobinna onde onde ciqilemman. Iittanni giddi darre'n galma mike; qeerrini shoole tomme ciqile kadaa woda, godobi lame tomme ciqilemman. <verse eid="EZK 41:2" /><verse number="3" style="v" sid="EZK 41:3" />Ookkonechchi uduma galmi giddi'a sa'eexxi e'yatixxe hulaka utuphuwwa mike; mitte mittiniingik godobi lame ciqilemman. Hulatik godobinna jaane ciqile kadaa woda, erqe kayyixxe gimok godobinna torbaane ciqilemma'a. <verse eid="EZK 41:3" /><verse number="4" style="v" sid="EZK 41:4" />Isinna galma giddidarree'n mike; qeerrini lame tomme ciqile kadaa wodda godobi gadhixxe gimoninni mitteba lame tomme ciqilemman; Isinna ane'ni, «Tinni bakka woyyitte woyyon» hiyye.<verse eid="EZK 41:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 41:5" />Ookkonechchi uduma galmiinxa gimo mike; furdini isekinna jaane ciqilemman; galminxe, dowwe'n hexxeexxi mitte mittinxe kutak godobi shoole ciqilemman. <verse eid="EZK 41:5" /><verse number="6" style="v" sid="EZK 41:6" />Tinni kuttuwwanna weli hana jaarendeexxe sase fooqexxe kaddeexxi mitte mitte fooqe'n sase sase tomme kutuwwa hexxemman; ise iimi'a kiphphe abideexxe, galmixxe gimoxxe dowwe'n abidisendeexxe kifafe'n ofoldemman. <verse eid="EZK 41:6" /><verse number="7" style="v" sid="EZK 41:7" />Galmiinxi butti darrexxi gimo iimi darrexxenaa'n furdaxxen; kaddo malee gadhii'n uudemmaa wodda iimi butti qico'n hexxeexxe gimok furdinni welqixxe fakkaataan; gimo butti darree'ni iimi'a me'itexxe qixxe'n qa'lata'n me'ite'emaxxe'e iimi'a me'eteexxe qixxe'n kutuwwa ba'lata'ne me'itaan; Buttii'n keexxi oddotixxe fooqe giddii'n sa'exxi iimixxe fooqe qico'n iyemaraak hadhisanji hedhemman.<verse eid="EZK 41:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 41:8" />Galmikinna dowwe ifixxe'n hojja tagagi hiteexxa ijaarendeexxa booso afeexxa uudenne; tinninna kasa kaske'n hexxemmaxxe kutuwwaxxe booso kadda wodda qeerrine qeerrinni jaane ciqilenna taakkotemmanni; tinninna miketixxe siqichchoke qeerrinemman. <verse eid="EZK 41:8" /><verse number="9" style="v" sid="EZK 41:9" />Gadhi darree'n kasi kasiixxe kutuwwak gimotik furdinni onde ciqilemman; ba'laxxi bakka galmixxe kasi kasiinxe kutuwaxxe oddo'ninna <verse eid="EZK 41:9" /><verse number="10" style="v" sid="EZK 41:10" />qeesoletixxe kutuwwaxxe oddo'ni hexxeexxe kaddaa wodda godobikinna galminxe dowwe'n lame tomme ciqilemman. <verse eid="EZK 41:10" /><verse number="11" style="v" sid="EZK 41:11" />Eettene duwwixxe bakkanaa'n kasi kasiinxe kutuwwabaa e'yishaaxxe huluwwa hexxemman. Mitte middi darree'n, wele hula kinni bita'i darre'n hexxemman. Duwwixxe bakkaxxi dowwek godobi onde ciqilemman.<verse eid="EZK 41:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 41:12" />Dhidhimi darree'n galmiinxe baxxeke albi edo hedheek kinjiink minixxe gimo godobi torbaane tomme ciqilemman. Konne minixxe gimok furdinni dowwete'n onde ciqile kadaa wodda qeerrini sallane tomme ciqilemman.<verse eid="EZK 41:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 41:13" />Ookkonechchi uduma galma mike; qeerrinni dhibba ciqile kadaa woda, galmiinxi gate galmixxe gimonni welt qeerne dhibba ciqile kade. <verse eid="EZK 41:13" /><verse number="14" style="v" sid="EZK 41:14" />Boroti darre'n galmiinxe baxxek godobi, galmiinni edo hexxeexxe ba'laxxe bakkanninni mitteba dhibba ciqilemman.<verse eid="EZK 41:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 41:15" />Ookkonechchi uduma galmii udumi darre isixxe baxxe edi darre hedheeke kinjiinke minika qeerrine elqe kayyi'n hedheeke oruwwika qeerrini mitteba dhibba ciqile mike.</para>
  <para style="p" vid="EZK 41:15">Galmiinxi gadhi darrexxe baxxe woyyite bakkanna giddi darre hexxeexxi woyyo woyyitte, <verse eid="EZK 41:15" /><verse number="16" style="v" sid="EZK 41:16" />tinni sasiinxi giiddi'a eyiteexxa ifixxa maskotuwwa afeexxe kadaa wodda sasiinxixxi gimuwwa fayotenaa'n masikooteti qico'n, haqqeti buqende'emman. <verse eid="EZK 41:16" /><verse number="17" style="v" sid="EZK 41:17" />Gadhi darree'n gelmi giddixxe hulake e'yinji iimi ga'ma hedheebi giddi gadhi, iittanni gadhike galma'ninna giddike galmixxe oddo'n hexxeexxi ba'laxxe bakkaxxe dowwe duuchcha'n, <verse eid="EZK 41:17" /><verse number="18" style="v" sid="EZK 41:18" />kirubelixxinna meexxetike haqichchixxi misile itti hana xabbende'emman; meexxetik haqichchuwwixxi misiluwwa kirubeltixxenna kirubeletixxe oddo oddo'n xabbende'emman; mitte mittendi kirubele lame lame alba affe'emman. <verse eid="EZK 41:18" /><verse number="19" style="v" sid="EZK 41:19" />Manjike albixxa misile affe'exxi kirubele mitte darrexxe meexxeba'a wirri hiteexxe kaddaa wodda, neenqinke albixxe misilexxi kinni wele darre'n hexxeexxe meexxebaa wirri hite'emman. Tinni duuchchinxi misiluwwa galminxe duuchchinxe dowwe hana xabbenede'emman. <verse eid="EZK 41:19" /><verse number="20" style="v" sid="EZK 41:20" />Buttixxe fawonaa'n e'yinji iimi darrexxe gadhixxe galmixxe gimo hana kirubeelinna meexxetike haqichchixxi misiluwwa xabende'emman.<verse eid="EZK 41:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 41:21" />Galmiinxe hulak mikikilanjuwwi shoole kasikemman; woyyitte woyyo edi darre hexxeexxe hulakinna iittanni shoole kasikemman. <verse eid="EZK 41:21" /><verse number="22" style="v" sid="EZK 41:22" />Ejjuma sase ciqile, godobi lame ciqile, qeerrine lame ciqilek haqicink tolchimalchi hedhemman; isixxi shoolngi qallasunjuwwa, isixxi boosonna isik gami gamik kasuwwi duuchchi haqichchinkemman. Manjichchikinna ane'e, «Kunni Duuchchi Woddike Gootti edo hedheeke beeran» hiyye. <verse eid="EZK 41:22" /><verse number="23" style="v" sid="EZK 41:23" />Giddi darrek galminna woyyitte woyyo lame lame cufana affe'emman: <verse eid="EZK 41:23" /><verse number="24" style="v" sid="EZK 41:24" />Mitti mittend hula lame lame qameka cufana affe'een. <verse eid="EZK 41:24" /><verse number="25" style="v" sid="EZK 41:25" />Gimuwwate'n xabbendemmashanni giddike galmike cufannuwwi hana kirubeelenna meexxetik haqqichchuwwixxi misile xabbendee; edi darre gimote'n abidisende giissendemmaxxe xawulinxe soro hexxemman. <verse eid="EZK 41:25" /><verse number="26" style="v" sid="EZK 41:26" />Wuddumetixxe soroke gami gamixxe gimo'n meexxetike haqichchixxi misile itti xabbende'exxi cu'maxxi masikootuwwa hexxemman. Gami gamixxi galmiinxi kuttuwwa xawulinxe soro affe'emman.<verse eid="EZK 41:26" /></para>
  <chapter eid="EZK 41" />
  <chapter number="42" style="c" sid="EZK 42" />
  <para style="s1">Qeesoletixxa Kutuwwa</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 42:1" />Ookkonechchi uduma iikki manjichchi anee middi darre'n hexxeexxe gadhixxe wuddume'n idageexxi, galmixxe wuddumeke edonna middi darree'ni hexxeexxe gimoke kallacha'n hexxeexxe kuta'n anee iyemare. <verse eid="EZK 42:1" /><verse number="2" style="v" sid="EZK 42:2" />Middi darre'n hula afeek mini qeerrine dhibba ciqile, godoba onde tomme ciqilemman. <verse eid="EZK 42:2" /><verse number="3" style="v" sid="EZK 42:3" />Giddi darrexxe wuddumenaa'n lame tomme ciqileqileke bayine'ninna iittanni gadhixxe wuddumexxe kinjiinxe fawoke oriinke kallacha'n ijaarendeexxi kutuwwa sase koobixxe fooqe kade'emman. <verse eid="EZK 42:3" /><verse number="4" style="v" sid="EZK 42:4" />Kutuwwati edi darre giddii'n godobi tomme ciqile, qeerrine dhibba ciqile ori hedhemman; giddi darree'n hexxemmaxxe. Kutuwatik cufanuwwinna middi darre'nitemman. <verse eid="EZK 42:4" /><verse number="5" style="v" sid="EZK 42:5" />Sakkaxxe fooqexxi kutuwwa langaxxixeenna butti darrexxixxee cu'maxxemman; tinni kadeechchi sakkaxxe fooqexxi soro langaxxenna butti darrexxe fooqek ori caala ba'laxxa bakka adhdhemaxxeten. <verse eid="EZK 42:5" /><verse number="6" style="v" sid="EZK 42:6" />Wele minixxi wuddume utuphuwwa affeexxe kadaa wodda sakkaxxe fooqexxi kutuwwa kinni uttupuwwa affemmabaan; tennexxe'e sakkaxxe fooqexxi kutuwwak ba'linni langaxxixxenna butti darrexxixxe'e cu'makemman. <verse eid="EZK 42:6" /><verse number="7" style="v" sid="EZK 42:7" />Kutuwwati edonna gadhi darrexxe wuddumeke kasa'n gimo hexxemma'a; isenna kutuwati edi darre hedhdheeki qeerrini onde tomme ciqile. <verse eid="EZK 42:7" /><verse number="8" style="v" sid="EZK 42:8" />Gadhixxe wuddumme'n itti aanede hexxeexxi kutuwwa qeerrinni onde tomme ciqile kadda wodda, galmake'n itti aande hexxeexxi kutuwwa kinni qeerrinni dhibba ciqilemman. <verse eid="EZK 42:8" /><verse number="9" style="v" sid="EZK 42:9" />Gadhixxe wuddumenaa'n e'yake manji'a butti darrexxi kuttuwwa hula borroti darre'n affeemman.<verse eid="EZK 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 42:10" />Bita'i darree'ni gadhixxe wuddummexxa duuka me'iteexxi galminxe wuddummen welti abidendexxi gadhi darrexxe gimoke kallachcha'n hexxeexxe kutuwwa hexxemman. <verse eid="EZK 42:10" /><verse number="11" style="v" sid="EZK 42:11" />Tenne kutuwwa edi darrenna ori hedhe; tinni kutuwwa middi darre'n hexxemmaxxe kutuwwashanni weli labbbaaxxe kaddeexxe ejjumatik godobixxe, huluwwaninna hexxemma darrinni mittetemman. Middi darre'n hexxemmaxxe huluwwashsha <verse eid="EZK 42:11" /><verse number="12" style="v" sid="EZK 42:12" />bita'i darre'n hexxemmaxxe kutuwwaxxe huluwwanni weli labba. Orinke ke'ito'n e'yatixxe hula hexxe; isenna ise edi darree'n boroti darre'n me'iteexxe gimoke kassa'n hexxemma'a.<verse eid="EZK 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 42:13" />Ookkonechchi uduma anee hiyyee qici, «Galmiinxe wuddumme edi darre hexxeexxi middixxinna bita'i darrexxi kutuwwa qeesoletixxen, iikkibi Duuchchi Woddike Gootti edo shiqqaaxxi qeesole woyyo woyyitte uwwaara ittaaban. Ookko insa'ne woyyo woyyitte uwwaaranna midhatixxa uwwa, cubbotixxanna balleessatixxa uwwaari okko uggenda'nechchi boonchi woyyichake kademmaxxeten. <verse eid="EZK 42:13" /><verse number="14" style="v" sid="EZK 42:14" />Qeesole mittele woyyite bakka'n e'yiteechchi uduma, oddo'wite ergatendammaxxa seemma fulchexxebaak gadho wuddumme fula hexxeba'a, seemma itti woyyitete kaddemmaxxe'e. Insa'ne ardiba'a dangeba edi ga'ma wele seemma oddo'winuun» hiyye.<verse eid="EZK 42:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 42:15" />Galmi giddo hedheeka booncho mike muuxeechchi uduma, boroti darrexxe hulanaa'n gadhi'a anee fulcheexxi qarqarake'n hedheeka booncho duuchcha mike. <verse eid="EZK 42:15" /><verse number="16" style="v" sid="EZK 42:16" />Boroti darrenna mikee, onde dhibba ciqile miketixxe zangeman. <verse eid="EZK 42:16" /><verse number="17" style="v" sid="EZK 42:17" />Middi darrenna mikeen onde dhibba ciqile miketixxe zangemman. <verse eid="EZK 42:17" /><verse number="18" style="v" sid="EZK 42:18" />Bita'i darrenna mikeen, onde dhibba ciqile miketixxe zangemman. <verse eid="EZK 42:18" /><verse number="19" style="v" sid="EZK 42:19" />Ookkonechchi uduma dhidhimi darre'ni wirri hiyyeexxi mikeen, onde dhibba ciqile miketixxe zangemman. <verse eid="EZK 42:19" /><verse number="20" style="v" sid="EZK 42:20" />Tennexxee shoolinii darre'ni mike; woyyitte bakka wele boonchonaa'ni gargar hiissaake kinjiik dalla'i galminke qarqara duuchcha'ni hedhemman; konne dalla'ik qeerrini onde dhibba ciqile iittanni godobikinna onde dhibba ciqilemman.<verse eid="EZK 42:20" /></para>
  <chapter eid="EZK 42" />
  <chapter number="43" style="c" sid="EZK 43" />
  <para style="s1">Mageniik Ulfinni Galmake'n Hige</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 43:1" />Ookkonechchi uduma iikki manjichchi boroti darre'n alba wiri hiteexxe hula'n anee idage; <verse eid="EZK 43:1" /><verse number="2" style="v" sid="EZK 43:2" />aninna Isira'eelik Magenik gaachchanni boroti darre'n dagaa'na afenne; hafuur iskinna abbayyatike danbala'ike luuljishshatemman; bogikinna isike gaachchananaa'n kexxeexxa ifa'emman.<note caller="-" style="x"><char style="xo" closed="false">43:2 </char><char style="xt" closed="false"><ref loc="EZK 10:3-4">Hiz. 10:3-4</ref>; <ref loc="EZK 18:19">18:19</ref>; <ref loc="EZK 11:22-23">11:22-23</ref>; <ref loc="REV 1:15">Wal. 1:15</ref>. </char></note> <verse eid="EZK 43:2" /><verse number="3" style="v" sid="EZK 43:3" />Uudennexxi waleellanna qachcha balleesso'a dagee wodda uudennexxe waleella labbammaxxeenna iittanni Kebaarike Galaanba uudennexxe waleellanni weli laba'emmaxxemman; aninna albik gonbisemenne. <verse eid="EZK 43:3" /><verse number="4" style="v" sid="EZK 43:4" />Duuchchi Woddike Goottik gaachchaninna borotiba'a alba wirri hiteexxe hulanaa'n galmi giddi'a e'ye. <verse eid="EZK 43:4" /><verse number="5" style="v" sid="EZK 43:5" />Ookkonechchi uduma Duuchchi Woddike Goottik Hafuur anee ke'isseexxi giddi darrexxe wuddumme'n anee iyyedage; Duuchchi Woddike Goottik gaachchanninna galma wo'me.<verse eid="EZK 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 43:6" />Iikki manjichch ani bira uurre'naani, galmi giddii'n Duuchchi Woddik Gootti ane'n haaso'aa'na'a laqenne. <verse eid="EZK 43:6" /><verse number="7" style="v" sid="EZK 43:7" />Isinna anee hiyya'emma qici, «Koo manjiinke belto kunni boonchi anxe moottexxe offo'lchinxe bakkan, anxe lekkaxxe kophexxe hadhatixxe bakkan, Isira'eelike ardi giddo duuchchi woddi'a hedhenoxxe bakkan; Isira'eelike ardi, insa'neke moyanjuwwinna yabaabulatinna magenofachchotixxe bakka'n gooruwwati hana magenofatammaxxe lubbo affebaaxxe insa'neke moyanjuwwixxe fakkuwwanni summa anka langaxxa battoossinabaan. <verse eid="EZK 43:7" /><verse number="8" style="v" sid="EZK 43:8" />Anxenna insa'nexxe fakkuwwaxxe oddo'n gimo call hexxe'na'a, insa'ne qephinna ifika anki bira, ifika mikiklanjuwwa anki bira, giissedhiyyoti ifixxe diqachchiisaaxxe hujen woyyichcha summa anka battoossine; tennexxe mufe anxenni insa'ne birenne. <verse eid="EZK 43:8" /><verse number="9" style="v" sid="EZK 43:9" />Ta'anna insa'ne yabaabulle ifixxanna lubbo affebaaxxa ifike moyanjuwwiinxa fakkuwwa ani edii'n bayyinsuun; aninna insa'nexxe oddo'n duuchchi woddi'a hedhannon.<verse eid="EZK 43:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 43:10" />«Koo manjinke belto cubbo ifixxee shoonko'a konne galma Isira'eelike arda'n leellish; hitta ijaareme qiconna hubante uunduun; <verse eid="EZK 43:10" /><verse number="11" style="v" sid="EZK 43:11" />hunjeexxe cubbo duuchixxeenna shoonke'eexxe kaddooole galmiinke ijaarsika karta ege'nish, tinninna isi hitta ijaaremaa qico, dhagga isixxa, e'yinjibanna fullatiba; isi hita ijaaremee qico duuchcha, isixxa aadanna isika seeruwwa ijaaremaa qiconna aada duuchcha heqe'naashshanna hordonfaashsha konnechchuwwa duuchcha insa'ne edo borreesi.<verse eid="EZK 43:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 43:12" />«Konne Galmik seerii: koobatixxe xungoxxe dowwe duuchcha'n hedheeke looli duuchchi hara woyyichchake kadaan. Kunni konne galmiike seeran.<verse eid="EZK 43:12" /></para>
  <para style="s1">Galminka Tolchimalcho</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 43:13" />«Konne tolchimalch qeerrinni ciqiletenna taakkoten; isik darrexxi dhimo mitte ciqile kadaa woda godobikinna mitte ciqile, isexxe dowweke irgik godobinna mitte taakko; kunni tolchimalchinke qeerrinnen:<note caller="-" style="x"><char style="xo" closed="false">43:13 </char><char style="xt" closed="false"><ref loc="EXO 27:1-2">Fula. 27:1-2</ref>; <ref loc="2CH 4:1">2 Odo. 4:1</ref>. </char></note> <verse eid="EZK 43:13" /><verse number="14" style="v" sid="EZK 43:14" />Hundi darrexxe isixxe boosonaa'n iimi'a butti darrek hadhisaji qico'n ejuma lame ciqile, godobikinna lame ciqile; shiixxoke hadhisanjonaa'ninna iimi'a lumoke hadhisanji qico'n ejuma shoole ciqile godobikinna mitte ciqilemman. <verse eid="EZK 43:14" /><verse number="15" style="v" sid="EZK 43:15" />Konne tolchimalchiixxe boosumma ejjuma shoole ciqilen; tenne boosumaxxi ejjuma mitte miite ciqile kadeek shool tolchimalchink gaafuwwi hedhemman. <verse eid="EZK 43:15" /><verse number="16" style="v" sid="EZK 43:16" />Konne tolchimalchixxi boosumma shoole weli qixxeke gami gamixxe kaddaa wodda qeerrinni tommenna lame ciqile godobikinna tommenna lame ciqilen. <verse eid="EZK 43:16" /><verse number="17" style="v" sid="EZK 43:17" />Iimi darrek irgi shoole kasike kadaa wodda qeerni tommenna shoole ciqile, godobakanna tommenna shoole ciqilen; isixxe dowwe'n hedheek dareeri godoba gamisa ciqilen; isixxe boosoxxi dowwenna mitte ciqilen; hana hadha'n e'yatik isik irguwwinna boroti darre'nitemman.»<verse eid="EZK 43:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 43:18" />Isinna anee hiyyee qici, «Koo manjinke belto Lumok Duuchchi Woddik Goottinna tolchimalchi ijaaremeexxa yanna, itti cinceessatikinna munde itti fiffixatik seeri konneechchinni butti'a hedheeke kaddaan: <verse eid="EZK 43:18" /><verse number="19" style="v" sid="EZK 43:19" />Ani'a ergatendo'a ani edo shiqqaaxxe, Leewwike gosatike minenaa'n, Saadoqike mini hadixxe qeesole'n cubbotike tolchi'a kadaaka mitte jibbichcha utinaa'n; tenne hasoe'ek Lumoke Duuchchi Woddik Goottan. <verse eid="EZK 43:19" /><verse number="20" style="v" sid="EZK 43:20" />Atinna eetene mundenaa'n heenoxxa aaxxe, tolchimalchiinke shoolnge gaafuwwa'n, iimi dareke isike shoolnge kasa'ninna isike irgixxe dowwe duuchcha'n fifixxatton; konne qicinni tolchimalcho ca'a assite cubbo birtatton. <verse eid="EZK 43:20" /><verse number="21" style="v" sid="EZK 43:21" />Cubbotike tolchi'a korma aaxxetexxi, galmiinke foyemeeke boncho'n galmii gadhi darre ciincesitatton.<verse eid="EZK 43:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 43:22" />«Langa baro fafa afebaaka re'etika korbeessa cubbotike tolchi'a tolchitatto; jibichchiinxe mundenni assiteteshshanni recciinxe mundenninna tolchimalcho ca'a assitatto. <verse eid="EZK 43:22" /><verse number="23" style="v" sid="EZK 43:23" />Ca'a assa muuxxettechchi uduma fafa afebaaka jibichchakanna gedhebiinka korbeessa shiqishshatton. <verse eid="EZK 43:23" /><verse number="24" style="v" sid="EZK 43:24" />Lamiinga Duuchchi Woddike Gootti edo shiqishshetelchchi uduma qeesole lamiinge'n maxine hana fiffixeexxi Duuchchi Woddke Gootti'a ciincatike tolchi'a tolchitatto.<verse eid="EZK 43:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 43:25" />«Barra barra'n torbaane barra'a, cubbotike tolchi'a re'etika korbeessa shiqishshatto; iittanni fafa afebaaka jibichchanna gedhebiinka korbeessa shiqishshatto <verse eid="EZK 43:25" /><verse number="26" style="v" sid="EZK 43:26" />Kunni hori torbaane barra'a tolchimalchiinxa cubbo biraan; konne qicinni tolchimalckinna ca'a assaan ittanni woyyonsaan. <verse eid="EZK 43:26" /><verse number="27" style="v" sid="EZK 43:27" />Tinni barruwwa muxendechchi uduma, saddeetesoxxe barranaa'ni qeesole ha'noka ciincatika tolchanna mittummatika tolcha tolchimalchoke'n shiqishsha. Ookkonechchi uduma aninna ha'no'n gammadanon» hiyya'neen Lumok Duuchchi Woddik Gootti.<note caller="-" style="x"><char style="xo" closed="false">43:27 </char><char style="xt" closed="false"><ref loc="EXO 29:35-37">Fula. 29:35-37</ref>. </char></note><verse eid="EZK 43:27" /></para>
  <chapter eid="EZK 43" />
  <chapter number="44" style="c" sid="EZK 44" />
  <para style="s1">Galchallo, Leewwito, Qeese</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 44:1" />Ookkoneechchi uduma iikki manjichchi anee boroti darre'n wirri hiteexxe gatexxe galminxe hulaba illee iima iyyedage; hulatinna cufendemman. <verse eid="EZK 44:1" /><verse number="2" style="v" sid="EZK 44:2" />Duuchchi Woddik Goottinna anee hiyyee qici: «Tinni hula cufendeeshshanni hexxaa malee'e banedaba'a; ayyinna isenaa'n e'yaba'a; Duuchchi Woddik Gootti Isira'eelik Mageni isenaa'n e'yemmaxxee cufendeeshshanni hexxa. <verse eid="EZK 44:2" /><verse number="3" style="v" sid="EZK 44:3" />Ardink akeekisanji Duuchchi Woddik Gootti edo ito'a, eettene hulanaa'n e'yeexxi giddo offo'laak ison callan; isinna hulatixxe soroke oranaa'n eyammashshanni fulaabinna ookko'nidden.»<verse eid="EZK 44:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 44:4" />Ookkoneechchi uduma iikki manjichchi middi darrexxe galminxe hula'n anee iyyedage; aninna tami asse uudanno wodda Duuchchi Woddike Goottik ulfinni Duuchchi Woddike Goottika galama wo'mee'na'a afennexxi albik gonbisemenne.<verse eid="EZK 44:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 44:5" />Duuchchi Woddik Goottinna anee hiyyee qici: «Koo manjinke belto Duuchchi Woddike Goottike gamixxa aada uuddaaxxenni ate'n kulaanexxa duuchcha hubate uudi, dho'ote laqqi qalbeeffat; minika e'yinjonna galmiinxa hulaara hubbat. <verse eid="EZK 44:5" /><verse number="6" style="v" sid="EZK 44:6" />Ookkone jallichcha Isira'eelike ardi'aa hitato qici: Lumok Duuchchi Woddik Gootti hiyya'ne'ni hitatto qici: ‹Koo Isira'eelike arda ha'noxxi diqachchisaxxi huje yoona gelte'e! <verse eid="EZK 44:6" /><verse number="7" style="v" sid="EZK 44:7" />Tenne diqachisaaxxe ha'noxxe huje gadhi darre, ha'no ani'a ita, ha'yonna munde shiqishshinaa wodda qalbenna biso ifika jila ofo'lebaaka alaga anke galmi giddi'a e'yishshiyyoti galma anka battoossine kako anxanna diigine. <verse eid="EZK 44:7" /><verse number="8" style="v" sid="EZK 44:8" />Ha'no ifi'anni woyyitte anxa aada hujinammaxxa bado wele manna anke galmi giddo baaloonsitine. <verse eid="EZK 44:8" /><verse number="9" style="v" sid="EZK 44:9" />Lumok Duuchchi Woddik Gootti hiyya'nee qici: Qalbenna biso ifika jila ofo'lebaak, Isira'eelike ardi giddo hedheeke kadoolenna midde galma anka e'yoqqe.<verse eid="EZK 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 44:10" />« ‹Leewwito anee hordofatenaa'n bayyatee wodda, anenaa'ni bayyateexxi fakkuwwa hordoffa'n doonsakiyya hitammaxxe cubbo ifixxika hira adhdhitaan. <verse eid="EZK 44:10" /><verse number="11" style="v" sid="EZK 44:11" />Insa'ne anke mini giddo ergatemat galma ankixxe hulla'ninna baaloomeexxi galmi giddo ani'a ergatema dandeenna; ciincatike tolchi'a dulleexxi arda ankee tolchati insa'ne edo uurine insa'ne'a ergatema dandeena. <verse eid="EZK 44:11" /><verse number="12" style="v" sid="EZK 44:12" />Yaane kinni Leewito arda magenoonfatamaxxe fakkuwwa arda ergatendemaxxenna Isira'eelik ardi cubbote'n ibaashsha assitemaxxe, tennexxe hujjeexxe cubboka hira alfitaashsha anga ke'ise kakate'enen» hiyya'neen Lumok Duuchchi Woddik Gootti. <verse eid="EZK 44:12" /><verse number="13" style="v" sid="EZK 44:13" />Qeesummatinna ani'a ergatemmo'a aniba'a shinqabaan; yookaan anxe woyyitte yaane duuchchiba'a, yookaan hara woyyichchake kadeeke anke tolchuwiba'a shinqabaan; ifixxe diqachchiisaaxxe hujeka shooko oddo'winaan. <verse eid="EZK 44:13" /><verse number="14" style="v" sid="EZK 44:14" />Yaane kinni galmiinxa hujenna giddo hujendaaxxa huje duuchcha'n baaloomik ergatemmaashsha assannon.<verse eid="EZK 44:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 44:15" />« ‹Yaane kinni Isira'eelik ardi anka ora waale dedhake'n me'ee wodda, anke galmixxa huje addatenshati muunnxe'ek Leewwitotenaa'n Saadoqixxe horte anee ani edo shiqqeexxi ani'a ergatendaan; insa'nenna ani edo uurrineexxi ha'yokanna mundetika tolcha ani'a shiqinshaan; tenne haaso'ek Lumoke Duuchchi Woddike Goottan. <verse eid="EZK 44:15" /><verse number="16" style="v" sid="EZK 44:16" />Insa'ne calli anke galma e'yinaan; insa'ne calli ani edo ergatemmo'a, aada anxanna muunxo'a anke tolchimalchibaa shinqaan.<verse eid="EZK 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 44:17" />« ‹Insa'ne giddi darrexxe wuddummexxe hula e'yinaa wodda, layinotixxa seemma oddo'wina; giddi darrexxe wuddummexxe huluwwaba galmi giddo ergatemmaa wodda gedhebinxe ordaxxa seemma oddo'winoqqe'e.<note caller="-" style="x"><char style="xo" closed="false">44:17 </char><char style="xt" closed="false"><ref loc="EXO 28:39-43">Fula. 28:39-43</ref>; <ref loc="LEV 16:4">Lew. 16:4</ref>. </char></note> <verse eid="EZK 44:17" /><verse number="18" style="v" sid="EZK 44:18" />Insa'ne layinoti umoke'n layinotixxe seemmaka ruufa mirqe'neexxi hidhake'ninna layinotika gonfa ka'linowaal; daffisaaxxa seemanna oddo'winoqqe'e. <verse eid="EZK 44:18" /><verse number="19" style="v" sid="EZK 44:19" />Ardi hedheeba gadhixxe wuddummeba'a fullaa wodda, oddo'wine ergatemammaxxa seemma fulche'neexxi woyyitte kuta'ni uggine wele seemma oddo'wina; tinninna insa'ene arda ifixxe seemmanni woyyoonsinabashshaten<note caller="+" style="f"><char style="fr" closed="false">44:19 </char><char style="ft" closed="false">Arda woyyonsinbaashsha hiyyak hiyyichchi wele manni woyyitte seemma tuqoole midhemabaasha hiyyoten. </char></note>.<note caller="-" style="x"><char style="xo" closed="false">44:19 </char><char style="xt" closed="false"><ref loc="LEV 16:23">Lew. 16:23</ref>. </char></note><verse eid="EZK 44:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 44:20" />« ‹Qeesetinna umo haaxxitoqqe'e, yookaan nossexxoqqe'e; yaane kinn harunsexxe woxxexxowaal.<note caller="-" style="x"><char style="xo" closed="false">44:20 </char><char style="xt" closed="false"><ref loc="LEV 21:5">Lew. 21:5</ref>. </char></note> <verse eid="EZK 44:20" /><verse number="21" style="v" sid="EZK 44:21" />Huuni qeesichchinna giddi darrexxe wuddummeba'a e'yaa wodda woyinetixxa booka ha'woqqe'e.<note caller="-" style="x"><char style="xo" closed="false">44:21 </char><char style="xt" closed="false"><ref loc="LEV 10:9">Lew. 10:9</ref>. </char></note> <verse eid="EZK 44:21" /><verse number="22" style="v" sid="EZK 44:22" />Aro'i reyeexxa melaalle yookaan aro'ik weli tikke'eexxa melaalle aa'noqqe'e; yaane kinni Isira'eelitotika dubara yookaan qeesichchi aro'i reyeexxara melaalle aadha dandeena.<note caller="-" style="x"><char style="xo" closed="false">44:22 </char><char style="xt" closed="false"><ref loc="LEV 21:7">Lew. 21:7</ref>, <ref loc="LEV 21:13-14">13-14</ref>. </char></note> <verse eid="EZK 44:22" /><verse number="23" style="v" sid="EZK 44:23" />Insa'ne woyyittenna woyyitte kaddebaaxxe yaanexxe oddo'n hexxeexxa gargarumma arda ankee barsinsaan; batto'ekanna batto'ebaaka hitta gargar hiissemaaxxa insa'ne'n leellinsha.<note caller="-" style="x"><char style="xo" closed="false">44:23 </char><char style="xt" closed="false"><ref loc="EXO 10:10">Fula. 10:10</ref>. </char></note><verse eid="EZK 44:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 44:24" />« ‹Heene weli gonphenna qeesoole yaane uudeexxi anke seerishsha murtowaal; anka ayyaanuwwa uudaxxenni anka seeranna anxa aada duuchcha he'qe'nowaal; anke edi sanbatixxa woyyummanna he'qe'nowaal.<verse eid="EZK 44:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 44:25" />« ‹Qeesichchi reyeeke manjike renshiba'a shiqiyyoti ifi battosoqe'e; kadomle kinni reyek manji annake yookaan amate, belto isike yookaan belto isixxe, dayyoke yookaan herundebaaxxe dayyo kaddo'ole ifi battoosa dande'aan.<note caller="-" style="x"><char style="xo" closed="false">44:25 </char><char style="xt" closed="false"><ref loc="LEV 21:1-4">Lew. 21:1-4</ref>. </char></note> <verse eid="EZK 44:25" /><verse number="26" style="v" sid="EZK 44:26" />Battummatenaa'n ca'a hiyyechchi uduma torbaane barra turiyyo hasissa. <verse eid="EZK 44:26" /><verse number="27" style="v" sid="EZK 44:27" />Galmi giddo ergatemo'a galminke giddi darrexxe wuddumeba'a e'yaaxxa barra, ifi'a cubbotika tolcha shiqishowaal; tenne'e haasoeek Lumoke Duuchchi Woddike Goottan.<verse eid="EZK 44:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 44:28" />« ‹Qeesetee ane callan insa'nek qadaad; Isira'eeli giddo insa'ne'a qadaada uutoxxe'e. Ani insa'neke qadaada kadannon.<note caller="-" style="x"><char style="xo" closed="false">44:28 </char><char style="xt" closed="false"><ref loc="NUM 18:20">Lak. 18:20</ref>. </char></note> <verse eid="EZK 44:28" /><verse number="29" style="v" sid="EZK 44:29" />Insa'ne midhatixxa uwwa, cubbotixxanna balleessatixxa uwwa indaan; Isira'eelike boga'n Duuchchi Woddike Gootti'a uwwemeechchi duuchchi insa'neke kadaan.<note caller="-" style="x"><char style="xo" closed="false">44:29 </char><char style="xt" closed="false"><ref loc="NUM 18:8-19">Lak. 18:8-19</ref>. </char></note> <verse eid="EZK 44:29" /><verse number="30" style="v" sid="EZK 44:30" />Umiinxe uwwaari giddii'n filendeexxa duuchchanna gargart hexxeexxi ha'noxxi uwwaari duuchchi qeesoletixxe kaddaan; atike mini hadi'a eebbate kaddo'a buttinakenaa'n alfitattoxxe ita duuchika umo insa'ne'a uwwi. <verse eid="EZK 44:30" /><verse number="31" style="v" sid="EZK 44:31" />Qeese reyeeka yookaan biniinchi shiyeexxa ci'ate kaddo'o horiinka maala ittoqe'e.<note caller="-" style="x"><char style="xo" closed="false">44:31 </char><char style="xt" closed="false"><ref loc="LEV 25:10">Lew. 25:10</ref>.</char></note><verse eid="EZK 44:31" /></para>
  <chapter eid="EZK 44" />
  <chapter number="45" style="c" sid="EZK 45" />
  <para style="s1">Boginka Qooddo</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 45:1" />« ‹Boga hixik ifike qadaada asedhdhate qoodendinnaa wodda, qeerrine lame tommenna onde kuma ciqile, godobakanna lame tomme kuma<note caller="+" style="f"><char style="fr" closed="false">45:1 </char><char style="ft" closed="false">Godobi lame tomme kuma hiyyendeexxi torbane tomme mannixxi tika kuma ciqile hitaan. </char></note> ciqilexxa mitte kuta Duuchchi Woddike Gootti'a woyyitte bakka assitine uwwe; itti bakka duuchchinba woyyitete kaddaan; <verse eid="EZK 45:1" /><verse number="2" style="v" sid="EZK 45:2" />Tenne bakkanaa'n qeerrine onde dhibba ciqile godobikinna onde dhibba ciqile kaddeexxi shoole gama affe'exxi bakka galmakee kadda; isexxe dowwe'ninna onde tomme ciqilexxi duwwixxi bakka hexxa. <verse eid="EZK 45:2" /><verse number="3" style="v" sid="EZK 45:3" />Eettenne woyyitte bakka giddo qeerrinne lame tommenna onde kuma ciqile, godoba tomme kuma ciqilexxa bakka mik; ookko giddonna galmi, woyyo woyyitte bakka hexxaan. <verse eid="EZK 45:3" /><verse number="4" style="v" sid="EZK 45:4" />Tinni bakkanna galmi giddo ergatendaaxxenna Duuchchi Woddike Gootti edo ergatenshatee shiqqaaxxe qeesole'a, boginxe woyyitte bakka kaddaan; tinni bakkanna qeesoletike galdumi'anna galmiinke ijaarsi'a kaddaan. <verse eid="EZK 45:4" /><verse number="5" style="v" sid="EZK 45:5" />Qeerrine lame tommenna onde kuma ciqile, godobi tomme kuma ciqile kaddaaxxi bakka galmi giddo ergata'neexxe Leewwito'a hexxaaka mine ijaadhitaashsha qadaada insa'neke kaddaan.<verse eid="EZK 45:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 45:6" />« ‹Woyyitte bakkake maxxana'n godobi onde kuma ciqile qeerrinni lame tommenna onde kuma ciqilexxa bakka qachchakee qadadiinsha uwwi; kunninna Isira'eelike ardi duuchchike kaddaan.<verse eid="EZK 45:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 45:7" />« ‹Bogink galchalli qadaadi elqe kayyii'n woyyitte bakkanninna qachchiinxe bakkanni gabalemaake kadaan; tinninna dhidhimakenaa'n dhidhimidare'n borotinaa'ninna boroti darre'n me'eexxi dhidhimakenaa'n boroti qico'n hexxeexxe gabalak qeerrnni mitte gosatike mini'a uwwemeeke qadaadike cinaachcha'n me'ita. <verse eid="EZK 45:7" /><verse number="8" style="v" sid="EZK 45:8" />Kunni bog Isira'eli giddo galchalliinke qadaada kadaan. Ta'inni edi'a ank galchalluwwi anka arda miicabaan; yaane kinni Isira'eelik ardi'a gosatike mini minishshanni qadaada insa'ne'a uuna.<verse eid="EZK 45:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 45:9" />«‹Lumok Duuchchi Woddik Goottinna koo Isira'eelike galchalluwwa! Sara saxxine'een; jallonna miica fuggussitineexxi, qajeellummatanna qullumma hujje; anke ardanaa'n afeechcho mulqedha waalle; tenne haaso'ek Lumoke Duuchchi Woddike Goottan. <verse eid="EZK 45:9" /><verse number="10" style="v" sid="EZK 45:10" />Seeriinxa kiilo, Iffi<note caller="+" style="f"><char style="fr" closed="false">45:10 </char><char style="ft" closed="false">Iffi bagoolcho saffarake saffarisanjon.</char></note> hiyyemaaka seernka safarsanjonna Badoosi<note caller="+" style="f"><char style="fr" closed="false">45:10 </char><char style="ft" closed="false">Seernxi Baadose dunemaashi mikisanjon.</char></note> hiyyemaaka seeriinka miksanjo la'offatte. <verse eid="EZK 45:10" /><verse number="11" style="v" sid="EZK 45:11" />Iffixxinna Badoosixxi mike weli qixxete kaddowaal; mitti Badoosik miksanji Homer<note caller="+" style="f"><char style="fr" closed="false">45:11 </char><char style="ft" closed="false">Hoomeri bagoochchik saffarsanjon.</char></note> hiyyemaake miksanjixxe tommixxe anga, iittanni mitte Iffi Homerrixxe tommixxe anga; laminig mikisanji, Badoosikinna Iffik akeekemaak Homorkenten. <verse eid="EZK 45:11" /><verse number="12" style="v" sid="EZK 45:12" />Mitte Seqili mikisanji lamme tomme Geera hiyyemaake mikisanjinni weli qixxeten; lame tomme seqilenna tommenna lame Seqile lebendaa wodda mitte Minaane kaddaan.<verse eid="EZK 45:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 45:13" />« ‹Shiqishshinaaxxi gargarti gargar hexxeexxi uwwa konnechchin butti'a hexxeexxen: mitte Homerke mikisajixxi dinnenaa'n iffike mikisanjixxa jaane anganaa'ni mitte, iittanni mitte Homerke mikisajo so'inaa'n iffike mikisanjixxe jaane anganaa'n mitteteten. <verse eid="EZK 45:13" /><verse number="14" style="v" sid="EZK 45:14" />Zayitetixxi mika, mitte mittinge Homerike mikisajonaa'n Baadoosike mikisanjixxa tommete'naa'n mitte anga; Tinninna tomme Baadoosi mitte Homerinni qixxeten. <verse eid="EZK 45:14" /><verse number="15" style="v" sid="EZK 45:15" />Iittanni Isira'eelixxa quffeexxa badda'a iteeke lame dhibba gedhebinaa'n mitte gedhechchi uwwemuun. Kunni duuchchi ardixxa cubbo biratee kaddaaxxe midhatixxe uwwa'a, ciinacatike tolchi'anna mittumatike tolchi'a kadaan; tenne haaso'eek Lumoke Duuchchi Woddike Goottan. <verse eid="EZK 45:15" /><verse number="16" style="v" sid="EZK 45:16" />Bogink ardi duuchchi tenne gargar hexxeexxa uwwa Isira'eelike galchalli'a uwwaan. <verse eid="EZK 45:16" /><verse number="17" style="v" sid="EZK 45:17" />Ayyanuwwa ayyanuwwa'inna, baate haroxxi fulatike ayyaana'ninna edi sanbata sanbata'n, Isira'eelike ardi'a murreeke ayyaanuwwa duuchcha'n ciincatixxa uwwa, midhatika tolchanna ha'watika tolcha shiqishiyyo ookkone galcallixxen; Isira'eelike ardixxa cubbo birate'e kaddo'a cubbotika tolcha midhatixxe uwwa'a, ciinacatike tolchi'anna mittummatike tolchi'a shiqishaan.<verse eid="EZK 45:17" /></para>
  <para style="s1">Ayyanuwiinxa Ulfeessa</para>
  <para style="r">(<ref loc="EXO 12:1-20">Fula. 12:1-20</ref>; <ref loc="LEV 23:33-43">Lew. 23:33-43</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 45:18" />« ‹Lumok Duuchchi Woddik Goottinna siretike aganjixxe siretixxe barra'n fafa mitte afebaaka jibichcha aadhi; galmakanna ca'assi. <verse eid="EZK 45:18" /><verse number="19" style="v" sid="EZK 45:19" />Qeesichchikinna cubbotik tolchixxe mundenaa'ni aadheexxi galmiinxe hulake mikikilanjuwwa'n, tolchimalchii iimike irgik shoolinge kasuwwa'ninna giddixxe wuddummexxe hulaxxe gubane'n fixowaal. <verse eid="EZK 45:19" /><verse number="20" style="v" sid="EZK 45:20" />Mitti manji afebang yookaan haakitik hujeexe cubbo'a agenjixxe torbesoxxe barra'n iimi darra ku'liinemmashshan assitton; konne qicininna galmixxa cubbo birtaton.<verse eid="EZK 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 45:21" />« ‹Siretike aganjixxe tommenna sholgeesoxxe barra'ni sa'atika ayyana ulfeessitinaan; kunninna lebele e'yiteebaaxxa kebbo torbaane barra qico'n ittinaan. <verse eid="EZK 45:21" /><verse number="22" style="v" sid="EZK 45:22" />Eettene barra'ni galchalli ifixxeenna bogiinke ardi duuchchixxee mitte jibichcha cobbotike tolchi'a shiqishaan. <verse eid="EZK 45:22" /><verse number="23" style="v" sid="EZK 45:23" />Ayyanni ulfeessema'neke torbaaninixxe barra'ni galchanlli barra barra'ninn fafa afebaaka mitte fafa afebaka torbaane jibootanna torbaane gedhebinxa korbeeyye ciincati tolchi'a Duuchchi Woddike Gootti'a shiqinshowaal; barra barra'ninni cubotike tolchi'a mitte mitte labbaka recco qophpheesinowal. <verse eid="EZK 45:23" /><verse number="24" style="v" sid="EZK 45:24" />Mitti mitting jibichchinna mitte mitte gedhebiink korbeesi tolchemaaxxa yanna mitte mitte Ifi ifike mikisanjixxi midhatixxi uwwanna mitte Iinke mikisanjixxe shoole literexxe zayitenni welti shiqishowaal.<verse eid="EZK 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 45:25" />« ‹Torbesoke agenjixxe tommenna ondeesoxxe barra'n safemeek torbaane barrake ayyaana'n, cubbotika tolcha, ciincatika tolcha, midhatika tolchi'anna zayite ittanni shiqishowwal.<verse eid="EZK 45:25" /></para>
  <chapter eid="EZK 45" />
  <chapter number="46" style="c" sid="EZK 46" />
  <para style="p">
    <verse number="1" style="v" sid="EZK 46:1" />« ‹Lumok Duuchchi Woddik Gootti hiyya'nee qici, boroti edo hexxeexxe giddixxe wuddummexxi hula jaaniniixxa hujetixxa barra cufendowaal; yaane kinni edi sanbatinxa barranna haaroxxi baate fuldaaxxa barra banemowal. <verse eid="EZK 46:1" /><verse number="2" style="v" sid="EZK 46:2" />Galchanj gadhi darrexxe wuddummexxe hulaxxe soro hundii'n e'yeexxi hulati mikiklanji bira uurrowaal; qeesoletinna isi'a ciincesinaaka tolchuwwanna mittomiinka tolcha tolchitowaal; isinna hulatixxe buttixxe gubane hane hedhe magnofateexxi fulowaal; wuddummetixxi hula kinni galagal qico'n cufendoqe'e. <verse eid="EZK 46:2" /><verse number="3" style="v" sid="EZK 46:3" />Bogiink ardinna edi sanbata sabata'ninna haaroxxi baate fulatike ayyaana Duuchchi Woddike Gootti edo wuddumetike e'yinjo'n magonfatowaal. <verse eid="EZK 46:3" /><verse number="4" style="v" sid="EZK 46:4" />Galchalli sanbatinxa barra ciincesinaake tolchi'a fafa afebaaka mitte gedhechinii korbeesanna jaane gedhebinka buruusuuwanna Duuchchi Woddike Gootti edo shiqinshowaal. <verse eid="EZK 46:4" /><verse number="5" style="v" sid="EZK 46:5" />Gedhebiinke korbeesiinni welti midhatixxi uwwa mitte Iffi mikisanjo shiqowwal; gedhebinke buruusuwwinni welti shiqqaxxi midhatixxi uwwa annichchinxe eeyyashanni kaddun; mitti mitting iffik mikisanjinni welti mitte mitte inka mikisanjo zayite shiqishowaal. <verse eid="EZK 46:5" /><verse number="6" style="v" sid="EZK 46:6" />Haroxxi baate fulatika ayyaana'n mitte jibichcha, jaane gedhebinka burusuwwanna mitte gedhebinka korbeessa shiqinshowaal; duuchhcing fafa afebaake kadowaal. <verse eid="EZK 46:6" /><verse number="7" style="v" sid="EZK 46:7" />Manjichchi jibichik welti mitte iffika mikisanjo, gedhebiinke korbeessininna welt mitte iffika mikisanjo midhatixxa uwwa shiqinshowwal; ittanni gedhebinke burusuwwinni shiqqa'neexxa midhatixxa uwwa kinni manjichchi eeyye qico uwwuun; mitti mitting iffik mikisanjinni welti mitte iink mikisaji zayite shiqqowaal. <verse eid="EZK 46:7" /><verse number="8" style="v" sid="EZK 46:8" />Galchalli e'yaa wodda wuddummetixxe sorotixxe hulanaa'n e'yowaal; fula woddanna ooko'ninni fulowaal.<verse eid="EZK 46:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 46:9" />«‹Bogink giddik ardi muremeeke ayyaanuwwa'n Duuchchi Woddike Gootti edo dagaa wodda, magenofachchotee middixxe wuddummexxe hulanaa'n e'yeek duuchchi bita'ixxe hulanaa'n fulowaal; bita'ixxe wuddummexxe hulanaa'n e'yek middixxe wuddummexxe hulanaa'n fulowaal; kallacha iske'n hexxeexxe hulanaa'n fuloo malee'e ayyinna e'yemmaxxe hulanaa'n fuloqqe. <verse eid="EZK 46:9" /><verse number="10" style="v" sid="EZK 46:10" />Galchalli insa'nexxe oddo'n hedheexxi e'yina wodda e'ya'n fulla woddanna fulaan.<verse eid="EZK 46:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 46:11" />«‹Ayyanuwwake'ninna muremeeke ayyanuwwiinxe barruwwa'n, jibichchik welti mitte iffik mikisanji, gedhebiinke korbeessininna welti mitte iffika mikisanjo midhatixxa uwwa shiqishowaal; gedhebiinke buruusuwwinni welti shiqishaak midhatik tolchi kinni manjichi eeyyeqicike kadowaal; mitte mittinge iffike mikisanjinni welt mitte iink mikisaji ejersiinxi zayite shiqqowaal. <verse eid="EZK 46:11" /><verse number="12" style="v" sid="EZK 46:12" />Galchalli eeyya ifixxenni Duuchchi Woddike Gootti'a ciincatika tolcha kadi mittummatika tolcha shiqishaaxxa yanna borot darre'n wirri hiteexxi hula isi'a banenduun; edi sanbatixxe barra'n assammashshanni ifika cincati tolchanna kadi ifika mittummatika tolcha shiqishowaal. Okonechchi uduma fulaan; fuleechchi uduma hulatinna cufendaan.<verse eid="EZK 46:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 46:13" />« ‹Barra barra'ninni fafa afebaaka mitte woggaka gedhebiinka buruusa ciincatike tolchi'a Duuchchi Woddike Gootti'a shiqishuun; gorsa gorsa'ninni isoo shiqishowaal. <verse eid="EZK 46:13" /><verse number="14" style="v" sid="EZK 46:14" />Isinni welti gorsa gorsa'ni midhatika tolcha, iffika mikisanjixxa jiyeesoxxa anga bulle karsatee kaddaaxxa iinka mikisanjixxa sakkaxxa anga zayite shiqishuun. Gorsa gorsa'ninni midhatika tolcha shiqishunni; Kunni midhatik tolchi Duuchchi Woddike Gootti'a shiqisha duuchchi woddixxe aadan. <verse eid="EZK 46:14" /><verse number="15" style="v" sid="EZK 46:15" />Tennexxee duuchchi woddi'a shiqaake cincatike tolchi'a gorsa gorsa'ninni gedhebiink buruusi, midhatik tolchinna zayite shiqqowaal.<verse eid="EZK 46:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 46:16" />« ‹Lumok Duuchchi Woddik Gootti hiyya'nee qici: galchalli qadaada ifikenaa'n labbaxxe ifixxe oose giddi'ni mitteke'e uwwoole, itti uwwa isixxe horte'n saxxaan; dhaalatinna insa'nexxe karra kaddaan. <verse eid="EZK 46:16" /><verse number="17" style="v" sid="EZK 46:17" />Yaane kinni ikki galchalli ifike qadaadanaa'n ifike erganjuwanaa'n mittekee uwwoole, iikki erganji ookkone qadaada qullo fulatixxe wogga qico'n ifike assedha; ookkonechchi uduma iikki qadaad ookkone galchalli'a higeexxi duuchchi woddi'a isixxe labbaxxe ooseke calla kadaan; qadaadi iikkinna insa'neke. <verse eid="EZK 46:17" /><verse number="18" style="v" sid="EZK 46:18" />Galchalli insa'nexxe karranaa'n finqilcheexxi hoone ardika qadaadanna adhdhiyyo hassissaba'a; ifixxe labbaxxe oose'anna qadaada uwwiyyo hassissaak ifixxe karranaa'niten; tinninna arda ankenaa'n ayyinna ifike qadaadinaa'n finqilchemabaashaten» hiyye.<verse eid="EZK 46:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 46:19" />Ookkonechchi uduma manjichchi iikk wuddummetixxe hulake qarqarnaa'n middi darree'n wirri hiteexxe woyyitte qeesoletixxe kutaba anee idageexxi dhidhimake'n uduma hexxeexxa bakka ane'n leelishe. <verse eid="EZK 46:19" /><verse number="20" style="v" sid="EZK 46:20" />Isinna anee, «Tinni bakka arda woyyonsatee<note caller="+" style="f"><char style="fr" closed="false">46:20 </char><char style="ft" closed="false">Arda woyyonsate hiyyo seer belo arda woyyite yaaneba'a shiqishati midhemabaasha assate hiyyoten</char></note> tolchuwwi siretixxe wuddummeba'a fulchinabaashsha, qeesole balleessatikenna cubbotike tolchika maala gaffaabanna midhatika tolcha ra'issitaaxxe bakkan» hiyye.<verse eid="EZK 46:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 46:21" />Ookkonechchi uduma iikki manjichchi siretixxe wudumme'n ane idageexxi shoolnge wuddummetike kasixxe dowwe'n ane'e marensiise; aninna mitte mittenge kasa'n wele wuddumme affeexxa uudenne. <verse eid="EZK 46:21" /><verse number="22" style="v" sid="EZK 46:22" />Siretixxe wuddummeke shoolnge kasa'n qeerrini shoole tomme ciqile godobi sase tomme ciqile kaddeexxi dalli'ik qoqqobendeexxe wuddumme hexxemman; tinni shoolinge kasa'n hexxemmaxxi wuddummuwwa weli qixetemman. <verse eid="EZK 46:22" /><verse number="23" style="v" sid="EZK 46:23" />Tenne shoolnxe wuddummexxe dowwe'n giddii'n kinjinxe laango hexxemma'a; laangoti hundixxe dowwe'ninna giiratixxe boosumma hexxemman. <verse eid="EZK 46:23" /><verse number="24" style="v" sid="EZK 46:24" />Manjichchikinna ane'e, «Kunni shoolng boonchi woyyichcha galma'n ergatemaakiir ardinka tolchuwwa ganfaaxxe bakkan» hiyye.<verse eid="EZK 46:24" /></para>
  <chapter eid="EZK 46" />
  <chapter number="47" style="c" sid="EZK 47" />
  <para style="s1">Galmi Hundii'n Fulaaka Wode'e</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 47:1" />Ookonechchi uduma iikki manjichchi galminxe hulaba ane'e illeema idage; (woyyichchi galmi alba borot darre'n wirri hiyemaxxe) woddi'ikinna galminxe qephphinni hundii'n fula'n boroti darre'n ya'amman; woddi'ikinna galminke bita'i darrenaa'n, tolchimalchiinke bita'anaa'n hundi hundii'n ya'aman.<note caller="-" style="x"><char style="xo" closed="false">47:1 </char><char style="xt" closed="false"><ref loc="ZEC 14:8">Zek. 14:8</ref>; <ref loc="JHN 7:38">Yoh. 7:38</ref>; <ref loc="REV 22:1">Wal. 22:1</ref>. </char></note> <verse eid="EZK 47:1" /><verse number="2" style="v" sid="EZK 47:2" />Middi darrexxe hulanaa'n anee fulcheexxi boroti darree'ni alba wirri hiteexxe siretixxe wuddummexxe dowwe'n anee marensiise; woddi'ikinna bita'i darrenaa'n ya'amman.<verse eid="EZK 47:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 47:3" />Manjichchi iikkinna miketixxa wodaro anga abixxiyyoti, middi darre'n me'eexxi mitti kuma ciqile mike; ookkoneechchi uduma shane geyeeke wode'i giddonna anee foosse. <verse eid="EZK 47:3" /><verse number="4" style="v" sid="EZK 47:4" />Higgeni mitte kuma ciqile mikeexxi gulubo iima geyeeke woddi'i giddi'ni anee foosse; higgeenna wele mitte kuma ciqile mikeexxi iima hidha geyyeke wodi'i giddi'n anee foosse. <verse eid="EZK 47:4" /><verse number="5" style="v" sid="EZK 47:5" />Higgeen wele mitte kuma ciqile mike, yaane kinni wodhi'i wo'meexxi dhi'mo afeeke kademmaxxee dande'e foofabo'noke galaana kade; isinna daakiyotite malee lekkati foossabaakemman. <verse eid="EZK 47:5" /><verse number="6" style="v" sid="EZK 47:6" />Isinna, «Koo manjinke belto, tenne uuda'ninni hexxette?» hiyye ane'e qore.</para>
  <para style="p" vid="EZK 47:6">Ookkonechchi uduma manjichchi iikki wodi'i qarqarba'a anee illeema hiisse. <verse eid="EZK 47:6" /><verse number="7" style="v" sid="EZK 47:7" />Ookkonna geyenne wodda galaaniinke gama gama'n heddo haqqichchuwwa uudenne. <verse eid="EZK 47:7" /><verse number="8" style="v" sid="EZK 47:8" />Manjichchikinna anee hiyyee qici, «Kunni wodi'i boroti darreke bogiba'a ya'aan; abbaayyate'n e'yammaxxe bakkaba'a, Araba'a adadde me'aan; eettene Abbaayya giddi'anna e'yaa wodda, ookko hedhemmak wodi'i maxinummatenaa'n jijjiremeexxi eloke wode'e kadaan. <verse eid="EZK 47:8" /><verse number="9" style="v" sid="EZK 47:9" />Kunni wodi'i ya'aaxxe bakka duuchcha'n lubbo affeexxi heddo daduwwa hexxa; kunni wodi'i ookko'a ya'ammaxxee qulxumuwwatik laakkossi birasa'eeke kada; tennexxee kunni wodi'i yaa'exxe bakka duuchcha'n yaane duuchcha hedhot hexxa. <verse eid="EZK 47:9" /><verse number="10" style="v" sid="EZK 47:10" />Qulxu'me abixxaak manni ookkone wodi'ike qarqara'n uurra; Ayiingadinaa'n Eeni egilayim qico'n hexxeexxe bakka'n marabe fa'winaaxxe kaddaan; ookkonna Lumoxxe abbaayyaxxe qulxu'meshsha gargar gargar hexxeexxe gosaxi qulxu'me afendaan. <verse eid="EZK 47:10" /><verse number="11" style="v" sid="EZK 47:11" />Yaane kinni caffa'atinna weeli wodi'i maxinetike kadeeshanni hedhaa malee ca'ichchake kadaba'a. <verse eid="EZK 47:11" /><verse number="12" style="v" sid="EZK 47:12" />Galaaniinke qarqara qarqara'n gumma gummisaak gargar gargar hedheek haqichchuwwi lataan, shafa bagaba'a gummatanna harcasaba'a. Kunni haqqichchuwwi galmi hundii'n fulammaka wode'e alfaammaxxe agenjo agenjo'n gummisa; gummatinna itatee, shafikinna fayyatee kadaan.»<note caller="-" style="x"><char style="xo" closed="false">47:12 </char><char style="xt" closed="false"><ref loc="REV 22:2">Wal. 22:2</ref>. </char></note><verse eid="EZK 47:12" /></para>
  <para style="s1">Boginxa Gabala</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 47:13" />Lumok Duuchchi Woddik Gootti hiyya'nee qici: «Boga tommenna lame Isira'eelike gosatike mini'a qadaadake kadaashsha qoodinaaxxi gabala konnechchinni butti'a hexxeeshshaten; Yooseefi lame qoobbo alfowaal. <verse eid="EZK 47:13" /><verse number="14" style="v" sid="EZK 47:14" />Ha'noke edike annuwwi'a uwwona'a kakate'enaxxee konne boga qixxe qoodemme; isinna ha'noke qadaada kadaan.<verse eid="EZK 47:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="EZK 47:15" />«Bogiinxi gabalanna konnechchin butti'a hexxeexxen:</para>
  <para style="p" vid="EZK 47:15">«Middi darree'n Lumoxxe Abbayyanaa'n kexxeexxi, Hetiloonke orii'n Hamati'a saxxeexxi Tsedaadi marte geltaan. <verse eid="EZK 47:15" /><verse number="16" style="v" sid="EZK 47:16" />Ookko'ninna Demasiqoxxenna Hamaatixxe gabala'n oddote'n hedheeke Berootakanna Sibirayiimika qachchuwwa saxxeexxi, Hawuraanixxe gabala'n hedheeke Hatseerhaatikon qachcha'n marte gelta. <verse eid="EZK 47:16" /><verse number="17" style="v" sid="EZK 47:17" />Gabalatinna Mediteranixxe Abbaayyanaa'n kexxeexxi Demasiqoxxa middi darrexxa gabala abixxite Hamaatixxa gabala middi darre'n gatisa'n Hatseer'eenaan marte gelta. Tinni middixxe gabalan.<verse eid="EZK 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 47:18" />«Boroti darrexxi gabala Hawuranxenna Demasiqoxxe oddoo'n saxxeexxi, Yordaanoosi darree'n Gele'adixxenna Isira'eelike bogixxe oddonaa'n saxxa'n borotixxe Abbaayya qico'n muguggiteexxi Tamari marte gelta. Tinni borotixxe gabala kaddaan.<verse eid="EZK 47:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 47:19" />«Bita'i darrexxi gabala Tamare'ni kexxeexxi Meribaa Qaadeesike wode'i qico'n, ooko'ninna Gibtseke galaaniinxa Lumoxxe Abbayya qico'ni marte gelta. Tinni bita'ixxe gabalan.<verse eid="EZK 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 47:20" />«Dhidhim darrexxi gabala kinni Hamaatixxe hulake kallachcha'n hexxeexxe Lumoxxe Abbayya qico'niten. Tinni dhidhimiinxe gabala kaddaan.<verse eid="EZK 47:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="EZK 47:21" />«Kunnise konne boga Isira'eelike gosatike minike laakkosixxe qixxe'n qoqqodendina. <verse eid="EZK 47:21" /><verse number="22" style="v" sid="EZK 47:22" />Ha'no ifi'aanna, ha'no giddo hedheeke oose afeeke alaguwwi'a geego kado'a hixik qoodemme; Insa'neenna Isira'eelike ilemi mannishsha uudde; ha'noshanni Isira'elixe gosake minik qadaadi insa'ne'anna uwwemowaal. <verse eid="EZK 47:22" /><verse number="23" style="v" sid="EZK 47:23" />Alagichchi hoone gosatike mini giddo hedhoole, ookkonee isika geego isi'a uwwe,» hiyya'neen Lumok Duuchchi Woddik Gootti.<verse eid="EZK 47:23" /></para>
  <chapter eid="EZK 47" />
  <chapter number="48" style="c" sid="EZK 48" />
  <para style="s1">Boginka Qooddo</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 48:1" />«Boga dhaalatee summi borreessemeke gosatik minuwwi konnechchinn butti'a hedheeken: middi darre'n Daanik gosatik mini mitte qoobo afa; kunninna Hetiloonika ora abixxe Hamaatixxe hula qico gaya. Hetseer'eenaaninna Hamaati'n itti aande hexxeexxi middixxi Demasiqoxxi gabala borotenaa'n dhidhimi qico'n hexxeexxe Danixxe gabalaxxe mitte kuta kaddaan.<verse eid="EZK 48:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZK 48:2" />«Aseerik gosati mini mitte qoobbo alfa; kunninna borotenaa'n dhidhimiin qico'n hedheek Daanik bogi isoo gabalaan.<verse eid="EZK 48:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 48:3" />«Nefitaalemik gosatik mini mitte qoobbo alfa; kunninnaa Aseerika boga borotenaa'n dhidhimi qico'n gabalaan.<verse eid="EZK 48:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 48:4" />«Minaasek gosatik mini mitte qoobbo alfa; kunninna Nefitaalemika boga borotenaa'n dhidhimi qico'n gabalaan.<verse eid="EZK 48:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 48:5" />«Efireemik gosatik mini mitte qoobbo alfa; kunninna Minaaseka boga borotenaa'n dhidhimi qico'n gabalaan.<verse eid="EZK 48:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 48:6" />«Roobelik gosatik mini mitte qoobbo alfa; kunninna Efireemika boga borotenaa'n dhidhimi qico'n gabalaan.<verse eid="EZK 48:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 48:7" />«Yihudak gosatik mini mitte qoobbo alfa; kunninna Roobelika boga borotenaa'n dhidhimi qico'n gabalaan.<verse eid="EZK 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 48:8" />«Yihuda'a borotenaa'n dhidhimiqico'n gabalaaka boga gargar hexxeexxe uwwa'a shiqaake qoobbo kadaan; godobikinna lame tommenna onde kuma ciqile kada; borotenaa'n dhidhimi qico'n hedheek isik qeerrinni mitte gosatike minuwwike mitte qoobbixxe qixxe kadee'na'a galmi oddo isixxe'n hedhaan.<verse eid="EZK 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 48:9" />«Kunni Duuchchi Woddike Gootti'a gargar hexxeexxe uwwa'a shiqishina'neek bogi qeerne lame tommenna onde kuma ciqile, godoba tomme kuma ciqile kada. <verse eid="EZK 48:9" /><verse number="10" style="v" sid="EZK 48:10" />Qeesoletinna tenne woyyondeexxe bakkanaa'n qoobbo alfa; kuninna middi darrenaa'n qeerrinne lame tommenna onde kuma ciqile; dhidhimi darrenaa'n godoba tomme kumma ciqile, boroti darrenaa'n godoba tomme kuma ciqile kadeexxi, bita'i darreenaa'n qeerrinne lame tommenna onde kuma ciqile kada; Duuchchi Woddike Goottik galmi isixxe oddo'n hedhaan. <verse eid="EZK 48:10" /><verse number="11" style="v" sid="EZK 48:11" />Tinni bakka Isira'eelito deetee wodda deetemmaxxe Leewwitoshsha deetebaang gatteexxe, addatemati ani'a ergatendeexxe woyyitte qeesole Sadoqittotixxe bakka kadda. <verse eid="EZK 48:11" /><verse number="12" style="v" sid="EZK 48:12" />Tinni bakka bogiinxe woyyitte bakkanaa'n insa'ne'a gargar hexxeexxe uwwa kadda; kunninna hara woyyichcha booncho kadeexxi gabala Leewwitotike boga kaddaan.<verse eid="EZK 48:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 48:13" />«Qeesoletike bogike cinaacha'n Leewwito qeerrinne lame tommenna onde kuma ciqile, godoba tomme kuma ciqele boga alffa; konne bogik duuching qeerrinni lame tommenna onde kuma ciqile godoba tomme kuma ciqile kadaan. <verse eid="EZK 48:13" /><verse number="14" style="v" sid="EZK 48:14" />Konne boganaan'n insa'ne gurgura yookaan jijjiira hassisaba'a; kunni boga duuchanaa'n Duuchchi Woddike Gotti'a foyyemeexxi woyyichchake kademmaxxee wele manna'n sa'aba'a.<verse eid="EZK 48:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 48:15" />«Godoba onde kuma ciqilek, qeerrinne lame tommenna onde kuma ciqile afeek gateek bogi qachchinxe gollotixxe la'o'a, minuwwinke ijaarsi'anna hore bobarsatee kadeexxi qachchinxe oddo'n hedha. <verse eid="EZK 48:15" /><verse number="16" style="v" sid="EZK 48:16" />Konne qachchixxi mike middi darree'n shoole kumanna onde dhibba ciqile, bita'i darree'n shoole kumanna onde dhibba ciqile, boroti darree'n shoole kumanna onde dhibba ciqile, iittanni dhidhimi darree'ninna shoole kumanna onde dhibba ciqilen. <verse eid="EZK 48:16" /><verse number="17" style="v" sid="EZK 48:17" />Qachchikinna horiinxe boba'aka booncho afa, middi darree'n lame dhibbanna onde tomme ciqile, bita'i darree'n lame dhibbanna onde tomme ciqile, borot darree'n lame dhibbanna onde tomme ciqile, dhidhimi darree'n lame dhibbanna onde tomme ciqile kada. <verse eid="EZK 48:17" /><verse number="18" style="v" sid="EZK 48:18" />Konnenaa'n gateek woyyiitte kuta'n gabalema'n iseke cinaacha'n hedheek boonchi, borot darree'n tomme kuma ciqile, dhidhimi darree'n tomme kuma ciqile kada; isixxi midhanna konne qachchike hujjaluwi'a itatee kadda. <verse eid="EZK 48:18" /><verse number="19" style="v" sid="EZK 48:19" />Boga wiilsaak hujalluwwi duuchinge Isira'eelike gosatike minenaa'n daga. <verse eid="EZK 48:19" /><verse number="20" style="v" sid="EZK 48:20" />Bogink shooling kasi weli qixxete kadaa wodda, mitti mittin kasi lame tommenna onde kuma ciqilen; qachchinxe kuttanninni mitteba gargar hexxeexxe uwwa'a woyyichcha booncho gargar hiissitinaan.<verse eid="EZK 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 48:21" />«Woyyichcha booncho'ninna qachchinxe kuttake middi bita'a'n gateek bogi galchallinke kada; kunninna lame tommenna onde kuma ciqile kade'eke woyyichcha boonchinaa'n boroti darrexxe gabala qico'n mare geyaleni; dhidhimi darre'ninna iittanni lame tommenna onde kuma ciqile kadeeke boonchinaa'n dhidhimiinxe gabala qico'n mare geya; gosatike mini minike qoobbo kade'eeke bogike cinaachcha abixxe me'aak boonchi duuchchi galchalliinke kada; woyyichchi boonchinna galmi isixxe oddo'n hedhaan. <verse eid="EZK 48:21" /><verse number="22" style="v" sid="EZK 48:22" />Tennexxee Leewwitotixxi karranna qachchinke mannixxi karra galchallokee uwwemeeke bogixxe oddo'n kaddaan; galchallink boginna Yihudaxxenna Biniyaamixxe gabalaxxe oddo'n kaddaan.<verse eid="EZK 48:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 48:23" />«Wele gateeke gosa gosake mini mini hadik qoobbi konneechchinni butti'a hedheeshshaten: Biniyaamik gosatike mini mitte qoobbo alfa; kuninna borotenaa'n dhidhimii qico'n mare geya.<verse eid="EZK 48:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 48:24" />«Simoonik gosatik mini mitte qoobbo alfa; kunninna borotinaa'n dhidhimi qico'n Biniyaamika boga gabalaan.<verse eid="EZK 48:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 48:25" />«Yisakoorik gosatik mini mitte qoobbo alfa; kuninna borotenaa'n dhidhimi qico'n Simoonika boga gabalaan.<verse eid="EZK 48:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 48:26" />«Zaabilonk gosatik mini mitte qoobbo alfa; kunninna borotenaa'n dhidhimi qico'ni Yisakoorika boga gabalaan.<verse eid="EZK 48:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 48:27" />«Gaadik gosatike mini mitte qoobbo alfa; kunninna borotenaa'n dhidhimii qico'n Zaabilonka boga gabalaan.<verse eid="EZK 48:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 48:28" />«Gaadixxi bita'i darrexxi gabala bita'a Taamarkenaa'n kexxeexxi Meribaa Qaadeesi wodu'uwwin qico'n gelta; okkoninna Gibtsexxa bogoxxa oyyoxxa duuka me'ite Lumoxxa Abbayya qico'n marte geltaan.<verse eid="EZK 48:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EZK 48:29" />«Kunni qici Isira'eelike gosatike mini mini'a qadaadake kado'a boga qoodinaa qicon; mitti mittingik qoobbinna konnenden» hiyya'nee'n Lumok Duuchchi Woddik Gootti.<verse eid="EZK 48:29" /></para>
  <para style="s1">Qachchuwwiinxa Hulluwwa</para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 48:30" />«Qachchinxi fulatixxi huluwwa konnechchinni butti'a hexxeeshshaten: middi darree'n shoole kumanna onde dhibba ciqile qeerrinne afeexxi hula, <verse eid="EZK 48:30" /><verse number="31" style="v" sid="EZK 48:31" />Qachchinxa hulluwwa Isira'eelike gosatike mini minike summinni ye'endaaxxe kaddaan; middi darree'n hexxeexxi sase huluwwa Roobelike gosatike minixxi hula, Yihudake gosatike minixxe hulanna Leewwike gosatike minixxe hula kaddaan.<verse eid="EZK 48:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 48:32" />«Boroti darree'n shoole kumanna onde dhibba ciqile qeerrinne afe'exxi sase huluwwa hexxaan; tinnirinna Yooseefike gosatike minixxi hula, Biniyaamike gosatike minixxi hulanna Daanike gosatike minixxe hula kaddaan.<verse eid="EZK 48:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 48:33" />«Bita'i darree'n shoole kumanna onde dhibba ciqile qeerrinne afe'exxe sase hulluwwa hexxe; tinniriinna Simoonike gosatike minixxi hula, Yisakoorike gosatike minixxe hulanna Zaabilonike gosatike minixxe hula kaddaan.<verse eid="EZK 48:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="EZK 48:34" />«Dhidhimi darre'n shoole kumanna onde dhibba ciqile qeerrinne afe'eexxi sase hula hexxeen; tinniirinna Gaadike gosatike minixxi hula, Aseerike gosatike minixxe hulanna Nefitaalemike gosatike minixxe hula kaddaan.<note caller="-" style="x"><char style="xo" closed="false">48:34 </char><char style="xt" closed="false"><ref loc="REV 21:12-13">Wal. 21:12-13</ref>. </char></note><verse eid="EZK 48:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 48:35" />«Konne qachchixxe dowwek duuching qeerrinni tommenna saddeeta kuma ciqile kadaan.</para>
  <para style="p" vid="EZK 48:35">«Eettene yannanaa'n qachchiink summi: Duuchchi Woddik Gootti ookko'o hedhe hiyyemaan.»<verse eid="EZK 48:35" /></para>
  <chapter eid="EZK 48" />
</usx>