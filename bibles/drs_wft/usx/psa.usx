<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Gedeo Bible</book>
  <para style="h">Faarotikaa Maxaafa</para>
  <para style="toc1">Faarotikaa Maxaafa</para>
  <para style="toc2">Faarotikaa Maxaafa</para>
  <para style="toc3">Far.</para>
  <para style="mt1">Faarotikaa Maxaafa</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Faarotik maxaafi woyyichchi maxaafi giddo hedheeke maxaafuwwa duuchchanaa'ni qeeredheeken. Tinni faaruwwa mitte manjinni yookaan mittoomik faarsendaaxxe yookaan haassessendaaxeran.</para>
  <para style="ip">Konne maxaafi giddo dhibbanna onde tomme faaruwwa afendaan. Tenne faaruwwanaa'n bira saxxaaxxa borreeseek moyanjo Daawwititen. Qeerake baro'ninna bukki assendeexxi Isira'eelike ardixxe magenoofachchotixxe aada'a umoke kadde. Mitte mitte faaruwwa hitta hedheeka faarotika miyanna hitta hedheeka meella hordofa hassissaaxxa faarsaleeyyetik sooreessa akeekaan. Fakkeennakee faaroo shoolenna faaro shoole tommenna onde uudi. Saadinoo, galataa, amanaa, addee, cubbotixxee hangulli hiyyaa, Duuchchi Woddike Goottixxa xuurameessummanna isika gargaarsa fakkaataakiir umi woyyichchi maxaafik yaaduwwi tennee faaruwwa giddo borreeseme'een.</para>
  <para style="ip">Tennee faaruwwa'a umoke kadeeki oddichchi yaadi Duuchchi Woddike Gootta'ni addataten. Faaruwwa tennek borreessanjuwwi Duuchchi Woddika Gootta galateefatat yookaan ifi ifixxa rakko ifisat dhugaatixxa ifixxa ko'o shiqisaan.</para>
  <para style="ip">Olmik Isira'eelik ardi tennee faaruwwa gargar gargar hedheeke jeeji giddo la'oofataamman. Tnninna:</para>
  <para style="ip">1. Faaroo 105 diiri Duuchchi Widdika Gootta galateefatatee'e.</para>
  <para style="ip">2. Faaroo 13 siiri yaaddo leellishatee'e.</para>
  <para style="ip">3. Faaroo 1 teeri barachchiisatee'e.</para>
  <para style="ip">4. Faaroo 72 miiri Isira'eelik moyanjuwwi toggitte murte muraashsha soodatatee'e.</para>
  <para style="ip">5. Faaroo 47 niiri Duuchchi Woddiki Gootti ifixxe dada duuchcha'n afeeka baallooma ege'nishatee'e.</para>
  <para style="ip">6. Faaroo 122 miiri Iyyerusaalemi'a jaalala leellishatee'e.</para>
  <para style="ip">7. Faaroo 126 niiri ayyaannuwwa ulfeesateeraten.</para>
  <para style="ip">Dhuggaaten, heddo faaruwwa mitte yaadi iimi darre afa dandeetaani. Gootti no'ok Yessuusi Kirstoosi lallabaamma woddanna barachchiisaamma wodda heddo yaanna tennee faaruwwa giddii'n la'onfataamman. Haaroxxe kakok borreessalluwwinna yanna yanna'ninni faarotike Maxaafanaa'ni kula'emman. Olmixxi Kirstoositonna Yessuusi Kirstoosi darree'ni Duuchchi Woddiki Gootti asseexxa eloxxa yaane magenooffachchotee'e tennee faaruwwa la'oofanfante'een. Fakkeennakee'e faarotika Maxaafa 118 giddo afemaak 22 laakkoossi haaroxxe kako giddo jaanele kuleme'een.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="ip">Kunni Faafotik maxaafi onde shiixaramma kutuwwa'n qoodemaan: siretixxenna langaxxe kutuwwa giddii'n bira saxxaaxxi borreesende'eek moyanjo Daawwitinniten. Sakkaxxe kutaxxi faaroor borreesende'eek Asaafinniten, yookaan Qorxe oosennite.</para>
  <para style="ip">Faaro 120—134 ayyaanuwwa ulfeesatixxe aadaxxe faaruwwaan; konneechchinni butta iitti onde shiixaramma kutuwwa shiqqe'een:</para>
  <para style="io1">Taakkaka Maxaafa <char style="ior"><ref loc="PSA 1-41">1—41</ref> </char></para>
  <para style="io1">Langaka Maxaafa <char style="ior"><ref loc="PSA 42-72">42—72</ref> </char></para>
  <para style="io1">Sakkaka Maxaafa <char style="ior"><ref loc="PSA 73-89">73—89</ref> </char></para>
  <para style="io1">Sholgaka Maxaafa <char style="ior"><ref loc="PSA 90-106">90—106</ref> </char></para>
  <para style="io1">Ondika Maxaafa <char style="ior"><ref loc="PSA 107-150">107—150</ref> </char></para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="ms">Taakkaka Maxaafa</para>
  <para style="mr">
    <ref loc="PSA 1-41">Far. 1—41</ref></para>
  <para style="s1">Qullichchi Manjixxanna Fuggaalleessi manjixxa Me'a</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1" />Fuggaalleeyyetike gorsa'n me'abaake</para>
  <para style="q2" vid="PSA 1:1">cubballeeyyetika ora'n hordofabaake</para>
  <para style="q2" vid="PSA 1:1">caaqalleeyyeti welti hosabaake manjixxa wodo!<verse eid="PSA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2" />Iitta hedheki manji</para>
  <para style="q2" vid="PSA 1:2">Duuchchi Woddike Goottike seera'n gammadaan;</para>
  <para style="q2" vid="PSA 1:2">Duuchchi Woddike Goottika seera hashshanna barra hedaan.<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JER 17:8">Erm. 17:8</ref>. </char></note><verse eid="PSA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3" />Tennexxee isii</para>
  <para style="q2" vid="PSA 1:3">wodi'in qarqara late'emmake,</para>
  <para style="q2" vid="PSA 1:3">galebaang gummisammake,</para>
  <para style="q2" vid="PSA 1:3">shafakanna harcasammabaake haqichchishaten;</para>
  <para style="q1" vid="PSA 1:3">Hujaaxxi duuchchanna isi'a qajeeldaan.<verse eid="PSA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4" />Fuggaaleeyye kinni iitatebaan;</para>
  <para style="q2" vid="PSA 1:4">insa'ne diidallo filte adhite me'itammake huurishaten.<verse eid="PSA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5" />Tennexxee fuggaaleeyye</para>
  <para style="q2" vid="PSA 1:5">Magenixxe murte baro murtetenaa'n gattabaan;</para>
  <para style="q2" vid="PSA 1:5">cubbaleeyyetinna qulliyyetixxe tuutanni welti hexxabaan;<verse eid="PSA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6" />Duuchchi Woddiki Gootti qulliyyetixxa me'a e'ge'ne'een;</para>
  <para style="q2" vid="PSA 1:6">fuggaaleeyyetiki ori kinni ba'nete'ni geessissaan.<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="s1">Mageni Fi'leeka Moyanjo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1" />Mageno ege'nebaaki ardi mayeete diinakee'e bukki hiyya'neek?</para>
  <para style="q2" vid="PSA 2:1">Gosa gosak arduwwi tolanga mayeete yaane miciiraak?<verse eid="PSA 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2" />Buttatiki moyanjuwwinna insaa'nek ja'laabuwwi</para>
  <para style="q2" vid="PSA 2:2">Duuchchi Woddiki Gootti hariireke'ninna Duuchchi Woddike Gootta'n fuggoxxa mari'ato'a bukki hiyye.<note caller="-" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="ACT 4:25-26">Erga. Huj. 4:25-26</ref>. </char></note><verse eid="PSA 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3" />Tennexxee, «Amme insa'nexxe galchaka haachaba no'oxxe lekkanaa'n tanshino;</para>
  <para style="q2" vid="PSA 2:3">wodaro insa'neexxanna kunte ifinaa'ni hunno» hine.<verse eid="PSA 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4" />Iima mootete'ni hedheeki Gootti insa'ne oso'le;</para>
  <para style="q2" vid="PSA 2:4">insa'neke toliinke heduma'ninna gacifate.<verse eid="PSA 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5" />Ookkoneechchi uduma Mageni mufe ifixxenni insa'nee xixaan;</para>
  <para style="q2" vid="PSA 2:5">yo'oshsha aarenna insa'nee sodachchisaan.<verse eid="PSA 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6" />Tennexxee, «woyyitte anxa kooba Tsiyoon hana</para>
  <para style="q2" vid="PSA 2:6">fi'lennek moyanji mowaashsha assenne» hiyye.<verse eid="PSA 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 2:7" />Moyanjikinna ani Duuchchi Woddike Goottika seera lallabannon;</para>
  <para style="q2" vid="PSA 2:7">Megenikinna anee hiyyee qici, «Ati anke beltoni, ani telcho atee i'leennen;<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="ACT 13:33">Erga. Huj. 13:33</ref>; <ref loc="HEB 1:5">Ibr. 1:5</ref>; <ref loc="HEB 5:5">5:5</ref>. </char></note><verse eid="PSA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8" />Anee kadhati, gosa gosaki ardi duuchchi ati'a hiremaashsha assannon;</para>
  <para style="q2" vid="PSA 2:8">butta duuchchanna galchitota'a ati'a uwwannon.<verse eid="PSA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9" />Mootondetexxi, lekka atixxinni insa'nee hiribeessittaton;</para>
  <para style="q2" vid="PSA 2:9">faariinke miyishshanna insa'nee butuchchite bulleessittaton.»<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="REV 2:26-27">Wal. 2:26-27</ref>; <ref loc="REV 12:5">12:5</ref>; <ref loc="REV 19:15">19:15</ref>. </char></note><verse eid="PSA 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10" />Tennexxee ha'no buttatike moyanjuwwaa konnee xixxichcho qalbeeffatte;</para>
  <para style="q2" vid="PSA 2:10">ha'no buttiki ja'labuwwinna tennee daabbachcho kassi hiyye.<verse eid="PSA 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11" />Duuchchi Woddike Gootti'a soda'ati ergatemme;</para>
  <para style="q2" vid="PSA 2:11">culphisinna'ni isi'a hiremme.<verse eid="PSA 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12" />Aare isixxi iikki woddi bubbammaxxee ha'noo mufate balleessabashsha</para>
  <para style="q2" vid="PSA 2:12">culphisina'ni isoo ulfeesse;</para>
  <para style="q2" vid="PSA 2:12">isoo gollake assedhaaka duuchcha eebbisaan.<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="s1">Rakko Giddo Hedheeke Manjixxa Gorsixxa Soodachcho</para>
  <para style="d">Daawwit belto ifike Abeseloominaa'n baaje wodda Farseexxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1" />Ee, Duuchchi Woddike Goottaa diini ane'ni bira sa'een!</para>
  <para style="q2" vid="PSA 3:1">Heddi manninna ane'n ke'een.<verse eid="PSA 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2" />Heddi manni, «Mageni isoo gargaarabaan» hiyya'n anxee haaso'een.<verse eid="PSA 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3" />Ee, Duuchchi Woddike Goottaa ati kinni anxe wonten;</para>
  <para style="q2" vid="PSA 3:3">naapha anka injifatannoshsha assite'e anee ulfeessitetek ateten.<verse eid="PSA 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4" />Duuchchi Woddik Gootti anee gargaarashsha hafuura gikki assee isoo ye'edhannon;</para>
  <para style="q2" vid="PSA 3:4">isinna ifixxe woyyitte kooba hana hedhee hissichcho ani'a uwwaan.<verse eid="PSA 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5" />Ani irkateennen; dhiiphikinna anee adhdhe.</para>
  <para style="q2" vid="PSA 3:5">Duuchchi Woddiki Gootti hashsha duuchcha anee heqqammaxxee'e</para>
  <para style="q2" vid="PSA 3:5">nage'iki diiphokenaa'n ke'enne.<verse eid="PSA 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6" />Gami gamii'ni ane'n gumeeka</para>
  <para style="q2" vid="PSA 3:6">golgola naapha sodaatabe'no.<verse eid="PSA 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7" />Ee Duuchchi Woddike Goottaa ke'ii!</para>
  <para style="q2" vid="PSA 3:7">Ee anke Duuchchi Woddike Gootta anee gargaar</para>
  <para style="q1" vid="PSA 3:7">Anke naaphi duuchchika qeqeeshanna gandatoni;</para>
  <para style="q2" vid="PSA 3:7">fuggaalleyyetixxa issonna enqitaton.<verse eid="PSA 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8" />Gargaarsi Duuchchi Woddike Gooattanaa'niten;</para>
  <para style="q2" vid="PSA 3:8">Magenoo ati arda atika eebbisi.<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="2SA 15:13-17:22">2 Sam. 15:13—17:22</ref>. </char></note> <char style="qs">Seela </char><verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="s1">Mageno Addatatee'e Shiqqeexxa Soodachcho</para>
  <para style="d">Faarsaleeyyetike akeekisanji'a. Baganik faarsendaaxxa Daawwitixxa faaro</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 4:1" />Ee qullichcha Magenoo,</para>
  <para style="q2" vid="PSA 4:1">ye'edhanno wodda hissichcho ani'a uwwi;</para>
  <para style="q1" vid="PSA 4:1">Abara ankenaa'n anee'e hafuura adhdhise'etan;</para>
  <para style="q2" vid="PSA 4:1">ta'anna ani'a marar; soodachcho anxanna laqi.<verse eid="PSA 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2" />Koo mannaa, ha'no haani qico'n anee salphissina?</para>
  <para style="q2" vid="PSA 4:2">haani qico'n wayifuldabaaxxa yaane eetina?</para>
  <para style="q2" vid="PSA 4:2">Haani qico'n dhara halsitina? <char style="qs">Seela</char><verse eid="PSA 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3" />Duuchchi Woddiki Gootti addatemeeka manna ifi'a fi'leexxa ege'ne;</para>
  <para style="q2" vid="PSA 4:3">Duuchchi Woddik Gootti isiba'a soodatanno wodda laqee anee gargaraan.<verse eid="PSA 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4" />Fedhee qico muffatinoolenna cubbo hujjinoqqe'e;</para>
  <para style="q2" vid="PSA 4:4">ma'na diiphineeba hexxineexxi</para>
  <para style="q2" vid="PSA 4:4">godobi giddo hedde; samminna hiyye.<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="EPH 4:26">Efe. 4:26</ref>. </char></note><verse eid="PSA 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5" />Duuchchi Woddike Gootti'a qullichcha tolcha tolche;</para>
  <para style="q2" vid="PSA 4:5">isoonna addatte.<verse eid="PSA 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6" />Heddo mannan, «No'o'a eloxxa yaane ayyette leellisha?» hiyya'neek;</para>
  <para style="q2" vid="PSA 4:6">Ee Duuchchi Woddike Goottaa</para>
  <para style="q2" vid="PSA 4:6">atike albik ifi no'o'n xabowwaal.<verse eid="PSA 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7" />Manni midhatanna woyinetixxa booka alfe wodda gammada irra</para>
  <para style="q2" vid="PSA 4:7">hedho anxe'ni lumoxxa gammashsho wonshite'eeten.<verse eid="PSA 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8" />Ee Duuchchi Woddike Goottaa! Nage'ik hedhona'a assiteteki aten calla kaddetexxee'e</para>
  <para style="q2" vid="PSA 4:8">irkatanno woddanna nage'iinke diipho diiphannon.<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="d">Faarsaleeyyetike akeekisanji'a suusu'leti faarsendaaxxa Daawwitixxa Faaro</para>
  <para style="s1">Gargaarsiinxa Soodachcho</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 5:1" />Eee Duuchchi Woddike Goottaa! Haaso'a anka caqasi;</para>
  <para style="q2" vid="PSA 5:1">fooxxi hiyya anxanna laqi.<verse eid="PSA 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2" />Eee Duuchchi Woddike Goottaa! Atibaa soodataannaxxee'e</para>
  <para style="q2" vid="PSA 5:2">gargaarsake soodatannoxxa anxa soodachcho laqi.<verse eid="PSA 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3" />Ee Duuchchi Woddike Goottaa! Gorsa hafuura anka laqqaton;</para>
  <para style="q2" vid="PSA 5:3">gorsa gorsa'inni soodachcho anxee hiissittatoka hiissichcho heqqedhaanneni.<verse eid="PSA 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4" />Ati cubbote'n gammaddatoke Magenobaan;</para>
  <para style="q2" vid="PSA 5:4">fuggaaleeyyenna atinni welti hexxabaan.<verse eid="PSA 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5" />Hollaameeyye ati edo uura dandeettabaan;</para>
  <para style="q2" vid="PSA 5:5">fuggoxxa assaka duuchcha gibbaton.<verse eid="PSA 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6" />Dhara haaso'aka duchcha birtatton;</para>
  <para style="q2" vid="PSA 5:6">manjo lubbo balleessaakanna sobaaleessa manna xireeffattatton.<verse eid="PSA 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7" />Ani kinni atixxe lumoxxe gattowalinaa'n kexxeexxa mine atike'ni e'yannon;</para>
  <para style="q2" vid="PSA 5:7">woyyichcha atike dunkaan giddo atee ulfeessa'n magenofatannon.<verse eid="PSA 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8" />Duuchchi Woddike Gooattaa! Heddo naapha afe'eennen;</para>
  <para style="q2" vid="PSA 5:8">tennexxee seera atike'n galona'a anee akeek;</para>
  <para style="q2" vid="PSA 5:8">ora atikanna ani edo ani'a qajeelchi.<verse eid="PSA 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9" />Anke naaphiki haaso'i duuchchi mittikinna dhugaate kada gophemmaxxe'e,</para>
  <para style="q2" vid="PSA 5:9">afo'i insa'neek dhugaa'a haaso'abaan; godobi giddonna fuggoxxe</para>
  <para style="q2" vid="PSA 5:9">uggudhine'een; elobaaxxa haaso'at manna dedhinse reyaashsha assine;</para>
  <para style="q2" vid="PSA 5:9">arabi insaneekinna dhuga'a haaso'abaan.<verse eid="PSA 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10" />Eee Magenoo naapha ankeeri'a huje isa'nexxishshanni uwwi;</para>
  <para style="q2" vid="PSA 5:10">xaqaro hunjammaxxi insa'ne'inni higgowwaal;</para>
  <para style="q2" vid="PSA 5:10">cubbo bira saxxeexxa hunja'ni ati'a jallantemmaxxee insa'nee balleessi<verse eid="PSA 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11" />Ate'ni gollataaki duuchchi gammadowwaali;</para>
  <para style="q2" vid="PSA 5:11">duuchchi woddi'anna illillisowwaal;</para>
  <para style="q2" vid="PSA 5:11">atee eeyyaki duuchchi gammado'a insa'ne'a gollake kadi.<verse eid="PSA 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12" />Duuchchi Woddike Goottaa ati qulliyye eebbissaton;</para>
  <para style="q2" vid="PSA 5:12">arjunte atixxenni atee eeyakanna wontete kadde'e gollittatton.<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="d">Faarsaleeyyetike akeekisanji'a baganik faarsendaaxxa Daawwitixxa faaro</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 6:1" />Ee Duuchchi Woddike Goottaa mufet anee gandoxxe'e;</para>
  <para style="q2" vid="PSA 6:1">aaretinna anee xixxoxxe'e.<verse eid="PSA 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2" />Ee Duuchchi Woddike Goottaa! Hunna gopheenneni ani'a marar;</para>
  <para style="q2" vid="PSA 6:2">micci anki duuchchi gilgile'een ballo anee fayyisi.<verse eid="PSA 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3" />Ee Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 6:3">Hedho anxi duuchcha yo'oshsha rakkate'een;</para>
  <para style="q2" vid="PSA 6:3">haani qici'aateta iitta kada'ni hedhaannek?<verse eid="PSA 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4" />Ee Duuchchi Woddike Goottaa! Anba'a higge'e hedho anxa wodi;</para>
  <para style="q2" vid="PSA 6:4">yo'oshsha anee eettaattaxxee anee anjir.<verse eid="PSA 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5" />Reyemmake manni giddii'n ke'exxi atee qaabataak hedhebaan;</para>
  <para style="q2" vid="PSA 6:5">hirreesi giddo moogemeeba hedhe'e atee galateefataak hedhebaan.<verse eid="PSA 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6" />Yaadotixxe bira sa'nenaa'ni kexxeexxa gophe'eennen;</para>
  <para style="q2" vid="PSA 6:6">oodhishatixxe bira sa'nenaa'ni kexxeexxa hashsha hashsha'inni indiddo ma'na anxa</para>
  <para style="q2" vid="PSA 6:6">coo'mi assiteen;</para>
  <para style="q2" vid="PSA 6:6">boraate anxinna corco hiteen.<verse eid="PSA 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7" />Naapha ankenaa'n kexxeexxa</para>
  <para style="q2" vid="PSA 6:7">yo'oshsha oodhenaxxee ille anxi garjite afa gophphe.<verse eid="PSA 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8" />Duuchchi Woddiki Gootti oodhishsha anxa laqe'een;</para>
  <para style="q2" vid="PSA 6:8">tennexxee ha'no fuggoxxa halsitinaak anenaa'n bayyatte!<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="MAT 7:23">Mat. 7:23</ref>; <ref loc="LUK 13:27">Luq. 13:27</ref>. </char></note><verse eid="PSA 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9" />Duuchchi Woddiki Gootti oodhishsha anxa laqe'een;</para>
  <para style="q2" vid="PSA 6:9">soodachcho anxeenna hiissichcho uwwaan.<verse eid="PSA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10" />Naaphi anki shookaan;</para>
  <para style="q2" vid="PSA 6:10">dedhange'n salphatenna udumi'a higaan.<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="d">Daawwit Biiniyaamichcho Kuushixxe buutonni Duuchchi Woddike Gootti'a faarseexxa faaro</para>
  <para style="s1">Dhuga Hujendaashsha Shiqqeexxa Soodachcho</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 7:1" />Ee Duuchchi Woddike Gootta anke Magenoo!</para>
  <para style="q2" vid="PSA 7:1">Ati anke gollan;</para>
  <para style="q2" vid="PSA 7:1">shorra'neeke naapha anke duuchchanaa'n anee anjirte'e gatisi.<verse eid="PSA 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2" />Anjira gophphottole kinni Neeqishsha bunte ayyinna anee'e gargaarabaake booncho'n</para>
  <para style="q2" vid="PSA 7:2">anee ninniffee kukkuntaan.<verse eid="PSA 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3" />Ee Duuchchi Woddike Gootta anke Magenoo!</para>
  <para style="q2" vid="PSA 7:3">Mitte manjo midde balleesoonnole,<verse eid="PSA 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4" />Ani'a eloxxa assemmakee'e fuggoxxa asso'oonnole</para>
  <para style="q2" vid="PSA 7:4">naapha ankenaa'n tola boddichcha mulqedho'oonnole,<verse eid="PSA 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5" />Naaphi anki shorre anee abixxowwaal;</para>
  <para style="q2" vid="PSA 7:5">anee gane'e reyanno qico'n hirbeessowwaal;</para>
  <para style="q2" vid="PSA 7:5">rensha ankanna bukote'ni gangalche salphisowwaal.<verse eid="PSA 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6" />Ee Duuchchi Woddike Goottaa! Mufate'e qophphi hite ke'i;</para>
  <para style="q2" vid="PSA 7:6">mufeti daga'neeka naapha ankanna fuggussi;</para>
  <para style="q2" vid="PSA 7:6">dhuga dabbebaang toggi hite'e me'ito'a ajjajeeteshshanni</para>
  <para style="q2" vid="PSA 7:6">ane gargaartota'a qophphi hite ke'i.<verse eid="PSA 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7" />Gosa gosaka arda ifi qarqara bukki assexxe'e</para>
  <para style="q2" vid="PSA 7:7">iimate'n hexxe'e insa'ne'n moyi.<verse eid="PSA 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8" />Duuchchi Woddiki Gootti arda duuchcha'n muraan;</para>
  <para style="q2" vid="PSA 7:8">ee Duuchchi Woddike Goottaa! Anxe qullummashshanna anxee adatenshashshanni ane'n mur.<verse eid="PSA 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9" />Hedumakanna godoba manjinka egendeeteke qullichcha Magenoo!</para>
  <para style="q2" vid="PSA 7:9">Fuggaaleeyyetixxa xaqaro balleessi;</para>
  <para style="q2" vid="PSA 7:9">qulliyye nage'ik ti'ni hite'e hexxashsha assi.<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="REV 2:23">Wal. 2:23</ref>. </char></note><verse eid="PSA 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10" />Qajeelummati isi'a ergataaka anjiraak,</para>
  <para style="q2" vid="PSA 7:10">Mageni isi anxe wonten.<verse eid="PSA 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11" />Mageni duuchchi Wodda fuggaaleeyyete'n muraakee</para>
  <para style="q2" vid="PSA 7:11">dhugaatike hayyichchan.<verse eid="PSA 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12" />Fuggaaleeyye fuggoxxe hujenaa'n higa gophphoole</para>
  <para style="q2" vid="PSA 7:12">Mageni wolantichcha ifika qaraan;</para>
  <para style="q2" vid="PSA 7:12">mogido ifikaanna qixxeessaan.<verse eid="PSA 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13" />Shiyaaka ifika lolinka miyanna qixxeessaan;</para>
  <para style="q2" vid="PSA 7:13">giiratishsha buba'neeka ifika mogiduwwanna qophpheessaan.<verse eid="PSA 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14" />Cubbaaleeyye balleessa horatte'e,</para>
  <para style="q2" vid="PSA 7:14">xaqaro sii'lawite'e,</para>
  <para style="q2" vid="PSA 7:14">dhara ildaan. <verse eid="PSA 7:14" /><verse number="15" style="v" sid="PSA 7:15" />Weleke fonxorote kaddashsha dhi'mo bale qontaan;</para>
  <para style="q2" vid="PSA 7:15">yaane kinni qonteexxe bale giddo insa'nende inba.<verse eid="PSA 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16" />Welekee assinemmaxxi fuggoxxi yaane insa'ne'anni kaddaan;</para>
  <para style="q2" vid="PSA 7:16">xaqaro hunjemmaxxinna umo insa'nege'n higgaan.<verse eid="PSA 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17" />Duuchchi Woddika Gootta qullumma isixxee galatefata'eennen;</para>
  <para style="q2" vid="PSA 7:17">Dada Duuchchike Duuchchi Woddike Goottike summi'a galatiniinxa faaro faarisa'eennen.<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="s1">Mageniinka Lumminnenna Manjiinka Ulfinna</para>
  <para style="d">Faarsaleeyyetike akeekisanji'a suusu'leti faarsendaaxxa Daawwitixxa faaro</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 8:1" />Ee Duuchchi Woddike Gootta no'oke Magenoo!</para>
  <para style="q2" vid="PSA 8:1">Summi atik butta duuchcha'n saademe'eeken;</para>
  <para style="q2" vid="PSA 8:1">ardakenaa'n ati'a shiqa'neek galatinna lummedhee iimi qico'ni geye'eeken.<verse eid="PSA 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2" />Oosetinna annoole atike lummini'a faarsitashsha assitteeten;</para>
  <para style="q2" vid="PSA 8:2">kone qicinni naaphakanna xaqarot ate'n ke'emmakaara sammi assitteten.<note caller="-" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="MAT 21:16">Mat. 21:16</ref>. </char></note><verse eid="PSA 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3" />Ati anga atixxenni daddettexxa iima uudanno wodda</para>
  <para style="q2" vid="PSA 8:3">bakka bakka'ninni uggittettexxa</para>
  <para style="q2" vid="PSA 8:3">baatenna urjuwwa uudanno wodda,<verse eid="PSA 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4" />Ati isoo heddota'a manji isi maachcho?</para>
  <para style="q2" vid="PSA 8:4">Ati isi'a xexxe'attota'a manjiinki belti isi maachcho?<verse eid="PSA 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5" />Ati isoo dadde ergannatenaa'ni butti darre hedhaashsha assitteten<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">Wele tikuwwa </char><char style="fqa" closed="false">Iimixxi erganat </char><char style="ft" closed="false">Yookaan </char><char style="fqa" closed="false">Dharcha magenuwwa hitan.</char></note></para>
  <para style="q2" vid="PSA 8:5">moyashsha assite'e ulfinnakanna lumminne isi'a uuttette.<verse eid="PSA 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6" />Daddetexxe dada duuchcha'n moya'shsha assittette;</para>
  <para style="q2" vid="PSA 8:6">dada duuchchinna isi hunda galdaashsha assittette.<verse eid="PSA 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7" />Gedhebokanna lalo, biniicha duuchchanna,<verse eid="PSA 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8" />Iimatixxa ci'anna abbaayya giddixxa quluxxu'me,</para>
  <para style="q2" vid="PSA 8:8">abbaayya giddo hexxexxa lubbo affexxa dada duuchcha moyashsha assittette.<verse eid="PSA 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9" />Ee Duuchchi Woddike Gootta, no'oke Magenoo!</para>
  <para style="q2" vid="PSA 8:9">Summi atiki butta duuchcha'n saademe'eeken!<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="s1">Dhuga'a Muraakee Mageni'a Shiqaaka Galata</para>
  <para style="d">Faarsaleeyyetike akeekisanji'a muutilaabeenike meellinni, Daawwitixxa faaro</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 9:1" />Ee Duuchchi Woddike Goottaa! Ani ate'e shenitte qalbbenni galateffata'eennen;</para>
  <para style="q2" vid="PSA 9:1">hujjeteka mambe'a duuchanna haaso'aannen.<verse eid="PSA 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2" />Ani ate'n gammada'nee, ilillisaa'enne; ee Dada Duuchchke Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 9:2">Atika summa faarsa'nee galateeffata'eenne.<verse eid="PSA 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3" />Alba atika leellishshatto wodda naaphi anki udumi'a higee baajaan;</para>
  <para style="q2" vid="PSA 9:3">guguffatenna ibeexxi ba'aan.<verse eid="PSA 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4" />Atixxe moote'n ofolde'e toggitte murte murtetten;</para>
  <para style="q2" vid="PSA 9:4">yaane anxa uude'e aneenna qullo fulchittatton.<verse eid="PSA 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5" />Dharichcha magenuwwa magenooffatammaka arda xixxeten;</para>
  <para style="q2" vid="PSA 9:5">fuggaaleeyyetanna balleessittetten;</para>
  <para style="q2" vid="PSA 9:5">duuchchi woddi'aanna dedhdhemmaashsha assitteetten.<verse eid="PSA 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6" />Naaphi no'oki duuchchi woddi'a ba'eedheen;</para>
  <para style="q2" vid="PSA 9:6">insa'neka qachchuwwanna dige'eetten;</para>
  <para style="q2" vid="PSA 9:6">insa'nenna haranga qaabbataaki hedhebaan.<verse eid="PSA 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7" />Duuchchi Woddik Gootti kinni duuchchi woddi'a moyanjoke kadee hedhaan;</para>
  <para style="q2" vid="PSA 9:7">murte uwwo'anna qopheeffate'een.<verse eid="PSA 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8" />Isi dhugaati butta galchaan;</para>
  <para style="q2" vid="PSA 9:8">toggitte murtenna ardake'e muraan.<verse eid="PSA 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9" />Duuchchi Woddike Gootti miicemeeke mani'a dalla'aken;</para>
  <para style="q2" vid="PSA 9:9">rakkoti woddanna gollaken.<verse eid="PSA 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10" />Duuchchi Woddike Gootta! Ate'e ege'neek duuchchi ate'n addataan;</para>
  <para style="q2" vid="PSA 9:10">atiba'a dagaaka duuchchanna waldaboxxon.<verse eid="PSA 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11" />Tsiyooni hedheeka Mageno farse;</para>
  <para style="q2" vid="PSA 9:11">asseka mambe'a duuchchanna arda duuchcha'ni kulle.<verse eid="PSA 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12" />Mageni miicemeeka manna qaabbataan;</para>
  <para style="q2" vid="PSA 9:12">oodhishsha insa'neexxanna dedhabaan;</para>
  <para style="q2" vid="PSA 9:12">insa'ne'e miicakanna xixaan.<verse eid="PSA 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13" />Ee Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 9:13">Ani'a marar! Naaphi ane'ni iyyedageexxa rakko uudi!</para>
  <para style="q2" vid="PSA 9:13">Reyotenaa'inna anee'e gatis!<verse eid="PSA 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14" />Tenne'e ani'a assitottole Iyyerussaalemike ardi eddo uure'e</para>
  <para style="q2" vid="PSA 9:14">ati ani'a hujjeteka galata mannake'n haasso'annon;</para>
  <para style="q2" vid="PSA 9:14">anee anjirtetexxeenna ilillissannon.<verse eid="PSA 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15" />Gosa gosak manni ifi'a qotemmanxe bale'n ibeen;</para>
  <para style="q2" vid="PSA 9:15">fonxoremmanxi fonxoro insa'neenni abiddeen.<verse eid="PSA 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16" />Duuchchi Woddiki Gootti dhugaatixxa murte muryoti ayyumma ifixxa leellishe;</para>
  <para style="q2" vid="PSA 9:16">fuggaleessi manni anga ifixxenni giissemmanxe fonxorro'ninni abiddemme.<verse eid="PSA 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17" />Fuggaaleeyye reyyemak manni hedhemmaba'a me'itaan;</para>
  <para style="q2" vid="PSA 9:17">Mageno gibaaki duuchchinna iittanden.<verse eid="PSA 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18" />Rakkiyye duuchchi wodda dedhendeeshsha gatabaan;</para>
  <para style="q2" vid="PSA 9:18">hiyyeeyyetixxi addenna duuchchi wodda tola gattabaan.<verse eid="PSA 9:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19" />Ee Duuchchi Woddike Goottaa! Qophi hite ke'i,</para>
  <para style="q2" vid="PSA 9:19">manji ate'ni ke'o'a waldoxxe;</para>
  <para style="q2" vid="PSA 9:19">dharicha magenke manna'inna mur;<verse eid="PSA 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20" />Ee Duuchchi Woddike Goottaa! Insa'ne'n soda'a ibisi,</para>
  <para style="q2" vid="PSA 9:20">manjoke kandeexxanna egenaashshsha assi.<verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="s1">Dhugaatixxe murtexxee Shiqqeexxa Soodachcho</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 10:1" />Ee Duuchchi Woddike Goottaa! Maaye'e bayyattette?</para>
  <para style="q2" vid="PSA 10:1">Rakkoti baro mayye'e no'oo maaxaffattete?<verse eid="PSA 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2" />Fuggaaleeyye ifi saadati hiyyeeyye rakkissaan;</para>
  <para style="q2" vid="PSA 10:2">mannakee fonxorremmaxxi fonxoro insa'neenni abidowwaal.<verse eid="PSA 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3" />Cubbaaleessi manji fuggoke ifike heduuma'n hollaan;</para>
  <para style="q2" vid="PSA 10:3">Duuchchi Woddike Goottaa! Ifi calla hedammaki manni</para>
  <para style="q2" vid="PSA 10:3">atee gibaan; atenna yowwaan.<verse eid="PSA 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4" />Fuggaaleeyye Duuchchi Woddik Gootti haba gaate hitabaan; holitammaxxee</para>
  <para style="q2" vid="PSA 10:4">Mageni hedhebaashsha heddaan.<verse eid="PSA 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5" />Fuggaaleessi manji'a yaane duuchcha qajeelidaan; kado malee kinni Mageniike</para>
  <para style="q2" vid="PSA 10:5">seeranaa'ini bayyate'eeken; naapha isikanna tuffataan.<verse eid="PSA 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6" />Godob giddo «Ayyinna bakka anxenaa'n annee le'misaaki hedhebaan</para>
  <para style="q2" vid="PSA 10:6">rakkote hiyyemaangchi ane'n geltebang duuchchi wodda gammada'nee hedhannon» hiyyaan.<verse eid="PSA 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7" />Haasso'i isiki giddo yowwichchi, dharinna manjo miidha gophendaabaan;</para>
  <para style="q2" vid="PSA 10:7">xaqarotinna fuggoxxa haaso'a afo'o isikenaa'n ibbabaan.<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="ROM 3:14">Rom. 3:14</ref>. </char></note><verse eid="PSA 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8" />Olla'i olla'i giddo sho'emee gadaan;</para>
  <para style="q2" vid="PSA 10:8">baassaka afebaaka manna balleesso'a heqqedhaan;</para>
  <para style="q2" vid="PSA 10:8">balleessa afebaaka manna qoonnete'n shiyaan.<verse eid="PSA 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9" />Baada'a golledhe gaadammake neenqishsha sho'ome turaan;</para>
  <para style="q2" vid="PSA 10:9">baassaaka afeebaka abido'a dabba'le gaadaan;</para>
  <para style="q2" vid="PSA 10:9">hiyyeeyye fonxoro ifixxeninni abidenna harkisaan.<verse eid="PSA 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10" />Isa'nee ganeexxi ifi hunda ibilsaan;</para>
  <para style="q2" vid="PSA 10:10">baassaaka afebaaki manninna injifatemee anga isixxe'n ibaan.<verse eid="PSA 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11" />Cubballeessii godobi giddo, «Anee Magen dedhe'een;</para>
  <para style="q2" vid="PSA 10:11">ille buqedhe'een; haranga anee afabaan» hiyyaan.<verse eid="PSA 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12" />Ee Duuchchi Woddike Goottaa qophphi hitte'e ke'i! Magenoo hunnameete anga atixxa ke'issi;</para>
  <para style="q2" vid="PSA 10:12">baassaaka afebaaka manna deettoxxe'e.<verse eid="PSA 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13" />Fuggichchi manni Mageno maaye'e tuffata?</para>
  <para style="q2" vid="PSA 10:13">Mayeete godob giddo «Magen no'oo xixabaan?» hiyyachchi?<verse eid="PSA 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14" />Ee Magenoo, ati kinni rakkateekanna yaadeeka uuddetexxi</para>
  <para style="q2" vid="PSA 10:14">gargaartota'a qophpheeffattaton;</para>
  <para style="q2" vid="PSA 10:14">rakkiyye ate'n irkattaan;</para>
  <para style="q1" vid="PSA 10:14">Atinna annanna ama affebaaxxa oose gargartatton.<verse eid="PSA 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15" />Fuggaaleeyye mannixxanna cubbaaleeyye mannixxa hunna enqi;</para>
  <para style="q2" vid="PSA 10:15">ta'an eliqi'a fuggoxxa assinabaashsha,</para>
  <para style="q2" vid="PSA 10:15">assinnemmaxxe fuggoxxee insa'nee gan.<verse eid="PSA 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16" />Duuchchi Woddiki Gootti duuchchi woddi'a moyanjoke kadee hedhaan;</para>
  <para style="q2" vid="PSA 10:16">wele magenuwwa magenoofataak arduwwi kinni</para>
  <para style="q2" vid="PSA 10:16">buttatenaa'n ba'aan.<verse eid="PSA 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17" />Ee Duuchchi Woddike Goottaa, ati micemeeke mannixxa soodachcho laqatton;</para>
  <para style="q2" vid="PSA 10:17">oodhishsha insa'neexxanna caqassee insa'ne'e jajjabesittatton.<verse eid="PSA 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18" />Buttate'ni hedheek manjiink belti</para>
  <para style="q2" vid="PSA 10:18">ta'aann elqi'a wele miicabaashsha</para>
  <para style="q2" vid="PSA 10:18">ati anna ama afebaakenna miicemeeke manni'a baassittatton.<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="s1">Duuchchi Woddike Gootta'n Addataa</para>
  <para style="d">Faarsaleeyyetike akeekisanji'a Daawwitixxa faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1" />Duuchchi Woddiki Gootti anke gollan;</para>
  <para style="q2" vid="PSA 11:1">hitta anee'e, «Ci'atishsha koobuwwatibaa phirri hite me'i» hitina.<verse eid="PSA 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2" />Cubbaaleeyye Mageniinka manna balleessito'a dukkanna giddo gaadaan;</para>
  <para style="q2" vid="PSA 11:2">Magnika manna shilto'a gabe ifixxa qophpheessexxeen.<verse eid="PSA 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3" />Seerikinna galdumi diigemaa wodda</para>
  <para style="q2" vid="PSA 11:3">Mageniink manji maa assa dande'a?<verse eid="PSA 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4" />Duuchchi Woddiki Gootti dunkaana ifike'ni hedheen;</para>
  <para style="q2" vid="PSA 11:4">moote isixxinna iimate'n hexxeen;</para>
  <para style="q2" vid="PSA 11:4">isi manji hujeexxa duuchcha ege'ne'een;</para>
  <para style="q2" vid="PSA 11:4">ille isixxinna duuchchinga affaan.<verse eid="PSA 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5" />Duuchchi Woddiki Gootti kinni qullichchanna cubbichcha hega uudaan;</para>
  <para style="q2" vid="PSA 11:5">fuggoxxa eeyyaaka kinni jibbaan.<verse eid="PSA 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6" />Isi kinni fuggaaleeyyete'n kashilonna ha'yaaka kinjo gansiisaan;</para>
  <para style="q2" vid="PSA 11:6">gubbaaxxe hobonbaltenninna insa'nee xixaan.<verse eid="PSA 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7" />Duuchchi Woddik Gootti qullichchake kademmaxee eloxxa hujaake eeyyaan;</para>
  <para style="q2" vid="PSA 11:7">eloxxa assaaki duuchchinna isinni welti hedhaan.<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="s1">Gargaarisa Alfatee Shiqqeexxa Soodachcho</para>
  <para style="d">Faarsaleeyyetike akeekisanji'a saddeettessoke meellinni faarsendaaxxa Daawwitixxa faaro</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 12:1" />Ee Duuchchi Woddike Goottaa! Xuurameessi manji gate'eebaan ballo'o no'oo gargaar;</para>
  <para style="q2" vid="PSA 12:1">xuurameessi manni manji giddo gophemeen.<verse eid="PSA 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2" />Duuchchiing weli'aanni wel dhara haaso'a'neen;</para>
  <para style="q2" vid="PSA 12:2">afo'iki kubbinsa'neekinna mitte godobinnitebaan.<verse eid="PSA 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3" />Ee Duuchchi Woddike Goottaa! Dharik kubbisaaka afo'uwwanna</para>
  <para style="q2" vid="PSA 12:3">hollaaka arabuwwa abid.<verse eid="PSA 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4" />Insa'ne, «No'oke Afo'ika galata hendennexxe alfinannon;</para>
  <para style="q2" vid="PSA 12:4">eenneenneshshanna haasonnannon; no'oo hoyyaaki ayyete?» hinaan. <verse eid="PSA 12:4" /><verse number="5" style="v" sid="PSA 12:5" />Duuchchi Woddiki Gootti kinni</para>
  <para style="q2" vid="PSA 12:5">«Rakkiyye miicende'een;</para>
  <para style="q2" vid="PSA 12:5">hiyyeeyye taphatende'een;</para>
  <para style="q2" vid="PSA 12:5">tennexxee ani insa'ne halisneeka nage'a insane'a uwwona'a ke'eennen» hiyye.<verse eid="PSA 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6" />Duuchchi Woddiki Goottik hiyyichchuwwi addatemeeken;</para>
  <para style="q2" vid="PSA 12:6">heddole giirate'ni baqisemeeke biretike sibiljishshanna luqqi hiyyekeeran.<verse eid="PSA 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7" />Ee Duuchchi Woddike Goottaa! Ati no'o heqqi balo'o</para>
  <para style="q2" vid="PSA 12:7">fuggichchake kade'eeke konne barike manninaa'ni no'oo golli.<verse eid="PSA 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8" />Manniinxe oddo'ni fuggoxxa hujaaki ulfataaxxa yanna</para>
  <para style="q2" vid="PSA 12:8">fuggaalleeyye ora ora'n hollati mammarendaan.<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="s1">Gargarsa alfatee Shiqqeexxa Soodachcho</para>
  <para style="d">Faarsaleeyyetike akeekisanji'a Daawwitixxa faaro</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 13:1" />Ee Duuchchi Woddike Goottaa! Haani qico anee deettatto?</para>
  <para style="q2" vid="PSA 13:1">Duuchchi woddi'aatee? Haani qico alba aneenaa'n sho'exxatto?<verse eid="PSA 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 13:2" />Haani qico'nite rakko ossa'ni hedhannok?</para>
  <para style="q2" vid="PSA 13:2">Haani qico'nte qalbet hashsha barra yada'n hedhannok?</para>
  <para style="q2" vid="PSA 13:2">Haani qco'ni naaphi anee gana'ni hedhaa?<verse eid="PSA 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3" />Ee Duuchchi Woddike Gootta anke Magenoo!</para>
  <para style="q2" vid="PSA 13:3">Ballo'o aniba'a wirri hite'e hiissichcho ani'a uwwi;</para>
  <para style="q2" vid="PSA 13:3">oodhishsha anxanna laqqe'e hunna ani'a leb;</para>
  <para style="q2" vid="PSA 13:3">reyotenaa'ninna anee gatisi.<verse eid="PSA 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4" />Naaphi anki «Isoo'o injifante'eennen» hiyye'e ifi saadabaashsha,</para>
  <para style="q2" vid="PSA 13:4">anxe iba'ninna gammadaashsha assittoxxe'e.<verse eid="PSA 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5" />Duuchchi woddixxe atixxe jaalalla'n addate'eennen;</para>
  <para style="q2" vid="PSA 13:5">anjira atixxe'ninna gammada'eennen.<verse eid="PSA 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6" />Ee Duuchchi Woddike Goottaa, ani'a ellolla yaane assitteettexxee</para>
  <para style="q2" vid="PSA 13:6">faarot atee faarsannon.<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="s1">Manji Hujaaxxa Fuggoxxa Huje</para>
  <para style="d">Faarsaleeyyetike akeekisanji'a Daawwitixxa faaro</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 14:1" />Gowwoole godobi giddo «Mageni hedhebaan hitaan;</para>
  <para style="q2" vid="PSA 14:1">iitta hedheek manni woyi fulaakerabaan;</para>
  <para style="q2" vid="PSA 14:1">gammachchissabaaxxa yaanerranna assaan;</para>
  <para style="q2" vid="PSA 14:1">insa'ne giddi'n mittikinna eloxxa assaak hedheebaan.<verse eid="PSA 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2" />Duuchchi Woddiki Gootti isoo'o halsa'neeki beek manji hedheexxa uudo'a</para>
  <para style="q2" vid="PSA 14:2">iimatenaa'n butti'a manjiinka belto uude.<verse eid="PSA 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3" />Yaane kinni manji duuchchi orakenaa'n gore'eemman;</para>
  <para style="q2" vid="PSA 14:3">duuchching mittenba bushe'eemman;</para>
  <para style="q2" vid="PSA 14:3">insa'ne giddii'n mittikinna eloxxa assaammak hedhebaan.<note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="ROM 3:10-12">Rom. 3:10-12</ref>. </char></note><verse eid="PSA 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4" />Fuggoxxa hunja'n mittechchonna egenebaan hiyyatee? Budeena</para>
  <para style="q2" vid="PSA 14:4">indammashsha arda anka itaakiir,</para>
  <para style="q2" vid="PSA 14:4">insa'ne anee'e Duuchchi Woddike Goottiba'a soodantabaan» hiyyane'een.<verse eid="PSA 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5" />Mageni isi'a ajajeememmake mannin welti hedhemmaxxee</para>
  <para style="q2" vid="PSA 14:5">fuggoxxa assamaki ookko hedhdhemambaa allayik culiphphisaan.<verse eid="PSA 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6" />Ha'no kinni hiyyeeyye mannika yaada guguffachchiisinoolenna midde</para>
  <para style="q2" vid="PSA 14:6">Duuchchi Woddiki Gootti insa'neeke golla kadaan.<verse eid="PSA 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7" />Isira'eelii'i anjiraak Tsiyoonii'n dageele!</para>
  <para style="q2" vid="PSA 14:7">Duuchchi Woddiki Gootti ardiinxa booji'o hiissaxxa yanna</para>
  <para style="q2" vid="PSA 14:7">Ya'iqoobixxi horte gammaddamman;</para>
  <para style="q2" vid="PSA 14:7">Isira'eelik ardinna illillisamman.<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="d">Daawwitixxa Faaro</para>
  <para style="s1">Mageni Manjokenaa'n Hassaaxxa Yanne</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 15:1" />Ee Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 15:1">atike duunkaan giddo dande'e hedhaak ayyete?</para>
  <para style="q2" vid="PSA 15:1">Atixxe woyyitte kooba hana hedha dande'aak ayyete?<verse eid="PSA 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2" />Ci'mendaaxxa hedho hedhabaakinna dhugaa calla hujaak;</para>
  <para style="q2" vid="PSA 15:2">arabi ifikenni dhugaa calla haaso'aak;<verse eid="PSA 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3" />Wele manna hamatabaak;</para>
  <para style="q2" vid="PSA 15:3">jaaluwwa ifike'n fuggoxxa assabaak;</para>
  <para style="q2" vid="PSA 15:3">olla'iinke mannika summa balleessabaak;<verse eid="PSA 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4" />Mageno eeyyabaaka manna tuffataak;</para>
  <para style="q2" vid="PSA 15:4">Duuchchi Woddike Gootti'a ajajemaakaara kinni ulfeesaak;</para>
  <para style="q2" vid="PSA 15:4">a'urteexxenna kaddoole werreegemmaka werreega muuxaak;<verse eid="PSA 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5" />Malaqa ifika dhalakee'e liqessabaak;</para>
  <para style="q2" vid="PSA 15:5">balleessa afebaaka manna miidhatee matta adhdhabaak;</para>
  <para style="q1" vid="PSA 15:5">Tennee yaanuwwa assaak manji</para>
  <para style="q2" vid="PSA 15:5">nage'ik hedha malee'e haranga le'mabaan.<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="d">Daawwitika Meela</para>
  <para style="s1">Mageno Addatatixxa Soodachcho</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1" />Ee Magenoo!</para>
  <para style="q2" vid="PSA 16:1">Ani atee addatennaxxee anee heqqi.<verse eid="PSA 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2" />Ee Duuchchi Woddike Goottaa, «Ati anke dada Duuchchike Goottaan;</para>
  <para style="q2" vid="PSA 16:2">ani afennexxi elolla yaane duuchcha</para>
  <para style="q2" vid="PSA 16:2">ati ani'a uuttettexxe uwwan» hiyyenne.<verse eid="PSA 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3" />Buttate'n hedheek woyyichchi manni</para>
  <para style="q2" vid="PSA 16:3">ulfate'eeken; aninna insa'ne'n gammadannon.<verse eid="PSA 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4" />Wele magenuwwa magenoofataakaara lummoxxe rakko geltaan;</para>
  <para style="q2" vid="PSA 16:4">iitta hedheeke magenuwwi'a hore tolche'e munde shiqishabe'non;</para>
  <para style="q2" vid="PSA 16:4">konne magenuwwanna magenoofatabe'non.<verse eid="PSA 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5" />Ee Duuchchi Woddike Goottaa! Ati anke qoobbon;</para>
  <para style="q2" vid="PSA 16:5">hassissaxxa duuchchanna ani'a uuttatton;</para>
  <para style="q2" vid="PSA 16:5">muuxami ankinna anga atixxi giddo hedheen.<verse eid="PSA 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6" />Ani'a uuttotta'a mikkeettexxi yaanuwwa ellollaten;</para>
  <para style="q2" vid="PSA 16:6">eeti, anee gammachchiisaake qoobbo afe'eennen.<verse eid="PSA 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7" />Ani'a gorsa uwweeka Duuchchi Woddika Gootta galateefataannen;</para>
  <para style="q2" vid="PSA 16:7">hashshanna midde anxi sammo me'annoka eloka ora akkeekaan.<verse eid="PSA 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8" />Duuchchi wodda, Duuchchi Woddika Gootta ifi edo uggudheennen;</para>
  <para style="q2" vid="PSA 16:8">Isinna ani bira hedhemmaxxee anee sodachchiisaachchi hedhebaan.<verse eid="PSA 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9" />Tennexxee gammada'nee galateeffataannen;</para>
  <para style="q2" vid="PSA 16:9">ruphphi hiyya gate'naanna ti'ni hiyyee hedhannon.<verse eid="PSA 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10" />Lubbo anxa reyemmaki manni hedhemmaba waaldabexxon;</para>
  <para style="q2" vid="PSA 16:10">atika woyyichchanna<note caller="+" style="f"><char style="fr" closed="false">16:10 </char><char style="ft" closed="false">yookaan</char><char style="fqa" closed="false">Ate'n addateeka</char></note> alo'a iso'n geltaashsha assitabexxon.<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="ACT 13:35">Erga. Huj. 13:35</ref>. </char></note><verse eid="PSA 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11" />Hedhotika oranna ane'ni leellishshatton;</para>
  <para style="q2" vid="PSA 16:11">aninninni welti hexxe'e gammachiissatton;</para>
  <para style="q2" vid="PSA 16:11">atike midda'ninna duuchchi woddi'a hafuura adhdhate hexxeen.<note caller="-" style="x"><char style="xo" closed="false">16:11 </char><char style="xt" closed="false"><ref loc="ACT 2:25-28">Erga. Huj. 2:25-28</ref>. </char></note><verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="p">
    <verse number="1" style="v" sid="PSA 17:1" />Ee Duuchchi Woddike Goottaa! Dhugaatixxa murte ani'a murtotta'a soodataannexxa</para>
  <para style="q2" vid="PSA 17:1">soodachcho laqi; oodhishsha anxanna caqasi;</para>
  <para style="q2" vid="PSA 17:1">dharkite kaddebaak dhugaati atee soodataannexxa soodachcho laqi.<verse eid="PSA 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2" />Ille atixxi dhugaa uuddammaxxee</para>
  <para style="q2" vid="PSA 17:2">murte uute'e anee qullo fulchi.<verse eid="PSA 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3" />Hashshati towwate anee uuddetele,</para>
  <para style="q2" vid="PSA 17:3">mitte dedhanna anenaa'n affabexxon;</para>
  <para style="q2" vid="PSA 17:3">fuggoxxi anke afo'onaa'ninna fuldebaan.<verse eid="PSA 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4" />Manjiinxe hujenaa'n, atike hiyyichchcishshanni</para>
  <para style="q2" vid="PSA 17:4">fuggaalleeyyetixxe me'anaa'n ifi heqedheennen.<verse eid="PSA 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5" />Ani duuchchi wodda ati akkeekketeba'a me'eenne;</para>
  <para style="q2" vid="PSA 17:5">atike orinaa'n lekka anxa goshebe'no.<verse eid="PSA 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6" />Ee Magenoo! Sooddachcho anxa laqqaattaxxee atee sooddataannen;</para>
  <para style="q2" vid="PSA 17:6">ani biri'a shiqqe'e</para>
  <para style="q2" vid="PSA 17:6">hiyyichcho anka laqi.<verse eid="PSA 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7" />Naaphakee'e atee gollake assedheekaara</para>
  <para style="q2" vid="PSA 17:7">atixxe middixxe anganni anjirtattokee Magenoo!</para>
  <para style="q2" vid="PSA 17:7">Atixxa duuchchi woddixxa jaalala mambe'ik leellishi.<verse eid="PSA 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8" />Illeti gummichchi heqqemaammashsha anee heqqi;</para>
  <para style="q2" vid="PSA 17:8">boba atixxe'ni anee sho'i.<verse eid="PSA 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9" />Anee buqe'e lole shiyo'a hasa'neeke</para>
  <para style="q2" vid="PSA 17:9">godoba jabake anke naaphanaa'n anee heqqi.<verse eid="PSA 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10" />Insa'ne maraarte anfeekebaan;</para>
  <para style="q2" vid="PSA 17:10">hollatinna haasonnaan.<verse eid="PSA 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11" />Shorrine anee bunqeexxi</para>
  <para style="q2" vid="PSA 17:11">butta anee harkinso'a illeti anee gaande.<verse eid="PSA 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12" />Insa'ne'e buteexxi adho'a halchamake nenqishsha,</para>
  <para style="q2" vid="PSA 17:12">yookaan sho'onde'e gaaddammaxxe neenqiinxe beltannashshaten.<verse eid="PSA 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13" />Ee Duuchchi Woddike Goottaa! Daggettexxi insa'nee loli;</para>
  <para style="q2" vid="PSA 17:13">atike wolantichchininna fuggaaleeyyetenaa'n anee anjir.<verse eid="PSA 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14" />Ee Duuchchi Woddike Goottaa! Insa'nexxi halcha tennee buttaxxe hedho calla</para>
  <para style="q2" vid="PSA 17:14">kade'eeke manninaa'n anee anjir;</para>
  <para style="q1" vid="PSA 17:14">Eettattoke manni'a itaachcho uwwi;</para>
  <para style="q2" vid="PSA 17:14">insa'nexxi oosenna geltaaxxa ita affowwaal;</para>
  <para style="q2" vid="PSA 17:14">insa'nexxe oosexxi oosenna gelte gattaaxxa ita affaashsha assi,<verse eid="PSA 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15" />Ani kinni qullummati alba atika uudannon;</para>
  <para style="q2" vid="PSA 17:15">dammaqanno woddanna atika ulfinna uudee'e gammadannon.<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="s1">Daawitixxa Injiffachchotixxa Faaro</para>
  <para style="d">Faarsaleeyyetie soorreesi'a, Duuchchi Woddike Goottika garbichcho Daawwitixxa faaro; tininna Duuchchi Woddik Gootti isoo Sa'oolinaa'ninna isike naaphi duuchchinaa'n anjiree wodda isi Duuchchi Woddika Gootta hiyya'n faarsee qici:</para>
  <para style="r">(<ref loc="2SA 22:1-51">2 Sam. 22:1-51</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1" />Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 18:1">Anxa hunna atee eeyyaannen.<verse eid="PSA 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2" />Duuchchi Woddik Goottii anxe rassa, anxe kollonna anke anjirallon;</para>
  <para style="q2" vid="PSA 18:2">Mageni itti gollatannoxxee anxe rassan;</para>
  <para style="q2" vid="PSA 18:2">isi anxe wontenna anxe anjirematixxe barraxxe, jabaxxe wolo'on.<verse eid="PSA 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3" />Galati hasisaaka Duuchchi Woddika Gootta ye'edha'ennen;</para>
  <para style="q2" vid="PSA 18:3">isinna naapha ankenaa'n anee anjiraan.<verse eid="PSA 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4" />Reyotixx ciniinito anee suruute;</para>
  <para style="q2" vid="PSA 18:4">ba'netinna lola'iinsha anee buqqe.<verse eid="PSA 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5" />Hirreesiinxi wodaronna ane'n mirqende;</para>
  <para style="q2" vid="PSA 18:5">reyotixxe fonxoronna anee abidde.<verse eid="PSA 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6" />Rakkatenne wodda Duuchchi Wooddika Gootta ye'edhenne;</para>
  <para style="q2" vid="PSA 18:6">anee gargaarashshanna Mageno sooddatenne;</para>
  <para style="q2" vid="PSA 18:6">isinna ifike galmi giddo hedheexxi haaso'a anka laqe;</para>
  <para style="q2" vid="PSA 18:6">oodhishsha anxanna caqase.<verse eid="PSA 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7" />Magen mufatemmaxxee butta sheke sheke hite le'mite;</para>
  <para style="q2" vid="PSA 18:7">koobuwwa offoldeemmaxxi boosuwwanna giri giri hite.<verse eid="PSA 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8" />Aaretixxi wiliilee isixxe sanonaa'n fulde;</para>
  <para style="q2" vid="PSA 18:8">gubaak giiratik buubenjinna</para>
  <para style="q2" vid="PSA 18:8">holataak kashil isike afo'onaa'n fule.<verse eid="PSA 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9" />Iimuwwa benqi asseexxi butti'a dirre;</para>
  <para style="q2" vid="PSA 18:9">lekka isixxi hundanna xiledhe'e raachcho'eek duummanchi hedheemman.<verse eid="PSA 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10" />Kiruubeelii gulufeexxi phirri hiyye;</para>
  <para style="q2" vid="PSA 18:10">diiddalotike keeli hana hedheexxi shuwwi hiyye.<verse eid="PSA 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11" />Dukkana odho'we;</para>
  <para style="q2" vid="PSA 18:11">raachcho'eeki, xeeniink duummanchi isoo buqe.<verse eid="PSA 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12" />Isi edo wa'a hiyyeeke ifanaa'n kexxeexxa</para>
  <para style="q2" vid="PSA 18:12">raachcho'eek duummanchi,</para>
  <para style="q2" vid="PSA 18:12">kaadenna giiratik xallaqqinni fule.<verse eid="PSA 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13" />Duuchchi Woddiki Gootti iimatenaa'n dindime;</para>
  <para style="q2" vid="PSA 18:13">Dada Duuchchik Duuchchi Woddik Gootti haaso'a ifikanna laqise.<verse eid="PSA 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14" />Mogido ifika darbeexxi naaphakanna xexeere;</para>
  <para style="q2" vid="PSA 18:14">banqotike balaqinninna insa'nee shorre.<verse eid="PSA 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15" />Ee Duuchchi Woddike Gottaa! Naapha atika xixxete wodda</para>
  <para style="q2" vid="PSA 18:15">mufate insa'ne'n dindindette wodda lumoxxa abbayya buqqeemmak buttinni leelle;</para>
  <para style="q2" vid="PSA 18:15">buttatixxi boosonna ce'e hitte gatte.<verse eid="PSA 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16" />Duuchchi Woddik Gootti iimatenaa'n anga diriirseexxi anee abide;</para>
  <para style="q2" vid="PSA 18:16">dhi'mo wode'enaa'ninna anee harkise fulche.<verse eid="PSA 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17" />Ane'n ke'emmake, jabake naaphanaa'ninna anee gibammake manni duuchchixxe</para>
  <para style="q2" vid="PSA 18:17">anganaa'n anee gatise.<verse eid="PSA 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18" />Rakkote'n hedhennaxxa yanna ane'n ke'ne lolle;</para>
  <para style="q2" vid="PSA 18:18">Duuchchi Woddik Gootti kinni anke kipha kade.<verse eid="PSA 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19" />Qarrakenaa'n ba'labaa'a anee fulche;</para>
  <para style="q2" vid="PSA 18:19">anee eeyyemmaxxee anee anjire.<verse eid="PSA 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20" />Duuchchi Woddik Gootti anxe qullummashshanni ani'a hira uwwe'een;</para>
  <para style="q2" vid="PSA 18:20">elloxxa assenneshshanni ani'a eloxxa asse'een.<verse eid="PSA 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21" />Duuchchi Woddika Gootta ajajemee'e ora isike'n me'eennen;</para>
  <para style="q2" vid="PSA 18:21">anke Mageninaa'n udumi'a higennexxi fuggoxxa assebe'non.<verse eid="PSA 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22" />Mageniinka seera duuchcha muuxeennen;</para>
  <para style="q2" vid="PSA 18:22">ajaaja isikanna gibebe'non.<verse eid="PSA 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23" />Ani isi edo balleessa belo hedheennan;</para>
  <para style="q2" vid="PSA 18:23">cubbo hujabe'noshshanna ifi heqedhe'eennen.<verse eid="PSA 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24" />Duuchchi Woddik Gootti qullumma anxishshanni,</para>
  <para style="q2" vid="PSA 18:24">ille isixxi edonna eloxxa assenneshshanni hira ani'a uwween.<verse eid="PSA 18:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25" />Duuchchi Woddike Gottaa! Atee addataakee'e atinna addatende'eeteken;</para>
  <para style="q2" vid="PSA 18:25">fuggoxxenaa'n bayyataakeenna ati eloken.<verse eid="PSA 18:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26" />Ca'ichchakee'e ati ca'ichcaken;</para>
  <para style="q2" vid="PSA 18:26">jallaammeyyetee kinni insa'neexxe jalloshshanni hira insa'ne'a uuttatton.<verse eid="PSA 18:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27" />Ati shaqqaka manna anjirtatton;</para>
  <para style="q2" vid="PSA 18:27">ifi sadaaka manna kinni salphissatton.<verse eid="PSA 18:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28" />Ee Duuchchi Woddike Goottaa! Ani'a ati anke ifan;</para>
  <para style="q2" vid="PSA 18:28">ee anke Magenoo, dukkana anxa ati ifissatton.<verse eid="PSA 18:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29" />Atike gargaarsinni, loliinka sannachcha miidhanno;</para>
  <para style="q2" vid="PSA 18:29">ank Mageni ati, dalla'a utaale sa'annoshsha assittatto.<verse eid="PSA 18:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30" />Mageniink or dedha afeekebaan;</para>
  <para style="q2" vid="PSA 18:30">Duuchchi Woddike Goottik hiyyichchi luqqichchaken;</para>
  <para style="q2" vid="PSA 18:30">isoo irko assedheeke duuchchi'a is wonteten.<verse eid="PSA 18:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31" />Duuchchi Woddika Gootta malee'e ayyete Mageni?</para>
  <para style="q2" vid="PSA 18:31">Isoo malee irkote kadaak ayyete?<verse eid="PSA 18:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32" />Hunna ani'a uwweexxi ora ankanna qajeelchaak</para>
  <para style="q2" vid="PSA 18:32">Magenoken.<verse eid="PSA 18:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33" />Isi lekka anxa gophphabaaxxe buddannetixxe lekkashsha assaan;</para>
  <para style="q2" vid="PSA 18:33">qephphpichcha bonchuwwa'ninna mitte ruphphi belo uurrannoshsha assaan.<verse eid="PSA 18:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34" />Hitta lolannoxxa isi, anee barachchiisaan;</para>
  <para style="q2" vid="PSA 18:34">sageettoti sibljixxa gabenna darbannoka uuduuda ani'a uwwaan.<verse eid="PSA 18:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35" />Atixxa anjiratixxa wonte ani'a uuttette;</para>
  <para style="q2" vid="PSA 18:35">atixxe middixxi anganna anee kiphphe abidde;</para>
  <para style="q2" vid="PSA 18:35">anee gargaartottaa dagge'e anee lummissette.<verse eid="PSA 18:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36" />Ora ani'a ba'liseten;</para>
  <para style="q2" vid="PSA 18:36">anxi lekkanna xaldebaan.<verse eid="PSA 18:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37" />Naapha anka gussee abidannon;</para>
  <para style="q2" vid="PSA 18:37">insa'nee mundaa qici'anna uudumi'a higebe'no.<verse eid="PSA 18:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38" />Dandaammantabaa qico'n insa'nee ganeennen;</para>
  <para style="q2" vid="PSA 18:38">insa'neenna anxe lekka hunda imbe.<verse eid="PSA 18:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39" />Lolakee ani'a hunna uuttette;</para>
  <para style="q2" vid="PSA 18:39">anki naaphinna injifatemaashsha assittette.<verse eid="PSA 18:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40" />Anki naaphi udumi'a hige baajaashsha assittetten;</para>
  <para style="q2" vid="PSA 18:40">anee gibamaka duuchchanna birtette.<verse eid="PSA 18:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41" />Gargaaraaka alfatee raarreen, kinni alfineba'a;</para>
  <para style="q2" vid="PSA 18:41">Duuchchi Woddika Goottanna ye'e'neen, isinna hiissichcho insa'ne'a uwweba'a.<verse eid="PSA 18:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42" />Diiddallo adhdhite me'itammaxxe bukkoshsha insa'nee bulleessenne;</para>
  <para style="q2" vid="PSA 18:42">or giddixxe dhoqqeshshanna insa'nee hirbeessennen.<verse eid="PSA 18:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43" />Jallichcha ardanaa'n anee anjirtette;</para>
  <para style="q2" vid="PSA 18:43">gosa gosaka ardike umo anee assittette;</para>
  <para style="q2" vid="PSA 18:43">ege'nebe'noki ardinna ani'a hireme.<verse eid="PSA 18:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44" />Ajaaja anka lanqeeshshanni ani'a ajaajjemaan;</para>
  <para style="q2" vid="PSA 18:44">alagikinna ani'a heeshshi qokki hiyyeen;<verse eid="PSA 18:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45" />Alagi alayye culphise;</para>
  <para style="q2" vid="PSA 18:45">insa'nenna roqonsinna'n kollifanteebaa'n fulle.<verse eid="PSA 18:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46" />Duuchchi Woddik Gootti hedheeken!</para>
  <para style="q2" vid="PSA 18:46">Golli anki isi ulfaatowwaal!</para>
  <para style="q2" vid="PSA 18:46">Anee anjirek Mageni lummedhowwaal.<verse eid="PSA 18:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47" />Isi naapha anke'n halo ani'a fulaake,</para>
  <para style="q2" vid="PSA 18:47">gosa gosak ardinna ani'a hiremaashsha assaake Magenon.<verse eid="PSA 18:47" /></para>
  <para style="q2">
    <verse number="48" style="v" sid="PSA 18:48" />Anke naaphanaa'ninna anee anjiraak isoten.</para>
  <para style="q2" vid="PSA 18:48">Ati anke naaphi hana anee lummissetten;</para>
  <para style="q2" vid="PSA 18:48">manjo midhaake mannanaa'n anee anjirtette.<verse eid="PSA 18:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49" />Ee Duuchchi Woddike Goottaa! Tennexxee gosa gosake ardi giddo atee galateefataannon;</para>
  <para style="q2" vid="PSA 18:49">atika summanna faaroti farsaannen.<note caller="-" style="x"><char style="xo" closed="false">18:49 </char><char style="xt" closed="false"><ref loc="ROM 15:9">Rom. 15:9</ref>. </char></note><verse eid="PSA 18:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50" />Moyaashsha assemmak moyanji injiffata'ni hedhaashsha assaan;</para>
  <para style="q2" vid="PSA 18:50">ifixxa duuchchi woddixxa jaalalanna hariireemmake ookkone'a,</para>
  <para style="q2" vid="PSA 18:50">Daawwiti'aanna, isixxe horte duuchchi'a, duuchchi woddi'a leellishaan.<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="s1">Dada Duuchcha Mageniinka Ulfinna Leellishshaan</para>
  <para style="d">Faarsaaleeyyetike Sooressi'a Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1" />Iimuwwa Mageniinka ulfinna leellishshaan;</para>
  <para style="q2" vid="PSA 19:1">dhisendeexxi iimanna isixxe angaxxa huje haassottaan.<verse eid="PSA 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2" />Mitte barra mittete'n tenneddee haassottaan;</para>
  <para style="q2" vid="PSA 19:2">mitte hashshanna wele hashsha'n tennende lebbaan.<verse eid="PSA 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3" />Kunnichchuwwi haaso'ee hiyyachchi hedheba'a;</para>
  <para style="q2" vid="PSA 19:3">hafuurikinna laqisaba'a;<verse eid="PSA 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4" />Yaane kinni erga konnechchuwwixxi butta duuchcha'n dhaqqabbaan;</para>
  <para style="q2" vid="PSA 19:4">buttatixxe gabala qico'ninna hiyyichchuwwi konneechchuwwik geyaan;</para>
  <para style="q1" vid="PSA 19:4">Mageni arishsho galdaba iima giise'een.<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="ROM 10:18">Rom. 10:18</ref>. </char></note><verse eid="PSA 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5" />Wajubbichcho dukko giddii'n fulammakishsha arishsho wa'aa hite fuldaan;</para>
  <para style="q2" vid="PSA 19:5">gongammaki hokkoketee'e gammadammashsha gammaddaan.<verse eid="PSA 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6" />Ise mitte darrexxe iimatixxe gabalanaa'n fuldeexxi wele darrexxe gabalaba'aa me'itaan;</para>
  <para style="q2" vid="PSA 19:6">isike eebbinjixxe hunnanaa'n dande'eexxi sho'omaachchi hedhebaan.<verse eid="PSA 19:6" /></para>
  <para style="s1">Duuchchi Woddike Goottika Seera</para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7" />Duuchchi Woddike Goottiki seeri dedha afeekebaan;</para>
  <para style="q2" vid="PSA 19:7">lubbo manjiinxe'e hedhote uuwwaan;</para>
  <para style="q2" vid="PSA 19:7">Duuchchi Woddike Gottik ajaji addatemeeken;</para>
  <para style="q2" vid="PSA 19:7">ege'na afebaake manni'a beekuma uuwwaan.<verse eid="PSA 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8" />Duuchchi Woddike Goottiki seeri dhugaaten;</para>
  <para style="q2" vid="PSA 19:8">qalbetee gammashshote uuwwaan;</para>
  <para style="q1" vid="PSA 19:8">Duuchchi Woddike Goottiki ajaji wa'aa hiyyeeken;</para>
  <para style="q2" vid="PSA 19:8">ille affashsha assaan.<verse eid="PSA 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9" />Duuchchi Woddika Gootta sodaata duuchchi woddi'a hexxaaxxe ca'umman. Duuchchi</para>
  <para style="q2" vid="PSA 19:9">Woddike Goottixxi murte duuchchi wodda dhugatenna qulummatiten.<verse eid="PSA 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10" />Iittann ca'ite worqe caala hira affe'eexxen;</para>
  <para style="q2" vid="PSA 19:10">malebiinxe la'e irra xe'maxxen.<verse eid="PSA 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11" />Ardake'n murte uuttettek oruwwi ani'a barachcho uwween;</para>
  <para style="q2" vid="PSA 19:11">garbichchi atik aninna ati hittettexxa ajajemennen.<verse eid="PSA 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12" />Ayyinna ifixxa balleessa uudaaki hedhebaan; Ee, Duuchchi woddike Gootta!</para>
  <para style="q2" vid="PSA 19:12">Sho'ondeexxa balleessa anxa gattowwal hiyyi.<verse eid="PSA 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13" />Ege'na'n cubbo hujatenaa'n anee heqqi;</para>
  <para style="q2" vid="PSA 19:13">ookkone wodda tennee labbaaxxa fuggoxxa balleessa hujebe'noke qullichcha manjo kadannon.<verse eid="PSA 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14" />Anke gollanna anke anjirallo Ee, Duuchchi Woddike Goottaa! Anke afo'ik haaso'inna anxe qalbeki yaadi atee gammachchiisake kadowwaal.<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="s1">Injiffachchotee Shiqqeexxa Soodachcho</para>
  <para style="d">Faarsaalleeyyetike Sooressi'a Daawwitixxa Faaro</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 20:1" />Duuchchi Woddiki Gootti rakkotixxa barra soodachcho atixxa laqowwaal! Ya'iqoobiki</para>
  <para style="q2" vid="PSA 20:1">Mageninna summa ifikenni atee heqqowwaal!<verse eid="PSA 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2" />Galma isike Tsiyoonixxe koobanaa'n dageexxi</para>
  <para style="q2" vid="PSA 20:2">atee gargaarowwaal. <verse eid="PSA 20:2" /><verse number="3" style="v" sid="PSA 20:3" />Isi'aa uuttettexxa uwwa duuchchanna dedhoqqe'e; ciinceesiteteke ciiniccatike tolcha'ni</para>
  <para style="q2" vid="PSA 20:3">gammadowwaal.<verse eid="PSA 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4" />Qalbeti heddattoxxa duuchcha ati'a uuwwowwaal;</para>
  <para style="q2" vid="PSA 20:4">heduma atika duuchanna ati'a muuxowwaal.<verse eid="PSA 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5" />Injiffattettaxxee ilili hina'eennen;</para>
  <para style="q2" vid="PSA 20:5">no'oka Magenonna farisina'n galatiinxa jila jillannon.</para>
  <para style="q2" vid="PSA 20:5">Duuchchi Woddik Gootti soodattettexxa duuchcha ati'a muuxowwaal.<verse eid="PSA 20:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6" />Duuchchi Woddik Gootti hariire moyaashsha asseeka gargaaraaxxa ta'a ane'ni aagge;</para>
  <para style="q2" vid="PSA 20:6">woyyichcha iimike ifike galma'n hedhe'e sooddachcho laqeexxi injiffato'a isi'a hunna</para>
  <para style="q2" vid="PSA 20:6">lummoxxa uwwaan.<verse eid="PSA 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7" />Mitti mitti ifixxe gaare'ni adata;</para>
  <para style="q2" vid="PSA 20:7">no'o kinni Duuchchi Woddike Gootta no'oke Magenixxe hunna'ni addantannon.<verse eid="PSA 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8" />Inssa'ne guggufantee inbaan;</para>
  <para style="q2" vid="PSA 20:8">no'o kinni qophphi hine ke'nee jabante uurrinnannon.<verse eid="PSA 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9" />Duuchchi Woddike Goottaa! Moyanjo naaphiinxe anganaa'ni gatisi;</para>
  <para style="q2" vid="PSA 20:9">no'onna atee soodantanno wodda hee hite'e laqi.<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="s1">Injiffachchootixxee Shiqeeka Galata</para>
  <para style="d">Faarsaleeyyetike Sooressi'a Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1" />Ee, Duuchchi Woddik Goottaa moyanji hunna atixxe'ni gammade'een;</para>
  <para style="q2" vid="PSA 21:1">naapha ifika injiffatashsha assittettaxxeenna illillisa'neen.<verse eid="PSA 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2" />Godobik hedeexxa duuchchiinxa isi'a uuttetten;</para>
  <para style="q2" vid="PSA 21:2">atee soodateexxanna hoyyexxeebexxon.<verse eid="PSA 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3" />Isoo ora qophexxe'e lumoxxe eebbanni isibaa daggeten;</para>
  <para style="q2" vid="PSA 21:3">eloxxe worqeka kallachchanna isike umi hana uggittette.<verse eid="PSA 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4" />Hedho isi'a uuttottaa atee soodate;</para>
  <para style="q2" vid="PSA 21:4">atinna qeeraka baro duuchchi woddi'a isi'a uuttetten.<verse eid="PSA 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5" />Ati isi'a uuttettexxe injiffachchonaa'n kexxeexxa gura fule;</para>
  <para style="q2" vid="PSA 21:5">ulfaate gaachchakanna alfe.<verse eid="PSA 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6" />Ati isi'a duuchchi woddixxa eebba uuttetten;</para>
  <para style="q2" vid="PSA 21:6">atixxi isinni welti hedhanna isoo gammachchiisseen.<verse eid="PSA 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7" />Duuchchi Woddike Gootta'n addate'een;</para>
  <para style="q2" vid="PSA 21:7">Dada Duuchchik duuchchi woddik Gootti isoo eeyyeemmaxxee lele'mabaan.<verse eid="PSA 21:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8" />Hirre atixxenni diinna atika duuchchiinga gandatton;</para>
  <para style="q2" vid="PSA 21:8">atee jibbaaka middixxe atixxe anganninna abiddatton.<verse eid="PSA 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9" />Daggatoxxa yanna giira boosixxishsha insa'nee gubbaton;</para>
  <para style="q1" vid="PSA 21:9">Duuchchi Woddik Gootti mufe ifixxenni insanee balleessaan;</para>
  <para style="q2" vid="PSA 21:9">giiratinna insanee ittaan.<verse eid="PSA 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10" />Ila ila insa'neexxa buttatenaa'ni balleessittaton;</para>
  <para style="q2" vid="PSA 21:10">sanne insa'neexxanna manjiinxe sanne giddii'n balleessittaton.<verse eid="PSA 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11" />Ate'n fuggoxxa assatee'e hendeexxi</para>
  <para style="q2" vid="PSA 21:11">mari'antoolenna haranga insane'a qajeeldabaan.<verse eid="PSA 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12" />Gabe atixxanna insa'ne'ni darbittaton;</para>
  <para style="q2" vid="PSA 21:12">udumi'aanna hinge'e baanjaashsh assittaton.<verse eid="PSA 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13" />Ee, Duuchchi Woddike Goottaa! Jabeenna atikee'e lummedhi!</para>
  <para style="q2" vid="PSA 21:13">Lumoxxe hunna atixxee faaroti atee galateeffanta'eennen.<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="s1">Yaaddotixxa Oodhishshanna Galatiinxa Faaro</para>
  <para style="d">Faarsaleeyyetik Sooressi'a, «Boro haachchaabba wodda gadansiinke» hiyyemeeke meelinni Faarsendeexxa Daawwitixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 22:1" />Anke Magenoo! Anke Magenoo! Mayee ane'e waaldette?</para>
  <para style="q2" vid="PSA 22:1">Anee anjirtabexxoshsha mayee anenaa'n bayyattette?</para>
  <para style="q2" vid="PSA 22:1">Mayeete fooxxi hiyya anxa midde laqqabexxo qico'ni bayyatteettek?<verse eid="PSA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2" />Anke Magenoo barra ate'ni oodhennen, ati kinni laqqeebexxon;</para>
  <para style="q2" vid="PSA 22:2">hashshanna atee ye'edhennen sammi hiyyenne woddinna hedhebaan.<verse eid="PSA 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3" />Kaddo malee ati woyyichcha Magenon.</para>
  <para style="q2" vid="PSA 22:3">Isira'eelike ardik galati atixxa moote buqaan.<verse eid="PSA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4" />Edik no'ok annuwwi atee addateen;</para>
  <para style="q2" vid="PSA 22:4">atee addateemmaxxeenna atinna insanee fulchitteten.<verse eid="PSA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5" />Gargaarsake ate'ni oo'nee wodda dhaqqabbeten;</para>
  <para style="q2" vid="PSA 22:5">insa'ne ate'ni addantee woddanna shonkeemmabaan.<verse eid="PSA 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6" />Ani kinni corroqati jala hedhenneke manjon;</para>
  <para style="q2" vid="PSA 22:6">manji ane'ni geeba'neen; ardake'ninna tuffateme'eenneken.<verse eid="PSA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7" />Uudeeki duuchchi ane'n qacifateen;</para>
  <para style="q2" vid="PSA 22:7">alba ifikanna ane'ni guduunfeexxi umo ifika le'misa'n anee hiyyaa qici:<note caller="-" style="x"><char style="xo" closed="false">22:7 </char><char style="xt" closed="false"><ref loc="MAT 27:39">Mat. 27:39</ref>; <ref loc="MRK 15:29">Mar. 15:29</ref>; <ref loc="LUK 23:55">Luq. 23:55</ref>. </char></note><verse eid="PSA 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8" />«Duuchchi Woddike Gootta'ni addate'een isi isoo gatisowwaalta.</para>
  <para style="q1" vid="PSA 22:8">Isoo eeyyammaxxee isi isoo fulchowwaalta!» hinaan.<note caller="-" style="x"><char style="xo" closed="false">22:8 </char><char style="xt" closed="false"><ref loc="MAT 27:43">Mat. 27:43</ref>. </char></note><verse eid="PSA 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9" />Atendeemman ani nage'ik ilemannoshsha assite'eetak;</para>
  <para style="q2" vid="PSA 22:9">unu'naannaxxa yannanna anee heqqiteetaak atenden.<verse eid="PSA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10" />Ama anxike godoba'ninna anee heqqiteteki ateten;</para>
  <para style="q2" vid="PSA 22:10">anxe ilenshaxxe barranaa'n ati, anke Magenon.<verse eid="PSA 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11" />Rakko ane'ni daggo'a shiqqeemmaxxeenna anee gargaaraak hedha gopheemmaxxee</para>
  <para style="q2" vid="PSA 22:11">ani birii'ni bayyattoxxe'e.<verse eid="PSA 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12" />Heddi naaphi ittaaxxe korommeshsha anee buqeen;</para>
  <para style="q2" vid="PSA 22:12">hunnaammette Baasake bogixxe korommoolshanna</para>
  <para style="q2" vid="PSA 22:12">anke qarqara'n hedheen. <verse eid="PSA 22:12" /><verse number="13" style="v" sid="PSA 22:13" />Bulte adhdhamakenna itanammake neenqishsha</para>
  <para style="q2" vid="PSA 22:13">anki naaphi afo'ao ane'n haanni asse.<verse eid="PSA 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14" />Hunna gophee'e duneme wode'eeke kadeennen;</para>
  <para style="q2" vid="PSA 22:14">micci anki duuchchi mikita mikitanaa'n lo'o hiyye;</para>
  <para style="q2" vid="PSA 22:14">godobi ankinna gagatishsha baqqe.<verse eid="PSA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15" />Qonqo anxi balchiinsha bagge;</para>
  <para style="q2" vid="PSA 22:15">arabi ankinna laagadake'n dhaphphi hiyye</para>
  <para style="q2" vid="PSA 22:15">reyeke manjishsha bukote'ni anee ibisseten.<verse eid="PSA 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16" />Fuggaaleeyye wonshiinke haagansha anee buqqe;</para>
  <para style="q2" vid="PSA 22:16">anga lekka anxa onte xalli assine.<verse eid="PSA 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17" />Ani huqatee'naa miqe anxi leelte;</para>
  <para style="q2" vid="PSA 22:17">naaphi ankinna anee dhaphphi hiyye'e hubate uuda'n cee'me.<verse eid="PSA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18" />Seemma anxa qoqoodemme;</para>
  <para style="q2" vid="PSA 22:18">ooddoono anxe'inna hixa iblisine.<note caller="-" style="x"><char style="xo" closed="false">22:18 </char><char style="xt" closed="false"><ref loc="MAT 27:35">Mat. 27:35</ref>; <ref loc="MRK 15:24">Mar. 15:24</ref>; <ref loc="LUK 23:34">Luq. 23:34</ref>; <ref loc="JHN 19:24">Yoh. 19:24</ref>. </char></note><verse eid="PSA 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19" />Duuchchi Woddike Goottaa ati kinni anenaa'n bayyattoxxe'e;</para>
  <para style="q2" vid="PSA 22:19">Anke gargaarsanjoo! Anee gargaartotta'a rakke dagi.<verse eid="PSA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20" />Lubbo anxa naaphiinke wolaantichchanaa'n,</para>
  <para style="q2" vid="PSA 22:20">hedho anxa konne worshuwwinaa'n gatis.<verse eid="PSA 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21" />Neenqiinke afo'onaa'n anee gargaar;</para>
  <para style="q2" vid="PSA 22:21">gafarsiinke gaafanaa'ninna anee gatisi.<verse eid="PSA 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22" />Summa atika anke arda'n kulannon;</para>
  <para style="q2" vid="PSA 22:22">insa'ne bukki hineexxe bakka'n atee galateeffatannon.<note caller="-" style="x"><char style="xo" closed="false">22:22 </char><char style="xt" closed="false"><ref loc="HEB 2:12">Ibr. 2:12</ref>. </char></note><verse eid="PSA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23" />Ha'noo Duuchchi Woddika Gootta sodaatinaak manni isoo galateeffatte;</para>
  <para style="q2" vid="PSA 22:23">ha'no Ya'iqoobixxi sanne duuchcha isoo ulfeesse! Ha'noo Isira'eelixxi sanne duuchcha</para>
  <para style="q1" vid="PSA 22:23">Isoo saadde.<verse eid="PSA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24" />Isi miicemeeka manjo tuffatebaan;</para>
  <para style="q2" vid="PSA 22:24">dudduronna iso'n wirri hiyyabaan;</para>
  <para style="q2" vid="PSA 22:24">yaane kinni gargaarsakee raareexxa raare laqe.<verse eid="PSA 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25" />Hujjettexxe eloxxe huje'a ardi bukki hiyyeexxe bakka'n atee galateeffatannon;</para>
  <para style="q2" vid="PSA 22:25">atee sodataake manni edo wereegenneka wereega uuwwannon.<verse eid="PSA 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26" />Hiyyeeyye ittee godditaan;</para>
  <para style="q2" vid="PSA 22:26">Duuchchi Woddika Gootta harsaak manninna isoo galateeffataan;</para>
  <para style="q2" vid="PSA 22:26">hexxineeke baro duuchcha'ni godobi ha'nook gammada'n hedhowwaal.<verse eid="PSA 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27" />Buttatixxe gabala qico'n hedheek manni duuchch Duuchchi Woddika Gootta qaabbate'e isibaa'a higaan;</para>
  <para style="q2" vid="PSA 22:27">buttate'n hedheek gosa gosak ardi duuchchi isoo magenoofataan.<verse eid="PSA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28" />Duuchchi Woddik Gootti butta duuchcha'n moyanjoke kadeemmaxxee</para>
  <para style="q2" vid="PSA 22:28">gosa gosak ardi duuchchinna isi hunda galaan.<verse eid="PSA 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29" />Dureeyye duuchcha isi'a heeshshi hite'e magenooffaattaan;</para>
  <para style="q2" vid="PSA 22:29">reyee'naa'a buttin itaak manji duuchchi dageexxi ati edo guluffataan.<verse eid="PSA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30" />Daggaxxi ila isi'a ergataan;</para>
  <para style="q2" vid="PSA 22:30">Duuchchi Woddike Goottixxa yaanenna udumixxe ila'ni haassottaan.<verse eid="PSA 22:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31" />Insa'ne qullummatixxa isixxa huje lassina'n,</para>
  <para style="q2" vid="PSA 22:31">isi hujeexxa qullumma ilemaake arda'n haassonnaan.<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="s1">Duuchchii Woddik Gootti Anke Allalsanjon</para>
  <para style="d">Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1" />Duuchchi Woddik Gootti allalsanjo anke kadeemmaxxee</para>
  <para style="q2" vid="PSA 23:1">mitteechchonna gophannochchi hedhebaan.<verse eid="PSA 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2" />Quffeexxi badda'a hexxeeba anee geessiseexxi hafuura adhdhannoshsha assaan;</para>
  <para style="q2" vid="PSA 23:2">eloke wodi'ibaa'aanna anee akeekaan.<note caller="-" style="x"><char style="xo" closed="false">23:2 </char><char style="xt" closed="false"><ref loc="REV 7:17">Wal. 7:17</ref>. </char></note><verse eid="PSA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3" />Hedho anxee haaroxxa hedho huuwwaan;</para>
  <para style="q2" vid="PSA 23:3">ifiinke summi'aanna hiyyee'e qullummatike ora'ni anee akeekaan.<verse eid="PSA 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4" />Dimma dukkana giddo</para>
  <para style="q2" vid="PSA 23:4">reyotike gaadisixxe dhooqa'ni me'oonolenna midde</para>
  <para style="q2" vid="PSA 23:4">ati aninni welti hexxeettaxxee</para>
  <para style="q1" vid="PSA 23:4">Mittiichchi elobaachchi anee geyaan hiyyee sodaatabe'no;</para>
  <para style="q2" vid="PSA 23:4">kuti atikinna siqqichcho atixxi anee jajjabeessitaan.<verse eid="PSA 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5" />Naaphi ank uuda'naan jila ani'a jildette;</para>
  <para style="q2" vid="PSA 23:5">umo anke'n ejersiinxa zayite hariirtete;</para>
  <para style="q2" vid="PSA 23:5">ha'waannexxi buudanna wo'mite duunedaa qico'ni xuphphi hita.<verse eid="PSA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6" />Dhugaaten, baro anke duuchcha'ni,</para>
  <para style="q2" vid="PSA 23:6">elle atixxinna shaqqunte atixxi anxa duuka me'itaan;</para>
  <para style="q2" vid="PSA 23:6">baro anke duuchcha'n aninna Duuchchi Woddike Goottike mine'n hedhaannon.<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="s1">Lumoka Moyanjo</para>
  <para style="d">Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1" />Buttatinna buttate'n hedheechchi duuchchi,</para>
  <para style="q2" vid="PSA 24:1">Duuchchi Woddike Goottiken;</para>
  <para style="q2" vid="PSA 24:1">buttatinna buttate'n hedheeek ardi duuchchi isiken.<note caller="-" style="x"><char style="xo" closed="false">24:1 </char><char style="xt" closed="false"><ref loc="1CO 10:26">1 Qor. 10:26</ref>. </char></note><verse eid="PSA 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2" />Isi butta abbayyati hana ugge;</para>
  <para style="q2" vid="PSA 24:2">wode'uwwii iimi darrenna jabeesse isee uurriseek isoten.<verse eid="PSA 24:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3" />Duuchchi Woddike Goottixxa kooba ayyete qabbata?</para>
  <para style="q2" vid="PSA 24:3">Isixxe woyyitte bakka'n uurraaki ayyete?<verse eid="PSA 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4" />Ca'itte angakenna qullite qalbeke,</para>
  <para style="q2" vid="PSA 24:4">fakkuwwa maganoofatabaakenna,</para>
  <para style="q2" vid="PSA 24:4">dharik kakatabaaken.<note caller="-" style="x"><char style="xo" closed="false">24:4 </char><char style="xt" closed="false"><ref loc="MAT 5:8">Mat. 5:8</ref>. </char></note><verse eid="PSA 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5" />Isi Duuchchi Woddike Goottanaa'n eebba,</para>
  <para style="q2" vid="PSA 24:5">anjirallo Magenonaa'n qullumma alfaani.<verse eid="PSA 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6" />Isoo halsitaaxxi ila</para>
  <para style="q2" vid="PSA 24:6">Ee, Ya'iqoobike Magenoo tinni ila atee halsitaaxxen.<verse eid="PSA 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7" />Ulfeesemeek moyanji e'yaashsha,</para>
  <para style="q2" vid="PSA 24:7">tee dalla'iinxe hulluwwa duuchchiinbaa'n banemme;</para>
  <para style="q2" vid="PSA 24:7">koo olmike cufanuwwa banemme.<verse eid="PSA 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8" />Kunni ulfeesemeek moyanji isi ayyete?</para>
  <para style="q2" vid="PSA 24:8">Isi jabakenna hunnameessa Duuchchi Woddike Goottaan;</para>
  <para style="q2" vid="PSA 24:8">isi lolik injifateeke Duuchchi Woddike Goottaan.<verse eid="PSA 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9" />Ulfeesemeek moyanji e'yaashsha,</para>
  <para style="q2" vid="PSA 24:9">tee dalla'iinxe hulluwwa duuchchiinbaa'n banemme;</para>
  <para style="q2" vid="PSA 24:9">koo olmike cufanuwwa banemme.<verse eid="PSA 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10" />Kunni ulfeesemeek moyanji isi ayyete?</para>
  <para style="q2" vid="PSA 24:10">Kunni ulfeesemeek moyanji,</para>
  <para style="q2" vid="PSA 24:10">Dada Duuchcha Ajajaake Duuchchi Woddike Goottaan!<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="s1">Mageniinxe Akeettexxanna Heqqatixxa Soodachcho</para>
  <para style="d">Daawwitixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 25:1" />Ee, Duuchchi Woddike Goottaa! Atinni haaso'aannen;<verse eid="PSA 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2" />Ee, anke Magenoo! Ani atee addateennen</para>
  <para style="q2" vid="PSA 25:2">meenni shookonnowwaal;</para>
  <para style="q2" vid="PSA 25:2">naaphi anki ane'ni gammadoqqe'e.<verse eid="PSA 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3" />Ate'ni adde assedhaak shookabaan;</para>
  <para style="q2" vid="PSA 25:3">shooki insa'ne geyaak</para>
  <para style="q2" vid="PSA 25:3">ati'ni addatemabaakeeranni.<verse eid="PSA 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4" />Ee, Duuchchi Woddike Goottaa! Ora atika ege'nannoshsha assi;</para>
  <para style="q2" vid="PSA 25:4">ora atikanna anee barachchiisi.<verse eid="PSA 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5" />Mageno ati anee anjirtattoke kaddeetaxxee</para>
  <para style="q2" vid="PSA 25:5">dhugaa atixxishsha galonna'aa anee barachchiisi;</para>
  <para style="q2" vid="PSA 25:5">ani hashsha barra adde assedhaannok atenden.<verse eid="PSA 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6" />Ee, Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 25:6">Ati arda atika bire</para>
  <para style="q2" vid="PSA 25:6">hitta mararta'eetaxxanna eettaataxxa hedi.<verse eid="PSA 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7" />Ee, Duuchchi Woddike Goottaa! Ati eloke kaddetaxxee,</para>
  <para style="q2" vid="PSA 25:7">shaqqunte atixxinni anee qaabat malee</para>
  <para style="q2" vid="PSA 25:7">anxa dargaggeeyyummatixxa cubbonna balleessa qaabbattoxxe'e.<verse eid="PSA 25:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8" />Duuchchi Woddiki Gootti elokenna qullichchake kadeemmaxxee,</para>
  <para style="q2" vid="PSA 25:8">me'itaaka ifika ora</para>
  <para style="q2" vid="PSA 25:8">cubballeyye barachchiisaan.<verse eid="PSA 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9" />Isi Shaqqaka manna toggichcha ora'ni akeekaan;</para>
  <para style="q2" vid="PSA 25:9">ora ifikanna insa'nee barachchiisaan.<verse eid="PSA 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10" />Duuchchi Woddike Goottixxe kakoka ajaja ulfeesse heqedhaake manni'a</para>
  <para style="q2" vid="PSA 25:10">Isi assaxxi duuchchi jaalalatitinna dhugaatiten.<verse eid="PSA 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11" />Ee, Duuchchi Woddike Goottaa! Atike summi'a hite'e,</para>
  <para style="q2" vid="PSA 25:11">yo'oshsha bira saxxeexxa anxa cubbo gattowwaal hiyyi.<verse eid="PSA 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12" />Duuchchi Woddika Gootta sodataak manji ayyete?</para>
  <para style="q2" vid="PSA 25:12">Isoo Duuchchi Woddik Gootti me'a hassissaaka ora barachchiisaan.<verse eid="PSA 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13" />Isi duuchchi wodda xoo'maamik hedhaan;</para>
  <para style="q2" vid="PSA 25:13">horte isixxinna boga dhaldaan.<verse eid="PSA 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14" />Duuchchi Woddiki Gootti isoo sodaataake manni duuchchi'a godobixxe kulaan;</para>
  <para style="q2" vid="PSA 25:14">aageemmaxxa kakonna insa'ne egenaashsha assaan.<verse eid="PSA 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15" />Duuchchi Woddike Gootti lekka anxa fonxorotenaa'n fulchaammaxxee,</para>
  <para style="q2" vid="PSA 25:15">ille anxi duuchchi wodda isiba'aaten.<verse eid="PSA 25:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16" />Ani miicemeennekenna gargaaraaka afebenoken;</para>
  <para style="q2" vid="PSA 25:16">Ee, Duuchchi Wooddike Goottaa! Anba'a wirri hiyyi; ani'aanna maraar.<verse eid="PSA 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17" />Rakko ane'ni bira saxxa'n me'ite'een;</para>
  <para style="q2" vid="PSA 25:17">abara duuchchanaa'inna anee gatisi.<verse eid="PSA 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18" />Rakko anxanna abara anka uudi;</para>
  <para style="q2" vid="PSA 25:18">cubbo anxa duuchchanna gattowwaal hiyyi.<verse eid="PSA 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19" />Naapha ank hittee qico bira sa'eexxa uudi;</para>
  <para style="q2" vid="PSA 25:19">hittee qico anee jibba'neexxanna uudi.<verse eid="PSA 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20" />Anee heqqi; lubbo anxanna anjir;</para>
  <para style="q2" vid="PSA 25:20">atee gollake assedhennaxxee'e</para>
  <para style="q2" vid="PSA 25:20">anke naaphi edo anee'e shookkishshoxxe'e.<verse eid="PSA 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21" />Ani addeti atee heqqedha'nexxee'e</para>
  <para style="q2" vid="PSA 25:21">qajelummatinna addatensha anee'e heqqitowwaal.<verse eid="PSA 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22" />Magenoo! Isira'eelii'i</para>
  <para style="q2" vid="PSA 25:22">rakko isexxe duuchchanaa'n wodi.<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="s1">Magenii Manjixxa Soodachcho</para>
  <para style="d">(Daawwitixxa Faaro)</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 26:1" />Ee, Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 26:1">Ani balleessa mitte belo me'eennen ani'a mur;</para>
  <para style="q2" vid="PSA 26:1">elqe kayyanna leele'mebe'nongi atee addateennen.<verse eid="PSA 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2" />Ee, Duuchchi Woddike Goottaa! Anee uudde hubatte'e</para>
  <para style="q2" vid="PSA 26:2">yaada ankanna godobixxa afi.<verse eid="PSA 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3" />Ati anee sinsinnebelo duuchchi woodda eeta'eetexxa uude'eennen;</para>
  <para style="q2" vid="PSA 26:3">aninna dhugaa atixxe'n me'annon.<verse eid="PSA 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4" />Dhariyyeti welti jaalomabe'non;</para>
  <para style="q2" vid="PSA 26:4">lame afo'ike manninninna mittoommabe'non.<verse eid="PSA 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5" />Fuggaaleeyyetixxa bukki gibannon;</para>
  <para style="q2" vid="PSA 26:5">xaqartiyyetinna welti offo'labe'non.<verse eid="PSA 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6" />Ee, Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 26:6">Balleessa hujebe'noxxa leellishatee'e anga anshedha'eennen;</para>
  <para style="q2" vid="PSA 26:6">ati'a tolchinammake boonchike qarqara'inna mammaremannon.<verse eid="PSA 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7" />Galatiinxa faaro faarsati</para>
  <para style="q2" vid="PSA 26:7">hujjetexxa mambe'a hujuwwa duuchcha haaso'aannon.<verse eid="PSA 26:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8" />Ee, Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 26:8">Ati hexxatoka minenna</para>
  <para style="q2" vid="PSA 26:8">atiki ulfinni hedheexxa bakka eeyyannon.<verse eid="PSA 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9" />Lubbo anxa cubbaaleeyyeti</para>
  <para style="q2" vid="PSA 26:9">hedho anxanna munde dunaammake manninni welti balleessittoxxe'e.<verse eid="PSA 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10" />Insa'nenna duuchchi wodda fuggoxxe hujatee hendaan;</para>
  <para style="q2" vid="PSA 26:10">matta adhdhateenna qophpheeffante'eeken.<verse eid="PSA 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11" />Ante kadonnole kinni komatendabaaxxe hedho hedhennen;</para>
  <para style="q2" vid="PSA 26:11">Magenoo anee wodi; anee anjir.<verse eid="PSA 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12" />Dirre bakka'n uurre'eennen;</para>
  <para style="q2" vid="PSA 26:12">ardi bukki hiyyeeba Duuchchi Woddika Gootta galateffatannon.<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="s1">Magenoke'n Addatatixxa Soodachcho</para>
  <para style="d">(Daawwitixxa Faaro)</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 27:1" />Duuchchi Woddiki Gootti anxe hedhoke ifanna anke anjirallon;</para>
  <para style="q2" vid="PSA 27:1">ayyeenna sodatabe'no;</para>
  <para style="q2" vid="PSA 27:1">Duuchchi Woddik Gootti anxe hedhoke gollan;</para>
  <para style="q2" vid="PSA 27:1">ayyeenna sodaatabe'no.<verse eid="PSA 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2" />Fuggaaleeyye ane'n kexxe'e anka maalanna itto'a hassa wodda</para>
  <para style="q2" vid="PSA 27:2">naaphi anikinna diini anki ane'n ke'aa wodda</para>
  <para style="q2" vid="PSA 27:2">insa'ne ifi'anni guggufantee inbaan.<verse eid="PSA 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3" />Heddi loliink manni anee buqoolenna sodaatabe'no;</para>
  <para style="q2" vid="PSA 27:3">naaphi anee adhoole midde</para>
  <para style="q2" vid="PSA 27:3">Mageno addataa waalabe'no.<verse eid="PSA 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4" />Duuchchi Woddika Gootta mitte yaane kadhataanen;</para>
  <para style="q2" vid="PSA 27:4">kadhataannelchinna: hedho anxike baro duuchcha,</para>
  <para style="q2" vid="PSA 27:4">Duuchchi Wooddike Goottike mineni hedhonnoshshanna Duuchchi Woddike Goottixxa danchumma uuda'ni saadonnaanna galma isike'n soodatonnaaten.<verse eid="PSA 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5" />Rakkoti baro ifike mini giddo anee heqqaan;</para>
  <para style="q2" vid="PSA 27:5">ifike dunkaan giddonna anee sho'aan;</para>
  <para style="q2" vid="PSA 27:5">rasatixxe xungo'ninna anee uggaan.<verse eid="PSA 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6" />Eettenee yanna anee buqemmaka naapha'n</para>
  <para style="q2" vid="PSA 27:6">ank umi qokki hiyyaan;</para>
  <para style="q2" vid="PSA 27:6">isike dunkaani giddonna illiillisatika tolchanna tolchannon;</para>
  <para style="q2" vid="PSA 27:6">galatiinxa faaronna faarsa'n Duuchchi Woddika Gootta galateefatannon.<verse eid="PSA 27:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7" />Ee, Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 27:7">Atee ye'aanno wodda heeyyi!</para>
  <para style="q2" vid="PSA 27:7">Ani'anna mararte'e soodachcho anxanna laqi!<verse eid="PSA 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8" />Atii «Anee halse» hitaatale,</para>
  <para style="q2" vid="PSA 27:8">Duuchchi Woddike Goottaa! Qalbe anxi atee halsannon hite.<verse eid="PSA 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9" />Ee anke anjirallo Magenoo!</para>
  <para style="q2" vid="PSA 27:9">Dudduro ane'n wirri hitoxxe'e;</para>
  <para style="q1" vid="PSA 27:9">Mufattenna garbichcha atika anee ifinaa'n bayyissoxxe'e;</para>
  <para style="q2" vid="PSA 27:9">gargaarsanjo anke kaddettaxxeenna anee gibboxxe'e; anee waaldoxxe'e.<verse eid="PSA 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10" />Anni ankina ama anxi anee waalloolenna midde,</para>
  <para style="q2" vid="PSA 27:10">Duuchchi Woddiki Gootti anee abixxaan.<verse eid="PSA 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11" />Ee Duuchchi Woddike Goottaa! Ora atika ane'n barachchiisi;</para>
  <para style="q2" vid="PSA 27:11">naapha afe'ennaxxeenna toggichcha atike ora'n anee akeek.<verse eid="PSA 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12" />Dhark dhugaa kulaakiiri hunnati ane'n ke'eemmaxxee</para>
  <para style="q2" vid="PSA 27:12">anke naaphiinxe anga'n anee sa'issite uutoxxe'e.<verse eid="PSA 27:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13" />Hedhoti hedheek manni hedhaaxxe butta'n hedhennexxi</para>
  <para style="q2" vid="PSA 27:13">Duuchchi Woddike Goottixxa elle uudannoxxa addatateennen.<verse eid="PSA 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14" />Duuchchi Woddika Gootta addati;</para>
  <para style="q2" vid="PSA 27:14">jabatti; mee co'o;</para>
  <para style="q2" vid="PSA 27:14">Duuchchi Woddika Gootta addati.<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="s1">Gargaarsa Alfatee Shiqqeexxa Soodachcho</para>
  <para style="s2">(Daawwitixxa Faaro)</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 28:1" />Ee anke golla Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 28:1">Atete ye'edhaannen, sammi hitoxxe'e</para>
  <para style="q2" vid="PSA 28:1">sammi hittotole ani reyemmake manninni qixxeten.<verse eid="PSA 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2" />Atike yo'oshsha Woyyichcha Galdumibaa anga anxa ke'isennexxi</para>
  <para style="q2" vid="PSA 28:2">gargaartota'a ate'n oodhanno wodda maganneten soodachcho anxa laqi.<verse eid="PSA 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3" />Fuggoxxa assaake xaqaritichchi manninni welti anee adhdhitoxxe'e;</para>
  <para style="q2" vid="PSA 28:3">insa'ne olla'ik eloke afo'o haasonnaan;</para>
  <para style="q2" vid="PSA 28:3">godoba insa'nek giddo kinni fuggoxxe uggudhine'een.<verse eid="PSA 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4" />Huje insa'neexxishshanni,</para>
  <para style="q2" vid="PSA 28:4">assineemmaxxe fuggoshshanni hira insane'a uwwi;</para>
  <para style="q1" vid="PSA 28:4">Anga ifixxenni hunjeemmaxxe hujeshshanni insa'nen mur;</para>
  <para style="q2" vid="PSA 28:4">hasisaa qiconna insa'nee xixi.<note caller="-" style="x"><char style="xo" closed="false">28:4 </char><char style="xt" closed="false"><ref loc="REV 22:12">Wal. 22:12</ref>. </char></note><verse eid="PSA 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5" />Duuchchi Woddik Gootti asseexxinna dadeexxi insa'ne'n mittechchonna laba gophpheemmaxxee</para>
  <para style="q2" vid="PSA 28:5">Mageni insa'nee butuchchaa malee'e qammalchabaan.<verse eid="PSA 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6" />Soodachcho anxa laqeemmaxxee</para>
  <para style="q2" vid="PSA 28:6">Duuchchi Woddiki Gootti saademowwaal.<verse eid="PSA 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7" />Duuchchi Woddiki Gootti hunna anxenna anxe wonten;</para>
  <para style="q2" vid="PSA 28:7">anee gargaare gammachchiisemmaxxee isoo addataannen;</para>
  <para style="q2" vid="PSA 28:7">faarotinna isoo galateeffataannen.<verse eid="PSA 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8" />Duuchchi Woddik Gootti arda ifikee hunnaten;</para>
  <para style="q2" vid="PSA 28:8">hariire'e moosiseemmake moyanji'aanna anjiratike gollan.<verse eid="PSA 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9" />Magenoo arda atika anjir;</para>
  <para style="q2" vid="PSA 28:9">karra atixxe kadeeka mannanna eebbisi;</para>
  <para style="q1" vid="PSA 28:9">Allaalsanjo insa'neke kaddettexxi duuchchi woddi'aanna insa'nee ba'edhi.<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="s1">Mageniinke Haaso'ixxa Hunna</para>
  <para style="s2">(Daawwitixxa Faaro)</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 29:1" />Ha'no iimatixxi erganna duuchchaa,</para>
  <para style="q2" vid="PSA 29:1">Duuchchi Woddik Gootti hunnameessakenna ulfaate'eeken hiyye.<verse eid="PSA 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2" />Ulfeeseme'eeke isike summi'a Duuchchi Woddika Gootta saadde;</para>
  <para style="q2" vid="PSA 29:2">isixxe woyyummake gaachanni'a Duuchchi Woddika Gootta Magenoonfatte.<note caller="-" style="x"><char style="xo" closed="false">29:2 </char><char style="xt" closed="false"><ref loc="PSA 96:7-9">Far. 96:7-9</ref>. </char></note><verse eid="PSA 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3" />Duuchchi Woddike Goottik haasso'i abbayyuwwati hana laqisa;</para>
  <para style="q1" vid="PSA 29:3">Ulfateeki Magen,</para>
  <para style="q2" vid="PSA 29:3">Duuchchi Woddik Gootti abbayyuwwate'n hana dindime.<verse eid="PSA 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4" />Duuchchi Woddike Goottik haaso'i hunna afe'eeken;</para>
  <para style="q2" vid="PSA 29:4">isiki haaso'inna gaachchanna afe'eeken.<verse eid="PSA 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5" />Duuchchi Woddike Goottik haaso'i birbirsuwwa caccasaan;</para>
  <para style="q2" vid="PSA 29:5">Duuchchi Woddik Gootti Libaanoosika birbirsuwwa caccassaan.<verse eid="PSA 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6" />Libaanoosixxa koobuwwa jabbetishsha burraqaashsha assaan;</para>
  <para style="q2" vid="PSA 29:6">Siriyoonixxa<note caller="+" style="f"><char style="fr" closed="false">29:6 </char><char style="ft" closed="false">Siryoonii hiyya Hermoonixxe kooba hiyyaten</char></note> koobuwwanna gafarisiinxe beltannashsha utaaldaashsha assaan.<verse eid="PSA 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7" />Duuchchi Woddike Goottik haaso'i</para>
  <para style="q2" vid="PSA 29:7">banqo balaqisaan.<verse eid="PSA 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8" />Duuchchi Woddike Goottik haaso'i qiilla gammoojje sheke sheke assaan;</para>
  <para style="q2" vid="PSA 29:8">Duuchchi Woddik Gootti Qaadeesixxa qiilla gammoojjenna lele'misaan.<verse eid="PSA 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9" />Duuchchi Woodike Goottik haaso'i qilxa lele'misaan;</para>
  <para style="q2" vid="PSA 29:9">haqichchuwwiinka shafuwwanna harcaasaan;</para>
  <para style="q2" vid="PSA 29:9">isike galduma'n hedheek duuchchi haaso'a isika laqaa wodda</para>
  <para style="q1" vid="PSA 29:9">«Ulfinni Magenokee kadowwaal» hiyyaan.<verse eid="PSA 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10" />Duuchchi Woddik Gootti dhi'mo abbayya'ni moyaan;</para>
  <para style="q2" vid="PSA 29:10">Duuchchi Woddik Gootti ifixxe moyanjummanni duuchchi woddi'a galchaan.<verse eid="PSA 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11" />Duuchchi Woddik Gootti arda ifikee hunna uwwaan;</para>
  <para style="q2" vid="PSA 29:11">nage'akanna uwwee insa'nee eebbisaan.<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="s1">Galatiinxa Soodachcho</para>
  <para style="s2">(Galmiinxe Eebba'a Faarsendeexxa Daawwitixxa Faaro)</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 30:1" />Ee, Duuchchi Woddike Goottaa! Dhi'mo balenaa'n anee gatise'e naaphi ane'n gammadabaashsha assittetexxee</para>
  <para style="q2" vid="PSA 30:1">atee lummisee galateeffataannen.<verse eid="PSA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2" />Ee Duuchchi Woddike Gootta anke Magenoo! Anee gargaartota'a atee soodateennen;</para>
  <para style="q2" vid="PSA 30:2">atinna anee fayyissete.<verse eid="PSA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3" />Ee Duuchchi Woddike Goottaa! Reyotenaa'n anee fulchittete;</para>
  <para style="q2" vid="PSA 30:3">hiireesiinxe balenaa'ninna anee gatissete.<verse eid="PSA 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4" />Duuchchi Woddike Goottike arda kaddineek, Duuchchi Woddika Gootta faaroti saadde;</para>
  <para style="q2" vid="PSA 30:4">isika woyyichcha summanna galateeffate.<verse eid="PSA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5" />Mufe isixxi shiixxoxxe yanna'aten;</para>
  <para style="q1" vid="PSA 30:5">Elle isixxi kinni hedhotike bari duuchchi'aten; hashsha oodhishshate kaddoole</para>
  <para style="q2" vid="PSA 30:5">gorsa kinni gammashshote kadda.<verse eid="PSA 30:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6" />Yaane ani'a eldee'naa udenne wodda</para>
  <para style="q2" vid="PSA 30:6">«Haranga lele'mabe'no» hiyyenne.<verse eid="PSA 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7" />Ee Duuchchi Woddike Goottaa! Ati ani'a eldette wodda le'mitammabaaxxe</para>
  <para style="q2" vid="PSA 30:7">koobashsha anee jabake assittete;</para>
  <para style="q2" vid="PSA 30:7">dudduro ane'n wirri hittete wodda kinni alayyenne.<verse eid="PSA 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8" />Ee Duuchchi Woddike Goottaa! Ani atee ye'edhenne;</para>
  <para style="q2" vid="PSA 30:8">ani'anna marartota'a atee soodatenne.<verse eid="PSA 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9" />Ani reyonnole maa alfittatoo?</para>
  <para style="q2" vid="PSA 30:9">Reyonnole maa la'o hexxe?</para>
  <para style="q2" vid="PSA 30:9">Reyeek manni atee galateeffataata?</para>
  <para style="q2" vid="PSA 30:9">Xuurameessumma atixxa haaso'aata?<verse eid="PSA 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10" />Ee Duuchchi Woddike Goottaa! Ani'a marartetexxi soodachcho anxa laqi;</para>
  <para style="q2" vid="PSA 30:10">Ee Duuchchi Woddike Goottaa! Anee gargaar.<verse eid="PSA 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11" />Ati gadda anka sirbake'n jijjiirtetten;</para>
  <para style="q2" vid="PSA 30:11">dooniyya seemma anenaa'n mulqitette'e</para>
  <para style="q2" vid="PSA 30:11">gammashsho ane'n oddeesitette.<verse eid="PSA 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12" />Yoona ani sammi hiyyabe'non ate galatiinxe faaronni sadannon.</para>
  <para style="q2" vid="PSA 30:12">Ee Duuchchi Woddike Gootta anke Magenoo!</para>
  <para style="q2" vid="PSA 30:12">Ani duuchchii wodda ati'a galata uwwannon.<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="s1">Magenoke'n Addatatixxa Soodachcho</para>
  <para style="q1">Faarsaleeyeetike Akeekisanji'a Saadinoti woddixxa Daawwitixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 31:1" />Ee, Duuchchi Woddike Goottaa! Atee'e golla anke assedhe'eennen</para>
  <para style="q2" vid="PSA 31:1">anee shookkishshoxxe'e;</para>
  <para style="q2" vid="PSA 31:1">qullumma atixxenni anee anjir.<verse eid="PSA 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2" />Mansha atixxa aniba'a wirri assite'e laqi;</para>
  <para style="q2" vid="PSA 31:2">rakke anee anjir;</para>
  <para style="q2" vid="PSA 31:2">golledhannoxxe anxe rassa,</para>
  <para style="q1" vid="PSA 31:2">anjiremonna'aanna anxe kollo kad.<verse eid="PSA 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3" />Ati rassa anxenna golla anke kaddettaxxee</para>
  <para style="q2" vid="PSA 31:3">summa atingee hite'e anee akeek;</para>
  <para style="q2" vid="PSA 31:3">orakanna ane'n leellishshi.<verse eid="PSA 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4" />Ati anke golla kaddeettaxxee'e</para>
  <para style="q2" vid="PSA 31:4">naaphi ani'a faayeexxe fonxoronaa'n anee'e fulchi.<verse eid="PSA 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5" />Ee, Duuchchi Woddike Gootta dhugaatike Magenoo!</para>
  <para style="q2" vid="PSA 31:5">Ati anee wodde'eten; hedho anxa ate'n uwwa'enne.<note caller="-" style="x"><char style="xo" closed="false">31:5 </char><char style="xt" closed="false"><ref loc="LUK 23:46">Luq. 23:46</ref>. </char></note><verse eid="PSA 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6" />Woyi fuldabaaxxa fakkuwwa magenoonfatakaara jibbenne;</para>
  <para style="q2" vid="PSA 31:6">yaane kinni ani Duuchchi Woddika Gootta addatenne.<verse eid="PSA 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7" />Rakkate'naa anee'e uuddetexxeenna</para>
  <para style="q2" vid="PSA 31:7">anxe lubboka abara egende'eetaxxee</para>
  <para style="q2" vid="PSA 31:7">jaalala atixxe'n gammadee'e illillisaannen.<verse eid="PSA 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8" />Naaphake'n anee'e sa'isite uutebexxon;</para>
  <para style="q2" vid="PSA 31:8">yanne kinni lekka anxa ba'laba uurrise'eeten.<verse eid="PSA 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9" />Ee, Duuchchi Woddike Goottaa rakko giddo hedhenneni ani'a marar;</para>
  <para style="q2" vid="PSA 31:9">rakkotenaa'n kexxeexxa ille anxi gophphe;</para>
  <para style="q2" vid="PSA 31:9">lubbo anxinna bis anki wexeqeme.<verse eid="PSA 31:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10" />Lubbo anxi abarik,</para>
  <para style="q2" vid="PSA 31:10">bari anikinna fooxxiyyat mude;</para>
  <para style="q2" vid="PSA 31:10">rakkotenaa'n kexxeexxa hunna gophenne;</para>
  <para style="q2" vid="PSA 31:10">micci anki duuchchinna wode'eke kade.<verse eid="PSA 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11" />Naaphi anki duuchchi ane'ni gacifate'e;</para>
  <para style="q2" vid="PSA 31:11">ola'i ankinna caala ane'n gacifate,</para>
  <para style="q2" vid="PSA 31:11">anee ege'neekee'e shookkiinke kadeennen;</para>
  <para style="q2" vid="PSA 31:11">orake'n afemenneki duuchchinna anee baaje.<verse eid="PSA 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12" />Reyeeke manjishsha dedhemenne;</para>
  <para style="q2" vid="PSA 31:12">rerteexxe oddolchoshshanna uudemenne.<verse eid="PSA 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13" />Heddi manni hashaashaa'naa laqaannaxxee</para>
  <para style="q2" vid="PSA 31:13">qarqara anke duuchchi'n soda'ate hexxemman;</para>
  <para style="q1" vid="PSA 31:13">ani'a weli gene'e mari'ante;</para>
  <para style="q2" vid="PSA 31:13">hedho anxa balleessino'a mallaan.<verse eid="PSA 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14" />Yaane kinni Ee, Duuchchi Woddike Goottaa! Ani atete addateenen</para>
  <para style="q2" vid="PSA 31:14">«Ati anke Magenon» hiyyannon.<verse eid="PSA 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15" />Bari ank duuchchi hedheek anga atixxe'nten;</para>
  <para style="q2" vid="PSA 31:15">anke naaphixxe anganaa'ninna</para>
  <para style="q2" vid="PSA 31:15">shorramake mannixxe anganaa'n anee gatisi.<verse eid="PSA 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16" />Anee erganjo atikee alba ifi,</para>
  <para style="q2" vid="PSA 31:16">jaalala atixxenninna anee anjir.<verse eid="PSA 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17" />Ee, Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 31:17">Ani atee'e ye'eedhannaxxee, anee shookkishshoxxe'e;</para>
  <para style="q2" vid="PSA 31:17">fuggaaleeyye kinni shookkowwaal;</para>
  <para style="q2" vid="PSA 31:17">hireessa hundike'n saxxe'e buccuqqinna hitoqqe'e.<verse eid="PSA 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18" />Qulliyyete'n hollati</para>
  <para style="q2" vid="PSA 31:18">ifi dukatinna tuffeti</para>
  <para style="q2" vid="PSA 31:18">haaso'aammak dharichchi afo'uwwi duudowwaal.<verse eid="PSA 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19" />Manjiinke belti edo,</para>
  <para style="q2" vid="PSA 31:19">atee sodaatakeeri'a uggite'eetexxi,</para>
  <para style="q2" vid="PSA 31:19">atee gollake assedhakeeri'anna qophpheesite'eetexxi,</para>
  <para style="q2" vid="PSA 31:19">elle atixxi hittata bira saxxeexxe!<verse eid="PSA 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20" />Fuggoxxa malaake mannanaa'n insa'nee atike galdumi giddo heqqittatto;</para>
  <para style="q2" vid="PSA 31:20">eloobake afo'onaa'ninna duunkaana atiki giddo insa'nee gollittatton.<verse eid="PSA 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21" />Buqemeemmake qachchi giddo,</para>
  <para style="q2" vid="PSA 31:21">mambee'iinxe ifixxe jaalalanni anee eeyeek,</para>
  <para style="q2" vid="PSA 31:21">Duuchchi Woddik Gootti saademowwaal!<verse eid="PSA 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22" />Alayyenne wodda</para>
  <para style="q2" vid="PSA 31:22">«Ille atixxi edii'n fuggusemeenne» hiyyenne;</para>
  <para style="q2" vid="PSA 31:22">ati kinni anee gargaartota'a atiba'a raarenne wodda</para>
  <para style="q2" vid="PSA 31:22">kadha anxa laqqeten.<verse eid="PSA 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23" />Ha'no qulliyye duuchcha Duuchchi Woddika Gootta eeyye;</para>
  <para style="q2" vid="PSA 31:23">Duuchchi Woddik Gootti addatemaaleeyye heqa heqaan,</para>
  <para style="q2" vid="PSA 31:23">hollameeyye kinni hara xixaan.<verse eid="PSA 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24" />Ha'noo Duuchchi Woddike Gootta'n addatinaak duuchchi</para>
  <para style="q2" vid="PSA 31:24">jabatte, hara jabaatte.<verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="s1">Aadde Aaganna Gattowwaalii Alfaa</para>
  <para style="d">Daawwitixxa Gence.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 32:1" />Balleesa insa'nexxi gattowwaali hiyyendeekirxa,</para>
  <para style="q2" vid="PSA 32:1">cubbo insa'nexxiirinna waalendeeke</para>
  <para style="q2" vid="PSA 32:1">manjixxa wodo.<verse eid="PSA 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2" />Duuchchi Woddik Gootti cubbo iso'ni laakko'abaakenna</para>
  <para style="q2" vid="PSA 32:2">soballo yaada afebaake manjixxa wodo.<note caller="-" style="x"><char style="xo" closed="false">32:2 </char><char style="xt" closed="false"><ref loc="ROM 4:7-8">Rom. 4:7-8</ref>. </char></note><verse eid="PSA 32:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3" />Cubbo anxa ku'la gophenne wodda barra duuchcha fooxxi hiyyatenaa'ni kexxeexxa</para>
  <para style="q2" vid="PSA 32:3">micci mikit ank duuchchi gophe.<verse eid="PSA 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4" />Hashsha barra jaba qicinni anee gandeetaxxee'e</para>
  <para style="q2" vid="PSA 32:4">eebbinji bonik bassaammalchishsha</para>
  <para style="q2" vid="PSA 32:4">hunna anenaa'n xo'o hite.<verse eid="PSA 32:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5" />Cubbo anxa ate'n ege'ni'lshenne;</para>
  <para style="q2" vid="PSA 32:5">balleessa anxanna atee sho'ebe'no;</para>
  <para style="q1" vid="PSA 32:5">«Sa'ne anxanna Duuchchi Woddike Gootta'n ku'lanon» hiyyenne;</para>
  <para style="q2" vid="PSA 32:5">atinna cubbo anxanna gattowwaal hitteten.<verse eid="PSA 32:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6" />Tennexxee mitti mitting qullichchi,</para>
  <para style="q2" vid="PSA 32:6">abariinxa yanna atiba'aa soodatowwaal;</para>
  <para style="q2" vid="PSA 32:6">jabak lola'inna dagoole isiba geyabaan.<verse eid="PSA 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7" />Ati anke gollan;</para>
  <para style="q2" vid="PSA 32:7">rakkotenaa'n anee'e heqqitatton;</para>
  <para style="q1" vid="PSA 32:7">Naaphakenaa'n fula anxe'n gammadaake mannixxe faaronni qoqqobemannoshsha assitatton.<verse eid="PSA 32:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8" />Ani atee barachchiisanon;</para>
  <para style="q2" vid="PSA 32:8">me'itatoke ora'inna atee akeekannon;</para>
  <para style="q2" vid="PSA 32:8">atee gorsannon; illetinna atee heqqanno.<verse eid="PSA 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9" />Bixaalikinna lugaamik leenjissemmoole malee'e</para>
  <para style="q2" vid="PSA 32:9">atiba'a shiqammabaake,</para>
  <para style="q2" vid="PSA 32:9">hedduma afemmabaake</para>
  <para style="q2" vid="PSA 32:9">fadhachiinsha yookaan gaangeshsha kaddinoqqe'e.<verse eid="PSA 32:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10" />Cubbaaleeyyetik abarii bira sa'eeken;</para>
  <para style="q2" vid="PSA 32:10">Duuchchi Woddika Gootta addataaka kinni,</para>
  <para style="q2" vid="PSA 32:10">duuchchi woddixxi jaalala iso'o qoqqobaan.<verse eid="PSA 32:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11" />Ha'noo qulliyyee! Duuchchi Woddike Gootta'ni</para>
  <para style="q2" vid="PSA 32:11">gammadde, ilillisse;</para>
  <para style="q1" vid="PSA 32:11">Ca'itte qalbe afine'eekinna illillise.<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="s1">Saadinotixxa Faaro Magenokee</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 33:1" />Ha'noo qulliyyee! Duuchchi Woddike Gootta'n gammadde;</para>
  <para style="q2" vid="PSA 33:1">qajeeli manni isoo saada hassissaan.<verse eid="PSA 33:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2" />Duuchchi Woddika Gootta Masnqoti saadde;</para>
  <para style="q2" vid="PSA 33:2">tomme kirreke baganinninna isoo faarse.<verse eid="PSA 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3" />Haaroxxe faaronni isoo faarse;</para>
  <para style="q2" vid="PSA 33:3">biifake meellinni bagana gandinna'ni</para>
  <para style="q2" vid="PSA 33:3">gammadikinna illillisse.<verse eid="PSA 33:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4" />Duuchchi Woddike Goottik haaso'i dhugaaten;</para>
  <para style="q2" vid="PSA 33:4">Duuchchi woddik Gootti hujaaxxe duuchcha'ni addateme'eeken.<verse eid="PSA 33:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5" />Duuchchi Woddik Gootti qullummatanna dhugaate eeyyaan;</para>
  <para style="q2" vid="PSA 33:5">jaalala isixxinna buttta duuchcha'n wo'maten.<verse eid="PSA 33:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6" />Duuchchi Woddik Gootti iimuwwa haaso'a ifiken,</para>
  <para style="q2" vid="PSA 33:6">atike ajajinni urjuwwatik sannachchuwwi dademe,<verse eid="PSA 33:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7" />Abbaayyatika wode'e mitte bakka'n bukki assaan;</para>
  <para style="q2" vid="PSA 33:7">lumollamma abbaayyuwwaka wode'enna mitte bakka'n eelchaanni.<verse eid="PSA 33:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8" />Butta duuchcha, Duuchchi Woddika Gootta sodaattowwaal;</para>
  <para style="q2" vid="PSA 33:8">buttate'n hedheek ardi duuchchinna isi'aa culphisowwaal.<verse eid="PSA 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9" />Isi haaso'ee wodda buttaa duuchcha dadende,</para>
  <para style="q2" vid="PSA 33:9">isike ajajinni duuchchiinxi yaane ti'ni hite uurte.<verse eid="PSA 33:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10" />Duuchchi Woddik Gootti gosa gosake ardixxa mari'e toliinxe assaan;</para>
  <para style="q2" vid="PSA 33:10">ardiinka yaadanna bakka geyabaashsha assaan.<verse eid="PSA 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11" />Duuchchi Woddike Goottik yaadi kinni duuchchi woddi'a hedhaan;</para>
  <para style="q2" vid="PSA 33:11">hedumi iskinna ila ilatteeten.<verse eid="PSA 33:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12" />Duuchchi Woddik Gootti Mageno insa'neke kadeeke,</para>
  <para style="q2" vid="PSA 33:12">geeggo ifike assedhe fi'leeke ardixxa wodo!<verse eid="PSA 33:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13" />Duuchchi Woddik Gootti iimatenaa'n uudaan;</para>
  <para style="q2" vid="PSA 33:13">manjiinka belto duuchchanna afaan.<verse eid="PSA 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14" />Ifixxe bakka'n hedheexxi</para>
  <para style="q2" vid="PSA 33:14">buttate'n hedheeka duuchcha afaan.<verse eid="PSA 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15" />Isi manji duuchchixxa qalbe dadeek,</para>
  <para style="q2" vid="PSA 33:15">assineexxa duuchchanna ege'naan.<verse eid="PSA 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16" />Moyanj lumoxxe hunnaka loliinke manna ifi'a afeexxee'e naaphakenaa'n fulabaan;</para>
  <para style="q2" vid="PSA 33:16">jannikinna ifixxe hunnake jabeenninni gatabaan.<verse eid="PSA 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17" />Fadhachchik lollee'e injifatanno hiyye addataa toliinxen;</para>
  <para style="q2" vid="PSA 33:17">ifixxe jabaxxe hunnanninna ayyi'anna anjiremabaan.<verse eid="PSA 33:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18" />Kunse, Duuchchi Woddike Goottixxi ille isoo sodaatakeeriba'a,</para>
  <para style="q2" vid="PSA 33:18">duuchchi woddixxa isixxa jaalalanna addataake manniba'a uuddaan.<verse eid="PSA 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19" />Isi insa'nee reyotenaa'n gatisaan;</para>
  <para style="q2" vid="PSA 33:19">solo'ii sanenna hedhoti insa'nee uggaan.<verse eid="PSA 33:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20" />No'o Duuchchi Woddika Gootta addeti heqqe'nanno;</para>
  <para style="q2" vid="PSA 33:20">isi gargaarsanjo no'okenna wonte no'oxen.<verse eid="PSA 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21" />Isike woyyichcha summa'n addante'eennaxxee</para>
  <para style="q2" vid="PSA 33:21">iso'n gammanda'eennen.<verse eid="PSA 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22" />Ee, Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 33:22">No'o ate'ni addantenneshshanni,</para>
  <para style="q2" vid="PSA 33:22">duuchchi woddixxi atixxi jaalala no'o'ni hexxowwaal.<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="s1">Mageniinxe Ellexxee shiqqeexxa Saadino</para>
  <para style="d">Ifi maraate'eeke manjo asseexxi Daawwiti Abemelek Edo Shiqemmaxxee Shoreme Fulee wodda Faarseexxa Daawwitixxa Faaro</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 34:1" />Ani duuchchi wodda Duuchchi Woddika Gootta saadannon;</para>
  <para style="q2" vid="PSA 34:1">jajinno isixxinna duuchchi wodda afo'o ankennaa'ninna qoottabaan.<note caller="-" style="x"><char style="xo" closed="false">34:1 </char><char style="xt" closed="false"><ref loc="1SA 21:13-15">1 Sam. 21:13-15</ref>. </char></note><verse eid="PSA 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2" />Lubbo anxi Duuchchi woddik Goottinni ifi jajjaan;</para>
  <para style="q2" vid="PSA 34:2">miicemeek manni tennee laqe'e gammadowwaal.<verse eid="PSA 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3" />Aninni welti Duuchchi Woddika Gootta lummisse;</para>
  <para style="q2" vid="PSA 34:3">summa isikanna mittenba kubbinso.<verse eid="PSA 34:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4" />Aninna Duuchchi Woddika Gootta halsenne; isinna heeyye;</para>
  <para style="q2" vid="PSA 34:4">sodaatannaxxe yaane duuchchanaa'n anee anjire.<verse eid="PSA 34:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5" />Iso'n ille uggudhaakiir alba ifaan;</para>
  <para style="q2" vid="PSA 34:5">Insa'nenna shoonkabaan.<verse eid="PSA 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6" />Kunni rakkichchi oodhe;</para>
  <para style="q2" vid="PSA 34:6">Duuchchi Woddik Goottinna oodhishsha isixxa laqe;</para>
  <para style="q2" vid="PSA 34:6">rakko isixxe duuchchanaa'ninna isoo anjire.<verse eid="PSA 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7" />Duuchchi Woddike Goottik iimiki erganji,</para>
  <para style="q2" vid="PSA 34:7">isoo sodaataka manna qoqqobaan;</para>
  <para style="q2" vid="PSA 34:7">rakkotenaa'n insa'nee fulchaan.<verse eid="PSA 34:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8" />Duuchchi Woddik Gootti eloke kadeexxa muxxine uudde;</para>
  <para style="q2" vid="PSA 34:8">isoo gollake assedheeke manjixxa wodo.<note caller="-" style="x"><char style="xo" closed="false">34:8 </char><char style="xt" closed="false"><ref loc="1PE 2:3">1 Phex. 2:3</ref>. </char></note><verse eid="PSA 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9" />Isoo sodaataak manni mittechchonna gophammabaaxxee,</para>
  <para style="q2" vid="PSA 34:9">ha'no isik woyyichchi manni Duuchchi Woddika Gootta sodaatte;<verse eid="PSA 34:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10" />Dargageesi neenqi itaachcho gopheexxi solo'waaxxe hexxaan;</para>
  <para style="q2" vid="PSA 34:10">Duuchchi Woddika Gootta halsaake mannanaa'n kinni elloxxi yaane xe'yitabaan.<verse eid="PSA 34:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11" />Tee oose! Amme hiyyaannexxa caqasse;</para>
  <para style="q2" vid="PSA 34:11">Duuchchi Woddika Gootta sodaata ha'noo barachchiisannon.<verse eid="PSA 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12" />Hedho eeyyaak,</para>
  <para style="q2" vid="PSA 34:12">eloxxanna uudo'a qeera barro halchaak ayyete?<verse eid="PSA 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13" />Arabo atikenaa'n elobaaxxi fuldabaashsha,</para>
  <para style="q2" vid="PSA 34:13">afo'i atikinna sobo haaso'abaashsha heqqedhi.<verse eid="PSA 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14" />Fuggoxxenaa'n baaji; elloxxanna assi;</para>
  <para style="q2" vid="PSA 34:14">nage'a halsi; isoonna hordof.<verse eid="PSA 34:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15" />Duuchchi Woddike Goottixxi ille qulliyyetibaa uudaan;</para>
  <para style="q2" vid="PSA 34:15">mansha isixxinna soodachcho insa'neexxa laqqaan.<verse eid="PSA 34:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16" />Duuchchi Woddik Gootti fuggoxxa assaaka manna gibaan;</para>
  <para style="q2" vid="PSA 34:16">buttate'ninna qaabbatemmabaasha assaan.<note caller="-" style="x"><char style="xo" closed="false">34:16 </char><char style="xt" closed="false"><ref loc="1PE 3:10-12">1 Phex. 3:10-12</ref>. </char></note><verse eid="PSA 34:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17" />Qulliyye ooxxaa wodda Duuchchi Woddik Gootti laqaan;</para>
  <para style="q2" vid="PSA 34:17">rakko insa'neexxe duuchchinaa'inna insa'nee fulchaan.<verse eid="PSA 34:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18" />Qalbe insa'nexxi enqendeekeeri'a Duuchchi Woddik Gootti shiqoken;</para>
  <para style="q2" vid="PSA 34:18">yaade cumummi hiyyeekaranna anjiraan.<verse eid="PSA 34:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19" />Qullichchi manjixxi rakko heddoten;</para>
  <para style="q2" vid="PSA 34:19">Duuchchi Woddik Gootti kinni tennee duuchchiinxenaa'n isoo fulchaan.<verse eid="PSA 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20" />Duuchchi Woddik Gootti micco mikita isika duuchcha heqqaan;</para>
  <para style="q2" vid="PSA 34:20">mitti miccinna midde enqemabaan.<note caller="-" style="x"><char style="xo" closed="false">34:20 </char><char style="xt" closed="false"><ref loc="JHN 19:36">Yoh. 19:36</ref>. </char></note><verse eid="PSA 34:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21" />Fuggo, fuggoxxa assaake manna shiltaan;</para>
  <para style="q2" vid="PSA 34:21">qulliyye gibaake manna'n murte uwwenda.<verse eid="PSA 34:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22" />Duuchchi Woddiki Gootti ifike erganjuwwixxa lubbo wodaan;</para>
  <para style="q2" vid="PSA 34:22">isoo gollake assedheekeeri'a murte uwwendabaan.<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="s1">Wixixxi Hiyyeeke Manjixxa Soodachcho</para>
  <para style="d">Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1" />Ee Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 35:1">Ane'n ke'a'neeke manna'n ati iso'n ke'i;</para>
  <para style="q2" vid="PSA 35:1">anee lola'neekaaranna ati isoo loli.<verse eid="PSA 35:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2" />Atixxa lumoxxanna shixxoxxa wonte abixite'e</para>
  <para style="q2" vid="PSA 35:2">anee gargaartota'a ke'i.<verse eid="PSA 35:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3" />Anee shora'neeke manna'n wolaantichcho atikanna bagedo atika qirqirsi;</para>
  <para style="q2" vid="PSA 35:3">lubbo anxanna, «Atik anjiralli anten» hiyyi.<verse eid="PSA 35:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4" />Anee shiyo'a halsa'neek duuchchi shooke salphatowwaal;</para>
  <para style="q2" vid="PSA 35:4">anee miidho'a mari'ataaki duuchchinna udumi'a hige'e salphatowwaal!<verse eid="PSA 35:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5" />Diidallo adhite me'itammake huurishsha kande'naa,</para>
  <para style="q2" vid="PSA 35:5">Duuchchi Woddike Goottik iimik erganj insa'nee shorrowwaal.<verse eid="PSA 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6" />Duuchchi Woddike Goottik iimik erganji insa'nee shorraa wodda</para>
  <para style="q2" vid="PSA 35:6">ori insa'nek dukkanatenna salqaake kadowwaal.<verse eid="PSA 35:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7" />Tola boddichcha ani'a fonxoro sho'ne fanneexxi,</para>
  <para style="q2" vid="PSA 35:7">tola boddichcha ani'a bale qonte'een.<verse eid="PSA 35:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8" />Keekantebaaxxi ba'ne insa'ne'n daggowwaal;</para>
  <para style="q2" vid="PSA 35:8">sho'neemmaxxi fonxoronna insa'nee abiddowwaal;</para>
  <para style="q2" vid="PSA 35:8">qonteemmanxe bale'n inbeexxi mundowwaal.<verse eid="PSA 35:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9" />Lubbo anxi Duuchchi Woddike Gootta'n gammaddaan;</para>
  <para style="q2" vid="PSA 35:9">isixxe anjira'ninna illillissaan.<verse eid="PSA 35:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10" />Anxi hedho duuchchi atee, «Ee Duuchchi Woddike Goottaa atishsha hedheek ayyete?</para>
  <para style="q2" vid="PSA 35:10">Balleesa gelteeka manjo isoo balleesammakeerinaa'n,</para>
  <para style="q2" vid="PSA 35:10">hiyyeessakanna miicemeemmaka saamaammakeerinaa'n gatisaak</para>
  <para style="q2" vid="PSA 35:10">atishsha hedheek ayyete?» hite.<verse eid="PSA 35:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11" />Dharik dhuga'a kulaak manni anee ku'le;</para>
  <para style="q2" vid="PSA 35:11">ille manshati afebenoxxa yaane anee qore.<verse eid="PSA 35:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12" />Elloxxixxa bado elobaaxxa ani'a hiissineexxi</para>
  <para style="q2" vid="PSA 35:12">qofi galeessake anee assine.<verse eid="PSA 35:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13" />Ani kinni insa'nee elagonphee wodda jooniyya seemma oddo'wenne;</para>
  <para style="q2" vid="PSA 35:13">agabo goddonna hosa'n ifinna heeshshi assenne;</para>
  <para style="q2" vid="PSA 35:13">soodachcho anxinna hiissichcho alfitebaang gatteen.<verse eid="PSA 35:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 35:14" />Anke jaali'a yookaan anke dayyi'a yaadannashsha</para>
  <para style="q2" vid="PSA 35:14">yaadenne;</para>
  <para style="q2" vid="PSA 35:14">ama ifixxee oodhammake manjishsha yaadoti umo hangulli asse'e oodhenne.<verse eid="PSA 35:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15" />Insa'ne kinni ani gugguffatenne wodda gammanda'n bukki hine;</para>
  <para style="q2" vid="PSA 35:15">gacifalleeyye dedhange ane'n bukki hiteexxi</para>
  <para style="q2" vid="PSA 35:15">cita belo anee niniffe.<verse eid="PSA 35:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16" />Insa'nee Mageni belo hedheeke mannishsha ane'ni qacifanite;</para>
  <para style="q2" vid="PSA 35:16">suumatanna ane'ni ga'me'ne.<verse eid="PSA 35:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17" />Ee Duuchchi Woddike Goottaa! Haani qico'n sammi uudatto?</para>
  <para style="q2" vid="PSA 35:17">Lubbo anxa miidhake mannannaa'n,</para>
  <para style="q2" vid="PSA 35:17">hedho anxa konne neenqinaa'n gatis.<verse eid="PSA 35:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18" />Tuutati giddo atee galateeffatannon;</para>
  <para style="q2" vid="PSA 35:18">Heddi ardi bukki hiyyeebanna atee saadannon.<verse eid="PSA 35:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19" />Tolanga ani'a naaphake kadeekiir meenni ane'ni gammadowwaal</para>
  <para style="q2" vid="PSA 35:19">iittanni anee gibaakiirinna meenni ane'n ille weli qiphowwaal.<note caller="-" style="x"><char style="xo" closed="false">35:19 </char><char style="xt" closed="false"><ref loc="PSA 69:4">Far. 69:4</ref>; <ref loc="JHN 15:25">Yoh. 15:25</ref>. </char></note><verse eid="PSA 35:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20" />Afo'o insa'neekenaa'n eloki haaso'i fulabaan;</para>
  <para style="q2" vid="PSA 35:20">bogake'n nage'ik hedheeke manna'n sobiinxa yaane mari'antaan.<verse eid="PSA 35:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21" />Haanni hine'e ane'n haasonna'n,</para>
  <para style="q2" vid="PSA 35:21">«Ee abboo! Ee abboo! Ille no'oxxenni assitteettexxa uundeennen» hine;<verse eid="PSA 35:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22" />Ee Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 35:22">Ati kinni tennee uudeeten, mee sammi hiyyi.</para>
  <para style="q1" vid="PSA 35:22">Ee dada duuchchike Goottaa! Anenaa'n bayyattoxxe'e.<verse eid="PSA 35:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23" />Anke Magenoo, anke dada duuchchike Goottaa!</para>
  <para style="q2" vid="PSA 35:23">Ani'a baassittotta'a ke'i! Ani'a murtotta'anna qophphi hiyyi.<verse eid="PSA 35:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24" />Ee Duuchchi Woddike Gootta anke Magenoo!</para>
  <para style="q2" vid="PSA 35:24">Atixxe qullummashshanni ani'a mur;</para>
  <para style="q2" vid="PSA 35:24">meenni insa'ne'e ane'ni gammandowwaal.<verse eid="PSA 35:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25" />Insa'ne godobi giddo, «Ee abboo! Hendennexxi kadde'een</para>
  <para style="q2" vid="PSA 35:25">isonna injiffanteennen» hinaashsha assitoxxe'e.<verse eid="PSA 35:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26" />Anxe rakko'n gammadaak duuchchi</para>
  <para style="q2" vid="PSA 35:26">salphatowwaal; shookkowwaal;</para>
  <para style="q2" vid="PSA 35:26">ane'n ifi dukaak duuchchi salphateexxi shooko oddo'wowwaal.<verse eid="PSA 35:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27" />Qullo fula anxa eeyaak duuchchi gammada'n illillisowwaal;</para>
  <para style="q2" vid="PSA 35:27">duuchchi woddanna, «Ifike Erganjixxi yaanexxa qaba eeyyaak Duuchchi Woddik Gootti lummedhuun» hiyyowwaal.<verse eid="PSA 35:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28" />Ank arabi atixxa qullumma,</para>
  <para style="q2" vid="PSA 35:28">saadinno atixxanna barra duuchcha haaso'aan.<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="s1">Cubbaaleeyyetixxa Fuggaalleessummanna Mageniinxe Elle</para>
  <para style="d">Faarsaleeyyetike Sooresi'a, Duuchchi Woddike Goottika Garbichcho, Daawwitixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 36:1" />Cubbichcha manjo cubbo, godobi giddo afe'eeka fuggichcha yaada caqasaashsha assitaan;</para>
  <para style="q2" vid="PSA 36:1">Magno soda'atinna isiba hexxebaan.<note caller="-" style="x"><char style="xo" closed="false">36:1 </char><char style="xt" closed="false"><ref loc="ROM 3:18">Rom. 3:18</ref>. </char></note><verse eid="PSA 36:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2" />Isi ifi yo'oshsha sobaammaxxee</para>
  <para style="q2" vid="PSA 36:2">balleessa ifixxa ege'ne'e, isee jibbabaan.<verse eid="PSA 36:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3" />Isike afo'inaa'n fulaak haaso'i fuggokenna dharaken;</para>
  <para style="q2" vid="PSA 36:3">qalbeeffachchotanna eloxxa assa waale'een.<verse eid="PSA 36:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4" />Isi ma'nanni hedhee'e fuggoxxa hedaan;</para>
  <para style="q2" vid="PSA 36:4">cubbotike ora'ninna me'aan;</para>
  <para style="q2" vid="PSA 36:4">elobaaxxenaa'n bayyatabaan.<verse eid="PSA 36:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5" />Ee, Duuchchi Woddike Goottaa, jaalala atixxi iimuwwate'n,</para>
  <para style="q2" vid="PSA 36:5">addatensha atixxinna iimatike duummanchi qico'n geltaan.<verse eid="PSA 36:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6" />Qullumma atixxi lumollamma koobuwwashsha</para>
  <para style="q2" vid="PSA 36:6">dhugaa mura atixxinna abbaayyatishsha dhi'moten;</para>
  <para style="q2" vid="PSA 36:6">Ee, Duuchchi Woddike Goottaa ati hore manjo biiniinchakenaa'ni ba'attatton.<verse eid="PSA 36:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7" />Ee, Magenoo! Atixxi jaalala hittatta manbe'iinxe;</para>
  <para style="q2" vid="PSA 36:7">manjiink belti duuchchi atike keelike gaaddisa'ni gollataan.<verse eid="PSA 36:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8" />Atike minnika corba insa'nee'e itissatton;</para>
  <para style="q2" vid="PSA 36:8">atixxe gammashshoke lagika wodde'enna insa'nee ha'wissatton.<verse eid="PSA 36:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9" />Hedhotixxi muumme atete kaddeettaaxxee</para>
  <para style="q2" vid="PSA 36:9">ifa atikenni ifa uundannon.<verse eid="PSA 36:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10" />Atee'e ege'neeke mannanaa'n jaalala atixxi,</para>
  <para style="q2" vid="PSA 36:10">godoba ba'lake manni'aanna qullumma atixxi qoottoqe'e.<verse eid="PSA 36:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11" />Hollaammeeyyetixxi lekka anee haxxaashsha,</para>
  <para style="q2" vid="PSA 36:11">Fuggaaleeyyetixxi anga anee shorritashsha assitoxxe'e.<verse eid="PSA 36:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12" />Fuggoxxa assaakiiri hitta ibeexxanna wabbi hiyyeexxa,</para>
  <para style="q2" vid="PSA 36:12">adadeenna darbeme'e ke'a dande'ebaa qico uudi.<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="s1">Muuxamake'n Qulliyyeteenna Cubbaaleeyyetee'e Uwwemaaka Qoobbo</para>
  <para style="d">Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1" />Fuggaleeyye uude'e bojogendoxxe'e;</para>
  <para style="q2" vid="PSA 37:1">cubbo hujaakaaranna gaabitoxxe'e.<verse eid="PSA 37:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2" />Insa'ne iikki woddi badda'atishsha bangaan;</para>
  <para style="q2" vid="PSA 37:2">qufeeke shafishshanna qooraan.<verse eid="PSA 37:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3" />Duuchchi Woddike Gootta'n addati; eloxxanna assi;</para>
  <para style="q2" vid="PSA 37:3">ookkone bogi giddo nage'ik offo'l.<verse eid="PSA 37:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4" />Duuchchi Woddike Gootta'ni gammadi;</para>
  <para style="q2" vid="PSA 37:4">Isinna atike godobixxa halcha ati'a uwwaan.<verse eid="PSA 37:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5" />Ora atika Duuchchi Woddike Gootta'n maganne uwwedhi</para>
  <para style="q2" vid="PSA 37:5">iso'ninna addati; isinna ati'a qajeelchaan.<verse eid="PSA 37:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6" />Isi qullumma atixxa ifiinsha</para>
  <para style="q2" vid="PSA 37:6">dhugaaleessumma atixxanna saafo'iinxe arshoshsha xassaan.<verse eid="PSA 37:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7" />Duuchchi Woddike Gootti edo sammi hite'e</para>
  <para style="q2" vid="PSA 37:7">ossati isoo heqqedhi;</para>
  <para style="q2" vid="PSA 37:7">ori isi'a qajeeleeke</para>
  <para style="q2" vid="PSA 37:7">fuggoxxa assaake manjixxee bojogendoxxe'e.<verse eid="PSA 37:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8" />Mufetenaa'n ifi heqedhi; aaretanna waal;</para>
  <para style="q2" vid="PSA 37:8">bojogema fuggoxxa assate'ni atee geessissaan, bojogendoxxe'e.<verse eid="PSA 37:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9" />Fuggaaleessi manni ba'a ba'aan;</para>
  <para style="q2" vid="PSA 37:9">Duuchchi Woddika Gootta'n addataak kinni boga dhaalaan.<verse eid="PSA 37:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10" />Heenooxxe yanna'aate malee'e fuggichchi manji hedhabaan;</para>
  <para style="q2" vid="PSA 37:10">isoo hassetelenna midde bakka isixxa afabbexxon.<verse eid="PSA 37:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11" />Shaqqak manni kinni boga dhaalaan,</para>
  <para style="q2" vid="PSA 37:11">wo'ma nage'i giddonna gammanda'nee he'naan.<note caller="-" style="x"><char style="xo" closed="false">37:11 </char><char style="xt" closed="false"><ref loc="MAT 5:5">Mat. 5:5</ref>. </char></note><verse eid="PSA 37:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12" />Fuggaaleessi manji qajeela manjo balleesatee malaan;</para>
  <para style="q2" vid="PSA 37:12">suumettanna insa'ne'n ga'medhaan.<verse eid="PSA 37:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13" />Dada duuchchik Duuchchi Woddik Gootti kinni</para>
  <para style="q2" vid="PSA 37:13">barra insa'nexxi sheqqeemmaxxa ege'neemmaxxe insa'ne'n oso'laan.<verse eid="PSA 37:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14" />Hiyyeeyyetanna rakkiyye shiyyatee,</para>
  <para style="q2" vid="PSA 37:14">ba'lake godobika mannanna gorra'atee</para>
  <para style="q2" vid="PSA 37:14">fuggaaleessi manni wolaantichcha ifika luqisaan; gabe ifixxanna qophpheessedhaan.<verse eid="PSA 37:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15" />Yanne kinni wolaatichchi insa'nek godoba insa'nenga otaan;</para>
  <para style="q2" vid="PSA 37:15">insa'nexxi gabenna enqendaan.<verse eid="PSA 37:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16" />Shiixxoxxi qullichchiinxi karra</para>
  <para style="q2" vid="PSA 37:16">lumoxxa fuggaaleeyyetixxa karra saxxaan.<verse eid="PSA 37:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17" />Fuggaaleeyyetixxi hirre enqema enqendaan;</para>
  <para style="q2" vid="PSA 37:17">qulliyye kinni Duuchchi Woddik Gootti kiphee abidaan.<verse eid="PSA 37:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18" />Duuchchi Woddik Gootti barra barra'n insa'nee heqqaan;</para>
  <para style="q2" vid="PSA 37:18">insa'ne'a uwwendeexxi uwwanna duuchchi woddi'aten.<verse eid="PSA 37:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19" />Fuggoxxe yanna giddonna shoonkabaan;</para>
  <para style="q2" vid="PSA 37:19">solo'iinke baro'ninna goddinaan.<verse eid="PSA 37:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20" />Fuggaaleeyye kinni ba'aa baxxaan;</para>
  <para style="q2" vid="PSA 37:20">Duuchchi Woddike Goottik naaphi bada'atixxe danchummashshaa ba'aan;</para>
  <para style="q2" vid="PSA 37:20">wiliilletishshanna gophemaan.<verse eid="PSA 37:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21" />Fuggichchi manji liqeefataan; hiissenna uwwaba'a;</para>
  <para style="q2" vid="PSA 37:21">qullichchi manji kinni ba'lumati hiissee uwwaan.<verse eid="PSA 37:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22" />Duuchchi Woddik Gootti eebbiseek manni boga dhaalaan;</para>
  <para style="q2" vid="PSA 37:22">isi yowweeki kinni ba'aan.<verse eid="PSA 37:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23" />Manjiinxi me'aa Duuchchi Woddika Gootta gammachchiisoole,</para>
  <para style="q2" vid="PSA 37:23">Duuchchi woddik Gootti ora isi'aa qajeelche'e tarkaaffe isixxa jabeesaan.<verse eid="PSA 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24" />Duuchchi Woddiki Gootti anga ifixxenni iso'o kiphaammaxxee'e,</para>
  <para style="q2" vid="PSA 37:24">gugguffatoolenna ibabaan.<verse eid="PSA 37:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25" />Ani dargageessummate'ni;</para>
  <para style="q2" vid="PSA 37:25">ta'anna cimo giddo,</para>
  <para style="q2" vid="PSA 37:25">qulliyye hunnendee'naa;</para>
  <para style="q1" vid="PSA 37:25">Oose insa'nexxinna ittaachcho gophpheexxi kadhata'naa haranga uude ege'nebe'no.<verse eid="PSA 37:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26" />Isi duuchchi wodda ba'lataan, liqeessaan;</para>
  <para style="q2" vid="PSA 37:26">horte isixxinna welekee eebbate kaddaan.<verse eid="PSA 37:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27" />Fuggoxxenaa'n bayyati; eloxxanna assi;</para>
  <para style="q2" vid="PSA 37:27">qeeraka barronna hexxatton.<verse eid="PSA 37:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28" />Duuchchi Woddik Gootti dhugaatixxa murte eeyyaan;</para>
  <para style="q2" vid="PSA 37:28">ifika addatemalluwwanna waalabaan;</para>
  <para style="q2" vid="PSA 37:28">duuchchi woddi'anna insa'nee heqqaan;</para>
  <para style="q2" vid="PSA 37:28">fuggaaleeyyetixxi horte kinni baxxaan.<verse eid="PSA 37:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29" />Qulliyye boga dhaaldaan;</para>
  <para style="q2" vid="PSA 37:29">qeeraka barronna ookko hexxaan.<verse eid="PSA 37:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30" />Qulichchi manjik afo'i beekumik haaso'aan;</para>
  <para style="q2" vid="PSA 37:30">arabo isikenaa'ni dhugaatixxe yaane fuldaan.<verse eid="PSA 37:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31" />Ifike Mageniki seeri qalbe isixxe'ni hedheen;</para>
  <para style="q2" vid="PSA 37:31">lekka isixxinna titimmissabaan.<verse eid="PSA 37:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32" />Fuggaaleessi manji qullichcha gaadaan;</para>
  <para style="q2" vid="PSA 37:32">isoo shiyyo'anna hasaan.<verse eid="PSA 37:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33" />Duuchchi Woddik Gootti kinni isoo naaphiinxe anga'ni sa'issabaan;</para>
  <para style="q2" vid="PSA 37:33">songote'n shiqaa woddanna murte iso'n murendo'a waalabaan.<verse eid="PSA 37:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34" />Duuchchi Woddika Gootta addatte heqqedhi;</para>
  <para style="q2" vid="PSA 37:34">ajaja isikanna muuxi;</para>
  <para style="q2" vid="PSA 37:34">isi ookkone boga dhaaldotaa atee ulfeessaan;</para>
  <para style="q2" vid="PSA 37:34">fuggaaleyyetinna baxxaa'naa uuddatton.<verse eid="PSA 37:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35" />Fuggichchikinna mararte afebaak manji,</para>
  <para style="q2" vid="PSA 37:35">Libaanosike biribisishsha bankaraarree'naa uudenne.<verse eid="PSA 37:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36" />Yaane kinni illee iima higee ookko'ni sa'enne wodda bakka eettene'n hedhemmaba'a;</para>
  <para style="q2" vid="PSA 37:36">hasenne woddanna afemeba'a.<verse eid="PSA 37:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37" />Qullichcha manjo hubatte uudi; godoba ba'laka manjonna qalbeeffati;</para>
  <para style="q2" vid="PSA 37:37">nageelchi manjixxi hegeree baxxabaan.<verse eid="PSA 37:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38" />Cubbaaleeyye kinni mittenba baxxaan;</para>
  <para style="q2" vid="PSA 37:38">hegeree insa'neexxinna shakki hitaan.<verse eid="PSA 37:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39" />Qulliyyetee anjirensha Duuchchi Woddik Gootti darre'nten;</para>
  <para style="q2" vid="PSA 37:39">rakkoti woddanna golli insa'neek isoten.<verse eid="PSA 37:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40" />Duuchchi Woddik Gootti insa'nee gargaraan; insa'nee wodaan;</para>
  <para style="q2" vid="PSA 37:40">fuggaaleeyyetixxe anganaa'ninna insa'nee mucuqe fulchaan; insa'ne isoo gollake asse'neemmaxxee'e insa'nee'e anjiraan.<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="s1">Abarii Woddixxa Sooddachcho</para>
  <para style="d">Mageni isoo'o qaabbato'a Faarsendeexxa Daawwitixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 38:1" />Ee, Duuchchi Woddike Goottaa! Mufeti anee gandoxxe'e;</para>
  <para style="q2" vid="PSA 38:1">aaretinna anee'e mura woxissoxxee.<verse eid="PSA 38:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2" />Mogiduwwi atiki anee'e ote'een;</para>
  <para style="q2" vid="PSA 38:2">anga atixxinna butti'a anee qe'wisse'een.<verse eid="PSA 38:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3" />Atixxe aarenaa'n kexxeexxa bisi anki fayya afebaan;</para>
  <para style="q2" vid="PSA 38:3">anxe cubbonaa'n kexxeexxenninna micci mikiti ank duuchchi nage'a gopheen.<verse eid="PSA 38:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4" />Cubbo anxi umo anki iimi darre saxxe'een;</para>
  <para style="q2" vid="PSA 38:4">ba'edha dande'abe'noxxe ba'oshshanna ane'n a'urte'een.<verse eid="PSA 38:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5" />Gowwumma anxenaa'n kexxeexxa</para>
  <para style="q2" vid="PSA 38:5">anxi mada foole gande, malootte.<verse eid="PSA 38:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6" />Hangulli hiyyenne; heeshshi hiyya'ninna me'enne;</para>
  <para style="q2" vid="PSA 38:6">barra duuchchanna oodhenne.<verse eid="PSA 38:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7" />Hidhi anee'e giiratishsha gube;</para>
  <para style="q2" vid="PSA 38:7">bisi ank duuchchinna fayya gophe.<verse eid="PSA 38:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8" />Hunna afebe'no; hara kurbu hiyyenne;</para>
  <para style="q2" vid="PSA 38:8">anke godobixee daaqanaa'n kexxeexxa aada'enne.<verse eid="PSA 38:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9" />Ee, Duuchchi Woddike Goottaa! Halcha anxi duuchcha ati edo barrate;</para>
  <para style="q2" vid="PSA 38:9">aadino anxinna atenaa'n sho'ondeexxebaan.<verse eid="PSA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10" />Laphphe anixi yo'oshsha ga'nite;</para>
  <para style="q2" vid="PSA 38:10">hunnatinna ane'n hexxeba'a;</para>
  <para style="q2" vid="PSA 38:10">ille anxinna afa gophe.<verse eid="PSA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11" />Dhibo anxenaa'n kexxeexxa jaaluwwi ankinna firi anee maaxate;</para>
  <para style="q2" vid="PSA 38:11">olla'uwwi ankinna anenaa'n bayyate.<verse eid="PSA 38:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12" />Hedho anxa balleesso'a halcha'emmakiir fonxoro ani'a faye;</para>
  <para style="q2" vid="PSA 38:12">anee'e miidho'a hede'emmakiirinna anee'e balleesso'a haaso'e;</para>
  <para style="q2" vid="PSA 38:12">barra duuchchanna insa'ne sobiinxa yaane ani'a mari'antaan.<verse eid="PSA 38:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13" />Ani kinni mansha duuda manjishsha laqabe'no;</para>
  <para style="q2" vid="PSA 38:13">afo'okanna duudee manjishsha haaso'abe'no.<verse eid="PSA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14" />Dhugaanden, ani mansha laqabake duuda</para>
  <para style="q2" vid="PSA 38:14">dande'enna haaso'eexxi hiissichcho uwwabaake manjo kadenne.<verse eid="PSA 38:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15" />Ee, Duuchchike Goottaa! Ani atete addatee heqedhannen.</para>
  <para style="q2" vid="PSA 38:15">Ee, Dada Duuchchike Duuchchi Woddike Gootta anke Magenoo! Ati hiissichcho ani'a uuttatton.<verse eid="PSA 38:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16" />Ani «Naaphi ane'n mee gammadowwaal;</para>
  <para style="q2" vid="PSA 38:16">lekka anxi salaqqee'naa'a mee anee ooso'laashsha assi» hiyyeennan.<verse eid="PSA 38:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17" />Ani'a iba malee maa gate?</para>
  <para style="q2" vid="PSA 38:17">Elaa gonphetinna anee haranga wocci assitebaan.<verse eid="PSA 38:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18" />Ballessa anxee aadde aaggannon;</para>
  <para style="q2" vid="PSA 38:18">cubbo huja anxeenna yaade'enne.<verse eid="PSA 38:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19" />Jajjabbi anki naaphi heddoke;</para>
  <para style="q2" vid="PSA 38:19">tolanga anee giba'neekiirinna birasa'eeke.<verse eid="PSA 38:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20" />Eloxxa assennaxxa bado ani'a elobaaxxa assinaan;</para>
  <para style="q2" vid="PSA 38:20">eloxxe'n me'anno wodda anee'e garreeraan.<verse eid="PSA 38:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21" />Ee, Duuchchi Woddike Goottaa! Anee waaldoxxe'e;</para>
  <para style="q2" vid="PSA 38:21">Ee, anke Magenoo! Anenaa'n bayyattoxxe'e.<verse eid="PSA 38:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22" />Ee, Dada Duuchchike Gootta, anke anjiraloo!</para>
  <para style="q2" vid="PSA 38:22">Rakke'e anee gargaari.<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="s1">Manjiinxi Hedho Harumaaxxen</para>
  <para style="d">Faarsaleeyyetike Sooresi'a, Edotaami'a, Daawwitixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 39:1" />Ani «Arabbo ankenni cubbo haaso'abe'noshsha</para>
  <para style="q2" vid="PSA 39:1">ora anka heqqedhanno;</para>
  <para style="q2" vid="PSA 39:1">fuggaaleessi manninna ani bira hedhee qico'ni</para>
  <para style="q2" vid="PSA 39:1">afo'o ankanna bixaa'lanno» hiyyenne.<verse eid="PSA 39:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2" />Afo'o duudee manjishsha sammi hiyyenne;</para>
  <para style="q2" vid="PSA 39:2">eloka haaso'anna midde haase'ebe'no;</para>
  <para style="q2" vid="PSA 39:2">kaddo malee abari ane'n bira sa'a'n me'e.<verse eid="PSA 39:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3" />Godobi anee gubatte;</para>
  <para style="q2" vid="PSA 39:3">hede herganno woddanna giiratinna ani giddo talli hite;</para>
  <para style="q2" vid="PSA 39:3">ookkoneechchi uduma haaso'a safenne.<verse eid="PSA 39:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4" />«Ee, Duuchchi Woddike Goottaa! Anxe Hedhoka muuxama, anke barrika laakkossanna ane'n ege'nishshi;</para>
  <para style="q2" vid="PSA 39:4">bari ankinna rake'e sa'aneeke kadeexxa ege'no.<verse eid="PSA 39:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5" />Kunse, baro anka taakkoti qicike assittette;</para>
  <para style="q2" vid="PSA 39:5">wogga anxinna ati edo maachchonnabaan;</para>
  <para style="q2" vid="PSA 39:5">dhugaaten, manji duuchchixxi hedho shuu hite'e saxxaammaxxe diidallon.<verse eid="PSA 39:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6" />Dhugaaten, manjii gaaddidotishsha sa'aan;</para>
  <para style="q2" vid="PSA 39:6">tolange elo'aan;</para>
  <para style="q2" vid="PSA 39:6">ayyi'aa kaddaaxxa afebaang karra tuulaan.<verse eid="PSA 39:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7" />«Ee, Dada Duuchchike Goottaa! Ta'ata ayyete uuxxedhanno?</para>
  <para style="q2" vid="PSA 39:7">Adde anxi ate'nten.<verse eid="PSA 39:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8" />Cubbo anxe duuchchanaa'n anee anjir;</para>
  <para style="q2" vid="PSA 39:8">gowwooletixxe gacifachchoke anee assitoxxe'e.<verse eid="PSA 39:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9" />Iitta rakkatannoshshaa assittettek atete kaddeetaxxee'e,</para>
  <para style="q2" vid="PSA 39:9">sammi hiyyannon;</para>
  <para style="q2" vid="PSA 39:9">mittelchonna haaso'abe'no.<verse eid="PSA 39:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10" />Gane atixxi anee miitee'e shaqqishshe'een</para>
  <para style="q2" vid="PSA 39:10">anga atixxa anenaa'n hoyyedhi.<verse eid="PSA 39:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11" />Manjo hujeexxe cubboxxee mura woxisee'e xixxatton;</para>
  <para style="q2" vid="PSA 39:11">karra isixxanna ooloti itemaachcho assittatton;</para>
  <para style="q2" vid="PSA 39:11">dhugaaten, manji duuchchi shuu hitaammaxxe diidalloxxen.<verse eid="PSA 39:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12" />«Ee, Duuchchi Woddike Goottaa! Soodachcho anxa laqi;</para>
  <para style="q2" vid="PSA 39:12">oodhishsha anxa caqasi;</para>
  <para style="q2" vid="PSA 39:12">indiddo anxanna uuda gibbexxe'e;</para>
  <para style="q2" vid="PSA 39:12">ani ati edo keessummaten;</para>
  <para style="q2" vid="PSA 39:12">edike anke annuwwishshanna orimaroken.<verse eid="PSA 39:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13" />Illee iima higabe'nobaa reyennexxi me'ebe'no edi darre</para>
  <para style="q2" vid="PSA 39:13">higgeenni gammadonna'a ille atixxa anenaa'ni hoyyedhi.»<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="s1">Gargaarsiinxa Sooddachcho</para>
  <para style="d">Faarsaleeyyetike Sooresi'a Daawwitixxa Faaro.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1" />Ani osse'e Duuchchi Woddika Gootta heeqqedhenne;</para>
  <para style="q2" vid="PSA 40:1">isinna anbaa wirri hiyye'e oodhishsha anxanna laqe.<verse eid="PSA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2" />Caffa'atixxe balenaa'n,</para>
  <para style="q2" vid="PSA 40:2">dhoqetike salaqanaa'n anee fulche;</para>
  <para style="q2" vid="PSA 40:2">lekka anxanna rassati hana uurrise;</para>
  <para style="q2" vid="PSA 40:2">me'aa anxanna jabeese.<verse eid="PSA 40:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3" />No'oke Mageni'a kaddaaxxa saadino,</para>
  <para style="q2" vid="PSA 40:3">haaroxxa faaro afo'o anke'n ugge;</para>
  <para style="q2" vid="PSA 40:3">heddi manninna isoo uude'e sodaateexxi Duuchchi Woddike Gootta'ni addataan.<verse eid="PSA 40:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4" />Duuchchi Woddika Gootta addataake,</para>
  <para style="q2" vid="PSA 40:4">ifi dukaaka manna addatabaake,</para>
  <para style="q2" vid="PSA 40:4">dharichchi manniba'a higati insa'nee hordofabaake</para>
  <para style="q2" vid="PSA 40:4">manjixxa wodo.<verse eid="PSA 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5" />Ee, Duuchchi Woddike Gootta anke Magenoo!</para>
  <para style="q2" vid="PSA 40:5">Ati no'aa assite'eettexxi mambe'aa yaanuwwa heddoten;</para>
  <para style="q2" vid="PSA 40:5">ati no'aa heddeetteexxaara dande'e laakko'aak ayyinna hedhebaan;</para>
  <para style="q2" vid="PSA 40:5">haaso'anno, kulannon hiyyeennele bira saxxaan.<verse eid="PSA 40:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6" />Ati tolchakanna uwwa hassebexxo;</para>
  <para style="q2" vid="PSA 40:6">kinni mansha anxa bandette;</para>
  <para style="q2" vid="PSA 40:6">ciincatika tolcha, cubbo biratika tolchanna eetebexxo.<note caller="-" style="x"><char style="xo" closed="false">40:6 </char><char style="xt" closed="false"><ref loc="HEB 10:5-7">Ibr. 10:5-7</ref>. </char></note><verse eid="PSA 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7" />Tennexxee aninna, «Kunse ani dage'eennen,</para>
  <para style="q2" vid="PSA 40:7">anxee'e maxaafi giddo borreessende'een.<verse eid="PSA 40:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8" />Ee, anke Magenoo! Fedhi atixxa muuxonna'a eeyyaannen;</para>
  <para style="q2" vid="PSA 40:8">seeri atikinna anke godobi giddo hedheen» hiyyenne.<verse eid="PSA 40:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9" />Ani lumoxxe bukki giddo qullumma atixxa haaso'enne;</para>
  <para style="q2" vid="PSA 40:9">Ee, Duuchchi Woddike Goottaa, ati egendetteshshanni afo'i anki sammi hiyyabaan.<verse eid="PSA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10" />Qullumma atixxa anke godobi giddo sho'e walabe'non;</para>
  <para style="q2" vid="PSA 40:10">addateemmallumma atixxanna anjira atixxa haaso'annon;</para>
  <para style="q1" vid="PSA 40:10">jaalala atixxanna dhugaa atixxa lumoxxe bukki'n sho'ebe'non.<verse eid="PSA 40:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11" />Ee, Duuchchi Woddike Goottaa! Mararte atixxa anenaa'n uurrisoxxe'e;</para>
  <para style="q2" vid="PSA 40:11">jaalala atixxinna dhugaa atixxi duuchchi wodda anee heqqittowwaal.<verse eid="PSA 40:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12" />Laakko'a dhaqqassiissabaaxxi fuggo anee buqqe'een;</para>
  <para style="q2" vid="PSA 40:12">cubbo anxiir ane'ni daldeemmaxxee afa dande'abe'no;</para>
  <para style="q2" vid="PSA 40:12">anke umike ordichchi caalanna bira saxxe'een,</para>
  <para style="q1" vid="PSA 40:12">Godobikinna anee hophphole.<verse eid="PSA 40:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 40:13" />Ee, Duuchchi Woddike Goottaa! Anee anjirtotta'a fedhi atixxe kaddowwaal;</para>
  <para style="q2" vid="PSA 40:13">Ee, Duuchchi Woddike Goottaa! Rakke'e anee gargaar.<verse eid="PSA 40:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14" />Lubbo anxa shiyo'a hasaak duuchchi salphatowwaal; shookowwaal;</para>
  <para style="q2" vid="PSA 40:14">miidhensha anxa eeyaak duuchchinna salphate'e udumi'a higowwaal.<verse eid="PSA 40:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15" />Anxe iba'ni «Hashshuu! Hashshu» hiyyaakiir</para>
  <para style="q2" vid="PSA 40:15">ifinge umike salphinninni shookowwaal.<verse eid="PSA 40:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16" />Atee halsak duuchchi kinni illillisowwaal;</para>
  <para style="q2" vid="PSA 40:16">ate'ninna gammadowwaal;</para>
  <para style="q2" vid="PSA 40:16">duuchchi wodda atixxa anjirema eeyaakiir «Duuchchi Woddik Gootti saademuun» hiyyowwaal.<verse eid="PSA 40:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17" />Ani kinni hiyyeessakenna rakkichchaken;</para>
  <para style="q2" vid="PSA 40:17">Dada Duuchchik Gootti kinni ani'a hedaan;</para>
  <para style="q2" vid="PSA 40:17">ati anke gargarsanjonna anke anjirallon;</para>
  <para style="q2" vid="PSA 40:17">Ee, anke Magenoo! Turtoxxe'ee.<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="s1">Elagonpheti Woddixxa Soodachcho</para>
  <para style="d">Faarsaleeyetike Sooresi'a Daawwitixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 41:1" />Hiyyeeyyetee'e hedaake manjixxa wodo;</para>
  <para style="q2" vid="PSA 41:1">rakko dagaa woddanna Duuchchi Woddik Gootti isoo fulchaan.<verse eid="PSA 41:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2" />Duuchchi Woddik Gootti isoo heqaan; hedhotinna isoo uggaan;</para>
  <para style="q2" vid="PSA 41:2">bogi giddonna isoo eebisaan;</para>
  <para style="q2" vid="PSA 41:2">isike naaphixxe halcha'aanna isoo sa'isse uwwabaan.<verse eid="PSA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3" />Elagophe'e diipheexxe taqe hana Duuchchi Woddik Gootti isoo gargaaraan;</para>
  <para style="q2" vid="PSA 41:3">fayyiseexxe dhibotixxe taqena'ninna isoo ke'issaan.<verse eid="PSA 41:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4" />Aninna, «Ee, Duuchchi Woddike Goottaa! Ani'a o'wi;</para>
  <para style="q2" vid="PSA 41:4">atee'e balleesseennen anee fayyisi» hiyyenne.<verse eid="PSA 41:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5" />Naaphi anki elobaaxxa ani'a haaso'a'ni,</para>
  <para style="q2" vid="PSA 41:5">«Isi haano reya? Summi isikinna haano dedhema?» hiyyaan.<verse eid="PSA 41:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6" />Anee'e laqo'a dagaakiir</para>
  <para style="q2" vid="PSA 41:6">godobi giddo fuggoxxa ca'ma'ni sobee'e aninni haaso'aan;</para>
  <para style="q2" vid="PSA 41:6">fule me'enna iseenni odeessa.<verse eid="PSA 41:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7" />Naaphi anki duuchchi mitteba anxee weli hashashaan;</para>
  <para style="q2" vid="PSA 41:7">ani'aanna elobaaxxa heda'ni hiyyaa qici,<verse eid="PSA 41:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8" />«Fuggoke dhukuba isoo abide'een;</para>
  <para style="q2" vid="PSA 41:8">yoona diiphebaa'ni higge ke'abaan.»<verse eid="PSA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9" />Aninni ite'eek,</para>
  <para style="q2" vid="PSA 41:9">addata'eneek lubbotik ank jaali midde</para>
  <para style="q2" vid="PSA 41:9">ane'ni naaphake kadee ke'een.<note caller="-" style="x"><char style="xo" closed="false">41:9 </char><char style="xt" closed="false"><ref loc="MAT 26:23">Mat. 26:23</ref>; <ref loc="MRK 14:18">Mar. 14:18</ref>; <ref loc="LUK 22:21">Luq. 22:21</ref>; <ref loc="JHN 13:18">Yoh. 13:18</ref>. </char></note><verse eid="PSA 41:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10" />Ee, Duuchchi Woddike Goottaa! Ati kinni ani'a marar;</para>
  <para style="q2" vid="PSA 41:10">anke naapha'ninna bado hiisedhonna'a dhibetenaa'ni anee ke'issi.<verse eid="PSA 41:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11" />Naaphi ane'ni geerarebaan,</para>
  <para style="q2" vid="PSA 41:11">anee eettettexxa tenne'n ege'nenne.<verse eid="PSA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12" />Balleessa afa gopheennaxxee kiphphe anee abide'eeten;</para>
  <para style="q2" vid="PSA 41:12">ati eddonna duuchchi woddi'a hedhissatton.<verse eid="PSA 41:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13" />Isira'eelik Mageni Duuchchi Woddik Gootti</para>
  <para style="q2" vid="PSA 41:13">duuchchi woddanaa'n duuchchi woddi'a saademowwaal.<note caller="-" style="x"><char style="xo" closed="false">41:13 </char><char style="xt" closed="false"><ref loc="PSA 106:48">Far. 106:48</ref>. </char></note></para>
  <para style="qc" vid="PSA 41:13">Hamiin! Hamiin!<verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="ms">Langaka Maxaafa</para>
  <para style="mr">
    <ref loc="PSA 42-72">Far. 42—72</ref></para>
  <para style="d">Boji'emeeke Manjixxa Soodachcho</para>
  <para style="q1">Faarsaleeyyetike Sooresi'aa Qorexxe Hortexxa Gence</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1" />Gadansii muummeti wode'e ha'wo'a halchammashsha</para>
  <para style="q2" vid="PSA 42:1">Ee, Magenoo lubbo anxinna atee iittanni halchitaan.<verse eid="PSA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2" />Lubbo anxinna Mageno, hedhaaka Mageno dhebo'wite;</para>
  <para style="q2" vid="PSA 42:2">alba atika uudonna'a atibaa dagannok haanotetaa?<verse eid="PSA 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3" />Manji anee'e barra duuchcha</para>
  <para style="q2" vid="PSA 42:3">«Mageni atik haba hedhe?» hiyya'n qoraaxxe yanna duuchcha'n</para>
  <para style="q2" vid="PSA 42:3">anxi indiddo ani'a hashsha barra hitate kadde.<verse eid="PSA 42:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4" />Lubbo anxi ani giddo cingitanaa'a hedaannaxxi yaanuwwaari,</para>
  <para style="q2" vid="PSA 42:4">ayyaneefata'neeka arda Mageniinke minibaa akeeka'n,</para>
  <para style="q2" vid="PSA 42:4">tuutati welti</para>
  <para style="q2" vid="PSA 42:4">illilleetetinna galatiinxe faaronni,</para>
  <para style="q2" vid="PSA 42:4">ardik welti hitta me'aannaxxa qalli hiyyenne.<verse eid="PSA 42:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5" />Tee anxe lubboo mayyee yaaddatto?</para>
  <para style="q2" vid="PSA 42:5">Mayeeteta ani giddo weekendaatechchi?</para>
  <para style="q2" vid="PSA 42:5">Magenonga heqedhi;</para>
  <para style="q2" vid="PSA 42:5">anjirallo ankanna Mageno anka ani higee galateefatannon.<verse eid="PSA 42:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6" />Lubbo anxi ani giddo weekende'een;</para>
  <para style="q2" vid="PSA 42:6">tennexxe'e Yordaanoosike boga'ni</para>
  <para style="q2" vid="PSA 42:6">Herimoonixxe tullo'ni</para>
  <para style="q2" vid="PSA 42:6">Mizaarixxe koobanaa'n atee qaabbatannon.<verse eid="PSA 42:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7" />Atixxe gootoki luulji,</para>
  <para style="q2" vid="PSA 42:7">mitte dhi'mo mitteyexxaan;</para>
  <para style="q2" vid="PSA 42:7">danbala'iinxi ganeshsha duuchcha,</para>
  <para style="q2" vid="PSA 42:7">ani ha'nii'ni yaa'e.<verse eid="PSA 42:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8" />Duuchchi Woddik Gootti jaalala ifixxa barra ajajaan;</para>
  <para style="q2" vid="PSA 42:8">hashshanna faaro isi'a faarsannon;</para>
  <para style="q1" vid="PSA 42:8">tinninna anxe hedhoxxe Mageniba'a shiqishaannexxe soodachchon.<verse eid="PSA 42:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9" />Magenoo anxa rassaa,</para>
  <para style="q2" vid="PSA 42:9">«Mayee'e anee deetette?</para>
  <para style="q1" vid="PSA 42:9">Naaphi anee miica'naa</para>
  <para style="q2" vid="PSA 42:9">mayee yaada'n me'anno?» hiyyenne.<verse eid="PSA 42:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10" />Ank naaphi barra duuchcha «Mageni atik haba hedhe?» hiyya'ni</para>
  <para style="q2" vid="PSA 42:10">anee yowwati micco anka enqe.<verse eid="PSA 42:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11" />Tee anxe lubboo mayyee'e yaaddatto?</para>
  <para style="q2" vid="PSA 42:11">Mayeeteta ani giddo weekendaatechchi?</para>
  <para style="q2" vid="PSA 42:11">Magenonga heqqedhi;</para>
  <para style="q2" vid="PSA 42:11">anjirallo ankanna Mageno anka ani higee'e saadannon.<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="s1">Booji'emeeke Manjixxa Soodachcho</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1" />Ee, Magenoo! Ati ani'aa muri;</para>
  <para style="q2" vid="PSA 43:1">atee addatabaake ardi edo ani'a baasi;</para>
  <para style="q2" vid="PSA 43:1">sobaaleeyyetenaa'ninna fuggaleeyyetenaa'n anee fulchi.<verse eid="PSA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2" />Magenoo! Ati ani itti gollatannoxxe anxe jabaxxe kollon</para>
  <para style="q2" vid="PSA 43:2">mayee'e anee waaldete?</para>
  <para style="q2" vid="PSA 43:2">Naaphi anee rakkisaa'naa mayeete yaada'ni hedhaannek?<verse eid="PSA 43:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3" />Anee akeekkuun</para>
  <para style="q2" vid="PSA 43:3">atixxe woyyite koobaba'a, ati hexxatoke galmiba'a anee geessissuun,</para>
  <para style="q2" vid="PSA 43:3">Ifa atikanna dhugaa atixxa ergi.<verse eid="PSA 43:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4" />Aninna Mageniinke tolchi boonchibaa</para>
  <para style="q2" vid="PSA 43:4">ani'a gammashsho uwwaake Magenibaa me'annon;</para>
  <para style="q2" vid="PSA 43:4">Ee, Magenoo, anke Magenoo atee bagana gana'ni saadannon.<verse eid="PSA 43:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5" />Tee anxe lubboo mayee yaaddatto?</para>
  <para style="q2" vid="PSA 43:5">Mayeeteta ani giddo weekendaatechchi?</para>
  <para style="q2" vid="PSA 43:5">Magenonga heqqedhi;</para>
  <para style="q2" vid="PSA 43:5">anjirallo ankanna Mageno anka ani higee saadannon.<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="s1">Gargaarsiinxa Soodachcho</para>
  <para style="d">Faarsaleeyyetike Sooresi'a Qorexxe Hortexxa Gence.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 44:1" />Ee, Magenoo! No'ok edik annuwwi</para>
  <para style="q2" vid="PSA 44:1">qara insa'neke barro'n</para>
  <para style="q1" vid="PSA 44:1">Ati assittettexxa no'o'ni kulee'naa</para>
  <para style="q2" vid="PSA 44:1">mansha no'oxxenni lanqe'eennen.<verse eid="PSA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2" />Gosa gosaka arda anga atixxenni shorrite'e</para>
  <para style="q2" vid="PSA 44:2">annuwwwa no'oka kaassette;</para>
  <para style="q2" vid="PSA 44:2">wele gosaka arda balleessitete'e</para>
  <para style="q2" vid="PSA 44:2">anuuwwa no'oka kinni ba'lissette.<verse eid="PSA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3" />Insa'nee boga adhdhineemmak ifike wolaatichchinniteemmabaan;</para>
  <para style="q2" vid="PSA 44:3">injifanteemmakinna ifixxe hirrenniteemmabaan;</para>
  <para style="q1" vid="PSA 44:3">Ati insa'nee eettettaxxee'e atixxi middixxi anga,</para>
  <para style="q2" vid="PSA 44:3">atixxi hirrenna atike albik ifi tennee asseen.<verse eid="PSA 44:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4" />Mageno ati anke moyanjon;</para>
  <para style="q2" vid="PSA 44:4">Ya'iqoobixxi horte injifataashsha murtetek ateten.<verse eid="PSA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5" />Atixxe hunnanni no'ok naapha dageemmaba'a higaashsha assinnannon;</para>
  <para style="q2" vid="PSA 44:5">atike summinni diina no'o'ni ke'eekanna hirbeessinnannon.<verse eid="PSA 44:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6" />Ani gabe anxe'n addatabe'no;</para>
  <para style="q2" vid="PSA 44:6">wolaatichchi ankinna anee anjirabaan.<verse eid="PSA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7" />Ati kinni no'oke naaphinaa'n no'oo anjirtatton;</para>
  <para style="q2" vid="PSA 44:7">no'oo gibammakaaranna shookkishshaton.<verse eid="PSA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8" />Barra duuchcha no'o Mageniinka ifa janjannon;</para>
  <para style="q2" vid="PSA 44:8">summa atikanna duuchchi woddi'a saandanno.<verse eid="PSA 44:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9" />Ta'a kinni no'oo gibbe'eeten; no'oo salphisseeten;</para>
  <para style="q2" vid="PSA 44:9">no'oke loliinke manninni welti fulada'ebexxon.<verse eid="PSA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10" />No'oke Naaphi eddii'n udumi'a hinge bannjannoshsha assittette;</para>
  <para style="q2" vid="PSA 44:10">no'oo gibammakiirinna no'oo saame.<verse eid="PSA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11" />Dulemaake gedhebishsha no'oo saisite uuttetten;</para>
  <para style="q2" vid="PSA 44:11">gosa gosake ardi giddo no'oo xeertette.<verse eid="PSA 44:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12" />Arda atika heenochcho'ni gurgurtete;</para>
  <para style="q2" vid="PSA 44:12">insa'ne gurguretenna la'o alfitebexxo.<verse eid="PSA 44:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13" />Olla'a no'okee geebotike,</para>
  <para style="q2" vid="PSA 44:13">qarqara no'oke'ni hedheeke gosa gosake ardi'a oso'lichchiinkenna gacifachchotike no'oo assittette.<verse eid="PSA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14" />Gosa gosake ardi giddo mammaakeemmannoke no'oo assittette;</para>
  <para style="q2" vid="PSA 44:14">ardikinna tuffeti umo no'o'n le'misse.<verse eid="PSA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15" />Ani barra duuchcha salphatenne;</para>
  <para style="q2" vid="PSA 44:15">shooke'e aliba anka buqeedheenne.<verse eid="PSA 44:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16" />Iitta kadeennelchi naaphi anki ane'ni halo fulaa wodda weli manni anee gacifatta'ninna oso'laa'naa laqeennexxeeten.<verse eid="PSA 44:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17" />Tinni duuchchi no'o'n gelteek atee deenebe'nong,</para>
  <para style="q2" vid="PSA 44:17">atixxe kako'aa xuurameesumma no'oxxa xe'insheebe'nog tinni duuchcha ano'o'ni gelte.<verse eid="PSA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18" />Qalbe no'oxxi atenaa'n udumi'a higgebaan;</para>
  <para style="q2" vid="PSA 44:18">lekka no'oxxinna ora atikenaa'n gortebaan.<verse eid="PSA 44:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19" />Ati kinni jeedali hosammabaa'a no'oo butuchchite'e hundette;</para>
  <para style="q2" vid="PSA 44:19">dimma dukkana'ninna no'oo buqqe'eette.<verse eid="PSA 44:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20" />Silaan no'oke Magenika summa deene'eennele</para>
  <para style="q2" vid="PSA 44:20">wele magenuwwiba'a anga no'oxxa ke'issine'eennele,<verse eid="PSA 44:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21" />Isi godobi giddo sho'ondeexxa afaak Mageni</para>
  <para style="q2" vid="PSA 44:21">tennee ege'naa gophaata?<verse eid="PSA 44:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22" />Yaane kinni barra duuchcha atixxee'e reyyotixxe rakko'n kiphphi hina'eennen;</para>
  <para style="q2" vid="PSA 44:22">duliinke gedhebishshanna uudeme'eennen.<note caller="-" style="x"><char style="xo" closed="false">44:22 </char><char style="xt" closed="false"><ref loc="ROM 8:36">Rom. 8:36</ref>. </char></note><verse eid="PSA 44:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23" />Ee, Dada Duuchike Goottaa! Dammaqi; mayeeta diiphphatto?</para>
  <para style="q2" vid="PSA 44:23">Ke'i, duuchchi woddi'anna no'oo gibbexxe'e.<verse eid="PSA 44:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24" />Ati mayee'e alba no'oo sho'exxatto?</para>
  <para style="q2" vid="PSA 44:24">Rakko no'oxxanna miiceensha no'oxxa mayee'e deettatto?<verse eid="PSA 44:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25" />Lubbo no'oxxi buttini giddo lixxe'een;</para>
  <para style="q2" vid="PSA 44:25">bisi no'okinna buttate'ni mexxi hiyye'een.<verse eid="PSA 44:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26" />Kexxe no'oo gargaar;</para>
  <para style="q2" vid="PSA 44:26">atixxe duuchchi woddixxe jaalala'aanna no'oo wodi.<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="s1">Aadha Heerumiinxe Jilaxxa Faaro</para>
  <para style="d">Faarsaaleeyyetike Sooresi'a Tsigerediinke Meellinni Qorexxe hortexxa Gence, Jaalalatixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1" />Eloxxe yaane anke godoba'ni wo'mite'e dhangalaate;</para>
  <para style="q2" vid="PSA 45:1">fulcheennexxa faaronna moyanjokee laqisanno;</para>
  <para style="q2" vid="PSA 45:1">arabi ankinna beeka borressanjiinxe tiikkoshshaten.<verse eid="PSA 45:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2" />Ati manjiinke belto duuchchanaa'n danchummati quba saxxeeteken;</para>
  <para style="q2" vid="PSA 45:2">haaso'i atikinna gaachchanna afe'eeke;</para>
  <para style="q2" vid="PSA 45:2">tennee atee Mageni duuchchi woddi'a eebbise'een.<verse eid="PSA 45:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3" />Ulfaatettekenna gaachchanna afe'eeteke</para>
  <para style="q2" vid="PSA 45:3">goottaa,</para>
  <para style="q2" vid="PSA 45:3">wolaatichcha atika ka'li.<verse eid="PSA 45:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4" />Gaachchanna oddo'wite'e injifachchotee'e ke'i;</para>
  <para style="q2" vid="PSA 45:4">dhugatixxee'e, shaqquntetixxeenna qullumatixxee</para>
  <para style="q2" vid="PSA 45:4">atixxi middixxi anga mambe'iinxa yaane assitowwaal.<verse eid="PSA 45:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5" />Atik qarsemeek mogiduwwi moyanjiinke naaphika godoba otowwaal;</para>
  <para style="q2" vid="PSA 45:5">gosa gosak arda lekka atixxi hunda ibowwaal.<verse eid="PSA 45:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6" />Ee, Magenoo! Moote atixxi, duuchchi woddi'a hexxaan;</para>
  <para style="q2" vid="PSA 45:6">atixxe mootummaxxi bokkonna dhugaatixxe bokkon.<verse eid="PSA 45:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7" />Ati qullumma eetteten, fuggo gibbete;</para>
  <para style="q2" vid="PSA 45:7">tennee Mageni, atik Mageni</para>
  <para style="q2" vid="PSA 45:7">gammashotixxe zayitenni atee hariireexxi</para>
  <para style="q2" vid="PSA 45:7">ati atixxa hari'aa caaldatoshsha asse.<note caller="-" style="x"><char style="xo" closed="false">45:7 </char><char style="xt" closed="false"><ref loc="HEB 1:8-9">Ibr. 1:8-9</ref>. </char></note><verse eid="PSA 45:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8" />Atixxi seemma duuchcha'n karbe, irreete, dakkadha giissendeexxe shito fiffixxende'een;</para>
  <para style="q2" vid="PSA 45:8">daana'iinxe issonni giisseme'e ijaaremeeke mootummatike mine'ni begeniink, masinqotike meelii atee gammachchiisaan.<verse eid="PSA 45:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9" />Moyanjiinke mootummatike mini giddo hexxeexxe mellaalle giddo moyanjuwwiink dubari hedheen,</para>
  <para style="q2" vid="PSA 45:9">moottitetinna Ofiirixxe worqenni seeffateexxi midda atike'ni uurrite'een.<verse eid="PSA 45:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10" />Tee beltoo!</para>
  <para style="q2" vid="PSA 45:10">Caqasi, qalbeefati; mansha atixxanna kaba'aa wirri assi;</para>
  <para style="q2" vid="PSA 45:10">arda atikanna atike annika mine dedhi.<verse eid="PSA 45:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11" />Danchumma atixxi moyanjo boojite'een;</para>
  <para style="q2" vid="PSA 45:11">isi atike gootta kadeemmaxxee'e</para>
  <para style="q2" vid="PSA 45:11">iso'o ulfeessi.<verse eid="PSA 45:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12" />Xiroosike qachchik ardi uwwa iyyedagaan;</para>
  <para style="q2" vid="PSA 45:12">dureeyyetinna atenaa'n elle alfatee'e atibaa shiqate'e hassaan.<verse eid="PSA 45:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13" />Moyanjiinxi belto ifi seeffateexxi moyetike mine'n ifixxe kuta giddo hexxeen;</para>
  <para style="q2" vid="PSA 45:13">seemma isexxinna worqeti shimalixxen.<verse eid="PSA 45:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14" />Seesende gandeexxa seemma oddo'wite'naa'a moyanjiba'a iyyemmarraan;</para>
  <para style="q2" vid="PSA 45:14">jaaluwwa isexxe kadeek dubaruwwi isexxa duuka atibaa dagaan.<verse eid="PSA 45:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15" />Insa'nenna gammashshotinna illilleetteti</para>
  <para style="q2" vid="PSA 45:15">moyanjiinke moyetike miniba'a e'yinaan.<verse eid="PSA 45:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16" />Edike atike annuwwixxe bakka'n labbaxxi atixxi oose bakka abixxitaan;</para>
  <para style="q2" vid="PSA 45:16">atinna insa'nee'e boga duuchcha galchinaashsha assittatton.<verse eid="PSA 45:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17" />Summi atik ilatenaa'n ilati qico'n qaabbatemaashsha assannon;</para>
  <para style="q2" vid="PSA 45:17">tennexxee gosa gosa ardi duuchchi woddi'aa atee saadaan.<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="s1">Magen No'onni Welti Hedheen</para>
  <para style="d">Faarsaaleeyyetike Sooresi'a Dubarri Faarsammake Meelinni Faarsendeexxa Qorexxe Hortexxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1" />Mageni no'oke dalla'anna no'oxxe hunnan;</para>
  <para style="q2" vid="PSA 46:1">rakko no'o'ni geltaxxee duuchcha'n no'oke shiqike gargarsanjon.<verse eid="PSA 46:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2" />Tennexxee buttinni lele'moole</para>
  <para style="q2" vid="PSA 46:2">koobuwwatinna abbayyaatixxe dhi'mo'n lixxoole sodantabe'non.<verse eid="PSA 46:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3" />Wode'uwwi luula'n honboolenna</para>
  <para style="q2" vid="PSA 46:3">koobuwwatinna wodi'uwwiinxe daganaa'n kexxeexxa linqisoolenna allannabe'non.<verse eid="PSA 46:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4" />Dada Duuchchika Duuchchi Woddike Goottika Mageniink qachcha,</para>
  <para style="q2" vid="PSA 46:4">woyyichcha galduma gammachchiisaak yaa'aak wodi'i hedheen.<verse eid="PSA 46:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5" />Mageni ookkone qachchi giddo hedheemmaxxee'e iikki qachchi lele'mabaan;</para>
  <para style="q2" vid="PSA 46:5">Mageni gorsa soodimaro isoo gargaaraan.<verse eid="PSA 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6" />Gosa gosak ardi fuggoxxen ke'e;</para>
  <para style="q2" vid="PSA 46:6">moottumuwwatinna ibbe;</para>
  <para style="q2" vid="PSA 46:6">Mageni hafuura gikki asse'e haaso'e; buttatinna baqqe.<verse eid="PSA 46:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7" />Dada Duuchcha Ajajak Duuchch Woddik Gootti no'onni hedheen;</para>
  <para style="q2" vid="PSA 46:7">Ya'iqoobik Mageni golla no'oken.<verse eid="PSA 46:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8" />Amme Duuchchi Woddike Goottixxa huje uudde,</para>
  <para style="q2" vid="PSA 46:8">isi buttaa duwwi gatiseexxa uudde.<verse eid="PSA 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9" />Isi butta duuchcha'n hedheek bagedi uurrashsha assaan;</para>
  <para style="q2" vid="PSA 46:9">gabetanna enqaan; bagedokanna buttuchchaan;</para>
  <para style="q2" vid="PSA 46:9">sarageelakanna giirate'n gubaan.<verse eid="PSA 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10" />Sammi hitineexxi ani Magenoke kadennexxa ege'ne;</para>
  <para style="q2" vid="PSA 46:10">gosa gosake arda'n saadeemannon;</para>
  <para style="q2" vid="PSA 46:10">buttate'ninna saadeemannon.<verse eid="PSA 46:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11" />Dada Duuchcha Ajajak Duuchchi Woddik Gootti no'onni hedheen;</para>
  <para style="q2" vid="PSA 46:11">Ya'iqoobik Mageni golla no'oken.<verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="s1">Mageni Butta Duuchchike Moyanjon</para>
  <para style="d">Faarsaleeyyetike Sooresi'a Qorexxe Hortexxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 47:1" />Gosa gosak ardi duuchchi anga ha'noxxa calle;</para>
  <para style="q2" vid="PSA 47:1">hafuura gikki assitine'e Magenokee illillisse.<verse eid="PSA 47:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2" />Butta duuchchik ulfateek moyanji</para>
  <para style="q2" vid="PSA 47:2">Dada Duuchchik Duuchchi Woddik Gootti sodaachchiisaaken.<verse eid="PSA 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3" />Isi gosa gosak ardi no'aa hiremaashsha asse;</para>
  <para style="q2" vid="PSA 47:3">ardakanna no'o hunda galche.<verse eid="PSA 47:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4" />Eeyyaaxxe Ya'iqoobixxe horte'a kubete kade'eka</para>
  <para style="q2" vid="PSA 47:4">boga isi no'aa file;<verse eid="PSA 47:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5" />Mageni gammashshotixxe illilleettenni,</para>
  <para style="q2" vid="PSA 47:5">Duuchchi Woddik Gootti malagati afuufema'naa'a iimi'a aage.<verse eid="PSA 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6" />Faaroti Mageno saadde; Faaroti isoo saadde;</para>
  <para style="q2" vid="PSA 47:6">moyanjo no'oka faaroti jajje; faaroti isoo jajje.<verse eid="PSA 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7" />Mageni butta duuchchike moyanjo kademmaxxeee</para>
  <para style="q2" vid="PSA 47:7">eloxxe faaroni isoo saadde.<verse eid="PSA 47:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8" />Mageni gosa gosake arda'n moyanjoken;</para>
  <para style="q2" vid="PSA 47:8">Mageni ifixxe woyyite moote hana offo'le'een.<verse eid="PSA 47:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9" />Abirihaamike Mageniinke ardinni welti</para>
  <para style="q2" vid="PSA 47:9">Gosa gosake ardik ja'laabuwwi bukki hiyye;</para>
  <para style="q2" vid="PSA 47:9">buttatik loliink manni Mageniinke kadeemmaxxee</para>
  <para style="q2" vid="PSA 47:9">isi yo'oshsha saadeemmeeken.<verse eid="PSA 47:9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="s1">Tsiyoonii'i, Mageniinka Qachcha</para>
  <para style="d">Qorexxe Hortexxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1" />Duuchchi Woddiki Gootti lumoken;</para>
  <para style="q2" vid="PSA 48:1">no'oke Mageniinke qachcha'ni, ifixxe woyyitte kooba hanaa lumo qico saadema hasissaaken.<verse eid="PSA 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2" />Butta duuchchike gammado kadde'eexxi,</para>
  <para style="q2" vid="PSA 48:2">middi darre'n qeerrink danchoonde'eexxi Tsiyoonixxi kooba</para>
  <para style="q2" vid="PSA 48:2">lumoke moyanjike qachchan.<verse eid="PSA 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3" />Mageni ookkone qachchike jabake mootummatike mini giddo hedhati qachchiinke golla kadeexxa kookeesse'een.<verse eid="PSA 48:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4" />Moyanjuwwikinna welti gudde'e</para>
  <para style="q2" vid="PSA 48:4">mitteba bukki hiyye'e ookkone qachcha lolatee dageexxi,<verse eid="PSA 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5" />qachcha ookkone uunde wodda mambe'a hine;</para>
  <para style="q2" vid="PSA 48:5">sodaantenna banje.<verse eid="PSA 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6" />Ookkonni sodante culphinse; ciniiffattammaxxe manjichchoshshanna ciniinfante.<verse eid="PSA 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7" />Boroti darree'n gandaammaxxi diidalo Terseesixxa hoboluwwa gande xeertammashsha</para>
  <para style="q2" vid="PSA 48:7">atinna insa'nee balleesittete.<verse eid="PSA 48:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8" />No'oo lanqenneshshanni Dada Duuchcha Ajajak Duuchchi Woddik Gootti Mageniik qachchi,</para>
  <para style="q2" vid="PSA 48:8">Mageno no'okike qachcha'ni</para>
  <para style="q2" vid="PSA 48:8">Dada Duuchchik Duuchchi Woddik Gootti duuchchi wodda jabeese uurrisaaxxa undenne.<verse eid="PSA 48:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9" />Ee, Magenoo! Galma atik giddo he'nee'e</para>
  <para style="q2" vid="PSA 48:9">duuchchi woddixxa atixxa jaalala qalli hina'eennen.<verse eid="PSA 48:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10" />Ee, Magenoo! Buttattixxe gabala qico'n saadino atixxi geltemmashshanni,</para>
  <para style="q2" vid="PSA 48:10">atike summiki gurrinna iittanni fule'een;</para>
  <para style="q2" vid="PSA 48:10">middiixxi atixxi anganna qullumma calla assitaaxxen.<verse eid="PSA 48:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11" />Atixe dhugatixxe murtexxee'e Tsiyoonixxe kooba'n hedha'neek ardi gammaddowwaal;</para>
  <para style="q2" vid="PSA 48:11">Yihudake qachcha'n hedha'neek duuchchi burraaqowwaal.<verse eid="PSA 48:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12" />Tsiyoonike loola'n mammarremme; qarqara iseke'ninna dowwe;</para>
  <para style="q2" vid="PSA 48:12">isexxa heqqatixxa xeelleephphuwwanna laakko'we.<verse eid="PSA 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13" />Daggaaxxe ila'n haasotinaashsha Tisiyoonka jabaka dalla'anna kollo isexxaara hubatine uudde.<verse eid="PSA 48:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14" />Kunni Mageni duuchchi woddi'a no'oke Mageno kadeemmaxxee</para>
  <para style="q2" vid="PSA 48:14">muuxamii qico'n no'oo akeekaak isoten.<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="s1">Karra Addatatixxa Gowwumma</para>
  <para style="d">Faarsaleeyyetike Sooresi'a Qorexxe Hortexxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1" />Ha'noo duuchchiing ardi tennee laqqe;</para>
  <para style="q2" vid="PSA 49:1">buttate'n hexxineek duuchchi tennee caqqasse.<verse eid="PSA 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2" />Hedhokinna heenokiiri</para>
  <para style="q2" vid="PSA 49:2">duureeyyetinna hiyyeeyye laqqe.<verse eid="PSA 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3" />Afo'o ankenni beekkumik haaso'annon;</para>
  <para style="q2" vid="PSA 49:3">anke godobi yaadinna ege'na uwwaaken.<verse eid="PSA 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4" />Mansha anxa mammaassii darre'n wirri assannon;</para>
  <para style="q2" vid="PSA 49:4">begana ganatinna hiibbo anxa tikannon.<verse eid="PSA 49:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5" />Fuggoxxi barra ane'ni geltaa baro</para>
  <para style="q2" vid="PSA 49:5">sobaaleeyetixxi fuggo anee buqqaa wodda,</para>
  <para style="q2" vid="PSA 49:5">mayee sodaatannotaa?<verse eid="PSA 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6" />Karrate'n addataakaaranna</para>
  <para style="q2" vid="PSA 49:6">ifixxe durummaxxe birasa'ne'n ifi dukaakaara</para>
  <para style="q2" vid="PSA 49:6">mayee sodaatannotaa?<verse eid="PSA 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7" />Wele manjixxa hedho woda dande'aak,</para>
  <para style="q2" vid="PSA 49:7">yookaan ifixxe hedhoka hira Magenokee dande'e uwwaak hedhebaan.<verse eid="PSA 49:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8" />Lubbotiki hiri fiixe'eeke kadeemmaxxee</para>
  <para style="q2" vid="PSA 49:8">ise'a uwwemeelenna geyaak hiri haranga hedhebaan.<verse eid="PSA 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9" />Reye moogemabaashsha</para>
  <para style="q2" vid="PSA 49:9">duuchchi woddi'a hedhoti hedhaashsha assatee fedheechchinna uwwemeele haranga geyabaan.<verse eid="PSA 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10" />Beekkoletinna midde rertaaxxa ayyinna ege'neexxen;</para>
  <para style="q2" vid="PSA 49:10">gowwikinna hawwawwi mittenba rennaan;</para>
  <para style="q2" vid="PSA 49:10">ifixxa karranna welekee waalle me'inaan.<verse eid="PSA 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11" />Insa'neeke summinni summisemeeka boga anfe'eelenna midde</para>
  <para style="q2" vid="PSA 49:11">insa'ne'aa hirreesi, duuchchi wodike mine insa'neke,</para>
  <para style="q2" vid="PSA 49:11">ilatenaa'n ilati qico'n insa'ne he'naaxxe bakkan.<verse eid="PSA 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12" />Karra manjo reyotenaa'n gatissabaan</para>
  <para style="q2" vid="PSA 49:12">isi hore yookaan biniichchiinsha reyaan.<verse eid="PSA 49:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13" />Kunni umo ifike'n addataake gowwoole mannikenna</para>
  <para style="q2" vid="PSA 49:13">insa'ne hinammaxxa addateexxi adhdhe'e insa'nee hordofamake mannike muuxamiinke qoobbon.<verse eid="PSA 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14" />Gedhebiinsha rennaan;</para>
  <para style="q2" vid="PSA 49:14">reyotinna insa'nee'e gedhebiinsha allalddaan;</para>
  <para style="q2" vid="PSA 49:14">insa'ne ifike dancha minnenaa'n bayyanteexxi hundike hirreesi giddo aloonnaan;</para>
  <para style="q2" vid="PSA 49:14">qulliyye soodimaro insa'ne hirreesi hana mammarendaan.<verse eid="PSA 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15" />Mageni ifibaa anee adhdhammaxxee</para>
  <para style="q2" vid="PSA 49:15">dhugaaten, isi lubbo anxa hundike hirreesixxe hunnanaa'n anee wodaan.<verse eid="PSA 49:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16" />Manji dureesake kadoole,</para>
  <para style="q2" vid="PSA 49:16">isike minixxi karranna bira saxxa'n me'itoole sodaattoxxe'e.<verse eid="PSA 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17" />Isi reyaa barra mittelchonna adhdhabaan;</para>
  <para style="q2" vid="PSA 49:17">karra isixxinna isinni welti me'itabaan.<verse eid="PSA 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18" />Manji hedheeke barro duuchcha'n gammadoolenna</para>
  <para style="q2" vid="PSA 49:18">duuchchiinxi yaane isi'a qajeeldeexxee saademoolenna midde,<verse eid="PSA 49:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19" />Isi edise reyemmake ifike annuwwiba'aa</para>
  <para style="q2" vid="PSA 49:19">langaxxa ifa hedhotika uudammabaakeerba'a me'aan.<verse eid="PSA 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20" />Manji karra afe'e ege'na gophoole</para>
  <para style="q2" vid="PSA 49:20">horiinsha reyaan.<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="s1">Dhugaatixxa Magenoonfachcho</para>
  <para style="d">Asaafixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1" />Lumok Mageni, Duuchchi Woddik Gootti haaso'aan;</para>
  <para style="q2" vid="PSA 50:1">buttattika arda arishsho fuldammabaa'ni aaggamma qico'n ye'aan.<verse eid="PSA 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2" />Danchummati hara quba saxxeexxe Tsiyoonixxe koobanaa'n</para>
  <para style="q2" vid="PSA 50:2">Mageni ifaan.<verse eid="PSA 50:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3" />Mageni no'ok, daga dagaan; sammi hiyyabaan;</para>
  <para style="q2" vid="PSA 50:3">isi edo giira ittaaxxi hexxeen;</para>
  <para style="q2" vid="PSA 50:3">qarqara isike'ninna jabaxxe hobonbaltenna qoqqobe'een.<verse eid="PSA 50:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4" />Isi arda ifike'ni muro'a, iima hexxeexxa iimanna butta hiyyeexxi ye'a qici,<verse eid="PSA 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5" />«Tolchik aninni kako aageeka anka xurameessuwwa ani'a buklki asse.»<verse eid="PSA 50:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6" />Umo ifingenninni Mageni muraake kadeemmaxxee'e</para>
  <para style="q2" vid="PSA 50:6">iimuwwa qullumma isixxa lallabaan.<verse eid="PSA 50:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7" />Mageni hiyyee qici, «Koo anke ardaa! Haaso'aannen laqqe, tee Isira'eelii cubbo hujjettexxa dhugaa kulaanneni</para>
  <para style="q2" vid="PSA 50:7">ani Mageni atike Magenon.<verse eid="PSA 50:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8" />Tolcha atikee ate'e komatabe'non</para>
  <para style="q2" vid="PSA 50:8">atik ciincatik tolchi duuchchi wodda ani edo hedheen.<verse eid="PSA 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9" />Ani kinni kormaa atika dalla'i giddii'n,</para>
  <para style="q2" vid="PSA 50:9">atixxa re'etixxa korbeeyyenna goodhe giddii'n adhdhannokebaan.<verse eid="PSA 50:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10" />Badda'atik biniichchi duuchchi</para>
  <para style="q2" vid="PSA 50:10">kumuwwik laakko'endaaxxe koobuwwa'n hedheek hori anken.<verse eid="PSA 50:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11" />Koobuwwate'n hexxeexxa ci'a duuchcha ege'ne'eennen;</para>
  <para style="q2" vid="PSA 50:11">badda'a giddo lubbo afeechchi duuchchi anilchon.<verse eid="PSA 50:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12" />Buttatinna buttate'n hedheechchi duuchchi anilcho kadeemmaxxee</para>
  <para style="q2" vid="PSA 50:12">solo'wonolenna ate'n kulabe'non.<verse eid="PSA 50:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13" />Isi ani korommetike maala itannota?</para>
  <para style="q2" vid="PSA 50:13">Yookaan re'etixxa munde ha'wannota?»<verse eid="PSA 50:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14" />Magenokee'e galatiinka tolcha shiqishi;</para>
  <para style="q2" vid="PSA 50:14">Galata Dada Duuchchike Duuchchi Woddike Gootti'a tolchi;</para>
  <para style="q2" vid="PSA 50:14">werreega atikanna hunna duuchchikee uwwi.<verse eid="PSA 50:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15" />Mageni, «Rakkoti baro anee ye'edhi;</para>
  <para style="q2" vid="PSA 50:15">aninna atee fulchannon; atinna anee ulfeesittaton.»<verse eid="PSA 50:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16" />Mageni kinni fuggichcha hiyya'nee qici:</para>
  <para style="q1" vid="PSA 50:16">«Anka ajaja maa haasottaate?</para>
  <para style="q2" vid="PSA 50:16">Anxa kako arbo atiken maa summa gandatto?<verse eid="PSA 50:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17" />Ati ajaja anka jibbittatton;</para>
  <para style="q2" vid="PSA 50:17">hiiyyichcho ankanna ifi udumi'a hundatton.<verse eid="PSA 50:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18" />Moodhalcho affato wodda welti jaalondatton</para>
  <para style="q2" vid="PSA 50:18">yaababulakeerninna mittondatton.<verse eid="PSA 50:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19" />Afo'o atika fuggoxxe'e uuteeten;</para>
  <para style="q2" vid="PSA 50:19">atik arbinna sobo haaso'ee.<verse eid="PSA 50:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20" />Dayyo atika ofolde hamatete;</para>
  <para style="q2" vid="PSA 50:20">godobike atike dayyika summanna balleessitete.<verse eid="PSA 50:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21" />Tennee assiteeten; ani kinni sammi hiyyanoo?</para>
  <para style="q2" vid="PSA 50:21">Anee'e atende assitete?</para>
  <para style="q2" vid="PSA 50:21">Ta'a kinni ati assiteetexxa duuchcha ati edo farri asse'e leellishshe atee xixannon.<verse eid="PSA 50:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22" />«Ha'noo Mageno deetinaak manni tennee hubatte;</para>
  <para style="q2" vid="PSA 50:22">kada gophphoole ani ha'noo balleessannon; ayyinna ha'noo gatisaak hedhebaan.<verse eid="PSA 50:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23" />Galatiinka tolcha ani'a shiqishaak isi anee ulfeessaan;</para>
  <para style="q2" vid="PSA 50:23">ora ifikanna toggi assedhaaka ani Mageni isoo anjirannon.»<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s1">Cubbotee Gattowwaalixxa Soodachcho</para>
  <para style="d">Faarsaleeyyetike Sooresi'a Daawwiti Bersaabeeyiba Maree Uduma Wabeekichchi Naataan Isibaa Dageema Wodda, Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1" />Ee, Mageno atixxe jaalalaxxee'e ani'a maraar;</para>
  <para style="q2" vid="PSA 51:1">atike lumoke o'wixxeenna sa'nee anxa filte hoyyi.<note caller="-" style="x"><char style="xo" closed="false">51:1</char><char style="xt" closed="false"><ref loc="2SA 12:1-15">2 Sam. 12:1-15</ref>. </char></note><verse eid="PSA 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2" />Balleessa anxa anenaa'n anshii;</para>
  <para style="q2" vid="PSA 51:2">cubbo anxenaa'ninna anee ca'aa assi.<verse eid="PSA 51:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3" />Sa'ne anxa ege'neennaxxee'e,</para>
  <para style="q2" vid="PSA 51:3">cubbo anxinna duuchchi wodda anxe ille edo hexxeen.<verse eid="PSA 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4" />Ani ate'n jallateenne; dhugaaten, atee calla balleessennen;</para>
  <para style="q2" vid="PSA 51:4">ille atixxi eddonna fuggoxxa yaane asseennen;</para>
  <para style="q1" vid="PSA 51:4">Tennexxee ane'n murte uwwa atixxinna,</para>
  <para style="q2" vid="PSA 51:4">anee mura woxisa atixxi seeraken.<note caller="-" style="x"><char style="xo" closed="false">51:4 </char><char style="xt" closed="false"><ref loc="ROM 3:4">Rom. 3:4</ref>. </char></note><verse eid="PSA 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5" />Reefi ama anxi anee'e siila'witee wodda cubbaaleessake,</para>
  <para style="q2" vid="PSA 51:5">ilemenne woddanna balleessanjokeman.<verse eid="PSA 51:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6" />Kunse, ati manjiinxe qalbe giddo dhuga'a uuddotaa halchitatton;</para>
  <para style="q2" vid="PSA 51:6">tennexxee beekkumiinxa buqo yaane anee barachchiisi.<verse eid="PSA 51:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7" />Hisoophike shafinni fiffixxe cubbotenaa'n anee luqqi assi,</para>
  <para style="q2" vid="PSA 51:7">aninna qulloommannon;</para>
  <para style="q2" vid="PSA 51:7">anee anshi aninna kaadeti calla gola'lannon.<verse eid="PSA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8" />Gammadokanna illilleete anee laqisi;</para>
  <para style="q2" vid="PSA 51:8">anee enqite'e butuchchiteetek anki micinna gammaddowwal.<verse eid="PSA 51:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9" />Cubbo anxa uuddoxxe'e;</para>
  <para style="q2" vid="PSA 51:9">balleessa anxa duuchchanna anenaa'n fiyi.<verse eid="PSA 51:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10" />Ee, Magenoo! Ca'itte qalbe ani'a dadi;</para>
  <para style="q2" vid="PSA 51:10">addatendaaxxa qalbe ani'a uwwi.<verse eid="PSA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11" />Alba atik edii'n anee bayyissoxxe'e;</para>
  <para style="q2" vid="PSA 51:11">woyyichcha atika Haafuuranna anenaa'n adhdhitoxxe'e.<verse eid="PSA 51:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12" />Atixxe anjiraxxa gammashsho haaroba ani'a uuwwi;</para>
  <para style="q2" vid="PSA 51:12">ishshi hiyye ati'a ajajemona'a anee gargaar.<verse eid="PSA 51:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13" />Ookkonechchi uduma aninna seera atika sa'emmaka manna ora atika barachchiisannon;</para>
  <para style="q2" vid="PSA 51:13">cubbaaleeyyetinna atibaa higgaan.<verse eid="PSA 51:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14" />Ee, Mageno anke anjiralloo</para>
  <para style="q2" vid="PSA 51:14">munde dhangalaasennexxee<note caller="+" style="f"><char style="fr" closed="false">51:14 </char><char style="ft" closed="false">Dhangalaasennexxenna hiyyendeexxi wele tika munde dhagalaasematenaa'n hitaan</char></note> cubbonaa'n anee gatisi;</para>
  <para style="q2" vid="PSA 51:14">afo'i ankinna qullumma atixxee'e illillisee faarsaannen.<verse eid="PSA 51:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15" />Ee, Dada Duuchchike Goottaa! Afo'o arbo anee bani;</para>
  <para style="q2" vid="PSA 51:15">aninna atee saadannon.<verse eid="PSA 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16" />Tolcha eeta'eetele silaan ati'a shiqishe'eennan;</para>
  <para style="q2" vid="PSA 51:16">ciincatik tolchi atee gammachchiisabaan.<verse eid="PSA 51:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17" />Mageno eeyyisaak tolchi enqendeexxe qalben;</para>
  <para style="q2" vid="PSA 51:17">Ee, Magenoo ati qalbe enqendeexxanna yaade'e aadde aaga manjo tuffattabexxon.<verse eid="PSA 51:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18" />Tsiyooni'aa fedhi atixxenni eloxxa yaane assi;</para>
  <para style="q2" vid="PSA 51:18">Iyyerusaalemika dalla'anna qammalchi.<verse eid="PSA 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19" />Ookkone wodda qulummatik tolchi,</para>
  <para style="q2" vid="PSA 51:19">ciincatik tolchinna wo'mi ciincatiki tolchii atee gammachchiisaan;</para>
  <para style="q2" vid="PSA 51:19">ookko'n atike tolchmalcho'n korommee tolchendaan.<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="s1">Magenxa Murtenna Mageniinka Badhaadha</para>
  <para style="d">Faarsaleeyyetike Sooresi'a Eedoomichchi Doyiqi Sa'ooliba Dageexxi «Daawwiti Abemelek Miniba'a Dage'een» hiyye Iso'ni Kulee Wodda Daawwitixxa Gence.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 52:1" />Koo worba manjoo, ati mayee fuggoxxenni hollitatto?</para>
  <para style="q2" vid="PSA 52:1">Ati Mageniinxe ille'ni tuffatende'eetek</para>
  <para style="q2" vid="PSA 52:1">mayee duuchchi wodda ifi dukkattoo?<note caller="-" style="x"><char style="xo" closed="false">52:1</char><char style="xt" closed="false"><ref loc="1SA 22:9-10">1 Sam. 22:9-10</ref>. </char></note><verse eid="PSA 52:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2" />Ati soba barate'eetek,</para>
  <para style="q2" vid="PSA 52:2">ati hedde hereegge'e balleessa maldate'eek;</para>
  <para style="q2" vid="PSA 52:2">arabi atik qaraxxe haadoshshaten.<verse eid="PSA 52:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3" />Eloxxe yaane irra fuggoxxa</para>
  <para style="q2" vid="PSA 52:3">dhugaa haso'ati manni'n dhara haaso'a eettatton.<verse eid="PSA 52:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4" />Ati koo sobaaleessa manjoo</para>
  <para style="q2" vid="PSA 52:4">manna miitaaxxe yaane eettatton.<verse eid="PSA 52:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5" />Mageni duuchchi woddi'a atee butti'a tutunsaan;</para>
  <para style="q2" vid="PSA 52:5">butte aadheexxi duunkaana atikenaa'ninna atee goshaan;</para>
  <para style="q2" vid="PSA 52:5">manni hedhoti hedhaammaxxe buttanaa'n atee hoyyaan.<verse eid="PSA 52:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6" />Qulliyyetinna tennee uudde'e sodateexxi</para>
  <para style="q2" vid="PSA 52:6">gacifachchoti atee hitaa qici,<verse eid="PSA 52:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7" />«Mageno gollake assedhebaake</para>
  <para style="q2" vid="PSA 52:7">ifixxe karraxxe bira sa'ne'ni ifi jajeeka</para>
  <para style="q2" vid="PSA 52:7">fuggoxxa assatinna jabake kadeeka manjichcho uudde.»<verse eid="PSA 52:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8" />Ani kinni Mageniinke minne'n</para>
  <para style="q2" vid="PSA 52:8">qufeeke ejersiinke haqichchishshaten;</para>
  <para style="q2" vid="PSA 52:8">duuchchi woddinaa'ni duuchchi woddi'a isixxe duuchchi woddixxe jaalala'n addatannon.<verse eid="PSA 52:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9" />Assitetexxe yaanexxe'ee duuchchi woddi'a atee saadannon;</para>
  <para style="q2" vid="PSA 52:9">summi atik eloke kadeemmaxxee summa atike'n addatanno;</para>
  <para style="q2" vid="PSA 52:9">atixxe qulliyye giddonna atee saadanno.<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="s1">Manjiinxa Fuggaaleessumma</para>
  <para style="d">Faarsaaleeyyetike Sooresi'a «Mahilaati» Hiyyemaake Mellinni Daawwitixxa Gence.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 53:1" />Gowwoole godobi giddo «Mageni hedhebaan» hitaan;</para>
  <para style="q2" vid="PSA 53:1">insa'ne elobaake mannanni;</para>
  <para style="q2" vid="PSA 53:1">huje insa'nexxinna battoteexxen;</para>
  <para style="q2" vid="PSA 53:1">insa'ne giddi'ninna eloxxa assaak mittikinna hedhebaan.<verse eid="PSA 53:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2" />Qalbeeffachchoti mammaremaak,</para>
  <para style="q2" vid="PSA 53:2">iso'o halsaak hedheexxa uudatee'e</para>
  <para style="q2" vid="PSA 53:2">Mageni iimatenaa'n manjiinka belto uudaan.<verse eid="PSA 53:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3" />Duuchchiing welebaa wirri hiyye;</para>
  <para style="q2" vid="PSA 53:3">duuchchiing mittenba harfo'een;</para>
  <para style="q2" vid="PSA 53:3">mittikinna midde eloxxa assaak hedhebaan.<note caller="-" style="x"><char style="xo" closed="false">53:3 </char><char style="xt" closed="false"><ref loc="ROM 3:10-12">Rom. 3:10-12</ref>. </char></note><verse eid="PSA 53:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4" />Manji waasa itammashsha arda anka itaakiir</para>
  <para style="q2" vid="PSA 53:4">Mageno ye'edhe egenebaakiir</para>
  <para style="q2" vid="PSA 53:4">iikki fuggoxxik hujalluwwi insa'ne haranga barantabaa?<verse eid="PSA 53:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5" />Sodaachchiisaxxi yaane ookko hexxeeba'a lumo qico sodaante;</para>
  <para style="q2" vid="PSA 53:5">Mageni ifike ardike naaphixxa miqe xeere;</para>
  <para style="q2" vid="PSA 53:5">Mageni insa'nee tuffateemmaxxee'e ha'no Mageniink ardi insa'ne'e shookishshinaan.<verse eid="PSA 53:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6" />Isira'eeli'i anjiraak Tsiyoonii'n dagummadu;</para>
  <para style="q2" vid="PSA 53:6">Mageni ifke ardixxa booji'o hiissaxxa yanna</para>
  <para style="q2" vid="PSA 53:6">Ya'iqoobixxi horte illillisowwaal; Isira'eelik ardinna gammadowwaal.<verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="s1">Naaphiinxe Anganaa'n Gataatee'e Shiqqaxxa Soodachcho</para>
  <para style="d">Faarsaleeyyetike Sooresi'a Baganuwwik Zaafaxxi Horte Sa'ooliiba Daggeexxi «Daawwiti No'oba Sho'ome'een.» Hinee Wodda Daawwitixa Gence</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1" />Ee, Mageno summa atikenni anee anjir;</para>
  <para style="q2" vid="PSA 54:1">hunna atixxenninna ani'aa muri; <verse eid="PSA 54:1" /><verse number="2" style="v" sid="PSA 54:2" />Ee, Magenoo! Soodachcho anxa laqi;</para>
  <para style="q2" vid="PSA 54:2">haaso'a ankanna caqasi.<verse eid="PSA 54:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3" />Alagi ane'ni ke'eedheen;</para>
  <para style="q2" vid="PSA 54:3">manna sodaachchisaak manninna lubbo anxa halse'een.</para>
  <para style="q2" vid="PSA 54:3">Mageno mitteelchchonna geessinsebaan.<verse eid="PSA 54:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4" />Dugaaten, Mageni anke gargaarsanjon;</para>
  <para style="q2" vid="PSA 54:4">Dada Duuchchik Goottinna anee kiphaaken.<verse eid="PSA 54:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5" />Naaphi ani'a hedeemmaxxa fuggoxxa Mageni iso'ninni hiissowwaal;</para>
  <para style="q2" vid="PSA 54:5">hiyyichcho atike'ni addate'eennen ati insa'nee balleessi<verse eid="PSA 54:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6" />Eeyyuunte anxenni tolcha ati'aa shiqishaanenni</para>
  <para style="q2" vid="PSA 54:6">Ee, Duuchchi Woddike Gootta ati eloke kaddeetaxxee</para>
  <para style="q2" vid="PSA 54:6">summa atika saadannon.<verse eid="PSA 54:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7" />Rakko duuchchanaa'ni anee fulchiteettaxxee'e</para>
  <para style="q2" vid="PSA 54:7">naaphi ankinna injifatemee'naa ille anxenni uudenneni.<note caller="-" style="x"><char style="xo" closed="false">54:7 </char><char style="xt" closed="false"><ref loc="1SA 23:19">1 Sam. 23:19</ref>; <ref loc="1SA 26:1">26:1</ref>. </char></note><verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="s1">Jaali Isoo'o Gibeeke Manjixxa Soodachcho</para>
  <para style="d">Faarsaleeyyeetike Sooresi'a Baganuwwik Daawwitixxa Gence.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 55:1" />Ee, Magenoo! Soodachcho anxa laqi;</para>
  <para style="q2" vid="PSA 55:1">kadha anxanna gibboxxe'e.<verse eid="PSA 55:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2" />Ani'a hee hiyyi; hiissichchokanna ani'a uwwi;</para>
  <para style="q2" vid="PSA 55:2">yaadik weekeme'ennen; fajjisemeennen.<verse eid="PSA 55:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3" />Naaphiinke haaso'inni weekemeennen;</para>
  <para style="q2" vid="PSA 55:3">fuggaleeyyetixxe dhaadachcho'aanna alayyeenne;</para>
  <para style="q1" vid="PSA 55:3">Insa'ne ane'n rakko iyyedangeen;</para>
  <para style="q2" vid="PSA 55:3">aareti ane'ni ke'ne'e naaphake ane'ni kandeen.<verse eid="PSA 55:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4" />Qalbe anee dhiqqisse;</para>
  <para style="q2" vid="PSA 55:4">reyotika alayyonna alayyenne.<verse eid="PSA 55:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5" />Alayyenna roqonsenne;</para>
  <para style="q2" vid="PSA 55:5">lumo qiconna culphisenne.<verse eid="PSA 55:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6" />Guugenjotishsha keela afe'eennele,</para>
  <para style="q2" vid="PSA 55:6">phirri hiyye me'ee hafuura adhannan,<verse eid="PSA 55:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7" />Silaa bayyi'a me'ee</para>
  <para style="q2" vid="PSA 55:7">qiilla gammooje giddo hekki hiyyannan.<verse eid="PSA 55:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8" />Hobonbaltetenaa'ninna diidallotike soranaa'n</para>
  <para style="q2" vid="PSA 55:8">baaje'e gollatannobaa silaa rakkee me'annan.<verse eid="PSA 55:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9" />Ee, Dada Duuchchike Gootta</para>
  <para style="q2" vid="PSA 55:9">qachchi giddo xaqarotanna weli itaa uude'eennaxxee'e</para>
  <para style="q2" vid="PSA 55:9">fugaaleeyyetixxa mari'e balleessi, afo'o insa'neeka gorsi.<verse eid="PSA 55:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10" />Hashsha barra insa'ne qachchiinke dalla'i hana doonaan;</para>
  <para style="q2" vid="PSA 55:10">Xaqarotinna rakko qachchi giddo wo'miteen;<verse eid="PSA 55:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11" />Qachchi giddo ba'nete hexxeen;</para>
  <para style="q2" vid="PSA 55:11">qachchiinxe weldeenna duuchcha'n manjo miicanna manjo soba gophendeebaan.<verse eid="PSA 55:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12" />Anee yowwa'neek naaphaakebaan</para>
  <para style="q2" vid="PSA 55:12">naaphake kadeele silaani ossannan;</para>
  <para style="q2" vid="PSA 55:12">ane'ni umo duka'neek diina ankebaan;</para>
  <para style="q2" vid="PSA 55:12">diinake kadeele silaan isi edii'n sho'omannan.<verse eid="PSA 55:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13" />Yaane kinni tennee assittetek ateten,</para>
  <para style="q2" vid="PSA 55:13">atee hari'a anxe,</para>
  <para style="q2" vid="PSA 55:13">jaalo ankenna yo'oshsha welti shiqanoke,<verse eid="PSA 55:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14" />atinni welti xe'maaka haaso'a haasonna'ni</para>
  <para style="q1" vid="PSA 55:14">Mageniinke galmi giddo ardinni welti me'ineennaken.<verse eid="PSA 55:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15" />Fuggoxxi insa'ne giddonna mine insa'neek giddo hexxeemmaxxee</para>
  <para style="q2" vid="PSA 55:15">keekatebaang reyo naapha anke'n daggowwaali</para>
  <para style="q2" vid="PSA 55:15">lubbondinni he'ne hirreesa hundike'n sa'numadu.<verse eid="PSA 55:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16" />Ani kinni Mageniinbaa soodata'eennen;</para>
  <para style="q2" vid="PSA 55:16">Duuchchi Woddiki Goottinna anee anjiraan.<verse eid="PSA 55:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17" />Hashsha barranna saafo'a rakko anxa iso'n ku'lanon;</para>
  <para style="q2" vid="PSA 55:17">isibaa oodhannon; isinna hafuura anka laqaan.<verse eid="PSA 55:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18" />Ane'n ke'eek manni heddoke kadeemmaxxee</para>
  <para style="q2" vid="PSA 55:18">isi insa'nenaa'n lubbo anxa nage'ik wodaan.<verse eid="PSA 55:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19" />Insa'ne me'aa ifixxa jijjiidha gonpheemmaxxee</para>
  <para style="q2" vid="PSA 55:19">Mageno sodaata gonpheemmaxee</para>
  <para style="q2" vid="PSA 55:19">olminaa'ni mootet hana hedheek Mageni soodachcho anxa laqeexxi insa'nee salphisaan.<verse eid="PSA 55:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20" />Ank jaalli ifika jaalluwwa lole;</para>
  <para style="q2" vid="PSA 55:20">kakateemmaxxa kakonna diige.<verse eid="PSA 55:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21" />Afoo'i isik buuroken;</para>
  <para style="q2" vid="PSA 55:21">godobi isik giddo kinni bagedoke hedheen;</para>
  <para style="q2" vid="PSA 55:21">haaso'i isik zayiteti caala shaqqaken;</para>
  <para style="q2" vid="PSA 55:21">yaane kinni goshemeeke wolaantichchan.<verse eid="PSA 55:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22" />Ate'n a'urteexxa yaane Duuchchi Woddike Gootta'n wocci assi;</para>
  <para style="q2" vid="PSA 55:22">isi atee kiphe abidaan;</para>
  <para style="q2" vid="PSA 55:22">qullichcha manjonna haranga guggufato'a waalabaan.<verse eid="PSA 55:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23" />Ani kinni ee, Magenoo! Ate'ni addata'eennen;</para>
  <para style="q2" vid="PSA 55:23">fuggaaleeyye ba'netixxe bale giddo ibissatton;</para>
  <para style="q2" vid="PSA 55:23">manjiinxa lubbo shiyaammakiirinna sobaaleessi manni ifixxe hedhoka gamisa baronna hedhabaan.<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="s1">Mageno Addatatixxa Soodachcho</para>
  <para style="d">Faarsaleeyyeetike Sooresi'a «Guugenjoo bayya hedheeke qilxi hana» Hiyyemaake Meellinni, Filisixeemik Manni Gaatike Qachcha'n Isoo abidee wodda Daawwitixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 56:1" />Ee, Mageno manni anee shorra'neen, ani'a maraar;</para>
  <para style="q2" vid="PSA 56:1">barra duuchcha ane'e lola'n anee miice'een.<verse eid="PSA 56:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2" />Naaphi ank barra duuchcha anee shorra'neen;</para>
  <para style="q2" vid="PSA 56:2">ifi dukati anee lola'neekiir heddoken.<verse eid="PSA 56:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3" />Sodaatanno woddanna</para>
  <para style="q2" vid="PSA 56:3">atete addatannon.<verse eid="PSA 56:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4" />Hiyyichcho isika saadannoke Mageno addate'eenneni</para>
  <para style="q2" vid="PSA 56:4">sodaatabe'non;</para>
  <para style="q2" vid="PSA 56:4">maala oddo'week manji ani'aa maassa dande'aa?<verse eid="PSA 56:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5" />Barra duuchcha haaso'a anka micciiraan;</para>
  <para style="q2" vid="PSA 56:5">duuchchi wodda anee miidhatee'e mallaan.<verse eid="PSA 56:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6" />Insa'ne mitteba bukki hinee, rinphaan;</para>
  <para style="q2" vid="PSA 56:6">tarkaffe anxanna faana qoraa'ni</para>
  <para style="q2" vid="PSA 56:6">lubbo anxanna balleessatee'e gaandaan.<verse eid="PSA 56:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7" />Ee, Magenoo! Dabaaleeyye hoone oranna baaje fuldabaashsha assi;</para>
  <para style="q2" vid="PSA 56:7">mufe atixxenni gosa gosaka arda butti'a hiissi.<verse eid="PSA 56:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8" />Oodhishsha anxa laakkote'eeten;</para>
  <para style="q2" vid="PSA 56:8">indiddo anxa xarmuuse giddo cossitee'e uggite'eeten;</para>
  <para style="q2" vid="PSA 56:8">kunniichchi atike maxaafa giddo borresseme'eekebaa?<verse eid="PSA 56:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9" />Atee ye'edhannoxxa barra</para>
  <para style="q2" vid="PSA 56:9">naaphi anki udumi'a higaan;</para>
  <para style="q2" vid="PSA 56:9">Mageni aninni hedheexxa tennenni ege'nannon.<verse eid="PSA 56:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10" />Kunni aninni welti hedheek Duuchchi Woddik Gootti</para>
  <para style="q2" vid="PSA 56:10">hiyyichcho isika galateefataannekenna ulfeessanneke Magenon.<verse eid="PSA 56:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11" />Mageno addateennen sodatabe'non;</para>
  <para style="q2" vid="PSA 56:11">maala odo'week manji ani'aa maassa dande'aa?<verse eid="PSA 56:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12" />Ee, Magenoo! Ati'a werreegennek werreegi ane'n hedheen;</para>
  <para style="q2" vid="PSA 56:12">galatiinka tolchanna ati'a tolchannon.<note caller="-" style="x"><char style="xo" closed="false">56:12 </char><char style="xt" closed="false"><ref loc="1SA 21:13-15">1 Sam. 21:13-15</ref>. </char></note><verse eid="PSA 56:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13" />Hedhotike ifa'n,</para>
  <para style="q2" vid="PSA 56:13">Mageni edo mammaremoona'aa,</para>
  <para style="q2" vid="PSA 56:13">lubbo anxa reyotenaa'n,</para>
  <para style="q2" vid="PSA 56:13">lekka anxanna guggufachchotenaa'n gatiseeten.<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="s1">Mageniinke Gargaarsi'a Shiqqeexxa Soodachcho</para>
  <para style="d">Faarsaleeyeetike Sooresi'a «Balleessitoxxe'e» Hiyyemaake Meellinni Faarsendaaxxa, Sa'ooli Edii'n Baajeexxi wolo'o Giddo Hedhemma Wodda Daawwitixxa Soodachcho.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 57:1" />Ani'aa marar Ee, Magenao! Ani'aa marar;</para>
  <para style="q2" vid="PSA 57:1">Lubbo anxi atee gollake assexxe'een,</para>
  <para style="q2" vid="PSA 57:1">ba'ne jabaxxi tinni saxxaa qico'ni</para>
  <para style="q2" vid="PSA 57:1">atixxe bobake gaadisi giddo gollato.<verse eid="PSA 57:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2" />Ani'a hedeexxa ani'a muuxaake</para>
  <para style="q2" vid="PSA 57:2">Dada Duuchchike Duuchchi Woddike Gootta Mageniba'aa oodhaannen.<verse eid="PSA 57:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3" />Anee rakkisaammake mannanaa'n ane'ee gatiso'a</para>
  <para style="q2" vid="PSA 57:3">iimatenaa'n ani'a gargaassa ergaan;</para>
  <para style="q2" vid="PSA 57:3">Mageni jaalala ifixxanna xuurameessumma ifixxa ani'a ergaan.<verse eid="PSA 57:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4" />Anee neeniinqi buqe'een;</para>
  <para style="q2" vid="PSA 57:4">ninnifaake biniinchixxe oddo'ni ibennen;</para>
  <para style="q2" vid="PSA 57:4">kunni neenqi isso insa'neexxi bagedokenna gabe</para>
  <para style="q2" vid="PSA 57:4">arabi insa'neekinna qarake wolaantichcha kade'eeke mannan.<verse eid="PSA 57:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5" />Ee, Magenoo! Iimuwwati iima kubbisemi;</para>
  <para style="q2" vid="PSA 57:5">gaachanni atikinna butta duucha'n hedhowwaal.<verse eid="PSA 57:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6" />Insa'ne lekka anxee'e fonxoro fanne;</para>
  <para style="q2" vid="PSA 57:6">aninna yaade hangulli hiyyenne;</para>
  <para style="q2" vid="PSA 57:6">me'annoke ora'n bale ani'a qonte;</para>
  <para style="q2" vid="PSA 57:6">yaane kinni insa'nenni bale eettene'n inbe.<verse eid="PSA 57:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7" />Ani mamabe'non! Ee, Mageno ani mamabe'no;</para>
  <para style="q2" vid="PSA 57:7">faarsannon; meella'ninna faarsannon.<verse eid="PSA 57:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8" />Tee anxe lubbo dammaqi;</para>
  <para style="q2" vid="PSA 57:8">koo anke baganaa, tee anxe masinqo dammaqi;</para>
  <para style="q2" vid="PSA 57:8">aninna soodi maro dammasso.<verse eid="PSA 57:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9" />Ee, Dada Duuchchike Goottaa!</para>
  <para style="q2" vid="PSA 57:9">Gosa gosake ardi giddo atee sadannon;</para>
  <para style="q2" vid="PSA 57:9">arduwwi giddo ati'a faarsannon.<verse eid="PSA 57:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10" />Jaalala atixxi iimuwwati qico'n gelte'eexxen,</para>
  <para style="q2" vid="PSA 57:10">xuurameessumma atixxinna iima duumanchii qico'ni geltaan.<verse eid="PSA 57:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11" />Ee, Magennoo! Iimuwwati hana kubisemi;</para>
  <para style="q2" vid="PSA 57:11">gaachchanni atikinna butta duuchcha'n hedhowwaal.<note caller="-" style="x"><char style="xo" closed="false">57:11 </char><char style="xt" closed="false"><ref loc="1SA 22:1">1 Sam. 22:1</ref>; <ref loc="1SA 24:3">24:3</ref>. </char></note><verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="s1">Mageni Fuggaalleeyye Xixaashshsha Shiqqeexxa Soodachcho</para>
  <para style="d">Faarsaaleeyyetike Sooresi'a «Balleesitoxxe'e» Hiyyemaake Meellinni Faarsendaaxxa Daawwitixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 58:1" />Koo ha'no galichalluwwi dhugaandinni qullummatika haaso'a haasotina'ee?</para>
  <para style="q2" vid="PSA 58:1">Manjiinke belti'aa dhugaati murtina'nee?<verse eid="PSA 58:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2" />Waawwo'o! Ha'noo godobik dhugaate kaddebaaxxa yaane heddinaan;</para>
  <para style="q2" vid="PSA 58:2">bogi giddo hunnati manjoke'n kexxinaan.<verse eid="PSA 58:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3" />Fuggaalleessi manni amati goddobinaa'ninni gore'eeken;</para>
  <para style="q2" vid="PSA 58:3">insa'nee ilemeenxenninni deene'eekenna dharaammeeyyeten.<verse eid="PSA 58:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4" />Insa'nexxi ha'la dhudhdhufiinxe ha'lashshaten;</para>
  <para style="q2" vid="PSA 58:4">laqa gibbeexxi mansha ifixxa duuchchexxeemmaxxe buuteshsha,<verse eid="PSA 58:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5" />isee'e hawwi assaake manjika haaso'a</para>
  <para style="q2" vid="PSA 58:5">yookaan beeka gojaalessika hafuura laqa gibateeten.<verse eid="PSA 58:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6" />Ee, Magenoo! Isso insa'nexxa afo'o insa'nek giddo buttuchchi</para>
  <para style="q2" vid="PSA 58:6">Ee, Duuchchi Woddike Goottaa konne neenqishsha sodaachchisa'neeke mannika kallaada harcaasi.<verse eid="PSA 58:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7" />Yaa'eexxi sa'amake wodi'ishsha ba'nowwaal;</para>
  <para style="q2" vid="PSA 58:7">gabet darbatee qopheefantaa wodda mogidi insa'ek cirmowwaal.<verse eid="PSA 58:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8" />Me'itaa wodda cingita'n mudammaxxe haqanqaleshsha kandowwaal;</para>
  <para style="q2" vid="PSA 58:8">rerte ilendexxi ifake hiyyemaachcho uudebaaxxe anno kandowwaal.<verse eid="PSA 58:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9" />Insa'ne shamoxxi yookaan bagoxxi ute giirendebaa edi darre meshetanna eebbishebaa edi darre</para>
  <para style="q2" vid="PSA 58:9">diidalo filte adhdhite me'itammake huurishshaten.<verse eid="PSA 58:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10" />Qulliyye Mageni insa'ne'aa halo fulaa'naa'a uuddaa wodda</para>
  <para style="q2" vid="PSA 58:10">gammaddaan;</para>
  <para style="q2" vid="PSA 58:10">lekka ifixxanna dabaalleyyetixxe mundenni anshexxaan.<verse eid="PSA 58:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11" />Ookkone wodda manni,</para>
  <para style="q2" vid="PSA 58:11">«Dhugaaten, qulliyye hira alfite'een;</para>
  <para style="q2" vid="PSA 58:11">dhugaaten, buttate'n muraak Mageni hedheen» hiyyaan.<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="s1">Mageniinxe Heqqaxxee Shiqqeexxa Soodachcho</para>
  <para style="d">Faarsaaleeyyetike Sooresi'a «Balleessitoxxe'e» Hiyyemaake Meellinni Faarsendeexxa, Daawwitii'i Shiyyatee Manni Minne buqeexxi Isoo Heqqaashsha Sa'ooli Manna Ergee Wodda Daawwitixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 59:1" />Ee, Magenoo! Naapha ankenaa'ni anee gatisi;</para>
  <para style="q2" vid="PSA 59:1">ane'ni ke'a'neeke mannanaa'ninna anee heqqi.<note caller="-" style="x"><char style="xo" closed="false">59:1 </char><char style="xt" closed="false"><ref loc="1SA 19:11">1 Sam. 19:11</ref>. </char></note><verse eid="PSA 59:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2" />Fuggoxxa assaakeerinaa'n anee gatis;</para>
  <para style="q2" vid="PSA 59:2">manjiinxa munde dhangalaasaakeerinaa'n anee anjir.<verse eid="PSA 59:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3" />Kunse, insa'ne rinphe anee heqqe'na'neen,</para>
  <para style="q2" vid="PSA 59:3">Ee, Duuchchi Woddike Goottaa, mararte afebaak manni</para>
  <para style="q2" vid="PSA 59:3">balleessennechchi hedhebaang, hujennexxi cubbo hexxebaang ani'a mari'ate.<verse eid="PSA 59:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4" />Insa'nee balleessennechchi hedhebaang anee lollo'aa qophpheefante;</para>
  <para style="q2" vid="PSA 59:4">ati kinni anee gargaartotta'a ke'i, yaane anxanna uudi.<verse eid="PSA 59:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5" />Ee, Duuchchi Woddike Gootta, hunna duuchchike Isira'eelike Magenoo!</para>
  <para style="q2" vid="PSA 59:5">gosa gosaka arda duuchcha mura woxissottaa ke'i</para>
  <para style="q2" vid="PSA 59:5">xuurameessake kadebaakeenna fuggaaleessi manni'aa marartoxxe'e.<verse eid="PSA 59:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6" />Insa'nenna wonshiinsha gururaana'n hashsha hashsha</para>
  <para style="q2" vid="PSA 59:6">qachchi giddo doonaan.<verse eid="PSA 59:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7" />Afo'o insa'neekenaa'n fula'neeka haaso'a uudi;</para>
  <para style="q2" vid="PSA 59:7">arabi insa'nek qaremeeke wolaatichchan;</para>
  <para style="q2" vid="PSA 59:7">insa'nenna, «No'o hinaannexxa laqaak hedhebaan» hinaan.<verse eid="PSA 59:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8" />Ee, Duuchchi Woddik Goottaa! Ati kinni insa'nee'n osoldatton;</para>
  <para style="q2" vid="PSA 59:8">gosa gosake arda duuchcha'n gacifattaton.<verse eid="PSA 59:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9" />Ee, Magenoo! Anke uduudaa</para>
  <para style="q2" vid="PSA 59:9">anke golla kaddeettaxxee,</para>
  <para style="q2" vid="PSA 59:9">ani atete heqqedhannon.<verse eid="PSA 59:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10" />Mageni jaalala ifixxee ani edo me'aan;</para>
  <para style="q2" vid="PSA 59:10">isi anke naaphphixxa injifatemanna uudannoshsha assaan.<verse eid="PSA 59:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11" />Ee, Dada Duuchchike Goottaa no'oxxe wontee</para>
  <para style="q2" vid="PSA 59:11">ardi ank dedhemabaashsha, insa'ne shiltoxxe'e</para>
  <para style="q2" vid="PSA 59:11">hunna atixxen bogii'n boga insa'nee fulchite'e butti'a hiissi.<verse eid="PSA 59:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12" />Afo'o insa'nekenaa'n fulda'neexxe cubboxxee</para>
  <para style="q2" vid="PSA 59:12">arabi insa'ek haaso'a'neeke haaso'ixxee</para>
  <para style="q2" vid="PSA 59:12">hollati abidemowwaal;</para>
  <para style="q2" vid="PSA 59:12">badinotixxenna haasoneeke dharixxee,<verse eid="PSA 59:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 59:13" />mufeti insa'nee balleessi; shakki assitenna insa'nee bir;</para>
  <para style="q2" vid="PSA 59:13">ookko'n Mageni Ya'iqoobike ardike galchallo kadeexxa</para>
  <para style="q2" vid="PSA 59:13">butta duuchcha'n ege'nendaan.<verse eid="PSA 59:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14" />Insa'nenna worshiinsha gururaana'n hashsha hashsha</para>
  <para style="q2" vid="PSA 59:14">qachchi giddo doonaan.<verse eid="PSA 59:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15" />Indaachcho hasito doonsakiyya hinaan;</para>
  <para style="q2" vid="PSA 59:15">goddanna gonphoole guruuraanaan.<verse eid="PSA 59:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16" />Ati anke golla,</para>
  <para style="q2" vid="PSA 59:16">rakkotixxa barranna anxe kollo kaddettaxxxee</para>
  <para style="q2" vid="PSA 59:16">atike uduudixxee'e faarsannon;</para>
  <para style="q2" vid="PSA 59:16">gorsanna atixxe jaalalaxxee'e faarsannon;<verse eid="PSA 59:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17" />Ee, anke uuduudaa</para>
  <para style="q2" vid="PSA 59:17">faaroti atee saadannon;</para>
  <para style="q2" vid="PSA 59:17">Ee, Magenoo ati ank golli, anee eettaateke Magenon.<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="s1">Mageniinke Gargaarsi'a Shiqqeexxa Soodachcho</para>
  <para style="d">Faarsaleeyyetike Sooreesi'a. Kakoti Tsigeereda Hiyyemaake Meellinni Faarsendaaxxa. Dhugaa'a Kulatixxa. Daawwitixxe Barachchiissaxxa Faaro. Isi Arami'a Nahara'imikanna Arami Zo'aka Manna Lolee Wodda Iyyo'aab Ille Iima Higeexxi Maxinetixxe Dhooqa'n Tommenna Lame Kuma Eedoomika Manna Biree Wodda Faarseexxa.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 60:1" />Ee, Magenoo! Ati no'o hunde waldette;</para>
  <para style="q2" vid="PSA 60:1">no'o butuchchittette;</para>
  <para style="q2" vid="PSA 60:1">no'o'n mufatete; ta'a kinni no'oo ifibaa hiissedhi.<verse eid="PSA 60:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2" />Eettene Butta le'missette, dhodhdhoosetexxinna lameba hashakki hittaashsha assiteten;</para>
  <para style="q2" vid="PSA 60:2">isenna girgir hiteexxi dhodhdhooteemmaxxee hiissite'e isee sumi.<verse eid="PSA 60:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3" />Ardi atik abara uudashsha assittette;</para>
  <para style="q2" vid="PSA 60:3">woyinetixxi booka no'oo machchoosite'e gatantarsito'aa ha'winannoshsha assittetten.<verse eid="PSA 60:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4" />Yaane kinni naaphiinxe gabenaa'n fullaashsha,</para>
  <para style="q2" vid="PSA 60:4">ate sodaatakeeri'a iimi'a abixxinaaka baandira insa'ne'aa uuttette.<verse eid="PSA 60:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5" />Eettaatek atik ardi no'o anjiremmonaa'a</para>
  <para style="q2" vid="PSA 60:5">atixxe middixxe anganni no'oo anjirte'e hiissichcho no'aa uwwi.<verse eid="PSA 60:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6" />Mageni ifixxa woyyitte bakka'ni hedhe hiyye haaso'ee qici,</para>
  <para style="q2" vid="PSA 60:6">«Injifatennexxi Sekemika boga qoqqooddannon;</para>
  <para style="q2" vid="PSA 60:6">Sukootixxa dhooqanna mikannon,<verse eid="PSA 60:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7" />Gele'adik bogi anken; bogi Minaasekinna anken;</para>
  <para style="q2" vid="PSA 60:7">Efireemi umoke'n uggudhdhannoxxe anxe sibljiinxe gullen;</para>
  <para style="q2" vid="PSA 60:7">Yihudanna anxe mootummaxxe bokkon.<verse eid="PSA 60:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8" />Mo'aabik bogi anxe anshecatixxe bakkan;</para>
  <para style="q2" vid="PSA 60:8">Eedoomik boginna anke kadeexxa kokeessatee'e kophe anxa itti qolanchannon;</para>
  <para style="q2" vid="PSA 60:8">Filisixxeemike boga'n injifachchoti illillisannon.»<verse eid="PSA 60:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9" />Kinjiinke dalla'ike qachchibaa ayyete anee iyyemaraa?</para>
  <para style="q2" vid="PSA 60:9">Lolonnaa'a Eedoomibaa ayyete anee akeeka?<verse eid="PSA 60:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10" />Ee, Magenoo no'oo hunde waldette;</para>
  <para style="q2" vid="PSA 60:10">no'oke lolinke manninni duuliinbaa fula gibbette;<verse eid="PSA 60:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11" />Manjiink gargaarsi dharaken,</para>
  <para style="q2" vid="PSA 60:11">naapha no'oke'ni injifachcho alfinnonnaa'a no'oo gargaar.<verse eid="PSA 60:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12" />Mageniinxe hirrenni injifachcho alfinnannon,</para>
  <para style="q2" vid="PSA 60:12">naapha no'oka no'aa hirbeesaak isoten.<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="s1">Gargaarsakee Soodatendeexxa Soodachcho</para>
  <para style="d">Faarsaleeyyetike Sooresi'a kiraaruwwik Daawwitixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 61:1" />Ee, Magenoo! Raare anxa caqasi;</para>
  <para style="q2" vid="PSA 61:1">soodachcho anxanna laqi.<verse eid="PSA 61:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2" />Jibbaate gophe'e</para>
  <para style="q2" vid="PSA 61:2">buttatike kasanaa'n atiba'aa raarannen,</para>
  <para style="q2" vid="PSA 61:2">lumoke kinji hana anee'e sa'issi.<verse eid="PSA 61:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3" />Ati anke gollan;</para>
  <para style="q2" vid="PSA 61:3">naaphakenaa'n itti baajannoxxe anxe jabaxxe xeleephphon.<verse eid="PSA 61:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4" />Baro anka duuchcha duunkaana atik giddo hedha'n atixxe heqqa hunda gollatannoke anee'e assi.<verse eid="PSA 61:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5" />Ee, Magenoo! Ati werreegenneka werreega laqqe'eeten;</para>
  <para style="q2" vid="PSA 61:5">atika summa sodaataake manni'a uuttetteka qoobbo ani'anna uutteetten.<verse eid="PSA 61:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6" />Moyanjiinka hedhotika baro qeers;</para>
  <para style="q2" vid="PSA 61:6">wogga isixxanna ilatenaa'n heddo ila qico'n lebi.<verse eid="PSA 61:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7" />Ati edo baro duuchcha moyaashsha assi;</para>
  <para style="q2" vid="PSA 61:7">atixxe duuchchi woddixxe jaalalanninna xuurameessumma atixxenni isoo heqqi. <verse eid="PSA 61:7" /><verse number="8" style="v" sid="PSA 61:8" />Werreegenneka werreega barra barra'ninni shiqishannon,</para>
  <para style="q2" vid="PSA 61:8">duuchchi woddanna summa atika galatiinxe faaronni saadannon.<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="s1">Magenxe Heqqa'n Addata</para>
  <para style="d">Faarsaleeyyetike Sooresi'a Edotaami'a, Daawwitixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 62:1" />Anee wodaak isonni callaa kadeemmaxxee'e</para>
  <para style="q2" vid="PSA 62:1">Mageno ossat heqqedhannon.<verse eid="PSA 62:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2" />Iso callan anxi rassanna anee wodaak;</para>
  <para style="q2" vid="PSA 62:2">golla anke kademmaxxeenna haranga shokki hiyyabe'non.<verse eid="PSA 62:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3" />Dooqeexxe gimoshshanna lele'meeke dalla'ishsha hunna afebaaka manjo, ha'no duuchiing isoo'o loldina'n haani qico'ni rakkissina'ni hexxina?<verse eid="PSA 62:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4" />Insa'ne hansaachchi ulifinna isikenaa'n isoo'o salphisateeten; iso'ni dhara haaso'ate eenaan; afo'ik eebbinsa'nee godobi giddo kinni yowwinaan.<verse eid="PSA 62:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5" />Anxe lubboo! Mageno calla sammi hite heqqedhi; isoo addatanna waalabe'no.<verse eid="PSA 62:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6" />Anixxi rassanna anee wodaake</para>
  <para style="q2" vid="PSA 62:6">golla anke kademmaxxee haranga shokki hiyyabe'no.<verse eid="PSA 62:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7" />Anee anjire'e ulfatannoshsha asseek Magenoken; Isi anxe rassanna anke gollan.<verse eid="PSA 62:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8" />Koo ardaa! Mageno addatte; isi golla no'oke kadeemmaxxee ha'nooke godobika yaada duuchcha iso'n ku'le.<verse eid="PSA 62:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9" />Manjiink belti diidallotishshaten;</para>
  <para style="q2" vid="PSA 62:9">manji duuchchi toliinken;</para>
  <para style="q2" vid="PSA 62:9">isi kiiloti hana uggeme kiilemeele</para>
  <para style="q2" vid="PSA 62:9">diidallotishshaa midde a'urabaan;<verse eid="PSA 62:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10" />Saamik adhdhitineexxe yaane'n addatinnoqqe'e;</para>
  <para style="q2" vid="PSA 62:10">moodhitineexxe yaannenni ifi saadinnoqqe'e;</para>
  <para style="q2" vid="PSA 62:10">karra ha'nooxxi bira saxxoole midde ise'ni ille uggudhdhitinnoqqe'e.<verse eid="PSA 62:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11" />Mageni mittele haaoso'eedheen</para>
  <para style="q2" vid="PSA 62:11">aninna lame yaane laqenne; hunna Mageniixxen,<verse eid="PSA 62:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 62:12" />Ee, Dada Duuchchike Goottaa duuchchi woddixxe jaalala atixxenni;</para>
  <para style="q2" vid="PSA 62:12">ati duuchchingee'e huje hujeshshanni hira uuttatton.<note caller="-" style="x"><char style="xo" closed="false">62:12 </char><char style="xt" closed="false"><ref loc="JOB 34:11">Iyo. 34:11</ref>; <ref loc="JER 17">Erm. 17</ref>; <ref loc="JER 10">10</ref>; <ref loc="MAT 16:27">Mat. 16:27</ref>; <ref loc="ROM 2:6">Rom. 2:6</ref>; <ref loc="REV 2:23">Wal. 2:23</ref>. </char></note><verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="s1">Mageno Halsaa</para>
  <para style="d">Qiilla Gammooje'n Hedhemma Wodda Daawwitixxa Faaro.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1" />Ee, Magenoo! Ati anke Magenon;</para>
  <para style="q2" vid="PSA 63:1">ani atee mitte godobinni halcheennen; xeena gopheexxi</para>
  <para style="q1" vid="PSA 63:1">Lameba wa'aa hiyyeemmake buttinishsha</para>
  <para style="q2" vid="PSA 63:1">lubbo anxi atee dheeboteen;</para>
  <para style="q1" vid="PSA 63:1">Aninna atee yora'eennen.<verse eid="PSA 63:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2" />Atixxe woyyitte bakka'n atee afenne;</para>
  <para style="q2" vid="PSA 63:2">hunna atixxanna ulfinna atika uudenne.<verse eid="PSA 63:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3" />Duuchchi woddixxi atixxi jaalala hedhotenaa'n midde</para>
  <para style="q2" vid="PSA 63:3">caaldeexxe kaddeemmaxxee'e afo'i ank atee saada'neen.<verse eid="PSA 63:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4" />Hedhenneke baro duuchcha'n atee saadannon;</para>
  <para style="q2" vid="PSA 63:4">anga anxa atibaa ke'isee summa atika ye'edhannon.<verse eid="PSA 63:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5" />Manji eloxxa ita iteexxi godde gammadammashsha</para>
  <para style="q2" vid="PSA 63:5">lubbo anxi ate'n gammaddaan;</para>
  <para style="q2" vid="PSA 63:5">afo'i ankinna gammada'n faaroti atee saadaan. <verse eid="PSA 63:5" /><verse number="6" style="v" sid="PSA 63:6" />Ma'nanni hedhe'e atende qalli hiyyannon; hashsha duuchchanna atee hedannon.<verse eid="PSA 63:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7" />Ati anke gargaarsanjo kaddeettaxxee boba atixxi hunda hedhee'e gammadiinxe faaronni atee faarsaannen.<verse eid="PSA 63:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8" />Lubbo anxi ate'ni maxxande'een; atixxi middixxi anganna anee'e kiphphee abidde'een.<verse eid="PSA 63:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9" />Anee shiyatee hasaak duuchchi hirreessa hundike'n sa'aan.<verse eid="PSA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10" />Insa'nenna bagedoke'n rennaan; jeedaluwwiinxe itanna kandaan.<verse eid="PSA 63:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11" />Moyanji kinni Magenoke'n gammadaan; Mageniinke summinni kakataak duuchchinna Mageno saadaan; dhariyye kinni afo'o duuddaan.<note caller="-" style="x"><char style="xo" closed="false">63:11 </char><char style="xt" closed="false"><ref loc="1SA 23:14">1 Sam. 23:14</ref>. </char></note><verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="s1">Gargaarsakee'e Soodatendeexxa Soodachcho</para>
  <para style="d">Faarsaleeyyetike Sooresi'a Daawwitixxa Faaro.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1" />Ee, Magenoo! Rakkateexxi atiba'aa soodatanno wodda laqi;</para>
  <para style="q2" vid="PSA 64:1">naaphi anki anee sodaachchise'eeni anee heqqi.<verse eid="PSA 64:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2" />Fuggaaleeyyetixxe fuggooxxe mari'enaa'ninna fuggoxxa asso'a bukki hiyyeemmake mannanaa'n anee gatisi.<verse eid="PSA 64:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3" />Insa'nek arrabi wolaantichchiinsha qare'eeken;</para>
  <para style="q2" vid="PSA 64:3">manjo iddaaka haaso'anna gabetishsha darbinaan.<verse eid="PSA 64:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4" />Insa'ne'e golanteexxi balleessa afebaa manjo</para>
  <para style="q2" vid="PSA 64:4">soda'a belo dedhanga iddinaan.<verse eid="PSA 64:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5" />Hendeemmaka fuggoka yaada bakka geessinso'a mari'antaan;</para>
  <para style="q2" vid="PSA 64:5">fonxoro insa'neexxa haba ugginaaxanna hendaan;</para>
  <para style="q2" vid="PSA 64:5">insa'nenna tennee duuchcha assinaa wodda, «Ayyinna no'oo afaaki hedhebaan» hina'neeten.<verse eid="PSA 64:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6" />Insa'ne fuggoxxa assino'aa hende;</para>
  <para style="q2" vid="PSA 64:6">«Godobi giddonna mancira hiyyendaaxxa fuggoxxa yaane assinnannon!» hine;</para>
  <para style="q1" vid="PSA 64:6">Kunni manjiinki yaadinna hedumi isik</para>
  <para style="q2" vid="PSA 64:6">fuggoxxenni wo'meeke kadeexxa ege'nishaan.<verse eid="PSA 64:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7" />Mageni kinni gabe ifixxa insa'ne'n darbaan; insa'nenna dedhange'n madoonnaan.<verse eid="PSA 64:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8" />Mageni afo'o insa'neekenaa'n fuldeemmanxi insa'neenni wirri hite'e balleessitashsha assaan;</para>
  <para style="q2" vid="PSA 64:8">insa'nee uudeek duuchchinna geeqishsha'ni umo insa'ne'ni le'misaan.<verse eid="PSA 64:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9" />Manji duuchchi sodataan; Mageniinxa huje lalaba'n asseexxa yaanenna hedaan.<verse eid="PSA 64:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10" />Qulliyye Duuchchi Woddike Gootta'n gammaddowwaal;</para>
  <para style="q2" vid="PSA 64:10">isoo gollake assexxowwaal;</para>
  <para style="q2" vid="PSA 64:10">qajeeli manni duuchchinna isoo saadowwaal.<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="s1">Mageno Saadanna Galateefataa</para>
  <para style="d">Faarsaleeyyetike Sooreesi'a Daawwitixxa Galatiinxa faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 65:1" />Ee, Magenoo! Tsiyooni giddo atee'e saadonna'a, werreegenaka werreeganna ati'a uwwa hassissaan.<verse eid="PSA 65:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2" />Ee, soodachcho laqqa'eetekee, manji duuchchi atibaa dagaan.<verse eid="PSA 65:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3" />Cubbo no'o'n bira saxxeemman;</para>
  <para style="q2" vid="PSA 65:3">ati kinni balleessa no'oxxa duuchcha gattowwaali hittetten.<verse eid="PSA 65:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4" />Fi'litetexxi atixxe woyyitte baxxe'n hedho'a ifibaa shikki assexxeteke mannixxa wodo;</para>
  <para style="q2" vid="PSA 65:4">no'onna atike minxe elollamma yaanuwwanna woyyitte atixxe bakkaxxe yaanen goddinannon.<verse eid="PSA 65:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5" />Ee, Mageno no'oke anjiralloo</para>
  <para style="q2" vid="PSA 65:5">mambe'iinxe qullummatixxe atixxe hujenni hiissiichcho no'aa uuttatton;</para>
  <para style="q2" vid="PSA 65:5">bayyixxe abbaayya wido hedheekiirinna gatebaang buttatik ardi duuchchi ate'n addataan.<verse eid="PSA 65:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6" />Jabeenne atikenni koobuwwa uurirseten;</para>
  <para style="q2" vid="PSA 65:6">hunnatanna oddo'wite'eeteken.<verse eid="PSA 65:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7" />Abbaayyatike danbala'ika luuljonna danbala'iinxa dhuqqachcho sammi assittatton;</para>
  <para style="q2" vid="PSA 65:7">gosa gosake ardixxa weekenshanna ca'li assittatton.<verse eid="PSA 65:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8" />Ati assittettexxa mambe'iinxa yaaaanuwwa buttatik ardi duuchchi sodataan;</para>
  <para style="q2" vid="PSA 65:8">buttatixxe gabalanaa'n buttatixxe gabala qico'n hedheek manni illillisaan.<verse eid="PSA 65:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9" />Xeena gansiisati butta affeten;</para>
  <para style="q2" vid="PSA 65:9">buttina shaqqishatton;</para>
  <para style="q2" vid="PSA 65:9">Mageniinxe muummuwwa'n wodi'i wo'maken;</para>
  <para style="q2" vid="PSA 65:9">tenneenna assittettexxe mannakee midha uuttette.<verse eid="PSA 65:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10" />Ko'emeeke fichchi'aa geyaaka xeena uuttatton;</para>
  <para style="q2" vid="PSA 65:10">isika dareera weli qixxeesittatton;</para>
  <para style="q2" vid="PSA 65:10">buttinakanna kiifoti shaqqishshatton;</para>
  <para style="q2" vid="PSA 65:10">mudhuwwikinna latee'e nophphaashsha assittatton.<verse eid="PSA 65:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11" />Arjumma atixxenni wogga eebbatixxe assittatton;</para>
  <para style="q2" vid="PSA 65:11">ati saxxeetebi duuchchi goddaken.<verse eid="PSA 65:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12" />Qiilla gammooje'ni bada'uwwatinna quffeen;</para>
  <para style="q2" vid="PSA 65:12">koobuwwatinna gammashsho oddo'wite.<verse eid="PSA 65:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13" />Diiduwwa duuchcha'n hori bobba'ee wo'maan;</para>
  <para style="q2" vid="PSA 65:13">dhooquwwa duuchchi midha calla kaddaan;</para>
  <para style="q2" vid="PSA 65:13">kunniichchuwwi gammade illillisa'nee faarsaan.<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="s1">Mageno Saadachchotixxanna Galateefatatixxa Faaro</para>
  <para style="q1">Faarsaleeyyetike Sooresi'a Ke'itiinxa Faarsendeexxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 66:1" />Butta duuchcha Magenoke illilli hituuni!<verse eid="PSA 66:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2" />Isike summike ulfinni'aa faarse;</para>
  <para style="q2" vid="PSA 66:2">uulfateeka galatanna isi'a uwwe.<verse eid="PSA 66:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3" />Mageno hitinaa qici, «Ati assitetexxi yaanuwwa hittatta manbe'iinxe!</para>
  <para style="q2" vid="PSA 66:3">Hunna atixxi yo'oshsha lumoxxe kaddeemmaxxee</para>
  <para style="q2" vid="PSA 66:3">atik naaphi atee sodaate'e cuqurto'aan.<verse eid="PSA 66:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4" />Buttate'n hedheek duuchchi ati'a heeshshi qokki hiyyaan;</para>
  <para style="q2" vid="PSA 66:4">galatiinxe faaronni atee saadaan;</para>
  <para style="q2" vid="PSA 66:4">summa atika saanda'n faarsaan.»<verse eid="PSA 66:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5" />Ammee, Mageni asseexxa duuchcha uudde;</para>
  <para style="q2" vid="PSA 66:5">isi manjiinke belti giddo mambe'a yaane asse'een.<verse eid="PSA 66:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6" />Isi abbaayya lameba shate;</para>
  <para style="q2" vid="PSA 66:6">edik no'ok annuwwi lekkati bagobaa'ni Yordaanosik galaana foonfeen;</para>
  <para style="q1" vid="PSA 66:6">No'onna isi asseexxe yaanexxee gammandeennen.<note caller="-" style="x"><char style="xo" closed="false">66:6 </char><char style="xt" closed="false"><ref loc="EXO 14">Fula. 14</ref>; <ref loc="EXO 21">21</ref>; <ref loc="JOS 3:14-17">Iya. 3:14-17</ref>. </char></note><verse eid="PSA 66:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7" />Isi Hunna ifixxenni duuchchi wodda moyaan;</para>
  <para style="q2" vid="PSA 66:7">ille isixxi gosa gosaka arda hubatee uudaan;</para>
  <para style="q2" vid="PSA 66:7">yoonna iso'ni ke'ak manni meenni ifi lummisowwaal.<verse eid="PSA 66:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8" />Koo ha'noo gosa gosaki ardi duuchchi Mageno no'oka saadde;</para>
  <para style="q2" vid="PSA 66:8">hafuura gikki assitine'e isoo saadde.<verse eid="PSA 66:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9" />Isi hedhoti he'nannoshsha heqqe'een;</para>
  <para style="q2" vid="PSA 66:9">inbannoshanna assebaan.<verse eid="PSA 66:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10" />Magenoo! Ati no'o hega uudeeten;</para>
  <para style="q2" vid="PSA 66:10">birretika sibilji finiine'e luqqi hiyyammashsha,</para>
  <para style="q2" vid="PSA 66:10">ati no'oo luqqi assittetten.<verse eid="PSA 66:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11" />Fonxoro no'oo abiddaashsha assite'e</para>
  <para style="q2" vid="PSA 66:11">a'urto ba'onna no'o'n feettette.<verse eid="PSA 66:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12" />Manni no'oo hana me'aashsha assitetteni;</para>
  <para style="q2" vid="PSA 66:12">giira giddii'ninna lolali giddii'n sa'nenne;</para>
  <para style="q2" vid="PSA 66:12">ta'a kinni goddi wo'meexxe bakka'n no'oo iyyedagetten.<verse eid="PSA 66:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13" />Ciincatika tolcha adhdhe mine atike'n e'yya'nee'e</para>
  <para style="q2" vid="PSA 66:13">werreegennaka werreeganna ati'a shiqishaannen.<verse eid="PSA 66:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14" />Kunni werreegi rakkatenna wodda arabi ank haaso'eeke</para>
  <para style="q2" vid="PSA 66:14">afo'o ankenaa'n fuleeken.<verse eid="PSA 66:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15" />Ha'yo hore ati'a ciinceessannon;</para>
  <para style="q2" vid="PSA 66:15">iittanni gedhebiinke korbeessika fishaka tolcha ati'a shiqishaanon;</para>
  <para style="q2" vid="PSA 66:15">kormakanna re'etika korbeessuwwa ati'a tolchannon.<verse eid="PSA 66:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16" />Mageni ani'a asseexxa duuchcha kulonna'aa Mageno sodaatinaa'neeki duuchchi amme laqqe.<verse eid="PSA 66:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17" />Hafuura anka gikki asse'e oodhdhe'e isoo soodatenne;</para>
  <para style="q2" vid="PSA 66:17">afo'o ankenninna isoo saadenne.<verse eid="PSA 66:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18" />Hujennexxa Cubbo aadde aaga gophe'e,</para>
  <para style="q2" vid="PSA 66:18">godoba uggudheennele Dada Duuchchik Gootti soodachcho anxa laqammabaan.<verse eid="PSA 66:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19" />Ta'a kinni dhugaaten, Mageni laqe'een;</para>
  <para style="q2" vid="PSA 66:19">soodachcho anxanna caqase'een.<verse eid="PSA 66:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20" />Soodachcho anxa tuffatebaake,</para>
  <para style="q2" vid="PSA 66:20">duuchchi wodda anee eeyya'neek</para>
  <para style="q2" vid="PSA 66:20">Mageni isi galatik saademmowwaal.<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="s1">Galatiinxa Faaro</para>
  <para style="q1">Faarsaleeyyetike Sooreesi'a Kiraaruwwik Faarsendeexxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 67:1" />Mageni no'aa mararowwaal, no'oo eebisowwaal;</para>
  <para style="q2" vid="PSA 67:1">albi atiki no'aa faddaddi hiyyowwaal.<verse eid="PSA 67:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2" />Butta duuchchi ora atika egendowwaal;</para>
  <para style="q2" vid="PSA 67:2">gosa gosaki ardi duuchchinna woda atixxa ege'nowwaal.<verse eid="PSA 67:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3" />Ee, Mageno ardi atee saadowwaal;</para>
  <para style="q2" vid="PSA 67:3">gosa gosaki ardi duuchchi isoo saadde.<verse eid="PSA 67:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4" />Ardake'n dhugaati murta'eetexxeenna</para>
  <para style="q2" vid="PSA 67:4">buttatika gosa gosaka arda duuchcha akeekaattaxxee,</para>
  <para style="q2" vid="PSA 67:4">ardi gammada'n illillisowwaal.<verse eid="PSA 67:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5" />Ee, Magenoo ardi atee saadowwaal;</para>
  <para style="q2" vid="PSA 67:5">gosa gosaki ardi duuchchi isoo saadde.<verse eid="PSA 67:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6" />Butta midha fulchite;</para>
  <para style="q2" vid="PSA 67:6">Duuchchi Woddik Gootti Mageni, no'oo eebisaan.<verse eid="PSA 67:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7" />Mageni no'oo eebisaan;</para>
  <para style="q2" vid="PSA 67:7">buttatik ardi duuchchi isoo sodaataan.<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="s1">Injiffachchotixxa Faaro</para>
  <para style="q1">Faarsaleeyyetike Sooresi'a Daawwitixxa Galatiinxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 68:1" />Mageni ke'owwaal; naaphi isikinna xeeremmowwaal;</para>
  <para style="q2" vid="PSA 68:1">isoo gibaakinna isi edii'n baajowwaal.<verse eid="PSA 68:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2" />Diidallo gandeexxi williille xeellaggammashsha</para>
  <para style="q2" vid="PSA 68:2">atinna insa'nee xeellagi;</para>
  <para style="q2" vid="PSA 68:2">gagaa giirate'n baqqammashsha fuggaaleeyyetinna iittanni Mageni edii'ni fugusendowwaal.<verse eid="PSA 68:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3" />Qulliyye kinni gammadduun;</para>
  <para style="q2" vid="PSA 68:3">Mageni edonna illillisowwaal;</para>
  <para style="q2" vid="PSA 68:3">gammashshoti burraaqqowwaal.<verse eid="PSA 68:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4" />Magno faarse, summa isikanna faaroti saadde;</para>
  <para style="q2" vid="PSA 68:4">duumanchii hana me'aaka ora giise</para>
  <para style="q2" vid="PSA 68:4">summi isikinna Duuchchi Woddike Goottann;</para>
  <para style="q1" vid="PSA 68:4">Isi edonna gammadde.<note caller="+" style="f"><char style="fr" closed="false">68:4 </char><char style="ft" closed="false">Duumanchake'ni yookaan qiilla gammojje'ni ora qophpheese. </char></note> <verse eid="PSA 68:4" /><verse number="5" style="v" sid="PSA 68:5" />Woyyitte ifixxe bakka'n hedhaak Mageni, annakanna ama affebbaaxxe oose'a annaken;</para>
  <para style="q2" vid="PSA 68:5">aro'i reyeexxe mellaalle'aanna dhugaati muraken.<verse eid="PSA 68:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6" />Qofi hedhammakee'e horte uwwaan;</para>
  <para style="q2" vid="PSA 68:6">usuremeekaara tike fulcheexxi godde hedhaashsha assaan;</para>
  <para style="q2" vid="PSA 68:6">xaqartiyye kinni hollattaaxxe qiilla gammoojje giddo hexxaan.<verse eid="PSA 68:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7" />Ee, Magenoo! Ati arda atika akeekkatta wodda,</para>
  <para style="q2" vid="PSA 68:7">qiilla gammoojje giddo insa'nenni welti me'ittatta wodda,<verse eid="PSA 68:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8" />Siinaxxe koobake Mageni edo,</para>
  <para style="q2" vid="PSA 68:8">Isira'eelike Mageni edo,</para>
  <para style="q1" vid="PSA 68:8">Butta lele'mite;</para>
  <para style="q2" vid="PSA 68:8">xeenikinna iimatenaa'ni gane.<note caller="-" style="x"><char style="xo" closed="false">68:8 </char><char style="xt" closed="false"><ref loc="EXO 19:18">Fula. 19:18</ref>. </char></note><verse eid="PSA 68:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9" />Yo'oka xeena gansiise'e bageemmaka boga hedho hiissittette. <verse eid="PSA 68:9" /><verse number="10" style="v" sid="PSA 68:10" />Ardi atikinna ookone boga'ni ofo'le;</para>
  <para style="q2" vid="PSA 68:10">arjumma atixxenn hiyyeeyyetee'e hasiisaachcho duuchchanna qophpheessittette.<verse eid="PSA 68:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11" />Dada Duuchchike Gootti lallabeen;</para>
  <para style="q2" vid="PSA 68:11">heddo melaalle odoo sa'isitte:<verse eid="PSA 68:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12" />«Moyanjuwwi ifike loliinke manninni welti udu'mi'a rake baaje!</para>
  <para style="q2" vid="PSA 68:12">Mine gatteemmaxxi melaalle booji'o qoodende.<verse eid="PSA 68:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13" />Gedhebo aalalo'a uduma gate'eemmaki manni misilluwwa keelluwwi isike birretike sibljinni buqemeexxa,</para>
  <para style="q2" vid="PSA 68:13">yo'oshsha calacala hitaaxxe worqenni giissendeexxe guchchuwwaxxe misilexxa guuggenna melaalle qoodendaa wodda diiphine'eeman.»<verse eid="PSA 68:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14" />Dada Duuchcha ajajaak Duuchchi Wooddik Gootti moyanjuwwa xeeree wodda,</para>
  <para style="q2" vid="PSA 68:14">kaade Tsalimoonixxe kooba'n ibbashsha asse.<verse eid="PSA 68:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15" />Basaanxi kooba yo'oshsha qeeraxxe kooban;</para>
  <para style="q2" vid="PSA 68:15">ise'ni heddo xunguwwanna hexxemman.<verse eid="PSA 68:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16" />Tee heddo xungoxxe koobaa,</para>
  <para style="q2" vid="PSA 68:16">Mageni itti hedho'a fi'leemmaxxe,</para>
  <para style="q2" vid="PSA 68:16">Duuchchi Woddik Gootti duuchchi wodda hedhaaxxe koobaba'aa mayeete hinaaffeti uuddaattechchi?<verse eid="PSA 68:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17" />Mageni heddi kumi mine'n lakko'emaake,</para>
  <para style="q2" vid="PSA 68:17">lummollamma ifike sarageeluwwinni welti Siinaa'n ifixxee woyyitte bakkabaa dagaan.<verse eid="PSA 68:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18" />Ee, Duuchchi Woddike Goottaa Magenoo!,</para>
  <para style="q2" vid="PSA 68:18">ati atike alke minibaa me'ittette wodda booji'o adhdhite'e me'ittette;</para>
  <para style="q2" vid="PSA 68:18">xaqartiyyetinna midde gattebaang manna duuchchanaa'n uwwa adhdhittette.<note caller="-" style="x"><char style="xo" closed="false">68:18 </char><char style="xt" closed="false"><ref loc="EPH 4:8">Efe. 4:8</ref>. </char></note><verse eid="PSA 68:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19" />Barra barra'ninni ba'o no'oxxa ba'edhaak Dada Duuchchik Gootti, Mageni anjiralli no'ok saadeemmowwaal.<verse eid="PSA 68:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20" />Mageni no'ok anjiraake Magenon;</para>
  <para style="q2" vid="PSA 68:20">reyotenaa'ninna gantannoshsha assaake Duuchchi Woddike Gootta Magenon.<verse eid="PSA 68:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21" />Mageni dhugaaten, ifike naaphika umo cancaqaan;</para>
  <para style="q2" vid="PSA 68:21">xaqartiyye cubbo hujjaaxxike umika qoonjonna butuchchaan.<verse eid="PSA 68:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22" />Dada Duuchchik Gootti hiyyee qici, «Naapha atika Baasaninaa'ninna</para>
  <para style="q2" vid="PSA 68:22">abbayyaatixxe dhi'monaa'ni illee iima hiisee'e iyyeedagannon.<verse eid="PSA 68:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23" />Ati munde insa'neexxa haxxa'n saxxaatton;</para>
  <para style="q2" vid="PSA 68:23">worshuwwi atikinna qoobbo ifika munde arraaphphaan.»<verse eid="PSA 68:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24" />Ee, Magenoo, atike ulfiink me'inji leelle;</para>
  <para style="q2" vid="PSA 68:24">tinninna Mageni ankinna moyanji ank ifike galmibaa asse'neeke ulfiinke me'injon.<verse eid="PSA 68:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 68:25" />Faarsaleeyye edii'ni,</para>
  <para style="q2" vid="PSA 68:25">faarotika miya geebaakiir udumii'n,</para>
  <para style="q2" vid="PSA 68:25">okole ganaammak dubarri oddo insa'nexxe'n hedheman.<verse eid="PSA 68:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 68:26" />Duuchchi Woddike Goottixxe tuuta giddo isoo saadde! Isira'eelik ardi bukki hiyyeeba Duuchchi Woddika Gootta saadde!<verse eid="PSA 68:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27" />Ediseexxi laakkosiki heeno'meeki Biniyaamik gosati minik ardi leelle;</para>
  <para style="q2" vid="PSA 68:27">ookko'n Yihudake gosati miniki akeekisanjuwwi ifike ardinni welti leelle;</para>
  <para style="q2" vid="PSA 68:27">udu'meexxi Zaabiloonikinna Nefitaalemike gosati mink akeekisanijuwwi leelle.<verse eid="PSA 68:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28" />Ee, Magenoo! Ati hunna atixxa ajaji;</para>
  <para style="q2" vid="PSA 68:28">konneechchi edo no'aa assiteteshshanni atixxa hirre leellishshi.<verse eid="PSA 68:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29" />Iyyerusaalemi hedheeke atike galmixxee'e</para>
  <para style="q2" vid="PSA 68:29">moyanjuwwi uwwa ati'a iyyedagaan.<verse eid="PSA 68:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30" />Gibtseka arda, shonbooqi giddo hedheeke biniichchishsha xixi;</para>
  <para style="q2" vid="PSA 68:30">korometanna jabbuwwa fakkaataaka gosa gosaka arda xixi;</para>
  <para style="q2" vid="PSA 68:30">duuchching ati'a guluffate'e birretika ifika siblijo ati'a iyyedagaashsha assi;</para>
  <para style="q2" vid="PSA 68:30">bagedo ibiso'a hasa'neeka gosa gosaka ardanna xeeri.<verse eid="PSA 68:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31" />Erganjuwwi Gibtsee'n dagaan;</para>
  <para style="q2" vid="PSA 68:31">Tophiyikinna anga ifixxa Mageniinbaa ke'issaan.<verse eid="PSA 68:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32" />Buttatixxi mootummuawwa duuchchi Mageno saadde;</para>
  <para style="q2" vid="PSA 68:32">saadinotixxa faaro</para>
  <para style="q2" vid="PSA 68:32">Dada Duuchchike Gootti'a faarse.<verse eid="PSA 68:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33" />Olminaa'n hexxeemmaxxe iimuwwa hana me'aaka faarse;</para>
  <para style="q2" vid="PSA 68:33">dindiime'e haaso'a'neekanna isoo caqasse.<verse eid="PSA 68:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34" />Gaachchanni isik Isira'eeli hana,</para>
  <para style="q2" vid="PSA 68:34">hunna isixxinna iimate'n hedheeke Mageniinxa hunna lallabe.<verse eid="PSA 68:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35" />Ee, Mageni ifixxe woyyitte bakka giddo sodaachchisa'neen;</para>
  <para style="q2" vid="PSA 68:35">isi arda ifike Isira'eeli'a jabeennakanna hunna uwwaan.</para>
  <para style="q1" vid="PSA 68:35">Mageni saademmowwaal.<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="s1">Gargaarsakee Soodandeexxa Soodachcho</para>
  <para style="d">Faarsaleeyyetike Sooresi'a «Daraa» hiyyemaake meelinni Daawwitixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 69:1" />Wodi'i goonbi qico'n anee buqeemmaxxe'e</para>
  <para style="q2" vid="PSA 69:1">Ee, anke Magenoo anee gargaar!<verse eid="PSA 69:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2" />Ani caffa'a giddo lixe'eennen;</para>
  <para style="q2" vid="PSA 69:2">lekka anxi uurritaaba gophphe'een;</para>
  <para style="q2" vid="PSA 69:2">dhi'mo woddi'iinxi giddo lixe'eennen;</para>
  <para style="q2" vid="PSA 69:2">wodi'i anee liqinse'een.<verse eid="PSA 69:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3" />Oodhatenaa'ni kexxeexxa shaqqeennen;</para>
  <para style="q2" vid="PSA 69:3">quumme anxinna madootte;</para>
  <para style="q2" vid="PSA 69:3">anka Magenoo heqqedhaa'naanni ille anxi garjite.<verse eid="PSA 69:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4" />Tolanga anee gibaaki,</para>
  <para style="q2" vid="PSA 69:4">anke umike ordichchi caala bira sa'eeken;</para>
  <para style="q2" vid="PSA 69:4">naaphi anee shiyo'a hasa'neeek,</para>
  <para style="q2" vid="PSA 69:4">tola boddichcha anee gibaak heddoken;</para>
  <para style="q2" vid="PSA 69:4">moodhebe'nolcho habaa'n aadhe hiissanno?<note caller="-" style="x"><char style="xo" closed="false">69:4 </char><char style="xt" closed="false"><ref loc="PSA 35:19">Far. 35:19</ref>; <ref loc="JHN 15:25">Yoh. 15:25</ref>. </char></note><verse eid="PSA 69:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5" />Ee, Magenoo! Haakito anka ati egendeeten;</para>
  <para style="q2" vid="PSA 69:5">balleesa anxi atenaa'n sho'ondeexxebaan.<verse eid="PSA 69:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6" />Isira'eelike Magenoo!</para>
  <para style="q2" vid="PSA 69:6">atee addataak anxe buuto'a mee shookowwaal;</para>
  <para style="q2" vid="PSA 69:6">Ee, Dada Duuchcha Ajajaatoke Duuchchi Woddike Gootta Magenoo</para>
  <para style="q2" vid="PSA 69:6">atee harsaakiiri anxe buutonaa'ni kexxeexxa mee salphattowwaal.<verse eid="PSA 69:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7" />Ani atixxee hiyyee yowwichcho osse'eennen;</para>
  <para style="q2" vid="PSA 69:7">shooko odo'we'eennen.<verse eid="PSA 69:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8" />Anke dayyuwwixxe oddo'ni mannake,</para>
  <para style="q2" vid="PSA 69:8">anke godobike dayyuwwi'aanna alagake kadeennen.<verse eid="PSA 69:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9" />Atike minixxi eloxxi hinaaffe giiratishsha anee gubbe;</para>
  <para style="q2" vid="PSA 69:9">atee yowwinaammaki yowwichchinna ane'n geye.<note caller="-" style="x"><char style="xo" closed="false">69:9 </char><char style="xt" closed="false"><ref loc="JHN 2:7">Yoh. 2:7</ref>; <ref loc="ROM 15:3">Rom. 15:3</ref>. </char></note><verse eid="PSA 69:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10" />Soodachchotee'e agabo goddo hosa'n oodhennexxee'e,</para>
  <para style="q2" vid="PSA 69:10">insa'ne anee yowwine.<verse eid="PSA 69:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11" />Yaadotee dooniyya seemma oddo'wenne wodda,</para>
  <para style="q2" vid="PSA 69:11">mammaasiinke kadenne.<verse eid="PSA 69:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12" />Songote'n ofo'laak anee hamateen,</para>
  <para style="q2" vid="PSA 69:12">machcho'alluwwi sirba'n anee yowwaan.<verse eid="PSA 69:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13" />Ee, Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 69:13">Ati eetteettexxe yanna'n atee soodatannon;</para>
  <para style="q2" vid="PSA 69:13">duuchchi woddixxe atixxe jaalalan,</para>
  <para style="q2" vid="PSA 69:13">atixxe dhugaatixxe anjiranni hiissichcho ani'a uwwi.<verse eid="PSA 69:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14" />Dhoqqe anee liqiinsitabaashsha anjir;</para>
  <para style="q2" vid="PSA 69:14">naapha ankenaa'ninna anee heqqi;</para>
  <para style="q2" vid="PSA 69:14">dhi'motenaa'ni anee fulchi.<verse eid="PSA 69:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15" />Lola'ii anee addhoqqe'e,</para>
  <para style="q2" vid="PSA 69:15">dhi'mo wodi'i anee liqiinsoqqe'e, balle anee ittoqqe'e.<verse eid="PSA 69:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16" />Ee, Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 69:16">Atixxi duuchchi woddixxi jaalaala eeloxxe kadeemmaxxee hiissichcho ani'a uwwi;</para>
  <para style="q2" vid="PSA 69:16">lumoxxe atixxe marartenni anbaa wirri hiyyi.<verse eid="PSA 69:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17" />Anee atika erganjo alba sho'exxoxxe'e;</para>
  <para style="q2" vid="PSA 69:17">lumoxxe rakko giddo hedhennen rakke ani'a hiissichcho uwwi.<verse eid="PSA 69:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18" />Anbaa shiqqe'e anee wodi; anke naaphixxe dhiibe'aa hitee anee fulchi.<verse eid="PSA 69:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19" />Hitte qico yowwemaanneexxa,</para>
  <para style="q2" vid="PSA 69:19">shookennexxanna salphatennexxa ati egende'eeten;</para>
  <para style="q2" vid="PSA 69:19">naaphi anki duuchchi atixxe ille edii'n sho'omeekebaan.<verse eid="PSA 69:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20" />Yowwichchi anee miidhe,</para>
  <para style="q2" vid="PSA 69:20">aninna godoba kultenne;</para>
  <para style="q2" vid="PSA 69:20">ani'a o'waaka manjo heqqedhennen kinni ayyinna hedhemmabaan;</para>
  <para style="q2" vid="PSA 69:20">anee jajjabeessaa manjo heqqedhennen,</para>
  <para style="q2" vid="PSA 69:20">kinni mittikinna hedhemmabaan;<verse eid="PSA 69:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21" />Itannolcho'n qaraaraachcho worre;</para>
  <para style="q2" vid="PSA 69:21">dheebo'wenne wodda majajaachcho uune.<note caller="-" style="x"><char style="xo" closed="false">69:21 </char><char style="xt" closed="false"><ref loc="MAT 27:48">Mat. 27:48</ref>; <ref loc="MRK 15:36">Mar. 15:36</ref>; <ref loc="LUK 23:36">Luq. 23:36</ref>; <ref loc="JHN 19:28-29">Yoh. 19:28-29</ref>. </char></note><verse eid="PSA 69:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22" />Inda'neexxi qore insa'ne'a fonxorote kaddo'o;</para>
  <para style="q2" vid="PSA 69:22">indeexxi itanna insa'ne'a suruurake kaddowwaal.<verse eid="PSA 69:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23" />Anfabaashsha ille insa'neexxa balleessi;</para>
  <para style="q2" vid="PSA 69:23">duuchchi woddanna xukkine he'naashsha assi.<note caller="-" style="x"><char style="xo" closed="false">69:23 </char><char style="xt" closed="false"><ref loc="ROM 11:9-10">Rom. 11:9-10</ref>. </char></note><verse eid="PSA 69:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24" />Jabaaxxe mufe atixinni insa'nee gan;</para>
  <para style="q2" vid="PSA 69:24">bubbaaxxi atixxi mufe insa'ne'n dirritowwaal.<verse eid="PSA 69:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25" />Bitum insa'neek onowwaal; dunkaana insa'neke'n mitti majinna hedhoqqeie.<note caller="-" style="x"><char style="xo" closed="false">69:25 </char><char style="xt" closed="false"><ref loc="ACT 1:20">Erga. Huj. 1:20</ref>. </char></note><verse eid="PSA 69:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26" />Ati gandeteka manni shorraan;</para>
  <para style="q2" vid="PSA 69:26">ati madoositteteke mannika abarra haasonaan.<verse eid="PSA 69:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27" />Balleessande'n belleessa lephphinaashsha waal;</para>
  <para style="q2" vid="PSA 69:27">insa'ne'aanna araarendoxxe'e.<verse eid="PSA 69:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28" />Summa insa'neeka hedhotike Maxaafanaa'n balleessi;</para>
  <para style="q2" vid="PSA 69:28">qullichchi manninni welti borreesemmoqqe'e.<note caller="-" style="x"><char style="xo" closed="false">69:28 </char><char style="xt" closed="false"><ref loc="EXO 32:32">Fula. 32:32</ref>; <ref loc="REV 3:5">Wal. 3:5</ref>; <ref loc="REV 13:8">13:8</ref>; <ref loc="REV 17:8">17:8</ref>. </char></note><verse eid="PSA 69:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29" />Ani kinni rakkonna abara uudeennen;</para>
  <para style="q2" vid="PSA 69:29">Ee, Magenoo! Anee heqqi, anee anjir.<verse eid="PSA 69:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30" />Mageniinka summa faaroti saadaannen;</para>
  <para style="q2" vid="PSA 69:30">galatiinxe faaronninna isoo lummisannon.<verse eid="PSA 69:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31" />Tinninna kormanna jibiichii caala Duuchchi Woddike Gootti'a gammachchiissaan.<verse eid="PSA 69:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32" />Rakkiyye manni tenne uuda wodda gammadaan;</para>
  <para style="q2" vid="PSA 69:32">Mageno halsitinaakiir jabaatte.<verse eid="PSA 69:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33" />Duuchchi Woddik Gootti rakkiyyetixxa soodachcho laqaa laqaan;</para>
  <para style="q2" vid="PSA 69:33">usuremeeka ifika ardanna waalabaan.<verse eid="PSA 69:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34" />Iimatinna butta, abbaayyatinna abbaayyuwwat giddo lele'maachchi duuchchi</para>
  <para style="q2" vid="PSA 69:34">Mageno saadowwaal.<verse eid="PSA 69:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35" />Mageni Tsiyoonii'i anjiraan;</para>
  <para style="q2" vid="PSA 69:35">Yihudaka qachchuwwanna qammalchaan.</para>
  <para style="q1" vid="PSA 69:35">Ookkoneechchi uduma ardi isikinna ookko hedhaa'ni bogakanna ifike assedhaan.<verse eid="PSA 69:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36" />Isike erganjuwwixxi hortenna ookkonee boga adhitaan;</para>
  <para style="q2" vid="PSA 69:36">isika summa eeyyaki duuchchi ookko hedhaan.<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="s1">Gargaarsakee'e Soodatendeexxa Soodachcho</para>
  <para style="q1">Faarsaleeyyetike Sooresi'a Mageni isoo'o qaabato'a Faarseendeexxa Daawwitixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 70:1" />Ee, Mageno anee anjir!</para>
  <para style="q2" vid="PSA 70:1">Duuchchi Woddike Goottaa rakke anee gargaar.<verse eid="PSA 70:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2" />Anee shiyo'a haasaki duuchchi shooke dommi hiyyowwaal;</para>
  <para style="q2" vid="PSA 70:2">anxa miidhensha eeyyaki duuchchi salphate udumi'a higowwaal.<verse eid="PSA 70:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3" />Bagganni! Hiyya'ni ane'ni gacifataak duuchchi shooke udumi'a higowwaal.<verse eid="PSA 70:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4" />Atee yoraak duuchchi gammadowwaal;</para>
  <para style="q2" vid="PSA 70:4">illillisowwaal;</para>
  <para style="q1" vid="PSA 70:4">Anjira atixxa eeyya'neek</para>
  <para style="q2" vid="PSA 70:4">duuchchi wodda, «Mageni lummedhuun» hiyyowwaal.<verse eid="PSA 70:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5" />Ani woyi fulabe'nokenna rakkichchaken;</para>
  <para style="q2" vid="PSA 70:5">Ee, Mageno rakke anbaa amo;</para>
  <para style="q1" vid="PSA 70:5">Ee, Duuchchi Woddike Goottaa! Anee gargaartattokinna anjirtattok atete kaddettaxxee turtoxxe'e!<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="s1">Mageniinxe Heqqa'a Soodatendeexxa Soodachcho</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 71:1" />Ee, Duuchchi Woddike Goottaa! Anee heqqittotta'a atiba'a dageennaxxee haranga anee shookishshoxxe'e!<verse eid="PSA 71:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2" />Qullumma atixxeenna anee gatise fulchi;</para>
  <para style="q2" vid="PSA 71:2">oodhishsha anxa laqqe'e anee anjiri.<verse eid="PSA 71:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3" />Ati ani itti baajannoxxe,</para>
  <para style="q2" vid="PSA 71:3">duuchchi wodda itti gollatannoxxe anxe rassa kadi;</para>
  <para style="q2" vid="PSA 71:3">ati anxe rassanna jabake golla kaddeettaxxee anee anjirtotta'a ajaja sa'issiteetten.<verse eid="PSA 71:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4" />Ee, anke Magenoo, fuggaaleeyyetixxe anganaa'ninna</para>
  <para style="q2" vid="PSA 71:4">mararte afebaake xaqartichiixxe anganaa'n anee fulchi.<verse eid="PSA 71:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5" />Ee, Lummoke Duuchchi Woddike Goottaa! Adde anxi ateten;</para>
  <para style="q2" vid="PSA 71:5">oosummatenaa'n telchi qico'n addette assedhdhaanekinna atenden.<verse eid="PSA 71:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6" />Anxe amake godobanaa'n ilemannoshsha assitteetek ateten;</para>
  <para style="q2" vid="PSA 71:6">ilemennexxenni telchi qico'n ate'n irkateennen;</para>
  <para style="q2" vid="PSA 71:6">aninna atee duuchchi wodda saadannon.<verse eid="PSA 71:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7" />Ani heddi mani'a fakkeennake kadeennen;</para>
  <para style="q2" vid="PSA 71:7">Ati ani'a jabake golla kade'eeten.<verse eid="PSA 71:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8" />Afo'i anki barra duuchcha atee ulfeesatinna saadat wo'meeken.<verse eid="PSA 71:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9" />Cimoti giddo anee deetoxxe'e; hunna gophanno wodda anee waaldoxxe'e.<verse eid="PSA 71:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10" />Anki naaphi fuggoxxe ani'a mari'ate'een;</para>
  <para style="q2" vid="PSA 71:10">anee shiyo'a hasammaakiir mitteba gudde.<verse eid="PSA 71:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11" />Insa'ne, «Mageni isoo wale'een; isoo anjiraak hedhebaan ke'we hordonfe isoo abindo» hinaan.<verse eid="PSA 71:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12" />Ee, Magenoo! Anenaa'n bayyattoxxe'e;</para>
  <para style="q2" vid="PSA 71:12">Ee, anke Magenoo rakke'e aneee gargaar.<verse eid="PSA 71:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13" />Anee gareeraak manni salphate ba'owwaal;</para>
  <para style="q2" vid="PSA 71:13">anee miidho'a hasaakiir tuffateme'e shookowwaal.<verse eid="PSA 71:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14" />Ani kinni duuchchi wodda atee adde anxe assedhannon;</para>
  <para style="q2" vid="PSA 71:14">galatange'ni hana galata shiqishati atee saadannon.<verse eid="PSA 71:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15" />Laakko'enna bira gophonnole midde,</para>
  <para style="q2" vid="PSA 71:15">atixxe qullumaxxeenna atixxe anjirummaxxee barra barra'ninni haaso'annon.<verse eid="PSA 71:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16" />Ee, Dada Duuchchike Goottaa!</para>
  <para style="q2" vid="PSA 71:16">Dagennexxi assitetexxa jabaxxa yaannuwwa,</para>
  <para style="q2" vid="PSA 71:16">atixxa qullumma calla lallabannon.<verse eid="PSA 71:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17" />Ee, Magenoo! Ati oosummandenaa'n anee barachchiise'eeten;</para>
  <para style="q2" vid="PSA 71:17">ta'i qico'n atixxa mambe'iinxa huje haaso'annon.<verse eid="PSA 71:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18" />Ee, Magenoo! Dande'a atixxanna dagaaxxe ila'n,</para>
  <para style="q2" vid="PSA 71:18">hunna atixxanna ila duuchcha'n haaso'anno qico'ni cime arre fulchonnolenna midde anee waaldoxxe'e.<verse eid="PSA 71:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19" />Ee, Magenoo! Qullumma atixxi lummexxe'e iima gelte'eexxen; lumollamma yaanuwwa assite'eeten;</para>
  <para style="q2" vid="PSA 71:19">Mageno atishsha hedheek ayyinna hedhebaan.<verse eid="PSA 71:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20" />Heddo rakkonna abara uudannoshsha assittotolenna haaroba;</para>
  <para style="q2" vid="PSA 71:20">hedho qammalchite'e dhimo balenaa'n anee fulchittatton.<verse eid="PSA 71:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21" />Higgeggeen anee ulfeessitteten;</para>
  <para style="q2" vid="PSA 71:21">lebbenna anee dayyeessittaton.<verse eid="PSA 71:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22" />Ee, Magenoo! Xuurameessumma atixxee baganik atee saadannon;</para>
  <para style="q2" vid="PSA 71:22">Ee, Isira'eelike woyyichcha ani masinqot faarsa'n atee saada'eennen.<verse eid="PSA 71:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23" />Atee faarsanno wodaa afo'i ankinna</para>
  <para style="q2" vid="PSA 71:23">ati woddetexxi anxi lubbo ati'a illillissaan.<verse eid="PSA 71:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24" />Anee miidho'a yoraak shooke salphateemmaxxee afo'i ank barra duuchcha qullumma atixa haaso'aan.<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="s1">Moyanjokee Soodatendeexxa Soodachcho</para>
  <para style="d">Solomoonixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 72:1" />Ee, Magenoo! Moyanji toggitte atixxa murte muraashsha,</para>
  <para style="q2" vid="PSA 72:1">atixxa qullumnna iso'n barachchiis.<verse eid="PSA 72:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2" />Konne qicinni arda atika qulummati,</para>
  <para style="q2" vid="PSA 72:2">hiyyeeyye atixxanna dhugati galchaan.<verse eid="PSA 72:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3" />Koobuwwa nage'a,</para>
  <para style="q2" vid="PSA 72:3">tullichchuwwikinna qullumma uwwaan.<verse eid="PSA 72:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4" />Moyanji miicemeeke ardi'a dhugaati muraan;</para>
  <para style="q2" vid="PSA 72:4">rakkiyyetixxa oosenna anjiraan;</para>
  <para style="q2" vid="PSA 72:4">miicammaakaaranna bulleessaan.<verse eid="PSA 72:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5" />Isi, arishshonna agenji hedheeke baro duuchcha'n</para>
  <para style="q2" vid="PSA 72:5">ila ila'n moyowwaal.<verse eid="PSA 72:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6" />Isi worqemeeke fichcha'n ganammake xeenishsha,</para>
  <para style="q2" vid="PSA 72:6">kiiffammaxxe kiifoshshanna butta shanshaan.<verse eid="PSA 72:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7" />Isike baro'n qulliyye daraartaan;</para>
  <para style="q2" vid="PSA 72:7">agenji hedheeke baro duuchcha'n nage'i bira sa'aan.<verse eid="PSA 72:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8" />Isi, arsho fuldammabaa'n aaggamma qico'n,</para>
  <para style="q2" vid="PSA 72:8">Efiraaxisike galaananaa'ni buttatixxe gabala qico'n galchowwaal.<note caller="-" style="x"><char style="xo" closed="false">72:8 </char><char style="xt" closed="false"><ref loc="ZEC 9:10">Zek. 9:10</ref>. </char></note><verse eid="PSA 72:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9" />Qiilla gammoojje giddo hedhaaki ardi isi edo sagadaan;</para>
  <para style="q2" vid="PSA 72:9">naaphi isikinna buttina arraaphphaan.<verse eid="PSA 72:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10" />Teriseesikinna giddichchuwwiink moyanjuwwi</para>
  <para style="q2" vid="PSA 72:10">irbo isi'a uuwwaan;</para>
  <para style="q2" vid="PSA 72:10">Sheebakinna Saabak moyanjuwwi uwwa isi'a iyyedangaan.<verse eid="PSA 72:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11" />Moyanjuwwi duuchchi isi'a heeshshi qokki hiyyaan;</para>
  <para style="q2" vid="PSA 72:11">gosa gosak arduwwi duuchchi isi'a ergatemaan.<verse eid="PSA 72:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12" />Isiba'a raartaaxxa hiyyeeyye,</para>
  <para style="q2" vid="PSA 72:12">rakiyyetanna gargaaraka afebaaka manna anjiraan.<verse eid="PSA 72:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13" />Hunna afebaakeenna hiyyeeyye manni'a mararaan;</para>
  <para style="q2" vid="PSA 72:13">rakkote'n hedheeka mannanna reyotenaa'n gatisaan.<verse eid="PSA 72:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14" />Munde insa'nexxi isi edo hira afe'eexxe kaddeemmaxxee</para>
  <para style="q2" vid="PSA 72:14">isi miicammakenaa'ninna xaqarammakenaa'n insa'nee gatisaan.<verse eid="PSA 72:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15" />Moyanji qeeraka baro hedho'o;</para>
  <para style="q2" vid="PSA 72:15">Sheebaki manninna worqe isi'a iyyedago'o;</para>
  <para style="q2" vid="PSA 72:15">ardikinna duuchchi wodda isi'a soodato'o,</para>
  <para style="q2" vid="PSA 72:15">duuchchi wodda iso'o eebbiso'o.<verse eid="PSA 72:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16" />Bogi duuchchi midhati midhate kado'o;</para>
  <para style="q2" vid="PSA 72:16">koobuwwa duuchcha'n midha fuldo'o;</para>
  <para style="q2" vid="PSA 72:16">Libaanoosixxe koobuwwaxxe midhashsha misso'o;</para>
  <para style="q2" vid="PSA 72:16">qachchuwwiink ardinna badda'atishsha bira sa'o.<verse eid="PSA 72:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17" />Summi isiki duuchchi woddi'a hedhowwaal;</para>
  <para style="q2" vid="PSA 72:17">arishsho hexxeeke baro duuchcha'n gurri isikinna fulo'o;</para>
  <para style="q2" vid="PSA 72:17">gosa gosaki ardi isixxee eebbisemo'o;</para>
  <para style="q2" vid="PSA 72:17">insa'nenna isoo «Eebbiseme'eeken» hinaan.<verse eid="PSA 72:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18" />Isin calli mambe'a yaane assaak,</para>
  <para style="q2" vid="PSA 72:18">Duuchchi Woddiki Gootti Mageni,</para>
  <para style="q2" vid="PSA 72:18">Isira'eelik Mageni saademowwaal!<verse eid="PSA 72:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19" />Ulfaate'eeki isik summi duuchchi woddi'a saademowwaal! Ulfinni isikinna</para>
  <para style="q2" vid="PSA 72:19">butta duuchcha'n wo'mowwaal!</para>
  <para style="qc" vid="PSA 72:19">Hamiini! Hamiini!<verse eid="PSA 72:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20" />Isseyike beltixxi Daawwitixxi soodachcho kaba muuxxende.<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms">Sakkaka Maxaafa</para>
  <para style="mr">
    <ref loc="PSA 73-89">Far. 73—89</ref></para>
  <para style="s1">Mageni Dhugaa Calla Assaaxxa</para>
  <para style="d">Asaafixxa Faaro</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 73:1" />Ca'ite qalbe afeeke Isira'eelike ardi'a Mageni eloken.<verse eid="PSA 73:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2" />Ani lekka anxi guggufatte</para>
  <para style="q2" vid="PSA 73:2">salaqqeenaa ibe gatteene.<verse eid="PSA 73:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3" />Tinninna kaddeechchi hollaammeeyyenna fuggaleeyye duroonda'naa'a uuddennexxi</para>
  <para style="q2" vid="PSA 73:3">insa'nee gaabbennexxeeten.<verse eid="PSA 73:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4" />Insa'ne mittelcho elagonphee afa gonpheemmaxxee</para>
  <para style="q2" vid="PSA 73:4">bisi insa'neek fayyakenna cululuqaaken.<verse eid="PSA 73:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5" />Insa'ne wele mannishsha rakkantabaan;</para>
  <para style="q2" vid="PSA 73:5">wele manna'ni geyaaki abari insa'nee afabaan.<verse eid="PSA 73:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6" />Insa'nee holla seesinsha goobake'n uggudhine'een;</para>
  <para style="q2" vid="PSA 73:6">hunnati manjoke'n ke'anna seemmuffa odd'wine'een.<verse eid="PSA 73:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7" />Coomi ille insa'nexxa gadhi'a xarqise;</para>
  <para style="q2" vid="PSA 73:7">fuggo godoba insa'neke'ni wo'miteexxi dhangalaate.<verse eid="PSA 73:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8" />Insa'nee wele manna'n gaciffanta'n fuggoxxa haasonnaan;</para>
  <para style="q2" vid="PSA 73:8">ifi saanda'n manna miincaan.<verse eid="PSA 73:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9" />Iimike Mageno'n afo'o fulche'naan;</para>
  <para style="q2" vid="PSA 73:9">haaso'ikinna butta duuchcha laanbunbaan.<verse eid="PSA 73:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10" />Tennexxee Mageniinki manni midde gattebaang insa'neba'a wirri hiyyaan;</para>
  <para style="q2" vid="PSA 73:10">insa'ne hinaaxxa duuchchanna adhdhaan.<verse eid="PSA 73:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11" />Insa'nenna, «Dhugaa dhugaatinxa Mageni ege'naa? Dada Duuchchik Duuchchi Woddiki Gootti Magenita ege'na afe'ee?» hinaan.<verse eid="PSA 73:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12" />Iitta hexxeen yoona fuggaaleeyye duuchchi wodda shalo galda'n karra karrade'ni lephphitaan.<verse eid="PSA 73:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13" />Ani qalbe ca'a assedhe'e ifi heqqedhatinna fuggoxxa assa waalat maa la'o alfenne?<verse eid="PSA 73:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14" />Barra barra'ninni abara uudennen; gorsa gorsa'ninni mura woxenne.<verse eid="PSA 73:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15" />Insa'ne haasonna'neeshsha haaso'eennele arda atike'n silaan xuurameesake kadanabaan.<verse eid="PSA 73:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16" />Tennee yaane wo'monna'a hedenne; yaane kinni lumo qico a'urttaxxe ane'n kadde.<verse eid="PSA 73:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17" />Dunkaan giddo e'yennexxi fuggaaleeyyete'n dagaachcho afano qico'n lumoshsha rakkatenne.<verse eid="PSA 73:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18" />Dhugaaten, ati insa'nee salaqaaxxe bakka'n uggittatton;</para>
  <para style="q2" vid="PSA 73:18">inbe mundaashshanna assittatton.<verse eid="PSA 73:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19" />Hitta kande insa'ne dedhange'ni munde!</para>
  <para style="q2" vid="PSA 73:19">Bararaaqikinna kutti hine.<verse eid="PSA 73:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20" />Ee, Dada Duuchchik Goottaa! Ati kexxatto wodda</para>
  <para style="q2" vid="PSA 73:20">oojonteemmaxxi oojjo gorsa dedhendaammashsha insa'ne ati edii'n gophphemaan.<verse eid="PSA 73:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21" />Hedho ane'n qaraartee wodda</para>
  <para style="q2" vid="PSA 73:21">yaadikinna ganemenne wodda<verse eid="PSA 73:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22" />ani gowwa, mittelcho ege'nebaake</para>
  <para style="q2" vid="PSA 73:22">horiinsha ati edo kadenne.<verse eid="PSA 73:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23" />Kaddo malee'e duuchchi wodda ani atinni welti hedhennen;</para>
  <para style="q2" vid="PSA 73:23">atinna anxa middixxa anga abidatton.<verse eid="PSA 73:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24" />Gorsa atikenni anee akeekkatton;</para>
  <para style="q2" vid="PSA 73:24">ookkone uduma atike ulfinnibaa anee adhdhittatton.<verse eid="PSA 73:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25" />Iimate'ni atee male'e ayyete afenne?</para>
  <para style="q2" vid="PSA 73:25">Buttate'ninna atee malee weli halsannoki hedhebaan.<verse eid="PSA 73:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26" />Maali ankinna yaadi anki gopha'nee me'aan;</para>
  <para style="q2" vid="PSA 73:26">Mageni kinni duuchchi woddi'a anxe hunnanna anke qoobbon.<verse eid="PSA 73:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27" />Atenaa'n bayyataakiir ba'aan;</para>
  <para style="q2" vid="PSA 73:27">ate waalaka duuchcha birtatton.<verse eid="PSA 73:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28" />Ani'a kinni Mageniibaa shiqa eloxxen;</para>
  <para style="q2" vid="PSA 73:28">atixxa huje duuchcha lassannoshsha,</para>
  <para style="q2" vid="PSA 73:28">ani atee Dada Duuchchika Goottaa gollake assedhe'eenne.<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="s1">Ardiinke Nage'i'aa Soodatendeexxa Soodachcho</para>
  <para style="q1">Asaafixxa Gence.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 74:1" />Ee, Magenoo! No'o'o haranga mayee waldete?</para>
  <para style="q2" vid="PSA 74:1">Atixxe allale hunda hedheeke atike gedhebo'n aare atixxi mayee bubbe?<verse eid="PSA 74:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2" />Oliminaa'n fi'litteteka atixxe gamo kadaashsha</para>
  <para style="q2" vid="PSA 74:2">garbummatena'ni woddeteka atika arda,</para>
  <para style="q2" vid="PSA 74:2">itti galde'e hosseetexxa Tsiyoonixxa kooba qaabbati.<verse eid="PSA 74:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3" />Naaphi atike galmi giddo hedheechcho duuchcha balleese'een.<verse eid="PSA 74:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4" />Atik naaphi atike galmi giddo geerare;</para>
  <para style="q2" vid="PSA 74:4">ookkonna ifika baandira olte.<verse eid="PSA 74:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5" />Insa'nenna gongomi giddo haqqe karatee'e,</para>
  <para style="q2" vid="PSA 74:5">qoce adhammake manna lanbaan.<verse eid="PSA 74:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6" />Gimotika seessuwwa</para>
  <para style="q2" vid="PSA 74:6">qocetinna burrisik enqine.<verse eid="PSA 74:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7" />Insa'ne atika mine gunbe;</para>
  <para style="q2" vid="PSA 74:7">atik summi ye'emaaxxa bakka battoosine.<verse eid="PSA 74:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8" />Insa'nenna «Amme insa'nee baalooma no'ok hunda galchino» hine.</para>
  <para style="q2" vid="PSA 74:8">Insa'nenna ookkone bogi giddo Mageno magenoofachchitxxa bakka duuchcha gunbe.<verse eid="PSA 74:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9" />Ta'inni edi'a beessis hedhebaan;</para>
  <para style="q2" vid="PSA 74:9">wabeeko haaso'atinna hexxabaan;</para>
  <para style="q2" vid="PSA 74:9">tinni yaane hitte qico turtaaxxa no'o giddii'n ege'naak hedhebaan.<verse eid="PSA 74:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10" />Ee, Magenoo! Naaphi ate'n haani qico'n qacifata'n hedha?</para>
  <para style="q2" vid="PSA 74:10">Summa atika duuchchii wodda tuffata'n hedhaa?<verse eid="PSA 74:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11" />Mayeete anga atixxenni insa'nee balleessa gophphete?</para>
  <para style="q2" vid="PSA 74:11">Mayeeta atixxa middixxa anga mirqexxete?<verse eid="PSA 74:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12" />Ee, Magenoo! Edi'ninni ati moyanjo anken;</para>
  <para style="q2" vid="PSA 74:12">buttate'ninna anjirumma atixxa iyyedageeten.<verse eid="PSA 74:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13" />Lumoxxe atixxe hunnanni abbaayya lameba shattete;</para>
  <para style="q2" vid="PSA 74:13">jawwe fakkataaka abbaayya giddike biniinchika umuwwa cancaqqette.<verse eid="PSA 74:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14" />Ati leewaataani hiyyemaaka naachcha fakkataake biniinchika umuwwa canicaqqete;</para>
  <para style="q2" vid="PSA 74:14">maala isikanna qiilla gammooje'ni hexxaaxxe daduwwaanna ita assite uutteten.<note caller="-" style="x"><char style="xo" closed="false">74:14 </char><char style="xt" closed="false"><ref loc="JOB 41:1">Iyo. 41:1</ref>; <ref loc="PSA 104:26">Far. 104:26</ref>; <ref loc="ISA 27:1">Isa. 27:1</ref>. </char></note><verse eid="PSA 74:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15" />Muummuwwatanna burquwwa yaa'ashsha assiteten;</para>
  <para style="q2" vid="PSA 74:15">lumollammi galaanuwwi kinni bagaashsha assitteten.<verse eid="PSA 74:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16" />Hashsha atixxe barranna atixxe;</para>
  <para style="q2" vid="PSA 74:16">arishshotanna agenjo bakka ifi ifixxe'ninni uggiteten.<verse eid="PSA 74:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17" />Ati buttatee gabala murtette; harsokanna bono daddeten.<verse eid="PSA 74:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18" />Ee, Duuchchi Woddike Goottaa! Atik naaphi ate'ni gacifata'nee qico uuddate;</para>
  <para style="q2" vid="PSA 74:18">gowwi ardi summa atika tuffateexxa qaabbati.<verse eid="PSA 74:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19" />Gargaarsa afebaake atike mannixxa lubbo naaphake'n sa'isite uuttoxxe'e;</para>
  <para style="q2" vid="PSA 74:19">atika rakkichcha arda duuchchi woddi'a deettoxxe'e!<verse eid="PSA 74:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20" />No'aa aagetexxa kako hedi;</para>
  <para style="q2" vid="PSA 74:20">buttate'n dukkana hexxeeba duuchcha xaqaro wo'mite'een.<verse eid="PSA 74:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21" />Miicemeeki ardi salphate higaashsha assittoxxe'e;</para>
  <para style="q2" vid="PSA 74:21">hiyyeeyyenna rakkiyye summa atika saadowwaal.<verse eid="PSA 74:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22" />Ee, Magenoo! Ke'i! Atixxe yaane'a morom;</para>
  <para style="q2" vid="PSA 74:22">gowwi manni barra duuchcha ate'ni gacifata'neexxa qaabbat.<verse eid="PSA 74:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23" />Atike diinka geerarsa</para>
  <para style="q2" vid="PSA 74:23">duuchchi woddixxa atike naaphixxa dhaadachcho deettoxxe'e.<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="s1">Mageni Muraake Kadeexxa</para>
  <para style="d">Faarsaleeyyetike sooresi'a «Balleessitoxxe'e» Hiyyemaake Meelinni Asaafixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 75:1" />Ee, Magenoo! Atee galateeffanta'eennen; summi atik shiqike kadeemmaxxee ati'a galata unaannen;</para>
  <para style="q2" vid="PSA 75:1">ardi assittetexxa yaanenna oodeesaan.<verse eid="PSA 75:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2" />Mageni hiyya'ne qici, «Ani murte murannoxxa barra woxxe'eennen;</para>
  <para style="q2" vid="PSA 75:2">eettene yanna toggi assee murannon.<verse eid="PSA 75:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3" />Buttanna ise giddo hexxeexxi hedho affeexxi daduwwa culphisoolenna midde;</para>
  <para style="q2" vid="PSA 75:3">buttatika utupha abidee jabeessannoki anten;<verse eid="PSA 75:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4" />Ani hollaameeyye ‹Ifi saadinoqqe'e›</para>
  <para style="q2" vid="PSA 75:4">fuggaaleeyyetanna ‹Hollati gaafa fulchitinoqqe'e!<verse eid="PSA 75:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5" />Holati gaafa iimi'a togginoqqe'e;</para>
  <para style="q2" vid="PSA 75:5">yookaani hollati gooba qeerrisine'e haasotinnoqqe'e hiyyannon› » hittatton.<verse eid="PSA 75:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6" />Ulfaataa borotenaa'n yookaan dhidhimakenaa'n,</para>
  <para style="q2" vid="PSA 75:6">yookaani qiilla gammoojenaa'n daggabaan.<verse eid="PSA 75:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7" />Mageno callanni murte muraak;</para>
  <para style="q2" vid="PSA 75:7">wele ulfeeseexxi wele salphisaan.<verse eid="PSA 75:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8" />Duuchchi Woddik Gootti ifixxe anga'ni wo'ma fule bageeki woyinetik bulbul hedhexxa mufetixxa buuda afe'eemman;</para>
  <para style="q2" vid="PSA 75:8">ise giddii'n mufeti bulbulo dunaa wodda fuggaaleeyye duuchchi ha'witaan;</para>
  <para style="q2" vid="PSA 75:8">cingotinna gattebaang cingilsitaan. <verse eid="PSA 75:8" /><verse number="9" style="v" sid="PSA 75:9" />Ani kinni duuchchi woddi'a lallabannon;</para>
  <para style="q2" vid="PSA 75:9">Ya'iqoobika Mageno faaroti saadatanna waalabe'no.<verse eid="PSA 75:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10" />Isi kinni hantaaleyyetixxa hunna enqaan;</para>
  <para style="q2" vid="PSA 75:10">qulliyyetixxi hunna kinni lebenda'nee me'itaan.<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="s1">Mageniixxa Injiffachcho</para>
  <para style="d">Faarsaleeyyetike Sooresi'a Kiraaruwwik Asaafixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 76:1" />Mageni Yihudake boga'n ege'neme'eeken;</para>
  <para style="q2" vid="PSA 76:1">summi isikinna Isira'eeli'n lumoken.<verse eid="PSA 76:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2" />Dunkaana ifika Saleemi Iyyerusale'mi'n</para>
  <para style="q2" vid="PSA 76:2">isixxe mottexxi bakkanna Tsiyoonixxe kooba hanan.<verse eid="PSA 76:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3" />Ookko xalaqqi xalaqqi hita'neexxa gabuwwa,</para>
  <para style="q2" vid="PSA 76:3">naaphiinka bageduwwa, wontuwwatanna,</para>
  <para style="q2" vid="PSA 76:3">wele loliinka miya duuchcha butuchche.<verse eid="PSA 76:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4" />Ulfinni atiki hittee qico lumoke;</para>
  <para style="q2" vid="PSA 76:4">gaachchanni atik lumolamma koobuwwa caalaan.<verse eid="PSA 76:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5" />Jannuwwi boojime'een;</para>
  <para style="q2" vid="PSA 76:5">insa'nenna diinphee cookkokki hineemman;</para>
  <para style="q2" vid="PSA 76:5">angatinna mitteelchonna huja dandeennebaan.<verse eid="PSA 76:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6" />Ee, Ya'iqoobike Magenoo,</para>
  <para style="q2" vid="PSA 76:6">atike xixichchonaa'n kexxeexxa insa'ne fadhado ifingenninni inbe.<verse eid="PSA 76:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7" />Magenoo, ati sodatende'eeteken;</para>
  <para style="q2" vid="PSA 76:7">muffatottole ati edo urraa dande'aak ayyate?<verse eid="PSA 76:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8" />Iimate'ni murte atixxa lallabbete;</para>
  <para style="q2" vid="PSA 76:8">buttatinna sodaateexxi sammi hite.<verse eid="PSA 76:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9" />Ee, Magenoo buttate'ni micemeemmaaka duuchcha wodatee murte'e kexxete wodda butta sammi hite.<verse eid="PSA 76:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10" />Mufe atixxi cubbo hujaaka gibbammaxxee ardi atee saadaan;</para>
  <para style="q2" vid="PSA 76:10">mufe atixxenaa'n gateek manninna lebeexxi cubbo huja waalaan.<verse eid="PSA 76:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11" />Duuchchi Woddika Gootta ha'nooke Mageni'a wereegge;</para>
  <para style="q2" vid="PSA 76:11">weereeginneechchonna muuxxe;</para>
  <para style="q2" vid="PSA 76:11">qarqara isike'n hedheek duuchchi sodaatema hassiasaake isi'a uwwa shiqishshowwaal.<verse eid="PSA 76:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12" />Isi hollaameessa hayyichchuwwa salphisaan;</para>
  <para style="q2" vid="PSA 76:12">buttatiki moyanjuwwinna isoo'o sodatee culphisaan.<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="s1">Dayyeesatixxa Soodachcho</para>
  <para style="d">Faarsaleeyyetike Sooresi'a Edotaami'a, Asaafixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 77:1" />Haafura anka gikki asse'e Magenoke'n oodhenne;</para>
  <para style="q2" vid="PSA 77:1">laqaashshanna hafuura gikki asse oodhenne.<verse eid="PSA 77:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2" />Rakkatenne wodda Mageno soodatenne;</para>
  <para style="q2" vid="PSA 77:2">hashsha duuchcha anga iimi'a ke'ise Mageno soodatannon;</para>
  <para style="q2" vid="PSA 77:2">kaddo malee lubbo anxi dayyayyaatebaan.<verse eid="PSA 77:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3" />Mageno hedanno wodda aadenne;</para>
  <para style="q2" vid="PSA 77:3">hede herreganno wodda hangul hiyyenne. <verse eid="PSA 77:3" /><verse number="4" style="v" sid="PSA 77:4" />Ille anxenaa'n diipho hoyyitete;</para>
  <para style="q2" vid="PSA 77:4">wixxirri hiyyennenni haaso'akanna gophenne.<verse eid="PSA 77:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5" />Saxxeexxa barruwwa hedenne;</para>
  <para style="q2" vid="PSA 77:5">olmixxa wogguwwanna qaabbatenne.<verse eid="PSA 77:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6" />Faaro anxa edixxa hashsha qaabbatenne;</para>
  <para style="q2" vid="PSA 77:6">hede herrega'n ifi'aanni ifi hiyye'e qoraana qici,<verse eid="PSA 77:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7" />«Dada Duuchchik Gootti duuchchi woddi'a no'oo waalaa?</para>
  <para style="q2" vid="PSA 77:7">Ta'anni elqi'a no'aa langaxxa haranga mararabaa?<verse eid="PSA 77:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8" />Jaalala isixxi duuchchi woddi'a baxxeeta?</para>
  <para style="q2" vid="PSA 77:8">Asso'aa addachchiiseemmak haaso'ita muuxemebang gataata?<verse eid="PSA 77:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9" />Mageni marara dedhe'ee?</para>
  <para style="q2" vid="PSA 77:9">Mufe godoba ba'lata isoo hoyyitee?»<verse eid="PSA 77:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10" />Aninna, «Dada Duuchchik Duuchchi Woddki Goottixxi hunna jijjirende'eshsha hedati</para>
  <para style="q2" vid="PSA 77:10">tinni anee miiteen» hiyyenne.<verse eid="PSA 77:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11" />Ee, Duuchchi Woddike Goottaa! Assittetexxa lumolla yannuwwa qaabbataannen;</para>
  <para style="q2" vid="PSA 77:11">sa'eemmake baro'n hujjeeteka mambe'uwwa kassi hiyyaannen.<verse eid="PSA 77:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12" />Assittettexxa lumolla huje duuchcha herregannon;</para>
  <para style="q2" vid="PSA 77:12">mambe'iinxa atixxa hujenna lebe lebee'e hedannon<verse eid="PSA 77:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13" />Ee, Magenoo, ori atik duuchchi woyyichchaken;</para>
  <para style="q2" vid="PSA 77:13">Lumoke no'oke Magenishsha hedheek weli magenuwwi ayyete?<verse eid="PSA 77:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14" />Ati mambe'a yaane assittattoken;</para>
  <para style="q2" vid="PSA 77:14">ati gosa gosake ardi giddo hunna atixxa leellishsheeten.<verse eid="PSA 77:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15" />Hunna atixxenni lumoxxa arda atikixxa Ya'iqoobixxanna Yooseefixxa horte wodde'eten.<verse eid="PSA 77:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16" />Ee, Magenoo! Heddi wodi'i atee uudeexxi sodaate;</para>
  <para style="q2" vid="PSA 77:16">dhi'mo abbaayyanna culphisse.<verse eid="PSA 77:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17" />Duumanchuwwi xeenna gansiise;</para>
  <para style="q2" vid="PSA 77:17">iimi'n dindinso dindinde;</para>
  <para style="q2" vid="PSA 77:17">banqo gabuwwatisha duuchchiinbaa xalaqqisse.<verse eid="PSA 77:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18" />Atixxe dindiinsook luulji hobonbalte giddo laqeme;</para>
  <para style="q2" vid="PSA 77:18">atixxe banqok balaqii butta duuchcha'n xasse;</para>
  <para style="q2" vid="PSA 77:18">butta lele'miteexxi sheke sheke hite.<verse eid="PSA 77:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19" />Ori atik Abbaayya giddo,</para>
  <para style="q2" vid="PSA 77:19">hodhdhichchi atikinna lumollamma wodi'i giddon;</para>
  <para style="q2" vid="PSA 77:19">yaane kinni faana atixxi leellita'emmabaan.<verse eid="PSA 77:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20" />Allalsanji gedhebo allalammashsha</para>
  <para style="q2" vid="PSA 77:20">Muusexxenna Aaroonixxe anga'n arda atika akeekkette.<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="s1">Magenokanna Mageniinka Arda</para>
  <para style="d">Asaafixxa Gence.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 78:1" />Koo Anke ardaa barachchiisaa anxa caqasse;</para>
  <para style="q2" vid="PSA 78:1">mansha ha'nooxxanna anke haaso'iba'a wirri asse.<verse eid="PSA 78:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2" />Oliminaa'n sho'ondemmaxxa yaane farri assannon,</para>
  <para style="q2" vid="PSA 78:2">mammaasik afo'o anka banata'eennen.<note caller="-" style="x"><char style="xo" closed="false">78:2 </char><char style="xt" closed="false"><ref loc="MAT 13:35">Mat. 13:35</ref>. </char></note><verse eid="PSA 78:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3" />Tinni yaanenna Lanqennexaarranna egennennaxxa no'ok edik,</para>
  <para style="q2" vid="PSA 78:3">annuwwi no'o'n kuleemmaxxa,<verse eid="PSA 78:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4" />No'oxxe oose'ni sho'nabe'non;</para>
  <para style="q2" vid="PSA 78:4">Duuchchi Woddike Goottixxe hunnaxxaara,</para>
  <para style="q2" vid="PSA 78:4">isi hujeexxa lumollamma hujeexxaaranna,</para>
  <para style="q2" vid="PSA 78:4">asseexxa mamibe'a yaanuwwaxxaara daggaaxxe ila'ni haasonnannon.<verse eid="PSA 78:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5" />Isi Ya'iqoobike ardi'a ajaja uwwe;</para>
  <para style="q2" vid="PSA 78:5">Isira'eeli'aanna seera ugge;</para>
  <para style="q2" vid="PSA 78:5">oose ifixxa barachchiisaashsha edika no'oka annuwwa ajaje.<verse eid="PSA 78:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6" />Tennee asseechchi itti aandaaxxi ilaa tennee egendo'a,</para>
  <para style="q2" vid="PSA 78:6">ta'a ilemaak manninna oose ifixxa barachchiisoo'aaten.<verse eid="PSA 78:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7" />Konne qicinni insa'nenna Mageno addantaan;</para>
  <para style="q2" vid="PSA 78:7">ajajuwwa isikanna heqe'naa malee deenabaan.<verse eid="PSA 78:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8" />Edike insa'neeke annuwwishsha,</para>
  <para style="q2" vid="PSA 78:8">godoba jabataakenna Magenoke'n jallataake,</para>
  <para style="q2" vid="PSA 78:8">Magenoke'n mitte godobinni addatati jabaatebaaka manna,</para>
  <para style="q2" vid="PSA 78:8">qalbe insa'neexxi Mageno addatabaake manna kandabaan.<verse eid="PSA 78:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9" />Efireemik loliink manni gabe abixxeenni hedheexi,</para>
  <para style="q2" vid="PSA 78:9">loliinxa barra udumi'a baaje.<verse eid="PSA 78:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10" />Mageniinxa kako dingeexxi seera isikeenna ajajema ginbe.<verse eid="PSA 78:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11" />Isi hujeexxa yaane duuchchanna,</para>
  <para style="q2" vid="PSA 78:11">asseemmaka mambe'a duuchcha deene.<verse eid="PSA 78:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12" />Gibtseeke bogi giddo Tso'aanike diida'n insa'neek,</para>
  <para style="q2" vid="PSA 78:12">edik annuwwi uuda'naa'a Mageni insa'ne edo mambe'a asse.<note caller="-" style="x"><char style="xo" closed="false">78:12 </char><char style="xt" closed="false"><ref loc="EXO 7:8-12:32">Fula. 7:8—12:32</ref>. </char></note><verse eid="PSA 78:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13" />Abbaayya lameba shateexxi giddii'n insa'nee foosse;</para>
  <para style="q2" vid="PSA 78:13">wode'e gimotishsha uurrise.<note caller="-" style="x"><char style="xo" closed="false">78:13 </char><char style="xt" closed="false"><ref loc="EXO 14:21-22">Fula. 14:21-22</ref>. </char></note><verse eid="PSA 78:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14" />Barra duumanchik,</para>
  <para style="q2" vid="PSA 78:14">hashsha giiratike ifinninni insa'nee akeeke.<note caller="-" style="x"><char style="xo" closed="false">78:14 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">Fula. 13:21-22</ref>. </char></note><verse eid="PSA 78:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15" />Isi Qiilla gammoojje giddo rassa dhooseexxi,</para>
  <para style="q2" vid="PSA 78:15">dhi'mo abbaayyake wodi'ishsha heenobaaka wode'e insa'ne'a uwwe.<note caller="-" style="x"><char style="xo" closed="false">78:15 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Fula. 17:1-7</ref>; <ref loc="NUM 20:2-13">Lak. 20:2-13</ref>. </char></note><verse eid="PSA 78:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16" />Muumme rassaatenaa'n phu'issaashsha asse;</para>
  <para style="q2" vid="PSA 78:16">wodi'ekanna galaaniinke wodi'ishsha yaase.<verse eid="PSA 78:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17" />Insa'ne kinni Dada Duuchchika Duuchchi Woddika Gootta yaadisatee ca'li hine'e cubbo hunje;</para>
  <para style="q2" vid="PSA 78:17">qiilla gammoojje giddo Lummoke Mageno'n jalline.<verse eid="PSA 78:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18" />Mageno hega uundo'a halchineexxa ita isoo lanqe.<note caller="-" style="x"><char style="xo" closed="false">78:18 </char><char style="xt" closed="false"><ref loc="EXO 16:2-15">Fula. 16:2-15</ref>; <ref loc="NUM 11:4-23">Lak. 11:4-23</ref>, <ref loc="NUM 11:31-35">31-35</ref>. </char></note><verse eid="PSA 78:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19" />Magenokanna hamanta'n hinee qici,</para>
  <para style="q2" vid="PSA 78:19">«Mageni qiilla gammoojje giddo indannolcho no'aa dande'ee uwwaa?<verse eid="PSA 78:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20" />Rassa ganee wodda wodi'i lola'e;</para>
  <para style="q2" vid="PSA 78:20">egedhitaa indaannolcho uwweexxi, maalakanna no'aa dande'ee qophpheessaa hiyyatee?»<verse eid="PSA 78:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21" />Duuchchi Woddiki Gootti tennee laqeexxi yo'oshsha mufate;</para>
  <para style="q2" vid="PSA 78:21">Ya'iqoobike arda'n giira ha'ite; Isira'eeli'ninna mufe isixxi bubbe.<verse eid="PSA 78:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22" />Tinninna kaddeechchi insa'ne isoo addata gonpheemmaxxeenna</para>
  <para style="q2" vid="PSA 78:22">insa'nee anjiraaxxa addata gonpheemmaxxeeten.<verse eid="PSA 78:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23" />Kaddo malee isi iimika duumancha ajaje;</para>
  <para style="q2" vid="PSA 78:23">iimatixxa hulanna bane.<verse eid="PSA 78:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24" />Ardi ito'a meenna gansiise;</para>
  <para style="q2" vid="PSA 78:24">iimatixxa midhanna insane'a uwwe.<note caller="-" style="x"><char style="xo" closed="false">78:24 </char><char style="xt" closed="false"><ref loc="JHN 6:31">Yoh. 6:31</ref>. </char></note><verse eid="PSA 78:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25" />Konne qicinni manni Ergannatixxa ita ite;</para>
  <para style="q2" vid="PSA 78:25">Mageni inde goddinaaxxa ita insa'ne'aa uwwe.<verse eid="PSA 78:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26" />Isi boroti darree'n diidallo diidaleesitaashsha assee;</para>
  <para style="q2" vid="PSA 78:26">hunna ifixxenni bita'i darree'n diidallo ke'isse.<verse eid="PSA 78:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27" />Buttiinsha bira sa'eeka maala,</para>
  <para style="q2" vid="PSA 78:27">abbaayyatike maanchishsha bira saxxeexxa gogorre arda ifikee xeenishsha gansiise.<verse eid="PSA 78:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28" />Insa'neke olla'i giddo dunkaan qarqaara'n gogorre insa'ne'aa harcaase.<verse eid="PSA 78:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29" />Isi haalchineechcho duuchcha insa'ne'aa uwweemmaxxee ardi ite godde.<verse eid="PSA 78:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30" />Kaddo malee halcha fulebaangi ita afo'onni anfee'naa'a,<verse eid="PSA 78:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31" />Mageni insa'ne'n mufate'e jajjaba insa'neeka shiye;</para>
  <para style="q2" vid="PSA 78:31">insa'ne giddii'n hexxeen hiyyendaaxxa</para>
  <para style="q2" vid="PSA 78:31">Isira'eelixxa lollobbe dargaggeeyenna qoomma shiye.<verse eid="PSA 78:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32" />Tinni duuchchi kaddee'naani ardi lebe lebee cubbo huja'nemman;</para>
  <para style="q2" vid="PSA 78:32">heddo mambe'uwwa leellishoolenna iso'ni addantebaan.<verse eid="PSA 78:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33" />Tennexxee baro insa'neeka uffuu hiyyemammake hafuurishsha harunse;</para>
  <para style="q2" vid="PSA 78:33">hedho insa'neexxanna weekenshati muunxaashsha asse.<verse eid="PSA 78:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34" />Insa'ne giddii'n manna shiyyee wodda gateeki isiba'a higate'ni ke'e;</para>
  <para style="q2" vid="PSA 78:34">aadde aagati mitte godobonni isiba'a hinge.<verse eid="PSA 78:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35" />Mageni rassa insa'neexxe,</para>
  <para style="q2" vid="PSA 78:35">Dada Duuchchik Duuchchi Woddik Gootti Mageni insa'ne wodeeke kadeexxanna qaabbante.<verse eid="PSA 78:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36" />Yaane kinni hinaammaxxi duuchchi soboken;</para>
  <para style="q2" vid="PSA 78:36">haasonammaxxi duuchchinna dharakemman.<verse eid="PSA 78:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37" />Qalbe insa'neexxi isi'a addatendemmabaan;</para>
  <para style="q2" vid="PSA 78:37">Isixxa kakonna heqqe'neemmabaan.<verse eid="PSA 78:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38" />Kaddo malee Mageni arda ifikee maraare;</para>
  <para style="q2" vid="PSA 78:38">balleessa insa'neexxa gattowwaali hiyyee malee'e insa'nee birebaan;</para>
  <para style="q2" vid="PSA 78:38">heddole aare enqedhe;</para>
  <para style="q2" vid="PSA 78:38">mufetanna eebbishebaan.<verse eid="PSA 78:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39" />Isi gande saxxaammaaxxe diidalloshsha,</para>
  <para style="q2" vid="PSA 78:39">manji reyaachcho kadeexxa qaabbate.<verse eid="PSA 78:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40" />Qiilla gammoojje'ni me'ele iso'n jallinne!</para>
  <para style="q2" vid="PSA 78:40">Gammooje'ni heddolenna iso'oo yaadinse.<verse eid="PSA 78:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41" />Insa'enne lenbe lenbe'e Mageno hega uunde;</para>
  <para style="q2" vid="PSA 78:41">woyyichcha Isira'eelikanna yaadinse.<verse eid="PSA 78:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42" />Insa'nee naaphiinxe anganaa'ni anjiremmaaxxa,<verse eid="PSA 78:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43" />Gibtseeke bogi giddo Tso'aanke diida'ni assexxa masonna mambe'a deene.<verse eid="PSA 78:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44" />Isi insa'neke galaanuwwika wode'e mundete'n jiijjiire;</para>
  <para style="q2" vid="PSA 78:44">tennexxe Gibtseke bogik manni muumetika wode'e asse ha'wwaa qico gophe.<note caller="-" style="x"><char style="xo" closed="false">78:44 </char><char style="xt" closed="false"><ref loc="EXO 7:17-21">Fula. 7:17-21</ref>. </char></note><verse eid="PSA 78:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45" />Insa'nee ga'maaka woraancha insa'neeka boga barbadeessaaka,</para>
  <para style="q2" vid="PSA 78:45">raachchuwwa insa'ne'n wocci asse.<note caller="-" style="x"><char style="xo" closed="false">78:45 </char><char style="xt" closed="false"><ref loc="EXO 8:1-6">Fula. 8:1-6</ref>; <ref loc="EXO 20:24">20:24</ref>. </char></note><verse eid="PSA 78:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46" />Midha insa'neexxa koro'miisi</para>
  <para style="q2" vid="PSA 78:46">hiddichchuwwa insa'neeka awwaaneessakee sa'ise uwwe.<note caller="-" style="x"><char style="xo" closed="false">78:46 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">Fula. 10:12-15</ref>. </char></note><verse eid="PSA 78:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47" />Insa'neeka Woyinetika hiddichchuwwanna kaadeti,</para>
  <para style="q2" vid="PSA 78:47">balasetika haqichchuwwanna qorriki balleesse.<verse eid="PSA 78:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48" />Lalo insa'neka kaadeti,</para>
  <para style="q2" vid="PSA 78:48">hore insa'neka banqoti shiyye.<note caller="-" style="x"><char style="xo" closed="false">78:48 </char><char style="xt" closed="false"><ref loc="EXO 9:22-25">Fula. 9:22-25</ref>. </char></note><verse eid="PSA 78:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49" />Isi bala ibisaaka ifike erganjuwwika sannachcha yo'oshsha sodachchisa'neexxa ifixxa aare,</para>
  <para style="q2" vid="PSA 78:49">jabaxxa mufe ifixxanna,</para>
  <para style="q2" vid="PSA 78:49">rakko insa'ne'n wocci asse.<verse eid="PSA 78:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50" />Isi aarete'e ora bane;</para>
  <para style="q2" vid="PSA 78:50">lubbo insa'nexxa reyotenaa'ninna gatisebaan;</para>
  <para style="q2" vid="PSA 78:50">yaane kinni balati rennaashsha sa'ise uwwe.<verse eid="PSA 78:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51" />Kaamixxe horteka karri banuwwa kadeekaara Kaamike duunkaana'n</para>
  <para style="q2" vid="PSA 78:51">Gibtseeke boga'n insa'neeka labbaka angafuwwa duuchcha shiye.<note caller="-" style="x"><char style="xo" closed="false">78:51 </char><char style="xt" closed="false"><ref loc="EXO 12:29">Fula. 12:29</ref>. </char></note><verse eid="PSA 78:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52" />Arda ifika fulcheexxi gedhebiinsha bobbaase;</para>
  <para style="q2" vid="PSA 78:52">qiilla gammoojje giddonna insa'nee akeeke.<note caller="-" style="x"><char style="xo" closed="false">78:52 </char><char style="xt" closed="false"><ref loc="EXO 13:17-22">Fula. 13:17-22</ref>. </char></note><verse eid="PSA 78:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53" />Nage'ik insa'nee'e akeekemmaxxee shookebaan;</para>
  <para style="q2" vid="PSA 78:53">yaane kinni abbaayya naapha insa'neeka liqinsite.<note caller="-" style="x"><char style="xo" closed="false">78:53 </char><char style="xt" closed="false"><ref loc="EXO 14:26-28">Fula. 14:26-28</ref>. </char></note><verse eid="PSA 78:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54" />Ifike woyyichcha bogiba'a,</para>
  <para style="q2" vid="PSA 78:54">middixxe anganni injifate'e adhdhemmaxxe koobaba'aa insa'nee iyyedage.<note caller="-" style="x"><char style="xo" closed="false">78:54 </char><char style="xt" closed="false"><ref loc="EXO 15:17">Fula. 15:17</ref>; <ref loc="JOS 3:14-17">Iya. 3:14-17</ref>. </char></note><verse eid="PSA 78:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55" />Isira'eeli edii'ni gosa gosaka arda shore;</para>
  <para style="q2" vid="PSA 78:55">insa'neeka boganna insa'nee dhaalchisee;</para>
  <para style="q2" vid="PSA 78:55">minuwwakanna arda ifike Isira'eeli'a uwwe.<note caller="-" style="x"><char style="xo" closed="false">78:55 </char><char style="xt" closed="false"><ref loc="JOS 11:16-23">Iya. 11:16-23</ref>. </char></note><verse eid="PSA 78:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56" />Yaane kinni ardi isiki Dada Duuchchike Duuchchi Woddike Gootta Mageno'ni jalle;</para>
  <para style="q2" vid="PSA 78:56">isoonna hega uude;</para>
  <para style="q2" vid="PSA 78:56">ajaja isikanna muuxebaan.<note caller="-" style="x"><char style="xo" closed="false">78:56 </char><char style="xt" closed="false"><ref loc="JDG 2:11-15">Hay. 2:11-15</ref>. </char></note><verse eid="PSA 78:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57" />Yaane kinni annuwwa insa'nekishshanni jalliyyetenna ajaajemmabaake kande;</para>
  <para style="q2" vid="PSA 78:57">dabaalette gabeshsha addachchiisabaake kande.<verse eid="PSA 78:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58" />Mageno ege'nebaak mannixxe magenoofachchotixxe baka'ni magenoofatati isoo mufaachchiinse;</para>
  <para style="q2" vid="PSA 78:58">fakkuwwa magenoofatatinna hinaafaashsha assine.<verse eid="PSA 78:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59" />Mageni tennee laqee wodda mufate;</para>
  <para style="q2" vid="PSA 78:59">Isira'eelinna haranga waale.<verse eid="PSA 78:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60" />Manni giddo uuriseeka duunkaana</para>
  <para style="q2" vid="PSA 78:60">Seeloka ifika galduma waale.<note caller="-" style="x"><char style="xo" closed="false">78:60 </char><char style="xt" closed="false"><ref loc="JOS 18:1">Iya. 18:1</ref>; <ref loc="JER 7:12-14">Erm. 7:12-14</ref>; <ref loc="JER 26:6">26:6</ref>. </char></note><verse eid="PSA 78:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61" />Isi hunna ifixxenninna gaachchanna ifikenni leellatike beessisa kade'eeka Kakkotika Taabota</para>
  <para style="q2" vid="PSA 78:61">naaphi booji'o'aa sa'isse uwwe.<note caller="-" style="x"><char style="xo" closed="false">78:61 </char><char style="xt" closed="false"><ref loc="1SA 4:4-22">1 Sam. 4:4-22</ref>. </char></note><verse eid="PSA 78:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62" />Arda ifike'ni yo'oshsha mufate;</para>
  <para style="q2" vid="PSA 78:62">bagedoke'ni muudaashsha asse.<verse eid="PSA 78:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63" />Qee'lo insa'neexxi duuchchi gubende rerrte;</para>
  <para style="q2" vid="PSA 78:63">dubari insa'neekiirinna aadhaaka gophe.<verse eid="PSA 78:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64" />Qeese duuchchi bagedik rerte;</para>
  <para style="q2" vid="PSA 78:64">insa'neexxi aruwwa insa'ne'aa oodha dandeetebaan.<verse eid="PSA 78:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65" />Ookkoneechchi uduma muuxamake'ni Dada Duuchik Gootti diiphokenaa'n ke'eeshsha dammaqe;</para>
  <para style="q2" vid="PSA 78:65">woyyinetixxa booka ha'weexxi onno'ammake janni manjishsha ke'e.<verse eid="PSA 78:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66" />Isi naapha ifika gane udumi'a hiissexxi</para>
  <para style="q2" vid="PSA 78:66">duuchchchi woddika shookonna insa'ne'n oddeesse.<verse eid="PSA 78:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67" />Yooseefika duunkaana tuffate; Efireemixxa horte fi'lebaan.<verse eid="PSA 78:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68" />Yaane kinni Yihudaka minenna yo'oshsha eeyyeexxa Tsiyoonixxa kooba fi'le.<verse eid="PSA 78:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69" />Ookkonna qeerraxxe tulloshsha ifika woyyichcha mine ijaadheexxi</para>
  <para style="q2" vid="PSA 78:69">duuchchi wodda hexxammaxxe buttashsha jabeesse.<verse eid="PSA 78:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70" />Garbichcho ifika Daawwitii'i fi'le;</para>
  <para style="q2" vid="PSA 78:70">gedhebiinxe allalenaa'ninna isoo adhdhe.<note caller="-" style="x"><char style="xo" closed="false">78:70 </char><char style="xt" closed="false"><ref loc="1SA 16:11-12">1 Sam. 16:11-12</ref>; <ref loc="2SA 7:8">2 Sam. 7:8</ref>; <ref loc="1CH 17:7">1 Odo. 17:7</ref>. </char></note><verse eid="PSA 78:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71" />Gedhebiinxe allalenaa'n fulcheexxi arda ifike Ya'iqoobii'i,</para>
  <para style="q2" vid="PSA 78:71">Isira'eelii'i ifixxike allalisanjo asse.<verse eid="PSA 78:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72" />Daawwitinna mitte godobinni insa'nee allala'ni,</para>
  <para style="q2" vid="PSA 78:72">beekkumikinna insa'nee akeeke.<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="s1">Ardiinke Nage'i'a Soodatendeexxa Soodachcho</para>
  <para style="d">Asaafixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 79:1" />Ee, Magenoo! Gosa gosak ardi atika boga adhdhe;</para>
  <para style="q2" vid="PSA 79:1">woyyichcha galma atikanna battoosse;</para>
  <para style="q2" vid="PSA 79:1">Iyyerusaaleminna diige.<note caller="-" style="x"><char style="xo" closed="false">79:1 </char><char style="xt" closed="false"><ref loc="2KI 25:8-10">2 Moy. 25:8-10</ref>; <ref loc="2CH 36:17-19">2 Odo. 36:17-19</ref>; <ref loc="JER 52:12-14">Erm. 52:12-14</ref>. </char></note> <verse eid="PSA 79:1" /><verse number="2" style="v" sid="PSA 79:2" />Atike erganjuwwika rensha allaatte</para>
  <para style="q2" vid="PSA 79:2">atixxe qulliyyeka maala biniichchi itaashsha assine.<verse eid="PSA 79:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3" />Insa'ne Iyyerusaalemike qarqara'ni munde wodi'iinsha dunende;</para>
  <para style="q2" vid="PSA 79:3">insa'neka rensha moogaaki mitti manjinna midde gatebaan.<verse eid="PSA 79:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4" />Olla'a no'oke'n hedheeke gosa gosake arda'ni yowweemmenne;</para>
  <para style="q2" vid="PSA 79:4">qarqara no'oke'ni hedeeke gosa gosake arda'ni ce'memmeennekenna oso'lemmeenneke kandenne.<verse eid="PSA 79:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5" />Ee, Duuchchi Woddike Goottaa! No'o'nita duuchchi woddi'a mufatete?</para>
  <para style="q2" vid="PSA 79:5">Haani qico'nta hinaaffe atixxi giiratishsha ha'ita'ni hexxaa?<verse eid="PSA 79:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6" />Bala atixxa Magenumma atixxa ege'nebake gosa gosake arda'ni</para>
  <para style="q2" vid="PSA 79:6">atee summa atika soodattabaaxxe mootumma'n mufe atixxa dhangalaasi<verse eid="PSA 79:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7" />Tennee iitta assitaatelchi insa'ne Ya'iqoobixxa horte shinnemmaxxeenna,</para>
  <para style="q2" vid="PSA 79:7">baxxe insa'nexxa onchineemmaxxeeten.<verse eid="PSA 79:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8" />Yo'oshsha salphante hanguli hineennaxxee,</para>
  <para style="q2" vid="PSA 79:8">no'oke annuwwixxe cubboxxe no'on laakotexxe buuto'a no'o'o xixa waalde'e</para>
  <para style="q2" vid="PSA 79:8">mararte atixxi no'oba'a rakke dagowwaal.<verse eid="PSA 79:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9" />No'oo anjrtattoke Ee, Magenoo! Ulfinna atike summikee hite no'o gargaar;</para>
  <para style="q2" vid="PSA 79:9">atike summi'a hitee no'o anjir;</para>
  <para style="q2" vid="PSA 79:9">cubbo no'oxxeenna araarem.<verse eid="PSA 79:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10" />Gosa gosaak ardi, «Mageni insa'nek habata hedhe?» maa hiyya?</para>
  <para style="q2" vid="PSA 79:10">Atike erganjuwwixxa duundeexxa munde halo fula atixxa ille no'oxxi uunda'naa gosa gosake ardixxe oddo'n egendowwaal.<verse eid="PSA 79:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11" />Usuremeeke mannika abara uudi;</para>
  <para style="q2" vid="PSA 79:11">Reyaashsha murte uwwendeeka mannanna jabaaxxe atixxe hunnanni gatis.<verse eid="PSA 79:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12" />Dada Duuchchike Goottaa!</para>
  <para style="q2" vid="PSA 79:12">Qarqaark gosa gosak ardi ate'n afo'o fulchedheemmaxxee torbane anga insa'ne'n halo ful.<verse eid="PSA 79:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13" />Ookkone woddanna atixxe allaala giddo he'nennek atik ardi,</para>
  <para style="q2" vid="PSA 79:13">duuchchi wodda atee'e galateefantannon;</para>
  <para style="q2" vid="PSA 79:13">ilatenaa'n ilati qico'n atee sandannon.<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="s1">Isira'eelixxi Moottumma Haaroba Uurritaashsha soodatendeexxa Soodachcho</para>
  <para style="d">Faarsaleeyyetike Sooresi'aa «Daraaro» hiyyemaake Meelinni Faarsendaaxxa, Dhugaa Kulatixxa Asaafixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 80:1" />Isira'eelik allaalisanji, Yooseefixxa horte bobbaasatoke Magenoo!</para>
  <para style="q2" vid="PSA 80:1">Kiruubeelixxe oddo'n hexxexxe atixxe mootte'n ofoldeetekee!</para>
  <para style="q2" vid="PSA 80:1">Soodachcho no'oxxa laqi;</para>
  <para style="q2" vid="PSA 80:1">ifi atikinna ifowwaali.<note caller="-" style="x"><char style="xo" closed="false">80:1 </char><char style="xt" closed="false"><ref loc="EXO 25:22">Fula. 25:22</ref>. </char></note><verse eid="PSA 80:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2" />Efireemikenna Biniyaamike gosat mine'ninna Minaaseke gosat mini edo leelli;</para>
  <para style="q2" vid="PSA 80:2">hunna atixxenni kexxee</para>
  <para style="q2" vid="PSA 80:2">daggee no'oo anjiri.<verse eid="PSA 80:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3" />Ee, Magenoo! Edixxa jiro no'aa hiissi;</para>
  <para style="q2" vid="PSA 80:3">anjirremmonna'a mararte atixxa no'aa leelishshi.<verse eid="PSA 80:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4" />Ee, Dada Duuchcha Ajajjatokee Duuchchi Woddike Gootta Magenoo!</para>
  <para style="q2" vid="PSA 80:4">Aatike ardixxe soodachcho'ni haani qco'ni aartatto?<verse eid="PSA 80:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5" />Yaaddo insa'ne'n itisette, ha'wino'a indiddotanna bira sa'isite uutete.<verse eid="PSA 80:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6" />No'oke qarqara'n hedheek gosa gosak ardi boga no'oka adhdhatee weli'aan weli lolemmaashsha assittete;</para>
  <para style="q2" vid="PSA 80:6">naaphi no'ok duuchchi no'o'ni gacifate.<verse eid="PSA 80:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7" />Ee, Dada Duuchcha Ajajjatoke Magenoo edixxa jiro no'aa hiissi;</para>
  <para style="q2" vid="PSA 80:7">anjirremmonnaa'a alba atika no'aa ifi.<verse eid="PSA 80:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8" />Ati woyyinetika hiddichcho Gibtsee'n iyyedagette,</para>
  <para style="q2" vid="PSA 80:8">gosa gosaka arda shorrite'e,</para>
  <para style="q2" vid="PSA 80:8">boga insa'neke'n isoo kaassette.<verse eid="PSA 80:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9" />Ookkone boga isi'aa cirte gissittette;</para>
  <para style="q2" vid="PSA 80:9">isinna hidda butti'aa olteexxi,</para>
  <para style="q2" vid="PSA 80:9">boga ookkone'ninna wo'me.<verse eid="PSA 80:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10" />Gaaddisi isik koobuwwa,</para>
  <para style="q2" vid="PSA 80:10">isixxe damek gaaddisinna lumollamma birbrissuwwa golle.<verse eid="PSA 80:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11" />Dame isexxi Mediteranyaanxe abbaayya qico'n</para>
  <para style="q2" vid="PSA 80:11">kichchuwwatinna Efiraxisike galaani qico'n daaldee.<verse eid="PSA 80:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12" />Atike woyyinetike hiddichchonaa'n dalla'a diigee'naa</para>
  <para style="q2" vid="PSA 80:12">ora ookkone sa'aaki manji duuchchi gummichcho isinaa'n mayee'e qocedha?<verse eid="PSA 80:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13" />Booyyuwwa isoo hirbeesitaan;</para>
  <para style="q1" vid="PSA 80:13">Weli biniichchuwwinna isoo itaan.<verse eid="PSA 80:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14" />Ee, Dada Duuchcha Ajajjatoke Gootta Magenoo!</para>
  <para style="q1" vid="PSA 80:14">Ati no'obaa wirri hiyyi;</para>
  <para style="q2" vid="PSA 80:14">iimi'n butti'a no'obaa uudde afi;</para>
  <para style="q2" vid="PSA 80:14">konnee woyyinetika hiddichchonna heqqi.<verse eid="PSA 80:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15" />Atixxe middixxe anganni,</para>
  <para style="q2" vid="PSA 80:15">Kaalsiteteka konnee golqo</para>
  <para style="q2" vid="PSA 80:15">ifi'anna nossexxeteka woyyinetika hiddichcho heqqi.<verse eid="PSA 80:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16" />Isoo naaphi no'ok kukkute giirate'ni wore'een;</para>
  <para style="q2" vid="PSA 80:16">Magenoo mufe atixxenni insanee uudde'e balleessi.<verse eid="PSA 80:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17" />Middixxe anga atixxi giddo hedheeka,</para>
  <para style="q2" vid="PSA 80:17">ifi'a jabeessitetteka manjo anga atixxi isoo heqqitowwaal.<verse eid="PSA 80:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18" />Ta'anni eliqi'a atenaa'ni udumi'a hingabbe'non;</para>
  <para style="q2" vid="PSA 80:18">lubbo calla no'oo uggi;</para>
  <para style="q2" vid="PSA 80:18">atee galateefanta'n he'nannon.<verse eid="PSA 80:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19" />Ee, Dada Duuchcha Ajajattok Duuchchi Woddike Gootta Magenoo! Edixxa jiro no'aa hiissi;</para>
  <para style="q2" vid="PSA 80:19">anjirremmonna'aana alba atika no'aa ifi.<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="s1">Ayyaaniixxa Faaro</para>
  <para style="d">Faarsaleeyyetike Sooresi'a Suusu'let Faarsendaaxxa Asaafixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 81:1" />Uduuda no'oke kadeeke Mageni'aa gammashshoti faarse;</para>
  <para style="q2" vid="PSA 81:1">Ya'iqoobike Mageni'aa illillissee!<verse eid="PSA 81:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2" />Faarsate'n ke'we;</para>
  <para style="q2" vid="PSA 81:2">okolekanna ganne;</para>
  <para style="q2" vid="PSA 81:2">begenikinna masinqoti eloka meella meelle.<verse eid="PSA 81:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3" />Baate fuldee goobandaa wodda,</para>
  <para style="q2" vid="PSA 81:3">no'oke ayyaanixxe barra'n malagata ufuuffe.<note caller="-" style="x"><char style="xo" closed="false">81:3 </char><char style="xt" closed="false"><ref loc="NUM 10:10">Lak. 10:10</ref>. </char></note><verse eid="PSA 81:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4" />Kunni Isira'eeli'aa uwwemeeke seeraa,</para>
  <para style="q2" vid="PSA 81:4">Ya'iqoobik Mageni uwweeke ajajan.<verse eid="PSA 81:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5" />Gibtseeke boganaa'n fulee wodda</para>
  <para style="q2" vid="PSA 81:5">kunni Yooseefike ardi'aa uwweeke ajajan.</para>
  <para style="q2" vid="PSA 81:5">Ege'nebe'nok laagadinni hiyye haaso'a'naa laqene.<verse eid="PSA 81:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6" />Isinna hiyyee qici «Ani ha'noke dudduronaa'n ba'oo hoyyenne;</para>
  <para style="q2" vid="PSA 81:6">anga ha'nooxxanna qiricco abixxatenaa'n gatisenne.<verse eid="PSA 81:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7" />Rakkoti wodda anee ye'exxeten;</para>
  <para style="q2" vid="PSA 81:7">aninna atee fulchennen;</para>
  <para style="q2" vid="PSA 81:7">golla diddinsotixxe bakkabaa'n hiissichcho ati'a uwwene;</para>
  <para style="q2" vid="PSA 81:7">Meribaake wodi'i bira hega atee uudenen.<note caller="-" style="x"><char style="xo" closed="false">81:7 </char><char style="xt" closed="false"><ref loc="EXO 17:7">Fula. 17:7</ref>; <ref loc="NUM 20:13">Lak. 20:13</ref>. </char></note><verse eid="PSA 81:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8" />«Anke ardaa! Atee xexxe'achchiisannen laqi;</para>
  <para style="q2" vid="PSA 81:8">tee Isira'eeli! Hiyya'ennexxa laqaa'eetele siilan hitta eloxxemma.<verse eid="PSA 81:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9" />Weliink mageni ati giddo hedhoqqe'e;</para>
  <para style="q2" vid="PSA 81:9">alagiinke mageni'a heeshshi qokki hitoxxe'e.<verse eid="PSA 81:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10" />Gibtseeke boganaa'n atee fulchennek,</para>
  <para style="q2" vid="PSA 81:10">ani Duuchchi Woddike Gootta atike Magenon;</para>
  <para style="q2" vid="PSA 81:10">anee laqedhi, haasisaachcho duuchcha ati'a uwwannon.<note caller="-" style="x"><char style="xo" closed="false">81:10 </char><char style="xt" closed="false"><ref loc="EXO 20:2-3">Fula. 20:2-3</ref>; <ref loc="LEV 5:6-7">Lew. 5:6-7</ref>. </char></note><verse eid="PSA 81:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11" />«Ardi anki kinni hiyyennexxa laqebaan;</para>
  <para style="q2" vid="PSA 81:11">Isira'eeli ani'a ifi uwwa gibbeen.<verse eid="PSA 81:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12" />Tennexxee insa'ne ifi gallaashsha</para>
  <para style="q2" vid="PSA 81:12">ille mashsha duunde me'ino'aa wocci asssenne.<verse eid="PSA 81:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13" />«Ardi anki hiyyennexxa laqe'eele,</para>
  <para style="q2" vid="PSA 81:13">Isira'eeli silaan ora anke'n me'ite'eele,<verse eid="PSA 81:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14" />Ani naapha insa'neeka silaan injifate'eennan;</para>
  <para style="q2" vid="PSA 81:14">anga anxenni diina insa'neeka silaan gane'eennan.<verse eid="PSA 81:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15" />Duuchchi Woddika Gootta jibbaak duuchchi isi edo wabbi hiyyaan;</para>
  <para style="q2" vid="PSA 81:15">insa'nenna duuchchi woddi'a mura wonxa'ni he'naan.<verse eid="PSA 81:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16" />Ha'noo kinni eloxxe dinne ittisannon;</para>
  <para style="q2" vid="PSA 81:16">rassati giddike malebbininna ha'noo goddisannon.»<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="s1">Mageni Umo Galchallo Kadeexxa</para>
  <para style="d">Asaafixxa Faaro.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1" />Mageni iimatike ya'ixxe bukki'n</para>
  <para style="q2" vid="PSA 82:1">magennuwwi duuchchi bukk hiyyee wodda,</para>
  <para style="q2" vid="PSA 82:1">isi oddo insa'nexxe'n afeme'e muraan.<verse eid="PSA 82:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2" />«Ha'noo haani qico'n murte dassitinaa?</para>
  <para style="q2" vid="PSA 82:2">Haani qico'ntaa fuggaaleeyyetee gamissinaa?<verse eid="PSA 82:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3" />Gophaaleeyyeteenna anna afebaaxxe oose'aa dhugaati murre;</para>
  <para style="q2" vid="PSA 82:3">rakkiyyetikanna miicemeeke mannika seera heqqisse.<verse eid="PSA 82:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4" />Gophaaleeyyetanna rakkiyye furre;</para>
  <para style="q2" vid="PSA 82:4">fuggaalleyyetixxe anganaa'ni insa'nee gatisse.<verse eid="PSA 82:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5" />«Insa'ne ege'na yookaan galchecca anfebaan;</para>
  <para style="q2" vid="PSA 82:5">dukkannati giddo me'inaan;</para>
  <para style="q2" vid="PSA 82:5">buttatixxi booso duuchchanna lele'mitaan.<verse eid="PSA 82:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6" />«Aninna, ‹Ha'noo magennuwwake</para>
  <para style="q2" vid="PSA 82:6">duuchchiing Dada Duuchchike Duuchchi Woddike Gootta Mageniinke beltuwwan› hiyyenne.<note caller="-" style="x"><char style="xo" closed="false">82:6 </char><char style="xt" closed="false"><ref loc="JHN 10:34">Yoh. 10:34</ref>. </char></note><verse eid="PSA 82:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7" />Kaddo malee manjiinshanni rertinaan;</para>
  <para style="q2" vid="PSA 82:7">ha'noxxe hedhoxxi muuxenshanna hoone galchalixxishshanden»<verse eid="PSA 82:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8" />Gosa gosak ardi duuchchi atiken,</para>
  <para style="q2" vid="PSA 82:8">Ee, Magenoo! Ke'i! Boga duuchcha'ni muri.<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="s1">Isira'eelik Naaphi Injifatemo'a Soodatendeexxa Soodachcho</para>
  <para style="q1">Asaafixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 83:1" />Ee Magenoo! Sammi hitoxxe'e;</para>
  <para style="q2" vid="PSA 83:1">Ee Magenoo cuqqi'i gibboxxe'e; laqa gibboxxe'e!<verse eid="PSA 83:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2" />Kunse, naaphi atik qophphi hiyyeexxa;</para>
  <para style="q2" vid="PSA 83:2">diinuwwi atikiirinna umo ate'n togeexxa uudi.<verse eid="PSA 83:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3" />Arda atike'n xaqaroti mallaan;</para>
  <para style="q2" vid="PSA 83:3">ati heqqitaateke manna'ni fuggoxxa mari'antaan.<verse eid="PSA 83:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4" />«Isira'eelik summi qaabatemabbaashsha,</para>
  <para style="q2" vid="PSA 83:4">amme hingeexxi ardake kandabaashsha insa'ne birro» hine.<verse eid="PSA 83:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5" />Weli aangeexxi ate'n malle;</para>
  <para style="q2" vid="PSA 83:5">ate'n ke'no'aanna kakante.<verse eid="PSA 83:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6" />Eedoomikinna Isima'eelik ardi,</para>
  <para style="q2" vid="PSA 83:6">Mo'aabik, Agaarik,<verse eid="PSA 83:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7" />Gebaalik, Amoonik, Amaaleqik, Filisixeemikinna Xiroosike arduwwan.<verse eid="PSA 83:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8" />Asoorik ardinna insa'nee gargaare</para>
  <para style="q2" vid="PSA 83:8">Looxixxe hortenni mittoomme.<verse eid="PSA 83:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9" />(Magenoo), Midiyaamike manna'ni assiteteshshann insa'ne'ninna assi;</para>
  <para style="q2" vid="PSA 83:9">Qishoonike galaana'ni Sisaara'ninna Yaabiini'n assiteteshshanni insa'ne'ninna iittanni assi.<note caller="-" style="x"><char style="xo" closed="false">83:9 </char><char style="xt" closed="false"><ref loc="JDG 4:6-22">Hay. 4:6-22</ref>; <ref loc="JDG 7:1-23">7:1-23</ref>. </char></note><verse eid="PSA 83:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10" />Insa'nee Endoor shiyyeme</para>
  <para style="q2" vid="PSA 83:10">renshi insa'neekinna buttinake'n alo'eexxi kosete kade.<verse eid="PSA 83:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11" />Insa'neka akeekisanjuwwa Oreebishshanna Zeebiishsha,</para>
  <para style="q2" vid="PSA 83:11">insa'enka galchalluwwanna Zebahishanna Tsalmunasha assi.<note caller="-" style="x"><char style="xo" closed="false">83:11 </char><char style="xt" closed="false"><ref loc="JDG 7:25">Hay. 7:25</ref>; <ref loc="JDG 8:12">8:12</ref>. </char></note><verse eid="PSA 83:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12" />Insa'ne, «Amme, Mageniinke ardika boga adhdhine'e</para>
  <para style="q2" vid="PSA 83:12">no'oke umike asse'nannon» hineen.<verse eid="PSA 83:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13" />Ee anke Magenoo! Ati insa'nee hobonbalte filte me'itammaxxe bukko,</para>
  <para style="q2" vid="PSA 83:13">diidaloti edonna hedheeke huura assi.<verse eid="PSA 83:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14" />Giira gongoma ittammashsha,</para>
  <para style="q2" vid="PSA 83:14">bubenikinna koobuwwa araabammashsha,<verse eid="PSA 83:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15" />Iittanni diidallo atixxenni insa'nee fiissi;</para>
  <para style="q2" vid="PSA 83:15">hobonbalte atixxenninna insa'nee bararassi.<verse eid="PSA 83:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16" />Ee Duuchchi Woddike Goottaa! Summa atika ye'e'no'a</para>
  <para style="q2" vid="PSA 83:16">shoonke buxxuxxi hinaashsha assi.<verse eid="PSA 83:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17" />Duuchchi woddi'aanna shoonkowwaal; domminna hinowwaal;</para>
  <para style="q2" vid="PSA 83:17">salphantenna mundowwaal.<verse eid="PSA 83:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18" />Summi atik Dada Duuchchike Duuchchi Woddike Gootta kaddeteek</para>
  <para style="q2" vid="PSA 83:18">atin calli butta duuchcha'n Lumoke kaddeetexxa egennowwaal.<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="s1">Mageniinka Mine Yoraa</para>
  <para style="q1">Faarsaleeyyetike Akeekisanji'a Suusu'let Faarsendaaxxa Qorexxe Hortexxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 84:1" />Ee, Dada Duuchcha Ajajjatoke Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 84:1">Ati hexxa'etexxi bakka hittatta eeyyisa'neexxe?<verse eid="PSA 84:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2" />Lubbo anxi Duuchchi Woddike Goottixxa baxxe yo'oshsha yortaan;</para>
  <para style="q2" vid="PSA 84:2">hedhaake Mageni'a mitte godobinni gammada'nee illillisannon.<verse eid="PSA 84:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3" />Anke moyanjoo, anke Magenoo, Ee, Dada Duuchcha Ajajatoke Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 84:3">Atik tolchiinke boonchiba,</para>
  <para style="q2" vid="PSA 84:3">diilisse midde ifinga mine,</para>
  <para style="q2" vid="PSA 84:3">bejjo'otinna beltanna uggudhdhitaaxxa ifinxee bakka afe'een.<verse eid="PSA 84:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4" />Atike mini giddo hedheeke mannixxa wodo!</para>
  <para style="q2" vid="PSA 84:4">Insa'ne atee duuchchi wodda saandaan.<verse eid="PSA 84:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5" />Ati insa'ne'a uudduudake kadee'naa</para>
  <para style="q2" vid="PSA 84:5">Tsiyonxe Koobaba'a me'atee godobik yora'neeke mannixxa wodo!<verse eid="PSA 84:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6" />Insa'ne'e oodhishshatixxe bagoxxe dhooqa giddii'n sa'naa wodda</para>
  <para style="q2" vid="PSA 84:6">Mageni insa'ne'a eettene bakka muume phu'issaaxxe assaan;</para>
  <para style="q2" vid="PSA 84:6">mayetik xeeninna isee lashshi assaan.<verse eid="PSA 84:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7" />Insa'nenna me'inaa wodda uduuda lephphina'n me'inaan;</para>
  <para style="q2" vid="PSA 84:7">mitti mitting Tsiyooni hedheeke Mageni edo afemmaan.<verse eid="PSA 84:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8" />Ee dada duuchcha ajajjatoke Duuchchi Woddike Goottaa! Soodachcho anxa laqi;</para>
  <para style="q2" vid="PSA 84:8">Ee Ya'iqoobike Magenoo! Mansha atixxa aniba'a wirri assi.<verse eid="PSA 84:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9" />Ee Magenoo! Golla no'okee uudi;</para>
  <para style="q2" vid="PSA 84:9">hariirtetekanna eloxxenni uudi.<verse eid="PSA 84:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10" />Weleba kuma barra hedhat mannii'ni</para>
  <para style="q2" vid="PSA 84:10">atixxe baxxe'ni mitte barra hossa woyya;</para>
  <para style="q1" vid="PSA 84:10">Fugaaleeyyetike duunkaani giddo hedhati mannii'n</para>
  <para style="q2" vid="PSA 84:10">anke Magenike minixxe hula edika uurricho melledhanno.<verse eid="PSA 84:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11" />Duuchchi Woddik Gootti Mageni arshotenna wontete kademaxxee</para>
  <para style="q2" vid="PSA 84:11">Duuchchi Woddik Gootti gaachchannakanna ulfaachcho uwwaan;</para>
  <para style="q1" vid="PSA 84:11">Isi balleessa bello me'aaka manna eloxxa yaane hanqisabaan.<verse eid="PSA 84:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12" />Ee, Dada Duuchcha Ajajjatok Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 84:12">Atee addateeke manjixxa wodo!<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="s1">Ardiinke Nage'i'a Soodatendeexxa Soodachcho</para>
  <para style="q1">Faasaleeyyetike sooreesi'a Qorexxe Hortexxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 85:1" />Ee Duuchchi Woddike Goottaa! Atike bogi'a eloxxa assiteten;</para>
  <para style="q2" vid="PSA 85:1">Ya'iqoobixxe horte'a haaroba godda hiissitete.<verse eid="PSA 85:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2" />Atike ardixxe balleessa'a gatowwaal hitete;</para>
  <para style="q2" vid="PSA 85:2">cubbo insa'neexxa duuchchanna leellitabashsha assitete.<verse eid="PSA 85:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3" />Atixxa mufe enqexxe'eeten;</para>
  <para style="q2" vid="PSA 85:3">bubba'neexxa atixxa aarenna hiissexxe'eeten.<verse eid="PSA 85:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4" />Ee no'oke anjirallo Magenoo! No'oo ediba'a hiissi;</para>
  <para style="q2" vid="PSA 85:4">no'o'ni qoxxi hiyya waal.<verse eid="PSA 85:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5" />No'o'ni duuchchi woddi'aata muffatatto?</para>
  <para style="q2" vid="PSA 85:5">Mufe atixxi ilatenaa'ni ilate'n saxxaata?<verse eid="PSA 85:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6" />Ardi atik ate'n gammado'a</para>
  <para style="q2" vid="PSA 85:6">haaroba hedho no'aa ukkabexxoo?<verse eid="PSA 85:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7" />Ee Duuchchi Woddike Goottaa! Jaalala atixxa no'oo uudisi;</para>
  <para style="q2" vid="PSA 85:7">anjira atixxa no'aa badhaasi.<verse eid="PSA 85:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8" />Mageni Duuchchi Woddik Gootti haaso'aaxxa laqanno;</para>
  <para style="q2" vid="PSA 85:8">ifike qulichchi ardi'a nage'a haaso'aan;</para>
  <para style="q2" vid="PSA 85:8">kaddo malee meeni gowwummatibaa udumi'a hingowwaal.<verse eid="PSA 85:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9" />Isi gaachchanna ifikenni boga no'oke'ni galo'a</para>
  <para style="q2" vid="PSA 85:9">isoo sodataake anjira isixxi dhugaaten shiqixxen.<verse eid="PSA 85:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10" />Jaalalatinna dhugaa welti afende;</para>
  <para style="q2" vid="PSA 85:10">qullummatinna nage'i weli suunqedhe.<verse eid="PSA 85:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11" />Xuurameessumma buttii'n iimi'a latte;</para>
  <para style="q2" vid="PSA 85:11">qullummatinna iimii'n butti'a uudde.<verse eid="PSA 85:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12" />Duuchchi Woddik Gootti eloxxa yaane badhaasaan;</para>
  <para style="q2" vid="PSA 85:12">bog no'okinna midha fulchan.<verse eid="PSA 85:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13" />Qullumma isi edo me'ita'n,</para>
  <para style="q2" vid="PSA 85:13">orakanna isi'a qajeelchitaan.<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="s1">Gargaarsakee Soodatendeexxa Soodachcho</para>
  <para style="d">Daawwitixxa Soodachcho.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1" />Ee Duuchchi Woddike Goottaa! Ani hiyyeesakenna rakkichchake kadennaxxee</para>
  <para style="q2" vid="PSA 86:1">soodachcho anxa laqqee heeyyi.<verse eid="PSA 86:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2" />Ani xuurameesa atike kadennaxxee hedho anxa heqqi;</para>
  <para style="q2" vid="PSA 86:2">ati anke Magenon; ate'n addata'eenneka garbichcha atika anee anjir.<verse eid="PSA 86:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3" />Barra duuchcha atibaa soodata'eennen,</para>
  <para style="q2" vid="PSA 86:3">Ee Dada Duuchchike Goottaa! Ani'a o'wi.<verse eid="PSA 86:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4" />Ee Dada Duuchchike Goottaa! Lubbo anxa ate'ni uwwedha'eennen,</para>
  <para style="q2" vid="PSA 86:4">anee'e atike garbichchixxa lubbo gammachchiis.<verse eid="PSA 86:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5" />Ee Dada Duuchchike Goottaa! Ati elokenna aaraarendattoken;</para>
  <para style="q2" vid="PSA 86:5">atee ye'edhaake duuchchi'aanna, jaalala atixxi gabala affeexxebaan.<verse eid="PSA 86:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6" />Ee Duuchchi Woddike Goottaa! Soodachcho anxa caqasi;</para>
  <para style="q2" vid="PSA 86:6">anxe kadhaxxa oodhishshanna laqi.<verse eid="PSA 86:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7" />Ati ani'a hee hitataxxee</para>
  <para style="q2" vid="PSA 86:7">rakkotixxa barra atete ye'edhannon.<verse eid="PSA 86:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8" />Ee Dada Duuchchike Goottaa! Magenuwwi giddii'n atishsha hedheek hedheebaan;</para>
  <para style="q2" vid="PSA 86:8">atixxe hujenni weli qixxootaaxxi huje hexxebaan.<verse eid="PSA 86:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9" />Ee Dada Duuchchike Goottaa! Ati daddeteke gosa gosaki ardi duuhchi</para>
  <para style="q2" vid="PSA 86:9">dageexxi ati'a kumbu hiyyaan;</para>
  <para style="q2" vid="PSA 86:9">summa atikanna ulfeessaan.<note caller="-" style="x"><char style="xo" closed="false">86:9 </char><char style="xt" closed="false"><ref loc="REV 15:4">Wal. 15:4</ref>. </char></note><verse eid="PSA 86:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10" />Ati lumoke kaddetaxxee mambe'a yaanuwwa assittatton;</para>
  <para style="q2" vid="PSA 86:10">atinni calli Magenoken.<verse eid="PSA 86:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11" />Ee Duuchchi Woddike Goottaa! Ora atika anee barachchiis;</para>
  <para style="q2" vid="PSA 86:11">Dhugaa atixxe'ninna me'annon;</para>
  <para style="q2" vid="PSA 86:11">summa atikanna sodaatonna'a mitte godobike manjo anee assi.<verse eid="PSA 86:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12" />Ee Dada Duuchchike Gootta, anke Magenoo! Mitte godobinni atee saadannon;</para>
  <para style="q2" vid="PSA 86:12">summa atikanna duuchchi wodda ulfeessannon.<verse eid="PSA 86:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13" />Ani'a affeetexxi jaalala jabaxxen,</para>
  <para style="q2" vid="PSA 86:13">lubbo anxa hundike hirreesi gidii'n fulchitteten.<verse eid="PSA 86:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14" />Ee Magenoo! Hollaameeyye ane'n qophphi hite kexxeen;</para>
  <para style="q2" vid="PSA 86:14">sannachchi mararte afebaak lubbo anxa balleesso'a hasa'neen;</para>
  <para style="q2" vid="PSA 86:14">insa'ne atee mittelchchonna geessinsebaan.<verse eid="PSA 86:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15" />Ee Dada Duuchchike Goottaa!</para>
  <para style="q2" vid="PSA 86:15">Ati kinni araarendatokinna o'wittatok Mageni,</para>
  <para style="q2" vid="PSA 86:15">mufe dandeettatoke, ossa atixxinna xuurameessumma atixxi bira saxxe'eeken.<verse eid="PSA 86:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16" />Anibaa wirri hite'e ani'a araaremi;</para>
  <para style="q2" vid="PSA 86:16">hunna atixxa anee garbichcha atikee uwwi;</para>
  <para style="q2" vid="PSA 86:16">atixxe garbiteka belto anee anjir.<verse eid="PSA 86:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17" />Naaphi ank uudeexxi sodataka</para>
  <para style="q2" vid="PSA 86:17">atixxe elleka beessisa ani'a assi;</para>
  <para style="q2" vid="PSA 86:17">Ee Duuchchi Woddike Goottaa! Ati anee gargaarte'eten; jajjabeessite'eten.<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="s1">Iyyerusaalemixxee Shiqqeexxa Saadino</para>
  <para style="q1">Qorexxe Hortexxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 87:1" />Duuchchi Woddik Gootti ifike qachchixxa booso woyyitte kooba hana ijaare.<verse eid="PSA 87:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2" />Duuchchi Woddik Gootti Isira'eeli giddo hedheeke qachchuwwi duuchchi caala</para>
  <para style="q2" vid="PSA 87:2">Tsiyoonike qachcha eeyyaan.<verse eid="PSA 87:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3" />Ee Mageniinke qachchaa!</para>
  <para style="q2" vid="PSA 87:3">Atixxee ulfateexxi yaane haaso'enda'nee qici:<verse eid="PSA 87:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4" />«Anee ege'neeke ardinni Ra'aabininna Baabilooninn mitteba abidannon;</para>
  <para style="q2" vid="PSA 87:4">Filisixeeminna, Xiroosinna Tophiyiink mannininni</para>
  <para style="q2" vid="PSA 87:4">‹Kunni manjichchi ookko ilemeen› hinaan.»<verse eid="PSA 87:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5" />Tsiyoonii'i uuddaxxenni, «Kunni ardi, ikki ardinna</para>
  <para style="q2" vid="PSA 87:5">isen giddo ilemeeken;</para>
  <para style="q2" vid="PSA 87:5">umo ifingeninni Dada Duuchchik Duuchchi Woddik Gootti isee jabeese urrisaan» hiyyendaan.<verse eid="PSA 87:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6" />Duuchchi Woddik Gootti arda duuchcha borreessaa wodda «Kunni manji Tsiyooni giddo ilemeeken» hiyyee borreessaan.<verse eid="PSA 87:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7" />Faaro farsaakiirinna miya ganaakiir, «Yaane duuchcha ati giddii'n no'aa phu'issaan» hiyya'n farsaan.<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="s1">Garagaarsakee'e Soodatendeexxa Soodachcho</para>
  <para style="d">Qorexxe Hortexxa Faaro. Faarsaleeyeetike sooresi'a Asaafixxa Mahileti Hiyyendaaxxa Ezirahichcho Eetaanixxa Gence.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 88:1" />Ee, Duuchchi Woddike Gootta anke anjirallo Magenoo!</para>
  <para style="q2" vid="PSA 88:1">Hashsha barra ati edo oodhaannen.<verse eid="PSA 88:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2" />Kadha anxi ati edo geltowwaal;</para>
  <para style="q2" vid="PSA 88:2">mansha atixxanna anxe oodhishshabaa wirri assi.<verse eid="PSA 88:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3" />Lubbo anxi lumo qico rakkatemmaxxee'e,</para>
  <para style="q2" vid="PSA 88:3">hedho anxinna hundike hirreesiba'a shiqqe'een.<verse eid="PSA 88:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4" />Reyeexxi moogeemammake mannishsha uudemenne;</para>
  <para style="q2" vid="PSA 88:4">uduuda afebaake manjonna kadenne.<verse eid="PSA 88:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5" />Reyemmake manni giddo hunemeemmake,</para>
  <para style="q2" vid="PSA 88:5">shiyemeexxi bale giddo diriisemeemmake,</para>
  <para style="q2" vid="PSA 88:5">ati isoo hige'e qaabbatabexxokenna</para>
  <para style="q2" vid="PSA 88:5">heqqo atixenaa'n kutemeexxi gateeke manna kadenne.<verse eid="PSA 88:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6" />Ati anee hirreesii hundike wiidda'n</para>
  <para style="q2" vid="PSA 88:6">dimma dukkaanaxxe dhi'mo bale giddo dhidhinsittette.<verse eid="PSA 88:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7" />Atixxi mufe ane'n hirrik hitee a'urte'een;</para>
  <para style="q2" vid="PSA 88:7">danbala'i atik duuchchinna anee buqe'een.<verse eid="PSA 88:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8" />Fir ank duuchchi ane'naa'n bayyatashsha,</para>
  <para style="q2" vid="PSA 88:8">aninna insa'nee gibisannoke assite;</para>
  <para style="q2" vid="PSA 88:8">hula ani'a cufende'een dande'e fulabe'non.<verse eid="PSA 88:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9" />Yaadotenaa'n kexxeexxa ille anxi gophphe;</para>
  <para style="q2" vid="PSA 88:9">Ee Duuchchi Woddike Goottaa! Barra barra'n atee ye'edha'eennen;</para>
  <para style="q2" vid="PSA 88:9">sooddachotinna anga anxa atibaa ke'isa'eennen.<verse eid="PSA 88:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10" />Reyeeke manni'a mambe'a assittatota?</para>
  <para style="q2" vid="PSA 88:10">Ekedha kexxee atee saaddaata?<verse eid="PSA 88:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11" />Jaalala atixxi hirreesi giddo</para>
  <para style="q2" vid="PSA 88:11">xuurameessumma atixxinna ba'netixxe bakka'n kulendaata?<verse eid="PSA 88:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12" />Atike mambe'ixx huje dukkanatixxe bakka'n</para>
  <para style="q2" vid="PSA 88:12">qullumma atixxinna dedhematike boga'n ege'nendaata?<verse eid="PSA 88:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13" />Ee Duuchchi Woddike Goottaa! Anee gargaartota'a atibaa oodha'eennen;</para>
  <para style="q2" vid="PSA 88:13">gorsa gorsa'ninni atee soodatannon.<verse eid="PSA 88:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14" />Ee Duuchchi Woddike Goottaa! Mayee anee waaldete?</para>
  <para style="q2" vid="PSA 88:14">Meyeeta anenaa'ni alba sho'exxete?<verse eid="PSA 88:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15" />Ani oosummandenaa'n rakkichchakenna reyo shiqeennakeman;</para>
  <para style="q2" vid="PSA 88:15">bararaassa atixxi anee dhibbe; kadannoxxanna gophenne.<verse eid="PSA 88:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16" />Mufe atixxi ane'n gelte'e</para>
  <para style="q2" vid="PSA 88:16">atixxi bararassa anee balleessitaan.<verse eid="PSA 88:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17" />Mufe atixxinna bararassa atixxi lola'uffa anee buqqe;</para>
  <para style="q2" vid="PSA 88:17">duuchchi darree'n mitteba ane'n qoqobbe.<verse eid="PSA 88:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18" />Jaaluwwi ankinna firi ank anenaa'n bayyataashsha assittette;</para>
  <para style="q2" vid="PSA 88:18">dukana calli anke jaalo kadde gatte.<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="s1">Rakkoti Woddixxa Soodachcho</para>
  <para style="q1">Ezirahichcho Eetaanixxa Gence.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 89:1" />Duuchchi Woddike Goottixxe jaalalaxxee duuchchi wodda farsanon;</para>
  <para style="q2" vid="PSA 89:1">xuurameesumma atixxa ilatenaa'n ilati qico'n afo'o ankenni lallabannon.<verse eid="PSA 89:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2" />Jaalala atixxi duuchchi woddi'a qattande hexxaaxxa,</para>
  <para style="q2" vid="PSA 89:2">atixxe xuurameesummaxxi uchchumenna iimate'n kaddeexxa haaso'annon.<verse eid="PSA 89:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3" />Atinna hiteete qici, «Ani fi'lennekee'e kako aage'eennen;</para>
  <para style="q2" vid="PSA 89:3">garbichcho anke Daawwiti'a kakate'eennen;<verse eid="PSA 89:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4" />‹Hitetexxi kako aaggeete qicinna, horte atixxa uchchumetixxe assannon;</para>
  <para style="q2" vid="PSA 89:4">moote atixxanna ilatenaa'n ilati qico'n qatansannon<note caller="-" style="x"><char style="xo" closed="false">89:4 </char><char style="xt" closed="false"><ref loc="2SA 7:12-16">2 Sam. 7:12-16</ref>; <ref loc="1CH 17:11-14">1 Odo. 17:11-14</ref>; <ref loc="PSA 132:11">Far. 132:11</ref>; <ref loc="ACT 2:30">Erga. Huj. 2:30</ref>. </char></note>› »<verse eid="PSA 89:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5" />Ee Duuchchi Woddike Goottaa! Iimuwwa mambe'iinxa atixxa huje,</para>
  <para style="q2" vid="PSA 89:5">xuurameessumma atixxanna qulliyyetixxe bukki giddo saaddaan.<verse eid="PSA 89:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6" />Iimate'n Duuchchi Woddike Goottinni qixxo'aak ayyete hedhe?</para>
  <para style="q2" vid="PSA 89:6">Iimatixxe daduwwa giddii'n Duuchchi Woddika Gootta ayyete labaak?<verse eid="PSA 89:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7" />Mageni iimatixxi woyyoolle giddo lumoshsha sodateme'eeken;</para>
  <para style="q2" vid="PSA 89:7">qarqara isike'n hedheeke duuchchanaa'ninna lumoshsha ulfate'eeken.<verse eid="PSA 89:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8" />Ee Duuchchi Woddike Gootta hunna duuchchike Magenoo! Atishsha hedheek ayyete?</para>
  <para style="q2" vid="PSA 89:8">Ee Duuchchi Woddike Goottaa! Ati hunnaameessaken;</para>
  <para style="q2" vid="PSA 89:8">xuurameessumma atixxi atee qoqqobe'een.<verse eid="PSA 89:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9" />Abbaayyatixxa daaqana mootommatixxa hunna affeete;</para>
  <para style="q2" vid="PSA 89:9">iseke wodiixxa ganeshshanna sammi assitatton.<verse eid="PSA 89:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10" />Re'aabi abbaayyatixxa jawwe,</para>
  <para style="q2" vid="PSA 89:10">yakkemeemmalchchishsha cancaqqette;</para>
  <para style="q2" vid="PSA 89:10">jabaxxe atixxe hirrenni naapha atika xeertette.<verse eid="PSA 89:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11" />Iimuwwa atixxe, buttatinna atixxen;</para>
  <para style="q2" vid="PSA 89:11">buttatixxinna ise giddo hedheechchi duuchchixxi hundaayye ateten.<verse eid="PSA 89:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12" />Middakanna bita'a dadetek ateten;</para>
  <para style="q2" vid="PSA 89:12">Taboorixxinna Herimoonixxi koobuwwa summa atikee illillisaan.<verse eid="PSA 89:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13" />Atixxi hirre hunna affe'eexxen;</para>
  <para style="q2" vid="PSA 89:13">anga atixxi jabaxxen; middixxi atixxi anganna ulfate'eexxen.<verse eid="PSA 89:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14" />Qullummatinna dhugaa mura atixxe mootexxe uchchumman;</para>
  <para style="q2" vid="PSA 89:14">jaalalatinna xuurameessumma atilchchon.<verse eid="PSA 89:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15" />Ee Duuchchi Woddike Goottaa! Atee magenoofachcho ege'neeke,</para>
  <para style="q2" vid="PSA 89:15">atixxe elleke ifi giddo mammaremaake mannixxa wodo!<verse eid="PSA 89:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16" />Insa'ne barra duuchcha ate'n gammandaan;</para>
  <para style="q2" vid="PSA 89:16">atixxe qullummanninna ulfeessemaan.<verse eid="PSA 89:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17" />Ati insa'neke uuduudike gaachchanna kaddetaxxe'ee</para>
  <para style="q2" vid="PSA 89:17">atixxe ellenni injifachcho no'aa uutteten.<verse eid="PSA 89:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18" />Wonte no'oxxi Duuchchi Woddike Gootta kaddemmaxxee</para>
  <para style="q2" vid="PSA 89:18">moyanji no'okinna umo insiingee Isira'eelike woyyichchan.<note caller="-" style="x"><char style="xo" closed="false">89:18 </char><char style="xt" closed="false"><ref loc="1KI 4:31">1 Moy. 4:31</ref>. </char></note><verse eid="PSA 89:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19" />Konneechi edo waleellati haasote'e</para>
  <para style="q2" vid="PSA 89:19">xuurameesa atika arda hite'eeta qici: «An isoo goota manjo gargaarenne;</para>
  <para style="q2" vid="PSA 89:19">ardi giddii'n fi'lemeeka isoo'o quba sa'isenne.<verse eid="PSA 89:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20" />Anka eragaanjo Daawwitii'i alfenne;</para>
  <para style="q2" vid="PSA 89:20">anxa woyyitte zayitenna iso'n hariirenne.<note caller="-" style="x"><char style="xo" closed="false">89:20 </char><char style="xt" closed="false"><ref loc="1SA 13:14">1 Sam. 13:14</ref>; <ref loc="ACT 13:22">Erga. Huj. 13:22</ref>; <ref loc="1SA 16:12">1 Sam. 16:12</ref>. </char></note><verse eid="PSA 89:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21" />Anga anxi isoo kiphphaan;</para>
  <para style="q2" vid="PSA 89:21">hirre anxinna isoo jabeessitaan.<verse eid="PSA 89:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22" />Naaphi isoo anga aadhabaan;</para>
  <para style="q2" vid="PSA 89:22">fuggaaleessi manjinna isoo salphisabaan.<verse eid="PSA 89:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23" />Diina isikaara isi edo butuchchannon;</para>
  <para style="q2" vid="PSA 89:23">isoo gibaaka duuchchanna butta ibisannon.<verse eid="PSA 89:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24" />Xuurameessumma anxinna jaalala anxi isinni welti hexxaan;</para>
  <para style="q2" vid="PSA 89:24">summa ankenninna injiffachcho alfaan.<verse eid="PSA 89:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25" />Abaayyuwwa anga isixxi hunda</para>
  <para style="q2" vid="PSA 89:25">galaanuwwakanna middixxe isixxe anga hunda galchannon.<verse eid="PSA 89:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26" />Isinna anee'e, ‹Ati aneke annan, anke Magenon;</para>
  <para style="q2" vid="PSA 89:26">anjiremannoxxe anxe rassan› hiyyaan.<verse eid="PSA 89:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27" />Aninna isoo'o anke angafa belto assedhannon;</para>
  <para style="q2" vid="PSA 89:27">buttatike moyanjuwwi caalanna ulfaataan.<note caller="-" style="x"><char style="xo" closed="false">89:27 </char><char style="xt" closed="false"><ref loc="REV 1:5">Wal. 1:5</ref>. </char></note><verse eid="PSA 89:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28" />Isi'a afennexxi jaalala duuchchi woddixxen;</para>
  <para style="q2" vid="PSA 89:28">isi'a aagennexxi kakonna addatendee hexxaan.<verse eid="PSA 89:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29" />Horte isixxa duuchchi woddi'a,</para>
  <para style="q2" vid="PSA 89:29">moote isixxanna iima hexxeeke bari qico'n dhaabannon.<verse eid="PSA 89:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30" />«Oose isixxi seera anka saxxoole,</para>
  <para style="q2" vid="PSA 89:30">ajaja anke'n gala gophoole,<verse eid="PSA 89:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31" />Murte anxa qaxxaamurtoole,</para>
  <para style="q2" vid="PSA 89:31">ajaja ankanna ulfeessa gophoole,<verse eid="PSA 89:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32" />Cubbo insa'nexxee'e insa'nee ganannon;</para>
  <para style="q2" vid="PSA 89:32">balleessa insa'nexxeenna insa'nee jiraafet xixannon.<verse eid="PSA 89:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33" />Jaalala anxa kinni isonaa'n hiisedhabe'no;</para>
  <para style="q2" vid="PSA 89:33">xuurameessumma anxanna xe'yishabe'no.<verse eid="PSA 89:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34" />Kako anxanna diigabe'non;</para>
  <para style="q2" vid="PSA 89:34">anke afo'onaa'ni fuleeka haasoanna jijirabe'no.<verse eid="PSA 89:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35" />Mittele woyyichcha anke summinni kakate'eennen</para>
  <para style="q2" vid="PSA 89:35">Daawwitii'i sobabe'no.<verse eid="PSA 89:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36" />Horte isixxi duuchchi woddi'a,</para>
  <para style="q2" vid="PSA 89:36">moote isixxinna ani edo arsho hexxeeke bari qico'n turtaan.<verse eid="PSA 89:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37" />Moote isixxi iimate'n dhugaatixxe dhugaa kula kadde</para>
  <para style="q2" vid="PSA 89:37">hexxemmaxxe baateshsha duuchchi woddi'a kaasendee hexxaan.»<verse eid="PSA 89:37" /></para>
  <para style="s1">Naaphi Moyanjo Injifatatenaa'ni Kexxeexxa Daawwitixxa Yaado</para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38" />Ta'a kinni hariirtetaka moyanjo tuffate'eeten, gibe'eeten,</para>
  <para style="q2" vid="PSA 89:38">iso'ninna lumoshsha mufate'eeten.<verse eid="PSA 89:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39" />Atike erganji'a aaggetexxa kako diigge'eeten;</para>
  <para style="q2" vid="PSA 89:39">kallachcha isikanna buttinake'n darbite'e isoo shollishshe'eten.<verse eid="PSA 89:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40" />Isike qachchika dalla'a duuchchanna banqarsite'e diigge'eeten;</para>
  <para style="q2" vid="PSA 89:40">kolluwwa isixxanna fedenshitee birte'eeten.<verse eid="PSA 89:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41" />Ora sa'ammak duuchchi isoo saame;</para>
  <para style="q2" vid="PSA 89:41">olla'uwwa ifikee'e gacifachchotike kadeen.<verse eid="PSA 89:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42" />Midditte diina isikee uutete;</para>
  <para style="q2" vid="PSA 89:42">naapha isika duuchchanna gammachchiisette.<verse eid="PSA 89:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43" />Isike wolantichchika qara udumi'a wirri assittete;</para>
  <para style="q2" vid="PSA 89:43">loli giddonna isoo gargaartebexxo.<verse eid="PSA 89:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44" />Gaachchanna isonaa'n hoyyittete;</para>
  <para style="q2" vid="PSA 89:44">moote isixxanna buttinake'n ibissete.<verse eid="PSA 89:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45" />Dargageessummatika isika baro harunsitetexxi</para>
  <para style="q2" vid="PSA 89:45">shooko iso'n oddeesittete.<verse eid="PSA 89:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46" />Ee Duuchchi Woddike Goottaa! Tinni haani qico'ni kadda?</para>
  <para style="q2" vid="PSA 89:46">Ati duuchi woddi'a ifi shoxxatto? Mufe atixxita giiratishsha bubba'n hexxaa?<verse eid="PSA 89:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47" />Bari ank hitte qico harumaake kadeexxa hedi;</para>
  <para style="q2" vid="PSA 89:47">manjiinka belto ittanni tolangee daddeete!<verse eid="PSA 89:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48" />Reyebaang hedhotike kade'e gataak manji hedhee isi?</para>
  <para style="q2" vid="PSA 89:48">Hirreessa hundikenaa'n dandeexxi ifi gatisaakita ayyete?<verse eid="PSA 89:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49" />Ee dada duuchhcike Goottaa!</para>
  <para style="q2" vid="PSA 89:49">Daawwiti'a xuurameessumma atixxenni kakatetaxxi</para>
  <para style="q2" vid="PSA 89:49">olmixxi atixxi jaalalata haba hexxe?<verse eid="PSA 89:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50" />Ee dada duuchchike Goottaa! Garbichchi atik hitee qico gacifatemeexxa,</para>
  <para style="q2" vid="PSA 89:50">gosa gosake mannixxa cee'manna hitta osse sa'ennexxa hedi.<verse eid="PSA 89:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51" />Ee Duuchchi Woddike Goottaa! Atik naaphi isoo yowe'eeke</para>
  <para style="q2" vid="PSA 89:51">me'a cee'mende'eke fi'liteteke manjixxa cee'mema uudi.<verse eid="PSA 89:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52" />Duuchchi Woddik Gootti duuchchi woddi'a eebbiseme'eeke kadowwaal!</para>
  <para style="qc" vid="PSA 89:52">Hmiin! Hmiin!<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms">Sholgaaka Maxaafa</para>
  <para style="mr">
    <ref loc="PSA 90-106">Far. 90—106</ref></para>
  <para style="s1">Magenokanna Manjoo</para>
  <para style="q1">Mageniinkaa Manjo Muusexxa Soodachcho.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 90:1" />Ee dada duuchchike Goottaa!</para>
  <para style="q2" vid="PSA 90:1">Ati ilatenaa'ni ilati qico'n no'oke golla kadde'eeten.<verse eid="PSA 90:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2" />Koobuwwa bakka ifixxe'n ilendebaang,</para>
  <para style="q2" vid="PSA 90:2">bogakanna butta duuchcha dadebexxo edi darre</para>
  <para style="q2" vid="PSA 90:2">duuchchii woddanaa'n duuchchii woddi'a ati Magenoken.<verse eid="PSA 90:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3" />Ati, «Koo manjiinke beltoo buttinange'ni higi» hitatton,</para>
  <para style="q2" vid="PSA 90:3">manjokanna wirri assitee'e buttiniinbaa'a hiissittatton.<verse eid="PSA 90:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4" />Kuma wogga ati edo</para>
  <para style="q2" vid="PSA 90:4">saxxeexxe bereqixxe barrashshaten;</para>
  <para style="q2" vid="PSA 90:4">iittan suukii'i hashshixxishaten.<note caller="-" style="x"><char style="xo" closed="false">90:4 </char><char style="xt" closed="false"><ref loc="2PE 3:8">2 Phex. 3:8</ref>. </char></note><verse eid="PSA 90:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5" />Ati manjo lola'iinsha filte hoyyittato wodda,</para>
  <para style="q2" vid="PSA 90:5">insa'ne oojjotishsha sa'naan;</para>
  <para style="q2" vid="PSA 90:5">insa'ne gorsa gorsa qokki hite'e latammaxxe badda'ashshaten.<verse eid="PSA 90:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6" />Badda'a gorsa latteexxi quffaan;</para>
  <para style="q2" vid="PSA 90:6">galgalo'a wodda kinni lunbu hitee'e qoortaan.<verse eid="PSA 90:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7" />Mufe atixxi no'o balleessiteen;</para>
  <para style="q2" vid="PSA 90:7">aare atixxinna no'o'o alalshiteen.<verse eid="PSA 90:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8" />Ati balleessa no'oxxa ifi edo,</para>
  <para style="q2" vid="PSA 90:8">sho'nennexxi hunjennexxa cubbonna atike albike ifi edo uggittatton.<verse eid="PSA 90:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9" />Bari no'oki duuchchi no'o'n muffata'naan mude;</para>
  <para style="q2" vid="PSA 90:9">wogga no'oxxanna foo'lati bidhdhinnannon.<verse eid="PSA 90:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10" />No'oxxe hedhok bari torbaane tomme woggan,</para>
  <para style="q2" vid="PSA 90:10">bira sa'oole sadeeta tomme woggan;</para>
  <para style="q2" vid="PSA 90:10">ise giddo bira sa'xxaaxxi rakkotenna yaadoten;</para>
  <para style="q2" vid="PSA 90:10">isenni rakke saxxaan; no'onna sukuti hinnannon.<verse eid="PSA 90:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11" />Atixxe mufexxa hunna ayyete ege'nee?</para>
  <para style="q2" vid="PSA 90:11">Ati'a hasisaake ulfinishshanni aare atixxinna jabaxxen.<verse eid="PSA 90:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12" />Beekuma qalbetika anfannoshsha</para>
  <para style="q2" vid="PSA 90:12">bari no'ok hittee qico harumaake kadeexxa no'oo barachchiis.<verse eid="PSA 90:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13" />Ee Duuchchi Woddike Goottaa! Higi;</para>
  <para style="q2" vid="PSA 90:13">tinni haani qico'ni kadda?</para>
  <para style="q2" vid="PSA 90:13">Erganjuwwa atikeenna o'wi.<verse eid="PSA 90:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14" />Baro no'oke duuchcha'ni gammanda'ni illillisannoshsha</para>
  <para style="q2" vid="PSA 90:14">gorsa jaalala atixxenni no'oo goddisi.<verse eid="PSA 90:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15" />Rakko no'oo uudisseteke barixxe qixxe'ni</para>
  <para style="q2" vid="PSA 90:15">fuggoxxi no'o'ni gelteeke sannixxe qixxe'ni</para>
  <para style="q2" vid="PSA 90:15">no'oo gammachchiisi.<verse eid="PSA 90:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16" />Huje atixxi erganjuwwa atike'ni</para>
  <para style="q2" vid="PSA 90:16">gaachchanni atikinna insa'nexxe oose'n leellaashsha assi.<verse eid="PSA 90:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17" />Dada duuchchike Gootta no'oke Magenixxi elle no'o'ni hexxowwaal;</para>
  <para style="q2" vid="PSA 90:17">isi no'oxxe angaxxa huje no'aa qatansowwaal;</para>
  <para style="q2" vid="PSA 90:17">ee no'aa qatansowwaal.<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="s1">Mageniinxa Heqqaa</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 91:1" />Dada Duuchchike Duuchchi Woddike Goottike qoorchcho'n hedhaak,</para>
  <para style="q2" vid="PSA 91:1">duuchchiinxa dande'aake</para>
  <para style="q2" vid="PSA 91:1">Dada duuchcha ajajaake Mageniinke gaaddis hunda galaan.<verse eid="PSA 91:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2" />Duuchchi Woddika Gootta, «Ati anke gollanna anxe kollon; ati anke Mageno ate'n addata'eeneken» hiyyaan.<verse eid="PSA 91:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3" />Mageni atee sho'ondeexxe fonxoronaa'ni, qoomaake dhukubanaa'n heqaan.<verse eid="PSA 91:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4" />Guchche ifixxenni atee gollaan;</para>
  <para style="q2" vid="PSA 91:4">keela isik giddonna sho'ondatton;</para>
  <para style="q2" vid="PSA 91:4">xuurameessumma isixxi ati'a wontetenna dalla'ake kaddaan.<verse eid="PSA 91:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5" />Alalshitaaxxa hashsha,</para>
  <para style="q2" vid="PSA 91:5">barra darbemaaka mogidonna sodaatabexxo.<verse eid="PSA 91:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6" />Dukkana giddo lulluggaaxxe bala'a</para>
  <para style="q2" vid="PSA 91:6">saafo'a me'itaaxxe ba'ne'aanna shokki hitabexxo.<verse eid="PSA 91:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7" />Kumi qarqara atike'n</para>
  <para style="q2" vid="PSA 91:7">tommi kuminna middi darre'n ibaan;</para>
  <para style="q2" vid="PSA 91:7">atibaa kinni shiqaachchi hedhabaan.<verse eid="PSA 91:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8" />Ati kinni ille callin uuddatton;</para>
  <para style="q2" vid="PSA 91:8">fuggaalleeyyetixxa xixenshanna affatton.<verse eid="PSA 91:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9" />Ati Duuchchi Woddika Gootta ifixxe kollo,</para>
  <para style="q2" vid="PSA 91:9">Dada Duuchchika Duuchchi Woddika Gootta qoorchchoke assexxe'eeten.<verse eid="PSA 91:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10" />Tennexxee fuggoxxi yaane ate'n daggabaan;</para>
  <para style="q2" vid="PSA 91:10">balatinna atike duunkaanike qarqara'n shiqqabaan.<verse eid="PSA 91:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11" />Me'itattoke ora duuchcha'n atee heqito'a</para>
  <para style="q2" vid="PSA 91:11">erganna ifixxa atixxee ajajammaxxeeten,<note caller="-" style="x"><char style="xo" closed="false">91:11 </char><char style="xt" closed="false"><ref loc="MAT 4:5">Mat. 4:5</ref>; <ref loc="LUK 4:10">Luq. 4:10</ref>. </char></note><verse eid="PSA 91:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12" />Lekka atixxi kinjoke'n ganeddabaashsha</para>
  <para style="q2" vid="PSA 91:12">erganna anga ifixxen atee qophphi assitaan.<note caller="-" style="x"><char style="xo" closed="false">91:12 </char><char style="xt" closed="false"><ref loc="MRK 4:6">Mar. 4:6</ref>; <ref loc="LUK 4:11">Luq. 4:11</ref>. </char></note><verse eid="PSA 91:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13" />Neenqake'ninna buuteti hana haxxatton;</para>
  <para style="q2" vid="PSA 91:13">sodachchisaake neenqa'ninna jawweti hana hirbeessittatton.<note caller="-" style="x"><char style="xo" closed="false">91:13 </char><char style="xt" closed="false"><ref loc="LUK 10:19">Luq. 10:19</ref>. </char></note><verse eid="PSA 91:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14" />«Anee eeyyemmaxxee ani isoo anjirannon;</para>
  <para style="q2" vid="PSA 91:14">anee ege'ne'een isoo gollannon.<verse eid="PSA 91:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15" />Anee'e ye'edhaa wodda laqannon;</para>
  <para style="q2" vid="PSA 91:15">rakkotixxa yannanna isinni hedhannon;</para>
  <para style="q2" vid="PSA 91:15">ookko'ninna isoo fulchannon; ulfeessannon.<verse eid="PSA 91:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16" />Qeerraxxa wogga isoo goddisannon;</para>
  <para style="q2" vid="PSA 91:16">anjira anxanna uudashsha assannon.»<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s1">Saadinotixxa Faaro</para>
  <para style="q1">Edi Sanbatiinxa Barra Faarsendaaxxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 92:1" />Duuchchi Woddika Gootta saada danchaten,</para>
  <para style="q2" vid="PSA 92:1">Ee Lumokee Magenoo summa atika faarsa eloxxen.<verse eid="PSA 92:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2" />Gorsa jaalala atixxa haaso'a</para>
  <para style="q2" vid="PSA 92:2">xuurameessumma atixxanna hashsha lallaba danchaten.<verse eid="PSA 92:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3" />Tomme jimmaateke baganinninna</para>
  <para style="q2" vid="PSA 92:3">masinqotike meellinni lallaba eloxxen.<verse eid="PSA 92:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4" />Ee Duuchchi Woddike Goottaa, huje atixxenni anee gammachchiiseetaxxee</para>
  <para style="q2" vid="PSA 92:4">atixxe angaxxe hujexxee gammashshoti ati'a faaro farsa'eenne.<verse eid="PSA 92:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5" />Ee Duuchchi Woddike Goottaa huje atixxi hittatta lumoxxe!</para>
  <para style="q2" vid="PSA 92:5">Yaadi atikinna hittatta a'ureeke!<verse eid="PSA 92:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6" />Hawwawwi manni tennee ege'nebaan;</para>
  <para style="q2" vid="PSA 92:6">gowwa manna'ninna aaggabaan.<verse eid="PSA 92:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7" />Fuggaaleeyye badda'atishsha lattoole</para>
  <para style="q2" vid="PSA 92:7">fuggoxxa assaakiir qufoole,</para>
  <para style="q2" vid="PSA 92:7">insa'ne duuchchii woddi'a ba'naan.<verse eid="PSA 92:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8" />Ee Duuchchi Woddike Goottaa! Ati kinni</para>
  <para style="q2" vid="PSA 92:8">duuchchii woddi'a duuchiingike umon.<verse eid="PSA 92:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9" />Naaphi atik Ee Duuchchi Woddike Goottaa</para>
  <para style="q2" vid="PSA 92:9">naaphi atik ba'a ba'aan,</para>
  <para style="q2" vid="PSA 92:9">fuggoxxa assak duuchchinna bittino'aan.<verse eid="PSA 92:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10" />Ati anee gafarsiinsha jabeessittetten;</para>
  <para style="q2" vid="PSA 92:10">eloxxe zayitenninna anee lashshi assittetten.<verse eid="PSA 92:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11" />Ille anxi anke diinixxa injifatema uudde;</para>
  <para style="q2" vid="PSA 92:11">mansha anxinna fuggichcha anke naaphixxa gadooda laqqe.<verse eid="PSA 92:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12" />Qulliyye meexxetishsha barqaaqqaan;</para>
  <para style="q2" vid="PSA 92:12">Libaanoosike birbirsishshanna inkuruurtaan.<verse eid="PSA 92:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13" />Insa'ne Duuchchi Woddike Goottike mini giddo kaaseme'een;</para>
  <para style="q2" vid="PSA 92:13">no'oke Magenixxe baxxe'ninna barqanqaan.<verse eid="PSA 92:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14" />Cimoti giddonna midde gumminsaan;</para>
  <para style="q2" vid="PSA 92:14">qunfeeshanni, jabanteeshanni he'naan.<verse eid="PSA 92:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15" />«Duuchchi Woddik Gootti toggitte yaane assaan;</para>
  <para style="q2" vid="PSA 92:15">isi anxe rassan; iso'n mitte gugurto hexxebaan» hinaan.<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="s1">Mageni Moyanjoken</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 93:1" />Duuchchi Woddik Gootti moye;</para>
  <para style="q2" vid="PSA 93:1">gaachchannakanna gonfedhe;</para>
  <para style="q2" vid="PSA 93:1">Duuchchi Woddik Gootti gaachchanna odo'we;</para>
  <para style="q2" vid="PSA 93:1">uduudakanna ka'le;</para>
  <para style="q1" vid="PSA 93:1">Butta jabeesendee urriteen; ayyinna isee'e le'misabaan.<verse eid="PSA 93:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2" />Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 93:2">Ati olminaa'ninni moote'eeteken;</para>
  <para style="q2" vid="PSA 93:2">baruwwi duuchchi edi darrenni hexxetan. <verse eid="PSA 93:2" /><verse number="3" style="v" sid="PSA 93:3" />Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 93:3">Abbaayyuwwa iimi'a dhuqqatte; luulijokanna gikki assite luulde;</para>
  <para style="q2" vid="PSA 93:3">iseke danbala'ixxi giwweetenna laqende.<verse eid="PSA 93:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4" />Yaane kinni heddo lumollamma</para>
  <para style="q2" vid="PSA 93:4">abbaayyuwwake luulji iimi darre</para>
  <para style="q2" vid="PSA 93:4">abbaayyuwwatike jabake danbala'uwwi caalanna</para>
  <para style="q2" vid="PSA 93:4">Duuchchi Woddik Gootti duuchchiinge'naa'n caala hunnameessaken.<verse eid="PSA 93:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5" />Duuchchi Woddike Goottaa! Seeri atik yo'oshsha addateme'eeken;</para>
  <para style="q2" vid="PSA 93:5">galmi atikinna duuchchi woddi'a biifa'neekenna woyyichchaken.<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="s1">Mageni Duuchchiinge'ni Muraake Kadeexxa</para>
  <para style="q1">Shoolgake Edi Sanbata'n Daawwitixxa Faaro <verse number="1" style="v" sid="PSA 94:1" />Ee Duuchchi Woddike Goottaa! Ati halo fuldatoke Magenon; tennexxee mufe atixxa insa'ne'n bidhdhi.<verse eid="PSA 94:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2" />Butta duuchcha'n murtatok ateten; tennexxee ke'i; hollameeyye huje insa'nexxishshan xixi.<verse eid="PSA 94:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3" />Fuggaaleeyye haani qico'n ifi saadda'ni hexxa?</para>
  <para style="q2" vid="PSA 94:3">Ee Duuchchi Woddike Goottaa! Isi haani qico'nita ifi saadda'ni hexxa?<verse eid="PSA 94:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4" />Haani qico'ni fuggaaleeyye ifi saadda'ni holla calla haassota'n hexxa?<verse eid="PSA 94:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5" />Ee Duuchchi Woddike Gootta!</para>
  <para style="q2" vid="PSA 94:5">Arda atika bogii'n fulchineen; atika manna miinceen.<verse eid="PSA 94:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6" />Aro'i reyeexxa mellaalenna</para>
  <para style="q2" vid="PSA 94:6">anna ama affebaaxxa oose shinneen;</para>
  <para style="q2" vid="PSA 94:6">keessummumma boga no'oke'n offo'le manna birreen. <verse eid="PSA 94:6" /><verse number="7" style="v" sid="PSA 94:7" />Insa'nenna, «Duuchchi Woddik Gootti no'oo afabaan;</para>
  <para style="q2" vid="PSA 94:7">Ya'iqoobik Mageni uudabaan» hinaan.<verse eid="PSA 94:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8" />Ardi giddii'n ha'no hawwawwi manni qaabbatte; ha'no gowwi manni ege'na alfitinaak haanote?<verse eid="PSA 94:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9" />Mansha dadeek Mageni hitta laqa gophata?</para>
  <para style="q2" vid="PSA 94:9">Ille dadeek Magenita hitta afa gopha?<verse eid="PSA 94:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10" />Gosa gosaka arda daabataak hitta xixa gopha?</para>
  <para style="q2" vid="PSA 94:10">Manjiinxa sanne duuchcha barachchiisakita ege'na afabaa?<verse eid="PSA 94:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11" />Duuchchi Woddik Gootti manjink yaadi</para>
  <para style="q2" vid="PSA 94:11">woyi fulabaake kadeexxa ege'ne'een.<note caller="-" style="x"><char style="xo" closed="false">94:11 </char><char style="xt" closed="false"><ref loc="1CO 3:20">1 Qor. 3:20</ref>. </char></note><verse eid="PSA 94:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12" />Duuchchi Woddike Goottaa! Ati xixatokenna</para>
  <para style="q2" vid="PSA 94:12">seera atika barachchiissatoke manjixxa wodo!<verse eid="PSA 94:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13" />Mageni insa'nee rakkotenaa'n gatiso'a</para>
  <para style="q2" vid="PSA 94:13">fuggaaleeyyetee'e bale qote.<verse eid="PSA 94:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14" />Duuchchi Woddiki Gootti arda ifika waalabaan;</para>
  <para style="q2" vid="PSA 94:14">ifike kadeeka mannanna dedhabaan.<verse eid="PSA 94:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15" />Dhugaa haaroba murtetixxe songo'n hujjendaan;</para>
  <para style="q2" vid="PSA 94:15">dhugaate'ni galaak manninna isee eeyyaan.<verse eid="PSA 94:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16" />Ani'a baasseexxi xaqaritiyyete'n ke'aak ayyeete?</para>
  <para style="q2" vid="PSA 94:16">Ayyete ani'a fuggaaleeyyeeti moromaak?<verse eid="PSA 94:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17" />Duuchchi Woddik Gootti anee gargaara gopheele</para>
  <para style="q2" vid="PSA 94:17">iikki woddi silaan reyemmak manni hedhemmaba me'eennan.<verse eid="PSA 94:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18" />«Ibe gatene» hiyyenne wodda</para>
  <para style="q2" vid="PSA 94:18">Ee Duuchchi Woddike Gottaa! Jaalala atixxe duuchchi woddixxenni anee'e kiphphette.<verse eid="PSA 94:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19" />Rakkisaak yaadi ane'n bira sa'eexxa yanna</para>
  <para style="q2" vid="PSA 94:19">jajjabeessite'e anee gammachchiisseten.<verse eid="PSA 94:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20" />Seeri beloxxa yaane dabik seeriinxe assexxi muraakeerinni firummaa affeeteta?<verse eid="PSA 94:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21" />Insa'ne qulliyyete'n fuggoxxa mari'antaan;</para>
  <para style="q2" vid="PSA 94:21">balleessa afebaak manninna shiyyemaashsha murraan.<verse eid="PSA 94:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22" />Yaane kinni Duuchchi Woddik Gootti anke gollan;</para>
  <para style="q2" vid="PSA 94:22">Magenikinna anke dalla'an.<verse eid="PSA 94:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23" />Isi assineemmaxxe fuggoxxee'e insa'nee xixaan;</para>
  <para style="q2" vid="PSA 94:23">hunjemmaxxe cubboxxeenna insa'nee biraan;</para>
  <para style="q2" vid="PSA 94:23">Duuchchi Woddik Gootti, no'ok Mageni insa'nee kutti assaan.<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="s1">Daawwitixxa Galatiinxa Faaro</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 95:1" />Amme Duuchchi Woddika Gootta galatenfanto! Anjirallo no'oke golli'aanna illillinso.<verse eid="PSA 95:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2" />Isi edi'a shinqe'e galateenfanto; faarotinna isoo saando!<verse eid="PSA 95:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3" />Duuchchi Woddik Gootti lumoke moyanjon; wele magenuwwi hananna moyanjoken.<verse eid="PSA 95:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4" />Buttii hundik wiidduwwi anga isixxe'n hedheen; koobuwwatixxi xunguwwanna isinxen.<verse eid="PSA 95:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5" />Isi dademmaxxee abbaayya isixxen;</para>
  <para style="q2" vid="PSA 95:5">bago boganna ifixxe anganni giiseek isonden.<verse eid="PSA 95:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6" />Amme kumbu hina'ni isoo magenoofanto;</para>
  <para style="q2" vid="PSA 95:6">no'oo dademmake Duuchchii Woddike Gootti edo gulufanto.<verse eid="PSA 95:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7" />Isi Mageno no'oken; no'onna isi allala'neeke isike ardanna bobbaalsa'neeke isike gedhebon. Tennexxee Mageni techcho hiyyaxxa caqasse:<verse eid="PSA 95:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8" />Eetenne qiilla gamoje'n Meribaanna Maasaa hiyyemaaba</para>
  <para style="q2" vid="PSA 95:8">ha'nok edik annuwwi kandemmashsha godoba jabeesexxinoqqe'e;<note caller="-" style="x"><char style="xo" closed="false">95:8 </char><char style="xt" closed="false"><ref loc="HEB 3:15">Ibr. 3:15</ref>; <ref loc="HEB 4:7">4:7</ref>. </char></note><verse eid="PSA 95:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9" />Insa'ne'a assenexxa mambe'a yaanuwwa uunda'ninni he'neexxi</para>
  <para style="q2" vid="PSA 95:9">ookko anee hega uunde; anee'e qo'ninse.<note caller="-" style="x"><char style="xo" closed="false">95:9 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Fula. 17:1-7</ref>; <ref loc="NUM 20:2-13">Lak. 20:2-13</ref>. </char></note><verse eid="PSA 95:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10" />Ookkonne arda'n shoole tomme wagga duuchcha mufatenne;</para>
  <para style="q2" vid="PSA 95:10">«Insa'ne gorre'eekenna</para>
  <para style="q2" vid="PSA 95:10">ora anke'n me'a egenneeke mannabaan» hiyyenne.<verse eid="PSA 95:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11" />Mufatennexxi «Ookkone haafuura adhdhitinaashsha</para>
  <para style="q2" vid="PSA 95:11">aassannoke boga'n haranga aagginabaan» hiyye kakatenne.<note caller="-" style="x"><char style="xo" closed="false">95:11 </char><char style="xt" closed="false"><ref loc="HEB 3:7-11">Ibr. 3:7-11</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">95:11 </char><char style="xt" closed="false"><ref loc="NUM 14:20-23">Lak. 14:20-23</ref>; <ref loc="DEU 1:34-36">Lan. 1:34-36</ref>; <ref loc="DEU 12:9-10">12:9-10</ref>; <ref loc="HEB 4:3-5">Ibr. 4:3-5</ref>. </char></note><verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="s1">Mageni Duuchchiingike Moyanjo Kadeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 96:1" />Duuchchi Woddike Gootti'a haaroxxa faaro farse;</para>
  <para style="q2" vid="PSA 96:1">buttate'n hexxineek ardi duuchchi, Duuchchi woddika Gootta faarot faarse.<verse eid="PSA 96:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2" />Duuchchi Woddike Gootta faarse; isonna galateeffatte!</para>
  <para style="q2" vid="PSA 96:2">Isixxe anjiralummaxxa eloxxa oddonna hashshe soodaashshanni lasse.<verse eid="PSA 96:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3" />Gosa gosake arda'n luminne isika ege'nishshe; arda duuchcha'ninna isixxa mambe'iinxa huje haasso'we.<verse eid="PSA 96:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4" />Duuchchi Woddik Gootti lumoken; lumoxxi saadinnonna uwwendaaken; wele magenuwwanaa'n caala sodaatemeeken.<verse eid="PSA 96:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5" />Wele gosa gosak ardi magenoofata'neek magenuwwi fakkuwwaten; Duuchchi Woddik Gootti kinni iimuwwa dade'eeken.<verse eid="PSA 96:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6" />Qarqari isik ulfinnakenna gaachchanaken; hunnatinna danchumma galma isik giddo hexxeen.<verse eid="PSA 96:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7" />Buttate'n hexxineke gosa gosake arda duuchchaa!</para>
  <para style="q2" vid="PSA 96:7">Isike ulifinnixxeenna hunnaxxee'e Duuchchi Woddika Gootta saadde.<verse eid="PSA 96:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8" />Isike ulfichchi summi'a kadaaka galata Duuchchi Woddike Gootti'a shiqishshe; uwwatanna aaxxineexxi</para>
  <para style="q2" vid="PSA 96:8">isike galmixxe baxxebaa'a amme.<verse eid="PSA 96:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9" />Woyyome'e gaachchanna afe'eeke Duuchchi Woddike Gootti'a kumbu hiyye;</para>
  <para style="q2" vid="PSA 96:9">butta duuchchik ardinna isi'a culphisowwaal.<verse eid="PSA 96:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10" />Gosa gosake arda'n «Duuchchi Woddiki Gootti moyanjoken» hiyye!</para>
  <para style="q2" vid="PSA 96:10">Butta jabeessende kaasenddemmaxxee le'mitabaan; isi arda duuchcha'n dhugaati muraan.<verse eid="PSA 96:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11" />Iimatinna butta gammaddowwaal! Abbaayyatinna ise giddo hedheechchi duuchchi illillisowwaal!<verse eid="PSA 96:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12" />Fichchikinna giddo hedheek hiddichchuwwi duuchchi gammadowwaal!</para>
  <para style="q2" vid="PSA 96:12">Ookkone wodda gongomi giddixxi haqqe duuchcha gammadee faarsitaan.<verse eid="PSA 96:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13" />Isi buttate'n muro'a dagaan; isi buttate'n qullumati, arduwwa duuchcha'ninna dhugaati muraan.<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="s1">Mageni Duchchiing Iimi darren</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 97:1" />Duuchchi Woddiki Gootti moyanjoken; butta gammaddowwaal; ha'no abbaayyatixxi giddichchuwwa duuchcha illillisse.<verse eid="PSA 97:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2" />Xilledhe'e raachcho'eek duumanchi isoo buqe'een; isi qullummatinna dhugaati moyaan.<verse eid="PSA 97:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3" />Giira isi edo me'itaan; qarqara isike'n hedhemmaka naaphanna gubbaan.<verse eid="PSA 97:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4" />Balaqi isik buttate'n ifise; buttatinna isoo uudeexxi culphisse.<verse eid="PSA 97:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5" />Duuchchi Woddike Gootti edo</para>
  <para style="q2" vid="PSA 97:5">butta duuchcha gagatishsha baqqe.,<verse eid="PSA 97:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6" />Iimmuwwa isixxa qullumma leellishshaan; gosa gosak ardi duuchchinna gaachchanna isika uudaan.<verse eid="PSA 97:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7" />Fakkuwwagtee kumbu hiyyaakiirinna ise'ni ifi saadaakiir duuchchi salphataan;</para>
  <para style="q2" vid="PSA 97:7">ha'no dharchuwwi mageni Duuchchi Woddike Gootti'a kumbu hiyye.<verse eid="PSA 97:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8" />Ee Duuchchi Woddike Gottaa! Atixxe toggitte murtexxee Tsiyoonik ardi gammadowwaal;</para>
  <para style="q2" vid="PSA 97:8">Yihudak qachchuwwinna illillisaan.<verse eid="PSA 97:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9" />Ee Dada Duuchchike Duuchchi Woddike Goottaa! Ati butta duuchchike Magenon;</para>
  <para style="q2" vid="PSA 97:9">dharchuwwi magenuwwinna mootumma atixxi hunda hedheen.<note caller="-" style="x"><char style="xo" closed="false">97:9 </char><char style="xt" closed="false"><ref loc="PSA 29:1-2">Far. 29:1-2</ref>. </char></note><verse eid="PSA 97:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10" />Duuchchi Woddik Gootti fuggoxxa yaane gibaake manna eeyyaan;</para>
  <para style="q2" vid="PSA 97:10">qulliyyetixxa lubbonna heqqa'n insa'nee fuggaleeyyetixxe anganaa'ninna gatisaan.<verse eid="PSA 97:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11" />Ifii'i qulliyyetee'e gammadikinna ba'lake manna'n dage.<verse eid="PSA 97:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12" />Duuchchi Woddik Gootti asseexxe yaanexxee'e</para>
  <para style="q2" vid="PSA 97:12">qulliyye duuchcha gammade; woyyichcha isika summanna saadde!<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="s1">Mageni Buttatike Galchallon</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 98:1" />Assemmaxxe manmbe'a yaanuwwaxxeenna jabbaxxe ifixxe hunnanni injifatemmaxxee'e Duuchchi Woddike Gootti'a haaroxxa faaro farse.<verse eid="PSA 98:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2" />Duuchchi Woddik Gootti ifixxi anjiralumma ege'nendaashsha asse;</para>
  <para style="q2" vid="PSA 98:2">qullumma ifixxanna gosa gosake arda'n leellishe.<verse eid="PSA 98:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3" />Isi Isira'eelike ardi'a afe'eexxa jaalalanna xuurameessumma dedhebaan; bogi bogik ardi duuchchi Mageni no'ok hitta injifate'eexxa uude'een.<verse eid="PSA 98:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4" />Buttate'n hexxineek ardi duuchchi Duuchchi Woddike Gootta gammashshoti faarse; faarotinna illilleeteti isoo galateeffatte.<verse eid="PSA 98:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5" />Bagank faarsitina'n Duuchchi Woddika Gootta galateffatte.<verse eid="PSA 98:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6" />Moyanjo no'oke Duuchchi Woddike Gootti'a suusu'letanna malagata ufuufina'n illillisse.<verse eid="PSA 98:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7" />Abbayyatinna ise giddo hexxineexxi daduwwa duuchcha hafuura ha'noka laqisse; buttatinna ise giddo hexxineek duuchchi faaro farse.<verse eid="PSA 98:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8" />Koo galaannuwwa anga calle; Tee koobuwwa Duuchchi Woddike Gootti edo illillisina'n mitteba faarse.<verse eid="PSA 98:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9" />Duuchchi Woddik Gootti buttate'ni muro'a dagammaxxee isi edo faaro faarsinowwaal; buttatike arda'ninna isi qullummati toggitte murte muraan.<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="s1">Mageni Lumoke Moyanjon</para>
  <para style="q1">Daawwitixxa Faaro.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 99:1" />Duuchchi Woddik Gootti moyedheen; ardi culiphisuun; kuruubeeli hiyyendaaxxe daaduwwa hana hexxeexxe ifixxe moote'n ofo'le'een; butta le'mituun.<note caller="-" style="x"><char style="xo" closed="false">99:1 </char><char style="xt" closed="false"><ref loc="EXO 25:22">Fula. 25:22</ref>. </char></note><verse eid="PSA 99:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2" />Duuchchi Woddik Gootti Tsiyooni'n lumoken; gosa gosake arda duuchcha'ninna xungote'ni hedheeken.<verse eid="PSA 99:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3" />Lumedhe'eekanna gaachchanna afeeka atika summa saandowwaal; qullichchi isoten.<verse eid="PSA 99:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4" />Dhugaa eetattokee lumoke moyanjoo! Ati seera uggite'eeten; dhugaatanna qullumma Isira'eeli giddo hujje'eeten.<verse eid="PSA 99:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5" />Duuchchi Woddika Gootta no'oka Mageno saadde! Mootte isixxi hundanna isi'a kumbu hiyye; isi woyyichchaken.<verse eid="PSA 99:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6" />Muusenna Aarooni isixxe qeessemman; Saamu'eelinna isoo'o soodateemmake mannanaa'ni mittekemman; insa'nenna Duuchchi Woddika Gootta ye'ne; isinna hiissichcho insa'ne'a uwwe.<verse eid="PSA 99:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7" />Duumanchiink utuphi giddo hedheexxi insa'ne'n haaso'e; insa'nenna uggemmaka seeranna uwwemmaka ajaja muunxe.<note caller="-" style="x"><char style="xo" closed="false">99:7 </char><char style="xt" closed="false"><ref loc="EXO 33:9">Fula. 33:9</ref>. </char></note><verse eid="PSA 99:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8" />Ee, Duuchchi Woddike Gootta no'oke Magenoo! Ati soodachcho insa'neexxa laqqette; insa'ne'anna araarendeteke Magenon; Yaane kinni assinemmaxxe balleessaxxee insa'nee mura woxisa waldebexxo.<verse eid="PSA 99:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9" />Duuchchi Woddik Gootti no'ok Mageni woyyichchake kadeemmaxxee</para>
  <para style="q2" vid="PSA 99:9">isoo saadde;</para>
  <para style="q2" vid="PSA 99:9">woyyitte isixxi kooba hananna isi'a sagadde.<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s1">Mageno Galateefatatee'e Shiqeeka Ye'injo</para>
  <para style="d">Glatiinxa Faaroo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1" />Buttate'n hexxineek arduwwi</para>
  <para style="q2" vid="PSA 100:1">duuchchi Duuchchi Woddike Gootti'a illillisse.<verse eid="PSA 100:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2" />Duuchchi Woddika Gootta gammashshoti ergatemme;</para>
  <para style="q2" vid="PSA 100:2">gammashshotixxa faaro faarsitina'n isi edo shiqqe.<verse eid="PSA 100:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3" />Duuchchi Woddik Gootti Magenoke kadeexxa ege'ne;</para>
  <para style="q2" vid="PSA 100:3">no'oo isote dadeen; no'onna isiken;</para>
  <para style="q2" vid="PSA 100:3">tennexxee no'oo gedhebiinsha allala'neeke arda isiken.<verse eid="PSA 100:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4" />Galateeffatina'ni isike galmixxa hula e'ye;</para>
  <para style="q2" vid="PSA 100:4">saaddina'ni isixxe baxxebaa me'we;</para>
  <para style="q2" vid="PSA 100:4">galata isi'a uutina'n summa isikanna saadde.<verse eid="PSA 100:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5" />Duuchchi Woddik Gootti eloken;</para>
  <para style="q2" vid="PSA 100:5">jaalala isixxinna xuurameessumma isixxi duuchchi woddixxen.<note caller="-" style="x"><char style="xo" closed="false">100:5 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 Odo. 16:34</ref>; <ref loc="2CH 5:13">2 Odo. 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Izr. 3:11</ref>; <ref loc="PSA 106:1">Far. 106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Erm. 33:11</ref>. </char></note><verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="s1">Moyanji Magenokee Aagaaxxa Kako</para>
  <para style="d">Daawwitixxa Faaroo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1" />Ee Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 101:1">Atixxe xuurameessemmaxxeenna toggitte murtexxee faaro farsa'eennen.<verse eid="PSA 101:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2" />Komatendabaaxxa hedho hedhannoni</para>
  <para style="q2" vid="PSA 101:2">ati anibaa daggatoki haanote?</para>
  <para style="q2" vid="PSA 101:2">Anike mini hadinni qullite hedhoni hedhannon.<verse eid="PSA 101:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3" />Ani hedheneba fuggoxxa assinaa'naa sammi hiyyabe'non;</para>
  <para style="q2" vid="PSA 101:3">Magenokenaa'ni bayyateeki manni assaaxxa duuchcha gibanno;</para>
  <para style="q2" vid="PSA 101:3">insa'nenninna mittoomabe'non.<verse eid="PSA 101:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4" />Fuaggaleesi manni anenaa'ni bayatowwaal;</para>
  <para style="q2" vid="PSA 101:4">fugoxxenni welti firooma afebe'non.<verse eid="PSA 101:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5" />Hashashati manna hamataaka manjjo sammi assannon;</para>
  <para style="q2" vid="PSA 101:5">hollaameeyyenna caqaaleeyye mana ca'li hiyye udabe'no.<verse eid="PSA 101:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6" />Magenokee xuurameessake kadeeke mana'ni'i godobi ank hedhen;</para>
  <para style="q2" vid="PSA 101:6">insa'nenna anike mine'n he'na'ni ani'a ergateemmaan.<verse eid="PSA 101:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7" />Lame afo'iki manni anke mine'n hedhabaan;</para>
  <para style="q2" vid="PSA 101:7">dhara haso'aakiir ille anxi edo hedhabaan.<verse eid="PSA 101:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8" />Bara bara'ni anke boga'ni hexxeexxa fuggaaleeyye biranoni;</para>
  <para style="q2" vid="PSA 101:8">Duuchchi Woddike Goottike qachchi giddii'ninna jalliyye duuchcha balleessannon.<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="s1">Rakote'ni Hedheeke Manjixxa Soodachcho</para>
  <para style="d">Yaadeexxa yannanna Soodachcho Ifixxa Duuchchi Woddike Gootti Edo Shiqiseexxa Yanna Rakkichchi Manjixxa Soodachcho</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1" />Ee Duuchchi Woddike Goottaa, soodachcho anxa laqi;</para>
  <para style="q2" vid="PSA 102:1">oodhishsha anxanna caqasse'e anee gargaar!<verse eid="PSA 102:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2" />Rakko ane'ni geltaaxxa yanna dudduro ane'ni wirri hitoxxe'e;</para>
  <para style="q2" vid="PSA 102:2">soodachcho anxanna laqi; ye'edhanno wodda rakketexxi heeyyi.<verse eid="PSA 102:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3" />Anxe hedhoki bari wiliilletishsha sa'e muda'nee'n;</para>
  <para style="q2" vid="PSA 102:3">bisi ankinna boosixxe giirashsha holateen.<verse eid="PSA 102:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4" />Bagoxxe badda'ashsha butute bullo'enne;</para>
  <para style="q1" vid="PSA 102:4">Itatanna anee boshshe.<verse eid="PSA 102:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5" />Hafuura gikki asse'e aadatenaa'n kexxeexxa,</para>
  <para style="q2" vid="PSA 102:5">maali mudee'naa miccoke kade gatenne.<verse eid="PSA 102:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6" />Qofinni qiilla gamoojje giddo hexxammaxxe ci'ashshanna</para>
  <para style="q2" vid="PSA 102:6">ona mine'ni hexxammaxxe urungo kadennen.<verse eid="PSA 102:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7" />Diiphi ille anxe'ni haranga wileba'a;</para>
  <para style="q2" vid="PSA 102:7">anke minixxe guutto hana hexxammaxxe qofi galeete ciichchoshsha kadennen.<verse eid="PSA 102:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8" />Hashsha barra naaphi anki afo'o ane'ni fulchedhe;</para>
  <para style="q2" vid="PSA 102:8">wele manna yowwateenna anka summa la'oofante.<verse eid="PSA 102:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9" />Bululii ani'a itate kade;</para>
  <para style="q2" vid="PSA 102:9">ha'wannochcho'n indiddo anixxinna coccobbe.<verse eid="PSA 102:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10" />Tinninna kaddeechchi ati anee qophphi assite kexxe'e</para>
  <para style="q2" vid="PSA 102:10">mufeti takki asssitetaxxeeten.<verse eid="PSA 102:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11" />Bari ank haru'mita'n me'itammaxxe galgalixxe gaaddiddoshshaten;</para>
  <para style="q2" vid="PSA 102:11">aninna badda'atishsha qoorannon.<verse eid="PSA 102:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12" />Ee Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 102:12">Ati kinni duuchchi woddi'a moota'n hexxattoken;</para>
  <para style="q2" vid="PSA 102:12">gurri atikinna ilatenaa'ni ilati qico'n quba sa'a'n me'aan.<verse eid="PSA 102:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13" />Tsiyooni'a godoba shaqqitattoxxi yanna shiqqemmaxxeenna</para>
  <para style="q2" vid="PSA 102:13">iitti yanna ta'ate kaddeemmaxxee</para>
  <para style="q2" vid="PSA 102:13">ati kexxetexxi ise'anna marartatton.<verse eid="PSA 102:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14" />Atika erganjuwwaara isexxi kino eeyyisaan;</para>
  <para style="q2" vid="PSA 102:14">diigendeexxe isexxe ole'anna midde marrarraan.<verse eid="PSA 102:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15" />Gosa gosak ardi Duuchchi Woddike Goottika summa,</para>
  <para style="q2" vid="PSA 102:15">buttatiki moyanjuwwi duchchinna isixxa hunna sodaataan.<verse eid="PSA 102:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16" />Duuchchi Woddik Gootti Tsiyooni haaroba ijaaraaxxa yanna</para>
  <para style="q2" vid="PSA 102:16">ifike luminninni ardake'n leellaan.<verse eid="PSA 102:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17" />Rakkiyyetixxa soodachcho laqa laqaan;</para>
  <para style="q2" vid="PSA 102:17">kadha insa'neexxanna tuffatabaani.<verse eid="PSA 102:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18" />Edi'a ilemmaaki manninna Duuchchi Woddika Gootta galateeffataashsha,</para>
  <para style="q2" vid="PSA 102:18">isi asseexxa tennee mambe'a yanne daggaaxxe ila'a borreesse<verse eid="PSA 102:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19" />Duuchchi Woddik Gootti ifixxe iimixxe woyyitte bakka'ni hedheexxi</para>
  <para style="q2" vid="PSA 102:19">iimi'ni butti'a uude.<verse eid="PSA 102:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20" />Tenneenna asseechchi usuremeemmake mannixxa oodhishsha laqeexxi</para>
  <para style="q2" vid="PSA 102:20">reyo itti murendeemmakaaranna wocci assaashshaten.<verse eid="PSA 102:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21" />Tennexxee Tsiyooni giddo Duuchchi Woddike Goottik summi saademaan;</para>
  <para style="q2" vid="PSA 102:21">Iyyerusaalemi giddonna galateefatemaan.<verse eid="PSA 102:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22" />Tinninna kadaaki gosa gosaki arduwwinna mootummuwwa</para>
  <para style="q2" vid="PSA 102:22">mitteba bukki hiteexxi Duuchchi Woddika Gootta magenoonfataa woddan.<verse eid="PSA 102:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23" />Dargageesummande'ni hedhee'naa Duuchchi Woddik Gootti huna anxa enqe;<note caller="+" style="f"><char style="fr" closed="false">102:23 </char><char style="ft" closed="false">yookaan</char><char style="fqa" closed="false">Hunna ifixxenni hunna anxa enqe</char></note></para>
  <para style="q2" vid="PSA 102:23">hedho anxanna harunse.<verse eid="PSA 102:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24" />«Ee anke Magenoo! Bari atik ilatenaa'ni ilate'ni sa'aake kadeemmaxxee</para>
  <para style="q1" vid="PSA 102:24">Baro anka muxebe'nok</para>
  <para style="q2" vid="PSA 102:24">anke barike gamisa'n anee adhdhittoxxe'e.<verse eid="PSA 102:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25" />Ati olma butta dadeten;</para>
  <para style="q2" vid="PSA 102:25">immuwwatinna atixxe angaxxe hujen.<verse eid="PSA 102:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26" />Iimatinna butta baxxaan; atik kinni hexxatto;</para>
  <para style="q2" vid="PSA 102:26">kunnichchi duuchchi seemmatishshanna mudaan;</para>
  <para style="q2" vid="PSA 102:26">konnechchuwwanna oddoonotishsha jijjiiritee'naa gopheemaan.<verse eid="PSA 102:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27" />Ati kinni duchchi wodda atenden;</para>
  <para style="q2" vid="PSA 102:27">bari Atikinna haranga mudaakebaan.<note caller="-" style="x"><char style="xo" closed="false">102:27 </char><char style="xt" closed="false"><ref loc="HEB 1:10-12">Ibr. 1:10-12</ref>. </char></note><verse eid="PSA 102:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28" />Atike erganjuwwixxi oose nage'ik hexxaan;</para>
  <para style="q2" vid="PSA 102:28">ila ila insa'neexxinna atixxe heqqanni le'mitebaangi hexxaan.»<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="s1">Mageniinxa Jaalala</para>
  <para style="d">Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1" />Anxe lubboo! Duuchchi Woddika Gootta galateefat!</para>
  <para style="q2" vid="PSA 103:1">anxi giddixxi hedho duuchchanna isika woyyichcha summa galateefat;<verse eid="PSA 103:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2" />Anxe lubboo, Duuchchi Woddika Gootta galateefat;</para>
  <para style="q2" vid="PSA 103:2">isixxa arijummanna deetoxxe'e;<verse eid="PSA 103:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3" />Cubbo atixxa duuchcha gattowwaal hiyyaak,</para>
  <para style="q2" vid="PSA 103:3">ela gonphe atixxanna fayyisaak,<verse eid="PSA 103:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4" />reyotenaa'n atee gatisaak,</para>
  <para style="q2" vid="PSA 103:4">atee eeyyatinna ati'a arijoomat eloxxa yaane ati'a assaak,<verse eid="PSA 103:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5" />atixxi ka'imummanna sinbiriinsha muuxxato'a</para>
  <para style="q2" vid="PSA 103:5">halcha atixxa elollamma yaannenni goddisaak isoten.<verse eid="PSA 103:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6" />Duuchchi Woddik Gootti assaaxxe duuchcha'n qullichchaken;</para>
  <para style="q2" vid="PSA 103:6">miicemeeke mani'a dhugaate muraan.<verse eid="PSA 103:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7" />Assaaxxa duuchcha Muuse'ni kule;</para>
  <para style="q2" vid="PSA 103:7">Asseexxa mambe'iinxa yaanuwwanna Isira'eelik ardi uudaashsha asse.<verse eid="PSA 103:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8" />Duuchchi Woddik Gootti ba'lakenna gattowwaaliken;</para>
  <para style="q2" vid="PSA 103:8">mufe dande'aake, jaalalatinna bira saxxe'eeken.<note caller="-" style="x"><char style="xo" closed="false">103:8 </char><char style="xt" closed="false"><ref loc="JAS 5:11">Ya'i. 5:11</ref>. </char></note><verse eid="PSA 103:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9" />Isi duuchchi wodda manjo xixa'n hedhabaan;</para>
  <para style="q2" vid="PSA 103:9">mufateeshshanna duuchchi woddi'a gatabaan;<verse eid="PSA 103:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10" />Hunjennexxe cubboxxe qixxe'ni no'o'ni mureba'an;</para>
  <para style="q2" vid="PSA 103:10">no'oxxe balleessashshanna halo no'o'ni fuleba'an.<verse eid="PSA 103:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11" />Iima buttatenaa'ni bayyataa qici lumoke kademmashshanni,</para>
  <para style="q2" vid="PSA 103:11">iittanni Mageni isoo magenoofataakaara eeyya qici lumoken.<verse eid="PSA 103:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12" />Arisho fuldammabi aggammabaa'ni bayyatamma qicishsha,</para>
  <para style="q2" vid="PSA 103:12">Mageni noxxa cubbo eettene qixxe'n no'onaa'ni bayyise.<verse eid="PSA 103:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13" />Oose ifixxee anni godoba ba'latamma qicishsha</para>
  <para style="q2" vid="PSA 103:13">Duuchchi Woddik Goottinna isoo magnoofataakeeri'a ba'lataan.<verse eid="PSA 103:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14" />Duuchchi Woddik Gootti no'oo maayenaa'ni daddemmennexxa ege'nedheen;</para>
  <para style="q2" vid="PSA 103:14">no'oxxi buttinake kadanna iso'n barraten.<verse eid="PSA 103:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15" />Manjiinxi hedhoqa bada'atishshate;</para>
  <para style="q2" vid="PSA 103:15">nophpheexxi daraarammake badda'atike daraarishshate;<verse eid="PSA 103:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16" />Iikki daraari diddallo iso'n gandaa wodda iikki woddi ba'aan;</para>
  <para style="q2" vid="PSA 103:16">hedhemmaxxi bakka midde ege'nendaba'a.<verse eid="PSA 103:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17" />Duuchchi Woddike Goottixxi jaalala kinni</para>
  <para style="q2" vid="PSA 103:17">duuchchi woddinaa'n duuchchii woddi'a isoo Magenoofataakeera'niten;</para>
  <para style="q2" vid="PSA 103:17">qullumma sixxinna insa'nexxe oosexxe oose'n hexxaan;<verse eid="PSA 103:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18" />Tenneenna assaak</para>
  <para style="q2" vid="PSA 103:18">isixxa kako heqqedhaakeera'ninna</para>
  <para style="q2" vid="PSA 103:18">isika ajaajanna muuxo'a xonxoommataakeera'niten.<verse eid="PSA 103:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19" />Duuchchi Woddik Gootti ifixxa moote iimate'n qophpheese'een;</para>
  <para style="q2" vid="PSA 103:19">mootumma isixxinna duuchchiinge'niten.<verse eid="PSA 103:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20" />Ha'noo isike hiyyichchi'a ajajendina'neexxi, isi hiyyaaxxanna laqqina'neexxi,</para>
  <para style="q2" vid="PSA 103:20">ha'noo hunnaameeyye erganna</para>
  <para style="q2" vid="PSA 103:20">Duuchchi Woddika Gootta saadde.<verse eid="PSA 103:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21" />Ha'noo fedhii isixxa muuxina'neeki</para>
  <para style="q2" vid="PSA 103:21">isik iimik sannachchuwwi duuchchi, Duuchchi Woddika Gootta saadde.<verse eid="PSA 103:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22" />Ha'no isixxe galcha giddo hexxineexxi isixxi dada duuchcha</para>
  <para style="q2" vid="PSA 103:22">Duuchchi Woddika Gootta saadde.</para>
  <para style="b" vid="PSA 103:22" />
  <para style="q1" vid="PSA 103:22">Tee anxe lubboo! Duuchchi Woddika Gootta saadi.<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="s1">Dadatike Mageni'a Shiqeeka Galata</para>
  <para style="s2">Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1" />Tee anxe lubboo! Duuchchi Woddika Gootta saadi!</para>
  <para style="q2" vid="PSA 104:1">Ee Duuchchi Woddike Gootta anke Magenoo!</para>
  <para style="q2" vid="PSA 104:1">Ati hara lumoken!</para>
  <para style="q2" vid="PSA 104:1">gaachchannakanna ulfinna oddo'wite'eeten.<verse eid="PSA 104:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2" />Ifakanna seemmuffa oddo'wite'eeten;</para>
  <para style="q2" vid="PSA 104:2">iimatanna duunkaaniinsha dhisse'eeten.<verse eid="PSA 104:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3" />Dhisendeexxe iima'n hedheeke wodi'i iimi darre mine ifi'a ijaadhiteeten;</para>
  <para style="q1" vid="PSA 104:3">Duumancha ifike sarageella assexxete;</para>
  <para style="q2" vid="PSA 104:3">diidallotike keelinninna me'ittatton;<verse eid="PSA 104:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4" />Diidaallo atixxe erganjon;</para>
  <para style="q2" vid="PSA 104:4">giiratik bubeninna ati'anni ergatemaan.<note caller="-" style="x"><char style="xo" closed="false">104:4 </char><char style="xt" closed="false"><ref loc="HEB 1:7">Ibr. 1:7</ref>. </char></note><verse eid="PSA 104:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5" />Butta isexxe booso'n jabeessite ofo'lishshette;</para>
  <para style="q2" vid="PSA 104:5">haranganna munnuqqi hitabaan.<verse eid="PSA 104:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6" />Lumoxxa abaayya seemmatishsha iti oddeesitete;</para>
  <para style="q2" vid="PSA 104:6">wodi'ikinna koobuwwa buqe.<verse eid="PSA 104:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7" />Wode'e xixxatale ati edi'ni baaje;</para>
  <para style="q2" vid="PSA 104:7">atixxe dindinsoka luuljonna laqeexxi hurru hiyye gonge.<verse eid="PSA 104:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8" />Ati isi'a qopheesitetexxe bakkabaa</para>
  <para style="q2" vid="PSA 104:8">kobuwati hananna dhoquwwa giddi'a yaa'e.<verse eid="PSA 104:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9" />Ileema higeexxi butta buqabaashsha,</para>
  <para style="q2" vid="PSA 104:9">qaxxamure sa'abaashshanna gabaldete.<verse eid="PSA 104:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10" />Muumuwwa dhooquwwa giddi'a yaataashsha,</para>
  <para style="q2" vid="PSA 104:10">galaanuwwikinna koobuwwatixxe oddonaa'ni sa'ani me'aashsha assittete.<verse eid="PSA 104:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11" />Konne qicinni biniinchi wode'e ha'wo'a qixxeessittete;</para>
  <para style="q2" vid="PSA 104:11">diidiinxi harrenna ha'witeexxi dhebo fuldaan.<verse eid="PSA 104:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12" />Tenne muummuwwa hananna galaanuwwi qarqara hexxeexe haqquwwa hana</para>
  <para style="q2" vid="PSA 104:12">mine ijaadhite'e ci'a woccaan.<verse eid="PSA 104:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13" />Iimi'ni koobuwwate'ni xeena wocci assittaton;</para>
  <para style="q2" vid="PSA 104:13">buttatinna atixxe hujexxa gumma badhaataan.<verse eid="PSA 104:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14" />Horekee'e anso lattissatto;</para>
  <para style="q2" vid="PSA 104:14">hiddichchuwwikinna manjokee'e la'o uwwashsha assittato;</para>
  <para style="q2" vid="PSA 104:14">konne qicinni manji itatee kadaachcho wiisse aassedha.<verse eid="PSA 104:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15" />Tennexxee isoo gammachchiisaaxxa woyinetixxa booka</para>
  <para style="q2" vid="PSA 104:15">alba cululussitaaxxa zayitenna</para>
  <para style="q2" vid="PSA 104:15">hunna lebbaaxxa ita qophpheesedhaan.<verse eid="PSA 104:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16" />Duuchchi Woddik Goottik haqichchuwwi</para>
  <para style="q2" vid="PSA 104:16">isi kaaseeki Libaanoosik birbirsuwwi geyaaka xeena alfaan.<verse eid="PSA 104:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17" />Ookkone haqichchuwwi hana ci'a mine ijaadhitaan;</para>
  <para style="q2" vid="PSA 104:17">huummuwwatinna eettene haqquwwa hana galdaba gissexxaan.<verse eid="PSA 104:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18" />Gadansuwwi lumolla koobuwwa'ni afemaan.</para>
  <para style="q2" vid="PSA 104:18">Ossoluwwatinna kinotike holli giddo hexxaan.<verse eid="PSA 104:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19" />Baate mitte mitte agenjike ke'iti'a beessisake kaddaashsha daddete;</para>
  <para style="q2" vid="PSA 104:19">arishshonna aaggaxxa yanna egendaashsha assittete.<verse eid="PSA 104:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20" />Dukkana daddette; bogikinna hashsha;</para>
  <para style="q2" vid="PSA 104:20">dukkana giddo biniinchi duchchi badda'atenaa'ni yaa'a.<verse eid="PSA 104:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21" />Mageni qophpheesseexxa ita addaandaa wodda</para>
  <para style="q2" vid="PSA 104:21">neniqiinxi beltana ittanda.<verse eid="PSA 104:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22" />Arishsho fuldaa wodda</para>
  <para style="q2" vid="PSA 104:22">illeema higge'e me'iteexxi galdammaba diiphpha.<verse eid="PSA 104:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23" />Ookkoneechchi uduma manji hujete'ni bobba'a;</para>
  <para style="q2" vid="PSA 104:23">hashshaa qico'ninna hucca'n hosa.<verse eid="PSA 104:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24" />Ee Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 104:24">Ati heddochcho daddeeten;</para>
  <para style="q2" vid="PSA 104:24">duuchchingechcho beekkuma atikenni daddeeten;</para>
  <para style="q2" vid="PSA 104:24">atixxi dada buttate'n wo'maten.<verse eid="PSA 104:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25" />Laakkossi dandeesisabaaxxi lumollammanna shiixxarramma lubboxxi dada</para>
  <para style="q2" vid="PSA 104:25">giddo hexxa'neexxe tenne ba'laxxenna lumoxxe abbaayya<verse eid="PSA 104:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26" />hana markabuwwi me'aan;</para>
  <para style="q2" vid="PSA 104:26">ati daddetek lewataan hiyyemaak</para>
  <para style="q2" vid="PSA 104:26">lumok naachchinna isen giddo geebaan.<note caller="-" style="x"><char style="xo" closed="false">104:26 </char><char style="xt" closed="false"><ref loc="JOB 41:1">Iyo. 41:1</ref>; <ref loc="PSA 74:14">Far. 74:14</ref>; <ref loc="ISA 27:1">Isa. 27:1</ref>. </char></note><verse eid="PSA 104:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27" />Kunnichchuwwi duuchchi hasaaxxe yanna'n</para>
  <para style="q2" vid="PSA 104:27">itaachcho isi'a qophpheessittota'a addata'neek atenden.<verse eid="PSA 104:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28" />Ita konneechchuwwi'a uuttato wodda kunnichchuwwi itaan;</para>
  <para style="q2" vid="PSA 104:28">atixxa anganna qeersatto wodda</para>
  <para style="q2" vid="PSA 104:28">kunnichchuwwi elolla yaane ite goddaan.<verse eid="PSA 104:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29" />Dudduro konnechchuwwa'n wirri hittato wodda duuchchiingechchi alayyaan;</para>
  <para style="q2" vid="PSA 104:29">uuteetaka hafuuranna konneechchuwwinaa'n adhdhittato woddanna reyeexi</para>
  <para style="q2" vid="PSA 104:29">dademeemmange buttina'n higaan.<verse eid="PSA 104:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30" />Hafuura atika hiisite'e uuttato wodda kinni</para>
  <para style="q2" vid="PSA 104:30">kunnichchuwwi dademaan;</para>
  <para style="q2" vid="PSA 104:30">buttatinna haaroxxa hedho hexxaashsha assittato.<verse eid="PSA 104:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31" />Duuchchi Woddike Goottik gaachchanni duuchchi wodi'a hedhowwaal!</para>
  <para style="q2" vid="PSA 104:31">Duuchchi Woddik Gootti dadeexxe dada duuchcha'ni gammadowwaal.<verse eid="PSA 104:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32" />Isi butta uudaa wodda lele'mitaan;</para>
  <para style="q2" vid="PSA 104:32">koobuwwatanna kisaa wodda wiliildaan.<verse eid="PSA 104:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33" />Anke baro duuchcha'n Duuchchi Woddike Gotta faarsaannon;</para>
  <para style="q2" vid="PSA 104:33">hedhoti hedhenne qico'n</para>
  <para style="q2" vid="PSA 104:33">Mageno anka galatik saadannon.<verse eid="PSA 104:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34" />Gammashsho ani'a uwweek isote kademmaxxee'e</para>
  <para style="q2" vid="PSA 104:34">yaadi ankinna isoo gammachchiisowwaal.<verse eid="PSA 104:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35" />Cubbaleeyye buttatenaa'n baxxowwaal;</para>
  <para style="q2" vid="PSA 104:35">fuggoxxa hujaakiirinna kutti hiyyowwaal.</para>
  <para style="b" vid="PSA 104:35" />
  <para style="q1" vid="PSA 104:35">Tee anxe lubboo! Duuchchi Woddika Gootta saadi!</para>
  <para style="q1" vid="PSA 104:35">Tee anxe lubboo! Duuchchi Woddika Gootta saadi!<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="s1">Magenokanna Isika Arda</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1" />Duuchchi Woddika Gootta galateeffatte;</para>
  <para style="q2" vid="PSA 105:1">isika summanna ye'we;</para>
  <para style="q2" vid="PSA 105:1">asseexxa duchchanna gosa gosake arda'ni oodeesse.<verse eid="PSA 105:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2" />Duuchchi Woddika Gootta galatik faarse;</para>
  <para style="q2" vid="PSA 105:2">asseexxa mambe'a yaane duuchchanna haasso'we.<verse eid="PSA 105:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3" />Woyyichcha Mageno'n gammadde;</para>
  <para style="q2" vid="PSA 105:3">Duuchchi Woddika Gootta magenoofataak duuchchi gammadowwaal.<verse eid="PSA 105:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4" />Duuchchi Woddika Goottanna isixxa hunna addatte;</para>
  <para style="q2" vid="PSA 105:4">duuchchi woddanna isoo Magenooffatte.<verse eid="PSA 105:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5" />Asseemmaxxa mambeiinxa hujuwwa</para>
  <para style="q2" vid="PSA 105:5">isixxa massuwwanna mureexxa murtuwwa kassi hiyye;<verse eid="PSA 105:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6" />Ha'no erganjo Abirihaamixxe hortee,</para>
  <para style="q2" vid="PSA 105:6">isi ifike umi'a fi'leexxe Ya'iqoobixxe oosee qaabbatte.<verse eid="PSA 105:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7" />Duuchchi Woddik Gootti no'oke Magenon;</para>
  <para style="q2" vid="PSA 105:7">isi butta duuchcha'n moyeedheen.<verse eid="PSA 105:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8" />Aageexxa kako yookaan asso'a addachchiiseemmaka haaso'a kuma ilensha qico'ninna kaddo'o</para>
  <para style="q2" vid="PSA 105:8">duuchchi woddi'anna dedhabaan.<verse eid="PSA 105:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9" />Abirihaami'a aageemmaxxa kakonna</para>
  <para style="q2" vid="PSA 105:9">Yisaaqi'a asso'a addachchiiseemmaka haaso'a muuxaan,<note caller="-" style="x"><char style="xo" closed="false">105:9 </char><char style="xt" closed="false"><ref loc="GEN 12:7">Dada. 12:7</ref>; <ref loc="GEN 17:8">17:8</ref>; <ref loc="GEN 28:3">28:3</ref>. </char></note><verse eid="PSA 105:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10" />Kunni Ya'iqqoobike seera kadaashsha</para>
  <para style="q2" vid="PSA 105:10">Isira'eeli'anna duuchchi woddi'a turtaaxxe kako kaddaashsha duudhe.<verse eid="PSA 105:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11" />Tinni aageexxi kakoo «Kenaanika booga ati'a uwwannon;</para>
  <para style="q2" vid="PSA 105:11">isinna atike qadaada kadaan» hitaaxxemman.<note caller="-" style="x"><char style="xo" closed="false">105:11 </char><char style="xt" closed="false"><ref loc="GEN 28:13">Dada. 28:13</ref>. </char></note><verse eid="PSA 105:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12" />Tinni kaddaa wodda Mageniink ardi laakkossik heenokemman;</para>
  <para style="q2" vid="PSA 105:12">bogakeenna keesummatemman.<verse eid="PSA 105:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13" />Insa'nenna mitte ardike bogibaa'ni weliinkibaa'a</para>
  <para style="q2" vid="PSA 105:13">mitte bogixxe mootummabaa'ni weliinxibaa'a doonsakiyya hine.<verse eid="PSA 105:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14" />Yanne kinni Mageni ayyinna insa'nee miidho'a waalebaan;</para>
  <para style="q2" vid="PSA 105:14">insa'neexxee hiyyeexxi moyanjuwwakanna xixxe.<verse eid="PSA 105:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15" />«Fi'lenneka anka erganjuwwa kissinoqqe'e;</para>
  <para style="q2" vid="PSA 105:15">anxa wabeekonna miittinoqqe'e» hiyya'n insa'nee xexe'achchiise.<note caller="-" style="x"><char style="xo" closed="false">105:15 </char><char style="xt" closed="false"><ref loc="GEN 20:3-7">Dada. 20:3-7</ref>. </char></note><verse eid="PSA 105:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16" />Duuchchi Woddik Gootti boga insa'neke'n solo'o ibise;</para>
  <para style="q2" vid="PSA 105:16">indaachcho duuchchanna balleesse.<note caller="-" style="x"><char style="xo" closed="false">105:16 </char><char style="xt" closed="false"><ref loc="GEN 41:53-57">Dada. 41:53-57</ref>. </char></note><verse eid="PSA 105:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17" />Yaane kinni insa'ne giddii'n mitte manjo ediseexxi erge;</para>
  <para style="q2" vid="PSA 105:17">iikki manjinna garbiinsha gurguremeemmake Yooseefitemman.<note caller="-" style="x"><char style="xo" closed="false">105:17 </char><char style="xt" closed="false"><ref loc="GEN 37:28">Dada. 37:28</ref>; <ref loc="GEN 45:5">45:5</ref>. </char></note><verse eid="PSA 105:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18" />Isixxi lekka lekkatike siblinni usurendeemman;</para>
  <para style="q2" vid="PSA 105:18">isike gooba'ninna sibljiinxe sageetto hexxemman.<verse eid="PSA 105:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19" />Yoosef umo ifinge'ninni ediseexxi haaso'emmaxxi yanne</para>
  <para style="q2" vid="PSA 105:19">muuxxendaa qici'anna</para>
  <para style="q2" vid="PSA 105:19">Duuchchi Woddike Goottike hiyyichchixxi dhugaalessumma isi'a kokeesendaa qici'atemman.<note caller="-" style="x"><char style="xo" closed="false">105:19 </char><char style="xt" closed="false"><ref loc="GEN 39:20-40:23">Dada. 39:20—40:23</ref>. </char></note><verse eid="PSA 105:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20" />Ookkoneechchni udduma Gibtsek moyanji</para>
  <para style="q2" vid="PSA 105:20">Yoosefii'i tikiseexxi fulche.<note caller="-" style="x"><char style="xo" closed="false">105:20 </char><char style="xt" closed="false"><ref loc="GEN 41:14">Dada. 41:14</ref>. </char></note><verse eid="PSA 105:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21" />Isike minike umo asseexxi hariire;</para>
  <para style="q2" vid="PSA 105:21">isixxe karra duuchchike galchallonna asse.<note caller="-" style="x"><char style="xo" closed="false">105:21 </char><char style="xt" closed="false"><ref loc="GEN 41:39-41">Dada. 41:39-41</ref>. </char></note><verse eid="PSA 105:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22" />Moyanjiinka jalqabuwwa ajajo'aanna</para>
  <para style="q2" vid="PSA 105:22">moyanjiinka mari'etika manna beekkuma barachchsiiso'a baalloome.<verse eid="PSA 105:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23" />Ookkoneechchi uduma Ya'iqoobi Gibtsee'a me'eexxi</para>
  <para style="q2" vid="PSA 105:23">ookko keesummumma ofo'le.<note caller="-" style="x"><char style="xo" closed="false">105:23 </char><char style="xt" closed="false"><ref loc="GEN 46:6">Dada. 46:6</ref>; <ref loc="GEN 47:11">47:11</ref>. </char></note><verse eid="PSA 105:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24" />Duuchchi Woddik Gootti arda ifika hara bira sa'isse;</para>
  <para style="q2" vid="PSA 105:24">naapha insa'neek caalanna jabaanta'n me'inaashsha asse.<verse eid="PSA 105:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25" />Duuchchi Woddk Gootti kinni ardi ifik jibbemaashshanna</para>
  <para style="q2" vid="PSA 105:25">isike erganjuwwa'n shokkoti ke'aashsha Gibtseke mannika yaada jijjiire.<note caller="-" style="x"><char style="xo" closed="false">105:25 </char><char style="xt" closed="false"><ref loc="EXO 1:7-14">Fula. 1:7-14</ref>. </char></note><verse eid="PSA 105:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26" />Ookkoneechchi uduma Mageni ifika erganjo Muusennaa,</para>
  <para style="q2" vid="PSA 105:26">fi'lemmaka Aaroonii'i Gibtse'a erge.<note caller="-" style="x"><char style="xo" closed="false">105:26 </char><char style="xt" closed="false"><ref loc="EXO 3:1-4">Fula. 3:1-4</ref>. </char></note><verse eid="PSA 105:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27" />Insa'nenna oddo insa'nexxe'n mambe'iinka beessiissuwwa</para>
  <para style="q2" vid="PSA 105:27">masso yaanuwwanna Gibtsike boga'n assine.<verse eid="PSA 105:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28" />Boga ookkonee Mageni dukkanaashsha asse;</para>
  <para style="q2" vid="PSA 105:28">kaddo malee'e Gibtsek manni Magenokee ajajemeba'a.<note caller="-" style="x"><char style="xo" closed="false">105:28 </char><char style="xt" closed="false"><ref loc="EXO 10:21-23">Fula. 10:21-23</ref>. </char></note><verse eid="PSA 105:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29" />Insa'neke galaanuwwika wode'e jijjiireexxi mundete asse;</para>
  <para style="q2" vid="PSA 105:29">qulxu'me duuchchanna shiyye.<note caller="-" style="x"><char style="xo" closed="false">105:29 </char><char style="xt" closed="false"><ref loc="EXO 7:17-21">Fula. 7:17-21</ref>. </char></note><verse eid="PSA 105:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30" />Boga insa'neke duuchcha'n raachchi wo'me;</para>
  <para style="q2" vid="PSA 105:30">moyanjiink moyeti mini giddi midde gatebaanigi duuchchiinba raachchi wo'me.<note caller="-" style="x"><char style="xo" closed="false">105:30 </char><char style="xt" closed="false"><ref loc="EXO 8:1-6">Fula. 8:1-6</ref>. </char></note><verse eid="PSA 105:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31" />Faachchikinna bookuwwa duuchchiiba'aa insa'neke bogi giddo</para>
  <para style="q2" vid="PSA 105:31">girrise'e me'aashsha ajaje.<note caller="-" style="x"><char style="xo" closed="false">105:31 </char><char style="xt" closed="false"><ref loc="EXO 8:16-17">Fula. 8:16-17</ref>, <ref loc="EXO 8:20-24">20-24</ref>. </char></note><verse eid="PSA 105:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32" />Mageni insa'neke boga'n xeeniinxa bakka</para>
  <para style="q2" vid="PSA 105:32">kaadetanna banqo ibise.<verse eid="PSA 105:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33" />Insa'neeka woyinetika hiddichchuwwanna belleesse;</para>
  <para style="q2" vid="PSA 105:33">wele haqichchuwwa duuchchanna butuchche.<note caller="-" style="x"><char style="xo" closed="false">105:33 </char><char style="xt" closed="false"><ref loc="EXO 9:22-25">Fula. 9:22-25</ref>.</char></note><verse eid="PSA 105:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34" />Isi ajajemmashshanni laakko'a dandeessissabaak</para>
  <para style="q2" vid="PSA 105:34">koro'miisinna awwaanessi dage.<verse eid="PSA 105:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35" />Boga insa'neeke'n hedheechcho hanjachcho duuchchanna</para>
  <para style="q2" vid="PSA 105:35">midha duuchcha ite biraashsha asse.<note caller="-" style="x"><char style="xo" closed="false">105:35 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">Fula. 10:12-15</ref>. </char></note><verse eid="PSA 105:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36" />Mitte mittiniinge Gibtseke mini hadika angafa belto shiye.<note caller="-" style="x"><char style="xo" closed="false">105:36 </char><char style="xt" closed="false"><ref loc="EXO 12:29">Fula. 12:29</ref>. </char></note><verse eid="PSA 105:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37" />Ookkoneechchi uduma Isira'eelika arda aadhe fulche;</para>
  <para style="q2" vid="PSA 105:37">fullee wodda birreti siblikanna worqetika seesuwwa adhinetemman;</para>
  <para style="q2" vid="PSA 105:37">insa'neke gosat minuwwike manni gidii'n mittikinna uduma gateek hedhemmabaan.<verse eid="PSA 105:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38" />Gibtseek manni lumoshsha insa'nee sodatemaxxee</para>
  <para style="q2" vid="PSA 105:38">Isira'eelike mannixxe me'a'n gammade.<note caller="-" style="x"><char style="xo" closed="false">105:38 </char><char style="xt" closed="false"><ref loc="EXO 12:33-36">Fula. 12:33-36</ref>. </char></note><verse eid="PSA 105:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39" />Me'inaa wodda Mageni duumanchik insa'nee golle;</para>
  <para style="q2" vid="PSA 105:39">hashshanna giira insa'ne'a ifise.<note caller="-" style="x"><char style="xo" closed="false">105:39 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">Fula. 13:21-22</ref>. </char></note><verse eid="PSA 105:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40" />Indaachcho qorree wodda gogorre labbaaxxa ci'a insa'ne'a iyyedage;</para>
  <para style="q2" vid="PSA 105:40">iimii'ni indaachcho uwweexxi insa'nee goddise.<note caller="-" style="x"><char style="xo" closed="false">105:40 </char><char style="xt" closed="false"><ref loc="EXO 16:2-15">Fula. 16:2-15</ref>. </char></note><verse eid="PSA 105:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41" />Rassa shateen; wodi'ikinna fule;</para>
  <para style="q2" vid="PSA 105:41">qiilla gammoojje giddonna glaaniinsha yaa'e.<note caller="-" style="x"><char style="xo" closed="false">105:41 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Fula. 17:1-7</ref>; <ref loc="NUM 20:2-13">Lak. 20:2-13</ref>. </char></note><verse eid="PSA 105:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42" />Abirihaamii'i ifike ernganji'a uwwemmaxxa</para>
  <para style="q2" vid="PSA 105:42">ifixxa woyyitte addachchiisa dedhebaan.<verse eid="PSA 105:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43" />Tennexxee fi'lemeeka ifika arda aadheexxi fulche;</para>
  <para style="q2" vid="PSA 105:43">insa'nenna gammashshoti faarsina'ni illillinise.<verse eid="PSA 105:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44" />Wele ardika boga insa'ne'a uwwe;</para>
  <para style="q2" vid="PSA 105:44">weli elo'eexxi huccemmaka fichchuuwwanna insa'nee dhaalchise.<note caller="-" style="x"><char style="xo" closed="false">105:44 </char><char style="xt" closed="false"><ref loc="JOS 11:16-23">Iya. 11:16-23</ref>. </char></note><verse eid="PSA 105:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45" />Mageni tennee duuchcha asseechchi ardi isik seera isika duuchcha heqedho'anna</para>
  <para style="q2" vid="PSA 105:45">ajaja isika duchchanna muuxo'aten.<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="s1">Arda Ifikee'e Mageniinxa Elle</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1" />Duuchchi Woddika Gootta galateeffatte!</para>
  <para style="q2" vid="PSA 106:1">Isi eloke kademmaxxeenna arda duuchchii wodda eeyyammaxxee</para>
  <para style="q2" vid="PSA 106:1">Duuchchi Woddika Gootta galateeffatte.<note caller="-" style="x"><char style="xo" closed="false">106:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 Odo. 16:34</ref>; <ref loc="2CH 5:13">2 Odo. 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:1">Izr. 3:1</ref>; <ref loc="PSA 100:5">Far. 100:5</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Erm. 33:11</ref>. </char></note><verse eid="PSA 106:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2" />Isi asseexxa lumollamma yanne</para>
  <para style="q2" vid="PSA 106:2">ayyete laakko'e dhaqqaba?</para>
  <para style="q2" vid="PSA 106:2">Geyaaka galata ayyete isi'a uwwe dande'a?<verse eid="PSA 106:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3" />Dhugaa huja dabbaabaashsha heqqedhaakeerixxanna</para>
  <para style="q2" vid="PSA 106:3">duuchchi wodda toggitte yaane</para>
  <para style="q2" vid="PSA 106:3">assaake mannixxa wodo!<verse eid="PSA 106:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4" />Ee Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 106:4">Arda atika gargaartatto wodda aneenna qaabbati;</para>
  <para style="q2" vid="PSA 106:4">insa'nee anjirtatto wodda</para>
  <para style="q2" vid="PSA 106:4">aneenna anjir.<verse eid="PSA 106:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5" />Atee faarsaake manninaa'n mitteke kadennexxi</para>
  <para style="q2" vid="PSA 106:5">atike ardika godda uudannokenna</para>
  <para style="q2" vid="PSA 106:5">insa'nenni gammadannoke anee assi.<verse eid="PSA 106:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6" />No'oke edike annuwishsha cuobbo hunje'eennen;</para>
  <para style="q2" vid="PSA 106:6">balleessine'eennen; fuggoxxe'ninna me'ine'eennen.<verse eid="PSA 106:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7" />No'ok ediki annuwwi Gibtsee bogi giddo</para>
  <para style="q2" vid="PSA 106:7">Duuchchi Woddik Gootti hujeexxa mambe'a yaannuwwa qalbeefatebaan;</para>
  <para style="q2" vid="PSA 106:7">ifixxe jaalalanaa'n kexxeexxa insa'nee'a asseexxa heddo yaanuwwa deene;</para>
  <para style="q2" vid="PSA 106:7">diimmoxe abbaayya bira iso'n jalline.<note caller="-" style="x"><char style="xo" closed="false">106:7 </char><char style="xt" closed="false"><ref loc="EXO 14:10-12">Fula. 14:10-12</ref>. </char></note><verse eid="PSA 106:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8" />Kaddo malee'e ifixxa lumoxxa hunna ege'nisho'a,</para>
  <para style="q2" vid="PSA 106:8">summa ifikee hiyyeexxi insa'nee anjire.<verse eid="PSA 106:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9" />Diimmoxxa abbaayya ajajee wodda isenna bagge;</para>
  <para style="q2" vid="PSA 106:9">dhi'mo wode'e qiilla gammoojje asseexxi</para>
  <para style="q2" vid="PSA 106:9">ifika arda akeeka'n foosse.<verse eid="PSA 106:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10" />Insa'nee gibammake mannanaa'ni insaa'nee anjire;</para>
  <para style="q2" vid="PSA 106:10">insa'neke naaphanaa'ninna insa'nee gatise.<verse eid="PSA 106:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11" />Yanne kinni naapha insa'neeka wodi'i liqiinse;</para>
  <para style="q2" vid="PSA 106:11">mittikinna insa'nee gidii'n gateek hedhemmabaan.<verse eid="PSA 106:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12" />Ookkoneechchi uduma Mageniink ardi Mageniinxe addachchiisake hiyyichcho'n amaneexxi</para>
  <para style="q2" vid="PSA 106:12">galatiinxa faaronna isi'a faarse.<note caller="-" style="x"><char style="xo" closed="false">106:12 </char><char style="xt" closed="false"><ref loc="EXO 14:31">Fula. 14:31</ref>. </char></note><note caller="-" style="x"><char style="xo" closed="false">106:12 </char><char style="xt" closed="false"><ref loc="EXO 15:1-21">Fula. 15:1-21</ref>. </char></note><verse eid="PSA 106:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13" />Yanne kinni asseemmaxxa mambe'a yaane duuchcha</para>
  <para style="q2" vid="PSA 106:13">iikki woddi deene;</para>
  <para style="q1" vid="PSA 106:13">Gorsa isika heqqedha ginbeexxi fedhii ifixxa asse'ne.<verse eid="PSA 106:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14" />Qiilla gammoojje giddo heddo yaane yorreexxi</para>
  <para style="q2" vid="PSA 106:14">Magenokanna hega uunde.<verse eid="PSA 106:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15" />Isoo kadhanteechcho duuchcha insa'ne'a uuwe;</para>
  <para style="q2" vid="PSA 106:15">kaddo malee'e yaayyisaaka dhukkuba insa'ne'ni ibise.<note caller="-" style="x"><char style="xo" closed="false">106:15 </char><char style="xt" closed="false"><ref loc="NUM 11:4-34">Lak. 11:4-34</ref>. </char></note><verse eid="PSA 106:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16" />Qiilla gammoojje giddo he'nemma wodda Muuseenna</para>
  <para style="q2" vid="PSA 106:16">Duuchchi Woddike Goottika woyyichcha erganjo Aaroonii'i hinaanfe.<verse eid="PSA 106:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17" />Buttini haanni hiyyeexxi</para>
  <para style="q2" vid="PSA 106:17">Daataanii'i liqiinse;</para>
  <para style="q2" vid="PSA 106:17">Aberoo'ninna isike mini hado'n tuuleme.<verse eid="PSA 106:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18" />Insa'nexxe gamo kadeemmaka</para>
  <para style="q2" vid="PSA 106:18">ookkone fuggaaleessa manna giira iimi'ni dagge itte.<note caller="-" style="x"><char style="xo" closed="false">106:18 </char><char style="xt" closed="false"><ref loc="NUM 16:1-35">Lak. 16:1-35</ref>. </char></note><verse eid="PSA 106:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19" />Koorebi he'nemma wodda worqeti jibichchiinxa fakke giise'neexxi</para>
  <para style="q2" vid="PSA 106:19">eettenne jibbichchiinxe fakke'anna sagande.<verse eid="PSA 106:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20" />Mageniinka gaachchanna</para>
  <para style="q2" vid="PSA 106:20">badda'a dheedaake horxe fakke'n jijjiirre.<verse eid="PSA 106:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21" />Gibtsee boga'ni lumolla mambe'a yaanuwwa assa'n</para>
  <para style="q2" vid="PSA 106:21">insa'nee anjireemmaka Mageno deene.<verse eid="PSA 106:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22" />Gibtse boga'ni asseemmaxxa mambe'a yaannuwwanna</para>
  <para style="q2" vid="PSA 106:22">Diimmoxxe abbaayya'ninna asseemmaxxa masoo yannuwwa deene.<verse eid="PSA 106:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23" />Tennenaa'n kexxeeexxa Mageni arda ifika</para>
  <para style="q2" vid="PSA 106:23">biro'a mudhe'eemman;</para>
  <para style="q1" vid="PSA 106:23">yaane kinni Mageni fi'leemmak Muuse oddote'ni sa'eexxi</para>
  <para style="q2" vid="PSA 106:23">Mageni insa'nee mufeti birabaashsha</para>
  <para style="q2" vid="PSA 106:23">insa'nexxee Mageno soodate.<note caller="-" style="x"><char style="xo" closed="false">106:23 </char><char style="xt" closed="false"><ref loc="EXO 32:1-14">Fula. 32:1-14</ref>. </char></note><verse eid="PSA 106:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24" />Mageniinka hiyyichcho addata gonpheemmaxxee'e</para>
  <para style="q2" vid="PSA 106:24">ookkonee eloka boga tuffante.<verse eid="PSA 106:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25" />Ifi ifike dunkaane giddo he'neexxi adhdhumme;</para>
  <para style="q2" vid="PSA 106:25">Duuchchi Woddike Goottika hiyyichchonna lanqebaan.<verse eid="PSA 106:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26" />Tennexxe qiilla gammoojje giddo insa'nee biraaxxa</para>
  <para style="q2" vid="PSA 106:26">anga iimi'a ke'iseexxi kakate.<note caller="-" style="x"><char style="xo" closed="false">106:26 </char><char style="xt" closed="false"><ref loc="NUM 14:1-35">Lak. 14:1-35</ref>. </char></note><verse eid="PSA 106:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27" />Horte insa'nexxa duuchcha dharichcha mageno magenoofata'neeke ardixxe oddo'n xeere'naa'a</para>
  <para style="q2" vid="PSA 106:27">annafee boga'ni rennaashsha assaaxxa haaso'e.<note caller="-" style="x"><char style="xo" closed="false">106:27 </char><char style="xt" closed="false"><ref loc="LEV 26:33">Lew. 26:33</ref>. </char></note><verse eid="PSA 106:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28" />Ookkonechchi uduma Mageniink ardi</para>
  <para style="q2" vid="PSA 106:28">Fegoori hiyyemaaba Ba'aali hiyyendaaxxa fakke magenoofate;</para>
  <para style="q2" vid="PSA 106:28">hedho affebaaxxe fakkuwwa'a</para>
  <para style="q2" vid="PSA 106:28">tolchemeeka maalanna inde.<verse eid="PSA 106:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29" />Insa'ne fuggoxxe hunjenni Duuchchi Woddka Gootta mufachchiinse;</para>
  <para style="q2" vid="PSA 106:29">tennexxee'e fuggoxxi bala insa'ne'ni ibbe.<verse eid="PSA 106:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30" />Yaane kinni Finihaasi ke'eexxi</para>
  <para style="q2" vid="PSA 106:30">balleessa hujeemmaka manna shiyyee wodda</para>
  <para style="q2" vid="PSA 106:30">dhukkubi ba'e.<verse eid="PSA 106:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31" />Finihaasi asseexxa tenne eloxxa yaane ardi duuchchi wodda qaabbata'neemman,</para>
  <para style="q2" vid="PSA 106:31">edi'aanna daggaaxxi ila duuchchi wodda qaabbata'n hexxaan.<verse eid="PSA 106:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32" />Meribaaxxe muumuwwaba</para>
  <para style="q2" vid="PSA 106:32">ardi Mageno muffachchiise;</para>
  <para style="q2" vid="PSA 106:32">insa'nenaa'n kexxeexxa Muuse'ni rakko gelte.<verse eid="PSA 106:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33" />Insa'nenna yo'oshsha isoo muffachchiinseemmaxxee</para>
  <para style="q2" vid="PSA 106:33">Muuse hasisabaaka haaso'a afo'okenaa'ni fulchedhe.<note caller="-" style="x"><char style="xo" closed="false">106:33 </char><char style="xt" closed="false"><ref loc="NUM 20:2-13">Lak. 20:2-13</ref>. </char></note><verse eid="PSA 106:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34" />Duuchchi Woddik Gootti insa'nee ajajeemmaashsha</para>
  <para style="q2" vid="PSA 106:34">dharichcha mageno magenoofatammaka arda birebaan.<verse eid="PSA 106:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35" />Iittaanni gosa gosake ardinni welti karseemmeexxi</para>
  <para style="q2" vid="PSA 106:35">insa'neke galdumaxxa aada hordonfe.<verse eid="PSA 106:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36" />Makeniink ardi wele ardixxa fakkuwwa magenoofate</para>
  <para style="q2" vid="PSA 106:36">tinninna insa'nexxe ba'ne'a buutote kadde.<note caller="-" style="x"><char style="xo" closed="false">106:36 </char><char style="xt" closed="false"><ref loc="JDG 2:1-3">Hay. 2:1-3</ref>; <ref loc="JDG 3:5-6">3:5-6</ref>. </char></note><verse eid="PSA 106:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37" />Labbaxxana meyyaxxa ifixxa oose</para>
  <para style="q2" vid="PSA 106:37">Kanaanike bogike dharichcha magenuwwi'a tolchine.<note caller="-" style="x"><char style="xo" closed="false">106:37 </char><char style="xt" closed="false"><ref loc="2KI 17:17">2 Moy. 17:17</ref>. </char></note><verse eid="PSA 106:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38" />Mitte balleessa affebaaxxa ifixxa labbaxxanna meyyaxxa oose shinnaa'naa</para>
  <para style="q2" vid="PSA 106:38">bogikinna mundeti batto'e.<note caller="-" style="x"><char style="xo" closed="false">106:38 </char><char style="xt" closed="false"><ref loc="NUM 35:33">Lak. 35:33</ref>. </char></note><verse eid="PSA 106:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39" />Huje insa'nexxi insa'nee battoossite;</para>
  <para style="q2" vid="PSA 106:39">assineemmaxxi fuggoxxi yaanenna Magenokenaa'ni insa'nee gorsite,<verse eid="PSA 106:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40" />Tennexxee Duuchchi Woddik Gootti arda ifike'n aare;</para>
  <para style="q2" vid="PSA 106:40">insa'neenna xireefate.<note caller="-" style="x"><char style="xo" closed="false">106:40 </char><char style="xt" closed="false"><ref loc="JDG 2:14-18">Hay. 2:14-18</ref>. </char></note><verse eid="PSA 106:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41" />Wele gosake ardixxe anga'n insa'nee sa'isse uwwe;</para>
  <para style="q2" vid="PSA 106:41">naaphi insa'nekinna insaa'nee moye galche.<verse eid="PSA 106:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42" />Naaphi insa'nee miica'naa</para>
  <para style="q2" vid="PSA 106:42">naaphii hunda yuukki hine galle.<verse eid="PSA 106:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43" />Duuchchi Woddik Gootti arda ifika heddole anjireedheen;</para>
  <para style="q2" vid="PSA 106:43">yaane kinni insa'ne egenna'ninni iso'ni jallante;</para>
  <para style="q2" vid="PSA 106:43">tenni hunjeemmaxxi cubbo insa'nee salphisse.<verse eid="PSA 106:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44" />Yaane kinni Duuchchi Woddik Gootti oo'naa wodda laqaamman;</para>
  <para style="q2" vid="PSA 106:44">rakko insa'nexxanna uudaamman.<verse eid="PSA 106:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45" />Insa'nee gargaaro'a aageemmaxxa kako qaabbata'nemman</para>
  <para style="q2" vid="PSA 106:45">lumoxxe ifixxe jaalala'a hiyyeexxi insa'ne'aa o'wa'nemman.<verse eid="PSA 106:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46" />Insa'nee miicaammak duuchchi</para>
  <para style="q2" vid="PSA 106:46">insa'ne'aa o'waashsha asse.<verse eid="PSA 106:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47" />Ee, Duuchchi Wooddike Gootta no'oke Magenoo! No'oo anjir!</para>
  <para style="q2" vid="PSA 106:47">Atee galateeffantonnaa</para>
  <para style="q2" vid="PSA 106:47">woyyichcha summa atika saandonnaa</para>
  <para style="q2" vid="PSA 106:47">wele gosaxxe mootumma giddii'n</para>
  <para style="q2" vid="PSA 106:47">no'oo boga no'okibaa illee iima hiissi.<verse eid="PSA 106:47" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48" />Duuchchi Woddik Gootti Isira'eelik Mageni</para>
  <para style="q2" vid="PSA 106:48">duuchchi woddi'a saademowwaal!</para>
  <para style="q2" vid="PSA 106:48">Ardi duuchchi hamiin hiyye;</para>
  <para style="q2" vid="PSA 106:48">Duuchchi Woddika Goottanna galateeffatte.<note caller="-" style="x"><char style="xo" closed="false">106:48 </char><char style="xt" closed="false"><ref loc="1CH 16:35-36">1 Odo. 16:35-36</ref>. </char></note><verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms">Ondika Maxaafa</para>
  <para style="mr">
    <ref loc="PSA 107-150">Far. 107—150</ref></para>
  <para style="d">Mageniixe Ellexxee Shiqaaka Galata</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1" />Eloke kadeemmaxxeenna arda duuchchii wodda eeyya'eemmaxxee</para>
  <para style="q2" vid="PSA 107:1">Duuchchi Woddika Gootta galateeffatte!<note caller="-" style="x"><char style="xo" closed="false">107:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 Odo. 16:34</ref>; <ref loc="2CH 5:13">2 Odo. 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Izr. 3:11</ref>; <ref loc="PSA 100:5">Far. 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Erm. 33:11</ref>. </char></note><verse eid="PSA 107:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2" />Duuchchi Woddik Gootti anjireek</para>
  <para style="q2" vid="PSA 107:2">naaphiinxe anganaa'ninna fulcheemmak duuchchinna tenneenni hiyyowwal.<verse eid="PSA 107:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3" />Boroti'ninna dhidhimi darre'ni</para>
  <para style="q2" vid="PSA 107:3">midii'inna bita'ii'ni,</para>
  <para style="q2" vid="PSA 107:3">bogi bogii'ni bukki asseekiir tenneenni hiyyowwaal.<note caller="+" style="f"><char style="fr" closed="false">107:3 </char><char style="ft" closed="false">Ibritoti Middi'ninna Lumoxxe Abbaayya hitaan. </char></note><verse eid="PSA 107:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4" />Mitti mitti qiilla gammoojje giddo doonsa kiyya hiyya'n rakkate</para>
  <para style="q2" vid="PSA 107:4">he'naake qachchiba'a iyyemaraaka</para>
  <para style="q2" vid="PSA 107:4">ora haanke.<verse eid="PSA 107:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5" />Dheebo'wine solo'wineemmaxxee</para>
  <para style="q2" vid="PSA 107:5">insa'nee lubbo fula gelte.<verse eid="PSA 107:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6" />Insa'nenna rakko giddo he'ne'e Duuchchi Woddike Goottiba'a oo'ne;</para>
  <para style="q2" vid="PSA 107:6">Isinna abarakenaa'n insa'nee anjire.<verse eid="PSA 107:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7" />He'naake qachchiba'a</para>
  <para style="q2" vid="PSA 107:7">insa'nee toggichcha ora'ni akeeke.<verse eid="PSA 107:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8" />Duuchchi Woddika Gootta isixxe duuchchii woddixxe jaalala'a</para>
  <para style="q2" vid="PSA 107:8">manjiinke belti'a asseeke mambe'uwwi'aanna galateeffantowwaal.<verse eid="PSA 107:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9" />Isi dheebo'weekaara dheebo fulche'eeken;</para>
  <para style="q2" vid="PSA 107:9">solo'weekaaranna heddo elola yaanenni goddise'eeken.<verse eid="PSA 107:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10" />Insa'ne giddii'ni mitti mitti dukkana dimmi giddo</para>
  <para style="q2" vid="PSA 107:10">haachchabik usureemme rakkateemman.<verse eid="PSA 107:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11" />Tinni duuchchi insa'ne'ni gelteechchi Dada Duuchchik Duuchchi Woddik Gootti Mageniinke</para>
  <para style="q2" vid="PSA 107:11">hiyyichcho'n jallanteemmaxxee,</para>
  <para style="q2" vid="PSA 107:11">gorsa isikanna tuffanteemmaxxeeten.<verse eid="PSA 107:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12" />Tennexxee jabaxxe hujenni insa'nee selli asse;</para>
  <para style="q2" vid="PSA 107:12">insa'nee gargaraak hedhemabaan; guggufanitenna inbe.<verse eid="PSA 107:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13" />Rakko giddo he'ne'e Duuchchi Woddike Goottibaa oo'ne</para>
  <para style="q2" vid="PSA 107:13">isinna abarakenaa'ni insa'nee anjire.<verse eid="PSA 107:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14" />Dimma dukkana giddii'n insa'nee fulche;</para>
  <para style="q2" vid="PSA 107:14">usureemmeemmaka haachabanna tanshe.<verse eid="PSA 107:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15" />Duuchchi Woddika Gootta isixxe duuchchi woddixxe jaalala'a</para>
  <para style="q2" vid="PSA 107:15">manjiinke belti'a asseke mambe'uwwi'aanna galteeffantowwaal.<verse eid="PSA 107:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16" />Isi saagetotike sibiljika cufanuwwa butuchche'een,</para>
  <para style="q2" vid="PSA 107:16">sibiljiinka danqarisanjuwwanna kukkute'een.<verse eid="PSA 107:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17" />Mitti mitti xaqarotenaa'n kexxeexxa doode;</para>
  <para style="q2" vid="PSA 107:17">seera sa'atenaa'ni kexxeexxa rakkate.<verse eid="PSA 107:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18" />Ita duuchcha insa'nee boshshe;</para>
  <para style="q2" vid="PSA 107:18">reyanna shinqe.<verse eid="PSA 107:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19" />Rako giddo he'ne'e Duuchchi woddike Gottiba'a oo'ne;</para>
  <para style="q2" vid="PSA 107:19">isinna abarakenaa'n insa'nee anjire.<verse eid="PSA 107:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20" />Hiyyichcho ifika insa'ne'n haaso'eexxi,</para>
  <para style="q2" vid="PSA 107:20">hirreesiinxe balenaa'ninna insa'nee gatise.<verse eid="PSA 107:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21" />Duuchchi Woddika Gootta isixxe duuchchii woddixxe jaalalaxxee</para>
  <para style="q2" vid="PSA 107:21">manjiink belti'a asseeke mambe'uwwi'aanna galateeffantowwaal.<verse eid="PSA 107:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22" />Insa'ne galatiinka tolcha isi'a shiqinshowwali;</para>
  <para style="q2" vid="PSA 107:22">asseexxaranna gammachchiissaaxxe faaronni haasonnowwaal.<verse eid="PSA 107:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23" />Mitti mitti markaba gulufe'e abbaayatti hana me'e;</para>
  <para style="q2" vid="PSA 107:23">ba'lake wodi'i hananna dadda'la'nemman.<verse eid="PSA 107:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24" />Insa'nenna Duuchchi Woddike Goottixxa huje,</para>
  <para style="q2" vid="PSA 107:24">dhi'mo abbaayya giddonna asseexxa mambe'a yaanuwwa uunde.<verse eid="PSA 107:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25" />Isi ajajee wodda hobonbalte kexxe;</para>
  <para style="q2" vid="PSA 107:25">danbala'ikinna wode'e raase.<verse eid="PSA 107:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26" />Markabiink manni hobonbalteti iimi'a darbeme;</para>
  <para style="q2" vid="PSA 107:26">dhi'moti giddii'aanna wirri hiyye hige;</para>
  <para style="q2" vid="PSA 107:26">rakkotenaa'ni kexxeexxinninna alayye qexerri hiyye.<verse eid="PSA 107:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27" />Machcho'eeke manjiinsha bogi insa'nenaa'ni ba'ee'naa gatantarre;</para>
  <para style="q2" vid="PSA 107:27">ege'naa insa'nenaa'n baxxee'naa assinaanxa gonphe.<verse eid="PSA 107:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28" />Rakkoti giddo he'ne'e Duuchchi Woddike Goottiba'a oo'ne;</para>
  <para style="q2" vid="PSA 107:28">Isinna abarakenaa'n insa'nee anjire.<verse eid="PSA 107:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29" />Hobonbalte ca'li asse;</para>
  <para style="q2" vid="PSA 107:29">danbala'akanna sammi asse.<verse eid="PSA 107:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30" />Sammi hitteemmaxxeenna gammande;</para>
  <para style="q2" vid="PSA 107:30">genno'a halchinnaamake abbaayyati qarqarba'aa geessise.<verse eid="PSA 107:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31" />Duuchchi Woddika Gootta isixxe duuchchi woddixxe jaalala'a</para>
  <para style="q2" vid="PSA 107:31">manjiinke belti'a asseeke mambe'uwwi'aanna galateeffantowwaal.<verse eid="PSA 107:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32" />Bukki hiyye'eeke ardi giddo isoo kubbinsowwaal;</para>
  <para style="q2" vid="PSA 107:32">galchaammake mannixxe songo'ninna isoo'o saandowwaal.<verse eid="PSA 107:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33" />Duuchchi Woddik Gootti galaana qiilla gammooje'n</para>
  <para style="q2" vid="PSA 107:33">muummuwwatanna bago boga'n jijjiire.<verse eid="PSA 107:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34" />Ookko hedhaammake mannixxe fuggaaleesummanaa'n kexxeexxa</para>
  <para style="q2" vid="PSA 107:34">shamoka boga maxinetike boga asse.<verse eid="PSA 107:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35" />Qiilla gammoojje baleesuwwiinke eela'n,</para>
  <para style="q2" vid="PSA 107:35">bagoka boganna muummuwwate'n jijjiire.<verse eid="PSA 107:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36" />So'lo'weeka arda ookko iyyedage;</para>
  <para style="q2" vid="PSA 107:36">insa'ne'aanna he'naaka mine ijaare.<verse eid="PSA 107:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37" />Insa'nenna fichchake'n huccine; woyinetanna kaanse;</para>
  <para style="q2" vid="PSA 107:37">misse'eexxa midhanna aasse'ne.<verse eid="PSA 107:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38" />Insa'nee eebbise;</para>
  <para style="q2" vid="PSA 107:38">insa'nenna horre bira sa'ne;</para>
  <para style="q2" vid="PSA 107:38">insa'neke horki laakkossinna shiixxedhabaashsha asse.<verse eid="PSA 107:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39" />Miicamik, rakkotinna yaaddoti</para>
  <para style="q2" vid="PSA 107:39">laakkossi insa'neek shiixxedhee'naa'a salphante'eemman.<verse eid="PSA 107:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40" />Isinna ja'laabuwwake'n salphine ibise;</para>
  <para style="q2" vid="PSA 107:40">qiilla gammoojjeke maanchi giddonna doonsa kiyya hinaashsha asse.<verse eid="PSA 107:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41" />Rakkiyye kinni abarakenaa'n fulche;</para>
  <para style="q2" vid="PSA 107:41">insa'neka mini hadonna horiinsha bira sa'isse.<verse eid="PSA 107:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42" />Tennee uudeexxi qulliyye gammadaan;</para>
  <para style="q2" vid="PSA 107:42">fuggaaleeyye kinni shookee'e afo'o abixxitaan.<verse eid="PSA 107:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43" />Beekake kadeek duuchchi tennee qalbeeffatowwaal;</para>
  <para style="q2" vid="PSA 107:43">isinna Duuchchi Woddike Goottixxa duuchchii woddixxa jaalala hubatowwaal.<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="s1">Mageniinke gargaarsi'a Soodatendeexxa Soodachcho</para>
  <para style="d">Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1" />Ee, anke Mageno godoba mittinni hedheennen;</para>
  <para style="q2" vid="PSA 108:1">faarsaannen; wo'ma hedhonninna faarsaannen.<verse eid="PSA 108:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2" />Koo baganaa, tee masinqoo ke'we</para>
  <para style="q2" vid="PSA 108:2">aninna soodimaro dammassannen.<verse eid="PSA 108:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3" />Ee, Duuchchi Woddike Goottaa! Gosa gosake ardixxe oddo'n atee saadannen;</para>
  <para style="q2" vid="PSA 108:3">Ardi giddonna ati'a galatiinxa faaro farsannon.<verse eid="PSA 108:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4" />Duchchii woddixxi atixxi jalala iimatike bayyinni iimi darren;</para>
  <para style="q2" vid="PSA 108:4">xuurameessumma atixxinna buttii'ni iimmi qico'ni gelte'eexxen.<verse eid="PSA 108:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5" />Ee, Mageno iimati iimi darre ati lummedhi;</para>
  <para style="q2" vid="PSA 108:5">butta duchcha'ni gaachchanni atikinna hedhowwaal.<verse eid="PSA 108:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6" />Eeta'eetek atiki ardi anjiremaashsha</para>
  <para style="q2" vid="PSA 108:6">middixxe atixxe anganni no'oo gargaar;</para>
  <para style="q2" vid="PSA 108:6">soodachcho anxa laqi.<verse eid="PSA 108:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7" />Mageni galma ifiike'ni hedheexxi hiyyee qici,</para>
  <para style="q2" vid="PSA 108:7">«Gammada'nee Sekemika qachcha qoodannon;</para>
  <para style="q2" vid="PSA 108:7">Sukootixxa dhooqanna mikannon.<verse eid="PSA 108:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8" />Gele'adi anken; Minaasenna anken;</para>
  <para style="q2" vid="PSA 108:8">Efireemi anxe gullen;</para>
  <para style="q2" vid="PSA 108:8">Yihudanna anxe mootummaxxe bokkon.<verse eid="PSA 108:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9" />Mo'aabi ani anshedhannoke gongan;</para>
  <para style="q2" vid="PSA 108:9">Eedoomi hana kophe anxa qolaanchannon;</para>
  <para style="q2" vid="PSA 108:9">Filisixxeemike arda'ninna inijfachchoti geeraarannon.»<verse eid="PSA 108:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10" />Kinjiinke dalla'inni ijaremeeke qachchiba ayyete anee iyyemara?</para>
  <para style="q2" vid="PSA 108:10">Eedoomi ayyete anee geesisa?<verse eid="PSA 108:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11" />Ee, Magenoo no'oo deete'eetek atetebaa?</para>
  <para style="q2" vid="PSA 108:11">Duuchchi Woddike Gootta no'oke sannachchinni welti fuldaabexxon.<verse eid="PSA 108:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12" />Manjiink gargaarsi woyi fulabaakeni</para>
  <para style="q2" vid="PSA 108:12">naapha no'oke'n middite no'aa uwwi.<verse eid="PSA 108:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13" />Mageniinke gargaarsinni injifantannon;</para>
  <para style="q2" vid="PSA 108:13">naapha nokanna hirbeesaak isoten.<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="s1">Rakkote'n Hedheeke Manjiinxa Waaka</para>
  <para style="d">Faarsaaleeyyetike Sooresi'a Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1" />Anke galatixxe muumme kaddeeteke Magenoo!</para>
  <para style="q2" vid="PSA 109:1">Sammi hitoxxe'e.<verse eid="PSA 109:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2" />Fuggaaleessi manni, dharaameeyye</para>
  <para style="q2" vid="PSA 109:2">afo'o ane'ni fulchexxe'een;</para>
  <para style="q2" vid="PSA 109:2">dharikinna ane'n haassoneen.<verse eid="PSA 109:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3" />Fuggoxxenni ane'ni gumme'e</para>
  <para style="q2" vid="PSA 109:3">tola boddichchanga anee lolle miine.<verse eid="PSA 109:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4" />Eeyyenne galata eeyyannakiir anke diina kade;</para>
  <para style="q2" vid="PSA 109:4">ani kinni insa'ne'aa soodataannen.<verse eid="PSA 109:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5" />Eloxxixxa bado fuggoxxa,</para>
  <para style="q2" vid="PSA 109:5">insa'nee eeyyennaxxee jibba</para>
  <para style="q2" vid="PSA 109:5">ani'a bado hiissinaan.<verse eid="PSA 109:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6" />Fuggichcha manjo iso'ni ke'issi;</para>
  <para style="q2" vid="PSA 109:6">iso'o ku'laakanna middake'n uurrisi.<verse eid="PSA 109:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7" />Songo giddo moromaa woddanna balleessa iso'ni afendo'o;</para>
  <para style="q2" vid="PSA 109:7">soodataaxxi soodachchonna isi'a cubbote kado'o.<verse eid="PSA 109:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8" />Bari isiki haru'moo;</para>
  <para style="q2" vid="PSA 109:8">baallooma isikanna weli adhdhowwaal.<verse eid="PSA 109:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9" />Oose isixxi anni belo gattowwaal;</para>
  <para style="q2" vid="PSA 109:9">are isixxinna hiyyeette, aro'o affebaaxxxe kaddowwaal.<verse eid="PSA 109:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10" />Oose isixxi doonsa kiyya hitaaxxe kadhatto kaddowwaal;</para>
  <para style="q2" vid="PSA 109:10">he'nammake horonqa minenaa'ninna shorremmowwaal.<verse eid="PSA 109:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11" />Horateechchi duuchchi liqakee'e adhdhemowwal;</para>
  <para style="q2" vid="PSA 109:11">elo'e alfeechcho duuchchanna alagi adhdhowwaali.<verse eid="PSA 109:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12" />Ayyinna isi'a o'woqqe'e;</para>
  <para style="q2" vid="PSA 109:12">oose isixxa anni reyeemmaxxee'e mararaak hedhoqqe'e.<verse eid="PSA 109:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13" />Horte isixxi muddowwaal;</para>
  <para style="q2" vid="PSA 109:13">summi insa'neekinna insa'ne udumixxe ila'ni ba'owwaal.<verse eid="PSA 109:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14" />Duuchchi Woddike Gootti edike isike annuwwixxa cubbo hedowwaal,</para>
  <para style="q2" vid="PSA 109:14">isixxe amaxxa cubbonna ise'aa gattowwaal hiyyoqqe'e.<verse eid="PSA 109:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15" />Buttate'n haranga dedhemme gantaashsha</para>
  <para style="q2" vid="PSA 109:15">Duuchchi Woddiki Gootti cubbo insa'neexxa duuchchii wodda qaabbattowwaal.<verse eid="PSA 109:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16" />Iikki manjichchi eloxxa huje hajatee haranga hedeemabaan;</para>
  <para style="q2" vid="PSA 109:16">hiyyeesa, rakkichchakanna cuqurto'eeka manna shorrisha'n shiyaaman.<verse eid="PSA 109:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17" />Isi bada eeyya'neemmaxxe'e isinna badinemeeke kaddowwaal;</para>
  <para style="q2" vid="PSA 109:17">isi eebba gibaammaxxee</para>
  <para style="q2" vid="PSA 109:17">isoonna eebbisaak manji afeemmoqqe'e.<verse eid="PSA 109:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18" />Isi yowwichcho seematishsha oddo'ween;</para>
  <para style="q2" vid="PSA 109:18">kunni yowwichchi wodi'iinsha isike giddike bisi giddi'aanna</para>
  <para style="q2" vid="PSA 109:18">zayitetishsha isike micci giddi'a e'yowwaal.<verse eid="PSA 109:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19" />Abbo, yowwichcho ifi'n oddo'waammaxxe oddoononna</para>
  <para style="q2" vid="PSA 109:19">duuchchii wodda hidhake'n ka'laammaxxe mixe isi'a kadowwaal.<verse eid="PSA 109:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20" />Tinni duuchchi abbo, ane diinaakeeri'a</para>
  <para style="q2" vid="PSA 109:20">lubbo anxee'e fuggoxxa haaso'aakeeri'a</para>
  <para style="q2" vid="PSA 109:20">Duuchchi Woddik Gootti uwwaake hira kadowwaal.<verse eid="PSA 109:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21" />Ee, Dada Duuchchike Duuchchi Woddike Goottaa</para>
  <para style="q2" vid="PSA 109:21">summa atike'ee eloxxenni anee uudi;</para>
  <para style="q2" vid="PSA 109:21">atixxi jaalalanna eloxxe kaddeemmaxxee anee anjir.<verse eid="PSA 109:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22" />Ani hiyyeessakenna rakkichchake kadeennaxxee</para>
  <para style="q2" vid="PSA 109:22">anxi hedho giddo madoote'een.<verse eid="PSA 109:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23" />Ani galgalixxe gaaddiddoshsha sa'aa shiqeennen,</para>
  <para style="q2" vid="PSA 109:23">awwaanessiinshanna hargufeme'eennen.<verse eid="PSA 109:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24" />Agabo goddo hedhatenaa'n kexxeexxa gulub anee gilgile;</para>
  <para style="q2" vid="PSA 109:24">bisi ankinna huqqate bululo'e.<verse eid="PSA 109:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25" />Naaphakee gaciffachchotike kadenneni;</para>
  <para style="q2" vid="PSA 109:25">anee afaa woddanna umo ane'n le'misaan.<note caller="-" style="x"><char style="xo" closed="false">109:25 </char><char style="xt" closed="false"><ref loc="MAT 27:39">Mat. 27:39</ref>; <ref loc="MRK 15:29">Mar. 15:29</ref>. </char></note><verse eid="PSA 109:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26" />Ee, Duuchchi Woddike Gootta anke Magenoo anee gargaar;</para>
  <para style="q2" vid="PSA 109:26">atixxe jaalalaxxee'e anee anjir.<verse eid="PSA 109:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27" />Ee, Duuchchi Woddike Goottaa anga atixxi tennee aassite'eexxa</para>
  <para style="q2" vid="PSA 109:27">atinna tennee muuxe'eetexxa egennowwaal.<verse eid="PSA 109:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28" />Insa'ne bandaan;</para>
  <para style="q2" vid="PSA 109:28">ati kinni eebbisatton;</para>
  <para style="q2" vid="PSA 109:28">ane'n ke'aakiir salphataan;</para>
  <para style="q2" vid="PSA 109:28">garbichchi atik ani kinni gammadannon.<verse eid="PSA 109:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29" />Diini ank shooko oddo'wowwaal;</para>
  <para style="q2" vid="PSA 109:29">salphinnekanna hana fugatowwaal.<verse eid="PSA 109:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30" />Afo'o ankenni Duuchchi Woddika Gootta lummisee galateeffataannen;</para>
  <para style="q2" vid="PSA 109:30">heddo ardi giddonna isoo saadannon.<verse eid="PSA 109:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31" />Tinni kaddeechchi isoo shiyo'a qophpheefateeke mannixxe anganaa'ni anjiro'aa</para>
  <para style="q2" vid="PSA 109:31">isi rakkichchiinke midda'n uurraani.<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="s1">Duuchchi Woddik Gootti Fi'leeka Moyanjo</para>
  <para style="d">Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1" />Duuchchi Woddik Gootti anka goottaa</para>
  <para style="q2" vid="PSA 110:1">«Atika naapha atixxe lekkake hirbi hunda sa'isano qico'n</para>
  <para style="q2" vid="PSA 110:1">anke midda'n offo'l» hiyye.<note caller="-" style="x"><char style="xo" closed="false">110:1 </char><char style="xt" closed="false"><ref loc="MAT 22:44">Mat. 22:44</ref>; <ref loc="MRK 12:36">Mar. 12:36</ref>; <ref loc="LUK 20:42-43">Luq. 20:42-43</ref>; <ref loc="ACT 2:34-35">Erga. Huj. 2:34-35</ref>; <ref loc="1CO 15:25">1 Qor. 15:25</ref>; <ref loc="EPH 1:20-22">Efe. 1:20-22</ref>; <ref loc="COL 3:1">Qol. 3:1</ref>; <ref loc="HEB 1:13">Ibr. 1:13</ref>; <ref loc="HEB 8:1">8:1</ref>; <ref loc="HEB 10:12-13">10:12-13</ref>. </char></note><verse eid="PSA 110:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2" />Duuchchi Woddik Gootti atixxa hunnaameete siqqichcho</para>
  <para style="q2" vid="PSA 110:2">Tsiyoonibaa'n gadhi'a ba'lsaan;</para>
  <para style="q2" vid="PSA 110:2">atinna naapha atiki giddo hexxee'e moottatton.<verse eid="PSA 110:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3" />Bagedokee fuldattoxxa barra</para>
  <para style="q2" vid="PSA 110:3">atik loliink manni feedhii ifixxenni ifi ati'a uwwaan;</para>
  <para style="q2" vid="PSA 110:3">soodimariinke gadaammeesanaa'n woyyichchi gaachchanninni ulfaate'e</para>
  <para style="q2" vid="PSA 110:3">dargageessumma atixxika haanjine fixeesiinsha adhitatton.<verse eid="PSA 110:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4" />«Ati Malketsedeeqike qeesummatike seerishsha</para>
  <para style="q2" vid="PSA 110:4">duuchchii woddi'a qeeseten» hiyyeexxi Duuchchii Woddik Gootti kakate'een;</para>
  <para style="q2" vid="PSA 110:4">isi yaada ifika jijjiirabaan.<note caller="-" style="x"><char style="xo" closed="false">110:4 </char><char style="xt" closed="false"><ref loc="HEB 5:6">Ibr. 5:6</ref>; <ref loc="HEB 6:20">6:20</ref>; <ref loc="HEB 7:17">7:17</ref>, <ref loc="HEB 7:21">21</ref>. </char></note><verse eid="PSA 110:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5" />Dada Duuchchik Gootti atike midda'n hedheen;</para>
  <para style="q2" vid="PSA 110:5">isixxe mufexxa barranna moyanjuwwa bulleessaan.<verse eid="PSA 110:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6" />Isi gosa gosake arda'n muraan;</para>
  <para style="q2" vid="PSA 110:6">bogi bogike umo kade'eemakaara bulleesseexxi renshange'n rensha lebaan.<verse eid="PSA 110:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7" />Orii qarqara hexxeexxe muummenaa'n wode'e ha'waan;</para>
  <para style="q2" vid="PSA 110:7">tennexxee dhanca'ee me'aan.<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="s1">Duuchchi Woddike Gootti'a Shiqqeexxa Saadino</para>
  <para style="d">Hallee luya</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1" />Hallee luya;</para>
  <para style="q1" vid="PSA 111:1">Qajeeli mannixxe songo'n isike ardixxe bukki giddo</para>
  <para style="q2" vid="PSA 111:1">Duuchchi Woddike Gootti'a mitte godobinni galata shiqishannon.<verse eid="PSA 111:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2" />Duuchchi Woddik Goottixxi huje lomoxxen;</para>
  <para style="q2" vid="PSA 111:2">ise'n gammadaak duuchchi, duuchchi wodda isee hedee heregaan.<verse eid="PSA 111:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3" />Huje isixxi ulfiniinxenna gaachchaniinxen</para>
  <para style="q2" vid="PSA 111:3">qullumma isixxinna duuchchii woddi'a hexxaaxxen.<verse eid="PSA 111:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4" />Mambe'iinxi isixxi huje qaabbatenda'n hexxaashsha asse;</para>
  <para style="q2" vid="PSA 111:4">Duuchchi Woddik Gootti ba'lakenna o'waaken.<verse eid="PSA 111:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5" />Isoo sodataakeeri'a itaachcho uwwaan;</para>
  <para style="q2" vid="PSA 111:5">kako ifixxanna duuchchii woddi'a qaabbataan.<verse eid="PSA 111:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6" />Arda ifikee wele gosaka boga uwwati</para>
  <para style="q2" vid="PSA 111:6">ifixxe hujeka lumminne arda ifikee leellisheen.<verse eid="PSA 111:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7" />Isixxe angaxxi hujuwwa dhugaatenna toggitteten;</para>
  <para style="q2" vid="PSA 111:7">ajajuwwi isik duuchchinna addateme'eeken.<verse eid="PSA 111:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8" />Barokenaa'n duuchchii woddi qico'n munnuqqi hiyyakebaan;</para>
  <para style="q2" vid="PSA 111:8">dhugaatinna toggichchummati hujeme'eeken.<verse eid="PSA 111:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9" />Isi arda ifikee'e fayyunte erge;</para>
  <para style="q2" vid="PSA 111:9">kako ifixxanna duuchchii woddi'a ajaje;</para>
  <para style="q2" vid="PSA 111:9">summi isikinna woyyichchakenna sodateme'eeken.<verse eid="PSA 111:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10" />Duuchchi Woddika Gootta sodaata</para>
  <para style="q2" vid="PSA 111:10">beekkumiike ke'iton;</para>
  <para style="q2" vid="PSA 111:10">ajaja isika muuxaak duuchchiirinna eloxxe qalbeeffachcho afe'een;</para>
  <para style="q2" vid="PSA 111:10">galati isikinna duuchchi woddi'a hedhaan.<note caller="-" style="x"><char style="xo" closed="false">111:10 </char><char style="xt" closed="false"><ref loc="JOB 28:28">Iyo. 28:28</ref>; <ref loc="PRO 1:7">Mam. 1:7</ref>; <ref loc="PRO 9:10">9:10</ref>. </char></note><verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="s1">Mageniinke Manjixxa Gammashsho</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1" />Hallee luya.</para>
  <para style="q2" vid="PSA 112:1">Duuchchi Woddika Gootta sodaataake</para>
  <para style="q2" vid="PSA 112:1">ajaja isike'ni yo'oshsha gammadaake manjixxa wodo.<verse eid="PSA 112:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2" />Horte isixxi bogi giddo hunna afe'eexxe kaddaan;</para>
  <para style="q2" vid="PSA 112:2">qajeeli mannixxi ila eebbisendaan.<verse eid="PSA 112:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3" />Karratinna qabeeni isike mini giddo hedheen;</para>
  <para style="q2" vid="PSA 112:3">isixxi qajeelummanna duuchchii woddi'a hexxaan.<verse eid="PSA 112:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4" />Isi ba'lake o'waakenna qullichchake kadeemmashshanni</para>
  <para style="q2" vid="PSA 112:4">qajeeli manjia'a dukkanna giddo ifi ifaan.<verse eid="PSA 112:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5" />Arja, ba'lummati liqeessaakeenna</para>
  <para style="q2" vid="PSA 112:5">huje ifixxa qajeelummati hujaake manji'a</para>
  <para style="q2" vid="PSA 112:5">eloxxi isi'a kaddaan.<verse eid="PSA 112:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6" />Isi duuchchi woddi'a hedheebaa'ni munnuqqi hiyya gophaammaxxee'e</para>
  <para style="q2" vid="PSA 112:6">qullichchi manji qaabbatema'nee hedhaan.<verse eid="PSA 112:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7" />Fuggoxxa oddo sodaatabaan;</para>
  <para style="q2" vid="PSA 112:7">Duuchchi Woddike Gootta'n addatati isi godoba jabaken.<verse eid="PSA 112:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8" />Isi godoba jabaken; sodaatabaan;</para>
  <para style="q2" vid="PSA 112:8">udumi uduma, ifike naaphixxa injifatema uudaan.<verse eid="PSA 112:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9" />Arjummati rakkiyyetee'e qoodeen;</para>
  <para style="q2" vid="PSA 112:9">qullumma isixxinna duuchchi woddi'a hexxaan;</para>
  <para style="q2" vid="PSA 112:9">gaachchanikinna leellee'e, quba sa'e ulfeessemaan.<note caller="-" style="x"><char style="xo" closed="false">112:9 </char><char style="xt" closed="false"><ref loc="2CO 9:9">2 Qor. 9:9</ref>. </char></note><verse eid="PSA 112:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10" />Fuggichchi manji tennee uudeexxi aaraan;</para>
  <para style="q2" vid="PSA 112:10">issotanna ga'medhaan; butti'a higgenna ba'aan;</para>
  <para style="q2" vid="PSA 112:10">fuggaaleeyyetixxi yorte oranni gattaan.<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="s1">Duuchchi Woddike Goottixxa Elle Leellishshaaka Galata</para>
  <para style="d">Hallee luya</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1" />Hallee luya.</para>
  <para style="q2" vid="PSA 113:1">Duuchchi Woddike Goottik erganjuwwi galateefatte;</para>
  <para style="q2" vid="PSA 113:1">Ee, Duuchchi Woddike Goottika summa saadde.<verse eid="PSA 113:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2" />Ta'inaa'n duuchchi woddi'a</para>
  <para style="q2" vid="PSA 113:2">Duuchchi Woddike Goottik summi saademowwaal.<verse eid="PSA 113:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3" />Arsho fuldammabaa'n aaggamaba'i qico'ni</para>
  <para style="q2" vid="PSA 113:3">Duuchchi Woddike Goottik summi saadwmowwaal.<verse eid="PSA 113:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4" />Duuchchi Woddik Gootti gosa gosake arduwwi duuchchi iimi darre quba sa'eeken,</para>
  <para style="q2" vid="PSA 113:4">gaachchanni isikinna iimuwwati iimi darren.<verse eid="PSA 113:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5" />Duuchchi Woddike Gootta no'oke Magenishsha</para>
  <para style="q2" vid="PSA 113:5">iima ifixxe moote'n ayyete ofo'leek?<verse eid="PSA 113:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6" />Iimate'ninna buttate'n hedheekaara uudatee</para>
  <para style="q2" vid="PSA 113:6">umo ifika butti'a ayyete heeshshi assaak?<verse eid="PSA 113:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7" />Isi hiyyeessa bukotenaa'n fulchaan;</para>
  <para style="q2" vid="PSA 113:7">rakkiyyetanna bululokenaa'n xungote'n fulchaan.<verse eid="PSA 113:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8" />Ja'laabuwwiinxa qixxe bakka isi'a uwwaan</para>
  <para style="q2" vid="PSA 113:8">arda isike hayyichchuwwikinna isoo ofo'lshaan.<verse eid="PSA 113:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9" />Ila affebaaxxanna mine isenge'ni galchaan;</para>
  <para style="q2" vid="PSA 113:9">gammadiinxenna oosetixxe ama isee assaan.</para>
  <para style="q1" vid="PSA 113:9">Hallee luya.<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="s1">Isira'eelik Ardi Gibtsee'n Fuleeke, Fulatike Ayyaani'a shiqqeexxa Qaabbetixxa Faaro</para>
  <para style="q1">Hallee luya</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1" />Isira'eelik ardi Gibtseen</para>
  <para style="q2" vid="PSA 114:1">Ya'iqoobixxe hortenna annafeeke lagadike ardanaa'ni fulde me'itee wodda,<note caller="-" style="x"><char style="xo" closed="false">114:1 </char><char style="xt" closed="false"><ref loc="EXO 12:51">Fula. 12:51</ref>.</char></note><verse eid="PSA 114:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2" />Yihuda galma Mageniinke</para>
  <para style="q2" vid="PSA 114:2">Isira'eelinna qadaada isike kadde.<verse eid="PSA 114:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3" />Abbaayya affe, baajje,</para>
  <para style="q2" vid="PSA 114:3">Yordaanoosinna illee iima higge.<note caller="-" style="x"><char style="xo" closed="false">114:3 </char><char style="xt" closed="false"><ref loc="EXO 14:21">Fula. 14:21</ref>; <ref loc="JOS 3:16">Iya. 3:16</ref>. </char></note><verse eid="PSA 114:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4" />Koobuwwa gedhebiinxe korbeeyyeshsha</para>
  <para style="q2" vid="PSA 114:4">tullichcuwwikinna gedhebiinke buruusishsha xerefise.<verse eid="PSA 114:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5" />Tee abbaayya ati baajetechchi</para>
  <para style="q2" vid="PSA 114:5">koo Yordaanoosi atinna illee iima higgeteechchi mayeete?<verse eid="PSA 114:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6" />Ha'no koobuwwa gedhebiinxe korbeeyyeshsha</para>
  <para style="q2" vid="PSA 114:6">tullichchuwwikinna gedhebiinke buruusishsha xereffissineechchi mayeete?<verse eid="PSA 114:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7" />Dada Duuchchike Gootti edo</para>
  <para style="q2" vid="PSA 114:7">Ya'iqoobike Mageni edo tee buttaa culphisi.<verse eid="PSA 114:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8" />Isi rassa baleesiinba'a;</para>
  <para style="q2" vid="PSA 114:8">jaxxa kinonna wodeiinxe muummeba'a jijjiireeken.<note caller="-" style="x"><char style="xo" closed="false">114:8 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Fula. 17:1-7</ref>; <ref loc="NUM 20:2-13">Lak. 20:2-13</ref>. </char></note><verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="s1">Magenokee Hasisaaka Galata</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1" />No'oxxeete kaddebaangi Ee, Duuchchi Woddike Goottaa no'oxxeete kaddebaangi</para>
  <para style="q2" vid="PSA 115:1">atixxe duuchchii woddixxe jaalalaxxeenna atixxe xuurameessummaxxe'e</para>
  <para style="q2" vid="PSA 115:1">abbo summa atikee gaachchanna uwwi.<verse eid="PSA 115:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2" />Gosa gosaki ardi</para>
  <para style="q2" vid="PSA 115:2">«Mageni insa'neek haba hedhe» maayee hiyya?<verse eid="PSA 115:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3" />No'ok Mageni iima hedheen;</para>
  <para style="q2" vid="PSA 115:3">isoo eeyyisaaxxa assaan.<verse eid="PSA 115:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4" />Insa'nexxi fakkuwwa kinni manjiinxe anganni</para>
  <para style="q2" vid="PSA 115:4">giissemeechchuwwa biretike sibiljonna worqen.<verse eid="PSA 115:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5" />Afo'o afe'eengeechchuwwan kinni haaso'aachchuwwaba'a;</para>
  <para style="q2" vid="PSA 115:5">ille afe'eengeechcuwwaan kinni afaachchuwwaba'a.<verse eid="PSA 115:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6" />Mansha afe'eengeechchuwwan kinn laqaachchuwwaba'a;</para>
  <para style="q2" vid="PSA 115:6">sano afeengeechchuwwan kinni ulataachchuwwaba'a.<verse eid="PSA 115:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7" />Anga afeengeechchuwwan kinni qaqqabaachchuwwaba'a;</para>
  <para style="q2" vid="PSA 115:7">lekka afeengeechchuwwan kinni tarkafataachchuwwaba'a;</para>
  <para style="q2" vid="PSA 115:7">bucuqqi hiyyenna laagadik haaso'aachchuwwaba'a.<verse eid="PSA 115:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8" />Konnechchuwwa giisaakiir, konnechchuwwa'n addataakiir duuchchi</para>
  <para style="q2" vid="PSA 115:8">konnechchuwwishshan kadowwaal.<note caller="-" style="x"><char style="xo" closed="false">115:8 </char><char style="xt" closed="false"><ref loc="PSA 135:15-18">Far. 135:15-18</ref>; <ref loc="REV 9:20">Wal. 9:20</ref>. </char></note><verse eid="PSA 115:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9" />Koo ha'no Isira'eelike arda Duuchchi Woddike Gootta'n addatte;</para>
  <para style="q2" vid="PSA 115:9">gargaaraakinna wonte ha'nooxxi isoten.<verse eid="PSA 115:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10" />Mageniinxi qeese, Aaroonik mini hadi Duuchchi Woddike Gootta'n addatte;</para>
  <para style="q2" vid="PSA 115:10">gargaaraakinna wonte hanooxxi isoten.<verse eid="PSA 115:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11" />Ha'no Duuchchi Woddika Gootta sodaatinaak</para>
  <para style="q2" vid="PSA 115:11">Duuchchi Woddike Gootta'n addatte;</para>
  <para style="q2" vid="PSA 115:11">gargaaraakinna wonte hanooxxi isoten.<verse eid="PSA 115:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12" />Duuchchi Woddik Gootti no'aa hedaan; no'oo eebbisaan;</para>
  <para style="q2" vid="PSA 115:12">isi Isira'eelika arda eebbisaan;</para>
  <para style="q2" vid="PSA 115:12">Aaroonika mini haddonna eebbisaan.<verse eid="PSA 115:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13" />Duuchchi Woddika Gootta sodaataka duuchcha</para>
  <para style="q2" vid="PSA 115:13">lumo shiixooka eebbisan.<note caller="-" style="x"><char style="xo" closed="false">115:13 </char><char style="xt" closed="false"><ref loc="REV 11:18">Wal. 11:18</ref>; <ref loc="REV 19:5">19:5</ref>. </char></note><verse eid="PSA 115:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14" />Duuchchi Woddik Gootti ha'noonna oose ha'nooxxa</para>
  <para style="q2" vid="PSA 115:14">eebbise'e bira sa'iso'o.<verse eid="PSA 115:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15" />Iimanna butta dadeek Duuchchi Woddik Gootti</para>
  <para style="q2" vid="PSA 115:15">ha'noo eebbiso'o.<verse eid="PSA 115:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16" />Iimuwwa Duuchchi Woddike Goottixxen;</para>
  <para style="q2" vid="PSA 115:16">butta kinni manjiinke belti'a uwwe'een.<verse eid="PSA 115:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17" />Duuchchi Woddika Gootta galateefataak reyeeke mannabaan;</para>
  <para style="q2" vid="PSA 115:17">haasonnabaaba hirreessi gidi'anna sa'aake mannabaan.<verse eid="PSA 115:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18" />Ta'anaa'n duuchchi woddi'a</para>
  <para style="q2" vid="PSA 115:18">Duuchchi Woddika Gootta galateeffantannok no'oten;</para>
  <para style="q2" vid="PSA 115:18">Duuchchi Woddik Gootti eebbisemowwaal.<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="s">Reyotenaa'n Gateek Manji, Magenokee Uuwweeka Galata</para>
  <para style="d">Hallee luya</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1" />Oodhishsha anxa laqemmaxxee</para>
  <para style="q2" vid="PSA 116:1">ani Duuchchi Woddika Gootta eeyyaannen.<verse eid="PSA 116:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2" />Isoo yee'edhanno wodda laqa'eemmaxxee</para>
  <para style="q2" vid="PSA 116:2">hedhannoke baro duuchcha'n isibaa raarannon.<verse eid="PSA 116:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3" />Reyotixxi fonxoro anee abide</para>
  <para style="q2" vid="PSA 116:3">hirreesiinxe yaaddoxxi ciiniintonna ane'ni dagge;</para>
  <para style="q2" vid="PSA 116:3">rakkotinna yaaddo anee injiffatte.<verse eid="PSA 116:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4" />Ookkone wodda, «Duuchchi Woddika Goottaa</para>
  <para style="q2" vid="PSA 116:4">lubbo anxa anjirtota'a atee soodata'eenne» hiyyenne;</para>
  <para style="q2" vid="PSA 116:4">Ee, Duuchchi Woddike Goottika summa ye'edhenne.<verse eid="PSA 116:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5" />Duuchchi Woddik Gootti ba'lakenna qullichchaken;</para>
  <para style="q2" vid="PSA 116:5">No'ok Mageni o'wi calliken.<verse eid="PSA 116:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6" />Duuchchi Woddik Gootti shaqqaka manna heqqaan;</para>
  <para style="q2" vid="PSA 116:6">lumo qico rakkate'naa'a ane'e anjireen.<verse eid="PSA 116:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7" />Tee anxe lubbo enqexxe hafuura adhdhi;</para>
  <para style="q2" vid="PSA 116:7">Duuchchi Woddik Gootti eloxxa ati'a asse'eeken.<verse eid="PSA 116:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8" />Ee, Duuchchi Woddik Gootti lubbo anxa reyotenaa'n</para>
  <para style="q2" vid="PSA 116:8">ille anxa indiddotenaa'ni,</para>
  <para style="q2" vid="PSA 116:8">lekka anxanna gugguffachchotenaa'ni gatise'een<verse eid="PSA 116:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9" />Tennexxe hedhoke mannike boga'n</para>
  <para style="q2" vid="PSA 116:9">Duuchchi Woddike Gootti edo mammarema'eennen.<verse eid="PSA 116:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10" />«Yo'oshsha rakkateennen» hiyyennexxa yanna midde</para>
  <para style="q2" vid="PSA 116:10">addateennen.<note caller="-" style="x"><char style="xo" closed="false">116:10 </char><char style="xt" closed="false"><ref loc="2CO 4:13">2 Qor. 4:13</ref>. </char></note><verse eid="PSA 116:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="PSA 116:11" />Alayyokenaa'ni kexxeexxa</para>
  <para style="q2" vid="PSA 116:11">«Manni duuchchi dharichchaken» hiyyenne.<verse eid="PSA 116:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12" />Ani'a asseexxe duuchchi'a</para>
  <para style="q2" vid="PSA 116:12">Duuchchi Woddike Gootti'a bado maa hissanno?<verse eid="PSA 116:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13" />Anjiretixxa buuda iimi'a abidannon;</para>
  <para style="q2" vid="PSA 116:13">Duuchchi Woddike Goottika summanna ye'edhannon.<verse eid="PSA 116:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14" />Isike ardi duuchchi edo</para>
  <para style="q2" vid="PSA 116:14">Duuchchi Woddike Gootti'a weereega anka muuxannon.<verse eid="PSA 116:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15" />Qulliyyetixxi reyo Duuchchi Woddike Gootti edo</para>
  <para style="q2" vid="PSA 116:15">ulfaate'eexxen.<verse eid="PSA 116:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16" />Ee, Duuchchi Woddike Gootaa, dhugaaten, ani atike erganjon</para>
  <para style="q2" vid="PSA 116:16">ani atixxe garbitek belti atike garbichchan;</para>
  <para style="q2" vid="PSA 116:16">haachchabiinke usurnaa'n anee tikkeeten.<verse eid="PSA 116:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17" />Ani ati'a galatiinka tolcha uwwannon;</para>
  <para style="q2" vid="PSA 116:17">Duuchchi Woddike Goottika summanna ye'edhannon.<verse eid="PSA 116:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18" />Isike ardixxe bukki edo</para>
  <para style="q2" vid="PSA 116:18">Duuchchi Woddike Gootti'a weereega anka uwwannon.<verse eid="PSA 116:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19" />Tee Iyyerusaalemi tennexxee ati giddo</para>
  <para style="q2" vid="PSA 116:19">Duuchchi Woddike Goottike minixxe baxxe'n assannon</para>
  <para style="q1" vid="PSA 116:19">Hallee luya.<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="s">Magenokee Shiqeeka Galata</para>
  <para style="d">Hallee luya</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1" />Gosa gosak ardi Duuchchi Woddika Gootta saadde;</para>
  <para style="q2" vid="PSA 117:1">ardi duuchchinna isoo galateeffatte.<note caller="-" style="x"><char style="xo" closed="false">117:1 </char><char style="xt" closed="false"><ref loc="ROM 15:11">Rom. 15:11</ref>. </char></note><verse eid="PSA 117:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2" />Isi no'aa afeexxi jaalala jabaxxe kaddeemmaxxee,</para>
  <para style="q2" vid="PSA 117:2">Duuchchi Woddike Goottixxi xuurameesummanna duuchchi woddixxen.</para>
  <para style="b" vid="PSA 117:2" />
  <para style="q1" vid="PSA 117:2">Hallee luya.<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="s">Mageniinxe Injjiffachcho'a Shiqeexxa Galatatiinxa Soodachcho</para>
  <para style="s2">Hallee luya</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1" />Duuchchi Woddik Gootti eloke kadeemmaxxee isoo galateeffatte;</para>
  <para style="q2" vid="PSA 118:1">jaalala isixxinna duuchchi woddixxen.<note caller="-" style="x"><char style="xo" closed="false">118:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 Odo. 16:34</ref>; <ref loc="2CH 5:13">2 Odo. 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Izr. 3:11</ref>; <ref loc="PSA 100:5">Far. 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Erm. 33:11</ref>. </char></note><verse eid="PSA 118:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2" />Isira'eelik ardi</para>
  <para style="q2" vid="PSA 118:2">«Jaalala isixxinna duuchchi woddixxen» hiyyowwaal.<verse eid="PSA 118:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3" />Aaroonixxi oose</para>
  <para style="q2" vid="PSA 118:3">«Jaalala isixxi duuchchi woddixxen» hitowwaal.<verse eid="PSA 118:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4" />Duuchchi Woddika Gootta sodaataakiir duuchchi</para>
  <para style="q2" vid="PSA 118:4">«Jaalala isixxi duuchchi woddixxen» hiyyowwaal.<verse eid="PSA 118:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5" />Rakkate wixxixxi hiyyeennexxa yanna, Duuchchi Woddika Gootta ye'edhenne;</para>
  <para style="q2" vid="PSA 118:5">Duuchchci Woddik Goottinna heeyye;</para>
  <para style="q2" vid="PSA 118:5">ba'laba'aanna anee fulche.<verse eid="PSA 118:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6" />Duuchchi Woddik Gootti aninni welti hedheen sodaatabe'no;</para>
  <para style="q2" vid="PSA 118:6">manji ani'a maassa?<note caller="-" style="x"><char style="xo" closed="false">118:6 </char><char style="xt" closed="false"><ref loc="HEB 13:6">Ibr. 13:6</ref>. </char></note><verse eid="PSA 118:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7" />Duuchchi Woddik Gootti anee gargaaro'a aninni welti hedheen;</para>
  <para style="q2" vid="PSA 118:7">aninna anke naaphiixxa iba uudannon.<verse eid="PSA 118:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8" />Manjo irko assedha mannii'n</para>
  <para style="q2" vid="PSA 118:8">Duuchchi Woddika Gootta addata woyyan;<verse eid="PSA 118:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9" />Jajjabba manna'ni irkata mannii'n</para>
  <para style="q2" vid="PSA 118:9">Duuchchi Woddike Gootta'n addata woyyan.<verse eid="PSA 118:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10" />Gosa gosak manni anee buqeen</para>
  <para style="q2" vid="PSA 118:10">yaane kinni Duuchchi Woddike Goottike summinni insa'nee injiffatenne.<verse eid="PSA 118:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11" />Insa'ne ori orii'n bunqammashshanni anee bunqeen</para>
  <para style="q2" vid="PSA 118:11">yaane kinni Duuchchi Woddike Goottike summinni insa'nee kutti assennen.<verse eid="PSA 118:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12" />Kiniisiinsha ane'ni heessine</para>
  <para style="q2" vid="PSA 118:12">yaane kinni huurinxe giirashsha ikki woddi gubaante;</para>
  <para style="q2" vid="PSA 118:12">Duuchchi Woddike Goottike summinninna insa'nee injiffatenne.<verse eid="PSA 118:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13" />Dhiibeme ibonna'a gataantarenne;</para>
  <para style="q2" vid="PSA 118:13">yaane kinni Duuchchi Woddik Gootti anee gargaare.<verse eid="PSA 118:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14" />Duuchchi Woddik Gootti hunna anxenna faaro anxen;</para>
  <para style="q2" vid="PSA 118:14">anjirallo anke kade'een.<note caller="-" style="x"><char style="xo" closed="false">118:14 </char><char style="xt" closed="false"><ref loc="EXO 15:2">Fula. 15:2</ref>; <ref loc="ISA 12:2">Isa. 12:2</ref>. </char></note><verse eid="PSA 118:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15" />Qulliyyetike duunkaan giddo laqqendaaxxi illilleetenna gammashotik canci hiyyaa qici,</para>
  <para style="q2" vid="PSA 118:15">«Duuchchi Woddike Goottixxi middixxi anga jabaxxe huje hujje'een!<verse eid="PSA 118:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16" />Duuchchi Wddike Goottixxi middixxi anga xungo gelte'een;</para>
  <para style="q2" vid="PSA 118:16">Duuchchi Woddike Goottixxi middixxi anga jabbaxxe huje huje'een.»<verse eid="PSA 118:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17" />Lubbo gatee'e hedhoti hedhanno malee reyabe'non;</para>
  <para style="q2" vid="PSA 118:17">Duuchchi Woddike Goottixxa hujenna haaso'annon.<verse eid="PSA 118:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18" />Duuchchi woddik Gootti jaba qicinni anee xixeen;</para>
  <para style="q2" vid="PSA 118:18">yanne kinni reyona'a anee waalebaan.<verse eid="PSA 118:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19" />Giddi'a e'ye'e Duuchchi Woddika Gootta galateeffatonna'a</para>
  <para style="q2" vid="PSA 118:19">qullummatixxa huluwwa ani'a bane.<verse eid="PSA 118:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20" />Tinni Duuchchi Woddike Goottixxe hulan;</para>
  <para style="q2" vid="PSA 118:20">qulliyyetinna isee'n e'yitaan.<verse eid="PSA 118:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21" />Ani'a heete'eetaxxee,</para>
  <para style="q2" vid="PSA 118:21">anee anjirte'eetaxxeenna atee galateeffata'eennen.<verse eid="PSA 118:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22" />Ijaarammak manni tufateemmak kinji</para>
  <para style="q2" vid="PSA 118:22">isi dhaaddotike kinjo kade.<note caller="-" style="x"><char style="xo" closed="false">118:22 </char><char style="xt" closed="false"><ref loc="LUK 20:17">Luq. 20:17</ref>; <ref loc="ACT 4:11">Erga. Huj. 4:11</ref>; <ref loc="1PE 2:7">1 Phex. 2:7</ref>. </char></note><verse eid="PSA 118:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23" />Duuchchi Woddik Gootti tenne asseen;</para>
  <para style="q2" vid="PSA 118:23">isenna ille no'oxxe'ni mambe'aken.<note caller="-" style="x"><char style="xo" closed="false">118:23 </char><char style="xt" closed="false"><ref loc="MAT 21:42">Mat. 21:42</ref>; <ref loc="MRK 12:10-11">Mar. 12:10-11</ref>. </char></note><verse eid="PSA 118:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24" />Duuchchi Woddik Gootti hucceexxi barra tenneten;</para>
  <para style="q2" vid="PSA 118:24">ise'ninna gammando; illillinso.<verse eid="PSA 118:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25" />Ee, Duuchchi Woddike Goottaa; maganneten no'oo anjir;</para>
  <para style="q2" vid="PSA 118:25">Ee, Duuchchi Wodike Goottaa! maganneten yaane no'aa qabbaashsha assi.<note caller="-" style="x"><char style="xo" closed="false">118:25 </char><char style="xt" closed="false"><ref loc="MAT 21:9">Mat. 21:9</ref>; <ref loc="MRK 11:9">Mar. 11:9</ref>; <ref loc="JHN 12:3">Yoh. 12:3</ref>. </char></note><verse eid="PSA 118:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26" />Duuchchi Woddike Goottike summinni dagaak eebbisemeeke kadowwaal</para>
  <para style="q2" vid="PSA 118:26">Duuchchi Woddike Goottike galmi giddo he'nee ha'noo eebbinseenen.<note caller="-" style="x"><char style="xo" closed="false">118:26 </char><char style="xt" closed="false"><ref loc="MAT 21:9">Mat. 21:9</ref>; <ref loc="MAT 23:39">23:39</ref>; <ref loc="MRK 11:9">Mar. 11:9</ref>; <ref loc="LUK 13:35">Luq. 13:35</ref>; <ref loc="LUK 19:38">19:38</ref>; <ref loc="JHN 12:13">Yoh. 12:13</ref>. </char></note><verse eid="PSA 118:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27" />Duuchchi Woddik Gootti Magenoken;</para>
  <para style="q2" vid="PSA 118:27">ifika ifanna no'o'ni ifise;</para>
  <para style="q2" vid="PSA 118:27">tolchimalchiinke gaaffuwwi qico'n marati,</para>
  <para style="q1" vid="PSA 118:27">Shafiinxa damuwwa adhitine'e ayyaana ulfeesaake manninni makemme.<verse eid="PSA 118:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28" />Ati Mageno anke kaddeettaxxee'e ani atee galteeffata'eennen;</para>
  <para style="q2" vid="PSA 118:28">ati Mageno anken ani atee kubbisa'eennen.<verse eid="PSA 118:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29" />Eloke kadeemmaxxee Duuchchi Woddika Gootta galateeffatte;</para>
  <para style="q2" vid="PSA 118:29">jaalala isixxinna duuchchi woddixxen.<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="s1">Alef</para>
  <para style="s1">Mageniinka Seera</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1" />Me'aake ora'n hamatemabaake,</para>
  <para style="q2" vid="PSA 119:1">Duuchchi Woddike Goottike seerishsha galaake mannixxa wodo.<verse eid="PSA 119:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2" />Dhugaa isixxa heqqedhaake,</para>
  <para style="q2" vid="PSA 119:2">mitte godobinni isoo yoraake mannixxa wodo.<verse eid="PSA 119:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3" />Insa'ne xaqaro assinabaan;</para>
  <para style="q2" vid="PSA 119:3">yaane kinni ora isike'ni me'inaan.<verse eid="PSA 119:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4" />Xonxoommante'e seera atika heqqe'nannoshsha</para>
  <para style="q2" vid="PSA 119:4">ati ajaje'eeten.<verse eid="PSA 119:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5" />Seera atika heqqedhatike ora'n jabaate'e urre'eennele</para>
  <para style="q2" vid="PSA 119:5">hittatta eeyana'a!<verse eid="PSA 119:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6" />Ajaja atike'n ille uggonnole</para>
  <para style="q2" vid="PSA 119:6">ookkone wodda salphatabe'non.<verse eid="PSA 119:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7" />Atixxe qullummaxxa murte baratonnole</para>
  <para style="q2" vid="PSA 119:7">mitte godobinni atee galateeffatannon.<verse eid="PSA 119:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8" />Seera atika heqqedhannon</para>
  <para style="q2" vid="PSA 119:8">haranga anee waaldoxxe'e.<verse eid="PSA 119:8" /></para>
  <para style="s1">Beeti</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9" />Ka'umi ora ifika hitta ca'ummati heqqedhaa?</para>
  <para style="q2" vid="PSA 119:9">Ajaja atikishsha galatiten.<verse eid="PSA 119:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10" />Mitte godobinni atee halse'eennen</para>
  <para style="q2" vid="PSA 119:10">seera atikenaa'n bayyatannoshsha assittoxxe'e<verse eid="PSA 119:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11" />Atee balleessabe'noshsha</para>
  <para style="q2" vid="PSA 119:11">hiyyichcho atika godoba uggudheenne.<verse eid="PSA 119:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12" />Ee, Duuchchi Woddike Goottaa! Ati saaddende'eeteken</para>
  <para style="q2" vid="PSA 119:12">seera atika anee barachchiisi.<verse eid="PSA 119:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13" />Afo'o atikenaa'ni fula'neeka seera duuchcha</para>
  <para style="q2" vid="PSA 119:13">arabbo ankenni haaso'annon.<verse eid="PSA 119:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14" />Manji karratixxe bira sa'ne'ni gammadammashsanni</para>
  <para style="q2" vid="PSA 119:14">dhugga atixxa hordofa anee gammachchiise'een.<verse eid="PSA 119:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15" />Ajaja atika hiissee alalchannon;</para>
  <para style="q2" vid="PSA 119:15">ora atike'ni ille uggudhanon.<verse eid="PSA 119:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16" />Seera atike'ni gammadonnole,</para>
  <para style="q2" vid="PSA 119:16">hiyyichcho atikanna dedhabe'no.<verse eid="PSA 119:16" /></para>
  <para style="s1">Gaameel</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17" />Hedhoti hedhonna'a, hiyyichcho atikanna heqqedhonna'a</para>
  <para style="q2" vid="PSA 119:17">anee erganjo atike'e eloxxa assi.<verse eid="PSA 119:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18" />Seera atikenaa'n mambe'a yaane uudonna'a</para>
  <para style="q2" vid="PSA 119:18">ille anee baqqi assi.<verse eid="PSA 119:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19" />Ani buttate'n keessummaten</para>
  <para style="q2" vid="PSA 119:19">ajajuwwa atika anenaa'ni shoxxoxxe'e.<verse eid="PSA 119:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20" />Duuchchi wodda ajaja atika yorati</para>
  <para style="q2" vid="PSA 119:20">lubbo anxi wexeqenda.<verse eid="PSA 119:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21" />Ajajuwwa atikenaa'ni fuleekanna</para>
  <para style="q2" vid="PSA 119:21">badinemeeka manna xixxaton.<verse eid="PSA 119:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22" />Dhugaa atixxa heqqedhennen</para>
  <para style="q2" vid="PSA 119:22">yowwichchchokanna tuffe anenaa'n bayyisi.<verse eid="PSA 119:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23" />Galchalluwwi ofo'le anee hamatoolenna midde</para>
  <para style="q2" vid="PSA 119:23">ani erganji atik seera atika hige higee qaabbatannon.<verse eid="PSA 119:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24" />Dhugaa atixxi anxe gammashshon;</para>
  <para style="q2" vid="PSA 119:24">anxe gorsallon.<verse eid="PSA 119:24" /></para>
  <para style="s1">Daaleexxi</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25" />Injifatemee'e bukote'ni ibeennen;</para>
  <para style="q2" vid="PSA 119:25">hiyyichcho atikishsha anee hedhoke assi.<verse eid="PSA 119:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26" />Ora anka duuchcha ate'n farri asse kule'eennen;</para>
  <para style="q2" vid="PSA 119:26">atinna hiissichcho ani'a uuteten</para>
  <para style="q2" vid="PSA 119:26">seera atika anee barachchiis.<verse eid="PSA 119:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27" />Seera atikixxa barrachcho qalbeefatannoshsha assi;</para>
  <para style="q2" vid="PSA 119:27">aninna mambe'iinxa atixxa huje higgeggeenni qaabbatannon.<verse eid="PSA 119:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28" />Lubbo anxi yaadoti wexeqende;</para>
  <para style="q2" vid="PSA 119:28">atike hiyyichchishsha anee jabeessi.<verse eid="PSA 119:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29" />Sobiinka ora anenaa'n bayyisi;</para>
  <para style="q2" vid="PSA 119:29">badhaadha atikanna seera atika anee barachchiis.<verse eid="PSA 119:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30" />Ani dhugaatike ora melledhe'eennen;</para>
  <para style="q2" vid="PSA 119:30">seera atikanna kallachchii edo uggudhe'eennen.<verse eid="PSA 119:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31" />Ee, Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 119:31">Dhugaa atixxe'ni maxxane'eennen</para>
  <para style="q2" vid="PSA 119:31">shookannoshsha anee assitoxxe'e.<verse eid="PSA 119:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32" />Qalbeeffachcho ani'a uutetaxxee'e</para>
  <para style="q2" vid="PSA 119:32">atike ajajuwwike ora'ni gonga'eennen.<verse eid="PSA 119:32" /></para>
  <para style="s1">Hee</para>
  <para style="s">Qalbeeffachchotixxa Soodachcho</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33" />Ee, Duuchchi Woddike Goottaa! Atike ajajuwwika ora anee barachchiis;</para>
  <para style="q2" vid="PSA 119:33">aninna muuxamii qico'ni isoo heqqedhannon.<verse eid="PSA 119:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34" />Seera atika heqqedhannoshsha, mitte godobinninna isi'a ajajemannoshsha</para>
  <para style="q2" vid="PSA 119:34">qalbeeffachcho ani'a uwwi.<verse eid="PSA 119:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35" />Ajajuwwi atik anee eeyiseemmaxxee'e</para>
  <para style="q2" vid="PSA 119:35">atike ajajuwwike ora'ni anee akeek.<verse eid="PSA 119:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36" />Duroomatatee'e haafemati irra</para>
  <para style="q2" vid="PSA 119:36">seera atika muuxatixxi yorte ane'n hexxaashsha assi.<verse eid="PSA 119:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37" />Toliincho ille anxi uudabaashsha anee heqqi;</para>
  <para style="q2" vid="PSA 119:37">atike ora'n hedho anxa uki.<verse eid="PSA 119:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38" />Sodaatendattoshsha</para>
  <para style="q2" vid="PSA 119:38">erganjo atikee'e aaggettexxa kako muuxi.<verse eid="PSA 119:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39" />Murte atixxi eloxxe kaddeemmaxxee'e</para>
  <para style="q2" vid="PSA 119:39">sodaatanneke salphinenaa'ni anee heqqi.<verse eid="PSA 119:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40" />Kunse, ajajuwwa atika haalche'eennen</para>
  <para style="q2" vid="PSA 119:40">qullumma atixxenni hedho anxa uki.<verse eid="PSA 119:40" /></para>
  <para style="s">Waawu</para>
  <para style="s">Duuchchi Woddike Goottike Seera'ni Addachcho</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41" />Ee, Duuchchi Woddike Goottaa! Jaalala atixxi ani'a daggowwaal;</para>
  <para style="q2" vid="PSA 119:41">hiyyichcho atikishshanni anee anjir.<verse eid="PSA 119:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42" />Hiyyichcho atike'n amaneennaxxee</para>
  <para style="q2" vid="PSA 119:42">anee yowwaakeeri'a hiissichcho uwwannon.<verse eid="PSA 119:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43" />Murte atixxe'ni addateennaxxee</para>
  <para style="q2" vid="PSA 119:43">dhuggatika hiyyichcho afo'o ankenaa'ni haranga bayyissoxxe'e.<verse eid="PSA 119:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44" />Baro baro'ni duuchchi woddi'a</para>
  <para style="q2" vid="PSA 119:44">seera atika heqqedhannon.<verse eid="PSA 119:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45" />Ajajuwwa atika halseennaxxee'e</para>
  <para style="q2" vid="PSA 119:45">ba'latee me'annon.<verse eid="PSA 119:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46" />Dhugaa atixxa moyanjuwwii edo haaso'annon;</para>
  <para style="q2" vid="PSA 119:46">haranga shookabe'non.<verse eid="PSA 119:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47" />Ajaajuwwa atika eeya'eennaxxee</para>
  <para style="q2" vid="PSA 119:47">iso'ni gammadannon.<verse eid="PSA 119:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48" />Eeyeenneke atike ajajuwwibaa ulfeesanen;</para>
  <para style="q2" vid="PSA 119:48">atike seerixxeenna hige higee qabbatannon.<verse eid="PSA 119:48" /></para>
  <para style="s1">Zayi</para>
  <para style="s1">Duuchchi Woddike Goottike Seera'ni Addata</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49" />Erganjo atikee aaggetexxa kako qaabati;</para>
  <para style="q2" vid="PSA 119:49">hiyyichchi atik anee hedhotike asse'een.<verse eid="PSA 119:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50" />Atik haaso'i anee lubbo uggaammaxxee</para>
  <para style="q2" vid="PSA 119:50">tinni rakko anke jabeennen.<verse eid="PSA 119:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51" />Hollaameeyye lumo qico ane'n gacifatte;</para>
  <para style="q2" vid="PSA 119:51">yaane kinni ani seera atikenaa'ni mishikki hiyabe'non.<verse eid="PSA 119:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52" />Ee, Duuchchi Woddike Goottaa! Olmiinaa'ni hexxemmaxxa</para>
  <para style="q2" vid="PSA 119:52">atixxa murte qaabbatenne wodda jabaatenne.<verse eid="PSA 119:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53" />Atika seera waldeexxe fuggaaleeyyenaa'ni kexxeexxa</para>
  <para style="q2" vid="PSA 119:53">aare gubatenne.<verse eid="PSA 119:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54" />Keessummumma hedhenneke boga'ni</para>
  <para style="q2" vid="PSA 119:54">seeri atik anxe faaron.<verse eid="PSA 119:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55" />Ee, Duuchchi Woddike Goottaa! Hashsha summa atika qaabbatanno;</para>
  <para style="q2" vid="PSA 119:55">seera atikanna heqqedhanno.<verse eid="PSA 119:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56" />Ajaaja atika halsenne;</para>
  <para style="q2" vid="PSA 119:56">tinni huje anxe kaddeen.<verse eid="PSA 119:56" /></para>
  <para style="s1">Heeti</para>
  <para style="s1">Duuchchi Woddike Goottike Seeri'a Ajajensha</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57" />Ee, Duuchchi Woddik Gootti qoobbo anken</para>
  <para style="q2" vid="PSA 119:57">seera atike'ni galonna'aa mudhdheennen.<verse eid="PSA 119:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58" />Alba farri hiyyeekenni aniba'aa uuddottaa'a</para>
  <para style="q2" vid="PSA 119:58">mitte goddobinni atee halsaannen;</para>
  <para style="q2" vid="PSA 119:58">atike hiyyichchishshanni anee maraaran.<verse eid="PSA 119:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59" />Ora anka qorqodheennen</para>
  <para style="q2" vid="PSA 119:59">me'aa anxanna atixxe dhugaaba'a wirri assedheennen.<verse eid="PSA 119:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60" />Seera atika heqqedhonna'a</para>
  <para style="q2" vid="PSA 119:60">hoxemmeennen, rincico'ebe'non.<verse eid="PSA 119:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61" />Fuggaaleeyye wodaro ani'a xaxxe;</para>
  <para style="q2" vid="PSA 119:61">ani kinni seera atika dedhabe'no.<verse eid="PSA 119:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62" />Atixxe qullitte murtexxee'e</para>
  <para style="q2" vid="PSA 119:62">hashsha wodhakka atee galateeffatonna'a ke'annon.<verse eid="PSA 119:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63" />Ani atee sodataake duuchchi'a</para>
  <para style="q2" vid="PSA 119:63">ajajuwwa atikaranna heqqedhaakeerike jaalon.<verse eid="PSA 119:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64" />Ee, Duuchchi Woddike Goottaa! Maraarte atixxi butta duuchcha'n wo'mite'een</para>
  <para style="q2" vid="PSA 119:64">seera atikanna anee barachchiis.<verse eid="PSA 119:64" /></para>
  <para style="s">Xeeti</para>
  <para style="s">Duuchchi Woddike Goottike Seerika Ulfinna</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65" />Ee, Duuchchi Woddike Goottaa! Atike hiyyichchishshanni</para>
  <para style="q2" vid="PSA 119:65">erganjo atikee eloxxa asite'eeten.<verse eid="PSA 119:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66" />Ajajuwwa atike'ni addateennaxxee</para>
  <para style="q2" vid="PSA 119:66">eloxxa qalbeeffachchonna ege'na anee barachchiis.<verse eid="PSA 119:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67" />Rakkatebe'no edo ora ba'ee me'eenne;</para>
  <para style="q2" vid="PSA 119:67">ta'a kinni hiyyichcho atika heqqedhanno.<verse eid="PSA 119:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68" />Ati eloken; assitatoxxinna eloxxen</para>
  <para style="q2" vid="PSA 119:68">seera atikanna anee barachchiis.<verse eid="PSA 119:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69" />Hollaameeyye dharik summa anee balleessite;</para>
  <para style="q2" vid="PSA 119:69">ani kinni seera atika mitte godobinni heqqedhanno.<verse eid="PSA 119:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70" />Insa'ne godoba jabakenna dillo'eeke mannan;</para>
  <para style="q2" vid="PSA 119:70">ani kinni seera atike'n gammadannon.<verse eid="PSA 119:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71" />Seera atika baratonna'a</para>
  <para style="q2" vid="PSA 119:71">rakkatema ani'a eloxxe kadde.<verse eid="PSA 119:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72" />Kuma worqenna biretike sibilji caala</para>
  <para style="q2" vid="PSA 119:72">atike afo'ika haaso'a ani'a woyya.<verse eid="PSA 119:72" /></para>
  <para style="s">Yoodi</para>
  <para style="s">Duuchchi Woddike Goottike Seerixxa Qullumma</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73" />Anga atixxi anee loobbe'e giisiteen;</para>
  <para style="q2" vid="PSA 119:73">ajaja atika baratonna'a qalbeeffachcho ani'a uwwi.<verse eid="PSA 119:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74" />Hiyyichcho atike'n addateennaxxee</para>
  <para style="q2" vid="PSA 119:74">ate'e sodaataaki duuchchi anee uudee gammadaan.<verse eid="PSA 119:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75" />Ee, Duuchchi Woddike Goottaa! atixxi murte qullitteten,</para>
  <para style="q2" vid="PSA 119:75">anee xixxetelchinna xuurameesxummatite kaddeexxa ege'nenne.<verse eid="PSA 119:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76" />Atike erganjo'ni addachchiisse'e haasoteteshshanni</para>
  <para style="q2" vid="PSA 119:76">jaalala atixxi anee jabeessitowwaal.<verse eid="PSA 119:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77" />Seeri atik gammado anke kadeemmaxxee</para>
  <para style="q2" vid="PSA 119:77">hedhoti hedhonna'a jaalala atixxi ani'a daggowwaal.<verse eid="PSA 119:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78" />Hollameeyye tola boddichcha ane'ni miidhema geessisseemmaxxee'e salphattowwaal;</para>
  <para style="q2" vid="PSA 119:78">ani kinni ajajuwwa atika higgeggeen qaabbatannon.<verse eid="PSA 119:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79" />Atee sodaataakiir,</para>
  <para style="q2" vid="PSA 119:79">dhugaa atixxanna ege'neek manni aniba'a higowwaal.<verse eid="PSA 119:79" /></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80" />Salphatabe'noshsha</para>
  <para style="q2" vid="PSA 119:80">ani mitte godobinni seera atike'n toggi hiyye galo.<verse eid="PSA 119:80" /></para>
  <para style="s">Kaafi</para>
  <para style="s">Anjirematee'e Shiqqeexxa Soodachcho</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81" />Lubbo anxi anjira atixxa lumo qico yorte;</para>
  <para style="q2" vid="PSA 119:81">haaso'a atikanna addateennen.<verse eid="PSA 119:81" /></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82" />«Haano anee jajjabeessitato?» hiyya'n</para>
  <para style="q2" vid="PSA 119:82">haaso'a atika heqqedhaa'naa'n ille anee gophphe.<verse eid="PSA 119:82" /></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83" />Wiliillete'n fansendeexxe woyintixxa qalqallo, labonnolenna</para>
  <para style="q2" vid="PSA 119:83">seera atika dedhabe'non.<verse eid="PSA 119:83" /></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84" />Atike garbichchik bari hiteeke?</para>
  <para style="q2" vid="PSA 119:84">Anee shorredha'neeke manna'ni haano murtatto?<verse eid="PSA 119:84" /></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85" />Seera atikishsha hexxabaaxxi hollaameeyye</para>
  <para style="q2" vid="PSA 119:85">bale ibannoxxa ani'a qotte.<verse eid="PSA 119:85" /></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86" />Ajaaji atik duuchchi addateme'eeken;</para>
  <para style="q2" vid="PSA 119:86">manni tola boddichcha anee shorredheen, anee gargaar.<verse eid="PSA 119:86" /></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87" />Buttatenaa'n anee balleessino'a heenoxxe yanna gate'eemman;</para>
  <para style="q2" vid="PSA 119:87">ani kinni atika ajajuwwa waalabe'non.<verse eid="PSA 119:87" /></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88" />Jaalala atixxenni lubbo anee uki;</para>
  <para style="q2" vid="PSA 119:88">aninna atike afo'ika haaso'a heqqedhannon.<verse eid="PSA 119:88" /></para>
  <para style="s">Laameedi</para>
  <para style="s">Duuchchi Woddike Goottike Seera'n Addata</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89" />Ee, Duuchchi Woddike Goottaa! Haaso'i atik iimate'n</para>
  <para style="q2" vid="PSA 119:89">duuchchi woddi'a dhugaaten.<verse eid="PSA 119:89" /></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90" />Xuurameessumma atixxi ilatenaa'ni ilati qico'ni hexxaaxxen;</para>
  <para style="q2" vid="PSA 119:90">ati butta, jaabeessite'e ofo'lshe'eeten;</para>
  <para style="q2" vid="PSA 119:90">isenna hexxaan.<verse eid="PSA 119:90" /></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91" />Duuchchiinxi dada ati'a ajajendaammaxxe'ee</para>
  <para style="q2" vid="PSA 119:91">seera atikishshanni telchi qco'n hexxeen.<verse eid="PSA 119:91" /></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92" />Seeri atik gammado anke kada gopheele,</para>
  <para style="q2" vid="PSA 119:92">wixixxii anxenaa'ni kexxeexxa silaati ba'eennan.<verse eid="PSA 119:92" /></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93" />Isinni lubbo anee ukkeettaxxee'e</para>
  <para style="q2" vid="PSA 119:93">ajajuwwa atika haranga dedhabe'non.<verse eid="PSA 119:93" /></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94" />Ajajuwwa atika halseennaxxee'e</para>
  <para style="q2" vid="PSA 119:94">ani atiken, anee anjir balloo.<verse eid="PSA 119:94" /></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95" />Fuggaaleeyye anee balleessito'aa gaada'neen;</para>
  <para style="q2" vid="PSA 119:95">ani kinni seera atika higgeggeenni qaabbatannon.<verse eid="PSA 119:95" /></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96" />Duuchchiinxe yaane ifi ifinga muuxama affe'eexxa afenne;</para>
  <para style="q2" vid="PSA 119:96">ajajuwwi atik kinni gabala afebaan.<verse eid="PSA 119:96" /></para>
  <para style="s">Meemi</para>
  <para style="s">Duuchchi Woddike Goottika Seera Eeyyaa</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97" />Ani seera atika hittatta eeyyenne!</para>
  <para style="q2" vid="PSA 119:97">Isoonna barra duuchcha higgeggeenni qaabbatannon.<verse eid="PSA 119:97" /></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98" />Ajajai atik anibrii'ni qo'aa gophaammaxxee'e</para>
  <para style="q2" vid="PSA 119:98">isi naapha anki caala anee'e qalbeefatannoke asse.<verse eid="PSA 119:98" /></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99" />Dhugaa atixxa higgeggeenn qaabbataannaxxee'e</para>
  <para style="q2" vid="PSA 119:99">anke barachchiisalluwwi caala qalbeefataannen.<verse eid="PSA 119:99" /></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100" />Ani ajajuwwa atika muuxaannaxxee'e,</para>
  <para style="q2" vid="PSA 119:100">geedheti caala qalbeefatannoke kadennen.<verse eid="PSA 119:100" /></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101" />Haaso'a atika heqqedhonna'a</para>
  <para style="q2" vid="PSA 119:101">lekka anxa fuggoke ora duuchchanaa'n hoyyedhenne.<verse eid="PSA 119:101" /></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102" />Atinni umo atikenni anee barachchiiseettaxxee'e</para>
  <para style="q2" vid="PSA 119:102">atixxe murtenaa'n gorebe'non.<verse eid="PSA 119:102" /></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103" />Hiyyichchi atiki hittatta xe'maake!</para>
  <para style="q2" vid="PSA 119:103">Malebiinxe la'ee irra xa'ma'neeken.<verse eid="PSA 119:103" /></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104" />Ajajuwwa atikenni qalbeeffachcho alfenne;</para>
  <para style="q2" vid="PSA 119:104">tennexxee'e dhariinka ora duuchcha jibbenne.<verse eid="PSA 119:104" /></para>
  <para style="s">Nooni</para>
  <para style="s">Duuchchi Woddike Goottike Seerika Ifa</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105" />Seeri atik lekka anxee xassake;</para>
  <para style="q2" vid="PSA 119:105">ora ankeenna ifaken.<verse eid="PSA 119:105" /></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106" />Qullummatika atika seera heqqedhonna'a</para>
  <para style="q2" vid="PSA 119:106">kakate'eennen; iso'ninna jabaatannon.<verse eid="PSA 119:106" /></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107" />Ee, Duuchchi Woddike Goottaa! Lomoshsha rakkate'eennen,</para>
  <para style="q2" vid="PSA 119:107">haaso'a atikishsha anee lubbo uki.<verse eid="PSA 119:107" /></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108" />Ee, Duuchchi Woddike Goottaa! Eeyye uwwaanneka anke afo'ike galatika tolcha adhdhi;</para>
  <para style="q2" vid="PSA 119:108">seera atikanna anee barachchiis.<verse eid="PSA 119:108" /></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109" />Lubbo anxi duuchchi wodda rakko giddo hexxeen;</para>
  <para style="q2" vid="PSA 119:109">ani kinni seera atika dedhabe'non.<verse eid="PSA 119:109" /></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110" />Fuggaaleeyye fonxoro ani'a falte;</para>
  <para style="q2" vid="PSA 119:110">ani kinni ajajuwwa atikenaa'n gorebe'non.<verse eid="PSA 119:110" /></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111" />Anxe qalbexxe gammashsho kaddeemmaxxee</para>
  <para style="q2" vid="PSA 119:111">dhugaa atixxi duuchchi woddixxe anxe karran.<verse eid="PSA 119:111" /></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112" />Baro baro'n, duuchchi woddi'a</para>
  <para style="q2" vid="PSA 119:112">seera atika heqqedhonna'a isibaa godobik mudhdheennen.<verse eid="PSA 119:112" /></para>
  <para style="s">Saamkeeti</para>
  <para style="s">Duuchchi Woddike Goottike Seernaa'n Afendaaxxa La'o</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113" />Elqe kayyi'a daaqaaka manna jibbenne;</para>
  <para style="q2" vid="PSA 119:113">seera atika kinni eeyyenne.<verse eid="PSA 119:113" /></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114" />Ati anke gollanna anxe wonten;</para>
  <para style="q2" vid="PSA 119:114">haaso'a atikanna addatee heqqedhannon.<verse eid="PSA 119:114" /></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115" />Anke Magenika ajajuwwa heqqedhonna'a</para>
  <para style="q2" vid="PSA 119:115">ha'noo fuggoxxa assitnaak anenaa'ni bayyatte.<verse eid="PSA 119:115" /></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116" />Haaso'a atikishshanni anee kiphi; lubbotinna hedhannon;</para>
  <para style="q2" vid="PSA 119:116">addetanna gophe'e shookannoke assitoxxe'e.<verse eid="PSA 119:116" /></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117" />Fayyonnaa ane'e gargaar;</para>
  <para style="q2" vid="PSA 119:117">seera atika duuuchchi wodda uudannon.<verse eid="PSA 119:117" /></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118" />Halcha insa'neexxi xaqaarotete kaddeemmaxee</para>
  <para style="q2" vid="PSA 119:118">atike seer gadho me'aaka duuchcha fugussi.<verse eid="PSA 119:118" /></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119" />Buttatixxa fuggaaleeyye duuchcha koriinsha fugussittaton;</para>
  <para style="q2" vid="PSA 119:119">tennexxee'e dhugaa atixxa eeyyenne.<verse eid="PSA 119:119" /></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120" />Atee sodaatatenaa'ni kexxeexxa bisi anee roqonsaan;</para>
  <para style="q2" vid="PSA 119:120">murte atixxanna sodaatannon.<verse eid="PSA 119:120" /></para>
  <para style="s1">Ee</para>
  <para style="s1">Duuchchi Woddike Goottike Seeri'a Ajajema</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121" />Dhugaanna qullumma hexxeexxa yaane asseennen;</para>
  <para style="q2" vid="PSA 119:121">miicaake manna'n anee sa'issite uuttoxxe'e.<verse eid="PSA 119:121" /></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122" />Garbichcha atikee eloxxi kaddaashsha assi;</para>
  <para style="q2" vid="PSA 119:122">fuggaaleeyye anee miicco'a waaldoxxe'e.<verse eid="PSA 119:122" /></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123" />Anjirallumma atixxanna,</para>
  <para style="q2" vid="PSA 119:123">dhugaatika hiyyichcho atika ille anxi heqqexxe gophphe.<verse eid="PSA 119:123" /></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124" />Garbichcha atike'e jaalala atixxishshann aassi;</para>
  <para style="q2" vid="PSA 119:124">seera atikanna anee barachchiis.<verse eid="PSA 119:124" /></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125" />Ani garbichcho atikenni</para>
  <para style="q2" vid="PSA 119:125">dhugaa atixxanna ege'nonnaa qalbeeffachcho ani'a uwwi.<verse eid="PSA 119:125" /></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126" />Ee, Duuchchi Woddike Goottaa! Manji seera atika sa'eemmaxxe'e</para>
  <para style="q2" vid="PSA 119:126">murte atixxa leellishattoxxi iitti yanna ta'aten.<verse eid="PSA 119:126" /></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127" />Ajajuwwa atika woreqeti irra, caalchissee eeyyannon;</para>
  <para style="q2" vid="PSA 119:127">eetti, ca'itte worqe irra caalchiissee eeyyannon.<verse eid="PSA 119:127" /></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128" />Ajajuwwi atik duuchchi toggichaken;</para>
  <para style="q2" vid="PSA 119:128">tennexxee dhariinka ora duuchcha jibbeennenni.<verse eid="PSA 119:128" /></para>
  <para style="s">Fee</para>
  <para style="s">Duuchchi Woddike Goottika Seera Ajajematee Halcha</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129" />Dhugaa atixxi duuchcha mambe'aken;</para>
  <para style="q2" vid="PSA 119:129">tennexxee lubbo anxi ise'aa ajajendaan.<verse eid="PSA 119:129" /></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130" />Atike hiyyichchixxi tika ifissaan;</para>
  <para style="q2" vid="PSA 119:130">ege'naa afebaaka mannanna qalbeefataake assittaan.<verse eid="PSA 119:130" /></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131" />Ajajuwwa atika yo'oshsha halcheennaxxee</para>
  <para style="q2" vid="PSA 119:131">haanni hiyyee heqqedhaannen.<verse eid="PSA 119:131" /></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132" />Summa atika eeyyaakee'e assitatashshanni,</para>
  <para style="q2" vid="PSA 119:132">anibaa higge'e ani'aa ba'lati.<verse eid="PSA 119:132" /></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133" />Me'injo anka hiyyichchi atikishshanni ani'a toggi assi;</para>
  <para style="q2" vid="PSA 119:133">cubbotinna ani hana mooto'aa waaldoxxe'e.<verse eid="PSA 119:133" /></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134" />Ajajuwwa atika heqqedhannoshsha</para>
  <para style="q2" vid="PSA 119:134">miicaake mannanaa'n anee anjir.<verse eid="PSA 119:134" /></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135" />Garbichcho atikee alba ifi;</para>
  <para style="q2" vid="PSA 119:135">seera atikanna anee barachchiis.<verse eid="PSA 119:135" /></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136" />Ardi seera atika sa'eemmaxxee</para>
  <para style="q2" vid="PSA 119:136">indiddo anenaa'ni wode'iinsha dunendaan.<verse eid="PSA 119:136" /></para>
  <para style="s1">Tsaade</para>
  <para style="s1">Duuchchi Woddike Goottike Seerixxa Dhugaaleessumma</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137" />Ee, Duuchchi Woddike Gootta ati qullichchaken;</para>
  <para style="q2" vid="PSA 119:137">murte atixxinna gugurto affeexxebaan.<verse eid="PSA 119:137" /></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138" />Dhugaa atixxa qullummati ajajjeten;</para>
  <para style="q2" vid="PSA 119:138">isenna yo'oshsha addatendeexxen.<verse eid="PSA 119:138" /></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139" />Naaphi anki hiyyichcho atika dedheemmaxxee'e</para>
  <para style="q2" vid="PSA 119:139">yo'oshsha aare gubatennen.<verse eid="PSA 119:139" /></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140" />Hiyyichchi atik yo'oshsha luqqi hiyyeeken;</para>
  <para style="q2" vid="PSA 119:140">ani garbichchi atikinna isoo eeyyenne.<verse eid="PSA 119:140" /></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141" />Ani heenokenna tuffatemeenneken;</para>
  <para style="q2" vid="PSA 119:141">yaane kinni ajaja atika dedhebe'non.<verse eid="PSA 119:141" /></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142" />Qullumma atixxi duuchchi woddixxe qullimman;</para>
  <para style="q2" vid="PSA 119:142">seeri atikinna dhugaaten.<verse eid="PSA 119:142" /></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143" />Rakkonna abari ane'n geye;</para>
  <para style="q2" vid="PSA 119:143">yaane kinni ajajuwwi atike anke gammadon.<verse eid="PSA 119:143" /></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144" />Dhugaa atixxi duuchchi woddixxe qullummatixxe dhugaan;</para>
  <para style="q2" vid="PSA 119:144">hedhoti hedhannoshsha qalbeefachcho ani'aa uwwi.<verse eid="PSA 119:144" /></para>
  <para style="s1">Qoffi</para>
  <para style="s1">Naaphiinxe Anganaa'n Anjiremate'e Shiqqeexxa Soodachcho.</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145" />Ee, Duuchchi Woddike Goottaa! Mitte godobinni atee ye'edhaanneni heeyyi;</para>
  <para style="q2" vid="PSA 119:145">seera atikanna heqqedhannon.<verse eid="PSA 119:145" /></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146" />Ani atee ye'edhaannen anee anjir;</para>
  <para style="q2" vid="PSA 119:146">dhugaa atixxanna heqqedhaannon.<verse eid="PSA 119:146" /></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147" />Anee gargaartottaa boro haachchabebaangi</para>
  <para style="q2" vid="PSA 119:147">ke'ennexxi atibaa oodhannon;</para>
  <para style="q2" vid="PSA 119:147">hiyyichcho atikanna addatannon.<verse eid="PSA 119:147" /></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148" />Hiyyichcho atika higgeggeen qaabatatee'e</para>
  <para style="q2" vid="PSA 119:148">diiphi ane'ni wilebaangi galannon.<verse eid="PSA 119:148" /></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149" />Atixxe jaalala hiteetexxi haaso'a anka laqi;</para>
  <para style="q2" vid="PSA 119:149">Ee, Duuchchi Woddike Goottaa atike seerishshanni hedho anee uki.<verse eid="PSA 119:149" /></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150" />Fuggoxxa ani'a mari'ataak manni anibaa shiqe'een;</para>
  <para style="q2" vid="PSA 119:150">seera atikenaa'ni kinni insa'ne bayyante'eeken.<verse eid="PSA 119:150" /></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151" />Ee, Duuchchi Woddike Gootta ati kinni shiqiken;</para>
  <para style="q2" vid="PSA 119:151">ajajuwwi atik duuchchinna dhugaaten.<verse eid="PSA 119:151" /></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152" />Seeri atik duuchchi woddi'a hedhaake assiteetexxa</para>
  <para style="q2" vid="PSA 119:152">birenni dhugaa atixxenaa'ni barateennen.<verse eid="PSA 119:152" /></para>
  <para style="s1">Reesi</para>
  <para style="s1">Gargaaro'a Mageno Ye'edha</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153" />Seera atika dedha gopheennaxxee</para>
  <para style="q2" vid="PSA 119:153">rakko anxa uude'e anee gargaar.<verse eid="PSA 119:153" /></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154" />Ani'a baasite'e anee wod;</para>
  <para style="q2" vid="PSA 119:154">hiyyichcho atikishshanna lubbo anee uggi.<verse eid="PSA 119:154" /></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155" />Insa'ne seera atika halsaa gonpheemmexxee</para>
  <para style="q2" vid="PSA 119:155">fuggaaleeyye woddabexxon.<verse eid="PSA 119:155" /></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156" />Ee, Duuchchi Woddike Goottaa! O'wa atixxi lumoshsha lumooxxen;</para>
  <para style="q2" vid="PSA 119:156">seera atikishshanni hedho anxa uki.<verse eid="PSA 119:156" /></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157" />Anee shorredha'neek ank naaphi heddoken;</para>
  <para style="q2" vid="PSA 119:157">ani kinni dhugaa atixxenaa'ni gorebe'non.<verse eid="PSA 119:157" /></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158" />Hiyyichcho atika heqqedha gonphammaxxee</para>
  <para style="q2" vid="PSA 119:158">finqila manna uude jibbenne.<verse eid="PSA 119:158" /></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159" />Ajaja atika hitta eeyyaanne qico uudi;</para>
  <para style="q2" vid="PSA 119:159">Ee, Duuchchi Woddike Goottaa! Jaalala atixxishshanni hedho anxa uki.<verse eid="PSA 119:159" /></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160" />Hiyyichchi atik duuchchi dhugaaten;</para>
  <para style="q2" vid="PSA 119:160">qullite atixxi murtenna duuchchi woddixxen.<verse eid="PSA 119:160" /></para>
  <para style="s1">Saani</para>
  <para style="s1">Duuchchi Woddike Goottike Seeri'a Ajajema.</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161" />Galchalluwwi tola boddichcha anee shorreen;</para>
  <para style="q2" vid="PSA 119:161">ani kinni haaso'a atika mitte godobinni ulfeessenee sodaatanno.<verse eid="PSA 119:161" /></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162" />Lumoxxa boji'o alfeeke manjishsha</para>
  <para style="q2" vid="PSA 119:162">hiyyichcho atike'n yo'oshsha gammadenne.<verse eid="PSA 119:162" /></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163" />Dhara jibbennen, boshshedhenne;</para>
  <para style="q2" vid="PSA 119:163">seera atika kinni eeyyenne.<verse eid="PSA 119:163" /></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164" />Dhugaatixxe atixxe muritexxee</para>
  <para style="q2" vid="PSA 119:164">barate'ni atee torbaanele galateffatannon.<verse eid="PSA 119:164" /></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165" />Seera Atika eeyyaakiir wo'ma nage'a afe'eeni;</para>
  <para style="q2" vid="PSA 119:165">mitte yaanenna insa'nee'e guguffachchiissaaxxi hexxebaani.<verse eid="PSA 119:165" /></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166" />Ee, Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 119:166">Ane gargaartattoxxa addatee heqqedha'eennen;</para>
  <para style="q2" vid="PSA 119:166">ajaja Atikanna muuxxannon.<verse eid="PSA 119:166" /></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167" />Ajajuwwa atika heqqedhannon;</para>
  <para style="q2" vid="PSA 119:167">mitte godobinninna isoo eeyyannon.<verse eid="PSA 119:167" /></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168" />Ajajuwwa atikanna seera ulfeesannon;</para>
  <para style="q2" vid="PSA 119:168">ani assannoxxa duuchcha ati uudattoni.<verse eid="PSA 119:168" /></para>
  <para style="s1">Gargaarsiinxa Soodachcho</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169" />Ee, Duuchchi Woddike Gootta!</para>
  <para style="q2" vid="PSA 119:169">Oodhishsha anxa laqi</para>
  <para style="q2" vid="PSA 119:169">hiteeteshshann qaabbatannoke assi.<verse eid="PSA 119:169" /></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170" />Soodachcho anxi ati edo dagge geltowwaal;</para>
  <para style="q2" vid="PSA 119:170">hiyyichchi atikishshanni anee anjir.<verse eid="PSA 119:170" /></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171" />Seera atika anee barachchiissattaxxe'e</para>
  <para style="q2" vid="PSA 119:171">duuchchi wodda atee galateeffatannon.<verse eid="PSA 119:171" /></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172" />Ajaji atik duuchchi dhugaate kadeemmaxxee'e</para>
  <para style="q2" vid="PSA 119:172">isoo farsa'eennen.<verse eid="PSA 119:172" /></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173" />Ani ajajuwwa atike'ni galonnaa fi'leennaxxee'e</para>
  <para style="q2" vid="PSA 119:173">duuchchi wodda anee gargaartota'a qixxeeffati.<verse eid="PSA 119:173" /></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174" />Ee, Duuchchi Woddik Goottaa!</para>
  <para style="q2" vid="PSA 119:174">Anee gargaartota'a mitte godobinni heqqedhaanneni</para>
  <para style="q2" vid="PSA 119:174">seera atika eyyeennen.<verse eid="PSA 119:174" /></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175" />Atee galateeffatannoshsha</para>
  <para style="q2" vid="PSA 119:175">baro ani'a qeerrisi;</para>
  <para style="q2" vid="PSA 119:175">seeri atik anee gargaaro'o.<verse eid="PSA 119:175" /></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176" />Ba'eeke gedhebishsha doonissa kiyya hiyyennen.</para>
  <para style="q2" vid="PSA 119:176">Kaddo malee seera atika dedha gopheennaxxee'e,</para>
  <para style="q2" vid="PSA 119:176">anee erganjo atika daggee harachchiis.<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="s">Gargaarsiinxa Soodachcho</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1" />Rakko ane'ni geltee wodda</para>
  <para style="q2" vid="PSA 120:1">Duuchchi Woddike Goottibaa raarenneni</para>
  <para style="q2" vid="PSA 120:1">isinna laqe.<verse eid="PSA 120:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2" />Ee, Duuchchi Woddik Goottaa!</para>
  <para style="q2" vid="PSA 120:2">Dharameeyyeteetenaa'ninna xaqartyyettenaa'ni anee gatisi.<verse eid="PSA 120:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3" />Koo dharichcha mannaa!</para>
  <para style="q2" vid="PSA 120:3">Mageni ha'noo maa ergu?</para>
  <para style="q2" vid="PSA 120:3">Hitta hexxexxa murte ha'no'n muru?<verse eid="PSA 120:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4" />Qareeke loliinke mannike bagedinni ha'no otaan;</para>
  <para style="q2" vid="PSA 120:4">yo'oshsha diimateeke kashillinni ha'noo gubaan.<verse eid="PSA 120:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5" />Qeedarike ardixxe oddo'ni</para>
  <para style="q2" vid="PSA 120:5">Meesheekite hiyyemaake boga'ni dagee ofo'lennaxxee'e ani'aa aanne'e.<verse eid="PSA 120:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6" />Nage'aa eeyyabaake manninni welti</para>
  <para style="q2" vid="PSA 120:6">yo'oshsha lumoxxa yanna ofo'lene.<verse eid="PSA 120:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7" />Ani nage'aa eeyye'e</para>
  <para style="q2" vid="PSA 120:7">nage'ik hedha eloxxe kaddeexxa haso'anno wodda insa'ne loliinxe haasonnaan.<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="s">Magen No'aa Gollake Kada</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1" />Koobuwwatiba'a uudennen</para>
  <para style="q2" vid="PSA 121:1">anee gargaaraakita ayyete?<verse eid="PSA 121:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2" />Anee gargaaraaki iimmtanna butta dadeeke</para>
  <para style="q2" vid="PSA 121:2">Duuchchi Woddike Goottani.<verse eid="PSA 121:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3" />Atee heqqa'neek mugaake kada gopheemmaxxee'e</para>
  <para style="q2" vid="PSA 121:3">gugguffattotaa atee waalabaan.<verse eid="PSA 121:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4" />Isira'eelii'i heqqaaki haranga mugaakebaani;</para>
  <para style="q2" vid="PSA 121:4">iittanna diiphakebaan.<verse eid="PSA 121:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5" />Duuchchi Woddik Gootti atike heqqanjon;</para>
  <para style="q2" vid="PSA 121:5">atike cinaachcha'ni hedhee atee heqqaan.<verse eid="PSA 121:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6" />Barra arishsho hashsha agenji</para>
  <para style="q2" vid="PSA 121:6">atee miidhabaan.<verse eid="PSA 121:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7" />Duuchchi Woddik Gootti atee miittaaxxe yaane duuchchanaa'ni heqqaan;</para>
  <para style="q2" vid="PSA 121:7">hedho atixxanna nage'ek heqqaan.<verse eid="PSA 121:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8" />Duuchchi Woddik Gootti ifike minenaa'ni fulde me'itatto woddanna</para>
  <para style="q2" vid="PSA 121:8">ifike minibaanna higgatto wodda</para>
  <para style="q2" vid="PSA 121:8">telchonna duuchchii woddi'a atee heqqaan.<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="s">Iyyerusaalemi Dhaadanteexxa Dhaadachcho</para>
  <para style="d">Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1" />«Duuchchi Woddike Goottike minibaa me'inoo!» Hinee wodda gammadennen.<verse eid="PSA 122:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2" />Tee Iyyerusaalemi!</para>
  <para style="q2" vid="PSA 122:2">No'o ta'a hula atixxe'ni dangee'e uurrineenneni.<verse eid="PSA 122:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3" />Iyyerusaalemi ardi weli'aani weli</para>
  <para style="q2" vid="PSA 122:3">shiqe'e jabaataashsha ijaremeeke qachchani.<verse eid="PSA 122:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4" />Duuchchi Woddik Gootti ajajemmashshanni</para>
  <para style="q2" vid="PSA 122:4">Duuchchi Woddika Gootta galateeffatto'aa</para>
  <para style="q2" vid="PSA 122:4">Isira'eelixxi gosa duuchchi bukki hitaak</para>
  <para style="q2" vid="PSA 122:4">konne qachchibaaten<verse eid="PSA 122:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5" />Daawwitixxe sannek moyanjuwwi duuchchi arda ifika moyaammak</para>
  <para style="q2" vid="PSA 122:5">konne qachchi giddo ofo'leettemman.<verse eid="PSA 122:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6" />Iyyerusaalemike qachcha'ni nage'i hedhaashsha</para>
  <para style="q2" vid="PSA 122:6">hitinee soodatinnaa qici,</para>
  <para style="q2" vid="PSA 122:6">«Atee eeyyaak duuchchi duroommowwaal;<verse eid="PSA 122:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7" />Dalla'i atik giddo nage'i hedhowwaal;</para>
  <para style="q2" vid="PSA 122:7">atike moottummatike minuwwi giddo ti'ni hiyya hexxowwaal»<verse eid="PSA 122:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8" />Anike firiixxeenna anke jaaluwwixxe buuttoxxee</para>
  <para style="q2" vid="PSA 122:8">Iyyerusaalemii'i «Nage'i atinni welti hedhowwaal!» hiyyanon.<verse eid="PSA 122:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9" />Tee, Iyyerusaalem! Duuchchi Woddike Gootta no'oke Magenik minixxe buuto'a hiyye'e</para>
  <para style="q2" vid="PSA 122:9">eloxxi yaane atenaa'ni gortabaashsha gaabba'eennen.<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="s">Mageniinxe Marartexxa Soodachcho</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1" />Ee, Duuchchi Woddik Goottaa! Moote Atixxi hana hexxetekee</para>
  <para style="q2" vid="PSA 123:1">atee soodata'eennen<verse eid="PSA 123:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2" />Ee, Duuchchi Woddike Gootta no'oke Magenoo!</para>
  <para style="q2" vid="PSA 123:2">Labballii yookaan melaalle insa'ne ergatammake mannixxa anga heqqe'nammashshanni</para>
  <para style="q2" vid="PSA 123:2">no'onna marartatto qico'ni atixxa mararte heqqe'naannen.<verse eid="PSA 123:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3" />Ee, Duuchchi Woddike Goottaa! Yo'oshsha yowwemmeennen no'aa marar!</para>
  <para style="q2" vid="PSA 123:3">No'aa marar ballo'o!<verse eid="PSA 123:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4" />Hollameeyye yo'oshsha no'oo salphisse'een</para>
  <para style="q2" vid="PSA 123:4">caaqaaleeyyetinna no'oo yo'oshsha tuffatte'een.<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="s1">Mageni Arida Ifika Heqqaake Kaddeexxa</para>
  <para style="d">Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1" />Isira'eelik ardi hiyyaa qici:</para>
  <para style="q2" vid="PSA 124:1">Duuchchi Woddik Gootti no'onni welti silaa hedhaa gopheele<verse eid="PSA 124:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2" />Naaphi no'oo lolee wodda</para>
  <para style="q2" vid="PSA 124:2">Silaa Duuchchi Woddik Gootti no'onni hedhaa gopheele<verse eid="PSA 124:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3" />Jabaxxe mufenni no'o'ni ke'ee wodda</para>
  <para style="q2" vid="PSA 124:3">silaani lubbondinn he'nee'naa no'oo liqiinseemman.<verse eid="PSA 124:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4" />Lola'i no'oo gudhdhee me'eemman; dageeke wodi'i silaa no'oo buqeemmani.<verse eid="PSA 124:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5" />Jabaki danbala'i silaa no'oo liqiinseemman.<verse eid="PSA 124:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6" />Naaphakenaa'ni no'oo gatiseeka Duuchchi Woddika Gootta</para>
  <para style="q2" vid="PSA 124:6">galati geyo.<verse eid="PSA 124:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7" />Lubbo no'oxxi ci'atishsha</para>
  <para style="q2" vid="PSA 124:7">adamaammakixxe fonxoronaa'ni fulchexxe'e</para>
  <para style="q1" vid="PSA 124:7">Fonxorotinna eqendeen;</para>
  <para style="q2" vid="PSA 124:7">no'onna leexxa fullennen.<verse eid="PSA 124:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8" />No'oo gargaareek</para>
  <para style="q2" vid="PSA 124:8">iimmatanna butta dadeeke</para>
  <para style="q2" vid="PSA 124:8">Duuchchi Woddike Goottan.<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="s">Mageniinke Mannixxa Anijirensha</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1" />Duuchchi Woddika Gootta addataak manni</para>
  <para style="q2" vid="PSA 125:1">haranga lele'mitebaang hexxaammaxxe</para>
  <para style="q2" vid="PSA 125:1">Tsiyoonixxe koobuwwashshaten.<verse eid="PSA 125:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2" />Koobbuwwa Iyyerusaalemii'i qoqqobemmashsha</para>
  <para style="q2" vid="PSA 125:2">telchinaa'ni duuchchi woddi'a</para>
  <para style="q2" vid="PSA 125:2">Duuchchi Woddik Gootti arda ifika qoqqobe'een.<verse eid="PSA 125:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3" />Fuggaaleeyye qulliyyetike boga'ni</para>
  <para style="q2" vid="PSA 125:3">duuchchi wodda moota'ni hexxabaan;</para>
  <para style="q2" vid="PSA 125:3">iittaa kaddoole qulliyyettinna fuggoxxe'ni me'ate'ni kexxaan.<verse eid="PSA 125:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4" />Ee, Duuchchi Woddik Goottaa!</para>
  <para style="q2" vid="PSA 125:4">Seera atike'n galaake qajeeli manni'a eloxxa assi.<verse eid="PSA 125:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5" />Yaane kinni fuggoxxa hujake'n murtatto baro</para>
  <para style="q2" vid="PSA 125:5">atika ora waaleeka duuchchi'ninna</para>
  <para style="q2" vid="PSA 125:5">mittenba murte uutatton.</para>
  <para style="q1" vid="PSA 125:5">Nage'i Isira'eeli'aa kadowwaal.<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="s">Booji'oteenaa'ni Gammashshoti Higati Woddixxe Galatixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1" />Duuchchi Woddiki Goottinna no'oo Iyyerusaalemi'aa wirri asseexxi hiissee wodda</para>
  <para style="q2" vid="PSA 126:1">oojjote malee</para>
  <para style="q2" vid="PSA 126:1">dhugaate labbe'eemmabaan.<verse eid="PSA 126:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2" />Gammadik osolla'ni</para>
  <para style="q2" vid="PSA 126:2">galatiinxa faaro faarsinnene;</para>
  <para style="q2" vid="PSA 126:2">tennexxee gosa gosak ardi no'oo</para>
  <para style="q2" vid="PSA 126:2">«Duuchchi Woddik Gootti insa'ne'aa eloxxa yaane asseen» hiyye.<verse eid="PSA 126:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3" />Dhugaaten, Duuchchi Woddik Gootti lumollamma yaane no'aa asse'een;</para>
  <para style="q2" vid="PSA 126:3">no'onna gammandennen.<verse eid="PSA 126:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4" />Ee, Duuchchi Woddik Goottaa!</para>
  <para style="q2" vid="PSA 126:4">Xeeni ganeexxi bita'ixxe qiillaa gammoojje'ni wode'ee yaasammashsha</para>
  <para style="q2" vid="PSA 126:4">booji'endeemmaxxa karra no'aa hiissi.<verse eid="PSA 126:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5" />Indiddoti wiilissaakiir</para>
  <para style="q2" vid="PSA 126:5">gammashshotixxa faaro faarsa'nee bukki assedhaan.<verse eid="PSA 126:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6" />Sanne dulkeexxi oodhdha'ni bobba'eemaakiir</para>
  <para style="q2" vid="PSA 126:6">ladduwwa ifixxa dulkee'e</para>
  <para style="q2" vid="PSA 126:6">illillisa'n higaan.<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="s1">Mageniinxe Arjummexxee Shiqqeexxa Saadino</para>
  <para style="s">Tsiyoonxe Koobaaba'aa Alalle Me'ati Woddixxa Faaro</para>
  <para style="d">Solomoonixxa Faaro</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 127:1" />Duuchchi Woddik Gootti mine ijaara gophoole,</para>
  <para style="q2" vid="PSA 127:1">mine ijarammak manni tolange elo'aan;</para>
  <para style="q1" vid="PSA 127:1">Duuchchi Wooddik Gootti qachcha heqqa gophoole,</para>
  <para style="q2" vid="PSA 127:1">qachcha heqqaak manni tolange elo'aan.<verse eid="PSA 127:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2" />Duuchchi Woddik Gootti eeyyaaka manna hafuura adhdhisaammaxxee</para>
  <para style="q2" vid="PSA 127:2">gorsa ke'a,</para>
  <para style="q2" vid="PSA 127:2">hashshi qico'ni tura ha'noxxinna toliinxen.<verse eid="PSA 127:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3" />Oosse Duuchchi Woddike Goottixxe uwwan;</para>
  <para style="q2" vid="PSA 127:3">tinni godobiinxi gumma isixxe eebban.<verse eid="PSA 127:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4" />Dargageessummati i'linaaxxi labbaxxi oose</para>
  <para style="q2" vid="PSA 127:4">loliinke manjixxe anga'ni hedheeke gabetike mogidishshaten.<verse eid="PSA 127:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5" />Konne Gabetike mogiduwwishsha hexxeexxa heddo labbaxxa oose</para>
  <para style="q2" vid="PSA 127:5">afeeke manijchchixxa wodo;</para>
  <para style="q2" vid="PSA 127:5">ifike naaphinni qachchiinke dalla'ixxe hula'n falamaa wodda isi shookabaan.<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="s1">Tsiyoonixxe Koobaaba'aa Alalle Me'ati woddixxa Faaro</para>
  <para style="s2">Manji Magenokee'e Ajajemati Alfaaka Hira</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 128:1" />Duuchchi Woddika Gootta sodaataakeerixxa</para>
  <para style="q2" vid="PSA 128:1">ora isike'ninna me'aake manjixxa wodo.<verse eid="PSA 128:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2" />Eloote alfitetteelcho itatton;</para>
  <para style="q2" vid="PSA 128:2">eebbisendatton; ati'anna qajeeldaan.<verse eid="PSA 128:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3" />Are atixxi mine atik giddo gumma callixxe woyineshsha kaddaan;</para>
  <para style="q2" vid="PSA 128:3">oose atixxinna atixxe qoreke qarqara'ni ejersiinke golqishshaten.<verse eid="PSA 128:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4" />Duuchchi Woddika Gootta sodaataak manj</para>
  <para style="q2" vid="PSA 128:4">iitta eebbisemaan.<verse eid="PSA 128:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5" />Duuchchi Woddik Gootti Tsiyoonii'ni atee eebbiso'o!</para>
  <para style="q2" vid="PSA 128:5">Hedho atixxike baro duuchcha'ni Iyyerusaalemixxa danaanumma uuddi!<verse eid="PSA 128:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6" />Atixxe oosexxa oose uudatoke</para>
  <para style="q2" vid="PSA 128:6">atee asso'o!</para>
  <para style="b" vid="PSA 128:6" />
  <para style="q1" vid="PSA 128:6">Nage'i Isira'eeli'a kadowwaal.<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="s1">Tsiyoonixxe Koobaaba'aa Alalle Me'ati woddixxa Faaro</para>
  <para style="s2">Isira'eelika Naapha Injifatatee'e Shiqqeexxa Soodachcho</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 129:1" />Isira'eeli oosummatenaa'ni ta'a qico'ni naaphi anee rakkiseen;<verse eid="PSA 129:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2" />Naaphi anee oosummatenaa'ninni lumo qico rakkiseen;</para>
  <para style="q2" vid="PSA 129:2">yaane kinni anee injiffatebaan.<verse eid="PSA 129:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3" />Fichcha daddare ko'ammake manjishsha</para>
  <para style="q2" vid="PSA 129:3">dudduro anka daddarre;</para>
  <para style="q2" vid="PSA 129:3">ba'linsenna madeesine.<verse eid="PSA 129:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4" />Duuchchi Woddik Gootti kinni qullichchaken;</para>
  <para style="q2" vid="PSA 129:4">isi fuggaaleeyyetixxa wodaro anenaa'n kukkute'een hitowwaal.<verse eid="PSA 129:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5" />Tsiyooni gibaaki duuchchi</para>
  <para style="q2" vid="PSA 129:5">shookeexxi udumi'a higowwaal.<verse eid="PSA 129:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6" />Nophphitebaang baggaammaxxe</para>
  <para style="q2" vid="PSA 129:6">minii hanixxe</para>
  <para style="q2" vid="PSA 129:6">arso kandowwaal.<verse eid="PSA 129:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7" />Tinni arso haamake manjixxa anga,</para>
  <para style="q2" vid="PSA 129:7">hanqafo isixxanna wo'mitabaan.<verse eid="PSA 129:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8" />Ora ookkone sa'aamak manninna insa'nee'e,</para>
  <para style="q2" vid="PSA 129:8">«Duuchchi Woddik Gootti ha'noo anga lekka tiko'o;</para>
  <para style="q2" vid="PSA 129:8">Duuchchi Woddike Goottike summinni ha'noo eebbinseennen» hiyyoqqe'e.<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="s1">Duuchchi Woddike Goottike Gargaarsi'a Shiqqeexxa Soodachcho</para>
  <para style="s2">Tsiyoonixxe Koobaaba'aa Alalle Meati woddixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1" />Ee, Duuchchi Woddike Goottaa! Dhi'mo giddo hedhee atiba'a raara'eennen.<verse eid="PSA 130:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2" />Ee, Dada Duuchchike Goottaa! Haafura anka laqi;</para>
  <para style="q2" vid="PSA 130:2">mansha atixxinna soodachcho anxa caqassowwaal.<verse eid="PSA 130:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3" />Ee, Duuchchi Woddike Gootta ati cubbo no'oxxa hordofeettele</para>
  <para style="q2" vid="PSA 130:3">Ee, Dada Duuchchik Gootta</para>
  <para style="q2" vid="PSA 130:3">ayyete ati edo dandeexxi uurrammaa?<verse eid="PSA 130:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4" />Yane kinni atee sodantannoshsha</para>
  <para style="q2" vid="PSA 130:4">ati cubbo no'oxxa gattowwaali hitatton.<verse eid="PSA 130:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5" />Ani Duuchchi Woddika Goottaa heqqedhannon; lubbo anxinna isoo heqqexxaan;</para>
  <para style="q2" vid="PSA 130:5">hiyyichcho isikanna addeti heqqedhannon.<verse eid="PSA 130:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6" />Hashshik heqqanjuwwi bogiinxa sooda heqqedhamma caala</para>
  <para style="q2" vid="PSA 130:6">eetti hashshik heqqanjuwwi bogiinxa sooda heqqedhamma caala</para>
  <para style="q2" vid="PSA 130:6">lubbo anxi Dada Duuchchika Gootta heqqexxaan.<verse eid="PSA 130:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7" />Tee Isira'eel! Duuchchi Woddike Goottixxi jaalala duuchchi woddixxe kaddeemmaxxeenna</para>
  <para style="q2" vid="PSA 130:7">manna wodatee'e affe'eexxe lumoxxe hunnaxxee'e</para>
  <para style="q2" vid="PSA 130:7">Duuchchi Woddika Gootta addatti.<verse eid="PSA 130:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8" />Isinna Isira'eelii'i</para>
  <para style="q2" vid="PSA 130:8">cubbo duuchchanaa'ni wodaan.<note caller="-" style="x"><char style="xo" closed="false">130:8 </char><char style="xt" closed="false"><ref loc="MAT 1:21">Mat. 1:21</ref>; <ref loc="TIT 2:14">Tit. 2:14</ref>. </char></note><verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="s1">Mageno Addatatixxa Soodachcho</para>
  <para style="s2">Tsiyoonixxe Koobaaba'aa Alalle Me'ati woddixxa Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1" />Ee, Duuchchi Woddike Goottaa! Ani hollebe'no;</para>
  <para style="q2" vid="PSA 131:1">ille anxinninna wele hollati uudebe'noni;</para>
  <para style="q2" vid="PSA 131:1">dande'abe'noxxa lumolla yaane yookaan</para>
  <para style="q2" vid="PSA 131:1">mambe'aa yaane assebe'non.<verse eid="PSA 131:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2" />Yaane kinni ani ifi sammi assenne;</para>
  <para style="q2" vid="PSA 131:2">ununa waaldeexxi anno amate'ni sammi hitteexxi luu'mendammashsha</para>
  <para style="q2" vid="PSA 131:2">aninna ununa waaldeemmaxxe annoshsha sammi hiyyenne.<verse eid="PSA 131:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3" />Koo Isira'eelike ardaa! Ta'anaa'ni duuchchi woddi qico'ni</para>
  <para style="q2" vid="PSA 131:3">Duuchchi Woddika Gootta addatti.<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="s1">Mageniinke Galmixxa Saadino</para>
  <para style="s2">Tsiyoonixxe Koobaaba'aa Alalle Me'ati woddixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1" />Ee, Duuchchi Woddike Goottaa! Daawwiti'ni geyyeeka</para>
  <para style="q2" vid="PSA 132:1">abara duuchcha qaabbati.<verse eid="PSA 132:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2" />Isi Duuchchi Woddike Gootti'a kakate'e</para>
  <para style="q2" vid="PSA 132:2">Ya'iqoobike Lumoke Mageni'a hiyye wereegee qici,<verse eid="PSA 132:2" /></para>
  <para style="q1">
    <verse number="3-5" style="v" sid="PSA 132:3-5" />«Duuchchi Woddik Gootti galaabaa,</para>
  <para style="q2" vid="PSA 132:3-5">qophpheesannoxxee'e</para>
  <para style="q1" vid="PSA 132:3-5">Ya'iqoobike Lumoke Duuchchi Woddike Gootti'a</para>
  <para style="q2" vid="PSA 132:3-5">mine ijaaranno qico'ni</para>
  <para style="q2" vid="PSA 132:3-5">mini'aa aagabe'no;</para>
  <para style="q2" vid="PSA 132:3-5">taqete'ninna galabe'no;</para>
  <para style="q2" vid="PSA 132:3-5">diiphabe'no yookaan mugabe'no.»<verse eid="PSA 132:3-5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6" />No'onna Kakotike Taabotixxa odo Efiraata he'nee lanqennen;</para>
  <para style="q2" vid="PSA 132:6">Yi'armike boga'ni isoo anfennen.<verse eid="PSA 132:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7" />«Amme Duuchchi Woddike Goottike galdumiba'a me'ino;</para>
  <para style="q2" vid="PSA 132:7">lekka isixxi haxxaaba kumbu hino.<verse eid="PSA 132:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8" />Ee, Duuchchi Woddike Goottaa Ke'i!</para>
  <para style="q2" vid="PSA 132:8">Hunna atixxa leellishshaake Kakotike Tabotinni welti</para>
  <para style="q2" vid="PSA 132:8">hafuura adhdhittattoxxe bakkabaa'a me'i.<verse eid="PSA 132:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9" />Qeese atixxi qullumma oddo'witowwaal;</para>
  <para style="q2" vid="PSA 132:9">ardi atikinna illillisee faarsowwaal.»<verse eid="PSA 132:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10" />Erganijo atike Daawwitixxee'e hitee</para>
  <para style="q2" vid="PSA 132:10">hariirteteka manjo waaldoxxe'e.<note caller="-" style="x"><char style="xo" closed="false">132:10 </char><char style="xt" closed="false"><ref loc="2CH 6:41-42">2 Odo. 6:41-42</ref>. </char></note><verse eid="PSA 132:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11" />Duuchchi Woddik Gootti Daawwiti'a dhugaatixxa kako,</para>
  <para style="q2" vid="PSA 132:11">jijjiirendabaaxxenni hiyyee qici:</para>
  <para style="q1" vid="PSA 132:11">«Atixxe horte giddii'n</para>
  <para style="q2" vid="PSA 132:11">mitte atixxe moote'ni ofo'lshannon.<note caller="-" style="x"><char style="xo" closed="false">132:11 </char><char style="xt" closed="false"><ref loc="2SA 7:12-16">2 Sam. 7:12-16</ref>; <ref loc="1CH 17:11-14">1 Odo. 17:11-14</ref>; <ref loc="PSA 89:3-4">Far. 89:3-4</ref>; <ref loc="ACT 2:30">Erga. Huj. 2:30</ref>. </char></note><verse eid="PSA 132:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12" />Labbaxxi atixxi oose kako anxa heqexxoolenna</para>
  <para style="q2" vid="PSA 132:12">barachchiisenneka ajajuwwa heqqexxoole</para>
  <para style="q2" vid="PSA 132:12">insa'neexxi labbaxxi oose</para>
  <para style="q2" vid="PSA 132:12">atixxe moote'ni duuchchi woddi'a mootaan.»<verse eid="PSA 132:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13" />Duuchchi Woddik Gootti Tsiyoonii'i fi'lemmaxxee'e</para>
  <para style="q2" vid="PSA 132:13">ise'e galdumma ifike assedho'a fedhe'een.<verse eid="PSA 132:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14" />«Ise duuchchi woddi'a anke galdumixxe bakkan;</para>
  <para style="q2" vid="PSA 132:14">isee eeyyeennaxxee hedhannoxxe bakka assedhannon.<verse eid="PSA 132:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15" />Tsiyyoni'a ittaachcho bira sa'isee'e isee eebbisannon;</para>
  <para style="q2" vid="PSA 132:15">isexxi hiyyeeyyenna goddite ittashsha assannon.<verse eid="PSA 132:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16" />Isexxe qeese'ni anjira odeessanno;</para>
  <para style="q2" vid="PSA 132:16">ardi isekinna illilleeteti farsaan.<verse eid="PSA 132:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17" />«Daawwitixxe sannenaa'ni moyanji moyaashsha assannon;</para>
  <para style="q2" vid="PSA 132:17">galchaashshanna ora isi'a qophpheessannon.<note caller="-" style="x"><char style="xo" closed="false">132:17 </char><char style="xt" closed="false"><ref loc="1KI 11:36">1 Moy. 11:36</ref>. </char></note><verse eid="PSA 132:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18" />Ani naapha iseke'n shooko odeessanno;</para>
  <para style="q2" vid="PSA 132:18">kallachchi isik kinni cala cala hiyyaan.»<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="s1">Dayyuwwiinxe Jaalala</para>
  <para style="s1">Tsiyoonixxe Koobaaba'aa Alalle Me'ati woddixxa Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1" />Dayyuwwi mitte afoo kade'e mitteba hedha</para>
  <para style="q2" vid="PSA 133:1">hitta hitta gammachchiisaaxxe, hittatta eloxxe.<verse eid="PSA 133:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2" />Tinni dayyumma Aaroonike umonaa'ni areedake'n yaate'e</para>
  <para style="q2" vid="PSA 133:2">oddo'weexxe seemmaka handaara gelteemmaxxe</para>
  <para style="q2" vid="PSA 133:2">eloke fishshaake ejersiinxe zayiteshshaten.<verse eid="PSA 133:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3" />Kunni dayyummatiki mittoomi Herimoonixxe koobanaa'ni Tsiyoonike Tullichchuwwa'ni</para>
  <para style="q2" vid="PSA 133:3">butti'a coccobammake wojishshaten;</para>
  <para style="q1" vid="PSA 133:3">Ookko Duuchchi Woddik Gootti</para>
  <para style="q2" vid="PSA 133:3">ifixxa eebba,</para>
  <para style="q2" vid="PSA 133:3">hedhotanna duuchchi woddi'a ajajeedheen.<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="s1">Mageno Saadaa</para>
  <para style="s2">Tsiyoonixxe Koobaaba'aa Alalle Me'ati Woddixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1" />Ha'noo Duuchchi Woddike Goottik erganjuwwi!</para>
  <para style="q2" vid="PSA 134:1">Hashsha Duuchchi Woddike Goottike mini giddo ergatendinaakiir</para>
  <para style="q2" vid="PSA 134:1">Duuchchi Woddika Gootta saadde.<verse eid="PSA 134:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2" />Ookkone Isike woyyichchi galmi giddo anga ha'nooxxa iimi'a ke'issitine'e</para>
  <para style="q2" vid="PSA 134:2">Duuchchi Woddika Gootta saadde.<verse eid="PSA 134:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3" />Iimatanna butta dadeek</para>
  <para style="q2" vid="PSA 134:3">Duuchchi Woddik Gootti ha'noo Tsiyooninaa'ni eebbisoo!<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="s1">Saadinotixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1" />Hallee luyaa!</para>
  <para style="q2" vid="PSA 135:1">Duuchchi Woddike Goottika summa saadde;</para>
  <para style="q2" vid="PSA 135:1">ha'noo Duuchchi Woddike Goottik erganjuwwi isoo saadde.<verse eid="PSA 135:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2" />No'oke Mageniinke galma'ni,</para>
  <para style="q2" vid="PSA 135:2">Duuchchi Woddike Goottike minixxe baxxe'ni ergatendinaak isoo saadde<verse eid="PSA 135:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3" />Duuchchi Woddik Gootti arjake kadeemmaxxee'e</para>
  <para style="q2" vid="PSA 135:3">Duuchchi Woddika Gootta saadde;</para>
  <para style="q2" vid="PSA 135:3">eloke kadeemmaxxee'e</para>
  <para style="q2" vid="PSA 135:3">summa isika faaroti saadde.<verse eid="PSA 135:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4" />Duuchchi Woddik Gootti Ya'iqoobii'i ifike assedho'a,</para>
  <para style="q2" vid="PSA 135:4">Isira'eelika ardanna ifike fiixeeke miya kado'aa fi'leen.<verse eid="PSA 135:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5" />Duuchchi Woddik Gootti lumoke kadeexxa,</para>
  <para style="q2" vid="PSA 135:5">no'ok Dada Duuchchik Goottinna wele magenuwwanaa'ni caalaaxxa ani ege'neennen.<verse eid="PSA 135:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6" />Iimmate'ninna buttate'ni</para>
  <para style="q2" vid="PSA 135:6">abbaayyuwwati giddonna isexxe dhi'muwwa duuchcha'ni</para>
  <para style="q2" vid="PSA 135:6">Duuchchi Woddik Gootti eeyyeexxe assaan.<verse eid="PSA 135:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7" />Isi duumancha buttatixxe gabalanaa'ni iyyedagaan;</para>
  <para style="q2" vid="PSA 135:7">banqo xeeni giddo ibbaashsha assee'e</para>
  <para style="q2" vid="PSA 135:7">diidallotanna uggeemmaxxe ifixxe bakkanaa'ni iyyedagaan.<verse eid="PSA 135:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8" />Isi Gibtseeke ardika labbaka angafa duuchchanna</para>
  <para style="q2" vid="PSA 135:8">edise ilemeeka hore duuchcha qooma shiye.<verse eid="PSA 135:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9" />Ookko moyanjo Feri'ooninna isika erganjuwwa duuchcha mura woxisatee'e</para>
  <para style="q2" vid="PSA 135:9">beessisuwwakanna mambe'aa yaane asse.<verse eid="PSA 135:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10" />Isi heddo gosa gosaka arda kutti asseexxi;</para>
  <para style="q2" vid="PSA 135:10">jajjaba moyanjuwwanna shiye.<verse eid="PSA 135:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11" />Amooritotika moyanjo Sihoonii'i,</para>
  <para style="q2" vid="PSA 135:11">Basaanke bogika moyanjo Ooggii'i</para>
  <para style="q2" vid="PSA 135:11">Kenaanike bogika moyanjuwwa duuchcha shiye.<verse eid="PSA 135:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12" />Boga insa'neekanna Isira'eelii ifike ardi'aa,</para>
  <para style="q2" vid="PSA 135:12">qadaadake kado'aa uwwe.<verse eid="PSA 135:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13" />Ee, Duuchchi Woddike Goottaa! summi atik duuchchi woddiken;</para>
  <para style="q2" vid="PSA 135:13">Ee, Duuchchi Woddike Gootta</para>
  <para style="q2" vid="PSA 135:13">ila ila atee qaabbattaan.<verse eid="PSA 135:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14" />Duuchchi Woddik Gootti arda ifikee muraan;</para>
  <para style="q2" vid="PSA 135:14">ifike erganjuwwi'aanna mararaan.<verse eid="PSA 135:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15" />Wele gosa gosake ardik magenuwwi</para>
  <para style="q2" vid="PSA 135:15">manjiinxe anganni giisendeexxe worqetixxenna biretike sibiljixxe fakkuwwan.<verse eid="PSA 135:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16" />Tinni fakkuwwa afo'onge affe'een kinni haasottabaan;</para>
  <para style="q2" vid="PSA 135:16">illende affe'een kinni affabaan.<verse eid="PSA 135:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17" />Kunniichchuwwi manshande afe'een laqabaan;</para>
  <para style="q2" vid="PSA 135:17">sanotenaa'ninna hafuura fulchedhabaan.<verse eid="PSA 135:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18" />Konneechchuwwa giiseekiirrinna konneechchuwwa'ni addataak duuchchinna</para>
  <para style="q2" vid="PSA 135:18">konneechchuwwishshanden.<verse eid="PSA 135:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19" />Koo Isira'eelike ardaa Duuchchi Woddika Gootta saadde;</para>
  <para style="q2" vid="PSA 135:19">tee Aaroonixxe hortee Duuchchi Wodika Gootta saadde;<verse eid="PSA 135:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20" />Ha'noo Leewwixxe hortee Duuchchi Woddika Gootta saadde;</para>
  <para style="q2" vid="PSA 135:20">ha'noo isoo sodaatinaakiir</para>
  <para style="q2" vid="PSA 135:20">Duuchchi Woddika Gootta saadde.<verse eid="PSA 135:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21" />Iyyerusaalemi giddo hedha'neek Duuchchi Woddik Gootti</para>
  <para style="q2" vid="PSA 135:21">Tsiyooni giddo saademmowwaal.</para>
  <para style="q2" vid="PSA 135:21">Hallee luyaa.<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="s1">Galatiinxa Faaro</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 136:1" />Eloke kadeemmaxxee Duuchchi Woddika Gootta Galateeffatte;</para>
  <para style="q2" vid="PSA 136:1">jaalala isixxi duuchchi woddixxen.<note caller="-" style="x"><char style="xo" closed="false">136:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 Odo. 16:34</ref>; <ref loc="2CH 5:13">2 Odo. 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Izr. 3:11</ref>; <ref loc="PSA 100:5">Far. 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="JER 33:11">Erm. 33:11</ref>. </char></note><verse eid="PSA 136:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2" />Magenuwwiinka Mageno galateeffatte;</para>
  <para style="q2" vid="PSA 136:2">jaalala isixxi duuchchi woddixxen.<verse eid="PSA 136:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3" />Goottowwinka dada duuchchika Gootta galateeffatte;</para>
  <para style="q2" vid="PSA 136:3">jaalala isixxi duuchchi woddixxen.<verse eid="PSA 136:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4" />Isin calli lumollamma mambe'a assaan,</para>
  <para style="q2" vid="PSA 136:4">jaalala isixxi duuchchi woddixxen.<verse eid="PSA 136:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5" />Beekuma ifiken iimuwwa dadeek,</para>
  <para style="q2" vid="PSA 136:5">jaalala isixxi duuchchi woddixxen.<note caller="-" style="x"><char style="xo" closed="false">136:5 </char><char style="xt" closed="false"><ref loc="GEN 1:1">Dada. 1:1</ref>. </char></note><verse eid="PSA 136:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6" />Butta wodi'uwwii hanna diriirseek,</para>
  <para style="q2" vid="PSA 136:6">jaalala isixxi duuchchi woddixxen.<note caller="-" style="x"><char style="xo" closed="false">136:6 </char><char style="xt" closed="false"><ref loc="GEN 1:2">Dada. 1:2</ref>. </char></note><verse eid="PSA 136:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7" />Lumollamma ifuwwa dadeek,</para>
  <para style="q2" vid="PSA 136:7">jaalala isixxi duuchchi woddixxen.<verse eid="PSA 136:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8" />Arishsho barra mootashsha asseek,</para>
  <para style="q2" vid="PSA 136:8">jaalala isixxi duuchchi woddixxen<verse eid="PSA 136:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9" />Agenjikinna urjjuwwa hashsha mootaashsha asseek,</para>
  <para style="q2" vid="PSA 136:9">jaalal isixxi duuchchi woddixxen.<note caller="-" style="x"><char style="xo" closed="false">136:9 </char><char style="xt" closed="false"><ref loc="GEN 1:16">Dada. 1:16</ref>. </char></note><verse eid="PSA 136:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10" />Gibtseeke mannika labbaka angafuwwa shiyeek,</para>
  <para style="q2" vid="PSA 136:10">jaalala isixxi duuchchi woddixxen.<note caller="-" style="x"><char style="xo" closed="false">136:10 </char><char style="xt" closed="false"><ref loc="EXO 12:29">Fula. 12:29</ref>. </char></note><verse eid="PSA 136:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11" />Isira'eelika arda Gibtssee'n fulcheek,</para>
  <para style="q2" vid="PSA 136:11">jaalala isixxi duuchchi woddixxen.<note caller="-" style="x"><char style="xo" closed="false">136:11 </char><char style="xt" closed="false"><ref loc="EXO 12:51">Fula. 12:51</ref>. </char></note><verse eid="PSA 136:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12" />Ifixxe hunnameette anganninna ifixxe jabaxxe hirrenni tennee asseek,</para>
  <para style="q2" vid="PSA 136:12">jaalala isixxi duuchchi woddixxen.<verse eid="PSA 136:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13" />Diimmoxxa abaayya lamebaa shateek,</para>
  <para style="q2" vid="PSA 136:13">jaalala isixxi duuchchi woddixxen.<verse eid="PSA 136:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14" />Isira'eelii'i isexxe oddonaa'n sa'iseek,</para>
  <para style="q2" vid="PSA 136:14">jaalala isixxi duuhchchi woddixxen.<verse eid="PSA 136:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15" />Gibtseka moyanjonna isika loliinka manna diimmoxxe abbaayya giddo bireek</para>
  <para style="q2" vid="PSA 136:15">jaalala isixxi duuchchi woddixxen.<note caller="-" style="x"><char style="xo" closed="false">136:15 </char><char style="xt" closed="false"><ref loc="EXO 14:21-29">Fula. 14:21-29</ref>. </char></note><verse eid="PSA 136:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16" />Arda ifika qiilla gammoojje giddo akeekeek,</para>
  <para style="q2" vid="PSA 136:16">jaalala isixxi duuchchi woddixxen.<verse eid="PSA 136:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="PSA 136:17" />Lumollamma moyanjuwwa shiyeek,</para>
  <para style="q2" vid="PSA 136:17">jaalala isixxi duuchchi woddixxen.<verse eid="PSA 136:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18" />Jajjabba moyanjuwwa shiyeek,</para>
  <para style="q2" vid="PSA 136:18">jaalala isixxi duuchchi woddixxen.<verse eid="PSA 136:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19" />Sihoonii'i Amoorake ardika moyanjo shiyeek,</para>
  <para style="q2" vid="PSA 136:19">jaalala isixxi duuchhci woddixxen.<note caller="-" style="x"><char style="xo" closed="false">136:19 </char><char style="xt" closed="false"><ref loc="NUM 21:21-30">Lak. 21:21-30</ref>. </char></note><verse eid="PSA 136:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20" />Ooggii'i Baasanke ardika moyanjo shiyeek,</para>
  <para style="q2" vid="PSA 136:20">jaalala isixxi duuchchi woddixxen.<note caller="-" style="x"><char style="xo" closed="false">136:20 </char><char style="xt" closed="false"><ref loc="NUM 21:31-35">Lak. 21:31-35</ref>. </char></note><verse eid="PSA 136:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21" />Insa'neka boga qadaadake kado'a ifike ardi'a uwweek,</para>
  <para style="q2" vid="PSA 136:21">jaalala isixxi duuchchi woddixxen.<verse eid="PSA 136:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22" />Erganjuwwa ifike Isira'eelike ardi'a qadaadak kado'a uwweek</para>
  <para style="q2" vid="PSA 136:22">jaalala isixxi duuchchi woddixxen.<verse eid="PSA 136:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23" />Salphantenne wodda no'oo qaabbateek,</para>
  <para style="q2" vid="PSA 136:23">jaalala isixxi duuchchi woddixxen.<verse eid="PSA 136:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24" />Naapha no'okenaa'n no'oo anjireek,</para>
  <para style="q2" vid="PSA 136:24">jaalala isixxi duuhchchi woddixxen.<verse eid="PSA 136:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25" />Dada duuchchi'a ita uwwaak,</para>
  <para style="q2" vid="PSA 136:25">jaalala isixxi duuchchi woddixxen.<verse eid="PSA 136:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26" />Iimmatika Mageno galateeffatte,</para>
  <para style="q2" vid="PSA 136:26">jaalala isixxi duuchchi woddixxen.<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="s1">Booji'emeeke Isira'eelike Ardixxa Oodhishsha</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1" />Baabiloonike galaani bira, ofole'e,</para>
  <para style="q2" vid="PSA 137:1">Tsiyoonii'i qaabbantenne wodda oo'nenne.<verse eid="PSA 137:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2" />Ookko hokokotike haqichchuwwi hana,</para>
  <para style="q2" vid="PSA 137:2">baganuwwa no'oka fannissenne.<verse eid="PSA 137:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3" />No'oo booji'ee rakkisammak manni</para>
  <para style="q2" vid="PSA 137:3">ookko insa'nee'e gammachchiissaaxxa faaro farsinoonna'aa no'oo lanqe'e</para>
  <para style="q2" vid="PSA 137:3">«Tsiyoonixxe faaruwwanaa'ni mitte no'aa faarse» hine.<verse eid="PSA 137:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4" />Duuchchi Woddike Goottixxa faaro,</para>
  <para style="q2" vid="PSA 137:4">no'o hitta annaafe boga'n faarsinnanno?<verse eid="PSA 137:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5" />Tee Iyyerusaalemi, ani atee dedhonnole</para>
  <para style="q2" vid="PSA 137:5">anxi middixxi anga huje deetowwaal.<verse eid="PSA 137:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6" />Iyyerusaalemii ani atee qaabbata gophonnole,</para>
  <para style="q2" vid="PSA 137:6">ani atee anxe gammashsho duuchchanaa'n</para>
  <para style="q2" vid="PSA 137:6">caalchisa gophonnole,</para>
  <para style="q2" vid="PSA 137:6">arrabi anki quumeti dhaphphi hiyyowwaal.<verse eid="PSA 137:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7" />Ee, Duuchchi Woddike Gootta Iyyerusaalemi diigendeexxa barra</para>
  <para style="q2" vid="PSA 137:7">Eedoomiki manni</para>
  <para style="q2" vid="PSA 137:7">«Diigge, diigge booso isexxanna balleese» hiyyeexxa qaabbati.<verse eid="PSA 137:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8" />Tee Baabiloonii ati diigendatton;</para>
  <para style="q2" vid="PSA 137:8">ati no'o'ni assitetexxe yaannexxee'e</para>
  <para style="q1" vid="PSA 137:8">huje atixxishshanni hira ati'a uwwaak isi eebbiseme'eeken.<verse eid="PSA 137:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9" />Annoole atixxa abide'e kinotixxe</para>
  <para style="q2" vid="PSA 137:9">rassa hana cancaqaak isi eebbiseme'eeken.<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="s1">Galatiinxa Soodachcho</para>
  <para style="s2">Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1" />Ee, Duuchchi Woddike Goottaa! mitti godobinni atee saadannon;</para>
  <para style="q2" vid="PSA 138:1">magenuwwii edo faaroti atee saadannon.<verse eid="PSA 138:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2" />Hiyyichcho atikanna summa atika duuchchiinxe yaane irra ulfeesiteettaxxee'e</para>
  <para style="q2" vid="PSA 138:2">atike woyyichcha galmi darre'n wirri hiyye'e heeshshi qokki hiyyee'e,</para>
  <para style="q2" vid="PSA 138:2">atixxe jaalalaxxeenna atixxe xuurameessumma'aa summa atika saadannon.<verse eid="PSA 138:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3" />Atee ye'edhenne wodda ani'a hee hitteetten;</para>
  <para style="q2" vid="PSA 138:3">lubbo anxa jabeessitee hunnameessake anee assitetten.<verse eid="PSA 138:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4" />Ee, Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 138:4">Atike afo'ika haaso'a laqaa wodda buttatik moyanjuwwi duuchchi atee galateeffatuun.<verse eid="PSA 138:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5" />Duuchchi Woddike Goottik gaachchanni lumoke kadeemmaxxee'e</para>
  <para style="q2" vid="PSA 138:5">insa'ne Duuchchi Woddike Goottika ora faarsinaan.<verse eid="PSA 138:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6" />Duuchchi Woddik Gootti xungote'n hedhoolenna</para>
  <para style="q2" vid="PSA 138:6">butta hedheeka uudaan;</para>
  <para style="q2" vid="PSA 138:6">yaane kinni bayyanni hedhe'e hollameessa ege'naan.<verse eid="PSA 138:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7" />Rakko anee qoqqobee'naa me'onnolenna</para>
  <para style="q2" vid="PSA 138:7">ati hedho anxa heqqittatton;</para>
  <para style="q2" vid="PSA 138:7">anke naaphixxe mufe'n anga atixxa wirri assitee'e</para>
  <para style="q2" vid="PSA 138:7">middixxe anga atixxenni anee anjirtatton.<verse eid="PSA 138:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8" />Duuchchi Woddik Gootti ifika yaada ani'a muuxaan;</para>
  <para style="q2" vid="PSA 138:8">Ee, Duuchchi Woddike Goottaa! Atixxi jaalala duuchchi woddixxen;</para>
  <para style="q2" vid="PSA 138:8">atixxe angaxxa huje waaldoxxe'e.<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="s2">Duuchchniinxa Ege'nallo Magenixxa Heqqa</para>
  <para style="s1">Faarsaleeyyeetike Sooresi'a Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1" />Ee, Duuchchi Woddike Goottaa! Ati anee qorqortee egendette.<verse eid="PSA 139:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2" />Ati ofo'la ke'aa anxa egendatton;</para>
  <para style="q2" vid="PSA 139:2">bayyii'ninni anke godobika yaada hubbattattoon.<verse eid="PSA 139:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3" />Me'anna hafuura adhdha anxa qorqortatton;</para>
  <para style="q2" vid="PSA 139:3">assannoxxa duuchcha egendatton.<verse eid="PSA 139:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4" />Ee, Duuchchi Woddike Goottaa! Haaso'ebe'no edi darre</para>
  <para style="q2" vid="PSA 139:4">maa haaso'onaa'a hedaannexxe egendatton.<verse eid="PSA 139:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5" />Ati edi udumii'n</para>
  <para style="q2" vid="PSA 139:5">anga atixxanna ani hana gaaddissette.<verse eid="PSA 139:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6" />Tennee ege'na ani'a mambe'aken;</para>
  <para style="q2" vid="PSA 139:6">dande'e dhaqqanbabe'noxxe xungon.<verse eid="PSA 139:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7" />Atike Hafuurnaa'n haba marannoo?</para>
  <para style="q2" vid="PSA 139:7">Ati edii'n dande'e baajannoo?<verse eid="PSA 139:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8" />Iimmi'a me'oonnole ati ookkonni hexxeten;</para>
  <para style="q2" vid="PSA 139:8">reyemmaki manni hedhemmaba giddo sa'e diiphonolenna ati ookkonni hexxetten.<verse eid="PSA 139:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9" />Arishsho fuldammabaa'n phirri hiyye me'oonnoole</para>
  <para style="q2" vid="PSA 139:9">yookaan arishsho aagammaba bayya hedhonnoole,<verse eid="PSA 139:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10" />Ookkonna kaddoole anee anga atixxi akeekaan;</para>
  <para style="q2" vid="PSA 139:10">middixxi atixxi anganna anee kiphphaan.<verse eid="PSA 139:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11" />Ani, «Dukkana dhugaagaten, anee shoxxaan,</para>
  <para style="q2" vid="PSA 139:11">qarqara anke hedheek ifi hashshate kaddaan» hiyyennele,<verse eid="PSA 139:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12" />Dukkana ati'aa dukkandabaan;</para>
  <para style="q2" vid="PSA 139:12">hashshatinna barrishsha iffaan;</para>
  <para style="q2" vid="PSA 139:12">tennexxee ati'aa dukkanatinna ifi mittengen.<verse eid="PSA 139:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13" />Ati anxa giddixxa manjumma dada'eetten;</para>
  <para style="q2" vid="PSA 139:13">anxe amake godobi giddo</para>
  <para style="q2" vid="PSA 139:13">loobbe'e anee daddetek ateten.<verse eid="PSA 139:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14" />Ani maso mambe'ake kadee'e dademeennaxxee'e</para>
  <para style="q2" vid="PSA 139:14">ateee saadda'eennen;</para>
  <para style="q2" vid="PSA 139:14">huje atixxi mambe'aken;</para>
  <para style="q2" vid="PSA 139:14">tenneenna ani adda ege'neennen.<verse eid="PSA 139:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15" />Ani sho'ik dademenne wodda</para>
  <para style="q2" vid="PSA 139:15">dhi'moo godobi giddo dademenne wodda</para>
  <para style="q2" vid="PSA 139:15">micci anki duuchchinna ati edo sho'eemabaan.<verse eid="PSA 139:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16" />Ille atixxi, anxee amake godoba'ni munde ititebaa wodda anee affeen;</para>
  <para style="q2" vid="PSA 139:16">ani'a murendeexxi barruwwa</para>
  <para style="q2" vid="PSA 139:16">atike maxaafa'n borreeseende'een.<verse eid="PSA 139:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17" />Ee, Mageno ati ani'aa affe'eetik yaadi yo'oshsha ulfaatekenna ba'lake kadeemmaxxee'e</para>
  <para style="q2" vid="PSA 139:17">ani ege'naa dande'abe'non.<verse eid="PSA 139:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18" />Yaada atika laakko'anno hiyyeennele maanchii caala bira sa'eeken;</para>
  <para style="q2" vid="PSA 139:18">dammaqanno woddanna atinni welti hedhennen.<verse eid="PSA 139:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19" />Ee, Mageno fuggaaleeyye shilteetelena'a!</para>
  <para style="q2" vid="PSA 139:19">Ha'noo munde dundinaak manni ane'naa'n bayyatte.<verse eid="PSA 139:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20" />Insa'ne atixxa fuggoxxa hassona;</para>
  <para style="q2" vid="PSA 139:20">naaphi atikinna summa atika fuggoxxenni ganaan.<verse eid="PSA 139:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21" />Ee, Duuchchi Woddike Goottaa atee jibbaaka ani isoo jibbabe'nnotaa?</para>
  <para style="q2" vid="PSA 139:21">Ate'ni ke'aakaaraa ani insa'nee diqatabe'nootaa?<verse eid="PSA 139:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22" />Ani insa'nee mitti godobinninni jibbeennen;</para>
  <para style="q2" vid="PSA 139:22">anke naapha kande'een.<verse eid="PSA 139:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23" />Ee, Mageno qorqotte anee uudde'e godobixxa anxa afi;</para>
  <para style="q2" vid="PSA 139:23">anee hega uudde'e yaaddo anxanna ege'ni.<verse eid="PSA 139:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24" />Ani giddo fuggoxxi hexxeexxe kaddoole uudi;</para>
  <para style="q2" vid="PSA 139:24">duuchchi woddike ora'ninna anee akeek.<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="s1">Fuggaaleeyyetenaa'ni Gatatee'e Shiqqeexxa Soodachcho</para>
  <para style="s1">Faarsaleeyyetike Sooresi'a Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1" />Ee, Duuchchi Woddike Goottaa fuggaaleeyye mannanaa'ni ane'e gatisi;</para>
  <para style="q2" vid="PSA 140:1">xaqartichcha mannanaa'ni anee heqqi.<verse eid="PSA 140:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2" />Insa'ne godobi giddo fuggoxxe yaane hendaan;</para>
  <para style="q2" vid="PSA 140:2">duuchchi woddanna lola ke'isinaan.<verse eid="PSA 140:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3" />Insa'nek arabi manjo dhudhdhuufiinsha iddaan;</para>
  <para style="q2" vid="PSA 140:3">haaso'i insa'neekinna buutetixxe ha'lashshaten.<note caller="-" style="x"><char style="xo" closed="false">140:3 </char><char style="xt" closed="false"><ref loc="ROM 3:13">Rom. 3:13</ref>. </char></note><verse eid="PSA 140:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4" />Ee Duuchchi Woddike Gootta fuggaaleeyyetixxe anganaa'ni anee heqqi;</para>
  <para style="q2" vid="PSA 140:4">xaqartichcha mannanaa'ni,</para>
  <para style="q2" vid="PSA 140:4">anee ibiso'aa lekka anxa qaxxafo'a malaakenaa'ni gatisi.<verse eid="PSA 140:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5" />Hollammeeyye fonxoro ani'a falte;</para>
  <para style="q2" vid="PSA 140:5">insa'ne wodaro sagarreexxi ani'a fanne;</para>
  <para style="q2" vid="PSA 140:5">me'anno ora'n qaxafa uggine.<verse eid="PSA 140:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6" />Ee, Duuchchi Wodike Goottaa! Atee ani «Anke Magno» hiyyannon;</para>
  <para style="q2" vid="PSA 140:6">Ee, Duuchchi Woddike Gootta anxa oodhishsha laqi.<verse eid="PSA 140:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7" />Ee, worba anjirallo, lumoke Duuchchi Woddike Gootta</para>
  <para style="q2" vid="PSA 140:7">loliinxa barra anee wontetishsha gollittette.<verse eid="PSA 140:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8" />Ee, Duuchchi Woddike Gootta fuggaaleeyyetixxa halcha muuxxissoxxee'e</para>
  <para style="q2" vid="PSA 140:8">mala insa'neeka qajeelchitoxxe'e.<verse eid="PSA 140:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9" />Anee qoqqobeexxi umo toggi asseeka manna</para>
  <para style="q2" vid="PSA 140:9">insa'neke afo'o'ixxi fuggo insa'ne'ne'ninni wirri hitowwaal.<verse eid="PSA 140:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10" />Giiratik kashili insa'ne hana ibowwaal;</para>
  <para style="q2" vid="PSA 140:10">giira giddo,</para>
  <para style="q2" vid="PSA 140:10">yookaan fullabaaxxe bale</para>
  <para style="q2" vid="PSA 140:10">giddonna hunemmowwaal.<verse eid="PSA 140:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11" />Manjo summa balleessaak</para>
  <para style="q2" vid="PSA 140:11">bogake'ni hedhoqqe'e;</para>
  <para style="q2" vid="PSA 140:11">xaqartichcha manna fuggoxxi isa'nee hordoffeexxi balleessitowwaal.<verse eid="PSA 140:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12" />Duuchchi Woddik Gootti hiyyeeyyetee'e dhugaa muraaxxa,</para>
  <para style="q2" vid="PSA 140:12">rakkiyye mannika seeranna heqqisaaxxa ege'ne'eennen.<verse eid="PSA 140:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13" />Qulliyye dhugaaten, atika summa saaddaan;</para>
  <para style="q2" vid="PSA 140:13">qajeeli manninna ati edo hedhaan.<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="s1">Galgaliinxa Soodachcho Daawwitixxa Faaro.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1" />Ee, Duuchchi Woddike Goottaa; atee ye'edhaannen</para>
  <para style="q2" vid="PSA 141:1">rakke'e anibaa dagi;</para>
  <para style="q2" vid="PSA 141:1">atibaa soodatanno wodda hafuura anikanna laqi.<verse eid="PSA 141:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 141:2" />Soodachcho anixxi hixaaniinsha</para>
  <para style="q2" vid="PSA 141:2">iimi'a ke'iseennexxa anga anxa galgaalike tolchishsha assite adhdhi.<note caller="-" style="x"><char style="xo" closed="false">141:2 </char><char style="xt" closed="false"><ref loc="REV 5:8">Wal. 5:8</ref>. </char></note><verse eid="PSA 141:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3" />Ee, Duuchchi Woddike Goottaa, afo'o ankee heqqanjo uggi;</para>
  <para style="q2" vid="PSA 141:3">suume anxanna heqqi;<verse eid="PSA 141:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4" />Fuggoxxa assonnaa halchabe'noshsha,</para>
  <para style="q2" vid="PSA 141:4">fuggoxxa assaaken welti mittomabo'noshsha anee heqqi;</para>
  <para style="q2" vid="PSA 141:4">eloxxa insa'neexxa ita welti itonnaa anee waaldoxxee.<verse eid="PSA 141:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5" />Qullichchi manji anee ganowwaal, tinni ani'a eloxxen,</para>
  <para style="q2" vid="PSA 141:5">anee xixowwaal tinni umiinke buurishshaten;</para>
  <para style="q2" vid="PSA 141:5">aninna tennee gibabe'non</para>
  <para style="q2" vid="PSA 141:5">ani fuggaaleeyyetixxa huje gibati duuchchi wodda soodatannon.<verse eid="PSA 141:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6" />Hayyoole insa'nexxi bowwaakenaa'ni adadde qolaanchendaan; anki hiyyichchi dhugaate kadeexxa insa'ne egennaan.<verse eid="PSA 141:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7" />Insa'ne «Manji boga ko'ee butuchchammashsha,</para>
  <para style="q2" vid="PSA 141:7">miqe no'oxxinna iittanni moogiinxe baleke afo'o'ni xeellagendeen» hinaan.<verse eid="PSA 141:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8" />Dada Duuchchik Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 141:8">Ille anxi kinni atibaa uuda'neen;</para>
  <para style="q2" vid="PSA 141:8">ate'ni gollatannon; yoona anee waaldoxxe'e.<verse eid="PSA 141:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9" />Insa'ne ani'a fanneexxe fonxoronaa'ni</para>
  <para style="q2" vid="PSA 141:9">fuggaaleeyye ani'a uggiteexxe gufonaa'ni anee heqqi. <verse eid="PSA 141:9" /><verse number="10" style="v" sid="PSA 141:10" />Ani nage'ik sa'eenaa</para>
  <para style="q2" vid="PSA 141:10">fuggaaleeyye ifi'aanni falteemmaxxe fonxoro'ni abidenddowwaal.<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="s1">Mageniinka Gargaarsa Alfatee'e Shiqqeexxa Soodachcho</para>
  <para style="s2">Wolo'o Giddo Hedhemma Woddixxa Daawwitixxa Gence</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1" />Hafuura gikki asse'e Duuchchi Woddike Goottibaa raarannon;</para>
  <para style="q2" vid="PSA 142:1">qarqaarsake'e qonqo qeerrise Duuchchi Woddike Goottibaa soodatannon;<verse eid="PSA 142:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 142:2" />Oodhishsha anxa duuchcha isi edo dhangalaasanno;</para>
  <para style="q2" vid="PSA 142:2">rakko anixxanna isi edo ku'lannon<verse eid="PSA 142:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 142:3" />Yaadi duuchchi anenaa'n ba'aa wodda</para>
  <para style="q2" vid="PSA 142:3">ati me'injo anka egendeetten;</para>
  <para style="q2" vid="PSA 142:3">insa'ne me'annoke ora'ni</para>
  <para style="q2" vid="PSA 142:3">sho'iki fonxoro ani'aa fanne'een.<verse eid="PSA 142:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 142:4" />Middanna bita'i'aa uudee afi;</para>
  <para style="q2" vid="PSA 142:4">ani'aa ege'naaka gophenne;</para>
  <para style="q2" vid="PSA 142:4">baaje'e fulanobi hedhebaan;</para>
  <para style="q2" vid="PSA 142:4">ani'aa hedaak hedhabaan.<verse eid="PSA 142:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5" />Ee, Duuchchi Woddike Goottaa, ani atibaa raarannen;</para>
  <para style="q2" vid="PSA 142:5">«Ati anke gollan;</para>
  <para style="q2" vid="PSA 142:5">hedhoti manni hedheeke boga'ni ati anke qoobbo» hiyyenne.<verse eid="PSA 142:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6" />Anee gargaaraaka afa gopheennaxxee'e</para>
  <para style="q2" vid="PSA 142:6">raare anixxa caqasi;</para>
  <para style="q2" vid="PSA 142:6">anee shorraammaakiir jabake kadeemmaxxee</para>
  <para style="q2" vid="PSA 142:6">ati anee insa'nenaa'ni gatisi.<verse eid="PSA 142:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7" />Summa atika saadonaa</para>
  <para style="q2" vid="PSA 142:7">anee usurrakenaa'ni fulchi;</para>
  <para style="q2" vid="PSA 142:7">ani'aa eloxxa assiteettaxxee'e</para>
  <para style="q2" vid="PSA 142:7">qulliyye anke qarqara'ni qoqqobbaan.<note caller="-" style="x"><char style="xo" closed="false">142:7 </char><char style="xt" closed="false"><ref loc="1SA 22:1">1 Sam. 22:1</ref>; <ref loc="1SA 24:3">24:3</ref>. </char></note><verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="s1">Mageniinke Gargaarsixxee'e Soodachcho</para>
  <para style="s1">Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1" />Ee Duuchchi Woddike Goottaa soodachcho anxa laqi;</para>
  <para style="q2" vid="PSA 143:1">kadha anxanna caqasi</para>
  <para style="q1" vid="PSA 143:1">Xuurammeessumatinna qulluma atixxenni laqqe'e hiissichcho ani'a uwwi.<verse eid="PSA 143:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2" />Ati edo ayyinna qulichchi hedha gophemmaxxee'e</para>
  <para style="q2" vid="PSA 143:2">anee erganjo atike'n murtoxxe'e.<note caller="-" style="x"><char style="xo" closed="false">143:2 </char><char style="xt" closed="false"><ref loc="ROM 3:20">Rom. 3:20</ref>; <ref loc="GAL 2:16">Gel. 2:16</ref>. </char></note><verse eid="PSA 143:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3" />Naaphi anee shiyo'a shorre;</para>
  <para style="q2" vid="PSA 143:3">hedho anxa butta ibise;</para>
  <para style="q2" vid="PSA 143:3">edo reyeeke mannishsha</para>
  <para style="q1" vid="PSA 143:3">dukkana giddo ofo'lannoshsha anee asse.<verse eid="PSA 143:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4" />Tennexxee yaadi ankinna ani giddo wexeqeme</para>
  <para style="q2" vid="PSA 143:4">godobi anee alaye.<verse eid="PSA 143:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5" />Bireka baro qaabbatannon;</para>
  <para style="q2" vid="PSA 143:5">huje atixxa duuchcha hede herregee</para>
  <para style="q2" vid="PSA 143:5">atixxe angaxxa hujenna higgeggeenni hedannon.<verse eid="PSA 143:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6" />Anga anixxanna atibaa farri asseennen;</para>
  <para style="q2" vid="PSA 143:6">bago bogishsha</para>
  <para style="q2" vid="PSA 143:6">lubbo anxinna atee dheebotte.<verse eid="PSA 143:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7" />Ee Duuchchi Woddike Gootta rekke ani'a hiissichcho uwwi;</para>
  <para style="q1" vid="PSA 143:7">Bale giddii'a me'ammake mannishsha kadannon;</para>
  <para style="q1" vid="PSA 143:7">Alba atika aneenaa'ni sho'exxoxxe'e.<verse eid="PSA 143:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8" />Ani atee addateennaxxee'e</para>
  <para style="q2" vid="PSA 143:8">duuchchi woddixxa atixxa jaalala gorsa gorsa ege'nannoshsha assi;</para>
  <para style="q2" vid="PSA 143:8">anxi lubbo atee addatamaxxee'e</para>
  <para style="q2" vid="PSA 143:8">me'annoka ora ani'a leellishshi.<verse eid="PSA 143:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9" />Ee Duuchchi Woddike Goottaa ate'ni gollateennaxxee'e</para>
  <para style="q2" vid="PSA 143:9">naapha ankenaa'ni anee gatisi.<verse eid="PSA 143:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10" />Ati anke Mageno kaddetaxxee'e</para>
  <para style="q2" vid="PSA 143:10">fedhii atixxa muuxonna'a anee barachchiis;</para>
  <para style="q2" vid="PSA 143:10">atiki elok hafuuri qajeela ora'n anee akeekowwaal.<verse eid="PSA 143:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11" />Ee Duuchchi Woddike Goottaa summa atikee hite'e</para>
  <para style="q1" vid="PSA 143:11">Hedhoti anee uggi;</para>
  <para style="q1" vid="PSA 143:11">Qullumma atixxenni lubbo anxa rakkotenaa'n fulchi.<verse eid="PSA 143:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12" />Atixxe duuchchi woddixxe jaalala'a</para>
  <para style="q2" vid="PSA 143:12">naapha ankanna biri;</para>
  <para style="q1" vid="PSA 143:12">Ani atike erganjo kadennaxxee'e</para>
  <para style="q1" vid="PSA 143:12">diina anka balleessi.<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="s1">Injiffachchotixxa Faaro</para>
  <para style="s2">Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1" />Anga anxa bagedokee,</para>
  <para style="q2" vid="PSA 144:1">qubba anxanna lolakee leenjiseek</para>
  <para style="q2" vid="PSA 144:1">rassa anxi Duuchchi Woddik Gootti saademowaal.<verse eid="PSA 144:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2" />Isi eeyyallo anke Magenonna</para>
  <para style="q2" vid="PSA 144:2">jabake gollan,</para>
  <para style="q2" vid="PSA 144:2">anee anjiraake anke gollaan;</para>
  <para style="q2" vid="PSA 144:2">iso'ni gollatannoxxe anxe wonte,</para>
  <para style="q2" vid="PSA 144:2">ardikinna ani'a hiremaashsha assaak isoten.<verse eid="PSA 144:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3" />Ee Duuchchi Woddike Goottaa, isi'a xexxe'attotta'a isi manjiingi maachchoo?</para>
  <para style="q2" vid="PSA 144:3">Isi'a heddotta'a isinni manjiink belti maachcho?<note caller="-" style="x"><char style="xo" closed="false">144:3 </char><char style="xt" closed="false"><ref loc="JOB 7:17-18">Iyo. 7:17-18</ref>; <ref loc="PSA 8:4">Far. 8:4</ref>. </char></note><verse eid="PSA 144:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4" />Manji hafuuriinshaten,</para>
  <para style="q2" vid="PSA 144:4">bari iskinna saxxammaxxe gaadiddoshshaten.<verse eid="PSA 144:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5" />Ee Duuchchi Woddike Goottaa,</para>
  <para style="q2" vid="PSA 144:5">iima benqe assite'e butti'a dirri;</para>
  <para style="q2" vid="PSA 144:5">wiliildo'a koobuwwatanna tuqi.<verse eid="PSA 144:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6" />Banqotanna balaqqisse'e naapha xeer,</para>
  <para style="q2" vid="PSA 144:6">mogidduwwa atika darbate'e insa'nee bogii'n fulchi.<verse eid="PSA 144:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7" />Iim'ni anga Atixxa butti'a diriirsi;</para>
  <para style="q2" vid="PSA 144:7">jabake wode'enaa'ni</para>
  <para style="q2" vid="PSA 144:7">alaguwwiinxe anganaa'ninna anee fulchite'e anjir.<verse eid="PSA 144:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8" />Afo'o insa'neekenni dhara calla haassonnaan,</para>
  <para style="q2" vid="PSA 144:8">middixxa anga insa'nexxa iimi'a ke'issine'e kakantaak dharkiten.<verse eid="PSA 144:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9" />Ee Mageno, haaroxxa faaro ati'a faarsannon;</para>
  <para style="q2" vid="PSA 144:9">tomme jimmaateke baganninni ati'a faaro faarsannon.<verse eid="PSA 144:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10" />Ati moyanijuwwaakee injiffachcho uuttatton;</para>
  <para style="q2" vid="PSA 144:10">erganjo atika Daawwitii'i shiyaake wolaantichchanaa'ni gattissatton.<verse eid="PSA 144:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11" />Afo'i insa'nek dhara haaso'aake,</para>
  <para style="q2" vid="PSA 144:11">middixxa anga iimi'a ke'isseexxi dhark kakataake</para>
  <para style="q2" vid="PSA 144:11">alagi mannixxe anganaa'ni anee anjir.<verse eid="PSA 144:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12" />Labbaxxi no'oxxi oose dargageessummate'ni</para>
  <para style="q2" vid="PSA 144:12">elo qico kadee nophphammake hiddichchishsha kaddowwaal;</para>
  <para style="q2" vid="PSA 144:12">meyyaxxi no'oxxi oosenna mootummatika mine dancheessatee'e</para>
  <para style="q2" vid="PSA 144:12">bocemeemmake kasi kasiinke utuphuwwishsha kaddowwaal.<verse eid="PSA 144:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13" />Doonuwwa no'oxxe'n gargar gargar hexxeexxi midha wo'mitowwaal;</para>
  <para style="q2" vid="PSA 144:13">gedhebi no'ok kumuwwik,</para>
  <para style="q2" vid="PSA 144:13">tomme kumuwwinni no'oke diida'n horowwaal.<verse eid="PSA 144:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14" />Hori no'oki alfowwaal;</para>
  <para style="q2" vid="PSA 144:14">rimo'a ibisoqe'e, hore bira sa'owwaal;</para>
  <para style="q2" vid="PSA 144:14">no'onna booji'eemmonnoqqe'e;</para>
  <para style="q2" vid="PSA 144:14">oruwwa no'oke'ninna yaadotixxi oodhishsha laqendoqqe'e.<verse eid="PSA 144:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15" />Tinni eebba insa'nexxe kadde'eeke ardixxa wodo;</para>
  <para style="q2" vid="PSA 144:15">Duuchchi woddik Gootti insa'neke Mageno kade'eeke ardixxa wodo.<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="s1">Galatiinxa Saadino</para>
  <para style="s2">Daawwitixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1" />Anke Magenonnaa anke moyanjoo!</para>
  <para style="q2" vid="PSA 145:1">Ani lumminne atika haaso'annon;</para>
  <para style="q2" vid="PSA 145:1">summa atikanna duuchchi woddi'a saadannon.<verse eid="PSA 145:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2" />Bara bara'ni atee saadannon;</para>
  <para style="q2" vid="PSA 145:2">summa atikanna duuchchii woddi'a saadannon.<verse eid="PSA 145:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3" />Duuchchi Woddik Gootti lumoken;</para>
  <para style="q2" vid="PSA 145:3">lumo qiconna saademaaken;</para>
  <para style="q2" vid="PSA 145:3">lumminee isikanna qorqorreexxi dhaqqanbaba'a.<verse eid="PSA 145:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4" />Mitte ila, itti aandaaxxe illa'n atixxa huje saaddaan;</para>
  <para style="q2" vid="PSA 145:4">atixxa mambe'iinxa hujuwwanna lallabbaan.<verse eid="PSA 145:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5" />Insa'ne atike gaachchannixxe danchumaxxanna atike uulfinnixxa haassonnaan;</para>
  <para style="q2" vid="PSA 145:5">aninna atixxa mambe'iinxa hujuwwa hige higee'e hedannon.<verse eid="PSA 145:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6" />Insa'nee atixxe mambe'iinxe hujexxa hunna haassonnaan;</para>
  <para style="q2" vid="PSA 145:6">aninna atika lumminne odeessannon.<verse eid="PSA 145:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7" />Atixxe arjummaxxe bira sa'nexxee'e jila jilaani;</para>
  <para style="q2" vid="PSA 145:7">atixxe qullummaxxeenna illillisati faarsinaan.<verse eid="PSA 145:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8" />Duuchchi Woddik Gootti arjakenna o'waaken;</para>
  <para style="q2" vid="PSA 145:8">mufe dande'aakenna jaalala isixxi bira saxxeeken.<verse eid="PSA 145:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9" />Duuchchi Woddik Gootti duuchchiingee'e eloken;</para>
  <para style="q2" vid="PSA 145:9">dada ifixxa duuchchi'aanna o'waaken.<verse eid="PSA 145:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10" />Ee, Duuchchi Woddike Goottaa!</para>
  <para style="q2" vid="PSA 145:10">Dada atixxi duuchchi atee saaddaan;</para>
  <para style="q2" vid="PSA 145:10">atik ardinna atee kubisaan.<verse eid="PSA 145:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11" />Insa'ne, atixxe moottummaka gaachchanna odeesinaan;</para>
  <para style="q2" vid="PSA 145:11">atixxe hunnaxxanna haassonnaan.<verse eid="PSA 145:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12" />Konne qicinni ardi duuchchi</para>
  <para style="q2" vid="PSA 145:12">atixxa mambe'iinxa hujuwwanna</para>
  <para style="q2" vid="PSA 145:12">atixxe mootummake, gaachchannika lumminne ege'naan.<verse eid="PSA 145:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13" />Atixxi mootumma duuchchii woddixxe mootumman;</para>
  <para style="q2" vid="PSA 145:13">galcha atixxinna ila ilateeten;<verse eid="PSA 145:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14" />Duuchchi Woddik Gootti ibaakaaranna kiphaan;</para>
  <para style="q2" vid="PSA 145:14">ibeekaaranna ke'issaan.<verse eid="PSA 145:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15" />Duuchchiinxi ille heqecati atiba'a uddaan;</para>
  <para style="q2" vid="PSA 145:15">atinna ita insa'ne'a yannate'n uuttatton.<verse eid="PSA 145:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16" />Ati anga atixxa farri assittatton;</para>
  <para style="q2" vid="PSA 145:16">dada duuchchixxa halchanna goddissatton.<verse eid="PSA 145:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17" />Duuchchi Woddiki Gootti ora ifike duuchcha'n qullichchaken;</para>
  <para style="q2" vid="PSA 145:17">assaaxxe duudhcha'ninna arjaken.<verse eid="PSA 145:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18" />Duuchchi Woddik Gootti ye'edhaake duuchchi'a,</para>
  <para style="q2" vid="PSA 145:18">dhugaati isoo'o ye'edhaake duuchchi'a isi shiqiken.<verse eid="PSA 145:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19" />Isi isoo sodaataakixxa halchcha duuchcha wonshaan;</para>
  <para style="q2" vid="PSA 145:19">raare insa'nexxa laqeexxi insa'nee anjiraan.<verse eid="PSA 145:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20" />Duuchchi Woddik Gootti isoo sodaataakaara heqaan;</para>
  <para style="q2" vid="PSA 145:20">fuggaalleeyye duuchcha kinni balleessaan.<verse eid="PSA 145:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21" />Afo'i ank Duuchchi Woddike Goottixxa saadino haaso'aan;</para>
  <para style="q2" vid="PSA 145:21">dada duuchchinna isika woyyichcha summa</para>
  <para style="q2" vid="PSA 145:21">duuchchii woddi'a saaddowwaal.<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="s1">Anjirallo Mageno Saadaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1" />Haallee luya;</para>
  <para style="q2" vid="PSA 146:1">Tee anxe lubbo Duuchchi Woddika Gootta saadi.<verse eid="PSA 146:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2" />Ani anxe hedhoke baro duuchcha'n Duuchchi Woddika Gootta saadannon;</para>
  <para style="q2" vid="PSA 146:2">hedhenneke baro duuchcha'ninna Mageno anka faarsannon.<verse eid="PSA 146:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3" />Anjira dande'abaake galchalluwwa'ni</para>
  <para style="q2" vid="PSA 146:3">yookaan manjiinke belto'ni amandinoqqe'e.<verse eid="PSA 146:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4" />Hafuur insa'ne giddii'ni fullaaxxa yanna,</para>
  <para style="q2" vid="PSA 146:4">insa'ne buttinage'ni hingaan;</para>
  <para style="q2" vid="PSA 146:4">eetteeneen barra yaadi insa'nek duuchchinna ba'aan.<verse eid="PSA 146:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5" />Ya'iqoobik Mageni isike gargaarsa kade'eeke</para>
  <para style="q2" vid="PSA 146:5">Duuchchi Woddika Gootta ifike Mageno'ni addataake manjixa wodo.<verse eid="PSA 146:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6" />Duuchchi Woddik Gootti iimanna butta,</para>
  <para style="q2" vid="PSA 146:6">abbaayyatanna ise giddo hedheechcho dadeek</para>
  <para style="q2" vid="PSA 146:6">xuurameessumma ifixxanna duuchchi woddi'a heqqedhaaken.<note caller="-" style="x"><char style="xo" closed="false">146:6 </char><char style="xt" closed="false"><ref loc="ACT 4:24">Erga. Huj. 4:24</ref>; <ref loc="ACT 14:15">14:15</ref>. </char></note><verse eid="PSA 146:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7" />Duuchchi Woddik Gootti miiceemeekee'e muraake;</para>
  <para style="q2" vid="PSA 146:7">solo'weekeenna ita uwwaan;</para>
  <para style="q2" vid="PSA 146:7">isi usuremeeka manna tikeexxi fulchaan.<verse eid="PSA 146:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8" />Duuchchi Woddik Gootti balla'uwwa baqqi assaan;</para>
  <para style="q2" vid="PSA 146:8">heeshshi hiyyeeka manna qokki assaan;</para>
  <para style="q2" vid="PSA 146:8">qulliyyetanna eeyyaan.<verse eid="PSA 146:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9" />Duuchchi Woddiki Gootti annafee boga'n hedheeka manna heqqaan;</para>
  <para style="q2" vid="PSA 146:9">anna ama affebaaxxa oosenna aro'i reyeexxa melaalle qarqaaraan;</para>
  <para style="q2" vid="PSA 146:9">fuggaaleeyyetika ora kinni balleessa.<verse eid="PSA 146:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10" />Duuchchi woddiki Gootti duuchchii woddi'a moyaan;</para>
  <para style="q2" vid="PSA 146:10">Tee, Tsiyooni atik Mageni ila ila duuchcha'ni moyaan.</para>
  <para style="b" vid="PSA 146:10" />
  <para style="q2" vid="PSA 146:10">Hallee luya.<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="s1">Lumoka Mageno Galateefataa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1" />Hallee luya</para>
  <para style="q2" vid="PSA 147:1">Duuchchi Woddika Gootta no'oka Mageno faaroti saada hittatta eloxxe;</para>
  <para style="q1" vid="PSA 147:1">Isoo saada gammachchiisaxxenna hassissaaxxen.<verse eid="PSA 147:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2" />Duuchchi Woddik Gootti Iyyerusaalemii'i qammalchaan;</para>
  <para style="q2" vid="PSA 147:2">xexxeerememmaka Isira'eelika ardanna hiissaan.<verse eid="PSA 147:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3" />Isi yaaddoti qalbe madooteekaara fayyisaan;</para>
  <para style="q2" vid="PSA 147:3">mada insa'neexxanna usura.<verse eid="PSA 147:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4" />Isi urjuwwatike laakkossika qixxa ege'ne'een;</para>
  <para style="q2" vid="PSA 147:4">mitte mittenda summi summinninni ye'aan.<verse eid="PSA 147:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5" />No'ok Dada Duuchchik Gootti lumoken; lumo qiconna hunnaameessaken;</para>
  <para style="q2" vid="PSA 147:5">beekkumi isikinna konnete hiyyemeexxi eg'nemabaan.<verse eid="PSA 147:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6" />Duuchchi Woddik Gootti shaqqaka manna lummisaan;</para>
  <para style="q2" vid="PSA 147:6">fuggaaleeyye kinni butti'a hiissaan.<verse eid="PSA 147:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7" />Duuchchi Woddike Gootti'a galatiinxa faaro faarse;</para>
  <para style="q2" vid="PSA 147:7">baganakanna gandinaa'n no'oka Mageno faarse.<verse eid="PSA 147:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8" />Isi dhisendeexxa iima duumanchchik buqaan;</para>
  <para style="q2" vid="PSA 147:8">buttatee'e xeena uwwan;</para>
  <para style="q2" vid="PSA 147:8">koobuwwate'ninna arso latisaan.<verse eid="PSA 147:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9" />Isi horekee'e itaachcho,</para>
  <para style="q2" vid="PSA 147:9">qophpheesa;</para>
  <para style="q2" vid="PSA 147:9">qodhandiinxi beltanuwwa cabuluqaa woda,</para>
  <para style="q1" vid="PSA 147:9">ittaachcho uwwaan.<verse eid="PSA 147:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10" />Isi fadhadiinxe hunna'ni,</para>
  <para style="q2" vid="PSA 147:10">yookaan gongaake manjike jabeenne'n gammadabaan.<verse eid="PSA 147:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11" />Yaane kinni Duuchchi Woddika Gootta isoo sodaataake manna'n</para>
  <para style="q2" vid="PSA 147:11">duuchchii woddixxe isixxe jaalala'ninna addata'neekeera'ni gammadaan.<verse eid="PSA 147:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12" />Tee, Iyyerusaalemii, Duuchchi Woddika Gootta saadi;</para>
  <para style="q2" vid="PSA 147:12">Tee, Tsiyoonii Mageno atika lummisi.<verse eid="PSA 147:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13" />Isi atixxe huluwwaka danqarisanjuwwa jabeessaan;</para>
  <para style="q2" vid="PSA 147:13">ati giddika ardanna eebbissaan.<verse eid="PSA 147:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14" />Isi gabala atixxee nage'aa uwwa;</para>
  <para style="q2" vid="PSA 147:14">eloxxe dinnenninna atee goddisa.<verse eid="PSA 147:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15" />Isi ajaja ifika butti'a erga;</para>
  <para style="q2" vid="PSA 147:15">hiyyichchi isikinna hirbange'n muuxema.<verse eid="PSA 147:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16" />Isi kaade fuuttiinsha fawa;</para>
  <para style="q2" vid="PSA 147:16">qorrakanna bululiinsha xeera.<verse eid="PSA 147:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17" />Isi kaade iimi'n kinuffa harcaasa;</para>
  <para style="q2" vid="PSA 147:17">isi ibiseeke qori edo ayyete dande'e uurraa?<verse eid="PSA 147:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18" />Isi hiyyichcho ifika ergaa'naa kaadetinna baqqa;</para>
  <para style="q2" vid="PSA 147:18">diidallo ifixxanna diidalleessaan, itti kaadenna wode'e kaddeexxi yaata.<verse eid="PSA 147:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19" />Isi hiyyichcho ifika Ya'iqoobixxe horte'n</para>
  <para style="q2" vid="PSA 147:19">seerakanna ajaja ifika Isira'eeli'n haaso'a.<verse eid="PSA 147:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20" />Tennee'e wele gosa gosake ardi'a asse'eexxebaan;</para>
  <para style="q2" vid="PSA 147:20">insa'nenna seera sika egennebaan.</para>
  <para style="b" vid="PSA 147:20" />
  <para style="q1" vid="PSA 147:20">Hallee luya.<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="s1">Dada Duuchchi, Duuchchi Woddika Gootta Saaddowwal</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1" />Hallee luya;</para>
  <para style="q2" vid="PSA 148:1">Duuchchi Woddika Gootta iimatenaa'ni saadde;</para>
  <para style="q2" vid="PSA 148:1">ale iimuwati giddo isoo saadde.<verse eid="PSA 148:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2" />Erganna isixxi duuchchi,</para>
  <para style="q2" vid="PSA 148:2">iima hexxineek isik lollalluwwi isoo saadde.<verse eid="PSA 148:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3" />Arishshotinna agenji</para>
  <para style="q2" vid="PSA 148:3">ha'noo ifisinaaxxi urjuwwa duuchcha isoo saadde.<verse eid="PSA 148:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4" />Ha'noo alixxi iimuwwanna</para>
  <para style="q2" vid="PSA 148:4">dhiseendeexxe iimmuwwa giddo hexxineek wodde'uwwi</para>
  <para style="q2" vid="PSA 148:4">isoo saadde.<verse eid="PSA 148:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5" />Isi ajajee'naa'a dademmeemmaxxee'e</para>
  <para style="q2" vid="PSA 148:5">kunni duuchchiingechchi, Duuchchi Woddike Goottika summa saadowwaal.<verse eid="PSA 148:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6" />Isi konneechchuwwa jabeesseexxi duuchchii woddi'a bakka bakka'n ofo'lshe'e</para>
  <para style="q2" vid="PSA 148:6">duuchchii woddi'a sa'abaaka seera uwwe.<verse eid="PSA 148:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7" />Ha'noo abbaayya lumoxxe giddixxi lumolla daduwwanna</para>
  <para style="q2" vid="PSA 148:7">dhi'moo wodi'uwwi duuchchi</para>
  <para style="q2" vid="PSA 148:7">Duuchchi Woddika Gootta buttatenaa'ni saadde.<verse eid="PSA 148:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8" />Balaqikinna kaade, qorrikinna duumanchuwwi,</para>
  <para style="q2" vid="PSA 148:8">ajaja isika muuxxattoxxi hobonbalte,<verse eid="PSA 148:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9" />koobuwwatinna tullichchiwwi,</para>
  <para style="q2" vid="PSA 148:9">gummatik haqichchuwwinna birbrsuwwi duuchchi,<verse eid="PSA 148:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10" />bada'atik biniinchinna hori duuchchi,</para>
  <para style="q2" vid="PSA 148:10">godobiki me'aachchi shiixxarammichchuwwinna keelik kexxaaxxi ci'a,<verse eid="PSA 148:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11" />buttatiki moyanjuwwinna gosa gosak ardi duuchchi,</para>
  <para style="q2" vid="PSA 148:11">jalqaabuwwikinna buttatik galchaluwwi duuchchi,<verse eid="PSA 148:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12" />Dargageeyyetinna dubarri,</para>
  <para style="q2" vid="PSA 148:12">geedhetinna oose Duchchi Woddika Gootta saadde.<verse eid="PSA 148:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13" />Summi isik calli lummedhe'e quba sa'eeke kadeemmaxxeenna</para>
  <para style="q2" vid="PSA 148:13">gaachchanni isiki buttate'ninna iimati hana hedheemmaxxee'e</para>
  <para style="q2" vid="PSA 148:13">kunnichchiwwi duuchchi, Duuchchi Woddike Goottika summa saadowwaal.<verse eid="PSA 148:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14" />Isi arda ifikee'e jabeenna uwwe;</para>
  <para style="q2" vid="PSA 148:14">arda isike duuchchi,</para>
  <para style="q2" vid="PSA 148:14">isik shiqik Isira'eeli ardi,</para>
  <para style="q2" vid="PSA 148:14">Duuchchi Woddika Gootta saadowwaal.</para>
  <para style="q1" vid="PSA 148:14">Hallee luya.<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="s1">Saadinotixxa Faaro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1" />Hallee luya;</para>
  <para style="q2" vid="PSA 149:1">Duuchchi Woddika Gootta saaddee!</para>
  <para style="q2" vid="PSA 149:1">Duuchchi Woddike Gootti'a haaroxxa faaro faarsee!</para>
  <para style="q2" vid="PSA 149:1">Saadinotanna isike ardixxe bukki giddo isoo saaddee!<verse eid="PSA 149:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2" />Isira'eelik ardi ifikee dadalli'a gammadowwaal;</para>
  <para style="q2" vid="PSA 149:2">Tsiyooni ardinna ifikee moyanji'a illillisowwaal.<verse eid="PSA 149:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3" />Kumbullisati</para>
  <para style="q2" vid="PSA 149:3">okolekanna begena gannati</para>
  <para style="q2" vid="PSA 149:3">insa'ne Duuchchi Woddike Goottika summa saandowwaal.<verse eid="PSA 149:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4" />Duuchchi Woddik Gootti arda ifike'ni gammadaammaxxee'e</para>
  <para style="q2" vid="PSA 149:4">isi shaqqake manni'a injiffachcho uwwati insa'nee ulfeessaan.<verse eid="PSA 149:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5" />Mageniink ardi tennee injiffachcho'ni gammadowwaal;</para>
  <para style="q2" vid="PSA 149:5">hashsha duuchchanna gammashshoti faarsowwaal.<verse eid="PSA 149:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6" />Lame qarka wolaantichcha anga abixxineexxi</para>
  <para style="q2" vid="PSA 149:6">afo'o insa'nekenni Mageno saanda'ni galateeffantowwaal.<verse eid="PSA 149:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7" />Iitta assati gosa gosaka arda injifantaan;</para>
  <para style="q2" vid="PSA 149:7">ardakanna xinxaan.<verse eid="PSA 149:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8" />Insa'neka moyanjuwwa sibiljiinke haachchabinni</para>
  <para style="q2" vid="PSA 149:8">ja'laabuwwa insa'nekanna lekkatike sibiljinni usuraan.<verse eid="PSA 149:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9" />Tinninna insa'nexxee'e borresendeexxa murte muuxateeten;</para>
  <para style="q2" vid="PSA 149:9">tinni arda isike duuchchi'a gaachchanaken;</para>
  <para style="q1" vid="PSA 149:9">Hallee luya.<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="s1">Galatiinxa Faafo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1" />Hallee luya</para>
  <para style="q2" vid="PSA 150:1">Mageno isixxe woyyitte bakka giddo saaddee;</para>
  <para style="q2" vid="PSA 150:1">isixxe hunnameette dhisendeexxe iimuwwaxxee'e isoo saaddee.<verse eid="PSA 150:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2" />Isixxe lumoxxe hujexxee'e isoo saaddee;</para>
  <para style="q2" vid="PSA 150:2">yo'oshsha lumoke kadeemmaxxee'e isoo saaddee.<verse eid="PSA 150:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3" />Malagatik isoo saaddee;</para>
  <para style="q2" vid="PSA 150:3">baganikinna masinqoti isoo saaddee.<verse eid="PSA 150:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4" />Okolikinna kunbulsati isoo saaddee;</para>
  <para style="q2" vid="PSA 150:4">kiraarikinna suusu'leti isoo saaddee.<verse eid="PSA 150:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5" />Qililisaake sibilinni isoo saaddee;</para>
  <para style="q2" vid="PSA 150:5">adda qiqqilisaake sibiluwwinni isoo saaddee.<verse eid="PSA 150:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6" />Hedho affeexxi dada duuchcha</para>
  <para style="q2" vid="PSA 150:6">Duuchhci Woddika Gootta saaddowwaal;</para>
  <para style="q1" vid="PSA 150:6">Hallee luya.<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>