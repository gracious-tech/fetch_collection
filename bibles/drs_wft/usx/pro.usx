<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Gedeo Bible</book>
  <para style="h">Mammaassiinkaa Maxaafa</para>
  <para style="toc1">Mammaassiinkaa Maxaafa</para>
  <para style="toc2">Mammaassiinkaa Maxaafa</para>
  <para style="toc3">Mam.</para>
  <para style="mt1">Mammaassiinkaa Maxaafa</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Mammaassiinkaa Maxaafa, mammaassinkenninna fakkeenniinke haaso'inni qophphessemeeke eloke adabikenna addetixxe barannokeni. Kunn Maxaafi yo'ooshsha kulaaxxi barratixxe hedhdho'n geltaaxxe yaanuwwani; «Ege'natiki ke'inji Mageno sodaatateni» hiyyaaka seera qalli assati safaani; barachchiisa'neechchinna amanatike adaba calla kadebaaki; manji barratixxe hedho'n muuxa hasisaaki eloki adabinna eloxxe hujenni weltiteni. Konne Maxaaf giddo shaqquntetixxa, ossuntetixxa, marartetixxanna addatenshatixxa heddo baranno fakkeenniki uuwwendeeni.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Fakkennuwwa heene bifanni la'oofantannoxxa <char style="ior"><ref loc="PRO 1:1-7">1:1-7</ref> </char></para>
  <para style="io1">Beekkuma harsatee uwwemeeka gorsa <char style="ior"><ref loc="PRO 1:8-7:27">1:8—7:27</ref> </char></para>
  <para style="io1">Beekkuma faarsedhdhatixxa faaro <char style="ior"><ref loc="PRO 8:1-9:1">8:1—9:1-18</ref> </char></para>
  <para style="io1">Solomoon mammaasik haaso'eka mammaasuwwa <char style="ior"><ref loc="PRO 10:1-29:27">10:1—29:27</ref> </char></para>
  <para style="io1">Aguuri haaso'eeka haaso'uwwa <char style="ior"><ref loc="PRO 30:1-33">30:1-33</ref> </char></para>
  <para style="io1">Limu'eelxi Ama belto iseke barachchiisseexxa baranno <char style="ior"><ref loc="PRO 31:1-31">31:1-31</ref> </char></para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s1">Muxxummatike Haaso'iixxa La'o</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 1:1" />Isira'eelika moyanjo, Daawwitika belto, Solomooni mammaassuwwa<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1KI 4:32">1 Moy. 4:32</ref>. </char></note><verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />Muxxumma la'oofatateenna cabbematee,</para>
  <para style="q2" vid="PRO 1:2">ege'natika hiyyichchuwwa qalbeeffachchotee;<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />Iittanni qullummanna seeriinxanna toggitte murte uwwatee;</para>
  <para style="q2" vid="PRO 1:3">cabbendeexxa muxxe hedho hedhatee,<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />Oosommataake manni'a qalbeffachcho,</para>
  <para style="q2" vid="PRO 1:4">reefixxe oose'a ege'natanna elo yo'ooxxa gargari mellatee;<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />Beekkole tennee laqqeexxi barachchonde'n barachcho lephphituun;</para>
  <para style="q2" vid="PRO 1:5">qalbeeffataakiirinna akkeette alfuun.<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />Tinninna beekkoletika mammaassuwwanna fakkeennuwwiinxa tika,</para>
  <para style="q2" vid="PRO 1:6">hiyyichchuwwakanna hiibbuwwa qalbeeffantaashshaten.<verse eid="PRO 1:6" /></para>
  <para style="s1">Dargaggeeyyetee Gorsa</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />Duuchchi Woddika Gootta sodaata muxxummatike ke'iton;</para>
  <para style="q2" vid="PRO 1:7">balalichchi manni kinni muxxummatanna cabbema tuffataani.<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="JOB 28:28">Iyo. 28:28</ref>; <ref loc="PSA 111:10">Far. 111:10</ref>; <ref loc="PRO 9:10">Mam. 9:10</ref>. </char></note><verse eid="PRO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />Anke beltoo! Atike annika gorsa caqasi;</para>
  <para style="q2" vid="PRO 1:8">ama atixxi uuttaaxxa barachchiisanna gibboxxe'e.<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />Isenna ati'a ulfinna lebammake umiinke kallachchishshanna,</para>
  <para style="q2" vid="PRO 1:9">gooba atika danchoossitammaxxe ellellashshaten.<verse eid="PRO 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />Anke beltoo! Cubballeeyye atee maxxissoole,</para>
  <para style="q2" vid="PRO 1:10">ishshi hitoxxe'e.<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />Insa'nenna atee, «Munde dunatee'e,</para>
  <para style="q2" vid="PRO 1:11">no'onni welti amo rinphoo,</para>
  <para style="q2" vid="PRO 1:11">balleessa afebaake manji'a sho'ommennexxi fonxoro ugginoo!<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />Hirreesiinxe, bale giddo sa'nammashsha,</para>
  <para style="q2" vid="PRO 1:12">lubbondinni he'nee'naa insa'nee liqiinsinoo!<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />No'onna yo'oshsha fiixeeka bifa bifaka mi'yuwwa alfinannoni; saammenechchooranna mine no'oke'n wo'nshe'nannon,<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />No'oni welti guddi;</para>
  <para style="q1" vid="PRO 1:14">Saammennexxa karranna atinni qoodemmannon» hinoole;<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />Anke beltoo! Insa'nenni welti me'itoxxe'e;</para>
  <para style="q2" vid="PRO 1:15">me'inaake oranaa'ninna lekka atixxa hoyyedhi.<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />Lekka insa'neexxinna cubbotibaa gongitaan;</para>
  <para style="q2" vid="PRO 1:16">munde dunateenna wiinandaan.<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />Ci'a uuddaa'naa'a uggendeexxi fonxoro,</para>
  <para style="q2" vid="PRO 1:17">toliinxen;<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />Yaane kinni kunni manni ripheedheeki ifike uminxe munde'niten;</para>
  <para style="q2" vid="PRO 1:18">gaanda'neekinna ifinge umo calla'nten.<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />Seeri belo ifike umixxe la'o'aa gongaakeerik muuxami iittanden;</para>
  <para style="q2" vid="PRO 1:19">itti bukki asse'nemmaxxi karranna,</para>
  <para style="q2" vid="PRO 1:19">lubbo insa'neexxa aaxxee saxxaan.<verse eid="PRO 1:19" /></para>
  <para style="s1">Muxxumma Gibaakeeri'a Uwwendeexxa Xexxe'achchiisa</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />Muxxumma orake'n hexxee yexxa'neen;</para>
  <para style="q2" vid="PRO 1:20">weldeennatenaa'ninna ifika hafuura gikki assitee laqissa'neen.<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />Canci bira sa'eeke boonchonaa'n yexxa'neen;</para>
  <para style="q2" vid="PRO 1:21">ookkone qachchi giddi'a e'yatixxe hula'ni hexxe:<note caller="-" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="PRO 8:1-3">Mam. 8:1-3</ref>.</char></note><verse eid="PRO 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />«Ha'no ege'na xe'yiteekiir! Haani qici'a xe'ya ege'naaka ha'nooka ora eettinaa?</para>
  <para style="q2" vid="PRO 1:22">Gacifataakiir gacifachchote'n gammada'neek,</para>
  <para style="q2" vid="PRO 1:22">gowwooletinna ege'na gibaak haani qici'aate?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />Xixichcho anka laqqina'neele,</para>
  <para style="q2" vid="PRO 1:23">yaada anka silaat ha'noo giddo uggannan;</para>
  <para style="q2" vid="PRO 1:23">ank hiyyichchinna silaat ha'noo'n ege'nemaashsha assannan.<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />Yaane kinni ye'enne wodda gibbinemmaxxee'e,</para>
  <para style="q2" vid="PRO 1:24">anga farri assenne woddanna ayyinna macci hiyyeek hedha gophemmaxxee'e,<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />Gorsa anka duuchcha bashshi hitnemmaxxee'e;</para>
  <para style="q2" vid="PRO 1:25">anka xixichchonna adhdha gophinemmaxxee'e,<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />Tennexxee rakko ha'noo'ni geltaa wodda ani ha'noo'ni oso'lannon;</para>
  <para style="q2" vid="PRO 1:26">ba'ne ha'nooni dagaa wodda ani ha'noo'n gacifatannon.<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />Ba'ne ha'noo danbala'iinsha wishshaa wodda,</para>
  <para style="q2" vid="PRO 1:27">rakkotinna ha'noo hobonbaltetishsha filtaa wodda,</para>
  <para style="q2" vid="PRO 1:27">wixxirri hiyyatinna abari ha'noo'ni dagaa wodda ha'no'ni gacifatannon.<verse eid="PRO 1:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />«Ookkone wodda anee yexxinaan; ani kinni hee hiyyabe'non;</para>
  <para style="q2" vid="PRO 1:28">jaba qicinni anee halsinaani yaane kinni anee'e alfinabaan.<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />Ege'na ginbemmaxxee,</para>
  <para style="q2" vid="PRO 1:29">Duuchchi Woddike Gootta sodaata melledha gonpheemmaxxee'e,<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />Gorsa anka adhdha eeyya gonpheemmaxxee'e,</para>
  <para style="q2" vid="PRO 1:30">anka xixichchonna tuffanteemmaxxee'e,<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />Tennexxee insa'ne ifike orixxa gumma indaan,</para>
  <para style="q2" vid="PRO 1:31">ifike yaadika hiranna adhdhinaan.<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />Ege'na xe'iteekaara beekkumakenaa'n bayyata insa'nexxi insa'nee shiltaan,</para>
  <para style="q2" vid="PRO 1:32">gowwoletanna bashshi hiyya insa'neexxi insa'nee balleesitaan.<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />Yaane kinni anxa laqaak duuchchi nage'ik hedhaan,</para>
  <para style="q2" vid="PRO 1:33">rakkotixxe ruphphinaa'ninna gataan.»<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">Beekkumakenaa'n Afendaaxxa La'o</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />Anke beltoo! Anka hiyyichcho adhdhitottole,</para>
  <para style="q2" vid="PRO 2:1">anka ajajanna godoba atike'n galchexxottole,<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />Mansha atixxi beekuma caqqassaashsha assexxottole,</para>
  <para style="q2" vid="PRO 2:2">qalbe atixxanna qalbeeffachchotibaa wirri assexxottole,<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />Iittanni ege'natee kadhattottole</para>
  <para style="q2" vid="PRO 2:3">haafuurakanna gikki assite qalbeefachcho ye'exxottole,<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />Iseenna birretike sibljishsha halsittottole,</para>
  <para style="q2" vid="PRO 2:4">moogemeeke maallaqishshanna isee jaba qicinni yortottole,<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />Ookkonee wodda Duuchchi Woddike Goottixxa soda'a qalbeeffattatton;</para>
  <para style="q2" vid="PRO 2:5">Mageno ege'natanna alfitatton.<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />Muxxumma uwwaaki Duuchchi Woddike Gootta callan;</para>
  <para style="q2" vid="PRO 2:6">ege'natinna qalbeeffachcho afendaak isike hiyyichchonaa'niten.<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />Isi qajeeli manni'a injifachcho tuulaan;</para>
  <para style="q2" vid="PRO 2:7">ci'mensha belo me'aakeri'aanna isi wonteten.<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />Isi dhugaa assaakeerika ora heqqaan;</para>
  <para style="q2" vid="PRO 2:8">ifixxe xuurameeyyeka me'injonna gollaan.<verse eid="PRO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />Ookkone wodda qullumma, dhugaa assa, yaane toggi assa,</para>
  <para style="q2" vid="PRO 2:9">eloxxe yaaneka ora duuchchanna qalbeeffattatton.<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />Muxxumma ate'ni qubatteemmxxee'e,</para>
  <para style="q2" vid="PRO 2:10">ege'natinna atee gammachchissaan.<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />Elo yo'ooxxa gargar foya atee heqqitaan,</para>
  <para style="q2" vid="PRO 2:11">qalbeffachchotinna atee gollitaan.<verse eid="PRO 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />Beekkumi haaso'i insa'neek dabaaleessake kadeekeerinaa'n,</para>
  <para style="q2" vid="PRO 2:12">fuggaalleeyyetike oranaa'ninna atee anjiraan.<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />Iitta hedheeki manni dukkana giddo me'atee,</para>
  <para style="q2" vid="PRO 2:13">ookkonee toggichcha ora waalaakeeran.<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />Elobaaxxa hujate'n gammadaakiirinna,</para>
  <para style="q2" vid="PRO 2:14">dabaaleessi fuggoke ora'n me'a wodda illillisaakiir,<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />Ori insa'neek midda middichcha,</para>
  <para style="q2" vid="PRO 2:15">ifika me'injooranna daddassaakeeran.<verse eid="PRO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />Muxxumma yabaabulto manjichchonaa'n atee heqqitaan;</para>
  <para style="q2" vid="PRO 2:16">fonxore abidaake iseke shaqake haaso'anaa'ninna anjirtaan.<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />Isenna siretika ifika aro'o waldeexxe,</para>
  <para style="q2" vid="PRO 2:17">Mageni edonna aaggemmaxxa kako deeteexxen.<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />Iseke minibaa marta'attole me'itaattebi reyotibaten;</para>
  <para style="q2" vid="PRO 2:18">isebaa mara reyemmak manni hedhemmaba maratixxe qixxen.<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />Isebaa e'yaak ayyinna ille iima higabaan;</para>
  <para style="q2" vid="PRO 2:19">hedhotika oranna alfabaan.<verse eid="PRO 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />Tennexxee atinna eloke mannika ora me'i;</para>
  <para style="q2" vid="PRO 2:20">qulliyyetika me'injonna hordofatton.<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />Qajeeli manni ookkone boga'n hedhammaxxee'e,</para>
  <para style="q2" vid="PRO 2:21">ci'mensha beloki manninna ookko hedhaan.<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />Fuggaalleyye kinni ookkone boganaa'n fuggusendaan,</para>
  <para style="q2" vid="PRO 2:22">xuurameessumma xe'iteemmakiirinna ookkoo'n goshemaan.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">Muxxummatenaa'n Daggaaxxa Wele wele Eebba</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />Anke beltoo! Atee barachchiisennexxa barachcho deetoxxe'e;</para>
  <para style="q2" vid="PRO 3:1">ajajuwwa anka godoba atike'n galchedhi,<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />Barachcho anxi heddo barruwwa ati'a lebbaan,</para>
  <para style="q2" vid="PRO 3:2">hedhotixxa wogguwwanna ati'a qeerrissaan; nage'akanna ati'a uutaan.<verse eid="PRO 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />Jaalalatinna xuurameessumma atenaa'n mee gophendowwaal;</para>
  <para style="q2" vid="PRO 3:3">tenneera gooba atike'n didhdhi,</para>
  <para style="q2" vid="PRO 3:3">atixxe qalbe giddonna borreessedhi.<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />Ookkone wodda ati elletanna eloka summa,</para>
  <para style="q2" vid="PRO 3:4">Magenokenaa'ninna manjokenaa'n alfittatton.<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="LUK 2:52">Luq. 2:52</ref>. </char></note><verse eid="PRO 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />Mitte godobinni Duuchchi Woddika Gootta addati,</para>
  <para style="q2" vid="PRO 3:5">ifixxe ege'na'ninna mee irkati.<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />Assitattoxxe duuchchinni isoo ege'ni,</para>
  <para style="q2" vid="PRO 3:6">isinna ati'a ora atika toggi assaan.<verse eid="PRO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />Ifike yaadinni ani muxxeten mee hiyyi;</para>
  <para style="q2" vid="PRO 3:7">Duuchchi Woddika Gootta sodaat, fuggoxxenaa'ninna bayyat.<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ROM 12:16">Rom. 12:16</ref>. </char></note><verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />Tinni, biso atikee fayya,</para>
  <para style="q2" vid="PRO 3:8">micco mikita atikeenna jabeenna uutaan.<verse eid="PRO 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />Duuchchi Woddika Gootta karra atixxe duuchchanni,</para>
  <para style="q2" vid="PRO 3:9">atik bogi fulcheexxe gumma duuchchika umo isi'a uwwati ulfeesi.<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />Tennee assitottole atik gootar wo'mee danbala'aan;</para>
  <para style="q2" vid="PRO 3:10">atike waaba'ninna woyinetixxe booka xuphphi hittee wo'mitaan.<verse eid="PRO 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />Anke beltoo! Duuchchi Woddike Goottixxa cabba tuffattoxxe'e,</para>
  <para style="q2" vid="PRO 3:11">atee xixaa woddanna dingi dingi hittoxxe'e,<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />Anni eeyyaaka belto cabbammashshanni,</para>
  <para style="q1" vid="PRO 3:12">Duuchchi Woddiki Goottinna eeyyaakaaranna cabbaan.<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="HEB 12:5-6">Ibr. 12:5-6</ref>; <ref loc="REV 3:19">Wal. 3:19</ref>. </char></note><verse eid="PRO 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />Muxxumma alfaakeerixxa</para>
  <para style="q2" vid="PRO 3:13">qalbeeffachchotanna ifixxe assedhaakeerixxa wodo.<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />Tennexxee beekkumi birreti siblji caala hira afe'eeni;</para>
  <para style="q2" vid="PRO 3:14">worqeti caalanna la'o afe'eeni.<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />Muxxumma hiri fiixeexxe kino caala fiixxeexxen;</para>
  <para style="q2" vid="PRO 3:15">ati halchitaattexxe yaanuwwa duuchchanaa'ninna isenni qixxo'aachchi hedhebaan.<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />Middixxe isexxe anga'n qeerrake baro hedhe;</para>
  <para style="q2" vid="PRO 3:16">bita'ixxe isexxe anga'ninna durummanna ulfinna afe'een.<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />Ori isek eeyyisaaken;</para>
  <para style="q2" vid="PRO 3:17">qaxxaamuri isek duuchchinna nage'aken.<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />Isee hanqalfaakeeri'a ise hedhoti haqichchon;</para>
  <para style="q2" vid="PRO 3:18">isee'e dhaphphi asse abixxaakiirinna eebbisemaan.<verse eid="PRO 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />Duuchchi Woddik Gootti muxxummati butta dade;</para>
  <para style="q2" vid="PRO 3:19">qalbeeffachchoti iimuwwa isenxe bakka bakka'ni offo'lishe;<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />Isixxe ege'nanni buttinii hundixxe baarxi dhi'mo dhoote,</para>
  <para style="q2" vid="PRO 3:20">duumanchuwwikinna buttatee xeena gansiisse.<verse eid="PRO 3:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />Anke beltoo! Seeriinxi murtenna qalbeefachchoti elo yo'oxxa gargar foya atenaa'n baxxoqqe'e;</para>
  <para style="q2" vid="PRO 3:21">tinniir atixxe sammo giddii'n meenni me'ittowwaal;<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />Tinniir ati'a hedhotanna,</para>
  <para style="q2" vid="PRO 3:22">goobiinke seesa kaddaan.<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />Ookkoneechchi uduma ora atika nage'ik me'itatton;</para>
  <para style="q2" vid="PRO 3:23">atixxa lekkanna guffo gandabaan.<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />Diiphphatto woddanna ruphphi hitabexxon;</para>
  <para style="q2" vid="PRO 3:24">hashsha duuchcha nage'iinke diipho diiphphatton.<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />Dedhange'n kaddaaxxe bararassitaaxxe yaane'a,</para>
  <para style="q2" vid="PRO 3:25">fuggaalleeyyete'n daggaaxxe bala'aanna alaltabexxo.<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />Duuchchi Woddiki Gootti una atixxe kadeexxi miidhaachchonaa'n atee heqqaan.<verse eid="PRO 3:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />Assaa dandeettattoxxa yaane,</para>
  <para style="q2" vid="PRO 3:27">rakkateekeeri'a eloxxa assa mee gibi.<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />Ta'a anganni affeenni heexxe'e atika ollalcho,</para>
  <para style="q2" vid="PRO 3:28">«Soodo ati'a uwwannon;</para>
  <para style="q2" vid="PRO 3:28">higge dagi» mee hiyyi.<verse eid="PRO 3:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />Addeti ati bira hedha'neeke atike ollalcho'n,</para>
  <para style="q2" vid="PRO 3:29">fuggoxxa iso'n heddoxxe'e.<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />Mitteelchchinninna atee balleessebaaka,</para>
  <para style="q2" vid="PRO 3:30">manjo tolanga mee ku'li.<verse eid="PRO 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />Fuggichcha manjo hinaaffoxxe'e;</para>
  <para style="q2" vid="PRO 3:31">isika hoonee oranna mee hordofi.<verse eid="PRO 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />Duuchchi Woddiki Gootti fuggoka manjo diqataan;</para>
  <para style="q2" vid="PRO 3:32">qajeela manjo'n kinni godobixxe kula.<verse eid="PRO 3:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />Duuchchi Woddike Goottixxi badino fuggaalleeyyetike mine'n hexxe,</para>
  <para style="q2" vid="PRO 3:33">qulliyyetiki mini kinni eebbisemaan.<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />Duuchchi Woddiki Gootti weleke'n gacifataakeera'n gacifata;</para>
  <para style="q2" vid="PRO 3:34">ifi heeshshi assaakeeri'a kinni gaachchanna uwwa.<note caller="-" style="x"><char style="xo" closed="false">3:34 </char><char style="xt" closed="false"><ref loc="JAS 4:6">Ya'i. 4:6</ref>; <ref loc="1PE 5:5">1 Phex. 5:5</ref>. </char></note><verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />Muxxe manni ulfinna alfaan;</para>
  <para style="q2" vid="PRO 3:35">gowwoole kinni isfi salphisaan.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">Muxxumma Yaane Duuchchii Iimi Darre Kaddeexxa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />Anxe oose! Anniinka gorsa laqqe;</para>
  <para style="q2" vid="PRO 4:1">dho'o hitine caqqassineexxi qalbeeffachchotanna alfe.<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />Ani ha'no'a eloxxa barachchiisa uwwannon;</para>
  <para style="q2" vid="PRO 4:2">tennexxee anxe barachchiisa'n mee ga'ma'mi hiyye.<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />Ani anke annike mine'n reefi shiixoke belto,</para>
  <para style="q2" vid="PRO 4:3">anxe ama'aanna mittelchchoke kadeennaa wodda,<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />Anni anki anee'e hiyya'ni barachchiisaamma qici,</para>
  <para style="q2" vid="PRO 4:4">«Hiyyichcho anka duuchcha atike godoba'n galchedhi;</para>
  <para style="q2" vid="PRO 4:4">anka ajajaaranna heqqedhi, hedhoti hexxatton.<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />Muxxumma alfi, qalbeefachcho abixxi;</para>
  <para style="q2" vid="PRO 4:5">hiyyichcho anka mee dedhi, iso'ninna mee ga'ma'mi hiyyi.<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />Muxxumma mee waal; iseenna ati'a gollake kaddaan;</para>
  <para style="q2" vid="PRO 4:6">isee eeyyi, ateenna heqqitaan.<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />Muxxumma quba saxxeexxe yaanen; tennexxee muxxumma alfi;</para>
  <para style="q2" vid="PRO 4:7">affetteelchcho duuchcha hira atee laqqoolenna qalbeeffachcho horat.<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />Muxxumma kubbisi, isenna atee kubbissaan;</para>
  <para style="q2" vid="PRO 4:8">muxxumma hanqalfi, isenna atee'e ulfeessitaan.<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />Isenna atike umo'n gaachchanna uwwaaka daraariinka seesa guggu'lishshaan;</para>
  <para style="q2" vid="PRO 4:9">ulfaatatike kallachcha ati'a kaddaan.»<verse eid="PRO 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />Anke beltoo! Hiyyaannexxa caqasi, kulaanexxanna laqi,</para>
  <para style="q2" vid="PRO 4:10">atik hedhoti barinna qeerredhaan.<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />Muxxummatika ora atee barachchiisennen, toggichcha ora'ninna atee akeekannon.<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />Me'ittatto wodda ori ate'n cu'matabaan;</para>
  <para style="q2" vid="PRO 4:12">gongittottolenna guggufattabexxon.<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />Barattettexxa barachcho jabeessite abixxi, mee isee wocci assi;</para>
  <para style="q2" vid="PRO 4:13">barachcho atixxe hedho kaddemmaxxee duute isee abixxi.<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />Cubbaalleeyyetika ora lekka atixxi meenni haxxowwaal;</para>
  <para style="q2" vid="PRO 4:14">fuggaalleeyyetika me'injonna me'itoxxe'e.<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />Isonaa'ni bayyati, meenni iso'ni me'i;</para>
  <para style="q2" vid="PRO 4:15">isinaa'n illee iima higgetexxi ora atika me'i.<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />Fuggoxxa assa gonphoole diiphi insa'nee adhdha gophammaxxee,</para>
  <para style="q2" vid="PRO 4:16">manjo guggufachchiisa gonphoole diiphi insa'ne'ni wilabaan.<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />Fuggoxxinna hunnat manjoke'n ke'na,</para>
  <para style="q2" vid="PRO 4:17">insa'ne'a itatishshanna ha'watishshaten.<verse eid="PRO 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />Qulliyyetik ori saafo'ii qico'n,</para>
  <para style="q2" vid="PRO 4:18">wa'inne leba'ni me'ammake soodimariinke ifishshaten.<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />Fuggalleeyyetiki ori kinni dimma dukanashshate;</para>
  <para style="q2" vid="PRO 4:19">insa'nee guggufantaan maachchi insa'nee ibiseexxanna egennabaan.<verse eid="PRO 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />Anke beltoo! Hiyyaannexxa caqasi;</para>
  <para style="q2" vid="PRO 4:20">anaka hiyyichchonna dho'o hite laqi.<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />Hiyyichcho anka atixxe ille edii'n mee bayyisi,</para>
  <para style="q2" vid="PRO 4:21">godoba atik giddonna galchedhi;<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />Hiyyichcho anka qalbeeffataakee, hiyyichchi anki hedho,</para>
  <para style="q2" vid="PRO 4:22">manjiinke bisi duuchchi'aanna fayyaten.<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />Duuchchiinxe yaane iimi darre qalbe atixxa heqqedhi,</para>
  <para style="q2" vid="PRO 4:23">qalbe hedhotixxe muummen.<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />Dabiinki haaso'i atenaa'n fuloqqe'e;</para>
  <para style="q2" vid="PRO 4:24">lame afo'ikenna kaddoxxe'e.<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />Yaadi atik toggi hiyyeeke kadowwaal;</para>
  <para style="q2" vid="PRO 4:25">middi bita'i'a hitebexxong edi'a uudi.<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />Me'itattoka ora giissedhi,</para>
  <para style="q2" vid="PRO 4:26">me'inji atikinna ati'a elaan.<note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="HEB 12:13">Ibr. 12:13</ref>. </char></note><verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />Middi bita'i'a gortoxxe'e; lekka atixxanna fuggoxxenaa'n heqqi.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">Yababulto Manjonaa'n Ifi heqqedha</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />Anke beltoo! Muxxumma anxa dho'o hite caqasi,</para>
  <para style="q2" vid="PRO 5:1">qalbeefachchotika anka hiyyichchonna adda laqi;<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />Tinninna elo yooxxa gargar foyya horattattoshanna,</para>
  <para style="q2" vid="PRO 5:2">haaso'i atiki ege'na leellisho'aten.<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />Yabaabulto manjichchoke afo'onaa'ni malbi coccoba'neeke labaan,</para>
  <para style="q2" vid="PRO 5:3">haaso'i isekinna buuri irra shaqqaken.<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />Udumi uduma kinni isee heexotishsha qaraarteexxe,</para>
  <para style="q2" vid="PRO 5:4">lame qarike wolaantichchishshanna woxxaaxxen.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />Ori isek rewotiba'a geessisaan;</para>
  <para style="q2" vid="PRO 5:5">me'inji isekinna hirreessake'n iyyemaraan.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />Ise hedhotike orixxee'e mitte yaadonna affebaan;</para>
  <para style="q2" vid="PRO 5:6">me'inji isek midaa middichcha orani;</para>
  <para style="q2" vid="PRO 5:6">kaddo malee'e ise'ni ege'nemebaake.<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />Anxe oosee! Hiyyaannexxa caqasse;</para>
  <para style="q2" vid="PRO 5:7">ha'no barachchiisenneke hiyyechchinaa'n qootinoqqe'e.<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />Iitta hexxeexxe manjonaa'n bayyati,</para>
  <para style="q2" vid="PRO 5:8">isexxe baxxeba'anna midde shiqqoxxe'e;<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />Tinninna, atiki oosummatiki uduudi welekee uwwemabaashsha,</para>
  <para style="q2" vid="PRO 5:9">hedho atixxinna mararabaake manjixxe anga'n shiyendabaashaten.<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />Alagi karra atixxenni fenxe hiyyabaashsha,</para>
  <para style="q2" vid="PRO 5:10">elootte alfitettelchchinna wele manjika mine duroonsabaashshaten.<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />Bari atiki muuxemaa woddanna maal atik mudaa wodda,</para>
  <para style="q2" vid="PRO 5:11">aaddaton;<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />Atinna hitatto qici, «Mayee cabbensha gibenne?</para>
  <para style="q2" vid="PRO 5:12">Tuffatennexxi manjiinka gorssa hara adhdha gibenneki mayeete!<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />Anke barachiisaluwwika haaso'a laqa gibenne;</para>
  <para style="q2" vid="PRO 5:13">gorsa insa'nekanna adhdhebe'no.<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />Tuuta duuchchi edo,</para>
  <para style="q2" vid="PRO 5:14">ba'eeqa gatene» hitatton.<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />Are atixxi ati'a muummetike wodi'ishshaten,</para>
  <para style="q2" vid="PRO 5:15">eettene muummenaa'ninna ha'wi.<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />Atixxi muumme gadhi'a,</para>
  <para style="q2" vid="PRO 5:16">atiki wodi'i weldeennatiba'a yaa'ataa?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />Atixxe muummekinna baletiki wodi'i ayyi manjinna,</para>
  <para style="q2" vid="PRO 5:17">atinni qabe qoodemabaake atinge calla kadowwaal.<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />Tennexxe muttaara atixxi are ati'a muummetike wode'e kaddemmaxxee,</para>
  <para style="q2" vid="PRO 5:18">ise'n gammad.<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />Ise ati'a eeyyemeeke meyyake gadansan; danchumma callixxe geedummashsha,</para>
  <para style="q2" vid="PRO 5:19">unun isek atee duuchchii wodda goddisowwaal,</para>
  <para style="q2" vid="PRO 5:19">jaalala isexxinna ate'e boojito'o.<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />Anke beltoo! Yabaabulto manjoxxe jaalalanni mayee machchoottatto?</para>
  <para style="q2" vid="PRO 5:20">Wele mannixxa are mayeeta hanqalfitatto?<verse eid="PRO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />Mayee'e? Duuchchi Woddiki Gootti manji assaaxxa duuchcha uudammaxxe'e,</para>
  <para style="q2" vid="PRO 5:21">me'injo isika duuchchanna kokammaxxeeten.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />Fuggaalleessa manjo umo ifingixxe fuggoxxe huje fonxortaan;</para>
  <para style="q2" vid="PRO 5:22">cubbo isixxinna wodarotishsha iso'o qaxxafa.<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />Hedhotixxe cabbema gophanaa'n kexxeexxa reyaan;</para>
  <para style="q2" vid="PRO 5:23">hara bira saxxeexxe gowwummanaa'n kexxeexxa orakenaa'n ba'aan.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">Gowwoommatenaa'n Gata</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />Anke beltoo! Liqa dande'e hiissa gopheeke manji'a,</para>
  <para style="q2" vid="PRO 6:1">hiissisatee annooma adhdhitootole,<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />Haasottetteki haaso'inna,</para>
  <para style="q2" vid="PRO 6:2">atee fonxortishsha abidoole,<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />Anke beltoo! Ookkone manjixxe anga'n ibbette hiyyoten;</para>
  <para style="q2" vid="PRO 6:3">tennexxe isixxe anganaa'n fuldattoshsha rakke isiba martettexxi,</para>
  <para style="q2" vid="PRO 6:3">ookkone liqa hiissisatika annooma ateenaa'n hoyyaashsha iso'o kadhat.<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />Tennee assitebexxoki diiphi atee adhdhoqqe'e,</para>
  <para style="q2" vid="PRO 6:4">suukkinna hitoxxe'e.<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />Buddanne adamammake manjixxe anganaa'n,</para>
  <para style="q2" vid="PRO 6:5">ci'atinna fonxorotenaa'n fulchexxemmashsha ifi anjiri.<verse eid="PRO 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />Ati boose'i manji mari xuxetiba;</para>
  <para style="q2" vid="PRO 6:6">galduma isekanna uudde muxxete kadi.<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />Xuxe ajajaaka affebaan,</para>
  <para style="q2" vid="PRO 6:7">yookaan akeekakkanna kadi galchaaka affebaan.<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />Kaddo malee ittaachcho bono qixxeeffatta,</para>
  <para style="q2" vid="PRO 6:8">la'ataachchonna midhatixxe aaggoxxe yanna'n bukki asseexxa.<verse eid="PRO 6:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />Koo ati boose'i! Duuchchii wodda diiphpha'n hexxatto?</para>
  <para style="q2" vid="PRO 6:9">Diiphokenaa'n kexxatokita haanote?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />«Shixxo qico diiphphaanneni, shiixoo qico suukki hiyyaannen,</para>
  <para style="q2" vid="PRO 6:10">anga mirqedhe shiixxoxxa yanna hufuura adhdho» hitaa'naa,<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />Ate'n hiyyo naaphiinsha duwwi gatatinna,</para>
  <para style="q2" vid="PRO 6:11">loliinka miya ka'leeke manjishsha ate'n daggaan.<note caller="-" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="PRO 24:33-34">Mam. 24:33-34</ref>. </char></note><verse eid="PRO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />Baasho'eekinna fuggoki,</para>
  <para style="q2" vid="PRO 6:12">kukkutanji erqe kayya dooyaak,<verse eid="PRO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13" />Isinna manjo sobatee,</para>
  <para style="q2" vid="PRO 6:13">illet qipha'n anga lekkati haaso'aaki,<verse eid="PRO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14" />Godoba afeexxe xaqaronni fuggoxxa hedaak,</para>
  <para style="q2" vid="PRO 6:14">haanonna isi weli gonphete ilaan.<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />Tennexxe'e ba'ne iso'n ikki woddi daggaan;</para>
  <para style="q2" vid="PRO 6:15">dedhange'ni ba'aan; gatabaan.<verse eid="PRO 6:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16" />Duuchchi Woddiki Gootti jibbaaxxi jaane yanuwwa hexxeen,</para>
  <para style="q2" vid="PRO 6:16">diqataaxirinna torbaanete kaddaa wodda tinninna konneechinni butti'a hexxeexxen:<verse eid="PRO 6:16" /></para>
  <para style="q3">
    <verse number="17" style="v" sid="PRO 6:17" />hollitaaxxa ille,</para>
  <para style="q3" vid="PRO 6:17">dhara haaso'aaka arrabo,</para>
  <para style="q3" vid="PRO 6:17">balleessa afebaaka manjo shiltaaxxa anga,<verse eid="PRO 6:17" /></para>
  <para style="q3">
    <verse number="18" style="v" sid="PRO 6:18" />fuggoxxa giddo uggudhaaka godoba,</para>
  <para style="q3" vid="PRO 6:18">fuggoxxiba'a gongatee wiinandaaxxa lekkuwwa,<verse eid="PRO 6:18" /></para>
  <para style="q3">
    <verse number="19" style="v" sid="PRO 6:19" />dhara dharake'n lebba'n dhugaa kuldaaxxa dhuga,</para>
  <para style="q3" vid="PRO 6:19">dayyuwwiinxe oddo'n weli gonphe ilaaka manjon.<verse eid="PRO 6:19" /></para>
  <para style="s1">Yabaabulto Manjonaa'n Bayyata</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />Anke beltoo! Atike annika ajaja heqqedhi,</para>
  <para style="q2" vid="PRO 6:20">ama atixxi barachchiisaaxxa barachchonna giboxxe'e.<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />Tenneeranna duuchchii woddi'a godoba galchedhi;</para>
  <para style="q2" vid="PRO 6:21">goobake'ninna didhdhi.<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />Tinniir me'itatto wodda atee akeekkaan;</para>
  <para style="q2" vid="PRO 6:22">diiphphatto woddanna heqqitaan;</para>
  <para style="q2" vid="PRO 6:22">dammaqqatto woddanna atee yaansissaan.<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />Kunni ajajuwwi xassiinsha ati'a ifa xassaan,</para>
  <para style="q2" vid="PRO 6:23">tinni barsiisanna ati'a ifake,</para>
  <para style="q1" vid="PRO 6:23">Cabbemati toggi hiyya,</para>
  <para style="q2" vid="PRO 6:23">ati'a hedhotike oran.<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />Tinni barsiisuwwa atee'e elobaake addabixxe,</para>
  <para style="q2" vid="PRO 6:24">buuro afo'ixxe yabaabulto manjonaa'n ate'e gatissaan.<verse eid="PRO 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />Danchumma isexxa atee'e godobi yoroqqe'e,</para>
  <para style="q2" vid="PRO 6:25">yookaan isexxe illexxe qe'lenchonni atee'e boojittoqqe'e.<verse eid="PRO 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />Mitti labbak ifi gurgudhitammaxxi manjichcho mitte yannaxxee itake hirrinni alfa dande'aan;</para>
  <para style="q2" vid="PRO 6:26">wele manjixxe arenni welti yabaabulaak kinni lubbo ifixxa gophaan.<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />Seema isixxi gubattebaang,</para>
  <para style="q2" vid="PRO 6:27">boba giddo giira uggudhdha dande'aaki manji hedheesi?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />Lekka isixxi gubatebaang,</para>
  <para style="q2" vid="PRO 6:28">kashilo hadha'ni me'aki manji hedheesi?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />Annafeexxe arenni diiphphaaki manjinna iittanden;</para>
  <para style="q1" vid="PRO 6:29">Isenni irkateekinna iso'n geyiyyo hassissaake xixichchonaa'ni gatabaan.<verse eid="PRO 6:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />Solo'weexxi moore abidemeeka manjo,</para>
  <para style="q2" vid="PRO 6:30">ayyinna iso'o tuffataba'a.<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />Mine afeechcho duuchcha gurgursissaaxxe kaddolenna,</para>
  <para style="q2" vid="PRO 6:31">abidemeechchinni torbaane anga asseexxi moreechcho hiissowwaal.<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />Yabaabulaaki manji kinni qalbeeffachchotixxe xe'ya afeeken;</para>
  <para style="q2" vid="PRO 6:32">ikki iitta assaak duuchchir lubbo ifixxa tola balleessaan.<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />Ganenshatinna salphinni isike qoobbon,</para>
  <para style="q2" vid="PRO 6:33">shookikinna isonaa'n hara gatabaan.<verse eid="PRO 6:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />Hinaaffe aro'ii</para>
  <para style="q2" vid="PRO 6:34">aareti bubbi hiyyaashsha assitammaxxee'e,</para>
  <para style="q2" vid="PRO 6:34">isi halo fulaaxxa yanna mararte ege'nebaan.<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />Isi heenee muranna itabaan;</para>
  <para style="q2" vid="PRO 6:35">hara bira saxxeexxi uwwanna isixxa mufe qiiddisabaan.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s1">Yabaabulto Manjonaa'n Bayyata Hasissaaxxa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />Anke beltoo! Hiyyichcho anka heqqedh;</para>
  <para style="q2" vid="PRO 7:1">ajajuwwa ankanna ifi giddo galchedhi.<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />Ajajuwwa anka heqqedhi, hedhoti hexxatton;</para>
  <para style="q2" vid="PRO 7:2">ate'e barachchiisannexxa barachchonna atixxe illeke gummichchishshanna heqqedhi.<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />Tennera anga atixxe'n usudhdhi;</para>
  <para style="q2" vid="PRO 7:3">atike godobi giddonna borreessedhi.<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />Muxxumma dayyo atixxishsha,</para>
  <para style="q2" vid="PRO 7:4">qalbeeffachchotanna atike shiqike firishsha uudi;<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />Tinni yaanuwwa atee'e yabaabulto manjichchonaa'ninna</para>
  <para style="q2" vid="PRO 7:5">dedhissaake annafeexxe areke haaso'anaa'n gattissaan.<verse eid="PRO 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />Barratixxa barra anke minixxe maskooteke golonaa'n,</para>
  <para style="q2" vid="PRO 7:6">gadhi'a uudenne.<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />Qalbeeffachchotixxa xe'ya afeeka oosichcha belto,</para>
  <para style="q2" vid="PRO 7:7">yaadik oosomateeke manni giddo affenne,</para>
  <para style="q2" vid="PRO 7:7">dargaggeeyye giddi'ninna gargar hiisse'e iso'o hubatenne.<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />Isi mine isek darre'n</para>
  <para style="q2" vid="PRO 7:8">mine isek qarqara hexxeexxe weldeennaka ora sa'nemman.<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />Galgala, bogi siphphi siphphi hiyya'n me'amma wodda,</para>
  <para style="q2" vid="PRO 7:9">hashshenna himmi hiyyo'atemman.<verse eid="PRO 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />Ookkoneechchi uduma manjichcho mitte iso'o affo'a gadhi'a fulde,</para>
  <para style="q2" vid="PRO 7:10">ifi gurgudhitammaxxe manjoxxa oddoono oddo'witeexxi manjo dedhisatika yaada ifi giddo abixiteemman.<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />Isee illimooltenna shookkoke hiyyendaaxxa yaane egendebaaxxe,</para>
  <para style="q2" vid="PRO 7:11">lekka isexxi mine ofoldabaaxxe;<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />Mittele ora mittele dikko giddonna,</para>
  <para style="q2" vid="PRO 7:12">weldeenna weldeenna'n uurta'n gaada.<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />Ookkonee dargaggeessanna hanqalfite sunqexxe,</para>
  <para style="q2" vid="PRO 7:13">illimoollummatinna iso'o hittee qici:<verse eid="PRO 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />«Ani mittummatika tolcha telcho tolchennexxi,</para>
  <para style="q2" vid="PRO 7:14">werreega anka muuxe'eenne.<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />Tennexxee atee afonnaa fulenne;</para>
  <para style="q2" vid="PRO 7:15">jaba qicinni atee'e hase'eennan; ta'a atee'e kunse alfeennen.<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />Gibtsee'ni daggeexxa,</para>
  <para style="q2" vid="PRO 7:16">dancha seemma taqe anxi hana fayeennen.<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />Taqe anxe'n,</para>
  <para style="q2" vid="PRO 7:17">karbe almuuninna qarafa hiyyendaaxxe haqqexxa shitto fiffixeenen.<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />Amo, soodaa qico'ni jaalala goddino;</para>
  <para style="q2" vid="PRO 7:18">welinna hanqalfine gammandoo!<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />Aro'i ank mine hedhebaan;</para>
  <para style="q2" vid="PRO 7:19">bayyi ora me'eni.<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />Jiraka maallaqa adhdhe me'emmaxxee,</para>
  <para style="q2" vid="PRO 7:20">illeema higabaan» hite.<verse eid="PRO 7:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />Xe'maake ifike hiyyichchinni iso'o dedhisse;</para>
  <para style="q2" vid="PRO 7:21">shaqqake ifike haaso'inni iso'o sobbe.<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />Duliimbaa ooffemammake kormishsha;</para>
  <para style="q2" vid="PRO 7:22">rake fonxoro giddo e'yammake gafarsishsha,</para>
  <para style="q1" vid="PRO 7:22">Qoxxinni mitte belo isinna ise'e hordofe me'e.<verse eid="PRO 7:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 7:23" />Gabe tidho isixxa ottaa qico'n,</para>
  <para style="q2" vid="PRO 7:23">isoo hedho gophissaaxxa ege'nebaang,</para>
  <para style="q1" vid="PRO 7:23">Phirri hite'e fonxoro giddo e'yitammaxxe cii'chchoshsha kade.<verse eid="PRO 7:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />Anxe oose! Hiyyaannexxa laqqe;</para>
  <para style="q2" vid="PRO 7:24">dho'o hitine caqasse.<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />Yaada ha'nooka ora isekibaa wirri assitinoqqe'e,</para>
  <para style="q2" vid="PRO 7:25">yookaan iseke dedhiinke ora'n e'yitinoqqe'e.<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />Salphisse'e hundeekir heddoken;</para>
  <para style="q2" vid="PRO 7:26">birteekirinna laakkosi iimi darre hedheeken.<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />Iseki mini reyotiba'a,</para>
  <para style="q2" vid="PRO 7:27">hirreessi giddonna iyyemaraake oran.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">Muxxumatika Ye'injo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />Caqasse! Muxxumma yexxa'neen; Qalbeeffachchotinna hafuura gikki assite laqissa'neen.<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />Oriin qarqara hexxeexxe gooruwwa hana, weldeennuwwate'ninna uurtaan;<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />Qachchuwwiinba e'yinaaxxe huluwwa qarqara,</para>
  <para style="q2" vid="PRO 8:3">wuddummete'n hexxe hafuura gikki assite hitta'n yexxee qic:<note caller="-" style="x"><char style="xo" closed="false">8:3 </char><char style="xt" closed="false"><ref loc="PRO 1:20-21">Mam. 1:20-21</ref>.</char></note><verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />«Koo mannaa! Ye'aannekiqqa ha'note;</para>
  <para style="q2" vid="PRO 8:4">hafuura gikki asse'e manjiinka belto duuchcha ye'aannen.<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />Ha'no xe'ya ege'na afineek ege'na alfitino'a baratte;</para>
  <para style="q2" vid="PRO 8:5">ha'no gowwoole, qalbeeffachcho alfe.<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />Haaso'aannexxa la'o affeexxa yaane caqasse;</para>
  <para style="q2" vid="PRO 8:6">afo'i anki toggitte yaane haaso'aan.<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />Ani fuggoxxa diqataannaxxe'e, dhugaate haaso'anno.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Haaso'annoki haaso'i duuchchi dhugaaten;</para>
  <para style="q2" vid="PRO 8:8">mittikinna dhari yookaan manjo dedhake'n ibisaakebaan.<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />Qalbeeffachcho afeeki haaso'i anki duuchchi toggichchaken;</para>
  <para style="q2" vid="PRO 8:9">ege'na afeeki manninna dedha afebaan.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />Birretik siblji irra gorsa,</para>
  <para style="q2" vid="PRO 8:10">ca'itte worqe irranna ege'na melledhe.<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />Muxxummati hiri fiixeeke kinjuwwi irra fiixxeexxen,</para>
  <para style="q2" vid="PRO 8:11">halchitattoxxe yaane duuchchanaa'n isenni qixxo'aachchi mittilchinna hedhebaan.<verse eid="PRO 8:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />«Ani muxxumma qarummati welti galannon;</para>
  <para style="q2" vid="PRO 8:12">ege'natinna elo yo'oxxa gargar mella aniilchon.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />Duuchchi Woddika Gootta sodaata fuggoxxa gibaten;</para>
  <para style="q2" vid="PRO 8:13">ani holla ifi dukatanna fuggoka adaba,</para>
  <para style="q2" vid="PRO 8:13">manjo dedhisaaka haaso'a gibanno.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />Gorskinna dhugaatixxi murte aniilchon;</para>
  <para style="q2" vid="PRO 8:14">qalbeeffachcho ante; hunnatanna afeenne.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />Moyanjuwwi aninni moya,</para>
  <para style="q2" vid="PRO 8:15">akeekisanjuwwikinna toggichcha seera aninni fulcha,<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />Ja'laabuwwi aninni galcha,</para>
  <para style="q2" vid="PRO 8:16">buttatiki galchalluwwi duuchchi aninni toggitte murte mura.<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />Ane'e eeyyaka duuchcha aninna insa'nee eeyyanno,</para>
  <para style="q2" vid="PRO 8:17">adda halsaakirinna anee alfa.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />Durummatinna ulfinni,</para>
  <para style="q2" vid="PRO 8:18">guutabaaxxi karranna yaane duuchchixxi qajeela aninnite.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />Ani gicannok gici ca'itte worqenaa'ni,</para>
  <para style="q2" vid="PRO 8:19">uwwannok hirinna hedheen hiyyemaake birret sibljonaa'n sa'aaken.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />Ani qulummatike ora'n ma'annon,</para>
  <para style="q2" vid="PRO 8:20">seeriinxe weldenna'ninna tarkaafatano;<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />Anee'e eeyyakara duroonsano;</para>
  <para style="q2" vid="PRO 8:21">mine insa'neeke'ninna karra wonshanno.<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />«Duuchchi Woddiki Gootti edo olma duuchiingechchi edo,</para>
  <para style="q2" vid="PRO 8:22">ifixxe hujeke safo'n taakaba anee dade.<note caller="-" style="x"><char style="xo" closed="false">8:22 </char><char style="xt" closed="false"><ref loc="REV 3:14">Wal. 3:14</ref>. </char></note><verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />Butta dadendebaa edi darre,</para>
  <para style="q2" vid="PRO 8:23">bire olminaa'ni hariiremmennen.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />Lumollamma abbaayyuwwa edi darre,</para>
  <para style="q2" vid="PRO 8:24">wodi'iinxi muummuwwa phu'issebaa ediga'ma ani ilemenne;<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />Koobuwwa dadendebaa edi darre,</para>
  <para style="q2" vid="PRO 8:25">tullichuwwakeenna ediga'ma ani ilemeennen,<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />Butta yookaan buttatik diiduwwi,</para>
  <para style="q2" vid="PRO 8:26">yookaan ediseexxi buttatixxa buko dadendebaa edi ga'ma ani illemenne.<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />Mageni lumolla abbaayyuwwa iimi darre iima dhisee wodda,</para>
  <para style="q2" vid="PRO 8:27">ani ookko hedhennan;<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />Duumanchuwwa iima uggee wodda,</para>
  <para style="q2" vid="PRO 8:28">lumolla abbaayyuwwaxxa muummuwwa dadeedee wodda,<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />Abbaayyuwwatixxa gabala gabale uggee wodda,</para>
  <para style="q2" vid="PRO 8:29">wodi'ikinna ajaja isika sa'abaashsha,</para>
  <para style="q1" vid="PRO 8:29">Butta booso isenxe'n gabalee wodda ani ookko hedhennaan.<verse eid="PRO 8:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 8:30" />Ookkone wodda ani isibira lumoke ogetike hujallomman.</para>
  <para style="q1" vid="PRO 8:30">Barra barra'n isoo gammachchiisa'ennan,</para>
  <para style="q2" vid="PRO 8:30">isi edonna duuchchii wodda gammadaannan.<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />Isi dadeexxe buttatixxee gammadaannan,</para>
  <para style="q2" vid="PRO 8:31">manjiinke beltixxeenna illillissaannan.<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />«Yoona anxe oose! Hiyyaannexxa caqasse;</para>
  <para style="q2" vid="PRO 8:32">ora anka heqqedhaake mannixxa wodo.<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Gorsa anka laqqine muxxete kadde;</para>
  <para style="q2" vid="PRO 8:33">ga'ma'minna hitinoqqe'e.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />Barra barra'in baxxe anxe'n dagaakee,</para>
  <para style="q2" vid="PRO 8:34">hula anxe'n anee'e heqqedhaakee,</para>
  <para style="q2" vid="PRO 8:34">hiyyannoxxanna caqasaake manjixxa wodo.<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />Anee'e alfeeki duuchchi hedho alfammaxxee'e,</para>
  <para style="q2" vid="PRO 8:35">Duuchchi Woddiki Goottanaa'ninna elle alfaani.<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />Anee alfa gopheeki kinni umo ifike miidha;</para>
  <para style="q2" vid="PRO 8:36">anee gibaakirinna reyote eeyaan.»<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">Muxxummatanna Gowwumma</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />Muxxumma mine ifika ijaadhdhite;</para>
  <para style="q2" vid="PRO 9:1">torbaane ifika utuphphuwwanna uggite.<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />Jila affeexxeenna hore dulde; woyinetixxa bookanna bulbulde;</para>
  <para style="q2" vid="PRO 9:2">la'otanna qophpheessite.<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />Ifixxi dubarte erganjuwwa qachchi giddi'a ergite,</para>
  <para style="q2" vid="PRO 9:3">qephphichcha booncho'n uurte manna yexxe.<verse eid="PRO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4" />Isenna qalbeeffachchotixxa xe'ya afeeka duuchchaa,</para>
  <para style="q2" vid="PRO 9:4">«Oosommatineeki duuchchi kaba'a amme!» hite.<verse eid="PRO 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5" />«Amme qophpheesseennexxa ita itte!</para>
  <para style="q2" vid="PRO 9:5">Bulbuleennexxa bookanna ha'we.<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />Ha'nooka gowwummatika ora waale hedhotinna hexxinaan;</para>
  <para style="q2" vid="PRO 9:6">qalbeeffachchotike ora'ninna me'we.»<verse eid="PRO 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />Gacifataaka manjo gorsaak duuchchi yowwaake badhaadhaa;</para>
  <para style="q2" vid="PRO 9:7">fuggichcha xixaaki duuchchcinna salphinneke alfa.<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />Gacifataaka manjo xixxoxxe'e, atee'e gibaan;</para>
  <para style="q2" vid="PRO 9:8">muxxe manjo kinni xixi; atee eeyyaan.<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />Muxxe manjo barsiis, lebee'e muxxe kadaan;</para>
  <para style="q2" vid="PRO 9:9">qullichcha manjo barsiis ege'nate lephphaan.<verse eid="PRO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />Duuchchi Woddika Gootta sodaata muxxummatike ke'iton;</para>
  <para style="q2" vid="PRO 9:10">ookkone Woyyichchakanna ege'na'a qalbeeffachchoten.<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="JOB 28:28">Iyo. 28:28</ref>; <ref loc="PSA 111:10">Far. 111:10</ref>; <ref loc="PRO 1:7">Mam. 1:7</ref>. </char></note><verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />Aninni bari atik qeerredhammaxxee,</para>
  <para style="q2" vid="PRO 9:11">hexxattoxxi atixxi woggaarinna ati'a lebbendaan.<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />Muxxaloke kaddottole muxxumma atixxi umo atingeeten;</para>
  <para style="q2" vid="PRO 9:12">gacifatatoke kaddottolenna ifinni miitatto.<verse eid="PRO 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />Muxxete kada gopha lallabbamaxxe</para>
  <para style="q2" vid="PRO 9:13">mitte ege'nanna affemmabaaxxe hawwawwa manjoshshaten.<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />Ise ifike minixxe baxxe'n,</para>
  <para style="q2" vid="PRO 9:14">qachchi giddike qephphichcha booncho'n ofoldaan.<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />Ookkoo'n sa'aakara,</para>
  <para style="q2" vid="PRO 9:15">sammi hiyye ora ifika me'aakara yexxaan.<verse eid="PRO 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16" />Isenna qalbeeffachchotixxa xe'ya afeeka duuchcha,</para>
  <para style="q2" vid="PRO 9:16">«Oosummatineek duuchchi kaba'a amme!» hitaan.<verse eid="PRO 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17" />«Mooriinki wodi'i xe'maan;</para>
  <para style="q2" vid="PRO 9:17">gollante indeexxi itanna gammachchiissaan.»<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />Insa'ne kinni iseba mareek reyeexxa,</para>
  <para style="q2" vid="PRO 9:18">ta'a yexxa'neekirinna reyemmak manni hedheeba hedheexxa egennebaan.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s1">Solomoonika mammaassuwwa</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />Solomoonka mammaassuwwa,</para>
  <para style="q1" vid="PRO 10:1">Muxxe belti anna gammachchiisa,</para>
  <para style="q2" vid="PRO 10:1">hawwawwi belti kinni amatee yaaddote ila.<verse eid="PRO 10:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />Seeribeloke orinni daggeexxi karra la'o affeba'a,</para>
  <para style="q2" vid="PRO 10:2">qullummate'n gala kinni reyotenaa'n gatisa.<verse eid="PRO 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />Duuchchi Woddik Gootti qulliyye sololsabaan,</para>
  <para style="q2" vid="PRO 10:3">fuggaalleeyyetixxa halcha kinni oranni gatisa.<verse eid="PRO 10:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />Hujete'ni goofaak manji hiyyoommaan,</para>
  <para style="q2" vid="PRO 10:4">jabaate huccaaki kinni duroommaan.<verse eid="PRO 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />Midha aagammaxxe yanna'ni bukki assedhaak belti muxxete, midha aassatixxe yanna'n diiphphaak kinni salphata.<verse eid="PRO 10:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />Qullichchi manji eebbisema,</para>
  <para style="q2" vid="PRO 10:6">hunnati manjokke'n ke'a manni kinni hunnati ke'a ifixxa eloke haaso'inni buqqa.<verse eid="PRO 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />Qulliyyetixxi qalli hiyyema eebbate,</para>
  <para style="q2" vid="PRO 10:7">fuggaalleeyyetik summi kinni dedheme gata.<verse eid="PRO 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />Yaada elokiki manji ajaja adhdhaan,</para>
  <para style="q2" vid="PRO 10:8">oosommatake afoollichcha manjo'ni kinni ba'nete iso'n daggaan.<verse eid="PRO 10:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />Dhugaatik manji ruphphi belo hedhaan,</para>
  <para style="q2" vid="PRO 10:9">dabaaleessi manji kinni abidema.<verse eid="PRO 10:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />Manjoke'n elobaaxxenni qinfi hiyyaaki rakkote geessissa,</para>
  <para style="q2" vid="PRO 10:10">afoollichchi oossoommataakinna ba'nete iyyedaga.<verse eid="PRO 10:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />Qullichchi manjiki afo'i hedhotixxe muummeshshaten,</para>
  <para style="q2" vid="PRO 10:11">hunati manjoke'n ke'aa manni kinni hunnati ke'a ifixxa eloke haaso'inni buqqa.<verse eid="PRO 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />Jibbi lola ke'issaan,</para>
  <para style="q2" vid="PRO 10:12">jaalala kinni dedha duuchcha gattowwaal hita.<note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="JAS 5:20">Ya'i. 5:20</ref>; <ref loc="1PE 4:8">1 Phex. 4:8</ref>. </char></note><verse eid="PRO 10:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />Muxxumma eloyo'oxxa gargar assaake manjike afo'n hexxaan,</para>
  <para style="q2" vid="PRO 10:13">kuti kinni qalbeeffachcho afebaake manjike dudduro'nite.<verse eid="PRO 10:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />Muxxe manni ege'na gudhdhaan,</para>
  <para style="q2" vid="PRO 10:14">oossoommataak manji afo'i kinni ba'nete iyyedaga.<verse eid="PRO 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />Durumma dureyyete'e gollaken,</para>
  <para style="q2" vid="PRO 10:15">yaane kinni hiyyumma hiyyeeyyete'n ba'ne iyyedagga.<verse eid="PRO 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />Qulliyye mannixxe qullummaki rundi hedhoten,</para>
  <para style="q2" vid="PRO 10:16">fuggaalees mannixxi la'o kinni xixemate.<verse eid="PRO 10:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />Gorsa adhdhaak wele mann'a hedhotike ora leellishshaan,</para>
  <para style="q2" vid="PRO 10:17">kula adha'baaak kinni dedhiinke ora'n akeeka.<verse eid="PRO 10:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />Ifika jibba buqe'e sa'aak dharcha afo'iken,</para>
  <para style="q2" vid="PRO 10:18">odo elqe kayya rokaaki duuchchi oossoommateeken.<verse eid="PRO 10:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />Haaso'iinxe birasa'ne'n cubbo gophendaba'a,</para>
  <para style="q2" vid="PRO 10:19">afo'o ifika buqedhaak kinni muxxete.<verse eid="PRO 10:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />Qullichchi manjik afo'i ca'a hiyyeeke birretike sibljishshate,</para>
  <para style="q2" vid="PRO 10:20">fuggichchi manjiki yaadi la'o afeba'a.<verse eid="PRO 10:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />Qulliyyetik haaso'i heddo manni'a la'o uwwaan,</para>
  <para style="q2" vid="PRO 10:21">oossoommataakir kinni eloyo'oxxa gargar hiissa gophatenaa'n kexxeexxa renna.<verse eid="PRO 10:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />Duuchchi Woddike Goottixxi eebba manjo duroonssitaan, isi</para>
  <para style="q2" vid="PRO 10:22">rakko ise'ni lebabaan.<verse eid="PRO 10:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />Oossoommataak manji fuggoxxa hujaa wodda gammadaan,</para>
  <para style="q2" vid="PRO 10:23">qalbeffachcho afeek kinni muxxummate'n gammada.<verse eid="PRO 10:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />Fuggichcha manjo'n sodaateexxe yaane dagga,</para>
  <para style="q2" vid="PRO 10:24">qullichchi halcheexxi isi'a uwwenda.<verse eid="PRO 10:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />Hobonbalte gandaa wodda fuggaalleyye fiyende baxxa,</para>
  <para style="q2" vid="PRO 10:25">qulliyye kinni duuchchii wodda hexxemmaba lele'mitebaang hexxaan.<verse eid="PRO 10:25" /></para>
  <para style="b" />
  <para style="p">
    <verse number="26" style="v" sid="PRO 10:26" />Majajaachch issotee, wiliille illetee eldammabaashsha,</para>
  <para style="q2" vid="PRO 10:26">boose'i manjinna isoo'o ergedhaakeri'a iittande.<verse eid="PRO 10:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />Duuchchi Woddika Gootta sodaata hedhotika baro qeerrissa,</para>
  <para style="q2" vid="PRO 10:27">fuggaalleyyetik bari kinni haru'me oranni gata.<verse eid="PRO 10:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />Qulliyyetixxe halchaki muuxami gammashshoten,</para>
  <para style="q2" vid="PRO 10:28">fuggaalleeyyetixxi halcha kinni tola gattaan.<verse eid="PRO 10:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />Duuchchi Woddike Goottik ori qulliyyete'e gollake,</para>
  <para style="q2" vid="PRO 10:29">fuggaalleeyyeete kinni ba'nete.<verse eid="PRO 10:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />Qulliyye haranga le'mitaba'a,</para>
  <para style="q2" vid="PRO 10:30">fuggaaleyye kinni buttate'n hexxaba'a.<verse eid="PRO 10:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />Qulliyyetik afo'i beekuma haaso'aan,</para>
  <para style="q2" vid="PRO 10:31">daba haaso'aak arrabi kinni woxemaan.<verse eid="PRO 10:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />Qulliyyetik afo'i seeriinxe yaane haaso'a,</para>
  <para style="q2" vid="PRO 10:32">fuggaalleyyetik afo'i haaso'a ege'nechchi kinni fuggoxxe calla.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />Duuchchi Woddiki Gootti moortaaxxa kiilo giba,</para>
  <para style="q2" vid="PRO 11:1">dhugaatixxe kilo'ni kinni gammada.<verse eid="PRO 11:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />Hollatixxa duuka salphinake dagaan,</para>
  <para style="q2" vid="PRO 11:2">shaqqake manjonaa'ni kinni beekumake afemaan.<verse eid="PRO 11:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />Qajeeli mannixxi balleessa afagopha insa'ne akeekka,</para>
  <para style="q2" vid="PRO 11:3">addatemabaaki manni kinni sobi ifingennin ba'aan.<verse eid="PRO 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />Duruumma murtetenaa'ni gatisaba'a,</para>
  <para style="q2" vid="PRO 11:4">qullumma kinni reyotenaa'ni gatissa.<verse eid="PRO 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />Qajeeli mannixxi qullumma insa'ne'a ora qajeelchita,</para>
  <para style="q2" vid="PRO 11:5">fuggaalleeyye kinni ifinxe fuggoxxe hujenni baxxa.<verse eid="PRO 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />Qajeela manna qulumma insa'neexxi insa'nee anjirta,</para>
  <para style="q2" vid="PRO 11:6">addatemabaaka manna kinni fuggoxxi insa'neexi gaabe insa'ne fonxorta.<verse eid="PRO 11:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />Fuggaalleessi manji reyaa wodda addatemaaxxi yaane tolanga gattaan,</para>
  <para style="q2" vid="PRO 11:7">ifi'ni hollammaaxxi yaane duuchchi isinninni welti baxxa.<verse eid="PRO 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />Qullichchi manji rakkotenaa'ni anjirema,</para>
  <para style="q2" vid="PRO 11:8">fuggaalleessa manjo'n rakko caala gelta.<verse eid="PRO 11:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />Fuggaalleesi manji afo'ik manjo balleessaan,</para>
  <para style="q2" vid="PRO 11:9">qulliyye kinni affeexxe ege'nanni miliqqa.<verse eid="PRO 11:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />Qulliyyetee yaane qajeeldaa wodda qachchi gammada,</para>
  <para style="q2" vid="PRO 11:10">fuggaalleeyye rertaa wodda kinni ililisate kadda.<verse eid="PRO 11:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />Qajeeli manni eebbisemaa wodda qachchi nophpha,</para>
  <para style="q2" vid="PRO 11:11">fuggaalleessi mannike afo'inni kinni qachchi ba'a.<verse eid="PRO 11:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />Qalbeeffachchotixxa xe'ya afeeki manji manjo tuffata,</para>
  <para style="q2" vid="PRO 11:12">qalbeeffachcho afeeki kinni afo'o buqedha.<verse eid="PRO 11:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />Hamataaki manji maqo haaso'a heqqe abidaba'a,</para>
  <para style="q2" vid="PRO 11:13">addatemeeki manji kinni maqoti haaso'a fulchaba'a.<verse eid="PRO 11:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />Akkeettetixxi xe'ya hexxeeba ardi ibaan,</para>
  <para style="q2" vid="PRO 11:14">gorsa uwwaaki heddi manni hedheeba kinni injiffachcho kokessenda.<verse eid="PRO 11:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />Ege'nebaake manjike liqi'aa annooma adhdhaa manjo'n rakkote geltaan,</para>
  <para style="q2" vid="PRO 11:15">annooma adhdha gibaaka kinni rakko iso'n geltaba'a.<verse eid="PRO 11:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />Arija manjichcho ulfinna alfita,</para>
  <para style="q2" vid="PRO 11:16">hunnaameessi manni kinni karra calla alfa.<verse eid="PRO 11:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />Elo manjiinxi elle isi'aanni la'o uuta,</para>
  <para style="q2" vid="PRO 11:17">fuggichchi manji kinni umo isinge'n rakko iyyedagga.<verse eid="PRO 11:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />Fuggichchi manji hujaaxxe huje'a alfaaxxi dhugaati la'o hexxeba'a,</para>
  <para style="q2" vid="PRO 11:18">qullumma hujaak kinni dhugaatike hira alfa.<verse eid="PRO 11:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />Dhugaat qullummate'n galaak hedho alfa,</para>
  <para style="q2" vid="PRO 11:19">fuggoxxe'ni me'aki kinni reyo'a me'a.<verse eid="PRO 11:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />Duuchchi Woddiki Gootti dabaaleessa yaadika manna diqata,</para>
  <para style="q2" vid="PRO 11:20">ci'memaachcho afebaake'n kinni gammada.<verse eid="PRO 11:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />Fuggaalleessi manji xixemebaak gatabaaxxa ege'ni,</para>
  <para style="q2" vid="PRO 11:21">qulliyye kinni tennenaa'n gatta.<verse eid="PRO 11:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />Qalbeeffachcho affebaaxxe dancha manjoxxi danchumma,</para>
  <para style="q2" vid="PRO 11:22">booyyetixxe sano'ni uggendeexxe worqexxe danchummashshaten.<verse eid="PRO 11:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />Qulliyyetixxe halchaki muuxami haanonna eloke,</para>
  <para style="q2" vid="PRO 11:23">fuggaalleessi mannixxe addeki muuxami kinni ba'nete.<verse eid="PRO 11:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />Mitti manji arjoome uwwake kaddole saxxeexxa karra alfa,</para>
  <para style="q2" vid="PRO 11:24">mitti manji yo'oshsha donnoomoole, kinni hiyyoomaan.<verse eid="PRO 11:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />Ariji durrooma,</para>
  <para style="q2" vid="PRO 11:25">wele manna dheebo fulchaak isinna dheebo fula.<verse eid="PRO 11:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />Sho'ik midha mine tuu'leeka ardi yowwaan,</para>
  <para style="q2" vid="PRO 11:26">dikko fulche'e gurguraaki kinni eebbisema.<verse eid="PRO 11:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />Eloxxa yaane jabaate harsaaka manjo eloxxe iso'o heqitaan,</para>
  <para style="q2" vid="PRO 11:27">fuggoxxa yaane harsaaki manji kinni fuggonxe iso'n geltaan.<verse eid="PRO 11:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />Karra ifixxe'n addataak duuchchi iba,</para>
  <para style="q2" vid="PRO 11:28">qulliyye kinni kichchotishsha quffa.<verse eid="PRO 11:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />Mini hado ifika olokaaki manji mittelchcho alfaachchi hedheba'a,</para>
  <para style="q2" vid="PRO 11:29">gowwi manjinna muxxe manjike garba kada.<verse eid="PRO 11:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />Qulliyyetixxi gumma hedhotike haqichchon,</para>
  <para style="q2" vid="PRO 11:30">manna gorse hiisaak isi muxxeten.<verse eid="PRO 11:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />Qulliyye hujjeexxe hujeka hira buttande'n alfitammashanni,</para>
  <para style="q2" vid="PRO 11:31">iittanni fuggaalleeyyetinna cubbaalleeyye buttate'n ifixxe hujeka hira alfitaan.<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="1PE 4:18">1 Phex. 4:18</ref>. </char></note><verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />Cabbema eeyyaaki manji ege'na eeya,</para>
  <para style="q2" vid="PRO 12:1">toggi assema gibaaki kinni gowwake.<verse eid="PRO 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />Eloki manji Duuchchi Woddike Goottanaa'ni elle alfa,</para>
  <para style="q2" vid="PRO 12:2">manjo dedhisaake manjo'ni kinni Duuchchi Woddiki Gootti mura.<verse eid="PRO 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />Fuggoxxi huje fuggichcha nage'a hoyyita,</para>
  <para style="q2" vid="PRO 12:3">qulliyye kinni lele'mitaba'a.<verse eid="PRO 12:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />Qalbameette manjo aro'o ifike'e kallachchaken,</para>
  <para style="q2" vid="PRO 12:4">aro'o ifika shookishaaxxi are kinni micci giddo lullugaake luuxishshate.<verse eid="PRO 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />Qulliyyetiki yaadi toggichchake,</para>
  <para style="q2" vid="PRO 12:5">fuggaalleeyyetiki gorsi kinni dabaaleessake.<verse eid="PRO 12:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />Fuggaalleeyyetik haaso'i shiltammaxxe fonxoroshshate,</para>
  <para style="q2" vid="PRO 12:6">qajeeli manniki kinni manna anjira.<verse eid="PRO 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />Fuggaalleessi manni reye muda,</para>
  <para style="q2" vid="PRO 12:7">hafe insa'nexxinna gattabaan,</para>
  <para style="q2" vid="PRO 12:7">qulliyyetixxi horte kinni lele'mitabaan.<verse eid="PRO 12:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />Manji muxxumma ifixxe'n galateeffatema,</para>
  <para style="q2" vid="PRO 12:8">fuggoka yaada afeeki manni kinni tuffatemaan.<verse eid="PRO 12:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />Itaachcho afebaangi ifi saadaake manji mannii'n,</para>
  <para style="q2" vid="PRO 12:9">ifi lummisebaangi hucce galaaka manjo woyyan.<verse eid="PRO 12:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />Qullichchi manji ifika hore mararaan,</para>
  <para style="q2" vid="PRO 12:10">fuggaalleeyye kinni duuchchii wodda marartaba'a.<verse eid="PRO 12:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />Fichcha huccaake manji'a itaachchi wo'meke,</para>
  <para style="q2" vid="PRO 12:11">la'o affebaaxxe yaane'a gongaaki manji kinni xe'ya heduma afeeke.<verse eid="PRO 12:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />Fuggaalleeyye saamendeexxa karra weli gaabbitaan,</para>
  <para style="q2" vid="PRO 12:12">qulliyye kinni eloke hiddichchishsha eloxxa ra'istaan.<verse eid="PRO 12:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />Fugaalleessi manji haaso'a ifingininni fonxoremaan,</para>
  <para style="q2" vid="PRO 12:13">qullichchi manji kinni rakkotenaa'ni fulaan.<verse eid="PRO 12:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />Manji eloke haaso'i ifikenni eloxxe yaanenni wo'maan,</para>
  <para style="q2" vid="PRO 12:14">huje isixxishshanna hasisaaka hira alfaan.<verse eid="PRO 12:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />Yaadiki oossoommataake manji'a me'inji ifiki toggichchake labaan,</para>
  <para style="q2" vid="PRO 12:15">muxxe manji kinni gorsa laqaan.<verse eid="PRO 12:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />Yaadiki oossoommataake manjixxi aare ikki woddi ege'nendaan,</para>
  <para style="q2" vid="PRO 12:16">qalbaameesi manji kinni yowwichcho tufatee waalaan.<verse eid="PRO 12:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />Dhugaa haso'aaki manji uudeexxa dhugaa kulaan,</para>
  <para style="q2" vid="PRO 12:17">dharichchi manji kinni dhariki dhugaa kulaan.<verse eid="PRO 12:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />Afeeshshanni haaso'aake manjiki haaso'i bagedinsha ota,</para>
  <para style="q2" vid="PRO 12:18">muxxe manjiki afo'i kinni fayyisaan.<verse eid="PRO 12:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />Dhugaa haaso'aki afo'i kinni duuchchii woddi'a hedha,</para>
  <para style="q2" vid="PRO 12:19">dhara haaso'aaki arrabi kinni ikki woddi ba'aan.<verse eid="PRO 12:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />Fuggoxxa hedaake mannixxe qalbe giddo fuggoxxe hexxeen,</para>
  <para style="q2" vid="PRO 12:20">nage'i dagaashsha gorsaake manni'a kinni gammashsho hexxeen.<verse eid="PRO 12:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />Qulliyye fuggooxxi geltabaan,</para>
  <para style="q2" vid="PRO 12:21">fuggaaleeyyete'ni rakko bira saxxaan.<verse eid="PRO 12:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />Duuchchi Woddiki Gootti dhara haaso'aaka afo'o eeyyabaan,</para>
  <para style="q2" vid="PRO 12:22">dhugaatike manna'ni kinni gammadaan.<verse eid="PRO 12:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />Qalibaameessi manji ege'na sho'edha,</para>
  <para style="q2" vid="PRO 12:23">gowwoole kinni haakito ifika haaso'ik leellishsha.<verse eid="PRO 12:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />Huje jabaatee hucce manjo galchalloke assitaa wodda,</para>
  <para style="q2" vid="PRO 12:24">boosse'ake kada kinni garbake assita.<verse eid="PRO 12:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />Ruphphi hiyya manjoke'ni yaado bira sa'issita,</para>
  <para style="q2" vid="PRO 12:25">eloki hiyyichchi kinni gammachchiisa.<verse eid="PRO 12:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />Qullichchi manji jaalo ifike'e elooke gorsa gorsa,</para>
  <para style="q2" vid="PRO 12:26">fuggaalleeyyetik me'inj kinni dedhake'n ibisaan.<verse eid="PRO 12:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />Boose'i manji adame iyyedageeka maala midde dudhilshabaan,</para>
  <para style="q2" vid="PRO 12:27">baredi manji kinni ifixxa karra lummisee uudaan.<verse eid="PRO 12:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />Qulummatike ora'ni hedhdho hexxeen,</para>
  <para style="q2" vid="PRO 12:28">ookkone ora'n reyo hexxeba'a.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />Muxxeeki belti anniinka gorsa qalibeefate laqaan,</para>
  <para style="q2" vid="PRO 13:1">gacifataak kinni xixichcho laqabaan.<verse eid="PRO 13:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />Elok manji elooke haaso'a ifike'n elooxxa yaane alfaan,</para>
  <para style="q2" vid="PRO 13:2">addatemabaaki manni kinni hunnati manjoke'n ke'a halcha.<verse eid="PRO 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />Haaso'a heqqedha'n haaso'aak hedho ifixxa heqqedha,</para>
  <para style="q2" vid="PRO 13:3">afeeshshanni haaso'aak kinni ba'aan.<verse eid="PRO 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />Boose'i manji jaba qico halcha mittelchonna alfaba'a,</para>
  <para style="q2" vid="PRO 13:4">jabaate huccaaki kinni halseechcho godda.<verse eid="PRO 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />Qullichchi manji dhara giba,</para>
  <para style="q2" vid="PRO 13:5">fuggaalleessi manji kinni shookokanna salphinne iyyedaga.<verse eid="PRO 13:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />Qullumma qajeela manjo heqqita,</para>
  <para style="q2" vid="PRO 13:6">fuggaalleessumma kinni cubbaalleessa balleesita.<verse eid="PRO 13:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />Mittelchonna afeechchi hedhebaang ifi durreesaake assaaki manji hedhe,</para>
  <para style="q2" vid="PRO 13:7">weli kinni ifi hiyyeessake assaaki hedhe, yaane kinni isi lumoxxe karra afe.<verse eid="PRO 13:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />Karra horateeki manji isenni ifixxa hedho woda dande'a,</para>
  <para style="q2" vid="PRO 13:8">hiyyeessi kinni tenne rakko afeba'a.<verse eid="PRO 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />Qulliyye ifiinsha wa'a hittee iffa,</para>
  <para style="q2" vid="PRO 13:9">fugaalleeyye kinni xo'ammake ifishsha xoxxa.<verse eid="PRO 13:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />Holla lola calla bira sa'issita,</para>
  <para style="q2" vid="PRO 13:10">muxxumma kinni gorsa adhaake manna'n afendaan.<verse eid="PRO 13:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />Elobelo afendaaxxi karra butti butti'a higa'n me'ite muddaan,</para>
  <para style="q2" vid="PRO 13:11">maallaqa ifika heeno heenoka qulsaakee kinni isi'a camemaan.<verse eid="PRO 13:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />Turteexxi addachchiisa manjo yaadissa,</para>
  <para style="q2" vid="PRO 13:12">halchatixxi wo'miyyo kinni hedho uwwaake haqichchon.<verse eid="PRO 13:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />Gorsemeeka gorsa tuffataaki umo ifike'n ba'ne iyyedaqqa,</para>
  <para style="q2" vid="PRO 13:13">ajaja ulfeessaaki kinni hira alfa.<verse eid="PRO 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />Muxxe manji barachchiisaaxxi barachcho hedhotixxe muummen,</para>
  <para style="q2" vid="PRO 13:14">manjokanna reyotixxe fonxoro'n abidemabaashsha gatisa.<verse eid="PRO 13:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />Qalbeeffachcho alfa manjo ulfataashsha assita,</para>
  <para style="q2" vid="PRO 13:15">addatemabaake mannik me'inji kinni ba'nete'n geessisaan.<verse eid="PRO 13:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />Qalibameessi manji huje muxxummati hucca,</para>
  <para style="q2" vid="PRO 13:16">oossoommataak kinni gowwumma ifixxishsha hucca.<verse eid="PRO 13:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />Fuggoki erganji rakkote'ni iba,</para>
  <para style="q2" vid="PRO 13:17">addatemeek erganji kinni nage'a afisaan.<verse eid="PRO 13:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />Cabbema gibaaki hiyyoomenna shookoke'n iba,</para>
  <para style="q2" vid="PRO 13:18">toggi assemaak duuchchi kinni ulfaataan.<verse eid="PRO 13:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />Halcha muuxxendaa wodda hedho gammaddaan,</para>
  <para style="q2" vid="PRO 13:19">oosommataakir kinni fuggoxxenaa'ni bayyata eeyyabaan.<verse eid="PRO 13:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />Muxxe manjinni hosaak muxxete kada,</para>
  <para style="q2" vid="PRO 13:20">oossoommataake manninni jaalomaak kinni rakkot miidhema.<verse eid="PRO 13:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />Fuggooxxi cubbaalleeyye hordoffaan,</para>
  <para style="q2" vid="PRO 13:21">qulliyyetiki hir kinni durummate.<verse eid="PRO 13:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />Qajeeli karra ifixxa oosetixxe oose'a sa'isa,</para>
  <para style="q2" vid="PRO 13:22">cubbaalleeyye tuu'liteexxa karra kinni qulliyye dhaalda.<verse eid="PRO 13:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />Hiyyeyyetike fichchixxi midha missaaxxe hexxe,</para>
  <para style="q2" vid="PRO 13:23">yaane kinni seeribeloke mannanaa'ni kexxexxa ise'e gophenda.<verse eid="PRO 13:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />Kutik belto ifika gana sodaataak belto ifika gibaaken,</para>
  <para style="q2" vid="PRO 13:24">belto ifika eyyaaki kinni xexe'achchoti xixaan.<verse eid="PRO 13:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />Qullichchi itee godda;</para>
  <para style="q2" vid="PRO 13:25">fugaalleeyye kinni solo'witeeshshanni hexxaan.<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 14:1" />Muxxe manjichcho mine ifika ijaartaan,</para>
  <para style="q2" vid="PRO 14:1">oossommataaxxi manjichcho kinni ifixxe anganninn diiggaan.<verse eid="PRO 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />Me'inji isik qajeelake kadeek manji Duuchchi Woddika Gootta sodaataan,</para>
  <para style="q2" vid="PRO 14:2">ori isik dabaalesa kadeek manji kinni iso'o tufata.<verse eid="PRO 14:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />Oossoommataak manji afo'inginn gane adhdha,</para>
  <para style="q2" vid="PRO 14:3">muxxe manjik haaso'i kinni yo'oxxenaa'ni isoo gatisa.<verse eid="PRO 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />Qotiyyo hexxebaaba midha hexxaba'a,</para>
  <para style="q2" vid="PRO 14:4">qottiyyotixxe hunnanni kinni lummoxxi midha afenda.<verse eid="PRO 14:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />Addatendeexxi dhuga sobo haasottaba'a,</para>
  <para style="q2" vid="PRO 14:5">dhariinxi dhugaa kinni dhariki dhugaa kulda.<verse eid="PRO 14:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />Gacifataaki manji muxxoomma halchaa male'e alfaba'a,</para>
  <para style="q2" vid="PRO 14:6">qalbaameeyyetee kinni ege'na shollaqicininni afenda.<verse eid="PRO 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />Isonaa'n ege'natika haaso'a alfa gophphattaxxee,</para>
  <para style="q2" vid="PRO 14:7">oossoommataake manjonaa'n bayyati.<verse eid="PRO 14:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />Qarumma manjinxxi muxxumma ora ifika qalbeeffachchote,</para>
  <para style="q2" vid="PRO 14:8">gowwi mannixxi gowwumma kinni sobemate.<verse eid="PRO 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />Gowwi manni cubbo hujaa wodda gacifata,</para>
  <para style="q2" vid="PRO 14:9">qajeeli manni kinni cubbo insa'neexxi gattowwaal hiyyendo'a yora.<verse eid="PRO 14:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />Mitti mitting manji ifi ifixxe qalbetixxa yaado ege'ne'e,</para>
  <para style="q2" vid="PRO 14:10">gammashsho isixxanna ayyinna isinni qoodemaba'a.<verse eid="PRO 14:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />Fuggaalleeyyetiki mini diigema,</para>
  <para style="q2" vid="PRO 14:11">qajeeli manniki duunkaani kinni hedheeshshann hedha.<verse eid="PRO 14:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />Manjoke'n eloke labaake ora hedhe,</para>
  <para style="q2" vid="PRO 14:12">udumi uduma kinni reyotiba iyyemara.<note caller="-" style="x"><char style="xo" closed="false">14:12 </char><char style="xt" closed="false"><ref loc="PRO 16:25">Mam. 16:25</ref>. </char></note><verse eid="PRO 14:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />Manji oso'la'inni ifi giddo yaada dande'a,</para>
  <para style="q2" vid="PRO 14:13">gammashshotinna yaadoti muuxema dandeeta.<verse eid="PRO 14:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />Qullummatike oranaa'n higaaki ifixxe hujeka hira adhdha,</para>
  <para style="q2" vid="PRO 14:14">qajeeli manjinna ifinxe hujeka hira alfa.<verse eid="PRO 14:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />Gowwi manji haasonnexxa duuchcha dhuggate hiyyee adhdha,</para>
  <para style="q2" vid="PRO 14:15">qaroontichchi manji kinni ifika me'injo hubate uuda.<verse eid="PRO 14:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />Muxxe manji xexxe'ate fuggoxxenaa'ninna bayyata,</para>
  <para style="q2" vid="PRO 14:16">oosommataaki manji kinni wiinamik afeeshshanni me'a.<verse eid="PRO 14:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />Hifattichchi manji gowwiinxe huje huja,</para>
  <para style="q2" vid="PRO 14:17">xaqartichchi manjinna gibema.<verse eid="PRO 14:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />Ege'na afebaak manni ege'na gophatika hira alfa,</para>
  <para style="q2" vid="PRO 14:18">qalbaameessi manni kinni ege'na kallachchiinsha uggudhdhaan.<verse eid="PRO 14:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />Fuggaalleeyye qajeeli manni edo,</para>
  <para style="q2" vid="PRO 14:19">cubbaalleeyyenna qulliyyetixxe wuddumme edo heeshshi hitaan.<verse eid="PRO 14:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />Hiyyeeyye jaaluwwi insa'neki midde insa'nee gibaan,</para>
  <para style="q2" vid="PRO 14:20">dureeyye kinni heddo jaaluwwa affe'en.<verse eid="PRO 14:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />Ollalcho tufataak cubbo hujeeke,</para>
  <para style="q2" vid="PRO 14:21">hiyyeeyye gargaarak kinni eebbisemaake.<verse eid="PRO 14:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />Fuggoxxa asso'a hedaak dedhaamessake,</para>
  <para style="q2" vid="PRO 14:22">eloxxa asso'a hedaak kinni eeyyaakanna addatemeeka jaaluwwa afaan.<verse eid="PRO 14:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />Eloonne hunjeechchi duuchchi la'o iyyedaga.</para>
  <para style="q2" vid="PRO 14:23">Odo duwwixxi kinni hiyyummate'n iyyemarta.<verse eid="PRO 14:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />Muxxe mannixxi durumma insa'nexxe ulfaachcho;</para>
  <para style="q2" vid="PRO 14:24">oossoommataake mannixxi oossoommachchotixxi gumma kinni oossoommachchote.<verse eid="PRO 14:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />Dhugaat dhugaa kulaak lubbo anjira,</para>
  <para style="q2" vid="PRO 14:25">dharik dhugaa kulaak kinni sobaaleessake.<verse eid="PRO 14:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />Duuchchi Woddika Gootta sodaataak jabake golla afee,</para>
  <para style="q2" vid="PRO 14:26">oose ifixxeenna irkote.<verse eid="PRO 14:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />Duuchchi Woddika Gootta sodaata hedho utaaxxe muummen,</para>
  <para style="q2" vid="PRO 14:27">manjo reyotixxe fonxoronaa'ni anjirtaan.<verse eid="PRO 14:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />Ardiinxi birasa'ne moyanjokee ulfinnake kaddaa wodda,</para>
  <para style="q2" vid="PRO 14:28">ardiinxi heeno'ma kinni galchammake moyanji'a ba'nete.<verse eid="PRO 14:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />Ossaameessi manji lumoxxe qalbeffachcho afe'en,</para>
  <para style="q2" vid="PRO 14:29">hiffatichchi manji kinni gowwumma ifixxa leellishsha.<verse eid="PRO 14:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />Nageelte sammo manjixxe hedho'a fayyate,</para>
  <para style="q2" vid="PRO 14:30">hinaaffe kinni hedho luuxxiinsha itta.<verse eid="PRO 14:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />Hiyyeeyye rakkisaak manji insa'nee dadeeka tuffateeke,</para>
  <para style="q2" vid="PRO 14:31">hiyyeeyyetee eloxxa assaaki kinni Mageno ulfeseeke.<verse eid="PRO 14:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />Fuggaalleeyye fuggo huja insa'neexxi insa'nee ibissa,</para>
  <para style="q2" vid="PRO 14:32">qulliyye kinni reyotixxa yannanna midde golla affe.<verse eid="PRO 14:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />Muxxumma qalbeeffachcho afeeke mannixxe qalbe'n galda,</para>
  <para style="q2" vid="PRO 14:33">oossoommataak manni kinni isee ege'neba'a.<verse eid="PRO 14:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />Qullumma arda lummissa,</para>
  <para style="q2" vid="PRO 14:34">cubbo kinni hoonee ardanna salphissa.<verse eid="PRO 14:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />Muxxe erganj moyanjo ifika gammachchiisa,</para>
  <para style="q2" vid="PRO 14:35">shookishshaak erganji kinni moyanjo mufachchiisa.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />Eloki hiisichchi aare qiidisaani;</para>
  <para style="q2" vid="PRO 15:1">fuggoki hiyyichchi kinni mufe bira sa'issaani.<verse eid="PRO 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />Muxxe manjiki arrabi ege'na saadaani;</para>
  <para style="q2" vid="PRO 15:2">oossoommataake manjiki arrabi kinni gowwummate haaso'aani.<verse eid="PRO 15:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />Duuchchi Woddike Goottixxi ille duuchchiini booncho uuddaaxxeni;</para>
  <para style="q2" vid="PRO 15:3">fuggaalleeyyenna qulliyye uudaani.<verse eid="PRO 15:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />Eloki arrabi hedhotike haqichchoni</para>
  <para style="q2" vid="PRO 15:4">dabaalleesi arraabi kinni lubbo yaadisaani.<verse eid="PRO 15:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />Oossoommataaki manji anna ifikika gorsa tuffataani;</para>
  <para style="q2" vid="PRO 15:5">gorsa adhdhaaki kinni qalbaameessake kadeexxa ege'nishshaani.<verse eid="PRO 15:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />Qulliyyetiki mini karra callinni wo'meekeni;</para>
  <para style="q2" vid="PRO 15:6">fuggaalleeyye alfitaaxxi la'o kinni rakko insa'ne'nini geessissaani.<verse eid="PRO 15:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />Muxxe manniki arraabi ege'na bira sa'issaani;</para>
  <para style="q2" vid="PRO 15:7">oossoommataake mannixxi qalbe kinni iittatebaani.<verse eid="PRO 15:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />Duuchchi Woddiki Gootti fuggaalleeyyetika tolcha diqataan;</para>
  <para style="q2" vid="PRO 15:8">qajeeli mannixxe soodachcho'ni kinni gammadaani.<verse eid="PRO 15:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />Duuchchi Woddiki Gootti fuggaalleeyyetika me'injo diqataan</para>
  <para style="q2" vid="PRO 15:9">qullummate'ni me'akara kinni eeyyaani.<verse eid="PRO 15:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />Dhugaatika ora waalaaki manji jabaaxxa mura waxaan;</para>
  <para style="q2" vid="PRO 15:10">xixichcho gibaaki reyaani.<verse eid="PRO 15:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />Reyemmaki manni hedhemmaxxi bakkanna ba'neetiki boonchi Duuchchi Woddike Gootti edo farri hiyye leelaan;</para>
  <para style="q2" vid="PRO 15:11">manniinxe qalibe giddo hexxeexxa fa'i hittatta ege'ne'e!<verse eid="PRO 15:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />Gacifataaki manji xixxichhco gibaani;</para>
  <para style="q2" vid="PRO 15:12">muxxeeka mannanna mari'achchiisabaani.<verse eid="PRO 15:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />Manji giddo gammashsho afoole albi ifaani;</para>
  <para style="q2" vid="PRO 15:13">isi giddo yaaddo hexxoole kinni hedho isixxa kurbu assitaani.<verse eid="PRO 15:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />Qalbaameesi manji ege'na harsaani;</para>
  <para style="q2" vid="PRO 15:14">oossoomaataak manji kinni gowwumma alalchaani.<verse eid="PRO 15:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />Miicemeeke manniki bari duuchchi rakkotikeni;</para>
  <para style="q2" vid="PRO 15:15">gammadaaki manji kinni duuchchii wodda fenxe hiyyaani.<verse eid="PRO 15:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />Lumoxxa karra horachchoti wixxirri hiyyati mannii'ni;</para>
  <para style="q2" vid="PRO 15:16">Duuchchi Woddika Gootta sodaatati welti hexxeexxa heenoxxa karra woyya.<verse eid="PRO 15:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />Weli jibba hexxeeba ha'yotika jibichcha dulle ita mannii'ni,</para>
  <para style="q2" vid="PRO 15:17">weli eeyya hexxeeba shaana ita woyya.<verse eid="PRO 15:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />Aarameesi manji lola ke'issaani;</para>
  <para style="q2" vid="PRO 15:18">ossi manji kinni lola qiidisaani.<verse eid="PRO 15:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />Boose'i manjiki ori utetike dalla'ishshateni;</para>
  <para style="q2" vid="PRO 15:19">qajeeli manniki ori kinni gugurto afeekebaani.<verse eid="PRO 15:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />Muxxee belti anna ifika gammachchiisaani;</para>
  <para style="q2" vid="PRO 15:20">oossoommataaki manji kinni ama ifinxa tuffataani.<verse eid="PRO 15:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />Qalbeeffatabaake manji'a gowwumma gammachchiisaani;</para>
  <para style="q2" vid="PRO 15:21">qalbaameesi manji kinni dhugaatike ora'ni me'aani.<verse eid="PRO 15:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />Mari'e hedha gophphoole hendeexxi yaane bakka geltabaani</para>
  <para style="q2" vid="PRO 15:22">mari'achchiisaaki manni hedheeba yaane qajeldaani.<verse eid="PRO 15:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />Manji hasissaaxxa hiissa hiissoole gammadaani!</para>
  <para style="q2" vid="PRO 15:23">Yannate'ni uwwemaaki hiyyichchi yo'oshsha eloken!<verse eid="PRO 15:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />Reyemmake manniba'a me'atenaa'ni anjiremaashsha;</para>
  <para style="q2" vid="PRO 15:24">hedhotiki ori muxxe manjo akeekaani.<verse eid="PRO 15:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />Duuchchi Woddiki Gootti hollaameessi manjika mine diigaani;</para>
  <para style="q2" vid="PRO 15:25">aro'o shi'witeexxe manjichchoxxa gabala dhiinbabaashsha heqqaani.<verse eid="PRO 15:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />Duuchchi Woddiki Gootti fuggoke manjika yaada jibbaani;</para>
  <para style="q2" vid="PRO 15:26">qulliyyetiki yaadi kinni gammachchiisaani.<verse eid="PRO 15:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />Donni manji ifike mini hado'ni rakko iyyedagaani;</para>
  <para style="q2" vid="PRO 15:27">matta adhdha gibaaki manji qeerraaka baro hedhaani.<verse eid="PRO 15:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />Qullichchi manji heda'ni haaso'aani;</para>
  <para style="q2" vid="PRO 15:28">fuggaalleessi manjiki afo'i fuggoxxe fulchaani.<verse eid="PRO 15:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />Duuchchi Woddiki Gootti fuggaalleeyyetenaa'ni bayyataani;</para>
  <para style="q2" vid="PRO 15:29">Qulliyyetixxa soodachcho kinni laqaani.<verse eid="PRO 15:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />Ifi manjo gammachchiisaani;</para>
  <para style="q2" vid="PRO 15:30">Eloki haaso'i miccoke'ni aagaani.<verse eid="PRO 15:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />Hedhotiba'a geessisaaka xixichcho adhdhaaki manji;</para>
  <para style="q2" vid="PRO 15:31">muxxee mannixxe oddo'ni hedhaani.<verse eid="PRO 15:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />Cabbema tuffataaki ifinni tuffataani;</para>
  <para style="q2" vid="PRO 15:32">xixichcho adhdhaaki kinni beekake kadaani.<verse eid="PRO 15:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />Duuchchi Woddika Gootta sodaata muxxumma barachchoteni;</para>
  <para style="q2" vid="PRO 15:33">ulfinna alfate'e shaqqake kada hasisaani.<verse eid="PRO 15:33" /></para>
  <para style="b" />
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />Manji herrega herregaan;</para>
  <para style="q2" vid="PRO 16:1">yaane kinni herreg iikki hujete'ni hosaak;</para>
  <para style="q2" vid="PRO 16:1">Duuchchi Woddik Goottinna eetti'i uwwa wodda callan.<verse eid="PRO 16:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />Manjoke'e huje duuchchi ca'ittete fakkaatte leellitaani;</para>
  <para style="q2" vid="PRO 16:2">ookkone yaadika ke'injo kinni Duuchchi Woddiki Gootti memmekisee uudaani.<verse eid="PRO 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />Huje atixxa duuchcha Duuchchi Woddike Gootta'ni magaanne uwwi;</para>
  <para style="q2" vid="PRO 16:3">heddattoxxi duuchchi ati'a qajeeldaani.<verse eid="PRO 16:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />Duuchchi Woddiki Gootti duuchchiinxa yaane ifi'a afeeke yaadi'a dade'eni;</para>
  <para style="q2" vid="PRO 16:4">fuggaalleeyyetanna midde ba'netixxe barra'a qophphesseeni.<verse eid="PRO 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />Duuchchi Woddiki Gootti hollaaka manna duuchcha jibbaani;</para>
  <para style="q2" vid="PRO 16:5">insa'neenna xixenshatenaa'ni gantabaaxxa dhugaandinni ege'ni.<verse eid="PRO 16:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />Jaalalatinna addatenshati cubbo gattowwaali hiyyendaani;</para>
  <para style="q2" vid="PRO 16:6">Duuchchi Woddika Gootta sodaatati manji fuggoxxenaa'ni bayyataani.<verse eid="PRO 16:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />Manjiinki me'inji Duuchchi Woddika Gootta gammachchiisaa wodda;</para>
  <para style="q2" vid="PRO 16:7">naaphuwwi ifikinni midde mitteba nage'iki he'naashsha assaani.<verse eid="PRO 16:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />Dhugaati alfinaaxxi shiixxoxxi yaane;</para>
  <para style="q2" vid="PRO 16:8">fuggoxxinni alfinaaxxa lumoxxa karra saxxaani.<verse eid="PRO 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />Manji hedaani;</para>
  <para style="q2" vid="PRO 16:9">yaane kinni hedeexxi isi'a muuxxendaaki Duuchchi Woddike Goottixxe muranniten.<verse eid="PRO 16:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />Moyanji murte muraaki Mageni baalloonseeke baalloominniteni;</para>
  <para style="q2" vid="PRO 16:10">muraaxxe murte'ninna dedhi afemabaani.<verse eid="PRO 16:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />Dhugaatixxi kiillonna safaranji Duuchchi Woddike Goottikeni;</para>
  <para style="q2" vid="PRO 16:11">subbi giddo hedheeki safaranjuwwi duuchchinna isixxe hujeni.<verse eid="PRO 16:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />Fuggoxxi huje moyaanjuwwa jibbissaaxxeni;</para>
  <para style="q2" vid="PRO 16:12">mootumma jabaatte hexxaaki qullummatiteni.<verse eid="PRO 16:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />Moyanjuwwi dhugaatike haaso'a'ni gammadaani;</para>
  <para style="q2" vid="PRO 16:13">dhugaa haso'aaka manjonna eeyyaani.<verse eid="PRO 16:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />Moyanji aare manjo shilchisaani;</para>
  <para style="q2" vid="PRO 16:14">muxxe manji kinni aare isixxa qiidisaani.<verse eid="PRO 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />Moyanjinki albi farri hiyyaa wodda hedho hexxeeni;</para>
  <para style="q2" vid="PRO 16:15">isinni elaanna,</para>
  <para style="q2" vid="PRO 16:15">mayetixxe yannake xeeninke duumanchishshaten.<verse eid="PRO 16:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />Worqe alfati irra beekkuma afate saxxaani;</para>
  <para style="q2" vid="PRO 16:16">birretika sibiljo alfa mannii'ni ege'na alfa woyya.<verse eid="PRO 16:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />Qajeeli mann fuggoke oranaa'n bayyate'ekeni;</para>
  <para style="q2" vid="PRO 16:17">me'injo ifika giissedhaki manji lubbo ifixxa heqqedheekeni.<verse eid="PRO 16:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />Holla ba'nete'ni geessissaani;</para>
  <para style="q2" vid="PRO 16:18">ifi dhadaake manji'a edisaachchi ibateni.<verse eid="PRO 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />Hollaameeyye saandemmalcho isenni welti qoodemma mannii'ni;</para>
  <para style="q2" vid="PRO 16:19">ifi heeshshi assine rakkiyyeti welti hedha woyyani.<verse eid="PRO 16:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />Gorsa laqaaki duroomaani;</para>
  <para style="q2" vid="PRO 16:20">Duuchchi Woddike Gootta'ni adde assedhaaki eebbisemeekeni.<verse eid="PRO 16:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />Muxxeeki manji qalbaameessake hiyyemaani;</para>
  <para style="q2" vid="PRO 16:21">gammachchisaaki hiyyichchuwwi ege'na barsiisaani.<verse eid="PRO 16:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />Qalbeeffachcho maallaqake assedheeke manji'a hedhotixxe muummeni;</para>
  <para style="q2" vid="PRO 16:22">gowwumma kinni oossoommataake manna'ni xixichcho geessissaani.<verse eid="PRO 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />Muxxe manjixxi sammo isi hiyyaaxxa barsiissani;</para>
  <para style="q2" vid="PRO 16:23">ege'nanna isi'a lebbaani.<verse eid="PRO 16:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />Eloki haaso'i malebinsha xe'maani;</para>
  <para style="q2" vid="PRO 16:24">manjokanna fayyisaani; miccoke'ninna aagaani.<verse eid="PRO 16:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />Manjoke'e eloke fakkaataaki ori hedheeni;</para>
  <para style="q2" vid="PRO 16:25">muuxamake'ni kinni ba'netibaa dhdhe me'aani.<verse eid="PRO 16:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />Hujallo barrate'ni itaaxxa ita halsa jabaate hujaashsha assita;</para>
  <para style="q2" vid="PRO 16:26">solo'ikinna jabaate hujaashsha assaani.<verse eid="PRO 16:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />Woyi fulabaaki manji fuggooxxe hedaani;</para>
  <para style="q2" vid="PRO 16:27">haaso'i isikinna bubbaaxxe giirashshateni.<verse eid="PRO 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />Fuggooki manji lola ke'issaani;</para>
  <para style="q2" vid="PRO 16:28">hamataaki manjinna addatemeeka jaaluwwa gargari hiissaani.<verse eid="PRO 16:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />Hunnati manjoke'n ke'aaki olla'a ifika sobe'e;</para>
  <para style="q2" vid="PRO 16:29">elobaake ora'ni akeekaani.<verse eid="PRO 16:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />Qiniffi hiyyaaki manji fuggoxxa hedeekeni;</para>
  <para style="q2" vid="PRO 16:30">suume ga'medhaaki manji fuggoxxa assani.<verse eid="PRO 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />Arree ulfinniinke kallachaani;</para>
  <para style="q2" vid="PRO 16:31">isenna afendaaki qullichcha manjo'niteni.<verse eid="PRO 16:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />Worbi manji irra ossaameessa manjo sa'aani;</para>
  <para style="q2" vid="PRO 16:32">heddo qachchuwwa lolle injifante abidati irra ifi heeshshi assa woyyani.<verse eid="PRO 16:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />Mann fedhi Duuchchi Woddike Goottiinxa ege'no'a hixa ibilsaani;</para>
  <para style="q2" vid="PRO 16:33">murte duuchcha muraaki Duuchchi Woddike Goottani.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />Lolema hexxee'na'a ita ha'wa wo'miteke mini mannii'n,</para>
  <para style="q2" vid="PRO 17:1">tima waasa nage'inke mine'n ita'n hedha woyyan.<verse eid="PRO 17:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />Muxxe erganji goottinke salphichcha belto'n gootta kada,</para>
  <para style="q2" vid="PRO 17:2">dayyo mittishshanna dayyuwwati dhaalatika qoobbo alfa.<verse eid="PRO 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />Worqetinna birretiki sibilji giirati hega uudemammashshanni,</para>
  <para style="q2" vid="PRO 17:3">Duuchchi Woddik Goottinna manjiinxa qalbe higa uudaan.<verse eid="PRO 17:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />Fuggichchi manji elobaake manjike haaso'a laqa,</para>
  <para style="q2" vid="PRO 17:4">dharichchikinna dhariinke haaso'a caqasa.<verse eid="PRO 17:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />Hiyyeeyyete'n gacifattootole insa'ne dadeeka Mageno yowwittetteshaten,</para>
  <para style="q2" vid="PRO 17:5">wele manjixxe rakko'n gammadaakinna xixemebaak gataba'a.<verse eid="PRO 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />Oosetixxi oose akka'watee kallachaken,</para>
  <para style="q2" vid="PRO 17:6">annikinna ama oosetee'e hirreti hirboora.<verse eid="PRO 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />Eloki haaso'i oossoommataake'e elabaan,</para>
  <para style="q2" vid="PRO 17:7">lame afo'iki galchalloke fa'i hitta elata!<verse eid="PRO 17:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />Matta uwwaake manji'a gojotike miyishaten,</para>
  <para style="q2" vid="PRO 17:8">isi mare geyeeba duuchcha yaane isi'a qajeelda.<verse eid="PRO 17:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />Balleessa laakko'abaak eeyyate nossa,</para>
  <para style="q2" vid="PRO 17:9">lebe ise'e haaso'aak kinni jaaluwwa ifinaa'n bayyissa.<verse eid="PRO 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />Oossoommataak manji dhibbale kutik ganeme barataa irra,</para>
  <para style="q2" vid="PRO 17:10">qalbeeffachcho afeek manji mitte xixichchinn barata.<verse eid="PRO 17:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />Fuggichchi manji manjoke'n hunnati ke'a calla halsa,</para>
  <para style="q2" vid="PRO 17:11">tennexxe'e godoba jabak erganj iso'n ergema.<note caller="+" style="f"><char style="fr" closed="false">17:11 </char><char style="ft" closed="false">Godoba jabak erganj iso'n ergema mitte mitte tika tennee'e reyo hitte'een. </char></note><verse eid="PRO 17:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />Oossoommatek hawwawwummatixxa huje hujaa'naa'ni futti hiyya mannii'ni,</para>
  <para style="q2" vid="PRO 17:12">beltanna ise hundii'n shiyendeeke meyyake qeedhanchinni futti hiyya woyya.<verse eid="PRO 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />Eloxxixxa bado fuggoxxa hiissaaka manjo,</para>
  <para style="q2" vid="PRO 17:13">fuggoxxi isike minenaa'n gophendaba'a.<verse eid="PRO 17:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />Lolemate'n geessissaaxxa yaane safaa,</para>
  <para style="q2" vid="PRO 17:14">kofemeeka wode'e qunxursatishshate, tennexxe lolake'n geessissaaxxa yaane safendeba edi darre yaane uurrisi.<verse eid="PRO 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />Qullichcha balleessanjoke asse'e balleessanjo kinni qullichchake asse mura</para>
  <para style="q2" vid="PRO 17:15">lamiinxi Duuchchi Woddika Gootta diqachchiissa.<verse eid="PRO 17:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />Afeeka maallaqa muxxumma alfatike ora'n hosisa gophammaxxee,</para>
  <para style="q2" vid="PRO 17:16">oossoommataake manjixxe anga'n hedheek maallaqi maa la'o afeta?<verse eid="PRO 17:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />Jaal jaalo ifika duuchchi wodda eeyya,</para>
  <para style="q2" vid="PRO 17:17">dayyikinna ifike dayyi'a rakkoti barike.<verse eid="PRO 17:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />Qalbeeffachcho afebaak manji liqa hiissisatixxee weli aage anga ganati,</para>
  <para style="q2" vid="PRO 17:18">annooma adhdhaan.<verse eid="PRO 17:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />Lola eyyaak cubbo eeyya,</para>
  <para style="q2" vid="PRO 17:19">hulatanna iima qeerrise ijaraak ba'ne ye'edha.<verse eid="PRO 17:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />Fuggichcha yaada afeeke manji'a eloxxi isi'a kaddaba'a,</para>
  <para style="q2" vid="PRO 17:20">dhuga'a haaso'abaakinna rakkote'n ibaan.<verse eid="PRO 17:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />Hawwawwa belto i'la yaaddo idaqqaten,</para>
  <para style="q2" vid="PRO 17:21">hawwawwichchiink anninna gammado afabaan.<verse eid="PRO 17:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />Gammadaaxxi qalbe eloke qorsan,</para>
  <para style="q2" vid="PRO 17:22">yaadik enqema kinni biso xo'a assite'e bassita.<verse eid="PRO 17:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />Fuggichchi manji dhuga dassatee,</para>
  <para style="q2" vid="PRO 17:23">sho'ik matta adhdha.<verse eid="PRO 17:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />Qalbeeffatak manji muxxummate'n ille ugga,</para>
  <para style="q2" vid="PRO 17:24">oossoommataake manjixxi ille kinni kumaba uudda.<verse eid="PRO 17:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />Hawwawwi belti annake'n yaaddote idaga,</para>
  <para style="q2" vid="PRO 17:25">ildeexxe ama'anna ciniintote.<verse eid="PRO 17:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />Qullichcha manjo mura woxaashsha assa,</para>
  <para style="q2" vid="PRO 17:26">yookaan qajeelumma insa'nexxe galchalluwwa jadhafa eloxxeba'a.<verse eid="PRO 17:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />Ege'na afeek manji haaso'a qusa'ne haaso'a,</para>
  <para style="q2" vid="PRO 17:27">qalbeeffachcho afeeke manjik yaadinna ititeeke.<verse eid="PRO 17:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />Oossoommataak manji midde sammi hiyyeele muxxeek labaan,</para>
  <para style="q2" vid="PRO 17:28">mitte haaso'anna bucuqqi hiyya gopheele qaroo manjo labaan.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 18:1" />Wele manninni welt gala eeyyabaak manji,</para>
  <para style="q2" vid="PRO 18:1">umo ifikixxa halcha calla hordofa,</para>
  <para style="q2" vid="PRO 18:1">toggichcha yaadanna midde moroma.<verse eid="PRO 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />Oossoommatak qalbeeffachcho welekenaa'n alfa iso'o goddisaba'a,</para>
  <para style="q2" vid="PRO 18:2">isi ifike yaada calla haaso'a eeyya.<verse eid="PRO 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />Fuggaalleessumma dagga wodda tuffatema dagga,</para>
  <para style="q2" vid="PRO 18:3">shookikki welti salphinni daga.<verse eid="PRO 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />Manjiinke afo'onaa'ni fulaak hiyyichchuwwi dhi'motike wode'e,</para>
  <para style="q2" vid="PRO 18:4">muxxummatixxi muummenna yaa'ammake wodi'ishshate.<verse eid="PRO 18:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />Fuggichcha manji'a gamisa,</para>
  <para style="q2" vid="PRO 18:5">qullichcha manjonna alfammaka seera hoyyedha eloxxebaan.<verse eid="PRO 18:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />Oossoommataake manjik hiyyichchi iso'ni lola ke'issa,</para>
  <para style="q2" vid="PRO 18:6">afo'i isikinna kuta iso'n idagaan.<verse eid="PRO 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />Oossoommatake manjik afo'i iso'ni ba'ne idaga,</para>
  <para style="q2" vid="PRO 18:7">haaso'i isikinna lubbo isinxee fonxoroten.<verse eid="PRO 18:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />Hamataake manjik haaso'i xe'maxxe itashshaten,</para>
  <para style="q2" vid="PRO 18:8">godob giddi'a luqqu'mi hyye e'ya.<verse eid="PRO 18:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />Huje ifixxa haba gatte hiyyabaak manji,</para>
  <para style="q2" vid="PRO 18:9">huje baxxaashsha assammakike dayyon.<verse eid="PRO 18:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />Duuchchi Woddike Goottik summi jabake golla,</para>
  <para style="q2" vid="PRO 18:10">qullichchikinna iso'n mare gollata.<verse eid="PRO 18:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />Dureeyyetixxi karra insa'ne'a kinjiinke qachchike dalla'an,</para>
  <para style="q2" vid="PRO 18:11">heduma insa'nek giddonna dademe da'memabaake qeerrake dalla'ishshate.<verse eid="PRO 18:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />Ibatixxi angafa ifidukate,</para>
  <para style="q2" vid="PRO 18:12">ulfaatatik umi kinni ifi heeshshi assate.<verse eid="PRO 18:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />Caqansebaang hiissichcho uwwaake,</para>
  <para style="q2" vid="PRO 18:13">manji'a gowwummatenna salphinneke.<verse eid="PRO 18:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />Elagonpheti wodda Kadannochchi hedhebaan hiyyaak yaadi anna kipha,</para>
  <para style="q2" vid="PRO 18:14">Anxa mooshshi hiyyaaka yaada kinni maachcho iso'o kipha?<verse eid="PRO 18:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />Qalbeeffachcho afeek manji ege'na alfa,</para>
  <para style="q2" vid="PRO 18:15">muxxe manjixxi manshanna ege'na dho'o hite laqqa.<verse eid="PRO 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />Uwwa uwwemmake manjichchi'a yaane qajeelchita,</para>
  <para style="q2" vid="PRO 18:16">lumolli manni edonna iso'o shiqaashsha assa.<verse eid="PRO 18:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />Murtetiba edise yaado ifika haaso'aak manji,</para>
  <para style="q2" vid="PRO 18:17">isoo moromammak dageexxi moronshatika qortuma iso'o qoraa qico'n isi calli dhugaatike kadeeshsha iso'n labba.<verse eid="PRO 18:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />Hixa ibisa moronsha gatissa,</para>
  <para style="q2" vid="PRO 18:18">lame mannixxa moronshanna uurrisaan.<verse eid="PRO 18:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />Balleessa iso'n gelteek dayyi kinjiinke dalla'i caala jabaken.</para>
  <para style="q2" vid="PRO 18:19">Lolikinna kinjiinke jabake cufanishshaten.<verse eid="PRO 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />Manji ifinge haaso'ixxe gumma godda,</para>
  <para style="q2" vid="PRO 18:20">haaso'emmaxxe yaane'ninna gammadaan.<verse eid="PRO 18:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />Afo'i hedho manjinxa fayyisiyyonna balleessa dande'a,</para>
  <para style="q2" vid="PRO 18:21">haaso'a eeyyaakinna haaso'eenge haaso'ika hira alfaan.<verse eid="PRO 18:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />Are aadheek eloxxe yaane alfe,</para>
  <para style="q2" vid="PRO 18:22">tinninna Duuchchi Woddik Gootti eloxxa isi'a asse hiyyote.<verse eid="PRO 18:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />Hiyyeessi shaqqunuteti sobata'ne'e haaso'aan,</para>
  <para style="q2" vid="PRO 18:23">dureesi kinni hollati hiissichcho uwwaan.<verse eid="PRO 18:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />Jaalo bira sa'issedhaa manji, ifi ba'nete'n geessisa.</para>
  <para style="q2" vid="PRO 18:24">Dhugaatik jaali kinni dayyo godobika sa'a.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />Lame afo'ike manji mannii'n, unshinaachcho afebaaka hiyyeessa woyyan.<verse eid="PRO 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />Ege'na belo assendaaxxi yaane la'o affeba'a,</para>
  <para style="q2" vid="PRO 19:2">wiinama birasa'anna dedhake'n ibissa.<verse eid="PRO 19:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />Manji gowwumma ifixxenni ba'ne ifi'n idaqqeexxi,</para>
  <para style="q2" vid="PRO 19:3">Duuchchi Woddike Gootta'n aaraan.<verse eid="PRO 19:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />Karra heddo jaaluwwa ilda, hiyyeessa kinni ising fir isonaa'n bayyata.<verse eid="PRO 19:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />Dharik dhugaa kulaak xixemebaak gataba'a,</para>
  <para style="q2" vid="PRO 19:5">dhara haaso'aakinna xixenshatenaa'n fulaba'a.<verse eid="PRO 19:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />Heddi manji galchallokenaa'n elle alfo'a hassaan,</para>
  <para style="q2" vid="PRO 19:6">uwwa uwwaake manjinni welti duuchching jaaloke.<verse eid="PRO 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />Hiyyeessa manjo godobing dayyuwwi isoo'o jibbaan,</para>
  <para style="q2" vid="PRO 19:7">jaaluwwi iskifa'i caala isonaa'n bayyata;</para>
  <para style="q2" vid="PRO 19:7">fedhee qiconna safata'n insa'ne hordofoolenna midde insa'ne alfabaan.<verse eid="PRO 19:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />Muxxumma eeyyaak hedho ifixxa eeyyaa,</para>
  <para style="q2" vid="PRO 19:8">qalbeeffachchotanna jabaate halsaake isi'a qajeeldaan.<verse eid="PRO 19:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />Dharik dhugaa kulaak xixemebaak gataba'a,</para>
  <para style="q2" vid="PRO 19:9">dhara haaso'aake'ninna ba'ne daga.<verse eid="PRO 19:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />Oossoommataak xoo'mamik hedha hasissabaan,</para>
  <para style="q2" vid="PRO 19:10">garbi ja'laabiinke galchallo kadoole fa'i hittata fuggoxxe!<verse eid="PRO 19:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />Muxxumma manjo ossalloke assitaan,</para>
  <para style="q2" vid="PRO 19:11">balleessa tuffate waaliyyotinna isi'a ulfaataten.<verse eid="PRO 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />Moyanjiinxi mufata neenqinxe harqashsha sodaachchissa,</para>
  <para style="q2" vid="PRO 19:12">isonaa'n elle alfanna badda'a haanjisammaxxe kiifoshaten.<verse eid="PRO 19:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />Hawwawwi belti annake'n ba'ne idaga,</para>
  <para style="q2" vid="PRO 19:13">dha'a hitaaxxi arenna aro'okee uurrabelo cophphi cophphi hiyya'n xissammake xissishshaten.<verse eid="PRO 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />Minikinna karra hadokee'n dhaalaachcho,</para>
  <para style="q2" vid="PRO 19:14">qalbeeffachcho afeexxa are kinni uwwaak Duuchchi Woddike Goottan.<verse eid="PRO 19:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />Booso'umma cokokki assite diipho idagga,</para>
  <para style="q2" vid="PRO 19:15">hujabaak manjinna solo'wa.<verse eid="PRO 19:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />Ajaja heqqedhaak hedho ifixxe heqqedha,</para>
  <para style="q2" vid="PRO 19:16">Mageninka hiyyichcho tuffataak kinni ba'a.<verse eid="PRO 19:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />Hiyyeeyyetee uwwaak Duuchchi Woddike Gootti'a liqeessaan,</para>
  <para style="q2" vid="PRO 19:17">Duuchchi Woddik Goottinna asseexxe huje'a hira isi'a uwwa.<verse eid="PRO 19:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />Higaaxxi yanna hexxee'na belto atika oossuummande'n xixi, reyo'anna sammi hite waaldoxxe'e.<verse eid="PRO 19:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />Hifatichchi manji xixema hasissa,</para>
  <para style="q2" vid="PRO 19:19">mittele waalde saxxotole wele woddanna walde sa'a atixxi gattaba'a.<verse eid="PRO 19:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />Gorsa laqi, akeettetanna adhdhi,</para>
  <para style="q2" vid="PRO 19:20">udumi uduma muxxete kaddatton.<verse eid="PRO 19:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />Manjiinxe sammo'n heddo yaada hedheen, muuxemaaki kinni Duuchchi Woddike Goottike yaadon.<verse eid="PRO 19:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />Manji halchaachchi jabaxxe jaalalan.</para>
  <para style="q2" vid="PRO 19:22">Dharichchake kadiyyoti mannii'ni hiyyeessa kada woyya.<verse eid="PRO 19:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />Duuchchi Woddika Gootta sodaata hedhotiba'a geessissa,</para>
  <para style="q2" vid="PRO 19:23">sodaataaki manjinna ti'ni hiyye ofo'laan,</para>
  <para style="q2" vid="PRO 19:23">rakkotinna iso'o geltaba'a.<verse eid="PRO 19:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />Boose'i manji qore giddo uggeexxa anga,</para>
  <para style="q2" vid="PRO 19:24">qore giddii'n adhdha midde iso'n a'urtaan.<verse eid="PRO 19:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />Gacifataaka gandotole,</para>
  <para style="q2" vid="PRO 19:25">oossoomataak qalbeeffachcho barataan,</para>
  <para style="q2" vid="PRO 19:25">qalbeffataaka xixi, ege'natanna alfaan.<verse eid="PRO 19:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />Anna mulqedhaak, amatanna shoraak,</para>
  <para style="q2" vid="PRO 19:26">shookokanna salphine idagaake belton.<verse eid="PRO 19:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />Anke belto gorsa caqasa waaldottole,</para>
  <para style="q2" vid="PRO 19:27">egendeettexxa barachchonna midde deetatton.<verse eid="PRO 19:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />Dharik dhugaa'a kulak seerake'n gacifata,</para>
  <para style="q2" vid="PRO 19:28">fuggaalleessi manninna balleesa itatishsha xe'mifataan.<verse eid="PRO 19:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />Gacifataakeri'a murte,</para>
  <para style="q2" vid="PRO 19:29">oossoomataake'e kutti qixxeesseme'e.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 20:1" />Woyinetixxi booka manjo gacifataake, jabaxxi ha'wanna manjo lolinke assita;</para>
  <para style="q2" vid="PRO 20:1">konneechchinni ifi dedheeki duuchchi muxxallokebaan.<verse eid="PRO 20:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />Moyanjiinxi mufe neenqiinxe ittanashshaten,</para>
  <para style="q2" vid="PRO 20:2">iso'o mufachchiisak manji reya.<verse eid="PRO 20:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />Lolakenaa'n baaja manjoke'e ulfinnake,</para>
  <para style="q2" vid="PRO 20:3">yaadik oossoommateek duuchchi kinni lolake'e muddama.<verse eid="PRO 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />Da'labi manji yannate'n huccaba'a,</para>
  <para style="q2" vid="PRO 20:4">tennexxee aassatike agenjo'ni midha halsa;</para>
  <para style="q2" vid="PRO 20:4">mittelchonna alfabaan.<verse eid="PRO 20:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />Manjiinxe qalbeki hedumi dhi'mo giddo hedheeke wodi'ishshate,</para>
  <para style="q2" vid="PRO 20:5">kaddo malee'e qalbeeffataaki manji kinni ookko'ni ikki'laan.<verse eid="PRO 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />Heddi manji wele eeyya'neeshsha ifi asse'e haaso'a,</para>
  <para style="q2" vid="PRO 20:6">dhugaati addatemaaka manjo kinni ayyete alfa dande'a?<verse eid="PRO 20:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />Qullichchi ci'mendabaaxxe hedho hedhaa,</para>
  <para style="q2" vid="PRO 20:7">isi uduma iso'o hordoffaaxxi isixxi oose eebbisendeexxe.<verse eid="PRO 20:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />Moyanji murte uwwo'a mootete'ni ofo'laa wodda,</para>
  <para style="q2" vid="PRO 20:8">fuggoxxa yaane duuchcha uude gargar asse ege'naa.<verse eid="PRO 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />Isinni, «Qalbe anxa ca'unteti heqqedheennen,</para>
  <para style="q2" vid="PRO 20:9">ani ca'ichaken; cubbo afeebe'non» hiyyaakis ayyete?<verse eid="PRO 20:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />Lame weli qixxe kaddeebaaxxa mikenna moortaaxxa kiilo,</para>
  <para style="q2" vid="PRO 20:10">tenne lamiinxa Duuchchi Woddik Gootti diqata.<verse eid="PRO 20:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />Anno midde adaba ca'itetenna qajeeltote kaddeexxa aasitaaxxe yaanenaa'ninni ege'nendaan.<verse eid="PRO 20:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />Mansha laqqo'a ille uudo'a,</para>
  <para style="q2" vid="PRO 20:12">lamiinxa Duuchchi Woddike Gootta dade'eeni.<verse eid="PRO 20:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />Diipho eettoxxe'e hiyyoondatton,</para>
  <para style="q2" vid="PRO 20:13">kexxe hujjottole kinni gelte gatteexxa ita alftatto.<verse eid="PRO 20:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />Miya hidhdhaak,</para>
  <para style="q2" vid="PRO 20:14">«Kunni kadaakebaan» hiyya'n hira buti'a abida,</para>
  <para style="q2" vid="PRO 20:14">higaa wodda kinni hire qico ifi'a saada.<verse eid="PRO 20:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />Worqetinna hexxe,</para>
  <para style="q2" vid="PRO 20:15">fiixeek kinjuwwinna wo'meechcho,</para>
  <para style="q2" vid="PRO 20:15">ege'nat haaso'aaki afo'i kinni worqe yookaan fiixeeke kinjuwwi caala fiixake.<verse eid="PRO 20:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />Alagi manjike liqi'aa annooma adhdheeke manjiixa seemma adhdhi,</para>
  <para style="q2" vid="PRO 20:16">ookkone alagi manjichchixxa eettene seemma abixxi.<verse eid="PRO 20:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />Manjo sonbe'e indaaxxi yaane xe'mita,</para>
  <para style="q2" vid="PRO 20:17">udu'mitaaxxi kinni afo'i giddo kinjo kadda.<verse eid="PRO 20:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />Gorsa laqeexxe'e affeteke yaadi'a hujeti ora fulchi,</para>
  <para style="q2" vid="PRO 20:18">lolakeena fuldaattole akkeette adhdhi.<verse eid="PRO 20:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />Hamataak manji maqo haaso'a gadho fulcha,</para>
  <para style="q2" vid="PRO 20:19">tennexxe'e afoollichcha manjonaa'n bayyati.<verse eid="PRO 20:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />Anna yookaan ama ifixxa yowwaak belti,</para>
  <para style="q2" vid="PRO 20:20">lubbo isixxi dimma dukkana'ni ba'ammake ifishsha baxxaan.<verse eid="PRO 20:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />Elobelo alfendaaxxi karra, muuxami iseki ebbisemabaan.<verse eid="PRO 20:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />«Ane'ni gelteexxe balleessa'a halo fulebe'noki!» hitoxxe'e,</para>
  <para style="q2" vid="PRO 20:22">Duuchchi Woddika Gootta heqqedhi;</para>
  <para style="q2" vid="PRO 20:22">isi ate'e gargaaraan.<verse eid="PRO 20:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />Lame weliqixxe kaddebaaxxa mikenna moortaaxxa kiilo Duuchchi Woddik Gootti diqataan.<verse eid="PRO 20:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />Manjiinxe hedho'ni kaddaaxxa duuchcha Duuchchi Woddik Gootti mura,</para>
  <para style="q2" vid="PRO 20:24">hittatta manji ifixxe hedho'ni kaddaaxxa ege'na?<verse eid="PRO 20:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />Uduma unsha hinaboxxoshsha Duuchchi Woddike Gootti'a werreega werreegebexxong edi darre xexxe'achchoti hedi,<verse eid="PRO 20:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />Muxxalli moyaji ayyiir fuggo hujemmaxxa gargar assee ege'na, mitte mararte belo insa'ne'e xixa.<verse eid="PRO 20:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />Manjiinxi sammo Duuchchi Woddike Goottike xassa,</para>
  <para style="q2" vid="PRO 20:27">isenna godobika manjiinka yaadanna qotte affaan.<verse eid="PRO 20:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />Jaalalatinna addatensha moyanjo galchita,</para>
  <para style="q2" vid="PRO 20:28">jaalalati moote isixxinna ti'ni hite hexxaan.<verse eid="PRO 20:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />Dargageeyyetee'e gaachchanni uduuda ifiken,</para>
  <para style="q2" vid="PRO 20:29">geedhetiki ulfinni kinni arre insa'nexxe.<verse eid="PRO 20:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />Miittaaxxi siqqo manji giddii'ni fuggoxxa fulchitaan, ganetinna manjiinxa giddixxa hedho ca'a assitaan.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 21:1" />Moyanji Duuchchi Woddike Goottixxe anga'ni hedheen;</para>
  <para style="q2" vid="PRO 21:1">isinna dareerake'n yaa'ammake wode'ishsha iso'o eeyyeba'a hiissedhaan.<verse eid="PRO 21:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />Manji assa'neexxi duuchcha eloxxe iso'ni labbaan;</para>
  <para style="q2" vid="PRO 21:2">Duuchchi Woddik Gootti kinn godoba uudan.<verse eid="PRO 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />Tolcha uwwati irra qullummatanna dhugaatixxa murte assa;</para>
  <para style="q2" vid="PRO 21:3">Duuchchi Woddika Gootta gammachchiisan.<verse eid="PRO 21:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />Hollanna kijiba fuggaalleyye mannike adaban;</para>
  <para style="q2" vid="PRO 21:4">tinninna cubboten.<verse eid="PRO 21:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />Yaadik jabaate salaliki hujeeki hegeri'a geye gataachocho alfaan;</para>
  <para style="q2" vid="PRO 21:5">wiinamik hujak hiyyoome gataan.<verse eid="PRO 21:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />Dhara dhugaate assat alfinaaxxi karra,</para>
  <para style="q2" vid="PRO 21:6">guulde saxxammaxxe diidalloshshanna shiltammaxxe fonxoroshshaten.<verse eid="PRO 21:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />Fuggaalleeyye eloxxa yaane assa gibbammaxxe'e</para>
  <para style="q2" vid="PRO 21:7">manjoke'n hunnati ke'a insa'nexxi insa'ne filte balleessita.<verse eid="PRO 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />Cubbaalleeyye daban calla eetan;</para>
  <para style="q2" vid="PRO 21:8">qajeel manjik adab kinn toggichchaken.<verse eid="PRO 21:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />Afoollitte arenni welti mitte mine'ni hedhati irra</para>
  <para style="q2" vid="PRO 21:9">miiinxe heelichchoke irga'n hedha woyyan.<verse eid="PRO 21:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />Fuggok manji xaqaro assate eeyyan;</para>
  <para style="q2" vid="PRO 21:10">ayyeenna mararabaan.<verse eid="PRO 21:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />Gacifataak manji ganemaa wodda,</para>
  <para style="q2" vid="PRO 21:11">weli ege'na afebaak manji muxxete kadaan;</para>
  <para style="q2" vid="PRO 21:11">qarchi manji barattoole ege'na alfa.<verse eid="PRO 21:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />Qullichchi fuggaalleeyyetika mine hubate uudaan;</para>
  <para style="q2" vid="PRO 21:12">daba hujammakara balleessa.<verse eid="PRO 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />Hiyyeessiinxa raare laqa gibeek mansha abixxoole;</para>
  <para style="q2" vid="PRO 21:13">isinna raaraa wodda reebaaka alfaba.<verse eid="PRO 21:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />Sho'ik uuneexxi uwwa mufe waalchissaan;</para>
  <para style="q2" vid="PRO 21:14">udumii'n uunaak mattinna jabaxxa aare sammi assaan.<verse eid="PRO 21:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />Dhugaatixxa murte muraa wodda,</para>
  <para style="q2" vid="PRO 21:15">qulliyye gammaddaan;</para>
  <para style="q2" vid="PRO 21:15">fuggoxxa hujammaki kinn raanka.<verse eid="PRO 21:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />Qalbeeffata gophe gugguffataake manjik</para>
  <para style="q2" vid="PRO 21:16">muuxam reyote.<verse eid="PRO 21:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />Xoo'mamik hedha hasaak hiyyooman;</para>
  <para style="q2" vid="PRO 21:17">woyinetixxa bookanna ha'yo eeyyaak haranga duromaba'a.<verse eid="PRO 21:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />Fichchi manji qulliyetee,</para>
  <para style="q2" vid="PRO 21:18">amana afebaak qajeela mannixxa bakka xixema.<verse eid="PRO 21:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />Afoolittenna aarrameete arenni welti hedhati mannii'n</para>
  <para style="q2" vid="PRO 21:19">qiila gammoojje'n hedha woyyan.<verse eid="PRO 21:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />Qarichchi manjike mine'n elolla itanna buur camemee hedhaan;</para>
  <para style="q2" vid="PRO 21:20">gowwi manni afebaak kinn afeenga faangesse biraan.<verse eid="PRO 21:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />Qullummatanna jaalala hordofaak,</para>
  <para style="q2" vid="PRO 21:21">hedho, durummatanna ulfinna alfaan.<verse eid="PRO 21:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />Qaroontichchi hunnameyyetike qachchika dalla'a enqe e'yaan,</para>
  <para style="q2" vid="PRO 21:22">insa'ne addantemmaxxa kolluwwa diigaan.<verse eid="PRO 21:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />Afo'okanna laagada ifika heqqedhaak;</para>
  <para style="q2" vid="PRO 21:23">daggaaxxe balana'ni ifi gatilsaan.<verse eid="PRO 21:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />Hollaammessinna kijiballi manji, «Hawwawwake» hiyyemman;</para>
  <para style="q2" vid="PRO 21:24">adabi isik duuchchi hollati barqaaqeken.<verse eid="PRO 21:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />Boose'i manji huje hiiqammabaaxxee,</para>
  <para style="q2" vid="PRO 21:25">gaabe iso shilta.<verse eid="PRO 21:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />Kunni manji duuchchi wodda yoraaxxi heddo yaane alfateeten;</para>
  <para style="q2" vid="PRO 21:26">qajeel manji kinn ani'a gatuun hiyyabaan.<verse eid="PRO 21:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />Jallichchi manjik tolchi</para>
  <para style="q2" vid="PRO 21:27">Duuchchi Woddika Gootta gammachchiisabaan;</para>
  <para style="q2" vid="PRO 21:27">elobaake yaadinni shiqishaa wodda fa'i caala diqachchiisa!<verse eid="PRO 21:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />Dhara dhugaa kulaak ba'aan;</para>
  <para style="q2" vid="PRO 21:28">dhugaa haaso'aak kinn galaan.<verse eid="PRO 21:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />Fuggichchi manji elobaaxxenni manjoke'n ille fulcha;</para>
  <para style="q2" vid="PRO 21:29">qajeel manji kinni hujaachcho xexxe'ate huja.<verse eid="PRO 21:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />Manji ifike beekkumin, qalbeeffachchotinna hedinot;</para>
  <para style="q2" vid="PRO 21:30">Duuchchi Woddika Gootta ifinaa'n hoyyedha dande'abaan.<verse eid="PRO 21:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />Fadhachchi lolake'e qophpheesema;</para>
  <para style="q2" vid="PRO 21:31">injifachcho kinni Duuchchi Woddike Goottinaa'nite.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 22:1" />Eloki summi lumoxxe karra caalan:</para>
  <para style="q2" vid="PRO 22:1">ulfaatatinna sibiljo birrena'ninna worqenaa'ni saxxaan.<verse eid="PRO 22:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />Duuchchi Woddiki Gootti duuchchingike dadallo kadeemmaxxe'e</para>
  <para style="q2" vid="PRO 22:2">dureessikinna hiyyeessi lamiing weli qixxeten.<verse eid="PRO 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />Qaroontichchi manji elobaachcho uudoole sho'omaan:</para>
  <para style="q2" vid="PRO 22:3">qalbeeffatabaak kinn eetteneninni guule me'aani: miidhemaani.<verse eid="PRO 22:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />Arja kadanna Duuchchi Woddika Gootta sodaata: durumma,</para>
  <para style="q2" vid="PRO 22:4">lumminnekanna hedho alfissaan.<verse eid="PRO 22:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />Fuggaalleeyye me'ita'neeke ora'ni utenna fonxoro hexxeen:</para>
  <para style="q2" vid="PRO 22:5">lubbo ifixxa heqqedhaak kinn konneechchonaa'ni baajan.<verse eid="PRO 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />Belto atika me'iyyo hasissaaka ora duuchcha iso'o baraachissi:</para>
  <para style="q2" vid="PRO 22:6">hedheeke baro duuchcha'ni isoo'o hordofa'ni hedhaan.<verse eid="PRO 22:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />Hiyyeessi dureessinke erganjon:</para>
  <para style="q2" vid="PRO 22:7">maallaqa liqeeffataak liqeessammake garbaken.<verse eid="PRO 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />Fuggoxxa hujaak rakkote haa'maan:</para>
  <para style="q2" vid="PRO 22:8">Mageniinxi mufenna isoo'o balleessitaan.<verse eid="PRO 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />Arji manji umo ifingee eebbisemaan:</para>
  <para style="q2" vid="PRO 22:9">itatanna hiyyeeyyeti welti qoodemaan.<verse eid="PRO 22:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />Gacifatammaka fulchitottole:</para>
  <para style="q2" vid="PRO 22:10">lolikinna yowwichchi hedhabaan.<verse eid="PRO 22:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />Ca'axxa qalbe afeeka manjo eeyyakinna haaso'a ege'neeki:</para>
  <para style="q2" vid="PRO 22:11">moyanji edo isi eeyyeme'eken.<verse eid="PRO 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />Duuchchi Woddike Goottixxi ille ege'na heqqexxaani:</para>
  <para style="q2" vid="PRO 22:12">addatemabaake mannika hiyyichcho kinni isi toliinke assaan.<verse eid="PRO 22:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />Boose'i «Neenqi gadho hedhe:</para>
  <para style="q2" vid="PRO 22:13">orake'ni shiyaan» hiyya'neen.<verse eid="PRO 22:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />Yabaabulto manjichchoki afo'i dhi'mo balen:</para>
  <para style="q2" vid="PRO 22:14">Duuchchi Woddik Gootti mufateeki manji ookko'o ibaan.<verse eid="PRO 22:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />Oose hundaayyet haakito affe'en:</para>
  <para style="q2" vid="PRO 22:15">kutinxi gane kinn insa'ne'e hiissitaan.<verse eid="PRO 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />Karra ca'maak hiyyeessa miicak, dureesake'e uwwa shiqilshaak;</para>
  <para style="q2" vid="PRO 22:16">lamiing hiyyoomaan.<verse eid="PRO 22:16" /></para>
  <para style="s1">Muxxeeke Mannika Gorsa</para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />Muxxetika hiyyichcho dho'o hite caqas:</para>
  <para style="q2" vid="PRO 22:17">qalbe atixxanna anxe barachchoba'a hiisedhi.<verse eid="PRO 22:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />Insa'ne'e godoba atike'n qaabbattottolenna heqqexxottole</para>
  <para style="q2" vid="PRO 22:18">insa'ne duuchchiing gammanda.<verse eid="PRO 22:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />Tennexxe'e adde atixxi Duuchchi Woddike Gootta'n kaddaasha,</para>
  <para style="q2" vid="PRO 22:19">telcho ani atee'e umo angeninni barachchiisaannen.<verse eid="PRO 22:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />Gorsatikenna ege'natika konne hiyyichcho</para>
  <para style="q2" vid="PRO 22:20">eloxxa barachchuuwwa ati'a borreesseenabaa?<verse eid="PRO 22:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />Ate'e ergekee hasissaaxxa hiissa uutattoshsha,</para>
  <para style="q2" vid="PRO 22:21">dhugaatixxanna addatemeeka hiyyichchuwwa atee'e barachciisannoshshatebaa?<verse eid="PRO 22:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />Mittelchcho afebaaka hunnati idagi hitoxxe'e:</para>
  <para style="q2" vid="PRO 22:22">hiyyeesake kadeemmaxxe'e: rakkichchakanna weldeennate'ni daassitoxxe'e.<verse eid="PRO 22:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />Duuchchi Woddik Gootti insa'nexxa murte muraan,</para>
  <para style="q2" vid="PRO 22:23">insa'nenaa'ni mulqeemmakara mulqaan.<verse eid="PRO 22:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />Hifatichchi manjinni welti jaalondoxxe'e;</para>
  <para style="q2" vid="PRO 22:24">hollaantichchik welti gudditoxxe'e.<verse eid="PRO 22:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />Adaba isika barattottole:</para>
  <para style="q2" vid="PRO 22:25">ifinni ifi sagadhitatton.<verse eid="PRO 22:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />Annoondetteke hiyyichcho'ni weli aagge anga gandoxxe'e:</para>
  <para style="q2" vid="PRO 22:26">liqakee'e annoondoxxe'e.<verse eid="PRO 22:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />Dandeette hiissa gophphottole</para>
  <para style="q2" vid="PRO 22:27">diiphattaxxi taqe ati hundii'ni adhendaan.<verse eid="PRO 22:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />Edik atiki annuwwi uggeemmaka,</para>
  <para style="q2" vid="PRO 22:28">gabalatika kakkichcho goshshoxxe'e.<verse eid="PRO 22:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />Huja'neexxe hujexxa oge afeeka manjo uudi;</para>
  <para style="q2" vid="PRO 22:29">isi moyanjuwwi edo ergatema malee'e afeenge manni'a ergatemabaan.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 23:1" />Moyanjik welt qore mitte'n ittotta'a shiqqatto wodda,</para>
  <para style="q2" vid="PRO 23:1">ayyinni ittaattexxa qaabbati.<verse eid="PRO 23:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />Solo'witottole midde:</para>
  <para style="q2" vid="PRO 23:2">haafenda'ni ittabexxoshsha ifi heqqedhi.<verse eid="PRO 23:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />Dedha ate'e hega uudaaxxe hexxeeni</para>
  <para style="q2" vid="PRO 23:3">shiqqaaxxa eloxxa ita haafende ittoxxe'e.<verse eid="PRO 23:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />Duroomatate'e ifi kurbu assitabexoshsha</para>
  <para style="q2" vid="PRO 23:4">muxxummati ifi heqqedhi.<verse eid="PRO 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />Durumate'ni ifi uwweexxottole;</para>
  <para style="q2" vid="PRO 23:5">keela fulche'e iimate'ni me'ammake sinbirishsha,</para>
  <para style="q2" vid="PRO 23:5">uuddaa'nanni haba copheexxa gophphatton.<verse eid="PRO 23:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />Donni manjixxa ita ittoxxe'e;</para>
  <para style="q2" vid="PRO 23:6">xe'maxxi ita majajjoqqe'e:<verse eid="PRO 23:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />Ita tanna godobi mittinite kaddebaang</para>
  <para style="q2" vid="PRO 23:7">lame godobinni hedheexxi sobe akkisa'ni,</para>
  <para style="q2" vid="PRO 23:7">«Iti, ha'wi» hiyyaan.<verse eid="PRO 23:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />Itteettaxxa shiixxoxxa ita midde honqootatton,</para>
  <para style="q2" vid="PRO 23:8">geeqqishaani haasottettaxxi hiyyanna tola boddichcha gattaan.<verse eid="PRO 23:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />Gowwik haasottoxxe,</para>
  <para style="q2" vid="PRO 23:9">haaso'a atika qe'yiin xure geessisabaan.<verse eid="PRO 23:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />Gabalate'n hedheeka hundaayyet beessisa mee kisi;</para>
  <para style="q2" vid="PRO 23:10">anna affebaaxxe ooseka boganna ku'lite adhitoxxe.<verse eid="PRO 23:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />Anjiralli insa'nek jabaken,</para>
  <para style="q2" vid="PRO 23:11">isi atininn welt murte insa'ne'a uwwaan.<verse eid="PRO 23:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />Hedino atixxa borachchotiba'a,</para>
  <para style="q2" vid="PRO 23:12">manshatanna ege'na uwwake hiyyichchiba'a hiissedhi.<verse eid="PRO 23:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />Belto xixichcho waaldoxxe;</para>
  <para style="q2" vid="PRO 23:13">kutik gandeetexxe'e reyabaan.<verse eid="PRO 23:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />Matanga kutik abidde kulchiissottole;</para>
  <para style="q2" vid="PRO 23:14">lubbo isixxa reyotenaa'n woddete hiyyoten.<verse eid="PRO 23:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />Koo anke belto, beekkuma horattottole,</para>
  <para style="q2" vid="PRO 23:15">qalbe anixxinna yo'oshsha gammadaan.<verse eid="PRO 23:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />Suume atixxi toggichcha haaso'a hoosotolenna,</para>
  <para style="q2" vid="PRO 23:16">giddixxi hedho anxi duuchcha gammadik nigaa muddeen.<verse eid="PRO 23:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />Qalbe atixxi fuggoxxa hujaaka manna yortoqqe,</para>
  <para style="q2" vid="PRO 23:17">yaane kinn duuchchi wodda Duuchchi Woddika Gootta sodaati.<verse eid="PRO 23:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />Tenne assitottole hegerik galdumi atiki qajeeldeeke kaddaan,</para>
  <para style="q2" vid="PRO 23:18">halcha atixxinna tola gattabaan.<verse eid="PRO 23:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />Koo anke belto caqas; beekuma horat,</para>
  <para style="q2" vid="PRO 23:19">qalbe atixxinna qajeela oranaa'ni ittanna mishikki hitoqqe.<verse eid="PRO 23:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />Woyinetixxa booka fakkanshe ha'waakerinninna itatee'e</para>
  <para style="q2" vid="PRO 23:20">haafemaake manninni welti guddittoxxe.<verse eid="PRO 23:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />Machcho'aluwwinna harbaqeessi hiyyoomaan;</para>
  <para style="q2" vid="PRO 23:21">bira sa'aaki mugi bibbixendeexxa seemma oddeessaan.<verse eid="PRO 23:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />Ate'e i'leeka anna caqas,</para>
  <para style="q2" vid="PRO 23:22">ama atixxi cindoole cee'mitoxxe.<verse eid="PRO 23:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />Dhugaa, beekkuma, xixichchokanna ege'na,</para>
  <para style="q2" vid="PRO 23:23">maallaqa ifike assexxe abixxi.<verse eid="PRO 23:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />Qajeel beltik anni yo'oshsha gammadaan;</para>
  <para style="q2" vid="PRO 23:24">beeka belto i'leekinna kijibaan.<verse eid="PRO 23:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />Anni atikinna ama atixxi gammanduun;</para>
  <para style="q2" vid="PRO 23:25">ate'e ildeexxi amanna ililissowwaal.<verse eid="PRO 23:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />Koo anke belto godoba atika ani'a uwwi;</para>
  <para style="q2" vid="PRO 23:26">ille atixxinna ora ankenaa'n mishikk hitoqqe.<verse eid="PRO 23:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />Afoollitte are cu'maxxe baleshshaten,</para>
  <para style="q2" vid="PRO 23:27">yabaabulto manjichchonna dhi'mo caffa'an.<verse eid="PRO 23:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />Moodhalshetishsha gaaddaan,</para>
  <para style="q2" vid="PRO 23:28">mulqammakara manjiinxe oddo'ni fakkanshitaan.<verse eid="PRO 23:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />Hunbaashsha yaado ayyixxeete?</para>
  <para style="q2" vid="PRO 23:29">Lolinna weli hiisensha ayyixxeette?</para>
  <para style="q2" vid="PRO 23:29">Tola boddichcha mado'a ayyixxeete? Ille diimisa ayyi'aate?<verse eid="PRO 23:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />Tinni duuchcha gelta'nek woyinetixxa booka ha'watinna futti hineenga jabaka ha'wo ha'watinna yanna huje belo sa'issammake mannanaa'niten.<verse eid="PRO 23:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />Birillete'n diimatte</para>
  <para style="q2" vid="PRO 23:31">cala cala hiyya'ni,</para>
  <para style="q2" vid="PRO 23:31">xe'ma'ne godobi'a sa'aani, woyinetixxe bookaba'a uudde sobendoxxe.<verse eid="PRO 23:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />Uduma dhudhdhuufiinsha iddaan;</para>
  <para style="q2" vid="PRO 23:32">buutetishshanna hafuurakanna woraan.<verse eid="PRO 23:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />Ille atixxi haaroxa yaane mee uuddowwaal;</para>
  <para style="q2" vid="PRO 23:33">toggi hite haaso'aakanna heda dandeettabexxon.<verse eid="PRO 23:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />Atinna abbaayyate'n diiphpheetteshshanna;</para>
  <para style="q2" vid="PRO 23:34">hobolotike oddotike utuphpha'n irkattettelchcho labbaan.<verse eid="PRO 23:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />Atinna «Anee'e ganneen, yaane kinn miidhemebo'non,</para>
  <para style="q2" vid="PRO 23:35">uxxineen ane'n maachchonna labbebaan;</para>
  <para style="q1" vid="PRO 23:35">Eega haanota dammaqaanne?» hitatton.<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 24:1" />Fuggaalleeyye manna gaabbitoxxe'e;</para>
  <para style="q2" vid="PRO 24:1">insa'nenn jaaloomate'e gudditoxxe,<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />Godobi insa'nek xaqarote heda'nen;</para>
  <para style="q2" vid="PRO 24:2">shokko haaso'aan.<verse eid="PRO 24:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />Mine beekkumik ijaaraan;</para>
  <para style="q2" vid="PRO 24:3">ege'nat le'ma belo jabaate hedhaan.<verse eid="PRO 24:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />Beekkumiki he'noole mini elollanna</para>
  <para style="q2" vid="PRO 24:4">fiixa miyuwwinni wo'maan.<verse eid="PRO 24:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />Beeki manji jabaxxa hunna afeen;</para>
  <para style="q2" vid="PRO 24:5">ege'na afeek manji jabeenna itti lephpha'ni me'aan.<verse eid="PRO 24:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />Lola ibate'e gorsa eloka</para>
  <para style="q2" vid="PRO 24:6">injifachchotenna heddi gorsalluwwi hasisaan.<verse eid="PRO 24:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />Ege'na afebaak manji beekkuma horata dande'abaan;</para>
  <para style="q2" vid="PRO 24:7">qachchiinxe hulaxxe baxxe'n haaso'e dande'abaan.<verse eid="PRO 24:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />Shokkot yaane qotaak,</para>
  <para style="q2" vid="PRO 24:8">«Xaqartichcha» hine ye'naan.<verse eid="PRO 24:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />Gowwi duuchchi wodda cubbo hujate eeyyan;</para>
  <para style="q2" vid="PRO 24:9">roorraka manjo manni jibbaan.<verse eid="PRO 24:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />Rakko ate'n gelta wodda hooda yo'oxxa affoottole;</para>
  <para style="q2" vid="PRO 24:10">jabeenn atik goofake hiyyoten.<verse eid="PRO 24:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />Reyotiba me'aakara gatisi;</para>
  <para style="q2" vid="PRO 24:11">shiyate'e weli abixxe ma'amakara hiiss.<verse eid="PRO 24:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />Atinna, «Tenne yaane ege'neennengechchi hedhebaan» hitottole,</para>
  <para style="q2" vid="PRO 24:12">godobixxa file findige ege'naak isi qaabbatabaa?;</para>
  <para style="q2" vid="PRO 24:12">Lubbo atixxa heqqa'nek isi haake'e?</para>
  <para style="q2" vid="PRO 24:12">Isi mitte mittenge'e huje isixxishshanni hira uwwabaa?<verse eid="PRO 24:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />Koo anke belto malebi eloochchon iti;</para>
  <para style="q2" vid="PRO 24:13">la'etinna yo'oshsha xe'me calliichon.<verse eid="PRO 24:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />Beekumikinna lubbote'e iittanni xe'ma'neechcho kadeexxa ege'ni:</para>
  <para style="q2" vid="PRO 24:14">beekkuma affoottole soodik atik galduminna qajeelaan; hegerii atixinna tola gattaban.<verse eid="PRO 24:14" /></para>
  <para style="s1">Lame tommenna torbaka</para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />Qullichchi manjike mine'n bokkaametishsha qoone abixxite gaaxxitoxxe;</para>
  <para style="q2" vid="PRO 24:15">galduma isikanna keekkattebaaba buqqoxxe.<verse eid="PRO 24:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />Qullichchi torbaanele midde iboolenna ke'aan;</para>
  <para style="q2" vid="PRO 24:16">fuggaalleeyye kinn fuggo insa'nexxinninn inbaan.<verse eid="PRO 24:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />Naaphi atik ibaa wodda mee godobi atik gammadoqqe;</para>
  <para style="q2" vid="PRO 24:17">guggufataa woddanna ililissoxxe.<verse eid="PRO 24:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />Kada gophphoole kinn Duuchchi Woddik Gootti tenne uude gammadabaan;</para>
  <para style="q2" vid="PRO 24:18">naapha atike'n idagammaxxa mufe waalaan.<verse eid="PRO 24:18" /></para>
  <para style="s1">Lame tommenna sallanika</para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 24:19" />Fuggaalleeyeye mannixxe huje'a rakkattoxxe,</para>
  <para style="q2" vid="PRO 24:19">elobaaxxa assa'neera'n gaabbitoxxe.<verse eid="PRO 24:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />Gifeeffataak heger'a adde assedhaaxxi yaane hexxebaan;</para>
  <para style="q2" vid="PRO 24:20">fuggaalleeyyetik xassi xo'e liphphi hiyyaan.<verse eid="PRO 24:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />Koo anke belto Duuchchi Woddika Goottanna moyanjo sodaat;</para>
  <para style="q2" vid="PRO 24:21">xaqaro assaake manninni ittanna gudditoxxe'e.<verse eid="PRO 24:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />Duuchchi Woddiki Gootiinna moyanji tenne fuggaalleeyye'ni jabaxxe bala ibisaan:</para>
  <para style="q2" vid="PRO 24:22">insa'ne'ni geltaaxxi bala hittaxxeexxe kaddeexxa ege'naak ayyete?<verse eid="PRO 24:22" /></para>
  <para style="s1">Lebemeeka Beekoletika Mammaassuwwa</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />Kunniir kinn beekoletik mammaassan;</para>
  <para style="q2" vid="PRO 24:23">murte weleke'e gamisa elobaaxen.<verse eid="PRO 24:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />Balleesanjonga, «Ati qullichchaken» hiyyaaka,</para>
  <para style="q2" vid="PRO 24:24">gosa gosak ardi iso'o yowwaan; mannikinna gibaan.<verse eid="PRO 24:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />Yaane kinn balleesanjo toggitte murtenni murtaaxxe hayyoole'a elonxi insa'ne'a kaddaan;</para>
  <para style="q2" vid="PRO 24:25">lumoxxa karranna horantaan.<verse eid="PRO 24:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />Dhugaatixxa murte muraak,</para>
  <para style="q2" vid="PRO 24:26">lubboti jaalishsha uudemaan.<verse eid="PRO 24:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />Sirete'n galduma atike'e fichchi giddo kaddaaxxa yaane duuchcha giissedhi;</para>
  <para style="q2" vid="PRO 24:27">ookkonechchi uduma mine ijaadhdhi.<verse eid="PRO 24:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />Fedhee manjo'n buuto mitte belo baassitoxxe;</para>
  <para style="q2" vid="PRO 24:28">dedhisaaka haaso'anna iso'n fulchexxoxxe.<verse eid="PRO 24:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />«Fuggoxxa huje hujeenxe qixxe'n aninna elobaaxxa iso'n geessisannon;</para>
  <para style="q2" vid="PRO 24:29">halo anixanna hiissedhannon» hitoxxe.<verse eid="PRO 24:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />Boose'i manjike fichchi giddii'n qaxxaamurenne;</para>
  <para style="q2" vid="PRO 24:30">wodanaa afebaake manjik woyinetike hiddichchi bogika kute sa'enne.<verse eid="PRO 24:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />Ookkone booncho'ninna utenna badda'a quffeemman;</para>
  <para style="q2" vid="PRO 24:31">kinjiink dalla'inna diigemeen.<verse eid="PRO 24:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />Uudennaxxa yaanenna memmekisennen;</para>
  <para style="q2" vid="PRO 24:32">hede qonxise baranno alfenne.<verse eid="PRO 24:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />Shiixxo qico mugi, shiixxoon qico suukki hiyyi;</para>
  <para style="q2" vid="PRO 24:33">lekka qaxxaamursite heenoo qico hafuura adhdhi.<verse eid="PRO 24:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />Yaane kinni hiyyo saamammake manjiinsha;</para>
  <para style="q2" vid="PRO 24:34">hiyyo lolinka miya ka'leeke manjishsha ate'n daggaan.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s1">Wele Solomoonika Mammaassuwwa</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />Kunniir Yihudak moyanji Hizqiyaasik manni welbaa'ni bukki asseeka Solomoonika mammaassuwwa.<verse eid="PRO 25:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />Magen shasha buqaammaxxe'e ulfoten; yaane file findiga moyanjuwwake kinn lumminnekeni.<verse eid="PRO 25:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />Moyanjiinka godoba ayyinna ege'na dande'abaan; moyanjiink hedum qeerrexxeexxe iimuwwashsha, ittanni buttin hundixxe dhi'moshshaten.<verse eid="PRO 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />Birret sibiljonaa'n ciila hoyyi;</para>
  <para style="q2" vid="PRO 25:4">giissammakinna ca'a assedhaan.<verse eid="PRO 25:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />Moyanji edii'n fuggaalleeyye fugussi;</para>
  <para style="q2" vid="PRO 25:5">moote isixxinna qullummat jabaatte hexxaan.<verse eid="PRO 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />Moyanji edo ifi lummissoxxe;</para>
  <para style="q2" vid="PRO 25:6">lumolli mannixxe oddo'n hedhate'e gaabbitoxxe'e.<verse eid="PRO 25:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />Atee'e lumoke manji edo shookisheexxi mannii'ni:</para>
  <para style="q2" vid="PRO 25:7">umi isingininni, «Amo lumoba konnoo ofo'li» ate'e hiyyeele woyyan.<verse eid="PRO 25:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 25:8" />Atinna ille atixxi uudeexxa yaane duuchcha iso'o murtetixxe songoba'a mudammiki aaxxe martoxxe:</para>
  <para style="q2" vid="PRO 25:8">jaali atiki ate'e salphisoole</para>
  <para style="q2" vid="PRO 25:8">dokko maa kaddatto?<verse eid="PRO 25:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />Umi atikixxe yaane'a jaali atikinni welt morondatto wodda;</para>
  <para style="q2" vid="PRO 25:9">wele manjika shasha diiggoxxe'e.<verse eid="PRO 25:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />Iita kada gophphoole tenne'e laqaak atee shookishaan:</para>
  <para style="q2" vid="PRO 25:10">ifi heqqexxabexxoke kaddoottole elobaake summa ate'ni buuraan.<verse eid="PRO 25:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />Eloxxe yanna'ni kulemeeka hasisaaka hiyyichcho,</para>
  <para style="q2" vid="PRO 25:11">birreti sibiljinn hujendeexxe qore giddo hexxeexxe worqetixxe gummashshateni.<verse eid="PRO 25:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />Muxxee manjika xixichcho laqaakixxi mansha worqe</para>
  <para style="q2" vid="PRO 25:12">yookaan eloxxe worqeke seessishshaten.<verse eid="PRO 25:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />Mayetixxe yanna'ni kaadetiki qiide wodi'i hashubbi assammashsha;</para>
  <para style="q2" vid="PRO 25:13">addatemeeki erganji ergemaakee iitandeni:</para>
  <para style="q2" vid="PRO 25:13">goottuwwinka yaada iittanni ti'ni asan.<verse eid="PRO 25:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />Uwwabaanxa yaane uwwannon hiyye ifi lummisaak manji,</para>
  <para style="q2" vid="PRO 25:14">xeena afebaake duumanchishshanna diidalloshshaten.<verse eid="PRO 25:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />Ossunteti moyanjiba'a shiqa moronsiisaaxxa jabaxxa yaane qiidissaan:</para>
  <para style="q2" vid="PRO 25:15">akeekisanjuwwakanna yaadiki mitte kandaashsha assaan.<verse eid="PRO 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />Malebo alfitatto wodda miketi iti,</para>
  <para style="q2" vid="PRO 25:16">bira sa'oole ho'o assaan.<verse eid="PRO 25:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />Atike jaalike miniba'a amma ammanni martoxxe,</para>
  <para style="q2" vid="PRO 25:17">uude uude hiyyoole ate'e jibbaan.<verse eid="PRO 25:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />Jaalo ifike'n dhugaa dhariki kulaaki manji</para>
  <para style="q2" vid="PRO 25:18">wolaantichchiinsha, siqqo qaraxxe gabeshaten.<verse eid="PRO 25:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />Rakkoti wodda addatemabaake manjo'ni addata,</para>
  <para style="q2" vid="PRO 25:19">le'miteexxe issonni incatishshanna naaffe'exxe lekkann me'atishshaten.<verse eid="PRO 25:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />Yaadeeke manji'a faaro faarsa,</para>
  <para style="q2" vid="PRO 25:20">boojetixxe barra'ni seemma fulchineeke manjishshanna</para>
  <para style="q2" vid="PRO 25:20">madate'ni maxine woreeke manjishshaten.<verse eid="PRO 25:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />Atik naaphi solo'woole itisi,</para>
  <para style="q2" vid="PRO 25:21">dheebo'woole ha'wisi.<verse eid="PRO 25:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />Tenne'e assiyoti umo isike'n giira wortetteshshaten;</para>
  <para style="q2" vid="PRO 25:22">Duuchchi Woddik Goottinna hira ati'a uwwaan.<verse eid="PRO 25:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />Middii'ni gandaaxxi diidallo xeena yexxammashsha;</para>
  <para style="q2" vid="PRO 25:23">afoollichchi arrabi mufete'n geessisaan.<verse eid="PRO 25:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />Afoollitte melaallenni mine mitte'n hedhati irra;</para>
  <para style="q2" vid="PRO 25:24">miniinxe heellchoke kasa'ni hedha woyyan.<verse eid="PRO 25:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />Bayyi'ni daggaaxxi eloxxi odo,</para>
  <para style="q2" vid="PRO 25:25">dheebotteexxa lubbo dheebo fulchammake qiida wodi'ishshateni.<verse eid="PRO 25:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />Fuggo manji'a guluffataaki qullichchi manji;</para>
  <para style="q2" vid="PRO 25:26">boorotteexxe muummeshsha yookaan baleessishshaten.<verse eid="PRO 25:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />Malebo bira sa'isse ita eloxebaan;</para>
  <para style="q2" vid="PRO 25:27">ulfinna ifika halsa lummissabaan.<verse eid="PRO 25:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />Umo ifika dedhaaki manji;</para>
  <para style="q2" vid="PRO 25:28">kinjiink dalla'i diigemeeke qachchishshaten.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 26:1" />Kaade bono xeen kinni midha aassatixxa yanna hasissammabaashshanni,</para>
  <para style="q2" vid="PRO 26:1">gowwake'e ulfinni hasisaba'a.<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />Ci'a keelik kexxe me'itaa wodda ate'n mitte rakkonna idagammabaashsha,</para>
  <para style="q2" vid="PRO 26:2">toliinxi badino ate abidaba'a.<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />Fadhadokee'e halange, gangete'e bixaal hasisammashsha,</para>
  <para style="q2" vid="PRO 26:3">gowwiinke bisi'anna siqqo hasissa.<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />Atinna isishsha gowwaake kaddaboxxoshsha,</para>
  <para style="q2" vid="PRO 26:4">gowwake'e gowwumma isixxishsha hissitoxxe'e.<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />Yaane kinni «Ani muxxete» hiyye ifi uudabaashsha,</para>
  <para style="q2" vid="PRO 26:5">gowwake'e isixxe gowwumma leellishaaka hiissichcho uwwi.<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />Gowwi dhaa'me ergedha,</para>
  <para style="q2" vid="PRO 26:6">ifixxa lekka kutatishsha yookaan fuggo ifi'ni idaqammashshate.<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />Gowwii mammaakaaki mammaassi naaffe rarrateexxe lekkashshate.<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />Gowwa ulfeessa, looyyate'n gudunfemeeka kinjo looyyatishshate.<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />Gowwi manji mammaakaaki mammaassi,</para>
  <para style="q2" vid="PRO 26:9">machcho'eeke manjinxe anga'ni hexxeexxe uteshshate.<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />Gowwa yookaan afeenga ora sa'aaka manjo huje hujilsaak manji,</para>
  <para style="q2" vid="PRO 26:10">gabe afeshanni darbata'n manjo madeessakeni.<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />Honqo'eexxa honqo'o worshi wirri hiyye'e itammashsha,</para>
  <para style="q2" vid="PRO 26:11">gowwi gowwummati hiyyemanxe hiyya.<verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />Muxxete kadebaang muxxe'eeshsha ifi assaaka manjo uudette?</para>
  <para style="q2" vid="PRO 26:12">Isi mannii'n gowwa woyya.<verse eid="PRO 26:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />Boose'i manji, «Orake'n neenqake hedhe,</para>
  <para style="q2" vid="PRO 26:13">sodaachchisaak neenquwwi orake'n hedhe» hiyya.<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />Saanqi maaxafi hana wirwir hiyyammashsha,</para>
  <para style="q2" vid="PRO 26:14">booso'i manji taqeti hana gangalata.<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />Boose'e manji ito'a qore giddo anga ugga,</para>
  <para style="q2" vid="PRO 26:15">yaane kinni ita afo'o uggudhdha iso'n a'urtaan.<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />Boose'i manji qalbeeffachchoti hiissichcho hiissaake torbaane manna caala,</para>
  <para style="q2" vid="PRO 26:16">ifi muxxete assa.<verse eid="PRO 26:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />Wele mannike lola'ni oddo e'yaaki manji,</para>
  <para style="q2" vid="PRO 26:17">Ora sa'ammake worshixxa mansha abidatishshate.<verse eid="PRO 26:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18" />Manjo shiyaaka qaraka mogiddo yookaan bagedo maraattichchi darbaammashsha,<verse eid="PRO 26:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19" />«Roorotte'n» hiyya'n manjo sobaaki manji iitta isishsha hedheekeni.<verse eid="PRO 26:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />Haqqetixxe gophemmanni giira xoxxa,</para>
  <para style="q2" vid="PRO 26:20">odichchiinxe gophemanninna loli gataani.<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />Cilaatte kashilo, haqqetinna giira, ha'yinshammashsha</para>
  <para style="q2" vid="PRO 26:21">gegge'aki manji lola ke'issa.<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />Hamataake manjik haaso'i xe'maxxe itashsha,</para>
  <para style="q2" vid="PRO 26:22">godob giddi'a luqu'mi hyye e'ya.<verse eid="PRO 26:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />Godobake'ni fuggoxxa uggudhdhe afo'ik eloka haaso'a haaso'aak manji,</para>
  <para style="q2" vid="PRO 26:23">baqeeka birretika sibiljo hana buyyineeke faarinke mi'a.<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />Xaqartichchi manji afo'ik eloxxa haaso'a'n foggoxxa godobi giddo hedaan.<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />Isi godobi giddo fuggoxxa wonshedhemmaxxe'e,</para>
  <para style="q2" vid="PRO 26:25">xe'make haaso'inni ate'e maxxisoolenna meenn haaso'a isika dhugaate assedhi.<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />Xaqartichchi fuggoka ifika yaada godobi giddo sho'edhoolenna,</para>
  <para style="q2" vid="PRO 26:26">isi assaaxxe fuggoxxe yaaneni manjo duuchcha'n leella.<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />Weleke'e bale qotaak ifi'aanni giddo e'ya,</para>
  <para style="q2" vid="PRO 26:27">kinjo goggo'mishaakanna ookkone kinjonde illee iima hige iso'n goggo'ma.<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />Dharichchi manji ifi'aanni miidhema miidhemanga manna jibba,</para>
  <para style="q2" vid="PRO 26:28">lame afo'ikinna ba'ne idaga.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />Barra idaggaaxxa ege'na gophpheetaxxe'e</para>
  <para style="q2" vid="PRO 27:1">soodo kaddaaxxe'n irkattoxxe'e.<note caller="-" style="x"><char style="xo" closed="false">27:1 </char><char style="xt" closed="false"><ref loc="JAS 4:13-16">Ya'i. 4:13-16</ref>. </char></note><verse eid="PRO 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />Weli manni ate'e saado malee ati ifi saaddoxxe'e</para>
  <para style="q2" vid="PRO 27:2">weli atixxe'e haaso'o malee ati ifixxa eloxxa haasotoxxe'e.<verse eid="PRO 27:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />Kinji a'uraan, maanchikinna hirikki hiyya,</para>
  <para style="q2" vid="PRO 27:3">gowwi manjiinxi mufe kinn lamingee'n irra a'urtaan.<verse eid="PRO 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />Mufe godoba jabaatate'ninna aarete'n geessisa,</para>
  <para style="q2" vid="PRO 27:4">hinaaffe kinn mufe saxxaan ayyete ise edo dande'e uurra?<verse eid="PRO 27:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />Iima leelleek yowwichchi, buqo hexxeexxe jaalalanaa'n sa'a.<verse eid="PRO 27:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />Naaphinxe sunqedha mannii'n jaaliinxa miidha woyya.<verse eid="PRO 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />Goddeeke manji'a malebiinxi la'e xe'mitabaan,</para>
  <para style="q2" vid="PRO 27:7">so'lo'weeke kinni qarartaanxi yaane midde xe'mitaan.<verse eid="PRO 27:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />Mine ifikenaa'ni fule doonsakiyya hiyyaak manji,</para>
  <para style="q2" vid="PRO 27:8">mine ifika waalde me'ite doonsakiyya hitammaxxe ciichoshshate.<verse eid="PRO 27:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />Shittotixxinna hixaaninxi fishshe manjo gammachchiissammashsha,</para>
  <para style="q2" vid="PRO 27:9">jaaliink gorsinna manjo gammachchiisa.<verse eid="PRO 27:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />Atika jaalonna kadi atike annnika jaalo waaldoxxe'e,</para>
  <para style="q2" vid="PRO 27:10">rakko ate'n geltaa wodda atike dayyiba martoxxe'e; bayyike firi mannii'n shiqika olla'a woyyani.<verse eid="PRO 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />Anke beltoo! Muxxete kadde ane'e gammachchiis,</para>
  <para style="q2" vid="PRO 27:11">ane'e cee'maake duuchchi'anna hiissichcho uwwa dandee'annon.<verse eid="PRO 27:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />Qaro dagga'neexxa rakko affee gollata,</para>
  <para style="q2" vid="PRO 27:12">ege'na afebaak manji kinni rakkonde'n mare miidhema.<verse eid="PRO 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />Alagi manjike liqi'a annooma adheeke manjixxa seemma adhdhi,</para>
  <para style="q2" vid="PRO 27:13">ookkone alagi manjixxeenna eettene seemma abixxi.<verse eid="PRO 27:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />Soodimaro hafuura gikki asse jaalo ifika nage'a aadha,</para>
  <para style="q2" vid="PRO 27:14">badinati qixxeteni.<verse eid="PRO 27:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />Afoollitte are,</para>
  <para style="q2" vid="PRO 27:15">xeeninxa barra sammi hiyye xissamake xissishshate.<verse eid="PRO 27:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />Ise'e sammi assatee wo'laana,</para>
  <para style="q2" vid="PRO 27:16">diidallo yookaan zayite angati cu'mate'e wo'laanaten.<verse eid="PRO 27:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />Sibilji sibiljo cabbammashsha, manjikinna ittanni mitti mitte cabba.<verse eid="PRO 27:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />Balleessetika haqichcho kaalse heqqedhaak manji gumma isexxe ita,</para>
  <para style="q2" vid="PRO 27:18">gootta ifika heqedhaak manji kinni ulfaata.<verse eid="PRO 27:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />Wode'i daa'witetishsha alba manjiinka leellishammashsha,</para>
  <para style="q2" vid="PRO 27:19">manjiinxi qalbenna ookkone manjika yaada farri assitee leellishsha.<verse eid="PRO 27:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />Reyeek manni hedhaabinna hirreessi geyeen hiyyammabaashshanni,</para>
  <para style="q2" vid="PRO 27:20">manjiinxi halchanna ittande.<verse eid="PRO 27:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />Worqetinna birretik sibiljinxi ca'umma giirate'n baqisende ege'nendammashsha,</para>
  <para style="q2" vid="PRO 27:21">manji isi'a uwwendaaxxe saadinonni hega uudema.<verse eid="PRO 27:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />Hawwawwa midhatishsha mooyyeke'n tumisanjik tundetele,</para>
  <para style="q2" vid="PRO 27:22">hawwawwumma isixxa isonaa'n hoyya dandeettabexxo.<verse eid="PRO 27:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />Gedhebi atik hedheeka jeeja hubatte uudi,</para>
  <para style="q2" vid="PRO 27:23">hore atikeenna xonxoommat.<verse eid="PRO 27:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />Durumma duuchchi woddi'a hexxabaan,</para>
  <para style="q2" vid="PRO 27:24">mootummatinna ilatenaa'n ilati qico'n.<verse eid="PRO 27:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />Baggeexxi arso haamendee'na'a haaroxxi lattaa wodda,</para>
  <para style="q2" vid="PRO 27:25">gooroti hana hexxeexxi arsonna bukki assendaa wodda;<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />Gedhebi atikenaa'n seemmate kaddaaxxa orda alfitatton,</para>
  <para style="q2" vid="PRO 27:26">re'e atixxanna gurgurte boga hidhdhitattochcho alfitatton.<verse eid="PRO 27:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />Ati'anna atike mini hadi'a</para>
  <para style="q2" vid="PRO 27:27">atixxe dubarte erganjuwwi'a geltaaxxa re'etixxa ado alfitatton.<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />Fuggichchi manji ayyinna shorrebaang baaja, qullichchi kinni neenqinsha mitte godobinni hedha.<verse eid="PRO 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />Bogiink ardi jalloole galchalluwwi birasa'aan,</para>
  <para style="q2" vid="PRO 28:2">yaane kinni qalbeeffachchotikinna ege'na afeek galchalli hedhaa wodda ardi qeerraxxe yanna'a ititee hedha.<verse eid="PRO 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />Hiyyeeyye miicaak manji,</para>
  <para style="q2" vid="PRO 28:3">midha balleessammake jabake xeenishshate.<verse eid="PRO 28:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />Seera ulfeessabaak manni fuggaalleeyye saada,</para>
  <para style="q2" vid="PRO 28:4">seera heqqedhaak manni kinni fuggaalleeyye gibaan.<verse eid="PRO 28:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />Fuggaaleyye manni dhuga'a qalbeeffantabaan,</para>
  <para style="q2" vid="PRO 28:5">Duuchchi Woddika Gootta harsaak manni kinn wo'ma qicinni ege'naan.<verse eid="PRO 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />Daabaallessa ora'n me'aake dureessi mannii'n,</para>
  <para style="q2" vid="PRO 28:6">addatemeeka hiyyeessa woyya.<verse eid="PRO 28:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />Seera heqqedhaaki qalbeeffachcho afeeke belton,</para>
  <para style="q2" vid="PRO 28:7">baashshe manninni welti jaalomaak kinni anna salphisaan.<verse eid="PRO 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />Dhala bira sa'issiyyoti karra bukki assedhaak,</para>
  <para style="q2" vid="PRO 28:8">hiyyeeyyete o'waake wele manni'a tuulaan.<verse eid="PRO 28:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />Seera laqa gibaake manjixxi soodachcho</para>
  <para style="q2" vid="PRO 28:9">Mageno diqachchiissa.<verse eid="PRO 28:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />Qajeela manna fuggo ora'n akeekaak</para>
  <para style="q2" vid="PRO 28:10">qotemmanxe bale'ni iba,</para>
  <para style="q2" vid="PRO 28:10">balleessa afebaak manji kinni eloxxe yaane dhaala.<verse eid="PRO 28:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />Dureessichchi ifi muxxete assee uuda,</para>
  <para style="q2" vid="PRO 28:11">qalbaamessi hiyyeessi kinni iso'o koke ege'na.<verse eid="PRO 28:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />Qulliyye injifattaa wodda lumooxxe gammashshoo kadda,</para>
  <para style="q2" vid="PRO 28:12">fuggaalleeyye galchate'n saxxaa wodda kinni suuqema.<verse eid="PRO 28:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />Cubbo ifixxa buqedhaak nammi hiyyaba'a,</para>
  <para style="q2" vid="PRO 28:13">faaci'weexxi isee'e waalak kinni gattowwaal alfa.<verse eid="PRO 28:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />Duuchchi wodda Duuchchi Woddika Gootta sodataake manjixxa wodo,</para>
  <para style="q2" vid="PRO 28:14">godoba jabeessedhaak kinni rakkote'n e'ya.<verse eid="PRO 28:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />Hiyyeeyye galchaak godoba jabaataak moyanji,</para>
  <para style="q2" vid="PRO 28:15">harqammake neenqishsha yookaan gaade tiribi hiyyammake Dibi hiyyemmake biniinchishshaten.<verse eid="PRO 28:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />Godoba jabakik galchalli xe'ya qalbeeffachchoke,</para>
  <para style="q2" vid="PRO 28:16">seeribeloxxa la'o gibaak kinni qeerrake baro hedha.<verse eid="PRO 28:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />Manjo anga sa'eek manji</para>
  <para style="q2" vid="PRO 28:17">reyaa qico'n doonsakiyya hiyya'n hedhaan;</para>
  <para style="q2" vid="PRO 28:17">ayyinna iso'o gargaaroqqe'e.<verse eid="PRO 28:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />Me'injo isike'n ci'memmabaaka manjo fuggoxxi iso'o geltaba'a,</para>
  <para style="q2" vid="PRO 28:18">dabaalessi orik manji kinni dadhange iba.<verse eid="PRO 28:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />Buttina huccaak gelte gattaaxxa ita alfa,</para>
  <para style="q2" vid="PRO 28:19">toliinxe halcha abixxe me'aak kinni buxanjo hyyeessa kada.<verse eid="PRO 28:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />Addatemeek manji lumo qico eebbisema,</para>
  <para style="q2" vid="PRO 28:20">duroomo'a wiinamaak kinni xixemebaak gataba'a.<verse eid="PRO 28:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />Gamisiyyo eloxxebaan,</para>
  <para style="q2" vid="PRO 28:21">manji kinni tima waasixxe hiyye balleessa huja.<verse eid="PRO 28:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />Donni duroomo'a haafema,</para>
  <para style="q2" vid="PRO 28:22">hiyyumma iso'o heqqita'neexxa ege'neba'a.<verse eid="PRO 28:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />Kookishshik haaso'a manji mannii'n,</para>
  <para style="q2" vid="PRO 28:23">xixaak manji uduma galateeffatema.<verse eid="PRO 28:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />Anno amatenaa'n mooreexxi, «Tinni balleessatebaan» hiyyaak,</para>
  <para style="q2" vid="PRO 28:24">balleessammake wele manninni qixxenden.<verse eid="PRO 28:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />Donni manji lola ke'issa,</para>
  <para style="q2" vid="PRO 28:25">Duuchchi Woddike Gootta'n addataak kinni godda.<verse eid="PRO 28:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />Umo ifike'n addatak manji hawwawwake,</para>
  <para style="q2" vid="PRO 28:26">muxxummati hedhaak fuggoxxenaa'n gata.<verse eid="PRO 28:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />Hiyyeeyyete'e uwwaak gophaachchi hedheba'a,</para>
  <para style="q2" vid="PRO 28:27">afa'inni afebaashsha sa'aak kinni yowwema.<verse eid="PRO 28:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />Fuggaalleeyye galchita wodda manni suuqema,</para>
  <para style="q2" vid="PRO 28:28">galchatenaa'n fuggaaleyye kexxaa wodda kinni qulliyye bira saxxa.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />Heddo xixichchi uduma higa gophe itti jabeessedhe jallaak manji,</para>
  <para style="q2" vid="PRO 29:1">dedhange'n copheeba gonphaan; mare e'yaaba anfabaan.<verse eid="PRO 29:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />Qulliyye galchate'e filendaa wodda ardi yo'oshsha gammadaan;</para>
  <para style="q2" vid="PRO 29:2">fuggaalleeyye filendaa wodda kinn manni yaaddot aaddani.<verse eid="PRO 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />Beekkuma eeyyaak manji ifika anna gammachchiisaan;</para>
  <para style="q2" vid="PRO 29:3">yaababul jaaluwwi kinn isixxa karra faangessaan.<verse eid="PRO 29:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />Dhugaatixxa murte bogi giddo fakkanshat moyanji boga nageesaan;</para>
  <para style="q2" vid="PRO 29:4">matta adhate'e haafemaaki kinn nage'a balleessan.<verse eid="PRO 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />Ifike jaaluwwa'ni shokko hujaak,</para>
  <para style="q2" vid="PRO 29:5">ifinni ifi sagadhaan.<verse eid="PRO 29:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />Fuggichchi manji ifi'aan hujemmanxe cubbo'ni sagaremaan;</para>
  <para style="q2" vid="PRO 29:6">qullichchi kinn faarsa'n ililisaan.<verse eid="PRO 29:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />Qullichchi manji hiyyeessiinxe dhuga'a laalataan;</para>
  <para style="q2" vid="PRO 29:7">fuggichchi kinn bashshi hiyyan.<verse eid="PRO 29:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />Futti hiyyeeshsha galamma manni qachcha daaqisaan;</para>
  <para style="q2" vid="PRO 29:8">beeki manni kinn mufe qiidisaan.<verse eid="PRO 29:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />Ege'na afeek manji hawwawwik weli ku'late'e songo marreele,</para>
  <para style="q2" vid="PRO 29:9">gowwi aareme jinne nage'a balleessaan.<verse eid="PRO 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />Manjo anga sa'ek mann dhugaatika manjo eenabaan;</para>
  <para style="q2" vid="PRO 29:10">qajeelakanna shiyate'e gaandaan.<verse eid="PRO 29:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />Gowwi manji futti hiyyeenba aare bidhdhaan;</para>
  <para style="q2" vid="PRO 29:11">ega'na afeek kinn osse ifi abixxan.<verse eid="PRO 29:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />Galchanji dhariinxa odo caqasa'noole;</para>
  <para style="q2" vid="PRO 29:12">hayyoole duuchcha diinameeyyete kaddaan.<verse eid="PRO 29:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />Hiyyeessakanna iso'o miicaammaka manjo ille uushsho uudabaaki</para>
  <para style="q2" vid="PRO 29:13">Duuchchi Woddik Gootti duuchchinge'e affaaxxa ille uwween.<verse eid="PRO 29:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />Moyanji hiyyeessake'e dhugaatixxa murte uwweele,</para>
  <para style="q2" vid="PRO 29:14">mootumma isixxinna baro baro'ni jabaatte'e hexxaan.<verse eid="PRO 29:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />Oose kutik gananna xixa muxxe kandaasha assitaan,</para>
  <para style="q2" vid="PRO 29:15">nossichcho ba'eeki belti kinni ildeenxa ama salphisaan.<verse eid="PRO 29:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />Fuggaalleessi manni galchate'e filemoole cubbo bira sa'issinaani,</para>
  <para style="q2" vid="PRO 29:16">qulliyye kinn insa'nexxa iba uuddan.<verse eid="PRO 29:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />Belto atika xixi, nage'a ati'a uwwaan,</para>
  <para style="q2" vid="PRO 29:17">lubbo atixxanna gammachchiisaan.<verse eid="PRO 29:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />Leella hexxeebaa boonchik ardi xeereme'e wocci hiyyaan,</para>
  <para style="q2" vid="PRO 29:18">seera heqqedhaaki kinn isi eebbatiken.<verse eid="PRO 29:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />Erganji xixa gophoole afo'i callinni baratabaan,</para>
  <para style="q2" vid="PRO 29:19">ati hitaattenxi yaane iso'ni aagoolenna midde ajajemabaan.<verse eid="PRO 29:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />Muddame haaso'aaka manjo uudeenn hexxette?</para>
  <para style="q2" vid="PRO 29:20">Isi mannii'n oossoommateeki manji hegeri ba'abaan.<verse eid="PRO 29:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />Manji mini giddo ergatema'ni oosummateenaa'ni ke'isse xoo'mamik nophphoole,</para>
  <para style="q2" vid="PRO 29:21">udumi uduma yaaddo hanqattabaan.<verse eid="PRO 29:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />Aarameessi manji lola ke'issaan,</para>
  <para style="q2" vid="PRO 29:22">hifatichchi bira saxxeexxa cubbo hujaan.<verse eid="PRO 29:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />Manjo holla isinxi iso salphisaani,</para>
  <para style="q2" vid="PRO 29:23">eloka hafuura afeeki kinni ulfaataan.<verse eid="PRO 29:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />Moodhalchik welti guddaak ifi huneeken,</para>
  <para style="q2" vid="PRO 29:24">kakatoolenna midde dhugaa fulche haaso'abaan.<verse eid="PRO 29:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />Manjo sodaataak fuggoxxe'ni ibaani,</para>
  <para style="q2" vid="PRO 29:25">Duuchchi Woddike Gootta'n addatemaaka kinn isinni heqqaan.<verse eid="PRO 29:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />Heddi manni moyanjokenaa'nii elle alfo'a hasaan,</para>
  <para style="q2" vid="PRO 29:26">yaane kinni manji dhugaatixxa murte alfaaki Duuchchi Woddike Gootti darree'niten.<verse eid="PRO 29:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />Qulliyye sobaaleyye manna jibbitaan,</para>
  <para style="q2" vid="PRO 29:27">fuggaalleeyyetinna qajeela manna gibbaan.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s1">Agur Haaso'eeka Mammaasuwwa</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Maasa hiyyemaake bogik manji Yaaqek belti Agure salalik haaso'eek hiyyichchi konnechchinn butti'a hedheen;</para>
  <para style="q2" vid="PRO 30:1">kunni manji Iti'eeli'a, Iti'eelinna Ukaal'a haaso'e.<verse eid="PRO 30:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />«Ani manjo duuchchanaa'n jaalaten, manji hedammaxxa hedino afebe'non.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />Beekkuma baratebe'non, woyyichchiinxe ege'nennengechchi hedhebaan.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />Iimi'a fuleeki, dirreek isinni ayyete?</para>
  <para style="q2" vid="PRO 30:4">Diidallo gunse abixxe'ek isinn ayyete?</para>
  <para style="q1" vid="PRO 30:4">Wode'uwwa ifixxe seemmann usudhdheek ayyete?</para>
  <para style="q2" vid="PRO 30:4">Bogiinxa gabala duuchcha jabeesse uurriseek ayyete?</para>
  <para style="q1" vid="PRO 30:4">Summi ising ayyte? Beltiinki summi ayyete hinaake?</para>
  <para style="q2" vid="PRO 30:4">Egendottole amo mee ane'ni kul!<verse eid="PRO 30:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />«Mageniink hiyyichchi duuchchi mitte gugurto afebaan;</para>
  <para style="q2" vid="PRO 30:5">Isi iso'o adde assedhaake duuchchi'a wonteten.<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />Isike hiyyichcho'n ittanna lebboxxe;</para>
  <para style="q2" vid="PRO 30:6">hexxebaaxxa lebbottole xixaan, ate'e dharichchake assaan.<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />«Ee Duuchchi Woddike Gootta lame yaane ate'e soodataannen;</para>
  <para style="q2" vid="PRO 30:7">reyebe'nog ane'e hoyyexxabexxoshsha soodataannen.<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />Haranga dhugaa dharake asse haaso'atena'n ane'e heqqi;</para>
  <para style="q2" vid="PRO 30:8">hiyyummatenna kadi durumma ani'a uutoxxen;</para>
  <para style="q2" vid="PRO 30:8">yaanee kinn telcho ite hosannoxxa ita ani'a uwwi.<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />Iita kada gophphoole ite godde atena'ni finqile,</para>
  <para style="q2" vid="PRO 30:9">‹Duuchchi Woddik Gootti ayyete?› Hiyyannoxxe hexxeen;</para>
  <para style="q1" vid="PRO 30:9">Yookaan hiyyoome moorannon;</para>
  <para style="q2" vid="PRO 30:9">anke Magenika summanna yowwisanon.<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />«Erganjo atika gootti isiki edo elobaaxxinn hamattoxxe,</para>
  <para style="q2" vid="PRO 30:10">dedha ate'ni fuggoka afo'o fulchee'na miidhendatton.<verse eid="PRO 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />«Anna ifinga yowwitaaxxi,</para>
  <para style="q2" vid="PRO 30:11">amatanna lumissabaaxxi ila hexxeen.<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />Ifi qullichcha assexxe uuddaaxxi,</para>
  <para style="q2" vid="PRO 30:12">kaddo male'e batto'e ca'a hiyyebaakir hedheen.<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />Holle kijibeekirinna manjo tuffataak mannuwwa hedheen.<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />Rakkichcha bogakenaa'n</para>
  <para style="q2" vid="PRO 30:14">hiyyeessakanna manjiinxe oddonaa'n shorre balleessate'e</para>
  <para style="q1" vid="PRO 30:14">Isso wolantichchinsha,</para>
  <para style="q2" vid="PRO 30:14">qeqqeshshikinna kaara hinake habillishsha hexxeexxi horte hexxeen.<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />«Alqiitti lame meyyaxxa oose affeen;</para>
  <para style="q2" vid="PRO 30:15">‹no'o'a uwwe! No'o'a uwwe!› hina'ni hongaan.</para>
  <para style="b" vid="PRO 30:15" />
  <para style="q1" vid="PRO 30:15">«Ijjenda geyeen goddeennen hitabaaxxi sase yaanuwwa hexxeen:</para>
  <para style="q2" vid="PRO 30:15">‹Hara ane'e geye'en!› hitabaaxxi shoole yaannuwwan:<verse eid="PRO 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16" />Kunniichchuwwinna, herreessa,</para>
  <para style="q2" vid="PRO 30:16">ildebaaxxi manjichcho,</para>
  <para style="q2" vid="PRO 30:16">wode'e gophe baqaqeek buttin, ‹hunnati iima hexxeexxe› geyyen hitabaaxxe giirateran.<verse eid="PRO 30:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />«Anna ifika cee'maakinna amatika ajaja tuffate qeeqaak,</para>
  <para style="q1" vid="PRO 30:17">Dhooqa giddo hedheek haanquwwi ille isixxa qote aadhaan;</para>
  <para style="q2" vid="PRO 30:17">allaatuwwatinna ittaan.<verse eid="PRO 30:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18" />«Hara mambe'a assissaaxxi sase yaane hexxen:</para>
  <para style="q2" vid="PRO 30:18">qaabbatabo'noxxi shooleten.<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />Sinbiri iima me'aan,</para>
  <para style="q2" vid="PRO 30:19">bofi harkisema'n butta me'aan,</para>
  <para style="q1" vid="PRO 30:19">Hobolo abbayate'n me'itan,</para>
  <para style="q2" vid="PRO 30:19">meyyaxinni jaalalat qiliphphisaake labbakeran.<verse eid="PRO 30:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />«Addatendabaaxxi are; yabaabuldaaxxi aro'i edo qullichcha manjo fakkaateexxi,</para>
  <para style="q2" vid="PRO 30:20">‹Mitte ballessengechchi hedhebaan› Hitaan.<verse eid="PRO 30:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21" />«Butta sase yaanenni raankitaan,</para>
  <para style="q2" vid="PRO 30:21">wele dhiisin dandeette ba'exxabaxxi shoole yaanuwwan:<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />Garbichchi moya sane,</para>
  <para style="q2" vid="PRO 30:22">da'labi ite goddoole,<verse eid="PRO 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23" />Jibbendeexxi manjo aro'o alfita sane,</para>
  <para style="q2" vid="PRO 30:23">meyyaxxi garbitte hujisammaxxa moote dhaalda wodda kaddaaxxe yaanuwwan.<verse eid="PRO 30:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24" />«Buttate'n shoole shiixara</para>
  <para style="q2" vid="PRO 30:24">jabaxxa ege'na affeexxi yaanuwwa hexxeen;<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />Xuxuwwa hunna affebaxxe daduwwan;</para>
  <para style="q2" vid="PRO 30:25">kaddo malee indaachcho boni gaafa yannande'n ca'mitaan.<verse eid="PRO 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26" />Osoletinna hunna afebaachchoran;</para>
  <para style="q2" vid="PRO 30:26">kaddo malee kinotixxe oddo'n holla galduma asse'ne giise'naan.<verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />Awwaanesuwwi moyanjo anfeebaan;</para>
  <para style="q2" vid="PRO 30:27">kaddo malee gume googessik me'aan.<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />Dadda'le angati abindaangechchon;</para>
  <para style="q2" vid="PRO 30:28">kaddo malee moyanjiinke mooteti mine'n e'itaan.<verse eid="PRO 30:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29" />«Me'injonge'n mambe'a hiyyendeexxi sase yaanuwwa hexxeen.</para>
  <para style="q2" vid="PRO 30:29">Matanga gaachchanna affe'e hirikki hiteexxi shooleten.<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />Biniichchi giddii'n jabak</para>
  <para style="q2" vid="PRO 30:30">feedheechchonaa'ni ittanna mishikk hiyyabaak neenqaken;<verse eid="PRO 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31" />Re'eti kormi, baroodaki lukoti korman;</para>
  <para style="q2" vid="PRO 30:31">insa'neke ardi edo ulfinki leelak moyanjuwwan.<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />«Oossoommate'e ifi lummissottole</para>
  <para style="q2" vid="PRO 30:32">yookaan elobaaxxa yaane heddottole</para>
  <para style="q2" vid="PRO 30:32">ifi heeshshi assite uudi.<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />Ado raansaa wodda buuri dagammashsha,</para>
  <para style="q2" vid="PRO 30:33">sano gannaa wodda mundaattammashsha</para>
  <para style="q2" vid="PRO 30:33">mufe duuchchiinsoole lolake ke'aan.»<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Moyanjo Limu'eeli'i ama barsiiseexxi barachcho konnechchinni butti'a hexxeexxen.<verse eid="PRO 31:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />«Anke belto i'lennekee, wereegik alfennekee,<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />Hunna atixxa melaallete'n birtoxxe'e,</para>
  <para style="q2" vid="PRO 31:3">tenne yaanexxi yaane moyanjuwwakanna midde salphisse'een.<verse eid="PRO 31:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />«Koo Limu'eeli moyanjuwwi woyinetixxa booka ha'wiyyo</para>
  <para style="q2" vid="PRO 31:4">galchalluwwikinna machchoossitaaxxa ha'wa halchiyyo hasissabaa,</para>
  <para style="q2" vid="PRO 31:4">tinni moyanjoke kadeeki manji assaaxxe yaanebaan.<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />Moyanjuwwi ha'we machcho'oole seera dedheexxi,</para>
  <para style="q2" vid="PRO 31:5">miicemeeke mannixxa deette hoyyedhaan.<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />Ba'aake manni'a machchoossitaaxxa ha'wa</para>
  <para style="q2" vid="PRO 31:6">wixxirri hiyya'neekiri'anna ha'wino'a woyinetixxa bookka uwwe.<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />Insa'ne hiyyumma ifixxanna</para>
  <para style="q2" vid="PRO 31:7">rakko ifixxa deenaashsha ha'winowwaal.<verse eid="PRO 31:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />«Ifixxe yaane'a haaso'a dande'aabaake manni'a ati insa'ne'a haaso'i,</para>
  <para style="q2" vid="PRO 31:8">miicemeeke mannixxe deette'a ati uurrite haaso'i.<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />Insa'nexxee haaso'i, dhugaatixxa murtenna muri;</para>
  <para style="q2" vid="PRO 31:9">hiyyeeyyetixxanna rakkiyyetika seera heqqisi.»<verse eid="PRO 31:9" /></para>
  <para style="s1">Eloke Adabixxa Are</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />Eloke adabixxa are ayyete ise dande'e alfa?</para>
  <para style="q2" vid="PRO 31:10">Iseki hiri fiixeeke kinjuwwi caala lumoo qico fiixxeexxe.<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />Aro'i iseki ise'e mitte godobinni amanaani,</para>
  <para style="q2" vid="PRO 31:11">hasissaaxxa yaane duuchcha isena'ni gophabaan.<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />Ise hedhoti hexxeeke baro duuchcha'n isi'a eloxxe assita malee'e</para>
  <para style="q2" vid="PRO 31:12">fuggoxxa yaane iso'ni assitabaan.<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />Fuutinxanna liyonotixxa seemma</para>
  <para style="q2" vid="PRO 31:13">eettene huje eetaaxxe anganni</para>
  <para style="q2" vid="PRO 31:13">gammadda'n hodhdhatixxe huje'n siitaan.<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />Dadaltotixxe lumoxxe hoboloshsha,</para>
  <para style="q2" vid="PRO 31:14">bayya marta'n gargar gargar hexxeexxa ita gurte iyyedagaan.<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />Adda soodebang kexxa,</para>
  <para style="q2" vid="PRO 31:15">ifike minihadi'a ita ra'issita;</para>
  <para style="q2" vid="PRO 31:15">dubarte erganjuwwa ifixxeenna hujetika qoobbo uutaan.<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />Umo ifingenninni isenni heddeexxi boga hirta,</para>
  <para style="q2" vid="PRO 31:16">alfitaake maalaqininna woyine kaassaan.<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />Jabaatteexxi huje ifixxa huccita,</para>
  <para style="q2" vid="PRO 31:17">uduudi isekinna hujetee'e jabaken.<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />Hujja'neexxi huje duuchcha la'o idaga'neexxa qalbeeffataan,</para>
  <para style="q2" vid="PRO 31:18">hashshanna hujjaammaxxe'e xassi iseki xo'abaan.<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />Giissiteeka fuutta liqaqake'n suqqeexxi</para>
  <para style="q2" vid="PRO 31:19">seemmatanna ganda.<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />Hiyyeeyyetanna rakkiyye gargaartaan.<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />Isek mini hadi duuchchi eebbitaaxxa seemma afeemmaxxee'e</para>
  <para style="q2" vid="PRO 31:21">kaade gandoolenna midde sodaatabaan.<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />Taqete'n fayendaaxxa seemma giissitaan,</para>
  <para style="q2" vid="PRO 31:22">dhiille bifaxxa hujendeexxa eloxxa seemma oddo'witaan.<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />Aro'i isek bogiinxe geedhe giddo,</para>
  <para style="q2" vid="PRO 31:23">qachchinxe hula edo afolaaba ulfaateeke.<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />Fuutinxa seemmanna sabbata ganda'n,</para>
  <para style="q2" vid="PRO 31:24">daddaltuwwate'n gurgudhdhitaan.<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />Ise jabbaxxenna ulfaatte'exxe,</para>
  <para style="q2" vid="PRO 31:25">hegerinna gammadda'n hexxaan.<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />Haasotta wodda beekkumik haasottaan,</para>
  <para style="q2" vid="PRO 31:26">haaso'i iseki giddonna eloke gorsa hedheen.<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />Duuchchi wodda hujete'ni siite'e mini hado iseka uuddammaxxee'e,</para>
  <para style="q2" vid="PRO 31:27">haranga gonphe ise'ni leellitabaan.<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />Oose isexxi kexxee isee saaddaan,</para>
  <para style="q2" vid="PRO 31:28">Aro'i isekinna isee jaja'ni,<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />«Eloxxa assiteexxi heddo melaalle hexxeen,</para>
  <para style="q2" vid="PRO 31:29">ati kinni duuchchinxenaa'n saxxatton» hiyya.<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />Danchumma la'o affebaan, dhaggatinna ba'aachchon,</para>
  <para style="q2" vid="PRO 31:30">Duuchchi Woddika Gootta sodaattaxxi manjichcho kinni jajendaan.<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />Hujjeexxe huje duuchchi'a ise'a gicce,</para>
  <para style="q2" vid="PRO 31:31">assiteexxi isexxi elola yaanerinna isee manni giddo ulfeessituun.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>