<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOS" style="id">- Gedeo Bible</book>
  <para style="h">Iyyaasu</para>
  <para style="toc1">Iyyaasukaa Maxaafa</para>
  <para style="toc2">Iyyasukaa Maxaafa</para>
  <para style="toc3">Iya.</para>
  <para style="mt1">Iyyaasukaa Maxaafa</para>
  <para style="imt">E'yichcho</para>
  <para style="ip">Maxaafi Iyyaasuki Isira'eelik ardi Muuse'n aane'e moyemmake Iyyaasuxxe akeetteni hitta lole'e injifate Kanaanika boga abidee qico haasotaaxxa jirte abide'eke maxaafan. Konne Maxaafi giddo borreessenideexxe lumolla jirtuwwa giddii'ni umo umoke kaddeexxi: Yordaanoosike galaanixxi foofa, Iyyaarikkoke dalla'ixxi diigensha, Iyyi hinaake qachcha'ni lolleeke lolixxinna ardi Magenik welti aagemmaxxa kako haaronsedheexxa haasottaaxxen. Konne maaxafi giddo yo'oshsha ege'nendeexxi heddo bakkanaa'ni mitte «Hoone'e magenoonfatina'neexxa fi'le; aninna anki mini hadi kinni Duuchchi Woddika Gootta magenoonfanita'nonn» (24:15) hitaaxxe bakkan.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Kani'anike ardixxa injifatensha <char style="ior"><ref loc="JOS 1:1-12:24">1:1—12:24</ref> </char></para>
  <para style="io1">Bogiinxa qoodensha <char style="ior"><ref loc="JOS 13:1-21:45">13:1—21:45</ref> </char></para>
  <para style="io2">Yoridaannosike Galaani widdo hedheka boga <char style="ior"><ref loc="JOS 13:1-33">13:1-33</ref> </char></para>
  <para style="io2">Yoridaannosike Galaana'n dhidhimiidarre'ni hedheeka boga <char style="ior"><ref loc="JOS 14:1-19:51">14:1—19:51</ref> </char></para>
  <para style="io2">Danoti manijo shiyeeki manji baajaka qachchuwwa <char style="ior"><ref loc="JOS 20:1-9">20:1-9</ref> </char></para>
  <para style="io2">Leewike minike ardika qachchuwwa <char style="ior"><ref loc="JOS 21:1-45">21:1-45</ref> </char></para>
  <para style="io1">Roobeelike, Gaadikenna gamisa Minaaseke minike ardi boga ifikibaa higee qico <char style="ior"><ref loc="JOS 22:1-34">22:1-34</ref> </char></para>
  <para style="io1">Iyyaasu ardake'ni haaso'eka haaso'a <char style="ior"><ref loc="JOS 23:1-16">23:1-16</ref> </char></para>
  <para style="io1">Sekemi, haarooba Kako aangeqico <char style="ior"><ref loc="JOS 24:1-33">24:1-33</ref> </char></para>
  <chapter number="1" style="c" sid="JOS 1" />
  <para style="s1">Duuchchi Woddik Gootti Iyyaasu'u Ajaje</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 1:1" />Duuchchii woddik Gootti erganji Muuse reye uduma Duuchchi Woddik Gootti Muuseka erganjo Neeweka belto Iyyaasuu'u hiyyee qici, <verse eid="JOS 1:1" /><verse number="2" style="v" sid="JOS 1:2" />«Erganji anki Muuse reyedheen; atinna Isira'eelik ardi duuchchi kexxine ani ha'noo Isira'eelike ardi'aa uwwaanneke boga'ni e'yitino'aa Yordaanoosika Galaana foofattee qixxeefatte. <verse eid="JOS 1:2" /><verse number="3" style="v" sid="JOS 1:3" />Muuse'ni uwwenexxe addachiishanni ha'nooxxi lekka haxxaa booncho duuchcha ha'no'aa uwwannon. <verse eid="JOS 1:3" /><verse number="4" style="v" sid="JOS 1:4" />Ha'nooke bogixxi gabala qiilla gammoojjenaa'n Libaanoosi qico'ni, lumoka galaani Efiraaxisinaa'n Hiititotika boga duuchcha abideexxi dhidhimi darree'ni lumoxxe abbaayya qico geltaan. <verse eid="JOS 1:4" /><verse number="5" style="v" sid="JOS 1:5" />Hedhoti hexxeteke barro duuchcha'n ayyinna atee dande'aaba; Muusenni welti hedhennashshanni atinninna welt hedhannon; haranga atee waalabe'non; ate dedhabe'non.<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="DEU 31:6">Lan. 31:6</ref>, <ref loc="DEU 31:8">8</ref>; <ref loc="HEB 13:5">Ibr. 13:5</ref>. </char></note><note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="LEV 11:24-25">Lew. 11:24-25</ref>. </char></note><verse eid="JOS 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 1:6" />«Edike insa'neke annuwwi'a uwwonaa kakateennaka boga dhaallashsha konne arda akeekkaa'etek atete kaddeettaxxee jabaati, worbi.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="DEU 31:6">Lan. 31:6</ref>; <ref loc="DEU 7:23">7:23</ref>. </char></note> <verse eid="JOS 1:6" /><verse number="7" style="v" sid="JOS 1:7" />Atinni calli jabaati worbi anki garbichchi Muuse ate'ni uwweemmaka ajajuwwa duuchcha xexe'achchoti heqqedhi; me'itatoke booncho duuchcha'ni ati'a qajeldaashsha konne seerinaa'n middi bitta'i'anna higgoxxe. <verse eid="JOS 1:7" /><verse number="8" style="v" sid="JOS 1:8" />Kunni seeriink maxaafi atike afo'inaa'ni qo'oqqe'e; isi giddo borreessemeechcho duuchcha xexxe'achchoti heqqexxattoshsha iso'o alalchi; tenne assitottole heddettexxi ati'a wo'mitaan, qajeldaan. <verse eid="JOS 1:8" /><verse number="9" style="v" sid="JOS 1:9" />Martatoba duuchcha'n Duuchchi Woddik Gootti atik Mageni atinni welti hedhaammaxxee mee co'oo jabaati, ti'ni hiyyi, alaltoxxe culphisoxxe» hiyye atee ajajeenabaata?<verse eid="JOS 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 1:10" />Iyyaasunna ardiinka sooreesuwwa hiyyeexxi ajajee qici, <verse eid="JOS 1:10" /><verse number="11" style="v" sid="JOS 1:11" />«Kaanbe giddi'aa e'yitineexxi ardake'n hitinaa qici, ‹Gala'atanna qixxeeffatte; ta'anaa'n saffinne sase barra giddo Yordaanoosii'i fooffinaan; Duuchchi Woddik Gootti ha'nook Mageni ha'no'aa uwwaaka qadaada dhaaldinaan› hiyyi» hiyye.<verse eid="JOS 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 1:12" />Iyyaasunna Roobeelika Gaadikanna gamisa Minaaseka gosati minika arda hiyyee qici, <verse eid="JOS 1:12" /><verse number="13" style="v" sid="JOS 1:13" />«Duuchchii woddik Gootti ha'nook Mageni ‹Konne boga ha'no'aa uwweexxi ha'noo hafuura adhdhisaan› hiyyeexxi erganji Muuse Ookkonne boga ha'no'aa uwwanno hiyya'ni ha'noo ajajeemmaka ookkonne ajaja qalli hiyyee. <verse eid="JOS 1:13" /><verse number="14" style="v" sid="JOS 1:14" />Aruwwa ha'nooxxinna oose ha'nooxxi, iittanni hori ha'nooki Muuse ha'no'aa uwweeke Yordaanoosi'ni dhidhimii darreke boga'ni ookkoo he'nowwaali; yaane kinni ha'nook loliink manni duuchchi lolake'e ka'lineemmake miyininni ha'nooke dayyuwwi'a edinse foonfowwaal. Ha'noonna ha'nooke dayyuwwa'ni aandine'e fooffe; insa'nenne gargaarre. <verse eid="JOS 1:14" /><verse number="15" style="v" sid="JOS 1:15" />Duuchchii woddik Gootti ha'noo ti'ni asseemmashshanni dayyuwwa ha'nooka ti'ni assaa qico'ni insa'nenna kinni Duuchchi Woddik Gootti ha'nook Mageni insa'ne'aa uwwaaka boga dhaala qico'niten. Ookkoneechchi uduma ha'noonna higgineexxi Duuchchi woddike Goottiki erganji arishsho fuldaamma darre'ni Muuse ha'no'aa uwweeka Yordaanoosinaa'n boroti darre'n hedheeka boga dhaaldinaan» hiyye.<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="NUM 32:28-32">Lak. 32:28-32</ref>; <ref loc="DEU 3:18">Lan. 3:18</ref>; <ref loc="JOS 22:1-6">Iya. 22:1-6</ref>. </char></note><verse eid="JOS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 1:16" />Inisa'nenna Iyyaasu'n hineexxi hiisinee qici «Ati no'o'aa ajajeettexxa duuchcha assinannon; no'oo eriggitattobaa duuchcha marrannon. <verse eid="JOS 1:16" /><verse number="17" style="v" sid="JOS 1:17" />Muuse'a duuchchiinxenni ajajemmeenneshsha ati'aanna ajejemmannon; Duuchchi Woddik Gootti atik Magni calli Muusenni hedhemmashsha ta'anna atinninna welt hedhuun. <verse eid="JOS 1:17" /><verse number="18" style="v" sid="JOS 1:18" />Atike ajaja'n jallataakinna atike hiyyichchi'a ajajemabaak duuchchi shiyemowwaal; atinni calli worbi, meeco'o jabaati!»<verse eid="JOS 1:18" /></para>
  <chapter eid="JOS 1" />
  <chapter number="2" style="c" sid="JOS 2" />
  <para style="s1">Ra'aabinna Isira'eelixxa Colibaleeyye</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 2:1" />Ookkoneechchi uduma Neewek belti Iyyaasu «Martineexxi ookkenee bogika Iyyaarkoka qachcha dooyye» hiyyeexxi Seeximinaa'n lame colibaleeye sho'ik erge; iikki maninna mareexxi Re'aabi hiyyendaaxxe yabaabulto manjichchoke mine'ni e'yine ookko galle.<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="HEB 11:31">Ibr. 11:31</ref>; <ref loc="JAS 2:25">Ya'i. 2:25</ref>. </char></note> <verse eid="JOS 2:1" /><verse number="2" style="v" sid="JOS 2:2" />Iyyaarikoke moyanjo'ni «Kunse konne boga dooyate'e heenoxxi Isira'eelito hashsha kabaa dagge'een» hiyyende iso'ni kulende. <verse eid="JOS 2:2" /><verse number="3" style="v" sid="JOS 2:3" />Iyyaarikok moyanjinna «Atiba dageexxi mine e'yeeki manni konne boga duuchcha dooyyo'a dageemmaxxe insa'ne'e mine atikenaa'ni fulchitattosha» hitaaxxa erga Re'aabibaa erge.<verse eid="JOS 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 2:4" />Yaane kinni iitti manjichcho ookkone lame manna shoxxe'emmaxxee hitee qici, «Dhugaaten iikki manni anba dage'en; yaane kinni insa'ne habaa'n dangeexxa ege'nbe'no. <verse eid="JOS 2:4" /><verse number="5" style="v" sid="JOS 2:5" />Bogi dukkaneexxi dalla'iinxi hula cefendeba ediga'ma iikki manni fulleexxi me'ineen; hoone darre'ni me'ineexxa ani kinni ege'nebe'no; insa'ne dhaqqabbinaan rakkine hordoffe.» <verse eid="JOS 2:5" /><verse number="6" style="v" sid="JOS 2:6" />Yaane kinni ise ookkone manna dagamati iima sa'isiteexxi tuulde'emmake darga'i giddo insa'ne shoxxe'emman. <verse eid="JOS 2:6" /><verse number="7" style="v" sid="JOS 2:7" />Manikinna colibaleeyye hordofiyyoti Yordaanoosi foossammaka ora abinde me'ine; iikki shorrammak manninni fule me'eeshshanni dalla'iinxi hula cufende.<verse eid="JOS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 2:8" />Colibaleeyye iitti diiphpheba edi darre, manjichchotinna dagamati iima saxxeexxi <verse eid="JOS 2:8" /><verse number="9" style="v" sid="JOS 2:9" />insa'ne hitee qici, «Duuchchi Woddik Gootti konnee boga ha'no'a uwweexxa, ha'no sodaachchise no'oo'n daggemaxxe konne bogik manni duuchchi ha'noo edo alayyik qexxirri hiyyeexxa ege'ne'eneni; <verse eid="JOS 2:9" /><verse number="10" style="v" sid="JOS 2:10" />Gibtseke bogana'ni fuldinee wodda, Duuchchi woddik Gootti diimmoxxa Abaayya ha'noo edo hitta basseexxa, ha'nonna Yordaanoosii'n borroti darre'n hedhemmaka birtineeka ookkone Amooritotika lame moyanjjuwa Siihooni'ninna Oogi'n maa assitineexxa lanqenneni.<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="EXO 14:21">Fula. 14:21</ref>; <ref loc="NUM 21:21-35">Lak. 21:21-35</ref>. </char></note> <verse eid="JOS 2:10" /><verse number="11" style="v" sid="JOS 2:11" />Duuchchii woddik Gootti ha'noon Mageni ale iimate'n butta buttate'n Magnoke kadeemmaxxee tenne laqqene wodda alane qexerinene; ha'no soda'atenaa'n kexxeexxa culphisebaak manji hedhemabaan. <verse eid="JOS 2:11" /><verse number="12" style="v" sid="JOS 2:12" />Yoona ani ha'no'aa eloxxa assenshanni ha'noonna anke anike mini hadi'aa eloxa assitino'a ani'a kakatte. Adatemaaka beesisanna ani'a uwwe. <verse eid="JOS 2:12" /><verse number="13" style="v" sid="JOS 2:13" />Anxe amaxxanna anke anxa anke dayyuwixxanna dayyuwwaxxa iittan insa'ne kadeeke manji duuchchixxa lubbo gatisino'a no'o'o reyotenaa'n anjire.»<verse eid="JOS 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 2:14" />«Mannikinna isee ha'nooxxa bakka no'o renno» no'o assinanoxxa duuchcha «Kula gophphinoole Duuchchi Woddik Gootti konne boga no'a uwwa wodda ati'a eloxxa assine addatensha no'oxxa leelinnshannon» hiyye.<verse eid="JOS 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 2:15" />Isenna hexxa'emmak mini qachchiinke dalla'in maxxaneeke kadeemmaxxe manna masikootetinnaa'ni wodaroti dirrisse. <verse eid="JOS 2:15" /><verse number="16" style="v" sid="JOS 2:16" />Isenna insa'ne'e, «Ha'noo shorra'neek manni afabaashsha ookkone tullichchibaa martineexxi insa'ne illee iima hingaa qico'ni sase barra ookko sho'omme; ookkoneechchi uduma ora ha'nooka me'itinaan» <verse eid="JOS 2:16" /><verse number="17" style="v" sid="JOS 2:17" />Mannikinna ise'e, «No'oo kakachchiissetaxxi kako no'a abidaabaashsha <verse eid="JOS 2:17" /><verse number="18" style="v" sid="JOS 2:18" />Kunse, no'oo ookkone bogibaa e'yinenne wodda konne diimoka dhiile seema ati no'oo dirrisetexxe masikoote darree'ni usuri; anna atikanna ama atixxa labbaxxa dayyuwwa dubara dayyuwwa atika anna atikikka mini hado duuchcha atike minibaa bukki assei. <verse eid="JOS 2:18" /><verse number="19" style="v" sid="JOS 2:19" />Ayyinna atike mininaa'ni fuleexxi orake'n afemoole munde ifixxe isonde qorema; isixxe no'oo e'yishaachchi hedhebaan; yaane kinni atinni welt mine hedhemmak manninaa'ni mittikinna tuqemoole munde isixxe no'o qoremmannon. <verse eid="JOS 2:19" /><verse number="20" style="v" sid="JOS 2:20" />Yaane kinni no'oo assinannoxxa duuchcha kuldettexxe kaddoole tinni kako no'o abidabaan» <verse eid="JOS 2:20" /><verse number="21" style="v" sid="JOS 2:21" />Isenna, «Hitineeshshanni kadduni» hite «hiissite haasotte» tennexxee insa'ne me'inaashsha assite'na'a insa'nenna me'ine; isenna diimooka shimala masikootete'n rarraasse.<verse eid="JOS 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 2:22" />Insa'nenna tullichchuwwiba genne, insa'nee shorrammak manni ora duuchcha'n hase gopheexxi illee iima hingaa qico'ni sase barra ookko turre. <verse eid="JOS 2:22" /><verse number="23" style="v" sid="JOS 2:23" />Iikki lamiinxi colibaleeyye illee iima higge; tullichuwwakenaa'n dirriteexxi galaana foofiyyoti Neeweka belto Iyyaasubaa dangeexi insa'ne'n kaddeexxa yaane duuchcha iso'n haasone. <verse eid="JOS 2:23" /><verse number="24" style="v" sid="JOS 2:24" />Insa'nenna Iyyaasu'n «Dhugaaten, Duuchchi Woddik Gootti ookkonee booga duuchcha no'oxxe anga'n sa'ise uwwedheen; ookkone boga'n hedheeke manninna no'o sodaatatenaa'n kexxeexxa alayyik qexerri hiyyedheen» hine.<verse eid="JOS 2:24" /></para>
  <chapter eid="JOS 2" />
  <chapter number="3" style="c" sid="JOS 3" />
  <para style="s1">Isira'eelito Yoridaanoosi'i Fooffe</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 3:1" />Gorsa Iyyaasunna Isira'eel ardi duuchchi Seeximii'n ke'eexxi Yordaanoosi'a dangeexxi foonfebaang ookko galle. <verse eid="JOS 3:1" /><verse number="2" style="v" sid="JOS 3:2" />Sase barra udduma Isira'eelike ardik ja'laabuwwi kaanbe giddi'a marreexxi <verse eid="JOS 3:2" /><verse number="3" style="v" sid="JOS 3:3" />arda hineexxi ajanjee qici, «Leewwito qeese Duuchchi Woddika Gootta ha'noke Mageniinka taaboota dukkeexxi ke'e'na uudinaa wodda kaanbe giddii'n fuldineexxi taabota hordoffe. <verse eid="JOS 3:3" /><verse number="4" style="v" sid="JOS 3:4" />Konnechchi edo ookkone ora me'itine ege'na gophphineemmaxxe habaa me'iyyo hassissaaxxa ookko egendinaan.»<verse eid="JOS 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 3:5" />Iyyaasunna arda, «Duuchchi woddik Gootti soodo ha'nooxe oddo'ni masso ifi qulloonse» hiyye. <verse eid="JOS 3:5" /><verse number="6" style="v" sid="JOS 3:6" />Iyyaasunna qeese, «Kakotika taabota dukkineexxi ardi edo sa'we» hiyye. Insa'nenna taabota dulkineexxi ardi edo sa'ne.<verse eid="JOS 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 3:7" />Duuchchi woddik Goottinna Iyyaasu'u, «Muusenni welti hedhennasha atinni welti hedhennexxa ege'no'a telcho Isira'eeliki ard edo atee lummisa safanenni. <verse eid="JOS 3:7" /><verse number="8" style="v" sid="JOS 3:8" />Kakotika taaboota dukkaaxxa qeese, ‹Yordaanoosika gaalana geltina wodda wodi'i giddo e'itine uurre› hite kuli.»<verse eid="JOS 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 3:9" />Iyyaasunna Isira'eelika arda, «kaba'a shikk hitineexxi Duuchchii woddik Gootti ha'nok Mageni hiyya'neexxa laqqe» hiyye. <verse eid="JOS 3:9" /><verse number="10" style="v" sid="JOS 3:10" />Iyyaasunna lebeexxi, «Hedhaak Mageni han'ooonni welt hedheexxa egendinaashsha Kenaanito, Hitaawito, Hiitito, Feeriizito, Gergerisiito, Amooritonna Iyyaabusito bogakenaa'n shorraan. <verse eid="JOS 3:10" /><verse number="11" style="v" sid="JOS 3:11" />Kunse butta duuchchike Duuchchi Woddik Goottik kakotik taabootta ha'no'a ediseexxi Yordaanoosika galaana e'yaan. <verse eid="JOS 3:11" /><verse number="12" style="v" sid="JOS 3:12" />Yoona Isira'eelixxe gosatike mininaa'ni tommena lame manjo melle. <verse eid="JOS 3:12" /><verse number="13" style="v" sid="JOS 3:13" />Butta duuchchik Duuchchi Woddike Goottik kakotika taabota dukkeexxi qeesexxi lekka Yordaanoosika galaana haxxeeshshanni adade yaa'amak wedi'i kutemaan; tuulotishshanna kadeexxi uuraan.»<verse eid="JOS 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 3:14" />Tennexxee Isira'eelik ardi Yordaanoosi'i foofo'a kaanbe giddii'n fulaa wodda kakotika taaboota dukkemmaxxi qeesole ardi edo me'ite. <verse eid="JOS 3:14" /><verse number="15" style="v" sid="JOS 3:15" />Itti yanna midha bukki asseccatixxe yanna kaddemmaxxee, Yordaaanoosiki galaaninna dageemmani; kakotika taaboota dukkeemaxxi qeesole Yordaanoosika galaana gelte wodda lekka insa'nexxi galaana tuqqeeshanni, <verse eid="JOS 3:15" /><verse number="16" style="v" sid="JOS 3:16" />alee'ni yaa'ammak wedi'i uurre; Tsartaani bira Addaami hiyyemaake bayike qachchii qico'ni tuuleme tullubeme; adadde Areebaxxe Maxinetixxe Abbaayyabaa<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">Rerteexxe Abbaayyan</char></note> ya'ammak wedi'inna kuteme; ardikinna Iyyaarikoke kallachchi darree'n foofe. <verse eid="JOS 3:16" /><verse number="17" style="v" sid="JOS 3:17" />Duuchchi Woddike Goottika taaboota dukkeemaxxe qeesole ardi duuchchi kuninna Isira'eelito duuchchi fooffe luggitaa qico'ni Yordaanoosike galaannixxe oddo'ni bago buttina'n uuriteemman.<verse eid="JOS 3:17" /></para>
  <chapter eid="JOS 3" />
  <chapter number="4" style="c" sid="JOS 4" />
  <para style="s1">Qaabete'e Uurrisexxa Kino</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 4:1" />Ardi duuchchi Yordaanoosii'i foofechchi uduma Mageni Iyyaasuu'u hiyyee qici, <verse eid="JOS 4:1" /><verse number="2" style="v" sid="JOS 4:2" />«Ardi giddii'n gosatike mini mininaa'n mitte mitte manjo duuchching mitteba tommenna lame manna melli <verse eid="JOS 4:2" /><verse number="3" style="v" sid="JOS 4:3" />Iittanni Yordaanoosike galaanixxe oddo'ni ookkone qeesole uurritemabaa'n tommena lame kinno aa'ne dunke ha'noo'ni welt foonfeexxi dokko galdinaaxxe bakka'n ugginaashsha ajaji.»<verse eid="JOS 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 4:4" />Iyyaasunna mitte mittenge Isira'eelike gosatike mininaa'n baallonsemaka tommena lame manna ye'e. <verse eid="JOS 4:4" /><verse number="5" style="v" sid="JOS 4:5" />Insa'neena hiyyee qici, «Duuchchii woddik Gootta hanooke Mageniinke kakotike taabooti edo saxxineexxi Yordaanoosike galaanixxe oddoba'a sa'we; mitti mitti ha'no'nig Isira'eelike gosatike minike laakkosixxe qixxe'n mitte mitte kinjo dugumoote'n dukke. <verse eid="JOS 4:5" /><verse number="6" style="v" sid="JOS 4:6" />Kunninna ha'no giddo beessisake kado'aten; heger ha'nooxxi oose ‹Tinni kino mayiinxe?› Hite ha'no qortoole, <verse eid="JOS 4:6" /><verse number="7" style="v" sid="JOS 4:7" />Yordaanoosik galaan Duuchchi woddike Goottike kakotike taabooti edo uurreexxa, iittanni taaboti Yordaanoosika galaana foofa wodda Yordaanoosik galaanike wodi'i uureexxa, tinni kino Isira'eelike ardi'a duuchchi woddixxe qalli kaddeexxa insa'ne'ni kulle.»<verse eid="JOS 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 4:8" />Isira'eeltotinna Iyyaasu inisa'ne ajajemmashshanni assitte; Duuchchi woddik Gootti Iyyaasu'ni kulemma qicinni Isira'eelike gosati minike laakossuwwixxe qixxe'n tommena lame kino Yordaanoosike galaani giddii'n aaxxeexxi hexxammaxxe kaanbeba'a aaxxe foofiyyot ookko uggite. <verse eid="JOS 4:8" /><verse number="9" style="v" sid="JOS 4:9" />Iyyaasunna kakotika taaboota dukkammaxxa qeesole uurite hexxemmabba Yordaanoosike galanixxe oddo'ni wele tommena lame kino uurisse; tinni kinonna telchiqico'n eetene bakka'ninn hexxeen.<verse eid="JOS 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 4:10" />Muusenna Iyyaasu'n uwwemmake ajajishsha Duuchchi woddik Gootti arda'n kulaashsha Iyyaasu'u ajajemmaxxi muuxendaa qioc'ni taaboota dukkeemmaxxi qeese Yordaanoosike galaanixxe oddo'ni uurrite turte; ardikinna rake foofe.<verse eid="JOS 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JOS 4:11" />Ardi duuchchi foofe luggeeshshanni Duuchchi woddike Goottik taabootinna iitti qeese ard insa'ne'e uuda'naa foonfe. <verse eid="JOS 4:11" /><verse number="12" style="v" sid="JOS 4:12" />Roobelike gosati minikinna Gaadike gosatik mini gamisa Minaasek gosatik mini Muuse insa'ne ajajemmashshanni ifika loliinka miya adhdhineexxi ardakee arda edinse foonfe. <verse eid="JOS 4:12" /><verse number="13" style="v" sid="JOS 4:13" />Shoole tomme kuma kadaak bagedokanna wonte ifixxa adhdhineexxi lolatee qixxeefanteexxi Duuchchi woddik Gootti edo Iyyaarikoke diidibaa foonfe. <verse eid="JOS 4:13" /><verse number="14" style="v" sid="JOS 4:14" />Eettene barra'n Duuchchi woddik Gootti Iyyaasu'u Isira'eelike ardi edo duuchhca iso'o lumise; ardikinna Muuse ulfeesammashshanni Iyyaasunna hedho isixxike baaro duuchcha'ni ulfeesine. <verse eid="JOS 4:14" /><verse number="15" style="v" sid="JOS 4:15" />Ookkoneechchi uduma Duuchchi woddik Gootti Iyyaasu'u hiyyee qici: <verse eid="JOS 4:15" /><verse number="16" style="v" sid="JOS 4:16" />«Dhugaa kulatika taaboota dukkeexi qeese Yordaanoosike galaananaa'ni fuldaashsha ajaji» hiyye. <verse eid="JOS 4:16" /><verse number="17" style="v" sid="JOS 4:17" />Iyyaasunna qeese «Yordaanoosik galaananaa'n fulle» hiyye ajaje. <verse eid="JOS 4:17" /><verse number="18" style="v" sid="JOS 4:18" />Qeesetinna Duuchchi woddike Goottika kakotika taaboota dukkeexxi Yordaanoosike galaani giddii'ni fuliyyoti lekka insa'nexxi bago buttina tuqqeeshshanni Yordaanoosiki galaan bakka ifixxe'ni illeema hige; eddixxa ifixxa bakka wo'me yaa'ate'n ke'e.<verse eid="JOS 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 4:19" />Siretik agenjixxe tommixxe barra'ni ardi Yordaanoosi'i foofeexxi Iyyaarikoke qachchanaa'n boroti darre'n Geligeela kaanbe olte. <verse eid="JOS 4:19" /><verse number="20" style="v" sid="JOS 4:20" />Iyyaasunna Yordaanoosike galaana'n aadhdhemmaxxa tommena lame kino Geligeela kaase. <verse eid="JOS 4:20" /><verse number="21" style="v" sid="JOS 4:21" />Isira'eelika ardanna hiyyee qici, «Heger oose ha'nooxi, ‹Tinni kino mayiinxesi?› Hiteexxi annuwwa ifika qortoole, <verse eid="JOS 4:21" /><verse number="22" style="v" sid="JOS 4:22" />‹Isira'eelik ardi Yordaanoosi'i bago buttii'ni fooffeen› hitine insa'ne'ni kulle. <verse eid="JOS 4:22" /><verse number="23" style="v" sid="JOS 4:23" />No'o foonfano qico'ni Duuchchi woddiki Gootti ha'nok Mageni diimmoxxa abbaayya basseemmashshanni ha'noonna fooffinaa qico Duuchchi Woddik Gootti ha'nook Mageni Yordaanoosika galaana ha'no edo basseen. <verse eid="JOS 4:23" /><verse number="24" style="v" sid="JOS 4:24" />Tennee asse'elchchi Duuchchii woddike Goottixxi hirre jabaxxe kaddeexxa buttattike arduwwi duuchchi ege'naashshanna Duuchchi woddika Gootta ha'nooka Mageno sodaatinaashshaten.»<verse eid="JOS 4:24" /></para>
  <chapter eid="JOS 4" />
  <chapter number="5" style="c" sid="JOS 5" />
  <para style="s1">Gelgela Assendeexxa Jila Ofo'la</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 5:1" />Eettene yanna Yordaanoos wido dhidhimi darre'ni hedhammak Amooritotik moyanjuwwi duuchchi eettene abbaayyake qarqara'ni hedhammak Kenaanitotik moyanjuwwi duuchchi Duuchchi woddik Gootti Yordaanoosi foonfano qico ookkone galaana Isira'eelike ardi edo hitta basseexa lanqe wodda alayyik qexxerrine; Isira'eelitotanna ifinaa'n hoyyedhatixxa onna gonphe; <verse eid="JOS 5:1" /><verse number="2" style="v" sid="JOS 5:2" />Eettenne yanna'ni Duuchchi Woddik Gootti Iyyaasu'u «Qaraxxa cabbe aaxxe jila ofoldebaaxxa Isira'eelito higeenna jila ofo'lish.» <verse eid="JOS 5:2" /><verse number="3" style="v" sid="JOS 5:3" />Iyyaasunna qaraxxa cabbe aadheexxi jila ofo'latike tullichcha hiyyemmammaba Isira'eelito jila ofo'lishshe. <verse eid="JOS 5:3" /><verse number="4" style="v" sid="JOS 5:4" />Iyyaasu Isira'eelto jila ofo'lisheexxi buuto Gibtsee'ni fuleek lolakee geyeek laballi duuchchi Gibtse'n fulchi uduma orake'ni qiilla gammoojje giddo rennemmaxxeeten. <verse eid="JOS 5:4" /><verse number="5" style="v" sid="JOS 5:5" />Ookkone fuleek ardi duuchchi jila ofo'lemmani; Gibtsee'n fulleechchinni uduma gammooji qiili giddo me'ate'ni he'neena'a ilemeek kinni jila ofo'leemabaan. <verse eid="JOS 5:5" /><verse number="6" style="v" sid="JOS 5:6" />Duuchchi Woddik Gootti no'o'a uwwo'a annuwwa insa'neke kako aagemmaxxa konne ado buuriinka boga uundabaashsha kakatemaxxee Gibtsee'ni fulee wodda lolake geyeemmaki labbali duuchchi, Duuchchi woddike Gootti'a ajajema gophemmaxxe insa'ne renne mundaa qioc'ni Isira'eelito gammoojje qiilli giddo shoole tomme wogga jeekina'nemman.<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="NUM 14:28-35">Lak. 14:28-35</ref>. </char></note> <verse eid="JOS 5:6" /><verse number="7" style="v" sid="JOS 5:7" />Tennexxe bakka'ni insa'exxa labbaxxa oose ke'ise; me'ate'n he'neemma wodda jila ofo'laa gonpheemmaxxee shoggoringimi he'nemman; konneerra Iyyaasu jila ofo'lishe. <verse eid="JOS 5:7" /><verse number="8" style="v" sid="JOS 5:8" />Ardi duuchchi jila ofo'leechchi udumi'a mada fayyitaa qico ookkoo he'nemmaxxe kaamebe giddo turre.<verse eid="JOS 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 5:9" />Ookkoneechchi uduma Duuchchi woddik Goottinna Iyyaasu'u, «Techcho Gibtseke bogika salphinne atenaa'ni goggo'misheenen» hiyye. Tennena'ni kexxeexxa ookkone boonchiki summi telchi qico'ni Geligeela<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">Ibrititotike laagadinni Geligeela hiyyaak ye'inji goggo'ma yookaan fugguseen hiyyake hiyyichchinni welti mitteken.</char></note> hiyyeme.<verse eid="JOS 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 5:10" />Isira'eelito Iyyaarikoke diida'n Geligeela kaambe oltite hexxeena'a ookkone agenjixxe tommena shoolgaxxe barraxxe hashsha sa'atika ayyaana ulfeesine. <verse eid="JOS 5:10" /><verse number="11" style="v" sid="JOS 5:11" />Sa'atike ayyaan uduma eetteneen barra ookkone bogixxa gumma tinninna gamami eeyyebaaxxa kebbonna kossemeeka tisha inde. <verse eid="JOS 5:11" /><verse number="12" style="v" sid="JOS 5:12" />Ookkone bogixxa gumma indeexxa barra menni uurre; ookkoneechchi uduma Isira'eelitotee menni uwwemeba'a; yaane kinni eettene wogga Kenaanike bogixxa gumma inde.<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="EXO 16:35">Fula. 16:35</ref>. </char></note><verse eid="JOS 5:12" /></para>
  <para style="s1">Iyyaarkoxxa Iba</para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 5:13" />Iyyaasu Iyyaariko bira hedheexxi tamasse uudaa wodda wolaantichcha abixxeek mitti dargaggeess isi edo uure'naa afe; Iyyaasunna isiba'a shiqeexxi, «Ati no'oxe gamo moo yookaan naaphiinxe?» Hiyye iso'o qore. <verse eid="JOS 5:13" /><verse number="14" style="v" sid="JOS 5:14" />Isinna, «Waawo'o ani Duuchchi Woddike Goottike sannachike akeekisanjo kadennaxxee kunse dage'ennen» hiyyeexxi iso'n hiise haasoe'e.</para>
  <para style="p" vid="JOS 5:14">Iyyaasunna albik butta gonbiseme sagadeexxi iso'o, «Anke gootta ane'e atike erganji'a maa erga affe'ette?» Hiyye.<verse eid="JOS 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 5:15" />Duuchchi Woddike Goottike Sannachik sooresinna Iyyaasu'u, «Urriteettexxi bakka woyyittete kaddeemmaxxee kophe atixxa lekkatenaa'n fulchedhi» hiyye; Iyyaasuna ajajemmeemmashanni asse.<verse eid="JOS 5:15" /></para>
  <chapter eid="JOS 5" />
  <chapter number="6" style="c" sid="JOS 6" />
  <para style="s1">Iyyaarkoxxa Iba</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 6:1" />Ookkone wodda Isira'eelito soda'atenaa'ni kexxeexa Iyyaariko jaba qicinni cufendeemman; gadhi'anna kadi giddi'a e'yaammak manji hedhemmabaan.<verse eid="JOS 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 6:2" />Duuchchi woddik Goottinna Iyyaasu'u hiyyee qici, «Kunse ani Iyyaariko isek moyanjinna iseke loliinke manninnaa'ni anga atixxe'ni sa'issee uwwe'enen. <verse eid="JOS 6:2" /><verse number="3" style="v" sid="JOS 6:3" />Konne qachcha ha'nooke loliinke manni welt mittele dowwe; tennenna jaane barra asse. <verse eid="JOS 6:3" /><verse number="4" style="v" sid="JOS 6:4" />Torbaane qeese torbaane malagata abixxiteexxi taabooti edo saxxowaal; torbaxxe barra'ni qeese malagata ufuufa'ni ookkone qachcha torbaanele dootowaal; <verse eid="JOS 6:4" /><verse number="5" style="v" sid="JOS 6:5" />Uurabeloka malagatiik hafuura laqqinaa wodda ardi duuchchi hafuura gikki asse raarrowwaal; ookkoneechchi uduma ookkene qachchik dalla'i diigemaan; ardikinna alallee qabataan; mitti mitting manji hedhe hedhemmabaa'ni giddi'a e'yowaal.»<verse eid="JOS 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 6:6" />Neewek belti Iyyaasu qeese ye'eexxi insa'nee hiyyee qici «Kakotika taaboota dukke; torbaane qeese torbaane malagata a'liteexxi Duuchchi Woddike Goottike taabooti edo me'itowaal» hiyye <verse eid="JOS 6:6" /><verse number="7" style="v" sid="JOS 6:7" />Ardakanna, «Edi'a sa'we; qachchakanna dowwe; ka'leek loliiki manninna Duuchchi Woddike Goottike taaboti edo me'inowaal» hiyye ajaje.<verse eid="JOS 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 6:8" />Iyyaasunna ardake'n haaso'eechchi uduma iitti torbaane qeese Duuchchi Woddike Gootti edo torbaane malagat abixxiteexxi ifiifika malagata ufuuffa'ni edo sa'ne; Duuchchi Woddike Gootti kakotike taabootinna insa'ne hordofe. <verse eid="JOS 6:8" /><verse number="9" style="v" sid="JOS 6:9" />Ka'leek loliink manni malagata ufuuffaaxxe qeese edo sa'e me'a wodda kiphake kadeek heqanjuwwi kinni taaboota hordonfe; eettene yanna duuchcha'ni malagati uurabelo ufuuffema'nemman. <verse eid="JOS 6:9" /><verse number="10" style="v" sid="JOS 6:10" />Iyyaasunna arda, «Bararasatixxa raare raartinoqqe'e; hafuura ha'nookanna gikki assitinoqqe; ani raare hiyyannoxxee barra qico'ni afo'o hanookenaa'ni mittechchonna bucuqqi hitinoqqe; raartinaak ookkoneechchi uduman» hiyya'ni ajaje. <verse eid="JOS 6:10" /><verse number="11" style="v" sid="JOS 6:11" />Tennexxe Iyyaasu Duuchchi Woddike Goottika taabota dulike'nnexi ookkone qachcha mittele doonashsha asse; ookkoneechchi uduma ardi kaanbetibaa illee iima higgexxi gale.<verse eid="JOS 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 6:12" />Iyyaasunna langa baro bariisa ke'e; qeesetinna Duuchchi woddike Goottika taaboota dukke. <verse eid="JOS 6:12" /><verse number="13" style="v" sid="JOS 6:13" />Iitti torbaane qeese torbaane malagata abixxiteexxi Duuchchi Woddike Goottike torbbaane qeese malagate ca'lite ufuuffa'ni Magenike taabooti edo me'ita'n malagata uurrisabelo ufuuffate'n kexxe; ka'leek loliink manninna insa'ne'e edii'n mei'na wodda kiphi heqanjuwwi kinni Duuchchi Woddike Goottika taaboota hordonfa'nemman; itti qeesenna uurrisabelo malagata ufuuffa'nemman. <verse eid="JOS 6:13" /><verse number="14" style="v" sid="JOS 6:14" />Tenne langaxxe barra'ni qachcha mittele dooneechchi uduma kaanbe'a illeema hinge; jaanne barra duuchcha iitta assine.<verse eid="JOS 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 6:15" />Torbaxxa barra reefi boro haachchaba wodda ke'neexxi, edi woddishshanni ookko qachcha torbaanele doone; ookkone qachchanna torbaanele dooneek eettene barra callamman. <verse eid="JOS 6:15" /><verse number="16" style="v" sid="JOS 6:16" />Torbaxxe dowwe'n qeese malagata ufuufaa wodda Iyyaasu arda hiyyeexxi ajajee qici, «Duuchchi Woddik Gootti konne qachcha hano'a uwwedheen raarre! <verse eid="JOS 6:16" /><verse number="17" style="v" sid="JOS 6:17" />Qachchakanna isi giddo hedheechcho duuchchi Duuchchi Woddike Gootti'a foyemeeke kademmaxxe ijenda balleesse; no'o erginennexxa colibaleeyye shoxxemmaxxe eettene yababulto Re'aabii callanna isenni welti iseke mine'ni hedheek calli lubbo gattowaal. <verse eid="JOS 6:17" /><verse number="18" style="v" sid="JOS 6:18" />Ha'noo kinni okkone hoyyemeechchinaa'n mittechcho adhdhitineexxi umo ha'nooke'n ba'ne idaqitinabaashsha ifi heqqedhdhe; kadagophoole Isira'eelixxe kaanbe'ni ba'ne geltaaxxe assitinaan; fuggoxxa yaanenna ise'ni iyyedagginaan. <verse eid="JOS 6:18" /><verse number="19" style="v" sid="JOS 6:19" />Iikki birretike sibiljininna worqe iittanni sageettotik sibiljinna sibliink miyuwwi duuchchi Duuchchi Woddike Gootti'a woyyomeeke kadeemmaxxee isike miya massatike mi'ne'n aagowaal» hiyye ajaje.<verse eid="JOS 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 6:20" />Malagata ufuufemaa wodda ardik raarre; malagatiinka hafuuraa laqeexxi ardi hunnati raara wodda dalla'i diigeme; mitti mitting manji hedhemmabaa'ni giddi'a e'ye; iikki qachchinna anga insa'nexxe'n ibe. <verse eid="JOS 6:20" /><verse number="21" style="v" sid="JOS 6:21" />Ookkone qachchi giddo hedheechchi duuchchi kunninna labbakana, meyaka geedhenna ka'uma lalokanna gedhebo ittanni harre wolaantichchi kutti assine.<verse eid="JOS 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 6:22" />Iyyaasunna ookkonee boga dooyyemmaka lame manna, «Etene yabaabulto manijichchoka mine mare; ise'a assitino'a kakatineemmashshanni isenna isecho kadeechcho duuchcha ookkone'ninna fulche» hiyye. <verse eid="JOS 6:22" /><verse number="23" style="v" sid="JOS 6:23" />Tennexxe lame ka'umi colibaaleyye e'yiteexxi Re'aabii'i anna isekanna ama isexxa iseka dayyuwwanna iseke kadeeka duuchcha ookko'n fulchine; iseka fira duuchcha fulchineexxi Isira'eelitotixxe kaanbe gadho uggine.<verse eid="JOS 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 6:24" />Ookkoneechchi uduma ookkone qachchanna giddo hedhemmachcho duuchcha gunbe; birretike sibiljinna worqqe sageettotike sibiljonna sibliinka miya Duuchchi Woddik Gootti miya massatike mi'ne'n uggurre. <verse eid="JOS 6:24" /><verse number="25" style="v" sid="JOS 6:25" />Iyyaariko dooyyinaashsha Iyyaasu ergemmaka manna shoxxemmaxxe eettene yabaabulto Re'aabi iseka mini hadonna iseke kadeeka duuchcha gatinse isenna techchi qico'ni Isira'eelitotixxe oddo'ni hexxeen.<verse eid="JOS 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JOS 6:26" />Ookkonne wodda Iyyaasu hiyya'n kakatee qici; Konne Iyyaarkoka qachcha illee iima hiisseexxi ijaaraak Duuchchi Woddik Gootti edo isi badinemmeeka kadowaal:</para>
  <para style="q1" vid="JOS 6:26">«Isi booso isixxa safa wodda,</para>
  <para style="q2" vid="JOS 6:26">isikk angaf beltinna ba'owaal;</para>
  <para style="q1" vid="JOS 6:26">Dalla'a isika jaaraa wodda,</para>
  <para style="q2" vid="JOS 6:26">maa'nichchi isik beltinna ba'owaal» hiyye kakate.<verse eid="JOS 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JOS 6:27" />Tennexxe Duuchchi Woddik Goottinna Iyyaasunni welt hedhamman; Iyyaasuki gurrinna ookkone bogi giddo duuchchaa'ni laqeme.<verse eid="JOS 6:27" /></para>
  <chapter eid="JOS 6" />
  <chapter number="7" style="c" sid="JOS 7" />
  <para style="s1">Akaani Hujeexxa Cubbo</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 7:1" />Duuchchii woddik Gootti Isira'eelika arda Iyyarkoka qachchanna isi giddo hedheechcho duuchcha biri hiyyemmaka ajaja muuxebaani. Yihudake gosati mininaa'ni Zaarahike menenaa'ni Akaani hiyyemaak Kermik belti, Zebidiki akka'i, Mageniinka ajaja sa'e hoyyemmachcho ifi'a adhdheexxe Mageni Isira'eelike arda'ni mufate.<verse eid="JOS 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 7:2" />Iyyasu «Iyyaariko hedhe Ayi hiyyemaake qachcha dooyyo'a shiixxo manna erge» Ayiki qachchi Beeti'eelii'ni boroti darre'ni hedheeke kadaa wodda Beeti'awwe hinaake qachchi'a shiqotemmani. Mannikinna Iyyaasu ajaja muuxe; <verse eid="JOS 7:2" /><verse number="3" style="v" sid="JOS 7:3" />Ookoneechchi uduma manni Iyyaasubaa «Ayik qachchi shiixkooke kadeemmaxxee isoo loliyotee lami yookaani sasi kumi manni calli duulo malee'e duuchchiinga manna ergitoxxeni» hiyye. <verse eid="JOS 7:3" /><verse number="4" style="v" sid="JOS 7:4" />Tennexxe sase kumaa kadaaki Isira'eeliki ardi duuleexxi Ayika qachcha lole: yaane kinni Ayiki loliinki manni edii'ni baqate. <verse eid="JOS 7:4" /><verse number="5" style="v" sid="JOS 7:5" />Ayik manninna Isira'eelika loliinka manna qachchiinxe hulanaa'ni Sheberite henaaxxe gooddo qico'ni shorra'ni shiya'ni soddomanna jaane manna bire. Isira'eeliki ardinna lumoshsha sodaate.<verse eid="JOS 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 7:6" />Eettene yanna'n Iyyaasunna Isira'eeliki akeekisanjuwwi yaandemmaxxee seemma ifi fixxa daddarre umoke'ni buko fiffinxe: Duuchchi Woddike Goottike taabooti edo wabbi hine galgali qico'ni turre. <verse eid="JOS 7:6" /><verse number="7" style="v" sid="JOS 7:7" />Iyyaasunna soodata'ni «Dada duuchchike Duuchchi Woddike Goottaa! Konnee arda Yordaanoosi mayeeta foossitette? Amoorik ardi no'o biro'a sa'isite uutottaatte? Mayee Yordaanoosi'i foofebe'nongi widonni gatisa gophphette? <verse eid="JOS 7:7" /><verse number="8" style="v" sid="JOS 7:8" />Anke Gootta Isira'eeli naaphi edii'ni baqateeni ani maata hiyyano? <verse eid="JOS 7:8" /><verse number="9" style="v" sid="JOS 7:9" />Kenaanitotinna weli ookkone bogiki ardi duuchchi tenne yaane laqaan; tennexxee no'o'ni duule no'o biraaxxe hexxen; bogake'n hedhabaashsha assinan yoona lumooke summi'a hite assitattexxi machcho?»<verse eid="JOS 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 7:10" />Duuchchi Woddik Gootti Iyyaasuu'u hiyyee qici «ke'i! Mayee wabbi hiteette? <verse eid="JOS 7:10" /><verse number="11" style="v" sid="JOS 7:11" />Isira'eeliki ardi balleesineeni: ajajenaka anka seera heqqedhebaani, hoyyemeechcho ifi'a adhdhe ifixe karranni welt massedheeen. <verse eid="JOS 7:11" /><verse number="12" style="v" sid="JOS 7:12" />Tennexxee Isira'eeli naapha iseka lolde injifata gophpheeki ise umi isengeeninni baxxaashsha murte saxxemmaxxee naaphi iseki edi'n baaja malee uurite loldabaan. Baleese hiyye ajajeennachcho odo insa'nexxenaa'n balleesinaaxxee ani insa'neni welt hedhabo'non.<verse eid="JOS 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 7:13" />«Ke'i! Marte arda qulloonsite hitatto qici, ‹Tee Isira'eel, farrate kaddeexxi yaane ha'nooxxe oddo'ni hexxemmaxxee tenne farra ifii mii'ni fulchedha gophphinoole naapha ha'nooka injifata dande'a gophphinaaxxa Isira'eelik Duuchchi Woddik Gootti Magen haaso'emmaxxee soodi'a ifi qophpheesate'e biso ha'nooka qulloonse.<verse eid="JOS 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 7:14" />« ‹Tennexxe sodo gorsa ardi gosa gosanni shiqowaali; Mageni kulaaxxi gosa mini minini shiqowaali; Mageni kulaaxxe gosaki mini ifi ifike mini hadinni shiqowaali Mgeni kulaake mini hadiki manni qofi qofinni shiqowwaali; <verse eid="JOS 7:14" /><verse number="15" style="v" sid="JOS 7:15" />Farra iyyedagaachchi afemeeki manji Duuchchi Woddik Gootti aagemmaxxa kako sa'iyyoti Isira'eelike arda'n salphinne iyyedageemmaaxxee isoo. Isika mini hadona horateechcho duuchcha gunbowaali.› » <verse eid="JOS 7:15" /><verse number="16" style="v" sid="JOS 7:16" />Langa baro gorsa Iyyaasu Isira'eelika arda gosa gosanni shiqishe; ookkoneechchi uduma Duuchchi Woddiki Gootti balleessa Yihudake gosati mine'n hexxeexxa leellishe; <verse eid="JOS 7:16" /><verse number="17" style="v" sid="JOS 7:17" />Iyyaasu Yihudiinxe gosaka arda shiqishe; ookkoneechchi uduma Duuchchi Woddiki Gootti balleessa Zaarahiik min qofinni foyeme; Zarahimenek mini hado mini minik shiqishe; Zaabidika mini hado qofitinni fule. Yihudanna shiqishee'naa Duuchchi Wooddiki Gootti foye. <verse eid="JOS 7:17" /><verse number="18" style="v" sid="JOS 7:18" />Zaabidinemika mini hadonna duuchchiinga shiqishee'naa Duuchchi Woddiki Gootti balleessa; Zaabidike akka'o'ni Kermike belto'n Akaani'n hexxeexxa lelishe.<verse eid="JOS 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 7:19" />Iyyaasunna Akaani'i «belto anike! Duuchchi Woddika Gootta Isira'eelika Mageno ulfeesitee aadde aagi; hujjettexxa yaane shoxxebexxongi ane'n kuli hiyye» hiyye.<verse eid="JOS 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 7:20" />Akaaninna hiyyee qici, «Dhuuganidinn Duuchchi Woddika Gootta Isira'eelikaa Mageno balleesseennek anten; balleessa anxinna <verse eid="JOS 7:20" /><verse number="21" style="v" sid="JOS 7:21" />Boojineenneke miyi giddo yo'oshsha biiffa'neexxa iimmii'ni butta geltaxxa Babiloonike mannixxa seemma, 2 kiiloo qico kadaaka birretika sibiljonna kiilotika gamisa kaddaaxxa worqe afe'e yo'oshsha gaabbennexxe'e aadhdheenne. Konneechchuwwanna anke duunkaani giddo birretika sibiljo hunda gatise'e worqe hana ugge'e moogennen.»<verse eid="JOS 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 7:22" />Ookkoneechchi uduma Iyyaasu manna ergee'naa insa'nenna duunkaanetibaa gongine marre; ookko farrate kadeeka miyuwwa birretika sibiljo hunda gatise'e moogee'na anfe. <verse eid="JOS 7:22" /><verse number="23" style="v" sid="JOS 7:23" />Insa'nena duunkaane giddii'ni fulichineexxi Iyyaasunna Isira'eeliki ardi heedhebaa iyyedangeexxi Duuchchi Woddike Gootti edo uggine.<verse eid="JOS 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 7:24" />Iyyaasunna Isira'eelike ardi duuchchi welt Zaarahika belto Akaani'i aa'neexxi birretika sibiljo, iimi'n butta geeltaammaxxa seemmanna worqe Akaanixxe labbaxxenna meyyaxxe oosenni welti qotiyuwwa harruwwanna gedhebuwwa isika ittanni dunkaananna miya isika duuchcha bukki assine'e Akoorixxe dhooqaba iyyedage <verse eid="JOS 7:24" /><verse number="25" style="v" sid="JOS 7:25" />Iyyaasunna, «Ati tenne rakko duuchcha no'o'n iyyedageten Duuchchi Woddik Gootti techcho eetteneeni rakko ate'n iyyeedageen» hiyye. Ookkoneechchi uduma Isira'eeliki ardi Akanii'i kinjiiki cancaqe shiye. Isika mini haddonna kinjiki cancanqeexxi miya isika duuchcha giirati gunbe <verse eid="JOS 7:25" /><verse number="26" style="v" sid="JOS 7:26" />Akaani'ni telchi qco'n heexxeexxa lumoxxa kinotixxa tuullo tuule. Ookkoneechchi uduma Duuchchi Woddik Goottinna mufe waale. Tennexxee eettene bakkak summi Akoorixxe dhooqa hiyyeme.<note caller="+" style="f"><char style="fr" closed="false">7:26 </char><char style="fqa" closed="false">Akorixxe dhooqa</char><char style="ft" closed="false">Ibritotikenni rakkotixxe dhooqa hiyyaten.</char></note><verse eid="JOS 7:26" /></para>
  <chapter eid="JOS 7" />
  <chapter number="8" style="c" sid="JOS 8" />
  <para style="s1">Gayike Qachchixxa Ba'ne</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 8:1" />Ookkoneechchi uduma Duuchchi Woddik Gootti Iyyaasuu'u hiyyee qici: «Sodaattoxxe'e, alaltoxxe'e sannachcha atika aaxxe'e fulde Ayike qachchika manna loli. Gayika moyano, arda, qachchakkanna boga atixxe anga'ni sa'isse uwweennene. <verse eid="JOS 8:1" /><verse number="2" style="v" sid="JOS 8:2" />Atinna Iyyaariko'ninna iseke moyanjo'ni assitettexxa duuchcha Ayikenna iseke moyanjo'ni lebbe assitaton. Yaane kinni booji'otanna hore ifi'a a'litinaan; atinna qachchi udumii'ni saxxe'e insa'ne siyantebaaba loldota'a qophpheefati» <verse eid="JOS 8:2" /><verse number="3" style="v" sid="JOS 8:3" />Tennexxe Iyyaasu iski sannachchi duuchchi Ayii'i lollo'a fulle; Iyyaasunna adhe ege'neka sase tomme kuma loliinka manna qopheefate'e hashsha duulchisexxi, <verse eid="JOS 8:3" /><verse number="4" style="v" sid="JOS 8:4" />hiyye ajajee qici «Qachchi udumii'ni riphphe; qachchakena'n bayyatinoqqe'e ha'no duuchchiing qophphefatine heqqedhdhe. <verse eid="JOS 8:4" /><verse number="5" style="v" sid="JOS 8:5" />Aninna aninni welti hedheek duuchchi qachchiinbaa shinqannon; manni konneechchi edo assemmashshanni no'o lolo'a dagaa wodda no'o kinni baanjannon; <verse eid="JOS 8:5" /><verse number="6" style="v" sid="JOS 8:6" />insa'nenna edi wodda baqantenshaanni baqantaancho ‹insa'ne'aa labbee'naa qachchakenaa'n insa'nee bayyinsanno qico'ni duuka no'oxxa dangaan› no'onna insa'ne edii'ni baqantannon. <verse eid="JOS 8:6" /><verse number="7" style="v" sid="JOS 8:7" />Ha'nonna sho'ondinebaa'n fuldineexxi ookkonni qachcha abidde; Duuchchi Woddik Gootti ha'nooki Mageni ookkonne qachcha anga ha'nooxxe'ni sa'issee uwwaan. <verse eid="JOS 8:7" /><verse number="8" style="v" sid="JOS 8:8" />Ha'noonna qachcha abiddinaa wodda giirati gubbe. Duuchchi Woddik Gootti ha'noo ajajeexxa asse; yoona ani ha'no ajajeennen.»<verse eid="JOS 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 8:9" />Ookkoneechchi uduma Iyyaasu manna erge; insa'nenna marreexxi Ayii'n dhidhimi darre'ni Beeti'eelixxenna Gayixxe oddo'ni hedheeke booncho'ni rinphe; Iyyaasu kinni ookkonne ardi welt gale.<verse eid="JOS 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 8:10" />Langa baro gorsa Iyyaasu bariisa ke'eexi labballo bukki asse; isinna Isira'eelike sooresuwwi edo he'ne akeenka'ni Ayi'a fulle. <verse eid="JOS 8:10" /><verse number="11" style="v" sid="JOS 8:11" />Isinni welt hedhemmaki loliinki manni duuchchi fule qachchiinba dage geye; ookkoneechchi uduma Ayii'n middi darre'ni oddote'ni hexxeexxe dhooqa wido qecence. <verse eid="JOS 8:11" /><verse number="12" style="v" sid="JOS 8:12" />Iyyaasu ediseexxi onde dhibba ifika loliinka manna fileexxi qachchi'ni dhidhimi darre'ni Beeti'eelixxenna Ayixxe oddo'ni riphasha assemman. <verse eid="JOS 8:12" /><verse number="13" style="v" sid="JOS 8:13" />Ookkone qachchibaa'n middi darre'n hedhammakaara ookkoonn qachchiba'ni dhidhimi darre'ni sho'nemmaka loliinka manna duuchcha booncho booncho ifika abixxinaashsha asse; ettene hashsha Iyyaasu ifixxe dhooqaba mere.<verse eid="JOS 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 8:14" />Ayik moyanji tennee uude wodda, isinna ookkone qachchik labballi duuchchi Isira'eeli'i lolate'e bariisanni ke'exxi Arebake kallachchake'ni hedheeke boonchibaa dange. Yaane kinni moyanji ookkone qachchi udumii'ni ripheeki loliinki manni hedheexxa ege'nemmabaan. <verse eid="JOS 8:14" /><verse number="15" style="v" sid="JOS 8:15" />Iyyaasunna Isira'eel duuchcha injifatemachcho labbee'na qiila gammoojebaa baqante. <verse eid="JOS 8:15" /><verse number="16" style="v" sid="JOS 8:16" />Ayik manni duuchchi insa'ne'e shorrino'a ye'emme; insa'nenna Iyyaasunna shorrine; konne qicinni Gayik manni ookkone qachchina'ni bayyantaasha assine. <verse eid="JOS 8:16" /><verse number="17" style="v" sid="JOS 8:17" />Isira'eeli shorrate'e Ayi'ninna Beeteli'i fulebaaki labballi hedhemmabaan; ookkone qachcha banne waaleexxi Isira'eeli'i shorrine.<verse eid="JOS 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JOS 8:18" />Ookkoneechchi uduma Duuchchi Woddik Gootti Iyyaasuu'u hiyyee qici: «Bagedo atika Ayike qachcha'n ke'issi; ani isoo anga atixxe'ni sa'isse uwwannoni» hiyye. Iyyaasunna bagedo Gayi'a hiisedhe. <verse eid="JOS 8:18" /><verse number="19" style="v" sid="JOS 8:19" />Isinna tennee asseshshanni ripheemmaki manni sho'omemmaba'ni rake edi'a fuleexxi abixxinemmaka ookkone qachcha giirati gunbe.<verse eid="JOS 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 8:20" />Ayik manni udumi'a wirri hiyye uudaa wodda, ookkone qachchixxi wiliille iimi'a tuqutuqu hitaa'na anfe. Yaane kinni qiila gammoojje'a baajjammaxxi Isira'eeelto dudduro insa'ne'ni uunemmaxxe'e hoone darre'ninna kaddo insa'ne fullaaki ori hedhemmabaan. <verse eid="JOS 8:20" /><verse number="21" style="v" sid="JOS 8:21" />Iyyaasunna Isira'eeli duuchcha ripheemmaki manni ookkone qachcha buqeexxanna qachchakenaa'ni wiliile iimi'a tuqutuqu hita'na anfeexxi uudumi'a hinge Ayika manna shinne. <verse eid="JOS 8:21" /><verse number="22" style="v" sid="JOS 8:22" />Ripheemmaki manni ookkone qachchinaa'ni fuleexxi insa'ne'ni guule; isexxe'e Isira'eelik manni erqe kayyi'ni insa'ne'e fula kuntemaxxe'e Gayika manna oddote'ni bunqe; Isira'eelitonna ookkone mannanaa'ni mitti midde gatebang shilte birte. <verse eid="JOS 8:22" /><verse number="23" style="v" sid="JOS 8:23" />Yaane kinni insa'ne Ayika moyanjo lubbo hedhe'naanni Iyyaasubaa aa'ne dange.<verse eid="JOS 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 8:24" />Kaddeqic Isira'eelito Ayika loliinka manna duuchcha shorrinemmake diida'ninna qiilla gammoojje'ni insa'nee shinne birreechchi udumanna mitte mittenga wolaantichchik shinne birreechchi uduma; ookkone qachchiba hingeexxi ookko'o futti hiteeka duuchcha shilte birte. <verse eid="JOS 8:24" /><verse number="25" style="v" sid="JOS 8:25" />Eettene barra'ni mudeeki Ayik meyyakinna labbaki ardi tommenna lame kumammani. <verse eid="JOS 8:25" /><verse number="26" style="v" sid="JOS 8:26" />Iyyaasu Ayi giddo hedhaammaka manna duuchcha bukki assaa qico'ni lolake'e ke'issemmaxxa anga ifixxa udumi'a hiissedhemmaban. <verse eid="JOS 8:26" /><verse number="27" style="v" sid="JOS 8:27" />Yaane kinni Isira'eelito Duuchchi Woddik Gootti Iyyaasuu'u ajajemmashshanni ookkone qachcha'ni futti hiteeka horenna booji'o ifi'a adhdhite. <verse eid="JOS 8:27" /><verse number="28" style="v" sid="JOS 8:28" />Tennexxee Iyyaasu ookkone Ayika qachcha gube duuchchi woddi'a oltixxe tuulonna telchi qico'ni gammoojje kadde gattaashsha asse. <verse eid="JOS 8:28" /><verse number="29" style="v" sid="JOS 8:29" />Isinna Ayika moyanjo haqichchi iima fanse; renshakanna galgal qico'ni okkonni hedhaashsha waale; arisho e'itechi uduma Iyyaasu rensha dirrinsaashshanna dalla'inxe hula'ni hunnaashsha ajaje; renshi hana lumolla kino tuulle: tinni kino telchi qico'ni okko'o hexxeen.<verse eid="JOS 8:29" /></para>
  <para style="s1">Kako Isixxi Gebaalixxe Kooba'n Haaronsende.</para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 8:30" />Ookkoneechchi uduma Iyyaasu Ebaalixxe kooba'n Isira'eelike Duuchchi Woddike Gootti Mageni'a tolchimalcho giisse. <verse eid="JOS 8:30" /><verse number="31" style="v" sid="JOS 8:31" />Duuchchi Woddike Goottik erganji Muuse Isira'eeli ajajemmashshanni Muuse seeriinke maxaafa'n hiyyendemmashshanni tolchimalcho sibili tuqebaake kinjin giisineexxi ciincatikanna mitoomika tolcha tolchine.<note caller="-" style="x"><char style="xo" closed="false">8:31 </char><char style="xt" closed="false"><ref loc="EXO 20:25">Fula. 20:25</ref>. </char></note> <verse eid="JOS 8:31" /><verse number="32" style="v" sid="JOS 8:32" />Muuse borreessemmaka seera Iyyaasu Isira'eelike ardi edo kinjoke'n hana borreesse.<note caller="-" style="x"><char style="xo" closed="false">8:32 </char><char style="xt" closed="false"><ref loc="LEV 27:2-8">Lew. 27:2-8</ref>. </char></note> <verse eid="JOS 8:32" /><verse number="33" style="v" sid="JOS 8:33" />Isira'eelika arda ebisaashsha edi wodda Duuccchi Woddiki Gootiki erganji Muuse ajajemmashshanni Isira'eelike ardk akeekisanjuwwi, ja'labuwwi, hayyichchuwwi, insa'nekinna iittanni Duuchchi Woddike Goottika kakotika taabota dukkeexxe Leewwito alba wirri hineexxi taabotiike middi bita'ii'n uurrineemman; Duuchchi Woddike Goottik erganji Muuse Isira'eelika arda eebbinsaashsha akeette uwwee wodda edi wodda ajajeemmashshanni gamisi manni Geriizaani hiyyendaaxxe kooba edi darre gamisi kinni Ebaalixxe kooba edi darre uurre.<verse eid="JOS 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 8:34" />Ookkoneechchinni udumi'a Iyyaasu seerinke maxaafa'n borreessemmashshanni seeriinke maxaafixxa eebaanna yo'wwichcho duuchcha haaseesse. <verse eid="JOS 8:34" /><verse number="35" style="v" sid="JOS 8:35" />Iyyaasu Isira'eeliki ardi duuchchi melaalluwwa oosuwanna weli mannina hedheexxe oddo'n Muuse ajajemmake seerana'ni mittekanna gatisebaang haassesse.<note caller="-" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="LEV 11:29">Lew. 11:29</ref>; <ref loc="LEV 27:11-14">27:11-14</ref>. </char></note><verse eid="JOS 8:35" /></para>
  <chapter eid="JOS 8" />
  <chapter number="9" style="c" sid="JOS 9" />
  <para style="s1">Geba'ooniki manni Iyyaasu'u Sobee qico</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 9:1" />Yordaanoosi'ni dhidhimi darre'n hedheeke ookkone koobatikenna gammoojjichcha boga'n iittanni Meditiraanixxe Abbaayyaxxe gabala'n Libaanoosixxe kooba qico'n hedheek Hiititotik, Amooritotik, Kenaanitotik, Feeriizitotik Hiwiitotikinna Iyyaabusitotik moyaanjuwwi tennee laqee wodda; <verse eid="JOS 9:1" /><verse number="2" style="v" sid="JOS 9:2" />Iyyaasunna Isira'eelika arda lolo'a mitteba bukki hiyye dage.<verse eid="JOS 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 9:3" />Geba'ooniki manni kinni Iyyaasu Iyyaarikonna Ayika qachchuwwa maa asseexxa laqeeammaxxee, <verse eid="JOS 9:3" /><verse number="4" style="v" sid="JOS 9:4" />isoo sobatee mudhdheexxi, galaalseemmaxxe gala'axxa dullatte kollonjuwwanna Woyinetixxa booka giddo hexxeexxa erbendeexxa kollonjuwwa harrete'n feene. <verse eid="JOS 9:4" /><verse number="5" style="v" sid="JOS 9:5" />Daddarenide muddeexxa seemmuwwanna oddo'wine. Erbendeexxa kophuwwanna uggudhine. <verse eid="JOS 9:5" /><verse number="6" style="v" sid="JOS 9:6" />Iitta assineechchinni udumi'a Isira'eeli ofoldemmaba'a Geligeela marreexxi Iyyaasunna Isira'eelika arda «No'o bayyi bogana'ni dangenne mannani; dangenchinna ha'nooni welt nage'iinka seera uggudhinonnaaten» hine.<verse eid="JOS 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 9:7" />Isira'eeliki ardi kinni Geba'oonka manna «Ha'nonni welt hitta weli aaggotika seera uggudhinanno? Akimagaada dedha ha'no no'o giddo hexxinaaxxe hexxeen» hine.<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="EXO 23:32">Fula. 23:32</ref>; <ref loc="EXO 34:12">34:12</ref>; <ref loc="LEV 7:2">Lew. 7:2</ref>. </char></note><verse eid="JOS 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 9:8" />Insa'nenna Iyyaasu «no'o atike erganjuwwa kandannoni» hine. Iyyaasu kinni «ha'no haba'i manna? Haba'n daggineera?» Hiyye qore.<verse eid="JOS 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 9:9" />Inisa'nnenna hiissineexxi, «Duuchchi Woddik Gootti ha'nook Mageni Gibtseke boga'n asseexxa yaane lanqennaxxee no'o bayi boganaa'n dangeneeke mannan. <verse eid="JOS 9:9" /><verse number="10" style="v" sid="JOS 9:10" />Iittanna Yordaanoosii'n boroti darre'n Asitaarooti hedhammake lame Amoorike moyanjuwwa maa asseexxa lanqeneni: Kunni lami moyanjuwwi Asitaaroti giddo hedhaamake Haseebonk moyanjo Siihooninna Baasaanike moyanijo Oogitemman.<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="NUM 21:21-35">Lak. 21:21-35</ref>. </char></note> <verse eid="JOS 9:10" /><verse number="11" style="v" sid="JOS 9:11" />Akeekisanjuwwi no'okinna bogi no'oki giddo hedha'neek ardi duuchchi, ‹Gala'a orakee galaalsitine'e anga abixxe; ha'noonna martineexxi insa'nenni afemme; no'onna garboole ha'nooxxe kandannon; insa'nenna no'onni kako aagge hiyye› no'o hine. <verse eid="JOS 9:11" /><verse number="12" style="v" sid="JOS 9:12" />Tennee galalsinennexxa gala'a udde! No'oke mininaa'ni ke'ne kaba'a daniganowodda kunni waasi eebbakemmani; ta'a kinni hitta bage'e buqunne qico udde! <verse eid="JOS 9:12" /><verse number="13" style="v" sid="JOS 9:13" />Tennee qalqalluwwa'n woyinetika bulbulo worrenna'wodda haaroxxemman; ta'a kinni hitta daddarende qico uudde! Orinke bayyinnenaa'ni kexxeexxa oddo'winennexxe seemmanna uggudhineennexxi ko'phe darende luggiteen.» <verse eid="JOS 9:13" /><verse number="14" style="v" sid="JOS 9:14" />Isira'eeliki manninna dagemmake mannixxe gala'anaa'ni shiixxoxxa adhdhine yaane kinni Duuchchi Woddika Gootta lanqeechchi hedhebaan. <verse eid="JOS 9:14" /><verse number="15" style="v" sid="JOS 9:15" />Iyyaasunna inisa'ne'ni welt jaalome nage'iki he'naashsha seera ugge. Isira'elike ardiki akeekisanjuwwinna seera ookkonee heqqe'naashsha kakante.<verse eid="JOS 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 9:16" />Seeri uggeme sakka baro Isira'eeliki ardi kunni manni olla'ake kade inisa'nenni welt hedha'neexxa Isira'eeliki ardi laqe. <verse eid="JOS 9:16" /><verse number="17" style="v" sid="JOS 9:17" />Tennexxe Isira'eeliki ardi ke'e me'exxi sase barra uduma iiki ardi hedheeke qachchuwwibaa geye; inisa'nek qachchuwwinna Geba'ooni, Keefiira, Be'eerotina, Qiriyatiyi'aarimi hiyyemammakeerani: <verse eid="JOS 9:17" /><verse number="18" style="v" sid="JOS 9:18" />Inisa'nee gennabaashsha ardiinki akeekisanjuwwi Duuchchii woddika Gootta Isira'eelike Mageniinke summinni kakantemmaxxee Isira'eeliki ardi inisa'ne'e shiya waale. Tenne yaanenaa'ni kexxeexxa Isira'eeliki ardi duuchchi ifike akeekisanjuwwa'ni guggumeen. <verse eid="JOS 9:18" /><verse number="19" style="v" sid="JOS 9:19" />Yaane kinn akeekisanjuwwi iikki; «No'o inisa'ne'ni gennabe'noshsha Duuchchii woddika Gootta Isira'eelike Mageniinke summinni kakattinaaxxe'e inisa'ne'ni miinabe'non. <verse eid="JOS 9:19" /><verse number="20" style="v" sid="JOS 9:20" />Assinano qici, insa'ne'aa kakanteennaxxa kako diingee'naa Mageni no'o'ni mufatabaashsha insa'ne hedhoti he'naasha amme shiya waallo. <verse eid="JOS 9:20" /><verse number="21" style="v" sid="JOS 9:21" />Yaane kinni ardi duuchchi'a haqqe bonca'ninna wode'e ikkilla'ni he'nuni» hine. Tennexxe iikki akekisanjuwwi shiqishemmake yaadishshanni yaane kadde.<verse eid="JOS 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 9:22" />Iyyaasunna Geba'onika arda ye'iseexi «Kaba biringe manna kaddine bayyii'ni dangenneni hitine maye'e anee sobbine? <verse eid="JOS 9:22" /><verse number="23" style="v" sid="JOS 9:23" />Sobo haasotinemmaxxee Mageni hanoo'ni mufate'en; tennexxe ardi ha'noki anke Mageniinke galmi'a haqqe boca'ninna wode'e ikkila'ni duuchchi wodda garbake kade hedhaan.»<verse eid="JOS 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 9:24" />Inisa'nenna Iyyaasu; «No'oke Gootta! Eeti assinennexxeni Duuchchii woddik Gootti ha'nooki Mageni ha'no giddo hexxina'neke bogika arda isiki erganji Muuse shiye bire boga ha'no'a uwwo'a ajajeexxa ege'nenneni; tenne iitta assinennechchi ha'noo sodaantennaxxee lubbo gantonaa hineeten. <verse eid="JOS 9:24" /><verse number="25" style="v" sid="JOS 9:25" />Ta'a yoona atixxe anga'ni he'neenneni, eetetteshsha no'o assedhi.»<verse eid="JOS 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JOS 9:26" />Tennexxe Iyyaasu Isira'eelike manninni Geba'onika manna shiyabaashsha hoyyemmaxxee mittikinna inisa'nee shiyeeki hedhemmabaan. <verse eid="JOS 9:26" /><verse number="27" style="v" sid="JOS 9:27" />Yaane kinni eettene yaana'n Iyyaasu geba'aoniki manni Isira'eelike ardi'a garbake kade'e haaqqe boonca'n wode'e iikkillaashshsha Duuchchi Woodik Goottike tolchimalchiba ergatemmaashsha asse. Insa'nenna telchi qico'n Duuchchi Woddik Gootti iso'o magenoonfanto'a fi'lemma booncho'n tenne huje'ni ergatemate'n he'neen.<verse eid="JOS 9:27" /></para>
  <chapter eid="JOS 9" />
  <chapter number="10" style="c" sid="JOS 10" />
  <para style="s1">Arishshotixxa Uurra</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 10:1" />Iyyerusaalemiki moyanji Adoonitsedeqi, Iyyaasu Ayika qachcha abideexxi lole balleeseexxa, iittanni Iyyaariko'ninna isike moyanjo'n asseexxa duuchcha, Gayi'ninna isike moyanjo'n asseexxa, iittann Geba'oonik manninna Isira'eelike ardinni weli aage nage'ik insa'ne bira hedheexxa laqe. <verse eid="JOS 10:1" /><verse number="2" style="v" sid="JOS 10:2" />Tennenaa'ni kexxeexxa isinna isik ardi yo'oshsha alanneemman, ittinna Geba'oonik qachchi lumminnekenaa'n kexxeexxa heddi moyanjuw galchaammak qachchuwwishsha kadiyot Ayike qachchanaa'n sa'emmaxxeenna giddo hedhammak manni lolake'e ege'nemeek kademmaxxeeten. <verse eid="JOS 10:2" /><verse number="3" style="v" sid="JOS 10:3" />Tennexxee Iyyerusaalemiki moyanji Adoonitsedeqi shoole moyanjbaa, Hohaami hiyyemaaka Kebiroonike moyanjibaa, Piraam hiyyemaake Yaarmuutike moyanjibaa, Yaafi'a hiyyemaake Lakkishiike moyajibaanna Daaberi hinammake Egiloonike moyonjibaa hiyye ergee qici; <verse eid="JOS 10:3" /><verse number="4" style="v" sid="JOS 10:4" />«Geba'oonik manni Iyyaasuninna Isira'eelik ardin nage'iki he'naashsha weli aagemmaxxe'e anxe gamo kaddinee'na mitteba hinge insa'nee'e lollona'a amme» hiyye.<verse eid="JOS 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 10:5" />Ookkoo'n oddi Amoorak qachchuwik moyanjuwwi, Iyyerusaalemiki moyanji, Kebiroonik moyanji, Yaarmuutik moyanji, Lakkishiik moyanjinna Egiloonik moyajni duuchchiingi mitteb ifika loliika manna bukki assinennexxi Geba'oonika qachcha erqe kayyii'n bunqe lolle.<verse eid="JOS 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 10:6" />Geba'ooniki manninna Iyyaasu hedheeba Isira'eelik ardi ofo'leeb Geligeeli'a erga ergineexxi, «koobuwwa callike boga'ni he'nammaki Amoorak qachchik moyanjuww duuchchi mitteba bukki hiyye no'o lolo'a qophpheefatemmaxxee no'o garboole atixxa gargaartottaa hashsha barrate hitoxxeni rakke dagi» hine kulle. <verse eid="JOS 10:6" /><verse number="7" style="v" sid="JOS 10:7" />Tennexxe Iyyaasunna duuchchiing isike loliink mannana lolaake ege'nemeek mannini welt Geligeeli'ni fule me'e. <verse eid="JOS 10:7" /><verse number="8" style="v" sid="JOS 10:8" />Duuchchi Woddik Gootti Iyyaasu'u, «Insa'nee'e injifattottaa middit ati'a uwwaanaxxe mee sodaat insa'ne giddii'n mittikinna atee uurre lolaaki hedhebaan» hiyye.<verse eid="JOS 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 10:9" />Iyyaasunna hashsha duuchcha Geligeeli'ni Geba'ooni'a me'a'ni galeexxi mare si'atebaaka Amooraka manna lole. <verse eid="JOS 10:9" /><verse number="10" style="v" sid="JOS 10:10" />Duuchchi Woddik Gootti Amoorak loliink manni Isira'eelika loliinka manna alaye bararaqaashsha asse; Isira'eeliki loliink manninna wele Geba'oonik loliinka manna gor'e shiya'n wele gateek Beetihoroni darree'n koobat hundii'n adaddeeshumma me'inammaba hedhemmak Azeeqanna Maqeedake qachchchi qico'n shorre. <verse eid="JOS 10:10" /><verse number="11" style="v" sid="JOS 10:11" />Amoorak manni adaddeeshumma Isira'eelik loliink manni edii'n baqatamma wodda Duuchchi Woddik Gootti Azeeqa gennaa qico'n iimi'n lumolla kaade insa'ne'ni ganisiise kaadeti reyeek manni Isira'eelik loliinki manni shiyeeki irra yo'okeman.<verse eid="JOS 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 10:12" />Duuchchi Woddik Gootti Amoorito Isira'eelik ardixxe anga'ni sa'isse uwweexxe barra'ni, Iyyaasu Duuchchi Woddika Gootta Isira'eeli'i edo hiyyee qici;</para>
  <para style="q1" vid="JOS 10:12">«Tee arishsho Geba'ooni iima uurri;</para>
  <para style="q2" vid="JOS 10:12">Tee baate Eeloonixxe dhooqa iima uurituun.»<verse eid="JOS 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOS 10:13" />Tennexxe Isira'eelik ardi naapha ifike'n halo fulaa qico'ni,</para>
  <para style="q2" vid="JOS 10:13">Arishshoo uuritemmaba gatte;</para>
  <para style="q2" vid="JOS 10:13">Agenjikinna hedhemmabaa'n le'mebaan.</para>
  <para style="m" vid="JOS 10:13">Tinninna Yashshaarike maxaafa'n borreessende hexxeen.</para>
  <para style="p" vid="JOS 10:13">Arishsho iimatixxe oddo'ni uurrite; e'yitebaang barra duuchcha hosse.<note caller="-" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="2SA 1:18">2 Sam. 1:18</ref>. </char></note> <verse eid="JOS 10:13" /><verse number="14" style="v" sid="JOS 10:14" />Ookkoneechchi edi darrenna kadi yookaan uduma ettene barrashsha Duuchchi Woddik Gootti manjiinka haaso'a laqeexxi barra hara hexxebaan. Dhugaandinn Duuchchi Woddik Gootti Isira'eeli'a gamote kade'e loleemman.<verse eid="JOS 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 10:15" />Ookkoneechchi uduma Iyyaasunna isik loliink manna Isira'eelik mann hedhemmabaa Geligeeli'a wirrine hinge.<verse eid="JOS 10:15" /></para>
  <para style="s1">Iyyaasu ondiinxa Amooraawiyanetixxa Moyanjuwwa Shiye qico</para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 10:16" />Ondiing Amoorak moyanjuww baqate fuleexx Maqeedake qachchi bira hexxeexxe wolo'o giddo sho'ommeemman. <verse eid="JOS 10:16" /><verse number="17" style="v" sid="JOS 10:17" />Kunni ondiing moyanjuww Maqeedake qachchi bira hexxeexxe wolo'o giddo sho'ommeexxa anfe Iyyaasu'n kulle. <verse eid="JOS 10:17" /><verse number="18" style="v" sid="JOS 10:18" />Iyyaasunna hiyyee qici, «Lumollamma kino goggo'mishine wolo'otixxa hula cuffe ookko'o heqqaaka mannanna ugge. <verse eid="JOS 10:18" /><verse number="19" style="v" sid="JOS 10:19" />Ha'no kinni ookko'o turitti noqqe higgine udumii'n naapha shorritina'n lolle mee baqatefu qachuww insa'neki giddi'a mee e'yowaal! Duuchchi Woddik Gootti ha'nook Mageni insa'nee injifatinoo'a middite hanno'a uwween.»<verse eid="JOS 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 10:20" />Shiixxook manni calli baqate fule ifike qachchike dalla'i giddi'a e'ye lubbo gatoolenna Iyyaasunna Isira'eelik ardi duuchchiinga manna gorra'e shiye bire. <verse eid="JOS 10:20" /><verse number="21" style="v" sid="JOS 10:21" />Ookkoneechchi uduma Iyyaasuk loliink manni duuchchi nage'ik hegeexxi isi hedhemmaba Isira'eeliki ardi ofo'lemmabaa Maqeeda'a dange.</para>
  <para style="p" vid="JOS 10:21">Tennenaa'n kexxeexa bogi ookkone giddo Isira'eelik arda'n mittikinna bucuqqi hiyyaammak hedhemmabaan.<verse eid="JOS 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 10:22" />Ookkoneechchi uduma Iyyaasu, «Wolo'otixxa hula banddin okkone ondiinga moyanjuwwa anibaa iyyedagge» hiyye ajaje. <verse eid="JOS 10:22" /><verse number="23" style="v" sid="JOS 10:23" />Tennexxe wolo'o banneex okkone onde moyanjuwwa Iyyerusaalemik, Kebiroonka, Yaarmuutika, Lakkishikanna Egiloonika moyanjuwwa fulchineexxa, <verse eid="JOS 10:23" /><verse number="24" style="v" sid="JOS 10:24" />Iyyaasuba'a iyyedage; Iyyaasunna Isira'eelika arda duuchcha ye'exxi isika loliinka manna ajajammak manni dageexx gooba insa'nek ha'naashsha ajaje; insa'nenna hiyyemmashshanni assine.<verse eid="JOS 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JOS 10:25" />Iyyaasunna insa'nee, «Sodaatinoqqe, alaltinoqqe, jabaatte, ti'ni hiyye yoona lolendinammake naapha duuchcha'ni Duuchchi Woddik Gootti tennee assaan» Hiyye. <verse eid="JOS 10:25" /><verse number="26" style="v" sid="JOS 10:26" />Ookkoneechchi uduma Iyyaasu ondiinga moyanijuwwa shiyyexxi renisha onde haqichcho'n fanse; insa'neki renshinna galgali qico'n fanisemeeba ture. <verse eid="JOS 10:26" /><verse number="27" style="v" sid="JOS 10:27" />Arishsho e'yitamma wodda Iyyaasuke ajajinni moyanijuwwiinka rensha haqiqetenaa'n dirrinse'e edi wodda sho'omemmaxxe wolo'o giddo hunne. Lumolla kinonna gogo'minshe'e wolo'otixxa hula cunfe. Iti kinonna techchi qico'i okkooni hexxe.<verse eid="JOS 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JOS 10:28" />Eettene barra'ni Iyyaasu Maqeeda hiyyemaaka qachcha lole abideexxi moyanjokanna shiye; qachchi giddo hedhemmaka manna duuchcha mittikinna gatebaang shiye bire. Maqedaka moyanjo shiiyee qici edi wodda Iyyaarkoka moyanjo shiyemmashshaten.<verse eid="JOS 10:28" /></para>
  <para style="s1">Buta'ike Qachchuwwixxa Abidensha</para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 10:29" />Ookkoneechchi udumi'a Iyyaasunna isiki loliinki manni Maqeedaa'n fule'e Libina hiyyemaake qachcha lole'e miidhe. <verse eid="JOS 10:29" /><verse number="30" style="v" sid="JOS 10:30" />Iittanni Duuchchi Woddik Gootti qachcha moyanjignni Isira'eelixxe anga'n ibise. Iyyaasu qachchanna qachchi giddo hedhemmaka manna duuchchin bire. Qachchiinka moyanijonna Iyyaarkoka mojanjo shiyemmashsha shiye.<verse eid="JOS 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JOS 10:31" />Ookkoneechchi udumi'a Iyyaasu isike loliinke manninni welt Libininaa'n duule Lakishi buqe lole'e miidhe. <verse eid="JOS 10:31" /><verse number="32" style="v" sid="JOS 10:32" />Duuchchi Woddik Goottinna langaxxe loliinxe barra'n Lakkishii'i Isira'eeli'a sa'isse uwwe. Iyyaasunna langa baro isee'e abixxee Libinaka qachcha assinemasha ookkone qachchi giddo hedheka manna duuchcha shine bire <verse eid="JOS 10:32" /><verse number="33" style="v" sid="JOS 10:33" />Ookkone wodda Geezeriki moyaji Horaami Lakkishii'i gargaaro'a dageemman; Iyyaasunna isonna isika loliinka manna lole miidhe; insa'ne giddii'n mittekinna luboti gateeki hedhemmabaan.<verse eid="JOS 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 10:34" />Ookkoneechchi udumi'a Iyyaasu isike loliinke manninna welt Lakkishii'n duule'e Egiloonii'i buqe lole miidhexxi; <verse eid="JOS 10:34" /><verse number="35" style="v" sid="JOS 10:35" />Eettene barra'ini qachcha anga ibilse manna wolantichchiki shine birre; Lakkishii'n assinemmashshanni qachchi giddo hedheeka manna duuchcha shinne birre.<verse eid="JOS 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JOS 10:36" />Ookkoneechchi uduma Iyyaasu isiki loliink manni welt Egiloonii'i duuleexxi Kebiroonii buqe lole'e midhexxi, <verse eid="JOS 10:36" /><verse number="37" style="v" sid="JOS 10:37" />Insa'nenna okkone qachcha moyanjiinxe anganaa'ni, iseke loola'n hedheeke hadi giddike qachchawwi giddo futti hineeka duuchcha shinne birre. Iyyassunna Egilooni'n assemmashshann qachcha balleesinaashsha murte uwwe; okkone qachchi giddo hedhemmake manninaa'n mittikinna lubbot gateeki hedhemmabaan.<verse eid="JOS 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JOS 10:38" />Ookkoneechchi udumi'a Iyyaasu isike loliinke manninni illee iima higexxi Debirika qachcha lole midhexxi. <verse eid="JOS 10:38" /><verse number="39" style="v" sid="JOS 10:39" />Insa'nenna ookkone qachcha moyanjokanna loola iseka duuchcha ibindeexxi wolaantichik shinne birre; qachchi giddonna hedhemmachcho duuchcha mittenna gatinsebaang kutti assine. Iitanni Libina'ninna moyanjo iseke'ni iitanni Kebirooni'ni assineexxa duuchcha kaba Debiri'ninna moyanjo iseke'ni lenbe assine.<verse eid="JOS 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JOS 10:40" />Konne qicinni Iyyaasu boga duchcha: koobatika boga Negeebii'i, ookkone dhidhimii darreka gammoojichcha boganna koobatixxe adaddeeshummaka boguwwinni mitteba konne boguwwika moyanjuwwa duchcha anga ibilse; Duuchchii woddik Gootti Isira'eelik Mageni ajajemmashshanni duchchiinga shiye bire male mittekanna lubboti waaleek hedhebaan. <verse eid="JOS 10:40" /><verse number="41" style="v" sid="JOS 10:41" />Iyyaasunna Qaadesi Berinee'n Gaaza qico'n Gooshenike loolika boga duuchcha, Geba'ooni qico'n hedheeka boga duuchchiinga lole injfate. <verse eid="JOS 10:41" /><verse number="42" style="v" sid="JOS 10:42" />Iyyaasu konne moyanjuwwanna insa'neka boga duchcha mitte duulo'ni injifateeki Duuchchi Woddik Gootti Isira'eeliki Mageni Isira'eeli'a lolammaxxeen.<verse eid="JOS 10:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JOS 10:43" />Ookkoneechchi uduma Iyyaasu isike loliinke manninna welt Isira'eeliki ardi ofo'lemmaba'a Geligeeli'a wirri hiyye hige.<verse eid="JOS 10:43" /></para>
  <chapter eid="JOS 10" />
  <chapter number="11" style="c" sid="JOS 11" />
  <para style="s1">Iyyaasu Moyanjo Yabininna Wele Moyanjuwwa Injifate qico</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 11:1" />Hatsoorik moyaji Yaabini Isira'eelixxa injifachcho laqe wodda Yobabii'i Madoonike moyajibaa Yobaabi'a, Shimiroonikenna Akishafike moyanjuwwibaa <verse eid="JOS 11:1" /><verse number="2" style="v" sid="JOS 11:2" />iittanni middake'n koobatike boga, Kinereetike bita'ii'n Areba, dhidhimake'n gammoojje boganna Doorike tullichchinaa'n dhidhimi darree'n hedhemmake moyanijuwwibaa erge. <verse eid="JOS 11:2" /><verse number="3" style="v" sid="JOS 11:3" />Ittanni Yordaanoosi'n Arishsho fuldamma darre'ninn dhidhimmii darre'ni hedheek Kenaanitotibaa, Amooritotibaa, Hiititotibaa, Feeriizitotibaanna koobuwwa callike boga'ni hexxa'neexxe Iyyaabusitotiba; iittanni kinni Mitsiphake boga'ni Harmoonixxe kooba hunda hedheeke Hiwaatotike moyanjiba'a erga dhaame. <verse eid="JOS 11:3" /><verse number="4" style="v" sid="JOS 11:4" />Inisa'nenna abbaayyatike qarqarike maanchishsha bira sa'eka ifike loliinke mannanna loliinxa fadhadixxa gaare adhdhine dange. <verse eid="JOS 11:4" /><verse number="5" style="v" sid="JOS 11:5" />Kunniichchi duuchchi moyanjuwwi mitteba hige'e Isira'eeli lolo'a Meroomi hiyyendaaxxe muumme bira dage qecece.<verse eid="JOS 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 11:6" />Duuchchi Woddik Goottinna Iyyaasu'u, «Insa'ne sodaattoxxe'e. Ani Isira'eeli'a lolennexxi soodo tenne yanna'n rensha insa'neka Isira'eelixxe anga'n uwwannon; atinna fadhodo insa'neka mogolchita'n insa'nexxe fadhadixxa gaaruwwanna gubbatton» hiyye.<verse eid="JOS 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 11:7" />Tennexxe Iyyaasu isike loliinke manninni welt Meroomixxe muummebaa duuleexxi si'atebaang lole miidhe. <verse eid="JOS 11:7" /><verse number="8" style="v" sid="JOS 11:8" />Duuchchi Woddik Goottinna Isira'eeli injifataashsha midditte uwweemmaxxe'e, Isira'eeli manni loleexxi middi darre'n Misirefootimayiiminna lumoke Sidoonake qachchi qico'n, boroti darre'n kinni Mitsiphphaxxe dhooqa qico'n lolla'n shorrine, mitti manjinna lubboti gatebaang duuchchiinga kutti assine. <verse eid="JOS 11:8" /><verse number="9" style="v" sid="JOS 11:9" />Iyyaasunna Duuchchi Woddiki Gootti ajajaxxa duuchchinixxa asse. Insa'neka fadhadonna mogolcha'ni fadhadiinxa gaaruwwanna gube bire.<verse eid="JOS 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 11:10" />Iyyaasunna illee iima higeexxi Hatsoorii'i lole injifate anga ibilse, moyanijokanna wolaantichchiki shiye. Eettene yanna'ni Hatsoriki moyanji ookkone baro'n hedhemmake wele bogike moyanjuwwi duuchchinaa'n hunnati sa'akemman <verse eid="JOS 11:10" /><verse number="11" style="v" sid="JOS 11:11" />Isira'eelik loliinki manni Hatsoorike qachchi giddo hedhemmaka manna duuchcha wolaantichchiki shiye bire, lubboti gateeng hedhemmabaan, qachchakanna gunbe.<verse eid="JOS 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 11:12" />Duuchchi Woddike Goottik erganji Muuse ajajemmashshanni Iyyaasu konne'e qachchuwwa duuchcha anga ibilsexxi moyanjuwwa kanna wolaantichchiki shiye bire. <verse eid="JOS 11:12" /><verse number="13" style="v" sid="JOS 11:13" />Kaddomalee Iyyaasunna isiki loliink manni Hatsoorike qachcha gadhi darre Isira'eelik koobbuwwate'n hedheeka qachcha gunbek hedhebaan. <verse eid="JOS 11:13" /><verse number="14" style="v" sid="JOS 11:14" />Isira'eeliki ardi konne qachchuwwika horenna karra duuchcha boojine'a ifi'a adhdhine, manna kinni wolaantichchiki birre, mite manjonna lubboti gatinsebang shinne birre. <verse eid="JOS 11:14" /><verse number="15" style="v" sid="JOS 11:15" />Duuchchi Woddik Gootti garbichcho ifika Muuse'e ajajemmashshanni Muusenna Iyyaasu'u ajaje; Iyyaasunna kulendemmashanni asse; Duuchchi Woddik Gootti Muuse'e ajajemmaxxe duuchchanaa'ni muuxebaangi mitte gatisexxi yaane hexxemmabaan. <verse eid="JOS 11:15" /><verse number="16" style="v" sid="JOS 11:16" />Iyyaasu ookkone boga duuchcha koobatika boga Negeebii duuchcha, Gooshenika boga duuchcha, dhidhimi darrexxa gammoojje, Arebanna iittanni Isira'eelika boga suubbichchakanna gammoojjichcha boga bukki asse abixxe. <verse eid="JOS 11:16" /><verse number="17" style="v" sid="JOS 11:17" />Iittanni Seyiiri qico'n marte geliteexxe Halaqixxe koobana'ni Herimonixxe kooba hunda Libaanoosixxe dhooqake Ba'aaligadike bogi qico'n hedheeka moyanjuwwa duuchcha booji'a'ni shiye bire. <verse eid="JOS 11:17" /><verse number="18" style="v" sid="JOS 11:18" />Iyyaasunna konnee duuchchiinge moyanjuwwinn welt heddo wogga lolema'n tureeman. <verse eid="JOS 11:18" /><verse number="19" style="v" sid="JOS 11:19" />Geba'oonike qachchaxxe Ewwitoxxe gosake arda male Isira'eelinn nage'iki weli aageki hedhemmabaani, wele qachchika arda lole'e abindemmakemman. <verse eid="JOS 11:19" /><verse number="20" style="v" sid="JOS 11:20" />Konne qachchuwwiki ardi duuchchi mudaashsha, Duuchchi Woddik Gootti Isira'eeli lollaashsha godoba insa'neka jabeessemmaxxe'e Isira'eelik ardi mararte belo insa'ene bire. Tinninna Duuchchi Woddiki Gootti ediseenni Muuse'e ajajeemmake ajajamman.<note caller="-" style="x"><char style="xo" closed="false">11:20 </char><char style="xt" closed="false"><ref loc="LEV 7:16">Lew. 7:16</ref>. </char></note><verse eid="JOS 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 11:21" />Eettene yanna Iyyaasu isike loliinke manin welt duuleexxi Kebiroonike, Debirike, Anaabike koobatike qachchuwwainna Isira'eelikenna Yihudake koobacallike boga'n hedhammaka qerrarramma Anaaqixxa gosaka arda duuchchi bire. Iyyaasu konne duuchchiinga arda bire'e insa'en he'nemmaka qachchanna bakka balleesse. <verse eid="JOS 11:21" /><verse number="22" style="v" sid="JOS 11:22" />Anaaqixxe gosana'ni shixxooki manni calli Gaazake, Gaatikenna Ashidoodike qachchuwwa'n gateeke male Isira'eelike bogi giddo lubboti gateek hedhemmabaan. <verse eid="JOS 11:22" /><verse number="23" style="v" sid="JOS 11:23" />Duuchchi Woddik Gootti Muuse ajajemmashshanni Iyyaasu boga duuchcha anga iblse; mitte mittenge Isira'eelixxe gosake mini'a geyaaka qadaada qoode. Tennexxee Isira'eeliki ardinna bagedokenaa'n gate.<verse eid="JOS 11:23" /></para>
  <chapter eid="JOS 11" />
  <chapter number="12" style="c" sid="JOS 12" />
  <para style="s1">Muuse lole Injifateeke Moyanjuwwika summa</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 12:1" />Isira'eelik ardi arishsho fuldama darre'n Arnoonixxe dhooqanaa'n Hamooni'enixxe kooba qico'n hedheeka Arebaka boga duuchcha; Yordaanoosi widi darre arishsho fuldamma darreka boga abideeki koneechchi butti'a hedheeka moyanjuwwa injifateeten. <verse eid="JOS 12:1" /><verse number="2" style="v" sid="JOS 12:2" />Haseebonike qachcha'n ofo'le galcha'ammaki Amooritotik moyanji Siihoonitemman; isi galchamake bogiki Gele'adike bogika gamisa abide'e Arnoonixxe Dhooqake kasa'n hedheeke Aro'eeri hiyyemaake qachchanaa'n ke'exxi eettene Dhooqanni giddo Amoonike bogixxe gabala'n hedheeke Yaaboqike galaani qico'itemman.<verse eid="JOS 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 12:3" />Iittanni isi Kinereetixxe Abbaayya'naa'n Maxinetixxe Abbaayya qico'n hedheeka Arebaka dhidhimii darre, Beetiyeshimooti qico'ninna ookkoo'n bita'i darre'n Pisigaxxe kooba hundi qico'n hedheeke bogi qico'ni galcheemman.<verse eid="JOS 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 12:4" />Iittanni udu'meemmaki Raafayixxe gosak Baasaaniki moyanj Oogi Asitaarootinna Edire'ika qachcha moye galcha'nemman <verse eid="JOS 12:4" /><verse number="5" style="v" sid="JOS 12:5" />Isixxi galcha Hermoonixxe kooba qico'n, Saleka, Geshuurekenna Ma'ikake qachchuwwi qico'n hedheeka Baasaanika boga duuchcha abide'e, Haseeboniki moyanji Siihooni galchammake Gele'adike bogike gamisi qco'n hedheeke boguwwi qico'ntemman.<note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="NUM 21:21-35">Lak. 21:21-35</ref>; <ref loc="DEU 2:26-3:11">Lan. 2:26—3:11</ref>. </char></note><verse eid="JOS 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 12:6" />Muuse Duuchchi Woddike Goottik erganj Isira'eelike ardinn welt konne lame moyanjuwwa injifateexxi boga insa'neka Roobeelixxe, Gaadixxenna Minaasexxe gamisa gosa'a qoode.<note caller="-" style="x"><char style="xo" closed="false">12:6 </char><char style="xt" closed="false"><ref loc="NUM 32:33">Lak. 32:33</ref>; <ref loc="LEV 3:12">Lew. 3:12</ref>. </char></note><verse eid="JOS 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 12:7" />Iyyaasu Isira'eelike ardinn welt Yordaanoosi'n dhidhimi darreke boga'n hedhammaka moyanjuwwa lole injifate; konne moyanjuwwiki boginna Libaanoosixxe dhooqa giddo hedheeke Ba'aaligadike qachchanaa'n Seyiirike bita'a'n hexxeeexxe Halaqixxe kooba qico'n geyaammakemman. Iyyaasunna konne boga duuchcha mitte mitte Isira'eelixxe gosake mini'a geyaaka qadaada qoode. <verse eid="JOS 12:7" /><verse number="8" style="v" sid="JOS 12:8" />Kunni boguwwinna koobatika boga, dhidhimi darreka koobati hundika boga, Areba, Yordaanoosixxe dhooqakanna dhooqa giddo boroti darre'n hedheeka adaddeeshummatika boganna bita'i darre'n hedheeka gammoojjichcha boga duchcha mitteba'a abideekemman. Kunni boguwwi edi wodda Hiititotike, Amooritotike, Kenaanitotike, Feeriizitotike, Hiwaatotikenna Iyyaabusitotike he'naammake bogamman.<verse eid="JOS 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 12:9" />Iyyaasu Isira'eelike ardinn welt lole'e injifateemmaki moyanjuwwiki qachchuwwi konneechchi buti'a hedhekeeran; Iyyaariko, Beeti'eeli bira hexxeexxi Ayii'i, <verse eid="JOS 12:9" /><verse number="10" style="v" sid="JOS 12:10" />Iyyerusaalemi, Kebirooni, <verse eid="JOS 12:10" /><verse number="11" style="v" sid="JOS 12:11" />Yaarmuuti, Lakkishshi, <verse eid="JOS 12:11" /><verse number="12" style="v" sid="JOS 12:12" />Egilooni, Geezerii, <verse eid="JOS 12:12" /><verse number="13" style="v" sid="JOS 12:13" />Debiri, Geederii, <verse eid="JOS 12:13" /><verse number="14" style="v" sid="JOS 12:14" />Horima, Araadi, <verse eid="JOS 12:14" /><verse number="15" style="v" sid="JOS 12:15" />Libina, Adulaami, <verse eid="JOS 12:15" /><verse number="16" style="v" sid="JOS 12:16" />Maqeeda, Beeti'eeli, <verse eid="JOS 12:16" /><verse number="17" style="v" sid="JOS 12:17" />Taapuha, Heferii, <verse eid="JOS 12:17" /><verse number="18" style="v" sid="JOS 12:18" />Afeeqi, Leesherooni, <verse eid="JOS 12:18" /><verse number="19" style="v" sid="JOS 12:19" />Madooni, Hatsoori, <verse eid="JOS 12:19" /><verse number="20" style="v" sid="JOS 12:20" />Shimironimeroon, Akishafii, <verse eid="JOS 12:20" /><verse number="21" style="v" sid="JOS 12:21" />Ta'inak, Megido, <verse eid="JOS 12:21" /><verse number="22" style="v" sid="JOS 12:22" />Qaadeesi, Qerlmeeloosi hedhemmaki Yooqine'aami, <verse eid="JOS 12:22" /><verse number="23" style="v" sid="JOS 12:23" />Abbaayyati qarqara hedheeki Doori, Geligeela hedheeki Gooyiminn, <verse eid="JOS 12:23" /><verse number="24" style="v" sid="JOS 12:24" />Tirtsate kadaa wodda, duuchching moyanjuwwi mitteba sase tommeenna mittekemman.<verse eid="JOS 12:24" /></para>
  <chapter eid="JOS 12" />
  <chapter number="13" style="c" sid="JOS 13" />
  <para style="s1">Abidema Hasissaa'nanni Gateeka Boga</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 13:1" />Iyyaasuxxi wogga lebba'ni me'itemmaxxe'e cime, Tennexxe Duuchchi Woddik Gootti hiyyee qici, «Ta'a atixxi wogga lumoxxen; cindeetten; yaanne kinn abidemebaang gateeki heddo boga hedheen.<verse eid="JOS 13:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="JOS 13:2" />«Abidemebaang gateeki boguwwi: Filisixeemikenna Geshuureke ardike boga duuchchan. <verse eid="JOS 13:2" /><verse number="3" style="v" sid="JOS 13:3" />Kunni boguwwi Gibtsee'n arishsho fuldamma darree'n Shiihorite hiyyemaake galaaninaa'n ke'exxi Middi darre hedheeke Aqarooni hiyyemaake qachchixxe gabala qico'n hedheek bogi. Kunni duuchchi Kenaanike boga hiyyemaan. Kunni boguwwinna ondiinge Filsixeemike moyanjuwwike Gaazake, Ashidoodike, Asiqeloonake, Gaatinna Aqaroonike moyanjuwwi galchammak boga kadaa woda kunninna Awwitotike bogamman. <verse eid="JOS 13:3" /><verse number="4" style="v" sid="JOS 13:4" />Weli kinni Kenaani giddo Me'aara hiyyemaake Sidoonitotike boginninni gabala Amoorake ardixxe Afeeqi qico'n hedheeki; <verse eid="JOS 13:4" /><verse number="5" style="v" sid="JOS 13:5" />Gebaalitotika bogganna boroti darre'n Haromoni'emixxe kooba'n bita'i darre'n hedheeke Ba'aaligadike qachchinaa'n Hamaasixxe weldeenna qico'n hedheeki Libaanoosi bogi duuchchi abidemebaan.<verse eid="JOS 13:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="JOS 13:6" />«Libaanoosi'ni Misirefootimayiimi qico'ni hedheeke kooba callike boga'n hedhaammaka Sidoonito ani umo anke Isira'eeli edi'n shorranoon; ati kinni ani ate'e ajajennashshann boga Isira'eelike ardi'a geegoke kadaashsha qoodi.<note caller="-" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="NUM 33:54">Lak. 33:54</ref>. </char></note> <verse eid="JOS 13:6" /><verse number="7" style="v" sid="JOS 13:7" />Konne boguwwanna qadaada kado'a qooddattoki Isira'eelixxe gosake sallane mini'anna gamisa Minaaseke mini'aten.»<verse eid="JOS 13:7" /></para>
  <para style="s1">Yordaanoosike Gaalani'n Boroti Darre'n hedheek Bogi Qoodemee qico</para>
  <para style="m">
    <verse number="8" style="v" sid="JOS 13:8" />Roobeelikinna Gaadik ardi ittanni Minaaseke minik gamis ardi Duuchchi Woddike Goottik erganj Muuse insa'nee geyaaka geegoke uwwee'na edi wodda adhdhine'en; kunni boginna Yordaanoosike galaan wido boroti darre'n hedheeken.<note caller="-" style="x"><char style="xo" closed="false">13:8 </char><char style="xt" closed="false"><ref loc="NUM 32:33">Lak. 32:33</ref>; <ref loc="LEV 3:12">Lew. 3:12</ref>. </char></note><verse eid="JOS 13:8" /></para>
  <para style="b" />
  <para style="m">
    <verse number="9" style="v" sid="JOS 13:9" />Insa'ne'a uwwemeemmaki geeginna Aroonixxe Dhooqake kayyike kasa'n hedheeke Aro'eeri hiyyemaake qachchanaa'n ke'exxi ettene dhooqa giddo oddote'n hedheeke Medeba hiyyemaake qachchike diidanaa'n Diboon hinaake qachchi qico'n hedheeke bogan. <verse eid="JOS 13:9" /><verse number="10" style="v" sid="JOS 13:10" />Ittani Amoorik moyanji Siihooni moyeeke Haseebonike qachchanaa'n Amoonike ardixxe gabala qico'n hedheeka boga duuchcha mitteba abideeten. <verse eid="JOS 13:10" /><verse number="11" style="v" sid="JOS 13:11" />Gele'adiki, Geshuureki, Ma'ikaki boguwwi duuchchinna Harmonixxe koobaki bogi duuchchi Baasaanike bogi duuchchinni Saleka qicon hedheeke boga mittenba abideeten; <verse eid="JOS 13:11" /><verse number="12" style="v" sid="JOS 13:12" />Raafayitotixxe hafe kadeemaka Asitaarootinna Edirayii'ni moyeemaka Baasaanika moyanjo Oogixxa mootumma duuchcha laphphaan. Muusenna konneera duuchcha injifateexxi fulche. <verse eid="JOS 13:12" /><verse number="13" style="v" sid="JOS 13:13" />Kaddomalee kinni Isira'eelk ardi Geshuurikanna Ma'ikaka arda bogi giddii'n fulchebaan; tennexxe insa'ne telchi qico'n Isira'eelike ardixxe oddo'n hedeen.<verse eid="JOS 13:13" /></para>
  <para style="b" />
  <para style="m">
    <verse number="14" style="v" sid="JOS 13:14" />Muuse Leewwike gosatike mini mini hadi'a geyaaka geego uwwebaan; Mageni Muuse'e ajajemmashshann Duuchchi Woddika Gootta Isira'eelike Mageni'a tolchimalchoke'ni ciincesinaake tolcha kade'e shiqaake tolchanaa'ni alflinaak qoobbi insa'ne'a geegoke kadee uwweme'en.<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="LEV 18:1">Lew. 18:1</ref>. </char></note><verse eid="JOS 13:14" /></para>
  <para style="s1">Roobelike Mini'a Geego</para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 13:15" />Muuse Roobelike minike ardi'a aanchi anchinn geyaaka geego qoode.<verse eid="JOS 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="JOS 13:16" />Insa'neke geeyeki bogi Arinoonixxe dhooqake kasa'n hedheeke Aro'eerinna ettenne dhooqa giddo oddote'n hedheeke qachchibaa'n itti aanne hedheek boga kute sa'eexxi Medebake qachcha bira hedheeka suubbichcha boga mitteba abidaan. <verse eid="JOS 13:16" /><verse number="17" style="v" sid="JOS 13:17" />Ittann Haseebonika qachcha; suubbichchi boga'n hedhemmaka Diboonika; Bamotiba'oolika; Betibe'aalimetsoonika; <verse eid="JOS 13:17" /><verse number="18" style="v" sid="JOS 13:18" />Yahaatsika, Qedemootika, Mefa'aatika, <verse eid="JOS 13:18" /><verse number="19" style="v" sid="JOS 13:19" />Qiriyatayiimika, Sibemaka, dhooqa giddixxe kooba'n hedheeka Tseretishahaarika, <verse eid="JOS 13:19" /><verse number="20" style="v" sid="JOS 13:20" />Beetipe'orika, Pisiga hinaaxxe kooba hunda hexxeexxe dhooqa boga duuchchanna Beetiyeshimootika qachchuwwa duuchcha mitteba abideeken. <verse eid="JOS 13:20" /><verse number="21" style="v" sid="JOS 13:21" />Suubbichchi boga'n hedheemmaka qachchuwwa duuchchanna Haseebonike qachchi giddo hedha'n moye galchaammake Siihoonii'i Amoorake moyanjika boga duuchcha mitteba abideeken. Muuse moyanjo Siihoninna Midiyaamike ardika akeekisanjuwwa kadeemmaka Ewwii'i, Reeqeemii'i, Tsurii'i, Huurinna Reba'ii'i injifateemman. Kunni akeekisanjuwwi duuchching arda galcha'ammki moyanjo Siihooni'a gabara'neetemman. <verse eid="JOS 13:21" /><verse number="22" style="v" sid="JOS 13:22" />Isira'eelik ardi shiyemmake manninaa'n mitti mora'n galaammaka Bi'oorike belto Bele'aamitemman. <verse eid="JOS 13:22" /><verse number="23" style="v" sid="JOS 13:23" />Dhidhimi darre'n Yordaanoosik galaani Roobelike minike aanchi aanchi ardi'a uwwemeemmake bogixxi gabalamman. Kunni bogi isi giddo hedheeke qachchuwwinna qarqarake'n hedheeke shiixxaramma qachchuwwi duuchchin Roobelike minike aanchi aanchi arda'a geegoke kado'a uwwemeemmaken.<verse eid="JOS 13:23" /></para>
  <para style="s1">Gaadike Minika Geego</para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 13:24" />Muuse Gaadike minike aanchi aanchi ardi'a geyaaka geego qoode. <verse eid="JOS 13:24" /><verse number="25" style="v" sid="JOS 13:25" />Insa'ne geeyeki bogi Iyyazeeri hiyyemaaka qachchanna Gele'adi bogi giddo hedheeka qachchuwwa duuchcha mitteba abide'e, Amoonike ardika gamisa boga leba'n Raabake qachchanaa'n boroti darre'n hedhemmake Aro'erike qachchi qico'n hedheeken. <verse eid="JOS 13:25" /><verse number="26" style="v" sid="JOS 13:26" />Bogi insa'nekiki ba'linni Haseebonike qachchana'n ke'eexxi Ramati Mitsiphakenna Beexonimike qachchuwwi qico'n, iittanni Mahinayimike qachchana'n Lodebaarike bogixxe gabala qico'ni geyeedhen; <verse eid="JOS 13:26" /><verse number="27" style="v" sid="JOS 13:27" />iittanni Yordaanoosixxe dhooqa giddo (Haseeboniki moyanji, Siihooni galchaammaka wele gateeki) Beetiharaamii'i, Beetinimiraa'a, Sukootii'i Tsafoniinna Kinereetixxe Abbaayyake kasi qico'n Yordaanoosiki galaanii'n dhidhimii darre'n hedheeka Haseebonik moyanji, Siihooni galchaammaka wele gateeka boga mitte abidaan. <verse eid="JOS 13:27" /><verse number="28" style="v" sid="JOS 13:28" />Gaadike minike aanchi aanchike'e ardi'a geegoke kado'a uwwememmaki qachchuwwinna qarqarake'n hedheeke shiixxaramma qachchuwwi duuchchi koneratemman.<verse eid="JOS 13:28" /></para>
  <para style="s1">Boroti Darre'n hedhammake Minaaseke Minike Gamisa aanchi aancike ardika Geego</para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 13:29" />Muuse gamisa Minaaseke minike ardi'a geyaaka geego uwweeki, aanchi aanchinni qoodetemman. <verse eid="JOS 13:29" /><verse number="30" style="v" sid="JOS 13:30" />Boga insa'nekixxi gabala Mahinayimika qachchanna Baasaani qico'n hedheeka boga duuchcha mitteba abideeten; Baasaaniki bogi kunni Baasaanika duuchchiinga boganna iittanni Baasaan giddo Ya'irri hiyyemaake boga'n hedheeka duuchchiinga 60 qachchuwwinninni Baasaanik moyaji Oogixxa galcha mitteba abideeten. <verse eid="JOS 13:30" /><verse number="31" style="v" sid="JOS 13:31" />Iittan Gele'adiki gamisi bogi, Asitaarootikinna Edire'iki qachchuwwi; konne qachchuwwa Baasaaniki moyanji Oogi moye galchaammaken, kunni duuchchin bogi gamisa Minaaseke gosati minike Makirixxe horite'a aanchi aanchinni qoqqoodeme.<verse eid="JOS 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 13:32" />Muuse Mo'aabike diida'n hedhemma wodda Yordaanoosike galaani wido Iyyaariko'n boroti darre'n hedheemaka boga qoodeeki konne qicinnitemman <verse eid="JOS 13:32" /><verse number="33" style="v" sid="JOS 13:33" />Yaane kinn Muuse Leewwike gosatike mini'a geyaaka geego uwwebaan; insa'nki geegi Duuchchi Woddika Gootta Isira'eelike Mageno kadeemmaxxe'e; geego insa'neka alfinaaki Magenoke'e shiqaammake tolchinaa'nite kaddeexxa kulende'en.<note caller="-" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="NUM 18:20">Lak. 18:20</ref>; <ref loc="LEV 18:2">Lew. 18:2</ref>. </char></note><verse eid="JOS 13:33" /></para>
  <chapter eid="JOS 13" />
  <chapter number="14" style="c" sid="JOS 14" />
  <para style="s1">Yordaanoosike Galaani'n Dhidhimi Darre'n Hedheeke Bogixxa Qoodensha</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 14:1" />Ali'aazaar qeesichchi, Neewek Belt Iyyaasunna Isira'eelike miniki aanchi aanchike soorreesuwwi Kenaanika boga Isira'eelike ardi'a geeyaka geego qoondeeki konneten. <verse eid="JOS 14:1" /><verse number="2" style="v" sid="JOS 14:2" />Duuchchi Woddik Gootti Muuse ajajemmashshann Yordaanoosike galaan wido dhidhimi darre'n hedheeka boga duuchcha sallanenna gamisa Isira'eelixxe gosake mini'a hixiki qoode.,<note caller="-" style="x"><char style="xo" closed="false">14:2 </char><char style="xt" closed="false"><ref loc="NUM 26:52-56">Lak. 26:52-56</ref>; <ref loc="NUM 34:13">34:13</ref>. </char></note> <verse eid="JOS 14:2" /><verse number="3" style="v" sid="JOS 14:3" />Muuse Yordaanoosi galan wido boroti darre'n hedheeka boga lamenna gamisa Isira'eelixxe gosake minia'a qoode; Leewwike gosatike minike ardi'a kinni geego uwwebaan.<note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="NUM 32:33">Lak. 32:33</ref>; <ref loc="NUM 34:14-15">34:14-15</ref>; <ref loc="LEV 3:12-17">Lew. 3:12-17</ref>. </char></note> <verse eid="JOS 14:3" /><verse number="4" style="v" sid="JOS 14:4" />Yooseefixxi oose Minaasenna Efireemi lame Isira'eelixxe gosake minemman. Leewwike ardi'a hore alla'latike boga kadoole malee qadaada uunebaan <verse eid="JOS 14:4" /><verse number="5" style="v" sid="JOS 14:5" />Tennexxee Duuchchi Woddik Gootti Muuse ajajeemmashshanni Isira'eeliki ardi boga qoodeme.<verse eid="JOS 14:5" /></para>
  <para style="s1">Keberooniki Qachchi Kaalebi'a Uwweme</para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 14:6" />Barra mitte Yihudake gosake mini hadik ardi Geligeela giddo Iyyaasubaa dage; Insa'ne giddii'n Qeneezichcho Yifaanek belti Kaalebi hiyyee qici: «Qaadesi Berine he'nenna wodda Duuchchi Woddike Goottik erganji Muuse haaso'exxa anxanna atixxa yaane atinni egende'eten. <verse eid="JOS 14:6" /><verse number="7" style="v" sid="JOS 14:7" />Duuchchi Woddike Goottik erganji Muuse Qaadesi Berinee'n boga dooyyona'a anee erga wodda ani shoole tomme woggake ka'umamman; hexxeexxa yaane dage'e dhugaa iso'n haaso'ennen <verse eid="JOS 14:7" /><verse number="8" style="v" sid="JOS 14:8" />Annini welt me'emmaki weli manni kinni arda sodate'e culiphisashsha asse; ani kinni Duchchii Woddika Gootta anke Mageni'a miite godobinni ergatemenne. <verse eid="JOS 14:8" /><verse number="9" style="v" sid="JOS 14:9" />Tennexxe Muuse eetene barra ‹Duuchchi Woddika Gootta anka Mageno mitte godobin hordofettaxxe'e iikki lekka atixxenni haxxeteki bogi, duuchchi woddi'a atikenna atixxe ooseke geego kade gataan› hiyye kakate.<note caller="-" style="x"><char style="xo" closed="false">14:9 </char><char style="xt" closed="false"><ref loc="DEU 1:36">Lan. 1:36</ref>. </char></note><verse eid="JOS 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 14:10" />«Isira'eeli gammoojje qiilla bogi giddixxe me'ani hexxee'na'a Muuse konne haaso'a haaso'exxe barranaa'n telchi qco'n uuddatteshshann Duuchchi Woddik Gootti hiyyemmashanni anee shoole tommenna onde wogga lubboti ugge galcheen; kunseteni ani ta'a saddeeta tommenna onde wogga geyennen. <verse eid="JOS 14:10" /><verse number="11" style="v" sid="JOS 14:11" />Muuse anee erge wodda hedhennashshan telchonna jabaken; ookkone woddishsha telchonna fule lolee aagannoxxa hunna afeene. <verse eid="JOS 14:11" /><verse number="12" style="v" sid="JOS 14:12" />Ta'a yoona Duuchchi Woddik Gootti uwwo'a eettene barra addachchiisemmaka konne'e kooba callika boga ani'a uwwi. Ati eettene barra Anaaqike ardik lumolmammakanna kolfanite'aka qachchuwwa afe'exxa eettenen barra laqqeetten, kaddo malee Duuchchi Woddiki Gootti hiyyemmashshann isi aninn welt hedhemmaxxe'e insa'nee bogakenaa'n shorrannon.»<verse eid="JOS 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 14:13" />Iyyaasunna Yifaaneka belto Kaalebii'i eebbiseexxi Kebiroonika qachcha geego isike kado'a uwwe. <verse eid="JOS 14:13" /><verse number="14" style="v" sid="JOS 14:14" />Tennexxe Isi Duuchchi Woddika Gootta Isira'eelika Mageno mitte godobinni hordofemmaxxe'e Kebiroonika qachchi telchi qico'n Qeneezichcho Kaalebii'i Yifaaneke belitixxe horeteke qadaada kade gate <verse eid="JOS 14:14" /><verse number="15" style="v" sid="JOS 14:15" />Kebiroonik qachchik summi edi wodda Anaaqixxe gosake manji duuchchinaa'n gurra fuleeke Arbaaqi hinaake manjichchike summi Qiriyati'arbaaqi hiyyeme ye'emaamman.</para>
  <para style="p" vid="JOS 14:15">Ookkoneechchi uduma iikki bogi nage'a alfe.<verse eid="JOS 14:15" /></para>
  <chapter eid="JOS 14" />
  <chapter number="15" style="c" sid="JOS 15" />
  <para style="s1">Isira'eeli Yihudake Minike Ardi'a Geyeka Geego</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 15:1" />Isira'eelii'i Yihudake minike aanchi aanchi ardi'a uwwemeeki bogixxi gabala Eedoomike bogixxe bita'i darrexxe gaba'la'n hexxeexxe Tsinixxe gammoojje qiillake kasi qico'n mare geyedheen. <verse eid="JOS 15:1" /><verse number="2" style="v" sid="JOS 15:2" />Bita'i darre'n insa'neke bogixxi gabala Maxinetixxe Abbaayyake kasa'n bita'i darre'n abbaayya giddi'a suuxxi hiyye e'yeeke bogi qico'ntemman. <verse eid="JOS 15:2" /><verse number="3" style="v" sid="JOS 15:3" />Ookkoo'n bita'i darre'n Aqirabiimika ora woxxe saxxe marte Tsini geltaan. Qaadesi Berineke bita'i darre'inna Hetseroonike qachchinaa'n sa'e me'ite Aadaarike qachchanaa'n toggi hiyyati Qarqake qachchi darre'n wirri hitaan. <verse eid="JOS 15:3" /><verse number="4" style="v" sid="JOS 15:4" />Atsimoonike qachchibaa saxxe me'ati Gibtseke bogixxe gabala'n hedheeke galaani qico'n marte gelta'n, Mediteraniyetixxe Abbaayya'n marte uurtaan. Tinni bita'i darre'n Isira'eelii'i Yuhuudake minixxe gabalan.<verse eid="JOS 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 15:5" />Boroti darreexxi gabala Maxinetixxe Abbaayya qico'n, Yordaanoosik galaan timi qico'nten. Middi darrexxi gabala kinni Yordaanoosik galaanike timibaa'ni Abbaayya giddi'a suuxxi hiyye e'yeeke bogiba'n <verse eid="JOS 15:5" /><verse number="6" style="v" sid="JOS 15:6" />Beetihogila qico'n marte geltaan, ookko'ninna Yordaanoosixxe dhooqake middanaa'n sa'exxi Boohaani hiyyemmake Roobeli beltike qaabbet kinji qico'n marte geltaan. <verse eid="JOS 15:6" /><verse number="7" style="v" sid="JOS 15:7" />Ookko'ninna Akoorixxe dhooqanaa'ni Dabiri'a qabbatta'n Aduumimike ori edi darrexxe dhooqake bita'i'n middi darre'n Geligela'a wirri hitaan. Tennexxe Gabala Ensheemeshixxe muummexxa saxxa'n Enirogeeli marete gelteen. <verse eid="JOS 15:7" /><verse number="8" style="v" sid="JOS 15:8" />Iittanni Heenomike belitixxe Dhooqake bita'a hexxeexxe adaddeeshumma'n Iyyaabusitotike qachchik kadeeke Iyyerusaalemike qachchi darree'n Heenomixxe dhooqa edi darre hexxeexxe koobaxxa xungo'n saxxa'n middi darre'n Raafayimixxe dhooqa marte gelteen. <verse eid="JOS 15:8" /><verse number="9" style="v" sid="JOS 15:9" />Ookko'inna gabala koobatixxe xungo'n kexxeexxi Nefitohaaxxe muummuwwaba marte gelteen; Efiroonixxe koobake qachchuwwixxa saxxa'n Ba'aala yookaan Qiriyatiyi'aarimibaa wirri hitaan. <verse eid="JOS 15:9" /><verse number="10" style="v" sid="JOS 15:10" />Ookko'ni Ba'aala qarqaranaa'n middi darree'n Seyiirixxe koobabaa wirri hitaan; Yi'arimi yookaan Kisaloon hiyyendaaxxe koobaxxa adaddeeshumma saxxaan adaddee Beetishemeshike qachchibaa dirrite Timinake qachchibaanna qaxxaamurtaan. <verse eid="JOS 15:10" /><verse number="11" style="v" sid="JOS 15:11" />Tinninni gabala midha Aqaroonixxe koobake'n alallee qabate'e Shikerooni gama'n wirrihita'n Ba'aalixxe koobaxxanna Yabini'eelixxa saxxa'n Meditiraayanixxa Abbaayya marte geltaan.<verse eid="JOS 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 15:12" />Dhidhimi darrexxi gabalanna Meditiranixxe Abbaayyanna ise qariqara hedheeke bogi qico'niten; tinninna Yihudake ardke bogixxi elqe kayyi'n aanchi aanchixxi gabala tenneten.<verse eid="JOS 15:12" /></para>
  <para style="s1">Kaaleb Keberooninna Debirni'i Injifate Abixxeexxa</para>
  <para style="r">(<ref loc="JDG 1:11-15">Hay. 1:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 15:13" />Iyyaasu Duuchchi Woddik Gootti ajajemma shanni Kaalebii'i Yifaaneke belti'a Isira'eeli'i Yihudake gosati minike qoobinaa'n Qiriyati'arbaaqi yookaani Kebirooni gegoke kadaasha uwwe. (Ariba Enaaqike annamman) <verse eid="JOS 15:13" /><verse number="14" style="v" sid="JOS 15:14" />Kaalebi Sasiinxa Enaaqixxa horte: Sesinii'i, Ahimaaniinna Talimayii'i Kebiroonina'n shorre.<note caller="-" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="JDG 1:20">Hay. 1:20</ref>. </char></note> <verse eid="JOS 15:14" /><verse number="15" style="v" sid="JOS 15:15" />Ookko'n ke'exxi Debiri hedhammaka arda lolo'a me'e; Kunni qachchi edidarre Qiriyatisefeeri hiyyema'eemman. <verse eid="JOS 15:15" /><verse number="16" style="v" sid="JOS 15:16" />Kaalebi «Qeriyatisefeerika qachcha lole'e abidake manji'a belto anixxa Akisaa'a aadhisaanen» hiyye <verse eid="JOS 15:16" /><verse number="17" style="v" sid="JOS 15:17" />Tennexxe Kaalebika dayyo, Qeneezik belti Otini'eeli ookkonee qachcha lole abide; Kaalebinna belto ifika Akisaa'a Gotoonniyyani'a uwwee'na'a aadhe.<verse eid="JOS 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JOS 15:18" />Akisa Gotoni'alba'a dagee wodda, anna isikenaa'ni huccaaka fichcha kadhataashsha duute ise'a gorsa uute<note caller="+" style="f"><char style="fr" closed="false">15:18 </char><char style="ft" closed="false">Ibritotinna wele torbaane tomme beekolexxe tikuwwa konnenni welti mittondaan: heddo torbaane tomme beekolexxi tikuwwa kinni Hayyo 1:14 jabeese ise'ni kuleen</char><char style="ft" closed="false">Hitaan.</char></note> isenna harrichchotenaa'n dirriteshshanni Kaalebi isee, «Ati'a maasona'a hassaate?» Hiyye ise qore. <verse eid="JOS 15:18" /><verse number="19" style="v" sid="JOS 15:19" />Isenna, «ani'a ute'ettaki bogi bagoke kadeemmaxxee'e wodi'iinxa muummuwwa ani'a uwwi» hite. Kaalebinna alee'ninna aadee'ni lame wodi'iinxa muumme ise'a uwwe.<verse eid="JOS 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 15:20" />Isira'eelii'i Yihudake gosati minik ardi'a aanchi aanchinni uwwemeeki geeg konneechchinni butti'a hedheeken: <verse eid="JOS 15:20" /><verse number="21" style="v" sid="JOS 15:21" />Bita'i darre'n Eedoomi qico'n hedheeki Isira'eeli Yihudake gosati minik qachchuwwi Qebsi'eeli, Edeeri, Yaguri, <verse eid="JOS 15:21" /><verse number="22" style="v" sid="JOS 15:22" />Qiina, Dimoona, Adi'aada, <verse eid="JOS 15:22" /><verse number="23" style="v" sid="JOS 15:23" />Qaadeesi, Hatsoori, Yitinaani, <verse eid="JOS 15:23" /><verse number="24" style="v" sid="JOS 15:24" />Zifi, Xellemi, Be'aaloti, <verse eid="JOS 15:24" /><verse number="25" style="v" sid="JOS 15:25" />Hatsoorihadata, Qiriyotihetsirooni, yookaani Hatsoori, <verse eid="JOS 15:25" /><verse number="26" style="v" sid="JOS 15:26" />Amaami, Shema'i, Moolada, <verse eid="JOS 15:26" /><verse number="27" style="v" sid="JOS 15:27" />Hatsaarigada, Heeshiimoon, Beetiphaalexxi, <verse eid="JOS 15:27" /><verse number="28" style="v" sid="JOS 15:28" />Hatsarishu'aali, Bersaabehi, Biiziyotiya, <verse eid="JOS 15:28" /><verse number="29" style="v" sid="JOS 15:29" />Be'aala, Iiyuumi, Etseemi, <verse eid="JOS 15:29" /><verse number="30" style="v" sid="JOS 15:30" />Eltolaadi, Kesili, Horima, <verse eid="JOS 15:30" /><verse number="31" style="v" sid="JOS 15:31" />Tsiqilaagi, Maadiimana, Saanisana, <verse eid="JOS 15:31" /><verse number="32" style="v" sid="JOS 15:32" />Liibawooti, Shilihiimi, Iyyiniinna Rimooni hiyyemmaki laakkoossiki lame tommenna sallane qachchuwwanna qachchuwwika ola'a duuchcha mitteba abideeten. <verse eid="JOS 15:32" /><verse number="33" style="v" sid="JOS 15:33" />Gammoojichchi bogi giddo hedheeki qachchuwwi Eshita'ooli, Tsoori'a, Ashiina, <verse eid="JOS 15:33" /><verse number="34" style="v" sid="JOS 15:34" />Zaanoha, Enigaanimi, Taapuha, Enaami, <verse eid="JOS 15:34" /><verse number="35" style="v" sid="JOS 15:35" />Yaarmuuti, Adulaami, Sekooti, Azeeqa, <verse eid="JOS 15:35" /><verse number="36" style="v" sid="JOS 15:36" />Shi'arayiimi, Aditaayimi, Gedeeranna Gederotaayim hiyyemaki laakkoossiki tommenna shoole qachchuwwanna qachchuwwika olla'a duuchcha mitteba abideeten.<verse eid="JOS 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JOS 15:37" />Iittanni Tsinaani, Haadasha, Miigidaligaadi, <verse eid="JOS 15:37" /><verse number="38" style="v" sid="JOS 15:38" />Dili'aani, Mitsiphpha, Yooqixi'eeli, <verse eid="JOS 15:38" /><verse number="39" style="v" sid="JOS 15:39" />Lakishi, Bootsiiqati, Egilooni, <verse eid="JOS 15:39" /><verse number="40" style="v" sid="JOS 15:40" />Kabooni, Lahimaasi, Kitilishi, <verse eid="JOS 15:40" /><verse number="41" style="v" sid="JOS 15:41" />Gederoti, Beetidaagon, Naa'imanna Maqeeda hiyyemaaki laakkoossiki tommenna jaane qachchuwwunna qachchuwwi qarqara hedheeka shiixxaramma qachchuwwa duuchcha mitteba abideeten.<verse eid="JOS 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JOS 15:42" />Konne duuchchinni welt Libina, Eteri, Ashaani, <verse eid="JOS 15:42" /><verse number="43" style="v" sid="JOS 15:43" />Yiifitahi, Ashina, Neetsibi, <verse eid="JOS 15:43" /><verse number="44" style="v" sid="JOS 15:44" />Qe'iila, Akizibinna Meriisa hiyyemaaki laakkoossiki salane qachchuwwanna qarqarake'n hedheeka shiixxaramma qachchuwwa duuchcha mittebaa abide'een.<verse eid="JOS 15:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JOS 15:45" />Aqarooni hiyyemaak qachchi isi qarqara'n hedheemmake shiixxaramma qachchuwwi duuchchinni mitteba; <verse eid="JOS 15:45" /><verse number="46" style="v" sid="JOS 15:46" />Aqarooninaa'n Mediteriyanixxe Abbaayya qico'n Ashidoodike qarqara'n ijaarememmaki qachchuwinna qachchuwwike qarqara'n hedheek shiixxarammi qacchchuwwi mitteba; <verse eid="JOS 15:46" /><verse number="47" style="v" sid="JOS 15:47" />Iittanni Ashidoodike qachchi qarqara hedhemmake shiixxaramma qachchuwwinn mitteba; Gaazak qachchi Gibtseke qarqara hedheeke galaani qico'inna Mediteranixxe Abbaayya qico'ni hedheeke shiixxaramma qachchuwwin mitteba; <verse eid="JOS 15:47" /><verse number="48" style="v" sid="JOS 15:48" />Koobatike bogi giddo Saamiri, Yaatiri, Soko, <verse eid="JOS 15:48" /><verse number="49" style="v" sid="JOS 15:49" />Daana, Qiriyatiseferi yookaan Debiri, <verse eid="JOS 15:49" /><verse number="50" style="v" sid="JOS 15:50" />Anaabi, Ashiteemo'a, Aanimi, <verse eid="JOS 15:50" /><verse number="51" style="v" sid="JOS 15:51" />Goosheni, Holooninna Giilo hiyyemaaki tommenna mitti qachchuwwi qarqarake'n hedheeke shiixxaramma qachchuwinni mitteba bukki asse'en.<verse eid="JOS 15:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JOS 15:52" />Iittanni Arabi, Duuma, Eshi'aani, <verse eid="JOS 15:52" /><verse number="53" style="v" sid="JOS 15:53" />Yaanimi, Beetitapuuha, Afeeqa, <verse eid="JOS 15:53" /><verse number="54" style="v" sid="JOS 15:54" />Humixa, Kebirooni hiyyendeexxi Qiriyati'arbaaqinna Tsii'ori hiyyemaaki laakkoossiki sallani qachchuwwi qarqara hedheeke shiixxaramma qachchuwwinn mitteba bukki asse'en.<verse eid="JOS 15:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JOS 15:55" />Ma'ooni, Qermeloosi, Ziifi, Yuuxa, <verse eid="JOS 15:55" /><verse number="56" style="v" sid="JOS 15:56" />Iyyizira'eeli, Yoqidi'am, Zaanoha, <verse eid="JOS 15:56" /><verse number="57" style="v" sid="JOS 15:57" />Qayin, Gibi'anna Timina hiyyemaaki laakkoossiki tommi qachchuwwi qarqara hedhemmake shiixxaramma qachchuiwwini mitteniba bukki asse'en.<verse eid="JOS 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JOS 15:58" />Ittani Halihuli, Betitsuuri, Geedoori, <verse eid="JOS 15:58" /><verse number="59" style="v" sid="JOS 15:59" />Ma'iraati, Beetii'anotinna Elitiqo hiyyemaaki laakkoossiki jaani qachchuwwi qarqara hedhemmake shiixxaramma qachchuwwinni mitteba;<verse eid="JOS 15:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="JOS 15:60" />Qiritiyatibaali yookaan Qiriyatiyi'aariminna Raabati hiyyemaaki lamme qachchuwwi qarqara hedhemmake shiixxaramma qachchuwwinni mitteba <verse eid="JOS 15:60" /><verse number="61" style="v" sid="JOS 15:61" />Konneerininn welt qiilla gammoojje giddo hedhemmake Beeti'araba, Miidiini, Sekakaa <verse eid="JOS 15:61" /><verse number="62" style="v" sid="JOS 15:62" />Nibishaani, Maxineti qachchinna Eenigaadi hiyyemaak laakkoossiki jaani qachchuwwi qarqara hedheeke shiixxaramma qachchuwwinni mittebaten.<verse eid="JOS 15:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="JOS 15:63" />Yaane kinni Isira'eli'i Yihudaki ardi Iyyerusaalemi hedhaammaka Iyyaabusaxxe gosaka arda shorra dandennebaan. Tennexxee Iyyaabuusaki ardi telchi qico'n Isira'eeli Yihudake ardinni welt hedha'neen.<note caller="-" style="x"><char style="xo" closed="false">15:63 </char><char style="xt" closed="false"><ref loc="JDG 1:21">Hay. 1:21</ref>; <ref loc="2SA 5:6">2 Sam. 5:6</ref>; <ref loc="1CH 11:4">1 Odo. 11:4</ref>. </char></note><verse eid="JOS 15:63" /></para>
  <chapter eid="JOS 15" />
  <chapter number="16" style="c" sid="JOS 16" />
  <para style="s1">Efireemikenna Gamisa Minaase ardi'aa uwwemeeka Geego</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 16:1" />Yooseefixxee horte'a uwwemeeki bogixxi bita'i darre'n gabala Iyyarkoke qarqari'n hedheeke Yordaanoosike galaaninaa'n kexxaan; tinninna boroti darre'n Iyyaarkoxxe muummuwwanaa'n kexxeexxi qiilla gammoojje qico'n marte geltaan; Iyyaarkoo'n kexxeexxi koobatike bogi giddii'n alallee qabbatte Beeti'eenli qico'n marte geltaan <verse eid="JOS 16:1" /><verse number="2" style="v" sid="JOS 16:2" />Beeteli'inna ke'exxi Arkixxe gosaki ardi hedhemmake Axarotidarri hiyyemaake bogi giddi'n saxxa'n Looza marte gelteen <verse eid="JOS 16:2" /><verse number="3" style="v" sid="JOS 16:3" />Ookko'ninna dhidhimidarre'n hedheeke Fileexitotixxe gosake bogixxa saxxa'n aadixxe Beetihoroni qico'n marte gelteen; ookko'n Geezeribaa, Geezerinana'n Meditiraanyanixxe Abbaayya'n marte urritaan. <verse eid="JOS 16:3" /><verse number="4" style="v" sid="JOS 16:4" />Yooseefixxe oosexxi Minaasexxinna Efireemixxi horte konneechchi buti'a hedheek qadaadi uwweme.<verse eid="JOS 16:4" /></para>
  <para style="s1">Efireemixxe Horiteka Qadaada</para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 16:5" />Isira'eelii'i Efireemike minike aanchi aanchike qadaadixxi gabala Axaarooti Adaarii'n boroti darre'n alixxe Beetihoroni'aa qabbattaan <verse eid="JOS 16:5" /><verse number="6" style="v" sid="JOS 16:6" />Ookko'ni saxxeexxi Mediteranixxe Abbaayya qico'n marte geltaan; middi darre'n insa'nexxi gabala Mikimetaatiten. Ookko'n ke'exxi borotidarre'n Ta'anaati Seelo'a wirri hite Yaanoha marete gelte. <verse eid="JOS 16:6" /><verse number="7" style="v" sid="JOS 16:7" />Yaanohaa'n kexxeexi Axarootinna Ne'aratibaa adadde dirrite Iyyaariko gelte Yordaanoosike galaana'n wirri hita <verse eid="JOS 16:7" /><verse number="8" style="v" sid="JOS 16:8" />Tinni gabala dhidhimi darre'n Taapuhaa'n kexxeexxi marte Qaanaka galaana gelta'n Mediteraanixxe Abbaayya'n marte uurtaan. Kunni Isira'eeli Efireemike minike aanchi aanchi arda'a uwwemeeki qadaadamman. <verse eid="JOS 16:8" /><verse number="9" style="v" sid="JOS 16:9" />Kunn qadaadi Minaaseke aanchi aanchi ardi'a Efireemixxe horte'aa uwwemeemmaka qachchuwwa duuchchanna insa'neka olla'uwwa bukki asse abideeken. <verse eid="JOS 16:9" /><verse number="10" style="v" sid="JOS 16:10" />Kunni Eefireemiki ardi kinn Geezeri hedhaammaka Kenaanika arda bogi giddii'ni shorreemmabaan. Tennexxee kani'anki ardi techchi qico'n Efireemike ardixxe oddo'n hedha'neen; kaddo malee Efiremiki aridi insa'nee jabaxxa huje hunnati ifi'a hujisa'emman.<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="JDG 1:29">Hay. 1:29</ref>. </char></note><verse eid="JOS 16:10" /></para>
  <chapter eid="JOS 16" />
  <chapter number="17" style="c" sid="JOS 17" />
  <para style="s1">Yordaanoosi'n Dhidhimi darre'n Hedheeke Minaaseke Gamisi Ardika Boga</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 17:1" />Yooseefike angafa belto Minaaseke ardi'a uwwemeeki qadaadi konneechchi butti'a hedheeken. Minaaseki angafa Gele'adiki anni Makiri loliik ege'nemeeke janna kadeemmaxxee Galadikanna Baasaanika boga isike qadaada kadaashsha uune. <verse eid="JOS 17:1" /><verse number="2" style="v" sid="JOS 17:2" />Yordaanoosi'n dhidhimi darre'n hedheeki bogi wele gatteexxe Minaasexxe ooseke, Abi'eezerike, Heleqike, Asiri'eelike, Sekemike, Heferikenna Shemida'ike aanchi aanchi ardi'a uwweme. Yooseefike belto Minaasexxe labbaxxe ooseeki aanchi aanciki ardi konneechchinn buttiaa hedheeken.<verse eid="JOS 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 17:3" />Tselehaadi Heferik belti, Heferii'i Geli'adiki belt, Gele'adi'i Makiriki belit, Makiri Minaasek belton. Tsele'adi kunni dubarra male'e labbaxxa oose afeemmabaan; isike ondi dubarri summi Mahila No'a, Hogila, Milkanna Tirtsa hiyyemaamman. <verse eid="JOS 17:3" /><verse number="4" style="v" sid="JOS 17:4" />Inisa'nenna qeessichcho Ali'aazaaribaa Neeweka belto Iyyaasuba'anna ookkone akekisanjuwwibaa marreexxi «Duuchchi Woddik Gootti Muuse no'aa no'oxxe gosake labbalinshann geego uwwo'a ajaje'en» hine. Tennexxe Duuchchi Woddiki Gootti ajajemashan Iyyaasu insa'n'a insa'nexxe gosake labbalinshann geego uwwe.<note caller="-" style="x"><char style="xo" closed="false">17:4 </char><char style="xt" closed="false"><ref loc="NUM 27:1-7">Lak. 27:1-7</ref>. </char></note> <verse eid="JOS 17:4" /><verse number="5" style="v" sid="JOS 17:5" />Minaase'a Yordaanoosike galani'n boroti darre'n hedheeke Gele'adikenna Baasaanike bogi gadhidare welebaa'n tomme insa'ne geyaaka qoobo anfenn <verse eid="JOS 17:5" /><verse number="6" style="v" sid="JOS 17:6" />Minaasexxi horte dubarri kinna labbaliinshanni geyaaka geego alfineemmaxxe'e Gele'adiki bogi wele gatteexxe Minaasexxee horte'a uwweme.<verse eid="JOS 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 17:7" />Minaaseke minike ardke geegixxi gabala Aseerike minike ardixxe gabalana'n kexxeexxi Sekemii'ni boroti darre'n hedheeke Mikimetaatike qachchi qico'n marte geltaan; ookkonna bita'i darre'n saxxexxi Enitaaphu'ahik ardi hedheeka boga mitteba abiddaan. <verse eid="JOS 17:7" /><verse number="8" style="v" sid="JOS 17:8" />Taapuhak bogi Minaase'a geeyake geegomman; kaddomale Taaphuwwake bogixxe gabala'n hedheeki shiixxooki qachchi Efireemixxe horteke geegomman. <verse eid="JOS 17:8" /><verse number="9" style="v" sid="JOS 17:9" />Gabalatinna ookkoo'ni kexxexxi Qaanake galani qicon geltaan; Qaanake galaani bita'i darre'n hedheeki qachchuwwi Minaase'e geegi giddo hedheeke kadoole ookko'n giddon Efireemixxe horteki qachchuwwinna hedhemman; Minaasexxi gabala mididare'n Qanaga galanixxa duuka Mediteraanixxe Abbaayya'n marte uurrtaan. <verse eid="JOS 17:9" /><verse number="10" style="v" sid="JOS 17:10" />Tennenaa'n kexxeexxa dhidhimii darrexxi lamingixxi gabala Mediteraaniyanixxe Abbaayya kaddaa wodda bita'ii darree'n Efireemi middi darre'n kinni Minaasexxe horteke geegomman; middi darre'n Aseeri boroti darre'n Yisakoorixxe horte'a geyeek qadaadamman.<verse eid="JOS 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JOS 17:11" />Iittanni Minaaseke qadaada kadeeki Yisakoorkinna Aseerike bogi giddo hedheeki qachchuwwinna qarqara hedheeki shiixxarammi qachchuwwi; Beetisheninna qarqara iseke'ni hedheeka shiixxaramma qachchuwwin, Yibili'ami qarqara iseke'n hedhemmake shiixxramma qachchuwwik, Indoorik ardi, Ayindoori, Ta'inakinna, Megido, kunni duuchchi qariqara hedhemmake shiixxaramma qachchuwwi welti Minaaseke geego kade; sakkake laakkoosa'ni Naaphotiten<note caller="+" style="f"><char style="fr" closed="false">17:11 </char><char style="ft" closed="false">Tinninna Naafoti Doorite.</char></note> <verse eid="JOS 17:11" /><verse number="12" style="v" sid="JOS 17:12" />kaddo malee Minaasexxe horte ardi Kanika arda shorreexxi konne qachchuwwa dande'e abidebaan. Tennexxee Kenaanik ardi ookkoo'ni fulebaang gate. <verse eid="JOS 17:12" /><verse number="13" style="v" sid="JOS 17:13" />Isira'eeliki ardi hunna lephpha'ni me'oolenna Kenaanika arda duuchcha shorrebaan; yaane kinni jabaxxa huje hunnati hujinsa'nemman.<note caller="-" style="x"><char style="xo" closed="false">17:13 </char><char style="xt" closed="false"><ref loc="JDG 1:27-28">Hay. 1:27-28</ref>. </char></note><verse eid="JOS 17:13" /></para>
  <para style="s1">Efireemikinna Minaaseke Miniki Gamisi Ardi Boga lebo'a Laqedhe</para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 17:14" />Isira'eelii Yoosefi miniki ardi Iyyaasu «Duuchchi Woddik Gootti eebbisena'a horte no'oxxi ba'laxxen, maye no'a mitte hixika qoobbo calla uutette?» Hiyye qore. <verse eid="JOS 17:14" /><verse number="15" style="v" sid="JOS 17:15" />«Iyyaasunna horte ha'nooxxe ba'laxxe kunni Efireemi koobacallik bogi ha'no'a shiixxedhoole martinexxi Feeriizitotinna Raafayike ardika boga a'ne.»<verse eid="JOS 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 17:16" />Insa'nenna «Kunni koobacalliki bogi no'o geeyakebaan; Iyyizira'eelixxe dhooqaki Beetishanke qachchikinna qarqara hedheeke shiixxaramma qachchuwwiki ittann diidicallike boga'n hedheeki Kenaanik manni duuchchi loliinxe gaaruwwa afe'en» hine.<verse eid="JOS 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 17:17" />Iyyaasu Isira'eeli Efireemike mini'ana Yordaanoosi'ni dhidhimi darre'n hedheeke Isira'eeli Minaaseke minika arda hiyyee qici: «dhugaandinn ha'nooxxi horte ba'laxxen; hunna ha'nooxxinna jabaxxen; ha'no qoobbi mitte hixa calla kadabaan. <verse eid="JOS 17:17" /><verse number="18" style="v" sid="JOS 17:18" />Yaane kinni kooba calliki bogi ha'nooke kadaan gongoma andine gabalate'n gabalati qico'n abixxitine'e afike assedhe; Kenaanik ardi loliinxa fadhadiinxa gaaruwwanna jabaxxa hunna afeke kadoolenna ha'no insa'nee bogakenaa'n goshshine'e shorra dandeettinaan.»<verse eid="JOS 17:18" /></para>
  <chapter eid="JOS 17" />
  <chapter number="18" style="c" sid="JOS 18" />
  <para style="s1">Gatemmake Bogika Qooddo</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 18:1" />Injifate boga abideechchi udumi'a Isira'eeliki ardi duuchchi Seelo bukki hiyyeexxi Mageno magenoonfataaka duunkaana ookko olte.<verse eid="JOS 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 18:2" />Isira'eelike ardinaa'n qadaada alfemmabaaki gateemmaki torbaani Isira'eelixxe gosaki mini hedheemman. <verse eid="JOS 18:2" /><verse number="3" style="v" sid="JOS 18:3" />Tennexxe Iyyaasu Isira'eelike ardi'a iyyee qici: «Duuchchi Woddik Gootti ha'nooke annuwwiki Mageni adhdhitino'a ha'no'aa uwweemmaka boga hitta abixxitinebaaki turtina? <verse eid="JOS 18:3" /><verse number="4" style="v" sid="JOS 18:4" />Sase sase manjo ookkone Isira'eelixxe gosake torbaane minina'n fille, ookkone bogi giddo duuchcha mammareme'e bogi hitta hedheexxa towante borreessinaashsha ergannon. Oookkoneechchi uduma insa'ne illee iima hinge'e anibaa dangaan. <verse eid="JOS 18:4" /><verse number="5" style="v" sid="JOS 18:5" />Insa'ne towantaaki bogi torbaane Isira'eelike mini'a qoodemaan. Yihudake miniki ardi bita'i darre'n Yooseefike miniki ardinna middi darre'n uwwememmaka ifi finga qoobbo'n he'naan. <verse eid="JOS 18:5" /><verse number="6" style="v" sid="JOS 18:6" />Konne torbaaneba qoodemake boga leelshaaxxa borro anib'a iyyedagine'naa Duuchchi Woddika Gootta ha'nooke Mageni edo ha'no'aa hixa ibinsannon <verse eid="JOS 18:6" /><verse number="7" style="v" sid="JOS 18:7" />Leewwitotike miniki ardiki qoobbi qeesummati Duuchchi Woddike Gootti'a ergatatee kadeemmaxxe'e ha'noosha insa'ne geyaaki bogiink qoobbi hedhabaan. Roobelik, Gaadikinna gamisi Minaaseke miniki ardi Yordaanoosike galaananaa'ni boroti darre'n hdheeka boga Duuchchi Woddike Goottiki erganji Muuse ediseenni insa'ne'a uwwena'a adhine'en.»<verse eid="JOS 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 18:8" />Manni boga dooyyat me'ebaa edi darre Iyyaasu, «Boga okkone duuchcha'ni mammaremme; borreesitine anibaa illee iima dagge ani kaba Seelonni Duuchchi Woddik Gootti laqe hixa ha'no'aa ibisannooni» hiyye ajaje. <verse eid="JOS 18:8" /><verse number="9" style="v" sid="JOS 18:9" />Manni kinna bogi giddo duuchcha mammaremeexi qachchuwwi duuchchi hitta torbaane minike ardi'a qoodemaaxxa borroti shiqinse. Ookkoneechchi uduma Iyyaasu hedhdheeba Seelo'a hinge dange. <verse eid="JOS 18:9" /><verse number="10" style="v" sid="JOS 18:10" />Iyyaasunna Seelo Duuchchi Woddika Gootta laqeexxi hixa ibisee; wele gateek Isira'eelik mitte mittenge mini'a arda insa'neke ba'liniinxe qixxe'n boga qoode.<verse eid="JOS 18:10" /></para>
  <para style="s1">Biiniyamike Minike Ardi'a Uwwemeeka Boga</para>
  <para style="m">
    <verse number="11" style="v" sid="JOS 18:11" />Biiniyamike minike ardi'a geyeeki geegi uwweme: insa'ne'a uwwemeeki bogi Yihudanna Yooseefike minike ardixxe oddo'niten: <verse eid="JOS 18:11" /><verse number="12" style="v" sid="JOS 18:12" />Inisa'neke bogixxi gabala Yordaanoosik galaananaa'ni kexxeexxi Iyyaarikoke middanaa'ni alallee qabate fuldeexi dhidhdhim darrenaa'ni hedheek koobati bogi giddii'n saxxeexi Beeti'awween hinaaka gammoojje qiilla qico'n marte gelteen: <verse eid="JOS 18:12" /><verse number="13" style="v" sid="JOS 18:13" />Tinni gabala bita'i darre'ni edi wodda Looza hinammake Beeti'eeli'a alalle sa'eexxi adadde Beetihoronexxe kooba gamii'ni adaddee Axaaroti Adaarike qachchibaa dirraan. <verse eid="JOS 18:13" /><verse number="14" style="v" sid="JOS 18:14" />Tinnii gabala wele gamanaa'ni tenne koobake dhidhiminaa'n bita'i darre'n wirri hiteexxi Qiriyatibaali yookaani Qiriyatiyi'aarimi hiyyemaake Yihudake gosati minike ardike qachchiba'a saxxe'e me'itaan; Tinni dhidhimi darrexxe gabalan. <verse eid="JOS 18:14" /><verse number="15" style="v" sid="JOS 18:15" />Bita'i darexxi gabala dhidhimi darree'n Qiriyatiyi'aarimike kasanaa'ni kexxe'e Nefitohaake qachchixxe muummuwaba'a saxxe me'itaan <verse eid="JOS 18:15" /><verse number="16" style="v" sid="JOS 18:16" />Ookko'inna gabala Henomike beltixxe Dhooqa albi edo hexxeexxe kooba hundi dirree'ni muguggi hiyyaan; tinni koobanna Raafayimixxe dhooqaba'n middi darre'ni hexxeexxen. Ookko'ni kexxeexxi bita'i darre'n Henomixxe dhooqaba'n saxxe'e Iyyaabusake ardke bogike kasanaa'n saxxe'e Enirogeeli geltaan. <verse eid="JOS 18:16" /><verse number="17" style="v" sid="JOS 18:17" />Ookkoneechchi uduma middi darre'n Ensheemeshi'a wirritaan; ookko'inna Aduumimixxe tarbake ori alibi edo Geelilootia me'itaan; iittanni Roobelike beltika kinjo Boohaanibaa dirritaan. <verse eid="JOS 18:17" /><verse number="18" style="v" sid="JOS 18:18" />Middi darre'n Betiraabake kaasana'n saxxexxi adade Arebaa dirritaan. <verse eid="JOS 18:18" /><verse number="19" style="v" sid="JOS 18:19" />Gabala middi darre'n Beetihogilake kasana'ni saxxeexxi bita'idarre'n Yordaanoosike galaani mare e'yaake Maxinetixxe Abbaayya qico'ni qaxxaamure sa'aan. Tinninna bita'i darrexxe gabalaan. <verse eid="JOS 18:19" /><verse number="20" style="v" sid="JOS 18:20" />Boroti darrexxi gabala Yordaanoosike galaanan. Tinni duuchchi Biiniyamike minike ardi'a uwwemeeke bogixxe duuchchi darrexxe gabalan.<verse eid="JOS 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 18:21" />Biiniyamike minike aanchi aanchike ardiki qachchuwwi Iyyaariko, Beetihogila, Emeqeetsetsi, <verse eid="JOS 18:21" /><verse number="22" style="v" sid="JOS 18:22" />Beeti'araba, Zemarayimi, Beeti'eeli, <verse eid="JOS 18:22" /><verse number="23" style="v" sid="JOS 18:23" />Awiimi, Faara, Ofira, <verse eid="JOS 18:23" /><verse number="24" style="v" sid="JOS 18:24" />Kefara'ayinay, Tsofininna Geba'i hiyyemaake laakkoossiki tomenna lamme qachchuwwanna qarqarake'n hedhemmake shiixxaramma qachchunni mittenba. <verse eid="JOS 18:24" /><verse number="25" style="v" sid="JOS 18:25" />Welikinna Geba'ooni, Raama Be'eeroti, <verse eid="JOS 18:25" /><verse number="26" style="v" sid="JOS 18:26" />Mitsiphpha, Keefiira, Mootsa, <verse eid="JOS 18:26" /><verse number="27" style="v" sid="JOS 18:27" />Reeqeemi, Yirphe'eeli, Taraala, <verse eid="JOS 18:27" /><verse number="28" style="v" sid="JOS 18:28" />Tsela'i, Elefi, Iyyaabusi yookaan Iyyerusaalemi Gibi'a iittann Qiryatitemman qarqara insa'neke'ni hedheemmak loolk laakkoosinna tommenna shoole qachchuwwaman. Yoonna kunni duuchchi Biiniyamike miniki aanchi aanchike ardi'a uwwemeeken.<verse eid="JOS 18:28" /></para>
  <chapter eid="JOS 18" />
  <chapter number="19" style="c" sid="JOS 19" />
  <para style="s1">Simoonike Gosati Mi'a Uwwemeeka Qadaada</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 19:1" />Langaki hixi Simoonike minike aanchi aanchike ardi'a ibe; insa'ne'aa uwwemeemmaki bogi Yihudake gosati minike ardike bogi giddi'a e'yeemman. <verse eid="JOS 19:1" /><verse number="2" style="v" sid="JOS 19:2" />Kunniirinna Bersaabehi'ki, Sheebak, mooladaki <verse eid="JOS 19:2" /><verse number="3" style="v" sid="JOS 19:3" />Hatsarishu'aalik, Baalaki, Etseemik, <verse eid="JOS 19:3" /><verse number="4" style="v" sid="JOS 19:4" />Eltolaadik, Betuuliki, Horimaki, <verse eid="JOS 19:4" /><verse number="5" style="v" sid="JOS 19:5" />Tsiqilaagi, Beetimarikabootiki, Haatsaarisuusak <verse eid="JOS 19:5" /><verse number="6" style="v" sid="JOS 19:6" />Beetileba'otinna Shaaruheeni hiyyemeeka tommenna sasi qahchcuwwinna konne qachchuwwike qarqara'n hedheemmaki shiixxarammi qachchuwwinni mitteban.<verse eid="JOS 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 19:7" />Konneerinn welt weli Ayyini, Rimooni, Eterinna Ashaani hiyyemaak shool qachchuwwinna konnee qachchuwwi qarqara'n hedheemmake shiixxarammi qachchuwwi. <verse eid="JOS 19:7" /><verse number="8" style="v" sid="JOS 19:8" />Iittanni bita'i darre'n Ba'ilatibe'eeri yookaan Raamaati qico'n hedheeka qachchuwanna konnee qachcuwwi qarqara hedheemmaka shiixxaramma qachchuwwa mitteba abideetemman; kunni Simoonike gosati mini minike aanchi aanchike ardi'a uwwemeeke bogi konnetemman.<note caller="-" style="x"><char style="xo" closed="false">19:8 </char><char style="xt" closed="false"><ref loc="1CH 4:28-33">1 Odo. 4:28-33</ref>. </char></note> <verse eid="JOS 19:8" /><verse number="9" style="v" sid="JOS 19:9" />Yihudake minike ardi'a uwwemeeki bogi yo'oshsha ba'lake kadeemmaxxee Simoonike gosati minike ardi'a Yihudake gosati minike qoobbonaa'n qadaadummati uwweme.<verse eid="JOS 19:9" /></para>
  <para style="s1">Zabiloonike Gosati Minike Ard'a Uwwemeeka Qadaada</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 19:10" />Sakkaki hixi Zabilonike minike aanchi aanchike ardi'a ibe; insa'ne'aa uwwemeeki bogi Saariidi qachchi qico'n mare geyeeken. <verse eid="JOS 19:10" /><verse number="11" style="v" sid="JOS 19:11" />Ookko'n kexxeexxi insa'nexxi gabala Mere'alaba fuleexxi Dabashetem qico'ni Yooqine'aamike qachchuwwiba dhidhimi darre'n hedheek galaanixxa duuka me'ita'n boroti darre'n Mari'ila qachchi qico'n marite geltaan. <verse eid="JOS 19:11" /><verse number="12" style="v" sid="JOS 19:12" />Saariidii'n boroti darre'n wirri hita'n Kisilooti Taabori darree'n saxxe'e Dabiratinna Yaafi'a marte geltaan. <verse eid="JOS 19:12" /><verse number="13" style="v" sid="JOS 19:13" />Ookko'ninna boroti darre'n Rimoonike qachchiba'a me'inammake oranaa'n Nii'ake qachchibaa wirri hiteexxi Gaatiheferinna Itiqaatsinike qachchixxa kute saxxaani. <verse eid="JOS 19:13" /><verse number="14" style="v" sid="JOS 19:14" />Middi darrexxi gabala Hanatoonii'ni kutte saxxee Yifita'elixxe Dhooqa'n marte lufi hittaan. <verse eid="JOS 19:14" /><verse number="15" style="v" sid="JOS 19:15" />Iitta'n Qaxaatike, Nahilaalike, Shimiroonike, Yidaalake, Beetelihemike qachchuwwinni welt laakkoossiki tommenna lame qachchuwwanna qarqara hedhemmaka shiixxaramma qachchuwwa mitteba bukki asse abidaan. <verse eid="JOS 19:15" /><verse number="16" style="v" sid="JOS 19:16" />Tennexxe Kunni qachchuwwinna qarqara hedhemaki shiixxarammi qachchuwwi Zabilonike minke aanchi aanchi ardi'a uwwemeemmake geegomman.<verse eid="JOS 19:16" /></para>
  <para style="s1">Yissaakoorike Geego Kade Uwwemeeka Boga</para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 19:17" />Sholniingi hixi Yisakoorike aanchi aanchi ardi'a ibe, <verse eid="JOS 19:17" /><verse number="18" style="v" sid="JOS 19:18" />Insa'neke bogi giddo Iyyizira'eelik, Keslootik, Sunemik, <verse eid="JOS 19:18" /><verse number="19" style="v" sid="JOS 19:19" />Hafarayimik, Shi'oonik, Aanaharatinik, <verse eid="JOS 19:19" /><verse number="20" style="v" sid="JOS 19:20" />Raabitki, Qisoonik, Abeetsiki, <verse eid="JOS 19:20" /><verse number="21" style="v" sid="JOS 19:21" />Reemeetik, Eniganimik, Eeniganiimkanna Beetiphatsiniki qachchuwwi afemaan. <verse eid="JOS 19:21" /><verse number="22" style="v" sid="JOS 19:22" />Gabala insa'nexxi Taaboorixxa kooba Shahatsumakanna Beetisihemeshika qachchuwwa duuka me'texxi Yordaanoosike Galaana'n marte uurritaan. Kunni laakkoossik tommenna jaane qachchuwwanna qarqara hedheeke shiixxaramma qachchuwwa mitteba abideeten. <verse eid="JOS 19:22" /><verse number="23" style="v" sid="JOS 19:23" />Tennexxe kunni qachchuwinna qarqarake'n hedheeke shiiaxarammi qachchuwwi Yisakoorike minike aanchi aanchike ardi'a uwwemeeke geegi giddo hedheeke qachchuwamman.<verse eid="JOS 19:23" /></para>
  <para style="s1">Asseerike Minike Aanchi Aanchike Ardi'a Uwwemeeka Geego</para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 19:24" />Ondiki hixi Aseerike minike aanchi aanchike ardi'a ibe; <verse eid="JOS 19:24" /><verse number="25" style="v" sid="JOS 19:25" />Insa'neke bogi giddo Heliqaatii'i, Halii'i, Beexeniki, Akishafii'i, <verse eid="JOS 19:25" /><verse number="26" style="v" sid="JOS 19:26" />Alamelekeki, Ami'adinikinna Mishi'aalik qachchuwwi afemaan. Dhidhimi darrexxi gabala Qermeeloosixxanna Shihoorilibinatixxa duuka me'itaan. <verse eid="JOS 19:26" /><verse number="27" style="v" sid="JOS 19:27" />Boroti darre'n Beetidaagoni'a wirri hiteexxi Zabilonixxenna Yiftahi'elixxe Dhooqaxxa duuka me'iyoti Kabulii'i bita'i darre'n gatisseexxi middi darre'ni Beeti'emeqinna Ni'eeli marite geltaan. <verse eid="JOS 19:27" /><verse number="28" style="v" sid="JOS 19:28" />Ookko'inna edi'a me'iteexxi Ebrooni<note caller="+" style="f"><char style="fr" closed="false">19:28 </char><char style="ft" closed="false">heddo Ibritotixxi tikuwwa tennenni weli aaggaan; yaane kinni heenoxxi tikuwwa Iya 21:30 uudi, </char><char style="fqa" closed="false">Abiyuun </char><char style="ft" closed="false">hitaan. </char></note>, Rehoobi Hamooni'ninna Qaanaa'n saxxe lumoxxe Sidoona qico'n geltaan. <verse eid="JOS 19:28" /><verse number="29" style="v" sid="JOS 19:29" />Gabala kollifachchotike Xiroosike qachcha marte geltee'e Raama'a wirr hitaan; ookko'inna Hosa'a wirri hiteexxi Akizibi darre'n Meditiraanixxe abbaayya'n marte uuritaan. <verse eid="JOS 19:29" /><verse number="30" style="v" sid="JOS 19:30" />Kunninna Uumake, Afeeqikenna Rehoobike qachchuwwinni welt lame tommenna lame qachchuwwinna qachchuwwi qarqara hedheeka shiixxarammi qachchcuwwa mitteba abideeten. <verse eid="JOS 19:30" /><verse number="31" style="v" sid="JOS 19:31" />Tennexxee kunni qachchuwwinna qarqarake'n hedhemmak shiixxaramm qachchuwwi Aseerike gosati minike aanchi aanchike ardi'a uwwemeemmake geegon.<verse eid="JOS 19:31" /></para>
  <para style="s1">Nifitaalemike Minike Aanchi Aanchike Ardi'a Uwwemeeka Geego</para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 19:32" />Jiyak hixi Nefitaalemike minike aanchi aanchike ardi'a ibe.<verse eid="JOS 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JOS 19:33" />Insa'neke bogixxi gabala Halefinna Tse'ineenimi hedheeke lumoke Qilixxiba'n kexxeexxi Adamineqeebi'ninna Yaminiya saxxe'e Laqumi'a daga'n marte Yordaanoosike galaana'n uurritaan. <verse eid="JOS 19:33" /><verse number="34" style="v" sid="JOS 19:34" />Ookkoneechchi uduma gabala dhidhimi darre'n Azinotitaabori'a wirri hiteexxi Huqooqi'a toggi hite me'itaan. Tinni gabala bita'i darre'n Zabiloni dhidhimii darre'n Aseeri Yordaanoosike galaani boroti darre'n Yihudaten. <verse eid="JOS 19:34" /><verse number="35" style="v" sid="JOS 19:35" />Iittanni kollifanteemmaki qachchuwwi Tsidimi, Tseeri, Hamaati, Raaqaati, Kenereeti, <verse eid="JOS 19:35" /><verse number="36" style="v" sid="JOS 19:36" />Adaama, Raama, Hatsoori, <verse eid="JOS 19:36" /><verse number="37" style="v" sid="JOS 19:37" />Qaadeesi, Edire'i, Enihatsoori, <verse eid="JOS 19:37" /><verse number="38" style="v" sid="JOS 19:38" />Yiri'onni, Megidaali'eeli, Horemi, Beeti'anatinna Beetishemeshi laakkoossi tommenna sallane qachchuwwanna qarqarake'n hedheeke shiiaxaramma qachchuwwinni mitteba. <verse eid="JOS 19:38" /><verse number="39" style="v" sid="JOS 19:39" />Tennexxe kunni qachchuwwinna qarqara hedheeki shiixxarammi qachchuwwi Nefitaalemike minike aanchi aanchike ardi'a uwwemeke bogi giddo hedheeken.<verse eid="JOS 19:39" /></para>
  <para style="s1">Daanike Minike Aanchi Aanchike Ardi'a Uwwemeeka Geego</para>
  <para style="p">
    <verse number="40" style="v" sid="JOS 19:40" />Torbaki hixi Daanike minike aanchi aanchike ardi'a ibe, <verse eid="JOS 19:40" /><verse number="41" style="v" sid="JOS 19:41" />Boga insa'neki giddo Tsoori'ak, Eshita'oolik, Irishemeshiki, <verse eid="JOS 19:41" /><verse number="42" style="v" sid="JOS 19:42" />Sha'alibimik, Ayyaloonik, Yitaalaki, <verse eid="JOS 19:42" /><verse number="43" style="v" sid="JOS 19:43" />Eeloonii'i, Timinak, Aqaroonik, <verse eid="JOS 19:43" /><verse number="44" style="v" sid="JOS 19:44" />Eliteeqe, Gibetooniki, Ba'ilatiinki, <verse eid="JOS 19:44" /><verse number="45" style="v" sid="JOS 19:45" />Yihuudiki, Beeneberaaqiki, Gaatirimoonin, <verse eid="JOS 19:45" /><verse number="46" style="v" sid="JOS 19:46" />Meyariqoki qachchuwwinna iittanni Iyyophee qarqarike boginni welt Raaqoonik qachchi hedheen.<verse eid="JOS 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JOS 19:47" />Daanike miniki aanchi aanchiki ardi insa'ne'a geyaa boga dandeene abixxa gonphee wodda Layishi mareexxi ookkone qachcha lole abinde, ardakanna shinne birreexxi qachcha ifike asse'ne ookkoo ofolle; qachchika summanna jijiirrexxi ifike hundaayyetike annika summa Daani hine fulchine.<note caller="-" style="x"><char style="xo" closed="false">19:47 </char><char style="xt" closed="false"><ref loc="JDG 18:27-29">Hay. 18:27-29</ref>. </char></note> <verse eid="JOS 19:47" /><verse number="48" style="v" sid="JOS 19:48" />Tennexxe kunni qachchuwwinna qarqarake'n hedheeki shiixxarammi qachchuwwi Daanike minike aanchi aanchi ardike geegon.<verse eid="JOS 19:48" /></para>
  <para style="s1">Iyyaasu'a Uwwemeeka Geego</para>
  <para style="p">
    <verse number="49" style="v" sid="JOS 19:49" />Isira'eeliki ardi boga qoodeme'e ifi ifika qoobbo abixxinchinni udumi'a Iyyaasu'u Neeweke belti'a geyaaka boga uwwe. <verse eid="JOS 19:49" /><verse number="50" style="v" sid="JOS 19:50" />Duuchchi Woddik Gootti ajajemmashshanni kooba callike Eefireemike bogi giddo uuno'a laqeeka Teminaseera hiyyemaaka qachcha uune. Isinna ookkone qachcha qammalcheexxi ookko ofo'le. Mageni ajajemmashshanni Efireemike koobatike boga'ni afendaaxxa Teminaasera hiyyendaaxxa Feleegatika qachcha uune; isinna hiisseexi qachcha ijaare; galdumi boonno assedhe.<verse eid="JOS 19:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JOS 19:51" />Qeesichchi Ali'aazaar Neewek belti Iyyaasunna Isira'eeliki minike ardika akeekisanjuwwi Seelo afenshatike duunkaanixxe baxxe'n Duuchchi Woddike Gootti edo Isira'eelike ardi'a hixiki qoondemmaki geegi konneten. Konne qicinetemman boga qoonde birreek.<verse eid="JOS 19:51" /></para>
  <chapter eid="JOS 19" />
  <chapter number="20" style="c" sid="JOS 20" />
  <para style="s1">Danoti Manjo Shyeeki Baaje Ofo'laaka Qachchuwwa</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 20:1" />Ookkoneechchi uduma Duuchchi Woddik Gootti Iyyaasu'u hiyyee qici: <verse eid="JOS 20:1" /><verse number="2" style="v" sid="JOS 20:2" />«Muuse darree'ni ha'noo'n kulenne qicishsha danoti manjo shiyeeki manji itti baajaaka qachchuwwa fi'linaashsha Isira'eeli'aa kuli; <verse eid="JOS 20:2" /><verse number="3" style="v" sid="JOS 20:3" />ayyinna danoti manjo shiyoole ookko'a baajiyyot halo fulo'a hasaake manjinna anjiremaan.<verse eid="JOS 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 20:4" />«Manijo shiyeeki manji konne qachchuwwinaa'n mittinbaa baaje mare qachchixxe hulaxxe songo'n murte uutammaxxe geedhe edo shiqeexxi kaddeexxa yaane insa'ne'ni kulaan. Ookkoneechchi uduuma insa'ne isoo qachchi giddi'a e'yaashsha assineexxi hedhaa boonchonna une'na'a ookko hedhaan. <verse eid="JOS 20:4" /><verse number="5" style="v" sid="JOS 20:5" />Halo fulo'a isoo hasa'neeki maniji hordofe dagoole, iikki manji shiyeechchi danotite male halo fulatete kada gopheemmaxxe'e qachchi giddi manni isoo abide uwwoqqe. <verse eid="JOS 20:5" /><verse number="6" style="v" sid="JOS 20:6" />Songote'n shiqe'naa'a murte uwwenidaa qico'inna ookkone baro'n hedheeki qeesetiki umo kadeeki qeesichchi reyaa qico'n ookkone qachchi giddo turowwaal. Ookkoneechchi uduma mine ifike'n, baaje dagemmake qachchibaa higaan.»<verse eid="JOS 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 20:7" />Tennexxe Isira'eeliki ardi koobatika Nefitaalemike bogi giddo hedheeka Geliilaka qachcha; Efireemike koobatike bogi giddo hedheeka Qaadeesi hiyyemmaka Sekemika qachchanna Yihudake kooba callike bogi giddo hedheeka Kebiroonite hiyyemmaka Qiriyati'arbaaqika qachcha file. <verse eid="JOS 20:7" /><verse number="8" style="v" sid="JOS 20:8" />Iittanni Yordaanoosi galaani wido Iyyaarkoo'n boroti darre'n hedheeke gammoojje qiilli giddo Roobelike minike ardike boganaa'n Beetseerika qachcha, Gaadixxe galcha giddo Gele'adike boganaa'n Raamotika qachchanna Minaaseke minike ardike boginaa'n Baasaani hedheeka Golaanika qachcha foone. <verse eid="JOS 20:8" /><verse number="9" style="v" sid="JOS 20:9" />Kunni qachchuwwi Isira'eelik ardi'anna insa'ne giddo keessummumma ofo'leeki manni danoti manjo shiyoole songote'n murte uwwendebaaki halo fulo'a hasaaki isoo shiyebaasha konne qachchcuwwi giddi'ni mittibaa banje'e lubbo gato'a filemeeke qachchuwwan.<verse eid="JOS 20:9" /></para>
  <chapter eid="JOS 20" />
  <chapter number="21" style="c" sid="JOS 21" />
  <para style="s1">Leewwike Minike Ardi'a Uwweeemka Qachchuwwa</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 21:1" />Leewwik gosatik minik aanchi aanchike ardiki sooresuwwi qeesichcho Ali'aazaaribaa, Neeweke belto Iyyaasubaanna Isira'eelixxe gosake minike aanchi aanchike ardike sooresuwwibaa marre. <verse eid="JOS 21:1" /><verse number="2" style="v" sid="JOS 21:2" />Kenaanike bogi giddo Seeloke qachcha'n insa'nebaa marreexxi «Duuchchi Woddik Gootti Muuse'n hedhe no'o'a he'nannoki qachchuwwinna qarqara qarqarake'n hore alla'latee kadaaki bogi no'aa uwwemaashsha ajaje» hine.<note caller="-" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="NUM 35:1-8">Lak. 35:1-8</ref>. </char></note> <verse eid="JOS 21:2" /><verse number="3" style="v" sid="JOS 21:3" />Tennexxe Duuchchi Woddik Gootti ajajemmashshann Isira'eeliki ardi Leewwike minike ardi'a konneechchi butti'a hedheeka qachchuwwanna hore alla'latee kadaaka boga ifi ifike qoobbonaa'n uwwe.<verse eid="JOS 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 21:4" />Taakaki hixi Qa'aatike ardi'a ibe; Leewwike minike qeesichcho kadedheeke Aaroonixxe oose'a tommenna sase qachchuwwa Yihudake, Siimi'onikenna Biiniyamike ardike bogana'n hixiki qoonde <verse eid="JOS 21:4" /><verse number="5" style="v" sid="JOS 21:5" />Wele gateeke Qee'aatike ardi'a Efireemike, Daanikenna dhidhimi darre'n Minaaseke ardike boganaa'n tomme qachchuwwa hixiki qoonde <verse eid="JOS 21:5" /><verse number="6" style="v" sid="JOS 21:6" />Gershoonike ardi'a Yisakoorike, Aseerike, Nefitaalemikenna boroti darre'n Baasaani hedheeke Minaaseke ardike boganaa'n tommenna sasi qachchuwwi uwweme.<verse eid="JOS 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 21:7" />Meraarike aanchi aanchike ardi'a Roobelike, Gaadikenna Zabilonike ardike boganaa'ni tommenna lami qachchuwwi uwweme.<verse eid="JOS 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 21:8" />Muuse'n darree'n Duuchchi Woddik Gootti ajajemmashshanni Isira'eeliki ardi konne qachchuwwanna horiinxe alla'la'a kadaaka boga Leewwike minike ardi'a hixiki qoode. <verse eid="JOS 21:8" /><verse number="9" style="v" sid="JOS 21:9" />Yihudakenna Simoonike ardike qachchuwwanaa'n konneechchi butta summik kulemeek qachchuwwi uwweme; <verse eid="JOS 21:9" /><verse number="10" style="v" sid="JOS 21:10" />Taakkaki hixi insa'ne'a ibeemmaxxee Leewwike minike qeesichcho Aaroonixxe horte kadeeke Qe'atike ardi'a uwweme <verse eid="JOS 21:10" /><verse number="11" style="v" sid="JOS 21:11" />Yihudake koobati bogi giddo hedheeka Qiriyati'arbaaqi hiyyemaaka qachcha qarqarake'n hedheeke hore alla'latee kadaake boginninni welt insa'ne'a uwweme; isenna Kebiroon kunni Aribaqi hiyyemeek Enaaqike annamman. <verse eid="JOS 21:11" /><verse number="12" style="v" sid="JOS 21:12" />Kaddo malee qachchi qarqariki fichchuwwanna qarqarake'n hedhemmaki shiixxarammi qachchuwwi edi wodda Kaalebii'i Yifaaneke belti'a qadaadake kadaashsha uwwemeemman <verse eid="JOS 21:12" /><verse number="13" style="v" sid="JOS 21:13" />Iittitanni danoti manjo shiyeeki manji halo fulo'a hasaake manjinaa'n baajeexxi hedhammake qachchuwwi giddii'n Kebirooninna Libina qarqara qarqara'n hedheeke hore allalla'latike bogginni welti qeesichcho Aaroonixxe horte'a uwwe. <verse eid="JOS 21:13" /><verse number="14" style="v" sid="JOS 21:14" />Yaatirik qachchi, Eshiteemo'ak, <verse eid="JOS 21:14" /><verse number="15" style="v" sid="JOS 21:15" />Holooniki, qarqara qarqarke'n hore alla'latike boginninni welt, Debiri, qarqara qarqarake'n hore alla'latike boginninni welti, <verse eid="JOS 21:15" /><verse number="16" style="v" sid="JOS 21:16" />Ayyinii'i, qarqarake'n hore alla'latike boginninni, Yuuxa'a, qarqarake'n hore alla'latike boginninni, Beetishemeshii'i, qarqarake'n hore alla'latike boginninni Yihudakenna Siimi'oonike gosa gosati minike ardike boginaa'n qoodemee insane'a uwwemeeke sallane qachchuwwan. <verse eid="JOS 21:16" /><verse number="17" style="v" sid="JOS 21:17" />Biiniyamike gosati ardike boganaa'ninna qoodeme insa'ne'a uwweemmaki qarqara qarqarake'n hore alla'latike boginninni welti shooli qachchuwwi Geba'ooniki Geba'iki, <verse eid="JOS 21:17" /><verse number="18" style="v" sid="JOS 21:18" />Anatootikinna Aalimoonike qachchchuwwan. <verse eid="JOS 21:18" /><verse number="19" style="v" sid="JOS 21:19" />Qeese Aaroonixxe horte'a qarqara qarqarake'n hedheeke hore alla'latike boginninni welti tommeenna sase qachchuwwi insa'naa uwweme <verse eid="JOS 21:19" /><verse number="20" style="v" sid="JOS 21:20" />Wele gatteexxe Leewwike gosati minixxe Qe'aatixxe horte'a Efireemike gosati minike ardike boganaa'n konneechchi buttaa hedheeki qachchuwwi qoodemee insa'ne'a uwweme.<verse eid="JOS 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 21:21" />Koobatike Efireemike ardike bogi giddo hedheeki, danoti manjo shiyeeki manji baajeexxi lubbo gataammaki Sekemi qachchi qarqarake'n hedheeke hore alla'latike boginnnni welti, Geezeriki qachchi <verse eid="JOS 21:21" /><verse number="22" style="v" sid="JOS 21:22" />Qibitsayimikinna Beetihoronki qachchi qarqara qarqarake'n hedheeke hore alla'latike boginni welt shoole qachchuwwan.<verse eid="JOS 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JOS 21:23" />Daanike gosati minike ardike boganaa'n qoodemee insa'ne'a uwwemeeki qarqara qarqarake'n hedheeke hore alla'latike boginninni welti shooli qachchuwwi Eliteeqek, Gibetoniki, <verse eid="JOS 21:23" /><verse number="24" style="v" sid="JOS 21:24" />Ayyaloonikinna Gaatirimooni.<verse eid="JOS 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JOS 21:25" />Dhidhimii darre'n Minaaseke gosati ardike boganaa'n qoodemeexxi qarqara qarqarake'n hedheeke hore alla'latike boginninni welt insa'ne'a uwwemeeki lami qachchi Ta'inakinna Gaatirimoniten <verse eid="JOS 21:25" /><verse number="26" style="v" sid="JOS 21:26" />Kunni qarqara qarqarake'n hore alla'latike boginni welti tommi qachcuwwi gateemmaki Qee'aatike gosati miniki ardi'a uwwemeeken.<verse eid="JOS 21:26" /></para>
  <para style="b" />
  <para style="m">
    <verse number="27" style="v" sid="JOS 21:27" />Leewwike gosati minixxe horte'a, Gershoonike ardi'a uwwemeeki bogi konneechchi buttia hedheeken; boroti darre'n Minaaseke ardike boganaa'n qarqarake'n hedheeke hore alla'litike boginni welt uwwemeeke lame qachchuwinnaa'n mitti danoti manjo shiyeeki manji baajammake Baasaani giddo hedheeke gollanite he'naaxxa Goola qarqarake'n hore alla'latike boginninni welti Eshiteeraten. <verse eid="JOS 21:27" /><verse number="28" style="v" sid="JOS 21:28" />Yisakoorike gosati minike ardike boganaa'n insa'ne'a qoodeexxi uwwemeeki qarqara qrqarake'n hedheeke hore alla'latike boginninni welt shooli qachchuwwi, Qisoonik, Dabiratiki, <verse eid="JOS 21:28" /><verse number="29" style="v" sid="JOS 21:29" />Yarmuutikinna Eeniganiimiken. <verse eid="JOS 21:29" /><verse number="30" style="v" sid="JOS 21:30" />Aseerike gosati minike ardike boganaa'n qoodemeexxi insa'ne'a uwwemeeki shooli qachchuwwi, Mishi'aalik, Abidoonik, <verse eid="JOS 21:30" /><verse number="31" style="v" sid="JOS 21:31" />Heliqatikinna Rehoobitmmaen. <verse eid="JOS 21:31" /><verse number="32" style="v" sid="JOS 21:32" />Nefitaalemike gosati minike ardike boganaa'n qoodemeexxi insa'ne'a uwwemeeki qarqara qaraqake'n hedheeke hore alla'lalatike boginninni welti Geliila giddo hedheek manjo shiyeeki manji baajammaki sasi, Qaadeesik Hamotidorikinna Qartaanike qachchuwwan. <verse eid="JOS 21:32" /><verse number="33" style="v" sid="JOS 21:33" />Gershoonike gosati minike ardi'a uwwemeeki qarqara qarqarake'n hedheeke hore alla'latike boginninni welt duuchchiing mitteba tommenna sase qachchcuwwan. <verse eid="JOS 21:33" /><verse number="34" style="v" sid="JOS 21:34" />Leewwitotenaa'n gateeke Meraarike ardia'a Zabilonike ardike boganaa'n qoodemeexxi uwwemeeki qarqara qarqarake'ni hedheeke hore alla'latike boginninni welti shoole qachchuwwi Yooqine'aamik, Qaritaki, <verse eid="JOS 21:34" /><verse number="35" style="v" sid="JOS 21:35" />Dimoonanna Nahilaaliten. <verse eid="JOS 21:35" /><verse number="36" style="v" sid="JOS 21:36" />Roobelike gosati minike ardike boginaa'n qoodemeexxi insa'ne'a uwwemeeki qarqara qarqarake'n hedheeke hore alla'latike boginninni welti shooli qachchuwwi Beetseeriki, Yahaatsik, <verse eid="JOS 21:36" /><verse number="37" style="v" sid="JOS 21:37" />Qedemootikinna Mefa'aatikeeran. <verse eid="JOS 21:37" /><verse number="38" style="v" sid="JOS 21:38" />Gaadike gosati minike ardike boganaa'n qoodemeexxi insa'ne'a uwwemeeki qarqara qarqarake'n hedheeke hore alla'latike boginninni welti shooli qachchuwwi Gela'adike bogi giddo hedheeki Raamotik qachchi danoti manjo shiyemmaki manji baajaki, Mahinayimik, <verse eid="JOS 21:38" /><verse number="39" style="v" sid="JOS 21:39" />Haseeboninna Iyyazeeriten <verse eid="JOS 21:39" /><verse number="40" style="v" sid="JOS 21:40" />Gatteemmaxxe wele Leewwike minike Meraarike ardi'a qoodeme uwwemeeki tommenna lame qachchuwwan.<verse eid="JOS 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JOS 21:41" />Isira'eelike bogi giddo hedheeki Leewwike ardki qarqaraken hore alla'lammeke boginni welt shoole tommeenna saddeeta qachchuwamman <verse eid="JOS 21:41" /><verse number="42" style="v" sid="JOS 21:42" />Kunni mitti mittiniingi qachchuwwi qarqara qarqarake'n hore alla'latike boga afeemman.<verse eid="JOS 21:42" /></para>
  <para style="s1">Isira'eeli Ardi Boga Abixxeexxi Nage'a Alfee qico</para>
  <para style="p">
    <verse number="43" style="v" sid="JOS 21:43" />Tennexxe Duuchchi Woddik Gootti edike annuwwi'a uwwo'a kako aagemmaka boga Isira'eeli'a uwwe; insa'nena boga abixxine'e ifike ase'ne ofole <verse eid="JOS 21:43" /><verse number="44" style="v" sid="JOS 21:44" />Duuchchi Woddik Gootti edike annuwwi'a kako aagemmashshanni insa'neke bogi giddo nage'iki he'naashsha asse; Naaphuwwa lolle injifanitaashsha asseemmaxxe'e, huuni naaphinna edo uurre insa'ne'e lola dande'ebaan <verse eid="JOS 21:44" /><verse number="45" style="v" sid="JOS 21:45" />Konne qicinn Duuchchi Woddik Gootti Isira'eelike ardi'a aageexxi duuchchiinxi kako muuxxendee male'e mittetinna gatteexxi hexxebaan.<verse eid="JOS 21:45" /></para>
  <chapter eid="JOS 21" />
  <chapter number="22" style="c" sid="JOS 22" />
  <para style="s1">Iyyaasu Boroti Darre'ni Dageemmaka Gosa Gosaka Mini Hado Me'ashsha Asseexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 22:1" />Ookkoneechchi uduma Iyyaasu Roobeelika, Gaadikanna dhidhimi darre'n hedheeka Minaaseke minika arda ye'e bukki asseexxi, <verse eid="JOS 22:1" /><verse number="2" style="v" sid="JOS 22:2" />hiyyee qici: «Duuchchi Woddike Goottik erganji Muuse ajajemaka duuchchiinga ajaja muuxxineen, anaanna ajajendine'e hiyyennexxa duuchcha heqqexxineen.<note caller="-" style="x"><char style="xo" closed="false">22:2 </char><char style="xt" closed="false"><ref loc="NUM 32:20-32">Lak. 32:20-32</ref>; <ref loc="JOS 1:12-15">Iya. 1:12-15</ref>. </char></note> <verse eid="JOS 22:2" /><verse number="3" style="v" sid="JOS 22:3" />Konne wodda duuchcha Duuchchi Woddika Gootta ha'nooka Mageni'a ajajendine'e gosa ha'nooxxa Isira'eelika arda gargaartinee malee waaldineexxi yanna hexxebaan. <verse eid="JOS 22:3" /><verse number="4" style="v" sid="JOS 22:4" />Ta'a yoona Duuchchi Woddik Gootti ha'nooki Mageni kako aagemmashshann ha'nooxxe gosa'a Isira'eelike ardi'a nage'a uwween. Tennexxe Duuchchi Woddiki Gootti Erganji Muuse'a ha'no'aa uwweemmake Yordaanoosike galaani boroti darre'n hedheeke abixxinemmake bogibaa higgine me'we. <verse eid="JOS 22:4" /><verse number="5" style="v" sid="JOS 22:5" />Yaane kinni Duuchchi Woddike Goottik erganji Muuse Duuchchi Woddika Gootta ha'nooka Mageno eetinaashsha, ora isike duuchcha'n me'itinaashsha, ajaja isika muuxxinaashsha, isibaa shiqqineeke kaddinaashsha ittanni mitte godobininnaa mitte wodaninni isi'a ergatenidinsha ajejemmaka ajajanna seera isika jabaatine heqqedhdhe.»<verse eid="JOS 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 22:6" />Ookkoneechchi uduma insa'nee Iyyaasu hancufa biife'naa ifike minibaa me'ine. <verse eid="JOS 22:6" /><verse number="7" style="v" sid="JOS 22:7" />Minaaseke minike gamisi ardi'a Muuse Baasaaninaa'n boga uwweemman; gateeke gamisi'a kinni Yordaanoosike galaani'n dhidhimi darree'n gosa insa'nexxike bogi birii'n Iyyaasu boga insa'ne'a uwwe. Iyyaasunna mine insa'nekiba'a me'ino'aa geegeesse wodda eebbise'e; <verse eid="JOS 22:7" /><verse number="8" style="v" sid="JOS 22:8" />«Ta'a yoona ha'no heddo hore, heddo birreti sibiljo, worqe, sageettoti sibiljonna heddo seemma boojitinee aaginammaxxee konne boojitinemmachcho duuchcha gosa ha'nooxxinni welt qoodemme» hiyye.<verse eid="JOS 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 22:9" />Tennexxee Roobelik, Gaadikinna gamisi Minaaseke miniki ardi Kenaani bogi giddo Seelo hedheke Isira'eelike ardi birri'n ke'neexxi Muuse darre'ni Duuchchi Woddike Goottike ajajinni insa'ne'aa uwwemeemmake Gele'adike bogiba'a illee iima hinge.<verse eid="JOS 22:9" /></para>
  <para style="s1">Yordaanoosike Galaani Bira Gissineeka Tolchimalcho</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 22:10" />Roobelik, Gaadikinna gamisi Minaaseke miniki ardi Kenaanike bogi giddo Yordaanoosike galaani bira hedheeke Gelilotika qachcha genneexxi heenobaaka tolchimalcho giissine. <verse eid="JOS 22:10" /><verse number="11" style="v" sid="JOS 22:11" />Weli gateeki Isira'eeliki ardi Roobelik, Gaadiikinna Minaaseke miniki gamisi ardi Kenaani bogi giddo Yordaanoosike galani qarqara Isira'eelike geego'n hedheeke Geliloteke qachcha'n tolchimalcho giissineexxa laqe <verse eid="JOS 22:11" /><verse number="12" style="v" sid="JOS 22:12" />Isira'eeliki ardi tenne laqeexxi duuchching Seelo dage bukki hiyyoti insa'ne'n duulo'a qophpheefate.<verse eid="JOS 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 22:13" />Tennexxe Isira'eeliki ardi qeesichcho Ali'aazaarika belto Finihaasii'i Gele'adike bogi giddo hedheeke Roobelike, Gaadikenna Minaaseke minike gamisi ardibaa'a erge. <verse eid="JOS 22:13" /><verse number="14" style="v" sid="JOS 22:14" />Isinni welt tommi sooresuwwi hedhemman. Insa'nenna mitti mitting Isira'eelixxe gosake mitte mitte minixxe tukke kandeemmake aanchi aanchi ardike sooresuwwan.<verse eid="JOS 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 22:15" />Inisa'ne Roobelike, Gaadikenna boroti darre'ni hedhaaka Minaaseke minike gamis ardi hedhemmake Gele'adike bogibaa dangeexxi hinee qici: <verse eid="JOS 22:15" /><verse number="16" style="v" sid="JOS 22:16" />«Duuchchi Woddike Goottik ardi hiyyee qici ‹Hitta Duuchchi Woddika Gootta Isira'eelika Mageno hordofa waaldine iitta hexxeexxa elobaaxxa yaane asitina? Umo ha'nooke'n tolchimalcho giissiyote'e Duuchchi Woddike Gootti'n jalatinee'n.<note caller="-" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="DEU 12:13-14">Lan. 12:13-14</ref>. </char></note> <verse eid="JOS 22:16" /><verse number="17" style="v" sid="JOS 22:17" />Duuchchi Woddike Goottik ardi mufeti miidhemaqashsha assiteexxi telchi qico'ninna no'o daaffa'n hexxeexi Fegorixxi cubbo hanqatammaletee? <verse eid="JOS 22:17" /><verse number="18" style="v" sid="JOS 22:18" />Techcho ha'no Duuchchi Woddika Gootta hordofa gibbinee jallatinoole.</para>
  <para style="p" vid="JOS 22:18">« ‹Soodo isi Isira'eelike arda duuchcha'n mufataan. <verse eid="JOS 22:18" /><verse number="19" style="v" sid="JOS 22:19" />Ta'a kinni bogi ha'nooki batto'oole Duuchchi Woddika Gootta Magenoonfantaabi hedheeke Duuchchi Woddiki Gootti galaake bogiba'a fooffe; malee'e wele tolchika booncho ijaritinee Duuchchi Woddike Gootta'n yookaan no'on jallitinoqqe'e. <verse eid="JOS 22:19" /><verse number="20" style="v" sid="JOS 22:20" />Zaarahiki belti Akaani, balleesse bira hassisammaxxa yaane balleesse biragophiyoti ajaja sa'e wodda Duuchchi Woddiki Gootti mufate'e Isira'eelike arda duuchcha ganebaa? Akaani calla balleessa isixxe ganebaan.› »<verse eid="JOS 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 22:21" />Roobelik, Gaadikinna Minaaseke miniki gamisi ardi Isira'eelixxe gosake minike aanchi aanchi ardike akeekisanjuwwa'n hiyye hiissee qici, <verse eid="JOS 22:21" /><verse number="22" style="v" sid="JOS 22:22" />«Lumoki Mageni, Isi duuchchingike Goottan! Isi lumoke Mageno Duuchchi Woddike Goottan! No'o maaye'e tenne assinennexxa Isi'i ege'ne'en; ha'noona no'o maye'e assinennexxa egendino'a eenaannen. Duuchchi Woddike Gootta'n jalline'e seera isika sa'noonnole no'o shiwwe. <verse eid="JOS 22:22" /><verse number="23" style="v" sid="JOS 22:23" />Konnee tolchimalcho giisiinennechchi Duuchchi Woddike Gootta'n jalline'e ciincatika tolcha, midhatika tolcha yookaan mittoominka tolcha iti tolchinona'a hine'e kaddoole Duuchchi Woddiki Gootti no'o uudowwaal.<verse eid="JOS 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 22:24" />«No'o giissineechchi tene'aate kaddebaaki dagaake baro'n hanooxxi horte no'oxxa oose ‹ha'no Duuchchi Woddike Gootta Isira'eelike Mageninni maa mittumma alfine? <verse eid="JOS 22:24" /><verse number="25" style="v" sid="JOS 22:25" />Duuchchi Woddik Gootti no'onna ha'noo Roobelikanna, Gaadika ardi mittumma anfabe'noshsha Yordaanoosika galaana oddo no'oxxe'n gabala ugge'en; tennexxe duuchchi Woddike Goottinni mittumma afinebaan› hina'ni hinee sodaantennexxe callaaten. Konne qicinn horte ha'nooxxi oose no'oxxi Duuchchi Woddika Gootta Magenoonfantabaashsha hoyyitaaxxe hexxen.<verse eid="JOS 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JOS 22:26" />«Tennexxe no'o ‹giissinennek tolchimalchi ciinco'aka yookaan wele tolcha itti tolchinona'atebaan› <verse eid="JOS 22:26" /><verse number="27" style="v" sid="JOS 22:27" />Wele darree'ni ciinco'aka tolcha no'oka, wele uwwa no'oxxanna mittomiinka no'oka tolcha aa'nennexxi Woyyichcha booncho'ni Duuchchi Woddika Gootta magenoonfantaanoshsha tolchimalchi no'oxxenna ha'nooxxe oddo'ni iittanni daggaaxxe ila duuchchi'a dhugaa kulatee kadaan. Tennexxe edi'a ha'nooxxi horte no'oxxa horte ‹Duuchchi Woddike Goottinn darree'ni geego affinebaan› hiyya dandeenabaan.<verse eid="JOS 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JOS 22:28" />«Akimagaada no'onna, ‹Edi'a no'onna kadi horte no'oxxa iitta hina'noole kunse edik annuwwi no'ok giissemmaxxa Duuchchi Woddike Gootika tolchimalchik fakkeenna uudde; tinni no'oxxenna ha'nooxxe oddo'ni dhugaa kulatee kaddaashshate malee ciincatika tolchanna wele tolcha tolchateetebaan hine'e kullannon› » hinennen. <verse eid="JOS 22:28" /><verse number="29" style="v" sid="JOS 22:29" />«No'o Duuchchi Woddike Gootta'n jallantebe'non; ciinicatika tolcha yookaan wele midhatika tolcha yookaan wele tolcha shiqilshatee hende'e wele tolchimalcho giissati Duuchchi Woddika Gootta magenoonfata waalebeno. Galdumiinke duunkaan edo uurraake Duuchchi Woddike Gootta no'oke Mageni'a giissemeeke wele gargar hedheeka tolchimalcho giissedha no'onaa'ni hanqatto!» Hine.<verse eid="JOS 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 22:30" />Qeesichchi Finihaasinna isinni welt ardi erige'na'a dagemaki Isira'eelixxe gosaki mini aanchiinke ardiki sooresuwwi Roobelik Gaadikinna Minaaseke miniki gamisi ardi hiyye haaso'exxa lanqe wodda yo'osha gamande <verse eid="JOS 22:30" /><verse number="31" style="v" sid="JOS 22:31" />Tennexxee Ali'aazaarik belt qeesichchi Finihaasi Roobelika, Gaadikanna Minaaseka arda, «Ha'noo Duuchchi Woddike Gootta'n jallitineebaan; tennexxe Duuchchi Woddiki Gootti no'oni welt hedheexxa egeneeneni; Isinna mufate Isira'eelika arda ganabaashsha assitineen» hiyye.<verse eid="JOS 22:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 22:32" />Ookkoneechchi uduma qeesichcho Ali'aazaarik belti Finihaasinna iikki akeekisanjuwwi Gele'adi hedhemmake Roobelikenna Gaadike ardibaa'n Kenaani boga'n hedhemmake Isira'eelike ardibaa hinge dangeexxi kaddeexxa yaane duuchcha Isira'eelike arda'n kulle. <verse eid="JOS 22:32" /><verse number="33" style="v" sid="JOS 22:33" />Isira'eeliki ardinna laqeexxe yaane duuchchi'a gammadeexxi Mageno galateeffate. Ookkoneechchi uduma Isira'eeliki ardi Roobelikanna Gaadike ardika boga lole'e balleessatixxa yaane mari'e waale.<verse eid="JOS 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 22:34" />Roobelikinna Gaadik ardi kunni tolchimalchi Duuchchi Woddik Gootti calli isi Magenoke kadeexxa no'o duuchchiinge'e dhugaa kulaten hine. Tennenaa'n kexxeexxa tolchimalchinka summa: Dhuugaa kulatee hine fulchine.<verse eid="JOS 22:34" /></para>
  <chapter eid="JOS 22" />
  <chapter number="23" style="c" sid="JOS 23" />
  <para style="s1">Iyyaasu Reyo Shiqe'e Gorseeka Gorsa</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 23:1" />Qeerraake bari uduma Duuchchi Woddik Gootti Isira'eelika arda qarqraake'n hedheeke naaphinaa'n gatiseexxi nage'iki he'naasha asse. Ookkone wodda Iyyaasu yo'osha cimeemmani. <verse eid="JOS 23:1" /><verse number="2" style="v" sid="JOS 23:2" />Tennexxe Iyyaasu Isira'eelika arda duuchcha, Geedhuwwa, sooresuwwa, hayyichchuwanna Ja'labuwwa duuchcha ye'e mitteba bukki assexxi hiyyee qici: «Kunnise ani ta'a cimee gopha'ni dageennen. <verse eid="JOS 23:2" /><verse number="3" style="v" sid="JOS 23:3" />Duuchchi Woddik Gootti no'oki Mageni no'oo gargaaro'a arda duuchcha hitta asseexxa uudineen. Duuchchi Woddiki Gootti no'oki Mageni ha'no'aa loleen. <verse eid="JOS 23:3" /><verse number="4" style="v" sid="JOS 23:4" />Ani injifatenneke ardikanna wele gateeke ardika Yordaanoosike galaani'n boroti darre'n dhidhimi darrenaa'n Mediteranixxe Abbaayya qico'n hedheeka boga duuchcha ha'nooxxe gosake mini minike ardi duuchchi'a geegoke kadaashsha uweennen <verse eid="JOS 23:4" /><verse number="5" style="v" sid="JOS 23:5" />Duuchchi Woddik Gootti ha'nooki Mageni naaphi ha'nooki ha'no edi'n baajaashsha asse'e bogakenaa'n fulchaan; Duuchchi Woddiki Gootti ha'nooki Mageni uwwanno hiyyemmaka insa'neka boganna adhdhitinaan.<verse eid="JOS 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 23:6" />«Tennnexxe Muuse seeriinke Maxaafi giddo borreessemmaka ajaja duuchcha jabaqicin xexxe'atina'n heqqedhdhe isonaa'n middi'aana bita'i'a higginoqqe'e. <verse eid="JOS 23:6" /><verse number="7" style="v" sid="JOS 23:7" />Ha'noo giddo gateeke konne ardinn welti gudditinoqqe'e, isa'neka dharichcha magenuwwika summa yexxinoqqe'e insa'ne'ninna kakatinoqqe'e, insa'ne'a ergatendinoqqe'e insa'ne'ni sagaddinoqqe'e. <verse eid="JOS 23:7" /><verse number="8" style="v" sid="JOS 23:8" />Yaane kinni ta'iqico'ni assitinemmashanni Duuchchi Woddike Gootta ha'nooke Mageni'a shiqqineeke kadde.<verse eid="JOS 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 23:9" />«Duuchchi Woddik Gootti lumolluwwanna hunnameessa arda ha'no edi'n shorreen; telchiqico'n uurre loleki hedhebaan. <verse eid="JOS 23:9" /><verse number="10" style="v" sid="JOS 23:10" />Duuchchi Woddik Gootti ha'nooki Mageni ha'no'a lolannoni hiyye adachchiisemmaxxe'e ha'nooki mitti kumma insa'neka shorran.<note caller="-" style="x"><char style="xo" closed="false">23:10 </char><char style="xt" closed="false"><ref loc="DEU 3:22">Lan. 3:22</ref>; <ref loc="DEU 32:30">32:30</ref>. </char></note> <verse eid="JOS 23:10" /><verse number="11" style="v" sid="JOS 23:11" />Tennexxe Duuchchi Woddika Gootta ha'nooka Mageno jaba qicinn eeyye.<verse eid="JOS 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 23:12" />«Yaane kinn ha'no Magenokenaa'n bayyatineexxi ha'no giddo gateemmake ardinni mitteke kaddinoole ha'no insa'nexxa dubarte insa'nenna kinni ha'nooxxa aa'ne'naa firondinoole <verse eid="JOS 23:12" /><verse number="13" style="v" sid="JOS 23:13" />Duuchchi Woddik Gootti ha'nooki Mageni konne arda ha'noo edi'n shorrabaaxxa ege'ne. Yaane kinni Ha'no konne eloke boginaa'n baxxinaa qico'n insa'ne dudduro ha'nooke kuta, ille ha'nooxxe uchcho ittanni lekka ha'nooxxe'e gufotanna fonxorote kandaan.<verse eid="JOS 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 23:14" />«Higgee reyo gatachcho kada gopheemmaxxe'e aninna turene qico turabo'non; Duuchchi Woddik Gootti ha'nooki Magen uwwo'a addachisemaxxa elolla yaane duuchcha mittetinna gattebaang ha'no'aa assexxa godobi ha'nookinna qalbe ha'nooxxi egendeen. <verse eid="JOS 23:14" /><verse number="15" style="v" sid="JOS 23:15" />Duuchchi Woddik Gootti ha'nooki Magen elolla yaane ha'no'a assemmashshann ittann Isi ha'noa'a uwweeke konne eloke boganaa'n ha'no balleesssa qico'n elobaaxxa yaane duuchcha ha'no'ni iyyedagaan <verse eid="JOS 23:15" /><verse number="16" style="v" sid="JOS 23:16" />Duuchchi Woddik Gootti ha'nooki Mageni ha'no'a aagemmaxxa kako diiggineexxi wele dharichcha magenuwwa magenoonfattina'n heeshshi hitina'n ulfeesitinoole Duuchchi Woodiki Gootti ha'no'n mufataan; uwwemmake konne eloke boginaa'ninna iikki woddi baxxiinaan.»<verse eid="JOS 23:16" /></para>
  <chapter eid="JOS 23" />
  <chapter number="24" style="c" sid="JOS 24" />
  <para style="s1">Sekemi Iyyaasu Ardake'ni Haaso'eka Haaso'a</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 24:1" />Iyyaasu Isira'eelixxe gosaka arda duuchcha ye'e Sekemi bukki asse. Geedhuwwa, akeekisanjuwwa, hayyichuwwanna ja'laabuwwa Isira'eelika duuchcha ye'e'na insa'nena Mageni edo bukki hine.<verse eid="JOS 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 24:2" />Iyyaasu arda duuchcha'n hiyye haaso'e qici, «Duuchchi Woddik Gootti Isira'eeliki Magen haso'a'n: ‹Qeerraake bari edi darre annuwwi ediki ha'nooki Efiraxiisike galaani wido dharichcha magenuwwa magenoonfanta'ne he'naamman. Konne annuwwi giddii'n mitti Abirihaamikenna Naakkoorike anna Taaratemman. <verse eid="JOS 24:2" /><verse number="3" style="v" sid="JOS 24:3" />Yaane kinni anna ha'nooka Abirihaamii'i Efiraxiissike galaan widi darre'n hedheeke boganaa'n aadhe fulchee, Kenaanike boga duuchcha'ni me'aashsha akeekennen; horte isixxanna bira sa'issennen; Yissihaaqiinnaa isi'aa uwweenne.<note caller="-" style="x"><char style="xo" closed="false">24:3 </char><char style="xt" closed="false"><ref loc="GEN 12:1-19">Dada. 12:1-19</ref>; <ref loc="GEN 21:1-3">21:1-3</ref>. </char></note> <verse eid="JOS 24:3" /><verse number="4" style="v" sid="JOS 24:4" />Yissihaaqi'a Ya'iqoobi'aanna Eesawu'u uwweenne; Eesaawu'anna Seyiirika koobatika boga isi'a qadaadake kadaashsha uwween. Yaane kinni Ya'iqoobinna oose isixxi Gibtse'a me'ine.<note caller="-" style="x"><char style="xo" closed="false">24:4 </char><char style="xt" closed="false"><ref loc="GEN 25:24-26">Dada. 25:24-26</ref>; <ref loc="GEN 36:8">36:8</ref>; <ref loc="GEN 46:1-7">46:1-7</ref>; <ref loc="LEV 2:5">Lew. 2:5</ref>. </char></note><verse eid="JOS 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 24:5" />« ‹Ookkoneechchi udumi'a Muusenna Aaroonii'i erge'e Gibtseka arda lumoxxe rakkonni ganenne'e ha'noo ookko fulchenne.<note caller="-" style="x"><char style="xo" closed="false">24:5 </char><char style="xt" closed="false"><ref loc="EXO 3:1-12:42">Fula. 3:1—12:42</ref>. </char></note> <verse eid="JOS 24:5" /><verse number="6" style="v" sid="JOS 24:6" />Edika ha'nooka annuwwa Gibtse'n fulcheenaa Abbaayyatibaa dange genne. Gibtseke manni insa'nee fadhadiinxe gaareninna fadhadiki Diimmoxxe Abbaayya qico ha'noo shorrinee wodda,<note caller="-" style="x"><char style="xo" closed="false">24:6 </char><char style="xt" closed="false"><ref loc="EXO 14:1-31">Fula. 14:1-31</ref>. </char></note> <verse eid="JOS 24:6" /><verse number="7" style="v" sid="JOS 24:7" />yaane kinn insa'ne'e gargraaronaa'a anibaa oo'neen; aninna insa'nexxenna Gibtseke mannixxe oddo'n dukkanna hexxaashsha assennexxa ille ha'nooxxinni uudine'en. Ookkoneechchi uduma ha'no qeerraaxxa yanna qiilla gammoje giddo turtineen.<verse eid="JOS 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 24:8" />« ‹Boroti darrexxe Yordaanoosi'ni hedheeke Amoorake ardike bogibaa ha'no idagennen; insa'nenna ha'noo lolleen, ani kinni midditte ha'no'a uwwee insa'nee injifattinaashsha asse'e ha'no edi'n balleessen; ha'nonna boga insa'neka adhdhitine.<note caller="-" style="x"><char style="xo" closed="false">24:8 </char><char style="xt" closed="false"><ref loc="NUM 21:21-35">Lak. 21:21-35</ref>. </char></note> <verse eid="JOS 24:8" /><verse number="9" style="v" sid="JOS 24:9" />Ookkoneechchi uduma Mo'aabik moyanji Sefoorik belt Baalaqi ha'noo lolo'a qophpheefate; ha'no yowwoo'anna Bele'aami hiyyemmake Bi'oorke beltibaa erge. <verse eid="JOS 24:9" /><verse number="10" style="v" sid="JOS 24:10" />Ani kinni Bele'aami hiyyaaxxa laqa gibennen, tennexxe higgegenni ha'noo biifashsha assennen. Konne qicinni ha'noo Baalaqixxe anganaa'n gatisennen.<verse eid="JOS 24:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JOS 24:11" />« ‹Ha'noonna Yordaanoosike galaana foofine'e Iyyaariko'a dagginnen; Iyyaarikoki manni, iittanni Amoorik, Feeriizito, Kenaanito, Hiititotik, Gergerisiitotiki, Hiwaakinna Iyyaabusaki manni ha'no'o lolmashanni; ani kinni insa'ne'e injifattinaashsha midditte ha'no'aa uwwennen.<note caller="-" style="x"><char style="xo" closed="false">24:11 </char><char style="xt" closed="false"><ref loc="JOS 3:14-17">Iya. 3:14-17</ref>; <ref loc="JOS 6:1-21">6:1-21</ref>. </char></note> <verse eid="JOS 24:11" /><verse number="12" style="v" sid="JOS 24:12" />Lamiing Amoorake moyanjuwwa'n assenneshshanni insa'ne ha'no ed'ni baqanto'a alayyo insa'neni worenenni. Tenne assitineeki ha'noke wolaantichchinna ha'nooxxe gabennitebaan.<note caller="-" style="x"><char style="xo" closed="false">24:12 </char><char style="xt" closed="false"><ref loc="EXO 23:28">Fula. 23:28</ref>; <ref loc="LEV 7:20">Lew. 7:20</ref>. </char></note> <verse eid="JOS 24:12" /><verse number="13" style="v" sid="JOS 24:13" />Ha'noo hujjine elootinebaaka boganna jadhitinebaaka qachchuwwa'ni hexxinashsha ha'no'aa uwwennen; kassinebaka woyinetika hiddichchonna elotinebaake Eejerisixxa guuma ittina'ne hixxinan.›<note caller="-" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="LEV 6:10-11">Lew. 6:10-11</ref>. </char></note><verse eid="JOS 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 24:14" />«Ta'anna ha'noo Duuchchi Woddika Gootta ulfeesse dhugaati isi'a ajajendina'n mitte godobinni ergatte. Ediki ha'nooki annuwwi Eefiraxxisike galaani wido Gibtseke boga'n magenoonfantammaka dharichcha magenuwwa fugusitine Duuchchi Woddika Gootta calla Magenoonfatte. <verse eid="JOS 24:14" /><verse number="15" style="v" sid="JOS 24:15" />Isoo magenoofata gibbinoole kinni edi wodda ha'nooki annuwwi Eefiraxxisike galaani wido hedhemma wodda magenoonfantaammaka yookaani ta'a giddo hexxineeke Amoorake ardike dharichcha magenuwwina'an hoone'a magenoonfatinaaxxa fi'le. Aninna anki mini hadi kinni Duuchchi Woddike Gootta Magenoonfantanon.»<verse eid="JOS 24:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 24:16" />Ardikinna «Duuchchi Woddika Gootta waale'e wele dharichcha magenuwwa magenoonfachhco no'onaa'n bayyato ise! <verse eid="JOS 24:16" /><verse number="17" style="v" sid="JOS 24:17" />Duuchchi Woddik Gootti no'oki Mageni no'o Gibtseke bogixxe garbumanaa'ni fulcheen. Isi asseexxa mambe'iinxa yaane duuchcha uundeennen. Duuchchiinge ardike bogi giddi'n sa'na'n dangano wodda nage'iki no'o heqqeen. <verse eid="JOS 24:17" /><verse number="18" style="v" sid="JOS 24:18" />Duuchchi Woddik Gootti duuchchiinga arda ittanni bogi giddo hedhammaka Amooraka ardanna no'o edi'n shorreen. Tennexxe no'o Duuchchi Woddika Gootta magenoonfanitannoni isi no'oke Magenon.»<verse eid="JOS 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 24:19" />Iyyaasu arda hiyyee qici, «Duuchchii woddik Gootti woyyichchakenna hinaantichcha Mageno kadeemmaxxe'e is'a ergatema shollaxxebaan. Jallatinaa woddanna cubbo hujjinaa wodda ha'no'a gattowwaali hiyyabaan. <verse eid="JOS 24:19" /><verse number="20" style="v" sid="JOS 24:20" />Duuchchi Wodika Gootta waaldine'e wele dharichcha magenuwwa magenoonfatinoole eloxxa assa'n dageeke kadoolenna hige'e elobaxxa asse ha'noo balleessaan.»<verse eid="JOS 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 24:21" />Ardi kinnina Iyyaasu'u «Waawwo'o; no'o Duuchchi Woddika Gootta magenoonfatannoni» hine.<verse eid="JOS 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 24:22" />Ookko'ni Iyyaasu «Yoona Duuchchi Woddika Gootta magenoonfatinnon hitine haasotineexxa arabi ha'noong dhugaate» hiyye.</para>
  <para style="p" vid="JOS 24:22">Insa'nenna «Eeti arabi no'oki dhuugaten» hine.<verse eid="JOS 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JOS 24:23" />Iyyaasu, «yoona ha'noo giddo hedheeka dharichcha magenuwwa fugusse Duchchii Woddika Gootta Isira'eelike Magenibaa mitte godobinni higge» hiyye.<verse eid="JOS 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 24:24" />Ookkkonneechchi uduma ardi Iyyaasu'u, «No'o Duuchchi Woddika Gootta no'oke Mageno magenoonfantannon seera isikeena ajajemmannoni» hine.<verse eid="JOS 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JOS 24:25" />Ettene barra Iyyaasu Sekemika arda Duuchchi Woddike Goottin welit kako aassise. Gallaaka seeranna insa'ne'a ugge. <verse eid="JOS 24:25" /><verse number="26" style="v" sid="JOS 24:26" />Iyyaasunna konne sseruwwa Mageniinke seerike maxaafa'n borreesse. Ookkoneechchinni uduma mitte lumoka kinjo adhdheexxi Duuchchi Woddike Goottike Galmi bira hedheeke Qilxi hunda kaase. <verse eid="JOS 24:26" /><verse number="27" style="v" sid="JOS 24:27" />Iyyaasu arda duuchcha «Kunni kinji Duuchchi Woddik Gootti no'o'ni haaso'exxa duuchcha laqeen. Tennexxe Mageno ha'nooka waaldinoole dhugaa kulaan» hiyye.<verse eid="JOS 24:27" /></para>
  <para style="s1">Iyyaasu Adde Asse'nemmake Boga'ni Moogeme</para>
  <para style="p">
    <verse number="28" style="v" sid="JOS 24:28" />Ookkoneechchi uduma Iyyaasu duuchchiingi ardi ifi ifinge geegibaa wirri hiyye'e me'aashsha asse.<verse eid="JOS 24:28" /></para>
  <para style="s1">Iyyaasuxxanna Ali'azarixxa Reyo</para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 24:29" />Ookkoneechchi uduma Duuchchi Woddike Goottik erganiji Neewek belt Iyyaasu dhibbanna tomme wogga'n lummedhe. <verse eid="JOS 24:29" /><verse number="30" style="v" sid="JOS 24:30" />Isira'eeliki ardinna Ga'ashi hiyyendaaxxe kooba'n middi darre'n Efireemike kooba callike boga'n hedheeke Teminaseera hiyyemaake isike qadaada'n moonge.<verse eid="JOS 24:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JOS 24:31" />Iyyaasu hedhoti hedhemmaxxa yanna duuchcha, Iiyyaasu udumanna hedhoti he'nemakenna Duuchchi Woddik Gootti Isira'eeliki ardi'aa asseexxa duuchcha egendeexxe geedhek baro duuchcha'ni Isira'eelki ardi Duuchchi Woddika Gootta magenoonfante.<verse eid="JOS 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 24:32" />Isira'eeliki ardi Gibtseke boginaa'n fulee wodda aa'ne fulleexxa Yooseefixxa miqe, Ya'iqoobi Sekeemik annaa Hamoorinaa'ni dhibba birreti sibiljinin hireemmake Sekemike boga'ni moogeme; bogi kunni Yoosefixxe horte'a geyeeke geegomman.<note caller="-" style="x"><char style="xo" closed="false">24:32 </char><char style="xt" closed="false"><ref loc="GEN 33:19">Dada. 33:19</ref>; <ref loc="GEN 50:24-25">50:24-25</ref>; <ref loc="EXO 13:19">Fula. 13:19</ref>; <ref loc="JHN 4:5">Yoh. 4:5</ref>; <ref loc="ACT 7:16">Erga. Huj. 7:16</ref>. </char></note><verse eid="JOS 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JOS 24:33" />Iittanni Aaroonik belti Ali'aazaarinna reye; isinna kooba callike Efireemike bogi giddo hedheeke belto ifikee Finihaasi'aa hixik uwwemeeke Gibaake boga'ni moogeme.<verse eid="JOS 24:33" /></para>
  <chapter eid="JOS 24" />
</usx>