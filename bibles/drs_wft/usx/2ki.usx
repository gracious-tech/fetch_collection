<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2KI" style="id">- Gedeo Bible</book>
  <para style="h">2 Moyanjuwwiinkaa Maxaafa</para>
  <para style="toc1">Langakaa Moyanjuwwiinkaa Maxaafa</para>
  <para style="toc2">2 Moyanjika Maxaafa</para>
  <para style="toc3">2 Moy.</para>
  <para style="mt1">Langakaa Moyanjuwwiinkaa Maxaafa</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Moyanjiinka moyanjuwwiinki Maxaafi langaxxi kuta; moyanjuwwiinke maxaafixxi taakaxxi kuta uurriteemmabaa'ni kexxeexxi lamiinge Isira'elike moyanjuwwixxa yaane haaso'aani: maxaafi lame umo umo kaddeexxe kutuwwa'ni qoodemaan.</para>
  <para style="ip">1 Kirsitoosixxe ilensha edi gama sallanixxe qarixxe woggake gamisaa'ni ke'isse Samaariyaxxe diigenshanna Kiristoosi ilemebaa edi darre torbaane dhibbanna lame tommenna mitte wogga middi darrexxexxi mootumma ibbaa qico'ni hexxeexxa lamiinxe mootummaxxi jirte.</para>
  <para style="ip">2. Isira'elixxe mootummaxxe ibaanaa'ni ke'isse Kiristoosixxe ilenshsha edi ga'ma onde dhibbanna saddeeta tommenna jaane wogga moyanji Naabu kedenetsoor Iyyerusalemii'i lole injifate diige biraa qico'ni hexxeexxa Yihudiinxe mootummaxxa jirte.</para>
  <para style="ip">Kunni Maxaafi Gedaaliya Baabiloonixxe galcha hunda Yihudiinka boga galchaammaxxeenna Yihudiinki moyanji Yo'aakinni baabiloonike ussurri minenaa'ni fulemmaxxa ca'a asse kule muuxxaani.</para>
  <para style="ip">Tinni ba'ne duuchcha Isira'eeli'ni geya dandeetteeki; Yihudinkinna Isira'eeliki moyanjuwwinna ardi Magenoke'e anffeexxa addatensha xe'yinsheemmaxxeteen: Iyyerusaalemixxa diigenshanna Yihudinke ardi giddi'ni heddi manni shorremeexxa Isira'eelike ardixxi jirte ora jijjidhdhate dandeessisseexxe buutonaa'ni umoke kadeexxeni.</para>
  <para style="ip">Moyanjiinke maxaafixxi langaxxi kuta giddo yo'oshsha ege'nemeeki wabeekichchi Eliyaasixxe tukke kadeemmakki Elisayiteni.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Qoqqoodendeexxa mootumma <char style="ior"><ref loc="2KI 1:1-17:41">1:1—17:41</ref> </char></para>
  <para style="io2">Wabeekichcho Eliyaasi'i <char style="ior"><ref loc="2KI 1:1-8:15">1:1—8:15</ref> </char></para>
  <para style="io2">Yihudiinkanna Isira'eelika moyanjuwwa <char style="ior"><ref loc="2KI 8:16-17:4">8:16—17:4</ref> </char></para>
  <para style="io2">Samariyaxxa iba <char style="ior"><ref loc="2KI 17:5-41">17:5-41</ref> </char></para>
  <para style="io1">Yihudiinxa mootumma <char style="ior"><ref loc="2KI 18:1-25:30">18:1—25:30</ref> </char></para>
  <para style="io2">Hiziqiyaasinaa'ni Iyyasiyaas qico'ni <char style="ior"><ref loc="2KI 18:1-21:26">18:1—21:26</ref> </char></para>
  <para style="io2">Iyyosiyaasixxa galcha <char style="ior"><ref loc="2KI 22:1-23:30">22:1—23:30</ref> </char></para>
  <para style="io2">Muuxamiinka Yihudiinka moyanjuwwa <char style="ior"><ref loc="2KI 23:31-24:20">23:31—24:20</ref> </char></para>
  <para style="io2">Iyyerussaalemixxa iba <char style="ior"><ref loc="2KI 25:1-30">25:1-30</ref> </char></para>
  <chapter number="1" style="c" sid="2KI 1" />
  <para style="s">Mageniinxi Murte Akaziyaasi'n</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 1:1" />Aki'aab reyeechchi uduma Mo'aabi Isira'eeli'ni fuggoxxinni ke'e.<verse eid="2KI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 1:2" />Ookkonne wodda Akaaziyaasi Semaariya hedheeke iimi darreke mootummatike minixxe masikootenaa'ni ibeexxi miidheme. Tennexxe isinna hiyyee qici: «Martineexxi tenne ela gonphenaa'ni fayyannoxxanna fayyabo'noxxa Aqaroonika mageno Bi'eelizebulii'i qorre» hiyyeexxi ergajjuwwa erge.<verse eid="2KI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 1:3" />Duuchchi Woddike Goottik iimik Erganji kinni Teesibichcho Eliyaasii'i hiyyee qici: «Kexxettexxi Semaariyake moyanjike erganjuwwini afendotta'a martettexxi, ‹Aqaroonika mageno Bi'eellizebuli'i qodhdhitino'a me'itina'neeki Isira'eeli giddo Magen hedhebaani hiyyote?› hite'e insa'ne qori. <verse eid="2KI 1:3" /><verse number="4" style="v" sid="2KI 1:4" />Tennexxee Duuchchi Woddik Gootti hiyya'nee qici, ‹Ati diiphphettexxe taqenaa'ni kexxaboxxoni. Dhugaandinni rertaatteni!› hiyye'een.» Ookkoneechchi uduma Eliyaasi me'e.<verse eid="2KI 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 1:5" />Eriganjuwwikinna moyanjiinbaa hinge dangee wodda, «Maye'e higgine daggine?» hiyye insa'ne qore.<verse eid="2KI 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 1:6" />Insa'nenna iso'ni hine hiissinee qici, «Mitti manji no'onni afemo'a dageexxi, ‹isinna ha'noo erigemmake moyanjiba higgine martineexxi, «Duuchchi Woddik Gootti hiyya'nee qici: Aqaroonika mageno Bi'eelizebuli'i qodhdhate'e manjo erigexxaatteki Isira'eeli giddo Magen hedhebaani hiyyotee? Tennexxe diiphphetteexxe taqenaa'n kexxabexxoni dhugaandinni rertattoni!» › »<verse eid="2KI 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 1:7" />Moyanjikinna insa'nee hiyye qoree qici, «Yoona ha'noo'ni dage afeme ha'no'ni iitta hiyyeeki manji hitta hedheeke?» hiyye qore.<verse eid="2KI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 1:8" />Insa'nenna, «Manjichchi ordati giissineexxe seemma odo'we'ekeni: hidhakanna gogiinxe mixeni usurreekeni» hine hiissine haasoonne.</para>
  <para style="p" vid="2KI 1:8">Moyanjikinna, «iikki Teesibichcho Eliyaasiten hiyye hiisse» hiyye.<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="MAT 3:4">Mat. 3:4</ref>; <ref loc="MRK 1:6">Mar. 1:6</ref>. </char></note><verse eid="2KI 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 1:9" />Ookkoneechchi uduma moyanji onde tomme loliinka manna ajajammaka onde tomme loliinke mannini welti Eliyaasiba'a erge. Onde tomme ajajammakinna Eliyaasi ofo'lemake tullichchiinxe xungo'ni iima fuleexxi isoo hiyyee qici: «Koo Mageniinke manjo, moyaanji atee, ‹Amo dirri hiyya'neni› » hiyye.<verse eid="2KI 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 1:10" />Eliyaasinna hiisseexxi onde tomme loliinka manna ajajammake'n hiyyee qici: «Ani Mageniinke manjo kadonnole giira iimi'ni ibbe'e, ateenna onde tomme atika manna ittowwaali!» hiyye. Ookkoonna giira iimi'ni ibbeexxi onde tomme ajajammakanna isika manna itte.<verse eid="2KI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 1:11" />Higgeeni moyanji wele onde tomme ajajammaka isike onde tomme mannini welti erge; onde tomme manna ajajammakinna, «Koo Mageniinke manjo moyanji atee, ‹Ta'a tenne amo dirri› hiyya'neeni» hiyye.<verse eid="2KI 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 1:12" />Eliyaasinna «Ani Mageniinke manjo kadonole giira iimi'ni ibbeexxi ateenna onde tomme atika manna ittowwaali!» hiyye. Eettene yanna'ni Mageniinxi giira iimii'ni ibbeexxi isoonna isika onde tomme manna itte.<note caller="-" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="LUK 9:34">Luq. 9:34</ref>. </char></note><verse eid="2KI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 1:13" />Tennexxe moyanji sakkaaka onde tomme loliinka manna ajajammaka onde tomme mannini welti erge. Kunninna sakkaki onde tomme manna ajajammak mareexxi Eliyaasi edo guluffate isoo hiyya'ni kadhdhatee qici, «Koo ati Mageniinki manjo! Isinna maganneteni aneenna konne onde tommixxi atike erganjuwwixxi lubbo ati edo eeyyendeexxe kaddowwaal! <verse eid="2KI 1:13" /><verse number="14" style="v" sid="2KI 1:14" />Kunseteni giira iimi'ni ibbeexxi; lame onde tomme ajajammaka ajajalluwwanna insa'neeka manna duuchcha itte. Yaane kinni ta'a lubbo anxi ati edo eeyyendeexxe kaddowwaali!»<verse eid="2KI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 1:15" />Duuchchi Woddike Goottixxi Erganna Eliyaasi'i, «Isinni welti adadde dirri; isoonna sodaattoxxe» hiyye. Tennexxe Eliyaasi ke'exxi isinni welti moyanjiinba mare.<verse eid="2KI 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 1:16" />Moyanjokanna Duuchchi Woddik Gootti hiyya'nee qici: «Yoona Aqaroonika mageno Bi'eelizebuli'i ifi'a qodhdhitottaa erganjuwwa ergexxetteki; Isira'eeli giddo Magen hedha gopheexxeete? Tenne assitettaxxee diiphphettaxxe taqenaa'ni hara kexxabexxoni; reya atixxi gattabaan!» hiyye kule.<verse eid="2KI 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 1:17" />Tennexxe Akaziyaasi Eliyaasi haaso'emmashanni Duuchchi Woddike Goottike hiyyichchishshanni reye.</para>
  <para style="p" vid="2KI 1:17">Akaaziyaasinna labbaka belto i'la gopheemmaxxee Iyyosafixxiki belti Iyyoraami Yihudake'ni moyexxe langaxxe woga'ni dayyi isiki Iyyoraami isixxa bakka moye. <verse eid="2KI 1:17" /><verse number="18" style="v" sid="2KI 1:18" />Wele Akaaziyaasi baro isike'ni hujeexxinna asseexxi hujuwwa duuchchi Isira'eelike moyanjuwwixxe jirtetike maxaafa'ni borreessendeexxebaata?<verse eid="2KI 1:18" /></para>
  <chapter eid="2KI 1" />
  <chapter number="2" style="c" sid="2KI 2" />
  <para style="s1">Eliyasi Iimi'aa Buteme</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 2:1" />Duuchchi Woddik Gootti Eliyasi'i diidalloti iimi'a adhdhaaxxi yanna geltte wodda Eliyaasinna Elsa'i Geligeela'ni ke'ne me'ina'nemmani. <verse eid="2KI 2:1" /><verse number="2" style="v" sid="2KI 2:2" />Eliyaasinna Elsa'i hiyyee qici, «Duuchchi Woddik Gootti anee Beeteli'a erge'eni ati kabani hedhi» hiyye.</para>
  <para style="p" vid="2KI 2:2">Yaane kinni Elsa'i Elisaayi'i, «Hedhaake Duuchchi Woddike Goottike summini kakataanneni ani atenaa'ni gargari higabe'no» hiyye. Tennexxe weltinni Beeteli'a adadde me'ine.<verse eid="2KI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 2:3" />Beeteli hedhemmaki wabeekotik orgi Elsa'ibaa mareexxi, «Duuchchi Woddik Gootti gootta atika Eliyaasi'i techcho atenaa'ni gargari hisseexxi adhdhe me'a'neexxa egendeeni hexxette?» hiyye. Elsa'inna «Eeti ege'nenneni; ha'noo kinni sammi hiyye» hiyye hiisse haaso'e.<verse eid="2KI 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 2:4" />Ookkoneechchi uduma Eliyaasi Elsa'ii, «Koo Elisayi Duuchchi Woddik Gootti anee Iyyariko ergeen ati kabaani hedhi» hiyye. Elsa'i kinni, «Ani hedhaake Duuchchi Woddike Goottike summini kakataanneni; atenaa'ni gargari higabo'non» hiyye hiisse haaso'e. Tennexxe Iyyaariko'a me'ine.<verse eid="2KI 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 2:5" />Iyyaariko giddo hedhemmaki wabeekotik orgi Elisaayibaa mareexxi isoo «Duuchchi Woddik Gootti techcho gootta atika atenaa'ni gargari hiisseexxi adhdha'neexxa egendeeni hexxete?» hine qorre.</para>
  <para style="p" vid="2KI 2:5">Elsa'inna «Eeti ege'neenneni: ha'no kinni sammi hiyye» hiyye hiisse haaso'e.<verse eid="2KI 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 2:6" />Ookkoneechchi uduma Eliyaasi Elisa'i'i, «Duuchchi Woddiki Gootti anee Yordaanoosike galaanibaa erge'eni ati kabanni anee heqqi» hiyye.</para>
  <para style="p" vid="2KI 2:6">Isinna, «Hedhaake Duuchchi Woddike Goottike summini kakataanneni. Aninna atenaa'ni gargari higabe'no» hiyye hiisse haaso'e. Tennexxe lamiingi mitteba me'ine.<verse eid="2KI 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 2:7" />Wabeekotike ya'i giddii'ni onddi tommi mareexxi Eliyaasinna Elsa'i uurrineeba Yordaanoosike galaani birii'ni bayyante uurrine.<verse eid="2KI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 2:8" />Eliyaasinna kaabba fulchedheexxi wede'e gane. Wede'ikinna middi'anna bita'i'a lameba qoodeme; lamiingi bagoke buttinanaa'ni foonfe.<verse eid="2KI 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 2:9" />Foonfeechi uduma Eliyaasinna Elsa'ii «Atenaa'ni adhdhemebo'no edi gama ati'aa maa assonnaa hassaattexxa ane'ni kuli» hiyye.</para>
  <para style="p" vid="2KI 2:9">Elsa'inna «Hafuur atik ane'ni dachcha'iki hedho'aa kadhataanneni» hiyye hiisse haaso'e.<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="LEV 21:17">Lew. 21:17</ref>.</char></note><verse eid="2KI 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 2:10" />Eliyaasinna «Jabaxxee yaane qortee'eten; kaddo malee'e ani atenaa'ni adhdhemano wodda anee uuddottole; hitetteshshanni ati'aa kaddaani; uuda gophphottole kinni alfa dandeettabexxoni» hiyye.<verse eid="2KI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 2:11" />Laana haasoonna'ni me'inaa'na'a giiratixxi gaarenna giiratiki fadhadi dedhange'ni oddo insa'neexxe'ni e'yeexxi insa'ne gargari hiisse; Eliyaasinna hobonbalteti iimi'a adhdheme.<verse eid="2KI 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 2:12" />Elsa'inna tennee uudeexxi «Ankannaa! Ankannaa! Isira'eelixxe gaaruwwanna fadhadoo!» hiyye raare; langaxxa Eliyaasi'i uudebaani. Ookkoneechchi uduma ifixxa seemma adheexxi lameba dare.<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="2KI 13:14">2 Moy. 13:14</ref>. </char></note><verse eid="2KI 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 2:13" />Isinna Eliyaasinaa'ni ibeemmaka kaabba butti'ni aadhe; higgeeni Yordaanoosi galaanike kasaa'ni uurre.<verse eid="2KI 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 2:14" />Eliyaasinaa'ni ibemmaka kaabba aadheexxi wede'e ganeexxi, «Eliyaasiki Duuchchi Woddik Gootti Magen haba hedhe?» hiyye. Wode'ekanna ganee wodda middanna bita'a qoodemmee'naa wede'e foofe.<verse eid="2KI 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 2:15" />Iyyaarikoo'ni daggeexxi tenne uudemmaki wabeekotike ya'i, «Eliyaasi'ni hedhemmaki hafuuri Elsa'i'ninna ofo'le'eeni» hine. Inisa'nenna isinni afemmo'a marreexxi isi edo heeshshi hine. <verse eid="2KI 2:15" /><verse number="16" style="v" sid="2KI 2:16" />Ookkoneechchi uduma «Kunnseteteni no'o atiki erganjuwwi jajjabba kadeeka onde tomme manna kaba anfeenneni; akimagaada Duuchchi Woddike Goottik Hafuuri gootta atika aadhe mitte kooba'ni uggeeke yookaani mitte dhooqa giddo ugge'oole marre hansowwaali.» Elisayinna «Waawwoti insa'ne erigitinoqqe.»<verse eid="2KI 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 2:17" />Insa'ne kinni waawwoti hiyya shookishshaa qico'ni jabeessine isoo kadhanteemmaxxee «Isinna ergitinaata» hiyye. Insa'nenna onde tomme manna ergine; mannikinna sase barra duuchcha hanseexxi anfebaangi gante.<verse eid="2KI 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 2:18" />Iyyaariko hedhe heqqaammake Elsa'ibaa hingee wodda: Elsa'inna «Ani edi wodda martinoqqe hiyye kuleennaba?» hiyye.<verse eid="2KI 2:18" /></para>
  <para style="s1">Elisa'i Hujeeka Mambe'uwwa</para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 2:19" />Qachchiinki manni Elsa'ii hiyyee qici, «Gootta no'oke ati uudateshanni kunni qachchi hedhatee elokeni kaddo malee'e wedi'i elokebaani; bogikinna midha fulchaakebaani» hine.<verse eid="2KI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 2:20" />Elisayinna «Haarooxxe odolcho'ni maxine wortine anibaa iyyedagge» hiyye; hiyyemmashshaani isibaa iyyedange.<verse eid="2KI 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 2:21" />Ookkoneechchi uduma Elisayinna wedi'inxe muummetiba mareexxi maxine wede'i giddo woreexxi, «Duuchchi Woddik Gootti hiyya'nee qici ‹Ani konnee wede'e fayyiseenneni: konneechchinni udumi'aa langaxxa reyotenna buttini midha fulcha gophatee'e buuto kadabaani› » hiyye.<verse eid="2KI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 2:22" />Eettene yannanaa'ni safeexxi Elsa'i hiyyeemmashshanni wedi'i techchi qico'ni qullichchaken.<verse eid="2KI 2:22" /></para>
  <para style="s1">Elsa'i'n Gacifanteexxa</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 2:23" />Elsa'inna ookko'ni ke'eexxi Beeteli'a me'o'aa Iyyaarko'ni ke'e: isinna orake'n me'ande'ni hedhee'naa qachchi giddii'ni heddo oose fuldeexxi hafuura gikki assite'e hitee qici, «Koo molanjo kabaa'ni fuli! Koo molanjo kabaa'ni fuli!» hita'ni isoo coore.<verse eid="2KI 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 2:24" />Elsa'inna udumi'aa wirri hiyye uudeexxinna; Duuchchi Woddike Goottike summinni insa'ne bade. Eettene yanna'ni lami meyyaki Dibi hinaaki biniinchi badda'aa giddi'ni fuleexxi eettenee oosenaa'ni shoole tommenna lame ninnife bire. <verse eid="2KI 2:24" /><verse number="25" style="v" sid="2KI 2:25" />Elisayinna Qermeeloosixxe koobaba'a qabate; ookko'ninna Semaariya'a hige.<verse eid="2KI 2:25" /></para>
  <chapter eid="2KI 2" />
  <chapter number="3" style="c" sid="2KI 3" />
  <para style="s1">Mo'abi Fuggoxxinni Ke'e</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 3:1" />Yihudak moyanji Iyyosafixi moyeexxe mitte tommenna saddeetixxe wogga'ni Aki'aabik belti Iyyoraami Isira'eeli'i moye galche. Isinna Semaariya ofo'leexxi tommenna lame wogga moye galche. <verse eid="2KI 3:1" /><verse number="2" style="v" sid="2KI 3:2" />Isinna Duuchchi Woddike Gootti edo diqachchiissaaxxa fuggoxxa yaane huje; fuggoxxi isixxi huje kinni anni isikinna ama isixxi hunjeemmaxxishshatebaani. Isinna anni isiki hujisemmaxxa Ba'aali hinaake magenixxa sooddo fugusse. <verse eid="2KI 3:2" /><verse number="3" style="v" sid="2KI 3:3" />Yaane kinni Naabaaxik belti Iyyorbi'aami Isira'eeli dedhisemmaxxe cubboni abidemee malee; isenaa'ni bayyata gibe.<verse eid="2KI 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 3:4" />Mo'aabik moyanji Meesha'i gedhebo horatammakemmani: wogga woggande'ni dhibba kuma buruusuwwanna dhibba kumika gedhebinxe korbeeyyexxa orda Isira'eelike moyanji'a gibira uwwaammani. <verse eid="2KI 3:4" /><verse number="5" style="v" sid="2KI 3:5" />Aki'aab reyeechchi uduma kinni Mo'aabik moyanji Isira'eelike moyanjo'ni fuggoxxinni ke'e.<verse eid="2KI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 3:6" />Eettene yanna'ni moyanji Iyyoraami Semaariya'n ke'eexxi Isira'eelika arda duuchcha bukki asse. <verse eid="2KI 3:6" /><verse number="7" style="v" sid="2KI 3:7" />Yihudake moyanji'a Iyyosafixxi'a «Mo'aabik moyanji ane'ni fuggoxxini ke'emmaxxe'e aninni welti duuldatto?» hiyyeexxi eriga iso'ni ergedhe.</para>
  <para style="p" vid="2KI 3:7">Moyanji Iyosaafixinna «Eeti atinni welti duulannoni; aninna atishshan, ardi ankinna atike ardishsha, fadhaduwwi aniki atike fadhaduwwishshandeni» hiyyeexxi isi'a hiisse.<verse eid="2KI 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 3:8" />Iyyosaafixxinna hiyyee qici, «Hoone ora duulaane?» hiyyee qore.</para>
  <para style="p" vid="2KI 3:8">Moyanji Iyoraaminna «Eedoomixxe qiilla gammoojje giddii'ni sa'neeteni» hiyye hiisse haaso'e.<verse eid="2KI 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 3:9" />Tennexxe Isira'eeliki moyanji Yihudake moyanjininna Eedoomike moyanjinni welti duulo'a ke'e. Iyyooraminna iittanni Yihudikinna, Edoomike moyanjuwwi duulo'a ke'e. Torbaane barra dooneechchi uduma sannachchuwwakeenna kadi hore insa'neeke gateeki wedi'i hedhemmabaani.<verse eid="2KI 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 3:10" />Isira'eeliki Moyanjnna, «Aane'e Duuchchi Woddik Gootti no'o sasiinga moyanjuwwa ye'eechchi no'o Mo'aabike moyanjixxe anga'ni sa'isse uwwo'ate?» hiyye.<verse eid="2KI 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 3:11" />Yaane kinni moyanji Iyyosafixxinna, «Isi ga'mi'ni Duuchchi Woddika Gootta laqe'nannoshsha kaba mitti wabeek hedhebaa?» hiyye qore.</para>
  <para style="p" vid="2KI 3:11">Moyanjo Isira'eelike moyanjike sannachchke ajajaluwwakenaa'ni mitti «Edi wodda Eliyaasike gargaarsanjo kadeemmaki Saafaxiinik belti Elsa'i kaba hedheeni» hiyyeexxi hiisse haaso'e.<verse eid="2KI 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 3:12" />Moyanji Iyyosafixinna, «Duuchchi Woddike Goottik hiyyichchi isi darree'ni afemaani» hiyye. Tennexxe Isira'eeliki moyanji Iyyosafixxinna Eedoomiki moyanji mitteba adadde isibaa dirrine.<verse eid="2KI 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 3:13" />Elsa'inna Isira'eelika moyanjo, «Atinni welti anee afensisaachchi maachcho hedhee'naate daggetteki; ta'a atike annixxi wabeekonna atixxe amaxxi wabeeko hexxeeba'a me'i» hiyye.</para>
  <para style="p" vid="2KI 3:13">Moyanji Isira'eelik moyanjinna hiisseexxi «Itta kaddabaani; Mo'aabike moyanjixxe anga'n sa'isse uwwo'aa no'oo sasiinga moyanjo mitteba no'o ye'eeki Duuchchi Woddike Goottani» hiyye.<verse eid="2KI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 3:14" />Elsa'inna, «Ani ergatemaanneke hedhaake Dada Duuchcha Ajajake Duuchchi Woddike Goottike summinni kakataannen. Ate'e gargaarate'e dageek Yihudake moyanjo Iyyosafixxi ulfeesenexxete malee; ate'e uudanaba; yookaan yaane anxeni ati'a hiyyanabani. <verse eid="2KI 3:14" /><verse number="15" style="v" sid="2KI 3:15" />Yaane kinni ta'anna kiraara ganaaka manjo aniba idagge.»</para>
  <para style="p" vid="2KI 3:15">Kiraara ganammakinna ganee wodda, Duuchchi Woddike Goottixxi hunna Elsa'i'n dagge'naa <verse eid="2KI 3:15" /><verse number="16" style="v" sid="2KI 3:16" />isinna hiyyee qici: «Duuchchi Woddik Gootti hiyya'nee qici: Tenne dhooqa'ni heddo bale umme. <verse eid="2KI 3:16" /><verse number="17" style="v" sid="2KI 3:17" />Duuchchi Woddik Gootti hiyya'nee qici: diidallotanna kadi xeena uuddinabaani; dhooqa kinni wedi'iki wo'mitaani; ha'noo, lali ha'nokinna weli hori ha'nokinna ha'no ha'witinaani. <verse eid="2KI 3:17" /><verse number="18" style="v" sid="2KI 3:18" />Tinni Duuchchi Woddike Gootti edo shollaxxe yaaneni. Mo'aabito anga ha'nooxxe'ni sa'isse uwwaani. <verse eid="2KI 3:18" /><verse number="19" style="v" sid="2KI 3:19" />Kinjiinke dala'ika qachchuwwanna elollamma qachchuwwa insa'neeka duuchcha injifattine adhdhitinaani. Elollamma haqquwwa insa'neexxa duuchcha kakkartinaani; wode'e ha'winammaxxa muummuwwa duuchcha duuchchitinaani shamoka fichcha insa'neeka kinoti balleesitinaani.»<verse eid="2KI 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 3:20" />Gorsa tolchi shiqammaxxi yanna geltee wodda Eedoomi darree'n wodi'iinxi muumme burqite butta duuchcha buqqe.<verse eid="2KI 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 3:21" />Tennexxe Eettene yannaa'ni moyanjuwwi lolo'a dageexxa Mo'aabito duuchchi laqqeemmaxxee; oosetenna kadi geedhe; loliinka miya abixxa dande'aaki ye'eme fuleexxi gabala heqqate'ni ke'ne.<verse eid="2KI 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 3:22" />Gorsa barrsa soodante ke'na wodda; arishsho wode'eke'ni cala cala hita'nemmaani. Wido hexxexxe Mo'aabitotinna woddi'i mundetishsha diimmatee'na uunde. <verse eid="2KI 3:22" /><verse number="23" style="v" sid="2KI 3:23" />Tennexxee insa'nenna hafuura gikki assineexxi «Ittiqqa mundete! Sasiingi no'oki naaphi weli'aani weli shiye'e bire'en! Yoona marrennexxi boga insa'neeka dhaallo!» weli'aani weli hine.<verse eid="2KI 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 3:24" />Yaane kinni Mo'aabito Isira'eelixxe kanbebaa marta wodda; Isira'eelinna kexxeexxi insa'ne lolde; Mo'aabitonna insa'ne edi'ni baqatte. Ookkoneechchi uduma Isra'elito boga insa'neeka lolideexxi Mo'abito shilte birte. <verse eid="2KI 3:24" /><verse number="25" style="v" sid="2KI 3:25" />Qachchuwwakanna balleessine: shamoka fichcha insa'neke duuchcha'ni kino wo'mita qico'ni mitti mitti manji mitte mitte kinjo fichchake'ni darbe; wodiinxa mumme duuchcha cunfe; elo eloxxa haqqe duuchcha kakkarre birre. Qirihereesi calli kinuwwati gateemmaani; isetenna kaddoole looyya darbata'ni lolaammaki lolinki mann buqeexxi lole miidhe.<verse eid="2KI 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 3:26" />Mo'aabitotik moyanji lolake'ni injifatemeexxa ege'neexxi wolaantichcha ka'leeka torbaane dhibba manna adhdheexxi Eedoomiki moyanji hedheeba oddo insa'neexxenaa'ni kute sa'ate'e wo'laane; yaane kinni dande'ebaani. <verse eid="2KI 3:26" /><verse number="27" style="v" sid="2KI 3:27" />Ookkoneechchi uduma isxxe bakka'ni moyaka angafa belto ifika aadheexxi qachchinke dalla'ani cincatike tolchcha asseexxi shiqishe. Isira'eeliki ardi tenne yaane'ni mufatemmaxxe; ookkonna waalleexxi ifike bogibaa hinge me'ine.<verse eid="2KI 3:27" /></para>
  <chapter eid="2KI 3" />
  <chapter number="4" style="c" sid="2KI 4" />
  <para style="s1">Aro'i Reyeexxe Hiyyeette Manjichchoxxa Zayite</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 4:1" />Wabeekotike ya'ixxe gamo kade hedheemmake mitte manjichchixxi are Elsa'i «Atiki erganji anki aro'i reyeeni! Isinna Duuchchi Woddika Gootta sodaataake manjo kadeexxa atinni egendeetteni; ta'a kinni anke aro'i'aa maalaqa liqeessemmaki manjichchi ookkone liqi'aa lame labbaxxa anxa oose adhdhe garbake assedho'aa dage'eeni» hita'ni Elisa'i'ni raarte.<verse eid="2KI 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 4:2" />Elsa'inna «Ani ati'a maa assona'a hassaatte? Mini atiki giddo mayi hedheexxa ane'ni kuli» isee hiyye.</para>
  <para style="p" vid="2KI 4:2">Isenna «Ani atixxi erganjo shiixxooxxe odolchonni hexxeexxa zayite malee weli afennelchi mittilchinna hedhebaani» hite.<verse eid="2KI 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 4:3" />Elsa'inna isee hiyyee qici, «Atike olla'a duuchchanaa'ni heddo oddowwa kadhati: <verse eid="2KI 4:3" /><verse number="4" style="v" sid="2KI 4:4" />Atinna oose atixxi mini giddi'a e'yitineechi uduma mine cufi: zayitetanna waabuwwa duuchcha'n fulchi: mitti mittingi waabi wo'ma wodda mitte gama'ni uggi.»<verse eid="2KI 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 4:5" />Tennexxe manjichcho hadi'a marteexxi oose ifixxinni welti hula cuffe: waabuwwa ise'a shiqinshaa'na'a ise wonshate'ni kexxe.<verse eid="2KI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 4:6" />Waabuwwa duuchcha wonshiteechchi uduma belto ifika «Wele waaba idagi» hite.</para>
  <para style="p" vid="2KI 4:6">Isinna kinni «Gateeki mitti waabinna hedhebaani» ise'a hiyye. Ookkoneechchi uduma zayite yaatammaxxi uurrite.<verse eid="2KI 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 4:7" />Isenna higgeexxi tenne Duuchchi Woddike Gootike manji'a kulde. Isinna, «Martettexxi Zayitetanna gurgudhdhite liqa affetteka manjichchoke hiissi: gateekinna ati'anna atixxe oose'a la'ote'e kadaani» hiyye.<verse eid="2KI 4:7" /></para>
  <para style="s1">Suunemitotixxe Manjichchoki Belti Reyotenaa'ni Ke'e</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 4:8" />Barra mitte Elsa'i Sunemi'a me'e. Ookkonna mitte dureette manjichcho hexxemmani; isenna ita ito'a jaba qici'ni isoo kadhatte; ookko'ni sa'aa wodda duuchcha ita ito'aa iseke mine'ni e'ya'nemmani.<verse eid="2KI 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 4:9" />Manjichotinna aro'o ifika hitee qici, «Kunni duuchchi wodda, hula no'oxxenaa'ni sa'a'neeki manji; qullichcha Duuchchi Woddike Goottike manjo kadeexxa ege'neenneni. <verse eid="2KI 4:9" /><verse number="10" style="v" sid="2KI 4:10" />Tennexxe mine iimiki hana mitte shiixxooxxe kutaka mine ijaarre mitte taqe, kibbe, baricumanna xxassa ugginannoni; no'oba'a dagaa wodda duuchcha ookko'o hafuura adhaani.»<verse eid="2KI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 4:11" />Mitte barra Elsa'i ookko dageexxi hafuura adhdhaammaxxe kutabaa iimi'a maraeexxi irikate.<verse eid="2KI 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 4:12" />Giyaazi'i erganjo ifika, «Marte eettene Sunemichcho ye'i» hiyye. Isinna ye'ee wodda daggeexxi isi edo uurrite. <verse eid="2KI 4:12" /><verse number="13" style="v" sid="2KI 4:13" />Elsa'inna, « ‹No'aa hite yo'oshsha rakkattetteni; maa ati'a assonna'a hassaatte? Moyanjoke'e yookaani loliinke mannke ajajalli'a ati'a kulanoxxi yaane hexxee?› hitetexxi ise'e qori» hiyye.</para>
  <para style="p" vid="2KI 4:13">Manjichchotinna hiissiteexxi «Aniqqa firi aniki giddo hedhennaxxee rakkonda afebe'noni» hite hiissite.<verse eid="2KI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 4:14" />Elsa'inna Giyaazi'i «Maa ise'a assinannota» hiyye qore.</para>
  <para style="p" vid="2KI 4:14">Giyaazinna, «Ise labbaka belto affebaani: iseki aro'inna cime'en» hiyye.<verse eid="2KI 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 4:15" />Elsa'inna «Isee ye'i» hiyye. Isenna daggeexxi hulate'ni uurrite.<note caller="-" style="x"><char style="xo" closed="false">4:15 </char><char style="xt" closed="false"><ref loc="GEN 18:14">Dada. 18:14</ref>. </char></note><verse eid="2KI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 4:16" />Elsa'inna «Dagaasane iittee wodda labba belto luu'mexxatton» ise'a hiyye.</para>
  <para style="p" vid="2KI 4:16">Isenna «Waawoti! Anke gootta; ati Mageniinki manji; maganneten addachchisabaaka muuxemabaaka hiyyichcho ane'ni haasoottoxxe!» hite.<verse eid="2KI 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 4:17" />Yaane kinni manjichchotinna siila'wite: Elsa'i hiyyemmaxxe eettene woga'ni labba belto ilde.<verse eid="2KI 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 4:18" />Beltikinna nophphe: mitte barra anni isiki midha haamammake mannini welti hedhemmabaa mare. <verse eid="2KI 4:18" /><verse number="19" style="v" sid="2KI 4:19" />Dedhange'ni «Umi anee bowwaasiseen! Umi anee bowwasiseeni!» hiyye. Annikinna erganjo ifika ye'eexxi; «Belto konne dukkettexxi amatibaa aaxxe iyyemari» hiyye.<verse eid="2KI 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 4:20" />Erganjikinna ookone belto aadheexxi amatiba iyyemare; beltikinna barra saafo'i qico'ni amate'ni luu'meme; ookkoneechchi uduma reye.<verse eid="2KI 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 4:21" />Iima Duuchchi Woddike Goottike manjixxe taqe'ni diiphisse; hulatanna iso'ni cuffeexxi fulde.<verse eid="2KI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 4:22" />Ookkoneechchi uduma aro'okanna yexxeexxi «Duuchchi Woddike Goottike manjibaa rake mare'e higonna'a mitte eriganjonna mitte harre ani'a ergi» hite.<verse eid="2KI 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 4:23" />Aro'i isekinna «Telcho isiba maye'e mara ati'a hasisse? Sanbatake yookaan baate fulatika ayyaana ulfeessinaaxxe barrabaan» ise'a hiyye.</para>
  <para style="p" vid="2KI 4:23">Isenna «Rakko hexxebaan: me'aanneni» hite.<verse eid="2KI 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 4:24" />Ookkoneechchi uduma isenna harre fe'edheexxi erganjo ifika; «Rakke me'itaashsha assi; ani uurisi hiyyonnole malee anxe hite laana me'issoxxe» hite.<verse eid="2KI 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 4:25" />Tennexxe kexxeexxi Duuchchi Woddike Goottiki manji hedheeba Qermeeloosixxe koobaba'a me'ite. Duuchchi Woddike Goottiki manji bayyi'nini afeexxi eriganjo ifika Giyaazi'i hiyyee qici, «Sunemichcho uuddetteni? Iikiixxi! <verse eid="2KI 4:25" /><verse number="26" style="v" sid="2KI 4:26" />Gongita'ni martettexxi maachcho ‹nage'aangebaa ati? Aro'i atiki nage'aangebaa? Belti atiki nage'aangebaa? Hitettexxi ise'e qori› » hiyye.</para>
  <para style="p" vid="2KI 4:26">Isenna «No'o Duuchchiing nage'akeni» hite.<verse eid="2KI 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 4:27" />Duuchchi Woddike Goottik manji hedheexxe kooba'ni gelteexxi lekka isixxe'ni ibbe; Giyaazi hoyyo'a dagee wodda Duuchchi Woddike Goottiki manji kinni «Yo'oshsha yaadeemmaxxee waali! Duuchchi Woddiki Gootti tenne maye'e anenaa'ni sho'exxanna ane'ni kula gopheexxa ege'nebo'nonni» hiyye.<verse eid="2KI 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 4:28" />Isenna «Anke gootta; ani'a belto uutottaa atee laqedheenna'a? ‹Muuxemabaake hiyyichchinni anee addachchissooxxe› atee hiyyeennabaa?» hite.<verse eid="2KI 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 4:29" />Elsa'inna Giyaazi'i, «Rakke kexxe anxa siqqo adhdhitettexxi me'i! Orake'ni mitti manjinninna nage'a aaxxoxxe: fedheeki manji nage'a ate'e aadhoole cuqqi hitoxxe; siqqichcho anxa beltinke albaa'ni uggi!» hiyye.<verse eid="2KI 4:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 4:30" />Beltiinxi ama kinn Elisa'ii, «Hedhaake Duuchchi Woddike Goottike summinninna hexxaatteke atike summinni kakataannen: haranga ate'e waale me'abe'noni!» hite. Tennexxe ke'exxi isexxa duuka me'e. <verse eid="2KI 4:30" /><verse number="31" style="v" sid="2KI 4:31" />Geyazinna edise me'eexxi siqqichcho beltinke albaa'ni hana ugge; yaane kinn hafuurikinna lubbo hexxeemmabaan. Tennexxee Giyazi Elsa'ibaa hige mareexxi «Belti dammaqebaani» hiyye.<verse eid="2KI 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 4:32" />Elsa'inna mini'a e'yee wodda belti taqete'ni diiphemmamaba reyeemmani.<verse eid="2KI 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2KI 4:33" />Belti kinna isi calli he'neeba hula culfeexxi; Duuchchi Woddike Goottibaa soodate.<verse eid="2KI 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 4:34" />Ookkoneechchi uduma taqeti iima sa'e beltoke'ni daba'leexxi ifika afo'o beltiinke afo'o'ni gence asse; illetanna, angatanna ittan ifixxe anganni gence asse. Konne rensha'ni hana dabba'le; eettene yanna'ni beltiinki bisi eebbe.<verse eid="2KI 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 4:35" />Elsa'inna ke'eexxi mini giddo eriqenna kayya maremeechchi uduma taqete'ni sa'eexxi higgeeni beltoke'ni hana daba'le; beltinkinna torbaane yanna hexxifatee'na ille isixxi baqqi hite.<note caller="-" style="x"><char style="xo" closed="false">4:35 </char><char style="xt" closed="false"><ref loc="1KI 17:21">1 Moy. 17:21</ref>. </char></note><verse eid="2KI 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 4:36" />Elsa'inna Giyaazi'i ye'eexxi «Sunemichcho ye'i» hiyye. Isinna isee'e ye'e. Isenna higge daggeeshshanni, «Belti atiki kunseten adhdhi» hiyye.<verse eid="2KI 4:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2KI 4:37" />Isenna buttinake'ni wabbi hiteexxi Elisayixxe lekka'ni ibbe: ookkoneechchi uduma beltokanna adhdhiite me'ite.<verse eid="2KI 4:37" /></para>
  <para style="s1">Ha'la Afeeka Qaa'minaachcho</para>
  <para style="p">
    <verse number="38" style="v" sid="2KI 4:38" />Elsa'i Geligeela'a hige; ookkone boga'ninna solo'i e'yeemmani. Wabeekotik orgi isi edo ofo'le hedhee'naa erganjo ifika hiyyee qici, «Lumoka waaba booso uggite konne manni'a qaa'minaachcho gafi» hiyye.<verse eid="2KI 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="2KI 4:39" />Wabeekole giddii'ni mitti shaaniinsha hedheka shafuwwa qocatee'e fichchi giddi'a mare: isinna badda'a giddo lateexxa buqqe afe; buqqetenaa'ninna qoonjinxa gumma qoceexxi seemma ifixxe'ni wonsheexxi hige dageexxi shashshateexxi qaa'minaammalcho gafemmaxxe odolcho'ni gafe; maachcho kadeexxa kinni ayyinna ege'neemmabaani.<verse eid="2KI 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="2KI 4:40" />Manni ito'a qaa'minaachcho hoole; reefi afo'iki manqeeshshaani «Koo Duuchchi Woddike Goottike manjo; odolcho giddo shiltaaxxe ha'la hexxeni!» hine raarre; itanna indebaani.<verse eid="2KI 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="2KI 4:41" />Elsa'inna «bulle ane'ni uwwe» hiyye. Eettene bulle odolcho giddo woreexxi; «Manni ito'a uwwe» hiyye. Odolcho giddonna shiyaachchi afemeba'a.<verse eid="2KI 4:41" /></para>
  <para style="s1">Dhibbi Manji Ita Ite</para>
  <para style="p">
    <verse number="42" style="v" sid="2KI 4:42" />Mitti manji umoke'ni raxxeexxe midhaxxa gumma ra'issineexxa lame tomme so'iinka xaltanna shiixxooka tisha qalqallote'ni uggeexxi Be'aalishaalisha Duuchchi Woddike Goottike manjibaa dage. Elsa'inna erganjo ifika «Manni ito'a uwwi» hiyye.<verse eid="2KI 4:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="2KI 4:43" />Erganjikinna, «Konnee hitta assee dhibba manji'a uwwanno?» hiyye qore.</para>
  <para style="p" vid="2KI 4:43">Elsa'i kinni, «Ito'a mannakee uwwi; Duuchchi Woddik Gootti, ‹Inde'na'a insa'ne'a gataani› hiyya'neeni» hiyye.</para>
  <para style="p" vid="2KI 4:43">Elisa'ina <verse eid="2KI 4:43" /><verse number="44" style="v" sid="2KI 4:44" />Ookkoneechchi uduma insa'ne'a shiqishshe Duuchchi Woddik Gootti hiyyemmashshanni inde'naa gate.<verse eid="2KI 4:44" /></para>
  <chapter eid="2KI 4" />
  <chapter number="5" style="c" sid="2KI 5" />
  <para style="s1">Ni'imaani Soomiinke Dhukkubanaa'ni Fayyee qico</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 5:1" />Ookkone wodda Ni'imaani Sooriyake moyanjike loliinke mannike ajajallommani; Duuchchi Woddik Gootti konne manjixxe daafenni Sooriya injifattaashsha asseemmaxxee gootta isike'ni lumokenna ulfeessemeeke manjommani. Janna loliinke manjo kadoolenna soomo'ekemman.<verse eid="2KI 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 5:2" />Loliink manni Sooriyii'ni fuleexxi, Isira'eelike boganaa'ni mitte dubarrichcho booji'e; iseenna Ni'imaanixxe are'a erigatenda'nemmani.<verse eid="2KI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 5:3" />Isenna ifixxe giitte'n «Anki gootti Ni'imaani Semaariyake boga'ni hedheeke wabeekiba mareexxi isoo afeeleqqa konne soomanaa'ni fayyamman» hite.<verse eid="2KI 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 5:4" />Ni'imaaninna gootti ifikiba'a mareexxi Isira'eelike boganaa'ni daggeemmaxxi dubaarrichcho hitemmaxxa kule.<verse eid="2KI 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 5:5" />Sooriyaki Moyanjinna «Yoona ta'ani mari; aninna Isira'eelike moyanji'a borro borreessannoni» hiyye; tennexxee Ni'imaani sase tomme kuma birretika sibiljo, jaane kuma maallaqa worqenna tomme iimi buttixxa seemma adhdhe me'e.<verse eid="2KI 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 5:6" />Isira'eelike moyanji'a uwwo'a abixxeemmaxxi borro, hitaamma qici, «Konne soominke dhukkubanaa'ni fayyissattoshsha tenne borro erganjo anke Ni'imaanixxe anga'ni uwwe eriganjo anka Ni'imani'i atibaa ergeenneni» hitaaxxemmani.<verse eid="2KI 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 5:7" />Isira'eeliki moyanji borro tennee bane uudeeshshan aareti seemma haaqqasse dareexxi, «Soomakenaa'ni fayyisonna'a kunni manjichchi aniba'a ergeechchi ani shiye fayyisa dande'annoke Mageno kadeenneni hiyyote? Uudde aninni welti lolemo'a hasa'neeni!» hiyye.<verse eid="2KI 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 5:8" />Mageniinki manji Elsa'i, Isira'eeliki moyanji seemma ifixxa dadareexxa laqee wodda, hiyya'ni isiba'a erga ergee qici, «Seemma atixxa maye'e dadartette? Manjichchi anibaa'a dagowwaali; ookkoneechchi uduma Isira'eeli giddo wabeek hedheexxa ege'naani.»<verse eid="2KI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 5:9" />Tennexxe Ni'imaani fadhadiinxe gaaruwwa'ni ofo'leexxi Elsa'ike minixxe hula'ni geyeexxi uure.<verse eid="2KI 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 5:10" />Elsa'inna, «Martettexxi Yordaanoosike galaana'ni torbaanele anshedhi; bisi atikinna fayyaani; atinna ca'a hitattoni» hiyye kulo'a erga isibaai'a erge.<verse eid="2KI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 5:11" />Ni'imaani kinni mufateexxi hiyyee qici, «Aniqqa dhugaanda ani biri'a dage'e uurre Duuchchi Woddike Goottika ifike Magenika summa ye'e; anga isixxini qaqqabe soomiinke dhukkubanaa'ni anee fayyisaake ane'ni labeemman. <verse eid="2KI 5:11" /><verse number="12" style="v" sid="2KI 5:12" />Wodi'iinxin Demasiqoki wodi'i, Abaananna, Faarfar, hoone Isira'eelike wodi'uwwanaa'ni sa'abaa? Anshedhatite kaddoole; ookkone wode'uwwa'nini anshedhe ca'a hiyya dande'annabaa?» tennexxe aara'ni hige.<verse eid="2KI 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 5:13" />Ni'imaaniki erganjuwwi kinni isi biri'a shiqeexxi hitee qici, «Anna no'oke, wabeek tennenaa'ni ha'urtaaxxa yaane assittatoshsha kuleechcho kadde'ele assittatabaa? Yoona ‹Anshexxettexxi ca'a hiyyi› hiyyoole maachcho atee dhibe?» hine. <verse eid="2KI 5:13" /><verse number="14" style="v" sid="2KI 5:14" />Tennexxe Ni'imaani adadde dirreexxi Mageniinki manji kulemmashshan Yordaanoosike galaana'n cuuphemma'ni fula'ni torbaanele anshedhe: bisi isikinna shiixxooke beltike bisishsha kade ca'a hiyye.<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="LUK 4:27">Luq. 4:27</ref>. </char></note><verse eid="2KI 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 5:15" />Ookkoneechchi uduma Ni'imaani isinni welti manni duuchchinni Mageniinke manjibaa hige me'e; isi edo uurreexxi, «Kunseteni Isira'eelike boga'ni malee butta duuchcha'ni weli Magen hedhebaaxxa ege'nenneni; tennee ta'anna erganjo atikenaa'ni uwwa adhittota'a kadhataanneni» hiyye.<verse eid="2KI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 5:16" />Iikki Wabeekinna, «Ergatemaanneke hedhaake Duuchchi Woddike Goottixxa mittechchonna adhabe'noni» hiyye hiisse. Mittechchonna midde Ni'imaani maganise kadhatoolenna adhdhebaani.<verse eid="2KI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 5:17" />Tennexxe Ni'imaani hiyyee qici, «Uwwa anxa adhdha gophaattole Duuchchi Woddike Gootti'a malee hoone magenuwwi'aa ciincatika yookaani wele tolcha shiqisha gophaannaxxe lame gaange'ni buttina fe'edhdhe adhdhe me'onnaa eetti uuttotaa atee kadhataanneni. <verse eid="2KI 5:17" /><verse number="18" style="v" sid="2KI 5:18" />Yaane kinni Duuchchi Woddik Gootti mitte yaane'aa calla erganjo atika ane'e gattowwaali hiyyowwaali; tinninna gootta ank magenoonfato'a Remoonike fakketi mine'ni e'yeexxi ane'n irkataa wodda aninna isishanni ookko magenoonfatonnole, Remoonike fakketike mine'ni magenoonfatennexxe Duuchchi Woddiki Gootti erganjo atika ane'e gattowwaali hiyyowwaali.»<verse eid="2KI 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 5:19" />Elsa'inna «Nage'ik me'i!» hiyye. Ni'imaaninna shiixxoo qico bayyate me'eshshani. <verse eid="2KI 5:19" /><verse number="20" style="v" sid="2KI 5:20" />Eliyaasike erganjo kadeek Giyaazi, «Anke gootta kunni Sooriyichchi Ni'imaani iyyedagemmalcho adhdha gopha eloxxeebbaani; hedha'neeke Duuchchi Woddike Goottixxa isoo hordofe isonaa'ni mittechcho adhdhannoni» hiyye hede.<verse eid="2KI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 5:21" />Tennexxe Giyaazi Ni'imaani'i hordofe: Ni'imaaninna Giyaazi udumii'ni gonga'ni daga'neexxa uudeexxi; fadhadiinxe gaarenaa'ni dirreexxi «Maye, elonxee daggette?» hiyye qore.<verse eid="2KI 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 5:22" />Giyaazinna, «Duuchchiingi nage'akeni; kinni anke gootta, ‹Wabeekotike organaa'ni lame dargaggeeyye Efireemike tullichchuwwinke boganaa'ni anibaa ta'a dedhange'ni dangeemmaxxe maganneteni sase kuma biretika sibiljnaa lame iimi buttixxa seemmaa uwwi hite kuli› hina'ni anee ergineeni» hiyye.<verse eid="2KI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 5:23" />Ni'imaaninna «Maganneteni jaane kuma biretika sibljo uwwanno» hyye. Giyaazi'i magannise kadhate. Ookkoo'n jaane kuma birretika sibiljo lame subi gido usureexxi lame iimi buttixxa seemma lebeexxi lame erganjuwwa'ni dukiseexxi; insa'neenna eettene ba'e'neexxi Giyaazi edo me'ine.<verse eid="2KI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 5:24" />Giyaazinna tullichchake'ni geyeeshshani ookkone lame subba eeriganjuwwakenaa'ni aadheexxi mini giddo ugge; mannakanna geegeessee'naa me'e.<verse eid="2KI 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 5:25" />Ookkoo'ni e'yeexxi gootta isiki Elsa'i edo uure. Elsa'inna «Koo Giyaazi haba hexxetta?» hiyye qore. Giyaazinna «Atiki eriganji habanna mareenbi hedhebaani» hiyye hiisse.<verse eid="2KI 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 5:26" />Elsa'inna isoo hiyyee qici, «Iikki manjichchi atinni afemo'a gaaretenaa'ni dirra wodda anki hafuuri atinni welti me'emmabaataa? Tinni malaqinna seemma ejersiinxe zayiteki hiddichchi, woyinetiki fichchi, gedhebiinkinna laliinki labbakinna meyyaxxi eriganjuwwa adhdhitattoxxe yannabaan. <verse eid="2KI 5:26" /><verse number="27" style="v" sid="2KI 5:27" />Tennexxee Ni'imaanik soomi ate'ni higaani; duuchchi woddi'anna atixxe horte'ni tare sa'aani.»</para>
  <para style="p" vid="2KI 5:27">Ookkoneechchi uduma Giyaazi Elsa'i biri'ni me'e; kaadetishsha gola'laa qico'ni soomo'e gate.<verse eid="2KI 5:27" /></para>
  <chapter eid="2KI 5" />
  <chapter number="6" style="c" sid="2KI 6" />
  <para style="s1">Maxirabi Leelle qico</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 6:1" />Wabeekotik orgi Elsa'i'n hiyyee qici, «Kunni, ati edo ofollannoki boonchi cu'mate'eni. <verse eid="2KI 6:1" /><verse number="2" style="v" sid="2KI 6:2" />Tennexxe Yordaanoosike galaaniba marrenneexxi no'o mitti mittingi haqichcho wonxe iyyedango; ookkoonna he'nannoka mine ijaarro» hine.</para>
  <para style="p" vid="2KI 6:2">Elsa'inna «Kaddaqqata me'e» hiyye.<verse eid="2KI 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 6:3" />Wabeekkole giddii'ni mitti Elsa'ii, «Atinna erganjuwwi atikinni welti daggaboxxoota?» hiyye.</para>
  <para style="p" vid="2KI 6:3">Elsayinna «Eloxxeni me'annoni» hiyye.<verse eid="2KI 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 6:4" />Insa'neni weltinna me'e. Yordaanoosika galaana genneshshaani haqqe cirate'ni ke'ne.<verse eid="2KI 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 6:5" />Inisa'nee giddii'ni mitti haqqe woxate'ni hedhee'na'a dedhange'ni maxirabi haqichchokenaa'ni luffi hiyyeexxi wedi'i giddo ibe: isinna «Maa mambe'a anke gootta; manjokenaa'ni aadhenneke maxarabaqqa!» hiyye raare.<verse eid="2KI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 6:6" />Mageniinki manjinna «Hoone darre'ni ibee?» hiyye qore.</para>
  <para style="p" vid="2KI 6:6">Manjichchikinna qoce ibeemmaxxa bakka kulee wodda, Elsa'iinna haqichcho woxeexxi wede'i giddi'a takki asse maxirabi wode'eke'n iimi'a dage. <verse eid="2KI 6:6" /><verse number="7" style="v" sid="2KI 6:7" />Ookkoneechchi uduma Elisa'inna, «Fulchite aadhi» hiyye. Manjichchikinna anga qeerriseexxi aadhe.<verse eid="2KI 6:7" /></para>
  <para style="s1">Elsa'i Sooriyak Manni Ille Ba'aashsha asse</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 6:8" />Eettene yanna'ni Sooriyike bogiki moyanji Isira'eelike ardinni welti lolemma'ni heedhemani: isinna loliinke mannike ajajalluwwinni welti mari'atechchi uduma, «Kaba, konne booncho'ni ofo'lannoni» hiyye. <verse eid="2KI 6:8" /><verse number="9" style="v" sid="2KI 6:9" />Mageniinki manjinna, «Sooriyaki manni ooko'ni butti'a dirremmaxxee ookkone gamanaa'ni saxxaboxxoshsha heqedhi» hiyya'ni Isira'eelike moyanji'a erga erge.<verse eid="2KI 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 6:10" />Tennexxee Isira'eeliki moyanji Mageniinki manji kulemmaka booncho dooyyinaashsha asse; Elsa'inna moyanjo iitta hedheeke boonchonaa'ni ifi heqqedhaashsha mittenna lame yanna iimi darre xexxe'achchiise.<verse eid="2KI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 6:11" />Tinninna Sooriyaka moyanjo yo'oshsha jinnisseemmaxxee; loliinka manna ajajammakaara ye'eexxi «No'o giddii'ni Isira'eelike moyanjinni welti jaaloomeeki hedhoole ane'ni kuldinabaa?» hiyye insa'ne qore.<verse eid="2KI 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 6:12" />Loliinke mannike ajajaalluwwi giddii'ni mitti «Anke gootta, Moyanjoo; no'o giddii'ni mittikinna tennee assaaki hedhebaan; yaane kinni ati ma'nande'ni hexxe haasottattooxxa midde mittetinna gattebaangi Isira'eelike moyanji'a kula'neeki Isira'eeli giddo hedheeki wabeek Elsa'iteni» hiyye.<verse eid="2KI 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 6:13" />Sooriyik moyanjinna, «Manna erge abidisonna'a; Isi haba hedheexxa hasse» hiyye ajaje. Ookkoneechchi uduma «Elisayi Dootani hedheeni» hitaaxxi odo iso'ni gelte.<verse eid="2KI 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 6:14" />Tennexxe Moyanjikinna fadhadokanna fadhadiinxe gaarreni itaani heddo loliinka manna ooko'a erge. Insa'nenna hashsha me'ina'ni galle marre genne qachcha bunqe.<verse eid="2KI 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 6:15" />Mageniinke manjiki erganji barrsa ke'eexxi gadhi'a fulee wodda, fadhadiinkinna sarageelluwwake'n hedheeki ifi jabeessedheeki loliinki manni qachcha bunqeemmani. Erganjikinna «Anke gootta; maa assinennexxa woyya?» hiyye qore.<verse eid="2KI 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 6:16" />Iikki Wabeekinna «Meeco'o no'oni weliti hedheeke sannachchi insa'neni welti hedhekenaa'ni sa'aakeni sooddattoxxe» hiyye.<verse eid="2KI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 6:17" />Ookkoneechchi uduma Elsa'inna «Duuchchi Woddike anke Goottaa; uudaashsha ille isixxa bani» hiyye soodate. Duuchchi Woddik Goottinna erganji isikixxa ille bane; uude woddanna giiratiki fadhadinna gaaruwwa koobuwwate'ni Elsa'ika qarqara buqqee'naa uude.<verse eid="2KI 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 6:18" />Sooryiki manni adadde dirre isibaa marree wodda Elsa'inna, «Konne arda balla'ake assi» hiyye. Duuchchi Woddike Goottibaa soodate. Tennexxee Elsa'i laqemmashshaani Duuchchi Woddiki Gootti insa'ne bala'ake asse.<verse eid="2KI 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 6:19" />Elsa'inna insa'nee, «Ori kabaa'nitebaann: qachchi konnetebaani: hassina'neeke manji'baa ha'noo geessisonnaa anxa duuka amme» insa'nee hiyye. Ookko'ni akeeka'ni Semaariya'a adhdhe me'e.<verse eid="2KI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 6:20" />Qachchi giddi'aa e'yineechchi uduma Elsa'i «Duuchchi Woddike Gootta uundaashsha konne mannixxa ille bani» hiyye. Duuchchii Wddik Goottinna ille insa'neexxa bane; insa'nenna Semaariya giddo he'neexxa egenne.<verse eid="2KI 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 6:21" />Isira'eelik moyanji insa'ne uudee wodda, «Anke anna insa'nee shiyoo?» hiyyeexxi Elsa'ii qore.<verse eid="2KI 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 6:22" />Elisayyina «Insa'ne shiltoxxe; wolaantichchikina gabeti boojitetteka manna shiya ati'a hasissa? Ta'anna indaachchonna ha'winaachcho shiqinshaasha assi inde ha'wineexxi gootti ifikibaa me'inuuni» hiyye.<verse eid="2KI 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 6:23" />Tennexxe lumoxxa ita qophpheesise'naa inde ha'wineechchi uduma insa'ne geegeesse'na'a gootti ifikibaa me'ine. Sooriyaki loliinki manninna Isira'eeli'i lolo'a ookkoneechchi uduma hige dagebaani.<verse eid="2KI 6:23" /></para>
  <para style="s1">Buqendeexxe Samariya'ni Geyeeka Solo'o</para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 6:24" />Shiixxooxxe yannan uduma Sooriyaki moyanji Beenihadaadi duuchchiinga loliinka manna bukki asse; fuleexxinna Semaariya elqe kayyi'ni buqe.<verse eid="2KI 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 6:25" />Ookkone qachchakanna elqe kayyii'ni buqeemmaxxe mitte harreki umi saddeeta tomme birretika sibiljo; lame tomme kiilo geyaaki guugenjotiki cili iittanni onde birretike sbiljo'ni gurgurra qico'ni jabake solo'o kadde.<verse eid="2KI 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 6:26" />Isira'eelik moyanji dalla'i giddo mammaremaa'naa mitte manjichcho hafuura gikki assiteexxi «Anke gootta, moyanjo; maganneteni anee gargaari!» hite.<verse eid="2KI 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 6:27" />Moyanjikinna, «Duuchchi Woddik Gootti ate'e gargaara gophoole ani hitta ate'e gargaaranno? Midhatite moo yookaan woyinetike bulbulinnite atee gargaaraanneki?» hiyye hiisse.<verse eid="2KI 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 6:28" />Ookkoneechchi uduma «Isi maachcho atinxi rakko?» hiyye isee qore.</para>
  <para style="p" vid="2KI 6:28">Isenna kinni hita'ni hiissitee qici: «Tinni manjichcho, ‹Telcho belto atika indonnaa uwwi; soodo kinni anka belto indannoni› anee hite. <verse eid="2KI 6:28" /><verse number="29" style="v" sid="2KI 6:29" />Tennexxe anka belto galfine indenneni. Gorsa kinni, ‹Belto atikanna indonna'a idagi› isee hiyyenneni; isenna kinni sho'exxe.»<note caller="-" style="x"><char style="xo" closed="false">6:29 </char><char style="xt" closed="false"><ref loc="JER 41:10">Erm. 41:10</ref>. </char></note><verse eid="2KI 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 6:30" />Moyanjikinna manjichcho hiteexxa laqeeshshan yaaddoti seemma ifixxa daddare; dalla'i giddo mammaremaa wodda giddo doonyya odo'weexxa ardi uude.<verse eid="2KI 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 6:31" />Moyanjikinna, «Saafaxiinika belto Elsa'iki umi telcho woxemebaaki galoole; Mageni ane'e balleesso; tennee saxxeexxa ane'ni asso» hiyye.<verse eid="2KI 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 6:32" />Eettene yanna'ni Elsa'i mine ifinge'ni ofo'leemmaani; geedhuwwatinna isinni welti ofoldeemmaani. Moyanjikinna erganji edise me'ashsha asse. Erga maremmaki manji mare geyebaa edigama Elisayinna geedhe ifixxe, «Kunni manjo anga sa'eki gooba anka woxxo'a manjo erigeexxa affineeni hexxine? Kunni ta'anna erigememmaki dagaa wodda hula cuffine mini'a e'yabaashsha asse; moynjiiknna isi udumi'ni dagate'n hedheen» hiyye.<verse eid="2KI 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2KI 6:33" />Elisayi geedhdheti welti haaso'ange'ni hedhdhee'naa; erganji isiba'a adade dirre dage. Moyanjikinna dageexxi, «Tennee rakko no'o'ni iyyedageeki Duuchchi Woddike Gootta; ani Duuchchi Woddike Goottanaa'ni maachcho heqqedhaanneta?» hiyye.<verse eid="2KI 6:33" /></para>
  <chapter eid="2KI 6" />
  <chapter number="7" style="c" sid="2KI 7" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 7:1" />Elisa'inna «Yooni Duuchchi Woddike Goottika hiyyichcho laqi! Duuchchi Woddiki Gootti soodo iittexxe yanna'ni Semaariyaxxe hula'ni sase killo eloxxa bulle yookaan jaane kilo so'a mitte sibiljinxe birre'ni gurgurraani» hiyye isi'a hiisse.<verse eid="2KI 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 7:2" />Moyanji irkote assedhe'eeka loliinka manna ajajammaki; Magenika manjo, «Itani kadoolenna Duuchchi Woddik Gootti iimuwwatixxa hulaanna banoole midde iitta kada dandeetta?» hiyye qore.</para>
  <para style="p" vid="2KI 7:2">Elisayinna, «Tenne ati umi atingennini ille atixxini uuddatoni; kaddo malee eettene midhanaa'ni mittelchonna afo'iki maqqaboxxoni.»<verse eid="2KI 7:2" /></para>
  <para style="s1">Sooryinke Loliinke Mannika Baqa</para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 7:3" />Eettene yanna Soomiinke dhukkubin abidemeeki shooli manni qachchi giddi'a e'yinammaxxe hula'ni hedhemman: insa'nenna weli'an weli hinaamma qici: «Rennano qico'ni kaba he'naanneki Maye'etesi? <verse eid="2KI 7:3" /><verse number="4" style="v" sid="2KI 7:4" />Yoona ‹Qachchi giddi'a e'yinannoni hinonnole› ookkoonna solo'iki rennannoni; kabanna he'nonnole reya no'oxxinna ittani gatta'nebaani; tennexxee Sooriyitotike ola'ibaa'a sammi hine me'ino sammi hinoole lubbo gantannoni; shinnoolenna rennannoni» hine.<verse eid="2KI 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 7:5" />Ookkoneechchi uduma bogi galigalo'e wodda, ke'neexxi Sooriyike mannike ola'ibaa me'ine: ookkoo gennee wodda manjonge hinaachchi mitti hedhemmabaan.<verse eid="2KI 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 7:6" />Tinni itta kaddeexxi buuto Duuchchi Woddiki Gootti Soriyika manna fadhadinkanna fadhadiinxe gaaruwwaka ittani heddi lolinke mannka hafuura Sooriyito laqqaashsha assemmaxxeettemmani; insa'nenna welii'ani weli «kunni Isira'eeliki moyanji no'o lole miidho'a; Hiititotikanna Gibtseka moyanjuwwa hidhdhe no'o'ni iyyedage'eni» hine.<verse eid="2KI 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 7:7" />Tennexxee insa'nenna bogi galgalo'ee wodda, ke'neexxi baqante; duunkaana ifika, fadhadokanna harre adhdhinebaani; lubbo ifixxa calla gatirsatee'e hineexxi ola'a ifika waalle me'ine.<verse eid="2KI 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 7:8" />Soomo'emmaki manni ookkone olla'i bira geyeechchi uduma; duunkaanne mitte giddo e'yyine; inde, ha'wine; ookko'n birretika sibljo, worqenna seemma adhdhine me'ineexxi hinge dangeexxinna wele duunkaanne giddo e'yineexxi wele yaanuwwanna adhdhineexxi sho'e'ne.<verse eid="2KI 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 7:9" />Insa'nenna weli'aan weli hinee qici; «Elobaaxxe hunjenneni; telchii gammashshotixxe barrani; tenne gammashsho no'oo kinni ifi'aa calla asse'nenneni; sooda qico'ni heqinonole mura wonxanoxxe hexxeen. Tennexxe mootummatike minbaa ranke marrenneexxi kullo!»<verse eid="2KI 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 7:10" />Ookkoneechchi uduma insa'nenna ookkone qachchik giddi'aa e'yinammaxxa hula heqqammaka manna cancina'ni ye'neexxi, «Sooriyitotike olla'i giddi'a e'yineenneni; ookkonna usurreeka fadhadonna harre malee mitti manjinna hedhemmabaani; hafuuri mittinna hedhemmabaani; duunkaanuuwwakinna hedheemmashshanni hedheemmani» hine kulle.<verse eid="2KI 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 7:11" />Hula heqqaammaki manninna tenneeni hafuura gikki asse haaso'emmaxxe odotinna mootummatike mini qico'ni laqende.<verse eid="2KI 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 7:12" />Yannatinna galgala temmani; moyanji diiphemabaa'ni ke'eexxi loliinke mannika ajajaluwwa hiyyee qici, «Sooriyake mannika yaada ha'noo'ni kulo! Insa'ne kaba hedheeka solo'o egene'een. Tennexxee kaanbe insa'nexxa waalexxi hadi giddi'a sho'omatee marre'en; no'onna ita harsecca fulloonole lubbondinni no'oo boojinee'e qachcha no'okanna adhdhinaan.»<verse eid="2KI 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 7:13" />Loliinka sooresuwwinaa'ni mitti hiyyee qici: «Konne qachchi giddo lubbo gateek ardi konneechchi edo reyeemake mannishsha reyotenee'ni gataakebaan. Tennexxee kaddeexxa yaane egenannoshsha heenook manna fillenexxi reyotenaa gateemake onde fadhadinni welti erginoo» hiyyaaka yaada shiqishe.<verse eid="2KI 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 7:14" />Insa'nenna heenoka manna fille; moyajikinna ookkone manna lamee sarageela'ni ofolaashsha asseexxi Sooritotike sannachcha'ni gelteexxa yaane memmekinseexxi hiisichcho uunaashsha akeete uwweexxi insa'nee erge. <verse eid="2KI 7:14" /><verse number="15" style="v" sid="2KI 7:15" />Iikki manninna ookkoo'ni ke'eexxi Yordaanoosike galaani qico'ni ke'ne me'ine; ora orake'ni Sooriyik manni baaja'ni hune me'eemaka seemmatanna miyuwwa duuchcha uunde. Ookkoneechchi uduma hinge dangeexxi tenne duuchcha moyanjokee haasone.<verse eid="2KI 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 7:16" />Ookkoneechchi uduma Ardikinna elqenna kayya higeexxi Sooriyake mannixxa karra saame adhdhine. Duuchchi Woddik Gootti edisee haaso'emmashanni sase kiilo eloxxa dinne yookaan jaane kiilo so'aa mitte birretike sibiljo'ni gurgurreeni.<verse eid="2KI 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 7:17" />Eettenee yanna Isira'eeliki moyanjik ookkone qachchika dalla'ixxa hula heqqaake shiqike loliinke mannika ajajalo kadeeke erganji baale hunda heqqendaasha asseeman. Yaane kinn ookkone erganjo ardi hirbeesee'naa ookone reye. Tinni kaddeedek moyanji Elisa'ii haaseso'aa maree wodda Eeliyaasi ookkone erganjo'ni haaso'emake raagik hiyyichchi muuxemeemmaxeeten.<verse eid="2KI 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 7:18" />Eettene yanna'ni Eeliyaasi moyanjoke, «Soodo tenne yanna'ni Semaariyaxxe hula'ni sase kiilo eloxxa dinne yookaan jaane kiilo so'a mitte biretike sibiljo'ni gurgurraan» hiyyemmaxxi muuxende. <verse eid="2KI 7:18" /><verse number="19" style="v" sid="2KI 7:19" />Loliinke manniki akeekisanji Magenike manjo'ni; «Duuchchi Woddik Gootti iimatixxa masikootuwwa banoole midde tinni hitta kada dandeetta?» hiyyemmaxxe; Mgeniki manji, «Tenne atinni umo atinginini uuddattoni yaane kinni midha ettenenaa'ni mittelcho afo'iki maqqaboxxoni» hiyyexxi hiisse'emmani.<verse eid="2KI 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 7:20" />Ookkone erganjo e'yinammaxxe hula'ni ardi hirbeessee'naa reyemmaxxe kulendemmaxxi muuxende.<verse eid="2KI 7:20" /></para>
  <chapter eid="2KI 7" />
  <chapter number="8" style="c" sid="2KI 8" />
  <para style="s1">Sunemichcho Manjichchoki Bogi Higeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 8:1" />Eettene yanna'ni Elsa'i belto iseka reyotenaa'ni ise'a ke'isseexxi manjichcho, «Duuchchi Woddik Gootti torbaane wogga qico'ni turaaka solo'o konne boga'ni ibise'en: kexxettexxi yannate tura dandeettattoke boonchiba'a atike mini hadinni welti me'i» hiyye.<note caller="-" style="x"><char style="xo" closed="false">8:1 </char><char style="xt" closed="false"><ref loc="2KI 4:8-37">2 Moy. 4:8-37</ref>. </char></note> <verse eid="2KI 8:1" /><verse number="2" style="v" sid="2KI 8:2" />Manjichotinna kexxeexxi Mageniinki manji ise'a kulemmashani assite; mini hadi isekini me'iteexxi; Filisixeemike boga'ni torbaane woga ofolde.<verse eid="2KI 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 8:3" />Torbaane wogga muuxendeechchi uduma Filisixeemike bogibaa'ni higge dagge: ijaadhiteemmake minixxeenna bogi ifikixxe'e ku'lito'a moyanjiinbaa me'ite.<verse eid="2KI 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 8:4" />Eettenne yanna moyanji, Mageniinke manjika erganjo Giyaazinni welti, «Elisa'i hujeexxa lumollamma yaanuwwa duuchcha ane'ni kuli» hiyya'nemmaani.<verse eid="2KI 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 8:5" />Elisa'i belto iseka reyotenaa'ni ke'issemmaxxi manjichcho mine ifikixxenna bogi ifikixxe ku'lito'a moyanjiinba'a shiqqeemmaxxa yanna Elisa'i reyeemmaka iseka belto hitta asse reyotenaa'ni ke'iseexxa Giyaazi moyanjoke'ni kulaammaxxe yanna'nitemmaani. Giyaazinna «Gootta anke moyanjo; iitti manjichonna tenneteni; Elisa'i reyotenaa'ni ke'issemmaki isek beltinna konneteni» hiyye.<verse eid="2KI 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 8:6" />Moyanjikinna tenneenni yaane qoree'na isenna hiissite kuldee. Ookkoneechchi uduma moyanji, «Afeechcho duuchcha itani waalde me'itettexxe yanna'ni ta'i qico'ni hedhdheeka fichchi isekixxa karra duuchcha ise'a hiissitattoshsha» hiyye jalqaba ajaje.<verse eid="2KI 8:6" /></para>
  <para style="s1">Azaheeli Benhadaadi Shiye</para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 8:7" />Elisa'i Demasiqo'a me'e; ettenne yanaa'ni Sooriyaki moyanji Beenihadaadi ela gopheemmaani; moyanjokeenna, «Mageniinki manji kabaa'a dage'eni hine kulle» <verse eid="2KI 8:7" /><verse number="8" style="v" sid="2KI 8:8" />Isinna Azaheeli'i, «Uwwa angate'ni abixxite maritetexxi Magenke manjinni welti afemi. Isi darree'ni ‹Konne dhukkubanaa'ni fayyani fayyanno?› hitetexxi Duuchchi Woddika Gootta qodhdhi» hiyye.<verse eid="2KI 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 8:9" />Ookko'ni Azaheeli Demasiqo bogi giddo huccemalchonaa'ni elolla yaane duuchcha shoole tomme gaaluwwa'ni fe'eexxi Elisa'yiba'a mare; Azaheelina Elisayi edo uurreexxi, «Sooriyaki moyanji atiki belti Beenihadaadi; ‹Dhibo tennenaa'ni fayyani fayaanno?› hiyye atibaa anee erge'eni» hiyye.<verse eid="2KI 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 8:10" />Elisa'inna, «Marittettexxi, ‹Fayya dhugaaten fayyitattoni› hiyyi. Yaane kinni reyaaxxa Duuchchi Woddik Gootti ane'ni leeliishe'eni; ‹Martettexxi, Dhugaaten fayyitabxxon› hiyyi reyaaxxa Duuchchi Woddik Gootti ane'ni ifise'een» hiyye hiisse.<verse eid="2KI 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 8:11" />Shooka qico'ni, Elsayinna Azaheeli'i dhaphphi hiyye uude; ookkoneechchi uduma Mageniinki manji Elisayi oodhee indiddo dune.<verse eid="2KI 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 8:12" />Azaheelinna «Anke gootta mayee ooxxaatte?» hiyye qore.</para>
  <para style="p" vid="2KI 8:12">Elisa'yinna hiisseexxi, «Isira'eelike arda'ni assittaattoxxa fuggoxxa yaane ege'nennaxxeeten: kolluwwa insa'nexxa giirati gubbatton: dargageeyye insa'neexxa wolantichchik shiltattoni; oose insa'neexxanna buttinake'ni cancaqqattoni, siila'witeexxa melaalle insa'neexxika godobanna daritattoni» hiyye.<verse eid="2KI 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 8:13" />Azaheelinna «Yoona woriishinnsha uudemannok atiki eriganji ani tenne heene hunnaanni assa dande'anno?» hiyye.</para>
  <para style="p" vid="2KI 8:13">Elisa'ina hiisseexxi, «Ati Sooriyake moyanjo kadde mootattoxxa Duuchchi Woddik Gootti ane'ni leellishe'eni» hiyye.<note caller="-" style="x"><char style="xo" closed="false">8:13 </char><char style="xt" closed="false"><ref loc="1KI 19:15">1 Moy. 19:15</ref>. </char></note><verse eid="2KI 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 8:14" />Ookkoneechchi uduma Azaheel Elisa'i biri'nii fuleexxi gootti ifikiba'a hige; Benhadaadinna «Abbo Elisayi maa hiyye?» hiyye qore.</para>
  <para style="p" vid="2KI 8:14">Azaheelinna «Dhugaandinni dhibo tennenaa'ni fayyitattoxxa ane'ni kule'eni» hiyye.<verse eid="2KI 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 8:15" />Yaane kinni gorsa bariisa Azaheeli ejja aadheexxi wodi'i giddo cuuphe: ookkooni moyanjo Banihadadi'i buqeexxi shiye.</para>
  <para style="p" vid="2KI 8:15">Azahelina Benihadadike booncho'ni Sooryike moyanjo kade.<verse eid="2KI 8:15" /></para>
  <para style="s1">Yihudaka Moyanjo Iyyoraami'i</para>
  <para style="r">(<ref loc="2CH 21:1-20">2 Odo. 21:1-20</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 8:16" />Isira'eeliki moyanjiki Aki'aabik belti Iyyoraami moyemmaxxe ondixxe wogga'ni Iyyosafixxiki belti Iyyoraami Yihudaka boga moye. <verse eid="2KI 8:16" /><verse number="17" style="v" sid="2KI 8:17" />Isinna moyee wodda, wogga isixxi sase tommenna lame woggammani; Iyyerusaalemi ofo'leexxi saddeeta wogga galche.<verse eid="2KI 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 8:18" />Are isixxinna Aki'aabixxe belto kaddeemmaxee Aki'abike mini hadi assammashsha isinna Isira'eelike moyanjuwwika ora hordofe; Duuchchi Woddike Gootti edo elobaaxxa huje huje.<verse eid="2KI 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 8:19" />Kado malee'e eriganjo ifike Daawwitixxee hiyyeexxi Duuchchi Woddik Gootti kinni Yihudaa balleesso'a hasebaani; tininna Daawwiti'i horte ifixxenaa'n moyanjo gophabaaxxa addachchise'emmaxxeeten.<note caller="-" style="x"><char style="xo" closed="false">8:19 </char><char style="xt" closed="false"><ref loc="1KI 11:36">1 Moy. 11:36</ref>. </char></note><verse eid="2KI 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 8:20" />Iyyoraami moye galchammake baro'ni Eedoomi Yihudake'ni elobaaxxinni ke'eexxi; ifika moyanjo moyaashsha asse.<note caller="-" style="x"><char style="xo" closed="false">8:20 </char><char style="xt" closed="false"><ref loc="GEN 27:40">Dada. 27:40</ref>. </char></note><verse eid="2KI 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 8:21" />Tennexxee Iyyoraami ookkone sarageela duuchcha bukki asseexxi Tsa'iiri'a duule. Eedoomika loliinka sannachchanna buqe; hashshunte isinna ookkone sarageeluwwik ajajaluwwi ooko'ni baqante fulla'neege'ni, loliink manni ifi ifike minibaa baanje.<verse eid="2KI 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 8:22" />Eedoominna techchi qico'ni Yihudake'n fuggoxxinni ke'eeshshanni hedheen; Libinak qachchinna ookkone wodda fuggoxxinni ke'emmani.<verse eid="2KI 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 8:23" />Iyyoraami moyemmake baro'ni hujendeexxi wele yaane duuchchi Yihudake jiritetike moyanjuwwiinke maxaafa'ni borreessende hexxexxeebaata?<verse eid="2KI 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 8:24" />Iyyoraami edike ifike annuwwishanni reye: Daawwitike qachchi giddo hedheeke moyanjuwiinke hirreessa'ni moonge: isixxe bakka'ni isingi belti Akaaziyaasi moye.<verse eid="2KI 8:24" /></para>
  <para style="s1">Yihudaka Moyanjo Akaaziyaasi'i</para>
  <para style="r">(<ref loc="2CH 22:1-6">2 Odo. 22:1-6</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 8:25" />Isira'eeliki moyanji Aki'aabik belti Iyyoraami moyexxe tommenna lame wogga'ni, Iyyoraamiki belti Akaaziyaasi Yihudake'ni moye.<verse eid="2KI 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 8:26" />Akaaziyaasi moyee wodda lame tommena lame woggammani: Iyyerusaalemi ofo'leexxi mitte wogga galche: ama isixxanna Ataaliyate hinaani; isenna Omiirii'i Isira'eelike moyanjike beltixxe beltomman.<verse eid="2KI 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 8:27" />Akaaziyaasi Aki'aabike mini hadinni balloke kadeemmaxxe'e Aki'abike mini hadishshanni cubbo hujeexxi Duuchchi Woddika Gootta yaadise.<verse eid="2KI 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 8:28" />Aki'abike belto Iyyuraminni welti Sooriyaka moyanja Azaheeli'i Raamoti Gele'adi lolo'a mare; Sooriyitonna Iyyoraami'i madeesite.<verse eid="2KI 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 8:29" />Tennexxe moyanji Iyyoraami Remaatike booncho'ni Azahelinni welti lolememmake lola'ni Sooriyaki manni isoo madeessemmaxxe madanaa'n fayyo'a Iyyizirali'a hige.</para>
  <para style="p" vid="2KI 8:29">Aki'aabik belti Iyyoraami mado'eemmaxxe Yihudaka moyanjo Iyyoraamiki belti Akaaziyaasi isi fooreexxa laqo'a Iyyizira'eeli'a me'e.<verse eid="2KI 8:29" /></para>
  <chapter eid="2KI 8" />
  <chapter number="9" style="c" sid="2KI 9" />
  <para style="s1">Iyyu Hariireme Isira'eeli'n Moye</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 9:1" />Wabeek Elisa'i wabeekotike orgi giddii'ni mitte ye'eexxi hiyyee qici: «Hidha atika usudhdhitettexxi, tennee zayitetixxa odolcho aaxxettexxi Raamoti Gele'adi'a me'i. <verse eid="2KI 9:1" /><verse number="2" style="v" sid="2KI 9:2" />Ookko geltettetto wodda Nimishika akka'o Iyyoosafiixika belto Iyyuu'u hasi. Isiba'anna shiqqettexxi jaaluwwa isikenaa'ni qofinni fulchitettelchi uduma; mini'a e'yishi. <verse eid="2KI 9:2" /><verse number="3" style="v" sid="2KI 9:3" />Ookkoneechchi uduma odolcho aaxxettexxi zayite umo isike'ni hana dunidetteexxi, ‹Duuchchi Woddik Gootti hiyya'nee qici, Kunniseteni, ani Isira'eeli'ni mootattoshsha hariireenneni› hite lassi. Ookkoneechchi uduma hula bandettexxxi dandeettette qico'ni ookkone boonchonaa'ni kexxe baqati!»<verse eid="2KI 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 9:4" />Tennexxe iikki dargaggeessi wabeek Raamoti Gele'adiba me'e.<verse eid="2KI 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 9:5" />Ookko'o mare geyeeshshan loliinke maniki ajajalluwwi mitteba ofoleemmani; isinna «Loliinke mannike ajajallo; ani atiba ergeme dageenneni» hiyye.</para>
  <para style="p" vid="2KI 9:5">Iyyunna, «No'o giddi'ni ayye'nite haasoottaatteki?» hiyye qore.</para>
  <para style="p" vid="2KI 9:5">Wabeekichchinna, «Lolilnke mannike ajajallo Ati'aateni haaso'aanneki» hiyye hiisse.<verse eid="2KI 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 9:6" />Iyyunna ke'eexxi mini'a e'ye; ookkoneechchi uduma iikki wabeek zayite Iyyu hana duneexxinna hiyyee qici: «Isra'eliki Duuchchi Woddik Gootti Mageni hiyya'nee qici, ‹Duuchchi Woddike Goottike Isira'eelike arda'ni moototta'a atee harireenneni.<note caller="-" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="1KI 19:16">1 Moy. 19:16</ref>. </char></note> <verse eid="2KI 9:6" /><verse number="7" style="v" sid="2KI 9:7" />Erganjuwwa anxe wabeekoxxa munde itani Duuchchi Woddike Goottike eriganjuwwixxa munde duuchchaxxe'e Elizaabeeli'n halo fulannoshsha ati gootti atikika Aki'aabika mine bakka balleessitattoni. <verse eid="2KI 9:7" /><verse number="8" style="v" sid="2KI 9:8" />Aki'aabik mini duuchchi kutti hiyyaan; garbakenna kadi mine ilemeeki Isira'eeli giddo hedheeka maa'na ilemaaki labbaki belti duuchchi Aki'abinaa'ni shiyee birannoni. <verse eid="2KI 9:8" /><verse number="9" style="v" sid="2KI 9:9" />Yooni Aki'aabika mine; Naabaaxike beltishsha Iyyorbi'aamike minishshanna Akiyake belto Ba'ishake minishsha assannoni. <verse eid="2KI 9:9" /><verse number="10" style="v" sid="2KI 9:10" />Elizaabeeli kinni Iyyizira'eelike fichchi giddo worishshi isee itaani; isee moogaakinna hedhebaani› » ookkoneechchi uduma tennee kuleexxi hula bane gonga'ni me'e.<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="1KI 21:23">1 Moy. 21:23</ref>. </char></note><verse eid="2KI 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 9:11" />Iyyuna fuleexxi loliinke mannike ajajalluwwa kandeeke jaaluwwiba geyeshshaani; insa'ne giddi'ni mitti, «Duuchchini geechi nage'ange? Maraattichchi kunni atibaa dage'echchi mayeete?» hiyye qore.</para>
  <para style="p" vid="2KI 9:11">Iyyunna «Manjichchokeenna kadi isi haaso'aaxxa ha'nonni egendine'eni» hiyye hiisse.<verse eid="2KI 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 9:12" />Insa'nenna «Tinni dhugaatebaani; ati no'aa kuli» hine hiissine.</para>
  <para style="p" vid="2KI 9:12">Iyyunna hiyyee qici, Isi ane'ni hiyye kuleechchi, « ‹Duuchchi Woddik Goottinna Isira'eelike moyanjo kaddotta'a ate'e hariireenneni› anee hiyyeen» hiyye insa'ne'a hiisse.<verse eid="2KI 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 9:13" />Insa'ne duuchchiingi ranke seemma fulche'na'ni Iyyu qabatammake hadhisanjon hana fanne; ookkoneechchi uduma malagata ufuunfee, «Iyyu moyeeni» hine.<verse eid="2KI 9:13" /></para>
  <para style="s1">Iyyu Iyyoraaminna Akaziyaasi'i Shiye</para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 9:14" />Tennexxe Nimishik betik belti, Iyyoosafiixik belti Iyyu Iyyoraami'ni fugoxxinni ke'e. Ettene yanna'ni Iyyoraaminna Isira'eeli duuchchi Raamoti Gele'adi'i Sooriyake moyanji Azaheeli lole midhabaashsha heqina'nemmaani.<verse eid="2KI 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 9:15" />Moyanji Iyyoraami kinni Sooriyaka moyanjo Azaheelinni lolemee wodda, Sooriyito madeessitemmaxxe mada fayyiriso'a Iyyizira'eeli'a higeemmani. Iyyunna, «Yoona yaadi ha'nooki iitatte kadoole; tennee yaane Iyyizira'eli maree haaso'abaashsha; ayyi manjinna konne qachchanaa'ni luuxxe fulabaashsha heqqee» hiyye.<verse eid="2KI 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 9:16" />Ookkoneechchi uduma Iyyu fadhadiinxe gaare'ni ofo'leexxi Iyyizira'eeli'a me'e: tennee assechchi Iyyoraami ookko diiphemmaxxe Yihudinki moyanji Akaaziyaasinna mada fayyitemmabaan: Yihudak moyanji Akaziyasinna isoo laqo'a adaade dagee.<verse eid="2KI 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 9:17" />Iyyizira'eelike kinjiinke dalla'ixxe xellepho'ni uurremmaki heqqanji Iyyuk loliinki manni shiqe dageexxa uudeexxi; «loliinki manni dagaa'na'a uudaannen!» hiyye cance kule.</para>
  <para style="p" vid="2KI 9:17">Iyyoraaminna hiyyee qici, «Mitte fadhachcho gulufeeka manjo erigitetexxi ookkone daga'neeka manna ‹Daggine'eki nage'angeete?› hiyye qorowwaali» hiyye ajaje.<verse eid="2KI 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 9:18" />Erganjikinna Iyyunni afemo'a fadhachcho gulufe mareexxinna; «Moyanji, ‹Daggine'echchi nage'angeetee?› hiyya'neeni» hiyye.</para>
  <para style="p" vid="2KI 9:18">Iyyunna, «Nage'inxe rakkattattoki atetebaani! Isee waalde uduma saxxettexxi anee hordofi» hiyye. Heqqammakinna, «Erganjikinna insa'ne bira geye'eni yaane kinni hige dagebaani» hiyye ege'nishe.<verse eid="2KI 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 9:19" />Tennexxe moyanji Wele fadhachcho gulufeeka erge; ookkone manniba geyyeshaan «Moyanji, ‹Daggine'echi nage'angeetee?› hiyya'neeni» hiyye.</para>
  <para style="p" vid="2KI 9:19">Iyyunna, «Nage'iinxee rakkattattoki atetebaani! Isee waalde uduma saxxe anee hordofi» hiyye.<verse eid="2KI 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 9:20" />Heqqanjikinna, «Erganji insa'neeba geye'eni; yaane kinni kunninna hige dagebaani; loliinka manna ajajaammakixxa gaare oofa'neeki Nimishik belti Iyyu oofammashshateni; oofa'neekinna maraatinsha oofa'neeni» hiyye ege'nshe.<verse eid="2KI 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 9:21" />Iyyoraaminna, «Fadhadiinxa gaare ani'aa qophpheessi» hiyye ajaje. Fadhadiinxa garenna isi'a qophpheessinshaani; Isira'eeliki moyanji Iyyoraaminna Yihudak moyanji Akaaziyaasi ifi ifinxa gaare gulunfeexxi Iyyunni afemo'a me'ine; Iyyizira'eelichcho Naabuteke geego kademmake fichcha'n welti afemme.<verse eid="2KI 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 9:22" />Iyyoraaminna Iyyunni afeeshshaani, «Koo Iyyu mayee elonxee daggete?» hiyye qore.</para>
  <para style="p" vid="2KI 9:22">Iyyunna, «Amaa atixxi Elizaabeeli iyyedaageexxe gogonna magenoonfachchati fakke giddo karseme he'nee'na mayiinke nage'a hedhee?» hiyye hiisse.<verse eid="2KI 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 9:23" />Iyyoraaminna fadhadiinxa gaare wirri assedheexxi baqata'ni, «Koo, Akaaziyaasi, tinni jalloten!» hiyye.<verse eid="2KI 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 9:24" />Ookko'ni Iyyu gabe udumi'a harkisedheexxi wocci asseexxi Iyyoraamii'i ceeko lamiinxixxa oddo ote; mogidikinna giddi'a e'ye onna otemmaxxe'e gaareti giddo wabbi hiyye ibe.<verse eid="2KI 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 9:25" />Iyyunna gaaretika akeekisanjo Bidiqaarii'i hiyyee qici, «Rensha aaxxettexxi Iyyizira'eelichcho Naabuteke hiddichchuwwiinke fichcha'ni huni; aninna ati mowanjo Iyyoraamike anna kade'eemake Aki'aab udumii'n ifi ifike sarageeluwwa'ni gulunfennexxi isoo hordonfe me'innanno wodda, Duuchchi Woddik Gootti isixxee konne wabeekumma haaso'eexxa kassi hiyyi. <verse eid="2KI 9:25" /><verse number="26" style="v" sid="2KI 9:26" />‹Bereqe Naabutexxanna isixxe oosexxa munde uudenneni: hiyya'neeni Duuchchi Woddik Gootti tenneenna ani ate konne fichchi giddo xixannoxxa kakatenne› hiyya'ni, Duuchchi Woddiki Gootti ta'anna Duuchchi Woddik Gootti hiyyemmashshaani aaxxettexxi konne fichchi giddo huni.»<note caller="-" style="x"><char style="xo" closed="false">9:26 </char><char style="xt" closed="false"><ref loc="1KI 21:19">1 Moy. 21:19</ref>. </char></note><verse eid="2KI 9:26" /></para>
  <para style="s1">Yihudak Moyanji Akaaz Shiyemeexxa</para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 9:27" />Yihudaki Moyanji Akaaziyaasi kaddeexxa yaane duuchcha uudeexxi sarageel gulufeexxi Beeti Hagak qachchibaa baqate; Iyyunna duuka isixxa hordofee mareexxi, «Isoo shiwwee!» hiyye loliinke manni'a ajaja uwwe; loliink manninna Akaaziyaasii hordonfeexxi Beeti Hagaan qachchi bira hedhdheeke Guurike ho'lichchike wirfama'ni sarageelik qalchaa'naa ganne madeesine. Isinna isso ga'medhdheexxi Megidoke qachchi qico'ni me'eexxi ookko'o reye.<verse eid="2KI 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 9:28" />Erganjuwwi isikinna rensha fadhadiinxe gaare giddo uggineexxi Iyyerusaalemi'a aa'ne me'ineexxi Daawwitike qachchi giddo hedheeke moyanjuwwa moongammake hirreessa'ni moonge.<verse eid="2KI 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 9:29" />Akaaziyaasi Yihudake'ni moyeeki Aki'aabik belti Iyyoraami moyeexxe tommenna mittixxe woga'nitemmani.<verse eid="2KI 9:29" /></para>
  <para style="s1">Elzabeelixxa Reyo</para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 9:30" />Ookkoneechchi uduma Iyyu Iyyizira'eeli'a me'e; Elizaabeelinna tennee kaddeexxa yaane laqeexxi illete'ni seesa buudhdhiteexxi; umokanna seesse ga'nite masikootetenaa'ni gadhi'a uuda'nemmani.<verse eid="2KI 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 9:31" />Iyyunna dalla'iinxa hula e'yee wodda, «Gootta atika shiltetteki koo Zimmiri daggeetteki nage'angeette?» hite qorte.<verse eid="2KI 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 9:32" />Iyyu iimi'a qokki hiyye masokootetibaa uudeexxi, «Ayyete ati? Ayyete anee gargaaraaki hiyya'ni raare» lami yookaan sase kolaasemeek manni iimi'ni butti'a iso'o uunde. <verse eid="2KI 9:32" /><verse number="33" style="v" sid="2KI 9:33" />Iyyunna, «Elizabeli'i ise'e butti'a darbe!» insa'ne hiyye. Insa'nenna butti'a darbine. Fadhadi isee hiribeessee wodda, munde isexxinna dala'ake'ninna fadhadoke'ni fixende.<verse eid="2KI 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 9:34" />Iyyu Mootummatike mine'ni e'ye ite ha'we. Okkonneechchi uduma «Fedheexxenna kaddoole Ise moyanjiinxe belto kaddemmaxxe; tenne badinendeexxa manjicho eloqicinni moogge» hiyye.<verse eid="2KI 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 9:35" />Mooggoke'e fullee wodda kinni iseka umiinka qoonjo, anganna leka malee welelichcho anfebaani.<verse eid="2KI 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 9:36" />Tenne duuchcha hingeexxi Iyyu'ni haasoonne wodda, Iyyu hiyyee qici, «Duuchchi Woddik Gootti erganjo Teesibichcho Eliyaasi'ni Iyyizira'eelike boga'ni hiddichchuwwiinke fichchi giddo Elizaabeelika maala worshi itaani.<note caller="-" style="x"><char style="xo" closed="false">9:36 </char><char style="xt" closed="false"><ref loc="1KI 21:23">1 Moy. 21:23</ref>. </char></note> <verse eid="2KI 9:36" /><verse number="37" style="v" sid="2KI 9:37" />Maala isekanna Iyyizira'eelike boga'ni hiddichuwwiinke fichchi giddo koriinshsha kadaammaxxe ayyi manjinna ‹Tinni Elzaabeeliteni› hiyya dande'abaani hiyememmaki hiyyichchi konneteni.»<verse eid="2KI 9:37" /></para>
  <chapter eid="2KI 9" />
  <chapter number="10" style="c" sid="2KI 10" />
  <para style="s1">Aki'abiki Mini hadi Shiyeme</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 10:1" />Ettene yanna'ni Aki'aab Samariya giddo Torbaane tomme labbaxxa oose afeemmani; tennexxe Iyyu borro borreesseexxi Iyyizira'eelike ja'labuwwi'a, geedheteenna Aki'aabixxa oose nossammake duuchchi'a Semaariya'a erge; borrotinna hitaamma qici, <verse eid="2KI 10:1" /><verse number="2" style="v" sid="2KI 10:2" />«Ha'nooke goottixxi oose ha'noonni welti hexxemmaxxe; fadhaduwwanna gaaruwwa; kinjiinke dala'i giddo hedheeka qachchuwwanna bagediinka miyuwwa affinemmaxxe; tinni borro ha'no'ni gelteeshshanni ikki woddi, <verse eid="2KI 10:2" /><verse number="3" style="v" sid="2KI 10:3" />gootti ha'nookixxe oose giddii'ni sa'aakanna hasisaani hitinaaka mitte fildineexxi anxe moote'ni ofo'lishshe. Ookkoneechchi uduma ha'nooke goottike mini hadixxe'e lolle!» hitaaxxemman.<verse eid="2KI 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 10:4" />Insa'ne kinni yo'oshsha sodanteemmaxxe «Lami moyanji isoo injifatebaaka manjo no'oo hitta iso injifata dandeennanno?» hine.<verse eid="2KI 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 10:5" />Tennexxe mootummatike miniki ajajali, qachcha galchaammaki, geedhetinna, oose nossitammaxxiri, «No'o atike erganjuwwaani; ajaja atika duuchcha munxannoni; no'oo ayyinna moyaashsha assinabe'noni atee gammachchiissaaxxa duuchcha atinni assi» hina'ni tennee erga Iyyu'aa ergine.<verse eid="2KI 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 10:6" />Ookkoneechchi uduma Iyyunna «Ha'noo gamo anxe kaddineexxi ani'a ajajendina'noole gootti ha'nookixxe ooseka gooba woxxine soodo tenne yanaa'ni ani'a aaxxineexxi Izira'eeli'a iyyedaginaashsha» hiyye borro insa'ne'a higgeeni borreesse. Ettene yanna torbaane tomme moyanjiinxi oose qachchi giddo ege'nemeeke nossaamake manniba hexxemmani.<verse eid="2KI 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 10:7" />Iyyuxxi borro anga insa'neexxe'ni gelteeshshan; manni torbaane tomme moyanjiinxa oose duuchchiinxa aadheexxi shiye. Umo insa'neekanna agalladete'ni uggineexxi Iyyubaa Iyyizira'eeli'a ergine.<verse eid="2KI 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 10:8" />Erganjikinna mare geyeeshshani; Iyyu'aa «Moyanjiinxe ooseka gooba wonxe aa'ne dange'eni» hiyye kule. Ookkoneechchi uduma iyyu, «Qachchi giddi'a e'yinammaxxe hula'ni lame bakka'ni tuuldineexxi soodo gorsi qico'ni ookkooni tursee» hiyye ajaje.<verse eid="2KI 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 10:9" />Langa baro gorsa Iyyu gadhi'a fuleexxi ardi duuchchi edo uurreexxi hiyyee qici: «Ha'no quliyyeteni; gootta anke'ni fuggoxxini ke'ennexxi shiyenneki anteni. Yaane kinni konne duuchchinga shiye bireeki ayyete? <verse eid="2KI 10:9" /><verse number="10" style="v" sid="2KI 10:10" />Yooni Duuchchi Woddiki Gootti Aki'aabike mini hadixxee hiyyeki hiyyichchi mittikinna midde butta ibe gatabaaxxa ege'ne. Duuchchi Woddik Gootti Erganjo ifike'ni Eliyaasi'ni hiyyemaxxa muuxxe'eni.»<verse eid="2KI 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 10:11" />Tennexxe Iyyu Aki'aabike minenaa'ni gatemmaka duuchcha lumollamma mannanna shiqika jaaluwwa isikanna qeese mittetiinna gatebaangi Iyyizira'eeli giddo shiye. Akaaziyaasik firuwwi shiyyeme.<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="HOS 1:4">Hos. 1:4</ref>. </char></note><verse eid="2KI 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 10:12" />Ookkoneechchi uduma Iyyu ke'exxi Semaariya'a me'e; Bete Ekedi hiyyemaaba'a gedhebo allaldammaxxe alalisanoke miniba geyee wodda; <verse eid="2KI 10:12" /><verse number="13" style="v" sid="2KI 10:13" />Yihudaka moyanjo Akaaziyaasi'a aantete kadeeka firuwwa shiixxoka manna alfeexxi ha'no ayye manna? Hiyye qore.</para>
  <para style="p" vid="2KI 10:13">Insa'nenna, «No'oo Akaaziyaasike shiqike firani: moyanjiinka mini hadonna mootittetixxa oose nage'a aa'nonna'a kaba adadde dirrine dangeenneni» hine.<verse eid="2KI 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 10:14" />Iyyunna «Konnee manna lubbondinni he'nee'naa abidde!» hiyye ajaje. Tennexxe lubbondini he'ne'naa'a adhdhine me'ineexxi Beeti'eekedi baleti qarqara shoole tommenna lame manna shiye bire; mittekanna midde gatisebaani.<verse eid="2KI 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 10:15" />Isinna ookko'ni ke'e me'aa'naa Rekaabik belti Iyyonaadaabi isibaa dagaa'na orake'ni afe. Iyyunna nage'a aadheexxi, «Godobi anki ate addata'neeshshani atiki godobinna ittani anee addata'ne?» hiyye qore.</para>
  <para style="p" vid="2KI 10:15">Iyyonadabinna, «eeti ittanden» hiyye hiisse.</para>
  <para style="p" vid="2KI 10:15">Iyyunna yooni, «Anga hinni» hiyye. Angatanna uwwe. Ookkoneechchi uduma Iyyu kipheexxi gaareti hana sa'isse. <verse eid="2KI 10:15" /><verse number="16" style="v" sid="2KI 10:16" />Iyyunna hiyyee qici: «Amo aninni welti me'inee'naa Duuchchi Woddike Gootti'a hinaafaanne qico uudi» hiyye. Ookkoneechchi uduma gaareti isoo adhdhe me'e.<verse eid="2KI 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 10:17" />Iyyu Semaariya mare geyeeshshani Aki'aabike firanaa'ni gatemmaka duuchcha shiye. Tinninna kaddeechchi Duuchchi Woddik Gootti wabeeka Eliyaasi'n hiyyemmake hiyyichchishani kutti asse. Ba'ali Hinaake Magenuwwi'a Ergatammakiiri Shiyeme.<verse eid="2KI 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 10:18" />Ookkoneechchi uduma Iyyu Samaryaka arda mitteba bukki asseexxi hiyyee qici; «Aki'aab Ba'aali'aa erigatemeeki shiixxo qiconi; Iyyu kinni isi irra erigatemaani. <verse eid="2KI 10:18" /><verse number="19" style="v" sid="2KI 10:19" />Ta'a Ba'aalixxa wabeeko duuchcha, ise'a ergatammakaaranna qeesole isexxa duuchcha ani'a ye'we. Ba'aali'a lumooka tolcha shiqishaannaxxe mitti manjinna midde gatabaashsha. Dagabaaki manji hedhoole kinni lubboti hedhabaani» Iyyu kinni tenne asseechchi Ba'a'lixxa ergatammakaara biro'a asseexxe xaqaromman.<verse eid="2KI 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 10:20" />Iyyunna, «Ba'aalike ulfinni'a ardi fulo'a lasse» hiyye; insa'nenna tennee ardake'ni ege'ninshe.<verse eid="2KI 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 10:21" />Ookkoneechchi uduma Iyyu Isira'eelike ardi duuchchi'a erga erge; Ba'aali'aa ergatammakir duuchchi mitti manjinna gatebaani dage; Ba'aalike galma'n kasakenaa'ni kasiini qico'ni manji wo'me.<verse eid="2KI 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 10:22" />Iyyunna seemma uggendammake minika akeekallo; «Ba'aal'aa ergatemamake manni duuchchia'a seemma idage» insinna seemma insa'ne'a idagge.<verse eid="2KI 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 10:23" />Ookkoneechchi uduma Iyyu Rekaabike belto Iyyonadabin welti Ba'aalixxe fakkeke mini giddi'a e'ye: Ba'aali'a ergatemamakaara; «Yooni Ba'aalixxe erigatameeyye male'e Duuchchi Woddike Goottik erganjuwwi kaba ha'noni hedhebaaxxa kokkine uudde» hiyye.<verse eid="2KI 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 10:24" />Ookkoneechchi uduma cinco'aaka tolchanna wele tolcha shiqinsho'a e'yine. Etennee yanna Iyyu «Anga ha'noxxe'ni sa'isse uwwenneke mannanaa'ni mittekanna midde baaje fulaashsha asseeki manji fonxoro isixxe'ni e'yaani» hiyye xexxe'achchiseexxi gadho saddeeta tomme manna qophpheeseemaani.<verse eid="2KI 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 10:25" />Iyyu tolcha shiqilshe ke'eechchi uduma heqqanjuwwakanna loliinke mannika ookkone sooresuwwa, «E'yitine insa'ne shiwwe; mitti manjinna baqate fuloqqe» hiyye ajaje. Insa'nenna wolaantichchik shinne birre; heqqanjuwwikinna loliinke manniki ja'labuwwinna rensha duuchchiinga gadhi'a fulchineexxi hunne. Ookkoneechchi uduma giddike Ba'aalike galma'n e'yine.<verse eid="2KI 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 10:26" />Magenoofantammaxxa soodduwwa Ba'aalike galmanaa'n gadhi'a fulchineexxi giirati gunbe.<verse eid="2KI 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 10:27" />Ba'aalixxa magenoonfantammaxxa soodduwwa butuchchine; Ba'aalika galmanna findinge'naa ardi telchi qico'ni foole'ake offole'aaxxe bakka assedhe.<verse eid="2KI 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 10:28" />Konne qicinni Iyyu Ba'aalixxa magenoonfachcho Isira'eelike bogana'ni balleesse.<verse eid="2KI 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 10:29" />Kado male'e Iyyu Naabaaxik belti Iyyorbi'aami Beeteli'ninna Daani'n worqetixxa jabbuwwa magenoonfantaashsha Isira'eeli dedhisemmaxxe cubbonaa'n bayyatebana.<note caller="-" style="x"><char style="xo" closed="false">10:29 </char><char style="xt" closed="false"><ref loc="1KI 12:28-30">1 Moy. 12:28-30</ref>. </char></note> <verse eid="2KI 10:29" /><verse number="30" style="v" sid="2KI 10:30" />Duuchchi Woddik Gootti Iyyu'u, «Ani edo eloxxa yaane assitettaxxenna Aki'aabike mini hado'ni assonna'a qalbe anxi giddo hasennexxa duuchcha muuxxettaxxe; sanne atixxi shoole ila qico'ni Isira'eelixxe moote'ni ofoldaani» hiyye.<verse eid="2KI 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 10:31" />Yaane kinni Iyyu Isira'eelike Duuchchi Woddike Gootta Magenike seeri'a mitte qalben heqqedhatee xexxe'achcho assebaani. Iyyorbi'aaminna, Isira'eeli dedhake'ni ibisemmaxxe'e cubbotenaa'ni bayyatebaani.<verse eid="2KI 10:31" /></para>
  <para style="s1">Iyyuxxa Reyo</para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 10:32" />Ookkone baro'ni Duuchchi Woddik Gootti Isira'eelike bogiki ba'linni cu'misa safe: Azaheelinna Isira'eeli'i bogiinke kasanaa'ni kasinin qico'n lole injifate.<verse eid="2KI 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2KI 10:33" />Isi abixxeeki bogi, Yordaanoosike galaananaa'ni boroti darree'ni, hedheeka Gele'adika boga duuchcha (Gaadika, Roobeelikanna Minaaseka boga), Arinoonike galaani alidarre hedheeke Aro'eerike qachanaa'n Gaadinna Baasaani qico'nten.<verse eid="2KI 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 10:34" />Gatemmaki Iyyu moyemake baro'ni kadeexxi, asseexxi duuchcha, hujeexxi huje duuchchi Isira'eelike moyanjuwwinke jirtetike maxaafa'ni borreesende hexxexxeebaata?<verse eid="2KI 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 10:35" />Iyyu edike isike annuwwashshaani reye; Semaariya isoo moonge. Belti isiki Iyyo'akaazi isixxi bakka'n moye.<verse eid="2KI 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 10:36" />Iyyu Semaariya ofo'lexxi Isira'eeli'ni moyyeeki lame tommenna saddeeta wogamani.<verse eid="2KI 10:36" /></para>
  <chapter eid="2KI 10" />
  <chapter number="11" style="c" sid="2KI 11" />
  <para style="s1">Gotoliyanna Iyyo'asi'i</para>
  <para style="r">(<ref loc="2CH 22:10-23:15">2 Odo. 22:10—23:15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 11:1" />Akaaziyaasixxi ama Ataaliya, ifike beltixxa reyo laqqee wodda, moyanjinka mini hado duuchcha shilchiise.<verse eid="2KI 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 11:2" />Moyanjo Iyyoraamixxi belto Akaaziyaasixxi dayyo Yoosabeeti kinni Akaaziyaasik belti Iyyo'aasi shiyemo'aa hedemeemmaxxe moyanjiinxe oose giddi'n moorte adhdhite; shinnabaashsha isoo Gotooliyanaa'n sho'neexxi isoonna isoo gargartammaxxa manjichcho mitte kuta'n shoxxe; tennexxe isinna shiyemebaan.<verse eid="2KI 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 11:3" />Gotooliya boga ookkone galchitaammaa wodda isoo gargaartammaxxini welti jaane wogga Duuchchi Woddike Goottike galma'ni sho'ome.<verse eid="2KI 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 11:4" />Torbaxxe wogga'ni Yodaahe ergeexxi Karaatitonna heqqanjuwwa ajajammaka dhibba ajajalluwwa isi hedhemmabaa Duuchchi Woddike Goottike galmiba dangaashsha asse. Insa'neninna welti kako aagiyyoti Duuchchi Woddike Goottike galmi giddo insa'ne kakachchiise; ookkoneechchi uduma moyanjiinka belto insa'ne'n leellishsheen. <verse eid="2KI 11:4" /><verse number="5" style="v" sid="2KI 11:5" />Hiyya'ni insa'ne ajajee qici, «Ha'noonna, sase gamo kaddine'e Sanbatiinxa barra heqqitinaaki giddii'ni sasekenaa'ni mitti mootummatika mine heqqowwaali; <verse eid="2KI 11:5" /><verse number="6" style="v" sid="2KI 11:6" />Weli sasekenaa'ni mitti Suurixxa hula heqqowwaali; gateeki weli sasekenaa'ni mitti higgeeni galma heqqammake heqanji uduma hexxeexxa hula heqqowwaali. <verse eid="2KI 11:6" /><verse number="7" style="v" sid="2KI 11:7" />Ha'noo baratendeemmashanni Sanbaatiinxa barra heqanjummatixxa huje affinebaaki sasekenaa'n langaxxi anga kinni moyanjoken shiyemabaashsha galma heqqe. <verse eid="2KI 11:7" /><verse number="8" style="v" sid="2KI 11:8" />Ha'noo duuchchiingi loliinka miyya abixxitine Moyanjo erqe kayyi'ni qoqqobine heqqe; ha'noo biri'aa shiqaaki hedhoole shiyemowwaali. Moyanji gadhi'a fulla woddanna mini'aa e'yaa wodda duuchcha isonaa'ni gargari higginoqqe'e.»<verse eid="2KI 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 11:9" />Dhibba loliinka manna ajajammakinna qeesichchi Yodaahe ajajeexxa duuchcha assine; insa'ne mitti mittiingi Sanbatiinxa barra heqqatixxe huje'a e'yaammakanna fulaammaka manna aa'neexxi qeesichcho Yodaheba iyyedange.<verse eid="2KI 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 11:10" />Qeesichchikinna Duuchchi Woddike Goottike mine'ni hedhemmaka moyanjo Daawwitika bagedonna wonte dhibba loliinka manna ajajammakeera'n uwwe.<verse eid="2KI 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 11:11" />Loliinki manninna mitti mittingi loliinka miya abixxeexxi; galimiinke bita'anaa'ni middi qico'ni tolchi malchi biranna galimii bira moyanjiinke qarqara'n uurine.<verse eid="2KI 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 11:12" />Yoodaahenna moyanjinka belto gadhi'a fulcheexxi kallachcha iso'ni ugge; kakotika Maxaafanna koppe iso'n uwwe; isi moyexxanna lallabe; Iyyo'aasinna hariiremeexxi moye. Ookkoneechchi uduma ardi, «Moyanji qeera baro moyowwaali» hiyya'ni cala'ni gammandeexxa hafuura gikki assinne gammashsho leellinshshe.<verse eid="2KI 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 11:13" />Mootite Gotooliyanna loliinke mannikanna ardiinka canca leqqeexxa yanna ardi hedhdhemmaba'a Duuchchi Woddike Goottike galmibaa me'ite.<verse eid="2KI 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 11:14" />Ookkoo marte gelteeshshani aadatishshanni moyanji utuphii bira uurre'naa; Ja'laabuwwikinna malagata ufuufammakiiri isi bira he'ne'na'a uude. Ookkone bogiki ardi duuchchi qeexala'ni, malagata ufuufa'nemmani. Gotooliyanna aareti seemma ifixxa darteexxi; «Tinni jallote! Tinni jalloten!» hita'ni raarte.<note caller="-" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="2KI 23:3">2 Moy. 23:3</ref>. </char></note><verse eid="2KI 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 11:15" />Qeesichchi Yodaahenna dhibba loliinka manna ajajammakaara «Middi bita'ni daleeke ardi giddi'ni isee fulche isee hordofaaka duuchcha wolaantichchiki shiwwe» hiyye ajaje. Tinni kaddeechchi qeesichchi ediseeni «Duuchchi Woddike Goottike mine'ni ise shiyema hasissabaani» hiyyeemmani.<verse eid="2KI 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 11:16" />Insa'nenna isee abixineexxi mootummatike minibaa aa'ne me'inee; Iseenna ookko fadhadiinxe e'yatixxe hulaa hinaa booncho'ni shinne.<verse eid="2KI 11:16" /></para>
  <para style="s1">Yoodahe Asseexxa Jijjiira</para>
  <para style="r">(<ref loc="2CH 23:16-21">2 Odo. 23:16-21</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 11:17" />Yodaahena, Duuchchi Woddike Goottike arda kandaashsha Duuchchi Woddike Goottixxe, moyanjiinxenna ardiinxe odoo'ni kako hexxaashsha asse; iittanni moyanjiinxenna ardiinxe oddo'ni kako hexxaashsha asse.<verse eid="2KI 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 11:18" />Ookkonne bogiki ardi duuchchi ba'ali hinammaxxa fakke magenoonfantammake minibaa mareexxi findinge; tolchchi malchuwwanna fakkuwwa duuchcha butuchchine; Ba'aali hiyyemaake magenika qeesichcho Maataaninna tolchi malchi edo shinne Ookkoneechchi uduma Yodahe Duuchchi Woddike Goottika galma heqqaaka heqqanjuwwa ugge.<verse eid="2KI 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 11:19" />Ookkoneechchi uduma dhibba loliinka manna ajajammakaara, Karaatitonna heqqanjuwwa ookkone iittanni bogike ardi duuchchinni welt duuchchiingi mitteba moyanjo Duuchchi Woddike Goottike galmaa'ni aa'neexxi heqqanjuwwiinke dalla'inxe hula darree'ni aade hedheeke mootummatike mine'ni aa'ne e'yinshe; moyanjikinna mootete'ni ofo'le.<verse eid="2KI 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 11:20" />Bogiinki ardi duuchchi gammade; Gotooliya mootummatike mini giddo wolaantichchiki shiyendemmaxxe qachchi nage'a alfe.<verse eid="2KI 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 11:21" />Iyyo'aasinna moyee wodda wogga isixxi torbaane woggammaani.<verse eid="2KI 11:21" /></para>
  <chapter eid="2KI 11" />
  <chapter number="12" style="c" sid="2KI 12" />
  <para style="s1">Iyyo'asi Galma Qammalche</para>
  <para style="r">(<ref loc="2CH 24:1-16">2 Odo. 24:1-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 12:1" />Iyyu moyeexxe torbaxxe wogga'ni Iyyo'aasi moye; Iyyerusaalemi ofo'leexxi shoole tomme wogga galche. Ama isixxi Saabiyya hiyyendaaxxi Bersaabehike qachcha'ni ilendeexxemmani.<verse eid="2KI 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 12:2" />Qeesichchi Yodaahe isoo barachchiisammake baro duuchcha'ni Iyyo'aasi Duuchchi Woddike Gootti edo eloxxa yaane asse.<verse eid="2KI 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 12:3" />Kaddo malee koobuwwat magenoonfatamma boonchuwwa balleesineemmabaani; ardi ookkone boonchuwa'ni tolchakanna hixxaana guba'ni hedhemmani.<verse eid="2KI 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 12:4" />Iyyo'aasinna qeese hiyee qici, «Duuchchi Woddike Gootti galmi'a woyyichcha tolchishsha uwwemaaka maallaqa duuchcha kunninna manji lubbo ifixxike hiri'a shiqishaakanna werreegik uwwaaka, iittanni eeyyunte ifixxini uwwaaka maallaqa duuchcha bukki asse.<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="EXO 30:11-16">Fula. 30:11-16</ref>. </char></note> <verse eid="2KI 12:4" /><verse number="5" style="v" sid="2KI 12:5" />Mitti mittingi qeesichchi maallaqa massammake manjiinxe anganaa'ni aadhowwaali; hasiseeshshani galma giddo qammalchatixxe huje'ni hosowwaali.»<verse eid="2KI 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 12:6" />Kaddo malee, Iyyo'aasi moyanjo kadeeke lame tommenna sase wogga moye qico'ni qeese giddi darree diigemeemmaka galma qammalchiteemmabaani. <verse eid="2KI 12:6" /><verse number="7" style="v" sid="2KI 12:7" />Tennexxe Iyyo'aasi qeesichcho Yodaheenna wele qeese Ye'eexxi, «Glmi giddo diigemeemmaka qammalcha gophphineeki mayeete? Hiyye qore; lebeexxinna konneechchi edi'a maallaqi galmi giddo diigemeeka qammalchate'ni hoso malee maallaqa abidaammake mannanaa'ni aaxxinoqe» hiyye. <verse eid="2KI 12:7" /><verse number="8" style="v" sid="2KI 12:8" />Qeesetinna konneechchini edi'a ardakenaa'ni maallaqa bukki assinabo'noni, galmakanna ifi'aa qammalchinabo'noni; hite weli aagge.<verse eid="2KI 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 12:9" />Ookkoneechchi uduma qeesichchi Yodaahe mitte saaxine aadheexxi tuphanjokenaa'ni qo'aa fulche. Duuchchi Woddike Goottike galmibaa e'yinanna wodda edo hedheeke tolchimalchiinke midda'n ugge. Hula heqqitammaxxi qeesenna Duuchchi Woddike Goottike minibaa iyyedangammaka maallaqa duuchcha saaxxine giddo uggita'nemmani. <verse eid="2KI 12:9" /><verse number="10" style="v" sid="2KI 12:10" />Saaxineti giddo heddi maallaqi hedheexxa uunda wodda duuchcha moyanjiinki borreessanjinna uni qeesichchi dangeexxi Duuchchi Woddike Goottike mine'ni aageeka maallaqa laakkoonne subba subba'ni worreexxi usurre ugginaammani. <verse eid="2KI 12:10" /><verse number="11" style="v" sid="2KI 12:11" />Maallaqi geeyee qico kiille egenneechchi galmiinxa huje hujiinso'a annosineeke manna'ni maallaqakanna uunaammani; tinninna Duuchchi Woddike Goottika galma ijaaraakenna kinjik ijaarammake manni'aa uunaman. <verse eid="2KI 12:11" /><verse number="12" style="v" sid="2KI 12:12" />Kino boccammakeeri'aanna, kino qunqume giissammakeeri'aa uunaakanna Duuchchi Woddike Goottika galma qamalchinaaxxa haqqeenna bonceexxa kino hirate hosaakemmani; iittanni gargar hexxeexxe hasissaaxxe yaanuwwaa duuchchi'a uuna'emman.<verse eid="2KI 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 12:13" />Galmi giddi'a aageeke maallaqanaa'ni kinni Duuchchi Woddike Goottike galm giddixxe huje'ni hossaaxxi birretike sibljixxi buuduwwa, faafasunjuuwwi, distuwa, malagatuwwinna yookaani weli worqetikenna kadi birretike sibiljiinke miyuwwixxe huje'ni hosebaani.<verse eid="2KI 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 12:14" />Iikki uuneeki maallaqi kinni galma qammalchake hujaluwwi'a callammani.<verse eid="2KI 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 12:15" />Insa'ne hujalluwwakee maalaqa uuwwashsha uuneeki manni haranga addatemeeke kadeemmaxxe maallaqi haba geye hine laqatee hansaammabaani.<note caller="-" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="2KI 22">2 Moy. 22</ref>; <ref loc="2KI 7">7</ref>. </char></note><verse eid="2KI 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 12:16" />Balleessatike tolchi'aanna cubbo biratike tolchi'a shiqaammaki iikki maallaqi qeesetike kadeemmaxxe Duuchchi Woddike Goottike galma'ni e'yaammabaani.<note caller="-" style="x"><char style="xo" closed="false">12:16 </char><char style="xt" closed="false"><ref loc="LEV 7:7">Lew. 7:7</ref>. </char></note><verse eid="2KI 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 12:17" />Eettene yanna Sooriyiki moyanji Azaheeli fuleexxi; Gaatika qachcha lole miidheexxi ifi'ni hiissedhe. Ookkoneechchi uduma Iyyerusaalemi'i lole miidho'a ke'e me'e. <verse eid="2KI 12:17" /><verse number="18" style="v" sid="2KI 12:18" />Yihudaki moyanjinna Iyyo'aasi kinni ediki annuwwi Yihudiinki moyanjuwwi, Iyyosafixxi, Iyyoraami, Akaaziyaasi, Duuchchi Woddike Gootti'a woyyonsinee gari garitti foonemmaka woyyichcha miyuwwa duuchcha, isi umi isinginnini woyyonsemaaxxa uwwuwwa ittani Duuchchi Woddike Goottike galma'ninna mootummatike mine'ni miyuwwa massinammake minuwwa'ni afendeexxa worqe duuchcha bukki asseexxi Sooriyake moyanji'a Azaheeli'a erge; Azahelinna Iyyerusaalemi geyyebaangi wirri hiyye udumi'a hige.<verse eid="2KI 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 12:19" />Iyyo'aasi moyemmake baro'ni hujeexxe wele hujuwwanna huje muuxeexxi duuchchi Yihudake moyanjuwwinke jirtetike Maxaafa'ni borreessende hexxeexxebaa?<verse eid="2KI 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 12:20" />Isik ja'labuwwinna iso'n fuggoxxini ke'e; adaadde Sillabaa me'ammake ora'n Beeti Milo isoo shinne.<verse eid="2KI 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 12:21" />Isoo shiyeeki ja'laabuwwinna Semi'aatik belti Yoozakarinna Shoomeerik belti Yihozabaaditemmani. Isinna reye; edike annuwwa isike duuchchishshani Daawwitike qachcha'ni moogeme. Ameetsiyasik beltinna isixxe bakka'ni moye.<verse eid="2KI 12:21" /></para>
  <chapter eid="2KI 12" />
  <chapter number="13" style="c" sid="2KI 13" />
  <para style="s1">Isira'eelika Moyanjo Iyyu'aakazi</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 13:1" />Yihudiinki moyanji Akaaziyaasiki belti Iyyo'aasi moyeexxe lame tommenna sase woga'ni Yihudake boga'ni; Iyyuk belti Iyyo'akaazi Semaariyake qachcha'ni Isira'eeli'ni moye; tommenna torbaane wogga moye galche.<verse eid="2KI 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 13:2" />Isinna Naabaaxik belti Iyyorbi'aami Isira'eeli'i dedhiseemmaxxa cubbo hordofati Duuchchi Woddike Gootti edo elobaaxxa huje huje: tenne fuggoxxe hujenaa'ni udumi'a higebaani. <verse eid="2KI 13:2" /><verse number="3" style="v" sid="2KI 13:3" />Tennexxe Duuchchi Woddike Goottixxi aare Isira'eelike arda'ni ha'yite; tennexxe Sooriyaka moyanjo Azaheelinna belti isiki Beenihadaadi he'nemmake baro duuchcha'ni insa'neexxe anga'ni sa'isse uwe.<verse eid="2KI 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 13:4" />Ookkoneechchi uduma Iyyo'akaazi Duuchchi Woddike Goottiba'a soodate: Duuchchi Woddik Goottinna Sooriyiki moyanji Isira'eeli'i hitta rakkiseexxa uudemmaxxe soodachcho isixxa laqe.<verse eid="2KI 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 13:5" />Tennexxe Duuchchi Woddik Gootti Isira'eelii'i anjiraaka manjo uwwe; insa'nenna Sooriyake ardike miiccamanaa'ni fulle; edi woddishshani ifi ifinge duunkaana'ni nage'iki hedha sanfee.<verse eid="2KI 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 13:6" />Kaddo malee Isira'eeli'i cubbo hujaashsha assemake Iyyorbi'aamike mini hadixxe cubbonaa'ni waalle udumi'a hingebaani; waallammaxxa baka cubbo waala gibati Ashshera hiyyemaaka meyyaxxike magenixxa fakke Semaariya giddo magenonfachchote'ni jabaante.<verse eid="2KI 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 13:7" />Iyyo'akaazike loliinke mannanaa'ni reyotenaa'ni gateeki onde tomme fadhado gulufammaki manni, tomme sarageeluwwinna tomme kuma butti'ni lolammake manna caalman. Tinninna kaddeexxi buuto Sooriyaki moyanji gateeka biremmaxxenna aldu'metike huurishsha isoo assemmaxxetemman.<verse eid="2KI 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 13:8" />Iyyo'akaazi moyemmake baro'ni hujeexxi wele yaane; aseexxinna hujee muuxxeexxi duuchchi Isira'eelike moyanjuwwiinke jiritetike Maxaafa'ni borreessende hexxeexxebaa?<verse eid="2KI 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 13:9" />Iyyo'akaazinna edike ifike annuwwihshani reye: Semaariya moogeme; belti isiki Yo'aasinna bakka isixxe'n moye.<verse eid="2KI 13:9" /></para>
  <para style="s1">Isira'eeliki Moyanji Yo'aasi</para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 13:10" />Yihudake moyanjike Iyyo'aasike baro'ni; sase tommenna torbaane wogga'ni; Iyyo'akaazi belti Yo'aasi Semaariyake qachcha'ni Isira'eeli'ni moye; tommenna jaane wogga moye galche.<verse eid="2KI 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 13:11" />Isinna Duuchchi Woddike Gootti edo elobaaxxa huje: Naabaaxik belti Iyyorbi'aami Isira'eelika arda dedhiseemmaxxe cubbo duuchchanaa'ni bayyatebaani; ittini jabaate.<verse eid="2KI 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 13:12" />Yo'aasi moyemmake baro'ni asseexxi wele yaane duuchcha iittani Yihudaka moyanjo Ameetsiyasi'i loleeke loliini welti Isira'eelike moyanjuwwinke jirtetike Maxaafa'ni borreessendeexxeba?.<verse eid="2KI 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 13:13" />Yo'aasinna edike ifike annuwwiinshanni reye; Iyyorbi'aminna isixxe bakka'ni moote isixxe'ni ofo'le. Yo'asinna Semaariya Isira'eelike moyanjuwwinke hirreessa'ni moogeme.<verse eid="2KI 13:13" /></para>
  <para style="s1">Elisa'ixxa Reyo</para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 13:14" />Ettenne yanaa'ni Elisa'inna jaba qicin ela gophe lubbote ga'na'nemmani. Isira'eeliki moyanji Yo'aasi isoo laqo'a adaadde mareexxi isi'a oodhe; «Anke annayyo! Anke annayyo! Isira'eliixxe sarageeluwwa gulufaammake manni'a!» hiyya'ni oodhe.<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="2KI 2:12">2 Moy. 2:12</ref>. </char></note><verse eid="2KI 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 13:15" />Elisa'inna moyanjo, «Mitte gabenna mogiduwwa iyyedagi» hiyye isinna iyyedage.<verse eid="2KI 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 13:16" />Isira'eelika moyanjo, «Gabe angate'ni abixxi» hiyye. Gabetanna abixxe wodda Elisa'inna anga ifixxa moyanjiinxe anga'ni hana ugge.<verse eid="2KI 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 13:17" />Higgeeni, «Boroti darrexxa maskoote bani» hiyye: moyanjikinna bane; Elisa'inna «Gabe fixi!» hiyye; isinna fixe; ookkoo'ni, «Duuchchi Woddike Goottixxa injifachchotixxa gabe! Sooriya injifatendaaxxe gabe!» hiyye. Elsa'inna higgeeni «Sooriyitotanna Afeeqike booncho'n hara kutti assite insa'ne biritattoni» hiyye.<verse eid="2KI 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 13:18" />Higgeeni, «Gabuwwa aadhi» hiyye; moyanjikinna aadhe; Elisaiinna sase yanna buttna ganeexxi uurrise.<verse eid="2KI 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 13:19" />Duuchchi Woddike Goottiki manji iso'n aareexxinna «Buttinna onde yookaani jaane yanna gana hassisammani; iitta assitettelcho kadeele Sooriyito injifate hara kutti assite insa'ne birtatani; ta'a kinni injifattattoki sase yanna callani» hiyye.<verse eid="2KI 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 13:20" />Elisa'inna reye'na: moongeni. Eettene yanna Mo'aabinaa'n daga'n lole miidhaaki manni wogga woga'nini Isira'eelike boga'ni e'yina'nemmani.<verse eid="2KI 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 13:21" />Mitte yanna Isira'eeliki manni mitti manji reye'naa mooggoke'ni he'ne'naa'a mitti lole miidhammake mannixxa gamo dedhange'ni anfe; tennexxe reyemmake manjika rensha Elsa'ike mooggi giddo hunne; renshikinna Elsay'ixxa miqe tuqeeshshani iikki woddi manjichchi fayyeexxi lekkati uurre.<verse eid="2KI 13:21" /></para>
  <para style="s1">Isira'eelixxenna Soriyaxxe Oddo'ni kadeeka lola</para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 13:22" />Iyyo'akaazi moyemmake baro duuchcha'ni Sooriyaki moyanji Azaheeli Isira'eelika arda rakkisa'neemmani.<verse eid="2KI 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 13:23" />Duuchchi Woddik Gootti kinni insa'ne'a marare yaadexxi insa'neba'anna hige; tinninna Abirihaami'a, Yissihaaqi'anna Ya'iqoobi'a aagettaxxe kakko'a hiyyeeteni; techchi qico'ni insa'ne biro'a hasebaani; albi ifiki edi'ninna insa'ne fugussebaani.<verse eid="2KI 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 13:24" />Sooriyaki moyanji Azaheeli reye; belti isiki Beenihadaadinna bakka isixxe'ni moye.<verse eid="2KI 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 13:25" />Ookkoneechchi uduma Iyyo'akaazik belti Yo'aasi; Azaheelik belt Beenihadaadi anna iske Iyyo'akazinaa'n lole adhdhemmaka qachchuwwa hiisse abixxe; Yo'aasi sase yanna lole'e injifate; Isira'eelika qachchuwwa konne qicinni ifitti hiissedhe abixxe.<verse eid="2KI 13:25" /></para>
  <chapter eid="2KI 13" />
  <chapter number="14" style="c" sid="2KI 14" />
  <para style="s1">Yihudaka Moyanjo Ameesiyaasi'i</para>
  <para style="r">(<ref loc="2CH 25:1-24">2 Odo. 25:1-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 14:1" />Isira'eelika moyanjo Iyyo'akaziki belti Yo'aasi Isira'eeli'n moye galcheexxe langaxxe wogga'ni; Yihudaki moyanji Iyyo'aasik belti Amesiyaasi moye galche. <verse eid="2KI 14:1" /><verse number="2" style="v" sid="2KI 14:2" />Isi Moyee wodda wogga isixxinna lame tommenna ondetemmani; Iyyerusaalemi ofo'leexxi lame tommenna sallaane wogga moye galche; ama isixxinna Yiho'adiini hiyyendaaxxe Iyyerusaalemi ilendeexxemmani.<verse eid="2KI 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 14:3" />Amasiyasi Duuchchi Woddike Gootti edo gammachchiissaaxxa yaane asseeni; yaane kinni anni isiki Daawwiti assemmashatebaani; duuchchiinxe yaaneni anna ifikika Iyyo'aasika fakkeenna hordofe.<verse eid="2KI 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 14:4" />Koobuwwate'ni hedheeka magenoonfantammalchuwwa diigebaani; ardikinna koobuwwate'ni tolcha shiqishanna hixxaana guba waaleemmabaani.<verse eid="2KI 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 14:5" />Amesiyaasi mootumma jabeesse abixxeechchi uduma; moyanjo anna isika shiyemmaka Ja'laabuwwa shiye.<verse eid="2KI 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 14:6" />Kaddo malee Muuseke seerike maxaafa'ni Duuchchi Woddik Gootti «Mitti mittingi manji hujemmaxxe ifixxe cubbo'a shiyemo malee annuwwi oose ifixxixxe, oosuwwatinna annuwwi ifikixxe cubbo'a shiyendoqqe» hiyye ajajemmaxxe shiyemaake mannixxa oose shiyebaani.<note caller="-" style="x"><char style="xo" closed="false">14:6 </char><char style="xt" closed="false"><ref loc="DEU 24:16">Lan. 24:16</ref>. </char></note><verse eid="2KI 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 14:7" />Isinna, maxinetixxe dhooqa hiyyemaake booncho'ni tomme kuma Eedoomika loliinka manna bire; Sela'iika qachcha lole injifate abixxemmaxxe techchi qico'ni Yoqixi'eeli hiyyemaaka summa fulcheeki Ameesiyaasiteni.<verse eid="2KI 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 14:8" />Ookkoneechchi uduma Ameetsiyasi, Iyyuk belti Iyyo'akaazi ileeke Yo'aasii'i Isira'eelike moyanjibaa, «Amo weli uundo» hiyyeexxi erga erge.<verse eid="2KI 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 14:9" />Isira'eeliki moyanji Yo'aasi kinni Yihudaka moyanjo Amesiyaasi'a hiyye erga ergee qici, «Mitte Libaanoosixxi qu'muudo; ‹belto atixxa belti anki aardho'a uwwi› hite'e Libaanoosike biribirsibaa erga ergite. Ookkoonneechchi uduma mitti Libaanoosiki biniinchi dageexxi qu'muudo lekkati hirbeesse. <verse eid="2KI 14:9" /><verse number="10" style="v" sid="2KI 14:10" />Dhugaaten ati Eedoomii'i loldee injifatteetteni; qalbe atixxinna hollati wo'miteeni; tenne injifachchoxxeenna gammada'ni sammi hitee mine atike'ni ofoldeettele woyani; ifi'ninna arda atike'ni rakko geessissaxxa yaane ke'issatee mayee hasaate?» hiyye.<verse eid="2KI 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 14:11" />Amesiyaasi kinni laqebaani; tennexxee Isira'eeliki moyanji Yo'aasi fule; isinna Yihudak moyanji Amesiyaasinna Yihudiinke boga'ni Beetishemeshi edi darre lola inbe.<verse eid="2KI 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 14:12" />Isira'eeli, Yihuda injifate: mitti mitti insa'neengi ifi ifinxe duunkaanebaa baanje.<verse eid="2KI 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 14:13" />Isira'eelik moyanji Yo'aasi Akaaziyaasike beltika belto, Iyyo'aasika belto Yihudaka moyanjo Amesiyaasii'i Beetishemeshike booncho'ni lubbondinni booji'e. Ookkoneechchi uduma Yo'aasi Iyyerusaalemi'a me'e; Efireemike Dalla'ixxe hulabaa'ni ke'isse shoole Kasike Dalla'ixxe hula hiyyemeeke boonchi qico'ni qeerrini shoole dhibba ciqile kadeeka dalla'a diige.<verse eid="2KI 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 14:14" />Duuchchi Woddike Goottika galmanna Mootummatika miya massinaake minuwwa'ni hexxeexxa worqenna birreetika sibljo duuchcha ookkonna afemeeka miya duuchcha abidise booji'ememmaka mannanna aadheexxi Semaariya'a hige.<verse eid="2KI 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 14:15" />Yo'aasi Moyemmake baro'ni asseexxi wele yaane, huje muuxxeexxi duuchchi, Yihudaka moyanjo Amesiyaasi'i loleeke lolini welti Isira'eelike moyanjuwwinke jirtetike Maxaafa'ni borreessende afendaaxxebaa?<verse eid="2KI 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 14:16" />Yo'aasi edike annuwwi isikshshani reye; Semaariya Isira'eelika moyanjuwwa moongemmake hirreessa'ni moogeme; belti isiki Iyyorbi'ami isixxe bakka'ni moye.<verse eid="2KI 14:16" /></para>
  <para style="s1">Yihudake Moyanjiinxa Ammesiyaasixxa Reyo</para>
  <para style="r">(<ref loc="2CH 25:25-28">2 Odo. 25:25-28</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 14:17" />Iyyo'aasik belti Yihudak moyanji Amesiyaasinna, Isira'eeliki moyanji Iyyo'akaazik belti Yo'aasi reyechchi uduma tommenna onde wogga ture: <verse eid="2KI 14:17" /><verse number="18" style="v" sid="2KI 14:18" />Amesiyaasi moyemmake baro'ni asseexxi wele yaane Yihudake moyanjuwike jiritetike Maxaafa'ni borreessende hexxeexxeebaa?<verse eid="2KI 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 14:19" />Amesiyaasi'i Iyyerusaalemi giddo shiyate'e hansemmaxxe: baqateexxi Lakkishiike qachchibaa me'e; insa'ne kinni iso'o hordofaaka manna ookko'a eriginee'na'a ookko'o isoo shinne.<verse eid="2KI 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 14:20" />Renshakanna fadhachchoke'ni feene aa'ne dangeexxi; Daawwitike qachcha'ni edike annuuwike hirreesaa'ni Iyyerusaalemi moonge.<verse eid="2KI 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 14:21" />Ookkoneechchi uduma Yihudak ardi duuchchi tommenna jaane woggaka Azariyaasii'i<note caller="+" style="f"><char style="fr" closed="false">14:21 </char><char style="ft" closed="false">yookaan Oziya hiyyemaan</char></note> aadheexxi anna isike Amesiyaasixxe baka'n moyashsha assine.<verse eid="2KI 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 14:22" />Azarya edike annuwwi isikishshanni reyeechchi uduma Ealaatii'i higgeenni qammalcheexxi Yihudabaa hiisseki konne Azaariyaasini.<verse eid="2KI 14:22" /></para>
  <para style="s1">Isira'eelika Moyanjo Langaka Iyyorbi'aami'i</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 14:23" />Iyyo'aasik belti Amesiyaasi Yihudake'ni moyeexxe tommenna ondixxe wogga'ni, Isira'eeliki moyanjo Yo'aasik belti Iyyorbi'ami Semaariya moye; shoole tommenna mitte wogga moye galche.<verse eid="2KI 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 14:24" />Duuchchi Woddike Gootti edo elobaaxxa yaane huje; Naabaaxik belti Iyyorbi'aami Isira'eeli dedhisemmaxxe cubbonaa'ni waale udumi'a higebaani.<verse eid="2KI 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 14:25" />Isira'eeliki Duuchchi Woddik Gootti Mageni Gaatiheferi giddo wabeek Amitaki belti raagichchi Yoonaasi daree'ni haaso'emmashshani; Hamaatike oranaa'ni ke'isse Maxinetixxe Abbaayya qico'ni hexxemmaxxa Isira'eelixxa gabala hiisseeki Iyyorbi'amiteni.<note caller="-" style="x"><char style="xo" closed="false">14:25 </char><char style="xt" closed="false"><ref loc="JHN 1:1">Yoh. 1:1</ref>. </char></note><verse eid="2KI 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 14:26" />Garbakenna kadi ca'ichchi, Isira'eel giddo hedhaaki duuchchi hitta lumo qico rakkatammaxxa Duuchchi Woddik Gootti uude; insa'ne gargaarammakinna hedhemmabaani.<verse eid="2KI 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 14:27" />Kaddo malee Duuchchi Woddik Gootti Isira'eelika summa buttatenaa'ni balleessaaxxa haaso'egopheemmaxxee Yo'aasika belto Iyyorbi'ami daree'ni insa'nee anjire.<verse eid="2KI 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 14:28" />Iyyorbi'ami moyemmake baro'ni asseexxi wele yaane, hujeexxi duuchchinna loleeki loli ittani Yihudaxxe gabala'ni hedhemmaka Demasiqonna Hamaati'i hitta asse Isra'eli'a hiisseexxa Isira'eelike moyanjuwwinke jirtetike Maxaafa'ni borreessende hexxeexxebba?<verse eid="2KI 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 14:29" />Iyyorbi'ami edike annuwwinni Isira'eelike moyanjuwwishshani reye; belti isiki Zakkariyaasinna isixxe bakka'ni moye.<verse eid="2KI 14:29" /></para>
  <chapter eid="2KI 14" />
  <chapter number="15" style="c" sid="2KI 15" />
  <para style="s1">Yihudaka Moyajo Azaariyaasi'i</para>
  <para style="r">(<ref loc="2CH 26:1-23">2 Odo. 26:1-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 15:1" />Isira'eelik moyanji Iyyorbi'ami moyexxe lame tommenna torbaxxee wogga'ni Yihudaka moyanjo Ametsiyasik belti Azariyaasi moye.<verse eid="2KI 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 15:2" />Moye wodda wogga isixxi tommenna jaane woggammani; Iyyerusaalemii'ni ofo'leexxi onde tommenna lame wogga moye galche. Ama isixxinna Yikooliya hiyyendaaxxe Iyyerusaalemi ilendeexxe manjichchommani.<verse eid="2KI 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 15:3" />Isinna anni isiki Amesiyaasi assemmashsha Azariyaasinna Duuchchi Woddike Gootti edo eloxxa yaane asse.<verse eid="2KI 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 15:4" />Kaddo malee tullichchuwwake'ni hedhemmaka magenoonfachchotika boonchuwwa balleessebaani: ardikinna koobuwwate'ni tolcha shiqilshanna hixaana guba waaleemmabaani.<verse eid="2KI 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 15:5" />Duuchchi Woddik Goottinna moyanjo reyaaxxe barra qico'ni soomiinke dhukkubinni abidemaashsha asse: isinna gargaritti hedheeke mine'ni qofinni hedha'nemmani. Ettenne yanna mootummatika mine akeekisanjoke kadee akekaammakinna bogiinka arda galchammak moyanjinke belto isike Iyyo'ataamitemmani.<verse eid="2KI 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 15:6" />Azariyaasi moyemmake baro'ni hujendeexxi wele huje Yihudak moyanji asseexxi duuchchanna jirtetike maxaafa'ni borreessende hexxeexxebaa?<verse eid="2KI 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 15:7" />Azariyaasi edike annuwwishshanni reye; Daawwitike qachcha'ni ediki annuwwi moogememmake hirreessi bira moonge. Belti isiki Iyyo'ataaminna isixxe bakaa'ni moye.<note caller="-" style="x"><char style="xo" closed="false">15:7 </char><char style="xt" closed="false"><ref loc="ISA 6:1">Isa. 6:1</ref>. </char></note><verse eid="2KI 15:7" /></para>
  <para style="s1">Isira'eelika Moyanjo Zakkaaryaasi'i</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 15:8" />Yihudak moyaji Azariyaasi moyeexxe sase tommenna saddeeta wogga'ni Iyyorbi'amik belti Zakkariyaasi Semaariyake qachcha'ni Isira'eeli'ni moye: jaane agenjo moye galche.<verse eid="2KI 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 15:9" />Isinna anni isiki assemmaxxa duuchcha isinna Duuchchi Woddike Gootti edo fuggoxxa yaane asse; Naabaaxik belti Iyyorbi'aami Isira'eelii'i dedhisemmaxxe cubbonaa'ni udumi'a higebaani.<verse eid="2KI 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 15:10" />Iyyabiisik belti Seloomi Zakkariyaasi'ni fuggoxxinni ke'eexxi; ardi edo gane shiyeexxi isixxe bakka'ninna moye.<verse eid="2KI 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 15:11" />Zakkariyaasi moyemmake baro'ni hujeexxi wele huje Isira'eelike moyanjuwwiinke jirtetike maxaafa'ni borreessende'eni.<verse eid="2KI 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 15:12" />Konne qicin Duuchchi Woddik Gootti moyanjo Iyyu'ni, «Oose atixxi shoole ila qico'n Isira'eeli'ni mootaani» hiyyeeki hiyyichchi muuxeme.<note caller="-" style="x"><char style="xo" closed="false">15:12 </char><char style="xt" closed="false"><ref loc="2KI 10:30">2 Moy. 10:30</ref>. </char></note><verse eid="2KI 15:12" /></para>
  <para style="s1">Isira'eelika Moyanjo Seloomi</para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 15:13" />Yihudak moyanji Ooziya moyeexxe sase tommenna sallanixxe wogga'ni Iyyabiisik belti Seloomi Isira'eeli'ni moye. Semaariya ofo'leexxi mitte agenjo moye galche.<verse eid="2KI 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 15:14" />Gaadiki belti Minaheemi; Tirtsaa'n ke'exxi Semaariya mareexxi Iyyabiisika belto Seloomii'i shiye; ookkoneechchi uduma isixxe bakaa'ni moye.<verse eid="2KI 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 15:15" />Seloomi moyemmake baro'ni hujendeexxi wele hujenna fuggoxxini ke'exxi Isira'eelike moyanjuwwinke jirtetike maxaafa'ni borreessende'eni.<verse eid="2KI 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 15:16" />Eettenne yanaa'ni Minaheemi Tirtsaa'n fuleexxi Betifisanna qachchi giddo hedhaneeke manna duuchcha'ni qarqarake'ni hedheeka boga duuchcha lole kutti asse bire; tenneenna asseechchi qachchinxa huluwwa isi'a bana ginbeemmaxxeeteni; Tifisaani loleexxi siila'witeexxe melaalleka godoba duuchcha daddarre.<verse eid="2KI 15:16" /></para>
  <para style="s1">Isira'eelika Moynajo Minaaheemii</para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 15:17" />Yihudak moyanji Azariyaasi moyeexxe sase tommenna sallaanixxe wogga'ni Gaadiki belti Minaheemi Isira'eel'ni moye; Semaariya ofo'leexxi tomme wogga moye galche.<verse eid="2KI 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 15:18" />Duuchchi Woddike Gootti edo elobaaxxa yaane asse; hedhemmake baro duuchcha'ni Naabaaxik belti Iyyorbi'aami Isira'eeli'i dedhisemaxxe cubbonaa'ni udumi'a higebaani.<verse eid="2KI 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 15:19" />Ookkoneechchi uduma Asoorik moyanji Foha<note caller="+" style="f"><char style="fr" closed="false">15:19 </char><char style="ft" closed="false">Tigilaati Peleseerimi </char><char style="ft" closed="false">hiyyemaan. </char></note>, Isira'eelii'i lole; Minaheeminna gargaarissa isonaa'n alfo'anna mootumma isixxa jabeesso'a hiyye'e; sase tommenna shoole kuma kiilo birretika sibljo isi'a uwwe.<verse eid="2KI 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 15:20" />Minaheemi konne maallaqa bukki assinaashsha asseki Isira'eelinaa'nite kadda wodda, tenneenna asseechchi Asoorike moyanji'a uunaashsha mitte mitte Isira'eelixxi dureeyye onde tomme, biretika sibljo uutaashsha hunnati ajaje. Tennexxe Asooriki moyanji ookkone boga'ni turebaangi hige me'e.<verse eid="2KI 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 15:21" />Minaheemi moyemmake baro'ni hujendeexxi hujenna, wele huje muuxeexxi duuchchi Isira'eelike moyanjuwwinke jirtetike maxaafa'ni borreessende hexxeexxebaa?<verse eid="2KI 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 15:22" />Minaheeminna edike annuuwwa isikishshanni reye: belti isiki Faqisiyaasinna isixxe bakka'ni moye.<verse eid="2KI 15:22" /></para>
  <para style="s1">Isira'eeliki Moyanji Faqisiyaasi</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 15:23" />Yihudak moyanji Azariyaasi moyeexxe onde tomme wogga'ni Minaheemik belti Faqisiyaasi Semaariyake qachcha'ni Isira'eeli'ni moye; lame wogga moye.<verse eid="2KI 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 15:24" />Faqisiyaasi Duuchchi Woddike Gootti edo elobaaxxa yaane asse; Naabaaxik belti Iyyorbi'aami Isira'eelii'i dedhisemmaxxe cubbonaa'ni udumi'a higebaani.<verse eid="2KI 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 15:25" />Isika loliinka manna ajajammake ajajalluwwi giddii'ni Remaliyak belti Feequhe fuggoxxini iso'n ke'e; onde tomme Gele'adika manna adhdhe me'eexxi Semaariya mootummatike mine'ni hexxeexxe kollo giddo Faaqisiyaasii'i Arigoobininna Aariyanni welti shiyeexxi isixxe baka'ni moye.<verse eid="2KI 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 15:26" />Faqisiyaasi moyemmake baro'ni hujendeexxi, wele huje muuxeexxi duuchchi Isira'eelike moyanjuwwiinke jirtetike maxaafa'ni borreessende'eni.<verse eid="2KI 15:26" /></para>
  <para style="s1">Isira'eeliki Moyanji Faaquhe</para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 15:27" />Yihudak moyanji Azariyaasi moyeexxe onde tommenna lame wogga'ni Remaliyak belti Feequhe Semaariyake qachcha'ni; Isira'eeli'ni moye; lame tomme wogganna moye galche.<verse eid="2KI 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 15:28" />Isinna Duuchchi Woddike Gootti edo elobaaxxa yaane asse; Naabaaxik belti Iyyorbi'aami Isira'eelii'i dedhiseemmaxxe cubbonaa'ni udumi'a higebaani.<verse eid="2KI 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 15:29" />Isira'eeliki moyanji Feequhe moyemmake baro'n Asoorik moyanji Teelgelteelfeelsoori dageexxi Iyyooni, Abeeli Beeti Ma'iika, Yaanohaa, Qaadeesi'i, Hatsoorii'i, Gele'adii'i, Geliilanna, Nefitaalemike boginninni mitteba abixxe. Ardakanna booji'eexxi Asoori'a adhdhe me'e.<verse eid="2KI 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 15:30" />Ookkoneechchi uduma Elaki belti Hoose'i Remaliyake belto'n Feequhe'n fuggoxxinni ke'e isoo shiye; Ooziyak belti Iyyo'ataami moyeexxe lame tommenna onde wogga'ni Hoose'i Faaquhexxe baka'ni moye.<verse eid="2KI 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 15:31" />Feequhe moyemmake baro'ni hujeexxi, wele huje muuxeexxi duuchchinna Isira'eelike moyanjuwwiinke jirtetike maxaafa'ni borreessende hexxeexxebaa?<verse eid="2KI 15:31" /></para>
  <para style="s1">Yihudiinka Moyanjo Iyyo'attami'i</para>
  <para style="r">(<ref loc="2CH 27:1-9">2 Odo. 27:1-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 15:32" />Isira'eeliki moyanji Remaliyak belti Feequhe moyeexxe langaxxe wogga'ni Yihudaka moyanjo Ooziyak belti Iyyo'ataami moye.<verse eid="2KI 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2KI 15:33" />Isi moye woddanna wogga isixxi lame tommenna ondetemmani; Iyyerusaalemi ofo'leexxi tommenna jaane wogga moye galche; ama isixxinna Saadoqixxe belto kadda wodda Yeruusha hiyyende ye'endaani.<verse eid="2KI 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 15:34" />Isinna anni isiki Ooziya assemmaxxa duuchcha; isinna Duuchchi Woddike Gootti edo eloxxa yaane asse.<verse eid="2KI 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 15:35" />Kaddo malee tullichchuwwi hana hedheeka magenoonfantammaka boonchuwwa hoyyebaani; ardikinna ookko'o tolcha shiqisha'ninna hixaanna guba'ni hedhemmaani. Iyyo'ataami Duuchchi Woddike Goottika galma aldareexxa Hula langaxxa giisse.<verse eid="2KI 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 15:36" />Iyyo'ataami moyemmake baro'ni hujendeexxi, wele huje muuxeexxi duuchchi Yihudake moyanjuwiinke jirtetike maxaafa'ni borreessende hexxeexxebaa?<verse eid="2KI 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2KI 15:37" />Eettene yanna Duuchchi Woddik Gootti Sooriyaka moyajo Retsiininna Remaliyaka belto Feequhe Yihuda lollaashsha asse.<verse eid="2KI 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2KI 15:38" />Iyyo'ataaminna isike edike anuwwishsha reye; Daawwitike qachcha'ni hedheeke moyanjuwwa moongammake hirreessa'ni moogeme; bakka isixxe'ninna belti isiki Akaazi moye.<verse eid="2KI 15:38" /></para>
  <chapter eid="2KI 15" />
  <chapter number="16" style="c" sid="2KI 16" />
  <para style="s1">Yihudiinka Moyanjo Akaazi</para>
  <para style="r">(<ref loc="2CH 28:1-27">2 Odo. 28:1-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 16:1" />Remaliyak belti Feequhe moyeexxe tommenna torbaane wogga'ni; Yihudake moyanjik Iyyo'ataamik belti Akaazi moye.<verse eid="2KI 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 16:2" />Akaazi Moye wodda wogga isixxi lame tommemmani; Iyyerusaalemi ofo'leexxi tommenna jaane wogga moye galche. Anni isiki Daawwiti assemmaxxa eloxxa yaane Duuchchi Woddike Gotta ifike Mageni edo assebaani.<verse eid="2KI 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 16:3" />Isinna Isira'eelike moyanjuwwika elobaaka adaba hordofe; ittanni Duuchchi Woddik Gootti Isira'eelike ardi edi'ni shorreemmake gosa gosake ardixxa batte yaane hordofeexxi; belto ifinga fakkuwwate'e ciincatike tolcha asse shiqishe.<note caller="-" style="x"><char style="xo" closed="false">16:3 </char><char style="xt" closed="false"><ref loc="DEU 12:31">Lan. 12:31</ref>. </char></note> <verse eid="2KI 16:3" /><verse number="4" style="v" sid="2KI 16:4" />Iittanni tullichchuwwake'ni magenoonfatammake boonchuwwa'ni; tullichchuwwiinxe xungo'ninna shafi callike haqichchuwwi hunda duuchcha tolcha tolche hixxaanakanna gube.<verse eid="2KI 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 16:5" />Sooriyaki moyanji, Retsiininna Isira'eelika moyanjo Remaliyaka belto Feequhe lollo'anna Akazi'i bunqo'a Iyyerusaalemi'a dange; kaddo male'e Akaazi'i injifata dandeenebaani.<note caller="-" style="x"><char style="xo" closed="false">16:5 </char><char style="xt" closed="false"><ref loc="ISA 7:1">Isa. 7:1</ref>. </char></note> <verse eid="2KI 16:5" /><verse number="6" style="v" sid="2KI 16:6" />Eettenne yanna'ni Sooryaki moyanji Retsiini Yihudaka manna shoreexxi; Eelaatika qachcha sooriyake assee ifiba'a hiissedhe; ookkoneechchi uduma Eedoomito Elaati'a dageexxi techchi qico'ni ookko hexxa'neeni.<verse eid="2KI 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 16:7" />Tennenaa'ni kexxeexxa Akaazi Asoorike moyanjiba'a Teelgelteelfeelsoori, «Ani atiki erganji, atinge beltoni; daggettexxi anee lola'neeke Sooriyake moyanjona'ninna Isira'eelike moyanjixxe anganaa'ni ane'e anjiiri» hiyya'ni erga isiba'a ergedhe.<verse eid="2KI 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 16:8" />Akaazinna Duuchchi Woddike Goottike galma'ninna mootummatika miyya masse'nammake minuwi giddo afemaaka birretika sibljonna worrqe aadheexxi Asoorike moyanji'a uuno'a erge.<verse eid="2KI 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 16:9" />Asoorik moyanjinna, Akaazika qortuma Demasiqo loleexxi ifitti hiissedhe; arda isikanna booji'exxi Qiiri'a adhdhe me'exxi; Retsiinii'i shiye.<verse eid="2KI 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 16:10" />Ookkoneechchi uduma Moyanji Akaazi Asoorika moyanjo Teelgelteelfeelsoorinni afemo'a Demasiqo'a me'e. Demasiqo hedheeka tolchimalcho uudeexxi; eettene fakke'ni tolchimalcho giissate'e fakkeesse borreessexxi qeesichcho Uuriya'a erge.<verse eid="2KI 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 16:11" />Qeesichchi Uuriyanna moyanji Akaazi Demasiqoo'ni ergemmaxxe fakkeshshanni tolchi malcho giisse; moyanji Akaazi hige dagebaangi edise giisse bire.<verse eid="2KI 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 16:12" />Moyanji Demasiqo'ni hige dagee wodda; tolchi malcho uude; biri'a shiqeexxi tolcha shiqisho'a tolchi malchiinbaa alale mare.<verse eid="2KI 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 16:13" />Isinna cincatika tolchanna midhatika tolcha tolchi malchoke'ni hana shiqishe; ha'watika tolchanna dune; mittummatike tolchixxa mundenna tolchi malchoke'ni fifixe.<verse eid="2KI 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 16:14" />Haarooke tolchi malchixxenna Duuchchi Woddike Goottike galmixxe oddo'ni Duuchchi Woddike Gootti edo uurrinsemmaka sageettotika tolchi malcho bakkatenaa'ni hoyyeexxi haarooke tolchi malchibaa'ni middi darre'ni ugge.<note caller="-" style="x"><char style="xo" closed="false">16:14 </char><char style="xt" closed="false"><ref loc="EXO 27:1-2">Fula. 27:1-2</ref>; <ref loc="2CH 4:1">2 Odo. 4:1</ref>. </char></note><verse eid="2KI 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 16:15" />Ookkoneechchi uduma moyanji Akaazi Qeesichcho Uuriya'a hiyye ajajee qici, «Konne lumoke haarooke tolchi malcho'ni; gorsika ciincatika tolchanna galigalka midhatika tolcha; moyanjinxe shiqaka ciincatika tolchanna midhatika ha'watika tolcha ittaani ardi duuchchixxe shiqaka ciincatika tolcha, midhatikanna ha'watika tolcha shiqishi; ciincatike tolchi'a shiqaake horixxa munde duuchcha tolchi malchoke'ni fifixxi; sageetottiki tolchi malchi kinni ani hasannoxxa yaane qodhdhate la'oonfatannoke kadaani» hiyye.<verse eid="2KI 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 16:16" />Qeesichchi Uuriyanna moyanji Akaazi ajajemmaxxa duuchcha asse.<verse eid="2KI 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 16:17" />Moyanji Akaazinna gami gaminka saanquwa goggosheexxi aadhe; moluwwati hana hexxeexxa itti anshe'nammaxxa qoruwwa hoyye. Wodee'e cammammaka gonga ba'edhe abidemmaka tommenna lame kormooletixxa fakke sageettoti giissineexxi hana dirrise ba'lake kinjo'ni hana ofo'lishe.<note caller="-" style="x"><char style="xo" closed="false">16:17 </char><char style="xt" closed="false"><ref loc="1KI 7:23-39">1 Moy. 7:23-39</ref>; <ref loc="2CH 4:2-6">2 Odo. 4:2-6</ref>. </char></note><verse eid="2KI 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 16:18" />Asoorika moyanjo gammachchiisate'e hiyye sanbatiinxa barra moyanjiinxa moote ugginaaba gargari hedhee booncho balleesse: konneechchi edo hedhemmaki hooni moyanjinna Duuchchi Woddike Goottike galmi giddi'a e'yammaxxa gatexxa hula cufe.<verse eid="2KI 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 16:19" />Moyanji Akaazi asseexi wele yaane duuchcha Yihudake moyajuwwike jirtetike maxaafa'ni borreessende hexxeeni: <verse eid="2KI 16:19" /><verse number="20" style="v" sid="2KI 16:20" />Akaazi edike isike annuwwishsha reye Daawwitike qachchi giddo hedheeke moyanjuwwiinke hirreessa'ni moogeme: isixxe bakka'ni belti isiki Hiziqiyaasi moye.<note caller="-" style="x"><char style="xo" closed="false">16:20 </char><char style="xt" closed="false"><ref loc="ISA 14:28">Isa. 14:28</ref>. </char></note><verse eid="2KI 16:20" /></para>
  <chapter eid="2KI 16" />
  <chapter number="17" style="c" sid="2KI 17" />
  <para style="s1">Isira'eelika Moyanjo Hoose'i</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 17:1" />Yihudak moyanji Akaazi moyeexxe tommenna lame wogga'ni Elaki belti Hoose'i Semaariyake qachcha'ni Isira'eel'ni moye; sallane wogga moye galche.<verse eid="2KI 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 17:2" />Isinna Duuchchi Woddike Gootti edo elobaaxxa yaane asse; kaddo male'e cubbo isixxinna edo hedhemmaki Isira'eeliki moyanjuwwi hujeexxa cubbo gelteexxemmabaan.<verse eid="2KI 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 17:3" />Asoorik moyanji Selminasoori isoo lole'na'a injifatemeexxi isi'anna irbo uwwe.<verse eid="2KI 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 17:4" />Asooriki moyanji kinni Hoose'i iso'ni fuggoxxinni ke'eexxa ege'ne; Yaane kinni Gibtseke moyanjo Sigooribaa erga ergedheemmaxxeenna wogga woga'nini assammashshanni Asoorike moyanji'a irbo uwwa gophemmaxxeeteni; tennenaa'ni kexxeexxa Selminasoori abideexxi usuriinke mine'ni e'yishe.<verse eid="2KI 17:4" /></para>
  <para style="s1">Samariyake Qachchixxa Iba</para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 17:5" />Asoorik moyanji boga duuchcha lole abixxeexxi Semaariyaka qachcha sase wogga erqe kayyi'ni buqe.<verse eid="2KI 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 17:6" />Hoose'i moyemmake baro'ni sallanixxe wogga'ni Asooriki moyanji lole injifate Semaariya abixxe: Isira'eelika ardanna booji'eexxi Asoori'a aadhe me'e. Kunnirinna Halahi, Gozaani giddo Heboorike galaani bira ittani Meedoonike qachchuwwa'ni he'naashsha asse.<verse eid="2KI 17:6" /></para>
  <para style="s1">Isira'eeli Cubbo Hujjemmaxxe Daafe'a Booji'ende</para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 17:7" />Yooni Isira'eeli'ni tinni duuchcha geya dandeetteeki; Gibtseke boganaa'ni Feri'oonixxe galchanaa'ni Gibtseke moyanjonaa'ni insa'ne fulcheeka Duuchchi Woddika Gootta Mageno insa'neeka balleessinemmaxxeeteni; ittani wele magenuwwa magenoonfante.<verse eid="2KI 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 17:8" />Duuchchi Woddik Gootti insa'ne edi'ni fulche shorremmaka gosa gosake ardikanna Isira'eeliki moyanjuwwi bogi giddi'a e'yinshemmaxxa batte aada hordonfemmaxxeeteni.<verse eid="2KI 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 17:9" />Isira'eeli, Duuchchi Woddike Gootta'n ifike Mageno'ni seeri beloxxa yaane sho'iki assite; qaaferi xellephpho heqqinammabaa'ni ke'issine kinjiinke dalla'ike qachcha'ni hedheeke minuwwa insa'neeke duuchcha'ni hedheeke tullichchuwwi hana magenoonfachchotika boonchuwwa giisse'ne.<verse eid="2KI 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 17:10" />Mitte mitte tullichchuwwi hananna mitte mitte shafi callike haqichchi hunda sooddo magenoonfantaxxanna asheera hine ye'naaxxa meyyake magenixxa fakke uurrinse. <verse eid="2KI 17:10" /><verse number="11" style="v" sid="2KI 17:11" />Duuchchi Woddik Gootti insa'ne edi'ni fulche shorremmaki gosa gosaki ardi assemmashshani; tullichchuwwi duuchchi hana hixxaana gunbe; Duuchchi Woddika Gootta aararsitaaxxa fuggoxxa yaane assine.<verse eid="2KI 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 17:12" />Duuchchi Woddik Goottinna insa'nee «Tenne assa ha'no'a hasissabaani» hiyyoolenna midde insa'ne fakkuwwa magenoonfante.<verse eid="2KI 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 17:13" />Tinni kaddoolenna Duuchchi Woddik Goottinna «Fuggoka ora ha'nooka waaldine higge; annuwwi ha'nooki muuuxaashsha ajajenneke seera duuchcha, iittanni erganjuwwa anxe, wabeeko darree'ni ha'no'a sa'isse uwwenneke seerike ke'injishshani; ajaja ankanna aada anxa heqqedhdhe» hiyye wabeekotanna leella uudammake manna duuchcha'ni Isira'eelinna Yihuda'a xexxe'achchiiseemmani.<verse eid="2KI 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 17:14" />Kaddo male'e insa'ne kinni lanqebaani; Duuchchi Woddike Gootta ifike Mageno'ni addatemabaake edike annuwwi insa'neekishsha jalline.<verse eid="2KI 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 17:15" />Isixxa Aadanna edike annuwwi insa'neekinni welti aagemmaxxa kako, insa'ne'aa uwweexxa xexxe'achcho tuffante woyi fuldabaaxxa fakke magenoonfatati umo ifinge woyi fulabaake kande: Duuchchi Woddik Gootti «Insa'ne assinaaxxa assitinoqqe» hiyye insa'nee ajajoolenna midde qarqara insa'neeke'ni hedheeka gosa gosaka arda hordonfe; Duuchchi Woddiki Gootti assinabaashsha hoyyemmaxxanna assineeni male'e waallebaani.<verse eid="2KI 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 17:16" />Duuchchi Woddik Gootti insa'neeki Mageni insa'nee ajajeexxa duuchcha muunxebaani; worqe baqinse lame jabbetixxa fakkenna Ashera hinaaxxa meyyaxxike magenixxa sooddo giissine; urjuwwa sagande; Ba'aali'i magenoonfante.<note caller="-" style="x"><char style="xo" closed="false">17:16 </char><char style="xt" closed="false"><ref loc="1KI 12:28">1 Moy. 12:28</ref>. </char></note><verse eid="2KI 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 17:17" />Ittani labbaxxanna meyyaxxa oose ifixxa ciincatike tolchi'a shiqinshe; morraakenna gonjaake kande; Duuchchi Woddike Gootti edo elobaaxxa yaane assate'e ifi uune; aaraashshanna assine.<note caller="-" style="x"><char style="xo" closed="false">17:17 </char><char style="xt" closed="false"><ref loc="LEV 18:10">Lew. 18:10</ref>. </char></note><verse eid="2KI 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 17:18" />Tennexxe Duuchchi Woddik Gootti Insa'ne'ni yo'oshsha aare; Yihudaxxi gosa calli gatteeni; Isira'eeli'i ifi edi'ni bayyise.<verse eid="2KI 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 17:19" />Yihudake ardanna kadoole, Isira'eelinaa'ni adhdhemmaxxa aada hordofeeni male'e Duuchchi Woddike Goottika insa'neeke Mageniinka ajaja heqqedhebaani.<verse eid="2KI 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 17:20" />Tennexxe Duuchchi Woddik Gootti Isira'eelika arda duuchcha waale; insa'nenna rakkise; ifi edi'ni insa'ne fuggussaa qico'ni; booji'aake mannnixxe anga'ni sa'isse uwwe.<verse eid="2KI 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 17:21" />Duuchchi Woddik Gootti Isira'eeli'i Daawwitike minenaa'ni gargaritti hiisseechchi uduma; insa'ne Naabaaxika belto Iyyoribi'ami'i moyanjoke assine; Iyyorbi'aaminna Isira'eeli Duuchchi Woddika Gootta hordoffabaashsha dedhisati lumoxxa cubbo hujaashsha asse.<verse eid="2KI 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 17:22" />Isira'eelinna Iyyorbi'aami hujemmaxxa cubbo duuchcha hunje; eettene cubbonaa'ninna bayyata ginbe.<verse eid="2KI 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 17:23" />Duuchchi Woddik Gootti erganjuwwa ifixxe wabeeko duuchchi darree'ni xexxe'achchiisemmashshani ifi edii'n insa'nee fugussa qico'ni ookkone ora'nini me'ine; tennexxee Isira'eelik ardi boga ifikenaa'ni boojine Asoori'a adhdhine me'ine; ta'anna ookkonni he'na'neeni.<verse eid="2KI 17:23" /></para>
  <para style="s1">Asoorito Samaariya Ofolde</para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 17:24" />Asoorik moyanjuwwi arda ifike Baabilooni'n, Kutaa'n, Awaa'n, Hamaati'n, Sefariwayimike qachchuwwanaa'ni iyyedaggeexxi; Isira'eeli hexxammake booncho'ni aangaashsha Samariyake qachchuwwa'ni ofo'lishe; insa'nenna Semaariya Dhaaleexxi iseke qachchuwwa'n hedhate'n ke'ne. <verse eid="2KI 17:24" /><verse number="25" style="v" sid="2KI 17:25" />Ookkoo hedha sanfeeshaani; Duuchchi Woddika Gootta magenoonfantebaani; tennexxee Duuchchi Woddiki Gootti neenqa insa'ne'ni erge insa'ne giddi'ni heenooka shiye.<verse eid="2KI 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 17:26" />Asoorike moyanji'a «Semaariyake qachchuwwibaa iyyemartettexxi shookishshettaki ardi ookkone bogiki magen harsaaxxa ege'nebaani; tennenaa'ni kexxeexxa Duuchchi Woddiki Gootti shiyaaka neenqa insa'ne'ni erge» hitaaxxi odo iso'ni gelte.<verse eid="2KI 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 17:27" />Ookkoneechchi uduma Asoorik moyanji «Samariyaa'ni boojitine iyyedaggeneexxe qeesenaa'ni mitti; ookko'anni higee hedhaashsha hiissitine imartineexxi bogi isikiki mageni maa hasa'neexxa arda ifika barsiisowwaali» hiyye ajaje.<verse eid="2KI 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 17:28" />Tennexxe Semaariyanaa'n boojine adhdhine me'inemmaki mitti qeesichchi Beeteli'a higeexxi Duuchchi Woddika Gootta hitta insa'ne magenoonfachcho hasissaaxxa barsiise.<verse eid="2KI 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 17:29" />Iittanna kaddoole mitti mittinxi gamo ofoldemmange qachcha'ni ifi ifinga mageno giissedhdhe; ookkone'e magenonna edi wodda Samaariyak ardi tullichchake'ni hana giissemmake magenoonfantamachcho iyyemara'ni uurrise.<verse eid="2KI 17:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 17:30" />Konne qicinni Baabilooni'ni dageeki manni Sukotibenotii'i giisse, Kutaanii'n dageeki manni Neerigaalii'i giisse, Hamaati'ni dageeki manni Ashimaa'a giissine.<verse eid="2KI 17:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 17:31" />Awwito Alibaziriinna Tertaaqi hiyyemaaka magenuwwa giisse'ne wodda, Sefariwayimii'n dageeki manni Adiraameelekinna Anameleek hiyyemaake magenuwwi'a ifixxa oose ciincatike tolchi'a shiqinshe.<verse eid="2KI 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 17:32" />Kunnini manni dhugaatika Duuchchi Woddika Gootta magenoonfatammani. Kaddo male'e mitte mitte gamo dagemmake ifi ifike ardiinxa aada hordofeexxi; tullichchuwwake'ni hedheeke fakkuwwa magenoonfantammake mine'ni ergatendaaxxa qeese hariire.<verse eid="2KI 17:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2KI 17:33" />Insa'nenna mittele Duuchchi Woddika Gootta magenoonfanta'ni; welele kinni insa'ne giddi'n fulemmake wele bogike mannixxe aadashshani ifiifinga magenuwwa magenoonfanta'nemmani.<verse eid="2KI 17:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 17:34" />Tennee elobaaxxa aada telchi qico'ni waallebaani; insa'ne Duuchchi Woddika Gootta seeriki magenoonfanta'nebaani; iittanni Isira'eeli hiyye ye'emaake Ya'iqoobixxe horte'a uwwemmaxxa aadanna seeruwwa, murtenna ajajuwwa hordonfa'nebaani.<note caller="-" style="x"><char style="xo" closed="false">17:34 </char><char style="xt" closed="false"><ref loc="GEN 32:28">Dada. 32:28</ref>; <ref loc="GEN 35:10">35:10</ref>. </char></note><verse eid="2KI 17:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 17:35" />Duuchchi Woddik Gootti Isira'eelini welti kako aagee wodda, hiyye ajajemma qici, «Wele magenuwwa magenoonfatinoqqe, isi'anna kumbu hitinoqqe'e, tolchakanna isi'a tolchitinoqqe.<note caller="-" style="x"><char style="xo" closed="false">17:35 </char><char style="xt" closed="false"><ref loc="EXO 20:5">Fula. 20:5</ref>; <ref loc="LEV 5:9">Lew. 5:9</ref>. </char></note> <verse eid="2KI 17:35" /><verse number="36" style="v" sid="2KI 17:36" />Yaane kinni lumoxxe hunnanninna jabaxxe hirreni Gibtseke boganaa'ni ha'no'o fulcheeka Duuchchi Woddika Gootta calla magenoonfachcho ha'no'a hasissaani. Isi'a kumbu hiyye; isi'a tolchakanna shiqishshe.<note caller="-" style="x"><char style="xo" closed="false">17:36 </char><char style="xt" closed="false"><ref loc="LEV 6:13">Lew. 6:13</ref>. </char></note> <verse eid="2KI 17:36" /><verse number="37" style="v" sid="2KI 17:37" />Ha'no'aa borreesse uwwennexxa aadanna nmurte, seeruwwakanna ajajuwwa; duuchchi wodda jabaattine heqqedhdhe. Wele magenuwwa magenoonfattinoqqe. <verse eid="2KI 17:37" /><verse number="38" style="v" sid="2KI 17:38" />Ani ha'noni welti aagennexxa kako deetinoqqe: wele magenuwwanna magenoonfattinoqqe. <verse eid="2KI 17:38" /><verse number="39" style="v" sid="2KI 17:39" />Yaane kinni Duuchchi Woddika Gootta ha'nooka Mageno magenoonfatte; naaphi ha'nookixxe anganaa'ni ha'no anjiraaki isoteni.» <verse eid="2KI 17:39" /><verse number="40" style="v" sid="2KI 17:40" />Yaane kinni edinxe aada insa'neexxe'ni jabaanteni male'e waallebaani.<verse eid="2KI 17:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="2KI 17:41" />Kunni ardi fedheexxinninna midde mitte gamini Duuchchi Woddika Gootta magenoonfanitoolenna qunqumendeexxa fakkuwwanna magenoonfanta'nemmani. Oose insa'neexxinna akka'uwwa insa'neexxi ediki annuwwi insa'neeki assinemmaxxa telchonna assina'nini he'neeni.<verse eid="2KI 17:41" /></para>
  <chapter eid="2KI 17" />
  <chapter number="18" style="c" sid="2KI 18" />
  <para style="s1">Yihudiinka Moyanjo Hiziqiyaasi</para>
  <para style="r">(<ref loc="2CH 29:1-2">2 Odo. 29:1-2</ref>; <ref loc="2CH 31:1">31:1</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 18:1" />Isira'eelike moyanji Elaki belti Hoose'i moyeexxe sakkaxxe wogga'n Yihudak moyanji Akaazik belti Hiziqiyaasi moye. <verse eid="2KI 18:1" /><verse number="2" style="v" sid="2KI 18:2" />Moyee wodda wogga isixxinna lame tommenna ondetemmani: Iyyerusaalemi ofo'leexxi lame tommenna sallaane wogga moye galche. Ama isixxinna Zekkaariyaasixxe belto kadda wodda summa isekanna Abiya hiyyemmani. <verse eid="2KI 18:2" /><verse number="3" style="v" sid="2KI 18:3" />Anni isiki moyanji Daawwiti assemmaxxa duuchcha, isinna Duuchchi Woddik Gootti edo eloxxa yaane asse. <verse eid="2KI 18:3" /><verse number="4" style="v" sid="2KI 18:4" />Tullichchuwwake'ni hedheeka magenoonfantammaka booncho balleesse; fakkuwwatixxa sooddo butuchche bire; Ashera hiyyendaaxxe fakkexxa sooddo kukkute; Muuse giissemmaxxe sageettotike bofixxe fakke'a, Isira'eeli eettenne yanna qico'ni hixaana gunba'ni hexxemmaxxee isee butuchche; isenna Nehushittaan<note caller="+" style="f"><char style="fr" closed="false">18:4 </char><char style="ft" closed="false">Nahushittaan hiyyemaak hiyyichchik laagadi</char><char style="ft" closed="false">Nehooshi </char><char style="ft" closed="false">bofa yookaan battitte yaane hiyyaake hiyyichchike laagadinni welti mitte laagadan.</char></note> hiyyendaammani.<note caller="-" style="x"><char style="xo" closed="false">18:4 </char><char style="xt" closed="false"><ref loc="NUM 21:9">Lak. 21:9</ref>. </char></note><verse eid="2KI 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 18:5" />Hiziqiyaasi Isira'eelike Duuchchi Woddike Gootta Mageno'ni addateme; isi edonna kaddo isi uduma isoo fakkaataaki weli Yihudaka moyanjuwwa duuchchanaa'ni isishsha hedheeki hedhemmabaani. <verse eid="2KI 18:5" /><verse number="6" style="v" sid="2KI 18:6" />Isi Duuchchi Woddik Gootta'ni addatememmaxxe'e isike oranaa'ni gargaritti higebaani Duuchchi Woddiki Gootti Muuse'ni uwwemmaka ajajuwwa heqqedhdhe. <verse eid="2KI 18:6" /><verse number="7" style="v" sid="2KI 18:7" />Tennexxe Duuchchi Woddik Gootti isin welti hedhemmaxxe assaaxxi duuchchi isi'a qajeelde. Asoorike moyanjo'ni fuggoxxini ke'e; irbo uwwammaxxanna hoyyedhe. <verse eid="2KI 18:7" /><verse number="8" style="v" sid="2KI 18:8" />Filisixeemika manna Gaaza qico'n, ookko'ni boginxe gabala qico'ni mare geyeexxi, heqqanjuwwi ofole heqammaxxe xelephonaa'ni kinjiki ijaaremeemmake dalla'ike qachchi qico'ni lole injifate.<verse eid="2KI 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 18:9" />Hiziqiyaasi moyeexxe sholgaxxe wogga'ni; Isira'eelki moyanji Elaki belti Hoose'i moyeexxe torbaaxxe wogga'ni; Asoorik moyanji Selminasoori Semaariya mareexxi qachchakanna erqe kayyi'n buqe. <verse eid="2KI 18:9" /><verse number="10" style="v" sid="2KI 18:10" />Sakkaxxe woggake muuxama'ni abixxe. Semaariya abidendeekinna Hiziqiyaasi moyeexxe jiyaxxe woga'n; Hoose'i Isira'eel'ni moyeexxe sallaanixxe wogga'nitemmani. <verse eid="2KI 18:10" /><verse number="11" style="v" sid="2KI 18:11" />Asooriki moyanji Isira'eelika arda booji'e Asoori'a aadhe me'eexxi; Halahi, Gozaani giddo Heboorike galaani biranna Meedoonike qachchuwwa'ni ofollaashsha asse. <verse eid="2KI 18:11" /><verse number="12" style="v" sid="2KI 18:12" />Tinninna insa'ne'n gelteechchi Duuchchi Woddike Goottik erganji Muuse ajajeeka Duuchchi Woddike Goottika insa'neeke Magenika hiyyichcho duuchcha lanqammaxxa bakka kako isini aangemmaxxa diingemmaxxeeteni. Ajajuwwa isikanna lanqebaani; higgeeni muunxebaani.<verse eid="2KI 18:12" /></para>
  <para style="s1">Asoorito Isira'eeli Lolate'e Dagge</para>
  <para style="r">(<ref loc="2CH 32:1-19">2 Odo. 32:1-19</ref>; <ref loc="ISA 36:1-22">Isa. 36:1-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 18:13" />Hiziqiyaasi moyeexxe tommenna sholgaxxe wogga'ni Asoorik moyanji Seenaakireemi lole injifate kinjiinke dalla'ini buqemeeka Yihudaka qachchuwwa duuchcha abixxe. <verse eid="2KI 18:13" /><verse number="14" style="v" sid="2KI 18:14" />Tennexxe Yihudak moyanji Hiziqiyaasinna «Balleessanji anendeni; waaldettexxi anenaa'ni udumi'a higi; aninna laqqatolcho duuchcha uwwannoni;» hiyya'n Lakkishii hedheemmake Asoorike moyanjibaa tenne erga erge. Asooriki moyanjinna; Yihudiinka moyanjo Hiziqiyaasi'i tomme kuma kiilo birretika sibiljo, mitte kuma kiilo worqe ani'a ergi hiyye. <verse eid="2KI 18:14" /><verse number="15" style="v" sid="2KI 18:15" />Tennexxe Hiziqiyaasi Duuchchi Woddike Goottike galma'ninna mootummatike miya masse'nammake minuwwa'ni hedheeka birretika sibiljo isi'a uwwe.<verse eid="2KI 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 18:16" />Eettene yanna'ninna Yihudak moyanji Hiziqiyaasi; Duuchchi Woddike Goottike galmike cufanuwwa'ninna mikikkilanjuwwake'ni abidisemmaxxa worqe goggosheexxi Asoorike moyanji'a uwwe.<verse eid="2KI 18:16" /></para>
  <para style="s1">Senaakireemi Iyyerusaalemi'i Sodaachchise</para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 18:17" />Asoorik moyanji Lakkishii'n loliinke mannika umo, loliinke mannika taakkaka ajajallonna, loliinke mannika akeekisanjo heddo loliinke mannini welti Yihudiinki moyanji hedheeba Iyyerusaalemi'a erge; insa'nenna Iyyerusaalemi'a duulexxi Hiziqiyaasi'ni lola geesinso'a ajaje; iikki sannachcinna jabak baaloma afeeke sase loliinkaajajuwwa akeekakemman; insa'nenna Iyyerusalmi'a genneeshanni ali darrexxe muumme darree'ni sa'aka dareeni bira seemma borcammakike fichchibaa me'inammake ora abixine. <verse eid="2KI 18:17" /><verse number="18" style="v" sid="2KI 18:18" />Insa'nenna moyanjiinbaa erga ergine; ookkoneechchi uduma mootummatike minike ajajallo kadeeki Hiliqiyaki belti Eliyaaqeemi; borreessanji Saaminaasi iittani jirte borreessamaki Asaafiki belti Yo'ahi insa'neebaa marre.<verse eid="2KI 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 18:19" />Asoorik loliinki ajajallinna insa'ne'a hiyyee qici: «Hiziqiyaasi'a hitinaa qici:</para>
  <para style="pm" vid="2KI 18:19">« ‹Lumoki Asooriki moyanji hiyya'nee qici: Atinni iitta addattettexxi yaane maachcho? <verse eid="2KI 18:19" /><verse number="20" style="v" sid="2KI 18:20" />Loliinxa barannonna hunna afeenneni hitaatteni; yaane kinni odoni callani. Ane'ni iitta fuggoxxini kexxeetteki ayye'n addatteete? <verse eid="2KI 18:20" /><verse number="21" style="v" sid="2KI 18:21" />Uudi iitta addattaattexxe Gibtse'ni irkataaki manji, anga isixxa ote'e madeessammake cancaaqemeeke shonbooqishshateni. Gibtsek moyanji Feri'ooninna iso'ni addataake duuchchi'a iittandeni. <verse eid="2KI 18:21" /><verse number="22" style="v" sid="2KI 18:22" />Iittanni ati ane'n, «No'o addantaanneki Duuchchi Woddike Gootta'n Mageno no'oke'niteni» hita'eettexxe kaddoolenna, Hiziqiyaasi Yihudakanna Iyyerusaalemika arda «Ha'no magenoonfata hasisaaki Iyyerussaalemi hedheeke konne tolchimalchi edoni» hiyyeexxi eettenee koobati hanixxa magenoofachchotixxa bakkaaranna tolchimalchuwa diigiseeki isotebaa»?<verse eid="2KI 18:22" /></para>
  <para style="pm">
    <verse number="23" style="v" sid="2KI 18:23" />« ‹Ta'a daggettexxi gootta ankinni Asoorike moyanjinni welti weli aagge'e; fadhado gulufaaka manna afa dandeettaattexxe kaddoole; lame kuma fadhado ati'a uwwannoni. <verse eid="2KI 18:23" /><verse number="24" style="v" sid="2KI 18:24" />Addattaattek Gibtsexxe gaaruwa'ninna fadhaduwwake'nite kaddoole anke gootti hunda hedheeki loliinke mannki jalqaba midde mitte hitta hiissa dandeettatto? <verse eid="2KI 18:24" /><verse number="25" style="v" sid="2KI 18:25" />Isee waalini ani lole konnee boncho balleessona'a dageenneki Duuchchi Woddike Goottike ajaji belo ati'a fakkaata'ne? Konne boga'ni duule lole balleessonna'a ane'ni kuleeki umi isingennini Duuchchi Woddike Goottani.› »<verse eid="2KI 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 18:26" />Ookkoneechchi uduma Hilqiyaasiki belti Elyaqeemi, Saaminaasinna Yo'asi loliinke mannika akeekisanjo, «No'o atik erganjuwwi lanqannaxxe; maganneteni Soorike afo'ini haaso'i; dalla'ake'ni hedheek manni laqaake Ibirayisixike afo'in no'o'ni haasoottoxxeni» hine.<verse eid="2KI 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 18:27" />Loliinka manna ajajammakinna, «Yoona gootti anki iitta haaso'onna'a ane ergeeki; gootta ha'nookenna ha'no'a calla? Insa'nenna ha'noshsha ifinga foole'a indaashsha, shi'na ifinxanna ha'winaashsha dala'ake'ni ofolleekiirinna miteba lanqashatebaa?»<verse eid="2KI 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 18:28" />Ookkoneechchi uduma loliinka manna ajajammaki uurreexxi hafuura gikki asseexxi Ibirayisixike afo'in hiyya'ni haaso'ee qici: «Yoona lumoke Asoorike moyanjiinka hiyyichcho laqqe! <verse eid="2KI 18:28" /><verse number="29" style="v" sid="2KI 18:29" />Moyanjikinna anxe anganaa'ni ha'no'o anjira dande'a gophammaxxee Hiziqiyaasi'i ha'no soboqqe'e! <verse eid="2KI 18:29" /><verse number="30" style="v" sid="2KI 18:30" />Higgeenna Hiziqiyaas, ‹Duuchchi Woddik Gootti mitte mami belo no'o anjiraani; konnee qachchanna Asoorike moyanji'a sa'isse uwwabaani› hiyya'ni Duuchchi Woddike Gootta'ni addattinaashsha ha'no'aa kula'neexxa laqqinoqqe'e.<verse eid="2KI 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 18:31" />«Hiziqiyaasi hiyya'neexxa laqqinoqqe'e. Asoorik moyanjinna hiyya'nee qici: aninni welti araaremme, anganna uwwe: ookkoneechchi uduma ha'nonaa'ni mitti mittingi ifixxe woyinenaa'ninna balase ifixxenaa'ni ittani, ifinxe balenaa'ni wode'e ha'waani. <verse eid="2KI 18:31" /><verse number="32" style="v" sid="2KI 18:32" />Tinninna kaddaachchii ha'noonga fakkataaka boga midhatanna woyinetixxa booka; waasanna woyinetika hiddichcho; ejersiinxa haqqenna; malebi hedheebaa e'yishanno qico'niteni; ha'nonna rertinabaashsha hedho fi'le.</para>
  <para style="p" vid="2KI 18:32">«Hiziqiyaasinna, ‹Duuchchi Woddik Gootti no'o anjiraani hiyya'ni ha'no dedhisammaxxe isixxa laqqinoqqe'e,› <verse eid="2KI 18:32" /><verse number="33" style="v" sid="2KI 18:33" />Isi'ni gosa gosake ardike magenuwwanaa'ni boga Asoorike moyanjixxe anganaa'ni anjireeki haba hedhe? <verse eid="2KI 18:33" /><verse number="34" style="v" sid="2KI 18:34" />Hamaatikanna Arifaadik magenuwwi isi haba hedhe? Sefariwayimik, Yenaa'ikanna Iwwak magenuwwi yoona haba genne? Semaariya'a anxe anganaa'ni anjireeta? <verse eid="2KI 18:34" /><verse number="35" style="v" sid="2KI 18:35" />Konne boguwwiki magen duuchchi boga ifika anxe anganaa'ni gatiso'a dande'eeki ayyete hedhe? Yoona Duuchchi Woddik Gootti Iyyerusaalemi'i anxe anganaa'ni hitta woda dande'a?»<verse eid="2KI 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 18:36" />Moyanjikinna, «Hiissa hiissitinoqqe» hiyye ajajemmaxxee, ardi sammi hiyye mitte hiissanna hiissebaani.<verse eid="2KI 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2KI 18:37" />Ookkoneechchi uduma mootummatike miniki ajajalli Kelqiyaasiki belti Elyaaqeemi, borreessanji Saaminaasi iittanni Asaafiki belti Yo'ahi seemma ifi ifixxa yaaddoti daddarre; Hiziqiyaasiba'a dangeexxi loliinke manniki ajajalli insa'ne'n hiyyeexxa kulle.<verse eid="2KI 18:37" /></para>
  <chapter eid="2KI 18" />
  <chapter number="19" style="c" sid="2KI 19" />
  <para style="s1">Iyyerusaalemi Naaphiinxe Anganaa'ni Anjirendaaxxa Kulendeexxa Wabeekumma</para>
  <para style="r">(<ref loc="ISA 37:1-7">Isa. 37:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 19:1" />Moyanji Hiziqiyaasi tennee laqeexxe yanna'ni ifixxa yaaddoti seemma haaqi asse dare; doniyya oddo'weexxi Duuchchi Woddike Goottike galmiba me'e.<verse eid="2KI 19:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 19:2" />Ookkoneechchi uduma mootummatike minika ajajallo Eliyaqemini'i, borreessanjo Saaminaasinna qeesetiki akekisanjuwwi dooniyya odo'wineexxi Amootsike beltibaa wabeeka Issayaasibaa duuchchiinga erge.<verse eid="2KI 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 19:3" />Insa'nenna hinee qici, «Hiziqiyaasinna yooni tinni barra rakkotixxe, xixematixenna salphinniinxe barrani; tinni barranna oose ilendaaxxi yanna geltoole ciniinto bira saxxammashsha; yaane kinni ciniinffatate'e ilate hunna gopheexxe manjichchoshsha kandeenneni. <verse eid="2KI 19:3" /><verse number="4" style="v" sid="2KI 19:4" />Hedhaaka Duuchchi Woddika Gootta yowwaashsha gootti isik Asoorik moyanji ergemmaki umike loliinke manni ajajallika hiyyichcho duuchcha Duuchchi Woddiki Gootti atiki Mageni taki laqe'en, laqemmake hiyyichchixxeenna Duuchchi Woddiki Gootti iso'o xixaashsha lubboti gatemmake no'oke manni'a soodati» hine.<verse eid="2KI 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 19:5" />Moyanjo Hiziqiyaasik Ja'laabuwwi Issayaasibaa dagee wodda, <verse eid="2KI 19:5" /><verse number="6" style="v" sid="2KI 19:6" />Issayaasi hiyyee qici, «Gootta ha'nooke hitine kuldinaa qici, ‹Yooni Duuchchi Woddik Gootti Asoorike moyanjiki erganjuwwi anee yowwa'na'a laqqetteke yowwichchi'a sodaattoxxe. <verse eid="2KI 19:6" /><verse number="7" style="v" sid="2KI 19:7" />Kunna ani mitte bifaka hafuura iso'ni uggannoni; kaddeexxa odo laqoole ifike bogibaa higaani; ookkonna wolaantichchake'ni shiyemmasha asannoni.› »<verse eid="2KI 19:7" /></para>
  <para style="s1">Asoorito Wele Yowwaak Manna Ergiteexxa</para>
  <para style="r">(<ref loc="ISA 37:8-20">Isa. 37:8-20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 19:8" />Loliinke manniki ajajalli Asoorik moyanji Lakkishii'n ke'e me'exxa laqeexxi hige; moyanjo Libinaa'n lolake'ni hedhe'na mare.<verse eid="2KI 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 19:9" />Eettene yanna Gibtseki moyanji Tophiyiinka moyanjo'ni Tirhaaqa lolo'a me'ate'ni hedheexxa Senakireemi laqe; tennexxee Hiziqiyaasiba'a higeeni hiyye erga ergee qici, <verse eid="2KI 19:9" /><verse number="10" style="v" sid="2KI 19:10" />«Martineexxi Yihudaka moyanjo Hiziqiyaasi, addattaatteki atiki Mageni ‹Iyyerusaalemi Asoorike moyanjixxe anga'ni ibbabaani› hiyye atee soboqqe. <verse eid="2KI 19:10" /><verse number="11" style="v" sid="2KI 19:11" />Yooni Asoorik moyanjuwwi boga atike duuchcha'ni maa asseexxa laqqeetteni; hara balleesine birre'eni; ati gattattota? <verse eid="2KI 19:11" /><verse number="12" style="v" sid="2KI 19:12" />Ediki annuwwi anki biremmaka arda kunninna, Gozaanika, Kaaranikanna Retsefika iittani Telasaari hedhemmaka Edenike mannik magenuwwi insa'neeki anjire'eta? <verse eid="2KI 19:12" /><verse number="13" style="v" sid="2KI 19:13" />Isinni Hamaatiki, Arifaadiki, moyanjuwwi haba he'ne? Sefariwayimike qachchiki moyanji haba hedhe? Higgeeni Heenaaki yookaani Iwwak moyanjuwwi haba he'ne?»<verse eid="2KI 19:13" /></para>
  <para style="s1">Hiziqiyaasixxa Soodachcho</para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 19:14" />Hiziqiyaasi borro erganjokena'ni aadheexxi haaseesse; ookkoneechchi uduma Duuchchi Woddike Goottike galmi giddo mareexxi borrotanna Duuchchi Woddike Gootti edo farri asse.<verse eid="2KI 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 19:15" />Ookkoneechchi uduma Hiziqiyaasi hiyya'ni Duuchchi Woddike Goottibaa soodatee qici; «Kurubeeluwwiinxe oddo'n moote atixxe'ni ofoldeetteke koo, Isira'eelike Duuchchi Woddike Gootta Mageno; buttatixxe mootumma duuchchiki Mageni ateni callani; iimanna butta dadeettekinna ateteni.<note caller="-" style="x"><char style="xo" closed="false">19:15 </char><char style="xt" closed="false"><ref loc="EXO 25:22">Fula. 25:22</ref>. </char></note> <verse eid="2KI 19:15" /><verse number="16" style="v" sid="2KI 19:16" />Duuchchi Woddike Goottaa ta'anna mansha atixxa wirrassite laqi, Duuchchi Woddike Gootta; ille atixxini uudi; Seenaakireemi Duuchchi Woddika Gootta yowwo'a ergeeka hiyyichcho laqi.<verse eid="2KI 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 19:17" />«Duuchchi Woddike Gootta Asoorik moyanjuwwi konne gosa gosaka ardanna boga insa'neeka balleessineexxi dhugaaten. <verse eid="2KI 19:17" /><verse number="18" style="v" sid="2KI 19:18" />Magenuwwa insa'neeka giirati giddo hunne gunbe'eni; kunni manjiinxe anga'ni hunjeeka haqichchonna kinjo calla malee'e magenuwwakemmabaani. <verse eid="2KI 19:18" /><verse number="19" style="v" sid="2KI 19:19" />Duuchchi Woddike Gootta no'oke Mageno, buttatiki mootummuwwa duuchchi atini calli Duuchchi Woddike Gootta Mageno kaddeettexxa ege'naashsha ta'a Asoorike moyanjixxe anganaa'ni no'o wodi.»<verse eid="2KI 19:19" /></para>
  <para style="s1">Issayaas Senakireemi Ibaaxxa Raaga Haaso'e</para>
  <para style="r">(<ref loc="ISA 37:21-38">Isa. 37:21-38</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 19:20" />Ookkoneechchi uduma Amootsiki belti Issayaasi moyanjo Hiziqiyaasibaa hiyye erga ergee qici: «Isira'eeliki Duuchchi Woddik Gootti Mageni Asoorike moyanjo Seenaakireemixxee anibaa soodattettexxa soodachcho laqeenneni. <verse eid="2KI 19:20" /><verse number="21" style="v" sid="2KI 19:21" />Yooni isixxee Duuchchi Woddik Gootti hiyyeeki hiyyichchi;</para>
  <para style="q1" vid="2KI 19:21">« ‹Tsiyoonixxi belto duuddo dubarrichcho tuffattaan;</para>
  <para style="q2" vid="2KI 19:21">ise ate'ni qi'missan, ate'e tuffattaan;</para>
  <para style="q1" vid="2KI 19:21">Iyyerusaalemixxi dubarrichcho,</para>
  <para style="q2" vid="2KI 19:21">atee ise'ni hana me'itatto wodda umo le'missaan.<verse eid="2KI 19:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2KI 19:22" />Yowwitettekinna ille fulchitettek ayye'nite?</para>
  <para style="q2" vid="2KI 19:22">Lallabba'etek aye'nitesi?</para>
  <para style="q1" vid="2KI 19:22">Hollati ifi dukaatek aye'nite?</para>
  <para style="q2" vid="2KI 19:22">Woyyichcha Isira'eelike Mageno'ninde?<verse eid="2KI 19:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="2KI 19:23" />Erganjuwwi atiki gamii'ni,</para>
  <para style="q2" vid="2KI 19:23">Mageno atika yowwite maala muluqo fulchitettexxi;</para>
  <para style="q1" vid="2KI 19:23">Atinna hitette qici,</para>
  <para style="q2" vid="2KI 19:23">«Heddo anxe gaaruwwani,</para>
  <para style="q1" vid="2KI 19:23">Koobuwwatika qeerrinne:</para>
  <para style="q2" vid="2KI 19:23">Libaanoosixxe xungo'ni iima fuleenneni:</para>
  <para style="q1" vid="2KI 19:23">Qeerraramma biribiirsuwwa;</para>
  <para style="q2" vid="2KI 19:23">elolla hi'neessuwwa woxedheenneni;</para>
  <para style="q1" vid="2KI 19:23">Bayyike bogixxa gabala</para>
  <para style="q2" vid="2KI 19:23">eloke gongomiba geyeenneni» hiteetteni.<verse eid="2KI 19:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="2KI 19:24" />«Keessummumma ofo'leenne boga'ni wedi'inxa bale qoltenneni</para>
  <para style="q2" vid="2KI 19:24">ookkonna wode'e ha'wenneni.</para>
  <para style="q2" vid="2KI 19:24">Lekka anxixxe kophenni,</para>
  <para style="q2" vid="2KI 19:24">Gibtseke wodi'ixxa muummuwwa hirbeesse basseenneni» hite gacifattetten.<verse eid="2KI 19:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="2KI 19:25" />« ‹Heddo yanna ediga'ma,</para>
  <para style="q2" vid="2KI 19:25">tennee ani assennexxa laqqebexxongi hexxeetta?</para>
  <para style="q1" vid="2KI 19:25">Edinge baro'n hedennexxinna,</para>
  <para style="q2" vid="2KI 19:25">ta'a kinni muuxxendaashsha assenneni.</para>
  <para style="q1" vid="2KI 19:25">Konne kinjinke dalla'ini buqemeeka qachchuwwa,</para>
  <para style="q2" vid="2KI 19:25">ati kinotixxe ole assitota'ateni.<verse eid="2KI 19:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="2KI 19:26" />Ookko hedha'neeke manni hunna gophphe'eeni,</para>
  <para style="q2" vid="2KI 19:26">alayyexxinna shookiinxa dooniyya odo'wine'eni.</para>
  <para style="q1" vid="2KI 19:26">Diidake'ni lateeke hiddichchishsha;</para>
  <para style="q2" vid="2KI 19:26">reefike mudhishsha mininxe guuto'ni latteexxi,</para>
  <para style="q1" vid="2KI 19:26">Nophphitebaangi baggammaxxe badda'ashsha kande'eni.<verse eid="2KI 19:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="2KI 19:27" />« ‹Haba ofoldattoxxa</para>
  <para style="q2" vid="2KI 19:27">haa'no dage'e haa'no me'itattoxxa</para>
  <para style="q2" vid="2KI 19:27">ane'n mufattettexxa mufe ege'nenneni.<verse eid="2KI 19:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="2KI 19:28" />Ane'ni mufattettaxxe, tuffe atixxanna mansha anxinni laqeennaxxe</para>
  <para style="q2" vid="2KI 19:28">malxaqqo anxinni sano atixxa urannoni,</para>
  <para style="q1" vid="2KI 19:28">Lugaama ankanna afo'o atike'ni uggannoni</para>
  <para style="q2" vid="2KI 19:28">daggettanga ora hige me'itattoshsha assannoni.›<verse eid="2KI 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 19:29" />«Koo Hiziqiyaasi'i beessisikinna konneechchini butti'a hedheenii:</para>
  <para style="q1" vid="2KI 19:29">«Tenne wogga'ni ifittini latteexxa,</para>
  <para style="q2" vid="2KI 19:29">daggaxxe wogga'ni kinni ookken ifitti lateekenaa'n lataaka itinaani.</para>
  <para style="q1" vid="2KI 19:29">Yaane kinni Sakkaxxe wogga'ni midha facaalsitine ha'mitinaani,</para>
  <para style="q2" vid="2KI 19:29">woyinetanna kalsitinaani; gummatanna ittinaani.<verse eid="2KI 19:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="2KI 19:30" />Ta'anna Yihudake ardanaa'n hafe ganteeki hidda oltaan</para>
  <para style="q2" vid="2KI 19:30">gummatanna gumminsaani.<verse eid="2KI 19:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="2KI 19:31" />Iyyerusaaleminaa'ni lubboti gateeki; Tsiyoonixxe koobaba'ni renne baaki ganteeki fulaani.</para>
  <para style="q2" vid="2KI 19:31">Dada Duuchcha Ajajake Duuchchi Woddik Gootti Magenixxi hinaaffe tennee assitaani.<verse eid="2KI 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 19:32" />«Tennexxe'e Duuchchi Woddik Gootti Asoorike moyanjixxe hiyya'nee qici,</para>
  <para style="q1" vid="2KI 19:32">«Konne qachcha'ni hara e'yabaani:</para>
  <para style="q2" vid="2KI 19:32">mitte gabenna iso'ni darbatabaani:</para>
  <para style="q1" vid="2KI 19:32">Wonte abixxe iseba'a shiqabaani;</para>
  <para style="q2" vid="2KI 19:32">buttinakanna iso'n iimi'a tullubabaani.<verse eid="2KI 19:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="2KI 19:33" />Dagemmange oriba'a hige me'ani: hige me'aani male'e konne qachcha'n hara e'yabaani; hiya'neni Duuchchi Woddik Gootti.<verse eid="2KI 19:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="2KI 19:34" />Anxeenna anke erganjo Daawwitixxee hiyye;</para>
  <para style="q2" vid="2KI 19:34">konnee qachcha anjironna'a gollannoni.»<verse eid="2KI 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 19:35" />Eettennee hashsha Duuchchi Woddike Goottixxi erganna fuldeexxi Asooritotixxe kaamibe'n mitte dhibbanna saddeeta tommenna onde kuma manna shilte; gorsa manni diiphii'ni ke'a wodda bonchi duuchchi rensha calla kade. <verse eid="2KI 19:35" /><verse number="36" style="v" sid="2KI 19:36" />Asoorik moyanji Seenaakireeminna ookko'n ke'exxi me'e;</para>
  <para style="q2" vid="2KI 19:36">Nenewe'a higeexxi ookkoni ofo'le.<verse eid="2KI 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2KI 19:37" />Mitte barra Nisirok hiyyemaak insa'neke magenuwwixxa fakkeke mini giddo kumbu hiyyate'n hedhee'na'a; Adiraameelekinna Saaretseeri hiyyendaaxxi oose isixxi wolaantichchiki iso shilte; ookko'ni fuldeexxi Araarati'a baqaatte. Belti isiki Asirado isixxe bakkaa'ni mowe.<verse eid="2KI 19:37" /></para>
  <chapter eid="2KI 19" />
  <chapter number="20" style="c" sid="2KI 20" />
  <para style="s1">Hiziqiyaasi Elagophe</para>
  <para style="r">(<ref loc="ISA 38:1-8">Isa. 38:1-8</ref>, <ref loc="ISA 38:21-22">21-22</ref>; <ref loc="2CH 32:24-26">2 Odo. 32:24-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 20:1" />Eettenne yanna'ni Hiziqiyaasi jaba qico ela gopheexxi reyo shiqeemmani. Amootsiki belti wabeek Issayaasi uushshotee mareexxi «Duuchchi Woddik Gootti ‹Rertaatteni malee yooni gata gophphattaxxe duuchchiinxa yaane giissi› hiyye'eni» hiyye kule.<verse eid="2KI 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 20:2" />Hiziqiyaasinna alba gimotiba'a wirri assedheexxi; Duuchchi Woddike Goottibaa hiyye soodatee qici, <verse eid="2KI 20:2" /><verse number="3" style="v" sid="2KI 20:3" />«Duuchchi Woddike Goottaa! Xuurameesummatinna mitte godobinni ati'a ergatemennexxa; ati gammaddattoxxa yaane assennexxa hedi» hiyya'ni Hiziqqiyaasi hiiqise oodhe.<verse eid="2KI 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 20:4" />Issayaasi oddotixxe weldennaba sa'e me'ebaangi Duuchchi Woddike Goottik hiyyichchi isibaa hiyya'n dagee qici; <verse eid="2KI 20:4" /><verse number="5" style="v" sid="2KI 20:5" />«Udumi'a higgettexxi ardi ankika sooresa Hiziqiyaasi hitatto qici, ‹Edike anni atikiki Daawwitiki Duuchchi Woddik Gootti Mageni hiya'nee qici: soodachcho atixxa laqeenneni: indiddo atixxanna uudeenneni; ani ate fayyisannoni: sase barra uduma Duuchchi Woddike Goottike galmibaa martattoni. <verse eid="2KI 20:5" /><verse number="6" style="v" sid="2KI 20:6" />Wogga atixxe'ni hana tommenna onde wogga ati'a lebannoni: ateenna konne qachcha Asoorike moyanjiinxe anganaa'ni anjirannoni; ani ifixxeenna anke erganjo Daawwitixxe hiyye; konne qachcha gollannoni.› »<verse eid="2KI 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 20:7" />Ookkoneechchi uduma Issayaasi, «Balasetika xalta qophpheesse» hiyye. Insa'nenna qophpheessineexxi miserake'ni hana uggine; isinna fayye.<verse eid="2KI 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 20:8" />Moyanji Hiziqiyaasinna Issayaasii'i «Duuchchi Woddik Gootti anee fayyiseexxa; sase barra uduma galmi isikibaa me'annoki beessisi maachcho?» hiyye Issayyaasi qore.<verse eid="2KI 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 20:9" />Issayaasinna «Duuchchi Woddik Gootti hiyye addachchiiseexxa muuxaaki beessisikiteni. Gaaddiddo tomme takkaarro edi'a saxxa? Yookaani tomme takkaarro udumi'a higgaa?» hiyye qore.<verse eid="2KI 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 20:10" />Hiziqiyaasinna hiisseexxi, «Gaaddido tomme takkaarro edi'aa me'aa shollexxaammaxxe tenne mannii'n tomme takkaarro udumi'a higgowwaali» hiyye.<verse eid="2KI 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 20:11" />Ookkonneechchchi uduma wabeek Issayaasinna Duuchchi Woddike Goottibaa soodate: Duuchchi Woddiki Goottinna moyanjo Akaazi tarkafatemmaxxe takkaarronaa'n tomme takkaarro udumi'a higgaashsha asse.<verse eid="2KI 20:11" /></para>
  <para style="s1">Baabilooni'ni Dageeka Erganjuwwa</para>
  <para style="r">(<ref loc="ISA 39:1-8">Isa. 39:1-8</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 20:12" />Eettene yanna'ni Baabiloonik moyanji Baaladanika belto Meroda-Baaladani, moyanji Hiziqiyaasi ela gopheexxa laqemmaxxe; tennexxe borro borreesseexxini mitteba uwwa Hiziqiyaasi'a erge.<verse eid="2KI 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 20:13" />Hiziqiyaasinna erganjuwwa gammashshoti qophedhe; miya mase'nammake mine'ni hedheechcho duuchcha, birretika siblijo, worqe, qimamuwwanna fiixxeexxa zayite, loliinke miyuwwika minenna wele miya masse'nammake mine'ni hedheechcho duuchcha insa'ne'n leelishe. Mootummatike mine'ni hedheechchonna kadi boga isike duuchcha'ni hedheechcho Hiziqiyaasi insa'ne'n leelishebaaki gateechchi mittichchinna hedhebaani.<verse eid="2KI 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 20:14" />Ookkoneechchi uduma wabeek Issayaasi moyanjo Hiziqiyaasiba'a mareexxi, «Kunni manni habaa'n dageeke? Maa ate'ni hiyye?» hiyye qore. Hiziqiyaasinna hiisseexxi «Insa'ne dange'ebi Baabilooni hiyyemabaa'ni bayyi boganaa'niteni» hiyye hiisse.<verse eid="2KI 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 20:15" />Wabeek Issayyaasinna «Mootummatike atike mini giddo maachchota uunde» hiyye qore.</para>
  <para style="p" vid="2KI 20:15">Hiziqiyaasinna «Mootummatike anke mine'ni hedheechcho duuchcha uunde'eni: miya massinammake mini giddo hexxeexxe karra duuchchanaa'ni insa'ne'n lelishebe'nochchi mittichchinna hedhebaani» hiyye.<verse eid="2KI 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 20:16" />Ookkoneechchi uduma Issayaasinna Hiziqiyaasi'i, «Duuchchi Woddike Goottika hiyyichcho laqi;<note caller="-" style="x"><char style="xo" closed="false">20:16 </char><char style="xt" closed="false"><ref loc="2KI 24:13">2 Moy. 24:13</ref>; <ref loc="2CH 36:10">2 Odo. 36:10</ref>. </char></note> <verse eid="2KI 20:16" /><verse number="17" style="v" sid="2KI 20:17" />Mootummatike atike mine'ni hedheechchi duuchchi ediki annuwwi atiki telchi qico'ni tuleechcho duuchcha Baabiloon'a adhdhine me'inaaxxe barra dhugaanden daggaani; mittilchi gataachchi hedhebaani hiyya'neeni Duuchchi Woddik Gootti» <verse eid="2KI 20:17" /><verse number="18" style="v" sid="2KI 20:18" />Atixxe horte giddii'ni mitti mitti Baabilooni'a boojiine adhdhine me'inaaxxi Baabiloonike mootummatike mine'ni kolaasseme ergatemaashsha assemaan.<note caller="-" style="x"><char style="xo" closed="false">20:18 </char><char style="xt" closed="false"><ref loc="2KI 24:14-15">2 Moy. 24:14-15</ref>; <ref loc="DAN 1:1-7">Dan. 1:1-7</ref>. </char></note><verse eid="2KI 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 20:19" />Moyanji Hiziqiyaasinna «Hitetteki Duuchchi Woddike Goottik hiyyichchi elokeni» hiyye hiisse; «Ani hedhenne qico'ni nage'ikinna dhugaa hexxeexxe kaddoole kadeexxi kaddowwaali» hiyye.<verse eid="2KI 20:19" /></para>
  <para style="s1">Moyanjo Hiziqiyaasixxe Mootummaxxa Muuxensha (2 Odo. 32:32-33)</para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 20:20" />Hiziqiyaasi moyemmake baro'ni hujeexxi; wele asse muuxeexxi yaane duuchcha jannuntetinna ittani wodi'i kofemaaka booncho hitta asse hujeexxanna qachchi giddi'a wode'e aassate'e unsiise buttini giddii'ni dareera hujiseexxi duuchchi Yihudake moyanjuwwiinke jirtetike maxaafa'ni borreessende hexxeexxebaata?<verse eid="2KI 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 20:21" />Hiziqiyaasinna edike annuwwishshanni reye; belti iski Minaase isixxe bakka'ni mowe.<verse eid="2KI 20:21" /></para>
  <chapter eid="2KI 20" />
  <chapter number="21" style="c" sid="2KI 21" />
  <para style="s1">Yihudiinka Moyanjo Minaase'e</para>
  <para style="r">(<ref loc="2CH 33:1-20">2 Odo. 33:1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 21:1" />Minaase moyee wodda wogga isixxi tommenna lametemmani; Iyyerusaalemi ofo'leexxi onde tommenna onde wogga moye galche; ama isixxinna Hefitsiba hiyyendaaxxemmani.<verse eid="2KI 21:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 21:2" />Isinna Duuchchi Woddik Gootti, Isira'eel edii'ni fulche shorreemmake gosa gosake ardixxa diqachchiissaaxxa aada hordofeexxi Duuchchi Woddike Gootti edo elobaaxxa yaane asse.<note caller="-" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="JER 15:4">Erm. 15:4</ref>. </char></note><verse eid="2KI 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 21:3" />Minaasenna anni isiki Hiziqiyaasi diigemmaka tullichchuwwake'ni magenoonfantammaka booncho hiisse ijaare; Isira'eeliki moyanji Aki'aab assemmaxxa duuchcha isinna Ba'aalite hiyyemaake magenuwwi'aa tolichimalcho giisse; Asheeraxxe fakkexxa soodo giisse. Iittanni urjuwwa duuchchanna sagade, magenoonfate.<verse eid="2KI 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 21:4" />Duuchchi Woddik Gootti «Summa anka Iyyerusaalemi uggannoni» hiyyemmaba Duuchchi Woddike Goottike galma'ni tolchimalchuwwa giisse.<note caller="-" style="x"><char style="xo" closed="false">21:4 </char><char style="xt" closed="false"><ref loc="2SA 7:13">2 Sam. 7:13</ref>. </char></note><verse eid="2KI 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 21:5" />Lamiinge Duuchchi Woddike Goottike galmiinke ba'linnuwwa'ni iimatixxe urjuwwa duuchchi'a tolchimalchuwwa giisse.<verse eid="2KI 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 21:6" />Isi i'leenga belto ciincatike tolchi'a shiqishe; gojo hujaakenna moraake kade'e; ekedha haaseessammakanna moro morammaka manna morsiirsa'nemmani; Duuchchi Woddike Gootti edo mufachchiissaaxxa elobaaxxa huje huje. <verse eid="2KI 21:6" /><verse number="7" style="v" sid="2KI 21:7" />Isi qunqumende giissendeexxa Asheeraxxe fakkexxa sooddo aadheexxi Galmi giddo ugge; kunninna Duuchchi Woddik Gootti Daawwiti'ninna belto isike Solomooni'n, «Konne galma'ninna Iyyerusaalemike qachcha'n summi ank duuchchi woddi'a hedho'a Isira'eelike gosatike mini duuchchanaa'ni ani fileenneke boonchon. <verse eid="2KI 21:7" /><verse number="8" style="v" sid="2KI 21:8" />Ittani ani ajajennexxa duuchcha xexxe'achchoti muuxiyyot ank erganji Muuse uwweeka seera duuchcha heqqedhate'n jabaanto malee'e yooni Isira'eelixxi lekka annuwwa insa'neke uwwennake boganaa'ni fuldee doonsa kiyya hinaashsha assabe'noni» hiyyeexxi konne boonchi'aateni.<note caller="-" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="1KI 9:3-5">1 Moy. 9:3-5</ref>; <ref loc="2CH 7:12-18">2 Odo. 7:12-18</ref>. </char></note><verse eid="2KI 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 21:9" />Ardi kinni laqebaani; Duuchchi Woddik Gootti Isira'eeli edi'ni biremmake gosa gosake ardi caala elobaaxxa huje hunjaashsha Minaase insa'ne dedhise.<verse eid="2KI 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 21:10" />Duuchchi Woddik Goottinna erganjuwa ifixxe wabeeko darree'n hiyye haaso'ee qici: <verse eid="2KI 21:10" /><verse number="11" style="v" sid="2KI 21:11" />«Yihudik moyanji Minaase tenne'e diqachiissaaxxa yaane cubbo duuchcha huje'eni; isi edi wodda hedhemmakie Amoorake ardi caala elobaaxxa huje huje'eni. Yihudakanna fakke magenoonfantaashsha asse cubbote'ni ibise. <verse eid="2KI 21:11" /><verse number="12" style="v" sid="2KI 21:12" />Tennexxe Isira'eeliki Duuchchi Woddike Goottika Mageno laqaake manji duuchchixxi mansha gibbaashsha assaaka fuggoxxa rakko Iyyerusaalemi'ninna Yihudake'ni iyyedagannoni. <verse eid="2KI 21:12" /><verse number="13" style="v" sid="2KI 21:13" />Semaariya mikennexxa wodaro Aki'aabike mi'ne mikennexxe tunbe Iyyerusaalemi hana diriirsannon; mitti manji qore fiyammashsha fiyeechchi uduma gonbisammashsha aninna Iyyerusaalemi fiye isee gonbisannoni. <verse eid="2KI 21:13" /><verse number="14" style="v" sid="2KI 21:14" />Ba'netenaa'ni gateeka anka arda waalannon; naapha insa'neekixxe anga'ni sa'isse uwwannoni: insa'nenna boojji'naani; karra inisa'neexxanna saammani. <verse eid="2KI 21:14" /><verse number="15" style="v" sid="2KI 21:15" />Insa'ne'ni tennee duuchcha assaannelchi ediki annuwwi inasa'neeki Gibtsee'ni fulleexxe yannanaa'ni ke'issine techchi qico'ni ani edo elobaaxxa assineemmaxxeenna mufatannoshsha ane assinemmaxxeeteni.»<verse eid="2KI 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 21:16" />Higgeeni Minaase Duuchchi Woddike Gootti edo elobaaxxa huje hunjaashsha Yihudaka arda dedhisemmaxxe cubbo gadho, Iyyerusaalemi'i kasakenaa'ni kasiini qico'ni heddo nage'iinke mannixxa munde dunne.<verse eid="2KI 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 21:17" />Minaase moyemmake baro'ni hujeexxa, wele yaanenna; hujeexxe cubboni welti asseexxi; hujeexxi huje duuchchi Yihudake moyyanjuwwike jirtetike maxaafa'ni borreessende hexxeexxebaata?<verse eid="2KI 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 21:18" />Minaasenna reye: «Uuzake hiddichchuwwiinke fichcha» hiyyemaaba mootummatike hiddichchiinke fichchi giddo moogeme. Belti isiki Amooninna isixxe bakaa'ni moye.<verse eid="2KI 21:18" /></para>
  <para style="s1">Yihudaki Moyanji Amooni</para>
  <para style="r">(<ref loc="2CH 33:21-25">2 Odo. 33:21-25</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 21:19" />Amooni moyee wodda wogga isixxi lame tommenna lametemmani Iyyerusaalemi ofo'leexxi lame wogga moye galche; ama isixxinna Mesolaamiti hiyyedaaxxeni; isenna Yaaxxibake bogixxe manjichcho Haaruusixxe beltommani.<verse eid="2KI 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 21:20" />Anni isiki Minaase assemmaxxa duuchcha isinna Duuchchi Woddike Gootti edo elobaaxxa yaane asse.<verse eid="2KI 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 21:21" />Anni isikika elobaaka adaba duuchcha hordofe: anni magenoonfatemmaka magenuwwa magenoofate, sagade.<verse eid="2KI 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 21:22" />Edike annuwwika Duuchchi Woddika Gootta Mageno waale; Duuchchi Woddike Goottike hiyyichchi'a ajajema gibe.<verse eid="2KI 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 21:23" />Amooniki ja'laabuwwi fuggoxxini iso'ni ke'e; mootummatike mini giddo isoo shinne.<verse eid="2KI 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 21:24" />Ookkoneechchi uduma bogiinki ardi moyanjo Amooni'ni fuggoxxini ke'emmaka duuchcha shinne; belto isika Iyyosiyaasinna bakka isixxe'ni mowaashsha assine.<verse eid="2KI 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 21:25" />Amooni moyemmake baro'ni asseexxi wele yaane duuchchi; Yihudake moyanjuwwiinke jirtetike maxaafa'ni borreessende afedaaxxebaata?<verse eid="2KI 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 21:26" />Isinna, Uuzake hiddichchiinke fichchi giddo hedheeke hirreessa'ni moogeme; belti isiki Iyyosiyaasi isixxe bakka'ni moye.<verse eid="2KI 21:26" /></para>
  <chapter eid="2KI 21" />
  <chapter number="22" style="c" sid="2KI 22" />
  <para style="s1">Seeriinki Maxaafi Afeme</para>
  <para style="r">(<ref loc="2CH 34:1-2">2 Odo. 34:1-2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 22:1" />Iyyosiyaasi moyee galchema sane wogga isixxi saddeetateman; iisnna galduma ifika assedheexxi Iyyeerusaalemi'i sase tommenna mitte wogga moye galche. Ama isixxinna Yidiida hiyyemaake Bootseqaatike qachcha'ni ilendeexxe Adaayaxxe beltoman.<note caller="-" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="JER 3:6">Erm. 3:6</ref>. </char></note><verse eid="2KI 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 22:2" />Iyyosyaasinna Duuchchi Woddike Gootti edo eloxxa yaane asse; middi'anna bita'i'a higebaani; anni isiki Daawwiti assemmaxxa duuchcha asse.<verse eid="2KI 22:2" /></para>
  <para style="s1">Mageniinke Seeri Maxaaf Afemeexxa</para>
  <para style="r">(<ref loc="2CH 34:8-28">2 Odo. 34:8-28</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 22:3" />Iyyosiyaasi moyemmake baro'ni tommenna saddeeta wogga'ni Meshulaamike beltik belti Atsaaliyake belto kadeeke mootumatike minike borreesanji Saafaani konneechchi butta hexxeexxa erga Duuchchi Woddike Goottike Galmibaa hiyya'ne ergee qici: <verse eid="2KI 22:3" /><verse number="4" style="v" sid="2KI 22:4" />«Galimiinxa hula heqqammakiiri ardakenaa'ni bukki assinemmaki maallaqi Duuchchi Woddike Goottike galma'ni aageeka maallaqa laakko'o'a qeesetike akeekisanjo Hilqiyaasibaa mari. <verse eid="2KI 22:4" /><verse number="5" style="v" sid="2KI 22:5" />Konne Galmiixxa huje towataashsha filemake manna'ni uunowwaali; insa'nenna Duuchchi Woddike Goottika galma qammachammake manni'a uunowwaali. <verse eid="2KI 22:5" /><verse number="6" style="v" sid="2KI 22:6" />Insa'nenna uunaaki mine ijaarammake kinjiinka mine ijaarammake kino qunqume giissammake manni'ateni. Ittani galminxe qammachchatixxa huje hujaakeeri'a kadaaka saanquwwanna bonce giissineexxa kino hirrowwaali. <verse eid="2KI 22:6" /><verse number="7" style="v" sid="2KI 22:7" />Hujisa'neeki manni addatemeeke manna kadeemmaxxe'e hitteeki maallaqi fuleexxa insa'ne'e qo'nisiyyo hasissabaani.»<note caller="-" style="x"><char style="xo" closed="false">22:7 </char><char style="xt" closed="false"><ref loc="2KI 12:15">2 Moy. 12:15</ref>.</char></note><verse eid="2KI 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 22:8" />Ookkoneechchi uduma borresanji Saafaani moyanjokenaa'ni borreesemeka ajaja Hiliqiya'niuwwe; Hiliqiyanna, «Seeriinka maxaafaqqa Duuchchi Woddike Gootike galmi giddo afenneni» hiyye uwwe; isinna aadhe haaseesse.<verse eid="2KI 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 22:9" />Ookkoneechchi uduma borreessanji Saafaani moyanjoke, «Ja'labuwwi atiki Duuchchi Woddike Goottike galmi giddo hedhemmaka maallaqa fulchiteeni; galmakanna towanta'ni hujisammake manni'a uune'eni» isoo hiyye.<verse eid="2KI 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 22:10" />Ookkoneechchi uduma, borreessanji Saafaani moyanjoke, «Umi qeeschchi Hilqiyaasi maxaafa ane'n uwwe'eni» hiyye kule. Saafaaninna moyanjoke maxaafa haaseesse.<verse eid="2KI 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 22:11" />Moyanjikinna seeriinke maxaafika hiyyichcho laqeexxi yaaddoti seemma ifixxa dare.<verse eid="2KI 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 22:12" />Ookkoneechchi uduma qeesichcho Hilqiyaasi'i, Saafaanika belto Ahiqaamii'i, Miikaka belto Akiboori'n, borreessanjo Safaaninna moyanji bira hedhe ergatemaammaka erganjo Assayaa'a hiyye ajajee qici, <verse eid="2KI 22:12" /><verse number="13" style="v" sid="2KI 22:13" />«Martineexxi anxe ardixxeenna Yihudake ardi duuchchixxee konne afemeeke maxaafi giddo mayi boreessemeexxa Duuchchi Woddika Gootta laqqe. Ediki annuwwi no'oki konne maxaafa'ni borreessemeeka seera heqqedhanna muuxa gonpheemmaxxe'e Duuchchi Woddiki Gootti insa'ne'ni mufate.»<verse eid="2KI 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 22:14" />Qeesichchi Hilqiyaasi, Ahiqaami, Akiboorinna, Saafaani, Assayanna, ookkone seemma heqamake Harihaasike beltika belto, Tiquwwaka belto, Seleemixxa are wabeetto Hildaana qodhdhino'a me'ine. Iseenna hexxammabi Iyyerusaalemi giddo langake ola'a'nitemmani.<verse eid="2KI 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 22:15" />Wabeekotinna hitee qici: «Isira'eelki Duuchchi Woddik Gootti Mageni Aniba'a ergitineeke manjichchi'a hitinaaqici, <verse eid="2KI 22:15" /><verse number="16" style="v" sid="2KI 22:16" />‹Duuchchi Woddik Goottinna Yihudaki moyanji haaseesseeke maxaafi giddo borreessendeexxa duuchcha konne booncho'ninna arda iseke'ni fuggoxxa yaane iyyedagannoni. <verse eid="2KI 22:16" /><verse number="17" style="v" sid="2KI 22:17" />Insa'ne ane'e waalleexxi wele magenuwwi'a hixaana gunbeemmaxxe: anga ifixxini hunjeexxi fakkuwwa duuchchi ane'e mufachchinseemmaxxe: mufe anxinna bira saxxaani malee'e qiiddabaani.› <verse eid="2KI 22:17" /><verse number="18" style="v" sid="2KI 22:18" />Duuchchi Woddika Gootta qodhatee ha'no ergeeke Yihudake moyanji'a hitinaa qici: ‹Duuchchi Woddiki Gootti Isira'eeliki Mageni laqqettexxe yaane'a hiyya'neexxi tenneten. <verse eid="2KI 22:18" /><verse number="19" style="v" sid="2KI 22:19" />Ha'no badinoteenna ba'netee geltineeke manna kandemmaxxe'e konne booncho'ni ifi salphisatanna ardake'ni haaso'ennexxa laqqete wodda godobi atee yo'emmaxxe, Duuchchi Woddike Gootti edo ifi salphissettaxxe, yaaddoti seemma atixxa darte ani edo ooxxettaxxe Duuchchi Woddiki Gootti laqeenneni hiyya'neeni. <verse eid="2KI 22:19" /><verse number="20" style="v" sid="2KI 22:20" />Tennexxe Iyyerussaalemi'i xixaanneka xixichcho illeti uuddebexxongi rertattoni; rertattoxxe'e xixabo'noni.› »</para>
  <para style="p" vid="2KI 22:20">Tennexxe ardikinna wabeekitte haasottemmaka hiissichcho moyanjoke'e marre kulle.<verse eid="2KI 22:20" /></para>
  <chapter eid="2KI 22" />
  <chapter number="23" style="c" sid="2KI 23" />
  <para style="s1">Iyyosiyasi Kako Haaroonse</para>
  <para style="r">(<ref loc="2CH 34:3-7">2 Odo. 34:3-7</ref>, <ref loc="2CH 34:29-33">29-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 23:1" />Ookkoneechchi uduma moyanji Yihudaxxanna Iyyerusaalemixxa geedhe duuchcha ye'e.<verse eid="2KI 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 23:2" />Yihudaka manna duuchcha, Iyyerusaalemike qachcha'ni hedha'neeka manna duuchcha, Qeesenna, wabeeko duuchcha, oosetenaa'ni lumollii qico'ni mitti manji gatebaangi aadheexxi Duuchchi Woddike Goottike galmiba'a dage. Duuchchi Woddike Goottike galmi giddi'ni afemeeka kakotike maxaafika hiyyichcho duuchcha mansha ifixxinni lanqo'a insa'ne'a haaseesse.<verse eid="2KI 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 23:3" />Moyanjikinna worqetixxe sooddo bira Duuchchi Woddike Gootti edo uurreexxi Duuchchi Woddika Gootta hordoffaaxxa ajajuwwa, seeruwwa, aaduwwa, mitte godobini, hedho duuchcha heqqedhaaxxa, konne maxaafa'ni borreessendeexxa kako jabeessaaxxanna Duuchchi Woddike Gootti edo kakotanna haaroonse. Ookkoneechchi uduma ardi duuchchi kakote'e afe'exxa addatensha kokeesse.<verse eid="2KI 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 23:4" />Moyanjikinna Ba'aali'a, Asheera'anna iimixxe urjuwwa duuchchi'a giissinemmaka la'onfantaaka miyuwwa duuchcha, Duuchchi Woddike Goottike galmi giddii'ni fulchinaashsha umo qeesichcho Hilqiyaasi'i, iso'ni aande hariirendemmaxxa qeesenna galmiinxa hula heqqammaka heqqanjuwwa ajaje. Miyuwakanna Iyyrusaalemi gadho Qediroonixxe dhooqake diida'ni gube bululokanna Beeteli'a aadhe me'e.<verse eid="2KI 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 23:5" />Yihudaka qachchuwwa'ninna Iyyerusaalemi qarqara'ni hedheeke tullichchuwwa'ni hixaana gunbo'a Yihudiinki moyanjuwwi hariiremmaka magenoonfantammaxxe fakkexxa qeese shorre ittani Ba'aali'a, arishshoteenna agenjokee, bukki hiteexxe urjuwwa'anna iimatixxe urjuwwa duuchchi'a hixaanna gunbammakaara fugusse.<verse eid="2KI 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 23:6" />Asheerixxe fakkexxa sooddo Duuchchi Woddike Goottike galmi giddi'ni fulcheexxi Iyyerusaalemi qachchi gadho hedheeke Qediroonixxe dhooqabaa'a aadhe me'exxi gube; bulleesse dayeexxi ardiinke hirreessa'ni xeere.<note caller="-" style="x"><char style="xo" closed="false">23:6 </char><char style="xt" closed="false"><ref loc="2KI 21:3">2 Moy. 21:3</ref>; <ref loc="2CH 33:3">2 Odo. 33:3</ref>. </char></note><verse eid="2KI 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 23:7" />Ittanni ege'nemebaaka mageno magenoonfachchotixxa aada, Duuchchi Woddike Goottike galmi giddo labbaki labbakinni weleti yabaabulammake galmi giddixxa kutuwwanna melaalle Asheerake mageni'a seemmatika golo giissito'a fuutta suqqammaxxa kutuwwa findige.<verse eid="2KI 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 23:8" />Iyyosiyaasi fakke magenoonfantammake minixxa qeese duuchcha Yihudake qachchuwwanaa'n Iyyerussaalemi'a iyyedage; Geba'i'n Berissaabehi qico'ni; qeese hixaana gubbammaka; tullichchuwwake'n magenoonfantammaka boonchuwwa duuchcha battoonse. Qachchinxe hulabaa'ni bita'i darre'ni; ookkone qachcha galchammake Iyyaasubaa e'yinammak kinjiinke dalla'ixxe hula bira magenoonfantammaka boonchuwwa diige bire.<verse eid="2KI 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 23:9" />Tullichchuwwake'ni magenoonfantamma boonchixxi qeese Iyyerusaalemi hedheeke Duuchchi Woddike Goottike tolchimalcho'ni tolcha shiqishabaashsha gonphoolenna midde; jaaluwwa insa'neexxe qeeseni welti gamami (irsho) e'yebaaxxa kebbo inda'nemmani.<verse eid="2KI 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 23:10" />Henoomixxe Dhooqa'ni hedheemmaka Toofeeti hinaaka magenoonfantammaka booncho battoonse; tennenna assechchi; huuni manjinna labbaka yookaani meyyaxxa belto ifixxa Moloki hina'neeke mageni'a ciincatike tolchi'a shiqishabaashshaten.<note caller="-" style="x"><char style="xo" closed="false">23:10 </char><char style="xt" closed="false"><ref loc="LEV 18:21">Lew. 18:21</ref>; <ref loc="JER 19:1-6">Erm. 19:1-6</ref>; <ref loc="JER 32:35">32:35</ref>. </char></note><verse eid="2KI 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 23:11" />Yihudak moyanjuwwi Duuchchi Woddike Goottike galmibaa e'yinammaxxe hula'ni arishsho magenoonfachchote'e uunemmaka fadhado oko'ni fugusse. Insa'nenna Naataani Meeleeki hiyyemaake mitte jalqabike mini bira weldeennate'ni he'nemmani. Iyyosiyaasinna arishsho magenoonfanto'a uuneemmaka fadhaduwwakanna hoyye; fadhadiinxa gaarenna gube.<verse eid="2KI 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 23:12" />Yihudak moyanjuwwi iimi darreke Akaazike mini bira iimike ba'lina'ni uurrisemmaka tolchimalcho, Minaasenna lamiinxe Duuchchi Woddike Goottike galmike ba'linna'ni giissemmaka tolchimalchuwwa enqe bire; enqemalchuwwakanna Qediroonixxe Dhooqa'ni hune.<verse eid="2KI 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 23:13" />Iittani Iyyrusaaleminaa'n boroti darre'ni batto'eeke tullichchibaa'ni bita'i darre'ni Asitaarooti hiyyemaake Sidoonake mageni'a, Kamooshi hiyyemaake Mo'aabike mageni'aanna Milkoomi hiyyemaake Amoonike mageni'a moyanji Solomooni giisiseemmaxxa battitte fakkuwwa duuchcha battootteexxe kaddeexxa kokeesse.<note caller="-" style="x"><char style="xo" closed="false">23:13 </char><char style="xt" closed="false"><ref loc="1KI 11:7">1 Moy. 11:7</ref>. </char></note><verse eid="2KI 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 23:14" />Higgeen moyanji Iyyosiyaas magenoonfantammaxxa kinjiinxa sooddo duuchcha butuchche bire: Asheera hinaaxxe mageniixxa sooddo wowwoxe bire; ettene bakka'ninna reyeeke mannixxa miqe tuule.<note caller="-" style="x"><char style="xo" closed="false">23:14 </char><char style="xt" closed="false"><ref loc="1KI 12:33">1 Moy. 12:33</ref>. </char></note><verse eid="2KI 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 23:15" />Isira'eeli'i dedhiseemmaki Naabaaxik belti Iyyorbi'aami hujiseemmaka tolchimalcho Beeteli hedhemmaka ookkonee tullichchuwwake'ni magenoonfatammaka booncho midde ittani findige; kinjuwwakanna butuchche bire, bulletishshanna asse. Asheeraxxa soodo gube.<verse eid="2KI 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 23:16" />Ookkoneechchi uduma Iyyosiyaasi qarqara uuda wodda, tullichchuwwake'ni hedheka hirreessuwa afe; miquwwatanna moongemmaxxe bale balenaa'ni fulchinaashsha asse; iikki Duuchchi Woddike Goottik manji edise haaso'emmashshani; Duuchchi Woddike Goottiki hiyyichchi muuxeemaashsha tolchimalcho battonso'a hiyyeexxi miquwwa hana gube.<note caller="-" style="x"><char style="xo" closed="false">23:16 </char><char style="xt" closed="false"><ref loc="1KI 13:2">1 Moy. 13:2</ref>. </char></note><verse eid="2KI 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 23:17" />Moyanjiikinna «Iikki hirreessi ayyike?» hiyye qore.</para>
  <para style="p" vid="2KI 23:17">Beetelik Qachchiinki manninna; «Yihudanaa'n dageexxi ta'a ati assitetexxa yaane duuchcha Beetelike tolchmalcho'ni geltaaxxa kuleeke ookkone Duuchchi Woddike Goottike manjike mooggoni» hiyye.<note caller="-" style="x"><char style="xo" closed="false">23:17 </char><char style="xt" closed="false"><ref loc="1KI 13:30-32">1 Moy. 13:30-32</ref>. </char></note><verse eid="2KI 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 23:18" />Iyyosiyaasinna «Kabanni waalle; isixxa miqe huuni manjinna kabaa'ni le'misabaashsha» hiyye.</para>
  <para style="p" vid="2KI 23:18">Tennexxee isixxanna Semaariya'n dageemmake wabeekixxa miqe tunqebangi walle.<verse eid="2KI 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 23:19" />Iyyosiyaasinna Beeteli assemmaxxa duuchcha Semaariyake qachchuwwike tullichchuwwa'ni hana Isira'eeliki moyanjuwwi hujisemmaxxanna Duuchchi Woddika Gootta mufachchinsemmaxxa magenoonfantammaxxe fakkeka booncho duuchcha battoonse. <verse eid="2KI 23:19" /><verse number="20" style="v" sid="2KI 23:20" />Iyyosiyaasi ookkone tullichchuwwa, tullichchuwwa'ni magenoonfantammake booncho'ni qeese duuuchcha; mitte mitte tolchimalchuwwi hana gorra'e bire; tolchimalchuwwake'ninna manjinxa miqe gube. Ookkoneechchi uduma Iyyerusaalemi'a hige.<verse eid="2KI 23:20" /></para>
  <para style="s1">Iyyosiyaasi Sa'atika Ayyaana Ulfeesseexxa (2 Odo. 35:1-19)</para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 23:21" />Moyanjikinna arda duuchcha «Konne kakotike Maxaafa'ni borreessendemmashshanni Duuchchi Woddika Gootta ha'nooke Magenika sa'atika ayyaanna ulfeesse» hiyye ajaje.<verse eid="2KI 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 23:22" />Isira'eeli'i akeekkammaxxe hayyooleke baronaa'ni ke'isse; Isira'eelikenna Yihudake moyanjuwwike baro duuchcha'ni iitta hedheeki Sa'atiki ayyaani haanonna ulfeesseme ege'nemebaani.<verse eid="2KI 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 23:23" />Iyyosiyaasi moyemmake baro'ni tommenna saddeetixxe wogga'ni kini kunni Sa'atiki ayyaani Iyyerusaalemi giddo Duuchchi Woddike Gootti'a ulfeesseme.<verse eid="2KI 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 23:24" />Higgeeni Iyyosiyaasi ekedha haaseessammaka, morammakaara, mini mini hadika magenuwwa, magenoonfantammaxxa fakkuwwa, ittani Yihudake'ninna Iyyerusaalemi'ni afendeexxa wele diqachchiissaaxxa yaanuwwa duuchcha fugusse bire. Tenneenna asseechchi qeesichchi Hilqiyaasi Duuchchi Woddike Goottike galmi giddii'ni afemaake maxaafa'ni borreessemeeki seeriinki hiyyichchi muuxemaashshateni.<verse eid="2KI 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 23:25" />Muuseke seera'n borreessendemmashshani mitte godobini, shenitte hedhoni, shenitte hunnani, Duuchchi Woddike Goottibaa higeeki Iyyosiyaasishsha hedheeki moyanji isi edi ga'manna kadi isi uduma hara afemebaani.<verse eid="2KI 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 23:26" />Yaane kinni Minaase hujeexxe fuggooxxe yaanexxe buuto'a Yihudake'ni bubbeexxi Duuchchi Woddike Goottixxi mufe ta'iqico'ni qiiddeemmabaani.<verse eid="2KI 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 23:27" />Tennexxe Duuchchi Woddik Gootti hiyyeeqici, «Isira'eel'i ifinaa'ni bayyisenneshshani Yihudakanna ani edii'ni bayyisannoni; ani fi'lenneka qachcha Iyyerusaaleminna ‹Summi anki ookko hedhaani› hiyye haaso'enneka konnee galma waalannoni» hiyye.<verse eid="2KI 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 23:28" />Iyyosiyaasi moyemmake baro'ni hujendeexxi wele huje; huje muuxeexxi duuchchi Yihudake moyanjuwwike jirtetike maxaafa'ni borreessende hexxeexxebaata?<verse eid="2KI 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 23:29" />Iyyosiyaasi moyemmake baro'ni Gibtsek moyanji Fari'ooni Nika'u, Asoorika moyanjo gargaaro'a Efiraaxisike galaaniba'a mareemmani; moyanji Iyyosiyaasinna lolakee fule; kaddoolenna Feri'ooni Nika'u mare loleexxi Megido hinaaba iso'o shiye.<verse eid="2KI 23:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 23:30" />Iyyosiyaasiki erganjuwwi Megido'n rensha isika fadhadinxe gaare'ni fe'exxi Iyyerusaalemi'a iyyedangeexxi moyanjuwwiinke hirreessa'ni moonge. Yihudiinki manninna Iyyosiyaasika belto Iyyo'akaazii'i filleexxi hariirre moyanjoke assine.<verse eid="2KI 23:30" /></para>
  <para style="s1">Yihudika Moyanjo Iyyo'akisi</para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 23:31" />Iyyo'akaazi Yihudake'ni moyee wodda wogga isixxinna lame tommenna sasetemman; isinna Iyyerusaalemi ofo'leexxi sase agenjo moye galche. Ama isixxinna Hamuuxxaal hinaaxxeni; isenna Libinake manjixxe Ermiyaasixxe beltommani.<verse eid="2KI 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 23:32" />Ediki annuwwi isiki assemmaxxa duuchcha isinna Duuchchi Woddike Gootti edo elobaaxxa yaane asse.<verse eid="2KI 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2KI 23:33" />Iyyerusaalemi ofo'leexxi galchabaashsha Feri'ooni Nika'u Hamaatike boga'ni Ribla hiyyemaake booncho'ni haachchabiki usureexxi; Yihudake'ni sase kumanna shoole dhibba kiilo birretika sibiljo, sase tommenna shoole kiilo worqe; irbo uwwaashsha asse.<verse eid="2KI 23:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 23:34" />Feri'ooni Nika'u Iyyosiyaasika belto Eliyaqemi'i anninxe Iyyosiyaasixxe bakka'n moye galchaashsha asse; summa isikanna Iyyo'aaqemite hiyye fulche. Yaane kinni Iyyo'akaazii'i booji'eexxi Gibtse'a adhdhe me'e isinna ookkooni reye.<verse eid="2KI 23:34" /></para>
  <para style="s1">Yihudika Moyanjo Iyyo'aqeemi'i</para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 23:35" />Iyyo'aaqemi Feri'ooni Nika'u hunnati laqemmaashsha worenna birretika sibiljo uwwe; tennee'e assate'e hunna hunnashanni irbo birretika sibiljonna worqe ardakenaa'n aadhe.<verse eid="2KI 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 23:36" />Iyyo'aaqemi moyee wodda wogga isixxinna lame tommenna ondetemman; Iyyerusaalemi ofo'leexxi tommenna mitte wogga mowe galche; ama isixxi Zebida Ruumake qachcha'n ilemeeke Fedaayaxxe beltomman. <verse eid="2KI 23:36" /><verse number="37" style="v" sid="2KI 23:37" />Iyyo'aqeemi siretiki annuwwi isik assemmashshanni isinna Duuchchi Woddike Gootti edo elobaaxa yaane asse.<verse eid="2KI 23:37" /></para>
  <chapter eid="2KI 23" />
  <chapter number="24" style="c" sid="2KI 24" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 24:1" />Iyyo'aaqemi moyemmake baro'ni Baabiloonik moyanji Naabukedenetsoori lole'e boga adhdhe; Iyyo'aaqeminna sase wogga irbo isi'a uwwe. Ookkoneechchi uduma yaada ifika jijjiireexxi Nabukedenetsoori'ni fuggoxxini ke'e.<note caller="-" style="x"><char style="xo" closed="false">24:1 </char><char style="xt" closed="false"><ref loc="JER 25:1-38">Erm. 25:1-38</ref>; <ref loc="DAN 1:1-2">Dan. 1:1-2</ref>. </char></note><verse eid="2KI 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 24:2" />Duuchchi Woddik Gootti Iyyo'aaqemi'ni Baabiloonika, Sooriyaka, Mo'aabitotanna Amoonito ole miidho'a erge; erganjuwwa ifixxe wabeeko darree'ni kulemeeke Duuchchi Woddike Goottike hiyyichchishshani Yihudaa'a biro'a konne manna erge.<verse eid="2KI 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 24:3" />Ifi edii'ni insa'ne bayyiso'a tenne yaanuwwa duuchcha Duuchchi Woddik Gootti ajajemmashshani Yihudake'ni dhugaaten muxemate dandeette'eni. Tinninna Minaase hujemmaxxe cubbo'anna assemaxxe duuchchi'ateni, <verse eid="2KI 24:3" /><verse number="4" style="v" sid="2KI 24:4" />ittanni Minaase qajeeli manjixxa munde dunemmaxxeeteni. Iyyerusaalemi'ni qajeeli mannixxi munde wo'mitaashsha assemmaxxe Duuchchi Woddik Gootti gattowwaali hiyyo'a hasebaani.<verse eid="2KI 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 24:5" />Iyyo'aaqemi moyemmake baro'ni hujendeexxi; wele huje muuxeexxi huje duuchchi Yihudake moyanjuwwike jirtetike maxaafa'n borreessende hexxeexxebaata?<verse eid="2KI 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 24:6" />Iyyo'aaqeminna reye, belti isik Ikooniyaaninna isixxe baka'ni moye.<verse eid="2KI 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 24:7" />Baabiloonik moyanji Gibtseke galaananaa'ni Efiraaxisike galaani qico'ni hedheeka boga isika adhdheemmaxxe; Gibtseki moyanji boga ifikenaa'ni langaxxa duulo fulebaani.<verse eid="2KI 24:7" /></para>
  <para style="s1">Yihudak Moyanji Yo'aakin (2 Odo. 36:9-10)</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 24:8" />Ikooniyaani moye wodda, wogga isixxi tommenna saddeetatemman; isinna Iyyerusaalemi ofo'leexxi sase agenjo mowe galche. Ama isixxinna Nehushita hiyyendaaxxeni; issenna Iyyerussaalemike manjixxe Elinaataani hiyyemaake manjixxe beltommani.<verse eid="2KI 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 24:9" />Anni isiki assemmashshanni isinna Duuchchi Woddike Gootti edo elobaaxxa yaane asse.<verse eid="2KI 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 24:10" />Eettene yanna'ni Baabiloonike moyanjiki Naabukedenetsoorik loliinke manniki ajajalluwwi Iyyerusaalemi'a dangeexxi elqe kayyii'ni bunqe.<verse eid="2KI 24:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 24:11" />Loliinke manniki ajajalluwwi erqe kayyii'ni buqee wodda Naabukedenetsoori umi ifinginnini Iyyerussaalemi'a dage.<verse eid="2KI 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 24:12" />Yihudak moyanji Ikooniyaani, ama isixxi, isinni me'ammaki ulfeessemeeki ja'laabuwwinna jalqabuwwi Baabiloonike moyanji'a anga uune. Baabilooniki moyanji moyemmaxxe saddeetixxe wogga'ni Yo'aakini'i booji'e adhdhe me'e.<note caller="-" style="x"><char style="xo" closed="false">24:12 </char><char style="xt" closed="false"><ref loc="JER 22:24-30">Erm. 22:24-30</ref>; <ref loc="JER 24:1-10">24:1-10</ref>. </char></note><verse eid="2KI 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 24:13" />Duuchchi Woddik Gootti edi wodda haaso'emmashshani Nabukedenetsoori Duuchchi Woddike Goottike galmi giddixxanna mootummatike minixxa karra duuchcha bukki asse fe'edhe adhdhe me'e. Isira'eeliki moyanji Solomooni Duuchchi Woddike Goottike galmi'a hujisemmaka worqetika miyuwwa duuchcha adhdhe.<verse eid="2KI 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 24:14" />Higgeeni Iyyerusaalemika arda hedhemmashshani loliinka manna ajajammakaaranna, loliinka manna duuchcha; angatixxe oge ege'nemmakaranna sibilo tumammaka duuchcha; lebeexxi mitteba tomme kuma manna booji'eexxi ifike bogiba'a adhdhe me'e. Ookko'o gateeki hiyyeeyye manna callammani.<verse eid="2KI 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 24:15" />Naabukedenetsoor Ikooniyaanii'i ooji'eexxi Baabilooni'a adhdhe me'e; ittaani moyanjiinxa ama, aruwwa isixxa, Ja'laabuwwa isikanna bogi giddo ege'nemeeka lumollamma mannanna Iyyerusaalemi'ni Babillon'a adhdhe me'e.<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="EZK 17:12">Hiz. 17:12</ref>. </char></note><verse eid="2KI 24:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 24:16" />Higgeeni Baabiloonik moyanji jajabba lola dande'aaka torbaane kuma loliinka manna, mitte kuma angatixxa oge muuxeekanna sibilo tumammakaara booji'eexxi Baabilloon'a adhdhe me'e.<verse eid="2KI 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 24:17" />Ookkoneechchi uduma Yo'aakinike annika dayyo Maataaniyaanii'i isixxa bakka moyashsha asse; summa isikanna Sedeqiyaasi hiyye fulche.<note caller="-" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="JER 37:1">Erm. 37:1</ref>; <ref loc="EZK 17:13">Hiz. 17:13</ref>. </char></note><verse eid="2KI 24:17" /></para>
  <para style="s1">Yihudiinka Moyanjo Sedeqiyaasi</para>
  <para style="r">(<ref loc="2CH 36:11-16">2 Odo. 36:11-16</ref>; <ref loc="JER 52:1-3">Erm. 52:1-3</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 24:18" />Sedeqiyaasi moye wodda wogga isixxi lame tommenna mittetemmani; isinna Iyyerusaalemi ofo'leexxi tommenna mitte wogga moye galche. Ama isixxininna Hamuuxxaali hinaaxxemmani; isenna Libinake manjixxe Ermiyaasixxe beltommani.<note caller="-" style="x"><char style="xo" closed="false">24:18 </char><char style="xt" closed="false"><ref loc="JER 27:1-22">Erm. 27:1-22</ref>; <ref loc="JER 28:1-17">28:1-17</ref>. </char></note><verse eid="2KI 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 24:19" />Iyyo'aaqimi assemmaxxa duuchcha; isinna Duuchchi Woddike Gootti edo elobaaxxa yaane asse.<verse eid="2KI 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 24:20" />Yooni tinni duuchchi Iyyerusaalemi'ninna Yihudake'ni geya dandeetteeki Duuchchi Woddik Gootti mufatemmaxxe'e insa'ne'e ifi edii'ni bayyise.</para>
  <para style="s1" vid="2KI 24:20">Iyerussaalemixxa Iba</para>
  <para style="p" vid="2KI 24:20">Ettenee yanna Sedeqiyaasi Baabiloonike moyanjo'ni fuggoxxini ke'e.<note caller="-" style="x"><char style="xo" closed="false">24:20 </char><char style="xt" closed="false"><ref loc="EZK 17:15">Hiz. 17:15</ref>. </char></note><verse eid="2KI 24:20" /></para>
  <chapter eid="2KI 24" />
  <chapter number="25" style="c" sid="2KI 25" />
  <para style="s1">Naaphiinxe Anga'n Iyyerssaalmixxa Iba</para>
  <para style="r">(<ref loc="2CH 36:13-21">2 Odo. 36:13-21</ref>; <ref loc="JER 52:3-11">Erm. 52:3-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 25:1" />Yihudiinki moyaji Sedeeqiyaasi moyemmake baro'n sallanixxe woggake tommike agenjixxe tomme barra'ni Baabiloonik moyanji Naabukedenetsoorinna ifika loliinka manna adhdheexxi Iyyerusaalemi'n duule; qachchinke dalla'i gadho booncho giissedhe ofo'le; qarqara duuchcha'ni buttina iimi'a tullube erqe kayii'ni buqe.<note caller="-" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="JER 21:1-10">Erm. 21:1-10</ref>; <ref loc="JER 34:1-5">34:1-5</ref>; <ref loc="EZK 24:2">Hiz. 24:2</ref>. </char></note><verse eid="2KI 25:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 25:2" />Qachchikinna Sedeqiyaasi moyemmake bari qico'ni tommenna mitte wogga'a erqe kayyi'ni buqeme hedhemmani. <verse eid="2KI 25:2" /><verse number="3" style="v" sid="2KI 25:3" />Sholgake agenjixxe sallanixxe barra'n qachchi giddo jabaki solo'i e'yemmaxxe ardi itaachcho gophe.<verse eid="2KI 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 25:4" />Baabilooniki manni qachchiinka dalla'a enqe e'yee; Baabiloonik manni qachcha buqoolenna midde Isira'eelik loliinki manni duuchchi moyanjiinke hiddichchiinke fichchi bira hedheeke lame dala hexxeexxe hulanaa'ni fulleexxi hashshati baanje; baanjeebinna Yordanoosixxe dhooqaba'aatemmani.<note caller="+" style="f"><char style="fr" closed="false">25:4 </char><char style="ft" closed="false">yookaan Areba darre'n</char></note><note caller="-" style="x"><char style="xo" closed="false">25:4 </char><char style="xt" closed="false"><ref loc="EZK 33:21">Hiz. 33:21</ref>. </char></note><verse eid="2KI 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 25:5" />Kaddo malee kinni Baabilooniki loliink manni moyanjo hordofeexxi Iyyaarikoke diida'n dhaqqabe; isik loliink manni isonaa'n gargar higeexxi xexxeereme'emman. <verse eid="2KI 25:5" /><verse number="6" style="v" sid="2KI 25:6" />Insa'ne moyanjokanna abindeexxi eettenne yanna'nini Baabiloonik moyanji hedheeba Ribla iso'o iyyedangeexxi murte iso'n murre. <verse eid="2KI 25:6" /><verse number="7" style="v" sid="2KI 25:7" />Sedeqiyaasi ille ifixxini uudaa'naani oose isixxa isi edo shinne; ookkoneechchi uduma lamiinxa ille isixxanna giddi'n fulchine; sageettotike haachchabinni usurreexxi Baabilooni'a adhdhine me'ine.<note caller="-" style="x"><char style="xo" closed="false">25:7 </char><char style="xt" closed="false"><ref loc="EZK 12:13">Hiz. 12:13</ref>. </char></note><verse eid="2KI 25:7" /></para>
  <para style="s1">Woyyichchi Galmxa Diigensha</para>
  <para style="r">(<ref loc="JER 52:12-33">Erm. 52:12-33</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 25:8" />Baabiloonik moyanji Naabukedenetsoori moyeexxe tommenna sallaane wogga'ni ondike agenjixxe torbaxxe barra'n Baabiloonike moyanjiki ulfeessemeeke heqqanjuwwiki ajajaallinna Baabiloonike moyanjike Ja'laaba kade'eki Nabuzardaani Iyyerusaalemi'a dage.<verse eid="2KI 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 25:9" />Isinna Duuchchi Woddike Goottika galma, moyanjiinka mootummatika minenna Iyyerusaalemi hedheeka minuwwa duuchcha gube; mitte mittenga lumollamma kinjiki ijaarremmeke mine'ni giira wore. <verse eid="2KI 25:9" /><verse number="10" style="v" sid="2KI 25:10" />Ulfeessemeeke isike heqqanjuwwike ajajallinni welti hedhemmaki Baabilooniki loliinki manni duuchchi Iyyerusaalemike qarqara'ni hedhemmaka qachchiinka dalla'a duuchcha diinge.<verse eid="2KI 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 25:11" />Ulfeessemeeke heqqanjuwwik ajajalli Nabuzardaani qachchi giddo gate'emmaka mannanna Baabiloonike moyanjiba'a me'emmaka manna duuuchcha, wele gateeka mannanna Baabilooni'a booji'e adhdhe me'e.<verse eid="2KI 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 25:12" />Yaane kinni heqqanjuwwiinki ajajalli bogiinke mannanaa'n mittelcho affebaaxxa hiyyeeyye woyinetika hiddichcho kaansaashsha, fichcha hunjaashsha ookooni waalle.<verse eid="2KI 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 25:13" />Baabiloonik maninninna sageettotika utuphuwwa, galmi giddo mole afeeka miya masse'naachchuwwanna sageettoti hunjeeka wode'e ca'minaaka gonga butuchchineexxi sageettotanna Baabiloon'a adhdhine me'ine.<note caller="-" style="x"><char style="xo" closed="false">25:13 </char><char style="xt" closed="false"><ref loc="1KI 7:15-26">1 Moy. 7:15-26</ref>; <ref loc="2CH 3:15-17">2 Odo. 3:15-17</ref>. </char></note><verse eid="2KI 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 25:14" />Iittanni odolchuwwa faafasujjo, bululo aa'namalchuwwanna mooqquwwa, wele sageettotike sibiljini giissineeka galmi giddo la'o uwwammaka miyuwwa duuchcha adhdhine.<note caller="-" style="x"><char style="xo" closed="false">25:14 </char><char style="xt" closed="false"><ref loc="1KI 7:45">1 Moy. 7:45</ref>; <ref loc="2CH 4:16">2 Odo. 4:16</ref>. </char></note><verse eid="2KI 25:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 25:15" />Ulfeessemeeke heqqanjuwwiki ajajalli ca'itte worqenninna birretike sibiljini hujendeexxa, hixaana gunbaakanna, hubuqqitte qoruwwa adhdhe.<verse eid="2KI 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 25:16" />Solomoon Duuchchi Woddike Goottike galmi'a hujeeka sageetoti giissiseeka lame utupha, wode'e camaaka gonganna mole afeemmaka miyuwwa hana uggemmalchcho aadhe; konne miyuwwi duuchchi'a kiila dandeesisaakemmaba'a.<verse eid="2KI 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 25:17" />Mitte mitte utuphiki qeerinni tommenna saddeeta ciqile kadaa wodda, guutote'ni sageettotixxa bokko afe'eemmakemman; bokkotiki qeerrinninna sase ciqile kadaa wodda; qarqari duuchchi sageettotike sibiljixxe marabenna roomaanetixxe gumuuwwa fakkaata'nemmani; weli utuphinna konneni welti weli fakkaata'nemmani.<verse eid="2KI 25:17" /></para>
  <para style="s1">Yihudak Moyanjuwwi Baabilooni'a Booji'emeexxa</para>
  <para style="r">(<ref loc="JER 52:24-27">Erm. 52:24-27</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 25:18" />Ulfeessemeeke heqqanjuwwiki ajajalli umo qeesichcho Serayaa'a, iso'ni langaba aanaaki qeesichcho Sofoniyaasinna sasiinga hulatika heqqanjuwwa usuro'a aadhe me'e.<verse eid="2KI 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 25:19" />Ettene yanna qico'ni, qachchi giddo gatemmakinna, loliinke mannika ajajallonna onde moyanjiki mari'atammaka manna adhdhe me'e. Higgeeni boginke ardanaa'ni lolake duulaaka manna mellammaka; loliinke mannika ajajallo; borreessanjokanna qachchi giddo afemeeka, borreessanjiinka jaane tomme manna adhdhe me'e.<verse eid="2KI 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 25:20" />Loliinke manniki Ajajalli Nabuzardaaninna konne manna duuchcha aadheexxi Ribla hedheeke Baabiloonike moyanjiba'a Nabukedenetsooriba insa'ne iyyemare.<verse eid="2KI 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 25:21" />Moyanjikinna manna Hamaatike boga'n ookkonni Ribla giddo shilchiise. Yihudak ardinna konne qicinni ifike boganaa'n booji'eme me'e.<verse eid="2KI 25:21" /></para>
  <para style="s1">Godoliyaasi Yihudake Moyanjo Kadeexxa</para>
  <para style="r">(<ref loc="JER 40:7-9">Erm. 40:7-9</ref>; <ref loc="JER 41:1-3">41:1-3</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 25:22" />Baabiloonik moyanji Naabukedenetsoori Saafaanika akka'o Ahiqaamika belto Godoliyaasi booji'emebaak gatemmake Yihudake ardike akeekisanjo asse baalloonse.<verse eid="2KI 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 25:23" />Duuchchiing loliinke manniki sooresuwwinna insa'neeki manni Baabiloonik moyanji Gedaliyaa'a galchanjoke assee hariireexxa lanqeexxi Mitsipha Godoliyaasibaa dange. Insa'nenna Netaaniyak belti Isima'eeli, Qaareehak belti Yohanaani, Nexoofichcho Tanihumeetik belti Seraaya, Ma'ikak belti Yezaaniyatemmani.<verse eid="2KI 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 25:24" />Godoliyaasinna insa'nenna loliinka insa'neeka manna hiyyee qici, «Baabiloonika ja'laabuwwa sodaattinoqee; konne boga'ninni hedhdhe; Baabiiloonike moyanji'a ergateme; duuchchiinxi yaane ha'no'a qajeeldaani» hiyyeexxi kakate.<verse eid="2KI 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 25:25" />Yaane kinni torbaake agenjo'n moyanjiinxe sanne kadeemmaka Elishaama'ike beltike belto kadeek, Netaaniyak belti Isima'eeli, tomme manninni dageexxi Godoliyaasinna Mitsipha isinni welti hedhemmaka Yihudakanna Baabiloonika manna shiye.<verse eid="2KI 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 25:26" />Baabiloonika manna sodaantemmaaxxe lumo shiixxoke hiyyebaaki ardi duuchchi looliinke mannike ajajalluwini welti Gibtse'a baaje.<note caller="-" style="x"><char style="xo" closed="false">25:26 </char><char style="xt" closed="false"><ref loc="JER 43:5-7">Erm. 43:5-7</ref>. </char></note><verse eid="2KI 25:26" /></para>
  <para style="s1">Yo'aakini Usurrakenaa'ni Tikeme</para>
  <para style="r">(<ref loc="JER 52:31-34">Erm. 52:31-34</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 25:27" />Yihudak moyanji Yo'aakini booji'emeexxe sase tommenna torbaane woggaxxe, tommenna langake agenjo'ni, ookkone agenjixxe lame tommenna torbaane barra'ni Yoormaroodeki Baabilooni'ni moyeexxe woggaa'ni Ikooniyaanii'i usurrakenaa'ni tike.<verse eid="2KI 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 25:28" />Isoonna shaqqunteti haasesee Baabilooni isini welti hedhemmake moyanjuwwi caala; lumoka ulfinniinka booncho isi'a uwwe.<verse eid="2KI 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 25:29" />Yo'aakininna usurriinke mi'ne'n oddo'wemmaxxa seemmanna jijjiidhdhe; <verse eid="2KI 25:29" /><verse number="30" style="v" sid="2KI 25:30" />Yo'akiminna hedheeke baro duuchcha'n duuchchi wodda moyanjiinxe qorenaa'ni ita'nemmani.<verse eid="2KI 25:30" /></para>
  <chapter eid="2KI 25" />
</usx>