<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Gedeo Bible</book>
  <para style="h">Imbaqqomikaa Raaga</para>
  <para style="toc1">Imbaqomikaa Raaga</para>
  <para style="toc2">Imbaqomikaa Raaga</para>
  <para style="toc3">Imb.</para>
  <para style="mt1">Inbaaqoomikaa Raaga</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Konne maxaafixxi edisaaxxi lame hafuura adhdhaar Inbaaqoomixxenna Magenixxe oddo'n assemeeke haaso'uwwan; Inbaaqoomi Yihudak giddo dhugaa dabbeexxanna assendemmaxxe fuggoxxa gibe. Magenikinna Babiloonito Yihudaka arda «Mura woxinsaan» hiyye hiisse haaso'e. Ookkonneechchi uduma kinni Inbaaqoomi Babiloonito Yihudake ardi caala cubbaaleyyete kaddeemmaxxee hitta Mageni Babilooniki ardi Yihudaka arda mura woxisaashsha anga insa'neexxe'n sa'isse uwwa? Hiyyeexxi Duuchchi Woddika Gootta qore. Duuchchi Woodiki Goottinna Inbaaqoomike qortumi'a hiissichcho Babiloonik ardinna badoti edi'a mura woxaan hiyyeexxi hiise haaso'e.</para>
  <para style="ip">Konne maxaafixxi udu'mitaaxxe hafuura adhdha'n Inbaaqoomi Duuchchi Woddike Goottike ulfinnixxeenna isike baalloomixxee galata shiqiseexxe soodachchoni.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Inbaaqoomixxa Aallachchonna Duuchchi Woddike Goottika Hiissichcho <char style="ior"><ref loc="HAB 1:1-2:4">1:1—2:4</ref> </char></para>
  <para style="io1">Fuggaaleeyyete'n murendeexxa Murte <char style="ior"><ref loc="HAB 2:5-20">2:5-20</ref> </char></para>
  <para style="io1">Inbaaqoomixxa Soodachcho <char style="ior"><ref loc="HAB 3:1-19">3:1-19</ref> </char></para>
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />Wabeekichcha Inbaaqoomi'n leellat uwwemeek hiyyichchi konneechchi butta hedheeken.<verse eid="HAB 1:1" /></para>
  <para style="s1">Inbaaqoomixxa Aallachcho</para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 1:2" />Duuchchi Woddike Goottaa! Gargaartota'a atee ye'edheenne; haanote hiissichcho ani'a uuttattok?</para>
  <para style="q1" vid="HAB 1:2">«Fuggo assa birasaxxe» hiyye atibaa raarannen</para>
  <para style="q2" vid="HAB 1:2">haanote anee anjirtattok?<verse eid="HAB 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 1:3" />Mayee balleessa assendaa wodda uudannoshsha assitete?</para>
  <para style="q2" vid="HAB 1:3">Hitata fuggoxxi hujendaa wodda sammitete?</para>
  <para style="q1" vid="HAB 1:3">Ba'netanna xaqaro uudaane;</para>
  <para style="q2" vid="HAB 1:3">lolikinna welgonphe bira saxxeen;<verse eid="HAB 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 1:4" />Tennexxe seeri lufe'een;</para>
  <para style="q2" vid="HAB 1:4">dhuagaa muratinna gorte'een;</para>
  <para style="q1" vid="HAB 1:4">Dhugaa muratinna gorto'a</para>
  <para style="q2" vid="HAB 1:4">fuggaaleeyye qulliyye buqqe'een.<verse eid="HAB 1:4" /></para>
  <para style="s1">Duuchchi Woddik Goottika hiissichcho</para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 1:5" />«Ha'no'ni kulendee'na midde</para>
  <para style="q2" vid="HAB 1:5">amandinabaaxxa</para>
  <para style="q1" vid="HAB 1:5">Ha'noke barro'n mitte yaane assa'annexxee</para>
  <para style="q2" vid="HAB 1:5">Kunnse konnee gosa gosaka arda uudde; uudina'neexxe yaane duuchcha'ninna</para>
  <para style="q2" vid="HAB 1:5">hara mambe'a hiyye.<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ACT 13:41">Erga. Huj. 13:41</ref>. </char></note><verse eid="HAB 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 1:6" />Ifike kadebaake galdumixxa bakka abixatee</para>
  <para style="q2" vid="HAB 1:6">butta duuchcha'n me'aaka</para>
  <para style="q1" vid="HAB 1:6">Godoba jabakikanna wiinamaaka</para>
  <para style="q2" vid="HAB 1:6">Baabiloonika manna ke'isanon<verse eid="HAB 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 1:7" />Insa'nenna sodachchisaakenna alalishaake mannani;</para>
  <para style="q2" vid="HAB 1:7">insa'ne ifika ulfinna heqinsaaka seera ifi'a fulchinaan.<verse eid="HAB 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 1:8" />Fadhadi insa'nek qeedhanichchi caala qolchaakeeraan;</para>
  <para style="q2" vid="HAB 1:8">hashshixxe yayye caalanna godoba jabakeeraan.</para>
  <para style="q1" vid="HAB 1:8">Insa'nek fadhado gulfaammaki manninna yo'oshsha qolchisaan;</para>
  <para style="q2" vid="HAB 1:8">insa'nenna bayyike boginaa'n dangaan;</para>
  <para style="q1" vid="HAB 1:8">Bultee itatee wiinammamake risishsha phirrinsaan.<verse eid="HAB 1:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="HAB 1:9" />Duuchching xaqarote ka'le dagaan.</para>
  <para style="q2" vid="HAB 1:9">Sannachchi insa'neek qiilla gammoojjexxe diidaloshsha</para>
  <para style="q2" vid="HAB 1:9">edi'a dhuqqisaan.</para>
  <para style="q2" vid="HAB 1:9">Booji'emee manna maanchuffa bukk assinaan.<verse eid="HAB 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 1:10" />Insa'nenna moyanjo tuffantaan</para>
  <para style="q2" vid="HAB 1:10">galchalluwwake'ninna gacifantaan;</para>
  <para style="q1" vid="HAB 1:10">Kolliffachcho duuchcha'n ossolaan;</para>
  <para style="q2" vid="HAB 1:10">buttinna itti tulluuba'ninna tennee kollifachchuwwanna abixxinaan.<verse eid="HAB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 1:11" />Ookkoneechchi uduma diidalotishsha sa'ne me'inaan</para>
  <para style="q2" vid="HAB 1:11">hunna ifixxa mageno assedhaak balleesanjuwwan.»<verse eid="HAB 1:11" /></para>
  <para style="s1">Inbaaqoomixxa Langaxxa Aallachcho</para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 1:12" />Ee dada duuchchike Gootta ati duuchchi woddinaa'ninni hexxetengebaata?</para>
  <para style="q2" vid="HAB 1:12">Anke Magenoo anke woyyichchaa no'o rennabe'non;</para>
  <para style="q1" vid="HAB 1:12">Ee dada duuchchike Goottaa ati insa'ne murrashsha baallonsite'eeten;</para>
  <para style="q2" vid="HAB 1:12">ee rassaa no'oo mura woxinso'a insa'ne'a baalloonsite'een.<verse eid="HAB 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 1:13" />Ille atixxi fuggoxxa uudabaashsha hara hoyyittete;</para>
  <para style="q2" vid="HAB 1:13">fuggoxxi assendaa'na uuda atinni me'itaba'a;</para>
  <para style="q1" vid="HAB 1:13">Hittata tennee xaqartiyye sammi hittatto?</para>
  <para style="q2" vid="HAB 1:13">Fuggichchi manji isi caala qullichchake kade'eeka liqinsaa woddata mayee sammittato?<verse eid="HAB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HAB 1:14" />Ati manna wodi'i giddo hexxeexxe qulxu'muwwashsha</para>
  <para style="q2" vid="HAB 1:14">galchaaka affebaaxxe wodi'i giddixxe dadashsha assitette.<verse eid="HAB 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 1:15" />Fuggichchi naaphi insa'ne duuchchiinga malxaqoti fulchaan;</para>
  <para style="q2" vid="HAB 1:15">marabeti isa'nenna abidaan;</para>
  <para style="q1" vid="HAB 1:15">Tuu'laachchi giddonna insa'nee bukki assedhaan;</para>
  <para style="q2" vid="HAB 1:15">tenne'ninna gammadaani, ililisaan.<verse eid="HAB 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 1:16" />Ita isixxinna ha'yoke kaddemmaxxeenna</para>
  <para style="q2" vid="HAB 1:16">isenni fenxe hiyya'n hedhammaxxee</para>
  <para style="q1" vid="HAB 1:16">Tennexxee ifixxe marabe'a tolchaan;</para>
  <para style="q2" vid="HAB 1:16">itti bukki assedhamachchi'anna hixaana gubaan.<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="2KI 24:2">2 Moy. 24:2</ref>. </char></note><verse eid="HAB 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HAB 1:17" />Marabe ifixxa duuchchi wodda fayya'ni</para>
  <para style="q2" vid="HAB 1:17">gosa gosaka arduwwa mararte belo bira'n hedhaata?<verse eid="HAB 1:17" /></para>
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="q1">
    <verse number="1" style="v" sid="HAB 2:1" />Heqqecatixxe Anxe bakka'n uurrannon</para>
  <para style="q2" vid="HAB 2:1">dalla'iinxe guuto hana hedhannon;</para>
  <para style="q2" vid="HAB 2:1">ane'n maa hiyyaaxxa</para>
  <para style="q1" vid="HAB 2:1">Tenne aallachcho'anna,</para>
  <para style="q2" vid="HAB 2:1">maa hiissichcho uwwaxxa uudona'a heqqedhannen.<verse eid="HAB 2:1" /></para>
  <para style="s1">Duuchchi Woddike Goottika Hiissichcho</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2" />Duuchchi Woddik Goottinna hiyya'ni hiisse haaso'ee qici:</para>
  <para style="q1" vid="HAB 2:2">«Shollake orinni haasessendaashsha tennee,</para>
  <para style="q2" vid="HAB 2:2">leella borreessi;</para>
  <para style="q2" vid="HAB 2:2">bidiroke'n isee qunqumati borreessi.<verse eid="HAB 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 2:3" />Tinni leellanna ise'a murendeexxa yanna heqqexxaan</para>
  <para style="q2" vid="HAB 2:3">muuxamiinxanna haasottaan</para>
  <para style="q2" vid="HAB 2:3">ise dharakanna haasotabaan</para>
  <para style="q1" vid="HAB 2:3">Turtaaxxe labboolenna heqqedhi;</para>
  <para style="q2" vid="HAB 2:3">daga isexxinna dhugaaten turtabaan.<note caller="-" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="HEB 10:37">Ibr. 10:37</ref>. </char></note><verse eid="HAB 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HAB 2:4" />«Kunnise isi ifi dukeedheen;</para>
  <para style="q2" vid="HAB 2:4">halcha isixxi qajeeldabaan</para>
  <para style="q2" vid="HAB 2:4">qullichchi kinni qulumma ifixxenninni hedhaan.<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="ROM 1:17">Rom. 1:17</ref>; <ref loc="GAL 3:11">Gel. 3:11</ref>; <ref loc="HEB 10:38">Ibr. 10:38</ref>.</char></note><verse eid="HAB 2:4" /></para>
  <para style="s1">Fuggaaleeyyetixxa Iba</para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 2:5" />Dhugaaten woyinetixxi booka isoo dedhise'een;</para>
  <para style="q2" vid="HAB 2:5">isi hollameessaken; ijje shookabaan;</para>
  <para style="q1" vid="HAB 2:5">Buttini giddike wiiddishsha donnaken;</para>
  <para style="q2" vid="HAB 2:5">reyotishsha hara goddakebaan</para>
  <para style="q2" vid="HAB 2:5">gosa gosaka ardanna ifibaa bukki assedhaan</para>
  <para style="q2" vid="HAB 2:5">manna duuchchanna lolee booji'ee adhdhaan.<verse eid="HAB 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HAB 2:6" />«Eega iitta hedheeke manjo'n cee'miyyotinna iso'ni gacifatit,</para>
  <para style="q1" vid="HAB 2:6">«Mooremeeka miya ifi'a tuu'lati</para>
  <para style="q2" vid="HAB 2:6">ifi duroonsakee aanne!</para>
  <para style="q2" vid="HAB 2:6">Tinninna haani qici'a kadda'ni hexxaaxxe?» hiyya'n Manji duuchchi isoo mammakabaata?<verse eid="HAB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 2:7" />Hidake'n ibissetak manni keekkatendebaaxxe yanna'n ate'n ke'abaata?</para>
  <para style="q2" vid="HAB 2:7">Ate'n qophpi hiyyeexxi atee sodaachchisabaata?</para>
  <para style="q2" vid="HAB 2:7">Atinna anga insa'neexxe'n ibbaton.<verse eid="HAB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 2:8" />Atinna heddo gosa gosaka arda saandetaxxee,</para>
  <para style="q2" vid="HAB 2:8">manjiinxa munde dundetaxxee</para>
  <para style="q2" vid="HAB 2:8">gateek ardinna atee saamaan;</para>
  <para style="q1" vid="HAB 2:8">Ookkone boguwwake'ninna ookkone qachchuwwi giddo hedhammaka duuchchinga birteeten.<verse eid="HAB 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 2:9" />«Seeri beloxxe la'onn galduma ifika ijaadhaak</para>
  <para style="q2" vid="HAB 2:9">naaphiinxe anganaa'n,</para>
  <para style="q2" vid="HAB 2:9">gatatee mine ifika iima qephphichcha booncho'n ijaadhaakee isi'a aanne'e!<verse eid="HAB 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 2:10" />Heddi mannixxi lubbo baxxo'a fuggoxxe'ni kexxeeten;</para>
  <para style="q2" vid="HAB 2:10">ati ifike mine'n salphinne, umo atike'ninna ba'ne iyyedageeten.<verse eid="HAB 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 2:11" />Kinjikinna gimo giddii'n raraan</para>
  <para style="q2" vid="HAB 2:11">haqqeti minik utuphinniki dagalsanjuwwinna tenneenni hiyyaan.<verse eid="HAB 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="HAB 2:12" />«Manjo shiyati qachcha ijaaraakee isi'a aanne'e</para>
  <para style="q2" vid="HAB 2:12">seeri belo orinninna isoo giisaakee isi'a aanne!<verse eid="HAB 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 2:13" />Ardi giiratixxe haqqe kado'a eloo'o'a</para>
  <para style="q2" vid="HAB 2:13">gosa gosak ardinna tola kurbu hiyyaashsha</para>
  <para style="q2" vid="HAB 2:13">dada duuchcha ajajaak Duuchchi Woddik Gootti mure'ebaata?<verse eid="HAB 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 2:14" />Wodi'i abbaayya buqammashshanni</para>
  <para style="q2" vid="HAB 2:14">Duuchchi Woddik Goottika gaachchanna ege'na buttate'n wo'mita.<note caller="-" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="ISA 11:9">Isa. 11:9</ref>. </char></note><verse eid="HAB 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HAB 2:15" />«Insa'neka saala uudatee</para>
  <para style="q2" vid="HAB 2:15">jaaluwwa ifika hawwisaake</para>
  <para style="q2" vid="HAB 2:15">machchonaa qico'ninna insa'ne'a woyine cossaakee isi'a aanne'e!<verse eid="HAB 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 2:16" />Ulfaattatixxa bado salphinne godditaton;</para>
  <para style="q2" vid="HAB 2:16">ta'a bado atixxe kaddemmaxxee ha'wi, saali atikinna leellowwaal</para>
  <para style="q1" vid="HAB 2:16">Duuchchi Woddik Gootta'ni hexxeexxi buuda ate'ni higgaan;</para>
  <para style="q2" vid="HAB 2:16">gaachchanna atikanna salphinnik buqaan.<verse eid="HAB 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 2:17" />Libaanoosi'n hujjetaxxi xaqaro ate'ni geltaan;</para>
  <para style="q2" vid="HAB 2:17">hore biniincha bira atixxi atee alalshitaan</para>
  <para style="q1" vid="HAB 2:17">Manjiinxa munde dundetaxxee</para>
  <para style="q2" vid="HAB 2:17">ookkone boguwwanna ookkone qachchuwwi giddo hedheeke duuchchininni balleessite'eten.<verse eid="HAB 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="HAB 2:18" />«Manjiixxi anga giissiteexxi misle</para>
  <para style="q2" vid="HAB 2:18">dharakanna haasotaxxi magenooffachchotixxi fakke maa la'o affe?</para>
  <para style="q1" vid="HAB 2:18">Isee giisseek anga ifixxixxa huje addatammaxxee</para>
  <para style="q2" vid="HAB 2:18">haaso'a dandetabaaxxxa magenooffachchotixxa fakkuwwanna giissaan.<verse eid="HAB 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 2:19" />Haqichcho, ‹dammaaqi›</para>
  <para style="q2" vid="HAB 2:19">hedho afebaaka kinjonna, ‹ke'i› hiyyaakee isi'a aanne'e!</para>
  <para style="q2" vid="HAB 2:19">dhugaandinta isi barsiisa dande'aata?</para>
  <para style="q2" vid="HAB 2:19">Kunnise isi birretinna worqeti buqemedheen</para>
  <para style="q2" vid="HAB 2:19">isi giddonna hafuuri hedheba'a.<verse eid="HAB 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="HAB 2:20" />Duuchchi Woddik Gootti kinni woyyichcha ifike galmi giddo hedheen.</para>
  <para style="q2" vid="HAB 2:20">Butta duuchchinna isi edo sammi hitowwaal.»<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="s1">Inbaaqoomixxa Soodachcho</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 3:1" />Faaroti shiqqeexxa wabeeka Ibaaqoomixxa soodachcho;<verse eid="HAB 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2" />Ee Duuchchi Woddike Gootta, gurra atika laqeenne</para>
  <para style="q2" vid="HAB 3:2">ee Duuchchi Woddike Gootta huje atixxinna anee sodaachchisse</para>
  <para style="q1" vid="HAB 3:2">No'oke baro'ninna isee haaronsi;</para>
  <para style="q2" vid="HAB 3:2">no'oxxe yanna'ninna ege'nendaashsha assi;</para>
  <para style="q2" vid="HAB 3:2">aartatto woddanna mararte atixxa hedi.<verse eid="HAB 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3" />Mageni Temaanike boganaa'n dage;</para>
  <para style="q2" vid="HAB 3:3">iikki woyyichchinna Faaranixxe koobanaa'ninna dage;</para>
  <para style="q1" vid="HAB 3:3">Isik gaachchaninna iimuwwa buqe'een;</para>
  <para style="q2" vid="HAB 3:3">saadino isixxinna buttate'n wo'mite.<verse eid="HAB 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4" />Wa'inni isikinna arishshotike ifishshaten</para>
  <para style="q2" vid="HAB 3:4">hunna isixxi sho'ondemmabaa'n</para>
  <para style="q2" vid="HAB 3:4">isixxe anganaa'n ifi ife.<verse eid="HAB 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5" />Dhukkubi isi edo me'aan;</para>
  <para style="q2" vid="HAB 3:5">balatinna faana isixxa hordoffaan.<verse eid="HAB 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6" />Uurree wodda buttanna linqi linqi asse;</para>
  <para style="q2" vid="HAB 3:6">uudeen, gosa gosak ardinna culphise;</para>
  <para style="q1" vid="HAB 3:6">Duuchchi woddixxi koobuwwa diigende</para>
  <para style="q2" vid="HAB 3:6">oolmik tulluchchuwwi fodhoki hiyye;</para>
  <para style="q2" vid="HAB 3:6">ori isik duuchchi woddiken.<verse eid="HAB 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7" />Tophiyiink dunkaanuwwi wixixxi hiyyaa wodda</para>
  <para style="q2" vid="HAB 3:7">Midiyaamike mannik galduminna weekemaa'naa uudenne.<verse eid="HAB 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8" />Ee Duuchchi Woddik Goottaa! Ati mufateetak galaanuwwake'niteeta?</para>
  <para style="q2" vid="HAB 3:8">Aare atixxita muummuwwate'nitemmata?</para>
  <para style="q1" vid="HAB 3:8">Atike fadhado'ninna</para>
  <para style="q2" vid="HAB 3:8">atike injfachchotike sarageelluwwa'n gulufette wodda</para>
  <para style="q2" vid="HAB 3:8">mufateetak abbaayyate'nitemmata?<verse eid="HAB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9" />Mogido atika qophpheessitete;</para>
  <para style="q2" vid="HAB 3:9">gabetinna dagaashsha ajajjete;</para>
  <para style="q2" vid="HAB 3:9">buttatanna galaanuwwik qooddete.<verse eid="HAB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 3:10" />Koobuwwa atee uudde wixxixxi hite;</para>
  <para style="q1" vid="HAB 3:10">Wodi'iink danbala'i sa'e me'e;</para>
  <para style="q2" vid="HAB 3:10">hundixxi baari jabaka luuljonna laqisse;</para>
  <para style="q2" vid="HAB 3:10">iseki danbala'inna iimi'a qophphi hiyye.<verse eid="HAB 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11" />Darbema'neeke atik mogidinaa'n</para>
  <para style="q2" vid="HAB 3:11">atike bagedike calalaqanaa'n kexxeexxa</para>
  <para style="q2" vid="HAB 3:11">arishshonna agenji ifi ifixxe bakka'n uurre.<verse eid="HAB 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12" />Buttate'n aare atixxenni mammarendete</para>
  <para style="q2" vid="HAB 3:12">gosa gosaka arduwwanna atixxe mufenni hirbeessitete.<verse eid="HAB 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13" />Arda atika dandandotaa</para>
  <para style="q2" vid="HAB 3:13">hariitetekanna anjirtota'a daggete</para>
  <para style="q1" vid="HAB 3:13">Fuggichcha bogika ookkone akeekisanjonna cancaqqette;</para>
  <para style="q2" vid="HAB 3:13">isoo umokenaa'ni lekkatike qe'yi qico'ni duwwi gatissete.<verse eid="HAB 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14" />Danbala'iinsha no'o xeero'a dageemmaka</para>
  <para style="q2" vid="HAB 3:14">buxanjokanna sho'ik liqiinso'a hasaake</para>
  <para style="q1" vid="HAB 3:14">Loliinke mannike sooreessika umo,</para>
  <para style="q2" vid="HAB 3:14">isinge bagedininni ottette.<verse eid="HAB 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15" />Jajabba wode'uwwa raasati</para>
  <para style="q2" vid="HAB 3:15">eettene abbaayyanna atike fadhadinni hirbeessitete.<verse eid="HAB 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16" />Aninna laqe'eennen qalbe anixxinna dhiqqise</para>
  <para style="q2" vid="HAB 3:16">suume anxinna ye'injo isikenaa'ni kexxeexxa roqonsite;</para>
  <para style="q1" vid="HAB 3:16">Soda'atinna miqe anxi giddo e'yite</para>
  <para style="q2" vid="HAB 3:16">lakka anxinna gilgilde</para>
  <para style="q1" vid="HAB 3:16">Kaddo malee'e no'oke naapha'n rakko geltaaxx yanna</para>
  <para style="q2" vid="HAB 3:16">ossunteti heqqedhannon.<verse eid="HAB 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17" />Yaane kinni belesetik haqichchi gummisa gophoole,</para>
  <para style="q2" vid="HAB 3:17">woyyinetike hiddichcho'ni gummanna afema gophphoole,</para>
  <para style="q1" vid="HAB 3:17">Ejersiink haqichchinna gumma uwwa gophoole,</para>
  <para style="q2" vid="HAB 3:17">fichchuwwikinna midha uwwa giboole,</para>
  <para style="q1" vid="HAB 3:17">Gedhebiinxi goodhenna midde duwwi gattoole,</para>
  <para style="q2" vid="HAB 3:17">lalikinna moonna giddo afema gophoole,<verse eid="HAB 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18" />Ani kinni Duchchi Woddike Gootta'ni gammadannon;</para>
  <para style="q2" vid="HAB 3:18">anke anjirallo Mageno'ni ililisannon.<verse eid="HAB 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19" />Dada duuchcha ajajaak Duuchchi Woddik Gootti anxe hunnan</para>
  <para style="q2" vid="HAB 3:19">lekka anxanna waala hiyyemaake biniinchixxe lekkashsha assaan;</para>
  <para style="q2" vid="HAB 3:19">isi koobuwwati iimanna tarkaafatannoshsha anee me'isaan. <note caller="-" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="2SA 22:34">2 Sam. 22:34</ref>; <ref loc="PSA 18:33">Far. 18:33</ref>.</char></note><verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>