<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2SA" style="id">- Gedeo Bible</book>
  <para style="h">2 Saamu'eeli</para>
  <para style="toc1">Langakaa Saamu'eelikaa Maxaafa</para>
  <para style="toc2">2 Saamu'elika Maxaafa</para>
  <para style="toc3">2 Sam.</para>
  <para style="mt1">Langakaa Saamu'eelikaa Maxaafa</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Kunni langaki Saamu'eeli maxaafi taakkake Saamu'eelike maxaafii'ni itti aanaake kadaa wodda Daawwiti edise bita'ike Yihudiinke moyanjo kadeexa (hafuura adhdha. 1-4) shiixxo qico tureechchinni uduma middika Isira'eelika boga lebeexxi duuchchiinga Isira'eelika boga mitteba galcheeke Isira'eelike moyanjo kadeexxa kulaake maxaafani (hafuura adhdha. 5-24) Kunni maxaafi Daawwiti mootumma isixxi ba'lattaashshanna galchatixxa hunna isixxa jabeessedho'a bogi giddonna gadhike boga'ni hedheeke naaphinn welti jabaxxa wo'laancho asseexxa ca'a asseexxi ege'nisha'nee maxaafan. Daawwiti addete'ni jabaateekenna Mageno yo'oshsha eeyyaammaken; ittanni ardiinxe oddo'ninna lumoxxa addatensha afeemmake manjon. Ookko biranni mitte mitte yanna mararte beloxxa yaane asseexxanna yorte isixxa wonshedho'a lumoxxe rakko'n geessissaaaxxa cubbo hujeexxa konne maxaafi giddo kulende'een. Kaddo malee'e Mageniinki wabeekichchi Naataani isibaa mare cubbo hujeexxa kassi assee wodda hujeexxe cubbo'a aadde aage Mageniinka xixichcho adhdhaamman.</para>
  <para style="ip">Daawwitixxi hedhona hujeexxi hujuwwa Isira'eelika arda yo'oshsha gammachchiissemmaxxee isi reyee uduma Isira'eelike boga'ni rakko geltaa wodda moyanjo uggino'a hanssoole Daawwitika belto yookaan Daawwitixxe sannenaa'ni Daawitishshan galchaaka manjo alfino'a halchinaamman.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Yihudi Boga'ni Daawwiti Moye <char style="ior"><ref loc="2SA 1:1-4:12">1:1—4:12</ref> </char></para>
  <para style="io1">Isira'eelike Boga Duuchcha'ni Daawwiti Moye <char style="ior"><ref loc="2SA 5:1-24:25">5:1—24:25</ref> </char></para>
  <para style="io2">Sirete'ni Moyeexxa Wogguwwa <char style="ior"><ref loc="2SA 5:1-10:19">5:1—10:19</ref> </char></para>
  <para style="io2">Daawwitiinna Bersaabehii <char style="ior"><ref loc="2SA 11:1-12:25">11:1—12:25</ref> </char></para>
  <para style="io2">Rakkonna Abara <char style="ior"><ref loc="2SA 12:26-20:26">12:26—20:26</ref> </char></para>
  <para style="io2">Cimo giddo Moyeexxa Wogguwwa <char style="ior"><ref loc="2SA 21:1-24:25">21:1—24:25</ref> </char></para>
  <chapter number="1" style="c" sid="2SA 1" />
  <para style="s1">Daawwiti Sa'oolixxa Rewo Laqe</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 1:1" />Sa'ooli reyeechchinni uduma Daawwiti Amaaleeqito lole injifate higeexxi, Tsiqilaagi lame barra ture. <verse eid="2SA 1:1" /><verse number="2" style="v" sid="2SA 1:2" />Sakka baro darendeexxa seemma oddo'wee, omo ifike'ni buko fiffiixeeki mitti manji Sa'oolixxe kaambebaa'ni dage. Isinna Daawwiti'i ulfeesse heeshshi hiyye.<verse eid="2SA 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 1:3" />Daawwitinna isoo, «Habaa'ni daggete?» hiyye qore.</para>
  <para style="p" vid="2SA 1:3">Isinna, «Isira'eelitotixxe kaambebaa'n baqate dagennen» hiyye hiisse.<verse eid="2SA 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 1:4" />Daawwitinna, «Kadeexxi yaane maacho?» hiyye isoo qore.</para>
  <para style="p" vid="2SA 1:4">Isinna, «Ardi bagedokenaa'ni baje'een; insa'ne giddii'ni heddi manni ribbi hiyyeen; reyeedhen; Sa'oolinna belti isik Yoonataaninna renne'en» hiyye.<verse eid="2SA 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 1:5" />Ookkoneechchi uduma Daawwitinna ergeme dagemmaka dargaggeesichcho, «Sa'oolinna belti isik Yoonataani renneexxa hitta egendette?» hiyye isoo qore.<verse eid="2SA 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 1:6" />Dargaggeessichchi manjichchinna hiyyee qic, «Ani iittanni Gilbo'axxe Kooba fuleennan» ookko'o «Sa'ooli abixxeexxe ebo'ni irkateeba hedhe'naa naaphiinxa fadhadiinxa gaaruwwanna fadhaduwwa oofammakiiri isoo hordofe dhaqqaphphe. <verse eid="2SA 1:6" /><verse number="7" style="v" sid="2SA 1:7" />Sa'oolinna udumi'a wirri hiyyee anee afeexxi ye'e; aninna ‹Mayee yexxette?› hiyyennen.<verse eid="2SA 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 1:8" />«Isinna hiisseexxi, ‹Ati ayyete?› hiyye anee qore.</para>
  <para style="p" vid="2SA 1:8">« ‹Aninna ante Amaaleqichchoken› hiyyee hiissene.<verse eid="2SA 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 1:9" />«Ookko'ni anee, ‹Reyotixxenna hedhotixxe oddo'ni hedhennen; lubbo kinni anenaa'n fuldebaan; amo anee shiyi› hiyye.<verse eid="2SA 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 1:10" />«Aninna mittele ibeechchi uduma gattabaaxxa ege'neennaxxe'e biri'a shikki hiyyennexxi shiyennen; umo isike'ni hedhemmaka kallachchanna hirrete'ni uggu'leemmaka hirboora aadhennexxi kunnuuxxi ati'a goota ankee iyyedageennen» hiyye.<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="1SA 31:1-6">1 Sam. 31:1-6</ref>; <ref loc="1CH 10:1-6">1 Odo. 10:1-6</ref>. </char></note><verse eid="2SA 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 1:11" />Ookkoneechchi uduma Daawwitinna isinni welti hedhemmak manni duuchchi yaandemmaxxee ifi ifixxa seemma daddarre. <verse eid="2SA 1:11" /><verse number="12" style="v" sid="2SA 1:12" />Insa'nenna Sa'oolinna belti isike Yoonataani wolaantichchik shiyemmeemmaxxee Duuchchi Woddike Goottike sannachchi'anna Isira'eelike mini hadi duuchchi'a bogi hashshaa qico'ni indeechchi hedhebang oo'na'ni honse.<verse eid="2SA 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 1:13" />Daawwitinna ergeme dageemmaka dargaggeessichcho, «Ati habaa'n daggette?» hiyye qore.</para>
  <para style="p" vid="2SA 1:13">Isinna «Ani wele boganaa'n dage ofo'leeke Amaaleqichchiinke belton» hiyye hiisse.<verse eid="2SA 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 1:14" />Daawwitinna «Duuchchi Woddik Gootti fi'le hariireeka moyanjo hitta soda'a belo shiltette?» hiyye.<verse eid="2SA 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 1:15" />Ookkoneechchi uduma Daawwiti isike manni giddii'n mitte ye'eexxi, «Marte shiyi» hiyye; isinna mare shiye; Amalqichchikinna reye. <verse eid="2SA 1:15" /><verse number="16" style="v" sid="2SA 1:16" />Daawwitinna, «Duuchchi Woddik Gootti hariireeka ‹shiyenneni hite atinge afo'inninni dhugaa fulchite kuldeetexxee ati mundii manjon› » hiyye.<verse eid="2SA 1:16" /></para>
  <para style="s1">Daawwiti Sa'oolixxenna Yoonataanixxe'e Boochchise</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 1:17" />Daawwitinna Sa'oolixxeenna belto isike Yoonataanixxe reyoxxee wi'lishsha'ni oodhe <verse eid="2SA 1:17" /><verse number="18" style="v" sid="2SA 1:18" />Iittanni tennee yaadotixxa wi'lishsha Yihudak ardi'a barataashsha ajaje; tinninna Yaasharke maxaafa'ni borressendeemman:<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="JOS 10:13">Iya. 10:13</ref>. </char></note><verse eid="2SA 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 1:19" />«Tee Isira'eeli! Atik gaachchanni</para>
  <para style="q2" vid="2SA 1:19">koobuwwate'ni hana oteme reye.</para>
  <para style="q1" vid="2SA 1:19">Jajjabbi hitta ibaa!<verse eid="2SA 1:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="2SA 1:20" />«Tennee Gaati'ni haasotinoqqe'e,</para>
  <para style="q2" vid="2SA 1:20">Asiqeloonamike hodhicha'ninna lassitinoqqe'e</para>
  <para style="q2" vid="2SA 1:20">Filisixeemitotik dubarruwwi gammadoqqe'e,</para>
  <para style="q2" vid="2SA 1:20">Duuchchi Woddika Gootta addatebaak dubarruwwi ililisoqqe'e.<verse eid="2SA 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="2SA 1:21" />«Ha'no Gilbo'ake tulluchuwwa</para>
  <para style="q2" vid="2SA 1:21">kiifo xeenixxi ha'noo'ni cophphoqqe'e!</para>
  <para style="q2" vid="2SA 1:21">Umiinxa uwwa uutatake fichcha'n midha hexxoqqe'e;</para>
  <para style="q2" vid="2SA 1:21">ookkoo jabake manjichchixxe wonte battootemmaxxee,</para>
  <para style="q2" vid="2SA 1:21">Sa'oolixxa wonte ta'inni elqi'a zayite issendabaan.<verse eid="2SA 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 1:22" />Yoonataanixxi gabe shiltebang higgabaan,</para>
  <para style="q2" vid="2SA 1:22">Sa'oolik wolaantichchi tola boddichcha dagabaan;</para>
  <para style="q2" vid="2SA 1:22">jajjabba gane enqaake,</para>
  <para style="q2" vid="2SA 1:22">naaphakanna shiye birammakemman.<verse eid="2SA 1:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="2SA 1:23" />«Sa'oolinna Yoonataani hedhoti he'nemma wodda,</para>
  <para style="q2" vid="2SA 1:23">insa'nenna yo'oshsha weli eena'neekenna afo'i insa'neek weli aagekemman;</para>
  <para style="q2" vid="2SA 1:23">reyote'ninna gargar hingebaan;</para>
  <para style="q2" vid="2SA 1:23">insa'nenna sinbir irra yo'oshsha winaammaan</para>
  <para style="q2" vid="2SA 1:23">neenqi caalanna hunnameeyyetemman.<verse eid="2SA 1:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="2SA 1:24" />«Ha'no Isira'eelike dubarra,</para>
  <para style="q2" vid="2SA 1:24">baddeessitte, butta gelteexxa seemmanna fuuta ganneexxa seemma oddeeseemmake,</para>
  <para style="q2" vid="2SA 1:24">seemmuwwa ha'nooxxa worqeti seesemmake,</para>
  <para style="q2" vid="2SA 1:24">Sa'ooli'a oodhdhe.<verse eid="2SA 1:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="2SA 1:25" />«Jajjabbi hitta kadee lolake'ni iba,</para>
  <para style="q2" vid="2SA 1:25">Yoonataani tulluchchuwwake'n oteme reyeen.<verse eid="2SA 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="2SA 1:26" />Anke dayyo Yoonataani;</para>
  <para style="q2" vid="2SA 1:26">ani atixxee yaadennen.</para>
  <para style="q1" vid="2SA 1:26">Ati ani'a yo'oshsha fiixxeetan,</para>
  <para style="q1" vid="2SA 1:26">Eeya atixxi ani'a mambe'akemman</para>
  <para style="q2" vid="2SA 1:26">melaalletixxe eeyya irra eloxxemman.<verse eid="2SA 1:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="2SA 1:27" />«Jajjabbi hitta ibe!</para>
  <para style="q2" vid="2SA 1:27">Isik loliinki miyuwwi hitta tola gate!»<verse eid="2SA 1:27" /></para>
  <chapter eid="2SA 1" />
  <chapter number="2" style="c" sid="2SA 2" />
  <para style="s1">Daawwiti Yihudiinke Moyanjo Kade</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 2:1" />Ookkoneechchi uduma Daawwiti hiyyee qici, «Yihudake qachchuwwi giddi'ni mittiinba alale maroo?» hiyye Duuchchi Woddika Gootta laqe.</para>
  <para style="p" vid="2SA 2:1">Duuchchi Woddik Goottinna «Eeti me'i» hiyye.</para>
  <para style="p" vid="2SA 2:1">Daawwitinna, «Hoone qachchibaata me'anno?» hiyye hiisse laqe.</para>
  <para style="p" vid="2SA 2:1">Duuchchi Woddik Goottinna, «Kebiroonike qachchiba'a me'i» hiyye isi'a hiisse.<verse eid="2SA 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 2:2" />Tennexxe Daawwiti lamiinxe are ifixxinni Iyyizira'eelichcho Ahino'aaminna Qermeeloosichcho reyemmake Naabaalixxa are Abigeelinni welti alalle'a qabate.<note caller="-" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="1SA 25:42-43">1 Sam. 25:42-43</ref>. </char></note> <verse eid="2SA 2:2" /><verse number="3" style="v" sid="2SA 2:3" />Iittanni Daawwiti isinni welti hedhemmaka manna insa'nege mini hadinninni welti aadhe dage; insa'nenna Kebiroonik qachchuwwik qarqara'ni hedheeke qachchuwwa'ni ofolle. <verse eid="2SA 2:3" /><verse number="4" style="v" sid="2SA 2:4" />Yihudak maninna Kebiroonike qachhcuwwiba dage; ookkonna Daawwiti'i hariirreexxi Yihudiinke ardike moyanjo assine.</para>
  <para style="p" vid="2SA 2:4">Sa'ooli'i moogeki Gele'adi hedhammak Iyyabiisike manna kadeexxa Daawwiti laqee wodda,<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="1SA 31:11-13">1 Sam. 31:11-13</ref>. </char></note> <verse eid="2SA 2:4" /><verse number="5" style="v" sid="2SA 2:5" />Daawwitinna Iyyabiisi Gele'adike manniba ergeexxi insa'ne'a hiyyee qici: «Konne qicinni gootta ha'noke Sa'oolika rensha moogiyyoti eloxxa assitineemmaxxee Duuchchi Woddik Gootti ha'noo eebbisoo. <verse eid="2SA 2:5" /><verse number="6" style="v" sid="2SA 2:6" />Ta'anna Duuchchi Woddik Gootti mararte isixxenninna addatensha ifixxee ha'noo uuddowwaal; ha'noonna tennee assitineemmaxxee, aninna iitanni eloxxa yaane ha'no'a assannon. <verse eid="2SA 2:6" /><verse number="7" style="v" sid="2SA 2:7" />Yoona gootti ha'nook Sa'ooli reyedheen; jabaatte, worbe, Yihudaki ardinna anee hariirexxi insa'nee moyannoshsha assine'een.»<verse eid="2SA 2:7" /></para>
  <para style="s1">Iyyabusitte Isira'eelike Moyanjo kade</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 2:8" />Eettene yanna'ni Sa'oolik loliinke sannachchik ajajalli Nerik belti Abeneeri, Sa'oolika belto Iyyaabusittee'e Yordanoosi foosseexi Mahinayimi'a iyyedage. <verse eid="2SA 2:8" /><verse number="9" style="v" sid="2SA 2:9" />Isoonna Gele'adi'ni, Aseeri'ni, Iyyizira'eeli'n, Efireemi'ni, Biiniyaami'ninna ittanni Isira'eelito duuchcha'ni moyanjoke asse.<verse eid="2SA 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 2:10" />Sa'oolik belti Iyyaabusitte Isira'eeli'ni moyanjo kadaa wodda shoole tomme woggamman; isinna lame wogga Isira'eeli galche.</para>
  <para style="p" vid="2SA 2:10">Yihudaki minni hadi kinni Daawwiti'i hordofe. <verse eid="2SA 2:10" /><verse number="11" style="v" sid="2SA 2:11" />Daawwiti Kebirooni ofo'leexxi Yihudake arda'ni torbaane wogganna jaane agenjo moye.<verse eid="2SA 2:11" /></para>
  <para style="s1">Yihudaxxe'ninna Isira'elixxe Oddo'n Kadeeka Lola</para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 2:12" />Nerik belti Abeneerinna, Sa'oolike beltixxe Iyyaabusitteke erganjuwwinni welti he'ne Mahinayimii'n kenneexxi Geba'oonike qachchiba'a me'ine. <verse eid="2SA 2:12" /><verse number="13" style="v" sid="2SA 2:13" />Insa'neenna Tsuriyak belti Iyyo'abinna Daawwitiki manni fulleexxi Geba'oonik baleessi qarqara insa'nenni afemme; mitte qorbi baleessi wido, wele qorbi kinni baleessi kayya ofolle.<verse eid="2SA 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 2:14" />Ookko'ninna Abeneeri Iyyo'aabii'i hiyyee qici, «Ha'no giddii'ninna no'o giddii'ni ka'umi ke'eexxi loliinke miyinni weli aanowwal» hiyye.</para>
  <para style="p" vid="2SA 2:14">Iyyo'aabinna hiyyee qici, «Kadduunni weli adhdhe inbaqata» hiyye hiisse.<verse eid="2SA 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 2:15" />Tennexxe Biniyaamixxe gamonnaa'ni Iyyaabusittek mannanaa'ni tommenna lami manni filemeexxi Daawwitike tommenna lame manninni welti lola inbe. <verse eid="2SA 2:15" /><verse number="16" style="v" sid="2SA 2:16" />Ookkoo'ni mitti mittingi manji ifi ifika naaphiinka umo abideexxi wolaantichchik cinaachcha weli hordina'ni weli abixinemmashshanni inbe ookko renne. Tennexxe Geba'ooni hedheek iikki boonchi, «Wolaantichchiinke boga» hiyyeme.<verse eid="2SA 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 2:17" />Eettene barrak loli yo'oshsha jabakemman; Daawwitiki manni, Abeneerinna Isira'eelika manna injifate. <verse eid="2SA 2:17" /><verse number="18" style="v" sid="2SA 2:18" />Tsuriya hiyyendaaxxe manjichchoxxi sasiinxi labbaxxi oose: Iyyo'aabi, Abisanna Asaheeli ookko he'nemman; Asa'heeli buddannetishsha gongammakemman <verse eid="2SA 2:18" /><verse number="19" style="v" sid="2SA 2:19" />Isi elqe kayya hiyyebaangi Abeneeri abido'a isiba'a gonge. <verse eid="2SA 2:19" /><verse number="20" style="v" sid="2SA 2:20" />Abeneerinna udumi'a wirri hiyye uudeexxi «Asaheeli ateende?» hiyye laqe.</para>
  <para style="p" vid="2SA 2:20">Isinna «Eeti, anenden» hiyye hiisse.<verse eid="2SA 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 2:21" />Ookkoneechchi uduma Abeneerinna, «Anee shorichcho walde'e loliinike mannanaa'ni mittekenaa'n loliinka miya adhdhi» Asaheeli kinni isoo shorra waalemmabaan.<verse eid="2SA 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 2:22" />Langaxxanna Abeneeri, «Anee ta'anna shorra waaldetele ati'a woyyaanni atee shiye dayyo atika Iyyo'aabi'i heene illeenni uudano?» hiyye. <verse eid="2SA 2:22" /><verse number="23" style="v" sid="2SA 2:23" />Yaane kinni Asaheeli shorrichcho waalebaan; tennexxee Abeneeri bagedo darbeexxi Asaheelika godoba ote duddurokenaa'ni fulche; Asaheelinna ookko ibe ikki woddi reye; ora sa'aaki manni duuchchi rensha isika uurre uudaamman.<verse eid="2SA 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 2:24" />Iyyo'aabinna Abisa kinni Abeneeri shorrate'ni ke'ne; shorrinsha'ni Gaba'oonixxe qiilla gammoojjeba'a me'aake Giyaahike ori bira hedheeke Amaake tullichchiba genneeshanni arishsho e'yite. <verse eid="2SA 2:24" /><verse number="25" style="v" sid="2SA 2:25" />Ookko'ninna Biiniyaamik manni Abeneeribaa dage bukki hineexxi tullichchinxe xungo'ni lolakee qopheeffante.<verse eid="2SA 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 2:26" />Abeneerinna Iyyo'aabii ye'eexxi, «Wolaantichchi duuchchiui wodda lolemma'n he'na'no? Loliink muuxam qararake kadeexxa egendeboxxo? Atike ardi dayyuwwa ifika shorra waalaashsha ajaja insa'ne'a uutaboxxolchi mayeete?» hiyye.<verse eid="2SA 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 2:27" />Iyyo'aabinna hiisseexxi, «Hedhaake Magenixxa tenne haaso'a gophpheettele manni soodaa qico'ni dayyuwwa ifika shorra waalaammabaan» hiyye hiisse.<verse eid="2SA 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 2:28" />Tennexxe Iyyo'aabi malagata ufuufe; ookkoneechchi uduma manni duuchchi Isira'eelika arda shorra waale; lolikinna tennenninni uurre.<verse eid="2SA 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 2:29" />Abeneerinna isiki manni hashsha Arebanaa'n sa'ne me'ine; okkonechchi uduma Yordaanoosi fonfe Beetiroonni sa'ne Mahinayimi'a dange.<verse eid="2SA 2:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 2:30" />Ookkoneechchi uduma Iyyo'aabi Abeneerii'i shorra waaleexxi hige; isinna manna duuchcha mitteba bukki assee wodda Daawwitike mannanaa'ni Asaheeli lebebaang tommenna sallane manni giddii'ni gophemeexxa ege'nende. <verse eid="2SA 2:30" /><verse number="31" style="v" sid="2SA 2:31" />Daawwitiki manninna kinni Abeneerinni welti hedhemmaka sase dhibbanna jaane tomme Biiniyaamito shinne. <verse eid="2SA 2:31" /><verse number="32" style="v" sid="2SA 2:32" />Asaheelinna ibemmabaa'ni ke'issineexxi Beetelihemi giddo hado isika moongammake hirreessiba moonge. Ookkoo'ni Iyyo'aabinna isik manni hashsha duuchcha me'inaa'ni galleexxi soode wodda Kebirooni'i genne.<verse eid="2SA 2:32" /></para>
  <chapter eid="2SA 2" />
  <chapter number="3" style="c" sid="2SA 3" />
  <para style="p">
    <verse number="1" style="v" sid="2SA 3:1" />Daawwitikenna Sa'oolike minni hadixxe oddo'ni hedhemmak loli qeerraxxa yanna adhdhe. Daawwiti jabaata'ni me'aa wodda Sa'ooliki mini hadi kinni gopha'ni me'e.<verse eid="2SA 3:1" /></para>
  <para style="s1">Daawwitixxa Oose</para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 3:2" />Daawwiti Kebirooni hedhemma wodda jaane labbaaxxa oose i'le; angafi belti Iyyizira'eelichcho Ahino'aaminaa'n illeeki Aminooni, <verse eid="2SA 3:2" /><verse number="3" style="v" sid="2SA 3:3" />Langaki Qermeeloosichcho Naabaalixxi are Abigeeli ildeeki Kili'aabi, sakkaki Geshuurika moyanjo Telmayixxi belto Ma'ika iledeek Abeseloomi, <verse eid="2SA 3:3" /><verse number="4" style="v" sid="2SA 3:4" />Sholgaki Hagiitinaani ilde'ek Adooniya, ondiba Abixaali ildee'ek Sefaaxiya, <verse eid="2SA 3:4" /><verse number="5" style="v" sid="2SA 3:5" />Jiyaki Daawwitixxi are Egila ildeek Yutire'aamitemman; kunniir Daawwiti Kebirooni hedhemma wodda isi'a ilendeexxeeramman.<verse eid="2SA 3:5" /></para>
  <para style="s1">Abneeri Daawwitinni Welti Gudde</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 3:6" />Sa'oolik minninna Daawwitiki mini lolake kadaamma wodda Abeneeri Sa'oolike mine'ni midditte alfa'ni me'e.<verse eid="2SA 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 3:7" />Sa'oolinna Iyyoheelixxa belto Ritsifa hiyyendaaxxa jaalo are afeemman; Iyyabusittenna Abeneeri'i, «Mayeete anke annixxe shiixxooxxe arenne welti diiphettek?» hiyye.<verse eid="2SA 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 3:8" />Abeneerinna Iyyaabusitte hiyyeeke hiyyichcho'ni lumoshsha mufatemmaxxi hiyyee qici, «Anee Yihuda'a ergatemannoke wolcho assitette? Ani anna atike Sa'oolike mini'a isike dayyuwwi'anna fira isike'e addatensha anxa telchi qico'ni waaleebo'non; aninna atee Daawwitixxe anga'ni sa'isse uwwebo'non; ta'a kinni ati tenne man'jichcho'n assennexxe yaanexxee anee ku'litatto? <verse eid="2SA 3:8" /><verse number="9" style="v" sid="2SA 3:9" />Duuchchi Woddik Gootti Daawwiti'a kakoti uwweemmaxxa eettenee addachchiisa muuxendaashsha assebe'nok gatoonole Mageni Abeneeri'n fuggoxxa assowwaal; eettenenaa'ninna caldaaxxa iso'n iiyyedagowwaal. <verse eid="2SA 3:9" /><verse number="10" style="v" sid="2SA 3:10" />Dada Duuchchik Gootti mootumma Sa'oolike mininaa'n adheexxi Daawwitixxa moote Isira'eeli'ninna Yihuda'n, Daani'n Bersaabeehi qico'n ofo'lishatee addachchiisati isi'a aageemmaxxa kako muuxendaashsha ani Daawwitii'i kipha gophonnole Mageni anee uudo!»<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="1SA 15:28">1 Sam. 15:28</ref>. </char></note> <verse eid="2SA 3:10" /><verse number="11" style="v" sid="2SA 3:11" />Iyyabusittenna Abeneerii'i yo'oshsha sodateemmaxxee hiissee mitelchonna midde hiissa dande'ebaan.<verse eid="2SA 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 3:12" />Ookko'ninna Abeneeri Daawwiti'a hiyyee qici, «Konne bogi galchalli ayyete? Aninni welti weli aagottole yoona Isira'eeliki ardi duuchchi atiba'a higaashsha ani atee gargaarannon» hine Daawwiti'a kullaashsha erganjuwwa erge.<verse eid="2SA 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 3:13" />Daawwitinna «Kadduun eloxxen, atinni welti weli aangannon; yaanee kinni atenaa'ni mitte yaane hasaannen; tinninna ati aniba'a daggatto wodda edisse Sa'oolixxa belto Melkooli'i aaxxe daggattoshshaten; iita kada gophphoole kinni aniba'a daggoxxee» hiyye. <verse eid="2SA 3:13" /><verse number="14" style="v" sid="2SA 3:14" />Ookkoneechchi uduma Daawwitinna hiyyee qici, «Dhibba Filisixeemitotike manna yakkate araarsedhennaxxa are anxa Melkoolii'i ani'a uwwi» hiyya'nee Sa'oolike belto Iyyaabusittebaa erga erge.<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="1SA 18:27">1 Sam. 18:27</ref>. </char></note> <verse eid="2SA 3:14" /><verse number="15" style="v" sid="2SA 3:15" />Tennexxe Iyyaabusitte mitte manjo ergeexxi, Milikooli heerundemmake aro'o iseke Leessake belto Feelixi'eeli hundii'ni fulchine. <verse eid="2SA 3:15" /><verse number="16" style="v" sid="2SA 3:16" />Aro'i iseki Paalixi'eelim Baahuriimke qachchi qico'ni oodha'ni duuka isexxa me'e; yaane kinn Abeneeri, «Gelteen! Yoona mini atikibaa higi» hiyye. Tennexxe isinna hige.<verse eid="2SA 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 3:17" />Abeneeri Isira'eelixxe geedhuwwanni welti mari'ate hiyyee qici, «Konneechchinni edo Daawwiti ha'nooke moyanjo kado'a yortine'emman; <verse eid="2SA 3:17" /><verse number="18" style="v" sid="2SA 3:18" />Duuchchi Woddik Gootti Daawwiti'a ‹Erganji anki Daawwiti arda anka Isira'eeli Filisixeemitotixxe anganaa'ninna insa'neke naaphuwwixxe anganaa'ni anjirannon› hiyyee addachchiisemmaxxee tennee ta'a tennee asse.» <verse eid="2SA 3:18" /><verse number="19" style="v" sid="2SA 3:19" />Iittanni Abeneeri Biiniyaamitotee ifi'aanni mareexxi tenneenni insa'ne'ni kule; ookkoneechchi uduma Isira'eelinna Biiniyamito duuchcha assate'e hanseexxa duuchcha Daawwiti'ni kulo'a Kebirooni'a me'e.<verse eid="2SA 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 3:20" />Abineerinna lame tomme manninni welti Daawwiti hedhemmabaa Kebirooni'a dage; Daawwitinna Abeneeri'anna isinni welti hedheeke manni'a jila jile. <verse eid="2SA 3:20" /><verse number="21" style="v" sid="2SA 3:21" />Ookkoneechchi uduma Abeneeri Daawwitii'i, «Atinni welti kako aango'a godobi atiki yoremmashsha duuchcha galchitotta'a rake marennexxi ate gootta anke moyanji'a Isira'eelika arda duuchcha bukki asso» hiyye. Tennexxee Daawwiti Abneeri geegeesse; isinna nage'iki me'e.<verse eid="2SA 3:21" /></para>
  <para style="s1">Iyyo'aabi Abeneeri'i Shiye</para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 3:22" />Daawwitiki manninna Iyyo'aabi eettene yanna'ni heddo booji'o booji'eexxi duulokenaa'ni hinge. Abeneeri kinni Daawwiti nage'iki geegesse'naa me'eemmaxxee Kebirooni'ni hedhemmabaan. <verse eid="2SA 3:22" /><verse number="23" style="v" sid="2SA 3:23" />Iyyo'aabi isinni welti hedhemmaki sannachchi duuchchi welti ookko'o geye; isinna Nerik belti Abeneeri moyanjiinbaa degeexxa moyanji geeggeessexxanna isi nage'ik me'eexxa laqe.<verse eid="2SA 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 3:24" />Tennexxe Iyyo'aabi moyanjii mine'ni e'yeexxi hiyyee qici, «Tinni assitettexxi yaane maachcho? Kunnisse Abeneeri atiba dageexxi nage'iki me'o'aa waaldetteki mayeete? <verse eid="2SA 3:24" /><verse number="25" style="v" sid="2SA 3:25" />Atinna Nerika belto Abeneeri egendeetten; isi atiba dageechchi atee geeqqishe, fula higa atixxa ege'no'aanna ati hujaatelcho duuchcha dooyyo'aaten.»<verse eid="2SA 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 3:26" />Ookkoneechchi uduma Iyyo'aabi Daawwiti birii'ni me'eexxi Abeneeri'i iyyedango'aa erge; erga maremmakiirinna Seeyirixxe wode'iinxe bale qarqarii'n isoo hiissine. Daawwiti kinni tennee ege'neemmabaan. <verse eid="2SA 3:26" /><verse number="27" style="v" sid="2SA 3:27" />Abeneerinna Kebirooni'a higee wodda Iyyo'aabi qofiba iso'n hasessa'nechcho fakkeesse wirri asse dalla'iinxe hulabaa iso'o aadhee me'e; ookkona isika dayyo Asaheelika guma hiissatee godoba oteexxi shiye. <verse eid="2SA 3:27" /><verse number="28" style="v" sid="2SA 3:28" />Daawwitinna tenne yaane udumii'ni laqeexxi hiyyee qici, «Aninni kadi mootumma giddik ardi Nerike belto Abeneerixxe mundexxee balleessa no'oni hexxebaaxxa Duuchchi Woddik Gootti ege'ne'een. <verse eid="2SA 3:28" /><verse number="29" style="v" sid="2SA 3:29" />Tinni isixxi munde Iyyo'aabi'ninna anni isikika mini hado duuchcha daafowwaal; coxxoti dhukkubi yookaan elobaaki mundiinki dhukuba afeeki, kooko'ichchi, yookaan wolaantichchake'ni reyaaki yookaan itaachcho gophe solo'waaki Iyyo'abike minenaa'ni gophemoqqe'e» hiyye.<verse eid="2SA 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 3:30" />Abeneeri Gaba'oo'ni kademmake lola'ni Iyyo'aabikanna Abisayika dayyo Asaheeli shiyemmaxxee insa'nenna Abeneeri shinne.<verse eid="2SA 3:30" /></para>
  <para style="s1">Abenerixxa Moogensha</para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 3:31" />Ookkoneechchi uduma Daawwiti Iyyo'aabinna isinni welti hedhemmaka arda duuchcha, «Seemma ha'noxxa dartine dooniyya odo'witine'e Abeneeri'a oodhdhe» hiyye. Moyanji Daawwiti umi isinge'ni mooggo mare. <verse eid="2SA 3:31" /><verse number="32" style="v" sid="2SA 3:32" />Insa'nenna Abeneeri'i Kebirooni moonge; ookkone moogo'ni moyanji Daawwitinna lumoshsha hiiqise oodhdhe; ardi duuchchinna iittanni oodhe.<verse eid="2SA 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 3:33" />Moyanji Daawwiti Abeneeri'a hiyya'ni boochchissinaa'ni hitinaa qici:</para>
  <para style="q1" vid="2SA 3:33">«Abeneeri mayee gowwi manjixxa reyo reye?<verse eid="2SA 3:33" /></para>
  <para style="q2">
    <verse number="34" style="v" sid="2SA 3:34" />Anga atixxi usurendemabaan;</para>
  <para style="q1" vid="2SA 3:34">Lekka tinna haachchabiki takalendeemmabaan;</para>
  <para style="q2" vid="2SA 3:34">manji fuggaaleeyyetixxe anga'ni ibammashsha;</para>
  <para style="q1" vid="2SA 3:34">Atinna iittani ibbe rertette!»</para>
  <para style="p" vid="2SA 3:34">Ardi duuchchinna hiiggen isi'a oodhe.<verse eid="2SA 3:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 3:35" />Ookkoneechchi uduma Ardi duuchchi ita itamaxxa yanna Daawwitiba dangeexxi ita iti hinaa'ni jaba qicinni kadhante. Daawwiti kinni, «Telcho arishsho aaga qico'ni midha yookaan weleechcho afo'o anke'ni maqonnole tinni kaddeexxi ane'n kaddo'a; wele caala Mageni ane'ni iyyedagoo!» hiyye kakate. <verse eid="2SA 3:35" /><verse number="36" style="v" sid="2SA 3:36" />Ardi duuchchi tenne hubateexxi gammade; dhugaandinni moyanji Daawwiti asseexxi yaane duuchchi arda gammachchiisse. <verse eid="2SA 3:36" /><verse number="37" style="v" sid="2SA 3:37" />Tennexxee eettene barra'ni ardi duuchchinna Isira'eeliki ardi duuchchi moyanji Daawwiti Nerika belto Abeneeri'i shilchiisebaaxxa ege'ne.<verse eid="2SA 3:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 3:38" />Ookkoneechchi uduma moyanji Daawwitinna isik jalqabuwwi'a hiyyee qici: «Telchixxe barra'ni Isira'eelinaa'ni akeekisanjinna ja'laabi reyeexxa egendineeba? <verse eid="2SA 3:38" /><verse number="39" style="v" sid="2SA 3:39" />Mageni anee telcho fi'le hariireeke moyanjo kadonnolenna midde ani gophaaleessa manjon; tinni Tsuriyaxxi oose lumoshsha elobaaxxenni ane'ni kexxe'een. Duuchchi Woddik Gootti fuggoxxa hujaakee huje isixxishshaanni uwwowwaal» hiyye.<verse eid="2SA 3:39" /></para>
  <chapter eid="2SA 3" />
  <chapter number="4" style="c" sid="2SA 4" />
  <para style="s1">Iyyabuusitte Shiyeme</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 4:1" />Abeneeri Kebirooni reyeexxa Sa'oolik belti Iyyaabusitte laqee wodda lumoshsha alayye culphise; Isira'eeliki ardi duuchchinna alayye. <verse eid="2SA 4:1" /><verse number="2" style="v" sid="2SA 4:2" />Eetene yanna Sa'oolik belti Iyyabusitte isika loliinka manna akeekkaaxxa lame akeekanoole afeemman; insa'nenna Biiniyaamixxe gosanaa'ni Be'eerotixxe sanne kandeeke Remoonixxi oose Be'aananna Rekaabitemman; Bi'erooti Biiniyaamixxe gosati mini giddii'n mittekemman. <verse eid="2SA 4:2" /><verse number="3" style="v" sid="2SA 4:3" />Be'eerotik ardi Gitayimi'a baqantemmashshanni telchi qico'ninna keesummumma ofo'leeshshaanni ookko hedha'neen.<verse eid="2SA 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 4:4" />Sa'ooliki belti Yoonataani lamiinxa lekka nafeeka mitte Mefibosheeti hiyyemaaka belto afeemman. Isinna Sa'oolinna Yoonaatani rennee wodda onde woggake beltomman; isinna naafake kadeechchi isoo lu'mitammaxxi manjichcho insa'nexxe reyoxxi odo Iyyizira'eelii'n daggee wodda isoo adhdhite wiinammiki baqattaa'na angii'ni ibe; iba eettenenaa'ni kexxeexa naafe.<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="2SA 9:3">2 Sam. 9:3</ref>. </char></note><verse eid="2SA 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 4:5" />Eettene yanna Be'eerotichcho Remoonixxi labbaaxxi oose Rekaabinna Be'aana Iyyaabusitteke mine'n barra saafo'a genne; isi ookkone wodda barrixxa hafuura adhdha adhdhatee taqete'ni irkateeba hedhdhe'na'a. <verse eid="2SA 4:5" /><verse number="6" style="v" sid="2SA 4:6" />Hula heqqitammaxxi manjichcho<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">Hula heqqitammaxxi manjichcho, wele tika Rekaabinna Be'aanna dinne adhdhaneeke manna lanbe'e mini giddo e'yati isoo'o godoba onte shinne hitaan</char></note>dinne sortammaba mugoke'n hexxemman. Ookkoneechchi uduma Rekaabinna Be'aanna laana sa'neexxi me'ne e'yine.<verse eid="2SA 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 4:7" />Insa'nenna mini giddi'a E'yineek Iyyabusitte kuta giddo diiphphenaten; onte shinnechchi uduma; gooba isikanna wonxe adhdhineexxi; hashsha duuchcha Arebaka ora me'ine. <verse eid="2SA 4:7" /><verse number="8" style="v" sid="2SA 4:8" />Iyyabusitteka umo Kebirooni hedheeke moyanjo Daawwiti'a iyyedangeexxi moyanjo hinee qici, «Atee shiyo'a hasaammake naaphi atikike Sa'oolike beltiki Iyyaabusittek umi kunnisseten; moyanjo Sa'ooli'ninna mini hado isike'ni telcho Duuchchi Woddik Gootti halo ati'a fule'een» hine.<verse eid="2SA 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 4:9" />Daawwitinna be'eerotichchi Remoonixxe labbaxxe oose'a Rekaabiinna dayyo isikee Be'aanaa hiyye hiisse qici, «Fuggoxxe duuchchinaa'ni ane gargaareeke hedha'neeke Duuchchi Woddike Goottike summinni hiyye kakatee qici: <verse eid="2SA 4:9" /><verse number="10" style="v" sid="2SA 4:10" />Gammashshotixxa odo ani'a iyyedageechcho iso'ni labee'naa, ‹Sa'ooli reyeen› hiyye ane'ni kuleeka manjo abideneexxi Tsiqilaagike booncho'ni shiyenneen; yoona ookkonne gammashotixxa odo iyyedageeke manji'a badhaseenneki badhaadhi konnendemmaan.<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="2SA 1:1-16">2 Sam. 1:1-16</ref>. </char></note> <verse eid="2SA 4:10" /><verse number="11" style="v" sid="2SA 4:11" />Yooni mini ifiki giddo, taqete'ni ca'li hiyye diipheeka nage'iinka manjo shiyeeki fuggoki manni hitta kadee jaba qicinni xixema gopha? Aninna munde ha'nooxxa dunee halo fule ha'no buttatenaa'n shiye balleessannon!» hiyye. <verse eid="2SA 4:11" /><verse number="12" style="v" sid="2SA 4:12" />Tennexxe Daawwiti ifika loliinka manna, insa'ne shiwwe hiyyeexxi ajaje; loliink manninna insa'nenna shinnexxi angatanna lekka wowwonxeexxi Kebirooni hedheeke balleessi bira rensha insa'neka fanisse. Yaane kinni Iyyaabusitteka umo aa'neexxi Kebirooni hedheeke hirreessa'ni Abeneeri moongemma bira isoo moonge.<verse eid="2SA 4:12" /></para>
  <chapter eid="2SA 4" />
  <chapter number="5" style="c" sid="2SA 5" />
  <para style="s1">Daawwitixxe Isira'eeli'ninna Yihuda'n Moye</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 5:1" />Isira'eelixxe gosak mine duuchchi Daawwiti hedheeba Kebirooni dageexxi isoo hiyyee qici, «Yoona no'o atinni mitte mundenna mitte maalan. <verse eid="2SA 5:1" /><verse number="2" style="v" sid="2SA 5:2" />Konnechchinni edo Sa'ooli no'oke moyanjo kade akeekaamma wodda Isira'eelike ardi edo hexxe lolinka manna akeekattaki atetemman; Duuchchi Woddik Goottinna ‹Arda anka Isira'eeli'i heqitaton, akeekisanjo insa'nekenna kadatton› » attee hiyyemmani.<verse eid="2SA 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 5:3" />Tennexxe Isira'eelike ardixxi geedhuwwa duuchchi kebirooni daggee; moyanji Daawwitinna Kebroonke booncho'ni Duuchchi Woddik Gootti edo insa'nenni welti kako aage; insa'nenna Daawwiti'i harrireexxi Isira'eel'ni moyaashsha assine. <verse eid="2SA 5:3" /><verse number="4" style="v" sid="2SA 5:4" />Daawwiti moyee wodda wogga isixxi sase tommemman; shoole tomme wogga moye galche. <verse eid="2SA 5:4" /><verse number="5" style="v" sid="2SA 5:5" />Kebirooni ofo'leexxi Yihudaka arda torbaane wogganna jaane agenjo; iittanni Iyyerusaalemi ofo'leexxi Yihudiinkanna Isira'eelika arda duuchcha sase tommenna sase wogga moye galche.<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="2SA 1:1-16">2 Sam. 1:1-16</ref>. </char></note><verse eid="2SA 5:5" /></para>
  <para style="s1">Daawwiti Yerusaalemii'i Lole Injifate</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 5:6" />Moyanjikinna manni isiki Iyyerusaalemi hedhaammaka Iyyabusika manna lollo'a ookko'a duulle. Iyyaabusiki manninna hiyyee qici, «Daawwiti kaba e'ya dande'abaan» hiyye hendemaaxxe Daawwiti'i, «Naafuwikinna balla'uwwi midde ate hoyyammaxxee kaba'a e'yitaboxxon» hine.<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="2SA 1:1-16">2 Sam. 1:1-16</ref>. </char></note> <verse eid="2SA 5:6" /><verse number="7" style="v" sid="2SA 5:7" />Kaddo malee'e Daawwitinna Tsiyoonixxa kollo abixxe; kunninna Daawwitike qachcha hiyyemeeken.<verse eid="2SA 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 5:8" />Eettene barra Daawwiti hiyyee qici, «Iyyaabusito lolee kutti asso'a hasaaki Daawwitik naaphi kadeeke ‹Naafuwwinna balla'uwwa› dhaqqabo'a wode'inba'a me'inammaka qettelinna qabata hasissaan» hiyye. Tennexxe « ‹Naafuwwikinna balla'uwwi› mootummatike mine'ni e'yinabaani» hineechchi tennexxeeten.<verse eid="2SA 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 5:9" />Ookkoneechchi uduma Daawwitinna kolloti hana galduma ifika assedhe; bakka etteneenna «Daawwitike qachcha» hiyyeexxi summa fulcheeexxi; Daawwitinna Miillo'n ke'isse ookkone qachcha qarqara duuchcha ijaare. <verse eid="2SA 5:9" /><verse number="10" style="v" sid="2SA 5:10" />Lumoki Duuchchi Woddik Gootti Mageni isinni welti hedhemmaxxe Daawwiti barra barra'ninni jabaata'ni me'e.<verse eid="2SA 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 5:11" />Eetene yanna Xiroosike bogiki moyanji Kiraami Daawwitiba'a erga erge; iittanni biribirisiinxa haqqe, mine ijaaraaka mannanna kino bocaaka manna insa'nenni welti erge; insa'nenna Daawwiti'a mootummatika mine ijaare. <verse eid="2SA 5:11" /><verse number="12" style="v" sid="2SA 5:12" />Daawwitinna Duuchchi Woddik Gootti isoo Isira'eelike moyanjo asse hunna uwwe jabeesseexxanna Isira'eelike ardi'a hiyyee mootumma isixxa lummiseexxa ege'ne.<verse eid="2SA 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 5:13" />Daawwiti Kebiroonii'ni Iyyerusaalemi'a higeechchinni uduma edinxe melaallee'ni lebeexxi wele melaalluwwanna jaaluwwa adheeman; iittanni heddo labbaxxanna meyyaxxa oose i'leemman. <verse eid="2SA 5:13" /><verse number="14" style="v" sid="2SA 5:14" />Daawwiti Iyyerusaalemi hedhemma wodda i'leexxi oose: Shaamu'a, Shobaabi, Naataani, Solomooni, <verse eid="2SA 5:14" /><verse number="15" style="v" sid="2SA 5:15" />Yibihaari, Elishuu'a, Nefegi, Yaafi'a, <verse eid="2SA 5:15" /><verse number="16" style="v" sid="2SA 5:16" />Elishaama'i, Eliyada'inna Elifeelexiiramman.<verse eid="2SA 5:16" /></para>
  <para style="s1">Daawwiti Filisixxeemito Lole Injifate</para>
  <para style="r">(<ref loc="1CH 14:8-17">1 Odo. 14:8-17</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 5:17" />Daawwiti Isira'eelike moyanjo kadeexxa Filisixeemito laqqeexxa yanna isika hasito hunna jabeessexxexxi fulde; Daawwitii kinni tenne laqeexxi kollo ifixxiba'a adadde me'e. <verse eid="2SA 5:17" /><verse number="18" style="v" sid="2SA 5:18" />Eettene yanna Filisixeemito daggeexxi Raafayimixxe dhooqa'ni xexxerende kanbe abixxite. <verse eid="2SA 5:18" /><verse number="19" style="v" sid="2SA 5:19" />Tennexxe Daawwittinna Duuchchi Woddika Gootta, «Konne Filisixxeemika manna fule loloo? Anga anxe'ni sa'issite uuttatto?» hiyye laqe.</para>
  <para style="p" vid="2SA 5:19">Duuchchi Woddik Goottinna, «Eeti martetexxi loli; ani insa'nee anga atixxe'ni sa'isse uwwannon» hiyye hiisse.<verse eid="2SA 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 5:20" />Tennexxe Daawwiti Ba'aaliperaasimi'a mareexxi Filisixxeemito lole injifate. Isinna «Lola'i enqe e'yee findigammashsha Duuchchi Woddik Gootti naapha ani edo enqe» hiyye. Tennenaa'ni kexxeexxa ookkone boonchiki summi Be'al Feratsim hiyyeme. <verse eid="2SA 5:20" /><verse number="21" style="v" sid="2SA 5:21" />Filisixxeemito magenoonfatammaxxa fakkuwwa waalde baqateemmaxxee Daawwitinna isinni welti hedhemmaki manni booji'e adhdhe.<verse eid="2SA 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 5:22" />Filisixeemito higgeen daggeexxi Raafayimixxe dhooqa'ni xexxereende kanbe abixxite. <verse eid="2SA 5:22" /><verse number="23" style="v" sid="2SA 5:23" />Tennexxe Daawwiti higgeeni Duuchchi Woddika Gootta laqe; Duuchchi Woddiki Goottinna hiyyee qici, «Insa'nee udumii'n saxxe buqqetexxi ode'iinxe haqqe edi ga'mii'ni loli malee kalchakenaa'n insa'ne'ni martoxxee. <verse eid="2SA 5:23" /><verse number="24" style="v" sid="2SA 5:24" />Ode'iinxe qacce iimi'ni googeessiinka hafuura laqqottole eettene yanna'ni Duuchchi Woddik Gootti Filisixeemika loliinka manna lolo'a ati'a edise fule'een hiyyoten; eettene yanna atinna rakke rakke edi'a me'i» hiyye hiisse. <verse eid="2SA 5:24" /><verse number="25" style="v" sid="2SA 5:25" />Tennexxe Daawwitinna Duuchchi Woddik Gootti ajajemmashshanni asse; Filisixeemito Geba'ii'ni ke'isseexxi Geezeri qico'ni insa'nee lole shorre.<verse eid="2SA 5:25" /></para>
  <chapter eid="2SA 5" />
  <chapter number="6" style="c" sid="2SA 6" />
  <para style="s1">Kakotika Taabota Iyyerusaalemi'a Iyyedange</para>
  <para style="r">(<ref loc="1CH 13:1-14">1 Odo. 13:1-14</ref>; <ref loc="1CH 15:25-16:6">15:25—16:6, 43</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 6:1" />Daawwiti higgeenna Isira'eelike ardi giddii'ni filemeeka sase tomme kuma manna mitteba bukki asse. <verse eid="2SA 6:1" /><verse number="2" style="v" sid="2SA 6:2" />Daawwitinna welti isinni hedhemmaaki manni duuchchi Taaboti hana hexxeexxe Kirubeeli'ni hana ofo'leeke Dada Duuchcha Ajajaak Duuchchi Woddike Gootta Mageniinke summinni ye'emeeka Mageniinka kakotika taabota ookko'ni iyyedagatee Yihudake bogi giddo Be'aale hinaabaa me'ine.<note caller="-" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="EXO 25:22">Fula. 25:22</ref>. </char></note> <verse eid="2SA 6:2" /><verse number="3" style="v" sid="2SA 6:3" />Insa'nenna Mageniinka Kakotika taabota haaroxxe fadhadinxe gaare'ni uggineexxi tullichchake'ni hedheeke Abinadaabike minenaa'ni fulchineexxi iyyedange; fadhadiinxa gaare oonfammaxxi Abinadaabixxi oose Uuzanna Ahiyyo kandaa wodda,<note caller="-" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="1SA 7:1-2">1 Sam. 7:1-2</ref>. </char></note> <verse eid="2SA 6:3" /><verse number="4" style="v" sid="2SA 6:4" />Mageniink taaboti fadhadiinxe gaare'ni hana hedhe Ahiyyo edi edii'ni me'aamman. <verse eid="2SA 6:4" /><verse number="5" style="v" sid="2SA 6:5" />Daawwitinna Isira'eeliki ardi hadi duuchchi faaroti, masiinqoti, kiraariki, okolik, bilibilikinna, suusu'leti anfeexxe hunna duuchchinni Duuchchi Woddike Gootti edo shimminsa'emman.<verse eid="2SA 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 6:6" />Naakoonniinxe aldu'mebaa gennee wodda koromme gugguffatteemmaxxee, Uuza anga qeerriseexxi Isira'eelika kakoti taabota abide. <verse eid="2SA 6:6" /><verse number="7" style="v" sid="2SA 6:7" />Ooza soda'a gophati taabota tuqeemmaxxee Duuchchi Woddike Goottixxi iso'ni mufe iso'n bubbe; tennexxe Magenikinna isoo qoome; Oozanna Mageniinke taaboti bira reye. <verse eid="2SA 6:7" /><verse number="8" style="v" sid="2SA 6:8" />Ookkoneechchi uduma Duuchchi Woddike Goottixxi mufe Oozaa qaxa'a assitemmaxxee Daawwiti aare; iikki boonchi techchi qico'n Pereezi Ooza<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">Pereezi Ooza hiyya Ibritotike laagadinni Ooziyaxxe enqensha hiyyaten</char></note> hiyyemee ye'emeen.<verse eid="2SA 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 6:9" />Daawwitinna eettene barra Duuchchi Woddika Gootta sodaatemmaxxee, «Duuchchi Woddike Goottik taaboti hitta aniba daga?» hiyye. <verse eid="2SA 6:9" /><verse number="10" style="v" sid="2SA 6:10" />Tennexxe Daawwiti Duuchchi Woddike Goottik taaboti'a isinni welti hedhaashsha Daawwitike qachchibaa taabota adhdhe me'atee'e hasebaan; eettenexxa bado welenga ora Gaatike qachcha'ni hedha'neeka manjichcho Abidaarake miniba adhdhe me'e. <verse eid="2SA 6:10" /><verse number="11" style="v" sid="2SA 6:11" />Duuchchi Woddike Goottik taabotinna Gaatike qachchike manjichcho kadeeke Abidaarake mine'ni sase agenjo ture. Duuchchi Woddik Goottinna Abiduraanna isika mini hado duuchcha eebbise.<note caller="-" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="1CH 26:4-5">1 Odo. 26:4-5</ref>. </char></note><verse eid="2SA 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 6:12" />Konne wodda «Duuchchi Woddike Goottike taabotixxe buutonni Abidaarak mini hadinna horateelcho duuchcha Mageni isi'a eebisse» hineexxi insa'nenna Daawwiti'n kulle. Tennexxe Daawwiti ookko'a dirreexxi Mageniinka taabota Abiduurake minenaa'ni Daawwitike qachchibaa lumoxxe gammashshonni aadhe dage.<verse eid="2SA 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 6:13" />Iikki Duuchchi Woddike Goottika taabota dukeemmak manni jaanele takkaarro me'ineexxe qixxe'ni Daawwiti mitte jibichchanna mitte ha'yaxxa jabbe tolchaamman. <verse eid="2SA 6:13" /><verse number="14" style="v" sid="2SA 6:14" />Daawwitinna layinoti giisendeexxa efuude hidhake'ni ussudheexxi isi afeexxe hunna duuchchinni Duuchchi Woddike Gootti edo burraaqaamman. <verse eid="2SA 6:14" /><verse number="15" style="v" sid="2SA 6:15" />Konne qicinni Daawwitinna Isira'eeliki ardi duuchchi qeexala'ni malagata ufuufa'ni Duuchchi Woddike Goottika taabota alalle idange.<verse eid="2SA 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 6:16" />Duuchchi Woddike Goottik taaboti Daawwitike qachchibaa e'yaa wodda Sa'oolixxi belto Melkooli maskootette'ni hexxe uuda'nemman; moyanji Daawwitinna Duuchchi Woddike Gootti edo utaala'ninna shimmisa'naa uuddee wodda godobik isoo tuffate. <verse eid="2SA 6:16" /><verse number="17" style="v" sid="2SA 6:17" />Ookkoneechchi uduma Duuchchi Woddike Goottika taabota aa'ne dange Daawwiti oteeke duunkaan giddo e'yineshsheexxi isi'aanni qophphesemeeke booncho'ni taabota uggine; Daawwitinna ciincatika tolchanna mittoomiinka tolcha Duuchchi Woddike Gootti edo shiqishe. <verse eid="2SA 6:17" /><verse number="18" style="v" sid="2SA 6:18" />Daawwitinna ciincatika tolchanna mittoominka tolcha shiqisheechi uduma arda Dada Duuchcha Ajajatoke Duuchchi Woddike Gootta Mageniinke summinni eebbise. <verse eid="2SA 6:18" /><verse number="19" style="v" sid="2SA 6:19" />Isira'eelixxe gamo kadeeke ardi duuchchi'a meyya labbangee mitti mittinge manji'a mitte mitte wodhaamo, mitte mitte guma maalanna mitte mitte woyinetixxe gummaxxa uwwe. Ookkoneechchi uduma duuchchingi ifi ifike minibaa me'e.<verse eid="2SA 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 6:20" />Daawwitinna mini hado ifika eebbiso'a ifike minibaa higee wodda, Sa'oolixxi belto, Melkooli isoo qophexxo'a fuldeexxi, «Telcho Isira'eeliki moyanji ja'laabuwwinxe garbituwwa edo woyifulabaake manjishsha saali belo hedhe leellati yo'oshsha ulfaatebaata!» hite.<note caller="-" style="x"><char style="xo" closed="false">6:20 </char><char style="xt" closed="false"><ref loc="1CH 16:43">1 Odo. 16:43</ref>. </char></note><verse eid="2SA 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 6:21" />Daawwitinna isee hiyyee qici, «Eeti atika annanna isike mini giddo hedheeke duuchchanaa'ni anee caalchise Duuchchi Woddike Goottika arda Isira'eeli'n moyanjoke assee ane'e fe'leeke Duuchchi Woddike Gootti edo shimmisannon; ta'anna lebe shimmisannon. <verse eid="2SA 6:21" /><verse number="22" style="v" sid="2SA 6:22" />Wele waalinni tenne mannii'ni isi edo ifi heeshi assannon; konne caala ifi salphisannon; yaane kinni summissettexxe garbuwwa edo ulfaatannon.»<verse eid="2SA 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 6:23" />Sa'oolixxi belto Melkooli rertaaxxe barra qico'n ildebaan.<verse eid="2SA 6:23" /></para>
  <chapter eid="2SA 6" />
  <chapter number="7" style="c" sid="2SA 7" />
  <para style="s1">Mageni Daawwiti'a Ageexxa Kako</para>
  <para style="r">(<ref loc="1CH 17:1-15">1 Odo. 17:1-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 7:1" />Moyanji ifike mootummatike mine'ni ti'ni hiyye ofo'lee'nanna Duuchchi Woddik Gootti isike qarqara'ni hedheeke naapha isike duuchchanaa'ni hafuura adhdhiseechchi uduma, <verse eid="2SA 7:1" /><verse number="2" style="v" sid="2SA 7:2" />isinna wabeeka Naataani'n hiyyee qici, «Kunse, ani birbirsik ijaarremeeke mootummatike mini giddo hedhaannen; Mageniinki taaboti kinni duunkaani giddo hedha'neen» hiyye.<verse eid="2SA 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 7:3" />Naataaninna isoo, «Duuchchi Woddik Gootti atinni welti hedhemmaxxee ati heddettexxa duuchcha assi» hiyye.<verse eid="2SA 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 7:4" />Eettene hashsha Duuchchi Woddike Goottiki hiyyichchi Naataani'n dageexxi hiyyee qici, <verse eid="2SA 7:4" /><verse number="5" style="v" sid="2SA 7:5" />«Martettexxi erganjo anka Daawwiti'i, ‹Duuchchi Woddik Goottti hiyya'nee qici; ani hedhannoka mine ani'a ijaartattoki atetebaan; <verse eid="2SA 7:5" /><verse number="6" style="v" sid="2SA 7:6" />Isira'eelito Gibtseke boganaa'n fulchennexxe barranaa'n techchi qico'ni duunkaana galduma anke assedhee mitte boonchonaa'n wele booncho marene malee mini giddo galebe'noni. <verse eid="2SA 7:6" /><verse number="7" style="v" sid="2SA 7:7" />Isira'eelito ardi duuchchinni welti me'ene booncho duuchcha'ni arda anka Isira'eeli'i heqqinaashsha ajajeneka akeekisanuwwi giddii'n mitte, birbinsiinke haqichchinni mayee ani'a mine ijaara gophphete? Hiyyennek meya hedhee?› » no'o'ni hiyye.<verse eid="2SA 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 7:8" />«Tennexxe erganjo anka Daawwiti'i hitatto qici, ‹Dad Duuchcha Ajajake Duuchchi Woddik Gootti Mageni hiyya'nee qici; ati horiinxa duuka me'ita'na'a arda anke Isira'eeli galchitotta'a atee ke'issennen; gedhebiinxe allale giddii'ni atee aadhenne. <verse eid="2SA 7:8" /><verse number="9" style="v" sid="2SA 7:9" />Martetteke booncho duuchcha'ni ani atinni welti hedhennan; naaphuwwa atika duuchcha ati edii'ni fiisennen; ta'anna summi insa'neeki buttate'ni jajemeeke yo'oshsha lummedheeke mannanaa'ni mittiishsha summa atika lummisannon. <verse eid="2SA 7:9" /><verse number="10" style="v" sid="2SA 7:10" />Ifika galdumiimika mine afaashshanna ta'inni elqe'a daaqabaasha arda anke Isira'eeli'a booncho uwwannon; jabeessannon. Konneechchi edo kaddeemmashsha ta'inni elqi'a fuggoki ardi isoo miicabaan. <verse eid="2SA 7:10" /><verse number="11" style="v" sid="2SA 7:11" />Arda anke Isira'eeli'aanna akeekisanjuwwa hariirennexxe yannanaa'ni ke'isse assinemmashsha duuchcha ta'anni edi'a insa'ne'n assinabaan; iittanni atike naaphuwwa duuchchanaa'ni atee heqqannon.</para>
  <para style="p" vid="2SA 7:11">« ‹Duuchchi Woddik Gootti umi isingenninni mine ati'a ijaara'neexxa ate'ni kula'neen: <verse eid="2SA 7:11" /><verse number="12" style="v" sid="2SA 7:12" />Cinde bututtee edike annuwwa atikishshanni lummexxatto wodda atixxa bakka gudeeda atikenaa'ni ilemaaka sanne atixxenaa'ni ke'issannon; mootumma isixxanna kutabelo hexxaashsha assannon.<note caller="-" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="PSA 89:3-4">Far. 89:3-4</ref>; <ref loc="PSA 132:11">132:11</ref>; <ref loc="JHN 7:42">Yoh. 7:42</ref>; <ref loc="ACT 2:30">Erga. Huj. 2:30</ref>. </char></note> <verse eid="2SA 7:12" /><verse number="13" style="v" sid="2SA 7:13" />Anke summi'a mine ijaaraki isoten; aninna mootumma isixxixxa moote duuchchi woddi'a jabeessannon. <verse eid="2SA 7:13" /><verse number="14" style="v" sid="2SA 7:14" />Aninna isi'a annake kadannon; isinna belto anke kadaan. Isinna balleessoole kinni manji ganemammaxxe siqqonni isoo ganannon; anni belto ifika halangeti jadhafammashsha aninna iso'o jadhafannon.<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="PSA 89:26-27">Far. 89:26-27</ref>; <ref loc="2CO 6:18">2 Qor. 6:18</ref>; <ref loc="HEB 1:5">Ibr. 1:5</ref>. </char></note> <verse eid="2SA 7:14" /><verse number="15" style="v" sid="2SA 7:15" />Kaddo malee mararte anxa ati edo hedhemmake Sa'oolinaa'n bayyiseneeshsha isonaa'ni bayyisabe'non. <verse eid="2SA 7:15" /><verse number="16" style="v" sid="2SA 7:16" />Atik mininna mootumma atixxi ani edo duuchchi wodda kutabelo hexxaan; moote atixxinna iittanni duuchchi woddi'a ti'nite hexxaan.› »<note caller="-" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="PSA 89:36-37">Far. 89:36-37</ref>. </char></note><verse eid="2SA 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 7:17" />Naataaninna konne duuchchinge waleelaka hiyyichcho duuchcha Daawwiti'ni kule.<verse eid="2SA 7:17" /></para>
  <para style="s1">Daawwitixxa Soodachcho</para>
  <para style="r">(<ref loc="1CH 17:16-27">1 Odo. 17:16-27</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 7:18" />Ookkoneechchi uduma moyanji Daawwiti Duuchchi Woddik Gootti edo hiyyee qici:</para>
  <para style="pm" vid="2SA 7:18">«Ee dada duuchchike Duuchchi Woddike Goottaa! Tenne duuchcha ani'a assitetteki ani ayyete? Hadi ankinna hoonte kade? <verse eid="2SA 7:18" /><verse number="19" style="v" sid="2SA 7:19" />Dada duuchchike Duuchchi Woddike Goottaa tinni ati edo heenoxxe kaddee'nani ati kinni edi'a hexxeexxe atike erganjixxe hortexxee haasotteten; ee dada duuchchike Duuchchi Woddike Goottaa ati adana manjokee itta assitatte hiyotee?<verse eid="2SA 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 7:20" />«Ani Daawwiti konneechchi iima maa hiyya dande'anno? Ee dada duuchchike Duuchchi Woddike Goottaa anee erganjo atika atinni egendeettaxxee! <verse eid="2SA 7:20" /><verse number="21" style="v" sid="2SA 7:21" />Atike hiyyichchixxeenna atike godobike yaadi'a tenne jabaxxa yaane assiteeten; erganji atike ege'nannoshsha assiteeten.<verse eid="2SA 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 7:22" />«Ee dada duuchchike Duuchchi Woddike Goottaa! Ati lumoken! Atishsha hedheeki hara ayyinna hedhebaan mansha no'oxxinni laqeneshshanni atee malee Mageni hedhebaan. <verse eid="2SA 7:22" /><verse number="23" style="v" sid="2SA 7:23" />Arda afike kado'a anjireekee, Mageni isi edo me'eeke ardishsha, ifike summi ege'nemaashsha, gosa gosaka ardanna magenuwwa insa'neka ifi edii'ni shorree lumoxxanna sodaachchisaaka mambe'a isi'a assemmaashshanna Gibtsee'n anjiremmashshanni atike Isira'eelike ardishsha buttate'ni hedheeki ardi ayyete?<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="LEV 4:34">Lew. 4:34</ref>. </char></note> <verse eid="2SA 7:23" /><verse number="24" style="v" sid="2SA 7:24" />Arda atika Isira'eeli'i duuchchi wodda ti'ni hiyye hedhaashsha assitette; Duuchchi Woddike Goottaa atinna Mageno insa'neeke kaddeetten.<verse eid="2SA 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 7:25" />«Ta'anna Duuchchi Woddike Gootta Magenoo erganjo atikeenna mini hadi'a uutettaxxa addachchiisa duuchchi woddi'a heqqi; haasotteteshshanni muuxxi. <verse eid="2SA 7:25" /><verse number="26" style="v" sid="2SA 7:26" />Tennexxe summi atik duuchchi woddi'a Gurri lumoke kadaani. Ookkoneechchi uduma mannikinna hiyyee qici, ‹Dada Duuchcha Ajajak Duuchchi Woddik Gootti Mageni Isira'eelike Magenon!› hina'neen. Erganjo atike Daawwitik mini ati edo ti'n hiyye hedhaan.<verse eid="2SA 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 7:27" />«Ee, Dada Duuchcha Ajajaak Duuchchi Woddike Gootta Isira'eelike Magenoo, ‹Ani ati'a mine ijaarannon› hite erganjo atikee ani'a barrise'eten. Tennexxe erganji atiki tenne soodachcho atibaa hunna alfeennen. <verse eid="2SA 7:27" /><verse number="28" style="v" sid="2SA 7:28" />Ee dada duuchchike Duuchchi Woddike Goottaa ati Magenokeni hiyyichchi atikinna xuurameesaken; tenne elolla yaane assitotta'a anee erganjo atika addachchiiseten. <verse eid="2SA 7:28" /><verse number="29" style="v" sid="2SA 7:29" />Ati edo duuchchi woddi'a tii'ni hiyye hedha ta'anna erganjo atikinna mini hado eebba atixxinni maganneten eebbisi. Dada duuchchik Duuchchi Woddike Goottaa tennee ati umi atinginninni haasotetten; eebba atixxenni erganji atikiki anki mini duuchchi woddi'a eebbisemaan.»<verse eid="2SA 7:29" /></para>
  <chapter eid="2SA 7" />
  <chapter number="8" style="c" sid="2SA 8" />
  <para style="s1">Daawwiti Lole Injifateexxa Injifachchuwwa</para>
  <para style="r">(<ref loc="1CH 18:1-17">1 Odo. 18:1-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 8:1" />Ookkoneechchi uduma Daawwiti Filisixeemito lolee injifatee anga ifixxe'ni ibirse. «Meettegi Ama» hiyyemaaaka qachcha Filisixxeemitotena'ni adhdhe.<verse eid="2SA 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 8:2" />Iittanni Daawwiti Mo'aabito lole injifate; isinna insa'nee butta karee wodaroti mike; wodaroti mikemmakeeranaa'ni lame shiya'ni sakkaka kinni lubbondinni waala'nemman. Tennexxee Mo'aabito Daawwiti'a hirende irbo isi'a uuta'nemman.<verse eid="2SA 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 8:3" />Ookkoneechchi uduma Daawwiti Efiraaxisike galaani bira hedheeka boga ifi'ni hiissedho'a maree wodda Tsobaka mayonjo, Re'aabika belto Hadaadi'ezerii'i lole. <verse eid="2SA 8:3" /><verse number="4" style="v" sid="2SA 8:4" />Daawwitinna mitte kuma fadhadiinxa gaaruwwa, torbaane kuma fadhadik lolaaka manna buttii'ni lolaaka lame tomme kuma manna booji'e. Laakkossi insa'nek dhibba geyeeki gaare harkisaammak fadhadi calli gataa wodda wele duuchchinga mogole wowwoxxe.<verse eid="2SA 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 8:5" />Demaasiqoxxi Sooriyito Tsobaka moyanjo Hadaadi'ezeri gargaartoa dagee wodda Daawwiti lame tommenna lame kuma insa'neka manna shiye. <verse eid="2SA 8:5" /><verse number="6" style="v" sid="2SA 8:6" />Ookkoneechchi uduma Demaasiqoxxe galcha kadeeke Sooriyitotike boga'ni loliinxa kaambe uurise. Soriyitotinna Daawwiti'a hirendee hirbo uute. Duuchchi Woddik Goottinna Daawiti maree booncho duuchcha'ni injifataashsha asse. <verse eid="2SA 8:6" /><verse number="7" style="v" sid="2SA 8:7" />Daawwitinna Hadaadi'ezerika ja'laabuwwi abixxiteemmaxxa worqetixxa wontuwwa booji'eexxi Iyyerusaalemi'a adhdhe dage. <verse eid="2SA 8:7" /><verse number="8" style="v" sid="2SA 8:8" />Ittani moyanji Daawwiti Hadaadi'ezeri galchamake Beexahinna Beerotayi hine ye'naake qachchuwwinaa'ni heddo sageetuwwa aadhe.<verse eid="2SA 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 8:9" />Hamaatik moyanji To'u Daawwiti Hadaadi'ezerika sannachcha duuchcha injifateexxa laqeexxa yanna, <verse eid="2SA 8:9" /><verse number="10" style="v" sid="2SA 8:10" />To'u Hadaadi'ezerinni welti duuchchi wodda lolemaammaxxenna Daawwiti Adi'aazar lole injifateemaxxee nage'akanna gammashshotixxa erga Daawwiti'a shiqisho'a belto ifika Yoraamii'i erge; isinna birreti siblijo, worqetikanna sageetotika miya isi'a aadhe mare. <verse eid="2SA 8:10" /><verse number="11" style="v" sid="2SA 8:11" />Moyanji Daawwitinna edike gosa gosake moyanjuwwa duuchchanaa'ni irbo adhammaxxa bireti sibljonna worqe edi wodda assemmashanni Duuchchi Woddike Gootti'a foye. <verse eid="2SA 8:11" /><verse number="12" style="v" sid="2SA 8:12" />Edoomi, Mo'aabi, Amoonito, Filisixeemitonna Amaaleeqito moyanjuwwi uwwemmaxxa irbo. Iitanni Tsobaka moyanjo Re'aabike belto Hadaadi'ezerina'ni adhdheemmaxxa booji'o Magenoke'e foye.<verse eid="2SA 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 8:13" />Daawwiti maxinetixxe dhooqa hiyyemaake booncho'ni tommenna saddeeta kuma Edoomito shiye higeechchi uduma summi isik saademe.<note caller="-" style="x"><char style="xo" closed="false">8:13 </char><char style="xt" closed="false"><ref loc="PSA 60">Far. 60</ref>. </char></note><verse eid="2SA 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 8:14" />Isinna Eedoomike boga duuchcha'ni loliinxa kaanbuwwa uurrise; Eedoomito duuchcha Daawwiti'a hirende; Duuchchi Woddik Goottinna Daawwitii maree boncho duuchcha'ni injifataashsha asse.<verse eid="2SA 8:14" /></para>
  <para style="s1">Daawwitika Ja'laabuwwa</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 8:15" />Daawwitinna Isira'eelike boga duuchcha'n moyeexxi arda duuchcha'n toggittenna dhugaatixxa murte mura'ni galche. <verse eid="2SA 8:15" /><verse number="16" style="v" sid="2SA 8:16" />Tsuriyak belti Iyyo'aabi loliinke mannike sooresa kadaa wodda Ahiluudik belti Iyyoosafiixinna jirtetike borreesanjomman. <verse eid="2SA 8:16" /><verse number="17" style="v" sid="2SA 8:17" />Iittanni Ahixuubik belti Saadooqinna Abiyataarik belti Abemelek qeesete kandaa wodda Seeraya borreesanjokemmani. <verse eid="2SA 8:17" /><verse number="18" style="v" sid="2SA 8:18" />Yoodahek beliti Bennayaasi Kelitotikenna Felitotike sooresa kandaa woddaa Daawwitixxi labbaxxi oose kinni mootummatike mini'a mari'etike mannamman.<note caller="+" style="f"><char style="fr" closed="false">8:18</char><char style="ft" closed="false">yookaan «qeese» hiyyeme tikema dandeessissaan</char></note><verse eid="2SA 8:18" /></para>
  <chapter eid="2SA 8" />
  <chapter number="9" style="c" sid="2SA 9" />
  <para style="s1">Daawwitinna Menfeboosheti</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 9:1" />Daawwitinna, «Yoonataanixxee hiyyee eloxxa isi'a assannoshsha Sa'oolike mini hadinaa'ni hafe gateeki hedhe lati?» Hiyye qore.<note caller="-" style="x"><char style="xo" closed="false">9:1 </char><char style="xt" closed="false"><ref loc="1SA 20:15-17">1 Sam. 20:15-17</ref>. </char></note><verse eid="2SA 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 9:2" />Ookkone wodda Sa'oolike mini hadonaa'n Siiba hiyyemaak mitti erganji hedheemmaxxee, Daawwitibaa me'aashsha kulle. Moyanjikinna, «Siibate hina'neeki atetee?» hiyye qore.</para>
  <para style="p" vid="2SA 9:2">Isinna, «Eeti ani atike erganjon» hiyye.<verse eid="2SA 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 9:3" />Moyanjinna, «Mageni eeyyaxxa eloxxa yaane isi'a assona'a Sa'oolike mini hadonaa'ni gateeki manji hedhebaa?» hiyye laqe.</para>
  <para style="p" vid="2SA 9:3">Siibanna moyanjo, «Lekka naafe'eki mitti Yoonataanik balti hedheen» hiyyee isi'a hiisse.<note caller="-" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="2SA 4:4">2 Sam. 4:4</ref>. </char></note> <verse eid="2SA 9:3" /><verse number="4" style="v" sid="2SA 9:4" />Moyanjikinna, «Isi habata hedhee?» hiyye qore.</para>
  <para style="p" vid="2SA 9:4">Siibanna, «Lodebaari hiyyendaaxxe bakka'ni Ami'eelik belto Makirike mine'ni hedheen» hiyye hiisse. <verse eid="2SA 9:4" /><verse number="5" style="v" sid="2SA 9:5" />Tennexxe moyanji Daawwiti, Menfebosheetee Ami'eelika belto Makirike minenaa'ni Lodebaarii'n manjo ergee iyyedangaashsha asse.<verse eid="2SA 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 9:6" />Sa'oolike beltik belti Yoonataanik belti Mefibosheeti Daawwitibaa dageexxi albi buttina tuqa qico'ni heeshshi hiyye ulfeesse.</para>
  <para style="p" vid="2SA 9:6">Daawwitinna, «Menfebosheeti!» hiyye isoo ye'e.</para>
  <para style="p" vid="2SA 9:6">Menfebosheetenna «Hee anke gootta» hiyye. <verse eid="2SA 9:6" /><verse number="7" style="v" sid="2SA 9:7" />Daawwitinna, «Meeco'o sodaattoxxee; anni atikixxe Yoonataanixxee hiyyee dhugaandinni eloxxa yaane ati'a assannon; atike akka'ika Sa'oolika boga duuchcha ati'a hiissannon; atinna duuchchi wodda anxe qorenaa'ni ittatton» hiyye.<verse eid="2SA 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 9:8" />Menfebosheeti albi buttina tuqaa qico'ni heeshshi hiyye anga iimi'a ke'isseexxi; «Reyeeke wolchishsha uudemannoke ani'a tenne duuchcha assitaatek erganji atiki ani ayyete isi?» hiyye. <verse eid="2SA 9:8" /><verse number="9" style="v" sid="2SA 9:9" />Ookkoneechchi uduma Sa'oolika erganjo Siibaa'a ye'eexxi hiyyee qici, «Sa'oolinna isike mini hado kadeeke kadeechcho duuchcha atike goottike beltike belti'a uwweennen. <verse eid="2SA 9:9" /><verse number="10" style="v" sid="2SA 9:10" />Ati, atixxi labbaxxi oosenna atiki erganjuwwi ha'nooke goottik beltik belti itaachcho alfaashsha fichcha isika hujje; midhatanna isi'a aasse. Atik goottik belti Mefibosheeti kinni duuchchi wodda aninni welti anxe qorenaa'ni itaan.» Ookkone wodda Siiba tommenna onde labbaxxa oosenna lame tomme erganjuwwa afeemman.<verse eid="2SA 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 9:11" />Ookko'ni Siibanna moyanjo, «Anke gootta moyanji erganjo atikee ajajeeka duuchcha, atik erganjinna muuxan» hiyye. Tennexxe Mefibosheeti moyanjiinxe oose giddii'ni kadee Daawwitinna mitte qore'ni itaamman. <verse eid="2SA 9:11" /><verse number="12" style="v" sid="2SA 9:12" />Mefibosheeti Miika hiyyemaaka mitte shiixoka belto afeemman; Siibak mini hadi duuchchi Menfeboshete'a ergatemaamman. <verse eid="2SA 9:12" /><verse number="13" style="v" sid="2SA 9:13" />Mefibosheetinna duuchchi wodda moyanjiinxe qorenaa'ni ita ita'nemmaxxee Iyyerusaalemii'i hedhaamman; isinna lamiinxa lekka naafeman.<verse eid="2SA 9:13" /></para>
  <chapter eid="2SA 9" />
  <chapter number="10" style="c" sid="2SA 10" />
  <para style="s1">Daawwiti Amoonitonna Soriyito Injifate</para>
  <para style="r">(<ref loc="1CH 19:1-19">1 Odo. 19:1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 10:1" />Konneechchi uduma Amoonik moyanji reye; belti isiki Hanooninna isixxe bakka'ni moye. <verse eid="2SA 10:1" /><verse number="2" style="v" sid="2SA 10:2" />Daawwitinna, «Anni isiki eloxxa ani'a asseemmashshanni aninna Na'oosike belto Amooni'a eloxxa assannon» hiyye hede. Tennexxe anni isikixxe reyo'aa alayyo hedhenni hexxinee hiyyaaka manna Daawiti erge.</para>
  <para style="p" vid="2SA 10:2">Daawwitiki manni Hamoonitotike bogibaa gennee wodda, <verse eid="2SA 10:2" /><verse number="3" style="v" sid="2SA 10:3" />Amoonitotik ja'laabuwwi gootta insa'neeka Hanooni'i «Daawwiti alayyo hedhen hexxette hiyyaaka manna ergiyyo isixxi anna atika ulfeeseechcho ate'ni labbe'ee? Isinna ergeeki manni qachcha, dooyyeenna balleessashshatebaa?» hine.<verse eid="2SA 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 10:4" />Tennexxe Hanooni Daawwitika manna abixxeexxi, mitti mittingika areeda gama haadee gama gatise; seemma insa'nexxanna hidha hidhake'ni harunse harunse woxxeexxi shorre. <verse eid="2SA 10:4" /><verse number="5" style="v" sid="2SA 10:5" />Daawwitinna tennee odo laqee wodda manni yo'oshsha shookemmaxxee moyanjikinna «Areedi ha'nook nophphaa qico'n Iyyaariko giddo turre ookkonechchi uduma higginaan» hiyyee erga erge.<verse eid="2SA 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 10:6" />Amoonito Daawwiti insa'nee'a naaphake kadeexxa egendeexxi, Betirehoobinaa'ninna Suubanaa'ni lame tomme kuma buttii'ni lolaaka Sooriyitotika lolii manna iittanni Ma'ikaka mowanjo mitte kuma manninni, higgeenni Xoobinaa'ni tommenna lame kuma loliinka manna maallaqik adhdhine. <verse eid="2SA 10:6" /><verse number="7" style="v" sid="2SA 10:7" />Daawwitinna tenne laqee wodda, Iyyo'aabi'i loliinke manni duuchchinni welti duulchise. <verse eid="2SA 10:7" /><verse number="8" style="v" sid="2SA 10:8" />Amoonito fuldeexxi ifike qachchi giddi'a e'yatixxe hulaba qececce; Suubaxxinna Re'aabixxi Sooriyito iittanni Xoobikinna Ma'ikak manni qofitti diidake'ni qacecce.<verse eid="2SA 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 10:9" />Iyyo'aabinna edii'ninna udumii'ni loliink manni buqeexxa uudeexxa yanna; Isira'eeli giddii'ni lolakee jannuntet ege'nemeeke manni giddii'ni heenoka fileexxi Sooritotike bagedi edi darre'n bakka abixxaashsha asse. <verse eid="2SA 10:9" /><verse number="10" style="v" sid="2SA 10:10" />Gateemmak manni kinni isike dayyo Abisayixxe akeette hunda uggeexxi Abisake bagedi edo Amoonitoti edi darre bakka abixxinaashhsa asse. <verse eid="2SA 10:10" /><verse number="11" style="v" sid="2SA 10:11" />Iyyo'aabinna hiyyee qici, «Soorito anxe hunna iimi ga'ma kada'noole ati dagge anee gargaartatton; Amoonito atixxe hunna iimi ga'ma kadda'noole ani dage atee gargaarannon. <verse eid="2SA 10:11" /><verse number="12" style="v" sid="2SA 10:12" />Yooni meeccoo jabaati! Arda no'okenna Mageno no'oke qachchuwwi'a jannumati lollo; Duuchchi Woddik Goottinna iso'n eloxxe labbe leelliteexxa assowwaal.»<verse eid="2SA 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 10:13" />Ookkoneechchi uduma Iyyo'aabinna isinni welti hehdemak loliinki manni Soorito lolatee edi'a me'e; Sooritonna insa'ne edii'ni baqatte. <verse eid="2SA 10:13" /><verse number="14" style="v" sid="2SA 10:14" />Sooritonna bajjeexxa Amoonito uuddexxi; insa'nenna Abisa edii'ni baqante qachchi giddi'a e'yine. Tennexxe Iyyo'aabi Amoonito lola waaleexxi Iyyerusaalemi'a hige.<verse eid="2SA 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 10:15" />Soorito Isira'eelitotike bagedo'n injifatendeexxa uudeexxi, higgeenni bukki hine. <verse eid="2SA 10:15" /><verse number="16" style="v" sid="2SA 10:16" />Adiri'aza'are erga ergeexxi wode'i wido hexxeexxa Soorito iyyedangaashsha assi; insa'nenna Hadaadi'ezerika sannachchuwwike ajajallo Soobaakixxe akeetenni Elaami'a me'ine. <verse eid="2SA 10:16" /><verse number="17" style="v" sid="2SA 10:17" />Daawwitinna tenne laqe wodda Isira'eeli duuchcha bukki asse; ookko'ninna Yordaanoosi foofee Elaami'a me'e; Sooritonna lolakee qececeexxi Daawwitinni lola ibbe; <verse eid="2SA 10:17" /><verse number="18" style="v" sid="2SA 10:18" />Kaddo malee'e insa'nenna Isira'eeli edii'ni baanje; Daawwitinna torbaane dhibba loliinxa gaaruwwanna shoole tomme kuma buttii'n lolaaka manna<note caller="+" style="f"><char style="fr" closed="false">10:18 </char><char style="ft" closed="false">Buttii'n lolaaka manna hiyyendeexxa Torbanne tomme beekkole fadhado gulufaamma manna hitaan</char></note> insa'neka shiye. Iittanni insa'neka loliinka akeekisanjo Soobaakii'i madeessineemaxxee ookkonni reye. <verse eid="2SA 10:18" /><verse number="19" style="v" sid="2SA 10:19" />Hadaadi'ezerixxe baale hunda hedheemmaki moyanjuwwi duuchchi Isira'eeli injifatteexxa uudeexxi Isira'eelinni welti araaremmeexxi isa'ne'a hiremme.</para>
  <para style="p" vid="2SA 10:19">Tennexxe Soorito ookkoneechchi uduma Amoonito gargaara sodaate.<verse eid="2SA 10:19" /></para>
  <chapter eid="2SA 10" />
  <chapter number="11" style="c" sid="2SA 11" />
  <para style="s1">Daawwitinna Bersaabehi</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 11:1" />Moyanjuwwi lolakee fulamaxxe midha facaansammaxxe yanna'ni Daawwiti Iyyo'aabi'i moyanjuwwinke manninninna Isira'eelike loliinke manni duuchchinn welti duullaashsha asse; insa'nenna Amoonito injifanteexxi Raaba hiyyemaaka qachcha bunqe; eettene yaanna Daawwiti kinni Iyyerusaalemi gateemman.<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="1CH 20:1">1 Odo. 20:1</ref>. </char></note><verse eid="2SA 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 11:2" />Mitte galgala Daawwiti diiphii'ni ke'eexxi mooyatike minixxe xeleepho'ni da'me elqe kayya mammarema'nemman; xeleephonde'ni hedhe manjichcho mitte biso anshexxa'naa afe; manjichchotinna danchumma gunde gungudeexxemman. <verse eid="2SA 11:2" /><verse number="3" style="v" sid="2SA 11:3" />Daawwitinna ayyixxe kaddeexxa qoro'a manjo ise'n erge; manjichchikinna «Isi tinni manjichcho Eli'aami i'leexxe, Hiitichcho Ooriyoxxi are Bersaabehitebaa?» hiyye. <verse eid="2SA 11:3" /><verse number="4" style="v" sid="2SA 11:4" />Ookkoneechchi uduma Daawwiti erganjuwwa irgiseexxi isee aa'ne dangaashsha asse; Bersaabehinna isi hedhemmake miniba'a e'yite; isinna isenni welti diiphe. Eettene yanna manjichchotena'n dubartettixxi aada dagge saxxe'naa seeriinxe aadashsha ca'a hitemman. Isenna ookko'ni ifike miniba'a illeema higge. <verse eid="2SA 11:4" /><verse number="5" style="v" sid="2SA 11:5" />Manjichchotinna siila'wite; Daawwiti'ninna «Siila'weennen» hiteexxi erga ergite.<verse eid="2SA 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 11:6" />Tennexxe Daawwiti Iyyo'abi'n, «Hiitichcho Ooriyoo'o anibaa ergi» hiyyeexxi erga erge. Iyyo'abinna Ooriyooni'i Daawwitibaa erge. <verse eid="2SA 11:6" /><verse number="7" style="v" sid="2SA 11:7" />Ooriyonna dagee wodda Daawwiti «Iyyo'aabinna sannachchi duuchchi nage'inginni hedhe? Loliinxi odo hittate?» hiyye qore. <verse eid="2SA 11:7" /><verse number="8" style="v" sid="2SA 11:8" />Ookkoneechchi uduma Daawwiti Ooriyo'o, «Kexxe mini'a martettexxi lekka anshedhi» hiyye. Ooriyonna mootumatike minenaa'ni fule me'e, moyanjikinna itaachcho duuka erge. <verse eid="2SA 11:8" /><verse number="9" style="v" sid="2SA 11:9" />Yaane kinni Ooriyo moyanjuwwiinke erganjuwwinni welti mootetike minike dalla'ixxe hulaba diiphe malee'e mini ifikiba'a adadde'a dirre me'eemmabaan. <verse eid="2SA 11:9" /><verse number="10" style="v" sid="2SA 11:10" />Daawwitinna, «Ooriyo mini ifikiba'a me'ebaan» hinaaxa odo laqeexxi Oriyoo, «Orii'ni ta'a reefitebaa daggeetek? Ifike miniba'a mayee mara gophphete?» hiyye laqe.<verse eid="2SA 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 11:11" />Ooriyonna Daawwiti'i, «Taaboti, Isira'eelinna Yihudak ardi duunkaani giddo hedheexxi; gootti anki Iyyo'abinna anke goottik manni diidake'ni he'ne'naa; ani itonaanna ha'wonna'a iitanni anxe arenni welti diiphonna'a hitta ani mine ankiba me'anno? Aninna iitta hexxeexxa yaane hara assabo'non!»<verse eid="2SA 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 11:12" />Ookkoneechchi uduma Daawwitinna Ooriyo'o hiyyee qici: «Yooni telcho kabanni galde'naa soodo ookko'a higge me'itattoshsha asaannon» hiyye. Tennexxe Ooriyo eettene barranna langaxxa barra Iyyerusaaleminni ture. <verse eid="2SA 11:12" /><verse number="13" style="v" sid="2SA 11:13" />Langa baro Daawwitinna Ooriyoo isinni welti hirbaata ito'a ye'eexxi itise ha'wise; machcheesse; bogi hashshee wodda Ooriyoo ifike goottike eriganjuwinni welti ifixxa fa'wammaxxa seemma fa'we galo'a me'e malee mini ifikiba'a me'ebaan.<verse eid="2SA 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 11:14" />Gorsa bariisanni Daawwiti Iyyo'aabi'a borro borresseexxi Ooriyo'ni erge. <verse eid="2SA 11:14" /><verse number="15" style="v" sid="2SA 11:15" />Borreessendeexxe borreessanna hitaamma qici, «Ooriyoo'o loli eebbeke booncho'ni edo sa'issi; ookkoneechchi uduma oteme reyaashsha isoo waaldine'e baqatte» hitaaxemman. <verse eid="2SA 11:15" /><verse number="16" style="v" sid="2SA 11:16" />Tennexxe Iyyo'aabi qachcha buqe abide hedheexxa yanna, naaphi haranga e'yabaasha kuteeke gama'ni Ooriyoo'o edo sa'isse. <verse eid="2SA 11:16" /><verse number="17" style="v" sid="2SA 11:17" />Qachchiinki manni fuleexxi Iyyo'aabinni welti lola gence hiyye; Daawwitike lolinke manni giddi'ni heenok manni reye; itaanni Hiitichchi Ooriyonna reye.<verse eid="2SA 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 11:18" />Iyyo'aabinna lolake'ni kaddeexxa duuchcha Daawwiti'n erge sa'isse. <verse eid="2SA 11:18" /><verse number="19" style="v" sid="2SA 11:19" />Erga marammakanna hiyyee qici: «Tenne lolinxa odo moyanjoke'n kuldetelchi uduma, <verse eid="2SA 11:19" /><verse number="20" style="v" sid="2SA 11:20" />moyanjikinna mufateexxi atee ‹Insa'nee lolidino'a qachchiinba mayee shiqqine martine? Kinjiinke dalla'a'ni hana he'ne mogido ha'no'ni darbinaaxxa egendineebaa? <verse eid="2SA 11:20" /><verse number="21" style="v" sid="2SA 11:21" />Yirubesheetika<note caller="+" style="f"><char style="fr" closed="false">11:21 </char><char style="ft" closed="false">Gedewoon, </char><char style="fqa" closed="false">Yirbe'eel </char><char style="ft" closed="false">hiyyemati ege'nemaan. </char></note> belto Abemelekii'i shiyyeeki ayyete? Tebesi hiyyemaake booncho'ni kinjinke dala'i iimi'ni daaminka kinjo daribite shilteexxi mitte meyyaaxxe manjichchobaa? Yoona ha'nota kinjiinke dalla'i biri'a shiqineechchi mayyeete?› hiyye atee qoroole, atinna iso'n hite hissitatto qici, ‹Erganji atiki Hiitichchi Ooriyonna reyedhen› hite kuli» hiyye.<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="JDG 9:53">Hay. 9:53</ref>. </char></note><verse eid="2SA 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 11:22" />Tennexxe erganjikinna ke'exxi mare; ookko geyyeseshshanni Iyyo'aabi hiyyemmaxxa duuchcha Daawwiti'ni kule. <verse eid="2SA 11:22" /><verse number="23" style="v" sid="2SA 11:23" />Erganjikinna Daawwiti'ni hiyyee qici, «Naaphi hunna no'oxxi iimi darre kade; no'onna lolo'a fuleexxi diidin qico'ni dage; no'onna qachchinke dalla'ixxe hula qico'ni wirrissine shorrinenneni. <verse eid="2SA 11:23" /><verse number="24" style="v" sid="2SA 11:24" />Ookkoneechchi uduma kinjiinke dalla'i hana he'nexxi mogido no'o'ni atike eriganjuwwa'ni darbineen; moyanjinke eriganjuwwanaa'ni henooka shinneen; erigaanji atiki Hiitichchi Ooriyonna shiyemeen.»<verse eid="2SA 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 11:25" />Daawwitinna erganjokee, «Yooni hitee Iyyo'aabi'ni kuldatto qici, ‹Haanonna kadoole wolaantichchi mitte yanna konnee, wele yannanna okkonee shiyammaaxxee tennexxe yaadooxxee; hunna jabeesedheexxi qachcha balleessaashsha iso'n adda kull› » hiyyi.<verse eid="2SA 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 11:26" />Ooriyoxxi are aro'i ifik reyeexxa laqqeexxi isi'a ooxxe. <verse eid="2SA 11:26" /><verse number="27" style="v" sid="2SA 11:27" />Bersabehi busedhumma bidhiteechchi uduma, Daawiti manjo ergeexxi ifike miniba'a iyyedangaashsha asse; ifixxe arenna assedhee'naa labbaka belto isi'a ilde; yaane kinni Daawwiti asseexxi yaane Duuchchi Woddika Gootta gammachchiisemmabaan.<verse eid="2SA 11:27" /></para>
  <chapter eid="2SA 11" />
  <chapter number="12" style="c" sid="2SA 12" />
  <para style="s1">Wabeekichchi Naatani Daawwiti'i Xixe</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 12:1" />Duuchchi Woddik Gootti Naatani Daawwitiba'a erge; Naataaninna Daawwitiba mareexxi hiyyee qici, «Mitte qachchi giddo lami manni hedha'nemman; ookkone lamenaa'ni mitti dureessakemman langaki kinni hiyyeessakemmani.<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="PSA 51">Far. 51</ref>. </char></note> <verse eid="2SA 12:1" /><verse number="2" style="v" sid="2SA 12:2" />Iikki dureessi manjichchi yo'oshsha heddo lalonna heddo gedhebo afeemman; <verse eid="2SA 12:2" /><verse number="3" style="v" sid="2SA 12:3" />Hiyyeessi manjichchi kinni hidhdheexxa mitte shiixxoxxa gedhechcho malee mitti afeechchi hedhemmaba'a. Iseenna oose ifixxen welti isiba nophphite; isi iteechcho ittee ha'weechchonna ha'wita'emman; diipha woddanna midde luu'medhe welti diipha'emman; isenna isi'a i'leexxe beltoshshatemman. <verse eid="2SA 12:3" /><verse number="4" style="v" sid="2SA 12:4" />Ookkone dureessi manjiba keesumma dagge; iikki dureessi manji keesummatee ittaachcho giissino'a ifike gedhebonaa'ni yookaani jibichcha mitte aadhe daggeexxe keesumma'a dulo'a eeyyebaan; ifika dulammaxxa bakka ookkone hiyyeessi manjichchixxa gedhechcho aadhe dule daggeexxi keesumma itto'a qophpheesse.»<verse eid="2SA 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 12:5" />Daawwitinna ookkonne manjo'ni yo'oshsha aareexxi Naataani'n hiyyee qici, «Hedhaake Duuchchi Woddike Goottixxa tenne asseeki manjichchi reya hasissaan! <verse eid="2SA 12:5" /><verse number="6" style="v" sid="2SA 12:6" />Mararte mitte belonna tenne yaane assemmaxxee eettene gedhechchoxxee iikki manjichchi shoole anga caala hiisse uwwa hasissaa» hiyye.<verse eid="2SA 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 12:7" />Ookkoneechchi uduma Naataaninna Daawwitii hiyyee qici: «Iikki manji ateteni! Duuchchi Woddik Gootti Isira'eeil Mageni hiyya'nee qici: ‹Ani atee Isira'eel'ni moototta'a hariirennen; Sa'oolixxe anganaa'ninna atee aniirennen. <verse eid="2SA 12:7" /><verse number="8" style="v" sid="2SA 12:8" />Atike goottika minenna atike goottixxa aruwwa anga atixxe'ni sa'isse uwwenene; Isira'eelixxanna Yihudaxxa horte ati'a uwwennnen; tinni duuchcha atee hanqatechcho kaddoole konne caala lebe ati'a uwwannan. <verse eid="2SA 12:8" /><verse number="9" style="v" sid="2SA 12:9" />Mayeeta Duuchchi Woddike Goottika hiyyichcho shollishette? Tenne fuggoxxa mayee assitette? Hiitichcho Ooriyo'o wolaantichchik shiltette; are ifixxe assexxotta'a are isixxa adhdhitetten; isoonna Amoonitotike wolaantichchinni shiltetten. <verse eid="2SA 12:9" /><verse number="10" style="v" sid="2SA 12:10" />Ati anee tuffate are ifixxe assexxotta'a Hiitichcho Ooriyoxxa are ifi'a adhdhiteettaxxee wolaantichchi duuchchi woddi'a mine atikenaa'ni gophemabaan› hiyye.<verse eid="2SA 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 12:11" />«Duuchchi Woddik Gootti hiyya'nee qici, ‹Yoona atike menenaa'ni fuggoxxa yaane ate'ni ke'issannon; ille atixxi uuda'naa'n aruwwa atixxa fira atike kadeeke manji'a mittekee uwwannon; isinna barra saafo'a atixxe aruwwanni welti diiphan. <verse eid="2SA 12:11" /><verse number="12" style="v" sid="2SA 12:12" />Ati tennee sho'iki assiteetten; ani kinni tenne yaane barra saafo'a Isira'eeli duuchchi edo farri assee leellishannon.› »<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="2SA 16:22">2 Sam. 16:22</ref>. </char></note><verse eid="2SA 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 12:13" />Ookkoneechchi uduma Daawwitinna Naataani'n «Duuchchi Woddike Gootta'n cubbo huje'ennen» hiyye.</para>
  <para style="p" vid="2SA 12:13">Naataninna hiyyee qici, «Duuchchi Woddi Gootti cubbo atixxa gattowwaal hiyye'een; rertaboxxon. <verse eid="2SA 12:13" /><verse number="14" style="v" sid="2SA 12:14" />Tenne assa kinni Duuchchi Woddike Goottik naaphi isoo tuffaatemashsha assiteetaxxe'e ati'a ilemeemmak belti reyaan.»<verse eid="2SA 12:14" /></para>
  <para style="s1">Daawwitike Beltixxa Rewo</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 12:15" />Naataani ifike minibaa me'eechchi uduma Ooriyoxxi are Daawwiti'a ildeemmake belto'ni Duuchchi Woddik Gootti jabbaxxa dhibo ibise. <verse eid="2SA 12:15" /><verse number="16" style="v" sid="2SA 12:16" />Daawwitinna beltokee Duuchchi Woddika Gootta soodate; agabo goddonna hose; ookkoneechchi uduma galammaxxe kuta giddixxe'ni e'ye buttinna duwwike'n dhiiphe. <verse eid="2SA 12:16" /><verse number="17" style="v" sid="2SA 12:17" />Isike moottummatike minixxi ja'laabuwwa isoo buttii'ni ke'issino'a isi bira uurite; isi kinni buttii'ni ke'a gibe; insa'neninna mittelchonna itebaan. <verse eid="2SA 12:17" /><verse number="18" style="v" sid="2SA 12:18" />Torbaxxe barra'ni beltikinna reye; Daawwitiki ergajuwwinna, «Yoona belti lubbo hedhemma wodda kulleennexxa Daawwiti laqebaan; ta'afa'i beltiinxa reyo hitta assine iso'ni kula dandeennanno? Isinna ifi'n fuggoxxa assedhaaxxe hexxeen» hiyyoti iso'n kula sodaante.<verse eid="2SA 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 12:19" />Daawwitinna eriganjuwwi isiki weli'anni weli hashanshaa'n'aa uudeexxi belti reyeexxa ege'ne; tennexxe «belti reyee?» hiyye insa'ne qore.</para>
  <para style="p" vid="2SA 12:19">Insa'nenna, «Eeti reyee'en» hine hiissine.<verse eid="2SA 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 12:20" />Ookkoneechchi uduma Daawwitinna buttinake'ni diiphemmabaa'ni ke'e biso anshedhe; buurokanna issate; seemmatanna jijjiidhdhe oddo'wechchi uduma Duuchchi Woddike Goottike minibaa mare sagade. Ookkoneechchi uduma mini ifikibaa e'ye; itaachcho uuno'a qoreexxi shiqinsheenaa ite.<verse eid="2SA 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 12:21" />Isike moyatike minixxi erganjuwwi, «Iitta assitettelchi mayyeete? Belti lubboti hedhemma wodda agabo goddo hossette, ooxxette; belti reyeechchi uduma kinni kexxe ittetten» hine isoo qorre.<verse eid="2SA 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 12:22" />Isinna hiyyee qici: «Dhugaandinni belti lubboti hedhe'naa, ‹Duuchchi Woddik Gootti ani'a gattowwaal hiyyeexxi belto lubbo gatisaaxxe hexxeen› hiyyee agabo goddo hedhee oodhennen. <verse eid="2SA 12:22" /><verse number="23" style="v" sid="2SA 12:23" />Ta'a kinni belti reyemmaxxee mayee agabo goddo hedhanno? Reyeeka langaxxa hiissa dande'annota? Ante isiba me'anno malee'e isi anibaa'a hige dagabaan!» hiyye hiisse.<verse eid="2SA 12:23" /></para>
  <para style="s1">Solomonixxa Ilensha</para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 12:24" />Ookkoneechchi uduma Daawwitinna are ifixxa Berissaabehi jajjabeesse; isebanna mareexxi isenni welti diiphe; isenna labbaka belto isi'a ilde; isinna beltinka summa Solomooni hiyye fulche. Duuchchi Woddik Goottinna isoo eeyye. <verse eid="2SA 12:24" /><verse number="25" style="v" sid="2SA 12:25" />Duuchchi Woddik Gootti belto eeyyemmaxxee summa isikanna Yidiidiya<note caller="+" style="f"><char style="fr" closed="false">12:25 </char><char style="ft" closed="false">Yidiidiya hiyya Ibrititotike laagadanni Magenoke'n eeyemeeke hiyyaten. </char></note> hiyyeme ye'emaashsha wabeeka Naataani darree'n hiyyichcho erge.<verse eid="2SA 12:25" /></para>
  <para style="s1">Daawwit Ra'aba Hiyyemaaka Qachcha Injifate Abide</para>
  <para style="r">(<ref loc="1CH 20:1-3">1 Odo. 20:1-3</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 12:26" />Ookkone wodda Iyyo'aabi Amoonitotika qachcha Raaba'a lolee mootetike minixxa kollo abixxe. <verse eid="2SA 12:26" /><verse number="27" style="v" sid="2SA 12:27" />Ookko'ni Iyyo'aabi Daawwitiba'a hiyye erga ergee qici: «Raaba'a lole wode'i hedheboonchixxa kollo abideennen. <verse eid="2SA 12:27" /><verse number="28" style="v" sid="2SA 12:28" />Yoona gateeka sannachcha bukki assite qachcha elqe kayyii'ni buqqe abidi; iitta assa gophphotole ani qachcha abidee'na'a anke summinni ye'emaan.» <verse eid="2SA 12:28" /><verse number="29" style="v" sid="2SA 12:29" />Tennexxe Daawwiti sannachcha duuchcha bukki asseexxi Raaba'a mareexxi lole abide. <verse eid="2SA 12:29" /><verse number="30" style="v" sid="2SA 12:30" />Daawwitinna insa'neeke moyanjike umonaa'ni kallachcha aadhe; kallachchikinna sase tommenna onde kiilo a'urittaaxxe worqe kaddaa wodda isinna Daawwitike umo'n uggeme; iittanni ookkone qachchanaa'ni lumoxxa booji'o booji'e. <verse eid="2SA 12:30" /><verse number="31" style="v" sid="2SA 12:31" />Ookko'o hedhemmaka arda fulcheexxi magaazeti, qottotinna maxarabik huje hunjaashsha asse; iitaanni buttinna qabandee bolokeete hunjaashsha asse. Iitta hexxeexxa huje wele Amoonike qachchuwwa duuchcha'ni hujendaashsha asse. Ookkoneechchi udumna Daawwitinna sannachchi duuchchi Iyyerusaalemi'a hinge.<verse eid="2SA 12:31" /></para>
  <chapter eid="2SA 12" />
  <chapter number="13" style="c" sid="2SA 13" />
  <para style="s1">Aminooninna Ti'imari'i Gurra Balleese</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 13:1" />Daawwitiki belti Abeseloomi Ti'imaari hiyyendaaxxa yo'oshsh dancha dayyo afeeman; iseenna Daawwitik belti Aminooni eeyye. <verse eid="2SA 13:1" /><verse number="2" style="v" sid="2SA 13:2" />Aminoonninna dayyo ifixxa Ti'imaarii'i eeyyatenaa'ni kexxeexxa isexxe yortenn elagophe; isenna duuddo dubarichcho kaddeemmaxxee isee diipha dande'abaaxxa ege'ne. <verse eid="2SA 13:2" /><verse number="3" style="v" sid="2SA 13:3" />Aminooninna Yonadaabi hiyyemaaka jaalo afeemman; isinna Daawwitika dayyo Saami'ake beltomman. Iyonadaabi yo'oshsha malameessakemman. <verse eid="2SA 13:3" /><verse number="4" style="v" sid="2SA 13:4" />Isinna Aminoonii'i hiyyee qici, «Koo moyanjiinke belto ate'e barra barra'ni huqqisa'n hexxa'neexxa yaane, ane'n kula gophatechi mayeete?» hiyye laqe.</para>
  <para style="p" vid="2SA 13:4">Aminooninna, «Anke dayyixxa Abeseloomixxa dayyo Ti'imaari'i eeyyennaxxeeten» hiyye hiisse.<verse eid="2SA 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 13:5" />Iyonaadaabinna, «Yoona ‹Ela gopheennen› hite taqete'ni diiphi; anni atiki atee laqo'a dagaa wodda ‹Dayyo anxi Ti'imaari daggeexxi itannolcho ani'a uuteele gammadannan; isenna konnoo ani bira hexxe'e uuda'naa ita qophpheessite anga isexxenni itisso'a maganneten balloo eeti ani'a uwwi› hite iso'ni kuli» hiyye. <verse eid="2SA 13:5" /><verse number="6" style="v" sid="2SA 13:6" />Tennexxe Aminooni ela gophee manjo fakkaate diiphe.</para>
  <para style="p" vid="2SA 13:6">Moyanjinna isoo laqo'a dage; Aminooninna, «Dayyo anxi Ti'imaari daggeexxiuuda'naani lame quncisa qunciseexxi anga isexxenni anee itisaashsha atee kadhataannen» hiyye laqe.<verse eid="2SA 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 13:7" />Tennexxee Daawwiti mootummatike mi'ne'n hexxeexxe Ti'imaari'n «Atike dayyo Aminooniba marte ita isi'a qopohpheessi» hiyyaaka ajaja erge. <verse eid="2SA 13:7" /><verse number="8" style="v" sid="2SA 13:8" />Tennexxe Ti'imaari dayyi Aminooni diiphemmake miniba'a marte; shiixxooxxa lixxe aaxxe qushshiteechchi uduma isi uuda'naanni qopheesite ra'isite. <verse eid="2SA 13:8" /><verse number="9" style="v" sid="2SA 13:9" />Ookkoneechchi uduma isenna qunicissemmaka quncisa she'latenaa'ni aaxxexxi isi'a shiqishshe; isinna ita gibe.</para>
  <para style="p" vid="2SA 13:9">Aminooninna «Manjo duuchcha kabaa'ni ani'a fulche» hiyye. Mine Hedhemmak manji duuchchingi fule. <verse eid="2SA 13:9" /><verse number="10" style="v" sid="2SA 13:10" />Ookkoneechchi uduma Aminooni Ti'imaarii'i, «Anee anga atixxenni itisottaa dhiiphaannaxxe anxe taqebaa iyyedagi» hiyye. Ti'imaarinna qopheesitemmaka quncisa aaxxeexxi dayyi iseki Aminooni galammaxxe kuta giddi'a adhdhite e'yite. <verse eid="2SA 13:10" /><verse number="11" style="v" sid="2SA 13:11" />Yaane kinni ita isi'a shiqishaa wodda sha'mi asse abideexxi, «Tee anxe dayyo amo welti diinpho» hiyye.<verse eid="2SA 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 13:12" />Isenna hitee qici, «Anke dayyo maganneten waali tinni kaddaaxxe yaanebaan ane'ni hunnattoxxee; iitta hexxeexxa shookishshaxxa yaane Isira'eeli giddo assende ege'nendebaan; tennexxee tenne yababulle assitoxxee. <verse eid="2SA 13:12" /><verse number="13" style="v" sid="2SA 13:13" />Ani maa hiyyanno? Salphate ardi giddo hoone gurrinni me'anno? Atinna Isira'eelike ardixxe oddo'ni lumoshsha salphatetteke kaddatton; maganneten moyanjoke'ni isee aadhannoni hite kuli; isi ate'ni heerumabo'noshsha hoyyabaan» hite. <verse eid="2SA 13:13" /><verse number="14" style="v" sid="2SA 13:14" />Isi kinni isexxa laqo'a hasebaan; ise irra isi jabake kadeemmaxxe'e isee hunnati abide diiphe.<verse eid="2SA 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 13:15" />Ookkoneechchi uduma Aminooninna isee yo'oshsha jibbe; edo iseee eeyyamma irra isee gibeemmaxxee tennexxee konne anke «Minenaa'ni fuli!» isee hiyye.<verse eid="2SA 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 13:16" />Isenna, «Tinni kaddabaan! Anee minii'ni fulchite shorra; edi wodda ane'ni assitettexxe balleesa irra saxxeexxa balleessa ane'ni geessisseten hiyyoten» isoo hite. Isi kinni isexxa laqa gibe. <verse eid="2SA 13:16" /><verse number="17" style="v" sid="2SA 13:17" />Isinna ifika erganjo dargageessichcho ye'eexxi «Tenne manjichcho kabaa'ni fulchitettexxi hula cufi» hiyye.<verse eid="2SA 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 13:18" />Tennexxe erganji isiki isee gadhi'a fulcheexxi hula cufe; ookkone wodda Ti'imaarinna moyanjiink duuddo dubarruwwi oddo'waammaxxa seesinxa seemma oddo'witemamn. <verse eid="2SA 13:18" /><verse number="19" style="v" sid="2SA 13:19" />Ti'imaarinna umo ifike'ni bululo filfilxite seesinxa seemma ifixxa darte umo abixxite hafuura gikki assite ooxxa'ni me'ite. <verse eid="2SA 13:19" /><verse number="20" style="v" sid="2SA 13:20" />Dayyi iseki Abeseloominna isee uude wodda, «Tee anixxe dayyoo! Dayyi atik Aminooni atinni welti hedhemmaa? Tee anxe dayyo amo ta'a sammi hiyyi; isi atike dayyo kadeemmaxxe'e yaane godoba uggudhittoxxe'e» isee hiyye. Ti'imaarinna iseke dayyo Abeseloomike mine'ni qofittinn ofolde.<verse eid="2SA 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 13:21" />Moyanji Daawwiti tenne duuchcha laqeexxi yo'oshsha mufate. <verse eid="2SA 13:21" /><verse number="22" style="v" sid="2SA 13:22" />Aminooni dayyo ifixxa Ti'imaari'i hunnati abide isenni welti diiphemmaxxee Abeseloomi Aminoonixxa ijje gibe. Isinna langaxxa elo yo'oxxa iso'ni haaso'a hasebaan.<verse eid="2SA 13:22" /></para>
  <para style="s1">Abeseloomi Aminooni'ni Halo Fule</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 13:23" />Lame wogga uduma Abeseloomi Efireemixxe gabala bira hedheeke Be'aalehatsorke qachcha'ni gedhebiinxa orda cira'emmani; ookkone wodda moyanjiinxa labbaxxa oose duuchcha ookkoo ite ha'watee ye'e. <verse eid="2SA 13:23" /><verse number="24" style="v" sid="2SA 13:24" />Abeselooninna moyanjinba mareexxi, «Yoona erganji atik gedhebiinxa orda cirate'ni hedhennen; tennexxee moyanjinna hayyoole daggineexxi qophpheessenaxxee ita'ni afendino'a daga eetaboxxo?» hiyye laqe.<verse eid="2SA 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 13:25" />Moyanjikinna «Koo anke belto, no'o duuchchiingi daga hasissabaan no'oo duuchchiing dangonnole keesunsa ate'ni ha'urtaan» hiyye isi'a hiisse. Abeseloominna jaba qicinn laqe; moyaji kinni ifka yaada jijjjiira gopheemmaxxee Abesoloomi hobba'i hiyye.<verse eid="2SA 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 13:26" />Abeseloominna, «Yoona dayyi anki Aminooni no'onni welti me'uun» hiyye.</para>
  <para style="p" vid="2SA 13:26">Mayonjinna, «Isi ha'noonni welti mayeete me'a'nechchi?» hiyye laqe. <verse eid="2SA 13:26" /><verse number="27" style="v" sid="2SA 13:27" />Yaane kinni Abeseloomi jabeesse isoo kadhateemmaxxee Aminoonninna wele moyanjiinxi labbaxxi oose duuchcha isinni welti me'itaashsha asse. <verse eid="2SA 13:27" /><verse number="28" style="v" sid="2SA 13:28" />Abeseloominna eriganjuwwa ifika hiyyee qici; «Aminooni woyyinetixxa booka ha'we huffi hiyyaa wodda; ani Aminooni'i iso shiwwe ha'no hiyyanno wodda shiwwe; ha'no ajajenneki anten sodaatinoqqee; jabaatte; hara mandinoqqe» hiyye. <verse eid="2SA 13:28" /><verse number="29" style="v" sid="2SA 13:29" />Tennexxe Abeseloomik erganjuwwi gootti insa'neeki insa'ne ajajemmaxxa Aminooni'ni assine. Ookkoneechchi uduma moyanjiinxi labbaxxi oose duuchchi kexxeexxi ifi ifixxa gaange guluffeexi baqatte.<verse eid="2SA 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 13:30" />Insa'nenna mine gennebaangi orake'n he'nee'naa, «Abeseloomi oose atixxa shiye bire; mittikinna gateeki hedhebaan» hitaaxxi odo Daawwiti'ni gelte. <verse eid="2SA 13:30" /><verse number="31" style="v" sid="2SA 13:31" />Moyanji Daawwitinna ofo'lemmabaa'ni ke'e uurre; yaadoti seemma oddo'wemmaxxa dareexxi buttinake'ni wabbi hiyye ibe; okko isi bira hedhdhemaki eriganjuwi isiki duuchchinna yaaddotixxa seemma ifi ifixxa darre. <verse eid="2SA 13:31" /><verse number="32" style="v" sid="2SA 13:32" />Daawwitik dayyi Saami'ak belti Yonadaabi hiyyee qici, «Moyanjiinxa labbaxxa oose duuchcha bireeshsha assee anki gootti hedoqqee; dayyo ifixxa Ti'imaari hunnati abide dubarrumma balleesseexxe yannanaa'ni ke'issee Abeseloomi mudhdhe ke'eexxe yaane kaddeemmaxxee reyeek Aminooni callan. <verse eid="2SA 13:32" /><verse number="33" style="v" sid="2SA 13:33" />Yoona reyeek Aminooni calla kadeemmaxxee, ‹Moyanjiixxi labbaxxi oose duuchcha shiyende› hiyyendee kulendeemmaxxa ati anki gootti mayanji addatoxxee.»<verse eid="2SA 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 13:34" />Abeseloominna rake baqate. Hula heqqammaki manjichchinna toggi hiyye uudaa wodda isinna dhidhimii darre'ni hedheeke oranaa'ni heddi manni koobatena'ni butti'a dirraa'naa afe; hula heqqaammaki manjichchinna mare moyanjo hiyyee qici, «Horinayiim darree'ni tullichchinke kasana'ni manni adadde dirraa'naa uudennen» hiyye kule. <verse eid="2SA 13:34" /><verse number="35" style="v" sid="2SA 13:35" />Yonadaabinna Daawwiti'i, «Kunnuuxxi mayanjo atixxi labbaxxi oose dagge'een; ani atik erganji hiyyennashanni kaddeen» hiyye. <verse eid="2SA 13:35" /><verse number="36" style="v" sid="2SA 13:36" />Isinna haaso'e birebaangi moyanjiinxi labbaxxi oose hunbaashshite ooxxa'ni e'yite; iittanni moyanjikinna erganjuwwi duuchchi hinqilfante oo'ne.<verse eid="2SA 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 13:37" />Abeseloominna baqate Geshuurika moyanjo Amiihudika belto Telmayibaa'a me'e; yaane kinni Daawwiti reyemmake beltixxee duuchchi wodda oodha'nemman.<note caller="-" style="x"><char style="xo" closed="false">13:37 </char><char style="xt" closed="false"><ref loc="2SA 3:3">2 Sam. 3:3</ref>. </char></note> <verse eid="2SA 13:37" /><verse number="38" style="v" sid="2SA 13:38" />Abeseloomi baaje Geshuure'a me'eechchi uduma ookkoo sase wogga ofo'le. <verse eid="2SA 13:38" /><verse number="39" style="v" sid="2SA 13:39" />Moyanji Daawwiti ifike belto Aminoonixxe reyoxxee yaaddo waale jabaatelchi uduma; Abeseloomibaa me'atee qalbe kexxe.<verse eid="2SA 13:39" /></para>
  <chapter eid="2SA 13" />
  <chapter number="14" style="c" sid="2SA 14" />
  <para style="s1">Abesoloomi Iyyerusaalemi'a Hige</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 14:1" />Tsuriyak belti Iyyo'aabi moyanjiink godobi Abeseloomii halcheexxa ege'ne. <verse eid="2SA 14:1" /><verse number="2" style="v" sid="2SA 14:2" />Tennexxe Iyyo'aabi Teequhe'a manjo ergeexxi mitte qaroontitte manjichcho iyyedangaashsha asse; isenna hiyyee qici, «Tinninna yaadeke manjishsha ifi assite; yaaddotixxa seemma oddo'i; buurokanna issattoxxe; reyeeke manji'a lumoxxa yanna yaaddeexxe manjichcho ifi assi. <verse eid="2SA 14:2" /><verse number="3" style="v" sid="2SA 14:3" />Ookkoneechchi uduma moyanjiinba martettexxi ani ate'ni haaso'annexxa iso'ni haaso'i» hiyye. Ookkoneechchi uduma Iyyo'aab marte iso'ni kuldaxxa yaane ise'ni kule.<verse eid="2SA 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 14:4" />Iitti Teequhee'n daggeexxi manjichchonna moyanjiibba marteexxi moyanji edo albiki buttinna tuqqaa qico'ni heeshshi hiteexxi ulfeessiteechchi uduma, «Koo moyanjo balloo ane'e gargaari!» hite.<verse eid="2SA 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 14:5" />Moyanjikinna «Rakko atixxi maachcho?» hiyyee isee laqe.</para>
  <para style="p" vid="2SA 14:5">Isenna hitee qici, «Aninna dhugaandinni aro'i reyeexxe hiyyeeten; <verse eid="2SA 14:5" /><verse number="6" style="v" sid="2SA 14:6" />Ani erganjo atixxi lame labbaxxa oose afeennan; insa'nenna diidake'ni welinni weli lolemme; araarsaaki manji hedha gopheemmaxxee mitti mitte gane shiye. <verse eid="2SA 14:6" /><verse number="7" style="v" sid="2SA 14:7" />Kunnisse firi duuchchi anee erganjo atixxe'ni ke'eexxi ‹Dayyo ifika shiyeemmaxxee dhaalak hedhabaashsha assineexxe kaddee'na midde iso shinnona'a dayyo ifika shiyeeka manjo no'aa uwwi› hina'n anee ko'winse'en. Insa'ne tenne assina'neexxe kaddoleta mitte ille anxa iille balleessinonna aro'o anka buttatenaa'n suummi belonna sanne belo gatinso'aten» hite.<verse eid="2SA 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 14:8" />Moyanjikinna manjichcho, «Ati mine atikiba'a me'i; yaane atixxee hasisaaka ajaja ani uwwannon» hiyye.<verse eid="2SA 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 14:9" />Yaane kinni Teequhee'n daggeexxi manjichcho, «Anke gootta moyanjo balleessa ane'ninna anke minke mine'ni kadduun; ate'ninna atixxe moote'n balleessa hexxebaan» hite.<verse eid="2SA 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 14:10" />Moyanjikinna, «Fedheeki manji mittelchonna haaso'oole isoo anibaa iyyedagi; langaxxa atee rakkisabaan» hiyye ise'a hiisse.<verse eid="2SA 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 14:11" />Issenna, «Halo fulaak manni anka belto balleessati tennee saxxeexxa miidhensha ane'ni geessinsabaasha ati moyanji atika Duuchchi Woddika Gootta ifika Mageno soodatowwaal» hite.</para>
  <para style="p" vid="2SA 14:11">Moyanjnikinna, «Hedha'neek Duuchchi Woddik Gootti ege'neexxa atike beltike umiink ordichchanaa'ni mitti midde tuqemabaan» isee hiyye.<verse eid="2SA 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 14:12" />Ookkoneechchi uduma manjichchotinna, «Ani erganjo atixxi gootta anka moaanjo mitte hiyyichcho haaso'onnaa eeti ani'a uuwwi» isoo hite.</para>
  <para style="p" vid="2SA 14:12">Isinna, «Haaso'ita'a,» isee hiyye.<verse eid="2SA 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 14:13" />Manjichchotinna hiissiteexxi hitee qici, «Iitta hexxeexxa yaane assatee Mageniinke arda'ni heddeetek mayeete? Moyanjikinna bogii'ni fuleeka belto ifika hiissiteboxxon; tenne hitatto wodda ifi'ni mudhiteeboxxoota? <verse eid="2SA 14:13" /><verse number="14" style="v" sid="2SA 14:14" />Booso ibeeka buuro langaxxa alfinammabaakishsha no'onna kinni rennannon; Mageni kinni bogii iimi'ni fuleeki manjo atenaa'ni bayyate ookko'o gatabaashsha higaaka ora isi'a qophpheessa malee lubbo isixxi tolanga baxxo'a eeyyabaan.<verse eid="2SA 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 14:15" />«Aninna ta'a kabaa dagenelchi ardi anee sodaachchisemmaxxee tenneenni moyanjo anke gootti'a kulonaaten. Aninna erganjo atixxi tennee ‹Moyanjokee kulannon; dedha erganjo atixxxi ani laqennexxa muuxxattoxxe hexxen. <verse eid="2SA 14:15" /><verse number="16" style="v" sid="2SA 14:16" />Mageni no'o'a uwweeke geegonaa'ni anenna anka belto fulcho'a ka'lee ke'eeke manjixxe anganaa'ni erganjo ifixxa moyanji anjiraaxxe hexxeni hiyyeteni› hite.<verse eid="2SA 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 14:17" />«Ta'anna ani erganjo atixxi hiyyaanne qici, ‹Gootti ank moyanji Magenike iimike erganjishsha eloxxanna elobaaxxa gargariti hiisse ege'nammaxxee anke goottiki moyanjiinki hiyyichchi anee jabeessowwaal; Duuchchi Woddik Gootti atik Mageninna attini welti hedhdhowwaal› hita'neen» hite.<note caller="-" style="x"><char style="xo" closed="false">14:17 </char><char style="xt" closed="false"><ref loc="2SA 19:27">2 Sam. 19:27</ref>. </char></note><verse eid="2SA 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 14:18" />Ookkoneechchi uduma Moyanjikinna manjichcho hiyyee qici: «Aninna atee qoraannexxa yaane; atinna shoxxe boxxongi kuli» hiyye.</para>
  <para style="p" vid="2SA 14:18">Isenna «Anke gootta moyanjo haaso'i» hite.<verse eid="2SA 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 14:19" />Moyanjikinna «Tenne ati assitattoshsha ajajeeki Iyoo'aabitebaa?» hiyye qore.</para>
  <para style="p" vid="2SA 14:19">Manjichchotinna hitee qici, «Anke gotta moyaanjo summi atikinni kakataannen; anki gootti moyanji hiyyeexxe duuchchanaa'ni middi'anna bitta'i'a higaak ayyinna hedhebaan. Eeti tenne assannoshsha anee ajajeekinna konne hiyyichcho duuchcha ani atixxi erganjo afo'i ankinninni kulannoshsha anee ergeeki erganjo atike Iyyo'aabiten. <verse eid="2SA 14:19" /><verse number="20" style="v" sid="2SA 14:20" />Atiki erganji Iyyo'aabi tenne asseechchinna kaddeexxa yaane duuchcha jijjiro'a hiyyeeten; yaane kinni ati Duuchchi Woddiike Goottike iimike Erganjiika beekkuma fakkaataaka beekkuma afeettaxxee buttate'ni kaddaaxxa yaane duuchcha egendeten» hite.<verse eid="2SA 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 14:21" />Moyanjikinna Iyyo'aabi'i hiyyee qici: «Eloxxen; eettii uwweennen; martettexxi darggageessa Abeseloomi'i aaxxe iyyedagi» hiyye.<verse eid="2SA 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 14:22" />Iyyo'aabinna Daawwiti edo albiki buttina tuqaa qico'ni heeshshi hiyye anga ke'isse ulfesseexxi galateeffate, Iyyo'aabinna lebeexxi, «Moyanji anxa erganji atikixxa kadha laqqetaxxee ani atik ergaanji ati edo elle alfeennexxa telcho ege'nennen» hiyyeen. <verse eid="2SA 14:22" /><verse number="23" style="v" sid="2SA 14:23" />Ookkoneechchi uduma Iyyo'aabi Geshuure'a mareexxi Abeseloomiinna Iyyerusaalemi'a hiisse iyyedage. <verse eid="2SA 14:23" /><verse number="24" style="v" sid="2SA 14:24" />Moyanji kinni hiyyee qici, «Isi ookko'a mine ifikibaa me'uuni; ani haraanga ille isixxa uudonnaa hasaabo'non» tennexxee Abeseloomi mine ifikiba'a me'e; moyajiinka alba uudebaan.<verse eid="2SA 14:24" /></para>
  <para style="s1">Abisooloomi Daawwitinni Araareme</para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 14:25" />Abeseloomii'i danchummati lekka uggaaki mitti manjinna Isira'eelike boga duuchcha'ni haranga hedhemmabaan; isinna umokenaa'n ke'isse lekkatike qe'yi qico'ni unshinaachcho afeemmabaake manjomman. <verse eid="2SA 14:25" /><verse number="26" style="v" sid="2SA 14:26" />Abisoloomi goofaretike kadeemmaxxee goofare nophphite bira saxxaa wodda woggate'ni mittele woxedha'nemman; woxemeeka umo mootummatike minixxe kiilo'ni kiilaa wodda lame kiilo sa'aamman. <verse eid="2SA 14:26" /><verse number="27" style="v" sid="2SA 14:27" />Abeseloomi sase labbaxxa oosenna Ti'imaari hiyyendaaxa mitte meyyaxxa belto i'leeman; iiti meyyaxxi belto yo'oshsha danchatemman.<verse eid="2SA 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 14:28" />Abeseloominna moyanjo uudebangi lame wogga Iyyerusaalemi ture. <verse eid="2SA 14:28" /><verse number="29" style="v" sid="2SA 14:29" />Ookkoneechchi uduma Abeseloomi moyanjiinbaa me'o'aa Iyyo'aabi'i ye'ise Iyyo'aabi kinni isibaa mara eeyyebaan; langaxxa isiba erge; higgeen Iyyo'abi dagebaangi gibe. <verse eid="2SA 14:29" /><verse number="30" style="v" sid="2SA 14:30" />Ookkoneechchi uduma Abeseloomi erganjuwwa ifikee hiyyee qici: «Kunnise Iyyo'aabiki fichchi anke fichchi biran; isike fichcha'ni haama geyeeke so'a hedheen; ookkone so'a'ni martineexxi giira worre» insa'nee hiyye. Tennexxe Abiselomoonk erganjuwwi mareexxi Iyyo'abike so'a'ni giira worre.<verse eid="2SA 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 14:31" />Ookkoneechchi uduma Iyyo'aabi Abeseloomike minibaa mareexxi, «Erganjuwwi atik mayeete anke midhatike fichcha'n giira woreek?» hiyyee qore.<verse eid="2SA 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 14:32" />Abeseloominna Iyyo'aabi hiyyee qici: «Ani atee ye'enne wodda daga gophetexxeten, moyanjiba martettexxi, ‹Geshuurii'n kaba mayye dagene? Ookko tureneele ani'a woyyamman› hitettexxi anxa yaane qor; iittanni moyanjik welti afema dande'annoshsha yaane ani'a giissi balleessa ane'ni afendoole anee shiyuun» hiyye.<verse eid="2SA 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 14:33" />Tennexxe Iyyo'aabinna moyanjo Daawwitiba mareexxi Abeseloomi hiyyeexxa duuchcha iso'n kule; ookkonechchi uduma moyanji Abesoloomi ye'ise; Abesoloominna mareexxi moyanji edo albiki gonbisemeexxi anga iimi'a ke'isse; moyanjikinna Abesoloomi sunqedhe.<verse eid="2SA 14:33" /></para>
  <chapter eid="2SA 14" />
  <chapter number="15" style="c" sid="2SA 15" />
  <para style="s1">Abeseloomi Fuggoxxini Ke'exxa</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 15:1" />Ookkoneechchi uduma Abeseloomi sarageelanna fadhaduwwa, iittanni isi edo gonga'ni me'aaka onde tomme manna ifi'a qophpheesedhe. <verse eid="2SA 15:1" /><verse number="2" style="v" sid="2SA 15:2" />Abeseloomi bariisa ke'eexxi qachchi giddi'a e'yinammaxxe hulaba'a me'ammake ori qarqara uurrammani. Gargari hexxeexxe ku'la'a murte alfatee moyanjinba dangaa wodda duuchcha; Abeseloomi konne manna ifibaa ye'a'ni, «Ati hoone qachchanaa'ni daggeette? Hiyya'ni laqaamman» iikki manjinna, «Erganji atik Isira'eelike mini mini hadinaa'ni mitteken» hiyye isi'a hiissan. <verse eid="2SA 15:2" /><verse number="3" style="v" sid="2SA 15:3" />Ookkoneechchi uduma Abeseloomi isoo, «Uudi yaane atixxi seerinxen; yaane kinni moyanjiinxe tukke kade yaane atixxa toggi asse uudaak manji hedhebaan» hiyyamman. <verse eid="2SA 15:3" /><verse number="4" style="v" sid="2SA 15:4" />Abeseloominna lebbexxi, «Toggitte murte murona'a maye hedhee? Ani bogake'ni murte uwwanoke assineele? Yaane ku'lo'a daagaki manji duuchchi aniba daga'ni toggite murte alfaashsha silaa assannan» hiyyaamman. <verse eid="2SA 15:4" /><verse number="5" style="v" sid="2SA 15:5" />Iitanni fedheek manji isiba shiqeexxi ulfeesatee heeshshi hiyya wodda Abiseloomi hanqalfeexxi isoo sunqedhaamman. <verse eid="2SA 15:5" /><verse number="6" style="v" sid="2SA 15:6" />Abeseloomi dhugaatixxa murte alfatee moyanjiinba dagaaka Isira'eelichoke kadaake duuchcha'ni shiqa'neeki konne toorinnite kadeemmaxxee Isira'eelke ardixxi qalbe ifiba'a higgaashsha asse.<verse eid="2SA 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 15:7" />Shoole wogga uduma Abeseloomi moyanjo hiyyee qici, «Duuchchi Woddike Gootti'a werreegenneka werreega Kebirooni mare uwwonnaaa eetii ani'a uwwi. <verse eid="2SA 15:7" /><verse number="8" style="v" sid="2SA 15:8" />Ani atik erganji Sooriyake boga'ni Geshuuri hedhenna wodda, ‹Duuchchi Woddik Gootti Iyyerusaalemi'a anee hiisseexxe kaddoole; Kebirooni'i Duuchchi Woddike Gootti'a kumbu hiyyanon› hiyye werreegeennan.»<verse eid="2SA 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 15:9" />Moyanjikinna, «Nage'iki me'i» iso'o hiyye; tennexxee Abeseloomi Kebirooni'a me'e. <verse eid="2SA 15:9" /><verse number="10" style="v" sid="2SA 15:10" />Ookkoneechchi uduma Abeseloomi, «Malagatiinka hafuura laqqinaa wodda hafuura ha'nnooka lummissineexxi, ‹Abesoloomi Kebiroonike moyanjo kadeen› hiyye kulaaka erganjuwwa sho'iki Isira'eelixxe gosa duuchcha'ni erge» hiyye. <verse eid="2SA 15:10" /><verse number="11" style="v" sid="2SA 15:11" />Iyyerusaalemi'ni lame dhibbi manni Abeseloominni welti me'e; mitteba ye'eme ba'lunteti me'a malee'e tenne yaane mittelchonna ege'neechchi hedhemmabaan. <verse eid="2SA 15:11" /><verse number="12" style="v" sid="2SA 15:12" />Abeseloomi tolcha shiqishammaxxe yanna'ni Daawwiti'i mari'achchisammaki Giiloke qachchik manji Akixofeel ifike boganaa'ni Giilo'ni isiba'a dagaashsha manjo isiba'a erge; tennexxe Daawwiti'ninna diini jabaata'ni me'e; Abeseloomixxi gamonna bira saxxa'ni me'ite.<verse eid="2SA 15:12" /></para>
  <para style="s1">Daawwitika Baqa</para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 15:13" />Erganjikinna dageexxi, «Isira'eelike manniki godobi Abeseloomi'ni hedheen» hiyye Daawwiti'ni kule.<verse eid="2SA 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 15:14" />Ookkoneechchi uduma Daawwiti isinni welti Iyyerusaalemi hedheemmaka ja'laaba duuchcha, «Ke'we baqaanto; baqata gonphonnole Abeseloomixxe anganaa'ni fula dandeennabo'non; ta'anni kabaa'ni fula no'o'a hasissaan; kada gophoole hordoffe dagee no'oo abidoole no'oo shiyaan; qachchake'ni afeeka duchcha wolaantichchik shiye biraan» hiyye.<verse eid="2SA 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 15:15" />Moyanjiink Ja'laabuwwinna, «Gootti no'oki moyanjo fi'leexxa duuchcha assiyyotee no'o erganjuwwi atiki qophpheeffanteenen» hine isi'a hiissine.<verse eid="2SA 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 15:16" />Moyanjikinna mini hadi ifikenni welti fule me'e; mootummatika minenna tomme shiixxoxxi aruwwa heqitaashsha gatise. <verse eid="2SA 15:16" /><verse number="17" style="v" sid="2SA 15:17" />Tennexxe Moyanjikinna ardi duuchchi ifixxa duuka me'aashsha asse; shiixxo qico me'ineechchi uduma mitte bakka'ni uurrine. <verse eid="2SA 15:17" /><verse number="18" style="v" sid="2SA 15:18" />Kelito duuchchi Kelito, Felito, iittanni Gaati'ni isinni welti dageeka jaane dhibba Geetitto duuchcha lebeexxi daliki Moyanji edii'ni sa'ne. <verse eid="2SA 15:18" /><verse number="19" style="v" sid="2SA 15:19" />Moyanjikinna Itaayite hine ye'naamaka Gaatika manjo hiyyee qici: «No'onni welti daggeeteki mayyeete? Higgettexxi Abeseloominni welti ofo'li; ati ifi'anni wele bogana'ni dageetteke keesutichchon. <verse eid="2SA 15:19" /><verse number="20" style="v" sid="2SA 15:20" />Atinna konne boga'ni daggetteki bereqeten; yoona haba me'aanexxa eg'nebo'noki manji; hitta no'onni welti doonsa kiyya hittattoshsha assanno? Ke'i manna atika adhdhitettexxi higi; ellenna addatensha atinni welti hexxowwaal» isi'a hiyye.<verse eid="2SA 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 15:21" />Itaayi kinni «Hedha'neeke Duuchchi Woddike Goottike iittanna anke goottike moyanjinke summinni kakatannen; hedhotenna kaddo reyo hoone booncho'ninna gootti anki moyanji kadaaxxa duuchcha atiki erganjinna iittanni kadaan» hiyye hiisse.<verse eid="2SA 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 15:22" />Daawwitinna Itaayi, «Eloxxen! Yooni edi'a kexxe me'i» hiyye. Tennexxe Gaatichchi Itayemik manni duuchchinna isinni welti hedhemmaka mini hado ifika adhdhe me'e.<verse eid="2SA 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 15:23" />Ardi duuchchi sa'aa wodda ookkone bogiki mann duuchchi hiiqise oodhe; moyanjikinna Qediroonixxa dhooqa foofe; ardi duuchchinna foofeexxi gammoojje'a me'e.<verse eid="2SA 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 15:24" />Qeesichchi Saadooqinna ookko hedhemman; isinni welti hexxeemmaxxi Leewwito duuchcha ookkonee Mageniinka kakotika taabota dukkeemman. Insa'nenna ookkonee kakotika taabota butta uggine; Abiyataarinna ardi duuchchi ookkonee qachcha waale fulaa qico'ni tolcha shiqishe.<verse eid="2SA 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 15:25" />Ookkoneechchi uduma moyanjikinna Saadooqi hiyyee qici, «Ati Mageniinka Taabota qachchi giddi'a aaxxe higi; Duuchchi Woddike Goottanaa'ni elle alfoonnole, isi anee hiissee'naa taabotakanna seemmati giisinemaka fooqa higgeenni uudannoshsha anee assaxxe hexxen; <verse eid="2SA 15:25" /><verse number="26" style="v" sid="2SA 15:26" />Yaane kinni isi ‹Ate'ni gammadebo'non› hiyyaxxe kaddoole eloxxe fakkaateexxa leelliteexxa yaane isi ani'a assowwaali; aninna adhdhatee qophpho'ennen.»<verse eid="2SA 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 15:27" />Iittanni moyanji qeesichcho Saadooqii hiyyee qici, «Ati wabeekakebaata? Yoona atinna belto atika Ahima'aatsii'i, Abiyataarika belto Yoonataanii'i aaxxettexxi qachchi giddi'a nage'iki me'i. Atinna Abiyataari laminxa ha'nooxxa oose adhdhitine me'e. <verse eid="2SA 15:27" /><verse number="28" style="v" sid="2SA 15:28" />Aninna atenaa'ni odo laqanno qico'ni gammoojje giddike wede'iinke riqichchi qarqara hedhee heqqannoni» hiyye. <verse eid="2SA 15:28" /><verse number="29" style="v" sid="2SA 15:29" />Tennexxe qeesichchi Saadooqinna Abiyataari Mageniinka Taabota adhdhineexxi Iyyerusaalemi'a aa'ne hiissine okkonni turre.<verse eid="2SA 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 15:30" />Daawwitinna kinni oodha'ni Dabire Za'yitetixxa tarbaba'a qabate; isinna haguuqeexxi lekka duwwixxenni hedhemman; isinni welti hedhemmak ardi duuchchi iittanni haguuqqeexxi oodha'ni tarba qabata'nemmaan. <verse eid="2SA 15:30" /><verse number="31" style="v" sid="2SA 15:31" />Eettenne yanna «Abeseloominni welti diinakee guddeemaake manni giddi'ni mitti Akixofeeliten» hine Daawwiti'ni kulle. Tennexxee Daawwiti, «Duuchchi Woddike Gootta maganneteni Akixxofeelka gorsa la'o afabaake assi» hiyye soodate.<verse eid="2SA 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 15:32" />Daawwitinna ardi Mageno magenoonfatammaaxxe koobaxxa xungo geyee wodda, Arkichchi Huushayi seemma ifixxa dareexxi buko umo ifike'ni fifilxxexxi isinni welti afemo'a dage. <verse eid="2SA 15:32" /><verse number="33" style="v" sid="2SA 15:33" />Ookkoneechchi uduma Daawwitinna isi'a hiyyee qici, «Ati aninni welti me'itottole ane'ni ba'ote kadattoni; <verse eid="2SA 15:33" /><verse number="34" style="v" sid="2SA 15:34" />Yaane kinni Ati qachchiiniba'a higge Abeseloomii'i anna atikee ergatemenneshshan, ‹Moyanjo ani atike erganjo kadannoni; telchonna ati'a ergatemannon› anee hitottole Akixofeelika gorsa moromati anee gargaaritattoni. <verse eid="2SA 15:34" /><verse number="35" style="v" sid="2SA 15:35" />Qeese, Saadooqinna Abiyataari okko'o atinni welti he'nneebaa? Moottummatike minenaa'ni hinaa'naa laqqettexxa duuchcha insa'ne'ni kuli. <verse eid="2SA 15:35" /><verse number="36" style="v" sid="2SA 15:36" />Saadooqik belti Ahima'aatsiinna Abiyataariki belti Yoonataani lamiinxi insa'nexxi labbaxxi oose ookkon insa'nenninni welti hexxen. Atinna laqqettexxa duuchcha insa'nee gamii'ni anibaa'a sa'issi.»<verse eid="2SA 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 15:37" />Tennexxe Daawwitiki jaali Huusheyi Abeseloomi Iyyerusaalemi e'yeexxe yanaa'ni ookko geye.<verse eid="2SA 15:37" /></para>
  <chapter eid="2SA 15" />
  <chapter number="16" style="c" sid="2SA 16" />
  <para style="s1">Daawwitinna Siba</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 16:1" />Daawwiti koobatixxe xugonaa'ni shiixxo qico sa'e me'eeshshanni Siiba hiyyemaak manji Mefibosheetik erganji, lame dhibba wodhaamo, mitte dhibba woyinetixxe roddeka xalta, mitte dhibba balasetika xaltanna mitte qalqallo weyinetixxa booka feeneexa lame harre dagaa'na afeeme.<note caller="-" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="2SA 9:9-10">2 Sam. 9:9-10</ref>. </char></note> <verse eid="2SA 16:1" /><verse number="2" style="v" sid="2SA 16:2" />Moyanjikinna Sibaa, «Konnechcho duuchcha iyyedagetelchi mayeete?» hiyye qore.</para>
  <para style="p" vid="2SA 16:2">Siibanna, «Harruwwa moyanjinki mini hadi gulufo'a, kebbonna balasetixxa gumma dargaggeeyye ittaan, weyine kinni qiila gammooje'ni dheebo'weki ha'waashshaten» hiyye.<verse eid="2SA 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 16:3" />Ookkoneechchi uduma moyanji, «Atike goottiki belti haba hedhe?» hiyye qore.</para>
  <para style="p" vid="2SA 16:3">Siibanna, « ‹Isira'eelik mini telcho anke annixxa mootumma ani'a hiissaani› hiyye hedammaxxee Iyyerusaalemi ofo'le'eeni» hiyye.<note caller="-" style="x"><char style="xo" closed="false">16:3 </char><char style="xt" closed="false"><ref loc="2SA 19:26-27">2 Sam. 19:26-27</ref>. </char></note><verse eid="2SA 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 16:4" />Ookkoneechchi uduma moyanji Siibaa'a, «Mefibosheeti afeechchi duuchchi atiken» hiyye.</para>
  <para style="p" vid="2SA 16:4">«Sibanna lumooxxe shaquntenni heeshshi hiyyennexxi» anga iimi'a ke'issannoni; «anke gootta moyanjo atenaa'ni elle alfo» hiyye.<verse eid="2SA 16:4" /></para>
  <para style="s1">Shimi'a Moyanjo Daawwiti'i Yowwe</para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 16:5" />Moyaanji Daawwiti Baahuriim geyee wodda, Sa'oolike mini hado kadeeki mitti manji dage; isinna Geerake belto Saamiten; isinna isoo badina'ni gadhi'a fule. <verse eid="2SA 16:5" /><verse number="6" style="v" sid="2SA 16:6" />Moyanjinki lolinki manninna garigarti hedheek heqanjuwwi duuchchi Daawwitike midda'ninna bitta'ani he'neexxenna kaddole Shimi'a Daawwiti'ninna Ja'laabuwwa duuchcha'ni kino darbataammani. <verse eid="2SA 16:6" /><verse number="7" style="v" sid="2SA 16:7" />Saaminna hiyye yowwaamma qici, «Ati manjo anga saxxeetek manji; ati fuggaaleessi manji; fuli, amo fuli kabaa'ni! <verse eid="2SA 16:7" /><verse number="8" style="v" sid="2SA 16:8" />Mootumma adhdhitetteke Sa'oolike mini hadixxi munde Duuchchi Woddiki Gootti hiissate'ni hedhen. Duuchchi Woddik Gootti mootumma atixxa belto atike Abeseloomi'a uwwe'eeni. Ati manjo anga saxxeeteke kaddetaxxee kunni ba'ne atixxi gelte'een.»<verse eid="2SA 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 16:9" />Ookkoneechchi uduma Tsuriyak belti Abisa moyanjo, «Kunni reyeeke wolchishsha hedheeki gootta moyaanjo anka hitta yowwa? Widi'a foofenneexxi gooba isika kutoo» hiyye.<verse eid="2SA 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 16:10" />Moyanji kinni «ha'no Tsuriyaxxi oose ha'noonna anee maachcho afensisaachchi? Duuchchi Woddik Gootti ‹Daawwiti'i yowwi› hiyye'naa anee isi yowwa'noole, ‹Tenne mayee assitete› hiyye ayyete isoo qora dande'a?» hiyye. <verse eid="2SA 16:10" /><verse number="11" style="v" sid="2SA 16:11" />Ookkoneechchi uduma Daawwiti Abisa'ninna ja'laabuwwa ifike duuchcha'n hiyyee qici: «Ani i'lenegi belti anee shiyo'a hasa'neexxinni, kunni Biiniyaamichchi anee galaafateele mitte mambe'a assitaaxxi yaane hexxee? Mee hoyye Duuchchi Woddik Gootti iso'ni kulee'naaten waalle yowwun. <verse eid="2SA 16:11" /><verse number="12" style="v" sid="2SA 16:12" />Dedha Duuchchi Woddik Gootti rakko anxa uudee kunni manjichchi anee yowwemmaxxa bakka eebbate ani'a assaan.»<verse eid="2SA 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 16:13" />Tennexxe Daawwitinna isiki manni ora ifika me'ine; Saami koobatike kasa kasanaa'ni me'a'ni; badina'ni, kinjo darbata'ninna buko iso'ni xeeraamman. <verse eid="2SA 16:13" /><verse number="14" style="v" sid="2SA 16:14" />Moyanjikinna isini welti me'a'nemmaki manni duuchchi marate hendemmaba genne lumoshsha gonpheemmaxxee ookkone booncho'ni hafuura adhdhineen.<verse eid="2SA 16:14" /></para>
  <para style="s1">Kuusikanna Akixofelka Gorsa</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 16:15" />Eettenne yanna Abeseloominna Isira'eeliki manni duuchchi Iyyerusaalemi'a dange, Akixofeelinna insa'nenni welti hedhemmani. <verse eid="2SA 16:15" /><verse number="16" style="v" sid="2SA 16:16" />Daawwitiki jaali Arkichchi Huusheyinna Abeseloomibaa dageexxi, «Moyanjo balloo duuchchi wodda moyi! Moyanjo balloo duchchi wodda moyi!» hiyye.<verse eid="2SA 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 16:17" />Abeseloominna Huusheyi'i, «Jaalo atike afettaxxi addatensha ookkone qico? Mayee jaali atikinni welti me'a gophphete?» hiyye qore.<verse eid="2SA 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 16:18" />Huusheyinna Abeseloomii'i hiyyee qici: «Hitta ani isinni welti me'anno? Fedheexxe yanna'ninna ani konne ardixxe, Isira'eelike ardi duuchchixxenna Duuchchi Woddik Gootti fileeke manjixxe gamon ani edi'aana isinni welti hedhannon. <verse eid="2SA 16:18" /><verse number="19" style="v" sid="2SA 16:19" />Yooni Gootti anikike belti'a ergatema gophonnole ayi'ata ergatemanno? Tennexxe anna atikee ergatemeneshshanni ati'anna ergatemannoni.»<verse eid="2SA 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 16:20" />Abeseloominna Akixofeelii'i «Yooni afetteka yaada iyyedagi; maata assinaanno?» hiyye.<verse eid="2SA 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 16:21" />Akixofeelinna hiisseexxi, «Mootumatika ifika mine heqqito'a anni atiki gatisemmaxxe atike annixe shiixoxxe melaallenni diiphi; ookkonechchi uduma ati anna ateke'ni hara naaphunteti kexxeeteke kaddettexxa Isira'eelike boga'ni hedhaaki ardi duuchchi laqee'naa atini welti hedheeke mannixxi hunna jabaattaani» hiyye. <verse eid="2SA 16:21" /><verse number="22" style="v" sid="2SA 16:22" />Tennexxee Abeseloomi'a Mootummatike minixxe xelephpho hana duunkaana isi'a onte; ookkonna Isira'eeliki ardi duuchchi uuda'naa anni ifikixxe melaallenni welti diiphe.<note caller="-" style="x"><char style="xo" closed="false">16:22 </char><char style="xt" closed="false"><ref loc="2SA 12:11-12">2 Sam. 12:11-12</ref>. </char></note><verse eid="2SA 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 16:23" />Eettene yanna'ni Akixofeel uwwammaka gorsa duuchcha Mageniinke hiyyichchishsha assine adhdhina'nemman; edi wodda Daawwiti Akixoofeelika gorsa adhdhammashshanni Abeseloominna isika gorsa adhdhe.<verse eid="2SA 16:23" /></para>
  <chapter eid="2SA 16" />
  <chapter number="17" style="c" sid="2SA 17" />
  <para style="s1">Kuusi Abiseloomi'i Dedhise</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 17:1" />Akixofeelinna, Abeseloomii hiyyee qici, «Tommenna lame kuma manna filleeneexxi telchixxe hashsha'ni anna atika Daawwiti'i shorishshannoni. <verse eid="2SA 17:1" /><verse number="2" style="v" sid="2SA 17:2" />Isi goofamma woddanna hunna gophamma wodda ani lola iso'ni ke'issannon; weekenshatanna iso'ni iyyedagannon. Ookkoneechchi uduma aninna isinni welti hedhemmak ardi isoo waale baaje'naa qofi gateemmaka moyanjo shiyannon; <verse eid="2SA 17:2" /><verse number="3" style="v" sid="2SA 17:3" />arda duuchcha atibaa hiissannonn; ati kinni mitte manji callixxe reyo hassaaten. Ookkoneechchi uduma ardi duuchchi nage'ik hedhaan.» <verse eid="2SA 17:3" /><verse number="4" style="v" sid="2SA 17:4" />Kunni gorsi Abeseloominna isinni welti hexxemmaxxa Isira'eelixxa akeekisanuwwa duuchcha gammachiiseen.<verse eid="2SA 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 17:5" />Abeseloomi kinni, «Amme mee Arkichcho Huusheyi ye'we isi hiyyaaxxanna lanqo» hiyye. <verse eid="2SA 17:5" /><verse number="6" style="v" sid="2SA 17:6" />Huusheyinna Abeseloomibaa dagee hiyyee qici: «Akixofeel no'oo gorse'een; yoona konne isi hiyya'neeka qorsa adhdhinoo? Kada gophoole atika ya'a amo mee no'o'ni kuli» hiyye.<verse eid="2SA 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 17:7" />Huusheyinna Abeseloomii hiyyee qici: «Akixofeel uwweeki gorsi tenne yanna'a elokebaan. <verse eid="2SA 17:7" /><verse number="8" style="v" sid="2SA 17:8" />Anni atikinna isinni welti hedheeki manni riffi hiyabaake lolinke mannanna beltanna isixxa hundii'ni adhineeke gochcho fakkaatake biniicnhishsha soodaachinsaake kandeexxa atinna egendeeten; higgeenni anni atikinna lolinxa lumoxxa ege'na afeeken; hashsha lolinke manninni welti galabaani. <verse eid="2SA 17:8" /><verse number="9" style="v" sid="2SA 17:9" />Ta'a midde mitte wolo'o'ni yookaan wele booncho'ni sho'omaaxxe hexxeen. Daawiti edise loleexxi, atika lolinka manna heenoka shiyoole; tenne laqeeki duuchchi, ‹Abeseloomixxa duuka me'emmaki lolinki reye mude› hine oddeessinaan. <verse eid="2SA 17:9" /><verse number="10" style="v" sid="2SA 17:10" />Anni atiki lumoshsha lolakee ege'nemeekenna isinni welti hedheekirinna jannuwwake kandeexxa Isira'eeli duuchchi egendemmaaxxee, neenqinsha godobi riffi hiyyabaake hiyyemeeki udumi'a higabaaki lolinki manni midde sodaate culphisaan.<verse eid="2SA 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 17:11" />«Tennexxe ani atee gorssaaneki gorsi, Laakkossi insa'neeki abbayyati qariqqarike maanchishsha bira sa'eeka Daanii'ni Berisaabehi qiconi hedheeka Isira'eelika arda duuchcha atibaa bukki hiyyaashsha assite ati umi atngenninni lolinike mannike akeekisanjo kaddee lolinbaa'a arda adhdhite me'i. <verse eid="2SA 17:11" /><verse number="12" style="v" sid="2SA 17:12" />Ookkoneechchi uduma Daawwiti ee'yeeke booncho duuchch'ni e'yinennexxi isoo lolannon; kaade iimi'ni buttinake'ni ibbammaashsha no'onna iso'ni hana inbannon; isinna kadi isiki loliinki manni midde mittikinna lubboti gatabaan; <verse eid="2SA 17:12" /><verse number="13" style="v" sid="2SA 17:13" />Isinna konne qachchuwwi giddi'ni mitteke'ni e'yoole, Isira'eeliki ardi duuchchi ookkone qachchibaa wodaro aadhe mare'naa no'onna mitti kinji midde ookkone qachchiba afemabaasha dhooqa giddi'a hunnannon.»<verse eid="2SA 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 17:14" />Abeseloominna Isira'eeliki ardi duuchchi, «Akixoofeelike gorsi irra Arkichcho Huusheyika gorrisa woyyaan» hiyye; Duuchchi Woddik Gootti Abesoloomi'ni ba'ne geessiso'a hiyyee eloka Akixofeelika gorsa adhemabaashsha assen.<verse eid="2SA 17:14" /></para>
  <para style="s1">Daawwiti Baaje Fuleexxa</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 17:15" />Huusheyinna qeese, Saadooqinna Abiyataari'i hiyyee qici: «Akixofeel Abeseloominna Isira'eelixxi geedhuwwa maa assiyo hasissaaxxa insa'ne gorseemman; aninna kinni tennee, tennee asse hiyye insa'nee gorseennen. <verse eid="2SA 17:15" /><verse number="16" style="v" sid="2SA 17:16" />Ta'a yoona moyanjikinna isinni welti hedheeki ardi duuchchi ‹Ko'o geltebaangi rakine foofe, foofa gophottole kinni moyanjikinna isinni welti hedhemmaki ardi duuchchi ha'noo biraan› hitine Daawwiti'ni kulle» hiyye.<verse eid="2SA 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 17:17" />Eettenne yanna Yoonataaninna Ahima'aatsi qachchi giddi'a e'yinaa wodda e'yinaa'naa insa'nee affabaasha sodaantemmaxxee; Enirogeeli hiyyemaake booncho'ni heqina'nemman; mitte ergatendammaxxi dubarichcho kadeexxa yaane ookko'a marta'ni insa'ne'a kuldaa wodda, insa'neenna kinni eettenne lanqemmaxxa moyanjo Daawwiti'ni kula'nemman. <verse eid="2SA 17:17" /><verse number="18" style="v" sid="2SA 17:18" />Yaane kinni mitti dargaggeessi belti insa'nee uudemmaxxee mareexxi Abeseloomi'a kulle; tennexxee lamingi rankee ke'neexxi Baahuriimi'ni hedheeke mitte manjike minibaa me'ine; manjichchikinna baxxe giddo wede'inxi bale hexxeemaxxee insa'nenna eettene bale'n e'yine. <verse eid="2SA 17:18" /><verse number="19" style="v" sid="2SA 17:19" />Ookkone manjichchixxi are baletike afo'o'ni hana midha fannammaka gasha farri assiteexxi ayyinna ege'nabaashsha midha hana falte. <verse eid="2SA 17:19" /><verse number="20" style="v" sid="2SA 17:20" />Abeseloomiki manni ookkone minibaa eettene manjichchobaa mareexxi, «Ahima'aatsinna Yoonataani haba he'ne?» hine qorre.</para>
  <para style="p" vid="2SA 17:20">Manjichotinna «Wode'e foonfe me'ineen» hite insa'ne'a hiissite. Insa'nenna hanseexxi afa dande'a gonpheemmaxxee Iyyerusaalemi'a hinge me'ine. <verse eid="2SA 17:20" /><verse number="21" style="v" sid="2SA 17:21" />Mannikinna me'ineechchi uduma iikki lamigi manni baletenaa'ni fuleexxi me'e; moyanjo Daawwiti'anna, kaddeexxa yaane duuchcha kulleen; Akixofeel insa'ne'aa gorsemmaka gorsa ca'a assine ege'nishsheechchi uduma «Rakketexxi wode'e foofi» isoo hine. <verse eid="2SA 17:21" /><verse number="22" style="v" sid="2SA 17:22" />Tennexxe Daawwitinna isixxa duuka me'ammaki ardi duuchchi ke'eexxi Yordanosika wode'e foonfe; bogi soodee wodda Yordaanoosi'i foofebaak mittikinna gateek hedhemmabaan.<verse eid="2SA 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 17:23" />Akixofeelinna gorsa isika adhdha ginbeexxa uudeexxi harre ifixxa fe'edheexxi isi hedhammaake qachchibaa me'e; mini ifikiba'a me'e; duuchchinixxa yaane boonchi boonchiki abidiseechchi uduma ifinni ifi suruudheexxi reye; anni isikike hirreesa'nina mogemeeni.<verse eid="2SA 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 17:24" />Abeseloominna Isira'eeliki ardi duuchchinni welti Yordaanoosii'i foonifee wodda Daawwiti kinni Mahinayimi hiyyemaaka qachcha geyeemman. <verse eid="2SA 17:24" /><verse number="25" style="v" sid="2SA 17:25" />Abeseloomi Iyyo'aabixxa bakka Amaasa hiyyemaaka manjo loliinke mannke akeekisanjo asseexxi hariire; Amaasa Isira'eelichcho Yeterike beltomman; Yotorinna Iyyo'abixxe Ama Tsuriyaxxi dayyo Na'osixxa belto Abigeeli'i aadheemman. <verse eid="2SA 17:25" /><verse number="26" style="v" sid="2SA 17:26" />Isira'eelitonna Abeseloomi Gele'adike boga'ni ofolleemman.<verse eid="2SA 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 17:27" />Daawwiti Mahinayimi geyee wodda; Amoonitotike qachchanaa'ni Raaba'ni dageek, Na'oosik belti Shoobi Lodebaarike qachchanaa'ni dageeki Ami'eelik belti Makirinna Roogiliimii'n dageek Gele'adichchi Baarzilaayini'i alfe. <verse eid="2SA 17:27" /><verse number="28" style="v" sid="2SA 17:28" />Inisa'nenna fa'inne diinphammaxxa seemmuwwa, heddo qoruwwa, faarinka miyyuwwa odolchuwwatanna iyyedange; iittanni dinnetanna so'a, bulletanna anneeka tishsha, baaqelakanna misira, <verse eid="2SA 17:28" /><verse number="29" style="v" sid="2SA 17:29" />Malebo, itichcha, gedhebokanna laliinxe adoka cicita, indo'aa Daawwiti'aanna ardakee iyyedange; tenne assinnechchi, «Ardi qiilla gamooje'ni solo'weeni; gophe'een, dheebo'ween» hineeteni.<verse eid="2SA 17:29" /></para>
  <chapter eid="2SA 17" />
  <chapter number="18" style="c" sid="2SA 18" />
  <para style="s1">Abeseloomixxa Reyo</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 18:1" />Daawwiti isinni welti hedhemmaka arda mitteba bukki asseexxi kuma loliinka manna ajajammakanna dhibba loliinka manna ajajammakaara hariire. <verse eid="2SA 18:1" /><verse number="2" style="v" sid="2SA 18:2" />Daawwitinna sannachchuwwa sasekena'ni mitte anga Iyyo'aabi'ni, sasekena'ni mitte anga Iyyo'aabike dayyike Tsuriyake belto'n Abisayi'ni, sasekena'ni mitte anga kinni Gaatichcho Itaayixxe ajajallummanni insa'nen erge. Moyanjikinna sannachchuwwakee, «Ani umi anginninni ha'noonni welti dhugaanda duulanon» hiyye.<verse eid="2SA 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 18:3" />Mannikinna, «Ati fula hasissabaan; no'o baqantottole manni no'o tuffataaxxe hexxen; gamisi no'oki rennonnole midde insa'ne'a maachchonabaan; ati mitti no'oo tomme kuma saxxatton; tennexxe ati qachchake'ninni hexxe no'oo gargaartettele woyyan» hinne.<verse eid="2SA 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 18:4" />Moyanjikinna, «Ha'no'a eloxxe fakkaate leelliteexxa duuchcha assannon» hiyye insa'ne'a hiisse. Tennexxe ardi duuchchi kumikinna dhibbiki kuta kuta'ninni googeessiki fulaana'a moyanji dalla'iinxe hula'ni uurreemman. <verse eid="2SA 18:4" /><verse number="5" style="v" sid="2SA 18:5" />Moyanjikinna Iyyo'aabii'i, Abisaanna Itaayi «Ani'a hitine'e darigaggeessa belto anke Abeseloomi'ni elobaaxxa assitinoqqee» hiyye ajaje. Moyanjikinna belto ifika Abesoloomi'i uuddaxxini mitte mitte ajajali'a ajaja uwwaa wodda; lolinki mann duuchchi laqe.<verse eid="2SA 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 18:6" />Loliinki mann Isira'eeli lollo'a googeessiki diidinbaa fulle; lolakanna Efireemike gongomi giddo sanfe. <verse eid="2SA 18:6" /><verse number="7" style="v" sid="2SA 18:7" />Ookkoonna Isira'eelixxa baagediinxa hunna Daawwitixxi bagediinxi hunna injifatte. Eettenne barra'ni lumoki manni mudeen; lame tommi kumi manni eettene barra'ni shyeme. <verse eid="2SA 18:7" /><verse number="8" style="v" sid="2SA 18:8" />Loli boga duuchcha'ni geyemmaxxee eettenne barra'ni wolaantichchki shineeke manni iimi darre raaqake'ni liqiinseme gateeke manniki laakkossi bira sa'eeni.<verse eid="2SA 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 18:9" />Eettene yanna'ni Abeseloomi Daawwittike manninni welti dedhange'ni afemme; Abesoloomi gaange gulufeexxi me'a'ni hedhemaxxee; gangige damuwwa bira saxxeeke mitte lumoke qilixxi hundi'ni saxxaa wodda Abesoloomika umo dame abidde; gulufeemmaxxi; gaangichchonna isi hundii'ni saxxe meitee wodda; Abesoloomi iimanni fanniseme gate. <verse eid="2SA 18:9" /><verse number="10" style="v" sid="2SA 18:10" />Mitti manji tenne uudeexxi Iyyo'aabi'i, «Kunnisetenni Abeseloomi qilxiinke haqichcho'ni fannisemee'naa uudennen» hiyye kule.<verse eid="2SA 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 18:11" />Iyyo'aabinna kulemmaka manjo, «Maa hitette! Uudetelchinni mayee ookkone wodda gande'e butta ibisa gophphetelchi? Gande ibisetelcho kadeele ani ati'a tomme birretika sibiljonna mitte Zinnara ati'a badhaasannani» hiyyexxi hiise.<verse eid="2SA 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 18:12" />Manjichchi kinni hiyyee qici: «No'o lanqaa'naa moyanji, ‹Darigaggeessa Abeseloomi'n fugooxxi geltabashsha anxee hitineexxi isoo heqqe› hiyyexxi atte'e, Abisaaninna Itaayi ajajeemmaxxe kadeemmaxxee, mitte kuma birretika sibljo ani'a laako'e uuwweexxe kaddolenna midde moyanjike belto'ni anga anxa ke'isabo'non. <verse eid="2SA 18:12" /><verse number="13" style="v" sid="2SA 18:13" />Wele darreeni ani lubbo anxa gibe'e Abesoloomi shiyenechcho kaddeele moyanjokenaa'n sho'onde gattaaxxi yaane hedha gophphpaammaxxee silaan atinna ani biri'a shiqqatammabaani» hiyye hiise haaso'e.<verse eid="2SA 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 18:14" />Iyyo'aabinna «Yooni konnee qicini ani atinni welti yanna tolanga balleessonaa hasabo'non» hiyye; tennexxee angate'ni sase bagedo abixxe me'exxi Abeseloomi qilixxakee'ni lubbonidinni fanniseme hedhee'na bagedo darbeexxi godoba oteen. <verse eid="2SA 18:14" /><verse number="15" style="v" sid="2SA 18:15" />Itaanni Iyyo'aabika lolinka miyya ba'edhammakeranaa'ni; tommi Abeseloomii elqe kayyi'ni buqqeexxi bagediki onte shinne.<verse eid="2SA 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 18:16" />Ookkoneechchi uduma Iyyo'aabinna loli urraashsha malagata ufuunfaashsha ajajeen; lolinki manninna Isira'eelika arda shorrshsha waalle udumi'a hige. <verse eid="2SA 18:16" /><verse number="17" style="v" sid="2SA 18:17" />Abeseloomika renshanna aa'neexxi raaqi giddo hexxeexxe lumoxxe bale giddo darbineen; eettene bale'ni heddo lumollamma kino tuule. Eettenne yanna Isira'eeliki ardi duuchchi baqateexxi mitti mittinigi manji mini mini ifnigiba'a me'een.<verse eid="2SA 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 18:18" />Abesoloomi, «Summa anka ye'isaaka mittekanna labbaka belto afeebo'non» hiyyexxi kassi isixxe kaddaashsha lubboti hedhemma wodda «Moyanjinxe dhooqa» hinaake booncho'ni ifike summinni sooddo karriseman; telchi qico'ni Abeseloomixxe sooddo hine ye'na'neen.<verse eid="2SA 18:18" /></para>
  <para style="s1">Daawwiti Abiseloomi Reyemaxxe'e Yaade</para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 18:19" />Eettenee yanna Saadooqik belti Ahima'aatsi, «Duuchchi Woddik Gootti naaphake'ni halo fulemmaxxee moyanjoke'ni gammashotixxa odo kuloo» hiyye.<verse eid="2SA 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 18:20" />Iyyo'aabinna, «Waawwoti telcho gammachchiissaaxxa odo marte odeessitattoki atetebaani; moyanjinki belti reyemmaxxee; telchote kaddebaaki gammachchiisaaxxa odo wele yanna marte odeesitattoni» hiyye.<verse eid="2SA 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 18:21" />Ookkoneechchi uduma Iyyo'aabi mitte Tophiyiichcho, «Martettexxi uuddettexxa moyanjoke'ni kuli» hiyye. Tophphiyichchikinna anga ifixxa iimi'a ke'isseexxi gonga'ni me'e.<verse eid="2SA 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 18:22" />Saadooqik belti Ahima'aatsinna higgeenni Iyyo'aabi'i, «Kaddeexxi kaddowwaal; maganneteni Tophiyiichcho dhaqabona'a gonga'ni maro» hiyye.</para>
  <para style="p" vid="2SA 18:22">Iyyo'aabinna kinni «Anike beltoo; mayee marto'ta'a hassette? Badhadha badhatattoshsha maachcho gammachchiisaaxxa odo marte kuldota'ate?» hiyye isi'a hiisse.<verse eid="2SA 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 18:23" />Ahima'aatsinna, «Kaddeexxi kaddowaal; maronnaa hasaannen» hiyye.</para>
  <para style="p" vid="2SA 18:23">Tennexxe Iyyo'aabinna, «Yooni gongita'ni me'i» hiyye. Ookkoneechchi uduma Akimaasi Yoridaanosixxe dhooqabaa geessisaaka ora gonga'ni me'eexxi Tophiyiichchi geyebaanigi iikki woddi mare geeye.<verse eid="2SA 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 18:24" />Daawwiti ookkone qachchixxe gadhixxenna giddixxe hulaxxe oddo'ni ofo'leenaa; dalla'iinxa hula heqqaammaaki dalla'i hana hulatiba hexxeexxe xeelphootixxe xungo'ni fule uurre gadhi'a uudaa wodda mitti manji qofittinni gonga'ni dagaa'naa uude; <verse eid="2SA 18:24" /><verse number="25" style="v" sid="2SA 18:25" />Hula heqqaammakinna hafuura ifika qeerrisee ye'eexxi uudeexxa yaane moyanjoke'ni kule.</para>
  <para style="p" vid="2SA 18:25">Moyanjikinna, «Qofittinni hedheeke kadoole eloxxa odo aadhe dageeke kadaan» hiyye. Iikki gongammaki manjichchinna shiqa'ninni daageeni.<verse eid="2SA 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 18:26" />Heqqanjikinna higgee'naa weli manji gonga'ni dagaa'naa uudeexxi daalla'iinxa hula heqqammaka ye'eexxi «Uudi! Weli manjinna qofinni gonga'ni dagate'ni hedheen» hiyye. Moyanjikinna, «Kunninna eloxxa odo aadhe daga'neeke kada dande'aan» hiyye hiisse.<verse eid="2SA 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 18:27" />Heqqanijikinna hiyyee qici, «Iikki edo hedhe gonga'neeki manji Saadoqike beltishsha Ahima'aatsishsha gonga'neekeni» hiyye.</para>
  <para style="p" vid="2SA 18:27">Moyanjikinna, «Isi eloke manjon; eloxxa odo aadhee dagaan» hiyye.<verse eid="2SA 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 18:28" />Ookkoneechchi uduma Ahima'aatsinna hafuura qeerriseexxi moyanjo, «Duuchchiinxi yaane elo qicinni muuxxende'eeni» hiyyexxi; moyanjii edo albik gonbisemeexxi anga iimi'a ke'isseexxi; gootta moyanjo anke'ni fugoxxinni ke'emmaka manna anga atixxe'ni «sa'isse uwweki Duuchchi Woddik Gootti Mageni saadema'ni hedhowwaal!» hiyye.<verse eid="2SA 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 18:29" />Moyanjikinna, «Dargaggeessi Abeseloomi nagi'aangee?» hiyyeexxi qore.</para>
  <para style="p" vid="2SA 18:29">Ahima'aatsinna, «Iyyo'aabi moyanjinka erganjonna anee erganjo atika ergo'a hiyya wodda, jabaxxi raankensha uudennen, yaane kinni ani maacho kaddeexxa ege'nebe'non» hiyyexxi hiisse.<verse eid="2SA 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 18:30" />Moyanjikinna isoo, «Edi'a saxxe uuri» hiyye. Isinna edi'a sa'eexxi uurre.<verse eid="2SA 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 18:31" />Ookkoneechchi uduma Tophiyiichchi dage dhaqqabeexxi, «Anke gootta moyanjo, gammashshotixxa odo! Telcho Duuchchi Woddik Gootti ate'ni ke'eeke naapha atike duuchchana'ni atee anjire'een» hiyye.<verse eid="2SA 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 18:32" />Moyanjikinna tophphiyichcho, «Dargaageessi Abeseloomi nage'angee?» hiyye isoo qore.</para>
  <para style="p" vid="2SA 18:32">Tophiyiichchikinna, «Anke goottike moyanjiink naaphinna atee miidho'a ate'ni ke'aaki duuchchi ookkone dargageessishanni kaduun» hiyye hiisse.<verse eid="2SA 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 18:33" />Moyanjikinna yo'oshsha yaadeeni. Isinna dalla'iinxe hula iimi gama hedheeke mini iima fuleexxi oodhe. Me'ee woddanna, «Koo anke belto Abiseloomi! Anke belto Abeseloomi! Atixxe bakka'ni maa hedhe silaa ani reyeenelee! Koo Abiseloomii, anke belto, aanne anke belto!» hiyya'ni hiiqqise oodhe.<verse eid="2SA 18:33" /></para>
  <chapter eid="2SA 18" />
  <chapter number="19" style="c" sid="2SA 19" />
  <para style="s1">Iyyo'aabi Daawwiti'i Xixe</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 19:1" />Iyyo'aabi, «Moyanji Daawwiti ifike belto Abeseloomixxee yaada'ni oodha'nen» hiyyende iso'ni kulnde. <verse eid="2SA 19:1" /><verse number="2" style="v" sid="2SA 19:2" />Moyanjikinna, «Belto ifikixxee yaade'een» hiyyendeexxa eettene barra loliink manni laqeemmaxxee, eettene barraxxe injifachchoxxi gammashsho loliinke manna duuchcha'ni yaaddote'ni jijjirende. <verse eid="2SA 19:2" /><verse number="3" style="v" sid="2SA 19:3" />Eettenne barra'ninna lolakenaa'ni baaje shooke quushshi hiyye qachchi giddi'a e'yammake manjishsha ardikinna hangulli hiyye qachchi giddi'a e'ye. <verse eid="2SA 19:3" /><verse number="4" style="v" sid="2SA 19:4" />Moyanjikinna alba ifika buqedheexxi, «Anke belto koo Abeseloom! Koo anke belto Abeseloomi! Koo anke belto! Aanne anke beltoo!» hiyya'ni hiiqqise oodhe.<verse eid="2SA 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 19:5" />Ookkoneechchi uduma Iyyo'abi moyanjinke minibaa e'yeexxi hiyyee qici: «Atixxa, labbaxxenna meyyaxxe atixxe ooseka, atixxe aruwwakanna atixxe shiixoxxe aruwwaxxa lubbo gatisemmaka manna duuchcha telcho insa'nee shookishsheten. <verse eid="2SA 19:5" /><verse number="6" style="v" sid="2SA 19:6" />Atee jibbaakaara eetatton atee eeyyaakaara jibbitatton. Atike lolinke mannik ajajalluwwinna insa'neek loliink manni ati'a woyi fula'neebaaxxa kunnise telcho farri assiteetten. Techcho Abeseloomi hedhoti hedhee'naa no'o duuchchiingi renne mundeennelcho kaddeele ati gammaddattexxa telchixxe barra'ni uudennen. <verse eid="2SA 19:6" /><verse number="7" style="v" sid="2SA 19:7" />Kexxe ta'a gadhi'a fuldettexxi atika manna jajjabeessi. Ati fula gophphottole kinni mitti manjinna atinni welti hedabaaxxa Duuchchi Woddike Goottik summinni kakataannen. Tinninna oosumma atixxenaa'ninni saffe telchi qico'ni ate'ni gelteexxe elobaaxxe yaane duuchchanaa'ni baaseexxa ko'o ate'ni geessissaan.» <verse eid="2SA 19:7" /><verse number="8" style="v" sid="2SA 19:8" />Tennexxe moyanji ke'eexxi hulati qarqara ofo'le. Ardakeenna, «Moyanji hulati qaraqara ofo'le'een» hiyyende kulndee wodda ardi duuchchi moyanjiba'a dage.</para>
  <para style="s1" vid="2SA 19:8">Daawwiti Iyyerusaalemi'a Hige</para>
  <para style="p" vid="2SA 19:8">Eettene yanna'n Isira'eeliki ardi duuchchi ifi ifike miniba'a baajemman. <verse eid="2SA 19:8" /><verse number="9" style="v" sid="2SA 19:9" />Isira'eelike gosa gosake mini hado'ni ardi, «Moyanji naapha no'okixxe anganaa'ni no'oo fulche'een; Filisixeemitotixxe anganaa'ni no'oo anjireek isoten; tennexxee ta'a kinni Abeseloomixxe buutonaa'ni kexxeexxa bogi giddii'ni baaje me'edheen; <verse eid="2SA 19:9" /><verse number="10" style="v" sid="2SA 19:10" />no'oo moye galchaaashsha hariirennek Abeseloomi kinni lolake'ni reyeedhen; moyanjo mayeeta hiissa gophine sammi hitinchii?» iitta hina'ni weli'anni weli moroma'nemman.<verse eid="2SA 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 19:11" />Moyanji Daawwitinna Isira'eelito weli'aanni weli haasoteexxa laqe; tennexxee eettenee qeese Saadooqinna Abiyataari'i ergeexxi Yihudaka akeekisanjuwwa hina'n qorro'a insa'nee ajajee qici, «Moyanjo gargaartineexxi isike moyetike minibaa illee iima hissatee mayee udumitine? <verse eid="2SA 19:11" /><verse number="12" style="v" sid="2SA 19:12" />Ha'noo anke maalanna micco kaddineeke anke dayyuwwan; mayeeteta moyanjo hiissatee udu'mitineeke kaddine?» <verse eid="2SA 19:12" /><verse number="13" style="v" sid="2SA 19:13" />Amaasa'ninna, ‹Atiqqa maala ankenna micco ankebaa? Ta'inaa'ni lubboti hexxete qico'ni Iyyo'aabixxe bakka'ni anke loliinke mannike ajajallo assa gophonnole Mageni anee shiyo tennenaa'ni saxxeexxa rakko ane'ni geessisoo› » hitine iso'ni kulle hiyye.<verse eid="2SA 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 19:14" />Isinna Yihudak ardi duuchchi isi'aa xuurameesa kadaasshsha asseen. Insa'nenna, «Atinna atik ardi duuchchi higge» hine iso'ni erga ergine.<verse eid="2SA 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 19:15" />Ookkoneechchi uduma moyanji higeexxi Yordaanoosi qico'n dage.</para>
  <para style="p" vid="2SA 19:15">Konne wodda Yihudak manni moyanjo qophe'neexxi Yordaanosi'i foosastee Geligeela qico'ni dangeemman. <verse eid="2SA 19:15" /><verse number="16" style="v" sid="2SA 19:16" />Ookkone wodda Baarhuriimik bogi manjo kadeeki Geeraki belti Biiniyaamichchi Saami Yihudake manninni welti hedheexxi moyanjo Daawwiti'i qophedho'aa rakee adadde dirre.<note caller="-" style="x"><char style="xo" closed="false">19:16 </char><char style="xt" closed="false"><ref loc="2SA 16:5-13">2 Sam. 16:5-13</ref>. </char></note> <verse eid="2SA 19:16" /><verse number="17" style="v" sid="2SA 19:17" />Isinni weltinna mitte kuma Biiniyaamito, iitanni Sa'oolike mini hadiki ergaji Siiba tommenna onde labbaxxe oossenninna lame tomme ifike erganjuwwinni welti mitteba he'nemman. Ookkoneechchi uduma moyanji hedheebaa Yordaanoosi'a ranke adadde dirrine. <verse eid="2SA 19:17" /><verse number="18" style="v" sid="2SA 19:18" />Moyanjiinka mini hado iyyedagateenna isi harsaaxxa duuchcha assatee wode'e foonfe.</para>
  <para style="s1" vid="2SA 19:18">Daawwiti Shiimi'a Gattowwaal Hiyyeexxa</para>
  <para style="p" vid="2SA 19:18">Geeraki belti Saami Yordaanoosii'i foofe; isinna moyanjii edo albiki gonbisemeexxi; <verse eid="2SA 19:18" /><verse number="19" style="v" sid="2SA 19:19" />Hiyyee qici, «Anki gootti balleessa anxa laakko'oqqe'e; moyanjo anke gootta Iyyerusaalemii'n fuldettexxa barra balleessendaxxa balleessa ani'a waali; halo abixxitoxxee. <verse eid="2SA 19:19" /><verse number="20" style="v" sid="2SA 19:20" />Ani atik erganji cubbo hujeennexxa ege'neennexee; telcho kinni gootta anka moyanjo qophedhonna'a Yooseefike mini hidi duuchchanaa'ni taakake kadee kunni dageennen.»<verse eid="2SA 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 19:21" />Ookkoneechchi uduma Tsuriyak belti Abisa, «Saami Duuchchi Woddik Gootti hariireka yowweemmaxxee reyo isi'a hasisabaa?» hiyye.<verse eid="2SA 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 19:22" />Daawwitinna, «Ha'noo Tsuriyaxxe oose, ha'noonna anee maacho afensiisaa? Ha'noonna telcho ane'ni naaphake kaddine'een! Ayyetenna kadoole telcho Isira'eeli giddo manji reya hasissaa? Ani Isira'eeli'ni moyanjo kadeennexxa ege'nennexxe barrabaa?» hiyye hiisse. <verse eid="2SA 19:22" /><verse number="23" style="v" sid="2SA 19:23" />Tennexxe moyanji Saami'i, «Rertaboxxen» hiyye kakate.<verse eid="2SA 19:23" /></para>
  <para style="s1">Daawwiti Mefebosite'a Marareexxa</para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 19:24" />Sa'oolik belti Mefibosheetinna moyanjo qophedho'a adadde dirre. Moyanjikinna shorremeexxe yannanaa'ni ke'issee higeexxe barra qico lekka ifixanna anshedhebaan; areedakanna haaxxebaan; seemma ifixxanna borcedhemmabaan.<note caller="-" style="x"><char style="xo" closed="false">19:24 </char><char style="xt" closed="false"><ref loc="2SA 9:1-13">2 Sam. 9:1-13</ref>; <ref loc="2SA 16:1-4">16:1-4</ref>. </char></note> <verse eid="2SA 19:24" /><verse number="25" style="v" sid="2SA 19:25" />Isinna moyanjik welti afematee Iyyerusaalemii'n dageexxa yanna moyanji, «Koo Mefibosheeti anxa duuka daga gophteelchi mayete?» hiyye laqe.<verse eid="2SA 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 19:26" />Isinna hiyyee qici, «Anke gootta moyanjo, ani erganji atik naafake kadeennaxxee, ‹Moyanjik welti me'onaa'a harrichcho anke'n gulufona'a› hiyyeenabaa. Kaddo malee erganji anki Siiba anee sobeen. <verse eid="2SA 19:26" /><verse number="27" style="v" sid="2SA 19:27" />Goota anke moyanji edo anka atike erganjika summa balleesseen. Anke gootta moyanjo ati iimike erganjishsha kaddeettaxxee ate'ni fakkaate leelliteexxa assi. <verse eid="2SA 19:27" /><verse number="28" style="v" sid="2SA 19:28" />Anke moyanjo anke annike mini hadi duuchchi'a sila reyote hasissamman; ati kinni erganjo atika anee indaaxxe qore bira ofo'lishsheten. Konneechchi iima ani'a assendowwaal hiyyee moyanjo laqonna'a maa seera afeene?»<verse eid="2SA 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 19:29" />Moyanjikinna isoo, «Mayee haaso'aa bira sa'isitaatte? Atinna Siiba fichcha duuchcha qoodendinaasha ani ajajeennen» hiyye.<verse eid="2SA 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 19:30" />Mefibosheetinna moyanjo, «Moyanjo anke goottaa fichcha duuchcha Siiba adhdhowwaal; ani'a ati nage'iki mine atike'ni higiyyo calli ani'a geltaan» hiyye.<verse eid="2SA 19:30" /></para>
  <para style="s1">Daawwiti Baarizilayi'a Eloxxa Asseexxa</para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 19:31" />Iittanni Gele'adichchi Baarizilayi moyanjo qoqqobeexxi Yordaanoosika galaana foofatee'e Roogiliimii'ni adadde dirre dage;<note caller="-" style="x"><char style="xo" closed="false">19:31 </char><char style="xt" closed="false"><ref loc="2SA 17:27-29">2 Sam. 17:27-29</ref>. </char></note> <verse eid="2SA 19:31" /><verse number="32" style="v" sid="2SA 19:32" />Ookkone wodda Baarizilaayi Saddeeta tomme wogake geerchomman. Isinna yo'oshsha duroomeemmake manjomman; moyanji Mahinayimi hedhemma wodda itaachcho isi'a iyyedageemman. <verse eid="2SA 19:32" /><verse number="33" style="v" sid="2SA 19:33" />Moyanjikinna Baarizilaayi'i, «Atinna aninni welti fooffe Iyyerusaalemi'i aninni welti hedhi; ani ati'a ittattolcho uwwannon» hiyye.<verse eid="2SA 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 19:34" />Baarizilayi kinni moyanjokee hiyye hiisee qici, «Moyanjiki welti Iyyerusaalemi'a me'aannek haba hexxeexxe wogga'a hiyyeete? <verse eid="2SA 19:34" /><verse number="35" style="v" sid="2SA 19:35" />Ani ta'a saddeeta tomme woggake geerchon; yoona ani eloxxanna elobaaxxa foye ege'na'noggee? Ta'inni edi'a atiki erganji itaachchonna kaddo ha'waachcho anja isixxa gargar hiissa dande'anno? Mansha anxinna labbakikanna meyyaxxike sirbika hafuura laqa dande'anoggeta? Yoona erganji atik moyanjo anke gootti'a mayeeta higgeenni ba'ote kadanno? <verse eid="2SA 19:35" /><verse number="36" style="v" sid="2SA 19:36" />Erganji atiki Yordaanoosii'i foofee moyanjik welti shiixxo qico me'annon; yaane kinni moyanji konne qicinni ani'a uwwa uwwa'neeki mayeete? <verse eid="2SA 19:36" /><verse number="37" style="v" sid="2SA 19:37" />Ani anigge qachcha'ni reye anke annikenna anxe amake hirreessi bira moogemannoshsha erganjo atika anee hige me'onaa'a eeti'i ani'a uwwi. Yaane kinni erganji atik Ke'ami moyanjo anke goottinna welti foofowwaal. Ati eetettexxa ani'a assi.»<verse eid="2SA 19:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 19:38" />Moyanjikinna, «Keme'aami aninni welti foofan ati eetattexxa yaane duuchcha isi'a assannon. Atinna anenaa'ni hassaattexxa feetenxa yaane ati'aanna assannon» hiyye. <verse eid="2SA 19:38" /><verse number="39" style="v" sid="2SA 19:39" />Tennexxe ardi duuchchi Yordaanoosii'i foofe, ookkoneechchi uduma moyanjikinna foofe. Moyanjikinna Baarizilaayii'i sunqedheexxi eebbiseen, Baarizilaayinna ifike miniba'a hige.<verse eid="2SA 19:39" /></para>
  <para style="s1">Yihudikinna Isira'eelik Ardi Daawwitixxee Moromeexxa</para>
  <para style="p">
    <verse number="40" style="v" sid="2SA 19:40" />Moyajikinna Geligeela'a me'ee wodda, Keme'aami isinni welti me'e. Yihudak loliinka manni duuchchinna ittanni Isira'eelike loliinke mannik gamisi moyanjo qoqqonbeexxi foossine. <verse eid="2SA 19:40" /><verse number="41" style="v" sid="2SA 19:41" />Illee iima Isira'eelik ardi duuchchi moyanjinbaa dageexxi, «Dayyuwwi no'oki Yihudak manni moyanjo sho'ne insa'ne qofiti adhdhine isoonna isika mini hado isixxa duuka me'ammakeerinni welti Yordaanoosi'i mayee foossine?» hine.<verse eid="2SA 19:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="2SA 19:42" />Yihudak manni duuchchi Isira'eelike manni'a, «No'o tenne assineenelchi moyanji no'o'a firunteti shiqaammaxxeeten; tinni ha'noo mufachchiissaaxe'e? No'o moyanjokenaa'ni adhdhine indeneelchi hedhee? No'o ifi'a adhdhinenelchi hedhee?» hine.<verse eid="2SA 19:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="2SA 19:43" />Ookkoneechchi uduma Isira'eelik manni Yihudake manni'a, «No'oqqa monyajokena'n tomme anga qoobo anfeenne; tenne'ni hana no'o Daawwitii'i harsitina'nee irra no'o isoo harsinaannen; yoona ha'noo no'oo tuffatinlchi mayeetee? Moyanji no'oki higaashsha edinsenexxi lanqeenneki no'otebaa?» hine.</para>
  <para style="p" vid="2SA 19:43">Yaane kinni Yihudik manni uwweek hiissichchi Isiraleeki manni uwweeke hiissichchi irra yo'oshsha jabakemman.<verse eid="2SA 19:43" /></para>
  <chapter eid="2SA 19" />
  <chapter number="20" style="c" sid="2SA 20" />
  <para style="s1">Saabe'e Daawwiti'ni Fuggoxxinni Ke'e</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 20:1" />Eettene yanna Bikiirik belti Saabe'e hiyyemaak mitte adaba elobaka afeeki Biiniyaamichchi ookko hedhemman. Isinna malagata ufuufa'ni hiyya'ni lassee qici:</para>
  <para style="q2" vid="2SA 20:1">«No'o Daawwitinaa'ni qoobbo anfeebe'non,</para>
  <para style="q2" vid="2SA 20:1">Isseyike beltonaa'ninna qadaada anfeebe'non!</para>
  <para style="q2" vid="2SA 20:1">Tee Isira'eeli mitti mitti ha'noogi ifi ifike duunkaanibaa higge!» hiyye.<note caller="-" style="x"><char style="xo" closed="false">20:1 </char><char style="xt" closed="false"><ref loc="1KI 12:16">1 Moy. 12:16</ref>; <ref loc="2CH 10:16">2 Odo. 10:16</ref>. </char></note><verse eid="2SA 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 20:2" />Tennexxee Isira'eelik manni duuchchi Daawwiti'i ginbeexxi Bikiirika belto Saabe'ee'e hordonfe. Yihudak manni kinni Yordaanoosinaa'n Iyyerusaalemi qico'ni ifike moyanjuwinaa'ni gargar hingebaang isinni welti me'ine.<verse eid="2SA 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 20:3" />Daawwiti Iyyerusaalemi hedheeke ifixxe mootummatike miniba higee wodda, ifika mootummatika mine heqqito'a waale me'eemmaxxa tommiinxa shiixarra aruwwa ifixxa adhdhe. Isinna mitte mini giddo insa'ne heqqemaashsha asse. Isinna insa'ne'a indaachcho uwwe. Kaddo malee isinna insa'nenni welti galebaan, insa'nenna reyoti qico'ni aro'o affebaaxxe aruwwashsha qofiti foyemme wele mine'ni ofolle.<note caller="-" style="x"><char style="xo" closed="false">20:3 </char><char style="xt" closed="false"><ref loc="2SA 16:22">2 Sam. 16:22</ref>. </char></note><verse eid="2SA 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 20:4" />Ookkoneechchi uduma moyanji Amaasaa'a, «Yihudak manni duuchchi sase barra giddo anibaa'a dangaashsha insa'nee ye'i, ati umi atingenninni afemi» hiyye. <verse eid="2SA 20:4" /><verse number="5" style="v" sid="2SA 20:5" />Amaasanna Yihuda'a ye'o'a mare; yaane kinni moyanji ye'eexxe yanna'ni hige dago'a dande'ebaan.<verse eid="2SA 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 20:6" />Daawwitinna Abisaani'i, «Abeseloomi irra ta'a Bikiirik belti Saabe'e lumoxxa rakko no'o'ni geessiso'aten. Tennexxe atike goottika manna aaxxetexxi shorri, shorra gophphottole kinjiinke dalla'ika qachcha alfeexxi no'onaa'ni baqate fulaan» hiyye. <verse eid="2SA 20:6" /><verse number="7" style="v" sid="2SA 20:7" />Tennexxe Iyyo'aabi manni, Kelito, Felito iittanni wele jajjaba loliink manni duuchchi Abisake ajajinni fulle. Iyyerusaalemii'ni fuleekiirinna Bikiirika belto Saabe'e shorrino'atemman.<verse eid="2SA 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 20:8" />Geba'oon lumoke kinji bira he'nee'naa, Amaasa insa'nenni afemo'a dage. Iyyo'aabinna lolinka miya oddo'we wolaantichcha gonofiki hidhake'ni kadhdheemman, isinna edi'a me'eeshshanni wolaantichchi gonofakenaa'ni fule butta ibe.<verse eid="2SA 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 20:9" />Iyyo'aabinna Amaasaa'a, «Koo anke dayyo, nage'aange?» hiyye. Ookkoneechchi uduma isi Ammesayi'i sunqa'neesha kade middixxe anganni areeda isika abide. <verse eid="2SA 20:9" /><verse number="10" style="v" sid="2SA 20:10" />Amaasa kinni Iyyo'aabixxe angani wolaantichchi hedheexxa afa gopheemmaxxee ifi heqqedhebaan. Tennexxe Iyyo'aabi wolaantichchik godoba isika horde, ma'lumatinni butta lo'o hite. Ookkoneechchi uduma Iyyo'aabi reyeemmaxxee lebe'e otebaan. Iyyo'aabinna dayyi isik Abisa Bikiirika belto Saabe'e shorrichoke'ni ke'ni.<verse eid="2SA 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 20:11" />Ammesayike renshi bira uurremake Iyyo'aabik manni giddii'ni mitti, «Iyyo'aabiinna Daawwiti'i hordofaak duuchchi Iyyo'aabi hordoffowwaal!» hiyye. <verse eid="2SA 20:11" /><verse number="12" style="v" sid="2SA 20:12" />Amaasak renshi mundeti laaqeme. Oriinxe oddo'ni ibeemman; ookkoo'ni sa'aammak loliinki manni duuchchi uurreexxi konnee manjichcho ude. Ookkone renshiba'a mareeki loliink manni duuchchi uurreexxa isinna hubateexxi Ammeesayika rensha orakenaa'ni fichchi giddi'a shikki asseexxi seemma hana buyye. <verse eid="2SA 20:12" /><verse number="13" style="v" sid="2SA 20:13" />Ammesayik renshi orakenaa'ni ke'eechch uduma ardi duuchchi Iyyo'aabi'i hordofeexxi Bikiirika beto Saabe'e shorratee Iyyo'aabixxa duuka me'een.<verse eid="2SA 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 20:14" />Sheeba'i Isira'eelike gosa gosake mini hadi duuchchike bogixxe oddonaa'ni sa'eexxi Abeelibeetima'ika hinaake qachchibaa geye; Bikiirtotike bogiki manni duuchchi bukki hiyyeexxi Sheeba'inii'i hordofat ookkone qachchibaa e'ine. <verse eid="2SA 20:14" /><verse number="15" style="v" sid="2SA 20:15" />Iyyo'aabinni welti hedhemaki loliink manni dageexxi Saabe'e Abeeli Beeti Ma'iika darree'ni buqe. Ookko'ni dalla'i gadhii'ninna qachchiink kinjii dalla'ixxe xungo qico'ni qarqari duuchcha'ni buttina iimi'a tullunbe. Insa'nenna kinjiinka dalla'a diigate'e hundii'ni qotate'ni ke'ni. <verse eid="2SA 20:15" /><verse number="16" style="v" sid="2SA 20:16" />Mitte qaro manjichcho qonqo gikki assiteexxi, «Laqqee! Laqqee! Iyyo'abi'ni haaso'annexxi yaane hexxeemmaxxee kaba'a dagaashsha iso'ni kulle» insa'ne'ni hite. <verse eid="2SA 20:16" /><verse number="17" style="v" sid="2SA 20:17" />Iyyo'aabinna iseba mare, isenna, «Iyyo'aabite hinaak atetee?» hiteexxi isoo qorte.</para>
  <para style="p" vid="2SA 20:17">Isinna, «Eeti anenden» hiyyeexxi ise'a hiisse.</para>
  <para style="p" vid="2SA 20:17">Isenna, «Yoona ani erganjo atixxi hiyyaanexxxa laqi» isoo hite.</para>
  <para style="p" vid="2SA 20:17">Isinna, «Kadduuni hitaattexxa laqannon» isee hiyye.<verse eid="2SA 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 20:18" />Isenna itti lebbee hitee qici, «Edike baro'n manni, ‹Gorsa Abeelinaa'n qo'dhdhe› hina'nemman; yoona insa'ne hinemmashanni muuxendaamman. <verse eid="2SA 20:18" /><verse number="19" style="v" sid="2SA 20:19" />Isira'eeli giddo nage'ikenna addatemeek manni giddi'ni ani mitteten. Ati Isira'eeli giddo umoke kadeeka qachcha balleessatee hassaate. Duuchchi Woddike Goottika geego mayee balleessitotta'a hassatee?» hite.<verse eid="2SA 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 20:20" />Iyyo'aabinna hiyye hiissee qic, «Tinni anenaa'ni bayyatto! Balleessatinna diiga ta'anna anenaa'ni bayyato'o! <verse eid="2SA 20:20" /><verse number="21" style="v" sid="2SA 20:21" />No'ok yaadi konnetebaan. Tullichchi callike Efireemike bogi manji, Bikiirik belti Saabe'e moyanjo Daawwiti'ni foggoxxinni ke'e'een; ha'noo konne manjichcho calla ani'a uwwee malee ani ookkone qachcha waalee me'annon» isee hiyye.</para>
  <para style="p" vid="2SA 20:21">Manjichchotinna Iyyo'abi'i, «Manjichchiinka gooba kunte kinjiinke dalla'i iimi'ni atee darbinaan.» <verse eid="2SA 20:21" /><verse number="22" style="v" sid="2SA 20:22" />Ookkoneechchi uduma manjichchotinna qarummati ardiinba me'ite, insa'nenna Bikiirika belto Saabe'eeka gooba kunteexxi Iyyu'aabi'a kinjiinke dalla'i iimi'ni darbine. Tennexxe Iyyo'aabi malagata ufuufe, mannikinna qachchi giddii'ni baajeexxi ifi ifike minibaa'a me'e. Iyyo'aabinna moya'neebaa Iyyerusaalemi'a hige.<verse eid="2SA 20:22" /></para>
  <para style="s1">Daawwitika Ja'laabuwwa</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 20:23" />Iyyo'aabinna Isira'eelike loliinke manni duuchchi'a ajajaloke kade; Yoodahek belti Bennayaasi Kelitote'ninna Felitote'n sooressa kade. <verse eid="2SA 20:23" /><verse number="24" style="v" sid="2SA 20:24" />Adooniraam tola hujammake manni'a sooressa kade; Ahiluudik belit Iyyoosafiixi jirtetike borresanjomman; <verse eid="2SA 20:24" /><verse number="25" style="v" sid="2SA 20:25" />Suusa borresanjokemman; Saadooqinna Abiyatar qeesetemman; <verse eid="2SA 20:25" /><verse number="26" style="v" sid="2SA 20:26" />Iittanni Ya'iirike bogik manjichchi Iraasi Daawwitixxe qeese giddii'ni isi mittekemman.<verse eid="2SA 20:26" /></para>
  <chapter eid="2SA 20" />
  <chapter number="21" style="c" sid="2SA 21" />
  <para style="s1">Gaba'oonke Mannixxa Halo Fula</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 21:1" />Daawwit moye galchammake baro'n weli duuka sase wogga duuchcha jabake solo'o hedhemman; tennexxee Daawwitinna Duuchchi Woddika Gootta laqe; Duuchchi Woddik Goottinna hiyyee qici, «Sa'oolinna mini hadi isiki manjo anga sa'eke fuggaaleessa manjon; Sa'oolinna Geba'oonka manna shiye bireen» hiyyeexxi hiisse.<verse eid="2SA 21:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 21:2" />Moyanji Geba'oonito ye'eexxi haasesse. Geba'oonto Amooritotenaa'ni fule dangeeke malee Isira'eelixxe gosammabaan; Isira'eelik manni ha'no heqqinannoni hiyye kakanteexxe kaddolenna Sa'ooli kinni Isira'eelike ardi'anna Yihudake ardi'a afeemmaxxe gaabbenaa'ni kexxeexxa insa'ne biro'a haseemman.<note caller="-" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="JOS 9:3-15">Iya. 9:3-15</ref>. </char></note> <verse eid="2SA 21:2" /><verse number="3" style="v" sid="2SA 21:3" />Daawwitinna Geba'oonito, «Maa ha'no'a asaanno? Duuchchi Woddike Goottika arda eebbissino'a ha'non geyeemmaka miiccama faaci'atee maa ha'no'a assanno?» hiyye qore.<verse eid="2SA 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 21:4" />Geba'oonto iso'ni, «Sa'oolitenna kadi mini hado birretika sibljo yookaan worqeti laqatika seera anfeebo'non iittanni Isira'eelinaa'ni mittekanna shiyate'e seera anfebo'non» hine hiissine.</para>
  <para style="p" vid="2SA 21:4">Daawwitinna, «Yooni maa ha'no'a assonaa'a hassina'ne?» hiyyeexxi insa'nee qore.<verse eid="2SA 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 21:5" />Insa'nenna «Xexxeeremmannoshshanna Isira'eelike bogi giddo hoone booncho'ninna he'nabo'noshsha no'oo birro'a haseemmake manjona'ninna fuggoxxa no'o'ni assemmake manjixxe, <verse eid="2SA 21:5" /><verse number="6" style="v" sid="2SA 21:6" />hortenaa'ni torbaane labbaxxi oose no'no'aa uwwendowwaal; no'onna Duuchchi Woddike Gootti fileeke Sa'oolike boga'ni Gibi'a giddo Duuchchi Woddik Gootti edo insa'ne'e fanninso» hine hiissine.</para>
  <para style="p" vid="2SA 21:6">Tennexxe moyanji, «Kadduun insa'nee ha'no'aa uwwannon» hiyye.<verse eid="2SA 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 21:7" />Moyanjikinna, Daawwitixxenna Sa'oolike belto Yoonataxxe oddo'ni Duuchchi Woddike Gootti edo assendeexxe kakoxxee hiyye Sa'oolka akka'o Yoonataanika belto Mefibosheetii'i reyotenaa'ni gatise.<note caller="-" style="x"><char style="xo" closed="false">21:7 </char><char style="xt" closed="false"><ref loc="1SA 20:15-17">1 Sam. 20:15-17</ref>; <ref loc="2SA 9:1-7">2 Sam. 9:1-7</ref>. </char></note> <verse eid="2SA 21:7" /><verse number="8" style="v" sid="2SA 21:8" />Yaane kinni moyanji Iyyoheelixxi belto, Ritsifa Sa'ooli'a ildeemmaxxa lame labbaxxa oose Arimooninna Mefiboshetii'i adhdhe; ittanni Sa'oolixxi belto, Meroobi Mehoolichcho Baarizilaayika belto Adiri'eeli'a ildeemmaxxee onde labbaxxa oosenna adhdhe.<note caller="-" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="1SA 18:19">1 Sam. 18:19</ref>. </char></note> <verse eid="2SA 21:8" /><verse number="9" style="v" sid="2SA 21:9" />Isinna Gaba'oonitotee insa'nee sa'isse uwwe; Gaba'oonitotinna insa'ne'e tullichchi hana Duuchchi Woddike Gootti edo fanninse. Torbaaniniig mitteba renne; insa'nenna shiyemmeek midha aaggammake agenjuwwa'n, so'inxe haamemaxxe safanitemman.<verse eid="2SA 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 21:10" />Ookkoneechchi uduma Saa'olxxe shiixxooxxe are kaddeexxi Aayaxxi belto Ritsifa yaadotixxa seemma aaxxeexxi lumoxxe rassa hana fa'wite. Midha aaggammake siretike agenjonaa'ni xeeni renshake'ni ganaa qico'ni barra ci'a hashsha biniichchuwwi tuqabaashsha heqqitaamman.<verse eid="2SA 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 21:11" />Daawwiti, Sa'oolixxi shiixoxxi are Ritsifa, assiteexxa yaane laqeexxa yanna, <verse eid="2SA 21:11" /><verse number="12" style="v" sid="2SA 21:12" />isinna mareexxi Sa'oolixxanna belto isike Yoonataanixxa miqe Gele'adi Iyyabiisike mannanaa'ni aadhe. (Iyyabusik manni ookkone renshuwwa aadheek Filisixeemito Sa'oolii'i Gilbo'a shinne ke'neexxi fanniseeke Beetishanixxe weldeenanaa'ni sho'ikitemman.)<note caller="-" style="x"><char style="xo" closed="false">21:12 </char><char style="xt" closed="false"><ref loc="1SA 31:8-13">1 Sam. 31:8-13</ref>. </char></note> <verse eid="2SA 21:12" /><verse number="13" style="v" sid="2SA 21:13" />Daawwitinna Sa'oolixxanna isika belto Yoonataanixxa miqe ookkoo'ni idage; iittanni ookkone shiyemeemmake torbaane mannixxa miqenna bukki assende. <verse eid="2SA 21:13" /><verse number="14" style="v" sid="2SA 21:14" />Ookkoneechchi uduma Sa'oolixxanna isike belto Yoonataanixxa miqe Biiniyaamike boga'n Tsela'i hiyyemaake booncho'n Sa'oolike anna Qiisike hirreessa'n moogiyyoti moyanji ajejemmaxxa duuchcha assine. Ookkoneechchi uduma Mageni ookkone bogixxe soodatendemmaxxa soodachcho duuchcha laqe.<verse eid="2SA 21:14" /></para>
  <para style="s1">Filisixxeemitote'n Ke'eeka Lola</para>
  <para style="r">(<ref loc="1CH 20:4-8">1 Odo. 20:4-8</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 21:15" />Higgeeni Filisixeemitotinna Isira'eelixxe oddo'ni loli ke'e. Daawwitinna ifike loliinke manninni welti adadde Filisixxeemito lolatee me'e; isinna gophe. <verse eid="2SA 21:15" /><verse number="16" style="v" sid="2SA 21:16" />Raafayimixxi hortek mitti Yushibiibenoobi hiyyemaak Sase kiilona gamisa geyaaka sageettotike sibljika bagedo abixxekeenna haaroka wolaantichcha ka'leeke manjomman; isinna Daawwiti'i shiyatee hede. <verse eid="2SA 21:16" /><verse number="17" style="v" sid="2SA 21:17" />Tsuriyak belti Abisa kinni Daawwiti anjirate dage; isinna Filisixeemichcho oteexxi sheye. Ookkonneechch uduma Daawwitik manni isoo, «Isira'eeliki xassi xo'abaashsha ta'inni elqi'a ati no'onni welti lolakee fuldabexxo'n» hina'n kakante.<note caller="-" style="x"><char style="xo" closed="false">21:17 </char><char style="xt" closed="false"><ref loc="1KI 11:36">1 Moy. 11:36</ref>; <ref loc="PSA 132:17">Far. 132:17</ref>. </char></note><verse eid="2SA 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 21:18" />Ookkoneechchi uduma Goobi hiyyemaake booncho'ni Filisixeemitoti welti weli loli kade. Eettene yanna'ni Kuusitichchi Sibekayi, Raafayimixxe horteka Saafi hiyyemaaka manjichcho shiye.<verse eid="2SA 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 21:19" />Goobi hiyyemaaba Filisixeemitoti welti kadeeke wele lola'ni, Beeteliheemi ilmee, isike bagedik<note caller="+" style="f"><char style="fr" closed="false">21:19 </char><char style="ft" closed="false">Ibiritotixxinna torbaane tomme beekkolexxi tika tenneenni weli aaggaan; yaane kinni 1Odo 20:5 hexxeexxi tennennaa'n gargar higgeexxen. </char></note> somelchik furdinni seemma ganatixxe ogeke mirqisanjishsha hedheek Ye'are'aarigimik<note caller="+" style="f"><char style="fr" closed="false">21:19 </char><char style="ft" closed="false">yookaan ookkone seemma ganamake Yi'eerik belti</char></note> belti Elihanan Gaatike bogika manjo Goliyaadii'i shiye.<verse eid="2SA 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 21:20" />Higgeenni Gaatii'ni ke'eeke lola'ni, lamiinxe lekka'ninna lamiinxe anga'ni jaane jaane qubba duuchchiinxi mitteba lame tommenna shoole qubba afeemmak mitti qeerrak manjichchi hedhemman. Isinna Raafayimixxe horteke manjomman. <verse eid="2SA 21:20" /><verse number="21" style="v" sid="2SA 21:21" />Kunni manjichchinna Isira'eeli'i gacifatee wodda, Daawwitika dayyo Saamak belti Yoonataan isoo shiye.<verse eid="2SA 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 21:22" />Kunni shoolniig Gaati'ni he'nemmake Raafayimixxe horteke mannamman; insa'nenna Daawwitixxe'ninna isike erganjuwwixxe anga'ni inbe.<verse eid="2SA 21:22" /></para>
  <chapter eid="2SA 21" />
  <chapter number="22" style="c" sid="2SA 22" />
  <para style="s1">Galatiinxa Daawwitixxa Faaro</para>
  <para style="r">(<ref loc="PSA 18">Far. 18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 22:1" />Duuchchi Woddik Gootti isike naapha duuchchanaa'ninna Sa'oolixxe anganaa'ni isoo anjiree wodda, Daawwiti konneechchinni butti'a hexxeexxa faaro Duuchchi Woddike Gootti'a faarse. <verse eid="2SA 22:1" /><verse number="2" style="v" sid="2SA 22:2" />Isinna hiyya'ni faarsee qici:</para>
  <para style="q1" vid="2SA 22:2">«Duuchchi Woddik Gootti jabaxxe anxe rassan, jabaxxe anke kollonna anke wodallon;<verse eid="2SA 22:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="2SA 22:3" />Anki Mageni irkatannoxxe anxe rassan,</para>
  <para style="q2" vid="2SA 22:3">anxe wontenna anxe anjiremaxxe hunnan.</para>
  <para style="q2" vid="2SA 22:3">Isinna jabaxxe anxe kollon,</para>
  <para style="q2" vid="2SA 22:3">irko anxenna anke anjirallon,</para>
  <para style="q2" vid="2SA 22:3">atinna hunnaameyye mannanaa'ni anee anjirtatton.<verse eid="2SA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="2SA 22:4" />Ani Ggalata hasisaaka Duuchchi Woddika Gootta ye'edhanno,</para>
  <para style="q2" vid="2SA 22:4">naapha anikenaa'ninna anjirmanno.<verse eid="2SA 22:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="2SA 22:5" />«Reyo abbayyatike danbala'ishsha anee buqqe;</para>
  <para style="q2" vid="2SA 22:5">balleessaak lola'inna anee liqiinse.<verse eid="2SA 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 22:6" />Hirreesiinxi wodaro ane'ni mirqende;</para>
  <para style="q2" vid="2SA 22:6">shiltaaxxi fonxoro anee abide.<verse eid="2SA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 22:7" />Rakko ane'ni geltee wodda</para>
  <para style="q2" vid="2SA 22:7">Duuchchi Woddika Gootta ye'edhenne;</para>
  <para style="q2" vid="2SA 22:7">anke Mageniba'anna raarenne.</para>
  <para style="q2" vid="2SA 22:7">Isinna galma ifik giddo hedheexxi hafuura anka laqe;</para>
  <para style="q2" vid="2SA 22:7">raare anixxinna mansha isixxe'n cophphi hite.<verse eid="2SA 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="2SA 22:8" />«Mageni mufate'emmaxxee booso buttiniinxi daaqqe,</para>
  <para style="q2" vid="2SA 22:8">iimatixxi boosuwwanna girgiri hite;</para>
  <para style="q2" vid="2SA 22:8">lele'mite.<verse eid="2SA 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="2SA 22:9" />Sano isixxenaa'ni wiliille tuqutuqu hite;</para>
  <para style="q2" vid="2SA 22:9">afo'o isikenaa'n ittaaxxi giira bubbe,</para>
  <para style="q2" vid="2SA 22:9">holati kashilinna afo'o isikenaa'n faqafaqa hiyye.<verse eid="2SA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="2SA 22:10" />Isinni Iimuwwa benqasse'e butti'a dirre;</para>
  <para style="q2" vid="2SA 22:10">lekka isixxi hunda xilledhe raacho'eeke duumancha hedhemman.<verse eid="2SA 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="2SA 22:11" />Isinna kirubeele gulufe pirri hiyye;</para>
  <para style="q2" vid="2SA 22:11">diidalotike keelinninna shiwwi hiyye.<verse eid="2SA 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2SA 22:12" />Dukkanaa oddowwe;</para>
  <para style="q2" vid="2SA 22:12">raachcho'eeki, xeeni callik duumanchi isoo buqe.<verse eid="2SA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2SA 22:13" />Isi edo wa'aa hiyyeeke ifinanaa'ni kexxeexxa</para>
  <para style="q2" vid="2SA 22:13">kashili faqafaqa hiyye.<verse eid="2SA 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="2SA 22:14" />Duuchchi Woddik Gootti iimi'ni dindime;</para>
  <para style="q2" vid="2SA 22:14">Lumok Mageni hafuura ifikanna laqise.<verse eid="2SA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="2SA 22:15" />Isinna mogido ifika darbeexxi,</para>
  <para style="q2" vid="2SA 22:15">naaphuwwa ifikanna xexeere;</para>
  <para style="q2" vid="2SA 22:15">banqotike balaqinninna insa'ne'e shorre.<verse eid="2SA 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="2SA 22:16" />Duuchchi Woddike Goottike xixichchonaa'ni,</para>
  <para style="q2" vid="2SA 22:16">sano isixxenaa'ni tuqutu hiyyaake hafuurinaa'ni kexxeexxa, lumoxxi abbayya buqqe'emmak buttinni leelle;</para>
  <para style="q2" vid="2SA 22:16">buttatixxi boosonna ce'e hitte gatte.<verse eid="2SA 22:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="2SA 22:17" />«Duuchchi Woddik Gootti iimi'n anga qeerrise anee abide;</para>
  <para style="q2" vid="2SA 22:17">dhi'mo wode'iinaa'ninna anee harkise fulche.<verse eid="2SA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2SA 22:18" />Ane'n ke'emmake jabake naaphuwwinaa'n, anee gibammake mannixxe</para>
  <para style="q2" vid="2SA 22:18">anganaa'n anee gatise.<verse eid="2SA 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 22:19" />Rakkote'n hedhee'naa ane'n ke'ne lolle;</para>
  <para style="q2" vid="2SA 22:19">Duuchchi Woddik Gootti kinni anke kipha kade.<verse eid="2SA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="2SA 22:20" />Isinna ba'laba anee fulche;</para>
  <para style="q2" vid="2SA 22:20">ane'ni gammademmaxxee anee anjire.<verse eid="2SA 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="2SA 22:21" />Duuchchi Woddik Gootti anxe qullummashshanni ani'a hira uwwa;</para>
  <para style="q2" vid="2SA 22:21">elloxxa assenneshshanni ani'a eloxxa assa.<verse eid="2SA 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 22:22" />Ani Duuchchi Woddike Goottika ora heqqedheennen;</para>
  <para style="q2" vid="2SA 22:22">anke Magenonaa'ni udumi'a higee fuggoxxa assebe'non.<verse eid="2SA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="2SA 22:23" />Mageniinka seera duuchcha muuxe'ennen;</para>
  <para style="q2" vid="2SA 22:23">ajaja isikanna gibebe'non.<verse eid="2SA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="2SA 22:24" />An balleessa afebe'noxxa isi ege'ne'een;</para>
  <para style="q2" vid="2SA 22:24">cubbo hujabe'noshshanna if heqqedhe'eennan.<verse eid="2SA 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="2SA 22:25" />Duuchchi Woddik Gootti qulluma anxishshanni,</para>
  <para style="q2" vid="2SA 22:25">eloxxa assenneshanni hira ani'a uwween.<verse eid="2SA 22:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="2SA 22:26" />«Ati'a addatemeekee, atinna isi'a addatendeeteke,</para>
  <para style="q2" vid="2SA 22:26">qajeeli manji'anna qajeelumma atixxa iso'n leellishshatto.<verse eid="2SA 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="2SA 22:27" />Ca'ichchakee atinna ca'umma atixxa iso'n leellishshatto,</para>
  <para style="q2" vid="2SA 22:27">fuggaalessakee kinni fuggo isixxishshanni hira isi'a uutatto.<verse eid="2SA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="2SA 22:28" />Shaqqaka manna anjirtatto,</para>
  <para style="q2" vid="2SA 22:28">hollameeyye kinni salphissatto.<verse eid="2SA 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="2SA 22:29" />Ee, Duuchchi Woddike Goottaa ati anke ifan;</para>
  <para style="q2" vid="2SA 22:29">dukkana anxa ati ifisatto.<verse eid="2SA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="2SA 22:30" />Atike gargaarsinni lolinka sannachcha injifatanno;</para>
  <para style="q2" vid="2SA 22:30">anke Magenixxe hunnanni dalla'a utaale sa'anno.<verse eid="2SA 22:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="2SA 22:31" />«Mageniink ori dedha afeekebaan;</para>
  <para style="q2" vid="2SA 22:31">Duuchchi Woddike Goottik hiyyichchi dhugaaten;</para>
  <para style="q2" vid="2SA 22:31">isoo irko assedheeke duuchchi'a isi wonteten.<verse eid="2SA 22:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="2SA 22:32" />Duuchchi Woddika Gootta malee'e ayyete Mageni?</para>
  <para style="q2" vid="2SA 22:32">No'oka Mageno malee rassa ayyete?<verse eid="2SA 22:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="2SA 22:33" />Hunna ani'a uwweexxi</para>
  <para style="q2" vid="2SA 22:33">ora ankanna qajeelchaak</para>
  <para style="q2" vid="2SA 22:33">Magenoken.<verse eid="2SA 22:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="2SA 22:34" />Isii lekka anxa gophphabaaxxe buddannetixxe lekkashsha assaan;</para>
  <para style="q2" vid="2SA 22:34">qephphpichcha bonchuwwa'n uurrannoshsha assaan.<note caller="-" style="x"><char style="xo" closed="false">22:34 </char><char style="xt" closed="false"><ref loc="HEB 3:19">Ibr. 3:19</ref>. </char></note><verse eid="2SA 22:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="2SA 22:35" />Hitta lolannoxxa isi anee barachchiisa;</para>
  <para style="q2" vid="2SA 22:35">maalde'inxa gabenna darbannoka uuduuda ani'a uwwaan.<verse eid="2SA 22:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="2SA 22:36" />Anjirtaaxxa atixxa wonte ani'a uutette;</para>
  <para style="q2" vid="2SA 22:36">anee kiphphee lummissette.<verse eid="2SA 22:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="2SA 22:37" />Ati ora ani'a giissitette;</para>
  <para style="q2" vid="2SA 22:37">lekka anxinna xaldebaan.<verse eid="2SA 22:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="2SA 22:38" />«Naapha anka gussee abidannon;</para>
  <para style="q2" vid="2SA 22:38">insa'nee balleessebo'noki uudumi'a higabo'non.<verse eid="2SA 22:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="2SA 22:39" />Dandammantabaa qico'n insa'ne'e ganannon;</para>
  <para style="q1" vid="2SA 22:39">Langaxxa munnuqqi hinabaa;</para>
  <para style="q2" vid="2SA 22:39">renshii insa'nekinna lekka anxi hunda ibaan.<verse eid="2SA 22:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="2SA 22:40" />Lolakee hunna ani'a uutette;</para>
  <para style="q2" vid="2SA 22:40">naapha ankanna injifatannoshsha assitette.<verse eid="2SA 22:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="2SA 22:41" />Naaphi anki udumi'a higee baajaashsha assitette,</para>
  <para style="q2" vid="2SA 22:41">anee jibbammakaaranna kutti assenne.<verse eid="2SA 22:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="2SA 22:42" />Insa'nenna gargaarsake'e raarre, anjireki hedhebaan.</para>
  <para style="q2" vid="2SA 22:42">Duuchchi Woddike Goottibaa raarre; isi kinni sammi hiyye.<verse eid="2SA 22:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="2SA 22:43" />Diiddallo adhdhite me'itammaxxe bukkoshsha insa'nee bulleessenne;</para>
  <para style="q2" vid="2SA 22:43">ori giddixxe dhoqqeshshanna insa'nee hirbeessenne.<verse eid="2SA 22:43" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="44" style="v" sid="2SA 22:44" />«Jallichchi ardinaa'n anee anjirtette.</para>
  <para style="q1" vid="2SA 22:44">Gosa gosake ardike umo assitee anee hariirtette;</para>
  <para style="q2" vid="2SA 22:44">ege'nebo'nok ardinna ani hunda galeen.<verse eid="2SA 22:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="2SA 22:45" />Alagi bogik manni ani'a heeshshi qokki hiyya;</para>
  <para style="q2" vid="2SA 22:45">gurra anka lanqeeshshanni ani'a ajajemaan.<verse eid="2SA 22:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="2SA 22:46" />Alanee culphinsa;</para>
  <para style="q2" vid="2SA 22:46">rooqonsina'n koollifanteebaa'n fulee anibaa dangaan.<verse eid="2SA 22:46" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="47" style="v" sid="2SA 22:47" />«Duuchchi Woddik Gootti hedheeken!</para>
  <para style="q2" vid="2SA 22:47">Golli anki isii ulfaatowwaal!</para>
  <para style="q2" vid="2SA 22:47">Anjirall ank, rassa anxi Magenii lummedhowwaal.<verse eid="2SA 22:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="2SA 22:48" />Isi naapha anke'n ani'a halo fulaan;</para>
  <para style="q2" vid="2SA 22:48">gosa gosak ardi ani hunda galaashsha assaan.<verse eid="2SA 22:48" /></para>
  <para style="q2">
    <verse number="49" style="v" sid="2SA 22:49" />Naapha ankenaa'n anee anjirtatto;</para>
  <para style="q2" vid="2SA 22:49">naaphi anki hana anee lummissatton;</para>
  <para style="q2" vid="2SA 22:49">manna midhaakerinaa'n anee gatissatton.<verse eid="2SA 22:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="2SA 22:50" />Ee Duuchchi Woddike Goottaa tennexxe gosa gosake ardi giddo atee galatefatannon;</para>
  <para style="q2" vid="2SA 22:50">summa atikanna faarsannon.<note caller="-" style="x"><char style="xo" closed="false">22:50 </char><char style="xt" closed="false"><ref loc="ROM 15:9">Rom. 15:9</ref>. </char></note><verse eid="2SA 22:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="2SA 22:51" />Moosisemmaka moyanjo isi injifatashsha assa;</para>
  <para style="q2" vid="2SA 22:51">fi'leeke moyanjo, Daawwitiinna, horte isixxa duuchchi woddi'a eeyyaa.»<verse eid="2SA 22:51" /></para>
  <chapter eid="2SA 22" />
  <chapter number="23" style="c" sid="2SA 23" />
  <para style="s1">Daawwiti Udumixxe Yanna'ni Haaso'eeka Hiyyichcho</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 23:1" />Daawwiti udunse haaso'eek hiyyichchi:</para>
  <para style="q1" vid="2SA 23:1">«Ya'iqoobike Mageno'ni hariiremeeki,</para>
  <para style="q2" vid="2SA 23:1">Lumok Mageni lummiseek manji,</para>
  <para style="q1" vid="2SA 23:1">Isira'eeliki eeyyemalli faarisanji,</para>
  <para style="q2" vid="2SA 23:1">Isseyike beltik Daawwitiki wabeekummatik hiyyichchi konneechchinni butti'a hedheeken.<verse eid="2SA 23:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="2SA 23:2" />«Duuchchi Woddike Goottik hafuuri ane'ni haaso'e;</para>
  <para style="q2" vid="2SA 23:2">hiyyichchi isiki anke afo'o'ni hedhemman.<verse eid="2SA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="2SA 23:3" />Isira'eelik Mageni haaso'e,</para>
  <para style="q2" vid="2SA 23:3">Isira'eelixxi rassanna anee hitee qici:</para>
  <para style="q1" vid="2SA 23:3">‹Manna qullummati galchaak,</para>
  <para style="q2" vid="2SA 23:3">Mageno sodaatiyyoti galchaak,<verse eid="2SA 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="2SA 23:4" />Isi duumanchi hedhebaaba, gorsa arishsho</para>
  <para style="q2" vid="2SA 23:4">fuldamma wodda,</para>
  <para style="q2" vid="2SA 23:4">hedheeke ifishshaten,</para>
  <para style="q2" vid="2SA 23:4">buttatte'n arso lachchiisammake,</para>
  <para style="q2" vid="2SA 23:4">xeeni ganeechchi uduma wa'a hiyye hedhaammake ifishshaten.›<verse eid="2SA 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="2SA 23:5" />«Anki mini Magenokee qajeelakebaa?</para>
  <para style="q2" vid="2SA 23:5">Duuchchiinxa yaane qophphesseexxi heqqe'e,</para>
  <para style="q2" vid="2SA 23:5">aninni welti duuchchi woddixxa kako aagekebaa?</para>
  <para style="q1" vid="2SA 23:5">Anjirema anxa muuxamakee geessissaak,</para>
  <para style="q2" vid="2SA 23:5">harsenechcho duuchcha ani uwwaak isotebaa?<verse eid="2SA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 23:6" />Yaane kinni fuggaaleyye manni duuchchi,</para>
  <para style="q2" vid="2SA 23:6">angati bukki assendammabaaxxe uteshsha hunemmaan.<verse eid="2SA 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 23:7" />Ute tuqaaki duuchchi</para>
  <para style="q2" vid="2SA 23:7">sibljiinka miya yookaan bagediinka somelcho abixxa;</para>
  <para style="q2" vid="2SA 23:7">utetinna hexxemmaxxe bakka'ni giirati gubante mundaan.»<verse eid="2SA 23:7" /></para>
  <para style="s1">Lolakee ege'nemeeka Daawwitika Manna</para>
  <para style="r">(<ref loc="1CH 11:10-41">1 Odo. 11:10-41</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 23:8" />Daawwitike gooti mannik summi konneechinni butti'a hedheen.</para>
  <para style="p" vid="2SA 23:8">Tahikimoonike<note caller="+" style="f"><char style="fr" closed="false">23:8 </char><char style="ft" closed="false">Tahikimoonike manjo </char><char style="ft" closed="false">hiyya Hakimooncho hiyyate kada dandeetaan. (1Odo. 11:11 uudi). </char></note> manji Yoosebi Besetibeti<note caller="+" style="f"><char style="fr" closed="false">23:8 </char><char style="ft" closed="false">Ibritotixxi tika tenneenni weli aaggaan; mitte mitte torbaane tomme beeklolexxi tika kinni, </char><char style="fqa" closed="false">Iyyasuusite</char><char style="ft" closed="false">hitaan; kunninna Yashoobi'amiten </char><char style="ft" closed="false">(1Odo. 11:11 uudi). </char></note> hiyyemaak manjichi ookkone sase gootuwwike akeekisanjo kadaa wodda, isinna bagedo aadheexxi mitte adhe'ni saddeeta dhibba loliinka manna sheyeeken.<verse eid="2SA 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 23:9" />Iso'ni aaneeki Ahoohichcho Doodik belti Ali'aazaaritemman; isinna lolakee mitteba bukki hiteemmaxxa Filisixeemito lollee wodda Daawwitinni welti hedheemmake sase goota manni giddii'ni mitti Eleezertemman. Ookkoneechchi uduma Isira'eelik manni baaje. <verse eid="2SA 23:9" /><verse number="10" style="v" sid="2SA 23:10" />Isi kinni uurrammaxxa bakka wocci aassemmabaan; anga isixxi gophphe wolaantichchik welti goggaa qico'ni Filisixeemito lole. Eettene barra'ni Duuchchi Woddik Gootti injifachcho lumoxxa isi'a uwwe. Baajemmak sannachchuwwi Eeli'ezariba higeek shiyemeeka manna boojino'a callamman.<verse eid="2SA 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 23:11" />Ookkone sase loliinke hunnaamesa manninaa'ni sakkaki Haraarik bogike gurra fuleeke Ageke belto Saamatemman. Mitte barra Filisixxeemitonna Leehite hinaaba missiri calli wo'meeke fichcha'ni mitteba bukki hine he'nee'naa; Isira'eelik loliink manni Filisixeemi edii'ni baaje. <verse eid="2SA 23:11" /><verse number="12" style="v" sid="2SA 23:12" />Saama kinni ookkone fichchi giddii'ni elqenna kayya higebaan. Isinna lole injifateexxi Filisixeemito shiye; eettene barra'ninna Duuchchi Woddik Gootti injifachcho lumoxxa isi'a uwwe. <verse eid="2SA 23:12" /><verse number="13" style="v" sid="2SA 23:13" />Mayetixxe yanna'ni Filisixeemik loliink manni Raafayimixxe dhooqa'ni gume hedhe'naa, sase tomme akeekisanjuwwa'naa'ni sasi Daawwiti hedhemmabaa Adulaamixxe wolo'obaa'a dange. <verse eid="2SA 23:13" /><verse number="14" style="v" sid="2SA 23:14" />Eettene yanna'ni Daawwiti kollo giddo hedheman; Filisixeemik loliink manninna Beetelihemi'i hedhemman. <verse eid="2SA 23:14" /><verse number="15" style="v" sid="2SA 23:15" />Daawwitinna wode'e halchati, «Beetelihemi'a e'yinammaxxe hula bira hedheek baleessiinke wode'enaa'n ikkille iyyedagaaka manjo alfennele!» hiyye. <verse eid="2SA 23:15" /><verse number="16" style="v" sid="2SA 23:16" />Tennexxe sasiniig gooti Filisixeemitotik loliinke mannixxe oddonaa'ni tansaase sa'eexxi, Beetelihemi'a e'yinammaxxe hula bira hedheeke baleessiinke wode'enaa'n iikkileexxi Daawwiti'a aa'ne dange. Yaane kinni isi ookkone wode'e ha'wammaxxe bakka Duuchchi Woddike Gootti edo dune.<verse eid="2SA 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 23:17" />«Isinna, koo Duuchchi Woddike Gootta iitta hexxeexxa yaane assa anenaa'n bayyis! Tinni rewotee mudhe me'emmake mannixxa munde ha'wineshshatebaa?» hiyye. Daawwitinna konne wode'e ha'wa hasebaan.</para>
  <para style="p" vid="2SA 23:17">Tinni sasi gooti manni jannunteti assemmaxxe yaanuwwamman.<verse eid="2SA 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 23:18" />Tsuriyak belti Iyyo'aabik dayyi Abisa sase gootuwwike akeekisanjomman. Isinna bagedo aadheexxi sase dhibba manna shiyeken; tennexxee isi ookkone sase gootuwwishshanni gurra fuleeke manjomman. <verse eid="2SA 23:18" /><verse number="19" style="v" sid="2SA 23:19" />Abisanna sase goota manni irra yo'oshsha ulfateekemmabaata? Isinna insa'nenaa'n mitteke kada gophoolenna sooresa insa'nekemman.<verse eid="2SA 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 23:20" />Qebsi'eelike bogike manjo kadeek Yoodahek belti Bennayaasi gura fuleeke wele goota manjomman. Isinna lame yo'oshsha ege'nemeeka Mo'aabito shiye; kaade ibbeexxa barranna bale giddo e'yeexxi neenqakanna shiye. <verse eid="2SA 23:20" /><verse number="21" style="v" sid="2SA 23:21" />Higgeenni lebeexxi mitte qeerraka Gibtsichcho shiyedhen. Gibtsichchikinna anga ifixxe'n bagedo abixoolenna, Bennayaasi kinni isinni lolmo'a siqqo abixxe isibaa'a mare. Isinna Gibtsichchokenaa'n bagedo bute aadheexxi isinge bagedinninni isoo sheye. <verse eid="2SA 23:21" /><verse number="22" style="v" sid="2SA 23:22" />Yoodahek belto Bennayaasixxi jannunte tenne labbaaxxemman; isinna sasiing gooti mannishsha gurra fuleeke kadoolenna <verse eid="2SA 23:22" /><verse number="23" style="v" sid="2SA 23:23" />sase tomme gootuwwi irra ulfaate manjomman; yaane kinni ookkone sase gootuwwinaa'n isi mittekemaba'a. Daawwitinna Bennayaasii'i ifika loliinka miya ba'edhaake assee hariire. <verse eid="2SA 23:23" /><verse number="24" style="v" sid="2SA 23:24" />Sase tomme manni giddii'ni wele mannilk summi konneechinni butti'a hedheeken, Iyyo'aabik dayyi Asaheeli, Beetelihemi ilemeek Doodik belti Elihanan, <verse eid="2SA 23:24" /><verse number="25" style="v" sid="2SA 23:25" />Haaroodichchi Saama, Aroodichchi Eliiqa, <verse eid="2SA 23:25" /><verse number="26" style="v" sid="2SA 23:26" />Feliixxichchi Selesi, Teequhe illemeek Isikaki belti Iraasi, <verse eid="2SA 23:26" /><verse number="27" style="v" sid="2SA 23:27" />Anatootichchi Abi'eezeri, Kuusitichchi Mibunaayi, <verse eid="2SA 23:27" /><verse number="28" style="v" sid="2SA 23:28" />Ahoohichcho Tsalmoon, Nexoofichchi Mahiraayi, <verse eid="2SA 23:28" /><verse number="29" style="v" sid="2SA 23:29" />Nexoofichchi Be'aanak belti Heleebi, Biiniyaamixxe hortenaa'n Gibi'ake bogik manjo kadeek Ribaayik belti Itaayi, <verse eid="2SA 23:29" /><verse number="30" style="v" sid="2SA 23:30" />Piri'atoonichchi Bennayaasi, Ga'ashixxe dhooqak manji Hidayi, <verse eid="2SA 23:30" /><verse number="31" style="v" sid="2SA 23:31" />Araabichchi Abi'aliboon, Barihuumichchi Azimoot, <verse eid="2SA 23:31" /><verse number="32" style="v" sid="2SA 23:32" />She'aalboonichchi Eliyaahiba, Aasaanixxi oose, Yoonataan hiyyemeek, <verse eid="2SA 23:32" /><verse number="33" style="v" sid="2SA 23:33" />Haraadichcho Saamak belti<note caller="+" style="f"><char style="fr" closed="false">23:33 </char><char style="ft" closed="false">mitte mitte torbaane tomme beekkolexxi tikuwwa (iittanni 1Odo 11:34 uudi) tenneenni welti weli aaggaan; Ibritotixxi tika kinni </char><char style="fqa" closed="false">belto hiyyaaka affebaan.</char></note> Aroodichcho Sharaarik<note caller="+" style="f"><char style="fr" closed="false">23:33 </char><char style="ft" closed="false">Ibritotixxi tennenni wel aaggaan; mitte mitte torbaane tomme beekkolexxi tikuwwa (iittanni 1Odo 11:35 uudi) kinni </char><char style="fqa" closed="false">Saakoor </char><char style="ft" closed="false">hitaan. </char></note> belti Ahi'aami, <verse eid="2SA 23:33" /><verse number="34" style="v" sid="2SA 23:34" />Ma'ikichcho Ahaasebayik belti Elefaalati, Giilonaachchi Akixofeelik belt Eli'aam, <verse eid="2SA 23:34" /><verse number="35" style="v" sid="2SA 23:35" />Qermeeloosichchi Hetsiro, Arabaachchi Fe'arayi, <verse eid="2SA 23:35" /><verse number="36" style="v" sid="2SA 23:36" />Tsobake bogik manji Naataanik belti Igaal, Gaadik bogik manji Baani, <verse eid="2SA 23:36" /><verse number="37" style="v" sid="2SA 23:37" />Amoonichchi Tsaaleqi, Tsuriyak belti Iyyo'aabika loliinka miya dukaammak Be'eerotichchi Nahirayi, <verse eid="2SA 23:37" /><verse number="38" style="v" sid="2SA 23:38" />Yiitirichchi Iraasi, Yiitirichchi Geerebi, <verse eid="2SA 23:38" /><verse number="39" style="v" sid="2SA 23:39" />iittanni Hiitichchi Ooriyo, insa'ne duuchchingi sase tommenna torbaankemman.<verse eid="2SA 23:39" /></para>
  <chapter eid="2SA 23" />
  <chapter number="24" style="c" sid="2SA 24" />
  <para style="s1">Daawwit Ifika Loliinka Manna Laakko'e</para>
  <para style="r">(<ref loc="1CH 21:1-27">1 Odo. 21:1-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 24:1" />Higgeenni Duuchchi Woddik Gootti Isira'eeli'ni yo'oshsha mufatemmaxxee Daawwiti darree'ni rakko ins'ne'ni geltaashsha asse: tennexxee Duuchchi Woddik Gootti Daawwiti'i, «Martettexxi Isira'eelikanna Yihudaka arda laakko'i» hiyye. <verse eid="2SA 24:1" /><verse number="2" style="v" sid="2SA 24:2" />Tennexxe moyanji Iyyo'aabinna isinni welti hedhemmaka loliinke mannika ajajalluwwa, «Daanii'ni Bersaabehi qico'ni hedheeke Isira'eelixxe gosa duuchchabaa marte. Laakkosi insa'nek me'eke kadeexxa ege'na dande'annoshsha loliinka manna borreessi» hiyye.<verse eid="2SA 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 24:3" />Iyyo'aabi kinn moyanjo, «Duuchchi Woddik Gootti atki Mageni sannachcha konne dhibba anga bira sa'isseexxi, ate anka gootta moyanjiinxi illenna tenne uddaake asso'o; yaane kinni ati ank gootti moyanji tennee assatee mayeete hasseteke?» hiyye hiisse. <verse eid="2SA 24:3" /><verse number="4" style="v" sid="2SA 24:4" />Kaddoolenna moyanjinki hiyyichchi Iyyo'aabinna loliinke mannika ajajjallo injifateemmaxxee Isira'eelika loliinka manna laakko'atee isi birii'n ke'ne me'ine.<verse eid="2SA 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 24:5" />Insa'nenna Yordaanoosi foonfeechchi uduma dhooqa giddo hedheeke qachchibaa'ni bita'i darre'ni hedheeke Aro'eerike qachchi bira kaanbe oltine, ookko'ninna Gaadi darree'n sa'neexxi Iyyazeeri'a me'ine. <verse eid="2SA 24:5" /><verse number="6" style="v" sid="2SA 24:6" />Ittanni Gele'adibaanna Tebaasoni Adaseyiba'a, iittanni Daaniba'a, ookko'ni dowwe wirrineexxi Sidoonabaa me'ine. <verse eid="2SA 24:6" /><verse number="7" style="v" sid="2SA 24:7" />Ookkoneechchi uduma Xiroosixxe kollobaa, Hiititotikenna Kenaanitotike qachchuwwi duuchchibaa, muuxamake'n Yihudake bita'a'n hexxeexxe Bersaabehiba'a me'ine. <verse eid="2SA 24:7" /><verse number="8" style="v" sid="2SA 24:8" />Insa'nenna bogi giddo duuchchinba mammaremmeexxi sallane agenjonna lame tomme barra uduma Iyyerusaalemi'a illeema hinge dange. <verse eid="2SA 24:8" /><verse number="9" style="v" sid="2SA 24:9" />Iyyo'aaninna loliinke manni duuchchingike laakkossa moyanjokee ege'nishe: Isira'eeli giddo saddeetta dhibbi kumi, Yihuda giddo onde dhibbi kumi wolaantichcha abixxe lalo'a dande'aak manni afeme.<verse eid="2SA 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 24:10" />Daawwitinna loliinka manna laakko'eechchi uduma ballesseexxa qalbete'n iso'n laqendemaxxee, «Ani tenne assiyyoti lumoxxa cubbo hujeennen. Assennexxi hara gowwi manjixxe hujen, koo Duuchchi Woddike Goottaa, ane erganjo atikixxa balleessa gattowwaal hitotta'a atee kadhataannen» hiyye.<verse eid="2SA 24:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 24:11" />Gorsa Daawwiti diiphi'n ke'ebaang Duuchchi Woddike Goottik hiyyichchi Daawitike waleella uudammake Gaadi'n dageexxi, <verse eid="2SA 24:11" /><verse number="12" style="v" sid="2SA 24:12" />«Martettexxi Daawwiti'n, ‹Duuchchi Woddik Gootti hiyya'neen hitatto qici sase yaanenaa'n fi'litotta'a ati'a shiqisheennen. Tenne sasenaa'n fi'litettexxa ate'n assonaa mitte fi'li hiyya'neen hiyyi› » <verse eid="2SA 24:12" /><verse number="13" style="v" sid="2SA 24:13" />Tennexxee Gaadi Daawwitibaa mareexi, «Boga atike'ni sase wogga'a solo'i kadaaxxa woyyamoo? Yookaan Naaphi atiki atee shorraa'na sase agenjo baajattoxxa? Yookaan kinni sase barraxxi bala boga atike'ni kaddaaxxa? Ta'a anee ergeeke'n maa hiyye hissichcho uwwannoxxa heddettexxi muri» hiyye.<verse eid="2SA 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 24:14" />Daawwitinna Gaadi'i, «Ani yo'oshsha wixxirri hiyyeenen. Isixxi mararte lumoxxe kaddeemmaxxee manjiinxe anga'ni ibennexxi mannii'ni Duuchchi Woddike Goottixxe anga'ni inbennexxa woyyan» hiyye. <verse eid="2SA 24:14" /><verse number="15" style="v" sid="2SA 24:15" />Tennexxee Duuchchi Woddik Gootti eettene gorsanaa'n murendeexxe barraa qico'n Isira'eeli'n bala ibise, tenne balanni Daanii'ni Bersaabehi qico'n torbaatami kumi manni reye. <verse eid="2SA 24:15" /><verse number="16" style="v" sid="2SA 24:16" />Duuchchi Woddike Goottik iimik erganji Iyyerusaalemi balleesate'e anga qophphi assee wodda, gelteexxi miidhensha Duuchchi Woddika Gootta yaadissemmaxxee ardake'n bala ibisaammaka ookkone iimika erganjo, «Gelte'een waal!» hiyye. Eettene yanna'ni Duuchchi Woddike Goottik iimik erganji Iyyaabusichcho Oorenna aldume bira uurremaan. <verse eid="2SA 24:16" /><verse number="17" style="v" sid="2SA 24:17" />Daawwitinna ardake'ni bala ibisammaka iimika erganjo uudee wodda Duuchchi Woddika Gootta'n, «Yoona cubbo hujennekinna dedheennek anedden. Yaane kinni kunni gedhebiinsha allallaannek manni maa asse? Tinni bala ane'ninna mini hado anke'ni kaddowwaal» hiyye.<verse eid="2SA 24:17" /></para>
  <para style="s1">Daawwiti Tolchi malcho Giisse</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 24:18" />Eettene barra'ninni Gaadi Daawwitiba mareexxi, «Iyyaabusichcho Oorenna aldu'meba ale martettexxi Duuchchi Woddike Gootti'a tolchimalcho giissi» hiyye. <verse eid="2SA 24:18" /><verse number="19" style="v" sid="2SA 24:19" />Tennexxee Daawwiti Duuchchi Woddik Gootti Gaadi darre'n ajajemmashshanni ale mare. <verse eid="2SA 24:19" /><verse number="20" style="v" sid="2SA 24:20" />Oorinanna adadde uudaa wodda moyanjikinna manni isiki isibaa'a dagaa'naa afe fuleexxi butta dabba'le moyanjo ulfeesatee anga ke'isse. <verse eid="2SA 24:20" /><verse number="21" style="v" sid="2SA 24:21" />Oorinanna, «Ank gootti moyanji anee erganjo atikiba mayee daggette?» hiyye.</para>
  <para style="p" vid="2SA 24:21">Daawwitinna hiisseexxi, «Bala ardakenaa'ni kexxaashsha Duuchchi Woddik Gootti'a tolchimalcho giisonnaa aldumme atixxa hironna'aten» hiyye.<verse eid="2SA 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 24:22" />Oorinanna Daawwiti'i hiyyee qici, «Anki gootti moyanji eetetteechcho aadhitetexxi tolcha shiqishi. Ciincatike tolchi'a jiboota hexxeen, giiratixxe haqqe'a midha uxxinammaxxi hiilonna qotiyyotik qanbari hedheen. <verse eid="2SA 24:22" /><verse number="23" style="v" sid="2SA 24:23" />Koo moyanjo konneechcho duuchcha ati'a uwwenne» iitanni Oorinanna isoo, «Duuchchi Woddik Gootti atik Mageni atenaa'ni adhdhaqqata» hiyye.<verse eid="2SA 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 24:24" />Yaane kinni moyanji Oorena'a, «Iita kaddabaan, konneechchika hira ani ati'a uwwa hasissaan. Aninna Duuchchi Woddike Gootta anke Mangini'a ciincatika tolcha hiri belo shiqishabe'non» hiyye.</para>
  <para style="p" vid="2SA 24:24">Tennexxe Daawwiti aldumetanna jibbotuwwa onde tomme birretike sibiljinni hire. <verse eid="2SA 24:24" /><verse number="25" style="v" sid="2SA 24:25" />Ookko'o Daawwiti Duuchchi Woddike Gootti'a tolchimalcho giisseen. Isinna ciincatika tolchanna mittoomiinka tolcha shiqishe. Ookkoneechchi uduma Duuchchi Woddik Gootti bogake'e soodantemmaxxa soodachcho laqe, Isira'eeli'n ibbeemmaxxi bala uurrite.<verse eid="2SA 24:25" /></para>
  <chapter eid="2SA 24" />
</usx>