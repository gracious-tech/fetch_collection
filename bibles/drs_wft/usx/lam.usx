<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Gedeo Bible</book>
  <para style="h">Erimiyaasixxaa Wiiga</para>
  <para style="toc1">Erimiyaasixxaa Wiiga</para>
  <para style="toc2">Erimiyaasixxaa Wiiga</para>
  <para style="toc3">Erm. Wig.</para>
  <para style="mt1">Ermiyaasixxaa Wiiga</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Erimiyaasi wiiga, Kiristoosixxe ileensha edi darre 586 wogga'n Iyyerusaalemi diigendemmaxxeenna ardi isekinna shorrememmaxxee buuttoa'a shiqqeexxa onde yaaddotixxi gence mitteba bukki assendexxen. Konne Maxaafixxi heddo kutta oodhishatixxeenna yaadotixxee haasotaaxxe kaddoolenna midde, Magenoke'n addatanna addeti hedhatixxee haasotaaxxi kutta isi giddo hexxeen. Tinn gencuwwa Ayihudooti Kirisitoosixxe ilensha edi darre 586 woga'n ookkoe boga'n gelteexxa ba'ne qaabatatee woga woga'nini agabo goddo hosatinna yaadoti magenooffachchotixxa aaduwwa assendammaxxe barruwwa giddo la'onfataan.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Siretixxa wiiga <char style="ior"><ref loc="LAM 1">1</ref> </char></para>
  <para style="io2">Iyyerusaalemixxa rakkonnna yaaddo <char style="ior"><ref loc="LAM 1:1-22">1:1-22</ref> </char></para>
  <para style="io1">Langaxxa wiiga <char style="ior"><ref loc="LAM 2">2</ref> </char></para>
  <para style="io1">Duuchchi Woddik Gootti Iyyerusaalemi'n iyyedageexxa mura woxisa <char style="ior"><ref loc="LAM 2:1-22">2:1-22</ref></char></para>
  <para style="io1">Sakaaxxa wiiga <char style="ior"><ref loc="LAM 3">3</ref></char></para>
  <para style="io1">Edi'a hexxeexxe adde <char style="ior"><ref loc="LAM 3:1-66">3:1-66</ref></char></para>
  <para style="io1">Sholgaxxa wiiga <char style="ior"><ref loc="LAM 4">4</ref> </char></para>
  <para style="io1">Iyyerusaalemixxa ba'ne <char style="ior"><ref loc="LAM 4:1-22">4:1-22</ref> </char></para>
  <para style="io1">Ondixxa wiiga <char style="ior"><ref loc="LAM 5">5</ref> </char></para>
  <para style="io1">Gattowwaali alfatixxa soodachcho <char style="ior"><ref loc="LAM 5:1-22">5:1-22</ref></char></para>
  <chapter number="1" style="c" sid="LAM 1" />
  <para style="s1">Iyyerusaalemika Abaranna Yaaddo</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1" />Mitte wodda manni wo'me hedheemmaki qachchi</para>
  <para style="q2" vid="LAM 1:1">hittata hadiyyo'e gate!</para>
  <para style="q1" vid="LAM 1:1">Gosa gosake arduwwa'n lummedhdhe hedhemmak</para>
  <para style="q2" vid="LAM 1:1">hittatta aro'i reyeexxe hiyyeete labe!</para>
  <para style="q1" vid="LAM 1:1">Awuraajuwwiinxe oddo'n mootittete kade'emmaxxi</para>
  <para style="q2" vid="LAM 1:1">ta'a garbake kadde.<verse eid="LAM 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2" />Hashsha cumumit hite ooxxaan;</para>
  <para style="q2" vid="LAM 1:2">indiddo boqo isexxeenaa'ni yaataan;</para>
  <para style="q1" vid="LAM 1:2">Iseke eeyyalluwwi duuchchi giddii'ni,</para>
  <para style="q2" vid="LAM 1:2">ise dayyeesaak mittikinna hedheba'a.</para>
  <para style="q1" vid="LAM 1:2">Jaaluwwi isek duuchchi isenaa'ni finqile;</para>
  <para style="q2" vid="LAM 1:2">naapha iseke kade.<verse eid="LAM 1:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3" />Rakkatematixxenna hirbeessematixxe bira sa'neenaa'n kexxeexxa</para>
  <para style="q2" vid="LAM 1:3">Yihudiink ardi booji'eme;</para>
  <para style="q1" vid="LAM 1:3">Gosa gosa ardi giddonna offoldeen;</para>
  <para style="q2" vid="LAM 1:3">hafuura adhdhitaabanna gophphe;</para>
  <para style="q1" vid="LAM 1:3">Wixxi hiyyati giddo hexxe'naani,</para>
  <para style="q2" vid="LAM 1:3">isee shorrammak duuchchi isee dhaqabe.<verse eid="LAM 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4" />Ege'nemeeka iseka ayyaanuwwa ulfeesatee'e</para>
  <para style="q2" vid="LAM 1:4">Ayyinna ulfeesatee'e daga gophammaxxee</para>
  <para style="q1" vid="LAM 1:4">Tsiyoonike bitumiixxe huluwwabaa e'yaakinna fulaak hedhebaan;</para>
  <para style="q2" vid="LAM 1:4">qeese isexxi duuchchinna fooxxi hitaan;</para>
  <para style="q1" vid="LAM 1:4">Dubarruwwi isek duuchchinna fuggo yaade'een;</para>
  <para style="q2" vid="LAM 1:4">isenna abara uudda.<verse eid="LAM 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5" />Diini isek umo iseke kade;</para>
  <para style="q2" vid="LAM 1:5">naapha isekeeri'anna elde</para>
  <para style="q1" vid="LAM 1:5">Isexxe cubboxxe bira sa'nenaa'n</para>
  <para style="q2" vid="LAM 1:5">kexxeexxa Duuchchi Woddik Gootti yaaddo ise'ni geltaashsha asse;</para>
  <para style="q1" vid="LAM 1:5">Oose isexxanna naaphi boji'e</para>
  <para style="q2" vid="LAM 1:5">adhdhe me'e.<verse eid="LAM 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6" />Tsiyoonixxi meyyaxxi belto,</para>
  <para style="q2" vid="LAM 1:6">gaachchanni duuchchi isenaa'ni lugge'een;</para>
  <para style="q1" vid="LAM 1:6">Hayyoole isexxi</para>
  <para style="q2" vid="LAM 1:6">bobba'aaba gopheeke gadansuwwishshaten,</para>
  <para style="q1" vid="LAM 1:6">Shorrishammakiir edo</para>
  <para style="q2" vid="LAM 1:6">hexxebaaxxe hunnanni baajje.<verse eid="LAM 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7" />Wixixxi hiteemmaxxa doonsakiyya hitemmaxxa barruwwa</para>
  <para style="q2" vid="LAM 1:7">Iyyerusaalemi olmi baro'ni affemmaxxa,</para>
  <para style="q2" vid="LAM 1:7">karra duuchcha heddaan;</para>
  <para style="q1" vid="LAM 1:7">Ardi isek duuchchi naaphiinxe anga'n ibeexxa yanna</para>
  <para style="q2" vid="LAM 1:7">isee gargaarek ayyinna hedhemmabaan;</para>
  <para style="q1" vid="LAM 1:7">Naaphi isekinna isee uudeexxi</para>
  <para style="q2" vid="LAM 1:7">isexxe ba'neexxee isee ooso'le.<verse eid="LAM 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8" />Iyyerusaalemi jaba qico cubbo hujjemmaxxee</para>
  <para style="q2" vid="LAM 1:8">tennexxee battootte;</para>
  <para style="q2" vid="LAM 1:8">saala iseka uudemmaxxee,</para>
  <para style="q1" vid="LAM 1:8">Isee ulfeesammakiir duuchchi isee tuffate;</para>
  <para style="q2" vid="LAM 1:8">isenna fooxxi hita'n</para>
  <para style="q2" vid="LAM 1:8">udumi'a higge.<verse eid="LAM 1:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9" />Dubartetixxi aada ise ka'liteexxe seemma'n leellitte;</para>
  <para style="q2" vid="LAM 1:9">heger ise'n mayi geyaaxxa heddeba'a;</para>
  <para style="q1" vid="LAM 1:9">Iba isexxi yo'oshsha alashshiitaaxxe kadde</para>
  <para style="q2" vid="LAM 1:9">isee dayyeesaammakinna hedhemmaba'a;</para>
  <para style="q1" vid="LAM 1:9">Ee, Duuchchi Woddike Goottaa</para>
  <para style="q2" vid="LAM 1:9">naaphi injifatemmaxxee,</para>
  <para style="q1" vid="LAM 1:9">Rakko anxa uudi.<verse eid="LAM 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10" />Ise horateexxe karra duuchcha'ni,</para>
  <para style="q2" vid="LAM 1:10">naaphi anga ifixxa laa'mi asse;</para>
  <para style="q1" vid="LAM 1:10">Atike ya'i giddo e'yabaashsha</para>
  <para style="q2" vid="LAM 1:10">hoyyiteetak,</para>
  <para style="q1" vid="LAM 1:10">Fakke magenooffatammak gosa gosak ardi,</para>
  <para style="q2" vid="LAM 1:10">galmi giddi'a e'ya'naa affe.<verse eid="LAM 1:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11" />Ardi isek duuchchi itatika hassito</para>
  <para style="q2" vid="LAM 1:11">fooxxi hiyya'n oodhaan;</para>
  <para style="q1" vid="LAM 1:11">Hedhoti hedhatee'e,</para>
  <para style="q2" vid="LAM 1:11">ifixxa fiixa karra itati jijjiidhinaan;</para>
  <para style="q1" vid="LAM 1:11">«Ee, Duuchchi Woddike Gootta tuffatemme'naxxee</para>
  <para style="q2" vid="LAM 1:11">anee'e qallite uudi.»<verse eid="LAM 1:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12" />«Ha'no ora saxxina'neeke duuchcha, tinni ha'no'a shollaxxe hiyyatebaata?</para>
  <para style="q2" vid="LAM 1:12">amme uude; affe;</para>
  <para style="q1" vid="LAM 1:12">Jabaxxe isixxe mufexxa barra,</para>
  <para style="q2" vid="LAM 1:12">Duuchchi Woddik Gootti ane'ni iyyedageexxe</para>
  <para style="q1" vid="LAM 1:12">Ane'ni gelteexxe,</para>
  <para style="q2" vid="LAM 1:12">anxe rakkoshsha hexxeexxi rakko hexxeeta?<verse eid="LAM 1:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13" />«Iimmii'n giira erge,</para>
  <para style="q2" vid="LAM 1:13">iseenna butti'a, anixxe miqe giddi'a wocci assee</para>
  <para style="q1" vid="LAM 1:13">Lakka anixxenna fonxoro fayeexxi</para>
  <para style="q2" vid="LAM 1:13">uudumi'a anee hiisse;</para>
  <para style="q1" vid="LAM 1:13">Barra duuchcha shaqishshati,</para>
  <para style="q2" vid="LAM 1:13">anee duwwichcho asse waale.<verse eid="LAM 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14" />«Cubbo anxi qanbarke ane'n kadde;</para>
  <para style="q2" vid="LAM 1:14">isixxe anganni mitteba wodarende;</para>
  <para style="q1" vid="LAM 1:14">Gooba aneke'ninna ba'ende;</para>
  <para style="q2" vid="LAM 1:14">dada duuchchik Goottinna hunna anee gophise;</para>
  <para style="q1" vid="LAM 1:14">Dande'enexxi ifinaa'n hoyyedhabe'nokeera'n</para>
  <para style="q2" vid="LAM 1:14">anee sa'isse uwwe.<verse eid="LAM 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15" />«Ani giddo hedhemmaka loliinka manna duuchcha.</para>
  <para style="q2" vid="LAM 1:15">Dada duuchchik Gootti fuggusse.</para>
  <para style="q1" vid="LAM 1:15">Anke ka'umiwwixxa hunna bulleesso'a</para>
  <para style="q2" vid="LAM 1:15">sannachcha ane'n ye'e;</para>
  <para style="q1" vid="LAM 1:15">Eettene dubarichcho Yihudaxxa belto</para>
  <para style="q2" vid="LAM 1:15">dada duuchchik Gootti woyine miicatixxe bakka'n hirbeesse.<verse eid="LAM 1:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16" />«Ani oodhaa'nechchi tenne yaanerixxeeten;</para>
  <para style="q2" vid="LAM 1:16">anxe ille'n indiddo wo'miteen;</para>
  <para style="q1" vid="LAM 1:16">Anee dayyeeso'a shiqeek</para>
  <para style="q2" vid="LAM 1:16">anee jabeeso'a hedho anxa ukeeki ayyinna hedheba'a;</para>
  <para style="q1" vid="LAM 1:16">Naaphi midditte adhdheemmaxxee</para>
  <para style="q2" vid="LAM 1:16">oose anxi wixixxi hite'een.»<verse eid="LAM 1:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17" />Tsiyooni anga ifixxa farri assite;</para>
  <para style="q2" vid="LAM 1:17">kaddomale isee dayyeesaak hedheba'a;</para>
  <para style="q1" vid="LAM 1:17">Olla'uwwi isik iso'n diinake kado'a,</para>
  <para style="q2" vid="LAM 1:17">Duuchchi Woddik Gootti Ya'iqoobi'n ajaja fulche'een;</para>
  <para style="q2" vid="LAM 1:17">Iyyerusaaleminna insa'ne giddo battitte yaaneshsha uudende.<verse eid="LAM 1:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18" />«Duuchchi Woddik Gootti qullichchaken;</para>
  <para style="q2" vid="LAM 1:18">ani kinn isike ajaja'n jalle'eennan;</para>
  <para style="q1" vid="LAM 1:18">Ha'no koo arduwwa duuchchaa laqqe;</para>
  <para style="q2" vid="LAM 1:18">anxa ko'onna uudde;</para>
  <para style="q1" vid="LAM 1:18">Anxi dargageeyye labba meyyaxxi oose</para>
  <para style="q2" vid="LAM 1:18">booji'endee me'ite'een.<verse eid="LAM 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19" />«Ani jaaluwwa anka ye'edhennen;</para>
  <para style="q2" vid="LAM 1:19">insa'ne kinni anee ginbe;</para>
  <para style="q1" vid="LAM 1:19">Qeese anxinna geedhe anxi</para>
  <para style="q2" vid="LAM 1:19">hedho ifi ifixxa gatisatee ita halsina'ninni</para>
  <para style="q2" vid="LAM 1:19">ookkone qachchi giddo munde.<verse eid="LAM 1:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20" />«Ee dada duuchchike Goottaa wixixxi heyyee'naa</para>
  <para style="q2" vid="LAM 1:20">madhumma anee raafende'een balloo uudi!</para>
  <para style="q1" vid="LAM 1:20">Yo'oshsha jalleennaxxee'e</para>
  <para style="q2" vid="LAM 1:20">godobi anee raankeen;</para>
  <para style="q2" vid="LAM 1:20">gadho wolaantichchi</para>
  <para style="q2" vid="LAM 1:20">mini giddo reyote hexxeen.<verse eid="LAM 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21" />«Manni ani wixixxi hiyye oodhaa'na laqe</para>
  <para style="q2" vid="LAM 1:21">yaane kinni anee dayyeeseek ayyinna hedhebaan</para>
  <para style="q1" vid="LAM 1:21">Naaphi ank duuchchi abara anxa laqe;</para>
  <para style="q2" vid="LAM 1:21">ati tenne assiteettaxxe'ni gammade.</para>
  <para style="q1" vid="LAM 1:21">Ballo iitti hitettaxxi barra dagguun;</para>
  <para style="q2" vid="LAM 1:21">insa'nenna ani kadeennexxa kanduun.<verse eid="LAM 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22" />«Fuggo insa'nexxi duuchchi ati edo leelitowwaal;</para>
  <para style="q2" vid="LAM 1:22">cubbo anxe duuchchanaa'n kexxeexxa,</para>
  <para style="q1" vid="LAM 1:22">Ane'n assiteetteshanni,</para>
  <para style="q2" vid="LAM 1:22">insa'ne'ninna iittanni assi;</para>
  <para style="q1" vid="LAM 1:22">Wixixxiitixxi oodhishsha ane'ni bira saxxe'een</para>
  <para style="q2" vid="LAM 1:22">qalbetinna anee gophpheen.»<verse eid="LAM 1:22" /></para>
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1" />Dada duuchchik Gootti ifixxe mufenni,</para>
  <para style="q2" vid="LAM 2:1">Tsiyooni'i hittatta salphisee!<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">yookaan Dada duuchchik Gootti ifixxe mufenni Tsiyoonixxa meyyaxxa belto hittatta duummachcheese!</char></note></para>
  <para style="q1" vid="LAM 2:1">Eetennee Isira'eelike ulfinna kadeemmaka iimi'n butti'a darbe;</para>
  <para style="q2" vid="LAM 2:1">ifixxe mufexxa barra</para>
  <para style="q2" vid="LAM 2:1">ifixxe lekkake hadhisanjo kada isexxanna qalbeefatebaan.<verse eid="LAM 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2" />Isira'eelike ardika galduma duuchcha,</para>
  <para style="q2" vid="LAM 2:2">Dada duuchchiki Gootti mararte belo balleesse;</para>
  <para style="q1" vid="LAM 2:2">Yihudake ardixxa kollowwanna mufe ifixxenn diige bire</para>
  <para style="q1" vid="LAM 2:2">Mootumma isixxanna hayyoole isixxa,</para>
  <para style="q2" vid="LAM 2:2">salphise'e butta dibbi asse.<verse eid="LAM 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3" />Bubba'neexxe jabaxxe ifixxe mufenni</para>
  <para style="q2" vid="LAM 2:3">Isira'eelixxa hunna duuchcha gophise;</para>
  <para style="q1" vid="LAM 2:3">Suruureexxi naaphi dageexxa yanna</para>
  <para style="q2" vid="LAM 2:3">middixxa anga ifixxa illee iima hiisedhe.</para>
  <para style="q1" vid="LAM 2:3">Qarqara ifike'n hedheechcho duuchcha ittaammaxxe giirashsha,</para>
  <para style="q2" vid="LAM 2:3">Ya'iqoobixxe sanne'n bubenno bubbi asse.<verse eid="LAM 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4" />Naaphiinsha mogido ifika dobe;</para>
  <para style="q2" vid="LAM 2:4">middixxi iifxxi anganna qophpheeffate;</para>
  <para style="q1" vid="LAM 2:4">Illete'n elaaka duuchcha;</para>
  <para style="q2" vid="LAM 2:4">naaphiinsha insa'ne gorra'e;</para>
  <para style="q1" vid="LAM 2:4">Tsiyoonike ardike duunkaana'n</para>
  <para style="q2" vid="LAM 2:4">aare ifixxa giiruffa wocci asse.<verse eid="LAM 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5" />Dada duuchchik Gootti naaphuffa</para>
  <para style="q2" vid="LAM 2:5">Isira'eelika arda liqiinse;</para>
  <para style="q1" vid="LAM 2:5">Mootummatika isika minuwwanna balleesse;</para>
  <para style="q2" vid="LAM 2:5">kolluwwa isixxanna balleessse.</para>
  <para style="q1" vid="LAM 2:5">Yihudake arda'ni</para>
  <para style="q2" vid="LAM 2:5">wiiganna hunbaashsha bira sa'isse.<verse eid="LAM 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6" />Galma ifika hiddichchiinxe bakkashsha duwwi gatise;</para>
  <para style="q2" vid="LAM 2:6">bukki hiteexxa ifixxa bakkanna diige.</para>
  <para style="q1" vid="LAM 2:6">Duuchchi Woddik Gootti Tsiyooni,</para>
  <para style="q2" vid="LAM 2:6">ifika ayyaanuwwanna ifika Edika Sanbatuwwa deetashsha asse;</para>
  <para style="q1" vid="LAM 2:6">Jabaxxe ifixxe mufenni,</para>
  <para style="q2" vid="LAM 2:6">moyanjokanna qeesichcho yo'oshsha tuffate.<verse eid="LAM 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7" />Duuchchi Woddik Gootti tolchimalcho ifika gibe;</para>
  <para style="q2" vid="LAM 2:7">ifika Woyyichcha Galmanna waale;</para>
  <para style="q1" vid="LAM 2:7">Mootummatike minika dalla'uwwanna</para>
  <para style="q2" vid="LAM 2:7">naaphakee sa'isse uwwe.</para>
  <para style="q1" vid="LAM 2:7">Ayyaaniixxe barra'n assendammashsha</para>
  <para style="q2" vid="LAM 2:7">Duuchchi Woddike Goottike mine'n honga'ni cancine.<verse eid="LAM 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8" />Duuchchi Woddik Gootti Tsiyoonke qachchike qarqara'ni hedheeka dalla'a diigo'a mudhdhe.</para>
  <para style="q1" vid="LAM 2:8">Miketixxa wodaronna ibise;</para>
  <para style="q2" vid="LAM 2:8">balleessatena'ni udumi'a higebaan.</para>
  <para style="q1" vid="LAM 2:8">Kolluwwakanna dalla'uwwa diige;</para>
  <para style="q2" vid="LAM 2:8">mitteba olete kande.<verse eid="LAM 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9" />Huluwwa isexxi buttinake'n lixxe;</para>
  <para style="q2" vid="LAM 2:9">sibljiinka danqarsanjuwwa enqe balleesse.</para>
  <para style="q1" vid="LAM 2:9">Moyanjuwwi isikinna hayyoole isixxi booji'endeexxi gosa gosake ardi giddi'a booji'ende;</para>
  <para style="q2" vid="LAM 2:9">ta'anni edi'a yoona seeri olmiki hedhebaan.</para>
  <para style="q1" vid="LAM 2:9">Wabeeko isixxinna ta'anni edi'a</para>
  <para style="q2" vid="LAM 2:9">Duuchchi Woddike Goottinaa'n waleella insa'ne'a uwwendabaan.<verse eid="LAM 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10" />Tsiyoonike qachchiinxi geedhe</para>
  <para style="q2" vid="LAM 2:10">buttinna duwwike'n sammi hitee offolde;</para>
  <para style="q1" vid="LAM 2:10">Umo ifike'n bukko fiffilxiteexxi</para>
  <para style="q2" vid="LAM 2:10">jooniyya seemmanna oddo'wite'een;</para>
  <para style="q1" vid="LAM 2:10">Iyyerusaalemik dubari</para>
  <para style="q2" vid="LAM 2:10">umo butti'aa hangulli asse.<verse eid="LAM 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11" />Ardi ank shiyememmaxxee,</para>
  <para style="q2" vid="LAM 2:11">oosetinna annoole;</para>
  <para style="q1" vid="LAM 2:11">Qachchi giddike oruwwa'n wexeqendeemmaxxee'e</para>
  <para style="q2" vid="LAM 2:11">ille anxi oodhishshati garjite;</para>
  <para style="q2" vid="LAM 2:11">madhuma anixxi raafend;</para>
  <para style="q2" vid="LAM 2:11">godobikinna ane'e culphise.<verse eid="LAM 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12" />Ookkone qachchiinke ora'ni otemeeke manjishsha shaqine gaggabee wodda,</para>
  <para style="q2" vid="LAM 2:12">lubbo insa'nexxi amatixxe anga'ni fula geltee'naa</para>
  <para style="q1" vid="LAM 2:12">«Indaachchinna woyinetixxi booka habaxxee?»</para>
  <para style="q2" vid="LAM 2:12">hita'ni oose ama ifixxa qortaan.<verse eid="LAM 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13" />Ani ha'noo maa hiyyannoota?</para>
  <para style="q2" vid="LAM 2:13">Mayiki ha'noo fakkeesannotaa?</para>
  <para style="q1" vid="LAM 2:13">Koo eeyyendineeke Iyyerusaalemike qachchike ardaa!</para>
  <para style="q2" vid="LAM 2:13">Ha'noo dayyeesonnaa mayik ha'noo fakkeesanno?</para>
  <para style="q2" vid="LAM 2:13">gargar hexxineek koo Iyyerusalemik arda!</para>
  <para style="q2" vid="LAM 2:13">ha'noo'ni geltaaxxi ba'ni abbaayyatishsha ba'lake kadeemmaxxe'e,</para>
  <para style="q2" vid="LAM 2:13">ayyeteta ha'no fayyisutaa?<verse eid="LAM 2:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14" />Ha'nooxxi wabeekoxxi waleella dharakenna toliinxe;</para>
  <para style="q2" vid="LAM 2:14">booji'o atixxanna hiisinaasha cubbo ha'nooxxa gatisatenna</para>
  <para style="q2" vid="LAM 2:14">cubbo ha'noxxa farri assine kuleba'a;</para>
  <para style="q1" vid="LAM 2:14">Haasonneek wabeekuminna dedhakenna</para>
  <para style="q2" vid="LAM 2:14">orakennaa'n gorsaken.<verse eid="LAM 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15" />Ora sa'ak duuchchi;</para>
  <para style="q2" vid="LAM 2:15">anga insa'nexxa ate'ni calaan;</para>
  <para style="q1" vid="LAM 2:15">«Danchoomiinxi muxxe, butta duuchchixxi gammashsho</para>
  <para style="q2" vid="LAM 2:15">hiyyemek qachchi isi konnendee?»</para>
  <para style="q1" vid="LAM 2:15">Hina'ni umo le'minsati,</para>
  <para style="q2" vid="LAM 2:15">Iyyerusaalemi'ni gacifantaan.<verse eid="LAM 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16" />Naaphi ha'nok duuchchi</para>
  <para style="q2" vid="LAM 2:16">afo'o ha'no'n fulchedhaan</para>
  <para style="q1" vid="LAM 2:16">Isso ha'no'n qara'ninna ha'no'ni gacifata'n</para>
  <para style="q2" vid="LAM 2:16">«Insa'nee liqinsineennen;</para>
  <para style="q1" vid="LAM 2:16">Halchinaannaxxi yanna tennetemman;</para>
  <para style="q2" vid="LAM 2:16">hedhondinni he'ne isee uundenne» hina.<verse eid="LAM 2:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17" />Duuchchi Woddik Gootti hedeexxa muuxe;</para>
  <para style="q2" vid="LAM 2:17">qeeraxxe yanna edi gama haaso'emmaka</para>
  <para style="q1" vid="LAM 2:17">Hiyyichcho muuxxe;</para>
  <para style="q2" vid="LAM 2:17">mararte belo ha'no'o balleesse;</para>
  <para style="q1" vid="LAM 2:17">Naaphi wixixxi hiyya ha'nooxxe'n gammadaashsha,</para>
  <para style="q2" vid="LAM 2:17">naapha ha'nookixxa hunnanna jabeesse.<verse eid="LAM 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18" />Koo Iyyerusaalemike dalla'i giddo hexxina'neke arda</para>
  <para style="q2" vid="LAM 2:18">mitte godobinni dada duuchchike Goottiba'a raare;</para>
  <para style="q1" vid="LAM 2:18">Hashsha barra</para>
  <para style="q2" vid="LAM 2:18">indiddo ha'nooxxi wode'uffa duneddowwaal;</para>
  <para style="q1" vid="LAM 2:18">Ifi'aani hafuura adhitinoqqee;</para>
  <para style="q2" vid="LAM 2:18">ille ha'nooxxenaa'ni indiddo qootoqqe'e.<verse eid="LAM 2:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19" />Hashshixxi yanna geltaa wodda</para>
  <para style="q2" vid="LAM 2:19">kexxine, hashshat raarre;</para>
  <para style="q1" vid="LAM 2:19">Dada duuchchik Gootti edo qalbe ha'nooxxi wode'uffa cingitowwaal;</para>
  <para style="q1" vid="LAM 2:19">Ora ora'n solo'ik ibbeexxe</para>
  <para style="q2" vid="LAM 2:19">ha'nooxxe oosexxe hedho'a</para>
  <para style="q2" vid="LAM 2:19">soodachchot anga isiba'a ke'isse.<verse eid="LAM 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20" />«Ee, duuchchi Woddike Gootta! Ballo uudi!</para>
  <para style="q2" vid="LAM 2:20">Konneechchi edo hoone arda'nite konne qico godoba kultite egendettek?</para>
  <para style="q1" vid="LAM 2:20">Amuwwa ifixxa anoole</para>
  <para style="q2" vid="LAM 2:20">kookkise nossiteexxa ifixxa oose ittaachchoo?</para>
  <para style="q1" vid="LAM 2:20">Wabeekinna qeesichchi</para>
  <para style="q2" vid="LAM 2:20">Duuchchi Woddike Goottike galmi giddo shiyemaachchota?<verse eid="LAM 2:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21" />«Ori orixxe buko giddo</para>
  <para style="q2" vid="LAM 2:21">geerchikinna ka'untichchi ibe;</para>
  <para style="q1" vid="LAM 2:21">Ka'umi dubartenna ka'umi labballi</para>
  <para style="q2" vid="LAM 2:21">wolaantichchik shiyemme;</para>
  <para style="q1" vid="LAM 2:21">Atixxe mufexxa barra insa'nee shiltete;</para>
  <para style="q2" vid="LAM 2:21">mararte belonna dulemaashsha assitete.<verse eid="LAM 2:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22" />«Ayyaaniixa barra ita ha'watee yexxattashsha</para>
  <para style="q2" vid="LAM 2:22">bararassa duuchchinn darre'n ane'n yexxete</para>
  <para style="q1" vid="LAM 2:22">Duuchchi Woddike Goottixxe mufexxa barra</para>
  <para style="q2" vid="LAM 2:22">ayyinna fulebaa yookaan gatebaan;</para>
  <para style="q2" vid="LAM 2:22">ile xoo'mamik nossedhennekaara,</para>
  <para style="q2" vid="LAM 2:22">naaphi anenaa'ni shiye bire.»<verse eid="LAM 2:22" /></para>
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1" />Mageniinxe mufetixxe siqqoxxa</para>
  <para style="q2" vid="LAM 3:1">rakko uudennek manji anten.<verse eid="LAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2" />Ifi edii'n anee fulcheexxi</para>
  <para style="q2" vid="LAM 3:2">ifake kadebaak, dukkana giddo me'annoshsha asse.<verse eid="LAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3" />Barra duuchcha, hige higeexxi</para>
  <para style="q2" vid="LAM 3:3">anga ifixxenni anee gane.<verse eid="LAM 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4" />Isi goga ankanna maala anka cinse;</para>
  <para style="q2" vid="LAM 3:4">miqe anxanna enqe.<verse eid="LAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5" />Qaraarto yaaddokanna rakkoka</para>
  <para style="q2" vid="LAM 3:5">dalla'a ane'n ijaare, ane'e qoqqobe.<verse eid="LAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6" />Edo, qeeraxxe yanna'n reyemmakeerishsha</para>
  <para style="q2" vid="LAM 3:6">dukkana giddo hedhannoshsha asse.<verse eid="LAM 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7" />Fulabonoshsha qarqara anke'ni dalla'a ijaare;</para>
  <para style="q2" vid="LAM 3:7">usuremeneka haachchabanna ane'n a'urse.<verse eid="LAM 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8" />Gargaarsa halse ye'edhenne wodda midde</para>
  <para style="q2" vid="LAM 3:8">soodachcho anxa laqa gibe.<verse eid="LAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9" />Ora anka bocendeexxe kinonn duuchche;</para>
  <para style="q2" vid="LAM 3:9">qaxaamura ankanna midamiddichchake asse.<verse eid="LAM 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10" />Gaadammake dibbi hinaake biniichishsha</para>
  <para style="q2" vid="LAM 3:10">sho'ommemake neenqishshanna,<verse eid="LAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11" />Harkise orakenaa'n anee fulche kochchiseexxi</para>
  <para style="q2" vid="LAM 3:11">duwwi anee gatise.<verse eid="LAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12" />Gabe dobeexxi</para>
  <para style="q2" vid="LAM 3:12">ifike mogidixxe ille anee assedhe.<verse eid="LAM 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13" />Mogiduwwa gonofakenaa'n fulcheexxi</para>
  <para style="q2" vid="LAM 3:13">onna anaxxa ote.<verse eid="LAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14" />Anke ardi duuchchi'a oso'lichchiinke kadenne;</para>
  <para style="q2" vid="LAM 3:14">barra duuchcha sirbinaa'n ane'n gacifante.<verse eid="LAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15" />Hedho anxa rakkoti qaraarse</para>
  <para style="q2" vid="LAM 3:15">heexote asse.<verse eid="LAM 3:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16" />Isso anxa kinot enqee;</para>
  <para style="q2" vid="LAM 3:16">bukko giddonna anee hirbeesse.<verse eid="LAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17" />Hedho anxi nage'a gophphe;</para>
  <para style="q2" vid="LAM 3:17">gammashsho maacho kaddeexxa dedhenne.<verse eid="LAM 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18" />Tennexxee, «Ulfaata anke,</para>
  <para style="q2" vid="LAM 3:18">Duuchchi Woddike Goottanaa'n heqqedhannaxxi addachchiisa duuchchanna gatte'een» hiyyenne.<verse eid="LAM 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19" />Wixixxinna doonsa kiyya anixxa qaabata</para>
  <para style="q2" vid="LAM 3:19">ane'n heexotenna ha'lootote kadde.<verse eid="LAM 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20" />Tennera hedaa'naa</para>
  <para style="q2" vid="LAM 3:20">hedho ani giddo xo'o hite.<verse eid="LAM 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21" />Kaddo malee mitte yaane heda</para>
  <para style="q2" vid="LAM 3:21">ossunte ane'n wo'nshite; tinninna<verse eid="LAM 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22" />Mundeebo'nok ganteenek Duuchchi Woddike Goottixxe lumoxxe jaalalaxxeeten;</para>
  <para style="q2" vid="LAM 3:22">mararte isixxinna hara muddabaaxxen.<verse eid="LAM 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23" />Isenna gorsa gorsa'ninna haaroxxe;</para>
  <para style="q2" vid="LAM 3:23">addatensha isixxinna lumoxxe.<verse eid="LAM 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24" />Ani ifi'anni, «Duuchchi Woddik Gootti anke qoobbon</para>
  <para style="q2" vid="LAM 3:24">tennexxee isoo heqedhannon» hiyyenne.<verse eid="LAM 3:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25" />Isoo heqqedhakeeri'a,</para>
  <para style="q2" vid="LAM 3:25">halsaake manji'a Duuchchi Woddik Gootti eloken.<verse eid="LAM 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26" />Manji Duuchchi Woddike Goottixxa anjira</para>
  <para style="q2" vid="LAM 3:26">sammi hiyye heqqedha eloxxen.<verse eid="LAM 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27" />Manji dargageesummate'n</para>
  <para style="q2" vid="LAM 3:27">qanbara ba'edha eloxen.<verse eid="LAM 3:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28" />Iso'ni Dada Duuchchik Gootti qanbara ba'isemmaxxee,</para>
  <para style="q2" vid="LAM 3:28">qofitti sammi hiyye offo'lowwaal.<verse eid="LAM 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29" />Edi'a adde isi'a hedhaa dandeetammaxxee'e</para>
  <para style="q2" vid="LAM 3:29">bukkote'n ifi moogowwaal.<verse eid="LAM 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30" />Dhabanaasaake boqo ifixxa gedowwaal</para>
  <para style="q2" vid="LAM 3:30">salphinekanna goddowwaal.<verse eid="LAM 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31" />Dada Duuchchik Gootti manjo,</para>
  <para style="q2" vid="LAM 3:31">duuchchi woddi'a hune waalabaan.<verse eid="LAM 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32" />Yaaddo manjoke'n geltashsha asseexxe kaddoolenna</para>
  <para style="q2" vid="LAM 3:32">bira saxxeexxe ifixxe jalalanaa'n kexxeexxa mararaan.<verse eid="LAM 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33" />Tinninna kaddeechchi isi anga ifixxenni</para>
  <para style="q2" vid="LAM 3:33">manjiinke belto'n rakko daggaashsha assa gopheemmaxxeten.<verse eid="LAM 3:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34" />Bogi giddik usuremalluwwi duuchchi</para>
  <para style="q2" vid="LAM 3:34">lekkati hirbeesemaa wodda,<verse eid="LAM 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35" />Dada Duuchchike Duuchchi Woddike Gootti edo</para>
  <para style="q2" vid="LAM 3:35">seeriinxa ifixxa yaane manji gophaa wodda,<verse eid="LAM 3:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36" />Mitte manjo'n yaane seerin gadho murendaa wodda</para>
  <para style="q2" vid="LAM 3:36">Dada Duuchchik Gootti eetene yaane afabaata?<verse eid="LAM 3:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37" />Dada Duuchchiki Gootti mureexxe yaane kadde'exxe malee</para>
  <para style="q2" vid="LAM 3:37">hiyyeexxa assa dande'aak ayyete?<verse eid="LAM 3:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38" />Eloxxenna kaddo elobaaxxi yaane kaddaak</para>
  <para style="q2" vid="LAM 3:38">Dada Duuchchike Duuchchi Woddik Gootti haaso'ee qicishatebaata?<verse eid="LAM 3:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39" />Hedhot hedheek manji hujeexxe cubboxxee</para>
  <para style="q2" vid="LAM 3:39">xixemaa wodda mayee gunguma?<verse eid="LAM 3:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40" />Ora no'oka qonte qonise uundo</para>
  <para style="q2" vid="LAM 3:40">Duuchchi Woddike Goottiba'anna hingo.<verse eid="LAM 3:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41" />Qalbe anga no'oxxen welti</para>
  <para style="q2" vid="LAM 3:41">iima hedheek mageniba'a ke'isinno; hinnano qici,<verse eid="LAM 3:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42" />«Cubbo hunje'ennen; jalline'enen;</para>
  <para style="q2" vid="LAM 3:42">atinna no'o'a gattowwaal hiteeboxxon.<verse eid="LAM 3:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43" />«Yo'oshsha mufatte no'o fiisitete;</para>
  <para style="q2" vid="LAM 3:43">mararte belo no'o shilteten.<verse eid="LAM 3:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44" />Soodachcho no'oxxi atiba geltabaashsha</para>
  <para style="q2" vid="LAM 3:44">duumachchik ifi buqeexxette.<verse eid="LAM 3:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45" />Gosa gosake ardi giddo</para>
  <para style="q2" vid="LAM 3:45">no'o ceegenshanna koriinsha assiteten.<verse eid="LAM 3:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46" />«Naaphi no'ok duuchchi,</para>
  <para style="q2" vid="LAM 3:46">afo'o ifka no'o'ni fulchedhe.<verse eid="LAM 3:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47" />Bararaqatinna iba</para>
  <para style="q2" vid="LAM 3:47">iittaanni diigenshatinna ba'ne no'o'ni gelte.»<verse eid="LAM 3:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48" />Ardi ank gelteexxe ba'nenaa'n kexxeexxa</para>
  <para style="q2" vid="LAM 3:48">ille anxenaa'n indiddo galaani wode'ishsha yaate.<verse eid="LAM 3:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49" />Ille anxenaa'n indiddo wode'uffa yaata;</para>
  <para style="q2" vid="LAM 3:49">sammitte yaataan,<verse eid="LAM 3:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50" />Tinninna kaddaak</para>
  <para style="q2" vid="LAM 3:50">Duuchchi Woddik Gootti iimi'n butti'a</para>
  <para style="q2" vid="LAM 3:50">no'o uuda qici'aten.<verse eid="LAM 3:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51" />Qachcha anke'ni hexxeexxe dubarte duuchcha'ni gelteexxa uuda anxi</para>
  <para style="q2" vid="LAM 3:51">anee yaadisse.<verse eid="LAM 3:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52" />Mitte buuto belo anke naapha kade'emmakiir</para>
  <para style="q2" vid="LAM 3:52">ci'uffa anee adamme.<verse eid="LAM 3:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53" />Bale giddo lubbo ane'e balleessino'a</para>
  <para style="q2" vid="LAM 3:53">ane'ninna kino darbine;<verse eid="LAM 3:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54" />Wodi'i anke umi hanii'ni yaa'e;</para>
  <para style="q2" vid="LAM 3:54">ba'eneelcho ane'ni labbe.<verse eid="LAM 3:54" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55" />Dhi'mo bale giddo hedhennexxi</para>
  <para style="q2" vid="LAM 3:55">Ee, Duuchchi Woddike Gootta summa atika ye'edhenne.<verse eid="LAM 3:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56" />Kadha anxa laqe'eten; gargaarsa halse wiiganno wodda</para>
  <para style="q2" vid="LAM 3:56">laqa gibate'e mansha buqexxoxxee.<verse eid="LAM 3:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57" />Ate'e ye'edhenne wodda ani bira shiqetexxi</para>
  <para style="q2" vid="LAM 3:57">ane'e «Sodaatoxxe» hitette.<verse eid="LAM 3:57" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58" />Ee, Dada Duuchchike Gootta! Anxe yaanexxe tukke kadde'e;</para>
  <para style="q2" vid="LAM 3:58">hedho anxa woddette.<verse eid="LAM 3:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59" />Ee, Dada Duuchchike Goottaa! Ane'n assemmeka mancira duuchcha uude'eten;</para>
  <para style="q2" vid="LAM 3:59">murte anxa ani'a muri.<verse eid="LAM 3:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60" />Naaphi anki ani'a afeexxa halonna</para>
  <para style="q2" vid="LAM 3:60">ane'ni hedeeka daba duuchcha uudeeten.<verse eid="LAM 3:60" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61" />Ee, Dada Duuchchike Goottaa! Yowwichcho insa'neka duuchcha;</para>
  <para style="q2" vid="LAM 3:61">ane'n hendeeka daba duuchcha laqqe'eten;<verse eid="LAM 3:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62" />Kunninna naaphi ank barra duuchcha</para>
  <para style="q2" vid="LAM 3:62">anee hashasha'nexxeenna gunguma'nexxeeten.<verse eid="LAM 3:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63" />Ofo'lanna ke'a insa'nexxa uudi;</para>
  <para style="q2" vid="LAM 3:63">sirbik ane'n gacifanta'neen.<verse eid="LAM 3:63" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64" />Ee, Duuchchi Woddike Goottaa! Insa'nexxe angaxxe huje'a</para>
  <para style="q2" vid="LAM 3:64">geyaaka hira insa'ne'a uwwi.<verse eid="LAM 3:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65" />Maa hiyyemunuu qalbe insa'nexxenaa'n hoyyi</para>
  <para style="q2" vid="LAM 3:65">badino atixxinna insa'ne'ni hexxuun.<verse eid="LAM 3:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66" />Duuchchi Woddik Gootti mufet insa'ne fiiseexxi</para>
  <para style="q2" vid="LAM 3:66">iimati butti'a insa'ne birowwaal.<verse eid="LAM 3:66" /></para>
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1" />Worqe hitta shibbillite!</para>
  <para style="q2" vid="LAM 4:1">Eloxxi worqe hitta jijjiirende!</para>
  <para style="q1" vid="LAM 4:1">Galmi ijaarememmaxxi kino,</para>
  <para style="q2" vid="LAM 4:1">weldeenna weldeena'n xerendeen.<verse eid="LAM 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2" />Ca'itte worqeshsha uudendeemmaxxi,</para>
  <para style="q2" vid="LAM 4:2">ulfaatto Tsiyoonixxi labbaxxi oose,</para>
  <para style="q1" vid="LAM 4:2">Faarinke hujallixxi anga,</para>
  <para style="q2" vid="LAM 4:2">ta'a hitta giisitemmake faarinke miya kadde!<verse eid="LAM 4:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3" />Jeedaluwwi midde ununa farri assee beltanna ifixxa unuunsedha;</para>
  <para style="q2" vid="LAM 4:3">ank ardi kinni qiilla gammojeke balguduwwishsha</para>
  <para style="q2" vid="LAM 4:3">godoba jabaate.<verse eid="LAM 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4" />Wode'e dheebo'watenaa'n kexxeexxa;</para>
  <para style="q2" vid="LAM 4:4">annooletik arabi quumeti quumete kade;</para>
  <para style="q1" vid="LAM 4:4">Oose ittaachcho kadhatte</para>
  <para style="q2" vid="LAM 4:4">yaane kinni mittikinna ittaachcho uwweba'a.<verse eid="LAM 4:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5" />Elo eloxxa ita ita'emmakiir</para>
  <para style="q2" vid="LAM 4:5">ora oranni mude;</para>
  <para style="q1" vid="LAM 4:5">Baddeesitte seemma oddo'wa'n nophemmakiir</para>
  <para style="q2" vid="LAM 4:5">ta'a bululiinxe kose'n hana diiphe.<verse eid="LAM 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6" />Arda anke'n geyeek xixichchi,</para>
  <para style="q2" vid="LAM 4:6">ayyixxi anganna kissebaang;</para>
  <para style="q1" vid="LAM 4:6">Hirbake'n ba'emmake,</para>
  <para style="q2" vid="LAM 4:6">Soodoomike qachchixxenaa'n caalde.<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="GEN 19:24">Dada. 19:24</ref>. </char></note><verse eid="LAM 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7" />Hayyoole insa'nexxi kaadeti caala ca'a hiteexeramman;</para>
  <para style="q2" vid="LAM 4:7">addoti caalanna gola'liteexeramman;</para>
  <para style="q1" vid="LAM 4:7">Bisi insa'nek diimoke fiixa kinji calla dhiilletemma'a</para>
  <para style="q2" vid="LAM 4:7">dhagga insa'nexxinna senper hiyyemaake fiixa kinjishsha danchatema'a.<verse eid="LAM 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8" />Ta'a kinni insa'ne cilaateti caala xille'ne'een;</para>
  <para style="q2" vid="LAM 4:8">orake'n insa'ne ayyinna ege'neba'a;</para>
  <para style="q1" vid="LAM 4:8">Bisi insa'nek miqeti miqete kade'een;</para>
  <para style="q2" vid="LAM 4:8">haqqetishshanna bage'een.<verse eid="LAM 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9" />Solo'ik reyeekiir mannii'n,</para>
  <para style="q2" vid="LAM 4:9">wolantichchik reyeekaara woyya</para>
  <para style="q1" vid="LAM 4:9">Sagale buttin fulcheechcho gophatenaa'n kexxeexxa</para>
  <para style="q2" vid="LAM 4:9">solo'ik bange munde.<verse eid="LAM 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10" />Ardi ank shiyememma wodda</para>
  <para style="q2" vid="LAM 4:10">ifi'a sagale kaddo'a</para>
  <para style="q1" vid="LAM 4:10">Olo'we melaalle anga ifixxenninni</para>
  <para style="q2" vid="LAM 4:10">finna ifika gaffe.<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 28:57">Lan. 28:57</ref>; <ref loc="EZK 5:10">Hiz. 5:10</ref>. </char></note><verse eid="LAM 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11" />Duuchchi Woddike Gootti jabaxxa aare ifixxa muuxe;</para>
  <para style="q2" vid="LAM 4:11">bubbaaxxa ifixxa mufe dhangalaase.</para>
  <para style="q1" vid="LAM 4:11">Booso isexxi itendashsha</para>
  <para style="q2" vid="LAM 4:11">Tsiyooni'ni giira bubbi asse.<verse eid="LAM 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12" />Naaphuwwakenna kado yabaabuluwwi,</para>
  <para style="q2" vid="LAM 4:12">Iyyerusaalemixxa huluwwa diinge e'yinaan hine,</para>
  <para style="q1" vid="LAM 4:12">Buttatike moyaanjuwwanna</para>
  <para style="q2" vid="LAM 4:12">yookaan buttatike arda duuchchana'ni amaneek ayyinna hedhemmabaan.<verse eid="LAM 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13" />Yaane kinni tinni kaddeechchi</para>
  <para style="q2" vid="LAM 4:13">ise giddo qulliyyetixxa munde dundemmaxxe</para>
  <para style="q1" vid="LAM 4:13">Isexxe wabeekolexxe cubbonaa'n</para>
  <para style="q2" vid="LAM 4:13">isexxe qeesexxe balleessanaa'n kexxeexxenniten.<verse eid="LAM 4:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14" />Insa'ne ille ba'eeke manjishsha,</para>
  <para style="q2" vid="LAM 4:14">orake'n gadaadonna.</para>
  <para style="q1" vid="LAM 4:14">Ayyinna seemma insa'nexxa dande'eexxi tuqaba qici'a,</para>
  <para style="q2" vid="LAM 4:14">mundeti battonne'een.<verse eid="LAM 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15" />Manni insa'ne'e «Ha'no battoole ookko'a me'we!» hiyya'ne canca;</para>
  <para style="q2" vid="LAM 4:15">«Bayyatte! Bayyatte! No'o'o tuqinoqqe» hiyyaan;</para>
  <para style="q1" vid="LAM 4:15">Insa'ne baanja'n gadaadonnee wodda,</para>
  <para style="q2" vid="LAM 4:15">gosa gosake ardi giddo hedheek ardi, ta'anni kayyi'a,</para>
  <para style="q2" vid="LAM 4:15">«Insa'ne kaba hekki hiyya hasisabaan.»<verse eid="LAM 4:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16" />Duuchchi Woddik Gootti umo ifingenninni insa'nee xeeredheen;</para>
  <para style="q2" vid="LAM 4:16">ta'anni kayyi'a insa'nee heqqabaan;</para>
  <para style="q1" vid="LAM 4:16">Qeese insa'neexxe ulfeesendebaan</para>
  <para style="q2" vid="LAM 4:16">geedhe insa''nexxinna elle alfitebaan.<verse eid="LAM 4:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17" />Tolla boddichcha gargaarsa coo'minaa'naanni,</para>
  <para style="q2" vid="LAM 4:17">ille no'o gophphe;</para>
  <para style="q1" vid="LAM 4:17">Heqqecatixxe no'oxxe xelleepho hana he'ene no'o'o dande'eexxi,</para>
  <para style="q2" vid="LAM 4:17">anjirabaaka wele gosa gosa arda heqe'nenne.<verse eid="LAM 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18" />Manni faana no'oxxa qore;</para>
  <para style="q2" vid="LAM 4:18">tennexxee ora me'a dandenebo'no;</para>
  <para style="q1" vid="LAM 4:18">Muuxami no'ok shiqe dagemmaxxee</para>
  <para style="q2" vid="LAM 4:18">bari no'okinna qubichchik laakko'emeeke; ba'ne no'oxxinna gelte'een.<verse eid="LAM 4:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19" />Iimma me'ammake sinbiri caala</para>
  <para style="q2" vid="LAM 4:19">no'oo shorredhekiir xinniqa'ni</para>
  <para style="q1" vid="LAM 4:19">Koobuwwati hana no'o shorre;</para>
  <para style="q2" vid="LAM 4:19">qiilla gammoojje giddonna riphe no'o gaade.<verse eid="LAM 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20" />Duuchchi Woddik Gootti harireek hedho no'oxxik hafuur,</para>
  <para style="q2" vid="LAM 4:20">insa'nexxe fonxoronni abideme;</para>
  <para style="q1" vid="LAM 4:20">Gaaddisi isiki hunda,</para>
  <para style="q2" vid="LAM 4:20">gosa gosake ardi giddo he'na'no hine hendeennan.<verse eid="LAM 4:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21" />Ha'no Uuzike boga'n hexxina'neeke</para>
  <para style="q2" vid="LAM 4:21">koo Eedoomike arda gammadde, ilillisse!</para>
  <para style="q1" vid="LAM 4:21">Yaane kinni ha'no bado ha'noxxe'n;</para>
  <para style="q2" vid="LAM 4:21">Dada Duuchchike Goottixxe mufetixxe buudanaa'n,</para>
  <para style="q2" vid="LAM 4:21">ha'witine machchootineexxi saali belonna gatinaan.<verse eid="LAM 4:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22" />Koo Iyyerusaalemike ardaa! Mura woxa ha'nooxxi muuxendaan;</para>
  <para style="q2" vid="LAM 4:22">isi ta'anni edi'a booji'o giddo turtinaashsha assabaan;</para>
  <para style="q1" vid="LAM 4:22">yaane kinni koo Eedoomike ardaa!</para>
  <para style="q1" vid="LAM 4:22">balleessa ha'noxxee mura woxxinaan;</para>
  <para style="q2" vid="LAM 4:22">cubbo ha'noxxinna faajje fuldaan.<verse eid="LAM 4:22" /></para>
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1" />Koo Duuchchi Woddike Gootta! No'o'n gelteexxa hedi;</para>
  <para style="q2" vid="LAM 5:1">uudi, salphinne no'okanna afi!<verse eid="LAM 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2" />Qadaadi no'ok alaguwwakee</para>
  <para style="q2" vid="LAM 5:2">mini no'okinna annafeeke manni'a uwwemedheen.<verse eid="LAM 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3" />No'o anni hedhebaake manna</para>
  <para style="q2" vid="LAM 5:3">ammuwwa no'oxinna aro'o shi'witeexxe hiyyeette kadde'een.<verse eid="LAM 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4" />Wode'e maalaqik ha'wine;</para>
  <para style="q2" vid="LAM 5:4">haqqetanna maalaqiki hidhdha hasisaan.<verse eid="LAM 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5" />Qanbar fe'emeeke horiinsha oofemiyyot</para>
  <para style="q2" vid="LAM 5:5">lumoshsha kurbu hinenne; hafuura adhdhanna hoyyemmenne.<verse eid="LAM 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6" />Goddine indonna'a hinee</para>
  <para style="q2" vid="LAM 5:6">Gibtsee'anna Asoori'a anga uunenne.<verse eid="LAM 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7" />Annuwwi edik no'ok cubbo huje sa'ne;</para>
  <para style="q2" vid="LAM 5:7">no'o kinni insa'nexxe balleessa'a xixemmenne.<verse eid="LAM 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8" />Garbi no'o'n moyedheen;</para>
  <para style="q2" vid="LAM 5:8">anga insa'nexxenaa'ninna no'o dande'e fulchaak ayyinna hedheba'a.<verse eid="LAM 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9" />Qiilla gammoojje giddo manjo anga sa'a hedhatenaa'n kexxeexxa,</para>
  <para style="q2" vid="LAM 5:9">lubbo no'oxxa gurgudhineete indanochcho alfinennen.<verse eid="LAM 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10" />Gubaake solo'inke holatinaa'n kexxeexxa</para>
  <para style="q2" vid="LAM 5:10">bisi no'ok qaqiinsha xiledhe.<verse eid="LAM 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11" />Tsiyooni giddo melaalle</para>
  <para style="q2" vid="LAM 5:11">Yihudake qachchuwwa'ninna dubarra hunnati diinphe.<verse eid="LAM 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12" />Akeekisanjuwwi no'ok anga insa'neexxe'n fanniseme;</para>
  <para style="q2" vid="LAM 5:12">geedhuwwatinna ulfeesendeba'a.<verse eid="LAM 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13" />Dargaggeeyye daamma daltaashsha assende;</para>
  <para style="q2" vid="LAM 5:13">labbaxxi oose haqqe dukati lelleqqe.<verse eid="LAM 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14" />Geedhe qachchinxe hula'n offo'la waalde;</para>
  <para style="q2" vid="LAM 5:14">dargaggeeyye sirbitammaka sirba uurrise.<verse eid="LAM 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15" />Gammashsho qalbe no'oxenaa'n baxxe;</para>
  <para style="q2" vid="LAM 5:15">sirb no'ok yaadote'n jijjiremeen.<verse eid="LAM 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16" />Kallachchi no'oke uminaa'n ibe'een;</para>
  <para style="q2" vid="LAM 5:16">cubbo hunje'enaxxee aanne no'o'a.<verse eid="LAM 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17" />Tennenaa'n kexxeexxa qalbe no'o ela gophphe;</para>
  <para style="q2" vid="LAM 5:17">tenne yaanuwwaxxeeranna ille no'oxxi garjite.<verse eid="LAM 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18" />Urmite gattetexxe tee Tsiyoonixxi Kooba,</para>
  <para style="q2" vid="LAM 5:18">jeedaluwwinxe dikka kadde'en.<verse eid="LAM 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19" />Ee, koo Duuchchi Woddike Gootta! Ati duuchchi woddike mootichcha;</para>
  <para style="q2" vid="LAM 5:19">moote atixxi ila ila'a hexxaan.<verse eid="LAM 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20" />Ati maayee hara no'o'o deetete?</para>
  <para style="q2" vid="LAM 5:20">Mayeeta no'o qeerake bari'a waaldette?<verse eid="LAM 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21" />Ee, Duuchchi Woddike Gootta! Atiba'a hingona'a no'o hiisi</para>
  <para style="q2" vid="LAM 5:21">jiro no'oxxa olmi woddishsha haaronsi.<verse eid="LAM 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22" />Haranga anee waldetten;</para>
  <para style="q2" vid="LAM 5:22">yo'oshanna ane'ni mufateeten.<verse eid="LAM 5:22" /></para>
  <chapter eid="LAM 5" />
</usx>