<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CH" style="id">- Gedeo Bible</book>
  <para style="h">2 Odotikaa Maxaafa</para>
  <para style="toc1">Langakaa Odotikaa Maxaafa</para>
  <para style="toc2">2 Odotikaa Maxaafa</para>
  <para style="toc3">2 Odo.</para>
  <para style="mt1">Langakaa Odotikaa Maxaafa</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Langak Odotik Maxaafixxi kuta lame safaak taakkak odotik maxaaf kuta mitte uurremabaa'nten. Tinnina moyanjo Solomoonixxe galchanaa'n safeexxi isixxe reyo qico'n mare geyaan; Iyyoribi'amixxe akeekisanjummanni midda hexxeexxi gossuwwa anna ifike Solomoonixxe bakka'n moyeemmake Yihudiinke moyanjo'n Robi'aami'n fuggoxxeni insa'ne ke'a odeeseechchi uduma, Iyyerussaalemi diigendee qico'n Kirisitoosixxe ilensha edi darre onde dhibba saddeeta tommenna jaane wogga qico'n hexxeexxa bita'ixxa Yihudixxe moottummaxxa jirte mitteba bukki asse mitte mitte kulaan.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Solomoonika bekkumanna karra <char style="ior"><ref loc="2CH 1:1-17">1:1-17</ref> </char></para>
  <para style="io1">Galmi ijaaremeexxanna eebbisemeexxa <char style="ior"><ref loc="2CH 2:1-7:22">2:1—7:22</ref> </char></para>
  <para style="io1">Solomoonike baro'n hujendeexxa wele yaanuwwa <char style="ior"><ref loc="2CH 8:1-9:28">8:1—9:28</ref> </char></para>
  <para style="io1">Solomoonixxa reyo <char style="ior"><ref loc="2CH 9:29-31">9:29-31</ref> </char></para>
  <para style="io1">Isira'eelixxi middixxi gosuwwa moyanjo Robi'aami'n fuggoxxenni ke'a <char style="ior"><ref loc="2CH 10:1-19">10:1-19</ref> </char></para>
  <para style="io1">Yihudinka moyanjuwwa <char style="ior"><ref loc="2CH 11:1-28:27">11:1—28:27</ref> </char></para>
  <para style="io1">Moyanjo Hiziqiyaasinna Asoortotika lola <char style="ior"><ref loc="2CH 29:1-32:33">29:1—32:33</ref> </char></para>
  <para style="io1">Moyanjo Minaaseenna moyanjo Amoonii'i <char style="ior"><ref loc="2CH 33:1-25">33:1-25</ref> </char></para>
  <para style="io1">Moyanjo Iyyosiyyaasinna Mageniinke seerika Maxaafa <char style="ior"><ref loc="2CH 34:1-35:27">34:1—35:27</ref> </char></para>
  <para style="io1">Udu'maaka Yihudika moyanjuwwa <char style="ior"><ref loc="2CH 36:1-16">36:1-16</ref> </char></para>
  <para style="io1">Iyyerussaalemixxa diigenshshanna isek ard booji'eme Baabiloon'a adhdhemeexxa <char style="ior"><ref loc="2CH 36:17-21">36:17-21</ref> </char></para>
  <para style="io1">Faarisiki moyanji Qiroosi Ayihuudiki mann ifike bogibaa higo'a eeti uwweexxa <char style="ior"><ref loc="2CH 36:22-23">36:22-23</ref> </char></para>
  <chapter number="1" style="c" sid="2CH 1" />
  <para style="s1">Moyanji Solomoon Mageni Beekuma Uwwo'a Soodateexxa</para>
  <para style="r">(<ref loc="1KI 3:1-15">1 Moy. 3:1-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 1:1" />Duuchchi Woddik Gootti isik Mageni isinni welt hedhemmaxxee, saademaashshanna assemmaxxe Daawwitik belti Solomooni mootummate'n jabaate ofo'le.<verse eid="2CH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 1:2" />Ookkoneechchi uduma Solomoon Isira'eelito duuchchi'a kuma ajajamakeri'a, dhibba ajajammakeri'a, hayyoolle ittanni moottummate'ni galchammake akeekisanjuwwa, shiqike firuwwik akeekisanjuwwa duuchchi'a, <verse eid="2CH 1:2" /><verse number="3" style="v" sid="2CH 1:3" />Duuchchi Woddik Goottik erganji Muuse qiilla gammoojje'ni hujeemmak Mageno magenoofachchoti duunkaan ookko hedhemmaxxee, Solomooninna ardi duuchchi Geba'ooni hedheek tullichibaa me'ine. <verse eid="2CH 1:3" /><verse number="4" style="v" sid="2CH 1:4" />Ookkone wodda moyanji Daawwiti Magenika taaboota Qiriyatiyi'aarimii'n Iyyerusaalemi giddo isi'a giissememmake duunkaanbaa iyyedageemman<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="2SA 6:1-17">2 Sam. 6:1-17</ref>; <ref loc="1CH 13:5-14">1 Odo. 13:5-14</ref>; <ref loc="1CH 15:25-16:1">15:25—16:1</ref>.</char></note> <verse eid="2CH 1:4" /><verse number="5" style="v" sid="2CH 1:5" />Kaddo malee'e Huurika akka'o, Uurika belto Baatsili'eel Duuchchi Woddike Goottike sageettotik tolchimalcho ookko Geba'ooni duunkaani albi edo hedhemman; tennexxe moyanji Solomooninna ardi duuchchi isoo ookko soodata'emman.<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="EXO 38:1-7">Fula. 38:1-7</ref>. </char></note><verse eid="2CH 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 1:6" />Moyanji Solomooninna Duuchchi Woddika Gootta edo mageneefachchotike duunkaan giddo hedheeke sageettoti tolchimalchiba dageexxi isi hana mitte kuma ciincatika tolcha shiqise.<verse eid="2CH 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 1:7" />Eettene hashsha'n Mageni Solomooni'n lelleexxi isoo, «Ati'a maachcho uwwona'a hassaate?» hiyye laqe.<verse eid="2CH 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 1:8" />Solomoonina Magenoke'n hiyye hissee haaso'e qici, «Ati anna anke'e Daawwiti'a lumoxxa atixxa eeya kutabelo isi'a leellishsheten; ta'anna ani anke annixxe bakka'ni tukkeeseme moyanoshsha assitetten. <verse eid="2CH 1:8" /><verse number="9" style="v" sid="2CH 1:9" />Ta'anna Duuchchi Woddike Gootta Magenoo! Anke anni'a haasotettek haaso'i muuxemaashsha assi. Atinna laakkoonne dhaqqanbabaaxxe bukushsha hedheeke arda'n ane'e baallonsitetten.<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="GEN 13:16">Dada. 13:16</ref>; <ref loc="GEN 28:14">28:14</ref>. </char></note> <verse eid="2CH 1:9" /><verse number="10" style="v" sid="2CH 1:10" />Tennexxee konne arda seerik akeekatee dande'annoshsha beekkumakanna ege'na ani'a uwwi; iita kada gophphoole kinni lumoka arda atika hitta akeeka dande'ano?»<verse eid="2CH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 1:11" />Magenikinna Solomoon hiyyee qici, «Atixxe qalbeke yaadi konnete kadeemmaxxe, karra, durumma yookaani eloka summa yookaan naaphi atiki reyaashsha, yookaani qeerraaxxa wogga laqedha gophphetaxxee mootattoshsha assenneka anka arda seerik galchitattoshsha beekkumanna ege'na laqqeettaxxee, <verse eid="2CH 1:11" /><verse number="12" style="v" sid="2CH 1:12" />tennexxee ati laqqqeeteka beekkumakanna ege'na uwwannon. Higgeenni konneechchi edo huuni moyanjinna alfebaaxxa edi'aanna ayyinna alfabaaxxa karra, durummanna ulfinna ati'a uwwannon.»<verse eid="2CH 1:12" /></para>
  <para style="s1">Moyanjo Solomoonika Baallomanna Durumma</para>
  <para style="r">(<ref loc="1KI 10:26-29">1 Moy. 10:26-29</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 1:13" />Solomooninna anfenshatik duunkaan hedhemmake Gaba'oonike tullichchibaa'n ke'eexxi Iyyerusaalemi'a ille iima hige. Isinna Isira'eeli moye.<verse eid="2CH 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 1:14" />Solomooni mitte kumanna shoole dhibba fsarageelluwwanna tommenna lame kuma loliinka fadhado bukki asse; isinna mitte kummanna shoole dhibba sarageelluwwanna tommenna lame kuma fadhado afe'eemman; Konneera duuchcha sarageelluwwiinke qachchuwwa'ninna isi hedheeke Iyyerusaalemi qachchi giddo ugge.<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="1KI 4:26">1 Moy. 4:26</ref>. </char></note> <verse eid="2CH 1:14" /><verse number="15" style="v" sid="2CH 1:15" />Moyanji Solomooni worqetanna birret sibiljo Iyyerusaalemi giddo kinotishsha bira sa'aashsha, birbirsakanna tullichchi tullichchuwwii hunda hedhammake odi'iinke haqichchishsha birasaashsha asse. <verse eid="2CH 1:15" /><verse number="16" style="v" sid="2CH 1:16" />Solomoonik fadhaduwwinna daga'nemmaki Gibtse'ninna Qewwee'nitemmani. Moyanjiinxi daddaltonna konnee fadhaduwwa maallaqik Qewwe'a hirte aaxxe daggaamman. <verse eid="2CH 1:16" /><verse number="17" style="v" sid="2CH 1:17" />Gibtsee'n iyyedangaammaka mitte sarageella jaane dhibba birreti sibiljinni, mitti fadhachcho mitte dhibbanna onde tomme sibiljo birrenni hirreemman. Insa'nenna konneera wirri assineexxi Hittiitoteenna Sooritotike moyanjuwwi'a gurgura'emmani.<note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="LEV 17:16">Lew. 17:16</ref>. </char></note><verse eid="2CH 1:17" /></para>
  <chapter eid="2CH 1" />
  <chapter number="2" style="c" sid="2CH 2" />
  <para style="s1">Galma Ijaarate Qophpheefanteexxa Qophpheefachcho</para>
  <para style="r">(<ref loc="1KI 5:1-18">1 Moy. 5:1-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 2:1" />Moyanji Solomoon Duuchchi Woddike Goottike summi'a galmakanna ifi'anna mootummatika mine ijaaremo'a ajaja sa'isse. <verse eid="2CH 2:1" /><verse number="2" style="v" sid="2CH 2:2" />Tennexxe miya ba'edhaaka torbaane tomme kuma, tullichchakenaa'ni kino bocaaka saddeeta tomme kuma manna hujetee bobbaase. Huje towataaka sase kumanna jaane dhibba manna ugge.<verse eid="2CH 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 2:3" />Ookkoneechchi uduma Solomoon Xeerosike moyanji'a Kiraami konneechchi butti'a hexxeexxa ergeexxi, «Anki anna moyanji Daawwiti hedhammaka mootummatika mine ijaadhdhema wodda birbirsiinxa haqqe ergitetteshshanni; ani'aanna birbirsiinxa haqqe ergi. <verse eid="2CH 2:3" /><verse number="4" style="v" sid="2CH 2:4" />Eloka foole afeeka hixaana isi edo gubatee, qullitte kebbo kutabelo shiqinshatee, ciincatika tolcha duuchchi wodda hashshanna barra tolchatee, ittanni sanbata sanbata'n, haarooxxi baate fuldaaxxe yanna'ninna Duuchchi Woddik Gootti'a muremeeke woyyichcha ayyaanuwwa duuchcha'n ciincatik tolchi tolchemaaka galma Duuchchi Woddike Gootta no'oke Magenike summi'a hujennexxi woyyonsona'a hedheennen; tenne aada Isira'eelike ardi'a duuchchi woddi'a assaashsha ajajendeexxen.<verse eid="2CH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 2:5" />«No'oki Mageni wele magenuwwa duuchchanaa'ni erra lumoke kadeemmaxxee ani isi'a ijaaranneki galminna lumoken. <verse eid="2CH 2:5" /><verse number="6" style="v" sid="2CH 2:6" />Yaane kinn iimatinna iimuwati iima hexxeexxi iima midde iso'o abida dandetammabaaxxe; galma isi'a ijaara dande'aki ayyete? Isi edo hixaana gunbaake male'e galma isi'a ijaarannoki ani ayyete?<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="1KI 8:27">1 Moy. 8:27</ref>; <ref loc="2CH 6:18">2 Odo. 6:18</ref>. </char></note><verse eid="2CH 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 2:7" />«Yoona ati anni anki Daawwiti qophpheseexxe anibaa'ninna Yihuda'ninna Iyyerusaalemi'ni hexxeexxe oge afe'ke manninni welti hedhaaka worqe, birreti sibiljo, sageettot hiri fiixeeka sibiljo, baddeesitte, boorajite, diimoke shimalinni seemma gana dande'aaka ogeti manjo ani'a erg.<verse eid="2CH 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 2:8" />«Atik erganjuwwi birbirsiinxe haqqenaa'ni kunte aa'na qico baranteexxa ege'neennaxxee libaanosike haqichonaa'n, birbirsiinkenaa'ninna sandaaletike haqichchonaa'n ani'a erg. <verse eid="2CH 2:8" /><verse number="9" style="v" sid="2CH 2:9" />Kunni ani ijaaratee hedeeneki galmi ba'lakenna hara yo'oshsha biifa'neeke kada hasissammaxxee ani heddo haqqe karee qophpheessat atika manna gargaaro'a anka manna atiba'a ergatee giisedheennen. <verse eid="2CH 2:9" /><verse number="10" style="v" sid="2CH 2:10" />Haqqe woxa'neek atik hujalluwwi itaaxxa shoole kumanna shoole dhibba kiilo leetiro dinne, shole kumanna shoole dhibba kiilo leetiro so'a, shoole dhibbanna shoole tome leetiro woyinetixxa booka shoole dhibbanna shoole neetiro ejersiinxa zayite ati'a ergannon.»<verse eid="2CH 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 2:11" />Moyanji Kiraaminna moyanjo Solomooni'a borro hiise borreesse hiyyee qic, «Duuchchi Woddiki Gootti arda ifika eeyyammaxxee atee insa'nee moote galchitota'a asseen» hiyye.<verse eid="2CH 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 2:12" />Moyanji Kiraaminna hiise hiyyee qici, «Duuchchi Woddike Gootti'a galmakanna ifi'a mootummatika mine ijaraaka beekkumiki, galcheccatinna qarummati wo'meeka belto ifika moyanjo Daawwiti'a uwweeki, iimanna butta dadeki Isira'eeliki Duuchchi Woddiki Gootti Mageni saademowwaal!» hiyye. <verse eid="2CH 2:12" /><verse number="13" style="v" sid="2CH 2:13" />«Yoona beekkumikinna angatixxa oge barateeka Huurami Aabite hinaaka qaro manjo atiba'a erganene. <verse eid="2CH 2:13" /><verse number="14" style="v" sid="2CH 2:14" />Isixxi amanna Daanixxe gosan, anni kinna Xiroosike bogike manjoni, Huraami Aabi worqeti, birreti sibiljonaa'ni, sageetotena'ni, sibljokena'ni, hiri fiixeeke kinjonaa'ninna haqqetenaa'n gargar hexxeexxa yaane hujatixxa dande'a afeedheen. Ittanni boorajitetenaa'n, baddeessittetenaa'ni, diimmoxxa seemmanaa'ninna layinotixxa seemma huja dande'aan. Konneechchuwwi gadhonna gargarit hedheeka seesuwwa fulchanna kulle qicinni huja duuchchingecehcho giissa dande'aan. Isinna angatixxa oge atike manninna anna atike Daawwiti anke goottinni welti hujaan.<verse eid="2CH 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 2:15" />«Yoona ergitotta'a ane'ni kuldetteke haaso'ishshanni dinne, so'a, woyineti bulbulonna ejerisiinxa zayite ani'a ergi. <verse eid="2CH 2:15" /><verse number="16" style="v" sid="2CH 2:16" />No'ona ati hassaattexxa haqqe duuchcha Libaanoosi'ni karre'e mura murati usure'e abbaayyati hana sheleelli asina'n Iyyophe qico'n adaadde gogo'minshannoni: atinna ookko'n Iyyerusaalemi'a adhdhitattoni» hiyye.<verse eid="2CH 2:16" /></para>
  <para style="s1">Woyyichchi Galmike Ijaarsixxa Safa</para>
  <para style="r">(<ref loc="1KI 6:1-38">1 Moy. 6:1-38</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 2:17" />Moyanji Solomoon konneechchi edo anni iski Daawwiti assemmashshanni Isira'eelike boga'n hedha'neeka wele bogika manna duuchcha laakko'e; laakkossi insa'nekinna mitte dhibbanna onde tommenna sase kumanna jaane dhibbamman. <verse eid="2CH 2:17" /><verse number="18" style="v" sid="2CH 2:18" />Insa'ne giddi'n toribaani tommi kumi miya ba'edhaake; saddeeti tommi kumi tullichchuwakenaa'ni kino bocaashsha asse. Higgeen huje towataaka sase kumanna jaane dhibba manna file.<verse eid="2CH 2:18" /></para>
  <chapter eid="2CH 2" />
  <chapter number="3" style="c" sid="2CH 3" />
  <para style="s1">Solomoon Galma Ijaare</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 3:1" />Solomooninna Iyyerusaalemi giddo Duuchchi Woddik Gootti anna isikee moyanjo Daawwiti'ni leelemaba Moriyaxxe kooba hana Iyyaabusichcho Oriinaxxe aldu'me'ni Daawwiti qophpheeseke booncho'ni Duuchchi Woddik Goottika Woyyichcha galma ijaarsa safe.<note caller="-" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="GEN 22:2">Dada. 22:2</ref>. </char></note> <verse eid="2CH 3:1" /><verse number="2" style="v" sid="2CH 3:2" />Isinna Solomoon moyeexxe shoolgaxxe wogga'ni langake agenjo'ninna langaxxe barra'n galma ijaara safe.<verse eid="2CH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 3:3" />Moyanji Solomoon ijaarisiseeke galmixxi booso, qeerinni jaane tomme ciqile kadaa wodda godobikinna lame tomme ciqilemman. <verse eid="2CH 3:3" /><verse number="4" style="v" sid="2CH 3:4" />Galminba'a e'yinammaxxe hulaxxi soroxxi hojja lame tomme ciqile onde kadaa wodda, lame tomme ciqilemman, giddonna ca'itte werqenni buqe. <verse eid="2CH 3:4" /><verse number="5" style="v" sid="2CH 3:5" />Galmiinxa lumoxxa kuta hi'neesinke haqichchinni buqeexxi hanna ca'itte worqe buyye, itti hanna meexxet haqichchixxanna haachchabiinxa fakke hana giisse. <verse eid="2CH 3:5" /><verse number="6" style="v" sid="2CH 3:6" />Moyanji Solomoon galma fiixeeke kinjininna Faaruwwayike boganaa'ni daggeexxe woriqenni danchoossemman. <verse eid="2CH 3:6" /><verse number="7" style="v" sid="2CH 3:7" />Galmiinxe heellichcho hana uggemaaka dagalisanjo, gubanuwwa, gimuwwanna cufanuwwa worqeti buqe; gimuwwate'ninna Kirubeelixxa fakke hana giisse.<verse eid="2CH 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 3:8" />Isinna hara Woyyite baka hinaaxxa giddixxa kuta giisse; ba'linnikinna lame tomme ciqile, godobikinna lame tomme. Hara Woyyite heellichchuwwa lame tommenna kuma kiilo gelteexxe ca'itte worqe hana bunqe giissineemman.<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="EXO 26:33-34">Fula. 26:33-34</ref>. </char></note> <verse eid="2CH 3:8" /><verse number="9" style="v" sid="2CH 3:9" />Woriqetixxi misimaaruwwa onde dhibbanna torbaane tomme giraama birteen. Hara woyyitexxa iimi darrexxa kutuwwa iittanni worqeti buqe.<verse eid="2CH 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 3:10" />Hara woyyitte kuta giddo lame kirubeelexxa fakke siblik<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">Ibritotike barro'n manni fakkuwwa giisa'emak siblik yookaan sageetotike siblinni kaddeexxa ege'nendeexxen</char></note> giisise hana worqeti buqe. <verse eid="2CH 3:10" /><verse number="11" style="v" sid="2CH 3:11" />Kasakenaa'n kasii qico'n weli abidee farri hiyyek kirubeeliki keeli lame tomme ciqile. Siretike kirubeelichchi mitti keeli onde ciqile kadeexxi galmiinxa gimo tuqa wodda, weli onde ciqile kadeeki keeli kinn langake kirubeelika keela tuqaammani. <verse eid="2CH 3:11" /><verse number="12" style="v" sid="2CH 3:12" />Itanni langake kirubeelki mitte keelik qeerrinn onde ciqile kade kallachchake'ni hedheek galmiinxa gimo tuqa wodda, onde ciqile kadaa wodda weli keeli kinn siretika kirubeelika keela tuqaammani. <verse eid="2CH 3:12" /><verse number="13" style="v" sid="2CH 3:13" />Farri hiyyeeke tenne kirubeeliki keeluwwi lame tomme ciqile kadaa wodda; alba insa'nek galmixxe umoke kadexxe kutaba'a wirri assine lekkati uurinemmani.<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EXO 25:18-20">Fula. 25:18-20</ref>. </char></note><verse eid="2CH 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 3:14" />Higgeenni hanjaaxxe boorajiteti, baddeessitte, fuutta suunqe ganneeke diimmooke shimalininna layinoti golo giissexxi kirubeelixxa fakke hana seese giissemmani.<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="EXO 26:31">Fula. 26:31</ref>. </char></note><verse eid="2CH 3:14" /></para>
  <para style="s1">Sageettotike Sibiljika Lame Utuphuwwa</para>
  <para style="r">(<ref loc="1KI 7:15-22">1 Moy. 7:15-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 3:15" />Galmi edi dare mitteba qeerrinni sase tommenna onde ciqilenna gamisa lame utuphuwwa hujeexxi, galmiinke albi edo uurrise. Mitti mittinge utuphi hana qeerrinne onde ciqile kaddeexxa lame bokkuwwa afeemman. <verse eid="2CH 3:15" /><verse number="16" style="v" sid="2CH 3:16" />Weli'anni weli sagaremeeka haachchabuwwa giissexxi utuphpiinxe qacce'n welti afensise. Ookkoneechchi uduma dhibba roomanetixxa gumma giissexxi haachchabuwwiki welti abidise. <verse eid="2CH 3:16" /><verse number="17" style="v" sid="2CH 3:17" />Utuphuwwa mitte bita'ake'n wele middaka'n uggeexxi Galmiinke albi edo uurrise; bita'i darree'n hedhemmaka Yaakin<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">Akimagaada </char><char style="fqa" closed="false">Yaakeni </char><char style="ft" closed="false">Hiyyo </char><char style="fqa" closed="false">Isi qullo fulcheen</char><char style="ft" closed="false">Mageni uurisan hiyya kada dendeetan.</char></note> middi darree'n hedhemmaka Boo'ezi<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">Aki magaada </char><char style="fqa" closed="false">Boo'ezi </char><char style="ft" closed="false">Hiyyo </char><char style="fqa" closed="false">Magenoke'n hunna hexxeen jabaati hiyyaten</char><char style="ft" closed="false">Hiyya kada dendeetan.</char></note> hiyye summa fulche.<verse eid="2CH 3:17" /></para>
  <chapter eid="2CH 3" />
  <chapter number="4" style="c" sid="2CH 4" />
  <para style="s1">Galmiinke Miyyuwixxa Wo'ma</para>
  <para style="r">(<ref loc="1KI 7:23-51">1 Moy. 7:23-51</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 4:1" />Moyanji Solomoon qeerrinne lame tomme ciqile ba'linne lame tomme ciqile iimi'a hojja tomme ciqile kadeeka sageettoti tolchimalcho giisse.<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="EXO 27:1-2">Fula. 27:1-2</ref>. </char></note> <verse eid="2CH 4:1" /><verse number="2" style="v" sid="2CH 4:2" />Ittanni afo'o isikik ba'linni kasakenaa'n kasii qico'n tomme ciqile; hojja isixxi onde ciqile kadeeka gonga baqinseeke sibilinni giisse; isixxi qarqari isiki mikemaa wodda sase tomme ciqile kade. <verse eid="2CH 4:2" /><verse number="3" style="v" sid="2CH 4:3" />Gongiinke afo'i butti darree'n mitte mitte ciqile'n tomme tomme jibootiinxa fakke gongii qarqara'ni giisse; ookko jibbotiinxi fakkenna gongiinke biso kadee lame dala'ni baqisende giisendeexxemman.<verse eid="2CH 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 4:4" />Gongikinna tommennaa lame jibootixxe fakke'n hana uureeke kadaa wodda; jibootikinna sasi middi darree'n sasi dhidhimi darree'n sasi bita'i darree'n sasi boroti darree'n uunda'nemman. Gongikinna jibootiinxe fakkuwwa'n hana offo'leeke kadaa wodda duuchchiinge jibootixxe fakkeki dudduri giddi darre'n wirri hiyyeemman. <verse eid="2CH 4:4" /><verse number="5" style="v" sid="2CH 4:5" />Gongiinki furdinni mitte taakko; afo'i kinn buudatike afo'ishsha yookaan suufetika daraaro fakkaata'nemman; gongikinna jaane tomme kuma leetiro aadha'emman.<verse eid="2CH 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 4:6" />Ittanni tomme anshecatika gonguwwa giissiseexxi onde bita'ake'ni, onde kinn middi darree'n, ugge; gonguwwi ciincatike tolchi'a shiqinshachchuwwa anshinaake kadaa wodda; lumoke gongiki wodi'i kinn qeesole anshexxaaken.<verse eid="2CH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 4:7" />Isi hunjo'a kulemmashaanni; tomme worqetika torbaane dhankoka xaasa giissiseexxi galmi giddi'a e'yisheexxi; onde bita'i darree'n; onde middi darree'n ugge.<verse eid="2CH 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 4:8" />Tomme beera giisseexxi, onde bita'i darree'n onde middi darree'n galmi giddo ugge. Higgeenni dhibba hubbuqitte qoruwwa worqeti giisse.<verse eid="2CH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 4:9" />Solomooni qeesteenna baxxe giisse; ittanni ba'laxxa baxxenna giisseexxi cufanuwwa giisseechchi uduma cufanuwwa sageettoti buqe. <verse eid="2CH 4:9" /><verse number="10" style="v" sid="2CH 4:10" />Lummoka gonganna galminba'n bita'i darre'a shiqqaaxxe boro'n hedheeke kasaa'ni ugge.<verse eid="2CH 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 4:11" />Ittanni Kiraami odolchuwwa, faafasujuwwakanna ferritte qoruwwa giisse; Huraaminna galmi giddixxe huje'a kadaaka miyyuwwa moyanjo Solomooni'a huje bire; hujechchuwwinna,<verse eid="2CH 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2CH 4:12" />Lame utuphuwwa,</para>
  <para style="q2" vid="2CH 4:12">utuphuwiinxe qacce'n hana hexxeexxa</para>
  <para style="q2" vid="2CH 4:12">qoretixxe fakkexxa lame bokkuwwa;</para>
  <para style="q2" vid="2CH 4:12">utuphuwake'n hana hexxexa lamiinxa;</para>
  <para style="q2" vid="2CH 4:12">qoretixxe fakkexxa bokko</para>
  <para style="q2" vid="2CH 4:12">danchoossaaki lame dowwek hachchabuwwi;<verse eid="2CH 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2CH 4:13" />Utuphuwwake'n hana hexxeexxa lame</para>
  <para style="q2" vid="2CH 4:13">qoretixxe fakkexxa bokko danchoositaashsha</para>
  <para style="q2" vid="2CH 4:13">mitte mtte marbabe'a lame dala romaanuwwa</para>
  <para style="q2" vid="2CH 4:13">lame dalixxe marbabe'aa</para>
  <para style="q2" vid="2CH 4:13">mitteba shoole dhibba romaanuwwa,<verse eid="2CH 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="2CH 4:14" />Ansheccatixxi qoruwwa hana ofoldammake offo'lisanjuwwinni;<verse eid="2CH 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="2CH 4:15" />Gonganna ookkone gongi hana ofo'lemmak tommennaa lame jibootuwwa;<verse eid="2CH 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="2CH 4:16" />Odolchuwwa, faafasunjuwwa, otisanjiinxi mooqquwwanna konneechchuwwinn welti shiqaak miyuwwan.</para>
  <para style="m" vid="2CH 4:16">Huurami Aabi Duuchchi Woddike Goottike galmi giddo la'onfachchotee kadaaka moyanjo Solomooni'a giisseki miyyuwi duuchchi moronde ca'a assineexxe sageettonni giissineekemmani. <verse eid="2CH 4:16" /><verse number="17" style="v" sid="2CH 4:17" />Moyanji Solomooni konne sageettotike sibiljika miyuwwa sageettotika sibiljo baqisee faariinke miyixxa bifa afaashsha faariinke miyi giddo dunemeek Sukootixxenna Tsaritaanixxe oddo'n hexxeexxe Yordaanoosixxe dhooqa'niten. <verse eid="2CH 4:17" /><verse number="18" style="v" sid="2CH 4:18" />Kunni Solomoon giissiseechchi duuchchi yo'oshsha heddoke kademaxxe sageettotiki sibiljik ha'uri hiteeke kadaxxa egeenebaan.<verse eid="2CH 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 4:19" />Ittanni Solomoon Mageniinke galmi giddo hujete'n hosaaka miyyuwa giisseeki konneechchinn butti'a hedheen:</para>
  <para style="q1" vid="2CH 4:19">Worqetika tolchimalcho;</para>
  <para style="q1" vid="2CH 4:19">Kebbo ugginaaka beera;<verse eid="2CH 4:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="2CH 4:20" />Uwwemeeke seerishshaanni; woyyitte woyyo edigama xabaashsha ca'itte worqenni giissineeka torbaane dhankoka offoilisanjo xassuwwinginni welt;<verse eid="2CH 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="2CH 4:21" />Worqetike daraarixxe misilexxi hujuwwa, xassuwwikinna qarabuwwa ca'itte worqenni hunjeexxemmani.<verse eid="2CH 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2CH 4:22" />Ca'itte worqenni giissineexxi xassa xorsinamachchuwwi, fiffixxatee kaddaaxxi ferritte qoruwwa, mooqquwwanna hixaana gunbamachchuwwi, iittann galmiinki worqetik cufanuwwi, tinninna Woyyitte woyyo giddi darreeki cufanuwwinna galmiinxe ba'laxxe kutaki cufanuwwi ca'itte worqenni hunjeekemman.<verse eid="2CH 4:22" /></para>
  <chapter eid="2CH 4" />
  <chapter number="5" style="c" sid="2CH 5" />
  <para style="p">
    <verse number="1" style="v" sid="2CH 5:1" />Moyanji Solomoon Duuchchi Woddike Goottika galma ijaare bireechchi uduma Anni isik Daawwiti foyemmaxxa worqenna birretika sibiljo miyyuwa duuchcha iyyedageexxi Mageniinke galmi giddo miya massinammaba ugge.<note caller="-" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="2SA 8:11">2 Sam. 8:11</ref>; <ref loc="1CH 18:11">1 Odo. 18:11</ref>. </char></note><verse eid="2CH 5:1" /></para>
  <para style="s1">Taaboota Galmi Giddi'a Iyyedangeexxa</para>
  <para style="r">(<ref loc="1KI 8:1-9">1 Moy. 8:1-9</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 5:2" />Ookkoneechchi uduma Solomooni Duuchchi Woddike Goottika kakotika taabbota Daawwitke qachchanaa'n Tsiyooni'n alallee iyyedango'a; Isra'elixxa gedhuwwa, gosa gosaka akeekisanjuwwa duuchchanna Isira'eelika mini minika akeekisanjuwwa iyyerusaalemi bukki asse.<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="2SA 6:12-15">2 Sam. 6:12-15</ref>; <ref loc="1CH 15:25-28">1 Odo. 15:25-28</ref>. </char></note> <verse eid="2CH 5:2" /><verse number="3" style="v" sid="2CH 5:3" />Isira'eeliki manni duuchchi torbake agenjika ayyaana ulfeessemma wodda; moyanji edo bukki hiyye.<verse eid="2CH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 5:4" />Isira'eelixxi geedhe bukki hite wodda Leewwito kakotika taabbota iimi'a ke'isite. <verse eid="2CH 5:4" /><verse number="5" style="v" sid="2CH 5:5" />Taaboota, afenshatika duunkaan giddo hedhemmaka woyyichcha miya duuchcha aa'neexxi alaallee qabante; Leewwitotiinxi qeesolenna isoo ba'exxe. <verse eid="2CH 5:5" /><verse number="6" style="v" sid="2CH 5:6" />Moyanji Solomooninna isi bira bukki hiyyemmaki Isira'eeliki tuuta duuchchi laakkonne dhaqanbabaaka gedhebonba jiboota Taabooti edo tolchchine.<verse eid="2CH 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 5:7" />Qeesetinna Duuchchi Woddike Goottika kakkotika taaboota galmiinxe giddi darrexxe woyyite woyyo bakka'n e'yinsheexxi Kirubeelike keeli hunda hexxeexxe bakka'n uggine.<note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="EXO 25:31-40">Fula. 25:31-40</ref>. </char></note> <verse eid="2CH 5:7" /><verse number="8" style="v" sid="2CH 5:8" />Kirubeelinna keeluwwa ifika taabooti iimi darre hedheeke booncho'n farri assee; kakkotika taabootanna taaboota dunkammaka haqichchuwwa buqe.<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="EXO 25:23-30">Fula. 25:23-30</ref>. </char></note> <verse eid="2CH 5:8" /><verse number="9" style="v" sid="2CH 5:9" />Kakotika taaboota dunkammaki haqichchi yo'oshsha qeerraake kadatenaa'n kexxeexxa; Taabooti hedheeke boonchi qico'n hexxeexxe qaccuwwa woyyitte woyyo edi darree'n leella'nemmani; galm gadho kinn leella'nemmabaani; telchi qico'n ookkone booncho'ninni hedheen. <verse eid="2CH 5:9" /><verse number="10" style="v" sid="2CH 5:10" />Isira'eel Gibtsee'n fuldechchi uduma Duuchchi Woddiki Gootti insa'nenni welti kako aage wodda, Muuse Korebixxe kooba'n kakotike taabooti giddo lame bocendemmaxxa kino uggeeka male'e taabooti giddo mittichchinna hedhemmabaan.<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="LEV 10:5">Lew. 10:5</ref>. </char></note><verse eid="2CH 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 5:11" />Qeesetinna galmakenaa'n fulde; ookko hexxemmaxxi qeesole insa'neke qoobbixxe hujenna kada gophphoole duuchchiinxi ifi woyyoonsiteemman. <verse eid="2CH 5:11" /><verse number="12" style="v" sid="2CH 5:12" />Faaro faarisammaki Leewwito duuchchi; Asaafi, Amaani, Hemaaninna Edotaami; labaaxxi oose insa'nexxinna firuwwi insa'neki duuchchi eloxxa layino odo'wineexxi; tolchiinke boonchibaa'n boroti darre'n uurrineexxi Tsena tsille qilliqilli assina'n; kiraarakanna masinqo meellinsa'nemman: insa'nenna malagata ufuuffammaxxe mitte dhibbanna lame tomme qeesole erqe kayyi'n buqqeemman. <verse eid="2CH 5:12" /><verse number="13" style="v" sid="2CH 5:13" />Malagata ufuunfammakiirrinna faarisanjo mitteba hige'e mitte hafuurrinni Duuchchi Woddika Gootta saanda'ninnaa galateefanta'ni: malagatiki, tsenaa tsilletinna wele faarotike miyinni qoqqonbeexxi hafuura gikki assineexxi Duuchchi Woddika Gootta saanda'n;<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 Odo. 16:34</ref>; <ref loc="2CH 7:3">2 Odo. 7:3</ref>; <ref loc="EZR 3:11">Izr. 3:11</ref>; <ref loc="PSA 100:5">Far. 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Erm. 33:11</ref>. </char></note><note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="EXO 40:34-35">Fula. 40:34-35</ref>. </char></note></para>
  <para style="q1" vid="2CH 5:13">«Isi elokeni;</para>
  <para style="q2" vid="2CH 5:13">Jaalala isixxi duuchchi woddixxeni hina'n faarsine.»</para>
  <para style="p" vid="2CH 5:13">Ookkoneechchi uduma Duuchchi Woddike Goottike Galma'ni duumanchi wo'me. <verse eid="2CH 5:13" /><verse number="14" style="v" sid="2CH 5:14" />Duuchchi Woddike Goottiki gaachchanni Magenike galma'n wo'meemmaxxee duumanchakenaa'n kexxeexxa qeese uwwendeexxa huje huja dandeettebaan.<verse eid="2CH 5:14" /></para>
  <chapter eid="2CH 5" />
  <chapter number="6" style="c" sid="2CH 6" />
  <para style="s1">Solomooni Ardake'n Haaso'eeka Haaso'a</para>
  <para style="r">(<ref loc="1KI 8:12-21">1 Moy. 8:12-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 6:1" />Ookkoneechchi uduma Solomoon hiyyee qici, «Duuchchi Woddiki Gootti dimma duumanchi giddo hedhaaxxa haaso'eeni; <verse eid="2CH 6:1" /><verse number="2" style="v" sid="2CH 6:2" />Aninna duuchchi wodda hexxattoka konne mambe'iinka lumoka galma ati'a ijaarenneni.»<verse eid="2CH 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 6:3" />Isira'eeliki tuuta duuchchi ookkoo uurite hexxe'na'a moyanji Solomoon insa'nebaa wirri hiyyeexxi insa'ne eebbise. <verse eid="2CH 6:3" /><verse number="4" style="v" sid="2CH 6:4" />Ookkoneechchi uduma hiyyee qici: «Anna anke Daawwiti'a hiyye addachchiisemmaka hiyyichcho anga ifixxinni muuxeeki Isira'eeliki Duuchchi Woddiki Gootti Mageni galateefatemmowaal; isinna hiyyeema qici, <verse eid="2CH 6:4" /><verse number="5" style="v" sid="2CH 6:5" />‹Anka arda Gibtsee'n fulchennexxe barranaa'n ke'isse summi anki ye'emaaka galma ijaaremmaxxa bakka fedheeke Isira'eelixxe gosake qachchuwwanaa'n mittekanna filebe'noni; yookaani anke ardike Isira'eelike akeekisanjo kado'a ayyeenna filebe'non. <verse eid="2CH 6:5" /><verse number="6" style="v" sid="2CH 6:6" />Ta'a kinn summi anki ookkoo ye'emo'a Iyyerusaalemii fi'leenneni; anka arda Isira'eeli moye galcho'a Daawwitii fi'leennen.›<verse eid="2CH 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 6:7" />«Anki Anni Daawwiti Isira'eelike Duuchchi Woddike Gootta Mageniinke summinni galma ijaaro'a godobik hedeemani. <verse eid="2CH 6:7" /><verse number="8" style="v" sid="2CH 6:8" />Duuchchi Woddiki Gootti kinn anna anke Daawwiti'a hiyyee qici: ‹Anna anke Daawwiti'a summa anke galma ijarittota'a godobiki heddettan; tennee godobi atiki giddo heda eloxxe asitetten. <verse eid="2CH 6:8" /><verse number="9" style="v" sid="2CH 6:9" />Kaddo malee galma ijaaritattoki atetebaan: summa anke galma ani'a ijaaraaki gudeeda atikenaa'ni fulaake belto atiken.›<note caller="-" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="2SA 7:1-13">2 Sam. 7:1-13</ref>; <ref loc="1CH 17:1-12">1 Odo. 17:1-12</ref>. </char></note><verse eid="2CH 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 6:10" />«Duuchchi Woddiki Gootti hiyyemmaka hiyyichcho muxeen; aninna Duuchchi Woddiki Gootti hiyye addachiisemmashshanni anke annixxe Daawwitixxe bakka'n Isira'eelike moyanjo kadennen; Isra'eelike Duuchchi Woddike Gootta Magenike summi'a galma ijaarennen. <verse eid="2CH 6:10" /><verse number="11" style="v" sid="2CH 6:11" />Duuchchi Woddiki Gootti Isira'eelike ardi'a aagemmaxxi kako hexxeeka taaboota ookko giddo uggennen.»<verse eid="2CH 6:11" /></para>
  <para style="s1">Solomooni Duuchchi Woddike Goottibaa Soodateexxa Soodachcho</para>
  <para style="r">(<ref loc="1KI 8:22-53">1 Moy. 8:22-53</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 6:12" />Ookkoneechchi uduma Solomoon Isira'eeliki ya'i duuchchi hedheeba Duuchchi Woddike Goottike tolchimalchi edo anga farri asseexxi uurre. <verse eid="2CH 6:12" /><verse number="13" style="v" sid="2CH 6:13" />Solomooninna qeerrin onde ciqile ba'linni onde ciqile ejjuma sase ciqile kaddeexxa sageetotike qehphpinni gadhi darrexxe baxxexxe oddo'n giissiseemman; ookkone qephphpinni hana sa'exxinna Isira'eelike ya'i duuchchi edo gulufateexxi angatanna iimi'a farri asseexxi <verse eid="2CH 6:13" /><verse number="14" style="v" sid="2CH 6:14" />Isi hiyyee qici: «Ee Duuchchi Woddike Gootta Isira'eelike Magenoo mitte godobinni ora atike'n me'aake erganjuwwi atikinni welti jaalalatixxa atixxa kako heqqexxatoke iimate'ninna kadi buttate'n atishsha hedheeki Mageni hedhebaan. <verse eid="2CH 6:14" /><verse number="15" style="v" sid="2CH 6:15" />Erganjo atike anna anke Daawwiti'a hitetteka addachchiisatika hiyyichcho heqqiteetten: afo'i atikinni haasottettexxa telchonna anga atixxinni muxxetten.<verse eid="2CH 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 6:16" />«Ta'anna Isira'eelike Duuchchi Woddike Gootta Mageno eriganjo atikee anna anke Daawwiti'a, ‹Ati seera anka xexxe'achchoti heqqexxeteshshanni oose atixxinna seera anka heqqexxoole; atixxe sanne giddi'n Isira'eelixxe moote'n ani edo moyaka manjo hara gophphabexxoni hitee aaggetaxxa kako ta'a isi'a heqqi.›<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="1KI 2:4">1 Moy. 2:4</ref>. </char></note> <verse eid="2CH 6:16" /><verse number="17" style="v" sid="2CH 6:17" />Yooni ee Duuchchi Woddike Gootta Isira'eelike Magenoo, erganjo atike Daawwiti'a addachchiiseteka hiyyichcho atiki muuxemowwaal.<verse eid="2CH 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 6:18" />«Yaane kinn dhugaandinni Mageni manjiki welti buttate'n hedhaata? Kunn iimatinna iimatixxi iimuwwa midde atee abida dandeettabaani hittata ani ijaareneki kunni galm hara hittata shiixxedhata?<note caller="-" style="x"><char style="xo" closed="false">6:18 </char><char style="xt" closed="false"><ref loc="2CH 2:6">2 Odo. 2:6</ref>. </char></note> <verse eid="2CH 6:18" /><verse number="19" style="v" sid="2CH 6:19" />Kaddo malee ee Duuchchi Woddike Gootta anke Magenoo erganji atikixxa soodachchonna marartetee atiba shiqiseexxa kadha caqasi; garbichchi atiki ani ati edo oodha'ni soodatannexxa soodachchonna laqi. <verse eid="2CH 6:19" /><verse number="20" style="v" sid="2CH 6:20" />Summi atiki ye'emashsha haasotteteke konne galmibaa barranna hashsha ille atixxi uuddowwaali; erganji atik ani konne boncho'n soodatannexxa soodachcho laqi.<note caller="-" style="x"><char style="xo" closed="false">6:20 </char><char style="xt" closed="false"><ref loc="DEU 12:11">Lan. 12:11</ref>. </char></note> <verse eid="2CH 6:20" /><verse number="21" style="v" sid="2CH 6:21" />Atiki erganji aninna atiki ardi Isira'eeli konne boncho'n soodantaa wodda soodachcho no'oxxa laqi; galduma atike'n iimanni hexxe laqi; laqqenna gattowwaali hiyyi.<verse eid="2CH 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 6:22" />«Mitti manji jaalo ifika ballesseexxi kakataashsha laqemoole isinna dageexxi galm giddo hedheeke tolchimalchi edo kakatoole, <verse eid="2CH 6:22" /><verse number="23" style="v" sid="2CH 6:23" />Iimanni hexxe laqqe muri. Balleesanjiinxa balleessa umo isinge'n isixxa hiissite huje isixxishshanni isi'a uwwi; erganjuwwi atikixxe oddo'n iso'n muri. Qulichchi balleessa afebaake kadeexx ege'nishi; balleessa afebaakinna qullo fulaashsha assi.<verse eid="2CH 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 6:24" />«Ardi atiki Isira'eeli ate balleesatenaa'n kexxeexxa naaphi insa'ne injifatoolenna atibaa hingeexxi konne galm giddo ati edo soodachcho atibaa kadha shiqinsa'n summa atika ye'noole, <verse eid="2CH 6:24" /><verse number="25" style="v" sid="2CH 6:25" />Iimanni hexxetexxi laqi; atike ardixxa Isira'eelixxa cubbo gattowwaali hiyyi; insa'ne'anna annuwwa insa'neke uutettake bogibaa insa'ne hiissi.<verse eid="2CH 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 6:26" />«Ardi atiki ate balleessatenaa'n kexxeexxa; iimuwwa cufende'naa xeeni gana gophoole, ati insa'ne'n rakko geessissetaxxee konne boonchibaa wirri hine soodantoole; summa atika ye'noolenna cubbo hujatenaa'n ille iima hingoole, <verse eid="2CH 6:26" /><verse number="27" style="v" sid="2CH 6:27" />Iimanni hexxee laqi; erganjuwwa atike kadeekixxa atike ardixxa Isira'eelixxa cubbo gattowwaali hiyyi; he'naaka eloka ora insa'nee barachchiisi; arda atike geegoke kadaashsha uutettake boga'n xeena gansiisi.<verse eid="2CH 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2CH 6:28" />«Bogake'n solo'i, yookini dhukubi, yookaani waagge, midha gubaaki dhukubi, yookaan awwaaneessi yookaan koro'miisi dagaa wodda, yookaan higgeenni hoone qachcha'ninna he'ne'naa naaphi insa'nee buqaa wodda, yookaan fedheexxi rakko yookaan dhibemma wodda, <verse eid="2CH 6:28" /><verse number="29" style="v" sid="2CH 6:29" />arda atike Isira'eelinaa'n fedheeki manji yaaddonna elagonphe gelte'naa anga konne galmbaa farri asse soodata'n kadhatoole, <verse eid="2CH 6:29" /><verse number="30" style="v" sid="2CH 6:30" />iimate'n galduma atinge'n hexxe laqi; gattowwaalinna hiyyi; manjiinxa qalbe egendeteki atee calla kaddetaxxee mitte mittengee huje huje isixxishshanni uwwi; <verse eid="2CH 6:30" /><verse number="31" style="v" sid="2CH 6:31" />tinninna annuwwa no'oke uuttetake boga'n he'naa wodda duuchcha atee soodanto'anna oruwwa atike'n me'inaashshaten.<verse eid="2CH 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 6:32" />«Arda atike Isira'eelixxe sanne kadebaaki alagake kadeeki manji atike lumoke summi'a hunnameette atixxe angaxxeenna jabaaxxe atixxe hirrexxa laqeexxi bayyike boganaa'n dageexxi konne galmbaa soodata wodda, <verse eid="2CH 6:32" /><verse number="33" style="v" sid="2CH 6:33" />iima atinge galduma'n hexxe laqi; bogi duuchchiki ardi Isira'eeli atike ardishsha summa atika ege'ne atee soodantaashsha ijaarenneki konne mini summi atiki ye'emaake kadeexxa egenaashsha alagi manji atee laqedhachcho duuchcha assi.<verse eid="2CH 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2CH 6:34" />«Ardi atiki ati ergtattoke booncho duuchcha'n naapha insa'neka lolo'a fullaa wodda ati fi'liteteke konne qachchibaa aninna summa atike ijaarenneke konne galmbaa atiba atiba'a soodantoole, <verse eid="2CH 6:34" /><verse number="35" style="v" sid="2CH 6:35" />soodachcho insa'nexxanna kadha insa'nexxa iimanni hexxe laqi; atee laqe'naaxxa insa'ne'a assi.<verse eid="2CH 6:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2CH 6:36" />«Balleesabaaki mitti manjinna hedhebaani ate balleessinaa wodda mufattettexxi bayya yookaan shiqa hedheeke bogibaa booji'e adhdhe me'aake naaphinxe anga'n sa'isite insa'ne uutottole, <verse eid="2CH 6:36" /><verse number="37" style="v" sid="2CH 6:37" />booji'eme me'inemange ookkone boga'n he'ne qalbe insa'nexxe'n yaaddo laqende'naa aade angoolenna booji'emeeba he'ne, ‹Cubbo hunjeenneni, balleesineenneni, elobaxxa hujenna hunjeenneni› hinoole, <verse eid="2CH 6:37" /><verse number="38" style="v" sid="2CH 6:38" />booji'emme me'inemange boga'n he'ne mitte godobinni mitte yaadinni hingoolenna annuwwa insa'neke uutettake bogibaa ati fi'litettake qachchibaanna ani summa atike ijaarenneke galmbaa soodantoole, <verse eid="2CH 6:38" /><verse number="39" style="v" sid="2CH 6:39" />soodachcho insa'nexxanna kadha insa'nexxa iima galduma atinge'n hexxe laqi; ate laqe'neexxa insa'ne'a assi. Ate balleessemmakixxa ardi atikixxa cubbo gattowwaal hiyyi.<verse eid="2CH 6:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="2CH 6:40" />«Ta'aanna anke Magenoo konne booncho'n shiqqeexxe soodachchobaa ille atixxi uuddaaxxe mansha atixxinna laqqaaxxe kaddowwaal.<verse eid="2CH 6:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="2CH 6:41" />«Ta'anna ee Duuchchi Woddike Gootta Mageno ke'i; atixxe hunnake taabootinni welti hafuura adhdhitattake boonchibaa e'yi. Ee Duuchchi Woddike Gootta Magenoo, qeese atixxi anjira odo'witowwaali; woyyoole atixxinna atixxe elle'n gammaddowwaal.<verse eid="2CH 6:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="2CH 6:42" />Ee Duuchchi Woddike Gootta Magenoo hariirtetteka waaldoxxe; erganjo atike Daawwiti'a addachiissetexxa jabaxxa atixxa jaalala hedi.»<note caller="-" style="x"><char style="xo" closed="false">6:42 </char><char style="xt" closed="false"><ref loc="PSA 132:8-10">Far. 132:8-10</ref>. </char></note><verse eid="2CH 6:42" /></para>
  <chapter eid="2CH 6" />
  <chapter number="7" style="c" sid="2CH 7" />
  <para style="s1">Galmiinxa Eebisensha</para>
  <para style="r">(<ref loc="1KI 8:62-66">1 Moy. 8:62-66</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 7:1" />Moyanji Solomoon soodachcho muxxeexxa yanna giira iimi'n ibee ciincatika tolchanna wele tolcha itte; Duuchchi Woddike Goottiki ulfinni galmi giddo wo'me<note caller="-" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="LEV 9:23-24">Lew. 9:23-24</ref>. </char></note> <verse eid="2CH 7:1" /><verse number="2" style="v" sid="2CH 7:2" />Galmi Duuchchi Woddike Goottike gaachchanni wo'meemmaxxe qeese galmi giddi'a e'ya dandetebaan. <verse eid="2CH 7:2" /><verse number="3" style="v" sid="2CH 7:3" />Isira'eelito duuchchi giira iimi'n ibba'naa, Duuchchi Woddike Goottika gaachchanna galmi iima uuddeexxi ba'linnake'n gulufantteexxi, albiki butti'a gonbisemmeexxi sagande; hina'nina Duuchchi Woddike Gootti'a galata shiqinsee qici,</para>
  <para style="q1" vid="2CH 7:3">«Isi elokeni</para>
  <para style="q2" vid="2CH 7:3">jaalala isixxinna duuchchi woddi'a hexxaani»</para>
  <para style="q2" vid="2CH 7:3">hina'n Duuchchi Woddika Gootta galateefante.<note caller="-" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 Odo. 16:34</ref>; <ref loc="2CH 5:13">2 Odo. 5:13</ref>; <ref loc="EZR 3:11">Izr. 3:11</ref>; <ref loc="PSA 100:5">Far. 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Erm. 33:11</ref>. </char></note><verse eid="2CH 7:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="2CH 7:4" />Ookkoneechchi uduma moyanji Solomooninna ardi duuchchi Duuchchi Woddike Gootti edo tolcha shiqinse. <verse eid="2CH 7:4" /><verse number="5" style="v" sid="2CH 7:5" />Moyanji Solomooninna lame tommenna lame kuma jiboota, mitte dhibbanna lame tomme kuma re'enna gedhebo tolche; moyanjikinna ardi duuchchi konne qicini Mageniinka galma woyyoonsine. <verse eid="2CH 7:5" /><verse number="6" style="v" sid="2CH 7:6" />Qeesetinna uwwendeexxe bakka'ni uurrite; insa'ne edii'ni Leewwito uurriteexxi edi gama moyanji Daawwiti Duuchchi Woddiki Gootti saadatee la'onfatammaxxe faarotike miyinni «Jaalala isixxi duuchchi woddi'aten» Duuchchi Woddika Gootta saadde hina'ni faaroti isoo saandaamman. Qeeseetinna malagata ufuuffaa wodda Isira'eelito duuchcha uurriteemman.<verse eid="2CH 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 7:7" />Solomoon giissemmaki sageettotiki tolchimalcho ciincatika tolcha, midhatika tolchanna ha'yo abida dande'a gopheemmaxxe Duuchchi Woddike Goottike galm edi darre oddote'n hedheeke ba'liniinxa kuta garigariti asseexxi ciincatika tolchanna mitoomiinke tolchika ha'yo ookkoo ciinceesse.<verse eid="2CH 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 7:8" />Eettene yanna Solomoon Isira'eelike ardi duuchchinni welti torbaane barra ayyaana ulfeesse; ardikinna Hamaati'a me'inammake oribaa'n Gibtseke galaani qico'n hedheeke boganaa'n dageeke yo'oshsha bira sa'eeke tuutamman. <verse eid="2CH 7:8" /><verse number="9" style="v" sid="2CH 7:9" />Tolchimalcho Duuchchi Woddike Gootti'a foyatike seera'n torbaane barra sa'isine; wele torbaane barra ayyaana ulfeesina'n tureechchi uduma saddeetixxa barra'n ayyana muuxatika seera assine muunxe. <verse eid="2CH 7:9" /><verse number="10" style="v" sid="2CH 7:10" />Solomooninna torbake agenjixxe lame tommenna sakkaxxe barra'n ardi ifi ifinge minbaa me'ashsha asse; ardikinna Duuchchi Woddiki Gootti Daawwiti'ana Solomooni'a ittann Isira'eelike ardi'a assemmaxxe eloxxe yaane duuchchi'a qalbeti gamanda'n ililnsa'ni me'ine.<verse eid="2CH 7:10" /></para>
  <para style="s1">Duuchchi Woddik Gootti Solomooni'a Langaxxa Leelleexxa</para>
  <para style="r">(<ref loc="1KI 9:1-9">1 Moy. 9:1-9</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 7:11" />Solomoon Duuchchi Woddike Goottika galmanna mootemmatike minixxa huje bire; Duuchchi woddike Goottike galmi'anna ifike mootumatike mini'a hujo'a godobi giddo hedemmaxxa duuchhca muuxeechchi uduma. <verse eid="2CH 7:11" /><verse number="12" style="v" sid="2CH 7:12" />Duuchchi Woddiki Gootti iso'ni hashsha leelleexxi hiyyee qici:</para>
  <para style="pm" vid="2CH 7:12">«Soodachcho atixxa laqeennen; konne galma ani'a tolcha shiqqaaxxe bakka kaddaashsha fi'leennen.<verse eid="2CH 7:12" /></para>
  <para style="pm">
    <verse number="13" style="v" sid="2CH 7:13" />«Xeeni ganabaashsha iimuwwa cufeennele yookaan midha ito'a awwaanneessa ergannele yookaan dhukkuba anke arda'ni ibesanno wodda duuchcha, <verse eid="2CH 7:13" /><verse number="14" style="v" sid="2CH 7:14" />anke summini ye'emeeki ardi ifi salphisee soodatoole, aneenna harse hunjaammaxxe fuggoxxa huja waalloole ani iimanni hedhee laqannon; cubbo insa'nexxanna gattowwaali hiyyannoni; boga insa'neke'ninna midha missaashsha assannon. <verse eid="2CH 7:14" /><verse number="15" style="v" sid="2CH 7:15" />Ta'anna konne booncho'n soodanta'neexxa soodachchabaa ille anxi uuddaan; mansha anxininna laqannon. <verse eid="2CH 7:15" /><verse number="16" style="v" sid="2CH 7:16" />Summi ank duuchchi woddi'a kaba ye'emaashsha konne galma fi'leennen woyyoonseennen. Godobi ankinna ille anxi duuchchi wodda ookko hexxaan.<verse eid="2CH 7:16" /></para>
  <para style="pm">
    <verse number="17" style="v" sid="2CH 7:17" />«Anni atik Daawwiti assemmashsha atinna addatenshati ani'a ergatendottole, seeruwwa ankanna aada anxa heqqexxe ajajuwwa duuchcha muuxxottole, <verse eid="2CH 7:17" /><verse number="18" style="v" sid="2CH 7:18" />anna tike Daawwiti'ni, ‹Atixxe horte giddii'ni Isira'eeli moye galchaaka gophabexxon› hiyyee isi'a kakatennashshanni moote atixxa jabeessannon.<note caller="-" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="1KI 2:4">1 Moy. 2:4</ref>.</char></note><verse eid="2CH 7:18" /></para>
  <para style="pm">
    <verse number="19" style="v" sid="2CH 7:19" />«Yaane kinni ha'no ane hordofatenaa'n uduma uwweenneka seeranna ajajuwwa heqqedha gophphinoole, wele magenuwwanna ergatendinoolenna magenooffatonoole, <verse eid="2CH 7:19" /><verse number="20" style="v" sid="2CH 7:20" />eettene yanna ani ha'no'a uwweneke boganaa'ni ha'no goshannon; anke Saumma woyyeense konne galma waalannon; arda duuchcha edo mammaakendinaakenna oso'lichiinke assannon. <verse eid="2CH 7:20" /><verse number="21" style="v" sid="2CH 7:21" />Kunni galmi ta'a yo'oshsha ulfateeke kadoolenna isi birii'n sa'aaki duuchchi majani hiyyati, ‹Duuchchi Woddiki Gootti konne boga'ninna konne Galma'n mayee iitta hexxeexxa yaane asse?› hiyyaan. <verse eid="2CH 7:21" /><verse number="22" style="v" sid="2CH 7:22" />Ardikinna, ‹Duuchchi Woddik Gootti tenne ba'ne duuchcha insa'nenni geessiseechchi Gibtseke boganaa'n insa'nee fulchemmaka edika annuwwi insa'nekika Mageno waalleexxi wele magenuwwa hordonfemmaxxe magenoonfantemmaxxeenna ergatememmaxxeten› hine hiissinaan.»<verse eid="2CH 7:22" /></para>
  <chapter eid="2CH 7" />
  <chapter number="8" style="c" sid="2CH 8" />
  <para style="s1">Solomoon Hujeexxa Wele Hujuwwa</para>
  <para style="r">(<ref loc="1KI 9:10-28">1 Moy. 9:10-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 8:1" />Solomoon Duuchchi Woddike Goottika galmanna ifi'a mootommatika mine ijaarate'n lame tomme wogga bireechchi uduma, <verse eid="2CH 8:1" /><verse number="2" style="v" sid="2CH 8:2" />Iittanni moyanji Kiraami uwweemmaka qachchuwwa qammachcheexxi Isira'eelito giddo qubattaashsha asse. <verse eid="2CH 8:2" /><verse number="3" style="v" sid="2CH 8:3" />Ookkoneechchi uduma Solomoon Hamati Tsobak hiyyemaake boga'n duulexxi ifibaa hiissedhe. <verse eid="2CH 8:3" /><verse number="4" style="v" sid="2CH 8:4" />Qiilla gammoojje giddo hedhemmaka Tedimorika qachcha qammachche, edi wodda Hamati Sobati'n miyuwwa massecatika qachchuwwa duuchchanna ijaare. <verse eid="2CH 8:4" /><verse number="5" style="v" sid="2CH 8:5" />Iittanni Solomoon ali darrexxa Betihoroninna aadi darrexxa Beti Horoni kolifantaake qachchuwwa kadaashsha dalla'uwwa, huluwwatinna cufanuwwa afaashsha asse ijaare. <verse eid="2CH 8:5" /><verse number="6" style="v" sid="2CH 8:6" />Higgeenni Ba'ilati qachchanna miyuwiinke minika qachchuwwa duuchcha, sarageelluwwinna fadhadi hedha'neeka qachchuwwa duuchcha Iyyerusaalemi giddo, Liibanoosi gidonna isi galchammake boga duuchcha'n ijaare.<verse eid="2CH 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 8:7" />Isira'eelito kadebaaki kinn Hiititotenaa'n, Amooritotenaa'n, Feeriizitotenaa'n, Hiwaatotinaa'ninna Iyyaabusitotenaa'n gateeki ardi duuchchi, <verse eid="2CH 8:7" /><verse number="8" style="v" sid="2CH 8:8" />Isira'eelito shilte birtebaang bogake'n gateexxa ookkone mannixxa horte hunnatixxa huje hujaashsha Solomoon melee insa'nenna telchi qico'ni hujende'ni he'neen. <verse eid="2CH 8:8" /><verse number="9" style="v" sid="2CH 8:9" />Kaddo malee Solomoon huuni Isira'eelik manji garbake kade hunnatixxa huje hujaashsha assebaa; insa'ne loliinka manna, loliinke mannike ja'laabuwwika ajajalluwwa, sarageelluwwakanna sarageelluwwa oofammake mannika ajajalluwwamman. <verse eid="2CH 8:9" /><verse number="10" style="v" sid="2CH 8:10" />Konneeri giddii'n lame dhibbanna onde tomme manni moyanjo Solomoonike manna towatammake ja'laabuwwamman.<verse eid="2CH 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 8:11" />Solomooninna «Duuchchi Woddike Goottiki taabooti e'yeeki boonchi duuchchi woyyichchake kademmaxxee, are anxi Isira'eelike moyanjike Daawwitike mootommatike mine'n hedha hasissabaan» hiyyexxi Feri'onixxa belto Daawwitike qachchanaa'n ise'a ijaarisisemmake mootommatike minbaa alalle isee iyyedage.<verse eid="2CH 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 8:12" />Solomooninna galmiinxe baxxe edi darre giissisemmake Duuchchi Woddike Goottike tolchimalcho'n ciincatika tolcha Duuchchi Woddike Gootti'a shiqise. <verse eid="2CH 8:12" /><verse number="13" style="v" sid="2CH 8:13" />Muuse tolchi shiqaa qico ajajemma qicinni mitte mittende ayyaanuwwiinxe barra'n tinninna, Edike Sanbata Sanbata'n, haaroxxi baateke fulatike ayyaana'ninna sase woggatike ayyaana'n kunninna gamami e'yebaaxxe kebboka ayyaana'n, mayetike ayyaana'ninna fooqiinke ayyaanixxe yanna'n ciiccesemmaka tolcha Duuchchi Woddike Gootti'a shiqise.<note caller="-" style="x"><char style="xo" closed="false">8:13 </char><char style="xt" closed="false"><ref loc="EXO 23:14-17">Fula. 23:14-17</ref>; <ref loc="EXO 34:22-23">34:22-23</ref>; <ref loc="NUM 28:9">Lak. 28:9</ref>; <ref loc="NUM 29:39">29:39</ref>; <ref loc="LEV 16:16">Lew. 16:16</ref>. </char></note> <verse eid="2CH 8:13" /><verse number="14" style="v" sid="2CH 8:14" />Ifike Annika Daawwitika seera hordofati qeeseteenna huje qoqqodeexxi Leewwitotinna faaro akeekkaashshanna barra barratixxe huje'n qeese gargaraashsha ugge. Higgeenni Magenik manji Daawwiti ajajemmashshanni galmiinxa hula heqqammakiira gargariti hexxeexxa huluwwa heqqinaashsha kuta kuta'n ugge. <verse eid="2CH 8:14" /><verse number="15" style="v" sid="2CH 8:15" />Insa'nenna moyanjiinke miyuwwinke mininni welti hasissaaxxa yaanexxa qeesoleteenna Leewwitotee uwwemaaka ajaja gagami hineba'a.<verse eid="2CH 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 8:16" />Duuchchi Woddike Goottike galmixxi booso safendeexxe barranaa'n muuxendaa qico'ni Solomoonixxi huje duuchcha qajeelde; konne qicinni Duuchchi Woddike Goottike galmixxe huje muuxamii qico'n gelte.<verse eid="2CH 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 8:17" />Ookkoneechchi uduma Solomooni Eedoomike boga'n abbaayyatixxe gabala kaddeexxe Etiyooni Gabiri'anna Eelaati'a me'e. <verse eid="2CH 8:17" /><verse number="18" style="v" sid="2CH 8:18" />Moyanji Kiraaminna abbaayyatixxa me'a ege'neeka markaba oofaaka manna ajajaake ifike jalqabuwwinni welti markabuwwa isi'a erge; insa'nenna Solomoonike manninni welti mitteba hingee Ofiiri'a me'ine; ookko'ninna tommenna onde kuma kiilo saxxaaxxa worqe Solomooni'a aa'ne dange.<verse eid="2CH 8:18" /></para>
  <chapter eid="2CH 8" />
  <chapter number="9" style="c" sid="2CH 9" />
  <para style="s1">Mootitte Saaba Solemonii'i Uushshotee Marte</para>
  <para style="r">(<ref loc="1KI 10:1-13">1 Moy. 10:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 9:1" />Mootitte Saaba Solomoonixxe'e kulema'neeka mambe'iinka beekkuma duuchcha laqqee wodda jabaka qortumuwwa qorte isoo hega uuddo'a Iyyerusaalemi'a dagge. Isenna qimamuwwa, heddo worqenna hiri fiixxeexxa kino gaaluwwake'ni fe'exxe hedo ulfesemeeke mannini welt marte gelte. Isenna Solomooniba marteexxi godoba affeemmaka yaada farri assiteexxi iso'ni haasootte. <verse eid="2CH 9:1" /><verse number="2" style="v" sid="2CH 9:2" />Solomooninna ise qorteeka qortuma duuchcha hiisse; isinna hiissa gopheexxi mitte yaanenna hexxemmabaan. <verse eid="2CH 9:2" /><verse number="3" style="v" sid="2CH 9:3" />Mootitte Saabanna Solomoonika beekumanna ijaareka mootumatika mine, <verse eid="2CH 9:3" /><verse number="4" style="v" sid="2CH 9:4" />qorte'ni shiqa'neexxa ita, ja'laabuwwiinka ofo'lichcho, mini giddo ergatemaaka mannanna oddoonno insa'nexxa, booka ibisaaka mannanna oddonno insa'nexxa, ittanni Duuchchi Woddik Goottik galmi giddo shiqiseeka ciincatika tolchuwwa uuddexxi yo'oshsha mambe'a hite.<verse eid="2CH 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 9:5" />Isenna moyanji Solomooni hitee qici, «Huje atixxanna beekkumi atikixxee boga anke'ninni hedhenna wodda laqennexxi dhugaanden. <verse eid="2CH 9:5" /><verse number="6" style="v" sid="2CH 9:6" />Yaane kinn dage ille anxinni uudano qico'n ane'n kulleexxa amaneennabaan; dhugaandinni atike beekkumika gamisa midde ane'n kullebaan. Ani laqenneke gurri iimi gama yo'oshsha lummexxeetten. <verse eid="2CH 9:6" /><verse number="7" style="v" sid="2CH 9:7" />Duuchchi wodda ati edo uurreki beekkumiki wo'meeka atika haaso'a laqa'neeki ja'labuwwinna atiki erganjuwwi insa'nexxa wodo. <verse eid="2CH 9:7" /><verse number="8" style="v" sid="2CH 9:8" />Duuchchi Woddike Gootta atike Mageni edo moyanjoke kaddee mootattoshsha, ate'ni gammadeekinna mootete'n ate ofo'lisheeki Duuchchi Woddiki Gootti atik Mageni saademowwaal. Mageni atiki Isira'eeli'a afeexxe jaalalanninna duuchchi woddi'a insa'nee jabeesso'a afeexxe eeyyanaa'n kexxeexxa; qixxoomikinna qullumma bira saxxaashsha asitotaa ateee insa'ne'n mootonse» hite.<verse eid="2CH 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 9:9" />Ookkoneechchi uduma moyanjokee shoole kuma killo saxxeexxa worqe, yo'oshsha bira saxxeexxa qimamuwwanna hiri fiixeexa kino isi'a uute. Mootitte Saabanna Solomooni'a uutemaxxe qimamuwwashsha hexxeexxi qimamuwwa hara hexxemmabaan.<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="MAT 12:42">Mat. 12:42</ref>; <ref loc="LUK 11:31">Luq. 11:31</ref>. </char></note><verse eid="2CH 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 9:10" />Kiraamiki manninna Solomooniki manni woriqe Ofiirii'ni ittanni sandaalenna hiri fiixxeexxa kinuwwa iyyedange. <verse eid="2CH 9:10" /><verse number="11" style="v" sid="2CH 9:11" />Moyanjikinna sandaaletika haqichcho Duuchchi Woddike Goottike galmi'ana moyatike mini'a lekkatika hadhisanjo giissinaaka, ittanni faarsaleeyyetee masinqonna kiraara giissise. Ookkoneechchi uduma iitta fakkattaaxxi yaane Yihudiinke boga'n haranga uudendebaan.<verse eid="2CH 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 9:12" />Moyanji Solomoon mootite Saabaa hasseechchonna laqqeechcho duuchcha ise'a uwwe. Ise'a uwweexxi uwwanna ise iyyedaggemmaxxe uwwanaa'n saxxeexxemman. Ookkoneechchi uduma isenni welti googeesse dagemmake manninni welti ifike bogiba'a higge.<verse eid="2CH 9:12" /></para>
  <para style="s1">Solomoonixxa Durumma</para>
  <para style="r">(<ref loc="1KI 10:14-25">1 Moy. 10:14-25</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 9:13" />Solomoon wogga wogga'ninni adha'neexxe worqe lame tommenna sase kuma kiilomman. <verse eid="2CH 9:13" /><verse number="14" style="v" sid="2CH 9:14" />Kunninna lumolla daddaltonaa'ninna heenoxxe daddaltonaa'ni bukki hitammaxxe irbo gadhi darremman: ittanni Arabiinke boga'n hedheeki moyanjuwwi duuchchinna isike bogiki jalqaabuwwi Solomooni'a worqenna birre iyyedanga'nemman.<verse eid="2CH 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 9:15" />Moyanji Solomoon lumollamma lame dhibba wonte worqeti giissise; mitte mitte wonte'n ugginemmaxxi tummeexxi woriqe torbaane killomman. <verse eid="2CH 9:15" /><verse number="16" style="v" sid="2CH 9:16" />Iittanni sase dhibba shixxaramma wonte tummendeexxe worqenni giisse; tenne mitte mitte wonte'n uggineexxi tummeexxi worqe sase killomman. Moyanjiknna wontuwwa «Liibanoosike gongoma» hinaake moottumatike mini giddo ugge.<verse eid="2CH 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 9:17" />Ookkoneechchchi uduma moyanji arbiinxe issonni seesee ca'ite worqeni buqeexxi lumoxxa moote giisse. <verse eid="2CH 9:17" /><verse number="18" style="v" sid="2CH 9:18" />Iitti mootetinna jaane iimi'a da'matixxanna butti'a dirratixxa koobbo affeexxe kadda wodda, mooteti welti abidisemeeki worqeti giissemeeki lekkati hadhisanji hedhemman. Eettenne moote'ninna middii'ninna bita'i darrenaa'n irikotichcho affeexxe kaddaa wodda ookkone irikotichchi bira mitti mitti neeqiinxi misile uurritteemmani. <verse eid="2CH 9:18" /><verse number="19" style="v" sid="2CH 9:19" />Iittanni jaaniinxe koobbuwwa'n kasa kasake'n mitti mitti neenqiinxi misile urriteemman; mittenba tommenna lame neenqixxi misile urriteemman; tennee fakkataaxxa moote hoone bogixxe mootumma giissende egendebaan. <verse eid="2CH 9:19" /><verse number="20" style="v" sid="2CH 9:20" />Moyanji Solomoon ha'wammaki miyuwwi duuchchi worqeti giissinekemman; «Libanoosike gongoma» hiyyemmaake mootummatike mini giddo hedhemmaki miyuwwi duuchchi luqqitte worqenni giissendeemman; Solomoonike baro'n birreti sibilji la'o afebaachchishsha uudemaammaxxee birreti sibiljinni giissemeechchi mittichchinna hedhemmabaan. <verse eid="2CH 9:20" /><verse number="21" style="v" sid="2CH 9:21" />Moyanji Kiraamiki manni oofammaxxa Terseesi'a daddalakee me'itammaxxa markabuwwa afeemman; insa'nenna sase sase wogga'n mitte yanna worqe, birretika sibiljo, Aribiinxa isso, qamaluwwatanna galeduwwa abinda'n iyyedangaamman.<verse eid="2CH 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 9:22" />Moyanji Solomoon durummatinna kadi beekkumiki bogi duuchchike moyanjuwwa duuchchanaa'n caleekemman. <verse eid="2CH 9:22" /><verse number="23" style="v" sid="2CH 9:23" />Bogi duuchchik moyanjuwwi duuchchi Mageni isixxe qalbe giddo uggeeka beekkuma laqo'a Solomooninni welti afemo'a hasa'nemman. <verse eid="2CH 9:23" /><verse number="24" style="v" sid="2CH 9:24" />Wogga wogga'ninn isibaa dagaaki duuchchi birretika sibiljonnaa worqetika miya, seemma, loliinka miyuwwannaa qimamuwwa iittann fadhadiinxanna gaangetixxa uwwa isi'a iyyedanga'nemman.<verse eid="2CH 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 9:25" />Solomoon shoole kuma fadhadiinkanna sarageelluwwiinka galdumi mine afeemman; iittann isi hedha'neeke Iyyerusaalemike qachcha'ninna sarageelluwwiinke qachchuwwa'n tommenna lame kuma fadhado afeemman.<note caller="-" style="x"><char style="xo" closed="false">9:25 </char><char style="xt" closed="false"><ref loc="1KI 4:26">1 Moy. 4:26</ref>. </char></note> <verse eid="2CH 9:25" /><verse number="26" style="v" sid="2CH 9:26" />Isinna Efiraxxisike galananaa'n Filisixeemike bogi qico'n iittanni Gibtseke bogixxe gabala qico'n hedheeke moyanjuwwa duuchcha'n hana moye.<note caller="-" style="x"><char style="xo" closed="false">9:26 </char><char style="xt" closed="false"><ref loc="GEN 15:18">Dada. 15:18</ref>; <ref loc="1KI 4:21">1 Moy. 4:21</ref>. </char></note> <verse eid="2CH 9:26" /><verse number="27" style="v" sid="2CH 9:27" />Iyyerusaalemi giddo moyanjke birreti sibilji kinotishsha, birbirsiinxe haqqexxi bira sa'ne tullichchuwwiinke qarqara'n futi hiyyeenba latammake odi'ishshatemman. <verse eid="2CH 9:27" /><verse number="28" style="v" sid="2CH 9:28" />Solomooni'a Gibtse'nina wele boguwwa duuchchanaa'n fadhado iyyedanga'nemman.<note caller="-" style="x"><char style="xo" closed="false">9:28 </char><char style="xt" closed="false"><ref loc="LEV 17:16">Lew. 17:16</ref>. </char></note><verse eid="2CH 9:28" /></para>
  <para style="s1">Solomoonixxa Reyo</para>
  <para style="r">(<ref loc="1KI 11:41-43">1 Moy. 11:41-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 9:29" />Weli Solomoonixxi jirte safokenaa'ni muuxamii qico'ni wabeeka Naataanixxe jirtenaa'ni Seeloke bogike wabeek Akiya raaganna Isira'eelik moyanjo Iyyorbi'aamik barixxee mootummaninni welti abidise haaso'a'neek wabeekichcho Idoxxi waleella giddo borreessendeexxebaata? <verse eid="2CH 9:29" /><verse number="30" style="v" sid="2CH 9:30" />Solomooni Iyyerusaalemi ofo'lexxi Isira'eeli duuchcha'n shoole tomme wogga moye. <verse eid="2CH 9:30" /><verse number="31" style="v" sid="2CH 9:31" />Ookkoneechchi uduma isike edike annuwwishsha reye; anna ifike Daawwitike qachcha'n mogeme; belti isiki Roobi'aami isixxe bakka'n moye.<verse eid="2CH 9:31" /></para>
  <chapter eid="2CH 9" />
  <chapter number="10" style="c" sid="2CH 10" />
  <para style="s1">Isira'eeli Robi'ami'n Fuggoxxinni Kexxe</para>
  <para style="r">(<ref loc="1KI 12:1-20">1 Moy. 12:1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 10:1" />Isira'eelito duuchcha Roobi'aami moyanjoke assexxo'a Sekemi'a me'itemmaxxee isinna ookkoo me'e. <verse eid="2CH 10:1" /><verse number="2" style="v" sid="2CH 10:2" />Moyanjo Solomooni baqate Gibtse'a me'emmaki Nabaaxxiki belti Iyyorbi'aami tenne laqeexxi Gibtsee'n hige dage. <verse eid="2CH 10:2" /><verse number="3" style="v" sid="2CH 10:3" />Erginse Iyyorbi'aamii ye'isinse; ookkoneechchi uduma isinna Isira'eelito duuchcha Roobi'aamibaa marteexxi iso'n hitee qici, <verse eid="2CH 10:3" /><verse number="4" style="v" sid="2CH 10:4" />«Ann atiki no'o'n jabaxxa ba'o ba'iseemmani; ati kinni rakkisaaxxa hujennaa no'o'n ba'iseemmaka jabaka qanbara no'onaa'n shollishshottole no'onna ati'a hiremme gallannon.»<verse eid="2CH 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 10:5" />Robi'aminna «Sase barra uduma higgine anibaa amme» insa'ne'a hiyye. Tennexxee manni hige me'e.<verse eid="2CH 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 10:6" />Ookkoneechchi uduma moyanji Roobi'aami ann isiki Solomoon lubboti hedhema wodda isoo gorsitaammaxxa Isira'eelixxa geedhe mitteba bukki asseexxi insa'nee, «Konne ardi'a hiissichcho hiissonaa maa hitina'ne?» hiyye qore.<verse eid="2CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 10:7" />Insa'nenna isoo, «Konne ardi'a eloke kadde insa'ne gammachchiissottolenna eloka hiissichcho insa'ne'a hiissitottole duuchchi wodda ati'a hireme galaani» hine.<verse eid="2CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 10:8" />Yaane kinni Robi'aaminna kinn geedhe gorsiteeka gorsa gibeexxi ifixxi hirrinna isi'a ergatendammaxxa dargageeyye qodhdhe. <verse eid="2CH 10:8" /><verse number="9" style="v" sid="2CH 10:9" />Isinna insa'ne, «Ann atiki no'o'n ba'iseexxa ba'o no'onaa'n shollishi hiyya'neeke konne ardi'a ani'a gorstina'neeki gorsi maachcho? Maa hine hiissichcho insa'ne'a hiisinanno?» hiyye.<verse eid="2CH 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 10:10" />Isixxi Hiri'a dargageeyye hitee hiissichcho isi'a uutee qici, «Ate qoreeke ardi'a ‹Ann atiki no'o'n jabaxxa ba'o ba'iseeni; ati kinn ba'o no'onaa'n shollishshi› ate'e hiyya'nekeri'a hitato qici, ‹Anxe angaaki shuu'nichchi anke annike hidhi caala furidataan. <verse eid="2CH 10:10" /><verse number="11" style="v" sid="2CH 10:11" />Ann anki jabaka qanbara ha'non ba'iseeni; ani kinn bira sa'isse qanbara ha'no'n aurisannon; ann anki ha'no halangeti jadhafeeni ani kinni gaaddotishsha idditaaxxe halangenni ha'noo jadhafannoni.› »<verse eid="2CH 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 10:12" />Moyanji «Sase barra uduma higgine dagge» hiyyemmashshanni Iyyorbi'aaminna ardi duuchchi sase barra uduma Roobi'aamibaa hinge dange. <verse eid="2CH 10:12" /><verse number="13" style="v" sid="2CH 10:13" />Moyanjikinna geedhe gorsiteeka gorsa tuffateexxi insa'ne cee'ma'n hiissichcho insa'ne'a hiisse. <verse eid="2CH 10:13" /><verse number="14" style="v" sid="2CH 10:14" />Isinna dargageeyyetika gorsa adhdheexxi, «Ann anki ha'noo'n qanbara ha'uriseeni; ani kinn ha'no'n caala qanbara ba'isannon; ann anki ha'noo halangeti jadhdhafeeni ani kinni gaaddotishsha idditaaxxe halangenni ha'noo jadhafannoni» hiyye. <verse eid="2CH 10:14" /><verse number="15" style="v" sid="2CH 10:15" />Duuchchi Woddik Gootti Seeloo'ni dageeke wabeeka Akiya darree'n Naabaxxike belto Iyyorbi'aamixxee hiyyemaaki hiyyichchi muuxemmashsha Magenii darree'n murendemmaxxee moyanji ardi hiyyexxa laqebaan.<verse eid="2CH 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 10:16" />Isira'eeli duuchchi moyanji insa'ne hineexxa adhdha gibeexxa egennexxa yanna insa'nenna moyanjoke'n hinee qici,</para>
  <para style="q1" vid="2CH 10:16">«Daawwitinni welti no'o mayiinke qoobbo anfeenne?</para>
  <para style="q2" vid="2CH 10:16">Isseyyike beltinni maa mittooma anfeenne?</para>
  <para style="q1" vid="2CH 10:16">Tee Isira'eel ifi ifike duunkaanbaa higge!</para>
  <para style="q2" vid="2CH 10:16">Koo Daawwiti atinna mine atinga heqqedhi!»</para>
  <para style="m" vid="2CH 10:16">Tennexxee Isira'eeli duuchchi ifi ifinge minibaa higge.<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="2SA 20:1">2 Sam. 20:1</ref>. </char></note> <verse eid="2CH 10:16" /><verse number="17" style="v" sid="2CH 10:17" />Kaddo malee Yihudiinke qachchuwwa'n hexxammaxxa Isira'eeli moye galchammaki Roobi'aamindemman.<verse eid="2CH 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 10:18" />Moyanji Roobi'aami siso hujammake mannike akeekisanjo kademmaka Adoniraamini erge; Isira'eeli kinn kinjiki cancanqe iso shilte. Moyanji Roobi'aami kinni kadeenxa kadee ifika sarageella gulufeexxi Iyyerusaalemi'a baaje me'e. <verse eid="2CH 10:18" /><verse number="19" style="v" sid="2CH 10:19" />Tennexxee Isira'eeli techchi qico'n Daawwitixxe hortenaa'n gargari higgeeshshanni hexxeen.<verse eid="2CH 10:19" /></para>
  <chapter eid="2CH 10" />
  <chapter number="11" style="c" sid="2CH 11" />
  <para style="s1">Shamaya Haaso'eeka Raagiinka Hiyyichcho</para>
  <para style="r">(<ref loc="1KI 12:21-24">1 Moy. 12:21-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 11:1" />Roobi'aami Iyyerusaalemi geye wodda Isira'eeli loleexxi mootumma isi'a hiisino'a Yihudiinxe gosanaa'ninna Biiniyaamixxe sannenaa'n mitte dhibbanna saddeeta tomme kuma loliinka manna bukki asse.<verse eid="2CH 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 11:2" />Yaane kinn Duuchchi Woddike Goottiki hiyyichchi Mageniinke manjo'n Shamaya'n hiyyee qici, <verse eid="2CH 11:2" /><verse number="3" style="v" sid="2CH 11:3" />«Yihudiinke moyanjo'n Solomoonike belti'a Roobi'aami'anna Yihudinxenna Biniyamixxe gosa giddo hexxeexxe Isira'eel duuchchi'a hitatto qici; <verse eid="2CH 11:3" /><verse number="4" style="v" sid="2CH 11:4" />‹Duuchchi Woddiki Gootti insa'nee hiyya'nee qici; tinn yaane anibaa'n kaddeexxe kaddeemmaxxee dayyuwwa ha'nooka loldino'a ookko'a martinoqqe'e; ha'no mitti mittingi ifi ifike minibaa me'e› » hiyye. Tennexxee Duuchchi Woddike Goottike hiyyichcho'n ajajemati Iyyorbi'aamii lollo'a duula waalleexxi ille iima hinge.<verse eid="2CH 11:4" /></para>
  <para style="s1">Robi'aami Yihudika Qachchuwa Kollifachchotike Asse</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 11:5" />Roobi'aami galduma ifika Iyyerusaalemi giddo assedheexxi ifi iimi'n faachchefatatee kadaaka qachchuwwa Yihudiinke bogi giddo ijaadhdhe; kunni qachchuwwinna, <verse eid="2CH 11:5" /><verse number="6" style="v" sid="2CH 11:6" />Beetelihemi, Exaami, Tequhe, <verse eid="2CH 11:6" /><verse number="7" style="v" sid="2CH 11:7" />Betitsuuri, Sokko, Adulaami, <verse eid="2CH 11:7" /><verse number="8" style="v" sid="2CH 11:8" />Gaati, Meeriisa, Ziifi, <verse eid="2CH 11:8" /><verse number="9" style="v" sid="2CH 11:9" />Adoorayiimi, Lakishi, Azeeqa, <verse eid="2CH 11:9" /><verse number="10" style="v" sid="2CH 11:10" />Tsori'a, Ayyalooni, Kebirooniratemman. Yihudiinkenna Biiniyamike bogi giddo kolfatatiki qachchuwwi konneeratemman. <verse eid="2CH 11:10" /><verse number="11" style="v" sid="2CH 11:11" />Isinna konnee qachchuwwa'n kollo jabaxxa giisseexxi loliinke mannika ajajalluwwa mitte mittinge qachchi giddo ugge; konne qachchuwwi giddonna ita, Ejerisiinxa zayitenna woyinetixxa booka tuule. <verse eid="2CH 11:11" /><verse number="12" style="v" sid="2CH 11:12" />Isinna konnee qachchuwwa duuchcha'n wontetanna bagedo gureexxi qachchuwwi sodatemaashsha asse. Konne qicinni Yihudiinkanna Biiniyamika boga ifike assedhe.<verse eid="2CH 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 11:13" />Isira'eelike boga duuchcha'n hexxexxi qeesenna Leewwoti ifi ifike boga duuchchinaa'n isibaa dagge. <verse eid="2CH 11:13" /><verse number="14" style="v" sid="2CH 11:14" />Isira'eelik moyanji Iyyorbi'aamina oose isixxi; Leewwito Duuchchi Woddike Goottixxe qeesummatixxa huje hujjabaashsha hoyyinemmaxxee Leewwito hore alla'litaamma boonchonna karra ifixxa duuchcha waaldeexxi Yihudaa Iyyerusaalemi'a dagge. <verse eid="2CH 11:14" /><verse number="15" style="v" sid="2CH 11:15" />Iyyoribi'aminna tullichchuwwake'n magenoofachchotixxe boonchuwwa'ninna iittanni isi giissemaxxe re'etixxenna jabbetixxe fakkuwwaa ergatendaaxxa qeese ifi'aanni fi'leemman.<note caller="-" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="1KI 12:31">1 Moy. 12:31</ref>. </char></note> <verse eid="2CH 11:15" /><verse number="16" style="v" sid="2CH 11:16" />Mitte mittende Isira'eelike gosatike mininaa'n mitte godobinni Duuchchi Woddika Gootta Isira'eelika Mageno halseek duuchchi ifike edike annuuwwike Duuchchi Woddike Gootta Mageni'a tolcha shiqqishsho Leewwito hordonfeexxe Iyyerusaalemi'a me'e. <verse eid="2CH 11:16" /><verse number="17" style="v" sid="2CH 11:17" />Konne qicini Daawwitikanna Solomoonika ora hordofati sase wogaa Yihudiinxa mootumma jabeessine; Solomoonika belto Roobi'aaminna gargaarre.<verse eid="2CH 11:17" /></para>
  <para style="s1">Robi'aamika Mini Hado</para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 11:18" />Roobi'aami Mahalati aadhe; anni isekinna Daawwitike belto Yaarimuutite. Ama isexxinna Abihayil hiyyendaaxxe kaddaa wodda Isseyike beltika belto Eli'aabixxe beltomman. <verse eid="2CH 11:18" /><verse number="19" style="v" sid="2CH 11:19" />Mahaala'itinna Ye'ushi, Shemariyanna Zahami hinaaxxa labbaxxa oose isi'a ilde. <verse eid="2CH 11:19" /><verse number="20" style="v" sid="2CH 11:20" />Ookkoneechchi uduma Robi'aami Abeseloomixxa belto Me'aka aadhe. Isenna Abiya, Ataayii, Ziizanna Sheloomiti isi'a ilde. <verse eid="2CH 11:20" /><verse number="21" style="v" sid="2CH 11:21" />Roobi'aami ifixxe aruwwanaa'ninna shiixxaramma ifixxe aruwwanaa'n caala Abeseloomixxa belto Me'aaka'a eeyye. Roobi'aaminna mittenba tommennaa saddeeta aruwwanna jaane tomme shiixaramma aruwwa, lame tommenna saddeeta labbalonna jaane tomme dubara afe'eemman.<verse eid="2CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 11:22" />Roobi'aaminna Ma'ikaka belto Abiyaa moyanjo asso'a haseemmaxxe dayyuwwiinke umo akeekisanjo asse file. <verse eid="2CH 11:22" /><verse number="23" style="v" sid="2CH 11:23" />Isi beekkumi ifikinni labbaxxe oosenaa'n heenooxxa Yihudiinkena Biiniyaamike qachchuwwa'n iittanni kinjiinke dalla'inni buqemeeke qachchuwwa galchinashsha file. Insa'ne'a hasisaachcho bira sa'ise uwwe; heddo melaallena insa'ne'a aadhise.<verse eid="2CH 11:23" /></para>
  <chapter eid="2CH 11" />
  <chapter number="12" style="c" sid="2CH 12" />
  <para style="s1">Gibtseke Moyanji Iyyerusaalemi'a Duule</para>
  <para style="r">(<ref loc="1KI 14:25-28">1 Moy. 14:25-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 12:1" />Roobi'aamixxi mootumma jabaate isinna hunna alfitechchi uduma isinna Isira'eeli ardi duuchchi Duuchchi Woddike Goottika seera waale. <verse eid="2CH 12:1" /><verse number="2" style="v" sid="2CH 12:2" />Duuchchi Woddike Gootti'a xuurameessumma gophatenaa'n kexxeexxa Roobi'aami moyexxe ondixxe wogga'n Gibtseki moyanji Shishaaqi Iyyerusaalemii'i lole miidhe. <verse eid="2CH 12:2" /><verse number="3" style="v" sid="2CH 12:3" />Insa'nenni welti Gibtse'n dageeke ardik laakosi tommenna lame kuma loliinxi gaaruwwa, jaane tomme kuma fadhado gulufeeke mannik laakkossi konnete hine dandeennabaaka Libiyaka, Sukamikanna Tophiyiinke loliinka manna adhdhe dageexxi, <verse eid="2CH 12:3" /><verse number="4" style="v" sid="2CH 12:4" />moyanji Shishaaqi kinjinke dalla'ika Yihudiinka qachchuwwa anga ifixxe'ni ibirsedheexxi Iyyerusaalemi qico'n mare.<verse eid="2CH 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 12:5" />Ookkonneeechchi uduma wabeekichchi Shemmaya Roobi'aamibanna Shishshaqi sodaatee, Iyyerusaalemi bukki hiyyeeke Isira'eelike akeekisanjuwwiba'a mareexxi, «Duuchchi Woddiki Gootti hiyya'nee qici, ‹Ha'no ane'e waldineeni; tennexxee aninna Shishaqixxe anga'n ha'no'o waalenneni› » insa'ne'a hiyye.<verse eid="2CH 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 12:6" />Isira'eeliki akeekisanjuwwinna moyanji ifi salphinseexxi hinee qici, «Duuchchi Woddiki Gootti qulchaken» hine.<verse eid="2CH 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 12:7" />Duuchchi Woddiki Goottinna ifi salphinseexxa uudeexxa yanna; Duuchchi Woddiki Goottinna Shemayya'n hiyyee qici, «Balleessa ifixxa egene ifi salphinseemmaxxee insa'ne anjirannoni malee birabe'non; Shishshaqi insa'ne lola wodda; rake insa'ne anjirannon; Iyyerusaalemi mufe anxinni ganabe'non. <verse eid="2CH 12:7" /><verse number="8" style="v" sid="2CH 12:8" />Kaddo malee ani'a ergatemiyyonnaa wele bogike moyanjuwwi'a ergatemiyyotixxe oddo'n hexxeexxa gargarunte egenaashsha; Shishaqi'a hireme galaan» hiyye.<verse eid="2CH 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 12:9" />Gibtsek moyanji Shishshaqi Iyyerusaalemi lole wodda; Duuchchi Woddike Goottike galmanna mootumatike miinixxa karra duuchcha mulqedhe adhdhe Solomoon worqeti giissisemmaxxa wonte midde gattebaangi duuchchingi geechcho gudhdhe me'e.<note caller="-" style="x"><char style="xo" closed="false">12:9 </char><char style="xt" closed="false"><ref loc="1KI 10:16-17">1 Moy. 10:16-17</ref>; <ref loc="2CH 9:15-16">2 Odo. 9:15-16</ref>. </char></note> <verse eid="2CH 12:9" /><verse number="10" style="v" sid="2CH 12:10" />Moyanji Roobi'aaminna Shishaaqi adhdhemmaxxe wontexxa bakka, wele wonte sageettoti giissiseexxi; mootumatike minike dalla'ixxa huluwwa heqqammake mannike akeekisanjuwwa'n uwwe. <verse eid="2CH 12:10" /><verse number="11" style="v" sid="2CH 12:11" />Moyanji Duuchchi Woddike Goottike galmbaa me'a wodda duuchcha; hula heqqammakiiri wonte abixxine erqe kayyi'n iso'o qoqqonba'nemman. Ookkoneechchi uduma wontuwwa hula heqqammake heqqanjuwwixxe kuta'n hiissina'nemman.<verse eid="2CH 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 12:12" />Robi'am balleesse ifixxa ege'ne ifi salphisemmaxxee Duuchchi Woddiki Gootti aare isoo bakka balleesitebaang walde; tinninna Yihudake'n heeno'mitoolenna eloxxi yaane afendeemmaxxeeten.<verse eid="2CH 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 12:13" />Moyanji Roobi'aaminna jabaate ti'ni hiyye Iyyerussaalemi moye galcha'n ture; Isi moye wodda wogga isixxi shoole tommenna mitte woggamman. Duuchchi Woddike Goottiki summi ookkoo ye'emaashsha Isira'eelixxe gosa duuchchanaa'n fi'leeke Iyyerusaalemike qachcha'n ofo'leexxi tommenna torbaane wogga moye. Ama isixxi Na'imate hinaaxxe Amoonichchomman. <verse eid="2CH 12:13" /><verse number="14" style="v" sid="2CH 12:14" />Isinna Duuchchi Woddika Gootta halsate qalbe qophpheefata gopheemmaxxee fuggoxxa huje.<verse eid="2CH 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 12:15" />Moyanji Roobi'aami moyemmake baro'n hujeexxa hujuwwa duuchcha safokenaa'n muuxamii qico'n wabeek Shemaya borreesseeke jirtetike maxaafa'ninnaa leella udammake Addo borreesseemmake ilenshatixxe borrooxxe maxaafa'n afendaaan; Robi'amixxenna Iyyorbi'aamixxe oddo'n uurrabaake loli hedhemman. <verse eid="2CH 12:15" /><verse number="16" style="v" sid="2CH 12:16" />Roobi'aaminna ifike edike annuwwishshanni lummedhe; Daawwitike qachcha'n moyanjuwwiinke hirreessa'ni moogeme. Isixxe bakka'ni belti isiki Abiya moye.<verse eid="2CH 12:16" /></para>
  <chapter eid="2CH 12" />
  <chapter number="13" style="c" sid="2CH 13" />
  <para style="s1">Yihudaka Moyanjo Abiyya</para>
  <para style="r">(<ref loc="1KI 15:1-8">1 Moy. 15:1-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 13:1" />Iyyorbi'aami moyexxe tommenna saddeeta wogga'n Abiya Yihudiinke moyanjo kade. <verse eid="2CH 13:1" /><verse number="2" style="v" sid="2CH 13:2" />Iyyerusaalemi ofo'le sase wogga moye galche. Ama isixxi Mikaya hinaaxxenni, isenna Gebi'axxe gosanaa'n ilendeexxe Uuri'eelixxe beltomman.</para>
  <para style="p" vid="2CH 13:2">Abiyaxxenna Iyyorbi'aamixxe oddo'n loli hedhemman.<verse eid="2CH 13:2" /></para>
  <para style="s1">Abiyyaxxenna Iyyebamixxe Oddo'n kadeeka Lola</para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 13:3" />Abiya shoole dhibba kuma jajjaba loliinka manna adhdheexxi duula wodda Iyyorbi'aaminna saddeeta dhibba kuma jajjaba loliinka manna adhdhe fuleexxi heqqedhe.<verse eid="2CH 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 13:4" />Abiya tullichchuwwiinke Efireemike boga'n Tsimarayyimixxe kooba'n uurreexxi hiyyee qici: «Iyyorbi'aaminna Isira'eeli duuchchi hiyyaannexxa laqqe! <verse eid="2CH 13:4" /><verse number="5" style="v" sid="2CH 13:5" />Duuchchi Woddiki Gootti Isira'eeliki Mageni Daawwitinna horte isixxi Isiira'eeli'n duuchchi woddi'a mootaashsha maxinetixxe kako<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="ft" closed="false">Maxinetixxa kakoyyi diigendabaxxe kakoyoten. </char></note> aagexxa egendineba? <verse eid="2CH 13:5" /><verse number="6" style="v" sid="2CH 13:6" />Daawwitike beltike Solomoonike erganjo kadeemmaki Nabaaxxiki belti Iyyorbi'aami kinni gootta ifike'n Solomooni'n fuggoxxini ke'e. <verse eid="2CH 13:6" /><verse number="7" style="v" sid="2CH 13:7" />Solomooniki belti Roobi'aami oosumandinni hedhe'naa mittechcho assa dande'abaakanna insa'nenna ifi iimi'n hoyyedha dande'abaaxxe yanna'ni, woyi fulabaaki heenooki baashe mann qaraqare isike'ni bukki hinee, isixxe hunna iimi darrenna kande.<verse eid="2CH 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 13:8" />«Ta'anna ha'no Daawwitixxe hortexxe anga'n hexxeexxa Duuchchi Woddike Goottixxa mootumma ittisino'a heddineeni. Dhugaandinni hara lumoka sannachcha affineeni; ha'nooke magenuwwa kado'a Iyyorbi'aami worqeti giissemmaxxa worqetixxa jabbuwwa afineen. <verse eid="2CH 13:8" /><verse number="9" style="v" sid="2CH 13:9" />Yaane kinn Aaroonixxa horte qeesoletanna Leewwito shoritineexxi, weli bogik ardi assammaxxa duuchcha ha'noonna ifixxa qeesole fi'litineebata? Mitte jibichchanna torbaane gedhebiinxa korbeeyye adhdhexxi ifi woyyonse dagaaka futti hitineega manjo dharichcha magenuwwi'a qeesolete assitine balsitinaan.<verse eid="2CH 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 13:10" />«No'o'a kinn Duuchchi Woddiki Gootti Magenoken. Isoonna waalebe'no; Duuchchi Woddike Gootti'a ergatenshate'n hexxeexxi qeese Aaroonixxe horte kaddaa wodda insa'nee gargarata'neexxi Leewwitoten. <verse eid="2CH 13:10" /><verse number="11" style="v" sid="2CH 13:11" />Insa'nenna barra barra'ninni gorisanna galgala ciincatika tolchanna fooli gammachchisaaka hixaana Duuchchi Woddike Gootti'a shiqqinaan. Seeriinsha ca'a hiyyeeke beera'ni tolchinxa kebbo ugginaan; galgala worqeti gissineexxe torbaane dhanko'n hedheeka xassa xassinaan; no'onna Duuchchi Woddike Gootta no'oke Magenoka ajaja heqe'naanneni; ha'no kinn isoo waaldineeni. <verse eid="2CH 13:11" /><verse number="12" style="v" sid="2CH 13:12" />Mageni no'onni welti hedheeni; akeekisanji no'okinna isoten. Isixxi qeesolenna malagata abixxiteexxi loliinka hafura ha'no'a laqissaan. Koo Isira'eelike manna ha'noo'a qajeeldaan ha'noke annuwwik Duuchchi Woddike Gootti Mageninni welti lolendinoqqe.»<verse eid="2CH 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 13:13" />Eettene yanna'n Iyyorbi'aami sannachchiinka gamisa Yihudiink loliink manni udumi'n rinphe lolle miinaashsha asse; gatemmaki sannachchi isinni welti Yihudika sannachcha edi'n sa'ne lollaasha asse. <verse eid="2CH 13:13" /><verse number="14" style="v" sid="2CH 13:14" />Yihudiink mann ifixxa dowwe uunda wodda edi udumi'n buqemmeexxa uundeexxi; Duuchchi Woddike Goottibaa raarre. Qeesetinna malagata ufuuffe. <verse eid="2CH 13:14" /><verse number="15" style="v" sid="2CH 13:15" />Yihudiink mannina qonqo gikki asse geerare; iitti geerara laqende wodda Magenikinna Iyyorbi'aaminna Isira'eelika sannachcha duuchcha Abiyanna Yihuda edo lole. <verse eid="2CH 13:15" /><verse number="16" style="v" sid="2CH 13:16" />Isira'eelito Yihudiinke mann edii'n baajje. Magenikinna Isira'eeliito anga insa'nexxe'n sa'ise uwwe. <verse eid="2CH 13:16" /><verse number="17" style="v" sid="2CH 13:17" />Abiyanna isik sannachchuwwi Isira'eeli injifanteexxi insa'neka loliinka manna fuggo miine; tennenaa'n kexxeexxa Isira'eelike jajaba loliinke mann giddii'n onde dhibba kuma manna shinne. <verse eid="2CH 13:17" /><verse number="18" style="v" sid="2CH 13:18" />Ookkone lolake'ninna Isira'eeliki manni salphate. Yihudiinki manni kinni Duuchchi Woddika Gootta edike ifike annuwwike Mageno'n addanteemmaxxee injifate.<verse eid="2CH 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 13:19" />Abiyanna Iyyoribi'aamii'i shorreexxi Beetelika qachcha qarqarake'n hedheeke ola'ninni, Yishanayika qachcha qarqarake'n hedheeke olla'ninna Eefiroonika qachcha qararake'n hedheeke olla'ninna isinaa'n adhdhe. <verse eid="2CH 13:19" /><verse number="20" style="v" sid="2CH 13:20" />Iyyorbi'aaminna Abiya moyemmake baro'n langaxxa fuuqqi hiyya dandeebaan. Ookkoneechchi uduma Duuchchi Woddiki Gootti isoo qooma shiye.<verse eid="2CH 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 13:21" />Yaane kinn Abiya yo'oshsha jabaata'n dage; tommenna shoole melaalle aadhe lame tommenna lame labbaxxa oosenna tommenna jaane dubarra i'le.<verse eid="2CH 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 13:22" />Abiyake baro'n hujendeexxi huje; isi hujeexxina haaso'exxi duuchchi wabeeka Addoxxe jirteke maxaafa'n maxaafi giddo borreessendeexxen.<verse eid="2CH 13:22" /></para>
  <chapter eid="2CH 13" />
  <chapter number="14" style="c" sid="2CH 14" />
  <para style="p">
    <verse number="1" style="v" sid="2CH 14:1" />Moynaji Abiya edike ifike annuwishshanni lummedhe; Daawwitike qachcha'n moyanjuwwiinke hirreesa'ni moonge; belti isiki Aasa isixxe bakka'n moye. Aasa moyemmake baro'n tomme wogga qico'n nage'i afeme.<verse eid="2CH 14:1" /></para>
  <para style="s1">Yihudiinka Moyanjo Aasa'a</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 14:2" />Aasa Duuchchi Woddike Gootta isike Mageni edo eloxxanna qajeelto yaane asse. <verse eid="2CH 14:2" /><verse number="3" style="v" sid="2CH 14:3" />Isinna alagiinke magenuwwika tolchimalchuwwanna tullichchuwwa hanna hexxeemmaxxa magenoofachchotixxa bakkaara balleese; mageneefachchotika kinotika utuphuwwa diige. Asheerate hinaaxxe meyyaxxike mageni'a uurrinseexxa haqqichchixxa fakkuwwa kukkute hune. <verse eid="2CH 14:3" /><verse number="4" style="v" sid="2CH 14:4" />Isinna Duuchchi Woddika Gootta edike insa'neke annuwwika Mageno halsinaashsha, seerakanna ajajuwwa muunxaasha Yihudiinka arda ajaje. <verse eid="2CH 14:4" /><verse number="5" style="v" sid="2CH 14:5" />Isinna mitte mittenge Yihudiinke qachchuwwa tullichchuwwi hana magenoofachchotika boonchuwwanna hixaana gunbaaka tolchimalchuwwa balleesse; mootumma isixxinna isi galchammake baro'ni nage'a alfite. <verse eid="2CH 14:5" /><verse number="6" style="v" sid="2CH 14:6" />Bogake'n nage'i birasa'emaxxee Yihudake kinjiinke dalla'ika qachchuwwa ijaare. Duuchchi Woddiki Gootti nage'ik hedhaasha asseemaxxee baro isike'n isoo loleeki mittikinna hedhemmabaan.<verse eid="2CH 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 14:7" />Aasanna Yihudiinke ardi'a hiyyee qici, «Konne qachchuwwa ijaaro; xellephpho, cufanakanna danqarisanjo afeeka dalla'uwwa qariqarake'n giisinno. Duuchchi Woddika Gootta Mageno no'oka halsinennaxxee bogi ta'anna no'oken, no'onna isoo halsineennen; isinna duuchchinni darrenaa'n no'o hafuura adhdhiseen» hunjeexxi duuchchanna insa'ne'a kadde.<verse eid="2CH 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 14:8" />Aasa lumolamma wontenna bagedo abixxeeka sase dhibba kuma Yihudiinka loliinka manna iittanni shiixxaramma wontenna mogido abixxeeka lame dhibbanna saddeeta tomme kuma Biiniyaamika loliinka manna afeemman; kunni duuchchi jajjaba loliinke mannamman.<verse eid="2CH 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 14:9" />Zerahi hiyyemaak Tophiyiinki manji mitte miliyoone loliinka mannanna sase dhibba loliinka sarageelluwwa adhdheexxi Yihuda'a lolo'a Meeriisa qico'n dage. <verse eid="2CH 14:9" /><verse number="10" style="v" sid="2CH 14:10" />Aasanna isoo lolo'a fule; Mersha bira hexxeexxe Tsefataxxe dhooqa'n lolakee booncho abixxine.<verse eid="2CH 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 14:11" />Eettene yanna'n Aasa Duuchchi Woddike Gootta ifike Magenibaa hiyye soodatee qici, «Ee Duuchchi Woddike Goottaa gophaleeyye hunnameeyyetenaa'n gargaraaki atishsha hedheeki ayyinna hedhebaan; ee Duuchchi Woddike Gootta no'oke Magenoo ate'n addantennaxxena konne heddi loliinke manninni atike summinni lola inbaannen; ee Duuchchi Woddike Goottaa no'oki Mageni ateten; manji atee injifataakebaani.»<verse eid="2CH 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 14:12" />Duuchchi Woddiki Gootti Tophiyiinka loliinka manna Aasanna Yihudiinke manni edo gane. Tophphiyiinki mannina baaje. <verse eid="2CH 14:12" /><verse number="13" style="v" sid="2CH 14:13" />Aasanna isiki loliinki mann Giraari qico'n shorinshe. Tennexxee hiddi Tophiyiink manni<note caller="+" style="f"><char style="fr" closed="false">14:13 </char><char style="ft" closed="false">Ibritotike laadaginni </char><char style="fqa" closed="false">Tophphak hiyya </char><char style="ft" closed="false">Kushetike manna hiyyaten.</char></note> konne qicini Tophphiyiinki manni Duuchchi Woddike Gootti edonna isike loliinke mann edo munde. Yihudiinki manninna yo'oshsha bira saxxeexxa booji'o booji'e adhdhe. <verse eid="2CH 14:13" /><verse number="14" style="v" sid="2CH 14:14" />Giraari qarqara hedheeke qachchuwwa duuchcha'n Duuchchi Woddiki Gootti yo'oka alayyo ibiseemmaxxee qachcha duuchcha bakka balleesine; yo'oxxa booji'onna boojine. <verse eid="2CH 14:14" /><verse number="15" style="v" sid="2CH 14:15" />Iittanni hore alaldammaxxa alalisano lole miineexxi yo'oka gedhebo, re'enna gaaluwwa boojinee Iyyerusaalemi'a hinge.<verse eid="2CH 14:15" /></para>
  <chapter eid="2CH 14" />
  <chapter number="15" style="c" sid="2CH 15" />
  <para style="s1">Moyanji Aasa Asseexxa Haaronsa</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 15:1" />Mageniki haafuri Odeedike belto'n Azaariyasini'ni dirre. <verse eid="2CH 15:1" /><verse number="2" style="v" sid="2CH 15:2" />Azaariyasinna moyanjo Aasanni afemo'a mareexxi hiyyee qici, «Koo moyanjo Aasaa! Ani hiyyaannexxa! Ha'no Yihudiinkenna Biiniyaamiki mann duuchchi ani hiyyanexxa laqqe; ha'no Duuchchi Woddike Goottinni welti hexxinaa wodda isinna ha'nonni welti hedhaai; isoo halsitinaa wodda isinna ha'no'a afemaan; waldinoole kinn isinna ha'noo waalaan. <verse eid="2CH 15:2" /><verse number="3" style="v" sid="2CH 15:3" />Isira'eeliki ardi dhugaatike Mageni belo, barachchiisaake qeesichchi belonna seeri belo lumoka baro hedhaamman. <verse eid="2CH 15:3" /><verse number="4" style="v" sid="2CH 15:4" />Rakko insa'ne'n gelte wodda kinn Duuchchi Woddike Gootta Isira'eelike Magenbaa hingeexxi isoo halsineen; isinna afeme. <verse eid="2CH 15:4" /><verse number="5" style="v" sid="2CH 15:5" />Ookkone baro'n bogake'n hedhemmake duuchcha'n jabaxxi waakensha hexxemmaxxee nage'iki fulee nage'iki aagaaki hedhemmabaan. <verse eid="2CH 15:5" /><verse number="6" style="v" sid="2CH 15:6" />Mageni gargari hexxeexxe rakkonni insa'ne rakkisammaxxee mitte mootumma wele mootumma mitti qachchik ardi wele qachchika arda biraamman. <verse eid="2CH 15:6" /><verse number="7" style="v" sid="2CH 15:7" />Ha'noo kinni ha'nooxxe hujeka hira alfitinaammaxxee jabaatte, hujete'ni gooffinoqqe'e.»<verse eid="2CH 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 15:8" />Aasa konne hiyyichonna wabeek Odedik belti Azariyaas<note caller="+" style="f"><char style="fr" closed="false">15:8 </char><char style="fqa" closed="false">Odeedik belti Azaryaas </char><char style="ft" closed="false">Yookaan Odeed.</char></note> haaso'eeka raaga laqee wodda jabaate. Yihudiinke boga duuchchanaa'ninna Biniyamike boganaa'n Efireemike tullichchuwwa'n isi booji'e abixxemmake qachchuwwanaa'n diqachchiissaxxa fakkuwwa fugusse. Duuchchi Woddike Goottike galmi edo hedheeka Duuchchi Woddike Goottika tolchimalcho qammachche.<verse eid="2CH 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 15:9" />Duuchchi Woddik Gootti isik Mageni Aasanni welti hedheexxa uundeemmaxxee, Efireemixxe, Minaasexxenna Siimi'oonixxe gosanaa'ni heddi manni Aasaba dageexxi isike bogi giddo he'naamman. Aasanna kunni manni duuchchi iittanni Yihudiinkanna Biiniyaamika arda bukki asse.<verse eid="2CH 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 15:10" />Insa'nenna Aasa moyeexxe tommenna ondixxe wogga'n sakkake agenjo'n Iyyerusaalemi bukki hine. <verse eid="2CH 15:10" /><verse number="11" style="v" sid="2CH 15:11" />Eettene yanna'n boojine iyyedangeemmake hori giddii'n torbaane dhibba jiboota, torbaane kuma gedhebiinxanna re'etixxa korbeeyye Duuchchi Woddike Gootti'a tolchine. <verse eid="2CH 15:11" /><verse number="12" style="v" sid="2CH 15:12" />Insa'nenna Duuchchi woddika Gootta ifike edike annuwwika Mageno ifixxe mitte godobinninna shenitte hedho isoo halsino'a kako aange. <verse eid="2CH 15:12" /><verse number="13" style="v" sid="2CH 15:13" />Duuchchi Woddika Gootta Isira'eelika Mageno halsabaak duuchcha kinn shiixxokenna kado lumok, labbakenna kado meyyaxxa shiyyendaashsha kakante. <verse eid="2CH 15:13" /><verse number="14" style="v" sid="2CH 15:14" />Insa'nenna tennee lumoke haafuurinni ililinsa'n inbiltakanna malagata ufuunfa'n Duuchchi Woddike Goottike summinni kakante. <verse eid="2CH 15:14" /><verse number="15" style="v" sid="2CH 15:15" />Yihudiinki ardi duuchchi mitte godobinni kakateemaxxee gammande. Insa'nenna Mageno mitte godobinni halsine; isinna insa'ne'a leelle; tennexxee Duuchchi Woddiki Gootti insa'ne duuchchinn darrenaa'n nage'iki he'naashsha asse.<verse eid="2CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 15:16" />Iittanni moyanji Aasa akka'o ifixxa Ma'aka battondeexxe Asheera hiyyendaaxxe fakkeexxa sooddo uurrisseemmaxxee ballomiinxe bakkanaa'n isee hoyye. Aasanna sooddo eettene butuchche; buttuttemmaxxanna Qedironixxe dhooqa'n gube. <verse eid="2CH 15:16" /><verse number="17" style="v" sid="2CH 15:17" />Fedhexxinninna midde tullichchuwwake'n magenoofachchotike boonchuwwa duuchcha Isira'eeli giddii'n bayyiseba'a; kaddo malee Aasaxxi qalbe baro isike duuchcha'n hara Duuchchi Woddike Gootti'a hirendeexxemman. <verse eid="2CH 15:17" /><verse number="18" style="v" sid="2CH 15:18" />Isinna anni isik Magenokee woyyonsinemaka birreti sibljo, worqenna gargar gargar hedheeka miyuwwa duuchcha galmi giddo ugge.<verse eid="2CH 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 15:19" />Aasa moyexxe sase tommenna onde wogga qico'n bogake'n loli hedhemmabaan.<verse eid="2CH 15:19" /></para>
  <chapter eid="2CH 15" />
  <chapter number="16" style="c" sid="2CH 16" />
  <para style="s1">Aasaxxa Udumixxa Wogguwwa</para>
  <para style="r">(<ref loc="1KI 15:17-22">1 Moy. 15:17-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 16:1" />Aasa moyemmaxxe sase tommenna jaane wogga'n Isira'eeliki moyanji Ba'isha Yihudake'n duleexxi Yihudiinka moyanjo Asaxxe galchanaa'n ayyinna fulabaashsha, ayyinna ookko'a marabaashsha hoyyo'a Raamma'n kollifachcho giise.<verse eid="2CH 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 16:2" />Aasanna Duuchchi Woddike Goottike galmanaa'ninna ifike moyatomatike mi'yuwwa massatikenaa'n birretika sibiljonna worqe adhdheexxi Demasiqo ofo'le galchammake Sooriyake moyanji'a Beenihadadaa'a erge. <verse eid="2CH 16:2" /><verse number="3" style="v" sid="2CH 16:3" />Ookkoneechchi uduma «Bire anke annixxenna atike annixxe oddo'n hexxemmaxxi duuchcha telchonna anxenna atixxe oddo'n weli aggotika seera uggudhdhino; tennexxee Isira'eelik moyanji kunse birretika sibiljonna worqe ati'a ergeennen; anenaa'n udumi'a hige me'aashsha Ba'ishanni anixxe galcha giddii'ni fulchaasha anee gargaartatoshsha hiyye insa'nenni welti weli aaggetaxxa kako diigi» hiyye.<verse eid="2CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 16:4" />Beenihadaadi moyanjo Aasaka yaada adhdhe; isika loliinke mannika ajajalluwwa Isira'eelike qachchuwwa'n duulchise. Insa'nenna Iyyonii'i, Daanii'i, Abeeli Beeti Ma'iikanna Nefitaalemika miya masseccatika qachchuwwa duuchcha lolle injifante ifike asse'ne. <verse eid="2CH 16:4" /><verse number="5" style="v" sid="2CH 16:5" />Ba'isha tenne laqeexxa yanna Raama'n kollo ijaadhdhammaxxa waale; hujetanna oddonde'n uurrise. <verse eid="2CH 16:5" /><verse number="6" style="v" sid="2CH 16:6" />Moyanji Aasanna Yihudiinka manna duuchcha bukki asse iyyedage; insa'nenna Baa'oosi ijaarammaxxa kinona haqqe adhdhine; Aasana Geba'oonikinna Mitsiphaka qachcha ijaare.<verse eid="2CH 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 16:7" />Eettene yanna wabeeki Hanani Yihudiinke moyanjo Aasaba dageexxi hiyyee qici: «Duuchchi Woddika Gootta atika Mageno addata gibee Soriyake moyanjo'n addattettaxxee Sooriyake moyanjiki loliinki manni anga atixxenaa'n fuleen. <verse eid="2CH 16:7" /><verse number="8" style="v" sid="2CH 16:8" />Tophiyiinkinna Libiyaki ardi heddo laakkossika loliinka sarageelluwwanna fadhiki welti jajjabi loliinki mann hedhemmabaata? Kaddo malee Duuchchi Woddike Gootta'n addattettaxxee insa'nee anga atixxe'n sa'ise uwween. <verse eid="2CH 16:8" /><verse number="9" style="v" sid="2CH 16:9" />Mitte godobinni iso'n addataakaara jabeessatee Duuchchi Woddike Goottixxi ille butta duuchcha uuddaaxxen. Ati gowwummatixxa huje hujjettaxxee konneechchinni edi'a loli atenaa'n ke'abaan.»<verse eid="2CH 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 16:10" />Tennenaa'n kexxeexxa Aasa wabeekake'n mufate; yo'oshsha aaremmaxxee isoo usursise. Eettene yanna'ninna Aasa mitte mitte manna miice.<verse eid="2CH 16:10" /></para>
  <para style="s1">Aasaxxe Moottumaxxa Muuxensha</para>
  <para style="r">(<ref loc="1KI 15:23-24">1 Moy. 15:23-24</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 16:11" />Aasa moyemmake baro'n ke'itokenaa'n muuxamii qico'n hujendeexxi huje Yihudiinkenna Isira'eelike moyanjuwwike jirtetike maxaafa'n borreessendeen. <verse eid="2CH 16:11" /><verse number="12" style="v" sid="2CH 16:12" />Aasa moyexxe sase tommenna sallanixxe wogga'n jaba qicini lekka ela gophe; ela gonphe iso'n jabatoolenna midde tenne ela gonphe giddo ci'leeyye malee Duuchchi Woddike Goottika gargaarsa halsebaan. <verse eid="2CH 16:12" /><verse number="13" style="v" sid="2CH 16:13" />Aasanna shoole tommenna mitte wogga moye reye; isike edike annuwwishshanni reye. <verse eid="2CH 16:13" /><verse number="14" style="v" sid="2CH 16:14" />Rensha isika gargari hexxeexxa qimamuwwanninna yo'osha fishshitaaxxa shittoki fooli hedheexxe rare'n uggine; isi ifi'anni Daawwitike qachchi giddo kino bocise ifi'a giissedheeke hirreessa'n isoo masine. Isike ulfini'a haqqe tuulle giira ha'inshe.<verse eid="2CH 16:14" /></para>
  <chapter eid="2CH 16" />
  <chapter number="17" style="c" sid="2CH 17" />
  <para style="s1">Yihudiinka Moyanjo Iyyosaafixii'i</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 17:1" />Iyyosafixxi ifike annixxe Aasaxxe bakka'n moye; Isira'eel lolo'a ifi jabeessedhe. <verse eid="2CH 17:1" /><verse number="2" style="v" sid="2CH 17:2" />Isinna kinjiinke dalla'inni ijaaremeeke Yihudiinke qachchuwwi duuchchi giddo loliinka manna ugge; iittanni Yihudiinke boga'ninna ann isiki Aasa lole ifitti hiisedhemmake Efireemike qachchuwwa'n heqqaaka manna ugge.<verse eid="2CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 17:3" />Oosumandenaa'n ann isiki Daawwiti me'emmaka eloka ora me'emmaxxee Duuchchi Woddik Gootti Iyyosafixxinni welt hedhemman; isinna Ba'aali hiyyemaaka magenuwwa magenoofatebaan. <verse eid="2CH 17:3" /><verse number="4" style="v" sid="2CH 17:4" />Yanne kinn Iyyosaafixi ifike annike Magenika ajajuwwa heqqedhe; Isira'eeli hujjammaxxa fuggoxxa huje hujebaan. <verse eid="2CH 17:4" /><verse number="5" style="v" sid="2CH 17:5" />Duuchchi Woddiki Gootti motumma isixxa jabeesse; Yihudiinki ardi duuchchi Iyyosafixxi'a gargar gargar hexxeexxa uwwa iyyedage; tennenaa'n kexxeexxa yo'oshsha duroome ulfeeseme. <verse eid="2CH 17:5" /><verse number="6" style="v" sid="2CH 17:6" />Isinna mitte godobinni Duuchchi Woddike Goottike ora'n me'e; iittanni magenoofachchotika tullichchuwwanna Ashera hiyyemaake magenixxa soodduwwa Yihudiinke boganaa'n fugusse.<verse eid="2CH 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 17:7" />Iyyosafixxi moyeexxe sakkaxxe wogga'n Yihudiinke qachchuwwi giddo barachchiinso'a ja'laabuwwa ifika Beenihayili, Abidiyaasinii, Zakaariyaasii, Naatina'eelinna Mikayya erge. <verse eid="2CH 17:7" /><verse number="8" style="v" sid="2CH 17:8" />Insa'nenni welti Leewwito hexxemman; summi insa'nekinna Shamaya, Nataniya, Zebadiya, Asaheeli, Samiramoti, Yoonataani, Adooniya, Xoobiyanna Xoobadoniyatemman. Qeesenna kinn Elishaama'inna Iyyoramitemman. <verse eid="2CH 17:8" /><verse number="9" style="v" sid="2CH 17:9" />Insa'nenna Duuchchi Woddike Goottika seeriinka Maxaafa adhdhine me'ineexxi Yihudiinke boga'n hedheeke ardi duuchchi'a barachchiinse; Yihudiinke qachchuwwa duuchcha'n mammaremma'n arda barachchiinse.<verse eid="2CH 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 17:10" />Duuchchi Woddik Gootti Yihudiinke bogi qarqara'n hedheeki moyanjuwwi duuchchi soda'a wocci asseemmaxxee Iyyosafixxii'i lolebaan. <verse eid="2CH 17:10" /><verse number="11" style="v" sid="2CH 17:11" />Filisixeemike mannanaa'n mitti mitti birretika sibiljonnaa wele uwwa moyanjo Iyyosafixxi'a iyyedange; Arabikinna torbaane tomme kumanna torbaane tomme dhibba gedhebiinxa korbeeyyenna torbaane tomme kumanna torbaane dhibba re'etixxa korbeeyye isi'a iyyedange.<verse eid="2CH 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 17:12" />Iyyosafixxinna hunna lephpha'n dage; Yihudi giddonna kolluwwatanna miyiinxe massecaka qachchuwa ijaare. <verse eid="2CH 17:12" /><verse number="13" style="v" sid="2CH 17:13" />Yihudiinke qachchuwwa'n yo'oxxi gala'uwwa heddo loliinki miyuwwi hedhemman. Higgeenni adhe muuxeeka loliinka manna Iyyerusaalemi ugge. <verse eid="2CH 17:13" /><verse number="14" style="v" sid="2CH 17:14" />Insa'nenna ifi ifike mini mini hadi borreessemee qici konneechchi butta hedheeshshate; Yihudiinxxe horitexxe gosanaa'n filemeeke kuma loliinka manna ajajammak Adina hiyyemaak loliink ajajal hedhemman; isi sase dhibba kuma loliinka manna ajajaamman.<verse eid="2CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 17:15" />Iso'n itti aaneeki ajajjalli Yehohanaani ifike lame dhibbanna saddeeta tomme kuma loliinka manninn welt, <verse eid="2CH 17:15" /><verse number="16" style="v" sid="2CH 17:16" />ookko'n itti aaneexxi Duuchchi Woddike Gootti'a ifi uwweeke Zikiriki belti Amaasiyaasi ifike lame dhibba kuma loliinke manninni welt, <verse eid="2CH 17:16" /><verse number="17" style="v" sid="2CH 17:17" />Biniyamixxe gosanaa'n filemeeke loliinke manni'a umoke kadeeki ajajjalli Eliyaadaa'i hiyyemaaki janna loliinke manjommani; isinni welti wontetanna mogido abixxeemmak lami dhibbi kumi loliinke manninni welt, <verse eid="2CH 17:17" /><verse number="18" style="v" sid="2CH 17:18" />isinaa'n itti aaneexxi Zabaati hiyyemaaki loliinke mannki ajajjalli lolake qophphefateeke mitte dhibbanna saddeeta tomme kumi loliink manninni welt hedhemman. <verse eid="2CH 17:18" /><verse number="19" style="v" sid="2CH 17:19" />Kunni duuchchi Yihudiinke boga duuchcha'n kinjiinke dalla'inni ijaaremeeke qachchuwwa'n moyanjokee ergatemaammake mannamman.<verse eid="2CH 17:19" /></para>
  <chapter eid="2CH 17" />
  <chapter number="18" style="c" sid="2CH 18" />
  <para style="s1">Mikayya Aki'abi'n Raaga Haaso'e</para>
  <para style="r">(<ref loc="1KI 22:1-28">1 Moy. 22:1-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 18:1" />Iyyosafixxi lumoxxa karranna ulfinna alfeexxa yanna Isira'eelike moyanjinni Aki'aabinni welti balloome. <verse eid="2CH 18:1" /><verse number="2" style="v" sid="2CH 18:2" />Shiixxoxxe wogguwwa uduma Iyyosaafixi Aki'abi'i uudo'a Semaariya'a dirre. Aki'aabinna isi'anna isinni welti hedhemmake ardi'a heddo gedhebonna lalo dule; ookkoneechchi uduma Gele'adi Raamotika qachcha lole miidhaashsha Iyyosaafixii'i malche. <verse eid="2CH 18:2" /><verse number="3" style="v" sid="2CH 18:3" />Isira'eeliki moyanji Aki'aabinna Yihudiinka moyanjo Iyyosafixxi'i «Raamoti'i Gele'adika lolatee anini welti dulidato?» hiyye qore.</para>
  <para style="p" vid="2CH 18:3">Iyyosafixxinna iso'n «Atete hiyya anten, arda anke hiyya atike ardan; bagedo weltinni duullannon» hiyye hiisse haaso'e. <verse eid="2CH 18:3" /><verse number="4" style="v" sid="2CH 18:4" />Yaane kinni Iyyosafixxi Isira'eelika moyanjo, «Edissetexxi kinn Duuchchi Woddike Goottixxa fedhi laqedhi» hiyye.<verse eid="2CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 18:5" />Tennexxee Isira'eelik moyanji shoole dhibba wabeeko mitteba bukki asseexxi «Raamoti Gele'adi lolatee maranno mo'o waalanno?» hiyye insa'nee qore.</para>
  <para style="p" vid="2CH 18:5">Insa'nenna «Mageni atee moyanjiinxe anga'n sa'isse uwwamaxxee marte loli» hine hiissine haasonne.<verse eid="2CH 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 18:6" />Iyyosafixxinna kinn «Weli qodhdhinnannoki Duuchchi Woddike Goottiki wabeek kaba hedhebaa?» hiyye.<verse eid="2CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 18:7" />Isira'eeliki moyanji Iyyosafixxii'n, «Duuchchi Woddike Goottixxa fedhi qodhdhinannoki mitti wabeeki ta'a kaba hedheeni; yaane kinni duuchchi wodda isi ani'a elobaaka malee eloka raaga ani'a haaso'ammabaaxxee isoo gibannon; isinna Yimilake belto Mikayaasiten» hiyye hiisse haaso'e.</para>
  <para style="p" vid="2CH 18:7">Iyyosafxixinna isoo «Ati moyanji iitta hiyya hasissabaan» hiyye.<verse eid="2CH 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 18:8" />Isira'eeliki moyanjinna ja'laabuwwakenaa'n mitte ye'exxi «Martetexxi Yimilaka belto Mikayaasii rakke aaxxe iyyedagi» hiyye.<verse eid="2CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 18:9" />Eettene yanna lamiingi moyanjuwwi ifi ifixxa motummatixxa seemma odo'weexxi Semaariyake dalla'ixxe hula bira gadhi darree'n hexxeexxe aldu'me hana ifi ifixxe moote'ni ofollee'naa iitti wabeeko duuchchi insa'ne edo raaga haassotaamman. <verse eid="2CH 18:9" /><verse number="10" style="v" sid="2CH 18:10" />Kene'anaaki belti Sedeqiyaasinna sibiljiinka gaafuwwa giissexxi Aki'abi'n, «Duuchchi Woddiki Gootti hiyya'nee qici, ‹Sooriyaka manna ati konne gafuwwinni otta'n birtatoni› hiyya'neni» hiyye.<verse eid="2CH 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 18:11" />Wele wabeeko duuchchi «Duuchchi Woddiki Gootti Raamoti Gele'adii anga atixxe'n sa'ise uwwammaxxee martetexxi loli» hita'n weli fakkataaka raaga raanga'nemman.<verse eid="2CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 18:12" />Mikayaasii ye'o'a maremmaki erganji; «Kunse wele wabeeko mitte afo'o kaddee moyanjio Aki'abi lole injifataaxxa kulaaka raaga haasote'een atinna insa'ne hineeshshanni hiyyi; moyanjo gammachchisaaka haaso'a haaso'i» hiyye.<verse eid="2CH 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 18:13" />Mikiyaas kinn «Hadaak Mageni ege'neexxa! Duuchchi Woddiki Gootti hiyyeexxa calla haaso'annon» hiyye kakate.<verse eid="2CH 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 18:14" />Mikiyaasinna ookko geyeexxa yanna moyanji isoo, «Koo Mikiyaas, Raamoti Gele'adi'i maree lolanno moo waalano?» hiyye qore.</para>
  <para style="p" vid="2CH 18:14">Isinna «Maritine lolle injifatinaani; insa'ne anga ha'nooxxe'n sa'isemmee uwwemmaani» hiyye hiisse haaso'e.<verse eid="2CH 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 18:15" />Moyanji Aki'abinna iso'o, «Dhugaa malee mittechchonna Duuchchi Woddike Goottike summinni ane'n haasotabexxoshsha me'e yanna atee kakachchiisa'n hedhano?» hiyye.<verse eid="2CH 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 18:16" />Ookkoneechchi uduma Mikiyaasi «Isira'eeli duuchchi allalisanjo afebaake gedhebishsha koobuwwate'n xexxeerendee'naa uudenneni; Duuchchi Woddiki Goottinna ‹Kunni mann akeekisanjo afebaan; mitti mittingi ifi ifike minibaa nage'iki higowwaali› hiyyeeni» hiyye hiisse haaso'e.<note caller="-" style="x"><char style="xo" closed="false">18:16 </char><char style="xt" closed="false"><ref loc="NUM 27:17">Lak. 27:17</ref>; <ref loc="EZK 34:5">Hiz. 34:5</ref>; <ref loc="MAT 9:36">Mat. 9:36</ref>; <ref loc="MRK 6:34">Mar. 6:34</ref>. </char></note><verse eid="2CH 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 18:17" />Isira'eeliki moyanji Aki'abinna Iyyosafixxii'i, «Isi ani'a fuggoxxa malee eloka raaga haaso'abaaxxa ate'n haaso'enabaa?» hiyye.<verse eid="2CH 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 18:18" />Mikiyaasinna lebe hiyyee qici, «Yooni Duuchchi Woddiki Gootti hiyya'nee qico laqi; Duuchchi Woddiki Gootti moote ifixxe'n ofo'le'naa iimatiki sannachchuwwi duuchchi isike midda'nina bita'ake'n uurree'naa uudennen. <verse eid="2CH 18:18" /><verse number="19" style="v" sid="2CH 18:19" />Duuchchi Woddiki Goottinna hiyyee qici, ‹Isira'eeliki moyanji Aki'aab Raamoti Gele'adi'ni duuleexxi ookkoo reyashsha ayyete isoo dedhisaaki?› hiyye.</para>
  <para style="p" vid="2CH 18:19">«Mitti mitte yaada shiqishe; weliknna wele yaada shiqishe. <verse eid="2CH 18:19" /><verse number="20" style="v" sid="2CH 18:20" />Udumi giddii'n mitti haafuuri edi dagati Duuchchi Woddike Gootti edo uurreexxi ‹Ani isoo dedhisannoni› hiyye.</para>
  <para style="p" vid="2CH 18:20">«Duuchchi Woddiki Goottinna ‹Hitta assitee dedhisaatto?› hiyye isoo qore.<verse eid="2CH 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 18:21" />«Iikki hafuurinna, ‹Ani marennexxi Aki'abixxi wabeeko duuchchi dhara haasottaashsha assannon› hiyye.</para>
  <para style="p" vid="2CH 18:21">«Duuchchi Woddiki Goottinna ‹Yooni martetexxi isoo dedhisi ati'a qajeldaan› hiyye.<verse eid="2CH 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 18:22" />«Tennexxee ta'anna tennee wabeekoke afo'o'ni Duuchchi Woddiki Gootti dharichcha hafuura uggeeni; Duuchchi Woddike Gootti ba'ne ate'n geltaashsha ajajeedheen.»<verse eid="2CH 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 18:23" />Ookkoneechchi uduma Kene'anaki belti Sedeqiyaasi, biri'a shikki hiyye Mikiyaasii'i kabalati, «Haanichchinni kayyi'aate Duuchchi Woddike Goottiki hafuuri ane'naa'n sa'eexxi ate'n haaso'eek?» hiyye.<verse eid="2CH 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 18:24" />Mikiyaasinna, «Goli giddi'a e'yite sho'ondattoxxa eettene barra affatoni» hiyye hiisse haaso'e.<verse eid="2CH 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 18:25" />Ookkoneechchi uduma Isira'eeliki moyanji hiyyeexxi ajajee qici, «Mikiyaasii'i abidineexxi ookkene qachchika galchallo, Amoninbaanna moyanjink belto Iyyo'aasibaa ille iimma hiissitine erge. <verse eid="2CH 18:25" /><verse number="26" style="v" sid="2CH 18:26" />Insa'neenna, ‹Moyanji, konne manjichcho usuriinke mine'n e'yishe; ani duulokenaa'n nage'iki ille iima higanno qico'n bagoka budeenanna wode'e malee mittechchonna isi'a uutinoqqe'e hiyye'eeni› hiyye.»<verse eid="2CH 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 18:27" />Mikiyaasina, «Ati duulokenaa'n nage'iki ille iima higotole Duuchchi Woddiki Gootti ane'n haaso'ebaani hiyyateni!» hiyye. Higgeenni «Ha'no Kaba hexxineeki ardi duuchchi hiyyennexxa laqqe» hiyye.<verse eid="2CH 18:27" /></para>
  <para style="s1">Aki'abixxa Reyo</para>
  <para style="r">(<ref loc="1KI 22:29-35">1 Moy. 22:29-35</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="2CH 18:28" />Tennexxee Isira'eeliki moyanjinna Yihudiinki moyanji Iyyosafixxi Raamoti Gele'adi'a qabante. <verse eid="2CH 18:28" /><verse number="29" style="v" sid="2CH 18:29" />Isira'eeliki moyanjina moyanjo Iyyosafixxii'n, «Ani wele seemma jijjiidhennexxi loli giddi'a e'yannon; ati kinni mootummatixxa seemma oddo'wi» hiyye.</para>
  <para style="p" vid="2CH 18:29">Tennexxee Isira'eeliki moyanji wele seemma jijjiidhe wele manjo fakkaateexxi bagediinbaa e'ye.<verse eid="2CH 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2CH 18:30" />Eettene yanna'n Sooriyaki moyanji ifike sarageella ajajamakaara, «Isira'eelika moyanjo calla malee shiixxokanna kadi lumoka wele ayyeenna loldinoqqe'e» hiyye insa'nee ajaje. <verse eid="2CH 18:30" /><verse number="31" style="v" sid="2CH 18:31" />Iikki sarageella ajajammakiirinna Iyyosafixxii'i uunde wodda, «Isira'eeliki moyanji konneten» hineexxi hende; isoonna shinno'a elqe kayyii'n bunqe; Iyyosaafixi kinni raare; Duuchchi Woddiki Goottinna isoo gargaare; Magenikinna isonaa'n insa'ne udumi'a hiisse. <verse eid="2CH 18:31" /><verse number="32" style="v" sid="2CH 18:32" />Iikki sarageella ajajammakiirinna isi Isira'eelike moyanjo kadebaaxxa egenneexxi isoo shorra waalle ile iima hinge.<verse eid="2CH 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2CH 18:33" />Kaddo malee mitti Sooriyaki loliink manji dedhanga mogido daribeexxi qomatixxi sibiljiinxi seemma welti gence hitexxe bakkanaa'n Isira'eelika moyanjo ote. Moyanjikinna ookkone sargeella oofaammaka «Ani mado'eenneni sarageella udumi'a hiissite loli giddii'n anee fulchi» hiyye. <verse eid="2CH 18:33" /><verse number="34" style="v" sid="2CH 18:34" />Barra duuchcha jabateeke lola hedhemman; Isira'eeliki moyanji Aki'aabi, Sooriyake manni ifike sarageella hana galgal qico'n irkateemman, isinna arishsho e'yitee wodda reye.<verse eid="2CH 18:34" /></para>
  <chapter eid="2CH 18" />
  <chapter number="19" style="c" sid="2CH 19" />
  <para style="p">
    <verse number="1" style="v" sid="2CH 19:1" />Yihudiink moyanji Iyyosafixxi Iyyerusaalemi hedheeke ifike moyatike mine'n nage'iki higeexxa yanna, <verse eid="2CH 19:1" /><verse number="2" style="v" sid="2CH 19:2" />wabeeki Hananiki belti Iyyu, moyanjiki afemo'a dageexxi Iyyosafixxi'i hiyyee qici: «Ati fuggaaleesa gargaara, Duuchchi Woddiki Gootti gibakaara eeya eloxxeta? Tennenaa'n kexxeexxa Duuchchi Woddike Goottixxi mufe ate'n hexxeen. <verse eid="2CH 19:2" /><verse number="3" style="v" sid="2CH 19:3" />Kaddo malee ashsheera hiyyemmake magenixxe fakkexxa sooddo bogakenaa'n hoyyite birtetaxxeenna Mageno halsatee qalbe atixxa qopheefatetaxxee eloxxe assiteeten.»<verse eid="2CH 19:3" /></para>
  <para style="s1">Iyyosaafixxi Hayoole Baallonse</para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 19:4" />Iyyosafixxi Iyyerusaalemi ofo'le; Bersaabehinaa'n tullichchuwwiinke Efireemike bogi qico'n ardiinxe oddo'n mammaremeexxi edike insa'neke annuwwika Mageno Duuchchi Woddike Goottibaa ille iima hingaashsha asse. <verse eid="2CH 19:4" /><verse number="5" style="v" sid="2CH 19:5" />Bogake'n kinjiinke dalla'i giddo ijaaremeeke Yihudiinke qachchuwwa duuchcha'n hayyoole baallonse. <verse eid="2CH 19:5" /><verse number="6" style="v" sid="2CH 19:6" />Isinna insa'ne'n hiyyee qici, «Ha'no murtina'neek manjokeete kaddebaak, murte murtinaaxxa yanna duuchcha ha'noon welt hedheeke Duuchchi Woddike Gootti'aate kaddemmaxxee, uutinaaxxe murte duuchcha'n jabbaxxa xexe'achcho asse. <verse eid="2CH 19:6" /><verse number="7" style="v" sid="2CH 19:7" />Ta'anna Duuchchi Woddika Gootta sodaata ha'noo'n hexxowwaal; no'oka Mageno Duuchchi Woddike Goottiba murte dassa, gamisanna matta adhdha hedhagophpheemmaxxee xexxe'atina'n murre.»<verse eid="2CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 19:8" />Iyyosafixxinna Iyyerussaalemi giddo Duuchchi Woddike Goottika seera muxxinsaashshanna kexxaaxxe wele gonphe'n murte unaashsha Leewwitotenaa'n, qeesetenaa'ninna Isira'eelike mini minike akeekisanjuwwinaa'n heenooka manna baalloonse; insa'nenna Iyyerusaalemi he'na'nemman. <verse eid="2CH 19:8" /><verse number="9" style="v" sid="2CH 19:9" />Insa'neenna hiyye ajajee qici, «Duuchchi Woddika Gootta sodaattinna'n xuurameessummatinnaa mitte godobinni ergatemme, <verse eid="2CH 19:9" /><verse number="10" style="v" sid="2CH 19:10" />Qachcha qachcha'ni hedha'neeki firi ha'nooki mado'exxi, yookaani seera, ajajuwwa, aadanna galduma sa'ati ha'noobaa shiqaaxxee fedheexxe yaanenni, Duuchchi Woddika Gootta balleessinabaashsha isixxi mufe kinni ha'noo'ninna dayyuwwa ha'nooke'n geltabaashsha insa'nee xexxe'achchiisse; tenne assitinoole balleessa affinebaan.<verse eid="2CH 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 19:11" />«Duuchchi Woddike Goottike kadeechcho duuchcha'n qeesetiki akeekisanji Amaariya; moyajiinke kadeechcho duuchcha'n Yihudiinxe gosake sooreessa Isima'elika belto Zebadiya ha'noo'n balloomeen; Leewwito kinn ha'noo edo akeekisanjuwwake kande ergatemaan; jabaattine hujje; Duuchchi Woddiki Goottinna eloxxa assaakeerinni welti hedhowwaal» hiyye.<verse eid="2CH 19:11" /></para>
  <chapter eid="2CH 19" />
  <chapter number="20" style="c" sid="2CH 20" />
  <para style="s1">Iyyosaafixxi Mo'abinna Amooni'i Lole injifateexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 20:1" />Ookkoneechchi uduma Mo'aabitonna Amoonito heenoxxe Mi'unawitonni welti Iyyosafixxii lolo'a dange.<verse eid="2CH 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 20:2" />Manni dageexxi Iyyosafixxi'n hiyyee qici, «Hara yo'oki loliinki mann atee lolo'a maxinetixxe<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">Ibritotixxi tika tennenni weli aaggaan; Ibritotikenni kinni Aaraami hiyyaan</char></note> abbaayya wido hedheeke Edoomike<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">hedho afeechchi giddo hedhabaaxxe abbaayya kaddeexxa ege'nendeexxe kaddeenaa'n midde mitte mitte tika hedho afeechchi giddo hedhabaaxxe hiyyaaka hiyyichcho la'oofataba'a</char></note> boganaa'n atibaa dageeni; kunniseteni Hasetsoni Tamari hiyyendammaxxa Ayyini gadi he'neen» hine. <verse eid="2CH 20:2" /><verse number="3" style="v" sid="2CH 20:3" />Iyyosafixxinna yo'oshsha sodaatemmaxxee Duuchchi Woddika Gootta harse; Yihudiinki ardi duuchchi agabo goddo hosaashsha lasse. <verse eid="2CH 20:3" /><verse number="4" style="v" sid="2CH 20:4" />Yihudiinki ardinna Duuchchi Woddiki Gootti insa'nee gargaaro'a; soodachchotee Yihudike qachchuwwa duuchchanaa'ni mitteba bukki hiyye.<verse eid="2CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 20:5" />Iyyosafixxinna Duuchchi Woddike Goottike galmibaa haarooke ba'linni edi darre Yihudikinna Iyyerusaalemiki ardi bukki hiyyeexxe oddo'n urreexxi; <verse eid="2CH 20:5" /><verse number="6" style="v" sid="2CH 20:6" />Hiyyee qici:</para>
  <para style="pm" vid="2CH 20:6">«Annuwwi no'okike Duuchchi Woddike Gootta Mageno; ati iimate'n hexxaateke Magenoba? Ati gosa gosake ardixxa mootummuwwa duuchcha galchitateki ateten; hunnana jabeenni atixxe anga'n hedheen; ate morome dande'aki ayyinna hedhebaan. <verse eid="2CH 20:6" /><verse number="7" style="v" sid="2CH 20:7" />No'oke Mageno; konne boga'n hedhemmaka manna arda atike Isira'eeli edi'n fulchite shorritettexxi; jaalo atike Abirihaamixxe horte'a duuchchi woddi'a uutetteki ateteba?<note caller="-" style="x"><char style="xo" closed="false">20:7 </char><char style="xt" closed="false"><ref loc="ISA 41:8">Isa. 41:8</ref>; <ref loc="JAS 2:23">Ya'i. 2:23</ref>. </char></note> <verse eid="2CH 20:7" /><verse number="8" style="v" sid="2CH 20:8" />Insa'nenna konne boga'n ofolleexxi; summi atikike ulfini'a galma ijaare; hinee qici, <verse eid="2CH 20:8" /><verse number="9" style="v" sid="2CH 20:9" />‹No'o mura woxisatee lola yookaan, dhukkubi yookaani solo'iinxi rakko no'o'n geltoole summi atiki ye'emeeke konne Galmi edo ati edo uurrine rakkotenaa'n no'o gargartotaa atiba'a raarrannen; atinna raare no'oxxa laqqe no'o anjirtatton› hine.<verse eid="2CH 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 20:10" />«Isira'eeli Gibtsee'n fuldee wodda konne mannika boga e'yine lollabaashsha assitetaxxee marree insa'ne birrebaangi waallemmaki Amooniki, Mo'aabikinna Seyiirixxe koobaki mann no'o lolo'a dageen.<note caller="-" style="x"><char style="xo" closed="false">20:10 </char><char style="xt" closed="false"><ref loc="DEU 2:4-19">Lan. 2:4-19</ref>. </char></note> <verse eid="2CH 20:10" /><verse number="11" style="v" sid="2CH 20:11" />Kunseteni ati no'o'a geego uutettake boganaa'n no'o shorrine halo fullo'a dangeen. <verse eid="2CH 20:11" /><verse number="12" style="v" sid="2CH 20:12" />No'oke Mageno; ati insa'ne'n murtabexxo? No'o'n duule dageeka konne yo'oka sanaachcha injifantannoxxa hunna anfebe'non; maa asinannoxxa egennebe'non; yaane kinni no'o gargartotaa atibaa uundaannen.»<verse eid="2CH 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 20:13" />Yihudiinki mann duuchchi aruwwa ifixxinn, oosuwwatinna shiixxaramma oosuwwanni welti Duuchchi Woddike Gootti edo uurrineemman.<verse eid="2CH 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 20:14" />Eettene yanna Aasafixxe horte kadeeke Leewwichcho Zakaaryaasi belto Yahazi'eeli'n Duuchchi Woddike Goottiki Hafuuri dage. Zakkariyaasi kunni Bennayaasike belto kadaa wodda, Bennayaasi Yi'i'eelii Maataaniyaken. Mataniyakemman.<verse eid="2CH 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 20:15" />Yazi'elinna hiyyee qici: «moyanjo Iyyossafixxi balloo! Ha'noonna Yihudiinkena Iyyerusaalemi hexxina'neeki duuchchi laqqe! Duuchchi Woddiki Gootti ha'no'a hiyya'nee qici; ‹Lola'neeki Magenoke malee ha'nootebaan; konne yo'oke sannachchi'a sodaattinoqqee; alaltinoqqe.<note caller="-" style="x"><char style="xo" closed="false">20:15 </char><char style="xt" closed="false"><ref loc="LEV 20:1-4">Lew. 20:1-4</ref>. </char></note> <verse eid="2CH 20:15" /><verse number="16" style="v" sid="2CH 20:16" />Soodo adaddee martine insa'nee lolle! Insa'ne Tsitsika ora qabante alaallee dangaani; ha'noonna Yiru'eelixxe qiilla gammoojje giddo dhooqatike kasa'n insa'ne affinaan. <verse eid="2CH 20:16" /><verse number="17" style="v" sid="2CH 20:17" />Konne lolanna loldinaaki ha'nootebaani; koo Yihudiinkenna Iyyerusaalemike manna; bakka bakka ha'nooxxa abixxe; jabaattine uurre; Duuchchi Woddiki Gootti injifachcho ha'no'a uwwaaxxa uuddinaan. Sodaattinoqqe; alaltinoqqe; soodonni fuldinee insa'ne lolle; Duuchchi Woddiki Gootti ha'noonni welti hedhaan› » hiyye.<note caller="-" style="x"><char style="xo" closed="false">20:17 </char><char style="xt" closed="false"><ref loc="EXO 14:13-14">Fula. 14:13-14</ref>. </char></note> <verse eid="2CH 20:17" /><verse number="18" style="v" sid="2CH 20:18" />Iyyosafixxi albiki buttinake'n gombiseme; Yihudiinknna Iyyerusaalemki ardi duuchchi Duuchchi Woddike Gootti edo ibe sagade.<verse eid="2CH 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 20:19" />Qe'atixxenna Qorexxe horteexxe gamo kadeexxi heenooxxi Leewwitonna uurrteexxi hafuura gikki assteexxi Isira'eelika Duuchchi Woddika Gootta Mageno galateefate.<verse eid="2CH 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 20:20" />Ardi gorsa bariisa ke'exxi Teqo'ake qiilla gammoojje bogibaa me'e. Ookko'a me'atee ke'neeshshanni Iyyosafixxi uurreexxi insa'nee «Yihudiinkenna Iyyerusaalemike arda hiyyanexxa laqqe! Duuchchi Woddike Gootta ha'noke Mageno'n amanne; ti'ni hitinaan; wabeeko haasottaaxxanna amanne; yaane ha'no'a qajeldaan» hiyye. <verse eid="2CH 20:20" /><verse number="21" style="v" sid="2CH 20:21" />Iyyosaafixi ardiki welti mari'ateechchi uduma ookkone sannachchi edo sa'eexxi me'ati</para>
  <para style="q1" vid="2CH 20:21">«Jaalala isixxi duuchchi woddixxe kaddemmaxxe Duuchchi Woddika Gootta galateefatte!» hiyya'n Duuchchi Woddike Goottixxe woyyumaxxeenna ulfinixee isoo saadaaka manna foye.<verse eid="2CH 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 20:22" />Faaro faarsatanna saadino sanfeeshshanni Duuchchi Woddiki Gootti Yihuda lola'emmake Amoonike, Mo'aabikenna Seyiirixxe koobake manna'n sho'omeeka bagedo iyyedage; insa'nenna injifatemme. <verse eid="2CH 20:22" /><verse number="23" style="v" sid="2CH 20:23" />Tennexxee Amoonitonna Mo'aabito Seyiirixxe koobaka manna duuchcha balleesateenna biratee insa'ne'n ke'ne; Seyiirika manna birreechchi uduma insa'nenna mararte belo weli welinni birre.<verse eid="2CH 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 20:24" />Yihudiinki sannachchi eettene qiilla gammoojje leellishshaaxxe bakka'n hedheexxi ookkene bira sa'eeka sannachcha adaadde uuda woddda ookkone boga duuchcha'n renshi wo'mee'naa afe; mitti manjinna baaje fuleek hedhemmabaan. <verse eid="2CH 20:24" /><verse number="25" style="v" sid="2CH 20:25" />Tennexxee Iyyosafixxinna isik loliinki manni booji'o adhdhatee ookko'a me'ine; heddo gargar gargar hedheeka miyuwwanna seemma, ba'edhatee dandeesisabaaka fiixeeka miyyuwwa alfine; eettene booji'otinna birasa'netenaa'n kexxeexxa sase barra qico bukki asse'ne. <verse eid="2CH 20:25" /><verse number="26" style="v" sid="2CH 20:26" />Shoolgaxxe barra'n Eebbatixxe Dhooqa'n bukki hine; ookkone booncho'n Duuchchi Woddika Gootta galateefante; tennexxee ookkone boncho telchi qico'n Eebbatixxe Dhooqa hiyyemmeechchi tennexxeeten.<verse eid="2CH 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 20:27" />Ookkoneechchi uduma Duuchchi Woddiki Gootti ifika naapha injifante gammandaashsha assemaxxee Yihudiinkinna Iyyerusaalemiki mann duuchchi Iyyosafixxixxe akeettenni lumoxxe gammashshonni Iyyerusaalemi'a ille iima hinge.<verse eid="2CH 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2CH 20:28" />Iyyerusaalemike qachcha'n e'yineeshshanni baganakanna, masinqo ganna'n malagatakanna ufuunfa'n Duuchchi Woddike Goottike galmibaa me'ine.<verse eid="2CH 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 20:29" />Duuchchi Woddiki Gootti Isira'eelika naapha hitta loleexxa laqeeke moyanjuwwa duuchcha'n Magenibaa'n soda'a insa'ne'n ibbe. <verse eid="2CH 20:29" /><verse number="30" style="v" sid="2CH 20:30" />Isik Magen duuchchi darree'n hafuura adhdhisemmaxxee Iyyosafixixxi mootumma nage'iki hexxemman.<verse eid="2CH 20:30" /></para>
  <para style="s1">Iyyosafixixxe Mootummaxxa Muuxensha</para>
  <para style="r">(<ref loc="1KI 22:41-50">1 Moy. 22:41-50</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="2CH 20:31" />Iyyosafixxi Yihudiinke moyanjo kadee wodda wogga isixxi sase tommenna onde woggamman; isinna Iyyerusaalemi ofo'leexxi lame tommenna onde wogga moye; isixxi amanna Azuuba hiyyendaaxxe Shilihixxe beltomman. <verse eid="2CH 20:31" /><verse number="32" style="v" sid="2CH 20:32" />Iyyosaafixi isi edi darre hedhemmake isika anna Aasanni Duuchchi Woddike Gootti edo eloxxa asse. <verse eid="2CH 20:32" /><verse number="33" style="v" sid="2CH 20:33" />Kaddo malee tullichchuwwiinka magenoofachchotika boonchuwwa balleesse bireemmabaan; ardikinna ifike edike annuwwike Magenibaa ookkone qico'n mitte godobinni higemmabaan.<verse eid="2CH 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2CH 20:34" />Iyyosafixxi moyemmake baro'n ke'itokenaa'n muuxamii qico'n hujendeexxa wele hujuwwa Hananiki belti Iyyu borreesseke Isira'eelike moyanjuwwiinke jirteke maxaafi giddo borreessende'een.<verse eid="2CH 20:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2CH 20:35" />Ookkoneechchi uduma Yihudiinki moyanji Iyyosafixxi hara elobaxxa huje hujeke Isira'eelika moyanjo Akaaziyaasinni welti guddeexxi weli aagemman. <verse eid="2CH 20:35" /><verse number="36" style="v" sid="2CH 20:36" />Insa'nenna Daddaliinka markabuwwanna hujinso'a weli aange; konnee markabuwwanna Tsiyooni Gabiri giissinse. <verse eid="2CH 20:36" /><verse number="37" style="v" sid="2CH 20:37" />Maressa bogiki manji Doodiyaaki belti Eli'eezer Iyyosafixxi'n, «Akaaziyaasinni welti guddite weli aaggettaxxee Duuchchi Woddiki Gootti hujjetexxa duuchcha balleesaan» hiyye raaga raage; iikki markabuwwinna enqeme; daddaliinxe huje'anna me'a dandeeneba'a.<note caller="+" style="f"><char style="fr" closed="false">20:37 </char><char style="ft" closed="false">Ibritotixxi tika Teerseesi'aanna me'a dandeenneba'a hitaan.</char></note><verse eid="2CH 20:37" /></para>
  <chapter eid="2CH 20" />
  <chapter number="21" style="c" sid="2CH 21" />
  <para style="p">
    <verse number="1" style="v" sid="2CH 21:1" />Iyyosafixxi ifike edike annuwwishshanni lummedhe; isinna Daawwitike qachchi giddo hedheeke moyanjuwwiinke hirreesa'n moogeme; belti isik Iyyoraami isixxe bakka moye.<verse eid="2CH 21:1" /></para>
  <para style="s1">Yihudaka Moyanjo Iyyoraamii'i</para>
  <para style="r">(<ref loc="2KI 8:17-24">2 Moy. 8:17-24</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 21:2" />Iyyoraamiki dayyuwwa kadde'eemmaxxi Iyyosaafixi oose, Azariyaasi, Yihi'eeli, Zekaaryaasi, Ezariyaasi, Mika'eelinna Safaxxiyyaasi hiyyemmaani. Tinni duuchchiinxi Isira'eelika moyanjo Iyyosafixxixxe oosemmani. <verse eid="2CH 21:2" /><verse number="3" style="v" sid="2CH 21:3" />Anni insa'neki heddo birretika sibiljonna worqe, fixeeka miyuwwanna iittanni Yihudi giddo kinjiinke dalla'inni ijaaremeeka qachchuwwa insa'ne'a uwwe; yaane kinni ifixxa mootumma ifike angafa belto kadeemmaxxee Iyyoraami'a uwwe.<verse eid="2CH 21:3" /></para>
  <para style="s1">Yihudiink Moyanjo Iyyoraamii'i</para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 21:4" />Iyyoraami mootumma ifike annixxa jabeessedheechchi uduma dayyuwwa ifika duuchcha iittanni heenooka Isira'eelike sooreessuwwa wolaantichchik bire. <verse eid="2CH 21:4" /><verse number="5" style="v" sid="2CH 21:5" />Iyyoraami moyee wodda wogga isixxi sase tommenna lame woggamman; Iyyerusaalemi ofo'leexxi saddeeta wogga moye galche. <verse eid="2CH 21:5" /><verse number="6" style="v" sid="2CH 21:6" />Iyyoribi'aminna Aki'aabixxa belto aadhemmaxxe Aki'abiki mini hadi assammashshanni Isira'eeliki moyanjuwwi me'emmaka elobaaka ora hordofe; Duuchchi Woddike Gootti edonna elobaxxa huje huje. <verse eid="2CH 21:6" /><verse number="7" style="v" sid="2CH 21:7" />Kaddo malee Duuchchi Woddiki Gootti Daawwiti'a aageexxe kakonaa'n kexxeexxa Daawwitika mine balleeso'a yorebaan; tinni iitta kaddeechchi Duuchchi Woddik Gootti edi wodda Daawwiti'anna isixxe sanne'a duuchchi woddi'a, kuta belo ifaak ifi hedhaashsha assatee addachchiisatika hiyyichcho isi'a uwweemmaxxeetemman.<note caller="-" style="x"><char style="xo" closed="false">21:7 </char><char style="xt" closed="false"><ref loc="1KI 11:36">1 Moy. 11:36</ref>. </char></note><verse eid="2CH 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 21:8" />Iyyoraami moyemmake baro'ni Eedoomi Yihudake'n fuggoxxinni ke'exxi ifika moyanjo fi'le moyisiise.<note caller="-" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="GEN 27:40">Dada. 27:40</ref>. </char></note> <verse eid="2CH 21:8" /><verse number="9" style="v" sid="2CH 21:9" />Tennexxe Iyyoraami loliinke mannika ajajalluwwanna loliinxa sarageela duuchcha adhdheexxi ookko'a mare. Eedoomiki manninna isoonna loliinka sarageela ajajammaka duuchcha erqe kayyi'n bunqe; isinna kinni hashsha ke'exxi isoo buqemmaka loliinka manna lole injifate. <verse eid="2CH 21:9" /><verse number="10" style="v" sid="2CH 21:10" />Eedoomi techchi qico'n Yihudakee ajajema gibeeshshanni gate.</para>
  <para style="p" vid="2CH 21:10">Iyyoraami annuwwi insa'nekika Duuchchi Woddika Gootta Mageno waalemmaxxee; Libinake qachchiki mann eettene yanna'n iso'n fuggoxxinni ke'e. <verse eid="2CH 21:10" /><verse number="11" style="v" sid="2CH 21:11" />Ookkoneechchi uduma isinna Yihudiinke tullichchuwwa'n magenoonfantaba giisseexxi Iyyerusaalemiki ardi ookko'o yabaabulaashsha assatii Yihudiinka arda dedhise.<verse eid="2CH 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 21:12" />Ookkoneechchi uduma wabeek Eliyaasi Iyyoraami'a borro hiyye borreese qici: «Atike annki Daawwitiki Duuchchi Woddiki Gootti Mageni hiyya'nee qici: ‹Atike annika Iyyosafixxike yookaani Akka'iinka moyanjo Aasak eloka ora ati me'iteboxxon. <verse eid="2CH 21:12" /><verse number="13" style="v" sid="2CH 21:13" />Yaane kinn Isira'eelike moyanjuwwike ora'n me'itetten; Aki'aabik mini Isira'eeliki ardi Duuchchi Woddike Gootta'n addatabaashsha assemmashshanni; atinna Yihudinikanna Iyyerusaalemiki ardi wele magenuwwa yabaabulaashsha assitetten; iittanni ati erra nageeliichchake kadeeka dayyuwwanna atike annika mini hado shiltetten. <verse eid="2CH 21:13" /><verse number="14" style="v" sid="2CH 21:14" />Tennexxee ta'a Duuchchi Woddiki Gootti arda atika, oose atixxa, aruwwa atixxana karra atixxa duuchcha jabaxxe balanni ganaan. <verse eid="2CH 21:14" /><verse number="15" style="v" sid="2CH 21:15" />Atinna umo atige'n barra barrani jabake madhuma lo'o assaake fayyabaake dhukkubinni dhibendatton.› »<verse eid="2CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 21:16" />Duuchchi Woddiki Goottina Filisixeemitotinna Tophiyitoti bira hedha'neeka Arabiinki manni Iyyoraami'ni naaphake kade ke'aashsha asse. <verse eid="2CH 21:16" /><verse number="17" style="v" sid="2CH 21:17" />Insa'nenna Yihudake arda'n duulleexxi lolle. Moyanjiinke mootummatike mine'n hedheeka miya duuchcha, labbaxxa oose isixxanna aruwwa isixxinni welti boojine adhdhine me'ine; maa'nichcho belto Akaziyaasi malee mitti beltinna isi'a gatebaan.<verse eid="2CH 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 21:18" />Ookkoneechchi uduma Duuchchi Woddiki Gootti fayya dande'abaake ma'lumatik dhukkubi Iyyoraami qooma shiye. <verse eid="2CH 21:18" /><verse number="19" style="v" sid="2CH 21:19" />Ela gonphe iso'n lame wogga'a jabaatta'n me'itemmaxxee ma'luma lo'o hite'naa jaba qico wixixxi hiyye reye. Ardiknna edike ifike annuwwike ulfini'aa giira giirammani; isi'a kinn giirebaan.<verse eid="2CH 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 21:20" />Iyyoraami moye wodda wogga isixxi sase tommenna lametemmaan; Iyyerusaalemi ofo'leexxi saddeeta wogga moye galche. Isi reye wodda ayyinna isi'a yaadeeki hedhemmabaan; Daawwitike qachchi giddo moongeeni malee moyanjuwwiinke hirreessa'n isoo moongebaan.<verse eid="2CH 21:20" /></para>
  <chapter eid="2CH 21" />
  <chapter number="22" style="c" sid="2CH 22" />
  <para style="s1">Yihudiinka Moyanjo Akaziyaasii'i</para>
  <para style="r">(<ref loc="2KI 8:25-29">2 Moy. 8:25-29</ref>; <ref loc="2KI 9:21-28">9:21-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 22:1" />Iyyerusaalemiki ardi Iyyoraamika maa'nichcho belto Akaaziyaasii anniinxe bakka'n mootonse; ookko'a Arabiinxe baxxebaa duuka dageemmaki loliinki manni angafoole isixxa shiyemmaxxee Yihudiink moyanji Iyyoraamiki belti Akaziyaasi moye galche.<verse eid="2CH 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 22:2" />Akaaziyaasi moyee wodda wogga isixxi lame tommenna lametemman<note caller="+" style="f"><char style="fr" closed="false">22:2 </char><char style="fqa" closed="false">Lame tommenna lame</char><char style="ft" closed="false">Yookaan shoole tommenna lame.</char></note> Iyyerusaalemi ofo'leexxi mitte wogga moye galche. Ama isixxinna Gotooliya hiyyendaaxxe Omerike beltixxe beltomman.<verse eid="2CH 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 22:3" />Ama isixxi isi elobaaxxa assaashsha isoo gorsitammaxxee isinna Aki'aabike mini hadike elobaake ora'n me'e. <verse eid="2CH 22:3" /><verse number="4" style="v" sid="2CH 22:4" />Ann isiki reyeechchi uduma Aki'aabike mini hadi elobaaxxa isi'a gorseemmaxxee Aki'abiki mini hadi assemmaxxa duuchcha isinna Duuchchi Woddike Gootti edo elobaaxxa asse. <verse eid="2CH 22:4" /><verse number="5" style="v" sid="2CH 22:5" />Iittanni Isira'eeliki moyanji Aki'aabik belti Iyyoraami Soriyaka moyanjo Azaheeli lolo'a Raamoti Gele'adi'a me'ee wodda ookkone mannika gorsa adhdheexxi Iyyoraaminni welti me'e; Sooriyaki manni Iyyoraamii madeesse. <verse eid="2CH 22:5" /><verse number="6" style="v" sid="2CH 22:6" />Tennexxee Sooriyake moyanjinn Azahelinni welti lolemmeeke lola'n Remati mado'emaxxe madanaa'n fayyo'a Iyyizira'eeli'a higeen.</para>
  <para style="p" vid="2CH 22:6">Aki'aabik belti Iyyoraami mado'emmaxxee Yihudiinki moyanji Iyyoraamiki belti Akaziyaasi gatteenni hexxette hiyyo'a Iyizira'eli'a me'e.<verse eid="2CH 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 22:7" />Akaziyyasi Iyyoraamii gatteeni hexxette hiyyo'a maremmaxxee buuto'a Duuchchi Woddiki Gootti Akaziyaasi'n ba'ne geessise; Akaziyaasi ookko geyeeshshanni Nameesika belto Iyyuu qophedho'a Iyyoraaminni welti fule; Iyyunna Aki'aabika mine biro'a Duuchchi Woddiki Gooti harireeke manjommani. <verse eid="2CH 22:7" /><verse number="8" style="v" sid="2CH 22:8" />Iyyuu Aki'aabike mine'n murte muree wodda Akaaziyaasii'i elqe kayyii'n qoqqobbeemmaxxa Yihudiinxa hayyoolenna isike firixxa labbaxxa oose afeexxi shiye. <verse eid="2CH 22:8" /><verse number="9" style="v" sid="2CH 22:9" />Isinna Akaaziyaasika hasito fule me'e; isiki manninna Akaziyaasii Semaariya shoome'naa anfeexxi abinde; Iyyubana iyyedangeexxi shinne, «Duuchchi Woddika Gootta mitte godobinni halseeki Iyyosafixxike beltoni» hina'n moonge. Tennexxee Akaziyaasike minenaa'n mootummate'n baalloma dande'aki manji hedhdhemmabaan.<verse eid="2CH 22:9" /></para>
  <para style="s1">Yihudixxa Mootitte Ataliyaa'a</para>
  <para style="r">(<ref loc="2KI 11:1-3">2 Moy. 11:1-3</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 22:10" />Akaaziyaasixxi Ama Gotooliya belti iseki reyeexxa uuddeexxa yanna Yihudiinke moyanjuwwika mini hado duuchcha shilchiisse. <verse eid="2CH 22:10" /><verse number="11" style="v" sid="2CH 22:11" />Moyanjo Iyyoraammixxi belti Yihosheba'i kinn shiyendammaxxe moyanjiinxe oose giddii'n Iyyo'aasii shoxxe adhdhite me'iteexxi isonna iso'oo nossitammaxxe manjichcho galdumminxe kuta giddo shoxxe. Iyyoraamika belto qeesichcho Yodaahexxi are Yosabeeti Akaaziyaasixxike dayyo kaddemmaxxee eettene anno shoxxechchi Gotooliya shiltabaashshaten. <verse eid="2CH 22:11" /><verse number="12" style="v" sid="2CH 22:12" />Isinna Gotooliya moote boga galchitee wodda Mageniinke galmi giddo sho'ome jaane wogga insa'neni welti ture.<verse eid="2CH 22:12" /></para>
  <chapter eid="2CH 22" />
  <chapter number="23" style="c" sid="2CH 23" />
  <para style="s1">Ataliya'n Asendeexxa Xaqaro</para>
  <para style="r">(<ref loc="2KI 11:4-16">2 Moy. 11:4-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 23:1" />Qeesichchi Yodaahe Torbaaxxe wogga'n hunnaammeessake kade; dhibbiinke ajajalluwwa kandeeke Yirohomike belti Azariyaasi, Yihohananik belti Isima'eli, Obediki belti Azariyaasi, Adayaaki belti Ma'iseyanna Zikiriki belti Elishafixxinni welti kako aagge. <verse eid="2CH 23:1" /><verse number="2" style="v" sid="2CH 23:2" />Insa'nenna Yihudiinke bogibaa me'ineexxi Leewwitonna Isira'eelike mini hadika akeekisanjuwwa qachcha duuchchanaa'n bukki assine. Iyyerusaalemi'a iyyedange wodda <verse eid="2CH 23:2" /><verse number="3" style="v" sid="2CH 23:3" />Ya'i duuchchi Mageniinke galmi giddo moyanjiki welti kako aage.</para>
  <para style="p" vid="2CH 23:3">Qeesichchi Yodaahe insa'ne'n hiyyee qici, «Duuchchi Woddiki Gootti Daawwitixxe horte'a addachiisemmashshanni kunse moyanjiinki belti Iyyo'aasi moyaan.<note caller="-" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="2SA 7:12">2 Sam. 7:12</ref>.</char></note> <verse eid="2CH 23:3" /><verse number="4" style="v" sid="2CH 23:4" />Ta'a no'o assitinnaa qici konneechchinni butti'a hexxeen: qeesetinna Leewwito Edi Sanbatiinxa barra ergematee dangaa wodda insa'ne giddii'n sasekenaa'ni mitti galmiinxe dalla'ixxa huluwwa heqqowwaal. <verse eid="2CH 23:4" /><verse number="5" style="v" sid="2CH 23:5" />Sasekenaa'ni mitti mootummatika mine sasekena'ni mitti oddottixxe hula hiyyendaaxxa heqqe; gateeki manni duuchchi Duuchchi Woddike Goottike galmike loola'ni bukki hinowwaal. <verse eid="2CH 23:5" /><verse number="6" style="v" sid="2CH 23:6" />Ergemate'ni hana hexxeexxe qeesenna Leewwito malee huuni manjinna galmi giddi'a e'ya hasissabaan; qeesetinna Leewwito kinni Duuchchi Woddike Gootti'a gargar foyemeemmaxxee e'ya dandeenaan. Gateek ardi Duuchchi Woddike Goottika ajaja muuxatee galmi gadhi darre he'nowwaal. <verse eid="2CH 23:6" /><verse number="7" style="v" sid="2CH 23:7" />Leewwito loliinka miya ifika anga abixxine moyanji qarqara uurtowwaal; galmi giddi'a e'yaaki huuni manji shiyemowwaal. Moyanji me'a'neeke booncho duuchcha'n isixxa duuka me'inowwaal.»<verse eid="2CH 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 23:8" />Leewwitotinna Yihudiink ardi duuchchi qeesichchi Yodaahe ajaajemmashshanni asseen. Qeesichchi Yodaahe heqqanjummatixxa huje hujammakeeranaa'ni ayyeena geegesemmabaan. Mitti mitting Edi Sanbatiinxa barra hujete'n bobba'akaaranna huje muuxee fulammakaara ifika manna adhdhe. <verse eid="2CH 23:8" /><verse number="9" style="v" sid="2CH 23:9" />Yodaahenna Galmi giddo hedhemmaka moyanjo Daawwitika bageduwwa, lumollanna shiixxaramma wontuwwa dhibba loliinka manna ajajammakeeri'a uwwe. <verse eid="2CH 23:9" /><verse number="10" style="v" sid="2CH 23:10" />Manni duuchchi mitti mitting loliinka miya anga abixxeeshshanni galmiinke bita'anaa'ni middii qico'ni tolchimalchonna galmi bira moyanji qarqara uurrinaashsha asse. <verse eid="2CH 23:10" /><verse number="11" style="v" sid="2CH 23:11" />Qeesichchi Yodaahenna isixxi labbaxxi oose moyanjiinka belto aaxxe daggeexxi kallachcha iso'ni uggine; kakotika maxaafa iso'n uunexxi isoo moyanjokee assine. Insa'nenna iso'o hariirreexxi hafuurakanna gikki assine, «Moyanji duuchchi woddi'a hedhowwaal!» hine. <verse eid="2CH 23:11" /><verse number="12" style="v" sid="2CH 23:12" />Gotooliyanna qeexala'ni moyanjo gammado leelisha'neek ardika hoga laqqeexxi ardi hedhemmabaa Duuchchi Woddik Goottike galmibaa me'ite. <verse eid="2CH 23:12" /><verse number="13" style="v" sid="2CH 23:13" />Moyanji e'yinammaxxe hulaba hedheek utuphi bira uurree'naa isenna affe; loliinki ajajalluwwinna malagata ufuufamakiirinna moyanji bira hedhemman; ookkone bogik manni duuchchi gammada'n malagata ufuufaamman. Faarsaleeyyetinna meelliinke miyinna qoqqobende ayyaaniinxa faaro akeenka'nemman. Gotooliyanna seemma ifixxa darteexxi tinni seeribeloteni! Tinni seeribeloteni! Hita'n cancite. <verse eid="2CH 23:13" /><verse number="14" style="v" sid="2CH 23:14" />Qeesichchi Yodaahenna dhibba loliink manna ajajamakaara hiyyee qici, «Gootoliyaa daleeke manni giddi'n fulchitine iyyedagge; iseexxa duuka dagaaki hedhoole shiwwe» hiyye insa'nebaa erge. Qeesichchikinna, «Duuchchi Woddik Goottiki galmi giddo isee shiltinoqqee» hiyyeemman. <verse eid="2CH 23:14" /><verse number="15" style="v" sid="2CH 23:15" />Isenna mootummatike minik dalla'i giddo fadhadi e'yaaxxe hula hineeke booncho'ni gelteeshshanni isee abinde; iseenna ookko shinne.<verse eid="2CH 23:15" /></para>
  <para style="s1">Yodaahe Asseexxa Jijjiira</para>
  <para style="r">(<ref loc="2KI 11:17-20">2 Moy. 11:17-20</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 23:16" />Qeesichchi Yodaahe umi ifikinni, ardinna isik moyanji Duuchchi Woddik Goottik arda kanda'neexxa kako aage. <verse eid="2CH 23:16" /><verse number="17" style="v" sid="2CH 23:17" />Ookkoneechchi uduma ardi duuchchi me'eexxi Ba'aalika magenoofachchotixxa fakkuwwa diige; tolchimalchonna fakkuwwa enqe bire; Ba'aalika qeesichcho Maataninna insa'nek tolchimalchi edo shinne. <verse eid="2CH 23:17" /><verse number="18" style="v" sid="2CH 23:18" />Qeesichchi Yodaahe Muuseke seera'ni borreessendemmashshanna Daawwitinna ajajemmashshanni gammadikinna faaroti ciincesemaaka Duuchchi Woddik Goottika tolcha shiqinshaashsha Daawwiti uggemmaxxe qeesenna Leewwito Duuchchi Woddik Goottika galma insa'ne heqqinaashsha baalloonse. <verse eid="2CH 23:18" /><verse number="19" style="v" sid="2CH 23:19" />Iittanni fedheeki batto'eek manji Duuchchi Woddike Goottike galmiinke dalla'ixxe huluwwa'ni e'yabaashsha heqqanjuwwa ugge. <verse eid="2CH 23:19" /><verse number="20" style="v" sid="2CH 23:20" />Dhibba loliinka manna ajajamakaara, ja'laabuwwa, arda akeekamakaaranna ookkone bogika arda duuchcha aadheexxi mayanjo alee'ni galmake'na'n adade aadhe dage. Alee'ni E'yinammaxxe hula darree'n mootummatike minibaa e'yineexxi moyanjo mootummatixxe moote hana ofo'linshe. <verse eid="2CH 23:20" /><verse number="21" style="v" sid="2CH 23:21" />Ookkone bogik ardi duuchchi gammade; Gotooliya shiyendeemmaxxee iikki qachchi nage'a alfe.<verse eid="2CH 23:21" /></para>
  <chapter eid="2CH 23" />
  <chapter number="24" style="c" sid="2CH 24" />
  <para style="s1">Yihudiinka Moyanjo Iyyo'aasii'i</para>
  <para style="r">(<ref loc="2KI 12:1-16">2 Moy. 12:1-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 24:1" />Iyyo'aasi moye wodda wogga isixxi torbaane tommeman. Isinna Iyyerusaalemi ofo'lee shoole tomme wogga galche. Isixxi amanna Saabiya hiyyendaaxxe Bersaabehike qachcha'n ilendeexxemman. <verse eid="2CH 24:1" /><verse number="2" style="v" sid="2CH 24:2" />Qeesichchi Yodaahe lubbot hedhemmake baro duuchcha'n Iyyo'aasi Duuchchi Woddik Gootti gammadaaxxa yaane asse. <verse eid="2CH 24:2" /><verse number="3" style="v" sid="2CH 24:3" />Qeesichchi Yodaahe lame are moyanjo Iyyosiyaasi'a aadhise; labbaxxanna meyyaxxa oose afe'eemman.<verse eid="2CH 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 24:4" />Heenoxxe yanna uduma Iyyo'aasi Duuchchi Woddike Goottika galma qammachchatee mudhdhe. <verse eid="2CH 24:4" /><verse number="5" style="v" sid="2CH 24:5" />Isinna qeesetinna Leewwito bukki asseexxi insa'nee, «Ha'noonna Yihudiinke qachchuwwibaa martineexxi Duuchchi Woddike Goottika galma wogga wogga'ninni qammachchatee Isira'eelika arda duuchchanaa'n maallaqa bukki asse; tenneenna ta'anni hujje» hiyye. Leewwito kinni ga'ma'mi hite.<verse eid="2CH 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 24:6" />Tennexxee moyanji umo qeesichcho Yodaahe e'yeexxi isoo «Duuchchi Woddik Goottik erganji Muusenna Isira'eelik ya'i afenshatike duunkaani'a uunaashsha murendeexxa irbo Yihudii'ninna Iyyerusaalemii'n Leewwito iyyedangaashsha mayee assa gophphete?» hiyye.<note caller="-" style="x"><char style="xo" closed="false">24:6 </char><char style="xt" closed="false"><ref loc="EXO 30:11-16">Fula. 30:11-16</ref>. </char></note><verse eid="2CH 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 24:7" />Eettene yanna eettene fuggitte Gotooliyaxxi oose Mageniinka galma enqite e'yiteexxi woyyomeeke miyuwwi midde gatebaangi Be'aalixxe fakkuwwaa la'oonfanteemman.<verse eid="2CH 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 24:8" />Moyanjiink ajajinni maallaqa bukki assemaaxxa saaxine hunje Duuchchi Woddik Goottik galmibaa e'yinammaxxe hula bira gadhi darree'ni uggine. <verse eid="2CH 24:8" /><verse number="9" style="v" sid="2CH 24:9" />Ookkoneechchi uduma Isira'eeli qiilla gammoojje'ni hexxe'naa Mageniink erganji Muuse ajajemmaxxa irbo Duuchchi Woddike Gootti'a aa'ne dangaashsha Yihuda'ninna Iyyerusaalemi'n lassine. <verse eid="2CH 24:9" /><verse number="10" style="v" sid="2CH 24:10" />Ja'laabuwwi duuchchi, ardi duuchchinna irbo gammanda'n aa'ne dange, maallaqakanna aa'ne danga'n wo'mitaa qico'n saaxinete'n uggine. <verse eid="2CH 24:10" /><verse number="11" style="v" sid="2CH 24:11" />Leewwitotinna saaxine aaxxeexxi sooresuwwake kadeekeri'a mootummatike minike galchalluwwi'a barra barra'ni uunaamman. Saaxinete'n maallaqi wo'meexxe qixxe'n mootummatike miniki borreessanjinna umi qeesichchi ja'laabuwwi maallaqa saaxineti giddii'ni fulchene adhdhineechchi uduma saaxine bakkande'n hiisinaamman; konne qicinn heddo maallaqa bukki assine.<verse eid="2CH 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 24:12" />Moyanjikinna Yodaahe Duuchchi Woddike Goottika galma hujisaake maanni'a maallaqa uune; insa'nenna Duuchchi Woddik Gootti galma qammachchatee kino bocaakaranna mine ijaarammake iittanni galma qammachchatee sibilokanna sageettuwwa hujammake manni'a uune.<verse eid="2CH 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 24:13" />Hujetee bobba'eek manni jabaate hujemmaxxe hujetinna hujende; Mageniinka galma edi wodda hedhemmashshanni jabeessine haaronsine. <verse eid="2CH 24:13" /><verse number="14" style="v" sid="2CH 24:14" />Insa'nenna hunje birreechchi uduma gateeka maallaqa manjibaanna Yodaahebaa aa'ne dange. Ookkone maallaqinni Duuchchi Woddk Goottik galmika miyuwwa la'o uwwateenna ciincatik tolchi'a lo'o uwwaaka miyuwwa ittanni mooqquwwatanna wele worqetikanna birretik sibiljika miyuwwa hirre.</para>
  <para style="s1" vid="2CH 24:14">Yodaahexxi Akeette Jijjiirende</para>
  <para style="p" vid="2CH 24:14">Qeesichchi Yodaahe lubboti hedhemake baro duuchcha'ni Duuchchi Woddik Goottik galma'ni ciincatika tolcha duuchchi wodda shiqisa'nemman.<verse eid="2CH 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 24:15" />Yodaahenna cime bo'lo'leechchi uduma dhibbanna sase tome wogga'n lummedhe. <verse eid="2CH 24:15" /><verse number="16" style="v" sid="2CH 24:16" />Isinna Isira'eeli giddo Mageniinke galmi giddo elo qico hujeemmaxxee Daawwitike qachcha'n moyanjuwiinke hirreesi giddo moogeme.<verse eid="2CH 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 24:17" />Yodaahexxe reyo uduma Yihudake bogik sooresuwwi dageexxi moyanjoke'n xuurameessumma ifixxa ege'nishe; moyanjikinna insa'ne hineexxa laqe. <verse eid="2CH 24:17" /><verse number="18" style="v" sid="2CH 24:18" />Insa'nenna ifike edike annuwwika Mageno Duuchchi Woddika Goottika galma waalleexxi Asherate hiyyende ye'na'neexxe meyyaxx fakkuwwanna sooddo'ni magenoonfante. Insa'nexxe cubboxxe buutonn Mageniinxi Duuchchi mufe Yihuda'ninna Iyyerusaalemi'n gelte. <verse eid="2CH 24:18" /><verse number="19" style="v" sid="2CH 24:19" />Duuchchi Woddik Gootti ifibaa hissitaashsha wabeeko ardi giddi'a erge; wabeeko insa'ne gorsite insa'nenna gorsa lanqebaan. <verse eid="2CH 24:19" /><verse number="20" style="v" sid="2CH 24:20" />Ookkoneechchi uduma Mageniink hafuur qeesichcho Yodaaheeke belto'ni Zekkariyasi'n dage; isinna ardi edo uurreexxi, «Mageni hiyya'nee qici, ‹Duuchchi Woddike Goottika ajaja mayee saxxina'ne?› Ha'no'a qabbabaan ha'no Duuchchi Woddika Gootta waaldinemmaxxee isinna ha'noo waaleen.» <verse eid="2CH 24:20" /><verse number="21" style="v" sid="2CH 24:21" />Insa'ne kinni isoo fuggoxxinni ke'ne; moyanjiinke ajajinni Duuchchi Woddik Gootike galmiinke ba'linna'ni isoo kinjik cancanqe shinne.<note caller="-" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="MAT 23:35">Mat. 23:35</ref>; <ref loc="LUK 11:51">Luq. 11:51</ref>. </char></note><verse eid="2CH 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 24:22" />Moyanji Iyyo'aasi Zakkariyaasik anni qeesichchi Yodaahe isi'a asseemmaxxa eloxxa hedebaan; isi'a eloxxa assaammaxxa bakka belto isika sheye. Isinna reye wodda, «Duuchchi Woddik Gootti tenne hujeexxe fuggoxxe huje'a iso'n halo fulowwaal» hiyye.<verse eid="2CH 24:22" /></para>
  <para style="s1">Iyyo'aasixxe Mootummaxxa Muuxensha</para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 24:23" />Eettene woggake mayetik agenjo'n Sooriyak sannachchi moyanjo Iyyo'aasi'n duule; isinna Yihudanna Iyyerusaalemii buqe abide ardiinka akeekisanjuwwa duuchcha bire; booji'eechcho duuchcha Demasiqoka moyanjibaa erge. <verse eid="2CH 24:23" /><verse number="24" style="v" sid="2CH 24:24" />Sooriyak sannachchuwwiki laakkossi heenookemman. Yaane kinni Duuchchi Woddik Gootti lumoshsha calaala sannacha anga insa'nexxe'n sa'ise uwwe, tinni kaddeechchi insa'ne ifike edik annuwwika Mageno Duuchchi Woddika Gootta waallemmaxxeeten. Konne qicinn Iyyo'aasi'ni dhugaatixxi murte murende. <verse eid="2CH 24:24" /><verse number="25" style="v" sid="2CH 24:25" />Sooriyito fulde me'iteechchi uduma Iyyu'aasii fuggo madeesineemman; Iyyu'asinna qeesichcho Yodaaheka belto shiyeemmaxxee isik ja'laabuwwi iso'ni fuggoxxenni ke'eexxi taqete'ni diipheenba shiye. Isinna moyanjo Daawwitik qachcha'n moogeme malee moyanjuwwiinke hirreesa'n moogemebaan.<verse eid="2CH 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 24:26" />Iso'ni fuggoxxenni ke'eekiir Amoonichcho Sema'aatixxi belto Zabadinna Mo'aabitotixxi Seemarixxi belto Yoozabaditemman. <verse eid="2CH 24:26" /><verse number="27" style="v" sid="2CH 24:27" />Isixxe labbaxxe oosexxi jirte, isixxee kulemeemmak heddo raaguwwanna Mageniinke galmi qammachchema moyanjuwwinn jirtetike maxaafa'ni borreessenedeen. Belti isik Amesiyaasi isixxe bakka'ni moye.<verse eid="2CH 24:27" /></para>
  <chapter eid="2CH 24" />
  <chapter number="25" style="c" sid="2CH 25" />
  <para style="s1">Yihudiinka Moyanjo Ammaasiyaasii'i</para>
  <para style="r">(<ref loc="2KI 14:2-6">2 Moy. 14:2-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 25:1" />Amesiyaasi lame tommenna onde wogga geye moye, isinna Iyyerusaalemi'i ofo'leexxi lame tommenna sallane wogga galche. Ama isixxinna Yihoodini hiyyendaaxxe Iyyerusaalemii ilendeexxe manjichchomman <verse eid="2CH 25:1" /><verse number="2" style="v" sid="2CH 25:2" />Ammaasiyaasi Duuchchi Woddike Gootti edo gammachchisaaxxa eloxxa qajeelumma assaamman; kaddo malee mitte godobinnitemmaba'a. <verse eid="2CH 25:2" /><verse number="3" style="v" sid="2CH 25:3" />Isinna mootumma isixxi ti'ni hite uuriseeshshann moyanjoke kade'eemmaka isika anna shiyeemmaka ja'laabuwwa shiyye. <verse eid="2CH 25:3" /><verse number="4" style="v" sid="2CH 25:4" />Kaddo malee oose insa'nexxa shiyeba'a; oose insa'nexxa shiya waaleechchinna Duuchchi Woddik Gootti Muuseke seerike maxaafa'n, «Hadi hujeexxe balleesaxxee oose, oose hujjeexxe balleesaxxee hadi shiyema hasissabaan; mitti mabnji shiyema hasissaak ifi'a hujeexxe balleesaxxe callinniten» hiyyeexxi haaso'emaka hiyyichcho ulfeesatiten.<note caller="-" style="x"><char style="xo" closed="false">25:4 </char><char style="xt" closed="false"><ref loc="DEU 24:16">Lan. 24:16</ref>. </char></note><verse eid="2CH 25:4" /></para>
  <para style="s1">Edoomi'ni Ke'eeka Lola</para>
  <para style="r">(<ref loc="2KI 14:7">2 Moy. 14:7</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 25:5" />Moyanji Amesiyaasi Yihudiinka arda mitteba bukki asseexxi, mini mini hadishshanni kuma ajajaakaranna dhibba ajajaakaara dhaabati Yihuda duuchcha'ninna Biiniyamike boga'n insa'nee qoode. Ookkonechchi uduma wogga insa'nexxi lame tommennaa ookkoneechchi iima hexxeexxa wogga afeekaara bukki asseexxi lola dande'aka, wontenna bagedo abixxa dande'akaara sase dhibba kuma filemeka manna afeemman. <verse eid="2CH 25:5" /><verse number="6" style="v" sid="2CH 25:6" />Ammaasiyaasi lebeexxi sase kumanna shoole dhibba kiilo sibiljo birrenni Isira'eeli giddii'n dhibba kuma rundik hujaaka lolaaka manna ugge.<verse eid="2CH 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 25:7" />Yaane kinn Mageniink manji Ammaasiyaasibaa dageexxi iso'n hiyyee qici, «Koo moyanjo Duuchchi Woddik Gootti Isira'eelinninna kaddo hoone Efireemike ardinn welti hedha gophaammaxxee kunni Isira'eelik loliink manni atinn welti duuloqqe'e. <verse eid="2CH 25:7" /><verse number="8" style="v" sid="2CH 25:8" />Martetexxi lola mitte godobinni loldotolenna midde injifachchonna inijifatema Magenokenaa'nite kaddeemmaxxee Mageni naaphi atik atee injifataasha assaan.»<verse eid="2CH 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 25:9" />Amesiyaasinna Mageniinka manjo, «Yoona konne Isira'eelike loliinke manni'a uwweennexxi shoole dhibba kiilo sibiljo birre hitta kaddaata?» hiyyee isoo qore.</para>
  <para style="p" vid="2CH 25:9">Iikki Mageniink manjinna, «Duuchchi Woddik Gootti konne maallaqinaa'n calaaka ati'a uwwa dande'aan» hiyye hiise haaso'e.<verse eid="2CH 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 25:10" />Tennexxee Amesiyaasinna Efireemi'ni isibaa dageeka loliinka manna ifi ifike minibaa me'inaashsha asse. Insa'nenna Yihuda'ni lumoshsha mufanteexxi jabaxxe aarenni ifi ifike minibaa ille iima hinge.<verse eid="2CH 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 25:11" />Amesiyaasinna hunna hasissaa qico'n jabeessedheexxi ifika sannachcha Maxinetixxe Dhooqabaa me'e; ookkoonna tomme kuma Seyiirika loliinka manna shiye. <verse eid="2CH 25:11" /><verse number="12" style="v" sid="2CH 25:12" />Yihudak sannachchi wele tomme kuma mannanna booji'e; mitte bowwa'ixxe xungo hananna insa'nee sa'ise butti'a darbe'naa duuchching cancaqemme reye.<verse eid="2CH 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 25:13" />Ookkone wodda Amesiyaasi insa'nenni welti loliinbaa me'abaahsha hoyyeemmak loliink manni Semaariyanaa'n Beetihoroni qico'n hedheeka Yihudiinka qachchuwwa dedhange'n loleexxi kuma manna shiye; hara lumooshsha bira saxxeexxa booji'onna adhdhe.<verse eid="2CH 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 25:14" />Amesiyaasinna Eedoomito bireexxi ille iima higeechchi uduma Seeyirike mannika magenuwwa aadhe dage; ifike magenuwwanna assedhe uurrilsati konneeri'a sagade; tolchakanna konneeri'a shiqise. <verse eid="2CH 25:14" /><verse number="15" style="v" sid="2CH 25:15" />Duuchchi Woddik Gootti Amesiyaasi'n yo'oshsha aareexxi wabeeka isibaa erge; iikkki wabeekinna, «Ifika arda anga atixenaa'ni woda dande'ebaaka gosa gosaka magenuwwa mayee gargaarsa laqexxette?» hiyye.<verse eid="2CH 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 25:16" />Isinna haaso'a'nde'n hedhee'naan moyanji isoo, «Ate moyanjiinke gorsallo assi'nee no'o atee baallonse'neenne? Sammi hitabexxo! Rertotaa hassaate?» hiyye.</para>
  <para style="p" vid="2CH 25:16">Iikki wabeekinna sammi hiyye ka'eexxi, «Tennee assiteetexxeenna gorsa anka a'dhdha gophphetaxxee Mageni atee balleesso'a mureexxa ege'neennen» hiyye.<verse eid="2CH 25:16" /></para>
  <para style="s1">Isira'eeli'n Assemeeka Lola</para>
  <para style="r">(<ref loc="2KI 14:8-20">2 Moy. 14:8-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 25:17" />Ookkoneechchi uduma Yihudak moyanji Amesiyaasi gorsalluwwa ifika mari'achchiiseechchi uduma; Isira'eelik moyanji Iyyuuke beltik belto Iyyu'akaazik belto kadeeke Iyyo'aasibaa, «Amo mee lola welti inbo» hiyye isibaa erge.<verse eid="2CH 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 25:18" />Isira'eelik moyanji Iyyo'aasi kinn Yihudiink moyanjo Amesiyaasi'n hiyye hiissee haaso'ee qici, «Libaanoosik tullichcha'n hana hexxeexxe qu'muudo Libaanoosike Birbirsibaa'a erga ergiteexxi ‹Anke belti'a belto atixxa uwwi› hite laqqe. Yaane kinn mitti biniinchi Libanoosinaa'n dageexxi qu'muudo eettenee hadhe. <verse eid="2CH 25:18" /><verse number="19" style="v" sid="2CH 25:19" />Koo Ammaasiyaasi yoona ati Eedoomito lolde injifateetaxxee ifi dukkee holliteeten; kinni atinge mine'n sammi hite ofo'li! Ate'ninna Yihudiink arda'n rakko geessisaxxa yaane mayee'e halsitaate?»<verse eid="2CH 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 25:20" />Insa'nenna Eedoomitotika magenuwwa mageneefata hanseemmaxxee Mageni insa'ne naaphiinxe anga'ni sa'isse uwwo'a muremmaxxe Amesiyaasi insa'nexxa laqeba'a. <verse eid="2CH 25:20" /><verse number="21" style="v" sid="2CH 25:21" />Tennexxee Isira'eelik moyanji Iyyo'aasi bagedo bane; Isinna Yihudiink moyanji Amesiyaasi Yihuda giddo Betishemeshi hiyyemaaba lola inbe. <verse eid="2CH 25:21" /><verse number="22" style="v" sid="2CH 25:22" />Yihudiink sannachchi lolake'n injifateme; mitti mitting ifi ifike minba'a baaje. <verse eid="2CH 25:22" /><verse number="23" style="v" sid="2CH 25:23" />Isira'eelik moyanji Iyyo'aasinna Akaziyaasik beltika belto Iyyo'asika belto Amesiyaasii'i Beetishemeshi'ni booji'e Iyyerusaalemi'a aadhe dage. Isinna Efireemike dalla'ixxe hulabaa'ni kasiinke dalla'ike hulake kasi qico'n mitte dhibbanna saddeeta tomme meetire<note caller="+" style="f"><char style="fr" closed="false">25:23 </char><char style="ft" closed="false">Ibritotixxi </char><char style="fqa" closed="false">Shoole dhibba kiyuube </char><char style="ft" closed="false">(tinninna 180 meetire qicon hiyyaten)</char></note> qico qeerrinne geyeeka Iyyerussaalemika dallaa diige. <verse eid="2CH 25:23" /><verse number="24" style="v" sid="2CH 25:24" />Isinna galmi giddo hexxeexxa worqenna birreti sibiljo, Obeedi Edoomixxe horte heqqitaammaka galmi giddika miyuwwanna galmi giddixxa karra duuchcha booji'e abidlishatee abixxemmake manninni welti aadhdheexxi Semaariyaa hige.<verse eid="2CH 25:24" /></para>
  <para style="s1">Ammaasiyaasixxa Reyo</para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 25:25" />Yihudiink moyanji Iyyo'asik belti Amesiyaasi Isira'eelik moyanji Iyyo'akaazik belti Iyyo'aasi reyeechi uduma tommenna onde wogga ture. <verse eid="2CH 25:25" /><verse number="26" style="v" sid="2CH 25:26" />Amesiyaasi moye galchemmake baro'ni ke'itokenaa'ni muuxami qico'ni hujeendeexxi wele yaane duuchcha Yihudakenna Isira'eelixee moyanjuwwike maxaafa'n borreessende hexxeen. <verse eid="2CH 25:26" /><verse number="27" style="v" sid="2CH 25:27" />Amesiyaasi Duuchchi Woddika Gootta hordofa waaleechchi uduma Iyyerusaalemi'i giddo iso'ni fuggoxxinn ke'nemmaxxee Lekkishi'a ke'e baaje. Yaane kinni naaphi isik Lekkishi qico'n manna ergine isoo shilshiinse. <verse eid="2CH 25:27" /><verse number="28" style="v" sid="2CH 25:28" />Renshakanna fadhachchoke'n feenne dageechchi uduma isike ediki annuwwishshann Yihudake qachcha'n moogeme.<verse eid="2CH 25:28" /></para>
  <chapter eid="2CH 25" />
  <chapter number="26" style="c" sid="2CH 26" />
  <para style="s1">Yihudiinka Moyanjo Ooziyaa'a</para>
  <para style="r">(<ref loc="2KI 14:21-22">2 Moy. 14:21-22</ref>; <ref loc="2KI 15:1-7">15:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 26:1" />Ookkoneechchi uduma Yihudiink ardi duuchchi tommenna jaane woggaka Ooziyaanii'i isika anna Amesiyaasixxe bakka'ni moyashsha assine. <verse eid="2CH 26:1" /><verse number="2" style="v" sid="2CH 26:2" />Ammasiyaasi ifike edike annuwwishshanni reyeechi uduma, Ooziya, Eelaatika qachcha haaroba qammachcheexxi Yihudiinbaa hiisse.<verse eid="2CH 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 26:3" />Ooziyaani tommenna jaane wogga'n moye; isinna Iyyerusaalemike qachcha'n onde tommenna lame wogga moye galche. Ama isixxi Yikooliyate hinaaxxe Iyyerusaalemii ilendeexxe manjichomman. <verse eid="2CH 26:3" /><verse number="4" style="v" sid="2CH 26:4" />Ooziyaninna anni isik Amesiyaasi assimmashshanni Duuchchi Woddik Gootti edo eloxxa yaane asse. <verse eid="2CH 26:4" /><verse number="5" style="v" sid="2CH 26:5" />Isinna Mageno sodaata barachchsiiseeke Zakaaryaasike baro'ni Mageno halse; Duuchchi Woddika Gootta halseexxe qixxe'n Mageni yaane isixxa qajeelche.<verse eid="2CH 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 26:6" />Ooziya Filisixeemitote'n lola ke'iseexxi Gaatika, Yaabinenikanna Ashidoodika qachchuwwiinka dalla'a diige. Ookkoneechchi uduma Ashedoodi biranna gateeki Filitsixeemik bogi giddo qachchuwwa haaroba ijaare. <verse eid="2CH 26:6" /><verse number="7" style="v" sid="2CH 26:7" />Magenikinna, isi Filisixeemito, Guuriba'aali hedhaammaka Arabakanna Me'unatito injifataashsha asse. <verse eid="2CH 26:7" /><verse number="8" style="v" sid="2CH 26:8" />Amoonito Ooziyaani'a irbo uute; isinna yo'oshsha jajemeemmaxxee gurri isik Gibtse qico'n laqeme.<verse eid="2CH 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 26:9" />Ooziyaaninna Iyyerusaalemi giddo kasiink dalla'iinxe hula'ni, dhooqatik dalla'iinxe hula'ninna dalla'iinxe wirfamiinxe hula'n xelleephphuwwa giissedheexxi tennee xelleephphuwwa kollifachchotixxe asse. <verse eid="2CH 26:9" /><verse number="10" style="v" sid="2CH 26:10" />Iittanni tullichchuwwiinke kasa'ninna diidake'ni heddo lalo afeemmaxxee qiilla gammoojje kinjiinxa xellephphuwwa giisse; heddo wede'iinxa baluwwanna ume. Isinna buttina hucca eeyyammaxxee tullichchuwwake'ninna shamoke boga'ni huccakanna woyinetika hiddichcho kaalsaaka hujalluwwa afeemman.<verse eid="2CH 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 26:11" />Ooziyaaninna, lolakee qophpho'eeka heddo sannachcha afeemman; ookkone sannachchiike mannika summinna moyanjiink borreessanjuwwa kande'eemmake Yi'i'eelinna iikki sooreessi Ma'iseeya borreessinaamman; insa'nek akeekisajinna mootummatike minike hujalluwwinaa'n Hanaaniyatemman. <verse eid="2CH 26:11" /><verse number="12" style="v" sid="2CH 26:12" />Ookkonee sannachuwwa akeeka'emmake mannik laakkossi lame kumnna jaane dhibba mini mini hadike akeekisanjuwwamman. <verse eid="2CH 26:12" /><verse number="13" style="v" sid="2CH 26:13" />Insa'nexxe akeette hunda moyanjiinka naapha lolatee muxxe fuleeka sase dhibba torbaane kumanna onde dhibba gooti loliink manni hedhemman. <verse eid="2CH 26:13" /><verse number="14" style="v" sid="2CH 26:14" />Ooziyaaninna loliinke ifike sannachchi duuchchi'a wonte, bagedo, loliinxa gulle, loliinxa seemma, mogidonna gabe, looyyanna looyati kinjo isi'a qophpheessemman. <verse eid="2CH 26:14" /><verse number="15" style="v" sid="2CH 26:15" />Moyanji Ooziya Iyyerusaalemi giddo angatixxe ogenni muxxe fuleek manni hujeexxi kinjiixe xellephpho'ninna qachchiink dalla'ike kasa'ni mogiduwwakann lumollamma kino darbatendaaka miyuwwa hujise. Tinninna isoo jaba qico jabeeseemmaxxee gurri isik bayyanna ba'la qico'n laqeme.<verse eid="2CH 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 26:16" />Moyanji Ooziya mootumma ifixxa jabeessee wodda hollate'n ke'e; tinni isixxi holla fuggoxxe'n geessise; Duuchchi Woddik Gotta isike Mage'noninna xuurameessake kada gophe; hixaanike tolchimalcho'n hana hixaana guphphatee Duuchchi Woddike Gootike galmi giddi'n hunnati e'yat. <verse eid="2CH 26:16" /><verse number="17" style="v" sid="2CH 26:17" />Ookkone wodda qeesichchi Azaariyaasi godoba jabake kaddeexxe saddeeta tomme qeese welti isoo hordonfe galmi giddi'a e'yine. <verse eid="2CH 26:17" /><verse number="18" style="v" sid="2CH 26:18" />Insa'nenna isoo moromeexxi, «Koo Ooziya! Ati Duuchchi Woddik Gootti'a hixaana guba hasisabaan; tenne'e assinaashsha uwwendeekiir Duuchchi Woddik Gootti'a gargar foyendeexxe Aaroonixxe horetexxa qeese malee'e ati'a hasissabaan; atinna Duuchchi Woddika Gootta balleesitetten galmi giddi'n fuli; tinni Duuchchi Woddike Gootta Mageni darree'ni ulfina ati'a uwwisaaxxebaan» hine.<note caller="-" style="x"><char style="xo" closed="false">26:18 </char><char style="xt" closed="false"><ref loc="EXO 30:7-8">Fula. 30:7-8</ref>; <ref loc="NUM 3:10">Lak. 3:10</ref>. </char></note><verse eid="2CH 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 26:19" />Hixaana gubo'a qophpheefatemak Ooziya mufate; Duuchchi Woddik Goottik galmi giddo hixaana tolchinammak tolchimalchi edo hedhee qeesolete'n hifata'nege'ni albi soomo'e. <verse eid="2CH 26:19" /><verse number="20" style="v" sid="2CH 26:20" />Iikki umi qeesichchi Azaariyasinna wele qeese duuchchi isoo uuddee wodda, alba soomo'eexxa anfe. Tennexxee isoo muddansite gadhi'a fulchite; isi umo ifingeninni Duuchchi Woddik Gootti isoo ganeemmaxxee ookkonn fulo'a muddame.<verse eid="2CH 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 26:21" />Moyanji Ooziyaani reyaaxxe barra qico'n soommakeman. Isinna soomo'emmaxxee galmi giddii'n shorrinemmaxxee qofinni mitte mine'ni ofo'le. Ookkoneechchi uduma belti isik Iyyo'ataami mootummatika minnixxa galcha annoomik adhdheexxi ookkone bogika arda akeeke.<verse eid="2CH 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 26:22" />Ooziyani moyeeke baro'ni ke'itokenaa'n muuxamii qico'n hujendeexxi yaane duuchcha Amootsik belti wabeek Issayaasi borreesse'een. <verse eid="2CH 26:22" /><verse number="23" style="v" sid="2CH 26:23" />Ooziyaninna ifike edike annuwwihshanni lummedhe. Ardikinna «Isi soomake afeedheen» hiyye moyanjuwwiinke hirreesi bira hedheeke booncho'n isoo moonge. Isixxe bakka'ninna belti isik Iyyo'ataami moye.<note caller="-" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="ISA 6:1">Isa. 6:1</ref>. </char></note><verse eid="2CH 26:23" /></para>
  <chapter eid="2CH 26" />
  <chapter number="27" style="c" sid="2CH 27" />
  <para style="s1">Yihudiinka Moyanjo Iyyo'ataamii'i</para>
  <para style="r">(<ref loc="2KI 15:32-38">2 Moy. 15:32-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 27:1" />Iyyo'ataami moyee wodda wogga isixxi lame tommenna ondetemman. Isinna Iyyerusaalemi giddo hedhe tommenna jaane wogga moye galche. Ama isixxinna Yirushaate hiyyendaaxxe Saadoqixxe beltomman. <verse eid="2CH 27:1" /><verse number="2" style="v" sid="2CH 27:2" />Anni isik Ooziya assemmashshanni Duuchchi Woddi Gootti edo eloxxa yaane asse. Kaddo malee'e isike annishsha Duuchchi Woddik Goottik galmibaa e'yeba'a. Ardi kinni balleessa hujatenaa'n udumi'a higebaan. <verse eid="2CH 27:2" /><verse number="3" style="v" sid="2CH 27:3" />Iyyo'ataami Duuchchi Woddik Goottika galmi ali darrexxa hula higgeeni huje; Oofeeli darree'ni hedheek dalla'i hana heddo jijjiirra asse. <verse eid="2CH 27:3" /><verse number="4" style="v" sid="2CH 27:4" />Iittanni Yihudiinke tullichchuwwi hana qachchuwwa, gongomiike boonchuwwa'ninna kolluwwatanna xellephphuwwa ijaare.<verse eid="2CH 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 27:5" />Iyyo'ataami Amoonitotika moyanjo lole injifate. Amoonito wele duuka sase wogga kumanna shoole dhibba kiilo kadaaka birreti sibiljo, mitte miiliyoone kiilo kaddaaxxa dinnenna iittanni mitte miiliyoone kiilo kadaaka so'a isi'a irbo iyyedange. <verse eid="2CH 27:5" /><verse number="6" style="v" sid="2CH 27:6" />Iyyo'ataami Duuchchi Woddike Gootta ifike Mageni edo xuurameessummati me'emmaxxee jabaata'ni me'e. <verse eid="2CH 27:6" /><verse number="7" style="v" sid="2CH 27:7" />Iyyo'ataami moye galcheeke baro'ni assendeexxi wele yaane, isi loleeki lolinna hujeexi huje duuchcha Isira'eelikenna Yihudiinke moyanjuwwiinke maxaafa'ni borreessende'een. <verse eid="2CH 27:7" /><verse number="8" style="v" sid="2CH 27:8" />Isinna moyee wodda wogga isixxi lame tommenna ondetemman. Isinna Iyyerusaalemi giddo hedhe tommenna jaane wogga moye galche. <verse eid="2CH 27:8" /><verse number="9" style="v" sid="2CH 27:9" />Iyyo'ataami isike edike annuwwishshanni reyeexxi Daawwitike qachcha'n moogeme. Isixxe bakka'n belti Akaazi moye.<verse eid="2CH 27:9" /></para>
  <chapter eid="2CH 27" />
  <chapter number="28" style="c" sid="2CH 28" />
  <para style="s1">Yihudaka Moyanjo Akaazii</para>
  <para style="r">(<ref loc="2KI 16:1-4">2 Moy. 16:1-4</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 28:1" />Akaazi moye wodda wogga isixxi lame tommemman. Isinna Iyyerusaalemii giddo tommenna jaane wogga moye galche. Anna ifike moyanjo Daawwitishsha Duuchchi Woddike Gootti edo eloxxa yaane assebaan. <verse eid="2CH 28:1" /><verse number="2" style="v" sid="2CH 28:2" />Isinna Isira'eelike moyanjuwwika elobaaka adaba hordofe; Ba'aali hinaake magenuwwika megenoofate bonce giissineexxa fakkuwwa giissedhe. <verse eid="2CH 28:2" /><verse number="3" style="v" sid="2CH 28:3" />Duuchchi Woddik Gootti Isira'eelik ardi edii'n fugusseemmaka gosa gosake ardika galduma hordofati Been Heenoonnixxe Dhooqqa'ni hixaanna gube; labbaxxa ifixxa oosenna ciincatike tolcha asseexxi shiqise. <verse eid="2CH 28:3" /><verse number="4" style="v" sid="2CH 28:4" />Tullichchuwwake'n magenoonfantammaba koobatixxe xungo'ni hana haqichchuwwiink gaadisuwwi hunda tolcha shiqiseexxi hixaanakanna gube.<verse eid="2CH 28:4" /></para>
  <para style="s1">Sooriya'ninna Isira'eeli Yihudaa'a Lolle Injifanneexxa</para>
  <para style="r">(<ref loc="2KI 16:5">2 Moy. 16:5</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 28:5" />Tennexxe Duuchchi Woddiki Gootti isik Mageni Sooritotik moyanjixxe anga'n iso'o sa'isse uwwe: Sooritotinna isoo injifate; insa'nenna isike ardanaa'ni heddo manna boojineexxi Demasiqo'a aadhe me'ine. Higgeenni Isira'eelike moyanjixxe anga'ni isoo sa'isse uwwe: isinna jaba qicini insa'nee lole miidhdhe. <verse eid="2CH 28:5" /><verse number="6" style="v" sid="2CH 28:6" />Yihudanna edike annuwwika Duuchchi Woddika Gootta Mageno waaleemmaxxee Roomeliyuk belti Faaguhe mitte barra'ni dhibbanna lame tomme kuma loliinka Yihudiinka manna shiye.<note caller="-" style="x"><char style="xo" closed="false">28:6 </char><char style="xt" closed="false"><ref loc="ISA 7:1">Isa. 7:1</ref>.</char></note> <verse eid="2CH 28:6" /><verse number="7" style="v" sid="2CH 28:7" />Efireemixxe gosa kadeeki Zikirite hiyyemaak mitti Isira'eelik loliink manji moyanjo Akaazika belto Ma'iseyaanii, mooteummatik minika sooreesa kadeeka Azaariqaaminenna baalleti moyanjiinke langaba hedheeka Hilqaanaa shiye. <verse eid="2CH 28:7" /><verse number="8" style="v" sid="2CH 28:8" />Ayihuudi fira insa'nekenna kandoole midde Isira'eelik loliink manni insa'nenaa'n lame dhibba kuma aro'o affeexxa melaalluwwanna miyyaxxanna labbaxxa oose boojine; iittanni heddo booji'o adhdhine Semaariya hinge.<verse eid="2CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 28:9" />Oodeedi hinaak Duuchchi Woddik Goottik wabeek ookkoo hedhemmaxxee sannachchuwwi Semaariyaa higee wodda qophedhatee fuleexxi insa'nee hiyyee qici, «Annuwwi ha'nookik Duuchchi Woddik Gootti Mageni Yihudiink arda'ni mufateemmaxxe'e insa'ne anga ha'nooxxen sa'isse uwween ha'noo kinni jabaxxe aarenne insa'nee shiltine birtine. <verse eid="2CH 28:9" /><verse number="10" style="v" sid="2CH 28:10" />Ta'anna Yihudiinka ardanna Iyyerusaalemika labballonna melaalle garba ha'nooke assitino'a heddina'neen. Yaane kinn ha'nooka Duuchchi Woddika Gootta Mageno balleesitineexxi balleessa ha'noo giddo hexxebaata? <verse eid="2CH 28:10" /><verse number="11" style="v" sid="2CH 28:11" />Yoona hiyyaannexxa laqqe Duuchchi Woddike Gootti aare ha'noo'ni bubbeeenaaxxe'e boojitine dagineemmaka fira ha'nooka ifi ifike boonchibaa hiisse.»<verse eid="2CH 28:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 28:12" />Ookkoneechchi uduma Efireemike akeekisanjuwwanaa'ni heenooki Yihohanaanik belti Azaariyasi, Shilemootik belti Bereekiya, Seeloommik belti Yihiziqiyya, Hadilayik belti Ameessayi lolakenaa'ni higeekaara ginbeexxi, <verse eid="2CH 28:12" /><verse number="13" style="v" sid="2CH 28:13" />insa'nee hinee qici: «Konnee boojitineeka manna kabaa aaxxine dagginaammabaan! Konneechchi edo cubbo hunje Duuchchi Woddika Gootta yaadinsennaxxee mufe isixxi no'o'ni gelteen; ta'atenna kaddoole balleesande'n hana balleessa hunjonnaa hassina'nee?»<verse eid="2CH 28:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 28:14" />Tennexxe loliink manni usuremeemmaka mannanna boojinemmaka manna ardi edonna akeekisano edo hiisine. <verse eid="2CH 28:14" /><verse number="15" style="v" sid="2CH 28:15" />Ookkoneechchi uduma konnee shoole manna usuremeeke manni'a boojinemachchonaa'ni duwwi hedhemmake hasisaachcho duuchcha uunaashsha assine; insa'neenna seemmatanna kophe, indaachchonna ha'winaachcho uune; ejersiinxa zayite issine, dande'e me'a gopheeka duuchcha harrete'ni gulufinseexxi meexxetike qachcha hiyyemmaak Iyyaarikoke qachchiba insa'nee wirri assine hiisine. Ookkoneechchi uduma Isira'eelito edo he'naamake ifike qachchak Semaariyaa higge.<verse eid="2CH 28:15" /></para>
  <para style="s1">Akaazi Asoori Gargarsa Laqedheexxa</para>
  <para style="r">(<ref loc="2KI 16:7-9">2 Moy. 16:7-9</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 28:16" />Eettenne yanna moyanji Akaazi Asoorike moyanjibaa erga ergeexxi gargaarsa laqedhe. <verse eid="2CH 28:16" /><verse number="17" style="v" sid="2CH 28:17" />Eedoomito higge daggeexxi Yihuda lolide miite heddo manna boojite adhdhite me'itemman. <verse eid="2CH 28:17" /><verse number="18" style="v" sid="2CH 28:18" />Eettene yanna Filisixeemito tullichchuwwiinke kasa'ninna Yihuda'n bita'i darre'ni hedheeka qachchuwwa abixxiyyot Beetishemeshii, Ayyaaloonii, Gederootii, Sooko, Timinaan, Gimizaanna konne qachchuwwike loolake'ni hedhemmaka shiixxarra qachchuwwa duuchcha abixxine, ofolle. <verse eid="2CH 28:18" /><verse number="19" style="v" sid="2CH 28:19" />Yihudak moyanji Akaazi boga isike'n elobaaxxa yaane huja'ni turemmaxxee Duuchchi Woddik Gootti'a xuurameessumma xe'insheemmaxxee Duuchchi Woddik Gootti Yihudaa salphise. <verse eid="2CH 28:19" /><verse number="20" style="v" sid="2CH 28:20" />Asoorik moyanji Teeligeliti Peliseerem Akaazi'ni rakko geessisse malee gargaareban. <verse eid="2CH 28:20" /><verse number="21" style="v" sid="2CH 28:21" />Tennexxe Akaazi Duuchchi Woddike Goottik galmanaa'ni, mootummatik minena'ninna hayyooletenaa'ni heenooka miyuwwa adhdheexxi Asoorike moyanji'a uwweemman; kaddo malee tinni isi'a la'ote'ni hosseexxebaan.<verse eid="2CH 28:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 28:22" />Moyanji Akaazi rakko iso'ni itti bira saxxemma wodda Duuchchi Woddik Gootti'a afeexxa addatensha edi erra saxxeexxa cubbo huje. <verse eid="2CH 28:22" /><verse number="23" style="v" sid="2CH 28:23" />Akaazinna, «Sooriyake moyanjuwwik magenuwwi insa'nee gargaaremmaxxee aneenna gargaraashsha tolcha shiqisannon» hiyya'ni isoo injifatee ke'e Demasiqok magenuwwi'a tolcha shiqise; yaane kinni kunni magenuwwi isi'anna Isira'eeliike ardi duuchchi'a goofoke kade.<verse eid="2CH 28:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 28:24" />Akaazi Mageniika galmika miya duuchcha mitteba bukki asseexxi aadhe; Duuchch Woddike Goottike galmixxa huluwwanna cufe; Iyyerusaalemike orike wirfama duuchcha'n tolchimalcho uurrise. <verse eid="2CH 28:24" /><verse number="25" style="v" sid="2CH 28:25" />Yihudiinke qachchuwwa duuchcha'ni wele magenuwwi'a ciinca tolcha tullichchuwwake'n magenoonfantaaka booncho giisse; tenne buutonni Akaazi edike annuwwika Duuchchi Woddika Gootta Mageno mufachchiise.<verse eid="2CH 28:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 28:26" />Akaazi moye galchammake baro'ni ke'itokenaa'ni muuxami qico'n hujende muuxendeexxi wele yaane duuchcha Yihudakenna Isira'eelik moyanjuwwike jirtetike maxaafa'ni borreessendeen. <verse eid="2CH 28:26" /><verse number="27" style="v" sid="2CH 28:27" />Moyanji Akaazinna edike isike annuwwishshanni lummedhe. Isinna moogemiyyo hasissaaba moyanjuwiinke hirreesa'nite kaddaa wodda isi Iyyerusaalemike qachcha'n moogeme. Isixxe bakka'ninna belti isik Hiziqiyaasi moye.<note caller="-" style="x"><char style="xo" closed="false">28:27 </char><char style="xt" closed="false"><ref loc="ISA 14:28">Isa. 14:28</ref>. </char></note><verse eid="2CH 28:27" /></para>
  <chapter eid="2CH 28" />
  <chapter number="29" style="c" sid="2CH 29" />
  <para style="s1">Yihudaka Moyanjo Hiziqiyaasii</para>
  <para style="r">(<ref loc="2KI 18:1-3">2 Moy. 18:1-3</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 29:1" />Hiziqiyaasi moyee wodda wogga isixxi lame tommenna ondetemman. Isinna Iyyerusaalemi giddo lame tommenna sallane wogga moye galche. Ama isixxinna Abiya hinaaxxe Zakaaryaasixxe beltomman. <verse eid="2CH 29:1" /><verse number="2" style="v" sid="2CH 29:2" />Hiziqiyaasinna anni Daawwiti eloxxa assemmashshanni isinna Duuchchi Woddike Gootti edo eloxxa yaane asse.<verse eid="2CH 29:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 29:3" />Hiziqiyaasi moye galcheek siretixxe wogga'ni sirtike agenjo'n Duuchchi Woddike Goottike galmixxa huluwwa bane qammachche. <verse eid="2CH 29:3" /><verse number="4" style="v" sid="2CH 29:4" />Isinna qeesoletanna Leewwito boroti darre'ni hedheeke galmik ba'linaa'ni bukki asseexxi, <verse eid="2CH 29:4" /><verse number="5" style="v" sid="2CH 29:5" />Insa'nee hiyyee qic, «Ha'noo Leewwito laqqe! Ta'a tennee ifi woyyoonse; edike ha'nook Duuchchi Woddike Gootti Magenika galma woyyoonse. Battitte yaanenna duuchcha galmakenaa'ni fugusse. <verse eid="2CH 29:5" /><verse number="6" style="v" sid="2CH 29:6" />Ediki no'ok annuwwi xuurammeesumma xe'inshe'een; insa'nenna Duuchchi Woddik Gootti Mageni edo fuggoxxa assinen; isoonna waalle Duuchchi Woddik Goottike galma'n dudduro wirri assine. <verse eid="2CH 29:6" /><verse number="7" style="v" sid="2CH 29:7" />Insa'nenna galmiinxa huluwwa cunfe; xassuwakanna xolsine. Isira'eelik Mageni'a hixaana gunbebaan; galmi giddo ciinceessinka tolcha shiqinsebaan. <verse eid="2CH 29:7" /><verse number="8" style="v" sid="2CH 29:8" />Tenne buutonni Duuchchi Woddik Goottixxi mufe Yihuda'ninna Iyyerusaalemi'ni gelte. Ha'noonna uuddina'neeshshanni isi insa'nee soda'atee, alayyokeenna culphisatee sa'isse uwwe. <verse eid="2CH 29:8" /><verse number="9" style="v" sid="2CH 29:9" />Tennexxe edik annuwwi no'ok bagedoke'ni renne; labbaxxinna meyyaxxi oose no'oxxi, aruwwa no'oxxinna booji'ende. <verse eid="2CH 29:9" /><verse number="10" style="v" sid="2CH 29:10" />Ta'inni udumi'a mufe no'onaa'ni higgaashsha ta'a yoona Duuchchi Woddike Gootta Isira'eelike Mageninni welti kako aagonnaa mudhdheennen. <verse eid="2CH 29:10" /><verse number="11" style="v" sid="2CH 29:11" />Tee anxe oose! Isi edo uurirtino'anna isi'a ergatendino'a; isi edo ergatendinaake kaddinaashshanna isi'a hixaana isi'a gubbino'a Duuchchi Woddik Gootti ha'noo fileemmaxxee ga'ma'mi hitinoqqe'e.» <verse eid="2CH 29:11" /><verse number="12" style="v" sid="2CH 29:12" />Konneechchinni butti'a hexxeexxi Leewwito hujete'ni bobbaate, Qe'atixxe hortenaa'ni Amaasik belti Mahaatinna Azaariyaasik belti Iyyu'eeli,</para>
  <para style="q1" vid="2CH 29:12">Meeraarixxe hortenaa'n Abidik belti Qiishinna Yihaleelik belti Azariyaasi,</para>
  <para style="q1" vid="2CH 29:12">Gershoonixxe hortenaa'n Ziimak belti Yo'ahinna Yu'aaki belti Eedeni;<verse eid="2CH 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2CH 29:13" />Elitsafaanixxe hortenaa'n Shiirina Yi'i'eeli;</para>
  <para style="q2" vid="2CH 29:13">Asaafixxe hortena'n Zakaaryaasinna Metaaniya; <verse eid="2CH 29:13" /><verse number="14" style="v" sid="2CH 29:14" />Hemaanixxe hortenaa'n Yihi'eelinna Seme'i, Edotaamixxe hortenaa'ni Shemayanna Uzu'eeliten.<verse eid="2CH 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 29:15" />Kunni manni dayyuwwa ifi fika bukki assine'e ifi qullonsineechchi uduma moyanji Duuchchi Woddike Goottika hiyychcho hordofe ajajemmaashshanni Duuchchi Woddike Goottika galma qullonsatee eiyine. <verse eid="2CH 29:15" /><verse number="16" style="v" sid="2CH 29:16" />Qeesetinna Duuchchi Woddike Gootika galma qullonsatee giddi'a e'yine; Duuchchi Woddike Goottik galmi giddo afendaa'neexxa heene batte yaanenna Duuchchi Woddike Goottik galmi edo aa'ne fulchine. Konne batto'emmachcho Leewwito dukke aaxxe me'iteexxi Qeedironixxe dhooqa giddo hunde.<verse eid="2CH 29:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 29:17" />Qulleessatixxi huje siretike agenjo'ni siretixxe barra'ni sanfeexxi ookkone agenjo'ni saddeetixxe barra'ni galmi giddi'a e'yinammaxxe kutaninni madadiinga hunje birre. Galmiinxi huje siretike agenjo'n tommenna jiyaxxe barra'n muuxende.<verse eid="2CH 29:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 29:18" />Qeese hujende muuxendeexxe hujexxee moyanjo Hiziqiyaasibaa martee hitee qici, «Duuchchi Woddike Goottika galma duuchcha ciincatik tolchi shiqaak tolchimalcho miyyuwwi duuchininn woyyitte kebbo ugginaake beera miyuwingininn qulleessineennen. <verse eid="2CH 29:18" /><verse number="19" style="v" sid="2CH 29:19" />Moyanji Akaazi Duuchchi Woddik Gootti'a xuurameessake kadebaaxxa wogguwwa aadhdheexxi hedhemmaka miyuwwa duuchcha qophpheesine woyyoonsine'eennen; kunnise kunni miyuwwi duuchchi Duuchchin Woddike Goottike galmike tolchimalchi edo hedheen.»<verse eid="2CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 29:20" />Langa baro bariisa moyanji Hiziqiyaasi qachchiink jalqaabuwwa mitteba bukki asseexxi Duuchchi Woddik Goottik galmibaa aadhe me'e. <verse eid="2CH 29:20" /><verse number="21" style="v" sid="2CH 29:21" />Insa'nenna mootummatixxee, galmiinxenna Yihudaxxee torbaane jiboota, torbaane gedhebiinxa korbeeyye, torbane gedhebiinka biruusa torbaane re'etika buruusa cubbo biratik tolchi'a shiqinse; moyanjinna konneera Duuchchi Woddike Goottike tolchimalcho'ni shiqinsaashsha Aaroonixxa horte, qeese ajaje. <verse eid="2CH 29:21" /><verse number="22" style="v" sid="2CH 29:22" />Qeestinna jiboota gorraateexxi munde aaxxeexxi tolchimalchoke'n hana fixxe; langaba gedhebiinxa korbeeyye gorraateexxi munde tolchimalchoke'n hana fixxe. Iittanni konnee buruusuwwanna gorraneexxi munde tolchimalchoke'n hana fixxe. <verse eid="2CH 29:22" /><verse number="23" style="v" sid="2CH 29:23" />Cubbotik tolchi'a kaddaaxxa re'e moyanji edonna ya'i edo shiqinse; insa'nenna anga ifixxa tenne re'e hana uggine. <verse eid="2CH 29:23" /><verse number="24" style="v" sid="2CH 29:24" />Moyanji ciincatika tolchanna cubbotika tolcha Isira'eelito duuchchi'a shiqaasha ajajemmaxxee, qeese re'e gorraateexxi Isira'eelito duuchchixxa cubbo birate kaddaashsha cubbotike tolchi'a munde tolchimalchi hana shiqishshe.<verse eid="2CH 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 29:25" />Moyanji Hiziqiyaasinna Duuchchi Woddi Gootti leella uudammake Gaadii darree'ninna wabeeka Naatanii darree'n moyanjo Daawwiti'a uwweekanna Daawwiti hujete'n hosiseeka ajajuwwa duuchcha hordofat lumoke kiraara, qilillisanna masinqoti muxxe fuleekaara Leewwito Duuchchi Woddike Goottike galmi giddo ugge. Kunni Duuchchi Woddik Gootti wabeeko ifixxi darree'n sa'iseemmake ajajin. <verse eid="2CH 29:25" /><verse number="26" style="v" sid="2CH 29:26" />Tennexxee Leewwito Daawwitika faarsatika miyuwwa qeesetinna malagatuwwa abixxitee qophpheefattexxi uurrite.<verse eid="2CH 29:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 29:27" />Konneechchi uduma moyanji Hiziqiyaasi ciincesiinaaka tolcha tolchimalchoke'ni shiqinsaashsha ajaje; tolchikinna ciinco'e safee wodda Isira'eelika moyanjo, Daawwitike faarotike miyuwwinninna malagatik qoqqobendeexxi galatiinxi faaro safende. <verse eid="2CH 29:27" /><verse number="28" style="v" sid="2CH 29:28" />Faarsaleeyye faarsita'naanna malagata ufuufammaakir ufuufaa wodda ya'a duuchchi gonbisemeexxi sagade. Ciincati tolchi ciinco'e luggaa qico'ni tinni duuchchi assende.<verse eid="2CH 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 29:29" />Tolcha shiqammaxxi huje muuxendeechchi uduma moyanji Hiziqiyaasinna isinni welti hedhemmak duuchchi guluffate Mageno sagande. <verse eid="2CH 29:29" /><verse number="30" style="v" sid="2CH 29:30" />Moyanji Hiziqiyaasinna ardiinxi akeekisanjo duuchchi, Leewwito, Daawwitikenna leella uudammake Asaafike hiyyichchishsha, Duuchchi Woddik Gootta galateefantaashsha ajaje. Insa'nenna faaro gammadik faarsine; gombiseme sagande.<verse eid="2CH 29:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2CH 29:31" />Ookkoneechchi uduma Hiziqiyaasi insa'nee'e, «Ta'a hanoo Duuchchi Woddike Gooti'a ifi woyyensitineen; ta'anna shiqqe; galatakanna tolcha Duuchchi Woddike Gootti'a galmibaa iyyedage» hiyye. Tennexxee ya'i tolchakanna galatiinxa uwwa iyyedange; ifixxe fedheenni uwwo'a haseek duuchchiing ciincatika tolcha iyyedagge.<verse eid="2CH 29:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 29:32" />Konne qicinni ardi ciincatike tolchi'a shiqiseemmak hori torbaane tomme jiboota, dhibba gedhebiinxa korbeeyyenna lame dhibba gedhebiinka buruusuwamman; kunnichchuwwi duuchchi Duuchchi Woddike Gootti'a ciincatike tolcha kade'e shiqa'emmakemman. <verse eid="2CH 29:32" /><verse number="33" style="v" sid="2CH 29:33" />Tolchakee woyyoonsemeammak hori jaane dhibba jibootanna sase kuma gedhebiinxe korbeeyyemman. <verse eid="2CH 29:33" /><verse number="34" style="v" sid="2CH 29:34" />Kaddo malee'e qeese konne hore duuchcha gorraate duldaaxxi heenooxxe kaddeemmaxxee, tennexxee insa'neka fira kaddeexxi Leewwito huje muddaa qico'ninna wele qeese ifi luqqi assexxaa qico'ni insa'nee gargaarte. Leewwitonna ifi luqqi assedhatee qeeseti irra yo'oshsha ifi xonxoommattaamman. <verse eid="2CH 29:34" /><verse number="35" style="v" sid="2CH 29:35" />Ciincesinaake tolchi welti shiqaaka mittoomiinka tolcha ha'yonna ha'watika tolchinn mitteba ciincesemaak tolchi yo'osha bira sa'eekemman.</para>
  <para style="p" vid="2CH 29:35">Konne qicinni Duuchchi Woddik Goottik galmiinxi ergatensha haarooba safendeemman. <verse eid="2CH 29:35" /><verse number="36" style="v" sid="2CH 29:36" />Moyanji Hiziqiyasinna ardi yaane duuchcha ariifatte muuxendaasha Mageni insa'nee gargaaremaxxee yo'oshsha gammande.<verse eid="2CH 29:36" /></para>
  <chapter eid="2CH 29" />
  <chapter number="30" style="c" sid="2CH 30" />
  <para style="s1">Hiziqiyaasi Sa'atika Ayyaana Ulfeesseexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 30:1" />Hiziqiyaasi Duuchchi Woddika Gootta Isira'eelike Magenika sa'atika ayyaana ulfeesatee Iyyerusaalemii hedheek Duuchchi Woddike Goottika galmibaa daggaasha Isira'eelito duuchchi'anna Yihudaa erga erge. Iittanni Efireemi'anna Minaase'a borro borreese. <verse eid="2CH 30:1" /><verse number="2" style="v" sid="2CH 30:2" />Moyanji, ja'laabuwwinna Iyyerusaalemik ya'i duuchchi sa'atika ayyaana langake agenjo'n ulfeesatee weli aange. <verse eid="2CH 30:2" /><verse number="3" style="v" sid="2CH 30:3" />Ifi luqqi assexxemmaxxe qeesek lakkossi geyaake kada gopheemmaxxeenna ardikinna Iyyerusaalemi bukki hiyya gophemmaxee ayyana yannate'n ulfeessa dandeenneemmaba'a.<note caller="-" style="x"><char style="xo" closed="false">30:3 </char><char style="xt" closed="false"><ref loc="NUM 9:9-11">Lak. 9:9-11</ref>. </char></note> <verse eid="2CH 30:3" /><verse number="4" style="v" sid="2CH 30:4" />Moyanjikinna ardi duuchchi yaadi toggichchake kadeexxa anfe. <verse eid="2CH 30:4" /><verse number="5" style="v" sid="2CH 30:5" />Tennexxee Duuchchi Woddika Gootta Isira'eelike Magenika sa'atika ayyaana ulfeessatee ardi dagaashsha Bersaabehi'ni Daani qico'ni lassinaashsha murre. Borreessendema qicnni ookkone ayyaana heddi manni ulfeesse ege'nemmabaan.<verse eid="2CH 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 30:6" />Moyanjiinke ajajinn erganjuwwi kinni moyanjiinkanna ja'laabiinxa borro aadhdhine Isira'eelikenna Yihudake bogibaa me'ine; iitti borrotinna hitaamma qici, «Koo Isira'eelike arda! Isi ha'noo booji'otenaa'ni gattineeka Asoorike moyanjuwwixxe angana'ni fuldineekibaa higaashsha ha'noonna Abirihaamik, Yisihaqikenna Isira'eelike Duuchchi Woddika Gootta Magenibaa higge. <verse eid="2CH 30:6" /><verse number="7" style="v" sid="2CH 30:7" />Ha'no uuddina'neeshshanni osolemmaake assaa qico'n Duuchchi Woddika Gootta ifike edike annuwwike Mageni'a xuurameeyyete kada gonpheemmake edike ha'nooke annuwwishshanna ha'nooke dayyuwwishsha kaddinoqqe'e. <verse eid="2CH 30:7" /><verse number="8" style="v" sid="2CH 30:8" />Edike ha'nooke annuwwishshanni gooba micciirtinoqqe'e Duuchchi Woddik Gootti'a ajajemme; isi duuchchi woddi'a woyyoonseeke woyyichchi galmibaanna amme. Ta'inni udumi'a Duuchchi Woddike Gootta ha'nooke Magenixxi sodaachchissaaxxi mufe ha'nonaa'n higgaashsha isoo calla ergatemme. <verse eid="2CH 30:8" /><verse number="9" style="v" sid="2CH 30:9" />Ha'noo Duuchchi Woddike Goottibaa higginoole isi ba'lakenna shaqqake kademmaxxee dayyuwwa ha'nookanna oose ha'nooxxa booji'emmake manninaa'n insa'ne mararte alfinaan; konne bogiba'aanna illeema hingaan. Ha'noonna Duuchchi Woddika Gootta ha'nooke Magenibaa higginoole isinna dudduro ha'noo'ni wirri hiyyabaan.»<verse eid="2CH 30:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 30:10" />Erganjuwwikinna Efireemikenna Minaaseke boga'ni hedheeke mitte qachchanaa'n mitte qachchibaa mareexxi middi darre'n Zabilonike bogi qico'n me'e. Ardi kinni insa'ne'e tuffatee gacifate. <verse eid="2CH 30:10" /><verse number="11" style="v" sid="2CH 30:11" />Kaddo malee Aseeri'ni, Minaase'ninna Zabiloni'ni heenooki manni ifi heeshsh asse Iyyerusaalemi'a dage. <verse eid="2CH 30:11" /><verse number="12" style="v" sid="2CH 30:12" />Ittanni moyanjikinna ja'labuwwi Magenke hiyyichchishsha ajajemmaxxa muuxaashsha, insa'ne mitte godoba kandaaashsha Duuchchi Woddike Goottiixxi anga Yihuda'ni hexxemman.<verse eid="2CH 30:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 30:13" />Langake agenjo'ni kebbootika ayyaana ulfeessatee hara bira sa'eek manni Iyyerusaalemii bukki hiyye. <verse eid="2CH 30:13" /><verse number="14" style="v" sid="2CH 30:14" />Insa'nenna Iyyerusaalemi giddo magenoofantammaxxa fakkuwwanna tolchimalchwwa gonsheexxi iittanni hixaana gunbamachchuwwa boonchokenaa'n goggonshexxi Qeediroonixxe dhooqa'ni hunne.<verse eid="2CH 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 30:15" />Langake agenjixxe tommenna sholgaxxe barra'ni sa'atike ayyanika korbeessa dulle. Ookkone wodda qeesenna Leewwito ifi ca'a assedha gophat shookemmaxxee ifi qullonsexxe; ookkoneechchi uduma insa'ne ciincatika tolcha Duuchchi Woddike Goottike galmibaa aa'ne dange. <verse eid="2CH 30:15" /><verse number="16" style="v" sid="2CH 30:16" />Ookkoneechchi uduma Magenk manji Muuse uwweeke seershshanni galmi giddo insa'ne'a uwwemeeke booncho'ni uurrite; leewwitonna tolchiinxa munde qeesetee shiqisse. Qeesenna Leewwito munde tolchimalchoke'ni fixxe. <verse eid="2CH 30:16" /><verse number="17" style="v" sid="2CH 30:17" />Ya'i giddi'n heddi manni seeriinsha ifi ca'a assedha gopheemaxxee sa'atike ayyani'a kaddaaxxa gedhebiinka buruusuwwa gorra'atee insa'ne'a eettii uwwendeemmabaan. Tennexxee Leewwito insa'nexxe bakka'ni gedhebiinka buruusuwwa gorra'ati Duuchchi Woddike Gootti'a shiqisse.<verse eid="2CH 30:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 30:18" />Higgeeni Efireemike, Minaasek, Yisakoorikinna Zabilonike boganaa'ni dageeranaa'ni heddi manni ifi ca'a assebaakenna kaddoole borreessemeeke ajaji gadho sa'atike ayyaanixxa ita inde. Hiziqiyaasi kinni hiyye soodatee qici, «Eloke Duuchchi Woddik Gootta insa'ne'a gattowwaal hiyyi; <verse eid="2CH 30:18" /><verse number="19" style="v" sid="2CH 30:19" />edike annuwwa insa'nekike Duuchchi Woddike Gootta Mageno! Kunni manni aadatishsha ifi ca'a assedha gophoolenna midde mitte godobinni atee magenoofata'neekeeran. Tennexxee insa'nee atixxe ellenni gattowwaal hiyyi!» hiyya'ni soodate. <verse eid="2CH 30:19" /><verse number="20" style="v" sid="2CH 30:20" />Duuchchi Woddik Goottinna Hiziqiyaasixxa soodachcho laqeexxi ardakee gattowwaal hiyye.<verse eid="2CH 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 30:21" />Leewwitonna qeese Duuchchi Woddike Gootti'a faarsinammake miyuwwinni qoqqobemme barra barra'ni Duuchchi Woddike Gootti'a faarsina'ni Iyyerusaalemi giddo hexxemaxxi Isira'eelito kebbootika ayyaana lumoxxe gammashshonni torbaane barra ulfeessine.<verse eid="2CH 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 30:22" />Hiziqiyaasinna Duuchchi Woddike Gootti'a ergatenshatixxa qalbeeffachcho affemaxxa leewwito duuchcha jajjabeessaaka haaso'a haaso'e. Insa'nenna torbaaniixa barra insa'ne'a uwwemeeka qoobbo inda'ninna mittoomiinka tolcha shiqinsha'ni edike annuwwika Duuchchi Woddika Gootta Mageno galateefante.<verse eid="2CH 30:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 30:23" />Ya'i duuchchinna weli duuka torbaane barra ayyaana higgeenni ulfeessatee weli aange. Tennexxee ayyaana torbaane barra'a higgeenni lumoxxe gammashshonn ulfeessine. <verse eid="2CH 30:23" /><verse number="24" style="v" sid="2CH 30:24" />Yihudiink moyanji Hiziqiyaasi mitte kuma jibichcha, torbaane dhibba gedhebonna re'e ya'a fuleeke manni'a uwwe. Ja'laabuwwikinna ittanni mitte kuma jiboota, tomme kuma gedhebiinxa korbeeyyenna re'e uune. Hara yo'oxxi qeesenna ifi woyyoonsite. <verse eid="2CH 30:24" /><verse number="25" style="v" sid="2CH 30:25" />Tennexxee duuchching Yihudiinke bogik ardi, qeesenna leewwito, Isira'eelike boganaa'ni bukki hiyyeek ya'i duuchchi, iittanni Isira'eelike boganaa'ni dageek wele bogik manninna Yihudiinke boga'ni hedha'neek wele bogik manni yo'oshsha gammade. <verse eid="2CH 30:25" /><verse number="26" style="v" sid="2CH 30:26" />Isira'eelike moyanjo, Daawwitike belto Solomoonike baronaa'ni saffe iita hedheeke ayyaani Iyyerusaalem giddo ulfeessema gopheemmaxxee Iyyerusaalemi lumoxxi gammashsha kadde. <verse eid="2CH 30:26" /><verse number="27" style="v" sid="2CH 30:27" />Ookko'ninna qeesenna leewwito kexxe uurriteexxi Duuchchi Woddike Goottika arda eebbissaashsha soodatte. Duuchchi Woddik Goottinna woyyichcha galduma ifike'ni iima hedhee soodachcho insa'nexxa laqe.<verse eid="2CH 30:27" /></para>
  <chapter eid="2CH 30" />
  <chapter number="31" style="c" sid="2CH 31" />
  <para style="s1">Moyanji Hiziqiyaasi Asseexxa Haaro'ma</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 31:1" />Ayyaaniinxe muuxema uduma ookkoo hexxemmaxxi Isira'eelito Yihudiinke qachchuwwibaa marteexxi magenoofantammaxxa soodduwwa enqite; Asheeraxxe soodoxxa misiluwwa butuchchite. Ittanni Yihudiinke boga duuchcha'ninna Biniyaamike, Efireemikenna Minaaseke boga'ni hedheeka tullichchuwwake'n magenoofantammaka boonchuwwanna tolchimalchuwwa balleessine; Isira'eelito konneechcho duuchcha balleesiteechchi uduma ifike qachuwwibaanna bogibaa higge.<verse eid="2CH 31:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 31:2" />Moyanji Hiziiqiyaasi qeesenna Leewwito ciincatika tolchanna mittomiinka tolcha shiqinsaashsha, ergatendaashshanna galateefattaashsha ittanni Duuchchi Woddike Goottike galmi giddo faarsitaashsha qeesenna kadi leewweto mitti mittinga huje huje insa'nexxishshanni ugge. <verse eid="2CH 31:2" /><verse number="3" style="v" sid="2CH 31:3" />Duuchchi Woddik Goottik seera'ni borreesendemmashshanni moyanji gorsanna galgala iittanni edike sanbata sanbata'n, haarooxxi baate fuldammake ayyaana'ninna, mureemek ayyaanuwwa'n ciincatee shiqaaka tolcha moyanji Hiziqiyaasi ifixxe karranaa'n uwwe.<note caller="-" style="x"><char style="xo" closed="false">31:3 </char><char style="xt" closed="false"><ref loc="NUM 28:1-29:39">Lak. 28:1—29:39</ref>. </char></note> <verse eid="2CH 31:3" /><verse number="4" style="v" sid="2CH 31:4" />Qeesolenna Leewwito duuchchi wodda Duuchchi Woddike Goottike seeri'a ergatendaashsha Iyyerusaalemike ardi insa'ne'a hasisaaka qoobbo uwwaashsha ajaje. <verse eid="2CH 31:4" /><verse number="5" style="v" sid="2CH 31:5" />Isira'eelito konne moyanji ajajeeka ajaja laqeeshshanni midhdha, woyyinetixxa booka, ejersiinxa zayitenna malebo ittanni fichchake'n huccineechchi duuchchanaa'n umo uune; horanetechcho hooneechcho duuchchinaa'n tommekenaa'n mitte anga hara bira saxxeexxa uwwa iyyedange.<note caller="-" style="x"><char style="xo" closed="false">31:5 </char><char style="xt" closed="false"><ref loc="NUM 18:12-13">Lak. 18:12-13</ref>, <ref loc="NUM 18:21">21</ref>.</char></note> <verse eid="2CH 31:5" /><verse number="6" style="v" sid="2CH 31:6" />Yihudike qachchuwwa'ni hedhammaki Isira'eelitonna Yihudiinki manni horuwwa insa'nekenaa'n, re'etenaa'ninna gedhebuwwakenaa'n Duuchchi Woddike Gootta insa'neke Mageni'a foonemmachchika tommekenaa'n mitte anga iyyedange tuulle. <verse eid="2CH 31:6" /><verse number="7" style="v" sid="2CH 31:7" />Tenne uwwa sakkake agenjonaa'n sanfeexxi torbake agenji qico'n muunxe. <verse eid="2CH 31:7" /><verse number="8" style="v" sid="2CH 31:8" />Moyanji Hiziqiyaasinna Ja'laabuwwi isiki dageexxi tenne tuullendeexxa uwwa uundeexxi Duuchchi Woddika Gootta galateefante Isira'eelika ardanna eebbinse.<verse eid="2CH 31:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 31:9" />Hiziqiyaasi qeesenna Leewwito tenne tuulleexxee insa'ne qore. <verse eid="2CH 31:9" /><verse number="10" style="v" sid="2CH 31:10" />Saadooqike mini hadiki qeesetiki akeekisanji Azariyaasina «Ardi uwwa Duuchchi Woddike Goottike galmibaa iyyedagexxe yannanaa'n inde goddine'naa gateen; Duuchchi Woddiki Gootti arda ifika eebbisemmaxxee tinni lumoxxi gata dandeteen» hiyye. <verse eid="2CH 31:10" /><verse number="11" style="v" sid="2CH 31:11" />Hiziqiyaasinna Duuchchi Woddike Goottike galmi giddo doone ugginaashsha ajaje: insa'nenna uggine. <verse eid="2CH 31:11" /><verse number="12" style="v" sid="2CH 31:12" />Ookkoneechchi uduma insa'nexxa uwwa, tommekenaa'n mitti anganna woyyondeexxa uwwa addatenshati iyyedangeexxi aassine. Leewwichchi Konaaniya konne miyuwwike sooreessa kadda wodda dayyi isiki Shimii baaleti isi'a langabamman. <verse eid="2CH 31:12" /><verse number="13" style="v" sid="2CH 31:13" />Yihi'eeli, Azaaziya, Nahaati, Asaheeli, Yirimooti, Yozabaadi, Eli'eeli, Samakiya, Mahaatinna Bennayaasi hinaakiiri tomme Leewwito filende. Konne duuchchiing moyanjo Hiziqiyaasinna qeesetike akeekisanjo Azaariyaasi darre'n baallomexxe Koniyanna dayo isike Semi'el hunda ergatema'emman. <verse eid="2CH 31:13" /><verse number="14" style="v" sid="2CH 31:14" />Boroti darrexxa hula heqqammak Leewwichchi Yiminak belt Qore kinni ifixxe eeyanni Magenoke shiqqexxe uwwa'ni Duuchchi Woddike Goottixxa uwwanna foyeendexxa yaanuwwa qoodatixxa baalle afeemman. <verse eid="2CH 31:14" /><verse number="15" style="v" sid="2CH 31:15" />Eden, Miniyaamini, Iyyaasu, Shema'iyya, Amaariyanna Sekaaniyate fira ifkixxe qeese lumokenna kadi shiixxarammake qoobbi qoobbishshann qoodati addatenshat insa'ne gargaare.<verse eid="2CH 31:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 31:16" />Higgeenni ila ilatike maxaafa'ni summi insa'neki borreessemeekinna barra barra'ninni gargar hexxeexxea insanexxa hujenna uwwemeeke insa'neke qoobbixxe qixxe'ninna uwwendexxa huje hujatee Duuchchi Woddik Goottik galmi giddo e'ya dande'ake sase wogganna ookkoneechchi iimi darre hexxeexxi labbaxxe oose'a ittanni huje uune. <verse eid="2CH 31:16" /><verse number="17" style="v" sid="2CH 31:17" />Ilatike maxaafa'ni mini mini insa'nekike hadike laakkossa'ni hexxeexxi qeese lame tomme wogganna ookkoneechchi iima hexxeexxe Leewwito'a hujetike qoobbishshanna hujetixxe uwwashshanni insa'ne'aanna qoonde. <verse eid="2CH 31:17" /><verse number="18" style="v" sid="2CH 31:18" />Konne ilatike maxxafa'n borreessemeek duuchinge ardixxa oose, aruwwa, labbaxxinna meyyaxxi oose mitteba ifi qullonsati xuurameeyyetemman.<verse eid="2CH 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 31:19" />Insa'nek qachchi qarqara hedheeke fichchiba yookaan wele qachchuwwa duuchcha'ni hexxa'neexxe qeesichcho Aaroonixxe horte'aanna; insa'nexxe oddo'ni hexxeexxe labbaxxenna Leewwitotike ilake maxaafa'ni borreesemeke duuchchi'a iitta qoondaashsha summi summiki borreessineeki manni hedhemman.<verse eid="2CH 31:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 31:20" />Moyanji Hiziqiyaasinna Duuchchi Woddike Gootta ifike Mageni edo elokenna qajeela manjo kadati Yihudiinke boga duuchcha'n hujeexxi huje tenneten. <verse eid="2CH 31:20" /><verse number="21" style="v" sid="2CH 31:21" />Isinna Duuchchi Woddike Goottike galmi giddo ergematinna kaddoo Magenke seeri'anna ajaji'a hiremat asseexxa duuchcha mitte godobinni Mageno ifika halseemmaxxee duuchchiinxi isi'a qajeelde.<verse eid="2CH 31:21" /></para>
  <chapter eid="2CH 31" />
  <chapter number="32" style="c" sid="2CH 32" />
  <para style="s1">Asoorito Iyyerusaalemi'ni Afo'o Fulchexxe</para>
  <para style="r">(<ref loc="2KI 18:13-37">2 Moy. 18:13-37</ref>; <ref loc="2KI 19:14-19">19:14-19</ref>, <ref loc="2KI 19:35-37">35-37</ref>; <ref loc="ISA 36:1-22">Isa. 36:1-22</ref>; <ref loc="ISA 37:8-38">37:8-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 32:1" />Moyanji Hiziqiyaasi konne qicinni xuurameessummati ergateme heddo yaane asseechchi uduma Asoorik moyanji Seenaakireeminna dageexxi Yihuda lole. Lole injifatee ifike assedho'a hedati kinjiinka dalla'a elqe kayyi'ni buqe. <verse eid="2CH 32:1" /><verse number="2" style="v" sid="2CH 32:2" />Seenaakireeminna Iyyerusaalemii lolo'a hedeexxa moyanjo Hiziqiyasii ege'neexxa yanna <verse eid="2CH 32:2" /><verse number="3" style="v" sid="2CH 32:3" />qachchi gadho hexxeexxa wedi'iinxa muummuwwa duuchchinaashsha ja'laabuwwikinna loliinke mannike akeekisanjinni welti mari'ate; insa'nenna isoo gargaarre. <verse eid="2CH 32:3" /><verse number="4" style="v" sid="2CH 32:4" />Heddi manninna bukki hiyyeexxi, «Asoorik moyanjuwwi dagexxi insa'ne mayee muummuwwatenaa'ni wede'e alfina?» hineexxi buttini hundii'ni phu'isammaka wede'e duuchchine. <verse eid="2CH 32:4" /><verse number="5" style="v" sid="2CH 32:5" />Ookkoneechchi uduma moyanji Hiziqiyaasi jabaate hujati diigememmaka dalla'uwwa qammachcheexxi hana xelleephpho ijaare; ittanni gadhi darree'ni wele dalla'a ijaarati Daawwitike qachchika hadhisanjo jabeesse; lebeexxi heddo loliinka miyanna wontuwwa huje.<verse eid="2CH 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 32:6" />Lolinke mannixxi akeekisanjo arda ballonsiteexxi ookkone qachchik dalla'ixxe hula edo hedheek ba'lina'ni bukki assineechchi uduma hiyya'ni insa'ne'e jajjabeesine qici, <verse eid="2CH 32:6" /><verse number="7" style="v" sid="2CH 32:7" />«Mee co'o jabaatte, Asoorika moyanjonna isinni welti hedheka sannachcha sodaatinoqqee. Isinni welti hexxeexxe hunna irra no'onni heexxeexxe hunna saxxaan. <verse eid="2CH 32:7" /><verse number="8" style="v" sid="2CH 32:8" />Isinni welti hexxeexxi hunna manjiinxe hunnan no'onni welti hedhe'e no'o gargaraakinna naapha no'oka lolaaki Duuchchi Woddike Gootta no'oke Magenon.» Ardikinna Yihudiink moyanji Hiziqiyaasi kuleeke hiyyichcho'ni jajjabaate.<verse eid="2CH 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 32:9" />Ookkoneechchi uduma Asoorik moyanji Seenaakireemi sannachchuwwa ifikinni welti Lakkishii buqe'naa, konneechchinni butti'a hexxeexxa erga loliinke mannik akeekisanjo darree'ni Hiziqiyaasi'anna isinni welti Iyyerusaalemii hedheeke Yihudike ardi'a konneechchi butta hexxeexxa erge.<verse eid="2CH 32:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 32:10" />«Ani Asoori moyanji Seenaakireeminna, anike sannachchinni buqemeeke Iyyerusaalemike qachcha'ni turtino'a heddineek ayye'ni addatineete? <verse eid="2CH 32:10" /><verse number="11" style="v" sid="2CH 32:11" />Hiziqiyaasinna, ‹Duuchchi Woddik Gootti no'oki Mageni Asoorike moyanjixxe anganaa'ni no'o anjiraan› hiyya'n isixxi solo'ikinna dheeboti rertinaashsha dedhiso'aatebaa? <verse eid="2CH 32:11" /><verse number="12" style="v" sid="2CH 32:12" />Mitte tolchimalchi edo kumbu hine; iso'nninna tolche hiyya'n Yihudanna Iyyerusaalemi ajaje, tullichchuwwiinxa magenoofachchotixxa bakkanna ciincatike tolchuwwa diigiseek Hiziqiyaasitebaa?<verse eid="2CH 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 32:13" />«Aninna edik anuwwi anki welti wele bogike arda duuchcha'ni assineneexxa egendinebaa? Yoona ookkone moyanjuwwik magenuwwi boga insa'neka anxe anganaa'ni hoyya dandee? <verse eid="2CH 32:13" /><verse number="14" style="v" sid="2CH 32:14" />Annuwwi anki balleesseeke konne moyanjuwwiki magenuwwi duuchchi gosa gosaka arda anjira dande'eki konne megenuwwanaa'ni hoonteta? Yoona ha'nook magenuwwi hitta anxe anganaa'ni ha'noo anjira dande'aa? <verse eid="2CH 32:14" /><verse number="15" style="v" sid="2CH 32:15" />Ta'atenna kaddoole Hiziqiyaasi konne qicinn ha'noo soboqqee, dedhake'ni ha'no ibisoqqe'e. Heene gosa gosak ardik mageni arda ifika anxe angana'ni yookaan anke annuwwixxe anganaa'ni anjira dande'ek ijje hedha gopheemmaxxee isoo amandinoqqe'e. Ha'nook mageni anxe anganaa'ni ha'noo hitta anjira dande'ata?»<verse eid="2CH 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 32:16" />Asoorixx akeekisanjo Duuchchi Woddike Gootti Mageninna erganjo Hiziqiyaasi'ni tennee saxxeexxa heddo elobaaxxa yaane haasonne. <verse eid="2CH 32:16" /><verse number="17" style="v" sid="2CH 32:17" />Asoorik moyanji borro borreesseexxi hiyyee qici, «Wele ardik magenuwwi ifika arda anxe anganaa'ni anjirebaashshanni, Hiziqiyaasik Mageni ifika arda anxe anganaa'ni anjira hara dande'abaan» hiyya'ni Duuchchi Woddika Gootta Isira'eelika Mageno yowwa'nemman. <verse eid="2CH 32:17" /><verse number="18" style="v" sid="2CH 32:18" />Ookkoneechchi uduma alalshatinna sodaachchisat ookkone qachcha abixxatee hine kinjiinke dalla'ani iima ofo'leeke Iyyerusaalemike arda'ni hafuura gikki assine Ibirawotiinke laagadinni cancine. <verse eid="2CH 32:18" /><verse number="19" style="v" sid="2CH 32:19" />Manjiinxe anganni hujemeeke wele bogike ardike magenuwwa'ni hunnati haasonnemmashshanni Iyyerusaalemike Mageno'ninna ittanni haasonnamman.<verse eid="2CH 32:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 32:20" />Moyanji Hiziqiyaasinna Amootsik belti wabeek Issayaasi tenne yaanexxee iimi'a soodachchoti raarre. <verse eid="2CH 32:20" /><verse number="21" style="v" sid="2CH 32:21" />Duuchchi Woddik Gootti iimika erganjo ergeexxi Asoorike moyanjixxe kaanbe'ni loliinka manna, akeekisanjonna loliinke mannixxa akeekisano birraashsha asse. Tennexxee Asoorik moyanji salphate ifike bogibaa hige; isi magenoofatammaxxe fakkeke mine'n e'yeeshshanni i'leemmaxxi labbaxxi oose wolaantichchik isoo shilte.<verse eid="2CH 32:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 32:22" />Duuchchi Woddik Gootti Hiziqiyaasinna Iyyerusaalemik arda Asoorike moyanjo Seenaakireeminna wele naaphuwwa insa'nekixxe anganaa'ni anjire. Wele arda duuchchinni welti nage'iki he'naashsha asse. <verse eid="2CH 32:22" /><verse number="23" style="v" sid="2CH 32:23" />Heddi manni Duuchchi Woddik Gootti'a uwwa aa'ne Iyyerusaalemi'a dangeexxi Yihudike moyanjo Hiziqiyaasi'anna fiixxeexxa uwwa aa'ne dange. Eettene yannanaa'ni ke'isse Hiziqiyaasi gosa gosake arda duuchcha'ni ulfeesseme.<verse eid="2CH 32:23" /></para>
  <para style="s1">Hiziqiyaasixxa Ifi Duka, Hujeexxa Yaanuwwanna Isixxa Reyo</para>
  <para style="r">(<ref loc="2KI 20:1-3">2 Moy. 20:1-3</ref>, <ref loc="2KI 20:12-19">12-19</ref>; <ref loc="ISA 38:1-3">Isa. 38:1-3</ref>; <ref loc="ISA 39:1-8">39:1-8</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 32:24" />Ookkone wodda Hiziqiyaasi elagophe rewo shiqeemman; isinna Duuchchi Woddike Goottibaa soodate; Isinna isi'a hiissichcho hiisse; beesisakanna isi'a uwwe. <verse eid="2CH 32:24" /><verse number="25" style="v" sid="2CH 32:25" />Hiziqiyaasi kinni ifi dukee malee isi'a assendeexxa eloxxe yaane'a hasisaaka hiissichcho shiqisebaan. Tennenaa'ni kexxeexxa Duuchchi Woddike Goottixxi mufe iso'ni, Iyyerusaalemikenna Yihudake arda'ni gelte. <verse eid="2CH 32:25" /><verse number="26" style="v" sid="2CH 32:26" />Kaddo melee Hiziqiyaasi ifi duka ifixxe aadde aage; Iyyerusaalemik ardi tennenni asse. Tennexxee Duuchchi Woddike Goottixxi mufe Hiziqiyaasi moyemmake baro'ni geltemmabaan.<verse eid="2CH 32:26" /></para>
  <para style="s1">Hiziqiyaasixxa Durumanna Gurra Fula</para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 32:27" />Moyanji Hiziqiyaasi lumoxxa karra afeekenna ulfateeke manjomman; tennenaa'ni kexxeexxa ifike birretika sibiljo, worqe, fiixxeexxe werquwwaa, qimamuwwatee, wontuwwatenna gargar hedheek hiri fiixeeke miyuwwi duuchchi'a massinnaka minuwwa ijaare. <verse eid="2CH 32:27" /><verse number="28" style="v" sid="2CH 32:28" />Iitttanni ifixxe midhaa, woyinetixxe bookaanna zayitetee masse'naka minuwwa gargar hedheke hori'a dalla'a, gedhebokeenna re'etee goodhe ijaaremman. <verse eid="2CH 32:28" /><verse number="29" style="v" sid="2CH 32:29" />Hiziqiyaasi'a Mageni yo'oxxa karra uwweemmaxxee; heddo gedhebiinkanna re'etixxa, iittanni heddo lalo bukki asse; heddo qachchuwwakanna ijaare.<verse eid="2CH 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2CH 32:30" />Ali darrexxi Giyoonixxi muumme yaatammaba kofeexxi wede'e dareerakenaa'ni butti'a dhidhimii darre'ni Daawwitike qachchibaa ya'aashsha asseeki Hiziqiyaasindemman; hujetinna isi'a qajeelde. <verse eid="2CH 32:30" /><verse number="31" style="v" sid="2CH 32:31" />Yaane kinni bogake'ni kaddeeke mambe'iinke beesisi'a isoo qorro'a Baabiloonixxe akeekisano erganjuwwa ergitee wodda, Mageni isoo hega uudo'a qalbe isixxe'ni hexxeexxa duuchcha ege'no'a haseemaxxee waale.<verse eid="2CH 32:31" /></para>
  <para style="s1">Hiziqiyaasixxe Moottummake Barixxa Muuxensha</para>
  <para style="r">(<ref loc="2KI 20:20-21">2 Moy. 20:20-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 32:32" />Moyanjo Hiziqiyaasi moyemmake baro'n hujeendeexxi wele hujenna arjunte Amootsike belto'ni wabeek Issayasixxe waleellanni Yihuda'ninna Isira'eelik moyanjuwike maxaafa'ni borreessendeen. <verse eid="2CH 32:32" /><verse number="33" style="v" sid="2CH 32:33" />Hiziqiyaasinna edike ifike annuwwishshanni lummedhe. Isinna Daawwitixxe horteke hirreessike tullichcha'ni moogeme. Isi reyee wodda Yihudak ardi duuchchinna Iyyerusaalemik ardi duuchchi ulfeessine. Isik belti Minaasenna isixxe bakka'ni moye.<verse eid="2CH 32:33" /></para>
  <chapter eid="2CH 32" />
  <chapter number="33" style="c" sid="2CH 33" />
  <para style="s1">Yihudiinka Moyanjo Minaasee'e</para>
  <para style="r">(<ref loc="2KI 21:1-9">2 Moy. 21:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 33:1" />Minaase moye wodda wogga isixxi tommenna lametemman; isinna Iyyerusaalemi ofo'le onde tommenna onde wogga moye galche. <verse eid="2CH 33:1" /><verse number="2" style="v" sid="2CH 33:2" />Minaase Duuchchi Woddik Gootti Isira'eelitoti edii'ni shorremmaka gosa gosake ardika diqachchisaaka galduma hordofati Duuchchi Woddike Gootti edo elobaaxxa yaane huje.<note caller="-" style="x"><char style="xo" closed="false">33:2 </char><char style="xt" closed="false"><ref loc="JER 15:4">Erm. 15:4</ref>. </char></note> <verse eid="2CH 33:2" /><verse number="3" style="v" sid="2CH 33:3" />Isinna anni isik Hiziqiyaasi fugussemmaka tullichchuwake'n magenoofachchotixxi bakkuwwa hiise ijaare; Ba'aal hiyyemaaka magenuwwi'a tolchimalcho giisse; Asheera hinaaka meyyaxxike magenixxa soodduwwa giisse; iimixxa urjuwwa sagade; magenooffate. <verse eid="2CH 33:3" /><verse number="4" style="v" sid="2CH 33:4" />Duuchchi Woddik Gootti, «Summi anki duuchchi woddi'a Iyyerusaalemi giddo ye'emaani.» Hiyyeemmake boonchoni isi Duuchchi Woddike Goottike galmi giddo wele magenuwwika tolchimalcho giisse.<note caller="-" style="x"><char style="xo" closed="false">33:4 </char><char style="xt" closed="false"><ref loc="2CH 6:6">2 Odo. 6:6</ref>. </char></note> <verse eid="2CH 33:4" /><verse number="5" style="v" sid="2CH 33:5" />Lamiinge Duuchchi Woddike Goottike galmixxe baxxe'ni duuchchinge iimixxe urjuwwaa tolchimalchuwwa ijaare. <verse eid="2CH 33:5" /><verse number="6" style="v" sid="2CH 33:6" />Isinna Ben Heenomixxe dhooqa'ni ifixxa labbaxxa oose giirate'ni ciinceessee; isi ifi'ani goja'n, falfala'n, morate'ni ke'e; iittanni ekedha haasseesammakeerinaa'n gorsa qodhdhaamman. Tenne elobaaxxa huje hujeexxi Duuchchi Woddika Gootta mufachchiise.<verse eid="2CH 33:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 33:7" />Isinna bocende giisendeexxa fakke aadheexxi Mageniinke galmi giddo ugge. Konne galmixxee Mageni Daawwiti'ninna isike belto Solomooni'n hiyyeema qici, «Konne galma'ninna Isira'eelixxe gosa duuchcha'a fi'leennexxe Iyyerusaalemi giddo summi anki duuchchi woddi'a ye'emaan; <verse eid="2CH 33:7" /><verse number="8" style="v" sid="2CH 33:8" />ani Isira'eelito Muuse darree'n aajajenneka ajajuwwa, seerakanna aada anxa duuchcha xexxe'atati muunxo malee edike insa'neke annuwwi'a uwweennake boganaa'ni Isira'eelito waalde fuldaashsha assaabe'non.»<note caller="-" style="x"><char style="xo" closed="false">33:8 </char><char style="xt" closed="false"><ref loc="1KI 9:3-5">1 Moy. 9:3-5</ref>; <ref loc="2CH 7:12-18">2 Odo. 7:12-18</ref>. </char></note> <verse eid="2CH 33:8" /><verse number="9" style="v" sid="2CH 33:9" />Minaase kinni Duuchchi Woddike Gootti Isira'eelitoti edi'ni fugussemmake gosa gosake ardi irra elobaaxxa huje hunjaashsha Yihudakanna Iyyerusaalemika arda dedhise.<verse eid="2CH 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 33:10" />Duuchchi Woddik Gootti Minaase'anna arda ifika jaba qicinni xexxe'achchisoolenna midde insa'ne isixxa laqanda ginbe. <verse eid="2CH 33:10" /><verse number="11" style="v" sid="2CH 33:11" />Tennexxee Asoorik sannachchuwwi Yihudaa bunqe lollaashsha Duuchchi Woddik Gootti eettii insa'ne'a uwwe, sannuchchuwwikinna Minaasee'e booji'e sanotanna urree haachchabiki foxoore Baabilooni'a aadhdhe me'e. <verse eid="2CH 33:11" /><verse number="12" style="v" sid="2CH 33:12" />Minaase jabaxxe rakko'ni ibee wodda Duuchchi Woddik Gootta ifike Magenixxe elle halse; ifike edike anuwwika Mageni edonna lumooshsha ifi salphise. <verse eid="2CH 33:12" /><verse number="13" style="v" sid="2CH 33:13" />Minaasenna isibaa soodatee wodda, Minaasexxa wixixxi hiyyatixxa soodachcho uude marareexxi Duuchchi Woddike Gootti soodachcho isixxa laqe; tennexxee isoo Iyyerusaalemi'a isixxe mootummabaa hiisse. Minaasenna Duuchchi Woddiki Gootti Magenoke kadeexxa ege'ne.<verse eid="2CH 33:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 33:14" />Ookkoneechchi uduma Minaase Daawwitike qachcha'ni boroti darre'ni hedheeka gadhi darreka kinjiinka dalla'a ejjuma qeerriseexxi huje; kunni kinjink dalla'inna eettene dhooqa giddo Giyoonixxe muummeke dhidhiminaa'n middi darre'n Qulxu'metike Dalla'ixxe hula qico'nite kadaa wodda ookkone qachchi bira hedheeka Oofeeli hiyyemaaka booncho mitteba abideekemman. Iittanni Minaase Yihudiinke kollifachchotike duuchchinge mitti mittingee qachcha'n mitte mitte loliinke mannika ajajallo ugge. <verse eid="2CH 33:14" /><verse number="15" style="v" sid="2CH 33:15" />Minaasenna wele bogika magenuwwanna isi ifi'a uurrisemmaxxa soodduwwa woyyichcha galmi giddii'ni fulche. Iittanni tullichchuwwake'n magenoofachchotixxa fakkenna Iyyerusaalemii hujiseemmaka tolchimalchuwwa duuchcha fugusseexxi ookkone qachchuwwi gadho hune. <verse eid="2CH 33:15" /><verse number="16" style="v" sid="2CH 33:16" />Ookkoneechchi uduma isi Duuchchi Woddike Goottika tolchimalcho qammachcheexxi hana mittomiinka tolchanna galatiinka tolcha shiqise. Yihudanna Duuchchi Woddike Gootta Isira'eelike Mageni'a ergatemmaashsha ajaje. <verse eid="2CH 33:16" /><verse number="17" style="v" sid="2CH 33:17" />Ardi kinni tollichchuwwiinke magenoofachchotike boonchuwwa'ni tolcha shiqisha'n hedheexxe kaddoolenna tolcha shiqisha'emak kinni ookke Duuchchi Woddike Gootta ifike Mageni'a callatemman.<verse eid="2CH 33:17" /></para>
  <para style="s1">Minaaseke Moottumatike Barixxa Muuxensha</para>
  <para style="r">(<ref loc="2KI 21:17-18">2 Moy. 21:17-18</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 33:18" />Minaase moye galchammake baro'ni hujendeexxi wele yaanuwwa isi ifike Magenibaa shiqisemmaxxi soodachcho, wabeeki Duuchchi Woddike Gootta Isira'eelike Magenike summinni Minaase'ni haaso'ek hiyyichchi Isira'eelike jirtetike maxaafa'ni borreessemeedheen. <verse eid="2CH 33:18" /><verse number="19" style="v" sid="2CH 33:19" />Moyanjo Minaasexxa soodachcho Mageni hitta isi'a mararee laqeexxi hiisseka hiissechcho, hujexxa cubbonna xurameessumma ifixxa xe'isheexxa, iittann ifi salphisebaa edo darre hujiseexxa tullichchuwwiinka magenoofachchotika boonchuwwa, uurriseemmaxxa Asheerati hiyyendaaxxe meyyaxxe fakkexxa soodduwwanna magenoofachchotixxa fakkuwwa duuchcha wabeekotike maxaafa'ni borreessenede'een. <verse eid="2CH 33:19" /><verse number="20" style="v" sid="2CH 33:20" />Minaasenna edike ifike annuwwishshanni lummedheexxi ifixxe mootumma bira hedheeke booncho'ni moogeme. Isixxe bakka'ninna belti isiki Amoon moye.<verse eid="2CH 33:20" /></para>
  <para style="s1">Yihudiinka Moyanjo Amoonii'i</para>
  <para style="r">(<ref loc="2KI 21:19-26">2 Moy. 21:19-26</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 33:21" />Amooni moyee wodda wogga isixxi lame tommenna lametemman. Isinna Iyyerusaalemi'i giddo lame wogga moye galche. <verse eid="2CH 33:21" /><verse number="22" style="v" sid="2CH 33:22" />Anni isiki Minaase hujemmashshanni isinna iittanni hujee Duuchchi Woddika Gootti edo foggoxxa asse. Amooninna anni hujemmaxxa fakkuwwa duuchcha magenooffante; tolchakanna tenne fakkuwwaa shiqise. <verse eid="2CH 33:22" /><verse number="23" style="v" sid="2CH 33:23" />Amooni Minaaseshsha ifi heeshsh asse salphise Duuchchi Woddik Goottiba higebaan. Yaane kinni anni irra ballesande'n balleessa leba'n huje.<verse eid="2CH 33:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 33:24" />Amooni ja'laabuwwi fuggoxxa iso'n mari'ate mootummatike mini giddo isoo shinne. <verse eid="2CH 33:24" /><verse number="25" style="v" sid="2CH 33:25" />Ookkoneechchi uduma ookkone bogiki ardi moyanjo Amooni fuggoxxa mari'atemmaka duuchcha shiye. Isixxe bakka'ni belto isika Iyyosiyaasii mootoonsine.<verse eid="2CH 33:25" /></para>
  <chapter eid="2CH 33" />
  <chapter number="34" style="c" sid="2CH 34" />
  <para style="s1">Iyyosiyaasi Asseexxe Haaronsa</para>
  <para style="r">(<ref loc="2KI 22:1-2">2 Moy. 22:1-2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 34:1" />Iyyosiyaasi moyee wodda wogga isixxi saddeetatemman. Isinna Iyyerusaalemii giddo sase tommenna mitte wogga galche. <verse eid="2CH 34:1" /><verse number="2" style="v" sid="2CH 34:2" />Iyyosiyaasinna Duuchchi Woddike Gootti'a eloxxa yaane asse. Isinna erqena kayyi'a higebangi edik anni isiki Daawwiti me'emmaka ora me'e.<verse eid="2CH 34:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 34:3" />Isinna moye galchemmaxxe saddeetixxe wogga'ni, oosummande'ni edike ifike annika Daawwitika Mageno magenoofate. Tommenna langaxxe wogga'ni wele bogiki manni mageneefatammak tullichchi boonchuwwa, Asheerati hiyyemaake meyyake magenixxa soodduwwanna wele hujendexxa fakkuwwanna baqisendeexxe misiluwwa duuchcha Yihuda'ninna Iyyerusaalemi'ni giddii'ni ballessate'ni ke'e. <verse eid="2CH 34:3" /><verse number="4" style="v" sid="2CH 34:4" />Isike ajajinni manni Ba'aalika tolchimalchuwwanna bira hedhammaka hixaana guphphinammaka tolchimalchuwwa enqine birre. Iittanni Asheera hiyyemaake meyyake magenixxa soodduwwa, wele fakkuwwanna misiluwwa duuchcha eniqine birreechi uduma cilaatte aa'nexxi eetene fakkuwwaa tolcha shiqisammake mannike hirreessa'ni xeerre.<note caller="-" style="x"><char style="xo" closed="false">34:4 </char><char style="xt" closed="false"><ref loc="2KI 21:3">2 Moy. 21:3</ref>; <ref loc="2CH 33:3">2 Odo. 33:3</ref>. </char></note> <verse eid="2CH 34:4" /><verse number="5" style="v" sid="2CH 34:5" />Iyyosiyaasinna insa'nexxe qeesexxa miqe insa'ne magenoofachchotike tolchimalchuwa hana ciinceesse; isinna konne qicinni Yihudanna Iyyerusaalemi luqqi asse.<note caller="-" style="x"><char style="xo" closed="false">34:5 </char><char style="xt" closed="false"><ref loc="1KI 13:2">1 Moy. 13:2</ref>. </char></note> <verse eid="2CH 34:5" /><verse number="6" style="v" sid="2CH 34:6" />Nefitaalemi qico'ni hedheek Minaasexxe, Efireemixxenna Siimi'oonike bogike qachchuwwa'ni ittanni qarqara insa'neke'ni hedheeke diigeme luggeeke loola'ninna tenneeni fakkaataxxa yaane asse. <verse eid="2CH 34:6" /><verse number="7" style="v" sid="2CH 34:7" />Isira'eelike boga'ni hedheeka fakkuwwika tolchimalchuwwa, Asheeraxxa soodduwwa duuchcha enqe, misiluwwa duuchchanna bullete asse waale, hixaana guphphinammak tolchimalchuwwa enqe bireexxi Iyyerusaalemi'a hige.<verse eid="2CH 34:7" /></para>
  <para style="s1">Mageninke Seerike Maxaafixxa Afensha</para>
  <para style="r">(<ref loc="2KI 22:3-20">2 Moy. 22:3-20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 34:8" />Iyyosiyaasi moyexxe tommenna saddeetixxe wogga'ni bogakanna woyyichcha galma luqqi asseechchi uduma Atsaaliyaka belto Saafaanii, Iyyerussaalemii galchammaka Ma'iseyaaniinna borreessanjo Iyyo'ahaazika belto Yo'ahi'i Duuchchi Woddike Gootta ifike Magenika galma qammachchino'a erge.<verse eid="2CH 34:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 34:9" />Insa'nenna umo qeesichcho Hiliqiyaasibaa marreexxi Mageniinke galmi'a dageeka maallaqa iso'n uunne; iikki maallaqinna hula heqqitammaxxi leewwito Minaasenaa'n Efireeminaa'ninna Isira'eelitotixxe hafe duuchchinaa'n iittanni Yihudake, Biiniyamike ardi duuchchinaa'ninna Iyyerusaalemi giddo hedha'nekeerinaa'ni bukki assemeekemman. <verse eid="2CH 34:9" /><verse number="10" style="v" sid="2CH 34:10" />Ookkoneechchi uduma Duuchchi Woddike Goottike galmixxa huje to'anta'ni hunjaashsha baallomemmake konne sase manna'n konne maallaqa uune. Kunni manninna konne maallaqa galma ijaara'neke qammachchammakenna haaronsekeeri'a uune. <verse eid="2CH 34:10" /><verse number="11" style="v" sid="2CH 34:11" />Iittanni Yihudaki moyanjuwwi diigemaashsha assemmake kinjiinke minuwwike ijaasi'a kadaaxxa bocendeexxa kinonna haqqe hirraashsha, kino bocamakeera'ninna mine ijaaramakeera'n uune. <verse eid="2CH 34:11" /><verse number="12" style="v" sid="2CH 34:12" />Mine ijaarammakiirinna kino bocammakiir huje xuurameessumati hunje muunxe. Insa'nek sooresuwwinna Meeraarixxe gosana'n Ii'eetinna Abidiyyu, Qe'aatixxe gosanaa'ni Zekkariyasinna Mesulaamitemman; faarotike miyinni faarsatixxa lumoxxa ege'na affeexxi Leewwito duuchcha, <verse eid="2CH 34:12" /><verse number="13" style="v" sid="2CH 34:13" />dukkamakeera'ninna gargaritti hexxeexxa huje hujaammakeera'n baallonde'eemman. Wele gatteexxi Leewwito iittanni sooresuwwa, borreesanjuwwanna hulatike hiqqanjuwwamman.<verse eid="2CH 34:13" /></para>
  <para style="s1">Muuseke Seerike Maxaafixxa Afensha</para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 34:14" />Duuchchi Woddike Goottike galmibaa e'yeeka maallaqa insa'ne fulchinaa wodda, qeesichchi Hiliqiyaasi Muuse'n uwwemeemmaka Duuchchi Woddike Goottike seerika maxaafa afe. <verse eid="2CH 34:14" /><verse number="15" style="v" sid="2CH 34:15" />Hiiliqiyaasinna borreessanjo Saafaanii, «Duuchchi Woddike Goottike seeriinka maxaafa konne woyyichchi galmi giddo afeennen» hiyye. Ookkoneechchi uduma isi ookkonee maxaafa Saafaani'n uwwe.<verse eid="2CH 34:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 34:16" />Ookkoneechchi uduma Saafaani ookkonee maxaafa aadheexxi moyanjiba mareexxi isoo hiyyee qici, «Ja'laabuwwi atiki ajajjetexxa duuchcha muuxate'ni hedheen; <verse eid="2CH 34:16" /><verse number="17" style="v" sid="2CH 34:17" />insa'nenna Duuchchi Woddike Goottik galmi giddo hedhemmaka maallaqa aa'neexxi ookkone hujalluwwa'ninna insa'nee to'atammake manna'n uuneen.» <verse eid="2CH 34:17" /><verse number="18" style="v" sid="2CH 34:18" />Ookkoneechchi uduma borreesanji Saafaani moyanjoke'n, «Qeesichchi Hiiliqiyaasi maxaafa ane'ni uwwe'een» hiyye. Saafaaninna ookkonee maxaafa moyanjokee haaseesse.<verse eid="2CH 34:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 34:19" />Moyanjikinna seeriinka hiyyichcho haasesinaa'na'a leqee wodda, yaaddoti seemma ifixxa dare. <verse eid="2CH 34:19" /><verse number="20" style="v" sid="2CH 34:20" />Isinna moyanjo Hiiliqiyaasi, Saafaanika labba belto Ahiqaami'a, Mikiyaasike labba belto Abidoni'a, ifike mootummatike borreesanjo Saafani'ninna moyanjiinke shiqike erganjo Asaaya'a konneechchi butta hedheeka ajaja uwwe. <verse eid="2CH 34:20" /><verse number="21" style="v" sid="2CH 34:21" />«Martineexxi anxee ittanni Isira'eelito giddonna Yihuda giddo gateeke ardixxee afemeeke maxaafi giddo borreessendeexxe yaane'a Duuchchi Woddika Gootta laqqe. Ediki no'oki annuwwi Duuchchi Woddike Goottike hiyyichchi'a ajajema gonpheemmaxxenna kunni maxaafi asse hiyya'neexxa duuchcha muuxa gonpheemmaxxee Duuchchi Woddik Gootti jabaxxa mufe ifixxa no'o'ni ibiseen.»<verse eid="2CH 34:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 34:22" />Hiliqiyaasinna iikki moyanji isinni welti ergeemmak manni seemmatike heqanjo kade'emmake Hasirake beltika belto Tiquwwaka belto Seelemixxa are kadde'emmaxxe eettene wabeetto Hildaanabaa marreexxi ise'n kulle. Isinna Iyyerusaalemi giddo langake quta qachcha'n hexxa'emman.<verse eid="2CH 34:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 34:23" />Wabeekittenna insa'nee, «Ha'noo anibaa ergeeke manjibaa ille iima higgineexxi konneechchi butta hedheeka Duuchchi Woddik Gootta Isira'eelike Magenika hiyyichcho iso'n kulle. <verse eid="2CH 34:23" /><verse number="24" style="v" sid="2CH 34:24" />‹Duuchchi Woddiki Gootti hiya'nee qici Yihudake moyanji edo haassesemeeke maxaafi giddo borreessendeexxe badinoshsha sa'atixxee kulendeeshshanni Iyyerussaalemina arda iseke duuchcha'n ba'ne geessisannon. <verse eid="2CH 34:24" /><verse number="25" style="v" sid="2CH 34:25" />Insa'nenna anee waaleexxi wele magenuwwi'a hixaana gubbeemmaxxeenna hunjeexxe yaane duuchcha'n anee mufachchiinsemmaxxee Iyyerussaalemi'ni aarennexxi aare anxi ha'yitaa malee xoxxabaan.› <verse eid="2CH 34:25" /><verse number="26" style="v" sid="2CH 34:26" />Duuchchi Woddika Gootta qodhatee ergitinemmake Yihudiinka moyanjo'n hitinee kuldinaa qici, ‹Ati laqqetteke hiyyichchi'a Duuchchi Woddike Gootti Isira'eelik Mageni hiyya'nee qici: <verse eid="2CH 34:26" /><verse number="27" style="v" sid="2CH 34:27" />ani Iyyerussaaleminna arda isike hitta ganannoxxa ati laqqette wodda; qalbe atixxi yaaddemmaxxee Magenii edo ifi salphisseetaxxee iittanni ani edo ifi heeshi assiteettaxxee seemma atixxa yaaddoti dartee ani edo soodattettaxxee soodachcho atixxa laqeennen hiyya'nee Duuchchi Woddik Gootti. <verse eid="2CH 34:27" /><verse number="28" style="v" sid="2CH 34:28" />Yoona ati edik atike annuwwishshanni rertaton. Nage'ikinna moogendatton. Iyyerussaalemi'ninna ise giddo hedha'neeke arda'n geltaaxxa rakko duuchcha ille atixxinni uuddabexxon.› »</para>
  <para style="p" vid="2CH 34:28">Iikki mannikinna hiisichcho iseka moyanjo Iyyosiyaasibaa aa'ne hinge.<verse eid="2CH 34:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 34:29" />Ookko'ninna moyanji Iyyosiyaasi Yihudikanna Iyyerusaalemixxa geedhe duuchcha mitteba bukki asse. <verse eid="2CH 34:29" /><verse number="30" style="v" sid="2CH 34:30" />Isinna lumokenaa'ni shiixxoki qico'ni hedheeka Yihudiinke mannanaa'ni, Iyyerusaalemike ardanaa'ni, qeesetinna Leewwitoti welti Duuchchi Woddike goottike galmibaa me'e. Isinna Duuchchi Woddik Goottik galmi giddo afemeemmaka ookkone seerike maxaafika hiyyichcho duuchcha ardakee haasesse. <verse eid="2CH 34:30" /><verse number="31" style="v" sid="2CH 34:31" />Moyanjikinna sooddoti bira uurreexxi Duuchchi Woddike Gootta hordofatee mitte godobininna shenitte hedhonni ajajuwwa, seeruwwakanna aada isixxa heqqedhatee konne maxaafa'ni borreessemeeke kakotike hiyyichchi'a ajajemo'a Duuchchi Woddike Gootti edo kako haaronse.<verse eid="2CH 34:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 34:32" />Ookkoneechchi uduma Biiniyaamika ardinna Iyyerusaalemii afemeeka manna duuchcha tenne yaane'n kako aagaashsha asse; konne qicinni Iyyerusaalemiki ardi ifike edike annuwwik Mageni ajajeemmaxxe Mageniinxe kakooshsha duuchchiinxa muunxe.<verse eid="2CH 34:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2CH 34:33" />Moyanji Iyyosiyaasi diqachiisaxxa magenoofachchotixxa fakkuwwa duuchcha Isira'eelike boga duuchchanaa'ni fugusse; Isira'eelike bogi giddo hedhemmaki duuchchi Duuchchi Woddika Gootta insa'neka Mageno magenoofantaashsha asse. Isi moyemmake hedhoti hedhammake baro'ni Duuchchi Woddika Gootta ifike edike anuwwika Mageno hordofatenaa'n udumi'a hingebaan.<verse eid="2CH 34:33" /></para>
  <chapter eid="2CH 34" />
  <chapter number="35" style="c" sid="2CH 35" />
  <para style="s1">Iyyosiyaasi Sa'atika Ayyaana Ulfeesse</para>
  <para style="r">(<ref loc="2KI 23:21-23">2 Moy. 23:21-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 35:1" />Iyyosiyaasi Duuchchi Woddike Gootti'a Iyyerusaalemi'n sa'atika ayyaana ulfeesse; siretike agenjo'ni tommenna sholgaxxe barra'ni sa'atike ayyaanik gedhechchi duleme. <verse eid="2CH 35:1" /><verse number="2" style="v" sid="2CH 35:2" />Isi qeese hujjaaxxa huje'n qoode; Duuchchi Woddike Goottike galmi giddo jabaante ergatemmaashsha jajjabeesse. <verse eid="2CH 35:2" /><verse number="3" style="v" sid="2CH 35:3" />Isira'eelito duuchcha barachchiissaammaxxanna Duuchchi woddik Gootti'a ifi footeexxe Leewwito'n hiyyee qic, «Duuchchi Woddike Goottika taaboota Daawwitike belti Solomoon hujisemmake woyyichcha galmi giddo ugge. Konneechchi uduma Kakotika taaboota dukkinoqqe'e; ta'anna Duuchchi Woddika Gootta ha'nooka Magenonna arda isika Isira'eelii'i ergatemme. <verse eid="2CH 35:3" /><verse number="4" style="v" sid="2CH 35:4" />Isira'eelike moyanji Daawwitinna belti isiki Solomoon borreessinemmaxxe akkeetteshsha ifi ifike mini hadinn woyyichchi galmi giddo ergatenshatee ifi ifi qopheesse.<note caller="-" style="x"><char style="xo" closed="false">35:4 </char><char style="xt" closed="false"><ref loc="2CH 8:14">2 Odo. 8:14</ref>. </char></note><verse eid="2CH 35:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 35:5" />«Leewwito kadebaake ha'nooke dayyuwwi edo, ifi ifike mini hadinni woyyitte bakka'n uurre; mitte mittenge mini hadi'anna Lewwito hexxewwaal. <verse eid="2CH 35:5" /><verse number="6" style="v" sid="2CH 35:6" />Ookkoneechchi uduma sa'atike ayyaani'a shiqqeexxa gedhebiinxa korbeeyye dulle; ha'noonna ifi woyyoonse; Duuchchi Woddik Gootti Muuse darree'ni ajajemmashshanni dayyuwwa ha'nookee dule qopheese.»<verse eid="2CH 35:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 35:7" />Moyanji Iyyosiyaasi ookko hedheeke ardi duuchchi'a sa'atike aayaanike tolchi'a sase tomme kuma gedhebiinxanna re'etixxa korbeeyye iittanni sase kuma jiboota ifike horenaa'ni uwwe.<verse eid="2CH 35:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 35:8" />Moyanjuwwinki ja'labuwwinna tolchakee shiqeek ardakee, qeesetenna Leewwitotee ifixxe eeyyanni uune. Mageniinke galmike sooreessuwwa kadeekiir Hiliqiyaasi, Zakaaryaasinna Yihi'eeli sa'atike ayyaani'a shiqqaaka lame kumanna jaane dhibba gedhebo, iittanni sase dhibba jiboota uune. <verse eid="2CH 35:8" /><verse number="9" style="v" sid="2CH 35:9" />Higgeeni Konaaniya, dayyuwwi isik Shema'iyanna Neetani'eeli iittanni Leewwitotik akeekisanjuwwi Hashabiya, Yi'i'e'eelinna Yozabaadi sa'atike aayaani'a tolchii onde kuma gedhebonna re'e, onde dhibba kormoole Leewwitotee uune.<verse eid="2CH 35:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 35:10" />Sa'atike ayyaanixxa qophpheeffachcho muunxeechchi uduma, moyanji ajajeammashshanni qeese ifi ifixxe kuta giddo uwwendemmaxxe bakka'n Leewwitoti welti ifi ifika booncho abixxite uurrite. <verse eid="2CH 35:10" /><verse number="11" style="v" sid="2CH 35:11" />Sa'atike ayyaani'a gorra'emeeka gedhebiinka buruuse Leewwito dulde. Qeesetinna tolchimalchi hana munde fixxe. <verse eid="2CH 35:11" /><verse number="12" style="v" sid="2CH 35:12" />Muuseke seera'ni borreessendemmashshanni Duuchchi Woddike Gootti'a shiqinsaashsha mini mini hadi'a uwwemeeke qoobbishshanni ardakee uwwatee ciincatika tolcha foone. Eettene jibootatanna iittanni foone. <verse eid="2CH 35:12" /><verse number="13" style="v" sid="2CH 35:13" />Leewwitonna seeriinshanni sa'atike ayyaanika tolcha dudhishshe; eettene woyyitte uwwa odolchote'ni, huburake'ninna disitete'ni gaffeexxi malaakanna ardakee rakke qoodde.<note caller="-" style="x"><char style="xo" closed="false">35:13 </char><char style="xt" closed="false"><ref loc="EXO 12:8-9">Fula. 12:8-9</ref>. </char></note> <verse eid="2CH 35:13" /><verse number="14" style="v" sid="2CH 35:14" />Ookkoneechchi uduma qeesetinna ifi ifi'a qophpheesite; Tennee assiteechchinna qeese Aaroonixxi oose ookkonee ciincatika tolchanna ha'yo duuchcha hashshi qico'n ciincesitammaxxeten; tenexxe Leewwito ifi'anna qeese Aaroonixxe oose'a qixxeefachcho assite.<verse eid="2CH 35:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 35:15" />Konnechi butta summi insa'neki hedheexxi Leewwichcho Asaafixxe hortexxi faarsaleeyye moyanji Daawwiti uwweeke ajajishshanni, insa'ne'a uwwemeeke booncho'ni he'nema; ina'nenna Asaafi, Hemaaninna moyanjo wabeeko Yidutaanitemman; wele Leewwito sa'atike ayyanika tolcha shiqishaammaxxe'e Woyyichcha galma heqqaamak heqqanji insa'nek boocho waalamabaan.<note caller="-" style="x"><char style="xo" closed="false">35:15 </char><char style="xt" closed="false"><ref loc="1CH 25:1">1 Odo. 25:1</ref>. </char></note><verse eid="2CH 35:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 35:16" />Konne qicinni sa'atika ayyaana ulfesatinna ciincatika tolcha Duuchchi Woddike Goottike tolchimalcho'ni shiqisat Duuchchi Woddike Gootti'a shiqqaxxa magenooffachchotixxa aada duuchcha, moyanji Iyyosiyaasi ajajemmashshanni eettene barra'ni muuxeme. <verse eid="2CH 35:16" /><verse number="17" style="v" sid="2CH 35:17" />Eettene yanna ookko hexxeexxi Isira'eelito duuchcha sa'atika ayyaana ulfeesite; iittanni kebbotika ayyaana torbaane barra ulfeesine.<note caller="-" style="x"><char style="xo" closed="false">35:17 </char><char style="xt" closed="false"><ref loc="EXO 12:1-20">Fula. 12:1-20</ref>. </char></note> <verse eid="2CH 35:17" /><verse number="18" style="v" sid="2CH 35:18" />Wabeek Saamu'eelike barinni kayyi'a Isira'eelito iitta hedheeka sa'atika ayyaana ulfeesite egendebaan; moyanji Iyyosiyaasi eettene qeese, eettene Leewwito, Yihudiinke boga duuchchanaa'ninna Isira'eeli giddii'ni, ookko hedhammake Iyyerusaalemike manninni welti ulfeessemmeeshsha Isire'eelike moyanjuwwinaa'ni mittikinna ulfeesseek hedhebaan. <verse eid="2CH 35:18" /><verse number="19" style="v" sid="2CH 35:19" />Kunni sa'atik ayyaani ulfeessemeeki Iyyosiyaasike baro'ni tommenna saddeetixxe wogga'nitemman.<verse eid="2CH 35:19" /></para>
  <para style="s1">Iyyosiyaassixxa Reyo</para>
  <para style="r">(<ref loc="2KI 23:28-30">2 Moy. 23:28-30</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 35:20" />Moyanji Iyyosiyaasi woyyichcha galmi'a tenne duuchcha qixxeessee bireechchi uduma, Gibtseke moyanji Nika'u Efiraaxisike galaani bira Karekemishi hinaa booncho'ni lolakee fule; Iyyosiyaasinna lolo'a fule. <verse eid="2CH 35:20" /><verse number="21" style="v" sid="2CH 35:21" />Niika'u kinni Iyyosiyaasii'n, «Koo Yihudiinke moyanjo atenna anee lolenchiisa'negeechchi maacho? Ani dagenneki naapha anika lolonnaate malee atee lollonnaatebaan; naapha anka rakee lollonaa Mageni anee ajajeen. Tennexxee aninni welti hedheeka Mageno giba waali, waala gophphottole atee balleessaan» hiyyee erga erge.<verse eid="2CH 35:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 35:22" />Iyyosiyaasi kinni ifi wele manjo fakkeese isoo lolo'a fule malee udumi'a higebaan; Megidoke diida'ni lolo'a fule malee Nika'u darree'ni Mageni haaso'exxa laqatee hasebaan.<verse eid="2CH 35:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 35:23" />Gabeti lolaammaki moyanjo Iyyosiyaasii'i ote; isinna loliinka manna ajajammakaara, «Fuggo mado'eennen kabaa'ni anee fulche» hiyye. <verse eid="2CH 35:23" /><verse number="24" style="v" sid="2CH 35:24" />Insa'nenna isoo loliinxe gaarenaa'ni dirrinseexxi ifixxe gaare'ni ugginee Iyyerusaalemi'a aa'ne me'ine; isinna ookko reye. Isinna edike isike annuwwike hirreessa'ni moogeme. Yihudiinkinna Iyyerussaalemiki ardi duuchchi isi'a boochise.<verse eid="2CH 35:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 35:25" />Wabeeki Ermiyaasi moyanjo Iyyosiyaasi'a yaaddotixxa gince borreesse; labbakinna meyyaki boochchisa fulchammaki manni duuchchi telchi qico'ni tenne genceenni Iyyosiyaasii'i qaabbanta'ne he'neen. Tinninna Isira'eel giddo baratendee kaddeexxi Isira'eeliitotixxa oodhishshatixxe genceke maxaafa'n borreessendeen.<verse eid="2CH 35:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 35:26" />Iyyosiyaasi moyemmake baro'ni hujende muuxendeexxi wele hujuwwanna Duuchchi Woddike Goottike Seeriinke maxaafa'ni borreessendemmashshanni, isi hujemmaxxi eloxxi huje, <verse eid="2CH 35:26" /><verse number="27" style="v" sid="2CH 35:27" />ke'itokenaa'ni muuxamii qico'ni isi assemmaxxi duuchcha Yihudiinkenna Isira'eelike moyanjuwiinke maxaafa'ni borreesende'een.<verse eid="2CH 35:27" /></para>
  <chapter eid="2CH 35" />
  <chapter number="36" style="c" sid="2CH 36" />
  <para style="s1">Yihudiinka Moyanjo Iyyohaazii'i</para>
  <para style="r">(<ref loc="2KI 23:30-35">2 Moy. 23:30-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 36:1" />Yihudiinki ardi Iyyosiyaasika belto Iyyohaazii aadheexxi aniinxe bakka'ni Iyyerusaalemii moyanjoke assine.<verse eid="2CH 36:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 36:2" />Iyyo'ahaazi moyexxa yanna wogga isixxi lame tommenna sasetemman. Isinna Iyyerusaalemii hedhe'e sase wogga moye galche. <verse eid="2CH 36:2" /><verse number="3" style="v" sid="2CH 36:3" />Ookkoo'ni Gibtseke moyanji Niika'u Iyyerusaalemi hexxeexxe mootenaa'n isoo dirrise. Yihudiinki ardinna sase kumanna shoole dhibba kiilo birretika sibiljonna sase tommenna shoole kiilo worqe irbo uwwaashsha asse. <verse eid="2CH 36:3" /><verse number="4" style="v" sid="2CH 36:4" />Gibtseki moyanji Nika'u Iyyo'ahaazika dayyo Eliyaqemii Yihuda'ninna Iyyerusaalemi'ni moyaashsha asse. Isinna summa jijjiireexxi Iyyo'aaqemite hiyye. Moyanji Nika'unna Eelaqiyemika dayyo Iyyo'ahaziin aadhexxi Gibtse'a adhdhe me'e.<note caller="-" style="x"><char style="xo" closed="false">36:4 </char><char style="xt" closed="false"><ref loc="JER 22:11-12">Erm. 22:11-12</ref>. </char></note><verse eid="2CH 36:4" /></para>
  <para style="s1">Yihudiinka Moyanjo Iyyo'aaqemii'i</para>
  <para style="r">(<ref loc="2KI 23:36-24:7">2 Moy. 23:36—24:7</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 36:5" />Iyyo'aaqemi woyeexxa yanna wogga isixxi lame tommenna ondetemman. Isinna Iyyerusaalemii hedhee tommenna mitte wogga moye galche. Isinna Duuchchi Woddika Gootta ifike Mageni edo elobaaxxa yaane huje.<note caller="-" style="x"><char style="xo" closed="false">36:5 </char><char style="xt" closed="false"><ref loc="JER 22:18-19">Erm. 22:18-19</ref>; <ref loc="JER 26:1-6">26:1-6</ref>; <ref loc="JER 35:1-19">35:1-19</ref>. </char></note> <verse eid="2CH 36:5" /><verse number="6" style="v" sid="2CH 36:6" />Baabiloonik moyanji Naabikedenetsoori Yihudiinke arda'ni duule. Moyanjo Iyyo'aqemi booji'eexxi sageettotike sibiljinni usureexxi Baabilooni'a adhdhe me'e.<note caller="-" style="x"><char style="xo" closed="false">36:6 </char><char style="xt" closed="false"><ref loc="JER 25:1-38">Erm. 25:1-38</ref>; <ref loc="JER 36:1-32">36:1-32</ref>; <ref loc="JER 45:1-5">45:1-5</ref>; <ref loc="DAN 1:1-2">Dan. 1:1-2</ref>. </char></note> <verse eid="2CH 36:6" /><verse number="7" style="v" sid="2CH 36:7" />Iittanni Naabukedenetsoori Duuchchi Woddike Goottike galmika miyuwwa adhdheexxi Baabilooni hedheeke ifike fakke magenoofachchotike mine'ni ugge.<verse eid="2CH 36:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 36:8" />Moyanjo Iyyo'aaqemi moyemmake baro'ni hujende muuxendeexxi wele diqachchissaaxxinna elobaaxxi hujeexxi juje duuchchi, Isira'eelikenna Yihudake moyanjuwwike maxaafa'ni barreessendeen. Isixxe bakka'ninna belti isik Ikkoniyaani moye.<verse eid="2CH 36:8" /></para>
  <para style="s1">Yihudiinka Moyanjo Ikkoniyaanii'i</para>
  <para style="r">(<ref loc="2KI 24:8-17">2 Moy. 24:8-17</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 36:9" />Ikkoniyaani moyee wodda wogga isixxi tommenna saddeetakemman; isinna Iyyerusaalemi hedhe sase agenjonna tomme barraa moye galche. Isinna Duuchchi Woddike Goottik edo elobaaxxa yaane huje. <verse eid="2CH 36:9" /><verse number="10" style="v" sid="2CH 36:10" />Midha facansaaxxa yanna moyanji Naabukedenetsoor Duuchchi Woddike Goottike galmi giddo hiri fiixeek miyuwwinni welti Ikkoniyaanii'i Baabilooni'a adhdhe me'e. Ikkoniyaanike annika dayyo<note caller="+" style="f"><char style="fr" closed="false">36:10 </char><char style="ft" closed="false">Anniinka dayyo yookaan dayyo. </char></note> Sedeqiyaasi Yihudiinkenna Iyyerusaalemike moyaashsha asse.<verse eid="2CH 36:10" /></para>
  <para style="s1">Yihudiinka Moyanjo Sedeqiyaasii'i</para>
  <para style="r">(<ref loc="2KI 24:18-20">2 Moy. 24:18-20</ref>; <ref loc="JER 52:1-3">Erm. 52:1-3</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 36:11" />Sedeqiyaasi moyee wodda wogga isixxi lame tommenna mittetemman. Isinna Iyyerusaalemi hedhe tommenna mitte wogga moye galche.<note caller="-" style="x"><char style="xo" closed="false">36:11 </char><char style="xt" closed="false"><ref loc="JER 27:1-22">Erm. 27:1-22</ref>; <ref loc="JER 28:1-17">28:1-17</ref>. </char></note> <verse eid="2CH 36:11" /><verse number="12" style="v" sid="2CH 36:12" />Isinna Duuchchi Woddike Gootti ifike Mageni edo elobaaxxa yaane huje. Duuchchi Woddike Goottika hiyyichcho haaso'eke wabeeka Ermiyaasi edonna ifi heeshi assebaan.<verse eid="2CH 36:12" /></para>
  <para style="s1">Iyyerusaalemixa Iba</para>
  <para style="r">(<ref loc="2KI 25:1-21">2 Moy. 25:1-21</ref>; <ref loc="JER 52:3-11">Erm. 52:3-11</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 36:13" />Iittanni Mageniink summinni kakachchiisemmake moyanjo Naabukedenetsoori'ni fuggoxxinni ke'e. Isinna ajajema gibee godoba jabeessedhe malee Duuchchi Woddika Gootta Isira'eelike Magenibaa higebaan.<note caller="-" style="x"><char style="xo" closed="false">36:13 </char><char style="xt" closed="false"><ref loc="EZK 17:15">Hiz. 17:15</ref>. </char></note> <verse eid="2CH 36:13" /><verse number="14" style="v" sid="2CH 36:14" />Higgeenni qeesetixxinna ardiinxi akeekisano duuchcha xuurameeyye kada gophati, diqachiisaaka gosa gosake ardika galduma hordofa bira sa'na'n me'ine; Iyyerusaalemi giddo woyyoonsemeeka Duuchchi Woddike Goottika galma battoossine.<verse eid="2CH 36:14" /></para>
  <para style="s1">Iyyerusaalemixxa Iba</para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 36:15" />Duuchchi Woddik Gootti edike insa'neke annuwwik Mageni arda ifikeenna ifike woyyichchi galmi'a mararemmaxxee erganjuwwa ergaamman. <verse eid="2CH 36:15" /><verse number="16" style="v" sid="2CH 36:16" />Isira'eelito kinni Mageniinke erganjuwwa'n gacifatte; wabeekotanna coorati, Duuchchi Woddike Goottika hiyyichcho shollise. Tennenaa'ni kexxeexxa Duuchchi Woddeke Goottixxi mufe ardake'ni gelte. Insa'nenna jabaxxe isixxe mufenaa'ni miliqa dandeennebaan. <verse eid="2CH 36:16" /><verse number="17" style="v" sid="2CH 36:17" />Tennexxee Baabilooniki moyanji insa'nee lole miidhaashsha Mageni eettii uwwe; Isinna insa'nexxa dargageeyye galmi giddo wolaantichchik bire; dargageessa yookaan, labbaka geercho, yookaan cimeeka yookaan meyyaxxa, foyebaangi duuchchiinga mararte belo bire.<note caller="-" style="x"><char style="xo" closed="false">36:17 </char><char style="xt" closed="false"><ref loc="JER 21:1-10">Erm. 21:1-10</ref>; <ref loc="JER 34:1-3">34:1-3</ref>. </char></note> <verse eid="2CH 36:17" /><verse number="18" style="v" sid="2CH 36:18" />Isinna lumoke yookaan shiixxooka, Mageniinke galmika miya duuchcha, iittanni Duuchchi Woddike Goottik galmixxa karra, moyanjiinkanna ja'laabuwwiinxa karra duuchcha Baabiloonibaa fe'edhe. <verse eid="2CH 36:18" /><verse number="19" style="v" sid="2CH 36:19" />Insa'nenna Duuchchi Woddike Goottika galma gunbe; Iyyerusaalemika kinjiinka dalla'uwwa diinge; mootummatika minuwwa duuchcha gunbe; ookko hedheeka hiri fiixeeka miyuwwa duuchcha balleessine.<verse eid="2CH 36:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 36:20" />Isinna wolaantichchiki shinnaa'naa gatemmaka booji'e Baabilooni'a adhdhe me'e. Faarsixxi mootumma kexxaa qico'ni isikenna isixxe oosexxe erganjuwwa kande. <verse eid="2CH 36:20" /><verse number="21" style="v" sid="2CH 36:21" />Iikki boginna sanbatiinxa hafuura adhdha, hafuura adhdhe; Duuchchi Woddik Gootti wabeeka Ermiyaasi darree'n haaso'emmaxxi muuxendo'a torbaane tomme wogga muuxendaa qico'n urmake kademake boro duuchcha'n hafuura adhdhe.<note caller="-" style="x"><char style="xo" closed="false">36:21 </char><char style="xt" closed="false"><ref loc="JER 25:11">Erm. 25:11</ref>; <ref loc="JER 29:10">29:10</ref>. </char></note><verse eid="2CH 36:21" /></para>
  <para style="s1">Faarisik Moyanji Qiroos Ayihuud Booji'ememmabaa'n Higaashsha Ajajeexxa</para>
  <para style="r">(<ref loc="EZR 1:1-4">Izr. 1:1-4</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 36:22" />Duuchchi Woddik Gootti wabeeki Ermiyaasi darree'ni edise haaso'eek raagiink hiyyichchi, Faarsike moyanjo Qiroosi moye galchemmake baro'ni siretixxe wogga'ni isi galchammake boga duuchcha'ni lassa lassisaashshanna tinni duuchchi borreessendaashsha Duuchchi Woddik Gootti Faarisika moyanjo Qiiroosii'i ke'isse.<verse eid="2CH 36:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="2CH 36:23" />Faarsik moyanji Qiroosi hiyya'nee qici:</para>
  <para style="pm" vid="2CH 36:23">« ‹Duuchchi Woddiki Gootti iimik Mageni buttattixxa mootumma duuchcha ani'a uwwe'een; Yihudiinke bogi giddo Iyyerusaalemik qachcha'ni isi'a woyyichcha galma ijaaronnaa anee ajaje'een. Ardi giddo hedheeki huuni isik manjinna Duuchchi Woddik Gootti isik Mageni isinni welti hedhowwaal; isinna alaalle Iyyerussaalemi'a marowwaal.› »<note caller="-" style="x"><char style="xo" closed="false">36:23 </char><char style="xt" closed="false"><ref loc="ISA 44:28">Isa. 44:28</ref>.</char></note><verse eid="2CH 36:23" /></para>
  <chapter eid="2CH 36" />
</usx>