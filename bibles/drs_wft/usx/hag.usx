<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAG" style="id">- Gedeo Bible</book>
  <para style="h">Hagekaa Raaga</para>
  <para style="toc1">Hagekaa Raaga</para>
  <para style="toc2">Hagekaa Raaga</para>
  <para style="toc3">Hag.</para>
  <para style="mt1">Hagekaa Raaga</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Hageke raaga'n bukki hite hexxeexxi harummamma erga, Mageni Kirstoosixxe ilensha edi darre onde dhibba wogga'n wabeekichcha Hage darree'n sa'isseexxe erguwwan; ardi iikki booji'otenaa'n higeexxi Iyyerussaalemi ofo'la safeexxenni heenoxxi wogguwwa saxxeexxe kaddoolenna midde, iikki Mageniink galmi diigemeeshshanni hedhemman; tennexxee tinni eraga iikki ardiink akeekisanjuwwi Mageniinka ookkone galma haaroba hiisseexxi ijaaraashsha dammasita'neexxemman; ardi haaro'manna luqqi hiyya heger afaaxxe kaddoole, Mageni edi'a nage'akanna durumma insa'ne'a uwwaaxxa haaso'aan.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Duuchchi Woddik Gootti Ifik Galmi ijaaremaashsha ajajeexxa <char style="ior"><ref loc="HAG 1:1-15">1:1-15</ref> </char></para>
  <para style="io1">Duuchchi Woddik Gootti arda ifikee uwweexxa eebbaxxanna dayyeeffachchoxxa addachchiisa <char style="ior"><ref loc="HAG 2:1-19">2:1-19</ref> </char></para>
  <para style="io1">Mageni Zerbaabeli'a uwweexxa addachchiisa <char style="ior"><ref loc="HAG 2:20-23">2:20-23</ref> </char></para>
  <chapter number="1" style="c" sid="HAG 1" />
  <para style="s1">Duuchchi Woddike Goottika Mine Ijaaratee Asseemeeka Ye'injo</para>
  <para style="p">
    <verse number="1" style="v" sid="HAG 1:1" />Daariyoosi moyeexxe langaxxe woggake jiyake agenjixxe taakkaxxe barra'n Duuchchi Woddike Goottik hiyyichchi wabeeka Haage darree'n Yihudiinka moyanjo Selaatiyaka belto Zerubaabeli'aanna umo qeesichcho Iyyooseedeqika belto Iyyaasuubaa daggeexxi:<verse eid="HAG 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HAG 1:2" />Dada duuchcha ajajaak Duuchchi Woddik Gootti hiyya'nee qici, «Kunni ardi ‹Duuchchi Woddike Goottik mini ijaaremaaxxi yanna ta'i qico gelteebaan hiyyaan› » hiyye.<verse eid="HAG 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HAG 1:3" />Duuchchi Woddike Goottik hiyyichchinna wabeekichcha Haage'n dageexxi hiyyee qici, <verse eid="HAG 1:3" /><verse number="4" style="v" sid="HAG 1:4" />«Kunni mini diigemeexxi hedhee'naa ha'no umo ha'nookenni danchoomeeke ifi ifike mine'n hexxino'a yannatee isii?»<verse eid="HAG 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HAG 1:5" />Tennexxee dada duuchcha ajajaak Duuchchi Woddik Gootti hiyya'nee qici, «Amme ora ha'nooka hubattine uudde; <verse eid="HAG 1:5" /><verse number="6" style="v" sid="HAG 1:6" />lumoxxa midha rokineen; yaane kinni heenoxxa haa'mitine;</para>
  <para style="q2" vid="HAG 1:6">ittineen kinni godditinebaan;</para>
  <para style="q2" vid="HAG 1:6">ha'witineen kinni dheebo fuldinebaan</para>
  <para style="q2" vid="HAG 1:6">oddo'witineen kinni eebbitinebaan;</para>
  <para style="q2" vid="HAG 1:6">runda adhdhitineen kinni uremeeke subba'n uggudhdhitineeshshaten.»<verse eid="HAG 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HAG 1:7" />Dada duuchcha ajajaak Duuchchi Woddik Gootti hiyya'nee qici, «Amme ora ha'nooka hubattine uudde; <verse eid="HAG 1:7" /><verse number="8" style="v" sid="HAG 1:8" />koobatanna qabattine'e haqqe iyyedagge; mine ookkonne ani'a ijaarre; aninna iso'ni gammadannon; iso'ninna ulfatannon» hiyya'neen Duuchchi Woddik Gootti. <verse eid="HAG 1:8" /><verse number="9" style="v" sid="HAG 1:9" />Dada duuchcha ajajaak Duuchchi Woddik Gootti hiyya'nee qici, «Jirachcho heqqexxineen alfitineechchi kinni heenochcho; mine aassexxineechcho'n ani uffuu hiyyenne; tinni kaddeek mayeete ha'no'n labbe?» hiyya'neeni dada duuchcha ajajaak Duuchchi Woddik Gootti. «Mini anki diigemeexxi hedhee'naa duuchchiingi ifi ifika mine ijaadhdhatee gongitinenmmaxxeeten. <verse eid="HAG 1:9" /><verse number="10" style="v" sid="HAG 1:10" />Tennexxee ha'nooxxe buuto'a iimuwwa xeena hoyyexxe; buttatinna ifixxa gumma uwwa gibbe. <verse eid="HAG 1:10" /><verse number="11" style="v" sid="HAG 1:11" />Aninna fichchuwwake'ninna koobuwwate'n, eettene midhate'ninna eettene reefixxe woyinetixxe booka'n eettene zayite'ninna butta gummissaachcho duuchcha'n, hore manjoke'n anga ha'nooxxenni huccitineechcho duuchcha'n bange iyyedagannon.»<verse eid="HAG 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HAG 1:12" />Ookkoneechchi uduma Selaatiyak belti Zerubaabeli, umo qeessichcho Iyyooseedeqik belti Iyyaasu booji'otenaa'n gateek ardi Duuchchi Woddika Gootta ifike Magenika haaso'anna Duuchchi Woddiki Gootti ifik Mageni ergeeke kaddeemmaxxee wabeekichcha Haage darree'n ergendeexxe erga'a ajajemme; ardikinna Duuchchi Woddika Gootta sodaatte.<verse eid="HAG 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HAG 1:13" />Higgeenni Duuchchi Woddike Goottik erganji Haage tenne Duuchchi Woddike Gottixxa erga ardake'n hiyya'n haaso'ee qici, «Ani ha'nonni welt hedhennen» hiyya'neen Duuchchi Woddik Gootti. <verse eid="HAG 1:13" /><verse number="14" style="v" sid="HAG 1:14" />Tennexxee Duuchchi Woddiki Gootti Yihudaka galchallo Selaatiyaka belto Zerubaabeelika irra ookkone umo qeesichcho Iyyooseedeqika belto Iyyaasuuka irranna booji'otenaa'n gateeke ardi duuchchika irra ke'isse; insa'nenna dangeexxi dada duuchcha ajajaaka Duuchchi Woddike Gootta ifike Magenika mine ijaara sanfe. <verse eid="HAG 1:14" /><verse number="15" style="v" sid="HAG 1:15" />Tinninna kaddeek Daariyoosi moyeexxe jiyaxxe woggaxxe lame tommenna sholgaxxe bara'nitemman.<verse eid="HAG 1:15" /></para>
  <chapter eid="HAG 1" />
  <chapter number="2" style="c" sid="HAG 2" />
  <para style="s1">Addachchiisa Uwwendeemmake Ookkone Haaroke Minika Gaachchanna</para>
  <para style="p">
    <verse number="1" style="v" sid="HAG 2:1" />Ookkone torbake agnjo'n lame tommena mitte barra'n Duuchchi Woddike Goottik hiyyichchi wabeeka Haage darree'n dageexxi hiyyee qici, <verse eid="HAG 2:1" /><verse number="2" style="v" sid="HAG 2:2" />«Yihudak galchallallo Selaatiyaka belto Zerubaabeli'n, umo qeesichcho Iyyooseedeqika belto Iyyaasuu'ninna, booji'otenaa'n gateeke manna'n hite haasoottatoo qicinna hite'e insa'nee qortato qici <verse eid="HAG 2:2" /><verse number="3" style="v" sid="HAG 2:3" />‹Konnee mine edi woddike isike gaachchanninni hedheena'a uudeek ha'noo giddo gateek hedhee? Ta'ata kunni mini hitta hedhee'naa uuddina'ne? Isi ille ha'noxxe'n mittichchishshannatebaan hiyyatebaata?<note caller="-" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="EZR 3:12">Izr. 3:12</ref>. </char></note> <verse eid="HAG 2:3" /><verse number="4" style="v" sid="HAG 2:4" />Ta'a kinni koo Zerubaabel jabaat› hiyya'neen Duuchchi Woddik Gootti; ‹Umo qeesichchike Iyyooseedeqike belto koo Iyyaasuu jabaati; ha'noo konne bogiki ardi duuchchi jabaatte› hiyya'neen Duuchchi Woddi Gootti ‹Ani ha'nonni welt hedhenen hujjee› hiyya'neen dada duuchcha ajajaak Duuchchi Woddik Gootti. <verse eid="HAG 2:4" /><verse number="5" style="v" sid="HAG 2:5" />Gibtsee'n fuldinee wodda ‹Hafuuri ank ha'nooxxe oddo'n hedhaan sodaattinoqqe'e› hiyye ha'no'a aageennaxxi kako tenneten.<verse eid="HAG 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HAG 2:6" />«Dada duuchcha ajajaak Duuchchi Woddik Gootti hiyyee qici, ‹Ani shiqoxxe yanna'n iimatanna butta, abbaayyatanna abbaayya hexxebaaka bago boga mittele sheke sheke assannon. <verse eid="HAG 2:6" /><verse number="7" style="v" sid="HAG 2:7" />Gosa gosaka arda duuchchanna sheke sheke assannon; gosa gosake ardi duuchchixxi karra duuchchanna kabaa daggaan; konnee mine'ninna gaachchanna wonshannon› hiyya'neen duuchchiinga galchaak dada duuchcha ajajaak Duuchchi Woddik Gootti. <verse eid="HAG 2:7" /><verse number="8" style="v" sid="HAG 2:8" />‹Birretik sbili anken; worqetinna anixxen› hiyya'neen dada duuchcha ajajaak Duuchchi Woddik Gootti. <verse eid="HAG 2:8" /><verse number="9" style="v" sid="HAG 2:9" />‹Konne ta'ike minik gaachchanni edike minike gaachchaninaa'n sa'aan› hiyya'neen dada duuchcha ajajaak Duuchchi Woddik Gootti; ‹Konne booncho'ninna naga'a uwwannon› hiyya'neen dada duuchcha ajajaak Duuchchi Woddik Gootti.»<verse eid="HAG 2:9" /></para>
  <para style="s1">Xixichchokanna Eebbaa</para>
  <para style="p">
    <verse number="10" style="v" sid="HAG 2:10" />Daariyoosi moyeexxe langaxxe woggake sallanke agejixxe lame tommenna sholgaxxe barra'n Duuchchi Woddike Goottik hiyyichchi wabeeki Haage darree'n dageexxi hiyyee qici, <verse eid="HAG 2:10" /><verse number="11" style="v" sid="HAG 2:11" />«Dada duuchcha ajajaak Duuchchi Woddik Gootti hiyya'nee qici, ‹Seeri maa hiyya'neexxa qeese hite qortatto qici, <verse eid="HAG 2:11" /><verse number="12" style="v" sid="HAG 2:12" />mitti manji woyyichcha maala ifixxe seemma'n abixxoole eettenee abixxeemmaxxa bakkanna iitti ita yookaan qaa'matichchi yookaan woyinetixxi booka yookaan zayite yookaan wele ita tuqqoole woyyittete kaddaata?› »</para>
  <para style="p" vid="HAG 2:12">Qeesetinna «Waawwo woyyittete kaddabaan» hiteexxi hiissite haasotte. <verse eid="HAG 2:12" /><verse number="13" style="v" sid="HAG 2:13" />Haagenna «Rensha tuqati batto'eek manji konnechchirinaa'n mitte tuqeexxe kaddoole, iitti tuqndemmaxxi battoottabaata? Hiyye qore?»</para>
  <para style="p" vid="HAG 2:13">Qeesetinna «Eeti battoottaan» hite hiissite haasotte.<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="NUM 19:1-22">Lak. 19:1-22</ref>. </char></note> <verse eid="HAG 2:13" /><verse number="14" style="v" sid="HAG 2:14" />Ookkoneechchinni uduma Haagenna, « ‹Kunni ardinna tinni gosa ani edo iittanden› hiyya'neen Duuchchi Woddik Gootti; ‹Anga insa'neexxi hujjeechchi duuchchinna shiqinshaachchi duuchchi batto'eeken.<verse eid="HAG 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HAG 2:15" />« ‹Yoonna ta'anni edi'a Duuchchi Woddike Goottike galmi'a mitti kinji mitte kinji hana uggememmabaa edi darre hexxemmaxxa yaane hubattine uudde. <verse eid="HAG 2:15" /><verse number="16" style="v" sid="HAG 2:16" />Mitt manji lame tomme safaranjo kaddaaxxe midhaxxe tuulobaa daggeexxi tomme calla alfe; onde tomme ikkilsanjo woyinetixxa booka ikki'latee iitti woyine miicendammaxxe bakkabaa marreexxi lame tomme calla alfe. <verse eid="HAG 2:16" /><verse number="17" style="v" sid="HAG 2:17" />Ani ha'noxxe angaxxa huje duuchcha midhatike dhukkubinni buqunikinna kaadeti ganneenen; ha'no kinni anibaa higginebaan› hiyya'neen Duuchchi Woddik Gootti. <verse eid="HAG 2:17" /><verse number="18" style="v" sid="HAG 2:18" />‹Tenne barranaa'n tinninna sallank agenjixxe lame tommenna shoole barranaa'n Duuchchi Woddike Goottike Galmixxi booso kaasendeexxe barra qico'n hexxeexxa barra qalbeeffatte; qalbeeffatine hedde. <verse eid="HAG 2:18" /><verse number="19" style="v" sid="HAG 2:19" />Gootaar giddo gatteexxi midha ta'a hexxeeta? Woyinetikinna balasetik haqichchi roomaankinna ejersiink haqichchi ta'i qico gummisebaan.</para>
  <para style="p" vid="HAG 2:19">« ‹Ani ha'noo tenne barranaa'n safe eebbisanon.› »<verse eid="HAG 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HAG 2:20" />Ookkone agenjixxe lame tommenna sholgaxxe barra'n Duuchchi Woddike Goottik hiyyichchi langaxxa dageexxi Haage'n hiyyee qici, <verse eid="HAG 2:20" /><verse number="21" style="v" sid="HAG 2:21" />«Ani iimatanna butta sheke sheke assannoxxe Yihudaka galchallo Zerubaabeli'n kuli. <verse eid="HAG 2:21" /><verse number="22" style="v" sid="HAG 2:22" />Ani moottumuwwatixxa moote gonbisannon; alagiinxe moottumuwwaxxa hunna balleessannon; sarageelluwwakanna sarageelluwwa oofaakaara gonbisannon; fadhado gulufaammakiir ifi ifike dayyuwwike wolaantichcha'n ibaan.<verse eid="HAG 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HAG 2:23" />«Dada duuchcha ajajaak Duuchchi Woddik Gootti hiyya'nee qici, ‹Eettne barra anke erganjoo Selaatiyake belto koo Zerubaabeli ani atee anke erganjo assedheennen› hiyya'neen Duuchchi Woddik Gootti. ‹Ani atee fi'leennaxxee anxe maxansiinxe qube atee assedheennen,› hiyya'neen dada duuchcha ajajaak Duuchchi Woddik Gootti.»<verse eid="HAG 2:23" /></para>
  <chapter eid="HAG 2" />
</usx>