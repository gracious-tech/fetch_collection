<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAL" style="id">- Gedeo Bible</book>
  <para style="h">Milkiyaasikaa Raagaa</para>
  <para style="toc1">Milkiyaasikaa Raagaa</para>
  <para style="toc2">Milkiyaasikaa Raagaa</para>
  <para style="toc3">Mil.</para>
  <para style="mt1">Milkiyaasikaa Raagaa</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Milkiyaasiki raagi afemeek kiresitoosixxe ilensha edi darre onde dhibba wogga, Iyyerussaalemik Woyyichchi Galmi langaxxa ijaremeechchi udumamman. Kunni wabeek qeesetenna kadi Mageniink ardi Magenik agemmaxxa kako haaronsa insa'nee haasissaaxxe kaddeexxa jabeessee kula'emman. Mageniink ardi galdumi duuchchininna kaddo'o magenooffachchoti seernaa'ni goreekenna busheeke kadeexxa tinni kokaken.</para>
  <para style="ip">Qeesetinna ardi hasisaaka tolcha shiqisha gophatinna isi uwweexxe akeette'n hedha gophati Mageno sobatee hendaamman. Tennexxee Mageni ora isika qixxesateenna, seera isika lallabatee, ifika erganjo ediseeni ergati ifike arda'n murat arda luqqi asso'a dagaan.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Duuchchi Woddik Gootti Isira'eelike ardi'a Afe'eexxa Jalala <char style="ior"><ref loc="MAL 1:1-5">1:1-5</ref> </char></para>
  <para style="io1">Qeesolete'n Mageniinxa Murte <char style="ior"><ref loc="MAL 1:6-2:9">1:6—2:9</ref> </char></para>
  <para style="io1">Kakotixxa Diigensha <char style="ior"><ref loc="MAL 2:10-17">2:10-17</ref> </char></para>
  <para style="io1">Duuchchi Woddike Goottixxa Daga <char style="ior"><ref loc="MAL 3:1-4">3:1-4</ref> </char></para>
  <para style="io1">Mageno Soba Hassissabaaxxe Kaddeexxa <char style="ior"><ref loc="MAL 3:5-15">3:5-15</ref> </char></para>
  <para style="io1">Xuurameeyyetixxa Gica Alfanna Fuggaaleyyetixxa Murte adhdha <char style="ior"><ref loc="MAL 3:16-4:6">3:16—4:6</ref> </char></para>
  <chapter number="1" style="c" sid="MAL 1" />
  <para style="s1">Qeesetee Uwwendeexxa Xexxe'achchiisa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAL 1:1" />Milkiyaasi darree'n Isira'eelike ardibaa dageeke Duuchchi Woddike Goottik hiyyichchi konnechchi bitta hedheeken.<verse eid="MAL 1:1" /></para>
  <para style="s1">Ya'iqoob Eeyyeme, Eesawu Jibbeme</para>
  <para style="p">
    <verse number="2" style="v" sid="MAL 1:2" />«Ani ha'noo eeyyeennen» hiyya'neen Duuchchi Woddik Gootti.</para>
  <para style="p" vid="MAL 1:2">«Ha'noo kinni, ‹hitta no'oo eettette› hitineen.</para>
  <para style="p" vid="MAL 1:2">«Eesaawu Ya'iqoobinge dayyomabaata?»</para>
  <para style="q2" vid="MAL 1:2">«Ya'iqoobii'i eeyyenne; <verse eid="MAL 1:2" /><verse number="3" style="v" sid="MAL 1:3" />yaane kinni Eesaawu'u jibbenne;</para>
  <para style="q2" vid="MAL 1:3">isixxa koobuwwanna urmake asse'eennen;</para>
  <para style="q1" vid="MAL 1:3">Isika qadaadanna qiilla gammoojjeke jeedaluwwi'a uwwe'eennen.» <note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ROM 9:13">Rom. 9:13</ref>.</char></note><verse eid="MAL 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAL 1:4" />Eedoominna, «No'ok qachchi diigeme'een, kaddo malee'e ookkonee diigemeeka hiisinee ijaarannon» hiyyaaxxe hexxeen.</para>
  <para style="p" vid="MAL 1:4">Yaane kinni dada duuchcha ajajaak Duuchchi Woddik Gootti hiyya'nee qici: «Insa'ne ijaaraaxxe hexxeen; ani kinni diiganno; fuggoke boga, Duuchchi Woddik Gootti duuchchi woddi'a insa'ne'n mufateeke arda hiyyemmaan. <verse eid="MAL 1:4" /><verse number="5" style="v" sid="MAL 1:5" />Ha'nonna tenne'e ha'noonxe illenninni uuddinaan, ‹Ha'noonna Isira'eelixxe gabala gadho Duuchchi Woddik Gootti Lumoken hitinaan!›<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">Isa. 34:5-17</ref>; <ref loc="ISA 63:1-6">63:1-6</ref>; <ref loc="JER 49:7-22">Erm. 49:7-22</ref>; <ref loc="EZK 25:12-14">Hiz. 25:12-14</ref>; <ref loc="EZK 35:1-15">35:1-15</ref>; <ref loc="AMO 1:11-12">Amo. 1:11-12</ref>; <ref loc="HEB 1:14">Ibr. 1:14</ref>.</char></note><verse eid="MAL 1:5" /></para>
  <para style="s1">Ci'memeeka Tolcha</para>
  <para style="p">
    <verse number="6" style="v" sid="MAL 1:6" />«Belt ifika anna garbichchikinna, ifika gootta ulfessaan. Ani annake kadennechchinni ulfaata anxita haba hexxeta? Goottake kadenechinni sodaatema anxi haba hexxeta?» hiyya'neen dada duuchcha ajajaak Duuchchi Woddik Gootti. «Tee qeese anka summa tuffachisina'neek ha'nooten.</para>
  <para style="p" vid="MAL 1:6">«Ha'noonna kinni, ‹Atika summa tuffachchiinsennek hittate?› hitina'neen.<verse eid="MAL 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAL 1:7" />«Anke tolchimalcho'n battotteexxe ita shiqisinaan.</para>
  <para style="p" vid="MAL 1:7">«Ha'noo kinni, ‹atee battoosineenek hittate?› hitinaan?</para>
  <para style="p" vid="MAL 1:7">«Duuchchi Woddike Goottixxi qore tufatendeexxen hiyyatiten. <verse eid="MAL 1:7" /><verse number="8" style="v" sid="MAL 1:8" />Ille ba'eeka hore tolchakee shiqishinaa wodda iitti balleessatebataa? Naafa yookaan dhukkullichcha hore tolchakee shiqisinaa wodda tinninna balleesatebaata? Ookkone ha'nooke galchalli'a shiqisatto wodda isi ate'n gammadaata? Yookaan atenaa'n adhdhaataa?» hiyya'neen Dada Duuchcha Ajajaak Duuchchi Woddik Gootti.<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="LEV 15:21">Lew. 15:21</ref>.</char></note><verse eid="MAL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAL 1:9" />«Ta'a kinni no'o'a mararaashsha Duuchchi Woddika Gootta kadhatte; iitta hedheeka tolcha aaxxine shiqinaa woodda isi ha'no'n macci hiyyaata?» hiya'neen Dada Duuchcha Ajajaak Duuchchi Woddik Gootti.<verse eid="MAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAL 1:10" />«Anke tolchimalcho'n woyi fuldabaaxxa giira he'yishinabaashsha ha'noo giddii'ni mitti galmiinxa hula cufeelenaa! Ani ha'noo'n gammadabe'no,» hiyya'neen Dada Duuchcha Ajajaak Duuchchi Woddik Gootti; «Anga ha'nooxxenaa'ni hoone tolchanna adhdhabe'no. <verse eid="MAL 1:10" /><verse number="11" style="v" sid="MAL 1:11" />Arishsho fuldammabaa'n e'yitamma qico'n summi ank gosa gosake arda duuchcha'n lummedhaan; summi ank gosa gosake arda duuchcha'n lumedhammaxxee duuchchiinxe bakka'n hixaanikinna luqqitte uwwa ani'a shiqqaan» hiyya'neen Dada Duuchcha Ajajaak Duuchchi Woddik Gootti.<verse eid="MAL 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAL 1:12" />«Ha'noo kinni Dada Duuchchike Goottixxi qore, ‹Battoteexxen› ita isixxinna, ‹Tuffatendeexxen› hitina'n isoo shollissineen. <verse eid="MAL 1:12" /><verse number="13" style="v" sid="MAL 1:13" />Ha'noonna, ‹Tinni hittata kurbu assita'neexxe yaane!› hitina'n qi'mi hitineen» hiyya'neen Dada Duuchcha Ajajaaki Duuchchi Woddik Gootti.</para>
  <para style="p" vid="MAL 1:13">«Ha'noo mooremeemmaka naafakanna ela gopheeka hore ani'a iyyedagineexxi uutinoole ani konneera ha'nooxxe anganaa'n adhdhannota?» hiyya'neen Duuchchi Woddik Gootti. <verse eid="MAL 1:13" /><verse number="14" style="v" sid="MAL 1:14" />«Ani Dada Duuchchike Goottan; summi ankinna gosa gosake arda'n sodaatema hassissaake kadeennaxxee'e, hore ifik giddo buruusi hedhe'naan werreegemmaka werreega gaabbat ci'memmeeka hore Duuchchi Woddike Gootti'a tolchaak badinemeeke kadowwaal» hiyya'neen Dada Duuchcha Ajajaaki Duuchchi Woddik Gootti.<verse eid="MAL 1:14" /></para>
  <chapter eid="MAL 1" />
  <chapter number="2" style="c" sid="MAL 2" />
  <para style="p">
    <verse number="1" style="v" sid="MAL 2:1" />«Ta'anna tee qeese kunni ajaji ha'noo'aten. <verse eid="MAL 2:1" /><verse number="2" style="v" sid="MAL 2:2" />Laqa gophphinoole qalbe ha'nooxxanna anee ulfeesatee qixxefata gohphinoole» yoona badino ha'noo'n wocci assannon: eebbisensha ha'nooxxanna badinote'n jijjiirannon ha'noonna «Anee ulfeessatee qalbe ha'nooxxa qixxeefata gophphineemmaxxee ha'noo badinendine'een hiyya'neen Dada Duuchcha Ajajaak Duuchchi Woddik Gootti.<verse eid="MAL 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAL 2:3" />«Horte ha'nooxxanna xixannon; ha'nooke tolchika cege'oo alba ha'noke'n xeerannon; ha'noonna isinninni mitteba fugussendinaan. <verse eid="MAL 2:3" /><verse number="4" style="v" sid="MAL 2:4" />Leewwi'a aagennexxe kako'a konne ajaja ergennek ante kadeennaxxa egendinaan» hiyya'neen Dada Duuchcha Ajajaak Duuchchi Woddik Gootti.<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="NUM 3:11-13">Lak. 3:11-13</ref>. </char></note> <verse eid="MAL 2:4" /><verse number="5" style="v" sid="MAL 2:5" />«Isi'a aagennexxi kako hedhotixxenna nage'iinxe kakomman; tennee hedhonna nage'a insa'ne'aa uwweennen; tinninna ani'a ulfinna iyyedagge; isinna anee ulfeesse; summa ankanna sodaataten jabaate. <verse eid="MAL 2:5" /><verse number="6" style="v" sid="MAL 2:6" />Dhugaatixxi barachchiisa isike afo'o'n hexxemman; arrabo isikenaa'ninna dhari afemebaan; aninni welt nage'ikinna qajeelummat me'e; heddo mannanna cubbotenaa'n ille iima hiisse.<verse eid="MAL 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAL 2:7" />«Qeesichchi Dada Duuchcha Ajajaak Duuchchi Woddike Goottike erganjo kadeemmaxxee'e arrabi isiki ege'naa, mannikinna isike afo'inaa'n barachcho heqqedha hassissaan. <verse eid="MAL 2:7" /><verse number="8" style="v" sid="MAL 2:8" />Yaane kinni ha'no ookkone oranaa'n gortine'een; ha'nooxxe barachchiissanninna heddo manni guggufataashsha assitine'een; Leewwixxi kakonna bushshaashsha assitine'een» hiyya'neen Dada Duuchcha Ajajaake Duuchchi Woddik Goott. <verse eid="MAL 2:8" /><verse number="9" style="v" sid="MAL 2:9" />«Tennexxee ora anke'n me'a gophphineemmaxxeenna ha'nooxxe barachchiissanni gamissineemmaxxee'e ardi duuchchi edo tuffatendinaashshanna salphatinaashsha ha'noo asseenenni.»<verse eid="MAL 2:9" /></para>
  <para style="s1">Yihudaxxa Xuurameesa Kada Gopha</para>
  <para style="p">
    <verse number="10" style="v" sid="MAL 2:10" />No'o duuchchiingi anfeennek mitte annabaata? No'o dadeekinna mittenge Magenobaata? Weli'anni weli xuurameeyyete kada gonphe xe'yishati no'oke annuwwaxxa kako mayee diinganotaa?<verse eid="MAL 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAL 2:11" />Yihuda amanemebaan; Yihuda'ninna Iyyerusaalemi giddo diqachchiissaaxxi yaane assende'een. Yihuda alag magenixxa belto aadhati Duuchchi Woddik Gootti eyyaaka galma battoose'een. <verse eid="MAL 2:11" /><verse number="12" style="v" sid="MAL 2:12" />Tenne assaak huuni manjinna Duuchchi Woddike Gootti'a uwwa iyyedagoolenna midde Dada Duuchcha Ajaajaak Duuchchi Woddike Gootti Ya'iqoobike duunkaaninaa'n isoo fugussaan.<verse eid="MAL 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAL 2:13" />Assitnaaxxi wele yaanee: Duuchchi Woddike Goottika tolchimalcho indiddotike assitinaan; ta'anni edi'a ha'nooxxe uwwa'n macci hiyya gophaammaxxeenna gammashshoti anga ha'nooxxenaa'n adhdha gophaammaxxee ooxxinaan; hunbaashitinaan. <verse eid="MAL 2:13" /><verse number="14" style="v" sid="MAL 2:14" />Ha'noonna «Tinni mayee kaddee?» hitine qortinaan; tinni kaddeechchi Duuchchi Woddik Gootti atixxenna atixxe oosummati woddixxe arexxe oddo'n dhugaa kulate kadeemmaxxeeten. <verse eid="MAL 2:14" /><verse number="15" style="v" sid="MAL 2:15" />Duuchchi Woddik Gootti insa'nee mitteke assemmabaata? Insa'ne maalikinna hafuurik isiken; mayeete insa'nee mitteke asseechchi? Mageniinxa soda'a affeexxa horte hasa'neemmaxxeeten. Tennexxee hafuura ha'nooka heqqedhdhe; ha'nooxxe oosummatixxe are'aa affineemmaxxa xuurameessumma xe'yishshinoqqe'e.<verse eid="MAL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAL 2:16" />«Ani weli tikate gibanno» hiyya'neen Duuchchi Woddik Gootti Isira'eelik Magen; «Manji seemmati ifi buqammashsha xaqarotti ifi buqa<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">yookaan</char><char style="fqa" closed="false">Ifixxa are </char></note> manjiinxe gibannon,» hiyya'neen dada duuchcha ajajaak Duuchchi Woddik Gootti.</para>
  <para style="p" vid="MAL 2:16">Tennexxee xuurameesumma ha'nooxxi xe'yitabaashsha hafuura ha'nooka heqqedhdhe.<verse eid="MAL 2:16" /></para>
  <para style="s1">Murtetixxa Barra</para>
  <para style="p">
    <verse number="17" style="v" sid="MAL 2:17" />Duuchchi Woddik Gootta haaso'a ha'nookenni ko'wisine'een.</para>
  <para style="p" vid="MAL 2:17">Ha'noonna, «Hitta isoo ko'winsenne?» hitinaan.</para>
  <para style="p" vid="MAL 2:17">«Fuggoxxa assaak duuchchi, Duuchchi Woddike Gootti edo eloken» isinna fuggaaleeyyete'n gammadaan.</para>
  <para style="p" vid="MAL 2:17">Yookaan «Dhugaa muraak Mageni haba hedhee?» hitine qoratiten.<verse eid="MAL 2:17" /></para>
  <chapter eid="MAL 2" />
  <chapter number="3" style="c" sid="MAL 3" />
  <para style="p">
    <verse number="1" style="v" sid="MAL 3:1" />«Kunnise, ani'a ora qixxeessaaka anka erganjo ergona'aten; halchitina'neek Dada Duuchchi Gootti galma ifikibaa dedhange dagaan; iso'n gammaddinaak eettene kakok erganji dagaan» hiyya'neen Dada Duuchcha Ajajaak Duuchchi Woddik Gootti.<verse eid="MAL 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAL 3:2" />Yaane kinni isi baqissammaxxe giirashsha yookaan anshatike saamunishshate kaddeemmaxxee isixxe dagaxxa barra dande'aak ayyete? Lufi hiyyaaxxa yanna uurraak ayyetee?<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="JOL 2:11">Iyu. 2:11</ref>; <ref loc="REV 6:17">Wal. 6:17</ref>. </char></note> <verse eid="MAL 3:2" /><verse number="3" style="v" sid="MAL 3:3" />Isinna birretika sibilo baqiseexxi luqqaasammake manjishsha ofo'laan; Leewwitotanna baqiseexxi worqetishanna birretike sibilishsha luqqi assaan. Ookkonneechchi uduma uwwa qullummati shiqishaaka manna Duuchchi Woddik Gootti afaan. <verse eid="MAL 3:3" /><verse number="4" style="v" sid="MAL 3:4" />Yihudaxxinna Iyyerusaalemixxi uwwaarinna saxxeexxe wogguwwashanna edike baruwwishsha Duuchchi Woddike Gootta'n adhdhendaaxxe kadda.<verse eid="MAL 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAL 3:5" />«Tennexxe ani murtetee ha'nooba dagannon; gojaaleeyyete'n, yabaabulake'n, dharik kakataakeera'n, hujaluwwiinka runda hoyyedhaakeera'n, aro'o affebaaxxaranna anna ama afebaaka miicaakeera'n, alagi mannixxa dhugaa dassaakeera'ninna aneenna sodatabaakeera'n rake dhugaa kulannon» hiyya'neen Dada Duuchcha Ajajaak Duuchchi Woddik Gootti.<verse eid="MAL 3:5" /></para>
  <para style="s1">Mageno Mooraa</para>
  <para style="p">
    <verse number="6" style="v" sid="MAL 3:6" />«Ani Duuchchi Woddik Gootti jijjiiremannokebaan; tennexxee ha'noo Ya'iqoobixxe hortee baxxineexxeba'a. <verse eid="MAL 3:6" /><verse number="7" style="v" sid="MAL 3:7" />Ha'nooke annuwwixxe yannanaa'ni anke seruwwinaa'n illee iima higgine'een, heqqexxinebaan; anibaanna higge, Aninna ha'noobaa higannon» hiyya'neen Dada Duuchcha Ajajaak Duuchchi Woddik Gootti.</para>
  <para style="p" vid="MAL 3:7">«Ha'noonna ‹Hingannok hittatee?› hitinaan.<verse eid="MAL 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAL 3:8" />«Manji isi Mageno mooraachcho? Ha'noo anee moortine'een.</para>
  <para style="p" vid="MAL 3:8">«Ha'noonna ‹Hittaa atee moorranno?› hitinaan.</para>
  <para style="p" vid="MAL 3:8">«Tommittetinna uwwatiten. <verse eid="MAL 3:8" /><verse number="9" style="v" sid="MAL 3:9" />Ha'noo, kunni ha'nook ardi duuchchi anee moortinaammaxxee'e badindineeken. <verse eid="MAL 3:9" /><verse number="10" style="v" sid="MAL 3:10" />Mine anke'n ita hexxo'aa, tommitte duuchcha gootarake'n aasse; tenneninna anee hega uudde» hiyya'neen Dada Duuchcha Ajajaak Duuchchi Woddik Gootti. «Iimuwwatixxa masikootuwwanna banabe'noxxa, uggudhitinaaxxa bakka gophinaa qici'a bira saxxeexxa eebbanna ha'no'a duna gophannoxxa udde.<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="LEV 27:30">Lew. 27:30</ref>; <ref loc="NUM 18:21-24">Lak. 18:21-24</ref>; <ref loc="LEV 12:6">Lew. 12:6</ref>; <ref loc="LEV 14:22-29">14:22-29</ref>; <ref loc="NEH 13:12">Neh. 13:12</ref>. </char></note> <verse eid="MAL 3:10" /><verse number="11" style="v" sid="MAL 3:11" />Ha'nooxxa midha daamili itabaashsha hoyyannon; ha'nooke fichcha'n hedheek woyinetik hiddichchinna doomaba'a» hiyya'neen Dada Duuchcha Ajajaak Duuchchi Woddike Gootti. <verse eid="MAL 3:11" /><verse number="12" style="v" sid="MAL 3:12" />«Ookkonneechchi uduma gammashshotike boga kaddinaammaxxe'e gosa gosak ardi duuchchi eebbisemeeke arda hiyye ha'noo ye'aan» hiyya'neen Dada Duuchcha Ajajaake Duuchchi Woddik Gootti.<verse eid="MAL 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAL 3:13" />«Dhankaaka afo'o ane'ni fulchexxine'een» hiyya'neen Duuchchi Woddik Gootti.</para>
  <para style="p" vid="MAL 3:13">«Ha'noo kinni, ‹Ate'ni maa hine haasonnene?› hitine'een.<verse eid="MAL 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAL 3:14" />«Ha'noonna hitinee qici ‹Mageno ergata woyifuldabaan; isi hasaaxxa duuchcha assatinna Dada Duuchcha Ajajaak Duuchchi Woddike Gootti edo yaadeke mannishsha he'nee mammaremati maa lephphinnenne? <verse eid="MAL 3:14" /><verse number="15" style="v" sid="MAL 3:15" />Ta'a kinni no'o ifi dukakaara eebbisemeekeeran hinaanne; fuggoxxa assaakiir ti'ni hiyya; Mageno hega uudaakirrinna fula.› »<verse eid="MAL 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAL 3:16" />Ookkone wodda Duuchchi Woddika Gootta sodaataak manni welti haaso'e; Duuchchi Woddik Goottinna laqe caqase; Duuchchi Woddika Gootta sodaatakeeri'a summa isikanna ulfeessakeeri'a isi edo qalliitik maxaafi borreesseme.<verse eid="MAL 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAL 3:17" />«Ani hujannoxxa barra insa'ne anxe karra kandaan» hiyya'neen Dada Duuchcha Ajajaaki Duuchchi Woddik Gootti; anni isoo ergataammake belti'a mararammashsha aninna insa'ne'a mararanno. <verse eid="MAL 3:17" /><verse number="18" style="v" sid="MAL 3:18" />Eettene yannanna langaxxa qulliyye mannixxe'ninna fuggichchi mannixxe oddo'n, Mageno ergatammaake mannixxe'ninna ergatammabaake mannixxe oddo'n hexxeexxa gargarumma uuddinaan.<verse eid="MAL 3:18" /></para>
  <chapter eid="MAL 3" />
  <chapter number="4" style="c" sid="MAL 4" />
  <para style="s1">Duuchchi Woddike Goottixxa Barra</para>
  <para style="p">
    <verse number="1" style="v" sid="MAL 4:1" />«Kunse boosixxe giirashsha ha'yitaaxxi barra dagaan; ifi dukaak duuchchinna fuggoxxa hujaak duuchchi huurake kadaan; itti daggaaxxi barranna insa'nee gubbaan» hiyya'neen Dad Duuchcha Ajajaak Duuchchi Woddik Gootti. «Hiddakanna dame insa'nee gatissabaan. <verse eid="MAL 4:1" /><verse number="2" style="v" sid="MAL 4:2" />Yaane kinni ha'noo summa anka sodaatina'neekeri'aa iitti qullummatixxi arishsho ha'no'aa fuldaan; fayyattinna keela iseki giddo ha'no'aa kaddaan. Ha'noonna dhoobbo giddii'n fuldeemmaxxe jabbeshsha burraaqqinaan. <verse eid="MAL 4:2" /><verse number="3" style="v" sid="MAL 4:3" />Ookkoonnechchi uduma ani hujannoxxa barranna fuggaaleeyye hirbeesitinaan; insa'nenna lekka ha'nooxxi hunda bululoke kandaan» hiyya'neen Dad Duuchcha Ajajaak Duuchchi Woddik Gootti. <verse eid="MAL 4:3" /><verse number="4" style="v" sid="MAL 4:4" />Isira'eelike ardi duuchchi'a aadatenna seerake kaddaashsha Koorebi erganjo anke Muuse'n uwweenneka anka seera qaabbatte.<verse eid="MAL 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAL 4:5" />«Kunse iitti jabaxxinna sodaachchissaaxxi Duuchchi Woddike Goottixxi barra daggebaa edi darree wabeekichcha Eliyaasii'i ha'no'aa ergannon. <verse eid="MAL 4:5" /><verse number="6" style="v" sid="MAL 4:6" />Dagennexxi ookkone boga badinoti ganabe'noshsha isi annuwwiinxa qalbe oosetixxe darre'n, oosetixxa qalbenna anuwwiinxe darre'n wirri assaan.»<verse eid="MAL 4:6" /></para>
  <chapter eid="MAL 4" />
</usx>