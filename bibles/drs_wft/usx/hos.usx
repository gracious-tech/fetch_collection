<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HOS" style="id">- Gedeo Bible</book>
  <para style="h">Hoose'ikaa Raaga</para>
  <para style="toc1">Hoose'ikaa Raaga</para>
  <para style="toc2">Hoose'ikaa Raaga</para>
  <para style="toc3">Hos.</para>
  <para style="mt1">Hoose'ikaa Raaga</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Wabeek Hoose'i Kirsitoosixxe ilensha edo Semaariya torbaane dhibbanna lame tomme mitte wogga diigendebaa edi darre hedheeke wabeekkichon. Isinna yaane yo'oshsha rakkisammaxxe yanna'ni wabeekkichchi Amootsi uduma middi darrexxe Isira'eelixxe mootumma wabeekkumma haaso'een. Hoose'i yo'osha farri assee haaso'eexxi ardi fakkuwwa mageneefachchote'ni higeexxanna Magenoke'ni afeexxa adde xe'insheexxen; Hoose'i tennee ardiinxa addata gopha ege'nishatee addatendebaaxxe manjichchoni welti hexxemmaxxa weli aadha mammaassiinsha assee haaso'aan; are isixxi Goomeri isi'a addatendemmabaashshann Duuchchi Woddiki Goottik ardinna Mageno ifika waaleen; tenne buuto'a murte Isira'eeli'ni daggo'a hexxeen; kaddomalee udumi uduma Duuchchi Woddik Gootti ardakee afe'ek duuchchi woddixxe jaalala caaldammaxxee, Duuchchi Woddik Gootti arda ifika ifibaa hiisse Iso'ni ardi giddo hedheeka mittooma haaronsaan; tinni lumoxxi jaalala konneechchin butti'a hedheeke hiyyichchinn kulendeen; «Tee Isira'eel! Hitta atee hunanno? Hitta atee sa'ise uwwanno? Ati'a afe'ennexxi jaalala jabaxxe kaddeemmaxxee; tenne duuchcha assonnaa qalbe anxi eetabaan!»</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Hoose'ika mini hadi adde afebaake kadeeka Duuchchi Woddeke Gootike ardike fakeena kadeexxa <char style="ior"><ref loc="HOS 1:1-3:5">1:1—3:5</ref> </char></para>
  <para style="io1">Duuchchi Woddik Gootti Isira'eelii Yihudaana akeekisano daabbateexxa <char style="ior"><ref loc="HOS 4:1-5:15">4:1—5:15</ref> </char></para>
  <para style="io1">Ardi Duuchchi Woddike Goottibaa higeeshsha fakkesseexxa <char style="ior"><ref loc="HOS 6:1-7:10">6:1—7:10</ref> </char></para>
  <para style="io1">Isira'eelik ardi Duuchchi Woddike Gootta'ni adde assedha gopha <char style="ior"><ref loc="HOS 7:11-8:14">7:11—8:14</ref> </char></para>
  <para style="io1">Isira'eelik ardi hasisaaka xixichcho adhaaxxa <char style="ior"><ref loc="HOS 9:1-16">9:1-16</ref> </char></para>
  <para style="io1">Isira'eelike ardi'a uwwemeeka xixichcho <char style="ior"><ref loc="HOS 10:1-15">10:1-15</ref> </char></para>
  <para style="io1">Duuchchi Woddiki Gootti ardakee afeexxa jaalala <char style="ior"><ref loc="HOS 11:1-11">11:1-11</ref> </char></para>
  <para style="io1">Duuchchi Woddik Gootti ardakenaa'n sa'iseexxa murte <char style="ior"><ref loc="HOS 11:12-13:16">11:12—13:16</ref> </char></para>
  <para style="io1">Cubbitixxa gattowaalinna eebbatee addachchiisa <char style="ior"><ref loc="HOS 14:1-9">14:1-9</ref></char></para>
  <chapter number="1" style="c" sid="HOS 1" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1" />Yihudak moyanjuwwi Ooziyaani, Iyyo'ataami, Akaazinna Hiziqiyaasi galchineemmake baro'n ittanni Isira'eeliki moyanji Iyyo'aasiki belti Iyyorbi'aami moyemmake baro'ni Bi'eerike belto Hooshe'ibaa dageek Duuchchi Woddike Goottik hiyyichchi konneechchinni butti'a hedheen.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 14:23-15:7">2 Moy. 14:23—15:7</ref>; <ref loc="2KI 15:32-16:20">15:32—16:20</ref>; <ref loc="2KI 18:1-20:21">18:1—20:21</ref>; <ref loc="2CH 26:1-27:8">2 Odo. 26:1—27:8</ref>; <ref loc="2CH 28:1-32:33">28:1—32:33</ref>. </char></note><verse eid="HOS 1:1" /></para>
  <para style="s1">Hoose'ixxa Arenna Oose</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2" />Duuchchi Woddiki Gootti Hoose'i'ni haaso'a safee wodda, Duuchchi Woddiki Gootti iso'n hiyyee qici, «Ardi anena'ni gargarti higeexxi yabaabule huje ifixxe assedhemmaxxe mertetexxi yabaabulto manjichchonna yabaabullet ilendeexxa oose adhdhi» hiyye. <verse eid="HOS 1:2" /><verse number="3" style="v" sid="HOS 1:3" />Tennexxee Hoose'i Dibilayimixxa belto Goomeri aadhe; isenna sila'wite labbaka belto isi'a ilde.<verse eid="HOS 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 1:4" />Ookkoneechchi uduma Duuchchi Woddiki Goottinna Hoose'i hiyyee qici, «Iyyizira'eeli giddo manjo shiyemmaxxe Iyyuxxa horte shiqoxxe yanna'ni xixaannaxxeenna Isira'eelixxa mootumma ibbamaxxee summa isika Iyyizira'eeli hite fulchi. <verse eid="HOS 1:4" /><verse number="5" style="v" sid="HOS 1:5" />Ettene barra Iyyizira'eelixxe dhooqa'n ani Isira'eelixxa gabe enqannon» hiyye.<verse eid="HOS 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6" />Goomeri higgeenni sila'wite dubarra ilde; Duuchchi Woddiki Goottinna Hoose'i hiyyee qici, «Ta'anni edi'a insa'ne'a marara gophaannaxxee yookin cubbo insa'nexxa gattowwaal hiyya gophaannaxxee beltotika summa Loruhaama<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">Loruhaama hiyyo gattowaali hiyyemabaka arda hiyyoteni. </char></note> hite fulchi. <verse eid="HOS 1:6" /><verse number="7" style="v" sid="HOS 1:7" />Yaane kinn ani Yihudake ardi'a mararannon; ani insa'ne'e anjirannok gabeti, yookini wolaantichchik, yookin bagedik, yookini fadhadikinna fadhado gulufammake manninite kaddebaang Duuchchi Woddiki Gootta Mageno insa'nekenten.»<verse eid="HOS 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8" />Goomeri, Loruhaama ununa waaldechchi uduma higgeeni sila'witeexxi labbaka belto ilde. <verse eid="HOS 1:8" /><verse number="9" style="v" sid="HOS 1:9" />Okkonechi uduma Duuchchi Woddiki Goottina Hoose'i hiyyee qici, «Ha'noo anke arda kada gophphineemmaxxee, aninna ha'noke Mageno kadagophenenaxxe beltiinka summa Lo'aami<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fqa" closed="false">Lo Ami </char><char style="ft" closed="false">Lo'aamite hiyyo anke arda kadebake hiyote</char></note> hite fulchi.<verse eid="HOS 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 1:10" />«Kaddomalee Isira'eelito laakkossi dandeesisabaake abbaayyatike maanchishsha kaddaan, ‹Ha'no anke ardabaani,› hiyyememmaxxe bakka'ni hedhaake, ‹Magenixxe oose hiyyeme ye'emaan.› <verse eid="HOS 1:10" /><verse number="11" style="v" sid="HOS 1:11" />Yihudaki ardinna Isira'eeliki ardi higgeeni mitteke kandaan; mitte akeekisanjonna ifi'a baalonsenaa'n; Iyyizira'eelixxi<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">Iyyizira'eelite hiyyo Ibiratike Magen rokaan hiyyote kadda wodda tinninna durmatanna qabeena leelishaan. </char></note> barra lumoxxe kaddeemmaxxee insa'nenna bogake'n bukkinaan.<verse eid="HOS 1:11" /></para>
  <chapter eid="HOS 1" />
  <chapter number="2" style="c" sid="HOS 2" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 2:1" />«Dayyuwwa ha'nooka Isira'eelito ‹Amii<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fqa" closed="false">Amii </char><char style="ft" closed="false">Anke arda hiyyate.</char></note>› dayyuwwa ha'nooxxanna ‹Ruhama<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fqa" closed="false">Ruhama</char><char style="ft" closed="false">Eeyemeke hiyyate.</char></note>› hitine ye'we.<verse eid="HOS 2:1" /></para>
  <para style="s1">Isra'eelika Xixemanna Higa</para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 2:2" />«Ha'nooxxa ama xixe, isee xixe;</para>
  <para style="q2" vid="HOS 2:2">ise anxe are kada gophpheemmaxxee,</para>
  <para style="q2" vid="HOS 2:2">aninna iseke aro'obaan;</para>
  <para style="q1" vid="HOS 2:2">Alba ifikenaa'n yabaabulatixxa uushsho</para>
  <para style="q2" vid="HOS 2:2">qoma ifixxenaa'n yaababulle fugussitowwaal.<verse eid="HOS 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 2:3" />Iitta kada gophphoole kiphennexxi duwwi gatisannon;</para>
  <para style="q2" vid="HOS 2:3">ilendema barishsha mulqe saalibelo isee gatisannon;</para>
  <para style="q1" vid="HOS 2:3">Qiilla gammoojjeshsha,</para>
  <para style="q2" vid="HOS 2:3">bago boga ise assannon,</para>
  <para style="q2" vid="HOS 2:3">wode'iinxe dheebonni isee shiyannon.<verse eid="HOS 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 2:4" />Yabaabulto manjoxxe oose kaddemmaxxee</para>
  <para style="q2" vid="HOS 2:4">oose isexxee mararabe'no.<verse eid="HOS 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 2:5" />Ama insa'nexxi yabaabultoten; salphinnikinna insa'nee siila'witeen;</para>
  <para style="q1" vid="HOS 2:5">Isenna hitee qici, ‹Itannochchonna ha'wannochcho ani'a uunaan;</para>
  <para style="q2" vid="HOS 2:5">fuutiinxanna layinotixxa seemma,</para>
  <para style="q2" vid="HOS 2:5">zayitenna ha'wannochcho ani'a uunaan;</para>
  <para style="q1" vid="HOS 2:5">Tennexxee welt hosenneke labbalixxa duuka me'annon› hite.<verse eid="HOS 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 2:6" />Tennexxee ora iseka uteti duuchchannon;</para>
  <para style="q2" vid="HOS 2:6">fuldaaka ora gophphaashsha kinjiinka dalla'a ise'n ijaarannon.<verse eid="HOS 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 2:7" />Ise welti hosammake labballo hordoffe me'itaan;</para>
  <para style="q2" vid="HOS 2:7">yaane kinn insa'nee dhaqqabbabaa;</para>
  <para style="q2" vid="HOS 2:7">hassaani kaddomalee insa'ne affabaa.</para>
  <para style="q1" vid="HOS 2:7">Okkoneechchi uduma isenna hitaa qici,</para>
  <para style="q2" vid="HOS 2:7">‹Ani anke edike aro'ibaa higannon;</para>
  <para style="q2" vid="HOS 2:7">ta'i manni'n ani'a edo woyya› hitaan.<verse eid="HOS 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 2:8" />Midha, zayitenna woyinetika bulubulo ise'a uwweennak,</para>
  <para style="q2" vid="HOS 2:8">Ba'aalixxe mageneefachcho'n hosisseexxa</para>
  <para style="q1" vid="HOS 2:8">Worqenna birreti sibiljo ise'a birasa'isse uwweennak</para>
  <para style="q2" vid="HOS 2:8">ante kadeennexxa egendemmaba'a.<verse eid="HOS 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 2:9" />«Tennexxee midha anxa midha aaggammaxxe yanna'n,</para>
  <para style="q2" vid="HOS 2:9">anka woyinetika bulbulonna bulbuli fulammaxxa yanna'n adhdhannon.</para>
  <para style="q1" vid="HOS 2:9">Saala ifika buqexxabaashsha;</para>
  <para style="q2" vid="HOS 2:9">fuutiinxanna layionotixxa seemma isenaa'n wirrasse adhdhannon.<verse eid="HOS 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 2:10" />Ta'anna welti hossammake labballi edo</para>
  <para style="q2" vid="HOS 2:10">saali belo isee gatisannon;</para>
  <para style="q2" vid="HOS 2:10">anga anxenaa'n isee gatisaak mittikinna hedhebaa.<verse eid="HOS 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 2:11" />Gammaddammaka iseka ayyaanuwwa duuchcha:</para>
  <para style="q2" vid="HOS 2:11">woggatika iseka ayyaanuwanna haarooxxi baate fulatika iseka ayyaanuwwa,</para>
  <para style="q2" vid="HOS 2:11">iseka edika sanbatuwwanna iseka muremeeka ayyaanuwwa duuchcha gatisannon.<verse eid="HOS 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 2:12" />Welti hosannake labbalinaa'n adhdhenneke hita'neeka</para>
  <para style="q2" vid="HOS 2:12">woyinetika iseka hiddichuwwanna iseka balasetika haqichchuwwa</para>
  <para style="q1" vid="HOS 2:12">Urmake assannonni;</para>
  <para style="q2" vid="HOS 2:12">biniinchuwwikinna itaan.<verse eid="HOS 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 2:13" />Ba'aali hiyyendaxxe fakke'a hixaana gunbemmaxxe barruwaxxe;</para>
  <para style="q2" vid="HOS 2:13">mura isee woxisannon;</para>
  <para style="q2" vid="HOS 2:13">isenna seesuwwikinna qubuwwati ifi sefateen;</para>
  <para style="q1" vid="HOS 2:13">Isenna welti hosammake labbalixxa duuka me'itee»</para>
  <para style="q2" vid="HOS 2:13">hiyya'neen Duuchchi Woddik Gootti.<verse eid="HOS 2:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 2:14" />«Tennexxee ani isee maxxirsannon;</para>
  <para style="q2" vid="HOS 2:14">qiilla gammoojjeba'anna isee idaganon;</para>
  <para style="q2" vid="HOS 2:14">Jaalalatinna ise'n haaso'anno.<verse eid="HOS 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 2:15" />Okkoonna iseka woyinetika hiddichcho ise'a hiissannon;</para>
  <para style="q2" vid="HOS 2:15">Akoorixxaa dhooqanna<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">Akoorxe dhooqa hiyyo rakotixxe dhooqa hiyyoten. </char></note> ise'a adddachchiisatixxe hula kaddaashsha assannon;</para>
  <para style="q1" vid="HOS 2:15">Okkoonna Gibtsee'n fuldemmaxxe barrashsha,</para>
  <para style="q2" vid="HOS 2:15">oosummati woddishshanni faarsitaan.<verse eid="HOS 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="HOS 2:16" />«Eettene barra, ‹Anke aro'oo› hitee hexxatto» malee'e,</para>
  <para style="q2" vid="HOS 2:16">Ta'anni edi'a, Ba'aali «Anke gootta» hite anee yexxabexxon. Hiyya'neen Duuchchi Woddik Gootti.<verse eid="HOS 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 2:17" />Aninna Ba'aalixxe fakkeka summa afoo isekenaa'n balleessannon;</para>
  <para style="q2" vid="HOS 2:17">ta'in edi'a summi insa'nek ganemaba'a.<verse eid="HOS 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 2:18" />Ettene barra ha'nooke bogi duuchchike biniinchuwi'a ci'uwwatee,</para>
  <para style="q2" vid="HOS 2:18">bogake'n lubbo affeexxe daduwwa'a</para>
  <para style="q2" vid="HOS 2:18">Kako insa'nea aagannon;</para>
  <para style="q1" vid="HOS 2:18">Kunniichchiwwi duuchchi nage'ik hedhaashsha</para>
  <para style="q2" vid="HOS 2:18">gabe, wolaantichchakanna bagedo</para>
  <para style="q2" vid="HOS 2:18">bogakenaa'n fuggussannon.<verse eid="HOS 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 2:19" />Ati anxe kaddattoshsha duuchchi woddi'a anxe are assedheenneni;</para>
  <para style="q2" vid="HOS 2:19">qullummatinna dhugaati,</para>
  <para style="q2" vid="HOS 2:19">jaalalatinna mararteti are anxe assedhannoni.<verse eid="HOS 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="HOS 2:20" />Aninna addatenshati are anxe assedhanoni;</para>
  <para style="q2" vid="HOS 2:20">atinna Duuchchi Woddika Gootta egendatton.<verse eid="HOS 2:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="HOS 2:21" />«Ettene barra ani hiissichcho uwwannon»</para>
  <para style="q2" vid="HOS 2:21">hiyya'neen Duuchchi Woddik Gootti.</para>
  <para style="q1" vid="HOS 2:21">«Iimuwwatenna hiissichcho uwwanon;</para>
  <para style="q2" vid="HOS 2:21">iimuwwatinna buttatee hiissichcho uutaan,<verse eid="HOS 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="HOS 2:22" />Bogikinna midhatee,</para>
  <para style="q2" vid="HOS 2:22">reefike woyinetike bulbuli'ana zayyitete hiissiicho uuwaan;</para>
  <para style="q2" vid="HOS 2:22">bogikinna Iyyizira'eeli'a hiissiicho uwwani.<verse eid="HOS 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="HOS 2:23" />Ani ifi'anni hiyye bogake'n isee kaasannon;</para>
  <para style="q2" vid="HOS 2:23">‹Eeyyemeebaake› hiyyee ye'ennakaara;</para>
  <para style="q2" vid="HOS 2:23">eeyyemeeke hiyye ye'annon;</para>
  <para style="q1" vid="HOS 2:23">‹Ha'noo anke ardabaan› hiyyeme ye'ememmakaara,</para>
  <para style="q2" vid="HOS 2:23">‹anke arda› hiyyannon;</para>
  <para style="q2" vid="HOS 2:23">Insa'nenna, ‹Ati Mageno anken› hinaan.»<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="ROM 9:25">Rom. 9:25</ref>; <ref loc="1PE 2:10">1 Phex. 2:10</ref>. </char></note><verse eid="HOS 2:23" /></para>
  <chapter eid="HOS 2" />
  <chapter number="3" style="c" sid="HOS 3" />
  <para style="s1">Hoose'i Are Ifixxinni Welti Araaremeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1" />Duuchchi Woddik Gootti ane'ni hiyyee qici «Ise wele manjo'n eeyyenda'neexxe yabaabulto kaddoolenna ta'anna martetexxi are atixxa eeyyi; insa'ne wele magenuwwibaanna hingooleenna foyyendeexxa zabiibetixxa kebbo eenolenna Duuchchi Woddiki Gootti Isira'eelito eeyyemmashshanni atinna isse eeyyi» hiyye.<verse eid="HOS 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2" />Tennexxee tommenna onde birretika sibiljonna mitte dhibbanna onde tomme kiilo so'inni ise'e hirenne. <verse eid="HOS 3:2" /><verse number="3" style="v" sid="HOS 3:3" />Okkoneechchi uduma ani isee, «Aninni welti heddo barra ofo'li, yabaabuldoxxee yookin wele manjinn hossoxxee; aninna atinni welti hedhannon» hiyye kulenne.<verse eid="HOS 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 3:4" />Isira'eelito qeerraake bari'a moyanji belonna akeekisanji belo, tolchi belonna mageneefachchotixxe sooddo belo, eefude belonna mageneefantammaxxe fakke belo he'naan.<verse eid="HOS 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HOS 3:5" />Okkoneechchi uduma Isira'eelito heggeexxi Duuchchi Woddike Gootta insa'neka Magenonna moyanjo insa'neka Daawwiti harsitaan; insa'nenna udumike baro'ninna sodaante culphisa'n Duuchchi Woddike Goottibaa eebba isixxibaa dangaan.<verse eid="HOS 3:5" /></para>
  <chapter eid="HOS 3" />
  <chapter number="4" style="c" sid="HOS 4" />
  <para style="s1">Isra'eeli ku'lendeexxxa Ku'la</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 4:1" />Bogake'n hexxina'neeke ha'noo</para>
  <para style="q2" vid="HOS 4:1">Duuchchi Woddik Gootti ku'la'nexxi ku'la hexxemmaxxee,</para>
  <para style="q2" vid="HOS 4:1">ha'noo Isira'eelito konne Duuchchi Woddike Goottika hiyyichcho laqqe:</para>
  <para style="q1" vid="HOS 4:1">«Addatensha hexxebaan; jaalalanna hexxebaan,</para>
  <para style="q2" vid="HOS 4:1">bogi giddo Mageno ege'na hexxebaan.<verse eid="HOS 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 4:2" />Okkkoo hedheek badinotik, dhara haaso'a, manjo shiya;</para>
  <para style="q2" vid="HOS 4:2">moorakenna yabaabulle callan;</para>
  <para style="q1" vid="HOS 4:2">Insa'nenna aangemmaxxa kako diingaan;</para>
  <para style="q2" vid="HOS 4:2">ookkoo munde dunanna manjo shiya bira saxxeen.<verse eid="HOS 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 4:3" />Tennexxe bogi oodhe;</para>
  <para style="q2" vid="HOS 4:3">ise giddo hedhaak duuchchi yaadan;</para>
  <para style="q1" vid="HOS 4:3">Biniinchuwwi, ci'uwwa,</para>
  <para style="q2" vid="HOS 4:3">abbaayya giddixxi qulxu'muwwa mudde.<verse eid="HOS 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 4:4" />«Yaane kinn huuni manji moromoqqe;</para>
  <para style="q2" vid="HOS 4:4">ayyinna wele manjo diinoqqe;</para>
  <para style="q1" vid="HOS 4:4">Qeesole ku'linammashsha;</para>
  <para style="q2" vid="HOS 4:4">ardi atik iittanden.<verse eid="HOS 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 4:5" />Ha'noonna hashshanna barra guggufattinaan;</para>
  <para style="q2" vid="HOS 4:5">wabeekkoletinna ha'noonn welti guggufattaan;</para>
  <para style="q1" vid="HOS 4:5">Tennexxe ani ha'nooxxa ama Izira'eelii ama ballessannon.<verse eid="HOS 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 4:6" />Ank ardi ege'na gophatenaa'n kexxeexxa ba'een.</para>
  <para style="b" vid="HOS 4:6" />
  <para style="q1" vid="HOS 4:6">«Ha'noo ege'na tuffatinemmaxxee,</para>
  <para style="q2" vid="HOS 4:6">aninna qeesolete kaddinabaashsha ha'noo tuffatennen;</para>
  <para style="q1" vid="HOS 4:6">Ha'noonna ha'nooke Magenika seera deetinemmaxxee;</para>
  <para style="q2" vid="HOS 4:6">aninna ha'nooxxa oose dedhannon.<verse eid="HOS 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 4:7" />Qeesoletik laakkossi bira sa'emmashshanni</para>
  <para style="q2" vid="HOS 4:7">ane'n hunja'nexxi cubbonna bira saxxeen;</para>
  <para style="q2" vid="HOS 4:7">ani ulfinna insa'neka salphinnake'n jijjiireennen.<verse eid="HOS 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 4:8" />Anke ardixxi cubbo insa'ne'a durummatee kaddee;</para>
  <para style="q2" vid="HOS 4:8">insa'nexxa batto'a yo'oshsha eeneen.<verse eid="HOS 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 4:9" />Qeesoletinna ardakenaa'n gargar higgebaan;</para>
  <para style="q2" vid="HOS 4:9">aninna duuchchiinga me'inji insa'nekishshanni insa'nee xixannon;</para>
  <para style="q2" vid="HOS 4:9">huje insa'nexxishshanni hira insa'ne'a uwwannon.<verse eid="HOS 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="HOS 4:10" />«Insa'nenna indaani yaane kinni goddinabaan;</para>
  <para style="q2" vid="HOS 4:10">yababulaani yaane kinn horrabaan;</para>
  <para style="q1" vid="HOS 4:10">Duuchchi Woddika Gootta waalleexxi</para>
  <para style="q2" vid="HOS 4:10">ifi <verse eid="HOS 4:10" /><verse number="11" style="v" sid="HOS 4:11" />yabaabulete'e,</para>
  <para style="q1" vid="HOS 4:11">Bagokenna reefike woyintike bulbuli'a ifi sa'isine uune;</para>
  <para style="q2" vid="HOS 4:11">konnechuwwa'ninna <verse eid="HOS 4:11" /><verse number="12" style="v" sid="HOS 4:12" />anke ardanaa'ni qalbeeffachcho a'lendexxee,</para>
  <para style="q2" vid="HOS 4:12">haqichchiki giissineexxa fakke gorsa laqe'naani;</para>
  <para style="q1" vid="HOS 4:12">Sibijiinxa siqqo insa'nexxanna insa'ne'a hiissita'neechcho uutaan;</para>
  <para style="q2" vid="HOS 4:12">yabaabulletik hafuuri insa'nee dedhise'na</para>
  <para style="q2" vid="HOS 4:12">Mageno insa'neke'n addatemmebaan.<verse eid="HOS 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 4:13" />Okkoneechchi uduma insa'ne koobuwwatixxe xungo'ni tolcha tolchinaan;</para>
  <para style="q2" vid="HOS 4:13">eloka gaaddisa afe'ke baaluxi hinaake haqichcho'n,</para>
  <para style="q1" vid="HOS 4:13">Kommebolina Ahooma hinaake haqichchi hunda,</para>
  <para style="q2" vid="HOS 4:13">Tullichchuwwake'n ciincatika tolcha shiqinsaan.</para>
  <para style="q1" vid="HOS 4:13">Tennexxee ha'nook dubarruwwi yabaabulaan,</para>
  <para style="q2" vid="HOS 4:13">ha'nooke beltuwwixxi arenna yabaabuldaan.<verse eid="HOS 4:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 4:14" />«Labballi yaababuldammaxxe melaallenni welti qili'misemmaxxeenna</para>
  <para style="q2" vid="HOS 4:14">fakkuwwa mageneefantamake minixxe yabaabulto melaallenn welti tolcha tolchineemmaxxee ha'nooki dubarruwwi</para>
  <para style="q1" vid="HOS 4:14">Yabaabulaake kadaa wodda,</para>
  <para style="q2" vid="HOS 4:14">ha'nooke beltuwwixxi aruwwa yabaabulda wodda:</para>
  <para style="q1" vid="HOS 4:14">Insa'ne xixabe'non.</para>
  <para style="q2" vid="HOS 4:14">Qaabbatabaak ardi ba'nete'n me'aan!<verse eid="HOS 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HOS 4:15" />«Tee Isira'eel ati yaababuldottolenna</para>
  <para style="q2" vid="HOS 4:15">Yihuda ballesanjummati qoremoqqe.</para>
  <para style="b" vid="HOS 4:15" />
  <para style="q1" vid="HOS 4:15">«Ha'noona Geligeeli'anna martinoqqe.</para>
  <para style="q2" vid="HOS 4:15">Beeti awweeni'anna fuldinoqqe, ‹hedhaake Duuchchi Woddike Gootixxa!› hitine kakatinoqqe.<verse eid="HOS 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 4:16" />Isira'eelik ard jallichchi jibichchishsha</para>
  <para style="q2" vid="HOS 4:16">halocallikeeran;</para>
  <para style="q1" vid="HOS 4:16">Eega, Duuchchi Woddik Gootti insa'nee</para>
  <para style="q2" vid="HOS 4:16">diidi giddo hedheeke gedhebinke buruusishsha;</para>
  <para style="q2" vid="HOS 4:16">hitta bobbaasata?<verse eid="HOS 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 4:17" />Efireem fakkuwwati welti guddeen;</para>
  <para style="q2" vid="HOS 4:17">amme iso waalle;<verse eid="HOS 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 4:18" />Ha'wi mudeexxe yanna'ni midde,</para>
  <para style="q2" vid="HOS 4:18">yaabubullemma insaa'nexxa waallebaan;</para>
  <para style="q2" vid="HOS 4:18">insa'neki galchalluwwinna shookisaaxxa yaane yo'oshsha eenaan.<verse eid="HOS 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 4:19" />Hobonbaltetinna insa'nee filte adhdhite me'itaan;</para>
  <para style="q2" vid="HOS 4:19">Tolchi insa'nekinna shooko insa'ne'ni geessisaan.<verse eid="HOS 4:19" /></para>
  <chapter eid="HOS 4" />
  <chapter number="5" style="c" sid="HOS 5" />
  <para style="s1">Isira'eeli'ni Mureendaaxxa Murte</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 5:1" />«Ha'noo qeesole: tennee laqqe!</para>
  <para style="q2" vid="HOS 5:1">Ha'noo Isira'eelik arda qaabbatte!</para>
  <para style="q1" vid="HOS 5:1">Koo moyanjiinke mini hado laqqe!</para>
  <para style="q2" vid="HOS 5:1">Tinni murte ha'noo'ni murendeen:</para>
  <para style="q1" vid="HOS 5:1">Ha'noonna Mitsiphaa'ni fonxoro:</para>
  <para style="q2" vid="HOS 5:1">Taaboori'ninna farri assineexxe marabe kaddineen.<verse eid="HOS 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 5:2" />Fuggaleeyye lubbo balleessate'n jaba qicin kexxeen:</para>
  <para style="q2" vid="HOS 5:2">ani insa'nee duuchchiinga xixannon.<verse eid="HOS 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 5:3" />Ani Efireemixxee duuchchiinxa ege'neennen:</para>
  <para style="q2" vid="HOS 5:3">Isira'eelinna ani edii'n sho'ondexxebaan;</para>
  <para style="q1" vid="HOS 5:3">Efireem, ta'a ati yabaabuldeetten:</para>
  <para style="q2" vid="HOS 5:3">Isira'eelinna battootteen.<verse eid="HOS 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 5:4" />«Insa'ne hunjeexxi huje: Mageni insa'nekibaa hingaashsha</para>
  <para style="q2" vid="HOS 5:4">eetii insa'ne'a uwwabaan;</para>
  <para style="q1" vid="HOS 5:4">Yabaabulletik hafuuri qalbe insa'nexxe'ni hedheen:</para>
  <para style="q2" vid="HOS 5:4">insa'nenna Duuchchi Woddika Gootta egennebaan.<verse eid="HOS 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 5:5" />Isra'eelike ardixxi holla cubbo insa'nexxa leelishshe:</para>
  <para style="q2" vid="HOS 5:5">Isira'eelitonna Efireemi; ifixxe cubbonini guggufantaan:</para>
  <para style="q2" vid="HOS 5:5">Yihudanna kinn insa'nenni weltin guggufataan.<verse eid="HOS 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 5:6" />Duuchchi Woddika Gootta harisate:</para>
  <para style="q2" vid="HOS 5:6">gedhebinkanna re'etika ittani ifika lalo olfinee me'inaa wodda:</para>
  <para style="q1" vid="HOS 5:6">Isi insa'nenaa'n gargarti higemaaxxee:</para>
  <para style="q2" vid="HOS 5:6">isoo afa dandeennabaan.<verse eid="HOS 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 5:7" />Insa'nenna Duuchchi Woddike Gootti'a addatemmebaan:</para>
  <para style="q2" vid="HOS 5:7">insa'ne baanuwwa i'linemmaxxee:</para>
  <para style="q1" vid="HOS 5:7">Tennexxee haaroxxe baate fulatika ayyaana ulfeessa</para>
  <para style="q2" vid="HOS 5:7">insa'neenna fichcha insa'neka balleessaan.<verse eid="HOS 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 5:8" />Gibi'a giddo malagata,</para>
  <para style="q2" vid="HOS 5:8">Raamana xurunba ufuufee:</para>
  <para style="q1" vid="HOS 5:8">Beeti Awweeni xexxe'achchisatika haafuura laqisse:</para>
  <para style="q2" vid="HOS 5:8">‹Koo Biniyaami: ate'ni dange› hiyye.<verse eid="HOS 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 5:9" />Xixichchiinxe barra'ni;</para>
  <para style="q2" vid="HOS 5:9">Efireemiki bogi urme gataan:</para>
  <para style="q1" vid="HOS 5:9">Isira'eelixxe gosa gosa giddo:</para>
  <para style="q2" vid="HOS 5:9">dhugaandinni kaddaaxxa aninni lallabannon.<verse eid="HOS 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 5:10" />Yihudiinxxi akeekisanjo</para>
  <para style="q2" vid="HOS 5:10">kakkichiinka kinjo goshammake mannishshaten:</para>
  <para style="q1" vid="HOS 5:10">Lola'iinsha,</para>
  <para style="q2" vid="HOS 5:10">mufe anxa insa'ne'ni hana dunannon.<verse eid="HOS 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 5:11" />Fakkuwwa hordofa eeyyemmaxxee</para>
  <para style="q2" vid="HOS 5:11">Efireemi miicemeen;</para>
  <para style="q2" vid="HOS 5:11">dhugaatixxe murtenna miidhemeeka kada.<verse eid="HOS 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 5:12" />Ani Efireemi'a biletishsha;</para>
  <para style="q2" vid="HOS 5:12">Yihudiinke ardi'anna daamulake kadennen.<verse eid="HOS 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 5:13" />Efireemi elagonphe ifixxa:</para>
  <para style="q2" vid="HOS 5:13">Yihudanna mada ifixxa uude wodda:</para>
  <para style="q1" vid="HOS 5:13">Efireemi Asoori'a me'e;</para>
  <para style="q2" vid="HOS 5:13">garigarsa laqedhate lumoke moyanjibaa manjo ergedhe:</para>
  <para style="q1" vid="HOS 5:13">Isi kinn ha'noo anjiro'anna</para>
  <para style="q2" vid="HOS 5:13">mada ha'nooxxa fayyiso'a dande'abaani.<verse eid="HOS 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 5:14" />Ani Efireemi'a neenqiinshsha</para>
  <para style="q2" vid="HOS 5:14">Yihudaanna oosichchi neenqishsha kadanaxxee,</para>
  <para style="q1" vid="HOS 5:14">Insa'ne enqe butuchche me'annoni:</para>
  <para style="q2" vid="HOS 5:14">insa'ne bute adhdhannoni: ayyinna insa'ne anjira dande'abaan.<verse eid="HOS 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 5:15" />Insa'nenna balleessinenn hina qioco'n,</para>
  <para style="q2" vid="HOS 5:15">anke boonchibaa ille iima higaannon;</para>
  <para style="q2" vid="HOS 5:15">insa'nenna anee harsinaan:</para>
  <para style="q1" vid="HOS 5:15">Rakko insa'nexxee'ninna jabeessineexxi</para>
  <para style="q2" vid="HOS 5:15">ane'e harsinaan» hiyye.<verse eid="HOS 5:15" /></para>
  <chapter eid="HOS 5" />
  <chapter number="6" style="c" sid="HOS 6" />
  <para style="s1">Isra'eelixxa Aadde Aaga Gopha</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 6:1" />«Amme, Duuchchi Woddike Goottibaa hingo;</para>
  <para style="q1" vid="HOS 6:1">Isi no'o enqe butuchcheen</para>
  <para style="q2" vid="HOS 6:1">yaane kinni isinni no'o xaasani;</para>
  <para style="q1" vid="HOS 6:1">Isi no'o madeeseeni</para>
  <para style="q2" vid="HOS 6:1">yaane kinni isinni no'o fayyisaan.<verse eid="HOS 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 6:2" />Lame barra uduma no'o lubbo no'oxxa ukaan</para>
  <para style="q2" vid="HOS 6:2">isi edo he'nannoshsha:</para>
  <para style="q2" vid="HOS 6:2">sakka barro no'o ke'issaan.<verse eid="HOS 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 6:3" />Duuchchi Woddika Gootta egenno;</para>
  <para style="q2" vid="HOS 6:3">adda egennannoshsha jabaanto</para>
  <para style="q1" vid="HOS 6:3">Soodimarike ifishsha</para>
  <para style="q2" vid="HOS 6:3">dhugaandinni leelani</para>
  <para style="q1" vid="HOS 6:3">Boga lashshi assamake mayetike xeenishsha;</para>
  <para style="q2" vid="HOS 6:3">haarsike xeenishshanna no'obaa dagaani» hine.<verse eid="HOS 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 6:4" />«Koo Efireemi; ate maa assano?</para>
  <para style="q2" vid="HOS 6:4">Koo Yihuda atee maa assano?</para>
  <para style="q1" vid="HOS 6:4">Jaalala ha'nooxxi ba'ammaxxe gorsixxe hurreshshanna</para>
  <para style="q2" vid="HOS 6:4">gorsike fixeensishshaten.<verse eid="HOS 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 6:5" />Tennexxee anxe wabeeko ha'noo kochchiseennen,</para>
  <para style="q2" vid="HOS 6:5">aninge afo'ike hiyyichchinni ha'noo shiyenneni:</para>
  <para style="q2" vid="HOS 6:5">murte anxinna banqotishsha ha'noo'ni balaqe;<verse eid="HOS 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 6:6" />Ani tolchi irra mararte</para>
  <para style="q2" vid="HOS 6:6">ciincatike tolchi irra:</para>
  <para style="q2" vid="HOS 6:6">Mageno ege'nate fi'lannon.<note caller="-" style="x"><char style="xo" closed="false">6:6 </char><char style="xt" closed="false"><ref loc="MAT 9:13">Mat. 9:13</ref>; <ref loc="MAT 12:7">12:7</ref>. </char></note><verse eid="HOS 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 6:7" />Insa'nenna Addaamishsha kako diingeen:</para>
  <para style="q2" vid="HOS 6:7">okkoo ani'a addatememmabaan.<verse eid="HOS 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 6:8" />Gela'aadi mundeti daafendeexxe</para>
  <para style="q2" vid="HOS 6:8">fuggaleeyyetike mannike qachchani.<verse eid="HOS 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 6:9" />Moodhalshe manjo miidhatee gaaddammashsha:</para>
  <para style="q2" vid="HOS 6:9">qeesoletiki ya'i ittanni assaan;</para>
  <para style="q1" vid="HOS 6:9">Insa'nenna Sekemike ora'ni manjo anga sa'naani</para>
  <para style="q2" vid="HOS 6:9">shookishaxxa yaanenna assina'neen.<verse eid="HOS 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 6:10" />Isira'eelike arda'ni diqachchiissaaxxa yaane uudennen;</para>
  <para style="q2" vid="HOS 6:10">okkoo Efireemi yabaabule;</para>
  <para style="q2" vid="HOS 6:10">Isra'eelikinna batto'e.<verse eid="HOS 6:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 6:11" />«Koo Yihudiinke arda!</para>
  <para style="q2" vid="HOS 6:11">ati'aanna mayetixxi yanna murende'een.</para>
  <para style="q1" vid="HOS 6:11">Aninna anka arda booji'otike boganaa'ni hiissenne wodda.»<verse eid="HOS 6:11" /></para>
  <chapter eid="HOS 6" />
  <chapter number="7" style="c" sid="HOS 7" />
  <para style="q2">
    <verse number="1" style="v" sid="HOS 7:1" />Ani Isira'eelii fayyisanno wodda.</para>
  <para style="q1" vid="HOS 7:1">Efireemixxi cubbo,</para>
  <para style="q2" vid="HOS 7:1">Samaariyaaxxi fuggoxxi hujenna farri hite leellitaan.</para>
  <para style="q1" vid="HOS 7:1">Insa'ne dhara haasonaan;</para>
  <para style="q2" vid="HOS 7:1">moodhalshe minuwwa undee e'yitaani:</para>
  <para style="q2" vid="HOS 7:1">manjo mulqedhammak manni ora ora'nini saamaan.<verse eid="HOS 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 7:2" />Yaane kinn fuggoxxa huje insa'nexxa duuchcha:</para>
  <para style="q2" vid="HOS 7:2">insa'ne qalbeefantabaan;</para>
  <para style="q1" vid="HOS 7:2">Cubbo insa'nexxi insa'ne buqqeen:</para>
  <para style="q2" vid="HOS 7:2">elobaaxxi huje insa'nenna duuchchi wodda ani edo hexxeen.<verse eid="HOS 7:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="HOS 7:3" />«Moyanjo fuggoxxe huje insa'nexxinni,</para>
  <para style="q2" vid="HOS 7:3">akeekisanonna dhari insa'nekinn gammachinsaan.<verse eid="HOS 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 7:4" />Lixe fulde danfitammashsha</para>
  <para style="q2" vid="HOS 7:4">ra'isammak giira ha'ishammaba qico'n</para>
  <para style="q1" vid="HOS 7:4">Boosummate'n ha'iitammaxxe giirashsha</para>
  <para style="q2" vid="HOS 7:4">duuchiingi yabaabulleti bubeeken<verse eid="HOS 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 7:5" />Moyanji no'okixxe ayyaaniinxe barra'ni,</para>
  <para style="q2" vid="HOS 7:5">akeekisano woyinetixxa booka ha'wine machchoonne huffu hine;</para>
  <para style="q2" vid="HOS 7:5">isinna gacifataake manninni welti gudde.<verse eid="HOS 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 7:6" />Insa'nexxi qalbe boosixxe laangoshsha eebbiteexxen:</para>
  <para style="q2" vid="HOS 7:6">insa'ne xaqaroti isibaa shinqaan:</para>
  <para style="q1" vid="HOS 7:6">Hashsha duuchcha aare insa'nexxi gubbaan;</para>
  <para style="q2" vid="HOS 7:6">ha'yitammaxxe giirashsha gorsa tallissan.<verse eid="HOS 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 7:7" />Duuchchingi eebitexxe laangoshshaten:</para>
  <para style="q2" vid="HOS 7:7">insa'ne ifika galchalluwwa birre;</para>
  <para style="q1" vid="HOS 7:7">Moyanjuwwa insa'nekixxa duuchchanna mudde;</para>
  <para style="q2" vid="HOS 7:7">insa'ne giddi'n mittikinna anee ye'edheek hedhebaa.<verse eid="HOS 7:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 7:8" />«Efireemi gosa gosake ardinni welti makeme;</para>
  <para style="q2" vid="HOS 7:8">Efireemi wirri assinebaaxxe kebbonn.<verse eid="HOS 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 7:9" />Alagi hunna isixxa ite;</para>
  <para style="q2" vid="HOS 7:9">isi kinn qalbeefatebaan.</para>
  <para style="q1" vid="HOS 7:9">Umo isikinna arro'e:</para>
  <para style="q2" vid="HOS 7:9">isi kinn tennee qalbefatebaa.<verse eid="HOS 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 7:10" />Isira'eelike ardixxi holla cubbo iffeexxa leelishe;</para>
  <para style="q2" vid="HOS 7:10">tinn duuchcha kadde'naanni kinn:</para>
  <para style="q1" vid="HOS 7:10">Duuchchi Woddike Gootta Mageno insa'nekibaa hingebaani;</para>
  <para style="q2" vid="HOS 7:10">isoonna harsinebaan.<verse eid="HOS 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 7:11" />«Efireemik ardi sholla qicinni sobendammaxxee:</para>
  <para style="q2" vid="HOS 7:11">heduma affebaaxxe guugenjoshaten:</para>
  <para style="q1" vid="HOS 7:11">Insa'nenna mitte yanna Gibtsee yee'naan</para>
  <para style="q2" vid="HOS 7:11">wele yanna kinn Asooribaa wirr hinaan.<verse eid="HOS 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 7:12" />Insa'ne wodda marabe anxa insa'ne'a farri assannon</para>
  <para style="q2" vid="HOS 7:12">ci'uwwatishsha iimi'ni butti'a harkise</para>
  <para style="q1" vid="HOS 7:12">Insa'ne dirrisannon</para>
  <para style="q2" vid="HOS 7:12">fuggoxxe huje insa'nexxeenna insa'nee xixannon.<verse eid="HOS 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 7:13" />Ani edii'ni bayyante me'inemmaxxe insa'ne'a aannee!</para>
  <para style="q2" vid="HOS 7:13">ane'ni fuggoxxinni ke'nemmaxxee</para>
  <para style="q1" vid="HOS 7:13">Ba'ne insa'nen geltowwaal!</para>
  <para style="q2" vid="HOS 7:13">insa'ne ane'ni jallineemmaxxee</para>
  <para style="q1" vid="HOS 7:13">Anjironaa haseennen;</para>
  <para style="q2" vid="HOS 7:13">insa'ne kinn ane'ni dhara haasonna'nen.<verse eid="HOS 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 7:14" />Insa'ne mitte godobinni anibaa raarra'nebaan:</para>
  <para style="q2" vid="HOS 7:14">yaane kinn taqe ifixxe'ni he'ne oo'naan.</para>
  <para style="q1" vid="HOS 7:14">Midhatenna reefike woyinetike bulbuli'a bukki hinaan:</para>
  <para style="q2" vid="HOS 7:14">yaane kinn insa'ne anenaa'n udumi'a hingeen.<verse eid="HOS 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 7:15" />Ani insa'ne; jabeesseennen:</para>
  <para style="q2" vid="HOS 7:15">insa'ne kinn ane'ni fuggoxxinn ke'ne.<verse eid="HOS 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 7:16" />Darbineeba waalde weleba ibbammaxxe gabeshaten;</para>
  <para style="q2" vid="HOS 7:16">La'o affebaaxxe yaanebanna illee iima hinga darbineeba</para>
  <para style="q1" vid="HOS 7:16">Akeekisano insa'nexxi fuggoke haaso'a insa'nekixxee,</para>
  <para style="q2" vid="HOS 7:16">wolaantichake'n rennaan;</para>
  <para style="q1" vid="HOS 7:16">Tenne buutonni insa'nenna Gibtseeke boga'ni;</para>
  <para style="q2" vid="HOS 7:16">osso'lichchiinke kandaan.<verse eid="HOS 7:16" /></para>
  <chapter eid="HOS 7" />
  <chapter number="8" style="c" sid="HOS 8" />
  <para style="s1">Isira'eelii Hobonbalte Haa'mitaan</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 8:1" />«Malagata afooke'ni uggee</para>
  <para style="q2" vid="HOS 8:1">Ardi anki aagemmaxxa kako diigemmaxxee</para>
  <para style="q1" vid="HOS 8:1">Anke seera'inna jallemmaxxee,</para>
  <para style="q2" vid="HOS 8:1">naaphi sinbiriinsha Duuchchi Woddike Goottike mini hana hedheen.<verse eid="HOS 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 8:2" />Isira'eelina, ‹Ee Mageno no'oke no'o atee egeneennen›</para>
  <para style="q2" vid="HOS 8:2">hina'ni anibaa raarraan.<verse eid="HOS 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 8:3" />Yaane kinn Isira'eel eloxxa yaane tuffatte;</para>
  <para style="q2" vid="HOS 8:3">naaphikinna insa'ne'e shorraan.<verse eid="HOS 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 8:4" />Insa'nenna anke seeri belo moyanjuwwa moyisiinsen:</para>
  <para style="q2" vid="HOS 8:4">aneenna lanqebaangi akeekisano ifi'a fi'line:</para>
  <para style="q1" vid="HOS 8:4">Birretike sibilji insa'nekininna worqeti ifixxe ba'ne</para>
  <para style="q2" vid="HOS 8:4">fakkuwwa ifi'ani giise'ne.<verse eid="HOS 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 8:5" />Tee Semaariya, jabbetixxa fakke atixxa fugussi:</para>
  <para style="q2" vid="HOS 8:5">mufe anxinna insa'ne'ni ha'yiteen:</para>
  <para style="q1" vid="HOS 8:5">Insa'nenna haani qici'a ca'a hiyya gonpha?<verse eid="HOS 8:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 8:6" />Tinninna Isira'eeli'ni kadde!</para>
  <para style="q1" vid="HOS 8:6">Anga ifixxenn hujendeexxi tinni jabbe magenuwwakebaan;</para>
  <para style="q1" vid="HOS 8:6">Iiti Samaariyaaxxi jabbe;</para>
  <para style="q2" vid="HOS 8:6">enqende bullootaan.<verse eid="HOS 8:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 8:7" />«Insa'nenna diidallo ronkaan</para>
  <para style="q2" vid="HOS 8:7">hobonbaltetanna haa'minaani</para>
  <para style="q1" vid="HOS 8:7">Dinne rodde ra'isitabaa;</para>
  <para style="q2" vid="HOS 8:7">isenna bulle affebaa;</para>
  <para style="q1" vid="HOS 8:7">Gumma afoolenna</para>
  <para style="q2" vid="HOS 8:7">isee itaaki alagake.<verse eid="HOS 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 8:8" />Isira'eel liqiinsedeeni</para>
  <para style="q2" vid="HOS 8:8">gosa gosake ardi giddonna</para>
  <para style="q2" vid="HOS 8:8">la'o afebaake miyishsha kaddeen.<verse eid="HOS 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 8:9" />Insa'nenna qofitinn hedhammake diidike harrichchishsha</para>
  <para style="q2" vid="HOS 8:9">Asoori'a me'ineen;</para>
  <para style="q2" vid="HOS 8:9">Efireemi jaaluwwake ifi gurgudhite.<verse eid="HOS 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 8:10" />Yaane kinn insa'ne gosa gosatike ardi giddo ifi gurgudhinnolenna;</para>
  <para style="q2" vid="HOS 8:10">ani ta'a insa'nee bukki assannon;</para>
  <para style="q1" vid="HOS 8:10">Insa'nenna jabake moyanjixxe miiccema'ni;</para>
  <para style="q2" vid="HOS 8:10">heeno'mina'ni me'inaan.<verse eid="HOS 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 8:11" />«Efireemi cubbotixxe bidhdhatika heddo tolchimalcho giissedhoolenna;</para>
  <para style="q2" vid="HOS 8:11">kunninna cubbo hujatike tolchimalcho kade.<verse eid="HOS 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 8:12" />Anke seeri giddo hexxeexxa heddo yaanuwwa insa'ne'a borreessennen;</para>
  <para style="q2" vid="HOS 8:12">insa'ne kinn egennebaaxxe yaaneshsha assine.<verse eid="HOS 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 8:13" />Insa'ne ani'a hasisaaka tolcha shiqinsaan;</para>
  <para style="q2" vid="HOS 8:13">maalakanna indaan;</para>
  <para style="q2" vid="HOS 8:13">Duuchchi Woddiki Gootti kinn insa'ne'ni gammadebaan;</para>
  <para style="q1" vid="HOS 8:13">Tennexxee isi fuggo insa'nexxa huje qaabbattaan;</para>
  <para style="q2" vid="HOS 8:13">cubbo insa'nexxenna xixaan;</para>
  <para style="q2" vid="HOS 8:13">insa'nenna Gibtsee'a hingaan.<verse eid="HOS 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 8:14" />Isira'eeliki ardi insa'ne dademanga deene;</para>
  <para style="q2" vid="HOS 8:14">mootetika minuwwanna ijaarre;</para>
  <para style="q2" vid="HOS 8:14">Yihudaka ardinna heddo kinjiinke dalla'ika qachchuwwa ijaare</para>
  <para style="q1" vid="HOS 8:14">Ani kinn qachchuwwa insa'neke'n giira worannon;</para>
  <para style="q2" vid="HOS 8:14">giiratinna kolluwwa insa'nexxanna itta» hiyye.<verse eid="HOS 8:14" /></para>
  <chapter eid="HOS 8" />
  <chapter number="9" style="c" sid="HOS 9" />
  <para style="s1">Isira'eelika Xixichcho</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 9:1" />Tee Isira'eel gammaddoxxee;</para>
  <para style="q2" vid="HOS 9:1">wele gosa gosake mannishsha ilillissoxxee,</para>
  <para style="q1" vid="HOS 9:1">Atinna Mageno atikee addatendebexxon,</para>
  <para style="q2" vid="HOS 9:1">Midha uuxxinammaxxe aldu'muwwa'ni;</para>
  <para style="q2" vid="HOS 9:1">Yabaabulto melaalle'a uunammaka hira eetetten.<verse eid="HOS 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 9:2" />Aldu'me ha'nooxxenaa'n midha woyine miice'nammabaa'n woyinetixxa booka affinaba'a</para>
  <para style="q1" vid="HOS 9:2">Reefik woyintik bulbulinna afinnabaan.<verse eid="HOS 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 9:3" />Insa'nenna Duuchchi Woddike Goottike boga'ni ofollabaan;</para>
  <para style="q2" vid="HOS 9:3">Efireemi Gibtsee'a higaan;</para>
  <para style="q2" vid="HOS 9:3">Isinna Asoori'n battoteexxa ita itaan.<verse eid="HOS 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 9:4" />Woyinetixxe bookaka tolcha Duuchchi Woddike Goottii'a tolchinabaan;</para>
  <para style="q2" vid="HOS 9:4">tolchi insa'nekinna isoo gammachchiisabaan;</para>
  <para style="q1" vid="HOS 9:4">Iitta hedheeki tolchi insa'ne'a yaaddote'ni hedheeke mannixxe waasa insa'ne'a kadaan;</para>
  <para style="q2" vid="HOS 9:4">ettene ita itaaki duuchchi batto'aan.</para>
  <para style="q1" vid="HOS 9:4">Tinni ita umo insa'negixxe kaddaan;</para>
  <para style="q2" vid="HOS 9:4">Duuchchi Woddike Goottike woyyichchi galmibaa e'yitabaan.<verse eid="HOS 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 9:5" />Duuchchi Woddike Goottike ayyaanixxe barra'ni,</para>
  <para style="q2" vid="HOS 9:5">woggatike ayyanuwwa ha'nookixxe barra'ni maa assitina'ne?<verse eid="HOS 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 9:6" />Insa'ne ba'netenaa'ni baqante fulloolenna midde;</para>
  <para style="q2" vid="HOS 9:6">Gibtsee insa'nee bukki assitaan;</para>
  <para style="q2" vid="HOS 9:6">Memifoosinna insa'nee moogaan.</para>
  <para style="q1" vid="HOS 9:6">Insa'neke birretike sibiljuwwixxe karra'ni laaleessi yaa'ane;</para>
  <para style="q2" vid="HOS 9:6">Seemmati giissineeke fooqa insa'neke'n ute buqqaan.<verse eid="HOS 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 9:7" />Xixichiinxi barra daggeen;</para>
  <para style="q2" vid="HOS 9:7">murtetixxi barranna shiqqeen;</para>
  <para style="q2" vid="HOS 9:7">Isira'eelinna tennee egendowwaal!</para>
  <para style="q1" vid="HOS 9:7">Cubbo ha'noxxinna heddattemmaxxee;</para>
  <para style="q2" vid="HOS 9:7">naaphunte ha'nooxxinna jabaxxe kaddemmaxxee</para>
  <para style="q1" vid="HOS 9:7">Wabeekkichchi gowwiinsha;</para>
  <para style="q2" vid="HOS 9:7">Magenokee ergatemmaki manji maraatiinsha uudemeen.<verse eid="HOS 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 9:8" />Iikki wabeek anke Mageninni welti</para>
  <para style="q2" vid="HOS 9:8">Efireemike heqqanjon;</para>
  <para style="q1" vid="HOS 9:8">Yaane kinn ora isike duuchcha'ni fonxoro,</para>
  <para style="q2" vid="HOS 9:8">Isike Magenike mine'ni naaphunte isoo heqqitaan.<verse eid="HOS 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 9:9" />Gibi'ake barishsha</para>
  <para style="q2" vid="HOS 9:9">insa'ne battooneen;</para>
  <para style="q1" vid="HOS 9:9">Mageni fuggo insa'nexxa qaabbataan</para>
  <para style="q2" vid="HOS 9:9">cubbo insa'nexxeenna insa'nee xixaan.<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="JDG 19:1-30">Hay. 19:1-30</ref>. </char></note><verse eid="HOS 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 9:10" />«Ani Isira'eeli alfa;</para>
  <para style="q2" vid="HOS 9:10">woyinetixxa gumma; qiilla gammoojje'n alfennexxe qixxemman;</para>
  <para style="q1" vid="HOS 9:10">Ani edika ha'nooka annuwwa uuda;</para>
  <para style="q2" vid="HOS 9:10">umiinxa balasetixxa gumma uudennexxe qixxemman;</para>
  <para style="q1" vid="HOS 9:10">Insa'ne Bi'eerfegoori'a dange wodda kinni</para>
  <para style="q2" vid="HOS 9:10">ettene shookisa'neexxe fakke'a ifi sa'isine uune;</para>
  <para style="q2" vid="HOS 9:10">insa'nenna ettene eenemmaxxe fakkeshsha battoonne.<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="NUM 25:1-5">Lak. 25:1-5</ref>. </char></note><verse eid="HOS 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 9:11" />Efireemiki ulfinni ci'atishsha phirri hiyye ba'aan;</para>
  <para style="q2" vid="HOS 9:11">ila, siila'wanna qaxxarro hexxebaa.<verse eid="HOS 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 9:12" />Insa'nenna oose nose'noolenna midde</para>
  <para style="q2" vid="HOS 9:12">oose belo gantaashsha insa'nenaa'n adhdhannon;</para>
  <para style="q1" vid="HOS 9:12">Ani insa'ne'n dudduro wirri hiyyannoxxa</para>
  <para style="q2" vid="HOS 9:12">yanna aanee insa'ne'a!<verse eid="HOS 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 9:13" />Efireemi Xiroosishsha</para>
  <para style="q2" vid="HOS 9:13">eloke booncho'n kansee'naa uudeennan;</para>
  <para style="q1" vid="HOS 9:13">Ta'a kinn Efireemi oose ifixxa</para>
  <para style="q2" vid="HOS 9:13">manjo anga sa'ammake manna'n sa'isse uwwaan» hiyye.<verse eid="HOS 9:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 9:14" />Koo Duuchchi Woddike Gootta insa'ne'a uwwi;</para>
  <para style="q2" vid="HOS 9:14">maachcho insa'ne'a uutattota?</para>
  <para style="q1" vid="HOS 9:14">Gufataaka gadamessuwwanna</para>
  <para style="q2" vid="HOS 9:14">bagoka unnunuwwa insa'ne'a uwwi.<verse eid="HOS 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 9:15" />«Insa'ne Geligeelake booncho'n hunjeexxe fuggoxxe huje duuchchanaa'n kexxexxa;</para>
  <para style="q2" vid="HOS 9:15">ani okkoo insa'ne jibbennen;</para>
  <para style="q1" vid="HOS 9:15">Hunjemmaxxe cubboxxe;</para>
  <para style="q2" vid="HOS 9:15">anke minenaa'n insa'ne shorrannon;</para>
  <para style="q1" vid="HOS 9:15">Konneechchinni edi'a insa'ne eeyyabe'non;</para>
  <para style="q2" vid="HOS 9:15">akeekisano insa'nexxi duuchchi jallaameeyyeten.<verse eid="HOS 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 9:16" />Efireemi ganeme;</para>
  <para style="q2" vid="HOS 9:16">hiddi insa'neki bage;</para>
  <para style="q2" vid="HOS 9:16">insa'nenna gumma guminsabaan;</para>
  <para style="q1" vid="HOS 9:16">Oose i'linoolenna midde</para>
  <para style="q2" vid="HOS 9:16">oose insa'nexxa shiyannoni» hiyye.<verse eid="HOS 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 9:17" />Insa'ne ajajema gonpheemmaxxee</para>
  <para style="q2" vid="HOS 9:17">anki Mageni insa'ne waalaan;</para>
  <para style="q2" vid="HOS 9:17">insa'nenna gosa gosake ardi giddo doonsa kiyya hina'ni he'naan.<verse eid="HOS 9:17" /></para>
  <chapter eid="HOS 9" />
  <chapter number="10" style="c" sid="HOS 10" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 10:1" />Isira'eeli ardixxe woyineshsha barqaaqammake mani:</para>
  <para style="q2" vid="HOS 10:1">bira saxxeexxa gummanna gummise:</para>
  <para style="q1" vid="HOS 10:1">Gumma bira saxxeexxe qixxe'ni</para>
  <para style="q2" vid="HOS 10:1">heddo tolchimalchuwwa giissedhe:</para>
  <para style="q1" vid="HOS 10:1">Fichchi insa'neki miseexxe qixxe'ni</para>
  <para style="q2" vid="HOS 10:1">mageneeffachchotixxa soodduwwa danchoosse.<verse eid="HOS 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 10:2" />Qalbe insa'nexxi xaqarotixxe;</para>
  <para style="q2" vid="HOS 10:2">balleessa ifi ifixxe hira alfinaan;</para>
  <para style="q1" vid="HOS 10:2">Duuchchi Woddiki Gootti insa'neka tolchimalchuwwa balleessaan:</para>
  <para style="q2" vid="HOS 10:2">mageneenfantammaxxa soodduwwa insa'nexxa diigaan.<verse eid="HOS 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 10:3" />Insa'nenna,</para>
  <para style="q2" vid="HOS 10:3">Duuchchi Woddika Gootta ulfeessa gonphenaxxe, «No'o moyanjo anfebe'non:</para>
  <para style="q1" vid="HOS 10:3">Moyanjo anfeennelenna</para>
  <para style="q2" vid="HOS 10:3">isi no'o'a maa assa dande'ammata?» hinaan.<verse eid="HOS 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 10:4" />Insa'ne heddo addachiisa uunaan;</para>
  <para style="q2" vid="HOS 10:4">dhariki kakantaan</para>
  <para style="q1" vid="HOS 10:4">Tennexxee anxi murte;</para>
  <para style="q2" vid="HOS 10:4">Tennexxee fichchi giddo lattammaxxe ha'latixxe bada'ashsha murte insa'ne'n bira saxxa.<verse eid="HOS 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 10:5" />Samaariyaa hedheek ardi</para>
  <para style="q2" vid="HOS 10:5">Beeti'awweni hexxeexxa jabbetixxa fakke sodataan;</para>
  <para style="q1" vid="HOS 10:5">Ardikinna isixxee oodhaan;</para>
  <para style="q2" vid="HOS 10:5">ulfinna isike'n yo'osha gammadeek duuchchi,</para>
  <para style="q1" vid="HOS 10:5">Booji'o insa'nenaa'ni adhendeemmaxxee</para>
  <para style="q2" vid="HOS 10:5">yabaabulto qeesole iittanni isi'a ooxxaan.<verse eid="HOS 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 10:6" />Lumoke moyanji'a tenne fakke mattiinsha Asoori'a adhdhendaan</para>
  <para style="q1" vid="HOS 10:6">Efireem salphataan;</para>
  <para style="q2" vid="HOS 10:6">Isira'eelinna mageneefattammaxxe fukkuwwa'ni shookkaan.<verse eid="HOS 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 10:7" />Semaariyanna moyanji iseki,</para>
  <para style="q2" vid="HOS 10:7">wode'i hana hedheeke hombishsha ba'naan.<verse eid="HOS 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 10:8" />Isira'eelike ardixxe cubbo kadeek Awwenik</para>
  <para style="q2" vid="HOS 10:8">mageneefachchotik tullichchi ba'aan:</para>
  <para style="q1" vid="HOS 10:8">Iso'n utenna qu'muudo fuldaan:</para>
  <para style="q2" vid="HOS 10:8">tolchimalchuwwa insa'neka buqqaan:</para>
  <para style="q1" vid="HOS 10:8">Okkone wodda insa'ne koobuwwa «No'o buqqe!»</para>
  <para style="q2" vid="HOS 10:8">tullichchuwwikinna no'o'ni hana ibbe! Hinaan.<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="LUK 23:30">Luq. 23:30</ref>; <ref loc="REV 6:16">Wal. 6:16</ref>. </char></note><verse eid="HOS 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 10:9" />«Tee Isira'eel Gibi'axxe yannanaa'n cubbo hujjineen;</para>
  <para style="q2" vid="HOS 10:9">okkoonna jabaatinee udumi'aanna higginebaan;</para>
  <para style="q1" vid="HOS 10:9">Giba'a hedhemmaki elobaaxxa hujammakiira</para>
  <para style="q2" vid="HOS 10:9">bagedi insa'ne biremmabaata?<verse eid="HOS 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 10:10" />Ani hasennexxe yanna'ni insa'ne'e xixannon;</para>
  <para style="q2" vid="HOS 10:10">lenbe, lenbe cubbo hunjemmaxxee insa'nee xixo'a</para>
  <para style="q2" vid="HOS 10:10">gosa gosak ardi insa'ne'ni bukki hiyyaan.<verse eid="HOS 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 10:11" />Efireemi uuxxa eeyyammake</para>
  <para style="q2" vid="HOS 10:11">leenjisemeke jibbishshaten;</para>
  <para style="q2" vid="HOS 10:11">isike dancha gooba'ni</para>
  <para style="q1" vid="HOS 10:11">Qanbara uggannon;</para>
  <para style="q2" vid="HOS 10:11">Efireemii xamadannoni</para>
  <para style="q2" vid="HOS 10:11">Yihuda qotaan:</para>
  <para style="q2" vid="HOS 10:11">Ya'iqoobinna buttinna shaqqisaan.<verse eid="HOS 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 10:12" />Ha'no ifi'aanni qullumma hujje;</para>
  <para style="q2" vid="HOS 10:12">jabaxxe jaalalaxxa gumma haa'me;</para>
  <para style="q1" vid="HOS 10:12">Hujemebaaka boga hujje</para>
  <para style="q2" vid="HOS 10:12">isi dageexxi</para>
  <para style="q1" vid="HOS 10:12">Qullumma ha'noo'ni xeeniinsha gansiisammaxxee</para>
  <para style="q2" vid="HOS 10:12">Duuchchi Woddika Gootta harse.<note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="JER 4:3">Erm. 4:3</ref>. </char></note><verse eid="HOS 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 10:13" />Ha'noo kinni fuggoxxa rokkineen</para>
  <para style="q2" vid="HOS 10:13">cubbote haa'mitineen</para>
  <para style="q2" vid="HOS 10:13">dhariinxa gummanna ittineen.</para>
  <para style="q1" vid="HOS 10:13">Ifixxe hunna'ninna,</para>
  <para style="q2" vid="HOS 10:13">lolammake ha'nooke mannixxe bira sa'ne'ni addatineen.<verse eid="HOS 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 10:14" />Shelmaani, Beeti'aribeel loliinxe yanna'n diige biremmashshann;</para>
  <para style="q2" vid="HOS 10:14">amuwwatanna oosuwwa insa'nexxininn welti; buttinake'ni rogojemmashanni;</para>
  <para style="q1" vid="HOS 10:14">Waakensha atike arda'ni daggaan</para>
  <para style="q2" vid="HOS 10:14">kolluwwa atixxa duuchchanna diingaan.<verse eid="HOS 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 10:15" />Tennexxee tee Beeteli: fuggoxxi atixxi huje: jabaxxe kaddemmaxxee:</para>
  <para style="q2" vid="HOS 10:15">ate'ninna iittann kaddaan:</para>
  <para style="q1" vid="HOS 10:15">Iitti bara gelta wodda:</para>
  <para style="q2" vid="HOS 10:15">Isira'eelik moyanji ijje ba'aan.»<verse eid="HOS 10:15" /></para>
  <chapter eid="HOS 10" />
  <chapter number="11" style="c" sid="HOS 11" />
  <para style="s1">Mageniinxi Jaalala Isira'eelike Ardi'a</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 11:1" />«Isira'eeli oosummanni reefi oosumma,</para>
  <para style="q2" vid="HOS 11:1">hedhema wodda eeyyennen,</para>
  <para style="q2" vid="HOS 11:1">belto ankanna Gibtsee'n ye'ennen.<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="EXO 4:22">Fula. 4:22</ref>; <ref loc="MAT 2:15">Mat. 2:15</ref>.</char></note><verse eid="HOS 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 11:2" />Anka arda Isira'eelii kinn ani hiisse ye'ennexxe qixxe'ni</para>
  <para style="q2" vid="HOS 11:2">irra caala anenaa'n bayyante:</para>
  <para style="q1" vid="HOS 11:2">Insa'nenna Ba'aali hiyyemaake mageni'a tolcha tolchine:</para>
  <para style="q2" vid="HOS 11:2">fakkuwwateenna hixaana gunbe.<verse eid="HOS 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 11:3" />Ani Efireemixxa anga abide,</para>
  <para style="q2" vid="HOS 11:3">daaddissenneki antemman:</para>
  <para style="q1" vid="HOS 11:3">Yaane kinn insa'nee fayyisennek ante kadennexxa</para>
  <para style="q2" vid="HOS 11:3">insa'ne qalbeefantebaan.<verse eid="HOS 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 11:4" />Marartetixxe wodaronn;</para>
  <para style="q2" vid="HOS 11:4">jaalalatike haachchabinni insa'ne akeekenne;</para>
  <para style="q1" vid="HOS 11:4">Qanbara gooba insa'nekenaa'ni hoyyenen:</para>
  <para style="q2" vid="HOS 11:4">heeshi hiyyennexxi insa'nee itisennen.<verse eid="HOS 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="HOS 11:5" />«Yoona insa'ne aadde aaga ginbeemmaxxee</para>
  <para style="q2" vid="HOS 11:5">Gibtsee'a hingabaata?</para>
  <para style="q2" vid="HOS 11:5">Asoorinna insa'nee galchabaata?<verse eid="HOS 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 11:6" />Qachcha insa'neke'n wolaantichchi ganaan;</para>
  <para style="q2" vid="HOS 11:6">hulatika danqarsanjuwwa insa'neka woxaan:</para>
  <para style="q2" vid="HOS 11:6">insa'neke fuggoke yaadixxenna insa'nee biraan.<verse eid="HOS 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 11:7" />Anki ardi anenaa'n ille iima higo'a eeyye;</para>
  <para style="q2" vid="HOS 11:7">Lumokibaa raarroolenna</para>
  <para style="q2" vid="HOS 11:7">hoone orininna insa'nee kubbisabaan.<verse eid="HOS 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 11:8" />«Koo Efireem, hitta atee waalannota?</para>
  <para style="q2" vid="HOS 11:8">Tee Isira'eel hitta atee sa'isse uwwannota?</para>
  <para style="q1" vid="HOS 11:8">Hittata Adaamashsha atee uudannota?</para>
  <para style="q2" vid="HOS 11:8">Hitta Tseboyisha atee assannota?</para>
  <para style="q1" vid="HOS 11:8">Godobi ank raafeme;</para>
  <para style="q2" vid="HOS 11:8">ati'a afeennexxi mararte lumoxxen.<note caller="-" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="DEU 29:23">Lan. 29:23</ref>.</char></note><verse eid="HOS 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 11:9" />Bubbaaxxa mufe anxa idagabe'non:</para>
  <para style="q2" vid="HOS 11:9">langaxxa Efireemii balleessabe'no;</para>
  <para style="q1" vid="HOS 11:9">Ani ha'noxxe oddo'ni hedhenneki woyyichcha Mageno malee:</para>
  <para style="q2" vid="HOS 11:9">manjokebaan</para>
  <para style="q2" vid="HOS 11:9">mufeti ha'noon dagabe'non.<verse eid="HOS 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 11:10" />Insa'nenna Duuchchi Woddika Gootta hordonfaan;</para>
  <para style="q2" vid="HOS 11:10">Isinna neeqiinsha harqaan</para>
  <para style="q1" vid="HOS 11:10">Isi harqa woddaa</para>
  <para style="q2" vid="HOS 11:10">oose isixxinna culphisa'n dhidhimakenaa'n daggaan.<verse eid="HOS 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 11:11" />Insa'nenna Ci'atishsha Gibtsee'n,</para>
  <para style="q2" vid="HOS 11:11">guugenjotishsha Asoori'ni</para>
  <para style="q2" vid="HOS 11:11">phirri hina'ni dangaan;</para>
  <para style="q1" vid="HOS 11:11">Aninna insa'nee mine insa'nenge'n hedhisannon»</para>
  <para style="q2" vid="HOS 11:11">hiyya'neeni Duuchchi Woddiki Gootti.<verse eid="HOS 11:11" /></para>
  <para style="s1">Isira'eelike Ardixxa Cubbo</para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 11:12" />Efireemi dhariki,</para>
  <para style="q2" vid="HOS 11:12">Isira'eeliki ardinna xaqaroti anee buqe,</para>
  <para style="q1" vid="HOS 11:12">Yihuda Magenokee ajajemabaake;</para>
  <para style="q2" vid="HOS 11:12">addatemeeka woyyichchanna ke'aaken.<verse eid="HOS 11:12" /></para>
  <chapter eid="HOS 11" />
  <chapter number="12" style="c" sid="HOS 12" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 12:1" />Efireemi diidalotike allalisanjon,</para>
  <para style="q2" vid="HOS 12:1">barra duuchcha borotixxa diidallo hordofaan;</para>
  <para style="q2" vid="HOS 12:1">dharakanna xaqaro bira sa'issaan.</para>
  <para style="q1" vid="HOS 12:1">Asoorin weltinna weli aagaan;</para>
  <para style="q2" vid="HOS 12:1">ejersiinxa zayitenna Gibtsee'a ergaan.<verse eid="HOS 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 12:2" />Duuchchi Woddiki Gootti Yihudaa ku'la'neexxe kula hexxeen;</para>
  <para style="q2" vid="HOS 12:2">Ya'iqoobi me'inji isikishshann xixaan</para>
  <para style="q2" vid="HOS 12:2">Huje isixxishshanni hira isi'a uwwaan.<verse eid="HOS 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 12:3" />Gadaameesi giddo ifike dayyika tinxa abixxeen;</para>
  <para style="q2" vid="HOS 12:3">nophpheechchi uduma Mageniki welti wo'laancho abixxe.<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="GEN 25:26">Dada. 25:26</ref>. </char></note><note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="GEN 32:24-26">Dada. 32:24-26</ref>. </char></note><verse eid="HOS 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 12:4" />Iimike erganjinni welti wo'lancho abixxexxi isoo injifate:</para>
  <para style="q2" vid="HOS 12:4">isi edo elle alfatee oodhe isoo kadhate;</para>
  <para style="q1" vid="HOS 12:4">Isoonna Beeteli afe:</para>
  <para style="q2" vid="HOS 12:4">okkonna isinni welti haaso'e.<verse eid="HOS 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 12:5" />Isinna Lumoke Duuchchi Woddik Gootta Magenon; isi ege'nemmak summinna Duuchchi Woddike Gootan.<verse eid="HOS 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 12:6" />Tennexxee atike Mageniba'a higi:</para>
  <para style="q2" vid="HOS 12:6">jaalalatanna seeriinxa murte jabeessite heqedhi;</para>
  <para style="q2" vid="HOS 12:6">duuchchi wodda Mageno atike'n addatem.<verse eid="HOS 12:6" /></para>
  <para style="s1">Lebendeedexxa Murte</para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 12:7" />Daddalto seeribeloxxe kiilo'n gurgudhitaan;</para>
  <para style="q2" vid="HOS 12:7">moorakanna eetaan.<verse eid="HOS 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 12:8" />Efireemi, hiyya'ni ifi saadaa qici,</para>
  <para style="q2" vid="HOS 12:8">«Ani qabaataken;</para>
  <para style="q2" vid="HOS 12:8">dureessake kadeennen;</para>
  <para style="q1" vid="HOS 12:8">Tenne karra duuchcha afee'naa</para>
  <para style="q2" vid="HOS 12:8">mitte balleessanna cubbo ane'ni afenda'a» hiyye.<verse eid="HOS 12:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 12:9" />«Gibtseeke boganaa'ni ha'noo fulchenneki, Duuchchi Woddiki Gootti ha'nooki Magen anten:</para>
  <para style="q2" vid="HOS 12:9">Woggatike ha'nooke ayyaanixxa barra: asitinammashsha duuchcha,</para>
  <para style="q1" vid="HOS 12:9">Haaroba seemmati giissineeke ha'nooke fooquwwa'n ofoldinaashsha:</para>
  <para style="q2" vid="HOS 12:9">ha'no'o assannon.<note caller="-" style="x"><char style="xo" closed="false">12:9 </char><char style="xt" closed="false"><ref loc="LEV 23:42-43">Lew. 23:42-43</ref>. </char></note><verse eid="HOS 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 12:10" />Wabeekkolete'ni haaso'eennen:</para>
  <para style="q2" vid="HOS 12:10">heddo waleella insa'ne'n leellisheennen;</para>
  <para style="q2" vid="HOS 12:10">insa'ne darree'n mammaasiki haaso'eenneni» hiyye.<verse eid="HOS 12:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 12:11" />Gele'adi fuggichchaken</para>
  <para style="q2" vid="HOS 12:11">ardikinna wayifulabaaken;</para>
  <para style="q1" vid="HOS 12:11">Jiboota Geligeelike booncho'ni tolchinata?</para>
  <para style="q2" vid="HOS 12:11">Insa'nek tolchimalch ko'emeeke fichcha'ni hexxeexxe</para>
  <para style="q2" vid="HOS 12:11">kinoxxe tuulosha kaddaan.<verse eid="HOS 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 12:12" />Ya'iqoobi Sooriyaa baaje;</para>
  <para style="q2" vid="HOS 12:12">Isira'eel are alfatee ergateme;</para>
  <para style="q2" vid="HOS 12:12">hira iseekeenna gedhebo alalle.<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="GEN 29:1-20">Dada. 29:1-20</ref>. </char></note><verse eid="HOS 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 12:13" />Duuchchi Woddiki Gootti wabeekkichchi darree'ni</para>
  <para style="q2" vid="HOS 12:13">Isira'eelii Gibtsee'ni fulche;</para>
  <para style="q1" vid="HOS 12:13">Wabeekkichchi darree'ninna isoo abide.<note caller="-" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="EXO 12:50-51">Fula. 12:50-51</ref>. </char></note><verse eid="HOS 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 12:14" />Efireemi kinn isoo fuggo mufachchiise:</para>
  <para style="q2" vid="HOS 12:14">Duuchchi Woddiki Gootti isikinna munde dunatixxa balleessa</para>
  <para style="q2" vid="HOS 12:14">iso'in wirri assaan: tuffateexxe tuffexxenna hasisaaka hira isi'a uwwaan.<verse eid="HOS 12:14" /></para>
  <chapter eid="HOS 12" />
  <chapter number="13" style="c" sid="HOS 13" />
  <para style="s1">Mageniinxi Mufe Isira'eelike Arda'ni</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 13:1" />Efireem haaso'a wodda manni culphise</para>
  <para style="q2" vid="HOS 13:1">isi Isira'eeli'ni ulfeessemeekemman:</para>
  <para style="q2" vid="HOS 13:1">yaane kinn Ba'aali hinaaka mageno mageneefate cubbo hujemmaxxe reye.<verse eid="HOS 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 13:2" />Ta'anna cubbo huja bira sa'ne;</para>
  <para style="q2" vid="HOS 13:2">birreti sibiljo baqinse ifi'aanni miseechchixxa fakke huccine:</para>
  <para style="q1" vid="HOS 13:2">Angatixxe ogenni hujendeexxa fakkuwwa giisse'ne:</para>
  <para style="q2" vid="HOS 13:2">kunniichchi duuchchi manjiinxe angatixxe hujen.</para>
  <para style="q1" vid="HOS 13:2">Konne mannixxee hiyyendee qici:</para>
  <para style="q2" vid="HOS 13:2">«Insa'ne manjo tolchine;</para>
  <para style="q2" vid="HOS 13:2">jabbetixxa fakkuwanna sunqe'naan» hineen.<verse eid="HOS 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 13:3" />Tennexxee soodimariinxe hurreshsha,</para>
  <para style="q2" vid="HOS 13:3">ikki woddi ba'ammake gorsike fixeessishsha,</para>
  <para style="q2" vid="HOS 13:3">ooddetenaa'ni diidallo filtammake huurishsha:</para>
  <para style="q2" vid="HOS 13:3">masikootetenaa'ni fuldamaxxe wiliilleshsha kandaan.<verse eid="HOS 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 13:4" />«Ani kinn Gibtseeke boganaa'ni atee fulcheenneke,</para>
  <para style="q2" vid="HOS 13:4">Duuchchi Woddike Gootta atike Magenon:</para>
  <para style="q1" vid="HOS 13:4">Ane malee wele Mageno egendebexxon:</para>
  <para style="q2" vid="HOS 13:4">ane malee weli anjiralli hedhebaan.<verse eid="HOS 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 13:5" />Qiilla Gammoojje'ni,</para>
  <para style="q2" vid="HOS 13:5">bagoke boga'ni ani atee heqqennen.<verse eid="HOS 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 13:6" />Ani insa'nee itisenechchi uduma goddineen:</para>
  <para style="q2" vid="HOS 13:6">goddineexxi hollate'ni ke'ne:</para>
  <para style="q2" vid="HOS 13:6">tennexxee anee deene.<note caller="-" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="EXO 8:11-17">Fula. 8:11-17</ref>. </char></note><verse eid="HOS 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 13:7" />Tennexxee ani neeqinsha insa'ne'ni dagannon,</para>
  <para style="q2" vid="HOS 13:7">qeedhanchiishsha orake'ni insa'nee gaadannon.<verse eid="HOS 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 13:8" />Beltanna hundii'ni a'lendemmake Dibite hiyyemammake biniinchishsha</para>
  <para style="q2" vid="HOS 13:8">insa'ne ganannon; ninnifannon</para>
  <para style="q1" vid="HOS 13:8">Neeqinsha insa'nee liqinsannon</para>
  <para style="q2" vid="HOS 13:8">biniinchuwwikinna insa'nee yeyyekannon.<verse eid="HOS 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 13:9" />«Koo Isira'eelike arda</para>
  <para style="q2" vid="HOS 13:9">anee gargarsanjo atike'n kexxetaxxee baxxaatton.<verse eid="HOS 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 13:10" />Moyanjokanna akeekisano ani'a uwwi;</para>
  <para style="q2" vid="HOS 13:10">hite laqqetteshshann;</para>
  <para style="q1" vid="HOS 13:10">Atee anjiro'a moyanji habata hedhe?</para>
  <para style="q2" vid="HOS 13:10">atike qachchuwwa duuchcha'ni hedheeki galchalluwwi habata hedhe?<note caller="-" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="1SA 8:5-6">1 Sam. 8:5-6</ref>. </char></note><verse eid="HOS 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 13:11" />Ani mufatee moyanjo ati'a uwweennen:</para>
  <para style="q2" vid="HOS 13:11">aare anxenni isoo hoyyennen.<note caller="-" style="x"><char style="xo" closed="false">13:11 </char><char style="xt" closed="false"><ref loc="1SA 10:17-24">1 Sam. 10:17-24</ref>; <ref loc="1SA 15:26">15:26</ref>. </char></note><verse eid="HOS 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 13:12" />Efireemixxi balleesa tulendeen;</para>
  <para style="q2" vid="HOS 13:12">cubbo isixxinna maxaafake'ni borreessendeen.<verse eid="HOS 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 13:13" />Ciniinitote'n hexxeexxi manjichchoshsha wixxiri hiyyaaxxe yanna iso'n daggaan:</para>
  <para style="q2" vid="HOS 13:13">isi kinni beekuma afebaake belton:</para>
  <para style="q1" vid="HOS 13:13">Ilemaaxxi yanna geltaa wodda,</para>
  <para style="q2" vid="HOS 13:13">amatike gadaameessanaa'ni fulo'a</para>
  <para style="q2" vid="HOS 13:13">eeyyabaaken.<verse eid="HOS 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 13:14" />«Hirreessiinxe hunnanna ani ha'noo wodannon:</para>
  <para style="q2" vid="HOS 13:14">reyotenaa'ninna insa'nee anjirannon:</para>
  <para style="q1" vid="HOS 13:14">Tee reyo, bala atixxi haba hexxeta?</para>
  <para style="q2" vid="HOS 13:14">Koo mooggo balleessa atixxi haba hexxeta?</para>
  <para style="b" vid="HOS 13:14" />
  <para style="q1" vid="HOS 13:14">«Ta'inni edi'a ani isi'a mararabe'no.<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="1CO 15:55">1 Qor. 15:55</ref>. </char></note><verse eid="HOS 13:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="HOS 13:15" />Dayyuwwi isikixxe oddo'ni duroomoolenna midde.</para>
  <para style="q1" vid="HOS 13:15">Borotixxi diidallo qiilla gammoojjenaa'ni ganda'ni,</para>
  <para style="q2" vid="HOS 13:15">Duuchchi Woddike Goottinaa'n daggaan:</para>
  <para style="q1" vid="HOS 13:15">Muumetinna xoxxaan:</para>
  <para style="q2" vid="HOS 13:15">wode'iinxi balenna baggaan.</para>
  <para style="q1" vid="HOS 13:15">Isixxi karra duuchcha</para>
  <para style="q2" vid="HOS 13:15">masseccatike minenaa'n booji'enda.<verse eid="HOS 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 13:16" />Mageno ifike'n jallineemmaxxee: Samaariyaaki ardi duuchchi balleessa ifixxa adhdhiinaan:</para>
  <para style="q2" vid="HOS 13:16">wolaantichchiki mundaan</para>
  <para style="q1" vid="HOS 13:16">Oose insa'nexxinna buttinake'ni cancaqendaan:</para>
  <para style="q2" vid="HOS 13:16">insa'nexxe siila'witeexxe melaalleki godobinna daremaan.»<verse eid="HOS 13:16" /></para>
  <chapter eid="HOS 13" />
  <chapter number="14" style="c" sid="HOS 14" />
  <para style="s1">Eebba Adhdhatee Aadde Aaga</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 14:1" />Koo Isira'eelike arda cubbote'n ibbettaxxee,</para>
  <para style="q2" vid="HOS 14:1">Duuchchi Woddike Gootta atike Magenibaa higi.<verse eid="HOS 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 14:2" />Hitinaaka hiyyichcho aaxxine:</para>
  <para style="q2" vid="HOS 14:2">Duuchchi Woddike Goottibaa higge:</para>
  <para style="q1" vid="HOS 14:2">Hitinaaqic,</para>
  <para style="q2" vid="HOS 14:2">«Cubbo no'oxxa duuchcha no'o'a gattowwali hiyyi:</para>
  <para style="q1" vid="HOS 14:2">Ati'a shiqinsaanneka galata,</para>
  <para style="q2" vid="HOS 14:2">Mararte atixxinn no'oo adhdhi.<verse eid="HOS 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 14:3" />Asoori no'oo anjiro'a dande'abaa</para>
  <para style="q2" vid="HOS 14:3">loliinka fadhaduwwanna gulunfaabe'no;</para>
  <para style="q1" vid="HOS 14:3">Ta'inni elqi'a ifixxe anganni hunjennachcho,</para>
  <para style="q2" vid="HOS 14:3">annanna ama afebaakiir atenaa'n mararte alfa'neen</para>
  <para style="q2" vid="HOS 14:3">‹Magenuwwa no'oken› hinabe'no» hiyye.<verse eid="HOS 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 14:4" />«Ani addatema gopha insa'nexxenaa'ni insa'ne fayyisannon;</para>
  <para style="q1" vid="HOS 14:4">Aare anxa insa'nenaa'ni hissedhennaxxee</para>
  <para style="q2" vid="HOS 14:4">ittanni insa'nee eeyyannon:<verse eid="HOS 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 14:5" />Ani Isira'eeli'a iimike wojishsha kadannon</para>
  <para style="q2" vid="HOS 14:5">isinna eloke daraarishsha dararaan;</para>
  <para style="q1" vid="HOS 14:5">Libaanoosike birbirsike</para>
  <para style="q2" vid="HOS 14:5">hiddichishsha hidda oltaan.<verse eid="HOS 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 14:6" />Dame isixxi nophphitaan;</para>
  <para style="q1" vid="HOS 14:6">Danchumma isixxinna ejersiinke haqichchishsha</para>
  <para style="q2" vid="HOS 14:6">fishshe isixxinna Libaanoosike birbirsishsha kaddaan.<verse eid="HOS 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 14:7" />Mannikinna higgeenni gaaddi isiki hunda hafuura adhdhaan:</para>
  <para style="q2" vid="HOS 14:7">isinna midhatishsha haanjedhaan;</para>
  <para style="q1" vid="HOS 14:7">Woyinetike hiddichchishsha dararaan:</para>
  <para style="q2" vid="HOS 14:7">gurri isikinna Libaanoosike woyinetixxe bookashsha fulaan.<verse eid="HOS 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 14:8" />Koo Efireem, ta'inni elqi'a misechchixxe fakkuwwanni welti</para>
  <para style="q1" vid="HOS 14:8">Maa mittooma afeenneta?</para>
  <para style="q2" vid="HOS 14:8">Hiyyaaxxa laqaannekinna isi'a xexxe'atannok anten:</para>
  <para style="q1" vid="HOS 14:8">Ani qufeeke hi'neesiinke haqichchishshaten:</para>
  <para style="q2" vid="HOS 14:8">gumma atixxinna anenaa'ni kexxeexxiniten»<verse eid="HOS 14:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 14:9" />Beeka kadeeki konneechchuwwa qaabbataan;</para>
  <para style="q2" vid="HOS 14:9">qalbefatakinna konnechuwwa ege'naan:</para>
  <para style="q1" vid="HOS 14:9">Duuchchi Woddike Goottik ori qajeeleeken</para>
  <para style="q2" vid="HOS 14:9">qulliyyetinna iso'n hana me'itaan</para>
  <para style="q2" vid="HOS 14:9">fuggaaleeyye kinni guggufattaan.<verse eid="HOS 14:9" /></para>
  <chapter eid="HOS 14" />
</usx>