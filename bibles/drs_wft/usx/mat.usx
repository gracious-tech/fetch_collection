<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Gedeo Bible</book>
  <para style="h">Maatoosixxaa Wengeele</para>
  <para style="toc1">Matoosi Borreesseexxa Gootta No'oke Yessuusi Kirstoosixxaa Wongele</para>
  <para style="toc2">Matoosixxaa Wengeele</para>
  <para style="toc3">Mat.</para>
  <para style="mt1">Maatoosi Borreesseexxa</para>
  <para style="mt2">Gootta No'oke Yessuusi Kirstoosixxaa Wongeele</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Maatoosixxi wengeele Yessuusixxe dagaxxi addachchiisa edisseexxi kulendeeke anjirallo kada isixxinna Mageni edise kako arda ifikee uwweexxa addachchisaaka hiyyichchi muuxe'emaak isi darre'n kaddeexxa kuldaaxxa eloxxe odoka hiyyichcho afe'eken. Tinni eloxxe odoke eloke haaso'i Yessuusi insa'neexxe oddo'ni ilemee nophpheeke Ayihudotakeete calla kadebaak butta duuchchi'anna weltiten. Maatoosixxa wengeele xexxe'achchotti qixxeessemeeke maxaafan; Yessuusixxe ilenshanaa'n safeexxi isixxe xammaqaxxenna isixxe hega uudematixxee barachchiiseechchi uduma Isi Geliili giddo asseexxa lallaba, barsiisatixxanna fayyisatixxa isixxa ergatensha shiqishaan; ookkonechchi uduma Yessuusi Galiil'n Iyyerusaalemi'a asseexxa me'inji'aanna tenne butta'ni tureeke udumixxe woggaxxe torba'n kaddeexxe yaanuwwaxxe kulaan. Tinni yaanuwwanna isixxa fannisenshanna isixxa reyonna ke'a mitteba abidaan. Tinni wengeel Yessuusi, Mageniinka seera tikatee baallooma afe'ekenna Mageniinxe mootummaxxe barsiisaake lumoke barsiisallo asse shiqishaan; isixxexxe barsiisanaa'n birasaxxaaxxi garga hexxe bifanni mitteba'a abidendeexxe onde kuta'n dhaabendaan.</para>
  <para style="ip">1. Mageniinxe mootummake mannika adaba'a, huje, insa'ne'a seeri uwwaaxxa yaanuwwanna muuxamiinxa qoobo ege'nishaaxxi isixxi koobatixxi lallaba 5:7.</para>
  <para style="ip">2. Mitte tommenna lame isixxi eragemeeyye wengeeltixxe lallaba'a ergendeexxa yanna insa'ne'a uwwendeexxi akeette hafuura adhdha 10:3.</para>
  <para style="ip">3. Mageniinxe mootummaxxe'e shiqqeexxi gargargargar hedheeke mammaassuwwi hafuura adhdha 13:4.</para>
  <para style="ip">4. Ergameeyyummatixxa maachchumma ifissaaxxa barsiisa haffura adhdha 18:5.</para>
  <para style="ip">5. Ta'ike barike muuxamixxeenna Mageniinxe mootummaxxe dagaxxe'e uwwendeexxa barsiisa hafuur adhdha 24-25.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Yessuus Kiristoosxa ilematika daalonna isixxa ilensha <char style="ior"><ref loc="MAT 1:1-2:23">1:1—2:23</ref> </char></para>
  <para style="io1">Xammaqallo Yohaannisixxa ergatensha <char style="ior"><ref loc="MAT 3:1-12">3:1-12</ref> </char></para>
  <para style="io1">Yessuusixxa xammaqenshanna isixxa hega uudensha <char style="ior"><ref loc="MAT 3:13-4:11">3:13—4:11</ref> </char></para>
  <para style="io1">Yessuus huje Galiila safeexxa <char style="ior"><ref loc="MAT 4:12-18:35">4:12—18:35</ref> </char></para>
  <para style="io1">Galiilinaa'n Iyyerusaalmi'a <char style="ior"><ref loc="MAT 19:1-20:34">19:1—20:34</ref> </char></para>
  <para style="io1">Muuxamiinxa isixxa torba Iyyerusaalem giddonna qarqara iseke'ninna ola'a iseke'n <char style="ior"><ref loc="MAT 21:1-27:66">21:1—27:66</ref> </char></para>
  <para style="io1">Goottiinxa reyotenaa'n ke'anna isixxa leella <char style="ior"><ref loc="MAT 28:1-20">28:1-20</ref></char></para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s1">Yessuus Kiristoosixxe Ilenshaka Daalo</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luq. 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Daawwitixxenna Abirihaamixxe sanne kade'eeke Yessuus Kiristoosixxe ilenshak daali konneechchinni butti'a hedheeken.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="PSA 132:11">Far. 132:11</ref>; <ref loc="ISA 11:1">Isa. 11:1</ref>.</char></note><verse eid="MAT 1:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />Abirihaami Yisaaqii'i i'le, Yisaaqii Ya'iqoobii'i i'le, Ya'iqoobinna Yihudaanna isika dayyuwwa i'le, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Yihuda Ti'imaarinaa'n Faaresiinna Zaaraa'a i'le, Faareesi Hesiroonii'i i'le, Hesirooninna Araamii'i i'le, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />Araamii Aminadaabii'i i'le, Aminadaabii Ne'asoonii'i i'le, Ne'asoonii Selmoonii'i i'le. <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Selmooninna Re'aabinaa'n Bo'eezii'i i'le, Bo'eezi Ruutinaa'n Iyyobeedii'i i'le, Iyyobeedii Isseyii'i i'le, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Isseyii moyanjo Daawwitii'i i'le. Daawwitinna Ooryoxxe arenaa'n Solomoonii'i i'le.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="RUT 4:18-22">Rut. 4:18-22</ref>; <ref loc="1CH 2:13-15">1 Odo. 2:13-15</ref>.</char></note> <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />Solomooninna Roobi'aamii'i i'le, Roobi'aamii Abiyaa'a i'le, Abiyanna Asaafii'i i'le, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />Asaafinna Iyyosaafixii'i i'le, Iyyosafixinna Iyyooraamii'i i'le, Iyyooraaminna Oziyaanii'i i'le, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Oziyaanina Iyyo'ataamii'i i'le, Iyyoo'atami Akaazii'i i'le, Akaazinna Hiziqiyaasii'i i'le, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Hiziqiyaasii Minaasee i'le, Minaasee Amootsii'i i'le, Amootisinna Iyyosiyaasii'i i'le, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Iyyosiyaasinna Baabiloonixxe booji'o wodda Ikoniyaaninna dayyuwwa isika i'le.<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="2KI 24:14-15">2 Moy. 24:14-15</ref>; <ref loc="2CH 36:10">2 Odo. 36:10</ref>; <ref loc="JER 27:20">Erm. 27:20</ref>. </char></note> <verse eid="MAT 1:11" /><verse number="12" style="v" sid="MAT 1:12" />Baabiloonixxe booji'o uduma Ikoniyaan Selatiyaalii'i i'le, Selatiyaalii Zerubaabeelii'i i'le, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Zerubaabeelinna Abiyuudii'i i'le, Abiyuudi Eliyaqeemii'i i'le, Eliyaqeeminna Azoorii'i i'le, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />Azoorinna Saadooqii'i i'le, Saadooqii Akiimii'i i'le, Akiiminna Eliyudii'i i'le, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Eliyudinna Alaazaarii'i i'le, Alaazaarinna Maataanii'i i'le, Maataaninna Ya'iqoobii'i i'le, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Ya'iqoobinna Kiristoosi<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="fqa" closed="false">Kiristoosi </char><char style="ft" closed="false">Kiristoosi hiyya Mesih yookaan hariiremeeke hiyyaten.</char></note> hiyyemeeka Yessuusii ildammaxxa Maaramii'i kadhateemaka Yooseefii'i i'le.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Yoona Abirihaaminaa'n Daawwiti qico'n tommenna shoole ila, Daawwitinaa'n Baabiloonixxe booji'o qico'n tommenna shoole ila, Baabiloonixxe booji'onaa'n Kiristoosixxe ilensha qico'n tommenna shoole ila kaddaan.<verse eid="MAT 1:17" /></para>
  <para style="s1">Yessuusi Kiristoosixxa Ilensha</para>
  <para style="r">(<ref loc="LUK 2:1-7">Luq. 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Yoona Yessuusi Kiristoosixxi ilensha konnechchi butta hexxeexxen: Ama isixxi Maarami Yooseefi'a uwwendeexxi heerundebaang Woyyichchi Hafuur darree'n sila'witeexxi afende.<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="LUK 1:27">Luq. 1:27</ref>.</char></note> <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Isee kadhateemmak Yooseefi qullichcha manjo kadeemmaxxee Maaramii'i mannii edo salphisa gibeexxi isee buqonni waalo'a mudhdhe. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Tennee yaane hedaa'naa'a Goottiink iimik erganji oojjoti iso'ni leelleexxi, «Koo Daawwitike belto Yooseefii! Kadhatteettexxi Maarami siila'witeek Woyyichchi Hafuuri darree'nite kaddeemmaxxe isee mini'a adhdha sodaattoxxe. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Isenna labba belto ildaan; isinna arda cubbotenaa'n anjirammaxxee summa isika Yessuus hite fulchitatton» hiyye.<note caller="-" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="LUK 1:31">Luq. 1:31</ref>.</char></note><verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Tinni duuchcha kaddechchi Gootti wabeekichchi darree'n haaso'eemmaxxi muuxendo'aten. Tinninna <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />«Dubarrichchote sila'witaan; labba beltonna ildaan; isik summinna Amaanu'eel hiyyemaan» hiyyendemmaxxeten. Amaanu'eli hiyyanna «Mageni no'onni welti hedheen» hiyyaten.<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">Isa. 7:14</ref>.</char></note> <verse eid="MAT 1:23" /><verse number="24" style="v" sid="MAT 1:24" />Yooseefi diiphokenaa'n dammaqeexxi Goottiink iimik erganji isoo ajajemmashsha Maaramii'i ifike minibaa adhdhe.<note caller="+" style="f"><char style="fr" closed="false">1:24 </char><char style="ft" closed="false">ifike minibaa adhdhe hiyyaaka hiyyichcho Girkeek hiyyichchi ifixxe are assedhdho'aa adhdhe hitaan</char></note> <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Kaddo malee angafa belto ildaa qico'ni isenni welt afemeba'a.<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="fqa" closed="false">Isenni welt afemeba'a </char><char style="ft" closed="false">Aro'tinxanna aretixxa afensha assineba'a hiyyate.</char></note> Yooseefinna summa isika, «Yessuus» hiyye fulche.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s1">Borotenaa'n Dageeka Urje Uudamma Manna</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Moyanjo Heerodisike baro'n Yessuus Yihudake bogi giddo Beeteliheemike qachcha'ni ileme; ookkonne wodda beekkole borotinaa'n Iyyerusaalemi'a daggeeexxi, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />«Ilemeek Ayihudiink moyanji haba hedhee? Borote'ni urje isixxa anfennexxi iso'n sagandona'a dangeennen» hina'n qorre.<note caller="-" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="JER 23:5">Erm. 23:5</ref>; <ref loc="ZEC 9:9">Zek. 9:9</ref>; <ref loc="NUM 24:17">Lak. 24:17</ref>.</char></note> <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />Moyanji Heerodis tennee laqee wodda weekkeme; Iyyerusaalemik manni duuchchinna isinni welti weekkeme. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Isinna qeesetika sooreessuwwanna ardiinka seeriinka barachiisanjuwwa duuchcha mitteba ye'eexxi Kiristoosi haba ilemaaxxa insa'nee qore. <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Insa'nenna, «Yihudake bogi giddo Beeteliheemi ilemaan hine iso'n hissine haasonne; tenneenna wabeek hiyyeexxi borreesseemma qici,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />« ‹Ati Yihudake bogixxe tee Beeteliheemii!</para>
  <para style="q2" vid="MAT 2:6">arda anka Isira'eelii'i allalaake galchallo kadaak atenaa'n dagaammaxxee</para>
  <para style="q2" vid="MAT 2:6">wele Yuhudake galchalluwwinaa'n mayikinna shiixxexxabexxo.› »<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">Mik. 5:2</ref>.</char></note><verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Tennexxe'e Heerodisi eettene beekkole maqo ye'iseexxi, iitti urje leeliteexxa yanna insa'ne qoreexxi wo'me. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Iinsa'ne Beeteliheemi'a hiyya'n ergee qici, «Martineexxi eettenee ilendemmaxxe annoxxa yaane xexe'achoti qortineexxi wo'me! Iso'o affineechchi uduma aninna marennexxi isi'a sagadonaa daggineexxi ane'ni kulle!» hiyye.<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Insa'nenna moyanji hiyyeexxa tenne lanqeexxi fule me'ine. Kunse borotinaa'n fulle dangeema wodda uunda'ni dangeemmaxxi iitti urje anno iitti hexxemmaxxe bakka'n dagge uurritaa qico'ni insa'nee akeeka'emman. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Urje eettene anfee wodda lumo qico gammande. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Mini'anna e'yinee woddanna annuyyo ama isixxe Maaraminni welti hexxe'na'a anfe; insa'nenna guluffante isi'a sagande; ookkonechchi uduma ififixxa saaxine ba'nineexxi worqe, hixxanakanna karibe isi'a shiqinshe. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Heerodisibaanna ille ima hinge marabaashsha oojjoti wo'mineexxi wele ora ifike bogiba'a illeema hinge.<verse eid="MAT 2:12" /></para>
  <para style="s1">Eetene Anno Gibtse'a Aa'ne Baanjeexxa</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Iikki urijuwwa uudammak manni me'eechchi uduma Goottiink iimik erganji hashsha oojjoti Yooseefi'ni leelleexxi «Heerodisi annuyyo shiyo'a hasaammaxxe'e, kexxettexxi annuyyo ama isixxeninn welti aaxxe Gibtse'a baaji! Ate'n kulanno qici'anna ookkonni tur!» hiyye. <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Yooseefinna hashsha ke'eexxi annuyyotanna ama annuyyootixxa aadhdheexxi Gibtse'a me'e. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Ookkonna Heerodisi reyaa qico'n ture. Tennenni «Belto anka Gibtsee'n ye'enne» hiyyeexxi Gootti wabeekii darree'n haaso'emmaxxi muuxende.<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">Hos. 11:1</ref>.</char></note><verse eid="MAT 2:15" /></para>
  <para style="s1">Heeroodis Annoole Shilchiseexxa</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Heerodisi iikki urje uuxxedhdhammak manni iso'o sobeexxa afeexxa yanna lumo qica aare; ookkonee urje uudammake manninaa'n wo'memmaxxe yanna'n lame woggaxxanna ookkenechchi butti'a hexxeexxa Beeteliheemi'ninna iseke qarqarke olla'uwwa'n hexxeexxa annoole duuchcha erge shilchiise. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Eetenne yanna'n wabeeka Ermiyaasi darree'n kulememmak konneechchi butti'a hedheek raagi muuxeme:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />«Raaheeli oose ifixxee ooxxa wodda</para>
  <para style="q2" vid="MAT 2:18">oodhishshatinna lumoxxi hunbaashsha</para>
  <para style="q2" vid="MAT 2:18">Raamake qachchi giddo laqende;</para>
  <para style="q2" vid="MAT 2:18">oose isexxi duuchchanna muddeemmaxxee</para>
  <para style="q2" vid="MAT 2:18">dayyeeffachchonna dandeetteba'a.»<note caller="-" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="JER 31:15">Erm. 31:15</ref>.</char></note><verse eid="MAT 2:18" /></para>
  <para style="s1">Gibtsee'n Naazireti'a Higa</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Heerodisi reyeechchi uduma iimik Goottiink eganji Gibtse Yooseefi'n oojjoti lelleexxi, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />«Annuyyo shiyo'a hasaammakir reyeemmaxxee kexxe annuyyotanna ama isixxa aaxxe Isira'eelike bogibaa me'i» hiyye. <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Yooseefinna ke'eexxi annuyyotanna ama isixxa adhdheexxi Isira'eelike bogibaa me'e. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Yaane kinni Heerodisixxe bakka'n belti isik, Arkelawoosi Yihudake boga'n moyeexxa laqqee wodda, Yooseefi ookko'a me'a sodaate; oojjotinna xexe'achiisa isi'a uwwendeemmaxxee Geliilake bogiba'a me'e. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Naazireeti hiyyemaake qachcha'ninna mareexxi ofo'le; Tininna kaddeechchi wabeekoti darree'n, «Naazireetike manjo hiyyemaan» hiyyeme kulememmak raagi muuxemaashshaten.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="ISA 11:1">Isa. 11:1</ref>; <ref loc="MRK 1:24">Mar. 1:24</ref>; <ref loc="LUK 2:39">Luq. 2:39</ref>; <ref loc="JHN 1:45">Yoh. 1:45</ref>.</char></note><verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">Xammaqallo Yohaannisixxa Lallaba</para>
  <para style="r">(<ref loc="MRK 1:1-8">Mar. 1:1-8</ref>; <ref loc="LUK 3:1-18">Luq. 3:1-18</ref>; <ref loc="JHN 1:19-28">Yoh. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Eettenee yanna xammaqalli Yohaannisi Yihudaxxe qiilla gammoojjebaa lallaba'n dage. <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />Lallaba woddanna, «Iimixxi mootumma shiqqeemmaxxee aadde aagge!» hiyya'neman.<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="MAT 4:17">Mat. 4:17</ref>; <ref loc="MRK 1:15">Mar. 1:15</ref>. </char></note> <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Wabeekichcha Issayaasi darree'n,</para>
  <para style="q1" vid="MAT 3:3">«Qilla gammoojje'n</para>
  <para style="q1" vid="MAT 3:3">Goottinka ora giise;</para>
  <para style="q1" vid="MAT 3:3">‹Hodhdhichakanna isi'a toggi asse!› hiyya'n raarramak hafuuri» hiyyeme kuleme'eemmak isoten.<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">Isa. 40:3</ref>. </char></note><verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Yohaannisixxi seemma gaaliinxe ordaxxeman; hidhake'ninna gogiinxa hiito ka'le'eman. Ita isixxinna, awwaanessakenna badda'atike maleboman.<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 Moy. 1:8</ref>; <ref loc="ZEC 13:4">Zek. 13:4</ref>; <ref loc="LEV 11:22">Lew. 11:22</ref>. </char></note> <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Eettene yanna Iyyerusaaleminaa'n, Yihudake bogi duuchchinaa'ninna Yordanoosike qarqara'n hedheek bogi duuchchanaa'n manni Yohaannisiba'a daga'aman. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Cubbo ifi ifixxanna faaci'wa'n Yordanoosike galaan giddo Yohaannisixxe anga'n xammaqema'nemman.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Heddo Feerisitonna Seduuqito isi xammaqammabaa dagaa'naa'a affeexxi insa'nee'e, «Ha'no buutetixxi oose! Dagga'neexxe aarenaa'n baajjinaashsha ayyete ha'noo'n kule?<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mat. 12:34</ref>; <ref loc="MAT 23:33">23:33</ref>. </char></note> <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Yoona aadde aaggo ha'nooxxa leellishshaaxxa gumma gummisse. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />‹Abirihaami no'oke annani› hitina'n ifi sobbinoqqe'e! Mageni tenne kinonaa'n Abirihaami'a oose ke'issa dande'aaxxa ha'no'n kula'ennen.<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="JHN 8:33">Yoh. 8:33</ref>. </char></note> <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Ta'a kunse qoce haqichchuwwinke hiddi bira hexxeen; tennexxee eloxxa gumma gummisabaak haqichchi duuchchi woxemee giirate'ni hunemaan.<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="MAT 7:19">Mat. 7:19</ref>. </char></note><verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />«Ha'no aadde aagineexxa ege'nishate kadaashsha ani ha'no wode'ik xammaqaannen. Yaane kinni kophe isixxa duka dande'abe'nok, ane'e sa'aak hunnaamessi ani uduma dagaan; isinna ha'no Woyyichchi Hafuurinninna giirati xammaqaan. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Midhatik isik diidallisanjinna anga isixxe'n hedheen; isinna aldu'me ifixxa ca'a asaan; ifixxa dinnenna gootarake'n assaan; huurakanna xoxxabaaxxe giira'n gubaan.»<verse eid="MAT 3:12" /></para>
  <para style="s1">Yessuusixxa Xammaqensha</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mar. 1:9-11</ref>; <ref loc="LUK 3:21-22">Luq. 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Ookkone wodda Yessuusi Yohaannisixxe anga'n xammaqemo'a Geliilaa'n Yordanoosike galaaniba'a dage. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Yohaannisi kinni, «Ani atixxe anga'n xammaqema hasissaa wodda ati hitta anbaa daggatto? Hiyya'n iso'o hoyyo'aa wo'laane» <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />Yessuusi, «Qullumma duuchcha wonshatee no'o tennee assa hasissaammaxxee ta'a yoona eettii ani'a uwwi» hiyye hisse haaso'e. Eettenee yanna Yohaannisinna konne yaada'ni weli aageexxi Yessuusii xammaqe. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />Yessuusinna xammaqemeshanni wode'ekenaa'n fule; ookkone hirba'ninni iima bannedee'naa'a, Mageniik Hafuuri guugenjotisha dirreexxi Yessuusi'n dagaa wodda afe. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Eettene yanna'ninni, «Ani iso'n gammadaannek eeyyaannek ank belti konneten» hiyyaak haaso'i iimitenaa'n laqeme.<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="GEN 22:2">Dada. 22:2</ref>; <ref loc="PSA 2:7">Far. 2:7</ref>; <ref loc="ISA 42:1">Isa. 42:1</ref>; <ref loc="MAT 12:18">Mat. 12:18</ref>; <ref loc="MAT 17:5">17:5</ref>; <ref loc="MRK 1:11">Mar. 1:11</ref>; <ref loc="LUK 9:35">Luq. 9:35</ref>. </char></note><verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s1">Yessuusixxa Hega Uudensha</para>
  <para style="r">(<ref loc="MRK 1:12-13">Mar. 1:12-13</ref>; <ref loc="LUK 4:1-13">Luq. 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Ookkonechchi uduma dabiloos<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">Diyabiloosinna seexaan hiyyemeek lamiing summi umoke kadeeke mitte seexani'a uwwemeeke summa kadeemmaxxee Gede'uffat seexana hiyyaake duriisa, dabiloos hiyyaakee hedheeshanni dabiloos hiyyemaashsha murende'een. </char></note> Yessuusii hega uudaashsha Woyyichchi Hafuurinni qiilla gammoojjebaa isoo adhdhe me'e.<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="HEB 2:18">Ibr. 2:18</ref>; <ref loc="HEB 4:15">4:15</ref>.</char></note> <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Shoole tomme hashshanna shoole tomme barra agabo goddo hose galeechchi uduma solo'we.<note caller="-" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="EXO 34:28">Fula. 34:28</ref>; <ref loc="1KI 19:8">1 Moy. 19:8</ref>.</char></note> <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Iikki hega uudammakinna Yessuusibaa dageexxi, «Ati Mageniinke Belto kaddo'ottole tinni kino buddeena kaddo'a ajaji!» hiyye. <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />Yessuussinna « ‹Manjii Mageniinke afo'inaan fulaake hiyyichchi duuchchinni malee buddeeni callinni hedhabaan› hiyyendee borreessende'een» hiyya'n hiisse haaso'e.<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">Lan. 8:3</ref>.</char></note><verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Ookkonechchi uduma dabiloos Yessuusii'i woyyichchi qachchiba iyyedagati woyyichcha galmixxe xungo hana isoo uuriseexxi, <note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="NEH 11:1">Neh. 11:1</ref>; <ref loc="DAN 9:24">Dan. 9:24</ref>.</char></note> <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />hiyyee qici, «Lekka atixxi kinjoke'n guggufattabaashsha</para>
  <para style="q1" vid="MAT 4:6">« ‹Anga ifixxenni atee ke'isitto'a erganna ifixxa atixxee ajajaan</para>
  <para style="q2" vid="MAT 4:6">hiyyendeexxi borreessendeemmaxxee</para>
  <para style="q2" vid="MAT 4:6">ati Mageniinke Belto kaddo'ottole kabaa'n ifi butti'a darbi› » hiyye.<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">Far. 91:11-12</ref>.</char></note><verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yessuusinna, «Iittanni maxaafake'ni, ‹Gootta atika Mageno hega uuddoxxe'e!› hiyyendee borreessende'een» hiyye iso'ni hiisse haaso'e.<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">Lan. 6:16</ref>.</char></note><verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Higgeenni dabiloos Yessuusii'i hara lumo qico qeerraxxe kooba hana iyyemareexxi buttixxa moottummuwwa duuchcha ulfinna isengeerinninni iso'n leellisheexxi, <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />«Kumbu hite anee magenooffattottole, konne duuchcha ati'a uwwannon» hiyye.<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Yessuusinna isoo, «Gootta atike Mageni'a kumbu hiyyi, ‹isoo callanna magenooffati› hiyyende borreessendeemmaxxee, ati Seexana! Me'i ani edii'n!» hiyye.<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">Lan. 6:13</ref>.</char></note> <verse eid="MAT 4:10" /><verse number="11" style="v" sid="MAT 4:11" />Eettene yanna dabiloosi Yessuusii'i waaleexxi me'e; ergannatinna daggeexxi isi'a ergatte.<verse eid="MAT 4:11" /></para>
  <para style="s1">Yessuusi Galiila Lallaba Safeexxa</para>
  <para style="r">(<ref loc="MRK 1:14-15">Mar. 1:14-15</ref>; <ref loc="LUK 4:14-15">Luq. 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Yessuusinna Yohaannisi abidemeexxi usuremeexxa laqee wodda Galiila'a hige me'e.<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="MAT 14">Mat. 14</ref>; <ref loc="MAT 3">3</ref>; <ref loc="MRK 6:1">Mar. 6:1</ref>; <ref loc="LUK 3:19-20">Luq. 3:19-20</ref>.</char></note> <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Naazireetii waaleexxi Zaabiloonikenna Niftaleemike boga'n Galiilaxxe abbaayya qarqara hedheeke Qifirnahoomike qachcha'n dage ofo'le.<note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="JHN 2:12">Yoh. 2:12</ref>.</char></note> <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Tinninna kaddeechchi wabeekichchi Issayaasi haaso'eek, kaba butta hedheeki raagi muuxemo'aaten:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />«Eettene abbaayyaba iyyemaraake oribanna Yordanoosi wido</para>
  <para style="q2" vid="MAT 4:15">hedheekiir Zaabiloonik boginna Niftaleemik bogi,</para>
  <para style="q2" vid="MAT 4:15">alagiinxi Geliila,<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Dukkanate'n hedheek ardi</para>
  <para style="q2" vid="MAT 4:16">jabaka ifa uude;</para>
  <para style="q1" vid="MAT 4:16">Rewotike gaadisike bogi giddo hedhaammakeeri'anna</para>
  <para style="q2" vid="MAT 4:16">ifi insa'ne'a ife.» <note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">Isa. 9:1-2</ref>.</char></note><verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Eettene yannaa'n safeexxi Yessuusi, «Magenixxi moottumma ha'noobaa shiqqeemmaxxee, aadde aagge» hiyya'n lallabe.<note caller="-" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="MAT 3:2">Mat. 3:2</ref>.</char></note><verse eid="MAT 4:17" /></para>
  <para style="s1">Yessuusi Siretixxa Hordofeeyye Ye'eexxa</para>
  <para style="r">(<ref loc="MRK 1:16-20">Mar. 1:16-20</ref>; <ref loc="LUK 5:1-11">Luq. 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Yessuusi Galiilixxe abbaayya birii'n sa'aamma wodda lame dayyuwwa, Pheexiroosi hiyyemeemmaka Simi'ooniinna dayyo isika Indiryaasii'i afe. Insa'nenna qulxu'me abixaammake manna kandeemmaxxee marabe abbaayyate'n darbe'na'nemman. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yessuusinna, «Amme, anee hordoffe! Manna abiddinaake ha'noo assannon» hiyye. <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Iikki woddi insa'nenna marabe ifixxa waalleexxi isoo hordonfe. <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />Ookkoo'ninna sa'eexxi wele lame dayyuwwa, Zebidewoosixxa oose Ya'iqoobinna Yohaannisii'i afe; insa'nenna anna ifike Zebidewoosinni welti hobolo giddo marabe ifixxa qixxeeffanta'nemman. Yessuusinna insa'nee ye'e. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Insa'nenna iikki woddi hobolotanna anna ifika waalleexxi Yessuusii'i hordonfe.<verse eid="MAT 4:22" /></para>
  <para style="s1">Yessuusi Heddo Elagopheeka Manna Fayyiseexxanna Barachiiseexxa</para>
  <para style="r">(<ref loc="LUK 6:17-19">Luq. 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yessuusi Ayihudiinke magenooffachchotike mine'n barachchiisa'ninna Mageniinxe moottummaxxa eloxxa odonna lallaba'n, ardake'n hedheeka gargar gargar hedheeka dhukkubanna elagonphe fayyisa'n Galiila duuchcha'n marema'nemman.<note caller="-" style="x"><char style="xo" closed="false">4:23 </char><char style="xt" closed="false"><ref loc="MAT 9:35">Mat. 9:35</ref>; <ref loc="MRK 1:39">Mar. 1:39</ref>. </char></note> <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Gurri Yessuusikinna Sooriyake boga duuchcha'n laqeme; ardikinna gargar gargar hedheeke dhukkubininna fuggoxxe elagonphenni rakkataamakaara, fuggichchi hafuurinni abidemeemmakaara, gaggaddotikaaranna gogeekaara isibaa iyyedage; Yessuusinna insa'nee duuchchiinga fayyise. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Galiilake boganaa'ninna ookkone tomme qachchuwwinaa'n, Iyyerusaaleminaa'n, Yihudanaa'ninna Yordanoosike galaani widi darree'ni dageek heddi manni Yessuusii hordofe.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s1">Yessuus Koobate'n Hedheexxi Barachiiseexxa Barachcho</para>
  <para style="r">(<ref loc="MAT 5:1-7:29">Mat. 5:1—7:29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Yessuusi arda lumoka afee wodda kooba qabateexxi ofo'le; hordofeeyye isixxinna isibaa dage. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Yessuusinna insa'ne'e hiyya'n barachiisa safee qici;<verse eid="MAT 5:2" /></para>
  <para style="s1">Dhugaatixxa Eebba Alfaaka Manna</para>
  <para style="r">(<ref loc="LUK 6:20-23">Luq. 6:20-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />«Iimixxi mootumma insa'nexxe kaddeemmaxxee ifixxe hafuuriinxe hedhonni</para>
  <para style="q2" vid="MAT 5:3">hiyyeeyete kada insa'ne'ni laqendaake mannixxa wodo.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Dayyeeffata alfa'ammaxxee</para>
  <para style="q2" vid="MAT 5:4">yaadaakiirixxa wodo.<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="ISA 61:2">Isa. 61:2</ref>. </char></note><verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Butta dhaalaammaxxee</para>
  <para style="q2" vid="MAT 5:5">ifi heeshshi assaakiirixxa wodo.<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 37:11">Far. 37:11</ref>.</char></note><verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Goddaammaxxee</para>
  <para style="q2" vid="MAT 5:6">qulluma solo'waakiirixxanna dhebo'waakiirixxa wodo.<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="ISA 55:1-2">Isa. 55:1-2</ref>.</char></note><verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Mararte insa'ne'a assendaammaxxee</para>
  <para style="q2" vid="MAT 5:7">mararaakeerixxa wodo.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Mageno uudaammaxxee</para>
  <para style="q2" vid="MAT 5:8">luqqitte qalbekeerixxa wodo.<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="PSA 24:3-4">Far. 24:3-4</ref>.</char></note><verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Mageniinxe oose hiyyemmaammaxxee</para>
  <para style="q2" vid="MAT 5:9">manjiixxe oddo'n nage'i dirraashsha assaakeerixxa wodo.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Mootumma Magenxi insa'nexxe kaddemmaxxee</para>
  <para style="q2" vid="MAT 5:10">qullumatee'e shorremaakirixxa wodo.»<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="1PE 3:14">1 Phex. 3:14</ref>.</char></note><verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />«Ha'no anke kaddineemmaxxee buutoxxe'e manni ha'noo yowwa wodda, yookaan ha'noo shornsha wodda, yookaan fuggoxxenni dhark ha'noo summa balleesina wodda ha'nooxxa wodo.<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="1PE 4:14">1 Phex. 4:14</ref>.</char></note> <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Hiri ha'nok iimate'ni lumoke kadeemmaxxee ha'nooxxa wodo; fananaqqe! Ha'no edi darre hexxemmaxxa wabeekkonna iittanni shorrinshe'een.»<verse eid="MAT 5:12" /></para>
  <para style="s1">Maxinetanna Ifa</para>
  <para style="r">(<ref loc="MRK 9:50">Mar. 9:50</ref>; <ref loc="LUK 14:34-35">Luq. 14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />«Ha'no tenne buttaxxe maxinen; maxine kinni xe'me ifixxa bellessexxoole langaxxa xe'ma dandeettaa? Gadho hunendeexxi lekkati hirbesendaa malee edi'a mittechchi'anna la'o affaba'a.<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="LUK 14:34-35">Luq. 14:34-35</ref>.</char></note><verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />«Ha'no tenne butta duuchchike ifani. Koobate'n hedheek qachchi sho'oma dande'abaan.<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="JHN 8">Yoh. 8</ref>; <ref loc="JHN 12">12</ref>; <ref loc="JHN 9:5">9:5</ref>.</char></note> <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Mannikinna xassa xasseexxi mine hedheeke duuchchi'a ifaashsha qephphi hiyyeechi hana uggaa malee'e qoreti hunda uggabaan.<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="MRK 4:21">Mar. 4:21</ref>; <ref loc="LUK 8:16">Luq. 8:16</ref>; <ref loc="LUK 11:33">11:33</ref>.</char></note> <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Iittanni manni eloxxa ha'nooxxa huje uudeexi iimate'n hedheeka ha'noka Anna saadaashsha ifi ha'nook manni edo ifowwaal!»<note caller="-" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">1 Phex. 2:12</ref>.</char></note><verse eid="MAT 5:16" /></para>
  <para style="s1">Seera Muuxatixxee</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />«Ani seerakanna wabeekkotika hiyyichcho diigonaa'a dageenechcho ha'no'n labboqqe'e! Wonshonate malee'e diigonatebaan. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Haaso'aanexxi dhugaaten; iimatinna butta saxxaaxxee'e seer duuchchi wo'maa malee'e seerakenaa'n mittechchinna yookaan mitte beddo midde baxxaba'a.<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="LUK 16:17">Luq. 16:17</ref>.</char></note> <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Konne ajajuwwanaa'ni shiixoke kadeeka midde diigaaka, diigo'a wele barachiisaak iimixxe mootumma'n jalete kadaan; yaane kinni ajajuwwa konne wonshaakinna welikinna wonshaashsha barachiisaak iimixxe mootumma'ni lumoke kadaan. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Qulluma ha'nooxxi Feerisitotixxenaa'ninna Muuseke seerixxe barachchiisalluwwixxe qullummanaa'n sa'a gophphoole haranga iimixxa mootumma e'yitinabaan.»<verse eid="MAT 5:20" /></para>
  <para style="s1">Manjo Anga Sa'a Hasisabaaxxa</para>
  <para style="r">(<ref loc="LUK 12:58">Luq. 12:58</ref>, <ref loc="LUK 12:59">59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />«Edike manna'n ‹Shiltoxxe shiyeeke duuchcha'n murte murendaan› hiyyendeexxa laqqine'een.<note caller="-" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="EXO 20:13">Fula. 20:13</ref>; <ref loc="LEV 5:17">Lew. 5:17</ref>; <ref loc="LEV 16:18">16:18</ref>. </char></note> <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Ani kinni hiyyanee qici dayyo ifike'ni mufataake duuchcha'n murte murendaan; dayyo ifika, ‹Gowwi kunni› hiyye yowwaak songote'n murte iso'n murendaan. ‹Hawwawwi kunni!› hiyye yowwaake duuchcha'n gehaannemixxe giiraxxi murte iso'n murendaan.<note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="fqa" closed="false">Dayyo ifike'n mufataak </char><char style="ft" closed="false">Mitti mitte birexxi borrowwa Tolanga hiyyaaka hiyyecho lebbaan.</char></note><verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />«Tennexxee tolcha atika tolchimalchoke'n shiqishattoxxa yanna dayyi atik ate'n qoxxo hiyyeexxi yaane hexxeexxa kassi hito'ottole; <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />Tolcha atika ookkone tolchimalchi edo uggite marte edise atike dayyinni araarem; ookkonechchi uduma dagge tolcha atika shiqishi!<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />«Atee ku'leeke manjinni murtetiba'a me'ita'etexxa yanna rakkettexxi isinni weli aagi; iitta kada gophphoole ate'e ku'lamak murammake'n sa'isse uwwaan; iikki murammakinna usuraammake'ni ate'e sa'isseexxi uwwaan; usuriinke mi'ne'ninna darbendatton. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Dhugaate ha'no'n haaso'aannen, iitti enqemalcho saante gattebaang uute birtato qico'n ookko'ni fula dandeettabexxon.»<verse eid="MAT 5:26" /></para>
  <para style="s1">Yabaabula Hasisabaaxxa</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />« ‹Yabaabuldoxxe'e!› hiyyendeexxa laqqine'een.<note caller="-" style="x"><char style="xo" closed="false">5:27 </char><char style="xt" closed="false"><ref loc="EXO 20">Fula. 20</ref>; <ref loc="EXO 14">14</ref>; <ref loc="LEV 5:18">Lew. 5:18</ref>.</char></note> <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Ani kinni ha'no'n hiyyaane qici dubarte gaabbeti uudeek duuchchi eettene yanna qalbe ifixxi giddo isenni yabaabule'een. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Middixxi atixxi ille ate'e cubbote'n e'yisha'noole, ise fulchite ifinaa'n huni! Manjumma atixxi duuchchi gahaannemi hunemati mannii'n atixxe manjummanaa'n mitte gophetexxa woyyan.<note caller="-" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">Mat. 18:9</ref>; <ref loc="MRK 9:47">Mar. 9:47</ref>.</char></note> <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Middixxi atixxi anga atee'e cubbote'n e'yishsha'noole, ise kutte ifinaa'n huni! Wo'ma atixxi manjumma gahaanemete'n huneddeexxi mannii'n manjumma atixxenaa'ni mitte gophphettexxa woyyan.»<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">Mat. 18:8</ref>; <ref loc="MRK 9:43">Mar. 9:43</ref>.</char></note><verse eid="MAT 5:30" /></para>
  <para style="s1">Weli Tika Hasisabaaxxa</para>
  <para style="r">(<ref loc="MAT 19:9">Mat. 19:9</ref>; <ref loc="MRK 10:11-12">Mar. 10:11-12</ref>; <ref loc="LUK 16:18">Luq. 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />« ‹Are ifixxa walaak duuchchi isee waalatixxa borro ise'a uwwowwaal!› hiyyende'een.<note caller="-" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">Lan. 24:1-4</ref>; <ref loc="MAT 19:7">Mat. 19:7</ref>; <ref loc="MRK 10:4">Mar. 10:4</ref>.</char></note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Ani kinni ha'no'n hiyyaane qici Yabaabulletixxe buuto belo are ifixxa tikaak duuchchi ise'e yabaabulndaasha assaaken, tikendexxanna adhaak duuchchi yabaabulaake.»<note caller="-" style="x"><char style="xo" closed="false">5:32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">Mat. 19:9</ref>; <ref loc="MRK 10:11-12">Mar. 10:11-12</ref>; <ref loc="LUK 16:18">Luq. 16:18</ref>; <ref loc="1CO 7:10-11">1 Qor. 7:10-11</ref>.</char></note><verse eid="MAT 5:32" /></para>
  <para style="s1">Kakotixxee</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />«Edike manna'n, ‹Dhark kakatinoqqe'e, yaane kinni Gootti edo kakatineexxa kako asse› hiyyendeexxa laqqine'een.<note caller="-" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="LEV 9:12">Lew. 9:12</ref>; <ref loc="NUM 30:2">Lak. 30:2</ref>; <ref loc="LEV 23:21">Lew. 23:21</ref>.</char></note> <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Ani kinni ha'no'n hiyyaane qici haranga kakatinoqqe'e; iima Mageniixxe mootte kaddemmaxxee ise'n kakatinoqqe'e.<note caller="-" style="x"><char style="xo" closed="false">5:34 </char><char style="xt" closed="false"><ref loc="JAS 5:12">Ya'i. 5:12</ref>; <ref loc="ISA 66:1">Isa. 66:1</ref>; <ref loc="MAT 23:22">Mat. 23:22</ref>.</char></note> <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />Isixxe lekkake hadhisanjo kaddeemmaxxee buttate'ninna kakatinoqqe'e; Lumoke moyanjike qachcha kaddeemmaxxeenna Iyyerusaalemi'ninna kakatinoqqe'e.<note caller="-" style="x"><char style="xo" closed="false">5:35 </char><char style="xt" closed="false"><ref loc="ISA 66:1">Isa. 66:1</ref>; <ref loc="PSA 48:2">Far. 48:2</ref>.</char></note> <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Atike umika ordichcho golaloke yookaan xilloke assa dande'a gophphataxxee ifi'n kakattoxxe'e. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Tennexxee haaso'i ha'nook ‹Eeti› kadoole ‹Eeti› yookaan ‹Waawwo› kadoole ‹Waawwo› kadowwaal; tennenni gadhi'a hedheek ookkone fuggichchinaa'niten.»<note caller="-" style="x"><char style="xo" closed="false">5:37 </char><char style="xt" closed="false"><ref loc="EXO 19:12">Fula. 19:12</ref>; <ref loc="NUM 30:2">Lak. 30:2</ref>; <ref loc="LEV 23:21">Lew. 23:21</ref>.</char></note><verse eid="MAT 5:37" /></para>
  <para style="s1">Halo Fula Hasissabaaxxa</para>
  <para style="r">(<ref loc="LUK 6:29-30">Luq. 6:29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />« ‹Illetee ille, issotee isso› hiyyendeexxa laqqine'een.<note caller="-" style="x"><char style="xo" closed="false">5:38 </char><char style="xt" closed="false"><ref loc="EXO 21:24">Fula. 21:24</ref>; <ref loc="LEV 24:20">Lew. 24:20</ref>; <ref loc="DEU 19:21">Lan. 19:21</ref>.</char></note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Ani kinni ha'no'n hiyyaane qici fuggoke manjo'n mee iso'ni halo fulle! Yaane kinni middixxa atixxa boqo ganaakee bita'ixxanna isi'a wirri assi. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Mitti manji atixxa shamize adhdho'a haseexxi atee'e ku'loole koote atixxanna adhdho'a isi'a waal. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Mitti manji atee, Aninni welti heenoka ora me'i! Hiyye hunnatoole, ookkone qicika dachcha'a ora isinn welt me'i. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Atee kadhataakee uwwi! Atenaa'ni liqesedho'a hasaakanna hoyyexxoxxe.»<note caller="-" style="x"><char style="xo" closed="false">5:42 </char><char style="xt" closed="false"><ref loc="LEV 15:8">Lew. 15:8</ref>; <ref loc="PRO 24:29">Mam. 24:29</ref>.</char></note><verse eid="MAT 5:42" /></para>
  <para style="s1">Naapha Eeyyatixxee Uwwendeexxa Barachcho</para>
  <para style="r">(<ref loc="LUK 6:27-36">Luq. 6:27-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />« ‹Jaalo atika eeyyi! Naapha atika jibbi› hiyyendeexxa laqqine'een.<note caller="-" style="x"><char style="xo" closed="false">5:43 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lew. 19:18</ref>.</char></note> <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Ani kinni ha'noo hiyyane qici: naapha ha'nooka eeyye! Ha'no shorraakeeri'anna soodatte.<note caller="-" style="x"><char style="xo" closed="false">5:44 </char><char style="xt" closed="false"><ref loc="PRO 25:21-22">Mam. 25:21-22</ref>.</char></note> <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Tenne assitinoole iima hedheeke ha'nooke annixxe oose kaddinaan; Isi arishsho ifixxa fuggaaleeyyeteenna eloke manni'a fulchaan; isi qulliyeteenna cubbaaleyyetee xeena ifika gansiisaan. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Ha'no'o eeyyaakaara calla eetinoole, maa hira affine? Cubbaaleeyyetinna assita'neexxi tennendebaata? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Dayyuwwa ha'nooka calla nage'a aaxxinoole welekenaa'n saxxeexxa assitineechchi maachcho? Mageno ege'nebaak manninna tenne assa'neenexebaata? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Tennexxee iimik ha'nook Anni wo'make kaddeemmashshanni ha'nonna wo'make kadde!»<note caller="-" style="x"><char style="xo" closed="false">5:48 </char><char style="xt" closed="false"><ref loc="LEV 19:2">Lew. 19:2</ref>, <ref loc="LEV 19:18">18</ref>; <ref loc="LEV 18:13">Lew. 18:13</ref>.</char></note><verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s1">Hiyyeyete Uwwatixxe'e</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />«Manni ha'noo uudo'a ‹eloxxa ha'nooxxa huje› manni edo assitnoqqe'e, heqqedhdhe! Assitinoole iimike ha'noke anninaa'n hira alfitinaba'a.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />«Manji edo ulfaatatee ora ora'ninna Ayihudiinke magenooffachchotike mine duucchcha'n malagata ufuufisammake ifi uggudhdhammake mannisha ha'nonna hiyyeeyyetee uwwa uutina wodda leellatee hitineexxi iitta assitinoqqe'e; dhugaate ha'no'n ahaaso'a'ennen iitta assaak manni ifika hira alfe'een. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Ha'no kinni hiyyeeyyetee'e uwwa uutinaa wodda ha'noxxi middixxi anga uutaachcho ha'noxxi bita'ixxi anga midde egendoqqe'e! <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Uwwa ha'nooxxi sho'ikite kaddowwaal. Sho'ik assendeexxa ege'naak ha'nook anni sho'ik hira ha'no'a uwwaan.<verse eid="MAT 6:4" /></para>
  <para style="s1">Soodachcho Barachiisatixxee</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luq. 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />«Ha'no soodattinaa wodda, ifi uggudhdhaake mannishsha kaddinoqqe'e! Insa'ne manni insa'nee uudo'a hineexxi Muuseka seera barantammake minuwwaninna weldeena weldeenna'n uurrineexxi Mageno soodantaan. Dhugaate ha'no'n haaso'aannenni; insa'ne ifixxe hujeka hira edinseenni adhdhine'eeni.<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="LUK 18:10-14">Luq. 18:10-14</ref>.</char></note> <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Ha'no kinni soodattinaa wodda ifixxe kuta giddi'a e'yitineexxi leella'nebaake ha'nooke Annibaa soodatte; Sho'ik assendeexxa afaak Anni ha'nookinna hira ha'no'a uwwaan. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Soodattinaa wodda hiyyichcho xonbati insa'neexxi soodachcho insa'ne'a laqenda'neechcho labbammake, Mageno ege'nebaake mannishsha hiyyichcho lebbine lebbine hitinoqqe'e.<note caller="-" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="1KI 18:25-29">1 Moy. 18:25-29</ref>.</char></note> <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Ha'no kinni Anni ha'nook isoo'o soodattinebaa edi darre maachchi ha'no'a hasisaaxxa ege'neemmaxxee insa'nee fakkaatinoqqe'e.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />«Tennexxee hitina'ni soodatinnaa qici,</para>
  <para style="q1" vid="MAT 6:9">« ‹Iimate'n hexxetteke No'oke Annaa!</para>
  <para style="q1" vid="MAT 6:9">Summi atik woyyoomowwaal.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Mootumma atixxinna daggowwaal;</para>
  <para style="q1" vid="MAT 6:10">Fedhii atixxi iimate'n kaddeemmashshanni</para>
  <para style="q2" vid="MAT 6:10">iittanni buttate'ninna kaddowwaal.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Barratika no'oka budeena techcho no'o'a uwwi.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />No'onna no'oo balleessemmakeeri'a gattowwaal hinenneshsha</para>
  <para style="q2" vid="MAT 6:12">no'oxxa balleessa no'aa gattowwaal hiyyi.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Ookkone fuggichchanaa'n no'oo anjir malee'e</para>
  <para style="q2" vid="MAT 6:13">hega uudemate'n no'oo e'yishshoxxe'e.</para>
  <para style="q1" vid="MAT 6:13">(Mootumma, hunnatinna ulfinni</para>
  <para style="q2" vid="MAT 6:13">duuchchii woddi'a atiken; hamiin.)<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Moottumma, hunnanna ulfinni duuchchi woddi'a atiken, hamiin, hiyyaak yaadi mitte mitte edike Girikike maxaafuwwa'n afemaba'a.</char></note><verse eid="MAT 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />Ha'noo balleesseemakeeri'a gattowwaal hitinoole, iimik ha'nook Aninna ha'no'a gattowwaal hiyyaan. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Yaane kinn ha'no manniinxa balleesa gattowwaal hiyya gophphinoole iima hedheek ha'nook Anninna balleesa ha'nooxxa ha'noo'a gattowwaal hiyyabaan.<note caller="-" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="MAT 11:25-26">Mat. 11:25-26</ref>.</char></note><verse eid="MAT 6:15" /></para>
  <para style="s1">Agabo Goddoxxee Barachcho</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />«Ha'no agabo goddo hossinaa wodda ifi uggudhdhaak manni assammashsha lumbu hitinoqqe'e! Insa'ne agabo goddo hosa insa'neexxi ege'nendo'a alba ifike'n yaadotixxa bifa leellinshan. Dhugaate ha'no'n haaso'annenni iitta assakiir ifika hira alfe'een.<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="ISA 58:5">Isa. 58:5</ref>.</char></note> <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Ati kinni agabo goddo hossatoo wodda alba atika anshedhi; umo atike'ninna issati. <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />Tennenni agabo goddo hosa atixxa ege'neddaaki leellabaake atike Anna'nite malee'e wele manna'ni kinni sho'endeexxe kadda; sho'iki assendaaxxa afaaki atik Anninna atika hira ati'a uwwaan.»<verse eid="MAT 6:18" /></para>
  <para style="s1">Iimate'n Karra Tuu'latixxee</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />«Daameli balleessaba moodhalshetinna enqite moodhitaaba buttate'n karra ifi'a bukki assexxinoqqe'e.<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="JAS 5:2-3">Ya'i. 5:2-3</ref>.</char></note> <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Yaane kinni daamulinna balleessabaaba, moodhalshetinna enqite moortabaaba iimate'n karra ifi'a tuu'le. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Karra atixxi hexxeeba godob atikinna ookko hedhaan.<verse eid="MAT 6:21" /></para>
  <para style="s1">Bisiinka Ifa</para>
  <para style="r">(<ref loc="LUK 11:34-36">Luq. 11:34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />«Ille bisiinke xassan. Tennexxee ille atixxi fayyaxxe kaddoole bisi atik duuchchi ifake kadaan. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Ille atixxi fayya gophoole kinni bisi atik duuchchi dukkanate kadaan. Tennexxee ate'ni hedheek ifi dukkanate kadoole dukkanafa'i hittaxxeexxe dimma dukkana kadduta!<verse eid="MAT 6:23" /></para>
  <para style="s1">Galdumakee Wixixxi Hiyya Hasissabaaxxe Kaddeexxa</para>
  <para style="r">(<ref loc="LUK 16:13">Luq. 16:13</ref>; <ref loc="LUK 12:22-31">12:22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />«Mitti manji lame gooti'a erganjoke kada dande'abaan; mitte jibbaan, langaka eeyyaan, yookaan mittinbaa higeexxi langaka tuffataan. Iittanni ha'nona Magenokeenna maallaqakee'e ergatema dandeettinaba'a.<verse eid="MAT 6:24" /></para>
  <para style="s1">Wixixxi Hiyya Gophaa</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />«Tennexxee ani ha'no'n hiyyaane qici, hedho ha'nooxxee maachcho indanno maachcho ha'winanno, maachcho oddo'winanno? Hitina'n wixixxi hitinoqqe'e. Hedho itatenaa'n manjummatinna seemmatenaa'n saxxabaata? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Amme iimatixxa ci'a uude! Facaalsitaba, haa'mitaba'a gootarake'n tuu'litaba'a, kaddoo malee'e iimik Anni ha'nook isee itisaan. Ha'noota ci'atenaa'n lumosha saxxinabaata? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Isi ha'no giddii'n wixixxi hiyye ifixxe hojja'ni<note caller="+" style="f"><char style="fr" closed="false">6:27 </char><char style="ft" closed="false">Mitte ciqile hiyyendeexxi mitte mitte tika'n ifixxe wogga'n mitte barra hiyyende'een; </char></note> mitte ciqile lebatee'e dande'aak hedhee?<note caller="-" style="x"><char style="xo" closed="false">6:27 </char><char style="xt" closed="false"><ref loc="PSA 39:5-7">Far. 39:5-7</ref>.</char></note><verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />«Seemmatee mayee'e wixxixxi hitina? Badda'a giddika daraaro hitta nophpha'neexxa amme uude! Daraaruwwi elo'aba'a yookaan suuqedhaba'a. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Yaane kinn ha'no'n kulo Solomooni midde ifixxe durumma giddii'n mittinke daraar qicixxa midde oddo'webaan.<note caller="-" style="x"><char style="xo" closed="false">6:29 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1 Moy. 10:4-7</ref>; <ref loc="2CH 9:3-6">2 Odo. 9:3-6</ref>.</char></note> <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Techcho leeliteexxi soodo giirate'n gubattaaxxa anso Mageni iitta oddeesseechchinni ha'no amana xe'yiteek manni ha'no'a hitta caalchiseexxi oddeessa gophphata? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Tennexxee, ‹Maa indanno? Maa ha'winanno? Maa oddo'winanno?› hitina'ni wixixxi hitinoqqe'e! <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Mageno ege'nebaak manni tennee yaane duuchcha alfatee gongaan; ha'no kinni iima hedheek ha'nook Anni tinni duuchcha ha'no'a hasissaaxxa ege'ne'een. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Ha'no kinn edisineexxi Mageniixxa mootummanna qullumma isixxa halse! Hassinaaxxi yaane duuchchanna ha'no'a lebendaan. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Soodi'a wixixxi hitinoqqe'e! Soodo umi ifingee wixixxi hitaan; Mitte mittendi barra geltaaxxa umo ifingixxe rakko affe'en.»<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s1">Weleke'n Mura Hasissabaaxxa</para>
  <para style="r">(<ref loc="LUK 6:37-42">Luq. 6:37-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Lebeexxi Yessuusi hiyye haaso'ee qic, «Ha'no'n murendbaasha ayye'ninna murtinoqqe. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Welekee'e murtinemashann ha'no'ninna murendaan; iittanni safaritineegechcho'n ha'no'aanna saffarendaan.<note caller="-" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="MRK 4:24">Mar. 4:24</ref>.</char></note><verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />«Atixxe ille'n hedheeka utupha affebexxok atike dayyixxe ille'n hedheeka heenoka huura hitta affattota? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Atixxe ille'n utuphi hedhee'na'a atika dayyo ‹Atixxe ille'ni hedheeka heenoka huura atenaa'n hoyyo!› hitta hitato? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Ati ifi uggudhdhalli! Edissettexxi atixxe ille'ni hedheeka utupha hoyyedhi Ookkonechchinni udumi'a dayyi atikixxe ille'ni hedheeke heenoka huura hoyyatee'e ca'a assite'e affatton.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />«Worshi lekkati ha'noo hirbeessabashshanna illeema hige ha'no'o ga'mabaashsha qullitte yaane worshake'e uutinoqqe! Ha'nooxxa fiixa yaanenna booyyeti edo uggitinoqqe!<verse eid="MAT 7:6" /></para>
  <para style="s1">Soodatte, Harse, Ganganne</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luq. 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />«Soodatte, ha'no'a uwwendaan; halse alfitinaan; hulatanna ganganne ha'no'a banendaan. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Soodataakee duuchchi'a uwwendaan; halsaakiirinna alfaan; gangaanake hula banendaan.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />«Ha'noo giddii'n belti ifiki xalta kadhatoole; kinjo uwwaak anni hedhee? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Yookaan qulxu'me kadhatoole bofa isi'a uwwaata? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Eeganni ha'no elobaake manna kaddineexxi oose ha'nooxe'e eloxxa uwwa uwwiyyo egendinoole iima hedheek ha'nook Annifa'i iso'o soodataakeeri'a hittata sa'isseexxi eloxxa yaane uwwa gophata? <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Yoona ha'no'a assino'a eettinaaxa yaane duuchcha ha'nonna welekee'e asse! Muusek seerinna wabeeko barachchiisa'nexxi tennenden.<note caller="-" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="LUK 6:31">Luq. 6:31</ref>.</char></note><verse eid="MAT 7:12" /></para>
  <para style="s1">Cu'maxxanna Ba'laxxa Hula</para>
  <para style="r">(<ref loc="LUK 13:24">Luq. 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />«Cu'maxxe hula'n e'ye! Ba'netibaa'a e'yishshaaxi hula ba'laxen orikinna lumoken; ookko'a e'yaak manni heddoken. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Hedhotibaa'a geessissaaxxi hula cu'maxxen, orikinna xurreten; tenne hulanna alfaak manni heenoken.<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="JER 21:8">Erm. 21:8</ref>; <ref loc="DEU 30:19">Lan. 30:19</ref>.</char></note><verse eid="MAT 7:14" /></para>
  <para style="s1">Haqichchi Gumma Ifixxenni ege'nemaan</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luq. 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />«Dhariyye wabeekolenaa'n ifi heqqedhdhe! Insa'ne gedhebinxa ka'le oddo'wineexxi, gedhebo lanba'ne ha'nooba'a dangaan; insa'ne kinni giddo ninniffammaxxe yayyeshshaten.<note caller="-" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="EZK 22:27">Hiz. 22:27</ref>.</char></note> <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Insa'nee egendinaachi gumma insa'neexxenniten. Utetixxe haqqenaa'n woyinetixxi gumma yookaan weleennatena'ninna odiinxi gumma qocendaata? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Iittanni elok haqichchi eloxxa gumma gummisa; elobaak haqichchi kinni elobaaxxe gumma gummisa. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Elok haqichchi elobaaxa gumma gummisa dande'abaan. Ittanni elobaak haqqichi eloxxa gumma gummisa dande'abaan. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Eloxxa gumma gummisabaak haqichchi duuchchi woxemeexxi giirate'n hunemaan.<note caller="-" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="MAT 3:10">Mat. 3:10</ref>; <ref loc="LUK 3:9">Luq. 3:9</ref>.</char></note> <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Tennexxee manna insa'nexxe gummanni egendinaan.<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="MAT 12:33">Mat. 12:33</ref>.</char></note><verse eid="MAT 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />«Iima hedheeke anke annika fedhi assaaka malee, ‹Anke Gootta, anke Gootta› hiyyaak duuchchi mootumma iimixxa aagaakebaan. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Murettixxa barra heddi manni ane'e, ‹Anke Gootta, anke Gootta summi atikenn raaga haasonneennabaata? Summi atikinni fuggichcha hafuura fulchineenabaata? Summa atikenn heddo mambe'iinxa yaane hunjeennabaata?› hiyyaan. <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Ani kinn ookkonee baro insa'ne'e ‹Haranga ha'noo ege'nebe'no; ha'no xaqartiyye manni anenaan bayyatte!› hiyyannon.<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="PSA 6:8">Far. 6:8</ref>.</char></note><verse eid="MAT 7:23" /></para>
  <para style="s1">Cirrachchake'n Yookaan Rassate'n Ijaaremeek Minuwika Fakkeena</para>
  <para style="r">(<ref loc="LUK 6:47-49">Luq. 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />«Konnee hiyyichcho anka laqeexxi ajajemaak duuchchi mine ifika kinjoke'n hana ijaareeke beek manjo fakkaataan. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Xeeni ganeen, lola'ikinna lola'e, diidallotinna gande, ookkone minenna dhiibbe kaddo malee mini iikki rasati hana ijaaremeemmaxxe'e ibebaan. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Konnee hiyyichcho anka laqeexxi isi'a ajajemabaak kinni mine ifika cirrachchii hana ijaareke gowwa manjichcho fakkaataan. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Xeeni ganeen lola'ikinna lola'e, diidallotinna gandeexxi, mine ookkone'e dhiibbe. Minikinna hirbange'n ibe; ibenna hara butute.»<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Yessuusi tenne'e yaanuwwa haaso'exxi bire wodda ardi barachchiisaa isixxa jaje. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Insa'nee mambe'a asseechchi Isi Muuseke seerik barachchiisalluwwi barachchiisaammashshate kaddeebaang baalloomiike manjishsha insa'nee barachchiiseemmaxxeeten.<note caller="-" style="x"><char style="xo" closed="false">7:29 </char><char style="xt" closed="false"><ref loc="MRK 1:22">Mar. 1:22</ref>; <ref loc="LUK 4:32">Luq. 4:32</ref>.</char></note><verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s1">Yessuusi Soomo'eeka Manjichcho Fayyise</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Yessuusi koobatenaa'n dirree wodda heddi manni iso'o hordofe. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Ookkone wodda soomo'eek mitti manjichchi Yessusibaa dage. Isinna Yessuusi edo kumbu hiyyeexxi, «Ee, Gootta! Eettotole anee'e fayyisa dandeettaton» hiyye.<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Yessuusinna anga diriirisse ookkone manjo qaqqabeexxi, «Ate'e fayyisa eeyyaannen fayyi» hiyye. Manjichchikinna soomakenaa'n hirbange'n fayye. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Yessuusi konnee'e soomakenaa'n fayyeeka manjichcho, «Tenne yaane mitteke'n kuldoxxe'e! Yaane kinni martettexxi ifi qeesichchoke'ni leellishi! Fayya atixxi insa'ne'e dhuga kulate kaddaashsha Muuse ajajemmaka tolcha shiqishi!» hiyye.<verse eid="MAT 8:4" /></para>
  <para style="s1">Dhibba Lolinka Manna Akeekammake Manjichchixxa Amana</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luq. 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Yessuusi Qifirnahoomike qachcha'n e'yee wodda mitti Roomik dhibba loliinke mannik ajajalli isiba dageexxi, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />«Gootta erganji anki naafee shiilexxi mine diipheen» hiyye kadhate.<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Yessuusinna iso'n, «Ani dage iso'o fayyisannon» hiyye. <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Dhibba lolinka manna ajajammaki kinni Yessuusi'i «Goottaa, anke mine'ni e'yitota'a ani geyeennekebaan. Yaane kinn mitte hiyyichcho calla haaso'i! Erganji ankinna fayya fayyaan hiyye hisse haaso'e. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Lebeexxi, aninna baalloomiinke weli manni hunda ajajemaanneken; higgeen ani'a ajajema'neeka lolinka mannanna afeennen. Mitte ‹Me'i!› hiyyonnole me'aan; welekanna ‹Amo!› hiyyoonnole dagaan. Anka erganjonna ‹Konneechcho huji!› hiyyoonnole hujaan» hiyye.<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Yessuusi konne'e haaso'a laqe wodda, mambe'a hiyyeexxi isoo hordofammake manna'ni hiyyee qici, «Dhugaate ha'no'n haaso'aannenni, iita hexxeexxa lumoxxa amana afeeka mitte manjo midde Isira'eeli giddo afeebe'no. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Tennee kassi hiyye! Heddi manni borotenaa'ninna dhidhimakenaa'n dagaan. Abirihaaminni, Yisaaqinninna Ya'iqoobinni welti mootumma iimixxe'n itatee ofo'laan.<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="MAT 13:29">13:29</ref>. </char></note> <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Iimixxi mootumma alfan hiyyeme hedememmak manni kinn dukkanati giddo gadhi'a huinemaan. Ookko'o oodhishshatenna isso qarate kaddaan.»<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Yessuusinna ookkonee dhibba lolinka manna ajajammaka «Amana atixishsha ati'a kadduun; missiyyi!» hiyye. Erganji isikinna eettene yanna'inni fayye.<verse eid="MAT 8:13" /></para>
  <para style="s1">Yessuusi Elagopheeka Heddo Manna Fayyise</para>
  <para style="r">(<ref loc="MRK 1:29-34">Mar. 1:29-34</ref>; <ref loc="LUK 4:38-41">Luq. 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Yessuusi Pheexiroosike mine'n e'ye wodda Pheexiroosixxa ballo eebbishe giisa gophe'na'a dhiiphphee'na afe. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Anga isexxa qaqqabe wodda, hirbange'n eebbinji isee waale'na'a fayyite kexxeexxi Yessuusi'i keessunsite.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Hashshee wodda heddo fuggichchi hafuurinni abide'emeeka manna Yessuusiba'a iyyedange; Yessuusi hiyyichcho ifikenni fuggichcha hafuuruwwa fulche; ela gopheemmaka manna duuchchanna fayyise. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Tennee assati, wabeekichcha Issayaasi'n «Isi dhibo no'oxxa adhdheen; ela gonphe no'oxanna ba'edhe» hiyyemeemmak raagi muuxeme.<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="ISA 53:4">Isa. 53:4</ref>. </char></note><verse eid="MAT 8:17" /></para>
  <para style="s1">Yessuus Hordofa Laqqaak Hira</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luq. 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Yessuusi, heddi mann dageexxi isso'o qoqobe'na'a uudee wodda abbaayyaati widdi'a foofaashsha hordofeeyye ifixxa ajaje. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Eettene yanna'ni mitti Seeriink<note caller="+" style="f"><char style="fr" closed="false">8:19 </char><char style="ft" closed="false">tenne bakka'n kulemeek Seeri Muuseke seeran hiyyaten</char></note> barachchiisaalli Yessuusibaa dageexxi «Koo barachchisaallo, ati me'itattoobaa duuchcha atee hordofannon» hiyye. <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Yessuusinna «Jeedaluwwi bale ifixxe afee'eni; ci'atinna galdaaka mine afe'een; Manjiinki Belti<note caller="+" style="f"><char style="fr" closed="false">8:20 </char><char style="ft" closed="false">Manji belti hiyyaak hiyyichchi Yessuus ifi ye'aamake summamman.</char></note> kinn umo ifika midde uggaabi hedheba'a» hiyyeexxi hiisse haaso'e.<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Hordofeeyyeti giddi'ni mitti iso'o, «Gootta edise marennexxi anka anna moogo» hiyye.<note caller="+" style="f"><char style="fr" closed="false">8:21 </char><char style="fqa" closed="false">Moogo, </char><char style="ft" closed="false">Anni isik reyaa qico'n isoo'o gargareexxi moogo'a afe'eexxe halcha labbaan.</char></note><verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Yessuusi kinn ookkone hordoffanjo «Reyeeki manni ifika reyeeka manna mooqo'a waaldetteexxi ati ane'e hordofi!» hiyye.<verse eid="MAT 8:22" /></para>
  <para style="s1">Yessuusi Danbala'a Sammi Asse</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mar. 4:35-41</ref>; <ref loc="LUK 8:22-25">Luq. 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Yessuusi hobolo giddi'a e'ye wodda hordofeeyye isixxinna isinni welti me'ite. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Dedhange'n jabak danbala'i abbaayyate'ni ke'exxi hobolo lixisaa geye; ookkone wodda Yessuusi diipheemman. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Hordofeeyyetinna Yessuusibaa shiqqeexxi, «Goottaa, ba'neennen! No'o anjiri!» hitteexxi isoo dammassite.<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Isinna «Ha'no amana heeno'mite'ek mann mayye'e sodaatinaa?» hiyye. Ookkonechchi udumi'a diidallotanna abbayya xixe, lumoxxi samminna kadde.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Manni duuchchi lumo qico mamibe'a hiyyexxi, «Diidallotinna abbayya midde isi'a ajajenda'neeki kunni manji maa manjo!» hiyye.<verse eid="MAT 8:27" /></para>
  <para style="s1">Fuggichchi Hafuurinni Abidemeeka Lame Manna Yesuus Fayyise</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mar. 5:1-20</ref>; <ref loc="LUK 8:26-39">Luq. 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Yessuusi Galilixxa abbaayya foofeexxi Gergeessenoonike<note caller="+" style="f"><char style="fr" closed="false">8:28 </char><char style="ft" closed="false">wele tikaar Geerassenoon hitaan.</char></note> bogibaa dagee wodda fuggichchi hafuurinni abideme'eki lami manni hirreessakenaa'ni fulleexxi isini futti hiyye; Insa'nenna hara lumoo qico fuggichchake kandeemmaxxee ayyinna ookkone ora sa'a dande'aammabaan. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Insa'nenna «Koo Mageniinke Belto no'naa'n maa afeete? Yanna geltebaangi no'o abara uudissotaa daggettee?» hina'ni raarre.<note caller="-" style="x"><char style="xo" closed="false">8:29 </char><char style="xt" closed="false"><ref loc="JDG 11:12">Hay. 11:12</ref>; <ref loc="2SA 16:10">2 Sam. 16:10</ref>.</char></note><verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Insa'nenaa'n heenoo qico baayyatteek booncho'ni heddo booyye bobbaatemmaan. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Fuggichchi haafuuruwwi kinni «No'o fulchchitattexxe kaddoole, booyyuwwatibaa me'inannoshsha ergi!» hinexxi Yessuusi kadhate.<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Yessuusinna insa'nee «Me'ee!» hiyye. Tennexxee fuggichchi hafuuruwwi konne lame mannanaa'ni fuleexxi booyyete'ni e'ye. Booyye duuchchiinxi bowwa'inke iriganaa'ni didda'n abbayyaati giddo lixxee rerte. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Booyyetixxi allalisanonna baajjee qachchi giddi'a maritteexxi kaddeexxa yaane duuchcha odeessite. Fuggichchi hafuuri abideemmake manna'ni kaddeexxa yaane duuchchanna haasotte. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Ookkonechchi uduma qachchiinki manni duuchchi Yessuusi'i uudo'a fule; isoo uundee woddanna insa'neke boginaa'ni me'aashsha iso'o kadhante.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">Gogeeka Manjichcho Yessuus Fayyise</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mar. 2:1-12</ref>; <ref loc="LUK 5:17-26">Luq. 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Ookkonechchi uduma Yessuusi hobolote'ni ofoo'le'e abbayya fofeexxi ifike qachiba'a dage. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Ookko mannikkinna mitte gogeeka manjichcho rarette'ni dunkeexxi Isibaa iyyedange. Yessuusinna konne mannixxa amana uudeexxi, elagopheemmaka manjichcho, «Koo belto; mee co'o! Cubbo atixxi gattowwaali hiyyende'eni» hiyye.<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Ookkonne wodda Seeriinke barsiisanjuwwi giddii'ni mitte mitti, «Kunni manjichchi Magenoke'ni yowwichchinke afo'o fulchedhe'en» hityyeexxi godobi ifiki giddo hede.<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Yessuusinna heduma insa'neka ege'neexxi, «Mayye'e itta hexxexxa fuggoxxa yaane godobi ha'noki giddo heddinna? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />‹Cubbo atixxi gattowwaal hiyyende'en› hiyyiyyotena'inna ‹Kexxettexxi me'i!› hiyyiyyatenaa'n? Heente shollexxa? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Yaane kinni Manjinki belti butta tenne'ni cubbo biratika baallooma afeexxa egendino'a!» Ookkonee naafa manjichcho, «Kexxe'e rare atixxa dulkitettexxi mine atikibaa me'i!» hiyye. <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Manjichchikinna ke'eexxi mine ifikiba'a me'e. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Mannikinna tennee uude wodda saadeexxi Mageni iitta hexxexxa baalle manjoke uuwwexxe'e Mageno galateeffate.<verse eid="MAT 9:8" /></para>
  <para style="s1">Yessuusi Maattewoosi'i Ye'exxa</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mar. 2:13-17</ref>; <ref loc="LUK 5:27-32">Luq. 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Yessuusi ookko'ni ke'eexxi me'aa'na qaraxa qaraxaammaka Maatewoosi hiyyemaka manjichcho qaraxi qaraxemmamaake booncho'ni ofo'lee'naa afeexxi, «Ane'e hordoofi!» hiyye. Maatoosinna ke'eexxi isoo hordofe.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Ookkonechchi uduma Yessuusi Maatewoosike mine'ni itate'e ofo'leena'a heddi qaraxaammki manninna cubbaalleeyye manni dageexxi Yessuusinninna hordofeeyye ifixxenni welti itate'e ofoo'le. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Feerisito tennee uude wodda isixxa hordofeeyye «Barsiisanji ha'nook mayee qarxooletinna cubbaaleyyeti welti ita'nee?» hite insa'ne qorte.<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAT 15:1-2">15:1-2</ref>.</char></note><verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Yesuusunna tenne laqeexxi hiyye hiisse haaso'ee qici, «Elagophpheeke mann'ate kaddoole malee'e fayyaake manni'a ci'leessi hasisabaan. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Yaane kinni ‹Ani tolchake kadebaak gattowwaalite eeyyannon› hiyyendeexxi borreessendeexxi maa kaddeexxa martineexxi qoritine wo'me; ani dagennechchi cubbaaleyyete malee'e qulliyye ye'onnaa dagebe'non» hiyye.<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Hos. 6:6</ref>; <ref loc="MAT 12:7">Mat. 12:7</ref>. </char></note><verse eid="MAT 9:13" /></para>
  <para style="s1">Agabo Goddo Hosatixxe Shiqeeka Qortuma</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mar. 2:18-22</ref>; <ref loc="LUK 5:33-39">Luq. 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Eettene yanna'ni Yohaannisixxi hordofeeyye Yessuusiba'a dageexxi, «No'o Feerisito duuchchii wodda agabo goddo honsaannen. Hordofeeyye atixxi agabo godo hosa'nebaachchi kinni mayeete?» hiteexxi iso'o qorte.<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Yessuusinna insa'ne'a hiisseexxi hiyyee qic, «Waajubbichchi insanni'ni welti hedhe'naa aadhatixxe barraki jaaluwwi yaada hasissaata? Yaane kinni waajubbichchi insa'nenaa'ni aadhdhemmaxxe yanna daggaan; ookkone wodda insa'nee agabo goddo honsaan.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />«Fedheek dullatte seemma'ni haarooxxa seemma erbaak hedhebaan. Erbeexxe kaddoole kinni haaroxxi erbe dullatte seemma dartaan; darenishsha iittinna edi qici irra saxxeexxe kaddaan. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Iittanni fedheeki dullate qalqallo'ni reefika woyyinetixxa booka uggaaki hedhebaan; uggeexxe kaddole kinni; qalqallottinna dhoottaan; iikki ugginemmaki woyinetixxi booka dunendaani; qalqallotinna la'oo uuttabaaxxe kaddaan. Haarooka woyyinetika bulibulo haaroxxe qalqallo'n uggiyyote hassisaan. Iitta assemoole lamingeechchi elo qico heqqemmeexxi hedhaan» hiyye.<verse eid="MAT 9:17" /></para>
  <para style="s1">Rerteexxa Beltichonna Munde Dunendammaxxa Manjichcho</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mar. 5:21-43</ref>; <ref loc="LUK 8:40-56">Luq. 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Yessuusi tenne'e haaso'a'nenige'n mitti galchalli dageexxi Yessuusixxe lekka'n ibeexxi, «belto anxi ta'a reriteeni. Daggeetteexxi anga atixxa ise'ni hana uggi, isenna fayyitaan» hiyye. <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Yessuusinna ke'exxi manjichchiinxa duuka me'e; hordofeeyye isixxinna isinni welti me'ite.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Tommenna lame wogga duuchcha munde duneenidaa'na'a rakkattaammaxxi manjichcho mitte ookkone wodda Yessuusi udumi'ni dageexxi isixxe seemmaka handaara tuqqe.<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="NUM 15:38">Lak. 15:38</ref>; <ref loc="LEV 22:12">Lew. 22:12</ref>.</char></note> <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Tennenna itta assiteechchi, «Seemma isixxa midde anga anixxenni tuqonoole fayyannon» hite'e heddeemmaxxeeten. <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Yessuusinna wirri hiyye'e isse'e uudeexxi, «Mee co'o anxe belto; amana atixxi atee'e fayyisee'en» hiyye. Manjichchotinna ookkone hiribba'ninn fayyite.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Ookkonechchinni udumi'a Yessuusi ookkone galchalke minibaa geyee wodda suusu'le ufuuffa'n hunbaashsha'neeka manna uudeexxi, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />insa'ne «Duuchchingi kabaa'n ke'we! Belto diiphphee'eni malle'e rerteebaan» hiyye. Yaane kinni insa'ne iso'ni osolle. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Manni fulechchi uduma beltichcho hexxeemmaba'a Yessuusi e'yeexxi anga beltotixxa abide wodda iimi'a kexxe. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Tenne yaanexxi odo boga ookkone duuchcha'n gelte.<verse eid="MAT 9:26" /></para>
  <para style="s1">Yessuusi Lame Balla'uwwa Fayyise</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yessuusi ookko'n fuleexxi me'aneege'n lami balla'i «Daawwitike belto, maganneten no'o'a marar!» hina'ni raara'n iso'o hordoffe.<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Yessuusi mini'a e'ye wodda kunni balla'i manni isibaa'a shiqe. Yessuusinna, «Ani fayyisate'e dande'annoxxa amanadinaa?» hiyye insa'ne'e qore.</para>
  <para style="p" vid="MAT 9:28">Insa'nenna, «Eetti, Gootta» hineexi hiissine haasonne. <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Ookkonechchinn uduma Yessuusi anga ifixxenni ille insa'nexxa qaqqabeexxi «amanadinemashanni ha'no'a kaddowwaal» hiyye. <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Ille insa'nexxinna banendeen. Yessuusi kinni, «Tenne yaane fedheeke'ninna kuldinoqqe!» Hiyye jabeesseexxi insa'nee ajaje. <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Insa'ne kinni ookkone boga duuchcha'n Yessuusi gurra oodessine.<verse eid="MAT 9:31" /></para>
  <para style="s1">Yessuusi Mitte Afo'o Duudeka Manjichchi Fayyiseexxa</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Ille bandeemmak iikki manni fuleexxi me'e wodda weli manni kinn fuggichchi hafuur abidee'na'a afo'o duude'eka manjichcho Yessuusiba'a idange. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Fuggichchi hafuur fuleechi uduma'a afo'o duudemmak iikki manjichchi haaso'e. Manni kinn, «Iita hexxeexxi yaane Isira'eelike boga'n hara leellite egendebaan» hina'ni saande. <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />Feerisito kinni, «Isi fuggichcha hafuura fulcha'neek fuggichchi hafuurke akeekisanjike summitte» hiyye.<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="MAT 10:25">10:25</ref>; <ref loc="MAT 12:34">12:34</ref>; <ref loc="MRK 3:22">Mar. 3:22</ref>; <ref loc="LUK 11:15">Luq. 11:15</ref>.</char></note><verse eid="MAT 9:34" /></para>
  <para style="s1">Yessuusi Ardakee'e Marare</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yessuusi Ayihudooti bukki hiyyaamaba barsiisa'n Mageniixxe mootummaxxa wengeele kula'n, arda garar gargar hedheeke dhukkubika fayyisa'n qachchuwake'ninna olla'uwwa duuchcha'n marema'nemman.<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat. 4:23</ref>; <ref loc="MRK 1:39">Mar. 1:39</ref>; <ref loc="LUK 4:44">Luq. 4:44</ref>. </char></note> <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Ardi allalisano afebaake gedhebishsha wixxixhiyye makkiyeena afee wodda insa'ne'a marare.<note caller="-" style="x"><char style="xo" closed="false">9:36 </char><char style="xt" closed="false"><ref loc="NUM 27:17">Lak. 27:17</ref>; <ref loc="1KI 22:17">1 Moy. 22:17</ref>; <ref loc="2CH 18:16">2 Odo. 18:16</ref>; <ref loc="EZK 34:5">Hiz. 34:5</ref>; <ref loc="ZEC 10:2">Zek. 10:2</ref>; <ref loc="MRK 6:34">Mar. 6:34</ref>. </char></note> <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Tennexxee Yessuusi ifixxa hordofeeyye'n hiyyee qici, «Bukki assendaaxxi midha lumoxxen, bukki assaki manni kinni shiixxoken. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Tennexxe hujalluwwa Gootti ookkene midha bukka assatike ifike booncho'n ergaasha iso'o kadhatte» hiyye.<note caller="-" style="x"><char style="xo" closed="false">9:38 </char><char style="xt" closed="false"><ref loc="LUK 10:2">Luq. 10:2</ref>.</char></note><verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s1">Tommenna Lame Hordofeyye</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mar. 3:13-19</ref>; <ref loc="LUK 6:12-16">Luq. 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Yessuusi tommenna lame hordofeeyye ifibaa ye'eexxi fuggichcha hafuuruwwa fulchinaashshanna gargar hexxeexxa dhibo fayyinsaashsha insa'ne'e baalloonse. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Eettene tommenna lame ergameeyyeke summi konnechchi butta hedheeken: siree Pheexiroosi hiyyemeek Simi'ooni, dayyi isiki Indiryaasi, Zebidewoosixxi oose Ya'iqoobi dayyi isik Yohaannisi, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filiphphoosinna Bertelomewoosi, Toomaasinna qaraxammak Maatoosi, Ilfiyoosik belti Ya'iqoobinna Taadewoosi, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Hinaafalli Simi'ooni Yessuusii'i sa'isse uwweemmak Asiqorootuke Yihudamman.<verse eid="MAT 10:4" /></para>
  <para style="s1">Yessuussi Tommenna Lame Hordofeeyye Ergeexxa</para>
  <para style="r">(<ref loc="MRK 6:7-13">Mar. 6:7-13</ref>; <ref loc="LUK 9:1-6">Luq. 9:1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Yessuusi tennee tommenna lame hordofeeyye hiyya'ni ajaje ergee qici: «Isra'eltote kadebaake manniba'a martinoqqe'e Semaariyaatotike qachchiba'anna e'yitinoqqe'e! <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Ookko martinaaxxa bakka gedhebiinsha ba'eeke Isira'eelike ardibaa marre! <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Maritineexxi, ‹Iimatixxi mootumma shiqe'en› hitinaa'n lalabbe!<note caller="-" style="x"><char style="xo" closed="false">10:7-15 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">Luq. 10:4-12</ref>. </char></note> <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Elagopheka fayyise! Reyeeka ke'ise! Soomo'eka manna ca'a asse! Durriisa fulchee! Tola adhdhitinemmalcho tolanga uwwe! <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Worqe yookaani birretika siblijo yookaani sageettotika sibiljo ha'noke subba'ni e'yexinoqqee. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Hujalloke ita hasissaaxxe kaddeemmaxxe me'itinaa wodda jijidhatika subba, yookaan seemma yookaan kophe yookaan siqqo iyyexxinoqqee.<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 Qor. 9:14</ref>; <ref loc="1TI 5:18">1 Xim. 5:18</ref>. </char></note><verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />«Maritinaake qachcha'ni yookaani maritinaake olla'a'ni ha'no'o adhdha eeyaa manjo affee! Booncho ookkone waalidineexxi weleba'a me'itinna qico'ni ookkonni turre! <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Manjiinke minibaa e'yitinaa wodda nage'a aadhdhe! <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Miniinki hadi nage'a aadhoole, nage'i ha'noki insa'neni welti hedhaani; adhdhaa gophoole kinni nage'i ha'nook illeema ha'no'a higaan! <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Ayyinna ha'noo adhdha gophoole yookaan haasotinaaxxa laqa gophoole mine isikinaa'n yookaan isike qachchinaa'n fuldinaa wodda lekka ha'nooxxenaa'ni bukko ganga'nitine fulle.<note caller="-" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Erga. Huj. 13:51</ref>. </char></note> <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Dhugaate ha'no haaso'aannen, murittetixxa barra Mageni ookkone qachchi irra Soodomikenna Gomorake qachchi'a murte shollexxaan.<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 11:24">Mat. 11:24</ref>; <ref loc="GEN 19:24-28">Dada. 19:24-28</ref>. </char></note><verse eid="MAT 10:15" /></para>
  <para style="s1">Goottinxe Daga'a Ediseexxi Kaddaaxxa Rakko</para>
  <para style="r">(<ref loc="MRK 13:3-13">Mar. 13:3-13</ref>; <ref loc="LUK 21:12-17">Luq. 21:12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />«Yessuusi ookkoni lebeexxi laqqe! Ha'no'o gedhebiinsha yayyetixxe oddo'ni erigaannen; tennexxee ha'no bofiinsha qarooyyetenna guugenjotishsha ba'lake kadde.<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="LUK 10:3">Luq. 10:3</ref>. </char></note><verse eid="MAT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17" />«Manni ha'no'o murittete'e sa'isseexxi uwwaan. Ifixxe magenooffattammaxxe bakka'ni ha'no'o jadhanfaan; tennexxe insa'nenaa'ni heqqedhdhe!<note caller="-" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">Mar. 13:9-11</ref>; <ref loc="LUK 12:11-12">Luq. 12:11-12</ref>; <ref loc="LUK 21:12-15">21:12-15</ref>. </char></note> <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Anxe buuto'a galchammakiiriba'anna moyanjuwwinba'a adhdhendinaan; insa'ne edonna Ayihudake kadebaake manni edo dhugaa kuldinaake kaddinaan. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Manni muritetibaa ha'noo iyyemaraa wodda maa haasonnanno yookaan hitta Yaanemmanno? Hiyyiyyoti wixixxi hitinoqqe; eettenne yanna'ni hitta hitinaaxxanna hitta haasottinaaxxi ha'no'a uwwendaan. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Ha'no'n hedhe haaso'ak iimike ha'nooke annike Hafuura malee'e ha'notebaan.<note caller="-" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="MRK 13:12">Mar. 13:12</ref>; <ref loc="LUK 21:16">Luq. 21:16</ref>. </char></note><verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />«Manji dayyo ifinga reyotee'e sa'isse uwwaan ittanni anni belto ifika reyote'e sa'isse uwwaan. Oosetinna hado ifike'n kexxaan; insa'neenna shiltaan. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Anxe buuto'a manjo duuchcha'n gibendinaan; yaane kinn muuxamii qico'ni jabaate uurraak isi anjirema.<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="MAT 24:9">Mat. 24:9</ref>, <ref loc="MAT 24:13">13</ref>; <ref loc="MRK 13:13">Mar. 13:13</ref>; <ref loc="LUK 21:17">Luq. 21:17</ref>. </char></note> <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Qachcha mitte'n rakko ha'no'n geessinso'ole wele qachchiba'a baaje! Dhugaate ha'no'n haaso'anneni Manjink Belti ille iima higeexxi dagaaqico'n Isira'eelike qachcha duuchchibaa geltinabaan.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />«Barataak ifike barsiisanjonaa'n sa'abaan; erganjikinna gootta ifikenaa'n sa'abaan.<note caller="-" style="x"><char style="xo" closed="false">10:24 </char><char style="xt" closed="false"><ref loc="LUK 6:40">Luq. 6:40</ref>; <ref loc="JHN 13:16">Yoh. 13:16</ref>; <ref loc="JHN 15:20">15:20</ref>. </char></note> <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Barataak iso'o barsisammakishsha, erganjikinna ifike goottishsha kadiyyo isoo gelte'een. Minininka anna Bi'eelzebuuli!<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="ft" closed="false">Be'eelzebuuli hiyya duursiinke umo hiyyaten </char></note> hineexxi ye'noole isika mini hado konnenaanni sa'edheeke elobaake summinni ye'e'naan.<note caller="-" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mat. 9:34</ref>; <ref loc="MAT 12:24">12:24</ref>; <ref loc="MRK 3:2">Mar. 3:2</ref>; <ref loc="LUK 11:15">Luq. 11:15</ref>. </char></note><verse eid="MAT 10:25" /></para>
  <para style="s1">Ayee'e Sodaatiyyo Hasissaaxxa</para>
  <para style="r">(<ref loc="LUK 12:4-7">Luq. 12:4-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />«Tennexxe'e meenni insa'nee sodaatte! Feeteexxi ta'a buqendeexxi yaane leellitabaaxxi sho'ondeexxi yaanenna ege'nedabaaxxi hexxebaan. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Tennexxee ani dukkanate'n ha'no'n kulannoxxa ha'no ifake'n haaso'we; hashashoti laqqineexxa ha'no mini hana uurritine lallabbe. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Maala shiyaaka lubbo kinni balleessa dande'abaaka manna meenni sodaatte; konnee irra maalakanna lubbo gahanemixxe giira'n balleessa dande'aaka iso'o sodaatte! <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Lame diillise mitte sanite'n gurgurenda'neexxebaata? Kaddo malee'e iimike ha'nooke annike fedhi belo diillise mitte midde butta ibbe gattabaan. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Ha'nooke umik ordichchi midde laako'eemedheeken. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Yoona mee sodaatte! Heddo diillisuwwanaa'n ha'note saxxinaan.<verse eid="MAT 10:31" /></para>
  <para style="s1">Kirisitoosixxa Dhuga Kuliyyo</para>
  <para style="r">(<ref loc="LUK 12:8-9">Luq. 12:8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />«Manjinii edo ani'a dhugaa kulaake duuchchi'a aninna iimate'n hedheeke anke anni edo isi'a duga'a kulannon. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Manjin edo anee'e waakkataaka manna duuchcha kinn, aninna iimate'n hedheeke anke anni edo isoo waakkatannon.<note caller="-" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="2TI 2:12">2 Xim. 2:12</ref>. </char></note><verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />«Ani buttate'n dagennelchi buttate'n nage'a idagona'ate ha'no'n labboqqe! Ani bagedo idagonate malee'e nage'a idagonaa'a dageebe'non. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Ani dagennelchi</para>
  <para style="q1" vid="MAT 10:35">« ‹Belti annake'n</para>
  <para style="q2" vid="MAT 10:35">belto amate'n</para>
  <para style="q1" vid="MAT 10:35">Beltiinxa beltiinxe ama'n diinummati ke'issonnaaten.<verse eid="MAT 10:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36" />Manjoke ifing minig hadi naaphake kadaan.›<note caller="-" style="x"><char style="xo" closed="false">10:36 </char><char style="xt" closed="false"><ref loc="MIC 7:6">Mik. 7:6</ref>. </char></note><verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />«Ani irra anna ifika yookaan ama ifixxa eeyyaak manji duuchchi anke kada dande'aba; ani irra ifika belto yookaan ifixxa belto eeyyaak anke kada dande'aba'a. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Ayyinna umo ifikixxa fanno dulkeexxi ane'e hordofabaak manji anke kadatee geyaba'a.<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="MAT 16:24">Mat. 16:24</ref>; <ref loc="MRK 8:34">Mar. 8:34</ref>; <ref loc="LUK 9:23">Luq. 9:23</ref>. </char></note> <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Lubbo ifixxa gatlso'a halsaak duuchchi lubbo ifinxe balleessaan. Lubbo ifixxa anixxee buuto'a gophaak duuchchi kinni lubbo ifixxa alfaan.<note caller="-" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="MAT 16:25">Mat. 16:25</ref>; <ref loc="MRK 8:35">Mar. 8:35</ref>; <ref loc="LUK 9:24">Luq. 9:24</ref>; <ref loc="LUK 17:33">17:33</ref>; <ref loc="JHN 12:25">Yoh. 12:25</ref>. </char></note><verse eid="MAT 10:39" /></para>
  <para style="s1">Hordofeeyyetika Hira</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />«Ha'noo adhdhaak ane'e adhdhaan. Ane'e adhdhaakinna ane'e ergeeka adhdhaan.<note caller="-" style="x"><char style="xo" closed="false">10:40 </char><char style="xt" closed="false"><ref loc="MRK 9:37">Mar. 9:37</ref>; <ref loc="LUK 9:48">Luq. 9:48</ref>; <ref loc="LUK 10:16">10:16</ref>; <ref loc="JHN 13:20">Yoh. 13:20</ref>. </char></note> <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Wabeeka wabeekiinke summinni adhdhaake wabeekiinke hira alfaan; qullichcha isixxi qullumma adhdhaak qullichinka hira alfaan. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Dhugaate ha'no'ni haaso'annen anxe hordofeye kade'eke giddii'n shiixxoke mitti'a qasha qiidaka wode'e uwwaak manji midde tola gatabaan.»<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s1">Xammaqaammake Yohaannisibaa'n Ergemeeka Manna</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luq. 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Yessuusi ifixxe tommena lame hordofeeyye ajaja uwwe barsiisateenna lallabatee bira hedheeke qachchuwwibaa me'e. <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />Xammaqaammak Yohaannisi usurriinke mine'ni hedhe Kiristoosi huja'neexxa huje laqeexxi ifixxa lame hordofeeyye Yessuusiba'a ergeexxi, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />«Daga'neen hiyyendeettak atete moo? Yookaan weleke heqinanno?» hiyyeexxi Yessuusi'i qorsiise.<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Yessuusinna insa'ne'n hiyyeexxi hiisse haaso'ee qici, «Martineexxi uuddineexxanna laqqine'exxa Yohaannisi'n kulle. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Balla'uwwi afaan, naafuwwi toggi hiyyaan, soomo'emmakiirinna fayyaan, mansha laqammabaakiirinna laqaan, reyeek mannuwwi ke'aan, hiyyeeyyeteenna wengeele lallabendaan.<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">Isa. 35:5-6</ref>; <ref loc="ISA 61:1">61:1</ref>.</char></note> <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Anxe buuto'a guggufatabaak eebbisemeedheeken» hiyye.<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Yohaannisixxi hordofeeyye me'iteechchi uduma, Yessuusi Yohaannisixxee mannake'n haaso'a safee hiyyee qici, «Qiilla gammooje'n maachcho uudino'a fuldine? Diidallo lele'missa'neeka shonbooqo uuddino'a fuldinee? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Yookaan Maachcho uudino'a fuldine? Dancha seemma oddo'weeka manjo uuddino'atema'a? Dancha seemma oddo'waakir moyanjuwwiinke mine'ni hedhaan. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Yookaan maachchota uudinno'a fuldine? wabeeka uudateetemmo? Eetti wabeekakenaa'n sa'aaka uudino'aaten. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Isi, ora atika ati'a fiyaashsha</para>
  <para style="q1" vid="MAT 11:10">« ‹Ati edo ora atika ati'a qophpheeso'a;</para>
  <para style="q2" vid="MAT 11:10">ati ediddarre arganjo anka ergannon› hiyyemeexxi borreeseemeemmak manjon.<note caller="-" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mil. 3:1</ref>.</char></note><verse eid="MAT 11:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Dhugaate haaso'annen melaalletena'n ilemeeke manna duuchchanaa'n xammaqallo Yohaannisii'i sa'aak hara hedhebaan; yaane kinni Mageniixxe mootomma'n duuchchingenaa'n shiixxedhaak iso'o sa'aan. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Xammaqammak Yohaannisike baronaa'ni saffe'e telchi qico'n mootumma Mageniinxi jaba qicinni dhiibendaan.<note caller="+" style="f"><char style="fr" closed="false">11:12 </char><char style="fqa" closed="false">Dhiibendaan </char><char style="ft" closed="false">Dhiibemanna wo'laancho abixxa hassissaaxxa fuggoxxa hunnuwwa xa'niteexxi eettene hega uushsho sa'atee'e aammaange assitaaxxe aammaangngumatixxe wo'laanchon.</char></note> Jaba qico'ni cichcheekiirinna isee alfaan. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Wabeeko duuchchanna Muuseke seerinaa'n Yohaannisike bari qico'ni raaga haasoote'een.<note caller="-" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="LUK 16:16">Luq. 16:16</ref>.</char></note> <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Insa'ne hina'neexxa ha'no adhitina'noole Daga'neen hiyyemeeki Eelyaasi konne Yohaannisiten.<note caller="-" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="MAL 4:5">Mil. 4:5</ref>; <ref loc="MAT 17:10-13">Mat. 17:10-13</ref>; <ref loc="MRK 9:11-13">Mar. 9:11-13</ref>. </char></note> <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Mansha afeeki hedhoole laqowwaal.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />«Konne barika manna mayiik fakkeessanno? Insa'ne dikko giddo ofoldeexxi jaaluwwa ifika yexxa'ni,<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />« ‹Suusu'le ha'no'a ufuufennen,</para>
  <para style="q2" vid="MAT 11:17">ha'no kinn sirbitinebaan;</para>
  <para style="q1" vid="MAT 11:17">Wi'lishsha wi'lishshine'een</para>
  <para style="q2" vid="MAT 11:17">ha'no kinni ooxxinebaan› hitaammaxxe oose fakkaattaan.<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />Xammaqalli Yohaannisi ita'nebaakinna ha'wanebaak ha'nooba'a dagee wodda, ‹Kunni fuggichchi hafuurinni abidemedheeken› hine. <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Manjink Belti kinni ita'ninna ha'wa'n dagee wodda ‹Kunni itallokenna ha'walloken; qaraxammake mannikenna cubbaaleeyyetik jaalon› hine. Mageniinke beekumi huje ifixxenni leelle» iso hine.<verse eid="MAT 11:19" /></para>
  <para style="s1">Amanagophemmake Qachchuwwa'n Haaso'endeexxa Daabachcho</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luq. 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Yessuusi heddo mambe'a isi giddo hujeme'na'a aadde aaga gopheeka qachchuwwa hiyya'ni daabbatee qici, <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />«Aannee ati'a koo Korraziinike qachcha! Aannee ati'a koo Beete Sayidake qachchaa! Ha'no giddo assemeek mambe'uwwi Xiroosikenna Sidoonake qachchuwwa'n assemeele yaaddotixxa seemma oddo'weexxi bululo ifi'ni fiffilxeexxi edonni aadde aagamman.<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">Isa. 23:1-18</ref>; <ref loc="EZK 26:1-28:26">Hiz. 26:1—28:26</ref>; <ref loc="JOL 3:4-8">Iyu. 3:4-8</ref>; <ref loc="AMO 1:9-10">Amo. 1:9-10</ref>; <ref loc="ZEC 9:2-4">Zek. 9:2-4</ref>.</char></note> <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Tennexxee ani ha'no'n kulo murtetixxa barra ha'no'a irra Xiroosikenna Sidoonake qachchi uwwemaka mura woxxa sholledhaan. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Ati kinni Qifirnahoomi! Umo atika iimati qico'ni lummissotta'a hassette? Si'oolixxe giddo hundatto; ati giddo hujemeeke mambe'i Soodomi'n hujeme'exxe kaddeele iikki qachchi telchi qico'ni hedhamman.<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">Isa. 14:13-15</ref>; <ref loc="GEN 19:24-28">Dada. 19:24-28</ref>.</char></note> <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Yaane kinni ani ate'ni murtetixxa barra ati'a irra xixichchi Soodomi'a sholledhaan» hiyye.<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="MAT 10:15">Mat. 10:15</ref>; <ref loc="LUK 10:12">Luq. 10:12</ref>. </char></note><verse eid="MAT 11:24" /></para>
  <para style="s1">Yessusinaa'n Afendaaxxa Hafuuradhdha</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luq. 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Ookkone wodda Yessuusi hiyyee qici, «Anke anna! Iimikinna buttik Gootta! Tenne'e yaane beekkoletenaa'ninna ege'nemeeke mannanaa'n shoxxettexxi annoolete'n ifisetaxxe ate'e galateeffataannen. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Eeti anke Anna! Tenne assiyyotee atixxe eloxxe fedhe kadde'en.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />«Anki anni duuchchiinxa yaane ani'a uwwe'een; Annake kadoole malee'e Belto ege'naak hedhebaan; ittanni Beltoke kaddoole malee Anna ege'naak hedhebaan; Belti eeyyeexxi leellisheke kadoole malee'e Anna ege'naak hedhabaan.<note caller="-" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="JHN 3:35">Yoh. 3:35</ref>; <ref loc="JHN 1:18">1:18</ref>; <ref loc="JHN 10:5">10:5</ref>.</char></note><verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />«Ha'no ba'oo ha'urteek duuchchi anibaa amme! Ani ha'noo hafuura adhdhisannon. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Ani ba'lakenna shaqqake kadeennaxxe'e qanbara anka dulkitineexxi anenaa'ni baratte! Lubbo ha'nooxxe'e hafuura adhdhitinaan.<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="JER 6:16">Erm. 6:16</ref>.</char></note> <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Qanbari anki ha'urabaaken; ba'oo anxinna shollaxxen» hiyye.<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s1">Edi Sanbatixxee Shiqeeka Qortuma</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mar. 2:23-28</ref>; <ref loc="LUK 6:1-5">Luq. 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Eettene yanna'n Yessuusi edike sanbatiinxa barra midhatike fichchi giddii'ni sa'a'naa hordofeeyye isixxi solo'witeemmaxxee tisha qushshexxa'n itate'n kexxe.<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="LEV 23:25">Lew. 23:25</ref>. </char></note> <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Feerisito tennee uude wodda Yessuusi'i, «Hordofeeyye atixxi Edike Sanbatixxa barra hoyyendeexxa yaane mayee'e assite?» iso'o hiyye. <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />Yessuusinna hiissexxi, «Daawwitinna isinni welti hedhemmak manni solo'we wodda assineexxa yaane haasessitineebaa?<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 Sam. 21:1-6</ref>. </char></note> <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Daawwiti Mageniinke mine'ni e'yeexxi, qeese malee'e isi yookaan isinni welti hedhemmak manni ito'a eeti uwwendebaaxxa eettene woyyitte ita ite.<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">Lew. 24:9</ref>. </char></note> <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Yookaan qeesi edi Sanbatixxa barra Galmi giddo Edika Sanbata ulfeesa gonphee'naa balleessate insa'ne'n kaddabaaxxa Seeriinke Maxaafinaa'n haasessitine'ebaata?<note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="NUM 28:9-10">Lak. 28:9-10</ref>. </char></note> <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Yaane kinni Woyyichcha Galma sa'aak kaba hedheexxa ani ha'no'n kulaannen. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />‹Ani tolchi irra gattowwaalite eeyyannon› hiyyaaka maxaafiinka hiyyichcho qalli hitineexe kaddeele balleessa afebaake manna'n murtinaammabaan.<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="MAT 9:13">Mat. 9:13</ref>; <ref loc="HOS 6:6">Hos. 6:6</ref>.</char></note> <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Wele dhiissinni Manjiink Belti edike sanbatike Gootta» hiyye.<verse eid="MAT 12:8" /></para>
  <para style="s1">Yessuusi Anga Gogeekka Manjichcho Fayyise</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mar. 3:1-6</ref>; <ref loc="LUK 6:6-11">Luq. 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Yessuusi ookko'ne ke'eexxi insa'neeke magenooffachchotike mine'n mare. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Ookko'o anga gogeeki mitti manjichchi hedhemman. Yessuus ku'latee buutoo haseemmak mitti mitti manni «Edike sanbati baro ela gopheeka fayyisatee eetti uwwendaa?» hiyyeexxi Yessuusi'i qore. <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />Yessuusinna hiisseexxi, «Ha'no giddii'n mitte beltanjo afe'eek edike sanbatixxa barra gedhechchi ikki balete'n ibe'exxe kaddoole baletenaa'n harkiseexxi falchabaak ayyete hedhe?<note caller="-" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="LUK 14:5">Luq. 14:5</ref>.</char></note> <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Yoona beltanjot irra manji caalabaataa? Tennexxe edisanbatixxa barra eloxxa assatee'e eetti'i uwwende'een» hiyye.<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Ookkonechchinn uduma Yessuusi ookkone manjichcho, «Anga atixxa diriirisi!» hiyye. Isinna diriirise wodda angatinna isixxe wele angashsha kadde. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Feerisito kinni ookko'ni fuldeexxi Yessuusi'i hitta assitee shiltaaxxa weli mari'atte.<verse eid="MAT 12:14" /></para>
  <para style="s1">Mageni File'eeka Erganjo</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Yessuusi kinni eettene iso shinno'a mari'anteemmaxxa ege'neexxi ookko'ni gamake'n hige. Heddi ardinna iso'o hordofe; elagophe'eeka manna duuchcha fayyiseexxi <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />isi ayyete kadeexxa kullabaashanna jabeesseexxi insa'nee ajaje. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Tinninna kaddeechchi wabeek Issayaasi haaso'emmak raagi muuxemo'aten; kunninna<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />«Kunnise ani fi'lennekinna</para>
  <para style="q2" vid="MAT 12:18">eeyyanekinna iso'ni gammadaanneki anki eriganji isoten;</para>
  <para style="q1" vid="MAT 12:18">Hafuura anka iso'ni uggannon;</para>
  <para style="q2" vid="MAT 12:18">isinna murte anixxa gosa gosake arduwwi'a kulaan.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Isi moromabaan,</para>
  <para style="q2" vid="MAT 12:19">cancaba'a, hafuurakanna orake'n laqisaba'a.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Dhugaa assa atixxa injifachchotee geesisaa qico'ni</para>
  <para style="q2" vid="MAT 12:20">cancanemeeka shonbooqo midde enqabaan</para>
  <para style="q1" vid="MAT 12:20">Jululliyyeeka xassanna xolsaba'an.<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />Gosa gosak arduwwinna iso'n addataan» hiyye.<note caller="-" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">Isa. 42:1-4</ref>. </char></note><verse eid="MAT 12:21" /></para>
  <para style="s1">Yessuusinna Be'ilzeebuuli'i</para>
  <para style="r">(<ref loc="MRK 3:20-30">Mar. 3:20-30</ref>; <ref loc="LUK 11:14-23">Luq. 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Ookkonechchinni udumi'a fuggichchi hafuurinni abidemeeka balla'akenna afo'o duudeeka manjichcho mitte manni Yessuusibaa idage. Yessusinna manjichcho konnee'e fayyise; manjichchikinna uudateenna haaso'atee'e dande'e. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Ardi duuchchinna jajeexxi, «Isi kunn Daawwitike belto kaduuta?» hiyye.<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Feerisito kinni tennee laqqee wodda, «Kunni manjichchi durriisa fulcha'neechi Bi'eelzebuuli hiyyemaake fuggichchi hafuurke akeekisanjini malee fuggichcha hafuura fulchaba'a» hiyye.<note caller="-" style="x"><char style="xo" closed="false">12:24 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mat. 9:34</ref>.; <ref loc="MAT 10:25">10:25</ref>.</char></note><verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Yessuusinna heduma insa'neka ege'neexxi hiyyee qici, «Mootumma mitte weli qoqqoodendeexxi weli'an weli lolenda'neexxe kaddoole mootumma eettene'a ba'nenden; iittanni qachchi yookaan mitti mini hadi welinaa'n gargar higoole ti'niyye urra dande'aba'a. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Seexani Seexana fulcha'neexxe kaddoole weli gibe lameba hige'en hiyyotentaa? Iittate kaddoole mootumma isixxi hittata uuriyyo dandeetta? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Eega ani fuggichcha hafuura Bi'eelzebuuli ani'a uwwa'neexxe hunnanni fulchaannexxe kaddoole oose ha'nooxxita ayyi uwwaaxxe hunnanni fuggichcha hafuura fulchita'neeyyote? Tennexxee oose ha'nooxi ha'no murtaan. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Yaane kinni ani fuggichcha hafuura fulcheennek Mageniinke Hafuurinnite kadoole Mageniinxi mootumma ha'noba'a dage'een hiyyoten.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />«Manji mitti hunnaamessa ediseexxi usurebaang mine isike'n e'yeexxi karra isixxa adhdhaa manji hedhebaan. Hunnaamessa manjichcho usureechchinni udumi'a kinni mine isike'n hedheechcho adhdha dande'aan. <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />Aninni welti hedhabaak duuchchi anee gibaake; aninni welti bukki assedhebaakinna xeeraaken.<note caller="-" style="x"><char style="xo" closed="false">12:30 </char><char style="xt" closed="false"><ref loc="MRK 9:40">Mar. 9:40</ref>. </char></note> <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Ani ha'no'n kuloo! Manni hujaaxi cubbonna yowwaa yowwichchi duuchchi gattowwaal hiyyemaan. Yaane kinn Woyyichcha Hafuura'n yowwichiinxa yaane haaso'aakee'e cubbo isixxi gattowwaal hiyyendabaan. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Manjiinke Belto'n yowwichchinxa yaane fulchaak duuchchi cubbo ifixxe'e gattowwaali'i alfaan; yaane kinn woyyichcha Hafuura'n yowwichchinxa yaane haaso'ake duuchchi'a tennenna kaddo'a hegeri'anna isi'a gattowwaal hiyyendabaan.<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luq. 12:10</ref>.</char></note><verse eid="MAT 12:32" /></para>
  <para style="s1">Haqichchi Gumma ifixxenni Ege'nema</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luq. 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />«Haqichchi duuchchi gummati ifixxe ege'nemamamxxe, eloxxa gumma alfitinaashsha eloka haqichcho affe; haqichchi elobaake kadoole gumma isixxinna elobaaxxe kaddaan.<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="MAT 7:20">Mat. 7:20</ref>; <ref loc="LUK 6:44">Luq. 6:44</ref>.</char></note> <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Ha'no buutetexxi oose fuggaaleyyet kaddina wodda eloxxa haaso'iyote'e habaa'n dandeetina? Manjiinka godoba ifike'ni wo'miteexxe afo'ik haaso'aani.<note caller="-" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="MAT 3:7">Mat. 3:7</ref>; <ref loc="MAT 23:33">23:33</ref>; <ref loc="MAT 15:18">15:18</ref>; <ref loc="LUK 3:7">Luq. 3:7</ref>; <ref loc="LUK 6:45">6:45</ref>.</char></note> <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Eloki manji ifike godoba'n tuu'lemmaxxe eloxxe yaanenaa'n eloxxa fulchaani; elobaaki manjinna ifike godoba'n tuulemmaxxe elobaaxxe yaane'naa'n elobaaxxa fulchaani. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Dhugaate ha'no'n haaso'annen murittetixxa barra mann duuchchi afeeshshanni haaso'eeke haaso'i duuchchixxee qoremaan. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Haaso'a atikenaa'n kexxeexxa ati qulloondatton; iittanna haaso'a atikenaa'n kexxeexxa ate'n murendaan.»<verse eid="MAT 12:37" /></para>
  <para style="s1">Beessisa Uudatixxe Shiqeeka Qortuma</para>
  <para style="r">(<ref loc="MRK 8:11-12">Mar. 8:11-12</ref>; <ref loc="LUK 11:29-32">Luq. 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Eettene yanna mitti mitti Muuseke seerixxi barachchiissalluwwinna Feerisito Yessuusii'i, «Barsiisanjo ati beessisa assitaa'na'a uundo» hine.<note caller="-" style="x"><char style="xo" closed="false">12:38 </char><char style="xt" closed="false"><ref loc="MAT 16:1">Mat. 16:1</ref>; <ref loc="MRK 8:11">Mar. 8:11</ref>; <ref loc="LUK 11:16">Luq. 11:16</ref>.</char></note><verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Yessuusinna insa'ne'n hiyyeexxi hiise haaso'ee qici: «Fuggittenna yabaabulto ila beessisa hassaan; yaane kinni wabeeka Yoonaasika beessisa malee insa'ne'aa uwwemabaan.<note caller="-" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 16:4">Mat. 16:4</ref>; <ref loc="MRK 8:12">Mar. 8:12</ref>. </char></note> <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Yoonaasi lumoxxe qulxu'me giddo sase hashshanna sase barra sa'issemmashsha; iittanni Manjiink Belti buttiniinke godobi giddo sase barranna sase hashsha sa'issaan.<note caller="-" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="JON 1:17">Yon. 1:17</ref>. </char></note> <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Neneweke qachchik manni hiyyichcho Yoonaasika laqee wodda cubbo ifixxe'ni yaadeexxi aadde aagemmaxxe'e murtetixxa barra Neneweke qachchik manni welti ke'eexxi iso'ni muraan. Kunnise ha'noo'ni kulo! Yoonaasinaa'n sa'aakiqqa kaba hedheen.<note caller="-" style="x"><char style="xo" closed="false">12:41 </char><char style="xt" closed="false"><ref loc="JON 3:5">Yon. 3:5</ref>.</char></note> <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Saabake bogixxi moottitte Solomoonika beekuma laqiyyotee'e bayyii'n kexxe daggeemmaxxe'e eettene murtetixxa barra tenne ilanni welti kexxeexxi iso'ni murtaan. Ha'noo'ni kulo! Solomooninaa'n sa'eekiqqa kaba hedhee.<note caller="-" style="x"><char style="xo" closed="false">12:42 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 Moy. 10:1-10</ref>; <ref loc="2CH 9:1-12">2 Odo. 9:1-12</ref>.</char></note><verse eid="MAT 12:42" /></para>
  <para style="s1">Fuggichchi Hafuur Manjoke'ni Higatika Jeeja</para>
  <para style="r">(<ref loc="LUK 11:24-26">Luq. 11:24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />«Fuggichchi hafuuri manjokenaa'ni fulee wodda hafuura adhdhaaba halsa'n wodi'i hedhebaabaa bago booncho maremaan. Yaane kinni alfabaa. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Ookko'ni, ‹Hedhennake mine'ninni illeema hige me'oo!› hiyyaan; illeema higeexxi dagaa wodda mini iikki haanni hiyye'e ca'a hiyyee qophpheessemme'naa alfaan. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Ookkonechchi uduma fuggichchi hafuur illeema higexxi isonaa'ni fuggaaleessummati hara sa'eeka wele torbaane fuggichcha hafuuruwwa buki asseexxi idageexxi welt ookkone manjichcho'n hedhaan. Tennexxee ookkone manjichchixxi hedho edi irra hara yoxxeexxe kaddaan. Konne barike fuggaalessa manna'ni kaddaaxxi yaanenna iita tennee labbaaxxen» hiyye.<verse eid="MAT 12:45" /></para>
  <para style="s1">Yessuusixxa Amanna Isika Dayyuwwa</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mar. 3:31-35</ref>; <ref loc="LUK 8:19-21">Luq. 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Yessuusi ardake'ni haaso'a'nenige'ni ama isixxinna dayyuwwi iski iso'o haasossino'a hanseexxi gadhdho uurrineemmani. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Ookko hedheemmake mannanaa'ni mitti iso'o, «Ama atixxinna dayyuwwi atiki atee haasessino'a hanse'e gadho uurrine'eeni» hiyye.<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Yessuusi kinni iso'n, «Ama anxi ayyete? Dayyuwwi ankinna ayyeera?» hiyyexxi hiisse haaso'e. <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Ookkonechchi uduma hordofeeyye ifixxe'n anga wirri asseexxi «Ama anxinna dayyuwwi anki konneerateni. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Iimate'ni hedhdheke anke Annixxa fedhi wonshaaki duuchchi isi anke dayyo anxe dayyoninna anxe aman.»<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s1">Facaasendemmaxxe Gummakanna Wiissalika Mammaassa</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mar. 4:1-9</ref>; <ref loc="LUK 8:4-8">Luq. 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Eettenne barra Yessuusi minii'ni fuleexxi abbaayyat bira ofo'le. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Heddi manni iso'o qoqobemmaxxe isi hobolote'n e'yeexxi ofo'le.<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">Luq. 5:1-3</ref>. </char></note> <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Ookkonechchinni udumi'a Yessuusi heddo yaanuwwa mammaasik ardake'ni hiyya'n kullee qici, «Laqqe! Wiisalli mitti facaalsa fule. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Facaasa wodda mitte mitte gumma orni qarqara ibbe, ci'atinna isee dagge itte. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Wele gummanna careti hana heenoke buttinna'ni ibbe; birasa'eek buttini hedha gophpheemmashshanni hiribbange'ni fulde. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Kaddomalee arishsho fuldee wodda qoorte; hiddakanna afagophpheemmaxxe'e bagge. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Wele gummanna utettixxi oddo'ni ibbe; utettiki haqichchinna nophpeexxi isee suruure. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Wele gummanna eloke buttina'n ibbe latteexxi heddo gumma gummisse; mitte dhibba, mitte jaane tomme, mittetinna sase tomme gumma gummisse. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Mansha laqqaaxxa afeek laqowwaal!» hiyye.<verse eid="MAT 13:9" /></para>
  <para style="s1">Yessuusi Mayee Mammaassik Haaso'eexxa</para>
  <para style="r">(<ref loc="MRK 4:10-12">Mar. 4:10-12</ref>; <ref loc="LUK 8:9-10">Luq. 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Ookkonechchi uduma hordofeeyye Yessuusixxi isibaa dageexxi isoo, «Ardake'ni mammaassik haasotta'ettechchi maayeete?» hite isoo qorte.<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Yessuusinna insa'ne'n hiyye hisse haaso'ee qici, «Ha'no'a iimixxe mootummaxxi buqo yaanexxi ege'na uwwende'en. Insa'ne'a kinn uwwendebaan. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Uwwendeeke uwwendaan; isi'anna caala birasaxxaan; afebaakenaa'n kinni iikki afeengichchi midde adhdhemaan.<note caller="-" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="MAT 25:29">Mat. 25:29</ref>; <ref loc="MRK 4:25">Mar. 4:25</ref>; <ref loc="LUK 8:18">Luq. 8:18</ref>; <ref loc="LUK 19:26">19:26</ref>.</char></note> <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Anfa'ninni anifa'nebaashsha, lanqa'ninni lanqa'nebaashsha yookaan qalbeffanta'nebaashsha kandeemmaxxe insa'ne'n mammaassik haaso'anechchi.»<verse eid="MAT 13:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14" />Wabeek Issayaasi'n borreessemmeek konnechchi butta hedheek raagi insa'ne'n muuxemeedheen:</para>
  <para style="q1" vid="MAT 13:14">« ‹Laqiyyo laqqinaan yaane kinni qalbeeffatinabaan;</para>
  <para style="q2" vid="MAT 13:14">afiyyo affinaan yaane kinni qallitinaba'a.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Konne ardixxi qalbe dilloottemmaxxe,</para>
  <para style="q1" vid="MAT 13:15">Mansha insa'nexxi laqqanebaan;</para>
  <para style="q2" vid="MAT 13:15">anfabaashshanna ille insa'neexxinna himmine'neen;</para>
  <para style="q1" vid="MAT 13:15">Tinni iittate kada gophpheel ille ifixxenni anfeexxi</para>
  <para style="q2" vid="MAT 13:15">mansha ifixxenninna lanqeexxi</para>
  <para style="q2" vid="MAT 13:15">qalbe ifixxenninna qalbeeffanteexxi</para>
  <para style="q1" vid="MAT 13:15">Aniba'a illeema hingee'na'a silaan insa'ne fayyise'enana.›<note caller="-" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">Isa. 6:9-10</ref>.</char></note><verse eid="MAT 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Ha'noxxi kinn ille ha'noxxi affaammaxxe mansha ha'noxxinna laqqaammaxxee eebbisendeeken. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Dhugaate ha'no'n haaso'annen, heddo wabbekonna heddo qulliyye ha'no uudina'neexxa uudatee yorte'emman, yaane kinni uundeba'a; ha'no laqqina'neexxanna laqatee yorteemman; yaane kinni lanqeba'a.<note caller="-" style="x"><char style="xo" closed="false">13:17 </char><char style="xt" closed="false"><ref loc="LUK 10:23-24">Luq. 10:23-24</ref>.</char></note><verse eid="MAT 13:17" /></para>
  <para style="s1">Midha Facaasemmake Manjichchike Mammaassiinxa Tika</para>
  <para style="r">(<ref loc="MRK 4:13-20">Mar. 4:13-20</ref>; <ref loc="LUK 8:11-15">Luq. 8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />«Ha'no yoonna wiisalli manjichchi mammaakemaka mammaassa laqqe: <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Orni qarqara ibbeemmaxxi sanne, Mageniinxe mootummaka hiyyichcho laqqeexxi qalbeeffatabaake mannan; iikki fuggichchinna dageexxi qalbe isixxe'n rokemeemmaka hiyyichcho Seexani dageexxi adhaan. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Carete'n rokemeek gummichchinna, hiyyichcho laqeexxi hirbange'n gammashshoti adhdhaake manjon. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Yaane kinni isi hidda olitta gopheemmaxxe lumoo qico turaba'a; tennexxe ookkone hiyyichchixxe buuto'a rakko yookaani shorrichchi iso'o geeya wodda, iikki woddi ibaan. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Utetixxe oddo'n rokendeexxi gumma iitti hiyyichcho Mageniiinka laqaake manjon; kaddo malee tenne buttaki yaadinna durummatike eeyyumma qalbe isixxi giddo e'yiteexxi hiyyichcho ookkonee suruurtammaxxe gummabelonna gataan. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Eloke buttina'ni rokendeexxi gumma kinni Mageniika hiyyichcho laqeexxi qalbeeffataake manjon; isinna gumma gummisaan; mitti dhibba mitti jaane tomme; mitti sase tomme gumma gummisaan» hiyye.<verse eid="MAT 13:23" /></para>
  <para style="s1">Jigjiinka Mammaassa</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Lebeexxi Yessuusinna wele mammaassa hiyya'ni insa'ne'n haaso'ee qici, «Mootumma iimixxi ifike fichcha'n eloxxa gumma rolkeeke manjichcho labbaan. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Yaane kinn manji duuchchi diiphee'na'a naaphi isike dageexxi rokkendeexxe dinne giddo jigja roke me'e. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Dinne fuldeexxi gummissammaxxe yanna'ni jigijikinna leelle.<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />«Tennexxe ookkone fichchike annik erganjuwwinna isiba'a dageexxi, ‹Koo aaddi, atike fichcha'n rokkeettaxxi eloxxe gummabaa rokkeettak? Jigijitaa habaa'n dage?› hine isoo qorre.<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />«Isinna, ‹Tenne iitta asseek naaphakeni› hiyye hiisse insa'ne'ni haaso'e.</para>
  <para style="p" vid="MAT 13:28">«Erganjuwwi isikinna, ‹Eega iittate kaddeexxenni marrennexxi jigija gonshonnaa hassaate?› hine isoo qorre.<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />«Isi kinni hiyyeexxi insa'ne'ni hiisse haaso'ee qici, ‹Waawo'o jigija goshshinaa wodda dinnetanna welti goshshinaammaxxee hedhuun. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Haamatixxe yanna qico'ni dinnetinna jigijikinna mittemba nophphuun, waalle! Haa'matixxa yanna haamammaka manna: Edisineexxi jigija goshshine giirate'n gubato'a ladde laddenni usurre; dinne kinni bukki assitineexxi gootarake'n aasse hiyyannon› insa'ne'a hiyye.»<verse eid="MAT 13:30" /></para>
  <para style="s1">Senaaficetixxanna Gamamiinka Mammaassa</para>
  <para style="r">(<ref loc="MRK 4:30-32">Mar. 4:30-32</ref>; <ref loc="LUK 13:18-19">Luq. 13:18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Yessuusinna wele mammaassa insa'ne'ni hiyya'ni mammaake qici, «Mootumma iimixxi mitti manjichchi adhdheexxi ifike fichchi giddo rokeexxe shaannixxe gummaxxe sanne<note caller="+" style="f"><char style="fr" closed="false">13:31 </char><char style="ft" closed="false">Wele tika Sinaaficexxe sanne hite'een.</char></note> fakkaattaan. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Tinni senaaficetixxi sanne wele sanne duuchchanaa'n shiixxoxxe kaddoolenna nophphitaa wodda wele heqquwwa saxxaan; ci'anna daggeexxi isexxe dame'n mine ijadhdhiteexxi hexxaan» hiyye.<verse eid="MAT 13:32" /></para>
  <para style="s1">Gamamiinka Mammaassa</para>
  <para style="r">(<ref loc="LUK 13:20-21">Luq. 13:20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Yessuusinna lebeexxi wele mamaassa insa'ne'n hiyyehaaso'ee qici, «Mootumma iimixxi manjichcho mitte bukooto'a sase saffarsanjo bulle'n karissiteek lebele fakkataan. Gamamikinna eettene buko fuldaashsha asse» hiyye.<verse eid="MAT 13:33" /></para>
  <para style="s1">Yessuus Mammaasik Mayee Haaso'eexxa</para>
  <para style="r">(<ref loc="MRK 4:33-34">Mar. 4:33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yessuusi tenne yaane duuchcha mammaasik ardake'n kuleen; mammaasi belo mitteechchonna insa'ne'n haaso'ebaan. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Tinninna kaddeechchi wabeekichchoke'n haaso'endemmaxxi konnechchinni butti'a hexxeexxi muuxendaashshaten.</para>
  <para style="q1" vid="MAT 13:35">«Haaso'anno wodda mammaassik haaso'annon;</para>
  <para style="q2" vid="MAT 13:35">dada dadendeexxe yannanaa'n buqo hexxeexxa yaane haaso'annon» hiyye.<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">Far. 78:2</ref>. </char></note><verse eid="MAT 13:35" /></para>
  <para style="s1">Jigijiinke Mammaassixxa Tika</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Ookkonechchi uduma Yessuusi arda me'aashsha asseexxi mini'a e'ye. Hordofeeyye isixxinna isibaa shiqqeexxi, «Ookkone fichchi giddo hedhemmake jigijiinka mammaassa no'o'a tiki» isoo hite.<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Yessuusinna insa'ne'n hiyye haaso'ee qic: «Iikki eloxxa sanne facaaseek Manjiinke Belton; <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Iikki fichinna tenne buttan; iitti eloxxi sannenna Mageniinxe mootummaxxe oosen. Iikki Jigijinna Seexaniinxe oosen. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Jigija facaaseek naaphinna Seexanaken. Iitti haamatixxi yannanna tenne buttaxxe mudan; iikki haamemmakiirinna iimixxe ergannan.<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />«Jigiji goshemmeexxi giirate'ni gubemammashshanni buttatixxe muda wodda ittanni kaddaan. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Manjinki Belti erganna ifixxa ergaan; insenna cubbotee buutote kadeekaranna fuggoxxa assaakaara duuchcha bukki assite isixxe mootummanaa'n fulchitaan. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Itoonixxe giira giddi'anna insa'ne darbitaan; ookkonna oodhishshanna isso qadhdha kaddaan. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Eettene yanna qulliyye ifike annixxe mootumma'n arishshotishsha xabbaan. Mansha laqqaaxxa afee'ek isi laqowwaal!»<verse eid="MAT 13:43" /></para>
  <para style="s1">Sho'ondeexxe Karrakanna Fiixa Kinoka Mammaassa</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />«Mootumma iimixxi fichchi giddo sho'ondeexxe karra fakkaattaan. Manjikinna ise alfee wodda hiise sho'edhe; gammashshotixxe birasa'nenaa'ninna kexxeexxa me'eexxi afeechcho duuchcha gurgudhdheexxi fichcha ookkone'e hidhdhe.<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />«Higgeen Mootumma iimixxi fiixxa kino halsaake dadalanjo fakkaattaan. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Kunni daddalanjinna hira lumo qico fiixeka kinjo alfee wodda mareexxi afeechcho duuchcha gurgudhdheexxi ookkonee fiixa kinjo hidhdhaan.»<verse eid="MAT 13:46" /></para>
  <para style="s1">Qulxu'metixxe Marabeka Mammaassa</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />«Iitanni Mootumma iimixxi abbaayya giddi'a darbendeexxi bifa bifaxxa qulxu'me duuchcha bukkasiteexxe marabe fakkattaan. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Qulxu'me ise'ni wo'mitee wodda qulxu'me abidammak manni ise'e harkiseexxi abbaayyatike kasa'ni fulche; ookkonechchi uduma ofo'leexxi elola qulxu'me fila'ni qirco giddo ugge; elobaakara kinni gadhi'a hune. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Buttatixxe muda'ninna kaddaa qici iittanden. Iimixxi ergannanna daggeexxi cubbaaleyye qulliyyetenaa'n gargar fotaan. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Cubbaaleyyetanna giirate'n hundee'naa ookko oodhishshatenna isso qadhdhate kaddaan.»<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Yessuusi, «Tennee yaane duuchcha qalbeeffatineen?» hiyyeexxi insa'nee qore.</para>
  <para style="p" vid="MAT 13:51">Insa'nenna, «Eeti» hine hiissine iso'ni haasonne.<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Yessuusinna insa'ne'n, «Yoona mootumma iimixxike hordoffallo kadeek huuni Muusek seerik barsiisanji masseccatike mininaaa'n dullachchakanna haaroka miya ifika fulchammake karrati anna fakkaataan» hiyye.<verse eid="MAT 13:52" /></para>
  <para style="s1">Naaziretike Qachcha'n Yessuusi'n Gelteexxa Gibensha</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mar. 6:1-6</ref>; <ref loc="LUK 4:16-30">Luq. 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Yessusinna konne mammaassuwwa biree wodda ookko'n ke'e me'e. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Ifike boga, Naazirtike qachchiba dageexxi insa'ne'eke magenooffachchotike mine'ni arda barsiisa'emman; ardikinna saadinot, «Kunni manji konne beekkumanna tenne mambe'a assiyyotixxa hunna habaa'ni adhdhe?» hiyye. <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />«Isi kunni ookkone haqqe xabbammake manjichchike beltobaata? Ama isixxita Maaramindebaa? Isik dayyuwwinna Ya'iqoobi, Yooseefi, Simi'ooninna Yihudaaratebaata? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Dayyuwwa isixxi duuchcharanna no'onninni welti hexxeexerabaata? Egedhita'a kunni manjichchi konne beekkuma duuchcha habaa'n alfe?» hine. <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Tenneena'n kexxeexxa iso'n manni macciyya ginbe.</para>
  <para style="p" vid="MAT 13:57">Yaane kinni Yessuusi insa'ne «Wabeek ulfaatabaabi ifike boga'ninna ifike mine'ne callan» hiyye.<note caller="-" style="x"><char style="xo" closed="false">13:57 </char><char style="xt" closed="false"><ref loc="JHN 4:44">Yoh. 4:44</ref>.</char></note><verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Insa'neexxe amanagonphenaa'n kexxeexxa Yessuusi ookko heddo mambe'a assebaan.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">Xammaqallo Yohaanisixxa Reyo</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mar. 6:14-29</ref>; <ref loc="LUK 9:7-9">Luq. 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Eettenee yanna sholgaxxe kutak galchalli Heeroodisi Yessuusixxa odo laqeexxi <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />erganjuwwa ifike'n «Eega iittate kaddoole xammaqammake Yohaannisi reyotenaa'ni ke'eedheen hiyyoten! Tennexxee'e isi darree'ni kunni maso mambe'uwwa duuchchi assema'neek» hiyye.<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Heeroodisi dayyo ifike Filiphphoosixxe are Heerodiyaadaxxe buuto'a Yohaannisi'i abidise'e usursiisse'na usuriinke mi'ne'n hedhemman.<note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">Luq. 3:19-20</ref>. </char></note> <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Yohaannisi Heeroodisii'i, «Atike dayyixxa are aadhiyotee'e seer ati'a uwwabaan» hiyya'n moroma'emman. <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Tennenaa'n kexxeexxa Heeroodis Yohaanisi'i shiyo'a hasa'neman; Yaane kinn ardi duuchchi Yohaannisii'i wabeekiinsha uudaammaxxee'e arda sodaate.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Heeroodisi ilenshatixxi barra ulfeesendaamma barro Heerodiyaadaxxi belto oddo insa'nexxe'n sirbite iso'o gammachchiisse. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Tennexxe isoo laqqaaxxa yaane duuchcha ise'a uwwo'a kakot addachchiise. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Isenna ama ifixenaa'n gorsa laqqeexxi iso'o, «Xammaqallo Yohaannisika umo qorete'n uggitettexxi ani'a uwwi!» hite <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Moyanji Heeroodisinna tenne yaanexxe'e yaade. Yaane kinni aageemmaxxe kakoxxeenna isinni welti hedhemmake mannixxe hiyyeexxi qorteexxi yaane ise'a assendaashsha ajaje. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Tennexxee ergeexxi usurink mi'ne'n Yohaannisika gooba kutise. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Kutemeek uminna qorte'n uggemeexxi beltichotee uwweme'na'a beltichchotinna ifixxe ama'n uutte. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Hordofeeyye Yohaannisixxi daggeexxi Yohaannisika rensha aaxxe mooggeexxi Yessuusi'n kulde.<verse eid="MAT 14:12" /></para>
  <para style="s1">Yessuusi Onde Kuma Manna Itise</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mar. 6:30-44</ref>; <ref loc="LUK 9:10-17">Luq. 9:10-17</ref>; <ref loc="JHN 6:1-14">Yoh. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Yessuusi Yohaannisixxa reyo laqee wodda hedhemmabaa'n ke'eexxi qofinni qoonne bakkaba'a hoboloti me'e; ardikinna tenne laqeexxi qachchuwwakenaa'n fule lekkati isoo herdofe. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Yessuusi hobolotenaa'n dirre wodda heddo arda afeexxi insa'ne'a marare; insa'neka elagophe'eka mannanna fayyise. <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />Bogi galgalo'e wodda Yessuusixxi hordofeeyye isibaa daggeexxi, «Kunni boonchi qiilla gammoojjen; bogikinna hashsha'neen; olla'uwwibaa marreexxi sagale hidhdhino'aa arda konnee me'ashsha assi» hine. <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Yessuusi kinni insa'ne'a, «Ha'no indaachcho insa'ne'a uwwe male'e insa'ne me'a hassisabaan!» hiyye. <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />Hordofeeyye kinni «No'o kaba anfeenchi onde budeenanna lame qulxu'me callan» hite. <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Yessuusinna «Ookkone hedheengechcho anibaa iyyedagge!» hiyye. <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Okonnechchi uduma ardi ansote'n ofo'laashsha ajaje. Ookkone onde buddeenanna eettene lame qulxxu'me aadhee iimi'a uuda'n galateeffate buddeenakanna kukkuteexxi hordofeeyyete'n uwwe; hordofeeyyetinna ardakee uute. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Duuchchinngi iteexxi godde. Ardi ite'na'a gateexxa hanaba tommenna lame qore wo'ma hordofeeyye aaxxe. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Iteeki manninna melaaletinna ooseti gadhi darre onde kuma mannibaatemman.<verse eid="MAT 14:21" /></para>
  <para style="s1">Yessuussi Wodi'i Hana Lekkati Me'e</para>
  <para style="r">(<ref loc="MRK 6:45-52">Mar. 6:45-52</ref>; <ref loc="JHN 6:15-21">Yoh. 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Ookkone hirba'ni Yessuusi hordofeeyye hobolotte'ni guluffeexxi isi'a edisse widdi'a fooffaashsha ajajeexxi isi arda me'iso'a uduma gate. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Isi arda me'iseechchi uduma soodachchote qofittinni kooba qabate. Hashshe woddanna qofittinni ookko'o hedhemman. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Eettenne yanna hobolo iitti me'ita'ni abbaayyatixxe oddo'n hexxee'na'a edi darree'n iseba'a diidallo ganda'na'a danbala'ik elqeenna kayya raasende. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Hashshixxe sallaane saate uduma Yessuussi abaayyati hana me'a'n hordofeeyyetiba'a dage. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Hordofeeyyetinna Yessuusi abbaayyati hana me'a'na affee wodda, «Tinni geelate» hita'n sodaatte raarte. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Hirba ookkoe'ne'ninn Yessuusinna insa'ne'e, «Mee co'o! Anenden; sodaattinoqqe» hiyye. <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />Ookkone wodda Pheexiroosi, «Gootta atete kaddotole wodi'i hana atiba'a dagonna'a ane'e ajaji!» hiyye hisse haaso'e. <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />Yessuusinna «Amo!» hiyye. Pheexiroosinna hobolotenaa'n fuleexxi Yessuussiba'a maro'a wodi'i hana tarkaafate. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Yaane kinni diidallotixxa hunna afeexxi sodaate; Abayyate'ninna lixa shiqee wodda «Goottaa ane'e anjir!» hiyya'n raare. <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Yessuusi hirbange'n anga diriirse iso'o abideexxi iso'o, «Koo ati amana xe'yiteek! Mayee i'nattette?» hiyye. <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Yessuussinna Pheexiroosi hobolote'n e'yine wodda diidallo iitti sammi hite. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Ookkonechchi uduma hobolo eettene giddo hedhemmak manni «Dhugaandinni ati Mageniinke Belton» hiyya'n Yessuussi'a kumbu hiyye.<verse eid="MAT 14:33" /></para>
  <para style="s1">Yessuussi Geensereexike Boga'n Elagopheeka Manna Fayyise</para>
  <para style="r">(<ref loc="MRK 6:53-56">Mar. 6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Yessuusinna hordofeeyye isixxi abbaayya foonfeexxi Geensareexxike boga'n genne. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Ookkone bogik manninna Yessuusite kadeexxa ege'nee wodda qarqarake'ni hedheeke boga duuchcha'n erga sa'ee'na'a ela gophe'eka manna isiba'a idange. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Ela gophemmak manninna Yessusixxee seemmaka kasa calla tunqo'a iso'o kadhate. Iso'o tuqeek duuchchinna fayye.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s1">Fereesittotixxa Aada</para>
  <para style="r">(<ref loc="MRK 7:1-15">Mar. 7:1-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Ookkonechchinni udumi'a Feerisitonna Muuseke seerik barachchiissalluwwi Iyyerusaaleminaa'n Yessuusibaa daggeexxi hite isoo qorettee qici, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />«Hordofeeyye atixxi annuwwiinxa aada diiggaa'nechchi mayeete? Ittaa woddaqqaa anga anshe'na'nebaan!» hine.<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Yessuusinna insa'ne'n hiisse haaso'ee qic, «Ha'nootta aada ha'nooxxe hitineexxi Mageniinka ajaja mayee'e diigginaa? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Mageni, ‹Anna atikanna ama atixxa ulfeessi! Anna ifika yookaan ama ifixxa yowwaak shiyemmowwaal› hiyyeen.<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="EXO 20">Fula. 20</ref>; <ref loc="EXO 12">12</ref>; <ref loc="EXO 21:17">21:17</ref>; <ref loc="DEU 5">Lan. 5</ref>; <ref loc="DEU 16">16</ref>; <ref loc="LEV 20:9">Lew. 20:9</ref>.</char></note> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Ha'no kinni mitti manji anna ifika yookaan ama ifixxa, ‹Ani ha'no'a assiyo hasissaaxxa Magenoke'e tolche'ene› hiyyoole, <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />‹Iikki manji anna ifika yookaan ama ifixxa ulfeessa hasissabaan› hitinaan; tennexxe ha'nooxxe aada'a hitineexxi Mageniinka seera diigginaan<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="fqa" closed="false">Anna ifika </char><char style="ft" closed="false">Mitte mitte mirqisanjo maxaafiki borreesuwwa Anna ifika yookaan ama ifixxa hiyyaan.</char></note> <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Ha'no ifi uggudhdhitinaak manni, Issayaasi ha'nooxxee konnechchi butta hedgeeka raaga haaso'eexxt dhugaaten.»<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />« ‹Kunni ardi afo'ik anee'e ulfeessaan</para>
  <para style="q2" vid="MAT 15:8">qalbetik kinni anenaa'n bayyate'eeken.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Manjiinxa aada barsiisa'n</para>
  <para style="q2" vid="MAT 15:9">dhark ane'e magenooffanta'neen.› »<verse eid="MAT 15:9" /></para>
  <para style="s1">Manjo Battoossitaaxxa Yaane</para>
  <para style="r">(<ref loc="MRK 7:14-23">Mar. 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Higgeen Yessuusi arda ifibaa ye'eexxi hiyyee qici, «Laqqe, qalbeeffatte. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Manjo battoosachchi afo'o isikenaa'n fulaachcho malee'e, afo'a sa'aachchobaan.»<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Ookkonechchi udumi'a hordofeeyye Yessuusibaa daggeexxi, «Ta'a ati haasotteettexxi yaane Feerisito riffi assiteexxa egendebexxoota?» hine.<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Isinna kinni insa'ne'a hiyyee hiissee qici, «Iimik ank anni kaasebaak hiddichchi duuchchi goshemaan. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Insa'nexxa yaane waalle, insa'ne balla'uwwa akeeka'neexxe balla'a akeekisannon; balla'i balla'a akeekoole lamiing balete'ni inbaan.»<note caller="-" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="LUK 6:39">Luq. 6:39</ref>.</char></note><verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Pheexiroosinna Yessuusi'i, «Konne mammaassa no'aa tiki» hiyye.<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Yessuusinna insa'ne hiyyee qici, «Ta'i qico'ni ha'no qalbeeffatinebaan hiyyotebaata?» hiyye. <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />«Manjiinke afo'o'ni sa'eechchi duuchchi godobi giddo mareexxi gadhi'a fulaaxxa egendineexxebaata? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Afo'okenaa'n fulaachchi kinni qalbetenaa'n dagaachchon; manjo battoossaachchinna isoten.<note caller="-" style="x"><char style="xo" closed="false">15:18 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mat. 12:34</ref>.</char></note> <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Figgichchi hedumi, manjo shiya, yabaabula, fedhe galatixxa yabaabula, moora, dharki dhugaa kulanna, summa balleesa kunniichchi duuchchi qalbe manjiinxenaa'ni dagaan. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Manjo battoossaachchi konnechchuwwa malee'e anshendebaaxxe anganni ita manjo battoossitabaan» hiyye.<verse eid="MAT 15:20" /></para>
  <para style="s1">Kenaanitoo Manjichchoxxa Amana</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mar. 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yessuusinna ookkone boonchonaa'ni ke'eexi Xiroosikenna Sidoonake qachchuwwibaa me'e. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Ookkone bogii'n mitti Kenaanito manjichcho Yessuusibaa daggeexxi, «Gootta, Daawwitike Belto, anxa belto fuggichchi hafuuri abide'naa rakkatta'neen; magannete ani'a marari» hita'n raarte.<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Isi kinni mitte hiyyichchonna ise'ni cuqqi hiyyebaan. Isixxi hordofeeyyenna isibaa daggeexxi, «Tinni manjichcho raaritta'ni no'oo udumi'n dagga'emmaxxee ise me'issi» hite iso kadhatte.<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Yessuusi hiisseexxi, «Ani ergemmenexxi dageennechchi Isira'eelike minenaa'n gedhebiinsha ba'eeke manni'a callaten» hiyye.<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Manjichcho kinni, «Anke Gootta Anee'e gargaar» hita'n lekka isixxe'n ibbe.<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Yessuusinna, «Oosetixxa ita aa'neexxi worshakee darbiyyo hasisabaan» hiyye hiisse haaso'e.<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Manjichchotinna hiissitexxi «Eeti anke Gootta worshikinnaqqa ifiki gootuwwi itaa'naa harca'emmalcho itaan» hite.<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Eettene yanna Yessuusi ise'e, «Tee manjichcho amana atixxi lumoxxen; Tennexxe atixxe halsashsha ati'a kaddowwaal» hiyye; belto isexxinna hirba ookkone'ninni fayyite.<verse eid="MAT 15:28" /></para>
  <para style="s1">Yessuusi Ela Gopheeka Heddo Manna Fayyise</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yessuusinna ookko'n ke'e Galiilixxe abbayya bira dage; koobatanna qabate hana ofo'le. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Heddi manni hokkoluwwa, balla'uwwa, naafuwwa, afo'o duuduwwanna heddo wele ela gonpheeka manna aadhe Yessuusibaa iyyedageexxi lekka isixxi hunda offo'linshe; Yessuusinna insa'ne'e fayyise. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Ardi afo'o duudemmakiir haaso'a'na'a naafuwwi fayyee'naa hokkoluwwi eloo qico me'aa'naa balla'uwwikinna afaa'na uude wodda mambe'a hiyyat Isira'eelika Mageno galateeffate.<verse eid="MAT 15:31" /></para>
  <para style="s1">Yessuusi Shoole Kuma Manna Itise</para>
  <para style="r">(<ref loc="MRK 8:1-10">Mar. 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Yessuusi hordofeeyye ifixxa ye'eexxi «Kunni ardi aninni welti sase barra tureemmaxxenna itaacho afa gopheemmaxxe'e insa'ne'a mararraane; me'a wodda gaggabik orake'ni inbabaashsha agabo me'o'a waalabe'non» hiyye.<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Hordofeeyye Yessuusixxinna «Tenne qiilla gammoojje'n konne ardi duuchchi'a geltaaxxa sagale habaa'ni anfanno?» hite hiisite haasotte.<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Yessuusinna, «Me'e buddeena afine'e?» hiyyeexxi insa'ne'e qore.</para>
  <para style="p" vid="MAT 15:34">Insa'nenna, «Torbaane buddeenanna heenoxxa shiixxaramma qulxu'me anfe'ennen» hine.<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Yessuusinna arda ofo'lo'a ajaje. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Ookkonee torbaane buddeennanna eettene qulxu'me aadheexxi Mageno galateffatechchi uduma shashshateexxi hordofeeyyete'n uwwe; insa'nenna ardakee qoodde. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Duuchchiing ite godde. Ookkonechchi uduma hordofeeyye gatteemmaxxa hanba wo'ma torbaane qore aaxxe. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Iteek manninna melaalletinna oose laako'endebaang shoole kuma labballomman. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Yessuusi arda me'iseechchi uduma hobolote'n ofo'leexxi Megedoolike bogibaa me'e.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s1">Beessisa Uudatee Shiqeeka Qortuma</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mar. 8:11-13</ref>; <ref loc="LUK 12:54-56">Luq. 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Feerisitonna Seduuqito Yessuusibaa daggeexxi isoo hega uuddo'a beessisa insa'ne'n iimatenaa'n leellisho'a isoo qorte<note caller="-" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="MAT 12:38">Mat. 12:38</ref>; <ref loc="LUK 11:16">Luq. 11:16</ref>. </char></note> <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Isi kinni insa'ne'n hiyye hiisse haaso'ee qici, «Hashsha wodda ‹Iima diimmatte'een xeeni ganabaan› hitinaan. <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Gorsanna ‹Iima diimmatte duumanchiteemmaxxe techcho xeeni gana ganaan› hitinaan. Ha'no iimitika beessisa gargar hiissa egendinaan; yaane kinni bariinka beessisa gargar hiissa dandetinabaan<note caller="+" style="f"><char style="fr" closed="false">16:3 </char><char style="ft" closed="false">Mitte mitte mirqisanjo maxaafuwwki borreessi laakkosa 2ke'ninna 3ke'n hedheeka Yessuusika haaso'a leellishshaba'a.</char></note> <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Fuggittenna Mageno egendebbaaxxi ila beessisa yortaan. Yaane kinni wabeeka Yoonaasik beessisa malee'e wele beessisi isi'a uwwemabaan» Ookkoneechchi uduma Yessuusi insa'nee waale me'e.<note caller="-" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="MAT 12:39">Mat. 12:39</ref>; <ref loc="LUK 11:29">Luq. 11:29</ref>. </char></note><verse eid="MAT 16:4" /></para>
  <para style="s1">Feerisitotikanna Seduuqotika Gamama</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mar. 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Hordofeeyye abbaayyati widi'a fooffee wodda buddeena iyyedha deete. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yessuusinna hordoffeeyyete'n, «Qalbeeffatte; Feerisitotikenna Seduuqitoti gamaminnaa'n ifi heqqedhdhe» hiyye.<note caller="-" style="x"><char style="xo" closed="false">16:6 </char><char style="xt" closed="false"><ref loc="LUK 12:1">Luq. 12:1</ref>. </char></note> <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Insa'nenna «Yessuusi tennee iitta hiyyeechchi buddeena iyyedaqqa gonpheennaxxeete kaddaan» hina'n weli'aa weli haasonne. <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Yessuusinna insa'nee haasonneeka haaso'a ege'neexxi insa'nee hiyyee qici «Ha'no amana xe'ite'ek manni ‹Buddeena iyyedaqqa gonpheennexxeten› hitinexxi maye'a weli'aa weli haasottina? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Ta'i qico'ni yaane ha'no'n aaggebaan hiyyotebaata? Ondi buddeeni onde kumi manni'a geye gatee'naa me'e wo'maa qore hanba aaxxineexxa kassi hitinna'neba hiyyatebaata?<note caller="-" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">Mat. 14:17-21</ref>. </char></note> <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Iittanni torbaani buddeen shoole kumi manni'a geyeexxi gate'naa me'e qore aaxxineexxa kassi hitinna'neba hiyyatebaata?<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">Mat. 15:34-38</ref>. </char></note> <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Yoona ani ha'noo'n haaso'ennek buddeeniinxeete kaddebaaxxa hittataa qalli hiyya gophphina? Ta'anna Feerisitokenna Seduuqitoti gamaminnaa'n ifi heqqedhdhe» <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Hordofeeyyetinna Yessuusi insa'ne'n kuleexxi yaane Feerisitotixxenna Seduuqitotixxe barachchiissaxxe malee buddeeniinxeete kaddebaaxxa eettene yanna egende.<verse eid="MAT 16:12" /></para>
  <para style="s1">Pheexiroosi Yessuusixxa Ayyumma Haaso'eexxa</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mar. 8:27-30</ref>; <ref loc="LUK 9:18-21">Luq. 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Yessuusi Filphoosi Qiisaariya hiyyemaake bogiba geyee wodda hordofeeyye ifixxa, «Manni Manjiinka Belto ayyete hiyya'ne?» hiyye qore. <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Insa'nenna «Mitti mitti ‹Xammaqallo Yohaannisiten› hiyya'neen; weli ‹Eelyaasi› hiyya'neen; welikinna ‹Ermiyaasi› hiyya'neen yookaan ‹Edixxe wabeeko giddii'ni mitteken› hiyya'neen» hite.<note caller="-" style="x"><char style="xo" closed="false">16:14 </char><char style="xt" closed="false"><ref loc="MAT 14:1-2">Mat. 14:1-2</ref>; <ref loc="MRK 6:14-15">Mar. 6:14-15</ref>; <ref loc="LUK 9:7-8">Luq. 9:7-8</ref>. </char></note> <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />Yessuusinna insa'nee, «Ha'noota anee ayyete hitinna'ne?» hiyye qore. <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Pheexiroosi hiyyemmeek Simi'ooni, «Ati Kiristoosi hedhaake Mageniink Belton» hiyye hiisse haaso'e.<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="JHN 6:66-69">Yoh. 6:66-69</ref>. </char></note> <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Yessuusinna iso'n hiyye haaso'ee qici, «Yoonake belto koo Simi'ooni, ati eebbisendeetteken; tennee ate'n leellisheek iima hedheeke anke anna malee'e manjokebaan. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Tennexxee ani atee Pheexiroosi<note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="ft" closed="false">Pheexiroosi hiyya rassa hiyyaten</char></note> hiyyaannen; tennee rassa'ninna Mageniinxa tuuta ijaarannon. Reyotixxi hunnanna tennee Mageniinxa tuuta injiffattabaan. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Iimixxe mootummaka mafachcha ate'n uwwannon; buttate'n usurtettek duuchchi iimate'n usuremeeke kadaan; buttate'ninna tikkeettek duuchchi iimate'ninna tikemeeke kadaan.»<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">Mat. 18:18</ref>; <ref loc="JHN 20:23">Yoh. 20:23</ref>. </char></note> <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Ookkoneechchi uduma isi Kiristoosite kadeexxa ayye'ninna kuldabaashsha hordofeeyye ifixxa ajaje.<verse eid="MAT 16:20" /></para>
  <para style="s1">Yessuusi Iso'n Geltaaxxe Rakkoxxeenna Reyoxxee Haaso'e</para>
  <para style="r">(<ref loc="MRK 8:31-33">Mar. 8:31-33</ref>; <ref loc="LUK 9:22-27">Luq. 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Eettene barranaa'n safeexxi Yessuusi Iyyerusaalemi'a me'a'neexxa, ookkonna geedhetenaa'n qeesetike sooreessuwwanaa'ninna Muuseke seerike barachchiissalluwwinaa'n iso'n rakko geltee'naa shiyema'neexxa, sakkaxxe barra'ninna reyotenaa'n ke'a hasisa'neexxa ifixxe hordofeeyye'n kulate'n ke'e. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />Pheexiroosi kinni Yessuusii'i qofibaa aadhe me'e'eexxi, «Goottaa tinni ate'n haranga geltoqqe'e» hiyya'n isoo xixe. <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Yessuusi kinni wirri hiyyeexxi Pheexiroosii'i, «Ati koo durriisa bayyati kabaan; manjiinxa malee'e Mageniinxe yaanek yaadi ate'n hedhagopheemmaxxee ani'a gufote kaddeetten» hiyye.<verse eid="MAT 16:23" /></para>
  <para style="s1">Kiristoosii Hordofa Laqqaaxxa Tolchema</para>
  <para style="r">(<ref loc="MRK 8:34-9:1">Mar. 8:34—9:1</ref>; <ref loc="LUK 9:23-27">Luq. 9:23-27</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Ookkoneechchi uduma Yessuusi ifixxe hordofeeyye'n «Anee hordofo'a hasaak duuchchi ifi huneexxi fanno ifixxa dulke anee hordofowwaal.<note caller="-" style="x"><char style="xo" closed="false">16:24 </char><char style="xt" closed="false"><ref loc="MAT 10:38">Mat. 10:38</ref>; <ref loc="LUK 14:27">Luq. 14:27</ref>. </char></note> <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Hedho ifixxa anjidhdho'a hasaak duuchchi ifinxe hedho gophaan; Ani'a hiyyeexxi ifixxa hedho balleessaak duuchchi kinni hedho ifixxa alfaan.<note caller="-" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mat. 10:39</ref>; <ref loc="LUK 17:33">Luq. 17:33</ref>; <ref loc="JHN 12:25">Yoh. 12:25</ref>. </char></note> <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Manji tennee buttaxxa la'o duuchcha alfoole ifixxa lubbo kinni gophoole isi maa la'o alfa? Yookaan lubbo ifixxee maa hira uwwa dande'a? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Manjiink Belti ifike annike ulfinninn, isixxe ergananni qoqqobemee dagaan; ookkone wodda mitte mittengee'e huje hujetishshanni hira uwwaan.<note caller="-" style="x"><char style="xo" closed="false">16:27 </char><char style="xt" closed="false"><ref loc="MAT 25:31">Mat. 25:31</ref>; <ref loc="PSA 62">Far. 62</ref>; <ref loc="PSA 12">12</ref>; <ref loc="ROM 2:6">Rom. 2:6</ref>. </char></note> <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Dhugaate ha'no'n haaso'annen, Manjiink Belti ifixxe mootummanni dagaa qico'n kaba uurreeke manninaa'n reyo uudabaak mitti mitti hedheen.»<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">Yessuusixxe Bifixxa Jijjiirensha</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mar. 9:2-13</ref>; <ref loc="LUK 9:28-36">Luq. 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Jaane barra uduma Yessuusi Pheexirosii'i, Ya'iqoobiinna Ya'iqoobika dayyo Yohaannisii'i qofitti insa'ne calla aadhdheexxi mitte qeeraxxe kooba hana qabate.<note caller="-" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 Phex. 1:17-18</ref>. </char></note> <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Ookkonna insa'ne edo jijjiiremme'naa isik albinna arishshotishsha xabe; isixxi seemmanna ifiinsha golalooxxe kadde. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Ookkone hirba'ninni Muusenna Eelyaasi Yessuusinni haasoona'n insa'ne'n leelline. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Pheexiroosinna Yessuusii'i, «Goottaa kaba hedha no'aa eloxxen. Eettaattole sase fooqa mitte ati'a mitte Muuse'a mitte Eelyaasi'a ijaaro» hiyye.<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Pheexiroosi tennee haaso'ande'n hedhee'naanni ca'a hiyyeek duummanchi insa'nee buqe; duummanchi giddii'ninna, «Ani iso'n gammadaannek, eeyyannek anki belti konneten; isi hiyyaaxxa laqqe» hiyyaak haaso'i laqeme.<note caller="-" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="GEN 22:2">Dada. 22:2</ref>; <ref loc="LEV 18:15">Lew. 18:15</ref>; <ref loc="PSA 2:7">Far. 2:7</ref>; <ref loc="ISA 42:1">Isa. 42:1</ref>; <ref loc="MAT 3:17">Mat. 3:17</ref>; <ref loc="MAT 12:8">12:8</ref>; <ref loc="MRK 1:11">Mar. 1:11</ref>; <ref loc="LUK 3:22">Luq. 3:22</ref>. </char></note> <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Hordofeeyyetinna konnee haaso'a laqqee wodda lumo qico sodaatteexxi albik butta gonbissend. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Yessuusi kinni insa'nebaa shiqe angati insa'nee qaqqabeexxi insa'nee, «Ke'we iimi'a; mee sodaatte» hiyye.<verse eid="MAT 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 17:8" />Insa'nenna qokki hineexxi uunde wodda Yessuusii malee'e wele ayyeenna anfeba'a.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Koobatenaa'n dirina'na'neenge'n Yessuusi «Manjiink Belti reyotenaa'n ke'aa qico'n uuddineexxa tennee yaane ayye'ninna kuldinoqqe'e» hiyyeexxi ifixxa hordofeeyye ajaje.<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Hordofeeyye Yessuusixxinna Yessuusii'i, «Muusseke seerik bararachchiisalluwwi edise daga hasisaak Eelyaasiten hiyya'neek mayeete?» hita'n qorte.<note caller="-" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="MAL 4:5">Mil. 4:5</ref>. </char></note> <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Yessuusinna hiisseexxi, «Dhugaaten Eelyaasi edise dageexxi guuchchiinxa yaane toggi assaan. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Yaane kinni ani ha'noo'n hiyyaannen, Eelyaasi ediseenni dageemman; kaddo malee'e manni isoo ege'neemmabaan; iso'ninna eeneeshsha asse'ne. Iittani Manjiink Belti insa'nexxe anga'n rakko adhdhaan»<note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="MAT 11:14">Mat. 11:14</ref>. </char></note> <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Ookkonne wodda hordofeeyye Yessuusi insa'ne'n haaso'eechchi xammaqallo Yohaannisixxeete kaddeexxa egende.<verse eid="MAT 17:13" /></para>
  <para style="s1">Yessuusi Gaggaddo Afeeka Belto Fayyise</para>
  <para style="r">(<ref loc="MRK 9:14-29">Mar. 9:14-29</ref>; <ref loc="LUK 9:37-43">Luq. 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Insa'nenna ardibaa ille iima hingeeshshanni manjichchi mitti Yessuusibaa dagge gulufateexxi hiyyee qici, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />«Goottaa belto ankee maraari! Gaggaddotike dhukkubinni lumoshsha abara uda'neen; heddo yanna giirate'ninna wodi'i giddo ibaan. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Hordofeeyye atixxibaanna isoo aadhdhe dageennen, insa'ne kinni isoo fayyisatee dandeennebaan.»<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Yessuusinna hiiseexxi, «Ha'no amandinabaaxxinna dabaaleyye ila haani qico'n ha'noonni welti hedhannota? Haani qico'n ha'noo ba'edhannota? Belto kabaa anibaa iyyedagge» hiyye. <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yessuusinna ookkone fuggichchaa hafuura xixe; fuggichchi hafuurinna beltokenaa'n fule; beltikinna eettene yanna'ninni fayye.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Ookkoneechchi uduma hordofeeyye qofitinni Yessuusibaa daggeexxi, «Mayeete no'o konnee fuggichcha hafuura fulcha dande'a gonpheennechchi?» hita'n isoo qorte. <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />Yessuusinna insa'ne'n hiyyee qici, «Ha'nooxxe amanaxxe xe'yani; Dhugaate haaso'aannen shaaniinxe gumma qicixxa amana affineexxe kaddoole, ‹Tennee kooba kabaa'n kexxe ookko'a me'i› hitinoole me'itaan; dandeettinabaaxxi yaanenna hexxebaan.<note caller="-" style="x"><char style="xo" closed="false">17:20 </char><char style="xt" closed="false"><ref loc="MAT 21:21">Mat. 21:21</ref>; <ref loc="MRK 11:23">Mar. 11:23</ref>; <ref loc="1CO 13:2">1 Qor. 13:2</ref>. </char></note> <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Iitta hedheek fuggichchi hafuuri agabo goddotinna soodachchoti malee'e fulabaan.»<verse eid="MAT 17:21" /></para>
  <para style="s1">Yessuusi Reyaaxxanna Reyo injifate Ke'aaxxa Langaxxa Haaso'e</para>
  <para style="r">(<ref loc="MRK 9:30-32">Mar. 9:30-32</ref>; <ref loc="LUK 9:43-45">Luq. 9:43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Hordofeeyye Geliila bukki hiteemma wodda Yessuusi insa'ne'n hiyyee qici, «Manjiink Belti manniinxe anga'n sa'issemee uwwemaan. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Insa'nenna isoo shinnaan; isinna sakkaxxa barra reyotenaa'n ke'aan.» Hordofeeyyetinna lumo qico yaadde.<verse eid="MAT 17:23" /></para>
  <para style="s1">Galmiinxa Irbo Uwwa</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Yessuusi ifixxe hordofeeyyenni welti Qifirnahoomi geyee wodda galmiinxa irbo bukkassaammak manni Pheexiroosibaa shikki hiyyeexxi, «Barachchiisalli ha'nook galmiinxa irbo uwwa gophaata?» hiyye isoo qore.<note caller="-" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="EXO 30:13">Fula. 30:13</ref>; <ref loc="EXO 38:26">38:26</ref>. </char></note> <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />Pheexiroosinna «Eeti, uwwaan» hiyye hiise haaso'e.</para>
  <para style="p" vid="MAT 17:25">Pheexiroosi mini'a e'yee wodda Yessuusi ediseexxi, «Koo Simi'ooni ate'n maa labbaa?» isinna hiisseexxi «Buttik moyanjuwwi qaraxakanna irbo aadhaak ayyenaa'nite? Ifixxe oosenaa'nite moo yookaan wele manninaa'nite» hiyye qore. <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Pheexiroosinna «Wele bogike mannanaa'niten» hiyye hiisse haaso'e.</para>
  <para style="p" vid="MAT 17:26">Yessuusinna «Yoona insa'ne oose irbo uatabaan hiyyatebaataa?» <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />«Yaane kinni insa'ne'a gufote kandabe'noshsha abbaayyatiba martettexxi atika qulxu'me abishshotika fixa wode'i giddi'a darb! Edisse abiddatoxxa qulxu'me aaxxe iseka afo'o maaqatto wodda maallaqa<note caller="+" style="f"><char style="fr" closed="false">17:27 </char><char style="ft" closed="false">Maala hiyyemeek hiyyichchi wele tika'n Isitaater hiyyemeedheen; Isitaater hiyya lame tophphiinxe birre qicon</char></note> affatton. Isoonna aaxxettexxi no'o lamiingike summinni irbotee uwwi.»<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s1">Iimate'n Duuchchingenaa'n Sa'aak Ayyete?</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mar. 9:33-37</ref>; <ref loc="LUK 9:46-48">Luq. 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Eettenee yanna hordofeeyye Yessuusibaa shiqqeexxi, «Mootumma iimixe'n duuchchingena'n sa'aak ayyete?» hite isoo qorte.<note caller="-" style="x"><char style="xo" closed="false">18:1 </char><char style="xt" closed="false"><ref loc="LUK 22:24">Luq. 22:24</ref>. </char></note> <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Yessuusinna anno mitte ye'e insa'nexxe oddo'n uurriseexxi,<note caller="-" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="MRK 10:15">Mar. 10:15</ref>; <ref loc="LUK 18:17">Luq. 18:17</ref>.</char></note> <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Dhugaate ha'no'n haaso'aane, jijjiirema gophphinoole oosetishsha kada gophphinoole iimixxa mootumma haranga e'yitinabaan. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Tennexxee tenne annoshsha ifi shiixxishaak iimixxe mootuma'n duuchiingenaa'n sa'aak isoten. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Iitta hexxeexxa anno anke summinni adhdhaak anee adhdhaan.<verse eid="MAT 18:5" /></para>
  <para style="s1">Manjokee Gugufachchote Kadatenaa'n Heqqedha</para>
  <para style="r">(<ref loc="MRK 9:42-48">Mar. 9:42-48</ref>; <ref loc="LUK 17:1-2">Luq. 17:1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />Yaane kinni ane'n amanaake konne shiixaramma manni giddii'n mitte guggufachchisaak manji lumoka daammiink kinji isike gooba'n usureme'naa abbaayyatixxe dhi'mo'n lixe'eele isi'a woyyamman.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />Manjo guggufachchiissaaxxe yaanuwwaxxe buutoxxee tenne butta'a aanne'e; guggufachchiissaxxi yaanna daggebaak gattabaan; yaane kinni iitti guggufachchiissaaxxi yaane isi darree'n daggaake manji'a aanne'e. <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Atixxi anga yookaan atixxi lekka cubbo hujjottaa ati'a buutote kadda'noole isee ifinaa'n kutte huni; lame anga yookaan lame lekka affettexxi duuchchi woddixxe giira'n hunedettexxi mannii'n hokkola kadde'e yookaan naafake kadde'e duuchchii woddixxe hedhobaa e'ya ati'a woyyan.<note caller="-" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="MAT 5:30">Mat. 5:30</ref>. </char></note> <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Ille atixxi cubbo hujjotta ati'a buutote kadda'noole isee ifinaa'n fulchite hun. Lame ille affe'e duuchchii woddixxe giira'n hunemati mannii'n mitte illenni hexxe hedhotibaa e'ya woyyan.<note caller="-" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="MAT 5:29">Mat. 5:29</ref>. </char></note><verse eid="MAT 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />«Ani ha'noo'n kuloo, iima hexxeexxi insa'nexxi erganna iima hedheeka anke annika alba duuchchii wodda uuddammaxxee konne shiixxaramma manninaa'n mittekanna tuffattinabaashsha, heqqedhdhe! <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Manjiink Belti dageechchi ba'eemmaka manna anjiro'aaten.»<verse eid="MAT 18:11" /></para>
  <para style="s1">Ba'eexxi Leeleeke Gedhechchika Mammaassa</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luq. 15:3-7</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />Higgeen Yessuusi hiyyee qici: «Ha'noo'n maa labba? Manjichchi mitti afe'eeke dhibbi gedhebi giddii'ni mitti ba'oole, sallaane tommenna sallaane gedhebo koobatte'n waaleexxi ookkone ba'eemmaka hasitto me'aa waalaata? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Dhugaate ha'noo'n haaso'aanne, ookkone ba'eemmaka alfee wodda ookkone ba'emmabaake sallaane tommenna sallaane gedhebii caala ookkone ba'eexxi afemeemmake mitte gedhechcho'n gammadaan. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Iittanni iimik ha'nook anni konnee shiixxarammuwwinaa'n mittikinna ba'o'aa eeyyaba'a.<verse eid="MAT 18:14" /></para>
  <para style="s1">Balleesseek Manjo Balleessatenaa'n Hiissaa</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />«Atik dayyi atee balleesseexxe kaddoole martettexxi atinna isinni calli mitteba hexxineeba isixxa belleessa iso'n kul. Hiteettexxa laqeexxi higeexxe kaddoole atika dayyo haaroba ifike assexxatton.<note caller="-" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="LUK 17:3">Luq. 17:3</ref>. </char></note> <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Hitettexxa laqa giboole kinni lame yookaan sase dhugaa kula manjixxi yaane kokeessitammaxxee langaxxa lame yookaan sase manjo ifi'n lephphi.<note caller="-" style="x"><char style="xo" closed="false">18:16 </char><char style="xt" closed="false"><ref loc="DEU 19:15">Lan. 19:15</ref>. </char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Insa'ne hinaaxxanna laqa giboole marte tennee Mageniinxe tuuta'n kuli; Mageniinxa tuutaxxanna laqa giboole isoo Mageno ege'nebaake yookaan qaraxammake manjishsha laakko'i.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />«Dhugaate ha'noo'n haaso'aannen butta usurtinaak duuchchi iima usuremeeke kadaan; butta tikkinaak duuchchi iima tikemeeke kadaan.<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="MAT 16:19">Mat. 16:19</ref>; <ref loc="JHN 20:23">Yoh. 20:23</ref>. </char></note><verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />«Higgeenna ha'no'n kulo, ha'noonaa'n kaba butta lami manji heene yaane'ninna weli aaggeexxi Mageno soodatoole iima hedheek ank anni eettenee yaane insa'ne'a assaan. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Lami yookaani sasi manji anke summinni bukki hiyyaake booncho'n ani ookko insa'nexxe oddo'n afemannon.»<verse eid="MAT 18:20" /></para>
  <para style="s1">Gattowaal Hiyya Hassissaaxxa</para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 18:21" />Ookkoneechchi uduma Pheexiroosi Yessuusibaa shiqeexxi, «Goottaa ank dayyi anee balleessoole me'e yana isi'a gattowwaal hiyyanno? Torbaane yannaa qici'aan?» hiyye isoo qore.<note caller="-" style="x"><char style="xo" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="LUK 17:3-4">Luq. 17:3-4</ref>. </char></note><verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yessuusinna «Torbaanne tomme yanna torbaanele malee'e, torbaane yanna calla hiyyabe'non» hiyye hiisse haaso'e.<note caller="-" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="GEN 4:24">Dada. 4:24</ref>. </char></note><verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />«Tennexxee iimixxi mootumma ifike erganjuwwa'n hedhemaka maallaqa towatto'a mudhdheemmake moyanjo labbaan. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Isinna ookkonee maallaqa towata safeeshshanni tomme kuma makiliite<note caller="+" style="f"><char style="fr" closed="false">18:24 </char><char style="fqa" closed="false">Mekiliite </char><char style="ft" closed="false">Mitte mekiliite eettene yanna tommenna onde woggake mitte hujali'a uwwemaamake barratike rundamman.</char></note> liqa afeek mitti erganji abideme isibaa dage. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Kunni erganji liqeeffateemmaka liqa hiissa dande'a gopheemmaaxxee isi umo isingenninni, isixxi are, isixxi oosenna afeexxi karra duuchcha gurgurendenaa iikki liqi uwwemaashsha iikki moyanji ajaje.<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />«Tennexxee iikki erganji isixxe lekka'n ibeexxi isoo, ‹Anke goottaa maganneten ani'a hittetexxi ossi; ane'n hedheeka liqa duuchcha ati'aa hiissannon› hiyya'n kadhate. <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Ookkonee erganjik goottinna isi'a marare; liqakanna isi'a waaleexxi me'o'a wocci asse.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />«Iikki erganji ifike gootti edii'n fuleeshshanni mitte dhibba diinaare<note caller="+" style="f"><char style="fr" closed="false">18:28 </char><char style="ft" closed="false">Mitte Diinaare heenoke berretike siblji qicon</char><char style="ft" closed="false">Mitte Diinaare mitte hujalike mitte barrake rundan</char></note> isika liqa afeemmaka ifika erganjo jaalo afeexxi isika gooba hudhe abidat, ‹Koo liqeeffatteettaka anka Maallaqa ani'a hiissi!› hiyye.<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />«Tennexxee kunni isi'a ergatemmammak isik jaali isixxe lekka'n ibeexxi, ‹Maganneteni ani'a hite ossi; liqeeffateennakanna ati'a hiissannon› hiyye isoo kadhate.<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />«Isi kinni, waala gibe; liqeeffateemmaka maallaqanna isi'a hiisse bira qico'n iyyemareexxi ookkonee manjichcho usurriinke mine'n usursiisse. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Weli isik jaaluwwa kadeek erganjuwwinna tennee afee wodda lumo qico yaadat mareexxi kaddeexxa duuchcha ifike gootta'n kule.<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />«Ookkoneechchi uduma moyanjikinna ookkone erganjo ye'iseexxi, ‹Koo, ati fuggichchi erganji! Yoona anee kadhatteettaxxee! Ookkone liqa duuchcha ati'a waaleennen. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Ani ati'a maraareneshsha atinna erganjo atike jaali'a marara hassissammabaata?› <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Tennexxee isik gootti iso'ni mufateexxi liqeeffateemmaka liqa duuchcha hiissa qico'ni usurii mine'n isoo rakkisaake manna'n sa'isse uwwe.<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />«Mitti mitti ha'noong ha'nooka dayyo mitte godobinni gattowwaali hiyya gophphinoole iima hedheek anki anninna iittanni ha'no'aa gattowwaal hiyyabaan.»<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s1">Aadha Heerumiinxee Uwwendeexxa Barachcho</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mar. 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Yessuusinna tennee yaane haaso'eexxi bireechchi uduma Geliilaa'n ke'eexxi Yordanoosi wido hedheeke Yihudake bogibaa me'e. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Hedi ardinna isoo hordofe; isinna ookko ela gopheemmaka manna fayyise.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Feerisitotinna Yessuusii'i hega uuddo'a isibaa shiqqeexxi, «Mitti manji heene buutonninna ifixxa are tikatee seeri isi'aa uwwaa?» hite isoo qorte.<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Yessuusinna hiissee hiyye haaso'ee qici, «Sirende'n Magen insa'nee labbakenna meyyaxxe asse dadeexxa haassossa gophine'eeta?<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">Dada. 1:27</ref>; <ref loc="GEN 5:2">5:2</ref>. </char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Yessuusinna hiyyee qici, Tennexxee manji ifika annanna ifixxa ama waalaan; ifixxe areninna makemaan; lamiing mitte maala kandaan.<note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Dada. 2:24</ref>. </char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Tennexxee insa'ne mitte biso malee'e lamekebaan. Yoona Mageni genci asse'e mitteke asseeka meenni manji gargar hiissowwaal.»<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Insa'nenna, «Mayeeta, Muuse aro'i ifixxa are tikatixxa dhugaa kulatixxa borro uwweexxi isee waalowwaal? Hiyyeexxi ajajeek» hina'n isoo qorre.<note caller="-" style="x"><char style="xo" closed="false">19:7 </char><char style="xt" closed="false"><ref loc="GEN 24:1-4">Dada. 24:1-4</ref>; <ref loc="MAT 5:31">Mat. 5:31</ref>. </char></note> <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Yessuusinna insa'ne'n hiisse hiyye haaso'ee qici, «Muuse ha'nooke godobika jabeenna uudati ha'nooxxa are tikkinnaashsha eetti ha'no'aa uwwee malee'e tinni sirete'n iittatemmabaan. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Ani kinni ha'noo hiyyaanexxi yabaabulletixxe buuttoxxeete kaddoole malee'e ifixxa are waaleexxi wele melaalle adhaak duuchchi yabaabule'eeken.»<note caller="-" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Mat. 5:32</ref>; <ref loc="1CO 7:10-11">1 Qor. 7:10-11</ref>. </char></note><verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Hordofeeyyetinna iso'n, «Aro'iinxinna aretixxi yaane iittate kaddexxinni aadha gopha woyya» hite.<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Yessuusi kinni hiisse insa'ne'n hiyye haaso'ee qici, «Tinni yaane isi'a uwwendeekeete kaddoole malee'e tinni yaane duuchchiingee kaddabaan. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Mitti mitti middisake kadeexxi ilemeekiir hedhe; wele manjiinxe anga'ninna middisake kadeekiir hedhe; iittanni iimixxe mootuma'a hiyyeexxi ifi middisake asseekkiirinna hedhe. Tennee yaane adhdha dande'aak adhdhowwaal.»<verse eid="MAT 19:12" /></para>
  <para style="s1">Yessuusi Annoole Eebbise</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mar. 10:13-16</ref>; <ref loc="LUK 18:15-17">Luq. 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Eettenne yanna ifixxa anga annooleti hana uggeexxi insa'ne'a soodato'a annoole Yessuusibaa iyyedange. Yaane kinni hordofeeyye annoole iyyedagemmaka manna xixxe.<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />Yessuusinna, «Iimixxi mootumma tennee annooleshsha hedheekeeri'aate kaddeemmaxxee annoole anibaa dagguunni, mee hoyyee!» hiyye. <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Isinna ifixxa anga annoolet hana uggeexxi insa'nee eebbiseechchi uduma, ookko'n ke'e me'e.<verse eid="MAT 19:15" /></para>
  <para style="s1">Dureessichchi Dargaggeessika Qortuma</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mar. 10:17-31</ref>; <ref loc="LUK 18:18-30">Luq. 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Mitte barra manjichchi mitti Yessuusibaa dageexxi, «Barachchiisalloo, duuchchi woddixxa hedho alfonnaa heenee eloxxa yaane assanno?» hiyye isoo qore. <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />Yessuusinna, «Eloxxe yaanexxee mayee anee qortatto? Elok mitte Mageno callanni; hedhotibaa e'ya hassottole kinni ajajuwwa heqedhi» hiyye hiise haaso'e.<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Manjichchikinna «Hoone ajajuwwa?» hiyye isoo qore.</para>
  <para style="p" vid="MAT 19:18">Yessuusinna hiyye hiise haaso'ee qici, «Shiltoxxe'e, yababuldoxxe'e, moortoxxe'e, dharik dhugaa kuldoxxe'e.<note caller="-" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">Fula. 20:13-16</ref>.</char></note> <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />Annakanna ama atixxa ulfeessi; manjo atke umishsha eeyyi.» <note caller="-" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Fula. 20:12</ref>; <ref loc="DEU 5:16">Lan. 5:16</ref>; <ref loc="LEV 19:18">Lew. 19:18</ref>. </char></note><verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Iikki dargaggeessi dureessichchinna «Konneeraqqa heqqedhdheenneni; weli ani'a xe'yaachchi maachcho?» hiyye.<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yessuusinna «Wo'make kaddotaa hassaattole martettexxi affeettechcho duuchcha gurgurtette'e hiyyeeyyetee uwwi, iimate'ninna karra affatton. Ookkoneechchi uduma daggettexxi anee hordofi» hiyye hiisse haaso'e.<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Kunni dureessichchi dargaggeessinna lumoxxa karra afeemmaxxee'e konne hiyyichcho laqee wodda yaada'n me'e.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Ookkoneechchi uduma Yessuusi ifixxe hordofeeyye'n hiyyee qici, «Dhugaate ha'no'n haaso'annen, dureessi manji'a iimixxa mootumma aaga lumoo qico ha'urtotten. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Higgeenna ha'noo'n haaso'annen, dureessi Mageniinxe mootumma'n e'yeexxi mannii'n gaali miiltike qo'anaa'n e'ya isi'a shollexxan» hiyye.<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Hordofeeyyetinna konnee haaso'a laqqeexxi hara mambe'a hiyyat, «Iittate kaddooletaa ayyete anjirma dande'a?» hite qorte.<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yessuusinna insa'nee uuda'n, «Tinni yaane manjo dandeessissaaxxeba'a. Magenoke'n kinni duuchchiinxi yaane dande'endaan» hiyye.<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Eettene yanna Pheexiroosinna, «No'o duuchchiinxa yaane waallennexxi atee hordonfe'eennen alfinannochchita maachcho?» hiyye hiisse qore.<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Yessuusinna insa'nen hiyyee qici, «Dhugaate hiyyaannen, ha'no anee hordoffineek, Manjiink Belti ifixxe ulfinniinxe moote'n ofo'laake haarooke sa'ne'n tommenna lame moote'n ofoldineexxi tommenna lame Isira'eelike gosati minuwwa'n murtinaan.<note caller="-" style="x"><char style="xo" closed="false">19:28 </char><char style="xt" closed="false"><ref loc="MAT 25:31">25:31</ref>; <ref loc="LUK 22:30">Luq. 22:30</ref>.</char></note> <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Anke summi'a hiyyeexxi minuwwaa yookaan ifika dayyuwwaa yookaan dayyuwwaa ifixxa yookaan annaa yookaan amaa yookaan oosee yookaan fichchaa waalaak duuchchi dhibba dachcha'a adhdhaan; duuchchii woddixxa hedhonna dhaalaan. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Yaane kinni ediseemmak heddi manni udu'maake kadaan; udu'meemmak heddi manni kinni edike kadaan.»<note caller="-" style="x"><char style="xo" closed="false">19:30 </char><char style="xt" closed="false"><ref loc="MAT 20:16">Mat. 20:16</ref>; <ref loc="LUK 13:30">Luq. 13:30</ref>.</char></note><verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s1">Woyineti Hiddichchi Boonchike Hujalluwwixxee Mammaassaa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />«Iimixxi mootumma ifike woyyinetike hiddichchi giddo hujaaka hiriinka hujalluwwa hasito gorsanni fuleeke fichchiinke anna labbaan. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Isinna mitte mitte hujalluwwi'a barratee mitte mitte diinaare'a weli aageexxi insa'nee ifike woyinetike hiddichchi giddi'a erge.<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="fqa" closed="false">Diinaare </char><char style="ft" closed="false">Mitte diinaare mitte barrake mitte hujallike rundan.</char></note><verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />«Sase saate kadamma wodda mareexxi dikko giddo huje belo uurreeka wele manna afeexxi, <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />insa'nee, ‹Ha'nonna martineexxi anke woyinetike hiddichchi fichchi giddo hujje; aninna hasisaachcho ha'no'a uwwannon› hiyye. <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Insa'nenna ookkone woyyinetike hiddichchi fichchi giddi'a me'ine.</para>
  <para style="p" vid="MAT 20:5">«Jaanenna saallane saate kadamma woddanna mareexxi higgeenna wele barratika hujalluwwa hirik hujaashsha asse. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Tommenna mitte saate kadamma woddanna mareexxi uurreemmaka wele manna afeexxi, ‹Ha'no barra duuchcha huje belo kaba uurritine'eechchi mayeete› hiyye insa'nee qore.<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />«Insa'nenna, ‹No'oo hirik hujlsaaka manjo gonphennexxeeten› hine hiissine haasonne.</para>
  <para style="p" vid="MAT 20:7">«Isinna insa'ne'n, ‹Ha'noonna martineexxi anke woyinetike hiddichchi fichchi giddo hujje› hiyye.<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />«Bogikinna galgalo'ee wodda, eettene woyinetike hiddichchik anni ifike hujalluwwi'a umoke kadeemmake manjichcho'n ‹Udu'me dagemmakenaa'n saffeettexxi ediseexxi dagemmak qico'n hedheeka ookkone hujalluwwa yexxa'n insa'nexxe hujeka hira insa'ne'a uwwi› hiyye.<note caller="-" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="NUM 19:13">Lak. 19:13</ref>; <ref loc="LEV 24:15">Lew. 24:15</ref>. </char></note><verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />«Tommenna mitte saate woddi'a hirik hujatee e'yeemmak manninna shiqeexxi mitti mitting mitte mitte diinaare adhdhe. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Edise hirik hujete'n e'yeemmakiirinna shiqee wodda insa'ne ifi'a sa'eeka adhdhina'neechcho labbeemman; yaane kinni insa'ne'nna mitti mittiing mitte mitte diinaare adhdhine. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Insa'nenna ookkonee hira adhdhinee wodda fichchiinka anna aallanta'n, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />‹Kunni ta'a udu'me dageek manni mitte saate calla hujeen› yaane kinni ‹Barra duuchcha hunja'n eloona'ninna arishshote'n xoolema'n no'oo honsenekixxa qixxe insa'ne'a uutetten› hine.<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />«Fichchiink anninna insa'ne giddii'n mitteke'n hiyye hiisse haaso'ee qici, ‹Koo anke jaalo, ani atee ballessennechchi hedheba'a; weli angeennak mitte diinaare'atemmabaata? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Atee geyeechcho adhdhite me'i; ati'a uwwennexxe qixxe'n udu'me dageemmake manji'aanna uwwa hassaannen. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Anke maalaqinni eeyyennexxa assa dande'abe'noota? Yookaan ani ba'late anka maallaqa uwwennexxee diindattota?›<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />«Iittanni udu'meemmakiir edike kadaan; ediseemmakiirinna udumike kadaan.»<note caller="-" style="x"><char style="xo" closed="false">20:16 </char><char style="xt" closed="false"><ref loc="MAT 19:30">Mat. 19:30</ref>; <ref loc="MRK 10:31">Mar. 10:31</ref>; <ref loc="LUK 13:30">Luq. 13:30</ref>. </char></note><verse eid="MAT 20:16" /></para>
  <para style="s1">Yessuusi Iso'n Geltaaxxe Rakkoxxee Haaso'e</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mar. 10:32-34</ref>; <ref loc="LUK 18:30">Luq. 18:30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Yessuusi alalle Iyyerusaalemi'a me'a'n tommenna lame hordofeeyye qofinni ifibaa ye'eexxi insa'ne'n hiyyee qici <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />«Kunse no'o Iyyerusaalemi'a me'ate'n he'nennen; Manjiink Belti qeesetike sooreessuwwixxe'ninna Muuseke seerike barachchiisalluwwixxe anga'n sa'issemee uwwemaan. Insa'nenna reyotixxa murte iso'n murraan. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Ayihudake kadebaake mannixxe anga'ninna isoo sa'issinee unaan; insa'nenna iso'n gacifantan, isoo gannaan, fannissaan; yaane kinni sakka barranna isi reyotenaa'n ke'aan.»<verse eid="MAT 20:19" /></para>
  <para style="s1">Zebediwoosixxe Oosexxe Amaxxa Kadha</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mar. 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Ookkonneechchi uduma Zebidewoosixxe oosexxi ama ifixxe oosenni Yessuusiba dage'e gulufatteexxi mitte yaane ise'a assaashsha isoo kadhatte.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Yessuusinna, «Maa hassette?» hiyye isee qore.</para>
  <para style="p" vid="MAT 20:21">Isenna, «Tennee anxa lame labbaxxa oose atixxe mootumma'n mitte atike midda'n mittekanna atike bita'a'n ofoldaashsha assi» hite.<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Yessuusi kinni, «Kadhatinaangechcho egendineba'a; ani ha'wannoxxe buudanaa'n<note caller="+" style="f"><char style="fr" closed="false">20:22 </char><char style="ft" closed="false">Buudatenaa'n ha'wa woyyichchi maxaafi giddo rakko adhdhate leellishshaan; tennexxee'e buudatenaa'n hawwate hiyya rakkatate hiyyaten. </char></note> ha'wa dandeetina?» hiyye. Insa'nenna «Eeti dandeennannon» hine haasonne.<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Yessuusinna insa'ne'n, «Dhugaaten, ani ha'wanoxxe buudanaa'n ha'witinaan; yaane kinni anke midda'ninna anke bita'a'n ofo'la ank anni qixxeesseekeeri'aate malee ani assannoxxe yaanebaan.»<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Wele gatteemmaxxi tomme hordofeeyyenna tennee laqqeexxi ookkone lame dayyuwwa'n mufatte. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Yessuusi kinni duuchchiinga ifibaa ye'eexxi insa'ne'n hiyyee qici, «Ayihudake kadebaake ardik galchalluwwi ifike arda'n moyaaxxa, insa'nek ja'laabuwwinna insa'ne'n baallooma afaaxxa egendine'een. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Ha'noo'n iitta kada hasisaba'a; yaane kinni ha'no giddii'n akeekisanjoke kado'a hasaak ha'noke erganjo kaduun,<note caller="-" style="x"><char style="xo" closed="false">20:26 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">Luq. 22:25-26</ref>. </char></note> <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Umoke kado'a hasaakinna ha'nooxxe jale kaduun, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Manjiink Belti isi'a ergantaashshate kaddebaak ergatemo'anna ifixxa lubbo heddi manni'a uwwo'a dage'een.»<verse eid="MAT 20:28" /></para>
  <para style="s1">Yesuus Lame Bala'uwwixxa Ille Baqqi Asseexxa</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mar. 10:46-52</ref>; <ref loc="LUK 18:35-43">Luq. 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Ookkonneechchi uduma Yessuusinna isixxi hordofeeyye Iyyarkonaa'n fulleexxi me'inaa'naa heddi manni Yessuusii hordofe. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Ookkonna lami balla'uwwi oriin qarqara ofo'leemman; insa'nenna Yessuusi ookkone'n sa'a'neexxa lanqeexxi, «Goottaa Daawwitike belto no'aa marar» hina'n raarre.<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Ardikinna samminaashsha insa'nee xixe; insa'nek kinni, «Goottaa Daawwitike Belto, no'aa marari» hina'n hafuura gikki assine raarre.<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Yessuusinna uure insa'nee ye'eexxi insa'nee, «Maa ha'no'a assonnaa hassina'n» hiyye qore.<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Insa'nenna, «Goottaa ille no'oxxi baqi hito'aa hansaannen» hine.<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Yessuusinna insa'ne'a marare ille insa'nexxa ifixxe anga qaqqabe. Hirba ookkone'n ille insa'nexxi baqqi hitenaa Yessuusii'i hordonfe.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">Yessuusi Ulfinna Lumokenni Iyyerusalemi E'ye</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mar. 11:1-11</ref>; <ref loc="LUK 19:28-40">Luq. 19:28-40</ref>; <ref loc="JHN 12:12-19">Yoh. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Yessuusinna hordofeeyye ifixxe'n Iyyerusaalemi'a danga'n Debire Zeyyitixxe Kooba hana hedheeke Beetefaage hiyyemaake boonchibaa genee wodda Yessuussi lame hordofeeyye <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />hiyya'ni ergee qici, «Ha'noo edi darre hedheeke olla'ibaa marre; geltineeshanni mitte usureendeexxa harrichcho isexxe beltanjonni welti affinaan; ani'anna tikkine iyyedage. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Ayyinna mitte yaane ha'noo'n hiyyeexxe kaddoole ‹Goottakee harre tinni hasissaan› hiyye; Isinna hirbange'n eettene harre wocci asse ergaan» hiyye. <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />Tinninna kadeechchi wabeekake'n konneechchi buttaa haaso'endeemmaxxi muuxendo'aten:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />«Tsiiyoonnixxe belto'n</para>
  <para style="q2" vid="MAT 21:5">‹Kunse Moyanji atik ifi shixisheexxi</para>
  <para style="q1" vid="MAT 21:5">Eettene harcho'ninna</para>
  <para style="q2" vid="MAT 21:5">eettene harrichchoxxe beltanjo hana ofo'leexxi atibaa dagaan hitine ise'n kulle.› »<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Tennexxee hordofeeyyetinna marteexxi Yessuusi insa'nee ajajemmashshanni assite. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Eettenee harrichcho isexxe beltanjoninni welti iyyedange; seemma ifixxanna tenne harre hana uggine; isinna tenne harre gulufe. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Lumook ardi seemma ifixxa orake'n fayya'emman; weli manni iittanni haqichchiinka shafuwwa enqa'n orake'n faya'emman. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Isi edi darre me'ammakinna isi udumii'n hordofa'emmak ardi</para>
  <para style="q1" vid="MAT 21:9">«Hoossayinna<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false">Ibrrayisixxe ifisann «Taa anjir!» hiyyendaa wodda galata ifesaaxxen: Laa 15</char></note> Daawwitike belti'a!»</para>
  <para style="b" vid="MAT 21:9" />
  <para style="q1" vid="MAT 21:9">«Goottiinke summinni dagaak isi eebbisemeeken»</para>
  <para style="q2" vid="MAT 21:9">«Hoosayina ale iimate'n!»<verse eid="MAT 21:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Yessuussinna Iyyerusaalemi e'ye wodda iikk qachchi duuchchi «Isi kunn ayyete?» hiyya'n raanke.<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Ardiknna «Kunniqqa Geliilake boganaa'n Naazireetii'n dageeke ookkone wabeeka Yessuusiten» hiyye.<verse eid="MAT 21:11" /></para>
  <para style="s1">Yessuusi Daddalto Woyyichcha Galami Giddii'n Shorre</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mar. 11:15-19</ref>; <ref loc="LUK 19:45-48">Luq. 19:45-48</ref>; <ref loc="JHN 2:13-22">Yoh. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Ookkoneechchi uduma Yessuusi woyyichchi Galmi giddi'a e'yeexxi ookko giddo gurgudhdhammakanna hidhdhammaka duuchcha fulche. Maallaqa jijjiidhdhammake mannika beeruwwanna guuggenjo gurgurammaake mannika beerruwwa gonbse. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Isinna insa'neni « ‹Mini ank soodachchotike mine hiyyemaan› hiyyendee borreessende'een. Ha'no kinni ‹bokkaametixxe wolo'o› assexxineeni» hiyye.<note caller="-" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isa. 56:7</ref>; <ref loc="JER 7:11">Erm. 7:11</ref>.</char></note> <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />Woyyichcha Galmi giddo balla'uwikinna hookoluwwi isibaa dage; isinna insa'nee fayyise. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Yaane kinni qeesetik sooreessuwwinna Muusseeke seerik barachchiisalluwwi, konnee Yessuusi asseeka mambe'uwwa uundemmaxxeenna «Hoosayina Daawwitike belti'a!» hita'n Galmi giddo oose raarteexxa raare lanqe wodda mufante.<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />Insa'nenna Yessuusii'i, «Tinni oose hita'neexxa laqa'inn hexxete?» hine qorre.</para>
  <para style="p" vid="MAT 21:16">Isinna, «Eeti laqqeenneen; iitta hiyyendeexxa hara haasossitine egendinebaan hiyyatebaata?»</para>
  <para style="q1" vid="MAT 21:16">« ‹Oosetena'ninna unu'nitammaxxe</para>
  <para style="q2" vid="MAT 21:16">annooleke afo'inaa'n galata qixxeessitetten› » hiyyendeexxa haranga haasossitine egendinebaan hiyyatebaata?<note caller="-" style="x"><char style="xo" closed="false">21:16 </char><char style="xt" closed="false"><ref loc="PSA 8:2">Far. 8:2</ref>. </char></note><verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Ookkonna insa'nee waale, qachchakenaa'n fuleexxi Biitaaniya mare gale.<verse eid="MAT 21:17" /></para>
  <para style="s1">Yessuusi Badeeka Belesetika Haqichcho</para>
  <para style="r">(<ref loc="MRK 11:14">Mar. 11:14</ref>, <ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Gorsa Yessuusi ookkone qachchibaa daga'n solo'we. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Or qarqara hedheeka mitte belese hiyyemaa haqichcho afeexxi isiba mare, shafe malee gumma isonaa'n gophemmaxxee, «Ta'anni edi'a ate'ni gumma haranga afendoqqe'e!» hiyye. Ookkone hirba'ninni iikki ballasetik hiqichchi bage.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Hordofeeyyetinna tennee kaddeexxa yaane uuddeexxi, «Kunni ballasetik haqichchi hitta iikk woddi bage?» hita'n mambe'a hite.<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Yessuusinna hiisse haaso'a'n hiyyee qici, «Dhugaate ha'noo'n haaso'annen, amana affinoole mamanna gophphinoole konne ballasetik haqichcho'n kaddeexxa calla assitinabaan; yaane kinni tennee kooba midde ‹Kabaa'n kexxe abbaaya giddi'aa ifi daribbi› hitnoole tinni kaddaan.<note caller="-" style="x"><char style="xo" closed="false">21:21 </char><char style="xt" closed="false"><ref loc="MAT 17:20">Mat. 17:20</ref>; <ref loc="1CO 13:2">1 Qor. 13:2</ref>.</char></note> <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Amandineexxi sooddachchoti laqqinaaxxa duuchcha alfitinaan.»<verse eid="MAT 21:22" /></para>
  <para style="s1">Yessuusik Baallomi Qortumakee Shiqeexxa</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mar. 11:27-33</ref>; <ref loc="LUK 20:1-8">Luq. 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Yessuusi woyyichchi Galmi giddo e'ye'e barachchiisaa'naa qeesetik sooreessuwwinna ardiinxi geedhe isibaa daggeexxi, «Maayiinke baalloominni tenne duuchcha assitaatte? Konne baalloomata ati'a uwweek ayyete?» hine isoo qorre.<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yessuusinna hiyyeexxi insa'ne'n hiisse haaso'ee qici, «Aninna mitte qortuma ha'noo qoraanen. Qortumma konne ani'a hiisitinoole, aninna maayiinke baalloominni tennee yaanuwwa assa'ennexxa ha'no'n kulannon. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Yohaannisixxi xammaqaa? Hoone darree'nitemma? Mageni darree'nite yookaan manjii darreenite?» hine.</para>
  <para style="p" vid="MAT 21:25">Insa'nenna weli'aa weli haasoonna'n hinee qici, ‹Magenii darree'nite› hinnonoole, ‹isinna hiisseexxi no'oo maayeeta iso'ni amana gophphineema?› hiyyaan; <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />‹Manjii darree'nite› hinonnoole iittan duuchching Yohaannisii'i wabeekiinsha uudaammaxxee arda sodantaannen.»<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Tennexxee, «Egennebe'no» hineexxi Yessuusi'n hiissine haasonne.</para>
  <para style="p" vid="MAT 21:27">Isinna insa'nen, «Aninna tennee yaanuwwa maayiinke baalloominni assa'ennexxa ha'no'ni kulabe'no» hiyye.<verse eid="MAT 21:27" /></para>
  <para style="s1">Lame Dayyuwwixxee, Mammaassa</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Yessuusinna insa'nee, «Amme kulle, ha'no'ni maa labba? Mitti manjichchi lame oose afe'eemman. Taakkaka ifika belto ye'eexxi isoo, ‹Anke belto techcho martettexxi anka woyinetika fichcha huji!› hiyye.<verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />« ‹Iikk Beltichchinna waalenne, marabe'no› hiyye; yaane kinni uduma gibemang yaade mare.<verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />«Annikinna langake ifike beltiba mareexxi isoona iittanni hujaashsha ajaje. Beltichchikinna, ‹Ishshi annayyo, marannon› hiyye. Yaane kinni marebaang gate.<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />«Tennee lame oosenaa'n ifike annixxa fedhii wonsheek?» hoonete?</para>
  <para style="p" vid="MAT 21:31">Insa'nenna «Takake belton» hineexi hiissine haasonne.</para>
  <para style="p" vid="MAT 21:31">Yessuusinna insa'ne'n hiyyee qici, «Dhugaate ha'no'n haasoa'ennen, cubbaaleeyyetinna yabaabuluwwi mootumma Mageniinxa e'yati hanoo edisaan. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Xammaqalli Yohaannisi qullummatika ora ha'no'n leellisho'a dagaa wodda isoo amandinebaan; cubbaaleeyyetinna yabaabuluwwi kinni isoo amane. Tennee kaddeexxa uuddinne udumanna midde aadde aaggineexxi isoo amandinebaan.» <note caller="-" style="x"><char style="xo" closed="false">21:32 </char><char style="xt" closed="false"><ref loc="LUK 3:12">Luq. 3:12</ref>; <ref loc="LUK 7:29-30">7:29-30</ref>.</char></note><verse eid="MAT 21:32" /></para>
  <para style="s1">Woyinetike Fichchike Hujalluwwika Mammaassa</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mar. 12:1-12</ref>; <ref loc="LUK 20:9-19">Luq. 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />«Wele mammaassanna laqe: woyinetika hiddichcho kaalseemmak mitti manjichchi hedhemman; isinna konnee woyinetike hiddichcha'n dalla'a ijaare, woyine miicendaaxxa balenna u'meexxi heqateenna xeleepho ijaare. Ookkoneechchi uduma ookkone woyinetika hiddichcho hujalluwwakee kira uwweexxi wele bogibaa me'e.<note caller="-" style="x"><char style="xo" closed="false">21:33 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">Isa. 5:1-2</ref>.</char></note> <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Gumma qocendaaxxi yannanna geltaa wodda ifika qoobbo adhdho'a erganjuwwa ifika ookkone hujalluwwiba erge.<verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />«Iikk hujalluwwinna ookkonee isika erganjuwwa abideexxi mitte ganne; mitti shinne; wele mitte kinjik cancanqe. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Isinna edike erganjuwanaa'n laakkossik sa'aaka wele ifika erganjuwwa insa'nebaa erge; hujaluwwi iikkinna ediseeke erganjuwwa'n assemanxa insa'neninna asse. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Udumii'n kinni ‹Belto anka ulfeesinaan› hiyyati belto ifika konnee hujallubaa erge.<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />«Yaane kinni hujalluwwi iikki belto isika afee wodda weli'aan weli ‹Kunnifa'i isoo dhaala'neeken, amme isoo shinnennexxi karra isixxa dhaallo› hine. <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Tennexxee belto isika aa'ne woyinetike hiddichchi giddii'n fulchineexxi shinne.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />«Woyine eettene hiddichchiink annita dagaa wodda konne hujalluwwa'n maachcho assa ha'no'n labba?» hiyye.<verse eid="MAT 21:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="MAT 21:41" />Insa'nenna «Ookkone fuggichcha manna fuggo shiyyeexxi ookkonee woyinet hiddichchonna isi'a gumma yannate'n uwwaake wele hujalluwwi'a kira uwwaan» hine.<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yessuusinna insa'ne'ni, «Woyyichcha maxaafa'n,</para>
  <para style="q1" vid="MAT 21:42">« ‹Iikki ijaaralluwwi gibemmak kinji</para>
  <para style="q2" vid="MAT 21:42">isi dhaadotike kinjo kade.</para>
  <para style="q1" vid="MAT 21:42">Mageni tennee asse'een;</para>
  <para style="q2" vid="MAT 21:42">isenna ille no'oxxe'n masoten hiyyendeexxi borreesendeexxa haasositinebaataa?›<note caller="-" style="x"><char style="xo" closed="false">21:42 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">Far. 118:22-23</ref>.</char></note><verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />«Tennexxee ha'no'n kulo, mootumma Mageniixxi ha'nonaa'n adhdhendeexxi isexxa gumma gummisaake wele manni'a uwwendaan. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Konne kinji hana ibaak bututaan; kunni kijinna itti hana ibaak manji isi bullo'aan.»<note caller="+" style="f"><char style="fr" closed="false">21:44 </char><char style="ft" closed="false">Mitte mitte mirqisanji maxaafixxi borruwwa laakkossa 44 lebbaan; kunni hiyyichchi Luq. 20:18 hedheeka fakkataan.</char></note><verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Qeesetik sooreessuwwinna Feerisito konnee mammaassuwwa laqqee wodda Yessuusi haaso'a'neek insa'nexxeete kaddeexxa egenne. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Isoo abinde usurro'a yorre; kaddo malee'e ardi wabeekiinsha isoo uundemmaxxee sodaante.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s1">Aadha Heerumiinxe Jilaka Mammaassa</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luq. 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Higgeen Yessuusi insa'ne'n mammaassik hiyya'n haaso'ee qic: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />«Mootumma iimixxi ifike beltixxe aadha'a jila jileeke moyanjo fakkaatta. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Moyanji kunninna jilatee ye'emeemmaka manna ye'o'aa ifika erganjuwwa insa'nebaa erge; insa'ne kinni jilatibaa daga ginbe.<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />«Iikki moyanji wele erganjuwwa higgeenna insa'nen, ‹Ookkone ye'emeemmake mannibaa martineexxi kunse sanga'uwwakanna ha'yo horuwwa dulee jila jileennen; duuchiinxi yaane qixxootteemmaxxee jilatixxe itabaa amme› hiyye erge.<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />«Yaane kinni kunni ye'emeemmak manni ye'injo konnee ga'ma'mi hiyyati mitti ifike fichibaa, mittikinna daddala ifikibaa me'e. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Weli gateek manninna ookkonee erganjuwwa isika abideexxi assendabaaxxa asse isa'nee shiyye. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Eettenee yaanna iikki moyanji aareexxi ifika loliinka manna ergati ookkone erganjuwwa shiyemmaka manna shilchiiseexxi insa'nek qachchinna giirati gubemaashsha asse.<verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />«Ookkoneechchi uduma isi erganjuwwa ifika hiyyee qici, ‹Aadhatixxi jila qixxoote'een; yaane kinni iikki ye'emeek manni eettene jila'a hasisabaake manna kade. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Yoona oriinxe weldeenna weldeenna'n martineexxi afineeka manjo duuchcha eettene aadhatixxe jilabaa ye'we› <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Iikki erganjuwwinna ori'aa mareexxi afeenga manna duuchcha, elo yo'oka bukki assee'naa ookkonee jilatike mine'n manni wo'me.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />«Yaane kinni moyanji iikki ookkonee ye'emeeka manna uudo'a mini'a ye'ee wodda jilatixxa seemma oddo'webaaka mitte manjo ookko afeexxi, <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Moyanji iikkinna isoo, ‹Koo anke jaaloo!› ‹jilatixxa seemma oddo'witebexxong hitta kaba e'ya dandeettete?› hiyye. Manjichchi iikki kinni hiyyeexxi hiisse haaso'aaka hiyyichcho afe'eemmaba'a.<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />«Iikki moyanjinna erganjuwwa ifika, ‹Anga lekka isixxa usurtineexxi gadho hexxeexxe dukkana'n fulchitineexxi isoo hunne; ookkonna oodhdhishshanna isso qarate kaddaan› hiyye.<note caller="-" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mat. 8:12</ref>; <ref loc="MAT 25:30">25:30</ref>; <ref loc="LUK 13:28">Luq. 13:28</ref>.</char></note><verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />«Ye'emeekiir heddoke, filemeekiir kinni heenoken» hiyyendeemmashshaten.<verse eid="MAT 22:14" /></para>
  <para style="s1">Qeesari'a Irbo Uwwatixxee Shiqeeka Qortuma</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Ookkoneechchi uduma Feerisito me'iteexxi Yessuusii'i haaso'a isingenninni isoo abiddo'a mari'atte. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Iinsa'nenna ifixxa hordofeeyye Heeroodisike manninni welti Yessuusibaa ergineexxi hinee qici, «Barachchiisalloo, ati dhugaatike kaddeettexxanna Mageniinka ora dhugaati barachchiissaatteke kaddeettexxa egenneennen. Manjo sodaatati ille uushsho hujabexxo; ayyi'aanna gamisabexo. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Amo no'o'n kuli, ate'n maa labba? Moyanjo Qeesaari'a irbo uwwa seerake mo'o yookaan seerakeba'a?» hine.<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Yessuusi kinni fuggaalessumma insa'neexxa ege'neexxi, «Ha'no ifi uggudhdhaalluwwi maayee anee yaaneti fonxortino'a yortina? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Ookkonee iirbotee uwwemaaka maallaqa ane'n leellishshe.» Insa'nenna mitte diinaare iso'n iyyedangeexxi leellinshe <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Isinna «Konne maallaqi hana hexxeexxi misilenna borreessi ayyike?» hiyye insa'nee qore. <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Insa'nenna «Qeesaarixxen» hine.</para>
  <para style="p" vid="MAT 22:21">Yessuusinna insa'nen, «Iittate kaddeechchinni Qeesaarika Qeesaari'a, Mageniinka Magenokee uwwe» hiyye.<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Insa'enna tennee lanqeexxi mambe'a hiyyati isoo waalle me'ine.<verse eid="MAT 22:22" /></para>
  <para style="s1">Reyotenaa'n Ke'atixxee Shiqeeka Qortuma</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mar. 12:18-27</ref>; <ref loc="LUK 20:27-40">Luq. 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Eettenneenn barra, «Reyotenaa'n ke'a hexxeba'a» hitaaxxi Seduuqito Yessuusibaa daggeexxi isoo hite qortee qici;<note caller="-" style="x"><char style="xo" closed="false">22:23 </char><char style="xt" closed="false"><ref loc="ACT 23:8">Erga. Huj. 23:8</ref>.</char></note> <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />«Barrachchiisalloo, Muuse ‹Mitti manji ifixxe arenaa'n i'lebaang reyoole, dayyi isik ookkone reyemmakixxa are aadheexxi isi'a sanne sa'issowwaal› hiyyedheen.<note caller="-" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="LEV 25:5">Lew. 25:5</ref>. </char></note> <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />No'oba torbaane dayyuwa hedhemman; angafi aadheexxi i'lebaang reyemmaxxee are isixxa iso'n aanaak isik dayyi aadhe. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Iittanni aante aantenni langaki sakkakinna torbeessoki qico'n hedheek isee aadha'n reye. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Duuchchiniingi uduma iitti manjichchonna rerte. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Tennexxee, duuchchingi isee aadheemmaxxee reyotenaa'n ke'atixxa barra ookkone torbaan giddii'n ise ayyixxe are kaddaa?» hine qorre.<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yessuusinna insa'nen hiyyeexxi hiisse haaso'ee qici, «Ha'no Woyyichcha Maxaafuwwanna Mageniinxa hunna ege'na gophineemmaxxee dedhake'n ibbina. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Reyotenaa'n ke'at uduma manji iimixxe erganashsha hedhaa malee aadha, heeruming hedhaba'a. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Reyotenaa'n ke'aatixxa uuddaaxxenni kinni Mageni ha'no'n kuleexxa haassositineenni hexxinebaata? <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />Isinna, ‹Ani Abirihaamike, Yisaaqikenna Ya'iqoobike Magenon› hiyye'een; Tennexxee Mageni hedhaakike Mageno malee'e reyeekike Magenobaan» hiyye.<note caller="-" style="x"><char style="xo" closed="false">22:32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Fula. 3:6</ref>.</char></note><verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Ardikinna tennee laqee wodda barachchiisa isixxa saade.<verse eid="MAT 22:33" /></para>
  <para style="s1">Duuchchingenaa'n Sa'aaka Ajaja</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mar. 12:28-34</ref>; <ref loc="LUK 10:25-28">Luq. 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Yessuusinna hiisseeke hiissichchinn Seduuqito sammi asseexxa Feerisito laqqeexxi mitteba bukki hitte. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Insa'ne giddii'n mitti Muuseke seerik barachchiisalli Yessuusii'i hega uudo'a hiyye isoo qoree qici,<note caller="-" style="x"><char style="xo" closed="false">22:35 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Luq. 10:25-28</ref>.</char></note> <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />«Barachchiisallo ajaja duuchchanaa'n sa'aak ajaji hoonte?» <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Yessuusinna hiyyeexxi iso'n hiise haaso'ee qici, « ‹Gootta atika Mageno wo'ma qalbenni, wo'ma lubbonninna wo'ma heduminni eeyi›<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">Lan. 6:5</ref>.</char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Taakakinna duuchchingenaa'n sa'aak ajaji konneten. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Iikki langakinna konnende labaaken; kunninna, ‹Wele manna ifike umishsha eeyi› hiyyaaken.<note caller="-" style="x"><char style="xo" closed="false">22:39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lew. 19:18</ref>.</char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Seer duuchchinna wabeekotixxi barachchiisa duuchchi konne lame ajajuwwi hana ijaarende'een.»<verse eid="MAT 22:40" /></para>
  <para style="s1">Kiristoosi Ayyike Belto?</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mar. 12:35-37</ref>; <ref loc="LUK 20:41">Luq. 20:41</ref>, <ref loc="LUK 20:44">44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Feerisito mitteba bukki hitee'naa, Yessuusi insa'nee hiyya'n qoree qici, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />«Kiristoosixxee ha'no maa hitina'ne? Isi ayyike belto?»</para>
  <para style="p" vid="MAT 22:42">Insa'nenna, «Daawwitike belton,» hineexxi hiissine haasonne.<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Yessuusinna insa'ne, «Yoonata, Daawwiti Woyyichchi Hafuurinn akeekemeexxi haaso'ee wodda hittata isoo ‹Goottaa›? Hiyye ye'a?<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />« ‹Gootti, anka Gootta:</para>
  <para style="q2" vid="MAT 22:44">«Atika naapha atixxi lekka hunda</para>
  <para style="q1" vid="MAT 22:44">Sa'issanno qico'n</para>
  <para style="q1" vid="MAT 22:44">Anke midda'n ofo'li.» ›<note caller="-" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Far. 110:1</ref>.</char></note><verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Tennexxee Daawwiti ifinge uminninn Kiristoosii'i, ‹Goottaa› hiyyeexxi ye'eechchinni, hittata Kiristoosi isike belto kada dande'a?» <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Mitte hiyyichchonna midde Yessuusi'n hiisse haaso'a dande'eek mitti manjinna hedhemmaba'a. Eettene barranaa'ninna saffeexxi isoo qoro'a qophpi hiyye ke'eek ayyinna hedhemmaba'a.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s1">Yesuusi Muuseke Seerika Barachchiisalluwwanna Feeristo Ci'meexxa</para>
  <para style="r">(<ref loc="MRK 12:38-39">Mar. 12:38-39</ref>; <ref loc="LUK 11:43-46">Luq. 11:43-46</ref>; <ref loc="LUK 20:45-46">20:45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Okkoneechchi udima Yessuusi ardake'ninna hordofeeyye ifixe'n hiyyeexxi haaso'ee qici, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />«Muuseke seerik barachchiisalluwwinna Feerisito barachchiisatee Muusexxe bakka'n he'neen. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Tennexxee insa'ne ha'noo ajanjaaxa duuchcha ajajendineexxi asse; yaane kinni haasonneexxa assa gonphaammaxxee insa'ne assinaaxxa assitinoqqe'e. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Ha'urtaaxxanna rakkissaaxxa ba'o usurreexxi manjiinxe dugumo'n feenaan; yaane kinni insa'ne ifi'a qubichcho ifikenn midde eettene ba'o tuqatee macci hinaba'a.<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />«Assinaaxxa duuchcha manji uudo'a assinaan; alba ifike'n uggudhinaaka ashenkitaaba hiyyemaachcho<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="ft" closed="false">Ashenkitaab hiyyemeechchi Ayhudootiink manni woyyichchi maxaafika hiyyichuwwa giddo uggudhdhammaxxe kolonjon</char></note> ba'lisinaa'n; ifixxe qeerraxxe seemmaka handaara qeerrilsinaan.<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="MAT 6:1">Mat. 6:1</ref>; <ref loc="NUM 15:38">Lak. 15:38</ref>; <ref loc="LEV 6:8">Lew. 6:8</ref>.</char></note> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Jilati booncho ulfinniinxa bakka, Ayihudootiinke magenooffachchotike mine'ninna ulfinniinke barcuma'n offo'late eenaan. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Iittanni dikko giddo duuchcha'ninna manni insa'nee ‹Barachchiisallo› hiyya'n naga'a aadhaashsha eenaan.<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />«Ha'no kinni barachchiisalli ha'nook mitte calla kadeemmaxxeenna ha'no duuchchiing dayyuwwake kaddineemmaxxee ‹Barachchiisallo!› hiyyendine ye'endinoqqe'e. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Iittanni iimate'n hedheeka ha'noo mitte anna afineemmaxxee buttate'n ayyeenna ‹Annayyo› hitineexi yexxinoqqe'e. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Barachchiisalli ha'nook Kiristoosi calla kadeemmaxxee ‹Barachchiisallo› hiyyendine ye'endinoqqe'e. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Ha'noonaa'n sa'aak ha'noo'a erganjo kadowwaal.<note caller="-" style="x"><char style="xo" closed="false">23:11 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">Mat. 20:26-27</ref>; <ref loc="MRK 9:35">Mar. 9:35</ref>; <ref loc="MRK 10:43-44">10:43-44</ref>; <ref loc="LUK 22:26">Luq. 22:26</ref>.</char></note> <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Ifi lummisaak duuchchi salphata; ifi salphiisaak duuchchi kinni lumedha.<note caller="-" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="LUK 14:11">Luq. 14:11</ref>; <ref loc="LUK 18:14">18:14</ref>.</char></note><verse eid="MAT 23:12" /></para>
  <para style="s1">Meuuseke Seerik Barachchiisalluwwinna Feereesito Adhdhema Gophpheexxa?</para>
  <para style="r">(<ref loc="MRK 12:40">Mar. 12:40</ref>; <ref loc="LUK 11:39-42">Luq. 11:39-42</ref>, <ref loc="LUK 11:52">52</ref>; <ref loc="LUK 20:47">20:47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />«Manji iimixxe mootumma'n e'yabaashsha, hula cuffina'neek ha'no ifi uggudhdhalluwwi, Muuseke seerik barachchiissalluwwinna Feerisito ha'noo'a aanne'e; ha'no ifi'a e'yitinaba'a; e'yatee eeyyaakaaranna e'yabaashsha assitina. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Ha'no ifi uggudhdhalluwwi Muueseke seerik barachchiisalluwwinna Feeristo aro'o affebaaxxe hiyyeetteka mine mulqexxina'ninna mannakee labbaashsha qeerraxxa soodachcho assitinaammaxxee hara bira saxxeexxi murte ha'noo'n geltaan.<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">Mitti mitte mirqisanji maxaafixxi borruwwa laakkossa 14 lebbaan. Hiyyichchi kuninna Mar. 12:40 welti fakkaatan.</char></note><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />«Ha'no ifi uggudhdhalluwwi Muuseke seerik barachchiisalluwwinna Feerisito, manjo mitte Ayihudiinxe amana'n amanchiisatee abbaayyati hananna wodii hedhebaake boga'n dootina'n, isoo ha'nooxxe amanake hordofallo assexxinnaxxa yanna isoo ha'no caala lame anga gehaannemixxe giirake manjo assitinaammaxxee ha'no'a aanne'e.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />«Balla'a akeekisanjuwwi'a a'noo'a aanne'e; ha'no, ‹Manji mitti Galmake'n kakatoole tinni maachchonnaba'a; Galmi giddixxe worqe'n kakatoole kinni kako iitti isoo abiddaan› hitinaan. <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Ha'no gowwi balla'uwwi, eettenee worqenaa'ninna iitti worqe woyyittete kaddaashsha asseeke ookkone Galminaa'n hoonte sa'a? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Iittanni, ‹Manji tolchimalchoke'n kakatoole tinni maachchonabaan; yaane kinni ookkone tolchimalchi hana hexxeexxe uwwa'ni<note caller="+" style="f"><char style="fr" closed="false">23:18 </char><char style="fqa" closed="false">Uwwa</char><char style="ft" closed="false">Manji Magenokee shiqishaaxxi ergatensha duuchcha uwwa hiyyenda.</char></note> kakatoole kako iitti isoo abiddaan› hitinaan. <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Ha'no koo balla'uwwi! Uwwatenaa'ninna uwwa iitti woyyittete kaddaashsha asseeke tolchimalchinaa'n hoonte sa'a? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Tennexxee ookkone tolchimalcho'n kakateek ookkone tolchimalcho'ninna isi hana tolchemeechcho duuchcha'n kakataan hiyyaten. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Ookkone woyyichcha Galma'n kakataa woddanna ookkonne Woyyichcha Galma'ninna ookkone isi giddo hedheechcho'n kakataan hiyyaten. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Iimate'n kakataak Mageniinxe moote'ninna eettene moote hana ofo'leeke'n kakataan hiyyaten.<note caller="-" style="x"><char style="xo" closed="false">23:22 </char><char style="xt" closed="false"><ref loc="ISA 66:1">Isa. 66:1</ref>; <ref loc="MAT 5:34">Mat. 5:34</ref>. </char></note><verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />«Ha'no ifi uggudhalluwwi Muuseke seerik barachchiisalluwwinna Feerisito bassibelotenaa'n, sugettetenaa'ninna hixichchokeninaa'n tommimitte utinaan; yaane kinn seera Mageniinke'ni umoke kaddeexxa yaanuwwa, tinniirinna dhugaa assaa, gattowaali hiyyanna xuurameessumma waldinaan; eetteneera waldinebaangi tenneeranna assa ha'noo hassissamman.<note caller="-" style="x"><char style="xo" closed="false">23:23 </char><char style="xt" closed="false"><ref loc="LEV 27:30">Lew. 27:30</ref>. </char></note> <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Ha'no Balla'uwwi akeekisanjuwwi! Bookee melmelchitinee fulchitina'n gaala kinni liqinsitinaan.<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />«Ha'no ifi uggudhdhalli Muuseke seerik barachchiisalluwanna Feerisito, ha'noo giddo ifi calli'a hiyyanna mulqedha wo'mitee'naa gadhi darre buudatanna qore ca'a assitnaan. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Koo ati balla'i Feerisichchi gadhi darri ca'a hiyyo'a edisettexxi buudatanna qore giddi darre ca'a assi.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />«Ifi'uggudhdhalli Muuseke seerik barachchiisalluwwinna Feerisito, gadhi darre'n noori itti issemee'naa eleekara, giddi darri kinni reyeeke mannixxi miqe wo'mite'naa batto'eemake hirreessuwwa labbinaammaxxee ha'no'a aanne'e.<note caller="-" style="x"><char style="xo" closed="false">23:27 </char><char style="xt" closed="false"><ref loc="ACT 23:3">Erga. Huj. 23:3</ref>.</char></note> <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Iittanni, ha'no gadho uudaake'n qulliyye fakkaattinaan; yaane kinni giddo ha'no'n ifi'uggudhdhatinna fuggoxxi wo'mite'en.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />«Ha'no ifi'uggudhdhalli Muuseke seerik barachchiisalluwwinna Feerisito ha'no'a aanne'e; ha'no wabeekotika hirreessuwwa ijaartina'n qulliyyetixxa hawultuwwanna danchoossitina'n, <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />‹Edike no'oke annuwwike baro'n silaan he'neennele wabeekoletixxa munde dunati insa'nenni welti mittoommannabaan› hitinaan. <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Tennexxee wabeeko shiyemmake mannixxe oose kadda ha'nooxxa, ha'no umo ifi'nge'n dhugaa kuldina'neen. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Tennexxe annuwi ha'nook safeemmaxxa yaane ha'no baada geessisse.<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />«Ha'no bofuwwi buutetixxi oose, gehaannemixxe murtenaa'n hitta fula dandeettina?<note caller="-" style="x"><char style="xo" closed="false">23:33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">Mat. 3:7</ref>; <ref loc="MAT 12:34">12:34</ref>; <ref loc="LUK 3:7">Luq. 3:7</ref>.</char></note> <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Tennexxe ani wabeeko, beekoletanna barachchiisalluwwa ha'noobaa ergaannen: ha'noonna konneeri giddii'n wele shiltina, wele fannisina, wele kinni ha'nooke magenooffatixxe bakka'n jadhaffina'nee mitte qachchanaa'ni mittinbaa insa'nee shorritina. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Tennexxe ookkone qullichcha Aabeelixxe mundenaa'n ookkone woyyichcha Galmixxenna ookkone tolchimalchixxe oddo'n shiltineemmake Beraakiyuka belto Zakkaariyaasixxe mundee qico'n buttate'n dundineemmaxxe qullitte munde duuchchixxi mura woxxa ha'no'n geltaan.<note caller="-" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="GEN 4:8">Dada. 4:8</ref>; <ref loc="2CH 24:20-21">2 Odo. 24:20-21</ref>.</char></note> <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Dhugaate ha'no'n haaso'annen, tinni mura woxxa duuchchi tennee ilake manna'n geltaan.<verse eid="MAT 23:36" /></para>
  <para style="s1">Yessuusi Iyyerusaalemi'a Oodheexxa</para>
  <para style="r">(<ref loc="LUK 13:34-35">Luq. 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />«Ati wabeeko shilta'ettexxi, atiba ergati dgeekaaranna kinjik cancaqqattoxxe, tee Iyyerusaalemi lukkichcho beltanna ifixxa keela ifike hunda bukki assexxammashsha, me'ele oose atixxa bukki assedha yorenne; ha'no kinni eetinebaan. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Kunse mini ha'nok oonee gataan.<note caller="-" style="x"><char style="xo" closed="false">23:38 </char><char style="xt" closed="false"><ref loc="JER 22:5">Erm. 22:5</ref>.</char></note> <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Tennexxee, ‹Goottiinke summinni dagaak eebbisemeeken!› hitinaa qico'n langaxxa anee affinabaa.» <note caller="-" style="x"><char style="xo" closed="false">23:39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">Far. 118:26</ref>.</char></note><verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">Bariinke Muuxamika Beessisuwwa</para>
  <para style="r">(<ref loc="MRK 13:1-2">Mar. 13:1-2</ref>; <ref loc="LUK 21:5-6">Luq. 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Yessuusi woyyichchi galmi giddii'n fuleexxi me'a'naa woyyichcha galma iso'ni leelishatee hordofeeyye Yesuussixxi Yesuussibaa shiqqe. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Isi kinni insa'ne'n, «Konnee duuchcha uudina'nee? Ani dhugaate ha'no'n haaso'annen, weli hana hedhemmaba hedheemmashshanni diigemebaak gataak mitti kinjinna hedhabaan» hiyye.<verse eid="MAT 24:2" /></para>
  <para style="s1">Goottiinxe Daga Edo kaddaaxxa Rakkonna Shorrichcho</para>
  <para style="r">(<ref loc="MRK 13:3-13">Mar. 13:3-13</ref>; <ref loc="LUK 21:8-19">Luq. 21:8-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Yessuussi Debire Zayitixxe kooba hana ofo'le'naa hordofeeyye isixxi qofinni isibaa daggeexxi, «No'o'n kul, tinni yaane duuchchi kaddaak haanote? Atike dagikinna bariinke muuxamik beessis maachcho?» hitte isoo qorte. <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Yessuusinna insa'nee hiise hiyye haaso'ee qici, «Ayyinna ha'noo dedhisabaashsha heqqedhdhe! <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Heddi manni, ‹Ani Kiristoositen› hiyya'n summa ankenni dagaan; heddo mannanna dedhisaan; <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Bagedokanna bagediinxa odo laqqinaan; tinni duuchcha kada hassissammaxxee mee sodaatte; kaddo malee'e iitti muuxaminxi yanna geltebaan. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Ardi ardake'n, mootummatinna mootummate'n kexxaan; gargar gargar hedheeke booncho'n solo'okinna buttatixxi lele'ma kaddaan. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Kunnichchi duuchchi ciniintotixxe abaraxxe safan.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />«Ookkonee wodda manni ha'noo rakkotee sa'isse uwwaan, shiyatanna shiyaan; anke summixxeenna arduwwa duuchcha'n jibbendinaan.<note caller="-" style="x"><char style="xo" closed="false">24:9 </char><char style="xt" closed="false"><ref loc="MAT 10:22">Mat. 10:22</ref>. </char></note> <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Ookkonee wodda heddi manni amana ifixxe'n guggufataan; welinna sa'isse uwwaan; welinna gibaan. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Heddo dhariyye wabeekonna kexxeexxi heddo mannanna dedhissaan. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Fuggotixxe bira sa'nenaa'n kexxeexxa heddi mannixxi jaalala qiddaan. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Muuxamiin qico'n jabaate ossaak isi kinni anjirema.<note caller="-" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">10:22</ref>. </char></note> <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Ardi duuchchi'a dhugaa kulate kaddo'a tennee Mageniinxe mootummaxxi wengeele butta duuchcha'n lallabendan; ookkonechchi udumanna iikki muuxami daga.<verse eid="MAT 24:14" /></para>
  <para style="s1">Jabaxxa Rakko</para>
  <para style="s1">(Mar. 13:14-23, Luq. 21:20-24)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />«Wabeeka Daani'eel darree'n iitti kulendemmaxxi ba'ne iyyedagaaxxi diqachchiisaaxxi yaane woyyitte bakka'n uurritee'naa affinaa wodda haaseessalli qalbeeffatowwaal!<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">Dan. 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref>. </char></note> <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />Eettenee yanna Yihudake boga'n hedheek manni koobuwwate'n baajowwal. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Ifike minixxe heellichcho hana hedheek ayyinna mine ifikee'n mittechcho adhdho'a butti'a dirroqqe'e.<note caller="-" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="LUK 17:31">Luq. 17:31</ref>. </char></note> <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Fichchi giddo hedheek seema ifixxa adhdho'a udumi'a higoqqe'e! <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Eetenee yanna siila'witeexxeeri'aanna unuunisita'neexxeeri'a aanne'e! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Baaja ha'nooxxi haarso yookaan Edi Sanbatixee barra kaddabaashsha soodatte! <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Eettenee yanna butta dadendeexxe barranaa'n techchi qico'n kaddebaaxxi edi'aanna kaddabaaxxi lumoxxe rakko kaddaan. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Tinni barruwwa haru'ma gophphee'ya mitti manjinna silaat gatamabaan; yaane kinni ookkone filemeeke mannixxee itti barruwwa harumitaan. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Eettenne yanna ayyinna ha'no'n, ‹Kunse, Kiristoosi kaba hedheen› yookaan ‹Ookko hedheen› hiyyoole addatinoqqe'e! <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Dhariyye Kiristoositonna dhariyye wabeeko kexxaan; insa'nenna dandeessisseele ookkonee filemeeka manna midde dedhisatee lumolla beesisuwwanna masuwwa assinaan.<note caller="-" style="x"><char style="xo" closed="false">24:24 </char><char style="xt" closed="false"><ref loc="DAN 12:1">Dan. 12:1</ref>; <ref loc="REV 7:14">Wal. 7:14</ref>. </char></note> <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Kunse, ani ha'no'n ediseen kuleennen.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />«Tennexxee ha'no'n ‹Kunse, qiilla gammaoojje giddo hedheen› hinoole fuldinoqqe'e; ‹Kunse, gaadi giddo hedheen› hinoole amandinoqqe'e.<note caller="-" style="x"><char style="xo" closed="false">24:26 </char><char style="xt" closed="false"><ref loc="LUK 17:23-24">Luq. 17:23-24</ref>, <ref loc="LUK 17:28">28</ref>. </char></note> <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Balaqi borotenaa'n balaqeexxi dhidhimii qico'n leellammashsha, Manjiinke Beltixxi daganna iittande kaddaan. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Renshi hedheeba'a allaattuwwa bukki hita.<note caller="-" style="x"><char style="xo" closed="false">24:28 </char><char style="xt" closed="false"><ref loc="LUK 17:37">Luq. 17:37</ref>. </char></note><verse eid="MAT 24:28" /></para>
  <para style="s1">Kiristoosixxa Langaxxa Daga</para>
  <para style="r">(<ref loc="MRK 13:24-27">Mar. 13:24-27</ref>; <ref loc="LUK 21:25-28">Luq. 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />«Eettene rakkotixxe barran uduma hirbange'n arishsho dukkandaan, agenjikinna ifa uwwaba'a; urjuwwatinna iimi'ni ibba, iimixxi hunnuwwanna lele'mitaan.<note caller="-" style="x"><char style="xo" closed="false">24:29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isa. 13:10</ref>; <ref loc="ISA 34:4">34:4</ref>; <ref loc="EZK 32:7">Hiz. 32:7</ref>; <ref loc="JOL 2:10-31">Iyu. 2:10-31</ref>; <ref loc="JOL 3:15">3:15</ref>; <ref loc="REV 6:12-13">Wal. 6:12-13</ref>; <ref loc="DAN 7:13">Dan. 7:13</ref>; <ref loc="ZEC 12:10-14">Zek. 12:10-14</ref>; <ref loc="REV 1:7">Wal. 1:7</ref>.</char></note><verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />«Ookoneechchi uduma Manjiinke Beltik beessis iimate'n lellaan; ookkone wodda buttatik arduwwi duuchchi oodha. Insa'nenna Manjiink Belti iimatike duumanchinni, hunnatinna lumok gaachchanninni daga'naa anfaan. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Isinna lumoka malagatiinka hafuura laqisaaxxa ifixxa ergana ergaan. Ergannatinna buttike shooliinge kasuwwinaa'n, mitte iimatike kasinaa'n welii qico'n hedheeka isi'a fileemeeka manna bukk assitaan.»<verse eid="MAT 24:31" /></para>
  <para style="s1">Balasetika Haqichcho</para>
  <para style="r">(<ref loc="MRK 13:28-31">Mar. 13:28-31</ref>; <ref loc="LUK 21:29-33">Luq. 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />«Balasetika haqichchonaa'n tennee baracho adhdhe: ise damuwwa qacceexxi shiffuwwa quuffa wodda boni<note caller="+" style="f"><char style="fr" closed="false">24:32 </char><char style="fqa" closed="false">Boni </char><char style="ft" closed="false">Kunni hiyyichchi leelishaak insa'nek boga'n haqqe qacca woddinna shafuwwi qufaa woddi bon shiqaa wodda kademaxxeeten.</char></note> shiqeexxa egendinaan. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Iittanni ha'no tennee yaanuwwa duuchcha afinaa wodda, manjiinke Beltixxi daga hara shiqqe'eexxa ege'ne! <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Dhugaate ha'no'n haaso'aannen, tinni yaane duuchcha kaddaa qico'n tinni ila saxxabaan. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Iimanna butta saxxaan, hiyyichchi ank kinni haranga sa'abaan.<verse eid="MAT 24:35" /></para>
  <para style="s1">Goottinxe Dagaxxi Barranna Yanna Ege'nedabaaxxa</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mar. 13:32-37</ref>; <ref loc="LUK 17:26-30">Luq. 17:26-30</ref>, <ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />«Eettenee barranna eettenee yanna Aabii malee'e, iimixxi ergannanna kaddo'o Aabike Beltokenna kado'o ayyinna ege'naba'a. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Nohike baro'n kaddemma qicishsha Manjiinke Beeltixxi daganna iittande kaddaan.<note caller="-" style="x"><char style="xo" closed="false">24:37 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">Dada. 6:5-8</ref>. </char></note> <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Ookkone barruwwa'n balleesamak wodi'i edi ga'ma, Nohi ookkone markabi giddi'a e'yeexxe barra qico'n manni ita'n ha'wa'n, aadha'ninna heerunsiisa'nee hedheemman. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Balleessamak iikki woddi'i dageexxi duuchchinga fiyeexxi adhdha qio'n egenneemmabaashshanni Manjiinke Beltixxi daganna iittande kaddaan.<note caller="-" style="x"><char style="xo" closed="false">24:39 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">Dada. 7:6-24</ref>. </char></note> <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Eettenee yanna lami manji fichchi giddo hucca, mitti adhdhema, mitti gata. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Lame melaalle daamma dalta, mitte adhdhenda, mitte gatta.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />«Yoona Gootti ha'nook heene barra dagaaxxa egendinammabaaxxee dammaqineexxi heqqedhdhe! <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Tennee qalbeeffatte, miniink anni moodhachchi hashsha heene yanna'n dagaaxxa ege'neele silaat dammaqe mini ifik umemabaashsha heqqedhamman. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Manjink Belti keekkattinebaaxxe saate'n daggammaxxee ha'nonna iittanni qixxeeffattineexxi heqqedhdhe!<note caller="-" style="x"><char style="xo" closed="false">24:44 </char><char style="xt" closed="false"><ref loc="LUK 12:39-40">Luq. 12:39-40</ref>. </char></note><verse eid="MAT 24:44" /></para>
  <para style="s1">Xurameesiinxeenna Fuggichchi Erganjixxee Mamaassaa</para>
  <para style="r">(<ref loc="LUK 12:41-48">Luq. 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />«Yannate'n mini hadixxa ita insa'ne'a uwwaashsha gootti mini hado ifike'n baalloonseek iikki xuurameessinna qalbaamessi erganji ayyete? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Isik gootti illeema higeexxi dagaa wodda iitta huja'n afemaak iikki erganji eebbisemeeken. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Dhugaate ha'no'n haaso'aannen, gooti ookkone erganjo, ifixxe karra duuchcha'n baalloonsaan. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Yaane kinni iikki fuggichchi erganji fuggichchake kadoole, ‹Gooti ank dagebaang turaan› hiyya'n, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />welti hujammaka manna ganete'n ke'oole, machcho'alluwwik weltinna ite ha'woole, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />isi heqqebaaxxe barra'ninna ege'nebaaxxe saate'n gootti isik dageexxi <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />isoo mura woxisaan; ifi uggudhdhammake manni mura woxamaba'aanna me'aashsha assaan; ookkonna oodhishshanna isso qadhdhate kadda.»<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">Tomme Dubarrika Mammaassa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />«Eettenee yanna iimixxi mootumma xassa ifi ifika abixxeexxi ookkonee waajubichcho qophedha fuleeke tomme dubarra fakkaattaan.<note caller="-" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="LUK 12:35">Luq. 12:35</ref>. </char></note> <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Insa'ne giddii'n ondi gowwakemman; ondi kinni qalbeeffatammakemma'a. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Iikk gowwi dubarri xassiinka miya abixxee malee'e geltaaxxa xassiinxa zaiyte afeemmaba'a. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Iikk qalbaamessi dubarri kinni ifi ifike xassinni welti geltaaxxa xassiinxa zayite xassiinke mi'uwwi giddo afe'eeman. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Iikki waajubichchi dagebaang turaa wodda mugi loolloosee'naa duuchchiingi dubarri diiphe.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />«Hashsha wodhakki geyee wodda, ‹Iikk waajubichchi dagete'n hedheen fuldineexxi qophedhdhe!› hiyyaak canci laqeme.<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />«Eettene yanna iikk tommiing dubarri dammaqeexxi ifi fika xassa qophpheesedhe. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Iikki gowwi dubarri ookkonee qalbaameessa dubarra, ‹No'ok xassi xo'aaten; ha'nooxxe xassiinxe zayitenaa'n no'aa uwwe!› hiyye.<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />«Qalbaamessi dubarri kinni insa'ne'n, ‹Anfe'eennexxi zayite no'aanna ha'no'aa geltabaan; martineexxi gurgurammake mannanaa'n ifi'a hidhdhe› hiyye hiisse haaso'e.<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />«Iikki gowwi dubarrinna xassiinxa zayite hidho'a me'eeke'n iikki waajubichchi dage. Iikki qixxeeffateemmak ondi qalbaamessi dubarri waajubichchik welti jilatike mine'ni e'ye; hulatinna cufende.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />«Udumi giddii'n gate'eemmak iikki weli dubarri dageexxi isoo, ‹goottaa goottaa! Hula no'o'a bani!› hiyye.<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />«Isi kinni, ‹Ani dhugaate ha'no'n haaso'aannen, ha'no ege'nebe'no› hiyya'n insa'ne'n hiisse haaso'e.<note caller="-" style="x"><char style="xo" closed="false">25:12 </char><char style="xt" closed="false"><ref loc="LUK 13:25">Luq. 13:25</ref>. </char></note><verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />«Tennexxee baratanna saate ege'ndinammabaaxxee qixxeffatine heqqedhdhe!<verse eid="MAT 25:13" /></para>
  <para style="s1">Makilite Uwwendemmake Sase Erganjuwwixxee Mammaassaa</para>
  <para style="r">(<ref loc="LUK 19:11-27">Luq. 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />«Mageniinxi mootumma, erganjuwwa ifika ye'eexxi afe'eexxa karra insa'ne'n maganne uwweexxi welebaa me'a ke'eeke manjichcho fakkaattaan.<note caller="-" style="x"><char style="xo" closed="false">25:14 </char><char style="xt" closed="false"><ref loc="LUK 19:11-27">Luq. 19:11-27</ref>.</char></note> <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Mitte mittengee dande'a isi isixxeshshanni, mittekee onde Mekiilite<note caller="+" style="f"><char style="fr" closed="false">25:15 </char><char style="ft" closed="false">Mekiilite, mitte mikiliite mitte barratike hujallike tommenna onde woggake rund iimidarrenni. </char></note>; mittekeenna lame taalante; iittanni mittekee mitte taalante uwweexxi wele bogibaa me'e. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Iikki onde taalante adhdhemmak manjichchi me'exxi, maallaqa ookkonenne dadaleexxi onde taalante ibise. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Iittanni lame taalante adhdhemmakinna daddaleexxi wele lame taalante ibise. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Mitte taalente adhdhemmak iikki manjichchi kinni bale umeexxi ookkonee ifike gootika maallaqa mooge.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />«Ookkone erganjuwwik gootti lumoxxe yanna uduma dageexxi insa'ne'n uwwemmaka maallaqa maa assineexxa haassonaa insa'nee qore. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Onde taalentek adhdhemmak iikki manjichi wele onde taalente adhdhe shiqeexxi, ‹Anke gootta ane'n onde taalente uute'ettan; kunse wele onde taalente ibiseennen!›<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />«Gootti isikinna isoo ‹Elo qico hujje'eetten; ati elokinna xuurameessi erganj! Heenoxxe yaane'n xuurameessake kaddeeten, ani atee heddo yaane'n baalloonsannon. Amo atike gootixxe gammashsho'n e'yi› hiyye.<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />«Lame taalente adhdhemmak iikki manjichchinna shiqeexxi, ‹Anke gootta ane'ni lame taalente uute'eetan; kunse wele lame taalente ibiseennen› hiyye.<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />«Gootti isikinna ‹Eloxxen, ati elokinna xuurameessi erganji heenoxxe yaane'n xuurameessa kaddeeten, heddo yaane'n atee baallonsannon. Amo atike goottixxe gammashshobaa e'yi› hiyye.<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />«Mitte taalente adhdheemmak iikki manjichchinna shiqeexxi, ‹Anke goottaa ati rokkebexxoke boonchinaa'n haa'mitatoke, facaassebexxoke boonchinaa'ninna bukk assexxatoke marartabexxoke manjo kaddettexxa ege'neennen. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Tennexxee atee sodaattennexxi taalente atixxa ume sho'eennen. Ane'n uutetak atik maallaqi kunse› hiyye.<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />«Isik goottinna iso'n hiyye hiisse haaso'ee qici, ‹Koo ati fuggichchinna booso'i erganji! Facaasebe'no boonchinaa'ni ha'mannoxxa, rokkebe'noke boonchinaa'n bukki assedhanoxxa egendeetechchinni, <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />hige daganno wodda maallaqa anka ilee'naa adhdhannoshsha ati dadalaake manna'n uwwa hassissamman.<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />« ‹Yoonna amme isixxa eettene taalente isonaa'n aaxineexxi tomme taalente afe'eemmakee uwwe. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Afe'eekee lebenda, isi'aanna bira saxxa. Afebaakenaa'n iikki afe'eemmangeechchi midde adhdhema.<note caller="-" style="x"><char style="xo" closed="false">25:29 </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mat. 13:12</ref>; <ref loc="MRK 4:25">Mar. 4:25</ref>; <ref loc="LUK 8:18">Luq. 8:18</ref>.</char></note> <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Konnee woyi fulabaaka erganjo fulchitineexxi gadhi'a dukkanate'n hunne! Ookonna oodhishshanna isso qarate kaddaan› hiyye.<note caller="-" style="x"><char style="xo" closed="false">25:30 </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mat. 8:12</ref>; <ref loc="MAT 22:13">22:13</ref>; <ref loc="LUK 13:28">Luq. 13:28</ref>. </char></note><verse eid="MAT 25:30" /></para>
  <para style="s1">Bariinke Muuxama'n Murendaaxxa Murte</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />«Manjink Belti eettene erganna duuchchinni ifike ulfinninni dagaa wodda ifike ulfinnixxe moote hana ofo'laan.<note caller="-" style="x"><char style="xo" closed="false">25:31 </char><char style="xt" closed="false"><ref loc="MAT 16:27">Mat. 16:27</ref>; <ref loc="MAT 19:28">19:28</ref>. </char></note> <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Gosa gosaki ardi duuchchinna isi edo bukki hiyyaan; allalisanji gedhebo re'etenaa'n gargar foyammashsha isinna arda mitte mittekenaa'n gargar foyaan. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Gedhebo ifike midda'n re'etanna ifike bita'a'n uurrisaan.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />«Ookonee wodda Moyanji ifike midda'n hedhemmakaara hiyyaa qici, ‹Ha'no anni ank eebbiseek manni, amme butta dadendeexxe barranaa'n ha'no'aa qixxeessendeexxa mootumma dhaalle. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Solo'we'naa anee itissinne'een, dhebowe'naa anee ha'wisine'een, keessummumma dage'naa anee keessunsitine'een; <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />daaree'naa anee oddessitine'een, elagophe'naa anee laqqine'een; usureme'naanna daginee anee uudine'een.›<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />«Ookkonee wodda qulliyye iittinna iso'n hissite hita'n haasottaa qici, ‹Goottaa haano solo'wite'naa anfee atee itinsenne? Dheebottenaa haano anfee atee ha'winsenne? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Keesummumma haano dagge'naa anfee atee keensunsiinnenne? Daarte'naa haano anfee atee oddeessinnenne? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Elagophee'naa yookaan usurendee'naa haano anfee dange atee uundenne?›<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />«Moyanjikinna insa'ne'n, ‹Dhugaate ha'no'ni haaso'aannen, konne anke dayyuwwinaa'n ookkone shiixxedhaake mitti'a assitineexxi ani'a assitineeshshaten› hiyye hiisse haaso'e.<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />«Ookkoneechchi uduma moyanji ifke bita'a'n hedheekaara hiyyaa qici, ‹Ha'no badinendineek manni seexanakeenna isixxe erganna'a qixxeessendeexxe duuchchi woddixxe giiraba'a anenaa'n bayyatine me'we. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Solo'wee'naa anee itisineba'a, dheebo'we'naa anee ha'wissineba'a. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Keessummumma dagee'naa anee keesunsitineba'a, daaree'naa anee oddeessitineba'a, elagophee'naa, usureme'naanna daggine anee uddineba'a.›<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />«Insa'nenna, ‹Goottaa, solo'wite'naa yookaan dhebo'witee'naa yookaan keesummumma dagge'naa yookaan daartee'naa yookaan, elagophee'naa yookaan usurendee'naa haano anfe atee gargaara gonphenne?› hine hiissine haassonna.<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />«Moyanjikinna insa'ne'n, ‹Dhugaate ha'no'n haaso'aannen, konne shiixxedheeke anke dayyuwwinaa'n mittekee ha'no assa gopha ani'a assa gophineeshshaten› hiyye hiisse haaso'e.<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />«Tennexxee insa'ne duuchchii woddixxe mura woxxaba'a, qulliyye kinni duuchchii woddixxe hedhobaa me'ita.»<note caller="-" style="x"><char style="xo" closed="false">25:46 </char><char style="xt" closed="false"><ref loc="DAN 12:2">Dan. 12:2</ref>. </char></note><verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">Yessuussi'n Assemeeka Diina</para>
  <para style="r">(<ref loc="MRK 14:1-2">Mar. 14:1-2</ref>; <ref loc="LUK 22:1-2">Luq. 22:1-2</ref>; <ref loc="JHN 11:45-53">Yoh. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Yessuusi tennee yaane duuchcha haaso'e bireechchi uduma ifixxe hordofeeyye'n <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />«Lame barranni uduma sa'aatike ayyaanixxe barra kaddeexxa egendine'een; Manjiink Belti fannisemo'a sa'isseme uwwemaan» hiyye.<note caller="-" style="x"><char style="xo" closed="false">26:2 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">Fula. 12:1-27</ref>. </char></note><verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Ookkoneechchi uduma qeesetik sooreessuwwinna ardiinxi geedhe umo qeesichcho kadeeke Qeyyaafa hiyyemmaake manjichchixxe baxxe'n bukki hineexxi, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Yessuusii'i malik abindeexxi shiyatee mari'ante. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />«Yaane kinni insa'ne, Ardi lele'mabaashsha ayyaaniinxe barra kaddoqqe'e» hine.<verse eid="MAT 26:5" /></para>
  <para style="s1">Yessuusi'n Shitto Issiteexxa Manjichcho</para>
  <para style="s1">(Mar. 14:3-9, Yoh. 12:1-8)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Yessuusi Biitaaniya, ookkonee soomi abideeke Simi'oonike mine'n hedhee'naa <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />mitte manjichcho hiri hara fiixxeexxa, albasixiroosixxe bilqaaxxe'n shitto aaxxe Yessuusibaa shiqqeexxi, Yessuusi itate'n hedhee'naa umo Yesuusik hana dunde.<note caller="+" style="f"><char style="fr" closed="false">26:7 </char><char style="fqa" closed="false">Albasixirosi </char><char style="ft" closed="false">Ulfink miyi hujemaake golaloke kinjon.</char></note><verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Hordofeeyyetinna tennee manjichcho assiteexxa yaane uudde mufatteexxi hittee qici, «Tinni faango'a mayeete? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Tinni shitto lumoke hira'n gurgurende'naa maalaqi iikki hiyyeeyyetee uwwemaa dande'amman.»<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Yessuusinna tennee ege'neexxi insa'ne'n hiyyee qici, «Tennee manjichcho maaye rakkissina? Ise dancha yaane ani'a assite'een. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Hiyyeeyye duuchchii wodda ha'noonni hexxaan, ani kinni duuchchii wodda ha'noonni hedhabe'non.<note caller="-" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="LEV 15:11">Lew. 15:11</ref>. </char></note> <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Ise tennee shitto anke biso'ni duna anee mooggokee qixxeessateeten. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Dhugaate ha'no'n haaso'aannen, tinni wongeele lallabendaaba, butta duuchcha'n hoone booncho'ninna tinni ise assiteexxi yaane isee qalli assatee'e kulendaan.»<verse eid="MAT 26:13" /></para>
  <para style="s1">Yihuda Yessuusii Sa'isseexxi Uwwate Weli Aageexxa</para>
  <para style="r">(<ref loc="MRK 14:10-11">Mar. 14:10-11</ref>; <ref loc="LUK 22:3-6">Luq. 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Ookkoneechchi uduma tommenna lamekenaa'n mitti Asiqorootuke qachchik Yihuda qeesetike sooreessuwwibaa mareexxi, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />«Yessuusii'i ha'no'aa sa'isse uwwonnole maachcho ani'a uutina?» hiyye insa'ne qore. Insa'nenna sase tomme birret sibljo<note caller="+" style="f"><char style="fr" closed="false">26:15 </char><char style="fqa" closed="false">Biretika Sibljo </char><char style="ft" closed="false">Mittichchinna itti lebemebaaka luqqichcha biretike sbljo hiyyaten. </char></note> isi'a uune.<note caller="-" style="x"><char style="xo" closed="false">26:15 </char><char style="xt" closed="false"><ref loc="ZEC 11:12">Zek. 11:12</ref>. </char></note> <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Eettene yannanaa'n Yihuda Yessuusii'i sa'isse uwwaaxxa eloxxa yanna hase'emman.<verse eid="MAT 26:16" /></para>
  <para style="s1">Yesuus Sa'atike Ayyaanika Dhiyaana Ifixxe Hordofeeyyenni Welt Iteexxa</para>
  <para style="r">(<ref loc="MRK 14:12-21">Mar. 14:12-21</ref>; <ref loc="LUK 22:7-14">Luq. 22:7-14</ref>, <ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yoh. 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Kebbotike ayyaanixxe siretixxe barra'n hordofeeyye Yessuusibaa shiqqeexxi isoo, «Ita Sa'atike ayyaanixxa ittottaa haba ati'a qixxeessinonnole eettato?» hite isoo qorte.<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Isinna, «Qachchi giddo ebeli mine martineexxi iso'n Barachchiisalli, ‹Yanna anixxi gelte'een; hordofeeyye anxenni welti sa'atika ayyaanna atike mine'n ulfeessonaaten hiyya'neen› » hitineexxi kulle hiyye.<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />Hordofeeyyetinna Yessuusi insa'nee ajajemmashshanni assitte; Sa'atike ayyaanixxa itanna qixxeessite.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Bogi galgalo'ee wodda Yessuusi tommenna lame hordofeyyenni welti itatee ofo'le. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Itate'n he'neenge'n Yessuusi insa'ne'n, «Dhugaate ha'no'n haaso'annen, ha'no giddii'n mitti anee sa'isse uwwaan» hiyye.<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Insa'nenna lumoo qico yaandeexxi mitti mittingi isoo, «Goottaa ante kadunnuu?» hiyyate'n ke'ne. <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Yessuusinna insa'ne'n, «Anee sa'isseexxi uwwaak aninni welti itatee anga qore giddo ugge'eeken» hiyye hiisse haaso'e.<note caller="-" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="PSA 41:9">Far. 41:9</ref>. </char></note> <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Manjiink Belti isixxee borressendemmashshanni reyaan. Yaane kinni Manjiinka Belto sa'isse uwwaake ookkone manji'a isi'a aannee; iikki manji ilemaa gophe'eele silaati isi'a woyyamman.<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Sa'isse isoo uwwa'neek Yihuda kinni isoo, «Barachchiisalloo, ante kaddunuu?» hiyye. Yessuusinna «Ati hitetteshshanden» hiyye.<verse eid="MAT 26:25" /></para>
  <para style="s1">Goottiinka Hirbaata</para>
  <para style="r">(<ref loc="MRK 14:22-26">Mar. 14:22-26</ref>; <ref loc="LUK 22:15-20">Luq. 22:15-20</ref>; <ref loc="1CO 11:23-25">1 Qor. 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Itande'n he'nee'naa Yessuusi buddeena aadhe galateeffate kukkuteexxi ifixxe hordofeeyye'n, «Hii'we itte; kunni maala anken» hiyye uwwe.<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Ookkoneechchi udma buudattanna aadheexxi galateeffateechchi uduma insa'nen hiyyee qici, «Ha'no duuchchiing tenne buudanna'ni ha'we. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Tinni heddi mannixxe cubboxxee gattowwaali'a dundaaxxe haaroxxe kakoxxe anxe munden.<note caller="-" style="x"><char style="xo" closed="false">26:28 </char><char style="xt" closed="false"><ref loc="EXO 24:8">Fula. 24:8</ref>; <ref loc="JER 31:31-34">Erm. 31:31-34</ref>. </char></note> <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Ha'no'n kulo, anke annixxe moote'n haaroxxa woyinexxe gummaxxa ha'wa ha'nonni welti ha'wannoxxe eettene barra qico'n ta'inaa'n safennexxi tenne woyinexxe gummaxxa ha'wa ha'wabe'no» <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" />Faarotanna faarsineechchi uduma Debrezayitixxa koobaba'a qabante.<verse eid="MAT 26:30" /></para>
  <para style="s1">Pheexiroosi Isoo Waakataaxxa Yessuusi Edise Haaso'e</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mar. 14:27-31</ref>; <ref loc="LUK 22:31-34">Luq. 22:31-34</ref>; <ref loc="JHN 13:36-38">Yoh. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Ookkoneechchi uduma Yessuusi hordofeeyyete'n hiyyee qici, «Maxaafake'n ‹Allalisanjo ganannon, gedhebikinna xeeremaan› hiyyendee borreessendemaxxee ha'no duuchching tennee hashsha anee waakkattinaan.<note caller="-" style="x"><char style="xo" closed="false">26:31 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">Zek. 13:7</ref>. </char></note> <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />Yaane kinni reyotenaa'n ke'ennechchi uduma ha'no'a edise Geliila'a me'annon» hiyye.<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Pheexiroosinna, «Weli duuchchiing midde atee waakkatoole ani atee haranga waakkatabe'no» hiyye.<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Yessuusinna «Dhugaate ate'ni haaso'annen, tenne hashsha lukichchi baroodebaa edi darre ‹Isoo ege'nebe'no› hita'ni sasele anee waakkattatton» hiyye. <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />Pheexiroosi kinni, «Reyatenna kaddoole midde atinninni welti reyanno malee'e haranga atee waakkatabe'no» hiyye. Hordofeeyye duuchchiinxinna tenneenni hite.<verse eid="MAT 26:35" /></para>
  <para style="s1">Yessuusi Geete Semaani Mageno Soodate</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mar. 14:32-42</ref>; <ref loc="LUK 22:39-46">Luq. 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Ookkoneechchi uduma Yessuusi ifixxe hordofeeyyenni welti Geetesemaani hiyyendaaxxe bakkabaa me'eexxi insa'nee, «Ookkoo marennexxi soodatanno wodda ha'no kabanni ofo'le» hiyye. <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Pheexiroosinna, lame Zebidewoosixxa oose adhdhe me'eexxi yaadate'ninna wixixxi hiyyate'ni ke'e. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />«Lubbo anxi yaaddoti reyo shiqqe; aninni welti ossitineexxi kabanni turre» hiyye. <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Insa'nenaa'n shiixxoo qico bayyate me'e albik gonbisemeexxi, «Anke anna dandeessissaaxxe kaddoole tinni buuda anenaa'n saxxowwaal; yaane kinni fedhii atixxishshate kaddo malee fedhii anixxishsha kaddoqqe'e» <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />Ookkoneechchi uduma hordofeeyyetibaa ille iima higgeexxi daggaa wodda diinphee'naa afe; Isinna Pheexiroosii'i hiyyee qici; «Aninni welti mitte saate midde dammaqine tura dande'a gophphineeshshatebaata?»<verse eid="MAT 26:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 26:41" />«Hega uudendinabaashsha jabaattineexxi Mageno soodatte; hafuuri qixxeeffateen; maali kinni gophaalessaken.»<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Higgeen langaxxa me'eexxi, «Anke Annaa, tinni ani ha'webe'nok saxxa'nebaaxxe buuda kaddoole fedhii atixxe kaddowwaal» hiyye soodate.<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Ille iima hige dagaa wodda ille insa'nexxe'n mugi ha'ureemmaxxee dhiinphee'naa afe. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Insa'nenna ookkonni waale'e woldinbaa me'eexxi woldo Mageno soodatammashshanni sakkaxxanna soodate. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Ookkoneechchi uduma hordofeeyyetiba'a dageexxi insa'ne'n hiyyee qici, «Ta'anna diiphphine hafuura adhdhande'n hexxinee? Kunse yanna gelte'een; Manjiink Belti cubbaaleyyetixxe anga'n sa'isseme uwwemaan; <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />ke'we me'ino; anee sa'isse uwwaak dagate'n hedheen.»<verse eid="MAT 26:46" /></para>
  <para style="s1">Yesuusixxa Abidensha</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mar. 14:43-50</ref>; <ref loc="LUK 22:47-53">Luq. 22:47-53</ref>; <ref loc="JHN 18:3-12">Yoh. 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Yessuusi haaso'ande'n hedhee'naa tommenna lame hordofeyyenaa'n mmitti Yihuda dage. Isinni welti qeesetik sooreessuwwinaa'ninna ardiinxe gedhenaa'n ergemeek heddi manni wolaantichchuwwakanna dulluwwa abixxeek isinni welt hedhemman. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Yihudanna, «Ani sunqannok isoten, isoo abidde» hiyyeexxi beessisa insa'ne'n uwweemman.<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />Iikki woddi Yessuusibaa mareexxi, «Barachchiisalloo nage'i ati'a kadowwaal!» hiyya'n isoo sunqedhe.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Yessuusinna isoo «Koo anke jaaloo daggeettechcho muuxi!» hiyye.</para>
  <para style="p" vid="MAT 26:50">Eettenee yanna iikki manni dage'e Yessuusii'i abideexxi usure. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Eettene yanna'n Yessuusinni welti hedhdhemmake manninaa'n mitti ifika wolaantichcha xuqqi asse aadhati qeesetike sooreessike erganjixxa mansha kute.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Yessuusinna isoo hiyyee qici, «Wolaantichchik ke'aak duuchchi wolaantichchik ba'aani; wolaanticha atika gonofi giddi'a hissi. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Anna anka ye'edhennele iikki woddi heddo kumi caala laakko'emaaka erganatika sannachcha ani'a erga dande'abaachcho ate'n labbe? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Yaane kinni iitta assaannole woyyichchi maxaafi kaddaan hiyyemmaxxi yaanuwwa hitta muuxendata?»<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Eettene yanna'n Yessuusi arda, «Bokkaame abidina'neeshsha wolaantichchakanna dulla abixxitineexxi anee abidino'aa daggineebaata? Barra barra'n woyyichchi galmi giddo offo'le barachchiisaanna wodda anee abidineemmabaan.<note caller="-" style="x"><char style="xo" closed="false">26:55 </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luq. 19:47</ref>; <ref loc="LUK 21:37">21:37</ref>. </char></note> <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Yaane kinni tinni duuchchi kaddeechchi wabeeko woyyichcha maxaafa'n haassottemmaxxi muuxendo'aaten,» Eettenee yanna hordofeeyye duuchiinxi isoo waalde baajje.<verse eid="MAT 26:56" /></para>
  <para style="s1">Yessuusi Ayihudiinxe Songo Edo Shiqe</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mar. 14:53-65</ref>; <ref loc="LUK 22:54-55">Luq. 22:54-55</ref>; <ref loc="JHN 18:13">Yoh. 18:13</ref>; <ref loc="JHN 14">14</ref>; <ref loc="JHN 19:24">19:24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Yessuusii'i abideemmak manni Muuseke seerik barachchiisalluwwinna ardiinxi geedhe bukki hiteemmaba'a, ookkonee umo qeesichcho Qeyyaafaba'a isoo iyyemarre. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Yaane kinni Pheexiroosi bayyateexxi ookkone umo qeesichchixxe baxxe qico'n isoo hordofaamman; giddi'aanna e'yeexxi eettene yaaneka muuxama uudo'a baxxetike ookkone heqqanjuwwinni welti ofo'le.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Eettene yanna Qeesetik sooreessuwwinna Ayihudiinxe Songoxxi duuchcha Yessuusii shilshiisatee'e dhariinxa dhugaa kula hanseemman. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Yaane kinni heddo dhariinxi dhugaa kula shiqqoolenna isoo reyotee geessissaaxxa yaane kuldaaxxi dhuga kula afendeba'a.</para>
  <para style="p" vid="MAT 26:60">Udumii giddii'n lami manni ke'eexxi, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />«Kunni manji, ‹Ani Mageniinka woyyichcha galma diigennexxi sase barra giddo isoo hiisse ijaara dande'annon› hiyye haaso'edheen» hine.<note caller="-" style="x"><char style="xo" closed="false">26:61</char><char style="xt" closed="false"><ref loc="JHN 2:19">Yoh. 2:19</ref>. </char></note><verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Eettene yanna iikki umi qeesichchi ke'e uurreexxi Yessuusii'i, «Kunni manni ate'n dhugaa kula'neexxee mitte hissichchonna uuta'ebexxoo?» hiyye. <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Yessuusi kinni sammiyye.</para>
  <para style="p" vid="MAT 26:63">Iikk umi qeesichchinna Yessuusii'i, «Hedhaake Magenike summinni atee laqa'ennen! Ati Mageniinke Belto Kiristoosite kaddo'oottole no'o'n kuli» hiyye.<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Yessuusinna, «Tinni ati hitetteshshanden; yaane kinni hegeri Manjiink Belti ookkone Hunnaammessa Mageninke midda'n ofo'leexxi iimatike duumanchinni dagaa wodda uuddinaan» hiyye hiisse haaso'e.<note caller="-" style="x"><char style="xo" closed="false">26:64 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dan. 7:13</ref>. </char></note><verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Eettene yanna iikki umi qeesichchi mufeti seemma ifixxa dareexxi hiyyee qici, «Magenoke'n yowwichchiinka haaso'a haaso'edheen; no'o maa wele dhugaa kula hansanno? Isi Magenoke'n yowwichchiinka haaso'a haaso'eexxa ha'no umo ha'nongenninni laqqine'een; <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Maa ha'no'n labba?» hiyye.</para>
  <para style="p" vid="MAT 26:66">Insa'nenna, «Isi'a reya hassissaan» hine hiissine haasonne.<note caller="-" style="x"><char style="xo" closed="false">26:66 </char><char style="xt" closed="false"><ref loc="LEV 24:16">Lew. 24:16</ref>. </char></note><verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Eettenee yanna Yessuusike alba'n tunfa'n tuntummotinna isoo ganne; weli manninna isoo dhabanaansa'n <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />«Kiristoosii, atee dhabanaaseek ayyete? Amo mee no'aa raaga haaso'i» hina'nemman.<verse eid="MAT 26:68" /></para>
  <para style="s1">Pheexiroosi Yessuusii Waakkate</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mar. 14:66-72</ref>; <ref loc="LUK 22:56-62">Luq. 22:56-62</ref>; <ref loc="JHN 18:15-25">Yoh. 18:15—18:25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Pheexiroosi gadho umi qeesichchixxe baxxe giddo ofo'lee'naa mitte erganjo belto isibaa shiqqeexxi, «Atinna Geliilake Yessuusinni welti hexxettan» hite.<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Isi kinn «Ati maa haasottaattenxa ani ege'nebe'non» hiyyeexxi duuchchiing edo waakkate.<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Baxxe giddii'n fulo'a hulatibaa me'a'neenge'n higgeenna welenxi mitte erganjo belto isoo affeexxi ookko hedhemmake manni duuchchi edo, «Kunni manji Naazireetike Yessuusinni welti hedhemman» hite.<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Pheexiroosinna, «Konnee hita'etteka manjo ege'nebe'non» hiyya'n kakot higgeenn waakkate.<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Shiixxoxxe yanna uduma ookko uurreemmak manni Pheexiroosibaa shikki hiyyeexxi, «Haaso'i ating ege'nishaammaxxee dhugaaten, ati isa'neeke manninaa'n mitteken» hiyye.<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Eettene yanna Pheexiroosi, «Konnee hitina'neeka manjo ege'nebe'non» hiyya'n ifi badinati kakote'n ke'e. Ookkone hirba'ninni lukkichchi baroode.<verse eid="MAT 26:74" /></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75" />Eettenee yanna Pheexiroosi, «Lukkichchi barodebaang sasele anee waakkattatton» hiyyemmaka Yessuusika haaso'a qalli hiyye. Gadhi'aanna fuleexxi qaraartaaxxa oodhishsha oodhe.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">Yihuda Suruudhdhe</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Bogi soodee wodda duuchchiing qeesetik sooreessuwwinna ardiinxi gedhee Yessuusi hitta shiyemaaxxa mari'ante.<verse eid="MAT 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 27:2" />Isoonna usurre iyyemarreexxi galchallo Philaaxoosi'n sa'issine uune.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Yessuusii'i iikki sa'isse uwwemmak Yihuda Yessuusi'n murte uwwendeexxa afeexxi hansha hiyye; ookkonee sase tommiinga birretika sibljo iyyemareexxi qeesetike sooreessuwwa'ninna ardiinxe geedhe'n hisseexxi, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />«Qullichcha manjo sa'ise uwwennexxee balleeseennen» hiyye. Insa'ne kinni, «No'oota maa dhibe? Iikki atike yaado» hine.<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Tennexxee Yihuda ookkone birretika sibljo Woyyichch galmi giddi'a darbe me'eexxi suruudhdhe reye.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Iikki qeesetik sooreessuwwinna ookkone maallaqa aadheexxi, «Mundiinke maallaqa kadeemmaxxee Woyyichchi galmixxe uwwake maalaqa'n mankonnaa, eeti uwwendebaan» hiyye.<verse eid="MAT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 27:7" />Tennexxee mari'anteexxi alagiinke mooggixxe bakka kado'a ookkonee maallaqinni ookkone waatichchika boga hirre. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Tennexxee iikki bogi techchi qico'n «Mundeti boga» hiyyema.<note caller="-" style="x"><char style="xo" closed="false">27:8 </char><char style="xt" closed="false"><ref loc="ACT 1:18-19">Erga. Huj. 1:18-19</ref>. </char></note> <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Eettenee yanna wabeeki Ermiyaasi'n, «Isike hira kado'a Isira'eelik ardi mureeka sase tomme birretika sbiljo adhdhine; <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />Goottikinna anee ajajemmashsha waatichchiinke ookkone bogi'a ookkonee maallaqa uune» hiyyende kulendeemmaxxi yaane muuxende.<note caller="-" style="x"><char style="xo" closed="false">27:10 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">Zek. 11:12-13</ref>. </char></note><verse eid="MAT 27:10" /></para>
  <para style="s1">Yesuus Philaaxoosi Edo Shiqeexxa</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mar. 15:2-5</ref>; <ref loc="LUK 23:3-5">Luq. 23:3-5</ref>; <ref loc="JHN 18:33-38">Yoh. 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Eettenee yanna Yessuusi ookkone bogiinke galchalli edo uurre; galchallikinna isoo, «Ati Ayihudiinke moyanjo?» hiyye qore.</para>
  <para style="p" vid="MAT 27:11">Yessuusinna, «Ati hiteteshshanden» hiyye.<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Qeesetik sooreessuwwinna geedhe isoo ku'litee wodda kinni mitte hiissichchonna hiisseba'a. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Eettenee yanna Philaaxoos isoo, «Me'e yaanenni atee ku'lina'neexxa laqa'ebexxota?» <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Galchallikinna mambe'a hiyyaa qico'n ku'lemeemmaxxe yaane'a Yessuusi mitte hiyyichonna midde buccuqqi hiyyeba'a.<verse eid="MAT 27:14" /></para>
  <para style="s1">Yessuusi'ni Reyotixxi Murte Murendeexxa</para>
  <para style="r">(<ref loc="MRK 15:6-15">Mar. 15:6-15</ref>; <ref loc="LUK 23:13-25">Luq. 23:13-25</ref>; <ref loc="JHN 18:39-40">Yoh. 18:39-40</ref>; <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Bogiink iikki galchalli ardi ayyaanake'n haseeka mitte usuremee manjo tika isi'a baratendeexxe yaanemman. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Eettenee yanna, xaqaro hujati ege'neme'eeke «Berbaan» hiyyemaak usureme'eemak manjichchi hedheemman. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Tennexxee ardi bukki hiyyee wodda Philaaxoosi insa'nee, «Ayyete ha'no'aa tikanno? Berbaanii'i yookaan? Kiristoosi hiyyemeeka Yessuusii'i?» hiyye qore. <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Isinna tennee hiyyeechchi insa'ne Yessuusii'i hinaaffet sa'issine uuneexxa ege'neemmaxxeetemman.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Philaaxoosi murtetike barcuma'n ofo'le'naa, are isixxi, «Ani konnee manjichchixxee techcho oojjoti lumo qico rakkateennaxxee konnee balleessa afebaake manjo'n mittechchonna assitoxxe'e» hita'n iso'n ergite.<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Qeesetik sooreessuwwinna ardiinxi geedhe kinni, Berbaanii'i insa'ne'a tikemaashsha Yessuusi kinni shiyemaashsha qoro'a arda malchite.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Galchallikinna «Konnee laminaa'n ayyee ha'no'a tikonnole eetina?» hiyyeexxi arda qore.</para>
  <para style="p" vid="MAT 27:21">Ardikinna: «Berbaanii'i no'aa tiki» hiyye hiisse haaso'e.<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Philaaxoosinna insa'nee, «Kiristoosi hiyyemeeka Yessuusita maa assanno?» hiyye qore.</para>
  <para style="p" vid="MAT 27:22">Duuchchiing, «Isi fannisemowwaal» hiyye hiisse haaso'e.<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Philaaxoosinna, «Mayee? Isixxi balleessa maachcho?» hiyye insa'nee qore.</para>
  <para style="p" vid="MAT 27:23">Insa'ne duuchchiing, «Isi fannisemowwaal» hina'n adda cancine.<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Tennexxee Philaaxoos tinni yaane canca ke'issita'nee malee'e la'o affa'nebaaxxa afeexxi, «Konne manjichchxxe mundenaa'n ani qullote; yoona tinni ha'note uudda» hiyya'n ardi edo wode'ik anga anshedhe.<note caller="-" style="x"><char style="xo" closed="false">27:24 </char><char style="xt" closed="false"><ref loc="LEV 21:6-9">Lew. 21:6-9</ref>. </char></note><verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Iikki duuchchiing ardi, «Isixxi munde no'o'ninna no'oxxe oosse'n geltowwaal» hiyye.<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Eettene yanna Philaaxoos Berbaanii'i insa'ne'a tike. Yessuusii kinni jadhafiseechchi uduma fannisemo'a sa'isse uwwe.<verse eid="MAT 27:26" /></para>
  <para style="s1">Loliink Manni Yessuusi'n Gacifate</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mar. 15:16-20</ref>; <ref loc="JHN 19:2-3">Yoh. 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Ookoneechchi uduma ookkone galchallik loliink manni Yessusii'i ookkone galchaallixxe baxxe giddo iyyemare; ookkonee sannachcha duuchchanna Yessuusibaa bukki assine. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Seemmatanna isinaa'n fulchineexxi diimmoxxa seemma iso'n oddeessine. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Ute sagarree kallachchanna giissineexxi Yessuusike umo'n uggine; Middixxe isexxe anga'ninna siqqichcho abidisat, isi edo gulufanteexxi, «Ayihudiinke moyanjoo, nage'i ati'a kadowwaal» hina'n iso'n gacifante. <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Hancufakanna iso'n tunfe; siqqichchotanna isinaa'n aa'neexxi isoo umo gannaamman. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Iso'n gacifanteechchi udumanna diimmoxxa seemma isinaa'n fulchineexxi seemma isinxa iso'n oddeesati fanninso'a adhdhine me'ine.<verse eid="MAT 27:31" /></para>
  <para style="s1">Yessuusixxa Fannisensha</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mar. 15:21-32</ref>; <ref loc="LUK 23:26-43">Luq. 23:26-43</ref>; <ref loc="JHN 19:17-27">Yoh. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Isoo aa'ne fulle me'ina'naa Simi'ooni hiyyemeeka Qereena bogi manjo anfeexxi eettene Yesuusixxa fanno dukaashsha isoo'n hunnante.<verse eid="MAT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 27:33" />Ookkoneechchi uduma, tika isixxi, «Umii qoonjo» hiyyemeeba, Golgoota dange. <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Ookkonna ha'loottoti makendeexxa woyinetixxa bookka ha'wo'a Yessuusi'n uune; isi kinni isee maqeechchi uduma ha'wa gibe.<note caller="-" style="x"><char style="xo" closed="false">27:34 </char><char style="xt" closed="false"><ref loc="PSA 69:21">Far. 69:21</ref>. </char></note> <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Insa'nenna Yessuusii'i fannisseechchi uduma hixa ibinseexxi seemma isixxa qoodemme.<note caller="-" style="x"><char style="xo" closed="false">27:35 </char><char style="xt" closed="false"><ref loc="PSA 22:18">Far. 22:18</ref>. </char></note> <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Ookkonna offolleexxi insa'ne isoo heqqinaamman. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />«Kunni Ayihudiinke moyanjo Yessuusiten» hiyyaaka isoo ku'latika borreessa isike umi iimi darre uggurre. <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Eettenee yanna Yessuusinni welt lame bokkaame mitti isike midda'n mittikinna isike bita'a'n fanninsende'eemman. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Ora sa'ammakiirinna isoo yowa'ninna umo ifika lele'misa'n<note caller="-" style="x"><char style="xo" closed="false">27:39 </char><char style="xt" closed="false"><ref loc="PSA 22:7">Far. 22:7</ref>; <ref loc="PSA 109:25">109:25</ref>. </char></note> <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />«Woyyichcha galma diiggettexxi sase barra giddo isoo ijaartattok ati amo mee, ifi anjir! Mageniinke Belto kaddo'oottole amo fannotenaa'n dirritataa!» isoo hinaamman.<note caller="-" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="MAT 26:61">Mat. 26:61</ref>; <ref loc="JHN 2:19">Yoh. 2:19</ref>. </char></note><verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Iittanna iikki qeesetik sooreessuwwi, Muuseke seerike barachchiisalluwwinninna geedheti welti, iso'n gacifanta'n hinee qic, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />«Wele anjireedheen; ifi kinni anjira dande'abaan! Isira'eelike moyanjo kado'oole ta'a fannotenaa'n dirraqqata! No'onna iso'n amannannon. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Magenoke'n addateexxi, ‹Ani Mageniinke Belton hiyyeemmaxxe isoo eeya'noole mee Mageni isoo anjiruun!› »<note caller="-" style="x"><char style="xo" closed="false">27:43 </char><char style="xt" closed="false"><ref loc="PSA 22:8">Far. 22:8</ref>. </char></note> <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Iittanni isinni welti fannisendeemmaxxi bokkaamenna isoo yowwita'nemman.<verse eid="MAT 27:44" /></para>
  <para style="s1">Yessuusixxa Reyo</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mar. 15:33-41</ref>; <ref loc="LUK 23:44-49">Luq. 23:44-49</ref>; <ref loc="JHN 19:28-30">Yoh. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Barrixxe jaane saatenaa'ni sallane saate qico'n bogi duuchchi dukkane. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Sallane saate kadaa wodda Yessuusi hafuura gikki asseexxi, «Elohee! Elohee! Laama sebeqitaanee?» hiyya'n raare. Tennexxi tikanna «Anke Magenoo anke Magenoo anee mayee waaldete?» hiyyaten.<note caller="-" style="x"><char style="xo" closed="false">27:46 </char><char style="xt" closed="false"><ref loc="PSA 22:1">Far. 22:1</ref>. </char></note> <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Ookko uurreemmake mannanaa'ni mitti mitti tennee laqeexxi, «Eelyaasii'i ye'a'neen» hiyye. <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Iikki woddi insa'nenaa'n mitti spoonje adheexxi majjajjeexxe woyinexxe booka giddo cuuphe'e, spoonje etteneenna siqqichchotixxe qacce'n uggeexxi ha'wo'a Yessuusi'n uwwe.<note caller="-" style="x"><char style="xo" closed="false">27:48 </char><char style="xt" closed="false"><ref loc="PSA 69:21">Far. 69:21</ref>. </char></note> <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Weli gatemmaki manni kinni, «Waalle, Eelyaasi dageexxi isoo anjiraaxxa uundannon» hiyye. <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Yessuusi hafura gikki asse'e langaxxa raareexxi lubbo ifixxa sa'isse uwwe. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Eettenee yanna galmi giddik seemmatik goli iimi'n butti qico'n lameba haaqqi hiyye; buttatinna lele'mite; rassuwwatinna dhodhoote.<note caller="-" style="x"><char style="xo" closed="false">27:51 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">Fula. 26:31-33</ref>. </char></note> <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Moogguwwi banemee'naa rerteemmaxxe qulliyyenaa'n heddi manni ke'e. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Moogguwwi giddii'n fulatinna Yessuusi reyotenaa'n ke'eechchi uduma ookkone woyyichcha qachcha'n e'yineexxi heddo manna'n leelline.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Iikki dhibbiink ajajallinna isin welti Yessuusi heqqaammakiir buttatixxa lele'manna wele kaddeexxa yaanuwwa uudendee wodda lumo qico sodaanteexxi «Dhugaaten isi Mageniinke Beltomman» hine. <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />Yessuusii'i Geliila ergatenda'n isoo hordoffeemmaxxi heddo melaalle tennee yaane uuda'n ookko hexxemman. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Insa'ne giddii'n Megidelixxi Maarami, Maaramii'i Ya'iqoobixxinna Yooseefixxi ama, iittanni Zebidewoosixxe oosexxi ama hexxemman.<note caller="-" style="x"><char style="xo" closed="false">27:56 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">Luq. 8:2-3</ref>. </char></note><verse eid="MAT 27:56" /></para>
  <para style="s1">Yessuusixxa Moogensha</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mar. 15:42-47</ref>; <ref loc="LUK 23:50-56">Luq. 23:50-56</ref>; <ref loc="JHN 19:38-42">Yoh. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Bogi galgalo'ee wodda Yooseefi hiyyemaak dureessi manjichchi Armatiyaasike qachchinaa'n dage; isi ifinge uminninni Yessuusike hordofallomman. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Isinna Philaaxoosibaa shiqeexxi Yessuusika rensha isoo kadhate; Philaaxoosinna iikki renshi isi'a uwwemaashsha ajaje. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yooseefi rensha konne aadheexxi eloxxe layinotixxe seemmanni isoo mirqe. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />Yooseefi rassa giddi'a boceexxi ifi'a giissedheemmake haaroke moogo'n isoo masse; ookkoneechchi uduma lumoka kinjo gogo'misheexxi ookkone mooggixxa hula cufe me'e.<verse eid="MAT 27:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MAT 27:61" />Megidelixxi Maaraminna wele Maarami ookko Yessuusike mooggike kallachcha'n ofolle'eemman.<verse eid="MAT 27:61" /></para>
  <para style="s1">Yessuusike Mooggixxe Bakkaxxa Heqqensha</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Langa baro Edi Sanbatixxa gorsa umi qeesetik sooreessuwwanna Feerisito mitteba Philaaxoosibaa marreexxi <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />isoo hinee qic, «Goottaa! Iikki dedhisalli hedho hedhemma wodda ‹Sase barra uduma ani ke'annon› hiyyeemmaxxa qalli hinneennen.<note caller="-" style="x"><char style="xo" closed="false">27:63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mat. 16:21</ref>; <ref loc="MAT 17:23">17:23</ref>; <ref loc="MAT 20:19">20:19</ref>; <ref loc="MRK 8:31">Mar. 8:31</ref>; <ref loc="MRK 9:31">9:31</ref>; <ref loc="MRK 10:33-34">10:33-34</ref>; <ref loc="LUK 9:22">Luq. 9:22</ref>; <ref loc="LUK 18:31-33">18:31-33</ref>. </char></note> <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Tennexxee isixxi hordofeeyye rensha isika moorteexxi ardake'n reyotenaa'n ke'edheen hita'n oddessitabaashsha kunni mooggi sase barra qico'n heqqemaashsha ajaja sa'issi; ittate kada gophphoole udumik dedhi edikenaa'n caalaake kadaan.»<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Philaaxoosinna insa'nee, «Ha'no heqqaaka manna affine'een; martineexxi egendinee qicinni heqqisse» hiyye. <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Insa'enna marreexxi ookkone mooggo'n maxxansa maxxansineexxi heqqanjo heqqinse.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">Yessuusixxa Reyotenaa'n Ke'a</para>
  <para style="r">(<ref loc="MRK 16:1-10">Mar. 16:1-10</ref>; <ref loc="LUK 24:1-12">Luq. 24:1-12</ref>; <ref loc="JHN 20:1-10">Yoh. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Edi Sanbat sa'eechchi uduma torbatixxe taakkaxxe barra'n boro haachchabbaa wodda Megidelixxi Maaraminna wele Maarami Yessuusika mooggo uundo'a me'ine.<note caller="+" style="f"><char style="fr" closed="false">28:1 </char><char style="fqa" closed="false">Sanbata </char><char style="ft" closed="false">Tenne baka'n Sanbata hiyyemeeki Qidaame hiyyaten. </char></note> <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Dedhange'n lumoxxi buttiniinxi lele'ma kadde. Goottiink iimik erganji iimatenaa'n dirreexxi ookkone mooggiba mare kinjo gogo'misheexxi itti hana ofo'le. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Isixxi dhagganna banqotishsha xassitaammaxxe; isixxi seemmanna kaadetishsha golalooxxeemman. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Iikki heqqanjuwwinna ookkonee iimika erganjo soda'atenaa'n kexxeexxa culphinseexxi reyeeke manjishsha kande. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Iikki iimik erganjinna eettene melaalle hiyyee qici, «Ha'no mee sodaatte! Ookkonee fannisemeemmaka Yessuusii halsitina'neexxa ege'neennen. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Isi kaba hedhebaan; haaso'eemmashshanni ke'edheen; amme renshi isik massemeexxi hedhemmaxxa bakka uudde. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Ta'a rakkine martineexxi isixxe hordofeeyye'n ‹Reyotenaa'n ke'edheen; ha'no'a ediseexxi Geliila'a sa'e me'aan; ookkonna isoo affinaan› hitine kulle. Kunse ani ha'no'n kuleennen.»<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Melaalle iittinna soda'anna gammashsho insa'ne'n wo'mite'naa rakkeexxi gongita'n eettenee mooggiinxe bakkabaa'n me'ite. Isixxe hordofeeyye'ninna kuldo'a gongite.<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />Hirbange'n Yessuusi insa'nee afeexxi, «Nage'i ha'no'a kadowwaal» hiyye; insa'nenna Yessuusiba'a shikki hine'e lekka isixxa abixxineexxi isi'a sagande. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Eettenee yanna Yessuusinna insa'ne'n, «Mee sodaattee! Martineexxi Geliila'a me'inaashsha dayyuwwa anke'n kulle; ookkonna anee anfaan» hiyye.<verse eid="MAT 28:10" /></para>
  <para style="s1">Heqqanjuwwi Odeesseexxa Odo</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Melaalle iittinna orange'n hexxe'naa ookkone heqanjuwwinaa'n heenok manni qachchinbaa mareexxi kaddeexxa yaane duuchcha qeesetike sooreessuwwa'n kule. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Iikki qeesetik sooreessuwwinna geedheti welti bukki hiyyeexxi mari'ateechchi uduma loliinke manni'a geyaaka maallaqa uneexxi insa'ne'n hinee qici, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />« ‹No'o diipho he'nee'naa hordofeeyye isixxi hashsha daggeexxi rensha isika moodhdhiteen› hitineexxi ardake'n kulle. <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Tinni odo ookkone bogiinke galchallo'n laqendeexxe kaddoole no'o iso'n yaane barrinsannon; ha'no'ni mitte rakkonna geltabaashsha assinnannon.»<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Iikki loliink manninna maallaqa adhdheexxi hiyyemmeemmashshanni asse. Tinni yaane Ayihudi giddo techchi qico'n ba'la qicinni haaso'endaan.<verse eid="MAT 28:15" /></para>
  <para style="s1">Yessuusi Hordofeeyyete'n Uwweexxa Lumoxxa Ergatensha</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mar. 16:14-18</ref>; <ref loc="LUK 24:36-49">Luq. 24:36-49</ref>; <ref loc="JHN 20:19-23">Yoh. 20:19-23</ref>; <ref loc="ACT 1:6-8">Erga. Huj. 1:6-8</ref>; <ref loc="1CO 15:3-8">1 Qor. 15:3-8</ref>)<note caller="-" style="x"><char style="xo" closed="false">28:16 </char><char style="xt" closed="false"><ref loc="MAT 26:32">Mat. 26:32</ref>; <ref loc="MRK 14:28">Mar. 14:28</ref>. </char></note></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Ookkoneechchi uduma iitti tommenna mitte hordofeeyye Yessuusi insa'ne kulemmaxxe Geliila hexxeexxe eettene koobaba'a me'ite. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Insa'nenna isoo anfeexxi isi'a sagande; mitti mmitti kinni mame. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Yessuusinna iitti hordofeeyye hexxeemmabaa shiqeexxi insa'ne'n hiyyee qici, «Baalloomi iimate'ninna buttate'n ani'a uwwemeedheen. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Tennexxee martineexxi gosa gosaka arduwwa duuchcha Aabikkenni, woldikenninna Woyyichchi Hafuuriike summinni insa'ne xammaqqina'n anxe hordofeeyye asse.<note caller="-" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 1:8">Erga. Huj. 1:8</ref>. </char></note> <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Ha'noo ajajeennaxxa duuchchanna assinaashsha insa'nee barachchiisse; aninna buttatike muuxami qico'n, duuchchii wodda ha'nonni welti hedhennen.»<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>