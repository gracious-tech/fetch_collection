<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Gedeo Bible</book>
  <para style="h">1 Odotikaa Maxaafa</para>
  <para style="toc1">Taakkakaa Odotikaa Maxaafa</para>
  <para style="toc2">1 Odotika Maxaafa</para>
  <para style="toc3">1 Odo.</para>
  <para style="mt1">Taakkakaa Odotikaa Maxaafa</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Taakkak Odotiki maxaafi Saamueli'ninna moyanjuwwiinke maxaafa'n borreesseme bukki hiteexxa jirtuwwa gargarti hedheeke orinni higgeeni diidesendeen; Odotike maxaafa'ni Isira'eelike moyanjiinxe galchaxxa jirte uuddaaxxenni lame umo umo afeek yaadi borreessemedheen.</para>
  <para style="ip">1. Isira'eelikenna Yihudik moyanjuwwi ba'netee gennoolenna Mageni ardake'e uwweexxa addatensha duuchcha heqqa'neexxanna Yihudike boga'ni hedha'neeke manni darree'n gosa gosake ardi'a afeeka yaada hujete'ni hosiseexxa leelshateeten; Tenne kokeessate'e ke'ito kaddaashsha borreesanji Daawwitinna Solomoon hunje'eke lumolla hujuwwa Iyyasaafixxi, Hiziqiyaasinna Iyyosiyaasi qammalichchineexxa haaroxxa hujenna Magenoke'e anfeexxa addatensha jabeessemake ardiba'a ifi heeshshi assedhaan. 2. Iyyerussalemi'n hedheeke galma'ni Mageno mageneefachcho hitta safendeexxa leelishateeten; gargarti hedheeke mageneefachchotike seera'n hunja'nemmaxxi qeesoletixxinna Leewwitotixxi bukkii hitta kadde safendee qico kulateetemman; galmakanna hujeek Solomoonitenna kadoole, galmiinkinna mageneefachchotik ke'iti Daawwitite kadeexxa ca'a assende kulemateeten.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Addamixxe sannenaa'n Sa'ool qico'n <char style="ior"><ref loc="1CH 1:1-9:44">1:1—9:44</ref> </char></para>
  <para style="io1">Sa'oolixxanna Oosetixxa reyo <char style="ior"><ref loc="1CH 10:1-14">10:1-14</ref> </char></para>
  <para style="io1">Daawwixixxa mootummanna Iyyerussaalemixxa abidensha <char style="ior"><ref loc="1CH 11:1-9">11:1-9</ref> </char></para>
  <para style="io1">Holla callixxa Daawwitika sannachuwwa <char style="ior"><ref loc="1CH 11:10-12:40">11:10—12:40</ref> </char></para>
  <para style="io1">Kakotika taaboti Iyyerussaalemi'a adhdha <char style="ior"><ref loc="1CH 13:1-16:43">13:1—16:43</ref> </char></para>
  <para style="io1">Galma ijaara'nek Solomooniten <char style="ior"><ref loc="1CH 17:1-27">17:1-27</ref> </char></para>
  <para style="io1">Daawwitiki sannachchi lole injifatee qico <char style="ior"><ref loc="1CH 18:1-20:8">18:1—20:8</ref> </char></para>
  <para style="io1">Daawwiti arda laako'e wodda Mageni mufatee qico <char style="ior"><ref loc="1CH 21:1-30">21:1-30</ref> </char></para>
  <para style="io1">Galma ijaarate'e assendeexxa qophpheefachcho <char style="ior"><ref loc="1CH 22:1-28:21">22:1—28:21</ref> </char></para>
  <para style="io1">Galminke ijaarsixxe huje'a ardi bukki assedhee qico; <char style="ior"><ref loc="1CH 29:1-20">29:1-20</ref> </char></para>
  <para style="io1">Solomoonixxa mootumma <char style="ior"><ref loc="1CH 29:21-25">29:21-25</ref> </char></para>
  <para style="io1">Daawwitixxa reyo <char style="ior"><ref loc="1CH 29:26-30">29:26-30</ref> </char></para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s1">Addaaminaa'n Abirhaami qico'n Hexxeexxe Ilaxxa Ila Nohixxe Ooseqico'n</para>
  <para style="s1">(Dada. 5:31-32; 10:1-32; 11:10-26)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 1:1" />Addaami, Seetii'i, Heenoosii'i, <verse eid="1CH 1:1" /><verse number="2" style="v" sid="1CH 1:2" />Qayinaani'i, Mehalali'eelinna, Yaareedi'i i'le <verse eid="1CH 1:2" /><verse number="3" style="v" sid="1CH 1:3" />Heenooki, Matusaala'a, Laamehii, Nohii'i i'le.<verse eid="1CH 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="1CH 1:4" />Nohixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:4">Seemi, Kaamitenna Yaafeti.<verse eid="1CH 1:4" /></para>
  <para style="s1">Yaafetito</para>
  <para style="q1">
    <verse number="5" style="v" sid="1CH 1:5" />Yaafetixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:5">Goomeri, Maagoog, Maadayi, Yaawani,</para>
  <para style="q1" vid="1CH 1:5">Toobeli, Moosahanna Teerasiten.<verse eid="1CH 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="1CH 1:6" />Goomerixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:6">Ashikenaazi, Rifaatinna, Tergaamaten.<verse eid="1CH 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="1CH 1:7" />Yaawanixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:7">Elisha, Terseesi, Kitiiminna Roditen.<verse eid="1CH 1:7" /></para>
  <para style="s1">Kaamito</para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 1:8" />Kaamixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:8">Kuushi, Mitsirayeem, Faaxxinna Kene'aniten.<verse eid="1CH 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 1:9" />Kuushixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:9">Saaba, Hawilaxxi, Sebita Ra'iimanna Sebiqaaten;</para>
  <para style="q1" vid="1CH 1:9">Ra'iimaxxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:9">Saabanna, Didaaniten.<verse eid="1CH 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 1:10" />Kuushi Namurudi'i i'le;</para>
  <para style="q2" vid="1CH 1:10">isinna buttate'n siretike hunnaameessa loliinke manjo kade.<verse eid="1CH 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 1:11" />Mitsirayim Luditotike, Anamitotike, Lehabim, Nefitatotike,<verse eid="1CH 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 1:12" />Fetiratotike, Filisixeemitotike hundaayyetik annuwwixxe gosa kadeeke Kefititonna Kesiluhimina ardamma.<verse eid="1CH 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 1:13" />Kene'anik angafi Heetti Sidoonite kadaa wodda, Keexxawito<verse eid="1CH 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 1:14" />Iyyaabusito, Amoorito Gergerisiito,<verse eid="1CH 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 1:15" />Hiitito, Arakawito, Siinatito,<verse eid="1CH 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 1:16" />Arewwadito, Semartotanna Hamoorito i'le.<verse eid="1CH 1:16" /></para>
  <para style="s1">Seemaatito</para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 1:17" />Seemixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:17">Elaami, Asoori, Arfaakiisid, Luudu, Araami;</para>
  <para style="q1" vid="1CH 1:17">Aaraamixxi labbaxxi oose:<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">yookaan Siidoonitotike sooreesa</char></note></para>
  <para style="q2" vid="1CH 1:17">Utsi, Huuli, Geteri, Moosaha.<verse eid="1CH 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 1:18" />Arfaakiisid Saala'a i'le;</para>
  <para style="q2" vid="1CH 1:18">Saalami Eebor'i i'le.<verse eid="1CH 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 1:19" />Eebor lame labbaxxa oose i'le;</para>
  <para style="q2" vid="1CH 1:19">isike baro buttate'n hedhemmak ardi qoqqoodemeemmaxxee,</para>
  <para style="q1" vid="1CH 1:19">Mitte beltika summa Feelqi hiyyeme;</para>
  <para style="q2" vid="1CH 1:19">isik dayyi summinna Yoqixaan hiyyeme.<verse eid="1CH 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 1:20" />Yoqixaaninna</para>
  <para style="q2" vid="1CH 1:20">Almodaadini'i, Saalfeni'i, Haderematini'i, Yerahiini'i,<verse eid="1CH 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 1:21" />Hadorami'i, Uuzaalii'i, Diqilaanii'i<verse eid="1CH 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 1:22" />Obaali'i, Abima'eelii'i Saabanii'i,<verse eid="1CH 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 1:23" />Ofiirii'i,</para>
  <para style="q2" vid="1CH 1:23">Hawilaxxi'i, Yobabi'i i'le;</para>
  <para style="q1" vid="1CH 1:23">Kunni duuchchi Yoqixaxxe labbaxxe oosen.<verse eid="1CH 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 1:24" />Seemi, Arfaakiisid, Saala,<verse eid="1CH 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 1:25" />Eebori, Faaleqi Raagiwe,<verse eid="1CH 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 1:26" />Seerohi, Naakor, Taara,<verse eid="1CH 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 1:27" />Iittanni udumii'n Abirihaami hiyyemeek Abiraami.<verse eid="1CH 1:27" /></para>
  <para style="s1">Abirhaamika Mini Hado</para>
  <para style="r">(<ref loc="GEN 25:12-16">Dada. 25:12-16</ref>)</para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 1:28" />Abirihaamixxa labbaxxa oose</para>
  <para style="q2" vid="1CH 1:28">Yisihaqinna Isima'el'i.<verse eid="1CH 1:28" /></para>
  <para style="s2">Aggaarixxa horte</para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 1:29" />Tinni hortenna konneechchin butti'a hexxeexen:</para>
  <para style="q2" vid="1CH 1:29">Isima'elki angafi belti Nebaayuti, kadaa wodda Qeedari, Adibe'eel, Mebisaami,<verse eid="1CH 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 1:30" />Masama'i, Duuma, Maasa, Hadaadi, Teeman,<verse eid="1CH 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 1:31" />Yixuur, Naafesi, Qeedima, kunnir Isima'elxe labbaxxe oosen.<verse eid="1CH 1:31" /></para>
  <para style="s2">Keexuraxxa Horte</para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 1:32" />Abirihaamixxi garba are Keexura ildeexxi</para>
  <para style="q2" vid="1CH 1:32">labbaxxi oose: Zimmiran, Yoqisan, Medan,</para>
  <para style="q2" vid="1CH 1:32">Midiyam, Yushibaqinna Sewihintemman.</para>
  <para style="q1" vid="1CH 1:32">Yoqisaaxxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:32">Saabaninna Didaateniten.<verse eid="1CH 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 1:33" />Midiyamixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:33">Gefeer, Eefer, Heenooki, Abidaa'inna, Elida'ate hene he'na'neek onde labbaxxa oose i'le.</para>
  <para style="q1" vid="1CH 1:33">Tinni duuchchi Keexuraxxe hortemman.<verse eid="1CH 1:33" /></para>
  <para style="s2">Saaraxxa Horte</para>
  <para style="r">(<ref loc="GEN 36:1-19">Dada. 36:1-19</ref>)</para>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 1:34" />Abirihaami Yissaaqii i'le.</para>
  <para style="q2" vid="1CH 1:34">Yisihaqixxi labbaxxi oose:</para>
  <para style="q1" vid="1CH 1:34">Eesawunna Isira'eelten.<verse eid="1CH 1:34" /></para>
  <para style="s1">Eesawuxxi Labbaxxi Osse</para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 1:35" />Eesawuxxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:35">Elifaazi, Re'u'eeli, Ye'usi, Ya'ilaaminna, Qoreten.<verse eid="1CH 1:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 1:36" />Elifaazixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:36">Teemani, Oomaar, Sifo, Ga'itaami</para>
  <para style="q1" vid="1CH 1:36">Qeneezi, Timinaa'inna Amaaleqiten.<verse eid="1CH 1:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="1CH 1:37" />Ragu'elixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:37">Nahooti, Zaara, Saamanna Mizaahiten.<verse eid="1CH 1:37" /></para>
  <para style="s1">Edoomii Hedha'neek Seeyirika manna</para>
  <para style="r">(<ref loc="GEN 36:20-30">Dada. 36:20-30</ref>)</para>
  <para style="q1">
    <verse number="38" style="v" sid="1CH 1:38" />Seeyirixxi labbaxxa oose:</para>
  <para style="q2" vid="1CH 1:38">Looxan, Sobaal, Tsibi'oon, Aana,</para>
  <para style="q2" vid="1CH 1:38">Diishooni, Etseerinna Diishaaniten.<verse eid="1CH 1:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="1CH 1:39" />Looxanixxi labbaxxa oose:</para>
  <para style="q2" vid="1CH 1:39">Hoorinna Homaamiten; Temonaa'i Looxanixxe dayyoman.<verse eid="1CH 1:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="1CH 1:40" />Soobalixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:40">Aliwaan, Manahati, Eebali, Seefo, Awinaami.</para>
  <para style="q1" vid="1CH 1:40">Tsibi'oonixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:40">Aayaanna Aanaten.<verse eid="1CH 1:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="1CH 1:41" />Aanak labbak belti:</para>
  <para style="q2" vid="1CH 1:41">Diishooni;</para>
  <para style="q1" vid="1CH 1:41">Diishonixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:41">Hemidaan, Eeshibaan, Yitirayininna, Kiraaniten.<verse eid="1CH 1:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="1CH 1:42" />Etseerixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:42">Bilihaan, Za'iwaaninna, Aqaaniten.</para>
  <para style="q1" vid="1CH 1:42">Diishaanixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 1:42">Uutsinna, Aaraaniten.<verse eid="1CH 1:42" /></para>
  <para style="s1">Edomiyaasika Moyanjuwwa</para>
  <para style="r">(<ref loc="GEN 36:31-43">Dada. 36:31-43</ref>)</para>
  <para style="q1">
    <verse number="43" style="v" sid="1CH 1:43" />Isira'eeli'n moyanji moyebaa edi darre</para>
  <para style="q2" vid="1CH 1:43">Eedoomike boga'ni mowemmak moyanjuwwi konneechchinni butti'a hedheekeeran.</para>
  <para style="q1" vid="1CH 1:43">Bee'orki belti Baala'i, isike qachchiki summinna Dinihaaba hiyyemaamman.<verse eid="1CH 1:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="1CH 1:44" />Beela'imi reya wodda Baasorchi,</para>
  <para style="q2" vid="1CH 1:44">Zaarahik belti Yobabi bakka isixxe'n moye.<verse eid="1CH 1:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="1CH 1:45" />Yobabi reya wodda Teemaanike bogik manji</para>
  <para style="q2" vid="1CH 1:45">Hushaami isixxe bakka mowe.</para>
  <para style="q1" vid="1CH 1:45">Qachchink summinna Awitite hine.<verse eid="1CH 1:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="1CH 1:46" />Hushaami reya wodda Mo'aabike boga'n</para>
  <para style="q2" vid="1CH 1:46">Midiyaamika manna lole injifateemmak Bedaadik belti Hadaadi</para>
  <para style="q2" vid="1CH 1:46">bakka isixxe'n mowe;</para>
  <para style="q1" vid="1CH 1:46">Isik qachchik summinna Awite hiyyeme.<verse eid="1CH 1:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="1CH 1:47" />Hadaadimi reya wodda Misireqak bogi manji</para>
  <para style="q2" vid="1CH 1:47">Semiila bakka isixxe'n mowe.<verse eid="1CH 1:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="1CH 1:48" />Semiila reya wodda galaan qarqara hedheeke</para>
  <para style="q2" vid="1CH 1:48">Rehobootike bogik manji Sa'uuli</para>
  <para style="q1" vid="1CH 1:48">Bakka isixxe'n mowe.<verse eid="1CH 1:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="1CH 1:49" />Sa'uulinna reya wodda Aki'oberiki belti</para>
  <para style="q2" vid="1CH 1:49">Be'aalihanaan bakka isixxe'n moye.<verse eid="1CH 1:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="1CH 1:50" />Be'aalihanan reya wodda Hadaadi bakka isixxe'n mowe;</para>
  <para style="q2" vid="1CH 1:50">isike qachchik Faa'u hiyyemamman;</para>
  <para style="q2" vid="1CH 1:50">are isixxinna Meheexabi'elite hiyyendaan;</para>
  <para style="q1" vid="1CH 1:50">Isenna Meezahebilike belto, Mezaabixxe akka'o.<verse eid="1CH 1:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="1CH 1:51" />Hadaadinna reye.</para>
  <para style="q2" vid="1CH 1:51">Umo umo kadeemmaki Eedoomike mannik sooreessuwwi konneechchinni butti'a hedheekeeran:</para>
  <para style="q2" vid="1CH 1:51">Timinaa'i, Aliwa, Yeteeti,<verse eid="1CH 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="1CH 1:52" />Oholiibaama, Ela, Fiinon, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />Qeenezi, Teemaan, Mibidari, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />Megidi'eel, Iraami.</para>
  <para style="q1" vid="1CH 1:54">Kunni duuchchi Eedoomike akeekisanjuwwamman.<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s1">Isira'eelixxa Labbaxxa Oose:</para>
  <para style="q1">
    <verse number="1" style="v" sid="1CH 2:1" />Isira'eelixxi labbaxxi oose konnechinn butti'a hexxexeraan: Roobeli, Simooni, Leewwi, Yihuda, Yisakoor, Zabiloni,<verse eid="1CH 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="1CH 2:2" />Daani, Yoosefi, Biiniyaam, Nefitaalemi, Gaadinna Aseeriten.<verse eid="1CH 2:2" /></para>
  <para style="s1">Yihuda</para>
  <para style="s2">Aseeronixxe Labbaxxa Ooseqico'n</para>
  <para style="q1">
    <verse number="3" style="v" sid="1CH 2:3" />Yihudaxxa labbaxxa oose: Eer, Awinaaninna, Seelomiten; tenne sase oose Kenaanichcho are ifixxe Sewwanaa'n i'le. Yihudak angaf belti Eer Duuchchi Woodike Goottike edo fuggichcha manjo kade; Duuchchi Woddik Gootti iso'o shiye.<verse eid="1CH 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="1CH 2:4" />Yihuda, Belti ifikixxe are Ti'imarinaa'n, Faareesinna Zaarahini'i i'le; Yihuda, duuchchinxa mitteba onde labaxxa oose afeemman.<verse eid="1CH 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="1CH 2:5" />Faaresixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 2:5">Hetsiroominna Hamuuliten.<verse eid="1CH 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="1CH 2:6" />Zaarahixxi labbaxxi oose: Zimiir,</para>
  <para style="q2" vid="1CH 2:6">Etaan, Hemaan, Kalikooli, Daara, duuchchinxi mitteba onde oosen.<verse eid="1CH 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="1CH 2:7" />Kaarmik belti Akaani, haranga balleessema hassissammaxxa yaane mooreexxi Isira'eeli'ni ba'ne geltaashsha asseeken.<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="JOS 7:1">Iya. 7:1</ref>. </char></note><verse eid="1CH 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 2:8" />Eetaanik labbak belti</para>
  <para style="q2" vid="1CH 2:8">Azeeryaten.<verse eid="1CH 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 2:9" />Hetsiroomixxi labbaxxi oose: Yirahime'eli, Araaminna Kaaleebiten.<verse eid="1CH 2:9" /></para>
  <para style="s1">Esiromike Belto Araamina'ni kexxeexxi Hedheeka Ilatika Daalo</para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 2:10" />Araami Aminadaabi'i i'le; Aminaadabinna Yihudike ardike soorressa kadeeka Ne'aasoonii i'le.<verse eid="1CH 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 2:11" />Ne'aasoosin Selimooneni'i i'le; Selimooninna Bo'eezi'i i'le.<verse eid="1CH 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 2:12" />Bo'eezi Iyyobeedi'i i'le; Iyyobeedinna Isseyi'i i'le.<verse eid="1CH 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 2:13" />Isseyike angafa labbaka belto Eli'aabiinna langak belto Aminadaabi'i, sakkaka belto Saama'a,<verse eid="1CH 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 2:14" />Sholgaka belto Naatina'eli'i, ondika belto Raadayi'i,<verse eid="1CH 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 2:15" />Jiyaka belto Otseemiinna, torbaka belto Daawwiti'i i'le.<verse eid="1CH 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 2:16" />Insa'nexxi dayyuwwa Tsiruyanna Abigeeltemman. Tsiruyaxxi sase labbaaxxi oose: Abisayi, Iyyo'abinna Asa'eelitemman.<verse eid="1CH 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 2:17" />Abigeeli Amesa'a ilde; anni isikinna Yeter hiyyemeeke Isima'elichchomman.<verse eid="1CH 2:17" /></para>
  <para style="s1">Eesiroomika Belto Kaalbi'i</para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 2:18" />Hetsiroomik belti Kaalebi ifixxe lame aree'n Azubanaa'ninna Yiri'ootinaa'n labbaxxa oose i'le; Azuubinaa'n i'leexxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 2:18">Yesher, Sobabinna Ardoniten.<verse eid="1CH 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 2:19" />Azuuba rerte wodda Kaalebi Eefiraataa aadhe; isenna Huuri'i isi'a ilde.<verse eid="1CH 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 2:20" />Huuri Uurii'i i'le; Urininna Baatsili'eeli'i i'le.<verse eid="1CH 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 2:21" />Ookkoneechchi uduma Hetsiroomi jaane tomme wogga geyeexxi Gele'adixxa belto Makiri'i aadhe; isenna Segubi'i isi'a ilde.<verse eid="1CH 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 2:22" />Segubinna Iyya'ireni'i i'le; isinna Gele'adike boga'n lame tommenna sase qachchuwwa galcha'nemman.<verse eid="1CH 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 2:23" />Kaddo malee'e Geshuurenna Aaraami, Qenaatika qachchanna qarqarake'n hedheeka jaane tomme shiixaramma qachchuwwinni mitteba Iyya'erika qachchuwwa abinde; kunni duuchchi Gele'adike annike, Makirixxe hortekemman.<verse eid="1CH 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 2:24" />Hetsiroomi Efiraataa Kaalebixxe'n reyeechi uduma, Eseeroomixxi are Abiya, Teequheka anna Ashihuur isi'a ilde.<verse eid="1CH 2:24" /></para>
  <para style="s1">Esiroomika Belto Yirehimi'eli'i</para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 2:25" />Hetsiroonik angafi belti, Yirahime'eeli onde labbaxxa oose i'le; insa'nenna angafi Raami, itti aanek Buunahi, Oreeni, Otseeminna Ahitatemman.<verse eid="1CH 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 2:26" />Yirahime'eli Axaara hiyyendaaxxa wele are afeemman; isenna Onaamixxe amamman.<verse eid="1CH 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 2:27" />Yirahime'elike angafi belto, Raamixxi labbaxxi oose: Me'aasi, Yaaminna, Eeqerten.<verse eid="1CH 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 2:28" />Onaamixxi labbaxxi oose: Shemayinna Yaadaten.</para>
  <para style="q2" vid="1CH 2:28">Shemayixxi labbaxxi oose: Naadabinna Abishuurten.<verse eid="1CH 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 2:29" />Abishuurinna Abihayil hiyyendaaxxa mitte manjichcho aadheexxi Ahibaaninna Moolidi hiyyendaaxxa oose isenaa'n i'le.<verse eid="1CH 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 2:30" />Nadaabixxi labbaxxi oose: Seleedi, Afaayimi, Seleedi labbaka i'lebaang reye.<verse eid="1CH 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 2:31" />Afaayimik belti Yishi'ate; Yishi'anna Soosaanii i'le; Shashaaninna Ahilayii'i i'le.<verse eid="1CH 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 2:32" />Shemayik dayyixxi, Yaadaxxi labbaxxi oose: Yeterinna Yoonataniten; Yeterinna oose i'lebaang reye.<verse eid="1CH 2:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 2:33" />Yoonatanixxi labbaxxi oose: Feeletinna Zaazaten. Kunniir Yirahime'elxxe hortemman.<verse eid="1CH 2:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 2:34" />Sosaan meyyaxxa male'e labbaxxa oose i'le'emabaan; Isinna Yarha'i hiyyemaake Gibtsichcho erganjo afeemman.<verse eid="1CH 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 2:35" />Soosane belto ifixxa erganjo ifike Iyoheeli'n herunsiise; isenna Ataayi hiyyemaaka belto isi'a ilde.<verse eid="1CH 2:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 2:36" />Ataayi Naatanii'i i'le; Naataninna Zabadi'i i'le.<verse eid="1CH 2:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="1CH 2:37" />Zabadi Efilaalii'i i'le; Efilaalii Obedii'i i'le.<verse eid="1CH 2:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="1CH 2:38" />Obedi Iyyuu i'le; Iyu Azaryaasii'i i'le.<verse eid="1CH 2:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="1CH 2:39" />Azaryaasi Heleetsii'i i'le; Kelesi Eli'aasa i'le.<verse eid="1CH 2:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="1CH 2:40" />Eli'aasa Sisemayii'i i'le;</para>
  <para style="q2" vid="1CH 2:40">Sisemayi Seloomii'i i'le.<verse eid="1CH 2:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="1CH 2:41" />Seloom Yeqamiya'a i'le;</para>
  <para style="q2" vid="1CH 2:41">Yeqamiya Elishaama'i i'le.<verse eid="1CH 2:41" /></para>
  <para style="s1">Kaalebixxa Horte</para>
  <para style="q1">
    <verse number="42" style="v" sid="1CH 2:42" />Yirahime'elka dayyo, Kaalebixxa labbaxxa oose: isk angafi belti Mesha, Ziifi'i i'le; Zifinna Merisa'a i'le; Merisanna Kebirooni'i i'le.<verse eid="1CH 2:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="1CH 2:43" />Kebiroonixxi labbaxxi oose: Qere, Tefuwa, Reqeminna Shima'iten,<verse eid="1CH 2:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="1CH 2:44" />Shima'i Rehami'i i'le; Rehaminna Yorqe'ami'i i'le. Reqemi Shemayi'i i'le;<verse eid="1CH 2:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="1CH 2:45" />Shemayi Ma'ooni'i i'le; Ma'ooninna Beetitsurinii i'le.<verse eid="1CH 2:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="1CH 2:46" />Kaalebixxi shiixxooxxa are, Eefa, Haraani'i, Motsaaninna, Gaazezini'i ilde. Haraani Gaazezini'i i'le.<verse eid="1CH 2:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="1CH 2:47" />Yahidayixxi labbaxxa oose: Regeemi, Iyyo'atami, Geshaan, Faleexxi, Eefanna She'afiten.<verse eid="1CH 2:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="1CH 2:48" />Kaalebixxi shixxooxxa are, Ma'ika, Sheberinna Tirihana'a isi'a ilde.<verse eid="1CH 2:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="1CH 2:49" />Tinni manjichcho turiteexxi Madimananika anna, Saafaninna Makibinakanna Gibi'anika anna, Shawwaani'i isi'a ilde. Kaalebi Akisa hiyyendaaxxa belto afeemman.<verse eid="1CH 2:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="1CH 2:50" />Kunni duuchchi Kaalebixxe hortemman. Eefiraataaka angafa belto, Huurixxa labbaxxi oose: Sobaali, Qiriyatiyi'aarimik anni,<verse eid="1CH 2:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="1CH 2:51" />Selimoon Beeteliheemik anninna, Hareefi Betigaaderik annani.<verse eid="1CH 2:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="1CH 2:52" />Qiriyatiyi'aarimika anna, Sobaalixxi horte: Haro'eeti, Menuhotik gamisi,<verse eid="1CH 2:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="1CH 2:53" />Iittanni Qiriyatiyi'aarimixxi gosuwwa: Yitiraatito, Fatito, Shumatito, Mishiratito, Tsori'atitotinna Eshita'oolito, Tsori'atotinna Eshita'olito konneerinaa'n daggeexxe gosuwwan.<verse eid="1CH 2:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="1CH 2:54" />Selimoonixi horte: Beeteliheemi, Neexoofitito, Axarobeti Yo'abi, Menahatotik gamisi, Tsori'ato,<verse eid="1CH 2:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CH 2:55" />Yaabetsi hedhaa'neeke borreessanjuwwixxi gosuwwa: Qiri'ato, Shemi'atonna Sukkaato. Kunniir Rekaabika anna, Hamatinaa'n daggeexxe Qeniton.<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s1">Daawwitixxa Labbaxxa Oose</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1" />Daawwiti Kebirooni hedhema wodda i'lemmaxxi labbaxxi oose konnechchin butti'a hexxeen: Iyyizira'eelichcho Ahino'aam ildeek angafi belti, Aminoon, langak, Qermelosichcho, Abigeeli ildek, Dani'eeli,<verse eid="1CH 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="1CH 3:2" />Sakkak, Moyanjo Geshuurexxi belto, Talami, ildeek Abeseloomi, Sholgak Hagiiti ildeek, Adooniyaasi,<verse eid="1CH 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="1CH 3:3" />Ondik, Abixaalinaa'n i'leek, Sefaxiyaasi, jiyaki, are ifixxe, Eegilanaa'n ileek, Yitireham.<verse eid="1CH 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="1CH 3:4" />Tinni jaane oose Daawwiti'a ilendeek isi Kebirooni hedheexxi torbaan wogganna gamisa galche'emma woddamman.</para>
  <para style="p" vid="1CH 3:4">Daawwiti Iyyerusaalemi'i sase tommenna sase wogga mowe.<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2SA 5:4-5">2 Sam. 5:4-5</ref>; <ref loc="1KI 2:11">1 Moy. 2:11</ref>; <ref loc="1CH 29:27">1 Odo. 29:27</ref>.</char></note> <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />Isinna ookko hedhema wodda konneechchinni butti'a hexxeexxa heddo labbaxxa oose i'leemi;</para>
  <para style="q1" vid="1CH 3:5">Samusi, Sobaabi, Naataani, Solomooni. Tinni shoole labbaxxi oose, Ami'eelixxa belto, Berissaabehinaa'n i'leexxen.<note caller="-" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="2SA 11:3">2 Sam. 11:3</ref>. </char></note><verse eid="1CH 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="1CH 3:6" />Wele labbaxxa oosenna afe'eeman; insa'nek summinna Yibihaar, Elishuu'a, Elifaalexi, <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />Nogga, Naafeqi, Yaafi'a, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />Elishaama'i, Eliyada'inna, Elifeelexi hiyyemaan; duuchiinxi mitteba sallaneteman. <verse eid="1CH 3:8" /><verse number="9" style="v" sid="1CH 3:9" />Tenneeeri gadho welr Daawwitti ifixxe shiixxooxxe aruwanaa'n i'leexxe labbaxxe oose gadhi darre tinni duuchcha isixxe oosemman. Insa'nenna Ti'imaar hiyyendaaxxe dayyo anfeeman.<verse eid="1CH 3:9" /></para>
  <para style="s1">Yihudaka moyanjuwwa</para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 3:10" />Solomoonik belti Roobi'aami,</para>
  <para style="q2" vid="1CH 3:10">Roobi'aamik belti Abiya,</para>
  <para style="q2" vid="1CH 3:10">Abiyak belti Aasa,</para>
  <para style="q2" vid="1CH 3:10">Aasak belti Iyyosafixxi,<verse eid="1CH 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 3:11" />Iyyofaaxxik belti Iyyoraam,</para>
  <para style="q2" vid="1CH 3:11">Iyyoraamik belti Akaaziyaas,</para>
  <para style="q2" vid="1CH 3:11">Akaaziyaasik belti Iyyo'aasi,<verse eid="1CH 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 3:12" />Iyo'aasik belti Amesiyaas,</para>
  <para style="q2" vid="1CH 3:12">Amesiyaasik belti Azaaryaas,</para>
  <para style="q2" vid="1CH 3:12">Azaaryasik belti Iyyo'ataam,<verse eid="1CH 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 3:13" />Iyyo'atam belti Akaazi</para>
  <para style="q2" vid="1CH 3:13">Akaazik belti Hiziqiyaas,</para>
  <para style="q2" vid="1CH 3:13">Hiziqiyaasik belti Minaase,<verse eid="1CH 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 3:14" />Minaasek belti Amooni,</para>
  <para style="q2" vid="1CH 3:14">Amoonik belti Iyyosiyaas,<verse eid="1CH 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 3:15" />Iyyosiyaasixxi labbaxxi oose,</para>
  <para style="q2" vid="1CH 3:15">angaf, Yohaanan,</para>
  <para style="q2" vid="1CH 3:15">langak isik belti, Iyyo'aaqem,</para>
  <para style="q2" vid="1CH 3:15">sakkak isik belti Sedeqiyaasi,</para>
  <para style="q2" vid="1CH 3:15">sholgak isik belti Seloomiten.<verse eid="1CH 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 3:16" />Iyyo'aaqemixxi labbaxxi oose,</para>
  <para style="q2" vid="1CH 3:16">Ikkoniyanna Sedeqiyasiteni.<verse eid="1CH 3:16" /></para>
  <para style="s1">Booji'oti Uduma hedhemmaka moyanjummatika Daalo</para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 3:17" />Booji'ememake, Ikkooniyaxxi horte:</para>
  <para style="q2" vid="1CH 3:17">belti isik Selatiyaali,<verse eid="1CH 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 3:18" />Melikiraami,</para>
  <para style="q2" vid="1CH 3:18">Fedaya, Shinatsaar, Yeqaamiya,</para>
  <para style="q2" vid="1CH 3:18">Hoshaamanna Nedabiyaten.<verse eid="1CH 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 3:19" />Fedeyaxxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 3:19">Zerubaabelinna Seme'i.</para>
  <para style="q1" vid="1CH 3:19">Zerubaabelixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 3:19">Mesulaami, Hanaaniya,</para>
  <para style="q2" vid="1CH 3:19">dayyo insa'nexxinna Seloomiti hiyyendaan.<verse eid="1CH 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 3:20" />Iittanni wele onde labbaxxa oosenna afeemman;</para>
  <para style="q2" vid="1CH 3:20">insa'nenna Hashuba, Oheeli,</para>
  <para style="q1" vid="1CH 3:20">Beerekiya, Hasadiyanna, Yushabihesediten.<verse eid="1CH 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 3:21" />Hanaaniyaxxi horte;</para>
  <para style="q2" vid="1CH 3:21">Felaaxiya, Yishaya, ittanni Yerfaayaxxi,</para>
  <para style="q2" vid="1CH 3:21">Arnaanixxi, Abidiyuxxinna Sekeeniyaxxiten.<verse eid="1CH 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 3:22" />Sekeeniyaxxi horte,</para>
  <para style="q2" vid="1CH 3:22">Shemayanna isixxi labbaxxi oose,</para>
  <para style="q2" vid="1CH 3:22">Haxuushi, Yugaali, Baariyaahi, Ne'ariya,</para>
  <para style="q2" vid="1CH 3:22">Shafaaxxitemani. Duuchiinxi mitteba jaanetemman.<verse eid="1CH 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 3:23" />Ner'aaryaxxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 3:23">Eliyo'eenayi, Hiziqiyaasinna, Aziriqamiten; duuchchinxi mitteba saseteman.<verse eid="1CH 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 3:24" />Eliyo'eenayimixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 3:24">Hodaawiya, Eliyaashib, Feliya, Aquubi,</para>
  <para style="q2" vid="1CH 3:24">Yohanaani, Delaaya, Anaaniten, Duuchchiinxi mitteba torbaanetemman.<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s1">Wele Yihudaxxa Horte</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1" />Yihudaxxi horte:</para>
  <para style="q2" vid="1CH 4:1">Faareesi, Hetsiroomi, Kaarmi, Huurinna, Shobaliten.<verse eid="1CH 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="1CH 4:2" />Sobaalik belti Raaya Yahaatini'i i'le;</para>
  <para style="q2" vid="1CH 4:2">Yahaatinna Ahumaayininna Lahadini'i i'le; tinnir Tsoryiittotixxe horten.<verse eid="1CH 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="1CH 4:3" />Eexamixxi labbaxxi oose konneechchinn butti'a hexxeexxen:</para>
  <para style="q2" vid="1CH 4:3">Eyiziri'eeli, Yishema, Edibaashi.</para>
  <para style="q1" vid="1CH 4:3">Dayyo insa'nexxinna Hatseleelifoni hiyyendaaxxe.<verse eid="1CH 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="1CH 4:4" />Faanu'el Geedoreni'i i'le, Etseerinna Hushaan'i i'le.</para>
  <para style="q2" vid="1CH 4:4">Kunniir Eefiraataaka angafa belto, Beetelihemike anna kadeeke Hoorixxi horten.<verse eid="1CH 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="1CH 4:5" />Teequhek anni Ashihuur,</para>
  <para style="q2" vid="1CH 4:5">Helanna Ne'iirate hiyyendaaxxe lame are afeemman.<verse eid="1CH 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="1CH 4:6" />Ne'iranna, Ahuzaamini'i, Heferi'i, Teminini'i,</para>
  <para style="q2" vid="1CH 4:6">Ahaashitaarini'i isi'a ildeekeeran. Tinni Ne'iiraxxe horten.<verse eid="1CH 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="1CH 4:7" />Helaxxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 4:7">Dereet, Yetsihaarinna Eetinaaniten.<verse eid="1CH 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 4:8" />Qootsinna Anuubiinna Tsobeeba hiyyendaaxxa lame labbaxxa oose i'le; iittanni Qootsi Haaruumika belto Ahaari'eelixxe sanne kadeeke manni'a gosati minike annan.<verse eid="1CH 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 4:9" />Yaabetsi ifike dayyuwwi irra yo'oshsha ulfeseme'emake manjomman; ama isixxinna «Lumoxxe rakkoni i'lenneken» hiteexxi summa iska Yaabetsi hite fulchite.<verse eid="1CH 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 4:10" />Yaabetsinna, «Ee, anike Magenoo anee eebisi; boga ankanna ani'a fadi; anga atixxi aninni welti hexxowwaal; anee miitaxxe heene elobaaxxe yaanena'ni ane'e heqqi» hiyye'e; Isira'eelike Mageno Duuchchi Woddike Goottibaa soodate Duuchchi Woddik Goottinna soodatemmashshanni isi'a uwwe.<verse eid="1CH 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 4:11" />Shuhak dayyi, Kelubi, Mehirii'i i'le;</para>
  <para style="q2" vid="1CH 4:11">Mihiriinna Eshitoonii'i i'le.<verse eid="1CH 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 4:12" />Eshitooninna Beetiraafi, Fasehaanna Tehinaa'a i'le; Tehinaa Nahaashika qachcha sirete'n safeek isoten. Kunnirinna Reekaxxe hortemman.<verse eid="1CH 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 4:13" />Qeenezixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 4:13">Gotoniyalinna Seraayaten.</para>
  <para style="q1" vid="1CH 4:13">Gootoniyalixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 4:13">Hatati, Me'onotayi.<verse eid="1CH 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 4:14" />Me'onotayinna Ofiraani'i i'le.</para>
  <para style="q2" vid="1CH 4:14">Seraayami'i Iyo'aabik anninna Geharashiimike<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="ft" closed="false">Geharashiimi hiyya angatixxe ogeke mannike qachcha hiyyaten</char></note> hiyeme. Itta hiyyemeechchi angatixxe ogeke manna kandeemmaxxe kunni Geharashiimi hiyyemaak summi insa'ne'a uwweme.<verse eid="1CH 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 4:15" />Kaalebi'i Yifuneki beltixxe labbaxxi oose:</para>
  <para style="q2" vid="1CH 4:15">Iru, Elanna Ne'amiten.</para>
  <para style="q1" vid="1CH 4:15">Elaki beltinna Qeneeziten.<verse eid="1CH 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 4:16" />Yihaleli'eli'ixxi labbaxxi oose: Ziifi, Ziifa, Tireyanna Asari'eeliten.<verse eid="1CH 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 4:17" />Iziraxxi labbaxxa oose:</para>
  <para style="q2" vid="1CH 4:17">Yeter, Meredi, Efeerinna Yaalonten; Meredixxi aruwwanaa'n mitte Maryaamii'i, Shemayiinna Eshettemi'aka anna, Yishibaanii'i ilde.<verse eid="1CH 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 4:18" />Isixxi yihudichcho arenna Geedorika anna, Yurediini'i, Ysokoonika anna, Haberini'i, Yezanoowanik anna, Yequti'elini'i ilde. Tinni oose Mereedi aadheexxe, Feri'oonxa belto, Biitiyaxxe oosen.<verse eid="1CH 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 4:19" />Hodiyaami Naahaminetixxa dayyo aadheeni; insa'nexxihorte Qe'ilake qachcha'ni hedhaamake; Garemmixxe gosake mini'ana Eshettemo'ak qachcha'ni hedhaamake Ma''ikatixxe gosake mini hadi'a annuwwakeman.<verse eid="1CH 4:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 4:20" />Shimonixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 4:20">Aminoo, Reena, Beenihanaani, Tiloon. Yishii'ixxi horte: Zohetiinna, Beenezoheti.<verse eid="1CH 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 4:21" />Yihudaka belto, Seloomixxa labbaxx oose:</para>
  <para style="q2" vid="1CH 4:21">Lekakki anni Eeri, Meeriisakinna Beeti'ashebek qachchi giddo fuuta suqeexxi seemma giissammake mannixxe gosaki anni, Le'aada.<verse eid="1CH 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 4:22" />Yooqiimi, kozeba manninna Mo'aabika arda galcheek Serafinna Yashubiliheem; jirte insa'nexxinna hundii'n daggeexxen.<verse eid="1CH 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 4:23" />Insa'nenna Nexa'iminna Gedeera he'na'n faariinka mi'ya hunja'nemmaken; insa'nennba ooko faarnka mi'a moyanjokee hunja'nemman.<verse eid="1CH 4:23" /></para>
  <para style="s1">Simi'oni'i</para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 4:24" />Simi'oinixxi horte:</para>
  <para style="q2" vid="1CH 4:24">Nemu'el, Yaamene, Yaaribin, Zaarahinna, Sa'uliten.<verse eid="1CH 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 4:25" />Seelomi, Sa'ulike belton; Mibisaami Seelomike belton;</para>
  <para style="q2" vid="1CH 4:25">Masima'inna Mibisaamike belton.<verse eid="1CH 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 4:26" />Masima'ixxi horte:</para>
  <para style="q2" vid="1CH 4:26">belti isik Hamu'eeli, belti isik Zakurinna Semi'i.<verse eid="1CH 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 4:27" />Semi'i tommenna jaane labbaxxa oosenna jaane meyyaxxa oose afeemman; isik dayyuwwi kinni heddo oose afemmabaan; tennexxee insa'nexxi gosa duuchcha Yihudaxxe gosake ardishsha heddo arda affemmabaan.<verse eid="1CH 4:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 4:28" />He'nema boonchuwwinna konneechchinni butti'a hedheeken: Bersaabehi, Molaada, Hatsarishu'aali,<verse eid="1CH 4:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 4:29" />Biliha, Etseemi, Tolaadi,<verse eid="1CH 4:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 4:30" />Betu'eel, Horima, Tsiqilaag,<verse eid="1CH 4:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 4:31" />Beetimarikabooti, Hotsarisuusimi, Beetibiirinna Shi'arayimiten; insa'ne Daawwitixxe mootumatike bar qioco'n he'na'ammak konne qachchuwwa'nitemman.<verse eid="1CH 4:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 4:32" />Insa'neke loola'n afemaammak olla'uwwi kinni Exaami, Ayin, Remoon, Tooken, Ashaani hiyyemeke onde qachchuwwan;<verse eid="1CH 4:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 4:33" />Konne qachchuwwike qarqara'ni Ba'ilaati qico'n hedheek olla'uwwi hedhemman; insa'nenna he'naake kandaa wodda ila ilatixxa jirte borreesinaaka maxaafann anfeemman.<note caller="-" style="x"><char style="xo" closed="false">4:33 </char><char style="xt" closed="false"><ref loc="JOS 19:2-8">Iya. 19:2-8</ref>. </char></note><verse eid="1CH 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 4:34" />Moshobaab, Yamilekinna Ametsiyaasik belti Iyyusiyaasi,<verse eid="1CH 4:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 4:35" />Iyyu'eeli, Yoshibiyaki belti Iyyu, Seraayak belti, Asi'eelik belti,<verse eid="1CH 4:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 4:36" />Ittanni Eliyo'eenayi, Ya'iqooba, Yeshohaaya, Asaaya, Adi'eli, Yeshimi'eeli, Bennayaasi,<verse eid="1CH 4:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="1CH 4:37" />Shifiki belti Ziiza, Alonek belti, Yidaayak belti, Shimeriyak belti, Shemaayak belti.<verse eid="1CH 4:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="1CH 4:38" />Kunni summi insa'nen konneechchinn iima kuleemeek manni ifi ifixxe gosa gosake akeekisanjuwwaman; insa'neke mini hadi laakkossinna yo'oshsha leba'ni me'e.<verse eid="1CH 4:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="1CH 4:39" />Insa'nenna hore ifike quffeexxa badda'a hasito dhooqatenaa'n boroti darre'n Geraari qico'n me'ine.<verse eid="1CH 4:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="1CH 4:40" />Okkoonna quffeexxe eloxxe badda'axxa bakka anfe; bogi ikkinna ba'lakenna mittichchi shokki hiyyaachi hedhebaaxxe nage'iinxe bakkamman; edike baro'n okkone boga'n mitti mitti Kaamixxe gosak manni hedha'nemman.<verse eid="1CH 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41" />Kunni summi insa'nek konneechchi iima kulemeek manni konne boonchiba'a dageek Yihudaka moyanjo, Hiziqiyasike baro'nitemman; insa'nenna seemmat giisineeke ifi ifike duunkaani giddo hedhamaka Kaamixxe gosanna Mi'unito lolle birre; tinni yaanenna telchi qico'n ege'nendeexxen; insa'ne hore ifikee geltaaxxa badda'atixxa bakka anfeemmaxxee ookko hedhate'n ke'ne.<verse eid="1CH 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CH 4:42" />Konner giddii'n onde dhibba kadaki Siimi'oonixxe gosak manni Seyiirixxe koobaba'a me'ine; insa'nenna akeeka'ammak Yishi'xxe oose: Felaxiya, Ne'arya, Rifaayanna Uzi'ellitemman.<verse eid="1CH 4:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 4:43" />Insa'nenna ookko gattemaxxa Amaaleqito birreexxi okkone booncho'n ofolle.<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s1">Roobelixxa Horte</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1" />Isira'elika angafa belto, Roobelixxa oose: Roobel angafa belto kadoolenna anniinxa ma'na battosemaxxe'e, angafummatik seeri Isira'eelika belto, Yooseefixxe oose'a uwwemeen. Tennenaa'ni kexxeexxa isi ila ilatike laakkossike maxaafi giddo angafummati lakko'emebaan.<verse eid="1CH 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 5:2" />Yihuda ifike dayyuwwi irra jabakemman; gadoomi dageek isinaa'nite kaddolenna angafuntetik seer sa'iseme uwwemeek Yoosefi'ateman.<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="GEN 49:8-10">Dada. 49:8-10</ref>.</char></note><verse eid="1CH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 5:3" />Isira'eelike angafa beltixx, Roobelixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 5:3">Heenooki, Faalusa, Atsirooninna, Kermiten.<verse eid="1CH 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="1CH 5:4" />Iyyu'eelixxi horte: belti isik Shemaya, belt isik Gogi, belti isik Semiya,<verse eid="1CH 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="1CH 5:5" />Belti isik Miika, belti isik Raayanna belt isik Bi'eeli.<verse eid="1CH 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="1CH 5:6" />Teligelitelifelisoori, Asoorik moyanji booji'emmak isik belti Be'era.<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="2KI 15:29">2 Moy. 15:29</ref>. </char></note><verse eid="1CH 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="1CH 5:7" />Insa'nek mini mini hadik gosa gosak ilatik laakkossi borreessemeemma qic konneechchinni butti'a hedheeshshaten:</para>
  <para style="q2" vid="1CH 5:7">gosatike mini hadik akeekisanjo kadeek Iyyu'eeli, Zakaaryaasi,<verse eid="1CH 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 5:8" />Iyyu'eelik belti, Shema'ik belti, Azaaziki belti Bela'itemman; kunni duuchchi hedhaamak Aro'eeri'ninna ookko'ne middi darree'ni Naabawwi qico'n iittanni Be'aalimetsooni qico'n hedheeke boga'n ofo'le.<verse eid="1CH 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 5:9" />Hori insa'nek Gele'adike boga'ni bira sa'emaxxee boroti darree'n Efiraaxisike galaanibaa'ni qiilla gammoojjeke kasiqico'ni hedheeka boga abixxine.<verse eid="1CH 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 5:10" />Saa'ooli galchamake baro'n anga ifixxenni lolleexxi injifantemmaxxe Haggaaritoti welti lolemmeexxi Gele'adike bogi giddo duuchcha he'namaka boga abixxine.<verse eid="1CH 5:10" /></para>
  <para style="s1">Gaadii</para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 5:11" />Gaadik gosak manninna insa'ne'n aanexxi Selikiqico'n hedheeke Baasaanike boga'n ofolle.<verse eid="1CH 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 5:12" />Takaaki akeekisisanji Iyyu'eeli, langak Safasini, okko'n Yaa'inayinna Sefaaxxi Baasaani'i ofolle.<verse eid="1CH 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 5:13" />Insa'nek firuwwinna ifi ifike mini haduwwinni konneechchin butti'a hedheekeeran:</para>
  <para style="q2" vid="1CH 5:13">Mika'eeli, Mesulaam, Saaba, Yoraay, Yaa'ikaninna, Zi'anna, Obediten; duuchching mitteba torbaanekemman.<verse eid="1CH 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 5:14" />Insa'nenna Buuzike belti, Yarohaak belti, Iyesayik belti, Mika'eeliki belti, Gele'adik belti, Idayik belti, Uurk belti, Yaahido Huurik belti, Ibihayi'eeixxe oosemman.<verse eid="1CH 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 5:15" />Insa'neke mini haduwwik akeekisaji Akii Gunik aka'i, Abidi'eelike beltomman.<verse eid="1CH 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 5:16" />Gadito Gele'adike boga'ni, Baasaani'ninna qarqarake'n hedhemmake shiixxaramma qachchuwwa'n, ittanni Saaroni giddo horiinxe bobaxxe bakka duuchcha'ninna ooko'ni edi'anna sa'neexxi ofolle.<verse eid="1CH 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17" />Kunnir duuchchi ilatik laakkossi borreessememmake maxaafa'n borreessemeek Yihudaka moyanjo Iyyo'ataamikenna Isira'eelika moyanjo Iyyoribi'amike galchatike baro'niten.<verse eid="1CH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />Roobelik, Gaadikinna gamisi Minaaseke gosake mini shoole tomme shoole kumanna torbaane dhibbanna jaane tommi loola dande'aak manna anfeemman; insa'nenna wontenna wolaanticha abixxa, gabe darba dande'aak jabak lolik muxxe fuleemmaran. <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />Insa'nenna Haggaarito, Yixuurito, Naafesitotanna Naadabito lolle. <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />Insa'nenna loliinxa yanna bagedinbaa'n Mageniba'a raareemaxxee lolake'ni insa'ne'e gargaare; Haggaaritotinna loliba'ik jaaluwwa insa'neke duuchcha'n sa'isse insa'ne'e uwwe; iso'o addantemmaxxee soodachcho insa'nexxanna laqe. <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />Agaritotika hore onde tomme kuma gaaluwwa, lame dhibbanna onde tomme kuma gedhebonna lame kumma harre boojine; ittanni mitte dhibba kuma manjonna boojine. <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />Loli Mageniinke kademaxxee wel heddi manni shiyeme. Booji'enshatixxe yanna qico'n bogi anga insa'nexxe'n hedhemman.<verse eid="1CH 5:22" /></para>
  <para style="s1">Minaaseka Gosatika Gamisa</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />Gamisa Minaaseke gosatik minik ardixxe horteki laakkossi yo'okemman: insa'nenna Ba'aaliherimooni; Oli'armoni'el qico'ni hedheeke Baasaanike boga'ni ofolle; tinninna Saaner Haremoni'elixxe kooba qico'nte.<verse eid="1CH 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 5:24" />Mini mini hadiki akeekisanjuwinna konneechchinn butti'a hedheekeeran; Efeer, Yishi'i, Eli'eel, Aziri'eeli, Eermiyaasi, Yaahidi'eeli, Iyyedi'e, kunni jannuwwi loliink mannanna ifi ifike mini mininik hadike akeekisansuwwamman.<verse eid="1CH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 5:25" />Kaddomalee ifi ifike annuwiinke Mageni'a addatemebaan; Mageni bogakenaa'ninna insa'ne edii'n ardi mageneefantammaka magenuwwa shorreemaka hinge mageneefante yababuleen. <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />Tennexxee Isira'eelik Mageni Asoorika mayanjo Fohanika hafuura dammasseexxi Roobelika, Gaadikanna Minaasexxa horte gamisa booji'e adhdhaashsha asse. Kunninna Halahibaa, Heboorba, Haraana'a, Goozanake galaanik gabalaba'a insa'ne'e sa'isse; insa'nenna telchi qico'n okko'o he'neen.<note caller="-" style="x"><char style="xo" closed="false">5:26 </char><char style="xt" closed="false"><ref loc="2KI 15:19">2 Moy. 15:19</ref>, <ref loc="2KI 15:29">29</ref>; <ref loc="2KI 17:6">17:6</ref>. </char></note><verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s1">Leewwito</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 6:1" />Leewwixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 6:1">Gershoone, Qee'aati, Meeraari.<verse eid="1CH 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="1CH 6:2" />Qee'aatixxi labbaxxi oose, Imibereemi, Yisi'ari, Kebiroonenn, Uuzi'eeli.<verse eid="1CH 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="1CH 6:3" />Imibereemixxi oose:</para>
  <para style="q2" vid="1CH 6:3">Aroon, Muuse, Maaryaami.</para>
  <para style="q1" vid="1CH 6:3">Aaroonixxi labbaxxi oose:</para>
  <para style="q1" vid="1CH 6:3">Naadabi, Abihu, Ali'aazaar, Itamaari.<verse eid="1CH 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="1CH 6:4" />Ali'aazaar Fenehaasii'i i'le;</para>
  <para style="q2" vid="1CH 6:4">Finihaasi Abishu'aanii'i i'le.<verse eid="1CH 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="1CH 6:5" />Abishu'a Buqini'i i'le;</para>
  <para style="q2" vid="1CH 6:5">Buqi Oozii'i i'le.<verse eid="1CH 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="1CH 6:6" />Oozi Zerahiyya'a i'le;</para>
  <para style="q2" vid="1CH 6:6">Zerahiyya Meeraayootii i'le.<verse eid="1CH 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="1CH 6:7" />Meeraayooti Amareya i'le;</para>
  <para style="q1" vid="1CH 6:7">Amareya Ahixoobii'i i'le.<verse eid="1CH 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 6:8" />Akiixoobi Saadooqii i'le; Saadooqinna Ahima'aatsii i'le;<verse eid="1CH 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 6:9" />Ahima'aatsinna Azareyasi'i i'le;</para>
  <para style="q2" vid="1CH 6:9">Azaryasi Yohanani'i i'le.<verse eid="1CH 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 6:10" />Yohana Azareyasi'i i'le;</para>
  <para style="q1" vid="1CH 6:10">Isinna Solomooni'i Iyyerusaalemi hujisemmake</para>
  <para style="q1" vid="1CH 6:10">Galma'ni qeesomik huja'nemman.<verse eid="1CH 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 6:11" />Azaryasi Amareya i'le;</para>
  <para style="q2" vid="1CH 6:11">Amareya Ahixuubii'i i'le.<verse eid="1CH 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 6:12" />Ahixuub Sadoqii'i i'le;</para>
  <para style="q1" vid="1CH 6:12">Sadoqi Seloomi'i i'le.<verse eid="1CH 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 6:13" />Selomi Hilqiyaasi'i i'le;</para>
  <para style="q2" vid="1CH 6:13">Kelqiyasi Azareyasi'i i'le.<verse eid="1CH 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 6:14" />Azareyasi Serayaasi'i i'le;</para>
  <para style="q2" vid="1CH 6:14">Seraya Iyyoosedeqini'i i'le.<verse eid="1CH 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 6:15" />Duuchchi Woddik Gootti Yihudakanna Iyyerusaalemika</para>
  <para style="q2" vid="1CH 6:15">arda Nabukedenetsorixxe anga'ni booji'eme adhemaashsha asse wodda;</para>
  <para style="q1" vid="1CH 6:15">Iyyoosedeqiminna welti booji'eme me'e.<verse eid="1CH 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 6:16" />Leewwixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 6:16">Gershoon, Qee'aatinna, Meeraari.<verse eid="1CH 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 6:17" />Gershoonixxi labbaxxi oose:</para>
  <para style="q1" vid="1CH 6:17">Loobeninna Seme'i.<verse eid="1CH 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 6:18" />Qee'aatixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 6:18">Ibermi, Yisi'ar, Kebirooninna Uzi'el.<verse eid="1CH 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 6:19" />Meeraarixxi labbaxxi oose:</para>
  <para style="q2" vid="1CH 6:19">Mahilinna, Muushi.</para>
  <para style="q1" vid="1CH 6:19">Ifi ifike annuwike mini hadin laako'emekir</para>
  <para style="q2" vid="1CH 6:19">Leewwixxe gosaki hadi konneechchinn butti'a hedheekeran;<verse eid="1CH 6:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 6:20" />Gershooni'n Lobeni i'le, Libeni Yahaati i'le, I'eeti Ziimati i'le;<verse eid="1CH 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 6:21" />Yo'ahi, Ado, Zeerahiminna, Yatirayi'i.<verse eid="1CH 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 6:22" />Qee'aatixxi horte: belti isk Aminaadaabi Qore i'le, Qore Asiiri i'le,<verse eid="1CH 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 6:23" />Asiiri Eliqaanaa'a i'le, Elqaana Abisaafi i'le, Abisaafi Asiiri i'le.<verse eid="1CH 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 6:24" />Asiiri I'iti i'le, I'iti Uri'eeli i'le, Uuri'eel Oziya i'le, Oziya Sawul i'le.<verse eid="1CH 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 6:25" />Hilqaanaxxi horte:</para>
  <para style="q2" vid="1CH 6:25">Amasayiinna Ahimootii'i.<verse eid="1CH 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 6:26" />Hilqaana, Suuf, Nahat,<verse eid="1CH 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 6:27" />Eliyabi, Yiroham, Hilqaananna Samu'el.<verse eid="1CH 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 6:28" />Saamu'eelixxa labbaxxa oose;</para>
  <para style="q2" vid="1CH 6:28">angaf belti Iyu'eli, itti aanek Abiyateman.<verse eid="1CH 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 6:29" />Meeraarixxi sannuwwa</para>
  <para style="q2" vid="1CH 6:29">Mahili, Libeni, Shemin Ooza,<verse eid="1CH 6:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 6:30" />Saami'a, Hagiyaminna, Asayaten.<verse eid="1CH 6:30" /></para>
  <para style="s1">Galmiinxa Faarsaleyye</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />Taabooti Yerusaalemi e'yeechchi uduma, Daawwit faarsaleeyetik akeekisanjo asse Duuchchi Woddike Goottike mine'n konne manna file; <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />Insa'nenna Solomoon Duuchchi Woddike Goottiki galmi Iyyerusaalemi'i hujema qico'n; isike galdumiba kunninna Mageni galammake afenshatike duunkaani edo he'ne faarsina'nemman: insa'nenna faarsina'nemmak insa'ne'a annichchi annichchik dhaanbe giissemmaashshanden.<verse eid="1CH 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 6:33" />Labbaxxe insa'nexxe oosenni welti kande ergatemammak manni konneeramman;</para>
  <para style="q1" vid="1CH 6:33">Qee'aatitotixxe oosenaa'n; faarsanji Hemaan, Iyyu'elinna, Saamu'eeli,<verse eid="1CH 6:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 6:34" />Hilqaanak belti, Yirohamik belti, Eli'eeliki belti, Towoki belti,<verse eid="1CH 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 6:35" />Sufiki belti, Hilqaanak belti, Mehatik belti, Amamik belti<verse eid="1CH 6:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 6:36" />Hilqaanak belti, Iyyuu'eelik belti Azareyasi belti, Soffoniyaasik belti;<verse eid="1CH 6:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="1CH 6:37" />Tahataki belti Asiirik belti, Abiyaasaf belti, Qerek belti;<verse eid="1CH 6:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="1CH 6:38" />Yisi'arik belti Qee'aatik belti, Leewwik belti Isira'eelik belti.<verse eid="1CH 6:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="1CH 6:39" />Ittanni Hemanik dayyi Asaafi middi darre'ni hedhe ergatemaamman;</para>
  <para style="q2" vid="1CH 6:39">Berraakiyaki belti Asaf, Sami'ak belti,<verse eid="1CH 6:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="1CH 6:40" />Mika'eeliki belti Ba'iseeyyak belti, Melkiyaak belti;<verse eid="1CH 6:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="1CH 6:41" />Eetinik belti Zerahik belti Adayak belti<verse eid="1CH 6:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="1CH 6:42" />Etank belti, Ziimak belti Shimi'iki belti<verse eid="1CH 6:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="1CH 6:43" />Yahaatik belti Gershoonik belti, Leewwik belti;<verse eid="1CH 6:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="1CH 6:44" />Insa'ne'ni bita'i darre'n welti hedhemmar Meraarixxi oose, Qisaki belti Etaan, Abidik belti Malokik belti,<verse eid="1CH 6:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="1CH 6:45" />Hashabiyak belti, Amesiyaasik belti, Helqiyak belti,<verse eid="1CH 6:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="1CH 6:46" />Amoostik belti, Baanik belti, Sheemeri,<verse eid="1CH 6:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="1CH 6:47" />Mahiliki belti, Muushik belti, Meeraarik belti, Leewwik belti;<verse eid="1CH 6:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />Leewawitotik dayyuwwi kinn; Magenika mine galdumiika duunkaana hunjaashsha insa'nee okko'o uggineemman. <verse eid="1CH 6:48" /><verse number="49" style="v" sid="1CH 6:49" />Mageniink garbichchi Muuse ajajemmashshann Isira'eelixxee gattowaali giddixxe woyyitte kuta giddo hujenda'neexxi huje duuchcha; tolchi booncho'ni ciincesinaaka tolcha hixaana tolcha shiqinshamaba iyyedanga'nek kinn Aarooninna sanne isixxe callamman.<verse eid="1CH 6:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="1CH 6:50" />Aaroonixxi sanne konneechchi butta hexxeexxen;</para>
  <para style="q2" vid="1CH 6:50">belti isik Ali'aazaar, belti isik Finihaasi,</para>
  <para style="q2" vid="1CH 6:50">belti isik Abishu'a <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />Belti isik Buqi,</para>
  <para style="q2" vid="1CH 6:51">belti isik Oozi, belti isik Zerahiyya,<verse eid="1CH 6:51" /></para>
  <para style="q2">
    <verse number="52" style="v" sid="1CH 6:52" />Belti isik Merayuti, belti isik Amarya,</para>
  <para style="q2" vid="1CH 6:52">Ahixoob, <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />Belti isik Saadooqi,</para>
  <para style="q2" vid="1CH 6:53">belti isik Ahima'aatsi.<verse eid="1CH 6:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54" />Galduma insa'neke kadaashsha fi'lineek boonchuwwi; siretiki hixi insa'neke kadeemmaxxe'e Qe'atixxi gosake mini hadi darree'ni kadeeke Aaroonixxe sannuwwa'aa geyeek minuwwik qoobi konneechchinn butti'a hedheeran.<verse eid="1CH 6:54" /></para>
  <para style="pi1">
    <verse number="55" style="v" sid="1CH 6:55" />Insa'nenna Yihudike boga'ni hexxeexxi Kebironinna qarqarake'n hexxeexxi kallee'naa arso quffeeka booncho uune; <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />Kebironi'i qarqara'n hedheeka midha huccinammaka fichcha kinn Yifuneke belto Kalebi'a uwweme.<verse eid="1CH 6:56" /></para>
  <para style="pi1">
    <verse number="57" style="v" sid="1CH 6:57" />Aaroonixxe sanne'a manjo anga sa'eek manji hedhaaka qachchuwwa Kebirooni'i, Libinaa'a, Yatirnii'i, Eshiteemo'aa'a, <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />Hileenii'i, Debiri'i, <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />Ashaanii'i, Yotaanii'i, Beetishemeshiinii'i konnee qachchuwwa hore bobbaalsatike konne qachchuwwike boogininni uune. <verse eid="1CH 6:59" /><verse number="60" style="v" sid="1CH 6:60" />Biiniyamixxe galcha'ni Gebaa'i, Aleemetinna Anaatooti hine ye'naak qachchuwwi hore bobbaansamake boonchchi qico'ni Aroonixxe labbaxxe oose'a uwwendeexxeman. Yoonna Aroonixxe horte'aanna mini hadi duuchchi'a galduma kadaaki tommenna sase qachchuwwamni.</para>
  <para style="pi1" vid="1CH 6:60">Qe'atixxe sanne'a qoodemeek kunni qachchuwwi duuchchi tommennaa sasekemman.<verse eid="1CH 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="1CH 6:61" />Wele gateeke Qee'aatixxe sanne'a kinn Minaaseke gosake mini hadinaa'n gamisa tomme qachcha insa'ne'a uune.<verse eid="1CH 6:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="1CH 6:62" />Gershoorike gosake mini hadina'n Yisakoori'ni Aseeri'ni, Nefitaalemi'ninna Baasaani'i hedheeke Minaasek gosat minik qadaadi'a tommenna sase qachcha insa'ne'a dhaanbe.<verse eid="1CH 6:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="1CH 6:63" />Meeraarixxe sannexxe gosanaa'ni Roobelike, Gaadikenna Zabilonike geegonaa'ni tommenna lame qachchuwwa insa'ne'a dhaanbe.<verse eid="1CH 6:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="1CH 6:64" />Isira'eelik ardinna qachchuwwa konne qicon dhaanbeexxi allala'neg boonchinn Leewwitote'e uune. <verse eid="1CH 6:64" /><verse number="65" style="v" sid="1CH 6:65" />Konneechchi edo kulemeeka qachchuwwa Yihudak, Siimi'oonixxenna Biiniyamixxe gosak minike geegina'n a'lineexxi insa'ne'a dhaanbe.<verse eid="1CH 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="1CH 6:66" />Mitti mittinge Qee'aatike mini hadina'n Efireemixxe gosaki geegi he'na'neeka booncho uune<verse eid="1CH 6:66" /></para>
  <para style="pi1">
    <verse number="67" style="v" sid="1CH 6:67" />Kooba callike Efireemike boga'n hedha'neka manjo anga sa'ek manni hedha'neeka qachchuwwa Sekemi'i, Geezerini'i, <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />Yoqimi'amine, Beetihoroni, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />Ayyalooninna Gaatiremooni allala'neg boonchinninni insa'ne'a uune.<verse eid="1CH 6:69" /></para>
  <para style="pi1">
    <verse number="70" style="v" sid="1CH 6:70" />Ittan Isira'eelik manni Minaaseke gosake minike geegonaa'n Aneerinna Bili'aamite hanaaka qachchuwwa allala'nege boonchinninn aa'ne gateeke Qee'aatixxe gosake manni'a uune.<verse eid="1CH 6:70" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="71" style="v" sid="1CH 6:71" />Gershoonito konneechchinn butti'a hedheeka qachcha a'lite</para>
  <para style="q1" vid="1CH 6:71">Minaasexxe gosake minika gamisa,</para>
  <para style="li2" vid="1CH 6:71">Baasaani hedha'neeke Golaaninna Asitaroti'i allalamang boonchinninn a'line;<verse eid="1CH 6:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="1CH 6:72" />Yisakoorike gosake minena'n,</para>
  <para style="q2" vid="1CH 6:72">Qadesi'i, Dabiratini'i <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />Raamotine, Anemenane, allalamang boonchinninn a'line.<verse eid="1CH 6:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="1CH 6:74" />Aseerike gosat minenaa'n</para>
  <para style="q2" vid="1CH 6:74">Me'asaline, Abidone, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />Huqoqinena, Re'abini'i allalamake boonchini a'line.<verse eid="1CH 6:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="1CH 6:76" />Nefitaalemike gosak minenaa'ni Geliila hedheeka Qadesi'i</para>
  <para style="q2" vid="1CH 6:76">Hamoninna Qireyatayimene allalamang boonchinnin adhdhine.<verse eid="1CH 6:76" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="77" style="v" sid="1CH 6:77" />Leewwitotenaa'ni gateekir Meeraarixxe gosak mini kinn konneechchinn butti'a hedheekaara a'line;</para>
  <para style="q2" vid="1CH 6:77">Zabilonike gosake mini Yuqinimamene, Qertahine; Remoonenna Taborene allalamange boonchinninn a'line.<verse eid="1CH 6:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="1CH 6:78" />Yordaanoosike galaan wido Iyyariko'ni middi dhidhimi darre'n hedheeka Roobelixxi gosake minenaa'n</para>
  <para style="q2" vid="1CH 6:78">qiilla gammoojje'n hedheeka Beetseeri, Yahitsaa, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />Qidimotinna Mefi'atine allalamaneg boonchinninn a'line;<verse eid="1CH 6:79" /></para>
  <para style="q1">
    <verse number="80" style="v" sid="1CH 6:80" />Gaadixxe gosake minenaa'n Gele'adi hedheeka</para>
  <para style="q2" vid="1CH 6:80">Raamoti'i Mahanayimi'i; <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />Haseeboninna Iyyazeerii allalamange boonchinninna a'line?<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s1">Yissaakor</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 7:1" />Yisakoorixxi labbaxxi oose</para>
  <para style="q1" vid="1CH 7:1">Tola, Faawa, Yaasubi, Shimiroon, laakkossi insa'nek shooleken.<verse eid="1CH 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 7:2" />Tolaxxi labbaxxi oose Oozi, Refaya, Yiri'eeli, Yahimayi Yubisami, Shimu'el, kunniir mini hadike akeekisanjuwwan; Daawwitke galchatike baro'ni Tolaxxe sannena'ni, ila ilatik laakkossi giddo hedheeki Tolaxxi sanne jabake lolinke mannamman; laakkossi insa'nekinna lame tommenna lame kumanna jaane dhibbaman.<verse eid="1CH 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 7:3" />Oozixxi labbaxxi oose</para>
  <para style="q1" vid="1CH 7:3">Yizirahiya.</para>
  <para style="q1" vid="1CH 7:3">Yizirahiyaxxi labbaxxi oose</para>
  <para style="q1" vid="1CH 7:3">Mika'eeli, Abidiyu, Iyyu'eeli, Yushiyaa; insa'nenna onde akeekisanjuwwamman.<verse eid="1CH 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 7:4" />Heddo aruwanna heddo oose anfeemmaxxee; mini hado insa'nekixxe ilake laakkossinaa'n lolake'e hunna afe'ekaara sase tommenna jaane kuma manna anfeemman.<verse eid="1CH 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 7:5" />Yisakoorixxe gosak mini duuchchinaa'n loliinki borreessemeek mini hadixxi ila ilaki laakkossi saddeeta tommenna torbaane kumamman.<verse eid="1CH 7:5" /></para>
  <para style="s1">Biniyami</para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 7:6" />Biiniyami sase labbaxxa oose;</para>
  <para style="q1" vid="1CH 7:6">Beela, Beekere, Yidi'eelii i'le.<verse eid="1CH 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 7:7" />Beela'i onde labbaxxa oose,</para>
  <para style="q1" vid="1CH 7:7">Eetseboon, Oozi, Uzu'el, Yaarmuti, Iiri, madading mitteba onde kandaa wodda insa'nenna mine ifi ifike akeekisanjuwwakeran: ila ilatiki laakkossi lame tommenna lame kumanna sase tommenna shoole loliinki manni borreesemeen.<verse eid="1CH 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 7:8" />Beekeri sallane labbaxxa oose,</para>
  <para style="q1" vid="1CH 7:8">Zemira, Yu'aashi, Eli'eezer, Eliyo'eenayi, Omiira, Yrermoti, Abiya, Anatooti, Alemeeti hinaaxxa oose i'le. <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />Ila ilatixxe borroke mazigabi giddo ifi ifike mini hadik akeekisanjuwwinna lami tommi kuminna lami dhibbi loliinki manni borreessemeen.<verse eid="1CH 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 7:10" />Yidi'eelik belti</para>
  <para style="q1" vid="1CH 7:10">Bilihaane.</para>
  <para style="q1" vid="1CH 7:10">Bilihaanixxi labbaxxi oose</para>
  <para style="q1" vid="1CH 7:10">Ye'ushi, Biiniyaam, Eehuudi, Kena'anena Zetaani, Tersesinna Ahishahaar;<verse eid="1CH 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 7:11" />Kunnir duuchchi Yidi'eelixxe oosuwwaxxe mini mininig akeekisanjuwwamman; insa'nenna adhetee itti jabateeka tommenna torbaane kuma loliinka manna anfeemman.<verse eid="1CH 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 7:12" />Saafeninna Hufiimi Iirixxe sanne kandaa wodda</para>
  <para style="q1" vid="1CH 7:12">Hushim kinn Aherexxe sannen.<verse eid="1CH 7:12" /></para>
  <para style="s1">Nefitaalem</para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 7:13" />Nefitaalemixxi labbaxxi oose;</para>
  <para style="q1" vid="1CH 7:13">Yahatsi'eeli, Guni, Yetsir, Shelemi kunnur Bilihaxxe sanneman.<verse eid="1CH 7:13" /></para>
  <para style="s1">Minaase</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 7:14" />Minaasexxi sannuwwa</para>
  <para style="q1" vid="1CH 7:14">Soorichcho gadhixxi isixxi jaalo isi'a ilde'ek labbak belti Asiri'eeliten.</para>
  <para style="q1" vid="1CH 7:14">Isenna Gele'adik anna Makirine isi'a indeexxen;<verse eid="1CH 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 7:15" />Makirmi Hufeemina'n Safemixxe gosana'n aadhe.</para>
  <para style="q1" vid="1CH 7:15">Dayyo isixxinna Me'akate hinaaxxemman.</para>
  <para style="q1" vid="1CH 7:15">Wele isixxi sanne Sipha'aditote kaddaa wodda</para>
  <para style="q1" vid="1CH 7:15">Isinna dubarra calla i'lemman.<verse eid="1CH 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 7:16" />Makirixxi are Mi'aka labbaka belto ilde: summakanna Faaresi hite fulchite.</para>
  <para style="q1" vid="1CH 7:16">Dayyiink summi Surositen; labbaxxi isixxi oosenna Ulaaminna Raaqemetemman.<verse eid="1CH 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 7:17" />Ulaami Bedaan hiyyemaaka labbak belto i'le.</para>
  <para style="q1" vid="1CH 7:17">Kunniir Minaaseke beltika belto, Maakiirika belto Gele'adixxe labbaxxe oosen;<verse eid="1CH 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 7:18" />Dayyo isixxi Meleketi Ishoodi, Abi'eezerinna Mahilaanee ilde.<verse eid="1CH 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 7:19" />Shemiidaxxi labbaxxi oose kinn konneechchi butta hexxeexxen;</para>
  <para style="q1" vid="1CH 7:19">Ani'aan, Sekemi, Liqihinna, Ini'ami.<verse eid="1CH 7:19" /></para>
  <para style="s1">Efireem</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 7:20" />Efireemixxi Shutelahiini'i i'le, Shuutelahiimi Bereedinii'i i'le, Bereedini Tahatiini'i i'le, tahatiini Eli'aadaani i'le, Eli'aadani Tahatinii'i i'le, <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />Zabadi, Shuttula. Ederenna Eli'aadi hore mooro'a dirrineexxa yanna, konne boga'ni ilemeenge Gaatike mannixxe anga'ni shiyeme. <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />Anni insa'nek Efireemi heddo barra insa'nexxe'e oodhe; hadi isikinna dage iso'o jajjabeessine. <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />Ookko'ni are ifixxinni diiphe; isenna sii'la'wite labba belto ilde: hado ifike'n gelteexxe rakkonaa'ni kexxeexxa summakanna Beri'a<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false">Beri'ate hiyya Ibritotike laagadinni Rakkoti hiyyaten.</char></note> hiyye fulche. <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />Meyyaxxik summi Si'araten; isenna alikanna aadika Beetihoroninna Uuzenisheraan hiyyemaaka qachchuwwa uurseexxen. <verse eid="1CH 7:24" /><verse number="25" style="v" sid="1CH 7:25" />Belti Faafe, Reesef, Teela Tahaan, <verse eid="1CH 7:25" /><verse number="26" style="v" sid="1CH 7:26" />Le'idaan, Amihudi, Elishaama'i, <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />Neewinna, Iyyaasuu'u.<verse eid="1CH 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 7:28" />Bogi insa'nekinna he'na'nek boonchi Beeti'eelinna qarqara iseke'n hedha'neeka qachuwwa, dhidhimi darre'n Ne'arane, boroti darre'n Geezirenina olla'uwwa, ittanni Sekeminna ola'uwwa, itti aanati Ayaninna ola'uwwa duuchcha abideemman. <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />Minaasexxe gabala'ni Beetishani'i, Ta'inaki'i Megidonanna Doorike ola'ingininn he'nemman. Konne ola'uwwa'ninna Isira'eelixx oose Yooseefixxi sanne ookko'o he'namman.<verse eid="1CH 7:29" /></para>
  <para style="s1">Asseer</para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 7:30" />Aseerixxi labbaxxi oose</para>
  <para style="q1" vid="1CH 7:30">Yiminna, Yesuwwa, Yesuwwi, Beri'a, dayyo insa'nexxinna Seerahite hinaaxxemman.<verse eid="1CH 7:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 7:31" />Beri'axxi labbaxxi oose</para>
  <para style="q1" vid="1CH 7:31">Hebeerinna, Malk'eeli Biirzachcho hine ye'naaka belto i'le.<verse eid="1CH 7:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 7:32" />Hebeerimi Yafilexi, Samiren, Hotamininna dayyo insa'nexxa Soolane'e i'le.<verse eid="1CH 7:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 7:33" />Yafilexxi labbaxxi oose</para>
  <para style="q1" vid="1CH 7:33">Faaseki, Bimihaali, Asiiti,</para>
  <para style="q1" vid="1CH 7:33">Yaafellexxi labbaxxi oose tenneeramman.<verse eid="1CH 7:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 7:34" />Saamerixxi labbaxxi oose</para>
  <para style="q1" vid="1CH 7:34">Ahii, Rohiiga, Yehuubanna Aaraami.<verse eid="1CH 7:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 7:35" />Ifike dayyinxi Heleemixxi labbaxxi oose;</para>
  <para style="q1" vid="1CH 7:35">Tsoofa, Yimina, Selesi, Amaal.<verse eid="1CH 7:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 7:36" />Tsoofaxxi labbaxxi oose</para>
  <para style="q1" vid="1CH 7:36">Suuwa, Harnefeer, Sogaal, Beeri, Yumiran.<verse eid="1CH 7:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="1CH 7:37" />Beetseeri, Hoodi, Saama, Selisa, Yitiraan, Be'eera.<verse eid="1CH 7:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="1CH 7:38" />Yeterixxi labbaxxi oose</para>
  <para style="q1" vid="1CH 7:38">Yifune, Fesepha, Aara.<verse eid="1CH 7:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="1CH 7:39" />Ulaxxi labbaxxi oose</para>
  <para style="q1" vid="1CH 7:39">Arahi, Hani'eeli, Retsiya.<verse eid="1CH 7:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="1CH 7:40" />Kunni duuchchi Aseerixxi sannuwwa insa'nenna mini hadike akeekisanjuwwan, melleemeke mannanna loliinke jabake dhota mannike sooreessuwwamman. Ila insa'nexxike mazigaba'ni hine borreessineemmashshan lolakee jabakanna dande'aka lame tommenna jaane kuma labballo anfeemman.<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s1">Biiniyammawwichcho Sa'olixxa Ilaxxa Horte</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 8:1" />Biiniyaami angafa belto Beela'i,</para>
  <para style="q1" vid="1CH 8:1">Langaka belto Ashibeel,</para>
  <para style="q1" vid="1CH 8:1">Sakaka belto Ahiraah, <verse eid="1CH 8:1" /><verse number="2" style="v" sid="1CH 8:2" />Sholgaka belto Nohani'i, ondika belto Raafani'i i'le. <verse eid="1CH 8:2" /><verse number="3" style="v" sid="1CH 8:3" />Beela'ixxi labbaxxi oose konnechinn butti'a hexxeexxeeran</para>
  <para style="q1" vid="1CH 8:3">Aadaari, Geera, Abihu, <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />Abishu'a Na'imane, Ahowa, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />Geera, Sefaaf, Huraami.<verse eid="1CH 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="1CH 8:6" />Kunnirinna Geba'i he'namakenna udumi uduma booji'oti Menahaati'a a'lemeeke Ehuudixxe sannuwwamman. <verse eid="1CH 8:6" /><verse number="7" style="v" sid="1CH 8:7" />Ehuudixxi sannuwwa Na'imaan, Ahiyanna Geera hine ye'naakeeraman; insa'nenna booji'emme ookkonneechchi uduma Manahaate'a me'ine ookko'o hedhemake mini hadi'a sooresake kandeeman; insa'nee ookko'a akeekeek Uuzanna Ahihuudike anna Geeratemman.<verse eid="1CH 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 8:8" />Shehaarayim Huushimiinna Ba'irrate hine ye'naaxxa lame ifixxa aruwwa tike; isinna tureexxi Mo'aabike boga'ni hehda'neege'ni Hodeshi hinaaxxa mitte manjichcho aadheexxi torbaane labbaxxa oose i'le; inisa'nenna Yubaabi, Diibiya, Meesha, Melikaami, <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />Are ifixxe Hodeeshinaa'n Yobabi'i, Dibiyane, Mesha, Malikamene,<verse eid="1CH 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 8:10" />Yi'utsi, Shakiyanenna, Miremane i'le:</para>
  <para style="q1" vid="1CH 8:10">Kunniir mini hadike akeekisanjuwwixxe oosuwwan.<verse eid="1CH 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 8:11" />Huushimi hiyyendaaxxe arenaa'n Ahitubinna Elifi'aal hiyyendaaxxa labbaxxa oose afeemman.<verse eid="1CH 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 8:12" />Elifi'aalixxi labbaxxi oose</para>
  <para style="q1" vid="1CH 8:12">Ebere, Mishaam, ittanni Oononna Loodite hiyyemaaka qachcha qorqore uurriseeki Shamedi; <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />Beeri'anna Seema'i Ayyaloonike qachcha'n hedhammake mannike mini haduwwike sooreessuwwamman; insa'nenna Gaatike qachcha'ni hedhaammaka manna shorrine. <verse eid="1CH 8:13" /><verse number="14" style="v" sid="1CH 8:14" />Ahiyyo, Shashaaqi, Yiremoti, <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />Zebadiya, Araadi, Eder, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />Mika'eeli, Yishiphana Yoha Beeri'axxi labbaxxi oose,<verse eid="1CH 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 8:17" />Zebadiya, Mesulam, Hiziiqi, Heberi, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />Yishimerayi, Yiziliyanna Yobabi kunniir Elifi'aalixxe labbaxxe oosemman.<verse eid="1CH 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 8:19" />Yaqimi, Zikiri, Zabidi <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />Eli'eenayi, Tsilitaayi, Eli'eel, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />Adaya, Berranaaya, Shimirati, kunniir Seme'ixxi labbaxxe oosemman.<verse eid="1CH 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 8:22" />Shaashaaqixxi labbaxxi oose Ishiphaan, Eebeer, Eli'eeli, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />Abidoon, Zikir, Hanani, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />Hanaaniya, Elaami, Antotiya, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />Yufideyanna Fanu'el Sooseqinixxe labbaxxe oosemman.<verse eid="1CH 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 8:26" />Shemisheyayi, Shehariya, Gotooliya, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />Ya'i'reshiya, Eeliyanna Zikir, Yirohaama labbaxxe oosemman. <verse eid="1CH 8:27" /><verse number="28" style="v" sid="1CH 8:28" />Kunniir duuchchi sire Iyyerusaalemi hedhammake mini minike hadike akeekisanjuwwanna insa'nexxe sannenaa'ni umo umo kadeeke mannan.<verse eid="1CH 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 8:29" />Geba'oonik anni, Yi'el, Geba'oni'i bootefate ofo'le; are isixxinna Me'akate hinaaxxemman. <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />Isik angafi beltinna Abidoonite hinaaken; iso'n itti aanak Duure, Qiisi, Bi'eeli, Neere, Naadabi. <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />Gedoori, Ahiyyo, Zekeernna <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />Shimi'aki anni Miqilootemman. Kunniirinna ifixxe aante welti</para>
  <para style="q1" vid="1CH 8:32">Iyyerusaalemike qachchi qarqara'n he'naamman.<verse eid="1CH 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 8:33" />Neeri Qiisii i'le, Qiisi Saa'oolii i'le, Saa'oolinna Yoonataani'i,</para>
  <para style="q1" vid="1CH 8:33">Melikishu'a, Aminadaabi, Dabine, Ashiba'alini'i i'le.<verse eid="1CH 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 8:34" />Yoonataanik labbak belti</para>
  <para style="q1" vid="1CH 8:34">Meeriibe'aali<note caller="+" style="f"><char style="fr" closed="false">8:34 </char><char style="fqa" closed="false">Meribe'al </char><char style="ft" closed="false">2 Sam. 4:4 Mefeboshet hiyyeme'een. </char></note> isinna Mikaane'e i'le.<verse eid="1CH 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 8:35" />Mikaanexxi labbaxxi oose</para>
  <para style="q1" vid="1CH 8:35">Phitoni'i, Meleki, Taare'a, Ahaazi.<verse eid="1CH 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 8:36" />Ahaazi Yiho'adaani'i i'le: Yiho'adaminna Alemetine,</para>
  <para style="q1" vid="1CH 8:36">Azimotine, Zimmirenne i'le; Zimmirenminna Motsaani'i i'le.<verse eid="1CH 8:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="1CH 8:37" />Motsaa Biine'aani i'le, Biine'ane Refaya'a i'le, Refaya Eli'aasa'a i'le, Eli'aasanna Atseelii'i i'le.<verse eid="1CH 8:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="1CH 8:38" />Atseeli jaane labbaxxa oose afeemman; summi insa'nekinna</para>
  <para style="q1" vid="1CH 8:38">Azireqaami, Bokkeeru, Isima'eli, She'areya, Abidiyunna Hananiten; tinni duuchcha Eselixxe oosemman.<verse eid="1CH 8:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="1CH 8:39" />Isike dayyo Esheeqixxi labbaxxi oose;</para>
  <para style="q1" vid="1CH 8:39">Angafi belti Ulaami, langaba Ya'ushi, sakkaba Elifeelexi.<verse eid="1CH 8:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="1CH 8:40" />Ulaamixxi oose gabeti darbite'na butta ibbabaxxe jabaxxe loliinxe aatomman; insa'neki laakkossinna 150 labbaxxa oosenna hegerixxe oosexxa oose anfeemman; tinni duuchcha Biiniyamixxe hegerixxe hortemman.<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />Isira'eelixxe ilaxxi aante duuchcha laako'endeexxi summi Isira'eelike moyanjuwwiinke mazigaba'n borreessemeen.</para>
  <para style="s1" vid="1CH 9:1">Iyyerusaalemike Qachchika Arda</para>
  <para style="p" vid="1CH 9:1">Yihudik ardi hujeexxe balleesanaa'ni kexxeexxa booji'emeexxi Baabilooni'a a'leme. <verse eid="1CH 9:1" /><verse number="2" style="v" sid="1CH 9:2" />Sirete'n ifi ifinge qadadiba'anna qachchiba'a higeexxi ofo'le'ek heenook Isira'eelik manni, qeesole, Leewwitonna galmi giddo hunnatixxa huje hujammak erganjuwwamman.<verse eid="1CH 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 9:3" />Iyyerusaalemi hedhammak Yihudak, Biiniyamik, Efireemikinna</para>
  <para style="q2" vid="1CH 9:3">Minaaseke mannixxi horte konneechchinn butti'a hexxeexxen.<note caller="-" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="NEH 7:73">Neh. 7:73</ref>. </char></note><verse eid="1CH 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="1CH 9:4" />Yihudake beltonaa'n, Faareesixxe sannuwwana'ni, Baanik belti,</para>
  <para style="q1" vid="1CH 9:4">Imeerik belti, Omerik belti, Amihudik belti Utaayi.<verse eid="1CH 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="1CH 9:5" />Seelonawitotenaa'n</para>
  <para style="q2" vid="1CH 9:5">angafi belti Asayanna isixxi laabbaxxe oose.<verse eid="1CH 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="1CH 9:6" />Zaarahitotenaa'n</para>
  <para style="q2" vid="1CH 9:6">Yi'u'eeli, isike mannik laakkossinna jaane dhibbanna sallane</para>
  <para style="q2" vid="1CH 9:6">tommemman. Yihudike minike mannik laakkossinna jaane</para>
  <para style="q2" vid="1CH 9:6">dhibbanna sallane tommemman.<verse eid="1CH 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="1CH 9:7" />Biiniyamitotenaa'n</para>
  <para style="q2" vid="1CH 9:7">Hasenu'ak belti, Hodaawiyak belti, Mesulamik belti Suul. <verse eid="1CH 9:7" /><verse number="8" style="v" sid="1CH 9:8" />Yirohamik belti Yubineya, Miikiyak belti, Oozik belti Ela; Yibineyak belti Ragu'eelik belti Safaxiyak belti Meesa'ulam. <verse eid="1CH 9:8" /><verse number="9" style="v" sid="1CH 9:9" />Ilatixxe aanteke mazigaba'n borreessememmashshann Biiniyamik mannike hortek laakkossi sallane dhibbanna onde tommenna jaanekemman; kunn labballi duuchchi mini minike akeekisajnuwwamman.<verse eid="1CH 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 9:10" />Qeesoletinna</para>
  <para style="q2" vid="1CH 9:10">Yida'iya, Yiho'yaraabi, Yaakin, <verse eid="1CH 9:10" /><verse number="11" style="v" sid="1CH 9:11" />Mageniinke minik soorreessa kadeek Ahixuubik belti,</para>
  <para style="q2" vid="1CH 9:11">Merayutik belti, Saadoqik belti, Meesulamik belti, Hilqiyasik belti Azatreyasi.<verse eid="1CH 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 9:12" />Melikiyaak belti, Phasikorik belti Yirohamik belti Adaaya, Imeerik belti, Mishilamitik belti, Mesulamik belti, Yehizeramik belti, Adi'elik belti Me'isaayi.<verse eid="1CH 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 9:13" />Mini hadike soorreessuwwa kadeexxe qeesolek laakkossi mitte kumanna torbaane dhibbanna jaane tommemman: kunniirina Mageniinke mine'n kadda'neexxe ergatensha'a ege'na lumoxxa afeeke mannamman.<verse eid="1CH 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 9:14" />Leewwitotixxe gamonaa'n Meeraarixxe sannuwwanaa'n Hashebiyak belti, Azireqamik belti, Hashuubik belti Shemaya, <verse eid="1CH 9:14" /><verse number="15" style="v" sid="1CH 9:15" />Beqibeqaare, Hereeshi, Galalinna Asaafik belti, Zikiirik belti, Miikaki belti Mettaaneya. <verse eid="1CH 9:15" /><verse number="16" style="v" sid="1CH 9:16" />Edotaamik belti, Galalik belti, Semusik belti Abidiya. Ittann Nexoofake qachchi giddo hedhemmak Hilqaanak belti, Aasak belti Beerekiya.<verse eid="1CH 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 9:17" />Hula galminxa heqqammakir:</para>
  <para style="q2" vid="1CH 9:17">Seelom, Aqubi, Xalmoon, Ahimaaninna dayyuwwi insa'nekiir: sooreessi insa'nekinna Seelomiteman. <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />Isinna dhidhimi darre'n moyanjinxe hulaba telchiqico'n uggine uggineeba hedheen. Kunnirinna Leewwitotixxa hula heqqamakemmaaran. <verse eid="1CH 9:18" /><verse number="19" style="v" sid="1CH 9:19" />Ebiyasaafike beltik belti, Qorek belti Seelomenna insa'nek mini hadi'a hado kadeek Qorewito seemmat giissineek Duuchchi Woddike Goottike fooqixxe hulaba'n heqqinammashsha konne galminba e'inamabanna ittan heqqinaamman.<verse eid="1CH 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 9:20" />Edi wodda hula haqqamake mannik sooreess Ali'aazaarik belto Finihaasitemman; Duuchchi Woddik Goottinna isinni welti hedhemman. <verse eid="1CH 9:20" /><verse number="21" style="v" sid="1CH 9:21" />Afenshatike duunkaanixxa giddixxe kutabaa e'yatixxa hula heqqammak kinni Musilamike belto Zekkariyasitemman.<verse eid="1CH 9:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 9:22" />E'yina'neexxa huluwwa heqqinaashsha filemeeki manni lame dhibbanna tommenna lameken. Insa'nexxi ilaxxe aanteshanni he'na'neeke olla'uwwa'n laakko'emme borreessemme; hula heqqaamakir okkone booncho'ni uggine'ek Daawwitinna oojanjo Saamu'eelitemman. <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />Afenshatike duunkaana tinninna Duuchchi Woddike Gootika mine heqqaammari insa'netenna sannuwwa insa'nexxeramman. <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />Hula heqqammakiirinna dhidhimi darre'n, boroti darre'n, middi'ninna bita'i darre'n hedheeke shoolin darre'n he'nemman. <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />Dayyuwwi insa'nekinna ifi ifike loola'in he'ne yanna yanna'inn fulla'ni torbaane torbane barra heqqina'nee insa'nee gargarraamman. <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />Shoole hula heqqitammaxxi Leewwito sooressuwwa kinn Mageniinke mini giddo hexxeexxa kutanna miya masse'naake mini'a sooreessa kande heqqinaamman. <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />Heqqatixxa huje muuxa'neek insa'nete kandeemaxxee okkone Magenike minixxi soro'ni gallaamman: gorsa gorsa dalla'inka cufana insa'nende bannaamman. <verse eid="1CH 9:27" /><verse number="28" style="v" sid="1CH 9:28" />Insaa'ne giddi'ni mitti mitti gamiinke mini giddo la'onfataa'na hujete'n hosaaka miyuwwa maganne a'line heqqinaamman; miyi fula woddanna higaa wodda duuchcha laakkonna'nemman; <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />Wele Leewwawito kinni miyuwakanna galmiink minik woyyichcha miya, bulletanna woyinetika bulbulo, ejersiinxa zayite, hixaana foole eloka affeexxa shuutta shufuroora heqqinaashsha uggemeemman. <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />Qeesoleti giddii'n mitte mitte shittotixxa shuuta shufuroora weli laanqe qophphesinaamman. <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />Qorexxe gosak Seelomik angafi belti Leewwichchi Matiteya qurbaanixxa kebbo kossaashsha iso'ni deettesine kulleemman. <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />Sanbata sanbata'ninn shiqqaxxe tenne ita'a maganne uuneek Qe'atawwichchiinxe dayyuwwi giddi'n duuchchakeetemmabaan.<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />Leewwitotike mini hadike sooreessuwwa kadeemmaxxi faarsaleyye kinn galmiinxe kuta giddo he'naashshanna wele huje duuchchana'ni qullo fullaashsha assendeemman; buutotinna hashshanna barra insa'ne hunja'neexxi huje hexxemman.<verse eid="1CH 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34" />Kunnir duuchchi Leewwitotixxe mini hadike aakeekisanjuwwa kanda woddaa, ila insa'nexxixxe aanteshann borreessemme: he'na'neekinna Iyyerusaalemitemman.<verse eid="1CH 9:34" /></para>
  <para style="s1">Sa'oolixxa Ilaxxa Aante</para>
  <para style="r">(<ref loc="1CH 8:29-38">1 Odo. 8:29-38</ref>)</para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 9:35" />Geba'oonik anni Yi'i'eeli, hedha'neb Geba'onitemman:</para>
  <para style="q2" vid="1CH 9:35">Aretik summinna Mee'akaten. <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />Angafi belti Abidonit kada wodda, iso'ni hana ilemeekir Duur, Qiisi, Ba'aali, Neer, Naadabi <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />Gedoori, Ahiyyo, Zakaaryaasi, Miqilotiteraman. <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />Miqiloti Same'oni'i i'le, isinna fir isikinni welti Iyyerusaalemike qarqara'n he'na'nemman.<verse eid="1CH 9:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="1CH 9:39" />Neer Qiseni i'le: Qiisi Sa'ooli'i i'le, Sa'ol Yoonataani'i, Melikishu'a, Aminadaabii'i, Eshabaal i'le. <verse eid="1CH 9:39" /><verse number="40" style="v" sid="1CH 9:40" />Yoonataanixxi labbaxxi oose Merba'aliten; Merba'al Miikane'e i'le. <verse eid="1CH 9:40" /><verse number="41" style="v" sid="1CH 9:41" />Miikaxxi labbaxxi oose</para>
  <para style="q2" vid="1CH 9:41">Pitone, Meleki, Tare'a, Akaazi. <verse eid="1CH 9:41" /><verse number="42" style="v" sid="1CH 9:42" />Ahaazi Ya'iraami i'le, Ye'iraami Naaremetine, Azimootinenna Zimmirebe i'le; Zimmirenne Motsaane i'le. <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />Motsaane Biine'aani i'le beltikinna Refiyatemman: belti isik Eli'aasanna, Atseelii'i i'le. <verse eid="1CH 9:43" /><verse number="44" style="v" sid="1CH 9:44" />Atseeli jaane labbaxxa oose i'leemman;</para>
  <para style="q2" vid="1CH 9:44">summi insa'nekinna Azireqam, Bokkeeru, Isima'eli, She'areya, Abidiyu, Hananni, kunnir Aseelixxe labbaxxe oosen.<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s1">Moyanjo Sa'oolixxa rewo</para>
  <para style="r">(<ref loc="1SA 31:1-13">1 Sam. 31:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />Konneechchi uduma Filisixeemik manni Isira'el'i lola sanfe; Isira'eeliki ardinna edi'ni ke'e baaje; insa'ne giddi'ni heddi Gilibo'axxe kooba'n reye. <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />Filisixeemik manninna Sa'ooliinna oose isixxa shorrine; Sa'oolixxa oose Yoonataani'i, Aminadaabinna Melikishu'a shinne; <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />Sa'ool lolakee duuloke'e fuleba bagedi eebbe; gabeti lolammak manninna iso'o gane madeesse.<verse eid="1CH 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4" />Sa'oolinna lola ajajammaka, «Kunni shoggoruwwi ane'e geebe geeraraabaashsha wolanticho aaxe ane'e shiyi» hiyye.</para>
  <para style="p" vid="1CH 10:4">Lola ajajamaki kinn yo'osha sodaatemmaxxee assebaan; tennexxee Sa'ooli ifinge wolaantichchi hana ibe reye. <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />Lola ajajamakinna Sa'oolixxa reyo uudexxi; isinna wolaantichchi hana ibe reye. <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />Tennexxee Sa'oolinna sasiinxi labbaxxi oose isixxi rerte: mini hadi isik duuchchi reye mude.<verse eid="1CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7" />Wolo'o giddo hedhemmak Isira'eelik manni duuchchi sannachchi baajexxa, Sa'oolinna oose isixxi rerteexxa calla uundexxi qachcha waalle baqante; Filisixeemik manninna dageexxi qachchuwwa abixxe.<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />Soodimaroke'n Filisixeemik manni rensha dulo'a daga wodda Sa'oolinna oose isixxi Gilibo'axxe kooba'n inbe'naa anfe. <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />Sa'ooli dulle, umokanna kunte, loliinka miya aa'neechchi uduma, mageniwwa insa'nekeena ardake'e tenne odo kullaashsha Filisixeemike boga duuchcha'n erganjuwwa insa'neka erga'ni. <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />Okko'ni Sa'oolinaa'ni adhdhineeka loliinka miya fakkuwwa mageneefantammake insa'neke magenuwwike mini giddo uggine; umokanna Daagoni hinaake magenuwike galmi giddo fanninse.<verse eid="1CH 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11" />Yaabeeshi Gele'adi giddo hedhammak ardi duuchchi Filisixeemito Sa'ooli'ni fuggo asseexxa uundexxe yanna'ni, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />Jajjabi manni mareexxi Sa'oolikanna oose isixxika rensha Iyyabusi'a aa'ne dangeexxi Yaabuushi'i hedheeke lumoke qilxi hunda rensha insa'neka moonge. Okkoona torbaane barra agabo goddo honse.<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />Sa'ooli ekedha haaseessammaka manna qodhdhati Duuchchi Woddik Gootta ajajema gopheemmaxxe'e Duuchchi Woddike Gootti Sa'ool'i reyaashsha asse. <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />Isi Duuchchi Woddika Goottanna qo'la gopheemmaxxee, Duuchchi Woddik Gootti iso'o shiye. Moottumattanna Isseyike belto Daawwiti'a sa'isse uwwe.<note caller="-" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="LEV 19:31">Lew. 19:31</ref>; <ref loc="LEV 20:6">20:6</ref>; <ref loc="1SA 13:8-14">1 Sam. 13:8-14</ref>; <ref loc="1SA 15:1-24">15:1-24</ref>; <ref loc="1SA 28:7-8">28:7-8</ref>. </char></note><verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s1">Daawwiti Isira'elinna Yihuda'a Mowe</para>
  <para style="r">(<ref loc="2SA 5:1-10">2 Sam. 5:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />Isira'eelito duuchcha Kebirooni'i hedheeke Daawwitiba daggeexxi iso'o hite qici, «No'o atinni mitte maalanna mitte munden. <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />Edi baro'n Sa'ooli moyanjo kadeemma wodda; Isira'eel'i bagedinba akeekattak atendemman. Duuchchi Woddik Gootti atik Mageni, ‹Ate'e anke Isira'elik ardik moyanjo kadde'e allalisanjokenna akeekisanjoke› kaddaton hiyye'emman» hiyye.<verse eid="1CH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3" />Isira'eelixxi geedhe duuchcha moyanjo Kebiroonibaa dagge; Daawwitinna Kebirooni'i Duuchchi Woddike Gootti edo insa'nenni welti kako aage. Duuchchi Woddik Goottinna Saamu'eeli darre'n haaso'emashanni insa'nenna Duuchchi Woddike Goottgik hiyyichchishsha Isira'eeli'ni moyanjo kadaashsha Daawwiti'i hariirree.<verse eid="1CH 11:3" /></para>
  <para style="s1">Daawwiti Iyyerusaalemi'i Lole Injifateexxa</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />Moyanji Daawwitinna Isira'eelk ardi duuchchi Iyyaabusite hinaaxxa Iyyerusaalemi lolle. Okkonna hexxa'nexxi Yaabushito,<note caller="-" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="JOS 15:63">Iya. 15:63</ref>; <ref loc="JDG 1:21">Hay. 1:21</ref>. </char></note> <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />Iyyaabusito Daawwiti'i, «Ittanna konnoo'o e'yitabexxon» hine. Daawwit kinn Tsiyoonixxa kollo abixxe. Ookkoneechchi uduma iiti bakka Daawwitik qachcha hiyyende.<verse eid="1CH 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6" />Daawwitinna, «Iyyaabusito edisse lolaak manji sannachchiinke ajajallo kadaan» hiyye. Tennexxee Tsiruyak belti Iyyo'aabi edise dage. Isinna sannachuwwinke ajajallo kade.<verse eid="1CH 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7" />Ookko'n Daawwiti ifika galduma kolloti giddo giissedhe. Iiti bakkanna «Daawwitike Qachcha» hiyyeme. <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />Daawwitinna Miloo'ni safeexxi gaangeesse qachchake'e dalla'a ijaare. Iyyo'aabinna gateemmabaa'n ke'isse qachcha ijaare. <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />Dada Duuchcha Ajajake Duuchchi Woddik Gootti isinni welti hedhemmaxxee Daawwiti barra barra'ninni itti jabaata'ni me'e.<verse eid="1CH 11:9" /></para>
  <para style="s1">Daawwitika Jajjaba Manna</para>
  <para style="r">(<ref loc="2SA 23:8-39">2 Sam. 23:8-39</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />Daawwitik jabak mannik akeekisanjuwwi konneechchinn butti'a hedheeran. Insa'nenna Duuchchi Woddik Gootti insa'ne'n haaso'e addachchiisemmashsha isixxi mootumma butta duuchcha'ni ba'lattaashsha wele Isira'eelike manninn welti kande mootumma isixxe'e jabaka gargaarsa assine. <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />Daawwitik jajjabbi mannik summinna konneechchin butti'a hedheekeeran.</para>
  <para style="p" vid="1CH 11:11">Hakoomichchi Yashobi'ami bagediink jalqabuwwike akeekisanjomman; isinna bagedo ke'isseexxi sase dhibba manjo okkonni shiye.<verse eid="1CH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12" />Iso'ni itti aaneki sase jajjabuwwi giddi'n mitti Ahoohike gosak mini hadik Doodike belto Ali'aazaariten. <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />Isinna Filisixeemik manni lolake'e bukki hiyyemma wodda Fesedemi'i Daawwitinn welti mitteba hedhemman. Ookko'n Isira'eelito so'i wo'meeke fichchi giddi'n Filisixeemik loliink manni edii'n baaje. <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />Kaddomalee fichchinxe oddo'n booncho abixxinemmaxxee Filisixeemika manna shinne. Duuchchi Woddik Gootinna middite insa'ne'a uwwe.<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />Filisixeemik loliinke manni giddii'n mitte kuta Raafayimixxe dhooqa'n bukki hite'naa, sase tomme akeekisanjuwwa giddi'n sasi Daawwiti'i afatee Adolamike gongomi bira hedheeke kinjiba adadde mare. <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />Ookkone wodda Daawwiti ettene kolloba hedhemman. Filisixeemik sannachixxi mitte kuta Beetelihemi hexxemman. <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />Daawwitinna wode'e halseexxi, «Beetelihemike dalla'ixxe hula bira hexxeexxe balenaa'ni ha'wannoka wode'e ayyete ani'a uwwaa!» hiyye. <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />Iite wodda sasiingi gooti loliink manni Filsixeemike mannika sannachcha enqe sa'eexxi Beetelihemixxe hula bira hexxeexxe balenaa'n wode'e ikkile Daawwiti'a iyyedang. Isi kinni ha'wa gibeexxi Duuchchi Woddike Gootti edo dune. <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />Okko'ninna, «Tenne assatenaa'n Mageni ane'e gargaro; tenne hedho insa'nexxe'n mudhine me'ineexxa konne mannixxa munde ha'watishatebaa?» hiyye. Tenne idagate'e hedho insa'nexxe'ni mudhine'emmaxxe'e, Daawwiti ha'wa gibe.</para>
  <para style="p" vid="1CH 11:19">Tenne'e asseeki sase hunnaameessa mannan.<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />Iyyo'aabik dayyi Abisa sasingike akeekisanjomman. Isinna lola ke'isseexxi sase dhibba manna shiye; tennenaa'n kexxeexxa sasingiishshanna gurra fule. <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />Sasi giddi'n<note caller="+" style="f"><char style="fr" closed="false">11:21 </char><char style="ft" closed="false">Sas giddi'n yookaan sase tommi giddii'n. </char></note> umo kadanna gophoole midde, lame anga lumoka ulfinna alfe; insa'neke ajajallo kade.<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />Qebisi'eli'ni dageekinna lumoxxa huje huje'ek Yodahek belti Bennayaasi jabake loliinke manjomman. Isinna lame gurra fuleeka Mo'aabika manna shiye. Mitte yanna kaade bogake'n ibbeexxa barra baletiba mareexxi neenqa shiye. <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />Higgenni ejjuma onde ciqile, kadaaka Gibtsaawichcho mitte shiye; Gibtsawichchi suqeeka fuutta miriqqinammalchishsha hedheecho abixoolena Benayaasi kinn qoonne abixxe iso'o adhe; Gibtsaawichiinxe anganaa'ni bagedo mucuqe aadhe isinge bagedinninni shiye. <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />Tinni Yodahek belti Bennayaasi leellisheexxi jannumma: Isinna ookkone sase<note caller="+" style="f"><char style="fr" closed="false">11:24 </char><char style="ft" closed="false">Ookkone sasi giddii'n yookaan ookkone sase tommi giddii'n.</char></note> worbi mannishanni gurra fule.<verse eid="1CH 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 11:25" />Sase tomme manni irra isi jabaka ulfinna alfe: kaddomalee sasi giddi'n mitti hedhemmabaan; Daawwitinna iso'o ulfeesinammake minike ajajallo asse.<verse eid="1CH 11:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 11:26" />Hunnameeyyetinna konneechchin butti'a hedheeran;</para>
  <para style="q2" vid="1CH 11:26">Iyyo'aabik dayyi Asaheel,</para>
  <para style="q2" vid="1CH 11:26">Beetelihemi ilemeemmake Doodik belti Elihanani,<verse eid="1CH 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 11:27" />Haroora ileme'ek Saamiti, Felonaaxxi ileme'ek Selesi,<verse eid="1CH 11:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 11:28" />Teequhe ileme'ek Isikaki belti,</para>
  <para style="q2" vid="1CH 11:28">Iraasi, Anaatooti ilemeek Abi'eezeri,<verse eid="1CH 11:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 11:29" />Huusha ilemeek Seebekayi,</para>
  <para style="q2" vid="1CH 11:29">Ahooha ilemeek Elayi,<verse eid="1CH 11:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 11:30" />Nexoofa ilemeek Maharay,</para>
  <para style="q2" vid="1CH 11:30">Nexofa ileme'ek Ba'innak belti Heleedi,<verse eid="1CH 11:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 11:31" />Biiniyamike firanaa'ni Gibi'ake bogik manji</para>
  <para style="q2" vid="1CH 11:31">Riibayik belti Itayi, Pire'atona ileme'ek Bennayaasi,<verse eid="1CH 11:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 11:32" />Ga'ashi hexxeexxe dhooqa bira ilemeek Hurayi,</para>
  <para style="q2" vid="1CH 11:32">Areba ilemeek Abi'eel,<verse eid="1CH 11:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 11:33" />Baahuriima ilemeek Azimoot,</para>
  <para style="q2" vid="1CH 11:33">Se'aliboo ileme'ek Eliyaahiba,<verse eid="1CH 11:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 11:34" />Giizoni ilemeeke Hasheemixxa oose</para>
  <para style="q2" vid="1CH 11:34">Haraar ileme'eke Shaageka belto Yoonataani'i,<verse eid="1CH 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 11:35" />Haraar ilemeeke Saakoorika belto Ahi'aami,</para>
  <para style="q2" vid="1CH 11:35">Uurik belti Elifaal<verse eid="1CH 11:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 11:36" />Mikerata ileme'ek Heferi,</para>
  <para style="q2" vid="1CH 11:36">Filona ileme'ek Akiya<verse eid="1CH 11:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="1CH 11:37" />Qermelosi ilemeek Hatsiiro,</para>
  <para style="q2" vid="1CH 11:37">Eezibayik belti Ne'irayi<verse eid="1CH 11:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="1CH 11:38" />Naatanek dayyi Iyyu'eeli</para>
  <para style="q2" vid="1CH 11:38">Hagiirk belti Mibihar,<verse eid="1CH 11:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="1CH 11:39" />Amooni ilemeek Tseleqi,</para>
  <para style="q2" vid="1CH 11:39">Tsiriyak belti Iyyo'aabik loli boonchik ajajalli</para>
  <para style="q2" vid="1CH 11:39">Bi'eero ilemeek Neharayi,<verse eid="1CH 11:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="1CH 11:40" />Yitira ilemeek Iirasi,</para>
  <para style="q2" vid="1CH 11:40">Yitira ilemeek Geerebi,<verse eid="1CH 11:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="1CH 11:41" />Keexxichcho Ooriyo,</para>
  <para style="q2" vid="1CH 11:41">Ahilayik Heetti Zabadi<verse eid="1CH 11:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="1CH 11:42" />Roobeeli'a ilemeek Yeshizak belti Adiina,</para>
  <para style="q2" vid="1CH 11:42">isinna Roobeelitoteenna welti hedhemmakeeri'a</para>
  <para style="q2" vid="1CH 11:42">sase tomme manike akeekisanjomman.<verse eid="1CH 11:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="1CH 11:43" />Ma'ikak belti Hanani,</para>
  <para style="q2" vid="1CH 11:43">Mitina ilemeek Iyyosaafixi<verse eid="1CH 11:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="1CH 11:44" />Asitaaro ileme'ek Oozeya, Aro'eraxxe dhooqa'ni ilemeeke Hotaamixxi oose Shaamanna Yi'i'eeli<verse eid="1CH 11:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="1CH 11:45" />Shimeriki belti Yidi'eeli</para>
  <para style="q2" vid="1CH 11:45">dayyi isikinna Teeda ilemeek Yoha,<verse eid="1CH 11:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="1CH 11:46" />Mahawwa ilemeek Eli'eeli,</para>
  <para style="q2" vid="1CH 11:46">Elina'amixxi oose Yirebayinna Yooshawiya,</para>
  <para style="q2" vid="1CH 11:46">Mo'aaba ilemeek Yitima<verse eid="1CH 11:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="1CH 11:47" />Eeli'eli, Oobedinanna Mitsoba ilemeek Ya'isi'elitemmaaran.<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s1">Daawwitinn Welti Makemeeka Loliinka Manna</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />Daawwiti Qiisike belto Saa'oli edii'n baqateexxi Tsiqilagi hedhe'naa isiba'a dageek manni konnechinn iimi'a hedheramman; insa'nenna lolake'n gargarike mannixxe oddo'ni he'nemman. <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />Mannikinna gabeti lolaakeera kada wodda, middixxenna bita'ixxe anganni fuggo hujatinna kinjo darbatixxa dande'a afeekeeramman; insa'nenna Biiniyaamike mini hadi darre'n Sa'ool shiqike firamman.<verse eid="1CH 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 12:3" />Akeekisanji insa'neke Ahi'eezertemmani itti aane Iyyo'aasi hedhemman; lamiing Gibtsi'awicho Shema'ixxe oosemman; Azimootixxi oose Yizi'eelina, Faalixxi, Beerakiya, Anaatooti ilemeek Iyyu, <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />Gibi'a ilemeeki Ishema'aa sase tomme manni giddi'n hunnameessakenna sase tommingike sooreessamman; Eermiyaasi, Yahazi'eeli, Yohanani, Gedirichchi Yozabaadi, <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />Eluuzayi, Yaarmuti, Be'aaliya, Semarya, Harufiichi Sefaxiya, <verse eid="1CH 12:5" /><verse number="6" style="v" sid="1CH 12:6" />Qore'a ilemeek Hilqaana, Yushiya, Azer'el, Yuzaare, Yashobi'am, <verse eid="1CH 12:6" /><verse number="7" style="v" sid="1CH 12:7" />Gedoori ilemeekeranaa'n kinn Yohaananixxi oose Yu'elinna Zebadiya.<verse eid="1CH 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />Daawwit qiilla gammoojje hedheeke kollifachcho giddo hedhee'naa; Gaadixxe gosake mini hadik manni dageexxi isike sannachchinn welti makeme; insa'nenna lolake'e qophphefanteexxa wontenna bagedo abixxa dandenaak jabake loliinke mannamman; albi insa'nekinna neenqiishsha sodachchisa'neekenna koobuwate'n hana utaldamaxxe geedujoshsha yo'osha muddamakeeramman.<verse eid="1CH 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 12:9" />Konneechchinn iimi'a hedheeki akeekisanj Etseretemman;</para>
  <para style="q2" vid="1CH 12:9">langak ajajalli Abidiyu; sakkak Eli'aabi <verse eid="1CH 12:9" /><verse number="10" style="v" sid="1CH 12:10" />Sholgak Mesimena ondik Ermiyaasi, <verse eid="1CH 12:10" /><verse number="11" style="v" sid="1CH 12:11" />Jiyak Atayi, torbak Eli'eeli, <verse eid="1CH 12:11" /><verse number="12" style="v" sid="1CH 12:12" />Saddeetik Yohanani, sallanik Elizabadi, <verse eid="1CH 12:12" /><verse number="13" style="v" sid="1CH 12:13" />Tommeessok Ermiyaasi, tommenna mitteessok Mekibenayi.<verse eid="1CH 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14" />Gaadixxe gosa kadeek duuchchi loliinke ajajalluwamman, insa'ne giddi'n maa'nichchi dhibba manjo, angafi kinn mitte kuma akeekisanuwwa laako'a'nemman. <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />Siretike agenjo'n Yordaanoosik galaan butti'ni iimi qico'ni wo'me'naa, wode'e foonfe dhiidhimi darreke'inna boroti darrexxe dhooqaba hedhammaka duuchchiira okko'ni shorreer konne mannamman.<verse eid="1CH 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />Weli Biiniyaamikenna Yihudake gosa darre'ni kadeek manni Daawwit hedhexxe kolloba'a dange. <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />Daawwitinna konne manna qophecaatee fuleexxi hiyyee qic; «Ha'no daggineek ane'e gargartino'anna nagi'akete kadoole aninni welti bobbatino'a ha'no a'late'e qophphefateennen; yaane kinn ballesa mitte hujebe'nog naapha anke'e ane'e sa'isitine uutina'noole, annuwwi no'okik Mageni iso'o uudeexxi huje isixxishshanni isi'a murowwaal.»<verse eid="1CH 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18" />Okko'ni Magenik Hafuur sase tommike akeekisanjo'ni Amasayi'ni dirreexxi hiyye qic:</para>
  <para style="q1" vid="1CH 12:18">«Koo Daawwit no'o atiken,</para>
  <para style="q2" vid="1CH 12:18">Koo Isseyike belto no'o atinni welti he'nennen;</para>
  <para style="q1" vid="1CH 12:18">Nage'i duuchchi woddik nage'i ati'a kadowwaal;</para>
  <para style="q2" vid="1CH 12:18">ate'e gargaraake duuchchi'a nage'i kadowwaal;</para>
  <para style="q2" vid="1CH 12:18">Atik Mageni ate'e gargaraan» hiyye.</para>
  <para style="p" vid="1CH 12:18">Tennexxee Daawwit insa'nee qophedhe; sannachchiink akeekisano insa'ne'e asse.<verse eid="1CH 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />Daawwit Filisixeemike manninn welti gudde Sa'ool'i lolate'e mare wodda, Minaaseke mini hadi darre'n heenok manni finqile Daawwitike sannachchin welti makemme. Isi kinn insa'ne'a gargaarsa asseebaan; buutotinna Filisixeemik mannik ajajaluwwa, «No'onaa'ni finqile ifike goota Sa'ooliba'a maroole no'o'o biraan» hine soodantemmaxxee afo'o mitte kande mari'antechchi uduma higaasha assine. <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />Daawwiti Tsiqilagi'a mare wodda finqile isinn makeme'ek Minaasek gosak mini hadik manni konneechchinni butti'a hedheen; Adina, Yozabaadi, Yidi'eeli, Mika'eeli, Yozabadi, Elihu, Tsilitaayi, kunnir Minaasexxe galcha hunda gala'ni he'ne woddanni kuma manjo akeekaramman. <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />Insa'ne duuchching jabake loliinke mannanna Daawwitike sannachchi giddo ajajallo kandeemmaxxee naaphuwwi lole dhiiba'n daga wodda iso'o gargaaramman. <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />Sannachchuwwikinna Magenik sannachchuwwishshann kadaa qico'n Daawwiti'i gargaratee barra barra'ninn heddi manni yaa'amman.<verse eid="1CH 12:22" /></para>
  <para style="s1">Welikinna Kebirooni'i Daawwitike Sannachchi Makeme</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23" />Duuchchi Woddik Gootti Daawwiti'a aagemmaxxe kakoshann Sa'oolixxa mootumma hoyyine isi'a uunaashsha Daawwiti hedheeke miniba Kebirooniiba dagemmak mannik laakkossi konneechchinn butti'a hedheen:<verse eid="1CH 12:23" /></para>
  <para style="li">
    <verse number="24" style="v" sid="1CH 12:24" />Wontenna bagedo abixxe'e lolakee qophpheefateeke Yihudaki manni 6,800. <verse eid="1CH 12:24" /><verse number="25" style="v" sid="1CH 12:25" />Lolakee qophpheefateek Siimi'oonixxe gosake mini hadinaa'n 7,100.<verse eid="1CH 12:25" /></para>
  <para style="li">
    <verse number="26" style="v" sid="1CH 12:26" />Leewwike gosake mini hadinaa'n 4,600. <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />Aaroonike mini hadike soorees Yodahene itti lephpheexxi sase kumanna torbaane dhibba manna; <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />Higgeenni lolake'e jabak dargagees Tsaadooqinna mini hado isikenaa'n lame tommenna lame loliinka akeekisanjuwwa.<verse eid="1CH 12:28" /></para>
  <para style="li">
    <verse number="29" style="v" sid="1CH 12:29" />Sa'ooli'a fira kadeek 3,000 Biiniyamik manni; konne giddii'n heddi eettene barra qico'n Sa'oolike mini'a addatenshati he'nemman;<verse eid="1CH 12:29" /></para>
  <para style="li">
    <verse number="30" style="v" sid="1CH 12:30" />Efireemike mannanaa'n gosati gurra fuleek jabak lolink manni 20, 800.<verse eid="1CH 12:30" /></para>
  <para style="li">
    <verse number="31" style="v" sid="1CH 12:31" />Minaaseke gosak mini hadina'n gamisi 18,000 mannan; insa'nenna Daawwiti'i mootonsatee summi summik borreessine'naa dageeke mannamman.<verse eid="1CH 12:31" /></para>
  <para style="li">
    <verse number="32" style="v" sid="1CH 12:32" />Baro qalbefate ege'nekiirinna Isira'eelik ardi maa assiyo hasissaaxxa hubateekir Yisakoorik manni 200 sooreessuwwan; insa'ne hunda hedhe ajajema'neeki insa'nek firuwwi. <verse eid="1CH 12:32" /><verse number="33" style="v" sid="1CH 12:33" />Adhe barate hoone sibilininna kaddo lolakee qophpheefatekinna Daawwiti'i gargaaratee dageekir lame godoba gurabaak 50,000 Zabilonik manni;<verse eid="1CH 12:33" /></para>
  <para style="li">
    <verse number="34" style="v" sid="1CH 12:34" />Nefitaalemike mannanaa'n 1,000 loliinka sooreessuwwa; insa'nenni welti wontena bagedo abixxeeki 37,000 manna;<verse eid="1CH 12:34" /></para>
  <para style="li">
    <verse number="35" style="v" sid="1CH 12:35" />Daanike manni giddii'ni lolake'e qophpheefateek 28,600;<verse eid="1CH 12:35" /></para>
  <para style="li">
    <verse number="36" style="v" sid="1CH 12:36" />Aseerike manni giddii'ni adhe barateerinna lolakee qophpheefateeki loliink manni 40,000;<verse eid="1CH 12:36" /></para>
  <para style="li">
    <verse number="37" style="v" sid="1CH 12:37" />Dhidhimi darrexxe Yordaanoosinaa'n Roobelixxe, Gaadina'ninna Minaaseke gosak mini hadik gamis gargar gargri hedheeka miya ka'leekir 120,000 manna.<verse eid="1CH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38" />Kunniir duuchchi sannachchummat ergatematee eetii uwweeke loliinke mannan; Kebirooni'a dangeekir Daawwitii Isira'eeli duuchcha'n mootonsatee mudhineemmaxxeten. Gateek Isira'eelik mann duuchchi Daawwiti'i mootonsatee mitte afo'o kande. <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />Insa'ne'a hasissaaxxa mini hadi insa'nek qophpheessemmaxxee manni Daawwitinn welti ita'ni ha'wa'ni sase barra duuchcha ture. <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />Ittann bayya hedheeke Yisakoorike, Zabilonikenna Nefitaalemike boganaa'n gatteebaang insa'nek olla'uwwi harrete'n, gaalake'n, gaangete'ninnaa sanga'ake'n ita fee'neexxi insa'ne'a aa'ne dange. Isira'eeli'n lumok gammadi kademmaxxee bulle, muxxunqinseexxa balasenna zebibe, woyinetika bulbulonna ejersiinxa zayite, ittanni heddo lalinna, gedhebo insa'ne'a aane dangaamman.<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s1">Kakotik Taabooti Higeexxa</para>
  <para style="r">(<ref loc="2SA 6:1-11">2 Sam. 6:1-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />Daawwitinna kuma loliinka manna akeekammarinninna dhibba manna akeekammake loliinke sooreessuwwinni welti mari'ate. <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />Ookko'ninna boga Isira'eelike'n ya'a fuleeke arda'n hiyye qic: «Yoona yaane ha'no'ni eloxxe fakkaate leellitoolenna Duuchchi Woddike Gootta no'oke Magenika eloke yaada kadoole, Isira'eelike boga duuchcha'ni hedha'neeke shiqonna kado bayyanna hedheeke no'oke dayyuwwi'a ittanni ifi ifike qachcha'ninna bobba'a'ni hexxa'neexxi Qeesolenna Leewwito daggeexxi no'on welti bukki hitaasha insa'neba'a erga'no. <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />Sa'ooli galchamma baro'ni hansabo'nogi hedhemmaka Duuchchi Woddike Gootta no'oke Magenika kakotika taaboota hiissine ifiba'a idango.» <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />Ardikinna yaada konne gammande adhdhinemmaxxee ya'a fuleeki duuchchinna kaddun assinannon hiyye.<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />Tennexxee Daawwit Mageniinka kakotika taaboota Qiriyatiyi'aarimii'n iyyedagatee Gibtseke galaana Shihori'ni safe Hamaatike gorsumi qico'n qorbeeka Isira'eelika arda duuchcha bukki asse.<note caller="-" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="1SA 7:1-2">1 Sam. 7:1-2</ref>.</char></note> <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />Daawwitinna Isira'eelik ardi duuchchi Kirubeli'n hana ofo'leeka summi isikinna iso'ni ye'emeeka Duuchchi Woddike Gootti Magenika kakotika taabota ookkoo'ni iyyedangaashsha Yihuda hexxeexxe Qiriyatiyi'aarimi hinammake Ba'aalike magenuwibaa me'we.<note caller="-" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="EXO 25:22">Fula. 25:22</ref>. </char></note><verse eid="1CH 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7" />Mageniinka kakotika taaboota Aminadaabike minenaa'n haaroxxe gaare'n hana uggine aa'ne dange; fadhadiinxa gaare oofamakiir Oozanna Ahiyyotemman. <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />Daawwitinna Isira'eelik ardi duuchchi Mageni edo giitarakanna kiraara, masinqotanna suusu'le, okolekanna, wontenna magalata konneechchuwwi yaaddo belo ayyaana faarsina'n gammashot ayyaneefantaamman.<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />Kidooni midha uxxinamaba genne wodda sangoole insa'ne'e takaldemaxxe'e, Ooza kakotika taabota kipho'a anga ke'isse. <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />Ooza kakotika taabota angati kisemaxxe'e Duuchchi Woddik Gootti mufate isinna hirba okkone'n qooma abideme; tennena'n kexxeexxa eetene bakka'n Mageni edo reye.<verse eid="1CH 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11" />Duuchchi Woddike Gootixxi mufe dedhange'n Oozani'i takke hiyyitemaxxee Daawwiti yaade; ookkone booncho telchi qico'n Oozaxxe enqeshsha hine ye'naan.<verse eid="1CH 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12" />Ettene barra Daawwit Mageno sodaatemmaxxee, «Eega Magenika kakotika taaboota hitta aniba'a idaga dande'anno?» hiyye. <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />Tennexxee kakotika taaboota Daawwitike qachchiba'a aadhe dagati mannii'ni Gaati hedheke Abidaarake miniba'a aadhe marre. <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />Mageniink kakotik taabootinna Abidaarake mine'n mini hadinni welti sase agenjo ture; Duuchchi Woddik Goottinna Abidaarraka mini hadonna horateechcho duuchcha eebbise.<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="1CH 26:4-5">1 Odo. 26:4-5</ref>. </char></note><verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s1">Daawitika Minenna Mini Hado</para>
  <para style="r">(<ref loc="2SA 5:11-16">2 Sam. 5:11-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />Ookkone wodda Xiroosik moyanjinna Kiraami Daawwitixxe mootumma'a hunjaashsha erganjuwwa, kinjo bocaaka mannanna ijaraaka manna birbirsiinke haqichchinni welti erge. <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />Daawwitinna Duuchchi Woddik Gootti Isira'eli'ni mootonse jabeessemmaxxanna ifike arda Isira'eelixxe hiyye mootomma ifixxa lummisexxa qalbeefate.<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />Daawwitinna Iyyerusaalemi'ni heddo are aadhe; insa'nenna'n labbaxxanna meyaxxa oose i'le. <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />Okko hedhemaba i'lemmaxxe oosek summi konneechchinni butti'a hedheen; Saamusi, Sobaabi, Naataani, Solomoon, <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />Yibihaar, Elishuu'a, Elifaalat, <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />Nooga, Naafeqi, Yaafi'a, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />Elishaama'i, Be'eeliyadanna Elifeeletiteeran.<verse eid="1CH 14:7" /></para>
  <para style="s1">Daawwiti Filisixeemika Manna Lole Injifate</para>
  <para style="r">(<ref loc="2SA 5:17-25">2 Sam. 5:17-25</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />Daawwiti Isira'eelika boga duuchcha mowashasha hariiremeexxa Filisixeemik manni laqeexxi, hunna jabefante iso'o hasito fulle; Daawwitinna tenne laqemmaxxee insa'nenni weli adhatee fule. <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />Ettene yanna'n Filisixeemik manni dageexxi Raafayimixxa dhooqa bunqe. <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />Tennexxee Daawwit, «Filisixeemike manna'ni haano mare lola ke'issanno? Ati anga anixe'n insa'ne'e sa'isite uutato?» hiyye Mageno laqe.</para>
  <para style="p" vid="1CH 14:10">Duuchchoi Woddiki Goottinna, «Eeti fuli! Aninna anga atixxe'n insa'ne'e sa'isse uwwannon» hiyye hiisse haaso'e. <verse eid="1CH 14:10" /><verse number="11" style="v" sid="1CH 14:11" />Tennexxee Daawwitinna Ba'aalifeeradiimite hine ye'naak booncho'n Filisixeemike manna'ni lola ke'iseexxi inisa'ne kutti asseechchi uduma; «Wode'i tansaase sa'ammashsha Magenikinna naaphuwwa anka anxe anganinni diigiseen» hiyye. Tennenaa'ni kexxeexxa okkone booncho «Olipharasimi» hine summa fulchine. <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />Filisixeemik manni magenuwwa insa'neka ooko'o laffi assinemaxxe'e, Daawwiti giirati gunbaasha ajaje.<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />Filisixeemik manninna higgeen dhooqatanna ale aade'n bunqe; <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />Higgenni Daawwiti Mageno laqe; Magenikinna hiyye hiisee qic, «Ale aade'i insa'ne qoqqobbe odi'inke haqichchi edo saxxe lola ke'issi; male'e ittanna alale qabattoxxe. <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />Odi'inke haqichchixxe xungo'ni yaasumiinka hirba laqqottole ille iima insa'ne'e fulde adhi: tinninna Filisixeemike mannika sannachcha Mageni balleso'a edo sa'en hiyyoten» hiyye. <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />Tennexxee Daawwitinna Mageni hiyyeexxa asse; Geba'oonii'ni ke'isse Geezir qico'ni Filisixeemika manna shorrine.<verse eid="1CH 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17" />Tennenaa'ni kexxeexxa Daawwitik gurri boga duuchcha'ni geye; Duuchchi Woddik Goottiinna mootoleeyye duuchcha Daawwiti'i sodaataashsha asse.<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s1">Kakotika Taaboota Iyyerusaalemi'a Aa'ne Dange</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />Daawwitinna ifike summinni ye'emeeke qachchiba ifi'a mine ijaadhdhe: Mageniinka kakotika taaboota ofo'lishaaka booncho qophphesseexxi duunkaana ote. <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />Ookkoneechchi uduma Daawwit, «Mageniinka kakotika taaboota dunkaashshanna duuchchi woddi'a isi edo ergatemaashsha Duuchchi Woddik Gootti fileeke leewwito malee, weli ayyinna Mageniinka kakotika taaboota dukoqqe'e» hiyye ajaje.<note caller="-" style="x"><char style="xo" closed="false">15:2 </char><char style="xt" closed="false"><ref loc="LEV 10:8">Lew. 10:8</ref>. </char></note><verse eid="1CH 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3" />Daawwiti Duuchchi Woddike Goottika kakotika taaboota qophpheesemmake boonchibaa idangaashsha Isira'eelika arda duuchcha Iyyerusaalemi'i bukki asse. <verse eid="1CH 15:3" /><verse number="4" style="v" sid="1CH 15:4" />Aaroonixxa sannuwwanna leewwito duuchcha mitteba bukki asse:<verse eid="1CH 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="1CH 15:5" />Qe'atixxe sannuwanaa'n,</para>
  <para style="q2" vid="1CH 15:5">akeekisanjo Uuri'eelinna ifixxe sannuwwana'n mitte dhibbanna lame tomme manna;<verse eid="1CH 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="1CH 15:6" />Meeraarixxe sannuwanaa'n,</para>
  <para style="q2" vid="1CH 15:6">akeekisanjo Asanayaninna ifixxe aanteka lame dhibba manna;<verse eid="1CH 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="1CH 15:7" />Gershoonixxe sannuwwanaa'n,</para>
  <para style="q2" vid="1CH 15:7">akeekisanjo Iyyu'eelininna ifixxe aanteka mitte dhibbanna sase tomme manna;<verse eid="1CH 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 15:8" />Elitsafaanixxe sannuwwanaa'ni,</para>
  <para style="q2" vid="1CH 15:8">akeekisanjo Shemaniyena ifixxe aanteka lame dhibba manna;<verse eid="1CH 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 15:9" />Kebiroonixxe sannuwwanaa'n,</para>
  <para style="q2" vid="1CH 15:9">akeekisanjo Eeli'eel ifixxe aanteka saddeeta tomme manni'aa tukkeeseme dage;<verse eid="1CH 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 15:10" />Uurixxe sannuwwanaa'n</para>
  <para style="q2" vid="1CH 15:10">akeekisanjo Aminaddaabineninna ifixxe aanteka mitte dhibbanna tommenna lame manna.<verse eid="1CH 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />Ookkoneechchi uduma Daawwit qeese Saadooqinna Abiyataarii'i iittanni Uuri'eelii'i, Asayanii'i, Iyyu'eelinii'i, Shemayanii'i, Eli'eeliniinna Aminaddaabii'i madadiing mitteba jaane Leewwito dunkaane giddi'a a'yishe. <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />Hiyye qici, «Yoona ha'no leewwitotike mini hadike akeekisanuwwa kaddineemmaxxee, ha'noonna dayyuwwi ha'nooka Leewwito ifi qulloonsa; Okko'ninna Isira'eelike Duuchchi Woddike Gootike Magenika kakotika taaboota qophpheessemeeke boonchiba'a aaxxine dagge. <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />Duuchchi Woddike Gootti no'oke Magenixxi mufe no'o'ni ha'iteek ha'no leewwito edisine idaga gophphinemmaxxeete, No'otenna kandonnole asse hitine ajajinemmashshann maata assinanno hine iso'o qodhdhinebo'non» hiyye. <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />Tennexxee qeesoletinna leewwito Isira'eelike Duuchchi Woddike Gootti Magenika kakotika taaboota idagate'e ifi qullonsine. <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />Muuse Duuchchi Woddike Goottike hiyyichcho'ni ajajemmashshann leewwito Isika kakotika taaboota fanno giise'ne dulke'ne.<note caller="-" style="x"><char style="xo" closed="false">15:15 </char><char style="xt" closed="false"><ref loc="EXO 25:14">Fula. 25:14</ref>. </char></note><verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />Daawwit meellatike miyin, masinqot, kiraarik, suusu'leti qoqqobemme gammadinka sirba sirbitaaxxa faarsaleeyye dayyuwwi insa'neki giddi'ni fi'lina'ni leewwitotike akeekisanjuwwa'n haasone.<verse eid="1CH 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17" />Tennexxee leewwito Iyyu'eelika belto Hemaane fi'len: dayyuwwa insa'neke giddii'ni Berraakiyaka belto Aasafii'i, insa'neke dayyuwwinaa'ni Meeraarixxe sannenaa'ni Qisanika belto Eetani'i fi'line; <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />Insa'nenni welti dayyuwwi insa'nek aante aaniteti fileme; insa'nena Zakariyaasi, Yaa'izi'eeli, Semiramoot, Yihi'eeli, Uniine, Elyaabi, Bennayaasi, Me'iseyaan, Metitiya, Elifeelehu, Miqineya, higgeen hula heqqammar Oobedi'edoominna Yi'i'elitemmara.<verse eid="1CH 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19" />Faarsaleeyye, Hemaani, Asafinna Eetaam bilbila sagetotike siblijika gikki assine laqinsaashsha filemme. <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />Zakkariyasi, Azi'eli, Semaramot, Yihi'eeli, Uuni, Eli'aabi, Me'iseyana, Bennayaasi, kinni Alamotike meelin masinqo ganaamman. <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />Iittanni Metiitiya, Elifeelehu, Miqiniya, Oobedi'edoomi, Yi'i'eeli, Azaziya, Beshiminiti, hinaake meellin kiraara gannaamman. <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />Faarsaaleeyyetik sooreessi leewwitotiinke akeeikisanjo Kenaniyateman: tenne sooreessumanna adhdheek faarotixxa uwwa afeemmaxxeeten.<verse eid="1CH 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23" />Beraakiya, Eliqaanna Tsoodi'eedoominna Yuhiiya kakotike taabootixxe hula heqqinaamman; <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />Qeese Sebeniya, Iyyosaafixi, Natina'el, Amasayi, Zakaaryaasi, Bennayasina Eli'eezer Magenike kakotike taabooti edo malagata ufuufaamman. Oobedi'edoominna Yihiya kinni kakotike taabootixxa hula heqqinaamman.<verse eid="1CH 15:24" /></para>
  <para style="s1">Kakotiki Taabooti Iyerussaalemi'a Adhdhemeexxa</para>
  <para style="r">(<ref loc="1CH 6:12-22">6:12-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />Tennexxee Daawwit Isira'eelixxi geedhenna kuma manna akeekammak ajajalluwwi Duuchchi Woddike Goottika kakotika taaboota Oobedi'edoomike minenaa'n gammadik idango'a me'ine. <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />Mageniinka kakotika taabota dulkexeexxi leewwito Duuchchi Woddiki Gootti insa'nee gargaremmaxxe'e torbaane middonna torbaane korbeeyye tolchine. <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />Kakotika taaboota dukkeexxi leewwito duuchcha, faarsaaleeyyenna faarsaaleeyyetixxi sooreeyye Kenaaniya'n oddo'witemmaxxe bifashsha fuuta suunqe giissineexxa seemma Daawwitinna oddo'weemman; ittanni fuutta suunqe giissineexxa Efuudite hanashonna oddo'weemman. <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />Konne qicinn Isira'eelike boga duuchcha'n hedheek ardi qeexala'n malagatanna suusu'le ufuufa'ni bilbila qillinsa'n masinqotanna kiraara ganna'ni Duuchchi Woddike Goottika kakotika taaboota aa'ne dange.<verse eid="1CH 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29" />Duuchchi Woddike Goottik kakotik taabooti Daawwitike qachchiba'a e'ya wodda Sa'oolixxi belto Melkooli masikobete'n hexxe uudde; moyanji Daawwiti gammadik sirba'naa uuddeexxi qalbeti iso'o tuffatte.<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />Kakotika taaboota adhdhineexxi Daawwiti qophpheseeke duunkaani giddo uggine; okkoneechchi uduma bukki assineeka ciincesinaaka tolchanna mittomiinka tolcha Magenoke shiqinse. <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />Daawwiti ciincatika tolchanna mittominka tolcha tolcheechchi uduma, arda Duuchchi Woddike Goottike summinn eebise. <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />Okko'ni Isira'eel duuchchi'a labbakenna miyyakee mitte mitte gunjo, mitte mitte kebbo, kukkutemeeka maalanna kebbenseexxa zebiibe uwwe.<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />Duuchchi Woddike Goottike kakotike taaboti edo ergatemmaashshanna Isira'eelike Duuchchi Woddike Gootti Mageniba'a soodachcho galatakanna sirba sirbinaashsha leewwito giddi'ni manna file. <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />Akeekisanjikinna Asaafitemman; iso'ni itti aane Zekkariyasi fileme; ookko'ninna Yi'i'eeli, Semiramot, Yihi'eeli, Metitiya, Eli'aabi, Bennayaasi, Oobidi'edoomi, Y'i'el, filemme; insa'nenna masinqotinna, kiraarik faarsinaamman; Asaafi kinn suusu'le ufuufaashsha fileme. <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />Ittanni qeesichchi Bennayanna Yahazi'eeli duuchchin wodda Megenike kakotike taabooti edo malagata ufuunfaashsha filemme.<verse eid="1CH 16:6" /></para>
  <para style="s1">Daawwitixxa Galatiinxa Faaro</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />Ettene barra Daawwiti sirte'n Asaafinaanna hujetike ifike jaaluwwi'a tenne Duuchchi Woddike Goottixxa galatiinxa faaro uwwe.<verse eid="1CH 16:7" /></para>
  <para style="s1">Galatnxa Faaro</para>
  <para style="r">(<ref loc="PSA 105:1-15">Far. 105:1-15</ref>; <ref loc="PSA 96:1-13">96:1-13</ref>; <ref loc="PSA 106:1">106:1</ref>, <ref loc="PSA 106:47-48">47-48</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 16:8" />Duuchchi Woddike Gootti'a galata shiqishshe; summa isikanna ye'we;</para>
  <para style="q2" vid="1CH 16:8">gosa gosake ardi'a assemmaxxa duuchcha kulle;<verse eid="1CH 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9" />Isi'a faarse; sirbakanna isi'a shiqisse</para>
  <para style="q2" vid="1CH 16:9">mambe'a isika duuchchanna haaso'we<verse eid="1CH 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10" />Woyyichcha summa isikena gammadde;</para>
  <para style="q2" vid="1CH 16:10">Duuchchi Woddika Gootta harsaaki duuchchi</para>
  <para style="q2" vid="1CH 16:10">qalbe mittenni ilillisowwaal<verse eid="1CH 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11" />Duuchchi Woddike Goottixxa jabaxxa hunna isixxa uudde</para>
  <para style="q2" vid="1CH 16:11">duuchchin wodda isoo'o hasse;<verse eid="1CH 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12" />Isi hujeexxa manbe'iinxa hujuwwa;</para>
  <para style="q2" vid="1CH 16:12">beessisuwwakanna uwweexxa murte qaabbatte;<verse eid="1CH 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13" />Ha'noo garboleeyye Isira'eelixxe sanne;</para>
  <para style="q2" vid="1CH 16:13">ha'no filendineexxa Ya'iqoobixxe oose.<verse eid="1CH 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14" />Isi Duuchchi Woddike Gootta Mageno no'oken</para>
  <para style="q2" vid="1CH 16:14">murte isixxinna boga duuchcha'niten.<verse eid="1CH 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15" />Kako isixxa duuchchi woddi qico'n</para>
  <para style="q2" vid="1CH 16:15">ajajemaka hiyyichcho ifikanna kuma ilaqico'ni hedaani.<verse eid="1CH 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16" />Abirihaami'a aagemmaxxa kako</para>
  <para style="q2" vid="1CH 16:16">Yisihaaqi'a afo'o sa'emaxxa.<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="GEN 12:7">Dada. 12:7</ref>; <ref loc="GEN 26:3">26:3</ref>. </char></note><verse eid="1CH 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17" />Tenneena Ya'iqoobi'a seera uggeexxi jabeesse;</para>
  <para style="q2" vid="1CH 16:17">Isira'eeli'anna duuchchi woddixxa kako uggeexxi hiyye qic;<verse eid="1CH 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18" />«Dhaaldatek geego atike kadaashsha;</para>
  <para style="q2" vid="1CH 16:18">kananika boga ati'a uwwannon» hiyye.<note caller="-" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="GEN 18:13">Dada. 18:13</ref>. </char></note><verse eid="1CH 16:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19" />Laakkossi insa'nek shiixxedhe'naanni;</para>
  <para style="q2" vid="1CH 16:19">ittann heno'mine keesummumma he'nenan.<verse eid="1CH 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 16:20" />Mitte gosa gosake ardanaa'ni wele gosake ardiba'a;</para>
  <para style="q2" vid="1CH 16:20">mitte mootummanaa'ni wele mootummabaa doonsa kiyya hine.<verse eid="1CH 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21" />Ayinna insa'ne'e miico'a eeti'i uwwebaan;</para>
  <para style="q2" vid="1CH 16:21">insa'nexxe'e moyanjuwwa xixe hiyye qici:<verse eid="1CH 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22" />«Ani hariirenneka tuqqinoqqe'e;</para>
  <para style="q2" vid="1CH 16:22">anxe wabeeko'ni fuggoxxa assitinoqqe'e»<note caller="-" style="x"><char style="xo" closed="false">16:22 </char><char style="xt" closed="false"><ref loc="GEN 20:3-7">Dada. 20:3-7</ref>. </char></note><verse eid="1CH 16:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23" />Butta duuchcha Duuchchi Woddike Gooti'a faarsite;</para>
  <para style="q2" vid="1CH 16:23">wodo isixanna barra barra'ninn odeesitee.<verse eid="1CH 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24" />Ulfinna isika gosa gosake ardi'a haasonne</para>
  <para style="q2" vid="1CH 16:24">hujemmaka mambe'a arda duuchcha'ni kulle.<verse eid="1CH 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25" />Duuchchi Woddik Gootti lumoken</para>
  <para style="q2" vid="1CH 16:25">galati isikinna heddoken;</para>
  <para style="q2" vid="1CH 16:25">magenuwwi duuchchi iima darre sodatemiyyo hasisaaken.<verse eid="1CH 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26" />Ardi duuchchik magenuwwi fakkuwwaten;</para>
  <para style="q2" vid="1CH 16:26">Duuchchi Woddik Gootti kinn iimuwwa dade.<verse eid="1CH 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27" />Isi edo ulfininna gaachchanni,</para>
  <para style="q2" vid="1CH 16:27">jabeeninna gammadi isi galammaba hedheen.<verse eid="1CH 16:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28" />Gosa gosake arda Duuchchi Woddike Gootti'a uwwe;</para>
  <para style="q2" vid="1CH 16:28">ulfinanna hunna Duuchchi Woddike Gootti'a idagge.<verse eid="1CH 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29" />Isike summi'a hasisaka ulfinna Duuchchi Woddike Gootti'a uwwe;</para>
  <para style="q2" vid="1CH 16:29">uwwa aaxineexxi isi'a shiqisse;</para>
  <para style="q2" vid="1CH 16:29">gaachchannik wo'meeke Duuchchi Woddike Goottike woyyumma'a kumbu hiyye.<verse eid="1CH 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 16:30" />Bogi duuchchi isi edo shekesheke hiyyowwaal;</para>
  <para style="q2" vid="1CH 16:30">buttatinna jabaqicin kaasendeen; le'mitabaan.<verse eid="1CH 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31" />Iimuwwa gammadowwaal; butta ilillissowwaal</para>
  <para style="q2" vid="1CH 16:31">gosa gosake ardixxe oddo'n, «Duuchchi Woddik Gootti moween!» hinowwaal.<verse eid="1CH 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32" />Abbaayyanna giddo hedheechchi duuchchi shekeshek hiyyowwaal;</para>
  <para style="q2" vid="1CH 16:32">diiduwwikinna giddo hedheechchi duuchchi ilillisowwaal.<verse eid="1CH 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33" />Okkone wodda gongomiinxi haqqe Duuchchi Woddike Gootti edo gammaddaan;</para>
  <para style="q2" vid="1CH 16:33">gammadik faarsinaan</para>
  <para style="q2" vid="1CH 16:33">boga duuchcha'n murte muro'a dagaan.<verse eid="1CH 16:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34" />Duuchchi Woddiki Gootti arjaken galateefatte;</para>
  <para style="q2" vid="1CH 16:34">jaalala isixxi duuchchin woddi'a itti jabaattee hexxaan.<note caller="-" style="x"><char style="xo" closed="false">16:34 </char><char style="xt" closed="false"><ref loc="2CH 5:13">2 Odo. 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Izr. 3:11</ref>; <ref loc="PSA 100:5">Far. 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Erm. 33:11</ref>. </char></note><verse eid="1CH 16:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35" />«Koo anjiralo no'oke Mageno no'o wodi;</para>
  <para style="q2" vid="1CH 16:35">Woyyichcha atike summi'a galata shiqinsannoshsha,</para>
  <para style="q1" vid="1CH 16:35">Atike galatinni ulfaantannoshsha no'o bukki assi</para>
  <para style="q2" vid="1CH 16:35">gosa gosake ardinaa'n no'o anjir» hitine raarre.<verse eid="1CH 16:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36" />Barokenaa'ni barin qico'ni,</para>
  <para style="q2" vid="1CH 16:36">Isira'eelik Duuchchi Woddik Gootti Mageni'a saadino kaddowwaal.</para>
  <para style="m" vid="1CH 16:36">Okko'ni ardi duuchchi «Ameen» iitanni, «Duuchchi Woddik Gootti saademowwaal!» hine.<verse eid="1CH 16:36" /></para>
  <para style="b" />
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />Daawwitinna barra barra'a mitte mittenge'e dhaabendemmashshann duuchchin wodda ergatemmashsha Asafiinna isinni welti hujammakaara okkone Duuchchi Woddike Goottike kakotike taabooti edo insa'ne'e waale. <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />Ittanni Obedi'edominna jaani tomminna saddeetiing hujetik darabuwwi duuchchi welti ergatemmaashsha ookkonni insa'ne'e waale. Edotaamik belti Oobedi'edoominna Hoosa kinjinka dalla'a heqqate'ni ke'ne.<verse eid="1CH 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39" />Daawwiti qeesichcho Saadooqinna hujetika darabuwwa insa'neka qeesole Geba'ooni'i hedheeke seemmat giissineeke Duuchchi Woddike Goottike duunkaani edo insa'nee waale. <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />Waala isixxinna Isira'eeli'a uwwemeeke ajajishshanna Duuchchi Woddik Goottike seeriinke maxaafa'n borreessememmashshann tolchi booncho'ni ciincesatee shiqaak tolchi gorsanna hashsha yanna yanna'ninni shiqinsaashshaten. <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />Iittanni «Isixxi jaalala duuchchi woddi'aten» hina'n shiqinsaashsha Hemaaninna Edotaam iittanni filemeenna summi insa'nek borresemeek welikinna insa'nenni welti hedhemman. <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />Malagatiinkanna suusu'letika ittann galatiinxa faaro faarsinaa'na la'ofata'nek weli miyi'a sooreessuwwi Hemaaninna Edotaamitemman; Edotaamixxi oose hula heqqitaashsha okko'o insa'nee dhaanbeemman.<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />Okko'n ardikinna ke'eexxi mitti mitting ifi ifike miniba'a me'e; Daawwitinna mini hado ifika eebbiso'a ifike miniba'a hige.<note caller="-" style="x"><char style="xo" closed="false">16:43 </char><char style="xt" closed="false"><ref loc="2SA 6:19-20">2 Sam. 6:19-20</ref>.</char></note><verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s1">Naatan Daawwiti'a Haaso'eka Hiyyichcho</para>
  <para style="r">(<ref loc="2SA 7:1-17">2 Sam. 7:1-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />Daawwiti mootummatik mine'n ti'nate ofo'lemma wodda, wabeeka Naataanii'i, «Yoona ani birbirsik ijaarreke mini giddo hedhannon: Duuchchi Woddike Goottik kakotik taabooti kinni duunkaani giddo hedha'neen» hiyye.<verse eid="1CH 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2" />Naataaninna Daawwiti'a, «Mageni atinn welti hedhemmaxxee heddetexxa duuchcha assi» hiyye.<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />Eettene hashsha Magenik hiyyichchi Daawwitiba'a Naataanibaa dageexxi hiyye qic:<verse eid="1CH 17:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4" />«Anke garbichcho Daawwiti'ni marte hitatto qic, ‹Duuchchi Woddik Gootti hiyya'ne qic: Ani hedhanoka mine hujjaattek atetebaan. <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />Isira'eel'i Gibtse'n fulchennexxe barranaa'n telchi qico'n, duunkaaninaa'ni wele duunkaanibaa, mitte galdumiinxe bakkanaa'ni weletibaa me'annoshshate malee'e mini giddo hedhabe'noni. <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />Isira'eelike ardinn welti me'ennoke booncho duuchcha'n, arda anka heqqinaashsha ajajennexxe sooreessuwwa insa'nexxeranaa'n mitte mittenga, «Abbo maye'e birbirsiinke haqichchinn mine ani'a ijaara gophphine hiyyennexxi yannaar hexxe?» ›<verse eid="1CH 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 17:7" />«Yoona ta'atenna kaddole garbichcho anke Daawwiti'a hite kuldatto qic, ‹Dada Duuchcha Ajajak Duuchchi Woddik Gootti hiyya'ne qici; arda anka Isira'eel'i moote galchittota'a gedhebo allaldatakenna hordofatabaa'ni aadhe ke'isennen. <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />Marteteba duuchcha atenaa'n gargar higebe'non; naapha atika duuchcha ati edi'n balleessennen: ta'anna summa atika buttate'n hedheke lumolli mannike summishshanni saandaashsha assannon. <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />Anke arda Isira'eelikee galdumi booncho uwwannon; ifika galdumi boonchonna alfinaashshanna ta'in udumi'a lele'minabaashsha insa'ne'e assannon. Konneechchi edo manni fuggoxxa assemmashsha ta'a yoona insa'ne miincabaan. <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />Konneechchi edo anke arda Isira'eeli sooreessuwwa filenne wodda miicemmashsha telcho assinabaan; naapha insa'neka duuchcha salphisannon.</para>
  <para style="p" vid="1CH 17:10">« ‹Duuchchi Woddik Gootti mine ijaaranexxa ate'n farri asse'e haaso'annon: <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />Bari atik geye'naa edike atike annuwiba'a me'itatto wodda, oose atixxi giddi'n mitte mootonsannon; mootumma isixxanna jabeessannon. <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />Mine ani'a ijaara'nek isoten; aninna mootumma isixxa duuchchi woddi'a jabeessannon. <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />Aninna annake isi'a kadannon; isinna belto anke kadaan; jabaxxa anxa jaalala ati edi darre hedhemmakenaa'ni adhdhenneshsha isonaa'ni ijje aadhdhabe'non.<note caller="-" style="x"><char style="xo" closed="false">17:13 </char><char style="xt" closed="false"><ref loc="2CO 6:18">2 Qor. 6:18</ref>; <ref loc="HEB 1:5">Ibr. 1:5</ref>. </char></note> <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />Mine anke'ninna mootumma anxe'ni duuchchi woddi'a uggannon; mootummatinna duuchchi woddi'a lele'mitebaang hexxaan.› »<verse eid="1CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15" />Naataaninna konne leelleeka hiyyichcho duuchcha Daawwiti'ni haaso'e.<verse eid="1CH 17:15" /></para>
  <para style="s1">Daawwitixxa Soodachcho</para>
  <para style="r">(<ref loc="2SA 7:18-29">2 Sam. 7:18-29</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />Okko'ni moyanji Daawwiti aage, Duuchchi Woddike Gootti edo ofo'leexxi hiyye qic,</para>
  <para style="pm" vid="1CH 17:16">«Ee, Duuchchi Woddike Gootta Mageno; tenne yaane duuchcha ani'a assitota'a geyeneki ani ayyete? Anki mini hadi konne qiconna maacho? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />Koo anke Mageno tinni ati edo woyi fulabaachcho kadeexxa egende garbichcho atikike minixxee dagaake qeerra barixxa higgenni ta'anna ane'e manni duuchchinaa'n hariiremeeke lumoochchishsha ulfateeke manjo assite uudiballo.<verse eid="1CH 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 17:18" />«Garbichcho atika ulfeesitetaxxee, Daawwiti konneechchi iima maa hiyyo'ate? Garbichch atikaqqa atinni egendeetten: <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />Koo Duuchchi Woddike Gootta atike garbichchixxe hitenna fedhii atixxishsha tenne jabaxxa yaane assitetten tenne jabaxxi lumollamma addatenshuwwa duuchcha itti ege'neddaashsha assi.<verse eid="1CH 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 17:20" />«Abbo atishsha hedheek ijje afemabaan; mansha no'oxxin lanqenneshshann Atee male'e weli Mageni hedhebaan. <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />Gibtseke boganaa'n anjire fulchitetteshshann atike arda Isira'eelishsha hedheek ayyete hedhe? Insa'ne Mageni buttate'ni hedheeke ardi duuchchi giddi'n ifi'anni anjire fi'leeke mannani: gosa gosake ardi edo lumollamma sodaachchissaaxxa yaanuwwa asseexxi mootoleeyyuwwo insa'ne edo fiissitetten. <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />Arda atika Isira'eelinna duuchchin woddi'a ifika arda assexeten; koo Duuchchi Woddike Gootta Atinna Mageno insa'neke kaddetten.<verse eid="1CH 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 17:23" />«Duuchchi Woddike Gootta ta'atenna kaddoole garbichcho atikixxenna mine isikixxe'e haasotettaka haaso'a duuchchi woddi'a lele'ma belo itti jabaatowwaal: haasotettaka haaso'anna muuxi: <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />Tinninna atik summi lele'ma belo itti jaabate hedhaashshanna duuchchi woddi'a lumoke kadaashshaten. Ookkoneechchi uduma mannikinna, ‹Dada Duuchcha Ajajaak Duuchchi Woddiki Gootti Isira'eelk Mageni dhugaandinn isi Isira'eelike Magenon!› hinaan; garbichchi atikik Daawwitik mini ati edo lele'ma belo itti jabaateeke kadaan.<verse eid="1CH 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 17:25" />«Koo anke Mageno, garbichcho atike'e mine ijaartatexxa kokeessiteeten; tennexxee garbichchi atibaa soodatate'e hunna alfeen. <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />Koo Duuchchi Woddike Gootta dhugaadinn ati Magenoken assatee konne eloka haaso'a haasotte garbichcho atikee kuldetten. <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />Ati edo duuchchi woddi'a lele'ma belo hedhaashsha atike garbichchika mine eebbissota'a fedhii atixxe kaddowwaal; Koo Duuchchi Woddike Gootta eebbissetek atete kaddettaxxee duuchchi woddi'a eebbisemowwaal.»<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s1">Daawwiti Lole Middite Alfeexxa</para>
  <para style="r">(<ref loc="2SA 8:1-18">2 Sam. 8:1-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />Ookkoneechchi uduma Daawwiti Filisixeemika manna injifate isi hunda gallaasha asse; Gaatinna qarqara iseke'n hedheka olla'a Filisixeemike mannixxe anganaa'ni ibise.<verse eid="1CH 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2" />Ittanni Daawwit Mo'aabika manna lole injifate; insa'nenna irbo isi'a uwwate'ni ke'ne.<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />Irraa caala Daawwiti Efiraaxisike galaani bira hedhemmaka boga galcha ifixxa ba'lissatee me'e wodda, Suubaanik moyanji Hadaadi'ezari ali darree'ni Hasemati qico'n mare lole. <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />Daawwitinna mitte kuma fadhadiinxa gaare, torbaane kuma fadhadiinxe gaareka oofalluwwa, lame tomme kumma lakkatika loli manna, mitte dhibba fadhadiinxe gaaretika fadhadiinxa calla gatise waalexxi gateeka mogole woxe.<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />Demaasiqo hexxeexxi Sooriyito Suubaka moyanjo Hadaadi'ezeri'i gargarate'e sannachcha erigee wodda Daawwiti insa'ne'ni giddii'n lame tommenna lame kuma manjo shiye. <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />Ookkoneechchi Sooriyaxxe galcha giddo hexxeexxe Demaasiqo'n heqqatixxa xelleephpho giisse; Sooriyitotinna irbo isi'a aaxxe dagge. Duuchchi Woddik Gootti Daawwiti'i mare booncho duuchcha'n injifataashsha middite uwwe.<verse eid="1CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7" />Daawwitinna Hadaadi'ezerika loliink sooreessuwwi aggaamme abindeexxa worqet giissendeexxa wonte aadhe; Iyyerusaalemi'anna aadhe dage. <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />Daawwitinna Hadaadi'ezerixxe galcha hunda hexxeexxe Xibihatinna Kekun'ni heddo sageettuwwa aadhe; Solomooninna sagettoti galmi giddika miyuwa, wode'e cammammaka gonga, utuphuwwakanna gargarti hedheeka imaanuwwa konneechchuwwinni huje.<note caller="-" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="1KI 7:40-47">1 Moy. 7:40-47</ref>; <ref loc="2CH 4:11-18">2 Odo. 4:11-18</ref>. </char></note><verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />Hamaatik moyanji To'u Daawwiti Suubaneka moyanjo Hadaadi'ezerika sannachuwwa duuchcha lole injifatexxa laqeexxi, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />To'i Hadaadi'ezerinni welti heddole adhete'ni sa'isseemaxxe'e, moyanji Daawwiti anga uwwaashanna Hadadi'eezeri'ni lole injifateexxe'e injifachcho kulaashsha belto iifka Yori'aami'i Daawwitbaa'a erga. Yoraaminna woriqe, birretixxe sageettonn hujenmeeka miyuwwa gicaa Daawwiti'a iyyedage.<verse eid="1CH 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11" />Moyanji Daawwiti Eedoomi'ni, Mo'aabi'ni, Amoonitotenaa'n, Filisixeemike manninaa'ninna Amaaleqitotenaa'n konnechuwwi duuchchinaa'n mootelleeyuwwa booji'utemaxxa worqenna sibiljo birre konneechchi edo assinemmashshann konne miyuwwa duuchcha Duuchchi Woddike Gootti'a woyyonse.<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />Tsiruyak belti Abisa Maxinetixxe Dhooqa'ni tommenna saddeeta kuma Eedoomika manna shiye.<note caller="-" style="x"><char style="xo" closed="false">18:12 </char><char style="xt" closed="false"><ref loc="PSA 60">Far. 60</ref>. </char></note> <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />Isinna Edomi'i heqatixxa xellephphuwwa giise; Eedoomito duuchcha moyanjo Daawwiti'a irbo uutaxe kadde. Duuchchi Woddik Goottinna Daawwiti'i mareboonno duuchcha'n injifataashsha middete uwwe.<verse eid="1CH 18:13" /></para>
  <para style="s1">Daawwitixxa Jalqaabuwwa</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />Daawwiti Isira'eelike boga duuchcha'n mowe; ardi duuchchi dhugatixxa murtenna qullumma alfaashsha asse. <verse eid="1CH 18:14" /><verse number="15" style="v" sid="1CH 18:15" />Tsiruyak belti Iyyo'aabi sannachchi duuchchik ajajallomman; Ahiluudik belti Iyyoosafiixxi kinn borreessanjokemman. <verse eid="1CH 18:15" /><verse number="16" style="v" sid="1CH 18:16" />Ahixoobik belti Saadooqinna Abemelekik belti Abiyataar qeesetemman; Suusa kinn borreessanjokemman. <verse eid="1CH 18:16" /><verse number="17" style="v" sid="1CH 18:17" />Yodahek belti Bennayaasi Kelitawwitotikenna Felitawwitotik ajajallomman. Daawwitixxi labbaxxi oose kinn moyanjoke'ni itti aandaaxxe galchaluwwamman.<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s1">Daawwiti Amoontonna Soorito Lole Injifateexxa</para>
  <para style="r">(<ref loc="2SA 10:1-19">2 Sam. 10:1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />Okkoneechcchi uduma Amoonitotik moyanji Na'oosi reye; belti isikinna bakka isixxe'n mowe. <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />Daawwitinna, «Anni isik ani'a eloxxa asseemmashshann ege'li aninna Na'oosike belto Hanooni'a eloxxa yaane asso» hiyye hede. Tennexxee Daawwiti anniinxe reyoxxee yaaddo iso'o jajjabeessate'e Hanoonibaa erganjuwwa erge.</para>
  <para style="p" vid="1CH 19:2">Daawwitk manninna yaaddo ege'nishatee Hanooni hedha'ne boonchibaa Amoonitotike bogibaa dangee wodda, <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />Amoonitotixxi hayyoole; Hanooni'ni, «Daawwiti yaaddo ege'nishatee manna atiba'a ergadheechi anna atika ulfeesete ate'n labbe'e? Manni atiba'a dageechchi boga dooyye abixxatetebaa?» hine. <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" />Tennexxee Hanoon Daawwitika manna abixxeexxi areeda haade; seema insa'nexxanna dollik butti'a hexxeexxa seemma daddare daddareexxi shorre.<verse eid="1CH 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5" />Insa'nenna hadi'a higate'e shoonke; Daawwiti kaddeexxa yaane duuchcha laqeexxi erganjuwwa erge. Moyanjikinna, «Areedi ha'nook nophphaa qico'n Iyyaarkonni turtine okkoneechchi uduma higgine dagginaan» hiyye.<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />Amoonito angadinn Daawwiti naapha assineexxa ifi'ann hende uundeexxi, Hanoonenna Amoonawwito Mesiphexomiya'a, Aramime'akana'anna Suuba'a gaaruwatanna fadhado qolchisaake jaane tomme kuma kiilo kadaaka sibljo birre ergine; <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />Ookko'n sase tommenna lame kuma gaaruwatanna fadhado qolchisakara ittanni Me'akanike moyanji'anna isika loliinka manni'a maallaqa uuneexxi heqqinse; insa'nenna dangeexxi Medaba hinaaba bukkine wodda, Amoonito kinn ifi ifike qachchuwinaa'n bukki hineexxi lolakee fulle.<verse eid="1CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8" />Daawwit tenne laqeexxi Iyyo'aabinenna madada loliinka sannachcha erge. <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />Amoonitotinna daggeexxi qachchinbaa e'yinamamxxe hula'ni lolake'e dalle; gargaarsakee dageeki moyanjuwwi qofinn diidake'n hedhemman.<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10" />Iyyo'aabinna edi udumii'n loli hedheexxanna buqemaaxxa uudeexxi; Isira'eeli giddo adhe ege'nemeeka jajjaba manna fi'leexxi Soorito lollaasha ka'lishe. <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />Gateek manninna isika dayya Abisa hunda hedheexxi Amoonito lollaashsha ka'lishe. <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />Iyo'abinna hiyyee qic, «Soorito itti ane'n jabaatole ati ane'e gargaartatton; Amoonito ate'ni itti jabaatoole kinn ani ate'e gargaarannon. <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />Yoona jabaatte no'oke ardixxenna no'oke Magenike qachixxe jabante lollo; Magenikinna eeyyeexxa assowwal» hiyye.<verse eid="1CH 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14" />Ookko'ni Iyyo'aabinna isinni welti hedhemmak loliink manni Soorito lolatee edi'a fiinga'n me'ine; Soorawitonna insa'ne edii'n baanje. <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />Amoonito Soorito baajjeexxa affeexxi insa'nenna dayyo Abisaani edi'ni baanjeexxi qachchi giddi'a e'yine; tennexxee Iyyo'aabi Iyyerusaalemi'a hige.<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />Soorito Isira'eeli injifateexxa calla affeexxi erganjuwwa ergine Efiraxisike galaani wido hexxeexxa Soorawito daggaashsha erginse; konneeranna akeeka'ner Hadaadi'ezerike sannachchik ajajalollo Shoofakiten.<verse eid="1CH 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17" />Daawwiti tenne laqeeshshann Isira'eelika arda duuchcha bukki asseexxi Yordaanoosika galaana foofe; edi'a sammi hiyye me'eexxi lola welti ibaka booncho abixxe; Daawwitinn Sooritoti lola ibatee heqqaka manna dala giisse; insa'nenna isinni lola inbe. <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />Kaddomalee Isira'eeli edi'ni ke'ne baanje; Daawwitinna torbaane kuma fadhadiinxa gaaruwanna butta lolaaka shoole tomme kumma manna shiye. Iittanni Shoobaak hiyyemaaka Sooritotike begediinki ajajallinna konne lola'n reye.<verse eid="1CH 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19" />Hadaadi'ezerixxe galcha hunda hexxeexxi hayyoole Isira'eeli'ni injifatendeexxa uundeexxi Daawwitinn nage'ik he'no'a isi'a ergatemme ke'ne.</para>
  <para style="p" vid="1CH 19:19">Tennexxee Soorito tenne barranaa'n saffe Amoonito gargaratee eeti hiyye'ne.<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s1">Raabike Qachchixxa Abidensha</para>
  <para style="r">(<ref loc="2SA 12:26-31">2 Sam. 12:26-31</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />Mootoleeyye lolakee me'itammaxxe woggatixxe jijjiirenshaxxa yanna Iyo'abi loliinka sannachcha akeeka'n mareexxi Amoonitotika boga balleese Raabaatika boga mareexxi buqe; Daawwiti kinn Iyyerusaaleminni gateemman. Iyyo'aabinna Raabaatii lole diige bire.<note caller="-" style="x"><char style="xo" closed="false">20:1 </char><char style="xt" closed="false"><ref loc="2SA 11:1">2 Sam. 11:1</ref>. </char></note> <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />Daawwitinna moyanjumatika kallachcha umokenaa'n aadhe; a'urikinna sase tommenna shoole kiilo kadaaxxe worqemman; tenneenna Daawwitike umi hana uggine; ittanni qachchi giddi'ni heddo laakkoonne dhaqanbabaachcho booji'e aadhdhe. <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />Okko'o hedheeka arda aadhe gadeexxi magaaze, qottonna maxiraba aa'ne hunjaasha asse. Daawwit wele Amoonike qachcha duuchcha'n tennee assine. Okko'n Daawwitinna sannachchi duuchchi Iyyerusaalemi'a hinge.<verse eid="1CH 20:3" /></para>
  <para style="s1">Filisixeemike Manninni Welti Inbeeka Lola</para>
  <para style="r">(<ref loc="2SA 21:15-22">2 Sam. 21:15-22</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />Ookkoneechchi uduma Filisixeemike manninni welti Geezere'i lola inbe: okkone wodda Huushichi Sebokay Rafayemixxe sannenaa'ni Sefayi'i shiye. Filisixeemik manninna injifateme.<verse eid="1CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5" />Filisixemike manninn welti loleme'ek weli haarok loli kade; Ya'irik belti Elihanani, bagedo isikixxe somilchik furdinni gannammaxxe seemmaka mirisanjoxxa qixxe kadaaka Gaatike bogika manjo, Goliyaadika dayyo Laahimi'i shiye.<note caller="-" style="x"><char style="xo" closed="false">20:5 </char><char style="xt" closed="false"><ref loc="1SA 17:4-7">1 Sam. 17:4-7</ref>. </char></note><verse eid="1CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6" />Higgeenni Gaati'ni assemeeke wele lola'ni, angate'ninna lekkate'n jaane jaane qubba madadi mitteba lame tommenna shoole qubba afe'eke heenobaake manjoman; kunninna ittanni Rayifayimixxe sannena'niteman. <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />Isinna Isira'eelito qacifatte wodda Daawwitika dayyo Shemayak belt Yoonataani'i shiye.<verse eid="1CH 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8" />Gaati'i hexxemmaxxi Rafayimixxi horte tenne labbaan; Insa'nenna Daawwitixxenna isike loliinke mannixe anga'ni inbe.<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s1">Daawwiti Loliinka Sannachchuwwa Laako'e</para>
  <para style="r">(<ref loc="2SA 24:1-25">2 Sam. 24:1-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />Durriisi Isira'eeli'ni ke'exxi Daawwiti Isira'eelika arda laakko'ashsha tirtirse. <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />Daawwitinna Iyyo'aabinna sannachchiinka ajajaluwwa, «Bersaabehi'ni Daaniqico'ni hedheeka Isira'eelika arda martineexxi laakko'e; ookkoo'ni me'e kadeexxa ege'nonaa ane'ni kulle» hiyye.<verse eid="1CH 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3" />Iyyo'aabi kinn, «Duuchchi Woddik Gootti Isira'eelika sannachchuwwa ta'a hedhee qici irra dhibba anga dachcha'ik bira sa'issowwal; koo moyanjo anke goota; duuchching anke gootike garbabaa? Eega tinni itta kadoole anke goota tenne assa isi'a maye'e hasisse? Mayikete Isira'eeli'ni cubbo idaga'negeechchi?» hiyye.<verse eid="1CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4" />Kaddomalee moyanjiink hiyyichchi Iyyo'abi'i injifate; tennexxee Iyyo'abi fule: Isira'eelike boga duuchcha'ni mammaremeechchi uduma Iyyerusaalemi'a hige. <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />Iyyo'aabinna lolinke mannika laakkossa Daawwiti'a shiqise; kunnirinna Isira'eelike boga duuchcha'ni mitti miloonenna mitte dhibba kuma manna; Yihuda'n kinn shoole dhibbanna torbaane tomme kuma kandaa wodda madadi insa'nek wolaantichcho abixxa dande'a'nera callamman.<verse eid="1CH 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6" />Iyyo'aabi kinn moyanjiinka ajaja giba'emake kademaxxe Leewwitonna Biiniyamito mannik welt laakko'ebaa. <verse eid="1CH 21:6" /><verse number="7" style="v" sid="1CH 21:7" />Kunni ajaji Mageni darre'n gibemeekemman; tennexxee Isi Isira'eeli'i gane.<verse eid="1CH 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8" />Okko'ni Daawwit Mageno, «Tenne assati ani ate'e balleesennen; lumoxx cubbo hujeenaxxee ane'e garbichcha atikixxa cubbo gondoortota'a ate'e soodataannen!» hiyye.<verse eid="1CH 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />Duuchchi Woddik Goottinna Daawwitika wabeeka kade'eka Gaadi'i hiyyee qic: <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />«Daawwiti'ni marte hitato qici, ‹Duuchchi Woddik Gootti atee hiyya'neexxi, yoona sase yaada ati'a shiqiseennen; konnenaa'n ate'n geessiseeshshanni ate'ni mitte fi'li› hiyya'nen» hite kuli.<verse eid="1CH 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11" />Tennexxee Gaadinna Daawwitibaa mareexxi iso'o hiyyeqic: «Duuchchi Woddik Gootti iso'n hiyya'nee ‹Amo yoona mitte fi'li; <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />Sase woggak solo'i yookin sase agenjo naapha atikixxe anga'ni iba yookin sase barra Duuchchi Woddike Goottixxi wolaantichchi, bala buttate'n ibe'na Duuchchi Woddik Gootik erganj Isira'eel duuchcha balleeso'an?› ergiteettek maa hiyye hiissanoxxa calla ani'a hiissichcho uwwi» hiyye.<verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />Daawwitinna Gaadi'i, «Yo'oshsha rakkatennen mararte isixxi lumoxxe kaddemaxxe'e manjiinxe anga'ni iba hasaabo'non; Duuchchi Woddike Goottixxe anga'ni ibennexxa woyyan» hiyye.<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />Tennexxee Duuchchi Woddik Gootti Isira'eeli'n bala ibise; Isira'eeli giddii'n torbaane tommi kumi manji mude. <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />Iittanni Mageni Iyyerussaalemi'i ballesinaashsha iimika erganjo erge; iimik erganjinna balleeso'a hiyyamale Duuchchi Woddik Gootti uudexxi gelta'neexxe ba'nexxee yaade; arda balleesemmaka iimika erganjonna, «Ta'a yoona gelte'een anga atixxa hoyyedhi» hiyye. Ookkone wodda iimik erganjinna Iyyaabusichcho Oriinaxxe aldumme bira uurremman.<verse eid="1CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16" />Daawwitinna iimiki erganji iimatixxenna buttatixxe oddo'ni uure'na afe: iimik erganjinna Iyyerusaalemi'ni gonofakenaa'ni luqqinse fulchineeka wolaantichcha anga abixeemman; Ookko'n Daawwitinna geedhe dooniyya odo'winemmashshann albiki buttinake'n wabbi hine.<verse eid="1CH 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17" />Daawwiti Mageno, «Lolamak manni laakko'ashsha ajajennek antebaa? Cubbo hujenneki ballesanjikinna anenden: kunni ardi mitti mitte balleesa hujekebaan; eega insa'ne maa assine? Koo Duuchchi Woddike Gootta Mageno anga atixxi ane'ninna anke annike mine'ni hexxo malee'e, bala ardake'n ibisoxxe» hiyye.<verse eid="1CH 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />Ookko'ninna iimik erganji Daawwiti dageexxi Iyyaabusichcho Oriinaxxe aldume'ni mareexxi Duuchchi Woddike Gootti'a tolchimalcho hujaashsha Gaadi iso'ni haaso'o'a ajaje. <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />Daawwitinna Duuchchi Woddike Goottika ajaja Gaadi iso'ni haaso'emashann muuxo'a fule.<verse eid="1CH 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20" />Oriina dinne uxxate'ni hedhe udumaa wirri hiyye iimika erganjo afe; isinni hedhemmak shoole labbaxxi oosenna sho'onde. <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />Oriinanna Daawwiti isiba'a shiqa'ni dageexxa uudexxi aldumme giddii'n fuleexxi ulfesate butta wabbiye anga iimi'a ke'ise.<verse eid="1CH 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22" />Daawwitinna isoo, «Ardake'n ibbeexxi bala baxxaashsha Duuchchi Woddike Gootti'a tolchimalcho giissonna'a aldumme atixxa hi'lonna'a ane'ni gurgur; addichcha maallaqa ani ati'a uwwannon» hiyye.<verse eid="1CH 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23" />Oriinanna Daawwitii'i, «Koo moyanjo ittanni tolanga aaxxe eetettexxa assedhi; tolchi booncho'n ciincatee qotiluwwa, giiratixxe heqqe'a uxxisanjuwwa, dinne kinn midhatixxe uwwa kaddaashshanna duuchchingeechcho ati'a uwwannon» hiyye.<verse eid="1CH 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24" />Moyanji Daawwit kinni Oriinaa'a, «Tinni kaddabaan; hasisaachcho duuchcha ani isi'a uwwannon; atixxa karra, ani daffe elo'ebe'nochcho Duuchchi Woddike Gootti'a ciincesatike tolcha asse shiqisha hasaabe'non» hiyye.<verse eid="1CH 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25" />Tennexxee Daawwit Oriinaxxe aldumme boonchika hira jaane dhibba worqetika kutemalchuwwa uwwe. <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />Daawwitinna okko'o Duuchchi Woddike Gootti'a tolchiinka booncho qophpheesseexxi ciincatika tolchanna mittominka tolcha shiqise. Duuchchi Woddika Goottanna ye'edhe; Duuchchi Woddik Goottinna ciincatiki tolchi shiqa'ne booncho'ni isi'a iimi'n giirati hiisse.<verse eid="1CH 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27" />Okko'ni Duuchchi Woddik Gootti iimike erganji'a wolaanticho gonofi giddi'a hiissedhe hiyyeexxi haaso'e; erganjikinna giddi'aani hiissedhe. <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />Ookkone wodda Daawwiti, Duuchchi Woddik Gootti Iyyaabusichcho Oriinake wildumme'ni hiissichcho uwweexxa uudeexxi, ettene bakka'ninni tolcha shiqise. <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />Muuse qiilla gammoojje'ni Duuchchi Woddik Goottika galdumiika duunkaana hujemmakinna ciincatike tolchika booncho giissemmak Geba'oonixxe gooro iimamman. <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />Daawwit iimike erganjika wolaantichcho sodaatemmaxxee okko'a mareexxi Duuchchi Woddika Gootta laqedha dande'ebaan.<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />Okko'ni Daawwitinna, «Ta'inn udumi'a Duuchchi Woddike Gootti Magenik mini konnoo kadaan; ittanni Isira'eeliki ardi ciincatika tolcha shiqinsaak tolchi boonchi konno'o uurraan» hiyye.<verse eid="1CH 22:1" /></para>
  <para style="s1">Galma Ijaaratee Assendeexxa Qixxeeffachcho</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />Tennexxee Daawwiti Isira'eelike boga'n hexxemmaxxa hedhdo manni bukki hiyyaasha ajaje; oddo insa'nexe'ninna Magenoke'e galma ijaaraashsha kino bocaaka manna qixxeessinaashsha dhaabe. <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />Daawwitinna dalla'uwwiinka cufana hunjaaka misimaarenna maaxafa hunjaaka heddo sibilo, ittanni heddachchotenaa'ni kexxeexxa kiille dhaqqanbabaaxxa heddo sageettuwwa qophpheesse. <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />Ittanni Sidoonikinna Xiroosik manni heddo ejersiinka haqichcho aa'ne dangammaxxee isinna laakkonne dhaqqanbabaak birbisiinxa haqqe qophpheessedhe.<verse eid="1CH 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5" />Daawwitinna, «Belti anki Solomoon oosicha huje ege'nebaake Duuchchi Woddike Gootti'a ijaara'neek galmi hara yo'oshsha butta duuchcha'n jajemeekenna saademeeke kadiyo hasissaan. Tennexxee duuchchiinxa aninni qophpheessedhannon» hiyye. Hiyyemashshann Daawwiti reyeba edi darre heddo miyuwwa qophphesesedhe.<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />Okko'ni belto ifika Solomooni'i ye'eexxi Isira'eelike Duuchchi Woddike Gootti Magenika mine ijaaraashsha ajaje.<verse eid="1CH 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 22:7" />Daawwitinna Solomooni'i hiyyee qic; «Koo anke belto; Duuchchi Woddike Gootta anke Magenke summi'a mine ijaaronna'a godobik yoreennan; <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />Yaane kinn Duuchchi Woddike Gootti darre'ni ani'a hiyyichchi dageexxi, ‹Ati heddo manjixxa munde lolaasseettaxxee heddo duulo duulde loldeten; ani edo buttate'n yo'oxxa munde dhangalaassettaxxee ati anke summi'a mine ijaartabexxon; <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />Yaane kinni nage'iinka ti'ni asse ofo'lishaaka manjo labbake belto i'litatton; qarqarake'n hedheeke bagedonaa'n iso'o heqqannon; summikinna Solomooni hiyyemaan. Isixxe mootumma galcha'n Isira'eeli'a nage'akanna ti'ni hiyya hexxaashsha assannon. <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />Anke summi'a mine a'naa ijaara'neek isoten. Isi belto anke kadaan; Aninna annake isi'a kadannon. Moote anxanna Isira'eeli'ni duuchchi woddi'a ti'ni assannon.›<note caller="-" style="x"><char style="xo" closed="false">22:10 </char><char style="xt" closed="false"><ref loc="2SA 7:1-16">2 Sam. 7:1-16</ref>; <ref loc="1CH 17:1-14">1 Odo. 17:1-14</ref>. </char></note><verse eid="1CH 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11" />«Ta'anna anke belto Duuchchi Woddik Gootti atiki Mageni atinni welti hedhowaal; Isi'a mine ijaartattoshsha kokeesse haaso'emmashshann duuchchiinxa yaane Isinni ati'a muuxowwaal. <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />Isira'eeli'ni atee akeekisanjo assemma wodda, Duuchchi Woddike Gootti atike Magenika ajaja muuxxattoshsha Duuchchi Woddik Gootti beekumakanna ege'na ati'a uwwowwaal. <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />Duuchchi Woddik Gootti Muuse darre'ni Isira'eeli'a uwweexxa aadatanna seera xonxomatte heqqexxottole ati'a qajeeldaan; meeco'o jabaati, shenichchake kadi, sodaattoxxe.<note caller="-" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="JOS 1:6-9">Iya. 1:6-9</ref>. </char></note><verse eid="1CH 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14" />«Ani darree'ni Duuchchi Woddik Goottike minike ijaarsi'a kadaaka sase kumanna shoole dhibba toone worqenna sase tommenna shoole kuma toone birret sibiljo; laakkossi iimi darre hexxeexxa sageettonna sibilo cameennen; ittanni haqqetanna kino qixxeseennen; wele ati lebi. <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />Kino bocaaka, mine ijaaraaka, haqqe daddare seesaaka yo'oka hujaluwwa, ittanni garagar hexxeexxe ogenni hedheeka heddo manna affeetten. <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />Kunnirinna laakkossi insa'nek hara bira sa'ekir, worqetik, sibiljo birrenni, sageettotinna sibiliinxe hujenni muxxe fuleeke mannan. Amo yoona huje safi; Duuchchi Woddik Gootti atinni welti hedhun» hiyye.<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />Okko'ni Daawwiti Isira'eelik akeekisanjuwwi duuchchi belto isika Solomoon'i gargaraashsha ajaje: <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />hiyyee qici, «Duuchchi Woddik Gootti ha'nook Mageni ha'nooninni welti hedheba? Qarqar ha'nooke'n nage'a ha'no'a uwweeba? Okkone boga'n hedheeka manna anga anxe'ni sa'isse uwween; bogi giddo hedheek ardi ha'no'anna Duuchchi Woddike Gooti'a hireme galaashshaten. <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />Ta'atenna kaddoole Duuchchi Woddike Gootta ha'nooke Mageni'a shenitte qalbenninna shenitte hedhonni ergatemme; Mageniinka kakotika taabootanna woyyichcha miyuwwa Duuchchi Woddike Goottik summinn ijaarema'neeke miniba'a idaggineexxi Duuchchi Woddike Gootti Magenika galma ijaarre» hiyye.<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s1">Leewwito</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />Daawwit cime hunna gopha'ni dage wodda, belto ifika Solomooni'i Isira'eeli'ni mootonse.<note caller="-" style="x"><char style="xo" closed="false">23:1 </char><char style="xt" closed="false"><ref loc="1KI 1:1-40">1 Moy. 1:1-40</ref>. </char></note><verse eid="1CH 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2" />Ittanni Isira'eelika akeekisanjuwwa, qeesoletanna Leewwito duuchcha mitteba bukki asse. <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />Sase tomme wogganna okkoneechchi iima hexxeexxi labbaxxi oose duuchcha laakko'ende; madadiing sase tommenna saddeeta kumamman. <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />Daawwitinna hiyyee qic, «Konneer giddii'ni lame tommenna shooli kumi Duuchchi Woddike Goottike minixxa huje towantowwaal; jaani kumi kinn ja'laabuwwakenna hayyoolete kanduni; <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />Shool kumi dalla'a heqqowwaal; shool kumi kinn tennexxeenni hiyye qophpheessennake meellatike miyinni Duuchchi Woddika Gootta saandowwaal» hiyye.<verse eid="1CH 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 23:6" />Daawwitinna Leewwixxe ooseeshsha sase kuta'n Gershooni'i, Qe'atinna, Meeraari'n dhaabe.<verse eid="1CH 23:6" /></para>
  <para style="s1">Gedisonawito</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 23:7" />Gershoonito</para>
  <para style="q2" vid="1CH 23:7">La'idaninna Seme'i.<verse eid="1CH 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 23:8" />La'idanik angaf belt</para>
  <para style="q2" vid="1CH 23:8">Yihi'eeli; Zeetaminna Iyyu'eeli, hinaaxxa sase labbaxxa oose afeemman.<verse eid="1CH 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 23:9" />Seemeni oose:</para>
  <para style="q2" vid="1CH 23:9">Selomit, Hazi'elinna Haran; mitteba sase labbaxxe oosemman.</para>
  <para style="q2" vid="1CH 23:9">Kunniiri La'idanike mini hadik sooreessuwwan.<verse eid="1CH 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 23:10" />Seme'ixxi oose</para>
  <para style="q2" vid="1CH 23:10">Yahaati, Ziiza, Ye'ushi, Beeriya,</para>
  <para style="q2" vid="1CH 23:10">kunni shooli Seme'ixxe labbaxxe oosen.<verse eid="1CH 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 23:11" />Siretik Yahaati, langak Ziizateman;</para>
  <para style="q2" vid="1CH 23:11">Ye'ushinna Beeriya kinni heddo labbaxxa oose i'linemmabaan;</para>
  <para style="q2" vid="1CH 23:11">tennexxee laakkossake'n insa'ne hujetixxe sultonni</para>
  <para style="q2" vid="1CH 23:11">mitte mini hadishsha fakkaanteeten.<verse eid="1CH 23:11" /></para>
  <para style="s1">Qe'aatawwichcho</para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 23:12" />Qe'aata;</para>
  <para style="q2" vid="1CH 23:12">Inberime, Yisi'are, Kebiroone</para>
  <para style="q2" vid="1CH 23:12">Uzi'eeli'i, mitteba shoole labbaxxa oose afeen.<verse eid="1CH 23:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 23:13" />Inberemixxi labbaxxi oose,</para>
  <para style="q2" vid="1CH 23:13">Aarooni, Muuse.</para>
  <para style="m" vid="1CH 23:13">Aarooni qullesemo'a foyeme; isinna sanne isixxi duuchchi woddi'a woyyo kadeechcho qullonsinaashsha Duuchchi Woddike Gootti edo tolcha shiqinssaashsha, Isi edo ergatemmaashshanna isike summinni duuchchi woddi'a eebisemmaashsha foyemme.<note caller="-" style="x"><char style="xo" closed="false">23:13 </char><char style="xt" closed="false"><ref loc="EXO 28:1">Fula. 28:1</ref>. </char></note> <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />Mageni manjiki Muusexxi labbaxxi oosenna Leewwitotixxe gosake mini hado kadde laakko'ende.<verse eid="1CH 23:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 23:15" />Muusexxi labbaxxi oose, Gershoomi, Eli'eezer.<verse eid="1CH 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 23:16" />Gershoomixxi sannuwwa;</para>
  <para style="q2" vid="1CH 23:16">angaf Suba'eel.<verse eid="1CH 23:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 23:17" />Eli'eezer sannuwwa;</para>
  <para style="q2" vid="1CH 23:17">siretik Ri'abiyatemman. Eli'eezer wele labbaxxa oose afemmabaan; Ri'abiyaxxi labbaxxi oose kinn hara yo'oxxemman.<verse eid="1CH 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 23:18" />Yisi'arixxi labbaxxi oose;</para>
  <para style="q2" vid="1CH 23:18">siretik Seloomiti.<verse eid="1CH 23:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 23:19" />Kebiroonexxi labbaxxi oose;</para>
  <para style="q2" vid="1CH 23:19">siretik Yiriya, itti aanak Amareya, sakkaki Yahazi'eeli, sholgak Yiqami'amitemman.<verse eid="1CH 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 23:20" />Uzii'elixxi labbaxxi oose;</para>
  <para style="q2" vid="1CH 23:20">siretik Miika, itti aanak Yushiyateramman.<verse eid="1CH 23:20" /></para>
  <para style="s1">Meerariyawito</para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 23:21" />Meeraarixxi labbaxxi oose;</para>
  <para style="q2" vid="1CH 23:21">Mahili, Muushi.</para>
  <para style="q2" vid="1CH 23:21">Mooholixxi labbaxxi oose;</para>
  <para style="q2" vid="1CH 23:21">Ali'aazaarinna Qiisiteramman.<verse eid="1CH 23:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 23:22" />Ali'aazaar labbaka belto i'lebaang reye;</para>
  <para style="q2" vid="1CH 23:22">oose isixxinna meyyaxxe callamman;</para>
  <para style="q2" vid="1CH 23:22">insa'neena annike dayyo Qiisixxi labbaxxi oose aaxxe.<verse eid="1CH 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 23:23" />Muushixxi labbaxxi oose;</para>
  <para style="q2" vid="1CH 23:23">Mahili, Eedere, Yiremoti mitteba saseken.<verse eid="1CH 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24" />Yoona kunni aante aantetinna mini minik kulema'neer Leewwixxe sannuwwa kandaa wodda; mitti mitting ifi ifike summinn borreessemeen. Lame tomme wogga geyeek yookaan ookkoneechchi iima hedheek mitti mitting Leewwixxi sanne Duuchchi Woddike Goottike galmi giddo ergateemaamman. <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />Daawwiti, «Isira'eeli Duuchchi Woddik Gootti Mageni arda isikee nage'a uwween; Iyyerusaalemi'i duuchchi wodda hedho'a dage'en; <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />Leewwito ta'in udumi'a duunkaana yookaan mageneefachchotixxe aada'a ergatemaaka miyuwwa duuchcha insa'ne duka hasisabaan» hiyye.<note caller="-" style="x"><char style="xo" closed="false">23:26 </char><char style="xt" closed="false"><ref loc="LEV 10:8">Lew. 10:8</ref>. </char></note><verse eid="1CH 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 23:27" />Daawwit muuxamake'n uwweexxe aadashshann lame wogganna okkoneechchi iima hexxeexxi Leewwito duuchcha lakko'ende.<verse eid="1CH 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28" />Leewwitotixxi huje Duuchchi Woddike Goottike galmi diddo Aaroonixxe sanne'a ergatemat qarqara, galmiinka dalla'axxa baxxenna kutuwwa xexxe'achcho assa; qullo'eeka miyuwwa duuchcha ca'assatenna Mageniinke mine'ni hexxeexxa wele hujuwwa duuchcha hujatemman. <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />Ittanni Duuchchi Woddike Gootti'a uwwatee kadde beerake'n shiqqaaxxa kebbonna umiinxe midhaxxe uwwaxxa bulle, gamami belo; ra'isina'nexxa kebbo ra'isina'neek, qushshina'neek, ra'isina'neekanna saffarraakanna kado minkaaka duuchcha maganne a'line towanta'nekir insa'neteeran. <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />Barra barra'ninn gorsanna hashsha Duuchchi Woddika Gootta galateeffatateenna sirbatee edo inbaamman; <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />Ittanni sanbatange'ni, agenjoke'n fulche'na'neeke ayyaana'ninna seera fulchineeke ayyaanuwwa duuchcha'n muunxaamman; insa'ne'a murre uunemmak laakkossishshann uwwendeexxe aadashann duuchchi wodda Duuchchi Woddike Gootti'a ergatemmaamman.<verse eid="1CH 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32" />Tennexxee Leewwito afenshatike duunkaani'aanna eettene woyyitte baka'aa iittanni dayyuwwa insa'nexxe Aaroonixxe sannuwwa hunda he'nee Duuchchi Woddike Goottike galmi'a anfeexxa annomixxa sooreessumma muunxaamman.<note caller="-" style="x"><char style="xo" closed="false">23:32 </char><char style="xt" closed="false"><ref loc="NUM 3:5-9">Lak. 3:5-9</ref>. </char></note><verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s1">Qeesoleti Qoddo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />Aaroonixxe oose'a uuneek qoobi konneechchinn butti'a hedheen.</para>
  <para style="p" vid="1CH 24:1">Aaroonixxi oose Naadab, Abihu, Ali'aazaarinna Itamaaritemman. <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />Naadabinna Abihu kinn sanne sa'isse'nebaang anni insa'nek reyeba edi darre renne; Tennexxee Ali'aazaarinna Itamaari qeesummat ergatemaamman. <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />Daawwitinna Ali'aazaarik sannek Saadooqinna Itamaarixxe sannek Abemelek isoo gargaara'n huje insa'nexxik qoobbishshann qofi qofittinni fo'a'ni dhaabe. <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />Itamir irra Ali'aazaarixxe sanne giddii'n heddo akeekisano leelite; qoobi insa'nekinna konneechchi butta hedheen: Ali'azarixxe sannuwwanaa'n tommenna jaane mini hadik sooreessuwwi; Itamaarixxe sannuwanaa'ni saddeeta mini hadik sooreessuwwi. <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />Ali'aazaarixxenna Itamaarixxe sannuwwaxxe oddo'ni galmiinxi akeekisanonna Mageniinka ja'laabuwwa he'nemaxxe'e gamatabelo insa'nee hixiki foone.<verse eid="1CH 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6" />Leewwitot giddii'n Natina'eelik belt borreessanji Shamaya, moyanji edonna ja'laabuwwa: qeesichcho Saadooqinna Abiyataarika belto Abemelek edo, qeesoletikenna Leewwitotike mini mini haduwwike akeekisanjuwwi edo mitte hixa Itamaarike mini hadi giddii'n Ali'aazaari'n mitte hixa kinni Itamaari'n borreesse.<verse eid="1CH 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 24:7" />Siretik hixi Yihou'yaraabi'a, langaba Yeda'iya ibe;<verse eid="1CH 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 24:8" />Sakkak Haarimi'a, sholgak Si'orimi'a,<verse eid="1CH 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 24:9" />Ondik Melikiya, jiyak Miyamine'a;<verse eid="1CH 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 24:10" />Torbak Aqoosi'a, saddeetik Abiya'a,<verse eid="1CH 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 24:11" />Salanik Iyasu'a, tommeessok Sekeniya;<verse eid="1CH 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 24:12" />Tommenna mitteessok Eliyaashibi'a, tommenna langeessok Yaqemi'a,<verse eid="1CH 24:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 24:13" />Tommenna sakkeessok Oopha'a, tommenna sholgeessok Hupha;<verse eid="1CH 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 24:14" />Tommenna ondeessok Biligaa, tommenna jiyake Imeeri'a<verse eid="1CH 24:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 24:15" />Tommenna torbeessok Hezi'eer, tommenna saddeeteessok Hapitseetsi<verse eid="1CH 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 24:16" />Tommenna sallaneessok Hafetaya'a, lame tommeessok Beyiheziqeeli'a,<verse eid="1CH 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 24:17" />Lame tommenna mitteessok Yihoyaarib'a, lame tommenna langak Yida'iyya'ni akeekemak,<verse eid="1CH 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 24:18" />Lame tommenna sakkeessok Delaaya, lame tommenna sholgeesok Me'aziyaa'a ibe.<verse eid="1CH 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19" />Isira'eelik Duuchchi Woddike Gootti Mageni edike anna insa'neke Aarooni darree'ni insa'ne'a kulemake ajajemmashshann Duuchchi Woddike Goottike galmi giddi'a e'yanaa woddixxi aada murendeexxi konne qicinnitemman.<verse eid="1CH 24:19" /></para>
  <para style="s1">Wele Gatteexxi Leewwito</para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 24:20" />Gatteexxe Leewwixxi sannenaa'ni kinn;</para>
  <para style="q2" vid="1CH 24:20">Inberimixxe labbaxxe oosenaa'ni; Suba'eli'i</para>
  <para style="q2" vid="1CH 24:20">Suba'elixxe labbaxxe oosenaa'ni Yehideya.<verse eid="1CH 24:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 24:21" />Re'abiyaxxe labbaxxe oosenaa'ni akeekisanji Yushiya.<verse eid="1CH 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 24:22" />Yitsiharchchotixxe gamona'n Seloomiti</para>
  <para style="q2" vid="1CH 24:22">Seloomitixxe labbaxxe oosenaa'ni Yahaati.<verse eid="1CH 24:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 24:23" />Kebiiroxxi labbaxxi oose; siretik Yiriya, langak Amaariya, sakkaki Yahazi'eeli, sholgak Yiqami'ami.<verse eid="1CH 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 24:24" />Uzi'eelik belti Miika,</para>
  <para style="q2" vid="1CH 24:24">Miikaxxe labbaxxe oosenaa'ni Shaamire.<verse eid="1CH 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 24:25" />Miikaki dayyi Yishiya;</para>
  <para style="q2" vid="1CH 24:25">Yushiyaaxxe labbaxxe oosenaa'ni Zekkariyasi.<verse eid="1CH 24:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 24:26" />Meeraarixxi labbaxxi oose Mahili, Muushi.</para>
  <para style="q2" vid="1CH 24:26">Yaa'iziyaki labbak belti Beeno.<verse eid="1CH 24:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 24:27" />Meeraarixxi labbaxxi oose;</para>
  <para style="q2" vid="1CH 24:27">Yaiziyaam Beeno, Shohaami, Zakuur, Eebiri.<verse eid="1CH 24:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 24:28" />Mahilixxena'n Ali'aazaar, kunni manjichchi labbaxxa oose i'leemmabaan.<verse eid="1CH 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 24:29" />Qiisixenaa'ni Qiisik labbak belti Yirahimeeli.<verse eid="1CH 24:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 24:30" />Muushixxi labbaxxi oose</para>
  <para style="q2" vid="1CH 24:30">Mahili, Eedare, Yaarmuti.</para>
  <para style="q2" vid="1CH 24:30">Kunniir yoona mini mini insa'nekishshann laakko'emeek Leewwitotemman.<verse eid="1CH 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 24:31" />Dayyuwwi insa'nek Aaroonixxi sanne assitemmashshann kunnirinna moyanjo Daawwiti'n, Saadooqi'n, Abemeleki'ni, ittanni qeesoletixxinna Leewwotiinxi mini hadik akeekisanjuwwi hedheeba hixa welaanni wel ibinse; angafink mini hadinna maa'ni dayyike mini hadixxa qixxe insa'ne'anna hixi ibe.<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s1">Galmixxa Faarsaleeyye</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />Daawwit ifike jalaabuwwike akeekisanoti welti hige masinqo, kiraara, suusu'le gannaa'ni raaga raaga'amakaara Asaafi'n, Hemaaneaa'ni, Edotaamike mini hadi giddii'n file ugge; Tenne huje muuxa'nee mannik summi konneechchinn butti'a hedheeran;<verse eid="1CH 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="1CH 25:2" />Asaafixxe labbaxxe oosenaa'n;</para>
  <para style="q2" vid="1CH 25:2">Zaakuri, Yoosefi, Netaniya, Asari'eela.</para>
  <para style="q2" vid="1CH 25:2">Asaafixxi oose Asafixxi galcha hunda hexxemman; Asaafinna moyanjiinxe galcha hunda hedhemman.<verse eid="1CH 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="1CH 25:3" />Edotaamixxe labbaxxe oosenaa'ni;</para>
  <para style="q2" vid="1CH 25:3">Gedaaliya, Tsiir, Yisha'iya, Semee'i, Hashabiya, Metatiya. Kunni jaaninig masinqot, Duuchchi Woddike Gootta saada'ninna kubbulsa'ni wabeekkumma haaso'emake anna insa'neke Edoomixxe galcha hunda he'nemman. <verse eid="1CH 25:3" /><verse number="4" style="v" sid="1CH 25:4" />Hemaanixxe labbaxxe oosenaa'ni;</para>
  <para style="m" vid="1CH 25:4">Buqiya, Metaniya, Azare'el, Suba'eel, Yaarmuti, Hanaaniya, Eli'ata, Gidaaliti, Roomaneti'ezere, Yoshibaqaasha, Meeloti, Hootire, Mahaziyoti. <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />Kunnir duuchchi moyanjiinke wabeekkichcho Eemanexxe oosemman. Isonna lumminso'a Mageni isi'a aagemmaxxe kakoshshanni uune. Magenikinna Hemaani'a tommenna shoole labbaxxa oosenna sase miyyaxxa oose uwwe.<verse eid="1CH 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6" />Labbaxxi oose duuchcha galmi suusu'leti, masinqotinna kiraaruwwik meellinni shiqa'neki Mageniinke minixxe ergatensha annuwwi insa'nekixxe galcha hunda he'nemman. Asaafi, Edotaaminna, Hemaani kinn moyanjiinke mootumma hunda he'nemman. <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />Kunnirinna mini hadi insa'neki mitteba higat duuchching Duuchchi Woddike Goottiba'a shiqaake meellinni barachcho a'leekenna muxxe fuleeramman; laakkossi insa'nekinna lame dhibbanna saddeeta tommenna saddeetakemman. <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />Ifi ifika hujetika qoobo ege'natee dargageessi, geerchi, barachchiisanjokenna kado barattoolet hine fonnebaang qixxe hixa ibirse'ne.<verse eid="1CH 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 25:9" />Siretik hixi Asaafixxe gosana'ni Yoosefixxe labbaxxe ooseuwwa isixxeenna</para>
  <para style="q2" vid="1CH 25:9">mini hado isike'e ibe;</para>
  <para style="q2" vid="1CH 25:9">laakkossi insa'nekinna tommenna lamekemman.</para>
  <para style="b" vid="1CH 25:9" />
  <para style="q1" vid="1CH 25:9">Langak Gedaaliya'a ibe; ittanni isi'anna</para>
  <para style="q1" vid="1CH 25:9">Isike mini hadixxe labbaxxe ooseninni ibe;</para>
  <para style="q2" vid="1CH 25:9">laakkossi insa'nek tommenna lamekemman.<verse eid="1CH 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 25:10" />Sakkaki Zaakuri'a, labbaxxe oosuwwa isixxeenna</para>
  <para style="q2" vid="1CH 25:10">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:10">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 25:11" />Sholgak Layitseri'a, labbaxxe oosuwwa isixxeenna</para>
  <para style="q2" vid="1CH 25:11">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:11">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 25:12" />Ondik Netaniyaxxe labbaxxe oosuwwa isixxeenna;</para>
  <para style="q2" vid="1CH 25:12">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:12">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 25:13" />Jiyak Buqiya'a, labbaxxe oosuwwa isixxeenna;</para>
  <para style="q2" vid="1CH 25:13">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:13">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 25:14" />Torbak Yishere'eli'a, labbaxxe oosuwwa isixxeenna;</para>
  <para style="q2" vid="1CH 25:14">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:14">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 25:15" />Saddeetik Yeshaya'a, labbaxxe oosuwwa isixxeenna;</para>
  <para style="q2" vid="1CH 25:15">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:15">laakkossi insa'nekinna tommenna lamakemman.<verse eid="1CH 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 25:16" />Sallanik Metaniya'a, labbaxxe oosuwwa isixxeenna;</para>
  <para style="q2" vid="1CH 25:16">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:16">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 25:17" />Tommik Seme'i'a, labbaxxe oosuwwa isixeenna</para>
  <para style="q2" vid="1CH 25:17">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:17">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 25:18" />Tommenna mitteessok Azare'eli'a, labbaxxe oosuwwa isixxeenna;</para>
  <para style="q2" vid="1CH 25:18">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:18">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 25:19" />Tommenna langeessok Hashaabiya'a, labbaxxe isixxe oosuwwa'anna</para>
  <para style="q2" vid="1CH 25:19">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:19">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 25:20" />Tommenna sakkeessok Suba'eli'a, labbaxxe oosuwwa isixxeenna;</para>
  <para style="q2" vid="1CH 25:20">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:20">laakkossi insa'nek tommenna lamekemman.<verse eid="1CH 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 25:21" />Tommenna sholgeessok Metaatiya'a, labbaxxe oosuwwa isixxeenna</para>
  <para style="q2" vid="1CH 25:21">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:21">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 25:22" />Tommenna ondeessok Yirerimoti'a, labbaxxe oosuwwa isixxeenna;</para>
  <para style="q2" vid="1CH 25:22">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:22">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 25:23" />Tommenna jiyeessok Hanaaniya'a, labbaxxe oosuwwa isineenna</para>
  <para style="q2" vid="1CH 25:23">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:23">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 25:24" />Tommenna torbeessok Yoshibaqaasha'a, labbaxxe oosuwwa isixxeenna;</para>
  <para style="q2" vid="1CH 25:24">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:24">laakkossi insa'nekinna tommena lamekemman.<verse eid="1CH 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 25:25" />Tommenna saddeetessok Hanaaniya labbaxxe oosuwwa isixxeeenna;</para>
  <para style="q2" vid="1CH 25:25">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:25">laakkossi insa'nekinna tommemma lamekemman.<verse eid="1CH 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 25:26" />Tommenna salaneessok Melooti'a labbaxxe oosuwwa isixxeenna</para>
  <para style="q2" vid="1CH 25:26">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:26">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 25:27" />Leme tommeessok Eli'ata'a, labbaxxe oosuwwa isixxeenna;</para>
  <para style="q2" vid="1CH 25:27">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:27">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 25:28" />Lame tommenna mitteessok Hooteri'a, labbaxxe oosuwwa isixxeenna;</para>
  <para style="q2" vid="1CH 25:28">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:28">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 25:29" />Lame tommenna langaki Gidooli'anna isixxe labbaxxe oose'a, iittanni tommenna lamiinge isike dayyuwi'a;</para>
  <para style="q2" vid="1CH 25:29">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:29">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 25:30" />Lame tommenna sakkeessok Mahaziyoti'a, labbaxxe oosuwwa isixxeenna;</para>
  <para style="q2" vid="1CH 25:30">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:30">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 25:31" />Lame tommenna sholgeessok Romaneti'ezere'a, labbaxxe oosuwwa isixxeenna;</para>
  <para style="q2" vid="1CH 25:31">mini hado isikee ibe;</para>
  <para style="q2" vid="1CH 25:31">laakkossi insa'nekinna tommenna lamekemman.<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s1">Galmiinxe Hulaka Heqanjuwwa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1" />Galmiinxa hula heqa'neke heqqanjuwwixxa dhaaba: Qorawitotixxe gosanaa'ni; Asaafixxe labbaxxe oosuwwa giddi'ni mitti Qoreki labbak belti Meesulamitemman.<verse eid="1CH 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 26:2" />Meesulaminna labbaxxa oose afeemman;</para>
  <para style="q2" vid="1CH 26:2">siretik Zekkariyasi, langak Yidi'eeli, sakkaki Zebadiya, sholgak Yatini'eeli, <verse eid="1CH 26:2" /><verse number="3" style="v" sid="1CH 26:3" />Ondik Elami, jiyak Yehohanane, torbak Eliyeho'enaayiniten.<verse eid="1CH 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="1CH 26:4" />Oobeedi Edoominna konneechchinn butti'a hexxeexxa labbaxxa oose afeemman;</para>
  <para style="q2" vid="1CH 26:4">siretik Shemaaya, langak Yuzabati, sakkaki Yo'ahi, sholgak Saakare, ondik Natina'el,<verse eid="1CH 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="1CH 26:5" />Jiyak Ami'eli, torbak Yisakoor, saddeetik Pilaati; Magenikinna Oobeedi Edoomii eebiseen.<note caller="-" style="x"><char style="xo" closed="false">26:5 </char><char style="xt" closed="false"><ref loc="2SA 6:11">2 Sam. 6:11</ref>; <ref loc="1CH 13:14">1 Odo. 13:14</ref>. </char></note><verse eid="1CH 26:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="1CH 26:6" />Ittanni belti isiki Shemaya labbaxxa oose afeemman; insa'nenna ege'na lumoxxa anfeemmaxxee ifixxe gosa'n sooreessummat akeenkaamman.<verse eid="1CH 26:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="1CH 26:7" />Shemayaxxi labbaxxi oose; Otini, Rafi'el, Obedi, Elizabadi; firi isik Elihunna Semakiyamiri jabaxxa ege'na anfeemman. <verse eid="1CH 26:7" /><verse number="8" style="v" sid="1CH 26:8" />Kunniir duuchchi Oobeedi Edoomixxe sanne kandaa wodda; insa'nenna kando labbaxxi oose insa'nexxinna firi insa'nek duuchchi huje hujaaxxa jabaxxa ege'na anfeemman. Obedi Edoomixxi sanne madada jaane tommenna lametemman.<verse eid="1CH 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 26:9" />Meesulaami ege'na lomoxxa affeexxa labbaxxa oosenna fira afeemman; laakkossi insa'nekinna 18.<verse eid="1CH 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 26:10" />Meeraarixxe gosana'ninna shoole labbaxxa oose afeemmak Hoosate hinaak manjichchi hedhemman; oose isixxinna siretik Shemeritemman; angafa beltonna kada gophoole midde; anni isik murroonsemman. <verse eid="1CH 26:10" /><verse number="11" style="v" sid="1CH 26:11" />Langak Helqiyaasi, sakkaki Xebaliya, sholgak Zekariyaasi, madadi Hoosa'axxi labbaxxi oosenna mini hadi tommenna sasekemman.<verse eid="1CH 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 26:12" />Galma heqqamakiir mini miniinshann aanchik qoqqoodemmeemman; insa'nenna wele leewwawitoshshann galmi giddo ergatema'neexxa hujetixxa dhaaba anfeemman. <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />Geericho, ka'untichcho midde hinebaang duuchchiinge qixxe hixi ibe.<verse eid="1CH 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 26:14" />Selemiya boroti darrexxa hula heqqaashsha hixi ibe; Okko'ni duuchchi wodda eloke gorsallo kadeeke belti'a Zekkariyasi'a hixa ibinse; hixikinna middixxe hulabaa'ni geye; <verse eid="1CH 26:14" /><verse number="15" style="v" sid="1CH 26:15" />Bita'ixxe hulaki hixi Obedi Edoomi'a geya wodda, miya masse'nammake minik hixi kinn oose isixee geye. <verse eid="1CH 26:15" /><verse number="16" style="v" sid="1CH 26:16" />Sefine'ana Hoosa'a dhidhimi darre'n hedheeke dalla'ixxe hulanna ali darre'ni hedheeke ora'ni Shelekiti hanaaxxe hulake dalla'iba'ni iso'o geye; heqqammake manjichchika hujeti qoobbo dhaabe dhaabemmashan weli abinde hexxemman.<verse eid="1CH 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 26:17" />Barra barra'ninni boroti darre'ni jaane, dhidhimi darre'n shoole, bita'i darre'ni shoole heqqanjuwwa miya masse'namake mini darre'ni lame leewwito mitteba ittanni insa'ne heqqinama edi darree'n weli lame heqqanjuwwi heqqaamman. <verse eid="1CH 26:17" /><verse number="18" style="v" sid="1CH 26:18" />Dhidhimi darre'ni oriinxa duuka hunjeexxe weldena'ni kinn shoole heqqaa wodda; lami weldenanda heqqaamman.<verse eid="1CH 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 26:19" />Yoonna kunni Qorexxinna Meeraarixxi sanne hula heqqitaashsha uwwemeeke hujeti qoobbon.<verse eid="1CH 26:19" /></para>
  <para style="s1">Galminxa Akeekisanonna Wele Jalqaabuwwa</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />Leewwitoti giddi'ni Akiya miya masse'namake mine'ninna Magenoke'e shiqqa'neki qullo'ek miyuwwi bukki hiyye hedhammaka miya masse'na'neke minike sooreessamman.<verse eid="1CH 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21" />Le'adanixxi sannuwwa Le'adani darre'ni Gershoonito kadekaara Gedisonawwitondee Le'adanike mini hadike sooreessuwwa kadeer La'idanixxe sannuwwa konneechchinn butti'a hedheramman; Yihi'eeli, <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" />Yihi'eelixxi labbaxxi oose, Zeetamminna dayyi isik Iyyu'eeli. Kunniir seemmati giissineek Duuchchi Woddike Goottike fooqiba miya massa'nemmake minike sooreessuwwamman.<verse eid="1CH 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 26:23" />Inbermawwitotenaa'ni, Yitsiharwwitotenaa'n, Kebiroonitotenaa'ninna Uuzi'elawwitotixxe sanne'a hujetik qoobbi uwwemeemman.<verse eid="1CH 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 26:24" />Muuseki belti Gershoomixxe sannenaa'n Suba'eeli, miya masse'nammake minike annoome galchaake sooreessamman. <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" />Eli'eezer darre'n firooma afeemmake; belt isik Re'abiya, belti isik Yisha'iya, belti isik Iyoraami, belti isik Zikir, belt isik Seloomiiti, <verse eid="1CH 26:25" /><verse number="26" style="v" sid="1CH 26:26" />Seloomotinna fir isik moyanji Daawwiti mini hado isikike murruwwa, kuma manna akeekisano dhibbi manjik sooreessuwwi ittanni weli sannachchuwwik ajajalluwwi qulloonse shiqinseek miyuwi'a insa'ne qullootteexxe murroolemman.<verse eid="1CH 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 26:27" />Lolake'n boojine a'linemalcho gamisa Duuchchi Woddike Goottike galmixxe qammachcha'a kadaashsha qulloonsine. <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />Wabeekkichcho Saamu'eeli, Qiisik belti Sa'ooli, Neereke belti Abeneer, Tseruyak belti Iyyo'aabi qulloonsineeka duuchchanna ittanni wele qullo'eka miyuwwa Seloominatinna mini hadi heqqe'naamman.<verse eid="1CH 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 26:29" />Yitsiharwwito'n, Kenaaneyanna labbaxxi oose isixxi galmi gadhi darre hexxeexxe wele huje Isira'eeli'n jalqaabuwwakenna hayyoolete baallomme.<verse eid="1CH 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 26:30" />Kebiroonitote'ni, Hashabiya, jabakenna worba kadeek mitte kumanna torbaane dhibba manna Yordaanoosi'ni dhidhimi darre'ni hedheeke Isira'eelike boga'ni Duuchchi Woddike Goottixxe huje'anna moyanjokee ergatematee akeekisanote kande baallomme. <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />Kebiroontotike mini hadixxe ilatike mazigabiinxe aadashshann Yiriya sooreessa insa'nekemman. Daawwitike galchatike baro'ni shoole tomme wogga'ni mazigaba memmekinsemmaxxe'e, Gele'adi giddo Iyyazeeri hinaake booncho'ni Keberoonitotixxe oddo'ni jabak manni leelleen. <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />Yiriyanna jabakenna mini hado insa'nekike akeekisano kadeeka lame kumanna torbaane dhibba aanteti shiqaak firuwwa afeemman. Moyanji Daawwiti konne Magenikenna moyanjiinke hinaaxxe yaane'a Roobeelii, Gaadinna Minaaseke mini hadika gamisa murroonse hariire.<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s1">Sannachchiinka Umo Umo Kuta</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1" />Isira'eelik mini hadik ajajalli, kuma manna ajajammaki, dhibba manjo akeekamma ja'laabi, ittanni wogga duuchcha agenjo agenjo'ninn dhaanba'neexxi umo umo kuta'ni hedhe moyanjo ergatamaki insa'nek akekisanjuwwik summi konneechchinn butti'a hedheen. Mitti mittiinxe kuta'ni lame tommenna shoole kuma manjo hedhemman.<verse eid="1CH 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 27:2" />Siretike agenijo'ni taakkanba hexxeexxe kuta'ni umo kadeek Zabidi'elik belti Yaashobi'amite kadaa wodda isi hunda ergatemaammaki lame tommenna shoole kuma manjo hedhemman. <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />Insa'nenna Faarasixxe sanne kandaa wodda, siretinge agenjo'ni sannachchiinke ja'labuwwi duuchchi'a umokemman.<verse eid="1CH 27:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 27:4" />Langake ageno'ni kuta mitte'ni loliinke umo akeekisanjo kadeeki Ahoohichcho Doodayiten; tenne kutak sooreessi kinn Miqilotineni; isi hunda lame tommenna shoole kuma manjo hedhemman.<verse eid="1CH 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 27:5" />Sakkake agenjo'ni sakaxxe kutak loliink umi ajajalli qeesichcho Yodahek belti Bennayaasitemman; umi isote kadaa wodda isi hunda lame tommenna shoole kuma manjo hedhemman. <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />Kunninna sase tommi irra jabake hunnaameessa, sase tommoke umoman; belti isik Amizabadimi kutatike sannachchike ajajallomman.<verse eid="1CH 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 27:7" />Sholgake agenjo'ni sholgaki umi ajajalli Iyyo'aabik dayyi Asaheeli, bakka isixxe'n wobbinseek belti Zebadiyaten; isi hunda lame tommenna shool kuma manjo hedhemman.<verse eid="1CH 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 27:8" />Ondeesoke agenjo'ni ondik umi ajajalli Yizirawichcho Shemehutiten isi hunda lame tommenna shool kuma manjo hedhemman.<verse eid="1CH 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 27:9" />Jayake agenjo'ni jiyaki umi ajajalli Yetequhawichcho Ye'isik belti Iraasiten isi hunda lame tommenna shoole kuma manjo hedheman.<verse eid="1CH 27:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 27:10" />Torbake agenjo'ni torbak umi ajajalli Efireemixxe gosanaa'ni Filonawichchi Selesiten isi hunda lame tommenna shoole kuma manjo hedhemman.<verse eid="1CH 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 27:11" />Saddeetike agenjo'ni saddeetik umi ajajalli Kazarawichchiinxe gosanaa'ni Huushaki Suusawichchi Siibokayiten isi hunda lame tommenna shoole kuma manjo hedhemman.<verse eid="1CH 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 27:12" />Sallanike agenjo'ni sallanik umi ajajalli Biiniyaamixxe gosanaa'ni Anaatootichcho Abi'eezeriten. Isi hunda lame tommenna shoole kuma manjo hedhemman.<verse eid="1CH 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 27:13" />Tommeessoke agenjo'ni tommik umi ajajalli Kezarawichchiinxe gosanaa'ni Nexoofichchi No'ereten. Isi hunda lame tommenna shoole kuma manjo hedhemman.<verse eid="1CH 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 27:14" />Tommenna mitteessoke agenjo'ni tommenna mitteessok umi ajajalli Efireemixxe gosanaa'ni Phire'atonawichcho Bennaasiten. Isi hunda lame tommenna shoole kuma manjo hedhemman.<verse eid="1CH 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 27:15" />Tommenna langake agenjo'ni tommenna langeessok umi ajajalli Gotoneyalike mini hadinaa'n Nexoofichcho Helidayitemman. Isi hundanna lame tommenna shoole kumma manni hedhemman.<verse eid="1CH 27:15" /></para>
  <para style="s1">Isira'eelike gosatik mini minika akeekisanjuwwa</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 27:16" />Isira'eelike mine minena'n galchatee filemeeke hadiki summi konnechinn butti'a hedheen;</para>
  <para style="q2" vid="1CH 27:16">Roobelika mini hado galchaashsha; Zikirki belti Eli'eezer;</para>
  <para style="q2" vid="1CH 27:16">Sime'onika mini hado galchaashsha; Me'akaki belti Sefaxiyaasi.<verse eid="1CH 27:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 27:17" />Leewwika mini hado galchaashsha; Qemu'elik belti Hashabiya;</para>
  <para style="q2" vid="1CH 27:17">Aaroonika mini hado galchaashsha; Saadooqi.<verse eid="1CH 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 27:18" />Yihudaka mini hado galchaashsha; Daawwitik dayyi Elihu;</para>
  <para style="q2" vid="1CH 27:18">Yisakoorika mini hado galchaashsha; Mika'eelik belti Omiiri.<verse eid="1CH 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 27:19" />Zabilonika mini hado galchaashsha; Abidiyuk belti Yishemaya,</para>
  <para style="q2" vid="1CH 27:19">Nefitaalemika mini hado galchaashsha; Aziri'eelik belti Yaaremuti.<verse eid="1CH 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 27:20" />Efireemika mini hado galchaashsha; Azazirek belti Hoosse'i;</para>
  <para style="q2" vid="1CH 27:20">Minaaseka mini hado gamisa galchaashsha; Fedayak belti Iyyu'eeli.<verse eid="1CH 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 27:21" />Gele'adi hedheeka Minaaseka mini hado gamisa galchaashsha;</para>
  <para style="q2" vid="1CH 27:21">Zakaaryasiki belti Ido, Biiniyaamika mini hado galchaashsha;</para>
  <para style="q2" vid="1CH 27:21">Abeneerik belti Isi'eeli.<verse eid="1CH 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 27:22" />Daanika mini hado galchasha; Yirohamik belti Azare'el</para>
  <para style="q2" vid="1CH 27:22">yoona kunnir duuchchi Isira'eelike mini minike hadike akeekisanjuwwamman.<verse eid="1CH 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23" />Duuchchi Woddik Gootti Isira'eeli'i iimatixxe urjeshsha bira sa'isa'neexxa haaso'emaxxee, Daawwiti wogga insa'nexxi lame tommenna okkoneechchi butta hedhekaara laakko'emmabaan.<note caller="-" style="x"><char style="xo" closed="false">27:23 </char><char style="xt" closed="false"><ref loc="GEN 15:5">Dada. 15:5</ref>; <ref loc="GEN 22:17">22:17</ref>; <ref loc="GEN 26:4">26:4</ref>. </char></note> <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />Tsiriyak belti Iyyo'aabii laakkossa safe muuxebaang gate; konne laakkossiinxe buuto Isira'eel'ni mufe idagemmaxxee, laakko'emeekinna moyanjo Daawwitike mazigaba'ni borreessemebaan.<note caller="-" style="x"><char style="xo" closed="false">27:24 </char><char style="xt" closed="false"><ref loc="2SA 24:1-15">2 Sam. 24:1-15</ref>; <ref loc="1CH 21:1-14">1 Odo. 21:1-14</ref>. </char></note><verse eid="1CH 27:24" /></para>
  <para style="s1">Moyanji Baallonseeka Umo Galchalluwwa</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 27:25" />Adi'eliki belti Azimooti mootummati minika miya massa'neeke minike sooreessamman.</para>
  <para style="p" vid="1CH 27:25">Oziyak belti Yoonataan awuraaja duuchcha'n qachcha qacha'ninn, loola loolake'ninna kollo kollote'n hedheeka miya masse'na'neeke minuwwi'a sooreessakemman.<verse eid="1CH 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 27:26" />Kelubik belti Eziri boga hucca'neeke wiisaluwi'a sooreessakemman.<verse eid="1CH 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 27:27" />Raamatawichchi Semee'i woyinetike hiddichike booncho'ni sooreessakemman; Shefamawichchi Zabidi woyinetike bulbulke miya masse'na'neeke minike sooreessamman.<verse eid="1CH 27:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 27:28" />Gedeerichchi Ba'aalihanaan dhidhimi darrexxe koobuwwa qarqara'n hexxeexxa woyinetanna qilxi haqicho heqqa'neeke sooreessamman; yu'aashi zayiteti minike akeekisanjomman.<verse eid="1CH 27:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 27:29" />Saaroonichchi Sexirayi Saaronii'i marema'neeke horiinke haagani'a sooreessakemman.</para>
  <para style="p" vid="1CH 27:29">Adiilayik belti Shaafaxi dhooqa giddo hedheeke horiinke haagani'a sooreessakemman. <verse eid="1CH 27:29" /><verse number="30" style="v" sid="1CH 27:30" />Isima'elichchi Oobil gaaliinke sooreessamman.</para>
  <para style="p" vid="1CH 27:30">Meronotawichchi Yehidiya harruwwatike sooreessamman.<verse eid="1CH 27:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 27:31" />Haggaarichchi Yaaziziya gedhebiinkenna re'etike haaganike sooreessamman.</para>
  <para style="p" vid="1CH 27:31">Kunniichchuwwi duuchchi moyanjo Daawwiti karra'a sooreessakemmaaran.<verse eid="1CH 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 27:32" />Qalbeeffachcho afeek Daawwitik annik dayyi Yoonataaxxe murranna borreessanjomman; Hakimoonik belti Yihi'eeli kinn moyanjiinke belti'a annomeemman.<verse eid="1CH 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 27:33" />Akixofeel moyanjiinke shiqike gorsallo kadaa wodda, Arkichchi Huushe kinn moyanjiinke jaalomman. <verse eid="1CH 27:33" /><verse number="34" style="v" sid="1CH 27:34" />Bennayak belti Yodaahenna Abiyataar Akixofeelixxe bakka'ni tukkoome.</para>
  <para style="p" vid="1CH 27:34">Iyyo'aabinna moyanjiinke sannachchike ajajallo kade.<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s1">Daawwiti Galma Ijaarate Fulcheexxa Akkeette</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />Daawwiti Isira'eelixxi akeekisano duuchcha Iyyerusaalemi'i bukki hitaashsha ajaje; tennexxee mini miniki sooreessuwwi mootummatixxa huje hujammak ajajalluwwi kuma manjo ajajammaar, dhibba manjo ajajammara, moyanjiinkanna oose isixxika horantemmachcho lalo, gedhebo duuchcha towatammara, ittanni mootummatike minika ja'laabuwwa, goottuwwa loliinka manna duuchcha ye'e.<verse eid="1CH 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2" />Okko'ni moyanji Daawwit uurreexxi insa'ne'e hiyyee qic: «Anke dayyuwwa koo anke arda; ballo ani hiyyaannexxa laqqe. Duuchchi Woddike Goottik kakotiki taabooti hedhaa boonchonna no'oki Mageniinxe lekkaka hadhisanjo ijaaratee hede herregeennan. <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />Mageni kinn ane'e hiyyee qic, ‹Loliink manjo kaddettaxxeenna munde dundeettaxxee, ati summa ankenni mine ijaartabexxon› hiyye.<verse eid="1CH 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4" />«Yaane kinn Isira'eelik Duuchchi Woddik Gootti Mageni Isira'eli'ni duuchchi woddi'a mowaashsha mini hado anke'n duuchchanaa'ni ane'e fi'leen; akeekisanjo kadaashsha Yihudana fi'le; Yihudake mininaa'n anka mini hado file; anikanninne oose giddi'ni kinn Isira'eeli duuchcha ani moyeeke kadona'a eeye. <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />Duuchchi Woddik Gootti heddo oose ani'a uwween; labbaxxe oose anxe duuchchanaa'ni Duuchchi Woddike Goottixxe moote'ni ofo'le Isira'eeli duuchcha'ni mowaashsha kinn belto anka Solomoon'i fi'leen. <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />Hiyyee qic: ‹Isi belto anke kadaashsha aninna anna isike kaddannoshsha fileennaxxee mine ankanna baxxe anxa giissaak atike belto Solomooniten. <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />Isi ta'a assammashsha duuchcha ajaja ankanna seeruwwa anke'n itti jabaate muuxoole, mootumma isixxa duuchchi woddi'a ti'ni hite hexxaashshsa assannon.›<note caller="-" style="x"><char style="xo" closed="false">28:7 </char><char style="xt" closed="false"><ref loc="2SA 7:1-6">2 Sam. 7:1-6</ref>; <ref loc="1CH 17:1-14">1 Odo. 17:1-14</ref>. </char></note><verse eid="1CH 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8" />«Yoona ta'anna konne eloka boga dhaaldino'anna oosuwwa ha'nooxxe'e dhaalchisinaashsha, Duuchchi Woddike Goottika ajaja duuchcha xexxe'achchoti ulfesitinaashsha Isira'eelike ardi edo duuchcha, Magenike ya'i edonna Mageni laqaa'nani ha'noo ajajaannen.<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />«Atinna anke belto Solomoon; Mageni qalbe duuchcha memmekise afammaxxeenna yaada duuchcha ege'neemmaxxee, atike annika Mageno ege'ni; mitte godobinnina eloke yaadinn isi'a ergatemi. Iso'o hassottole ati'a afemaan; waaldottole kinn Isinna ate'e duuchchi woddi'a waalan. <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />Galma ijaartota'a Duuchchi Woddik Gootti atee fi'leexxa ta'anna qaabbat; jabaatte huji.»<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />Okkoo'ni Daawwit galmika buttixxi fawo, kinjii mine, miselcho masse'naaka mine, qeerraaka kinjinka minenna giddaxxa kuta ittanni cubbotixxa gattowwaal alfinaaka booncho leelishaaka kaarta Solomoon'a uwwe. <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />Heggeni woyyichchi Hafuur qalbe isixxe'n uggemmak Duuchchi Woddike Goottike galmixxa baxxe, qarqarke'n hexxeexxa kuta duuchcha, Mageniinke galmike misengeechcho masse'naaka minenna hegeri'a leelishaaka kaarta duuchcha iso'ni uwwe; <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />Ittanni qeesoletikanna leewwitotika hujetika qoobbo, Duuchchi Woddike Goottike mini giddo ergatemme hunjaaxxa hujenna ergatenshatee la'ote insa'ne'a kadaaka miyuwwi duuchchi'a akeette uwwe. <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />Gargarte hexxeexe ergatensha'a kaddaaxxa worqetika miya duuchcha miketi, gargar gargar hexxexxe yaane'a hosaaka birretika sibiljo duuchchixxa mike uwweexxi ege'nishe. <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />Mitti mittinxi torbaniinxi dhanko uutammaxxe la'oshshann worqetixxa dhankonna cunnuchchuwwakeenna kadaaka mitte mittengee worqe miketi, birre sibilji'a kaddaaxxa dhankotanna cunnuchchuwwa birreti sibiljo mike uwwe. <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />Mitti mittinge qullite kebbo uggatee elaaka worqeti beera, wele beeruwwa giissinaaka sibiljo birre mikeexxi uwwe. <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />Ittanni hubbuqanjo qore'a, manqorqorakee, hasisaaka ca'itte worqe; mitti mittinge sibiljo birrexxe qore'a hasisaaka sibiljo birre mike uwwe. <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />Hixaana guphphinaaba tolcha kadaaka ca'itte worqexxi jifo ittanni keeluwwa farri assine Duuchchi Woddike Goottika kakotika taaboota buqqaaxxa worqeti hujendeexxe kurubeele gaaruwwa fakke leelishaaka kaarta iso'ni uwwe.<verse eid="1CH 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19" />Daawwitinna, «Tinni duuchcha ane'ni hedheeke Duuchchi Woddike Goottik Hafuur leellishanna duuchchiinxa yaane hitta hujannoxxa borreessenne; hujetixxa karranna ege'nonaa ani'a qalbefachcho uwwe» hiyye.<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />Higgeenni Daawwit belto ifika Solomooni'i hiyyee qic, «Yoona ke'i jabaati, hujetanna safi. Sodaattoxxe, godoba gurtoxxe: Duuchchi Woddik Gootti anki Mageni atinini hedheen: isinna galmi ijaareme muuxemaaxxee ate'e waalabaan; hunabaan. <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />Magenike galmixxe huje duuchchi'a hasissaaxxa qeesolenna leewwito dhaanbennen. Gargarti hexxeexxa ogetixxe hujexxa ege'na afeeki hujalluwwi manni duuchchi ifixxe eeyanni ate'e gargartaan. Ja'laabuwwinna ardi duuchchi ati'a ajajemaan» hiyye.<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s1">Galma Ijaaratee Shiqqeexxa Uwwa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />Okko'ninna moyanji Daawwiti ya'a duuchcha'n hiyyeeqic; «Mageni fi'leek anki belti Solomoon midda bita'a ege'nebaak oosichchanni hunjaa qico barateekebaan. Kunni jabak kinji mini ijarema'neek manjokete kaddebaang Duuchchi Woddike Gootti Mageni'ate kaddemmaxxee jabaxxe hujen. <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />Aninna horatennexxa karra anke Magenik galmi'a worqet hunjaba worqe, sibiljo birrenni hunjaaba'a sibljo birre, sageettoti hunjaba'a sageetto, sibiljik hunjaaxxe huje'a sibiljo, haqqeti hunjaaxxe huje'a haqqe, ittanni seesinxe huje'a meregidite hiyyemaaka fiixe kinjo, gargarti hexxeexxa kino, elola bifa affeexxa kinonna golalamma kino duuchcha heddoke asse qophpheessedheennen.<note caller="-" style="x"><char style="xo" closed="false">29:2 </char><char style="xt" closed="false"><ref loc="1CH 22:5">1 Odo. 22:5</ref>. </char></note> <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />Konne qophpheessennaxxe yaanuwwa gadho anke Magenike galmi'a afeenexxe lumoxxe jaalalanaa'ni kexxeexxa konne qullo'eke galmi'a konneechchi edo uwweenenge'n itti lebe konne Mageni galmi'a ifi'a horatennake sibiljo birrenna worqe uwwannon. <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />Tinninna dhibba kuma kiilo Ofiirixxa worqenna lame dhibbanna shoole tomme kuma kiilo kaddaaxxi sibiljo birre galmiinka kinjinka dalla'a qammachchateenna, <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />Iittan worqetixxe huje'a, sibiljo birrexxe baqisa'a, ogeti mannixe huje duuchchi'a kaddaaxxen. Eega telcho ifi Duuchchi Woddike Gooti'a tolcha asse uwwaak ayyete?» hiyye.<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />Okko'ni mini hadik sooresuwwi, mini minike hadik Isira'eelike mannik jalqaabuwwi, kuma manjo akeekammakinna dhibba manjo akeekammakiir ittanni moyanjiinxe huje'ni dhaabendeexxi hayyoole ifixxe eeyyanni uune; <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />Mageniinke galmixxe huje'a uunexxi dhibbanna torbaane tomme kuma kiilo iima hexxeexxa worqe, sase dhibbanna shoole tomme kuma kiilo iima kadaaka sibiljo birre, jaane dhibbanna lame tomme kiilo iima geltaaxxa sageettonna sase miliyoonenna shoole dhibba kuma kiilo iima kadaaka sibiljo ifixxe fedhiini uwwate'e mu'line: <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />Fiixxeexxa kino afeeki duuchchi Gershoonichcho Yihi'eeli darre'n Duuchchi Woddike Gootike galmike misechcho massinammake miniba'a e'yishe. <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />Uwwatanna ifixxe eeyaninna mitte godobinni Magenokee shiqeexxe kaddeemmaxxee akeekisanjuwwi isiki hunjeexxe eloxxe hujexxe uwwa'a ardi gammade: moyanji Daawwitinna ittanni gammade.<verse eid="1CH 29:9" /></para>
  <para style="s1">Daawwitixxa Soodachcho</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />Daawwitinna ya'i duuchchi edo Duuchchi Woddika Gootta hiyye saadee qic,</para>
  <para style="q1" vid="1CH 29:10">«Ee, anni no'okike Isira'eelike Duuchchi Woddike Gootta Mageno,</para>
  <para style="q2" vid="1CH 29:10">borokenaa'ni bari qico'ni ati saadenda'ni hedhi.<verse eid="1CH 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11" />Koo Duuchchi Woddike Gootta; iimate'ninna buttate'n hedheechchi duuchchi atingen;</para>
  <para style="q1" vid="1CH 29:11">Lumminni, hunna, ulfinninna gaachchanni atingen.</para>
  <para style="q2" vid="1CH 29:11">Koo Duuchchi Woddike Gootta mootummatinna atinxen;</para>
  <para style="q2" vid="1CH 29:11">Atinna umiinsha duuchchinge iimi darre lummexxeetteken.<note caller="-" style="x"><char style="xo" closed="false">29:11 </char><char style="xt" closed="false"><ref loc="MAT 6:13">Mat. 6:13</ref>. </char></note><verse eid="1CH 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12" />Durummatinna ulfinni uwwema'neek atii'nite;</para>
  <para style="q2" vid="1CH 29:12">Atinna duuchchingike galchallon;</para>
  <para style="q1" vid="1CH 29:12">Lummisatee, duuchchiinge jabeenna uwwatee;</para>
  <para style="q2" vid="1CH 29:12">jabuntenna hunna atixxe anga'ni hexxeen.<verse eid="1CH 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13" />Mageno no'oke; ta'anna atee saandaannen;</para>
  <para style="q2" vid="1CH 29:13">ulfateke atike summi'a ilillisaannen.<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14" />«Yaane kinni Duuchchiinxi atenaa'ni afendeen; ati'anna uunennek atixxe anganaa'ni a'linenageechchon. Iita hexxeexxa arjunte assatee ani ayyete? Ardi ankinna isi honte kade? <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />No'onna edike annuwwishshann ati edo dhoddotishshanna keessummaten; bari no'okinna buttate'ni gaadiddotishshaten; addachchiisa belonna he'naanna. <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />Koo Duuchchi Woddike Gootta Mageno woyyichcha atike summi'a galma ati'a ajaarona'a kunni heddo assine qophpheessinennek duuchchi, atixxe angana'ni afemeekenna madadiing atiken. <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />Anke Mageno; ati qalbe manjiinxa hega uuddattexxanna qajeelumma eettatexxa ege'nennen; aninna tenne duuchcha uwwennek fedhii anxenninna mitte godobinniten. Ta'anna konno'o hedheek ardi atik ifixxe eeyanni hitta uwweexxa uudennen. <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />Koo edike annuwwa no'okike Abirihaamike Yisihaqike, Isira'eelike Duuchchi Woddike Gootta Mageno konne yaada atike ardike godobi giddo baro barokee uggi; qalbe insa'nexxi duuchchi wodda atee addattaashsha assi. <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />Ajajuwwa atika, aadatanna seera heqqedhaashsha, ani isi'a qophpheessenaxxe yaanuwwa'ni lumoka kinjiinka mine ijaaro'a dande'asha anke belto Solomooni'a shenendinni eeti'i isi'a uwween.»<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />Okkoo'ni Daawwiti ya'a duuchcha, «Duuchchi Woddika Gootta ha'nooka Mageno saadde!» hiyye. Tennexxee annuwwa insa'nekika Duuchchi Woddika Gootta Mageno saande. Duuchchi Woddike Goottanna moyanji edo kumbu hine sagande.<verse eid="1CH 29:20" /></para>
  <para style="s1">Solomoon Moyanjo Kadeexa Duuchchinge'ni Ege'nende</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />Langa barixxa gorsa Duuchchi Woddike Gootti'a tolcha tolche; ciincatika tolchanna shiqinshe; kunninna mitte kuma jibootta, mitte kuma gedhebiinxa korbeeyyenna mitte kuma buruusa ittanni ha'winamachchonaa'ninna wele tolchuwwinn welti Isira'eeli duuchchi'a heddo assine shiqinse. <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />Eetene barra'ni Duuchchi Woddike Gootti edo lumoke gammadinni inde; ha'wine.</para>
  <para style="p" vid="1CH 29:22">Okko'ni Daawwitik belti Solomoon moyanjo kadeexxa langaxxe yanna'a ba'lifante egenne; moyanjo kadaasha Duuchchi Woddike Gootti edo hariire; Saadooqinna qeesichcho insa'neke kadaashsha hariire. <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />Konneqicinni Solomooninna mowe anniinxe bakka'ni Duuchchi Woddike Goottixxe moote'n ofo'le; isi'anna qabbe; Isira'eel duuchcha isi'a ajajende.<note caller="-" style="x"><char style="xo" closed="false">29:23 </char><char style="xt" closed="false"><ref loc="1KI 2:12">1 Moy. 2:12</ref>. </char></note> <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />Loliink akeekisanjuwwinna hunnameeyye duuchcha ittanni moyanjo Daawwitixxi labbaxxi oose duuchcha addatensha insa'nexxa moyanjo Solomooni'a kokeesine.<verse eid="1CH 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 29:25" />Duuchchi Woddik Goottinna Solomoon'i Isira'eelike arda duuchcha'ni hara yo'osha lummise; isi edo hexxeexxi Isira'eelixxi mootoleeyye'a uwwendebaaxxa moyanjummatika ulfinna duuchcha isi'a uwwe.<verse eid="1CH 29:25" /></para>
  <para style="s1">Daawwitixxa Rewo</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />Isseyik belti Daawwit Isira'eeli duuchcha'ni mowemman. <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />Isinna Kebirooni torbaane wogga, Iyyerusaalemii sase tommenna sase wogga; mitteba shoole tomme wogga mowe.<note caller="-" style="x"><char style="xo" closed="false">29:27 </char><char style="xt" closed="false"><ref loc="2SA 5:4-5">2 Sam. 5:4-5</ref>; <ref loc="1CH 3:4">1 Odo. 3:4</ref>. </char></note> <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />Durummatinna ulfinni isonaa'ni mishik hiyyebang heddo wogga ture lummedhe; belti Solomooninna bakka isixxe'ni mowe.<verse eid="1CH 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 29:29" />Moyanji Daawwiti galchaamma baro'ni ke'itokenaa'ni miixami qico'ni hujendeexxi huje wabeeka Saamu'eelike jirtetike maxaafa'ni wabeeka Naataanike jirtetik maxaafa'ni, wabeeka Gaadike jirtetike maxaafa'ni borreessemeen; <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />borreessemeekinna mootummate'ni hedhema wodda taakka langa hiyye hujeexxe hujuwa'ninna qarqarake'n buqeeke, Isira'eelikenna wele bogike mootoleeyyetixxe jirtenni weltiten.<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>