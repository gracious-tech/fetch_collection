<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Gedeo Bible</book>
  <para style="h">Lallabiinkaa Maxaafa</para>
  <para style="toc1">Lallabiinkaa Maxaafa</para>
  <para style="toc2">Lallabiinkaa Maxaafa</para>
  <para style="toc3">Lal.</para>
  <para style="mt1">Lallabiinkaa Maxaafa</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Lallabiinke maxaafi giddo hedheeki hiyyichchi manjiinxi hedho harumaaxxe kadatenaa'n saxxe eloossitaaxxennaa mittelchonnabaan, oribeloxxa murtennaa elo bira saxxeexxe kaddeexxa, «Manjiinxi hedho mekkiteten» hiyye qunqumeeke mitte lallaballi manjichchike yaaduwwan. Kunni lallaballi manniinka hedhotika toora towata'neeke Duuchchi Woddike Goottixxa huje ege'na dande'ebaan: Kaddo malee he'naake baro duuchcha'ninna dandeessissaaxxe hunnanni jabaante hujanna Duuchchi Woddike Goottixxe uwwa'ni gammada hasissaaxxa mannake gorsaan.</para>
  <para style="ip">Lallabichchi heddi yaaduwwi weli labbabaxxa uushsho afeekenna mamiinke yaadinni wo'meeken: Kaddo malee kunni Maxaafi Woyyichchi Maxaafi giddo afemaa Woyyichcha Maxaafa'ni hidda oltiteexxi amana wele waalini konne weli lababaaka yaadanna mami wo'meeke Maxaafinni welti abidaa qico'n ba'lake kadeexxa ege'nishaan. Yaane kunni maxaafi manjiinxa hedho da'witetishsha leellishammaxxe heddi manni konne maxaafanaa'n jabeenna alfe'eni: Iittanni kunni yaaduwwi leellisha'neeki, kunni mitti Woyyichchi Maxaafi, hedhotee lumoxxa tika uwwaake Duuchchi Woddike Gootta'n amana assedha dandennaaxxa gorsaake kadeexxa egene'een.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Hedhotixxa tika <char style="ior"><ref loc="ECC 1:1-2:26">1:1—2:26</ref> </char></para>
  <para style="io1">Duuchchiinxe yannate hexxeni <char style="ior"><ref loc="ECC 3:1-8">3:1-8</ref> </char></para>
  <para style="io1">Hedho duuchchiin wodda eldaaxxe kada gophphemmaxxee lallabi hedha <char style="ior"><ref loc="ECC 3:9-6:12">3:9—6:12</ref> </char></para>
  <para style="io1">Edi'a mayi kadaaxxa ege'naaki hedhebaani <char style="ior"><ref loc="ECC 9:1-11:6">9:1—11:6</ref> </char></para>
  <para style="io1">Duuchchi Woddika Gootta ulfeessanna isi'a ajajema <char style="ior"><ref loc="ECC 11:7-12:14">11:7—12:14</ref> </char></para>
  <chapter number="1" style="c" sid="ECC 1" />
  <para style="s1">Yaane Duuchchi Mekki Assitaaxxe Kaddeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1" />Konnechchinni butti'a hedheek haaso'i Iyyerusaalemi moyeemmake Daawwitike beltike lallabiinke hiyyichcho<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Yookaan</char><char style="fqa" closed="false">Ya'iinka akeekisanjo </char><char style="ft" closed="false">Iittanni laakkossa lameke'ninna tommenna lameken</char></note>.<verse eid="ECC 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 1:2" />Lallabichchikinna hiyyee qici,</para>
  <para style="q2" vid="ECC 1:2">«Duuchchiinxi yaane toliinxxeen!</para>
  <para style="q1" vid="ECC 1:2">Mekkinna meqe'e assitaaxxen:</para>
  <para style="q2" vid="ECC 1:2">haranga duuchchiinxi yaane toliinxxen» hiyyan.<verse eid="ECC 1:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ECC 1:3" />Arishshoti butti'a elo'aaxxe yaane duuchcha'ni,</para>
  <para style="q2" vid="ECC 1:3">manji buttate'n huja'n alfaxxi la'o maachcho?<verse eid="ECC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 1:4" />Ila saxxee'naa ila daggaan;</para>
  <para style="q2" vid="ECC 1:4">butta kinni duuchchi woddi'a hexxemmashshanni hexxaan.<verse eid="ECC 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 1:5" />Arishsho fuldaan, e'yitaan;</para>
  <para style="q1" vid="ECC 1:5">Higgenna fuldamaxxe bakkaba higiyyotee wiinandaan.<verse eid="ECC 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 1:6" />Diidallo bita'i'a diidalleessitan;</para>
  <para style="q2" vid="ECC 1:6">middi'aanna diidalleessitan;</para>
  <para style="q1" vid="ECC 1:6">Doote dooteexxi ille iima,</para>
  <para style="q2" vid="ECC 1:6">higgaani.<verse eid="ECC 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 1:7" />Galaaniik wodi'i duuchchi abbaayyatiba'a yaa'aan;</para>
  <para style="q2" vid="ECC 1:7">abbaayya kinni haranga wo'mitabaan;</para>
  <para style="q1" vid="ECC 1:7">Wodi'i illema higeexxi higgeenni</para>
  <para style="q2" vid="ECC 1:7">muummetiba'a wirri hiyyaan;<verse eid="ECC 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 1:8" />Yaane duuchcha gophissa'neexxen;</para>
  <para style="q2" vid="ECC 1:8">tennenaa'n kexxeexxa haaso'akeenna a'urtoten;</para>
  <para style="q1" vid="ECC 1:8">Ille uudde godditabaan; manshatinna laqa waaldabaan.<verse eid="ECC 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 1:9" />Edo kaddemmanxe yaane higgeenna kaddaan;</para>
  <para style="q2" vid="ECC 1:9">ta'anna assenda'neexxi yaane duuchchin wodda assenda'neexxen;</para>
  <para style="q2" vid="ECC 1:9">tennexxe buttate'n haarochcho hiyyemaachchi hedhebaan.<verse eid="ECC 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 1:10" />Manji mitti «Tinni haarooxxe yaanen»</para>
  <para style="q2" vid="ECC 1:10">hiyya dande'aaxxi itteelchinna meya hedhee?</para>
  <para style="q1" vid="ECC 1:10">Kunniichchuwwi qaranni ookkonni hedheechchuwwan;</para>
  <para style="q2" vid="ECC 1:10">no'o edi darrenni hedhemmalchon.<verse eid="ECC 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 1:11" />Edike baro'n kaddeemmaxxaa duuchcha yaane qaabbataak hedhebaan;</para>
  <para style="q2" vid="ECC 1:11">edi'a daggaaxxenna kaddo'o,</para>
  <para style="q1" vid="ECC 1:11">Eettene udumii'n daga'neekiirinna konneechchuwwixxa qaabbataaki hedhebaan.<verse eid="ECC 1:11" /></para>
  <para style="s1">Beekkichchi Galdumakenaa'n Alfeexxa Barachcho</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12" />Ani lallabichchi Iyyerusaalemi giddo moyeennan; <verse eid="ECC 1:12" /><verse number="13" style="v" sid="ECC 1:13" />tenne butta duuchcha'n kadda'neexxa yaane beekkumik qote qo'nise afonna'a mudhdhenne; tinni Mageni manji hujaashsha uwweexxe a'urto hujen. <verse eid="ECC 1:13" /><verse number="14" style="v" sid="ECC 1:14" />Buttate'n hujendeexxa yaane duuchcha uudennen; kaddo malee yaane duuchcha mekki assitaaxxe kaddeexxa afenne; duuchchiinxi yaane diidallo hordofatixxe qixxen.<verse eid="ECC 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 1:15" />Dabeechchi toggi hiyyabaan;</para>
  <para style="q2" vid="ECC 1:15">hedhebaachchi laakko'embaan.<verse eid="ECC 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16" />Ani anke godobi giddo, «Ani edi darre Iyyerusaalemi'i galchemmaker duuchchanaa'n caala lumoo qico beekkichcha manjo kadeennen; beekkumi maachcho kadexxanna ege'neennen; heddo yaanenna barateennen» hiyyeennan.<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="1KI 4:29-31">1 Moy. 4:29-31</ref>. </char></note> <verse eid="ECC 1:16" /><verse number="17" style="v" sid="ECC 1:17" />Ookkoneechchi udum beekkumakanna, ege'na, jajji hiyyotanna gowwumma adda ege'nonna'a mudhdhenne; kaddo malee tinni diidallo hordofatishsha kadde'naa'a afenne.<verse eid="ECC 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 1:18" />Beekkumi birasa'eexxe qixxe'n yaaddo birasaxxaan;</para>
  <para style="q2" vid="ECC 1:18">ege'natinna bira saxxeexxe qixxe'n wixxirriinna lebbaan.<verse eid="ECC 1:18" /></para>
  <chapter eid="ECC 1" />
  <chapter number="2" style="c" sid="ECC 2" />
  <para style="s1">Buttattixxi Gammashsho Mittelchonnabaa</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1" />Ifi gammachchiisonna'anna gammadingi maachcho kadeexxa qote afonnaa mudhdhenne; yaane kinni tinni diidallo hordofati qixxete kaddeexxa afenne. <verse eid="ECC 2:1" /><verse number="2" style="v" sid="ECC 2:2" />Oso'lichchi gowwummatenaa'n woyyo'abaxxa, gammadikinna la'o afebachcho kadeexxa uudenne. <verse eid="ECC 2:2" /><verse number="3" style="v" sid="ECC 2:3" />Beekkumakee'e afeennexxe halchanaa'n kexxexxa woyinetixxe bookanni ifi gammachchisatee gowwumati mudhenenni; manni buttate'n hedheexxe harumaaxxe wogga'n iimati butti'a alfiyyo hasiissaaxxi eloxxi yaane tenne calla kaddeexxa hedenne. <verse eid="ECC 2:3" /><verse number="4" style="v" sid="ECC 2:4" />Iittanni mitte lumoxxa yaane assenneni; tinninna mine ijaadhdhenne; woyinetika hiddichchonna kaalsenne.<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="1KI 10:23-27">1 Moy. 10:23-27</ref>; <ref loc="2CH 9:22-27">2 Odo. 9:22-27</ref>. </char></note> <verse eid="ECC 2:4" /><verse number="5" style="v" sid="ECC 2:5" />Gargar gargar hexxeexxa gumma indaaka haqichchuwwa, daraariinxa haqquwwanna hiddichchuwwa kaasenne. <verse eid="ECC 2:5" /><verse number="6" style="v" sid="ECC 2:6" />Haqquwwate'n ha'wisatee'e wodi'i kofeme hedhaabanna giissenne; <verse eid="ECC 2:6" /><verse number="7" style="v" sid="ECC 2:7" />Labbakanna meyyaka garba hirenne; wele mine aniba ilemeeka garbuwwakanna afeenani; ani edi darre Iyyerusaalemi hedhemmake manni caala heddo lalo, gedhebonna re'e horatenne.<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="1KI 4:23">1 Moy. 4:23</ref>. </char></note> <verse eid="ECC 2:7" /><verse number="8" style="v" sid="ECC 2:8" />Ani galchaannake gargar gargar hedheeke bogixxe mootummaxxa karra duuchcha bukki assedhe'e birretika sibiljonna worqe tuu'lenne; anee faarsitaaxxa labbaxxannaa meelaalle faarsaleeyye qophpheessenne; manjo nigaa birtaaxanna gammachchiissaaxxa yo'oshsha heddo melaalluwwanna bukki assedhenne.<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="1KI 10:10">1 Moy. 10:10</ref>; <ref loc="1KI 14:22">14:22</ref>. </char></note> <verse eid="ECC 2:8" /><verse number="9" style="v" sid="ECC 2:9" />Tennenaa'n kexxeexxa ani edi darre Iyyerusaalemi giddo hedhemmake duuchchingenaa'n sa'e lumoke ulfaateenneke manjo kadenne; beekkumi kinna aniilcho kade gate.<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="1CH 29:25">1 Odo. 29:25</ref>. </char></note><verse eid="ECC 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 2:10" />Ille anxi uudechchonna godobi anki yoreechcho duuchcha alfenne;</para>
  <para style="q2" vid="ECC 2:10">ifi hanqisennexxi gammashshonna hexxebaan;</para>
  <para style="q1" vid="ECC 2:10">Godobi mittinni hujennexxe huje duuchcha'n gammadenne;</para>
  <para style="q2" vid="ECC 2:10">tinninna elo anxike hirammani.<verse eid="ECC 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 2:11" />Hujenexxa huje duuchchanna</para>
  <para style="q2" vid="ECC 2:11">hujete'n hitta elo'ennexxa uudanno wadda</para>
  <para style="q1" vid="ECC 2:11">Duuchchiinxi mittelchonnabaa, diidallo hordofatishshatemman;</para>
  <para style="q2" vid="ECC 2:11">arishshoti butti'a mitte la'onna hexxemmabaan.<verse eid="ECC 2:11" /></para>
  <para style="s1">Beekkumikinna Gowwumma Mittelchonnabaa</para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 2:12" />Ookkoneechchi uduma beekkuma,</para>
  <para style="q2" vid="ECC 2:12">gowwummatennaa jajji hiyya maachcho kaddeexxa</para>
  <para style="q2" vid="ECC 2:12">ege'natee yaada hiissedhenne;</para>
  <para style="q1" vid="ECC 2:12">Edo assendeexxi gadho,</para>
  <para style="q2" vid="ECC 2:12">moyanji uduma dagaak manji maa assa dande'a?<verse eid="ECC 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 2:13" />Ifi dukkanatenaa'n woyyo'ammashsha duuchcha,</para>
  <para style="q2" vid="ECC 2:13">beekkumikinna gowwummatenaa'n woyyo'aaxxa afenne;<verse eid="ECC 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 2:14" />Beekkoole manji haba'a me'aaxxa egendee'en;</para>
  <para style="q2" vid="ECC 2:14">gowwi kinni tenne ege'nebaan</para>
  <para style="q1" vid="ECC 2:14">Yaane kinni beeka manjo kadi gowwooletenna kadoole</para>
  <para style="q2" vid="ECC 2:14">lamiinga heqqita'neexxi yaane mittete kaddexxa wo'menne.<verse eid="ECC 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 2:15" />Tennexxee godobiki</para>
  <para style="q1" vid="ECC 2:15">«Gowwake'n gelta'neexxi ane'ninna geltaan;</para>
  <para style="q2" vid="ECC 2:15">tennexxeeta yo'oshsha beekake kada ani'a maa lebba?» hiyye</para>
  <para style="q1" vid="ECC 2:15">Aninna godobik,</para>
  <para style="q2" vid="ECC 2:15">«Tinni duuchchi mittelchonnabaa!» hiyyenne.<verse eid="ECC 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 2:16" />Beeka manjonna gowwiinshanni lamiinga qeerraaxxe yanna'a qaabbataak hedhebaan;</para>
  <para style="q2" vid="ECC 2:16">dagake baro duuchcha'n duuchchiing dedhemme gantannon.</para>
  <para style="q2" vid="ECC 2:16">Adanaa, beekikkinna gowwiinsha reyo isixxi gattaba!<verse eid="ECC 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 2:17" />Rakko male'e mitte la'onna alfa gophennaxxee hedho anee gibisse; tinni mekki assitaaxxe kaddeemmaxxee'e diidallo hordofat qixxeten. <verse eid="ECC 2:17" /><verse number="18" style="v" sid="ECC 2:18" />Horatennexxa karra anibaa uduma welengee waale me'aanexxee tenne butta'n elo'ennexxa elo duuchcha jibbenne. <verse eid="ECC 2:18" /><verse number="19" style="v" sid="ECC 2:19" />Aniba uduma dagaak beekake kadi gowwake kadi ege'nemmabaan; yaane kinni ani elo'ennexxi beekumik alfennexxa yaane duuchcha adhdheexxi annake kadaan; tinninna mekki assitaaxxen. <verse eid="ECC 2:19" /><verse number="20" style="v" sid="ECC 2:20" />Tennexxee tenne butta'n elo'e hujennexxa yaane duuchcha qalli hiyyanno wodda godoba kultenne. <verse eid="ECC 2:20" /><verse number="21" style="v" sid="ECC 2:21" />Manji afeeke beekuminni, ege'nanninna malinni elo'e hujeechcho duuchcha elo'eebaake manji'a waale sa'aan; tinni mekki assitaaxxenna jabaxxe rakkon. <verse eid="ECC 2:21" /><verse number="22" style="v" sid="ECC 2:22" />Iittate kaddooleta, heda'ninnaa wixxirri hiyya'n sa'issaake baro'n manji elo'eexxi huccachcho duuchchanaa'n maa la'o alfaa? <verse eid="ECC 2:22" /><verse number="23" style="v" sid="ECC 2:23" />Baro isike duuchcha'n hujaxxe yaanena'n yaadotanna gubbachchote malee wele mitte la'onna alfabaan; hashsha midde diipho nage'iinka alfabaan; tinni duuchchanna mekki assitaaxxen.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="JOB 5:7">Iyo. 5:7</ref>; <ref loc="JOB 14:1">14:1</ref>. </char></note><verse eid="ECC 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24" />Yoona manjokee ita ha'watinnaa hucceechcho'n gammadati gadhi darre woyya hiyyendaaxxi yaane hexxebaan; tinni Magenongenaa'n uwwendeexxe kaddeexxa wo'me'ennen;<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="PRO 3:13">Mam. 3:13</ref>; <ref loc="PRO 5:18">5:18</ref>; <ref loc="PRO 9:7">9:7</ref>; <ref loc="LUK 12:19">Luq. 12:19</ref>; <ref loc="1CO 15:32">1 Qor. 15:32</ref>. </char></note> <verse eid="ECC 2:24" /><verse number="25" style="v" sid="ECC 2:25" />Fedhii isixxi gadhi darre ite ha'wa'n ayyete gammadeek? <verse eid="ECC 2:25" /><verse number="26" style="v" sid="ECC 2:26" />Mageni isoo gammachchisaake manji'a beekkuma, eg'natannaa gammashsho uwwaan; cubbaalleessa Mageno gammachchisabaake manji'a kinni karra bukki assatixxannaa tuulatixxa huje uwwaan; tinni duuchchanna mekki assitaaxxen; diidallo hordofatixxe qixxen.<note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="JOB 32:8">Iyo. 32:8</ref>; <ref loc="PRO 2:6">Mam. 2:6</ref>. </char></note><verse eid="ECC 2:26" /></para>
  <chapter eid="ECC 2" />
  <chapter number="3" style="c" sid="ECC 3" />
  <para style="s1">Duuchchiinxee Yannate Hexxeen</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 3:1" />Duuchchiinxee yanna hexxeen;</para>
  <para style="q2" vid="ECC 3:1">Tenne butta'n kaddaaxxe yaane duuchcha'a Mageni mureexxe yanna hexxeen.<verse eid="ECC 3:1" /></para>
  <para style="b" />
  <para style="q2">
    <verse number="2" style="v" sid="ECC 3:2" />Ilemiyyotee yannate hexxeen,</para>
  <para style="q2" vid="ECC 3:2">reyiyyotee yannate hexxeen,</para>
  <para style="q1" vid="ECC 3:2">Kaasiyyotee yannate hexxeen,</para>
  <para style="q2" vid="ECC 3:2">goshiyyotee yannate hexxeen.<verse eid="ECC 3:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="ECC 3:3" />Shiyiyyotee yannate hexxeen,</para>
  <para style="q1" vid="ECC 3:3">Fayyisiyyotee yannate hexxeen,</para>
  <para style="q2" vid="ECC 3:3">ijaariyyotee yannate hexxeen,</para>
  <para style="q2" vid="ECC 3:3">diigiyyotee yannate hexxeen.<verse eid="ECC 3:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="ECC 3:4" />Oodhiyyotee yannate hexxeen,</para>
  <para style="q2" vid="ECC 3:4">ooso'liyyotee yannate hexxeen,</para>
  <para style="q2" vid="ECC 3:4">yaadiyyotee yannate hexxeen,</para>
  <para style="q2" vid="ECC 3:4">sirbiyyotee yannate hexxeen.<verse eid="ECC 3:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="ECC 3:5" />Kino xeeriyyotee yannate hexxeen,</para>
  <para style="q2" vid="ECC 3:5">kino bukki assiyyotenna yannate hexxeen,</para>
  <para style="q1" vid="ECC 3:5">Hanxo'watee yannate hexxeen,</para>
  <para style="q2" vid="ECC 3:5">ha'nxo'wa gophiyyotenna yannate hexxeen,<verse eid="ECC 3:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="ECC 3:6" />hasiyyote'e yannate hexxeen,</para>
  <para style="q2" vid="ECC 3:6">hasa gophiyyoteenna yannate hexxeen,</para>
  <para style="q1" vid="ECC 3:6">Massiyyote'e yannate hexxeen,</para>
  <para style="q2" vid="ECC 3:6">huniyyoten yannate hexxeen,<verse eid="ECC 3:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="ECC 3:7" />daryotee yannate hexxeen,</para>
  <para style="q2" vid="ECC 3:7">hodhdhiyyotenna yannate hexxeen,</para>
  <para style="q1" vid="ECC 3:7">Sammi hiyyoteenna yannate hexxeen,</para>
  <para style="q2" vid="ECC 3:7">haaso'iyyotenna yannate hexxeen,<verse eid="ECC 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="ECC 3:8" />Eeyyiyyotee yannate hexxeen,</para>
  <para style="q2" vid="ECC 3:8">jibbiyyotee yannate hexxeen,</para>
  <para style="q2" vid="ECC 3:8">bagedokee yannate hexxeen,</para>
  <para style="q2" vid="ECC 3:8">nage'akee yannate hexxeen.<verse eid="ECC 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9" />Hujallita, elo'eexxi maa la'o alfaa? <verse eid="ECC 3:9" /><verse number="10" style="v" sid="ECC 3:10" />Manji elo'e hujo'a Mageni uwweeka hujetika a'ure uudenne. <verse eid="ECC 3:10" /><verse number="11" style="v" sid="ECC 3:11" />Mageni yaane duuchcha yanna isexxe'n kaddaashsha seese giissedheen. Manjiinxe sammo giddonna edi'a kaddaaxxa ege'natixxa halcha uggeen; kaddo malee Mageni hujeexxa duuchcha manji sirtenaa'n muuxamii qico'ni ege'nabaan. <verse eid="ECC 3:11" /><verse number="12" style="v" sid="ECC 3:12" />Tennexxee manji hedhotike baro'n eloxxa assatena'ninnaa gammada'n hedhatenaa'n woyya hiyyendaxxi yaane hexxebaaxxa ani wo'meennen. <verse eid="ECC 3:12" /><verse number="13" style="v" sid="ECC 3:13" />Manji ite ha'weexxi elo'e hucceechcho'n gammadaashsha tinni Mageniinxe uwwan. <verse eid="ECC 3:13" /><verse number="14" style="v" sid="ECC 3:14" />Mageni hujeexxi yaane duuchchi, duuchchiin woddi'a hexxaaxxa ege'neennen; ise'n mitte lenbaxxi yookaan isenaa'n hoyyinaaxxi yaane hexxebaan; Mageni tenne asseechchi manji isoo sodato'aten.<verse eid="ECC 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 3:15" />Ta'a hedhechchi edonni hedheechchon;</para>
  <para style="q2" vid="ECC 3:15">edi'a kadachchinna edi wodda hedheechchon;</para>
  <para style="q1" vid="ECC 3:15">Mageni eettene edo dadeemmanxi yaane higgeggeen kaddaashsha assaan.<verse eid="ECC 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16" />Buttate'n higgenna afennexxi yaane,</para>
  <para style="q1" vid="ECC 3:16">Dhugatixxi murte uwwendaammabaanna</para>
  <para style="q2" vid="ECC 3:16">seeriinxi hujendaammabaa fuggoxxi kaddaa'naa afenne.<verse eid="ECC 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 3:17" />Aninna godobi giddo,</para>
  <para style="q1" vid="ECC 3:17">«Assendaaxxe yaane duuchchi'a,</para>
  <para style="q2" vid="ECC 3:17">hujendaaxxe yaane duuchchi'a yanna hexxemmaxxee,</para>
  <para style="q1" vid="ECC 3:17">Mageni qullumma hujaake'ninna fuggoxxa assaake'n mura muraan»</para>
  <para style="q2" vid="ECC 3:17">hiyye hedennen.<verse eid="ECC 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 3:18" />Aninna higgeen hiyye hedenne qici, «Manji, hori, biniinchakenaa'n woyyo'eke kadebaaxxa ifi ege'naashsha, Mageni iso'o hega uuda'neen. <verse eid="ECC 3:18" /><verse number="19" style="v" sid="ECC 3:19" />Manjo heqqita'neexxi yaane hori biniinchixxishshanden; lamiinga mitte yaane heqqita'neen; mitti reya'neeshshanni mittikinna reyaan; lamiingik hafuuri mitteken; manji biniinchakenaa'n woyyo'aaxxi yaane hedha gophphemmaxxee'e lamiingixxi yaane mekki assitaaxxen. <verse eid="ECC 3:19" /><verse number="20" style="v" sid="ECC 3:20" />Manjoke kadi hori biniinchi lamiing mitte boonchi'a me'inaan; kunninna buttinakenaa'n dademmemmaxxee wirri hine'e buttinange'n hingaan. <verse eid="ECC 3:20" /><verse number="21" style="v" sid="ECC 3:21" />Manjiink hafuuri iimi'a me'aaxxannaa hori biinnchik hafuuri kinni butti'a me'aaxxa ayyete ege'ne?»<verse eid="ECC 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ECC 3:22" />Manjo heqqita'neexxi tennende kaddemmaxxe'e manji assaaxxe yaane'n gammada gadhi darre wele assaaxxi yaane hexxebaaxxa wo'menne; reyeechchi udumanna kaddaaxxa yaane ege'naak ayyinna hedhebaan.<verse eid="ECC 3:22" /></para>
  <chapter eid="ECC 3" />
  <chapter number="4" style="c" sid="ECC 4" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1" />Higgeenna buttate'n hujenda'neexxa seeri beloxxa duuchcha afenne;</para>
  <para style="q2" vid="ECC 4:1">miicemeek manni oodha'nemman,</para>
  <para style="q2" vid="ECC 4:1">yaane kinni insa'nee dayyeessaak hedhemmabaan;</para>
  <para style="q1" vid="ECC 4:1">Hunnatinna insa'nee miice galchammakeera'ni hexxemman</para>
  <para style="q2" vid="ECC 4:1">insa'nee dayyeessaakinna hedhemmabaan.<verse eid="ECC 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 4:2" />Tennexxee aninna edi wodda reyeek</para>
  <para style="q2" vid="ECC 4:2">techcho hedhot hedheeke manni mannii'ni</para>
  <para style="q2" vid="ECC 4:2">gammashsho anfeexxa haaso'ennen.<verse eid="ECC 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 4:3" />Yaane kinni konne lamiinge manni erra</para>
  <para style="q2" vid="ECC 4:3">ta'i qico ilemebaak</para>
  <para style="q2" vid="ECC 4:3">tenne butta'n asseneda'neexxa</para>
  <para style="q2" vid="ECC 4:3">fuggoxxannaa miiccama uudebaaka woyya.<verse eid="ECC 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4" />Iitanni manji afeexxe ogenni hitta elo'e huja'neexxa uudenne; iitta assa'neechchi wele manjo hinaafeete kaddeexxanna wo'menne; tinninna mekki assitaxxenna diidallo hordofat qixxeten.<verse eid="ECC 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 4:5" />Da'labi anga mirqedhe ofo'laan</para>
  <para style="q2" vid="ECC 4:5">solo'ik ifi shiyaan.<verse eid="ECC 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 4:6" />Elo'atinna diidallo hordafa labaake yaadinni lumoxxa alfiyyotee hujati mannii'n,</para>
  <para style="q2" vid="ECC 4:6">nageellite sammonni shiixxoka alfiyyotee huja woyya.<verse eid="ECC 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7" />Tenne butta'n wele mekki assitaaxxa yaane afenne;<verse eid="ECC 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 4:8" />Qofitti hedhaaki mitti manjichchi hedheen;</para>
  <para style="q2" vid="ECC 4:8">manji belto yookaan fira afebaake hedheen;</para>
  <para style="q1" vid="ECC 4:8">Kaddo malee duuchchiin wodda hujaan;</para>
  <para style="q2" vid="ECC 4:8">alfeexxi karra isoo dheebo fulchitebaan;</para>
  <para style="q2" vid="ECC 4:8">isinna godobi giddo, «Ani ayyi'aate elo'aanneki?</para>
  <para style="q1" vid="ECC 4:8">Ita ha'wa gophe maayeete ifi qoorsaanek?» hiyye isoo qore:</para>
  <para style="q2" vid="ECC 4:8">tinni duuchcha hara mekki assitaaxxennaa abaratixxe hedhon.<verse eid="ECC 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ECC 4:9" />Mitteba huccinoole eloxxa la'o alfinammaxxee</para>
  <para style="q2" vid="ECC 4:9">mitteke kadati mannii'n lameke kada woyyan.<verse eid="ECC 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 4:10" />Lami giddii'n mitti iboole mitti ke'issaan;</para>
  <para style="q2" vid="ECC 4:10">iboole ke'issaaka afebaak kinni hitta yaadisaake manjo!<verse eid="ECC 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 4:11" />Lami welti diiphoole lamiingi eebbaan;</para>
  <para style="q2" vid="ECC 4:11">mitti qofitti dhiiphoole kinni hitta eebba?<verse eid="ECC 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 4:12" />Mitti manjichchi qofitti mitte manjichchinni lolemoole</para>
  <para style="q2" vid="ECC 4:12">injifataaxxinna hexxeen; yaane kinni lame manjinni lolemoole dande'abaan;</para>
  <para style="q1" vid="ECC 4:12">Sakka assine sirinbe ganneexxi wodaro kutendaba.<verse eid="ECC 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13" />Gorsa adhdhabaake gowwi geerchi moyanji mannii'n beekichcha hiyyeessa dargaggeessa woyya; <verse eid="ECC 4:13" /><verse number="14" style="v" sid="ECC 4:14" />Dargageessi ikki usuriinke minenaa'n moyanjummatiba'a dageeke yookaan hedheemaxxe galcha giddo hiyyummati ilemeeke kada dande'aan. <verse eid="ECC 4:14" /><verse number="15" style="v" sid="ECC 4:15" />Buttate'n hedheek ardi duuchchi moyanjiinxe bakka'n moyemmaka dargaggeessa hordofa'naa afenne. <verse eid="ECC 4:15" /><verse number="16" style="v" sid="ECC 4:16" />Isi edi darre hedhemmak ardik laakkossi ege'nemmabaaken; isi uduma dagaak kinni bakka isixxe'n ofo'leemmaken gammadeba'a; tinni mekki assitaaxxe diidallo hordofatixxe qixxen.<verse eid="ECC 4:16" /></para>
  <chapter eid="ECC 4" />
  <chapter number="5" style="c" sid="ECC 5" />
  <para style="s1">Mageno Sodaat</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1" />Mageni mine'n e'yitatto wodda ifi xexxe'ati; Laqateennaa ajajematee qophphefati; tinni fuggoxxa assa'neexxa ege'nebaak gowwi manni Magenokee uwwaake tolchanaa'n saxxaan.<verse eid="ECC 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 5:2" />Haaso'a muddandoxxe'e;</para>
  <para style="q2" vid="ECC 5:2">Magen edo heene yaanenna haaso'ate</para>
  <para style="q2" vid="ECC 5:2">qalbe atixxenni jarjjartoxxe'e;</para>
  <para style="q1" vid="ECC 5:2">Mageni iima hedheen</para>
  <para style="q2" vid="ECC 5:2">ati kinni butta hexxettaxxee</para>
  <para style="q2" vid="ECC 5:2">haaso'i atik heenoke kadowwaal.<verse eid="ECC 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 5:3" />Hujetixxi birasa'ne oojjo iyyedaggammashsha</para>
  <para style="q2" vid="ECC 5:3">haaso'iinxi bira sa'nenna gowwammatike haaso'a leellishshaan.<verse eid="ECC 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 5:4" />Magenokee werreggottole muuxxeboxxok hekki hitoxxee; boose'a manna'n isi gammada gophammaxxee'e werreega atika muuxi.<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="PSA 66:13-14">Far. 66:13-14</ref>. </char></note> <verse eid="ECC 5:4" /><verse number="5" style="v" sid="ECC 5:5" />Werrege uwwa gophati mannii'n werreega gophiyyo woyyan. <verse eid="ECC 5:5" /><verse number="6" style="v" sid="ECC 5:6" />Afo'i atik cubbote'n atee ibisabaashsha mee kadi; galmiinke erganjo'ninna, «Werreegennek dedhikiten» hitoxxe'e; mayeeta Mageni haaso'a atike'n mufateexxi huccitettelchcho atenaa'n biraa? <verse eid="ECC 5:6" /><verse number="7" style="v" sid="ECC 5:7" />Heddo oojjonnaa heddi haaso'i mittelchonnabaan; tennexxee Mageno sodaati.<verse eid="ECC 5:7" /></para>
  <para style="s1">Durumma Mittelchonnabaan</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8" />Mitti galchalli ifika umiinka galchallo afe'een; konne lamiinga kinni wele uumiink galchalluwwi insa'nee galchammaxxee bogi giddo hiyyeeyye miicendaa'naa, seeri goraa'naa'a, deette ifixxi gophendaa'naaa uuddottole mancira hitoxxee. <verse eid="ECC 5:8" /><verse number="9" style="v" sid="ECC 5:9" />Buttin uwwaaxxi la'o duuchchiingeeten; moyanjikinna umo ifingenninni la'o alfaak fichchakenaa'niten.<verse eid="ECC 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 5:10" />Maallaqa eeyyaak maallaqa goddabaan;</para>
  <para style="q2" vid="ECC 5:10">durumma eeyyaak alfeexxe karra duuchcha'n dheebo fulabaan;</para>
  <para style="q2" vid="ECC 5:10">tinninna mekke assitaaxxen.<verse eid="ECC 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ECC 5:11" />Karra birasaxxeexxe qixxe'n</para>
  <para style="q2" vid="ECC 5:11">isee la'oonfataakinna bira sa'aan;</para>
  <para style="q1" vid="ECC 5:11">Iittate kaddooleta isee illet uuxedha malee</para>
  <para style="q2" vid="ECC 5:11">annakee maa la'o uuta?<verse eid="ECC 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 5:12" />Heenochchonna kadi lumoolchcho itoole</para>
  <para style="q2" vid="ECC 5:12">hujaaliink diiphi isik xe'maken;</para>
  <para style="q1" vid="ECC 5:12">Dureessi manjixxi karra kinni</para>
  <para style="q2" vid="ECC 5:12">diipho isoo kuttaan.<verse eid="ECC 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 5:13" />Buttate'n yo'oshsha yaadissaaxxa fuggoxxa yaane uudenne;</para>
  <para style="q1" vid="ECC 5:13">Tinninna horateeke annixxe miidhema'a qusendeexxe karra.<verse eid="ECC 5:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ECC 5:14" />Yookaan elobaaxxi daggaa baro baxxaaxxe karran,</para>
  <para style="q1" vid="ECC 5:14">Tennexxee beltokanna i'loole</para>
  <para style="q2" vid="ECC 5:14">isi'a sa'issaachcho afaba'a.<verse eid="ECC 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 5:15" />Manji amatike godobanaa'n duwwit ilememmashshanni</para>
  <para style="q2" vid="ECC 5:15">iittanni duwwittinni illee iima higaan.</para>
  <para style="q1" vid="ECC 5:15">Elo'eexxi huccechchinaa'n</para>
  <para style="q2" vid="ECC 5:15">midde mittelchonna anga abixxee iyyedhabaan.<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="JOB 1:21">Iyo. 1:21</ref>; <ref loc="PSA 49:17">Far. 49:17</ref>; <ref loc="1TI 6:7">1 Xim. 6:7</ref>. </char></note><verse eid="ECC 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 5:16" />Tinni kinni yo'oshsha yaadissaaxxe fuggoxxe yaanen;</para>
  <para style="q1" vid="ECC 5:16">Manji dagemmashshanni iittanni ille iima higaan.</para>
  <para style="q2" vid="ECC 5:16">Elo isixxi duuchchi diidallo adhdhiteechchishshate kaddooleta</para>
  <para style="q2" vid="ECC 5:16">la'o isixxi maachcho?<verse eid="ECC 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 5:17" />Jabaxxe wixxirrinni, rakkoni, hifonninna dhibonni</para>
  <para style="q2" vid="ECC 5:17">baro ifika duuchcha dukkanootteexxe hedho giddo hedhaan.<verse eid="ECC 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18" />Yoona, an uudennexxi woyya hiyyendaaxxi yaane manji tenne butta'n hedhaake harumaake baro'n elo'e hujeechcho duuchcha ite ha'wa'n gammadaten; kunni manjokee uwwemeeke qoobbon. <verse eid="ECC 5:18" /><verse number="19" style="v" sid="ECC 5:19" />Mageni manjokee karrannaa qabeenna uwweechchi manji elotika hira alfeexxi ite ha'wa'n gammadaashsha assateeten; tinni Mageninxe uwwan. <verse eid="ECC 5:19" /><verse number="20" style="v" sid="ECC 5:20" />Mageni qalbe isixxe'n gammado uggemmaxxee hedhaake barixxe lumo qico hedabaan.<verse eid="ECC 5:20" /></para>
  <chapter eid="ECC 5" />
  <chapter number="6" style="c" sid="ECC 6" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1" />Buttate'n wele fuggoxxa yaane afenne; tininna manjoke'n yo'oshsha a'urtaaxxen. <verse eid="ECC 6:1" /><verse number="2" style="v" sid="ECC 6:2" />Manji hedeexxa gophaashsha Mageni manjokee karra, qabeennakanna ulfinna duuchcha isi'a uwwaan; Mageni kinni konnechchuwwa'n gammadaaxxa dande'a isi'a uwwebaan; garmajje alagi konnechchuwwa'n gammadaan; tinni mittelchonnabaan yo'oshsha fuggoxxe yaanen. <verse eid="ECC 6:2" /><verse number="3" style="v" sid="ECC 6:3" />Manji mitti dhibba oose i'loole, fedhee qiconna qeerraaxxa wogga hedhoolenna, horateexxe karra'n gammada gophoole reyaa woddanna eloka mooggo alfabaake kadoole; isi mannii'n lubbeme ilemeechcho woyya. <verse eid="ECC 6:3" /><verse number="4" style="v" sid="ECC 6:4" />Ikki lubbeme ilemeechchi mitte la'onna afebaan; dukkana giddi'aanna me'aan; ebeli hiyyemaaka summanna afabaan. <verse eid="ECC 6:4" /><verse number="5" style="v" sid="ECC 6:5" />Arishsho uuda gophoolenna yookaan mittelchchonna ege'na gophoolenna midde ikkichchi ookkone manjichchi caala hafuura adhe'een. <verse eid="ECC 6:5" /><verse number="6" style="v" sid="ECC 6:6" />Tennexxee iikki manjichchi lame kuma wogga hedhoole yaane kinni karra ifixxe'n gammada gophoole lamiingixxi me'a mitte boonchiba'aatebaa?<verse eid="ECC 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 6:7" />Manji duuchchi elo'e hucca godobakeeten;</para>
  <para style="q2" vid="ECC 6:7">kaddo malee kinni goddenne hiyyo ege'nebaan.<verse eid="ECC 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 6:8" />Gowwi manji mannii'n beeki manji caala afe'eexxi la'o maachcho?</para>
  <para style="q1" vid="ECC 6:8">Hiyyeessita ardi giddo galaa qico ege'naa</para>
  <para style="q2" vid="ECC 6:8">isi'a maa la'o uuta?<verse eid="ECC 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 6:9" />Halchati hiremati mannii'n</para>
  <para style="q2" vid="ECC 6:9">anfenechcho'n gammada woyya;</para>
  <para style="q1" vid="ECC 6:9">Tinninna mekki assitaaxenna</para>
  <para style="q2" vid="ECC 6:9">diidallo hordofatixxe qixxen.<verse eid="ECC 6:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ECC 6:10" />Ta'a hedheechchi duuchchi edonni summa afe'eechchon;</para>
  <para style="q2" vid="ECC 6:10">manji maa kadaaxxanna edonni ege'nendeexxen;</para>
  <para style="q1" vid="ECC 6:10">Ifixxe hunna iimi darre hedheeke manjinni</para>
  <para style="q2" vid="ECC 6:10">ayyinna moroma dande'abaan.<verse eid="ECC 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 6:11" />Haaso'i bira sa'eexxe qixxe'n</para>
  <para style="q2" vid="ECC 6:11">mekki assitaaxxi yaane birasaxxaan;</para>
  <para style="q2" vid="ECC 6:11">tinnita manjokee maa la'o affe?<verse eid="ECC 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 6:12" />Manji hedhoti hedhaa wodda gaaddisiinsha sa'aake heenokenna mekki assaake isike baro'n manjokee eloxxa ege'neek ayyete? Yookaan isi reyee udumata buttate'n maachchi kadaaxxa ayyete iso'n kula dande'ata?<verse eid="ECC 6:12" /></para>
  <chapter eid="ECC 6" />
  <chapter number="7" style="c" sid="ECC 7" />
  <para style="s1">Beekkuma</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 7:1" />Eloxxe shitto mannii'n eloka summa woyyan;</para>
  <para style="q2" vid="ECC 7:1">ilenshatixxe barra mannii'n reyotixxa barra woyya.<note caller="-" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="PRO 22:1">Mam. 22:1</ref>. </char></note><verse eid="ECC 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 7:2" />Ite ha'watike mine'n me'ati mannii'n</para>
  <para style="q2" vid="ECC 7:2">yaaddotike miniba'a me'a woyya;</para>
  <para style="q1" vid="ECC 7:2">Reyo manjo duuchchiingee muuxama kaddemmaxee</para>
  <para style="q1" vid="ECC 7:2">Hedhot hedheek tennee godobake'n galchedha hasissaan.<verse eid="ECC 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 7:3" />Yaaddo alba xillisseexxe kaddoolenna qalbe giissitammaxxee</para>
  <para style="q2" vid="ECC 7:3">ooso'lchi mannii'n yaaddo woyya.<verse eid="ECC 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 7:4" />Beekkoleti godobi yaaddotike mine'n hedheen,</para>
  <para style="q2" vid="ECC 7:4">gowwooletik godob kinni gammashshotike mine'niten.<verse eid="ECC 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 7:5" />Gowwooletika sirba laqati manni'n</para>
  <para style="q2" vid="ECC 7:5">beekkoletika xixichcho laqa woyya.<verse eid="ECC 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 7:6" />Gowwiink oso'lchi odoolchoti hundii'ni xaxa'isammaxxe utetixxe haqqeshshaten;</para>
  <para style="q2" vid="ECC 7:6">tinninna mekki assitaaxen.<verse eid="ECC 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 7:7" />Manjo miica beeka manjo hawwi assitaan;</para>
  <para style="q2" vid="ECC 7:7">matta adhdhanna eloka adaba balleesstaan.<verse eid="ECC 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 7:8" />Mitte yaaneke ke'iti irra muuxaa iseka woyyan;</para>
  <para style="q2" vid="ECC 7:8">ifi dukaake manji mannii'n ossaameessa manjo woyya.<verse eid="ECC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 7:9" />Aare gowwiinxe halo fulatike ora kaddemmaxxee</para>
  <para style="q2" vid="ECC 7:9">aare ifinaa'n balleessi.<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="JAS 1:19">Ya'i. 1:19</ref>. </char></note><verse eid="ECC 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 7:10" />Beeki manji qoraake qortuma kada gophemmaxxee,</para>
  <para style="q2" vid="ECC 7:10">«Edike baronaa'n ta'ak mayee woyyo'e» hite qortoxxe'e.<verse eid="ECC 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 7:11" />Beekkumi karratishshanni elolchchon;</para>
  <para style="q2" vid="ECC 7:11">elle isixxinna buttate'n hedheeke manji duuchchi'aaten.<verse eid="ECC 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 7:12" />Maallaqi manjokee buyyote kademmashshanni</para>
  <para style="q2" vid="ECC 7:12">beekkumikinna manjokee buyyoten;</para>
  <para style="q2" vid="ECC 7:12">tennenaa'n ege'na caaldaa qici kinni</para>
  <para style="q2" vid="ECC 7:12">beekkumi isoo afemmake annixxa hedho heqqaten.<verse eid="ECC 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 7:13" />Mageniinxa huje amo hubatte uudi;</para>
  <para style="q1" vid="ECC 7:13">Isi dasseechcho</para>
  <para style="q2" vid="ECC 7:13">ayyete dande'e toggi assa?<verse eid="ECC 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 7:14" />Yaane eldaa wodda gammadi;</para>
  <para style="q2" vid="ECC 7:14">yaane yoxxa wodda kinni</para>
  <para style="q1" vid="ECC 7:14">Mageni mitte yaane asseek</para>
  <para style="q2" vid="ECC 7:14">weletanna assaaxxa hedi;</para>
  <para style="q1" vid="ECC 7:14">Tennexxe manji heger iso'n kaddaaxxa</para>
  <para style="q2" vid="ECC 7:14">ege'na dande'abaan.<verse eid="ECC 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15" />Konnee mekki assaake anke hedhotike baro'n mittelchonna afebaachcho lame yaane uudenne;</para>
  <para style="q1" vid="ECC 7:15">Tinninna qullichchi qullummati ba'aa'naa;</para>
  <para style="q2" vid="ECC 7:15">fuggichchi qeerraaka baro hedha'naa uudenne.<verse eid="ECC 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 7:16" />Tennexxee hara qullichchake kaddoxxe'e;</para>
  <para style="q2" vid="ECC 7:16">hara beekkake kaddoxxe'e;</para>
  <para style="q2" vid="ECC 7:16">mayee ifi shi'witatto?<verse eid="ECC 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 7:17" />Atixxe yanna belo rertaboxxoshsha</para>
  <para style="q2" vid="ECC 7:17">yo'oshsha fuggichchake</para>
  <para style="q2" vid="ECC 7:17">yookaan gowwake kaddoxxe'e.<verse eid="ECC 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 7:18" />Tenne yaane mitteba abidde'e mittetanna wocci assa gopha eloxxen;</para>
  <para style="q2" vid="ECC 7:18">Mageno sodaataaki manji kinni</para>
  <para style="q2" vid="ECC 7:18">yaane duuchcha'n calaqi hiyyotenaa'n gataan.<verse eid="ECC 7:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="ECC 7:19" />Mitte qachcha'n hedheeke tomme galchalluwwi caala</para>
  <para style="q2" vid="ECC 7:19">beekkum beeka manjo hunnaameessake assaan.<verse eid="ECC 7:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ECC 7:20" />Eloxxa calla assa'n haranga cubbo hujabaak</para>
  <para style="q2" vid="ECC 7:20">qullichchi manji buttate'n hedhebaan.<verse eid="ECC 7:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ECC 7:21" />Manji haaso'aaxxa duuchcha dho'o hite laqqoxxe'e</para>
  <para style="q2" vid="ECC 7:21">akimagaada erganji atik atee yowwaa'naa laqqattoxxi hexxaan.<verse eid="ECC 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ECC 7:22" />Heddole atinni umo atingenninni</para>
  <para style="q2" vid="ECC 7:22">wele manna yowwitettexxa atingi godobi ege'ne'eeken.<verse eid="ECC 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23" />Aninna tenne duuchcha beekkuma ankenni kokennexxi,</para>
  <para style="q1" vid="ECC 7:23">«Beekichchake kadonna'a mudhdhenne» hiyyenne.</para>
  <para style="q2" vid="ECC 7:23">Kaddo malee kinni tinni anxe hunna iimi darremman.<verse eid="ECC 7:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ECC 7:24" />Beekkumi yo'oshsha manjiinke hedumi iimi darre</para>
  <para style="q2" vid="ECC 7:24">hedheekeenna bayyateeke kademmaxxee</para>
  <para style="q2" vid="ECC 7:24">beekkuma ayyete koke afa?<verse eid="ECC 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ECC 7:25" />Tennexxee beekkumakanna yaane duuchcha kaddee qico ege'natee qote afateenna qorqorateee,</para>
  <para style="q2" vid="ECC 7:25">fuggichchummatixxa yo'ne,</para>
  <para style="q1" vid="ECC 7:25">Gowwummatixxa maraatumma qalbeefatonna'a</para>
  <para style="q2" vid="ECC 7:25">yaadik wirri hiyyenne.<verse eid="ECC 7:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="ECC 7:26" />Reyoti caalanna qaraarteexxa wel yaane afenne.</para>
  <para style="q2" vid="ECC 7:26">Tinninna meyyaxxixxe fonxoroni;</para>
  <para style="q2" vid="ECC 7:26">meyyaxxi marabetishsha hexxeexxe isexxe jaalalanni labballo fonxorte abidaan;</para>
  <para style="q2" vid="ECC 7:26">isenna lekkatike haachchaba kaddeexxe isexxe hirrenni marxende'e abido'a hassaan;</para>
  <para style="q1" vid="ECC 7:26">Mageno sodaatak manji calli isenaa'ni baaje fula dande'aan;</para>
  <para style="q2" vid="ECC 7:26">cubbichcha manjo kinni ise fonxorte abiddaan.<verse eid="ECC 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ECC 7:27" />Beekkichchi hiyyee qici: Kunnise qorqore afennexxi yaane konnechchinni butti'a hexxeen;</para>
  <para style="q1" vid="ECC 7:27">«Mitte yaaneka mala qorqore afatee'e</para>
  <para style="q2" vid="ECC 7:27">Mitte yaane mittete'n lebba'n,<verse eid="ECC 7:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ECC 7:28" />Qorqorande'n hedhe</para>
  <para style="q2" vid="ECC 7:28">kinni gophennek, kumi labballi giddo mitte eloka manjo afenne;</para>
  <para style="q2" vid="ECC 7:28">konne duuchchi giddo kinni mitte eloxxa manjichcho midde gophenne.<verse eid="ECC 7:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ECC 7:29" />Mitte calla afennexxi yaane</para>
  <para style="q2" vid="ECC 7:29">Mageni manjo dadee wodda eloke asse dadeexxa;</para>
  <para style="q2" vid="ECC 7:29">manji kinni heddo mala male» hiyye.<verse eid="ECC 7:29" /></para>
  <chapter eid="ECC 7" />
  <chapter number="8" style="c" sid="ECC 8" />
  <para style="q1">
    <verse number="1" style="v" sid="ECC 8:1" />Yaane tika dande'aak,</para>
  <para style="q2" vid="ECC 8:1">beeki manjishsha hedheek ayyete?</para>
  <para style="q1" vid="ECC 8:1">Beekkumi manjiinka alba farri asseexxi</para>
  <para style="q2" vid="ECC 8:1">goora ifikanna jijjiiraan.<verse eid="ECC 8:1" /></para>
  <para style="s1">Moyanjokee Ajajem</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2" />Mageni edo kako aaggettaxxee moyanjiinka ajaja ulfeessi; atee hiyya'neen. <verse eid="ECC 8:2" /><verse number="3" style="v" sid="ECC 8:3" />Moyanji edii'n fulatee mudandoxxe'e. Isi eeyyeexxa assa dande'ammaxxee elobaaxxe yaanexxe buuto kaddoxxe'e. <verse eid="ECC 8:3" /><verse number="4" style="v" sid="ECC 8:4" />Moyanjiink hiyyichchi hunna afeeke kademmaxxee iso'o «Maa assitaate?» hiyya dande'aak aate?<verse eid="ECC 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 8:5" />Isi'a ajajemaak ayyinna miidhemaba'a;</para>
  <para style="q2" vid="ECC 8:5">beeki manji yannatanna yaane assendaa gara ege'naan.<verse eid="ECC 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 8:6" />Manjoke'n rakko yo'oshsha tuulendoolenna,</para>
  <para style="q2" vid="ECC 8:6">duuchchiinxi yaane ifixxe yannanna assendaake gara affe.<verse eid="ECC 8:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ECC 8:7" />Heger kaddaaxxa manji ege'na gophammaxxee</para>
  <para style="q2" vid="ECC 8:7">edi'a daggaaxxa aate iso'n kula dande'a?<verse eid="ECC 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 8:8" />Manji diidallo ajajatixxa hunna afebaan;</para>
  <para style="q2" vid="ECC 8:8">ifixxe reyotixxe barra'inna baallooma afeek ayyinna hedheba'a;</para>
  <para style="q1" vid="ECC 8:8">Ayyinna bagediinxa yanna wocci assema dandeessissamabaashshanni</para>
  <para style="q2" vid="ECC 8:8">fuggoxxinna fuggoxxa huccammakara wocci assitabaan.<verse eid="ECC 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 8:9" />Tenne butta'n assendeexxa yaane duuchcha hubatee uudennexxi tenneera duuchcha afenne. Manji manjo miidho'a weleke'n galchalloke kadaaxxe yanna hexxe. <verse eid="ECC 8:9" /><verse number="10" style="v" sid="ECC 8:10" />Iittanni woyyitte bakkaba'a dagammakiirinna okko'n fula'ammakiir fuggichchi manni moogemee'naa afenne; tennee hunjemmake qachchi giddo saadema'nemman; tinninna mekki assitaaxxe yaanen.<verse eid="ECC 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 8:11" />Fuggoxxa hujaake manna'ni iikki woddi murte uwwema gophphoole fuggoxxa huja manjike godoba'n wo'mitaan. <verse eid="ECC 8:11" /><verse number="12" style="v" sid="ECC 8:12" />Cubballeessi manni dhibbale cubbo huje qeerraake baro hedhoolenna Mageno sodaateexxi ulfeessaake manni'a eloxxi kaddaaxxa ege'ne'een. <verse eid="ECC 8:12" /><verse number="13" style="v" sid="ECC 8:13" />Yaane kinni fuggaalleessi manni Mageno sodaata gophaammaxxee bari insa'neek gaadidduffa qeeredhabaan.<verse eid="ECC 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 8:14" />Buttate'n mekki assitaaxxa uudennexxi yaane: qulliyyete'n geltammaxxi fuggaalleeyyete'n, geltammaxxinna qulliyyete'n geltaan. Tinniirinna mekki assitaaxxe yaane hiyyenne. <verse eid="ECC 8:14" /><verse number="15" style="v" sid="ECC 8:15" />Ite ha'watinna gammadati gadhi darre wele woyya hiyyendaaxxi yaane hedha gophphemmaxxee hedhote'n gammada eloxxen hiyyenne. Tennexxee manjokee Mageni tenne butta'n hedho'a uwweeke baro duuchcha'n huccaachcho'n gammadaan.<verse eid="ECC 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16" />Beekkuma ege'nateee hashsha barra diipho gophatixxa tenne buttaxxa manjiinxa hedho hubate uudanno wodda, <verse eid="ECC 8:16" /><verse number="17" style="v" sid="ECC 8:17" />Mageni asseexxa duuchcha afenneni; buttate'n kaddaaxxa ayyinna ege'nabaan; manji qote afatee lumo qico wo'laanolenna yaane hexxee qico ege'na dande'abaan. Beekkichchi manji midde ege'neenne hiyyoolenna yaane hexxee qico qunqume afabaan.<verse eid="ECC 8:17" /></para>
  <chapter eid="ECC 8" />
  <chapter number="9" style="c" sid="ECC 9" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1" />Tennee duuchchaara godoba abixxenne beekkoletinnaa qulliyye insa'ne hunjaaxxi hujenna Mageniinxe anga'n hexxeexxa wo'menne; yaane kinni ayyinna edi'a iso'o heqqaachchi jalalate kaddo yookaan jibbake kaddeexxa egennebaan. <verse eid="ECC 9:1" /><verse number="2" style="v" sid="ECC 9:2" />Qullichchakenna cubbbichcha, elokannaa fuggichchak, batto'eekenna batto'ebaaka, tolcha shiqishakannaa shiqishabaake'n duuchchingik qoobbi heger mitteken.</para>
  <para style="q1" vid="ECC 9:2">Eloke manjo'n kaddammashshanni</para>
  <para style="q2" vid="ECC 9:2">cubbichchake'ninna iittanden;</para>
  <para style="q1" vid="ECC 9:2">Kakatamakeera'n kaddammashshanni</para>
  <para style="q2" vid="ECC 9:2">kako sodaatammakeera'ninna iittanden.<verse eid="ECC 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 9:3" />Tinne buttate'n duuchchinge'n kaddeexxi fuggoxxe yaanen: duuchchiingik qoobbi heger mitteken; tenne'ninni hana manjiinke godoba'n fuggoxxi wo'miteeken; manji hedho hedhe'naanni godobi giddo maraatumma hexxeen; ookkonechchi uduma reyo daggaan. <verse eid="ECC 9:3" /><verse number="4" style="v" sid="ECC 9:4" />Reyeeke neeqi irra lubbo hedheeke wolcho caalan; hedheeke manni giddo hedhaak manji woyyate afe; tinninna<verse eid="ECC 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 9:5" />Lubbo hedheek manni reyaaxxa ege'needheen,</para>
  <para style="q2" vid="ECC 9:5">reyeek kinni mittelchonna ege'na gophemmaxxeeten;</para>
  <para style="q1" vid="ECC 9:5">Qalbeefachcho insa'neexxinna gattemmaxxee</para>
  <para style="q2" vid="ECC 9:5">insa'ne mitte la'onna anfebaan.<verse eid="ECC 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 9:6" />Jalala insa'neexxi, jibba insa'neexxinnaa</para>
  <para style="q2" vid="ECC 9:6">hinaaffe insa'neexxi woldo baxxeen;</para>
  <para style="q1" vid="ECC 9:6">Buttate'n assendaaxxe yaane duuchcha'n</para>
  <para style="q1" vid="ECC 9:6">Ta'anni eelqi'a insa'nee mitte qoobbo anfeba'a.<verse eid="ECC 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7" />Hujettexxe hujenni Mageniin edo elle alfiteettaxxee me'ite gammadda'n itti, woyinetixxa atixxa bookanni gammadda'n ha'wi. <verse eid="ECC 9:7" /><verse number="8" style="v" sid="ECC 9:8" />Duuchchi wodda golalooxxa seemma oddo'wi, zayitetanna umo atike'n issat. <verse eid="ECC 9:8" /><verse number="9" style="v" sid="ECC 9:9" />Mageni tenne butta'n ati'a uwweeke mekkichcha baro duuchcha'n, atike mekkichcha hedhotike sane'n are atixxenni welti gammadi. <verse eid="ECC 9:9" /><verse number="10" style="v" sid="ECC 9:10" />Rertettexxi martaatteke hirreessi giddo hujete kadi hujatee heda, ege'natenna kadi beekkumi hedha gophemmaxxee, anga atixxi affeexxi hujjaaxxa huje duuchcha hunna affettexxe duuchchinni huji.<verse eid="ECC 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11" />Tenne butta'n uudennexxi wele yaane:</para>
  <para style="q1" vid="ECC 9:11">Gongichchi gongaakee,</para>
  <para style="q2" vid="ECC 9:11">loli jannakee kadeeba'a;</para>
  <para style="q1" vid="ECC 9:11">Ita beekkoletee,</para>
  <para style="q2" vid="ECC 9:11">yookaan durumma qarooyyetee;</para>
  <para style="q2" vid="ECC 9:11">yookaan gaachchanni ege'na afeeke kadaba'a;</para>
  <para style="q1" vid="ECC 9:11">Yaane kinni duuchchiinga elobaaxxi yanna alfitaan.<verse eid="ECC 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 9:12" />Iittanni umo ifikixxa yanna ege'naak manji hedheba'a;</para>
  <para style="q1" vid="ECC 9:12">Fonxoroti ci'a dhaphphi</para>
  <para style="q2" vid="ECC 9:12">yookaan marabeti qulxu'muwwa abindammashsha</para>
  <para style="q1" vid="ECC 9:12">Manji keekkatebaangi iso'n daggaaxxe</para>
  <para style="q2" vid="ECC 9:12">fuggoxxi yannanni fonxoremaan.<verse eid="ECC 9:12" /></para>
  <para style="s1">Beekkumi Gowwummatenaa'n Sa'aan</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13" />Iittanni anee mambe'a assisseek tenne butta'n uudenneke fakkeenna beekkumiinken. Isinna: <verse eid="ECC 9:13" /><verse number="14" style="v" sid="ECC 9:14" />Isinna heenok manni giddo hedha'nemmake mitte shiixxooke qachcha hedhemma'a; mitti hunnaameesi moyanji dageexxi konne qachcha dage lole; buqe abidenna qaraqarake'n lumooka gollifachchotika dalla'a ijaare. <verse eid="ECC 9:14" /><verse number="15" style="v" sid="ECC 9:15" />Ookkone qachchi giddo hedha'nemmake mitti hiyyeessi beekkichchi manji, konne qachcha beekkuma ifikenni anjire; yaane kinni ookkone hiyyeessa manjo ayyinna isoo qaabbateba'a. <verse eid="ECC 9:15" /><verse number="16" style="v" sid="ECC 9:16" />Tennexxee ani, «Hunnatenaa'n beekkumi sa'aan» hiyyenne; kaddo malee hiyyeessichchink beekkum tufatemeeke, haaso'i isikinna laqemeba'a.<verse eid="ECC 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 9:17" />Gowwooltike ya'a'ni laqemaake galchanjik canci irra</para>
  <para style="q2" vid="ECC 9:17">beekkichchi manjike hashasha'n haaso'eeke haaso'a laqemaan.<verse eid="ECC 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 9:18" />Beekkumi loliinke miyanaa'n sa'a;</para>
  <para style="q2" vid="ECC 9:18">yaane kinni mitti cubbichchi heddo ellolla yaane balleessa.<verse eid="ECC 9:18" /></para>
  <chapter eid="ECC 9" />
  <chapter number="10" style="c" sid="ECC 10" />
  <para style="q1">
    <verse number="1" style="v" sid="ECC 10:1" />Reyeek tiitichchi shittotixxa fishshe boshshammashshanni</para>
  <para style="q2" vid="ECC 10:1">heenooxxi guwwumma beekkumakannaa ulfinna shollissa.<verse eid="ECC 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 10:2" />Beekkichchi manjik godobi eloxxe yaaneba hedha;</para>
  <para style="q2" vid="ECC 10:2">gowwi manji kinni fuggoxxiba.<verse eid="ECC 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 10:3" />Gowwi ora me'aa wodda dho'ichcha yaado afeba'a;</para>
  <para style="q2" vid="ECC 10:3">hawwawwumma ifixxanna ayye'ninna leellisha.<verse eid="ECC 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 10:4" />Ossa lumooxxa muffe sammi assittammaxxee</para>
  <para style="q2" vid="ECC 10:4">galchalli mufeti ate'n ke'aaxxa yanna</para>
  <para style="q2" vid="ECC 10:4">bakka atixxa wocci assitoxxee.<verse eid="ECC 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 10:5" />Tenne buttate'n uudennexxi fuggoxxe yaane hexxe;</para>
  <para style="q2" vid="ECC 10:5">tinninna galchalli ilaake dedhan.<verse eid="ECC 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 10:6" />Gowwi manni'a lumo qico ulfatteexxi bakka uwwende'naa,</para>
  <para style="q2" vid="ECC 10:6">duureeye kinni hara tuffatendeexxe bakkaxxe kadde.<verse eid="ECC 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 10:7" />Hayyichchuwwa garbiinsha lekkati me'inaa'na</para>
  <para style="q2" vid="ECC 10:7">garbi fadhadoke'n ofo'le me'aa'naa afenne.<verse eid="ECC 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ECC 10:8" />Bale qotaak isonde giddo iba;</para>
  <para style="q2" vid="ECC 10:8">gimotanna diigaaka bofake idda.<verse eid="ECC 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 10:9" />Kinjo goggo'mishaaka ookkone kinjo isoo miidha;</para>
  <para style="q2" vid="ECC 10:9">jirmakanna daraaka jirmi iikki isooe miidhebaaki gatabaan.<verse eid="ECC 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 10:10" />Duudek meesani</para>
  <para style="q2" vid="ECC 10:10">qarema gophoole,</para>
  <para style="q1" vid="ECC 10:10">Manjo hunna bira;</para>
  <para style="q2" vid="ECC 10:10">baredumma kinni hujetixxe gumma'a geessissa.<verse eid="ECC 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 10:11" />Bofi atee iddeechchi uduma bafiinxi doodda,</para>
  <para style="q2" vid="ECC 10:11">doochchalloke'e mitte lo'onna hexxebaan.<verse eid="ECC 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ECC 10:12" />Beeki manjike afo'onaa'ni fulaak haaso'i ulfaateeken;</para>
  <para style="q2" vid="ECC 10:12">gowwa kinni afo'o ifinge isoo balleessa.<verse eid="ECC 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 10:13" />Gowwi manji haaso'a gowwummati safeexxi</para>
  <para style="q2" vid="ECC 10:13">fuggoxxe maraatummanni muuxa.<verse eid="ECC 10:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ECC 10:14" />Gowwi manji haaso'a bira sa'issa.</para>
  <para style="b" vid="ECC 10:14" />
  <para style="q1" vid="ECC 10:14">Mayi dagaaxxa ayyinna ege'naba'a;</para>
  <para style="q2" vid="ECC 10:14">isi uduma kaddaaxxa ayyi iso'n kuluta?<verse eid="ECC 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 10:15" />Gowwa umo ifingixxe huje iso'o kurbu assita;</para>
  <para style="q2" vid="ECC 10:15">qachchiinba'a me'aaka oranna ege'neba'a.<verse eid="ECC 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ECC 10:16" />Koo, moyanji atik oose kade'eeke</para>
  <para style="q2" vid="ECC 10:16">ja'laabuwwi atikiirinna soodeeshshanni ite ha'waake boga atike aanne'e!<verse eid="ECC 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 10:17" />Koo, moyanji atik eloke hadonaa'n ilemeeke,</para>
  <para style="q2" vid="ECC 10:17">machcheteete kadebaangi uduudakee</para>
  <para style="q2" vid="ECC 10:17">seeriinxe yanna'n ite ha'waaka ja'laabuwwa affe'etteke atike bogixxa wodo!<verse eid="ECC 10:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ECC 10:18" />Manji boose'ake kadoole mini isikixxi heellichcho huruffi hitaan;</para>
  <para style="q2" vid="ECC 10:18">anga mirqedhemmaxxeenna mini isik xissa.<verse eid="ECC 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 10:19" />Ite ha'wa oso'lichcho iyyedaggaan,</para>
  <para style="q2" vid="ECC 10:19">woyinetixxi bookanna ha'waaka hedho ifinxee assita;</para>
  <para style="q2" vid="ECC 10:19">maallaqi hedhoole yaane duuchcha hexxe.<verse eid="ECC 10:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ECC 10:20" />Haaso'a atika ci'a iimixxi,</para>
  <para style="q2" vid="ECC 10:20">keelik me'itaaxxi marteexxi hitettexxa kuldaaxxe hexxeeni</para>
  <para style="q1" vid="ECC 10:20">Goli giddo midde moyanjo cee'mitoxxe'e;</para>
  <para style="q2" vid="ECC 10:20">diiphphettexxe taqe'ninna hexxe'e dureessa yowwitoxxe.<verse eid="ECC 10:20" /></para>
  <chapter eid="ECC 10" />
  <chapter number="11" style="c" sid="ECC 11" />
  <para style="s1">So'iinxe Bulleexxa Kebbo Wodi'ini Hana</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 11:1" />Heddo barra uduma higgee'naa alfitaattaxxee</para>
  <para style="q2" vid="ECC 11:1">kebbo atixa abbaayyate'ni darbi.<verse eid="ECC 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 11:2" />Buttate'n daggaaxxa ba'ne ege'na'a gophphettaxxee</para>
  <para style="q2" vid="ECC 11:2">karra atixxa torbaane bakka yookaan saddeetaba'a uggi.<verse eid="ECC 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 11:3" />Duumanchi xilledheexxi raachcho'oole</para>
  <para style="q2" vid="ECC 11:3">buttate'n xeena gansiisaan.</para>
  <para style="q1" vid="ECC 11:3">Haqichchi middake'n yookaan bita'ake'n iboole</para>
  <para style="q2" vid="ECC 11:3">ookko ibeemba hedhaan.<verse eid="ECC 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 11:4" />Diidallo heqqedhaak facaalsabaan;</para>
  <para style="q2" vid="ECC 11:4">duumancha uudaakinna haamabaan.<verse eid="ECC 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 11:5" />Diidallotika ora egendaboxxoshshanni yookaan</para>
  <para style="q2" vid="ECC 11:5">hedho hafuur amati godobi giddo hitta finnakee kadeexxa egendeboxxoshshanni</para>
  <para style="q1" vid="ECC 11:5">Duuchchiinxa dande'aake Magenixxa huje</para>
  <para style="q2" vid="ECC 11:5">ege'na dandeettaboxxo.<verse eid="ECC 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 11:6" />Hiine gumma gummissaaxxa ege'na gophphttaxxee gorsa sanne facaalsi</para>
  <para style="q2" vid="ECC 11:6">galgalanna anga atixxa mirqexxoxxe'e;</para>
  <para style="q1" vid="ECC 11:6">Tinni lattuu, itti lattuu,</para>
  <para style="q2" vid="ECC 11:6">yookaan lamiinxi eloxxe kadduu egendeboxxon,</para>
  <para style="q2" vid="ECC 11:6">galgalanna anga atixxa mirqexxoxxe'e;<verse eid="ECC 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 11:7" />Ifi eloochchon,</para>
  <para style="q2" vid="ECC 11:7">arishsho uushshonna ille gammachchiissa.<verse eid="ECC 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 11:8" />Fedhee qiconna manji heddo wogga hedhooti hedhoole</para>
  <para style="q2" vid="ECC 11:8">tenne wogguwwa duuchcha'n gammaduun;</para>
  <para style="q1" vid="ECC 11:8">Kaddo malee daga'neek dukkanatik bari birasa'eeke kademmaxxee,</para>
  <para style="q2" vid="ECC 11:8">isoo heduun.</para>
  <para style="q2" vid="ECC 11:8">Dagga'neexxi yaane duuchcha mittelchonnabaan.<verse eid="ECC 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 11:9" />Koo dargaggeessa atixxe dargaggeessuma'n gammad;</para>
  <para style="q2" vid="ECC 11:9">dargaggeessumma atixxike baro'n qalbe atixxi gammadduun;</para>
  <para style="q1" vid="ECC 11:9">Godobi atiki hedheexxa, ille atixxinna uuddaachcho duuchcha hordofi;</para>
  <para style="q2" vid="ECC 11:9">yaane kinni tenne yaane duuchchiinxee</para>
  <para style="q2" vid="ECC 11:9">atee Mageni murtetiba'a iyyedagaaxxa ege'n.<verse eid="ECC 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 11:10" />Tennexxee ka'umummatinna dargaggeessumma maachchonnabaan;</para>
  <para style="q2" vid="ECC 11:10">wixxi hiyya qalbe atixxi giddii'ni bayyisi;</para>
  <para style="q2" vid="ECC 11:10">fuggoxxa yaanenna ifinaa'ni fugussi.<verse eid="ECC 11:10" /></para>
  <chapter eid="ECC 11" />
  <chapter number="12" style="c" sid="ECC 12" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 12:1" />Wixixxi hiyyatixxi barra daggebaangi;</para>
  <para style="q2" vid="ECC 12:1">«Anee gammachchiissa'nebaan»</para>
  <para style="q1" vid="ECC 12:1">Hitattoxxe wogguwwa shiqqebaangi</para>
  <para style="q2" vid="ECC 12:1">atixxe dargaggeessummatixxe yanna'n</para>
  <para style="q2" vid="ECC 12:1">atee dadeeka qaabbat.<verse eid="ECC 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 12:2" />Arishshotinna ifinni</para>
  <para style="q2" vid="ECC 12:2">agenjikinna urjuwwa dukkandeebaangi,</para>
  <para style="q2" vid="ECC 12:2">duumanchuwwikinna xeeni uduma higebaangi;<verse eid="ECC 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 12:3" />Miniink heqqanjuwwi culphisaa wodda,</para>
  <para style="q2" vid="ECC 12:3">jajjabbuwwi xukkaa wodda</para>
  <para style="q2" vid="ECC 12:3">hee'no'matenaa'n kexxeexxa daltammaxxi melaalle huje uurrissaa wodda,</para>
  <para style="q2" vid="ECC 12:3">masikotetenaa'n uudammakeerixxi ille siphpi siphphi hitaa wodda;<verse eid="ECC 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 12:4" />Weldeenatibaa fulchaak oruwwi cufemaa wodda,</para>
  <para style="q2" vid="ECC 12:4">daama dayatik hafuuri laqisa gopha'n me'aa wodda,</para>
  <para style="q1" vid="ECC 12:4">Manji ci'atixxe wocanni dammaqaa wodda,</para>
  <para style="q2" vid="ECC 12:4">kinni faarsitammaxxe dubartek canci laqisa gopha'n me'aa wodda;<verse eid="ECC 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 12:5" />Koobuwwa qabata sodaachchisse'e</para>
  <para style="q2" vid="ECC 12:5">ora me'anna culphisiissaa wodda;</para>
  <para style="q1" vid="ECC 12:5">Lawuzetik haqichchi daraare'na'a</para>
  <para style="q2" vid="ECC 12:5">koro'miis ifi shirri assa'n me'aa'naa</para>
  <para style="q2" vid="ECC 12:5">halcha baxxaa wodda,</para>
  <para style="q1" vid="ECC 12:5">Eettene yanna manji duuchchi woddike ifike miniba'a me'aa wodda</para>
  <para style="q2" vid="ECC 12:5">oodhaak manninna ora ora'ni mammaremaan.<verse eid="ECC 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 12:6" />Birretike sibiljik haachchabi ta'ebaang edi ga'ma</para>
  <para style="q2" vid="ECC 12:6">worqeti giissemeek sahininna eenqemebaangi</para>
  <para style="q1" vid="ECC 12:6">Wode'e ikkilatik waabi muummeti qarqara'n reyebaangi,</para>
  <para style="q2" vid="ECC 12:6">wode'e ikkilaaxxi wodaronna baletinna huruffebaangi,<verse eid="ECC 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 12:7" />Buttini buttina dagemangibaa illee iima higebaangi</para>
  <para style="q2" vid="ECC 12:7">hafuurikinna isoo uwwemmake Magenibaa illee iima higebaangi</para>
  <para style="q2" vid="ECC 12:7">atee dadeeka qaabbati.<verse eid="ECC 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 12:8" />Lallabichchi, «Yaane duuchchi mekki mekkitte</para>
  <para style="q2" vid="ECC 12:8">duuchchiinxi mekki assitaaxxen» hiyye.<verse eid="ECC 12:8" /></para>
  <para style="s1">Yaanetixxa Qunqumensha</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9" />Lallabichchi, beekkuma calla kadebaak ardake'n ege'na barsiisa'nemmakemman; isinna jaba qico heda'n yaane qote qo'nise; heddo mammaassuwwanna bukki asseexxi seerake'n ofo'lishe. <verse eid="ECC 12:9" /><verse number="10" style="v" sid="ECC 12:10" />Lallabichchi xe'maaka hiyyichchuwwa afiyotee, qote qo'nise'e borreesseexxi, eloxxenna dhugaatemman.<verse eid="ECC 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 12:11" />Lallabichchi haaso'i allalisano hore ooffammaxxe qeerraxxe siqqoshshaten; mitteba bukki assemeeke hiyyichchuwwinna miselcho mitteba gobbe abiddemmaxxe mismaaruwwashshaten; kunni hiyyichchuwwinna mitte allalisanjonaa'n uwwemeeken. <verse eid="ECC 12:11" /><verse number="12" style="v" sid="ECC 12:12" />Anke beltoo! Konneechchi duuchchi iimi darre wele yaanenaa'n xexxe'at; mitte yaanenna tenneera'ni lebboxxe'e.</para>
  <para style="p" vid="ECC 12:12">Heddo maxaafuwwa borreesse muuxa dandeessissabaan; lumo qico qote qo'nisatinna biso kurbi assitaan.<verse eid="ECC 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 12:13" />Yoona yaane duuchchi laqqende'een; yaane duuchchixxi qunqummensha:</para>
  <para style="q2" vid="ECC 12:13">tinni manjiinke beltixxe wo'ma hujen,</para>
  <para style="q2" vid="ECC 12:13">Mageno sodaati, seera isikanna heqqedhi.<verse eid="ECC 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 12:14" />Eloxxe kaddo'o fuggoxxa</para>
  <para style="q2" vid="ECC 12:14">sho'ondeexxe yaane duuchcha, mittetinna gattebaangi</para>
  <para style="q2" vid="ECC 12:14">huje manjiinxa duuchcha Mageni murtetibaa iyyedagaan.<verse eid="ECC 12:14" /></para>
  <chapter eid="ECC 12" />
</usx>