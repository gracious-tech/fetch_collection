<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="DAN" style="id">- Gedeo Bible</book>
  <para style="h">Daani'eelikaa Raaga</para>
  <para style="toc1">Dani'eelikaa Raaga</para>
  <para style="toc2">Dani'eelikaa Raaga</para>
  <para style="toc3">Dan</para>
  <para style="toc1">Daani'eelikaa Maxaafa</para>
  <para style="mt1">Daani'eelika Raaga</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Daani'eelik Raaga borreessemeeki Yihudiink ardi Mageno ege'nebaake moyanjiinxe galcha hunda lumoki shorrichchininna miiccami insa'ne'n geye'naa'a wixixxi hinaammaxxe yannamman. Konnee maxaafik borreessaanji leelliteexxe waleellana'ninna jirtenaa'ni afendeexxe hujuwwaake ke'injini eettene yanna'ni hedheeka arda dayyeesan. Magen konee miice galchallo fugusseexxi arda ifikee luminne hiissaaxxa insa'nee addachchiisa'neeni.</para>
  <para style="ip">Kunni maxaaf lame umoke kaddeexxa kuttuwwa afe'eeni, taakaxxi Daani'eelinna isinni welti baqa'ne hedheemmaki heenok manni Magenoke'n afeemmaxxe jabaaxxe amananna insa'ne isi'aa anfeexxi ajajenshanni naaphi insa'neki shookeexxa kuldaaxxe jirten; tinni jirtenna muuxendeeki Baabiloonkenna Faarisike moyanjuwwike baro'niteni. Langaaxxinna Daani'eeli'ni leeliteexxe gargar garga hexxeexxe waleela kadda wodda, tinni waleelanna Babilooni'ni saffe'e gargar gargar hedheeki moyanjuwwi baalomakena'ni iba'ninna ke'a'neexxa Mageno ege'nebaak galchanji ba'ee'naa Magenki ardi ifike bireke boonchibaa higaaxxa fakkeenniki leelliteexxeni.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Daani'eelinna sase jaaluwwa isika <char style="ior"><ref loc="DAN 1:1-21">1:1-21</ref> </char></para>
  <para style="io1">Moyanji Nabukenetsoorixxa oojjoteexxa oojo <char style="ior"><ref loc="DAN 2:1-49">2:1-49</ref> </char></para>
  <para style="io1">Sidiraaqi, Misraaqinna Abidinaago Mageni ha'yita'neexxe giira giddii'n anjireexxa <char style="ior"><ref loc="DAN 3:1-30">3:1-30</ref> </char></para>
  <para style="io1">Nabukenetsoori torbaane wogga'a moote ifixxa gopheexxa <char style="ior"><ref loc="DAN 4:1-37">4:1-37</ref> </char></para>
  <para style="io1">Moyaanjo Belshaatsoorinna gimote'ni borreessendeexxa borro <char style="ior"><ref loc="DAN 5:1-31">5:1-31</ref> </char></para>
  <para style="io1">Magen Daani'eelii'i neenqakenaa'n anjireexxa <char style="ior"><ref loc="DAN 6:1-28">6:1-28</ref> </char></para>
  <para style="io1">Daani'eelii uudeexxa shoole biniichixxa waleella <char style="ior"><ref loc="DAN 7:1-28">7:1-28</ref> </char></para>
  <para style="io1">Daani'eeli'n leelliteexxa gedhebiinke korbeessixxanna re'etike korbeessixxa waleella <char style="ior"><ref loc="DAN 8:1-27">8:1-27</ref> </char></para>
  <para style="io1">Daani'eel ardakee soodateexxa soodachcho <char style="ior"><ref loc="DAN 9:1-27">9:1-27</ref> </char></para>
  <para style="io1">Daani'eel Xeegirosike galaani bira Mageniinka Eriganjo uude <char style="ior"><ref loc="DAN 10:1-11:45">10:1—11:45</ref> </char></para>
  <para style="io1">Udumika baro <char style="ior"><ref loc="DAN 12:1-13">12:1-13</ref></char></para>
  <chapter number="1" style="c" sid="DAN 1" />
  <para style="s1">Daani'eelinna Jaaluwwi Ifiki Baabilooni Mootummatike Mine'ni</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 1:1" />Yihudak moyanji Iyyo'aaqemi moyeexxe sakkaxxe wogga'n Baabiloonik moyanji Nabukedentsoori Dageexxi Iyyerusaalemi buqe.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 24:1">2 Moy. 24:1</ref>; <ref loc="2CH 36:5-7">2 Odo. 36:5-7</ref>. </char></note> <verse eid="DAN 1:1" /><verse number="2" style="v" sid="DAN 1:2" />Dada duuchchiki Goottinna Yihudiinka moyaanjo Iyyo'aaqeminna Mageninke galmi giddo hedheemmaka heenoka miyuwwa Nabukedentsoorixxe anga'ni sa'isse uwwe. Moyajinna konne miyuwwa iyyemareexxi ifike magenike mine'n Babilooni miya massinammake mini giddo ugge.<verse eid="DAN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 1:3" />Ookkoneechchi uduma moyaanji mootummatike minike ja'laabuwwike sooressa kadeeka Ashifenazi Isira'eeltotenaa'n booji'emek manni giddii'ni moyanjuwwinke mini hadonaa'ni ilendeexxe dargageeyye giddii'ni heenoxxa iyyedagaashsha ajaje. <verse eid="DAN 1:3" /><verse number="4" style="v" sid="DAN 1:4" />Insa'nenna bisoke'n fafa afebaake danchallamma, heene barachchonna baratatixxa danende'a anfe'ekenna, beekkuma anfe'eka, hirbange'n qalbeeffata dande'aakanna moyanjiinke moyetike mine'n ergatematee'e dandeette affe'eexxa labbaxxe dargageeyyen. Baabiloonitotika laagadanna borrotixxa aada insa'ne barsiisaashsha iso'o ajaje. <verse eid="DAN 1:4" /><verse number="5" style="v" sid="DAN 1:5" />Moyanjikinna barra barra'n indaaxxi itana ha'winaaxxi woyinetixxi booka moyanjiinxe qorenaa'n kaddaashsha ajaje; insa'nenna sase wogga baranteechchi uduma moyaanjiinxe ergatensha'n e'yino'aaten. <verse eid="DAN 1:5" /><verse number="6" style="v" sid="DAN 1:6" />Insa'ne giddii'ni Yihuda'ni dangeek Daani'eeli, Hanaaniya, Misa'eelinna Azaaryatemman. <verse eid="DAN 1:6" /><verse number="7" style="v" sid="DAN 1:7" />Kolaasemeeke mannik sooresi insa'ne'a haaroka summa fulche: Daani'eeli'i Bilxaasoor, Hanaaniya'a Sidiraaqi, Misa'eeli'i Misaaqi, Azaarya'a Abidinaagote hiyye fulche.<verse eid="DAN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 1:8" />Daani'eelinni moyanjiinxa itanna woyinetixxa booka ha'we ifi battoosabaashsha mudhdhe; isinna konne orinni ifi battoosabaashsha kolaasemeeke mannika sooresa eeti'i uwwo'a laqedhe. <verse eid="DAN 1:8" /><verse number="9" style="v" sid="DAN 1:9" />Mageninna Daani'eeli'a kolaasemeeke mannike sooressuwwi edo gaachchannakanna elle alfaashsha asse. <verse eid="DAN 1:9" /><verse number="10" style="v" sid="DAN 1:10" />Kaddo malee'e kolaasemeeke mannik sooressi Daani'eeli'a «Ita ittineexxi wele dargageeyye caala huqqatine'na'a afoole moyanji ank gootti ane'e shiyaashsha assitineen.» <verse eid="DAN 1:10" /><verse number="11" style="v" sid="DAN 1:11" />Ookkonneechchi uduma Daani'eelinna kolaasemeeke mannika sooressanna Hanaaniya'a, Misa'eeli'ninna Azaariyyaa heqqaashsha uggeemaka hiyyee qici, <verse eid="DAN 1:11" /><verse number="12" style="v" sid="DAN 1:12" />«Ballo maganneten hiddichchuwwa inda'ninna wode'e ha'wina'n he'nannoshsha assite no'oo erganjuwwa atika tomme barra'a hega uudi. <verse eid="DAN 1:12" /><verse number="13" style="v" sid="DAN 1:13" />Ookkonneechchi uduma no'oka albanna moyanjiinxa ita itteexxe dargageeyyeka alba welti qixxeessi; no'o atike erganjuwwa'ni eettetexxa assi» <verse eid="DAN 1:13" /><verse number="14" style="v" sid="DAN 1:14" />Kolaasemeeke mannik sooressinna Daani'eeli hiyyeeka yaada aadheexxi tomme barra'a insa'ne hega uude.<verse eid="DAN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 1:15" />Tomme barra uduma moyanjixxa ita ittemmaxxe wele dargageeyye caala insa'ne eloxxe fayyanni he'ne furdante leelline. <verse eid="DAN 1:15" /><verse number="16" style="v" sid="DAN 1:16" />Tennexxee heqqanji insa'ne itiyyo hasissammaxxa filendeexxa itanna woyinetixxa booka gatiseexxi isexxa bado hiddichuwwa indo'a uwwe.<verse eid="DAN 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 1:17" />Magenkinna tenne shoole dargageeyye'a duuchchinxe borroxxanna barachchoxxa ege'nannna qalbeeffachcho insa'ne'aa uwwe; Daani'eelinna duuchchiinxe waleellaxxanna iittanni oojjo tikatixxa uwwa afe'emman.<verse eid="DAN 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 1:18" />Isibaa dangaashsha moyanji muremmaxxi sase wogga muuxxendee wodda kolaasemeeke manniki sooressi insa'nee Nabukedentsoori edo shiqishe. <verse eid="DAN 1:18" /><verse number="19" style="v" sid="DAN 1:19" />Moyanjinna insa'ne yaansise wodda insa'ne giddo Daani'eelishsha Hanaaniyashsha, Misa'eelishshanna Azaariyaa hedheekir hara afemebaan; tennexxee insa'ne moyanjokee ergatemate'ni ke'ne. <verse eid="DAN 1:19" /><verse number="20" style="v" sid="DAN 1:20" />Moyanji insa'ne qoreexxa duuchcha beekumakanna qalbeefachcho uudaaxxe yaane duuchchanni isi galchammake boga duuchcha'ni afemaake morammakeera'ninna doochchammake duuchchana'ni insa'ne tomme anga caalleexxa afe. <verse eid="DAN 1:20" /><verse number="21" style="v" sid="DAN 1:21" />Daani'eelinna moyanji Qiroosi moyeexxe siretixxe wogga qico'n ookkon ture.<verse eid="DAN 1:21" /></para>
  <chapter eid="DAN 1" />
  <chapter number="2" style="c" sid="DAN 2" />
  <para style="s1">Nabukedenetsoorxa Oojjo</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 2:1" />Nabukedentsoori moyeexxe langaxxe wogga'n oojjo oojjote; uudemmaxxe oojjo'ni alayyeemmaxxee dhiiphi isoo abixxa gibe. <verse eid="DAN 2:1" /><verse number="2" style="v" sid="DAN 2:2" />Tennexxee isiba dangeexxi isi oojjotemmaxxa oojjo kullaashsha moramakiir, gojammakiir, diginte daggamammakiirinna urje laakko'ammakaara ye'emmaashsha moyanji ajaja sa'isse; insa'nenna dangeexx isi edo uurrine.<note caller="-" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="GEN 41:8">Dada. 41:8</ref>. </char></note> <verse eid="DAN 2:2" /><verse number="3" style="v" sid="DAN 2:3" />Moyanjikinna insa'ne'a «Oojjo oojjo'teenan isexxa tika ege'nonna'a lumo qica yaadik wixxirri hiyyenne» hiyye.<verse eid="DAN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 2:4" />Ookkoneechchi uduma urje laakko'ammakiir moyanjoke'n Aramayike laagadinni, «Moyanjo ati no'o'a lubbo gali! Oojjottettexxa oojjo no'oo erganjuwwa atike'n kuli ati'a tinkannon» hine.<verse eid="DAN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 2:5" />Moyanjikinna urje laakko'ammakeera'n hiisse hiyye haaso'ee qici, «Eettene oojjonna isexxa tika ane'ni kula gophphinoole kochchiisendine'naa'a minuwwi ha'nokinna oletixxe tuulo kadaashsha murennen. <verse eid="DAN 2:5" /><verse number="6" style="v" sid="DAN 2:6" />Yaane kinni eettene oojjonna isexxa tika ane'n kuldinoole uwwatanna gica lumooka ulfinnanna anenaa'n alfitinaan; tennexxee eettene oojjonna ane'ni kulle; iseenna ani'a tikke.»<verse eid="DAN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 2:7" />Insa'ne hiissineexxi, «Moyanjoo! Oojjo atixxa no'oo erganjuwwa atike'ni kuli; no'onna tika isexxa ate'ni kullanon» hine haasonne.<verse eid="DAN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 2:8" />Moyanjikinna hiisseexxi insa'ne'a hiyye haaso'ee qici, «Ani mudhdhenexxa jabaxxa murte egendineemmaxxee yanna qeerrisate'e hassina'neexxa ane'n aagge'een. <verse eid="DAN 2:8" /><verse number="9" style="v" sid="DAN 2:9" />Eettene oojjo ane'ni kula gophphinoole mitte bifaxxe mura woxa ha'noo heqqitaan; tinni yaane jijjiirendaaxxe hitine hediyyot dedhiinkanna fuggichcha yaada ane'ni kuldino'a weli aaggine'eni; tennexxee oojjo eettene'e ane'ni kulle; tika isexxanna ane'ni kula dandeettina'neexxa tennenni ege'nannon.»<verse eid="DAN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 2:10" />Urje laakko'amakiirinna moyanjoke'n hiissine hinee haasonee qici, «Moyanjoo! Ati qortetteke qortumi'a dande'e hiissichcho hiissaak manji tenne butta'ni afemabaan! Huuni moyanjinna hoonee qiconna lumokenna hunnaamessa kadoolenna iitta hexxeexxa yaane moraaka, doochchaaka, yookaan urjuwwa laakko'aakaara qore ege'nebaan. <verse eid="DAN 2:10" /><verse number="11" style="v" sid="DAN 2:11" />Moyanjoo! Ati qorta'ettek qortum hara rakkisaaken; manjiinke beltixxe oddo'n hedhabaake magenuwwa malee'e ayyinna tennee oojjo moyanjokee'e tikaaki hedhebaan.»<verse eid="DAN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 2:12" />Tinninna moyanjo yo'oshsha aare gubate; Baabiloon giddo hexxeexxa beekkole duuchchanna shiyendaashsha ajaje. <verse eid="DAN 2:12" /><verse number="13" style="v" sid="DAN 2:13" />Beekkole duuchchanna shiyendaashsha ajaji fule; Daani'eelinna isika jaaluwwanna hanse shinnaashsha manni ergeme.<verse eid="DAN 2:13" /></para>
  <para style="s1">Eettene Oojjoxxa Tika Magen Daanili'eeli'n Leellishsheexxa</para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 2:14" />Moyajiinke heqqanjuwwik ajajalli Aryooki Baabiloonixxa beekkole shiyo'a dagee wodda Daani'eeli isiba mareexxi beekkumikinna maliki isoo'o yaansiise <verse eid="DAN 2:14" /><verse number="15" style="v" sid="DAN 2:15" />Isinna moyanjiinka ja'laaba Aryookii'i, «Moyanji konne wiinameeka ajaja mayee fulaashsha asse?» hiyye qore; Aryokinna tenne yaane Daani'eeli'n ifise.<verse eid="DAN 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 2:16" />Eettene yanna Daani'eelinna e'yeexxi eettene oojjo isi'a tiko'a yanna isi'a uwwendo'a moyanjo qore. <verse eid="DAN 2:16" /><verse number="17" style="v" sid="DAN 2:17" />Ookkoneechchi uduma Daani'eelinna ifike minibaa ille iima higeexxi ifika jaaluwwa Hanaaniyya'n, Misa'eeli'ninna Azaarya'n yaane ifise kule. <verse eid="DAN 2:17" /><verse number="18" style="v" sid="DAN 2:18" />Isinna isike wele jaaluwwi gatemmaxxe Baabiloonixxe beekkolenni welt mitteba shiyemabaashsha iimik Mageni insa'ne'a mararo'anna eettene buqo yaane ifiso'a soodantaashsha ege'nishe. <verse eid="DAN 2:18" /><verse number="19" style="v" sid="DAN 2:19" />Eetteneen hashsha iitti buqo yaane waleellati Dani'eeli'n iffe; Dani'eelinna iimika Mageno saada'ni hiyyee qici,<verse eid="DAN 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="DAN 2:20" />«Beekkumikinna hunna isixxe kaddeemmaxxee</para>
  <para style="q2" vid="DAN 2:20">Mageniink summi duuchchi woddi'a saademowwaal!<verse eid="DAN 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="DAN 2:21" />Isi yannatanna sanne jijjiira</para>
  <para style="q2" vid="DAN 2:21">moyanjuwakanna mootete'n ofo'lishaani; ookko'ninna dirisa;</para>
  <para style="q2" vid="DAN 2:21">isinna beekkuma beekkoletee ege'natanna qalbefataakeeri'a uwwa.<verse eid="DAN 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="DAN 2:22" />Isi xilki hite sho'ondeexxa yaane ifisa; dukkanate'n hedheechcho ege'na;</para>
  <para style="q2" vid="DAN 2:22">ifikinna isinni welti hedhaani.<verse eid="DAN 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="DAN 2:23" />Anke edike annuwwike Magnoo! Atee galateeffata'ennen; atee saada'enneni;</para>
  <para style="q2" vid="DAN 2:23">atee qorennexxa yaane ane'n ege'nishetten,</para>
  <para style="q2" vid="DAN 2:23">beekkumakanna hunna ani'a uutetteni;</para>
  <para style="q2" vid="DAN 2:23">moyanjiinxa oojjo no'o'a tikketteni.»<verse eid="DAN 2:23" /></para>
  <para style="s1">Daani'eel Eeettene Oojjo Tike</para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 2:24" />Ookkoneechchi uduma Daani'eeli Baabilonixxa beekkole shiyyendaashsha moyaanji ajaja uwweemmake Aryookibaa mareexxi iso'n «Baabiloonixxa beekkole shiltoxxe'e; moyanjinbaa anee iyyemar; aninna oojjo isixxa isi'a tikannon» hiyye.<verse eid="DAN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 2:25" />Aryookinna rakeexxi Daan'ieelii'i moyanjo Nabukedenetsoori edo shiqisheexxi, «Moyanjoo! Atixxa eettene oojjonna isexxa tika ati'a ifisaaka booji'emeeke Yihudiinke manninaa'n mitte manjo afeenneni» hiyye.<verse eid="DAN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 2:26" />Moyanjikinna Bilxasoor hiyyemeeka Daani'eelii'i, «Oojjotennexxa oojjonna isexxa tika ane'ni kula dandettatto?» hiyye qore.<verse eid="DAN 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 2:27" />Daani'eelinna hiyyee qici, «Moyanjoo! Ati qortettexxa buqo yaane beekkole yookaan moraakiir, yookaan faro uudaakiir yookaan gojaakiir moyanji laqeexxa buqo yaane tika ati'a dande'aak hedhebaani. <verse eid="DAN 2:27" /><verse number="28" style="v" sid="DAN 2:28" />Yaane kinn buqo yaane duuchcha ifisaak Magen iima hedheeni; isinna dagaake baruwwa'ni kaddaaxxa yaane duuchcha atee moyanjo Nabukedenetsoori'ni leellishe'een; ati taqete'n diiphphee'naa sammo atixxi giddo hexxemmaxxi oojjonna waleella konnechchi butta hexxeexxen.<verse eid="DAN 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 2:29" />«Moyanjoo! Taqete'n diiphphe'naa atixxi sammo edi'a kaddaaxxa yaane heddamman; buqo yaanek ifisallinna edi'a kaddaaxxa yaane ate'ni leellishe. <verse eid="DAN 2:29" /><verse number="30" style="v" sid="DAN 2:30" />Tinni buqo yaane ani'a iffeeki ani wele manninaa'ni lumooka beekuma afennexxeetebaani; yaane kinni moyanjoo, atixxe oojjoxxa tika egendotta'anna atixxe sammo giddo heddaattaxxi yaane maachcho kaddeexxa qalbeefattota'aaten.<verse eid="DAN 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 2:31" />«Moyanjoo! Ati edo heenobaaxxa cala cala hita'neexxanna hara sodaachchisa'neexxa misile uurrite'naa affetten. <verse eid="DAN 2:31" /><verse number="32" style="v" sid="DAN 2:32" />Tenne Misilek umi, luqqitte worqeke, isixxi qomanna hirre biretike sibljinni, isek godobinna hidhi iseki sageetotike sibljinni hujemeekemmani. <verse eid="DAN 2:32" /><verse number="33" style="v" sid="DAN 2:33" />Tafuwwi isikinna sibljiinke, isixxi lekkuwwanna gamisi sibljinxenna gamisi faariik hujendeexxe. <verse eid="DAN 2:33" /><verse number="34" style="v" sid="DAN 2:34" />Ati tennee misile uudande'n hexxxee'naa manjiinxi anga tuqqebaangi mitti kinji fottoqeexxi faarinxanna sibljinxa isexxa lekkuwwa ganeexxi bulleesse. <verse eid="DAN 2:34" /><verse number="35" style="v" sid="DAN 2:35" />Eettenne yanna'ni iikkki siblji, iikki faari, iikki sageettotik siblji, iikki birretik sibljinna iitti worqe mittenba bulloottexxi aldummete'ni hedhemmake bonike huura kadde; diidallotinna mittechchonna gatissebaang huura ookkone filte adhdhite; yaane kinni eettene misile ganemmak kinji lumooxxe kooba kadeexxi butta duuchcha wo'me.<verse eid="DAN 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 2:36" />«Iitti oojjo tennetemman; ta'a tika isexxanna atee moyanjoke'n kullaannen. <verse eid="DAN 2:36" /><verse number="37" style="v" sid="DAN 2:37" />Moyanjoo! Ati moyanjuwwiinke moyanjon; iimiki Mageni mootummatanna baallooma, hunnatanna ulfinna ati'a uwwe'eeni. <verse eid="DAN 2:37" /><verse number="38" style="v" sid="DAN 2:38" />Manjinxa sanne, biniichakanna ci'a duuchcha anga atixxe'ni sa'isse uwween; kunnichchuwwi hoone booncho'ninna hedheexxe kaddoole atee isi konne duuchchingike galchallo assedheen; yoona ati worqetike umo ookkoneten.<verse eid="DAN 2:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="DAN 2:39" />«Ati uduma atenaa'n shiixxexxaaxxi wele mootumma mootaan; itti aandeexxi iitti sageettotike sibljinni fakkeessendeexxi, sakkaxxi mootumma butta duuchcha'n moottaan. <verse eid="DAN 2:39" /><verse number="40" style="v" sid="DAN 2:40" />Udumixxe yanna'ni yaane duuchcha enqe bulleessammake jabake siblishsha hexxeexxi sholgaxxi mootumma moottaan; sibili duuchchingechcho enqe bulloossammashsha ise edi darre hexxemmaxxa mootummuwwa duuchcha enqitee bulloosittaan. <verse eid="DAN 2:40" /><verse number="41" style="v" sid="DAN 2:41" />Iitti lekkuwwanna qubba gamisi faara gimisi sibilo kaddee'naa uuddeteshanni iittanni qoqqoodendeexxe mootumma kaddaan; yaane kinni faarikinna sibil makemee'naa uuddetteshshanni tinni mootumma gamisa sibliinke jabeenna affaan. <verse eid="DAN 2:41" /><verse number="42" style="v" sid="DAN 2:42" />Iitti lekkatixxi qubba gamisi faara gamisi sibilo kaddemmashshanni tinni mootumma gamisi jabaxxe, gamisi shaqqqaxxe kaddaan. <verse eid="DAN 2:42" /><verse number="43" style="v" sid="DAN 2:43" />Sibil faarik makemee'naa uuddetteshshanni ardikinna makemeeke kadaan; yaane kinni sibil faarik weli abixxammabaashshanni ardi mittummati mitteba hedhabaan.<verse eid="DAN 2:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="DAN 2:44" />«Tenne mootumuwwake baro'n, iimik Magen haranga baxxabaaxxa wele manni'anna saxxe uwwendabaaxxa mootumma uurrisaan; isenna wele mootummuwwa duuchcha bulleessiteexxi booso balleessitaan; yaane kinni ise umo ifikenni duuchchi woddi'a hexxaan. <verse eid="DAN 2:44" /><verse number="45" style="v" sid="DAN 2:45" />Manjiinxi anga tuqqebaangi koobatenaa'n fottoqeexxi siblo, sageetotika siblo, birretika siblonna worqe bulleessemmake ookkone kinjixxe leellaxxi tika tenneten.</para>
  <para style="p" vid="DAN 2:45">«Lumoki Mageni edi'a kaddaaxxa atee moyanjoke'n leellisheen; iitti oojjonna dhugaatixxen; tika isexinna addatendeexxen.»<verse eid="DAN 2:45" /></para>
  <para style="s1">Moyanji Daani'eeli'a Badhaaseka Badhaadha</para>
  <para style="p">
    <verse number="46" style="v" sid="DAN 2:46" />Ookkoneechchi uduma moyanji Nabukedenetsoor Dani'eel edo albik gonbisemeexxi Daani'eeli'a sagade; isonna ulfeesseexxi tolchikinna hixaan isi'a uwwemaashsha ajaje. <verse eid="DAN 2:46" /><verse number="47" style="v" sid="DAN 2:47" />Moyanjikinna Daani'eelii'i, «Tenne buqo yaane tika dandeetteetten, dhugaandinni ha'nok Magen magenuwwiinke Magenonna moyanjuwiinke dada duuchchike Gootta, buqo yaaneke ifisallon» hiyye. <verse eid="DAN 2:47" /><verse number="48" style="v" sid="DAN 2:48" />Ookkoneechchi uduma moyanji Daani'eeli luumoxxe baalloomiinxe bakka'n ofo'lisheexxi heddo lumollamma uwwa isi'a uwwe; duuchchinge Baabiloonike awuraajjike galchallonna isoo asse; Baabiloonixxe duuchchiinxe beekkole hananna isoo sooreessake asse. <verse eid="DAN 2:48" /><verse number="49" style="v" sid="DAN 2:49" />Daani'eelike qortuminni moyanji Sidiraaqii'i, Misaaqiinna Abidenaago'o duuchchinge Babiloonike awuraajike galchalluwwa asse baalloonse; Daani'eel kinni moyanjiinke mootommatike mini'ne offo'le.<verse eid="DAN 2:49" /></para>
  <chapter eid="DAN 2" />
  <chapter number="3" style="c" sid="DAN 3" />
  <para style="s1">Worqetixxa Misilenna Gooliinxa Giira</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 3:1" />Moyanji Nabukedenetsoor ejjuma jaane tomme ciqile, godoba jaane ciqilexxa worqetixxa misile giissiseexxi Baabiloonike awuraaja'n Duurake diida'ni uurrise. <verse eid="DAN 3:1" /><verse number="2" style="v" sid="DAN 3:2" />Ookkonneechchi uduma ja'laabuwwa, jalqabuwwa, boginka galchalluwwa, gorsalluwwa, miya massinammake minika sooressuwwa, hayyichchuwwa, wele seerinka muxxalluwwanna awuraaja awuraaja'n hedheeka jalqabuwwa duuchcha uurriseemmaxxe misilexxe eebbatike ayyaani'a dangaashsha ye'e. <verse eid="DAN 3:2" /><verse number="3" style="v" sid="DAN 3:3" />Ja'laabuwwi, jalqabuwwi boginka galchalluwwi, gorsalluwwi, miya massinammake minik sooressuwwi, hayyichuwwi, wele seerink muxxalluwwinna awuraajja awuraajja'n hedheeka jalqabuwwa duuchcha moyanji Nabukedenetsoor uurriseexxe misilexxe eebbatike ayyaani'a bukki hineexxi misilet edo uurrine.<verse eid="DAN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 3:4" />Ookkonneechchi uduma lallabammak qonqo gikki asseexxi hiyyee qici, «Koo arda, gosa gosakenna gargar hedheeka laagada haasottinaak duuchchi: <verse eid="DAN 3:4" /><verse number="5" style="v" sid="DAN 3:5" />Malagatiinkanna inbiltiinka masinqotikanna kiraariinka, baganiinkanna suusu'letika iittanni sirbi duuchchika hafuura laqinaa wodda moyanji Nabukedenetsoor uurseexxe eettene worqetixxe misile'a kumbu hitine sagade. <verse eid="DAN 3:5" /><verse number="6" style="v" sid="DAN 3:6" />Kumbu hiyye sagadabaak huun manjinna hedheexxe kaddoole ille iima goolendeexxe giirake bubenji giddo hunemaan.»<verse eid="DAN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 3:7" />Tennexxe malagatinkanna inbiltiinka, masinqotikanna kiraariinka, baganiinkanna suusu'letika sirbi duuchchika hafuuranna laqee wodda iikki woddi ardi duuchchi, moottummuwwatinna gargar gargar hedheeka laagada haaso'aak manni moyanji Nabukedenetsoor uurriseexxe eettene worqetixxe misile'a kumbu hiyye sagade.<verse eid="DAN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 3:8" />Eettene yanna Baabiloniki manni edi'a dageexxi Ayihudoota ku'le. <verse eid="DAN 3:8" /><verse number="9" style="v" sid="DAN 3:9" />Insa'nenna moyanjo Nabukedenetsoori'i hinee qici, «Moyaanjo! Ati lubbo gali! <verse eid="DAN 3:9" /><verse number="10" style="v" sid="DAN 3:10" />Moyaanjo! Ati malagatinka inbiltinka masinqotika, kiraarinka, baganinka, suusu'letikanna sirbi duuchchika hafuura laqeek duuchchi eettene worqetixxe misile'ni kumbu hine sagada hasissaan. <verse eid="DAN 3:10" /><verse number="11" style="v" sid="DAN 3:11" />Ayyinna butta wabbi hiyye eetene worqetixxe misile'ni sagada gophoole goolendeexxe giirake bubeno'ni hunemaan. <verse eid="DAN 3:11" /><verse number="12" style="v" sid="DAN 3:12" />Kunse Baabiloonike awuraajji giddo galchate'n uggitettek Ayhudoot Sidiraaqi, Misaaqinna Abidenaago ajaja atika mitteechcho hanqisa'neen; magenuwwa atike ergatema'neba'a ati uurrisettexxe eetene worqetixxe misilenna sagandabaan.»<verse eid="DAN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 3:13" />Moyanji Nabukedenetsoorinna lumoxxe aarenni Sidiraaqi, Misaaqinna Abidenaago ye'iseen; insa'nenna moyanji edo dange. <verse eid="DAN 3:13" /><verse number="14" style="v" sid="DAN 3:14" />Naabukedenetsoorinna insa'ne hiyyee qici, «Koo Sidiraaqi, Misaaqinna Abidenaago! Ha'no anke magenuwwa'ni ergatema gophanna uurrisennexxe misile'a sagada gopha tinni dhugaate? <verse eid="DAN 3:14" /><verse number="15" style="v" sid="DAN 3:15" />Yoona ta'a malagatinka inbiltinka masinqotika kiraarinka, lumoka kiraara, suusu'letikanna sirbi duuchchi hafuura laqqina wodda ani uurrisennexxe eetene worqetixxe misele'a wabbi hitineexxi sagadineele eloxen: sagada gophphinoole kinni iikki woddi goolendeexxe giiratike bubeno'n hunendinaan; anga anxenaa'n ha'no'o anjira dande'aak hoone mageno?»<verse eid="DAN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 3:16" />Sidiraaqi, Misaaqinna Abidenaago moyaanjoke'n hinee qici, «Moyaanjoo! Tenne yaane uudaaxxenni ifinaa'n faachcheffatatee no'o hissichcho ati'a hissa hasisabaan. <verse eid="DAN 3:16" /><verse number="17" style="v" sid="DAN 3:17" />Moyanjoo! Goolendeexxe giirake bubeno'n hunemonnole iikki ergatemaannek Magen isenaa'n no'o anjira dande'aan; anga atixxenaa'ninna no'o gatisaan. <verse eid="DAN 3:17" /><verse number="18" style="v" sid="DAN 3:18" />Yaane kinni Moyaanjoo! Isi no'o anjira gophoolenna midde magenuwwa atika magenoonfantabo'noxxanna uursetexxe eetene worqetixxe misile'ni sagandaabe'noxxa ege'n.»<verse eid="DAN 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 3:19" />Eettene yanna Naabukedenetsoor Sidiraaqi'n, Misaaqi'ninna Abidenaago'n yo'oshsha mufate'naa'a albi wele bifa idaqqe; giiratinna edi qiconaa'n caala torbaane anga eetene giira goolaashsha ajaje. <verse eid="DAN 3:19" /><verse number="20" style="v" sid="DAN 3:20" />Sasinga mannanna usurree ha'yita'neexxe goolinxe giira'n darbinaashsha ifike loliinke manni giddii'n jajjaba manna ajaje. <verse eid="DAN 3:20" /><verse number="21" style="v" sid="DAN 3:21" />Tennexxee kunni manni qeerraxxa seemma, bolaaluwwa umiinxa ruufaranna wele seemmuwwa oddo'winemmashshanni usuremeexxi ha'yita'neexxe goolinxe giira'n hunemme. <verse eid="DAN 3:21" /><verse number="22" style="v" sid="DAN 3:22" />Moyanjiink ajaji hara wiinanseek kadeemmaxxe goolinxi giira jaba qicinni ha'itemmaxxe giiratik buben Sidiraaqi, Misaaqinna Abidenaago'o iyyemare giirate'n hunemmaka loliinka manna shilte. <verse eid="DAN 3:22" /><verse number="23" style="v" sid="DAN 3:23" />Sasing kunni manninna usurememmashshanni goolendeexxe giira'n inbe.<verse eid="DAN 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 3:24" />Ookkonneechchi uduma moyanji Naabukedenetsoor mambe'a hiyyot offo'lebaa'n qophphi hiyye ke'eexxi, «Ussurre giira giddo hunneennak manni sase callammabaa?» hiyye qore.</para>
  <para style="p" vid="DAN 3:24">Insa'neenna, «Eeti, moyanjo» hine hisine haasonne.<verse eid="DAN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 3:25" />Moyanjikinna, «Kunnise usuremebaaka miidhemebaaka giira giddo mammarema'neeka shoole manna uuda'enne; sholgakkinna magenoonfantamakike belto laba'neen» hiyye.<verse eid="DAN 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 3:26" />Eettene yanna Naabukedenetsoor ha'yita'neexxe goolinxe giiraba'a shikki hiyyeexxi, «Koo Sidiraaqi, Misaaqinna Abidenaagoo, Lumoke Mageniinxe garboolee amme fulle! Kaba'a amme!»</para>
  <para style="p" vid="DAN 3:26">Tennexxe Sidiraaqi, Misaqinna Abidanaagoo giira giddii'n fulle. <verse eid="DAN 3:26" /><verse number="27" style="v" sid="DAN 3:27" />Galchalluwwi, ja'laabuwwi, moyetike minik mari'etik manninna dowwe insa'nexxe'n bukki hiyyeexxi insa'eneke umik ordichcho midde giira qunxu assitebaaxxa afe; oddoono insa'nexxixxi shibilli hitebaan; wiliilletik fooli midde insa'ne tuqqemmabaan.<verse eid="DAN 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 3:28" />Ookkonneechchi uduma Naabukedenetsoori hiyyee qici, «Iimika ifika erganjo ergeexxi anjireek Sidiraaqiki, Misaaqikinna Abidenaagooki Magen saademowwaal! Insa'ne iso'ni addatemati moyanjiinka ajaja qaxxaamurat ifika Mageno malee'e wele mageni'a ergatematenna kaddo isoo sagada gibati hedho ifixxa sa'issine uune'een. <verse eid="DAN 3:28" /><verse number="29" style="v" sid="DAN 3:29" />Tennexxe'e iitta anjiraak weli magen hedha gopheemmaxxe Sidiraaqike Misaaqikenna Abidenaagoke Mageno'n fuggoxxenni bucuqqi hiyyaak heene gosaki ardi yookaan gargar hedheeka laagada haaso'aakir duuchchi kochchisemmee'na'a minuwwi insa'nekinna oletixxe tuulo kadaashsha ajajenne.»<verse eid="DAN 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="DAN 3:30" />Ookkonneechchi uduma moyanji Sidiraaqi'i, Misaaqinna Abidenaago'o Baabiloonike awuraajji giddo baaloonse.<verse eid="DAN 3:30" /></para>
  <chapter eid="DAN 3" />
  <chapter number="4" style="c" sid="DAN 4" />
  <para style="s1">Naabukedenetsoor Oojjoti Uudeeka Haqichcho</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 4:1" />Naabukedenetsoori'i moyanji, buttate'n hedheeke arda, gosa gosuwwa'anna gargarika laagada haaso'a'neeke manni duuchhci'a nage'i ha'no'a bira sa'owwaali!<verse eid="DAN 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 4:2" />Lumok Magen ani'a asseeka mambe'a beessisuwwanna maso yaanuwwa gammada'nee ha'no'n kulaanne.<verse eid="DAN 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="DAN 4:3" />Isik Beessisuwwi hittatta lummoke!</para>
  <para style="q2" vid="DAN 4:3">Isixxi maso yaannuwwa hittatta jabaxxe!</para>
  <para style="q2" vid="DAN 4:3">Mootumma isixxi duuchchi woddixxen;</para>
  <para style="q2" vid="DAN 4:3">galcha isixxinna ila ila'n saxxaaxxe.<verse eid="DAN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 4:4" />Ani Naabukedenetsoor, anke mi'ne'n qununa'e anke moottumatike mine'ninna danqaashsha hedheennan. <verse eid="DAN 4:4" /><verse number="5" style="v" sid="DAN 4:5" />Ane'e sodaachchissexxa mitte oojjo oojjotenne; dhiiphennexxe taqe'n hedhe'na'a anxe sammo'n daggeexxi misilenna waleella ane'e alalshite. <verse eid="DAN 4:5" /><verse number="6" style="v" sid="DAN 4:6" />Tennexxe Baabiloonixxi beekkole duuchchi anibaa daggeexxi oojjo anxa ani'a tinko'a ajajenne. <verse eid="DAN 4:6" /><verse number="7" style="v" sid="DAN 4:7" />Morammakir, gojammakir, diginte daggamammakirnna urje laakko'ammakir dagee wodda oojjo anxa insa'ne'n kulenne yaane kinni tika dandeenneba'a. <verse eid="DAN 4:7" /><verse number="8" style="v" sid="DAN 4:8" />Ookkonneechchi uduma moyanjiinke magenuwwike summinni Bilxasoor hiyyeme ye'emeekinna woyyichchi magenuwwika hafuura afeeki Daani'eeli anibaa dage; aninna oojjo anxa iso'ni kulenneni. <verse eid="DAN 4:8" /><verse number="9" style="v" sid="DAN 4:9" />Aninna iso'ni hiyyeene qici, «Beekkoletike sooresa kaddeetteke koo Bilxasoor, woyyichchi magenuwwik hafuur ate'ni hedheexxa ege'nenne; hiini buqo yaanenna ate'e rakkisaban; ate'ni kulaannexxe oojjoxxa tika ani'a tiki. <verse eid="DAN 4:9" /><verse number="10" style="v" sid="DAN 4:10" />Anxe taqe'ni dhiiphennexxa yanna uudeennaxxi waleella: ani edi darre kunnise buttatixxe oddo'n ejjuma yo'oshsha qeeredheeki heqqichchi uurree'na uudenneni. <verse eid="DAN 4:10" /><verse number="11" style="v" sid="DAN 4:11" />Haqichchikinna yo'oshsha nophphe; jabaate; qacce isixxinna iima gelteexxi buttatike kasi qico'n leella'nemman. <verse eid="DAN 4:11" /><verse number="12" style="v" sid="DAN 4:12" />Isinna dancha shafikenna gumma unkuruure'ekemma'a; duuchchinge kaddaaxxi itanna iso'n hexxemma'a; biniichikinna isike gaaddis hunda gaaddilseedhe'emma'a; isixxe damuwwa hananna ci'a ofolda'emman; dada duuchchinna konne haqichchonaa'n la'ata'nemman.<verse eid="DAN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 4:13" />«Anxe taqete'n diiphe uudennexxe waleella'n mitti woyyichchi iimik erganji iimi'n dagaa'naa uudenneni. <verse eid="DAN 4:13" /><verse number="14" style="v" sid="DAN 4:14" />Isinna hafuura gikki asseexxi ane ye'e hiyyee qici: ‹Haqichcho konne karre; damuwwatanna cirre; shafuwwakanna harcaasse; gummatanna xeerre; biniichikinna isi hundii'n ci'atinna isixxe damuwwanaa'n baajjuun. <verse eid="DAN 4:14" /><verse number="15" style="v" sid="DAN 4:15" />Yaane kinni isika tutunjonna hiddi isik badda'a giddo sibiljikininna sageettoti usureme buttin giddo turowwaal.</para>
  <para style="p" vid="DAN 4:15">«‹Iimi'ni coccobaake wojinni lashshi hiyyowwaal; badda'a giddonna biiniinchik hedhuun. <verse eid="DAN 4:15" /><verse number="16" style="v" sid="DAN 4:16" />Sammo isixxinna manjinxenaa'n jijjiirende'na'a biniinchinxi sammo torbaane wogga qici'a isi'a uwwenduun.<verse eid="DAN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 4:17" />«‹Murtettinna erganjuwwi darree'n kulende; seerakanna woyyoole haasote; kuninna, Lumoki Mageni buttatixxe moottumma duuchcha'n moyaaxxa tenne moottumuwwa eeyyeeke uwwaaxxanna manni giddi'n tuffatemekara baalonsaxxa hedho afeek duuchchi tenne ege'naashaten.›<verse eid="DAN 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 4:18" />«Tinni ani moyaanji Nabukedenetsoor oojjotenaxxe oojjoman; yoona ta'a koo, Bilxasoor anxe moottuma giddo hexxeexxe beekkolenaa'n mittikinna ise'e tika dande'a gophedheen, ate'ni kinni magenuwwiinki woyyichchi hafuur hedhemmaxxe ati tika dandeettatton.»<verse eid="DAN 4:18" /></para>
  <para style="s1">Daani'eel Moyaanjiinxa Oojjo Tike</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 4:19" />Eettene yanna Bilxasoor hiyyemeek Daani'eeli heenoxxe yanna'a lumoshsha raankeme yaadikinna isoo alalshe; tennexxe moyanji, «Koo Bilxasoor eetene oojjonna kadi tika isexxi ate'e alalshitoqqe'e» hiyye.</para>
  <para style="p" vid="DAN 4:19">Bilxasoorinna hiyye haaso'ee qici, «Koo moyaanjoo! Iitti oojjo atee gibaakixxe kaddo tika isexxinna atike naaphi'a kaddo. <verse eid="DAN 4:19" /><verse number="20" style="v" sid="DAN 4:20" />Iikk oojjoti uuddettek haqichchi, nophphe jabaate qacce isixxinna iima geltee'na'a butta duuchcha'ninna leelleeke, <verse eid="DAN 4:20" /><verse number="21" style="v" sid="DAN 4:21" />danchallamma shafuwwikinna unkuruura gummake, ardi duuchchi'ana itate kadeeke, biniinchuwwi isi hunda gaadifata'neekenna ci'aa isi hana mine ijaadhdhite hexxaamakeman. <verse eid="DAN 4:21" /><verse number="22" style="v" sid="DAN 4:22" />Koo moyanjoo! Lumokenna jabake kadeeki iikki haqichchi ateten; atinna lummexxe'e iimi qico'n gelteetten; galcha atixxinna buttatixxe gabala qico'niten.<verse eid="DAN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 4:23" />«Koo moyanjoo! Atinna uuddaa'naann mitti woyyichchi iimik erganji dirre dageexxi ‹Haqichcho konne karre; tutunjo kinni sibiljikinna sageettotike usurri, hiddichchikinna buttini giddo hedhuun. Iimi'ni coccobaak woji iso'o lashshi assowwaal; isinna torbaane wogga biniinchuwwik welti hedhowwaal.›<verse eid="DAN 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 4:24" />«Koo moyanjoo! Lumok Magen ate'e gootta anke moyanjo'n iyyedageeke ajajixxi tika konneechchinni butti'a hexxeeshshaten: <verse eid="DAN 4:24" /><verse number="25" style="v" sid="DAN 4:25" />Atinna ardi giddii'n adhdhendeettexxi biniinchik welti hexxattoni; torbaane wogga saxxaa qico'n horiinsha badda'a dheeda'na'a iimii'n woji ate coo'mi assaan; tinn duuchchi ate'n geltaachchi Lumoki Magen manjiinxe moottummuwwa duuchcha'n hunna affeexxanna moottumma duuchcha eeyyeekee uwwaaxxa egendatto qico'nteni. <verse eid="DAN 4:25" /><verse number="26" style="v" sid="DAN 4:26" />Haqichchink tutunji buttini giddo hiddik gataashsha ajajaamma Magen butta duuchcha'n hunna affeexxa egendetechchi uduma higgeena mootatoxxa leellisha. <verse eid="DAN 4:26" /><verse number="27" style="v" sid="DAN 4:27" />Tennexxe koo moyanjoo! Ani ate gorsaanneka gorsa gammadik adhdhi; cubbo huja waaldetexxi eloxxa yaane assi; fuggoxxa assa waalde miicemeeke manni'a marari; tennexxe qeerraka baro nage'ik hexxatton.»<verse eid="DAN 4:27" /></para>
  <para style="s1">Iitti Oojjo Muuxende</para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 4:28" />Tinni duuchchi moyanjo Naabukedenetsoor'n kadde. <verse eid="DAN 4:28" /><verse number="29" style="v" sid="DAN 4:29" />Tommena langa agenji uduma moyanji Naabukedenetsoor Baabiloonike moottummatike iimi darreke mine'n mammarema'n <verse eid="DAN 4:29" /><verse number="30" style="v" sid="DAN 4:30" />Moyanji hiyyee qici, «Tinni moyanjuwwiinke galduma kado'aa anxe jabaxxe hunnanni anke lumoke gurri'aa ijaarennexxe lumoxxe Baabiloonitebaataa?»<verse eid="DAN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 4:31" />Haaso'a afo'ii'ni birebaang hafuur<note caller="+" style="f"><char style="fr" closed="false">4:31 </char><char style="ft" closed="false">Konne booncho'ni hafuuarake hiyyemek woyyichcha hafuura kadebang laqendaaxxe qonqo hitaaxxe tika affe'en. </char></note> iimi'n dageexxi hiyyee qici, «Koo moyanjo Naabukedenetsoor! Ati'a ajaji fuleek: moyanjummatixxi atixxi baalle atenaa'n adhdhende'een; <verse eid="DAN 4:31" /><verse number="32" style="v" sid="DAN 4:32" />Ati ardi gidii'n adhdhendettexxi biniinchik welti hexxattoni; horinshanna badda'a dheeddatto; Lumok Magen manjixxe mottummuwwa duuchcha'n hunna afeexxanna tenne mottummuwwa eeyyekee uwwaaxxa egendatto qico'n torbaane wogga saxxaan.»<verse eid="DAN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="DAN 4:33" />Iikki woddi kulendemmaxxi Nabukedenetsoor'n kaddee'na'a manji giddii'n adhdhemeexxi horinsha badda'a dheede; biso iskixxi orda sinbiriinke keelishsha qeerrexxaa qici'aanna qe'yi isik ci'atikishsha nophphaa qici'a iimike wojinni corco hiyye.<verse eid="DAN 4:33" /></para>
  <para style="s1">Naabukedenetsoori Magenoke Shiqisheeka Galata</para>
  <para style="p">
    <verse number="34" style="v" sid="DAN 4:34" />Bari iikkinna muuxemechchi uduma ani Naabukedenetsoori toggi hiyye iimi'a uudenne; kiidotinna ane'n higge; Lumoka Magenonna saadenne; duuchchi woddi'a hedhaakanna ulfeessenne jajenne.</para>
  <para style="q1" vid="DAN 4:34">Galcha isixxi duuchchi woddiixxeni;</para>
  <para style="q2" vid="DAN 4:34">moottumma isixxinna ilatenaa'n ilati qico'n hexxaani.<verse eid="DAN 4:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="DAN 4:35" />Buttate'n hedheek ardi duuchchi</para>
  <para style="q2" vid="DAN 4:35">mitteelchishanna laakko'emabaan;</para>
  <para style="q2" vid="DAN 4:35">iimike sannachuwwanna kado'o</para>
  <para style="q2" vid="DAN 4:35">buttate'n hedheeke ardi eeyyeexxa assaan;</para>
  <para style="q2" vid="DAN 4:35">iso'o hoyya dande'aak yookaan</para>
  <para style="q2" vid="DAN 4:35">iso'o, «Maassitette?» hiyyaak ayyinna hedhaba'a.<verse eid="DAN 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 4:36" />Iitti kiido ane'ni higgeexxa yanna anxe mootummake ulfinni'a gaachannikinna lumminni duuchchi ane'n hige; ank gorsalluwwinna ja'laabuwwi ane hanse; anxe moote'ninna higennexxi edi caalanna ulfeessemenne.<verse eid="DAN 4:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="DAN 4:37" />Iimik Magen assaaxxi duuchchi eloxxe kaddeemmaxxee ori isik duuchchinna qullichakenna dhugaate kademmaxxe ta'a ani Naabukedenetsoor iso'o sadaanne, lummisaanne, ulfessaanne; isi ifi dukaakaranna salphisa dande'aaken.<verse eid="DAN 4:37" /></para>
  <chapter eid="DAN 4" />
  <chapter number="5" style="c" sid="DAN 5" />
  <para style="s1">Gimote'ni Borreessendeexxa Borro</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 5:1" />Mitte barra moyanji Bilxasoor kuma ifike ja'laabuwwi'a lumoxxa jila jileexxi insa'nenni welti woyinetixxa booka ha'wa'neemmani. <verse eid="DAN 5:1" /><verse number="2" style="v" sid="DAN 5:2" />Bilxasoor woyinetixxa booka ha'wande'n hedheexxi, anni isiki Naabukedenetsoori Iyyerusaalemike galmanaa'n iyyedagemmaxxa worqetixxanna birretike sibiljixxa buuduwwa'n, ja'laabuwwa ifikenn, aruwwa ifixxenninna shiixxooxxe ifixxe aruwwanni welt ha'wo'aa tenne buuduwwa iyyedangaashsha erganjuwwa ajaje. <verse eid="DAN 5:2" /><verse number="3" style="v" sid="DAN 5:3" />Tennexxe erganjuwwikinna Iyyerusaalemi hedhemmake Mageniinke galmanaa'n daggemmaxxa worqetixxa buuduwwa iyyedage'naa moyanji tenne buuduwwa'n ifike ja'laabuwwinn, aruwwa ifixxeninna shiixxooxxe ifixxe aruwwann welt ha'we. <verse eid="DAN 5:3" /><verse number="4" style="v" sid="DAN 5:4" />Insa'ne woyinetixxa booka ha'wina'n worqetika, birretike sibljika, sageeto sibljika, sibljiinka, haqqetikanna kinjiinka magenuwwa galateeffante.<verse eid="DAN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 5:5" />Hirba ookkone'ni manjiinxe angaxxi qubba leelliteexxi moottummatike minixxe giddixxe gimo'n borreessite; moyanjikinna qubba tinni borressita'na'a afe. <verse eid="DAN 5:5" /><verse number="6" style="v" sid="DAN 5:6" />Ookkone wodda moyanji alba xilledhe; alayyokenaa'n kexxeexxeninna anga lekka wexeqeme; mikituwwakanna gilgile. <verse eid="DAN 5:6" /><verse number="7" style="v" sid="DAN 5:7" />Moyaanjinna hafuura gikki asseexxi morammakir, gojammakir, diginte daggamammakirnna urje laakko'ammakiir dagaashsha ajajeexxi tenne Baabiloonixxe beekkole'ni hiyyee qici, «Tenne borro haasesseexxi tika isexxa ane'n kula dande'aake manji'aa dhiille kaabba oddoossennexxi goobake'ininna worqetika haachchaba ugganno; isi anxe moottumma'n sakkake galchallo kadaan.»<verse eid="DAN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 5:8" />Ookkonneechchi uduma moyanjinxa duuchchinxa beekkole ye'isse; yaane kinni borro eettene haasessateenna kad isexxa tika moyanjoke'n kula dandeenneba'a. <verse eid="DAN 5:8" /><verse number="9" style="v" sid="DAN 5:9" />Tennexxee moyanji Bilxasoor yo'oshsha alayye; albakanna xilledhe; isik ja'laabuwinna mekki hiyye.<verse eid="DAN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 5:10" />Mootitte moyanjiinkanna isike ja'laabuwwika haaso'a laqqeexxi jilatike mine'n e'yite hitee qici, «Koo moyaanjoo! Qeerra baro hedhe! Tenne yaanexxenna mekki hittoxxe, albakanna xillisoxxe. <verse eid="DAN 5:10" /><verse number="11" style="v" sid="DAN 5:11" />Atixxe moottumma giddo woyyichcha magenuwwika hafuura afeek mitti manji hedheen; kunn manji atike annike baro'n magenuwwiinsha hedheeka beekuma qalbefachonna ege'naa afeemmakemman; iso'o anni atik Nabukedenetsoorinna moramakirke, gojamakirke, diginte daggamammakirikenna urje lakko'ammakar mannike akeekisanjo asse. <verse eid="DAN 5:11" /><verse number="12" style="v" sid="DAN 5:12" />Moyanji iso'o Bilxasoor hiyye summa fulcheemmak Daani'eeli kunni eloxxa kiido, ege'nanna qalbeeffachcho afeeke kade'e ege'nemeken; oojjo tika, hiibbo hissanna buqo yaane farri assatixxa dande'a afe'emmaken; tennexxe'e Daani'eel ye'ise; borro itti maa hitaaxxa isi ate'n kulaan.»<verse eid="DAN 5:12" /></para>
  <para style="s1">Daani'eel Borrotixxa Tika Moyaanjoke Ege'nishsheexxa</para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 5:13" />Eettene yanna Daani'eeli moyanji edo shiqe; moyaanjinna iso'o hiyyee qici, «Moyanji anni ank Naabukedenetsoori Yihudakenaa'ni booji'e iyyedageeke manni giddii'ni Daani'eelte hinaak atetee? <verse eid="DAN 5:13" /><verse number="14" style="v" sid="DAN 5:14" />Magenuwwink hafuur ate'ni hedheexxa ege'na qalbeeffachchonna gargar hedheeka beekkuma affeettexxa ege'neennen. <verse eid="DAN 5:14" /><verse number="15" style="v" sid="DAN 5:15" />Tenne borro haasossineexxi tika isexxa ane'n kullo'a beekoletinna, diginte daggamammakir ani edo shiqeemman; yaane kinni tika ane'n kula dandeenneba'a. <verse eid="DAN 5:15" /><verse number="16" style="v" sid="DAN 5:16" />Yaane kinni ati tikattixxa dande'a affettexxanna rakkissaaxxa yaane duuchcha kula dandeetattoxxa laqeenen; tenne borro haasesitotole, tika isexxanna ane'n kula dandeettottole, dhiille kaabba oddo'wittattoshsha gobake'ininna worqetika haachchaba uggudhdhitettexxi anxe mootumma'n sakkake galchallo kaddattoshsha assannon.»<verse eid="DAN 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 5:17" />Daani'eelinna moyanjoke'n hisse haaso'e hiyyee qici, «Uwwa atixxir ati'anni hexxuun; gica atikaranna wele manji'a gic; kado malee'e tenne borro haasossennexxi isexxa tikanna atee moyanjoke'n kulannon.<verse eid="DAN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 5:18" />«Koo moyaanjoo! Lumok Magen Naabukedenetsoori anna atikee moottumma, lumminne, ulfinnakanna gaachchanna uwween. <verse eid="DAN 5:18" /><verse number="19" style="v" sid="DAN 5:19" />Isi'a uwweeke lumooke baalloommanaa'n kexxeexxa ardi duuchchinna garga gargar hedheeka laagada haaso'aakir duuchchi isi'a culphiseexxi iso'o sodaate; moyanjinna shiyo'a haseeka shiya; gatiso'a haseeka gatisa; baalonsa haseeka baloonsa; salphisa haseeka salphisa'emman. <verse eid="DAN 5:19" /><verse number="20" style="v" sid="DAN 5:20" />Yaane kinni hollatinna ifi dukati jabaatee wodda mootte ifixxenaa'n fugusseme; gaachannikinna isonaa'n mulqeme. <verse eid="DAN 5:20" /><verse number="21" style="v" sid="DAN 5:21" />Isi ardi giddii'ni adhdheme; biniinchinxi sammonna isi'a uwwende; diidinxe harruwwanni welt hose gale; horinshanna badda'a dheede; Lumok Magen manjinxe moottuummuwwa duuchcha'n hunna afeexxanna moottumma duuchcha eeyyeke uwwaaxxa ege'naa qico'n bisi isik iimi'ni cophphisammake wojinn coo'mi hiyye.<verse eid="DAN 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 5:22" />«Koo Bilxasoor ati belto isinge kadde tenne duuchcha egendeenni hexxe ifi salphisebexxo. <verse eid="DAN 5:22" /><verse number="23" style="v" sid="DAN 5:23" />Ifi salphissattaxxa bado iimike Dada duuchchiki Gootti ifi dukkette; galmixxa buuduwwanna iyyedagissettexxi atike ja'laabuwwinni aruwwa atixxenninna shiixxooxxe atixxe aruwwanni welt woyinetixxa booka tenne buuduwwa'n ha'witete; uuda, afanna qalbeeffata dande'abaaka worqetika, birretike sibljika sageettotike sibiljika, sibiljiinka haqqetikanna kinjiinka mageno galateeffattette. Yaane kinni hedho atixxinna ora atika duuchcha anga abideeka Mageno ulfeessitebexxo. <verse eid="DAN 5:23" /><verse number="24" style="v" sid="DAN 5:24" />Tennexxe isi eettene borro borreessitaaxxa qubba erge.<verse eid="DAN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 5:25" />«Itti borresseendemmaxxi borronna: Maane, Maane, Teqel, Faares<note caller="+" style="f"><char style="fr" closed="false">5:25 </char><char style="ft" closed="false">Hitaaxxi hiyya Araamayikike hiyyochon.</char></note> hita'emmaxxe kaddaa wodda.<verse eid="DAN 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 5:26" />«Isexxi tikanna: Magen atixxe mootummaka baro lakko'eexxi muuxemake'n idage hiyyoten. <verse eid="DAN 5:26" /><verse number="27" style="v" sid="DAN 5:27" />Teeqel hiyyo Kiilende shollexxe hiyyotte. <verse eid="DAN 5:27" /><verse number="28" style="v" sid="DAN 5:28" />Faares hiyyo mootumma atixxi qoodendeexxi Medoonikenna Faarisike manni'a uwwende.» <verse eid="DAN 5:28" /><verse number="29" style="v" sid="DAN 5:29" />Ookkonneechchi uduma Bilxasoor Daani'eeli'n dhiille kaabba oddoossinaashsha, goobake'ninna worqetika haachchaba uggaashsha; moottumma isixxe'ninna sakkake galchallo assinaashsha ajaje. <verse eid="DAN 5:29" /><verse number="30" style="v" sid="DAN 5:30" />Eetteneen hashsha Babilonk moyaanj Bilxasoor shiyemee'na'a, <verse eid="DAN 5:30" /><verse number="31" style="v" sid="DAN 5:31" />jaane tommenna lame woggak Daaryoosi Medoonchi moottumma isixxa dhaale.<verse eid="DAN 5:31" /></para>
  <chapter eid="DAN 5" />
  <chapter number="6" style="c" sid="DAN 6" />
  <para style="s1">Daani'eeli Neenquwwinxe Bale Giddo Huneme</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 6:1" />Mootumma isixxe duuchcha'n moonaashsha Daaryoosi dhibbanna lame tomme jalqaabuwwa baalloonsa eeyye. <verse eid="DAN 6:1" /><verse number="2" style="v" sid="DAN 6:2" />Insa'ne'ninna sase manna umoke asse; kone manninaa'ninna mitti Daani'eelitemman; insa'ne moyanjokee'e mitte yaanenna xe'itabaashsha konne galchalluwwa towantaashsha assende. <verse eid="DAN 6:2" /><verse number="3" style="v" sid="DAN 6:3" />Galchalluwwakenaa'ninna jalqaabuwwakenaa'n Daani'eeli gargar hexxeexxa dande'a afeemmaxxee moyanji isoo ifixxe mootumma hana baalloonso'a yore. <verse eid="DAN 6:3" /><verse number="4" style="v" sid="DAN 6:4" />Tennexxee iikki umiink galchalluwwinna ja'laabuwwi Daani'eeli mootummatike mine'ni hujaammaxxe hujexxe buuto'a manni isoo ku'lino'a hase; yaane kinni Daani'eel xuurameessake, xexe'allokenna hujete'n mitte xe'yanna gugurto afa gophemmaxxee iso'n mitte dedhanna balleessa afa dandeenneba'a. <verse eid="DAN 6:4" /><verse number="5" style="v" sid="DAN 6:5" />Tennexxee insa'ne weli'ani weli, «Isike Magenka seera uudaaxxe yaane darre'nite kaddoole malee konne manjichcho ku'linannoxxa mitte balleessa iso'n afa dandennebo'n» hine.<verse eid="DAN 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 6:6" />Ookkoneechchi uduma iikki galchalluwwikinna iikki jalqabuwwi bukki hine marreexxi moyanjo, «Koo Moyanjo Daariyoosii! Qeerra baro hedhi! <verse eid="DAN 6:6" /><verse number="7" style="v" sid="DAN 6:7" />Sase tomme barra qici'a ati gadhi darre ayyinna manjo yookaan wele mageno soodatabaashsha lallaba fulchitotta'a, konne lallabanna sa'eek neenqinxe bale'n hunemaashsha umiink mootummatik galchalluwwi, ja'laabuwwi, hayyoole, gorsalluwwinna bogiink galchalluwwi duuchchi weli aage'een. <verse eid="DAN 6:7" /><verse number="8" style="v" sid="DAN 6:8" />Tennexxee moyanjoo! Konne lallaba fulchitettexxi Medoonikenna Faarsike seerishsha jijjiiremabaaka seera borreesite offo'lish.» <verse eid="DAN 6:8" /><verse number="9" style="v" sid="DAN 6:9" />Tennexxe Moyanji Daaryoosi ookkonee lallaba borroti ofo'lshe. <verse eid="DAN 6:9" /><verse number="10" style="v" sid="DAN 6:10" />Daani'eelinna iikki lallabi borreessemeexxa laqee wodda hedhammaxxe fooqebaa qabata; isi hedha'emmaxxi fooqexxi masikotenna Iyyerusaalemi darre'n bandeexxe masikootuwwa affe'eemman; edi wodda assa'emmashshanni guluffateexxi barrate'n sasele soodate; ifika Magenonna galateeffate.<verse eid="DAN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 6:11" />Iikki manni mitteba bukki hiyye mareexxi Daani'eeli, soodata'n Mageno gargaarsa laqedhaa'naa afe. <verse eid="DAN 6:11" /><verse number="12" style="v" sid="DAN 6:12" />Insa'nenna moyanjiinba marreexxi, «Moyanjoo sase tomme barra qici'a ati gadhi darre ayyinna manjo yookaan wele mageno soodatoole neenqiinxe bale'n huneemaaxxa ajaja fulchiteettabaa?» hina'n fulcheemmake lallabixxee isoo qorre; moyanjikinna, «Iikk lallab Medoonikenna Faarsike jijjiiremabaake seerishsha jijjiiremaakeba'a» hiyye hiisse haaso'e.<verse eid="DAN 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 6:13" />Insa'nenna moyanjoke'n, «Moyanjoo Yihudakenaa'n booji'emeeke manninaa'n Daani'eeli hiyyemaak ati fulchitteteka ajaja ulfeesa'nebaan; ta'anna barrate'n sasele guluffate soodata'neen.» hine.<verse eid="DAN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 6:14" />Moyanji tenne laqeexxa yanna lumoo qica yaade; Daani'eeli gatiso'anna mudhdheexxi arishsho aaggaa qici'anna dandeessiseexxa duuchcha asse.<verse eid="DAN 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 6:15" />Ookkoneechchi uduma manni mitteba moyanjinba shiqeexxi, «Moyanjoo! Medoonikena Faarisike seerishsha moyanji fulcheek lallabinna kad ajaji jijjiiremabaaxxa ege'n!» hine.<verse eid="DAN 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 6:16" />Tennexxee Moyanji Daani'eel iyyedangeexxi neenquwwiinxe bale'n hunnaashsha ajaje; moyanjikina Daani'eelii'i, «Duuchchi wodda isi'a ergatendaatek Magen atee gatiso'o» hiyye. <verse eid="DAN 6:16" /><verse number="17" style="v" sid="DAN 6:17" />Kinjokanna iyyedandeexxi eettene neenqinxe baleke afo'n cunfe; moyanjikinna Daani'eeli'n assendeexxi yaane jijjiirendaaxxe kaddabaaxxa ege'nishatee ifixxe qubekanna ifike ja'laabuwwixxe qubeka maxxansa itti maxxanse. <verse eid="DAN 6:17" /><verse number="18" style="v" sid="DAN 6:18" />Moyanjikinna ifike mootummatike minibaa ille iima hige; eettene hashsha itebaang, iso'o fenxe assitaaxxi yaanenna isi'a daggaashsha assendebaang gale; diiphikinna isinaa'n ba'e.<verse eid="DAN 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 6:19" />Bariisa reefi boro haachchabbamma wodda moyanj ke'eexxi wiinamik eettene neenquwwiinxe balebaa me'e. <verse eid="DAN 6:19" /><verse number="20" style="v" sid="DAN 6:20" />Eettene baleba'aanna shiqeexxi yaadotike hafuurinni Daani'eeli'i, «Ookkone hadhaake Magenike garbichcho Dani'eelii! Iikki duuchchi wodda isi'a ergatendattak atik Magen ate'e neenquwwakenaa'n gatisa dande'edhee?» hiyya'n ye'e. <verse eid="DAN 6:20" /><verse number="21" style="v" sid="DAN 6:21" />Daani'eelinna hiisse hiyye haaso'ee qici, «Moyanjoo! Qeerra baro moyii! <verse eid="DAN 6:21" /><verse number="22" style="v" sid="DAN 6:22" />Moyanjo ani isi edo balleessa belo hedhannaxxee ati edonna fuggoxxa huje ege'na gophennaxxee anki Magen ifika iimika erganjo ergeexxi ookkone neenquwwiinka ofo'o cufeen; neenquwwikinna anee'e midhebaan.»<verse eid="DAN 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 6:23" />Moyanjikinna lumoshsha gammadeexxi Daani'eelii'i bale giddii'n fulchinaashsha ajaje; Daani'eelinna bale giddii'n fulchemee wodda Magenoke'n addateemmaxxee mitte miidhenshanna iso'n gelteemmaba'a. <verse eid="DAN 6:23" /><verse number="24" style="v" sid="DAN 6:24" />Moyanjiinke ajajinni ookkonee dhariki Daani'eelii'i ku'lemmaka manna, insa'nexxe aruwwanninna insa'nexxe oosenni welti iyyedangeexxi eettene neenquwwiinxe bale giddo darbine; bale giddo hunda gennebaang iikki neenquwwi insa'nee ninnifeexxi miqe insa'nexxanna duuchchanna buttuchche.<verse eid="DAN 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 6:25" />Ookkoneechchi uduma moyanji Daariyoosi butta duuchcha'n hedheeke arduwwa'n mootummuwwa'ninna gargar gargar hedheeka laagad haaso'aake manni duuchchibaa erga hiyya'n boreessee qici: «Nage'i ha'no'aa kadowwaal!<verse eid="DAN 6:25" /></para>
  <para style="b" />
  <para style="p">
    <verse number="26" style="v" sid="DAN 6:26" />«Anxe mootummaxxe galcha giddo duuchcha'n hedheek manji duuchchi Daani'eelika Mageno sodataashshanna ulfeesaashsha konnee lallaba fulcheennen.</para>
  <para style="q1" vid="DAN 6:26">«Isi duuchchi woddi'a hedhaake Mageno kademmaxxee,</para>
  <para style="q2" vid="DAN 6:26">isixxi mootumma baxxaba'a;</para>
  <para style="q2" vid="DAN 6:26">isixxi galchanna muuxama affeba'a.<verse eid="DAN 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="DAN 6:27" />Isi wodaan anjiraan;</para>
  <para style="q2" vid="DAN 6:27">iimate'ninna buttate'n beesissuwwakanna maso assaan;</para>
  <para style="q2" vid="DAN 6:27">Daani'eelinna neenquwwiinke afo'inaa'n gatise'een.»<verse eid="DAN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 6:28" />Tennexxee Daani'eeli'a Daaryoosixxe mootummake baro'ninna Farisichcho Qiroosixxe mootummake baro duuchcha'n yaane isi'a qajeelde.<verse eid="DAN 6:28" /></para>
  <chapter eid="DAN 6" />
  <chapter number="7" style="c" sid="DAN 7" />
  <para style="s1">Daani'eel Uudeexxa Shoole Biniinchixxa Waleella</para>
  <para style="r">(<ref loc="DAN 7:1-12:13">7:1—12:13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 7:1" />Baabiloonik moyanji Bilxasoor moyeexxe siretixxe wogga'n Daani'eeli taqete'n diipheeba hedheexxi oojjo oojjote; waleellatanna uude. Eettene oojjoka umo yaadanna borreesse.<verse eid="DAN 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 7:2" />Dani'eelinna hiyyeeqic: «Shoole iimik diidallichchuwwi lumoxxe abbaayya raassaa wodda hashsha waleellati uudenne. <verse eid="DAN 7:2" /><verse number="3" style="v" sid="DAN 7:3" />Shool gargar gargar hedheek biniinchuwwinna tenne abbaayyanaa'n fule.<note caller="-" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="REV 13:1">Wal. 13:1</ref>; <ref loc="REV 17:8">17:8</ref>.</char></note><verse eid="DAN 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 7:4" />«Iikki taakkak biniinchi neenqa laba'emman; isinna sinbiriinka keela afe'eemman; aninna uuda'naa'n isik keeluwwinna goggosheme; manjiinshanna lame lekkanni uurraashsha buttii'n iimi'a qophphi asseme, manjiinxi qalbenna isi'a uwwende.<verse eid="DAN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 7:5" />«Kunnise weli langak biniinchi dibbi hiyyemaake biniicha laba'emman; isinna mitte ga'mii'n iimi'a qophpi hiyyeexxi sase cinaachchiinxa miqe issoti ga'me'emman. Isinna, ‹Kexxettexxi godditatto qico it› hiyyeme.<verse eid="DAN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 7:6" />«Ookkoneechchi udumanna uudannoo wodda ani edo qeedhancha labaak wele biniinchi hedhemman; ifike dudduro'ninna ci'atikishsha hedheeka shoole keela afe'eemman; kunni biniinchi shoole umuwwa afe'eemman; isi'anna galchatik baalloomi uwweme.<note caller="-" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="REV 13:2">Wal. 13:2</ref>. </char></note><verse eid="DAN 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 7:7" />«Ookkonechchi uduma, hashsha leella uudene; kunnise sodaachchisaakinna alalishaak lumoshsha hunnaamessake kade'eek sholgaki biniinchi hedhemman; isinna lumolla sibiljiinxa isso afeemman; butuchche ita'na'a gateechcho duuchanna lekkat hirbeessa'emman. Isi edidarre hedhemmake biniinchi duuchchinaa'ninna gargar hedheekenna tomme gaafuwwikemman.<note caller="-" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="REV 12:3">Wal. 12:3</ref>; <ref loc="REV 13:1">13:1</ref>. </char></note><verse eid="DAN 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 7:8" />«Konne gaafuwwinxe yaane hedande'n hedhennenge'n konne gaafuwwixxe oddonaa'n weli gaaf xuutti hiyye; edisemmake gaafuwinaa'ninna isi edo sasi gosheme; kunni shiixxoki gaafi manjinxishsha hexxeexxa ille, hollati haaso'aaka afo'onna afe'emman.<note caller="-" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="REV 13:5-6">Wal. 13:5-6</ref>. </char></note><verse eid="DAN 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 7:9" />«Aninna uudanege'ni,</para>
  <para style="q1" vid="DAN 7:9">«Mootuwwa bakkate'n uggendee'naa</para>
  <para style="q2" vid="DAN 7:9">iikki olmikinna iso'ni ofo'le;</para>
  <para style="q1" vid="DAN 7:9">Seemma isixxinna kaadetishsha golaloxxemman;</para>
  <para style="q2" vid="DAN 7:9">isike umixxi ordanna footinsha golaloxxemman;</para>
  <para style="q1" vid="DAN 7:9">Moote isixxinna giirati bubeno,</para>
  <para style="q2" vid="DAN 7:9">isixxe mootexxi moluwwanna ha'ita'neexxe giiramman.<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="REV 20:4">Wal. 20:4</ref>; <ref loc="REV 1:14">1:14</ref>. </char></note> <verse eid="DAN 7:9" /><verse number="10" style="v" sid="DAN 7:10" />Giiratik wodi'inna isi edii'n burqeexxi</para>
  <para style="q2" vid="DAN 7:10">ya'a'nemma'a;</para>
  <para style="q1" vid="DAN 7:10">Heddo kuma'n laakko'emaak erganjiwwi isi'a ergatema'emman;</para>
  <para style="q2" vid="DAN 7:10">laakkossi iimi darre hedheeke kumuwwiirinna isi edo uurre'eemman;</para>
  <para style="q1" vid="DAN 7:10">Murte safende;</para>
  <para style="q2" vid="DAN 7:10">maxaafuwwikinna baneme.<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="REV 5:11">Wal. 5:11</ref>; <ref loc="REV 20:12">20:12</ref>. </char></note><verse eid="DAN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 7:11" />«Gaafi iikki haaso'ammak hollaatite kadeemmaxxee aninna uushshote'n ke'enne; ani uudande'n hedhee'na iikki biniinchi abideme shiyemeechchi uduma renshi isik giirate'n darbeme iteme. <verse eid="DAN 7:11" /><verse number="12" style="v" sid="DAN 7:12" />Wele biniichuwinaa'ni baaloommi hoyyeme; kaddo malee murendeexxe woggaxxa yanna hedhoti hedho'a eetti uwwende.<verse eid="DAN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 7:13" />«Hashsha uudennexxe waleella'n manjinka belto labaak iimike duumanchinni welti dagaa'naa afenne. Isoona ookkone olmiinki edo shiqinshe.<note caller="-" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="MAT 24:30">Mat. 24:30</ref>; <ref loc="MAT 26:64">26:64</ref>; <ref loc="MRK 13:26">Mar. 13:26</ref>; <ref loc="MRK 14:62">14:62</ref>; <ref loc="LUK 21:27">Luq. 21:27</ref>; <ref loc="REV 1:7">Wal. 1:7</ref>, <ref loc="REV 1:13">13</ref>; <ref loc="REV 14:14">14:14</ref>. </char></note> <verse eid="DAN 7:13" /><verse number="14" style="v" sid="DAN 7:14" />Baalle, gaachchannikinna lumoxxi hunna isi'a uwwende; gargar gargar hedheeka laagada haaso'aak gosa gosak manninna arduwwi isoo sagande; galcha isixxinna duuchchi woddi'a saxxabaaxxen; mootumma isixxinna haranga baxxabaaxxen.<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="REV 11:15">Wal. 11:15</ref>. </char></note><verse eid="DAN 7:14" /></para>
  <para style="s1">Eettene Leellatixxa Tika</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 7:15" />«Ani uudennexxe waleellaxxee, ani Daani'eeli mekki hiyye ifi giddonna wixxirri hiyyeene. <verse eid="DAN 7:15" /><verse number="16" style="v" sid="DAN 7:16" />Aninna ookko uurre'emmakeranaa'n mittinba'a shiqennexxi tenne duuchchinxee dhugaatixxa tika isoo qorenneni.</para>
  <para style="p" vid="DAN 7:16">«Isinna tenne yaaneexxa tika hiyyeexxi ane'n kulee qici, <verse eid="DAN 7:16" /><verse number="17" style="v" sid="DAN 7:17" />‹Kunni shool lumollammi biiniinchi buttate'n mootaaxxe shoole mootummuwwan. <verse eid="DAN 7:17" /><verse number="18" style="v" sid="DAN 7:18" />Yaane kinni ookkone Lumokixxi Woyyoole tenne mootumma adhdhitaan; duuchchi woddi'anna isee dhaaldaan, eetti baro baroke ifixxe assexxaan.›<note caller="-" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="REV 22:5">Wal. 22:5</ref>. </char></note><verse eid="DAN 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 7:19" />«Ookkoneechchi uduma butuchcha'neekenna ninnifa'neeke gatechcho duuchchanna lekkati hirbeessa'neeke, sibilinxa issonna sageettotike sibilinke qe'ya afeeka, wele biniinchinaa'ninna gargar hedheeki lumoshsha sodaachchisa'neeke konne shoolgake biniinchixxa dhugaatixxa tika ege'nonna'a yorenne. <verse eid="DAN 7:19" /><verse number="20" style="v" sid="DAN 7:20" />Iittanni konne biniinchike umi hana hedheeke tomme gaafuwwi hedhemman, konne gaafuwwiinxe oddonaa'ni shiixxoki gaafi quuxxise; aninna konne goggoshemeemmake sasi gafuwwixxee e'ge'nonna'a yorenne; kunni gaafi illuwwanna ofo'o afeemman; wele gaafuwwinaa'n caala sodaachchisaaka hollati haaso'aaka afo'o afeemman. <verse eid="DAN 7:20" /><verse number="21" style="v" sid="DAN 7:21" />Ani uudannenge'ni kunni gaafi woyyoolete'ni bagedo baneexxi insa'ne injifate:<note caller="-" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="REV 13:7">Wal. 13:7</ref>. </char></note> <verse eid="DAN 7:21" /><verse number="22" style="v" sid="DAN 7:22" />Tinninna kaddeek iikki olmiki dagaa qici'anna ookkone Lumokixxe woyyoole'a muraa qici'aten; ookkoneechchi uduma insa'ne mootumma dhallaaxx barra dagge'een.<verse eid="DAN 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 7:23" />«Isinna ane'n hiyyee qici, ‹Iikki Shoolgaki biniinchi tenne butta'n mootaaxxe sholgeessoxxe mootumma kaddaan; tinni mootumma edi darre hexxemmaxxe mootummuwwa duuchchinaa'n gargar hexxeexxe kaddeexxi butta duuchcha hirbeessita'ninna bulleessita'n galchitaan. <verse eid="DAN 7:23" /><verse number="24" style="v" sid="DAN 7:24" />Kunni tommi gaafuwwi eettene mootumma giddii'n ke'aake tomme moyanjuwwan; ookkoneechchi uduma konne moyanjuwwinaa'n gargar hedheek wele moyanji keexxi ookkone sase moyanjuwwa injifataan.<note caller="-" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="REV 17:12">Wal. 17:12</ref>. </char></note> <verse eid="DAN 7:24" /><verse number="25" style="v" sid="DAN 7:25" />Ookkone Lummoke'ninna afo'o fulchedhaan; woyyoole isixxanna miicaan; ayyaanuwwake murendeexxa yannaaranna seeruwwa jijjiiro'a wo'laana; woyyooletinna sase wogganna gamisakee anga isixxe'n sa'issende uwwendaan.<note caller="-" style="x"><char style="xo" closed="false">7:25 </char><char style="xt" closed="false"><ref loc="REV 12:14">Wal. 12:14</ref>; <ref loc="REV 13:5-6">13:5-6</ref>. </char></note><verse eid="DAN 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 7:26" />« ‹Ookkonneechchi uduma murte murenda; baalloomikinna isonaa'n adhdhemee'naa'a isinna duuchchi woddi'a balleessemaan. <verse eid="DAN 7:26" /><verse number="27" style="v" sid="DAN 7:27" />Ookkoneechchi uduma iimati butta hexxeexxe mootummuwwaxxi galcha baalloominna lumminni ookkone Lumokixxe woyyoole'a uwweemman. Mootumma isixxinna duuchchi woddixxe kaddaan; galchalluwwi duuchchinna isoo magenooffata'ne isi'a ajajemaan.›<note caller="-" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="REV 20:4">Wal. 20:4</ref>; <ref loc="REV 22:5">22:5</ref>.</char></note><verse eid="DAN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 7:28" />«Eettene oojjoti tika kaba qunqumende. Ani Daani'eeli, giddo yaadik yo'oshsha mekki hiyyenne; alayyikinna bifa ba'enne, kaddoolenna tenne yaane godoba galchedhenne.»<verse eid="DAN 7:28" /></para>
  <chapter eid="DAN 7" />
  <chapter number="8" style="c" sid="DAN 8" />
  <para style="s1">Dani'eeli Waleellati Uudeeka Re'etikenna Gedhebiinka Korbeessa</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 8:1" />Moyanji Bilxaasoor moyeexxe sakkaxxe wogga'n ane'n edi darre leelliteemmaxxe waleella uduma ani, Daani'eeli wele waleella uudenne. <verse eid="DAN 8:1" /><verse number="2" style="v" sid="DAN 8:2" />Tenne leella giddo ani Elaamike awuraajja'n Suusake umo qachchike kinjinke dalla'i giddo hedhennexxa afenne; eettene waleellaninna ani Ulaayike galaan qarqaranna uurrennani. <verse eid="DAN 8:2" /><verse number="3" style="v" sid="DAN 8:3" />Tami asse uudanno wodda ani edo kunnise lame gaafik gedhebiink korbeess galaan qarqara uurre'naa afenne; gaafuwwi isikinna qeerrarammakemman; gaafuwwakenaa'ninna mitti welekenaa'n qeerredhaan; isi quuxxisek kinni udu'meeteman. <verse eid="DAN 8:3" /><verse number="4" style="v" sid="DAN 8:4" />Iikki gedhebiink korbeessi dhidhimi darre'n, middi darre'ninna bita'i darre'n ifike gaafinni cifaa'naa afenne; mitti biniinchinna isoo ifinaa'n dande'e hoyyedheba'a; hunna isixxenaa'ninna dande'e baaje fuleek hedhemmabaan. Eeyyeexxa duuchcha asse; umo ifikanna lummise.<verse eid="DAN 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 8:5" />Waleella tennexxa yaane heda'ennenge'n lamiinxe illexxe oddo'n lumooka gaafa afe'eek recci buttinna kisebaang didhimii darrenaa'n butta duuchcha tansaasa'n dage. <verse eid="DAN 8:5" /><verse number="6" style="v" sid="DAN 8:6" />Isinna galaan qarqara uurree'naa uudennake lame gaafike gedhebiinke korbeessibaa lumoxxe aarenni yaasume dage. <verse eid="DAN 8:6" /><verse number="7" style="v" sid="DAN 8:7" />Ookkene gedhebiinke korbeessibaanna shiqe; isinna ookkone gedhebiinka korbeessa jabaxxe aarenni tumeexxi lamiinga gaafa isonaa'n enqe; isoo injifataaxxi hunnanna ookkone gedhebiinke korbeessa'n hexxemmaba'a; tennexxee iikki recci ookkone gedhebiinka korbeessa butta anxuqeexxi isi hana hirbeesse; ookkone gedhebiinka korbeessanna ookkone recconaa'n gatisa dande'eek hedhemmaba'a.<verse eid="DAN 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 8:8" />Iikki reccikinna yo'oshsha jabaate; yaane kinni ifi lummisatixxi hunna xungo geltee woddi isik lumok gaafi enqeme; eettene bakka'ninna shoole iimixxe diidalluwwa darre'n nophphaak lumolammi gaafuwwi fule. <verse eid="DAN 8:8" /><verse number="9" style="v" sid="DAN 8:9" />Konne shoole gaafuwanaa'n mitteke'n weli mitti shiixxok gaafi xuutti hiyye; isinna Bita'ake'ni, boroti darre'ninna ookkone eloke boga'n hunnati nophphe. <verse eid="DAN 8:9" /><verse number="10" style="v" sid="DAN 8:10" />Iimika sannachcha geyaa qici'anna nophphe; ookkone sannachchixxe urjuwwanaa'n butta ibiseexxi hana hirbeesse.<note caller="-" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="REV 12:4">Wal. 12:4</ref>. </char></note> <verse eid="DAN 8:10" /><verse number="11" style="v" sid="DAN 8:11" />Iimike sannachchik sooressinni ifi qixxeessati ifi lummise; barra barra'n isi'a shiqammaka tolchanna ifi'a adhdhe; isike woyyichcha galmixxa bakkanna battoosse. <verse eid="DAN 8:11" /><verse number="12" style="v" sid="DAN 8:12" />Jallotenaa'n kexxeexxa woyyichchi sannachchi barra barra'n shiqammake tolchinninni welti isi'a sa'isseme uwweme. Asseexxi duuchchi isi'a qajeelde; dhugaatinna butti'a hunende.<verse eid="DAN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 8:13" />Ookkoneechchi uduma woyyoletenaa'n mitti haaso'a'naa laqenne; weli woyyichchinna ookkone haaso'emmake woyyichcha'n, «Ookkone barra barrake tolchixxe, ba'netee buutote kaddeexxe jalloxxee, hirbeessamatee sa'isseme uwwemaake woyyichcha galmixxeenna sannachchixxee leelliteexxi leella muuxendaak haanote?»<verse eid="DAN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 8:14" />Qoremeemmak iikki woyyichchinna ane'ni, «Lame kumanna sase dhibba gorsanna galgala qici'aaten; ookkoneechchi uduma iikki woyyichchi galmi haaroba luqqi assemaan» hiyye.<verse eid="DAN 8:14" /></para>
  <para style="s1">Eettene Leellatixxe Tika</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 8:15" />Ani, Daani'eeli tenne leella uuda'n iseenni wo'monnaa hedanenge'ni manjo labaachchi ani edo uurre. <verse eid="DAN 8:15" /><verse number="16" style="v" sid="DAN 8:16" />Ulaayike galaanibaa'ninna, «Koo Gabiri'eel konne manjichcho'n tenne leellaxxa tika kul hiyya'n haaso'a'neeke manjichchika hafuura laqenne.»<note caller="-" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="LUK 1:19">Luq. 1:19</ref>, <ref loc="LUK 1:26">26</ref>. </char></note><verse eid="DAN 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 8:17" />Isinna an uurre'enaba'a shiqa'n dagee wodda alayyennexxi albik gonbisemenne. Isinna anee, «Koo manjinke beltoo, leella tinni udumike barixxeete kaddeexxa qalbeeffati» hiyye. <verse eid="DAN 8:17" /><verse number="18" style="v" sid="DAN 8:18" />Ane'n haaso'ande'ni hedhe'naa albik gonbisemenneba diiphe cokkokki hiyyenne. Isinna anee kise'e buttii'ni ke'isseexxi uurrise.<verse eid="DAN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 8:19" />Isinna ane'n hiyyee qici: «Tinni Leella muremeeke udumike baro'n kaddaaxxa yaane leellishshaaxxe kaddemmaxxee uduma ookkone mufetike baro'n maachchi kadaaxxa kunni ate'n kula'eennen. <verse eid="DAN 8:19" /><verse number="20" style="v" sid="DAN 8:20" />Iikki uuddettek lame gaafik gedhebiink korbeess Meedoonikenna Faarsike moyanjuwwa leellishaan. <verse eid="DAN 8:20" /><verse number="21" style="v" sid="DAN 8:21" />Iikki recci Girkeeke moyanjo kada wodda isixxe lame illexxe oddo'n hedheek lumok gaafi siretike Girikike moyanjon. <verse eid="DAN 8:21" /><verse number="22" style="v" sid="DAN 8:22" />Ookkone enqememmake gaafixxe bakka'n fule'emmak iikki shool gaafuwwi, eettene mootumanaa'n fuldaaxxa shoole mootummuwwa leellishaan; yaane kinni mitti mittinxi mootumma eettene siretixxe mootumma qicixxa hunna affaba'a.<verse eid="DAN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 8:23" />«Tenne mootummuwwaxxe udumike galchatika baro'n jalliyyetixxi fuggaalessumma hara xungo geltaa wodda, albi sodaachchisak godoba jabakik moyanji ke'aan. <verse eid="DAN 8:23" /><verse number="24" style="v" sid="DAN 8:24" />Isinna hara worbake kadaan; yaane kinni ifixxe hunnannitebaan; mancira hiyyissaaxxa ba'ne geessissan; assaaxxe duuchchanna isi'a qajeeldaan; jajjabba mannanna woyyoole arda muxuqqi assaan. <verse eid="DAN 8:24" /><verse number="25" style="v" sid="DAN 8:25" />Isinna sobiki durooman; ifinna lummisaan; nage'ik hedheeka heddo ardanna biraan; ookknee galchalluwwiinke galchallo'ninna ke'aan. Yaane kinni isi balleessemaan; balleessemaakinna manjinxe hunnannitebaan.<verse eid="DAN 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 8:26" />«Ate'ni kulendeexxi tinni galgalixxinna gorsixxi waleella dhugaateni; kaddo malee'e heddo wogga uduma kaddaaxxa yaane leellishshaaxxe kaddeemmaxxee waleella tenne'e buqqe abidi.»<verse eid="DAN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 8:27" />Ani, Daani'eeli kurbu hiyye'e heddo barra'anna elagophenne; ookkoneechchi uduma ke'ennexxi ookkone moyanjinxe huje'n me'enne; uudennexxi leella anee'e alalishite; isenna ane'ni aaggeemmabaani.<verse eid="DAN 8:27" /></para>
  <chapter eid="DAN 8" />
  <chapter number="9" style="c" sid="DAN 9" />
  <para style="s1">Daani'eel Ifike Ardixxee Soodateexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 9:1" />Meedoonichchi Arxeksiisik belti Daariyoosi Baabiloonixxe mootumma'ni moyeexxe siretixxe wogga'n, <verse eid="DAN 9:1" /><verse number="2" style="v" sid="DAN 9:2" />isixxe moweexxe taakkaxxe wogga'n ani Daani'eeli, Duuchchi Woddik Gootti, Iyyerusaalemi diigende turtaaxxi torbaane tomme woggaxxi muuxensha wabeeka Ermiyaasi darree'n haaso'emmaxxa woyyichcha maxaafi giddii'n qalbeeffatenne.<note caller="-" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="JER 25:11">Erm. 25:11</ref>; <ref loc="JER 29:10">29:10</ref>. </char></note> <verse eid="DAN 9:2" /><verse number="3" style="v" sid="DAN 9:3" />Tennexxee jooniyya seemma oddo'we bululoke'n ofo'lennexxi agabo goddo hedhe soodachchoteenna kadhatee alba dada duuchchik Gootti Mageninbaa wirri hiyyenne.<verse eid="DAN 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 9:4" />Cubbo anxa faa'ci'wa'n Duuchchi Woddike Gootta anke Magenibaa hiyye soodatenne qici, «Ate eeyyaakerininna ajaja atika heqqedhaakeri'a aaggettaxxa jaalalatixxa kako heqqexxattoke dada duuchchike Gootta Magenoo, <verse eid="DAN 9:4" /><verse number="5" style="v" sid="DAN 9:5" />no'o jalline cubbo hunjeenneni; balleessine fuggoxxe'ninna me'ineennen; atike ajajuwwinaa'ninna seera atikenaa'n uduma hingeennen. <verse eid="DAN 9:5" /><verse number="6" style="v" sid="DAN 9:6" />No'oke moyanjuwwa'n, no'oke galchalluwwa'n, no'oke edike annuwwa'n iittanni bogiinke arda duuchcha'n atike summinni haasotteexxa atixxa erganjuwwa wabeeko laqaginbeennen.<verse eid="DAN 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 9:7" />«Ee dada duuchchike Goottaa! Ati qulichchake; yaane kinn no'o ati'a xuurameeyyete kada gophatenaa'n kexxeexxinni ati no'oo xeertetteke boguwwa duuchcha'n he'nennek Yihudiink, Iyyerusaalemikinna duuchching Isira'eelik ardi bayyikinna kado shiqo he'nennek techchixxe barra'n shooko oddo'wineennen. <verse eid="DAN 9:7" /><verse number="8" style="v" sid="DAN 9:8" />No'oke Duuchchi Woddike Goottaa! Hunjennexxe cubbonaa'n kexxeexxa no'o, no'ok moyanjuwwi, no'ok ja'laabuwwinna no'ok edik annuwwi shooko odo'wineennen. <verse eid="DAN 9:8" /><verse number="9" style="v" sid="DAN 9:9" />Dada duuchchike Gootta no'oke Magenoo! No'o ate'ni jallantennaxxenna kaddoole ati gattowwaalikenna marartatoken. <verse eid="DAN 9:9" /><verse number="10" style="v" sid="DAN 9:10" />Duuchchi Woddike Gootta no'oke Mageni'a ajajemmebe'non; erganjuwwa isixxe wabeeko darree'n no'o'n uwweeka seeranna heqqe'nebe'no. <verse eid="DAN 9:10" /><verse number="11" style="v" sid="DAN 9:11" />Isira'eeliki ardi duuchchinna seera atika sa'edheen; atika ajajanna laqa gibeexxi udumi'a hige'een.</para>
  <para style="p" vid="DAN 9:11">«No'onna ate'n cubbo hunjennaxxee Mageniinka erganjo, Muuseke seerike maxaafa'n borreessendemmaxxi badinonna murte no'o'n dhangalaasseten. <verse eid="DAN 9:11" /><verse number="12" style="v" sid="DAN 9:12" />Jabaxxa ba'ne no'on iyyedagati no'o'ninna no'oke galcahlluwwa'n assiyyotee haasottettaka haaso'a muuxetteni. Iyyerusaalemi'ni assendeexxi yaane iimati butti'a haranga assendeba'a. <verse eid="DAN 9:12" /><verse number="13" style="v" sid="DAN 9:13" />Muuseke seerike maxaafa'n borreessendemmaxxe qixxe'n tinni ba'ne duuchchi no'o'n dagge; kaddo malee'e cubbo no'oxxenaa'ni ille iima higatinna dhugaa atixxa hordofati Duuchchi Woddika Gootta no'oke Mageninaa'n elle alfinebe'no. <verse eid="DAN 9:13" /><verse number="14" style="v" sid="DAN 9:14" />Duuchchi Woddike Gootti assaaxxe duuchchinni qullichchake kademmaxxee Duuchchi Woddik Gootti no'ok Mageni ba'ne no'o'ni geessissatenaa'n ille iima higeba'a; no'onna isi'a ajajemmebe'no.<verse eid="DAN 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 9:15" />«Ta'anna, atixxe jabaxxe anganni arda atika Gibtsee'n fulchitetteke, telchixxe barra qico'ninna hedhaaka gurra ifi'a adhdhitetteke ee dada duuchchike Gootta no'oke Magenoo! No'o cubbo hunjeenneni; ateenna balleessineenneni. <verse eid="DAN 9:15" /><verse number="16" style="v" sid="DAN 9:16" />Ee dada duuchchi Goottaa! Assitettaxxe qullummatixxe hujuwwa duuchchi'a, hite'e atixxa woyyitte kooba, Iyyerusaalemike qachchinaa'n atixxa mufe hiissedhi; cubbo no'oxxinna edike no'oke annuwwixxi balleessa Iyyerusaaleminna atik ardi no'oke qararaken hedheek duuchchi'a gaciffachchotik kade'eeni.<verse eid="DAN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 9:17" />«Ta'anna no'oke Magenoo anee erganjo atikixxa soodachchonna kadha laqi; ee dada duuchchike Goottaa! Atike summi'anni hite'e diigemeeke atike galmi'a alba ifi. <verse eid="DAN 9:17" /><verse number="18" style="v" sid="DAN 9:18" />Ee, anke Magenoo laqi; ille atixxenni rakko no'oxxanna summi atik itti ye'emeeke qachchixxa ba'ne uudi; no'o atee kadhanta'ennechchi no'oxxe qullummatixxeete kaddebaak atixxe lumoxxe marartexeeten. <verse eid="DAN 9:18" /><verse number="19" style="v" sid="DAN 9:19" />Ee, dada duuchchike Goottaa Caqas! Ee, dada duuchchike Goottaa gattowwaal hiyyi! Ee, dada duuchchike Goottaa! Hinaanexxa caqasse assi! Atike qachcha'ninna atike arda'n atik summi ye'emeemmaxxee anke Magenoo turtoxxe'e.»<verse eid="DAN 9:19" /></para>
  <para style="s1">Eetene Torbaane Tomme Torba</para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 9:20" />Ani haaso'a'ninna ifixxa cubbo'anna Isira'eelii'i anke ardixxa cubboo faaci'wa'n eettene isixxe woyyitte koobaxxeenna Duuchchi Woddika Gootta anka Mageno kadhata'n, <verse eid="DAN 9:20" /><verse number="21" style="v" sid="DAN 9:21" />ani soodata'ennenge'ni eettene edixxe waleella'n uudeennak manjichchi, Gabiri'eel galgalike tolchixxa yanna anibaa wiinamik phirrisa'n dage.<note caller="-" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="LUK 1:19-26">Luq. 1:19-26</ref>. </char></note> <verse eid="DAN 9:21" /><verse number="22" style="v" sid="DAN 9:22" />Isinna ane'n barriseexxi hiyyee qici, «Ta'a ani koo Daani'eeli ati'a beekkumakanna qalbeeffachcho uwwonna dageennen. <verse eid="DAN 9:22" /><verse number="23" style="v" sid="DAN 9:23" />Ati lumoshsha eeyyende'etteke kaddeettaxxee ati soodachcho eettene reefi saffettaxxa yanna'ninni hiisichchi ati'a uwweme'een; aninna tenneenni ate'n kulona'a dageenne. Tennexxee tenne erga hubat, leella teenenna qalbeeffati.<verse eid="DAN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 9:24" />«Xaqaro gatiso'aa, cubbo gabalo'aa, balleessa faaci'o'aa, duuchchi woddixxa qullumma iyyedago'a, waleellatanna raaga maxxanso'anna hara woyyitte bakkanna hariiro'a atike ardixxeenna atike woyyichcha qachchixxee torbaane tomme torba lalabende'een.<verse eid="DAN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 9:25" />«Tennexxe egendattoxxinna qalbeeffatattoxxi yaane; Iyyerusaalemi haarensendo'anna qamachchendo'a lallabi fulaaxxe yannanaa'n iikki Hariiremeek galchalli dagaa qico'n torbaane tomme torbanna jiyaane tommenna lame torba saxxaan; Iyyerusaaleminna ifike oruwwininna ifike dalla'uwwininni qammachchenda; kaddo malee'e tinni kaddaak rakkotixxe yanna giddoni. <verse eid="DAN 9:25" /><verse number="26" style="v" sid="DAN 9:26" />Eettene jaane tommenna lame torba uduma iikk Hariiremeek shiyemaan; isi'a gataachchi mittichchinna hedhebaan<note caller="+" style="f"><char style="fr" closed="false">9:26 </char><char style="ft" closed="false">Yookaan shiyemaan; </char><char style="fqa" closed="false">qofinni gataan yookaan shiyemaan; isi'a gataachchi mittichchi hedhebaan.</char></note>. Ookkone dagaake galchallik ardinna dageexxi Iyyerusaalemika qachchanna ookkone woyyichcha galma diigaani; tenne yaannexxi muuxenshanna lola'iinsha daggaani; muuxamii qico'ninna bagedi kadaan; ba'netinna lallabende'een. <verse eid="DAN 9:26" /><verse number="27" style="v" sid="DAN 9:27" />Iikki sooreessinna mitte torba heddi manninni jabaxxa kako aagaani; eettene torbake gimisa'n shiqammaka tolchanna uwwa gatisaani; lallabendeexxi murte iso'n muuxendaa qico'ni ba'ne iyyedagaaxxa battitte yaane, ookkone woyyichchi galmi giddo<note caller="+" style="f"><char style="fr" closed="false">9:27 </char><char style="ft" closed="false">Yookaan</char><char style="fqa" closed="false">isi hana</char></note> uurrisaani<note caller="+" style="f"><char style="fr" closed="false">9:27 </char><char style="ft" closed="false">Yookaan</char><char style="fqa" closed="false">ookkone diigemeeke qachcha'n iitti lallabendeemmaxxi murte dangalaata qico'ninna iitti lallabendeemmaxxi ba'ne diqachchiisaake qachchi hana daggaan. </char></note>.»<note caller="-" style="x"><char style="xo" closed="false">9:27 </char><char style="xt" closed="false"><ref loc="DAN 11:31">Dan. 11:31</ref>; <ref loc="DAN 12:11">12:11</ref>; <ref loc="MAT 24:15">Mat. 24:15</ref>; <ref loc="MRK 13:14">Mar. 13:14</ref>. </char></note><verse eid="DAN 9:27" /></para>
  <chapter eid="DAN 9" />
  <chapter number="10" style="c" sid="DAN 10" />
  <para style="s1">Daani'eeli Waleellati Uudeeka Manjichcho</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 10:1" />Faarsik moyanji Qiroosii moyeexxe sakkaxxe wogga'n Bilxaasoor hiyyemeeka Daani'eeli'n waleella leellitte. Tenne waleellaxxi erganna dhugaate; isenna jabake bagedo uudaaxxe yaanexxemman; tenne erganna qalbeeffataashsha leellat qalbeeffachcho isi'a uuwwende.<verse eid="DAN 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 10:2" />Eettene yanna ani, Daani'eeli sase torba oodhenne. <verse eid="DAN 10:2" /><verse number="3" style="v" sid="DAN 10:3" />Iitti sase torbuwwa muuxendaa qici'a eloxxa ita itebe'no, maali yookaan woyinetixxi booka afo'o anka maqqeba'a; qibaatetanna issatebe'no.<verse eid="DAN 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 10:4" />Taakkake agenjixxe lame tommenna sholgaxxe barra ani lumoke Xegirosike galaan qarqara uurre'enege'n <verse eid="DAN 10:4" /><verse number="5" style="v" sid="DAN 10:5" />tami asse uudanno wodda kunse ani edo layinotixxa seemma odo'weexxi yo'oshsha ca'ite worqeke sabbatinni hidha usudhdheeka manjichcho afenne. <verse eid="DAN 10:5" /><verse number="6" style="v" sid="DAN 10:6" />Bisi isikinna birle hiyyemeeke fiixe kinjo laba'emman; albi isik banqotishsha, illuwwa isixxi bubbammaxxe giirashsha, isixxi hirruwwanna lekkuwwa holateek sageettotike sibiljishsha cala cala hiyyaak hafuur isikinna heddo mannike hafuurishshatemman.<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="REV 1:13-15">Wal. 1:13-15</ref>; <ref loc="REV 2:18">2:18</ref>; <ref loc="REV 19:2">19:2</ref>. </char></note> <verse eid="DAN 10:6" /><verse number="7" style="v" sid="DAN 10:7" />Tenne leella uuda'ennak ante, Daani'eeli callamman; aninni welt hedhemmak manni isee uudebaani; yaane kinni yo'oshsha alanne'e qexerrii hineemmaxxee baanje shoomme. <verse eid="DAN 10:7" /><verse number="8" style="v" sid="DAN 10:8" />Tennexxee tenne waleella uuda'n an calli qof gatenne; hunna anenaa'n xo'o hite'na'aa albi duuchchinni gola'le hunna gophenne. <verse eid="DAN 10:8" /><verse number="9" style="v" sid="DAN 10:9" />Aninna ookkone manjichchika hafuura laqenne wodda ifi haake buttinake'n albik gonbisemenneni. <verse eid="DAN 10:9" /><verse number="10" style="v" sid="DAN 10:10" />Ookkoneechchi uduma mitte anga ane'e qaqqabbe; aninna roqoonsaa'naa angatinna gulubik anee uurrise.<verse eid="DAN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 10:11" />Iimik Erganjinna anee, «Lumooshsha eeyyendetteke koo Daani'eeli! Ani atiba ergeme dage'ennaxxee ate'n haaso'annexxe yaane laqqotta'a kexxe uurri» hiyye; aninna roqoonsa'n ke'e uurrenne.<verse eid="DAN 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 10:12" />Higgeenna anee hiyyee qici, «Koo Daani'eeli! Sodaattooxxe'e! Ege'na alfatee Magen edo ifi salphisatee mudhdhitettexxe siretixxe barranaa'ninni soodachcho atixxi laqende'eeni; aninna atixxe soodachchoka hiisichcho iyyeedageenneni. <verse eid="DAN 10:12" /><verse number="13" style="v" sid="DAN 10:13" />Yaane kinni Faarsixxe mootummake sooreessa kadeek hafuuri lame tommenna mitte barra'a ane moromeni. Ookkoneechchi uduma ani ookko Faarsixxe mootumma giddo qofitt gatennaxxee erganatike umiinke sooreessuwwinaa'n kade'eek Mika'eeli anee gargaro'a dage.<note caller="-" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="REV 12:7">Wal. 12:7</ref>. </char></note> <verse eid="DAN 10:13" /><verse number="14" style="v" sid="DAN 10:14" />Tenne waleellaxxe muuxensha'a heddi bar gata'emmaxxee, heger atike arda'n kaddaaxxa ate'n leellishonnaa ta'a atibaa dage'ennen.»<verse eid="DAN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 10:15" />Isi tenne ane'n haaso'aa wodda albik butta gonbisemennexxi bucuqqi hiyyebe'no. <verse eid="DAN 10:15" /><verse number="16" style="v" sid="DAN 10:16" />Ookkoneechchi uduma manjo labaak anga qeerriseexxi sume anxa kise; aninna ofo'i baneme'naa haaso'ate'n ke'enne. Ani edo uurre'emmake'n hiyyeenne qic, «Anke goottaa! Tenne waleellanaa'n kexxeexxa lumoshsha wixixxi hiyye hunna gophenne. <verse eid="DAN 10:16" /><verse number="17" style="v" sid="DAN 10:17" />Koo anke goottaa an atik garbichchi hittata atee anke goottinni dande'e haaso'annota? Hunna gophenne, hafuurkinna anenaa'n mudeeni.»<verse eid="DAN 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 10:18" />Higgeenna manjo labammak iikki anee kiseexxi jabeesse. <verse eid="DAN 10:18" /><verse number="19" style="v" sid="DAN 10:19" />Isina anee, «Koo lumooshsha eeyyende'etteke manjoo, mee Sodaati; nage'i atinni hedhowwaal; jabaat, worbi» hiyye.</para>
  <para style="p" vid="DAN 10:19">Isinna ane'n haaso'e wodda hunna jabaatennexxi, «Anke gootta hunna anee jabeessitettexxenni haaso'i» hiyyene.<verse eid="DAN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 10:20" />Isinna anee, «Ani atiba mayee dagenexxa egendeette? Faarsixxe mootumak sooreessa kade'eeka hafuura lolonna'a hirbake'n ille iima higannon; ani me'onnole Girkeexxe mootumak sooreessi kade'eek hafuur dagaan» hiyye. <verse eid="DAN 10:20" /><verse number="21" style="v" sid="DAN 10:21" />Yaane kinni Dhugaatike Maxaafi giddo borreessendeexxa edisennexxi ate'n kulannon; konne sooreessa kade'eeke hafuuruwwinni lolemonna'a ha'nooke sooreessa kadeeke Mika'eelii'i malee anee gargarak hedheba'a.<verse eid="DAN 10:21" /></para>
  <chapter eid="DAN 10" />
  <chapter number="11" style="c" sid="DAN 11" />
  <para style="p">
    <verse number="1" style="v" sid="DAN 11:1" />Medoonichchi Daariyoosi moyexxe siretixxe wogga'n ani isoo gargaronna'anna isi'a faachcheffatonna'a isi bira uurre'enan.<verse eid="DAN 11:1" /></para>
  <para style="s1">Gibtsekanna Sooriyaka Moyanjuwwa</para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 11:2" />«Ta'a ani ate'n kula'ennechchi dhugaaten: Isinna ane'n weli sasi moyanjuwwi Faarsi giddo moyaan; itti aanaak sholgak moyanji wele konne moyanjuwwi duuchchinaa'n sa'aake dureessa kadaan. Isi durummatixxa hunna jabeessedheexxa yanna Girkeexxe mootumma'n wele duuchchi ke'aashsha assaan. <verse eid="DAN 11:2" /><verse number="3" style="v" sid="DAN 11:3" />Ookkoneechchi uduma lumoxxe hunnakinna fedhii ifixxishsha assaak gootti moyanji moyaan. <verse eid="DAN 11:3" /><verse number="4" style="v" sid="DAN 11:4" />Yaane kinni isi yo'oshsha hunnamessake kadaa wodda mootumma isixxi diigende shooliini darre'ni qoodendaan; isixxe bakka'ni horet isixxe kadebaak moyanjuwwi tukkeesseman. Kaddo malee'e insa'ne giddii'ni mittikinna isishsha hunna afabaan. Tinninna kaddaachchi iiti mootumma diigende'na'a higgeenn welekee qoodendammaxxeten.<verse eid="DAN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 11:5" />«Bita'ik moyanji lumooshsha jabaata; kado malee'e isik bagediinke ajajalluwwinaa'n mitti isinaa'n sa'eexxi jabaatee'na'a mootumma isixxinna jabaxxa hunna affeexxe kadda. <verse eid="DAN 11:5" /><verse number="6" style="v" sid="DAN 11:6" />Shiixxooxxe wogguwwa uduma weli aangeexxi mitteke kanda; Bita'ik moyanji weli aaggotee ifixxa belto Middike moyanjo'n heerunsiisa; yaane kinni ise affemmaxxa hunna gophpha; isotenna kadi hunna isixxi turtaba'a; ookkone baruwwa'n ise ifixxe mootumake erganjuwwinni, ifike anninninna isee kiphammarni welti sa'issendeexxi uwwenda.<verse eid="DAN 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 11:7" />«Yaane kinni iseke firanaa'n mitti bakka isexxa abido'a ke'a; Middike moyanjika sannachchuwwininna lolemma; kollo insa'nexxanna enqe e'yeexxi insa'ne injifata. <verse eid="DAN 11:7" /><verse number="8" style="v" sid="DAN 11:8" />Insa'neka magenuwwa, insa'nexxa sibiliinxa misuluwwanna insa'neka ulfaateeka birretike sibilkanna worqetika mi'uwwa booji'eexxi Gibtsee'a adhdhe me'aani; shiixxoxxe wogguwwa'anna Middike moyanjinni lolema waala. <verse eid="DAN 11:8" /><verse number="9" style="v" sid="DAN 11:9" />Ookkoneechchi uduma Middik moyanji Bita'ike moyanjika boga lolaani; yaane kinni ifike bogibaa ille iima higaani. <verse eid="DAN 11:9" /><verse number="10" style="v" sid="DAN 11:10" />Sooriyake moyanjixxi labbaxxi oosenna lolakee qixxeeffattaani; naaphiinxa kollo qico'n marte loliyyoti, dande'emmabaake lola'iinsha fiyaaka lumoka sannachcha bukki assitaani.<verse eid="DAN 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 11:11" />«Ookkoneechchi uduma Bita'ik moyanji mufet ke'eexxi Middika moyanjo lolaani; middik moyanji lumooka sannachcha bukki assoolenna midde injifatemaan. <verse eid="DAN 11:11" /><verse number="12" style="v" sid="DAN 11:12" />Bita'ik moyanji heddo sannachcha booji'eexxa yanna hollati ifi duka; heddo kumuwwa'ni laakko'emaaka mannanna shiya; kaddo malee'e injiffachcho eettenenni hedhabaani. <verse eid="DAN 11:12" /><verse number="13" style="v" sid="DAN 11:13" />Middik moyanji edikinenaa'n sa'aaka wele sannachcha bukki assa; heddo wogguwwa uduma loliinka miya geyaa qico'n ka'leeke jabake sannachchinni welt ille iima hige dagaan.<verse eid="DAN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 11:14" />«Ookkone baro'ni heddi manni Bita'ike moyanjo'n ke'a. Tenne waleella'n leellitemmaxxi yaanuwwanna muuxendo'a atike ardi giddii'n heddi jallichchi manni ka'aani; kaddo malee'e insa'ne'a qajeeldabaani. <verse eid="DAN 11:14" /><verse number="15" style="v" sid="DAN 11:15" />Middik moyanjinna dage buttina tullubeexxi kinjiinke dalla'ika qachcha abidaani; Bita'ik moyanjinna faachcheffataaxxa hunna afaba'a; muxxe fuleek insa'nek loliink sannachchi midde uurre dande'e lolabaan. <verse eid="DAN 11:15" /><verse number="16" style="v" sid="DAN 11:16" />Iikki lolammaki eeyyeexxe assaani; ayyinna dande'e isoo uurre lolabaani; ookkone Eloka Boga galchaan; isonna balleessaaxxa hunna afaani. <verse eid="DAN 11:16" /><verse number="17" style="v" sid="DAN 11:17" />Ifixxe mootumma giddo hedheeka sannachchi duuchchinni dagatee mudhdhaani; naaphiinxa mootummanna ibisatee ifixxa belto iso'ni heerunsisaan; kaddo malee'e yaadi isik qajeelabaan yookaan isi'anna woyif ulabaani. <verse eid="DAN 11:17" /><verse number="18" style="v" sid="DAN 11:18" />Ookkoneechchi uduma abbaayyatixxe gabala'ni hedheeka boguwwibaa wirri hiyyeexxi konnerinaa'n heddo abida; yaane kinni bagediink mitti ajajalli holla isixxa isonaa'n balleessaani; hollatika isika haaso'anna iso'ninni muuxemaashsha assa. <verse eid="DAN 11:18" /><verse number="19" style="v" sid="DAN 11:19" />Ookkoneechchi uduma ifike boga'n hexxeexxe kolluwwaba'aa ille iima higaan; yaane kinni guggufate ibaani; langaxxanna afemabaani.<verse eid="DAN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 11:20" />«Isixxe bakka'inni tukke dagaakinna, isixxe mootummaka ulfinna heqisatee irbo bukka ssaaka ergaan; kaddo malee'e mufet yookaan bagedik kaddebaang heenoxxe yanna giddo shiyema.<verse eid="DAN 11:20" /></para>
  <para style="s1">Mararte Afebaaka Sooryaka Moyanjo</para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 11:21" />«Isixxe bakka'n tukke dagaakinna mootummatika ulfinna isi'a uwwabaak tuffatemeeke manjon; isi ardi nage'ik afo'le hedhe'naanni laana dageexxi dedhiseexxi mootumma eettene abixxa. <verse eid="DAN 11:21" /><verse number="22" style="v" sid="DAN 11:22" />Ookkoneechchi uduma isi edo hedhaak, ookkone kakotike sooreessa kadeeki gatebaang lamiing mitteba kutti hiyyaan. <verse eid="DAN 11:22" /><verse number="23" style="v" sid="DAN 11:23" />Isinni welt weli aageechchi uduma dedhisatixxa huje huja; heenok manninni weltinna baalloomaan. <verse eid="DAN 11:23" /><verse number="24" style="v" sid="DAN 11:24" />Duromeeke awuraajuwwi nage'ik hedhe'neenge'n dageexxi konee awuraajuwwa abixxa; isike edike annuwwik annuwwinna assebaaxxa yaanenna assaan; isi'anna qajeeldaani; mulqedhemmaachcho, booji'emaachchonna karra duuchcha ifixxe hordofeeyye'a qoodaani; kolluwwatanna miidho'a yaada abixxa; tenneenna assaak heenoxxe yanna calla'aten.<verse eid="DAN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 11:25" />«Lumoka sannachcha qixxeesseexxi hunnatinna onno'ati Bita'ike moyanjo'n ke'isiisa; Bita'ik moyanjinna laakkossi hara bira sa'eeka, hunnamessa sannachcha abixxeexxi bagedo bana; yaane kinni isi'a migiremeeke yaadanaa'n kexxeexxa isi'a qajeeldabaani. <verse eid="DAN 11:25" /><verse number="26" style="v" sid="DAN 11:26" />Moyanjiinxe qorenaa'n welt ita'ammakiir isoo balleessatee ke'aani; sannachchi isikinna kurbu assemmaan; heddi manninna bagedoke'n reyaan. <verse eid="DAN 11:26" /><verse number="27" style="v" sid="DAN 11:27" />Godobi insa'nek fuggoxxibaa dooqeek lami moyanjuwwi mitte qore'n ito'a mitteba'a ofo'leexxi weli'anni weli dhara haaso'a; yaane kinni murendeexxi yanna geya gophpheemmaxxee insa'ne'a qajeeldaba'a. <verse eid="DAN 11:27" /><verse number="28" style="v" sid="DAN 11:28" />Middik moyanji lumoxxa karranni ifike bogibaa ille iima higa; kaddo malee'e godobi isik fuggoxxenni eettene woyyitte kako'n hedha; ise'n hedeexxa asseechchi uduma ifike bogiba'a ille iima higaani.<verse eid="DAN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 11:29" />«Eettene murendeexxe yanna'n ille iima higeexxi langaxxa ookkonee Bita'ika boga abida; kaddo malee'e eettene yanna'n kaddaaxxi yaane edi woddixxenaa'n gargar hexxeexxe kadda. <verse eid="DAN 11:29" /><verse number="30" style="v" sid="DAN 11:30" />Qophiroosik markabuwwinni dangeexxi isoo lollaammaxxee, isinna godoba gura; hige dageexxi jabaxxe mufenni eettene woyyitte kako'n ke'aan; ille iimanna higeexxi eettene woyyitte kako waalemmakaara eloxxenni uudaan.<verse eid="DAN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 11:31" />«Isik loliink sannachchi ookkonee woyyichcha galmanna dalla'a battoossatee ke'eexxi duuchchi woddika tolchanna gataashsha assa; ba'ne iyyedagaaxxa battitte yaanenna uurrisaan.<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="DAN 9:27">Dan. 9:27</ref>; <ref loc="DAN 12:11">12:11</ref>; <ref loc="MAT 24:15">Mat. 24:15</ref>; <ref loc="MRK 13:14">Mar. 13:14</ref>. </char></note> <verse eid="DAN 11:31" /><verse number="32" style="v" sid="DAN 11:32" />Kako digaakara duuchcha, moyanji sobik dedhisaan; Mageno ifika ege'neek ardi duuchchi kinni jabaate isoo ifinaa'n hoyyedhaan.<verse eid="DAN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="DAN 11:33" />«Yaanetee insa'ne wolaantichchik shiyemoole gubemoole, booji'emoolenna mulqemoole beekolete kadeek manni heddo manna barachchiisaan. <verse eid="DAN 11:33" /><verse number="34" style="v" sid="DAN 11:34" />Insa'ne tenne rakko'n inbaa wodda shiixxoka gargaarsa gargaaremma; heddi manninna dharik insa'nenni welti mitteke kada. <verse eid="DAN 11:34" /><verse number="35" style="v" sid="DAN 11:35" />Tenne beekkolenaa'n mitti mitti manni muuxamiinke bari qico'n qorqorsemo'a, luqqi hiyyo'anna ca'a hiyyo'a ibaan; tinni yaanenna kaddaaki iitti murendeexxi yanna geltaa qico'niten.<verse eid="DAN 11:35" /></para>
  <para style="s1">Hollati Ifi Lummisaaka Moyanjo</para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 11:36" />«Iikki moyanji eeyyeexxa assaani; isinna wele magenuwwi duuchchinaa'n ifi lummisaani; magenuwwiinge umo kadeeke Mageno'ninna hollatika afo'o fulchedhaani; iitti murendeexxi muuxema hasissammaxxee Mageniinxi aare muuxendaa qici'a isi'a qajeeldaan.<note caller="-" style="x"><char style="xo" closed="false">11:36 </char><char style="xt" closed="false"><ref loc="2TH 2:3-4">2 Tes. 2:3-4</ref>; <ref loc="REV 13:5-6">Wal. 13:5-6</ref>. </char></note> <verse eid="DAN 11:36" /><verse number="37" style="v" sid="DAN 11:37" />Isinna ifike edike annuwwika magenuwwa bashshi hiyya; melaalle eetaaka magenuwwanna tuffata; wele magenuwwi iimi darrenna ifi lummisammaxxee wele magenuwwa mittichishshanna laako'aba'a. <verse eid="DAN 11:37" /><verse number="38" style="v" sid="DAN 11:38" />Konneer irra kollo heqqaaka mageno ulfeessa; edik isik annuwwi ege'nebaake mageni'a worqe, birret sibilo, fiixxeexxa kinonna wele fiixxa uwwaara, uwwiyyot ulfeessa. <verse eid="DAN 11:38" /><verse number="39" style="v" sid="DAN 11:39" />Kolluwwa isixxa isi'a heqinaashsha alaga mageno magenooffataaka manna la'ooffataani; galcha isixxa eeyyake duuchchi'anna lumoka ulfinna uwwiyyot lumoxxe baalloomma'n insa'nee ofo'lishaani; isi'a assineexxe yaanexxeenna boga insa'ne'a qoodaani.<verse eid="DAN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="DAN 11:40" />«Ookkone muuxamiinke baro'n Bita'ik moyanji iso'n lolik ke'aan; Middik moyanji fadhadikinna sarageelluwwik heddo markabuwwinni isoo jabaxxe hunnanni lolaan; heddo boguwwanna abixxaan; lola'iinshanna fiya'n konne boguwwixxe oddonaa'n sa'aan. <verse eid="DAN 11:40" /><verse number="41" style="v" sid="DAN 11:41" />Isinna ookkone Eloke Bogibaa e'yaani; heddo boguwwinna anga isixxe'n ibaan; kaddo malee'e Eedoomik, Mo'aabikinna Amoonik akeekisanjuwwi anga isixxenaa'n gataani. <verse eid="DAN 11:41" /><verse number="42" style="v" sid="DAN 11:42" />Heddo boguwwanna abixxaan; Gibtseek boginna gataba'a. <verse eid="DAN 11:42" /><verse number="43" style="v" sid="DAN 11:43" />Gibtseexxe worqexxinna birretika sbiljixxa tuulo iittanni isexxi karra duuchcha ifixxe assedhaan; Tophiyiinki, Libiyaki manninna isi'a hiremaan. <verse eid="DAN 11:43" /><verse number="44" style="v" sid="DAN 11:44" />Yaane kinni borotenaa'ninna middii'n daggaaxxi odo isoo alalshitaan; heddo manna balleessateenna biratee jabaxxe mufenni ke'aan. <verse eid="DAN 11:44" /><verse number="45" style="v" sid="DAN 11:45" />Moyanjummatixxa ifika dunkaanuwwa, abbaayyuwwatixxxe oddo'n hexxeexxe eettene dancha woyyitte kooba'n oltaa; kaddo malee'e muuxamake'n isinni ba'aan; ayyinna isoo gargaaraak ayyinna hedhaba'a.»<verse eid="DAN 11:45" /></para>
  <chapter eid="DAN 11" />
  <chapter number="12" style="c" sid="DAN 12" />
  <para style="s1">Reyeek Manni Ke'aaxxa</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 12:1" />«Ookkone baro'n atike ardixxee uuraki lumoki sooreessi Mika'eeli ke'aan; manjiinxi sanne dadendeexxe yannanaa'n ookkone bari qico'n kade ege'nebaaki rakkotik bari dagaan. Yaane kinni eettene yanna'ni summi insa'nek ookkone Maxaafa'ni borreessemaake atik ardi duuchchi mitti mitting anjiremaan.<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="MAT 24:21">Mat. 24:21</ref>; <ref loc="MRK 13:19">Mar. 13:19</ref>; <ref loc="REV 7:14">Wal. 7:14</ref>; <ref loc="REV 12:7">12:7</ref>. </char></note> <verse eid="DAN 12:1" /><verse number="2" style="v" sid="DAN 12:2" />Reyeexxi buttinake kade'emmaki manni duuchchinaa'ni heddi ke'aani; weli duuchchi woddixxe hedho'n e'yaa wodda wel kinni shookokeenna duuchchi woddike salphini'a ke'aan.<note caller="-" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="ISA 26:19">Isa. 26:19</ref>; <ref loc="MAT 25:46">Mat. 25:46</ref>; <ref loc="JHN 5:29">Yoh. 5:29</ref>. </char></note> <verse eid="DAN 12:2" /><verse number="3" style="v" sid="DAN 12:3" />Beekkoletinna iimike ifishsha, heddo mannanna qullummatike ora'n hiisaakiir iimixxe urjeshsha duuchchi woddi'a ifaan. <verse eid="DAN 12:3" /><verse number="4" style="v" sid="DAN 12:4" />Koo Daani'eeli atik kinni iitti muuxxematixxi yanna daggaa qici'a, konee maxxaafika hiyyichchi cufe, iso'ninna maxans; heddi manni eleqe kayya gongaan; ege'natinna bira saxxaan.»<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="REV 22:10">Wal. 22:10</ref>. </char></note><verse eid="DAN 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 12:5" />Ookkoneechchi uduma ani Daani'eeli lami manni galaan qaraqara mitti wido, mitti kayyii'n uurree'naa afenne. <verse eid="DAN 12:5" /><verse number="6" style="v" sid="DAN 12:6" />Lamekenaa'n mitti, Layinotixxa seemma odo'weexxi galaani ali darre hedhammaka manjichcho, «Tinni maso yaanuwwa muuxematee hitteexxe yanna gattaa?» hiyye.<verse eid="DAN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 12:7" />Iikki layinotixxa seemma odo'weexxi galaanii ali darre hedhemmak manjichchi, ifixxa middixxanna bita'ixxa anga iimi'a ke'isseexxi «Woggatee, wogguwwatee woggatike gamisi'aate kaddaan; ookkone woyyichchi mannixxi hunna, xeerensha muuxendaaxxa yanna tinni yaane duuchchi muuxendaan» hiyya'n isoo duuchchi woddi'a hedhaakenni kakata'naa laqenne.<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="REV 10:5">Wal. 10:5</ref>; <ref loc="REV 12:14">12:14</ref>. </char></note><verse eid="DAN 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 12:8" />Aninna laqennen yaane kinni qalbeeffatebe'no; tennexxee «Anke Goottaa, tenne duuchchixxi muuxensha maachcho?» hiyye qorenne.<verse eid="DAN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 12:9" />Isinna ane'n hiyye hiisse haaso'ee qic, «Koo Daani'eeli kunni hiyyichchi muuxamiinke bari qico'n buqemeekenna maxxansemeeke kademaxxee yoona ati me'i. <verse eid="DAN 12:9" /><verse number="10" style="v" sid="DAN 12:10" />Heddi manni qorqorsemaan, luqqi hiyyaan; ca'a hiyyaan; fuggaalless manni kinni ifinxe fuggo assitaan; fuggaaleyyetenaa'n mittikinna qalbeefataba'a; beekkole kinni qalbeeffattaan.<note caller="-" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="REV 22:11">Wal. 22:11</ref>. </char></note><verse eid="DAN 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 12:11" />«Iikki Barra barrak tolchi gateexxe yannanaa'ninna ba'ne iyyedaggaaxxi battitte yaane, kaasendeexxe yannanaa'n mitte kuma lame dhibbanna sallane tomme barra kaddaan.<note caller="-" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="DAN 9:27">Dan. 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="MAT 24:15">Mat. 24:15</ref>; <ref loc="MRK 13">Mar. 13</ref>; <ref loc="MRK 14">14</ref>. </char></note> <verse eid="DAN 12:11" /><verse number="12" style="v" sid="DAN 12:12" />Ossaakinna mitte kuma sase dhibba, sase tommenna onde barraxxa muuxensha geyaak eebbisemeeken.<verse eid="DAN 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 12:13" />«Koo Daani'eel ati kinni muuxamii qico'ni me'i; lummexxaton; eettene muuxamiinxe barruwwa udumanna kexxettexxi ati'a dhaabemeeka geego adhdhittaton.»<verse eid="DAN 12:13" /></para>
  <chapter eid="DAN 12" />
</usx>