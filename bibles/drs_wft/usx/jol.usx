<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Gedeo Bible</book>
  <para style="h">Iyyuu'eelikaa Raaga</para>
  <para style="toc1">Iyyuu'eelikaa Raaga</para>
  <para style="toc2">Iyyuu'eelikaa Raaga</para>
  <para style="toc3">Iyu.</para>
  <para style="mt1">Iyyuu'eelikaa Raaga</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Wabeeki Iyyuu'eeli hoone baro'ni hedhemmaxxanna wo'ma isixxa jirtexxee adda egene'ndeexxi yaane hexxeba'a. Kaddo malee'e kunni Iyyuu'eeliki maxaafi afemeek kiristoosixxe ilensha edi darre sholgaxxe yookaan ondixxe dhibba woggake qarqara'ni kadeexxe hedendaan. Iitti yannanna faarisixxi mootumaxxexxe yanna hiyyaten. Iyyuu'eel Isira'eelike boga giddo jabaki awwaaneesiink haagan dagaaxxa yannanna jabaxxe ba'ne geessissaaxxi bange kaddaaxxa yanna ifisaan; tenni kaddeexxi yaanuwwanna Goottiinxe dagaxxi barra shiqqeexxa leellishaaxxe kaddeexxa haaso'een; Goottiinxi barranna dagaa wodda Mageni ifixxa woyyitte fedhii xa'naaka duuchcha mura woxisaaxxa tenneenna itti lebeexxi haasoaan. Kunni wabeek iikki ardi aadde aagaashsha Mageniinka ye'injo ifisati, aadde angeexxe kaddoole edixxe insa'nexxe jirobaa insa'nee ille iima hiissaati insa'nee eebbisaaxxa addachchiisaan; konne raagi giddo aadda leellaak addachchiisatik hiyyichchi, Mageni labba meyake'n dargageeyyete'ninna geedhete'n, iittanni arda duuchcha'n Ifika Hafuura dirrisaaxxa haaso'aaken.</para>
  <para style="iot">Konne Maxaafi Giddo Heexxeexxa Yaanuwwa</para>
  <para style="io1">Awwaaneesakanna Naaphiinke bagedika sannachcha <char style="ior"><ref loc="JOL 1:1-2:17">1:1—2:17</ref> </char></para>
  <para style="io1">Duuchchi Woddike Goottixxa barra <char style="ior"><ref loc="JOL 2:18-32">2:18-32</ref> </char></para>
  <para style="io1">Duuchchi Woddik Gootti gosa gosaka arduwwa mura woxisaaxxa <char style="ior"><ref loc="JOL 3:1-21">3:1-21</ref> </char></para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />Baatu'eelika belto Iyyuu'eelibaa daggeek Duuchchi Woddik Goottik hiyyichchi konneechchi butta hedheeken:<verse eid="JOL 1:1" /></para>
  <para style="s1">Awwaaneesiink Haagani Iyyedageexxa Ba'ne</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2" />Ha'no geedhe tenne laqqe;</para>
  <para style="q2" vid="JOL 1:2">tenne butta'ni hexxina'neek duuchchiing caqasse;</para>
  <para style="q1" vid="JOL 1:2">Ha'noke baro'ninna kaddo edike ha'noke annuwwike baro'ni</para>
  <para style="q2" vid="JOL 1:2">iitta hexxeexxi yaane meya kadde egendee?<verse eid="JOL 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3" />Tenne yaane oose ha'nooxxe'ni haaso'we;</para>
  <para style="q2" vid="JOL 1:3">oose ha'nooxxinna ifixxe oose'ni haasotowwaal;</para>
  <para style="q2" vid="JOL 1:3">insa'neexxi oosenna iitti andaaxxe illa'n haasottowwaal.<verse eid="JOL 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4" />Daarrekenaa'n gateechcho awwaaneessi ite;</para>
  <para style="q2" vid="JOL 1:4">oosichchi awwaaneessinaa'ni gateechcho</para>
  <para style="q1" vid="JOL 1:4">Dargaggeessi awwaaneessi ite;</para>
  <para style="q1" vid="JOL 1:4">Dargaggeessi awwaaneessi itaa'naa gateechcho</para>
  <para style="q2" vid="JOL 1:4">lumolli awwaaneessi ite.<verse eid="JOL 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5" />Ha'no machcho'alluwwi kexxine oodhe</para>
  <para style="q2" vid="JOL 1:5">ha'no woyyinetixxa booka ha'witinaak duuchchi woo hiyye;</para>
  <para style="q1" vid="JOL 1:5">Afo'o ha'nokenaa'n hoyyendemmaxxee;</para>
  <para style="q2" vid="JOL 1:5">reefixxe woyinetixxe booka'a woo hitine oodhdhe.<verse eid="JOL 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6" />Laakkossi iimi darre hedheek hunnaameessi ardi</para>
  <para style="q2" vid="JOL 1:6">boga anka gume abixxemmaxxee</para>
  <para style="q1" vid="JOL 1:6">Isso isixxinna neeqiinxe issoshsha,</para>
  <para style="q2" vid="JOL 1:6">qeqqeshshi isikinna meyyake neeqiinke qeqqeshishshaten.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="REV 9:8">Wal. 9:8</ref>. </char></note><verse eid="JOL 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7" />Isinna aninna anxa woyinetixxa bakka duwwi gatise;</para>
  <para style="q2" vid="JOL 1:7">anka belesetika haqichchuwwa kukkuteexxi,</para>
  <para style="q1" vid="JOL 1:7">Isixxi damuwwanna gola'lte leellitaa qico'n</para>
  <para style="q2" vid="JOL 1:7">isixxa quncuwwanna cooqe,</para>
  <para style="q2" vid="JOL 1:7">hune.<verse eid="JOL 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8" />Dubarichcho isi'a uwwendeek reyee'naa yaaddotixxa seemma oddo'witeexxi ooxxamaxxishsha ha'nonna oodhdhe.<verse eid="JOL 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9" />Midhatik tolchinna ha'watik tolcha</para>
  <para style="q2" vid="JOL 1:9">Duuchchi Woddike Goottike mininaa'n gate'een;</para>
  <para style="q1" vid="JOL 1:9">Duuchchi Woddike Gootti edo ergatenda'neexxi</para>
  <para style="q2" vid="JOL 1:9">qeesenna ooxxa'neen.<verse eid="JOL 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10" />Iikki fichchuwwi duwwi gateen;</para>
  <para style="q2" vid="JOL 1:10">iikki boginna bageen;</para>
  <para style="q1" vid="JOL 1:10">Midha baxxeen;</para>
  <para style="q2" vid="JOL 1:10">reefixxi woyinetixxi booka muddeen;</para>
  <para style="q2" vid="JOL 1:10">zayitetinna xo'o hiteen.<verse eid="JOL 1:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11" />He'no wisalluwwi yaadde;</para>
  <para style="q2" vid="JOL 1:11">ha'no woyenetike hiddichchik wiisalluwwi woo woo hiyye;</para>
  <para style="q1" vid="JOL 1:11">Midha duuchcha fichchake'n baxxemmaxxee,</para>
  <para style="q2" vid="JOL 1:11">so'akeenna dinnetee oodhdhe.<verse eid="JOL 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12" />Iitti woyine bagge'een;</para>
  <para style="q2" vid="JOL 1:12">belasetik haqichchuwwinna qoore'een;</para>
  <para style="q1" vid="JOL 1:12">Romaane, teemirenna Inkoyye;</para>
  <para style="q2" vid="JOL 1:12">wele gumma ra'isaak haqichchuwwi duuchchi bage'een;</para>
  <para style="q1" vid="JOL 1:12">Tennexxee gammashsho</para>
  <para style="q2" vid="JOL 1:12">manjiinke beltonaa'n bayyate'een.<verse eid="JOL 1:12" /></para>
  <para style="s1">Aadde Aagatee Assemeeka Ye'injo</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13" />Ha'no ifike Mageni'a shiqishinaaxxe midhatikenna woyenetixxe bookaki tolchi hedha gopheemmaxxee</para>
  <para style="q2" vid="JOL 1:13">ha'no anke Magenike erganjuwwa kaddineexxee qeesse</para>
  <para style="q1" vid="JOL 1:13">Ammee, jooniyya seemma oddo'witineexxi hashsha duuchcha oodhdhe.</para>
  <para style="q2" vid="JOL 1:13">Ha'no ookkonee tolchimalcho'n ergatendinaakiirinna woo woo hiyye.<verse eid="JOL 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14" />Woyyitte agabo goddo lasse;</para>
  <para style="q2" vid="JOL 1:14">woyyitte tuutanna bukki asse;</para>
  <para style="q1" vid="JOL 1:14">Geedhetanna bukki asse</para>
  <para style="q2" vid="JOL 1:14">ookkone bogi giddo hedheeka duuchcha</para>
  <para style="q1" vid="JOL 1:14">Duuchchi Wodika Gootta ha'nooke Magenike miniba'a ye'we;</para>
  <para style="q2" vid="JOL 1:14">Duuchchi Woddike Goottiba'aanna raarre.<verse eid="JOL 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15" />Dada Duuchcha ajajaake Duuchchi Woddike Goottixxi barra shiqeemmaxxee</para>
  <para style="q2" vid="JOL 1:15">aanne'e! Eetten barra'a;</para>
  <para style="q2" vid="JOL 1:15">duuchchinxa dande'ake Mageni ba'ne iyyedagaaxxi barra gelte'een.<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="ISA 13:6">Isa. 13:6</ref>. </char></note><verse eid="JOL 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16" />Indaaxxa ita</para>
  <para style="q2" vid="JOL 1:16">ille no'oxxeenaa'ni,</para>
  <para style="q1" vid="JOL 1:16">Gammashshotinna fenxe hiyya,</para>
  <para style="q2" vid="JOL 1:16">no'oke Mageniinke minenaa'n gatte'ebaata?<verse eid="JOL 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17" />Wiisendeexxi midha buttin giddo</para>
  <para style="q2" vid="JOL 1:17">aloote baxxe'een;</para>
  <para style="q2" vid="JOL 1:17">miya masseccatik minwwinna diigemeedheen</para>
  <para style="q2" vid="JOL 1:17">iitti midha baggemaxxee</para>
  <para style="q2" vid="JOL 1:17">midha aasseccatik gootaruwwi duuchchinna duwwi gate'een.<verse eid="JOL 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18" />Hori yo'oshsha ma'late;</para>
  <para style="q2" vid="JOL 1:18">lalikinna mekki hiyye;</para>
  <para style="q1" vid="JOL 1:18">Allallaaba goniphemmaxxee</para>
  <para style="q2" vid="JOL 1:18">gedhebikinna midde rakkate'een.<verse eid="JOL 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19" />Ee, Duuchchi Woddike Gootta atee ye'aannen</para>
  <para style="q2" vid="JOL 1:19">allallatixxa badda'a duuchcha giira ittemmaxxee'e</para>
  <para style="q2" vid="JOL 1:19">haqichchuwwakanna giira itteen.<verse eid="JOL 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20" />Badda'atik biniichchuwwi atiba'a hamuummate;</para>
  <para style="q2" vid="JOL 1:20">wodiinxi muumuwwa bage'een;</para>
  <para style="q2" vid="JOL 1:20">ansichcho duuchchanna giira itte'een.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s1">Awwaaneessiinka Sannachcha</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 2:1" />Malagata Tsiyooni giddo ufuuffe;</para>
  <para style="q2" vid="JOL 2:1">woyyitte anxe kooba'ni ookkonee xexxe'achchisatika hafuuranna laqisse.</para>
  <para style="b" vid="JOL 2:1" />
  <para style="q1" vid="JOL 2:1">Duuchchi Woddike Goottixxi murtetixxi barra dage'eemmaxxee</para>
  <para style="q2" vid="JOL 2:1">buttate'n hedheek duuchchi culphisowwaal;</para>
  <para style="q1" vid="JOL 2:1">Isenna shiqo hexxeen.<verse eid="JOL 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 2:2" />Tinninna dukkanatixxenna cuggogotixxe barra,</para>
  <para style="q2" vid="JOL 2:2">duumanchiixxenna dimma dukkanaxxe barran;</para>
  <para style="q1" vid="JOL 2:2">Borrotike dayya'iki ifi koobuwwwati hana duuchcha'n geyammashsha jajjabbi heddi sannachchi dagaan;</para>
  <para style="q1" vid="JOL 2:2">Olma iitta hexxeexxi yaane hara kadde egendebaan,</para>
  <para style="q2" vid="JOL 2:2">dagaake barruwwa'ninna iitta hexxeexxi yaane hara kaddaba'a.<verse eid="JOL 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3" />Konne sannachchi edii'ni giira ha'yitaan,</para>
  <para style="q2" vid="JOL 2:3">isi uduumi darre'ninna bubba'ni tallisaan;</para>
  <para style="q1" vid="JOL 2:3">Konne sannachchi edi darre'n hedheek bog Edeenike eloke hiddichchinxe bakka labaan</para>
  <para style="q2" vid="JOL 2:3">udumi darri duwwixxe qiilla gammoojje labaan,</para>
  <para style="q2" vid="JOL 2:3">konne sannachchinaa'n mittichchinna gataachchi hedhebaan.<verse eid="JOL 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4" />Konnechchuwwixxi bifa fadhadoke labba;</para>
  <para style="q2" vid="JOL 2:4">qolcha giddonna loliinke fadhadishshaten.<verse eid="JOL 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5" />Huura itta'n haxxaxxisammaxe giirashsha,</para>
  <para style="q2" vid="JOL 2:5">lolakee qophpheefateeke jajjabbi sannachchishsha</para>
  <para style="q2" vid="JOL 2:5">sarageelliinka hafuura laqisa'ni</para>
  <para style="q2" vid="JOL 2:5">koobuwwatixxe xungo hanii'n xoggaan.<note caller="-" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="REV 9:7-9">Wal. 9:7-9</ref>. </char></note><verse eid="JOL 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6" />Isi edonna gosa gosak ardi duuchchi culphisaan;</para>
  <para style="q2" vid="JOL 2:6">manji duuchchik albinna alayyik xilledhaan.<verse eid="JOL 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7" />Duuliinke mannishsha dedhange'n miidhaan;</para>
  <para style="q2" vid="JOL 2:7">loliinke mannishshanna dalla'a da'maan.<verse eid="JOL 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8" />Insa'ne weli'anni weli dhiibabaan;</para>
  <para style="q2" vid="JOL 2:8">mitti mittinig ifi ifike ora abixinee me'inaan;</para>
  <para style="q1" vid="JOL 2:8">Ifi ifike googeessi giddii'ni fullebaang,</para>
  <para style="q2" vid="JOL 2:8">gollifachcho enqine sa'naan.<verse eid="JOL 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9" />Kunni sannachchi ookkone qachcha'ni gumaani;</para>
  <para style="q2" vid="JOL 2:9">dalla'i hani'ninna utaalaan;</para>
  <para style="q1" vid="JOL 2:9">Minuwwii hananna da'maan</para>
  <para style="q2" vid="JOL 2:9">modhachchiishshanna masikotuwwatenaa'ni e'yaan.<verse eid="JOL 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10" />Buttatinna isi edo sheke sheke hitaan;</para>
  <para style="q2" vid="JOL 2:10">iimatinna girrisaan;</para>
  <para style="q1" vid="JOL 2:10">Arishsho agenjikinna dukkanaan;</para>
  <para style="q2" vid="JOL 2:10">urjuwwatinna ifa gibba.<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="REV 8:12">Wal. 8:12</ref>. </char></note><verse eid="JOL 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11" />Duuchchi Woddik Gootti dindimeexxi</para>
  <para style="q2" vid="JOL 2:11">ifike sannachcha edo ifika hafuura laqisaan;</para>
  <para style="q1" vid="JOL 2:11">Isike sannachchik laakkossi lumoo qico bara sa'eeken;</para>
  <para style="q2" vid="JOL 2:11">ajaja isika muuxaakinna isi hunnaameessaken;</para>
  <para style="q1" vid="JOL 2:11">Iitti Duuchchi Woddike Goottixxi barra jabaxxen;</para>
  <para style="q2" vid="JOL 2:11">lumo qiconna sodaachchisaaxxen, ayyete isee dande'ata?<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="REV 6:17">Wal. 6:17</ref>. </char></note><verse eid="JOL 2:11" /></para>
  <para style="s1">Aadde Aaggotika Ye'injo</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12" />«Ta'anna agabo godda hosati,</para>
  <para style="q2" vid="JOL 2:12">oodhishshatinna yaaddoti</para>
  <para style="q1" vid="JOL 2:12">Mitti godobinni anibaa higge» hiyya'neen Duuchchi Woddik Gootti.<verse eid="JOL 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13" />Qalbe ha'nooxxa malee'e,</para>
  <para style="q2" vid="JOL 2:13">seemma ha'nooxxa dartinoqqe'e;</para>
  <para style="q1" vid="JOL 2:13">Duuchchi Woddike Gootta ha'noke Magenbaa higge;</para>
  <para style="q2" vid="JOL 2:13">isi o'waakenna mararaake,</para>
  <para style="q1" vid="JOL 2:13">Fuggoxxa iyyedago'a hiyyee waalaake kademmaxxee</para>
  <para style="q2" vid="JOL 2:13">mufe dande'akenna bira saxxeexxe jalalaken.<verse eid="JOL 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14" />Ifixxe o'wan higeexxi</para>
  <para style="q2" vid="JOL 2:14">Duuchchi Woddike Gootta hanooke Mageni'a kadaake</para>
  <para style="q1" vid="JOL 2:14">Midhatike tolchinninna ha'watike tolchinni ha'noo eebbiso'a</para>
  <para style="q2" vid="JOL 2:14">eebba ifixxa ha'no'a uwwuu ayyete ege'ne?<verse eid="JOL 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15" />Malagata Tsiyooni giddo ufuuffe;</para>
  <para style="q2" vid="JOL 2:15">woyyitte agabo goddo hosanna lallabbe;</para>
  <para style="q1" vid="JOL 2:15">Woyyichcha yaa'anna ye'we.<verse eid="JOL 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16" />Ardakanna bukki asse</para>
  <para style="q2" vid="JOL 2:16">ookkonee yaa'anna woyyoonse;</para>
  <para style="q1" vid="JOL 2:16">Geedhe mitteba shiqishshe</para>
  <para style="q2" vid="JOL 2:16">annoolettanna bukki asse;</para>
  <para style="q1" vid="JOL 2:16">Waajubichchi ifika golo waalowwaal;</para>
  <para style="q1" vid="JOL 2:16">Waajubichchotinna ifixxe dukko waldowwaal.<verse eid="JOL 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17" />Duuchchi Woddike Gootti edo ergatenda'neexxi qeese</para>
  <para style="q2" vid="JOL 2:17">tolchimalchoke'ninna galmiinxe wuddummexxe oddo'ni he'ne'e,</para>
  <para style="q1" vid="JOL 2:17">Hina'ni oo'naa qici: «Ee, Duuchchi Woddike Gootta arda atika anjir</para>
  <para style="q2" vid="JOL 2:17">qadaada atikanna gosa gosake arda'n mammakemaake</para>
  <para style="q2" vid="JOL 2:17">osolemaakenna gacifachotike manna no'o assitoxxee.</para>
  <para style="q1" vid="JOL 2:17">Mayee atike ardixxe oddo'ni</para>
  <para style="q2" vid="JOL 2:17">‹Mageni insa'nekita haba hedhe? No'o hina?› »<verse eid="JOL 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18" />Yoona Duuchchi Woddik Gootti ifike boga'n hedheeke</para>
  <para style="q2" vid="JOL 2:18">ardi duuchchi'a gaabbe eloxa afemmaxxee isi ifike ardi'a mararan;<verse eid="JOL 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 2:19" />Duuchchi Woddik Goottinna hiyye hiisse haaso'ee qici:</para>
  <para style="q1" vid="JOL 2:19">«Kunnise midha, reefixxa woyinetixxa bookanna zayite</para>
  <para style="q2" vid="JOL 2:19">godditinaa qici'a ha'no'aa uwwannon;</para>
  <para style="q1" vid="JOL 2:19">Gosa gosak ardinna ha'noo'ni gacifataashsha assabe'non.<verse eid="JOL 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20" />«Ani middika awwaaneessika sannachcha ha'nonaa'ni bayyisannon;</para>
  <para style="q2" vid="JOL 2:20">alba isikanna borotixxe abbaayya darre'n</para>
  <para style="q1" vid="JOL 2:20">Dudduro isikanna dhidhimii darrexxe abbaayyabaa assiyyoti</para>
  <para style="q2" vid="JOL 2:20">ookkone bagokenna uruma bogibaa me'ashsha assannon;</para>
  <para style="q2" vid="JOL 2:20">ookko bochchi isikinna laqisaan;</para>
  <para style="q1" vid="JOL 2:20">Foolekanna ganaan.»</para>
  <para style="b" vid="JOL 2:20" />
  <para style="q1" vid="JOL 2:20">Dhugaaten, isi lumooxxe yaane asse'een.<verse eid="JOL 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 2:21" />Tee butta sodaattoxxee</para>
  <para style="q2" vid="JOL 2:21">gammadi ilillisi;</para>
  <para style="q1" vid="JOL 2:21">Dhugaaten Duuchchi Woddik Gootti lumooxxe yaane asse'een.<verse eid="JOL 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOL 2:22" />Iitti bobba'atixxe badda'a quffeemmaxxee</para>
  <para style="q2" vid="JOL 2:22">koo bada'a giddike biniinchaa mee sodaatte;</para>
  <para style="q1" vid="JOL 2:22">Iikki haqichchuwwinna gumma gummise'een;</para>
  <para style="q2" vid="JOL 2:22">balasetik haqichchinna woyinetik hiddichchi unkuruure gummise'een.<verse eid="JOL 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23" />Ha'no Tsiyoonike arda gammadde!</para>
  <para style="q2" vid="JOL 2:23">Duuchchi Woddike Gootta ha'noke Mageno'ni'anna ilillisse;</para>
  <para style="q1" vid="JOL 2:23">Haarsikanna bonika xeena</para>
  <para style="q2" vid="JOL 2:23">qullumati hasissaa qico'n ha'no'a gansiise'een</para>
  <para style="q1" vid="JOL 2:23">Edi woddishsha,</para>
  <para style="q1" vid="JOL 2:23">Haarsikanna bonika xeena ha'noo'a uwwe'een.<verse eid="JOL 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24" />Aldummuwwate'ninna midha wo'mitaan;</para>
  <para style="q2" vid="JOL 2:24">miicatixxi baluwwanna reefixxe woyinetixxe bookanninna zayitenni</para>
  <para style="q1" vid="JOL 2:24">Wo'mitee danbalataan.<verse eid="JOL 2:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25" />«Ha'nooxxe oddo'n wocci assennek lumook sannachchi</para>
  <para style="q2" vid="JOL 2:25">lumollikinna shiixxarammi awwaaneessi</para>
  <para style="q2" vid="JOL 2:25">weli awwaanessinna awwaanessiink sannachchi itemmaka</para>
  <para style="q1" vid="JOL 2:25">Kunni duuchchi itemmaxxe wogguwwaka hira ha'noo'a hiissannon.<verse eid="JOL 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26" />Godditinaa qico'n ittinaaxxa heddo midha affinaan;</para>
  <para style="q2" vid="JOL 2:26">maso yaanuwwa ha'no'a asseeka</para>
  <para style="q2" vid="JOL 2:26">Duuchchi Woddika Gootta ha'nooke Magenika summa saaddinaan;</para>
  <para style="q1" vid="JOL 2:26">Ardi ank ta'anni edi'a shookabaan.<verse eid="JOL 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27" />Ookkoneechchi uduma ani Isira'eelixxe oddo'n hedhennexxa</para>
  <para style="q2" vid="JOL 2:27">ani Duuchchi Woddike Gootta ha'nooke Mageno kadennexxa</para>
  <para style="q2" vid="JOL 2:27">anishsha hedheekinna hedhebaaxxa egendinaan;</para>
  <para style="q1" vid="JOL 2:27">Ardi ankinna ta'anni edi'a shookabaan.»<verse eid="JOL 2:27" /></para>
  <para style="s1">Duuchchi Woddike Goottixxa Barra</para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28" />«Ookkonneechchi uduma</para>
  <para style="q2" vid="JOL 2:28">Hafuura anka manjo duuchcha'n dhangalaasannon;</para>
  <para style="q1" vid="JOL 2:28">Ha'noxxi labbaxxinna meyyaaxxi oose raaga raaggaan;</para>
  <para style="q2" vid="JOL 2:28">ha'nooxxi geedhenna oojjo oojjottaan;</para>
  <para style="q2" vid="JOL 2:28">dargageeyye ha'noxxinna waleella uuddaan.<note caller="-" style="x"><char style="xo" closed="false">2:28 </char><char style="xt" closed="false"><ref loc="ACT 2:17-21">Erga. Huj. 2:17-21</ref>. </char></note><verse eid="JOL 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29" />Ittanni eettene barruwwa'n meyyaxxenna labbake erganjuwwa'n midde,</para>
  <para style="q2" vid="JOL 2:29">Hafuura anka dhangalaasannon.<verse eid="JOL 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30" />Massotanna iimuwwate'n leellishannon</para>
  <para style="q2" vid="JOL 2:30">iittanni buttate'n munde, giiratanna wiliilletike utuphika duumaancha leellishaannon.<verse eid="JOL 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31" />Jabaxxinna sodaachchissaaxxi Duuchchi Woddike Goottixxi barra daggebaa edi darre,</para>
  <para style="q2" vid="JOL 2:31">arishsho dukkandaan,</para>
  <para style="q2" vid="JOL 2:31">agenjikinna mundete'n jijjiiremaan.<note caller="-" style="x"><char style="xo" closed="false">2:31 </char><char style="xt" closed="false"><ref loc="MAT 24:29">Mat. 24:29</ref>; <ref loc="MRK 13:24-25">Mar. 13:24-25</ref>; <ref loc="LUK 21:25">Luq. 21:25</ref>; <ref loc="REV 6:12-13">Wal. 6:12-13</ref>. </char></note><verse eid="JOL 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32" />Duuchchi Woddike Goottika summa ye'aak duuchchi,</para>
  <para style="q2" vid="JOL 2:32">isi anjiremaan;</para>
  <para style="q1" vid="JOL 2:32">Duuchchi Woddik Gootti hiyyemmashshanni</para>
  <para style="q2" vid="JOL 2:32">Tsiyoonixxe Kooba'ninna Iyyerusaalemi giddo</para>
  <para style="q2" vid="JOL 2:32">anjirensha hexxaan.</para>
  <para style="q1" vid="JOL 2:32">Ookkone anjiremaake manni giddii'ni</para>
  <para style="q2" vid="JOL 2:32">Duuchchi Woddik Gootti eeyyeekiiri ooko afemaan.»<note caller="-" style="x"><char style="xo" closed="false">2:32 </char><char style="xt" closed="false"><ref loc="ROM 10:13">Rom. 10:13</ref>. </char></note><verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s1">Mageni Gosa Gosake Arda'n Muraan</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1" />Ookkone baro'ni eettene yanna'ni</para>
  <para style="q2" vid="JOL 3:1">Yihudaxxanna Iyyerusaalemixxa booji'o hiissanno wodda,<verse eid="JOL 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2" />Gosa gosaka arduwwa duuchcha bukki assannon;</para>
  <para style="q1" vid="JOL 3:2">Iyyoosaafixxixxe dhooqa giddi'anna insa'ne iyyedagannon;</para>
  <para style="q2" vid="JOL 3:2">anka qadaada, Isira'eelike ardixxee,</para>
  <para style="q1" vid="JOL 3:2">Ookko insa'ne'ni muronna'aa e'yannon, tinni kaddaachchi insa'ne</para>
  <para style="q2" vid="JOL 3:2">boga anka qodendeemmaxxe</para>
  <para style="q2" vid="JOL 3:2">arda ankanna arduwwi giddo xexxeeremmaxxeeten.<verse eid="JOL 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3" />Insa'nenna anke arda'n hixa iblisine'een;</para>
  <para style="q2" vid="JOL 3:3">labaxxa oosenna yabaabultuwwatike hiri'a uune;</para>
  <para style="q2" vid="JOL 3:3">woyitixxa booka ha'wiyyoteenna meyyaxxa oose gurgudhine.<verse eid="JOL 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4" />«Tee Xiroosinna Sidoona iittanni ha'no Filisixeemixxe galchuwwake arda duuchcha ane'ni maa afine'e? Assennexxe yaanexxee ane'n halo fuldino'aate? Halo fuldina'neexxe kaddoole rakkennexxi iikki woddi ha'no assitinemmaxxa ha'no'ninni wirri asse hiissannon.<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">Isa. 14:29-31</ref>; <ref loc="ISA 23:1-18">23:1-18</ref>; <ref loc="JER 47:1-7">Erm. 47:1-7</ref>; <ref loc="EZK 25:15-28:26">Hiz. 25:15—28:26</ref>; <ref loc="AMO 1:6-10">Amo. 1:6-10</ref>; <ref loc="ZEP 2:4-7">Sof. 2:4-7</ref>; <ref loc="ZEC 9:1-7">Zek. 9:1-7</ref>; <ref loc="MAT 11:21-22">Mat. 11:21-22</ref>; <ref loc="LUK 10:13-14">Luq. 10:13-14</ref>.</char></note> <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />Anka birretika sibljonna anxa worqe adhdhitine'een; mellemeeka anka miyuwwanna gudhdhitineexxi ha'noke galmuwwi giddo e'yishineen. <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />Insa'neke boginaa'n bayyissino'a Yihudiinkanna Iyyerusaalemika manna Girkeeke manna'ni gurgudhitineen.<verse eid="JOL 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7" />«Kunnise insa'ne gurgurtinemmake bonchuwwanaa'n insa'nee ke'issannon; ha'nonna assitinemmaxxa umo ha'nonge'n hiissano. <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />Aninna labbaxxanna meyyaxxa ha'nooxxa oose Yihudiinke arda'n gurgurannon; insa'nenna oose ha'nooxxa bayya hedheeke Saabake manna'n gurgurdhinaan» Duuchchi Woddik Gootti tenne haaso'eedheen.<verse eid="JOL 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9" />Konneechchi butta hexxeexxa tennee gosa gosake ardi'a lasse:</para>
  <para style="q2" vid="JOL 3:9">bagedokee qixxeeffatte</para>
  <para style="q1" vid="JOL 3:9">Loliinka mannanna dammasse;</para>
  <para style="q2" vid="JOL 3:9">loliink manni duuchchinna shiqeexxi lolowwaal.<verse eid="JOL 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10" />Qotto ha'nooxxi wolaantichchake</para>
  <para style="q2" vid="JOL 3:10">haanto ha'nooxxinna bagedoke kaddo'a tumme;</para>
  <para style="q1" vid="JOL 3:10">Goof manjinna</para>
  <para style="q2" vid="JOL 3:10">«Ani worbaken» hiyyowwaal<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="ISA 2:4">Isa. 2:4</ref>; <ref loc="MIC 4:3">Mik. 4:3</ref>.</char></note><verse eid="JOL 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11" />Ha'no qarqarake'ni hexxineek gosa gosak ardi duuchchiing</para>
  <para style="q2" vid="JOL 3:11">rakkine amme; ookkonna bukki hiyye.</para>
  <para style="b" vid="JOL 3:11" />
  <para style="q1" vid="JOL 3:11">Ee, Duuchchi Woddike Goottaa atika loliinka manna adade ergi.<verse eid="JOL 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12" />«Gosa gosak ardi ke'owwaal;</para>
  <para style="q2" vid="JOL 3:12">Iyyoosaafixxixxe dhooqaba'aanna reke dirrowwaal;</para>
  <para style="q2" vid="JOL 3:12">qarqarake'ni hedheeke gosa gosake arda duuchcha'ni murronna'a ookko ofo'lannon.<verse eid="JOL 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13" />Insa'nexxi fuggo hara birasaxxe'een;</para>
  <para style="q2" vid="JOL 3:13">haantot midha haandaammashsha insa'ne haamme;</para>
  <para style="q1" vid="JOL 3:13">Woyine miicatixxi bakka'n wo'mite hirbeesendammashsha insa'nenna hirbeesse!»<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="REV 14:14-16">Wal. 14:14-16</ref>, <ref loc="REV 14:19-20">19-20</ref>; <ref loc="REV 19:15">19:15</ref>. </char></note><verse eid="JOL 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14" />Duuchchi Woddike Goottixxi barra murtetixxe dhooqa'n sheqqeemmaxxee lumooshsha heddi ardi ookko bukki hiyye'een.<verse eid="JOL 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15" />Arishshotinna agenji dukkananna</para>
  <para style="q2" vid="JOL 3:15">urjuwwa konneechchi edi'a ifissabaan.<verse eid="JOL 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16" />Duuchchi Woddik Gootti Tsiyooninaa'n hafuura gikki asse haaso'aan;</para>
  <para style="q2" vid="JOL 3:16">Iyyerusaaleminaa'n dindimaan;</para>
  <para style="q2" vid="JOL 3:16">iimatinna butta raankitaan;</para>
  <para style="q1" vid="JOL 3:16">Duuchchi Woddik Gootti kinni arda ifikee gollake</para>
  <para style="q2" vid="JOL 3:16">Isira'eelike ardi'anna gollake kadaan.<note caller="-" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="AMO 1:2">Amo. 1:2</ref>. </char></note><verse eid="JOL 3:16" /></para>
  <para style="s1">Eebbisema Mageniinke Ardi'a</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17" />«Ookkonechchi uduma ani Duuchchi Woddiki Gootti ha'nook Mageni</para>
  <para style="q2" vid="JOL 3:17">Woyyitte anxe kooba'ni Tsiyooni'ni hadhannoxxa egendinaan;</para>
  <para style="q1" vid="JOL 3:17">Iyyerusaalemi woyyitte kaddaan;</para>
  <para style="q2" vid="JOL 3:17">ta'an edi'a alagi isee injifatabaan.<verse eid="JOL 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18" />«Ookonne wodda woyinetixxi bookka koobuwwatenaa'n cocobbaan;</para>
  <para style="q2" vid="JOL 3:18">tulliuchchuwwakenaa'ninna ado phu'wisaan;</para>
  <para style="q2" vid="JOL 3:18">Yihuda giddo hexxeexxe dhooquwwa duuchcha wode'e lolaassaan;</para>
  <para style="q1" vid="JOL 3:18">Duuchchi Woddike Goottike minenaa'n muumme burqitaan;</para>
  <para style="q2" vid="JOL 3:18">Shiximixxa dhooqa'ninna yaataan.<verse eid="JOL 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19" />Boga insa'neke'n qullitte munde dhangalaasiyyot</para>
  <para style="q2" vid="JOL 3:19">Yihudake arda'n assineexxe fuggoxxee</para>
  <para style="q2" vid="JOL 3:19">Gibtsee urimitaan,</para>
  <para style="q2" vid="JOL 3:19">Eedoominna qiilla gammoojje kaddaan.<verse eid="JOL 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20" />Yihuda duuchchi woddi'a,</para>
  <para style="q2" vid="JOL 3:20">Iyyerusaaleminna ila duuchchi'a galdumiinxe bakka kaddaan.<verse eid="JOL 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21" />Munde insa'nexxe halo fulannon</para>
  <para style="q2" vid="JOL 3:21">balleessanjo xixaa waalabe'no.»</para>
  <para style="b" vid="JOL 3:21" />
  <para style="qc" vid="JOL 3:21">Duuchchi Woddik Gootti Tsiyoonixxe kooba'ni hedhaan!<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>