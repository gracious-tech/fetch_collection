<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Gedeo Bible</book>
  <para style="h">Amootsikaa Raaga</para>
  <para style="toc1">Amootsikaa Raaga</para>
  <para style="toc2">Amootsikaa Raaga</para>
  <para style="toc3">Amo.</para>
  <para style="mt1">Amootsikaa Raaga</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Amootsi ragiinxa oge afeemmabaan; raaga raagatixxe ogexxa leenjooni leenjisemeebaan (7:14). Yaanne kinni gootti midixxe mootumma giddo hedheeke Isira'eelike ard'a eriga geessiso'a erigee wodda Amootsi Yihudi giddo hedheeke Teqoo'a hiyyemaaka ifika qachcha waale me'e. Ookko'ni ke'eexxi Isira'eeliki ardi magenoonfatammake boonchiba'a Bettelike qachchiba'a me'e.</para>
  <para style="ip">Konne Maxaafi giddo Amootsi edise qarqarake'ni hedheeka arda duukaa'ni; ookko'ni Isira'eelika arda gargari hiisseexxi xoo'mamiki hexxa'neexxa dureeyye duukaani. Insa'ne arda saamo'anna garibake asino'a jabaxxe hunna anfeemman. Heddi ardi goottinni gadho wele magenoonfantaaxxi fakkuwwa anfoolena midde Duuchchi Woddiki Gootti insa'nee heqqa'neexxa addantamaani. Amootsi kinni cubbo insa'neexxixxe dafee'a xixxichcho adhdhinaaxxa insa'ne'a hiyya'ne kulee qici: Elobaaxxa yaane waalle; elooxxe kaddeexxa eeyye.</para>
  <para style="ip">Muritetixxe songuwwaa'ni dhugaa gortabaashsha asse; dedha Lumoki Duuchchi Woddiki Gootti Mageni gateeke Isra'elike ard'a gattowwaali hiyyaaxe hexxeeni (5:15).</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Gosa gosaki ardi ifixxe balleessa'a xixichcho adhdhaxxa <char style="ior"><ref loc="AMO 1:1-3:2">1:1—3:2</ref> </char></para>
  <para style="io1">Isera'eelixxanna Samaariyyaxxa ba'ne i <char style="ior"><ref loc="AMO 3:3-6:14">3:3—6:14</ref> </char></para>
  <para style="io1">Isira'eelixxe xixenshaxxe Amootsi'n leelliteexxa onde leelluwwa <char style="ior"><ref loc="AMO 7:1-9:10">7:1—9:10</ref> </char></para>
  <para style="io1">Isira'eelixxa elooxxa halcha <char style="ior"><ref loc="AMO 9:11-15">9:11-15</ref> </char></para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />Teqo'ake qachcha'ni hexxeexxe allalisano giddii'ni mitti Amootsiten. Oziyaani Yihudake moyanjo kadeemma wodda iittanni Iyyo'aasiki belti Iyyorbi'aami Isira'eelik moyanjo kadeemma wodda, tinninna bogi giddo lele'ma kadeebaa edi darre Isira'eelxe'e uudeexxi haaso'eemak hiyyichchi konneechchinni butti'a hedheeken.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 15:1-7">2 Moy. 15:1-7</ref>; <ref loc="2CH 26:1-23">2 Odo. 26:1-23</ref>; <ref loc="2KI 14:23-29">2 Moy. 14:23-29</ref>. </char></note><verse eid="AMO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2" />Amootsinna hiyyee qici,</para>
  <para style="q1" vid="AMO 1:2">«Duuchchi Woddiki Gootti Tsiyoonixxe kooba'ni hedheexxi neenqinsha ittanna'naa;</para>
  <para style="q2" vid="AMO 1:2">sodaachchisaaki hafuuri isikinna Iyyerusaalemi qico'ni laqiseen;</para>
  <para style="q1" vid="AMO 1:2">Allalisano hore bobbaalsitaammaaxxi arsonna qoorteen;</para>
  <para style="q2" vid="AMO 1:2">Qermeeloosixxe koobaaki hanjinninna bageen.»<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JOL 3:16">Iyu. 3:16</ref>. </char></note><verse eid="AMO 1:2" /></para>
  <para style="s1">Mageniinxi Murte Isira'eelike Qarqarke Boguwwa'ni</para>
  <para style="s2">Soriya</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />Duuchchi Woddiki Gootti hiyya'nee qici,</para>
  <para style="q1" vid="AMO 1:3">«Demasiqoki ardi cubbonde'ni lebee cubbo hujeemmaxxee'e,</para>
  <para style="q2" vid="AMO 1:3">mitte mami belo inisa'nee mura woxisannon.</para>
  <para style="q1" vid="AMO 1:3">Inisa'nee isso afeeke siblijiinke uxxisanjinn Gele'adika arda rakkinseen.<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 17:1-3">Isa. 17:1-3</ref>; <ref loc="JER 49:23-27">Erm. 49:23-27</ref>; <ref loc="ZEC 9:1">Zek. 9:1</ref>. </char></note><verse eid="AMO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4" />Tennexxe moyaanjo Hazaheelike moyaatike mine'ni giirra worrannoni;</para>
  <para style="q2" vid="AMO 1:4">giirattinna moyanji Beenihadaadi ijaarsissemmake kinjiinke dalla'ika qachchuwwanna ittaani.<verse eid="AMO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5" />Demasiqoke qachchike dallaiinxe hulakka cufanuwwa duuchcha enqe birannon;</para>
  <para style="q2" vid="AMO 1:5">Beeti'edeeni giddo siqqo abixxeeka,</para>
  <para style="q1" vid="AMO 1:5">Aweenxedhoqqa'ni hedheeka ardanna Beetti edeenka akeekisanjo fugussannon.</para>
  <para style="q2" vid="AMO 1:5">Sooriyaki Ardinna booji'emmeexxi Qiiri hiyyemaake bogibaa me'aan»</para>
  <para style="q2" vid="AMO 1:5">hiyya'neen Duuchchi Woddik Gootti.<verse eid="AMO 1:5" /></para>
  <para style="s2">Filisixxeemi</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />Duuchchi Woddiki Gootti hiyya'nee qici,</para>
  <para style="q1" vid="AMO 1:6">«Gaazaki ardi cubbonde'ni lebee cubbo hujeemmaxxee'e,</para>
  <para style="q2" vid="AMO 1:6">mitte mami belo inisa'nee mura woxisannon.</para>
  <para style="q1" vid="AMO 1:6">Inisa'ne bogi giddo hedheeka arda boojineexxi</para>
  <para style="q2" vid="AMO 1:6">Eedoomike manni'a sa'isine uune'en.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">Isa. 14:29-31</ref>; <ref loc="JER 47:1-7">Erm. 47:1-7</ref>; <ref loc="EZK 25:15-17">Hiz. 25:15-17</ref>; <ref loc="JOL 3:4-8">Iyu. 3:4-8</ref>; <ref loc="ZEP 2:4-7">Sof. 2:4-7</ref>; <ref loc="ZEC 9:5-7">Zek. 9:5-7</ref>. </char></note><verse eid="AMO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7" />Tennexxe Gaazake qachchike dalla'a'ni giira worannoni;</para>
  <para style="q2" vid="AMO 1:7">kollo inisa'nexxanna gube birannoni.<verse eid="AMO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8" />Ashidoodi giddo hedha'neeka ardanna Asiqeloonika akeekisanjo balleesanon; Filisixeemik bogi giddo kasake'ni hedheek manji reyaa qico'ni</para>
  <para style="q2" vid="AMO 1:8">anga anxa Aqarooni'n diriisanno.»</para>
  <para style="q2" vid="AMO 1:8">hiyya'neen Duuchchi Woddik Gootti.<verse eid="AMO 1:8" /></para>
  <para style="s2">Xxirroosi</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />Duuchchi Woddik Goottinna hiyya'nee qici,</para>
  <para style="q1" vid="AMO 1:9">«Xiroosiki ardi cubbonde'ni lebee cubbo hujeemmaxxee'e,</para>
  <para style="q2" vid="AMO 1:9">mitte mami belo inisa'nee mura woxisannon.</para>
  <para style="q1" vid="AMO 1:9">Dayyuwwi inisa'nekinni welti mitteba hinge haasoneemmaxxanna diingeexxi</para>
  <para style="q2" vid="AMO 1:9">booji'eenaka arda Eedoomi'n sa'issinee uuneen.<verse eid="AMO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10" />Tennexxee Kolluwwa isexxinna itendaashsha,</para>
  <para style="q2" vid="AMO 1:10">Xiroosike qachchike dalla'i giira woranon.»<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="ISA 23:1-8">Isa. 23:1-8</ref>; <ref loc="EZK 26:1-28:19">Hiz. 26:1—28:19</ref>; <ref loc="JOL 3:4-8">Iyu. 3:4-8</ref>; <ref loc="ZEC 9:1-4">Zek. 9:1-4</ref>; <ref loc="MAT 11:21-22">Mat. 11:21-22</ref>; <ref loc="LUK 10:13-14">Luq. 10:13-14</ref>. </char></note><verse eid="AMO 1:10" /></para>
  <para style="s1">Odomi</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />Duuchchi Woddik Gootti hiyya'nee qici,</para>
  <para style="q1" vid="AMO 1:11">«Eedoomik ardi cubbonde'ni lebee cubbo hujeemmaxxee'e,</para>
  <para style="q2" vid="AMO 1:11">mitte mami belo inisa'nee mura woxisannon.</para>
  <para style="q1" vid="AMO 1:11">Dayyuwwa inisa'neeka Isira'eelika arda wolaantichchik shorrine'een;</para>
  <para style="q2" vid="AMO 1:11">insa'nee abindeeechchi uduma inisa'ne'aa mararrebaan.</para>
  <para style="q1" vid="AMO 1:11">Inisa'nenni anfeexxi aare balleeffanito'a dandeennebaan.<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">Isa. 34:5-17</ref>; <ref loc="ISA 63:1-6">63:1-6</ref>; <ref loc="JER 49:7-22">Erm. 49:7-22</ref>; <ref loc="EZK 25:12-14">Hiz. 25:12-14</ref>; <ref loc="EZK 35:1-15">35:1-15</ref>; <ref loc="OBA 1:14">Abi. 14</ref>; <ref loc="MAL 1:2-5">Mil. 1:2-5</ref>. </char></note><verse eid="AMO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12" />Baasooranxi kollo itendaashsha</para>
  <para style="q2" vid="AMO 1:12">Temaank dalla'uwwa'ni giirra worannoni.</para>
  <para style="q1" vid="AMO 1:12">Bootsiraanixxa kolluwwanna gubannon» hiyya'neeni.<verse eid="AMO 1:12" /></para>
  <para style="s1">Amooni</para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />Duuchchi Woddik Gootti hiyya'nee qici,</para>
  <para style="q1" vid="AMO 1:13">«Amooniki ardi cubbonde'ni lebee cubbo hujeemmaxxee'e,</para>
  <para style="q2" vid="AMO 1:13">mitte mami belo inisa'nee mura woxisannon.</para>
  <para style="q1" vid="AMO 1:13">Inisa'ne galcha ba'lisatee ke'issineeke lola'ni;</para>
  <para style="q2" vid="AMO 1:13">Gele'adike boga'ni hexxa'neexxa siilinxa melaale midde godoba inisa'neka darre'eeni.<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="JER 49:1-6">Erm. 49:1-6</ref>; <ref loc="EZK 21:28-32">Hiz. 21:28-32</ref>; <ref loc="EZK 25:1-7">25:1-7</ref>; <ref loc="ZEP 2:8-11">Sof. 2:8-11</ref>. </char></note><verse eid="AMO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14" />Tennexxee Raabak qachchik dalla'a'ni giira woranon; isenna kolluwwatanna ittaan; eettene loliinxa barra raarennaa hogi bira sa'aan; iikki lolinna hobonbaltetishsha wiinamaan.<verse eid="AMO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15" />Iseki moyanjinna hayyoole</para>
  <para style="q2" vid="AMO 1:15">mittenba booji'endee me'itaani»</para>
  <para style="q2" vid="AMO 1:15">hiyya'neen Duuchchi Woddik Gootti.<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="s1">Mo'aabi</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />Duuchchi Woddik Goottinna,</para>
  <para style="q1" vid="AMO 2:1">«Mo'aabik ardi cubbonde'ni lebee cubbo hujeemmaxxee'e,</para>
  <para style="q2" vid="AMO 2:1">mitte mami belo inisa'nee mura woxisannon.</para>
  <para style="q1" vid="AMO 2:1">Inisa'neenna Eedoomike moyanjiinxa miqe</para>
  <para style="q2" vid="AMO 2:1">soodo kaddaa qico'ni gube'e bululoke assannon.<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="ISA 15:1-16:14">Isa. 15:1—16:14</ref>; <ref loc="ISA 25:10-12">25:10-12</ref>; <ref loc="JER 48:1-47">Erm. 48:1-47</ref>; <ref loc="EZK 25:8-11">Hiz. 25:8-11</ref>; <ref loc="ZEP 2:8-11">Sof. 2:8-11</ref>.</char></note><verse eid="AMO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2" />Aninna Qeryootixxi kolluwwa itendaashsha,</para>
  <para style="q2" vid="AMO 2:2">Mo'aabi'ni giira woranno.</para>
  <para style="q1" vid="AMO 2:2">Mo'aabik ardi lolammake mannike caancinninna malagatinke hafuurixxe raare giddo,</para>
  <para style="q2" vid="AMO 2:2">lumoxxe weekkenshanni reyaan.<verse eid="AMO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3" />Mo'aabike bogika galchalluwwa kutti assanon;</para>
  <para style="q2" vid="AMO 2:3">sooressuwwa iseka duuchcha isenge moyanjinninni welti shiyannon;» hiyya'neen Duuchchi Woddik Gootti.<verse eid="AMO 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />Duuchchi Woddik Goottinna hiyya'nee qici,</para>
  <para style="q1" vid="AMO 2:4">«Yihudiinki ardi cubbonde'ni lebee cubbo hujeemmaxxee'e,</para>
  <para style="q2" vid="AMO 2:4">mitte mami belo inisa'nee mura woxisannon. Inisa'ne seera anka sa'ne'eeni.</para>
  <para style="q1" vid="AMO 2:4">Duuchchi Woddike Goottika seeranna tuffante'een;</para>
  <para style="q2" vid="AMO 2:4">ajaja ankanna heqqe'nebaan;</para>
  <para style="q1" vid="AMO 2:4">Annuwwi inisa'neki hordofaammaki</para>
  <para style="q2" vid="AMO 2:4">dharichchi magenuwwi inisa'neenna dedhise'eeni.<verse eid="AMO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5" />Iyyerusaalemixxi kolluwwa itendo'aa,</para>
  <para style="q2" vid="AMO 2:5">Yihuda'ni giira worannon.»<verse eid="AMO 2:5" /></para>
  <para style="s1">Mageniinxi Murte Isira'eeli'ni</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />Duuchchi Woddik Gootti hiyyee qici:</para>
  <para style="q1" vid="AMO 2:6">«Isira'eelik ardi cubbonde'ni lenbe cubbo hunjeemmaxxee'e</para>
  <para style="q2" vid="AMO 2:6">mitte mami belo insa'nee mura woxisannon.</para>
  <para style="q1" vid="AMO 2:6">Inisa'ne liqa liqqeesedhe hiissa gopheeka qullichcha manjo biretike sibljo'ni</para>
  <para style="q2" vid="AMO 2:6">rakkichcha hidhdheexxe kophekaa hira uwwa gopheeka hiyyeessa garbake kado'a gurgurreen.<verse eid="AMO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7" />Hunna afebaakanna gargaaraaka</para>
  <para style="q2" vid="AMO 2:7">hirbeesina'neeni;</para>
  <para style="q2" vid="AMO 2:7">umo ifika heeshshi assaaka shaqqake mannika manjo elobaake assinaan.</para>
  <para style="q1" vid="AMO 2:7">Annikinna belti laminigi mitte manjichchonni welti yabaabullaan;</para>
  <para style="q2" vid="AMO 2:7">tenne insa'nexxe hujenni qullichcha summa anka battoossinaan.<verse eid="AMO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8" />Liqa liqqeeffatee dandeete hiissiitabaaxxe hiyyeeyexxa seemma abixxine adhdhinaan;</para>
  <para style="q2" vid="AMO 2:8">tolcha tolchinaake booncho duuchcha'ni eettene adhdhinemmaxxa seemma buyye'nee diinphani.</para>
  <para style="q1" vid="AMO 2:8">Mageno insa'nekike galmi giddo,</para>
  <para style="q2" vid="AMO 2:8">liqa afeemmake mannanaa'ni mura wonxe adhdhineemmaxxa woyinetixxa bookka ha'winaan.<verse eid="AMO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9" />«Ani kinni ha'nooxxee hiyye hojja insa'nexxi biri birbrisiinsha,</para>
  <para style="q2" vid="AMO 2:9">hunnatinna ejerisiinsha hedheemmaka,</para>
  <para style="q2" vid="AMO 2:9">Amoorika manna booso inisa'nexxa ballesse birennen.</para>
  <para style="q1" vid="AMO 2:9">Ani isixxa gumma iimii'n,</para>
  <para style="q2" vid="AMO 2:9">hundi'ninna hidda isika balleessenne.<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="LEV 3:8-11">Lew. 3:8-11</ref>.</char></note><verse eid="AMO 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10" />«Amoorake mannika boga qadaada ha'nooke asse ha'no'aa uwwonaa,</para>
  <para style="q2" vid="AMO 2:10">Gibtseeke boganaa'ni ha'noo fulcheennexxi,</para>
  <para style="q2" vid="AMO 2:10">shoole tomme wogga duuchcha gammoojeke boga'ni inisa'nee akeekennen.<verse eid="AMO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11" />Labbaxxe ha'nooxxe oossexxe oddonaa'ni mitte mitte wabeekkole,</para>
  <para style="q2" vid="AMO 2:11">ha'nooxxe dargageeye giddii'ni mitte mitte Naaziraawwoota<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">Naaziraawwoota heenooxxa yanna woyintika bulbulo yookaan hoone machchoosaka ha'waa ha'wagophati, umo haaxa gophati, rensha tuqa gophati werreegati Magenoke'e foyemeeke Isira'eelootan. </char></note> assennexxi ke'issenenni;</para>
  <para style="q1" vid="AMO 2:11">Koo Isira'eelike ardaa! Eegga tinni dhugaandebataa?»</para>
  <para style="q4" vid="AMO 2:11">Ani Duuchchi Woddik Gootti tennee haasso'eenen.<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="NUM 6:1-8">Lak. 6:1-8</ref>. </char></note><verse eid="AMO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12" />«Ha'noo kinni Naaziroota woyinetika bulibulo ha'wissine'e dedhake'ni ibisine'een;</para>
  <para style="q2" vid="AMO 2:12">wabeekkotanna raaga raangabaashsha hoyyitineen.<verse eid="AMO 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13" />«Tennexxe hunnati iima midha feenneeki sarageeli isi hunda hexxeexxa yaane bulleessammashsha</para>
  <para style="q2" vid="AMO 2:13">aninna ha'noo bulleessanon.<verse eid="AMO 2:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="AMO 2:14" />Iikki wiinamaammak loliink manni wiinamma dande'abaa; hunnaammeeyye mannixxi hunnanna gophphaan;</para>
  <para style="q2" vid="AMO 2:14">lolaammakiirinna ifi anjira dande'abaani.<verse eid="AMO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15" />Gabee darbammaki boonchoke'ni ti'ni hiyyee uurrabaan;</para>
  <para style="q2" vid="AMO 2:15">iikki wiinamik lolemaammak baaje fulabaan;</para>
  <para style="q2" vid="AMO 2:15">iikki fadhado qolchisaakinna lubbo ifixxa anjirabaan.<verse eid="AMO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16" />Eettene barra iikki jabak worbi loliink manni midde</para>
  <para style="q2" vid="AMO 2:16">loliinka imaanna ifika hunee baajaan,»</para>
  <para style="q4" vid="AMO 2:16">hiyya'neeni Duuchchi Woddik Gootti.<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />Koo Isira'eelike ardaa! Duuchchi Woddik Gootti ha'noo Gibtsee'ni fulcheenek ane'ni ha'noo duuchchiingee haaso'eexxa konneechchinn butti'a hedheeka konnee hiyyichcho caqasse.<verse eid="AMO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2" />«Buttate'ni hedha'nekee arda duuchchanaa'ni,</para>
  <para style="q2" vid="AMO 3:2">ani fi'leennek ha'no callan;</para>
  <para style="q1" vid="AMO 3:2">Tennexxee ha'noo hujineemmaxxee cubbo duuchchi'a,</para>
  <para style="q2" vid="AMO 3:2">ani ha'noo mura woxisannon.» hiyye.<verse eid="AMO 3:2" /></para>
  <para style="s1">Wabeekoltixxa Huje</para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3" />Lami manni afo'i weli agebaangi,</para>
  <para style="q2" vid="AMO 3:3">miteba me'aa dande'aa?<verse eid="AMO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4" />Neenqi itaachcho afebaang, badda'a giddo tolanga harqaa?</para>
  <para style="q1" vid="AMO 3:4">Neenqiinxi beltanna mitteelcho alfebaak gongomi giddo buriqitaa?<verse eid="AMO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5" />Fonxoroo foxoorbaang,</para>
  <para style="q2" vid="AMO 3:5">ciicco buttate'ni fannaachchoo?</para>
  <para style="q1" vid="AMO 3:5">Abixxitaalcho mitteelcho affeebaang,</para>
  <para style="q2" vid="AMO 3:5">iitti fonxoro tuqqebaangi fixendo'aa dandeetaa?<verse eid="AMO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6" />Lolakee qophpheessaka malagatiinka hafuura qachchi giddo ufuunfaa wodda,</para>
  <para style="q2" vid="AMO 3:6">sodaate roqonsabaaki ardi hedhaa?</para>
  <para style="q1" vid="AMO 3:6">Ba'ne qachchake'n geltaa wodda,</para>
  <para style="q2" vid="AMO 3:6">tenne asseek Duuchchi Woddike Goottabaataa?<verse eid="AMO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7" />Dhugaaten Lumoki Duuchchi Woddik Gootti buqo yaane</para>
  <para style="q2" vid="AMO 3:7">ifike erganjuwwi'a ifisebaak,</para>
  <para style="q2" vid="AMO 3:7">mitte yaanenna assabaan.<verse eid="AMO 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8" />Neenqi ittanaa'na'a</para>
  <para style="q2" vid="AMO 3:8">laqe sodatabaaki ayyete?</para>
  <para style="q1" vid="AMO 3:8">Dada duuchchik Duuchchi Woddik Gootti haaso'ena'a</para>
  <para style="q2" vid="AMO 3:8">raaga raagabaak ayyete hedhe?<verse eid="AMO 3:8" /></para>
  <para style="s1">Samaariyaxxa Iba</para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9" />Ashidoodinna Gibtseexxe kollo'ni hedhake duuchchi'a hite lassitato qici;</para>
  <para style="q1" vid="AMO 3:9">«Semaariyaxxe koobuwwa hana bukki hiyye;</para>
  <para style="q2" vid="AMO 3:9">ise giddonna hexxeexxa jabaxxa weekkensha,</para>
  <para style="q2" vid="AMO 3:9">ardi iseki giddo hexxeexxa xaqaro uudde» hiyye.<verse eid="AMO 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10" />«Hunnati saamenna mulqe'ne kollo insa'nexi giddo tuu'lee wonshedheek manni;</para>
  <para style="q2" vid="AMO 3:10">eloxxa yaane assa ege'nebaani» hiyya'neen Duuchchi Woddik Gootti.<verse eid="AMO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11" />Tennexxe Lumok Duuchchi Woddik Gootti hiyya'nee qici:</para>
  <para style="q1" vid="AMO 3:11">«Naaphi ookkone boga'ni gumaan;</para>
  <para style="q2" vid="AMO 3:11">kolluwwa ha'nooxxanna diigan; seemmati giisineka mine ha'nokanna</para>
  <para style="q2" vid="AMO 3:11">saamme biraan» hiyye.<verse eid="AMO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 3:12" />Duuchchi Woddik Gootti hiyya'nee qici:</para>
  <para style="q1" vid="AMO 3:12">«Allalisanji neeqinke haagananaa'ni</para>
  <para style="q2" vid="AMO 3:12">lame gedhebiinxa lekka yookaan manshatika gamisa gatisammashsha</para>
  <para style="q1" vid="AMO 3:12">Iittanni Semaariya giddo taqe insa'nexxike kasa'ni;</para>
  <para style="q2" vid="AMO 3:12">Demasiqo giddo fanneexxe fawo'ni hana ofo'leekiri</para>
  <para style="q1" vid="AMO 3:12">Isira'eelik ardi anjiraan» hiyyeen.<verse eid="AMO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13" />«Tenne laqqe; Ya'iqoobike mine'ni hana dhugaa kulle» hiyya'nee Dada duuchcha Ajajaak Duuchchi Woddik Gootti Mageni.<verse eid="AMO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14" />«Ani Isira'eeli cubbo isexxee mura woxisannoxxa barra</para>
  <para style="q2" vid="AMO 3:14">Beetelika tolchimalchuwwa diigannon</para>
  <para style="q1" vid="AMO 3:14">Tolchimalchuwwiink gaafuwwi woxemaan;</para>
  <para style="q2" vid="AMO 3:14">buttanna ibaan.<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="2KI 23:15">2 Moy. 23:15</ref>.</char></note><verse eid="AMO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15" />Haarisika mine,</para>
  <para style="q2" vid="AMO 3:15">bonike mininni welti fedenshannon;</para>
  <para style="q1" vid="AMO 3:15">Daana'iinxe issonni seense ijaarremmak minnuwwi duuchchi diigemaan;</para>
  <para style="q2" vid="AMO 3:15">jajjabbi minuwwinna diigemaan,»</para>
  <para style="q4" vid="AMO 3:15">hiyyan'neeni Duuchchi Woddik Gootti.<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="s1">Isira'eel Duuchchi Woddike Goottiba'a Higgebaan</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1" />Ha'noo Semaariya giddo hexxina'nek Baasanke lalo</para>
  <para style="q2" vid="AMO 4:1">hiyyeesa miicina'nekenna rakkiyye wixixxi assitina'neeke</para>
  <para style="q2" vid="AMO 4:1">aro'o ha'nookanna, «Ha'winannoolcho no'aa qophpheesee!»</para>
  <para style="q2" vid="AMO 4:1">hitina'neexxe melaalle hiyyichcho konne laqqe.<verse eid="AMO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2" />Lumok Duuchchi Woddik Gootti woyyumma ifixxenn hiyye kakatee qici:</para>
  <para style="q2" vid="AMO 4:2">«Kunse ha'noo malixxaqoti abidendine harkisendinaaxxi</para>
  <para style="q1" vid="AMO 4:2">Hafe ha'nooxxi midde qulxu'metixxe malixxaqonni</para>
  <para style="q2" vid="AMO 4:2">adhdhendaaxxi yanna daggaan.<verse eid="AMO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3" />Mitti mitti ha'noong dalla'iinbaa'n hulluunqaak qo'i giddii'ni</para>
  <para style="q2" vid="AMO 4:3">Harmoon bogiba ha'no hunnaan»</para>
  <para style="q2" vid="AMO 4:3">hiyya'neen Duuchchi Woddik Gootti.<verse eid="AMO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4" />«Ha'noo Beeteli'a martineexxi cubbo hujje;</para>
  <para style="q2" vid="AMO 4:4">Geligeeli'anna martine bira saxxeexxa cubbo sasse.</para>
  <para style="q1" vid="AMO 4:4">Bariisa bariisa tolchuwwa ha'nooka,</para>
  <para style="q2" vid="AMO 4:4">sase sase wogga'ni tommitte shiqqishshe.<verse eid="AMO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5" />Lebele e'yiteeka buddeena galatiinke tolcha assitine shiqishshe;</para>
  <para style="q1" vid="AMO 4:5">Ifixxe eeyanni shiqishi'na'neke tolcha'ni kijibe</para>
  <para style="q2" vid="AMO 4:5">ha'noo Isira'eelik ardi insa'neni holle;</para>
  <para style="q2" vid="AMO 4:5">ha'noo assate'e eettineecho kaddeemmaxxee'e»</para>
  <para style="q4" vid="AMO 4:5">hiyya'neen Lumok Duuchchi Woddik Gootti.<verse eid="AMO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6" />«Ani qachcha qachchange'ni godoba ha'noka duwwi uggennen;</para>
  <para style="q2" vid="AMO 4:6">olla'a olla'ange'ni ittinaachcho</para>
  <para style="q2" vid="AMO 4:6">uwwisennen ha'no kinni anbaa higginebaan»</para>
  <para style="q2" vid="AMO 4:6">hiyya'neen Duuchchi Woddik Gootti.<verse eid="AMO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7" />«Mayetixxi yanna shiqo'a sasi agenji gattaa wodda,</para>
  <para style="q2" vid="AMO 4:7">ani xeen ganabaashsha assennen;</para>
  <para style="q1" vid="AMO 4:7">Mitte qachcha'ni gansiisennen</para>
  <para style="q2" vid="AMO 4:7">wele qachcha'ni kinni ganabaashsha assennen;</para>
  <para style="q2" vid="AMO 4:7">mittiinke fichcha'ni ganaa wodda,</para>
  <para style="q2" vid="AMO 4:7">weliink xeena gophe bageen.<verse eid="AMO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8" />Manni wode'iinka hasito qachchakenaa'ni wele qachchibaa doonsa kiyya hiyyee</para>
  <para style="q2" vid="AMO 4:8">kaddo malee'e ha'wine dheebo fullebaan;</para>
  <para style="q2" vid="AMO 4:8">ha'noo kinni anibaa higginebaan,»</para>
  <para style="q2" vid="AMO 4:8">hiyya'neen Duuchchi Woddik Gootti.<verse eid="AMO 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9" />«Hiddichchuwwiinkanna woyinetika fichcha ha'nooka heddole balleessennen;</para>
  <para style="q2" vid="AMO 4:9">qorrikinna jabaxxe diidallonni ganennen</para>
  <para style="q1" vid="AMO 4:9">Awwaanessuwwikinna balasetikanna ejernsiinxa ha'nooxxa haqqe itte;</para>
  <para style="q2" vid="AMO 4:9">ha'noo kinni anbaa higginebaan»</para>
  <para style="q2" vid="AMO 4:9">hiyya'neen Duuchchi Woddik Gootti.<verse eid="AMO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10" />«Ani Gibtseeke boga'ni assenneshshanni</para>
  <para style="q2" vid="AMO 4:10">baluwwa ha'no'n ergennen</para>
  <para style="q1" vid="AMO 4:10">Booji'emeke ha'nooke fadhaduwwinni welti</para>
  <para style="q2" vid="AMO 4:10">dargageeyye ha'nooxxa wolaantichchik shiyennen.</para>
  <para style="q1" vid="AMO 4:10">Ani ha'nooke loolka booncho sano ha'nooxxe'ni e'yaashsha assanon;</para>
  <para style="q2" vid="AMO 4:10">ha'no kinni anibaa higginebaan,»</para>
  <para style="q2" vid="AMO 4:10">hiyya'neen Duuchchi Woddik Gootti.<verse eid="AMO 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11" />«Soodoominna Gomora bakka inisa'nexxa balleessenshanni</para>
  <para style="q2" vid="AMO 4:11">ha'noo giddii'ni mitte mitte ganennen.</para>
  <para style="q1" vid="AMO 4:11">Ha'noo giiratenaa'ni itemebaang gatteeke itisanneshshatenn</para>
  <para style="q2" vid="AMO 4:11">ha'noo kinni anbaa dagginebaan»</para>
  <para style="q2" vid="AMO 4:11">hiyya'neen Duuchchi Woddik Gootti.<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="GEN 19:24">Dada. 19:24</ref>.</char></note><verse eid="AMO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12" />«Tennexxe koo Isira'eelike arda;</para>
  <para style="q2" vid="AMO 4:12">ani tenne ate'ni assaannaxxee, koo Isira'eelike arda;</para>
  <para style="q2" vid="AMO 4:12">Mageno ha'nookinna afendota'a ifi qophpheeffat» hiyye.<verse eid="AMO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13" />Koobuwwa giisaki,</para>
  <para style="q2" vid="AMO 4:13">diidaluwwa dadaaki,</para>
  <para style="q2" vid="AMO 4:13">yaada ifikanna manjokee ifisaaki,</para>
  <para style="q1" vid="AMO 4:13">Barra dukkanaa assaaki,</para>
  <para style="q2" vid="AMO 4:13">buttatixxa tulluwwa hadhaak,</para>
  <para style="q2" vid="AMO 4:13">summi isik lumoke Duuchchi Woddike Gootta Magenon.<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s1">Isira'eeliki Ardi Aade Aagaashsha Ye'emeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />Isira'eelike arda baloo! Ha'no'aa boochchisaaneeka boochchisa laqqe:<verse eid="AMO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2" />«Ikkiseteni duudo dubarrichcho Isira'eelixxi ibbeeni;</para>
  <para style="q2" vid="AMO 5:2">langaxxa kexxo'aa dande'a gophpheemmaxxee;</para>
  <para style="q1" vid="AMO 5:2">Ifike boga'ni fanxaraarite'een;</para>
  <para style="q2" vid="AMO 5:2">isee gargaare ke'issaaka alfitebaan.»<verse eid="AMO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />Lumok Duuchchi Woddik Gootti:</para>
  <para style="q1" vid="AMO 5:3">«Mitte Isira'eelike qachchanaa'n kumi manni duulo duulaani;</para>
  <para style="q2" vid="AMO 5:3">duulokena'ni hige dagaaki kinni mitte dhibba calla higaan;</para>
  <para style="q1" vid="AMO 5:3">Wele qachchana'ni dhibbi manni duulo duulaani;</para>
  <para style="q2" vid="AMO 5:3">duulokenaani hige dagaaki kinni tomme calla kadaan.»<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />Duuchchi Woddik Gootti, Isira'eelika arda balloo! Anbaa higge;</para>
  <para style="q1" vid="AMO 5:4">«Hedhotinna hexxinaan;»<verse eid="AMO 5:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 5:5" />Yaane kinni Geligeela mitte gatteebag booji'enda'neen, Beetteelinnaa tolanga gattaammaxxee'e Beeteli martinoqqe'e; Geligeela'aanna e'yitinoqqe; Bersaabehinna qaxxaamurtinoqqee.<verse eid="AMO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6" />Ha'noo Duuchchi Woddika Gootta halse;</para>
  <para style="q2" vid="AMO 5:6">hedhoti hexxinaan;</para>
  <para style="q1" vid="AMO 5:6">Kada gophphoole isi giiratishsha Yoosefika arda biraan;</para>
  <para style="q2" vid="AMO 5:6">iitti giirattinna Beeteli'i ittaan; isee balleessakinna hedhabaan.<verse eid="AMO 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7" />Ha'noo dhugaatixxa murte qaraartaaxxe yaanebaa jijjiirtinaak,</para>
  <para style="q2" vid="AMO 5:7">qullummatanna butti'aa darbitinaake ha'no'aa aanne'ee!<verse eid="AMO 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 5:8" />Torbaaane urjuwwanna Oriyoonii hujeeki,</para>
  <para style="q2" vid="AMO 5:8">dukkanna soodimariink ifibaa jijjiiraaki;</para>
  <para style="q2" vid="AMO 5:8">barra dukkanseexxi hashshate assaaki;</para>
  <para style="q1" vid="AMO 5:8">Abbaayyatika wode'e ye'eexxi,</para>
  <para style="q2" vid="AMO 5:8">buttati hana yaa'aashsha assaki</para>
  <para style="q2" vid="AMO 5:8">summi isikinna Duuchchi Woddike Goottan.<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="JOB 9:9">Iyo. 9:9</ref>; <ref loc="JOB 38:31">38:31</ref>. </char></note><verse eid="AMO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9" />Isi jabaxxe kollo'ni dedhange'ni kaddaaxxa ba'ne,</para>
  <para style="q2" vid="AMO 5:9">kollifateemmeeke qachcha'ninna bakka balleessitaaxxe ba'ne iyyedagaan.<verse eid="AMO 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10" />Ha'noo murtetixxe bakka'ni</para>
  <para style="q2" vid="AMO 5:10">ha'noo xixaaka jibbitinna;</para>
  <para style="q2" vid="AMO 5:10">dhugaa haaso'aakanna tuffatinaan.<verse eid="AMO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11" />Hiyyeeyyetanna hirbeessitineen;</para>
  <para style="q2" vid="AMO 5:11">midha inisa'neexxanna saandine adhdhitineen.</para>
  <para style="q1" vid="AMO 5:11">Boceme seesemeeke kinijinni minnuwwa ijaadhdhitineen;</para>
  <para style="q2" vid="AMO 5:11">ha'no kinni ookkone minnuwwi giddo hexxinabaan;</para>
  <para style="q1" vid="AMO 5:11">Gammachchiissaxxa woyine kaarsitineen</para>
  <para style="q2" vid="AMO 5:11">yaane kinni issenaa'ni afemaaka woyinetika bulibulo ha'nnona ha'witinabaan.<verse eid="AMO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12" />Cubbo ha'nooxxi hittatta jabaxxe kaddeexxa</para>
  <para style="q2" vid="AMO 5:12">balleessa ha'nooxxinna hitte qico bira saxxeexxa ani ege'nennen.</para>
  <para style="b" vid="AMO 5:12" />
  <para style="q1" vid="AMO 5:12">Ha'noo qullichcha miicinaa;</para>
  <para style="q2" vid="AMO 5:12">mattakanna adhdhitina;</para>
  <para style="q2" vid="AMO 5:12">murtetixxe songo'ninna hiyyeessakenaa'ni dhuggaatixxa murte hoyyexxinaan.<verse eid="AMO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13" />Tennexxee qalbeeffataki manji iitte wodda sammi hiyya;</para>
  <para style="q2" vid="AMO 5:13">yannatinna fuggitete kaddeemmaxxee.<verse eid="AMO 5:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14" />Hedhoti hexxinaashsha,</para>
  <para style="q2" vid="AMO 5:14">eloxxa malee'e elobaaxxa hujinoqqe'e;</para>
  <para style="q1" vid="AMO 5:14">Ookkonechchi uduma haaso'emashanni,</para>
  <para style="q2" vid="AMO 5:14">Dada Duuchcha Ajajaak Duuchchi Woddik Gootti Mageni ha'noonni welti hedhaan.<verse eid="AMO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15" />Ha'noo fuggoxxa yaane hunidine waale; eloxxanna eeyye;</para>
  <para style="q2" vid="AMO 5:15">murte murraaxxe songa'ni dhugaatixxa murte dassitinoqqe'e.</para>
  <para style="q1" vid="AMO 5:15">Akimagaada Dada Duuchcha Ajajaak Duuchchi Woddik Gootti Mageni;</para>
  <para style="q2" vid="AMO 5:15">Yoosefixxe hafe'aa mararaaxxe hexxeen.<verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />Tennexxee Dada Duuchcha Ajajaak Duuchchi Woddik Gootti Mageni hiyya'nee qici;</para>
  <para style="q2" vid="AMO 5:16">«Ora oranaa'ninna ardi duuchchi woo hiyyee oodhaan;</para>
  <para style="q1" vid="AMO 5:16">Weldeenna weldeennate'ni wixixxi hiyyatixxe raare kaddaan wiisaluwwi oodhishshatee</para>
  <para style="q2" vid="AMO 5:16">oodhishshaluwwi wi'lishshatee ye'eman.<verse eid="AMO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17" />Woyinetik hiddichchiinke fichchiinke booncho duuchcha'ni oodhdhishsha kaddaan;</para>
  <para style="q2" vid="AMO 5:17">tinni duuchcha kaddaa'neek ani oddo insa'nexxenaa'ni sa'aannaxxeeten,»</para>
  <para style="q2" vid="AMO 5:17">hiyya'neen Duuchchi Woddik Gootti.<verse eid="AMO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18" />Duuchchi Woddike Goottixxa barra hassina'neekee</para>
  <para style="q2" vid="AMO 5:18">ha'no'aa aanne'ee!</para>
  <para style="q1" vid="AMO 5:18">Duuchchi Woddike Goottixxa barra ha'noo mayee hassinna'nee</para>
  <para style="q2" vid="AMO 5:18">iitti barra dukkanate malee ifakebaan.<verse eid="AMO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19" />Tinni barra mitti manji neenqakenaa'ni baaja'naa;</para>
  <para style="q2" vid="AMO 5:19">Dibi hinaaki biniichchi futti hiyyammashsha,</para>
  <para style="q1" vid="AMO 5:19">Mine ifikibaa e'yeexxi, anga ifixxa gimoti</para>
  <para style="q2" vid="AMO 5:19">hana ugge'naa,</para>
  <para style="q2" vid="AMO 5:19">iddammake bofixxen.<verse eid="AMO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20" />Duuchchi Woddike Goottixxi barra ifi leellabaaxxe lumoxxe dukkanan</para>
  <para style="q2" vid="AMO 5:20">ifiink wolalacci hedhebaake dimma dukkanabaata?<verse eid="AMO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21" />«Ani ayyaanuwwa ha'nooka jibbeennen;</para>
  <para style="q2" vid="AMO 5:21">tuffateenen; ya'i ha'nookinna anee gammachchiisa'nebaan.<verse eid="AMO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22" />Ciinco'aaka tolcha ha'nookanna midhatika tolcha ani'a shiqishshinoolenna</para>
  <para style="q2" vid="AMO 5:22">Ani adhdhaabo'noni.</para>
  <para style="q1" vid="AMO 5:22">Ha'yoo horenaa'ninna mittoominka tolcha shiqishinoole;</para>
  <para style="q2" vid="AMO 5:22">ani ookko'a uudabo'non.<note caller="-" style="x"><char style="xo" closed="false">5:22 </char><char style="xt" closed="false"><ref loc="ISA 1:11-14">Isa. 1:11-14</ref>.</char></note><verse eid="AMO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23" />Ha'nooxxe faaroxxa raare anenaa'ni fugusse;</para>
  <para style="q2" vid="AMO 5:23">masinqotika meelanna laqabo'non;<verse eid="AMO 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24" />Yaane kinni dhugaatixxi murte wode'iinsha</para>
  <para style="q2" vid="AMO 5:24">qullummatinna baggammabaaxxe muummeshsha duneduun.<verse eid="AMO 5:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25" />«Koo Isira'eelike ardaa ballo'o! Shoole tomme wogga qiila gammoojje'ni;</para>
  <para style="q2" vid="AMO 5:25">tolchakanna qurbaana ani'a shiqishineemata?<note caller="-" style="x"><char style="xo" closed="false">5:25 </char><char style="xt" closed="false"><ref loc="ACT 7:42-43">Erga. Huj. 7:42-43</ref>. </char></note><verse eid="AMO 5:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26" />Ha'noo ifi'a huccitineeka;</para>
  <para style="q2" vid="AMO 5:26">moyanjoke hitina'neeka saakuuti ha'noka magenuwwa,</para>
  <para style="q2" vid="AMO 5:26">magenoonfatine'neke magenuwwixxa sooddo</para>
  <para style="q2" vid="AMO 5:26">ha'nooke mangenuwwixxa urje iimi'a ke'isitine dulkexxineen.<verse eid="AMO 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27" />Tennexxe Demasiqo wido shorrendinaashsha assannoni»</para>
  <para style="q2" vid="AMO 5:27">hiyya'neeni Dada Duuchcha Ajajaak Duuchchi Woddik Gootti Mageni.<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s1">Isira'eelixxa Baa'ne</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 6:1" />Tsiyooni giddo xoo'mamik hexxineekenna,</para>
  <para style="q2" vid="AMO 6:1">Semaariyaxxe kooba hana mitte godobinni ofoldineekee,</para>
  <para style="q1" vid="AMO 6:1">Isira'eelik ardinna gargaarsakee ha'noobaa daagakee,</para>
  <para style="q2" vid="AMO 6:1">ha'noo gosa gosak ardike akeekisanjuwwaa ha'no'aa aannee!<verse eid="AMO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2" />Kaaline'a me'ee, isoonna uudde;</para>
  <para style="q2" vid="AMO 6:2">ookko'ninna lumoke qachchibaa Hamaati'a me'ee.</para>
  <para style="q1" vid="AMO 6:2">Filsixeemike qachchibaa Gaati'a aadadde dirre;</para>
  <para style="q2" vid="AMO 6:2">insa'neke bogiki ba'linni ha'nookenaa'ni sa'aataa?<verse eid="AMO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3" />Ha'noo fuggoxxa barra bayyisinaakee,</para>
  <para style="q2" vid="AMO 6:3">miicamik galchitina'n shiqishshina'neekee ha'no'aa aanne'ee!<verse eid="AMO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4" />Daana'iinixxe issoni hunjeexxe ma'na'ni diiphphina'neeke;</para>
  <para style="q2" vid="AMO 6:4">quphphite ha'nooxxe taqe'ni fenxee hitina'neeke,</para>
  <para style="q1" vid="AMO 6:4">Gedhebi giddii'ni buruusa,</para>
  <para style="q2" vid="AMO 6:4">godhetenaa'ni jibichcha itinaa'neke ha'no'aa aanne'ee!<verse eid="AMO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5" />Faarsatee elaasha giisemebaake lumok baganinni Daawwitisha sirbitinakee,</para>
  <para style="q2" vid="AMO 6:5">faarotike miyinni geebbino'a yortina'neekee,<verse eid="AMO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6" />Woyinetixxa bookanna waabake'ni ha'witina'neekee,</para>
  <para style="q2" vid="AMO 6:6">hara fiixeexxa shittonna issatina'neeke,</para>
  <para style="q2" vid="AMO 6:6">Isira'eelike arda'ni kinni gelteexxe rakkoxxee yaaddina'nebaakee ha'no'aa aannee!<verse eid="AMO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7" />Tennexxe ha'noo edise booji'eemmaammake manni giddo hexxinaan;</para>
  <para style="q2" vid="AMO 6:7">ha'nooxxi fenxee hiyyanna ha'nooxxi dayya'a gattaan.<verse eid="AMO 6:7" /></para>
  <para style="s1">Duuchchi Woddik Gootti Isira'eelixa Ifi saada Diqata</para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />Lumooki Duuchchi Woddiki Gootti,</para>
  <para style="q1" vid="AMO 6:8">«Isira'eelike ardixxa ifi duka jibbeenneni.</para>
  <para style="q2" vid="AMO 6:8">Ani insa'neka seesemeeka mootummatika minuwwa boshshedheenneni;</para>
  <para style="q1" vid="AMO 6:8">ookkone qachchuwwi giddo hedheeka manna duuchcha,</para>
  <para style="q1" vid="AMO 6:8">Naaphakee sa'issee uwwaannon» hiyyeexxi ifi'ni kakateen.<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />Mitte mini giddo tommi manji calli gatoole iikki midde reyan. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />Ookkone reyeemmaka manna minii'ni fulche giirate'ni gubaak mitti shiqike fira kadeek dageexxi ookko mini giddo sho'omee hedheeka mitte manjo ye'eexxi, «Atinni welti gateeki weli manji hedhee?» hiyyee wodda, isinna «Mittikinna gateeki hedhebaan» hiyyeexxi hiisaan; ookkonneechchi uduma, qoreemmaki manjichchinna isoo «Duuchchi Woddike Goottika summa ganaa dandeennabo'noon sammi hiyyi!» hiyyaani.<verse eid="AMO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 6:11" />Kunnise Duuchchi Woddik Gootti ajaja uwwe'een;</para>
  <para style="q2" vid="AMO 6:11">isi lumollama minnuwwa diigan;</para>
  <para style="q2" vid="AMO 6:11">shiixxaramma minuwwanna bulleesaan.<verse eid="AMO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12" />Fadhadi care giddo qolchaata?</para>
  <para style="q2" vid="AMO 6:12">Manjitaa ookko hana qottiyyoti wiilsa dande'aata?</para>
  <para style="q1" vid="AMO 6:12">Ha'noo kinni dhugatixxa murte fuggobaa,</para>
  <para style="q2" vid="AMO 6:12">qullummataxxa gummanna qaraaratibaa jijjiirtineen.<verse eid="AMO 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 6:13" />Ha'noo Lodobaarika qachcha lolidine injifatati gammadine'eek,</para>
  <para style="q2" vid="AMO 6:13">«Qarinayimika qachchanna hunnaa no'oxxenni adhdhinenneni» hitina'ni burraaqqina'neeke.<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fqa" closed="false">Lodobaar: </char><char style="ft" closed="false">Qachchiinke summa kada wodda kunni hiyyichchi Ibirayisixxikenn Tolinixxe yaane hiyyate.</char></note><verse eid="AMO 6:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14" />Lumoki Duuchchi Woddiki Gootti Mageni hiyya'nee qici,</para>
  <para style="q2" vid="AMO 6:14">«Koo Isira'eelike ardaa! Ani middixxe Hamaatixxe hulanaa'ni bita'ixxe Arebaaxxe dhooqa qiconi</para>
  <para style="q1" vid="AMO 6:14">Ha'noo rakkisaaka arda ha'noo'ni</para>
  <para style="q2" vid="AMO 6:14">ke'isannon.» hiyya'neen.<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s1">Awwaaneesiinxa Daga Kuldaaxxa Waleella</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />Lumoki Duuchchi Woddiki Gootti ane'ni waleella leelishshen; tenne leella giddo moyaanjiinxa mayetixxa midha haammeke'ni'nna latemmake qorjaa'ni Duuchchi Woddiki Gootti Awwaaneessiinki haagani dademaashsha asse. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />Awwaaneessiinki haaganinna buttate'ni latte haanjedheechcho duuchcha ite bireexxa uudeennexxi, «Lumoke Duuchchi Woddike Goottaa! Atike ardixxa balleessa balloo gattowwaal hiyyi! Ardi atiki Isira'eeli he'nookenna hunna afebaake kadeemmaxxee hoonte gata» hiyyee soodatenen.<verse eid="AMO 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3" />Duuchchi Woddiki Gootti ardakee marareexxi, «Tinni uudetexxi waleella muuxedaashsha assabo'noo!» hiyye.<verse eid="AMO 7:3" /></para>
  <para style="s1">Mura Woxissaaxxi Giira Daggaaxxa Kuldaaxxa Leela</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />Lumok Duuchchi Woddiki Gootti ane'ni leelishshexxi wele waleela konneechchinni butti'a hexxeexxeni; tenne leela giddo Lumok Duuchchi Woddiki Gootti arda ifike'ni giirati muro'a qophpheefate; giirattinna abbaayyatixxa dhi'mo bassite; ookkone boganna itte. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />Ookkonneechchi uduma ani hiyye soodatenne qici, «Ee, Lumoke Duuchchi Woddike Gootta balloo! Giira tenne uurrisi! Isira'eelk atik ardi hnunna afebaake kadeemmaxxee tenne dande'aata?»<verse eid="AMO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6" />Duuchchi Woddiki Goottinna ardakee maraarexxi, «Tinni muuxxendabaan» hiyye.<verse eid="AMO 7:6" /></para>
  <para style="s1">Tunbii (Gimotika Toginne minkaake Sibljixxa) Leela</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />Duuchchi Woddiki Gootti wele waleelanna ane'ni leelishsheen tenne leela giddo Duuchchi Woddiki Gootti tunbiitike mikisanjinni giisemee ijaaremeeke dalla'i qarqara uure'na afeenne isinna tunbii anga abixxeemman <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />Duuchchi Woddik Goottinna, «Koo Amootsii! Uuddaatexxi yaane maachchoo?» hiyyeexxi anee qore.</para>
  <para style="p" vid="AMO 7:8">Aninna, «Tumbii'i» uudaanen hiyyennexxi hiissenne.</para>
  <para style="p" vid="AMO 7:8">Ookkonneechchi uduma Dada Duuchchiki Goottinna anee hiyyee qici, «Kunse ani anke Isira'eelke ardixxe oddo'ni tunbii dirriissannon; ta'inni edi'aa insa'ne'aa mararabbo'non.<verse eid="AMO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9" />«Yisaaqi magenoonfatammaxxi koobuwwa onake kaddaan;</para>
  <para style="q2" vid="AMO 7:9">Isira'eelik galmuwwinna diigemaan;</para>
  <para style="q2" vid="AMO 7:9">Iyyorbi'aamike arda'ni anke wolaatichchinni ke'annon.»<verse eid="AMO 7:9" /></para>
  <para style="s1">Amootsinna Amesiyaa</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />Ookkoneechchi uduma Beeti'elik qeesichchi Ameetsiyaasi Isira'eelke moyanjo Iyyorbi'aami'a ergaa hiyye ergee qici, «Amootsi Isra'eelike ardixxe oddo'ni hedhee atixxee ximmalate'ni hedheeni. Iikki ardinna haaso'a isike'ni ti'ni hiyya dande'abaan. <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />Amootsi hiyyee haaso'ee qici,</para>
  <para style="q2" vid="AMO 7:11">« ‹Iyyorbi'aami wolaantichchik reyaani;</para>
  <para style="q2" vid="AMO 7:11">Isira'eeli ardinna boga ifikenaa'ni booji'emee adhemmaan› » hiyye.<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />Ameetsiyaasinna, Amootsii'i hiyyee qici, «Koo ati waleellati me'i kabaa'ni! Yihudake bogibaanna baajettexxi ookkonna raaga raaga'ni itattanna iti. <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />Yaane kinni Beeteli moyanjiink galmanna ardiinke magenoofachchotixxe bakka kaddeemmaxxee'e konne booncho'ni langaxxa raaga raaggoxxee.»<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />Amootsinna Ameetsiyaasi'aa hiyyee qici, «Ani hore allalannokenna ode'iinxa gumma qocedhanoke malee'e raagichcho yookaan raagichchiinke beltobaan. <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />Yaane kinni Duuchchi Woddiki Gootti anee gedhebo allalaane boonchonaa'ni aadhdheexxii, ‹Martettexxi arda anke Isira'eelke raaga raagi› anee hiyye. <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />Yoonna Duuchchi Woddiki Goottika hiyyichcho laqi.</para>
  <para style="q1" vid="AMO 7:16">« ‹Isira'eelike arda'ni ati raaga raagoxxe;</para>
  <para style="q2" vid="AMO 7:16">Yisaaqixxe horte'ni lallaboxxee› hitatton.<verse eid="AMO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17" />«Tennexxee Duuchchi Woddik Gootti atixxee hiyya'nee qici,</para>
  <para style="q1" vid="AMO 7:17">« ‹Are atixxi ookkone qachchi giddo yabaabula kaddaan;</para>
  <para style="q2" vid="AMO 7:17">labbaxxinna meyyaxxi atixxi oose wolaantichchik reritaan.</para>
  <para style="q1" vid="AMO 7:17">Boga atikanna wodaroti minka'nee qoqqoodemmaan;</para>
  <para style="q2" vid="AMO 7:17">atinna umo atingenninni anafeeke boga'ni reritatton.</para>
  <para style="q1" vid="AMO 7:17">Isira'eelinna ifike boganaa'ni booji'ende adhdhendaan.› »<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s1">Amootsi Raxxeexxi Gumma Wo'miteexxa Shaaqale Waleelati Uuddeexxa</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />Dada Duuchchik Duuchchi Woddiki Gootti wele waleela ane'ni leelishshe; kunse raxxeexxe gumma wo'miteexxa shaaqale uuddenne. <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />Duuchchi Woddiki Goottinna, «Koo Amootsi maachcho uuddaatee?» hiyye anee qore.</para>
  <para style="p" vid="AMO 8:2">Aninna, «Raxxeexxi gumma shaaqalette'ni wo'mitee'naa uuddannen» hiiyye hiissennen.</para>
  <para style="p" vid="AMO 8:2">Ookkonneechchi uduma Duuchchi Woddiki Gootti anee hiyyee qici, «Anke ardik Isira'eelik muuxxami geyeedheen; ta'inni udumaa ani insa'nee mararabe'noni.»<verse eid="AMO 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3" />Dada Duuchchik Duuchchi Woddik Gootti, «Eettene barra Galmi giddiki sirbi oodhishatibaa, jijjiiremmaan; heddi manniki renshi booncho booncho'ninni ibaan; bucuqqi hiyyaachchi hedhabaan.»<verse eid="AMO 8:3" /></para>
  <para style="s1">Isira'eelixxa Iba</para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4" />Ha'noo rakkiyye hirbeesitina'neeki,</para>
  <para style="q2" vid="AMO 8:4">ookkone bogixxxa hiyyeeyye bogakenaa'ni balleessatee hassina'neek duuchchi! Tennee hiyyaannexxa laqqee!<verse eid="AMO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 8:5" />Ha'noo hitina'nee qici,</para>
  <para style="q1" vid="AMO 8:5">«Saffarsanjo shiixxishshati,</para>
  <para style="q2" vid="AMO 8:5">hirakanna caala lebati,</para>
  <para style="q1" vid="AMO 8:5">Dhariinxee kiilonni sobati,</para>
  <para style="q2" vid="AMO 8:5">midha gurgudhinonnaa,</para>
  <para style="q1" vid="AMO 8:5">Reefi fuldaaxxe baateki ayyaan haano muuxemaa?<verse eid="AMO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6" />Hiyyeessa biretike sibljinni,</para>
  <para style="q2" vid="AMO 8:6">rakkichchakanna lame lekkaxxe kophenni hidhdhinannon;</para>
  <para style="q2" vid="AMO 8:6">huurakanna midde dinnetike hira'ni gurgudhinannon.»<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />Ya'iqoobi'aanna horte isixxee irko kadeek Duuchchi Woddiki Gootti hiyya'nee qici, «Insa'ne assineexxa duuchcha ijje dedhabbo'non hiyye'e ifi'ni kakate.<verse eid="AMO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8" />«Tenne fuggoxxe hujeexxeera butta lele'mitabaataa?</para>
  <para style="q2" vid="AMO 8:8">ookkone bogi giddo hedheek ardi duuchchi oodhabaataa?</para>
  <para style="q1" vid="AMO 8:8">Abbaayik galaan wo'me xe'yeexxi saankuramaashsha</para>
  <para style="q2" vid="AMO 8:8">bogi iikki duuchchi iittanni sankuraan.»<verse eid="AMO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9" />Dada Duuchchik Duuchchi Woddiki Gootti hiyya'nee qici,</para>
  <para style="q2" vid="AMO 8:9">«Eettene barra ani barra saafo'a arishsho aaggaashsha assannon;</para>
  <para style="q2" vid="AMO 8:9">buttatanna wa'a hiyyeek ifi hedhe'naani barranni dukkansanno.<verse eid="AMO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10" />Ha'nooka ayyaanuwwa oodhishshatibaa,</para>
  <para style="q2" vid="AMO 8:10">ha'nooxxa faaruwwanna wi'lishshatibaa jijjiirannon.</para>
  <para style="q1" vid="AMO 8:10">Ha'no duuchchiing yaaddotixxa seemma odo'witinaashsha,</para>
  <para style="q2" vid="AMO 8:10">umo ha'nookanna haaxxitinaashsha assannon.</para>
  <para style="q1" vid="AMO 8:10">Eettene barra mitte reyeeke ifike belti'a oo'nammashsha,</para>
  <para style="q2" vid="AMO 8:10">eettene yaanaka muuxamma qaraareeke assanon.<verse eid="AMO 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11" />«Kunniseten buttate'ni solo'o ibisannoxxi yaana dagaan»</para>
  <para style="q2" vid="AMO 8:11">hiyya'neen Dada Duuchchik Duuchchi Woddik Gootti.</para>
  <para style="q1" vid="AMO 8:11">«Eettene yanna manni solo'aakinna dheebbo'waak</para>
  <para style="q2" vid="AMO 8:11">Duuchchi Woddike Goottika hiyyichcho laqatike solo'o malee,</para>
  <para style="q2" vid="AMO 8:11">indaachcho solo'watike yookaan ha'winaachcho dheebo'watikebaan.<verse eid="AMO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12" />Ardi Duuchchi Woddike Gootta harssiyyotee</para>
  <para style="q2" vid="AMO 8:12">abbayatenaa'ni abbaayatiba'a</para>
  <para style="q1" vid="AMO 8:12">Middakenaa'ni borotibaa doonsa kiyya hiyaan;</para>
  <para style="q2" vid="AMO 8:12">yaane kinni alfabaan.<verse eid="AMO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13" />«Eettene yaana</para>
  <para style="q1" vid="AMO 8:13">«Danchalammi oossitte dubariinna worba woraba dargageeyyenna,</para>
  <para style="q2" vid="AMO 8:13">wodiinxe dheebonaa'ni kexxeexxa gagganban.<verse eid="AMO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14" />Semaariyake salphine'n yookaan ‹Ashemma› hiyyenda'nexxe fakke'ni kakatakir,</para>
  <para style="q2" vid="AMO 8:14">yookaan, ‹Daani hedhaake atike magenxi› hiyyaakir</para>
  <para style="q2" vid="AMO 8:14">yookaan, ‹Hedhaake Bersaabehike magenxa› hiyye kakataakir,</para>
  <para style="q2" vid="AMO 8:14">langaxxa ke'naba qico'n duuchchi woddi'a inbaan.»<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s1">Mageniinxa Murite</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />Dada Duuchchik Gootti tolchimalchi bira uurre'na afenne,</para>
  <para style="q1" vid="AMO 9:1">«Madirekuwwa linqi linqi hitaashsha</para>
  <para style="q2" vid="AMO 9:1">utuphuwwiniinxa bokkuwwa gani,</para>
  <para style="q1" vid="AMO 9:1">Ookkone ardike umo'ni konneechchuwwa butuchchi;</para>
  <para style="q2" vid="AMO 9:1">gateeka arda ani wolaantichchik shiyannon</para>
  <para style="q1" vid="AMO 9:1">Insa'ne giddii'ni mitti manjinna baqataak hehdebaan</para>
  <para style="q2" vid="AMO 9:1">baajoolenna fulaak hedhebaan.<verse eid="AMO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2" />Dhi'mo bale qoltine butti'aa me'ineelenna,</para>
  <para style="q2" vid="AMO 9:2">anga anxi ookko'ni insa'nee fulchitaan;</para>
  <para style="q1" vid="AMO 9:2">Iimi'aa fulloolenna,</para>
  <para style="q2" vid="AMO 9:2">ookko'ni insa'nee dirrisannon.<verse eid="AMO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3" />Qermeeloosixxe xungo'ni sho'omoolenna,</para>
  <para style="q2" vid="AMO 9:3">adame hasee ookko'ni insa'nee dirrisannon;</para>
  <para style="q1" vid="AMO 9:3">Abidannon;</para>
  <para style="q2" vid="AMO 9:3">dhi'mo abbaayya giddo anenaa'ni sho'omoolenna,</para>
  <para style="q2" vid="AMO 9:3">ookko'o bofi insa'nee iddaashsha ajajannon;<verse eid="AMO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4" />Naaphpha inisa'neke'ni booji'emme oofemme eme'inoolenna,</para>
  <para style="q2" vid="AMO 9:4">ookko'o insa'nee shinnaashsha wolaantichcha ajajannon.</para>
  <para style="q1" vid="AMO 9:4">Eloxeete kaddebang elobaaxee</para>
  <para style="q2" vid="AMO 9:4">ille anxa insa'ne'ni uggannon.»<verse eid="AMO 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5" />Dada Duuchcha ajajaka Duuchchi Woddika Gootta</para>
  <para style="q1" vid="AMO 9:5">Butta tuqqabaan,</para>
  <para style="q2" vid="AMO 9:5">buttatinna baqqaani;</para>
  <para style="q1" vid="AMO 9:5">Ise giddo hedhaachchi duuchchi oodhaan</para>
  <para style="q2" vid="AMO 9:5">buttate'ni hedheechchi duuchchi Abbayike wode'ishsha ke'aan;</para>
  <para style="q2" vid="AMO 9:5">Gibtseeke galaansha yaa'ani.<verse eid="AMO 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 9:6" />Mine ifika iimate'ni ijaadhaaki,</para>
  <para style="q2" vid="AMO 9:6">boosotanna buttate'ni assaak,</para>
  <para style="q1" vid="AMO 9:6">Abbaayyatika wode'e ajajaaki ye'aake</para>
  <para style="q2" vid="AMO 9:6">buttinnaa duuchcha'ni dhangalaasaak,</para>
  <para style="q2" vid="AMO 9:6">suummi isiki Duuchchi Woddike Goottan.<verse eid="AMO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 9:7" />«Ha'noo Isira'eelik ardi,</para>
  <para style="q2" vid="AMO 9:7">ha'noo ani'aa Tophiyiinke ardishshaten»</para>
  <para style="q2" vid="AMO 9:7">hiyya'neen Duuchchi Woddik Gootti</para>
  <para style="q1" vid="AMO 9:7">«Isira'eelika arda Gibtsee'ni,</para>
  <para style="q2" vid="AMO 9:7">ittanni Filisixxeemika ardanna Qeerixxesii'ni,</para>
  <para style="q2" vid="AMO 9:7">Sooriyaka ardanna Qiirii'ni fulchebo'notaa?<verse eid="AMO 9:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8" />«Kunnse Duuchchi Woddiki Gootti Magenixxi illuwwa,</para>
  <para style="q2" vid="AMO 9:8">cubbaleete mootumma'ni hana hexxeen;</para>
  <para style="q1" vid="AMO 9:8">Isenna buttatenaa'ni kutti assee balleessannoni;</para>
  <para style="q2" vid="AMO 9:8">kaddo malee Ya'iqoobixxa horte duuchcha hara kutti asse</para>
  <para style="q1" vid="AMO 9:8">Balleesse birabo'non»</para>
  <para style="q2" vid="AMO 9:8">hiyya'neen Duuchchi Woddik Gootti.<verse eid="AMO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9" />«Kunnise ajaja uwwannon</para>
  <para style="q2" vid="AMO 9:9">midha diddiqate'ni diddisinammashsha,</para>
  <para style="q2" vid="AMO 9:9">Isira'eelika mine,</para>
  <para style="q1" vid="AMO 9:9">Gosa gosake ardi duuchchixxe oddo'ni iittanni assannon;</para>
  <para style="q2" vid="AMO 9:9">yaane kinni mitte gumma qixxa buttate'ni ibbabaan.<verse eid="AMO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10" />Ardiinxe oddo'ni hedheexxi</para>
  <para style="q2" vid="AMO 9:10">‹fuggoxxi yaane no'oo geltabaan yookaani no'oo affabaan› hiyyaakkeeri'aa,</para>
  <para style="q1" vid="AMO 9:10">Cubbaleeyye duuchchi,</para>
  <para style="q2" vid="AMO 9:10">‹wolaantichchik rertaan.› »<verse eid="AMO 9:10" /></para>
  <para style="s1">Isira'eelike Ardi Illee Iima Higatee Uwwendeexxa Adde</para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 9:11" />«Eettene barra ibbeeka,</para>
  <para style="q1" vid="AMO 9:11">ookkonee Daawwitika duunkaana ke'issannon.</para>
  <para style="q1" vid="AMO 9:11">Enqeshsha isixxa qammalchannon,</para>
  <para style="q2" vid="AMO 9:11">diigemeeka haaronsanno,</para>
  <para style="q2" vid="AMO 9:11">qara hedhemmashshanni, assennexxi ijaarannoni.<verse eid="AMO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12" />Tennexxee Eedoomike bogi giddo gatemaka arda,</para>
  <para style="q2" vid="AMO 9:12">summi ankinni ye'emeeka arda duuchcha dhaalaan,»</para>
  <para style="q2" vid="AMO 9:12">hiyya'neen tenne assaaki Duuchchi Woddiki Gootti.<note caller="-" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="ACT 15:16-18">Erga. Huj. 15:16-18</ref>. </char></note><verse eid="AMO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13" />Duuchchi Woddiki Gootti hiyya'nee qici:</para>
  <para style="q1" vid="AMO 9:13">«Kunnise midha ha'mammak manni haa'me birebaangi,</para>
  <para style="q2" vid="AMO 9:13">wiisallichchi keekkatebang dhaqabbaan,</para>
  <para style="q2" vid="AMO 9:13">golqo kaasammakinna kaalse birebaang,</para>
  <para style="q2" vid="AMO 9:13">woyinetixxa gumma miicammakiri dhaqqabbaaxxi barra daggaan.</para>
  <para style="q1" vid="AMO 9:13">Haaroxxe woyinki bulbul koobuwwatenaa'ni coccobbaan</para>
  <para style="q2" vid="AMO 9:13">tulluchchuwwa duuchchanaa'ni dunemaan.<verse eid="AMO 9:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="AMO 9:14" />Shorremeeka arda anka Isira'eeli</para>
  <para style="q2" vid="AMO 9:14">wirri asse bogi inisa'nekibaa iyyedaganon.</para>
  <para style="q1" vid="AMO 9:14">Insa'nenna diigememmaka qachchuwwa qammalchine ookkoo he'naani;</para>
  <para style="q2" vid="AMO 9:14">woyine karsineexxi woyinetika bulibulonna ha'winaan;</para>
  <para style="q2" vid="AMO 9:14">gargari hedheeka hiddichchuwwa kaarsneexxi gumma indaan.<verse eid="AMO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15" />Isra'eelika arda insa'negge boga'ni kaasannon;</para>
  <para style="q2" vid="AMO 9:15">insa'ne'aa uwwennake boganaa'ni langaxxa</para>
  <para style="q2" vid="AMO 9:15">goshemme me'inabaan,»</para>
  <para style="b" vid="AMO 9:15" />
  <para style="q4" vid="AMO 9:15">hiyya'nen Duuchchi Woddik Gootti Mageni.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>