<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Gedeo Bible</book>
  <para style="h">Abidiyyukaa Raaga</para>
  <para style="toc1">Abidiyyukaa Raaga</para>
  <para style="toc2">Abidiyyukaa Raaga</para>
  <para style="toc3">Abi.</para>
  <para style="mt1">Abidiyyukaa Raaga</para>
  <para style="imt">E'yichchoo</para>
  <para style="ip">Kunni harumaaki Maxaafi borreessemeek Iyyeerusaalemik Qachchi Kiristoossixxe ileensha edo 586 wogga'ni diigemee uduma tennete hiyyendeexxi egenabaaxxe yanna'nitemman. Eetteene yanna'ni bita'ixxe boro gamii'ni gatteexxi qeerraxxe yanna'a naaphake kade'e tureemmaki Edoomiki ardi Iyyeerusaalemiki iikki qachchi diigemmeexxa eeyyatinna booji'o gamisati ookkone qachchi giddixxa karra saamma'neman. Abidiyyu, Edoomik ardinna wele Isira'eelika naapha Mageni mufeti ganaaxxa raaga raage.</para>
  <para style="iot">Konne Maxaafi Giddo Hexxeexxa Yaanuwwa</para>
  <para style="io1">Edoomiyaasike ardixxa holla Mageni mufeti ganee qico <char style="ior"><ref loc="OBA 1:1-9">1-9</ref> </char></para>
  <para style="io1">Edoomiyasike ardixxa mararte gophaa <char style="ior"><ref loc="OBA 1:10-14">10-14</ref> </char></para>
  <para style="io1">Isira'eelike ardixxa middite adhdha <char style="ior"><ref loc="OBA 1:15-21">15-21</ref> </char></para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="s1">Edoomiyasike Arda'ni uwwendeexxa murte</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />Dada Duuchchiki Duuchchi Woddik Gootti Eedoomixxee hiyya'nee qici:</para>
  <para style="b" vid="OBA 1:1" />
  <para style="p" vid="OBA 1:1">Duuchchi Woddike Goottanaa'n erga lanqennen;</para>
  <para style="q1" vid="OBA 1:1">Erganjikinna gosa gosake ardibaa ergemee</para>
  <para style="q2" vid="OBA 1:1">hiyya'nee qici:</para>
  <para style="q1" vid="OBA 1:1">«Ke'we; isee lollonaa fullo.»<verse eid="OBA 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />«Kunnise ani atee'e gosa gosake ardi giddo horoondaboxxoshsha assannon;</para>
  <para style="q2" vid="OBA 1:2">haratanga ati tuffatendeetke kaddaton.<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />Ati baqaqa kinoti giddo</para>
  <para style="q2" vid="OBA 1:3">hexxaateke,</para>
  <para style="q2" vid="OBA 1:3">galduma atikanna xungoti iima assexxeeteke,</para>
  <para style="q1" vid="OBA 1:3">Ati ifi'aani qalbe giddo,</para>
  <para style="q2" vid="OBA 1:3">‹Ate anee butti'a dirrisa dande'aaki?› hitaateke</para>
  <para style="q2" vid="OBA 1:3">atixxe qalbexxi ifiduka atee sobbe'een.<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />Sinbiriinsha keelik iim'a kexxootole,</para>
  <para style="q2" vid="OBA 1:4">urjuwwati giddonna galduma atika assexxootole,</para>
  <para style="q2" vid="OBA 1:4">ookko'ninni ani atee butti'a dirrisannon,»</para>
  <para style="q4" vid="OBA 1:4">hiyya'neen Duuchchi Woddik Gootti.<verse eid="OBA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />«Moodha'lishshe atibaa daggeele,</para>
  <para style="q2" vid="OBA 1:5">mulqedhaak manni hashsha e'yeele,</para>
  <para style="q1" vid="OBA 1:5">Mooraak insa'ne geyaa qico callabaataa?</para>
  <para style="q2" vid="OBA 1:5">Woyinetixxa gumma qocedhaakir atiba dageele,</para>
  <para style="q1" vid="OBA 1:5">Feshshi'linaachcho gatisabaa hiyyotee?</para>
  <para style="q2" vid="OBA 1:5">Atee kinni hitta hexxeexxe ba'ne heqqita'netaa!<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />Yaane kinni Eesaawu hittaa mulqemee?</para>
  <para style="q2" vid="OBA 1:6">Isi sho'eemmaxxi karranna hittatata mulqende.<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />Jaaluwwi atik duuchchi gabalatiba'a ate dhiibaan,</para>
  <para style="q2" vid="OBA 1:7">hariyya atixxiirinna atee sonbaan; ate'ni hunna hortaan;</para>
  <para style="q1" vid="OBA 1:7">Qore atixxenaa'n iteekirinna fonxoro ati'a fayaan;</para>
  <para style="q2" vid="OBA 1:7">ati kinni tenne egendeboxxon.<verse eid="OBA 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />«Eettenne barra» hiyya'neeni Duuchchi Woddik Gootti,</para>
  <para style="q2" vid="OBA 1:8">«Eedoomike boganaa'n beekkoole,</para>
  <para style="q2" vid="OBA 1:8">Eesaawuxxe koobanaa'ni qalbeeffachcho afeeka manna balleessanon.<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />Tee Temaani atik loliink manni duuchchi culphisaan;</para>
  <para style="q2" vid="OBA 1:9">Eesaawuxxe kooba'n hedhaak duuchchinna,</para>
  <para style="q2" vid="OBA 1:9">shiyemee ba'aan.<verse eid="OBA 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />Dayyo atike Ya'iqoobi'n assitetaxxe xaqaroxxee,</para>
  <para style="q2" vid="OBA 1:10">shookee shooko oddo'witatton;</para>
  <para style="q2" vid="OBA 1:10">duuchchi woddi'anna ati baxxatton.<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />Alagi karra atixxa gudhdhe me'aa wodda,</para>
  <para style="q2" vid="OBA 1:11">annafee bogik manni atixxe hulanaa'n e'yeexxi,</para>
  <para style="q1" vid="OBA 1:11">Iyyerusaalemi'n hixa iblsaa wodda,</para>
  <para style="q2" vid="OBA 1:11">eettene barra ati bayyatee uuritee uudeten;</para>
  <para style="q2" vid="OBA 1:11">atinna insa'nenaa'n mittekemman.<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />Fuggoxxi iso'ni daggeexxa barra,</para>
  <para style="q2" vid="OBA 1:12">atike dayyixxe wixixxii'ni silaati gammadatabaan;</para>
  <para style="q1" vid="OBA 1:12">Ba'ne insa'ne'ni geltee'naa Yihudake ardi yaadaa wodda,</para>
  <para style="q2" vid="OBA 1:12">silaati ililisatabaan,</para>
  <para style="q1" vid="OBA 1:12">Insa'ne wixixxi hineexxa barranna,</para>
  <para style="q2" vid="OBA 1:12">hollati ifi dukke haasottaabaan.<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />Insa'nexxe ba'nexxa barra,</para>
  <para style="q2" vid="OBA 1:13">anke ardixxa hula silaati e'yitatabaan;</para>
  <para style="q1" vid="OBA 1:13">Ba'ne insa'ne'ni gelteexxa barra,</para>
  <para style="q2" vid="OBA 1:13">wixixxi hiyya insa'nexxe'ni silaa gammadattabaan;</para>
  <para style="q1" vid="OBA 1:13">Insa'neexxe ba'nexxe barra'ni,</para>
  <para style="q2" vid="OBA 1:13">silaati karra insa'nexxa saandatabaan.<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />Insa'neka baajammakaara shiyaatee</para>
  <para style="q2" vid="OBA 1:14">weldeenate'n silaati heqqitatabaan;</para>
  <para style="q1" vid="OBA 1:14">Insa'nexxe wixixxiitixxe barra'ni</para>
  <para style="q2" vid="OBA 1:14">hafe gateemmakaara silaati sa'issite uutatabaan.<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">Isa. 34:5-17</ref>; <ref loc="ISA 63:1-6">63:1-6</ref>; <ref loc="JER 49:7-22">Erm. 49:7-22</ref>; <ref loc="EZK 25:12-14">Hiz. 25:12-14</ref>; <ref loc="EZK 35:1-15">35:1-15</ref>; <ref loc="AMO 1:11-12">Amo. 1:11-12</ref>; <ref loc="MAL 1:2-5">Mil. 1:2-5</ref>. </char></note><verse eid="OBA 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />«Gosa gosake arda duuchcha'n</para>
  <para style="q2" vid="OBA 1:15">Duuchchi Woddike Goottixxi barra gelte'een</para>
  <para style="q1" vid="OBA 1:15">Ati assiteeteshshanni ate'ninna iitanni assendaan;</para>
  <para style="q2" vid="OBA 1:15">fuggoxxi huje atixxi umo atinge'ni higgaan.<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />Ha'no anxe woyyitte kooba hana rakko ha'witineemmashshanni,</para>
  <para style="q2" vid="OBA 1:16">gosa gosak ardi duuchchinna duuchchi wodda saxxeexxa rakko ha'waan;</para>
  <para style="q1" vid="OBA 1:16">Insa'ne ha'winee, tuchchiinsaan;</para>
  <para style="q2" vid="OBA 1:16">konne edo kande egenebaa qiconna kandee mundaan.<verse eid="OBA 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />Yaane kinni Tsiyoonixxe kooba'n leexxa fula kaddaan;</para>
  <para style="q2" vid="OBA 1:17">Ya'iqoobik ardi isi woyyichchake kadaan;</para>
  <para style="q2" vid="OBA 1:17">qadaada insa'nekanna dhalaan.<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />Ya'iqoobik ardi giira,</para>
  <para style="q2" vid="OBA 1:18">Yoosefik ardinna bubenjoke kadaan;</para>
  <para style="q1" vid="OBA 1:18">Eesaawuk ardi huurake kadaan;</para>
  <para style="q1" vid="OBA 1:18">Insa'nenna isoo gunbaan; isoo indaan;</para>
  <para style="q2" vid="OBA 1:18">Eesawuke ardinaa'n ayyinnna gataak hedhebaan.»</para>
  <para style="q2" vid="OBA 1:18">Tenne haaso'eki Duuchchi Woddik Goottan.<verse eid="OBA 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />Bita'ik ardi,</para>
  <para style="q2" vid="OBA 1:19">Eesaawuxxa kooba abixaan;</para>
  <para style="q1" vid="OBA 1:19">Eettene kooba hunda hedheek manninna,</para>
  <para style="q2" vid="OBA 1:19">Filisixeemike ardika boga dhaalaan;</para>
  <para style="q1" vid="OBA 1:19">Efireemike mannikanna Semaariyake mannika fichcha abixxinaan;</para>
  <para style="q2" vid="OBA 1:19">Biniyaaminna Gele'adika boga dhaalaan.<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />Kenaanike boga'n booji'ende hexxeexxi tinni Isira'eelixxi gamo,</para>
  <para style="q2" vid="OBA 1:20">Seraaphita qico'ni hedheeka boga dhaaldaan;</para>
  <para style="q1" vid="OBA 1:20">Seeferadimi giddo hedheek booji'emeek Iyyerusaalemik ardinna,</para>
  <para style="q2" vid="OBA 1:20">Bita'ika qachchuwwa dhaalaan.<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />Eesaawuxxa koobuwwa galchatee,</para>
  <para style="q2" vid="OBA 1:21">anjiralluwwi Tsiyoonixxe koobabaa qabataan;</para>
  <para style="q2" vid="OBA 1:21">mootumma iittinna Duuchchi Woddike Goottixxe kaddaan.<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>