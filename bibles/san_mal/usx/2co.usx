<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="2CO" style="id">Sanskrit Bible (NT) in Malayalam Script (സത്യവേദഃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">2 Corinthians</para>
  <para style="toc1">2 കരിന്ഥിനഃ പത്രം</para>
  <para style="toc2">2 കരിന്ഥിനഃ</para>
  <para style="toc3">2 കരിന്ഥിനഃ</para>
  <para style="mt1">2 കരിന്ഥിനഃ പത്രം</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഈശ്വരസ്യേച്ഛയാ യീശുഖ്രീഷ്ടസ്യ പ്രേരിതഃ പൗലസ്തിമഥിർഭ്രാതാ ച ദ്വാവേതൗ കരിന്ഥനഗരസ്ഥായൈ ഈശ്വരീയസമിതയ ആഖായാദേശസ്ഥേഭ്യഃ സർവ്വേഭ്യഃ പവിത്രലോകേഭ്യശ്ച പത്രം ലിഖതഃ|</para>
  <para style="p">
    <verse number="2" style="v"/>അസ്മാകം താതസ്യേശ്വരസ്യ പ്രഭോര്യീശുഖ്രീഷ്ടസ്യ ചാനുഗ്രഹഃ ശാന്തിശ്ച യുഷ്മാസു വർത്തതാം|</para>
  <para style="p">
    <verse number="3" style="v"/>കൃപാലുഃ പിതാ സർവ്വസാന്ത്വനാകാരീശ്വരശ്ച യോഽസ്മത്പ്രഭോര്യീശുഖ്രീഷ്ടസ്യ താത ഈശ്വരഃ സ ധന്യോ ഭവതു|</para>
  <para style="p">
    <verse number="4" style="v"/>യതോ വയമ് ഈശ്വരാത് സാന്ത്വനാം പ്രാപ്യ തയാ സാന്ത്വനയാ യത് സർവ്വവിധക്ലിഷ്ടാൻ ലോകാൻ സാന്ത്വയിതും ശക്നുയാമ തദർഥം സോഽസ്മാകം സർവ്വക്ലേശസമയേഽസ്മാൻ സാന്ത്വയതി|</para>
  <para style="p">
    <verse number="5" style="v"/>യതഃ ഖ്രീഷ്ടസ്യ ക്ലേശാ യദ്വദ് ബാഹുല്യേനാസ്മാസു വർത്തന്തേ തദ്വദ് വയം ഖ്രീഷ്ടേന ബഹുസാന്ത്വനാഢ്യാ അപി ഭവാമഃ|</para>
  <para style="p">
    <verse number="6" style="v"/>വയം യദി ക്ലിശ്യാമഹേ തർഹി യുഷ്മാകം സാന്ത്വനാപരിത്രാണയോഃ കൃതേ ക്ലിശ്യാമഹേ യതോഽസ്മാഭി ര്യാദൃശാനി ദുഃഖാനി സഹ്യന്തേ യുഷ്മാകം താദൃശദുഃഖാനാം സഹനേന തൗ സാധയിഷ്യേതേ ഇത്യസ്മിൻ യുഷ്മാനധി മമ ദൃഢാ പ്രത്യാശാ ഭവതി|</para>
  <para style="p">
    <verse number="7" style="v"/>യദി വാ വയം സാന്ത്വനാം ലഭാമഹേ തർഹി യുഷ്മാകം സാന്ത്വനാപരിത്രാണയോഃ കൃതേ താമപി ലഭാമഹേ| യതോ യൂയം യാദൃഗ് ദുഃഖാനാം ഭാഗിനോഽഭവത താദൃക് സാന്ത്വനായാ അപി ഭാഗിനോ ഭവിഷ്യഥേതി വയം ജാനീമഃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ഹേ ഭ്രാതരഃ, ആശിയാദേശേ യഃ ക്ലേശോഽസ്മാൻ ആക്രാമ്യത് തം യൂയം യദ് അനവഗതാസ്തിഷ്ഠത തന്മയാ ഭദ്രം ന മന്യതേ| തേനാതിശക്തിക്ലേശേന വയമതീവ പീഡിതാസ്തസ്മാത് ജീവനരക്ഷണേ നിരുപായാ ജാതാശ്ച,</para>
  <para style="p">
    <verse number="9" style="v"/>അതോ വയം സ്വേഷു ന വിശ്വസ്യ മൃതലോകാനാമ് ഉത്ഥാപയിതരീശ്വരേ യദ് വിശ്വാസം കുർമ്മസ്തദർഥമ് അസ്മാഭിഃ പ്രാണദണ്ഡോ ഭോക്തവ്യ ഇതി സ്വമനസി നിശ്ചിതം|</para>
  <para style="p">
    <verse number="10" style="v"/>ഏതാദൃശഭയങ്കരാത് മൃത്യോ ര്യോ ഽസ്മാൻ അത്രായതേദാനീമപി ത്രായതേ സ ഇതഃ പരമപ്യസ്മാൻ ത്രാസ്യതേ ഽസ്മാകമ് ഏതാദൃശീ പ്രത്യാശാ വിദ്യതേ|</para>
  <para style="p">
    <verse number="11" style="v"/>ഏതദർഥമസ്മത്കൃതേ പ്രാർഥനയാ വയം യുഷ്മാഭിരുപകർത്തവ്യാസ്തഥാ കൃതേ ബഹുഭി ര്യാചിതോ യോഽനുഗ്രഹോഽസ്മാസു വർത്തിഷ്യതേ തത്കൃതേ ബഹുഭിരീശ്വരസ്യ ധന്യവാദോഽപി കാരിഷ്യതേ|</para>
  <para style="p">
    <verse number="12" style="v"/>അപരഞ്ച സംസാരമധ്യേ വിശേഷതോ യുഷ്മന്മധ്യേ വയം സാംസാരിക്യാ ധിയാ നഹി കിന്ത്വീശ്വരസ്യാനുഗ്രഹേണാകുടിലതാമ് ഈശ്വരീയസാരല്യഞ്ചാചരിതവന്തോഽത്രാസ്മാകം മനോ യത് പ്രമാണം ദദാതി തേന വയം ശ്ലാഘാമഹേ|</para>
  <para style="p">
    <verse number="13" style="v"/>യുഷ്മാഭി ര്യദ് യത് പഠ്യതേ ഗൃഹ്യതേ ച തദന്യത് കിമപി യുഷ്മഭ്യമ് അസ്മാഭി ർന ലിഖ്യതേ തച്ചാന്തം യാവദ് യുഷ്മാഭി ർഗ്രഹീഷ്യത ഇത്യസ്മാകമ് ആശാ|</para>
  <para style="p">
    <verse number="14" style="v"/>യൂയമിതഃ പൂർവ്വമപ്യസ്മാൻ അംശതോ ഗൃഹീതവന്തഃ, യതഃ പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യ ദിനേ യദ്വദ് യുഷ്മാസ്വസ്മാകം ശ്ലാഘാ തദ്വദ് അസ്മാസു യുഷ്മാകമപി ശ്ലാഘാ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="15" style="v"/>അപരം യൂയം യദ് ദ്വിതീയം വരം ലഭധ്വേ തദർഥമിതഃ പൂർവ്വം തയാ പ്രത്യാശയാ യുഷ്മത്സമീപം ഗമിഷ്യാമി</para>
  <para style="p">
    <verse number="16" style="v"/>യുഷ്മദ്ദേശേന മാകിദനിയാദേശം വ്രജിത്വാ പുനസ്തസ്മാത് മാകിദനിയാദേശാത് യുഷ്മത്സമീപമ് ഏത്യ യുഷ്മാഭി ര്യിഹൂദാദേശം പ്രേഷയിഷ്യേ ചേതി മമ വാഞ്ഛാസീത്|</para>
  <para style="p">
    <verse number="17" style="v"/>ഏതാദൃശീ മന്ത്രണാ മയാ കിം ചാഞ്ചല്യേന കൃതാ? യദ് യദ് അഹം മന്ത്രയേ തത് കിം വിഷയിലോകഇവ മന്ത്രയാണ ആദൗ സ്വീകൃത്യ പശ്ചാദ് അസ്വീകുർവ്വേ?</para>
  <para style="p">
    <verse number="18" style="v"/>യുഷ്മാൻ പ്രതി മയാ കഥിതാനി വാക്യാന്യഗ്രേ സ്വീകൃതാനി ശേഷേഽസ്വീകൃതാനി നാഭവൻ ഏതേനേശ്വരസ്യ വിശ്വസ്തതാ പ്രകാശതേ|</para>
  <para style="p">
    <verse number="19" style="v"/>മയാ സില്വാനേന തിമഥിനാ ചേശ്വരസ്യ പുത്രോ യോ യീശുഖ്രീഷ്ടോ യുഷ്മന്മധ്യേ ഘോഷിതഃ സ തേന സ്വീകൃതഃ പുനരസ്വീകൃതശ്ച തന്നഹി കിന്തു സ തസ്യ സ്വീകാരസ്വരൂപഏവ|</para>
  <para style="p">
    <verse number="20" style="v"/>ഈശ്വരസ്യ മഹിമാ യദ് അസ്മാഭിഃ പ്രകാശേത തദർഥമ് ഈശ്വരേണ യദ് യത് പ്രതിജ്ഞാതം തത്സർവ്വം ഖ്രീഷ്ടേന സ്വീകൃതം സത്യീഭൂതഞ്ച|</para>
  <para style="p">
    <verse number="21" style="v"/>യുഷ്മാൻ അസ്മാംശ്ചാഭിഷിച്യ യഃ ഖ്രീഷ്ടേ സ്ഥാസ്നൂൻ കരോതി സ ഈശ്വര ഏവ|</para>
  <para style="p">
    <verse number="22" style="v"/>സ ചാസ്മാൻ മുദ്രാങ്കിതാൻ അകാർഷീത് സത്യാങ്കാരസ്യ പണഖരൂപമ് ആത്മാനം അസ്മാകമ് അന്തഃകരണേഷു നിരക്ഷിപച്ച|</para>
  <para style="p">
    <verse number="23" style="v"/>അപരം യുഷ്മാസു കരുണാം കുർവ്വൻ അഹമ് ഏതാവത്കാലം യാവത് കരിന്ഥനഗരം ന ഗതവാൻ ഇതി സത്യമേതസ്മിൻ ഈശ്വരം സാക്ഷിണം കൃത്വാ മയാ സ്വപ്രാണാനാം ശപഥഃ ക്രിയതേ|</para>
  <para style="p">
    <verse number="24" style="v"/>വയം യുഷ്മാകം വിശ്വാസസ്യ നിയന്താരോ ന ഭവാമഃ കിന്തു യുഷ്മാകമ് ആനന്ദസ്യ സഹായാ ഭവാമഃ, യസ്മാദ് വിശ്വാസേ യുഷ്മാകം സ്ഥിതി ർഭവതി|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അപരഞ്ചാഹം പുനഃ ശോകായ യുഷ്മത്സന്നിധിം ന ഗമിഷ്യാമീതി മനസി നിരചൈഷം|</para>
  <para style="p">
    <verse number="2" style="v"/>യസ്മാദ് അഹം യദി യുഷ്മാൻ ശോകയുക്താൻ കരോമി തർഹി മയാ യഃ ശോകയുക്തീകൃതസ്തം വിനാ കേനാപരേണാഹം ഹർഷയിഷ്യേ?</para>
  <para style="p">
    <verse number="3" style="v"/>മമ യോ ഹർഷഃ സ യുഷ്മാകം സർവ്വേഷാം ഹർഷ ഏവേതി നിശ്ചിതം മയാബോധി; അതഏവ യൈരഹം ഹർഷയിതവ്യസ്തൈ ർമദുപസ്ഥിതിസമയേ യന്മമ ശോകോ ന ജായേത തദർഥമേവ യുഷ്മഭ്യമ് ഏതാദൃശം പത്രം മയാ ലിഖിതം|</para>
  <para style="p">
    <verse number="4" style="v"/>വസ്തുതസ്തു ബഹുക്ലേശസ്യ മനഃപീഡായാശ്ച സമയേഽഹം ബഹ്വശ്രുപാതേന പത്രമേകം ലിഖിതവാൻ യുഷ്മാകം ശോകാർഥം തന്നഹി കിന്തു യുഷ്മാസു മദീയപ്രേമബാഹുല്യസ്യ ജ്ഞാപനാർഥം|</para>
  <para style="p">
    <verse number="5" style="v"/>യേനാഹം ശോകയുക്തീകൃതസ്തേന കേവലമഹം ശോകയുക്തീകൃതസ്തന്നഹി കിന്ത്വംശതോ യൂയം സർവ്വേഽപി യതോഽഹമത്ര കസ്മിംശ്ചിദ് ദോഷമാരോപയിതും നേച്ഛാമി|</para>
  <para style="p">
    <verse number="6" style="v"/>ബഹൂനാം യത് തർജ്ജനം തേന ജനേനാലമ്ഭി തത് തദർഥം പ്രചുരം|</para>
  <para style="p">
    <verse number="7" style="v"/>അതഃ സ ദുഃഖസാഗരേ യന്ന നിമജ്ജതി തദർഥം യുഷ്മാഭിഃ സ ക്ഷന്തവ്യഃ സാന്ത്വയിതവ്യശ്ച|</para>
  <para style="p">
    <verse number="8" style="v"/>ഇതി ഹേതോഃ പ്രർഥയേഽഹം യുഷ്മാഭിസ്തസ്മിൻ ദയാ ക്രിയതാം|</para>
  <para style="p">
    <verse number="9" style="v"/>യൂയം സർവ്വകർമ്മണി മമാദേശം ഗൃഹ്ലീഥ ന വേതി പരീക്ഷിതുമ് അഹം യുഷ്മാൻ പ്രതി ലിഖിതവാൻ|</para>
  <para style="p">
    <verse number="10" style="v"/>യസ്യ യോ ദോഷോ യുഷ്മാഭിഃ ക്ഷമ്യതേ തസ്യ സ ദോഷോ മയാപി ക്ഷമ്യതേ യശ്ച ദോഷോ മയാ ക്ഷമ്യതേ സ യുഷ്മാകം കൃതേ ഖ്രീഷ്ടസ്യ സാക്ഷാത് ക്ഷമ്യതേ|</para>
  <para style="p">
    <verse number="11" style="v"/>ശയതാനഃ കൽപനാസ്മാഭിരജ്ഞാതാ നഹി, അതോ വയം യത് തേന ന വഞ്ച്യാമഹേ തദർഥമ് അസ്മാഭിഃ സാവധാനൈ ർഭവിതവ്യം|</para>
  <para style="p">
    <verse number="12" style="v"/>അപരഞ്ച ഖ്രീഷ്ടസ്യ സുസംവാദഘോഷണാർഥം മയി ത്രോയാനഗരമാഗതേ പ്രഭോഃ കർമ്മണേ ച മദർഥം ദ്വാരേ മുക്തേ</para>
  <para style="p">
    <verse number="13" style="v"/>സത്യപി സ്വഭ്രാതുസ്തീതസ്യാവിദ്യമാനത്വാത് മദീയാത്മനഃ കാപി ശാന്തി ർന ബഭൂവ, തസ്മാദ് അഹം താൻ വിസർജ്ജനം യാചിത്വാ മാകിദനിയാദേശം ഗന്തും പ്രസ്ഥാനമ് അകരവം|</para>
  <para style="p">
    <verse number="14" style="v"/>യ ഈശ്വരഃ സർവ്വദാ ഖ്രീഷ്ടേനാസ്മാൻ ജയിനഃ കരോതി സർവ്വത്ര ചാസ്മാഭിസ്തദീയജ്ഞാനസ്യ ഗന്ധം പ്രകാശയതി സ ധന്യഃ|</para>
  <para style="p">
    <verse number="15" style="v"/>യസ്മാദ് യേ ത്രാണം ലപ്സ്യന്തേ യേ ച വിനാശം ഗമിഷ്യന്തി താൻ പ്രതി വയമ് ഈശ്വരേണ ഖ്രീഷ്ടസ്യ സൗഗന്ധ്യം ഭവാമഃ|</para>
  <para style="p">
    <verse number="16" style="v"/>വയമ് ഏകേഷാം മൃത്യവേ മൃത്യുഗന്ധാ അപരേഷാഞ്ച ജീവനായ ജീവനഗന്ധാ ഭവാമഃ, കിന്ത്വേതാദൃശകർമ്മസാധനേ കഃ സമർഥോഽസ്തി?</para>
  <para style="p">
    <verse number="17" style="v"/>അന്യേ ബഹവോ ലോകാ യദ്വദ് ഈശ്വരസ്യ വാക്യം മൃഷാശിക്ഷയാ മിശ്രയന്തി വയം തദ്വത് തന്ന മിശ്രയന്തഃ സരലഭാവേനേശ്വരസ്യ സാക്ഷാദ് ഈശ്വരസ്യാദേശാത് ഖ്രീഷ്ടേന കഥാം ഭാഷാമഹേ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>വയം കിമ് ആത്മപ്രശംസനം പുനരാരഭാമഹേ? യുഷ്മാൻ പ്രതി യുഷ്മത്തോ വാ പരേഷാം കേഷാഞ്ചിദ് ഇവാസ്മാകമപി കിം പ്രശംസാപത്രേഷു പ്രയോജനമ് ആസ്തേ?</para>
  <para style="p">
    <verse number="2" style="v"/>യൂയമേവാസ്മാകം പ്രശംസാപത്രം തച്ചാസ്മാകമ് അന്തഃകരണേഷു ലിഖിതം സർവ്വമാനവൈശ്ച ജ്ഞേയം പഠനീയഞ്ച|</para>
  <para style="p">
    <verse number="3" style="v"/>യതോ ഽസ്മാഭിഃ സേവിതം ഖ്രീഷ്ടസ്യ പത്രം യൂയപേവ, തച്ച ന മസ്യാ കിന്ത്വമരസ്യേശ്വരസ്യാത്മനാ ലിഖിതം പാഷാണപത്രേഷു തന്നഹി കിന്തു ക്രവ്യമയേഷു ഹൃത്പത്രേഷു ലിഖിതമിതി സുസ്പഷ്ടം|</para>
  <para style="p">
    <verse number="4" style="v"/>ഖ്രീഷ്ടേനേശ്വരം പ്രത്യസ്മാകമ് ഈദൃശോ ദൃഢവിശ്വാസോ വിദ്യതേ;</para>
  <para style="p">
    <verse number="5" style="v"/>വയം നിജഗുണേന കിമപി കൽപയിതും സമർഥാ ഇതി നഹി കിന്ത്വീശ്വരാദസ്മാകം സാമർഥ്യം ജായതേ|</para>
  <para style="p">
    <verse number="6" style="v"/>തേന വയം നൂതനനിയമസ്യാർഥതോ ഽക്ഷരസംസ്ഥാനസ്യ തന്നഹി കിന്ത്വാത്മന ഏവ സേവനസാമർഥ്യം പ്രാപ്താഃ| അക്ഷരസംസ്ഥാനം മൃത്യുജനകം കിന്ത്വാത്മാ ജീവനദായകഃ|</para>
  <para style="p">
    <verse number="7" style="v"/>അക്ഷരൈ ർവിലിഖിതപാഷാണരൂപിണീ യാ മൃത്യോഃ സേവാ സാ യദീദൃക് തേജസ്വിനീ ജാതാ യത്തസ്യാചിരസ്ഥായിനസ്തേജസഃ കാരണാത് മൂസസോ മുഖമ് ഇസ്രായേലീയലോകൈഃ സംദ്രഷ്ടും നാശക്യത,</para>
  <para style="p">
    <verse number="8" style="v"/>തർഹ്യാത്മനഃ സേവാ കിം തതോഽപി ബഹുതേജസ്വിനീ ന ഭവേത്?</para>
  <para style="p">
    <verse number="9" style="v"/>ദണ്ഡജനികാ സേവാ യദി തേജോയുക്താ ഭവേത് തർഹി പുണ്യജനികാ സേവാ തതോഽധികം ബഹുതേജോയുക്താ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="10" style="v"/>ഉഭയോസ്തുലനായാം കൃതായാമ് ഏകസ്യാസ്തേജോ ദ്വിതീയായാഃ പ്രഖരതരേണ തേജസാ ഹീനതേജോ ഭവതി|</para>
  <para style="p">
    <verse number="11" style="v"/>യസ്മാദ് യത് ലോപനീയം തദ് യദി തേജോയുക്തം ഭവേത് തർഹി യത് ചിരസ്ഥായി തദ് ബഹുതരതേജോയുക്തമേവ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="12" style="v"/>ഈദൃശീം പ്രത്യാശാം ലബ്ധ്വാ വയം മഹതീം പ്രഗൽഭതാം പ്രകാശയാമഃ|</para>
  <para style="p">
    <verse number="13" style="v"/>ഇസ്രായേലീയലോകാ യത് തസ്യ ലോപനീയസ്യ തേജസഃ ശേഷം ന വിലോകയേയുസ്തദർഥം മൂസാ യാദൃഗ് ആവരണേന സ്വമുഖമ് ആച്ഛാദയത് വയം താദൃക് ന കുർമ്മഃ|</para>
  <para style="p">
    <verse number="14" style="v"/>തേഷാം മനാംസി കഠിനീഭൂതാനി യതസ്തേഷാം പഠനസമയേ സ പുരാതനോ നിയമസ്തേനാവരണേനാദ്യാപി പ്രച്ഛന്നസ്തിഷ്ഠതി|</para>
  <para style="p">
    <verse number="15" style="v"/>തച്ച ന ദൂരീഭവതി യതഃ ഖ്രീഷ്ടേനൈവ തത് ലുപ്യതേ| മൂസസഃ ശാസ്ത്രസ്യ പാഠസമയേഽദ്യാപി തേഷാം മനാംസി തേനാവരണേന പ്രച്ഛാദ്യന്തേ|</para>
  <para style="p">
    <verse number="16" style="v"/>കിന്തു പ്രഭും പ്രതി മനസി പരാവൃത്തേ തദ് ആവരണം ദൂരീകാരിഷ്യതേ|</para>
  <para style="p">
    <verse number="17" style="v"/>യഃ പ്രഭുഃ സ ഏവ സ ആത്മാ യത്ര ച പ്രഭോരാത്മാ തത്രൈവ മുക്തിഃ|</para>
  <para style="p">
    <verse number="18" style="v"/>വയഞ്ച സർവ്വേഽനാച്ഛാദിതേനാസ്യേന പ്രഭോസ്തേജസഃ പ്രതിബിമ്ബം ഗൃഹ്ലന്ത ആത്മസ്വരൂപേണ പ്രഭുനാ രൂപാന്തരീകൃതാ വർദ്ധമാനതേജോയുക്താം താമേവ പ്രതിമൂർത്തിം പ്രാപ്നുമഃ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അപരഞ്ച വയം കരുണാഭാജോ ഭൂത്വാ യദ് ഏതത് പരിചാരകപദമ് അലഭാമഹി നാത്ര ക്ലാമ്യാമഃ,</para>
  <para style="p">
    <verse number="2" style="v"/>കിന്തു ത്രപായുക്താനി പ്രച്ഛന്നകർമ്മാണി വിഹായ കുടിലതാചരണമകുർവ്വന്ത ഈശ്വരീയവാക്യം മിഥ്യാവാക്യൈരമിശ്രയന്തഃ സത്യധർമ്മസ്യ പ്രകാശനേനേശ്വരസ്യ സാക്ഷാത് സർവ്വമാനവാനാം സംവേദഗോചരേ സ്വാൻ പ്രശംസനീയാൻ ദർശയാമഃ|</para>
  <para style="p">
    <verse number="3" style="v"/>അസ്മാഭി ർഘോഷിതഃ സുസംവാദോ യദി പ്രച്ഛന്നഃ; സ്യാത് തർഹി യേ വിനംക്ഷ്യന്തി തേഷാമേവ ദൃഷ്ടിതഃ സ പ്രച്ഛന്നഃ;</para>
  <para style="p">
    <verse number="4" style="v"/>യത ഈശ്വരസ്യ പ്രതിമൂർത്തി ര്യഃ ഖ്രീഷ്ടസ്തസ്യ തേജസഃ സുസംവാദസ്യ പ്രഭാ യത് താൻ ന ദീപയേത് തദർഥമ് ഇഹ ലോകസ്യ ദേവോഽവിശ്വാസിനാം ജ്ഞാനനയനമ് അന്ധീകൃതവാൻ ഏതസ്യോദാഹരണം തേ ഭവന്തി|</para>
  <para style="p">
    <verse number="5" style="v"/>വയം സ്വാൻ ഘോഷയാമ ഇതി നഹി കിന്തു ഖ്രീഷ്ടം യീശും പ്രഭുമേവാസ്മാംശ്ച യീശോഃ കൃതേ യുഷ്മാകം പരിചാരകാൻ ഘോഷയാമഃ|</para>
  <para style="p">
    <verse number="6" style="v"/>യ ഈശ്വരോ മധ്യേതിമിരം പ്രഭാം ദീപനായാദിശത് സ യീശുഖ്രീഷ്ടസ്യാസ്യ ഈശ്വരീയതേജസോ ജ്ഞാനപ്രഭായാ ഉദയാർഥമ് അസ്മാകമ് അന്തഃകരണേഷു ദീപിതവാൻ|</para>
  <para style="p">
    <verse number="7" style="v"/>അപരം തദ് ധനമ് അസ്മാഭി ർമൃണ്മയേഷു ഭാജനേഷു ധാര്യ്യതേ യതഃ സാദ്ഭുതാ ശക്തി ർനാസ്മാകം കിന്ത്വീശ്വരസ്യൈവേതി ജ്ഞാതവ്യം|</para>
  <para style="p">
    <verse number="8" style="v"/>വയം പദേ പദേ പീഡ്യാമഹേ കിന്തു നാവസീദാമഃ, വയം വ്യാകുലാഃ സന്തോഽപി നിരുപായാ ന ഭവാമഃ;</para>
  <para style="p">
    <verse number="9" style="v"/>വയം പ്രദ്രാവ്യമാനാ അപി ന ക്ലാമ്യാമഃ, നിപാതിതാ അപി ന വിനശ്യാമഃ|</para>
  <para style="p">
    <verse number="10" style="v"/>അസ്മാകം ശരീരേ ഖ്രീഷ്ടസ്യ ജീവനം യത് പ്രകാശേത തദർഥം തസ്മിൻ ശരീരേ യീശോ ർമരണമപി ധാരയാമഃ|</para>
  <para style="p">
    <verse number="11" style="v"/>യീശോ ർജീവനം യദ് അസ്മാകം മർത്ത്യദേഹേ പ്രകാശേത തദർഥം ജീവന്തോ വയം യീശോഃ കൃതേ നിത്യം മൃത്യൗ സമർപ്യാമഹേ|</para>
  <para style="p">
    <verse number="12" style="v"/>ഇത്ഥം വയം മൃത്യാക്രാന്താ യൂയഞ്ച ജീവനാക്രാന്താഃ|</para>
  <para style="p">
    <verse number="13" style="v"/>വിശ്വാസകാരണാദേവ സമഭാഷി മയാ വചഃ| ഇതി യഥാ ശാസ്ത്രേ ലിഖിതം തഥൈവാസ്മാഭിരപി വിശ്വാസജനകമ് ആത്മാനം പ്രാപ്യ വിശ്വാസഃ ക്രിയതേ തസ്മാച്ച വചാംസി ഭാഷ്യന്തേ|</para>
  <para style="p">
    <verse number="14" style="v"/>പ്രഭു ര്യീശു ര്യേനോത്ഥാപിതഃ സ യീശുനാസ്മാനപ്യുത്ഥാപയിഷ്യതി യുഷ്മാഭിഃ സാർദ്ധം സ്വസമീപ ഉപസ്ഥാപയിഷ്യതി ച, വയമ് ഏതത് ജാനീമഃ|</para>
  <para style="p">
    <verse number="15" style="v"/>അതഏവ യുഷ്മാകം ഹിതായ സർവ്വമേവ ഭവതി തസ്മാദ് ബഹൂനാം പ്രചുരാനുुഗ്രഹപ്രാപ്തേ ർബഹുലോകാനാം ധന്യവാദേനേശ്വരസ്യ മഹിമാ സമ്യക് പ്രകാശിഷ്യതേ|</para>
  <para style="p">
    <verse number="16" style="v"/>തതോ ഹേതോ ർവയം ന ക്ലാമ്യാമഃ കിന്തു ബാഹ്യപുരുഷോ യദ്യപി ക്ഷീയതേ തഥാപ്യാന്തരികഃ പുരുഷോ ദിനേ ദിനേ നൂതനായതേ|</para>
  <para style="p">
    <verse number="17" style="v"/>ക്ഷണമാത്രസ്ഥായി യദേതത് ലഘിഷ്ഠം ദുഃഖം തദ് അതിബാഹുല്യേനാസ്മാകമ് അനന്തകാലസ്ഥായി ഗരിഷ്ഠസുഖം സാധയതി,</para>
  <para style="p">
    <verse number="18" style="v"/>യതോ വയം പ്രത്യക്ഷാൻ വിഷയാൻ അനുദ്ദിശ്യാപ്രത്യക്ഷാൻ ഉദ്ദിശാമഃ| യതോ ഹേതോഃ പ്രത്യക്ഷവിഷയാഃ ക്ഷണമാത്രസ്ഥായിനഃ കിന്ത്വപ്രത്യക്ഷാ അനന്തകാലസ്ഥായിനഃ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അപരമ് അസ്മാകമ് ഏതസ്മിൻ പാർഥിവേ ദൂഷ്യരൂപേ വേശ്മനി ജീർണേ സതീശ്വരേണ നിർമ്മിതമ് അകരകൃതമ് അസ്മാകമ് അനന്തകാലസ്ഥായി വേശ്മൈകം സ്വർഗേ വിദ്യത ഇതി വയം ജാനീമഃ|</para>
  <para style="p">
    <verse number="2" style="v"/>യതോ ഹേതോരേതസ്മിൻ വേശ്മനി തിഷ്ഠന്തോ വയം തം സ്വർഗീയം വാസം പരിധാതുമ് ആകാങ്ക്ഷ്യമാണാ നിഃശ്വസാമഃ|</para>
  <para style="p">
    <verse number="3" style="v"/>തഥാപീദാനീമപി വയം തേന ന നഗ്നാഃ കിന്തു പരിഹിതവസനാ മന്യാമഹേ|</para>
  <para style="p">
    <verse number="4" style="v"/>ഏതസ്മിൻ ദൂഷ്യേ തിഷ്ഠനതോ വയം ക്ലിശ്യമാനാ നിഃശ്വസാമഃ, യതോ വയം വാസം ത്യക്തുമ് ഇച്ഛാമസ്തന്നഹി കിന്തു തം ദ്വിതീയം വാസം പരിധാതുമ് ഇച്ഛാമഃ, യതസ്തഥാ കൃതേ ജീവനേന മർത്യം ഗ്രസിഷ്യതേ|</para>
  <para style="p">
    <verse number="5" style="v"/>ഏതദർഥം വയം യേന സൃഷ്ടാഃ സ ഈശ്വര ഏവ സ ചാസ്മഭ്യം സത്യങ്കാരസ്യ പണസ്വരൂപമ് ആത്മാനം ദത്തവാൻ|</para>
  <para style="p">
    <verse number="6" style="v"/>അതഏവ വയം സർവ്വദോത്സുകാ ഭവാമഃ കിഞ്ച ശരീരേ യാവദ് അസ്മാഭി ർന്യുഷ്യതേ താവത് പ്രഭുതോ ദൂരേ പ്രോഷ്യത ഇതി ജാനീമഃ,</para>
  <para style="p">
    <verse number="7" style="v"/>യതോ വയം ദൃഷ്ടിമാർഗേ ന ചരാമഃ കിന്തു വിശ്വാസമാർഗേ|</para>
  <para style="p">
    <verse number="8" style="v"/>അപരഞ്ച ശരീരാദ് ദൂരേ പ്രവസ്തും പ്രഭോഃ സന്നിധൗ നിവസ്തുഞ്ചാകാങ്ക്ഷ്യമാണാ ഉത്സുകാ ഭവാമഃ|</para>
  <para style="p">
    <verse number="9" style="v"/>തസ്മാദേവ കാരണാദ് വയം തസ്യ സന്നിധൗ നിവസന്തസ്തസ്മാദ് ദൂരേ പ്രവസന്തോ വാ തസ്മൈ രോചിതും യതാമഹേ|</para>
  <para style="p">
    <verse number="10" style="v"/>യസ്മാത് ശരീരാവസ്ഥായാമ് ഏകൈകേന കൃതാനാം കർമ്മണാം ശുഭാശുഭഫലപ്രാപ്തയേ സർവ്വൈസ്മാഭിഃ ഖ്രീഷ്ടസ്യ വിചാരാസനസമ്മുഖ ഉപസ്ഥാതവ്യം|</para>
  <para style="p">
    <verse number="11" style="v"/>അതഏവ പ്രഭോ ർഭയാനകത്വം വിജ്ഞായ വയം മനുജാൻ അനുനയാമഃ കിഞ്ചേശ്വരസ്യ ഗോചരേ സപ്രകാശാ ഭവാമഃ, യുഷ്മാകം സംവേദഗോചരേഽപി സപ്രകാശാ ഭവാമ ഇത്യാശംസാമഹേ|</para>
  <para style="p">
    <verse number="12" style="v"/>അനേന വയം യുഷ്മാകം സന്നിധൗ പുനഃ സ്വാൻ പ്രശംസാമ ഇതി നഹി കിന്തു യേ മനോ വിനാ മുഖൈഃ ശ്ലാഘന്തേ തേഭ്യഃ പ്രത്യുത്തരദാനായ യൂയം യഥാസ്മാഭിഃ ശ്ലാഘിതും ശക്നുഥ താദൃശമ് ഉപായം യുഷ്മഭ്യം വിതരാമഃ|</para>
  <para style="p">
    <verse number="13" style="v"/>യദി വയം ഹതജ്ഞാനാ ഭവാമസ്തർഹി തദ് ഈശ്വരാർഥകം യദി ച സജ്ഞാനാ ഭവാമസ്തർഹി തദ് യുഷ്മദർഥകം|</para>
  <para style="p">
    <verse number="14" style="v"/>വയം ഖ്രീഷ്ടസ്യ പ്രേമ്നാ സമാകൃഷ്യാമഹേ യതഃ സർവ്വേഷാം വിനിമയേന യദ്യേകോ ജനോഽമ്രിയത തർഹി തേ സർവ്വേ മൃതാ ഇത്യാസ്മാഭി ർബുധ്യതേ|</para>
  <para style="p">
    <verse number="15" style="v"/>അപരഞ്ച യേ ജീവന്തി തേ യത് സ്വാർഥം ന ജീവന്തി കിന്തു തേഷാം കൃതേ യോ ജനോ മൃതഃ പുനരുത്ഥാപിതശ്ച തമുദ്ദിശ്യ യത് ജീവന്തി തദർഥമേവ സ സർവ്വേഷാം കൃതേ മൃതവാൻ|</para>
  <para style="p">
    <verse number="16" style="v"/>അതോ ഹേതോരിതഃ പരം കോഽപ്യസ്മാഭി ർജാതിതോ ന പ്രതിജ്ഞാതവ്യഃ| യദ്യപി പൂർവ്വം ഖ്രീഷ്ടോ ജാതിതോഽസ്മാഭിഃ പ്രതിജ്ഞാതസ്തഥാപീദാനീം ജാതിതഃ പുന ർന പ്രതിജ്ഞായതേ|</para>
  <para style="p">
    <verse number="17" style="v"/>കേനചിത് ഖ്രീഷ്ട ആശ്രിതേ നൂതനാ സൃഷ്ടി ർഭവതി പുരാതനാനി ലുപ്യന്തേ പശ്യ നിഖിലാനി നവീനാനി ഭവന്തി|</para>
  <para style="p">
    <verse number="18" style="v"/>സർവ്വഞ്ചൈതദ് ഈശ്വരസ്യ കർമ്മ യതോ യീശുഖ്രീഷ്ടേന സ ഏവാസ്മാൻ സ്വേന സാർദ്ധം സംഹിതവാൻ സന്ധാനസമ്ബന്ധീയാം പരിചര്യ്യാമ് അസ്മാസു സമർപിതവാംശ്ച|</para>
  <para style="p">
    <verse number="19" style="v"/>യതഃ ഈശ്വരഃ ഖ്രീഷ്ടമ് അധിഷ്ഠായ ജഗതോ ജനാനാമ് ആഗാംസി തേഷാമ് ഋണമിവ ന ഗണയൻ സ്വേന സാർദ്ധം താൻ സംഹിതവാൻ സന്ധിവാർത്താമ് അസ്മാസു സമർപിതവാംശ്ച|</para>
  <para style="p">
    <verse number="20" style="v"/>അതോ വയം ഖ്രീഷ്ടസ്യ വിനിമയേന ദൗത്യം കർമ്മ സമ്പാദയാമഹേ, ഈശ്വരശ്ചാസ്മാഭി ര്യുഷ്മാൻ യായാച്യതേ തതഃ ഖ്രീഷ്ടസ്യ വിനിമയേന വയം യുഷ്മാൻ പ്രാർഥയാമഹേ യൂയമീശ്വരേണ സന്ധത്ത|</para>
  <para style="p">
    <verse number="21" style="v"/>യതോ വയം തേന യദ് ഈശ്വരീയപുണ്യം ഭവാമസ്തദർഥം പാപേന സഹ യസ്യ ജ്ഞാതേയം നാസീത് സ ഏവ തേനാസ്മാകം വിനിമയേന പാപഃ കൃതഃ|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>തസ്യ സഹായാ വയം യുഷ്മാൻ പ്രാർഥയാമഹേ, ഈശ്വരസ്യാനുഗ്രഹോ യുഷ്മാഭി ർവൃഥാ ന ഗൃഹ്യതാം|</para>
  <para style="p">
    <verse number="2" style="v"/>തേനോക്തമേതത്, സംശ്രോഷ്യാമി ശുഭേ കാലേ ത്വദീയാം പ്രാർഥനാമ് അഹം| ഉപകാരം കരിഷ്യാമി പരിത്രാണദിനേ തവ| പശ്യതായം ശുഭകാലഃ പശ്യതേദം ത്രാണദിനം|</para>
  <para style="p">
    <verse number="3" style="v"/>അസ്മാകം പരിചര്യ്യാ യന്നിഷ്കലങ്കാ ഭവേത് തദർഥം വയം കുത്രാപി വിഘ്നം ന ജനയാമഃ,</para>
  <para style="p">
    <verse number="4" style="v"/>കിന്തു പ്രചുരസഹിഷ്ണുതാ ക്ലേശോ ദൈന്യം വിപത് താഡനാ കാരാബന്ധനം നിവാസഹീനത്വം പരിശ്രമോ ജാഗരണമ് ഉപവസനം</para>
  <para style="p">
    <verse number="5" style="v"/>നിർമ്മലത്വം ജ്ഞാനം മൃദുശീലതാ ഹിതൈഷിതാ</para>
  <para style="p">
    <verse number="6" style="v"/>പവിത്ര ആത്മാ നിഷ്കപടം പ്രേമ സത്യാലാപ ഈശ്വരീയശക്തി</para>
  <para style="p">
    <verse number="7" style="v"/>ർദക്ഷിണവാമാഭ്യാം കരാഭ്യാം ധർമ്മാസ്ത്രധാരണം</para>
  <para style="p">
    <verse number="8" style="v"/>മാനാപമാനയോരഖ്യാതിസുഖ്യാത്യോ ർഭാഗിത്വമ് ഏതൈഃ സർവ്വൈരീശ്വരസ്യ പ്രശംസ്യാൻ പരിചാരകാൻ സ്വാൻ പ്രകാശയാമഃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ഭ്രമകസമാ വയം സത്യവാദിനോ ഭവാമഃ, അപരിചിതസമാ വയം സുപരിചിതാ ഭവാമഃ, മൃതകൽപാ വയം ജീവാമഃ, ദണ്ഡ്യമാനാ വയം ന ഹന്യാമഹേ,</para>
  <para style="p">
    <verse number="10" style="v"/>ശോകയുക്താശ്ച വയം സദാനന്ദാമഃ, ദരിദ്രാ വയം ബഹൂൻ ധനിനഃ കുർമ്മഃ, അകിഞ്ചനാശ്ച വയം സർവ്വം ധാരയാമഃ|</para>
  <para style="p">
    <verse number="11" style="v"/>ഹേ കരിന്ഥിനഃ, യുഷ്മാകം പ്രതി മമാസ്യം മുക്തം മമാന്തഃകരണാഞ്ച വികസിതം|</para>
  <para style="p">
    <verse number="12" style="v"/>യൂയം മമാന്തരേ ന സങ്കോചിതാഃ കിഞ്ച യൂയമേവ സങ്കോചിതചിത്താഃ|</para>
  <para style="p">
    <verse number="13" style="v"/>കിന്തു മഹ്യം ന്യായ്യഫലദാനാർഥം യുഷ്മാഭിരപി വികസിതൈ ർഭവിതവ്യമ് ഇത്യഹം നിജബാലകാനിവ യുഷ്മാൻ വദാമി|</para>
  <para style="p">
    <verse number="14" style="v"/>അപരമ് അപ്രത്യയിഭിഃ സാർദ്ധം യൂയമ് ഏകയുഗേ ബദ്ധാ മാ ഭൂത, യസ്മാദ് ധർമ്മാധർമ്മയോഃ കഃ സമ്ബന്ധോഽസ്തി? തിമിരേണ സർദ്ധം പ്രഭായാ വാ കാ തുലനാസ്തി?</para>
  <para style="p">
    <verse number="15" style="v"/>ബിലീയാലദേവേന സാകം ഖ്രീഷ്ടസ്യ വാ കാ സന്ധിഃ? അവിശ്വാസിനാ സാർദ്ധം വാ വിശ്വാസിലോകസ്യാംശഃ കഃ?</para>
  <para style="p">
    <verse number="16" style="v"/>ഈശ്വരസ്യ മന്ദിരേണ സഹ വാ ദേവപ്രതിമാനാം കാ തുലനാ? അമരസ്യേശ്വരസ്യ മന്ദിരം യൂയമേവ| ഈശ്വരേണ തദുക്തം യഥാ, തേഷാം മധ്യേഽഹം സ്വാവാസം നിധാസ്യാമി തേഷാം മധ്യേ ച യാതായാതം കുർവ്വൻ തേഷാമ് ഈശ്വരോ ഭവിഷ്യാമി തേ ച മല്ലോകാ ഭവിഷ്യന്തി|</para>
  <para style="p">
    <verse number="17" style="v"/>അതോ ഹേതോഃ പരമേശ്വരഃ കഥയതി യൂയം തേഷാം മധ്യാദ് ബഹിർഭൂയ പൃഥഗ് ഭവത, കിമപ്യമേധ്യം ന സ്പൃശത; തേനാഹം യുഷ്മാൻ ഗ്രഹീഷ്യാമി,</para>
  <para style="p">
    <verse number="18" style="v"/>യുഷ്മാകം പിതാ ഭവിഷ്യാമി ച, യൂയഞ്ച മമ കന്യാപുത്രാ ഭവിഷ്യഥേതി സർവ്വശക്തിമതാ പരമേശ്വരേണോക്തം|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അതഏവ ഹേ പ്രിയതമാഃ, ഏതാദൃശീഃ പ്രതിജ്ഞാഃ പ്രാപ്തൈരസ്മാഭിഃ ശരീരാത്മനോഃ സർവ്വമാലിന്യമ് അപമൃജ്യേശ്വരസ്യ ഭക്ത്യാ പവിത്രാചാരഃ സാധ്യതാം|</para>
  <para style="p">
    <verse number="2" style="v"/>യൂയമ് അസ്മാൻ ഗൃഹ്ലീത| അസ്മാഭിഃ കസ്യാപ്യന്യായോ ന കൃതഃ കോഽപി ന വഞ്ചിതഃ|</para>
  <para style="p">
    <verse number="3" style="v"/>യുഷ്മാൻ ദോഷിണഃ കർത്തമഹം വാക്യമേതദ് വദാമീതി നഹി യുഷ്മാഭിഃ സഹ ജീവനായ മരണായ വാ വയം യുഷ്മാൻ സ്വാന്തഃകരണൈ ർധാരയാമ ഇതി പൂർവ്വം മയോക്തം|</para>
  <para style="p">
    <verse number="4" style="v"/>യുഷ്മാൻ പ്രതി മമ മഹേത്സാഹോ ജായതേ യുഷ്മാൻ അധ്യഹം ബഹു ശ്ലാഘേ ച തേന സർവ്വക്ലേശസമയേഽഹം സാന്ത്വനയാ പൂർണോ ഹർഷേണ പ്രഫുല്ലിതശ്ച ഭവാമി|</para>
  <para style="p">
    <verse number="5" style="v"/>അസ്മാസു മാകിദനിയാദേശമ് ആഗതേഷ്വസ്മാകം ശരീരസ്യ കാചിദപി ശാന്തി ർനാഭവത് കിന്തു സർവ്വതോ ബഹി ർവിരോധേനാന്തശ്ച ഭീത്യാ വയമ് അപീഡ്യാമഹി|</para>
  <para style="p">
    <verse number="6" style="v"/>കിന്തു നമ്രാണാം സാന്ത്വയിതാ യ ഈശ്വരഃ സ തീതസ്യാഗമനേനാസ്മാൻ അസാന്ത്വയത്|</para>
  <para style="p">
    <verse number="7" style="v"/>കേവലം തസ്യാഗമനേന തന്നഹി കിന്തു യുഷ്മത്തോ ജാതയാ തസ്യ സാന്ത്വനയാപി, യതോഽസ്മാസു യുഷ്മാകം ഹാർദ്ദവിലാപാസക്തത്വേഷ്വസ്മാകം സമീപേ വർണിതേഷു മമ മഹാനന്ദോ ജാതഃ|</para>
  <para style="p">
    <verse number="8" style="v"/>അഹം പത്രേണ യുഷ്മാൻ ശോകയുക്താൻ കൃതവാൻ ഇത്യസ്മാദ് അന്വതപ്യേ കിന്ത്വധുനാ നാനുതപ്യേ| തേന പത്രേണ യൂയം ക്ഷണമാത്രം ശോകയുക്തീഭൂതാ ഇതി മയാ ദൃശ്യതേ|</para>
  <para style="p">
    <verse number="9" style="v"/>ഇത്യസ്മിൻ യുഷ്മാകം ശോകേനാഹം ഹൃഷ്യാമി തന്നഹി കിന്തു മനഃപരിവർത്തനായ യുഷ്മാകം ശോകോഽഭവദ് ഇത്യനേന ഹൃഷ്യാമി യതോഽസ്മത്തോ യുഷ്മാകം കാപി ഹാനി ര്യന്ന ഭവേത് തദർഥം യുഷ്മാകമ് ഈശ്വരീയഃ ശോेകോ ജാതഃ|</para>
  <para style="p">
    <verse number="10" style="v"/>സ ഈശ്വരീയഃ ശോകഃ പരിത്രാണജനകം നിരനുതാപം മനഃപരിവർത്തനം സാധയതി കിന്തു സാംസാരികഃ ശോകോ മൃത്യും സാധയതി|</para>
  <para style="p">
    <verse number="11" style="v"/>പശ്യത തേനേശ്വരീയേണ ശോകേന യുഷ്മാകം കിം ന സാധിതം? യത്നോ ദോഷപ്രക്ഷാലനമ് അസന്തുഷ്ടത്വം ഹാർദ്ദമ് ആസക്തത്വം ഫലദാനഞ്ചൈതാനി സർവ്വാണി| തസ്മിൻ കർമ്മണി യൂയം നിർമ്മലാ ഇതി പ്രമാണം സർവ്വേണ പ്രകാരേണ യുഷ്മാഭി ർദത്തം|</para>
  <para style="p">
    <verse number="12" style="v"/>യേനാപരാദ്ധം തസ്യ കൃതേ കിംവാ യസ്യാപരാദ്ധം തസ്യ കൃതേ മയാ പത്രമ് അലേഖി തന്നഹി കിന്തു യുഷ്മാനധ്യസ്മാകം യത്നോ യദ് ഈശ്വരസ്യ സാക്ഷാദ് യുഷ്മത്സമീപേ പ്രകാശേത തദർഥമേവ|</para>
  <para style="p">
    <verse number="13" style="v"/>ഉക്തകാരണാദ് വയം സാന്ത്വനാം പ്രാപ്താഃ; താഞ്ച സാന്ത്വനാം വിനാവരോ മഹാഹ്ലാദസ്തീതസ്യാഹ്ലാദാദസ്മാഭി ർലബ്ധഃ, യതസ്തസ്യാത്മാ സർവ്വൈ ര്യുഷ്മാഭിസ്തൃപ്തഃ|</para>
  <para style="p">
    <verse number="14" style="v"/>പൂർവ്വം തസ്യ സമീപേഽഹം യുഷ്മാഭിര്യദ് അശ്ലാഘേ തേന നാലജ്ജേ കിന്തു വയം യദ്വദ് യുഷ്മാൻ പ്രതി സത്യഭാവേന സകലമ് അഭാഷാമഹി തദ്വത് തീതസ്യ സമീപേഽസ്മാകം ശ്ലാഘനമപി സത്യം ജാതം|</para>
  <para style="p">
    <verse number="15" style="v"/>യൂയം കീദൃക് തസ്യാജ്ഞാ അപാലയത ഭയകമ്പാഭ്യാം തം ഗൃഹീതവന്തശ്ചൈതസ്യ സ്മരണാദ് യുഷ്മാസു തസ്യ സ്നേഹോ ബാഹുല്യേന വർത്തതേ|</para>
  <para style="p">
    <verse number="16" style="v"/>യുഷ്മാസ്വഹം സർവ്വമാശംസേ, ഇത്യസ്മിൻ മമാഹ്ലാദോ ജായതേ|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഹേ ഭ്രാതരഃ, മാകിദനിയാദേശസ്ഥാസു സമിതിഷു പ്രകാശിതോ യ ഈശ്വരസ്യാനുഗ്രഹസ്തമഹം യുഷ്മാൻ ജ്ഞാപയാമി|</para>
  <para style="p">
    <verse number="2" style="v"/>വസ്തുതോ ബഹുക്ലേശപരീക്ഷാസമയേ തേഷാം മഹാനന്ദോഽതീവദീനതാ ച വദാന്യതായാഃ പ്രചുരഫലമ് അഫലയതാം|</para>
  <para style="p">
    <verse number="3" style="v"/>തേ സ്വേച്ഛയാ യഥാശക്തി കിഞ്ചാതിശക്തി ദാന ഉദ്യുക്താ അഭവൻ ഇതി മയാ പ്രമാണീക്രിയതേ|</para>
  <para style="p">
    <verse number="4" style="v"/>വയഞ്ച യത് പവിത്രലോകേഭ്യസ്തേഷാം ദാനമ് ഉപകാരാർഥകമ് അംശനഞ്ച ഗൃഹ്ലാമസ്തദ് ബഹുനുനയേനാസ്മാൻ പ്രാർഥിതവന്തഃ|</para>
  <para style="p">
    <verse number="5" style="v"/>വയം യാദൃക് പ്രത്യൈ·ക്ഷാമഹി താദൃഗ് അകൃത്വാ തേഽഗ്രേ പ്രഭവേ തതഃ പരമ് ഈശ്വരസ്യേച്ഛയാസ്മഭ്യമപി സ്വാൻ ന്യവേദയൻ|</para>
  <para style="p">
    <verse number="6" style="v"/>അതോ ഹേതോസ്ത്വം യഥാരബ്ധവാൻ തഥൈവ കരിന്ഥിനാം മധ്യേഽപി തദ് ദാനഗ്രഹണം സാധയേതി യുഷ്മാൻ അധി വയം തീതം പ്രാർഥയാമഹി|</para>
  <para style="p">
    <verse number="7" style="v"/>അതോ വിശ്വാസോ വാക്പടുതാ ജ്ഞാനം സർവ്വോത്സാഹോ ഽസ്മാസു പ്രേമ ചൈതൈ ർഗുണൈ ര്യൂയം യഥാപരാൻ അതിശേധ്വേ തഥൈവൈതേന ഗുണേനാപ്യതിശേധ്വം|</para>
  <para style="p">
    <verse number="8" style="v"/>ഏതദ് അഹമ് ആജ്ഞയാ കഥയാമീതി നഹി കിന്ത്വന്യേഷാമ് ഉത്സാഹകാരണാദ് യുഷ്മാകമപി പ്രേമ്നഃ സാരല്യം പരീക്ഷിതുമിച്ഛതാ മയൈതത് കഥ്യതേ|</para>
  <para style="p">
    <verse number="9" style="v"/>യൂയഞ്ചാസ്മത്പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യാനുഗ്രഹം ജാനീഥ യതസ്തസ്യ നിർധനത്വേന യൂയം യദ് ധനിനോ ഭവഥ തദർഥം സ ധനീ സന്നപി യുഷ്മത്കൃതേ നിർധനോഽഭവത്|</para>
  <para style="p">
    <verse number="10" style="v"/>ഏതസ്മിൻ അഹം യുഷ്മാൻ സ്വവിചാരം ജ്ഞാപയാമി| ഗതം സംവത്സരമ് ആരഭ്യ യൂയം കേവലം കർമ്മ കർത്തം തന്നഹി കിന്ത്വിച്ഛുകതാം പ്രകാശയിതുമപ്യുപാക്രാഭ്യധ്വം തതോ ഹേതോ ര്യുഷ്മത്കൃതേ മമ മന്ത്രണാ ഭദ്രാ|</para>
  <para style="p">
    <verse number="11" style="v"/>അതോ ഽധുനാ തത്കർമ്മസാധനം യുഷ്മാഭിഃ ക്രിയതാം തേന യദ്വദ് ഇച്ഛുകതായാമ് ഉത്സാഹസ്തദ്വദ് ഏകൈകസ്യ സമ്പദനുസാരേണ കർമ്മസാധനമ് അപി ജനിഷ്യതേ|</para>
  <para style="p">
    <verse number="12" style="v"/>യസ്മിൻ ഇച്ഛുകതാ വിദ്യതേ തേന യന്ന ധാര്യ്യതേ തസ്മാത് സോഽനുഗൃഹ്യത ഇതി നഹി കിന്തു യദ് ധാര്യ്യതേ തസ്മാദേവ|</para>
  <para style="p">
    <verse number="13" style="v"/>യത ഇതരേഷാം വിരാമേണ യുഷ്മാകഞ്ച ക്ലേശേന ഭവിതവ്യം തന്നഹി കിന്തു സമതയൈവ|</para>
  <para style="p">
    <verse number="14" style="v"/>വർത്തമാനസമയേ യുഷ്മാകം ധനാധിക്യേന തേഷാം ധനന്യൂനതാ പൂരയിതവ്യാ തസ്മാത് തേഷാമപ്യാധിക്യേന യുഷ്മാകം ന്യൂനതാ പൂരയിഷ്യതേ തേന സമതാ ജനിഷ്യതേ|</para>
  <para style="p">
    <verse number="15" style="v"/>തദേവ ശാസ്ത്രേഽപി ലിഖിതമ് ആസ്തേ യഥാ, യേനാധികം സംഗൃഹീതം തസ്യാധികം നാഭവത് യേന ചാൽപം സംഗൃഹീതം തസ്യാൽപം നാഭവത്|</para>
  <para style="p">
    <verse number="16" style="v"/>യുഷ്മാകം ഹിതായ തീതസ്യ മനസി യ ഈശ്വര ഇമമ് ഉദ്യോഗം ജനിതവാൻ സ ധന്യോ ഭവതു|</para>
  <para style="p">
    <verse number="17" style="v"/>തീതോഽസ്മാകം പ്രാർഥനാം ഗൃഹീതവാൻ കിഞ്ച സ്വയമ് ഉദ്യുക്തഃ സൻ സ്വേച്ഛയാ യുഷ്മത്സമീപം ഗതവാൻ|</para>
  <para style="p">
    <verse number="18" style="v"/>തേന സഹ യോഽപര ഏകോ ഭ്രാതാസ്മാഭിഃ പ്രേഷിതഃ സുസംവാദാത് തസ്യ സുഖ്യാത്യാ സർവ്വാഃ സമിതയോ വ്യാപ്താഃ|</para>
  <para style="p">
    <verse number="19" style="v"/>പ്രഭോ ർഗൗരവായ യുഷ്മാകമ് ഇച്ഛുകതായൈ ച സ സമിതിഭിരേതസ്യൈ ദാനസേവായൈ അസ്മാകം സങ്ഗിത്വേ ന്യയോജ്യത|</para>
  <para style="p">
    <verse number="20" style="v"/>യതോ യാ മഹോപായനസേവാസ്മാഭി ർവിധീയതേ താമധി വയം യത് കേനാപി ന നിന്ദ്യാമഹേ തദർഥം യതാമഹേ|</para>
  <para style="p">
    <verse number="21" style="v"/>യതഃ കേവലം പ്രഭോഃ സാക്ഷാത് തന്നഹി കിന്തു മാനവാനാമപി സാക്ഷാത് സദാചാരം കർത്തുമ് ആലോചാമഹേ|</para>
  <para style="p">
    <verse number="22" style="v"/>താഭ്യാം സഹാപര ഏകോ യോ ഭ്രാതാസ്മാഭിഃ പ്രേഷിതഃ സോഽസ്മാഭി ർബഹുവിഷയേഷു ബഹവാരാൻ പരീക്ഷിത ഉദ്യോഗീവ പ്രകാശിതശ്ച കിന്ത്വധുനാ യുഷ്മാസു ദൃഢവിശ്വാസാത് തസ്യോത്സാഹോ ബഹു വവൃധേ|</para>
  <para style="p">
    <verse number="23" style="v"/>യദി കശ്ചിത് തീതസ്യ തത്ത്വം ജിജ്ഞാസതേ തർഹി സ മമ സഹഭാഗീ യുഷ്മന്മധ്യേ സഹകാരീ ച, അപരയോ ർഭ്രാത്രോസ്തത്ത്വം വാ യദി ജിജ്ഞാസതേ തർഹി തൗ സമിതീനാം ദൂതൗ ഖ്രീഷ്ടസ്യ പ്രതിബിമ്ബൗ ചേതി തേന ജ്ഞായതാം|</para>
  <para style="p">
    <verse number="24" style="v"/>അതോ ഹേതോഃ സമിതീനാം സമക്ഷം യുഷ്മത്പ്രേമ്നോഽസ്മാകം ശ്ലാഘായാശ്ച പ്രാമാണ്യം താൻ പ്രതി യുഷ്മാഭിഃ പ്രകാശയിതവ്യം|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>പവിത്രലോകാനാമ് ഉപകാരാർഥകസേവാമധി യുഷ്മാൻ പ്രതി മമ ലിഖനം നിഷ്പ്രയോജനം|</para>
  <para style="p">
    <verse number="2" style="v"/>യത ആഖായാദേശസ്ഥാ ലോകാ ഗതവർഷമ് ആരഭ്യ തത്കാര്യ്യ ഉദ്യതാഃ സന്തീതി വാക്യേനാഹം മാകിദനീയലോകാനാം സമീപേ യുഷ്മാകം യാമ് ഇച്ഛുകതാമധി ശ്ലാഘേ താമ് അവഗതോഽസ്മി യുഷ്മാകം തസ്മാദ് ഉത്സാഹാച്ചാപരേഷാം ബഹൂനാമ് ഉദ്യോഗോ ജാതഃ|</para>
  <para style="p">
    <verse number="3" style="v"/>കിഞ്ചൈതസ്മിൻ യുഷ്മാൻ അധ്യസ്മാകം ശ്ലാഘാ യദ് അതഥ്യാ ന ഭവേത് യൂയഞ്ച മമ വാക്യാനുസാരാദ് യദ് ഉദ്യതാസ്തിഷ്ഠേത തദർഥമേവ തേ ഭ്രാതരോ മയാ പ്രേഷിതാഃ|</para>
  <para style="p">
    <verse number="4" style="v"/>യസ്മാത് മയാ സാർദ്ധം കൈശ്ചിത് മാകിദനീയഭ്രാതൃഭിരാഗത്യ യൂയമനുദ്യതാ ഇതി യദി ദൃശ്യതേ തർഹി തസ്മാദ് ദൃഢവിശ്വാസാദ് യുഷ്മാകം ലജ്ജാ ജനിഷ്യത ഇത്യസ്മാഭി ർന വക്തവ്യം കിന്ത്വസ്മാകമേവ ലജ്ജാ ജനിഷ്യതേ|</para>
  <para style="p">
    <verse number="5" style="v"/>അതഃ പ്രാക് പ്രതിജ്ഞാതം യുഷ്മാകം ദാനം യത് സഞ്ചിതം ഭവേത് തച്ച യദ് ഗ്രാഹകതായാഃ ഫലമ് അഭൂത്വാ ദാനശീലതായാ ഏവ ഫലം ഭവേത് തദർഥം മമാഗ്രേ ഗമനായ തത്സഞ്ചയനായ ച താൻ ഭ്രാതൃൻ ആദേഷ്ടുമഹം പ്രയോജനമ് അമന്യേ|</para>
  <para style="p">
    <verse number="6" style="v"/>അപരമപി വ്യാഹരാമി കേനചിത് ക്ഷുദ്രഭാവേന ബീജേഷൂപ്തേഷു സ്വൽപാനി ശസ്യാനി കർത്തിഷ്യന്തേ, കിഞ്ച കേനചിദ് ബഹുദഭവേന ബീജേഷൂപ്തേഷു ബഹൂനി ശസ്യാനി കർത്തിഷ്യന്തേ|</para>
  <para style="p">
    <verse number="7" style="v"/>ഏകൈകേന സ്വമനസി യഥാ നിശ്ചീയതേ തഥൈവ ദീയതാം കേനാപി കാതരേണ ഭീതേന വാ ന ദീയതാം യത ഈശ്വരോ ഹൃഷ്ടമാനസേ ദാതരി പ്രീയതേ|</para>
  <para style="p">
    <verse number="8" style="v"/>അപരമ് ഈശ്വരോ യുഷ്മാൻ പ്രതി സർവ്വവിധം ബഹുപ്രദം പ്രസാദം പ്രകാശയിതുമ് അർഹതി തേന യൂയം സർവ്വവിഷയേ യഥേഷ്ടം പ്രാപ്യ സർവ്വേണ സത്കർമ്മണാ ബഹുഫലവന്തോ ഭവിഷ്യഥ|</para>
  <para style="p">
    <verse number="9" style="v"/>ഏതസ്മിൻ ലിഖിതമാസ്തേ, യഥാ, വ്യയതേ സ ജനോ രായം ദുർഗതേഭ്യോ ദദാതി ച| നിത്യസ്ഥായീ ച തദ്ധർമ്മഃ</para>
  <para style="p">
    <verse number="10" style="v"/>ബീജം ഭേജനീയമ് അന്നഞ്ച വപ്ത്രേ യേന വിശ്രാണ്യതേ സ യുഷ്മഭ്യമ് അപി ബീജം വിശ്രാണ്യ ബഹുലീകരിഷ്യതി യുഷ്മാകം ധർമ്മഫലാനി വർദ്ധയിഷ്യതി ച|</para>
  <para style="p">
    <verse number="11" style="v"/>തേന സർവ്വവിഷയേ സധനീഭൂതൈ ര്യുഷ്മാഭിഃ സർവ്വവിഷയേ ദാനശീലതായാം പ്രകാശിതായാമ് അസ്മാഭിരീശ്വരസ്യ ധന്യവാദഃ സാധയിഷ്യതേ|</para>
  <para style="p">
    <verse number="12" style="v"/>ഏതയോപകാരസേവയാ പവിത്രലോകാനാമ് അർഥാഭാവസ്യ പ്രതീകാരോ ജായത ഇതി കേവലം നഹി കിന്ത്വീശ്ചരസ്യ ധന്യവാദോഽപി ബാഹുല്യേനോത്പാദ്യതേ|</para>
  <para style="p">
    <verse number="13" style="v"/>യത ഏതസ്മാദ് ഉപകാരകരണാദ് യുഷ്മാകം പരീക്ഷിതത്വം ബുദ്ധ്വാ ബഹുഭിഃ ഖ്രീഷ്ടസുസംവാദാങ്ഗീകരണേ യുഷ്മാകമ് ആജ്ഞാഗ്രാഹിത്വാത് തദ്ഭാഗിത്വേ ച താൻ അപരാംശ്ച പ്രതി യുഷ്മാകം ദാതൃത്വാദ് ഈശ്വരസ്യ ധന്യവാദഃ കാരിഷ്യതേ,</para>
  <para style="p">
    <verse number="14" style="v"/>യുഷ്മദർഥം പ്രാർഥനാം കൃത്വാ ച യുഷ്മാസ്വീശ്വരസ്യ ഗരിഷ്ഠാനുഗ്രഹാദ് യുഷ്മാസു തൈഃ പ്രേമ കാരിഷ്യതേ|</para>
  <para style="p">
    <verse number="15" style="v"/>അപരമ് ഈശ്വരസ്യാനിർവ്വചനീയദാനാത് സ ധന്യോ ഭൂയാത്|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>യുഷ്മത്പ്രത്യക്ഷേ നമ്രഃ കിന്തു പരോക്ഷേ പ്രഗൽഭഃ പൗലോഽഹം ഖ്രീഷ്ടസ്യ ക്ഷാന്ത്യാ വിനീത്യാ ച യുഷ്മാൻ പ്രാർഥയേ|</para>
  <para style="p">
    <verse number="2" style="v"/>മമ പ്രാർഥനീയമിദം വയം യൈഃ ശാരീരികാചാരിണോ മന്യാമഹേ താൻ പ്രതി യാം പ്രഗൽഭതാം പ്രകാശയിതും നിശ്ചിനോമി സാ പ്രഗൽഭതാ സമാഗതേന മയാചരിതവ്യാ ന ഭവതു|</para>
  <para style="p">
    <verse number="3" style="v"/>യതഃ ശരീരേ ചരന്തോഽപി വയം ശാരീരികം യുദ്ധം ന കുർമ്മഃ|</para>
  <para style="p">
    <verse number="4" style="v"/>അസ്മാകം യുദ്ധാസ്ത്രാണി ച ന ശാരീരികാനി കിന്ത്വീശ്വരേണ ദുർഗഭഞ്ജനായ പ്രബലാനി ഭവന്തി,</para>
  <para style="p">
    <verse number="5" style="v"/>തൈശ്ച വയം വിതർകാൻ ഈശ്വരീയതത്ത്വജ്ഞാനസ്യ പ്രതിബന്ധികാം സർവ്വാം ചിത്തസമുന്നതിഞ്ച നിപാതയാമഃ സർവ്വസങ്കൽപഞ്ച ബന്ദിനം കൃത്വാ ഖ്രീഷ്ടസ്യാജ്ഞാഗ്രാഹിണം കുർമ്മഃ,</para>
  <para style="p">
    <verse number="6" style="v"/>യുഷ്മാകമ് ആജ്ഞാഗ്രാഹിത്വേ സിദ്ധേ സതി സർവ്വസ്യാജ്ഞാലങ്ഘനസ്യ പ്രതീകാരം കർത്തുമ് ഉദ്യതാ ആസ്മഹേ ച|</para>
  <para style="p">
    <verse number="7" style="v"/>യദ് ദൃഷ്ടിഗോചരം തദ് യുഷ്മാഭി ർദൃശ്യതാം| അഹം ഖ്രീഷ്ടസ്യ ലോക ഇതി സ്വമനസി യേന വിജ്ഞായതേ സ യഥാ ഖ്രീഷ്ടസ്യ ഭവതി വയമ് അപി തഥാ ഖ്രീഷ്ടസ്യ ഭവാമ ഇതി പുനർവിവിച്യ തേന ബുധ്യതാം|</para>
  <para style="p">
    <verse number="8" style="v"/>യുഷ്മാകം നിപാതായ തന്നഹി കിന്തു നിഷ്ഠായൈ പ്രഭുനാ ദത്തം യദസ്മാകം സാമർഥ്യം തേന യദ്യപി കിഞ്ചിദ് അധികം ശ്ലാഘേ തഥാപി തസ്മാന്ന ത്രപിഷ്യേ|</para>
  <para style="p">
    <verse number="9" style="v"/>അഹം പത്രൈ ര്യുഷ്മാൻ ത്രാസയാമി യുഷ്മാഭിരേതന്ന മന്യതാം|</para>
  <para style="p">
    <verse number="10" style="v"/>തസ്യ പത്രാണി ഗുരുതരാണി പ്രബലാനി ച ഭവന്തി കിന്തു തസ്യ ശാരീരസാക്ഷാത്കാരോ ദുർബ്ബല ആലാപശ്ച തുച്ഛനീയ ഇതി കൈശ്ചിദ് ഉച്യതേ|</para>
  <para style="p">
    <verse number="11" style="v"/>കിന്തു പരോക്ഷേ പത്രൈ ർഭാഷമാണാ വയം യാദൃശാഃ പ്രകാശാമഹേ പ്രത്യക്ഷേ കർമ്മ കുർവ്വന്തോഽപി താദൃശാ ഏവ പ്രകാശിഷ്യാമഹേ തത് താദൃശേന വാചാലേന ജ്ഞായതാം|</para>
  <para style="p">
    <verse number="12" style="v"/>സ്വപ്രശംസകാനാം കേഷാഞ്ചിന്മധ്യേ സ്വാൻ ഗണയിതും തൈഃ സ്വാൻ ഉപമാതും വാ വയം പ്രഗൽഭാ ന ഭവാമഃ, യതസ്തേ സ്വപരിമാണേന സ്വാൻ പരിമിമതേ സ്വൈശ്ച സ്വാൻ ഉപമിഭതേ തസ്മാത് നിർബ്ബോധാ ഭവന്തി ച|</para>
  <para style="p">
    <verse number="13" style="v"/>വയമ് അപരിമിതേന ന ശ്ലാഘിഷ്യാമഹേ കിന്ത്വീശ്വരേണ സ്വരജ്ജ്വാ യുഷ്മദ്ദേശഗാമി യത് പരിമാണമ് അസ്മദർഥം നിരൂപിതം തേനൈവ ശ്ലാഘിഷ്യാമഹേ|</para>
  <para style="p">
    <verse number="14" style="v"/>യുഷ്മാകം ദേശോഽസ്മാഭിരഗന്തവ്യസ്തസ്മാദ് വയം സ്വസീമാമ് ഉല്ലങ്ഘാമഹേ തന്നഹി യതഃ ഖ്രീഷ്ടസ്യ സുസംവാദേനാപരേഷാം പ്രാഗ് വയമേവ യുഷ്മാൻ പ്രാപ്തവന്തഃ|</para>
  <para style="p">
    <verse number="15" style="v"/>വയം സ്വസീമാമ് ഉല്ലങ്ഘ്യ പരക്ഷേത്രേണ ശ്ലാഘാമഹേ തന്നഹി, കിഞ്ച യുഷ്മാകം വിശ്വാസേ വൃദ്ധിം ഗതേ യുഷ്മദ്ദേശേഽസ്മാകം സീമാ യുഷ്മാഭിർദീർഘം വിസ്താരയിഷ്യതേ,</para>
  <para style="p">
    <verse number="16" style="v"/>തേന വയം യുഷ്മാകം പശ്ചിമദിക്സ്ഥേഷു സ്ഥാനേഷു സുസംവാദം ഘോഷയിഷ്യാമഃ, ഇത്ഥം പരസീമായാം പരേണ യത് പരിഷ്കൃതം തേന ന ശ്ലാഘിഷ്യാമഹേ|</para>
  <para style="p">
    <verse number="17" style="v"/>യഃ കശ്ചിത് ശ്ലാഘമാനഃ സ്യാത് ശ്ലാഘതാം പ്രഭുനാ സ ഹി|</para>
  <para style="p">
    <verse number="18" style="v"/>സ്വേന യഃ പ്രശംസ്യതേ സ പരീക്ഷിതോ നഹി കിന്തു പ്രഭുനാ യഃ പ്രശംസ്യതേ സ ഏവ പരീക്ഷിതഃ|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>യൂയം മമാജ്ഞാനതാം ക്ഷണം യാവത് സോഢുമ് അർഹഥ, അതഃ സാ യുഷ്മാഭിഃ സഹ്യതാം|</para>
  <para style="p">
    <verse number="2" style="v"/>ഈശ്വരേ മമാസക്തത്വാദ് അഹം യുഷ്മാനധി തപേ യസ്മാത് സതീം കന്യാമിവ യുഷ്മാൻ ഏകസ്മിൻ വരേഽർഥതഃ ഖ്രീഷ്ടേ സമർപയിതുമ് അഹം വാഗ്ദാനമ് അകാർഷം|</para>
  <para style="p">
    <verse number="3" style="v"/>കിന്തു സർപേണ സ്വഖലതയാ യദ്വദ് ഹവാ വഞ്ചയാഞ്ചകേ തദ്വത് ഖ്രീഷ്ടം പ്രതി സതീത്വാദ് യുഷ്മാകം ഭ്രംശഃ സമ്ഭവിഷ്യതീതി ബിഭേമി|</para>
  <para style="p">
    <verse number="4" style="v"/>അസ്മാഭിരനാഖ്യാപിതോഽപരഃ കശ്ചിദ് യീശു ര്യദി കേനചിദ് ആഗന്തുകേനാഖ്യാപ്യതേ യുഷ്മാഭിഃ പ്രാഗലബ്ധ ആത്മാ വാ യദി ലഭ്യതേ പ്രാഗഗൃഹീതഃ സുസംവാദോ വാ യദി ഗൃഹ്യതേ തർഹി മന്യേ യൂയം സമ്യക് സഹിഷ്യധ്വേ|</para>
  <para style="p">
    <verse number="5" style="v"/>കിന്തു മുഖ്യേഭ്യഃ പ്രേരിതേഭ്യോഽഹം കേനചിത് പ്രകാരേണ ന്യൂനോ നാസ്മീതി ബുധ്യേ|</para>
  <para style="p">
    <verse number="6" style="v"/>മമ വാക്പടുതായാ ന്യൂനത്വേ സത്യപി ജ്ഞാനസ്യ ന്യൂനത്വം നാസ്തി കിന്തു സർവ്വവിഷയേ വയം യുഷ്മദ്ഗോചരേ പ്രകാശാമഹേ|</para>
  <para style="p">
    <verse number="7" style="v"/>യുഷ്മാകമ് ഉന്നത്യൈ മയാ നമ്രതാം സ്വീകൃത്യേശ്വരസ്യ സുസംവാദോ വിനാ വേതനം യുഷ്മാകം മധ്യേ യദ് അഘോഷ്യത തേന മയാ കിം പാപമ് അകാരി?</para>
  <para style="p">
    <verse number="8" style="v"/>യുഷ്മാകം സേവനായാഹമ് അന്യസമിതിഭ്യോ ഭൃതി ഗൃഹ്ലൻ ധനമപഹൃതവാൻ,</para>
  <para style="p">
    <verse number="9" style="v"/>യദാ ച യുഷ്മന്മധ്യേഽവഽർത്തേ തദാ മമാർഥാഭാവേ ജാതേ യുഷ്മാകം കോഽപി മയാ ന പീഡിതഃ; യതോ മമ സോഽർഥാഭാവോ മാകിദനിയാദേശാദ് ആഗതൈ ഭ്രാതൃഭി ന്യവാര്യ്യത, ഇത്ഥമഹം ക്കാപി വിഷയേ യഥാ യുഷ്മാസു ഭാരോ ന ഭവാമി തഥാ മയാത്മരക്ഷാ കൃതാ കർത്തവ്യാ ച|</para>
  <para style="p">
    <verse number="10" style="v"/>ഖ്രീഷ്ടസ്യ സത്യതാ യദി മയി തിഷ്ഠതി തർഹി മമൈഷാ ശ്ലാഘാ നിഖിലാഖായാദേശേ കേനാപി ന രോത്സ്യതേ|</para>
  <para style="p">
    <verse number="11" style="v"/>ഏതസ്യ കാരണം കിം? യുഷ്മാസു മമ പ്രേമ നാസ്ത്യേതത് കിം തത്കാരണം? തദ് ഈശ്വരോ വേത്തി|</para>
  <para style="p">
    <verse number="12" style="v"/>യേ ഛിദ്രമന്വിഷ്യന്തി തേ യത് കിമപി ഛിദ്രം ന ലഭന്തേ തദർഥമേവ തത് കർമ്മ മയാ ക്രിയതേ കാരിഷ്യതേ ച തസ്മാത് തേ യേന ശ്ലാഘന്തേ തേനാസ്മാകം സമാനാ ഭവിഷ്യന്തി|</para>
  <para style="p">
    <verse number="13" style="v"/>താദൃശാ ഭാക്തപ്രേരിതാഃ പ്രവഞ്ചകാഃ കാരവോ ഭൂത്വാ ഖ്രീഷ്ടസ്യ പ്രേരിതാനാം വേശം ധാരയന്തി|</para>
  <para style="p">
    <verse number="14" style="v"/>തച്ചാശ്ചര്യ്യം നഹി; യതഃ സ്വയം ശയതാനപി തേജസ്വിദൂതസ്യ വേശം ധാരയതി,</para>
  <para style="p">
    <verse number="15" style="v"/>തതസ്തസ്യ പരിചാരകാ അപി ധർമ്മപരിചാരകാണാം വേശം ധാരയന്തീത്യദ്ഭുതം നഹി; കിന്തു തേഷാം കർമ്മാണി യാദൃശാനി ഫലാന്യപി താദൃശാനി ഭവിഷ്യന്തി|</para>
  <para style="p">
    <verse number="16" style="v"/>അഹം പുന ർവദാമി കോഽപി മാം നിർബ്ബോധം ന മന്യതാം കിഞ്ച യദ്യപി നിർബ്ബോധോ ഭവേയം തഥാപി യൂയം നിർബ്ബോധമിവ മാമനുഗൃഹ്യ ക്ഷണൈകം യാവത് മമാത്മശ്ലാഘാമ് അനുജാനീത|</para>
  <para style="p">
    <verse number="17" style="v"/>ഏതസ്യാഃ ശ്ലാഘായാ നിമിത്തം മയാ യത് കഥിതവ്യം തത് പ്രഭുനാദിഷ്ടേനേവ കഥ്യതേ തന്നഹി കിന്തു നിർബ്ബോധേനേവ|</para>
  <para style="p">
    <verse number="18" style="v"/>അപരേ ബഹവഃ ശാരീരികശ്ലാഘാം കുർവ്വതേ തസ്മാദ് അഹമപി ശ്ലാഘിഷ്യേ|</para>
  <para style="p">
    <verse number="19" style="v"/>ബുദ്ധിമന്തോ യൂയം സുഖേന നിർബ്ബോധാനാമ് ആചാരം സഹധ്വേ|</para>
  <para style="p">
    <verse number="20" style="v"/>കോഽപി യദി യുഷ്മാൻ ദാസാൻ കരോതി യദി വാ യുഷ്മാകം സർവ്വസ്വം ഗ്രസതി യദി വാ യുഷ്മാൻ ഹരതി യദി വാത്മാഭിമാനീ ഭവതി യദി വാ യുഷ്മാകം കപോലമ് ആഹന്തി തർഹി തദപി യൂയം സഹധ്വേ|</para>
  <para style="p">
    <verse number="21" style="v"/>ദൗർബ്ബല്യാദ് യുഷ്മാഭിരവമാനിതാ ഇവ വയം ഭാഷാമഹേ, കിന്ത്വപരസ്യ കസ്യചിദ് യേന പ്രഗൽഭതാ ജായതേ തേന മമാപി പ്രഗൽഭതാ ജായത ഇതി നിർബ്ബോധേനേവ മയാ വക്തവ്യം|</para>
  <para style="p">
    <verse number="22" style="v"/>തേ കിമ് ഇബ്രിലോകാഃ? അഹമപീബ്രീ| തേ കിമ് ഇസ്രായേലീയാഃ? അഹമപീസ്രായേലീയഃ| തേ കിമ് ഇബ്രാഹീമോ വംശാഃ? അഹമപീബ്രാഹീമോ വംശഃ|</para>
  <para style="p">
    <verse number="23" style="v"/>തേ കിം ഖ്രീഷ്ടസ്യ പരിചാരകാഃ? അഹം തേഭ്യോഽപി തസ്യ മഹാപരിചാരകഃ; കിന്തു നിർബ്ബോധ ഇവ ഭാഷേ, തേഭ്യോഽപ്യഹം ബഹുപരിശ്രമേ ബഹുപ്രഹാരേ ബഹുവാരം കാരായാം ബഹുവാരം പ്രാണനാശസംശയേ ച പതിതവാൻ|</para>
  <para style="p">
    <verse number="24" style="v"/>യിഹൂദീയൈരഹം പഞ്ചകൃത്വ ഊനചത്വാരിംശത്പ്രഹാരൈരാഹതസ്ത്രിർവേത്രാഘാതമ് ഏകകൃത്വഃ പ്രസ്തരാഘാതഞ്ച പ്രപ്തവാൻ|</para>
  <para style="p">
    <verse number="25" style="v"/>വാരത്രയം പോതഭഞ്ജനേന ക്ലിഷ്ടോഽഹമ് അഗാധസലിലേ ദിനമേകം രാത്രിമേകാഞ്ച യാപിതവാൻ|</para>
  <para style="p">
    <verse number="26" style="v"/>ബഹുവാരം യാത്രാഭി ർനദീനാം സങ്കടൈ ർദസ്യൂനാം സങ്കടൈഃ സ്വജാതീയാനാം സങ്കടൈ ർഭിന്നജാതീയാനാം സങ്കടൈ ർനഗരസ്യ സങ്കടൈ ർമരുഭൂമേഃ സങ്കടൈ സാഗരസ്യ സങ്കടൈ ർഭാക്തഭ്രാതൃണാം സങ്കടൈശ്ച</para>
  <para style="p">
    <verse number="27" style="v"/>പരിശ്രമക്ലേശാഭ്യാം വാരം വാരം ജാഗരണേന ക്ഷുധാതൃഷ്ണാഭ്യാം ബഹുവാരം നിരാഹാരേണ ശീതനഗ്നതാഭ്യാഞ്ചാഹം കാലം യാപിതവാൻ|</para>
  <para style="p">
    <verse number="28" style="v"/>താദൃശം നൈമിത്തികം ദുഃഖം വിനാഹം പ്രതിദിനമ് ആകുലോ ഭവാമി സർവ്വാസാം സമിതീനാം ചിന്താ ച മയി വർത്തതേ|</para>
  <para style="p">
    <verse number="29" style="v"/>യേനാഹം ന ദുർബ്ബലീഭവാമി താദൃശം ദൗർബ്ബല്യം കഃ പാപ്നോതി?</para>
  <para style="p">
    <verse number="30" style="v"/>യദി മയാ ശ്ലാഘിതവ്യം തർഹി സ്വദുർബ്ബലതാമധി ശ്ലാഘിഷ്യേ|</para>
  <para style="p">
    <verse number="31" style="v"/>മയാ മൃഷാവാക്യം ന കഥ്യത ഇതി നിത്യം പ്രശംസനീയോഽസ്മാകം പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യ താത ഈശ്വരോ ജാനാതി|</para>
  <para style="p">
    <verse number="32" style="v"/>ദമ്മേഷകനഗരേഽരിതാരാജസ്യ കാര്യ്യാധ്യക്ഷോ മാം ധർത്തുമ് ഇച്ഛൻ യദാ സൈന്യൈസ്തദ് ദമ്മേഷകനഗരമ് അരക്ഷയത്</para>
  <para style="p">
    <verse number="33" style="v"/>തദാഹം ലോകൈഃ പിടകമധ്യേ പ്രാചീരഗവാക്ഷേണാവരോഹിതസ്തസ്യ കരാത് ത്രാണം പ്രാപം|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ആത്മശ്ലാഘാ മമാനുപയുക്താ കിന്ത്വഹം പ്രഭോ ർദർശനാദേശാനാമ് ആഖ്യാനം കഥയിതും പ്രവർത്തേ|</para>
  <para style="p">
    <verse number="2" style="v"/>ഇതശ്ചതുർദശവത്സരേഭ്യഃ പൂർവ്വം മയാ പരിചിത ഏകോ ജനസ്തൃതീയം സ്വർഗമനീയത, സ സശരീരേണ നിഃശരീരേണ വാ തത് സ്ഥാനമനീയത തദഹം ന ജാനാമി കിന്ത്വീശ്വരോ ജാനാതി|</para>
  <para style="p">
    <verse number="3" style="v"/>സ മാനവഃ സ്വർഗം നീതഃ സൻ അകഥ്യാനി മർത്ത്യവാഗതീതാനി ച വാക്യാനി ശ്രുതവാൻ|</para>
  <para style="p">
    <verse number="4" style="v"/>കിന്തു തദാനീം സ സശരീരോ നിഃശരീരോ വാസീത് തന്മയാ ന ജ്ഞായതേ തദ് ഈശ്വരേണൈവ ജ്ഞായതേ|</para>
  <para style="p">
    <verse number="5" style="v"/>തമധ്യഹം ശ്ലാഘിഷ്യേ മാമധി നാന്യേന കേനചിദ് വിഷയേണ ശ്ലാഘിഷ്യേ കേവലം സ്വദൗർബ്ബല്യേന ശ്ലാഘിഷ്യേ|</para>
  <para style="p">
    <verse number="6" style="v"/>യദ്യഹമ് ആത്മശ്ലാഘാം കർത്തുമ് ഇച്ഛേയം തഥാപി നിർബ്ബോധ ഇവ ന ഭവിഷ്യാമി യതഃ സത്യമേവ കഥയിഷ്യാമി, കിന്തു ലോകാ മാം യാദൃശം പശ്യന്തി മമ വാക്യം ശ്രുത്വാ വാ യാദൃശം മാം മന്യതേ തസ്മാത് ശ്രേഷ്ഠം മാം യന്ന ഗണയന്തി തദർഥമഹം തതോ വിരംസ്യാമി|</para>
  <para style="p">
    <verse number="7" style="v"/>അപരമ് ഉത്കൃഷ്ടദർശനപ്രാപ്തിതോ യദഹമ് ആത്മാഭിമാനീ ന ഭവാമി തദർഥം ശരീരവേധകമ് ഏകം ശൂലം മഹ്യമ് അദായി തത് മദീയാത്മാഭിമാനനിവാരണാർഥം മമ താഡയിതാ ശയതാനോ ദൂതഃ|</para>
  <para style="p">
    <verse number="8" style="v"/>മത്തസ്തസ്യ പ്രസ്ഥാനം യാചിതുമഹം ത്രിസ്തമധി പ്രഭുമുദ്ദിശ്യ പ്രാർഥനാം കൃതവാൻ|</para>
  <para style="p">
    <verse number="9" style="v"/>തതഃ സ മാമുക്തവാൻ മമാനുഗ്രഹസ്തവ സർവ്വസാധകഃ, യതോ ദൗർബ്ബല്യാത് മമ ശക്തിഃ പൂർണതാം ഗച്ഛതീതി| അതഃ ഖ്രീഷ്ടസ്യ ശക്തി ര്യന്മാമ് ആശ്രയതി തദർഥം സ്വദൗർബ്ബല്യേന മമ ശ്ലാഘനം സുഖദം|</para>
  <para style="p">
    <verse number="10" style="v"/>തസ്മാത് ഖ്രീഷ്ടഹേതോ ർദൗർബ്ബല്യനിന്ദാദരിദ്രതാവിപക്ഷതാകഷ്ടാദിഷു സന്തുഷ്യാമ്യഹം| യദാഹം ദുർബ്ബലോഽസ്മി തദൈവ സബലോ ഭവാമി|</para>
  <para style="p">
    <verse number="11" style="v"/>ഏതേനാത്മശ്ലാഘനേനാഹം നിർബ്ബോധ ഇവാഭവം കിന്തു യൂയം തസ്യ കാരണം യതോ മമ പ്രശംസാ യുഷ്മാഭിരേവ കർത്തവ്യാസീത്| യദ്യപ്യമ് അഗണ്യോ ഭവേയം തഥാപി മുഖ്യതമേഭ്യഃ പ്രേരിതേഭ്യഃ കേനാപി പ്രകാരേണ നാഹം ന്യൂനോഽസ്മി|</para>
  <para style="p">
    <verse number="12" style="v"/>സർവ്വഥാദ്ഭുതക്രിയാശക്തിലക്ഷണൈഃ പ്രേരിതസ്യ ചിഹ്നാനി യുഷ്മാകം മധ്യേ സധൈര്യ്യം മയാ പ്രകാശിതാനി|</para>
  <para style="p">
    <verse number="13" style="v"/>മമ പാലനാർഥം യൂയം മയാ ഭാരാക്രാന്താ നാഭവതൈതദ് ഏകം ന്യൂനത്വം വിനാപരാഭ്യഃ സമിതിഭ്യോ യുഷ്മാകം കിം ന്യൂനത്വം ജാതം? അനേന മമ ദോഷം ക്ഷമധ്വം|</para>
  <para style="p">
    <verse number="14" style="v"/>പശ്യത തൃതീയവാരം യുुഷ്മത്സമീപം ഗന്തുമുദ്യതോഽസ്മി തത്രാപ്യഹം യുഷ്മാൻ ഭാരാക്രാന്താൻ ന കരിഷ്യാമി| യുഷ്മാകം സമ്പത്തിമഹം ന മൃഗയേ കിന്തു യുഷ്മാനേവ, യതഃ പിത്രോഃ കൃതേ സന്താനാനാം ധനസഞ്ചയോഽനുപയുക്തഃ കിന്തു സന്താനാനാം കൃതേ പിത്രോ ർധനസഞ്ചയ ഉപയുക്തഃ|</para>
  <para style="p">
    <verse number="15" style="v"/>അപരഞ്ച യുഷ്മാസു ബഹു പ്രീയമാണോഽപ്യഹം യദി യുഷ്മത്തോഽൽപം പ്രമ ലഭേ തഥാപി യുഷ്മാകം പ്രാണരക്ഷാർഥം സാനന്ദം ബഹു വ്യയം സർവ്വവ്യയഞ്ച കരിഷ്യാമി|</para>
  <para style="p">
    <verse number="16" style="v"/>യൂയം മയാ കിഞ്ചിദപി ന ഭാരാക്രാന്താ ഇതി സത്യം, കിന്ത്വഹം ധൂർത്തഃ സൻ ഛലേന യുഷ്മാൻ വഞ്ചിതവാൻ ഏതത് കിം കേനചിദ് വക്തവ്യം?</para>
  <para style="p">
    <verse number="17" style="v"/>യുഷ്മത്സമീപം മയാ യേ ലോകാഃ പ്രഹിതാസ്തേഷാമേകേന കിം മമ കോഽപ്യർഥലാഭോ ജാതഃ?</para>
  <para style="p">
    <verse number="18" style="v"/>അഹം തീതം വിനീയ തേന സാർദ്ധം ഭ്രാതരമേകം പ്രേഷിതവാൻ യുഷ്മത്തസ്തീതേന കിമ് അർഥോ ലബ്ധഃ? ഏകസ്മിൻ ഭാവ ഏകസ്യ പദചിഹ്നേഷു ചാവാം കിം ന ചരിതവന്തൗ?</para>
  <para style="p">
    <verse number="19" style="v"/>യുഷ്മാകം സമീപേ വയം പുന ർദോഷക്ഷാലനകഥാം കഥയാമ ഇതി കിം ബുധ്യധ്വേ? ഹേ പ്രിയതമാഃ, യുഷ്മാകം നിഷ്ഠാർഥം വയമീശ്വരസ്യ സമക്ഷം ഖ്രീഷ്ടേന സർവ്വാണ്യേതാനി കഥയാമഃ|</para>
  <para style="p">
    <verse number="20" style="v"/>അഹം യദാഗമിഷ്യാമി, തദാ യുഷ്മാൻ യാദൃശാൻ ദ്രഷ്ടും നേച്ഛാമി താദൃശാൻ ദ്രക്ഷ്യാമി, യൂയമപി മാം യാദൃശം ദ്രഷ്ടും നേച്ഛഥ താദൃശം ദ്രക്ഷ്യഥ, യുഷ്മന്മധ്യേ വിവാദ ഈർഷ്യാ ക്രോധോ വിപക്ഷതാ പരാപവാദഃ കർണേജപനം ദർപഃ കലഹശ്ചൈതേ ഭവിഷ്യന്തി;</para>
  <para style="p">
    <verse number="21" style="v"/>തേനാഹം യുഷ്മത്സമീപം പുനരാഗത്യ മദീയേശ്വരേണ നമയിഷ്യേ, പൂർവ്വം കൃതപാപാൻ ലോകാൻ സ്വീയാശുചിതാവേശ്യാഗമനലമ്പടതാചരണാദ് അനുതാപമ് അകൃതവന്തോ ദൃഷ്ട്വാ ച താനധി മമ ശോകോ ജനിഷ്യത ഇതി ബിഭേമി|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഏതത്തൃതീയവാരമ് അഹം യുഷ്മത്സമീപം ഗച്ഛാമി തേന സർവ്വാ കഥാ ദ്വയോസ്ത്രയാണാം വാ സാക്ഷിണാം മുഖേന നിശ്ചേഷ്യതേ|</para>
  <para style="p">
    <verse number="2" style="v"/>പൂർവ്വം യേ കൃതപാപാസ്തേഭ്യോഽന്യേഭ്യശ്ച സർവ്വേഭ്യോ മയാ പൂർവ്വം കഥിതം, പുനരപി വിദ്യമാനേനേവേദാനീമ് അവിദ്യമാനേന മയാ കഥ്യതേ, യദാ പുനരാഗമിഷ്യാമി തദാഹം ന ക്ഷമിഷ്യേ|</para>
  <para style="p">
    <verse number="3" style="v"/>ഖ്രീഷ്ടോ മയാ കഥാം കഥയത്യേതസ്യ പ്രമാണം യൂയം മൃഗയധ്വേ, സ തു യുഷ്മാൻ പ്രതി ദുർബ്ബലോ നഹി കിന്തു സബല ഏവ|</para>
  <para style="p">
    <verse number="4" style="v"/>യദ്യപി സ ദുർബ്ബലതയാ ക്രുശ ആരോപ്യത തഥാപീശ്വരീയശക്തയാ ജീവതി; വയമപി തസ്മിൻ ദുർബ്ബലാ ഭവാമഃ, തഥാപി യുഷ്മാൻ പ്രതി പ്രകാശിതയേശ്വരീയശക്ത്യാ തേന സഹ ജീവിഷ്യാമഃ|</para>
  <para style="p">
    <verse number="5" style="v"/>അതോ യൂയം വിശ്വാസയുക്താ ആധ്വേ ന വേതി ജ്ഞാതുമാത്മപരീക്ഷാം കുരുധ്വം സ്വാനേവാനുസന്ധത്ത| യീശുഃ ഖ്രീഷ്ടോ യുഷ്മന്മധ്യേ വിദ്യതേ സ്വാനധി തത് കിം ന പ്രതിജാനീഥ? തസ്മിൻ അവിദ്യമാനേ യൂയം നിഷ്പ്രമാണാ ഭവഥ|</para>
  <para style="p">
    <verse number="6" style="v"/>കിന്തു വയം നിഷ്പ്രമാണാ ന ഭവാമ ഇതി യുഷ്മാഭി ർഭോത്സ്യതേ തത്ര മമ പ്രത്യാശാ ജായതേ|</para>
  <para style="p">
    <verse number="7" style="v"/>യൂയം കിമപി കുത്സിതം കർമ്മ യന്ന കുരുഥ തദഹമ് ഈശ്വരമുദ്ദിശ്യ പ്രാർഥയേ| വയം യത് പ്രാമാണികാ ഇവ പ്രകാശാമഹേ തദർഥം തത് പ്രാർഥയാമഹ ഇതി നഹി, കിന്തു യൂയം യത് സദാചാരം കുരുഥ വയഞ്ച നിഷ്പ്രമാണാ ഇവ ഭവാമസ്തദർഥം|</para>
  <para style="p">
    <verse number="8" style="v"/>യതഃ സത്യതായാ വിപക്ഷതാം കർത്തും വയം ന സമർഥാഃ കിന്തു സത്യതായാഃ സാഹായ്യം കർത്തുമേവ|</para>
  <para style="p">
    <verse number="9" style="v"/>വയം യദാ ദുർബ്ബലാ ഭവാമസ്തദാ യുഷ്മാൻ സബലാൻ ദൃഷ്ട്വാനന്ദാമോ യുഷ്മാകം സിദ്ധത്വം പ്രാർഥയാമഹേ ച|</para>
  <para style="p">
    <verse number="10" style="v"/>അതോ ഹേതോഃ പ്രഭു ര്യുഷ്മാകം വിനാശായ നഹി കിന്തു നിഷ്ഠായൈ യത് സാമർഥ്യമ് അസ്മഭ്യം ദത്തവാൻ തേന യദ് ഉപസ്ഥിതികാലേ കാഠിന്യം മയാചരിതവ്യം ന ഭവേത് തദർഥമ് അനുപസ്ഥിതേന മയാ സർവ്വാണ്യേതാനി ലിഖ്യന്തേ|</para>
  <para style="p">
    <verse number="11" style="v"/>ഹേ ഭ്രാതരഃ, ശേഷേ വദാമി യൂയമ് ആനന്ദത സിദ്ധാ ഭവത പരസ്പരം പ്രബോധയത, ഏകമനസോ ഭവത പ്രണയഭാവമ് ആചരത| പ്രേമശാന്ത്യോരാകര ഈശ്വരോ യുഷ്മാകം സഹായോ ഭൂയാത്|</para>
  <para style="p">
    <verse number="12" style="v"/>യൂയം പവിത്രചുമ്ബനേന പരസ്പരം നമസ്കുരുധ്വം|</para>
  <para style="p">
    <verse number="13" style="v"/>പവിത്രലോകാഃ സർവ്വേ യുഷ്മാൻ നമന്തി|</para>
  <para style="p">
    <verse number="14" style="v"/>പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യാനുഗ്രഹ ഈശ്വരസ്യ പ്രേമ പവിത്രസ്യാത്മനോ ഭാഗിത്വഞ്ച സർവ്വാൻ യുഷ്മാൻ പ്രതി ഭൂയാത്| തഥാസ്തു|</para>
</usx>
