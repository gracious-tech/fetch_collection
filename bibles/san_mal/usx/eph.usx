<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="EPH" style="id">Sanskrit Bible (NT) in Malayalam Script (സത്യവേദഃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Ephesians</para>
  <para style="toc1">ഇഫിഷിണഃ പത്രം</para>
  <para style="toc2">ഇഫിഷിണഃ</para>
  <para style="toc3">ഇഫിഷിണഃ</para>
  <para style="mt1">ഇഫിഷിണഃ പത്രം</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഈശ്വരസ്യേച്ഛയാ യീശുഖ്രീഷ്ടസ്യ പ്രേരിതഃ പൗല ഇഫിഷനഗരസ്ഥാൻ പവിത്രാൻ ഖ്രീഷ്ടയീശൗ വിശ്വാസിനോ ലോകാൻ പ്രതി പത്രം ലിഖതി|</para>
  <para style="p">
    <verse number="2" style="v"/>അസ്മാകം താതസ്യേശ്വരസ്യ പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യ ചാനുഗ്രഹഃ ശാന്തിശ്ച യുഷ്മാസു വർത്തതാം|</para>
  <para style="p">
    <verse number="3" style="v"/>അസ്മാകം പ്രഭോ ര്യീശോഃ ഖ്രീഷ്ടസ്യ താത ഈശ്വരോ ധന്യോ ഭവതു; യതഃ സ ഖ്രീഷ്ടേനാസ്മഭ്യം സർവ്വമ് ആധ്യാത്മികം സ്വർഗീയവരം ദത്തവാൻ|</para>
  <para style="p">
    <verse number="4" style="v"/>വയം യത് തസ്യ സമക്ഷം പ്രേമ്നാ പവിത്രാ നിഷ്കലങ്കാശ്ച ഭവാമസ്തദർഥം സ ജഗതഃ സൃഷ്ടേ പൂർവ്വം തേനാസ്മാൻ അഭിരോചിതവാൻ, നിജാഭിലഷിതാനുരോധാച്ച</para>
  <para style="p">
    <verse number="5" style="v"/>യീശുനാ ഖ്രീഷ്ടേന സ്വസ്യ നിമിത്തം പുത്രത്വപദേഽസ്മാൻ സ്വകീയാനുഗ്രഹസ്യ മഹത്ത്വസ്യ പ്രശംസാർഥം പൂർവ്വം നിയുക്തവാൻ|</para>
  <para style="p">
    <verse number="6" style="v"/>തസ്മാദ് അനുഗ്രഹാത് സ യേന പ്രിയതമേന പുത്രേണാസ്മാൻ അനുഗൃഹീതവാൻ,</para>
  <para style="p">
    <verse number="7" style="v"/>വയം തസ്യ ശോണിതേന മുക്തിമ് അർഥതഃ പാപക്ഷമാം ലബ്ധവന്തഃ|</para>
  <para style="p">
    <verse number="8" style="v"/>തസ്യ യ ഈദൃശോഽനുഗ്രഹനിധിസ്തസ്മാത് സോഽസ്മഭ്യം സർവ്വവിധം ജ്ഞാനം ബുദ്ധിഞ്ച ബാഹുല്യരൂപേണ വിതരിതവാൻ|</para>
  <para style="p">
    <verse number="9" style="v"/>സ്വർഗപൃഥിവ്യോ ര്യദ്യദ് വിദ്യതേ തത്സർവ്വം സ ഖ്രീഷ്ടേ സംഗ്രഹീഷ്യതീതി ഹിതൈഷിണാ</para>
  <para style="p">
    <verse number="10" style="v"/>തേന കൃതോ യോ മനോരഥഃ സമ്പൂർണതാം ഗതവത്സു സമയേഷു സാധയിതവ്യസ്തമധി സ സ്വകീയാഭിലാഷസ്യ നിഗൂഢം ഭാവമ് അസ്മാൻ ജ്ഞാപിതവാൻ|</para>
  <para style="p">
    <verse number="11" style="v"/>പൂർവ്വം ഖ്രീഷ്ടേ വിശ്വാസിനോ യേ വയമ് അസ്മത്തോ യത് തസ്യ മഹിമ്നഃ പ്രശംസാ ജായതേ,</para>
  <para style="p">
    <verse number="12" style="v"/>തദർഥം യഃ സ്വകീയേച്ഛായാഃ മന്ത്രണാതഃ സർവ്വാണി സാധയതി തസ്യ മനോരഥാദ് വയം ഖ്രീഷ്ടേന പൂർവ്വം നിരൂപിതാഃ സന്തോഽധികാരിണോ ജാതാഃ|</para>
  <para style="p">
    <verse number="13" style="v"/>യൂയമപി സത്യം വാക്യമ് അർഥതോ യുഷ്മത്പരിത്രാണസ്യ സുസംവാദം നിശമ്യ തസ്മിന്നേവ ഖ്രീഷ്ടേ വിശ്വസിതവന്തഃ പ്രതിജ്ഞാതേന പവിത്രേണാത്മനാ മുദ്രയേവാങ്കിതാശ്ച|</para>
  <para style="p">
    <verse number="14" style="v"/>യതസ്തസ്യ മഹിമ്നഃ പ്രകാശായ തേന ക്രീതാനാം ലോകാനാം മുക്തി ര്യാവന്ന ഭവിഷ്യതി താവത് സ ആത്മാസ്മാകമ് അധികാരിത്വസ്യ സത്യങ്കാരസ്യ പണസ്വരൂപോ ഭവതി|</para>
  <para style="p">
    <verse number="15" style="v"/>പ്രഭൗ യീശൗ യുഷ്മാകം വിശ്വാസഃ സർവ്വേഷു പവിത്രലോകേഷു പ്രേമ ചാസ്ത ഇതി വാർത്താം ശ്രുത്വാഹമപി</para>
  <para style="p">
    <verse number="16" style="v"/>യുഷ്മാനധി നിരന്തരമ് ഈശ്വരം ധന്യം വദൻ പ്രാർഥനാസമയേ ച യുഷ്മാൻ സ്മരൻ വരമിമം യാചാമി|</para>
  <para style="p">
    <verse number="17" style="v"/>അസ്മാകം പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യ താതോ യഃ പ്രഭാവാകര ഈശ്വരഃ സ സ്വകീയതത്ത്വജ്ഞാനായ യുഷ്മഭ്യം ജ്ഞാനജനകമ് പ്രകാശിതവാക്യബോധകഞ്ചാത്മാനം ദേയാത്|</para>
  <para style="p">
    <verse number="18" style="v"/>യുഷ്മാകം ജ്ഞാനചക്ഷൂംഷി ച ദീപ്തിയുക്താനി കൃത്വാ തസ്യാഹ്വാനം കീദൃശ്യാ പ്രത്യാശയാ സമ്ബലിതം പവിത്രലോകാനാം മധ്യേ തേന ദത്തോഽധികാരഃ കീദൃശഃ പ്രഭാവനിധി ർവിശ്വാസിഷു ചാസ്മാസു പ്രകാശമാനസ്യ</para>
  <para style="p">
    <verse number="19" style="v"/>തദീയമഹാപരാക്രമസ്യ മഹത്വം കീദൃഗ് അനുപമം തത് സർവ്വം യുഷ്മാൻ ജ്ഞാപയതു|</para>
  <para style="p">
    <verse number="20" style="v"/>യതഃ സ യസ്യാഃ ശക്തേഃ പ്രബലതാം ഖ്രീഷ്ടേ പ്രകാശയൻ മൃതഗണമധ്യാത് തമ് ഉത്ഥാപിതവാൻ,</para>
  <para style="p">
    <verse number="21" style="v"/>അധിപതിത്വപദം ശാസനപദം പരാക്രമോ രാജത്വഞ്ചേതിനാമാനി യാവന്തി പദാനീഹ ലോകേ പരലോകേ ച വിദ്യന്തേ തേഷാം സർവ്വേഷാമ് ഊർദ്ധ്വേ സ്വർഗേ നിജദക്ഷിണപാർശ്വേ തമ് ഉപവേശിതവാൻ,</para>
  <para style="p">
    <verse number="22" style="v"/>സർവ്വാണി തസ്യ ചരണയോരധോ നിഹിതവാൻ യാ സമിതിസ്തസ്യ ശരീരം സർവ്വത്ര സർവ്വേഷാം പൂരയിതുഃ പൂരകഞ്ച ഭവതി തം തസ്യാ മൂർദ്ധാനം കൃത്വാ</para>
  <para style="p">
    <verse number="23" style="v"/>സർവ്വേഷാമ് ഉപര്യ്യുപരി നിയുക്തവാംശ്ച സൈവ ശക്തിരസ്മാസ്വപി തേന പ്രകാശ്യതേ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>പുരാ യൂയമ് അപരാധൈഃ പാപൈശ്ച മൃതാഃ സന്തസ്താന്യാചരന്ത ഇഹലോകസ്യ സംസാരാനുസാരേണാകാശരാജ്യസ്യാധിപതിമ്</para>
  <para style="p">
    <verse number="2" style="v"/>അർഥതഃ സാമ്പ്രതമ് ആജ്ഞാലങ്ഘിവംശേഷു കർമ്മകാരിണമ് ആത്മാനമ് അന്വവ്രജത|</para>
  <para style="p">
    <verse number="3" style="v"/>തേഷാം മധ്യേ സർവ്വേ വയമപി പൂർവ്വം ശരീരസ്യ മനസ്കാമനായാഞ്ചേഹാം സാധയന്തഃ സ്വശരീരസ്യാഭിലാഷാൻ ആചരാമ സർവ്വേഽന്യ ഇവ ച സ്വഭാവതഃ ക്രോധഭജനാന്യഭവാമ|</para>
  <para style="p">
    <verse number="4" style="v"/>കിന്തു കരുണാനിധിരീശ്വരോ യേന മഹാപ്രേമ്നാസ്മാൻ ദയിതവാൻ</para>
  <para style="p">
    <verse number="5" style="v"/>തസ്യ സ്വപ്രേമ്നോ ബാഹുല്യാദ് അപരാധൈ ർമൃതാനപ്യസ്മാൻ ഖ്രീഷ്ടേന സഹ ജീവിതവാൻ യതോഽനുഗ്രഹാദ് യൂയം പരിത്രാണം പ്രാപ്താഃ|</para>
  <para style="p">
    <verse number="6" style="v"/>സ ച ഖ്രീഷ്ടേന യീശുനാസ്മാൻ തേന സാർദ്ധമ് ഉത്ഥാപിതവാൻ സ്വർഗ ഉപവേശിതവാംശ്ച|</para>
  <para style="p">
    <verse number="7" style="v"/>ഇത്ഥം സ ഖ്രീഷ്ടേന യീശുനാസ്മാൻ പ്രതി സ്വഹിതൈഷിതയാ ഭാവിയുഗേഷു സ്വകീയാനുഗ്രഹസ്യാനുപമം നിധിം പ്രകാശയിതുമ് ഇച്ഛതി|</para>
  <para style="p">
    <verse number="8" style="v"/>യൂയമ് അനുഗ്രഹാദ് വിശ്വാസേന പരിത്രാണം പ്രാപ്താഃ, തച്ച യുഷ്മന്മൂലകം നഹി കിന്ത്വീശ്വരസ്യൈവ ദാനം,</para>
  <para style="p">
    <verse number="9" style="v"/>തത് കർമ്മണാം ഫലമ് അപി നഹി, അതഃ കേനാപി ന ശ്ലാഘിതവ്യം|</para>
  <para style="p">
    <verse number="10" style="v"/>യതോ വയം തസ്യ കാര്യ്യം പ്രാഗ് ഈശ്വരേണ നിരൂപിതാഭിഃ സത്ക്രിയാഭിഃ കാലയാപനായ ഖ്രീഷ്ടേ യീശൗ തേന മൃഷ്ടാശ്ച|</para>
  <para style="p">
    <verse number="11" style="v"/>പുരാ ജന്മനാ ഭിന്നജാതീയാ ഹസ്തകൃതം ത്വക്ഛേദം പ്രാപ്തൈ ർലോകൈശ്ചാച്ഛിന്നത്വച ഇതിനാമ്നാ ഖ്യാതാ യേ യൂയം തൈ ര്യുഷ്മാഭിരിദം സ്മർത്തവ്യം</para>
  <para style="p">
    <verse number="12" style="v"/>യത് തസ്മിൻ സമയേ യൂയം ഖ്രീഷ്ടാദ് ഭിന്നാ ഇസ്രായേലലോകാനാം സഹവാസാദ് ദൂരസ്ഥാഃ പ്രതിജ്ഞാസമ്ബലിതനിയമാനാം ബഹിഃ സ്ഥിതാഃ സന്തോ നിരാശാ നിരീശ്വരാശ്ച ജഗത്യാധ്വമ് ഇതി|</para>
  <para style="p">
    <verse number="13" style="v"/>കിന്ത്വധുനാ ഖ്രീഷ്ടേ യീശാവാശ്രയം പ്രാപ്യ പുരാ ദൂരവർത്തിനോ യൂയം ഖ്രീഷ്ടസ്യ ശോണിതേന നികടവർത്തിനോഽഭവത|</para>
  <para style="p">
    <verse number="14" style="v"/>യതഃ സ ഏവാസ്മാകം സന്ധിഃ സ ദ്വയമ് ഏകീകൃതവാൻ ശത്രുതാരൂപിണീം മധ്യവർത്തിനീം പ്രഭേദകഭിത്തിം ഭഗ്നവാൻ ദണ്ഡാജ്ഞായുക്തം വിധിശാസ്ത്രം സ്വശരീരേണ ലുപ്തവാംശ്ച|</para>
  <para style="p">
    <verse number="15" style="v"/>യതഃ സ സന്ധിം വിധായ തൗ ദ്വൗ സ്വസ്മിൻ ഏകം നുതനം മാനവം കർത്തും</para>
  <para style="p">
    <verse number="16" style="v"/>സ്വകീയക്രുശേ ശത്രുതാം നിഹത്യ തേനൈവൈകസ്മിൻ ശരീരേ തയോ ർദ്വയോരീശ്വരേണ സന്ധിം കാരയിതും നിശ്ചതവാൻ|</para>
  <para style="p">
    <verse number="17" style="v"/>സ ചാഗത്യ ദൂരവർത്തിനോ യുഷ്മാൻ നികടവർത്തിനോ ഽസ്മാംശ്ച സന്ധേ ർമങ്ഗലവാർത്താം ജ്ഞാപിതവാൻ|</para>
  <para style="p">
    <verse number="18" style="v"/>യതസ്തസ്മാദ് ഉഭയപക്ഷീയാ വയമ് ഏകേനാത്മനാ പിതുഃ സമീപം ഗമനായ സാമർഥ്യം പ്രാപ്തവന്തഃ|</para>
  <para style="p">
    <verse number="19" style="v"/>അത ഇദാനീം യൂയമ് അസമ്പർകീയാ വിദേശിനശ്ച ന തിഷ്ഠനതഃ പവിത്രലോകൈഃ സഹവാസിന ഈശ്വരസ്യ വേശ്മവാസിനശ്ചാധ്വേ|</para>
  <para style="p">
    <verse number="20" style="v"/>അപരം പ്രേരിതാ ഭവിഷ്യദ്വാദിനശ്ച യത്ര ഭിത്തിമൂലസ്വരൂപാസ്തത്ര യൂയം തസ്മിൻ മൂലേ നിചീയധ്വേ തത്ര ച സ്വയം യീശുഃ ഖ്രീഷ്ടഃ പ്രധാനഃ കോണസ്ഥപ്രസ്തരഃ|</para>
  <para style="p">
    <verse number="21" style="v"/>തേന കൃത്സ്നാ നിർമ്മിതിഃ സംഗ്രഥ്യമാനാ പ്രഭോഃ പവിത്രം മന്ദിരം ഭവിതും വർദ്ധതേ|</para>
  <para style="p">
    <verse number="22" style="v"/>യൂയമപി തത്ര സംഗ്രഥ്യമാനാ ആത്മനേശ്വരസ്യ വാസസ്ഥാനം ഭവഥ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അതോ ഹേതോ ർഭിന്നജാതീയാനാം യുഷ്മാകം നിമിത്തം യീശുഖ്രീഷ്ടസ്യ ബന്ദീ യഃ സോഽഹം പൗലോ ബ്രവീമി|</para>
  <para style="p">
    <verse number="2" style="v"/>യുഷ്മദർഥമ് ഈശ്വരേണ മഹ്യം ദത്തസ്യ വരസ്യ നിയമഃ കീദൃശസ്തദ് യുഷ്മാഭിരശ്രാവീതി മന്യേ|</para>
  <para style="p">
    <verse number="3" style="v"/>അർഥതഃ പൂർവ്വം മയാ സംക്ഷേപേണ യഥാ ലിഖിതം തഥാഹം പ്രകാശിതവാക്യേനേശ്വരസ്യ നിഗൂഢം ഭാവം ജ്ഞാപിതോഽഭവം|</para>
  <para style="p">
    <verse number="4" style="v"/>അതോ യുഷ്മാഭിസ്തത് പഠിത്വാ ഖ്രീഷ്ടമധി തസ്മിന്നിഗൂഢേ ഭാവേ മമ ജ്ഞാനം കീദൃശം തദ് ഭോത്സ്യതേ|</para>
  <para style="p">
    <verse number="5" style="v"/>പൂർവ്വയുഗേഷു മാനവസന്താനാസ്തം ജ്ഞാപിതാ നാസൻ കിന്ത്വധുനാ സ ഭാവസ്തസ്യ പവിത്രാൻ പ്രേരിതാൻ ഭവിഷ്യദ്വാദിനശ്ച പ്രത്യാത്മനാ പ്രകാശിതോഽഭവത്;</para>
  <para style="p">
    <verse number="6" style="v"/>അർഥത ഈശ്വരസ്യ ശക്തേഃ പ്രകാശാത് തസ്യാനുഗ്രഹേണ യോ വരോ മഹ്യമ് അദായി തേനാഹം യസ്യ സുസംവാദസ്യ പരിചാരകോഽഭവം,</para>
  <para style="p">
    <verse number="7" style="v"/>തദ്വാരാ ഖ്രീഷ്ടേന ഭിന്നജാതീയാ അന്യൈഃ സാർദ്ധമ് ഏകാധികാരാ ഏകശരീരാ ഏകസ്യാഃ പ്രതിജ്ഞായാ അംശിനശ്ച ഭവിഷ്യന്തീതി|</para>
  <para style="p">
    <verse number="8" style="v"/>സർവ്വേഷാം പവിത്രലോകാനാം ക്ഷുദ്രതമായ മഹ്യം വരോഽയമ് അദായി യദ് ഭിന്നജാതീയാനാം മധ്യേ ബോധാഗയസ്യ ഗുണനിധേഃ ഖ്രീഷ്ടസ്യ മങ്ഗലവാർത്താം പ്രചാരയാമി,</para>
  <para style="p">
    <verse number="9" style="v"/>കാലാവസ്ഥാതഃ പൂർവ്വസ്മാച്ച യോ നിഗൂഢഭാവ ഈശ്വരേ ഗുപ്ത ആസീത് തദീയനിയമം സർവ്വാൻ ജ്ഞാപയാമി|</para>
  <para style="p">
    <verse number="10" style="v"/>യത ഈശ്വരസ്യ നാനാരൂപം ജ്ഞാനം യത് സാമ്പ്രതം സമിത്യാ സ്വർഗേ പ്രാധാന്യപരാക്രമയുക്താനാം ദൂതാനാം നികടേ പ്രകാശ്യതേ തദർഥം സ യീശുനാ ഖ്രീഷ്ടേന സർവ്വാണി സൃഷ്ടവാൻ|</para>
  <para style="p">
    <verse number="11" style="v"/>യതോ വയം യസ്മിൻ വിശ്വസ്യ ദൃഢഭക്ത്യാ നിർഭയതാമ് ഈശ്വരസ്യ സമാഗമേ സാമർഥ്യഞ്ച</para>
  <para style="p">
    <verse number="12" style="v"/>പ്രാപ്തവന്തസ്തമസ്മാകം പ്രഭും യീശും ഖ്രീഷ്ടമധി സ കാലാവസ്ഥായാഃ പൂർവ്വം തം മനോരഥം കൃതവാൻ|</para>
  <para style="p">
    <verse number="13" style="v"/>അതോഽഹം യുഷ്മന്നിമിത്തം ദുഃഖഭോഗേന ക്ലാന്തിം യന്ന ഗച്ഛാമീതി പ്രാർഥയേ യതസ്തദേവ യുഷ്മാകം ഗൗരവം|</para>
  <para style="p">
    <verse number="14" style="v"/>അതോ ഹേതോഃ സ്വർഗപൃഥിവ്യോഃ സ്ഥിതഃ കൃത്സ്നോ വംശോ യസ്യ നാമ്നാ വിഖ്യാതസ്തമ്</para>
  <para style="p">
    <verse number="15" style="v"/>അസ്മത്പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യ പിതരമുദ്ദിശ്യാഹം ജാനുനീ പാതയിത്വാ തസ്യ പ്രഭാവനിധിതോ വരമിമം പ്രാർഥയേ|</para>
  <para style="p">
    <verse number="16" style="v"/>തസ്യാത്മനാ യുഷ്മാകമ് ആന്തരികപുരുഷസ്യ ശക്തേ ർവൃദ്ധിഃ ക്രിയതാം|</para>
  <para style="p">
    <verse number="17" style="v"/>ഖ്രീഷ്ടസ്തു വിശ്വാസേന യുഷ്മാകം ഹൃദയേഷു നിവസതു| പ്രേമണി യുഷ്മാകം ബദ്ധമൂലത്വം സുസ്ഥിരത്വഞ്ച ഭവതു|</para>
  <para style="p">
    <verse number="18" style="v"/>ഇത്ഥം പ്രസ്ഥതായാ ദീർഘതായാ ഗഭീരതായാ ഉച്ചതായാശ്ച ബോധായ സർവ്വൈഃ പവിത്രലോകൈഃ പ്രാപ്യം സാമർഥ്യം യുഷ്മാഭി ർലഭ്യതാം,</para>
  <para style="p">
    <verse number="19" style="v"/>ജ്ഞാനാതിരിക്തം ഖ്രീഷ്ടസ്യ പ്രേമ ജ്ഞായതാമ് ഈശ്വരസ്യ സമ്പൂർണവൃദ്ധിപര്യ്യന്തം യുഷ്മാകം വൃദ്ധി ർഭവതു ച|</para>
  <para style="p">
    <verse number="20" style="v"/>അസ്മാകമ് അന്തരേ യാ ശക്തിഃ പ്രകാശതേ തയാ സർവ്വാതിരിക്തം കർമ്മ കുർവ്വൻ അസ്മാകം പ്രാർഥനാം കൽപനാഞ്ചാതിക്രമിതും യഃ ശക്നോതി</para>
  <para style="p">
    <verse number="21" style="v"/>ഖ്രീഷ്ടയീശുനാ സമിതേ ർമധ്യേ സർവ്വേഷു യുഗേഷു തസ്യ ധന്യവാദോ ഭവതു| ഇതി|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അതോ ബന്ദിരഹം പ്രഭോ ർനാമ്നാ യുഷ്മാൻ വിനയേ യൂയം യേനാഹ്വാനേനാഹൂതാസ്തദുപയുക്തരൂപേണ</para>
  <para style="p">
    <verse number="2" style="v"/>സർവ്വഥാ നമ്രതാം മൃദുതാം തിതിക്ഷാം പരസ്പരം പ്രമ്നാ സഹിഷ്ണുതാഞ്ചാചരത|</para>
  <para style="p">
    <verse number="3" style="v"/>പ്രണയബന്ധനേന ചാത്മന ഏैക്യം രക്ഷിതും യതധ്വം|</para>
  <para style="p">
    <verse number="4" style="v"/>യൂയമ് ഏകശരീരാ ഏകാത്മാനശ്ച തദ്വദ് ആഹ്വാനേന യൂയമ് ഏകപ്രത്യാശാപ്രാപ്തയേ സമാഹൂതാഃ|</para>
  <para style="p">
    <verse number="5" style="v"/>യുഷ്മാകമ് ഏകഃ പ്രഭുരേകോ വിശ്വാസ ഏകം മജ്ജനം, സർവ്വേഷാം താതഃ</para>
  <para style="p">
    <verse number="6" style="v"/>സർവ്വോപരിസ്ഥഃ സർവ്വവ്യാപീ സർവ്വേഷാം യുഷ്മാകം മധ്യവർത്തീ ചൈക ഈശ്വര ആസ്തേ|</para>
  <para style="p">
    <verse number="7" style="v"/>കിന്തു ഖ്രീഷ്ടസ്യ ദാനപരിമാണാനുസാരാദ് അസ്മാകമ് ഏകൈകസ്മൈ വിശേഷോ വരോഽദായി|</para>
  <para style="p">
    <verse number="8" style="v"/>യഥാ ലിഖിതമ് ആസ്തേ, "ഊർദ്ധ്വമ് ആരുഹ്യ ജേതൃൻ സ വിജിത്യ ബന്ദിനോഽകരോത്| തതഃ സ മനുജേഭ്യോഽപി സ്വീയാൻ വ്യശ്രാണയദ് വരാൻ|| "</para>
  <para style="p">
    <verse number="9" style="v"/>ഊർദ്ധ്വമ് ആരുഹ്യേതിവാക്യസ്യായമർഥഃ സ പൂർവ്വം പൃഥിവീരൂപം സർവ്വാധഃസ്ഥിതം സ്ഥാനമ് അവതീർണവാൻ;</para>
  <para style="p">
    <verse number="10" style="v"/>യശ്ചാവതീർണവാൻ സ ഏവ സ്വർഗാണാമ് ഉപര്യ്യുപര്യ്യാരൂഢവാൻ യതഃ സർവ്വാണി തേന പൂരയിതവ്യാനി|</para>
  <para style="p">
    <verse number="11" style="v"/>സ ഏവ ച കാംശ്ചന പ്രേരിതാൻ അപരാൻ ഭവിഷ്യദ്വാദിനോഽപരാൻ സുസംവാദപ്രചാരകാൻ അപരാൻ പാലകാൻ ഉപദേശകാംശ്ച നിയുക്തവാൻ|</para>
  <para style="p">
    <verse number="12" style="v"/>യാവദ് വയം സർവ്വേ വിശ്വാസസ്യേശ്വരപുത്രവിഷയകസ്യ തത്ത്വജ്ഞാനസ്യ ചൈക്യം സമ്പൂർണം പുരുഷർഥഞ്ചാർഥതഃ ഖ്രീഷ്ടസ്യ സമ്പൂർണപരിമാണസ്യ സമം പരിമാണം ന പ്രാപ്നുമസ്താവത്</para>
  <para style="p">
    <verse number="13" style="v"/>സ പരിചര്യ്യാകർമ്മസാധനായ ഖ്രീഷ്ടസ്യ ശരീരസ്യ നിഷ്ഠായൈ ച പവിത്രലോകാനാം സിദ്ധതായാസ്താദൃശമ് ഉപായം നിശ്ചിതവാൻ|</para>
  <para style="p">
    <verse number="14" style="v"/>അതഏവ മാനുഷാണാം ചാതുരീതോ ഭ്രമകധൂർത്തതായാശ്ഛലാച്ച ജാതേന സർവ്വേണ ശിക്ഷാവായുനാ വയം യദ് ബാലകാ ഇവ ദോലായമാനാ ന ഭ്രാമ്യാമ ഇത്യസ്മാഭി ര്യതിതവ്യം,</para>
  <para style="p">
    <verse number="15" style="v"/>പ്രേമ്നാ സത്യതാമ് ആചരദ്ഭിഃ സർവ്വവിഷയേ ഖ്രീഷ്ടമ് ഉദ്ദിശ്യ വർദ്ധിതവ്യഞ്ച, യതഃ സ മൂർദ്ധാ,</para>
  <para style="p">
    <verse number="16" style="v"/>തസ്മാച്ചൈകൈകസ്യാങ്ഗസ്യ സ്വസ്വപരിമാണാനുസാരേണ സാഹായ്യകരണാദ് ഉപകാരകൈഃ സർവ്വൈഃ സന്ധിഭിഃ കൃത്സ്നസ്യ ശരീരസ്യ സംയോഗേ സമ്മിലനേ ച ജാതേ പ്രേമ്നാ നിഷ്ഠാം ലഭമാനം കൃത്സ്നം ശരീരം വൃദ്ധിം പ്രാപ്നോതി|</para>
  <para style="p">
    <verse number="17" style="v"/>യുഷ്മാൻ അഹം പ്രഭുനേദം ബ്രവീമ്യാദിശാമി ച, അന്യേ ഭിന്നജാതീയാ ഇവ യൂയം പൂന ർമാചരത|</para>
  <para style="p">
    <verse number="18" style="v"/>യതസ്തേ സ്വമനോമായാമ് ആചരന്ത്യാന്തരികാജ്ഞാനാത് മാനസികകാഠിന്യാച്ച തിമിരാവൃതബുദ്ധയ ഈശ്വരീയജീവനസ്യ ബഗീർഭൂതാശ്ച ഭവന്തി,</para>
  <para style="p">
    <verse number="19" style="v"/>സ്വാൻ ചൈതന്യശൂന്യാൻ കൃത്വാ ച ലോഭേന സർവ്വവിധാശൗചാചരണായ ലമ്പടതായാം സ്വാൻ സമർപിതവന്തഃ|</para>
  <para style="p">
    <verse number="20" style="v"/>കിന്തു യൂയം ഖ്രീഷ്ടം ന താദൃശം പരിചിതവന്തഃ,</para>
  <para style="p">
    <verse number="21" style="v"/>യതോ യൂയം തം ശ്രുതവന്തോ യാ സത്യാ ശിക്ഷാ യീശുതോ ലഭ്യാ തദനുസാരാത് തദീയോപദേശം പ്രാപ്തവന്തശ്ചേതി മന്യേ|</para>
  <para style="p">
    <verse number="22" style="v"/>തസ്മാത് പൂർവ്വകാലികാചാരകാരീ യഃ പുരാതനപുരുഷോ മായാഭിലാഷൈ ർനശ്യതി തം ത്യക്ത്വാ യുഷ്മാഭി ർമാനസികഭാവോ നൂതനീകർത്തവ്യഃ,</para>
  <para style="p">
    <verse number="23" style="v"/>യോ നവപുരുഷ ഈശ്വരാനുരൂപേണ പുണ്യേന സത്യതാസഹിതേന</para>
  <para style="p">
    <verse number="24" style="v"/>ധാർമ്മികത്വേന ച സൃഷ്ടഃ സ ഏവ പരിധാതവ്യശ്ച|</para>
  <para style="p">
    <verse number="25" style="v"/>അതോ യൂയം സർവ്വേ മിഥ്യാകഥനം പരിത്യജ്യ സമീപവാസിഭിഃ സഹ സത്യാലാപം കുരുത യതോ വയം പരസ്പരമ് അങ്ഗപ്രത്യങ്ഗാ ഭവാമഃ|</para>
  <para style="p">
    <verse number="26" style="v"/>അപരം ക്രോധേ ജാതേ പാപം മാ കുരുധ്വമ്, അശാന്തേ യുഷ്മാകം രോഷേസൂര്യ്യോഽസ്തം ന ഗച്ഛതു|</para>
  <para style="p">
    <verse number="27" style="v"/>അപരം ശയതാനേ സ്ഥാനം മാ ദത്ത|</para>
  <para style="p">
    <verse number="28" style="v"/>ചോരഃ പുനശ്ചൈര്യ്യം ന കരോതു കിന്തു ദീനായ ദാനേ സാമർഥ്യം യജ്ജായതേ തദർഥം സ്വകരാഭ്യാം സദ്വൃത്ത്യാ പരിശ്രമം കരോതു|</para>
  <para style="p">
    <verse number="29" style="v"/>അപരം യുഷ്മാകം വദനേഭ്യഃ കോഽപി കദാലാപോ ന നിർഗച്ഛതു, കിന്തു യേന ശ്രോതുരുപകാരോ ജായതേ താദൃശഃ പ്രയോജനീയനിഷ്ഠായൈ ഫലദായക ആലാപോ യുഷ്മാകം ഭവതു|</para>
  <para style="p">
    <verse number="30" style="v"/>അപരഞ്ച യൂയം മുക്തിദിനപര്യ്യന്തമ് ഈശ്വരസ്യ യേന പവിത്രേണാത്മനാ മുദ്രയാങ്കിതാ അഭവത തം ശോകാന്വിതം മാ കുരുത|</para>
  <para style="p">
    <verse number="31" style="v"/>അപരം കടുവാക്യം രോഷഃ കോഷഃ കലഹോ നിന്ദാ സർവ്വവിധദ്വേഷശ്ചൈതാനി യുഷ്മാകം മധ്യാദ് ദൂരീഭവന്തു|</para>
  <para style="p">
    <verse number="32" style="v"/>യൂയം പരസ്പരം ഹിതൈഷിണഃ കോമലാന്തഃകരണാശ്ച ഭവത| അപരമ് ഈശ്വരഃ ഖ്രീഷ്ടേന യദ്വദ് യുഷ്മാകം ദോഷാൻ ക്ഷമിതവാൻ തദ്വദ് യൂയമപി പരസ്പരം ക്ഷമധ്വം|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അതോ യൂയം പ്രിയബാലകാ ഇവേശ്വരസ്യാനുകാരിണോ ഭവത,</para>
  <para style="p">
    <verse number="2" style="v"/>ഖ്രീഷ്ട ഇവ പ്രേമാചാരം കുരുത ച, യതഃ സോഽസ്മാസു പ്രേമ കൃതവാൻ അസ്മാകം വിനിമയേന ചാത്മനിവേദനം കൃത്വാ ഗ്രാഹ്യസുഗന്ധാർഥകമ് ഉപഹാരം ബലിഞ്ചേശ്വരാച ദത്തവാൻ|</para>
  <para style="p">
    <verse number="3" style="v"/>കിന്തു വേശ്യാഗമനം സർവ്വവിധാശൗചക്രിയാ ലോഭശ്ചൈതേഷാമ് ഉച്ചാരണമപി യുഷ്മാകം മധ്യേ ന ഭവതു, ഏതദേവ പവിത്രലോകാനാമ് ഉചിതം|</para>
  <para style="p">
    <verse number="4" style="v"/>അപരം കുത്സിതാലാപഃ പ്രലാപഃ ശ്ലേഷോക്തിശ്ച ന ഭവതു യത ഏതാന്യനുചിതാനി കിന്ത്വീശ്വരസ്യ ധന്യവാദോ ഭവതു|</para>
  <para style="p">
    <verse number="5" style="v"/>വേശ്യാഗാമ്യശൗചാചാരീ ദേവപൂജക ഇവ ഗണ്യോ ലോഭീ ചൈതേഷാം കോഷി ഖ്രീഷ്ടസ്യ രാജ്യേഽർഥത ഈശ്വരസ്യ രാജ്യേ കമപ്യധികാരം ന പ്രാപ്സ്യതീതി യുഷ്മാഭിഃ സമ്യക് ജ്ഞായതാം|</para>
  <para style="p">
    <verse number="6" style="v"/>അനർഥകവാക്യേന കോഽപി യുഷ്മാൻ ന വഞ്ചയതു യതസ്താദൃഗാചാരഹേതോരനാജ്ഞാഗ്രാഹിഷു ലോകേഷ്വീശ്വരസ്യ കോപോ വർത്തതേ|</para>
  <para style="p">
    <verse number="7" style="v"/>തസ്മാദ് യൂയം തൈഃ സഹഭാഗിനോ ന ഭവത|</para>
  <para style="p">
    <verse number="8" style="v"/>പൂർവ്വം യൂയമ് അന്ധകാരസ്വരൂപാ ആധ്വം കിന്ത്വിദാനീം പ്രഭുനാ ദീപ്തിസ്വരൂപാ ഭവഥ തസ്മാദ് ദീപ്തേഃ സന്താനാ ഇവ സമാചരത|</para>
  <para style="p">
    <verse number="9" style="v"/>ദീപ്തേ ര്യത് ഫലം തത് സർവ്വവിധഹിതൈഷിതായാം ധർമ്മേ സത്യാലാപേ ച പ്രകാശതേ|</para>
  <para style="p">
    <verse number="10" style="v"/>പ്രഭവേ യദ് രോചതേ തത് പരീക്ഷധ്വം|</para>
  <para style="p">
    <verse number="11" style="v"/>യൂയം തിമിരസ്യ വിഫലകർമ്മണാമ് അംശിനോ ന ഭൂത്വാ തേഷാം ദോഷിത്വം പ്രകാശയത|</para>
  <para style="p">
    <verse number="12" style="v"/>യതസ്തേ ലോകാ രഹമി യദ് യദ് ആചരന്തി തദുച്ചാരണമ് അപി ലജ്ജാജനകം|</para>
  <para style="p">
    <verse number="13" style="v"/>യതോ ദീപ്ത്യാ യദ് യത് പ്രകാശ്യതേ തത് തയാ ചകാസ്യതേ യച്ച ചകാസ്തി തദ് ദീപ്തിസ്വരൂപം ഭവതി|</para>
  <para style="p">
    <verse number="14" style="v"/>ഏതത്കാരണാദ് ഉക്തമ് ആസ്തേ, "ഹേ നിദ്രിത പ്രബുധ്യസ്വ മൃതേഭ്യശ്ചോത്ഥിതിം കുരു| തത്കൃതേ സൂര്യ്യവത് ഖ്രീഷ്ടഃ സ്വയം ത്വാം ദ്യോതയിഷ്യതി| "</para>
  <para style="p">
    <verse number="15" style="v"/>അതഃ സാവധാനാ ഭവത, അജ്ഞാനാ ഇവ മാചരത കിന്തു ജ്ഞാനിന ഇവ സതർകമ് ആചരത|</para>
  <para style="p">
    <verse number="16" style="v"/>സമയം ബഹുമൂല്യം ഗണയധ്വം യതഃ കാലാ അഭദ്രാഃ|</para>
  <para style="p">
    <verse number="17" style="v"/>തസ്മാദ് യൂയമ് അജ്ഞാനാ ന ഭവത കിന്തു പ്രഭോരഭിമതം കിം തദവഗതാ ഭവത|</para>
  <para style="p">
    <verse number="18" style="v"/>സർവ്വനാശജനകേന സുരാപാനേന മത്താ മാ ഭവത കിന്ത്വാത്മനാ പൂര്യ്യധ്വം|</para>
  <para style="p">
    <verse number="19" style="v"/>അപരം ഗീതൈ ർഗാനൈഃ പാരമാർഥികകീർത്തനൈശ്ച പരസ്പരമ് ആലപന്തോ മനസാ സാർദ്ധം പ്രഭുമ് ഉദ്ദിശ്യ ഗായത വാദയത ച|</para>
  <para style="p">
    <verse number="20" style="v"/>സർവ്വദാ സർവ്വവിഷയേഽസ്മത്പ്രഭോ യീശോഃ ഖ്രീഷ്ടസ്യ നാമ്നാ താതമ് ഈശ്വരം ധന്യം വദത|</para>
  <para style="p">
    <verse number="21" style="v"/>യൂയമ് ഈശ്വരാദ് ഭീതാഃ സന്ത അന്യേഽപരേഷാം വശീഭൂതാ ഭവത|</para>
  <para style="p">
    <verse number="22" style="v"/>ഹേ യോഷിതഃ, യൂയം യഥാ പ്രഭോസ്തഥാ സ്വസ്വസ്വാമിനോ വശങ്ഗതാ ഭവത|</para>
  <para style="p">
    <verse number="23" style="v"/>യതഃ ഖ്രീഷ്ടോ യദ്വത് സമിതേ ർമൂർദ്ധാ ശരീരസ്യ ത്രാതാ ച ഭവതി തദ്വത് സ്വാമീ യോഷിതോ മൂർദ്ധാ|</para>
  <para style="p">
    <verse number="24" style="v"/>അതഃ സമിതി ര്യദ്വത് ഖ്രീഷ്ടസ്യ വശീഭൂതാ തദ്വദ് യോഷിദ്ഭിരപി സ്വസ്വസ്വാമിനോ വശതാ സ്വീകർത്തവ്യാ|</para>
  <para style="p">
    <verse number="25" style="v"/>അപരഞ്ച ഹേ പുരുഷാഃ, യൂയം ഖ്രീഷ്ട ഇവ സ്വസ്വയോഷിത്സു പ്രീയധ്വം|</para>
  <para style="p">
    <verse number="26" style="v"/>സ ഖ്രീഷ്ടോഽപി സമിതൗ പ്രീതവാൻ തസ്യാഃ കൃതേ ച സ്വപ്രാണാൻ ത്യക്തവാൻ യതഃ സ വാക്യേ ജലമജ്ജനേന താം പരിഷ്കൃത്യ പാവയിതുമ്</para>
  <para style="p">
    <verse number="27" style="v"/>അപരം തിലകവല്യാദിവിഹീനാം പവിത്രാം നിഷ്കലങ്കാഞ്ച താം സമിതിം തേജസ്വിനീം കൃത്വാ സ്വഹസ്തേ സമർപയിതുഞ്ചാഭിലഷിതവാൻ|</para>
  <para style="p">
    <verse number="28" style="v"/>തസ്മാത് സ്വതനുവത് സ്വയോഷിതി പ്രേമകരണം പുരുഷസ്യോചിതം, യേന സ്വയോഷിതി പ്രേമ ക്രിയതേ തേനാത്മപ്രേമ ക്രിയതേ|</para>
  <para style="p">
    <verse number="29" style="v"/>കോഽപി കദാപി ന സ്വകീയാം തനുമ് ഋതീയിതവാൻ കിന്തു സർവ്വേ താം വിഭ്രതി പുഷ്ണന്തി ച| ഖ്രീഷ്ടോഽപി സമിതിം പ്രതി തദേവ കരോതി,</para>
  <para style="p">
    <verse number="30" style="v"/>യതോ വയം തസ്യ ശരീരസ്യാങ്ഗാനി മാംസാസ്ഥീനി ച ഭവാമഃ|</para>
  <para style="p">
    <verse number="31" style="v"/>ഏതദർഥം മാനവഃ സ്വമാതാപിതരോै പരിത്യജ്യ സ്വഭാര്യ്യായാമ് ആസംക്ഷ്യതി തൗ ദ്വൗ ജനാവേകാങ്ഗൗ ഭവിഷ്യതഃ|</para>
  <para style="p">
    <verse number="32" style="v"/>ഏതന്നിഗൂഢവാക്യം ഗുരുതരം മയാ ച ഖ്രീഷ്ടസമിതീ അധി തദ് ഉച്യതേ|</para>
  <para style="p">
    <verse number="33" style="v"/>അതഏവ യുഷ്മാകമ് ഏകൈകോ ജന ആത്മവത് സ്വയോഷിതി പ്രീയതാം ഭാര്യ്യാപി സ്വാമിനം സമാദർത്തും യതതാം|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഹേ ബാലകാഃ, യൂയം പ്രഭുമ് ഉദ്ദിശ്യ പിത്രോരാജ്ഞാഗ്രാഹിണോ ഭവത യതസ്തത് ന്യായ്യം|</para>
  <para style="p">
    <verse number="2" style="v"/>ത്വം നിജപിതരം മാതരഞ്ച സമ്മന്യസ്വേതി യോ വിധിഃ സ പ്രതിജ്ഞായുക്തഃ പ്രഥമോ വിധിഃ</para>
  <para style="p">
    <verse number="3" style="v"/>ഫലതസ്തസ്മാത് തവ കല്യാണം ദേശേ ച ദീർഘകാലമ് ആയു ർഭവിഷ്യതീതി|</para>
  <para style="p">
    <verse number="4" style="v"/>അപരം ഹേ പിതരഃ, യൂയം സ്വബാലകാൻ മാ രോഷയത കിന്തു പ്രഭോ ർവിനീത്യാദേശാഭ്യാം താൻ വിനയത|</para>
  <para style="p">
    <verse number="5" style="v"/>ഹേ ദാസാഃ, യൂയം ഖ്രീഷ്ടമ് ഉദ്ദിശ്യ സഭയാഃ കമ്പാന്വിതാശ്ച ഭൂത്വാ സരലാന്തഃകരണൈരൈഹികപ്രഭൂനാമ് ആജ്ഞാഗ്രാഹിണോ ഭവത|</para>
  <para style="p">
    <verse number="6" style="v"/>ദൃഷ്ടിഗോചരീയപരിചര്യ്യയാ മാനുഷേഭ്യോ രോചിതും മാ യതധ്വം കിന്തു ഖ്രീഷ്ടസ്യ ദാസാ ഇവ നിവിഷ്ടമനോഭിരീശ്ചരസ്യേച്ഛാം സാധയത|</para>
  <para style="p">
    <verse number="7" style="v"/>മാനവാൻ അനുദ്ദിശ്യ പ്രഭുമേവോദ്ദിശ്യ സദ്ഭാവേന ദാസ്യകർമ്മ കുരുധ്വം|</para>
  <para style="p">
    <verse number="8" style="v"/>ദാസമുക്തയോ ര്യേന യത് സത്കർമ്മ ക്രിയതേ തേന തസ്യ ഫലം പ്രഭുതോ ലപ്സ്യത ഇതി ജാനീത ച|</para>
  <para style="p">
    <verse number="9" style="v"/>അപരം ഹേ പ്രഭവഃ, യുഷ്മാഭി ർഭർത്സനം വിഹായ താൻ പ്രതി ന്യായ്യാചരണം ക്രിയതാം യശ്ച കസ്യാപി പക്ഷപാതം ന കരോതി യുഷ്മാകമപി താദൃശ ഏകഃ പ്രഭുഃ സ്വർഗേ വിദ്യത ഇതി ജ്ഞായതാം|</para>
  <para style="p">
    <verse number="10" style="v"/>അധികന്തു ഹേ ഭ്രാതരഃ, യൂയം പ്രഭുനാ തസ്യ വിക്രമയുക്തശക്ത്യാ ച ബലവന്തോ ഭവത|</para>
  <para style="p">
    <verse number="11" style="v"/>യൂയം യത് ശയതാനശ്ഛലാനി നിവാരയിതും ശക്നുഥ തദർഥമ് ഈശ്വരീയസുസജ്ജാം പരിധദ്ധ്വം|</para>
  <para style="p">
    <verse number="12" style="v"/>യതഃ കേവലം രക്തമാംസാഭ്യാമ് ഇതി നഹി കിന്തു കർതൃത്വപരാക്രമയുക്തൈസ്തിമിരരാജ്യസ്യേഹലോകസ്യാധിപതിഭിഃ സ്വർഗോദ്ഭവൈ ർദുഷ്ടാത്മഭിരേവ സാർദ്ധമ് അസ്മാഭി ര്യുദ്ധം ക്രിയതേ|</para>
  <para style="p">
    <verse number="13" style="v"/>അതോ ഹേതോ ര്യൂയം യയാ സംകുेലേ ദിനേഽവസ്ഥാതും സർവ്വാണി പരാജിത്യ ദൃഢാഃ സ്ഥാതുഞ്ച ശക്ഷ്യഥ താമ് ഈശ്വരീയസുസജ്ജാം ഗൃഹ്ലീത|</para>
  <para style="p">
    <verse number="14" style="v"/>വസ്തുതസ്തു സത്യത്വേന ശൃങ്ഖലേന കടിം ബദ്ധ്വാ പുണ്യേന വർമ്മണാ വക്ഷ ആച്ഛാദ്യ</para>
  <para style="p">
    <verse number="15" style="v"/>ശാന്തേഃ സുവാർത്തയാ ജാതമ് ഉത്സാഹം പാദുകായുഗലം പദേ സമർപ്യ തിഷ്ഠത|</para>
  <para style="p">
    <verse number="16" style="v"/>യേന ച ദുഷ്ടാത്മനോഽഗ്നിബാണാൻ സർവ്വാൻ നിർവ്വാപയിതും ശക്ഷ്യഥ താദൃശം സർവ്വാച്ഛാദകം ഫലകം വിശ്വാസം ധാരയത|</para>
  <para style="p">
    <verse number="17" style="v"/>ശിരസ്ത്രം പരിത്രാണമ് ആത്മനഃ ഖങ്ഗഞ്ചേശ്വരസ്യ വാക്യം ധാരയത|</para>
  <para style="p">
    <verse number="18" style="v"/>സർവ്വസമയേ സർവ്വയാചനേന സർവ്വപ്രാർഥനേന ചാത്മനാ പ്രാർഥനാം കുരുധ്വം തദർഥം ദൃഢാകാങ്ക്ഷയാ ജാഗ്രതഃ സർവ്വേഷാം പവിത്രലോകാനാം കൃതേ സദാ പ്രാർഥനാം കുരുധ്വം|</para>
  <para style="p">
    <verse number="19" style="v"/>അഹഞ്ച യസ്യ സുസംവാദസ്യ ശൃങ്ഖലബദ്ധഃ പ്രചാരകദൂതോഽസ്മി തമ് ഉപയുക്തേനോത്സാഹേന പ്രചാരയിതും യഥാ ശക്നുയാം</para>
  <para style="p">
    <verse number="20" style="v"/>തഥാ നിർഭയേന സ്വരേണോത്സാഹേന ച സുസംവാദസ്യ നിഗൂഢവാക്യപ്രചാരായ വക്തൃाതാ യത് മഹ്യം ദീയതേ തദർഥം മമാപി കൃതേ പ്രാർഥനാം കുരുധ്വം|</para>
  <para style="p">
    <verse number="21" style="v"/>അപരം മമ യാവസ്ഥാസ്തി യച്ച മയാ ക്രിയതേ തത് സർവ്വം യദ് യുഷ്മാഭി ർജ്ഞായതേ തദർഥം പ്രഭുനാ പ്രിയഭ്രാതാ വിശ്വാസ്യഃ പരിചാരകശ്ച തുഖികോ യുഷ്മാൻ തത് ജ്ഞാപയിഷ്യതി|</para>
  <para style="p">
    <verse number="22" style="v"/>യൂയം യദ് അസ്മാകമ് അവസ്ഥാം ജാനീഥ യുഷ്മാകം മനാംസി ച യത് സാന്ത്വനാം ലഭന്തേ തദർഥമേവാഹം യുഷ്മാകം സന്നിധിം തം പ്രേഷിതവാന|</para>
  <para style="p">
    <verse number="23" style="v"/>അപരമ് ഈശ്വരഃ പ്രഭു ര്യീശുഖ്രീഷ്ടശ്ച സർവ്വേഭ്യോ ഭ്രാതൃഭ്യഃ ശാന്തിം വിശ്വാസസഹിതം പ്രേമ ച ദേയാത്|</para>
  <para style="p">
    <verse number="24" style="v"/>യേ കേചിത് പ്രഭൗ യീശുഖ്രീഷ്ടേഽക്ഷയം പ്രേമ കുർവ്വന്തി താൻ പ്രതി പ്രസാദോ ഭൂയാത്| തഥാസ്തു|</para>
</usx>
