<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1TI" style="id">Sanskrit Bible (NT) in Malayalam Script (സത്യവേദഃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 Timothy</para>
  <para style="toc1">1 തീമഥിയം പത്രം</para>
  <para style="toc2">1 തീമഥിയഃ</para>
  <para style="toc3">1 തീമഥിയഃ</para>
  <para style="mt1">1 തീമഥിയം പത്രം</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അസ്മാകം ത്രാണകർത്തുരീശ്വരസ്യാസ്മാകം പ്രത്യാശാഭൂമേഃ പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യ ചാജ്ഞാനുസാരതോ യീശുഖ്രീഷ്ടസ്യ പ്രേരിതഃ പൗലഃ സ്വകീയം സത്യം ധർമ്മപുത്രം തീമഥിയം പ്രതി പത്രം ലിഖതി|</para>
  <para style="p">
    <verse number="2" style="v"/>അസ്മാകം താത ഈശ്വരോഽസ്മാകം പ്രഭു ര്യീശുഖ്രീഷ്ടശ്ച ത്വയി അനുഗ്രഹം ദയാം ശാന്തിഞ്ച കുര്യ്യാസ്താം|</para>
  <para style="p">
    <verse number="3" style="v"/>മാകിദനിയാദേശേ മമ ഗമനകാലേ ത്വമ് ഇഫിഷനഗരേ തിഷ്ഠൻ ഇതരശിക്ഷാ ന ഗ്രഹീതവ്യാ, അനന്തേഷൂപാഖ്യാനേഷു വംശാവലിഷു ച യുഷ്മാഭി ർമനോ ന നിവേശിതവ്യമ്</para>
  <para style="p">
    <verse number="4" style="v"/>ഇതി കാംശ്ചിത് ലോകാൻ യദ് ഉപദിശേരേതത് മയാദിഷ്ടോഽഭവഃ, യതഃ സർവ്വൈരേതൈ ർവിശ്വാസയുക്തേശ്വരീയനിഷ്ഠാ ന ജായതേ കിന്തു വിവാദോ ജായതേ|</para>
  <para style="p">
    <verse number="5" style="v"/>ഉപദേശസ്യ ത്വഭിപ്രേതം ഫലം നിർമ്മലാന്തഃകരണേന സത്സംവേദേന നിഷ്കപടവിശ്വാസേന ച യുക്തം പ്രേമ|</para>
  <para style="p">
    <verse number="6" style="v"/>കേചിത് ജനാശ്ച സർവ്വാണ്യേതാനി വിഹായ നിരർഥകകഥാനാമ് അനുഗമനേന വിപഥഗാമിനോഽഭവൻ,</para>
  <para style="p">
    <verse number="7" style="v"/>യദ് ഭാഷന്തേ യച്ച നിശ്ചിന്വന്തി തന്ന ബുധ്യമാനാ വ്യവസ്ഥോപദേഷ്ടാരോ ഭവിതുമ് ഇച്ഛന്തി|</para>
  <para style="p">
    <verse number="8" style="v"/>സാ വ്യവസ്ഥാ യദി യോഗ്യരൂപേണ ഗൃഹ്യതേ തർഹ്യുത്തമാ ഭവതീതി വയം ജാനീമഃ|</para>
  <para style="p">
    <verse number="9" style="v"/>അപരം സാ വ്യവസ്ഥാ ധാർമ്മികസ്യ വിരുദ്ധാ ന ഭവതി കിന്ത്വധാർമ്മികോ ഽവാധ്യോ ദുഷ്ടഃ പാപിഷ്ഠോ ഽപവിത്രോ ഽശുചിഃ പിതൃഹന്താ മാതൃഹന്താ നരഹന്താ</para>
  <para style="p">
    <verse number="10" style="v"/>വേശ്യാഗാമീ പുംമൈഥുനീ മനുഷ്യവിക്രേതാ മിഥ്യാവാദീ മിഥ്യാശപഥകാരീ ച സർവ്വേഷാമേതേഷാം വിരുദ്ധാ,</para>
  <para style="p">
    <verse number="11" style="v"/>തഥാ സച്ചിദാനന്ദേശ്വരസ്യ യോ വിഭവയുക്തഃ സുസംവാദോ മയി സമർപിതസ്തദനുയായിഹിതോപദേശസ്യ വിപരീതം യത് കിഞ്ചിദ് ഭവതി തദ്വിരുദ്ധാ സാ വ്യവസ്ഥേതി തദ്ഗ്രാഹിണാ ജ്ഞാതവ്യം|</para>
  <para style="p">
    <verse number="12" style="v"/>മഹ്യം ശക്തിദാതാ യോഽസ്മാകം പ്രഭുഃ ഖ്രീഷ്ടയീശുസ്തമഹം ധന്യം വദാമി|</para>
  <para style="p">
    <verse number="13" style="v"/>യതഃ പുരാ നിന്ദക ഉപദ്രാവീ ഹിംസകശ്ച ഭൂത്വാപ്യഹം തേന വിശ്വാസ്യോ ഽമന്യേ പരിചാരകത്വേ ന്യയുജ്യേ ച| തദ് അവിശ്വാസാചരണമ് അജ്ഞാനേന മയാ കൃതമിതി ഹേതോരഹം തേനാനുകമ്പിതോഽഭവം|</para>
  <para style="p">
    <verse number="14" style="v"/>അപരം ഖ്രീഷ്ടേ യീശൗ വിശ്വാസപ്രേമഭ്യാം സഹിതോഽസ്മത്പ്രഭോരനുഗ്രഹോ ഽതീവ പ്രചുരോഽഭത്|</para>
  <para style="p">
    <verse number="15" style="v"/>പാപിനഃ പരിത്രാതും ഖ്രീഷ്ടോ യീശു ർജഗതി സമവതീർണോഽഭവത്, ഏഷാ കഥാ വിശ്വാസനീയാ സർവ്വൈ ഗ്രഹണീയാ ച|</para>
  <para style="p">
    <verse number="16" style="v"/>തേഷാം പാപിനാം മധ്യേഽഹം പ്രഥമ ആസം കിന്തു യേ മാനവാ അനന്തജീവനപ്രാപ്ത്യർഥം തസ്മിൻ വിശ്വസിഷ്യന്തി തേഷാം ദൃഷ്ടാന്തേ മയി പ്രഥമേ യീശുനാ ഖ്രീഷ്ടേന സ്വകീയാ കൃത്സ്നാ ചിരസഹിഷ്ണുതാ യത് പ്രകാശ്യതേ തദർഥമേവാഹമ് അനുകമ്പാം പ്രാപ്തവാൻ|</para>
  <para style="p">
    <verse number="17" style="v"/>അനാദിരക്ഷയോഽദൃശ്യോ രാജാ യോഽദ്വിതീയഃ സർവ്വജ്ഞ ഈശ്വരസ്തസ്യ ഗൗരവം മഹിമാ ചാനന്തകാലം യാവദ് ഭൂയാത്| ആമേൻ|</para>
  <para style="p">
    <verse number="18" style="v"/>ഹേ പുത്ര തീമഥിയ ത്വയി യാനി ഭവിഷ്യദ്വാക്യാനി പുരാ കഥിതാനി തദനുസാരാദ് അഹമ് ഏനമാദേശം ത്വയി സമർപയാമി, തസ്യാഭിപ്രായോഽയം യത്ത്വം തൈ ർവാക്യൈരുത്തമയുദ്ധം കരോഷി</para>
  <para style="p">
    <verse number="19" style="v"/>വിശ്വാസം സത്സംവേദഞ്ച ധാരയസി ച| അനയോഃ പരിത്യാഗാത് കേഷാഞ്ചിദ് വിശ്വാസതരീ ഭഗ്നാഭവത്|</para>
  <para style="p">
    <verse number="20" style="v"/>ഹുമിനായസികന്ദരൗ തേഷാം യൗ ദ്വൗ ജനൗ, തൗ യദ് ധർമ്മനിന്ദാം പുന ർന കർത്തും ശിക്ഷേതേ തദർഥം മയാ ശയതാനസ്യ കരേ സമർപിതൗ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>മമ പ്രഥമ ആദേശോഽയം, പ്രാർഥനാവിനയനിവേദനധന്യവാദാഃ കർത്തവ്യാഃ,</para>
  <para style="p">
    <verse number="2" style="v"/>സർവ്വേഷാം മാനവാനാം കൃതേ വിശേഷതോ വയം യത് ശാന്തത്വേന നിർവ്വിരോധത്വേന ചേശ്ചരഭക്തിം വിനീതത്വഞ്ചാചരന്തഃ കാലം യാപയാമസ്തദർഥം നൃപതീനാമ് ഉച്ചപദസ്ഥാനാഞ്ച കൃതേ തേ കർത്തവ്യാഃ|</para>
  <para style="p">
    <verse number="3" style="v"/>യതോഽസ്മാകം താരകസ്യേശ്വരസ്യ സാക്ഷാത് തദേവോത്തമം ഗ്രാഹ്യഞ്ച ഭവതി,</para>
  <para style="p">
    <verse number="4" style="v"/>സ സർവ്വേഷാം മാനവാനാം പരിത്രാണം സത്യജ്ഞാനപ്രാപ്തിഞ്ചേച്ഛതി|</para>
  <para style="p">
    <verse number="5" style="v"/>യത ഏകോഽദ്വിതീയ ഈശ്വരോ വിദ്യതേ കിഞ്ചേശ്വരേ മാനവേഷു ചൈകോ ഽദ്വിതീയോ മധ്യസ്ഥഃ</para>
  <para style="p">
    <verse number="6" style="v"/>സ നരാവതാരഃ ഖ്രീഷ്ടോ യീശു ർവിദ്യതേ യഃ സർവ്വേഷാം മുക്തേ ർമൂല്യമ് ആത്മദാനം കൃതവാൻ| ഏതേന യേന പ്രമാണേനോപയുക്തേ സമയേ പ്രകാശിതവ്യം,</para>
  <para style="p">
    <verse number="7" style="v"/>തദ്ഘോഷയിതാ ദൂതോ വിശ്വാസേ സത്യധർമ്മേ ച ഭിന്നജാതീയാനാമ് ഉപദേശകശ്ചാഹം ന്യയൂജ്യേ, ഏതദഹം ഖ്രീഷ്ടസ്യ നാമ്നാ യഥാതഥ്യം വദാമി നാനൃതം കഥയാമി|</para>
  <para style="p">
    <verse number="8" style="v"/>അതോ മമാഭിമതമിദം പുരുഷൈഃ ക്രോധസന്ദേഹൗ വിനാ പവിത്രകരാൻ ഉത്തോല്യ സർവ്വസ്മിൻ സ്ഥാനേ പ്രാർഥനാ ക്രിയതാം|</para>
  <para style="p">
    <verse number="9" style="v"/>തദ്വത് നാര്യ്യോഽപി സലജ്ജാഃ സംയതമനസശ്ച സത്യോ യോഗ്യമാച്ഛാദനം പരിദധതു കിഞ്ച കേശസംസ്കാരൈഃ കണകമുക്താഭി ർമഹാർഘ്യപരിച്ഛദൈശ്ചാത്മഭൂഷണം ന കുർവ്വത്യഃ</para>
  <para style="p">
    <verse number="10" style="v"/>സ്വീകൃതേശ്വരഭക്തീനാം യോഷിതാം യോഗ്യൈഃ സത്യർമ്മഭിഃ സ്വഭൂഷണം കുർവ്വതാം|</para>
  <para style="p">
    <verse number="11" style="v"/>നാരീ സമ്പൂർണവിനീതത്വേന നിർവിരോധം ശിക്ഷതാം|</para>
  <para style="p">
    <verse number="12" style="v"/>നാര്യ്യാഃ ശിക്ഷാദാനം പുരുഷായാജ്ഞാദാനം വാഹം നാനുജാനാമി തയാ നിർവ്വിരോेധത്വമ് ആചരിതവ്യം|</para>
  <para style="p">
    <verse number="13" style="v"/>യതഃ പ്രഥമമ് ആദമസ്തതഃ പരം ഹവായാഃ സൃഷ്ടി ർബഭൂവ|</para>
  <para style="p">
    <verse number="14" style="v"/>കിഞ്ചാദമ് ഭ്രാന്തിയുക്തോ നാഭവത് യോഷിദേവ ഭ്രാന്തിയുക്താ ഭൂത്വാത്യാചാരിണീ ബഭൂവ|</para>
  <para style="p">
    <verse number="15" style="v"/>തഥാപി നാരീഗണോ യദി വിശ്വാസേ പ്രേമ്നി പവിത്രതായാം സംയതമനസി ച തിഷ്ഠതി തർഹ്യപത്യപ്രസവവർത്മനാ പരിത്രാണം പ്രാപ്സ്യതി|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>യദി കശ്ചിദ് അധ്യക്ഷപദമ് ആകാങ്ക്ഷതേ തർഹി സ ഉത്തമം കർമ്മ ലിപ്സത ഇതി സത്യം|</para>
  <para style="p">
    <verse number="2" style="v"/>അതോഽധ്യക്ഷേണാനിന്ദിതേനൈകസ്യാ യോഷിതോ ഭർത്രാ പരിമിതഭോഗേന സംയതമനസാ സഭ്യേനാതിഥിസേവകേന ശിക്ഷണേ നിപുണേന</para>
  <para style="p">
    <verse number="3" style="v"/>ന മദ്യപേന ന പ്രഹാരകേണ കിന്തു മൃദുഭാവേന നിർവ്വിവാദേന നിർലോഭേന</para>
  <para style="p">
    <verse number="4" style="v"/>സ്വപരിവാരാണാമ് ഉത്തമശാസകേന പൂർണവിനീതത്വാദ് വശ്യാനാം സന്താനാനാം നിയന്ത്രാ ച ഭവിതവ്യം|</para>
  <para style="p">
    <verse number="5" style="v"/>യത ആത്മപരിവാരാൻ ശാസിതും യോ ന ശക്നോതി തേനേശ്വരസ്യ സമിതേസ്തത്ത്വാവധാരണം കഥം കാരിഷ്യതേ?</para>
  <para style="p">
    <verse number="6" style="v"/>അപരം സ ഗർവ്വിതോ ഭൂത്വാ യത് ശയതാന ഇവ ദണ്ഡയോഗ്യോ ന ഭവേത് തദർഥം തേന നവശിഷ്യേണ ന ഭവിതവ്യം|</para>
  <para style="p">
    <verse number="7" style="v"/>യച്ച നിന്ദായാം ശയതാനസ്യ ജാലേ ച ന പതേത് തദർഥം തേന ബഹിഃസ്ഥലോകാനാമപി മധ്യേ സുഖ്യാതിയുക്തേന ഭവിതവ്യം|</para>
  <para style="p">
    <verse number="8" style="v"/>തദ്വത് പരിചാരകൈരപി വിനീതൈ ർദ്വിവിധവാക്യരഹിതൈ ർബഹുമദ്യപാനേ ഽനാസക്തൈ ർനിർലോഭൈശ്ച ഭവിതവ്യം,</para>
  <para style="p">
    <verse number="9" style="v"/>നിർമ്മലസംവേദേന ച വിശ്വാസസ്യ നിഗൂഢവാക്യം ധാതിവ്യഞ്ച|</para>
  <para style="p">
    <verse number="10" style="v"/>അഗ്രേ തേഷാം പരീക്ഷാ ക്രിയതാം തതഃ പരമ് അനിന്ദിതാ ഭൂത്വാ തേ പരിചര്യ്യാം കുർവ്വന്തു|</para>
  <para style="p">
    <verse number="11" style="v"/>അപരം യോഷിദ്ഭിരപി വിനീതാഭിരനപവാദികാഭിഃ സതർകാഭിഃ സർവ്വത്ര വിശ്വാസ്യാഭിശ്ച ഭവിതവ്യം|</para>
  <para style="p">
    <verse number="12" style="v"/>പരിചാരകാ ഏകൈകയോഷിതോ ഭർത്താരോ ഭവേയുഃ, നിജസന്താനാനാം പരിജനാനാഞ്ച സുശാസനം കുര്യ്യുശ്ച|</para>
  <para style="p">
    <verse number="13" style="v"/>യതഃ സാ പരിചര്യ്യാ യൈ ർഭദ്രരൂപേണ സാധ്യതേ തേ ശ്രേഷ്ഠപദം പ്രാപ്നുവന്തി ഖ്രീഷ്ടേ യീശൗ വിശ്വാസേന മഹോത്സുകാ ഭവന്തി ച|</para>
  <para style="p">
    <verse number="14" style="v"/>ത്വാം പ്രത്യേതത്പത്രലേഖനസമയേ ശീഘ്രം ത്വത്സമീപഗമനസ്യ പ്രത്യാശാ മമ വിദ്യതേ|</para>
  <para style="p">
    <verse number="15" style="v"/>യദി വാ വിലമ്ബേയ തർഹീശ്വരസ്യ ഗൃഹേ ഽർഥതഃ സത്യധർമ്മസ്യ സ്തമ്ഭഭിത്തിമൂലസ്വരൂപായാമ് അമരേശ്വരസ്യ സമിതൗ ത്വയാ കീദൃശ ആചാരഃ കർത്തവ്യസ്തത് ജ്ഞാതും ശക്ഷ്യതേ|</para>
  <para style="p">
    <verse number="16" style="v"/>അപരം യസ്യ മഹത്ത്വം സർവ്വസ്വീകൃതമ് ഈശ്വരഭക്തേസ്തത് നിഗൂഢവാക്യമിദമ് ഈശ്വരോ മാനവദേഹേ പ്രകാശിത ആത്മനാ സപുണ്യീകൃതോ ദൂതൈഃ സന്ദൃഷ്ടഃ സർവ്വജാതീയാനാം നികടേ ഘോഷിതോ ജഗതോ വിശ്വാസപാത്രീഭൂതസ്തേജഃപ്രാപ്തയേ സ്വർഗം നീതശ്ചേതി|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>പവിത്ര ആത്മാ സ്പഷ്ടമ് ഇദം വാക്യം വദതി ചരമകാലേ കതിപയലോകാ വഹ്നിനാങ്കിതത്വാത്</para>
  <para style="p">
    <verse number="2" style="v"/>കഠോരമനസാം കാപട്യാദ് അനൃതവാദിനാം വിവാഹനിഷേധകാനാം ഭക്ഷ്യവിശേഷനിഷേധകാനാഞ്ച</para>
  <para style="p">
    <verse number="3" style="v"/>ഭൂതസ്വരൂപാണാം ശിക്ഷായാം ഭ്രമകാത്മനാം വാക്യേഷു ച മനാംസി നിവേശ്യ ധർമ്മാദ് ഭ്രംശിഷ്യന്തേ| താനി തു ഭക്ഷ്യാണി വിശ്വാസിനാം സ്വീകൃതസത്യധർമ്മാണാഞ്ച ധന്യവാദസഹിതായ ഭോഗായേശ്വരേണ സസൃജിരേ|</para>
  <para style="p">
    <verse number="4" style="v"/>യത ഈശ്വരേണ യദ്യത് സൃഷ്ടം തത് സർവ്വമ് ഉത്തമം യദി ച ധന്യവാദേന ഭുജ്യതേ തർഹി തസ്യ കിമപി നാഗ്രാഹ്യം ഭവതി,</para>
  <para style="p">
    <verse number="5" style="v"/>യത ഈശ്വരസ്യ വാക്യേന പ്രാർഥനയാ ച തത് പവിത്രീഭവതി|</para>
  <para style="p">
    <verse number="6" style="v"/>ഏതാനി വാക്യാനി യദി ത്വം ഭ്രാതൃൻ ജ്ഞാപയേസ്തർഹി യീശുഖ്രീഷ്ടസ്യോത്തമ്ഃ പരിചാരകോ ഭവിഷ്യസി യോ വിശ്വാസോ ഹിതോപദേശശ്ച ത്വയാ ഗൃഹീതസ്തദീയവാക്യൈരാപ്യായിഷ്യസേ ച|</para>
  <para style="p">
    <verse number="7" style="v"/>യാന്യുപാഖ്യാനാനി ദുർഭാവാനി വൃദ്ധയോഷിതാമേവ യോഗ്യാനി ച താനി ത്വയാ വിസൃജ്യന്താമ് ഈശ്വരഭക്തയേ യത്നഃ ക്രിയതാഞ്ച|</para>
  <para style="p">
    <verse number="8" style="v"/>യതഃ ശാരീരികോ യത്നഃ സ്വൽപഫലദോ ഭവതി കിന്ത്വീശ്വരഭക്തിരൈഹികപാരത്രികജീവനയോഃ പ്രതിജ്ഞായുക്താ സതീ സർവ്വത്ര ഫലദാ ഭവതി|</para>
  <para style="p">
    <verse number="9" style="v"/>വാക്യമേതദ് വിശ്വസനീയം സർവ്വൈ ർഗ്രഹണീയഞ്ച വയഞ്ച തദർഥമേവ ശ്രാമ്യാമോ നിന്ദാം ഭുംജ്മഹേ ച|</para>
  <para style="p">
    <verse number="10" style="v"/>യതോ ഹേതോഃ സർവ്വമാനവാനാം വിശേഷതോ വിശ്വാസിനാം ത്രാതാ യോഽമര ഈശ്വരസ്തസ്മിൻ വയം വിശ്വസാമഃ|</para>
  <para style="p">
    <verse number="11" style="v"/>ത്വമ് ഏതാനി വാക്യാനി പ്രചാരയ സമുപദിശ ച|</para>
  <para style="p">
    <verse number="12" style="v"/>അൽപവയഷ്കത്വാത് കേനാപ്യവജ്ഞേയോ ന ഭവ കിന്ത്വാലാപേനാചരണേന പ്രേമ്നാ സദാത്മത്വേന വിശ്വാസേന ശുചിത്വേന ച വിശ്വാസിനാമ് ആദർശോ ഭവ|</para>
  <para style="p">
    <verse number="13" style="v"/>യാവന്നാഹമ് ആഗമിഷ്യാമി താവത് ത്വ പാഠേ ചേതയനേ ഉപദേശേ ച മനോ നിധത്സ്വ|</para>
  <para style="p">
    <verse number="14" style="v"/>പ്രാചീനഗണഹസ്താർപണസഹിതേന ഭവിഷ്യദ്വാക്യേന യദ്ദാനം തുഭ്യം വിശ്രാണിതം തവാന്തഃസ്ഥേ തസ്മിൻ ദാനേ ശിഥിലമനാ മാ ഭവ|</para>
  <para style="p">
    <verse number="15" style="v"/>ഏതേഷു മനോ നിവേശയ, ഏതേഷു വർത്തസ്വ, ഇത്ഥഞ്ച സർവ്വവിഷയേ തവ ഗുണവൃദ്ധിഃ പ്രകാശതാം|</para>
  <para style="p">
    <verse number="16" style="v"/>സ്വസ്മിൻ ഉപദേശേ ച സാവധാനോ ഭൂത്വാവതിഷ്ഠസ്വ തത് കൃത്വാ ത്വയാത്മപരിത്രാണം ശ്രോതൃണാഞ്ച പരിത്രാണം സാധയിഷ്യതേ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ത്വം പ്രാചീനം ന ഭർത്സയ കിന്തു തം പിതരമിവ യൂനശ്ച ഭ്രാതൃനിവ</para>
  <para style="p">
    <verse number="2" style="v"/>വൃദ്ധാഃ സ്ത്രിയശ്ച മാതൃനിവ യുവതീശ്ച പൂർണശുചിത്വേന ഭഗിനീരിവ വിനയസ്വ|</para>
  <para style="p">
    <verse number="3" style="v"/>അപരം സത്യവിധവാഃ സമ്മന്യസ്വ|</para>
  <para style="p">
    <verse number="4" style="v"/>കസ്യാശ്ചിദ് വിധവായാ യദി പുത്രാഃ പൗത്രാ വാ വിദ്യന്തേ തർഹി തേ പ്രഥമതഃ സ്വീയപരിജനാൻ സേവിതും പിത്രോഃ പ്രത്യുപകർത്തുഞ്ച ശിക്ഷന്താം യതസ്തദേവേശ്വരസ്യ സാക്ഷാദ് ഉത്തമം ഗ്രാഹ്യഞ്ച കർമ്മ|</para>
  <para style="p">
    <verse number="5" style="v"/>അപരം യാ നാരീ സത്യവിധവാ നാഥഹീനാ ചാസ്തി സാ ഈശ്വരസ്യാശ്രയേ തിഷ്ഠന്തീ ദിവാനിശം നിവേദനപ്രാർഥനാഭ്യാം കാലം യാപയതി|</para>
  <para style="p">
    <verse number="6" style="v"/>കിന്തു യാ വിധവാ സുഖഭോഗാസക്താ സാ ജീവത്യപി മൃതാ ഭവതി|</para>
  <para style="p">
    <verse number="7" style="v"/>അതഏവ താ യദ് അനിന്ദിതാ ഭവേയൂസ്തദർഥമ് ഏതാനി ത്വയാ നിദിശ്യന്താം|</para>
  <para style="p">
    <verse number="8" style="v"/>യദി കശ്ചിത് സ്വജാതീയാൻ ലോകാൻ വിശേഷതഃ സ്വീയപരിജനാൻ ന പാലയതി തർഹി സ വിശ്വാസാദ് ഭ്രഷ്ടോ ഽപ്യധമശ്ച ഭവതി|</para>
  <para style="p">
    <verse number="9" style="v"/>വിധവാവർഗേ യസ്യാ ഗണനാ ഭവതി തയാ ഷഷ്ടിവത്സരേഭ്യോ ന്യൂനവയസ്കയാ ന ഭവിതവ്യം; അപരം പൂർവ്വമ് ഏകസ്വാമികാ ഭൂത്വാ</para>
  <para style="p">
    <verse number="10" style="v"/>സാ യത് ശിശുപോഷണേനാതിഥിസേവനേന പവിത്രലോകാനാം ചരണപ്രക്ഷാലനേന ക്ലിഷ്ടാനാമ് ഉപകാരേണ സർവ്വവിധസത്കർമ്മാചരണേന ച സത്കർമ്മകരണാത് സുഖ്യാതിപ്രാപ്താ ഭവേത് തദപ്യാവശ്യകം|</para>
  <para style="p">
    <verse number="11" style="v"/>കിന്തു യുവതീ ർവിധവാ ന ഗൃഹാണ യതഃ ഖ്രീഷ്ടസ്യ വൈപരീത്യേന താസാം ദർപേ ജാതേ താ വിവാഹമ് ഇച്ഛന്തി|</para>
  <para style="p">
    <verse number="12" style="v"/>തസ്മാച്ച പൂർവ്വധർമ്മം പരിത്യജ്യ ദണ്ഡനീയാ ഭവന്തി|</para>
  <para style="p">
    <verse number="13" style="v"/>അനന്തരം താ ഗൃഹാദ് ഗൃഹം പര്യ്യടന്ത്യ ആലസ്യം ശിക്ഷന്തേ കേവലമാലസ്യം നഹി കിന്ത്വനർഥകാലാപം പരാധികാരചർച്ചാഞ്ചാപി ശിക്ഷമാണാ അനുചിതാനി വാക്യാനി ഭാഷന്തേ|</para>
  <para style="p">
    <verse number="14" style="v"/>അതോ മമേച്ഛേയം യുവത്യോ വിധവാ വിവാഹം കുർവ്വതാമ് അപത്യവത്യോ ഭവന്തു ഗൃഹകർമ്മ കുർവ്വതാഞ്ചേത്ഥം വിപക്ഷായ കിമപി നിന്ദാദ്വാരം ന ദദതു|</para>
  <para style="p">
    <verse number="15" style="v"/>യത ഇതഃ പൂർവ്വമ് അപി കാശ്ചിത് ശയതാനസ്യ പശ്ചാദ്ഗാമിന്യോ ജാതാഃ|</para>
  <para style="p">
    <verse number="16" style="v"/>അപരം വിശ്വാസിന്യാ വിശ്വാസിനോ വാ കസ്യാപി പരിവാരാണാം മധ്യേ യദി വിധവാ വിദ്യന്തേ തർഹി സ താഃ പ്രതിപാലയതു തസ്മാത് സമിതൗ ഭാരേ ഽനാരോപിതേ സത്യവിധവാനാം പ്രതിപാലനം കർത്തും തയാ ശക്യതേ|</para>
  <para style="p">
    <verse number="17" style="v"/>യേ പ്രാഞ്ചഃ സമിതിം സമ്യഗ് അധിതിഷ്ഠന്തി വിശേഷത ഈശ്വരവാക്യേനോപദേശേന ച യേ യത്നം വിദധതേ തേ ദ്വിഗുണസ്യാദരസ്യ യോഗ്യാ മാന്യന്താം|</para>
  <para style="p">
    <verse number="18" style="v"/>യസ്മാത് ശാസ്ത്രേ ലിഖിതമിദമാസ്തേ, ത്വം ശസ്യമർദ്ദകവൃഷസ്യാസ്യം മാ ബധാനേതി, അപരമപി കാര്യ്യകൃദ് വേതനസ്യ യോഗ്യോ ഭവതീതി|</para>
  <para style="p">
    <verse number="19" style="v"/>ദ്വൗ ത്രീൻ വാ സാക്ഷിണോ വിനാ കസ്യാചിത് പ്രാചീനസ്യ വിരുദ്ധമ് അഭിയോഗസ്ത്വയാ ന ഗൃഹ്യതാം|</para>
  <para style="p">
    <verse number="20" style="v"/>അപരം യേ പാപമാചരന്തി താൻ സർവ്വേഷാം സമക്ഷം ഭർത്സയസ്വ തേനാപരേഷാമപി ഭീതി ർജനിഷ്യതേ|</para>
  <para style="p">
    <verse number="21" style="v"/>അഹമ് ഈശ്വരസ്യ പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യ മനോനീതദിവ്യദൂതാനാഞ്ച ഗോചരേ ത്വാമ് ഇദമ് ആജ്ഞാപയാമി ത്വം കസ്യാപ്യനുരോധേന കിമപി ന കുർവ്വന വിനാപക്ഷപാതമ് ഏതാന വിധീൻ പാലയ|</para>
  <para style="p">
    <verse number="22" style="v"/>കസ്യാപി മൂർദ്ധി ഹസ്താപർണം ത്വരയാ മാകാർഷീഃ| പരപാപാനാഞ്ചാംശീ മാ ഭവ| സ്വം ശുചിം രക്ഷ|</para>
  <para style="p">
    <verse number="23" style="v"/>അപരം തവോദരപീഡായാഃ പുനഃ പുന ദുർബ്ബലതായാശ്ച നിമിത്തം കേവലം തോയം ന പിവൻ കിഞ്ചിൻ മദ്യം പിവ|</para>
  <para style="p">
    <verse number="24" style="v"/>കേഷാഞ്ചിത് മാനവാനാം പാപാനി വിചാരാത് പൂർവ്വം കേഷാഞ്ചിത് പശ്ചാത് പ്രകാശന്തേ|</para>
  <para style="p">
    <verse number="25" style="v"/>തഥൈവ സത്കർമ്മാണ്യപി പ്രകാശന്തേ തദന്യഥാ സതി പ്രച്ഛന്നാനി സ്ഥാതും ന ശക്നുവന്തി|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>യാവന്തോ ലോകാ യുഗധാരിണോ ദാസാഃ സന്തി തേ സ്വസ്വസ്വാമിനം പൂർണസമാദരയോഗ്യം മന്യന്താം നോ ചേദ് ഈശ്വരസ്യ നാമ്ന ഉപദേശസ്യ ച നിന്ദാ സമ്ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="2" style="v"/>യേഷാഞ്ച സ്വാമിനോ വിശ്വാസിനഃ ഭവന്തി തൈസ്തേ ഭ്രാതൃത്വാത് നാവജ്ഞേയാഃ കിന്തു തേ കർമ്മഫലഭോഗിനോ വിശ്വാസിനഃ പ്രിയാശ്ച ഭവന്തീതി ഹേതോഃ സേവനീയാ ഏവ, ത്വമ് ഏതാനി ശിക്ഷയ സമുപദിശ ച|</para>
  <para style="p">
    <verse number="3" style="v"/>യഃ കശ്ചിദ് ഇതരശിക്ഷാം കരോതി, അസ്മാകം പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യ ഹിതവാക്യാനീശ്വരഭക്തേ ര്യോഗ്യാം ശിക്ഷാഞ്ച ന സ്വീകരോതി</para>
  <para style="p">
    <verse number="4" style="v"/>സ ദർപധ്മാതഃ സർവ്വഥാ ജ്ഞാനഹീനശ്ച വിവാദൈ ർവാഗ്യുദ്ധൈശ്ച രോഗയുക്തശ്ച ഭവതി|</para>
  <para style="p">
    <verse number="5" style="v"/>താദൃശാദ് ഭാവാദ് ഈർഷ്യാവിരോധാപവാദദുഷ്ടാസൂയാ ഭ്രഷ്ടമനസാം സത്യജ്ഞാനഹീനാനാമ് ഈശ്വരഭക്തിം ലാഭോപായമ് ഇവ മന്യമാനാനാം ലോകാനാം വിവാദാശ്ച ജായന്തേ താദൃശേഭ്യോ ലോകേഭ്യസ്ത്വം പൃഥക് തിഷ്ഠ|</para>
  <para style="p">
    <verse number="6" style="v"/>സംയതേച്ഛയാ യുക്താ യേശ്വരഭക്തിഃ സാ മഹാലാഭോപായോ ഭവതീതി സത്യം|</para>
  <para style="p">
    <verse number="7" style="v"/>ഏതജ്ജഗത്പ്രവേശനകാലേഽസ്മാഭിഃ കിമപി നാനായി തത്തയജനകാലേഽപി കിമപി നേതും ന ശക്ഷ്യത ഇതി നിശ്ചിതം|</para>
  <para style="p">
    <verse number="8" style="v"/>അതഏവ ഖാദ്യാന്യാച്ഛാദനാനി ച പ്രാപ്യാസ്മാഭിഃ സന്തുഷ്ടൈ ർഭവിതവ്യം|</para>
  <para style="p">
    <verse number="9" style="v"/>യേ തു ധനിനോ ഭവിതും ചേഷ്ടന്തേ തേ പരീക്ഷായാമ് ഉന്മാഥേ പതന്തി യേ ചാഭിലാഷാ മാനവാൻ വിനാശേ നരകേ ച മജ്ജയന്തി താദൃശേഷ്വജ്ഞാനാഹിതാഭിലാഷേഷ്വപി പതന്തി|</para>
  <para style="p">
    <verse number="10" style="v"/>യതോഽർഥസ്പൃഹാ സർവ്വേഷാം ദുരിതാനാം മൂലം ഭവതി താമവലമ്ബ്യ കേചിദ് വിശ്വാസാദ് അഭ്രംശന്ത നാനാക്ലേശൈശ്ച സ്വാൻ അവിധ്യൻ|</para>
  <para style="p">
    <verse number="11" style="v"/>ഹേ ഈശ്വരസ്യ ലോക ത്വമ് ഏതേഭ്യഃ പലായ്യ ധർമ്മ ഈശ്വരഭക്തി ർവിശ്വാസഃ പ്രേമ സഹിഷ്ണുതാ ക്ഷാന്തിശ്ചൈതാന്യാചര|</para>
  <para style="p">
    <verse number="12" style="v"/>വിശ്വാസരൂപമ് ഉത്തമയുദ്ധം കുരു, അനന്തജീവനമ് ആലമ്ബസ്വ യതസ്തദർഥം ത്വമ് ആഹൂതോ ഽഭവഃ, ബഹുസാക്ഷിണാം സമക്ഷഞ്ചോത്തമാം പ്രതിജ്ഞാം സ്വീകൃതവാൻ|</para>
  <para style="p">
    <verse number="13" style="v"/>അപരം സർവ്വേഷാം ജീവയിതുരീശ്വരസ്യ സാക്ഷാദ് യശ്ച ഖ്രീഷ്ടോ യീശുഃ പന്തീയപീലാതസ്യ സമക്ഷമ് ഉത്തമാം പ്രതിജ്ഞാം സ്വീകൃതവാൻ തസ്യ സാക്ഷാദ് അഹം ത്വാമ് ഇദമ് ആജ്ഞാപയാമി|</para>
  <para style="p">
    <verse number="14" style="v"/>ഈശ്വരേണ സ്വസമയേ പ്രകാശിതവ്യമ് അസ്മാകം പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യാഗമനം യാവത് ത്വയാ നിഷ്കലങ്കത്വേന നിർദ്ദോഷത്വേന ച വിധീ രക്ഷ്യതാം|</para>
  <para style="p">
    <verse number="15" style="v"/>സ ഈശ്വരഃ സച്ചിദാനന്ദഃ, അദ്വിതീയസമ്രാട്, രാജ്ഞാം രാജാ, പ്രഭൂനാം പ്രഭുഃ,</para>
  <para style="p">
    <verse number="16" style="v"/>അമരതായാ അദ്വിതീയ ആകരഃ, അഗമ്യതേജോനിവാസീ, മർത്ത്യാനാം കേനാപി ന ദൃഷ്ടഃ കേനാപി ന ദൃശ്യശ്ച| തസ്യ ഗൗരവപരാക്രമൗ സദാതനൗ ഭൂയാസ്താം| ആമേൻ|</para>
  <para style="p">
    <verse number="17" style="v"/>ഇഹലോകേ യേ ധനിനസ്തേ ചിത്തസമുന്നതിം ചപലേ ധനേ വിശ്വാസഞ്ച ന കുർവ്വതാം കിന്തു ഭോഗാർഥമ് അസ്മഭ്യം പ്രചുരത്വേന സർവ്വദാതാ</para>
  <para style="p">
    <verse number="18" style="v"/>യോഽമര ഈശ്വരസ്തസ്മിൻ വിശ്വസന്തു സദാചാരം കുർവ്വന്തു സത്കർമ്മധനേന ധനിനോ സുകലാ ദാതാരശ്ച ഭവന്തു,</para>
  <para style="p">
    <verse number="19" style="v"/>യഥാ ച സത്യം ജീവനം പാപ്നുയുസ്തഥാ പാരത്രികാമ് ഉത്തമസമ്പദം സഞ്ചിന്വന്ത്വേതി ത്വയാദിശ്യന്താം|</para>
  <para style="p">
    <verse number="20" style="v"/>ഹേ തീമഥിയ, ത്വമ് ഉപനിധിം ഗോപയ കാൽപനികവിദ്യായാ അപവിത്രം പ്രലാപം വിരോധോക്തിഞ്ച ത്യജ ച,</para>
  <para style="p">
    <verse number="21" style="v"/>യതഃ കതിപയാ ലോകാസ്താം വിദ്യാമവലമ്ബ്യ വിശ്വാസാദ് ഭ്രഷ്ടാ അഭവന| പ്രസാദസ്തവ സഹായോ ഭൂയാത്| ആമേൻ|</para>
</usx>
