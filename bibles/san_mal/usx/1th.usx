<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1TH" style="id">Sanskrit Bible (NT) in Malayalam Script (സത്യവേദഃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 Thessalonians</para>
  <para style="toc1">1 ഥിഷലനീകിനഃ പത്രം</para>
  <para style="toc2">1 ഥിഷലനീകിനഃ</para>
  <para style="toc3">1 ഥിഷലനീകിനഃ</para>
  <para style="mt1">1 ഥിഷലനീകിനഃ പത്രം</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>പൗലഃ സില്വാനസ്തീമഥിയശ്ച പിതുരീശ്വരസ്യ പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യ ചാശ്രയം പ്രാപ്താ ഥിഷലനീകീയസമിതിം പ്രതി പത്രം ലിഖന്തി| അസ്മാകം താത ഈശ്വരഃ പ്രഭു ര്യീശുഖ്രീഷ്ടശ്ച യുഷ്മാൻ പ്രത്യനുഗ്രഹം ശാന്തിഞ്ച ക്രിയാസ്താം|</para>
  <para style="p">
    <verse number="2" style="v"/>വയം സർവ്വേഷാം യുഷ്മാകം കൃതേ ഈശ്വരം ധന്യം വദാമഃ പ്രാർഥനാസമയേ യുഷ്മാകം നാമോച്ചാരയാമഃ,</para>
  <para style="p">
    <verse number="3" style="v"/>അസ്മാകം താതസ്യേശ്വരസ്യ സാക്ഷാത് പ്രഭൗ യീശുഖ്രീഷ്ടേ യുഷ്മാകം വിശ്വാസേന യത് കാര്യ്യം പ്രേമ്നാ യഃ പരിശ്രമഃ പ്രത്യാശയാ ച യാ തിതിക്ഷാ ജായതേ</para>
  <para style="p">
    <verse number="4" style="v"/>തത് സർവ്വം നിരന്തരം സ്മരാമശ്ച| ഹേ പിയഭ്രാതരഃ, യൂയമ് ഈശ്വരേണാഭിരുചിതാ ലോകാ ഇതി വയം ജാനീമഃ|</para>
  <para style="p">
    <verse number="5" style="v"/>യതോഽസ്മാകം സുസംവാദഃ കേവലശബ്ദേന യുഷ്മാൻ ന പ്രവിശ്യ ശക്ത്യാ പവിത്രേണാത്മനാ മഹോത്സാഹേന ച യുഷ്മാൻ പ്രാവിശത്| വയന്തു യുഷ്മാകം കൃതേ യുഷ്മന്മധ്യേ കീദൃശാ അഭവാമ തദ് യുഷ്മാഭി ർജ്ഞായതേ|</para>
  <para style="p">
    <verse number="6" style="v"/>യൂയമപി ബഹുക്ലേശഭോഗേന പവിത്രേണാത്മനാ ദത്തേനാനന്ദേന ച വാക്യം ഗൃഹീത്വാസ്മാകം പ്രഭോശ്ചാനുഗാമിനോഽഭവത|</para>
  <para style="p">
    <verse number="7" style="v"/>തേന മാകിദനിയാഖായാദേശയോ ര്യാവന്തോ വിശ്വാസിനോ ലോകാഃ സന്തി യൂയം തേഷാം സർവ്വേഷാം നിദർശനസ്വരൂപാ ജാതാഃ|</para>
  <para style="p">
    <verse number="8" style="v"/>യതോ യുഷ്മത്തഃ പ്രതിനാദിതയാ പ്രഭോ ർവാണ്യാ മാകിദനിയാഖായാദേശൗ വ്യാപ്തൗ കേവലമേതന്നഹി കിന്ത്വീശ്വരേ യുഷ്മാകം യോ വിശ്വാസസ്തസ്യ വാർത്താ സർവ്വത്രാശ്രാവി, തസ്മാത് തത്ര വാക്യകഥനമ് അസ്മാകം നിഷ്പ്രയോജനം|</para>
  <para style="p">
    <verse number="9" style="v"/>യതോ യുഷ്മന്മധ്യേ വയം കീദൃശം പ്രവേശം പ്രാപ്താ യൂയഞ്ച കഥം പ്രതിമാ വിഹായേശ്വരം പ്രത്യാവർത്തധ്വമ് അമരം സത്യമീശ്വരം സേവിതും</para>
  <para style="p">
    <verse number="10" style="v"/>മൃതഗണമധ്യാച്ച തേനോത്ഥാപിതസ്യ പുത്രസ്യാർഥത ആഗാമിക്രോധാദ് അസ്മാകം നിസ്താരയിതു ര്യീശോഃ സ്വർഗാദ് ആഗമനം പ്രതീക്ഷിതുമ് ആരഭധ്വമ് ഏതത് സർവ്വം തേ ലോകാഃ സ്വയമ് അസ്മാൻ ജ്ഞാപയന്തി|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഹേ ഭ്രാതരഃ, യുഷ്മന്മധ്യേ ഽസ്മാകം പ്രവേശോ നിഷ്ഫലോ ന ജാത ഇതി യൂയം സ്വയം ജാനീഥ|</para>
  <para style="p">
    <verse number="2" style="v"/>അപരം യുഷ്മാഭി ര്യഥാശ്രാവി തഥാ പൂർവ്വം ഫിലിപീനഗരേ ക്ലിഷ്ടാ നിന്ദിതാശ്ച സന്തോഽപി വയമ് ഈശ്വരാദ് ഉത്സാഹം ലബ്ധ്വാ ബഹുയത്നേന യുഷ്മാൻ ഈശ്വരസ്യ സുസംവാദമ് അബോധയാമ|</para>
  <para style="p">
    <verse number="3" style="v"/>യതോഽസ്മാകമ് ആദേശോ ഭ്രാന്തേരശുചിഭാവാദ് വോത്പന്നഃ പ്രവഞ്ചനായുക്തോ വാ ന ഭവതി|</para>
  <para style="p">
    <verse number="4" style="v"/>കിന്ത്വീശ്വരേണാസ്മാൻ പരീക്ഷ്യ വിശ്വസനീയാൻ മത്ത്വാ ച യദ്വത് സുസംവാദോഽസ്മാസു സമാർപ്യത തദ്വദ് വയം മാനവേഭ്യോ ന രുരോചിഷമാണാഃ കിന്ത്വസ്മദന്തഃകരണാനാം പരീക്ഷകായേശ്വരായ രുരോചിഷമാണാ ഭാഷാമഹേ|</para>
  <para style="p">
    <verse number="5" style="v"/>വയം കദാപി സ്തുതിവാദിനോ നാഭവാമേതി യൂയം ജാനീഥ കദാപി ഛലവസ്ത്രേണ ലോഭം നാച്ഛാദയാമേത്യസ്മിൻ ഈശ്വരഃ സാക്ഷീ വിദ്യതേ|</para>
  <para style="p">
    <verse number="6" style="v"/>വയം ഖ്രീഷ്ടസ്യ പ്രേരിതാ ഇവ ഗൗരവാന്വിതാ ഭവിതുമ് അശക്ഷ്യാമ കിന്തു യുഷ്മത്തഃ പരസ്മാദ് വാ കസ്മാദപി മാനവാദ് ഗൗരവം ന ലിപ്സമാനാ യുഷ്മന്മധ്യേ മൃദുഭാവാ ഭൂത്വാവർത്താമഹി|</para>
  <para style="p">
    <verse number="7" style="v"/>യഥാ കാചിന്മാതാ സ്വകീയശിശൂൻ പാലയതി തഥാ വയമപി യുഷ്മാൻ കാങ്ക്ഷമാണാ</para>
  <para style="p">
    <verse number="8" style="v"/>യുഷ്മഭ്യം കേവലമ് ഈശ്വരസ്യ സുസംവാദം തന്നഹി കിന്തു സ്വകീയപ്രാണാൻ അപി ദാതും മനോഭിരഭ്യലഷാമ, യതോ യൂയമ് അസ്മാകം സ്നേഹപാത്രാണ്യഭവത|</para>
  <para style="p">
    <verse number="9" style="v"/>ഹേ ഭ്രാതരഃ, അസ്മാകം ശ്രമഃ ക്ലേेശശ്ച യുഷ്മാഭിഃ സ്മര്യ്യതേ യുഷ്മാകം കോഽപി യദ് ഭാരഗ്രസ്തോ ന ഭവേത് തദർഥം വയം ദിവാനിശം പരിശ്രാമ്യന്തോ യുഷ്മന്മധ്യ ഈശ്വരസ്യ സുസംവാദമഘോഷയാമ|</para>
  <para style="p">
    <verse number="10" style="v"/>അപരഞ്ച വിശ്വാസിനോ യുഷ്മാൻ പ്രതി വയം കീദൃക് പവിത്രത്വയഥാർഥത്വനിർദോഷത്വാചാരിണോഽഭവാമേത്യസ്മിൻ ഈശ്വരോ യൂയഞ്ച സാക്ഷിണ ആധ്വേ|</para>
  <para style="p">
    <verse number="11" style="v"/>അപരഞ്ച യദ്വത് പിതാ സ്വബാലകാൻ തദ്വദ് വയം യുഷ്മാകമ് ഏകൈകം ജനമ് ഉപദിഷ്ടവന്തഃ സാന്ത്വിതവന്തശ്ച,</para>
  <para style="p">
    <verse number="12" style="v"/>യ ഈശ്വരഃ സ്വീയരാജ്യായ വിഭവായ ച യുഷ്മാൻ ആഹൂതവാൻ തദുപയുക്താചരണായ യുഷ്മാൻ പ്രവർത്തിതവന്തശ്ചേതി യൂയം ജാനീഥ|</para>
  <para style="p">
    <verse number="13" style="v"/>യസ്മിൻ സമയേ യൂയമ് അസ്മാകം മുഖാദ് ഈശ്വരേണ പ്രതിശ്രുതം വാക്യമ് അലഭധ്വം തസ്മിൻ സമയേ തത് മാനുഷാണാം വാക്യം ന മത്ത്വേശ്വരസ്യ വാക്യം മത്ത്വാ ഗൃഹീതവന്ത ഇതി കാരണാദ് വയം നിരന്തരമ് ഈശ്വരം ധന്യം വദാമഃ, യതസ്തദ് ഈശ്വരസ്യ വാക്യമ് ഇതി സത്യം വിശ്വാസിനാം യുഷ്മാകം മധ്യേ തസ്യ ഗുണഃ പ്രകാശതേ ച|</para>
  <para style="p">
    <verse number="14" style="v"/>ഹേ ഭ്രാതരഃ, ഖ്രീഷ്ടാശ്രിതവത്യ ഈശ്വരസ്യ യാഃ സമിത്യോ യിഹൂദാദേശേ സന്തി യൂയം താസാമ് അനുകാരിണോഽഭവത, തദ്ഭുക്താ ലോകാശ്ച യദ്വദ് യിഹൂദിലോകേഭ്യസ്തദ്വദ് യൂയമപി സ്വജാതീയലോകേഭ്യോ ദുഃഖമ് അലഭധ്വം|</para>
  <para style="p">
    <verse number="15" style="v"/>തേ യിഹൂദീയാഃ പ്രഭും യീശും ഭവിഷ്യദ്വാദിനശ്ച ഹതവന്തോ ഽസ്മാൻ ദൂരീകൃതവന്തശ്ച, ത ഈശ്വരായ ന രോചന്തേ സർവ്വേഷാം മാനവാനാം വിപക്ഷാ ഭവന്തി ച;</para>
  <para style="p">
    <verse number="16" style="v"/>അപരം ഭിന്നജാതീയലോകാനാം പരിത്രാണാർഥം തേഷാം മധ്യേ സുസംവാദഘോഷണാദ് അസ്മാൻ പ്രതിഷേധന്തി ചേത്ഥം സ്വീയപാപാനാം പരിമാണമ് ഉത്തരോത്തരം പൂരയന്തി, കിന്തു തേഷാമ് അന്തകാരീ ക്രോധസ്താൻ ഉപക്രമതേ|</para>
  <para style="p">
    <verse number="17" style="v"/>ഹേ ഭ്രാതരഃ മനസാ നഹി കിന്തു വദനേന കിയത്കാലം യുഷ്മത്തോ ഽസ്മാകം വിച്ഛേദേ ജാതേ വയം യുഷ്മാകം മുഖാനി ദ്രഷ്ടുമ് അത്യാകാങ്ക്ഷയാ ബഹു യതിതവന്തഃ|</para>
  <para style="p">
    <verse number="18" style="v"/>ദ്വിരേകകൃത്വോ വാ യുഷ്മത്സമീപഗമനായാസ്മാകം വിശേഷതഃ പൗലസ്യ മമാഭിലാഷോഽഭവത് കിന്തു ശയതാനോ ഽസ്മാൻ നിവാരിതവാൻ|</para>
  <para style="p">
    <verse number="19" style="v"/>യതോഽസ്മാകം കാ പ്രത്യാശാ കോ വാനന്ദഃ കിം വാ ശ്ലാഘ്യകിരീടം? അസ്മാകം പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യാഗമനകാലേ തത്സമ്മുഖസ്ഥാ യൂയം കിം തന്ന ഭവിഷ്യഥ?</para>
  <para style="p">
    <verse number="20" style="v"/>യൂയമ് ഏവാസ്മാകം ഗൗരവാനന്ദസ്വരൂപാ ഭവഥ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അതോഽഹം യദാ സന്ദേഹം പുനഃ സോഢും നാശക്നുവം തദാനീമ് ആഥീനീനഗര ഏകാകീ സ്ഥാതും നിശ്ചിത്യ</para>
  <para style="p">
    <verse number="2" style="v"/>സ്വഭ്രാതരം ഖ്രീഷ്ടസ്യ സുസംവാദേ സഹകാരിണഞ്ചേശ്വരസ്യ പരിചാരകം തീമഥിയം യുഷ്മത്സമീപമ് അപ്രേഷയം|</para>
  <para style="p">
    <verse number="3" style="v"/>വർത്തമാനൈഃ ക്ലേശൈഃ കസ്യാപി ചാഞ്ചല്യം യഥാ ന ജായതേ തഥാ തേ ത്വയാ സ്ഥിരീക്രിയന്താം സ്വകീയധർമ്മമധി സമാശ്വാസ്യന്താഞ്ചേതി തമ് ആദിശം|</para>
  <para style="p">
    <verse number="4" style="v"/>വയമേതാദൃശേ ക്ലേेശേ നിയുക്താ ആസ്മഹ ഇതി യൂയം സ്വയം ജാനീഥ, യതോഽസ്മാകം ദുർഗതി ർഭവിഷ്യതീതി വയം യുഷ്മാകം സമീപേ സ്ഥിതികാലേഽപി യുഷ്മാൻ അബോധയാമ, താദൃശമേവ ചാഭവത് തദപി ജാനീഥ|</para>
  <para style="p">
    <verse number="5" style="v"/>തസ്മാത് പരീക്ഷകേണ യുഷ്മാസു പരീക്ഷിതേഷ്വസ്മാകം പരിശ്രമോ വിഫലോ ഭവിഷ്യതീതി ഭയം സോഢും യദാഹം നാശക്നുവം തദാ യുഷ്മാകം വിശ്വാസസ്യ തത്ത്വാവധാരണായ തമ് അപ്രേഷയം|</para>
  <para style="p">
    <verse number="6" style="v"/>കിന്ത്വധുനാ തീമഥിയോ യുഷ്മത്സമീപാദ് അസ്മത്സന്നിധിമ് ആഗത്യ യുഷ്മാകം വിശ്വാസപ്രേമണീ അധ്യസ്മാൻ സുവാർത്താം ജ്ഞാപിതവാൻ വയഞ്ച യഥാ യുഷ്മാൻ സ്മരാമസ്തഥാ യൂയമപ്യസ്മാൻ സർവ്വദാ പ്രണയേന സ്മരഥ ദ്രഷ്ടുമ് ആകാങ്ക്ഷധ്വേ ചേതി കഥിതവാൻ|</para>
  <para style="p">
    <verse number="7" style="v"/>ഹേ ഭ്രാതരഃ, വാർത്താമിമാം പ്രാപ്യ യുഷ്മാനധി വിശേഷതോ യുഷ്മാകം ക്ലേശദുഃഖാന്യധി യുഷ്മാകം വിശ്വാസാദ് അസ്മാകം സാന്ത്വനാജായത;</para>
  <para style="p">
    <verse number="8" style="v"/>യതോ യൂയം യദി പ്രഭാവവതിഷ്ഠഥ തർഹ്യനേന വയമ് അധുനാ ജീവാമഃ|</para>
  <para style="p">
    <verse number="9" style="v"/>വയഞ്ചാസ്മദീയേശ്വരസ്യ സാക്ഷാദ് യുഷ്മത്തോ ജാതേന യേനാനന്ദേന പ്രഫുല്ലാ ഭവാമസ്തസ്യ കൃത്സ്നസ്യാനന്ദസ്യ യോഗ്യരൂപേണേശ്വരം ധന്യം വദിതും കഥം ശക്ഷ്യാമഃ?</para>
  <para style="p">
    <verse number="10" style="v"/>വയം യേന യുഷ്മാകം വദനാനി ദ്രഷ്ടും യുഷ്മാകം വിശ്വാസേ യദ് അസിദ്ധം വിദ്യതേ തത് സിദ്ധീകർത്തുഞ്ച ശക്ഷ്യാമസ്താദൃശം വരം ദിവാനിശം പ്രാർഥയാമഹേ|</para>
  <para style="p">
    <verse number="11" style="v"/>അസ്മാകം താതേനേശ്വരേണ പ്രഭുനാ യീശുഖ്രീഷ്ടേന ച യുഷ്മത്സമീപഗമനായാസ്മാകം പന്ഥാ സുഗമഃ ക്രിയതാം|</para>
  <para style="p">
    <verse number="12" style="v"/>പരസ്പരം സർവ്വാംശ്ച പ്രതി യുഷ്മാകം പ്രേമ യുഷ്മാൻ പ്രതി ചാസ്മാകം പ്രേമ പ്രഭുനാ വർദ്ധ്യതാം ബഹുഫലം ക്രിയതാഞ്ച|</para>
  <para style="p">
    <verse number="13" style="v"/>അപരമസ്മാകം പ്രഭു ര്യീശുഖ്രീഷ്ടഃ സ്വകീയൈഃ സർവ്വൈഃ പവിത്രലോകൈഃ സാർദ്ധം യദാഗമിഷ്യതി തദാ യൂയം യഥാസ്മാകം താതസ്യേശ്വരസ്യ സമ്മുഖേ പവിത്രതയാ നിർദോഷാ ഭവിഷ്യഥ തഥാ യുഷ്മാകം മനാംസി സ്ഥിരീക്രിയന്താം|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഹേ ഭ്രാതരഃ, യുഷ്മാഭിഃ കീദൃഗ് ആചരിതവ്യം ഈശ്വരായ രോചിതവ്യഞ്ച തദധ്യസ്മത്തോ യാ ശിക്ഷാ ലബ്ധാ തദനുസാരാത് പുനരതിശയം യത്നഃ ക്രിയതാമിതി വയം പ്രഭുയീശുനാ യുഷ്മാൻ വിനീയാദിശാമഃ|</para>
  <para style="p">
    <verse number="2" style="v"/>യതോ വയം പ്രഭുയീശുനാ കീദൃശീരാജ്ഞാ യുഷ്മാസു സമർപിതവന്തസ്തദ് യൂയം ജാനീഥ|</para>
  <para style="p">
    <verse number="3" style="v"/>ഈശ്വരസ്യായമ് അഭിലാഷോ യദ് യുഷ്മാകം പവിത്രതാ ഭവേത്, യൂയം വ്യഭിചാരാദ് ദൂരേ തിഷ്ഠത|</para>
  <para style="p">
    <verse number="4" style="v"/>യുഷ്മാകമ് ഏകൈകോ ജനഃ സ്വകീയം പ്രാണാധാരം പവിത്രം മാന്യഞ്ച രക്ഷതു,</para>
  <para style="p">
    <verse number="5" style="v"/>യേ ച ഭിന്നജാതീയാ ലോകാ ഈശ്വരം ന ജാനന്തി ത ഇവ തത് കാമാഭിലാഷസ്യാധീനം ന കരോതു|</para>
  <para style="p">
    <verse number="6" style="v"/>ഏതസ്മിൻ വിഷയേ കോഽപ്യത്യാചാരീ ഭൂത്വാ സ്വഭ്രാതരം ന വഞ്ചയതു യതോഽസ്മാഭിഃ പൂർവ്വം യഥോക്തം പ്രമാണീകൃതഞ്ച തഥൈവ പ്രഭുരേതാദൃശാനാം കർമ്മണാം സമുചിതം ഫലം ദാസ്യതി|</para>
  <para style="p">
    <verse number="7" style="v"/>യസ്മാദ് ഈശ്വരോഽസ്മാൻ അശുചിതായൈ നാഹൂതവാൻ കിന്തു പവിത്രത്വായൈവാഹൂതവാൻ|</para>
  <para style="p">
    <verse number="8" style="v"/>അതോ ഹേതോ ര്യഃ കശ്ചിദ് വാക്യമേതന്ന ഗൃഹ്ലാതി സ മനുഷ്യമ് അവജാനാതീതി നഹി യേന സ്വകീയാത്മാ യുഷ്മദന്തരേ സമർപിതസ്തമ് ഈശ്വരമ് ഏവാവജാനാതി|</para>
  <para style="p">
    <verse number="9" style="v"/>ഭ്രാതൃഷു പ്രേമകരണമധി യുഷ്മാൻ പ്രതി മമ ലിഖനം നിഷ്പ്രയോജനം യതോ യൂയം പരസ്പരം പ്രേമകരണായേശ്വരശിക്ഷിതാ ലോകാ ആധ്വേ|</para>
  <para style="p">
    <verse number="10" style="v"/>കൃത്സ്നേ മാകിദനിയാദേശേ ച യാവന്തോ ഭ്രാതരഃ സന്തി താൻ സർവ്വാൻ പ്രതി യുഷ്മാഭിസ്തത് പ്രേമ പ്രകാശ്യതേ തഥാപി ഹേ ഭ്രാതരഃ, വയം യുഷ്മാൻ വിനയാമഹേ യൂയം പുന ർബഹുതരം പ്രേമ പ്രകാശയത|</para>
  <para style="p">
    <verse number="11" style="v"/>അപരം യേ ബഹിഃസ്ഥിതാസ്തേഷാം ദൃഷ്ടിഗോചരേ യുഷ്മാകമ് ആചരണം യത് മനോരമ്യം ഭവേത് കസ്യാപി വസ്തുനശ്ചാഭാവോ യുഷ്മാകം യന്ന ഭവേത്,</para>
  <para style="p">
    <verse number="12" style="v"/>ഏതദർഥം യൂയമ് അസ്മത്തോ യാദൃശമ് ആദേശം പ്രാപ്തവന്തസ്താദൃശം നിർവിരോധാചാരം കർത്തും സ്വസ്വകർമ്മണി മനാംമി നിധാതും നിജകരൈശ്ച കാര്യ്യം സാധയിതും യതധ്വം|</para>
  <para style="p">
    <verse number="13" style="v"/>ഹേ ഭ്രാതരഃ നിരാശാ അന്യേ ലോകാ ഇവ യൂയം യന്ന ശോചേധ്വം തദർഥം മഹാനിദ്രാഗതാൻ ലോകാനധി യുഷ്മാകമ് അജ്ഞാനതാ മയാ നാഭിലഷ്യതേ|</para>
  <para style="p">
    <verse number="14" style="v"/>യീശു ർമൃതവാൻ പുനരുഥിതവാംശ്ചേതി യദി വയം വിശ്വാസമസ്തർഹി യീശുമ് ആശ്രിതാൻ മഹാനിദ്രാപ്രാപ്താൻ ലോകാനപീശ്വരോഽവശ്യം തേന സാർദ്ധമ് ആനേഷ്യതി|</para>
  <para style="p">
    <verse number="15" style="v"/>യതോഽഹം പ്രഭോ ർവാക്യേന യുഷ്മാൻ ഇദം ജ്ഞാപയാമി; അസ്മാകം മധ്യേ യേ ജനാഃ പ്രഭോരാഗമനം യാവത് ജീവന്തോഽവശേക്ഷ്യന്തേ തേ മഹാനിദ്രിതാനാമ് അഗ്രഗാമിനോന ന ഭവിഷ്യന്തി;</para>
  <para style="p">
    <verse number="16" style="v"/>യതഃ പ്രഭുഃ സിംഹനാദേന പ്രധാനസ്വർഗദൂതസ്യോച്ചൈഃ ശബ്ദേനേശ്വരീയതൂരീവാദ്യേന ച സ്വയം സ്വർഗാദ് അവരോക്ഷ്യതി തേന ഖ്രീഷ്ടാശ്രിതാ മൃതലോകാഃ പ്രഥമമ് ഉത്ഥാസ്യാന്തി|</para>
  <para style="p">
    <verse number="17" style="v"/>അപരമ് അസ്മാകം മധ്യേ യേ ജീവന്തോഽവശേക്ഷ്യന്തേ ത ആകാശേ പ്രഭോഃ സാക്ഷാത്കരണാർഥം തൈഃ സാർദ്ധം മേഘവാഹനേന ഹരിഷ്യന്തേ; ഇത്ഥഞ്ച വയം സർവ്വദാ പ്രഭുനാ സാർദ്ധം സ്ഥാസ്യാമഃ|</para>
  <para style="p">
    <verse number="18" style="v"/>അതോ യൂയമ് ഏതാഭിഃ കഥാഭിഃ പരസ്പരം സാന്ത്വയത|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഹേ ഭ്രാതരഃ, കാലാൻ സമയാംശ്ചാധി യുഷ്മാൻ പ്രതി മമ ലിഖനം നിഷ്പ്രയോജനം,</para>
  <para style="p">
    <verse number="2" style="v"/>യതോ രാത്രൗ യാദൃക് തസ്കരസ്താദൃക് പ്രഭോ ർദിനമ് ഉപസ്ഥാസ്യതീതി യൂയം സ്വയമേവ സമ്യഗ് ജാനീഥ|</para>
  <para style="p">
    <verse number="3" style="v"/>ശാന്തി ർനിർവ്വിൻഘത്വഞ്ച വിദ്യത ഇതി യദാ മാനവാ വദിഷ്യന്തി തദാ പ്രസവവേദനാ യദ്വദ് ഗർബ്ഭിനീമ് ഉപതിഷ്ഠതി തദ്വദ് അകസ്മാദ് വിനാശസ്താൻ ഉപസ്ഥാസ്യതി തൈരുദ്ധാരോ ന ലപ്സ്യതേ|</para>
  <para style="p">
    <verse number="4" style="v"/>കിന്തു ഹേ ഭ്രാതരഃ, യൂയമ് അന്ധകാരേണാവൃതാ ന ഭവഥ തസ്മാത് തദ്ദിനം തസ്കര ഇവ യുഷ്മാൻ ന പ്രാപ്സ്യതി|</para>
  <para style="p">
    <verse number="5" style="v"/>സർവ്വേ യൂയം ദീപ്തേഃ സന്താനാ ദിവായാശ്ച സന്താനാ ഭവഥ വയം നിശാവംശാസ്തിമിരവംശാ വാ ന ഭവാമഃ|</para>
  <para style="p">
    <verse number="6" style="v"/>അതോ ഽപരേ യഥാ നിദ്രാഗതാഃ സന്തി തദ്വദ് അസ്മാഭി ർന ഭവിതവ്യം കിന്തു ജാഗരിതവ്യം സചേതനൈശ്ച ഭവിതവ്യം|</para>
  <para style="p">
    <verse number="7" style="v"/>യേ നിദ്രാന്തി തേ നിശായാമേവ നിദ്രാന്തി തേ ച മത്താ ഭവന്തി തേ രജന്യാമേവ മത്താ ഭവന്തി|</para>
  <para style="p">
    <verse number="8" style="v"/>കിന്തു വയം ദിവസസ്യ വംശാ ഭവാമഃ; അതോ ഽസ്മാഭി ർവക്ഷസി പ്രത്യയപ്രേമരൂപം കവചം ശിരസി ച പരിത്രാണാശാരൂപം ശിരസ്ത്രം പരിധായ സചേതനൈ ർഭവിതവ്യം|</para>
  <para style="p">
    <verse number="9" style="v"/>യത ഈശ്വരോഽസ്മാൻ ക്രോധേ ന നിയുജ്യാസ്മാകം പ്രഭുനാ യീശുഖ്രീഷ്ടേന പരിത്രാണസ്യാധികാരേ നിയുुക്തവാൻ,</para>
  <para style="p">
    <verse number="10" style="v"/>ജാഗ്രതോ നിദ്രാഗതാ വാ വയം യത് തേന പ്രഭുനാ സഹ ജീവാമസ്തദർഥം സോഽസ്മാകം കൃതേ പ്രാണാൻ ത്യക്തവാൻ|</para>
  <para style="p">
    <verse number="11" style="v"/>അതഏവ യൂയം യദ്വത് കുരുഥ തദ്വത് പരസ്പരം സാന്ത്വയത സുസ്ഥിരീകുരുധ്വഞ്ച|</para>
  <para style="p">
    <verse number="12" style="v"/>ഹേ ഭ്രാതരഃ, യുഷ്മാകം മധ്യേ യേ ജനാഃ പരിശ്രമം കുർവ്വന്തി പ്രഭോ ർനാമ്നാ യുഷ്മാൻ അധിതിഷ്ഠന്ത്യുപദിശന്തി ച താൻ യൂയം സമ്മന്യധ്വം|</para>
  <para style="p">
    <verse number="13" style="v"/>സ്വകർമ്മഹേതുനാ ച പ്രേമ്നാ താൻ അതീവാദൃയധ്വമിതി മമ പ്രാർഥനാ, യൂയം പരസ്പരം നിർവ്വിരോധാ ഭവത|</para>
  <para style="p">
    <verse number="14" style="v"/>ഹേ ഭ്രാതരഃ, യുഷ്മാൻ വിനയാമഹേ യൂയമ് അവിഹിതാചാരിണോ ലോകാൻ ഭർത്സയധ്വം, ക്ഷുദ്രമനസഃ സാന്ത്വയത, ദുർബ്ബലാൻ ഉപകുരുത, സർവ്വാൻ പ്രതി സഹിഷ്ണവോ ഭവത ച|</para>
  <para style="p">
    <verse number="15" style="v"/>അപരം കമപി പ്രത്യനിഷ്ടസ്യ ഫലമ് അനിഷ്ടം കേനാപി യന്ന ക്രിയേത തദർഥം സാവധാനാ ഭവത, കിന്തു പരസ്പരം സർവ്വാൻ മാനവാംശ്ച പ്രതി നിത്യം ഹിതാചാരിണോ ഭവത|</para>
  <para style="p">
    <verse number="16" style="v"/>സർവ്വദാനന്ദത|</para>
  <para style="p">
    <verse number="17" style="v"/>നിരന്തരം പ്രാർഥനാം കുരുധ്വം|</para>
  <para style="p">
    <verse number="18" style="v"/>സർവ്വവിഷയേ കൃതജ്ഞതാം സ്വീകുരുധ്വം യത ഏതദേവ ഖ്രീഷ്ടയീശുനാ യുഷ്മാൻ പ്രതി പ്രകാശിതമ് ഈശ്വരാഭിമതം|</para>
  <para style="p">
    <verse number="19" style="v"/>പവിത്രമ് ആത്മാനം ന നിർവ്വാപയത|</para>
  <para style="p">
    <verse number="20" style="v"/>ഈശ്വരീയാദേശം നാവജാനീത|</para>
  <para style="p">
    <verse number="21" style="v"/>സർവ്വാണി പരീക്ഷ്യ യദ് ഭദ്രം തദേവ ധാരയത|</para>
  <para style="p">
    <verse number="22" style="v"/>യത് കിമപി പാപരൂപം ഭവതി തസ്മാദ് ദൂരം തിഷ്ഠത|</para>
  <para style="p">
    <verse number="23" style="v"/>ശാന്തിദായക ഈശ്വരഃ സ്വയം യുഷ്മാൻ സമ്പൂർണത്വേന പവിത്രാൻ കരോതു, അപരമ് അസ്മത്പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യാഗമനം യാവദ് യുഷ്മാകമ് ആത്മാനഃ പ്രാണാഃ ശരീരാണി ച നിഖിലാനി നിർദ്ദോഷത്വേന രക്ഷ്യന്താം|</para>
  <para style="p">
    <verse number="24" style="v"/>യോ യുഷ്മാൻ ആഹ്വയതി സ വിശ്വസനീയോഽതഃ സ തത് സാധയിഷ്യതി|</para>
  <para style="p">
    <verse number="25" style="v"/>ഹേ ഭ്രാതരഃ, അസ്മാകം കൃതേ പ്രാർഥനാം കുരുധ്വം|</para>
  <para style="p">
    <verse number="26" style="v"/>പവിത്രചുമ്ബനേന സർവ്വാൻ ഭ്രാതൃൻ പ്രതി സത്കുരുധ്വം|</para>
  <para style="p">
    <verse number="27" style="v"/>പത്രമിദം സർവ്വേഷാം പവിത്രാണാം ഭ്രാതൃണാം ശ്രുതിഗോചരേ യുഷ്മാഭിഃ പഠ്യതാമിതി പ്രഭോ ർനാമ്നാ യുഷ്മാൻ ശപയാമി|</para>
  <para style="p">
    <verse number="28" style="v"/>അസ്മാകം പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യാനുഗ്രതേ യുഷ്മാസു ഭൂയാത്| ആമേൻ|</para>
</usx>
