<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="3JN" style="id">Sanskrit Bible (NT) in Malayalam Script (സത്യവേദഃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">3 John</para>
  <para style="toc1">3 യോഹനഃ പത്രം</para>
  <para style="toc2">3 യോഹനഃ</para>
  <para style="toc3">3 യോഹനഃ</para>
  <para style="mt1">3 യോഹനഃ പത്രം</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>പ്രാചീനോ ഽഹം സത്യമതാദ് യസ്മിൻ പ്രീയേ തം പ്രിയതമം ഗായം പ്രതി പത്രം ലിഖാമി|</para>
  <para style="p">
    <verse number="2" style="v"/>ഹേ പ്രിയ, തവാത്മാ യാദൃക് ശുഭാന്വിതസ്താദൃക് സർവ്വവിഷയേ തവ ശുഭം സ്വാസ്ഥ്യഞ്ച ഭൂയാത്|</para>
  <para style="p">
    <verse number="3" style="v"/>ഭ്രാതൃഭിരാഗത്യ തവ സത്യമതസ്യാർഥതസ്ത്വം കീദൃക് സത്യമതമാചരസ്യേതസ്യ സാക്ഷ്യേ ദത്തേ മമ മഹാനന്ദോ ജാതഃ|</para>
  <para style="p">
    <verse number="4" style="v"/>മമ സന്താനാഃ സത്യമതമാചരന്തീതിവാർത്താതോ മമ യ ആനന്ദോ ജായതേ തതോ മഹത്തരോ നാസ്തി|</para>
  <para style="p">
    <verse number="5" style="v"/>ഹേ പ്രിയ, ഭ്രാതൃൻ പ്രതി വിശേഷതസ്താൻ വിദേശിനോ ഭൃाതൃൻ പ്രതി ത്വയാ യദ്യത് കൃതം തത് സർവ്വം വിശ്വാസിനോ യോഗ്യം|</para>
  <para style="p">
    <verse number="6" style="v"/>തേ ച സമിതേഃ സാക്ഷാത് തവ പ്രമ്നഃ പ്രമാണം ദത്തവന്തഃ, അപരമ് ഈശ്വരയോഗ്യരൂപേണ താൻ പ്രസ്ഥാപയതാ ത്വയാ സത്കർമ്മ കാരിഷ്യതേ|</para>
  <para style="p">
    <verse number="7" style="v"/>യതസ്തേ തസ്യ നാമ്നാ യാത്രാം വിധായ ഭിന്നജാതീയേഭ്യഃ കിമപി ന ഗൃഹീതവന്തഃ|</para>
  <para style="p">
    <verse number="8" style="v"/>തസ്മാദ് വയം യത് സത്യമതസ്യ സഹായാ ഭവേമ തദർഥമേതാദൃശാ ലോകാ അസ്മാഭിരനുഗ്രഹീതവ്യാഃ|</para>
  <para style="p">
    <verse number="9" style="v"/>സമിതിം പ്രത്യഹം പത്രം ലിഖിതവാൻ കിന്തു തേഷാം മധ്യേ യോ ദിയത്രിഫിഃ പ്രധാനായതേ സോ ഽസ്മാൻ ന ഗൃഹ്ലാതി|</para>
  <para style="p">
    <verse number="10" style="v"/>അതോ ഽഹം യദോപസ്ഥാസ്യാമി തദാ തേന യദ്യത് ക്രിയതേ തത് സർവ്വം തം സ്മാരയിഷ്യാമി, യതഃ സ ദുർവ്വാക്യൈരസ്മാൻ അപവദതി, തേനാപി തൃപ്തിം ന ഗത്വാ സ്വയമപി ഭ്രാതൃൻ നാനുഗൃഹ്ലാതി യേ ചാനുഗ്രഹീതുമിച്ഛന്തി താൻ സമിതിതോ ഽപി ബഹിഷ്കരോതി|</para>
  <para style="p">
    <verse number="11" style="v"/>ഹേ പ്രിയ, ത്വയാ ദുഷ്കർമ്മ നാനുക്രിയതാം കിന്തു സത്കർമ്മൈവ| യഃ സത്കർമ്മാചാരീ സ ഈശ്വരാത് ജാതഃ, യോ ദുഷ്കർമ്മാചാരീ സ ഈശ്വരം ന ദൃഷ്ടവാൻ|</para>
  <para style="p">
    <verse number="12" style="v"/>ദീമീത്രിയസ്യ പക്ഷേ സർവ്വൈഃ സാക്ഷ്യമ് അദായി വിശേഷതഃ സത്യമതേനാപി, വയമപി തത്പക്ഷേ സാക്ഷ്യം ദദ്മഃ, അസ്മാകഞ്ച സാക്ഷ്യം സത്യമേവേതി യൂയം ജാനീഥ|</para>
  <para style="p">
    <verse number="13" style="v"/>ത്വാം പ്രതി മയാ ബഹൂനി ലേഖിതവ്യാനി കിന്തു മസീലേഖനീഭ്യാം ലേഖിതും നേച്ഛാമി|</para>
  <para style="p">
    <verse number="14" style="v"/>അചിരേണ ത്വാം ദ്രക്ഷ്യാമീതി മമ പ്രത്യാശാസ്തേ തദാവാം സമ്മുഖീഭൂയ പരസ്പരം സമ്ഭാഷിഷ്യാവഹേ|</para>
  <para style="p">
    <verse number="15" style="v"/>തവ ശാന്തി ർഭൂയാത്| അസ്മാകം മിത്രാണി ത്വാം നമസ്കാരം ജ്ഞാപയന്തി ത്വമപ്യേകൈകസ്യ നാമ പ്രോച്യ മിത്രേഭ്യോ നമസ്കുരു| ഇതി|</para>
</usx>
