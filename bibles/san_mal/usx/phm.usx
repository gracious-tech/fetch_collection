<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="PHM" style="id">Sanskrit Bible (NT) in Malayalam Script (സത്യവേദഃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Philemon</para>
  <para style="toc1">ഫിലോമോനം പത്രം</para>
  <para style="toc2">ഫിലോമോനഃ</para>
  <para style="toc3">ഫിലോമോനഃ</para>
  <para style="mt1">ഫിലോമോനം പത്രം</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഖ്രീഷ്ടസ്യ യീശോ ർബന്ദിദാസഃ പൗലസ്തീഥിയനാമാ ഭ്രാതാ ച പ്രിയം സഹകാരിണം ഫിലീമോനം</para>
  <para style="p">
    <verse number="2" style="v"/>പ്രിയാമ് ആപ്പിയാം സഹസേനാമ് ആർഖിപ്പം ഫിലീമോനസ്യ ഗൃഹേ സ്ഥിതാം സമിതിഞ്ച പ്രതി പത്രം ലിഖതഃ|</para>
  <para style="p">
    <verse number="3" style="v"/>അസ്മാകം താത ഈശ്വരഃ പ്രഭു ര്യീശുഖ്രീഷ്ടശ്ച യുഷ്മാൻ പ്രതി ശാന്തിമ് അനുഗ്രഹഞ്ച ക്രിയാസ്താം|</para>
  <para style="p">
    <verse number="4" style="v"/>പ്രഭും യീശും പ്രതി സർവ്വാൻ പവിത്രലോകാൻ പ്രതി ച തവ പ്രേമവിശ്വാസയോ ർവൃത്താന്തം നിശമ്യാഹം</para>
  <para style="p">
    <verse number="5" style="v"/>പ്രാർഥനാസമയേ തവ നാമോച്ചാരയൻ നിരന്തരം മമേശ്വരം ധന്യം വദാമി|</para>
  <para style="p">
    <verse number="6" style="v"/>അസ്മാസു യദ്യത് സൗജന്യം വിദ്യതേ തത് സർവ്വം ഖ്രീഷ്ടം യീശും യത് പ്രതി ഭവതീതി ജ്ഞാനായ തവ വിശ്വാസമൂലികാ ദാനശീലതാ യത് സഫലാ ഭവേത് തദഹമ് ഇച്ഛാമി|</para>
  <para style="p">
    <verse number="7" style="v"/>ഹേ ഭ്രാതഃ, ത്വയാ പവിത്രലോകാനാം പ്രാണ ആപ്യായിതാ അഭവൻ ഏതസ്മാത് തവ പ്രേമ്നാസ്മാകം മഹാൻ ആനന്ദഃ സാന്ത്വനാ ച ജാതഃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ത്വയാ യത് കർത്തവ്യം തത് ത്വാമ് ആജ്ഞാപയിതും യദ്യപ്യഹം ഖ്രീഷ്ടേനാതീവോത്സുകോ ഭവേയം തഥാപി വൃദ്ധ</para>
  <para style="p">
    <verse number="9" style="v"/>ഇദാനീം യീശുഖ്രീഷ്ടസ്യ ബന്ദിദാസശ്ചൈവമ്ഭൂതോ യഃ പൗലഃ സോഽഹം ത്വാം വിനേതും വരം മന്യേ|</para>
  <para style="p">
    <verse number="10" style="v"/>അതഃ ശൃങ്ഖലബദ്ധോഽഹം യമജനയം തം മദീയതനയമ് ഓനീഷിമമ് അധി ത്വാം വിനയേ|</para>
  <para style="p">
    <verse number="11" style="v"/>സ പൂർവ്വം തവാനുപകാരക ആസീത് കിന്ത്വിദാനീം തവ മമ ചോപകാരീ ഭവതി|</para>
  <para style="p">
    <verse number="12" style="v"/>തമേവാഹം തവ സമീപം പ്രേഷയാമി, അതോ മദീയപ്രാണസ്വരൂപഃ സ ത്വയാനുഗൃഹ്യതാം|</para>
  <para style="p">
    <verse number="13" style="v"/>സുസംവാദസ്യ കൃതേ ശൃങ്ഖലബദ്ധോഽഹം പരിചാരകമിവ തം സ്വസന്നിധൗ വർത്തയിതുമ് ഐച്ഛം|</para>
  <para style="p">
    <verse number="14" style="v"/>കിന്തു തവ സൗജന്യം യദ് ബലേന ന ഭൂത്വാ സ്വേച്ഛായാഃ ഫലം ഭവേത് തദർഥം തവ സമ്മതിം വിനാ കിമപി കർത്തവ്യം നാമന്യേ|</para>
  <para style="p">
    <verse number="15" style="v"/>കോ ജാനാതി ക്ഷണകാലാർഥം ത്വത്തസ്തസ്യ വിച്ഛേദോഽഭവദ് ഏതസ്യായമ് അഭിപ്രായോ യത് ത്വമ് അനന്തകാലാർഥം തം ലപ്സ്യസേ</para>
  <para style="p">
    <verse number="16" style="v"/>പുന ർദാസമിവ ലപ്സ്യസേ തന്നഹി കിന്തു ദാസാത് ശ്രേഷ്ഠം മമ പ്രിയം തവ ച ശാരീരികസമ്ബന്ധാത് പ്രഭുസമ്ബന്ധാച്ച തതോഽധികം പ്രിയം ഭ്രാതരമിവ|</para>
  <para style="p">
    <verse number="17" style="v"/>അതോ ഹേതോ ര്യദി മാം സഹഭാഗിനം ജാനാസി തർഹി മാമിവ തമനുഗൃഹാണ|</para>
  <para style="p">
    <verse number="18" style="v"/>തേന യദി തവ കിമപ്യപരാദ്ധം തുഭ്യം കിമപി ധാര്യ്യതേ വാ തർഹി തത് മമേതി വിദിത്വാ ഗണയ|</para>
  <para style="p">
    <verse number="19" style="v"/>അഹം തത് പരിശോത്സ്യാമി, ഏതത് പൗലോഽഹം സ്വഹസ്തേന ലിഖാമി, യതസ്ത്വം സ്വപ്രാണാൻ അപി മഹ്യം ധാരയസി തദ് വക്തും നേച്ഛാമി|</para>
  <para style="p">
    <verse number="20" style="v"/>ഭോ ഭ്രാതഃ, പ്രഭോഃ കൃതേ മമ വാഞ്ഛാം പൂരയ ഖ്രീഷ്ടസ്യ കൃതേ മമ പ്രാണാൻ ആപ്യായയ|</para>
  <para style="p">
    <verse number="21" style="v"/>തവാജ്ഞാഗ്രാഹിത്വേ വിശ്വസ്യ മയാ ഏതത് ലിഖ്യതേ മയാ യദുച്യതേ തതോഽധികം ത്വയാ കാരിഷ്യത ഇതി ജാനാമി|</para>
  <para style="p">
    <verse number="22" style="v"/>തത്കരണസമയേ മദർഥമപി വാസഗൃഹം ത്വയാ സജ്ജീക്രിയതാം യതോ യുഷ്മാകം പ്രാർഥനാനാം ഫലരൂപോ വര ഇവാഹം യുഷ്മഭ്യം ദായിഷ്യേ മമേതി പ്രത്യാശാ ജായതേ|</para>
  <para style="p">
    <verse number="23" style="v"/>ഖ്രീഷ്ടസ്യ യീശാഃ കൃതേ മയാ സഹ ബന്ദിരിപാഫ്രാ</para>
  <para style="p">
    <verse number="24" style="v"/>മമ സഹകാരിണോ മാർക ആരിഷ്ടാർഖോ ദീമാ ലൂകശ്ച ത്വാം നമസ്കാരം വേദയന്തി|</para>
  <para style="p">
    <verse number="25" style="v"/>അസ്മാകം പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യാനുഗ്രഹോ യുഷ്മാകമ് ആത്മനാ സഹ ഭൂയാത്| ആമേൻ|</para>
</usx>
