<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="JAS" style="id">Sanskrit Bible (NT) in Malayalam Script (സത്യവേദഃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">James</para>
  <para style="toc1">യാകൂബഃ പത്രം</para>
  <para style="toc2">യാകൂബഃ</para>
  <para style="toc3">യാകൂബഃ</para>
  <para style="mt1">യാകൂബഃ പത്രം</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഈശ്വരസ്യ പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യ ച ദാസോ യാകൂബ് വികീർണീഭൂതാൻ ദ്വാദശം വംശാൻ പ്രതി നമസ്കൃത്യ പത്രം ലിഖതി|</para>
  <para style="p">
    <verse number="2" style="v"/>ഹേ മമ ഭ്രാതരഃ, യൂയം യദാ ബഹുവിധപരീക്ഷാഷു നിപതത തദാ തത് പൂർണാനന്ദസ്യ കാരണം മന്യധ്വം|</para>
  <para style="p">
    <verse number="3" style="v"/>യതോ യുഷ്മാകം വിശ്വാസസ്യ പരീക്ഷിതത്വേന ധൈര്യ്യം സമ്പാദ്യത ഇതി ജാനീഥ|</para>
  <para style="p">
    <verse number="4" style="v"/>തച്ച ധൈര്യ്യം സിദ്ധഫലം ഭവതു തേന യൂയം സിദ്ധാഃ സമ്പൂർണാശ്ച ഭവിഷ്യഥ കസ്യാപി ഗുണസ്യാഭാവശ്ച യുഷ്മാകം ന ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="5" style="v"/>യുഷ്മാകം കസ്യാപി ജ്ഞാനാഭാവോ യദി ഭവേത് തർഹി യ ഈശ്വരഃ സരലഭാവേന തിരസ്കാരഞ്ച വിനാ സർവ്വേഭ്യോ ദദാതി തതഃ സ യാചതാം തതസ്തസ്മൈ ദായിഷ്യതേ|</para>
  <para style="p">
    <verse number="6" style="v"/>കിന്തു സ നിഃസന്ദേഹഃ സൻ വിശ്വാസേന യാചതാം യതഃ സന്ദിഗ്ധോ മാനവോ വായുനാ ചാലിതസ്യോത്പ്ലവമാനസ്യ ച സമുദ്രതരങ്ഗസ്യ സദൃശോ ഭവതി|</para>
  <para style="p">
    <verse number="7" style="v"/>താദൃശോ മാനവഃ പ്രഭോഃ കിഞ്ചിത് പ്രാപ്സ്യതീതി ന മന്യതാം|</para>
  <para style="p">
    <verse number="8" style="v"/>ദ്വിമനാ ലോകഃ സർവ്വഗതിഷു ചഞ്ചലോ ഭവതി|</para>
  <para style="p">
    <verse number="9" style="v"/>യോ ഭ്രാതാ നമ്രഃ സ നിജോന്നത്യാ ശ്ലാഘതാം|</para>
  <para style="p">
    <verse number="10" style="v"/>യശ്ച ധനവാൻ സ നിജനമ്രതയാ ശ്ലാഘതാംയതഃ സ തൃണപുഷ്പവത് ക്ഷയം ഗമിഷ്യതി|</para>
  <para style="p">
    <verse number="11" style="v"/>യതഃ സതാപേന സൂര്യ്യേണോദിത്യ തൃണം ശോഷ്യതേ തത്പുഷ്പഞ്ച ഭ്രശ്യതി തേന തസ്യ രൂപസ്യ സൗന്ദര്യ്യം നശ്യതി തദ്വദ് ധനിലോകോഽപി സ്വീയമൂഢതയാ മ്ലാസ്യതി|</para>
  <para style="p">
    <verse number="12" style="v"/>യോ ജനഃ പരീക്ഷാം സഹതേ സ ഏവ ധന്യഃ, യതഃ പരീക്ഷിതത്വം പ്രാപ്യ സ പ്രഭുനാ സ്വപ്രേമകാരിഭ്യഃ പ്രതിജ്ഞാതം ജീവനമുകുടം ലപ്സ്യതേ|</para>
  <para style="p">
    <verse number="13" style="v"/>ഈശ്വരോ മാം പരീക്ഷത ഇതി പരീക്ഷാസമയേ കോഽപി ന വദതു യതഃ പാപായേശ്വരസ്യ പരീക്ഷാ ന ഭവതി സ ച കമപി ന പരീക്ഷതേ|</para>
  <para style="p">
    <verse number="14" style="v"/>കിന്തു യഃ കശ്ചിത് സ്വീയമനോവാഞ്ഛയാകൃഷ്യതേ ലോഭ്യതേ ച തസ്യൈവ പരീക്ഷാ ഭവതി|</para>
  <para style="p">
    <verse number="15" style="v"/>തസ്മാത് സാ മനോവാഞ്ഛാ സഗർഭാ ഭൂത്വാ ദുഷ്കൃതിം പ്രസൂതേ ദുഷ്കൃതിശ്ച പരിണാമം ഗത്വാ മൃത്യും ജനയതി|</para>
  <para style="p">
    <verse number="16" style="v"/>ഹേ മമ പ്രിയഭ്രാതരഃ, യൂയം ന ഭ്രാമ്യത|</para>
  <para style="p">
    <verse number="17" style="v"/>യത് കിഞ്ചിദ് ഉത്തമം ദാനം പൂർണോ വരശ്ച തത് സർവ്വമ് ഊർദ്ധ്വാദ് അർഥതോ യസ്മിൻ ദശാന്തരം പരിവർത്തനജാതച്ഛായാ വാ നാസ്തി തസ്മാദ് ദീപ്ത്യാകരാത് പിതുരവരോഹതി|</para>
  <para style="p">
    <verse number="18" style="v"/>തസ്യ സൃഷ്ടവസ്തൂനാം മധ്യേ വയം യത് പ്രഥമഫലസ്വരൂപാ ഭവാമസ്തദർഥം സ സ്വേച്ഛാതഃ സത്യമതസ്യ വാക്യേനാസ്മാൻ ജനയാമാസ|</para>
  <para style="p">
    <verse number="19" style="v"/>അതഏവ ഹേ മമ പ്രിയഭ്രാതരഃ, യുഷ്മാകമ് ഏകൈകോ ജനഃ ശ്രവണേ ത്വരിതഃ കഥനേ ധീരഃ ക്രോധേഽപി ധീരോ ഭവതു|</para>
  <para style="p">
    <verse number="20" style="v"/>യതോ മാനവസ്യ ക്രോധ ഈശ്വരീയധർമ്മം ന സാധയതി|</para>
  <para style="p">
    <verse number="21" style="v"/>അതോ ഹേതോ ര്യൂയം സർവ്വാമ് അശുചിക്രിയാം ദുഷ്ടതാബാഹുല്യഞ്ച നിക്ഷിപ്യ യുഷ്മന്മനസാം പരിത്രാണേ സമർഥം രോപിതം വാക്യം നമ്രഭാവേന ഗൃഹ്ലീത|</para>
  <para style="p">
    <verse number="22" style="v"/>അപരഞ്ച യൂയം കേവലമ് ആത്മവഞ്ചയിതാരോ വാക്യസ്യ ശ്രോതാരോ ന ഭവത കിന്തു വാക്യസ്യ കർമ്മകാരിണോ ഭവത|</para>
  <para style="p">
    <verse number="23" style="v"/>യതോ യഃ കശ്ചിദ് വാക്യസ്യ കർമ്മകാരീ ന ഭൂത്വാ കേവലം തസ്യ ശ്രോതാ ഭവതി സ ദർപണേ സ്വീയശാരീരികവദനം നിരീക്ഷമാണസ്യ മനുജസ്യ സദൃശഃ|</para>
  <para style="p">
    <verse number="24" style="v"/>ആത്മാകാരേ ദൃഷ്ടേ സ പ്രസ്ഥായ കീദൃശ ആസീത് തത് തത്ക്ഷണാദ് വിസ്മരതി|</para>
  <para style="p">
    <verse number="25" style="v"/>കിന്തു യഃ കശ്ചിത് നത്വാ മുക്തേഃ സിദ്ധാം വ്യവസ്ഥാമ് ആലോക്യ തിഷ്ഠതി സ വിസ്മൃതിയുക്തഃ ശ്രോതാ ന ഭൂത്വാ കർമ്മകർത്തൈവ സൻ സ്വകാര്യ്യേ ധന്യോ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="26" style="v"/>അനായത്തരസനഃ സൻ യഃ കശ്ചിത് സ്വമനോ വഞ്ചയിത്വാ സ്വം ഭക്തം മന്യതേ തസ്യ ഭക്തി ർമുധാ ഭവതി|</para>
  <para style="p">
    <verse number="27" style="v"/>ക്ലേശകാലേ പിതൃഹീനാനാം വിധവാനാഞ്ച യദ് അവേക്ഷണം സംസാരാച്ച നിഷ്കലങ്കേന യദ് ആത്മരക്ഷണം തദേവ പിതുരീശ്വരസ്യ സാക്ഷാത് ശുചി ർനിർമ്മലാ ച ഭക്തിഃ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഹേ മമ ഭ്രാതരഃ, യൂയമ് അസ്മാകം തേജസ്വിനഃ പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യ ധർമ്മം മുഖാപേക്ഷയാ ന ധാരയത|</para>
  <para style="p">
    <verse number="2" style="v"/>യതോ യുഷ്മാകം സഭായാം സ്വർണാങ്ഗുരീയകയുക്തേ ഭ്രാജിഷ്ണുപരിച്ഛദേ പുരുഷേ പ്രവിഷ്ടേ മലിനവസ്ത്രേ കസ്മിംശ്ചിദ് ദരിദ്രേഽപി പ്രവിഷ്ടേ</para>
  <para style="p">
    <verse number="3" style="v"/>യൂയം യദി തം ഭ്രാജിഷ്ണുപരിച്ഛദവസാനം ജനം നിരീക്ഷ്യ വദേത ഭവാൻ അത്രോത്തമസ്ഥാന ഉപവിശത്വിതി കിഞ്ച തം ദരിദ്രം യദി വദേത ത്വമ് അമുസ്മിൻ സ്ഥാനേ തിഷ്ഠ യദ്വാത്ര മമ പാദപീഠ ഉപവിശേതി,</para>
  <para style="p">
    <verse number="4" style="v"/>തർഹി മനഃസു വിശേഷ്യ യൂയം കിം കുതർകൈഃ കുവിചാരകാ ന ഭവഥ?</para>
  <para style="p">
    <verse number="5" style="v"/>ഹേ മമ പ്രിയഭ്രാതരഃ, ശൃണുത, സംസാരേ യേ ദരിദ്രാസ്താൻ ഈശ്വരോ വിശ്വാസേന ധനിനഃ സ്വപ്രേമകാരിഭ്യശ്ച പ്രതിശ്രുതസ്യ രാജ്യസ്യാധികാരിണഃ കർത്തും കിം ന വരീതവാൻ? കിന്തു ദരിദ്രോ യുഷ്മാഭിരവജ്ഞായതേ|</para>
  <para style="p">
    <verse number="6" style="v"/>ധനവന്ത ഏവ കിം യുഷ്മാൻ നോപദ്രവന്തി ബലാച്ച വിചാരാസനാനാം സമീപം ന നയന്തി?</para>
  <para style="p">
    <verse number="7" style="v"/>യുഷ്മദുപരി പരികീർത്തിതം പരമം നാമ കിം തൈരേവ ന നിന്ദ്യതേ?</para>
  <para style="p">
    <verse number="8" style="v"/>കിഞ്ച ത്വം സ്വസമീപവാസിനി സ്വാത്മവത് പ്രീയസ്വ, ഏതച്ഛാസ്ത്രീയവചനാനുസാരതോ യദി യൂയം രാജകീയവ്യവസ്ഥാം പാലയഥ തർഹി ഭദ്രം കുരുഥ|</para>
  <para style="p">
    <verse number="9" style="v"/>യദി ച മുഖാപേക്ഷാം കുരുഥ തർഹി പാപമ് ആചരഥ വ്യവസ്ഥയാ ചാജ്ഞാലങ്ഘിന ഇവ ദൂഷ്യധ്വേ|</para>
  <para style="p">
    <verse number="10" style="v"/>യതോ യഃ കശ്ചിത് കൃത്സ്നാം വ്യവസ്ഥാം പാലയതി സ യദ്യേകസ്മിൻ വിധൗ സ്ഖലതി തർഹി സർവ്വേഷാമ് അപരാധീ ഭവതി|</para>
  <para style="p">
    <verse number="11" style="v"/>യതോ ഹേതോസ്ത്വം പരദാരാൻ മാ ഗച്ഛേതി യഃ കഥിതവാൻ സ ഏവ നരഹത്യാം മാ കുര്യ്യാ ഇത്യപി കഥിതവാൻ തസ്മാത് ത്വം പരദാരാൻ ന ഗത്വാ യദി നരഹത്യാം കരോഷി തർഹി വ്യവസ്ഥാലങ്ഘീ ഭവസി|</para>
  <para style="p">
    <verse number="12" style="v"/>മുക്തേ ർവ്യവസ്ഥാതോ യേഷാം വിചാരേണ ഭവിതവ്യം താദൃശാ ലോകാ ഇവ യൂയം കഥാം കഥയത കർമ്മ കുരുത ച|</para>
  <para style="p">
    <verse number="13" style="v"/>യോ ദയാം നാചരതി തസ്യ വിചാരോ നിർദ്ദയേന കാരിഷ്യതേ, കിന്തു ദയാ വിചാരമ് അഭിഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="14" style="v"/>ഹേ മമ ഭ്രാതരഃ, മമ പ്രത്യയോഽസ്തീതി യഃ കഥയതി തസ്യ കർമ്മാണി യദി ന വിദ്യന്ത തർഹി തേന കിം ഫലം? തേന പ്രത്യയേന കിം തസ്യ പരിത്രാണം ഭവിതും ശക്നോതി?</para>
  <para style="p">
    <verse number="15" style="v"/>കേഷുചിദ് ഭ്രാതൃഷു ഭഗിനീഷു വാ വസനഹീനേഷു പ്രാത്യഹികാഹാരഹീനേഷു ച സത്സു യുഷ്മാകം കോഽപി തേഭ്യഃ ശരീരാർഥം പ്രയോജനീയാനി ദ്രവ്യാണി ന ദത്വാ യദി താൻ വദേത്,</para>
  <para style="p">
    <verse number="16" style="v"/>യൂയം സകുശലം ഗത്വോഷ്ണഗാത്രാ ഭവത തൃപ്യത ചേതി തർഹ്യേതേന കിം ഫലം?</para>
  <para style="p">
    <verse number="17" style="v"/>തദ്വത് പ്രത്യയോ യദി കർമ്മഭി ര്യുക്തോ ന ഭവേത് തർഹ്യേകാകിത്വാത് മൃത ഏവാസ്തേ|</para>
  <para style="p">
    <verse number="18" style="v"/>കിഞ്ച കശ്ചിദ് ഇദം വദിഷ്യതി തവ പ്രത്യയോ വിദ്യതേ മമ ച കർമ്മാണി വിദ്യന്തേ, ത്വം കർമ്മഹീനം സ്വപ്രത്യയം മാം ദർശയ തർഹ്യഹമപി മത്കർമ്മഭ്യഃ സ്വപ്രത്യയം ത്വാം ദർശയിഷ്യാമി|</para>
  <para style="p">
    <verse number="19" style="v"/>ഏക ഈശ്വരോ ഽസ്തീതി ത്വം പ്രത്യേഷി| ഭദ്രം കരോഷി| ഭൂതാ അപി തത് പ്രതിയന്തി കമ്പന്തേ ച|</para>
  <para style="p">
    <verse number="20" style="v"/>കിന്തു ഹേ നിർബ്ബോധമാനവ, കർമ്മഹീനഃ പ്രത്യയോ മൃത ഏവാസ്ത്യേതദ് അവഗന്തും കിമ് ഇച്ഛസി?</para>
  <para style="p">
    <verse number="21" style="v"/>അസ്മാകം പൂർവ്വപുരുഷോ യ ഇബ്രാഹീമ് സ്വപുത്രമ് ഇസ്ഹാകം യജ്ഞവേദ്യാമ് ഉത്സൃഷ്ടവാൻ സ കിം കർമ്മഭ്യോ ന സപുണ്യീകൃതഃ?</para>
  <para style="p">
    <verse number="22" style="v"/>പ്രത്യയേ തസ്യ കർമ്മണാം സഹകാരിണി ജാതേ കർമ്മഭിഃ പ്രത്യയഃ സിദ്ധോ ഽഭവത് തത് കിം പശ്യസി?</para>
  <para style="p">
    <verse number="23" style="v"/>ഇത്ഥഞ്ചേദം ശാസ്ത്രീയവചനം സഫലമ് അഭവത്, ഇബ്രാഹീമ് പരമേശ്വരേ വിശ്വസിതവാൻ തച്ച തസ്യ പുണ്യായാഗണ്യത സ ചേശ്വരസ്യ മിത്ര ഇതി നാമ ലബ്ധവാൻ|</para>
  <para style="p">
    <verse number="24" style="v"/>പശ്യത മാനവഃ കർമ്മഭ്യഃ സപുണ്യീക്രിയതേ ന ചൈകാകിനാ പ്രത്യയേന|</para>
  <para style="p">
    <verse number="25" style="v"/>തദ്വദ് യാ രാഹബ്നാമികാ വാരാങ്ഗനാ ചാരാൻ അനുഗൃഹ്യാപരേണ മാർഗേണ വിസസർജ സാപി കിം കർമ്മഭ്യോ ന സപുണ്യീകൃതാ?</para>
  <para style="p">
    <verse number="26" style="v"/>അതഏവാത്മഹീനോ ദേഹോ യഥാ മൃതോഽസ്തി തഥൈവ കർമ്മഹീനഃ പ്രത്യയോഽപി മൃതോഽസ്തി|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഹേ മമ ഭ്രാതരഃ, ശിക്ഷകൈരസ്മാഭി ർഗുരുതരദണ്ഡോ ലപ്സ്യത ഇതി ജ്ഞാത്വാ യൂയമ് അനേകേ ശിക്ഷകാ മാ ഭവത|</para>
  <para style="p">
    <verse number="2" style="v"/>യതഃ സർവ്വേ വയം ബഹുവിഷയേഷു സ്ഖലാമഃ, യഃ കശ്ചിദ് വാക്യേ ന സ്ഖലതി സ സിദ്ധപുരുഷഃ കൃത്സ്നം വശീകർത്തും സമർഥശ്ചാസ്തി|</para>
  <para style="p">
    <verse number="3" style="v"/>പശ്യത വയമ് അശ്വാൻ വശീകർത്തും തേഷാം വക്ത്രേഷു ഖലീനാൻ നിധായ തേഷാം കൃത്സ്നം ശരീരമ് അനുവർത്തയാമഃ|</para>
  <para style="p">
    <verse number="4" style="v"/>പശ്യത യേ പോതാ അതീവ ബൃഹദാകാരാഃ പ്രചണ്ഡവാതൈശ്ച ചാലിതാസ്തേഽപി കർണധാരസ്യ മനോഽഭിമതാദ് അതിക്ഷുദ്രേണ കർണേന വാഞ്ഛിതം സ്ഥാനം പ്രത്യനുവർത്തന്തേ|</para>
  <para style="p">
    <verse number="5" style="v"/>തദ്വദ് രസനാപി ക്ഷുദ്രതരാങ്ഗം സന്തീ ദർപവാക്യാനി ഭാഷതേ| പശ്യ കീദൃങ്മഹാരണ്യം ദഹ്യതേ ഽൽപേന വഹ്നിനാ|</para>
  <para style="p">
    <verse number="6" style="v"/>രസനാപി ഭവേദ് വഹ്നിരധർമ്മരൂപപിഷ്ടപേ| അസ്മദങ്ഗേഷു രസനാ താദൃശം സന്തിഷ്ഠതി സാ കൃത്സ്നം ദേഹം കലങ്കയതി സൃഷ്ടിരഥസ്യ ചക്രം പ്രജ്വലയതി നരകാനലേന ജ്വലതി ച|</para>
  <para style="p">
    <verse number="7" style="v"/>പശുപക്ഷ്യുരോഗജലചരാണാം സർവ്വേഷാം സ്വഭാവോ ദമയിതും ശക്യതേ മാനുഷികസ്വഭാവേന ദമയാഞ്ചക്രേ ച|</para>
  <para style="p">
    <verse number="8" style="v"/>കിന്തു മാനവാനാം കേനാപി ജിഹ്വാ ദമയിതും ന ശക്യതേ സാ ന നിവാര്യ്യമ് അനിഷ്ടം ഹലാഹലവിഷേണ പൂർണാ ച|</para>
  <para style="p">
    <verse number="9" style="v"/>തയാ വയം പിതരമ് ഈശ്വരം ധന്യം വദാമഃ, തയാ ചേശ്വരസ്യ സാദൃശ്യേ സൃഷ്ടാൻ മാനവാൻ ശപാമഃ|</para>
  <para style="p">
    <verse number="10" style="v"/>ഏകസ്മാദ് വദനാദ് ധന്യവാദശാപൗ നിർഗച്ഛതഃ| ഹേ മമ ഭ്രാതരഃ, ഏതാദൃശം ന കർത്തവ്യം|</para>
  <para style="p">
    <verse number="11" style="v"/>പ്രസ്രവണഃ കിമ് ഏകസ്മാത് ഛിദ്രാത് മിഷ്ടം തിക്തഞ്ച തോയം നിർഗമയതി?</para>
  <para style="p">
    <verse number="12" style="v"/>ഹേ മമ ഭ്രാതരഃ, ഉഡുമ്ബരതരുഃ കിം ജിതഫലാനി ദ്രാക്ഷാലതാ വാ കിമ് ഉഡുമ്ബരഫലാനി ഫലിതും ശക്നോതി? തദ്വദ് ഏകഃ പ്രസ്രവണോ ലവണമിഷ്ടേ തോയേ നിർഗമയിതും ന ശക്നോതി|</para>
  <para style="p">
    <verse number="13" style="v"/>യുഷ്മാകം മധ്യേ ജ്ഞാനീ സുബോധശ്ച ക ആസ്തേ? തസ്യ കർമ്മാണി ജ്ഞാനമൂലകമൃദുതായുക്താനീതി സദാചാരാത് സ പ്രമാണയതു|</para>
  <para style="p">
    <verse number="14" style="v"/>കിന്തു യുഷ്മദന്തഃകരണമധ്യേ യദി തിക്തേർഷ്യാ വിവാദേച്ഛാ ച വിദ്യതേ തർഹി സത്യമതസ്യ വിരുദ്ധം ന ശ്ലാഘധ്വം നചാനൃതം കഥയത|</para>
  <para style="p">
    <verse number="15" style="v"/>താദൃശം ജ്ഞാനമ് ഊർദ്ധ്വാദ് ആഗതം നഹി കിന്തു പാർഥിവം ശരീരി ഭൗതികഞ്ച|</para>
  <para style="p">
    <verse number="16" style="v"/>യതോ ഹേതോരീർഷ്യാ വിവാദേച്ഛാ ച യത്ര വേദ്യേതേ തത്രൈവ കലഹഃ സർവ്വം ദുഷ്കൃതഞ്ച വിദ്യതേ|</para>
  <para style="p">
    <verse number="17" style="v"/>കിന്തൂർദ്ധ്വാദ് ആഗതം യത് ജ്ഞാനം തത് പ്രഥമം ശുചി തതഃ പരം ശാന്തം ക്ഷാന്തമ് ആശുസന്ധേയം ദയാദിസത്ഫലൈഃ പരിപൂർണമ് അസന്ദിഗ്ധം നിഷ്കപടഞ്ച ഭവതി|</para>
  <para style="p">
    <verse number="18" style="v"/>ശാന്ത്യാചാരിഭിഃ ശാന്ത്യാ ധർമ്മഫലം രോപ്യതേ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>യുഷ്മാകം മധ്യേ സമരാ രണശ്ച കുത ഉത്പദ്യന്തേ? യുഷ്മദങ്ഗശിബിരാശ്രിതാഭ്യഃ സുഖേച്ഛാഭ്യഃ കിം നോത്പദ്യന്തേे?</para>
  <para style="p">
    <verse number="2" style="v"/>യൂയം വാഞ്ഛഥ കിന്തു നാപ്നുഥ, യൂയം നരഹത്യാമ് ഈർഷ്യാഞ്ച കുരുഥ കിന്തു കൃതാർഥാ ഭവിതും ന ശക്നുഥ, യൂയം യുധ്യഥ രണം കുരുഥ ച കിന്ത്വപ്രാപ്താസ്തിഷ്ഠഥ, യതോ ഹേതോഃ പ്രാർഥനാം ന കുരുഥ|</para>
  <para style="p">
    <verse number="3" style="v"/>യൂയം പ്രാർഥയധ്വേ കിന്തു ന ലഭധ്വേ യതോ ഹേതോഃ സ്വസുഖഭോഗേഷു വ്യയാർഥം കു പ്രാർഥയധ്വേ|</para>
  <para style="p">
    <verse number="4" style="v"/>ഹേ വ്യഭിചാരിണോ വ്യഭിചാരിണ്യശ്ച, സംസാരസ്യ യത് മൈത്ര്യം തദ് ഈശ്വരസ്യ ശാത്രവമിതി യൂയം കിം ന ജാനീഥ? അത ഏവ യഃ കശ്ചിത് സംസാരസ്യ മിത്രം ഭവിതുമ് അഭിലഷതി സ ഏവേശ്വരസ്യ ശത്രു ർഭവതി|</para>
  <para style="p">
    <verse number="5" style="v"/>യൂയം കിം മന്യധ്വേ? ശാസ്ത്രസ്യ വാക്യം കിം ഫലഹീനം ഭവേത്? അസ്മദന്തർവാസീ യ ആത്മാ സ വാ കിമ് ഈർഷ്യാർഥം പ്രേമ കരോതി?</para>
  <para style="p">
    <verse number="6" style="v"/>തന്നഹി കിന്തു സ പ്രതുലം വരം വിതരതി തസ്മാദ് ഉക്തമാസ്തേ യഥാ, ആത്മാഭിമാനലോകാനാം വിപക്ഷോ ഭവതീശ്വരഃ| കിന്തു തേനൈവ നമ്രേഭ്യഃ പ്രസാദാദ് ദീയതേ വരഃ||</para>
  <para style="p">
    <verse number="7" style="v"/>അതഏവ യൂയമ് ഈശ്വരസ്യ വശ്യാ ഭവത ശയതാനം സംരുന്ധ തേന സ യുഷ്മത്തഃ പലായിഷ്യതേ|</para>
  <para style="p">
    <verse number="8" style="v"/>ഈശ്വരസ്യ സമീപവർത്തിനോ ഭവത തേന സ യുഷ്മാകം സമീപവർത്തീ ഭവിഷ്യതി| ഹേ പാപിനഃ, യൂയം സ്വകരാൻ പരിഷ്കുരുധ്വം| ഹേ ദ്വിമനോലോകാഃ, യൂയം സ്വാന്തഃകരണാനി ശുചീനി കുരുധ്വം|</para>
  <para style="p">
    <verse number="9" style="v"/>യൂയമ് ഉദ്വിജധ്വം ശോചത വിലപത ച, യുഷ്മാകം ഹാസഃ ശോകായ, ആനന്ദശ്ച കാതരതായൈ പരിവർത്തേതാം|</para>
  <para style="p">
    <verse number="10" style="v"/>പ്രഭോഃ സമക്ഷം നമ്രാ ഭവത തസ്മാത് സ യുഷ്മാൻ ഉച്ചീകരിഷ്യതി|</para>
  <para style="p">
    <verse number="11" style="v"/>ഹേ ഭ്രാതരഃ, യൂയം പരസ്പരം മാ ദൂഷയത| യഃ കശ്ചിദ് ഭ്രാതരം ദൂഷയതി ഭ്രാതു ർവിചാരഞ്ച കരോതി സ വ്യവസ്ഥാം ദൂഷയതി വ്യവസ്ഥായാശ്ച വിചാരം കരോതി| ത്വം യദി വ്യവസ്ഥായാ വിചാരം കരോഷി തർഹി വ്യവസ്ഥാപാലയിതാ ന ഭവസി കിന്തു വിചാരയിതാ ഭവസി|</para>
  <para style="p">
    <verse number="12" style="v"/>അദ്വിതീയോ വ്യവസ്ഥാപകോ വിചാരയിതാ ച സ ഏവാസ്തേ യോ രക്ഷിതും നാശയിതുഞ്ച പാരയതി| കിന്തു കസ്ത്വം യത് പരസ്യ വിചാരം കരോഷി?</para>
  <para style="p">
    <verse number="13" style="v"/>അദ്യ ശ്വോ വാ വയമ് അമുകനഗരം ഗത്വാ തത്ര വർഷമേകം യാപയന്തോ വാണിജ്യം കരിഷ്യാമഃ ലാഭം പ്രാപ്സ്യാമശ്ചേതി കഥാം ഭാഷമാണാ യൂയമ് ഇദാനീം ശൃണുത|</para>
  <para style="p">
    <verse number="14" style="v"/>ശ്വഃ കിം ഘടിഷ്യതേ തദ് യൂയം ന ജാനീഥ യതോ ജീവനം വോ ഭവേത് കീദൃക് തത്തു ബാഷ്പസ്വരൂപകം, ക്ഷണമാത്രം ഭവേദ് ദൃശ്യം ലുപ്യതേ ച തതഃ പരം|</para>
  <para style="p">
    <verse number="15" style="v"/>തദനുക്ത്വാ യുഷ്മാകമ് ഇദം കഥനീയം പ്രഭോരിച്ഛാതോ വയം യദി ജീവാമസ്തർഹ്യേതത് കർമ്മ തത് കർമ്മ വാ കരിഷ്യാമ ഇതി|</para>
  <para style="p">
    <verse number="16" style="v"/>കിന്ത്വിദാനീം യൂയം ഗർവ്വവാക്യൈഃ ശ്ലാഘനം കുരുധ്വേ താദൃശം സർവ്വം ശ്ലാഘനം കുത്സിതമേവ|</para>
  <para style="p">
    <verse number="17" style="v"/>അതോ യഃ കശ്ചിത് സത്കർമ്മ കർത്തം വിദിത്വാ തന്ന കരോതി തസ്യ പാപം ജായതേ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഹേ ധനവന്തഃ, യൂയമ് ഇദാനീം ശൃണുത യുഷ്മാഭിരാഗമിഷ്യത്ക്ലേശഹേതോഃ ക്രന്ദ്യതാം വിലപ്യതാഞ്ച|</para>
  <para style="p">
    <verse number="2" style="v"/>യുഷ്മാകം ദ്രവിണം ജീർണം കീടഭുക്താഃ സുചേലകാഃ|</para>
  <para style="p">
    <verse number="3" style="v"/>കനകം രജതഞ്ചാപി വികൃതിം പ്രഗമിഷ്യതി, തത്കലങ്കശ്ച യുഷ്മാകം പാപം പ്രമാണയിഷ്യതി, ഹുതാശവച്ച യുഷ്മാകം പിശിതം ഖാദയിഷ്യതി| ഇത്ഥമ് അന്തിമഘസ്രേഷു യുഷ്മാഭിഃ സഞ്ചിതം ധനം|</para>
  <para style="p">
    <verse number="4" style="v"/>പശ്യത യൈഃ കൃഷീവലൈ ര്യുഷ്മാകം ശസ്യാനി ഛിന്നാനി തേഭ്യോ യുഷ്മാഭി ര്യദ് വേതനം ഛിന്നം തദ് ഉച്ചൈ ർധ്വനിം കരോതി തേഷാം ശസ്യച്ഛേദകാനാമ് ആർത്തരാവഃ സേനാപതേഃ പരമേശ്വരസ്യ കർണകുഹരം പ്രവിഷ്ടഃ|</para>
  <para style="p">
    <verse number="5" style="v"/>യൂയം പൃഥിവ്യാം സുഖഭോഗം കാമുകതാഞ്ചാരിതവന്തഃ, മഹാഭോജസ്യ ദിന ഇവ നിജാന്തഃകരണാനി പരിതർപിതവന്തശ്ച|</para>
  <para style="p">
    <verse number="6" style="v"/>അപരഞ്ച യുഷ്മാഭി ർധാർമ്മികസ്യ ദണ്ഡാജ്ഞാ ഹത്യാ ചാകാരി തഥാപി സ യുഷ്മാൻ ന പ്രതിരുദ്ധവാൻ|</para>
  <para style="p">
    <verse number="7" style="v"/>ഹേ ഭ്രാതരഃ, യൂയം പ്രഭോരാഗമനം യാവദ് ധൈര്യ്യമാലമ്ബധ്വം| പശ്യത കൃഷിവലോ ഭൂമേ ർബഹുമൂല്യം ഫലം പ്രതീക്ഷമാണോ യാവത് പ്രഥമമ് അന്തിമഞ്ച വൃഷ്ടിജലം ന പ്രാപ്നോതി താവദ് ധൈര്യ്യമ് ആലമ്ബതേ|</para>
  <para style="p">
    <verse number="8" style="v"/>യൂയമപി ധൈര്യ്യമാലമ്ബ്യ സ്വാന്തഃകരണാനി സ്ഥിരീകുരുത, യതഃ പ്രഭോരുപസ്ഥിതിഃ സമീപവർത്തിന്യഭവത്|</para>
  <para style="p">
    <verse number="9" style="v"/>ഹേ ഭ്രാതരഃ, യൂയം യദ് ദണ്ഡ്യാ ന ഭവേത തദർഥം പരസ്പരം ന ഗ്ലായത, പശ്യത വിചാരയിതാ ദ്വാരസമീപേ തിഷ്ഠതി|</para>
  <para style="p">
    <verse number="10" style="v"/>ഹേ മമ ഭ്രാതരഃ, യേ ഭവിഷ്യദ്വാദിനഃ പ്രഭോ ർനാമ്നാ ഭാഷിതവന്തസ്താൻ യൂയം ദുഃഖസഹനസ്യ ധൈര്യ്യസ്യ ച ദൃഷ്ടാന്താൻ ജാനീത|</para>
  <para style="p">
    <verse number="11" style="v"/>പശ്യത ധൈര്യ്യശീലാ അസ്മാഭി ർധന്യാ ഉച്യന്തേ| ആയൂബോ ധൈര്യ്യം യുഷ്മാഭിരശ്രാവി പ്രഭോഃ പരിണാമശ്ചാദർശി യതഃ പ്രഭു ർബഹുകൃപഃ സകരുണശ്ചാസ്തി|</para>
  <para style="p">
    <verse number="12" style="v"/>ഹേ ഭ്രാതരഃ വിശേഷത ഇദം വദാമി സ്വർഗസ്യ വാ പൃഥിവ്യാ വാന്യവസ്തുനോ നാമ ഗൃഹീത്വാ യുഷ്മാഭിഃ കോഽപി ശപഥോ ന ക്രിയതാം, കിന്തു യഥാ ദണ്ഡ്യാ ന ഭവത തദർഥം യുഷ്മാകം തഥൈവ തന്നഹി ചേതിവാക്യം യഥേഷ്ടം ഭവതു|</para>
  <para style="p">
    <verse number="13" style="v"/>യുഷ്മാകം കശ്ചിദ് ദുഃഖീ ഭവതി? സ പ്രാർഥനാം കരോതു| കശ്ചിദ് വാനന്ദിതോ ഭവതി? സ ഗീതം ഗായതു|</para>
  <para style="p">
    <verse number="14" style="v"/>യുഷ്മാകം കശ്ചിത് പീഡിതോ ഽസ്തി? സ സമിതേഃ പ്രാചീനാൻ ആഹ്വാതു തേ ച പഭോ ർനാമ്നാ തം തൈലേനാഭിഷിച്യ തസ്യ കൃതേ പ്രാർഥനാം കുർവ്വന്തു|</para>
  <para style="p">
    <verse number="15" style="v"/>തസ്മാദ് വിശ്വാസജാതപ്രാർഥനയാ സ രോഗീ രക്ഷാം യാസ്യതി പ്രഭുശ്ച തമ് ഉത്ഥാപയിഷ്യതി യദി ച കൃതപാപോ ഭവേത് തർഹി സ തം ക്ഷമിഷ്യതേ|</para>
  <para style="p">
    <verse number="16" style="v"/>യൂയം പരസ്പരമ് അപരാധാൻ അങ്ഗീകുരുധ്വമ് ആരോഗ്യപ്രാപ്ത്യർഥഞ്ചൈകജനോ ഽന്യസ്യ കൃതേ പ്രാർഥനാം കരോതു ധാർമ്മികസ്യ സയത്നാ പ്രാർഥനാ ബഹുശക്തിവിശിഷ്ടാ ഭവതി|</para>
  <para style="p">
    <verse number="17" style="v"/>യ ഏലിയോ വയമിവ സുഖദുഃഖഭോഗീ മർത്ത്യ ആസീത് സ പ്രാർഥനയാനാവൃഷ്ടിം യാചിതവാൻ തേന ദേശേ സാർദ്ധവത്സരത്രയം യാവദ് വൃഷ്ടി ർന ബഭൂവ|</para>
  <para style="p">
    <verse number="18" style="v"/>പശ്ചാത് തേന പുനഃ പ്രാർഥനായാം കൃതായാമ് ആകാശസ്തോയാന്യവർഷീത് പൃഥിവീ ച സ്വഫലാനി പ്രാരോഹയത്|</para>
  <para style="p">
    <verse number="19" style="v"/>ഹേ ഭ്രാതരഃ, യുഷ്മാകം കസ്മിംശ്ചിത് സത്യമതാദ് ഭ്രഷ്ടേ യദി കശ്ചിത് തം പരാവർത്തയതി</para>
  <para style="p">
    <verse number="20" style="v"/>തർഹി യോ ജനഃ പാപിനം വിപഥഭ്രമണാത് പരാവർത്തയതി സ തസ്യാത്മാനം മൃത്യുത ഉദ്ധരിഷ്യതി ബഹുപാപാന്യാവരിഷ്യതി ചേതി ജാനാതു|</para>
</usx>
