<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1PE" style="id">Sanskrit Bible (NT) in Malayalam Script (സത്യവേദഃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 Peter</para>
  <para style="toc1">1 പിതരസ്യ പത്രം</para>
  <para style="toc2">1 പിതരഃ</para>
  <para style="toc3">1 പിതരഃ</para>
  <para style="mt1">1 പിതരസ്യ പത്രം</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>പന്ത-ഗാലാതിയാ-കപ്പദകിയാ-ആശിയാ-ബിഥുനിയാദേശേഷു പ്രവാസിനോ യേ വികീർണലോകാഃ</para>
  <para style="p">
    <verse number="2" style="v"/>പിതുരീശ്വരസ്യ പൂർവ്വനിർണയാദ് ആത്മനഃ പാവനേന യീശുഖ്രീഷ്ടസ്യാജ്ഞാഗ്രഹണായ ശോണിതപ്രോക്ഷണായ ചാഭിരുചിതാസ്താൻ പ്രതി യീശുഖ്രീഷ്ടസ്യ പ്രേരിതഃ പിതരഃ പത്രം ലിഖതി| യുഷ്മാൻ പ്രതി ബാഹുല്യേന ശാന്തിരനുഗ്രഹശ്ച ഭൂയാസ്താം|</para>
  <para style="p">
    <verse number="3" style="v"/>അസ്മാകം പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യ താത ഈശ്വരോ ധന്യഃ, യതഃ സ സ്വകീയബഹുകൃപാതോ മൃതഗണമധ്യാദ് യീശുഖ്രീഷ്ടസ്യോത്ഥാനേന ജീവനപ്രത്യാശാർഥമ് അർഥതോ</para>
  <para style="p">
    <verse number="4" style="v"/>ഽക്ഷയനിഷ്കലങ്കാമ്ലാനസമ്പത്തിപ്രാപ്ത്യർഥമ് അസ്മാൻ പുന ർജനയാമാസ| സാ സമ്പത്തിഃ സ്വർഗേ ഽസ്മാകം കൃതേ സഞ്ചിതാ തിഷ്ഠതി,</para>
  <para style="p">
    <verse number="5" style="v"/>യൂയഞ്ചേശ്വരസ്യ ശക്തിതഃ ശേഷകാലേ പ്രകാശ്യപരിത്രാണാർഥം വിശ്വാസേന രക്ഷ്യധ്വേ|</para>
  <para style="p">
    <verse number="6" style="v"/>തസ്മാദ് യൂയം യദ്യപ്യാനന്ദേന പ്രഫുല്ലാ ഭവഥ തഥാപി സാമ്പ്രതം പ്രയോജനഹേതോഃ കിയത്കാലപര്യ്യന്തം നാനാവിധപരീക്ഷാഭിഃ ക്ലിശ്യധ്വേ|</para>
  <para style="p">
    <verse number="7" style="v"/>യതോ വഹ്നിനാ യസ്യ പരീക്ഷാ ഭവതി തസ്മാത് നശ്വരസുവർണാദപി ബഹുമൂല്യം യുഷ്മാകം വിശ്വാസരൂപം യത് പരീക്ഷിതം സ്വർണം തേന യീശുഖ്രീഷ്ടസ്യാഗമനസമയേ പ്രശംസായാഃ സമാദരസ്യ ഗൗരവസ്യ ച യോഗ്യതാ പ്രാപ്തവ്യാ|</para>
  <para style="p">
    <verse number="8" style="v"/>യൂയം തം ഖ്രീഷ്ടമ് അദൃഷ്ട്വാപി തസ്മിൻ പ്രീയധ്വേ സാമ്പ്രതം തം ന പശ്യന്തോഽപി തസ്മിൻ വിശ്വസന്തോ ഽനിർവ്വചനീയേന പ്രഭാവയുക്തേന ചാനന്ദേന പ്രഫുല്ലാ ഭവഥ,</para>
  <para style="p">
    <verse number="9" style="v"/>സ്വവിശ്വാസസ്യ പരിണാമരൂപമ് ആത്മനാം പരിത്രാണം ലഭധ്വേ ച|</para>
  <para style="p">
    <verse number="10" style="v"/>യുഷ്മാസു യോ ഽനുഗ്രഹോ വർത്തതേ തദ്വിഷയേ യ ഈശ്വരീയവാക്യം കഥിതവന്തസ്തേ ഭവിഷ്യദ്വാദിനസ്തസ്യ പരിത്രാണസ്യാന്വേഷണമ് അനുസന്ധാനഞ്ച കൃതവന്തഃ|</para>
  <para style="p">
    <verse number="11" style="v"/>വിശേഷതസ്തേഷാമന്തർവ്വാസീ യഃ ഖ്രീഷ്ടസ്യാത്മാ ഖ്രീഷ്ടേ വർത്തിഷ്യമാണാനി ദുഃഖാനി തദനുഗാമിപ്രഭാവഞ്ച പൂർവ്വം പ്രാകാശയത് തേന കഃ കീദൃശോ വാ സമയോ നിരദിശ്യതൈതസ്യാനുസന്ധാനം കൃതവന്തഃ|</para>
  <para style="p">
    <verse number="12" style="v"/>തതസ്തൈ ർവിഷയൈസ്തേ യന്ന സ്വാൻ കിന്ത്വസ്മാൻ ഉപകുർവ്വന്ത്യേതത് തേഷാം നികടേ പ്രാകാശ്യത| യാംശ്ച താൻ വിഷയാൻ ദിവ്യദൂതാ അപ്യവനതശിരസോ നിരീക്ഷിതുമ് അഭിലഷന്തി തേ വിഷയാഃ സാമ്പ്രതം സ്വർഗാത് പ്രേഷിതസ്യ പവിത്രസ്യാത്മനഃ സഹായ്യാദ് യുഷ്മത്സമീപേ സുസംവാദപ്രചാരയിതൃഭിഃ പ്രാകാശ്യന്ത|</para>
  <para style="p">
    <verse number="13" style="v"/>അതഏവ യൂയം മനഃകടിബന്ധനം കൃത്വാ പ്രബുദ്ധാഃ സന്തോ യീശുഖ്രീഷ്ടസ്യ പ്രകാശസമയേ യുഷ്മാസു വർത്തിഷ്യമാനസ്യാനുഗ്രഹസ്യ സമ്പൂർണാം പ്രത്യാശാം കുരുത|</para>
  <para style="p">
    <verse number="14" style="v"/>അപരം പൂർവ്വീയാജ്ഞാനതാവസ്ഥായാഃ കുത്സിതാഭിലാഷാണാം യോഗ്യമ് ആചാരം ന കുർവ്വന്തോ യുഷ്മദാഹ്വാനകാരീ യഥാ പവിത്രോ ഽസ്തി</para>
  <para style="p">
    <verse number="15" style="v"/>യൂയമപ്യാജ്ഞാഗ്രാഹിസന്താനാ ഇവ സർവ്വസ്മിൻ ആചാരേ താദൃക് പവിത്രാ ഭവത|</para>
  <para style="p">
    <verse number="16" style="v"/>യതോ ലിഖിതമ് ആസ്തേ, യൂയം പവിത്രാസ്തിഷ്ഠത യസ്മാദഹം പവിത്രഃ|</para>
  <para style="p">
    <verse number="17" style="v"/>അപരഞ്ച യോ വിനാപക്ഷപാതമ് ഏകൈകമാനുഷസ്യ കർമ്മാനുസാരാദ് വിചാരം കരോതി സ യദി യുഷ്മാഭിസ്താത ആഖ്യായതേ തർഹി സ്വപ്രവാസസ്യ കാലോ യുഷ്മാഭി ർഭീത്യാ യാപ്യതാം|</para>
  <para style="p">
    <verse number="18" style="v"/>യൂയം നിരർഥകാത് പൈതൃകാചാരാത് ക്ഷയണീയൈ രൂപ്യസുവർണാദിഭി ർമുക്തിം ന പ്രാപ്യ</para>
  <para style="p">
    <verse number="19" style="v"/>നിഷ്കലങ്കനിർമ്മലമേഷശാവകസ്യേവ ഖ്രീഷ്ടസ്യ ബഹുമൂല്യേന രുധിരേണ മുക്തിം പ്രാപ്തവന്ത ഇതി ജാനീഥ|</para>
  <para style="p">
    <verse number="20" style="v"/>സ ജഗതോ ഭിത്തിമൂലസ്ഥാപനാത് പൂർവ്വം നിയുക്തഃ കിന്തു ചരമദിനേഷു യുഷ്മദർഥം പ്രകാശിതോ ഽഭവത്|</para>
  <para style="p">
    <verse number="21" style="v"/>യതസ്തേനൈവ മൃതഗണാത് തസ്യോത്ഥാപയിതരി തസ്മൈ ഗൗരവദാതരി ചേശ്വരേ വിശ്വസിഥ തസ്മാദ് ഈശ്വരേ യുഷ്മാകം വിശ്വാസഃ പ്രത്യാശാ ചാസ്തേ|</para>
  <para style="p">
    <verse number="22" style="v"/>യൂയമ് ആത്മനാ സത്യമതസ്യാജ്ഞാഗ്രഹണദ്വാരാ നിഷ്കപടായ ഭ്രാതൃപ്രേമ്നേ പാവിതമനസോ ഭൂത്വാ നിർമ്മലാന്തഃകരണൈഃ പരസ്പരം ഗാഢം പ്രേമ കുരുത|</para>
  <para style="p">
    <verse number="23" style="v"/>യസ്മാദ് യൂയം ക്ഷയണീയവീര്യ്യാത് നഹി കിന്ത്വക്ഷയണീയവീര്യ്യാദ് ഈശ്വരസ്യ ജീവനദായകേന നിത്യസ്ഥായിനാ വാക്യേന പുനർജന്മ ഗൃഹീതവന്തഃ|</para>
  <para style="p">
    <verse number="24" style="v"/>സർവ്വപ്രാണീ തൃണൈസ്തുല്യസ്തത്തേജസ്തൃണപുഷ്പവത്| തൃണാനി പരിശുഷ്യതി പുഷ്പാണി നിപതന്തി ച|</para>
  <para style="p">
    <verse number="25" style="v"/>കിന്തു വാക്യം പരേശസ്യാനന്തകാലം വിതിഷ്ഠതേ| തദേവ ച വാക്യം സുസംവാദേന യുഷ്മാകമ് അന്തികേ പ്രകാശിതം|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>സർവ്വാൻ ദ്വേഷാൻ സർവ്വാംശ്ച ഛലാൻ കാപട്യാനീർഷ്യാഃ സമസ്തഗ്ലാനികഥാശ്ച ദൂരീകൃത്യ</para>
  <para style="p">
    <verse number="2" style="v"/>യുഷ്മാഭിഃ പരിത്രാണായ വൃദ്ധിപ്രാപ്ത്യർഥം നവജാതശിശുഭിരിവ പ്രകൃതം വാഗ്ദുഗ്ധം പിപാസ്യതാം|</para>
  <para style="p">
    <verse number="3" style="v"/>യതഃ പ്രഭു ർമധുര ഏതസ്യാസ്വാദം യൂയം പ്രാപ്തവന്തഃ|</para>
  <para style="p">
    <verse number="4" style="v"/>അപരം മാനുഷൈരവജ്ഞാതസ്യ കിന്ത്വീശ്വരേണാഭിരുചിതസ്യ ബഹുമൂല്യസ്യ ജീവത്പ്രസ്തരസ്യേവ തസ്യ പ്രഭോഃ സന്നിധിമ് ആഗതാ</para>
  <para style="p">
    <verse number="5" style="v"/>യൂയമപി ജീവത്പ്രസ്തരാ ഇവ നിചീയമാനാ ആത്മികമന്ദിരം ഖ്രീഷ്ടേന യീശുനാ ചേശ്വരതോഷകാണാമ് ആത്മികബലീനാം ദാനാർഥം പവിത്രോ യാജകവർഗോ ഭവഥ|</para>
  <para style="p">
    <verse number="6" style="v"/>യതഃ ശാസ്ത്രേ ലിഖിതമാസ്തേ, യഥാ, പശ്യ പാഷാണ ഏകോ ഽസ്തി സീയോനി സ്ഥാപിതോ മയാ| മുഖ്യകോണസ്യ യോഗ്യഃ സ വൃതശ്ചാതീവ മൂല്യവാൻ| യോ ജനോ വിശ്വസേത് തസ്മിൻ സ ലജ്ജാം ന ഗമിഷ്യതി|</para>
  <para style="p">
    <verse number="7" style="v"/>വിശ്വാസിനാം യുഷ്മാകമേവ സമീപേ സ മൂല്യവാൻ ഭവതി കിന്ത്വവിശ്വാസിനാം കൃതേ നിചേതൃഭിരവജ്ഞാതഃ സ പാഷാണഃ കോണസ്യ ഭിത്തിമൂലം ഭൂത്വാ ബാധാജനകഃ പാഷാണഃ സ്ഖലനകാരകശ്ച ശൈലോ ജാതഃ|</para>
  <para style="p">
    <verse number="8" style="v"/>തേ ചാവിശ്വാസാദ് വാക്യേന സ്ഖലന്തി സ്ഖലനേ ച നിയുക്താഃ സന്തി|</para>
  <para style="p">
    <verse number="9" style="v"/>കിന്തു യൂയം യേനാന്ധകാരമധ്യാത് സ്വകീയാശ്ചര്യ്യദീപ്തിമധ്യമ് ആഹൂതാസ്തസ്യ ഗുണാൻ പ്രകാശയിതുമ് അഭിരുചിതോ വംശോ രാജകീയോ യാജകവർഗഃ പവിത്രാ ജാതിരധികർത്തവ്യാഃ പ്രജാശ്ച ജാതാഃ|</para>
  <para style="p">
    <verse number="10" style="v"/>പൂർവ്വം യൂയം തസ്യ പ്രജാ നാഭവത കിന്ത്വിദാനീമ് ഈശ്വരസ്യ പ്രജാ ആധ്വേ| പൂർവ്വമ് അനനുകമ്പിതാ അഭവത കിന്ത്വിദാനീമ് അനുകമ്പിതാ ആധ്വേ|</para>
  <para style="p">
    <verse number="11" style="v"/>ഹേ പ്രിയതമാഃ, യൂയം പ്രവാസിനോ വിദേശിനശ്ച ലോകാ ഇവ മനസഃ പ്രാതികൂല്യേന യോധിഭ്യഃ ശാരീരികസുഖാഭിലാഷേഭ്യോ നിവർത്തധ്വമ് ഇത്യഹം വിനയേ|</para>
  <para style="p">
    <verse number="12" style="v"/>ദേവപൂജകാനാം മധ്യേ യുഷ്മാകമ് ആചാര ഏവമ് ഉത്തമോ ഭവതു യഥാ തേ യുഷ്മാൻ ദുഷ്കർമ്മകാരിലോകാനിവ പുന ർന നിന്ദന്തഃ കൃപാദൃഷ്ടിദിനേ സ്വചക്ഷുർഗോചരീയസത്ക്രിയാഭ്യ ഈശ്വരസ്യ പ്രശംസാം കുര്യ്യുഃ|</para>
  <para style="p">
    <verse number="13" style="v"/>തതോ ഹേതോ ര്യൂയം പ്രഭോരനുരോധാത് മാനവസൃഷ്ടാനാം കർതൃത്വപദാനാം വശീഭവത വിശേഷതോ ഭൂപാലസ്യ യതഃ സ ശ്രേഷ്ഠഃ,</para>
  <para style="p">
    <verse number="14" style="v"/>ദേശാധ്യക്ഷാണാഞ്ച യതസ്തേ ദുഷ്കർമ്മകാരിണാം ദണ്ഡദാനാർഥം സത്കർമ്മകാരിണാം പ്രശംസാർഥഞ്ച തേന പ്രേരിതാഃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ഇത്ഥം നിർബ്ബോധമാനുഷാണാമ് അജ്ഞാനത്വം യത് സദാചാരിഭി ര്യുഷ്മാഭി ർനിരുത്തരീക്രിയതേ തദ് ഈശ്വരസ്യാഭിമതം|</para>
  <para style="p">
    <verse number="16" style="v"/>യൂയം സ്വാധീനാ ഇവാചരത തഥാപി ദുഷ്ടതായാ വേഷസ്വരൂപാം സ്വാധീനതാം ധാരയന്ത ഇവ നഹി കിന്ത്വീശ്വരസ്യ ദാസാ ഇവ|</para>
  <para style="p">
    <verse number="17" style="v"/>സർവ്വാൻ സമാദ്രിയധ്വം ഭ്രാതൃവർഗേ പ്രീയധ്വമ് ഈശ്വരാദ് ബിഭീത ഭൂപാലം സമ്മന്യധ്വം|</para>
  <para style="p">
    <verse number="18" style="v"/>ഹേ ദാസാഃ യൂയം സമ്പൂർണാദരേണ പ്രഭൂനാം വശ്യാ ഭവത കേവലം ഭദ്രാണാം ദയാലൂനാഞ്ച നഹി കിന്ത്വനൃജൂനാമപി|</para>
  <para style="p">
    <verse number="19" style="v"/>യതോ ഽന്യായേന ദുഃഖഭോഗകാല ഈശ്വരചിന്തയാ യത് ക്ലേശസഹനം തദേവ പ്രിയം|</para>
  <para style="p">
    <verse number="20" style="v"/>പാപം കൃത്വാ യുഷ്മാകം ചപേടാഘാതസഹനേന കാ പ്രശംസാ? കിന്തു സദാചാരം കൃത്വാ യുഷ്മാകം യദ് ദുഃഖസഹനം തദേവേശ്വരസ്യ പ്രിയം|</para>
  <para style="p">
    <verse number="21" style="v"/>തദർഥമേവ യൂയമ് ആഹൂതാ യതഃ ഖ്രീഷ്ടോഽപി യുഷ്മന്നിമിത്തം ദുഃഖം ഭുക്ത്വാ യൂയം യത് തസ്യ പദചിഹ്നൈ ർവ്രജേത തദർഥം ദൃഷ്ടാന്തമേകം ദർശിതവാൻ|</para>
  <para style="p">
    <verse number="22" style="v"/>സ കിമപി പാപം ന കൃതവാൻ തസ്യ വദനേ കാപി ഛലസ്യ കഥാ നാസീത്|</para>
  <para style="p">
    <verse number="23" style="v"/>നിന്ദിതോ ഽപി സൻ സ പ്രതിനിന്ദാം ന കൃതവാൻ ദുഃഖം സഹമാനോ ഽപി ന ഭർത്സിതവാൻ കിന്തു യഥാർഥവിചാരയിതുഃ സമീപേ സ്വം സമർപിതവാൻ|</para>
  <para style="p">
    <verse number="24" style="v"/>വയം യത് പാപേഭ്യോ നിവൃത്യ ധർമ്മാർഥം ജീവാമസ്തദർഥം സ സ്വശരീരേണാസ്മാകം പാപാനി ക്രുശ ഊഢവാൻ തസ്യ പ്രഹാരൈ ര്യൂയം സ്വസ്ഥാ അഭവത|</para>
  <para style="p">
    <verse number="25" style="v"/>യതഃ പൂർവ്വം യൂയം ഭ്രമണകാരിമേഷാ ഇവാധ്വം കിന്ത്വധുനാ യുഷ്മാകമ് ആത്മനാം പാലകസ്യാധ്യക്ഷസ്യ ച സമീപം പ്രത്യാവർത്തിതാഃ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഹേ യോഷിതഃ, യൂയമപി നിജസ്വാമിനാം വശ്യാ ഭവത തഥാ സതി യദി കേചിദ് വാക്യേ വിശ്വാസിനോ ന സന്തി തർഹി</para>
  <para style="p">
    <verse number="2" style="v"/>തേ വിനാവാക്യം യോഷിതാമ് ആചാരേണാർഥതസ്തേഷാം പ്രത്യക്ഷേണ യുഷ്മാകം സഭയസതീത്വാചാരേണാക്രഷ്ടും ശക്ഷ്യന്തേ|</para>
  <para style="p">
    <verse number="3" style="v"/>അപരം കേശരചനയാ സ്വർണാലങ്കാരധാരണോന പരിച്ഛദപരിധാനേന വാ യുഷ്മാകം വാഹ്യഭൂഷാ ന ഭവതു,</para>
  <para style="p">
    <verse number="4" style="v"/>കിന്ത്വീശ്വരസ്യ സാക്ഷാദ് ബഹുമൂല്യക്ഷമാശാന്തിഭാവാക്ഷയരത്നേന യുക്തോ ഗുപ്ത ആന്തരികമാനവ ഏവ|</para>
  <para style="p">
    <verse number="5" style="v"/>യതഃ പൂർവ്വകാലേ യാഃ പവിത്രസ്ത്രിയ ഈശ്വരേ പ്രത്യാശാമകുർവ്വൻ താ അപി താദൃശീമേവ ഭൂഷാം ധാരയന്ത്യോ നിജസ്വാമിനാം വശ്യാ അഭവൻ|</para>
  <para style="p">
    <verse number="6" style="v"/>തഥൈവ സാരാ ഇബ്രാഹീമോ വശ്യാ സതീ തം പതിമാഖ്യാതവതീ യൂയഞ്ച യദി സദാചാരിണ്യോ ഭവഥ വ്യാകുലതയാ ച ഭീതാ ന ഭവഥ തർഹി തസ്യാഃ കന്യാ ആധ്വേ|</para>
  <para style="p">
    <verse number="7" style="v"/>ഹേ പുരുഷാഃ, യൂയം ജ്ഞാനതോ ദുർബ്ബലതരഭാജനൈരിവ യോഷിദ്ഭിഃ സഹവാസം കുരുത, ഏകസ്യ ജീവനവരസ്യ സഹഭാഗിനീഭ്യതാഭ്യഃ സമാദരം വിതരത ച ന ചേദ് യുഷ്മാകം പ്രാർഥനാനാം ബാധാ ജനിഷ്യതേ|</para>
  <para style="p">
    <verse number="8" style="v"/>വിശേഷതോ യൂയം സർവ്വ ഏകമനസഃ പരദുഃഖൈ ർദുഃഖിതാ ഭ്രാതൃപ്രമിണഃ കൃപാവന്തഃ പ്രീതിഭാവാശ്ച ഭവത|</para>
  <para style="p">
    <verse number="9" style="v"/>അനിഷ്ടസ്യ പരിശോധേനാനിഷ്ടം നിന്ദായാ വാ പരിശോധേന നിന്ദാം ന കുർവ്വന്ത ആശിഷം ദത്ത യതോ യൂയമ് ആശിരധികാരിണോ ഭവിതുമാഹൂതാ ഇതി ജാനീഥ|</para>
  <para style="p">
    <verse number="10" style="v"/>അപരഞ്ച, ജീവനേ പ്രീയമാണോ യഃ സുദിനാനി ദിദൃക്ഷതേ| പാപാത് ജിഹ്വാം മൃഷാവാക്യാത് സ്വാധരൗ സ നിവർത്തയേത്|</para>
  <para style="p">
    <verse number="11" style="v"/>സ ത്യജേദ് ദുഷ്ടതാമാർഗം സത്ക്രിയാഞ്ച സമാചരേത്| മൃഗയാണശ്ച ശാന്തിം സ നിത്യമേവാനുധാവതു|</para>
  <para style="p">
    <verse number="12" style="v"/>ലോചനേ പരമേശസ്യോന്മീലിതേ ധാർമ്മികാൻ പ്രതി| പ്രാർഥനായാഃ കൃതേ തേഷാഃ തച്ഛ്രോത്രേ സുഗമേ സദാ| ക്രോധാസ്യഞ്ച പരേശസ്യ കദാചാരിഷു വർത്തതേ|</para>
  <para style="p">
    <verse number="13" style="v"/>അപരം യദി യൂയമ് ഉത്തമസ്യാനുഗാമിനോ ഭവഥ തർഹി കോ യുഷ്മാൻ ഹിംസിഷ്യതേ?</para>
  <para style="p">
    <verse number="14" style="v"/>യദി ച ധർമ്മാർഥം ക്ലിശ്യധ്വം തർഹി ധന്യാ ഭവിഷ്യഥ| തേഷാമ് ആശങ്കയാ യൂയം ന ബിഭീത ന വിങ്ക്ത വാ|</para>
  <para style="p">
    <verse number="15" style="v"/>മനോഭിഃ കിന്തു മന്യധ്വം പവിത്രം പ്രഭുമീശ്വരം| അപരഞ്ച യുഷ്മാകമ് ആന്തരികപ്രത്യാശായാസ്തത്ത്വം യഃ കശ്ചിത് പൃച്ഛതി തസ്മൈ ശാന്തിഭീതിഭ്യാമ് ഉത്തരം ദാതും സദാ സുസജ്ജാ ഭവത|</para>
  <para style="p">
    <verse number="16" style="v"/>യേ ച ഖ്രീഷ്ടധർമ്മേ യുഷ്മാകം സദാചാരം ദൂഷയന്തി തേ ദുഷ്കർമ്മകാരിണാമിവ യുഷ്മാകമ് അപവാദേന യത് ലജ്ജിതാ ഭവേയുസ്തദർഥം യുഷ്മാകമ് ഉത്തമഃ സംവേദോ ഭവതു|</para>
  <para style="p">
    <verse number="17" style="v"/>ഈശ്വരസ്യാഭിമതാദ് യദി യുഷ്മാഭിഃ ക്ലേശഃ സോഢവ്യസ്തർഹി സദാചാരിഭിഃ ക്ലേശസഹനം വരം ന ച കദാചാരിഭിഃ|</para>
  <para style="p">
    <verse number="18" style="v"/>യസ്മാദ് ഈശ്വരസ്യ സന്നിധിമ് അസ്മാൻ ആനേതുമ് അധാർമ്മികാണാം വിനിമയേന ധാർമ്മികഃ ഖ്രീഷ്ടോ ഽപ്യേകകൃത്വഃ പാപാനാം ദണ്ഡം ഭുക്തവാൻ, സ ച ശരീരസമ്ബന്ധേ മാരിതഃ കിന്ത്വാത്മനഃ സമ്ബന്ധേ പുന ർജീവിതോ ഽഭവത്|</para>
  <para style="p">
    <verse number="19" style="v"/>തത്സമ്ബന്ധേ ച സ യാത്രാം വിധായ കാരാബദ്ധാനാമ് ആത്മനാം സമീപേ വാക്യം ഘോഷിതവാൻ|</para>
  <para style="p">
    <verse number="20" style="v"/>പുരാ നോഹസ്യ സമയേ യാവത് പോതോ നിരമീയത താവദ് ഈശ്വരസ്യ ദീർഘസഹിഷ്ണുതാ യദാ വ്യലമ്ബത തദാ തേഽനാജ്ഞാഗ്രാഹിണോഽഭവൻ| തേന പോതോനാൽപേഽർഥാദ് അഷ്ടാവേവ പ്രാണിനസ്തോയമ് ഉത്തീർണാഃ|</para>
  <para style="p">
    <verse number="21" style="v"/>തന്നിദർശനഞ്ചാവഗാഹനം (അർഥതഃ ശാരീരികമലിനതായാ യസ്ത്യാഗഃ സ നഹി കിന്ത്വീശ്വരായോത്തമസംവേദസ്യ യാ പ്രതജ്ഞാ സൈവ) യീശുഖ്രീഷ്ടസ്യ പുനരുത്ഥാനേനേദാനീമ് അസ്മാൻ ഉത്താരയതി,</para>
  <para style="p">
    <verse number="22" style="v"/>യതഃ സ സ്വർഗം ഗത്വേശ്വരസ്യ ദക്ഷിണേ വിദ്യതേ സ്വർഗീയദൂതാഃ ശാസകാ ബലാനി ച തസ്യ വശീഭൂതാ അഭവൻ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അസ്മാകം വിനിമയേന ഖ്രീഷ്ടഃ ശരീരസമ്ബന്ധേ ദണ്ഡം ഭുക്തവാൻ അതോ ഹേതോഃ ശരീരസമ്ബന്ധേ യോ ദണ്ഡം ഭുക്തവാൻ സ പാപാത് മുക്ത</para>
  <para style="p">
    <verse number="2" style="v"/>ഇതിഭാവേന യൂയമപി സുസജ്ജീഭൂയ ദേഹവാസസ്യാവശിഷ്ടം സമയം പുനർമാനവാനാമ് ഇച്ഛാസാധനാർഥം നഹി കിന്ത്വീശ്വരസ്യേച്ഛാസാധനാർഥം യാപയത|</para>
  <para style="p">
    <verse number="3" style="v"/>ആയുഷോ യഃ സമയോ വ്യതീതസ്തസ്മിൻ യുഷ്മാഭി ര്യദ് ദേവപൂജകാനാമ് ഇച്ഛാസാധനം കാമകുത്സിതാഭിലാഷമദ്യപാനരങ്ഗരസമത്തതാഘൃണാർഹദേവപൂജാചരണഞ്ചാകാരി തേന ബാഹുല്യം|</para>
  <para style="p">
    <verse number="4" style="v"/>യൂയം തൈഃ സഹ തസ്മിൻ സർവ്വനാശപങ്കേ മജ്ജിതും ന ധാവഥ, ഇത്യനേനാശ്ചര്യ്യം വിജ്ഞായ തേ യുഷ്മാൻ നിന്ദന്തി|</para>
  <para style="p">
    <verse number="5" style="v"/>കിന്തു യോ ജീവതാം മൃതാനാഞ്ച വിചാരം കർത്തുമ് ഉദ്യതോഽസ്തി തസ്മൈ തൈരുത്തരം ദായിഷ്യതേ|</para>
  <para style="p">
    <verse number="6" style="v"/>യതോ ഹേതോ ര്യേ മൃതാസ്തേഷാം യത് മാനവോദ്ദേശ്യഃ ശാരീരികവിചാരഃ കിന്ത്വീശ്വരോദ്ദേശ്യമ് ആത്മികജീവനം ഭവത് തദർഥം തേഷാമപി സന്നിധൗ സുസമാചാരഃ പ്രകാശിതോഽഭവത്|</para>
  <para style="p">
    <verse number="7" style="v"/>സർവ്വേഷാമ് അന്തിമകാല ഉപസ്ഥിതസ്തസ്മാദ് യൂയം സുബുദ്ധയഃ പ്രാർഥനാർഥം ജാഗ്രതശ്ച ഭവത|</para>
  <para style="p">
    <verse number="8" style="v"/>വിശേഷതഃ പരസ്പരം ഗാഢം പ്രേമ കുരുത, യതഃ, പാപാനാമപി ബാഹുല്യം പ്രേമ്നൈവാച്ഛാദയിഷ്യതേ|</para>
  <para style="p">
    <verse number="9" style="v"/>കാതരോക്തിം വിനാ പരസ്പരമ് ആതിഥ്യം കൃരുത|</para>
  <para style="p">
    <verse number="10" style="v"/>യേന യോ വരോ ലബ്ധസ്തേനൈവ സ പരമ് ഉപകരോതൃ, ഇത്ഥം യൂയമ് ഈശ്വരസ്യ ബഹുവിധപ്രസാദസ്യോത്തമാ ഭാണ്ഡാഗാരാധിപാ ഭവത|</para>
  <para style="p">
    <verse number="11" style="v"/>യോ വാക്യം കഥയതി സ ഈശ്വരസ്യ വാക്യമിവ കഥയതു യശ്ച പരമ് ഉപകരോതി സ ഈശ്വരദത്തസാമർഥ്യാദിവോപകരോതു| സർവ്വവിഷയേ യീശുഖ്രീഷ്ടേനേശ്വരസ്യ ഗൗരവം പ്രകാശ്യതാം തസ്യൈവ ഗൗരവം പരാക്രമശ്ച സർവ്വദാ ഭൂയാത്| ആമേന|</para>
  <para style="p">
    <verse number="12" style="v"/>ഹേ പ്രിയതമാഃ, യുഷ്മാകം പരീക്ഷാർഥം യസ്താപോ യുഷ്മാസു വർത്തതേ തമ് അസമ്ഭവഘടിതം മത്വാ നാശ്ചര്യ്യം ജാനീത,</para>
  <para style="p">
    <verse number="13" style="v"/>കിന്തു ഖ്രീഷ്ടേന ക്ലേശാനാം സഹഭാഗിത്വാദ് ആനന്ദത തേന തസ്യ പ്രതാപപ്രകാശേഽപ്യാനനന്ദേന പ്രഫുല്ലാ ഭവിഷ്യഥ|</para>
  <para style="p">
    <verse number="14" style="v"/>യദി ഖ്രീഷ്ടസ്യ നാമഹേതുനാ യുഷ്മാകം നിന്ദാ ഭവതി തർഹി യൂയം ധന്യാ യതോ ഗൗരവദായക ഈശ്വരസ്യാത്മാ യുഷ്മാസ്വധിതിഷ്ഠതി തേഷാം മധ്യേ സ നിന്ദ്യതേ കിന്തു യുഷ്മന്മധ്യേ പ്രശംസ്യതേ|</para>
  <para style="p">
    <verse number="15" style="v"/>കിന്തു യുഷ്മാകം കോഽപി ഹന്താ വാ ചൈരോ വാ ദുഷ്കർമ്മകൃദ് വാ പരാധികാരചർച്ചക ഇവ ദണ്ഡം ന ഭുങ്ക്താം|</para>
  <para style="p">
    <verse number="16" style="v"/>യദി ച ഖ്രീഷ്ടീയാന ഇവ ദണ്ഡം ഭുങ്ക്തേ തർഹി സ ന ലജ്ജമാനസ്തത്കാരണാദ് ഈശ്വരം പ്രശംസതു|</para>
  <para style="p">
    <verse number="17" style="v"/>യതോ വിചാരസ്യാരമ്ഭസമയേ ഈശ്വരസ്യ മന്ദിരേ യുജ്യതേ യദി ചാസ്മത്സ്വാരഭതേ തർഹീശ്വരീയസുസംവാദാഗ്രാഹിണാം ശേഷദശാ കാ ഭവിഷ്യതി?</para>
  <para style="p">
    <verse number="18" style="v"/>ധാർമ്മികേനാപി ചേത് ത്രാണമ് അതികൃച്ഛ്രേണ ഗമ്യതേ| തർഹ്യധാർമ്മികപാപിഭ്യാമ് ആശ്രയഃ കുത്ര ലപ്സ്യതേ|</para>
  <para style="p">
    <verse number="19" style="v"/>അത ഈശ്വരേച്ഛാതോ യേ ദുഃഖം ഭുഞ്ജതേ തേ സദാചാരേണ സ്വാത്മാനോ വിശ്വാസ്യസ്രഷ്ടുരീശ്വസ്യ കരാഭ്യാം നിദധതാം|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഖ്രീഷ്ടസ്യ ക്ലേശാനാം സാക്ഷീ പ്രകാശിഷ്യമാണസ്യ പ്രതാപസ്യാംശീ പ്രാചീനശ്ചാഹം യുഷ്മാകം പ്രാചീനാൻ വിനീയേദം വദാമി|</para>
  <para style="p">
    <verse number="2" style="v"/>യുഷ്മാകം മധ്യവർത്തീ യ ഈശ്വരസ്യ മേഷവൃന്ദോ യൂയം തം പാലയത തസ്യ വീക്ഷണം കുരുത ച, ആവശ്യകത്വേന നഹി കിന്തു സ്വേച്ഛാതോ ന വ കുലോഭേന കിന്ത്വിച്ഛുകമനസാ|</para>
  <para style="p">
    <verse number="3" style="v"/>അപരമ് അംശാനാമ് അധികാരിണ ഇവ ന പ്രഭവത കിന്തു വൃന്ദസ്യ ദൃഷ്ടാന്തസ്വരൂപാ ഭവത|</para>
  <para style="p">
    <verse number="4" style="v"/>തേന പ്രധാനപാലക ഉപസ്ഥിതേ യൂയമ് അമ്ലാനം ഗൗരവകിരീടം ലപ്സ്യധ്വേ|</para>
  <para style="p">
    <verse number="5" style="v"/>ഹേ യുവാനഃ, യൂയമപി പ്രാചീനലോകാനാം വശ്യാ ഭവത സർവ്വേ ച സർവ്വേഷാം വശീഭൂയ നമ്രതാഭരണേന ഭൂഷിതാ ഭവത, യതഃ,ആത്മാഭിമാനിലോകാനാം വിപക്ഷോ ഭവതീശ്വരഃ| കിന്തു തേനൈവ നമ്രേഭ്യഃ പ്രസാദാദ് ദീയതേ വരഃ|</para>
  <para style="p">
    <verse number="6" style="v"/>അതോ യൂയമ് ഈശ്വരസ്യ ബലവത്കരസ്യാധോ നമ്രീഭൂയ തിഷ്ഠത തേന സ ഉചിതസമയേ യുഷ്മാൻ ഉച്ചീകരിഷ്യതി|</para>
  <para style="p">
    <verse number="7" style="v"/>യൂയം സർവ്വചിന്താം തസ്മിൻ നിക്ഷിപത യതഃ സ യുഷ്മാൻ പ്രതി ചിന്തയതി|</para>
  <para style="p">
    <verse number="8" style="v"/>യൂയം പ്രബുദ്ധാ ജാഗ്രതശ്ച തിഷ്ഠത യതോ യുഷ്മാകം പ്രതിവാദീ യഃ ശയതാനഃ സ ഗർജ്ജനകാരീ സിംഹ ഇവ പര്യ്യടൻ കം ഗ്രസിഷ്യാമീതി മൃഗയതേ,</para>
  <para style="p">
    <verse number="9" style="v"/>അതോ വിശ്വാസേ സുസ്ഥിരാസ്തിഷ്ഠന്തസ്തേന സാർദ്ധം യുധ്യത, യുഷ്മാകം ജഗന്നിവാസിഭ്രാതൃഷ്വപി താദൃശാഃ ക്ലേശാ വർത്തന്ത ഇതി ജാനീത|</para>
  <para style="p">
    <verse number="10" style="v"/>ക്ഷണികദുഃഖഭോഗാത് പരമ് അസ്മഭ്യം ഖ്രീഷ്ടേന യീശുനാ സ്വകീയാനന്തഗൗരവദാനാർഥം യോഽസ്മാൻ ആഹൂതവാൻ സ സർവ്വാനുഗ്രാഹീശ്വരഃ സ്വയം യുഷ്മാൻ സിദ്ധാൻ സ്ഥിരാൻ സബലാൻ നിശ്ചലാംശ്ച കരോതു|</para>
  <para style="p">
    <verse number="11" style="v"/>തസ്യ ഗൗരവം പരാക്രമശ്ചാനന്തകാലം യാവദ് ഭൂയാത്| ആമേൻ|</para>
  <para style="p">
    <verse number="12" style="v"/>യഃ സില്വാനോ (മന്യേ) യുഷ്മാകം വിശ്വാസ്യോ ഭ്രാതാ ഭവതി തദ്വാരാഹം സംക്ഷേപേണ ലിഖിത്വാ യുഷ്മാൻ വിനീതവാൻ യൂയഞ്ച യസ്മിൻ അധിതിഷ്ഠഥ സ ഏവേശ്വരസ്യ സത്യോ ഽനുഗ്രഹ ഇതി പ്രമാണം ദത്തവാൻ|</para>
  <para style="p">
    <verse number="13" style="v"/>യുഷ്മാഭിഃ സഹാഭിരുചിതാ യാ സമിതി ർബാബിലി വിദ്യതേ സാ മമ പുത്രോ മാർകശ്ച യുഷ്മാൻ നമസ്കാരം വേദയതി|</para>
  <para style="p">
    <verse number="14" style="v"/>യൂയം പ്രേമചുമ്ബനേന പരസ്പരം നമസ്കുരുത| യീശുഖ്രീഷ്ടാശ്രിതാനാം യുഷ്മാകം സർവ്വേഷാം ശാന്തി ർഭൂയാത്| ആമേൻ|</para>
</usx>
