<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="PHP" style="id">Sanskrit Bible (NT) in Malayalam Script (സത്യവേദഃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Philippians</para>
  <para style="toc1">ഫിലിപിനഃ പത്രം</para>
  <para style="toc2">ഫിലിപിനഃ</para>
  <para style="toc3">ഫിലിപിനഃ</para>
  <para style="mt1">ഫിലിപിനഃ പത്രം</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>പൗലതീമഥിനാമാനൗ യീശുഖ്രീഷ്ടസ്യ ദാസൗ ഫിലിപിനഗരസ്ഥാൻ ഖ്രീഷ്ടയീശോഃ സർവ്വാൻ പവിത്രലോകാൻ സമിതേരധ്യക്ഷാൻ പരിചാരകാംശ്ച പ്രതി പത്രം ലിഖതഃ|</para>
  <para style="p">
    <verse number="2" style="v"/>അസ്മാകം താത ഈശ്വരഃ പ്രഭു ര്യീശുഖ്രീഷ്ടശ്ച യുഷ്മഭ്യം പ്രസാദസ്യ ശാന്തേശ്ച ഭോഗം ദേയാസ്താം|</para>
  <para style="p">
    <verse number="3" style="v"/>അഹം നിരന്തരം നിജസർവ്വപ്രാർഥനാസു യുഷ്മാകം സർവ്വേഷാം കൃതേ സാനന്ദം പ്രാർഥനാം കുർവ്വൻ</para>
  <para style="p">
    <verse number="4" style="v"/>യതി വാരാൻ യുഷ്മാകം സ്മരാമി തതി വാരാൻ ആ പ്രഥമാദ് അദ്യ യാവദ്</para>
  <para style="p">
    <verse number="5" style="v"/>യുഷ്മാകം സുസംവാദഭാഗിത്വകാരണാദ് ഈശ്വരം ധന്യം വദാമി|</para>
  <para style="p">
    <verse number="6" style="v"/>യുഷ്മന്മധ്യേ യേനോത്തമം കർമ്മ കർത്തുമ് ആരമ്ഭി തേനൈവ യീശുഖ്രീഷ്ടസ്യ ദിനം യാവത് തത് സാധയിഷ്യത ഇത്യസ്മിൻ ദൃഢവിശ്വാസോ മമാസ്തേ|</para>
  <para style="p">
    <verse number="7" style="v"/>യുഷ്മാൻ സർവ്വാൻ അധി മമ താദൃശോ ഭാവോ യഥാർഥോ യതോഽഹം കാരാവസ്ഥായാം പ്രത്യുത്തരകരണേ സുസംവാദസ്യ പ്രാമാണ്യകരണേ ച യുഷ്മാൻ സർവ്വാൻ മയാ സാർദ്ധമ് ഏകാനുഗ്രഹസ്യ ഭാഗിനോ മത്വാ സ്വഹൃദയേ ധാരയാമി|</para>
  <para style="p">
    <verse number="8" style="v"/>അപരമ് അഹം ഖ്രീഷ്ടയീശോഃ സ്നേഹവത് സ്നേഹേന യുഷ്മാൻ കീദൃശം കാങ്ക്ഷാമി തദധീശ്വരോ മമ സാക്ഷീ വിദ്യതേ|</para>
  <para style="p">
    <verse number="9" style="v"/>മയാ യത് പ്രാർഥ്യതേ തദ് ഇദം യുഷ്മാകം പ്രേമ നിത്യം വൃദ്ധിം ഗത്വാ</para>
  <para style="p">
    <verse number="10" style="v"/>ജ്ഞാനസ്യ വിശിഷ്ടാനാം പരീക്ഷികായാശ്ച സർവ്വവിധബുദ്ധേ ർബാഹുല്യം ഫലതു,</para>
  <para style="p">
    <verse number="11" style="v"/>ഖ്രീഷ്ടസ്യ ദിനം യാവദ് യുഷ്മാകം സാരല്യം നിർവിഘ്നത്വഞ്ച ഭവതു, ഈശ്വരസ്യ ഗൗരവായ പ്രശംസായൈ ച യീശുനാ ഖ്രീഷ്ടേന പുണ്യഫലാനാം പൂർണതാ യുഷ്മഭ്യം ദീയതാമ് ഇതി|</para>
  <para style="p">
    <verse number="12" style="v"/>ഹേ ഭ്രാതരഃ, മാം പ്രതി യദ് യദ് ഘടിതം തേന സുസംവാദപ്രചാരസ്യ ബാധാ നഹി കിന്തു വൃദ്ധിരേവ ജാതാ തദ് യുഷ്മാൻ ജ്ഞാപയിതും കാമയേഽഹം|</para>
  <para style="p">
    <verse number="13" style="v"/>അപരമ് അഹം ഖ്രീഷ്ടസ്യ കൃതേ ബദ്ധോഽസ്മീതി രാജപുര്യ്യാമ് അന്യസ്ഥാനേഷു ച സർവ്വേഷാം നികടേ സുസ്പഷ്ടമ് അഭവത്,</para>
  <para style="p">
    <verse number="14" style="v"/>പ്രഭുസമ്ബന്ധീയാ അനേകേ ഭ്രാതരശ്ച മമ ബന്ധനാദ് ആശ്വാസം പ്രാപ്യ വർദ്ധമാനേനോത്സാഹേന നിഃക്ഷോഭം കഥാം പ്രചാരയന്തി|</para>
  <para style="p">
    <verse number="15" style="v"/>കേചിദ് ദ്വേഷാദ് വിരോധാച്ചാപരേ കേചിച്ച സദ്ഭാവാത് ഖ്രീഷ്ടം ഘോഷയന്തി;</para>
  <para style="p">
    <verse number="16" style="v"/>യേ വിരോധാത് ഖ്രീഷ്ടം ഘോഷയന്തി തേ പവിത്രഭാവാത് തന്ന കുർവ്വന്തോ മമ ബന്ധനാനി ബഹുതരക്ലോശദായീനി കർത്തുമ് ഇച്ഛന്തി|</para>
  <para style="p">
    <verse number="17" style="v"/>യേ ച പ്രേമ്നാ ഘോഷയന്തി തേ സുസംവാദസ്യ പ്രാമാണ്യകരണേഽഹം നിയുക്തോഽസ്മീതി ജ്ഞാത്വാ തത് കുർവ്വന്തി|</para>
  <para style="p">
    <verse number="18" style="v"/>കിം ബഹുനാ? കാപട്യാത് സരലഭാവാദ് വാ ഭവേത്, യേന കേനചിത് പ്രകാരേണ ഖ്രീഷ്ടസ്യ ഘോഷണാ ഭവതീത്യസ്മിൻ അഹമ് ആനന്ദാമ്യാനന്ദിഷ്യാമി ച|</para>
  <para style="p">
    <verse number="19" style="v"/>യുഷ്മാകം പ്രാർഥനയാ യീശുഖ്രീഷ്ടസ്യാത്മനശ്ചോപകാരേണ തത് മന്നിസ്താരജനകം ഭവിഷ്യതീതി ജാനാമി|</para>
  <para style="p">
    <verse number="20" style="v"/>തത്ര ച മമാകാങ്ക്ഷാ പ്രത്യാശാ ച സിദ്ധിം ഗമിഷ്യതി ഫലതോഽഹം കേനാപി പ്രകാരേണ ന ലജ്ജിഷ്യേ കിന്തു ഗതേ സർവ്വസ്മിൻ കാലേ യദ്വത് തദ്വദ് ഇദാനീമപി സമ്പൂർണോത്സാഹദ്വാരാ മമ ശരീരേണ ഖ്രീഷ്ടസ്യ മഹിമാ ജീവനേ മരണേ വാ പ്രകാശിഷ്യതേ|</para>
  <para style="p">
    <verse number="21" style="v"/>യതോ മമ ജീവനം ഖ്രീഷ്ടായ മരണഞ്ച ലാഭായ|</para>
  <para style="p">
    <verse number="22" style="v"/>കിന്തു യദി ശരീരേ മയാ ജീവിതവ്യം തർഹി തത് കർമ്മഫലം ഫലിഷ്യതി തസ്മാത് കിം വരിതവ്യം തന്മയാ ന ജ്ഞായതേ|</para>
  <para style="p">
    <verse number="23" style="v"/>ദ്വാഭ്യാമ് അഹം സമ്പീഡ്യേ, ദേഹവാസത്യജനായ ഖ്രീഷ്ടേന സഹവാസായ ച മമാഭിലാഷോ ഭവതി യതസ്തത് സർവ്വോത്തമം|</para>
  <para style="p">
    <verse number="24" style="v"/>കിന്തു ദേഹേ മമാവസ്ഥിത്യാ യുഷ്മാകമ് അധികപ്രയോജനം|</para>
  <para style="p">
    <verse number="25" style="v"/>അഹമ് അവസ്ഥാസ്യേ യുഷ്മാഭിഃ സർവ്വൈഃ സാർദ്ധമ് അവസ്ഥിതിം കരിഷ്യേ ച തയാ ച വിശ്വാസേ യുഷ്മാകം വൃദ്ധ്യാനന്ദൗ ജനിഷ്യേതേ തദഹം നിശ്ചിതം ജാനാമി|</para>
  <para style="p">
    <verse number="26" style="v"/>തേന ച മത്തോഽർഥതോ യുഷ്മത്സമീപേ മമ പുനരുപസ്ഥിതത്വാത് യൂയം ഖ്രീഷ്ടേന യീശുനാ ബഹുതരമ് ആഹ്ലാദം ലപ്സ്യധ്വേ|</para>
  <para style="p">
    <verse number="27" style="v"/>യൂയം സാവധാനാ ഭൂത്വാ ഖ്രീഷ്ടസ്യ സുസംവാദസ്യോപയുക്തമ് ആചാരം കുരുധ്വം യതോഽഹം യുഷ്മാൻ ഉപാഗത്യ സാക്ഷാത് കുർവ്വൻ കിം വാ ദൂരേ തിഷ്ഠൻ യുഷ്മാകം യാം വാർത്താം ശ്രോതുമ് ഇച്ഛാമി സേയം യൂയമ് ഏകാത്മാനസ്തിഷ്ഠഥ, ഏകമനസാ സുസംവാദസമ്ബന്ധീയവിശ്വാസസ്യ പക്ഷേ യതധ്വേ, വിപക്ഷൈശ്ച കേനാപി പ്രകാരേണ ന വ്യാകുലീക്രിയധ്വ ഇതി|</para>
  <para style="p">
    <verse number="28" style="v"/>തത് തേഷാം വിനാശസ്യ ലക്ഷണം യുഷ്മാകഞ്ചേശ്വരദത്തം പരിത്രാണസ്യ ലക്ഷണം ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="29" style="v"/>യതോ യേന യുഷ്മാഭിഃ ഖ്രീഷ്ടേ കേവലവിശ്വാസഃ ക്രിയതേ തന്നഹി കിന്തു തസ്യ കൃതേ ക്ലേശോഽപി സഹ്യതേ താദൃശോ വരഃ ഖ്രീഷ്ടസ്യാനുരോധാദ് യുഷ്മാഭിഃ പ്രാപി,</para>
  <para style="p">
    <verse number="30" style="v"/>തസ്മാത് മമ യാദൃശം യുദ്ധം യുഷ്മാഭിരദർശി സാമ്പ്രതം ശ്രൂയതേ ച താദൃശം യുദ്ധം യുഷ്മാകമ് അപി ഭവതി|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഖ്രീഷ്ടാദ് യദി കിമപി സാന്ത്വനം കശ്ചിത് പ്രേമജാതോ ഹർഷഃ കിഞ്ചിദ് ആത്മനഃ സമഭാഗിത്വം കാചിദ് അനുകമ്പാ കൃപാ വാ ജായതേ തർഹി യൂയം മമാഹ്ലാദം പൂരയന്ത</para>
  <para style="p">
    <verse number="2" style="v"/>ഏകഭാവാ ഏകപ്രേമാണ ഏകമനസ ഏകചേഷ്ടാശ്ച ഭവത|</para>
  <para style="p">
    <verse number="3" style="v"/>വിരോധാദ് ദർപാദ് വാ കിമപി മാ കുരുത കിന്തു നമ്രതയാ സ്വേഭ്യോഽപരാൻ വിശിഷ്ടാൻ മന്യധ്വം|</para>
  <para style="p">
    <verse number="4" style="v"/>കേവലമ് ആത്മഹിതായ ന ചേഷ്ടമാനാഃ പരഹിതായാപി ചേഷ്ടധ്വം|</para>
  <para style="p">
    <verse number="5" style="v"/>ഖ്രീഷ്ടസ്യ യീശോ ര്യാദൃശഃ സ്വഭാവോ യുഷ്മാകമ് അപി താദൃശോ ഭവതു|</para>
  <para style="p">
    <verse number="6" style="v"/>സ ഈശ്വരരൂപീ സൻ സ്വകീയാമ് ഈശ്വരതുല്യതാം ശ്ലാഘാസ്പദം നാമന്യത,</para>
  <para style="p">
    <verse number="7" style="v"/>കിന്തു സ്വം ശൂന്യം കൃത്വാ ദാസരൂപീ ബഭൂവ നരാകൃതിം ലേഭേ ച|</para>
  <para style="p">
    <verse number="8" style="v"/>ഇത്ഥം നരമൂർത്തിമ് ആശ്രിത്യ നമ്രതാം സ്വീകൃത്യ മൃത്യോരർഥതഃ ക്രുശീയമൃത്യോരേവ ഭോഗായാജ്ഞാഗ്രാഹീ ബഭൂവ|</para>
  <para style="p">
    <verse number="9" style="v"/>തത്കാരണാദ് ഈശ്വരോഽപി തം സർവ്വോന്നതം ചകാര യച്ച നാമ സർവ്വേഷാം നാമ്നാം ശ്രേഷ്ഠം തദേവ തസ്മൈ ദദൗ,</para>
  <para style="p">
    <verse number="10" style="v"/>തതസ്തസ്മൈ യീശുനാമ്നേ സ്വർഗമർത്യപാതാലസ്ഥിതൈഃ സർവ്വൈ ർജാനുപാതഃ കർത്തവ്യഃ,</para>
  <para style="p">
    <verse number="11" style="v"/>താതസ്ഥേശ്വരസ്യ മഹിമ്നേ ച യീശുഖ്രീഷ്ടഃ പ്രഭുരിതി ജിഹ്വാഭിഃ സ്വീകർത്തവ്യം|</para>
  <para style="p">
    <verse number="12" style="v"/>അതോ ഹേ പ്രിയതമാഃ, യുഷ്മാഭി ര്യദ്വത് സർവ്വദാ ക്രിയതേ തദ്വത് കേവലേ മമോപസ്ഥിതികാലേ തന്നഹി കിന്ത്വിദാനീമ് അനുപസ്ഥിതേഽപി മയി ബഹുതരയത്നേനാജ്ഞാം ഗൃഹീത്വാ ഭയകമ്പാഭ്യാം സ്വസ്വപരിത്രാണം സാധ്യതാം|</para>
  <para style="p">
    <verse number="13" style="v"/>യത ഈശ്വര ഏവ സ്വകീയാനുരോധാദ് യുഷ്മന്മധ്യേ മനസ്കാമനാം കർമ്മസിദ്ധിഞ്ച വിദധാതി|</para>
  <para style="p">
    <verse number="14" style="v"/>യൂയം കലഹവിവാദർവിജതമ് ആചാരം കുർവ്വന്തോഽനിന്ദനീയാ അകുടിലാ</para>
  <para style="p">
    <verse number="15" style="v"/>ഈശ്വരസ്യ നിഷ്കലങ്കാശ്ച സന്താനാഇവ വക്രഭാവാനാം കുടിലാചാരിണാഞ്ച ലോകാനാം മധ്യേ തിഷ്ഠത,</para>
  <para style="p">
    <verse number="16" style="v"/>യതസ്തേഷാം മധ്യേ യൂയം ജീവനവാക്യം ധാരയന്തോ ജഗതോ ദീപകാ ഇവ ദീപ്യധ്വേ| യുഷ്മാഭിസ്തഥാ കൃതേ മമ യത്നഃ പരിശ്രമോ വാ ന നിഷ്ഫലോ ജാത ഇത്യഹം ഖ്രീഷ്ടസ്യ ദിനേ ശ്ലാഘാം കർത്തും ശക്ഷ്യാമി|</para>
  <para style="p">
    <verse number="17" style="v"/>യുഷ്മാകം വിശ്വാസാർഥകായ ബലിദാനായ സേവനായ ച യദ്യപ്യഹം നിവേദിതവ്യോ ഭവേയം തഥാപി തേനാനന്ദാമി സർവ്വേഷാം യുഷ്മാകമ് ആനന്ദസ്യാംശീ ഭവാമി ച|</para>
  <para style="p">
    <verse number="18" style="v"/>തദ്വദ് യൂയമപ്യാനന്ദത മദീയാനന്ദസ്യാംശിനോ ഭവത ച|</para>
  <para style="p">
    <verse number="19" style="v"/>യുഷ്മാകമ് അവസ്ഥാമ് അവഗത്യാഹമപി യത് സാന്ത്വനാം പ്രാപ്നുയാം തദർഥം തീമഥിയം ത്വരയാ യുഷ്മത്സമീപം പ്രേഷയിഷ്യാമീതി പ്രഭൗ പ്രത്യാശാം കുർവ്വേ|</para>
  <para style="p">
    <verse number="20" style="v"/>യഃ സത്യരൂപേണ യുഷ്മാകം ഹിതം ചിന്തയതി താദൃശ ഏകഭാവസ്തസ്മാദന്യഃ കോഽപി മമ സന്നിധൗ നാസ്തി|</para>
  <para style="p">
    <verse number="21" style="v"/>യതോഽപരേ സർവ്വേ യീശോഃ ഖ്രീഷ്ടസ്യ വിഷയാൻ ന ചിന്തയന്ത ആത്മവിഷയാൻ ചിന്തയന്തി|</para>
  <para style="p">
    <verse number="22" style="v"/>കിന്തു തസ്യ പരീക്ഷിതത്വം യുഷ്മാഭി ർജ്ഞായതേ യതഃ പുത്രോ യാദൃക് പിതുഃ സഹകാരീ ഭവതി തഥൈവ സുസംവാദസ്യ പരിചര്യ്യായാം സ മമ സഹകാരീ ജാതഃ|</para>
  <para style="p">
    <verse number="23" style="v"/>അതഏവ മമ ഭാവിദശാം ജ്ഞാത്വാ തത്ക്ഷണാത് തമേവ പ്രേഷയിതും പ്രത്യാശാം കുർവ്വേ</para>
  <para style="p">
    <verse number="24" style="v"/>സ്വയമ് അഹമപി തൂർണം യുഷ്മത്സമീപം ഗമിഷ്യാമീത്യാശാം പ്രഭുനാ കുർവ്വേ|</para>
  <para style="p">
    <verse number="25" style="v"/>അപരം യ ഇപാഫ്രദീതോ മമ ഭ്രാതാ കർമ്മയുദ്ധാഭ്യാം മമ സഹായശ്ച യുഷ്മാകം ദൂതോ മദീയോപകാരായ പ്രതിനിധിശ്ചാസ്തി യുഷ്മത്സമീപേ തസ്യ പ്രേഷണമ് ആവശ്യകമ് അമന്യേ|</para>
  <para style="p">
    <verse number="26" style="v"/>യതഃ സ യുഷ്മാൻ സർവ്വാൻ അകാങ്ക്ഷത യുഷ്മാഭിസ്തസ്യ രോഗസ്യ വാർത്താശ്രാവീതി ബുദ്ധ്വാ പര്യ്യശോചച്ച|</para>
  <para style="p">
    <verse number="27" style="v"/>സ പീഡയാ മൃതകൽപോഽഭവദിതി സത്യം കിന്ത്വീശ്വരസ്തം ദയിതവാൻ മമ ച ദുഃഖാത് പരം പുനർദുഃഖം യന്ന ഭവേത് തദർഥം കേവലം തം ന ദയിത്വാ മാമപി ദയിതവാൻ|</para>
  <para style="p">
    <verse number="28" style="v"/>അതഏവ യൂയം തം വിലോക്യ യത് പുനരാനന്ദേത മമാപി ദുഃഖസ്യ ഹ്രാസോ യദ് ഭവേത് തദർഥമ് അഹം ത്വരയാ തമ് അപ്രേഷയം|</para>
  <para style="p">
    <verse number="29" style="v"/>അതോ യൂയം പ്രഭോഃ കൃതേ സമ്പൂർണേനാനന്ദേന തം ഗൃഹ്ലീത താദൃശാൻ ലോകാംശ്ചാദരണീയാൻ മന്യധ്വം|</para>
  <para style="p">
    <verse number="30" style="v"/>യതോ മമ സേവനേ യുഷ്മാകം ത്രുടിം പൂരയിതും സ പ്രാണാൻ പണീകൃത്യ ഖ്രീഷ്ടസ്യ കാര്യ്യാർഥം മൃതപ്രായേഽഭവത്|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഹേ ഭ്രാതരഃ, ശേഷേ വദാമി യൂയം പ്രഭാവാനന്ദത| പുനഃ പുനരേകസ്യ വചോ ലേഖനം മമ ക്ലേശദം നഹി യുഷ്മദർഥഞ്ച ഭ്രമനാശകം ഭവതി|</para>
  <para style="p">
    <verse number="2" style="v"/>യൂയം കുക്കുരേഭ്യഃ സാവധാനാ ഭവത ദുഷ്കർമ്മകാരിഭ്യഃ സാവധാനാ ഭവത ഛിന്നമൂലേഭ്യോ ലോകേഭ്യശ്ച സാവധാനാ ഭവത|</para>
  <para style="p">
    <verse number="3" style="v"/>വയമേവ ഛിന്നത്വചോ ലോകാ യതോ വയമ് ആത്മനേശ്വരം സേവാമഹേ ഖ്രീഷ്ടേന യീശുനാ ശ്ലാഘാമഹേ ശരീരേണ ച പ്രഗൽഭതാം ന കുർവ്വാമഹേ|</para>
  <para style="p">
    <verse number="4" style="v"/>കിന്തു ശരീരേ മമ പ്രഗൽഭതായാഃ കാരണം വിദ്യതേ, കശ്ചിദ് യദി ശരീരേണ പ്രഗൽഭതാം ചികീർഷതി തർഹി തസ്മാദ് അപി മമ പ്രഗൽഭതായാ ഗുരുതരം കാരണം വിദ്യതേ|</para>
  <para style="p">
    <verse number="5" style="v"/>യതോഽഹമ് അഷ്ടമദിവസേ ത്വക്ഛേദപ്രാപ്ത ഇസ്രായേല്വംശീയോ ബിന്യാമീനഗോഷ്ഠീയ ഇബ്രികുലജാത ഇബ്രിയോ വ്യവസ്ഥാചരണേ ഫിരൂശീ</para>
  <para style="p">
    <verse number="6" style="v"/>ധർമ്മോത്സാഹകാരണാത് സമിതേരുപദ്രവകാരീ വ്യവസ്ഥാതോ ലഭ്യേ പുണ്യേ ചാനിന്ദനീയഃ|</para>
  <para style="p">
    <verse number="7" style="v"/>കിന്തു മമ യദ്യത് ലഭ്യമ് ആസീത് തത് സർവ്വമ് അഹം ഖ്രീഷ്ടസ്യാനുരോധാത് ക്ഷതിമ് അമന്യേ|</para>
  <para style="p">
    <verse number="8" style="v"/>കിഞ്ചാധുനാപ്യഹം മത്പ്രഭോഃ ഖ്രീഷ്ടസ്യ യീശോ ർജ്ഞാനസ്യോത്കൃഷ്ടതാം ബുദ്ധ്വാ തത് സർവ്വം ക്ഷതിം മന്യേ|</para>
  <para style="p">
    <verse number="9" style="v"/>യതോ ഹേതോരഹം യത് ഖ്രീഷ്ടം ലഭേയ വ്യവസ്ഥാതോ ജാതം സ്വകീയപുണ്യഞ്ച ന ധാരയൻ കിന്തു ഖ്രീഷ്ടേ വിശ്വസനാത് ലഭ്യം യത് പുണ്യമ് ഈശ്വരേണ വിശ്വാസം ദൃഷ്ട്വാ ദീയതേ തദേവ ധാരയൻ യത് ഖ്രീഷ്ടേ വിദ്യേയ തദർഥം തസ്യാനുരോധാത് സർവ്വേഷാം ക്ഷതിം സ്വീകൃത്യ താനി സർവ്വാണ്യവകരാനിവ മന്യേ|</para>
  <para style="p">
    <verse number="10" style="v"/>യതോ ഹേതോരഹം ഖ്രീഷ്ടം തസ്യ പുനരുത്ഥിതേ ർഗുണം തസ്യ ദുഃഖാനാം ഭാഗിത്വഞ്ച ജ്ഞാത്വാ തസ്യ മൃത്യോരാകൃതിഞ്ച ഗൃഹീത്വാ</para>
  <para style="p">
    <verse number="11" style="v"/>യേന കേനചിത് പ്രകാരേണ മൃതാനാം പുനരുത്ഥിതിം പ്രാപ്തും യതേ|</para>
  <para style="p">
    <verse number="12" style="v"/>മയാ തത് സർവ്വമ് അധുനാ പ്രാപി സിദ്ധതാ വാലമ്ഭി തന്നഹി കിന്തു യദർഥമ് അഹം ഖ്രീഷ്ടേന ധാരിതസ്തദ് ധാരയിതും ധാവാമി|</para>
  <para style="p">
    <verse number="13" style="v"/>ഹേ ഭ്രാതരഃ, മയാ തദ് ധാരിതമ് ഇതി ന മന്യതേ കിന്ത്വേതദൈകമാത്രം വദാമി യാനി പശ്ചാത് സ്ഥിതാനി താനി വിസ്മൃത്യാഹമ് അഗ്രസ്ഥിതാന്യുദ്ദിശ്യ</para>
  <para style="p">
    <verse number="14" style="v"/>പൂർണയത്നേന ലക്ഷ്യം പ്രതി ധാവൻ ഖ്രീഷ്ടയീശുനോർദ്ധ്വാത് മാമ് ആഹ്വയത ഈശ്വരാത് ജേതൃപണം പ്രാപ്തും ചേഷ്ടേ|</para>
  <para style="p">
    <verse number="15" style="v"/>അസ്മാകം മധ്യേ യേ സിദ്ധാസ്തൈഃ സർവ്വൈസ്തദേവ ഭാവ്യതാം, യദി ച കഞ്ചന വിഷയമ് അധി യുഷ്മാകമ് അപരോ ഭാവോ ഭവതി തർഹീശ്വരസ്തമപി യുഷ്മാകം പ്രതി പ്രകാശയിഷ്യതി|</para>
  <para style="p">
    <verse number="16" style="v"/>കിന്തു വയം യദ്യദ് അവഗതാ ആസ്മസ്തത്രാസ്മാഭിരേകോ വിധിരാചരിതവ്യ ഏകഭാവൈ ർഭവിതവ്യഞ്ച|</para>
  <para style="p">
    <verse number="17" style="v"/>ഹേ ഭ്രാതരഃ, യൂയം മമാനുഗാമിനോ ഭവത വയഞ്ച യാദൃഗാചരണസ്യ നിദർശനസ്വരൂപാ ഭവാമസ്താദൃഗാചാരിണോ ലോകാൻ ആലോകയധ്വം|</para>
  <para style="p">
    <verse number="18" style="v"/>യതോഽനേകേ വിപഥേ ചരന്തി തേ ച ഖ്രീഷ്ടസ്യ ക്രുശസ്യ ശത്രവ ഇതി പുരാ മയാ പുനഃ പുനഃ കഥിതമ് അധുനാപി രുദതാ മയാ കഥ്യതേ|</para>
  <para style="p">
    <verse number="19" style="v"/>തേഷാം ശേഷദശാ സർവ്വനാശ ഉദരശ്ചേശ്വരോ ലജ്ജാ ച ശ്ലാഘാ പൃഥിവ്യാഞ്ച ലഗ്നം മനഃ|</para>
  <para style="p">
    <verse number="20" style="v"/>കിന്ത്വസ്മാകം ജനപദഃ സ്വർഗേ വിദ്യതേ തസ്മാച്ചാഗമിഷ്യന്തം ത്രാതാരം പ്രഭും യീശുഖ്രീഷ്ടം വയം പ്രതീക്ഷാമഹേ|</para>
  <para style="p">
    <verse number="21" style="v"/>സ ച യയാ ശക്ത്യാ സർവ്വാണ്യേവ സ്വസ്യ വശീകർത്തും പാരയതി തയാസ്മാകമ് അധമം ശരീരം രൂപാന്തരീകൃത്യ സ്വകീയതേജോമയശരീരസ്യ സമാകാരം കരിഷ്യതി|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഹേ മദീയാനന്ദമുകുടസ്വരൂപാഃ പ്രിയതമാ അഭീഷ്ടതമാ ഭ്രാതരഃ, ഹേ മമ സ്നേഹപാത്രാഃ, യൂയമ് ഇത്ഥം പഭൗ സ്ഥിരാസ്തിഷ്ഠത|</para>
  <para style="p">
    <verse number="2" style="v"/>ഹേ ഇവദിയേ ഹേ സുന്തുഖി യുവാം പ്രഭൗ ഏകഭാവേ ഭവതമ് ഏതദ് അഹം പ്രാർഥയേ|</para>
  <para style="p">
    <verse number="3" style="v"/>ഹേ മമ സത്യ സഹകാരിൻ ത്വാമപി വിനീയ വദാമി ഏതയോരുപകാരസ്ത്വയാ ക്രിയതാം യതസ്തേ ക്ലീമിനാദിഭിഃ സഹകാരിഭിഃ സാർദ്ധം സുസംവാദപ്രചാരണായ മമ സാഹായ്യാർഥം പരിശ്രമമ് അകുർവ്വതാം തേഷാം സർവ്വേഷാം നാമാനി ച ജീവനപുസ്തകേ ലിഖിതാനി വിദ്യന്തേ|</para>
  <para style="p">
    <verse number="4" style="v"/>യൂയം പ്രഭൗ സർവ്വദാനന്ദത| പുന ർവദാമി യൂയമ് ആനന്ദത|</para>
  <para style="p">
    <verse number="5" style="v"/>യുഷ്മാകം വിനീതത്വം സർവ്വമാനവൈ ർജ്ഞായതാം, പ്രഭുഃ സന്നിധൗ വിദ്യതേ|</para>
  <para style="p">
    <verse number="6" style="v"/>യൂയം കിമപി ന ചിന്തയത കിന്തു ധന്യവാദയുക്താഭ്യാം പ്രാർഥനായാഞ്ചാഭ്യാം സർവ്വവിഷയേ സ്വപ്രാർഥനീയമ് ഈശ്വരായ നിവേദയത|</para>
  <para style="p">
    <verse number="7" style="v"/>തഥാ കൃത ഈശ്വരീയാ യാ ശാന്തിഃ സർവ്വാം ബുദ്ധിമ് അതിശേതേ സാ യുഷ്മാകം ചിത്താനി മനാംസി ച ഖ്രീഷ്ടേ യീശൗ രക്ഷിഷ്യതി|</para>
  <para style="p">
    <verse number="8" style="v"/>ഹേ ഭ്രാതരഃ, ശേഷേ വദാമി യദ്യത് സത്യമ് ആദരണീയം ന്യായ്യം സാധു പ്രിയം സുഖ്യാതമ് അന്യേണ യേന കേനചിത് പ്രകാരേണ വാ ഗുണയുക്തം പ്രശംസനീയം വാ ഭവതി തത്രൈവ മനാംസി നിധധ്വം|</para>
  <para style="p">
    <verse number="9" style="v"/>യൂയം മാം ദൃഷ്ട്വാ ശ്രുത്വാ ച യദ്യത് ശിക്ഷിതവന്തോ ഗൃഹീതവന്തശ്ച തദേവാചരത തസ്മാത് ശാന്തിദായക ഈശ്വരോ യുഷ്മാഭിഃ സാർദ്ധം സ്ഥാസ്യതി|</para>
  <para style="p">
    <verse number="10" style="v"/>മമോപകാരായ യുഷ്മാകം യാ ചിന്താ പൂർവ്വമ് ആസീത് കിന്തു കർമ്മദ്വാരം ന പ്രാപ്നോത് ഇദാനീം സാ പുനരഫലത് ഇത്യസ്മിൻ പ്രഭൗ മമ പരമാഹ്ലാദോഽജായത|</para>
  <para style="p">
    <verse number="11" style="v"/>അഹം യദ് ദൈന്യകാരണാദ് ഇദം വദാമി തന്നഹി യതോ മമ യാ കാചിദ് അവസ്ഥാ ഭവേത് തസ്യാം സന്തോഷ്ടുമ് അശിക്ഷയം|</para>
  <para style="p">
    <verse number="12" style="v"/>ദരിദ്രതാം ഭോക്തും ശക്നോമി ധനാഢ്യതാമ് അപി ഭോക്തും ശക്നോമി സർവ്വഥാ സർവ്വവിഷയേഷു വിനീതോഽഹം പ്രചുരതാം ക്ഷുധാഞ്ച ധനം ദൈന്യഞ്ചാവഗതോഽസ്മി|</para>
  <para style="p">
    <verse number="13" style="v"/>മമ ശക്തിദായകേന ഖ്രീഷ്ടേന സർവ്വമേവ മയാ ശക്യം ഭവതി|</para>
  <para style="p">
    <verse number="14" style="v"/>കിന്തു യുഷ്മാഭി ർദൈന്യനിവാരണായ മാമ് ഉപകൃത്യ സത്കർമ്മാകാരി|</para>
  <para style="p">
    <verse number="15" style="v"/>ഹേ ഫിലിപീയലോകാഃ, സുസംവാദസ്യോദയകാലേ യദാഹം മാകിദനിയാദേശാത് പ്രതിഷ്ഠേ തദാ കേവലാൻ യുഷ്മാൻ വിനാപരയാ കയാപി സമിത്യാ സഹ ദാനാദാനയോ ർമമ കോഽപി സമ്ബന്ധോ നാസീദ് ഇതി യൂയമപി ജാനീഥ|</para>
  <para style="p">
    <verse number="16" style="v"/>യതോ യുഷ്മാഭി ർമമ പ്രയോജനായ ഥിഷലനീകീനഗരമപി മാം പ്രതി പുനഃ പുനർദാനം പ്രേഷിതം|</para>
  <para style="p">
    <verse number="17" style="v"/>അഹം യദ് ദാനം മൃഗയേ തന്നഹി കിന്തു യുഷ്മാകം ലാഭവർദ്ധകം ഫലം മൃഗയേ|</para>
  <para style="p">
    <verse number="18" style="v"/>കിന്തു മമ കസ്യാപ്യഭാവോ നാസ്തി സർവ്വം പ്രചുരമ് ആസ്തേ യത ഈശ്വരസ്യ ഗ്രാഹ്യം തുഷ്ടിജനകം സുഗന്ധിനൈവേദ്യസ്വരൂപം യുഷ്മാകം ദാനം ഇപാഫ്രദിതാദ് ഗൃഹീത്വാഹം പരിതൃപ്തോഽസ്മി|</para>
  <para style="p">
    <verse number="19" style="v"/>മമേശ്വരോഽപി ഖ്രീഷ്ടേന യീശുനാ സ്വകീയവിഭവനിധിതഃ പ്രയോജനീയം സർവ്വവിഷയം പൂർണരൂപം യുഷ്മഭ്യം ദേയാത്|</para>
  <para style="p">
    <verse number="20" style="v"/>അസ്മാകം പിതുരീശ്വരസ്യ ധന്യവാദോഽനന്തകാലം യാവദ് ഭവതു| ആമേൻ|</para>
  <para style="p">
    <verse number="21" style="v"/>യൂയം യീശുഖ്രീഷ്ടസ്യൈകൈകം പവിത്രജനം നമസ്കുരുത| മമ സങ്ഗിഭ്രാതരോ യൂഷ്മാൻ നമസ്കുർവ്വതേ|</para>
  <para style="p">
    <verse number="22" style="v"/>സർവ്വേ പവിത്രലോകാ വിശേഷതഃ കൈസരസ്യ പരിജനാ യുഷ്മാൻ നമസ്കുർവ്വതേ|</para>
  <para style="p">
    <verse number="23" style="v"/>അസ്മാകം പ്രഭോ ര്യീശുഖ്രീഷ്ടസ്യ പ്രസാദഃ സർവ്വാൻ യുഷ്മാൻ പ്രതി ഭൂയാത്| ആമേൻ|</para>
</usx>
