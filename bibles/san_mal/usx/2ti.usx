<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="2TI" style="id">Sanskrit Bible (NT) in Malayalam Script (സത്യവേദഃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">2 Timothy</para>
  <para style="toc1">2 തീമഥിയം പത്രം</para>
  <para style="toc2">2 തീമഥിയഃ</para>
  <para style="toc3">2 തീമഥിയഃ</para>
  <para style="mt1">2 തീമഥിയം പത്രം</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഖ്രീഷ്ടേന യീശുനാ യാ ജീവനസ്യ പ്രതിജ്ഞാ താമധീശ്വരസ്യേച്ഛയാ യീശോഃ ഖ്രീഷ്ടസ്യൈകഃ പ്രേരിതഃ പൗലോഽഹം സ്വകീയം പ്രിയം ധർമ്മപുത്രം തീമഥിയം പ്രതി പത്രം ലിഖാമി|</para>
  <para style="p">
    <verse number="2" style="v"/>താത ഈശ്വരോഽസ്മാകം പ്രഭു ര്യീശുഖ്രീഷ്ടശ്ച ത്വയി പ്രസാദം ദയാം ശാന്തിഞ്ച ക്രിയാസ്താം|</para>
  <para style="p">
    <verse number="3" style="v"/>അഹമ് ആ പൂർവ്വപുരുഷാത് യമ് ഈശ്വരം പവിത്രമനസാ സേവേ തം ധന്യം വദനം കഥയാമി, അഹമ് അഹോരാത്രം പ്രാർഥനാസമയേ ത്വാം നിരന്തരം സ്മരാമി|</para>
  <para style="p">
    <verse number="4" style="v"/>യശ്ച വിശ്വാസഃ പ്രഥമേ ലോയീനാമികായാം തവ മാതാമഹ്യാമ് ഉനീകീനാമികായാം മാതരി ചാതിഷ്ഠത് തവാന്തരേഽപി തിഷ്ഠതീതി മന്യേ</para>
  <para style="p">
    <verse number="5" style="v"/>തവ തം നിഷ്കപടം വിശ്വാസം മനസി കുർവ്വൻ തവാശ്രുപാതം സ്മരൻ യഥാനന്ദേന പ്രഫല്ലോ ഭവേയം തദർഥം തവ ദർശനമ് ആകാങ്ക്ഷേ|</para>
  <para style="p">
    <verse number="6" style="v"/>അതോ ഹേതോ ർമമ ഹസ്താർപണേന ലബ്ധോ യ ഈശ്വരസ്യ വരസ്ത്വയി വിദ്യതേ തമ് ഉജ്ജ്വാലയിതും ത്വാം സ്മാരയാമി|</para>
  <para style="p">
    <verse number="7" style="v"/>യത ഈശ്വരോഽസ്മഭ്യം ഭയജനകമ് ആത്മാനമ് അദത്ത്വാ ശക്തിപ്രേമസതർകതാനാമ് ആകരമ് ആത്മാനം ദത്തവാൻ|</para>
  <para style="p">
    <verse number="8" style="v"/>അതഏവാസ്മാകം പ്രഭുമധി തസ്യ വന്ദിദാസം മാമധി ച പ്രമാണം ദാതും ന ത്രപസ്വ കിന്ത്വീശ്വരീയശക്ത്യാ സുസംവാദസ്യ കൃതേ ദുഃഖസ്യ സഹഭാഗീ ഭവ|</para>
  <para style="p">
    <verse number="9" style="v"/>സോഽസ്മാൻ പരിത്രാണപാത്രാണി കൃതവാൻ പവിത്രേണാഹ്വാനേനാഹൂതവാംശ്ച; അസ്മത്കർമ്മഹേതുനേതി നഹി സ്വീയനിരൂപാണസ്യ പ്രസാദസ്യ ച കൃതേ തത് കൃതവാൻ| സ പ്രസാദഃ സൃഷ്ടേഃ പൂർവ്വകാലേ ഖ്രീഷ്ടേന യീശുനാസ്മഭ്യമ് അദായി,</para>
  <para style="p">
    <verse number="10" style="v"/>കിന്ത്വധുനാസ്മാകം പരിത്രാതു ര്യീശോഃ ഖ്രീഷ്ടസ്യാഗമനേന പ്രാകാശത| ഖ്രീഷ്ടോ മൃത്യും പരാജിതവാൻ സുസംവാദേന ച ജീവനമ് അമരതാഞ്ച പ്രകാശിതവാൻ|</para>
  <para style="p">
    <verse number="11" style="v"/>തസ്യ ഘോഷയിതാ ദൂതശ്ചാന്യജാതീയാനാം ശിക്ഷകശ്ചാഹം നിയുക്തോഽസ്മി|</para>
  <para style="p">
    <verse number="12" style="v"/>തസ്മാത് കാരണാത് മമായം ക്ലേശോ ഭവതി തേന മമ ലജ്ജാ ന ജായതേ യതോഽഹം യസ്മിൻ വിശ്വസിതവാൻ തമവഗതോഽസ്മി മഹാദിനം യാവത് മമോപനിധേ ർഗോപനസ്യ ശക്തിസ്തസ്യ വിദ്യത ഇതി നിശ്ചിതം ജാനാമി|</para>
  <para style="p">
    <verse number="13" style="v"/>ഹിതദായകാനാം വാക്യാനാമ് ആദർശരൂപേണ മത്തഃ ശ്രുതാഃ ഖ്രീഷ്ടേ യീശൗ വിശ്വാസപ്രേമ്നോഃ കഥാ ധാരയ|</para>
  <para style="p">
    <verse number="14" style="v"/>അപരമ് അസ്മദന്തർവാസിനാ പവിത്രേണാത്മനാ താമുത്തമാമ് ഉപനിധിം ഗോപയ|</para>
  <para style="p">
    <verse number="15" style="v"/>ആശിയാദേശീയാഃ സർവ്വേ മാം ത്യക്തവന്ത ഇതി ത്വം ജാനാസി തേഷാം മധ്യേ ഫൂഗില്ലോ ഹർമ്മഗിനിശ്ച വിദ്യേതേ|</para>
  <para style="p">
    <verse number="16" style="v"/>പ്രഭുരനീഷിഫരസ്യ പരിവാരാൻ പ്രതി കൃപാം വിദധാതു യതഃ സ പുനഃ പുന ർമാമ് ആപ്യായിതവാൻ</para>
  <para style="p">
    <verse number="17" style="v"/>മമ ശൃങ്ഖലേന ന ത്രപിത്വാ രോമാനഗരേ ഉപസ്ഥിതിസമയേ യത്നേന മാം മൃഗയിത്വാ മമോദ്ദേശം പ്രാപ്തവാൻ|</para>
  <para style="p">
    <verse number="18" style="v"/>അതോ വിചാരദിനേ സ യഥാ പ്രഭോഃ കൃപാഭാജനം ഭവേത് താദൃശം വരം പ്രഭുസ്തസ്മൈ ദേയാത്| ഇഫിഷനഗരേഽപി സ കതി പ്രകാരൈ ർമാമ് ഉപകൃതവാൻ തത് ത്വം സമ്യഗ് വേത്സി|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഹേ മമ പുത്ര, ഖ്രീഷ്ടയീശുതോ യോഽനുഗ്രഹസ്തസ്യ ബലേന ത്വം ബലവാൻ ഭവ|</para>
  <para style="p">
    <verse number="2" style="v"/>അപരം ബഹുഭിഃ സാക്ഷിഭിഃ പ്രമാണീകൃതാം യാം ശിക്ഷാം ശ്രുതവാനസി താം വിശ്വാസ്യേഷു പരസ്മൈ ശിക്ഷാദാനേ നിപുണേഷു ച ലോകേഷു സമർപയ|</para>
  <para style="p">
    <verse number="3" style="v"/>ത്വം യീശുഖ്രീഷ്ടസ്യോത്തമോ യോദ്ധേവ ക്ലേശം സഹസ്വ|</para>
  <para style="p">
    <verse number="4" style="v"/>യോ യുദ്ധം കരോതി സ സാംസാരികേ വ്യാപാരേ മഗ്നോ ന ഭവതി കിന്തു സ്വനിയോജയിത്രേ രോചിതും ചേഷ്ടതേ|</para>
  <para style="p">
    <verse number="5" style="v"/>അപരം യോ മല്ലൈ ര്യുധ്യതി സ യദി നിയമാനുസാരേണ ന യുദ്ധ്യതി തർഹി കിരീടം ന ലപ്സ്യതേ|</para>
  <para style="p">
    <verse number="6" style="v"/>അപരം യഃ കൃഷീവലഃ കർമ്മ കരോതി തേന പ്രഥമേന ഫലഭാഗിനാ ഭവിതവ്യം|</para>
  <para style="p">
    <verse number="7" style="v"/>മയാ യദുച്യതേ തത് ത്വയാ ബുധ്യതാം യതഃ പ്രഭുസ്തുഭ്യം സർവ്വത്ര ബുദ്ധിം ദാസ്യതി|</para>
  <para style="p">
    <verse number="8" style="v"/>മമ സുസംവാദസ്യ വചനാനുസാരാദ് ദായൂദ്വംശീയം മൃതഗണമധ്യാദ് ഉത്ഥാപിതഞ്ച യീശും ഖ്രീഷ്ടം സ്മര|</para>
  <para style="p">
    <verse number="9" style="v"/>തത്സുസംവാദകാരണാദ് അഹം ദുഷ്കർമ്മേവ ബന്ധനദശാപര്യ്യന്തം ക്ലേശം ഭുഞ്ജേ കിന്ത്വീശ്വരസ്യ വാക്യമ് അബദ്ധം തിഷ്ഠതി|</para>
  <para style="p">
    <verse number="10" style="v"/>ഖ്രീഷ്ടേന യീശുനാ യദ് അനന്തഗൗരവസഹിതം പരിത്രാണം ജായതേ തദഭിരുചിതൈ ർലോകൈരപി യത് ലഭ്യേത തദർഥമഹം തേഷാം നിമിത്തം സർവ്വാണ്യേതാനി സഹേ|</para>
  <para style="p">
    <verse number="11" style="v"/>അപരമ് ഏഷാ ഭാരതീ സത്യാ യദി വയം തേന സാർദ്ധം മ്രിയാമഹേ തർഹി തേന സാർദ്ധം ജീവിവ്യാമഃ, യദി ച ക്ലേശം സഹാമഹേ തർഹി തേന സാർദ്ധം രാജത്വമപി കരിഷ്യാമഹേ|</para>
  <para style="p">
    <verse number="12" style="v"/>യദി വയം തമ് അനങ്ഗീകുർമ്മസ്തർഹി സോ ഽസ്മാനപ്യനങ്ഗീകരിഷ്യതി|</para>
  <para style="p">
    <verse number="13" style="v"/>യദി വയം ന വിശ്വാസാമസ്തർഹി സ വിശ്വാസ്യസ്തിഷ്ഠതി യതഃ സ്വമ് അപഹ്നോതും ന ശക്നോതി|</para>
  <para style="p">
    <verse number="14" style="v"/>ത്വമേതാനി സ്മാരയൻ തേ യഥാ നിഷ്ഫലം ശ്രോതൃണാം ഭ്രംശജനകം വാഗ്യുദ്ധം ന കുര്യ്യസ്തഥാ പ്രഭോഃ സമക്ഷം ദൃഢം വിനീയാദിശ|</para>
  <para style="p">
    <verse number="15" style="v"/>അപരം ത്വമ് ഈശ്വരസ്യ സാക്ഷാത് സ്വം പരീക്ഷിതമ് അനിന്ദനീയകർമ്മകാരിണഞ്ച സത്യമതസ്യ വാക്യാനാം സദ്വിഭജനേ നിപുണഞ്ച ദർശയിതും യതസ്വ|</para>
  <para style="p">
    <verse number="16" style="v"/>കിന്ത്വപവിത്രാ അനർഥകകഥാ ദൂരീകുരു യതസ്തദാലമ്ബിന ഉത്തരോത്തരമ് അധർമ്മേ വർദ്ധിഷ്യന്തേ,</para>
  <para style="p">
    <verse number="17" style="v"/>തേഷാഞ്ച വാക്യം ഗലിതക്ഷതവത് ക്ഷയവർദ്ധകോ ഭവിഷ്യതി തേഷാം മധ്യേ ഹുമിനായഃ ഫിലീതശ്ചേതിനാമാനൗ ദ്വൗ ജനൗ സത്യമതാദ് ഭ്രഷ്ടൗ ജാതൗ,</para>
  <para style="p">
    <verse number="18" style="v"/>മൃതാനാം പുനരുത്ഥിതി ർവ്യതീതേതി വദന്തൗ കേഷാഞ്ചിദ് വിശ്വാസമ് ഉത്പാടയതശ്ച|</para>
  <para style="p">
    <verse number="19" style="v"/>തഥാപീശ്വരസ്യ ഭിത്തിമൂലമ് അചലം തിഷ്ഠതി തസ്മിംശ്ചേയം ലിപി ർമുദ്രാങ്കിതാ വിദ്യതേ| യഥാ, ജാനാതി പരമേശസ്തു സ്വകീയാൻ സർവ്വമാനവാൻ| അപഗച്ഛേദ് അധർമ്മാച്ച യഃ കശ്ചിത് ഖ്രീഷ്ടനാമകൃത്||</para>
  <para style="p">
    <verse number="20" style="v"/>കിന്തു ബൃഹന്നികേതനേ കേവല സുവർണമയാനി രൗപ്യമയാണി ച ഭാജനാനി വിദ്യന്ത ഇതി തർഹി കാഷ്ഠമയാനി മൃണ്മയാന്യപി വിദ്യന്തേ തേഷാഞ്ച കിയന്തി സമ്മാനായ കിയന്തപമാനായ ച ഭവന്തി|</para>
  <para style="p">
    <verse number="21" style="v"/>അതോ യദി കശ്ചിദ് ഏതാദൃശേഭ്യഃ സ്വം പരിഷ്കരോതി തർഹി സ പാവിതം പ്രഭോഃ കാര്യ്യയോഗ്യം സർവ്വസത്കാര്യ്യായോപയുക്തം സമ്മാനാർഥകഞ്ച ഭാജനം ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="22" style="v"/>യൗവനാവസ്ഥായാ അഭിലാഷാസ്ത്വയാ പരിത്യജ്യന്താം ധർമ്മോ വിശ്വാസഃ പ്രേമ യേ ച ശുചിമനോഭിഃ പ്രഭുമ് ഉദ്ദിശ്യ പ്രാർഥനാം കുർവ്വതേ തൈഃ സാർദ്ധമ് ഐക്യഭാവശ്ചൈതേഷു ത്വയാ യത്നോ വിധീയതാം|</para>
  <para style="p">
    <verse number="23" style="v"/>അപരം ത്വമ് അനർഥകാൻ അജ്ഞാനാംശ്ച പ്രശ്നാൻ വാഗ്യുദ്ധോത്പാദകാൻ ജ്ഞാത്വാ ദൂരീകുരു|</para>
  <para style="p">
    <verse number="24" style="v"/>യതഃ പ്രഭോ ർദാസേന യുദ്ധമ് അകർത്തവ്യം കിന്തു സർവ്വാൻ പ്രതി ശാന്തേന ശിക്ഷാദാനേച്ഛുകേന സഹിഷ്ണുനാ ച ഭവിതവ്യം, വിപക്ഷാശ്ച തേന നമ്രത്വേന ചേതിതവ്യാഃ|</para>
  <para style="p">
    <verse number="25" style="v"/>തഥാ കൃതേ യദീശ്വരഃ സത്യമതസ്യ ജ്ഞാനാർഥം തേഭ്യോ മനഃപരിവർത്തനരൂപം വരം ദദ്യാത്,</para>
  <para style="p">
    <verse number="26" style="v"/>തർഹി തേ യേന ശയതാനേന നിജാഭിലാഷസാധനായ ധൃതാസ്തസ്യ ജാലാത് ചേതനാം പ്രാപ്യോദ്ധാരം ലബ്ധും ശക്ഷ്യന്തി|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ചരമദിനേഷു ക്ലേശജനകാഃ സമയാ ഉപസ്ഥാസ്യന്തീതി ജാനീഹി|</para>
  <para style="p">
    <verse number="2" style="v"/>യതസ്താത്കാലികാ ലോകാ ആത്മപ്രേമിണോ ഽർഥപ്രേമിണ ആത്മശ്ലാഘിനോ ഽഭിമാനിനോ നിന്ദകാഃ പിത്രോരനാജ്ഞാഗ്രാഹിണഃ കൃതഘ്നാ അപവിത്രാഃ</para>
  <para style="p">
    <verse number="3" style="v"/>പ്രീതിവർജിതാ അസന്ധേയാ മൃഷാപവാദിനോ ഽജിതേന്ദ്രിയാഃ പ്രചണ്ഡാ ഭദ്രദ്വേഷിണോ</para>
  <para style="p">
    <verse number="4" style="v"/>വിശ്വാസഘാതകാ ദുഃസാഹസിനോ ദർപധ്മാതാ ഈശ്വരാപ്രേമിണഃ കിന്തു സുഖപ്രേമിണോ</para>
  <para style="p">
    <verse number="5" style="v"/>ഭക്തവേശാഃ കിന്ത്വസ്വീകൃതഭക്തിഗുണാ ഭവിഷ്യന്തി; ഏതാദൃശാനാം ലോകാനാം സംമർഗം പരിത്യജ|</para>
  <para style="p">
    <verse number="6" style="v"/>യതോ യേ ജനാഃ പ്രച്ഛന്നം ഗേഹാൻ പ്രവിശന്തി പാപൈ ർഭാരഗ്രസ്താ നാനാവിധാഭിലാഷൈശ്ചാലിതാ യാഃ കാമിന്യോ</para>
  <para style="p">
    <verse number="7" style="v"/>നിത്യം ശിക്ഷന്തേ കിന്തു സത്യമതസ്യ തത്ത്വജ്ഞാനം പ്രാപ്തും കദാചിത് ന ശക്നുവന്തി താ ദാസീവദ് വശീകുർവ്വതേ ച തേ താദൃശാ ലോകാഃ|</para>
  <para style="p">
    <verse number="8" style="v"/>യാന്നി ര്യാമ്ബ്രിശ്ച യഥാ മൂസമം പ്രതി വിപക്ഷത്വമ് അകുരുതാം തഥൈവ ഭ്രഷ്ടമനസോ വിശ്വാസവിഷയേ ഽഗ്രാഹ്യാശ്ചൈതേ ലോകാ അപി സത്യമതം പ്രതി വിപക്ഷതാം കുർവ്വന്തി|</para>
  <para style="p">
    <verse number="9" style="v"/>കിന്തു തേ ബഹുദൂരമ് അഗ്രസരാ ന ഭവിഷ്യന്തി യതസ്തയോ ർമൂഢതാ യദ്വത് തദ്വദ് ഏതേഷാമപി മൂഢതാ സർവ്വദൃശ്യാ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="10" style="v"/>മമോപദേശഃ ശിഷ്ടതാഭിപ്രായോ വിശ്വാസോ ർധര്യ്യം പ്രേമ സഹിഷ്ണുതോപദ്രവഃ ക്ലേശാ</para>
  <para style="p">
    <verse number="11" style="v"/>ആന്തിയഖിയായാമ് ഇകനിയേ ലൂസ്ത്രായാഞ്ച മാം പ്രതി യദ്യദ് അഘടത യാംശ്ചോപദ്രവാൻ അഹമ് അസഹേ സർവ്വമേതത് ത്വമ് അവഗതോഽസി കിന്തു തത്സർവ്വതഃ പ്രഭു ർമാമ് ഉദ്ധൃതവാൻ|</para>
  <para style="p">
    <verse number="12" style="v"/>പരന്തു യാവന്തോ ലോകാഃ ഖ്രീഷ്ടേന യീശുനേശ്വരഭക്തിമ് ആചരിതുമ് ഇച്ഛന്തി തേഷാം സർവ്വേഷാമ് ഉപദ്രവോ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="13" style="v"/>അപരം പാപിഷ്ഠാഃ ഖലാശ്ച ലോകാ ഭ്രാമ്യന്തോ ഭ്രമയന്തശ്ചോത്തരോത്തരം ദുഷ്ടത്വേന വർദ്ധിഷ്യന്തേ|</para>
  <para style="p">
    <verse number="14" style="v"/>കിന്തു ത്വം യദ് യദ് അശിക്ഷഥാഃ, യച്ച ത്വയി സമർപിതമ് അഭൂത് തസ്മിൻ അവതിഷ്ഠ, യതഃ കസ്മാത് ശിക്ഷാം പ്രാപ്തോഽസി തദ് വേത്സി;</para>
  <para style="p">
    <verse number="15" style="v"/>യാനി ച ധർമ്മശാസ്ത്രാണി ഖ്രീഷ്ടേ യീശൗ വിശ്വാസേന പരിത്രാണപ്രാപ്തയേ ത്വാം ജ്ഞാനിനം കർത്തും ശക്നുവന്തി താനി ത്വം ശൈശവകാലാദ് അവഗതോഽസി|</para>
  <para style="p">
    <verse number="16" style="v"/>തത് സർവ്വം ശാസ്ത്രമ് ഈശ്വരസ്യാത്മനാ ദത്തം ശിക്ഷായൈ ദോഷബോധായ ശോധനായ ധർമ്മവിനയായ ച ഫലയൂക്തം ഭവതി</para>
  <para style="p">
    <verse number="17" style="v"/>തേന ചേശ്വരസ്യ ലോകോ നിപുണഃ സർവ്വസ്മൈ സത്കർമ്മണേ സുസജ്ജശ്ച ഭവതി|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഈശ്വരസ്യ ഗോചരേ യശ്ച യീശുഃ ഖ്രീഷ്ടഃ സ്വീയാഗമനകാലേ സ്വരാജത്വേന ജീവതാം മൃതാനാഞ്ച ലോകാനാം വിചാരം കരിഷ്യതി തസ്യ ഗോചരേ ഽഹം ത്വാമ് ഇദം ദൃഢമ് ആജ്ഞാപയാമി|</para>
  <para style="p">
    <verse number="2" style="v"/>ത്വം വാക്യം ഘോഷയ കാലേഽകാലേ ചോത്സുകോ ഭവ പൂർണയാ സഹിഷ്ണുതയാ ശിക്ഷയാ ച ലോകാൻ പ്രബോധയ ഭർത്സയ വിനയസ്വ ച|</para>
  <para style="p">
    <verse number="3" style="v"/>യത ഏതാദൃശഃ സമയ ആയാതി യസ്മിൻ ലോകാ യഥാർഥമ് ഉപദേശമ് അസഹ്യമാനാഃ കർണകണ്ഡൂയനവിശിഷ്ടാ ഭൂത്വാ നിജാഭിലാഷാത് ശിക്ഷകാൻ സംഗ്രഹീഷ്യന്തി</para>
  <para style="p">
    <verse number="4" style="v"/>സത്യമതാച്ച ശ്രോത്രാണി നിവർത്ത്യ വിപഥഗാമിനോ ഭൂത്വോപാഖ്യാനേഷു പ്രവർത്തിഷ്യന്തേ;</para>
  <para style="p">
    <verse number="5" style="v"/>കിന്തു ത്വം സർവ്വവിഷയേ പ്രബുദ്ധോ ഭവ ദുഃഖഭോഗം സ്വീകുരു സുസംവാദപ്രചാരകസ്യ കർമ്മ സാധയ നിജപരിചര്യ്യാം പൂർണത്വേന കുരു ച|</para>
  <para style="p">
    <verse number="6" style="v"/>മമ പ്രാണാനാമ് ഉത്സർഗോ ഭവതി മമ പ്രസ്ഥാനകാലശ്ചോപാതിഷ്ഠത്|</para>
  <para style="p">
    <verse number="7" style="v"/>അഹമ് ഉത്തമയുദ്ധം കൃതവാൻ ഗന്തവ്യമാർഗസ്യാന്തം യാവദ് ധാവിതവാൻ വിശ്വാസഞ്ച രക്ഷിതവാൻ|</para>
  <para style="p">
    <verse number="8" style="v"/>ശേഷം പുണ്യമുകുടം മദർഥം രക്ഷിതം വിദ്യതേ തച്ച തസ്മിൻ മഹാദിനേ യഥാർഥവിചാരകേണ പ്രഭുനാ മഹ്യം ദായിഷ്യതേ കേവലം മഹ്യമ് ഇതി നഹി കിന്തു യാവന്തോ ലോകാസ്തസ്യാഗമനമ് ആകാങ്ക്ഷന്തേ തേഭ്യഃ സർവ്വേഭ്യോ ഽപി ദായിഷ്യതേ|</para>
  <para style="p">
    <verse number="9" style="v"/>ത്വം ത്വരയാ മത്സമീപമ് ആഗന്തും യതസ്വ,</para>
  <para style="p">
    <verse number="10" style="v"/>യതോ ദീമാ ഐഹികസംസാരമ് ഈഹമാനോ മാം പരിത്യജ്യ ഥിഷലനീകീം ഗതവാൻ തഥാ ക്രീഷ്കി ർഗാലാതിയാം ഗതവാൻ തീതശ്ച ദാൽമാതിയാം ഗതവാൻ|</para>
  <para style="p">
    <verse number="11" style="v"/>കേവലോ ലൂകോ മയാ സാർദ്ധം വിദ്യതേ| ത്വം മാർകം സങ്ഗിനം കൃത്വാഗച്ഛ യതഃ സ പരിചര്യ്യയാ മമോപകാരീ ഭവിഷ്യതി,</para>
  <para style="p">
    <verse number="12" style="v"/>തുഖികഞ്ചാഹമ് ഇഫിഷനഗരം പ്രേഷിതവാൻ|</para>
  <para style="p">
    <verse number="13" style="v"/>യദ് ആച്ഛാദനവസ്ത്രം ത്രോയാനഗരേ കാർപസ്യ സന്നിധൗ മയാ നിക്ഷിപ്തം ത്വമാഗമനസമയേ തത് പുസ്തകാനി ച വിശേഷതശ്ചർമ്മഗ്രന്ഥാൻ ആനയ|</para>
  <para style="p">
    <verse number="14" style="v"/>കാംസ്യകാരഃ സികന്ദരോ മമ ബഹ്വനിഷ്ടം കൃതവാൻ പ്രഭുസ്തസ്യ കർമ്മണാം സമുചിതഫലം ദദാതു|</para>
  <para style="p">
    <verse number="15" style="v"/>ത്വമപി തസ്മാത് സാവധാനാസ്തിഷ്ഠ യതഃ സോഽസ്മാകം വാക്യാനാമ് അതീവ വിപക്ഷോ ജാതഃ|</para>
  <para style="p">
    <verse number="16" style="v"/>മമ പ്രഥമപ്രത്യുത്തരസമയേ കോഽപി മമ സഹായോ നാഭവത് സർവ്വേ മാം പര്യ്യത്യജൻ താൻ പ്രതി തസ്യ ദോഷസ്യ ഗണനാ ന ഭൂയാത്;</para>
  <para style="p">
    <verse number="17" style="v"/>കിന്തു പ്രഭു ർമമ സഹായോ ഽഭവത് യഥാ ച മയാ ഘോഷണാ സാധ്യേത ഭിന്നജാതീയാശ്ച സർവ്വേ സുസംവാദം ശൃണുയുസ്തഥാ മഹ്യം ശക്തിമ് അദദാത് തതോ ഽഹം സിംഹസ്യ മുഖാദ് ഉദ്ധൃതഃ|</para>
  <para style="p">
    <verse number="18" style="v"/>അപരം സർവ്വസ്മാദ് ദുഷ്കർമ്മതഃ പ്രഭു ർമാമ് ഉദ്ധരിഷ്യതി നിജസ്വർഗീയരാജ്യം നേതും മാം താരയിഷ്യതി ച| തസ്യ ധന്യവാദഃ സദാകാലം ഭൂയാത്| ആമേൻ|</para>
  <para style="p">
    <verse number="19" style="v"/>ത്വം പ്രിഷ്കാമ് ആക്കിലമ് അനീഷിഫരസ്യ പരിജനാംശ്ച നമസ്കുരു|</para>
  <para style="p">
    <verse number="20" style="v"/>ഇരാസ്തഃ കരിന്ഥനഗരേ ഽതിഷ്ഠത് ത്രഫിമശ്ച പീഡിതത്വാത് മിലീതനഗരേ മയാ വ്യഹീയത|</para>
  <para style="p">
    <verse number="21" style="v"/>ത്വം ഹേമന്തകാലാത് പൂർവ്വമ് ആഗന്തും യതസ്വ| ഉബൂലഃ പൂദി ർലീനഃ ക്ലൗദിയാ സർവ്വേ ഭ്രാതരശ്ച ത്വാം നമസ്കുർവ്വതേ|</para>
  <para style="p">
    <verse number="22" style="v"/>പ്രഭു ര്യീശുഃ ഖ്രീഷ്ടസ്തവാത്മനാ സഹ ഭൂയാത്| യുഷ്മാസ്വനുഗ്രഹോ ഭൂയാത്| ആമേൻ|</para>
</usx>
