<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="HEB" style="id">Sanskrit Bible (NT) in Malayalam Script (സത്യവേദഃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Hebrews</para>
  <para style="toc1">ഇബ്രിണഃ പത്രം</para>
  <para style="toc2">ഇബ്രിണഃ</para>
  <para style="toc3">ഇബ്രിണഃ</para>
  <para style="mt1">ഇബ്രിണഃ പത്രം</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>പുരാ യ ഈശ്വരോ ഭവിഷ്യദ്വാദിഭിഃ പിതൃലോകേഭ്യോ നാനാസമയേ നാനാപ്രകാരം കഥിതവാൻ</para>
  <para style="p">
    <verse number="2" style="v"/>സ ഏതസ്മിൻ ശേഷകാലേ നിജപുത്രേണാസ്മഭ്യം കഥിതവാൻ| സ തം പുത്രം സർവ്വാധികാരിണം കൃതവാൻ തേനൈവ ച സർവ്വജഗന്തി സൃഷ്ടവാൻ|</para>
  <para style="p">
    <verse number="3" style="v"/>സ പുത്രസ്തസ്യ പ്രഭാവസ്യ പ്രതിബിമ്ബസ്തസ്യ തത്ത്വസ്യ മൂർത്തിശ്ചാസ്തി സ്വീയശക്തിവാക്യേന സർവ്വം ധത്തേ ച സ്വപ്രാണൈരസ്മാകം പാപമാർജ്ജനം കൃത്വാ ഊർദ്ധ്വസ്ഥാനേ മഹാമഹിമ്നോ ദക്ഷിണപാർശ്വേ സമുപവിഷ്ടവാൻ|</para>
  <para style="p">
    <verse number="4" style="v"/>ദിവ്യദൂതഗണാദ് യഥാ സ വിശിഷ്ടനാമ്നോ ഽധികാരീ ജാതസ്തഥാ തേഭ്യോഽപി ശ്രേഷ്ഠോ ജാതഃ|</para>
  <para style="p">
    <verse number="5" style="v"/>യതോ ദൂതാനാം മധ്യേ കദാചിദീശ്വരേണേദം ക ഉക്തഃ? യഥാ, "മദീയതനയോ ഽസി ത്വമ് അദ്യൈവ ജനിതോ മയാ| " പുനശ്ച "അഹം തസ്യ പിതാ ഭവിഷ്യാമി സ ച മമ പുത്രോ ഭവിഷ്യതി| "</para>
  <para style="p">
    <verse number="6" style="v"/>അപരം ജഗതി സ്വകീയാദ്വിതീയപുത്രസ്യ പുനരാനയനകാലേ തേനോക്തം, യഥാ, "ഈശ്വരസ്യ സകലൈ ർദൂതൈരേഷ ഏവ പ്രണമ്യതാം| "</para>
  <para style="p">
    <verse number="7" style="v"/>ദൂതാൻ അധി തേനേദമ് ഉക്തം, യഥാ, "സ കരോതി നിജാൻ ദൂതാൻ ഗന്ധവാഹസ്വരൂപകാൻ| വഹ്നിശിഖാസ്വരൂപാംശ്ച കരോതി നിജസേവകാൻ|| "</para>
  <para style="p">
    <verse number="8" style="v"/>കിന്തു പുത്രമുദ്ദിശ്യ തേനോക്തം, യഥാ, "ഹേ ഈശ്വര സദാ സ്ഥായി തവ സിംഹാസനം ഭവേത്| യാഥാർഥ്യസ്യ ഭവേദ്ദണ്ഡോ രാജദണ്ഡസ്ത്വദീയകഃ|</para>
  <para style="p">
    <verse number="9" style="v"/>പുണ്യേ പ്രേമ കരോഷി ത്വം കിഞ്ചാധർമ്മമ് ഋതീയസേ| തസ്മാദ് യ ഈശ ഈശസ്തേ സ തേ മിത്രഗണാദപി| അധികാഹ്ലാദതൈലേന സേചനം കൃതവാൻ തവ|| "</para>
  <para style="p">
    <verse number="10" style="v"/>പുനശ്ച, യഥാ, "ഹേ പ്രഭോ പൃഥിവീമൂലമ് ആദൗ സംസ്ഥാപിതം ത്വയാ| തഥാ ത്വദീയഹസ്തേന കൃതം ഗഗനമണ്ഡലം|</para>
  <para style="p">
    <verse number="11" style="v"/>ഇമേ വിനംക്ഷ്യതസ്ത്വന്തു നിത്യമേവാവതിഷ്ഠസേ| ഇദന്തു സകലം വിശ്വം സംജരിഷ്യതി വസ്ത്രവത്|</para>
  <para style="p">
    <verse number="12" style="v"/>സങ്കോചിതം ത്വയാ തത്തു വസ്ത്രവത് പരിവർത്സ്യതേ| ത്വന്തു നിത്യം സ ഏവാസീ ർനിരന്താസ്തവ വത്സരാഃ|| "</para>
  <para style="p">
    <verse number="13" style="v"/>അപരം ദൂതാനാം മധ്യേ കഃ കദാചിദീശ്വരേണേദമുക്തഃ? യഥാ, "തവാരീൻ പാദപീഠം തേ യാവന്നഹി കരോമ്യഹം| മമ ദക്ഷിണദിഗ്ഭാഗേ താവത് ത്വം സമുപാവിശ|| "</para>
  <para style="p">
    <verse number="14" style="v"/>യേ പരിത്രാണസ്യാധികാരിണോ ഭവിഷ്യന്തി തേഷാം പരിചര്യ്യാർഥം പ്രേഷ്യമാണാഃ സേവനകാരിണ ആത്മാനഃ കിം തേ സർവ്വേ ദൂതാ നഹി?</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അതോ വയം യദ് ഭ്രമസ്രോതസാ നാപനീയാമഹേ തദർഥമസ്മാഭി ര്യദ്യദ് അശ്രാവി തസ്മിൻ മനാംസി നിധാതവ്യാനി|</para>
  <para style="p">
    <verse number="2" style="v"/>യതോ ഹേതോ ദൂതൈഃ കഥിതം വാക്യം യദ്യമോഘമ് അഭവദ് യദി ച തല്ലങ്ഘനകാരിണേ തസ്യാഗ്രാഹകായ ച സർവ്വസ്മൈ സമുചിതം ദണ്ഡമ് അദീയത,</para>
  <para style="p">
    <verse number="3" style="v"/>തർഹ്യസ്മാഭിസ്താദൃശം മഹാപരിത്രാണമ് അവജ്ഞായ കഥം രക്ഷാ പ്രാപ്സ്യതേ, യത് പ്രഥമതഃ പ്രഭുനാ പ്രോക്തം തതോഽസ്മാൻ യാവത് തസ്യ ശ്രോതൃഭിഃ സ്ഥിരീകൃതം,</para>
  <para style="p">
    <verse number="4" style="v"/>അപരം ലക്ഷണൈരദ്ഭുതകർമ്മഭി ർവിവിധശക്തിപ്രകാശേന നിജേച്ഛാതഃ പവിത്രസ്യാത്മനോ വിഭാഗേന ച യദ് ഈശ്വരേണ പ്രമാണീകൃതമ് അഭൂത്|</para>
  <para style="p">
    <verse number="5" style="v"/>വയം തു യസ്യ ഭാവിരാജ്യസ്യ കഥാം കഥയാമഃ, തത് തേൻ ദിവ്യദൂതാനാമ് അധീനീകൃതമിതി നഹി|</para>
  <para style="p">
    <verse number="6" style="v"/>കിന്തു കുത്രാപി കശ്ചിത് പ്രമാണമ് ഈദൃശം ദത്തവാൻ, യഥാ, "കിം വസ്തു മാനവോ യത് സ നിത്യം സംസ്മര്യ്യതേ ത്വയാ| കിം വാ മാനവസന്താനോ യത് സ ആലോച്യതേ ത്വയാ|</para>
  <para style="p">
    <verse number="7" style="v"/>ദിവ്യദതഗണേഭ്യഃ സ കിഞ്ചിൻ ന്യൂനഃ കൃതസ്ത്വയാ| തേജോഗൗരവരൂപേണ കിരീടേന വിഭൂഷിതഃ| സൃഷ്ടം യത് തേ കരാഭ്യാം സ തത്പ്രഭുത്വേ നിയോജിതഃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ചരണാധശ്ച തസ്യൈവ ത്വയാ സർവ്വം വശീകൃതം|| " തേന സർവ്വം യസ്യ വശീകൃതം തസ്യാവശീഭൂതം കിമപി നാവശേഷിതം കിന്ത്വധുനാപി വയം സർവ്വാണി തസ്യ വശീഭൂതാനി ന പശ്യാമഃ|</para>
  <para style="p">
    <verse number="9" style="v"/>തഥാപി ദിവ്യദൂതഗണേഭ്യോ യഃ കിഞ്ചിൻ ന്യൂനീകൃതോഽഭവത് തം യീശും മൃത്യുഭോഗഹേതോസ്തേജോഗൗരവരൂപേണ കിരീടേന വിഭൂഷിതം പശ്യാമഃ, യത ഈശ്വരസ്യാനുഗ്രഹാത് സ സർവ്വേഷാം കൃതേ മൃത്യുമ് അസ്വദത|</para>
  <para style="p">
    <verse number="10" style="v"/>അപരഞ്ച യസ്മൈ യേന ച കൃത്സ്നം വസ്തു സൃഷ്ടം വിദ്യതേ ബഹുസന്താനാനാം വിഭവായാനയനകാലേ തേഷാം പരിത്രാണാഗ്രസരസ്യ ദുഃഖഭോഗേന സിദ്ധീകരണമപി തസ്യോപയുക്തമ് അഭവത്|</para>
  <para style="p">
    <verse number="11" style="v"/>യതഃ പാവകഃ പൂയമാനാശ്ച സർവ്വേ ഏകസ്മാദേവോത്പന്നാ ഭവന്തി, ഇതി ഹേതോഃ സ താൻ ഭ്രാതൃൻ വദിതും ന ലജ്ജതേ|</para>
  <para style="p">
    <verse number="12" style="v"/>തേന സ ഉക്തവാൻ, യഥാ, "ദ്യോതയിഷ്യാമി തേ നാമ ഭ്രാതൃണാം മധ്യതോ മമ| പരന്തു സമിതേ ർമധ്യേ കരിഷ്യേ തേ പ്രശംസനം|| "</para>
  <para style="p">
    <verse number="13" style="v"/>പുനരപി, യഥാ, "തസ്മിൻ വിശ്വസ്യ സ്ഥാതാഹം| " പുനരപി, യഥാ, "പശ്യാഹമ് അപത്യാനി ച ദത്താനി മഹ്യമ് ഈശ്വരാത്| "</para>
  <para style="p">
    <verse number="14" style="v"/>തേഷാമ് അപത്യാനാം രുധിരപലലവിശിഷ്ടത്വാത് സോഽപി തദ്വത് തദ്വിശിഷ്ടോഽഭൂത് തസ്യാഭിപ്രായോഽയം യത് സ മൃത്യുബലാധികാരിണം ശയതാനം മൃത്യുനാ ബലഹീനം കുര്യ്യാത്</para>
  <para style="p">
    <verse number="15" style="v"/>യേ ച മൃത്യുഭയാദ് യാവജ്ജീവനം ദാസത്വസ്യ നിഘ്നാ ആസൻ താൻ ഉദ്ധാരയേത്|</para>
  <para style="p">
    <verse number="16" style="v"/>സ ദൂതാനാമ് ഉപകാരീ ന ഭവതി കിന്ത്വിബ്രാഹീമോ വംശസ്യൈവോപകാരീ ഭവതീ|</para>
  <para style="p">
    <verse number="17" style="v"/>അതോ ഹേതോഃ സ യഥാ കൃപാവാൻ പ്രജാനാം പാപശോധനാർഥമ് ഈശ്വരോദ്ദേശ്യവിഷയേ വിശ്വാസ്യോ മഹായാജകോ ഭവേത് തദർഥം സർവ്വവിഷയേ സ്വഭ്രാതൃണാം സദൃശീഭവനം തസ്യോചിതമ് ആസീത്|</para>
  <para style="p">
    <verse number="18" style="v"/>യതഃ സ സ്വയം പരീക്ഷാം ഗത്വാ യം ദുഃഖഭോഗമ് അവഗതസ്തേന പരീക്ഷാക്രാന്താൻ ഉപകർത്തും ശക്നോതി|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഹേ സ്വർഗീയസ്യാഹ്വാനസ്യ സഹഭാഗിനഃ പവിത്രഭ്രാതരഃ, അസ്മാകം ധർമ്മപ്രതിജ്ഞായാ ദൂതോഽഗ്രസരശ്ച യോ യീശുസ്തമ് ആലോചധ്വം|</para>
  <para style="p">
    <verse number="2" style="v"/>മൂസാ യദ്വത് തസ്യ സർവ്വപരിവാരമധ്യേ വിശ്വാസ്യ ആസീത്, തദ്വത് അയമപി സ്വനിയോജകസ്യ സമീപേ വിശ്വാസ്യോ ഭവതി|</para>
  <para style="p">
    <verse number="3" style="v"/>പരിവാരാച്ച യദ്വത് തത്സ്ഥാപയിതുരധികം ഗൗരവം ഭവതി തദ്വത് മൂസസോഽയം ബഹുതരഗൗരവസ്യ യോഗ്യോ ഭവതി|</para>
  <para style="p">
    <verse number="4" style="v"/>ഏകൈകസ്യ നിവേശനസ്യ പരിജനാനാം സ്ഥാപയിതാ കശ്ചിദ് വിദ്യതേ യശ്ച സർവ്വസ്ഥാപയിതാ സ ഈശ്വര ഏവ|</para>
  <para style="p">
    <verse number="5" style="v"/>മൂസാശ്ച വക്ഷ്യമാണാനാം സാക്ഷീ ഭൃത്യ ഇവ തസ്യ സർവ്വപരിജനമധ്യേ വിശ്വാസ്യോഽഭവത് കിന്തു ഖ്രീഷ്ടസ്തസ്യ പരിജനാനാമധ്യക്ഷ ഇവ|</para>
  <para style="p">
    <verse number="6" style="v"/>വയം തു യദി വിശ്വാസസ്യോത്സാഹം ശ്ലാഘനഞ്ച ശേഷം യാവദ് ധാരയാമസ്തർഹി തസ്യ പരിജനാ ഭവാമഃ|</para>
  <para style="p">
    <verse number="7" style="v"/>അതോ ഹേതോഃ പവിത്രേണാത്മനാ യദ്വത് കഥിതം, തദ്വത്, "അദ്യ യൂയം കഥാം തസ്യ യദി സംശ്രോതുമിച്ഛഥ|</para>
  <para style="p">
    <verse number="8" style="v"/>തർഹി പുരാ പരീക്ഷായാ ദിനേ പ്രാന്തരമധ്യതഃ| മദാജ്ഞാനിഗ്രഹസ്ഥാനേ യുഷ്മാഭിസ്തു കൃതം യഥാ| തഥാ മാ കുരുതേദാനീം കഠിനാനി മനാംസി വഃ|</para>
  <para style="p">
    <verse number="9" style="v"/>യുഷ്മാകം പിതരസ്തത്ര മത്പരീക്ഷാമ് അകുർവ്വത| കുർവ്വദ്ഭി ർമേഽനുസന്ധാനം തൈരദൃശ്യന്ത മത്ക്രിയാഃ| ചത്വാരിംശത്സമാ യാവത് ക്രുദ്ധ്വാഹന്തു തദന്വയേ|</para>
  <para style="p">
    <verse number="10" style="v"/>അവാദിഷമ് ഇമേ ലോകാ ഭ്രാന്താന്തഃകരണാഃ സദാ| മാമകീനാനി വർത്മാനി പരിജാനന്തി നോ ഇമേ|</para>
  <para style="p">
    <verse number="11" style="v"/>ഇതി ഹേതോരഹം കോപാത് ശപഥം കൃതവാൻ ഇമം| പ്രേവേക്ഷ്യതേ ജനൈരേതൈ ർന വിശ്രാമസ്ഥലം മമ|| "</para>
  <para style="p">
    <verse number="12" style="v"/>ഹേ ഭ്രാതരഃ സാവധാനാ ഭവത, അമരേശ്വരാത് നിവർത്തകോ യോഽവിശ്വാസസ്തദ്യുക്തം ദുഷ്ടാന്തഃകരണം യുഷ്മാകം കസ്യാപി ന ഭവതു|</para>
  <para style="p">
    <verse number="13" style="v"/>കിന്തു യാവദ് അദ്യനാമാ സമയോ വിദ്യതേ താവദ് യുഷ്മന്മധ്യേ കോഽപി പാപസ്യ വഞ്ചനയാ യത് കഠോരീകൃതോ ന ഭവേത് തദർഥം പ്രതിദിനം പരസ്പരമ് ഉപദിശത|</para>
  <para style="p">
    <verse number="14" style="v"/>യതോ വയം ഖ്രീഷ്ടസ്യാംശിനോ ജാതാഃ കിന്തു പ്രഥമവിശ്വാസസ്യ ദൃഢത്വമ് അസ്മാഭിഃ ശേഷം യാവദ് അമോഘം ധാരയിതവ്യം|</para>
  <para style="p">
    <verse number="15" style="v"/>അദ്യ യൂയം കഥാം തസ്യ യദി സംശ്രോതുമിച്ഛഥ, തർഹ്യാജ്ഞാലങ്ഘനസ്ഥാനേ യുഷ്മാഭിസ്തു കൃതം യഥാ, തഥാ മാ കുരുതേദാനീം കഠിനാനി മനാംസി വ ഇതി തേന യദുക്തം,</para>
  <para style="p">
    <verse number="16" style="v"/>തദനുസാരാദ് യേ ശ്രുത്വാ തസ്യ കഥാം ന ഗൃഹീതവന്തസ്തേ കേ? കിം മൂസസാ മിസരദേശാദ് ആഗതാഃ സർവ്വേ ലോകാ നഹി?</para>
  <para style="p">
    <verse number="17" style="v"/>കേഭ്യോ വാ സ ചത്വാരിംശദ്വർഷാണി യാവദ് അക്രുധ്യത്? പാപം കുർവ്വതാം യേഷാം കുണപാഃ പ്രാന്തരേ ഽപതൻ കിം തേഭ്യോ നഹി?</para>
  <para style="p">
    <verse number="18" style="v"/>പ്രവേക്ഷ്യതേ ജനൈരേതൈ ർന വിശ്രാമസ്ഥലം മമേതി ശപഥഃ കേഷാം വിരുദ്ധം തേനാകാരി? കിമ് അവിശ്വാസിനാം വിരുദ്ധം നഹി?</para>
  <para style="p">
    <verse number="19" style="v"/>അതസ്തേ തത് സ്ഥാനം പ്രവേഷ്ടുമ് അവിശ്വാസാത് നാശക്നുവൻ ഇതി വയം വീക്ഷാമഹേ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അപരം തദ്വിശ്രാമപ്രാപ്തേഃ പ്രതിജ്ഞാ യദി തിഷ്ഠതി തർഹ്യസ്മാകം കശ്ചിത് ചേത് തസ്യാഃ ഫലേന വഞ്ചിതോ ഭവേത് വയമ് ഏതസ്മാദ് ബിഭീമഃ|</para>
  <para style="p">
    <verse number="2" style="v"/>യതോ ഽസ്മാകം സമീപേ യദ്വത് തദ്വത് തേഷാം സമീപേഽപി സുസംവാദഃ പ്രചാരിതോ ഽഭവത് കിന്തു തൈഃ ശ്രുതം വാക്യം താൻ പ്രതി നിഷ്ഫലമ് അഭവത്, യതസ്തേ ശ്രോതാരോ വിശ്വാസേന സാർദ്ധം തന്നാമിശ്രയൻ|</para>
  <para style="p">
    <verse number="3" style="v"/>തദ് വിശ്രാമസ്ഥാനം വിശ്വാസിഭിരസ്മാഭിഃ പ്രവിശ്യതേ യതസ്തേനോക്തം, "അഹം കോപാത് ശപഥം കൃതവാൻ ഇമം, പ്രവേക്ഷ്യതേ ജനൈരേതൈ ർന വിശ്രാമസ്ഥലം മമ| " കിന്തു തസ്യ കർമ്മാണി ജഗതഃ സൃഷ്ടികാലാത് സമാപ്താനി സന്തി|</para>
  <para style="p">
    <verse number="4" style="v"/>യതഃ കസ്മിംശ്ചിത് സ്ഥാനേ സപ്തമം ദിനമധി തേനേദമ് ഉക്തം, യഥാ, "ഈശ്വരഃ സപ്തമേ ദിനേ സ്വകൃതേഭ്യഃ സർവ്വകർമ്മഭ്യോ വിശശ്രാമ| "</para>
  <para style="p">
    <verse number="5" style="v"/>കിന്ത്വേതസ്മിൻ സ്ഥാനേ പുനസ്തേനോച്യതേ, യഥാ, "പ്രവേക്ഷ്യതേ ജനൈരേതൈ ർന വിശ്രാമസ്ഥലം മമ| "</para>
  <para style="p">
    <verse number="6" style="v"/>ഫലതസ്തത് സ്ഥാനം കൈശ്ചിത് പ്രവേഷ്ടവ്യം കിന്തു യേ പുരാ സുസംവാദം ശ്രുതവന്തസ്തൈരവിശ്വാസാത് തന്ന പ്രവിഷ്ടമ്,</para>
  <para style="p">
    <verse number="7" style="v"/>ഇതി ഹേതോഃ സ പുനരദ്യനാമകം ദിനം നിരൂപ്യ ദീർഘകാലേ ഗതേഽപി പൂർവ്വോക്താം വാചം ദായൂദാ കഥയതി, യഥാ, "അദ്യ യൂയം കഥാം തസ്യ യദി സംശ്രോതുമിച്ഛഥ, തർഹി മാ കുരുതേദാനീം കഠിനാനി മനാംസി വഃ| "</para>
  <para style="p">
    <verse number="8" style="v"/>അപരം യിഹോശൂയോ യദി താൻ വ്യശ്രാമയിഷ്യത് തർഹി തതഃ പരമ് അപരസ്യ ദിനസ്യ വാഗ് ഈശ്വരേണ നാകഥയിഷ്യത|</para>
  <para style="p">
    <verse number="9" style="v"/>അത ഈശ്വരസ്യ പ്രജാഭിഃ കർത്തവ്യ ഏകോ വിശ്രാമസ്തിഷ്ഠതി|</para>
  <para style="p">
    <verse number="10" style="v"/>അപരമ് ഈശ്വരോ യദ്വത് സ്വകൃതകർമ്മഭ്യോ വിശശ്രാമ തദ്വത് തസ്യ വിശ്രാമസ്ഥാനം പ്രവിഷ്ടോ ജനോഽപി സ്വകൃതകർമ്മഭ്യോ വിശ്രാമ്യതി|</para>
  <para style="p">
    <verse number="11" style="v"/>അതോ വയം തദ് വിശ്രാമസ്ഥാനം പ്രവേഷ്ടും യതാമഹൈ, തദവിശ്വാസോദാഹരണേന കോഽപി ന പതതു|</para>
  <para style="p">
    <verse number="12" style="v"/>ഈശ്വരസ്യ വാദോഽമരഃ പ്രഭാവവിശിഷ്ടശ്ച സർവ്വസ്മാദ് ദ്വിധാരഖങ്ഗാദപി തീക്ഷ്ണഃ, അപരം പ്രാണാത്മനോ ർഗ്രന്ഥിമജ്ജയോശ്ച പരിഭേദായ വിച്ഛേദകാരീ മനസശ്ച സങ്കൽപാനാമ് അഭിപ്രേതാനാഞ്ച വിചാരകഃ|</para>
  <para style="p">
    <verse number="13" style="v"/>അപരം യസ്യ സമീപേ സ്വീയാ സ്വീയാ കഥാസ്മാഭിഃ കഥയിതവ്യാ തസ്യാഗോചരഃ കോഽപി പ്രാണീ നാസ്തി തസ്യ ദൃഷ്ടൗ സർവ്വമേവാനാവൃതം പ്രകാശിതഞ്ചാസ്തേ|</para>
  <para style="p">
    <verse number="14" style="v"/>അപരം യ ഉച്ചതമം സ്വർഗം പ്രവിഷ്ട ഏതാദൃശ ഏകോ വ്യക്തിരർഥത ഈശ്വരസ്യ പുത്രോ യീശുരസ്മാകം മഹായാജകോഽസ്തി, അതോ ഹേതോ ർവയം ധർമ്മപ്രതിജ്ഞാം ദൃഢമ് ആലമ്ബാമഹൈ|</para>
  <para style="p">
    <verse number="15" style="v"/>അസ്മാകം യോ മഹായാജകോ ഽസ്തി സോഽസ്മാകം ദുഃഖൈ ർദുഃഖിതോ ഭവിതുമ് അശക്തോ നഹി കിന്തു പാപം വിനാ സർവ്വവിഷയേ വയമിവ പരീക്ഷിതഃ|</para>
  <para style="p">
    <verse number="16" style="v"/>അതഏവ കൃപാം ഗ്രഹീതും പ്രയോജനീയോപകാരാർഥമ് അനുഗ്രഹം പ്രാപ്തുഞ്ച വയമ് ഉത്സാഹേനാനുഗ്രഹസിംഹാസനസ്യ സമീപം യാമഃ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>യഃ കശ്ചിത് മഹായാജകോ ഭവതി സ മാനവാനാം മധ്യാത് നീതഃ സൻ മാനവാനാം കൃത ഈശ്വരോദ്ദേശ്യവിഷയേഽർഥത ഉപഹാരാണാം പാപാർഥകബലീനാഞ്ച ദാന നിയുജ്യതേ|</para>
  <para style="p">
    <verse number="2" style="v"/>സ ചാജ്ഞാനാം ഭ്രാന്താനാഞ്ച ലോകാനാം ദുഃഖേന ദുഃഖീ ഭവിതും ശക്നോതി, യതോ ഹേതോഃ സ സ്വയമപി ദൗർബ്ബല്യവേഷ്ടിതോ ഭവതി|</para>
  <para style="p">
    <verse number="3" style="v"/>ഏതസ്മാത് കാരണാച്ച യദ്വത് ലോകാനാം കൃതേ തദ്വദ് ആത്മകൃതേഽപി പാപാർഥകബലിദാനം തേന കർത്തവ്യം|</para>
  <para style="p">
    <verse number="4" style="v"/>സ ഘോച്ചപദഃ സ്വേച്ഛാതഃ കേനാപി ന ഗൃഹ്യതേ കിന്തു ഹാരോണ ഇവ യ ഈശ്വരേണാഹൂയതേ തേനൈവ ഗൃഹ്യതേ|</para>
  <para style="p">
    <verse number="5" style="v"/>ഏവമ്പ്രകാരേണ ഖ്രീഷ്ടോഽപി മഹായാജകത്വം ഗ്രഹീതും സ്വീയഗൗരവം സ്വയം ന കൃതവാൻ, കിന്തു "മദീയതനയോഽസി ത്വമ് അദ്യൈവ ജനിതോ മയേതി" വാചം യസ്തം ഭാഷിതവാൻ സ ഏവ തസ്യ ഗൗരവം കൃതവാൻ|</para>
  <para style="p">
    <verse number="6" style="v"/>തദ്വദ് അന്യഗീതേഽപീദമുക്തം, ത്വം മൽകീഷേദകഃ ശ്രേണ്യാം യാജകോഽസി സദാതനഃ|</para>
  <para style="p">
    <verse number="7" style="v"/>സ ച ദേഹവാസകാലേ ബഹുക്രന്ദനേനാശ്രുപാതേന ച മൃത്യുത ഉദ്ധരണേ സമർഥസ്യ പിതുഃ സമീപേ പുനഃ പുനർവിനതിം പ്രർഥനാഞ്ച കൃത്വാ തത്ഫലരൂപിണീം ശങ്കാതോ രക്ഷാം പ്രാപ്യ ച</para>
  <para style="p">
    <verse number="8" style="v"/>യദ്യപി പുത്രോഽഭവത് തഥാപി യൈരക്ലിശ്യത തൈരാജ്ഞാഗ്രഹണമ് അശിക്ഷത|</para>
  <para style="p">
    <verse number="9" style="v"/>ഇത്ഥം സിദ്ധീഭൂയ നിജാജ്ഞാഗ്രാഹിണാം സർവ്വേഷാമ് അനന്തപരിത്രാണസ്യ കാരണസ്വരൂപോ ഽഭവത്|</para>
  <para style="p">
    <verse number="10" style="v"/>തസ്മാത് സ മൽകീഷേദകഃ ശ്രേണീഭുക്തോ മഹായാജക ഈശ്വരേണാഖ്യാതഃ|</para>
  <para style="p">
    <verse number="11" style="v"/>തമധ്യസ്മാകം ബഹുകഥാഃ കഥയിതവ്യാഃ കിന്തു താഃ സ്തബ്ധകർണൈ ര്യുഷ്മാഭി ർദുർഗമ്യാഃ|</para>
  <para style="p">
    <verse number="12" style="v"/>യതോ യൂയം യദ്യപി സമയസ്യ ദീർഘത്വാത് ശിക്ഷകാ ഭവിതുമ് അശക്ഷ്യത തഥാപീശ്വരസ്യ വാക്യാനാം യാ പ്രഥമാ വർണമാലാ താമധി ശിക്ഷാപ്രാപ്തി ര്യുഷ്മാകം പുനരാവശ്യകാ ഭവതി, തഥാ കഠിനദ്രവ്യേ നഹി കിന്തു ദുഗ്ധേ യുഷ്മാകം പ്രയോജനമ് ആസ്തേ|</para>
  <para style="p">
    <verse number="13" style="v"/>യോ ദുഗ്ധപായീ സ ശിശുരേവേതികാരണാത് ധർമ്മവാക്യേ തത്പരോ നാസ്തി|</para>
  <para style="p">
    <verse number="14" style="v"/>കിന്തു സദസദ്വിചാരേ യേഷാം ചേതാംസി വ്യവഹാരേണ ശിക്ഷിതാനി താദൃശാനാം സിദ്ധലോകാനാം കഠോരദ്രവ്യേഷു പ്രയോജനമസ്തി|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>വയം മൃതിജനകകർമ്മഭ്യോ മനഃപരാവർത്തനമ് ഈശ്വരേ വിശ്വാസോ മജ്ജനശിക്ഷണം ഹസ്താർപണം മൃതലോകാനാമ് ഉത്ഥാനമ്</para>
  <para style="p">
    <verse number="2" style="v"/>അനന്തകാലസ്ഥായിവിചാരാജ്ഞാ ചൈതൈഃ പുനർഭിത്തിമൂലം ന സ്ഥാപയന്തഃ ഖ്രീഷ്ടവിഷയകം പ്രഥമോപദേശം പശ്ചാത്കൃത്യ സിദ്ധിം യാവദ് അഗ്രസരാ ഭവാമ|</para>
  <para style="p">
    <verse number="3" style="v"/>ഈശ്വരസ്യാനുമത്യാ ച തദ് അസ്മാഭിഃ കാരിഷ്യതേ|</para>
  <para style="p">
    <verse number="4" style="v"/>യ ഏകകൃത്വോ ദീപ്തിമയാ ഭൂത്വാ സ്വർഗീയവരരസമ് ആസ്വദിതവന്തഃ പവിത്രസ്യാത്മനോഽംശിനോ ജാതാ</para>
  <para style="p">
    <verse number="5" style="v"/>ഈശ്വരസ്യ സുവാക്യം ഭാവികാലസ്യ ശക്തിഞ്ചാസ്വദിതവന്തശ്ച തേ ഭ്രഷ്ട്വാ യദി</para>
  <para style="p">
    <verse number="6" style="v"/>സ്വമനോഭിരീശ്വരസ്യ പുത്രം പുനഃ ക്രുശേ ഘ്നന്തി ലജ്ജാസ്പദം കുർവ്വതേ ച തർഹി മനഃപരാവർത്തനായ പുനസ്താൻ നവീനീകർത്തും കോഽപി ന ശക്നോതി|</para>
  <para style="p">
    <verse number="7" style="v"/>യതോ യാ ഭൂമിഃ സ്വോപരി ഭൂയഃ പതിതം വൃഷ്ടിം പിവതീ തത്ഫലാധികാരിണാം നിമിത്തമ് ഇഷ്ടാനി ശാകാദീന്യുത്പാദയതി സാ ഈശ്വരാദ് ആശിഷം പ്രാപ്താ|</para>
  <para style="p">
    <verse number="8" style="v"/>കിന്തു യാ ഭൂമി ർഗോക്ഷുരകണ്ടകവൃക്ഷാൻ ഉത്പാദയതി സാ ന ഗ്രാഹ്യാ ശാപാർഹാ ച ശേഷേ തസ്യാ ദാഹോ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="9" style="v"/>ഹേ പ്രിയതമാഃ, യദ്യപി വയമ് ഏതാദൃശം വാക്യം ഭാഷാമഹേ തഥാപി യൂയം തത ഉത്കൃഷ്ടാഃ പരിത്രാണപഥസ്യ പഥികാശ്ചാധ്വ ഇതി വിശ്വസാമഃ|</para>
  <para style="p">
    <verse number="10" style="v"/>യതോ യുഷ്മാഭിഃ പവിത്രലോകാനാം യ ഉപകാരോ ഽകാരി ക്രിയതേ ച തേനേശ്വരസ്യ നാമ്നേ പ്രകാശിതം പ്രേമ ശ്രമഞ്ച വിസ്മർത്തുമ് ഈശ്വരോഽന്യായകാരീ ന ഭവതി|</para>
  <para style="p">
    <verse number="11" style="v"/>അപരം യുഷ്മാകമ് ഏകൈകോ ജനോ യത് പ്രത്യാശാപൂരണാർഥം ശേഷം യാവത് തമേവ യത്നം പ്രകാശയേദിത്യഹമ് ഇച്ഛാമി|</para>
  <para style="p">
    <verse number="12" style="v"/>അതഃ ശിഥിലാ ന ഭവത കിന്തു യേ വിശ്വാസേന സഹിഷ്ണുതയാ ച പ്രതിജ്ഞാനാം ഫലാധികാരിണോ ജാതാസ്തേഷാമ് അനുഗാമിനോ ഭവത|</para>
  <para style="p">
    <verse number="13" style="v"/>ഈശ്വരോ യദാ ഇബ്രാഹീമേ പ്രത്യജാനാത് തദാ ശ്രേഷ്ഠസ്യ കസ്യാപ്യപരസ്യ നാമ്നാ ശപഥം കർത്തും നാശക്നോത്, അതോ ഹേതോഃ സ്വനാമ്നാ ശപഥം കൃത്വാ തേനോക്തം യഥാ,</para>
  <para style="p">
    <verse number="14" style="v"/>"സത്യമ് അഹം ത്വാമ് ആശിഷം ഗദിഷ്യാമി തവാന്വയം വർദ്ധയിഷ്യാമി ച| "</para>
  <para style="p">
    <verse number="15" style="v"/>അനേന പ്രകാരേണ സ സഹിഷ്ണുതാം വിധായ തസ്യാഃ പ്രത്യാശായാഃ ഫലം ലബ്ധവാൻ|</para>
  <para style="p">
    <verse number="16" style="v"/>അഥ മാനവാഃ ശ്രേഷ്ഠസ്യ കസ്യചിത് നാമ്നാ ശപന്തേ, ശപഥശ്ച പ്രമാണാർഥം തേഷാം സർവ്വവിവാദാന്തകോ ഭവതി|</para>
  <para style="p">
    <verse number="17" style="v"/>ഇത്യസ്മിൻ ഈശ്വരഃ പ്രതിജ്ഞായാഃ ഫലാധികാരിണഃ സ്വീയമന്ത്രണായാ അമോഘതാം ബാഹുല്യതോ ദർശയിതുമിച്ഛൻ ശപഥേന സ്വപ്രതിജ്ഞാം സ്ഥിരീകൃതവാൻ|</para>
  <para style="p">
    <verse number="18" style="v"/>അതഏവ യസ്മിൻ അനൃതകഥനമ് ഈശ്വരസ്യ ന സാധ്യം താദൃശേനാചലേന വിഷയദ്വയേന സമ്മുഖസ്ഥരക്ഷാസ്ഥലസ്യ പ്രാപ്തയേ പലായിതാനാമ് അസ്മാകം സുദൃഢാ സാന്ത്വനാ ജായതേ|</para>
  <para style="p">
    <verse number="19" style="v"/>സാ പ്രത്യാശാസ്മാകം മനോനൗകായാ അചലോ ലങ്ഗരോ ഭൂത്വാ വിച്ഛേദകവസ്ത്രസ്യാഭ്യന്തരം പ്രവിഷ്ടാ|</para>
  <para style="p">
    <verse number="20" style="v"/>തത്രൈവാസ്മാകമ് അഗ്രസരോ യീശുഃ പ്രവിശ്യ മൽകീഷേദകഃ ശ്രേണ്യാം നിത്യസ്ഥായീ യാജകോഽഭവത്|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ശാലമസ്യ രാജാ സർവ്വോപരിസ്ഥസ്യേശ്വരസ്യ യാജകശ്ച സൻ യോ നൃപതീനാം മാരണാത് പ്രത്യാഗതമ് ഇബ്രാഹീമം സാക്ഷാത്കൃത്യാശിഷം ഗദിതവാൻ,</para>
  <para style="p">
    <verse number="2" style="v"/>യസ്മൈ ചേബ്രാഹീമ് സർവ്വദ്രവ്യാണാം ദശമാംശം ദത്തവാൻ സ മൽകീഷേദക് സ്വനാമ്നോഽർഥേന പ്രഥമതോ ധർമ്മരാജഃ പശ്ചാത് ശാലമസ്യ രാജാർഥതഃ ശാന്തിരാജോ ഭവതി|</para>
  <para style="p">
    <verse number="3" style="v"/>അപരം തസ്യ പിതാ മാതാ വംശസ്യ നിർണയ ആയുഷ ആരമ്ഭോ ജീവനസ്യ ശേഷശ്ചൈതേഷാമ് അഭാവോ ഭവതി, ഇത്ഥം സ ഈശ്വരപുത്രസ്യ സദൃശീകൃതഃ, സ ത്വനന്തകാലം യാവദ് യാജകസ്തിഷ്ഠതി|</para>
  <para style="p">
    <verse number="4" style="v"/>അതഏവാസ്മാകം പൂർവ്വപുരുഷ ഇബ്രാഹീമ് യസ്മൈ ലുഠിതദ്രവ്യാണാം ദശമാംശം ദത്തവാൻ സ കീദൃക് മഹാൻ തദ് ആലോചയത|</para>
  <para style="p">
    <verse number="5" style="v"/>യാജകത്വപ്രാപ്താ ലേവേഃ സന്താനാ വ്യവസ്ഥാനുസാരേണ ലോകേഭ്യോഽർഥത ഇബ്രാഹീമോ ജാതേഭ്യഃ സ്വീയഭ്രാതൃഭ്യോ ദശമാംശഗ്രഹണസ്യാദേശം ലബ്ധവന്തഃ|</para>
  <para style="p">
    <verse number="6" style="v"/>കിന്ത്വസൗ യദ്യപി തേഷാം വംശാത് നോത്പന്നസ്തഥാപീബ്രാഹീമോ ദശമാംശം ഗൃഹീതവാൻ പ്രതിജ്ഞാനാമ് അധികാരിണമ് ആശിഷം ഗദിതവാംശ്ച|</para>
  <para style="p">
    <verse number="7" style="v"/>അപരം യഃ ശ്രേയാൻ സ ക്ഷുദ്രതരായാശിഷം ദദാതീത്യത്ര കോഽപി സന്ദേഹോ നാസ്തി|</para>
  <para style="p">
    <verse number="8" style="v"/>അപരമ് ഇദാനീം യേ ദശമാംശം ഗൃഹ്ലന്തി തേ മൃത്യോരധീനാ മാനവാഃ കിന്തു തദാനീം യോ ഗൃഹീതവാൻ സ ജീവതീതിപ്രമാണപ്രാപ്തഃ|</para>
  <para style="p">
    <verse number="9" style="v"/>അപരം ദശമാംശഗ്രാഹീ ലേവിരപീബ്രാഹീമ്ദ്വാരാ ദശമാംശം ദത്തവാൻ ഏതദപി കഥയിതും ശക്യതേ|</para>
  <para style="p">
    <verse number="10" style="v"/>യതോ യദാ മൽകീഷേദക് തസ്യ പിതരം സാക്ഷാത് കൃതവാൻ തദാനീം സ ലേവിഃ പിതുരുരസ്യാസീത്|</para>
  <para style="p">
    <verse number="11" style="v"/>അപരം യസ്യ സമ്ബന്ധേ ലോകാ വ്യവസ്ഥാം ലബ്ധവന്തസ്തേന ലേവീയയാജകവർഗേണ യദി സിദ്ധിഃ സമഭവിഷ്യത് തർഹി ഹാരോണസ്യ ശ്രേണ്യാ മധ്യാദ് യാജകം ന നിരൂപ്യേശ്വരേണ മൽകീഷേദകഃ ശ്രേണ്യാ മധ്യാദ് അപരസ്യൈകസ്യ യാജകസ്യോത്ഥാപനം കുത ആവശ്യകമ് അഭവിഷ്യത്?</para>
  <para style="p">
    <verse number="12" style="v"/>യതോ യാജകവർഗസ്യ വിനിമയേന സുതരാം വ്യവസ്ഥായാ അപി വിനിമയോ ജായതേ|</para>
  <para style="p">
    <verse number="13" style="v"/>അപരഞ്ച തദ് വാക്യം യസ്യോദ്ദേശ്യം സോഽപരേണ വംശേന സംയുക്താഽസ്തി തസ്യ വംശസ്യ ച കോഽപി കദാപി വേദ്യാഃ കർമ്മ ന കൃതവാൻ|</para>
  <para style="p">
    <verse number="14" style="v"/>വസ്തുതസ്തു യം വംശമധി മൂസാ യാജകത്വസ്യൈകാം കഥാമപി ന കഥിതവാൻ തസ്മിൻ യിഹൂദാവംശേഽസ്മാകം പ്രഭു ർജന്മ ഗൃഹീതവാൻ ഇതി സുസ്പഷ്ടം|</para>
  <para style="p">
    <verse number="15" style="v"/>തസ്യ സ്പഷ്ടതരമ് അപരം പ്രമാണമിദം യത് മൽകീഷേദകഃ സാദൃശ്യവതാപരേണ താദൃശേന യാജകേനോദേതവ്യം,</para>
  <para style="p">
    <verse number="16" style="v"/>യസ്യ നിരൂപണം ശരീരസമ്ബന്ധീയവിധിയുക്തയാ വ്യവസ്ഥായാ ന ഭവതി കിന്ത്വക്ഷയജീവനയുക്തയാ ശക്ത്യാ ഭവതി|</para>
  <para style="p">
    <verse number="17" style="v"/>യത ഈശ്വര ഇദം സാക്ഷ്യം ദത്തവാൻ, യഥാ, "ത്വം മക്ലീഷേദകഃ ശ്രേണ്യാം യാജകോഽസി സദാതനഃ| "</para>
  <para style="p">
    <verse number="18" style="v"/>അനേനാഗ്രവർത്തിനോ വിധേ ദുർബ്ബലതായാ നിഷ്ഫലതായാശ്ച ഹേതോരർഥതോ വ്യവസ്ഥയാ കിമപി സിദ്ധം ന ജാതമിതിഹേതോസ്തസ്യ ലോപോ ഭവതി|</para>
  <para style="p">
    <verse number="19" style="v"/>യയാ ച വയമ് ഈശ്വരസ്യ നികടവർത്തിനോ ഭവാമ ഏതാദൃശീ ശ്രേഷ്ഠപ്രത്യാശാ സംസ്ഥാപ്യതേ|</para>
  <para style="p">
    <verse number="20" style="v"/>അപരം യീശുഃ ശപഥം വിനാ ന നിയുക്തസ്തസ്മാദപി സ ശ്രേഷ്ഠനിയമസ്യ മധ്യസ്ഥോ ജാതഃ|</para>
  <para style="p">
    <verse number="21" style="v"/>യതസ്തേ ശപഥം വിനാ യാജകാ ജാതാഃ കിന്ത്വസൗ ശപഥേന ജാതഃ യതഃ സ ഇദമുക്തഃ, യഥാ,</para>
  <para style="p">
    <verse number="22" style="v"/>"പരമേശ ഇദം ശേപേ ന ച തസ്മാന്നിവർത്സ്യതേ| ത്വം മൽകീഷേദകഃ ശ്രേണ്യാം യാജകോഽസി സദാതനഃ| "</para>
  <para style="p">
    <verse number="23" style="v"/>തേ ച ബഹവോ യാജകാ അഭവൻ യതസ്തേ മൃത്യുനാ നിത്യസ്ഥായിത്വാത് നിവാരിതാഃ,</para>
  <para style="p">
    <verse number="24" style="v"/>കിന്ത്വസാവനന്തകാലം യാവത് തിഷ്ഠതി തസ്മാത് തസ്യ യാജകത്വം ന പരിവർത്തനീയം|</para>
  <para style="p">
    <verse number="25" style="v"/>തതോ ഹേതോ ര്യേ മാനവാസ്തേനേശ്വരസ്യ സന്നിധിം ഗച്ഛന്തി താൻ സ ശേഷം യാവത് പരിത്രാതും ശക്നോതി യതസ്തേഷാം കൃതേ പ്രാർഥനാം കർത്തും സ സതതം ജീവതി|</para>
  <para style="p">
    <verse number="26" style="v"/>അപരമ് അസ്മാകം താദൃശമഹായാജകസ്യ പ്രയോജനമാസീദ് യഃ പവിത്രോ ഽഹിംസകോ നിഷ്കലങ്കഃ പാപിഭ്യോ ഭിന്നഃ സ്വർഗാദപ്യുച്ചീകൃതശ്ച സ്യാത്|</para>
  <para style="p">
    <verse number="27" style="v"/>അപരം മഹായാജകാനാം യഥാ തഥാ തസ്യ പ്രതിദിനം പ്രഥമം സ്വപാപാനാം കൃതേ തതഃ പരം ലോകാനാം പാപാനാം കൃതേ ബലിദാനസ്യ പ്രയോജനം നാസ്തി യത ആത്മബലിദാനം കൃത്വാ തദ് ഏകകൃത്വസ്തേന സമ്പാദിതം|</para>
  <para style="p">
    <verse number="28" style="v"/>യതോ വ്യവസ്ഥയാ യേ മഹായാജകാ നിരൂപ്യന്തേ തേ ദൗർബ്ബല്യയുക്താ മാനവാഃ കിന്തു വ്യവസ്ഥാതഃ പരം ശപഥയുക്തേന വാക്യേന യോ മഹായാജകോ നിരൂപിതഃ സോ ഽനന്തകാലാർഥം സിദ്ധഃ പുത്ര ഏവ|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>കഥ്യമാനാനാം വാക്യാനാം സാരോഽയമ് അസ്മാകമ് ഏതാദൃശ ഏകോ മഹായാജകോഽസ്തി യഃ സ്വർഗേ മഹാമഹിമ്നഃ സിംഹാസനസ്യ ദക്ഷിണപാർശ്വോ സമുപവിഷ്ടവാൻ</para>
  <para style="p">
    <verse number="2" style="v"/>യച്ച ദൂഷ്യം ന മനുജൈഃ കിന്ത്വീശ്വരേണ സ്ഥാപിതം തസ്യ സത്യദൂഷ്യസ്യ പവിത്രവസ്തൂനാഞ്ച സേവകഃ സ ഭവതി|</para>
  <para style="p">
    <verse number="3" style="v"/>യത ഏകൈകോ മഹായാജകോ നൈവേദ്യാനാം ബലീനാഞ്ച ദാനേ നിയുജ്യതേ, അതോ ഹേതോരേതസ്യാപി കിഞ്ചിദ് ഉത്സർജനീയം വിദ്യത ഇത്യാവശ്യകം|</para>
  <para style="p">
    <verse number="4" style="v"/>കിഞ്ച സ യദി പൃഥിവ്യാമ് അസ്ഥാസ്യത് തർഹി യാജകോ നാഭവിഷ്യത്, യതോ യേ വ്യവസ്ഥാനുസാരാത് നൈവേദ്യാനി ദദത്യേതാദൃശാ യാജകാ വിദ്യന്തേ|</para>
  <para style="p">
    <verse number="5" style="v"/>തേ തു സ്വർഗീയവസ്തൂനാം ദൃഷ്ടാന്തേന ഛായയാ ച സേവാമനുതിഷ്ഠന്തി യതോ മൂസസി ദൂഷ്യം സാധയിതുമ് ഉദ്യതേ സതീശ്വരസ്തദേവ തമാദിഷ്ടവാൻ ഫലതഃ സ തമുക്തവാൻ, യഥാ, "അവധേഹി ഗിരൗ ത്വാം യദ്യന്നിദർശനം ദർശിതം തദ്വത് സർവ്വാണി ത്വയാ ക്രിയന്താം| "</para>
  <para style="p">
    <verse number="6" style="v"/>കിന്ത്വിദാനീമ് അസൗ തസ്മാത് ശ്രേഷ്ഠം സേവകപദം പ്രാപ്തവാൻ യതഃ സ ശ്രേഷ്ഠപ്രതിജ്ഞാഭിഃ സ്ഥാപിതസ്യ ശ്രേഷ്ഠനിയമസ്യ മധ്യസ്ഥോഽഭവത്|</para>
  <para style="p">
    <verse number="7" style="v"/>സ പ്രഥമോ നിയമോ യദി നിർദ്ദോഷോഽഭവിഷ്യത തർഹി ദ്വിതീയസ്യ നിയമസ്യ കിമപി പ്രയോജനം നാഭവിഷ്യത്|</para>
  <para style="p">
    <verse number="8" style="v"/>കിന്തു സ ദോഷമാരോപയൻ തേഭ്യഃ കഥയതി, യഥാ, "പരമേശ്വര ഇദം ഭാഷതേ പശ്യ യസ്മിൻ സമയേഽഹമ് ഇസ്രായേലവംശേന യിഹൂദാവംശേന ച സാർദ്ധമ് ഏകം നവീനം നിയമം സ്ഥിരീകരിഷ്യാമ്യേതാദൃശഃ സമയ ആയാതി|</para>
  <para style="p">
    <verse number="9" style="v"/>പരമേശ്വരോഽപരമപി കഥയതി തേഷാം പൂർവ്വപുരുഷാണാം മിസരദേശാദ് ആനയനാർഥം യസ്മിൻ ദിനേഽഹം തേഷാം കരം ധൃത്വാ തൈഃ സഹ നിയമം സ്ഥിരീകൃതവാൻ തദ്ദിനസ്യ നിയമാനുസാരേണ നഹി യതസ്തൈ ർമമ നിയമേ ലങ്ഘിതേഽഹം താൻ പ്രതി ചിന്താം നാകരവം|</para>
  <para style="p">
    <verse number="10" style="v"/>കിന്തു പരമേശ്വരഃ കഥയതി തദ്ദിനാത് പരമഹം ഇസ്രായേലവംശീയൈഃ സാർദ്ധമ് ഇമം നിയമം സ്ഥിരീകരിഷ്യാമി, തേഷാം ചിത്തേ മമ വിധീൻ സ്ഥാപയിഷ്യാമി തേഷാം ഹൃത്പത്രേ ച താൻ ലേഖിഷ്യാമി, അപരമഹം തേഷാമ് ഈശ്വരോ ഭവിഷ്യാമി തേ ച മമ ലോകാ ഭവിഷ്യന്തി|</para>
  <para style="p">
    <verse number="11" style="v"/>അപരം ത്വം പരമേശ്വരം ജാനീഹീതിവാക്യേന തേഷാമേകൈകോ ജനഃ സ്വം സ്വം സമീപവാസിനം ഭ്രാതരഞ്ച പുന ർന ശിക്ഷയിഷ്യതി യത ആക്ഷുദ്രാത് മഹാന്തം യാവത് സർവ്വേ മാം ജ്ഞാസ്യന്തി|</para>
  <para style="p">
    <verse number="12" style="v"/>യതോ ഹേതോരഹം തേഷാമ് അധർമ്മാൻ ക്ഷമിഷ്യേ തേഷാം പാപാന്യപരാധാംശ്ച പുനഃ കദാപി ന സ്മരിഷ്യാമി| "</para>
  <para style="p">
    <verse number="13" style="v"/>അനേന തം നിയമം നൂതനം ഗദിത്വാ സ പ്രഥമം നിയമം പുരാതനീകൃതവാൻ; യച്ച പുരാതനം ജീർണാഞ്ച ജാതം തസ്യ ലോപോ നികടോ ഽഭവത്|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>സ പ്രഥമോ നിയമ ആരാധനായാ വിവിധരീതിഭിരൈഹികപവിത്രസ്ഥാനേന ച വിശിഷ്ട ആസീത്|</para>
  <para style="p">
    <verse number="2" style="v"/>യതോ ദൂഷ്യമേകം നിരമീയത തസ്യ പ്രഥമകോഷ്ഠസ്യ നാമ പവിത്രസ്ഥാനമിത്യാസീത് തത്ര ദീപവൃക്ഷോ ഭോജനാസനം ദർശനീയപൂപാനാം ശ്രേണീ ചാസീത്|</para>
  <para style="p">
    <verse number="3" style="v"/>തത്പശ്ചാദ് ദ്വിതീയായാസ്തിരഷ്കരിണ്യാ അഭ്യന്തരേ ഽതിപവിത്രസ്ഥാനമിതിനാമകം കോഷ്ഠമാസീത്,</para>
  <para style="p">
    <verse number="4" style="v"/>തത്ര ച സുവർണമയോ ധൂപാധാരഃ പരിതഃ സുവർണമണ്ഡിതാ നിയമമഞ്ജൂഷാ ചാസീത് തന്മധ്യേ മാന്നായാഃ സുവർണഘടോ ഹാരോണസ്യ മഞ്ജരിതദണ്ഡസ്തക്ഷിതൗ നിയമപ്രസ്തരൗ,</para>
  <para style="p">
    <verse number="5" style="v"/>തദുപരി ച കരുണാസനേ ഛായാകാരിണൗ തേജോമയൗ കിരൂബാവാസ്താമ്, ഏതേഷാം വിശേഷവൃത്താന്തകഥനായ നായം സമയഃ|</para>
  <para style="p">
    <verse number="6" style="v"/>ഏതേഷ്വീദൃക് നിർമ്മിതേഷു യാജകാ ഈശ്വരസേവാമ് അനുതിഷ്ഠനതോ ദൂഷ്യസ്യ പ്രഥമകോഷ്ഠം നിത്യം പ്രവിശന്തി|</para>
  <para style="p">
    <verse number="7" style="v"/>കിന്തു ദ്വിതീയം കോഷ്ഠം പ്രതിവർഷമ് ഏകകൃത്വ ഏകാകിനാ മഹായാജകേന പ്രവിശ്യതേ കിന്ത്വാത്മനിമിത്തം ലോകാനാമ് അജ്ഞാനകൃതപാപാനാഞ്ച നിമിത്തമ് ഉത്സർജ്ജനീയം രുധിരമ് അനാദായ തേന ന പ്രവിശ്യതേ|</para>
  <para style="p">
    <verse number="8" style="v"/>ഇത്യനേന പവിത്ര ആത്മാ യത് ജ്ഞാപയതി തദിദം തത് പ്രഥമം ദൂഷ്യം യാവത് തിഷ്ഠതി താവത് മഹാപവിത്രസ്ഥാനഗാമീ പന്ഥാ അപ്രകാശിതസ്തിഷ്ഠതി|</para>
  <para style="p">
    <verse number="9" style="v"/>തച്ച ദൂഷ്യം വർത്തമാനസമയസ്യ ദൃഷ്ടാന്തഃ, യതോ ഹേതോഃ സാമ്പ്രതം സംശോധനകാലം യാവദ് യന്നിരൂപിതം തദനുസാരാത് സേവാകാരിണോ മാനസികസിദ്ധികരണേഽസമർഥാഭിഃ</para>
  <para style="p">
    <verse number="10" style="v"/>കേവലം ഖാദ്യപേയേഷു വിവിധമജ്ജനേഷു ച ശാരീരികരീതിഭി ര്യുക്താനി നൈവേദ്യാനി ബലിദാനാനി ച ഭവന്തി|</para>
  <para style="p">
    <verse number="11" style="v"/>അപരം ഭാവിമങ്ഗലാനാം മഹായാജകഃ ഖ്രീഷ്ട ഉപസ്ഥായാഹസ്തനിർമ്മിതേനാർഥത ഏതത്സൃഷ്ടേ ർബഹിർഭൂതേന ശ്രേഷ്ഠേന സിദ്ധേന ച ദൂഷ്യേണ ഗത്വാ</para>
  <para style="p">
    <verse number="12" style="v"/>ഛാഗാനാം ഗോവത്സാനാം വാ രുധിരമ് അനാദായ സ്വീയരുധിരമ് ആദായൈകകൃത്വ ഏവ മഹാപവിത്രസ്ഥാനം പ്രവിശ്യാനന്തകാലികാം മുക്തിം പ്രാപ്തവാൻ|</para>
  <para style="p">
    <verse number="13" style="v"/>വൃഷഛാഗാനാം രുധിരേണ ഗവീഭസ്മനഃ പ്രക്ഷേപേണ ച യദ്യശുചിലോകാഃ ശാരീരിശുചിത്വായ പൂയന്തേ,</para>
  <para style="p">
    <verse number="14" style="v"/>തർഹി കിം മന്യധ്വേ യഃ സദാതനേനാത്മനാ നിഷ്കലങ്കബലിമിവ സ്വമേവേശ്വരായ ദത്തവാൻ, തസ്യ ഖ്രീഷ്ടസ്യ രുധിരേണ യുഷ്മാകം മനാംസ്യമരേശ്വരസ്യ സേവായൈ കിം മൃത്യുജനകേഭ്യഃ കർമ്മഭ്യോ ന പവിത്രീകാരിഷ്യന്തേ?</para>
  <para style="p">
    <verse number="15" style="v"/>സ നൂതനനിയമസ്യ മധ്യസ്ഥോഽഭവത് തസ്യാഭിപ്രായോഽയം യത് പ്രഥമനിയമലങ്ഘനരൂപപാപേഭ്യോ മൃത്യുനാ മുക്തൗ ജാതായാമ് ആഹൂതലോകാ അനന്തകാലീയസമ്പദഃ പ്രതിജ്ഞാഫലം ലഭേരൻ|</para>
  <para style="p">
    <verse number="16" style="v"/>യത്ര നിയമോ ഭവതി തത്ര നിയമസാധകസ്യ ബലേ ർമൃത്യുനാ ഭവിതവ്യം|</para>
  <para style="p">
    <verse number="17" style="v"/>യതോ ഹതേന ബലിനാ നിയമഃ സ്ഥിരീഭവതി കിന്തു നിയമസാധകോ ബലി ര്യാവത് ജീവതി താവത് നിയമോ നിരർഥകസ്തിഷ്ഠതി|</para>
  <para style="p">
    <verse number="18" style="v"/>തസ്മാത് സ പൂർവ്വനിയമോഽപി രുധിരപാതം വിനാ ന സാധിതഃ|</para>
  <para style="p">
    <verse number="19" style="v"/>ഫലതഃ സർവ്വലോകാൻ പ്രതി വ്യവസ്ഥാനുസാരേണ സർവ്വാ ആജ്ഞാഃ കഥയിത്വാ മൂസാ ജലേന സിന്ദൂരവർണലോമ്നാ ഏഷോവതൃണേന ച സാർദ്ധം ഗോവത്സാനാം ഛാഗാനാഞ്ച രുധിരം ഗൃഹീത്വാ ഗ്രന്ഥേ സർവ്വലോകേഷു ച പ്രക്ഷിപ്യ ബഭാഷേ,</para>
  <para style="p">
    <verse number="20" style="v"/>യുഷ്മാൻ അധീശ്വരോ യം നിയമം നിരൂപിതവാൻ തസ്യ രുധിരമേതത്|</para>
  <para style="p">
    <verse number="21" style="v"/>തദ്വത് സ ദൂഷ്യേഽപി സേവാർഥകേഷു സർവ്വപാത്രേഷു ച രുധിരം പ്രക്ഷിപ്തവാൻ|</para>
  <para style="p">
    <verse number="22" style="v"/>അപരം വ്യവസ്ഥാനുസാരേണ പ്രായശഃ സർവ്വാണി രുധിരേണ പരിഷ്ക്രിയന്തേ രുധിരപാതം വിനാ പാപമോചനം ന ഭവതി ച|</para>
  <para style="p">
    <verse number="23" style="v"/>അപരം യാനി സ്വർഗീയവസ്തൂനാം ദൃഷ്ടാന്താസ്തേഷാമ് ഏതൈഃ പാവനമ് ആവശ്യകമ് ആസീത് കിന്തു സാക്ഷാത് സ്വർഗീയവസ്തൂനാമ് ഏതേഭ്യഃ ശ്രേഷ്ഠേै ർബലിദാനൈഃ പാവനമാവശ്യകം|</para>
  <para style="p">
    <verse number="24" style="v"/>യതഃ ഖ്രീഷ്ടഃ സത്യപവിത്രസ്ഥാനസ്യ ദൃഷ്ടാന്തരൂപം ഹസ്തകൃതം പവിത്രസ്ഥാനം ന പ്രവിഷ്ടവാൻ കിന്ത്വസ്മന്നിമിത്തമ് ഇദാനീമ് ഈശ്വരസ്യ സാക്ഷാദ് ഉപസ്ഥാതും സ്വർഗമേവ പ്രവിഷ്ടഃ|</para>
  <para style="p">
    <verse number="25" style="v"/>യഥാ ച മഹായാജകഃ പ്രതിവർഷം പരശോണിതമാദായ മഹാപവിത്രസ്ഥാനം പ്രവിശതി തഥാ ഖ്രീഷ്ടേന പുനഃ പുനരാത്മോത്സർഗോ ന കർത്തവ്യഃ,</para>
  <para style="p">
    <verse number="26" style="v"/>കർത്തവ്യേ സതി ജഗതഃ സൃഷ്ടികാലമാരഭ്യ ബഹുവാരം തസ്യ മൃത്യുഭോഗ ആവശ്യകോഽഭവത്; കിന്ത്വിദാനീം സ ആത്മോത്സർഗേണ പാപനാശാർഥമ് ഏകകൃത്വോ ജഗതഃ ശേഷകാലേ പ്രചകാശേ|</para>
  <para style="p">
    <verse number="27" style="v"/>അപരം യഥാ മാനുഷസ്യൈകകൃത്വോ മരണം തത് പശ്ചാദ് വിചാരോ നിരൂപിതോഽസ്തി,</para>
  <para style="p">
    <verse number="28" style="v"/>തദ്വത് ഖ്രീഷ്ടോഽപി ബഹൂനാം പാപവഹനാർഥം ബലിരൂപേണൈകകൃത്വ ഉത്സസൃജേ, അപരം ദ്വിതീയവാരം പാപാദ് ഭിന്നഃ സൻ യേ തം പ്രതീക്ഷന്തേ തേഷാം പരിത്രാണാർഥം ദർശനം ദാസ്യതി|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>വ്യവസ്ഥാ ഭവിഷ്യന്മങ്ഗലാനാം ഛായാസ്വരൂപാ ന ച വസ്തൂനാം മൂർത്തിസ്വരൂപാ തതോ ഹേതോ ർനിത്യം ദീയമാനൈരേകവിധൈ ർവാർഷികബലിഭിഃ ശരണാഗതലോകാൻ സിദ്ധാൻ കർത്തും കദാപി ന ശക്നോതി|</para>
  <para style="p">
    <verse number="2" style="v"/>യദ്യശക്ഷ്യത് തർഹി തേഷാം ബലീനാം ദാനം കിം ന ന്യവർത്തിഷ്യത? യതഃ സേവാകാരിഷ്വേകകൃത്വഃ പവിത്രീഭൂതേഷു തേഷാം കോഽപി പാപബോധഃ പുന ർനാഭവിഷ്യത്|</para>
  <para style="p">
    <verse number="3" style="v"/>കിന്തു തൈ ർബലിദാനൈഃ പ്രതിവത്സരം പാപാനാം സ്മാരണം ജായതേ|</para>
  <para style="p">
    <verse number="4" style="v"/>യതോ വൃഷാണാം ഛാഗാനാം വാ രുധിരേണ പാപമോചനം ന സമ്ഭവതി|</para>
  <para style="p">
    <verse number="5" style="v"/>ഏതത്കാരണാത് ഖ്രീഷ്ടേന ജഗത് പ്രവിശ്യേദമ് ഉച്യതേ, യഥാ, "നേഷ്ട്വാ ബലിം ന നൈവേദ്യം ദേഹോ മേ നിർമ്മിതസ്ത്വയാ|</para>
  <para style="p">
    <verse number="6" style="v"/>ന ച ത്വം ബലിഭി ർഹവ്യൈഃ പാപഘ്നൈ ർവാ പ്രതുഷ്യസി|</para>
  <para style="p">
    <verse number="7" style="v"/>അവാദിഷം തദൈവാഹം പശ്യ കുർവ്വേ സമാഗമം| ധർമ്മഗ്രന്ഥസ്യ സർഗേ മേ വിദ്യതേ ലിഖിതാ കഥാ| ഈശ മനോഽഭിലാഷസ്തേ മയാ സമ്പൂരയിഷ്യതേ| "</para>
  <para style="p">
    <verse number="8" style="v"/>ഇത്യസ്മിൻ പ്രഥമതോ യേഷാം ദാനം വ്യവസ്ഥാനുസാരാദ് ഭവതി താന്യധി തേനേദമുക്തം യഥാ, ബലിനൈവേദ്യഹവ്യാനി പാപഘ്നഞ്ചോപചാരകം, നേമാനി വാഞ്ഛസി ത്വം ഹി ന ചൈതേഷു പ്രതുഷ്യസീതി|</para>
  <para style="p">
    <verse number="9" style="v"/>തതഃ പരം തേനോക്തം യഥാ, "പശ്യ മനോഽഭിലാഷം തേ കർത്തും കുർവ്വേ സമാഗമം;" ദ്വിതീയമ് ഏതദ് വാക്യം സ്ഥിരീകർത്തും സ പ്രഥമം ലുമ്പതി|</para>
  <para style="p">
    <verse number="10" style="v"/>തേന മനോഽഭിലാഷേണ ച വയം യീശുഖ്രീഷ്ടസ്യൈകകൃത്വഃ സ്വശരീരോത്സർഗാത് പവിത്രീകൃതാ അഭവാമ|</para>
  <para style="p">
    <verse number="11" style="v"/>അപരമ് ഏകൈകോ യാജകഃ പ്രതിദിനമ് ഉപാസനാം കുർവ്വൻ യൈശ്ച പാപാനി നാശയിതും കദാപി ന ശക്യന്തേ താദൃശാൻ ഏകരൂപാൻ ബലീൻ പുനഃ പുനരുത്സൃജൻ തിഷ്ഠതി|</para>
  <para style="p">
    <verse number="12" style="v"/>കിന്ത്വസൗ പാപനാശകമ് ഏകം ബലിം ദത്വാനന്തകാലാർഥമ് ഈശ്വരസ്യ ദക്ഷിണ ഉപവിശ്യ</para>
  <para style="p">
    <verse number="13" style="v"/>യാവത് തസ്യ ശത്രവസ്തസ്യ പാദപീഠം ന ഭവന്തി താവത് പ്രതീക്ഷമാണസ്തിഷ്ഠതി|</para>
  <para style="p">
    <verse number="14" style="v"/>യത ഏകേന ബലിദാനേന സോഽനന്തകാലാർഥം പൂയമാനാൻ ലോകാൻ സാധിതവാൻ|</para>
  <para style="p">
    <verse number="15" style="v"/>ഏതസ്മിൻ പവിത്ര ആത്മാപ്യസ്മാകം പക്ഷേ പ്രമാണയതി</para>
  <para style="p">
    <verse number="16" style="v"/>"യതോ ഹേതോസ്തദ്ദിനാത് പരമ് അഹം തൈഃ സാർദ്ധമ് ഇമം നിയമം സ്ഥിരീകരിഷ്യാമീതി പ്രഥമത ഉക്ത്വാ പരമേശ്വരേണേദം കഥിതം, തേഷാം ചിത്തേ മമ വിധീൻ സ്ഥാപയിഷ്യാമി തേഷാം മനഃസു ച താൻ ലേഖിഷ്യാമി ച,</para>
  <para style="p">
    <verse number="17" style="v"/>അപരഞ്ച തേഷാം പാപാന്യപരാധാംശ്ച പുനഃ കദാപി ന സ്മാരിഷ്യാമി| "</para>
  <para style="p">
    <verse number="18" style="v"/>കിന്തു യത്ര പാപമോചനം ഭവതി തത്ര പാപാർഥകബലിദാനം പുന ർന ഭവതി|</para>
  <para style="p">
    <verse number="19" style="v"/>അതോ ഹേ ഭ്രാതരഃ, യീശോ രുധിരേണ പവിത്രസ്ഥാനപ്രവേശായാസ്മാകമ് ഉത്സാഹോ ഭവതി,</para>
  <para style="p">
    <verse number="20" style="v"/>യതഃ സോഽസ്മദർഥം തിരസ്കരിണ്യാർഥതഃ സ്വശരീരേണ നവീനം ജീവനയുക്തഞ്ചൈകം പന്ഥാനം നിർമ്മിതവാൻ,</para>
  <para style="p">
    <verse number="21" style="v"/>അപരഞ്ചേശ്വരീയപരിവാരസ്യാധ്യക്ഷ ഏകോ മഹായാജകോഽസ്മാകമസ്തി|</para>
  <para style="p">
    <verse number="22" style="v"/>അതോ ഹേതോരസ്മാഭിഃ സരലാന്തഃകരണൈ ർദൃഢവിശ്വാസൈഃ പാപബോധാത് പ്രക്ഷാലിതമനോഭി ർനിർമ്മലജലേ സ്നാതശരീരൈശ്ചേശ്വരമ് ഉപാഗത്യ പ്രത്യാശായാഃ പ്രതിജ്ഞാ നിശ്ചലാ ധാരയിതവ്യാ|</para>
  <para style="p">
    <verse number="23" style="v"/>യതോ യസ്താമ് അങ്ഗീകൃതവാൻ സ വിശ്വസനീയഃ|</para>
  <para style="p">
    <verse number="24" style="v"/>അപരം പ്രേമ്നി സത്ക്രിയാസു ചൈകൈകസ്യോത്സാഹവൃദ്ധ്യർഥമ് അസ്മാഭിഃ പരസ്പരം മന്ത്രയിതവ്യം|</para>
  <para style="p">
    <verse number="25" style="v"/>അപരം കതിപയലോകാ യഥാ കുർവ്വന്തി തഥാസ്മാഭിഃ സഭാകരണം ന പരിത്യക്തവ്യം പരസ്പരമ് ഉപദേഷ്ടവ്യഞ്ച യതസ്തത് മഹാദിനമ് ഉത്തരോത്തരം നികടവർത്തി ഭവതീതി യുഷ്മാഭി ർദൃശ്യതേ|</para>
  <para style="p">
    <verse number="26" style="v"/>സത്യമതസ്യ ജ്ഞാനപ്രാപ്തേഃ പരം യദി വയം സ്വംച്ഛയാ പാപാചാരം കുർമ്മസ്തർഹി പാപാനാം കൃതേ ഽന്യത് കിമപി ബലിദാനം നാവശിഷ്യതേ</para>
  <para style="p">
    <verse number="27" style="v"/>കിന്തു വിചാരസ്യ ഭയാനകാ പ്രതീക്ഷാ രിപുനാശകാനലസ്യ താപശ്ചാവശിഷ്യതേ|</para>
  <para style="p">
    <verse number="28" style="v"/>യഃ കശ്ചിത് മൂസസോ വ്യവസ്ഥാമ് അവമന്യതേ സ ദയാം വിനാ ദ്വയോസ്തിസൃണാം വാ സാക്ഷിണാം പ്രമാണേന ഹന്യതേ,</para>
  <para style="p">
    <verse number="29" style="v"/>തസ്മാത് കിം ബുധ്യധ്വേ യോ ജന ഈശ്വരസ്യ പുത്രമ് അവജാനാതി യേന ച പവിത്രീകൃതോ ഽഭവത് തത് നിയമസ്യ രുധിരമ് അപവിത്രം ജാനാതി, അനുഗ്രഹകരമ് ആത്മാനമ് അപമന്യതേ ച, സ കിയന്മഹാഘോരതരദണ്ഡസ്യ യോഗ്യോ ഭവിഷ്യതി?</para>
  <para style="p">
    <verse number="30" style="v"/>യതഃ പരമേശ്വരഃ കഥയതി, "ദാനം ഫലസ്യ മത്കർമ്മ സൂചിതം പ്രദദാമ്യഹം| " പുനരപി, "തദാ വിചാരയിഷ്യന്തേ പരേശേന നിജാഃ പ്രജാഃ| " ഇദം യഃ കഥിതവാൻ തം വയം ജാനീമഃ|</para>
  <para style="p">
    <verse number="31" style="v"/>അമരേശ്വരസ്യ കരയോഃ പതനം മഹാഭയാനകം|</para>
  <para style="p">
    <verse number="32" style="v"/>ഹേ ഭ്രാതരഃ, പൂർവ്വദിനാനി സ്മരത യതസ്തദാനീം യൂയം ദീപ്തിം പ്രാപ്യ ബഹുദുർഗതിരൂപം സംഗ്രാമം സഹമാനാ ഏകതോ നിന്ദാക്ലേശൈഃ കൗതുകീകൃതാ അഭവത,</para>
  <para style="p">
    <verse number="33" style="v"/>അന്യതശ്ച തദ്ഭോഗിനാം സമാംശിനോ ഽഭവത|</para>
  <para style="p">
    <verse number="34" style="v"/>യൂയം മമ ബന്ധനസ്യ ദുഃഖേന ദുഃഖിനോ ഽഭവത, യുഷ്മാകമ് ഉത്തമാ നിത്യാ ച സമ്പത്തിഃ സ്വർഗേ വിദ്യത ഇതി ജ്ഞാത്വാ സാനന്ദം സർവ്വസ്വസ്യാപഹരണമ് അസഹധ്വഞ്ച|</para>
  <para style="p">
    <verse number="35" style="v"/>അതഏവ മഹാപുരസ്കാരയുക്തം യുഷ്മാകമ് ഉത്സാഹം ന പരിത്യജത|</para>
  <para style="p">
    <verse number="36" style="v"/>യതോ യൂയം യേനേശ്വരസ്യേച്ഛാം പാലയിത്വാ പ്രതിജ്ഞായാഃ ഫലം ലഭധ്വം തദർഥം യുഷ്മാഭി ർധൈര്യ്യാവലമ്ബനം കർത്തവ്യം|</para>
  <para style="p">
    <verse number="37" style="v"/>യേനാഗന്തവ്യം സ സ്വൽപകാലാത് പരമ് ആഗമിഷ്യതി ന ച വിലമ്ബിഷ്യതേ|</para>
  <para style="p">
    <verse number="38" style="v"/>"പുണ്യവാൻ ജനോ വിശ്വാസേന ജീവിഷ്യതി കിന്തു യദി നിവർത്തതേ തർഹി മമ മനസ്തസ്മിൻ ന തോഷം യാസ്യതി| "</para>
  <para style="p">
    <verse number="39" style="v"/>കിന്തു വയം വിനാശജനികാം ധർമ്മാത് നിവൃത്തിം ന കുർവ്വാണാ ആത്മനഃ പരിത്രാണായ വിശ്വാസം കുർവ്വാമഹേे|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>വിശ്വാസ ആശംസിതാനാം നിശ്ചയഃ, അദൃശ്യാനാം വിഷയാണാം ദർശനം ഭവതി|</para>
  <para style="p">
    <verse number="2" style="v"/>തേന വിശ്വാസേന പ്രാഞ്ചോ ലോകാഃ പ്രാമാണ്യം പ്രാപ്തവന്തഃ|</para>
  <para style="p">
    <verse number="3" style="v"/>അപരമ് ഈശ്വരസ്യ വാക്യേന ജഗന്ത്യസൃജ്യന്ത, ദൃഷ്ടവസ്തൂനി ച പ്രത്യക്ഷവസ്തുഭ്യോ നോദപദ്യന്തൈതദ് വയം വിശ്വാസേന ബുധ്യാമഹേ|</para>
  <para style="p">
    <verse number="4" style="v"/>വിശ്വാസേന ഹാബിൽ ഈശ്വരമുദ്ദിശ്യ കാബിലഃ ശ്രേഷ്ഠം ബലിദാനം കൃതവാൻ തസ്മാച്ചേശ്വരേണ തസ്യ ദാനാന്യധി പ്രമാണേ ദത്തേ സ ധാർമ്മിക ഇത്യസ്യ പ്രമാണം ലബ്ധവാൻ തേന വിശ്വാസേന ച സ മൃതഃ സൻ അദ്യാപി ഭാഷതേ|</para>
  <para style="p">
    <verse number="5" style="v"/>വിശ്വാസേന ഹനോക് യഥാ മൃത്യും ന പശ്യേത് തഥാ ലോകാന്തരം നീതഃ, തസ്യോദ്ദേശശ്ച കേനാപി ന പ്രാപി യത ഈശ്വരസ്തം ലോകാന്തരം നീതവാൻ, തത്പ്രമാണമിദം തസ്യ ലോകാന്തരീകരണാത് പൂർവ്വം സ ഈശ്വരായ രോചിതവാൻ ഇതി പ്രമാണം പ്രാപ്തവാൻ|</para>
  <para style="p">
    <verse number="6" style="v"/>കിന്തു വിശ്വാസം വിനാ കോഽപീശ്വരായ രോചിതും ന ശക്നോതി യത ഈശ്വരോഽസ്തി സ്വാന്വേഷിലോകേഭ്യഃ പുരസ്കാരം ദദാതി ചേതികഥായാമ് ഈശ്വരശരണാഗതൈ ർവിശ്വസിതവ്യം|</para>
  <para style="p">
    <verse number="7" style="v"/>അപരം തദാനീം യാന്യദൃശ്യാന്യാസൻ താനീശ്വരേണാദിഷ്ടഃ സൻ നോഹോ വിശ്വാസേന ഭീത്വാ സ്വപരിജനാനാം രക്ഷാർഥം പോതം നിർമ്മിതവാൻ തേന ച ജഗജ്ജനാനാം ദോഷാൻ ദർശിതവാൻ വിശ്വാസാത് ലഭ്യസ്യ പുണ്യസ്യാധികാരീ ബഭൂവ ച|</para>
  <para style="p">
    <verse number="8" style="v"/>വിശ്വാസേനേബ്രാഹീമ് ആഹൂതഃ സൻ ആജ്ഞാം ഗൃഹീത്വാ യസ്യ സ്ഥാനസ്യാധികാരസ്തേന പ്രാപ്തവ്യസ്തത് സ്ഥാനം പ്രസ്ഥിതവാൻ കിന്തു പ്രസ്ഥാനസമയേ ക്ക യാമീതി നാജാനാത്|</para>
  <para style="p">
    <verse number="9" style="v"/>വിശ്വാസേന സ പ്രതിജ്ഞാതേ ദേശേ പരദേശവത് പ്രവസൻ തസ്യാഃ പ്രതിജ്ഞായാഃ സമാനാംശിഭ്യാമ് ഇസ്ഹാകാ യാകൂബാ ച സഹ ദൂഷ്യവാസ്യഭവത്|</para>
  <para style="p">
    <verse number="10" style="v"/>യസ്മാത് സ ഈശ്വരേണ നിർമ്മിതം സ്ഥാപിതഞ്ച ഭിത്തിമൂലയുക്തം നഗരം പ്രത്യൈക്ഷത|</para>
  <para style="p">
    <verse number="11" style="v"/>അപരഞ്ച വിശ്വാസേന സാരാ വയോതിക്രാന്താ സന്ത്യപി ഗർഭധാരണായ ശക്തിം പ്രാപ്യ പുത്രവത്യഭവത്, യതഃ സാ പ്രതിജ്ഞാകാരിണം വിശ്വാസ്യമ് അമന്യത|</para>
  <para style="p">
    <verse number="12" style="v"/>തതോ ഹേതോ ർമൃതകൽപാദ് ഏകസ്മാത് ജനാദ് ആകാശീയനക്ഷത്രാണീവ ഗണനാതീതാഃ സമുദ്രതീരസ്ഥസികതാ ഇവ ചാസംഖ്യാ ലോകാ ഉത്പേദിരേ|</para>
  <para style="p">
    <verse number="13" style="v"/>ഏതേ സർവ്വേ പ്രതിജ്ഞായാഃ ഫലാന്യപ്രാപ്യ കേവലം ദൂരാത് താനി നിരീക്ഷ്യ വന്ദിത്വാ ച, പൃഥിവ്യാം വയം വിദേശിനഃ പ്രവാസിനശ്ചാസ്മഹ ഇതി സ്വീകൃത്യ വിശ്വാസേന പ്രാണാൻ തത്യജുഃ|</para>
  <para style="p">
    <verse number="14" style="v"/>യേ തു ജനാ ഇത്ഥം കഥയന്തി തൈഃ പൈതൃകദേശോ ഽസ്മാഭിരന്വിഷ്യത ഇതി പ്രകാശ്യതേ|</para>
  <para style="p">
    <verse number="15" style="v"/>തേ യസ്മാദ് ദേശാത് നിർഗതാസ്തം യദ്യസ്മരിഷ്യൻ തർഹി പരാവർത്തനായ സമയമ് അലപ്സ്യന്ത|</para>
  <para style="p">
    <verse number="16" style="v"/>കിന്തു തേ സർവ്വോത്കൃഷ്ടമ് അർഥതഃ സ്വർഗീയം ദേശമ് ആകാങ്ക്ഷന്തി തസ്മാദ് ഈശ്വരസ്താനധി ന ലജ്ജമാനസ്തേഷാമ് ഈശ്വര ഇതി നാമ ഗൃഹീതവാൻ യതഃ സ തേഷാം കൃതേ നഗരമേകം സംസ്ഥാപിതവാൻ|</para>
  <para style="p">
    <verse number="17" style="v"/>അപരമ് ഇബ്രാഹീമഃ പരീക്ഷായാം ജാതായാം സ വിശ്വാസേനേസ്ഹാകമ് ഉത്സസർജ,</para>
  <para style="p">
    <verse number="18" style="v"/>വസ്തുത ഇസ്ഹാകി തവ വംശോ വിഖ്യാസ്യത ഇതി വാഗ് യമധി കഥിതാ തമ് അദ്വിതീയം പുത്രം പ്രതിജ്ഞാപ്രാപ്തഃ സ ഉത്സസർജ|</para>
  <para style="p">
    <verse number="19" style="v"/>യത ഈശ്വരോ മൃതാനപ്യുത്ഥാപയിതും ശക്നോതീതി സ മേനേ തസ്മാത് സ ഉപമാരൂപം തം ലേഭേ|</para>
  <para style="p">
    <verse number="20" style="v"/>അപരമ് ഇസ്ഹാക് വിശ്വാസേന യാകൂബ് ഏഷാവേ ച ഭാവിവിഷയാനധ്യാശിഷം ദദൗ|</para>
  <para style="p">
    <verse number="21" style="v"/>അപരം യാകൂബ് മരണകാലേ വിശ്വാസേന യൂഷഫഃ പുത്രയോരേകൈകസ്മൈ ജനായാശിഷം ദദൗ യഷ്ട്യാ അഗ്രഭാഗേ സമാലമ്ബ്യ പ്രണനാമ ച|</para>
  <para style="p">
    <verse number="22" style="v"/>അപരം യൂഷഫ് ചരമകാലേ വിശ്വാസേനേസ്രായേല്വംശീയാനാം മിസരദേശാദ് ബഹിർഗമനസ്യ വാചം ജഗാദ നിജാസ്ഥീനി ചാധി സമാദിദേശ|</para>
  <para style="p">
    <verse number="23" style="v"/>നവജാതോ മൂസാശ്ച വിശ്വാസാത് ത്രാीൻ മാസാൻ സ്വപിതൃഭ്യാമ് അഗോപ്യത യതസ്തൗ സ്വശിശും പരമസുന്ദരം ദൃഷ്ടവന്തൗ രാജാജ്ഞാഞ്ച ന ശങ്കിതവന്തൗ|</para>
  <para style="p">
    <verse number="24" style="v"/>അപരം വയഃപ്രാപ്തോ മൂസാ വിശ്വാസാത് ഫിരൗണോ ദൗഹിത്ര ഇതി നാമ നാങ്ഗീചകാര|</para>
  <para style="p">
    <verse number="25" style="v"/>യതഃ സ ക്ഷണികാത് പാപജസുഖഭോഗാദ് ഈശ്വരസ്യ പ്രജാഭിഃ സാർദ്ധം ദുഃഖഭോഗം വവ്രേ|</para>
  <para style="p">
    <verse number="26" style="v"/>തഥാ മിസരദേശീയനിധിഭ്യഃ ഖ്രീഷ്ടനിമിത്താം നിന്ദാം മഹതീം സമ്പത്തിം മേനേ യതോ ഹേതോഃ സ പുരസ്കാരദാനമ് അപൈക്ഷത|</para>
  <para style="p">
    <verse number="27" style="v"/>അപരം സ വിശ്വാസേന രാജ്ഞഃ ക്രോധാത് ന ഭീത്വാ മിസരദേശം പരിതത്യാജ, യതസ്തേനാദൃശ്യം വീക്ഷമാണേനേവ ധൈര്യ്യമ് ആലമ്ബി|</para>
  <para style="p">
    <verse number="28" style="v"/>അപരം പ്രഥമജാതാനാം ഹന്താ യത് സ്വീയലോകാൻ ന സ്പൃശേത് തദർഥം സ വിശ്വാസേന നിസ്താരപർവ്വീയബലിച്ഛേദനം രുധിരസേചനഞ്ചാനുഷ്ഠിതാവാൻ|</para>
  <para style="p">
    <verse number="29" style="v"/>അപരം തേ വിശ്വാസാത് സ്ഥലേനേവ സൂഫ്സാഗരേണ ജഗ്മുഃ കിന്തു മിസ്രീയലോകാസ്തത് കർത്തുമ് ഉപക്രമ്യ തോയേഷു മമജ്ജുഃ|</para>
  <para style="p">
    <verse number="30" style="v"/>അപരഞ്ച വിശ്വാസാത് തൈഃ സപ്താഹം യാവദ് യിരീഹോഃ പ്രാചീരസ്യ പ്രദക്ഷിണേ കൃതേ തത് നിപപാത|</para>
  <para style="p">
    <verse number="31" style="v"/>വിശ്വാസാദ് രാഹബ്നാമികാ വേശ്യാപി പ്രീത്യാ ചാരാൻ അനുഗൃഹ്യാവിശ്വാസിഭിഃ സാർദ്ധം ന വിനനാശ|</para>
  <para style="p">
    <verse number="32" style="v"/>അധികം കിം കഥയിഷ്യാമി? ഗിദിയോനോ ബാരകഃ ശിമ്ശോനോ യിപ്തഹോ ദായൂദ് ശിമൂയേലോ ഭവിഷ്യദ്വാദിനശ്ചൈതേഷാം വൃത്താന്തകഥനായ മമ സമയാഭാവോ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="33" style="v"/>വിശ്വാസാത് തേ രാജ്യാനി വശീകൃതവന്തോ ധർമ്മകർമ്മാണി സാധിതവന്തഃ പ്രതിജ്ഞാനാം ഫലം ലബ്ധവന്തഃ സിംഹാനാം മുഖാനി രുദ്ധവന്തോ</para>
  <para style="p">
    <verse number="34" style="v"/>വഹ്നേർദാഹം നിർവ്വാപിതവന്തഃ ഖങ്ഗധാരാദ് രക്ഷാം പ്രാപ്തവന്തോ ദൗർബ്ബല്യേ സബലീകൃതാ യുദ്ധേ പരാക്രമിണോ ജാതാഃ പരേഷാം സൈന്യാനി ദവയിതവന്തശ്ച|</para>
  <para style="p">
    <verse number="35" style="v"/>യോഷിതഃ പുനരുത്ഥാനേന മൃതാൻ ആത്മജാൻ ലേഭിരേे, അപരേ ച ശ്രേഷ്ഠോത്ഥാനസ്യ പ്രാപ്തേരാശയാ രക്ഷാമ് അഗൃഹീത്വാ താഡനേന മൃതവന്തഃ|</para>
  <para style="p">
    <verse number="36" style="v"/>അപരേ തിരസ്കാരൈഃ കശാഭി ർബന്ധനൈഃ കാരയാ ച പരീക്ഷിതാഃ|</para>
  <para style="p">
    <verse number="37" style="v"/>ബഹവശ്ച പ്രസ്തരാഘാതൈ ർഹതാഃ കരപത്രൈ ർവാ വിദീർണാ യന്ത്രൈ ർവാ ക്ലിഷ്ടാഃ ഖങ്ഗധാരൈ ർവാ വ്യാപാദിതാഃ| തേ മേഷാണാം ഛാഗാനാം വാ ചർമ്മാണി പരിധായ ദീനാഃ പീഡിതാ ദുഃഖാർത്താശ്ചാഭ്രാമ്യൻ|</para>
  <para style="p">
    <verse number="38" style="v"/>സംസാരോ യേഷാമ് അയോഗ്യസ്തേ നിർജനസ്ഥാനേഷു പർവ്വതേഷു ഗഹ്വരേഷു പൃഥിവ്യാശ്ഛിദ്രേഷു ച പര്യ്യടൻ|</para>
  <para style="p">
    <verse number="39" style="v"/>ഏതൈഃ സർവ്വൈ ർവിശ്വാസാത് പ്രമാണം പ്രാപി കിന്തു പ്രതിജ്ഞായാഃ ഫലം ന പ്രാപി|</para>
  <para style="p">
    <verse number="40" style="v"/>യതസ്തേ യഥാസ്മാൻ വിനാ സിദ്ധാ ന ഭവേയുസ്തഥൈവേശ്വരേണാസ്മാകം കൃതേ ശ്രേഷ്ഠതരം കിമപി നിർദിദിശേ|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അതോ ഹേതോരേതാവത്സാക്ഷിമേഘൈ ർവേഷ്ടിതാഃ സന്തോ വയമപി സർവ്വഭാരമ് ആശുബാധകം പാപഞ്ച നിക്ഷിപ്യാസ്മാകം ഗമനായ നിരൂപിതേ മാർഗേ ധൈര്യ്യേണ ധാവാമ|</para>
  <para style="p">
    <verse number="2" style="v"/>യശ്ചാസ്മാകം വിശ്വാസസ്യാഗ്രേസരഃ സിദ്ധികർത്താ ചാസ്തി തം യീശും വീക്ഷാമഹൈ യതഃ സ സ്വസമ്മുഖസ്ഥിതാനന്ദസ്യ പ്രാപ്ത്യർഥമ് അപമാനം തുച്ഛീകൃത്യ ക്രുശസ്യ യാതനാം സോഢവാൻ ഈശ്വരീയസിംഹാസനസ്യ ദക്ഷിണപാർശ്വേ സമുപവിഷ്ടവാംശ്ച|</para>
  <para style="p">
    <verse number="3" style="v"/>യഃ പാപിഭിഃ സ്വവിരുദ്ധമ് ഏതാദൃശം വൈപരീത്യം സോഢവാൻ തമ് ആലോചയത തേന യൂയം സ്വമനഃസു ശ്രാന്താഃ ക്ലാന്താശ്ച ന ഭവിഷ്യഥ|</para>
  <para style="p">
    <verse number="4" style="v"/>യൂയം പാപേന സഹ യുധ്യന്തോഽദ്യാപി ശോണിതവ്യയപര്യ്യന്തം പ്രതിരോധം നാകുരുത|</para>
  <para style="p">
    <verse number="5" style="v"/>തഥാ ച പുത്രാൻ പ്രതീവ യുഷ്മാൻ പ്രതി യ ഉപദേശ ഉക്തസ്തം കിം വിസ്മൃതവന്തഃ? "പരേശേന കൃതാം ശാസ്തിം ഹേ മത്പുത്ര ന തുച്ഛയ| തേന സംഭർത്സിതശ്ചാപി നൈവ ക്ലാമ്യ കദാചന|</para>
  <para style="p">
    <verse number="6" style="v"/>പരേശഃ പ്രീയതേ യസ്മിൻ തസ്മൈ ശാസ്തിം ദദാതി യത്| യന്തു പുത്രം സ ഗൃഹ്ലാതി തമേവ പ്രഹരത്യപി| "</para>
  <para style="p">
    <verse number="7" style="v"/>യദി യൂയം ശാസ്തിം സഹധ്വം തർഹീശ്വരഃ പുത്രൈരിവ യുഷ്മാഭിഃ സാർദ്ധം വ്യവഹരതി യതഃ പിതാ യസ്മൈ ശാസ്തിം ന ദദാതി താദൃശഃ പുത്രഃ കഃ?</para>
  <para style="p">
    <verse number="8" style="v"/>സർവ്വേ യസ്യാഃ ശാസ്തേരംശിനോ ഭവന്തി സാ യദി യുഷ്മാകം ന ഭവതി തർഹി യൂയമ് ആത്മജാ ന കിന്തു ജാരജാ ആധ്വേ|</para>
  <para style="p">
    <verse number="9" style="v"/>അപരമ് അസ്മാകം ശാരീരികജന്മദാതാരോഽസ്മാകം ശാസ്തികാരിണോഽഭവൻ തേ ചാസ്മാഭിഃ സമ്മാനിതാസ്തസ്മാദ് യ ആത്മനാം ജനയിതാ വയം കിം തതോഽധികം തസ്യ വശീഭൂയ ന ജീവിഷ്യാമഃ?</para>
  <para style="p">
    <verse number="10" style="v"/>തേ ത്വൽപദിനാനി യാവത് സ്വമനോഽമതാനുസാരേണ ശാസ്തിം കൃതവന്തഃ കിന്ത്വേഷോഽസ്മാകം ഹിതായ തസ്യ പവിത്രതായാ അംശിത്വായ ചാസ്മാൻ ശാസ്തി|</para>
  <para style="p">
    <verse number="11" style="v"/>ശാസ്തിശ്ച വർത്തമാനസമയേ കേനാപി നാനന്ദജനികാ കിന്തു ശോകജനികൈവ മന്യതേ തഥാപി യേ തയാ വിനീയന്തേ തേഭ്യഃ സാ പശ്ചാത് ശാന്തിയുക്തം ധർമ്മഫലം ദദാതി|</para>
  <para style="p">
    <verse number="12" style="v"/>അതഏവ യൂയം ശിഥിലാൻ ഹസ്താൻ ദുർബ്ബലാനി ജാനൂനി ച സബലാനി കുരുധ്വം|</para>
  <para style="p">
    <verse number="13" style="v"/>യഥാ ച ദുർബ്ബലസ്യ സന്ധിസ്ഥാനം ന ഭജ്യേത സ്വസ്ഥം തിഷ്ഠേത് തഥാ സ്വചരണാർഥം സരലം മാർഗം നിർമ്മാത|</para>
  <para style="p">
    <verse number="14" style="v"/>അപരഞ്ച സർവ്വൈഃ സാർഥമ് ഏेക്യഭാവം യച്ച വിനാ പരമേശ്വരസ്യ ദർശനം കേനാപി ന ലപ്സ്യതേ തത് പവിത്രത്വം ചേഷ്ടധ്വം|</para>
  <para style="p">
    <verse number="15" style="v"/>യഥാ കശ്ചിദ് ഈശ്വരസ്യാനുഗ്രഹാത് ന പതേത്, യഥാ ച തിക്തതായാ മൂലം പ്രരുഹ്യ ബാധാജനകം ന ഭവേത് തേന ച ബഹവോഽപവിത്രാ ന ഭവേയുഃ,</para>
  <para style="p">
    <verse number="16" style="v"/>യഥാ ച കശ്ചിത് ലമ്പടോ വാ ഏകകൃത്വ ആഹാരാർഥം സ്വീയജ്യേഷ്ഠാധികാരവിക്രേതാ യ ഏഷൗസ്തദ്വദ് അധർമ്മാചാരീ ന ഭവേത് തഥാ സാവധാനാ ഭവത|</para>
  <para style="p">
    <verse number="17" style="v"/>യതഃ സ ഏഷൗഃ പശ്ചാദ് ആശീർവ്വാദാധികാരീ ഭവിതുമ് ഇച്ഛന്നപി നാനുഗൃഹീത ഇതി യൂയം ജാനീഥ, സ ചാശ്രുപാതേന മത്യന്തരം പ്രാർഥയമാനോഽപി തദുപായം ന ലേഭേ|</para>
  <para style="p">
    <verse number="18" style="v"/>അപരഞ്ച സ്പൃശ്യഃ പർവ്വതഃ പ്രജ്വലിതോ വഹ്നിഃ കൃഷ്ണാവർണോ മേഘോ ഽന്ധകാരോ ഝഞ്ഭ്ശ തൂരീവാദ്യം വാക്യാനാം ശബ്ദശ്ച നൈതേഷാം സന്നിധൗ യൂയമ് ആഗതാഃ|</para>
  <para style="p">
    <verse number="19" style="v"/>തം ശബ്ദം ശ്രുത്വാ ശ്രോതാരസ്താദൃശം സമ്ഭാഷണം യത് പുന ർന ജായതേ തത് പ്രാർഥിതവന്തഃ|</para>
  <para style="p">
    <verse number="20" style="v"/>യതഃ പശുരപി യദി ധരാധരം സ്പൃശതി തർഹി സ പാഷാണാഘാതൈ ർഹന്തവ്യ ഇത്യാദേശം സോഢും തേ നാശക്നുവൻ|</para>
  <para style="p">
    <verse number="21" style="v"/>തച്ച ദർശനമ് ഏവം ഭയാനകം യത് മൂസസോക്തം ഭീതസ്ത്രാസയുക്തശ്ചാസ്മീതി|</para>
  <para style="p">
    <verse number="22" style="v"/>കിന്തു സീയോൻപർവ്വതോ ഽമരേശ്വരസ്യ നഗരം സ്വർഗസ്ഥയിരൂശാലമമ് അയുതാനി ദിവ്യദൂതാഃ</para>
  <para style="p">
    <verse number="23" style="v"/>സ്വർഗേ ലിഖിതാനാം പ്രഥമജാതാനാമ് ഉത്സവഃ സമിതിശ്ച സർവ്വേഷാം വിചാരാധിപതിരീശ്വരഃ സിദ്ധീകൃതധാർമ്മികാനാമ് ആത്മാനോ</para>
  <para style="p">
    <verse number="24" style="v"/>നൂതനനിയമസ്യ മധ്യസ്ഥോ യീശുഃ, അപരം ഹാബിലോ രക്താത് ശ്രേയഃ പ്രചാരകം പ്രോക്ഷണസ്യ രക്തഞ്ചൈതേഷാം സന്നിധൗ യൂയമ് ആഗതാഃ|</para>
  <para style="p">
    <verse number="25" style="v"/>സാവധാനാ ഭവത തം വക്താരം നാവജാനീത യതോ ഹേതോഃ പൃഥിവീസ്ഥിതഃ സ വക്താ യൈരവജ്ഞാതസ്തൈ ര്യദി രക്ഷാ നാപ്രാപി തർഹി സ്വർഗീയവക്തുഃ പരാങ്മുഖീഭൂയാസ്മാഭിഃ കഥം രക്ഷാ പ്രാപ്സ്യതേ?</para>
  <para style="p">
    <verse number="26" style="v"/>തദാ തസ്യ രവാത് പൃഥിവീ കമ്പിതാ കിന്ത്വിദാനീം തേനേദം പ്രതിജ്ഞാതം യഥാ, "അഹം പുനരേകകൃത്വഃ പൃഥിവീം കമ്പയിഷ്യാമി കേവലം തന്നഹി ഗഗനമപി കമ്പയിഷ്യാമി| "</para>
  <para style="p">
    <verse number="27" style="v"/>സ ഏകകൃത്വഃ ശബ്ദോ നിശ്ചലവിഷയാണാം സ്ഥിതയേ നിർമ്മിതാനാമിവ ചഞ്ചലവസ്തൂനാം സ്ഥാനാന്തരീകരണം പ്രകാശയതി|</para>
  <para style="p">
    <verse number="28" style="v"/>അതഏവ നിശ്ചലരാജ്യപ്രാപ്തൈരസ്മാഭിഃ സോഽനുഗ്രഹ ആലമ്ബിതവ്യോ യേന വയം സാദരം സഭയഞ്ച തുഷ്ടിജനകരൂപേണേശ്വരം സേവിതും ശക്നുയാമ|</para>
  <para style="p">
    <verse number="29" style="v"/>യതോഽസ്മാകമ് ഈശ്വരഃ സംഹാരകോ വഹ്നിഃ|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഭ്രാതൃഷു പ്രേമ തിഷ്ഠതു| അതിഥിസേവാ യുഷ്മാഭി ർന വിസ്മര്യ്യതാം</para>
  <para style="p">
    <verse number="2" style="v"/>യതസ്തയാ പ്രച്ഛന്നരൂപേണ ദിവ്യദൂതാഃ കേഷാഞ്ചിദ് അതിഥയോഽഭവൻ|</para>
  <para style="p">
    <verse number="3" style="v"/>ബന്ദിനഃ സഹബന്ദിഭിരിവ ദുഃഖിനശ്ച ദേഹവാസിഭിരിവ യുഷ്മാഭിഃ സ്മര്യ്യന്താം|</para>
  <para style="p">
    <verse number="4" style="v"/>വിവാഹഃ സർവ്വേഷാം സമീപേ സമ്മാനിതവ്യസ്തദീയശയ്യാ ച ശുചിഃ കിന്തു വേശ്യാഗാമിനഃ പാരദാരികാശ്ചേശ്വരേണ ദണ്ഡയിഷ്യന്തേ|</para>
  <para style="p">
    <verse number="5" style="v"/>യൂയമ് ആചാരേ നിർലോഭാ ഭവത വിദ്യമാനവിഷയേ സന്തുഷ്യത ച യസ്മാദ് ഈശ്വര ഏവേദം കഥിതവാൻ, യഥാ, "ത്വാം ന ത്യക്ഷ്യാമി ന ത്വാം ഹാസ്യാമി| "</para>
  <para style="p">
    <verse number="6" style="v"/>അതഏവ വയമ് ഉത്സാഹേനേദം കഥയിതും ശക്നുമഃ, "മത്പക്ഷേ പരമേശോഽസ്തി ന ഭേഷ്യാമി കദാചന| യസ്മാത് മാം പ്രതി കിം കർത്തും മാനവഃ പാരയിഷ്യതി|| "</para>
  <para style="p">
    <verse number="7" style="v"/>യുഷ്മാകം യേ നായകാ യുഷ്മഭ്യമ് ഈശ്വരസ്യ വാക്യം കഥിതവന്തസ്തേ യുഷ്മാഭിഃ സ്മര്യ്യന്താം തേഷാമ് ആചാരസ്യ പരിണാമമ് ആലോച്യ യുഷ്മാഭിസ്തേഷാം വിശ്വാസോഽനുക്രിയതാം|</para>
  <para style="p">
    <verse number="8" style="v"/>യീശുഃ ഖ്രീഷ്ടഃ ശ്വോഽദ്യ സദാ ച സ ഏവാസ്തേ|</para>
  <para style="p">
    <verse number="9" style="v"/>യൂയം നാനാവിധനൂതനശിക്ഷാഭി ർന പരിവർത്തധ്വം യതോഽനുഗ്രഹേണാന്തഃകരണസ്യ സുസ്ഥിരീഭവനം ക്ഷേമം ന ച ഖാദ്യദ്രവ്യൈഃ| യതസ്തദാചാരിണസ്തൈ ർനോപകൃതാഃ|</para>
  <para style="p">
    <verse number="10" style="v"/>യേ ദഷ്യസ്യ സേവാം കുർവ്വന്തി തേ യസ്യാ ദ്രവ്യഭോജനസ്യാനധികാരിണസ്താദൃശീ യജ്ഞവേദിരസ്മാകമ് ആസ്തേ|</para>
  <para style="p">
    <verse number="11" style="v"/>യതോ യേഷാം പശൂനാം ശോണിതം പാപനാശായ മഹായാജകേന മഹാപവിത്രസ്ഥാനസ്യാഭ്യന്തരം നീയതേ തേഷാം ശരീരാണി ശിബിരാദ് ബഹി ർദഹ്യന്തേ|</para>
  <para style="p">
    <verse number="12" style="v"/>തസ്മാദ് യീശുരപി യത് സ്വരുധിരേണ പ്രജാഃ പവിത്രീകുര്യ്യാത് തദർഥം നഗരദ്വാരസ്യ ബഹി ർമൃതിം ഭുക്തവാൻ|</para>
  <para style="p">
    <verse number="13" style="v"/>അതോ ഹേതോരസ്മാഭിരപി തസ്യാപമാനം സഹമാനൈഃ ശിബിരാദ് ബഹിസ്തസ്യ സമീപം ഗന്തവ്യം|</para>
  <para style="p">
    <verse number="14" style="v"/>യതോ ഽത്രാസ്മാകം സ്ഥായി നഗരം ന വിദ്യതേ കിന്തു ഭാവി നഗരമ് അസ്മാഭിരന്വിഷ്യതേ|</para>
  <para style="p">
    <verse number="15" style="v"/>അതഏവ യീശുനാസ്മാഭി ർനിത്യം പ്രശംസാരൂപോ ബലിരർഥതസ്തസ്യ നാമാങ്ഗീകുർവ്വതാമ് ഓഷ്ഠാധരാണാം ഫലമ് ഈശ്വരായ ദാതവ്യം|</para>
  <para style="p">
    <verse number="16" style="v"/>അപരഞ്ച പരോപകാരോ ദാനഞ്ച യുഷ്മാഭി ർന വിസ്മര്യ്യതാം യതസ്താദൃശം ബലിദാനമ് ഈശ്വരായ രോചതേ|</para>
  <para style="p">
    <verse number="17" style="v"/>യൂയം സ്വനായകാനാമ് ആജ്ഞാഗ്രാഹിണോ വശ്യാശ്ച ഭവത യതോ യൈരുപനിധിഃ പ്രതിദാതവ്യസ്താദൃശാ ലോകാ ഇവ തേ യുഷ്മദീയാത്മനാം രക്ഷണാർഥം ജാഗ്രതി, അതസ്തേ യഥാ സാനന്ദാസ്തത് കുര്യ്യു ർന ച സാർത്തസ്വരാ അത്ര യതധ്വം യതസ്തേഷാമ് ആർത്തസ്വരോ യുഷ്മാകമ് ഇഷ്ടജനകോ ന ഭവേത്|</para>
  <para style="p">
    <verse number="18" style="v"/>അപരഞ്ച യൂയമ് അസ്മന്നിമിത്തിം പ്രാർഥനാം കുരുത യതോ വയമ് ഉത്തമമനോവിശിഷ്ടാഃ സർവ്വത്ര സദാചാരം കർത്തുമ് ഇച്ഛുകാശ്ച ഭവാമ ഇതി നിശ്ചിതം ജാനീമഃ|</para>
  <para style="p">
    <verse number="19" style="v"/>വിശേഷതോഽഹം യഥാ ത്വരയാ യുഷ്മഭ്യം പുന ർദീയേ തദർഥം പ്രാർഥനായൈ യുഷ്മാൻ അധികം വിനയേ|</para>
  <para style="p">
    <verse number="20" style="v"/>അനന്തനിയമസ്യ രുധിരേണ വിശിഷ്ടോ മഹാൻ മേഷപാലകോ യേന മൃതഗണമധ്യാത് പുനരാനായി സ ശാന്തിദായക ഈശ്വരോ</para>
  <para style="p">
    <verse number="21" style="v"/>നിജാഭിമതസാധനായ സർവ്വസ്മിൻ സത്കർമ്മണി യുഷ്മാൻ സിദ്ധാൻ കരോതു, തസ്യ ദൃഷ്ടൗ ച യദ്യത് തുഷ്ടിജനകം തദേവ യുഷ്മാകം മധ്യേ യീശുനാ ഖ്രീഷ്ടേന സാധയതു| തസ്മൈ മഹിമാ സർവ്വദാ ഭൂയാത്| ആമേൻ|</para>
  <para style="p">
    <verse number="22" style="v"/>ഹേ ഭ്രാതരഃ, വിനയേഽഹം യൂയമ് ഇദമ് ഉപദേശവാക്യം സഹധ്വം യതോഽഹം സംക്ഷേപേണ യുഷ്മാൻ പ്രതി ലിഖിതവാൻ|</para>
  <para style="p">
    <verse number="23" style="v"/>അസ്മാകം ഭ്രാതാ തീമഥിയോ മുക്തോഽഭവദ് ഇതി ജാനീത, സ ച യദി ത്വരയാ സമാഗച്ഛതി തർഹി തേന സാർദ്ധംമ് അഹം യുഷ്മാൻ സാക്ഷാത് കരിഷ്യാമി|</para>
  <para style="p">
    <verse number="24" style="v"/>യുഷ്മാകം സർവ്വാൻ നായകാൻ പവിത്രലോകാംശ്ച നമസ്കുരുത| അപരമ് ഇതാലിയാദേശീയാനാം നമസ്കാരം ജ്ഞാസ്യഥ|</para>
  <para style="p">
    <verse number="25" style="v"/>അനുഗ്രഹോ യുഷ്മാകം സർവ്വേഷാം സഹായോ ഭൂയാത്| ആമേൻ|</para>
</usx>
