<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1JN" style="id">Sanskrit Bible (NT) in Malayalam Script (സത്യവേദഃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 John</para>
  <para style="toc1">1 യോഹനഃ പത്രം</para>
  <para style="toc2">1 യോഹനഃ</para>
  <para style="toc3">1 യോഹനഃ</para>
  <para style="mt1">1 യോഹനഃ പത്രം</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ആദിതോ യ ആസീദ് യസ്യ വാഗ് അസ്മാഭിരശ്രാവി യഞ്ച വയം സ്വനേത്രൈ ർദൃഷ്ടവന്തോ യഞ്ച വീക്ഷിതവന്തഃ സ്വകരൈഃ സ്പൃഷ്ടവന്തശ്ച തം ജീവനവാദം വയം ജ്ഞാപയാമഃ|</para>
  <para style="p">
    <verse number="2" style="v"/>സ ജീവനസ്വരൂപഃ പ്രകാശത വയഞ്ച തം ദൃഷ്ടവന്തസ്തമധി സാക്ഷ്യം ദദ്മശ്ച, യശ്ച പിതുഃ സന്നിധാവവർത്തതാസ്മാകം സമീപേ പ്രകാശത ച തമ് അനന്തജീവനസ്വരൂപം വയം യുഷ്മാൻ ജ്ഞാപയാമഃ|</para>
  <para style="p">
    <verse number="3" style="v"/>അസ്മാഭി ര്യദ് ദൃഷ്ടം ശ്രുതഞ്ച തദേവ യുഷ്മാൻ ജ്ഞാപ്യതേ തേനാസ്മാഭിഃ സഹാംശിത്വം യുഷ്മാകം ഭവിഷ്യതി| അസ്മാകഞ്ച സഹാംശിത്വം പിത്രാ തത്പുത്രേണ യീശുഖ്രീഷ്ടേന ച സാർദ്ധം ഭവതി|</para>
  <para style="p">
    <verse number="4" style="v"/>അപരഞ്ച യുഷ്മാകമ് ആനന്ദോ യത് സമ്പൂർണോ ഭവേദ് തദർഥം വയമ് ഏതാനി ലിഖാമഃ|</para>
  <para style="p">
    <verse number="5" style="v"/>വയം യാം വാർത്താം തസ്മാത് ശ്രുത്വാ യുഷ്മാൻ ജ്ഞാപയാമഃ സേയമ്| ഈശ്വരോ ജ്യോതിസ്തസ്മിൻ അന്ധകാരസ്യ ലേശോഽപി നാസ്തി|</para>
  <para style="p">
    <verse number="6" style="v"/>വയം തേന സഹാംശിന ഇതി ഗദിത്വാ യദ്യന്ധാകാരേ ചരാമസ്തർഹി സത്യാചാരിണോ ന സന്തോ ഽനൃതവാദിനോ ഭവാമഃ|</para>
  <para style="p">
    <verse number="7" style="v"/>കിന്തു സ യഥാ ജ്യോതിഷി വർത്തതേ തഥാ വയമപി യദി ജ്യോതിഷി ചരാമസ്തർഹി പരസ്പരം സഹഭാഗിനോ ഭവാമസ്തസ്യ പുത്രസ്യ യീശുഖ്രീഷ്ടസ്യ രുധിരഞ്ചാസ്മാൻ സർവ്വസ്മാത് പാപാത് ശുദ്ധയതി|</para>
  <para style="p">
    <verse number="8" style="v"/>വയം നിഷ്പാപാ ഇതി യദി വദാമസ്തർഹി സ്വയമേവ സ്വാൻ വഞ്ചയാമഃ സത്യമതഞ്ചാസ്മാകമ് അന്തരേ ന വിദ്യതേ|</para>
  <para style="p">
    <verse number="9" style="v"/>യദി സ്വപാപാനി സ്വീകുർമ്മഹേ തർഹി സ വിശ്വാസ്യോ യാഥാർഥികശ്ചാസ്തി തസ്മാദ് അസ്മാകം പാപാനി ക്ഷമിഷ്യതേ സർവ്വസ്മാദ് അധർമ്മാച്ചാസ്മാൻ ശുദ്ധയിഷ്യതി|</para>
  <para style="p">
    <verse number="10" style="v"/>വയമ് അകൃതപാപാ ഇതി യദി വദാമസ്തർഹി തമ് അനൃതവാദിനം കുർമ്മസ്തസ്യ വാക്യഞ്ചാസ്മാകമ് അന്തരേ ന വിദ്യതേ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഹേ പ്രിയബാലകാഃ, യുഷ്മാഭി ര്യത് പാപം ന ക്രിയേത തദർഥം യുഷ്മാൻ പ്രത്യേതാനി മയാ ലിഖ്യന്തേ| യദി തു കേനാപി പാപം ക്രിയതേ തർഹി പിതുഃ സമീപേ ഽസ്മാകം ഏകഃ സഹായോ ഽർഥതോ ധാർമ്മികോ യീശുഃ ഖ്രീഷ്ടോ വിദ്യതേ|</para>
  <para style="p">
    <verse number="2" style="v"/>സ ചാസ്മാകം പാപാനാം പ്രായശ്ചിത്തം കേവലമസ്മാകം നഹി കിന്തു ലിഖിലസംസാരസ്യ പാപാനാം പ്രായശ്ചിത്തം|</para>
  <para style="p">
    <verse number="3" style="v"/>വയം തം ജാനീമ ഇതി തദീയാജ്ഞാപാലനേനാവഗച്ഛാമഃ|</para>
  <para style="p">
    <verse number="4" style="v"/>അഹം തം ജാനാമീതി വദിത്വാ യസ്തസ്യാജ്ഞാ ന പാലയതി സോ ഽനൃതവാദീ സത്യമതഞ്ച തസ്യാന്തരേ ന വിദ്യതേ|</para>
  <para style="p">
    <verse number="5" style="v"/>യഃ കശ്ചിത് തസ്യ വാക്യം പാലയതി തസ്മിൻ ഈശ്വരസ്യ പ്രേമ സത്യരൂപേണ സിധ്യതി വയം തസ്മിൻ വർത്താമഹേ തദ് ഏതേനാവഗച്ഛാമഃ|</para>
  <para style="p">
    <verse number="6" style="v"/>അഹം തസ്മിൻ തിഷ്ഠാമീതി യോ ഗദതി തസ്യേദമ് ഉചിതം യത് ഖ്രീഷ്ടോ യാദൃഗ് ആചരിതവാൻ സോ ഽപി താദൃഗ് ആചരേത്|</para>
  <para style="p">
    <verse number="7" style="v"/>ഹേ പ്രിയതമാഃ, യുഷ്മാൻ പ്രത്യഹം നൂതനാമാജ്ഞാം ലിഖാമീതി നഹി കിന്ത്വാദിതോ യുഷ്മാഭി ർലബ്ധാം പുരാതനാമാജ്ഞാം ലിഖാമി| ആദിതോ യുഷ്മാഭി ര്യദ് വാക്യം ശ്രുതം സാ പുരാതനാജ്ഞാ|</para>
  <para style="p">
    <verse number="8" style="v"/>പുനരപി യുഷ്മാൻ പ്രതി നൂതനാജ്ഞാ മയാ ലിഖ്യത ഏതദപി തസ്മിൻ യുഷ്മാസു ച സത്യം, യതോ ഽന്ധകാരോ വ്യത്യേതി സത്യാ ജ്യോതിശ്ചേദാനീം പ്രകാശതേ;</para>
  <para style="p">
    <verse number="9" style="v"/>അഹം ജ്യോതിഷി വർത്ത ഇതി ഗദിത്വാ യഃ സ്വഭ്രാതരം ദ്വേഷ്ടി സോ ഽദ്യാപി തമിസ്രേ വർത്തതേ|</para>
  <para style="p">
    <verse number="10" style="v"/>സ്വഭ്രാതരി യഃ പ്രീയതേ സ ഏവ ജ്യോതിഷി വർത്തതേ വിഘ്നജനകം കിമപി തസ്മിൻ ന വിദ്യതേ|</para>
  <para style="p">
    <verse number="11" style="v"/>കിന്തു സ്വഭ്രാതരം യോ ദ്വേഷ്ടി സ തിമിരേ വർത്തതേ തിമിരേ ചരതി ച തിമിരേണ ച തസ്യ നയനേ ഽന്ധീക്രിയേതേ തസ്മാത് ക്ക യാമീതി സ ജ്ഞാതും ന ശക്നോതി|</para>
  <para style="p">
    <verse number="12" style="v"/>ഹേ ശിശവഃ, യൂയം തസ്യ നാമ്നാ പാപക്ഷമാം പ്രാപ്തവന്തസ്തസ്മാദ് അഹം യുഷ്മാൻ പ്രതി ലിഖാമി|</para>
  <para style="p">
    <verse number="13" style="v"/>ഹേ പിതരഃ, യ ആദിതോ വർത്തമാനസ്തം യൂയം ജാനീഥ തസ്മാദ് യുഷ്മാൻ പ്രതി ലിഖാമി| ഹേ യുവാനഃ യൂയം പാപത്മാനം ജിതവന്തസ്തസ്മാദ് യുഷ്മാൻ പ്രതി ലിഖാമി| ഹേ ബാലകാഃ, യൂയം പിതരം ജാനീഥ തസ്മാദഹം യുഷ്മാൻ പ്രതി ലിഖിതവാൻ|</para>
  <para style="p">
    <verse number="14" style="v"/>ഹേ പിതരഃ, ആദിതോ യോ വർത്തമാനസ്തം യൂയം ജാനീഥ തസ്മാദ് യുഷ്മാൻ പ്രതി ലിഖിതവാൻ| ഹേ യുവാനഃ, യൂയം ബലവന്ത ആധ്വേ, ഈശ്വരസ്യ വാക്യഞ്ച യുഷ്മദന്തരേ വർതതേ പാപാത്മാ ച യുഷ്മാഭിഃ പരാജിഗ്യേ തസ്മാദ് യുഷ്മാൻ പ്രതി ലിഖിതവാൻ|</para>
  <para style="p">
    <verse number="15" style="v"/>യൂയം സംസാരേ സംസാരസ്ഥവിഷയേഷു ച മാ പ്രീയധ്വം യഃ സംസാരേ പ്രീയതേ തസ്യാന്തരേ പിതുഃ പ്രേമ ന തിഷ്ഠതി|</para>
  <para style="p">
    <verse number="16" style="v"/>യതഃ സംസാരേ യദ്യത് സ്ഥിതമ് അർഥതഃ ശാരീരികഭാവസ്യാഭിലാഷോ ദർശനേന്ദ്രിയസ്യാഭിലാഷോ ജീവനസ്യ ഗർവ്വശ്ച സർവ്വമേതത് പിതൃതോ ന ജായതേ കിന്തു സംസാരദേവ|</para>
  <para style="p">
    <verse number="17" style="v"/>സംസാരസ്തദീയാഭിലാഷശ്ച വ്യത്യേതി കിന്തു യ ഈശ്വരസ്യേഷ്ടം കരോതി സോ ഽനന്തകാലം യാവത് തിഷ്ഠതി|</para>
  <para style="p">
    <verse number="18" style="v"/>ഹേ ബാലകാഃ, ശേഷകാലോഽയം, അപരം ഖ്രീഷ്ടാരിണോപസ്ഥാവ്യമിതി യുഷ്മാഭി ര്യഥാ ശ്രുതം തഥാ ബഹവഃ ഖ്രീഷ്ടാരയ ഉപസ്ഥിതാസ്തസ്മാദയം ശേഷകാലോഽസ്തീതി വയം ജാനീമഃ|</para>
  <para style="p">
    <verse number="19" style="v"/>തേ ഽസ്മന്മധ്യാൻ നിർഗതവന്തഃ കിന്ത്വസ്മദീയാ നാസൻ യദ്യസ്മദീയാ അഭവിഷ്യൻ തർഹ്യസ്മത്സങ്ഗേ ഽസ്ഥാസ്യൻ, കിന്തു സർവ്വേ ഽസ്മദീയാ ന സന്ത്യേതസ്യ പ്രകാശ ആവശ്യക ആസീത്|</para>
  <para style="p">
    <verse number="20" style="v"/>യഃ പവിത്രസ്തസ്മാദ് യൂയമ് അഭിഷേകം പ്രാപ്തവന്തസ്തേന സർവ്വാണി ജാനീഥ|</para>
  <para style="p">
    <verse number="21" style="v"/>യൂയം സത്യമതം ന ജാനീഥ തത്കാരണാദ് അഹം യുഷ്മാൻ പ്രതി ലിഖിതവാൻ തന്നഹി കിന്തു യൂയം തത് ജാനീഥ സത്യമതാച്ച കിമപ്യനൃതവാക്യം നോത്പദ്യതേ തത്കാരണാദേവ|</para>
  <para style="p">
    <verse number="22" style="v"/>യീശുരഭിഷിക്തസ്ത്രാതേതി യോ നാങ്ഗീകരോതി തം വിനാ കോ ഽപരോ ഽനൃതവാദീ ഭവേത്? സ ഏവ ഖ്രീഷ്ടാരി ര്യഃ പിതരം പുത്രഞ്ച നാങ്ഗീകരോതി|</para>
  <para style="p">
    <verse number="23" style="v"/>യഃ കശ്ചിത് പുത്രം നാങ്ഗീകരോതി സ പിതരമപി ന ധാരയതി യശ്ച പുത്രമങ്ഗീകരോതി സ പിതരമപി ധാരയതി|</para>
  <para style="p">
    <verse number="24" style="v"/>ആദിതോ യുഷ്മാഭി ര്യത് ശ്രുതം തദ് യുഷ്മാസു തിഷ്ഠതു, ആദിതഃ ശ്രുതം വാക്യം യദി യുഷ്മാസു തിഷ്ഠതി, തർഹി യൂയമപി പുത്രേ പിതരി ച സ്ഥാസ്യഥ|</para>
  <para style="p">
    <verse number="25" style="v"/>സ ച പ്രതിജ്ഞയാസ്മഭ്യം യത് പ്രതിജ്ഞാതവാൻ തദ് അനന്തജീവനം|</para>
  <para style="p">
    <verse number="26" style="v"/>യേ ജനാ യുഷ്മാൻ ഭ്രാമയന്തി താനധ്യഹമ് ഇദം ലിഖിതവാൻ|</para>
  <para style="p">
    <verse number="27" style="v"/>അപരം യൂയം തസ്മാദ് യമ് അഭിഷേകം പ്രാപ്തവന്തഃ സ യുഷ്മാസു തിഷ്ഠതി തതഃ കോഽപി യദ് യുഷ്മാൻ ശിക്ഷയേത് തദ് അനാവശ്യകം, സ ചാഭിഷേകോ യുഷ്മാൻ സർവ്വാണി ശിക്ഷയതി സത്യശ്ച ഭവതി ന ചാതഥ്യഃ, അതഃ സ യുഷ്മാൻ യദ്വദ് അശിക്ഷയത് തദ്വത് തത്ര സ്ഥാസ്യഥ|</para>
  <para style="p">
    <verse number="28" style="v"/>അതഏവ ഹേ പ്രിയബാലകാ യൂയം തത്ര തിഷ്ഠത, തഥാ സതി സ യദാ പ്രകാശിഷ്യതേ തദാ വയം പ്രതിഭാന്വിതാ ഭവിഷ്യാമഃ, തസ്യാഗമനസമയേ ച തസ്യ സാക്ഷാന്ന ത്രപിഷ്യാമഹേ|</para>
  <para style="p">
    <verse number="29" style="v"/>സ ധാർമ്മികോ ഽസ്തീതി യദി യൂയം ജാനീഥ തർഹി യഃ കശ്ചിദ് ധർമ്മാചാരം കരോതി സ തസ്മാത് ജാത ഇത്യപി ജാനീത|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>പശ്യത വയമ് ഈശ്വരസ്യ സന്താനാ ഇതി നാമ്നാഖ്യാമഹേ, ഏതേന പിതാസ്മഭ്യം കീദൃക് മഹാപ്രേമ പ്രദത്തവാൻ, കിന്തു സംസാരസ്തം നാജാനാത് തത്കാരണാദസ്മാൻ അപി ന ജാനാതി|</para>
  <para style="p">
    <verse number="2" style="v"/>ഹേ പ്രിയതമാഃ, ഇദാനീം വയമ് ഈശ്വരസ്യ സന്താനാ ആസ്മഹേ പശ്ചാത് കിം ഭവിഷ്യാമസ്തദ് അദ്യാപ്യപ്രകാശിതം കിന്തു പ്രകാശം ഗതേ വയം തസ്യ സദൃശാ ഭവിഷ്യാമി ഇതി ജാനീമഃ, യതഃ സ യാദൃശോ ഽസ്തി താദൃശോ ഽസ്മാഭിർദർശിഷ്യതേ|</para>
  <para style="p">
    <verse number="3" style="v"/>തസ്മിൻ ഏഷാ പ്രത്യാശാ യസ്യ കസ്യചിദ് ഭവതി സ സ്വം തഥാ പവിത്രം കരോതി യഥാ സ പവിത്രോ ഽസ്തി|</para>
  <para style="p">
    <verse number="4" style="v"/>യഃ കശ്ചിത് പാപമ് ആചരതി സ വ്യവസ്ഥാലങ്ഘനം കരോതി യതഃ പാപമേവ വ്യവസ്ഥാലങ്ഘനം|</para>
  <para style="p">
    <verse number="5" style="v"/>അപരം സോ ഽസ്മാകം പാപാന്യപഹർത്തും പ്രാകാശതൈതദ് യൂയം ജാനീഥ, പാപഞ്ച തസ്മിൻ ന വിദ്യതേ|</para>
  <para style="p">
    <verse number="6" style="v"/>യഃ കശ്ചിത് തസ്മിൻ തിഷ്ഠതി സ പാപാചാരം ന കരോതി യഃ കശ്ചിത് പാപാചാരം കരോതി സ തം ന ദൃഷ്ടവാൻ ന വാവഗതവാൻ|</para>
  <para style="p">
    <verse number="7" style="v"/>ഹേ പ്രിയബാലകാഃ, കശ്ചിദ് യുഷ്മാകം ഭ്രമം ന ജനയേത്, യഃ കശ്ചിദ് ധർമ്മാചാരം കരോതി സ താദൃഗ് ധാർമ്മികോ ഭവതി യാദൃക് സ ധാമ്മികോ ഽസ്തി|</para>
  <para style="p">
    <verse number="8" style="v"/>യഃ പാപാചാരം കരോതി സ ശയതാനാത് ജാതോ യതഃ ശയതാന ആദിതഃ പാപാചാരീ ശയതാനസ്യ കർമ്മണാം ലോപാർഥമേവേശ്വരസ്യ പുത്രഃ പ്രാകാശത|</para>
  <para style="p">
    <verse number="9" style="v"/>യഃ കശ്ചിദ് ഈശ്വരാത് ജാതഃ സ പാപാചാരം ന കരോതി യതസ്തസ്യ വീര്യ്യം തസ്മിൻ തിഷ്ഠതി പാപാചാരം കർത്തുഞ്ച ന ശക്നോതി യതഃ സ ഈശ്വരാത് ജാതഃ|</para>
  <para style="p">
    <verse number="10" style="v"/>ഇത്യനേനേശ്വരസ്യ സന്താനാഃ ശയതാനസ്യ ച സന്താനാ വ്യക്താ ഭവന്തി| യഃ കശ്ചിദ് ധർമ്മാചാരം ന കരോതി സ ഈശ്വരാത് ജാതോ നഹി യശ്ച സ്വഭ്രാതരി ന പ്രീയതേ സോ ഽപീശ്വരാത് ജാതോ നഹി|</para>
  <para style="p">
    <verse number="11" style="v"/>യതസ്തസ്യ യ ആദേശ ആദിതോ യുഷ്മാഭിഃ ശ്രുതഃ സ ഏഷ ഏവ യദ് അസ്മാഭിഃ പരസ്പരം പ്രേമ കർത്തവ്യം|</para>
  <para style="p">
    <verse number="12" style="v"/>പാപാത്മതോ ജാതോ യഃ കാബിൽ സ്വഭ്രാതരം ഹതവാൻ തത്സദൃശൈരസ്മാഭി ർന ഭവിതവ്യം| സ കസ്മാത് കാരണാത് തം ഹതവാൻ? തസ്യ കർമ്മാണി ദുഷ്ടാനി തദ്ഭ്രാതുശ്ച കർമ്മാണി ധർമ്മാണ്യാസൻ ഇതി കാരണാത്|</para>
  <para style="p">
    <verse number="13" style="v"/>ഹേ മമ ഭ്രാതരഃ, സംസാരോ യദി യുഷ്മാൻ ദ്വേഷ്ടി തർഹി തദ് ആശ്ചര്യ്യം ന മന്യധ്വം|</para>
  <para style="p">
    <verse number="14" style="v"/>വയം മൃത്യുമ് ഉത്തീര്യ്യ ജീവനം പ്രാപ്തവന്തസ്തദ് ഭ്രാതൃഷു പ്രേമകരണാത് ജാനീമഃ| ഭ്രാതരി യോ ന പ്രീയതേ സ മൃത്യൗ തിഷ്ഠതി|</para>
  <para style="p">
    <verse number="15" style="v"/>യഃ കശ്ചിത് സ്വഭ്രാതരം ദ്വേഷ്ടി സം നരഘാതീ കിഞ്ചാനന്തജീവനം നരഘാതിനഃ കസ്യാപ്യന്തരേ നാവതിഷ്ഠതേ തദ് യൂയം ജാനീഥ|</para>
  <para style="p">
    <verse number="16" style="v"/>അസ്മാകം കൃതേ സ സ്വപ്രാണാംസ്ത്യക്തവാൻ ഇത്യനേന വയം പ്രേമ്നസ്തത്ത്വമ് അവഗതാഃ, അപരം ഭ്രാതൃണാം കൃതേ ഽസ്മാഭിരപി പ്രാണാസ്ത്യക്തവ്യാഃ|</para>
  <para style="p">
    <verse number="17" style="v"/>സാംസാരികജീവികാപ്രാപ്തോ യോ ജനഃ സ്വഭ്രാതരം ദീനം ദൃഷ്ട്വാ തസ്മാത് സ്വീയദയാം രുണദ്ധി തസ്യാന്തര ഈശ്വരസ്യ പ്രേമ കഥം തിഷ്ഠേത്?</para>
  <para style="p">
    <verse number="18" style="v"/>ഹേ മമ പ്രിയബാലകാഃ, വാക്യേന ജിഹ്വയാ വാസ്മാഭിഃ പ്രേമ ന കർത്തവ്യം കിന്തു കാര്യ്യേണ സത്യതയാ ചൈവ|</para>
  <para style="p">
    <verse number="19" style="v"/>ഏതേന വയം യത് സത്യമതസമ്ബന്ധീയാസ്തത് ജാനീമസ്തസ്യ സാക്ഷാത് സ്വാന്തഃകരണാനി സാന്ത്വയിതും ശക്ഷ്യാമശ്ച|</para>
  <para style="p">
    <verse number="20" style="v"/>യതോ ഽസ്മദന്തഃകരണം യദ്യസ്മാൻ ദൂഷയതി തർഹ്യസ്മദന്തഃ കരണാദ് ഈശ്വരോ മഹാൻ സർവ്വജ്ഞശ്ച|</para>
  <para style="p">
    <verse number="21" style="v"/>ഹേ പ്രിയതമാഃ, അസ്മദന്തഃകരണം യദ്യസ്മാൻ ന ദൂഷയതി തർഹി വയമ് ഈശ്വരസ്യ സാക്ഷാത് പ്രതിഭാന്വിതാ ഭവാമഃ|</para>
  <para style="p">
    <verse number="22" style="v"/>യച്ച പ്രാർഥയാമഹേ തത് തസ്മാത് പ്രാപ്നുമഃ, യതോ വയം തസ്യാജ്ഞാഃ പാലയാമസ്തസ്യ സാക്ഷാത് തുഷ്ടിജനകമ് ആചാരം കുർമ്മശ്ച|</para>
  <para style="p">
    <verse number="23" style="v"/>അപരം തസ്യേയമാജ്ഞാ യദ് വയം പുത്രസ്യ യീശുഖ്രീഷ്ടസ്യ നാമ്നി വിശ്വസിമസ്തസ്യാജ്ഞാനുസാരേണ ച പരസ്പരം പ്രേമ കുർമ്മഃ|</para>
  <para style="p">
    <verse number="24" style="v"/>യശ്ച തസ്യാജ്ഞാഃ പാലയതി സ തസ്മിൻ തിഷ്ഠതി തസ്മിൻ സോഽപി തിഷ്ഠതി; സ ചാസ്മാൻ യമ് ആത്മാനം ദത്തവാൻ തസ്മാത് സോ ഽസ്മാസു തിഷ്ഠതീതി ജാനീമഃ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഹേ പ്രിയതമാഃ, യൂയം സർവ്വേഷ്വാത്മസു ന വിശ്വസിത കിന്തു തേ ഈശ്വരാത് ജാതാ ന വേത്യാത്മനഃ പരീക്ഷധ്വം യതോ ബഹവോ മൃഷാഭവിഷ്യദ്വാദിനോ ജഗന്മധ്യമ് ആഗതവന്തഃ|</para>
  <para style="p">
    <verse number="2" style="v"/>ഈശ്വരീയോ യ ആത്മാ സ യുഷ്മാഭിരനേന പരിചീയതാം, യീശുഃ ഖ്രീഷ്ടോ നരാവതാരോ ഭൂത്വാഗത ഏതദ് യേന കേനചിദ് ആത്മനാ സ്വീക്രിയതേ സ ഈശ്വരീയഃ|</para>
  <para style="p">
    <verse number="3" style="v"/>കിന്തു യീശുഃ ഖ്രീഷ്ടോ നരാവതാരോ ഭൂത്വാഗത ഏതദ് യേന കേനചിദ് ആത്മനാ നാങ്ഗീക്രിയതേ സ ഈശ്വരീയോ നഹി കിന്തു ഖ്രീഷ്ടാരേരാത്മാ, തേന ചാഗന്തവ്യമിതി യുഷ്മാഭിഃ ശ്രുതം, സ ചേദാനീമപി ജഗതി വർത്തതേ|</para>
  <para style="p">
    <verse number="4" style="v"/>ഹേ ബാലകാഃ, യൂയമ് ഈശ്വരാത് ജാതാസ്താൻ ജിതവന്തശ്ച യതഃ സംസാരാധിഷ്ഠാനകാരിണോ ഽപി യുഷ്മദധിഷ്ഠാനകാരീ മഹാൻ|</para>
  <para style="p">
    <verse number="5" style="v"/>തേ സംസാരാത് ജാതാസ്തതോ ഹേതോഃ സംസാരാദ് ഭാഷന്തേ സംസാരശ്ച തേഷാം വാക്യാനി ഗൃഹ്ലാതി|</para>
  <para style="p">
    <verse number="6" style="v"/>വയമ് ഈശ്വരാത് ജാതാഃ, ഈശ്വരം യോ ജാനാതി സോഽസ്മദ്വാക്യാനി ഗൃഹ്ലാതി യശ്ചേശ്വരാത് ജാതോ നഹി സോഽസ്മദ്വാക്യാനി ന ഗൃഹ്ലാതി; അനേന വയം സത്യാത്മാനം ഭ്രാമകാത്മാനഞ്ച പരിചിനുമഃ|</para>
  <para style="p">
    <verse number="7" style="v"/>ഹേ പ്രിയതമാഃ, വയം പരസ്പരം പ്രേമ കരവാമ, യതഃ പ്രേമ ഈശ്വരാത് ജായതേ, അപരം യഃ കശ്ചിത് പ്രേമ കരോതി സ ഈശ്വരാത് ജാത ഈശ്വരം വേത്തി ച|</para>
  <para style="p">
    <verse number="8" style="v"/>യഃ പ്രേമ ന കരോതി സ ഈശ്വരം ന ജാനാതി യത ഈശ്വരഃ പ്രേമസ്വരൂപഃ|</para>
  <para style="p">
    <verse number="9" style="v"/>അസ്മാസ്വീശ്വരസ്യ പ്രേമൈതേന പ്രാകാശത യത് സ്വപുത്രേണാസ്മഭ്യം ജീവനദാനാർഥമ് ഈശ്വരഃ സ്വീയമ് അദ്വിതീയം പുത്രം ജഗന്മധ്യം പ്രേഷിതവാൻ|</para>
  <para style="p">
    <verse number="10" style="v"/>വയം യദ് ഈശ്വരേ പ്രീതവന്ത ഇത്യത്ര നഹി കിന്തു സ യദസ്മാസു പ്രീതവാൻ അസ്മത്പാപാനാം പ്രായശ്ചിർത്താർഥം സ്വപുത്രം പ്രേഷിതവാംശ്ചേത്യത്ര പ്രേമ സന്തിഷ്ഠതേ|</para>
  <para style="p">
    <verse number="11" style="v"/>ഹേ പ്രിയതമാഃ, അസ്മാസു യദീശ്വരേണൈതാദൃശം പ്രേമ കൃതം തർഹി പരസ്പരം പ്രേമ കർത്തുമ് അസ്മാകമപ്യുചിതം|</para>
  <para style="p">
    <verse number="12" style="v"/>ഈശ്വരഃ കദാച കേനാപി ന ദൃഷ്ടഃ യദ്യസ്മാഭിഃ പരസ്പരം പ്രേമ ക്രിയതേ തർഹീശ്വരോ ഽസ്മന്മധ്യേ തിഷ്ഠതി തസ്യ പ്രേമ ചാസ്മാസു സേത്സ്യതേ|</para>
  <para style="p">
    <verse number="13" style="v"/>അസ്മഭ്യം തേന സ്വകീയാത്മനോംഽശോ ദത്ത ഇത്യനേന വയം യത് തസ്മിൻ തിഷ്ഠാമഃ സ ച യദ് അസ്മാസു തിഷ്ഠതീതി ജാനീമഃ|</para>
  <para style="p">
    <verse number="14" style="v"/>പിതാ ജഗത്രാതാരം പുത്രം പ്രേഷിതവാൻ ഏതദ് വയം ദൃഷ്ട്വാ പ്രമാണയാമഃ|</para>
  <para style="p">
    <verse number="15" style="v"/>യീശുരീശ്വരസ്യ പുത്ര ഏതദ് യേനാങ്ഗീക്രിയതേ തസ്മിൻ ഈശ്വരസ്തിഷ്ഠതി സ ചേശ്വരേ തിഷ്ഠതി|</para>
  <para style="p">
    <verse number="16" style="v"/>അസ്മാസ്വീശ്വരസ്യ യത് പ്രേമ വർത്തതേ തദ് വയം ജ്ഞാതവന്തസ്തസ്മിൻ വിശ്വാസിതവന്തശ്ച| ഈശ്വരഃ പ്രേമസ്വരൂപഃ പ്രേമ്നീ യസ്തിഷ്ഠതി സ ഈശ്വരേ തിഷ്ഠതി തസ്മിംശ്ചേശ്വരസ്തിഷ്ഠതി|</para>
  <para style="p">
    <verse number="17" style="v"/>സ യാദൃശോ ഽസ്തി വയമപ്യേതസ്മിൻ ജഗതി താദൃശാ ഭവാമ ഏതസ്മാദ് വിചാരദിനേ ഽസ്മാഭി ര്യാ പ്രതിഭാ ലഭ്യതേ സാസ്മത്സമ്ബന്ധീയസ്യ പ്രേമ്നഃ സിദ്ധിഃ|</para>
  <para style="p">
    <verse number="18" style="v"/>പ്രേമ്നി ഭീതി ർന വർത്തതേ കിന്തു സിദ്ധം പ്രേമ ഭീതിം നിരാകരോതി യതോ ഭീതിഃ സയാതനാസ്തി ഭീതോ മാനവഃ പ്രേമ്നി സിദ്ധോ ന ജാതഃ|</para>
  <para style="p">
    <verse number="19" style="v"/>അസ്മാസു സ പ്രഥമം പ്രീതവാൻ ഇതി കാരണാദ് വയം തസ്മിൻ പ്രീയാമഹേ|</para>
  <para style="p">
    <verse number="20" style="v"/>ഈശ്വരേ ഽഹം പ്രീയ ഇത്യുക്ത്വാ യഃ കശ്ചിത് സ്വഭ്രാതരം ദ്വേഷ്ടി സോ ഽനൃതവാദീ| സ യം ദൃഷ്ടവാൻ തസ്മിൻ സ്വഭ്രാതരി യദി ന പ്രീയതേ തർഹി യമ് ഈശ്വരം ന ദൃഷ്ടവാൻ കഥം തസ്മിൻ പ്രേമ കർത്തും ശക്നുയാത്?</para>
  <para style="p">
    <verse number="21" style="v"/>അത ഈശ്വരേ യഃ പ്രീയതേ സ സ്വീയഭ്രാതര്യ്യപി പ്രീയതാമ് ഇയമ് ആജ്ഞാ തസ്മാദ് അസ്മാഭി ർലബ്ധാ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>യീശുരഭിഷിക്തസ്ത്രാതേതി യഃ കശ്ചിദ് വിശ്വാസിതി സ ഈശ്വരാത് ജാതഃ; അപരം യഃ കശ്ചിത് ജനയിതരി പ്രീയതേ സ തസ്മാത് ജാതേ ജനേ ഽപി പ്രീയതേ|</para>
  <para style="p">
    <verse number="2" style="v"/>വയമ് ഈശ്വരസ്യ സന്താനേഷു പ്രീയാമഹേ തദ് അനേന ജാനീമോ യദ് ഈശ്വരേ പ്രീയാമഹേ തസ്യാജ്ഞാഃ പാലയാമശ്ച|</para>
  <para style="p">
    <verse number="3" style="v"/>യത ഈശ്വരേ യത് പ്രേമ തത് തദീയാജ്ഞാപാലനേനാസ്മാഭിഃ പ്രകാശയിതവ്യം, തസ്യാജ്ഞാശ്ച കഠോരാ ന ഭവന്തി|</para>
  <para style="p">
    <verse number="4" style="v"/>യതോ യഃ കശ്ചിദ് ഈശ്വരാത് ജാതഃ സ സംസാരം ജയതി കിഞ്ചാസ്മാകം യോ വിശ്വാസഃ സ ഏവാസ്മാകം സംസാരജയിജയഃ|</para>
  <para style="p">
    <verse number="5" style="v"/>യീശുരീശ്വരസ്യ പുത്ര ഇതി യോ വിശ്വസിതി തം വിനാ കോഽപരഃ സംസാരം ജയതി?</para>
  <para style="p">
    <verse number="6" style="v"/>സോഽഭിഷിക്തസ്ത്രാതാ യീശുസ്തോയരുധിരാഭ്യാമ് ആഗതഃ കേവലം തോയേന നഹി കിന്തു തോയരുധിരാഭ്യാമ്, ആത്മാ ച സാക്ഷീ ഭവതി യത ആത്മാ സത്യതാസ്വരൂപഃ|</para>
  <para style="p">
    <verse number="7" style="v"/>യതോ ഹേതോഃ സ്വർഗേ പിതാ വാദഃ പവിത്ര ആത്മാ ച ത്രയ ഇമേ സാക്ഷിണഃ സന്തി, ത്രയ ഇമേ ചൈകോ ഭവന്തി|</para>
  <para style="p">
    <verse number="8" style="v"/>തഥാ പൃഥിവ്യാമ് ആത്മാ തോയം രുധിരഞ്ച ത്രീണ്യേതാനി സാക്ഷ്യം ദദാതി തേഷാം ത്രയാണാമ് ഏകത്വം ഭവതി ച|</para>
  <para style="p">
    <verse number="9" style="v"/>മാനവാനാം സാക്ഷ്യം യദ്യസ്മാഭി ർഗൃഹ്യതേ തർഹീശ്വരസ്യ സാക്ഷ്യം തസ്മാദപി ശ്രേഷ്ഠം യതഃ സ്വപുത്രമധീശ്വരേണ ദത്തം സാക്ഷ്യമിദം|</para>
  <para style="p">
    <verse number="10" style="v"/>ഈശ്വരസ്യ പുത്രേ യോ വിശ്വാസിതി സ നിജാന്തരേ തത് സാക്ഷ്യം ധാരയതി; ഈശ്വരേ യോ ന വിശ്വസിതി സ തമ് അനൃതവാദിനം കരോതി യത ഈശ്വരഃ സ്വപുത്രമധി യത് സാക്ഷ്യം ദത്തവാൻ തസ്മിൻ സ ന വിശ്വസിതി|</para>
  <para style="p">
    <verse number="11" style="v"/>തച്ച സാക്ഷ്യമിദം യദ് ഈശ്വരോ ഽസ്മഭ്യമ് അനന്തജീവനം ദത്തവാൻ തച്ച ജീവനം തസ്യ പുത്രേ വിദ്യതേ|</para>
  <para style="p">
    <verse number="12" style="v"/>യഃ പുത്രം ധാരയതി സ ജീവനം ധാരിയതി, ഈശ്വരസ്യ പുത്രം യോ ന ധാരയതി സ ജീവനം ന ധാരയതി|</para>
  <para style="p">
    <verse number="13" style="v"/>ഈശ്വരപുത്രസ്യ നാമ്നി യുഷ്മാൻ പ്രത്യേതാനി മയാ ലിഖിതാനി തസ്യാഭിപ്രായോ ഽയം യദ് യൂയമ് അനന്തജീവനപ്രാപ്താ ഇതി ജാനീയാത തസ്യേശ്വരപുത്രസ്യ നാമ്നി വിശ്വസേത ച|</para>
  <para style="p">
    <verse number="14" style="v"/>തസ്യാന്തികേ ഽസ്മാകം യാ പ്രതിഭാ ഭവതി തസ്യാഃ കാരണമിദം യദ് വയം യദി തസ്യാഭിമതം കിമപി തം യാചാമഹേ തർഹി സോ ഽസ്മാകം വാക്യം ശൃണോതി|</para>
  <para style="p">
    <verse number="15" style="v"/>സ ചാസ്മാകം യത് കിഞ്ചന യാചനം ശൃണോതീതി യദി ജാനീമസ്തർഹി തസ്മാദ് യാചിതാ വരാ അസ്മാഭിഃ പ്രാപ്യന്തേ തദപി ജാനീമഃ|</para>
  <para style="p">
    <verse number="16" style="v"/>കശ്ചിദ് യദി സ്വഭ്രാതരമ് അമൃത്യുജനകം പാപം കുർവ്വന്തം പശ്യതി തർഹി സ പ്രാർഥനാം കരോതു തേനേശ്വരസ്തസ്മൈ ജീവനം ദാസ്യതി, അർഥതോ മൃത്യുജനകം പാപം യേന നാകാരിതസ്മൈ| കിന്തു മൃത്യുജനകമ് ഏകം പാപമ് ആസ്തേ തദധി തേന പ്രാർഥനാ ക്രിയതാമിത്യഹം ന വദാമി|</para>
  <para style="p">
    <verse number="17" style="v"/>സർവ്വ ഏവാധർമ്മഃ പാപം കിന്തു സർവ്വപാംപ മൃത്യുജനകം നഹി|</para>
  <para style="p">
    <verse number="18" style="v"/>യ ഈശ്വരാത് ജാതഃ സ പാപാചാരം ന കരോതി കിന്ത്വീശ്വരാത് ജാതോ ജനഃ സ്വം രക്ഷതി തസ്മാത് സ പാപാത്മാ തം ന സ്പൃശതീതി വയം ജാനീമഃ|</para>
  <para style="p">
    <verse number="19" style="v"/>വയമ് ഈശ്വരാത് ജാതാഃ കിന്തു കൃത്സ്നഃ സംസാരഃ പാപാത്മനോ വശം ഗതോ ഽസ്തീതി ജാനീമഃ|</para>
  <para style="p">
    <verse number="20" style="v"/>അപരമ് ഈശ്വരസ്യ പുത്ര ആഗതവാൻ വയഞ്ച യയാ തസ്യ സത്യമയസ്യ ജ്ഞാനം പ്രാപ്നുയാമസ്താദൃശീം ധിയമ് അസ്മഭ്യം ദത്തവാൻ ഇതി ജാനീമസ്തസ്മിൻ സത്യമയേ ഽർഥതസ്തസ്യ പുത്രേ യീശുഖ്രീഷ്ടേ തിഷ്ഠാമശ്ച; സ ഏവ സത്യമയ ഈശ്വരോ ഽനന്തജീവനസ്വരൂപശ്ചാസ്തി|</para>
  <para style="p">
    <verse number="21" style="v"/>ഹേ പ്രിയബാലകാഃ, യൂയം ദേവമൂർത്തിഭ്യഃ സ്വാൻ രക്ഷത| ആമേൻ|</para>
</usx>
