<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="LUK" style="id">Sanskrit Bible (NT) in Malayalam Script (സത്യവേദഃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Luke</para>
  <para style="toc1">ലൂകലിഖിതഃ സുസംവാദഃ</para>
  <para style="toc2">ലൂകഃ</para>
  <para style="toc3">ലൂകഃ</para>
  <para style="mt1">ലൂകലിഖിതഃ സുസംവാദഃ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>പ്രഥമതോ യേ സാക്ഷിണോ വാക്യപ്രചാരകാശ്ചാസൻ തേഽസ്മാകം മധ്യേ യദ്യത് സപ്രമാണം വാക്യമർപയന്തി സ്മ</para>
  <para style="p">
    <verse number="2" style="v"/>തദനുസാരതോഽന്യേപി ബഹവസ്തദ്വൃത്താന്തം രചയിതും പ്രവൃത്താഃ|</para>
  <para style="p">
    <verse number="3" style="v"/>അതഏവ ഹേ മഹാമഹിമഥിയഫിൽ ത്വം യാ യാഃ കഥാ അശിക്ഷ്യഥാസ്താസാം ദൃഢപ്രമാണാനി യഥാ പ്രാപ്നോഷി</para>
  <para style="p">
    <verse number="4" style="v"/>തദർഥം പ്രഥമമാരഭ്യ താനി സർവ്വാണി ജ്ഞാത്വാഹമപി അനുക്രമാത് സർവ്വവൃത്താന്താൻ തുഭ്യം ലേഖിതും മതിമകാർഷമ്|</para>
  <para style="p">
    <verse number="5" style="v"/>യിഹൂദാദേശീയഹേരോദ്നാമകേ രാജത്വം കുർവ്വതി അബീയയാജകസ്യ പര്യ്യായാധികാരീ സിഖരിയനാമക ഏകോ യാജകോ ഹാരോണവംശോദ്ഭവാ ഇലീശേവാഖ്യാ</para>
  <para style="p">
    <verse number="6" style="v"/>തസ്യ ജായാ ദ്വാവിമൗ നിർദോഷൗ പ്രഭോഃ സർവ്വാജ്ഞാ വ്യവസ്ഥാശ്ച സംമന്യ ഈശ്വരദൃഷ്ടൗ ധാർമ്മികാവാസ്താമ്|</para>
  <para style="p">
    <verse number="7" style="v"/>തയോഃ സന്താന ഏകോപി നാസീത്, യത ഇലീശേവാ ബന്ധ്യാ തൗ ദ്വാവേവ വൃദ്ധാവഭവതാമ്|</para>
  <para style="p">
    <verse number="8" style="v"/>യദാ സ്വപര്യ്യാനുക്രമേണ സിഖരിയ ഈശ്വാസ്യ സമക്ഷം യാജകീയം കർമ്മ കരോതി</para>
  <para style="p">
    <verse number="9" style="v"/>തദാ യജ്ഞസ്യ ദിനപരിപായ്യാ പരമേശ്വരസ്യ മന്ദിരേ പ്രവേശകാലേ ധൂപജ്വാലനം കർമ്മ തസ്യ കരണീയമാസീത്|</para>
  <para style="p">
    <verse number="10" style="v"/>തദ്ധൂപജ്വാലനകാലേ ലോകനിവഹേ പ്രാർഥനാം കർതും ബഹിസ്തിഷ്ഠതി</para>
  <para style="p">
    <verse number="11" style="v"/>സതി സിഖരിയോ യസ്യാം വേദ്യാം ധൂപം ജ്വാലയതി തദ്ദക്ഷിണപാർശ്വേ പരമേശ്വരസ്യ ദൂത ഏക ഉപസ്ഥിതോ ദർശനം ദദൗ|</para>
  <para style="p">
    <verse number="12" style="v"/>തം ദൃഷ്ട്വാ സിഖരിയ ഉദ്വിവിജേ ശശങ്കേ ച|</para>
  <para style="p">
    <verse number="13" style="v"/>തദാ സ ദൂതസ്തം ബഭാഷേ ഹേ സിഖരിയ മാ ഭൈസ്തവ പ്രാർഥനാ ഗ്രാഹ്യാ ജാതാ തവ ഭാര്യ്യാ ഇലീശേവാ പുത്രം പ്രസോഷ്യതേ തസ്യ നാമ യോेഹൻ ഇതി കരിഷ്യസി|</para>
  <para style="p">
    <verse number="14" style="v"/>കിഞ്ച ത്വം സാനന്ദഃ സഹർഷശ്ച ഭവിഷ്യസി തസ്യ ജന്മനി ബഹവ ആനന്ദിഷ്യന്തി ച|</para>
  <para style="p">
    <verse number="15" style="v"/>യതോ ഹേതോഃ സ പരമേശ്വരസ്യ ഗോചരേ മഹാൻ ഭവിഷ്യതി തഥാ ദ്രാക്ഷാരസം സുരാം വാ കിമപി ന പാസ്യതി, അപരം ജന്മാരഭ്യ പവിത്രേണാത്മനാ പരിപൂർണഃ</para>
  <para style="p">
    <verse number="16" style="v"/>സൻ ഇസ്രായേല്വംശീയാൻ അനേകാൻ പ്രഭോഃ പരമേശ്വരസ്യ മാർഗമാനേഷ്യതി|</para>
  <para style="p">
    <verse number="17" style="v"/>സന്താനാൻ പ്രതി പിതൃണാം മനാംസി ധർമ്മജ്ഞാനം പ്രത്യനാജ്ഞാഗ്രാഹിണശ്ച പരാവർത്തയിതും, പ്രഭോഃ പരമേശ്വരസ്യ സേവാർഥമ് ഏകാം സജ്ജിതജാതിം വിധാതുഞ്ച സ ഏലിയരൂപാത്മശക്തിപ്രാപ്തസ്തസ്യാഗ്രേ ഗമിഷ്യതി|</para>
  <para style="p">
    <verse number="18" style="v"/>തദാ സിഖരിയോ ദൂതമവാദീത് കഥമേതദ് വേത്സ്യാമി? യതോഹം വൃദ്ധോ മമ ഭാര്യ്യാ ച വൃദ്ധാ|</para>
  <para style="p">
    <verse number="19" style="v"/>തതോ ദൂതഃ പ്രത്യുവാച പശ്യേശ്വരസ്യ സാക്ഷാദ്വർത്തീ ജിബ്രായേൽനാമാ ദൂതോഹം ത്വയാ സഹ കഥാം ഗദിതും തുഭ്യമിമാം ശുഭവാർത്താം ദാതുഞ്ച പ്രേഷിതഃ|</para>
  <para style="p">
    <verse number="20" style="v"/>കിന്തു മദീയം വാക്യം കാലേ ഫലിഷ്യതി തത് ത്വയാ ന പ്രതീതമ് അതഃ കാരണാദ് യാവദേവ താനി ന സേത്സ്യന്തി താവത് ത്വം വക്തുംമശക്തോ മൂകോ ഭവ|</para>
  <para style="p">
    <verse number="21" style="v"/>തദാനീം യേ യേ ലോകാഃ സിഖരിയമപൈക്ഷന്ത തേ മധ്യേമന്ദിരം തസ്യ ബഹുവിലമ്ബാദ് ആശ്ചര്യ്യം മേനിരേ|</para>
  <para style="p">
    <verse number="22" style="v"/>സ ബഹിരാഗതോ യദാ കിമപി വാക്യം വക്തുമശക്തഃ സങ്കേതം കൃത്വാ നിഃശബ്ദസ്തസ്യൗ തദാ മധ്യേമന്ദിരം കസ്യചിദ് ദർശനം തേന പ്രാപ്തമ് ഇതി സർവ്വേ ബുബുധിരേ|</para>
  <para style="p">
    <verse number="23" style="v"/>അനന്തരം തസ്യ സേവനപര്യ്യായേ സമ്പൂർണേ സതി സ നിജഗേഹം ജഗാമ|</para>
  <para style="p">
    <verse number="24" style="v"/>കതിപയദിനേഷു ഗതേഷു തസ്യ ഭാര്യ്യാ ഇലീശേവാ ഗർബ്ഭവതീ ബഭൂവ</para>
  <para style="p">
    <verse number="25" style="v"/>പശ്ചാത് സാ പഞ്ചമാസാൻ സംഗോപ്യാകഥയത് ലോകാനാം സമക്ഷം മമാപമാനം ഖണ്ഡയിതും പരമേശ്വരോ മയി ദൃഷ്ടിം പാതയിത്വാ കർമ്മേദൃശം കൃതവാൻ|</para>
  <para style="p">
    <verse number="26" style="v"/>അപരഞ്ച തസ്യാ ഗർബ്ഭസ്യ ഷഷ്ഠേ മാസേ ജാതേ ഗാലീൽപ്രദേശീയനാസരത്പുരേ</para>
  <para style="p">
    <verse number="27" style="v"/>ദായൂദോ വംശീയായ യൂഷഫ്നാമ്നേ പുരുഷായ യാ മരിയമ്നാമകുമാരീ വാഗ്ദത്താസീത് തസ്യാഃ സമീപം ജിബ്രായേൽ ദൂത ഈശ്വരേണ പ്രഹിതഃ|</para>
  <para style="p">
    <verse number="28" style="v"/>സ ഗത്വാ ജഗാദ ഹേ ഈശ്വരാനുഗൃഹീതകന്യേ തവ ശുഭം ഭൂയാത് പ്രഭുഃ പരമേശ്വരസ്തവ സഹായോസ്തി നാരീണാം മധ്യേ ത്വമേവ ധന്യാ|</para>
  <para style="p">
    <verse number="29" style="v"/>തദാനീം സാ തം ദൃഷ്ട്വാ തസ്യ വാക്യത ഉദ്വിജ്യ കീദൃശം ഭാഷണമിദമ് ഇതി മനസാ ചിന്തയാമാസ|</para>
  <para style="p">
    <verse number="30" style="v"/>തതോ ദൂതോഽവദത് ഹേ മരിയമ് ഭയം മാകാർഷീഃ, ത്വയി പരമേശ്വരസ്യാനുഗ്രഹോസ്തി|</para>
  <para style="p">
    <verse number="31" style="v"/>പശ്യ ത്വം ഗർബ്ഭം ധൃത്വാ പുത്രം പ്രസോഷ്യസേ തസ്യ നാമ യീശുരിതി കരിഷ്യസി|</para>
  <para style="p">
    <verse number="32" style="v"/>സ മഹാൻ ഭവിഷ്യതി തഥാ സർവ്വേഭ്യഃ ശ്രേഷ്ഠസ്യ പുത്ര ഇതി ഖ്യാസ്യതി; അപരം പ്രഭുഃ പരമേശ്വരസ്തസ്യ പിതുർദായൂദഃ സിംഹാസനം തസ്മൈ ദാസ്യതി;</para>
  <para style="p">
    <verse number="33" style="v"/>തഥാ സ യാകൂബോ വംശോപരി സർവ്വദാ രാജത്വം കരിഷ്യതി, തസ്യ രാജത്വസ്യാന്തോ ന ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="34" style="v"/>തദാ മരിയമ് തം ദൂതം ബഭാഷേ നാഹം പുരുഷസങ്ഗം കരോമി തർഹി കഥമേതത് സമ്ഭവിഷ്യതി?</para>
  <para style="p">
    <verse number="35" style="v"/>തതോ ദൂതോഽകഥയത് പവിത്ര ആത്മാ ത്വാമാശ്രായിഷ്യതി തഥാ സർവ്വശ്രേഷ്ഠസ്യ ശക്തിസ്തവോപരി ഛായാം കരിഷ്യതി തതോ ഹേതോസ്തവ ഗർബ്ഭാദ് യഃ പവിത്രബാലകോ ജനിഷ്യതേ സ ഈശ്വരപുത്ര ഇതി ഖ്യാതിം പ്രാപ്സ്യതി|</para>
  <para style="p">
    <verse number="36" style="v"/>അപരഞ്ച പശ്യ തവ ജ്ഞാതിരിലീശേവാ യാം സർവ്വേ ബന്ധ്യാമവദൻ ഇദാനീം സാ വാർദ്ധക്യേ സന്താനമേകം ഗർബ്ഭേഽധാരയത് തസ്യ ഷഷ്ഠമാസോഭൂത്|</para>
  <para style="p">
    <verse number="37" style="v"/>കിമപി കർമ്മ നാസാധ്യമ് ഈശ്വരസ്യ|</para>
  <para style="p">
    <verse number="38" style="v"/>തദാ മരിയമ് ജഗാദ, പശ്യ പ്രഭേരഹം ദാസീ മഹ്യം തവ വാക്യാനുസാരേണ സർവ്വമേതദ് ഘടതാമ്; അനനതരം ദൂതസ്തസ്യാഃ സമീപാത് പ്രതസ്ഥേ|</para>
  <para style="p">
    <verse number="39" style="v"/>അഥ കതിപയദിനാത് പരം മരിയമ് തസ്മാത് പർവ്വതമയപ്രദേശീയയിഹൂദായാ നഗരമേകം ശീഘ്രം ഗത്വാ</para>
  <para style="p">
    <verse number="40" style="v"/>സിഖരിയയാജകസ്യ ഗൃഹം പ്രവിശ്യ തസ്യ ജായാമ് ഇലീശേവാം സമ്ബോധ്യാവദത്|</para>
  <para style="p">
    <verse number="41" style="v"/>തതോ മരിയമഃ സമ്ബോധനവാക്യേ ഇലീശേവായാഃ കർണയോഃ പ്രവിഷ്ടമാത്രേ സതി തസ്യാ ഗർബ്ഭസ്ഥബാലകോ നനർത്ത| തത ഇലീശേവാ പവിത്രേണാത്മനാ പരിപൂർണാ സതീ</para>
  <para style="p">
    <verse number="42" style="v"/>പ്രോച്ചൈർഗദിതുമാരേഭേ, യോഷിതാം മധ്യേ ത്വമേവ ധന്യാ, തവ ഗർബ്ഭസ്ഥഃ ശിശുശ്ച ധന്യഃ|</para>
  <para style="p">
    <verse number="43" style="v"/>ത്വം പ്രഭോർമാതാ, മമ നിവേശനേ ത്വയാ ചരണാവർപിതൗ, മമാദ്യ സൗഭാഗ്യമേതത്|</para>
  <para style="p">
    <verse number="44" style="v"/>പശ്യ തവ വാക്യേ മമ കർണയോഃ പ്രവിഷ്ടമാത്രേ സതി മമോദരസ്ഥഃ ശിശുരാനന്ദാൻ നനർത്ത|</para>
  <para style="p">
    <verse number="45" style="v"/>യാ സ്ത്രീ വ്യശ്വസീത് സാ ധന്യാ, യതോ ഹേതോസ്താം പ്രതി പരമേശ്വരോക്തം വാക്യം സർവ്വം സിദ്ധം ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="46" style="v"/>തദാനീം മരിയമ് ജഗാദ| ധന്യവാദം പരേശസ്യ കരോതി മാമകം മനഃ|</para>
  <para style="p">
    <verse number="47" style="v"/>മമാത്മാ താരകേശേ ച സമുല്ലാസം പ്രഗച്ഛതി|</para>
  <para style="p">
    <verse number="48" style="v"/>അകരോത് സ പ്രഭു ർദുഷ്ടിം സ്വദാസ്യാ ദുർഗതിം പ്രതി| പശ്യാദ്യാരഭ്യ മാം ധന്യാം വക്ഷ്യന്തി പുരുഷാഃ സദാ|</para>
  <para style="p">
    <verse number="49" style="v"/>യഃ സർവ്വശക്തിമാൻ യസ്യ നാമാപി ച പവിത്രകം| സ ഏവ സുമഹത്കർമ്മ കൃതവാൻ മന്നിമിത്തകം|</para>
  <para style="p">
    <verse number="50" style="v"/>യേ ബിഭ്യതി ജനാസ്തസ്മാത് തേഷാം സന്താനപംക്തിഷു| അനുകമ്പാ തദീയാ ച സർവ്വദൈവ സുതിഷ്ഠതി|</para>
  <para style="p">
    <verse number="51" style="v"/>സ്വബാഹുബലതസ്തേന പ്രാകാശ്യത പരാക്രമഃ| മനഃകുമന്ത്രണാസാർദ്ധം വികീര്യ്യന്തേഽഭിമാനിനഃ|</para>
  <para style="p">
    <verse number="52" style="v"/>സിംഹാസനഗതാല്ലോകാൻ ബലിനശ്ചാവരോഹ്യ സഃ| പദേഷൂച്ചേഷു ലോകാംസ്തു ക്ഷുദ്രാൻ സംസ്ഥാപയത്യപി|</para>
  <para style="p">
    <verse number="53" style="v"/>ക്ഷുധിതാൻ മാനവാൻ ദ്രവ്യൈരുത്തമൈഃ പരിതർപ്യ സഃ| സകലാൻ ധനിനോ ലോകാൻ വിസൃജേദ് രിക്തഹസ്തകാൻ|</para>
  <para style="p">
    <verse number="54" style="v"/>ഇബ്രാഹീമി ച തദ്വംശേ യാ ദയാസ്തി സദൈവ താം| സ്മൃത്വാ പുരാ പിതൃണാം നോ യഥാ സാക്ഷാത് പ്രതിശ്രുതം|</para>
  <para style="p">
    <verse number="55" style="v"/>ഇസ്രായേൽസേവകസ്തേന തഥോപക്രിയതേ സ്വയം||</para>
  <para style="p">
    <verse number="56" style="v"/>അനന്തരം മരിയമ് പ്രായേണ മാസത്രയമ് ഇലീശേവയാ സഹോഷിത്വാ വ്യാഘുയ്യ നിജനിവേശനം യയൗ|</para>
  <para style="p">
    <verse number="57" style="v"/>തദനന്തരമ് ഇലീശേവായാഃ പ്രസവകാല ഉപസ്ഥിതേ സതി സാ പുത്രം പ്രാസോഷ്ട|</para>
  <para style="p">
    <verse number="58" style="v"/>തതഃ പരമേശ്വരസ്തസ്യാം മഹാനുഗ്രഹം കൃതവാൻ ഏതത് ശ്രുത്വാ സമീപവാസിനഃ കുടുമ്ബാശ്ചാഗത്യ തയാ സഹ മുമുദിരേ|</para>
  <para style="p">
    <verse number="59" style="v"/>തഥാഷ്ടമേ ദിനേ തേ ബാലകസ്യ ത്വചം ഛേത്തുമ് ഏത്യ തസ്യ പിതൃനാമാനുരൂപം തന്നാമ സിഖരിയ ഇതി കർത്തുമീഷുഃ|</para>
  <para style="p">
    <verse number="60" style="v"/>കിന്തു തസ്യ മാതാകഥയത് തന്ന, നാമാസ്യ യോഹൻ ഇതി കർത്തവ്യമ്|</para>
  <para style="p">
    <verse number="61" style="v"/>തദാ തേ വ്യാഹരൻ തവ വംശമധ്യേ നാമേദൃശം കസ്യാപി നാസ്തി|</para>
  <para style="p">
    <verse number="62" style="v"/>തതഃ പരം തസ്യ പിതരം സിഖരിയം പ്രതി സങ്കേത്യ പപ്രച്ഛുഃ ശിശോഃ കിം നാമ കാരിഷ്യതേ?</para>
  <para style="p">
    <verse number="63" style="v"/>തതഃ സ ഫലകമേകം യാചിത്വാ ലിലേഖ തസ്യ നാമ യോഹൻ ഭവിഷ്യതി| തസ്മാത് സർവ്വേ ആശ്ചര്യ്യം മേനിരേ|</para>
  <para style="p">
    <verse number="64" style="v"/>തത്ക്ഷണം സിഖരിയസ്യ ജിഹ്വാജാഡ്യേഽപഗതേ സ മുഖം വ്യാദായ സ്പഷ്ടവർണമുച്ചാര്യ്യ ഈശ്വരസ്യ ഗുണാനുവാദം ചകാര|</para>
  <para style="p">
    <verse number="65" style="v"/>തസ്മാച്ചതുർദിക്സ്ഥാഃ സമീപവാസിലോകാ ഭീതാ ഏവമേതാഃ സർവ്വാഃ കഥാ യിഹൂദായാഃ പർവ്വതമയപ്രദേശസ്യ സർവ്വത്ര പ്രചാരിതാഃ|</para>
  <para style="p">
    <verse number="66" style="v"/>തസ്മാത് ശ്രോതാരോ മനഃസു സ്ഥാപയിത്വാ കഥയാമ്ബഭൂവുഃ കീദൃശോയം ബാലോ ഭവിഷ്യതി? അഥ പരമേശ്വരസ്തസ്യ സഹായോഭൂത്|</para>
  <para style="p">
    <verse number="67" style="v"/>തദാ യോഹനഃ പിതാ സിഖരിയഃ പവിത്രേണാത്മനാ പരിപൂർണഃ സൻ ഏതാദൃശം ഭവിഷ്യദ്വാക്യം കഥയാമാസ|</para>
  <para style="p">
    <verse number="68" style="v"/>ഇസ്രായേലഃ പ്രഭു ര്യസ്തു സ ധന്യഃ പരമേശ്വരഃ| അനുഗൃഹ്യ നിജാല്ലോകാൻ സ ഏവ പരിമോചയേത്|</para>
  <para style="p">
    <verse number="69" style="v"/>വിപക്ഷജനഹസ്തേഭ്യോ യഥാ മോച്യാമഹേ വയം| യാവജ്ജീവഞ്ച ധർമ്മേണ സാരല്യേന ച നിർഭയാഃ|</para>
  <para style="p">
    <verse number="70" style="v"/>സേവാമഹൈ തമേവൈകമ് ഏതത്കാരണമേവ ച| സ്വകീയം സുപവിത്രഞ്ച സംസ്മൃത്യ നിയമം സദാ|</para>
  <para style="p">
    <verse number="71" style="v"/>കൃപയാ പുരുഷാൻ പൂർവ്വാൻ നികഷാർഥാത്തു നഃ പിതുഃ| ഇബ്രാഹീമഃ സമീപേ യം ശപഥം കൃതവാൻ പുരാ|</para>
  <para style="p">
    <verse number="72" style="v"/>തമേവ സഫലം കർത്തം തഥാ ശത്രുഗണസ്യ ച| ഋृതീയാകാരിണശ്ചൈവ കരേഭ്യോ രക്ഷണായ നഃ|</para>
  <para style="p">
    <verse number="73" style="v"/>സൃഷ്ടേഃ പ്രഥമതഃ സ്വീയൈഃ പവിത്രൈ ർഭാവിവാദിഭിഃ|</para>
  <para style="p">
    <verse number="74" style="v"/>യഥോക്തവാൻ തഥാ സ്വസ്യ ദായൂദഃ സേവകസ്യ തു|</para>
  <para style="p">
    <verse number="75" style="v"/>വംശേ ത്രാതാരമേകം സ സമുത്പാദിതവാൻ സ്വയമ്|</para>
  <para style="p">
    <verse number="76" style="v"/>അതോ ഹേ ബാലക ത്വന്തു സർവ്വേഭ്യഃ ശ്രേഷ്ഠ ഏവ യഃ| തസ്യൈവ ഭാവിവാദീതി പ്രവിഖ്യാതോ ഭവിഷ്യസി| അസ്മാകം ചരണാൻ ക്ഷേമേ മാർഗേ ചാലയിതും സദാ| ഏവം ധ്വാന്തേഽർഥതോ മൃത്യോശ്ഛായായാം യേ തു മാനവാഃ|</para>
  <para style="p">
    <verse number="77" style="v"/>ഉപവിഷ്ടാസ്തു താനേവ പ്രകാശയിതുമേവ ഹി| കൃത്വാ മഹാനുകമ്പാം ഹി യാമേവ പരമേശ്വരഃ|</para>
  <para style="p">
    <verse number="78" style="v"/>ഊർദ്വ്വാത് സൂര്യ്യമുദായ്യൈവാസ്മഭ്യം പ്രാദാത്തു ദർശനം| തയാനുകമ്പയാ സ്വസ്യ ലോകാനാം പാപമോചനേ|</para>
  <para style="p">
    <verse number="79" style="v"/>പരിത്രാണസ്യ തേഭ്യോ ഹി ജ്ഞാനവിശ്രാണനായ ച| പ്രഭോ ർമാർഗം പരിഷ്കർത്തും തസ്യാഗ്രായീ ഭവിഷ്യസി||</para>
  <para style="p">
    <verse number="80" style="v"/>അഥ ബാലകഃ ശരീരേണ ബുദ്ധ്യാ ച വർദ്ധിതുമാരേഭേ; അപരഞ്ച സ ഇസ്രായേലോ വംശീയലോകാനാം സമീപേ യാവന്ന പ്രകടീഭൂതസ്താസ്താവത് പ്രാന്തരേ ന്യവസത്|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അപരഞ്ച തസ്മിൻ കാലേ രാജ്യസ്യ സർവ്വേഷാം ലോകാനാം നാമാനി ലേഖയിതുമ് അഗസ്തകൈസര ആജ്ഞാപയാമാസ|</para>
  <para style="p">
    <verse number="2" style="v"/>തദനുസാരേണ കുരീണിയനാമനി സുരിയാദേശസ്യ ശാസകേ സതി നാമലേഖനം പ്രാരേഭേ|</para>
  <para style="p">
    <verse number="3" style="v"/>അതോ ഹേതോ ർനാമ ലേഖിതും സർവ്വേ ജനാഃ സ്വീയം സ്വീയം നഗരം ജഗ്മുഃ|</para>
  <para style="p">
    <verse number="4" style="v"/>തദാനീം യൂഷഫ് നാമ ലേഖിതും വാഗ്ദത്തയാ സ്വഭാര്യ്യയാ ഗർബ്ഭവത്യാ മരിയമാ സഹ സ്വയം ദായൂദഃ സജാതിവംശ ഇതി കാരണാദ് ഗാലീൽപ്രദേശസ്യ നാസരത്നഗരാദ്</para>
  <para style="p">
    <verse number="5" style="v"/>യിഹൂദാപ്രദേശസ്യ ബൈത്ലേഹമാഖ്യം ദായൂദ്നഗരം ജഗാമ|</para>
  <para style="p">
    <verse number="6" style="v"/>അന്യച്ച തത്ര സ്ഥാനേ തയോസ്തിഷ്ഠതോഃ സതോ ർമരിയമഃ പ്രസൂതികാല ഉപസ്ഥിതേ</para>
  <para style="p">
    <verse number="7" style="v"/>സാ തം പ്രഥമസുതം പ്രാസോഷ്ട കിന്തു തസ്മിൻ വാസഗൃഹേ സ്ഥാനാഭാവാദ് ബാലകം വസ്ത്രേണ വേഷ്ടയിത്വാ ഗോശാലായാം സ്ഥാപയാമാസ|</para>
  <para style="p">
    <verse number="8" style="v"/>അനന്തരം യേ കിയന്തോ മേഷപാലകാഃ സ്വമേഷവ്രജരക്ഷായൈ തത്പ്രദേശേ സ്ഥിത്വാ രജന്യാം പ്രാന്തരേ പ്രഹരിണഃ കർമ്മ കുർവ്വന്തി,</para>
  <para style="p">
    <verse number="9" style="v"/>തേഷാം സമീപം പരമേശ്വരസ്യ ദൂത ആഗത്യോപതസ്ഥൗ; തദാ ചതുഷ്പാർശ്വേ പരമേശ്വരസ്യ തേജസഃ പ്രകാശിതത്വാത് തേഽതിശശങ്കിരേ|</para>
  <para style="p">
    <verse number="10" style="v"/>തദാ സ ദൂത ഉവാച മാ ഭൈഷ്ട പശ്യതാദ്യ ദായൂദഃ പുരേ യുഷ്മന്നിമിത്തം ത്രാതാ പ്രഭുഃ ഖ്രീഷ്ടോഽജനിഷ്ട,</para>
  <para style="p">
    <verse number="11" style="v"/>സർവ്വേഷാം ലോകാനാം മഹാനന്ദജനകമ് ഇമം മങ്ഗലവൃത്താന്തം യുഷ്മാൻ ജ്ഞാപയാമി|</para>
  <para style="p">
    <verse number="12" style="v"/>യൂയം (തത്സ്ഥാനം ഗത്വാ) വസ്ത്രവേഷ്ടിതം തം ബാലകം ഗോശാലായാം ശയനം ദ്രക്ഷ്യഥ യുഷ്മാൻ പ്രതീദം ചിഹ്നം ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="13" style="v"/>ദൂത ഇമാം കഥാം കഥിതവതി തത്രാകസ്മാത് സ്വർഗീയാഃ പൃതനാ ആഗത്യ കഥാമ് ഇമാം കഥയിത്വേശ്വരസ്യ ഗുണാനന്വവാദിഷുഃ, യഥാ,</para>
  <para style="p">
    <verse number="14" style="v"/>സർവ്വോർദ്വ്വസ്ഥൈരീശ്വരസ്യ മഹിമാ സമ്പ്രകാശ്യതാം| ശാന്തിർഭൂയാത് പൃഥിവ്യാസ്തു സന്തോഷശ്ച നരാൻ പ്രതി||</para>
  <para style="p">
    <verse number="15" style="v"/>തതഃ പരം തേഷാം സന്നിധേ ർദൂതഗണേ സ്വർഗം ഗതേ മേഷപാലകാഃ പരസ്പരമ് അവേചൻ ആഗച്ഛത പ്രഭുഃ പരമേശ്വരോ യാം ഘടനാം ജ്ഞാപിതവാൻ തസ്യാ യാഥര്യം ജ്ഞാതും വയമധുനാ ബൈത്ലേഹമ്പുരം യാമഃ|</para>
  <para style="p">
    <verse number="16" style="v"/>പശ്ചാത് തേ തൂർണം വ്രജിത്വാ മരിയമം യൂഷഫം ഗോശാലായാം ശയനം ബാലകഞ്ച ദദൃശുഃ|</para>
  <para style="p">
    <verse number="17" style="v"/>ഇത്ഥം ദൃഷ്ട്വാ ബാലകസ്യാർഥേ പ്രോക്താം സർവ്വകഥാം തേ പ്രാചാരയാഞ്ചക്രുഃ|</para>
  <para style="p">
    <verse number="18" style="v"/>തതോ യേ ലോകാ മേഷരക്ഷകാണാം വദനേഭ്യസ്താം വാർത്താം ശുശ്രുവുസ്തേ മഹാശ്ചര്യ്യം മേനിരേ|</para>
  <para style="p">
    <verse number="19" style="v"/>കിന്തു മരിയമ് ഏതത്സർവ്വഘടനാനാം താത്പര്യ്യം വിവിച്യ മനസി സ്ഥാപയാമാസ|</para>
  <para style="p">
    <verse number="20" style="v"/>തത്പശ്ചാദ് ദൂതവിജ്ഞപ്താനുരൂപം ശ്രുത്വാ ദൃഷ്ട്വാ ച മേഷപാലകാ ഈശ്വരസ്യ ഗുണാനുവാദം ധന്യവാദഞ്ച കുർവ്വാണാഃ പരാവൃത്യ യയുഃ|</para>
  <para style="p">
    <verse number="21" style="v"/>അഥ ബാലകസ്യ ത്വക്ഛേദനകാലേഽഷ്ടമദിവസേ സമുപസ്ഥിതേ തസ്യ ഗർബ്ഭസ്ഥിതേഃ പുർവ്വം സ്വർഗീയദൂതോ യഥാജ്ഞാപയത് തദനുരൂപം തേ തന്നാമധേയം യീശുരിതി ചക്രിരേ|</para>
  <para style="p">
    <verse number="22" style="v"/>തതഃ പരം മൂസാലിഖിതവ്യവസ്ഥായാ അനുസാരേണ മരിയമഃ ശുചിത്വകാല ഉപസ്ഥിതേ,</para>
  <para style="p">
    <verse number="23" style="v"/>"പ്രഥമജഃ സർവ്വഃ പുരുഷസന്താനഃ പരമേശ്വരേ സമർപ്യതാം," ഇതി പരമേശ്വരസ്യ വ്യവസ്ഥയാ</para>
  <para style="p">
    <verse number="24" style="v"/>യീശും പരമേശ്വരേ സമർപയിതുമ് ശാസ്ത്രീയവിധ്യുക്തം കപോതദ്വയം പാരാവതശാവകദ്വയം വാ ബലിം ദാതും തേ തം ഗൃഹീത്വാ യിരൂശാലമമ് ആയയുഃ|</para>
  <para style="p">
    <verse number="25" style="v"/>യിരൂശാലമ്പുരനിവാസീ ശിമിയോന്നാമാ ധാർമ്മിക ഏക ആസീത് സ ഇസ്രായേലഃ സാന്ത്വനാമപേക്ഷ്യ തസ്ഥൗ കിഞ്ച പവിത്ര ആത്മാ തസ്മിന്നാവിർഭൂതഃ|</para>
  <para style="p">
    <verse number="26" style="v"/>അപരം പ്രഭുണാ പരമേശ്വരേണാഭിഷിക്തേ ത്രാതരി ത്വയാ ന ദൃഷ്ടേ ത്വം ന മരിഷ്യസീതി വാക്യം പവിത്രേണ ആത്മനാ തസ്മ പ്രാകഥ്യത|</para>
  <para style="p">
    <verse number="27" style="v"/>അപരഞ്ച യദാ യീശോഃ പിതാ മാതാ ച തദർഥം വ്യവസ്ഥാനുരൂപം കർമ്മ കർത്തും തം മന്ദിരമ് ആനിന്യതുസ്തദാ</para>
  <para style="p">
    <verse number="28" style="v"/>ശിമിയോൻ ആത്മന ആകർഷണേന മന്ദിരമാഗത്യ തം ക്രോഡേ നിധായ ഈശ്വരസ്യ ധന്യവാദം കൃത്വാ കഥയാമാസ, യഥാ,</para>
  <para style="p">
    <verse number="29" style="v"/>ഹേ പ്രഭോ തവ ദാസോയം നിജവാക്യാനുസാരതഃ| ഇദാനീന്തു സകല്യാണോ ഭവതാ സംവിസൃജ്യതാമ്|</para>
  <para style="p">
    <verse number="30" style="v"/>യതഃ സകലദേശസ്യ ദീപ്തയേ ദീപ്തിരൂപകം|</para>
  <para style="p">
    <verse number="31" style="v"/>ഇസ്രായേലീയലോകസ്യ മഹാഗൗരവരൂപകം|</para>
  <para style="p">
    <verse number="32" style="v"/>യം ത്രായകം ജനാനാന്തു സമ്മുഖേ ത്വമജീജനഃ| സഏവ വിദ്യതേഽസ്മാകം ധ്രവം നയനനഗോചരേ||</para>
  <para style="p">
    <verse number="33" style="v"/>തദാനീം തേനോക്താ ഏതാഃ സകലാഃ കഥാഃ ശ്രുത്വാ തസ്യ മാതാ യൂഷഫ് ച വിസ്മയം മേനാതേ|</para>
  <para style="p">
    <verse number="34" style="v"/>തതഃ പരം ശിമിയോൻ തേഭ്യ ആശിഷം ദത്ത്വാ തന്മാതരം മരിയമമ് ഉവാച, പശ്യ ഇസ്രായേലോ വംശമധ്യേ ബഹൂനാം പാതനായോത്ഥാപനായ ച തഥാ വിരോധപാത്രം ഭവിതും, ബഹൂനാം ഗുപ്തമനോഗതാനാം പ്രകടീകരണായ ബാലകോയം നിയുക്തോസ്തി|</para>
  <para style="p">
    <verse number="35" style="v"/>തസ്മാത് തവാപി പ്രാണാഃ ശൂലേന വ്യത്സ്യന്തേ|</para>
  <para style="p">
    <verse number="36" style="v"/>അപരഞ്ച ആശേരസ്യ വംശീയഫിനൂയേലോ ദുഹിതാ ഹന്നാഖ്യാ അതിജരതീ ഭവിഷ്യദ്വാദിന്യേകാ യാ വിവാഹാത് പരം സപ്ത വത്സരാൻ പത്യാ സഹ ന്യവസത് തതോ വിധവാ ഭൂത്വാ ചതുരശീതിവർഷവയഃപര്യ്യനതം</para>
  <para style="p">
    <verse number="37" style="v"/>മന്ദിരേ സ്ഥിത്വാ പ്രാർഥനോപവാസൈർദിവാനിശമ് ഈശ്വരമ് അസേവത സാപി സ്ത്രീ തസ്മിൻ സമയേ മന്ദിരമാഗത്യ</para>
  <para style="p">
    <verse number="38" style="v"/>പരമേശ്വരസ്യ ധന്യവാദം ചകാര, യിരൂശാലമ്പുരവാസിനോ യാവന്തോ ലോകാ മുക്തിമപേക്ഷ്യ സ്ഥിതാസ്താൻ യീശോർവൃത്താന്തം ജ്ഞാപയാമാസ|</para>
  <para style="p">
    <verse number="39" style="v"/>ഇത്ഥം പരമേശ്വരസ്യ വ്യവസ്ഥാനുസാരേണ സർവ്വേഷു കർമ്മസു കൃതേഷു തൗ പുനശ്ച ഗാലീലോ നാസരത്നാമകം നിജനഗരം പ്രതസ്ഥാതേ|</para>
  <para style="p">
    <verse number="40" style="v"/>തത്പശ്ചാദ് ബാലകഃ ശരീരേണ വൃദ്ധിമേത്യ ജ്ഞാനേന പരിപൂർണ ആത്മനാ ശക്തിമാംശ്ച ഭവിതുമാരേഭേ തഥാ തസ്മിൻ ഈശ്വരാനുഗ്രഹോ ബഭൂവ|</para>
  <para style="p">
    <verse number="41" style="v"/>തസ്യ പിതാ മാതാ ച പ്രതിവർഷം നിസ്താരോത്സവസമയേ യിരൂശാലമമ് അഗച്ഛതാമ്|</para>
  <para style="p">
    <verse number="42" style="v"/>അപരഞ്ച യീശൗ ദ്വാദശവർഷവയസ്കേ സതി തൗ പർവ്വസമയസ്യ രീത്യനുസാരേണ യിരൂശാലമം ഗത്വാ</para>
  <para style="p">
    <verse number="43" style="v"/>പാർവ്വണം സമ്പാദ്യ പുനരപി വ്യാഘുയ്യ യാതഃ കിന്തു യീശുർബാലകോ യിരൂശാലമി തിഷ്ഠതി| യൂഷഫ് തന്മാതാ ച തദ് അവിദിത്വാ</para>
  <para style="p">
    <verse number="44" style="v"/>സ സങ്ഗിഭിഃ സഹ വിദ്യത ഏതച്ച ബുദ്വ്വാ ദിനൈകഗമ്യമാർഗം ജഗ്മതുഃ| കിന്തു ശേഷേ ജ്ഞാതിബന്ധൂനാം സമീപേ മൃഗയിത്വാ തദുദ്ദേेശമപ്രാപ്യ</para>
  <para style="p">
    <verse number="45" style="v"/>തൗ പുനരപി യിരൂശാലമമ് പരാവൃത്യാഗത്യ തം മൃഗയാഞ്ചക്രതുഃ|</para>
  <para style="p">
    <verse number="46" style="v"/>അഥ ദിനത്രയാത് പരം പണ്ഡിതാനാം മധ്യേ തേഷാം കഥാഃ ശൃണ്വൻ തത്ത്വം പൃച്ഛംശ്ച മന്ദിരേ സമുപവിഷ്ടഃ സ താഭ്യാം ദൃഷ്ടഃ|</para>
  <para style="p">
    <verse number="47" style="v"/>തദാ തസ്യ ബുദ്ധ്യാ പ്രത്യുത്തരൈശ്ച സർവ്വേ ശ്രോതാരോ വിസ്മയമാപദ്യന്തേ|</para>
  <para style="p">
    <verse number="48" style="v"/>താദൃശം ദൃഷ്ട്വാ തസ്യ ജനകോ ജനനീ ച ചമച്ചക്രതുഃ കിഞ്ച തസ്യ മാതാ തമവദത്, ഹേ പുത്ര, കഥമാവാം പ്രതീത്ഥം സമാചരസ്ത്വമ്? പശ്യ തവ പിതാഹഞ്ച ശോകാകുലൗ സന്തൗ ത്വാമന്വിച്ഛാവഃ സ്മ|</para>
  <para style="p">
    <verse number="49" style="v"/>തതഃ സോവദത് കുതോ മാമ് അന്വൈച്ഛതം? പിതുർഗൃഹേ മയാ സ്ഥാതവ്യമ് ഏതത് കിം യുവാഭ്യാം ന ജ്ഞായതേ?</para>
  <para style="p">
    <verse number="50" style="v"/>കിന്തു തൗ തസ്യൈതദ്വാക്യസ്യ താത്പര്യ്യം ബോദ്ധും നാശക്നുതാം|</para>
  <para style="p">
    <verse number="51" style="v"/>തതഃ പരം സ താഭ്യാം സഹ നാസരതം ഗത്വാ തയോർവശീഭൂതസ്തസ്ഥൗ കിന്തു സർവ്വാ ഏതാഃ കഥാസ്തസ്യ മാതാ മനസി സ്ഥാപയാമാസ|</para>
  <para style="p">
    <verse number="52" style="v"/>അഥ യീശോ ർബുദ്ധിഃ ശരീരഞ്ച തഥാ തസ്മിൻ ഈശ്വരസ്യ മാനവാനാഞ്ചാനുഗ്രഹോ വർദ്ധിതുമ് ആരേഭേ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അനന്തരം തിബിരിയകൈസരസ്യ രാജത്വസ്യ പഞ്ചദശേ വത്സരേ സതി യദാ പന്തീയപീലാതോ യിഹൂദാദേശാധിപതി ർഹേരോദ് തു ഗാലീൽപ്രദേശസ്യ രാജാ ഫിലിപനാമാ തസ്യ ഭ്രാതാ തു യിതൂരിയായാസ്ത്രാഖോനീതിയാപ്രദേശസ്യ ച രാജാസീത് ലുഷാനീയനാമാ അവിലീനീദേശസ്യ രാജാസീത്</para>
  <para style="p">
    <verse number="2" style="v"/>ഹാനൻ കിയഫാശ്ചേമൗ പ്രധാനയാജാകാവാസ്താം തദാനീം സിഖരിയസ്യ പുത്രായ യോഹനേ മധ്യേപ്രാന്തരമ് ഈശ്വരസ്യ വാക്യേ പ്രകാശിതേ സതി</para>
  <para style="p">
    <verse number="3" style="v"/>സ യർദ്ദന ഉഭയതടപ്രദേശാൻ സമേത്യ പാപമോചനാർഥം മനഃപരാവർത്തനസ്യ ചിഹ്നരൂപം യന്മജ്ജനം തദീയാഃ കഥാഃ സർവ്വത്ര പ്രചാരയിതുമാരേഭേ|</para>
  <para style="p">
    <verse number="4" style="v"/>യിശയിയഭവിഷ്യദ്വക്തൃഗ്രന്ഥേ യാദൃശീ ലിപിരാസ്തേ യഥാ, പരമേശസ്യ പന്ഥാനം പരിഷ്കുരുത സർവ്വതഃ| തസ്യ രാജപഥഞ്ചൈവ സമാനം കുരുതാധുനാ|</para>
  <para style="p">
    <verse number="5" style="v"/>കാരിഷ്യന്തേ സമുച്ഛ്രായാഃ സകലാ നിമ്നഭൂമയഃ| കാരിഷ്യന്തേ നതാഃ സർവ്വേ പർവ്വതാശ്ചോപപർവ്വതാഃ| കാരിഷ്യന്തേ ച യാ വക്രാസ്താഃ സർവ്വാഃ സരലാ ഭുവഃ| കാരിഷ്യന്തേ സമാനാസ്താ യാ ഉച്ചനീചഭൂമയഃ|</para>
  <para style="p">
    <verse number="6" style="v"/>ഈശ്വരേണ കൃതം ത്രാണം ദ്രക്ഷ്യന്തി സർവ്വമാനവാഃ| ഇത്യേതത് പ്രാന്തരേ വാക്യം വദതഃ കസ്യചിദ് രവഃ||</para>
  <para style="p">
    <verse number="7" style="v"/>യേ യേ ലോകാ മജ്ജനാർഥം ബഹിരായയുസ്താൻ സോവദത് രേ രേ സർപവംശാ ആഗാമിനഃ കോപാത് പലായിതും യുഷ്മാൻ കശ്ചേതയാമാസ?</para>
  <para style="p">
    <verse number="8" style="v"/>തസ്മാദ് ഇബ്രാഹീമ് അസ്മാകം പിതാ കഥാമീദൃശീം മനോഭി ർന കഥയിത്വാ യൂയം മനഃപരിവർത്തനയോഗ്യം ഫലം ഫലത; യുഷ്മാനഹം യഥാർഥം വദാമി പാഷാണേഭ്യ ഏതേഭ്യ ഈശ്വര ഇബ്രാഹീമഃ സന്താനോത്പാദനേ സമർഥഃ|</para>
  <para style="p">
    <verse number="9" style="v"/>അപരഞ്ച തരുമൂലേഽധുനാപി പരശുഃ സംലഗ്നോസ്തി യസ്തരുരുത്തമം ഫലം ന ഫലതി സ ഛിദ്യതേഽഗ്നൗ നിക്ഷിപ്യതേ ച|</para>
  <para style="p">
    <verse number="10" style="v"/>തദാനീം ലോകാസ്തം പപ്രച്ഛുസ്തർഹി കിം കർത്തവ്യമസ്മാഭിഃ?</para>
  <para style="p">
    <verse number="11" style="v"/>തതഃ സോവാദീത് യസ്യ ദ്വേ വസനേ വിദ്യേതേ സ വസ്ത്രഹീനായൈകം വിതരതു കിംഞ്ച യസ്യ ഖാദ്യദ്രവ്യം വിദ്യതേ സോപി തഥൈവ കരോതു|</para>
  <para style="p">
    <verse number="12" style="v"/>തതഃ പരം കരസഞ്ചായിനോ മജ്ജനാർഥമ് ആഗത്യ പപ്രച്ഛുഃ ഹേ ഗുരോ കിം കർത്തവ്യമസ്മാഭിഃ?</para>
  <para style="p">
    <verse number="13" style="v"/>തതഃ സോകഥയത് നിരൂപിതാദധികം ന ഗൃഹ്ലിത|</para>
  <para style="p">
    <verse number="14" style="v"/>അനന്തരം സേനാഗണ ഏത്യ പപ്രച്ഛ കിമസ്മാഭി ർവാ കർത്തവ്യമ്? തതഃ സോഭിദധേ കസ്യ കാമപി ഹാനിം മാ കാർഷ്ട തഥാ മൃഷാപവാദം മാ കുരുത നിജവേതനേന ച സന്തുഷ്യ തിഷ്ഠത|</para>
  <para style="p">
    <verse number="15" style="v"/>അപരഞ്ച ലോകാ അപേക്ഷയാ സ്ഥിത്വാ സർവ്വേപീതി മനോഭി ർവിതർകയാഞ്ചക്രുഃ, യോഹനയമ് അഭിഷിക്തസ്ത്രാതാ ന വേതി?</para>
  <para style="p">
    <verse number="16" style="v"/>തദാ യോഹൻ സർവ്വാൻ വ്യാജഹാര, ജലേഽഹം യുഷ്മാൻ മജ്ജയാമി സത്യം കിന്തു യസ്യ പാദുകാബന്ധനം മോചയിതുമപി ന യോഗ്യോസ്മി താദൃശ ഏകോ മത്തോ ഗുരുതരഃ പുമാൻ ഏതി, സ യുഷ്മാൻ വഹ്നിരൂപേ പവിത്ര ആത്മനി മജ്ജയിഷ്യതി|</para>
  <para style="p">
    <verse number="17" style="v"/>അപരഞ്ച തസ്യ ഹസ്തേ ശൂർപ ആസ്തേ സ സ്വശസ്യാനി ശുദ്ധരൂപം പ്രസ്ഫോട്യ ഗോധൂമാൻ സർവ്വാൻ ഭാണ്ഡാഗാരേ സംഗ്രഹീഷ്യതി കിന്തു ബൂഷാണി സർവ്വാണ്യനിർവ്വാണവഹ്നിനാ ദാഹയിഷ്യതി|</para>
  <para style="p">
    <verse number="18" style="v"/>യോഹൻ ഉപദേശേനേത്ഥം നാനാകഥാ ലോകാനാം സമക്ഷം പ്രചാരയാമാസ|</para>
  <para style="p">
    <verse number="19" style="v"/>അപരഞ്ച ഹേരോദ് രാജാ ഫിലിപ്നാമ്നഃ സഹോദരസ്യ ഭാര്യ്യാം ഹേരോദിയാമധി തഥാന്യാനി യാനി യാനി കുകർമ്മാണി കൃതവാൻ തദധി ച</para>
  <para style="p">
    <verse number="20" style="v"/>യോഹനാ തിരസ്കൃതോ ഭൂത്വാ കാരാഗാരേ തസ്യ ബന്ധനാദ് അപരമപി കുകർമ്മ ചകാര|</para>
  <para style="p">
    <verse number="21" style="v"/>ഇതഃ പൂർവ്വം യസ്മിൻ സമയേ സർവ്വേ യോഹനാ മജ്ജിതാസ്തദാനീം യീശുരപ്യാഗത്യ മജ്ജിതഃ|</para>
  <para style="p">
    <verse number="22" style="v"/>തദനന്തരം തേന പ്രാർഥിതേ മേഘദ്വാരം മുക്തം തസ്മാച്ച പവിത്ര ആത്മാ മൂർത്തിമാൻ ഭൂത്വാ കപോതവത് തദുപര്യ്യവരുരോഹ; തദാ ത്വം മമ പ്രിയഃ പുത്രസ്ത്വയി മമ പരമഃ സന്തോഷ ഇത്യാകാശവാണീ ബഭൂവ|</para>
  <para style="p">
    <verse number="23" style="v"/>തദാനീം യീശുഃ പ്രായേണ ത്രിംശദ്വർഷവയസ്ക ആസീത്| ലൗകികജ്ഞാനേ തു സ യൂഷഫഃ പുത്രഃ,</para>
  <para style="p">
    <verse number="24" style="v"/>യൂഷഫ് ഏലേഃ പുത്രഃ, ഏലിർമത്തതഃ പുത്രഃ, മത്തത് ലേവേഃ പുത്രഃ, ലേവി ർമൽകേഃ പുത്രഃ, മൽകിര്യാന്നസ്യ പുത്രഃ; യാന്നോ യൂഷഫഃ പുത്രഃ|</para>
  <para style="p">
    <verse number="25" style="v"/>യൂഷഫ് മത്തഥിയസ്യ പുത്രഃ, മത്തഥിയ ആമോസഃ പുത്രഃ, ആമോസ് നഹൂമഃ പുത്രഃ, നഹൂമ് ഇഷ്ലേഃ പുത്രഃ ഇഷ്ലിർനഗേഃ പുത്രഃ|</para>
  <para style="p">
    <verse number="26" style="v"/>നഗിർമാടഃ പുത്രഃ, മാട് മത്തഥിയസ്യ പുത്രഃ, മത്തഥിയഃ ശിമിയേഃ പുത്രഃ, ശിമിയിര്യൂഷഫഃ പുത്രഃ, യൂഷഫ് യിഹൂദാഃ പുത്രഃ|</para>
  <para style="p">
    <verse number="27" style="v"/>യിഹൂദാ യോഹാനാഃ പുത്രഃ, യോഹാനാ രീഷാഃ പുത്രഃ, രീഷാഃ സിരുബ്ബാബിലഃ പുത്രഃ, സിരുബ്ബാബിൽ ശൽതീയേലഃ പുത്രഃ, ശൽതീയേൽ നേരേഃ പുത്രഃ|</para>
  <para style="p">
    <verse number="28" style="v"/>നേരിർമൽകേഃ പുത്രഃ, മൽകിഃ അദ്യഃ പുത്രഃ, അദ്ദീ കോഷമഃ പുത്രഃ, കോഷമ് ഇൽമോദദഃ പുത്രഃ, ഇൽമോദദ് ഏരഃ പുത്രഃ|</para>
  <para style="p">
    <verse number="29" style="v"/>ഏർ യോശേഃ പുത്രഃ, യോശിഃ ഇലീയേഷരഃ പുത്രഃ, ഇലീയേഷർ യോരീമഃ പുത്രഃ, യോരീമ് മത്തതഃ പുത്രഃ, മത്തത ലേവേഃ പുത്രഃ|</para>
  <para style="p">
    <verse number="30" style="v"/>ലേവിഃ ശിമിയോനഃ പുത്രഃ, ശിമിയോൻ യിഹൂദാഃ പുത്രഃ, യിഹൂദാ യൂഷുഫഃ പുത്രഃ, യൂഷുഫ് യോനനഃ പുത്രഃ, യാനൻ ഇലീയാകീമഃ പുത്രഃ|</para>
  <para style="p">
    <verse number="31" style="v"/>ഇലിയാകീമ്ഃ മിലേയാഃ പുത്രഃ, മിലേയാ മൈനനഃ പുത്രഃ, മൈനൻ മത്തത്തസ്യ പുത്രഃ, മത്തത്തോ നാഥനഃ പുത്രഃ, നാഥൻ ദായൂദഃ പുത്രഃ|</para>
  <para style="p">
    <verse number="32" style="v"/>ദായൂദ് യിശയഃ പുത്രഃ, യിശയ ഓബേദഃ പുത്ര, ഓബേദ് ബോയസഃ പുത്രഃ, ബോയസ് സൽമോനഃ പുത്രഃ, സൽമോൻ നഹശോനഃ പുത്രഃ|</para>
  <para style="p">
    <verse number="33" style="v"/>നഹശോൻ അമ്മീനാദബഃ പുത്രഃ, അമ്മീനാദബ് അരാമഃ പുത്രഃ, അരാമ് ഹിഷ്രോണഃ പുത്രഃ, ഹിഷ്രോൺ പേരസഃ പുത്രഃ, പേരസ് യിഹൂദാഃ പുത്രഃ|</para>
  <para style="p">
    <verse number="34" style="v"/>യിഹൂദാ യാകൂബഃ പുത്രഃ, യാകൂബ് ഇസ്ഹാകഃ പുത്രഃ, ഇസ്ഹാക് ഇബ്രാഹീമഃ പുത്രഃ, ഇബ്രാഹീമ് തേരഹഃ പുത്രഃ, തേരഹ് നാഹോരഃ പുത്രഃ|</para>
  <para style="p">
    <verse number="35" style="v"/>നാഹോർ സിരുഗഃ പുത്രഃ, സിരുഗ് രിയ്വഃ പുത്രഃ, രിയൂഃ പേലഗഃ പുത്രഃ, പേലഗ് ഏവരഃ പുത്രഃ, ഏവർ ശേലഹഃ പുത്രഃ|</para>
  <para style="p">
    <verse number="36" style="v"/>ശേലഹ് കൈനനഃ പുത്രഃ, കൈനൻ അർഫക്ഷദഃ പുത്രഃ, അർഫക്ഷദ് ശാമഃ പുത്രഃ, ശാമ് നോഹഃ പുത്രഃ, നോഹോ ലേമകഃ പുത്രഃ|</para>
  <para style="p">
    <verse number="37" style="v"/>ലേമക് മിഥൂശേലഹഃ പുത്രഃ, മിഥൂശേലഹ് ഹനോകഃ പുത്രഃ, ഹനോക് യേരദഃ പുത്രഃ, യേരദ് മഹലലേലഃ പുത്രഃ, മഹലലേൽ കൈനനഃ പുത്രഃ|</para>
  <para style="p">
    <verse number="38" style="v"/>കൈനൻ ഇനോശഃ പുത്രഃ, ഇനോശ് ശേതഃ പുത്രഃ, ശേത് ആദമഃ പുത്ര, ആദമ് ഈശ്വരസ്യ പുത്രഃ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>തതഃ പരം യീശുഃ പവിത്രേണാത്മനാ പൂർണഃ സൻ യർദ്ദനനദ്യാഃ പരാവൃത്യാത്മനാ പ്രാന്തരം നീതഃ സൻ ചത്വാരിംശദ്ദിനാനി യാവത് ശൈതാനാ പരീക്ഷിതോഽഭൂത്,</para>
  <para style="p">
    <verse number="2" style="v"/>കിഞ്ച താനി സർവ്വദിനാനി ഭോജനം വിനാ സ്ഥിതത്വാത് കാലേ പൂർണേ സ ക്ഷുധിതവാൻ|</para>
  <para style="p">
    <verse number="3" style="v"/>തതഃ ശൈതാനാഗത്യ തമവദത് ത്വം ചേദീശ്വരസ്യ പുത്രസ്തർഹി പ്രസ്തരാനേതാൻ ആജ്ഞയാ പൂപാൻ കുരു|</para>
  <para style="p">
    <verse number="4" style="v"/>തദാ യീശുരുവാച, ലിപിരീദൃശീ വിദ്യതേ മനുജഃ കേവലേന പൂപേന ന ജീവതി കിന്ത്വീശ്വരസ്യ സർവ്വാഭിരാജ്ഞാഭി ർജീവതി|</para>
  <para style="p">
    <verse number="5" style="v"/>തദാ ശൈതാൻ തമുച്ചം പർവ്വതം നീത്വാ നിമിഷൈകമധ്യേ ജഗതഃ സർവ്വരാജ്യാനി ദർശിതവാൻ|</para>
  <para style="p">
    <verse number="6" style="v"/>പശ്ചാത് തമവാദീത് സർവ്വമ് ഏതദ് വിഭവം പ്രതാപഞ്ച തുഭ്യം ദാസ്യാമി തൻ മയി സമർപിതമാസ്തേ യം പ്രതി മമേച്ഛാ ജായതേ തസ്മൈ ദാതും ശക്നോമി,</para>
  <para style="p">
    <verse number="7" style="v"/>ത്വം ചേന്മാം ഭജസേ തർഹി സർവ്വമേതത് തവൈവ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="8" style="v"/>തദാ യീശുസ്തം പ്രത്യുക്തവാൻ ദൂരീ ഭവ ശൈതാൻ ലിപിരാസ്തേ, നിജം പ്രഭും പരമേശ്വരം ഭജസ്വ കേവലം തമേവ സേവസ്വ ച|</para>
  <para style="p">
    <verse number="9" style="v"/>അഥ ശൈതാൻ തം യിരൂശാലമം നീത്വാ മന്ദിരസ്യ ചൂഡായാ ഉപരി സമുപവേശ്യ ജഗാദ ത്വം ചേദീശ്വരസ്യ പുത്രസ്തർഹി സ്ഥാനാദിതോ ലമ്ഫിത്വാധഃ</para>
  <para style="p">
    <verse number="10" style="v"/>പത യതോ ലിപിരാസ്തേ, ആജ്ഞാപയിഷ്യതി സ്വീയാൻ ദൂതാൻ സ പരമേശ്വരഃ|</para>
  <para style="p">
    <verse number="11" style="v"/>രക്ഷിതും സർവ്വമാർഗേ ത്വാം തേന ത്വച്ചരണേ യഥാ| ന ലഗേത് പ്രസ്തരാഘാതസ്ത്വാം ധരിഷ്യന്തി തേ തഥാ|</para>
  <para style="p">
    <verse number="12" style="v"/>തദാ യീശുനാ പ്രത്യുക്തമ് ഇദമപ്യുക്തമസ്തി ത്വം സ്വപ്രഭും പരേശം മാ പരീക്ഷസ്വ|</para>
  <para style="p">
    <verse number="13" style="v"/>പശ്ചാത് ശൈതാൻ സർവ്വപരീക്ഷാം സമാപ്യ ക്ഷണാത്തം ത്യക്ത്വാ യയൗ|</para>
  <para style="p">
    <verse number="14" style="v"/>തദാ യീശുരാത്മപ്രഭാവാത് പുനർഗാലീൽപ്രദേശം ഗതസ്തദാ തത്സുഖ്യാതിശ്ചതുർദിശം വ്യാനശേ|</para>
  <para style="p">
    <verse number="15" style="v"/>സ തേഷാം ഭജനഗൃഹേഷു ഉപദിശ്യ സർവ്വൈഃ പ്രശംസിതോ ബഭൂവ|</para>
  <para style="p">
    <verse number="16" style="v"/>അഥ സ സ്വപാലനസ്ഥാനം നാസരത്പുരമേത്യ വിശ്രാമവാരേ സ്വാചാരാദ് ഭജനഗേഹം പ്രവിശ്യ പഠിതുമുത്തസ്ഥൗ|</para>
  <para style="p">
    <verse number="17" style="v"/>തതോ യിശയിയഭവിഷ്യദ്വാദിനഃ പുസ്തകേ തസ്യ കരദത്തേ സതി സ തത് പുസ്തകം വിസ്താര്യ്യ യത്ര വക്ഷ്യമാണാനി വചനാനി സന്തി തത് സ്ഥാനം പ്രാപ്യ പപാഠ|</para>
  <para style="p">
    <verse number="18" style="v"/>ആത്മാ തു പരമേശസ്യ മദീയോപരി വിദ്യതേ| ദരിദ്രേഷു സുസംവാദം വക്തും മാം സോഭിഷിക്തവാൻ| ഭഗ്നാന്തഃ കരണാല്ലോകാൻ സുസ്വസ്ഥാൻ കർത്തുമേവ ച| ബന്ദീകൃതേഷു ലോകേഷു മുക്തേ ർഘോഷയിതും വചഃ| നേത്രാണി ദാതുമന്ധേഭ്യസ്ത്രാതും ബദ്ധജനാനപി|</para>
  <para style="p">
    <verse number="19" style="v"/>പരേശാനുഗ്രഹേ കാലം പ്രചാരയിതുമേവ ച| സർവ്വൈതത്കരണാർഥായ മാമേവ പ്രഹിണോതി സഃ||</para>
  <para style="p">
    <verse number="20" style="v"/>തതഃ പുസ്തകം ബദ്വ്വാ പരിചാരകസ്യ ഹസ്തേ സമർപ്യ ചാസനേ സമുപവിഷ്ടഃ, തതോ ഭജനഗൃഹേ യാവന്തോ ലോകാ ആസൻ തേ സർവ്വേഽനന്യദൃഷ്ട്യാ തം വിലുലോകിരേ|</para>
  <para style="p">
    <verse number="21" style="v"/>അനന്തരമ് അദ്യൈതാനി സർവ്വാണി ലിഖിതവചനാനി യുഷ്മാകം മധ്യേ സിദ്ധാനി സ ഇമാം കഥാം തേഭ്യഃ കഥയിതുമാരേഭേ|</para>
  <para style="p">
    <verse number="22" style="v"/>തതഃ സർവ്വേ തസ്മിൻ അന്വരജ്യന്ത, കിഞ്ച തസ്യ മുഖാന്നിർഗതാഭിരനുഗ്രഹസ്യ കഥാഭിശ്ചമത്കൃത്യ കഥയാമാസുഃ കിമയം യൂഷഫഃ പുത്രോ ന?</para>
  <para style="p">
    <verse number="23" style="v"/>തദാ സോഽവാദീദ് ഹേ ചികിത്സക സ്വമേവ സ്വസ്ഥം കുരു കഫർനാഹൂമി യദ്യത് കൃതവാൻ തദശ്രൗഷ്മ താഃ സർവാഃ ക്രിയാ അത്ര സ്വദേശേ കുരു കഥാമേതാം യൂയമേവാവശ്യം മാം വദിഷ്യഥ|</para>
  <para style="p">
    <verse number="24" style="v"/>പുനഃ സോവാദീദ് യുഷ്മാനഹം യഥാർഥം വദാമി, കോപി ഭവിഷ്യദ്വാദീ സ്വദേശേ സത്കാരം ന പ്രാപ്നോതി|</para>
  <para style="p">
    <verse number="25" style="v"/>അപരഞ്ച യഥാർഥം വച്മി, ഏലിയസ്യ ജീവനകാലേ യദാ സാർദ്ധത്രിതയവർഷാണി യാവത് ജലദപ്രതിബന്ധാത് സർവ്വസ്മിൻ ദേശേ മഹാദുർഭിക്ഷമ് അജനിഷ്ട തദാനീമ് ഇസ്രായേലോ ദേശസ്യ മധ്യേ ബഹ്വ്യോ വിധവാ ആസൻ,</para>
  <para style="p">
    <verse number="26" style="v"/>കിന്തു സീദോൻപ്രദേശീയസാരിഫത്പുരനിവാസിനീമ് ഏകാം വിധവാം വിനാ കസ്യാശ്ചിദപി സമീപേ ഏലിയഃ പ്രേരിതോ നാഭൂത്|</para>
  <para style="p">
    <verse number="27" style="v"/>അപരഞ്ച ഇലീശായഭവിഷ്യദ്വാദിവിദ്യമാനതാകാലേ ഇസ്രായേൽദേശേ ബഹവഃ കുഷ്ഠിന ആസൻ കിന്തു സുരീയദേശീയം നാമാൻകുഷ്ഠിനം വിനാ കോപ്യന്യഃ പരിഷ്കൃതോ നാഭൂത്|</para>
  <para style="p">
    <verse number="28" style="v"/>ഇമാം കഥാം ശ്രുത്വാ ഭജനഗേഹസ്ഥിതാ ലോകാഃ സക്രോധമ് ഉത്ഥായ</para>
  <para style="p">
    <verse number="29" style="v"/>നഗരാത്തം ബഹിഷ്കൃത്യ യസ്യ ശിഖരിണ ഉപരി തേഷാം നഗരം സ്ഥാപിതമാസ്തേ തസ്മാന്നിക്ഷേപ്തും തസ്യ ശിഖരം തം നിന്യുഃ</para>
  <para style="p">
    <verse number="30" style="v"/>കിന്തു സ തേഷാം മധ്യാദപസൃത്യ സ്ഥാനാന്തരം ജഗാമ|</para>
  <para style="p">
    <verse number="31" style="v"/>തതഃ പരം യീശുർഗാലീൽപ്രദേശീയകഫർനാഹൂമ്നഗര ഉപസ്ഥായ വിശ്രാമവാരേ ലോകാനുപദേഷ്ടുമ് ആരബ്ധവാൻ|</para>
  <para style="p">
    <verse number="32" style="v"/>തദുപദേശാത് സർവ്വേ ചമച്ചക്രു ര്യതസ്തസ്യ കഥാ ഗുരുതരാ ആസൻ|</para>
  <para style="p">
    <verse number="33" style="v"/>തദാനീം തദ്ഭജനഗേഹസ്ഥിതോഽമേധ്യഭൂതഗ്രസ്ത ഏകോ ജന ഉച്ചൈഃ കഥയാമാസ,</para>
  <para style="p">
    <verse number="34" style="v"/>ഹേ നാസരതീയയീശോഽസ്മാൻ ത്യജ, ത്വയാ സഹാസ്മാകം കഃ സമ്ബന്ധഃ? കിമസ്മാൻ വിനാശയിതുമായാസി? ത്വമീശ്വരസ്യ പവിത്രോ ജന ഏതദഹം ജാനാമി|</para>
  <para style="p">
    <verse number="35" style="v"/>തദാ യീശുസ്തം തർജയിത്വാവദത് മൗനീ ഭവ ഇതോ ബഹിർഭവ; തതഃ സോമേധ്യഭൂതസ്തം മധ്യസ്ഥാനേ പാതയിത്വാ കിഞ്ചിദപ്യഹിംസിത്വാ തസ്മാദ് ബഹിർഗതവാൻ|</para>
  <para style="p">
    <verse number="36" style="v"/>തതഃ സർവ്വേ ലോകാശ്ചമത്കൃത്യ പരസ്പരം വക്തുമാരേഭിരേ കോയം ചമത്കാരഃ| ഏഷ പ്രഭാവേണ പരാക്രമേണ ചാമേധ്യഭൂതാൻ ആജ്ഞാപയതി തേനൈവ തേ ബഹിർഗച്ഛന്തി|</para>
  <para style="p">
    <verse number="37" style="v"/>അനന്തരം ചതുർദിക്സ്ഥദേശാൻ തസ്യ സുഖ്യാതിർവ്യാപ്നോത്|</para>
  <para style="p">
    <verse number="38" style="v"/>തദനന്തരം സ ഭജനഗേഹാദ് ബഹിരാഗത്യ ശിമോനോ നിവേശനം പ്രവിവേശ തദാ തസ്യ ശ്വശ്രൂർജ്വരേണാത്യന്തം പീഡിതാസീത് ശിഷ്യാസ്തദർഥം തസ്മിൻ വിനയം ചക്രുഃ|</para>
  <para style="p">
    <verse number="39" style="v"/>തതഃ സ തസ്യാഃ സമീപേ സ്ഥിത്വാ ജ്വരം തർജയാമാസ തേനൈവ താം ജ്വരോഽത്യാക്ഷീത് തതഃ സാ തത്ക്ഷണമ് ഉത്ഥായ താൻ സിഷേവേ|</para>
  <para style="p">
    <verse number="40" style="v"/>അഥ സൂര്യ്യാസ്തകാലേ സ്വേഷാം യേ യേ ജനാ നാനാരോഗൈഃ പീഡിതാ ആസൻ ലോകാസ്താൻ യീശോഃ സമീപമ് ആനിന്യുഃ, തദാ സ ഏകൈകസ്യ ഗാത്രേ കരമർപയിത്വാ താനരോഗാൻ ചകാര|</para>
  <para style="p">
    <verse number="41" style="v"/>തതോ ഭൂതാ ബഹുഭ്യോ നിർഗത്യ ചീത്ശബ്ദം കൃത്വാ ച ബഭാഷിരേ ത്വമീശ്വരസ്യ പുത്രോഽഭിഷിക്തത്രാതാ; കിന്തു സോഭിഷിക്തത്രാതേതി തേ വിവിദുരേതസ്മാത് കാരണാത് താൻ തർജയിത്വാ തദ്വക്തും നിഷിഷേധ|</para>
  <para style="p">
    <verse number="42" style="v"/>അപരഞ്ച പ്രഭാതേ സതി സ വിജനസ്ഥാനം പ്രതസ്ഥേ പശ്ചാത് ജനാസ്തമന്വിച്ഛന്തസ്തന്നികടം ഗത്വാ സ്ഥാനാന്തരഗമനാർഥം തമന്വരുന്ധൻ|</para>
  <para style="p">
    <verse number="43" style="v"/>കിന്തു സ താൻ ജഗാദ, ഈശ്വരീയരാജ്യസ്യ സുസംവാദം പ്രചാരയിതുമ് അന്യാനി പുരാണ്യപി മയാ യാതവ്യാനി യതസ്തദർഥമേവ പ്രേരിതോഹം|</para>
  <para style="p">
    <verse number="44" style="v"/>അഥ ഗാലീലോ ഭജനഗേഹേഷു സ ഉപദിദേശ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അനന്തരം യീശുരേകദാ ഗിനേഷരഥ്ദസ്യ തീര ഉത്തിഷ്ഠതി, തദാ ലോകാ ഈശ്വരീയകഥാം ശ്രോതും തദുപരി പ്രപതിതാഃ|</para>
  <para style="p">
    <verse number="2" style="v"/>തദാനീം സ ഹ്ദസ്യ തീരസമീപേ നൗദ്വയം ദദർശ കിഞ്ച മത്സ്യോപജീവിനോ നാവം വിഹായ ജാലം പ്രക്ഷാലയന്തി|</para>
  <para style="p">
    <verse number="3" style="v"/>തതസ്തയോർദ്വയോ ർമധ്യേ ശിമോനോ നാവമാരുഹ്യ തീരാത് കിഞ്ചിദ്ദൂരം യാതും തസ്മിൻ വിനയം കൃത്വാ നൗകായാമുപവിശ്യ ലോകാൻ പ്രോപദിഷ്ടവാൻ|</para>
  <para style="p">
    <verse number="4" style="v"/>പശ്ചാത് തം പ്രസ്താവം സമാപ്യ സ ശിമോനം വ്യാജഹാര, ഗഭീരം ജലം ഗത്വാ മത്സ്യാൻ ധർത്തും ജാലം നിക്ഷിപ|</para>
  <para style="p">
    <verse number="5" style="v"/>തതഃ ശിമോന ബഭാഷേ, ഹേ ഗുരോ യദ്യപി വയം കൃത്സ്നാം യാമിനീം പരിശ്രമ്യ മത്സ്യൈകമപി ന പ്രാപ്താസ്തഥാപി ഭവതോ നിദേശതോ ജാലം ക്ഷിപാമഃ|</para>
  <para style="p">
    <verse number="6" style="v"/>അഥ ജാലേ ക്ഷിപ്തേ ബഹുമത്സ്യപതനാദ് ആനായഃ പ്രച്ഛിന്നഃ|</para>
  <para style="p">
    <verse number="7" style="v"/>തസ്മാദ് ഉപകർത്തുമ് അന്യനൗസ്ഥാൻ സങ്ഗിന ആയാതുമ് ഇങ്ഗിതേന സമാഹ്വയൻ തതസ്ത ആഗത്യ മത്സ്യൈ ർനൗദ്വയം പ്രപൂരയാമാസു ര്യൈ ർനൗദ്വയം പ്രമഗ്നമ്|</para>
  <para style="p">
    <verse number="8" style="v"/>തദാ ശിമോൻപിതരസ്തദ് വിലോക്യ യീശോശ്ചരണയോഃ പതിത്വാ, ഹേ പ്രഭോഹം പാപീ നരോ മമ നികടാദ് ഭവാൻ യാതു, ഇതി കഥിതവാൻ|</para>
  <para style="p">
    <verse number="9" style="v"/>യതോ ജാലേ പതിതാനാം മത്സ്യാനാം യൂഥാത് ശിമോൻ തത്സങ്ഗിനശ്ച ചമത്കൃതവന്തഃ; ശിമോനഃ സഹകാരിണൗ സിവദേഃ പുത്രൗ യാകൂബ് യോഹൻ ചേമൗ താദൃശൗ ബഭൂവതുഃ|</para>
  <para style="p">
    <verse number="10" style="v"/>തദാ യീശുഃ ശിമോനം ജഗാദ മാ ഭൈഷീരദ്യാരഭ്യ ത്വം മനുഷ്യധരോ ഭവിഷ്യസി|</para>
  <para style="p">
    <verse number="11" style="v"/>അനന്തരം സർവ്വാസു നൗസു തീരമ് ആനീതാസു തേ സർവ്വാൻ പരിത്യജ്യ തസ്യ പശ്ചാദ്ഗാമിനോ ബഭൂവുഃ|</para>
  <para style="p">
    <verse number="12" style="v"/>തതഃ പരം യീശൗ കസ്മിംശ്ചിത് പുരേ തിഷ്ഠതി ജന ഏകഃ സർവ്വാങ്ഗകുഷ്ഠസ്തം വിലോക്യ തസ്യ സമീപേ ന്യുബ്ജഃ പതിത്വാ സവിനയം വക്തുമാരേഭേ, ഹേ പ്രഭോ യദി ഭവാനിച്ഛതി തർഹി മാം പരിഷ്കർത്തും ശക്നോതി|</para>
  <para style="p">
    <verse number="13" style="v"/>തദാനീം സ പാണിം പ്രസാര്യ്യ തദങ്ഗം സ്പൃശൻ ബഭാഷേ ത്വം പരിഷ്ക്രിയസ്വേതി മമേച്ഛാസ്തി തതസ്തത്ക്ഷണം സ കുഷ്ഠാത് മുക്തഃ|</para>
  <para style="p">
    <verse number="14" style="v"/>പശ്ചാത് സ തമാജ്ഞാപയാമാസ കഥാമിമാം കസ്മൈചിദ് അകഥയിത്വാ യാജകസ്യ സമീപഞ്ച ഗത്വാ സ്വം ദർശയ, ലോകേഭ്യോ നിജപരിഷ്കൃതത്വസ്യ പ്രമാണദാനായ മൂസാജ്ഞാനുസാരേണ ദ്രവ്യമുത്മൃജസ്വ ച|</para>
  <para style="p">
    <verse number="15" style="v"/>തഥാപി യീശോഃ സുഖ്യാതി ർബഹു വ്യാപ്തുമാരേഭേ കിഞ്ച തസ്യ കഥാം ശ്രോതും സ്വീയരോഗേഭ്യോ മോക്തുഞ്ച ലോകാ ആജഗ്മുഃ|</para>
  <para style="p">
    <verse number="16" style="v"/>അഥ സ പ്രാന്തരം ഗത്വാ പ്രാർഥയാഞ്ചക്രേ|</para>
  <para style="p">
    <verse number="17" style="v"/>അപരഞ്ച ഏകദാ യീശുരുപദിശതി, ഏതർഹി ഗാലീല്യിഹൂദാപ്രദേശയോഃ സർവ്വനഗരേഭ്യോ യിരൂശാലമശ്ച കിയന്തഃ ഫിരൂശിലോകാ വ്യവസ്ഥാപകാശ്ച സമാഗത്യ തദന്തികേ സമുപവിവിശുഃ, തസ്മിൻ കാലേ ലോകാനാമാരോഗ്യകാരണാത് പ്രഭോഃ പ്രഭാവഃ പ്രചകാശേ|</para>
  <para style="p">
    <verse number="18" style="v"/>പശ്ചാത് കിയന്തോ ലോകാ ഏകം പക്ഷാഘാതിനം ഖട്വായാം നിധായ യീശോഃ സമീപമാനേതും സമ്മുഖേ സ്ഥാപയിതുഞ്ച വ്യാപ്രിയന്ത|</para>
  <para style="p">
    <verse number="19" style="v"/>കിന്തു ബഹുജനനിവഹസമ്വാധാത് ന ശക്നുവന്തോ ഗൃഹോപരി ഗത്വാ ഗൃഹപൃഷ്ഠം ഖനിത്വാ തം പക്ഷാഘാതിനം സഖട്വം ഗൃഹമധ്യേ യീശോഃ സമ്മുഖേ ഽവരോഹയാമാസുഃ|</para>
  <para style="p">
    <verse number="20" style="v"/>തദാ യീശുസ്തേഷാമ് ഈദൃശം വിശ്വാസം വിലോക്യ തം പക്ഷാഘാതിനം വ്യാജഹാര, ഹേ മാനവ തവ പാപമക്ഷമ്യത|</para>
  <para style="p">
    <verse number="21" style="v"/>തസ്മാദ് അധ്യാപകാഃ ഫിരൂശിനശ്ച ചിത്തൈരിത്ഥം പ്രചിന്തിതവന്തഃ, ഏഷ ജന ഈശ്വരം നിന്ദതി കോയം? കേവലമീശ്വരം വിനാ പാപം ക്ഷന്തും കഃ ശക്നോതി?</para>
  <para style="p">
    <verse number="22" style="v"/>തദാ യീശുസ്തേഷാമ് ഇത്ഥം ചിന്തനം വിദിത്വാ തേഭ്യോകഥയദ് യൂയം മനോഭിഃ കുതോ വിതർകയഥ?</para>
  <para style="p">
    <verse number="23" style="v"/>തവ പാപക്ഷമാ ജാതാ യദ്വാ ത്വമുത്ഥായ വ്രജ ഏതയോ ർമധ്യേ കാ കഥാ സുകഥ്യാ?</para>
  <para style="p">
    <verse number="24" style="v"/>കിന്തു പൃഥിവ്യാം പാപം ക്ഷന്തും മാനവസുതസ്യ സാമർഥ്യമസ്തീതി യഥാ യൂയം ജ്ഞാതും ശക്നുഥ തദർഥം (സ തം പക്ഷാഘാതിനം ജഗാദ) ഉത്തിഷ്ഠ സ്വശയ്യാം ഗൃഹീത്വാ ഗൃഹം യാഹീതി ത്വാമാദിശാമി|</para>
  <para style="p">
    <verse number="25" style="v"/>തസ്മാത് സ തത്ക്ഷണമ് ഉത്ഥായ സർവ്വേഷാം സാക്ഷാത് നിജശയനീയം ഗൃഹീത്വാ ഈശ്വരം ധന്യം വദൻ നിജനിവേശനം യയൗ|</para>
  <para style="p">
    <verse number="26" style="v"/>തസ്മാത് സർവ്വേ വിസ്മയ പ്രാപ്താ മനഃസു ഭീതാശ്ച വയമദ്യാസമ്ഭവകാര്യ്യാണ്യദർശാമ ഇത്യുക്ത്വാ പരമേശ്വരം ധന്യം പ്രോദിതാഃ|</para>
  <para style="p">
    <verse number="27" style="v"/>തതഃ പരം ബഹിർഗച്ഛൻ കരസഞ്ചയസ്ഥാനേ ലേവിനാമാനം കരസഞ്ചായകം ദൃഷ്ട്വാ യീശുസ്തമഭിദധേ മമ പശ്ചാദേഹി|</para>
  <para style="p">
    <verse number="28" style="v"/>തസ്മാത് സ തത്ക്ഷണാത് സർവ്വം പരിത്യജ്യ തസ്യ പശ്ചാദിയായ|</para>
  <para style="p">
    <verse number="29" style="v"/>അനന്തരം ലേവി ർനിജഗൃഹേ തദർഥം മഹാഭോജ്യം ചകാര, തദാ തൈഃ സഹാനേകേ കരസഞ്ചായിനസ്തദന്യലോകാശ്ച ഭോക്തുമുപവിവിശുഃ|</para>
  <para style="p">
    <verse number="30" style="v"/>തസ്മാത് കാരണാത് ചണ്ഡാലാനാം പാപിലോകാനാഞ്ച സങ്ഗേ യൂയം കുതോ ഭംഗ്ധ്വേ പിവഥ ചേതി കഥാം കഥയിത്വാ ഫിരൂശിനോഽധ്യാപകാശ്ച തസ്യ ശിഷ്യൈഃ സഹ വാഗ്യുദ്ധം കർത്തുമാരേഭിരേ|</para>
  <para style="p">
    <verse number="31" style="v"/>തസ്മാദ് യീശുസ്താൻ പ്രത്യവോചദ് അരോഗലോകാനാം ചികിത്സകേന പ്രയോജനം നാസ്തി കിന്തു സരോഗാണാമേവ|</para>
  <para style="p">
    <verse number="32" style="v"/>അഹം ധാർമ്മികാൻ ആഹ്വാതും നാഗതോസ്മി കിന്തു മനഃ പരാവർത്തയിതും പാപിന ഏവ|</para>
  <para style="p">
    <verse number="33" style="v"/>തതസ്തേ പ്രോചുഃ, യോഹനഃ ഫിരൂശിനാഞ്ച ശിഷ്യാ വാരംവാരമ് ഉപവസന്തി പ്രാർഥയന്തേ ച കിന്തു തവ ശിഷ്യാഃ കുതോ ഭുഞ്ജതേ പിവന്തി ച?</para>
  <para style="p">
    <verse number="34" style="v"/>തദാ സ താനാചഖ്യൗ വരേ സങ്ഗേ തിഷ്ഠതി വരസ്യ സഖിഗണം കിമുപവാസയിതും ശക്നുഥ?</para>
  <para style="p">
    <verse number="35" style="v"/>കിന്തു യദാ തേഷാം നികടാദ് വരോ നേഷ്യതേ തദാ തേ സമുപവത്സ്യന്തി|</para>
  <para style="p">
    <verse number="36" style="v"/>സോപരമപി ദൃഷ്ടാന്തം കഥയാമ്ബഭൂവ പുരാതനവസ്ത്രേ കോപി നുതനവസ്ത്രം ന സീവ്യതി യതസ്തേന സേവനേന ജീർണവസ്ത്രം ഛിദ്യതേ, നൂതനപുരാതനവസ്ത്രയോ ർമേലഞ്ച ന ഭവതി|</para>
  <para style="p">
    <verse number="37" style="v"/>പുരാതന്യാം കുത്വാം കോപി നുതനം ദ്രാക്ഷാരസം ന നിദധാതി, യതോ നവീനദ്രാക്ഷാരസസ്യ തേജസാ പുരാതനീ കുതൂ ർവിദീര്യ്യതേ തതോ ദ്രാക്ഷാരസഃ പതതി കുതൂശ്ച നശ്യതി|</para>
  <para style="p">
    <verse number="38" style="v"/>തതോ ഹേതോ ർനൂതന്യാം കുത്വാം നവീനദ്രാക്ഷാരസഃ നിധാതവ്യസ്തേനോഭയസ്യ രക്ഷാ ഭവതി|</para>
  <para style="p">
    <verse number="39" style="v"/>അപരഞ്ച പുരാതനം ദ്രാക്ഷാരസം പീത്വാ കോപി നൂതനം ന വാഞ്ഛതി, യതഃ സ വക്തി നൂതനാത് പുരാതനമ് പ്രശസ്തമ്|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അചരഞ്ച പർവ്വണോ ദ്വിതീയദിനാത് പരം പ്രഥമവിശ്രാമവാരേ ശസ്യക്ഷേത്രേണ യീശോർഗമനകാലേ തസ്യ ശിഷ്യാഃ കണിശം ഛിത്ത്വാ കരേഷു മർദ്ദയിത്വാ ഖാദിതുമാരേഭിരേ|</para>
  <para style="p">
    <verse number="2" style="v"/>തസ്മാത് കിയന്തഃ ഫിരൂശിനസ്താനവദൻ വിശ്രാമവാരേ യത് കർമ്മ ന കർത്തവ്യം തത് കുതഃ കുരുഥ?</para>
  <para style="p">
    <verse number="3" style="v"/>യീശുഃ പ്രത്യുവാച ദായൂദ് തസ്യ സങ്ഗിനശ്ച ക്ഷുധാർത്താഃ കിം ചക്രുഃ സ കഥമ് ഈശ്വരസ്യ മന്ദിരം പ്രവിശ്യ</para>
  <para style="p">
    <verse number="4" style="v"/>യേ ദർശനീയാഃ പൂപാ യാജകാൻ വിനാന്യസ്യ കസ്യാപ്യഭോജനീയാസ്താനാനീയ സ്വയം ബുഭജേ സങ്ഗിഭ്യോപി ദദൗ തത് കിം യുഷ്മാഭിഃ കദാപി നാപാഠി?</para>
  <para style="p">
    <verse number="5" style="v"/>പശ്ചാത് സ താനവദത് മനുജസുതോ വിശ്രാമവാരസ്യാപി പ്രഭു ർഭവതി|</para>
  <para style="p">
    <verse number="6" style="v"/>അനന്തരമ് അന്യവിശ്രാമവാരേ സ ഭജനഗേഹം പ്രവിശ്യ സമുപദിശതി| തദാ തത്സ്ഥാനേ ശുഷ്കദക്ഷിണകര ഏകഃ പുമാൻ ഉപതസ്ഥിവാൻ|</para>
  <para style="p">
    <verse number="7" style="v"/>തസ്മാദ് അധ്യാപകാഃ ഫിരൂശിനശ്ച തസ്മിൻ ദോഷമാരോപയിതും സ വിശ്രാമവാരേ തസ്യ സ്വാസ്ഥ്യം കരോതി നവേതി പ്രതീക്ഷിതുമാരേഭിരേ|</para>
  <para style="p">
    <verse number="8" style="v"/>തദാ യീശുസ്തേഷാം ചിന്താം വിദിത്വാ തം ശുഷ്കകരം പുമാംസം പ്രോവാച, ത്വമുത്ഥായ മധ്യസ്ഥാനേ തിഷ്ഠ|</para>
  <para style="p">
    <verse number="9" style="v"/>തസ്മാത് തസ്മിൻ ഉത്ഥിതവതി യീശുസ്താൻ വ്യാജഹാര, യുഷ്മാൻ ഇമാം കഥാം പൃച്ഛാമി, വിശ്രാമവാരേ ഹിതമ് അഹിതം വാ, പ്രാണരക്ഷണം പ്രാണനാശനം വാ, ഏതേഷാം കിം കർമ്മകരണീയമ്?</para>
  <para style="p">
    <verse number="10" style="v"/>പശ്ചാത് ചതുർദിക്ഷു സർവ്വാൻ വിലോക്യ തം മാനവം ബഭാഷേ, നിജകരം പ്രസാരയ; തതസ്തേന തഥാ കൃത ഇതരകരവത് തസ്യ ഹസ്തഃ സ്വസ്ഥോഭവത്|</para>
  <para style="p">
    <verse number="11" style="v"/>തസ്മാത് തേ പ്രചണ്ഡകോപാന്വിതാ യീശും കിം കരിഷ്യന്തീതി പരസ്പരം പ്രമന്ത്രിതാഃ|</para>
  <para style="p">
    <verse number="12" style="v"/>തതഃ പരം സ പർവ്വതമാരുഹ്യേശ്വരമുദ്ദിശ്യ പ്രാർഥയമാനഃ കൃത്സ്നാം രാത്രിം യാപിതവാൻ|</para>
  <para style="p">
    <verse number="13" style="v"/>അഥ ദിനേ സതി സ സർവ്വാൻ ശിഷ്യാൻ ആഹൂതവാൻ തേഷാം മധ്യേ</para>
  <para style="p">
    <verse number="14" style="v"/>പിതരനാമ്നാ ഖ്യാതഃ ശിമോൻ തസ്യ ഭ്രാതാ ആന്ദ്രിയശ്ച യാകൂബ് യോഹൻ ച ഫിലിപ് ബർഥലമയശ്ച</para>
  <para style="p">
    <verse number="15" style="v"/>മഥിഃ ഥോമാ ആൽഫീയസ്യ പുത്രോ യാകൂബ് ജ്വലന്തനാമ്നാ ഖ്യാതഃ ശിമോൻ</para>
  <para style="p">
    <verse number="16" style="v"/>ച യാകൂബോ ഭ്രാതാ യിഹൂദാശ്ച തം യഃ പരകരേഷു സമർപയിഷ്യതി സ ഈഷ്കരീയോതീയയിഹൂദാശ്ചൈതാൻ ദ്വാദശ ജനാൻ മനോനീതാൻ കൃത്വാ സ ജഗ്രാഹ തഥാ പ്രേരിത ഇതി തേഷാം നാമ ചകാര|</para>
  <para style="p">
    <verse number="17" style="v"/>തതഃ പരം സ തൈഃ സഹ പർവ്വതാദവരുഹ്യ ഉപത്യകായാം തസ്ഥൗ തതസ്തസ്യ ശിഷ്യസങ്ഘോ യിഹൂദാദേശാദ് യിരൂശാലമശ്ച സോരഃ സീദോനശ്ച ജലധേ രോധസോ ജനനിഹാശ്ച ഏത്യ തസ്യ കഥാശ്രവണാർഥം രോഗമുക്ത്യർഥഞ്ച തസ്യ സമീപേ തസ്ഥുഃ|</para>
  <para style="p">
    <verse number="18" style="v"/>അമേധ്യഭൂതഗ്രസ്താശ്ച തന്നികടമാഗത്യ സ്വാസ്ഥ്യം പ്രാപുഃ|</para>
  <para style="p">
    <verse number="19" style="v"/>സർവ്വേഷാം സ്വാസ്ഥ്യകരണപ്രഭാവസ്യ പ്രകാശിതത്വാത് സർവ്വേ ലോകാ ഏത്യ തം സ്പ്രഷ്ടും യേതിരേ|</para>
  <para style="p">
    <verse number="20" style="v"/>പശ്ചാത് സ ശിഷ്യാൻ പ്രതി ദൃഷ്ടിം കുത്വാ ജഗാദ, ഹേ ദരിദ്രാ യൂയം ധന്യാ യത ഈശ്വരീയേ രാജ്യേ വോഽധികാരോസ്തി|</para>
  <para style="p">
    <verse number="21" style="v"/>ഹേ അധുനാ ക്ഷുധിതലോകാ യൂയം ധന്യാ യതോ യൂയം തർപ്സ്യഥ; ഹേ ഇഹ രോദിനോ ജനാ യൂയം ധന്യാ യതോ യൂയം ഹസിഷ്യഥ|</para>
  <para style="p">
    <verse number="22" style="v"/>യദാ ലോകാ മനുഷ്യസൂനോ ർനാമഹേതോ ര്യുഷ്മാൻ ഋृതീയിഷ്യന്തേ പൃഥക് കൃത്വാ നിന്ദിഷ്യന്തി, അധമാനിവ യുഷ്മാൻ സ്വസമീപാദ് ദൂരീകരിഷ്യന്തി ച തദാ യൂയം ധന്യാഃ|</para>
  <para style="p">
    <verse number="23" style="v"/>സ്വർഗേ യുഷ്മാകം യഥേഷ്ടം ഫലം ഭവിഷ്യതി, ഏതദർഥം തസ്മിൻ ദിനേ പ്രോല്ലസത ആനന്ദേന നൃത്യത ച, തേഷാം പൂർവ്വപുരുഷാശ്ച ഭവിഷ്യദ്വാദിനഃ പ്രതി തഥൈവ വ്യവാഹരൻ|</para>
  <para style="p">
    <verse number="24" style="v"/>കിന്തു ഹാ ഹാ ധനവന്തോ യൂയം സുഖം പ്രാപ്നുത| ഹന്ത പരിതൃപ്താ യൂയം ക്ഷുധിതാ ഭവിഷ്യഥ;</para>
  <para style="p">
    <verse number="25" style="v"/>ഇഹ ഹസന്തോ യൂയം വത യുഷ്മാഭിഃ ശോചിതവ്യം രോദിതവ്യഞ്ച|</para>
  <para style="p">
    <verse number="26" style="v"/>സർവ്വൈലാകൈ ര്യുഷ്മാകം സുഖ്യാതൗ കൃതായാം യുഷ്മാകം ദുർഗതി ർഭവിഷ്യതി യുഷ്മാകം പൂർവ്വപുരുഷാ മൃഷാഭവിഷ്യദ്വാദിനഃ പ്രതി തദ്വത് കൃതവന്തഃ|</para>
  <para style="p">
    <verse number="27" style="v"/>ഹേ ശ്രോതാരോ യുഷ്മഭ്യമഹം കഥയാമി, യൂയം ശത്രുഷു പ്രീയധ്വം യേ ച യുഷ്മാൻ ദ്വിഷന്തി തേഷാമപി ഹിതം കുരുത|</para>
  <para style="p">
    <verse number="28" style="v"/>യേ ച യുഷ്മാൻ ശപന്തി തേഭ്യ ആശിഷം ദത്ത യേ ച യുഷ്മാൻ അവമന്യന്തേ തേഷാം മങ്ഗലം പ്രാർഥയധ്വം|</para>
  <para style="p">
    <verse number="29" style="v"/>യദി കശ്ചിത് തവ കപോലേ ചപേടാഘാതം കരോതി തർഹി തം പ്രതി കപോലമ് അന്യം പരാവർത്ത്യ സമ്മുഖീകുരു പുനശ്ച യദി കശ്ചിത് തവ ഗാത്രീയവസ്ത്രം ഹരതി തർഹി തം പരിധേയവസ്ത്രമ് അപി ഗ്രഹീതും മാ വാരയ|</para>
  <para style="p">
    <verse number="30" style="v"/>യസ്ത്വാം യാചതേ തസ്മൈ ദേഹി, യശ്ച തവ സമ്പത്തിം ഹരതി തം മാ യാചസ്വ|</para>
  <para style="p">
    <verse number="31" style="v"/>പരേഭ്യഃ സ്വാൻ പ്രതി യഥാചരണമ് അപേക്ഷധ്വേ പരാൻ പ്രതി യൂയമപി തഥാചരത|</para>
  <para style="p">
    <verse number="32" style="v"/>യേ ജനാ യുഷ്മാസു പ്രീയന്തേ കേവലം തേഷു പ്രീയമാണേഷു യുഷ്മാകം കിം ഫലം? പാപിലോകാ അപി സ്വേഷു പ്രീയമാണേഷു പ്രീയന്തേ|</para>
  <para style="p">
    <verse number="33" style="v"/>യദി ഹിതകാരിണ ഏവ ഹിതം കുരുഥ തർഹി യുഷ്മാകം കിം ഫലം? പാപിലോകാ അപി തഥാ കുർവ്വന്തി|</para>
  <para style="p">
    <verse number="34" style="v"/>യേഭ്യ ഋണപരിശോധസ്യ പ്രാപ്തിപ്രത്യാശാസ്തേ കേവലം തേഷു ഋണേ സമർപിതേ യുഷ്മാകം കിം ഫലം? പുനഃ പ്രാപ്ത്യാശയാ പാപീലോകാ അപി പാപിജനേഷു ഋണമ് അർപയന്തി|</para>
  <para style="p">
    <verse number="35" style="v"/>അതോ യൂയം രിപുഷ്വപി പ്രീയധ്വം, പരഹിതം കുരുത ച; പുനഃ പ്രാപ്ത്യാശാം ത്യക്ത്വാ ഋണമർപയത, തഥാ കൃതേ യുഷ്മാകം മഹാഫലം ഭവിഷ്യതി, യൂയഞ്ച സർവ്വപ്രധാനസ്യ സന്താനാ ഇതി ഖ്യാതിം പ്രാപ്സ്യഥ, യതോ യുഷ്മാകം പിതാ കൃതഘ്നാനാം ദുർവ്ടത്താനാഞ്ച ഹിതമാചരതി|</para>
  <para style="p">
    <verse number="36" style="v"/>അത ഏവ സ യഥാ ദയാലു ര്യൂയമപി താദൃശാ ദയാലവോ ഭവത|</para>
  <para style="p">
    <verse number="37" style="v"/>അപരഞ്ച പരാൻ ദോഷിണോ മാ കുരുത തസ്മാദ് യൂയം ദോഷീകൃതാ ന ഭവിഷ്യഥ; അദണ്ഡ്യാൻ മാ ദണ്ഡയത തസ്മാദ് യൂയമപി ദണ്ഡം ന പ്രാപ്സ്യഥ; പരേഷാം ദോഷാൻ ക്ഷമധ്വം തസ്മാദ് യുഷ്മാകമപി ദോഷാഃ ക്ഷമിഷ്യന്തേ|</para>
  <para style="p">
    <verse number="38" style="v"/>ദാനാനിദത്ത തസ്മാദ് യൂയം ദാനാനി പ്രാപ്സ്യഥ, വരഞ്ച ലോകാഃ പരിമാണപാത്രം പ്രദലയ്യ സഞ്ചാല്യ പ്രോഞ്ചാല്യ പരിപൂര്യ്യ യുഷ്മാകം ക്രോഡേഷു സമർപയിഷ്യന്തി; യൂയം യേന പരിമാണേന പരിമാഥ തേനൈവ പരിമാണേന യുഷ്മത്കൃതേ പരിമാസ്യതേ|</para>
  <para style="p">
    <verse number="39" style="v"/>അഥ സ തേഭ്യോ ദൃഷ്ടാന്തകഥാമകഥയത്, അന്ധോ ജനഃ കിമന്ധം പന്ഥാനം ദർശയിതും ശക്നോതി? തസ്മാദ് ഉഭാവപി കിം ഗർത്തേ ന പതിഷ്യതഃ?</para>
  <para style="p">
    <verse number="40" style="v"/>ഗുരോഃ ശിഷ്യോ ന ശ്രേഷ്ഠഃ കിന്തു ശിഷ്യേ സിദ്ധേ സതി സ ഗുരുതുല്യോ ഭവിതും ശക്നോതി|</para>
  <para style="p">
    <verse number="41" style="v"/>അപരഞ്ച ത്വം സ്വചക്ഷുुഷി നാസാമ് അദൃഷ്ട്വാ തവ ഭ്രാതുശ്ചക്ഷുഷി യത്തൃണമസ്തി തദേവ കുതഃ പശ്യമി?</para>
  <para style="p">
    <verse number="42" style="v"/>സ്വചക്ഷുഷി യാ നാസാ വിദ്യതേ താമ് അജ്ഞാത്വാ, ഭ്രാതസ്തവ നേത്രാത് തൃണം ബഹിഃ കരോമീതി വാക്യം ഭ്രാതരം കഥം വക്തും ശക്നോഷി? ഹേ കപടിൻ പൂർവ്വം സ്വനയനാത് നാസാം ബഹിഃ കുരു തതോ ഭ്രാതുശ്ചക്ഷുഷസ്തൃണം ബഹിഃ കർത്തും സുദൃഷ്ടിം പ്രാപ്സ്യസി|</para>
  <para style="p">
    <verse number="43" style="v"/>അന്യഞ്ച ഉത്തമസ്തരുഃ കദാപി ഫലമനുത്തമം ന ഫലതി, അനുത്തമതരുശ്ച ഫലമുത്തമം ന ഫലതി കാരണാദതഃ ഫലൈസ്തരവോ ജ്ഞായന്തേ|</para>
  <para style="p">
    <verse number="44" style="v"/>കണ്ടകിപാദപാത് കോപി ഉഡുമ്ബരഫലാനി ന പാതയതി തഥാ ശൃഗാലകോലിവൃക്ഷാദപി കോപി ദ്രാക്ഷാഫലം ന പാതയതി|</para>
  <para style="p">
    <verse number="45" style="v"/>തദ്വത് സാധുലോകോഽന്തഃകരണരൂപാത് സുഭാണ്ഡാഗാരാദ് ഉത്തമാനി ദ്രവ്യാണി ബഹിഃ കരോതി, ദുഷ്ടോ ലോകശ്ചാന്തഃകരണരൂപാത് കുഭാണ്ഡാഗാരാത് കുത്സിതാനി ദ്രവ്യാണി നിർഗമയതി യതോഽന്തഃകരണാനാം പൂർണഭാവാനുരൂപാണി വചാംസി മുഖാന്നിർഗച്ഛന്തി|</para>
  <para style="p">
    <verse number="46" style="v"/>അപരഞ്ച മമാജ്ഞാനുരൂപം നാചരിത്വാ കുതോ മാം പ്രഭോ പ്രഭോ ഇതി വദഥ?</para>
  <para style="p">
    <verse number="47" style="v"/>യഃ കശ്ചിൻ മമ നികടമ് ആഗത്യ മമ കഥാ നിശമ്യ തദനുരൂപം കർമ്മ കരോതി സ കസ്യ സദൃശോ ഭവതി തദഹം യുഷ്മാൻ ജ്ഞാाപയാമി|</para>
  <para style="p">
    <verse number="48" style="v"/>യോ ജനോ ഗഭീരം ഖനിത്വാ പാഷാണസ്ഥലേ ഭിത്തിം നിർമ്മായ സ്വഗൃഹം രചയതി തേന സഹ തസ്യോപമാ ഭവതി; യത ആപ്ലാവിജലമേത്യ തസ്യ മൂലേ വേഗേന വഹദപി തദ്ഗേഹം ലാഡയിതും ന ശക്നോതി യതസ്തസ്യ ഭിത്തിഃ പാഷാണോപരി തിഷ്ഠതി|</para>
  <para style="p">
    <verse number="49" style="v"/>കിന്തു യഃ കശ്ചിൻ മമ കഥാഃ ശ്രുത്വാ തദനുരൂപം നാചരതി സ ഭിത്തിം വിനാ മൃृദുപരി ഗൃഹനിർമ്മാത്രാ സമാനോ ഭവതി; യത ആപ്ലാവിജലമാഗത്യ വേഗേന യദാ വഹതി തദാ തദ്ഗൃഹം പതതി തസ്യ മഹത് പതനം ജായതേ|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>തതഃ പരം സ ലോകാനാം കർണഗോചരേ താൻ സർവ്വാൻ ഉപദേശാൻ സമാപ്യ യദാ കഫർനാഹൂമ്പുരം പ്രവിശതി</para>
  <para style="p">
    <verse number="2" style="v"/>തദാ ശതസേനാപതേഃ പ്രിയദാസ ഏകോ മൃതകൽപഃ പീഡിത ആസീത്|</para>
  <para style="p">
    <verse number="3" style="v"/>അതഃ സേനാപതി ര്യീശോ ർവാർത്താം നിശമ്യ ദാസസ്യാരോഗ്യകരണായ തസ്യാഗമനാർഥം വിനയകരണായ യിഹൂദീയാൻ കിയതഃ പ്രാചഃ പ്രേഷയാമാസ|</para>
  <para style="p">
    <verse number="4" style="v"/>തേ യീശോരന്തികം ഗത്വാ വിനയാതിശയം വക്തുമാരേഭിരേ, സ സേനാപതി ർഭവതോനുഗ്രഹം പ്രാപ്തുമ് അർഹതി|</para>
  <para style="p">
    <verse number="5" style="v"/>യതഃ സോസ്മജ്ജാതീയേഷു ലോകേഷു പ്രീയതേ തഥാസ്മത്കൃതേ ഭജനഗേഹം നിർമ്മിതവാൻ|</para>
  <para style="p">
    <verse number="6" style="v"/>തസ്മാദ് യീശുസ്തൈഃ സഹ ഗത്വാ നിവേശനസ്യ സമീപം പ്രാപ, തദാ സ ശതസേനാപതി ർവക്ഷ്യമാണവാക്യം തം വക്തും ബന്ധൂൻ പ്രാഹിണോത്| ഹേ പ്രഭോ സ്വയം ശ്രമോ ന കർത്തവ്യോ യദ് ഭവതാ മദ്ഗേഹമധ്യേ പാദാർപണം ക്രിയേത തദപ്യഹം നാർഹാമി,</para>
  <para style="p">
    <verse number="7" style="v"/>കിഞ്ചാഹം ഭവത്സമീപം യാതുമപി നാത്മാനം യോഗ്യം ബുദ്ധവാൻ, തതോ ഭവാൻ വാക്യമാത്രം വദതു തേനൈവ മമ ദാസഃ സ്വസ്ഥോ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="8" style="v"/>യസ്മാദ് അഹം പരാധീനോപി മമാധീനാ യാഃ സേനാഃ സന്തി താസാമ് ഏകജനം പ്രതി യാഹീതി മയാ പ്രോക്തേ സ യാതി; തദന്യം പ്രതി ആയാഹീതി പ്രോക്തേ സ ആയാതി; തഥാ നിജദാസം പ്രതി ഏതത് കുർവ്വിതി പ്രോക്തേ സ തദേവ കരോതി|</para>
  <para style="p">
    <verse number="9" style="v"/>യീശുരിദം വാക്യം ശ്രുത്വാ വിസ്മയം യയൗ, മുഖം പരാവർത്യ പശ്ചാദ്വർത്തിനോ ലോകാൻ ബഭാഷേ ച, യുഷ്മാനഹം വദാമി ഇസ്രായേലോ വംശമധ്യേപി വിശ്വാസമീദൃശം ന പ്രാപ്നവം|</para>
  <para style="p">
    <verse number="10" style="v"/>തതസ്തേ പ്രേഷിതാ ഗൃഹം ഗത്വാ തം പീഡിതം ദാസം സ്വസ്ഥം ദദൃശുഃ|</para>
  <para style="p">
    <verse number="11" style="v"/>പരേഽഹനി സ നായീനാഖ്യം നഗരം ജഗാമ തസ്യാനേകേ ശിഷ്യാ അന്യേ ച ലോകാസ്തേന സാർദ്ധം യയുഃ|</para>
  <para style="p">
    <verse number="12" style="v"/>തേഷു തന്നഗരസ്യ ദ്വാരസന്നിധിം പ്രാപ്തേഷു കിയന്തോ ലോകാ ഏകം മൃതമനുജം വഹന്തോ നഗരസ്യ ബഹിര്യാന്തി, സ തന്മാതുരേകപുത്രസ്തന്മാതാ ച വിധവാ; തയാ സാർദ്ധം തന്നഗരീയാ ബഹവോ ലോകാ ആസൻ|</para>
  <para style="p">
    <verse number="13" style="v"/>പ്രഭുസ്താം വിലോക്യ സാനുകമ്പഃ കഥയാമാസ, മാ രോദീഃ| സ സമീപമിത്വാ ഖട്വാം പസ്പർശ തസ്മാദ് വാഹകാഃ സ്ഥഗിതാസ്തമ്യുഃ;</para>
  <para style="p">
    <verse number="14" style="v"/>തദാ സ ഉവാച ഹേ യുവമനുഷ്യ ത്വമുത്തിഷ്ഠ, ത്വാമഹമ് ആജ്ഞാപയാമി|</para>
  <para style="p">
    <verse number="15" style="v"/>തസ്മാത് സ മൃതോ ജനസ്തത്ക്ഷണമുത്ഥായ കഥാം പ്രകഥിതഃ; തതോ യീശുസ്തസ്യ മാതരി തം സമർപയാമാസ|</para>
  <para style="p">
    <verse number="16" style="v"/>തസ്മാത് സർവ്വേ ലോകാഃ ശശങ്കിരേ; ഏകോ മഹാഭവിഷ്യദ്വാദീ മധ്യേഽസ്മാകമ് സമുദൈത്, ഈശ്വരശ്ച സ്വലോകാനന്വഗൃഹ്ലാത് കഥാമിമാം കഥയിത്വാ ഈശ്വരം ധന്യം ജഗദുഃ|</para>
  <para style="p">
    <verse number="17" style="v"/>തതഃ പരം സമസ്തം യിഹൂദാദേശം തസ്യ ചതുർദിക്സ്ഥദേശഞ്ച തസ്യൈതത്കീർത്തി ർവ്യാനശേ|</para>
  <para style="p">
    <verse number="18" style="v"/>തതഃ പരം യോഹനഃ ശിഷ്യേഷു തം തദ്വൃത്താന്തം ജ്ഞാപിതവത്സു</para>
  <para style="p">
    <verse number="19" style="v"/>സ സ്വശിഷ്യാണാം ദ്വൗ ജനാവാഹൂയ യീശും പ്രതി വക്ഷ്യമാണം വാക്യം വക്തും പ്രേഷയാമാസ, യസ്യാഗമനമ് അപേക്ഷ്യ തിഷ്ഠാമോ വയം കിം സ ഏവ ജനസ്ത്വം? കിം വയമന്യമപേക്ഷ്യ സ്ഥാസ്യാമഃ?</para>
  <para style="p">
    <verse number="20" style="v"/>പശ്ചാത്തൗ മാനവൗ ഗത്വാ കഥയാമാസതുഃ, യസ്യാഗമനമ് അപേക്ഷ്യ തിഷ്ഠാമോ വയം, കിം സഏവ ജനസ്ത്വം? കിം വയമന്യമപേക്ഷ്യ സ്ഥാസ്യാമഃ? കഥാമിമാം തുഭ്യം കഥയിതും യോഹൻ മജ്ജക ആവാം പ്രേഷിതവാൻ|</para>
  <para style="p">
    <verse number="21" style="v"/>തസ്മിൻ ദണ്ഡേ യീശൂരോഗിണോ മഹാവ്യാധിമതോ ദുഷ്ടഭൂതഗ്രസ്താംശ്ച ബഹൂൻ സ്വസ്ഥാൻ കൃത്വാ, അനേകാന്ധേഭ്യശ്ചക്ഷുംഷി ദത്ത്വാ പ്രത്യുവാച,</para>
  <para style="p">
    <verse number="22" style="v"/>യുവാം വ്രജതമ് അന്ധാ നേത്രാണി ഖഞ്ജാശ്ചരണാനി ച പ്രാപ്നുവന്തി, കുഷ്ഠിനഃ പരിഷ്ക്രിയന്തേ, ബധിരാഃ ശ്രവണാനി മൃതാശ്ച ജീവനാനി പ്രാപ്നുവന്തി, ദരിദ്രാണാം സമീപേഷു സുസംവാദഃ പ്രചാര്യ്യതേ, യം പ്രതി വിഘ്നസ്വരൂപോഹം ന ഭവാമി സ ധന്യഃ,</para>
  <para style="p">
    <verse number="23" style="v"/>ഏതാനി യാനി പശ്യഥഃ ശൃണുഥശ്ച താനി യോഹനം ജ്ഞാപയതമ്|</para>
  <para style="p">
    <verse number="24" style="v"/>തയോ ർദൂതയോ ർഗതയോഃ സതോ ര്യോഹനി സ ലോകാൻ വക്തുമുപചക്രമേ, യൂയം മധ്യേപ്രാന്തരം കിം ദ്രഷ്ടും നിരഗമത? കിം വായുനാ കമ്പിതം നഡം?</para>
  <para style="p">
    <verse number="25" style="v"/>യൂയം കിം ദ്രഷ്ടും നിരഗമത? കിം സൂക്ഷ്മവസ്ത്രപരിധായിനം കമപി നരം? കിന്തു യേ സൂക്ഷ്മമൃദുവസ്ത്രാണി പരിദധതി സൂത്തമാനി ദ്രവ്യാണി ഭുഞ്ജതേ ച തേ രാജധാനീഷു തിഷ്ഠന്തി|</para>
  <para style="p">
    <verse number="26" style="v"/>തർഹി യൂയം കിം ദ്രഷ്ടും നിരഗമത? കിമേകം ഭവിഷ്യദ്വാദിനം? തദേവ സത്യം കിന്തു സ പുമാൻ ഭവിഷ്യദ്വാദിനോപി ശ്രേഷ്ഠ ഇത്യഹം യുഷ്മാൻ വദാമി;</para>
  <para style="p">
    <verse number="27" style="v"/>പശ്യ സ്വകീയദൂതന്തു തവാഗ്ര പ്രേഷയാമ്യഹം| ഗത്വാ ത്വദീയമാർഗന്തു സ ഹി പരിഷ്കരിഷ്യതി| യദർഥേ ലിപിരിയമ് ആസ്തേ സ ഏവ യോഹൻ|</para>
  <para style="p">
    <verse number="28" style="v"/>അതോ യുഷ്മാനഹം വദാമി സ്ത്രിയാ ഗർബ്ഭജാതാനാം ഭവിഷ്യദ്വാദിനാം മധ്യേ യോഹനോ മജ്ജകാത് ശ്രേഷ്ഠഃ കോപി നാസ്തി, തത്രാപി ഈശ്വരസ്യ രാജ്യേ യഃ സർവ്വസ്മാത് ക്ഷുദ്രഃ സ യോഹനോപി ശ്രേഷ്ഠഃ|</para>
  <para style="p">
    <verse number="29" style="v"/>അപരഞ്ച സർവ്വേ ലോകാഃ കരമഞ്ചായിനശ്ച തസ്യ വാക്യാനി ശ്രുത്വാ യോഹനാ മജ്ജനേന മജ്ജിതാഃ പരമേശ്വരം നിർദോഷം മേനിരേ|</para>
  <para style="p">
    <verse number="30" style="v"/>കിന്തു ഫിരൂശിനോ വ്യവസ്ഥാപകാശ്ച തേന ന മജ്ജിതാഃ സ്വാൻ പ്രതീശ്വരസ്യോപദേശം നിഷ്ഫലമ് അകുർവ്വൻ|</para>
  <para style="p">
    <verse number="31" style="v"/>അഥ പ്രഭുഃ കഥയാമാസ, ഇദാനീന്തനജനാൻ കേനോപമാമി? തേ കസ്യ സദൃശാഃ?</para>
  <para style="p">
    <verse number="32" style="v"/>യേ ബാലകാ വിപണ്യാമ് ഉപവിശ്യ പരസ്പരമ് ആഹൂയ വാക്യമിദം വദന്തി, വയം യുഷ്മാകം നികടേ വംശീരവാദിഷ്മ, കിന്തു യൂയം നാനർത്തിഷ്ട, വയം യുഷ്മാകം നികട അരോദിഷ്മ, കിന്തു യുയം ന വ്യലപിഷ്ട, ബാലകൈരേതാദൃശൈസ്തേഷാമ് ഉപമാ ഭവതി|</para>
  <para style="p">
    <verse number="33" style="v"/>യതോ യോഹൻ മജ്ജക ആഗത്യ പൂപം നാഖാദത് ദ്രാക്ഷാരസഞ്ച നാപിവത് തസ്മാദ് യൂയം വദഥ, ഭൂതഗ്രസ്തോയമ്|</para>
  <para style="p">
    <verse number="34" style="v"/>തതഃ പരം മാനവസുത ആഗത്യാഖാദദപിവഞ്ച തസ്മാദ് യൂയം വദഥ, ഖാദകഃ സുരാപശ്ചാണ്ഡാലപാപിനാം ബന്ധുരേകോ ജനോ ദൃശ്യതാമ്|</para>
  <para style="p">
    <verse number="35" style="v"/>കിന്തു ജ്ഞാനിനോ ജ്ഞാനം നിർദോഷം വിദുഃ|</para>
  <para style="p">
    <verse number="36" style="v"/>പശ്ചാദേകഃ ഫിരൂശീ യീശും ഭോജനായ ന്യമന്ത്രയത് തതഃ സ തസ്യ ഗൃഹം ഗത്വാ ഭോക്തുമുപവിഷ്ടഃ|</para>
  <para style="p">
    <verse number="37" style="v"/>ഏതർഹി തത്ഫിരൂശിനോ ഗൃഹേ യീശു ർഭേക്തുമ് ഉപാവേക്ഷീത് തച്ഛ്രുത്വാ തന്നഗരവാസിനീ കാപി ദുഷ്ടാ നാരീ പാണ്ഡരപ്രസ്തരസ്യ സമ്പുടകേ സുഗന്ധിതൈലമ് ആനീയ</para>
  <para style="p">
    <verse number="38" style="v"/>തസ്യ പശ്ചാത് പാദയോഃ സന്നിധൗ തസ്യൗ രുദതീ ച നേത്രാമ്ബുഭിസ്തസ്യ ചരണൗ പ്രക്ഷാല്യ നിജകചൈരമാർക്ഷീത്, തതസ്തസ്യ ചരണൗ ചുമ്ബിത്വാ തേന സുഗന്ധിതൈലേന മമർദ|</para>
  <para style="p">
    <verse number="39" style="v"/>തസ്മാത് സ നിമന്ത്രയിതാ ഫിരൂശീ മനസാ ചിന്തയാമാസ, യദ്യയം ഭവിഷ്യദ്വാദീ ഭവേത് തർഹി ഏനം സ്പൃശതി യാ സ്ത്രീ സാ കാ കീദൃശീ ചേതി ജ്ഞാതും ശക്നുയാത് യതഃ സാ ദുഷ്ടാ|</para>
  <para style="p">
    <verse number="40" style="v"/>തദാ യാശുസ്തം ജഗാദ, ഹേ ശിമോൻ ത്വാം പ്രതി മമ കിഞ്ചിദ് വക്തവ്യമസ്തി; തസ്മാത് സ ബഭാഷേ, ഹേ ഗുരോ തദ് വദതു|</para>
  <para style="p">
    <verse number="41" style="v"/>ഏകോത്തമർണസ്യ ദ്വാവധമർണാവാസ്താം, തയോരേകഃ പഞ്ചശതാനി മുദ്രാപാദാൻ അപരശ്ച പഞ്ചാശത് മുദ്രാപാദാൻ ധാരയാമാസ|</para>
  <para style="p">
    <verse number="42" style="v"/>തദനന്തരം തയോഃ ശോധ്യാഭാവാത് സ ഉത്തമർണസ്തയോ രൃണേ ചക്ഷമേ; തസ്മാത് തയോർദ്വയോഃ കസ്തസ്മിൻ പ്രേഷ്യതേ ബഹു? തദ് ബ്രൂഹി|</para>
  <para style="p">
    <verse number="43" style="v"/>ശിമോൻ പ്രത്യുവാച, മയാ ബുധ്യതേ യസ്യാധികമ് ഋണം ചക്ഷമേ സ ഇതി; തതോ യീശുസ്തം വ്യാജഹാര, ത്വം യഥാർഥം വ്യചാരയഃ|</para>
  <para style="p">
    <verse number="44" style="v"/>അഥ താം നാരീം പ്രതി വ്യാഘുഠ്യ ശിമോനമവോചത്, സ്ത്രീമിമാം പശ്യസി? തവ ഗൃഹേ മയ്യാഗതേ ത്വം പാദപ്രക്ഷാലനാർഥം ജലം നാദാഃ കിന്തു യോഷിദേഷാ നയനജലൈ ർമമ പാദൗ പ്രക്ഷാല്യ കേശൈരമാർക്ഷീത്|</para>
  <para style="p">
    <verse number="45" style="v"/>ത്വം മാം നാചുമ്ബീഃ കിന്തു യോഷിദേഷാ സ്വീയാഗമനാദാരഭ്യ മദീയപാദൗ ചുമ്ബിതും ന വ്യരംസ്ത|</para>
  <para style="p">
    <verse number="46" style="v"/>ത്വഞ്ച മദീയോത്തമാങ്ഗേ കിഞ്ചിദപി തൈലം നാമർദീഃ കിന്തു യോഷിദേഷാ മമ ചരണൗ സുഗന്ധിതൈലേനാമർദ്ദീത്|</para>
  <para style="p">
    <verse number="47" style="v"/>അതസ്ത്വാം വ്യാഹരാമി, ഏതസ്യാ ബഹു പാപമക്ഷമ്യത തതോ ബഹു പ്രീയതേ കിന്തു യസ്യാൽപപാപം ക്ഷമ്യതേ സോൽപം പ്രീയതേ|</para>
  <para style="p">
    <verse number="48" style="v"/>തതഃ പരം സ താം ബഭാഷേ, ത്വദീയം പാപമക്ഷമ്യത|</para>
  <para style="p">
    <verse number="49" style="v"/>തദാ തേന സാർദ്ധം യേ ഭോക്തുമ് ഉപവിവിശുസ്തേ പരസ്പരം വക്തുമാരേഭിരേ, അയം പാപം ക്ഷമതേ ക ഏഷഃ?</para>
  <para style="p">
    <verse number="50" style="v"/>കിന്തു സ താം നാരീം ജഗാദ, തവ വിശ്വാസസ്ത്വാം പര്യ്യത്രാസ്ത ത്വം ക്ഷേമേണ വ്രജ|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അപരഞ്ച യീശു ർദ്വാദശഭിഃ ശിഷ്യൈഃ സാർദ്ധം നാനാനഗരേഷു നാനാഗ്രാമേഷു ച ഗച്ഛൻ ഇശ്വരീയരാജത്വസ്യ സുസംവാദം പ്രചാരയിതും പ്രാരേഭേ|</para>
  <para style="p">
    <verse number="2" style="v"/>തദാ യസ്യാഃ സപ്ത ഭൂതാ നിരഗച്ഛൻ സാ മഗ്ദലീനീതി വിഖ്യാതാ മരിയമ് ഹേരോദ്രാജസ്യ ഗൃഹാധിപതേഃ ഹോഷേ ർഭാര്യ്യാ യോഹനാ ശൂശാനാ</para>
  <para style="p">
    <verse number="3" style="v"/>പ്രഭൃതയോ യാ ബഹ്വ്യഃ സ്ത്രിയഃ ദുഷ്ടഭൂതേഭ്യോ രോഗേഭ്യശ്ച മുക്താഃ സത്യോ നിജവിഭൂതീ ർവ്യയിത്വാ തമസേവന്ത, താഃ സർവ്വാസ്തേന സാർദ്ധമ് ആസൻ|</para>
  <para style="p">
    <verse number="4" style="v"/>അനന്തരം നാനാനഗരേഭ്യോ ബഹവോ ലോകാ ആഗത്യ തസ്യ സമീപേഽമിലൻ, തദാ സ തേഭ്യ ഏകാം ദൃഷ്ടാന്തകഥാം കഥയാമാസ| ഏകഃ കൃഷീബലോ ബീജാനി വപ്തും ബഹിർജഗാമ,</para>
  <para style="p">
    <verse number="5" style="v"/>തതോ വപനകാലേ കതിപയാനി ബീജാനി മാർഗപാർശ്വേ പേതുഃ, തതസ്താനി പദതലൈ ർദലിതാനി പക്ഷിഭി ർഭക്ഷിതാനി ച|</para>
  <para style="p">
    <verse number="6" style="v"/>കതിപയാനി ബീജാനി പാഷാണസ്ഥലേ പതിതാനി യദ്യപി താന്യങ്കുരിതാനി തഥാപി രസാഭാവാത് ശുശുഷുഃ|</para>
  <para style="p">
    <verse number="7" style="v"/>കതിപയാനി ബീജാനി കണ്ടകിവനമധ്യേ പതിതാനി തതഃ കണ്ടകിവനാനി സംവൃദ്ധ്യ താനി ജഗ്രസുഃ|</para>
  <para style="p">
    <verse number="8" style="v"/>തദന്യാനി കതിപയബീജാനി ച ഭൂമ്യാമുത്തമായാം പേതുസ്തതസ്താന്യങ്കുരയിത്വാ ശതഗുണാനി ഫലാനി ഫേലുഃ| സ ഇമാ കഥാം കഥയിത്വാ പ്രോച്ചൈഃ പ്രോവാച, യസ്യ ശ്രോതും ശ്രോത്രേ സ്തഃ സ ശൃണോതു|</para>
  <para style="p">
    <verse number="9" style="v"/>തതഃ പരം ശിഷ്യാസ്തം പപ്രച്ഛുരസ്യ ദൃഷ്ടാന്തസ്യ കിം താത്പര്യ്യം?</para>
  <para style="p">
    <verse number="10" style="v"/>തതഃ സ വ്യാജഹാര, ഈശ്വരീയരാജ്യസ്യ ഗുഹ്യാനി ജ്ഞാതും യുഷ്മഭ്യമധികാരോ ദീയതേ കിന്ത്വന്യേ യഥാ ദൃഷ്ട്വാപി ന പശ്യന്തി ശ്രുത്വാപി മ ബുധ്യന്തേ ച തദർഥം തേഷാം പുരസ്താത് താഃ സർവ്വാഃ കഥാ ദൃഷ്ടാന്തേന കഥ്യന്തേ|</para>
  <para style="p">
    <verse number="11" style="v"/>ദൃഷ്ടാന്തസ്യാസ്യാഭിപ്രായഃ, ഈശ്വരീയകഥാ ബീജസ്വരൂപാ|</para>
  <para style="p">
    <verse number="12" style="v"/>യേ കഥാമാത്രം ശൃണ്വന്തി കിന്തു പശ്ചാദ് വിശ്വസ്യ യഥാ പരിത്രാണം ന പ്രാപ്നുവന്തി തദാശയേന ശൈതാനേത്യ ഹൃദയാതൃ താം കഥാമ് അപഹരതി ത ഏവ മാർഗപാർശ്വസ്ഥഭൂമിസ്വരൂപാഃ|</para>
  <para style="p">
    <verse number="13" style="v"/>യേ കഥം ശ്രുത്വാ സാനന്ദം ഗൃഹ്ലന്തി കിന്ത്വബദ്ധമൂലത്വാത് സ്വൽപകാലമാത്രം പ്രതീത്യ പരീക്ഷാകാലേ ഭ്രശ്യന്തി തഏവ പാഷാണഭൂമിസ്വരൂപാഃ|</para>
  <para style="p">
    <verse number="14" style="v"/>യേ കഥാം ശ്രുത്വാ യാന്തി വിഷയചിന്തായാം ധനലോഭേന ഏेഹികസുഖേ ച മജ്ജന്ത ഉപയുക്തഫലാനി ന ഫലന്തി ത ഏവോപ്തബീജകണ്ടകിഭൂസ്വരൂപാഃ|</para>
  <para style="p">
    <verse number="15" style="v"/>കിന്തു യേ ശ്രുത്വാ സരലൈഃ ശുദ്ധൈശ്ചാന്തഃകരണൈഃ കഥാം ഗൃഹ്ലന്തി ധൈര്യ്യമ് അവലമ്ബ്യ ഫലാന്യുത്പാദയന്തി ച ത ഏവോത്തമമൃത്സ്വരൂപാഃ|</para>
  <para style="p">
    <verse number="16" style="v"/>അപരഞ്ച പ്രദീപം പ്രജ്വാല്യ കോപി പാത്രേണ നാച്ഛാദയതി തഥാ ഖട്വാധോപി ന സ്ഥാപയതി, കിന്തു ദീപാധാരോപര്യ്യേവ സ്ഥാപയതി, തസ്മാത് പ്രവേശകാ ദീപ്തിം പശ്യന്തി|</para>
  <para style="p">
    <verse number="17" style="v"/>യന്ന പ്രകാശയിഷ്യതേ താദൃഗ് അപ്രകാശിതം വസ്തു കിമപി നാസ്തി യച്ച ന സുവ്യക്തം പ്രചാരയിഷ്യതേ താദൃഗ് ഗൃപ്തം വസ്തു കിമപി നാസ്തി|</para>
  <para style="p">
    <verse number="18" style="v"/>അതോ യൂയം കേന പ്രകാരേണ ശൃണുഥ തത്ര സാവധാനാ ഭവത, യസ്യ സമീപേ ബർദ്ധതേ തസ്മൈ പുനർദാസ്യതേ കിന്തു യസ്യാശ്രയേ ന ബർദ്ധതേ തസ്യ യദ്യദസ്തി തദപി തസ്മാത് നേഷ്യതേ|</para>
  <para style="p">
    <verse number="19" style="v"/>അപരഞ്ച യീശോ ർമാതാ ഭ്രാതരശ്ച തസ്യ സമീപം ജിഗമിഷവഃ</para>
  <para style="p">
    <verse number="20" style="v"/>കിന്തു ജനതാസമ്ബാധാത് തത്സന്നിധിം പ്രാപ്തും ന ശേകുഃ| തത്പശ്ചാത് തവ മാതാ ഭ്രാതരശ്ച ത്വാം സാക്ഷാത് ചികീർഷന്തോ ബഹിസ്തിഷ്ഠനതീതി വാർത്തായാം തസ്മൈ കഥിതായാം</para>
  <para style="p">
    <verse number="21" style="v"/>സ പ്രത്യുവാച; യേ ജനാ ഈശ്വരസ്യ കഥാം ശ്രുത്വാ തദനുരൂപമാചരന്തി തഏവ മമ മാതാ ഭ്രാതരശ്ച|</para>
  <para style="p">
    <verse number="22" style="v"/>അനന്തരം ഏകദാ യീശുഃ ശിഷ്യൈഃ സാർദ്ധം നാവമാരുഹ്യ ജഗാദ, ആയാത വയം ഹ്രദസ്യ പാരം യാമഃ, തതസ്തേ ജഗ്മുഃ|</para>
  <para style="p">
    <verse number="23" style="v"/>തേഷു നൗകാം വാഹയത്സു സ നിദദ്രൗ;</para>
  <para style="p">
    <verse number="24" style="v"/>അഥാകസ്മാത് പ്രബലഝഞ്ഭ്ശഗമാദ് ഹ്രദേ നൗകായാം തരങ്ഗൈരാച്ഛന്നായാം വിപത് താൻ ജഗ്രാസ| തസ്മാദ് യീശോരന്തികം ഗത്വാ ഹേ ഗുരോ ഹേ ഗുരോ പ്രാണാ നോ യാന്തീതി ഗദിത്വാ തം ജാഗരയാമ്ബഭൂവുഃ| തദാ സ ഉത്ഥായ വായും തരങ്ഗാംശ്ച തർജയാമാസ തസ്മാദുഭൗ നിവൃത്യ സ്ഥിരൗ ബഭൂവതുഃ|</para>
  <para style="p">
    <verse number="25" style="v"/>സ താൻ ബഭാഷേ യുഷ്മാകം വിശ്വാസഃ ക? തസ്മാത്തേ ഭീതാ വിസ്മിതാശ്ച പരസ്പരം ജഗദുഃ, അഹോ കീദൃഗയം മനുജഃ പവനം പാനീയഞ്ചാദിശതി തദുഭയം തദാദേശം വഹതി|</para>
  <para style="p">
    <verse number="26" style="v"/>തതഃ പരം ഗാലീൽപ്രദേശസ്യ സമ്മുഖസ്ഥഗിദേരീയപ്രദേശേ നൗകായാം ലഗന്ത്യാം തടേഽവരോഹമാവാദ്</para>
  <para style="p">
    <verse number="27" style="v"/>ബഹുതിഥകാലം ഭൂതഗ്രസ്ത ഏകോ മാനുഷഃ പുരാദാഗത്യ തം സാക്ഷാച്ചകാര| സ മനുഷോ വാസോ ന പരിദധത് ഗൃഹേ ച ന വസൻ കേവലം ശ്മശാനമ് അധ്യുവാസ|</para>
  <para style="p">
    <verse number="28" style="v"/>സ യീശും ദൃഷ്ട്വൈവ ചീച്ഛബ്ദം ചകാര തസ്യ സമ്മുഖേ പതിത്വാ പ്രോച്ചൈർജഗാദ ച, ഹേ സർവ്വപ്രധാനേശ്വരസ്യ പുത്ര, മയാ സഹ തവ കഃ സമ്ബന്ധഃ? ത്വയി വിനയം കരോമി മാം മാ യാതയ|</para>
  <para style="p">
    <verse number="29" style="v"/>യതഃ സ തം മാനുഷം ത്യക്ത്വാ യാതുമ് അമേധ്യഭൂതമ് ആദിദേശ; സ ഭൂതസ്തം മാനുഷമ് അസകൃദ് ദധാര തസ്മാല്ലോകാഃ ശൃങ്ഖലേന നിഗഡേന ച ബബന്ധുഃ; സ തദ് ഭംക്ത്വാ ഭൂതവശത്വാത് മധ്യേപ്രാന്തരം യയൗ|</para>
  <para style="p">
    <verse number="30" style="v"/>അനന്തരം യീശുസ്തം പപ്രച്ഛ തവ കിന്നാമ? സ ഉവാച, മമ നാമ ബാഹിനോ യതോ ബഹവോ ഭൂതാസ്തമാശിശ്രിയുഃ|</para>
  <para style="p">
    <verse number="31" style="v"/>അഥ ഭൂതാ വിനയേന ജഗദുഃ, ഗഭീരം ഗർത്തം ഗന്തും മാജ്ഞാപയാസ്മാൻ|</para>
  <para style="p">
    <verse number="32" style="v"/>തദാ പർവ്വതോപരി വരാഹവ്രജശ്ചരതി തസ്മാദ് ഭൂതാ വിനയേന പ്രോചുഃ, അമും വരാഹവ്രജമ് ആശ്രയിതുമ് അസ്മാൻ അനുജാനീഹി; തതഃ സോനുജജ്ഞൗ|</para>
  <para style="p">
    <verse number="33" style="v"/>തതഃ പരം ഭൂതാസ്തം മാനുഷം വിഹായ വരാഹവ്രജമ് ആശിശ്രിയുഃ വരാഹവ്രജാശ്ച തത്ക്ഷണാത് കടകേന ധാവന്തോ ഹ്രദേ പ്രാണാൻ വിജൃഹുഃ|</para>
  <para style="p">
    <verse number="34" style="v"/>തദ് ദൃഷ്ട്വാ ശൂകരരക്ഷകാഃ പലായമാനാ നഗരം ഗ്രാമഞ്ച ഗത്വാ തത്സർവ്വവൃത്താന്തം കഥയാമാസുഃ|</para>
  <para style="p">
    <verse number="35" style="v"/>തതഃ കിം വൃത്തമ് ഏതദ്ദർശനാർഥം ലോകാ നിർഗത്യ യീശോഃ സമീപം യയുഃ, തം മാനുഷം ത്യക്തഭൂതം പരിഹിതവസ്ത്രം സ്വസ്ഥമാനുഷവദ് യീശോശ്ചരണസന്നിധൗ സൂപവിശന്തം വിലോക്യ ബിഭ്യുഃ|</para>
  <para style="p">
    <verse number="36" style="v"/>യേ ലോകാസ്തസ്യ ഭൂതഗ്രസ്തസ്യ സ്വാസ്ഥ്യകരണം ദദൃശുസ്തേ തേഭ്യഃ സർവ്വവൃത്താന്തം കഥയാമാസുഃ|</para>
  <para style="p">
    <verse number="37" style="v"/>തദനന്തരം തസ്യ ഗിദേരീയപ്രദേശസ്യ ചതുർദിക്സ്ഥാ ബഹവോ ജനാ അതിത്രസ്താ വിനയേന തം ജഗദുഃ, ഭവാൻ അസ്മാകം നികടാദ് വ്രജതു തസ്മാത് സ നാവമാരുഹ്യ തതോ വ്യാഘുട്യ ജഗാമ|</para>
  <para style="p">
    <verse number="38" style="v"/>തദാനീം ത്യക്തഭൂതമനുജസ്തേന സഹ സ്ഥാതും പ്രാർഥയാഞ്ചക്രേ</para>
  <para style="p">
    <verse number="39" style="v"/>കിന്തു തദർഥമ് ഈശ്വരഃ കീദൃങ്മഹാകർമ്മ കൃതവാൻ ഇതി നിവേശനം ഗത്വാ വിജ്ഞാപയ, യീശുഃ കഥാമേതാം കഥയിത്വാ തം വിസസർജ| തതഃ സ വ്രജിത്വാ യീശുസ്തദർഥം യന്മഹാകർമ്മ ചകാര തത് പുരസ്യ സർവ്വത്ര പ്രകാശയിതും പ്രാരേഭേ|</para>
  <para style="p">
    <verse number="40" style="v"/>അഥ യീശൗ പരാവൃത്യാഗതേ ലോകാസ്തം ആദരേണ ജഗൃഹു ര്യസ്മാത്തേ സർവ്വേ തമപേക്ഷാഞ്ചക്രിരേ|</para>
  <para style="p">
    <verse number="41" style="v"/>തദനന്തരം യായീർനാമ്നോ ഭജനഗേഹസ്യൈകോധിപ ആഗത്യ യീശോശ്ചരണയോഃ പതിത്വാ സ്വനിവേശനാഗമനാർഥം തസ്മിൻ വിനയം ചകാര,</para>
  <para style="p">
    <verse number="42" style="v"/>യതസ്തസ്യ ദ്വാദശവർഷവയസ്കാ കന്യൈകാസീത് സാ മൃതകൽപാഭവത്| തതസ്തസ്യ ഗമനകാലേ മാർഗേ ലോകാനാം മഹാൻ സമാഗമോ ബഭൂവ|</para>
  <para style="p">
    <verse number="43" style="v"/>ദ്വാദശവർഷാണി പ്രദരരോഗഗ്രസ്താ നാനാ വൈദ്യൈശ്ചികിത്സിതാ സർവ്വസ്വം വ്യയിത്വാപി സ്വാസ്ഥ്യം ന പ്രാപ്താ യാ യോഷിത് സാ യീശോഃ പശ്ചാദാഗത്യ തസ്യ വസ്ത്രഗ്രന്ഥിം പസ്പർശ|</para>
  <para style="p">
    <verse number="44" style="v"/>തസ്മാത് തത്ക്ഷണാത് തസ്യാ രക്തസ്രാവോ രുദ്ധഃ|</para>
  <para style="p">
    <verse number="45" style="v"/>തദാനീം യീശുരവദത് കേനാഹം സ്പൃഷ്ടഃ? തതോഽനേകൈരനങ്ഗീകൃതേ പിതരസ്തസ്യ സങ്ഗിനശ്ചാവദൻ, ഹേ ഗുരോ ലോകാ നികടസ്ഥാഃ സന്തസ്തവ ദേഹേ ഘർഷയന്തി, തഥാപി കേനാഹം സ്പൃഷ്ടഇതി ഭവാൻ കുതഃ പൃച്ഛതി?</para>
  <para style="p">
    <verse number="46" style="v"/>യീശുഃ കഥയാമാസ, കേനാപ്യഹം സ്പൃഷ്ടോ, യതോ മത്തഃ ശക്തി ർനിർഗതേതി മയാ നിശ്ചിതമജ്ഞായി|</para>
  <para style="p">
    <verse number="47" style="v"/>തദാ സാ നാരീ സ്വയം ന ഗുപ്തേതി വിദിത്വാ കമ്പമാനാ സതീ തസ്യ സമ്മുഖേ പപാത; യേന നിമിത്തേന തം പസ്പർശ സ്പർശമാത്രാച്ച യേന പ്രകാരേണ സ്വസ്ഥാഭവത് തത് സർവ്വം തസ്യ സാക്ഷാദാചഖ്യൗ|</para>
  <para style="p">
    <verse number="48" style="v"/>തതഃ സ താം ജഗാദ ഹേ കന്യേ സുസ്ഥിരാ ഭവ, തവ വിശ്വാസസ്ത്വാം സ്വസ്ഥാമ് അകാർഷീത് ത്വം ക്ഷേമേണ യാഹി|</para>
  <para style="p">
    <verse number="49" style="v"/>യീശോരേതദ്വാക്യവദനകാലേ തസ്യാധിപതേ ർനിവേശനാത് കശ്ചില്ലോക ആഗത്യ തം ബഭാഷേ, തവ കന്യാ മൃതാ ഗുരും മാ ക്ലിശാന|</para>
  <para style="p">
    <verse number="50" style="v"/>കിന്തു യീശുസ്തദാകർണ്യാധിപതിം വ്യാജഹാര, മാ ഭൈഷീഃ കേവലം വിശ്വസിഹി തസ്മാത് സാ ജീവിഷ്യതി|</para>
  <para style="p">
    <verse number="51" style="v"/>അഥ തസ്യ നിവേശനേ പ്രാപ്തേ സ പിതരം യോഹനം യാകൂബഞ്ച കന്യായാ മാതരം പിതരഞ്ച വിനാ, അന്യം കഞ്ചന പ്രവേഷ്ടും വാരയാമാസ|</para>
  <para style="p">
    <verse number="52" style="v"/>അപരഞ്ച യേ രുദന്തി വിലപന്തി ച താൻ സർവ്വാൻ ജനാൻ ഉവാച, യൂയം മാ രോദിഷ്ട കന്യാ ന മൃതാ നിദ്രാതി|</para>
  <para style="p">
    <verse number="53" style="v"/>കിന്തു സാ നിശ്ചിതം മൃതേതി ജ്ഞാത്വാ തേ തമുപജഹസുഃ|</para>
  <para style="p">
    <verse number="54" style="v"/>പശ്ചാത് സ സർവ്വാൻ ബഹിഃ കൃത്വാ കന്യായാഃ കരൗ ധൃത്വാജുഹുവേ, ഹേ കന്യേ ത്വമുത്തിഷ്ഠ,</para>
  <para style="p">
    <verse number="55" style="v"/>തസ്മാത് തസ്യാഃ പ്രാണേഷു പുനരാഗതേഷു സാ തത്ക്ഷണാദ് ഉത്തസ്യൗ| തദാനീം തസ്യൈ കിഞ്ചിദ് ഭക്ഷ്യം ദാതുമ് ആദിദേശ|</para>
  <para style="p">
    <verse number="56" style="v"/>തതസ്തസ്യാഃ പിതരൗ വിസ്മയം ഗതൗ കിന്തു സ താവാദിദേശ ഘടനായാ ഏതസ്യാഃ കഥാം കസ്മൈചിദപി മാ കഥയതം|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>തതഃ പരം സ ദ്വാദശശിഷ്യാനാഹൂയ ഭൂതാൻ ത്യാജയിതും രോഗാൻ പ്രതികർത്തുഞ്ച തേഭ്യഃ ശക്തിമാധിപത്യഞ്ച ദദൗ|</para>
  <para style="p">
    <verse number="2" style="v"/>അപരഞ്ച ഈശ്വരീയരാജ്യസ്യ സുസംവാദം പ്രകാശയിതുമ് രോഗിണാമാരോഗ്യം കർത്തുഞ്ച പ്രേരണകാലേ താൻ ജഗാദ|</para>
  <para style="p">
    <verse number="3" style="v"/>യാത്രാർഥം യഷ്ടി ർവസ്ത്രപുടകം ഭക്ഷ്യം മുദ്രാ ദ്വിതീയവസ്ത്രമ്, ഏഷാം കിമപി മാ ഗൃഹ്ലീത|</para>
  <para style="p">
    <verse number="4" style="v"/>യൂയഞ്ച യന്നിവേശനം പ്രവിശഥ നഗരത്യാഗപര്യ്യനതം തന്നിവേശനേ തിഷ്ഠത|</para>
  <para style="p">
    <verse number="5" style="v"/>തത്ര യദി കസ്യചിത് പുരസ്യ ലോകാ യുഷ്മാകമാതിഥ്യം ന കുർവ്വന്തി തർഹി തസ്മാന്നഗരാദ് ഗമനകാലേ തേഷാം വിരുദ്ധം സാക്ഷ്യാർഥം യുഷ്മാകം പദധൂലീഃ സമ്പാതയത|</para>
  <para style="p">
    <verse number="6" style="v"/>അഥ തേ പ്രസ്ഥായ സർവ്വത്ര സുസംവാദം പ്രചാരയിതും പീഡിതാൻ സ്വസ്ഥാൻ കർത്തുഞ്ച ഗ്രാമേഷു ഭ്രമിതും പ്രാരേഭിരേ|</para>
  <para style="p">
    <verse number="7" style="v"/>ഏതർഹി ഹേരോദ് രാജാ യീശോഃ സർവ്വകർമ്മണാം വാർത്താം ശ്രുത്വാ ഭൃശമുദ്വിവിജേ</para>
  <para style="p">
    <verse number="8" style="v"/>യതഃ കേചിദൂചുര്യോഹൻ ശ്മശാനാദുദതിഷ്ഠത്| കേചിദൂചുഃ, ഏലിയോ ദർശനം ദത്തവാൻ; ഏവമന്യലോകാ ഊചുഃ പൂർവ്വീയഃ കശ്ചിദ് ഭവിഷ്യദ്വാദീ സമുത്ഥിതഃ|</para>
  <para style="p">
    <verse number="9" style="v"/>കിന്തു ഹേരോദുവാച യോഹനഃ ശിരോഽഹമഛിനദമ് ഇദാനീം യസ്യേദൃക്കർമ്മണാം വാർത്താം പ്രാപ്നോമി സ കഃ? അഥ സ തം ദ്രഷ്ടുമ് ഐച്ഛത്|</para>
  <para style="p">
    <verse number="10" style="v"/>അനന്തരം പ്രേരിതാഃ പ്രത്യാഗത്യ യാനി യാനി കർമ്മാണി ചക്രുസ്താനി യീശവേ കഥയാമാസുഃ തതഃ സ താൻ ബൈത്സൈദാനാമകനഗരസ്യ വിജനം സ്ഥാനം നീത്വാ ഗുപ്തം ജഗാമ|</para>
  <para style="p">
    <verse number="11" style="v"/>പശ്ചാൽ ലോകാസ്തദ് വിദിത്വാ തസ്യ പശ്ചാദ് യയുഃ; തതഃ സ താൻ നയൻ ഈശ്വരീയരാജ്യസ്യ പ്രസങ്ഗമുക്തവാൻ, യേഷാം ചികിത്സയാ പ്രയോജനമ് ആസീത് താൻ സ്വസ്ഥാൻ ചകാര ച|</para>
  <para style="p">
    <verse number="12" style="v"/>അപരഞ്ച ദിവാവസന്നേ സതി ദ്വാദശശിഷ്യാ യീശോരന്തികമ് ഏത്യ കഥയാമാസുഃ, വയമത്ര പ്രാന്തരസ്ഥാനേ തിഷ്ഠാമഃ, തതോ നഗരാണി ഗ്രാമാണി ഗത്വാ വാസസ്ഥാനാനി പ്രാപ്യ ഭക്ഷ്യദ്രവ്യാണി ക്രേതും ജനനിവഹം ഭവാൻ വിസൃജതു|</para>
  <para style="p">
    <verse number="13" style="v"/>തദാ സ ഉവാച, യൂയമേവ താൻ ഭേജയധ്വം; തതസ്തേ പ്രോചുരസ്മാകം നികടേ കേവലം പഞ്ച പൂപാ ദ്വൗ മത്സ്യൗ ച വിദ്യന്തേ, അതഏവ സ്ഥാനാന്തരമ് ഇത്വാ നിമിത്തമേതേഷാം ഭക്ഷ്യദ്രവ്യേഷു ന ക്രീതേഷു ന ഭവതി|</para>
  <para style="p">
    <verse number="14" style="v"/>തത്ര പ്രായേണ പഞ്ചസഹസ്രാണി പുരുഷാ ആസൻ|</para>
  <para style="p">
    <verse number="15" style="v"/>തദാ സ ശിഷ്യാൻ ജഗാദ പഞ്ചാശത് പഞ്ചാശജ്ജനൈഃ പംക്തീകൃത്യ താനുപവേശയത, തസ്മാത് തേ തദനുസാരേണ സർവ്വലോകാനുപവേശയാപാസുഃ|</para>
  <para style="p">
    <verse number="16" style="v"/>തതഃ സ താൻ പഞ്ച പൂപാൻ മീനദ്വയഞ്ച ഗൃഹീത്വാ സ്വർഗം വിലോക്യേശ്വരഗുണാൻ കീർത്തയാഞ്ചക്രേ ഭങ്ക്താ ച ലോകേഭ്യഃ പരിവേഷണാർഥം ശിഷ്യേഷു സമർപയാമ്ബഭൂവ|</para>
  <para style="p">
    <verse number="17" style="v"/>തതഃ സർവ്വേ ഭുക്ത്വാ തൃപ്തിം ഗതാ അവശിഷ്ടാനാഞ്ച ദ്വാദശ ഡല്ലകാൻ സംജഗൃഹുഃ|</para>
  <para style="p">
    <verse number="18" style="v"/>അഥൈകദാ നിർജനേ ശിഷ്യൈഃ സഹ പ്രാർഥനാകാലേ താൻ പപ്രച്ഛ, ലോകാ മാം കം വദന്തി?</para>
  <para style="p">
    <verse number="19" style="v"/>തതസ്തേ പ്രാചുഃ, ത്വാം യോഹന്മജ്ജകം വദന്തി; കേചിത് ത്വാമ് ഏലിയം വദന്തി, പൂർവ്വകാലികഃ കശ്ചിദ് ഭവിഷ്യദ്വാദീ ശ്മശാനാദ് ഉദതിഷ്ഠദ് ഇത്യപി കേചിദ് വദന്തി|</para>
  <para style="p">
    <verse number="20" style="v"/>തദാ സ ഉവാച, യൂയം മാം കം വദഥ? തതഃ പിതര ഉക്തവാൻ ത്വമ് ഈശ്വരാഭിഷിക്തഃ പുരുഷഃ|</para>
  <para style="p">
    <verse number="21" style="v"/>തദാ സ താൻ ദൃഢമാദിദേശ, കഥാമേതാം കസ്മൈചിദപി മാ കഥയത|</para>
  <para style="p">
    <verse number="22" style="v"/>സ പുനരുവാച, മനുഷ്യപുത്രേണ വഹുയാതനാ ഭോക്തവ്യാഃ പ്രാചീനലോകൈഃ പ്രധാനയാജകൈരധ്യാപകൈശ്ച സോവജ്ഞായ ഹന്തവ്യഃ കിന്തു തൃതീയദിവസേ ശ്മശാനാത് തേനോത്ഥാതവ്യമ്|</para>
  <para style="p">
    <verse number="23" style="v"/>അപരം സ സർവ്വാനുവാച, കശ്ചിദ് യദി മമ പശ്ചാദ് ഗന്തും വാഞ്ഛതി തർഹി സ സ്വം ദാമ്യതു, ദിനേ ദിനേ ക്രുശം ഗൃഹീത്വാ ച മമ പശ്ചാദാഗച്ഛതു|</para>
  <para style="p">
    <verse number="24" style="v"/>യതോ യഃ കശ്ചിത് സ്വപ്രാണാൻ രിരക്ഷിഷതി സ താൻ ഹാരയിഷ്യതി, യഃ കശ്ചിൻ മദർഥം പ്രാണാൻ ഹാരയിഷ്യതി സ താൻ രക്ഷിഷ്യതി|</para>
  <para style="p">
    <verse number="25" style="v"/>കശ്ചിദ് യദി സർവ്വം ജഗത് പ്രാപ്നോതി കിന്തു സ്വപ്രാണാൻ ഹാരയതി സ്വയം വിനശ്യതി ച തർഹി തസ്യ കോ ലാഭഃ?</para>
  <para style="p">
    <verse number="26" style="v"/>പുന ര്യഃ കശ്ചിൻ മാം മമ വാക്യം വാ ലജ്ജാസ്പദം ജാനാതി മനുഷ്യപുത്രോ യദാ സ്വസ്യ പിതുശ്ച പവിത്രാണാം ദൂതാനാഞ്ച തേജോഭിഃ പരിവേഷ്ടിത ആഗമിഷ്യതി തദാ സോപി തം ലജ്ജാസ്പദം ജ്ഞാസ്യതി|</para>
  <para style="p">
    <verse number="27" style="v"/>കിന്തു യുഷ്മാനഹം യഥാർഥം വദാമി, ഈശ്വരീയരാജത്വം ന ദൃഷ്ടവാ മൃത്യും നാസ്വാദിഷ്യന്തേ, ഏതാദൃശാഃ കിയന്തോ ലോകാ അത്ര സ്ഥനേഽപി ദണ്ഡായമാനാഃ സന്തി|</para>
  <para style="p">
    <verse number="28" style="v"/>ഏതദാഖ്യാനകഥനാത് പരം പ്രായേണാഷ്ടസു ദിനേഷു ഗതേഷു സ പിതരം യോഹനം യാകൂബഞ്ച ഗൃഹീത്വാ പ്രാർഥയിതും പർവ്വതമേകം സമാരുരോഹ|</para>
  <para style="p">
    <verse number="29" style="v"/>അഥ തസ്യ പ്രാർഥനകാലേ തസ്യ മുഖാകൃതിരന്യരൂപാ ജാതാ, തദീയം വസ്ത്രമുജ്ജ്വലശുക്ലം ജാതം|</para>
  <para style="p">
    <verse number="30" style="v"/>അപരഞ്ച മൂസാ ഏലിയശ്ചോഭൗ തേജസ്വിനൗ ദൃഷ്ടൗ</para>
  <para style="p">
    <verse number="31" style="v"/>തൗ തേന യിരൂശാലമ്പുരേ യോ മൃത്യുഃ സാധിഷ്യതേ തദീയാം കഥാം തേന സാർദ്ധം കഥയിതുമ് ആരേഭാതേ|</para>
  <para style="p">
    <verse number="32" style="v"/>തദാ പിതരാദയഃ സ്വസ്യ സങ്ഗിനോ നിദ്രയാകൃഷ്ടാ ആസൻ കിന്തു ജാഗരിത്വാ തസ്യ തേജസ്തേന സാർദ്ധമ് ഉത്തിഷ്ഠന്തൗ ജനൗ ച ദദൃശുഃ|</para>
  <para style="p">
    <verse number="33" style="v"/>അഥ തയോരുഭയോ ർഗമനകാലേ പിതരോ യീശും ബഭാഷേ, ഹേ ഗുരോഽസ്മാകം സ്ഥാനേഽസ്മിൻ സ്ഥിതിഃ ശുഭാ, തത ഏകാ ത്വദർഥാ, ഏകാ മൂസാർഥാ, ഏകാ ഏലിയാർഥാ, ഇതി തിസ്രഃ കുട്യോസ്മാഭി ർനിർമ്മീയന്താം, ഇമാം കഥാം സ ന വിവിച്യ കഥയാമാസ|</para>
  <para style="p">
    <verse number="34" style="v"/>അപരഞ്ച തദ്വാക്യവദനകാലേ പയോദ ഏക ആഗത്യ തേഷാമുപരി ഛായാം ചകാര, തതസ്തന്മധ്യേ തയോഃ പ്രവേശാത് തേ ശശങ്കിരേ|</para>
  <para style="p">
    <verse number="35" style="v"/>തദാ തസ്മാത് പയോദാദ് ഇയമാകാശീയാ വാണീ നിർജഗാമ, മമായം പ്രിയഃ പുത്ര ഏതസ്യ കഥായാം മനോ നിധത്ത|</para>
  <para style="p">
    <verse number="36" style="v"/>ഇതി ശബ്ദേ ജാതേ തേ യീശുമേകാകിനം ദദൃശുഃ കിന്തു തേ തദാനീം തസ്യ ദർശനസ്യ വാചമേകാമപി നോക്ത്വാ മനഃസു സ്ഥാപയാമാസുഃ|</para>
  <para style="p">
    <verse number="37" style="v"/>പരേഽഹനി തേഷു തസ്മാച്ഛൈലാദ് അവരൂഢേഷു തം സാക്ഷാത് കർത്തും ബഹവോ ലോകാ ആജഗ്മുഃ|</para>
  <para style="p">
    <verse number="38" style="v"/>തേഷാം മധ്യാദ് ഏകോ ജന ഉച്ചൈരുവാച, ഹേ ഗുരോ അഹം വിനയം കരോമി മമ പുത്രം പ്രതി കൃപാദൃഷ്ടിം കരോതു, മമ സ ഏവൈകഃ പുത്രഃ|</para>
  <para style="p">
    <verse number="39" style="v"/>ഭൂതേന ധൃതഃ സൻ സം പ്രസഭം ചീച്ഛബ്ദം കരോതി തന്മുഖാത് ഫേണാ നിർഗച്ഛന്തി ച, ഭൂത ഇത്ഥം വിദാര്യ്യ ക്ലിഷ്ട്വാ പ്രായശസ്തം ന ത്യജതി|</para>
  <para style="p">
    <verse number="40" style="v"/>തസ്മാത് തം ഭൂതം ത്യാജയിതും തവ ശിഷ്യസമീപേ ന്യവേദയം കിന്തു തേ ന ശേകുഃ|</para>
  <para style="p">
    <verse number="41" style="v"/>തദാ യീശുരവാദീത്, രേ ആവിശ്വാസിൻ വിപഥഗാമിൻ വംശ കതികാലാൻ യുഷ്മാഭിഃ സഹ സ്ഥാസ്യാമ്യഹം യുഷ്മാകമ് ആചരണാനി ച സഹിഷ്യേ? തവ പുത്രമിഹാനയ|</para>
  <para style="p">
    <verse number="42" style="v"/>തതസ്തസ്മിന്നാഗതമാത്രേ ഭൂതസ്തം ഭൂമൗ പാതയിത്വാ വിദദാര; തദാ യീശുസ്തമമേധ്യം ഭൂതം തർജയിത്വാ ബാലകം സ്വസ്ഥം കൃത്വാ തസ്യ പിതരി സമർപയാമാസ|</para>
  <para style="p">
    <verse number="43" style="v"/>ഈശ്വരസ്യ മഹാശക്തിമ് ഇമാം വിലോക്യ സർവ്വേ ചമച്ചക്രുഃ; ഇത്ഥം യീശോഃ സർവ്വാഭിഃ ക്രിയാഭിഃ സർവ്വൈർലോകൈരാശ്ചര്യ്യേ മന്യമാനേ സതി സ ശിഷ്യാൻ ബഭാഷേ,</para>
  <para style="p">
    <verse number="44" style="v"/>കഥേയം യുഷ്മാകം കർണേഷു പ്രവിശതു, മനുഷ്യപുത്രോ മനുഷ്യാണാം കരേഷു സമർപയിഷ്യതേ|</para>
  <para style="p">
    <verse number="45" style="v"/>കിന്തു തേ താം കഥാം ന ബുബുധിരേ, സ്പഷ്ടത്വാഭാവാത് തസ്യാ അഭിപ്രായസ്തേഷാം ബോധഗമ്യോ ന ബഭൂവ; തസ്യാ ആശയഃ ക ഇത്യപി തേ ഭയാത് പ്രഷ്ടും ന ശേകുഃ|</para>
  <para style="p">
    <verse number="46" style="v"/>തദനന്തരം തേഷാം മധ്യേ കഃ ശ്രേഷ്ഠഃ കഥാമേതാം ഗൃഹീത്വാ തേ മിഥോ വിവാദം ചക്രുഃ|</para>
  <para style="p">
    <verse number="47" style="v"/>തതോ യീശുസ്തേഷാം മനോഭിപ്രായം വിദിത്വാ ബാലകമേകം ഗൃഹീത്വാ സ്വസ്യ നികടേ സ്ഥാപയിത്വാ താൻ ജഗാദ,</para>
  <para style="p">
    <verse number="48" style="v"/>യോ ജനോ മമ നാമ്നാസ്യ ബാലാസ്യാതിഥ്യം വിദധാതി സ മമാതിഥ്യം വിദധാതി, യശ്ച മമാതിഥ്യം വിദധാതി സ മമ പ്രേരകസ്യാതിഥ്യം വിദധാതി, യുഷ്മാകം മധ്യേയഃ സ്വം സർവ്വസ്മാത് ക്ഷുദ്രം ജാനീതേ സ ഏവ ശ്രേഷ്ഠോ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="49" style="v"/>അപരഞ്ച യോഹൻ വ്യാജഹാര ഹേ പ്രഭേा തവ നാമ്നാ ഭൂതാൻ ത്യാജയന്തം മാനുഷമ് ഏകം ദൃഷ്ടവന്തോ വയം, കിന്ത്വസ്മാകമ് അപശ്ചാദ് ഗാമിത്വാത് തം ന്യഷേധാമ്| തദാനീം യീശുരുവാച,</para>
  <para style="p">
    <verse number="50" style="v"/>തം മാ നിഷേധത, യതോ യോ ജനോസ്മാകം ന വിപക്ഷഃ സ ഏവാസ്മാകം സപക്ഷോ ഭവതി|</para>
  <para style="p">
    <verse number="51" style="v"/>അനന്തരം തസ്യാരോഹണസമയ ഉപസ്ഥിതേ സ സ്ഥിരചേതാ യിരൂശാലമം പ്രതി യാത്രാം കർത്തും നിശ്ചിത്യാഗ്രേ ദൂതാൻ പ്രേഷയാമാസ|</para>
  <para style="p">
    <verse number="52" style="v"/>തസ്മാത് തേ ഗത്വാ തസ്യ പ്രയോജനീയദ്രവ്യാണി സംഗ്രഹീതും ശോമിരോണീയാനാം ഗ്രാമം പ്രവിവിശുഃ|</para>
  <para style="p">
    <verse number="53" style="v"/>കിന്തു സ യിരൂശാലമം നഗരം യാതി തതോ ഹേതോ ർലോകാസ്തസ്യാതിഥ്യം ന ചക്രുഃ|</para>
  <para style="p">
    <verse number="54" style="v"/>അതഏവ യാകൂബ്യോഹനൗ തസ്യ ശിഷ്യൗ തദ് ദൃഷ്ട്വാ ജഗദതുഃ, ഹേ പ്രഭോ ഏലിയോ യഥാ ചകാര തഥാ വയമപി കിം ഗഗണാദ് ആഗന്തുമ് ഏതാൻ ഭസ്മീകർത്തുഞ്ച വഹ്നിമാജ്ഞാപയാമഃ? ഭവാൻ കിമിച്ഛതി?</para>
  <para style="p">
    <verse number="55" style="v"/>കിന്തു സ മുഖം പരാവർത്യ താൻ തർജയിത്വാ ഗദിതവാൻ യുഷ്മാകം മനോഭാവഃ കഃ, ഇതി യൂയം ന ജാനീഥ|</para>
  <para style="p">
    <verse number="56" style="v"/>മനുജസുതോ മനുജാനാം പ്രാണാൻ നാശയിതും നാഗച്ഛത്, കിന്തു രക്ഷിതുമ് ആഗച്ഛത്| പശ്ചാദ് ഇതരഗ്രാമം തേ യയുഃ|</para>
  <para style="p">
    <verse number="57" style="v"/>തദനന്തരം പഥി ഗമനകാലേ ജന ഏകസ്തം ബഭാഷേ, ഹേ പ്രഭോ ഭവാൻ യത്ര യാതി ഭവതാ സഹാഹമപി തത്ര യാസ്യാമി|</para>
  <para style="p">
    <verse number="58" style="v"/>തദാനീം യീശുസ്തമുവാച, ഗോമായൂനാം ഗർത്താ ആസതേ, വിഹായസീയവിഹഗാाനാം നീഡാനി ച സന്തി, കിന്തു മാനവതനയസ്യ ശിരഃ സ്ഥാപയിതും സ്ഥാനം നാസ്തി|</para>
  <para style="p">
    <verse number="59" style="v"/>തതഃ പരം സ ഇതരജനം ജഗാദ, ത്വം മമ പശ്ചാദ് ഏഹി; തതഃ സ ഉവാച, ഹേ പ്രഭോ പൂർവ്വം പിതരം ശ്മശാനേ സ്ഥാപയിതും മാമാദിശതു|</para>
  <para style="p">
    <verse number="60" style="v"/>തദാ യീശുരുവാച, മൃതാ മൃതാൻ ശ്മശാനേ സ്ഥാപയന്തു കിന്തു ത്വം ഗത്വേശ്വരീയരാജ്യസ്യ കഥാം പ്രചാരയ|</para>
  <para style="p">
    <verse number="61" style="v"/>തതോന്യഃ കഥയാമാസ, ഹേ പ്രഭോ മയാപി ഭവതഃ പശ്ചാദ് ഗംസ്യതേ, കിന്തു പൂർവ്വം മമ നിവേശനസ്യ പരിജനാനാമ് അനുമതിം ഗ്രഹീതുമ് അഹമാദിശ്യൈ ഭവതാ|</para>
  <para style="p">
    <verse number="62" style="v"/>തദാനീം യീശുസ്തം പ്രോക്തവാൻ, യോ ജനോ ലാങ്ഗലേ കരമർപയിത്വാ പശ്ചാത് പശ്യതി സ ഈശ്വരീയരാജ്യം നാർഹതി|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>തതഃ പരം പ്രഭുരപരാൻ സപ്തതിശിഷ്യാൻ നിയുജ്യ സ്വയം യാനി നഗരാണി യാനി സ്ഥാനാനി ച ഗമിഷ്യതി താനി നഗരാണി താനി സ്ഥാനാനി ച പ്രതി ദ്വൗ ദ്വൗ ജനൗ പ്രഹിതവാൻ|</para>
  <para style="p">
    <verse number="2" style="v"/>തേഭ്യഃ കഥയാമാസ ച ശസ്യാനി ബഹൂനീതി സത്യം കിന്തു ഛേദകാ അൽപേ; തസ്മാദ്ധേതോഃ ശസ്യക്ഷേത്രേ ഛേദകാൻ അപരാനപി പ്രേഷയിതും ക്ഷേത്രസ്വാമിനം പ്രാർഥയധ്വം|</para>
  <para style="p">
    <verse number="3" style="v"/>യൂയം യാത, പശ്യത, വൃകാണാം മധ്യേ മേഷശാവകാനിവ യുഷ്മാൻ പ്രഹിണോമി|</para>
  <para style="p">
    <verse number="4" style="v"/>യൂയം ക്ഷുദ്രം മഹദ് വാ വസനസമ്പുടകം പാദുകാശ്ച മാ ഗൃഹ്ലീത, മാർഗമധ്യേ കമപി മാ നമത ച|</para>
  <para style="p">
    <verse number="5" style="v"/>അപരഞ്ച യൂയം യദ് യത് നിവേശനം പ്രവിശഥ തത്ര നിവേശനസ്യാസ്യ മങ്ഗലം ഭൂയാദിതി വാക്യം പ്രഥമം വദത|</para>
  <para style="p">
    <verse number="6" style="v"/>തസ്മാത് തസ്മിൻ നിവേശനേ യദി മങ്ഗലപാത്രം സ്ഥാസ്യതി തർഹി തന്മങ്ഗലം തസ്യ ഭവിഷ്യതി, നോചേത് യുഷ്മാൻ പ്രതി പരാവർത്തിഷ്യതേ|</para>
  <para style="p">
    <verse number="7" style="v"/>അപരഞ്ച തേ യത്കിഞ്ചിദ് ദാസ്യന്തി തദേവ ഭുക്ത്വാ പീത്വാ തസ്മിന്നിവേശനേ സ്ഥാസ്യഥ; യതഃ കർമ്മകാരീ ജനോ ഭൃതിമ് അർഹതി; ഗൃഹാദ് ഗൃഹം മാ യാസ്യഥ|</para>
  <para style="p">
    <verse number="8" style="v"/>അന്യച്ച യുഷ്മാസു കിമപി നഗരം പ്രവിഷ്ടേഷു ലോകാ യദി യുഷ്മാകമ് ആതിഥ്യം കരിഷ്യന്തി, തർഹി യത് ഖാദ്യമ് ഉപസ്ഥാസ്യന്തി തദേവ ഖാദിഷ്യഥ|</para>
  <para style="p">
    <verse number="9" style="v"/>തന്നഗരസ്ഥാൻ രോഗിണഃ സ്വസ്ഥാൻ കരിഷ്യഥ, ഈശ്വരീയം രാജ്യം യുഷ്മാകമ് അന്തികമ് ആഗമത് കഥാമേതാഞ്ച പ്രചാരയിഷ്യഥ|</para>
  <para style="p">
    <verse number="10" style="v"/>കിന്തു കിമപി പുരം യുഷ്മാസു പ്രവിഷ്ടേഷു ലോകാ യദി യുഷ്മാകമ് ആതിഥ്യം ന കരിഷ്യന്തി, തർഹി തസ്യ നഗരസ്യ പന്ഥാനം ഗത്വാ കഥാമേതാം വദിഷ്യഥ,</para>
  <para style="p">
    <verse number="11" style="v"/>യുഷ്മാകം നഗരീയാ യാ ധൂല്യോഽസ്മാസു സമലഗൻ താ അപി യുഷ്മാകം പ്രാതികൂല്യേന സാക്ഷ്യാർഥം സമ്പാതയാമഃ; തഥാപീശ്വരരാജ്യം യുഷ്മാകം സമീപമ് ആഗതമ് ഇതി നിശ്ചിതം ജാനീത|</para>
  <para style="p">
    <verse number="12" style="v"/>അഹം യുഷ്മഭ്യം യഥാർഥം കഥയാമി, വിചാരദിനേ തസ്യ നഗരസ്യ ദശാതഃ സിദോമോ ദശാ സഹ്യാ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="13" style="v"/>ഹാ ഹാ കോരാസീൻ നഗര, ഹാ ഹാ ബൈത്സൈദാനഗര യുവയോർമധ്യേ യാദൃശാനി ആശ്ചര്യ്യാണി കർമ്മാണ്യക്രിയന്ത, താനി കർമ്മാണി യദി സോരസീദോനോ ർനഗരയോരകാരിഷ്യന്ത, തദാ ഇതോ ബഹുദിനപൂർവ്വം തന്നിവാസിനഃ ശണവസ്ത്രാണി പരിധായ ഗാത്രേഷു ഭസ്മ വിലിപ്യ സമുപവിശ്യ സമഖേത്സ്യന്ത|</para>
  <para style="p">
    <verse number="14" style="v"/>അതോ വിചാരദിവസേ യുഷ്മാകം ദശാതഃ സോരസീദോന്നിവാസിനാം ദശാ സഹ്യാ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="15" style="v"/>ഹേ കഫർനാഹൂമ്, ത്വം സ്വർഗം യാവദ് ഉന്നതാ കിന്തു നരകം യാവത് ന്യഗ്ഭവിഷ്യസി|</para>
  <para style="p">
    <verse number="16" style="v"/>യോ ജനോ യുഷ്മാകം വാക്യം ഗൃഹ്ലാതി സ മമൈവ വാക്യം ഗൃഹ്ലാതി; കിഞ്ച യോ ജനോ യുഷ്മാകമ് അവജ്ഞാം കരോതി സ മമൈവാവജ്ഞാം കരോതി; യോ ജനോ മമാവജ്ഞാം കരോതി ച സ മത്പ്രേരകസ്യൈവാവജ്ഞാം കരോതി|</para>
  <para style="p">
    <verse number="17" style="v"/>അഥ തേ സപ്തതിശിഷ്യാ ആനന്ദേന പ്രത്യാഗത്യ കഥയാമാസുഃ, ഹേ പ്രഭോ ഭവതോ നാമ്നാ ഭൂതാ അപ്യസ്മാകം വശീഭവന്തി|</para>
  <para style="p">
    <verse number="18" style="v"/>തദാനീം സ താൻ ജഗാദ, വിദ്യുതമിവ സ്വർഗാത് പതന്തം ശൈതാനമ് അദർശമ്|</para>
  <para style="p">
    <verse number="19" style="v"/>പശ്യത സർപാൻ വൃശ്ചികാൻ രിപോഃ സർവ്വപരാക്രമാംശ്ച പദതലൈ ർദലയിതും യുഷ്മഭ്യം ശക്തിം ദദാമി തസ്മാദ് യുഷ്മാകം കാപി ഹാനി ർന ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="20" style="v"/>ഭൂതാ യുഷ്മാകം വശീഭവന്തി, ഏതന്നിമിത്തത് മാ സമുല്ലസത, സ്വർഗേ യുഷ്മാകം നാമാനി ലിഖിതാനി സന്തീതി നിമിത്തം സമുല്ലസത|</para>
  <para style="p">
    <verse number="21" style="v"/>തദ്ഘടികായാം യീശു ർമനസി ജാതാഹ്ലാദഃ കഥയാമാസ ഹേ സ്വർഗപൃഥിവ്യോരേകാധിപതേ പിതസ്ത്വം ജ്ഞാനവതാം വിദുഷാഞ്ച ലോകാനാം പുരസ്താത് സർവ്വമേതദ് അപ്രകാശ്യ ബാലകാനാം പുരസ്താത് പ്രാകാശയ ഏതസ്മാദ്ധേതോസ്ത്വാം ധന്യം വദാമി, ഹേ പിതരിത്ഥം ഭവതു യദ് ഏതദേവ തവ ഗോചര ഉത്തമമ്|</para>
  <para style="p">
    <verse number="22" style="v"/>പിത്രാ സർവ്വാണി മയി സമർപിതാനി പിതരം വിനാ കോപി പുത്രം ന ജാനാതി കിഞ്ച പുത്രം വിനാ യസ്മൈ ജനായ പുത്രസ്തം പ്രകാശിതവാൻ തഞ്ച വിനാ കോപി പിതരം ന ജാനാതി|</para>
  <para style="p">
    <verse number="23" style="v"/>തപഃ പരം സ ശിഷ്യാൻ പ്രതി പരാവൃത്യ ഗുപ്തം ജഗാദ, യൂയമേതാനി സർവ്വാണി പശ്യഥ തതോ യുഷ്മാകം ചക്ഷൂംഷി ധന്യാനി|</para>
  <para style="p">
    <verse number="24" style="v"/>യുഷ്മാനഹം വദാമി, യൂയം യാനി സർവ്വാണി പശ്യഥ താനി ബഹവോ ഭവിഷ്യദ്വാദിനോ ഭൂപതയശ്ച ദ്രഷ്ടുമിച്ഛന്തോപി ദ്രഷ്ടും ന പ്രാപ്നുവൻ, യുഷ്മാഭി ര്യാ യാഃ കഥാശ്ച ശ്രൂയന്തേ താഃ ശ്രോതുമിച്ഛന്തോപി ശ്രോതും നാലഭന്ത|</para>
  <para style="p">
    <verse number="25" style="v"/>അനന്തരമ് ഏകോ വ്യവസ്ഥാപക ഉത്ഥായ തം പരീക്ഷിതും പപ്രച്ഛ, ഹേ ഉപദേശക അനന്തായുഷഃ പ്രാപ്തയേ മയാ കിം കരണീയം?</para>
  <para style="p">
    <verse number="26" style="v"/>യീശുഃ പ്രത്യുവാച, അത്രാർഥേ വ്യവസ്ഥായാം കിം ലിഖിതമസ്തി? ത്വം കീദൃക് പഠസി?</para>
  <para style="p">
    <verse number="27" style="v"/>തതഃ സോവദത്, ത്വം സർവ്വാന്തഃകരണൈഃ സർവ്വപ്രാണൈഃ സർവ്വശക്തിഭിഃ സർവ്വചിത്തൈശ്ച പ്രഭൗ പരമേശ്വരേ പ്രേമ കുരു, സമീപവാസിനി സ്വവത് പ്രേമ കുരു ച|</para>
  <para style="p">
    <verse number="28" style="v"/>തദാ സ കഥയാമാസ, ത്വം യഥാർഥം പ്രത്യവോചഃ, ഇത്ഥമ് ആചര തേനൈവ ജീവിഷ്യസി|</para>
  <para style="p">
    <verse number="29" style="v"/>കിന്തു സ ജനഃ സ്വം നിർദ്ദോഷം ജ്ഞാപയിതും യീശും പപ്രച്ഛ, മമ സമീപവാസീ കഃ? തതോ യീശുഃ പ്രത്യുവാച,</para>
  <para style="p">
    <verse number="30" style="v"/>ഏകോ ജനോ യിരൂശാലമ്പുരാദ് യിരീഹോപുരം യാതി, ഏതർഹി ദസ്യൂനാം കരേഷു പതിതേ തേ തസ്യ വസ്ത്രാദികം ഹൃതവന്തഃ തമാഹത്യ മൃതപ്രായം കൃത്വാ ത്യക്ത്വാ യയുഃ|</para>
  <para style="p">
    <verse number="31" style="v"/>അകസ്മാദ് ഏകോ യാജകസ്തേന മാർഗേണ ഗച്ഛൻ തം ദൃഷ്ട്വാ മാർഗാന്യപാർശ്വേന ജഗാമ|</para>
  <para style="p">
    <verse number="32" style="v"/>ഇത്ഥമ് ഏകോ ലേവീയസ്തത്സ്ഥാനം പ്രാപ്യ തസ്യാന്തികം ഗത്വാ തം വിലോക്യാന്യേന പാർശ്വേന ജഗാമ|</para>
  <para style="p">
    <verse number="33" style="v"/>കിന്ത്വേകഃ ശോമിരോണീയോ ഗച്ഛൻ തത്സ്ഥാനം പ്രാപ്യ തം ദൃഷ്ട്വാദയത|</para>
  <para style="p">
    <verse number="34" style="v"/>തസ്യാന്തികം ഗത്വാ തസ്യ ക്ഷതേഷു തൈലം ദ്രാക്ഷാരസഞ്ച പ്രക്ഷിപ്യ ക്ഷതാനി ബദ്ധ്വാ നിജവാഹനോപരി തമുപവേശ്യ പ്രവാസീയഗൃഹമ് ആനീയ തം സിഷേവേ|</para>
  <para style="p">
    <verse number="35" style="v"/>പരസ്മിൻ ദിവസേ നിജഗമനകാലേ ദ്വൗ മുദ്രാപാദൗ തദ്ഗൃഹസ്വാമിനേ ദത്ത്വാവദത് ജനമേനം സേവസ്വ തത്ര യോഽധികോ വ്യയോ ഭവിഷ്യതി തമഹം പുനരാഗമനകാലേ പരിശോത്സ്യാമി|</para>
  <para style="p">
    <verse number="36" style="v"/>ഏഷാം ത്രയാണാം മധ്യേ തസ്യ ദസ്യുഹസ്തപതിതസ്യ ജനസ്യ സമീപവാസീ കഃ? ത്വയാ കിം ബുധ്യതേ?</para>
  <para style="p">
    <verse number="37" style="v"/>തതഃ സ വ്യവസ്ഥാപകഃ കഥയാമാസ യസ്തസ്മിൻ ദയാം ചകാര| തദാ യീശുഃ കഥയാമാസ ത്വമപി ഗത്വാ തഥാചര|</para>
  <para style="p">
    <verse number="38" style="v"/>തതഃ പരം തേ ഗച്ഛന്ത ഏകം ഗ്രാമം പ്രവിവിശുഃ; തദാ മർഥാനാമാ സ്ത്രീ സ്വഗൃഹേ തസ്യാതിഥ്യം ചകാര|</para>
  <para style="p">
    <verse number="39" style="v"/>തസ്മാത് മരിയമ് നാമധേയാ തസ്യാ ഭഗിനീ യീശോഃ പദസമീപ ഉവവിശ്യ തസ്യോപദേശകഥാം ശ്രോതുമാരേഭേ|</para>
  <para style="p">
    <verse number="40" style="v"/>കിന്തു മർഥാ നാനാപരിചര്യ്യായാം വ്യഗ്രാ ബഭൂവ തസ്മാദ്ധേതോസ്തസ്യ സമീപമാഗത്യ ബഭാഷേ; ഹേ പ്രഭോ മമ ഭഗിനീ കേവലം മമോപരി സർവ്വകർമ്മണാം ഭാരമ് അർപിതവതീ തത്ര ഭവതാ കിഞ്ചിദപി ന മനോ നിധീയതേ കിമ്? മമ സാഹായ്യം കർത്തും ഭവാൻ താമാദിശതു|</para>
  <para style="p">
    <verse number="41" style="v"/>തതോ യീശുഃ പ്രത്യുവാച ഹേ മർഥേ ഹേ മർഥേ, ത്വം നാനാകാര്യ്യേഷു ചിന്തിതവതീ വ്യഗ്രാ ചാസി,</para>
  <para style="p">
    <verse number="42" style="v"/>കിന്തു പ്രയോജനീയമ് ഏകമാത്രമ് ആസ്തേ| അപരഞ്ച യമുത്തമം ഭാഗം കോപി ഹർത്തും ന ശക്നോതി സഏവ മരിയമാ വൃതഃ|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അനന്തരം സ കസ്മിംശ്ചിത് സ്ഥാനേ പ്രാർഥയത തത്സമാപ്തൗ സത്യാം തസ്യൈകഃ ശിഷ്യസ്തം ജഗാദ ഹേ പ്രഭോ യോഹൻ യഥാ സ്വശിഷ്യാൻ പ്രാർഥയിതുമ് ഉപദിഷ്ടവാൻ തഥാ ഭവാനപ്യസ്മാൻ ഉപദിശതു|</para>
  <para style="p">
    <verse number="2" style="v"/>തസ്മാത് സ കഥയാമാസ, പ്രാർഥനകാലേ യൂയമ് ഇത്ഥം കഥയധ്വം, ഹേ അസ്മാകം സ്വർഗസ്ഥപിതസ്തവ നാമ പൂജ്യം ഭവതു; തവ രാജത്വം ഭവതു; സ്വർഗേ യഥാ തഥാ പൃഥിവ്യാമപി തവേച്ഛയാ സർവ്വം ഭവതു|</para>
  <para style="p">
    <verse number="3" style="v"/>പ്രത്യഹമ് അസ്മാകം പ്രയോജനീയം ഭോജ്യം ദേഹി|</para>
  <para style="p">
    <verse number="4" style="v"/>യഥാ വയം സർവ്വാൻ അപരാധിനഃ ക്ഷമാമഹേ തഥാ ത്വമപി പാപാന്യസ്മാകം ക്ഷമസ്വ| അസ്മാൻ പരീക്ഷാം മാനയ കിന്തു പാപാത്മനോ രക്ഷ|</para>
  <para style="p">
    <verse number="5" style="v"/>പശ്ചാത് സോപരമപി കഥിതവാൻ യദി യുഷ്മാകം കസ്യചിദ് ബന്ധുസ്തിഷ്ഠതി നിശീഥേ ച തസ്യ സമീപം സ ഗത്വാ വദതി,</para>
  <para style="p">
    <verse number="6" style="v"/>ഹേ ബന്ധോ പഥിക ഏകോ ബന്ധു ർമമ നിവേശനമ് ആയാതഃ കിന്തു തസ്യാതിഥ്യം കർത്തും മമാന്തികേ കിമപി നാസ്തി, അതഏവ പൂപത്രയം മഹ്യമ് ഋണം ദേഹി;</para>
  <para style="p">
    <verse number="7" style="v"/>തദാ സ യദി ഗൃഹമധ്യാത് പ്രതിവദതി മാം മാ ക്ലിശാന, ഇദാനീം ദ്വാരം രുദ്ധം ശയനേ മയാ സഹ ബാലകാശ്ച തിഷ്ഠന്തി തുഭ്യം ദാതുമ് ഉത്ഥാതും ന ശക്നോമി,</para>
  <para style="p">
    <verse number="8" style="v"/>തർഹി യുഷ്മാനഹം വദാമി, സ യദി മിത്രതയാ തസ്മൈ കിമപി ദാതും നോത്തിഷ്ഠതി തഥാപി വാരം വാരം പ്രാർഥനാത ഉത്ഥാപിതഃ സൻ യസ്മിൻ തസ്യ പ്രയോജനം തദേവ ദാസ്യതി|</para>
  <para style="p">
    <verse number="9" style="v"/>അതഃ കാരണാത് കഥയാമി, യാചധ്വം തതോ യുഷ്മഭ്യം ദാസ്യതേ, മൃഗയധ്വം തത ഉദ്ദേശം പ്രാപ്സ്യഥ, ദ്വാരമ് ആഹത തതോ യുഷ്മഭ്യം ദ്വാരം മോക്ഷ്യതേ|</para>
  <para style="p">
    <verse number="10" style="v"/>യോ യാചതേ സ പ്രാപ്നോതി, യോ മൃഗയതേ സ ഏവോദ്ദേശം പ്രാപ്നോതി, യോ ദ്വാരമ് ആഹന്തി തദർഥം ദ്വാരം മോച്യതേ|</para>
  <para style="p">
    <verse number="11" style="v"/>പുത്രേണ പൂപേ യാചിതേ തസ്മൈ പാഷാണം ദദാതി വാ മത്സ്യേ യാചിതേ തസ്മൈ സർപം ദദാതി</para>
  <para style="p">
    <verse number="12" style="v"/>വാ അണ്ഡേ യാചിതേ തസ്മൈ വൃശ്ചികം ദദാതി യുഷ്മാകം മധ്യേ ക ഏതാദൃശഃ പിതാസ്തേ?</para>
  <para style="p">
    <verse number="13" style="v"/>തസ്മാദേവ യൂയമഭദ്രാ അപി യദി സ്വസ്വബാലകേഭ്യ ഉത്തമാനി ദ്രവ്യാണി ദാതും ജാനീഥ തർഹ്യസ്മാകം സ്വർഗസ്ഥഃ പിതാ നിജയാചകേഭ്യഃ കിം പവിത്രമ് ആത്മാനം ന ദാസ്യതി?</para>
  <para style="p">
    <verse number="14" style="v"/>അനന്തരം യീശുനാ കസ്മാച്ചിദ് ഏകസ്മിൻ മൂകഭൂതേ ത്യാജിതേ സതി സ ഭൂതത്യക്തോ മാനുഷോ വാക്യം വക്തുമ് ആരേഭേ; തതോ ലോകാഃ സകലാ ആശ്ചര്യ്യം മേനിരേ|</para>
  <para style="p">
    <verse number="15" style="v"/>കിന്തു തേഷാം കേചിദൂചു ർജനോയം ബാലസിബൂബാ അർഥാദ് ഭൂതരാജേന ഭൂതാൻ ത്യാജയതി|</para>
  <para style="p">
    <verse number="16" style="v"/>തം പരീക്ഷിതും കേചിദ് ആകാശീയമ് ഏകം ചിഹ്നം ദർശയിതും തം പ്രാർഥയാഞ്ചക്രിരേ|</para>
  <para style="p">
    <verse number="17" style="v"/>തദാ സ തേഷാം മനഃകൽപനാം ജ്ഞാത്വാ കഥയാമാസ, കസ്യചിദ് രാജ്യസ്യ ലോകാ യദി പരസ്പരം വിരുന്ധന്തി തർഹി തദ് രാജ്യമ് നശ്യതി; കേചിദ് ഗൃഹസ്ഥാ യദി പരസ്പരം വിരുന്ധന്തി തർഹി തേപി നശ്യന്തി|</para>
  <para style="p">
    <verse number="18" style="v"/>തഥൈവ ശൈതാനപി സ്വലോകാൻ യദി വിരുണദ്ധി തദാ തസ്യ രാജ്യം കഥം സ്ഥാസ്യതി? ബാലസിബൂബാഹം ഭൂതാൻ ത്യാജയാമി യൂയമിതി വദഥ|</para>
  <para style="p">
    <verse number="19" style="v"/>യദ്യഹം ബാലസിബൂബാ ഭൂതാൻ ത്യാജയാമി തർഹി യുഷ്മാകം സന്താനാഃ കേന ത്യാജയന്തി? തസ്മാത് തഏവ കഥായാ ഏതസ്യാ വിചാരയിതാരോ ഭവിഷ്യന്തി|</para>
  <para style="p">
    <verse number="20" style="v"/>കിന്തു യദ്യഹമ് ഈശ്വരസ്യ പരാക്രമേണ ഭൂതാൻ ത്യാജയാമി തർഹി യുഷ്മാകം നികടമ് ഈശ്വരസ്യ രാജ്യമവശ്യമ് ഉപതിഷ്ഠതി|</para>
  <para style="p">
    <verse number="21" style="v"/>ബലവാൻ പുമാൻ സുസജ്ജമാനോ യതികാലം നിജാട്ടാലികാം രക്ഷതി തതികാലം തസ്യ ദ്രവ്യം നിരുപദ്രവം തിഷ്ഠതി|</para>
  <para style="p">
    <verse number="22" style="v"/>കിന്തു തസ്മാദ് അധികബലഃ കശ്ചിദാഗത്യ യദി തം ജയതി തർഹി യേഷു ശസ്ത്രാസ്ത്രേഷു തസ്യ വിശ്വാസ ആസീത് താനി സർവ്വാണി ഹൃത്വാ തസ്യ ദ്രവ്യാണി ഗൃഹ്ലാതി|</para>
  <para style="p">
    <verse number="23" style="v"/>അതഃ കാരണാദ് യോ മമ സപക്ഷോ ന സ വിപക്ഷഃ, യോ മയാ സഹ ന സംഗൃഹ്ലാതി സ വികിരതി|</para>
  <para style="p">
    <verse number="24" style="v"/>അപരഞ്ച അമേധ്യഭൂതോ മാനുഷസ്യാന്തർനിർഗത്യ ശുഷ്കസ്ഥാനേ ഭ്രാന്ത്വാ വിശ്രാമം മൃഗയതേ കിന്തു ന പ്രാപ്യ വദതി മമ യസ്മാദ് ഗൃഹാദ് ആഗതോഹം പുനസ്തദ് ഗൃഹം പരാവൃത്യ യാമി|</para>
  <para style="p">
    <verse number="25" style="v"/>തതോ ഗത്വാ തദ് ഗൃഹം മാർജിതം ശോഭിതഞ്ച ദൃഷ്ട്വാ</para>
  <para style="p">
    <verse number="26" style="v"/>തത്ക്ഷണമ് അപഗത്യ സ്വസ്മാദപി ദുർമ്മതീൻ അപരാൻ സപ്തഭൂതാൻ സഹാനയതി തേ ച തദ്ഗൃഹം പവിശ്യ നിവസന്തി| തസ്മാത് തസ്യ മനുഷ്യസ്യ പ്രഥമദശാതഃ ശേഷദശാ ദുഃഖതരാ ഭവതി|</para>
  <para style="p">
    <verse number="27" style="v"/>അസ്യാഃ കഥായാഃ കഥനകാലേ ജനതാമധ്യസ്ഥാ കാചിന്നാരീ തമുച്ചൈഃസ്വരം പ്രോവാച, യാ യോഷിത് ത്വാം ഗർബ്ഭേഽധാരയത് സ്തന്യമപായയച്ച സൈവ ധന്യാ|</para>
  <para style="p">
    <verse number="28" style="v"/>കിന്തു സോകഥയത് യേ പരമേശ്വരസ്യ കഥാം ശ്രുത്വാ തദനുരൂപമ് ആചരന്തി തഏവ ധന്യാഃ|</para>
  <para style="p">
    <verse number="29" style="v"/>തതഃ പരം തസ്യാന്തികേ ബഹുലോകാനാം സമാഗമേ ജാതേ സ വക്തുമാരേഭേ, ആധുനികാ ദുഷ്ടലോകാശ്ചിഹ്നം ദ്രഷ്ടുമിച്ഛന്തി കിന്തു യൂനസ്ഭവിഷ്യദ്വാദിനശ്ചിഹ്നം വിനാന്യത് കിഞ്ചിച്ചിഹ്നം താൻ ന ദർശയിഷ്യതേ|</para>
  <para style="p">
    <verse number="30" style="v"/>യൂനസ് തു യഥാ നീനിവീയലോകാനാം സമീപേ ചിഹ്നരൂപോഭവത് തഥാ വിദ്യമാനലോകാനാമ് ഏഷാം സമീപേ മനുഷ്യപുത്രോപി ചിഹ്നരൂപോ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="31" style="v"/>വിചാരസമയേ ഇദാനീന്തനലോകാനാം പ്രാതികൂല്യേന ദക്ഷിണദേശീയാ രാജ്ഞീ പ്രോത്ഥായ താൻ ദോഷിണഃ കരിഷ്യതി, യതഃ സാ രാജ്ഞീ സുലേമാന ഉപദേശകഥാം ശ്രോതും പൃഥിവ്യാഃ സീമാത ആഗച്ഛത് കിന്തു പശ്യത സുലേമാനോപി ഗുരുതര ഏകോ ജനോഽസ്മിൻ സ്ഥാനേ വിദ്യതേ|</para>
  <para style="p">
    <verse number="32" style="v"/>അപരഞ്ച വിചാരസമയേ നീനിവീയലോകാ അപി വർത്തമാനകാലികാനാം ലോകാനാം വൈപരീത്യേന പ്രോത്ഥായ താൻ ദോഷിണഃ കരിഷ്യന്തി, യതോ ഹേതോസ്തേ യൂനസോ വാക്യാത് ചിത്താനി പരിവർത്തയാമാസുഃ കിന്തു പശ്യത യൂനസോതിഗുരുതര ഏകോ ജനോഽസ്മിൻ സ്ഥാനേ വിദ്യതേ|</para>
  <para style="p">
    <verse number="33" style="v"/>പ്രദീപം പ്രജ്വാല്യ ദ്രോണസ്യാധഃ കുത്രാപി ഗുപ്തസ്ഥാനേ വാ കോപി ന സ്ഥാപയതി കിന്തു ഗൃഹപ്രവേശിഭ്യോ ദീപ്തിം ദാതം ദീപാധാരോപര്യ്യേവ സ്ഥാപയതി|</para>
  <para style="p">
    <verse number="34" style="v"/>ദേഹസ്യ പ്രദീപശ്ചക്ഷുസ്തസ്മാദേവ ചക്ഷു ര്യദി പ്രസന്നം ഭവതി തർഹി തവ സർവ്വശരീരം ദീപ്തിമദ് ഭവിഷ്യതി കിന്തു ചക്ഷു ര്യദി മലീമസം തിഷ്ഠതി തർഹി സർവ്വശരീരം സാന്ധകാരം സ്ഥാസ്യതി|</para>
  <para style="p">
    <verse number="35" style="v"/>അസ്മാത് കാരണാത് തവാന്തഃസ്ഥം ജ്യോതി ര്യഥാന്ധകാരമയം ന ഭവതി തദർഥേ സാവധാനോ ഭവ|</para>
  <para style="p">
    <verse number="36" style="v"/>യതഃ ശരീരസ്യ കുത്രാപ്യംശേ സാന്ധകാരേ ന ജാതേ സർവ്വം യദി ദീപ്തിമത് തിഷ്ഠതി തർഹി തുഭ്യം ദീപ്തിദായിപ്രോജ്ജ്വലൻ പ്രദീപ ഇവ തവ സവർവശരീരം ദീപ്തിമദ് ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="37" style="v"/>ഏതത്കഥായാഃ കഥനകാലേ ഫിരുശ്യേകോ ഭേജനായ തം നിമന്ത്രയാമാസ, തതഃ സ ഗത്വാ ഭോക്തുമ് ഉപവിവേശ|</para>
  <para style="p">
    <verse number="38" style="v"/>കിന്തു ഭോജനാത് പൂർവ്വം നാമാങ്ക്ഷീത് ഏതദ് ദൃഷ്ട്വാ സ ഫിരുശ്യാശ്ചര്യ്യം മേനേ|</para>
  <para style="p">
    <verse number="39" style="v"/>തദാ പ്രഭുസ്തം പ്രോവാച യൂയം ഫിരൂശിലോകാഃ പാനപാത്രാണാം ഭോജനപാത്രാണാഞ്ച ബഹിഃ പരിഷ്കുരുഥ കിന്തു യുഷ്മാകമന്ത ർദൗരാത്മ്യൈ ർദുഷ്ക്രിയാഭിശ്ച പരിപൂർണം തിഷ്ഠതി|</para>
  <para style="p">
    <verse number="40" style="v"/>ഹേ സർവ്വേ നിർബോധാ യോ ബഹിഃ സസർജ സ ഏവ കിമന്ത ർന സസർജ?</para>
  <para style="p">
    <verse number="41" style="v"/>തത ഏവ യുഷ്മാഭിരന്തഃകരണം (ഈശ്വരായ) നിവേദ്യതാം തസ്മിൻ കൃതേ യുഷ്മാകം സർവ്വാണി ശുചിതാം യാസ്യന്തി|</para>
  <para style="p">
    <verse number="42" style="v"/>കിന്തു ഹന്ത ഫിരൂശിഗണാ യൂയം ന്യായമ് ഈശ്വരേ പ്രേമ ച പരിത്യജ്യ പോദിനായാ അരുദാദീനാം സർവ്വേഷാം ശാകാനാഞ്ച ദശമാംശാൻ ദത്ഥ കിന്തു പ്രഥമം പാലയിത്വാ ശേഷസ്യാലങ്ഘനം യുഷ്മാകമ് ഉചിതമാസീത്|</para>
  <para style="p">
    <verse number="43" style="v"/>ഹാ ഹാ ഫിരൂശിനോ യൂയം ഭജനഗേഹേ പ്രോച്ചാസനേ ആപണേഷു ച നമസ്കാരേഷു പ്രീയധ്വേ|</para>
  <para style="p">
    <verse number="44" style="v"/>വത കപടിനോഽധ്യാപകാഃ ഫിരൂശിനശ്ച ലോകായത് ശ്മശാനമ് അനുപലഭ്യ തദുപരി ഗച്ഛന്തി യൂയമ് താദൃഗപ്രകാശിതശ്മശാനവാദ് ഭവഥ|</para>
  <para style="p">
    <verse number="45" style="v"/>തദാനീം വ്യവസ്ഥാപകാനാമ് ഏകാ യീശുമവദത്, ഹേ ഉപദേശക വാക്യേനേദൃശേനാസ്മാസ്വപി ദോഷമ് ആരോപയസി|</para>
  <para style="p">
    <verse number="46" style="v"/>തതഃ സ ഉവാച, ഹാ ഹാ വ്യവസ്ഥാപകാ യൂയമ് മാനുഷാണാമ് ഉപരി ദുഃസഹ്യാൻ ഭാരാൻ ന്യസ്യഥ കിന്തു സ്വയമ് ഏകാങ്ഗുुല്യാപി താൻ ഭാരാൻ ന സ്പൃശഥ|</para>
  <para style="p">
    <verse number="47" style="v"/>ഹന്ത യുഷ്മാകം പൂർവ്വപുരുഷാ യാൻ ഭവിഷ്യദ്വാദിനോഽവധിഷുസ്തേഷാം ശ്മശാനാനി യൂയം നിർമ്മാഥ|</para>
  <para style="p">
    <verse number="48" style="v"/>തേനൈവ യൂയം സ്വപൂർവ്വപുരുഷാണാം കർമ്മാണി സംമന്യധ്വേ തദേവ സപ്രമാണം കുരുഥ ച, യതസ്തേ താനവധിഷുഃ യൂയം തേഷാം ശ്മശാനാനി നിർമ്മാഥ|</para>
  <para style="p">
    <verse number="49" style="v"/>അതഏവ ഈശ്വരസ്യ ശാസ്ത്രേ പ്രോക്തമസ്തി തേഷാമന്തികേ ഭവിഷ്യദ്വാദിനഃ പ്രേരിതാംശ്ച പ്രേഷയിഷ്യാമി തതസ്തേ തേഷാം കാംശ്ചന ഹനിഷ്യന്തി കാംശ്ചന താഡശ്ഷ്യിന്തി|</para>
  <para style="p">
    <verse number="50" style="v"/>ഏതസ്മാത് കാരണാത് ഹാബിലഃ ശോണിതപാതമാരഭ്യ മന്ദിരയജ്ഞവേദ്യോ ർമധ്യേ ഹതസ്യ സിഖരിയസ്യ രക്തപാതപര്യ്യന്തം</para>
  <para style="p">
    <verse number="51" style="v"/>ജഗതഃ സൃഷ്ടിമാരഭ്യ പൃഥിവ്യാം ഭവിഷ്യദ്വാദിനാം യതിരക്തപാതാ ജാതാസ്തതീനാമ് അപരാധദണ്ഡാ ഏഷാം വർത്തമാനലോകാനാം ഭവിഷ്യന്തി, യുഷ്മാനഹം നിശ്ചിതം വദാമി സർവ്വേ ദണ്ഡാ വംശസ്യാസ്യ ഭവിഷ്യന്തി|</para>
  <para style="p">
    <verse number="52" style="v"/>ഹാ ഹാ വ്യവസ്ഥപകാ യൂയം ജ്ഞാനസ്യ കുഞ്ചികാം ഹൃത്വാ സ്വയം ന പ്രവിഷ്ടാ യേ പ്രവേഷ്ടുഞ്ച പ്രയാസിനസ്താനപി പ്രവേഷ്ടും വാരിതവന്തഃ|</para>
  <para style="p">
    <verse number="53" style="v"/>ഇത്ഥം കഥാകഥനാദ് അധ്യാപകാഃ ഫിരൂശിനശ്ച സതർകാഃ</para>
  <para style="p">
    <verse number="54" style="v"/>സന്തസ്തമപവദിതും തസ്യ കഥായാ ദോഷം ധർത്തമിച്ഛന്തോ നാനാഖ്യാനകഥനായ തം പ്രവർത്തയിതും കോപയിതുഞ്ച പ്രാരേഭിരേ|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>തദാനീം ലോകാഃ സഹസ്രം സഹസ്രമ് ആഗത്യ സമുപസ്ഥിതാസ്തത ഏകൈകോ ഽന്യേഷാമുപരി പതിതുമ് ഉപചക്രമേ; തദാ യീശുഃ ശിഷ്യാൻ ബഭാഷേ, യൂയം ഫിരൂശിനാം കിണ്വരൂപകാപട്യേ വിശേഷേണ സാവധാനാസ്തിഷ്ഠത|</para>
  <para style="p">
    <verse number="2" style="v"/>യതോ യന്ന പ്രകാശയിഷ്യതേ തദാച്ഛന്നം വസ്തു കിമപി നാസ്തി; തഥാ യന്ന ജ്ഞാസ്യതേ തദ് ഗുപ്തം വസ്തു കിമപി നാസ്തി|</para>
  <para style="p">
    <verse number="3" style="v"/>അന്ധകാരേ തിഷ്ഠനതോ യാഃ കഥാ അകഥയത താഃ സർവ്വാഃ കഥാ ദീപ്തൗ ശ്രോഷ്യന്തേ നിർജനേ കർണേ ച യദകഥയത ഗൃഹപൃഷ്ഠാത് തത് പ്രചാരയിഷ്യതേ|</para>
  <para style="p">
    <verse number="4" style="v"/>ഹേ ബന്ധവോ യുഷ്മാനഹം വദാമി, യേ ശരീരസ്യ നാശം വിനാ കിമപ്യപരം കർത്തും ന ശക്രുവന്തി തേഭ്യോ മാ ഭൈഷ്ട|</para>
  <para style="p">
    <verse number="5" style="v"/>തർഹി കസ്മാദ് ഭേതവ്യമ് ഇത്യഹം വദാമി, യഃ ശരീരം നാശയിത്വാ നരകം നിക്ഷേപ്തും ശക്നോതി തസ്മാദേവ ഭയം കുരുത, പുനരപി വദാമി തസ്മാദേവ ഭയം കുരുത|</para>
  <para style="p">
    <verse number="6" style="v"/>പഞ്ച ചടകപക്ഷിണഃ കിം ദ്വാഭ്യാം താമ്രഖണ്ഡാഭ്യാം ന വിക്രീയന്തേ? തഥാപീശ്വരസ്തേഷാമ് ഏകമപി ന വിസ്മരതി|</para>
  <para style="p">
    <verse number="7" style="v"/>യുഷ്മാകം ശിരഃകേശാ അപി ഗണിതാഃ സന്തി തസ്മാത് മാ വിഭീത ബഹുചടകപക്ഷിഭ്യോപി യൂയം ബഹുമൂല്യാഃ|</para>
  <para style="p">
    <verse number="8" style="v"/>അപരം യുഷ്മഭ്യം കഥയാമി യഃ കശ്ചിൻ മാനുഷാണാം സാക്ഷാൻ മാം സ്വീകരോതി മനുഷ്യപുത്ര ഈശ്വരദൂതാനാം സാക്ഷാത് തം സ്വീകരിഷ്യതി|</para>
  <para style="p">
    <verse number="9" style="v"/>കിന്തു യഃ കശ്ചിന്മാനുഷാണാം സാക്ഷാന്മാമ് അസ്വീകരോതി തമ് ഈശ്വരസ്യ ദൂതാനാം സാക്ഷാദ് അഹമ് അസ്വീകരിഷ്യാമി|</para>
  <para style="p">
    <verse number="10" style="v"/>അന്യച്ച യഃ കശ്ചിൻ മനുജസുതസ്യ നിന്ദാഭാവേന കാഞ്ചിത് കഥാം കഥയതി തസ്യ തത്പാപസ്യ മോചനം ഭവിഷ്യതി കിന്തു യദി കശ്ചിത് പവിത്രമ് ആത്മാനം നിന്ദതി തർഹി തസ്യ തത്പാപസ്യ മോചനം ന ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="11" style="v"/>യദാ ലോകാ യുഷ്മാൻ ഭജനഗേഹം വിചാരകർതൃരാജ്യകർതൃണാം സമ്മുഖഞ്ച നേഷ്യന്തി തദാ കേന പ്രകാരേണ കിമുത്തരം വദിഷ്യഥ കിം കഥയിഷ്യഥ ചേത്യത്ര മാ ചിന്തയത;</para>
  <para style="p">
    <verse number="12" style="v"/>യതോ യുഷ്മാഭിര്യദ് യദ് വക്തവ്യം തത് തസ്മിൻ സമയഏവ പവിത്ര ആത്മാ യുഷ്മാൻ ശിക്ഷയിഷ്യതി|</para>
  <para style="p">
    <verse number="13" style="v"/>തതഃ പരം ജനതാമധ്യസ്ഥഃ കശ്ചിജ്ജനസ്തം ജഗാദ ഹേ ഗുരോ മയാ സഹ പൈതൃകം ധനം വിഭക്തും മമ ഭ്രാതരമാജ്ഞാപയതു ഭവാൻ|</para>
  <para style="p">
    <verse number="14" style="v"/>കിന്തു സ തമവദത് ഹേ മനുഷ്യ യുവയോ ർവിചാരം വിഭാഗഞ്ച കർത്തും മാം കോ നിയുക്തവാൻ?</para>
  <para style="p">
    <verse number="15" style="v"/>അനന്തരം സ ലോകാനവദത് ലോഭേ സാവധാനാഃ സതർകാശ്ച തിഷ്ഠത, യതോ ബഹുസമ്പത്തിപ്രാപ്ത്യാ മനുഷ്യസ്യായു ർന ഭവതി|</para>
  <para style="p">
    <verse number="16" style="v"/>പശ്ചാദ് ദൃഷ്ടാന്തകഥാമുത്ഥാപ്യ കഥയാമാസ, ഏകസ്യ ധനിനോ ഭൂമൗ ബഹൂനി ശസ്യാനി ജാതാനി|</para>
  <para style="p">
    <verse number="17" style="v"/>തതഃ സ മനസാ ചിന്തയിത്വാ കഥയാമ്ബഭൂവ മമൈതാനി സമുത്പന്നാനി ദ്രവ്യാണി സ്ഥാപയിതും സ്ഥാനം നാസ്തി കിം കരിഷ്യാമി?</para>
  <para style="p">
    <verse number="18" style="v"/>തതോവദദ് ഇത്ഥം കരിഷ്യാമി, മമ സർവ്വഭാണ്ഡാഗാരാണി ഭങ്ക്ത്വാ ബൃഹദ്ഭാണ്ഡാഗാരാണി നിർമ്മായ തന്മധ്യേ സർവ്വഫലാനി ദ്രവ്യാണി ച സ്ഥാപയിഷ്യാമി|</para>
  <para style="p">
    <verse number="19" style="v"/>അപരം നിജമനോ വദിഷ്യാമി, ഹേ മനോ ബഹുവത്സരാർഥം നാനാദ്രവ്യാണി സഞ്ചിതാനി സന്തി വിശ്രാമം കുരു ഭുക്ത്വാ പീത്വാ കൗതുകഞ്ച കുരു| കിന്ത്വീശ്വരസ്തമ് അവദത്,</para>
  <para style="p">
    <verse number="20" style="v"/>രേ നിർബോധ അദ്യ രാത്രൗ തവ പ്രാണാസ്ത്വത്തോ നേഷ്യന്തേ തത ഏതാനി യാനി ദ്രവ്യാണി ത്വയാസാദിതാനി താനി കസ്യ ഭവിഷ്യന്തി?</para>
  <para style="p">
    <verse number="21" style="v"/>അതഏവ യഃ കശ്ചിദ് ഈശ്വരസ്യ സമീപേ ധനസഞ്ചയമകൃത്വാ കേവലം സ്വനികടേ സഞ്ചയം കരോതി സോപി താദൃശഃ|</para>
  <para style="p">
    <verse number="22" style="v"/>അഥ സ ശിഷ്യേഭ്യഃ കഥയാമാസ, യുഷ്മാനഹം വദാമി, കിം ഖാദിഷ്യാമഃ? കിം പരിധാസ്യാമഃ? ഇത്യുക്ത്വാ ജീവനസ്യ ശരീരസ്യ ചാർഥം ചിന്താം മാ കാർഷ്ട|</para>
  <para style="p">
    <verse number="23" style="v"/>ഭക്ഷ്യാജ്ജീവനം ഭൂഷണാച്ഛരീരഞ്ച ശ്രേഷ്ഠം ഭവതി|</para>
  <para style="p">
    <verse number="24" style="v"/>കാകപക്ഷിണാം കാര്യ്യം വിചാരയത, തേ ന വപന്തി ശസ്യാനി ച ന ഛിന്ദന്തി, തേഷാം ഭാണ്ഡാഗാരാണി ന സന്തി കോഷാശ്ച ന സന്തി, തഥാപീശ്വരസ്തേഭ്യോ ഭക്ഷ്യാണി ദദാതി, യൂയം പക്ഷിഭ്യഃ ശ്രേഷ്ഠതരാ ന കിം?</para>
  <para style="p">
    <verse number="25" style="v"/>അപരഞ്ച ഭാവയിത്വാ നിജായുഷഃ ക്ഷണമാത്രം വർദ്ധയിതും ശക്നോതി, ഏതാദൃശോ ലാകോ യുഷ്മാകം മധ്യേ കോസ്തി?</para>
  <para style="p">
    <verse number="26" style="v"/>അതഏവ ക്ഷുദ്രം കാര്യ്യം സാധയിതുമ് അസമർഥാ യൂയമ് അന്യസ്മിൻ കാര്യ്യേ കുതോ ഭാവയഥ?</para>
  <para style="p">
    <verse number="27" style="v"/>അന്യച്ച കാമ്പിലപുഷ്പം കഥം വർദ്ധതേ തദാപി വിചാരയത, തത് കഞ്ചന ശ്രമം ന കരോതി തന്തൂംശ്ച ന ജനയതി കിന്തു യുഷ്മഭ്യം യഥാർഥം കഥയാമി സുലേമാൻ ബഹ്വൈശ്വര്യ്യാന്വിതോപി പുഷ്പസ്യാസ്യ സദൃശോ വിഭൂഷിതോ നാസീത്|</para>
  <para style="p">
    <verse number="28" style="v"/>അദ്യ ക്ഷേത്രേ വർത്തമാനം ശ്വശ്ചൂല്ല്യാം ക്ഷേപ്സ്യമാനം യത് തൃണം, തസ്മൈ യദീശ്വര ഇത്ഥം ഭൂഷയതി തർഹി ഹേ അൽപപ്രത്യയിനോ യുഷ്മാന കിം ന പരിധാപയിഷ്യതി?</para>
  <para style="p">
    <verse number="29" style="v"/>അതഏവ കിം ഖാദിഷ്യാമഃ? കിം പരിധാസ്യാമഃ? ഏതദർഥം മാ ചേഷ്ടധ്വം മാ സംദിഗ്ധ്വഞ്ച|</para>
  <para style="p">
    <verse number="30" style="v"/>ജഗതോ ദേവാർച്ചകാ ഏതാനി സർവ്വാണി ചേഷ്ടനതേ; ഏഷു വസ്തുഷു യുഷ്മാകം പ്രയോജനമാസ്തേ ഇതി യുഷ്മാകം പിതാ ജാനാതി|</para>
  <para style="p">
    <verse number="31" style="v"/>അതഏവേശ്വരസ്യ രാജ്യാർഥം സചേഷ്ടാ ഭവത തഥാ കൃതേ സർവ്വാണ്യേതാനി ദ്രവ്യാണി യുഷ്മഭ്യം പ്രദായിഷ്യന്തേ|</para>
  <para style="p">
    <verse number="32" style="v"/>ഹേ ക്ഷുദ്രമേഷവ്രജ യൂയം മാ ഭൈഷ്ട യുഷ്മഭ്യം രാജ്യം ദാതും യുഷ്മാകം പിതുഃ സമ്മതിരസ്തി|</para>
  <para style="p">
    <verse number="33" style="v"/>അതഏവ യുഷ്മാകം യാ യാ സമ്പത്തിരസ്തി താം താം വിക്രീയ വിതരത, യത് സ്ഥാനം ചൗരാ നാഗച്ഛന്തി, കീടാശ്ച ന ക്ഷായയന്തി താദൃശേ സ്വർഗേ നിജാർഥമ് അജരേ സമ്പുടകേ ഽക്ഷയം ധനം സഞ്ചിനുത ച;</para>
  <para style="p">
    <verse number="34" style="v"/>യതോ യത്ര യുഷ്മാകം ധനം വർത്തതേ തത്രേവ യുഷ്മാകം മനഃ|</para>
  <para style="p">
    <verse number="35" style="v"/>അപരഞ്ച യൂയം പ്രദീപം ജ്വാലയിത്വാ ബദ്ധകടയസ്തിഷ്ഠത;</para>
  <para style="p">
    <verse number="36" style="v"/>പ്രഭു ർവിവാഹാദാഗത്യ യദൈവ ദ്വാരമാഹന്തി തദൈവ ദ്വാരം മോചയിതും യഥാ ഭൃത്യാ അപേക്ഷ്യ തിഷ്ഠന്തി തഥാ യൂയമപി തിഷ്ഠത|</para>
  <para style="p">
    <verse number="37" style="v"/>യതഃ പ്രഭുരാഗത്യ യാൻ ദാസാൻ സചേതനാൻ തിഷ്ഠതോ ദ്രക്ഷ്യതി തഏവ ധന്യാഃ; അഹം യുഷ്മാൻ യഥാർഥം വദാമി പ്രഭുസ്താൻ ഭോജനാർഥമ് ഉപവേശ്യ സ്വയം ബദ്ധകടിഃ സമീപമേത്യ പരിവേഷയിഷ്യതി|</para>
  <para style="p">
    <verse number="38" style="v"/>യദി ദ്വിതീയേ തൃതീയേ വാ പ്രഹരേ സമാഗത്യ തഥൈവ പശ്യതി, തർഹി തഏവ ദാസാ ധന്യാഃ|</para>
  <para style="p">
    <verse number="39" style="v"/>അപരഞ്ച കസ്മിൻ ക്ഷണേ ചൗരാ ആഗമിഷ്യന്തി ഇതി യദി ഗൃഹപതി ർജ്ഞാതും ശക്നോതി തദാവശ്യം ജാഗ്രൻ നിജഗൃഹേ സന്ധിം കർത്തയിതും വാരയതി യൂയമേതദ് വിത്ത|</para>
  <para style="p">
    <verse number="40" style="v"/>അതഏവ യൂയമപി സജ്ജമാനാസ്തിഷ്ഠത യതോ യസ്മിൻ ക്ഷണേ തം നാപ്രേക്ഷധ്വേ തസ്മിന്നേവ ക്ഷണേ മനുഷ്യപുത്ര ആഗമിഷ്യതി|</para>
  <para style="p">
    <verse number="41" style="v"/>തദാ പിതരഃ പപ്രച്ഛ, ഹേ പ്രഭോ ഭവാൻ കിമസ്മാൻ ഉദ്ദിശ്യ കിം സർവ്വാൻ ഉദ്ദിശ്യ ദൃഷ്ടാന്തകഥാമിമാം വദതി?</para>
  <para style="p">
    <verse number="42" style="v"/>തതഃ പ്രഭുഃ പ്രോവാച, പ്രഭുഃ സമുചിതകാലേ നിജപരിവാരാർഥം ഭോജ്യപരിവേഷണായ യം തത്പദേ നിയോക്ഷ്യതി താദൃശോ വിശ്വാസ്യോ ബോദ്ധാ കർമ്മാധീശഃ കോസ്തി?</para>
  <para style="p">
    <verse number="43" style="v"/>പ്രഭുരാഗത്യ യമ് ഏതാദൃശേ കർമ്മണി പ്രവൃത്തം ദ്രക്ഷ്യതി സഏവ ദാസോ ധന്യഃ|</para>
  <para style="p">
    <verse number="44" style="v"/>അഹം യുഷ്മാൻ യഥാർഥം വദാമി സ തം നിജസർവ്വസ്വസ്യാധിപതിം കരിഷ്യതി|</para>
  <para style="p">
    <verse number="45" style="v"/>കിന്തു പ്രഭുർവിലമ്ബേനാഗമിഷ്യതി, ഇതി വിചിന്ത്യ സ ദാസോ യദി തദന്യദാസീദാസാൻ പ്രഹർത്തുമ് ഭോക്തും പാതും മദിതുഞ്ച പ്രാരഭതേ,</para>
  <para style="p">
    <verse number="46" style="v"/>തർഹി യദാ പ്രഭും നാപേക്ഷിഷ്യതേ യസ്മിൻ ക്ഷണേ സോഽചേതനശ്ച സ്ഥാസ്യതി തസ്മിന്നേവ ക്ഷണേ തസ്യ പ്രഭുരാഗത്യ തം പദഭ്രഷ്ടം കൃത്വാ വിശ്വാസഹീനൈഃ സഹ തസ്യ അംശം നിരൂപയിഷ്യതി|</para>
  <para style="p">
    <verse number="47" style="v"/>യോ ദാസഃ പ്രഭേाരാജ്ഞാം ജ്ഞാത്വാപി സജ്ജിതോ ന തിഷ്ഠതി തദാജ്ഞാനുസാരേണ ച കാര്യ്യം ന കരോതി സോനേകാൻ പ്രഹാരാൻ പ്രാപ്സ്യതി;</para>
  <para style="p">
    <verse number="48" style="v"/>കിന്തു യോ ജനോഽജ്ഞാത്വാ പ്രഹാരാർഹം കർമ്മ കരോതി സോൽപപ്രഹാരാൻ പ്രാപ്സ്യതി| യതോ യസ്മൈ ബാഹുല്യേന ദത്തം തസ്മാദേവ ബാഹുല്യേന ഗ്രഹീഷ്യതേ, മാനുഷാ യസ്യ നികടേ ബഹു സമർപയന്തി തസ്മാദ് ബഹു യാചന്തേ|</para>
  <para style="p">
    <verse number="49" style="v"/>അഹം പൃഥിവ്യാമ് അനൈക്യരൂപം വഹ്നി നിക്ഷേപ്തുമ് ആഗതോസ്മി, സ ചേദ് ഇദാനീമേവ പ്രജ്വലതി തത്ര മമ കാ ചിന്താ?</para>
  <para style="p">
    <verse number="50" style="v"/>കിന്തു യേന മജ്ജനേനാഹം മഗ്നോ ഭവിഷ്യാമി യാവത്കാലം തസ്യ സിദ്ധി ർന ഭവിഷ്യതി താവദഹം കതികഷ്ടം പ്രാപ്സ്യാമി|</para>
  <para style="p">
    <verse number="51" style="v"/>മേലനം കർത്തും ജഗദ് ആഗതോസ്മി യൂയം കിമിത്ഥം ബോധധ്വേ? യുഷ്മാൻ വദാമി ന തഥാ, കിന്ത്വഹം മേലനാഭാവം കർത്തുംമ് ആഗതോസ്മി|</para>
  <para style="p">
    <verse number="52" style="v"/>യസ്മാദേതത്കാലമാരഭ്യ ഏകത്രസ്ഥപരിജനാനാം മധ്യേ പഞ്ചജനാഃ പൃഥഗ് ഭൂത്വാ ത്രയോ ജനാ ദ്വയോർജനയോഃ പ്രതികൂലാ ദ്വൗ ജനൗ ച ത്രയാണാം ജനാനാം പ്രതികൂലൗ ഭവിഷ്യന്തി|</para>
  <para style="p">
    <verse number="53" style="v"/>പിതാ പുത്രസ്യ വിപക്ഷഃ പുത്രശ്ച പിതു ർവിപക്ഷോ ഭവിഷ്യതി മാതാ കന്യായാ വിപക്ഷാ കന്യാ ച മാതു ർവിപക്ഷാ ഭവിഷ്യതി, തഥാ ശ്വശ്രൂർബധ്വാ വിപക്ഷാ ബധൂശ്ച ശ്വശ്ര്വാ വിപക്ഷാ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="54" style="v"/>സ ലോകേഭ്യോപരമപി കഥയാമാസ, പശ്ചിമദിശി മേഘോദ്ഗമം ദൃഷ്ട്വാ യൂയം ഹഠാദ് വദഥ വൃഷ്ടി ർഭവിഷ്യതി തതസ്തഥൈവ ജായതേ|</para>
  <para style="p">
    <verse number="55" style="v"/>അപരം ദക്ഷിണതോ വായൗ വാതി സതി വദഥ നിദാഘോ ഭവിഷ്യതി തതഃ സോപി ജായതേ|</para>
  <para style="p">
    <verse number="56" style="v"/>രേ രേ കപടിന ആകാശസ്യ ഭൂമ്യാശ്ച ലക്ഷണം ബോദ്ധും ശക്നുഥ,</para>
  <para style="p">
    <verse number="57" style="v"/>കിന്തു കാലസ്യാസ്യ ലക്ഷണം കുതോ ബോദ്ധും ന ശക്നുഥ? യൂയഞ്ച സ്വയം കുതോ ന ന്യാഷ്യം വിചാരയഥ?</para>
  <para style="p">
    <verse number="58" style="v"/>അപരഞ്ച വിവാദിനാ സാർദ്ധം വിചാരയിതുഃ സമീപം ഗച്ഛൻ പഥി തസ്മാദുദ്ധാരം പ്രാപ്തും യതസ്വ നോചേത് സ ത്വാം ധൃത്വാ വിചാരയിതുഃ സമീപം നയതി| വിചാരയിതാ യദി ത്വാം പ്രഹർത്തുഃ സമീപം സമർപയതി പ്രഹർത്താ ത്വാം കാരായാം ബധ്നാതി</para>
  <para style="p">
    <verse number="59" style="v"/>തർഹി ത്വാമഹം വദാമി ത്വയാ നിഃശേഷം കപർദകേഷു ന പരിശോധിതേഷു ത്വം തതോ മുക്തിം പ്രാപ്തും ന ശക്ഷ്യസി|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അപരഞ്ച പീലാതോ യേഷാം ഗാലീലീയാനാം രക്താനി ബലീനാം രക്തൈഃ സഹാമിശ്രയത് തേഷാം ഗാലീലീയാനാം വൃത്താന്തം കതിപയജനാ ഉപസ്ഥാപ്യ യീശവേ കഥയാമാസുഃ|</para>
  <para style="p">
    <verse number="2" style="v"/>തതഃ സ പ്രത്യുവാച തേഷാം ലോകാനാമ് ഏതാദൃശീ ദുർഗതി ർഘടിതാ തത്കാരണാദ് യൂയം കിമന്യേഭ്യോ ഗാലീലീയേഭ്യോപ്യധികപാപിനസ്താൻ ബോധധ്വേ?</para>
  <para style="p">
    <verse number="3" style="v"/>യുഷ്മാനഹം വദാമി തഥാ ന കിന്തു മനഃസു ന പരാവർത്തിതേഷു യൂയമപി തഥാ നംക്ഷ്യഥ|</para>
  <para style="p">
    <verse number="4" style="v"/>അപരഞ്ച ശീലോഹനാമ്ന ഉച്ചഗൃഹസ്യ പതനാദ് യേഽഷ്ടാദശജനാ മൃതാസ്തേ യിരൂശാലമി നിവാസിസർവ്വലോകേഭ്യോഽധികാപരാധിനഃ കിം യൂയമിത്യം ബോധധ്വേ?</para>
  <para style="p">
    <verse number="5" style="v"/>യുഷ്മാനഹം വദാമി തഥാ ന കിന്തു മനഃസു ന പരിവർത്തിതേഷു യൂയമപി തഥാ നംക്ഷ്യഥ|</para>
  <para style="p">
    <verse number="6" style="v"/>അനന്തരം സ ഇമാം ദൃഷ്ടാന്തകഥാമകഥയദ് ഏകോ ജനോ ദ്രാക്ഷാക്ഷേത്രമധ്യ ഏകമുഡുമ്ബരവൃക്ഷം രോപിതവാൻ| പശ്ചാത് സ ആഗത്യ തസ്മിൻ ഫലാനി ഗവേഷയാമാസ,</para>
  <para style="p">
    <verse number="7" style="v"/>കിന്തു ഫലാപ്രാപ്തേഃ കാരണാദ് ഉദ്യാനകാരം ഭൃത്യം ജഗാദ, പശ്യ വത്സരത്രയം യാവദാഗത്യ ഏതസ്മിന്നുഡുമ്ബരതരൗ ക്ഷലാന്യന്വിച്ഛാമി, കിന്തു നൈകമപി പ്രപ്നോമി തരുരയം കുതോ വൃഥാ സ്ഥാനം വ്യാപ്യ തിഷ്ഠതി? ഏനം ഛിന്ധി|</para>
  <para style="p">
    <verse number="8" style="v"/>തതോ ഭൃത്യഃ പ്രത്യുവാച, ഹേ പ്രഭോ പുനർവർഷമേകം സ്ഥാതുമ് ആദിശ; ഏതസ്യ മൂലസ്യ ചതുർദിക്ഷു ഖനിത്വാഹമ് ആലവാലം സ്ഥാപയാമി|</para>
  <para style="p">
    <verse number="9" style="v"/>തതഃ ഫലിതും ശക്നോതി യദി ന ഫലതി തർഹി പശ്ചാത് ഛേത്സ്യസി|</para>
  <para style="p">
    <verse number="10" style="v"/>അഥ വിശ്രാമവാരേ ഭജനഗേഹേ യീശുരുപദിശതി</para>
  <para style="p">
    <verse number="11" style="v"/>തസ്മിത് സമയേ ഭൂതഗ്രസ്തത്വാത് കുബ്ജീഭൂയാഷ്ടാദശവർഷാണി യാവത് കേനാപ്യുപായേന ഋജു ർഭവിതും ന ശക്നോതി യാ ദുർബ്ബലാ സ്ത്രീ,</para>
  <para style="p">
    <verse number="12" style="v"/>താം തത്രോപസ്ഥിതാം വിലോക്യ യീശുസ്താമാഹൂയ കഥിതവാൻ ഹേ നാരി തവ ദൗർബ്ബല്യാത് ത്വം മുക്താ ഭവ|</para>
  <para style="p">
    <verse number="13" style="v"/>തതഃ പരം തസ്യാ ഗാത്രേ ഹസ്താർപണമാത്രാത് സാ ഋജുർഭൂത്വേശ്വരസ്യ ധന്യവാദം കർത്തുമാരേഭേ|</para>
  <para style="p">
    <verse number="14" style="v"/>കിന്തു വിശ്രാമവാരേ യീശുനാ തസ്യാഃ സ്വാസ്ഥ്യകരണാദ് ഭജനഗേഹസ്യാധിപതിഃ പ്രകുപ്യ ലോകാൻ ഉവാച, ഷട്സു ദിനേഷു ലോകൈഃ കർമ്മ കർത്തവ്യം തസ്മാദ്ധേതോഃ സ്വാസ്ഥ്യാർഥം തേഷു ദിനേഷു ആഗച്ഛത, വിശ്രാമവാരേ മാഗച്ഛത|</para>
  <para style="p">
    <verse number="15" style="v"/>തദാ പഭുഃ പ്രത്യുവാച രേ കപടിനോ യുഷ്മാകമ് ഏകൈകോ ജനോ വിശ്രാമവാരേ സ്വീയം സ്വീയം വൃഷഭം ഗർദഭം വാ ബന്ധനാന്മോചയിത്വാ ജലം പായയിതും കിം ന നയതി?</para>
  <para style="p">
    <verse number="16" style="v"/>തർഹ്യാഷ്ടാദശവത്സരാൻ യാവത് ശൈതാനാ ബദ്ധാ ഇബ്രാഹീമഃ സന്തതിരിയം നാരീ കിം വിശ്രാമവാരേ ന മോചയിതവ്യാ?</para>
  <para style="p">
    <verse number="17" style="v"/>ഏഷു വാക്യേഷു കഥിതേഷു തസ്യ വിപക്ഷാഃ സലജ്ജാ ജാതാഃ കിന്തു തേന കൃതസർവ്വമഹാകർമ്മകാരണാത് ലോകനിവഹഃ സാനന്ദോഽഭവത്|</para>
  <para style="p">
    <verse number="18" style="v"/>അനന്തരം സോവദദ് ഈശ്വരസ്യ രാജ്യം കസ്യ സദൃശം? കേന തദുപമാസ്യാമി?</para>
  <para style="p">
    <verse number="19" style="v"/>യത് സർഷപബീജം ഗൃഹീത്വാ കശ്ചിജ്ജന ഉദ്യാന ഉപ്തവാൻ തദ് ബീജമങ്കുരിതം സത് മഹാവൃക്ഷോഽജായത, തതസ്തസ്യ ശാഖാസു വിഹായസീയവിഹഗാ ആഗത്യ ന്യൂഷുഃ, തദ്രാജ്യം താദൃശേന സർഷപബീജേന തുല്യം|</para>
  <para style="p">
    <verse number="20" style="v"/>പുനഃ കഥയാമാസ, ഈശ്വരസ്യ രാജ്യം കസ്യ സദൃശം വദിഷ്യാമി? യത് കിണ്വം കാചിത് സ്ത്രീ ഗൃഹീത്വാ ദ്രോണത്രയപരിമിതഗോധൂമചൂർണേഷു സ്ഥാപയാമാസ,</para>
  <para style="p">
    <verse number="21" style="v"/>തതഃ ക്രമേണ തത് സർവ്വഗോധൂമചൂർണം വ്യാപ്നോതി, തസ്യ കിണ്വസ്യ തുല്യമ് ഈശ്വരസ്യ രാജ്യം|</para>
  <para style="p">
    <verse number="22" style="v"/>തതഃ സ യിരൂശാലമ്നഗരം പ്രതി യാത്രാം കൃത്വാ നഗരേ നഗരേ ഗ്രാമേ ഗ്രാമേ സമുപദിശൻ ജഗാമ|</para>
  <para style="p">
    <verse number="23" style="v"/>തദാ കശ്ചിജ്ജനസ്തം പപ്രച്ഛ, ഹേ പ്രഭോ കിം കേവലമ് അൽപേ ലോകാഃ പരിത്രാസ്യന്തേ?</para>
  <para style="p">
    <verse number="24" style="v"/>തതഃ സ ലോകാൻ ഉവാച, സംകീർണദ്വാരേണ പ്രവേഷ്ടും യതഘ്വം, യതോഹം യുഷ്മാൻ വദാമി, ബഹവഃ പ്രവേഷ്ടും ചേഷ്ടിഷ്യന്തേ കിന്തു ന ശക്ഷ്യന്തി|</para>
  <para style="p">
    <verse number="25" style="v"/>ഗൃഹപതിനോത്ഥായ ദ്വാരേ രുദ്ധേ സതി യദി യൂയം ബഹിഃ സ്ഥിത്വാ ദ്വാരമാഹത്യ വദഥ, ഹേ പ്രഭോ ഹേ പ്രഭോ അസ്മത്കാരണാദ് ദ്വാരം മോചയതു, തതഃ സ ഇതി പ്രതിവക്ഷ്യതി, യൂയം കുത്രത്യാ ലോകാ ഇത്യഹം ന ജാനാമി|</para>
  <para style="p">
    <verse number="26" style="v"/>തദാ യൂയം വദിഷ്യഥ, തവ സാക്ഷാദ് വയം ഭേाജനം പാനഞ്ച കൃതവന്തഃ, ത്വഞ്ചാസ്മാകം നഗരസ്യ പഥി സമുപദിഷ്ടവാൻ|</para>
  <para style="p">
    <verse number="27" style="v"/>കിന്തു സ വക്ഷ്യതി, യുഷ്മാനഹം വദാമി, യൂയം കുത്രത്യാ ലോകാ ഇത്യഹം ന ജാനാമി; ഹേ ദുരാചാരിണോ യൂയം മത്തോ ദൂരീഭവത|</para>
  <para style="p">
    <verse number="28" style="v"/>തദാ ഇബ്രാഹീമം ഇസ്ഹാകം യാകൂബഞ്ച സർവ്വഭവിഷ്യദ്വാദിനശ്ച ഈശ്വരസ്യ രാജ്യം പ്രാപ്താൻ സ്വാംശ്ച ബഹിഷ്കൃതാൻ ദൃഷ്ട്വാ യൂയം രോദനം ദന്തൈർദന്തഘർഷണഞ്ച കരിഷ്യഥ|</para>
  <para style="p">
    <verse number="29" style="v"/>അപരഞ്ച പൂർവ്വപശ്ചിമദക്ഷിണോത്തരദിഗ്ഭ്യോ ലോകാ ആഗത്യ ഈശ്വരസ്യ രാജ്യേ നിവത്സ്യന്തി|</para>
  <para style="p">
    <verse number="30" style="v"/>പശ്യതേത്ഥം ശേഷീയാ ലോകാ അഗ്രാ ഭവിഷ്യന്തി, അഗ്രീയാ ലോകാശ്ച ശേഷാ ഭവിഷ്യന്തി|</para>
  <para style="p">
    <verse number="31" style="v"/>അപരഞ്ച തസ്മിൻ ദിനേ കിയന്തഃ ഫിരൂശിന ആഗത്യ യീശും പ്രോചുഃ, ബഹിർഗച്ഛ, സ്ഥാനാദസ്മാത് പ്രസ്ഥാനം കുരു, ഹേരോദ് ത്വാം ജിഘാംസതി|</para>
  <para style="p">
    <verse number="32" style="v"/>തതഃ സ പ്രത്യവോചത് പശ്യതാദ്യ ശ്വശ്ച ഭൂതാൻ വിഹാപ്യ രോഗിണോഽരോഗിണഃ കൃത്വാ തൃതീയേഹ്നി സേത്സ്യാമി, കഥാമേതാം യൂയമിത്വാ തം ഭൂരിമായം വദത|</para>
  <para style="p">
    <verse number="33" style="v"/>തത്രാപ്യദ്യ ശ്വഃ പരശ്വശ്ച മയാ ഗമനാഗമനേ കർത്തവ്യേ, യതോ ഹേതോ ര്യിരൂശാലമോ ബഹിഃ കുത്രാപി കോപി ഭവിഷ്യദ്വാദീ ന ഘാനിഷ്യതേ|</para>
  <para style="p">
    <verse number="34" style="v"/>ഹേ യിരൂശാലമ് ഹേ യിരൂശാലമ് ത്വം ഭവിഷ്യദ്വാദിനോ ഹംസി തവാന്തികേ പ്രേരിതാൻ പ്രസ്തരൈർമാരയസി ച, യഥാ കുക്കുടീ നിജപക്ഷാധഃ സ്വശാവകാൻ സംഗൃഹ്ലാതി, തഥാഹമപി തവ ശിശൂൻ സംഗ്രഹീതും കതിവാരാൻ ഐച്ഛം കിന്തു ത്വം നൈച്ഛഃ|</para>
  <para style="p">
    <verse number="35" style="v"/>പശ്യത യുഷ്മാകം വാസസ്ഥാനാനി പ്രോച്ഛിദ്യമാനാനി പരിത്യക്താനി ച ഭവിഷ്യന്തി; യുഷ്മാനഹം യഥാർഥം വദാമി, യഃ പ്രഭോ ർനാമ്നാഗച്ഛതി സ ധന്യ ഇതി വാചം യാവത്കാലം ന വദിഷ്യഥ, താവത്കാലം യൂയം മാം ന ദ്രക്ഷ്യഥ|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അനന്തരം വിശ്രാമവാരേ യീശൗ പ്രധാനസ്യ ഫിരൂശിനോ ഗൃഹേ ഭോക്തും ഗതവതി തേ തം വീക്ഷിതുമ് ആരേഭിരേ|</para>
  <para style="p">
    <verse number="2" style="v"/>തദാ ജലോദരീ തസ്യ സമ്മുഖേ സ്ഥിതഃ|</para>
  <para style="p">
    <verse number="3" style="v"/>തതഃ സ വ്യവസ്ഥാപകാൻ ഫിരൂശിനശ്ച പപ്രച്ഛ, വിശ്രാമവാരേ സ്വാസ്ഥ്യം കർത്തവ്യം ന വാ? തതസ്തേ കിമപി ന പ്രത്യൂചുഃ|</para>
  <para style="p">
    <verse number="4" style="v"/>തദാ സ തം രോഗിണം സ്വസ്ഥം കൃത്വാ വിസസർജ;</para>
  <para style="p">
    <verse number="5" style="v"/>താനുവാച ച യുഷ്മാകം കസ്യചിദ് ഗർദ്ദഭോ വൃഷഭോ വാ ചേദ് ഗർത്തേ പതതി തർഹി വിശ്രാമവാരേ തത്ക്ഷണം സ കിം തം നോത്ഥാപയിഷ്യതി?</para>
  <para style="p">
    <verse number="6" style="v"/>തതസ്തേ കഥായാ ഏതസ്യാഃ കിമപി പ്രതിവക്തും ന ശേകുഃ|</para>
  <para style="p">
    <verse number="7" style="v"/>അപരഞ്ച പ്രധാനസ്ഥാനമനോനീതത്വകരണം വിലോക്യ സ നിമന്ത്രിതാൻ ഏതദുപദേശകഥാം ജഗാദ,</para>
  <para style="p">
    <verse number="8" style="v"/>ത്വം വിവാഹാദിഭോജ്യേഷു നിമന്ത്രിതഃ സൻ പ്രധാനസ്ഥാനേ മോപാവേക്ഷീഃ| ത്വത്തോ ഗൗരവാന്വിതനിമന്ത്രിതജന ആയാതേ</para>
  <para style="p">
    <verse number="9" style="v"/>നിമന്ത്രയിതാഗത്യ മനുഷ്യായൈതസ്മൈ സ്ഥാനം ദേഹീതി വാക്യം ചേദ് വക്ഷ്യതി തർഹി ത്വം സങ്കുചിതോ ഭൂത്വാ സ്ഥാന ഇതരസ്മിൻ ഉപവേഷ്ടുമ് ഉദ്യംസ്യസി|</para>
  <para style="p">
    <verse number="10" style="v"/>അസ്മാത് കാരണാദേവ ത്വം നിമന്ത്രിതോ ഗത്വാഽപ്രധാനസ്ഥാന ഉപവിശ, തതോ നിമന്ത്രയിതാഗത്യ വദിഷ്യതി, ഹേ ബന്ധോ പ്രോച്ചസ്ഥാനം ഗത്വോപവിശ, തഥാ സതി ഭോജനോപവിഷ്ടാനാം സകലാനാം സാക്ഷാത് ത്വം മാന്യോ ഭവിഷ്യസി|</para>
  <para style="p">
    <verse number="11" style="v"/>യഃ കശ്ചിത് സ്വമുന്നമയതി സ നമയിഷ്യതേ, കിന്തു യഃ കശ്ചിത് സ്വം നമയതി സ ഉന്നമയിഷ്യതേ|</para>
  <para style="p">
    <verse number="12" style="v"/>തദാ സ നിമന്ത്രയിതാരം ജനമപി ജഗാദ, മധ്യാഹ്നേ രാത്രൗ വാ ഭോജ്യേ കൃതേ നിജബന്ധുഗണോ വാ ഭ്രാതൃृഗണോ വാ ജ്ഞാതിഗണോ വാ ധനിഗണോ വാ സമീപവാസിഗണോ വാ ഏതാൻ ന നിമന്ത്രയ, തഥാ കൃതേ ചേത് തേ ത്വാം നിമന്ത്രയിഷ്യന്തി, തർഹി പരിശോധോ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="13" style="v"/>കിന്തു യദാ ഭേജ്യം കരോഷി തദാ ദരിദ്രശുഷ്കകരഖഞ്ജാന്ധാൻ നിമന്ത്രയ,</para>
  <para style="p">
    <verse number="14" style="v"/>തത ആശിഷം ലപ്സ്യസേ, തേഷു പരിശോധം കർത്തുമശക്നുവത്സു ശ്മശാനാദ്ധാർമ്മികാനാമുത്ഥാനകാലേ ത്വം ഫലാം ലപ്സ്യസേ|</para>
  <para style="p">
    <verse number="15" style="v"/>അനന്തരം താം കഥാം നിശമ്യ ഭോജനോപവിഷ്ടഃ കശ്ചിത് കഥയാമാസ, യോ ജന ഈശ്വരസ്യ രാജ്യേ ഭോക്തും ലപ്സ്യതേ സഏവ ധന്യഃ|</para>
  <para style="p">
    <verse number="16" style="v"/>തതഃ സ ഉവാച, കശ്ചിത് ജനോ രാത്രൗ ഭേाജ്യം കൃത്വാ ബഹൂൻ നിമന്ത്രയാമാസ|</para>
  <para style="p">
    <verse number="17" style="v"/>തതോ ഭോജനസമയേ നിമന്ത്രിതലോകാൻ ആഹ്വാതും ദാസദ്വാരാ കഥയാമാസ, ഖദ്യദ്രവ്യാണി സർവ്വാണി സമാസാദിതാനി സന്തി, യൂയമാഗച്ഛത|</para>
  <para style="p">
    <verse number="18" style="v"/>കിന്തു തേ സർവ്വ ഏകൈകം ഛലം കൃത്വാ ക്ഷമാം പ്രാർഥയാഞ്ചക്രിരേ| പ്രഥമോ ജനഃ കഥയാമാസ, ക്ഷേത്രമേകം ക്രീതവാനഹം തദേവ ദ്രഷ്ടും മയാ ഗന്തവ്യമ്, അതഏവ മാം ക്ഷന്തും തം നിവേദയ|</para>
  <para style="p">
    <verse number="19" style="v"/>അന്യോ ജനഃ കഥയാമാസ, ദശവൃഷാനഹം ക്രീതവാൻ താൻ പരീക്ഷിതും യാമി തസ്മാദേവ മാം ക്ഷന്തും തം നിവേദയ|</para>
  <para style="p">
    <verse number="20" style="v"/>അപരഃ കഥയാമാസ, വ്യൂഢവാനഹം തസ്മാത് കാരണാദ് യാതും ന ശക്നോമി|</para>
  <para style="p">
    <verse number="21" style="v"/>പശ്ചാത് സ ദാസോ ഗത്വാ നിജപ്രഭോഃ സാക്ഷാത് സർവ്വവൃത്താന്തം നിവേദയാമാസ, തതോസൗ ഗൃഹപതിഃ കുപിത്വാ സ്വദാസം വ്യാജഹാര, ത്വം സത്വരം നഗരസ്യ സന്നിവേശാൻ മാർഗാംശ്ച ഗത്വാ ദരിദ്രശുഷ്കകരഖഞ്ജാന്ധാൻ അത്രാനയ|</para>
  <para style="p">
    <verse number="22" style="v"/>തതോ ദാസോഽവദത്, ഹേ പ്രഭോ ഭവത ആജ്ഞാനുസാരേണാക്രിയത തഥാപി സ്ഥാനമസ്തി|</para>
  <para style="p">
    <verse number="23" style="v"/>തദാ പ്രഭുഃ പുന ർദാസായാകഥയത്, രാജപഥാൻ വൃക്ഷമൂലാനി ച യാത്വാ മദീയഗൃഹപൂരണാർഥം ലോകാനാഗന്തും പ്രവർത്തയ|</para>
  <para style="p">
    <verse number="24" style="v"/>അഹം യുഷ്മഭ്യം കഥയാമി, പൂർവ്വനിമന്ത്രിതാനമേകോപി മമാസ്യ രാത്രിഭോജ്യസ്യാസ്വാദം ന പ്രാപ്സ്യതി|</para>
  <para style="p">
    <verse number="25" style="v"/>അനന്തരം ബഹുഷു ലോകേഷു യീശോഃ പശ്ചാദ് വ്രജിതേഷു സത്സു സ വ്യാഘുട്യ തേഭ്യഃ കഥയാമാസ,</para>
  <para style="p">
    <verse number="26" style="v"/>യഃ കശ്ചിൻ മമ സമീപമ് ആഗത്യ സ്വസ്യ മാതാ പിതാ പത്നീ സന്താനാ ഭ്രാതരോ ഭഗിമ്യോ നിജപ്രാണാശ്ച, ഏതേഭ്യഃ സർവ്വേഭ്യോ മയ്യധികം പ്രേമ ന കരോതി, സ മമ ശിഷ്യോ ഭവിതും ന ശക്ഷ്യതി|</para>
  <para style="p">
    <verse number="27" style="v"/>യഃ കശ്ചിത് സ്വീയം ക്രുശം വഹൻ മമ പശ്ചാന്ന ഗച്ഛതി, സോപി മമ ശിഷ്യോ ഭവിതും ന ശക്ഷ്യതി|</para>
  <para style="p">
    <verse number="28" style="v"/>ദുർഗനിർമ്മാണേ കതിവ്യയോ ഭവിഷ്യതി, തഥാ തസ്യ സമാപ്തികരണാർഥം സമ്പത്തിരസ്തി ന വാ, പ്രഥമമുപവിശ്യ ഏതന്ന ഗണയതി, യുഷ്മാകം മധ്യ ഏതാദൃശഃ കോസ്തി?</para>
  <para style="p">
    <verse number="29" style="v"/>നോചേദ് ഭിത്തിം കൃത്വാ ശേഷേ യദി സമാപയിതും ന ശക്ഷ്യതി,</para>
  <para style="p">
    <verse number="30" style="v"/>തർഹി മാനുഷോയം നിചേതുമ് ആരഭത സമാപയിതും നാശക്നോത്, ഇതി വ്യാഹൃത്യ സർവ്വേ തമുപഹസിഷ്യന്തി|</para>
  <para style="p">
    <verse number="31" style="v"/>അപരഞ്ച ഭിന്നഭൂപതിനാ സഹ യുദ്ധം കർത്തുമ് ഉദ്യമ്യ ദശസഹസ്രാണി സൈന്യാനി ഗൃഹീത്വാ വിംശതിസഹസ്രേഃ സൈന്യൈഃ സഹിതസ്യ സമീപവാസിനഃ സമ്മുഖം യാതും ശക്ഷ്യാമി ന വേതി പ്രഥമം ഉപവിശ്യ ന വിചാരയതി ഏതാദൃശോ ഭൂമിപതിഃ കഃ?</para>
  <para style="p">
    <verse number="32" style="v"/>യദി ന ശക്നോതി തർഹി രിപാവതിദൂരേ തിഷ്ഠതി സതി നിജദൂതം പ്രേഷ്യ സന്ധിം കർത്തും പ്രാർഥയേത|</para>
  <para style="p">
    <verse number="33" style="v"/>തദ്വദ് യുഷ്മാകം മധ്യേ യഃ കശ്ചിൻ മദർഥം സർവ്വസ്വം ഹാതും ന ശക്നോതി സ മമ ശിഷ്യോ ഭവിതും ന ശക്ഷ്യതി|</para>
  <para style="p">
    <verse number="34" style="v"/>ലവണമ് ഉത്തമമ് ഇതി സത്യം, കിന്തു യദി ലവണസ്യ ലവണത്വമ് അപഗച്ഛതി തർഹി തത് കഥം സ്വാദുയുക്തം ഭവിഷ്യതി?</para>
  <para style="p">
    <verse number="35" style="v"/>തദ ഭൂമ്യർഥമ് ആലവാലരാശ്യർഥമപി ഭദ്രം ന ഭവതി; ലോകാസ്തദ് ബഹിഃ ക്ഷിപന്തി| യസ്യ ശ്രോതും ശ്രോത്രേ സ്തഃ സ ശൃണോതു|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>തദാ കരസഞ്ചായിനഃ പാപിനശ്ച ലോകാ ഉപദേശ്കഥാം ശ്രോതും യീശോഃ സമീപമ് ആഗച്ഛൻ|</para>
  <para style="p">
    <verse number="2" style="v"/>തതഃ ഫിരൂശിന ഉപാധ്യായാശ്ച വിവദമാനാഃ കഥയാമാസുഃ ഏഷ മാനുഷഃ പാപിഭിഃ സഹ പ്രണയം കൃത്വാ തൈഃ സാർദ്ധം ഭുംക്തേ|</para>
  <para style="p">
    <verse number="3" style="v"/>തദാ സ തേഭ്യ ഇമാം ദൃഷ്ടാന്തകഥാം കഥിതവാൻ,</para>
  <para style="p">
    <verse number="4" style="v"/>കസ്യചിത് ശതമേഷേഷു തിഷ്ഠത്മു തേഷാമേകം സ യദി ഹാരയതി തർഹി മധ്യേപ്രാന്തരമ് ഏകോനശതമേഷാൻ വിഹായ ഹാരിതമേഷസ്യ ഉദ്ദേശപ്രാപ്തിപര്യ്യനതം ന ഗവേഷയതി, ഏതാദൃശോ ലോകോ യുഷ്മാകം മധ്യേ ക ആസ്തേ?</para>
  <para style="p">
    <verse number="5" style="v"/>തസ്യോദ്ദേശം പ്രാപ്യ ഹൃഷ്ടമനാസ്തം സ്കന്ധേ നിധായ സ്വസ്ഥാനമ് ആനീയ ബന്ധുബാന്ധവസമീപവാസിന ആഹൂയ വക്തി,</para>
  <para style="p">
    <verse number="6" style="v"/>ഹാരിതം മേഷം പ്രാപ്തോഹമ് അതോ ഹേതോ ർമയാ സാർദ്ധമ് ആനന്ദത|</para>
  <para style="p">
    <verse number="7" style="v"/>തദ്വദഹം യുഷ്മാൻ വദാമി, യേഷാം മനഃപരാവർത്തനസ്യ പ്രയോജനം നാസ്തി, താദൃശൈകോനശതധാർമ്മികകാരണാദ് യ ആനന്ദസ്തസ്മാദ് ഏകസ്യ മനഃപരിവർത്തിനഃ പാപിനഃ കാരണാത് സ്വർഗേ ഽധികാനന്ദോ ജായതേ|</para>
  <para style="p">
    <verse number="8" style="v"/>അപരഞ്ച ദശാനാം രൂപ്യഖണ്ഡാനാമ് ഏകഖണ്ഡേ ഹാരിതേ പ്രദീപം പ്രജ്വാല്യ ഗൃഹം സമ്മാർജ്യ തസ്യ പ്രാപ്തിം യാവദ് യത്നേന ന ഗവേഷയതി, ഏതാദൃശീ യോഷിത് കാസ്തേ?</para>
  <para style="p">
    <verse number="9" style="v"/>പ്രാപ്തേ സതി ബന്ധുബാന്ധവസമീപവാസിനീരാഹൂയ കഥയതി, ഹാരിതം രൂപ്യഖണ്ഡം പ്രാപ്താഹം തസ്മാദേവ മയാ സാർദ്ധമ് ആനന്ദത|</para>
  <para style="p">
    <verse number="10" style="v"/>തദ്വദഹം യുഷ്മാൻ വ്യാഹരാമി, ഏകേന പാപിനാ മനസി പരിവർത്തിതേ, ഈശ്വരസ്യ ദൂതാനാം മധ്യേപ്യാനന്ദോ ജായതേ|</para>
  <para style="p">
    <verse number="11" style="v"/>അപരഞ്ച സ കഥയാമാസ, കസ്യചിദ് ദ്വൗ പുത്രാവാസ്താം,</para>
  <para style="p">
    <verse number="12" style="v"/>തയോഃ കനിഷ്ഠഃ പുത്രഃ പിത്രേ കഥയാമാസ, ഹേ പിതസ്തവ സമ്പത്ത്യാ യമംശം പ്രാപ്സ്യാമ്യഹം വിഭജ്യ തം ദേഹി, തതഃ പിതാ നിജാം സമ്പത്തിം വിഭജ്യ താഭ്യാം ദദൗ|</para>
  <para style="p">
    <verse number="13" style="v"/>കതിപയാത് കാലാത് പരം സ കനിഷ്ഠപുത്രഃ സമസ്തം ധനം സംഗൃഹ്യ ദൂരദേശം ഗത്വാ ദുഷ്ടാചരണേന സർവ്വാം സമ്പത്തിം നാശയാമാസ|</para>
  <para style="p">
    <verse number="14" style="v"/>തസ്യ സർവ്വധനേ വ്യയം ഗതേ തദ്ദേശേ മഹാദുർഭിക്ഷം ബഭൂവ, തതസ്തസ്യ ദൈന്യദശാ ഭവിതുമ് ആരേഭേ|</para>
  <para style="p">
    <verse number="15" style="v"/>തതഃ പരം സ ഗത്വാ തദ്ദേശീയം ഗൃഹസ്ഥമേകമ് ആശ്രയത; തതഃ സതം ശൂകരവ്രജം ചാരയിതും പ്രാന്തരം പ്രേഷയാമാസ|</para>
  <para style="p">
    <verse number="16" style="v"/>കേനാപി തസ്മൈ ഭക്ഷ്യാദാനാത് സ ശൂകരഫലവൽകലേന പിചിണ്ഡപൂരണാം വവാഞ്ഛ|</para>
  <para style="p">
    <verse number="17" style="v"/>ശേഷേ സ മനസി ചേതനാം പ്രാപ്യ കഥയാമാസ, ഹാ മമ പിതുഃ സമീപേ കതി കതി വേതനഭുജോ ദാസാ യഥേഷ്ടം തതോധികഞ്ച ഭക്ഷ്യം പ്രാപ്നുവന്തി കിന്ത്വഹം ക്ഷുധാ മുമൂർഷുഃ|</para>
  <para style="p">
    <verse number="18" style="v"/>അഹമുത്ഥായ പിതുഃ സമീപം ഗത്വാ കഥാമേതാം വദിഷ്യാമി, ഹേ പിതർ ഈശ്വരസ്യ തവ ച വിരുദ്ധം പാപമകരവമ്</para>
  <para style="p">
    <verse number="19" style="v"/>തവ പുത്രഇതി വിഖ്യാതോ ഭവിതും ന യോഗ്യോസ്മി ച, മാം തവ വൈതനികം ദാസം കൃത്വാ സ്ഥാപയ|</para>
  <para style="p">
    <verse number="20" style="v"/>പശ്ചാത് സ ഉത്ഥായ പിതുഃ സമീപം ജഗാമ; തതസ്തസ്യ പിതാതിദൂരേ തം നിരീക്ഷ്യ ദയാഞ്ചക്രേ, ധാവിത്വാ തസ്യ കണ്ഠം ഗൃഹീത്വാ തം ചുചുമ്ബ ച|</para>
  <para style="p">
    <verse number="21" style="v"/>തദാ പുത്ര ഉവാച, ഹേ പിതർ ഈശ്വരസ്യ തവ ച വിരുദ്ധം പാപമകരവം, തവ പുത്രഇതി വിഖ്യാതോ ഭവിതും ന യോഗ്യോസ്മി ച|</para>
  <para style="p">
    <verse number="22" style="v"/>കിന്തു തസ്യ പിതാ നിജദാസാൻ ആദിദേശ, സർവ്വോത്തമവസ്ത്രാണ്യാനീയ പരിധാപയതൈനം ഹസ്തേ ചാങ്ഗുരീയകമ് അർപയത പാദയോശ്ചോപാനഹൗ സമർപയത;</para>
  <para style="p">
    <verse number="23" style="v"/>പുഷ്ടം ഗോവത്സമ് ആനീയ മാരയത ച തം ഭുക്ത്വാ വയമ് ആനന്ദാമ|</para>
  <para style="p">
    <verse number="24" style="v"/>യതോ മമ പുത്രോയമ് അമ്രിയത പുനരജീവീദ് ഹാരിതശ്ച ലബ്ധോഭൂത് തതസ്ത ആനന്ദിതുമ് ആരേഭിരേ|</para>
  <para style="p">
    <verse number="25" style="v"/>തത്കാലേ തസ്യ ജ്യേഷ്ഠഃ പുത്രഃ ക്ഷേത്ര ആസീത്| അഥ സ നിവേശനസ്യ നികടം ആഗച്ഛൻ നൃത്യാനാം വാദ്യാനാഞ്ച ശബ്ദം ശ്രുത്വാ</para>
  <para style="p">
    <verse number="26" style="v"/>ദാസാനാമ് ഏകമ് ആഹൂയ പപ്രച്ഛ, കിം കാരണമസ്യ?</para>
  <para style="p">
    <verse number="27" style="v"/>തതഃ സോവാദീത്, തവ ഭ്രാതാഗമത്, തവ താതശ്ച തം സുശരീരം പ്രാപ്യ പുഷ്ടം ഗോവത്സം മാരിതവാൻ|</para>
  <para style="p">
    <verse number="28" style="v"/>തതഃ സ പ്രകുപ്യ നിവേശനാന്തഃ പ്രവേഷ്ടും ന സമ്മേനേ; തതസ്തസ്യ പിതാ ബഹിരാഗത്യ തം സാധയാമാസ|</para>
  <para style="p">
    <verse number="29" style="v"/>തതഃ സ പിതരം പ്രത്യുവാച, പശ്യ തവ കാഞ്ചിദപ്യാജ്ഞാം ന വിലംഘ്യ ബഹൂൻ വത്സരാൻ അഹം ത്വാം സേവേ തഥാപി മിത്രൈഃ സാർദ്ധമ് ഉത്സവം കർത്തും കദാപി ഛാഗമേകമപി മഹ്യം നാദദാഃ;</para>
  <para style="p">
    <verse number="30" style="v"/>കിന്തു തവ യഃ പുത്രോ വേശ്യാഗമനാദിഭിസ്തവ സമ്പത്തിമ് അപവ്യയിതവാൻ തസ്മിന്നാഗതമാത്രേ തസ്യൈവ നിമിത്തം പുഷ്ടം ഗോവത്സം മാരിതവാൻ|</para>
  <para style="p">
    <verse number="31" style="v"/>തദാ തസ്യ പിതാവോചത്, ഹേ പുത്ര ത്വം സർവ്വദാ മയാ സഹാസി തസ്മാൻ മമ യദ്യദാസ്തേ തത്സർവ്വം തവ|</para>
  <para style="p">
    <verse number="32" style="v"/>കിന്തു തവായം ഭ്രാതാ മൃതഃ പുനരജീവീദ് ഹാരിതശ്ച ഭൂത്വാ പ്രാപ്തോഭൂത്, ഏതസ്മാത് കാരണാദ് ഉത്സവാനന്ദൗ കർത്തുമ് ഉചിതമസ്മാകമ്|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അപരഞ്ച യീശുഃ ശിഷ്യേഭ്യോന്യാമേകാം കഥാം കഥയാമാസ കസ്യചിദ് ധനവതോ മനുഷ്യസ്യ ഗൃഹകാര്യ്യാധീശേ സമ്പത്തേരപവ്യയേഽപവാദിതേ സതി</para>
  <para style="p">
    <verse number="2" style="v"/>തസ്യ പ്രഭുസ്തമ് ആഹൂയ ജഗാദ, ത്വയി യാമിമാം കഥാം ശൃണോമി സാ കീദൃശീ? ത്വം ഗൃഹകാര്യ്യാധീശകർമ്മണോ ഗണനാം ദർശയ ഗൃഹകാര്യ്യാധീശപദേ ത്വം ന സ്ഥാസ്യസി|</para>
  <para style="p">
    <verse number="3" style="v"/>തദാ സ ഗൃഹകാര്യ്യാധീശോ മനസാ ചിന്തയാമാസ, പ്രഭു ര്യദി മാം ഗൃഹകാര്യ്യാധീശപദാദ് ഭ്രംശയതി തർഹി കിം കരിഷ്യേഽഹം? മൃദം ഖനിതും മമ ശക്തി ർനാസ്തി ഭിക്ഷിതുഞ്ച ലജ്ജിഷ്യേഽഹം|</para>
  <para style="p">
    <verse number="4" style="v"/>അതഏവ മയി ഗൃഹകാര്യ്യാധീശപദാത് ച്യുതേ സതി യഥാ ലോകാ മഹ്യമ് ആശ്രയം ദാസ്യന്തി തദർഥം യത്കർമ്മ മയാ കരണീയം തൻ നിർണീയതേ|</para>
  <para style="p">
    <verse number="5" style="v"/>പശ്ചാത് സ സ്വപ്രഭോരേകൈകമ് അധമർണമ് ആഹൂയ പ്രഥമം പപ്രച്ഛ, ത്വത്തോ മേ പ്രഭുണാ കതി പ്രാപ്യമ്?</para>
  <para style="p">
    <verse number="6" style="v"/>തതഃ സ ഉവാച, ഏകശതാഢകതൈലാനി; തദാ ഗൃഹകാര്യ്യാധീശഃ പ്രോവാച, തവ പത്രമാനീയ ശീഘ്രമുപവിശ്യ തത്ര പഞ്ചാശതം ലിഖ|</para>
  <para style="p">
    <verse number="7" style="v"/>പശ്ചാദന്യമേകം പപ്രച്ഛ, ത്വത്തോ മേ പ്രഭുണാ കതി പ്രാപ്യമ്? തതഃ സോവാദീദ് ഏകശതാഢകഗോധൂമാഃ; തദാ സ കഥയാമാസ, തവ പത്രമാനീയ അശീതിം ലിഖ|</para>
  <para style="p">
    <verse number="8" style="v"/>തേനൈവ പ്രഭുസ്തമയഥാർഥകൃതമ് അധീശം തദ്ബുദ്ധിനൈപുണ്യാത് പ്രശശംസ; ഇത്ഥം ദീപ്തിരൂപസന്താനേഭ്യ ഏതത്സംസാരസ്യ സന്താനാ വർത്തമാനകാലേഽധികബുദ്ധിമന്തോ ഭവന്തി|</para>
  <para style="p">
    <verse number="9" style="v"/>അതോ വദാമി യൂയമപ്യയഥാർഥേന ധനേന മിത്രാണി ലഭധ്വം തതോ യുഷ്മാസു പദഭ്രഷ്ടേഷ്വപി താനി ചിരകാലമ് ആശ്രയം ദാസ്യന്തി|</para>
  <para style="p">
    <verse number="10" style="v"/>യഃ കശ്ചിത് ക്ഷുദ്രേ കാര്യ്യേ വിശ്വാസ്യോ ഭവതി സ മഹതി കാര്യ്യേപി വിശ്വാസ്യോ ഭവതി, കിന്തു യഃ കശ്ചിത് ക്ഷുദ്രേ കാര്യ്യേഽവിശ്വാസ്യോ ഭവതി സ മഹതി കാര്യ്യേപ്യവിശ്വാസ്യോ ഭവതി|</para>
  <para style="p">
    <verse number="11" style="v"/>അതഏവ അയഥാർഥേന ധനേന യദി യൂയമവിശ്വാസ്യാ ജാതാസ്തർഹി സത്യം ധനം യുഷ്മാകം കരേഷു കഃ സമർപയിഷ്യതി?</para>
  <para style="p">
    <verse number="12" style="v"/>യദി ച പരധനേന യൂയമ് അവിശ്വാസ്യാ ഭവഥ തർഹി യുഷ്മാകം സ്വകീയധനം യുഷ്മഭ്യം കോ ദാസ്യതി?</para>
  <para style="p">
    <verse number="13" style="v"/>കോപി ദാസ ഉഭൗ പ്രഭൂ സേവിതും ന ശക്നോതി, യത ഏകസ്മിൻ പ്രീയമാണോഽന്യസ്മിന്നപ്രീയതേ യദ്വാ ഏകം ജനം സമാദൃത്യ തദന്യം തുച്ഛീകരോതി തദ്വദ് യൂയമപി ധനേശ്വരൗ സേവിതും ന ശക്നുഥ|</para>
  <para style="p">
    <verse number="14" style="v"/>തദൈതാഃ സർവ്വാഃ കഥാഃ ശ്രുത്വാ ലോഭിഫിരൂശിനസ്തമുപജഹസുഃ|</para>
  <para style="p">
    <verse number="15" style="v"/>തതഃ സ ഉവാച, യൂയം മനുഷ്യാണാം നികടേ സ്വാൻ നിർദോഷാൻ ദർശയഥ കിന്തു യുഷ്മാകമ് അന്തഃകരണാനീശ്വരോ ജാനാതി, യത് മനുഷ്യാണാമ് അതി പ്രശംസ്യം തദ് ഈശ്വരസ്യ ഘൃണ്യം|</para>
  <para style="p">
    <verse number="16" style="v"/>യോഹന ആഗമനപര്യ്യനതം യുഷ്മാകം സമീപേ വ്യവസ്ഥാഭവിഷ്യദ്വാദിനാം ലേഖനാനി ചാസൻ തതഃ പ്രഭൃതി ഈശ്വരരാജ്യസ്യ സുസംവാദഃ പ്രചരതി, ഏകൈകോ ലോകസ്തന്മധ്യം യത്നേന പ്രവിശതി ച|</para>
  <para style="p">
    <verse number="17" style="v"/>വരം നഭസഃ പൃഥിവ്യാശ്ച ലോപോ ഭവിഷ്യതി തഥാപി വ്യവസ്ഥായാ ഏകബിന്ദോരപി ലോപോ ന ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="18" style="v"/>യഃ കശ്ചിത് സ്വീയാം ഭാര്യ്യാം വിഹായ സ്ത്രിയമന്യാം വിവഹതി സ പരദാരാൻ ഗച്ഛതി, യശ്ച താ ത്യക്താം നാരീം വിവഹതി സോപി പരദാരാന ഗച്ഛതി|</para>
  <para style="p">
    <verse number="19" style="v"/>ഏകോ ധനീ മനുഷ്യഃ ശുക്ലാനി സൂക്ഷ്മാണി വസ്ത്രാണി പര്യ്യദധാത് പ്രതിദിനം പരിതോഷരൂപേണാഭുംക്താപിവച്ച|</para>
  <para style="p">
    <verse number="20" style="v"/>സർവ്വാങ്ഗേ ക്ഷതയുക്ത ഇലിയാസരനാമാ കശ്ചിദ് ദരിദ്രസ്തസ്യ ധനവതോ ഭോജനപാത്രാത് പതിതമ് ഉച്ഛിഷ്ടം ഭോക്തും വാഞ്ഛൻ തസ്യ ദ്വാരേ പതിത്വാതിഷ്ഠത്;</para>
  <para style="p">
    <verse number="21" style="v"/>അഥ ശ്വാന ആഗത്യ തസ്യ ക്ഷതാന്യലിഹൻ|</para>
  <para style="p">
    <verse number="22" style="v"/>കിയത്കാലാത്പരം സ ദരിദ്രഃ പ്രാണാൻ ജഹൗ; തതഃ സ്വർഗീയദൂതാസ്തം നീത്വാ ഇബ്രാഹീമഃ ക്രോഡ ഉപവേശയാമാസുഃ|</para>
  <para style="p">
    <verse number="23" style="v"/>പശ്ചാത് സ ധനവാനപി മമാര, തം ശ്മശാനേ സ്ഥാപയാമാസുശ്ച; കിന്തു പരലോകേ സ വേദനാകുലഃ സൻ ഊർദ്ധ്വാം നിരീക്ഷ്യ ബഹുദൂരാദ് ഇബ്രാഹീമം തത്ക്രോഡ ഇലിയാസരഞ്ച വിലോക്യ രുവന്നുവാച;</para>
  <para style="p">
    <verse number="24" style="v"/>ഹേ പിതർ ഇബ്രാഹീമ് അനുഗൃഹ്യ അങ്ഗുല്യഗ്രഭാഗം ജലേ മജ്ജയിത്വാ മമ ജിഹ്വാം ശീതലാം കർത്തുമ് ഇലിയാസരം പ്രേരയ, യതോ വഹ്നിശിഖാതോഹം വ്യഥിതോസ്മി|</para>
  <para style="p">
    <verse number="25" style="v"/>തദാ ഇബ്രാഹീമ് ബഭാഷേ, ഹേ പുത്ര ത്വം ജീവൻ സമ്പദം പ്രാപ്തവാൻ ഇലിയാസരസ്തു വിപദം പ്രാപ്തവാൻ ഏതത് സ്മര, കിന്തു സമ്പ്രതി തസ്യ സുഖം തവ ച ദുഃഖം ഭവതി|</para>
  <para style="p">
    <verse number="26" style="v"/>അപരമപി യുഷ്മാകമ് അസ്മാകഞ്ച സ്ഥാനയോ ർമധ്യേ മഹദ്വിച്ഛേദോഽസ്തി തത ഏതത്സ്ഥാനസ്യ ലോകാസ്തത് സ്ഥാനം യാതും യദ്വാ തത്സ്ഥാനസ്യ ലോകാ ഏതത് സ്ഥാനമായാതും ന ശക്നുവന്തി|</para>
  <para style="p">
    <verse number="27" style="v"/>തദാ സ ഉക്തവാൻ, ഹേ പിതസ്തർഹി ത്വാം നിവേദയാമി മമ പിതു ർഗേഹേ യേ മമ പഞ്ച ഭ്രാതരഃ സന്തി</para>
  <para style="p">
    <verse number="28" style="v"/>തേ യഥൈതദ് യാതനാസ്ഥാനം നായാസ്യന്തി തഥാ മന്ത്രണാം ദാതും തേഷാം സമീപമ് ഇലിയാസരം പ്രേരയ|</para>
  <para style="p">
    <verse number="29" style="v"/>തത ഇബ്രാഹീമ് ഉവാച, മൂസാഭവിഷ്യദ്വാദിനാഞ്ച പുസ്തകാനി തേഷാം നികടേ സന്തി തേ തദ്വചനാനി മന്യന്താം|</para>
  <para style="p">
    <verse number="30" style="v"/>തദാ സ നിവേദയാമാസ, ഹേ പിതർ ഇബ്രാഹീമ് ന തഥാ, കിന്തു യദി മൃതലോകാനാം കശ്ചിത് തേഷാം സമീപം യാതി തർഹി തേ മനാംസി വ്യാഘോടയിഷ്യന്തി|</para>
  <para style="p">
    <verse number="31" style="v"/>തത ഇബ്രാഹീമ് ജഗാദ, തേ യദി മൂസാഭവിഷ്യദ്വാദിനാഞ്ച വചനാനി ന മന്യന്തേ തർഹി മൃതലോകാനാം കസ്മിംശ്ചിദ് ഉത്ഥിതേപി തേ തസ്യ മന്ത്രണാം ന മംസ്യന്തേ|</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ഇതഃ പരം യീശുഃ ശിഷ്യാൻ ഉവാച, വിഘ്നൈരവശ്യമ് ആഗന്തവ്യം കിന്തു വിഘ്നാ യേന ഘടിഷ്യന്തേ തസ്യ ദുർഗതി ർഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="2" style="v"/>ഏതേഷാം ക്ഷുദ്രപ്രാണിനാമ് ഏകസ്യാപി വിഘ്നജനനാത് കണ്ഠബദ്ധപേഷണീകസ്യ തസ്യ സാഗരാഗാധജലേ മജ്ജനം ഭദ്രം|</para>
  <para style="p">
    <verse number="3" style="v"/>യൂയം സ്വേഷു സാവധാനാസ്തിഷ്ഠത; തവ ഭ്രാതാ യദി തവ കിഞ്ചിദ് അപരാധ്യതി തർഹി തം തർജയ, തേന യദി മനഃ പരിവർത്തയതി തർഹി തം ക്ഷമസ്വ|</para>
  <para style="p">
    <verse number="4" style="v"/>പുനരേകദിനമധ്യേ യദി സ തവ സപ്തകൃത്വോഽപരാധ്യതി കിന്തു സപ്തകൃത്വ ആഗത്യ മനഃ പരിവർത്യ മയാപരാദ്ധമ് ഇതി വദതി തർഹി തം ക്ഷമസ്വ|</para>
  <para style="p">
    <verse number="5" style="v"/>തദാ പ്രേരിതാഃ പ്രഭുമ് അവദൻ അസ്മാകം വിശ്വാസം വർദ്ധയ|</para>
  <para style="p">
    <verse number="6" style="v"/>പ്രഭുരുവാച, യദി യുഷ്മാകം സർഷപൈകപ്രമാണോ വിശ്വാസോസ്തി തർഹി ത്വം സമൂലമുത്പാടിതോ ഭൂത്വാ സമുദ്രേ രോപിതോ ഭവ കഥായാമ് ഏതസ്യാമ് ഏതദുഡുമ്ബരായ കഥിതായാം സ യുഷ്മാകമാജ്ഞാവഹോ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="7" style="v"/>അപരം സ്വദാസേ ഹലം വാഹയിത്വാ വാ പശൂൻ ചാരയിത്വാ ക്ഷേത്രാദ് ആഗതേ സതി തം വദതി, ഏഹി ഭോക്തുമുപവിശ, യുഷ്മാകമ് ഏതാദൃശഃ കോസ്തി?</para>
  <para style="p">
    <verse number="8" style="v"/>വരഞ്ച പൂർവ്വം മമ ഖാദ്യമാസാദ്യ യാവദ് ഭുഞ്ജേ പിവാമി ച താവദ് ബദ്ധകടിഃ പരിചര പശ്ചാത് ത്വമപി ഭോക്ഷ്യസേ പാസ്യസി ച കഥാമീദൃശീം കിം ന വക്ഷ്യതി?</para>
  <para style="p">
    <verse number="9" style="v"/>തേന ദാസേന പ്രഭോരാജ്ഞാനുരൂപേ കർമ്മണി കൃതേ പ്രഭുഃ കിം തസ്മിൻ ബാധിതോ ജാതഃ? നേത്ഥം ബുധ്യതേ മയാ|</para>
  <para style="p">
    <verse number="10" style="v"/>ഇത്ഥം നിരൂപിതേഷു സർവ്വകർമ്മസു കൃതേഷു സത്മു യൂയമപീദം വാക്യം വദഥ, വയമ് അനുപകാരിണോ ദാസാ അസ്മാഭിര്യദ്യത്കർത്തവ്യം തന്മാത്രമേവ കൃതം|</para>
  <para style="p">
    <verse number="11" style="v"/>സ യിരൂശാലമി യാത്രാം കുർവ്വൻ ശോമിരോൺഗാലീൽപ്രദേശമധ്യേന ഗച്ഛതി,</para>
  <para style="p">
    <verse number="12" style="v"/>ഏതർഹി കുത്രചിദ് ഗ്രാമേ പ്രവേശമാത്രേ ദശകുഷ്ഠിനസ്തം സാക്ഷാത് കൃത്വാ</para>
  <para style="p">
    <verse number="13" style="v"/>ദൂരേ തിഷ്ഠനത ഉച്ചൈ ർവക്തുമാരേഭിരേ, ഹേ പ്രഭോ യീശോ ദയസ്വാസ്മാൻ|</para>
  <para style="p">
    <verse number="14" style="v"/>തതഃ സ താൻ ദൃഷ്ട്വാ ജഗാദ, യൂയം യാജകാനാം സമീപേ സ്വാൻ ദർശയത, തതസ്തേ ഗച്ഛന്തോ രോഗാത് പരിഷ്കൃതാഃ|</para>
  <para style="p">
    <verse number="15" style="v"/>തദാ തേഷാമേകഃ സ്വം സ്വസ്ഥം ദൃഷ്ട്വാ പ്രോച്ചൈരീശ്വരം ധന്യം വദൻ വ്യാഘുട്യായാതോ യീശോ ർഗുണാനനുവദൻ തച്ചരണാധോഭൂമൗ പപാത;</para>
  <para style="p">
    <verse number="16" style="v"/>സ ചാസീത് ശോമിരോണീ|</para>
  <para style="p">
    <verse number="17" style="v"/>തദാ യീശുരവദത്, ദശജനാഃ കിം ന പരിഷ്കൃതാഃ? തഹ്യന്യേ നവജനാഃ കുത്ര?</para>
  <para style="p">
    <verse number="18" style="v"/>ഈശ്വരം ധന്യം വദന്തമ് ഏനം വിദേശിനം വിനാ കോപ്യന്യോ ന പ്രാപ്യത|</para>
  <para style="p">
    <verse number="19" style="v"/>തദാ സ തമുവാച, ത്വമുത്ഥായ യാഹി വിശ്വാസസ്തേ ത്വാം സ്വസ്ഥം കൃതവാൻ|</para>
  <para style="p">
    <verse number="20" style="v"/>അഥ കദേശ്വരസ്യ രാജത്വം ഭവിഷ്യതീതി ഫിരൂശിഭിഃ പൃഷ്ടേ സ പ്രത്യുവാച, ഈശ്വരസ്യ രാജത്വമ് ഐശ്വര്യ്യദർശനേന ന ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="21" style="v"/>അത ഏതസ്മിൻ പശ്യ തസ്മിൻ വാ പശ്യ, ഇതി വാക്യം ലോകാ വക്തും ന ശക്ഷ്യന്തി, ഈശ്വരസ്യ രാജത്വം യുഷ്മാകമ് അന്തരേവാസ്തേ|</para>
  <para style="p">
    <verse number="22" style="v"/>തതഃ സ ശിഷ്യാൻ ജഗാദ, യദാ യുഷ്മാഭി ർമനുജസുതസ്യ ദിനമേകം ദ്രഷ്ടുമ് വാഞ്ഛിഷ്യതേ കിന്തു ന ദർശിഷ്യതേ, ഈദൃക്കാല ആയാതി|</para>
  <para style="p">
    <verse number="23" style="v"/>തദാത്ര പശ്യ വാ തത്ര പശ്യേതി വാക്യം ലോകാ വക്ഷ്യന്തി, കിന്തു തേഷാം പശ്ചാത് മാ യാത, മാനുഗച്ഛത ച|</para>
  <para style="p">
    <verse number="24" style="v"/>യതസ്തഡിദ് യഥാകാശൈകദിശ്യുദിയ തദന്യാമപി ദിശം വ്യാപ്യ പ്രകാശതേ തദ്വത് നിജദിനേ മനുജസൂനുഃ പ്രകാശിഷ്യതേ|</para>
  <para style="p">
    <verse number="25" style="v"/>കിന്തു തത്പൂർവ്വം തേനാനേകാനി ദുഃഖാനി ഭോക്തവ്യാന്യേതദ്വർത്തമാനലോകൈശ്ച സോഽവജ്ഞാതവ്യഃ|</para>
  <para style="p">
    <verse number="26" style="v"/>നോഹസ്യ വിദ്യമാനകാലേ യഥാഭവത് മനുഷ്യസൂനോഃ കാലേപി തഥാ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="27" style="v"/>യാവത്കാലം നോഹോ മഹാപോതം നാരോഹദ് ആപ്ലാവിവാര്യ്യേത്യ സർവ്വം നാനാശയച്ച താവത്കാലം യഥാ ലോകാ അഭുഞ്ജതാപിവൻ വ്യവഹൻ വ്യവാഹയംശ്ച;</para>
  <para style="p">
    <verse number="28" style="v"/>ഇത്ഥം ലോടോ വർത്തമാനകാലേപി യഥാ ലോകാ ഭോജനപാനക്രയവിക്രയരോപണഗൃഹനിർമ്മാണകർമ്മസു പ്രാവർത്തന്ത,</para>
  <para style="p">
    <verse number="29" style="v"/>കിന്തു യദാ ലോട് സിദോമോ നിർജഗാമ തദാ നഭസഃ സഗന്ധകാഗ്നിവൃഷ്ടി ർഭൂത്വാ സർവ്വം വ്യനാശയത്</para>
  <para style="p">
    <verse number="30" style="v"/>തദ്വൻ മാനവപുത്രപ്രകാശദിനേപി ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="31" style="v"/>തദാ യദി കശ്ചിദ് ഗൃഹോപരി തിഷ്ഠതി തർഹി സ ഗൃഹമധ്യാത് കിമപി ദ്രവ്യമാനേതുമ് അവരുഹ്യ നൈതു; യശ്ച ക്ഷേത്രേ തിഷ്ഠതി സോപി വ്യാഘുട്യ നായാതു|</para>
  <para style="p">
    <verse number="32" style="v"/>ലോടഃ പത്നീം സ്മരത|</para>
  <para style="p">
    <verse number="33" style="v"/>യഃ പ്രാണാൻ രക്ഷിതും ചേഷ്ടിഷ്യതേ സ പ്രാണാൻ ഹാരയിഷ്യതി യസ്തു പ്രാണാൻ ഹാരയിഷ്യതി സഏവ പ്രാണാൻ രക്ഷിഷ്യതി|</para>
  <para style="p">
    <verse number="34" style="v"/>യുഷ്മാനഹം വച്മി തസ്യാം രാത്രൗ ശയ്യൈകഗതയോ ർലോകയോരേകോ ധാരിഷ്യതേ പരസ്ത്യക്ഷ്യതേ|</para>
  <para style="p">
    <verse number="35" style="v"/>സ്ത്രിയൗ യുഗപത് പേഷണീം വ്യാവർത്തയിഷ്യതസ്തയോരേകാ ധാരിഷ്യതേ പരാത്യക്ഷ്യതേ|</para>
  <para style="p">
    <verse number="36" style="v"/>പുരുഷൗ ക്ഷേത്രേ സ്ഥാസ്യതസ്തയോരേകോ ധാരിഷ്യതേ പരസ്ത്യക്ഷ്യതേ|</para>
  <para style="p">
    <verse number="37" style="v"/>തദാ തേ പപ്രച്ഛുഃ, ഹേ പ്രഭോ കുത്രേത്ഥം ഭവിഷ്യതി? തതഃ സ ഉവാച, യത്ര ശവസ്തിഷ്ഠതി തത്ര ഗൃധ്രാ മിലന്തി|</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അപരഞ്ച ലോകൈരക്ലാന്തൈ ർനിരന്തരം പ്രാർഥയിതവ്യമ് ഇത്യാശയേന യീശുനാ ദൃഷ്ടാന്ത ഏകഃ കഥിതഃ|</para>
  <para style="p">
    <verse number="2" style="v"/>കുത്രചിന്നഗരേ കശ്ചിത് പ്രാഡ്വിവാക ആസീത് സ ഈശ്വരാന്നാബിഭേത് മാനുഷാംശ്ച നാമന്യത|</para>
  <para style="p">
    <verse number="3" style="v"/>അഥ തത്പുരവാസിനീ കാചിദ്വിധവാ തത്സമീപമേത്യ വിവാദിനാ സഹ മമ വിവാദം പരിഷ്കുർവ്വിതി നിവേദയാമാസ|</para>
  <para style="p">
    <verse number="4" style="v"/>തതഃ സ പ്രാഡ്വിവാകഃ കിയദ്ദിനാനി ന തദങ്ഗീകൃതവാൻ പശ്ചാച്ചിത്തേ ചിന്തയാമാസ, യദ്യപീശ്വരാന്ന ബിഭേമി മനുഷ്യാനപി ന മന്യേ</para>
  <para style="p">
    <verse number="5" style="v"/>തഥാപ്യേഷാ വിധവാ മാം ക്ലിശ്നാതി തസ്മാദസ്യാ വിവാദം പരിഷ്കരിഷ്യാമി നോചേത് സാ സദാഗത്യ മാം വ്യഗ്രം കരിഷ്യതി|</para>
  <para style="p">
    <verse number="6" style="v"/>പശ്ചാത് പ്രഭുരവദദ് അസാവന്യായപ്രാഡ്വിവാകോ യദാഹ തത്ര മനോ നിധധ്വം|</para>
  <para style="p">
    <verse number="7" style="v"/>ഈശ്വരസ്യ യേ ഽഭിരുചിതലോകാ ദിവാനിശം പ്രാർഥയന്തേ സ ബഹുദിനാനി വിലമ്ബ്യാപി തേഷാം വിവാദാൻ കിം ന പരിഷ്കരിഷ്യതി?</para>
  <para style="p">
    <verse number="8" style="v"/>യുഷ്മാനഹം വദാമി ത്വരയാ പരിഷ്കരിഷ്യതി, കിന്തു യദാ മനുഷ്യപുത്ര ആഗമിഷ്യതി തദാ പൃഥിവ്യാം കിമീദൃശം വിശ്വാസം പ്രാപ്സ്യതി?</para>
  <para style="p">
    <verse number="9" style="v"/>യേ സ്വാൻ ധാർമ്മികാൻ ജ്ഞാത്വാ പരാൻ തുച്ഛീകുർവ്വന്തി ഏതാദൃഗ്ഭ്യഃ, കിയദ്ഭ്യ ഇമം ദൃഷ്ടാന്തം കഥയാമാസ|</para>
  <para style="p">
    <verse number="10" style="v"/>ഏകഃ ഫിരൂശ്യപരഃ കരസഞ്ചായീ ദ്വാവിമൗ പ്രാർഥയിതും മന്ദിരം ഗതൗ|</para>
  <para style="p">
    <verse number="11" style="v"/>തതോഽസൗ ഫിരൂശ്യേകപാർശ്വേ തിഷ്ഠൻ ഹേ ഈശ്വര അഹമന്യലോകവത് ലോഠയിതാന്യായീ പാരദാരികശ്ച ന ഭവാമി അസ്യ കരസഞ്ചായിനസ്തുല്യശ്ച ന, തസ്മാത്ത്വാം ധന്യം വദാമി|</para>
  <para style="p">
    <verse number="12" style="v"/>സപ്തസു ദിനേഷു ദിനദ്വയമുപവസാമി സർവ്വസമ്പത്തേ ർദശമാംശം ദദാമി ച, ഏതത്കഥാം കഥയൻ പ്രാർഥയാമാസ|</para>
  <para style="p">
    <verse number="13" style="v"/>കിന്തു സ കരസഞ്ചായി ദൂരേ തിഷ്ഠൻ സ്വർഗം ദ്രഷ്ടും നേച്ഛൻ വക്ഷസി കരാഘാതം കുർവ്വൻ ഹേ ഈശ്വര പാപിഷ്ഠം മാം ദയസ്വ, ഇത്ഥം പ്രാർഥയാമാസ|</para>
  <para style="p">
    <verse number="14" style="v"/>യുഷ്മാനഹം വദാമി, തയോർദ്വയോ ർമധ്യേ കേവലഃ കരസഞ്ചായീ പുണ്യവത്ത്വേന ഗണിതോ നിജഗൃഹം ജഗാമ, യതോ യഃ കശ്ചിത് സ്വമുന്നമയതി സ നാമയിഷ്യതേ കിന്തു യഃ കശ്ചിത് സ്വം നമയതി സ ഉന്നമയിഷ്യതേ|</para>
  <para style="p">
    <verse number="15" style="v"/>അഥ ശിശൂനാം ഗാത്രസ്പർശാർഥം ലോകാസ്താൻ തസ്യ സമീപമാനിന്യുഃ ശിഷ്യാസ്തദ് ദൃഷ്ട്വാനേതൃൻ തർജയാമാസുഃ,</para>
  <para style="p">
    <verse number="16" style="v"/>കിന്തു യീശുസ്താനാഹൂയ ജഗാദ, മന്നികടമ് ആഗന്തും ശിശൂൻ അനുജാനീധ്വം താംശ്ച മാ വാരയത; യത ഈശ്വരരാജ്യാധികാരിണ ഏഷാം സദൃശാഃ|</para>
  <para style="p">
    <verse number="17" style="v"/>അഹം യുഷ്മാൻ യഥാർഥം വദാമി, യോ ജനഃ ശിശോഃ സദൃശോ ഭൂത്വാ ഈശ്വരരാജ്യം ന ഗൃഹ്ലാതി സ കേനാപി പ്രകാരേണ തത് പ്രവേഷ്ടും ന ശക്നോതി|</para>
  <para style="p">
    <verse number="18" style="v"/>അപരമ് ഏകോധിപതിസ്തം പപ്രച്ഛ, ഹേ പരമഗുരോ, അനന്തായുഷഃ പ്രാപ്തയേ മയാ കിം കർത്തവ്യം?</para>
  <para style="p">
    <verse number="19" style="v"/>യീശുരുവാച, മാം കുതഃ പരമം വദസി? ഈശ്വരം വിനാ കോപി പരമോ ന ഭവതി|</para>
  <para style="p">
    <verse number="20" style="v"/>പരദാരാൻ മാ ഗച്ഛ, നരം മാ ജഹി, മാ ചോരയ, മിഥ്യാസാക്ഷ്യം മാ ദേഹി, മാതരം പിതരഞ്ച സംമന്യസ്വ, ഏതാ യാ ആജ്ഞാഃ സന്തി താസ്ത്വം ജാനാസി|</para>
  <para style="p">
    <verse number="21" style="v"/>തദാ സ ഉവാച, ബാല്യകാലാത് സർവ്വാ ഏതാ ആചരാമി|</para>
  <para style="p">
    <verse number="22" style="v"/>ഇതി കഥാം ശ്രുത്വാ യീശുസ്തമവദത്, തഥാപി തവൈകം കർമ്മ ന്യൂനമാസ്തേ, നിജം സർവ്വസ്വം വിക്രീയ ദരിദ്രേഭ്യോ വിതര, തസ്മാത് സ്വർഗേ ധനം പ്രാപ്സ്യസി; തത ആഗത്യ മമാനുഗാമീ ഭവ|</para>
  <para style="p">
    <verse number="23" style="v"/>കിന്ത്വേതാം കഥാം ശ്രുത്വാ സോധിപതിഃ ശുശോച, യതസ്തസ്യ ബഹുധനമാസീത്|</para>
  <para style="p">
    <verse number="24" style="v"/>തദാ യീശുസ്തമതിശോകാന്വിതം ദൃഷ്ട്വാ ജഗാദ, ധനവതാമ് ഈശ്വരരാജ്യപ്രവേശഃ കീദൃഗ് ദുഷ്കരഃ|</para>
  <para style="p">
    <verse number="25" style="v"/>ഈശ്വരരാജ്യേ ധനിനഃ പ്രവേശാത് സൂചേശ്ഛിദ്രേണ മഹാങ്ഗസ്യ ഗമനാഗമനേ സുകരേ|</para>
  <para style="p">
    <verse number="26" style="v"/>ശ്രോതാരഃ പപ്രച്ഛുസ്തർഹി കേന പരിത്രാണം പ്രാപ്സ്യതേ?</para>
  <para style="p">
    <verse number="27" style="v"/>സ ഉക്തവാൻ, യൻ മാനുഷേണാശക്യം തദ് ഈശ്വരേണ ശക്യം|</para>
  <para style="p">
    <verse number="28" style="v"/>തദാ പിതര ഉവാച, പശ്യ വയം സർവ്വസ്വം പരിത്യജ്യ തവ പശ്ചാദ്ഗാമിനോഽഭവാമ|</para>
  <para style="p">
    <verse number="29" style="v"/>തതഃ സ ഉവാച, യുഷ്മാനഹം യഥാർഥം വദാമി, ഈശ്വരരാജ്യാർഥം ഗൃഹം പിതരൗ ഭ്രാതൃഗണം ജായാം സന്താനാംശ്ച ത്യക്തവാ</para>
  <para style="p">
    <verse number="30" style="v"/>ഇഹ കാലേ തതോഽധികം പരകാലേ ഽനന്തായുശ്ച ന പ്രാപ്സ്യതി ലോക ഈദൃശഃ കോപി നാസ്തി|</para>
  <para style="p">
    <verse number="31" style="v"/>അനന്തരം സ ദ്വാദശശിഷ്യാനാഹൂയ ബഭാഷേ, പശ്യത വയം യിരൂശാലമ്നഗരം യാമഃ, തസ്മാത് മനുഷ്യപുത്രേ ഭവിഷ്യദ്വാദിഭിരുക്തം യദസ്തി തദനുരൂപം തം പ്രതി ഘടിഷ്യതേ;</para>
  <para style="p">
    <verse number="32" style="v"/>വസ്തുതസ്തു സോഽന്യദേശീയാനാം ഹസ്തേഷു സമർപയിഷ്യതേ, തേ തമുപഹസിഷ്യന്തി, അന്യായമാചരിഷ്യന്തി തദ്വപുഷി നിഷ്ഠീവം നിക്ഷേപ്സ്യന്തി, കശാഭിഃ പ്രഹൃത്യ തം ഹനിഷ്യന്തി ച,</para>
  <para style="p">
    <verse number="33" style="v"/>കിന്തു തൃതീയദിനേ സ ശ്മശാനാദ് ഉത്ഥാസ്യതി|</para>
  <para style="p">
    <verse number="34" style="v"/>ഏതസ്യാഃ കഥായാ അഭിപ്രായം കിഞ്ചിദപി തേ ബോദ്ധും ന ശേകുഃ തേഷാം നികടേഽസ്പഷ്ടതവാത് തസ്യൈതാസാം കഥാനാമ് ആശയം തേ ജ്ഞാതും ന ശേകുശ്ച|</para>
  <para style="p">
    <verse number="35" style="v"/>അഥ തസ്മിൻ യിരീഹോഃ പുരസ്യാന്തികം പ്രാപ്തേ കശ്ചിദന്ധഃ പഥഃ പാർശ്വ ഉപവിശ്യ ഭിക്ഷാമ് അകരോത്</para>
  <para style="p">
    <verse number="36" style="v"/>സ ലോകസമൂഹസ്യ ഗമനശബ്ദം ശ്രുത്വാ തത്കാരണം പൃഷ്ടവാൻ|</para>
  <para style="p">
    <verse number="37" style="v"/>നാസരതീയയീശുര്യാതീതി ലോകൈരുക്തേ സ ഉച്ചൈർവക്തുമാരേഭേ,</para>
  <para style="p">
    <verse number="38" style="v"/>ഹേ ദായൂദഃ സന്താന യീശോ മാം ദയസ്വ|</para>
  <para style="p">
    <verse number="39" style="v"/>തതോഗ്രഗാമിനസ്തം മൗനീ തിഷ്ഠേതി തർജയാമാസുഃ കിന്തു സ പുനാരുവൻ ഉവാച, ഹേ ദായൂദഃ സന്താന മാം ദയസ്വ|</para>
  <para style="p">
    <verse number="40" style="v"/>തദാ യീശുഃ സ്ഥഗിതോ ഭൂത്വാ സ്വാന്തികേ തമാനേതുമ് ആദിദേശ|</para>
  <para style="p">
    <verse number="41" style="v"/>തതഃ സ തസ്യാന്തികമ് ആഗമത്, തദാ സ തം പപ്രച്ഛ, ത്വം കിമിച്ഛസി? ത്വദർഥമഹം കിം കരിഷ്യാമി? സ ഉക്തവാൻ, ഹേ പ്രഭോഽഹം ദ്രഷ്ടും ലഭൈ|</para>
  <para style="p">
    <verse number="42" style="v"/>തദാ യീശുരുവാച, ദൃഷ്ടിശക്തിം ഗൃഹാണ തവ പ്രത്യയസ്ത്വാം സ്വസ്ഥം കൃതവാൻ|</para>
  <para style="p">
    <verse number="43" style="v"/>തതസ്തത്ക്ഷണാത് തസ്യ ചക്ഷുഷീ പ്രസന്നേ; തസ്മാത് സ ഈശ്വരം ധന്യം വദൻ തത്പശ്ചാദ് യയൗ, തദാലോക്യ സർവ്വേ ലോകാ ഈശ്വരം പ്രശംസിതുമ് ആരേഭിരേ|</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>യദാ യീശു ര്യിരീഹോപുരം പ്രവിശ്യ തന്മധ്യേന ഗച്ഛംസ്തദാ</para>
  <para style="p">
    <verse number="2" style="v"/>സക്കേയനാമാ കരസഞ്ചായിനാം പ്രധാനോ ധനവാനേകോ</para>
  <para style="p">
    <verse number="3" style="v"/>യീശുഃ കീദൃഗിതി ദ്രഷ്ടും ചേഷ്ടിതവാൻ കിന്തു ഖർവ്വത്വാല്ലോകസംഘമധ്യേ തദ്ദർശനമപ്രാപ്യ</para>
  <para style="p">
    <verse number="4" style="v"/>യേന പഥാ സ യാസ്യതി തത്പഥേഽഗ്രേ ധാവിത്വാ തം ദ്രഷ്ടുമ് ഉഡുമ്ബരതരുമാരുരോഹ|</para>
  <para style="p">
    <verse number="5" style="v"/>പശ്ചാദ് യീശുസ്തത്സ്ഥാനമ് ഇത്വാ ഊർദ്ധ്വം വിലോക്യ തം ദൃഷ്ട്വാവാദീത്, ഹേ സക്കേയ ത്വം ശീഘ്രമവരോഹ മയാദ്യ ത്വദ്ഗേഹേ വസ്തവ്യം|</para>
  <para style="p">
    <verse number="6" style="v"/>തതഃ സ ശീഘ്രമവരുഹ്യ സാഹ്ലാദം തം ജഗ്രാഹ|</para>
  <para style="p">
    <verse number="7" style="v"/>തദ് ദൃഷ്ട്വാ സർവ്വേ വിവദമാനാ വക്തുമാരേഭിരേ, സോതിഥിത്വേന ദുഷ്ടലോകഗൃഹം ഗച്ഛതി|</para>
  <para style="p">
    <verse number="8" style="v"/>കിന്തു സക്കേയോ ദണ്ഡായമാനോ വക്തുമാരേഭേ, ഹേ പ്രഭോ പശ്യ മമ യാ സമ്പത്തിരസ്തി തദർദ്ധം ദരിദ്രേഭ്യോ ദദേ, അപരമ് അന്യായം കൃത്വാ കസ്മാദപി യദി കദാപി കിഞ്ചിത് മയാ ഗൃഹീതം തർഹി തച്ചതുർഗുണം ദദാമി|</para>
  <para style="p">
    <verse number="9" style="v"/>തദാ യീശുസ്തമുക്തവാൻ അയമപി ഇബ്രാഹീമഃ സന്താനോഽതഃ കാരണാദ് അദ്യാസ്യ ഗൃഹേ ത്രാണമുപസ്ഥിതം|</para>
  <para style="p">
    <verse number="10" style="v"/>യദ് ഹാരിതം തത് മൃഗയിതും രക്ഷിതുഞ്ച മനുഷ്യപുത്ര ആഗതവാൻ|</para>
  <para style="p">
    <verse number="11" style="v"/>അഥ സ യിരൂശാലമഃ സമീപ ഉപാതിഷ്ഠദ് ഈശ്വരരാജത്വസ്യാനുഷ്ഠാനം തദൈവ ഭവിഷ്യതീതി ലോകൈരന്വഭൂയത, തസ്മാത് സ ശ്രോതൃഭ്യഃ പുനർദൃഷ്ടാന്തകഥാമ് ഉത്ഥാപ്യ കഥയാമാസ|</para>
  <para style="p">
    <verse number="12" style="v"/>കോപി മഹാല്ലോകോ നിജാർഥം രാജത്വപദം ഗൃഹീത്വാ പുനരാഗന്തും ദൂരദേശം ജഗാമ|</para>
  <para style="p">
    <verse number="13" style="v"/>യാത്രാകാലേ നിജാൻ ദശദാസാൻ ആഹൂയ ദശസ്വർണമുദ്രാ ദത്ത്വാ മമാഗമനപര്യ്യന്തം വാണിജ്യം കുരുതേത്യാദിദേശ|</para>
  <para style="p">
    <verse number="14" style="v"/>കിന്തു തസ്യ പ്രജാസ്തമവജ്ഞായ മനുഷ്യമേനമ് അസ്മാകമുപരി രാജത്വം ന കാരയിവ്യാമ ഇമാം വാർത്താം തന്നികടേ പ്രേരയാമാസുഃ|</para>
  <para style="p">
    <verse number="15" style="v"/>അഥ സ രാജത്വപദം പ്രാപ്യാഗതവാൻ ഏകൈകോ ജനോ ബാണിജ്യേന കിം ലബ്ധവാൻ ഇതി ജ്ഞാതും യേഷു ദാസേഷു മുദ്രാ അർപയത് താൻ ആഹൂയാനേതുമ് ആദിദേശ|</para>
  <para style="p">
    <verse number="16" style="v"/>തദാ പ്രഥമ ആഗത്യ കഥിതവാൻ, ഹേ പ്രഭോ തവ തയൈകയാ മുദ്രയാ ദശമുദ്രാ ലബ്ധാഃ|</para>
  <para style="p">
    <verse number="17" style="v"/>തതഃ സ ഉവാച ത്വമുത്തമോ ദാസഃ സ്വൽപേന വിശ്വാസ്യോ ജാത ഇതഃ കാരണാത് ത്വം ദശനഗരാണാമ് അധിപോ ഭവ|</para>
  <para style="p">
    <verse number="18" style="v"/>ദ്വിതീയ ആഗത്യ കഥിതവാൻ, ഹേ പ്രഭോ തവൈകയാ മുദ്രയാ പഞ്ചമുദ്രാ ലബ്ധാഃ|</para>
  <para style="p">
    <verse number="19" style="v"/>തതഃ സ ഉവാച, ത്വം പഞ്ചാനാം നഗരാണാമധിപതി ർഭവ|</para>
  <para style="p">
    <verse number="20" style="v"/>തതോന്യ ആഗത്യ കഥയാമാസ, ഹേ പ്രഭോ പശ്യ തവ യാ മുദ്രാ അഹം വസ്ത്രേ ബദ്ധ്വാസ്ഥാപയം സേയം|</para>
  <para style="p">
    <verse number="21" style="v"/>ത്വം കൃപണോ യന്നാസ്ഥാപയസ്തദപി ഗൃഹ്ലാസി, യന്നാവപസ്തദേവ ച ഛിനത്സി തതോഹം ത്വത്തോ ഭീതഃ|</para>
  <para style="p">
    <verse number="22" style="v"/>തദാ സ ജഗാദ, രേ ദുഷ്ടദാസ തവ വാക്യേന ത്വാം ദോഷിണം കരിഷ്യാമി, യദഹം നാസ്ഥാപയം തദേവ ഗൃഹ്ലാമി, യദഹം നാവപഞ്ച തദേവ ഛിനദ്മി, ഏതാദൃശഃ കൃപണോഹമിതി യദി ത്വം ജാനാസി,</para>
  <para style="p">
    <verse number="23" style="v"/>തർഹി മമ മുദ്രാ ബണിജാം നികടേ കുതോ നാസ്ഥാപയഃ? തയാ കൃതേഽഹമ് ആഗത്യ കുസീദേന സാർദ്ധം നിജമുദ്രാ അപ്രാപ്സ്യമ്|</para>
  <para style="p">
    <verse number="24" style="v"/>പശ്ചാത് സ സമീപസ്ഥാൻ ജനാൻ ആജ്ഞാപയത് അസ്മാത് മുദ്രാ ആനീയ യസ്യ ദശമുദ്രാഃ സന്തി തസ്മൈ ദത്ത|</para>
  <para style="p">
    <verse number="25" style="v"/>തേ പ്രോചുഃ പ്രഭോഽസ്യ ദശമുദ്രാഃ സന്തി|</para>
  <para style="p">
    <verse number="26" style="v"/>യുഷ്മാനഹം വദാമി യസ്യാശ്രയേ വദ്ധതേ ഽധികം തസ്മൈ ദായിഷ്യതേ, കിന്തു യസ്യാശ്രയേ ന വർദ്ധതേ തസ്യ യദ്യദസ്തി തദപി തസ്മാൻ നായിഷ്യതേ|</para>
  <para style="p">
    <verse number="27" style="v"/>കിന്തു മമാധിപതിത്വസ്യ വശത്വേ സ്ഥാതുമ് അസമ്മന്യമാനാ യേ മമ രിപവസ്താനാനീയ മമ സമക്ഷം സംഹരത|</para>
  <para style="p">
    <verse number="28" style="v"/>ഇത്യുപദേശകഥാം കഥയിത്വാ സോഗ്രഗഃ സൻ യിരൂശാലമപുരം യയൗ|</para>
  <para style="p">
    <verse number="29" style="v"/>തതോ ബൈത്ഫഗീബൈഥനീയാഗ്രാമയോഃ സമീപേ ജൈതുനാദ്രേരന്തികമ് ഇത്വാ ശിഷ്യദ്വയമ് ഇത്യുക്ത്വാ പ്രേഷയാമാസ,</para>
  <para style="p">
    <verse number="30" style="v"/>യുവാമമും സമ്മുഖസ്ഥഗ്രാമം പ്രവിശ്യൈവ യം കോപി മാനുഷഃ കദാപി നാരോഹത് തം ഗർദ്ദഭശാവകം ബദ്ധം ദ്രക്ഷ്യഥസ്തം മോചയിത്വാനയതം|</para>
  <para style="p">
    <verse number="31" style="v"/>തത്ര കുതോ മോചയഥഃ? ഇതി ചേത് കോപി വക്ഷ്യതി തർഹി വക്ഷ്യഥഃ പ്രഭേाരത്ര പ്രയോജനമ് ആസ്തേ|</para>
  <para style="p">
    <verse number="32" style="v"/>തദാ തൗ പ്രരിതൗ ഗത്വാ തത്കഥാाനുസാരേണ സർവ്വം പ്രാപ്തൗ|</para>
  <para style="p">
    <verse number="33" style="v"/>ഗർദഭശാവകമോചനകാലേ തത്വാമിന ഊചുഃ, ഗർദഭശാവകം കുതോ മോചയഥഃ?</para>
  <para style="p">
    <verse number="34" style="v"/>താവൂചതുഃ പ്രഭോരത്ര പ്രയോജനമ് ആസ്തേ|</para>
  <para style="p">
    <verse number="35" style="v"/>പശ്ചാത് തൗ തം ഗർദഭശാവകം യീശോരന്തികമാനീയ തത്പൃഷ്ഠേ നിജവസനാനി പാതയിത്വാ തദുപരി യീശുമാരോഹയാമാസതുഃ|</para>
  <para style="p">
    <verse number="36" style="v"/>അഥ യാത്രാകാലേ ലോകാഃ പഥി സ്വവസ്ത്രാണി പാതയിതുമ് ആരേഭിരേ|</para>
  <para style="p">
    <verse number="37" style="v"/>അപരം ജൈതുനാദ്രേരുപത്യകാമ് ഇത്വാ ശിഷ്യസംഘഃ പൂർവ്വദൃഷ്ടാനി മഹാകർമ്മാണി സ്മൃത്വാ,</para>
  <para style="p">
    <verse number="38" style="v"/>യോ രാജാ പ്രഭോ ർനാമ്നായാതി സ ധന്യഃ സ്വർഗേ കുശലം സർവ്വോച്ചേ ജയധ്വനി ർഭവതു, കഥാമേതാം കഥയിത്വാ സാനന്ദമ് ഉചൈരീശ്വരം ധന്യം വക്തുമാരേഭേ|</para>
  <para style="p">
    <verse number="39" style="v"/>തദാ ലോകാരണ്യമധ്യസ്ഥാഃ കിയന്തഃ ഫിരൂശിനസ്തത് ശ്രുത്വാ യീശും പ്രോചുഃ, ഹേ ഉപദേശക സ്വശിഷ്യാൻ തർജയ|</para>
  <para style="p">
    <verse number="40" style="v"/>സ ഉവാച, യുഷ്മാനഹം വദാമി യദ്യമീ നീരവാസ്തിഷ്ഠന്തി തർഹി പാഷാണാ ഉചൈഃ കഥാഃ കഥയിഷ്യന്തി|</para>
  <para style="p">
    <verse number="41" style="v"/>പശ്ചാത് തത്പുരാന്തികമേത്യ തദവലോക്യ സാശ്രുപാതം ജഗാദ,</para>
  <para style="p">
    <verse number="42" style="v"/>ഹാ ഹാ ചേത് ത്വമഗ്രേഽജ്ഞാസ്യഥാഃ, തവാസ്മിന്നേവ ദിനേ വാ യദി സ്വമങ്ഗലമ് ഉപാലപ്സ്യഥാഃ, തർഹ്യുത്തമമ് അഭവിഷ്യത്, കിന്തു ക്ഷണേസ്മിൻ തത്തവ ദൃഷ്ടേരഗോചരമ് ഭവതി|</para>
  <para style="p">
    <verse number="43" style="v"/>ത്വം സ്വത്രാണകാലേ ന മനോ ന്യധത്ഥാ ഇതി ഹേതോ ര്യത്കാലേ തവ രിപവസ്ത്വാം ചതുർദിക്ഷു പ്രാചീരേണ വേഷ്ടയിത്വാ രോത്സ്യന്തി</para>
  <para style="p">
    <verse number="44" style="v"/>ബാലകൈഃ സാർദ്ധം ഭൂമിസാത് കരിഷ്യന്തി ച ത്വന്മധ്യേ പാഷാണൈകോപി പാഷാണോപരി ന സ്ഥാസ്യതി ച, കാല ഈദൃശ ഉപസ്ഥാസ്യതി|</para>
  <para style="p">
    <verse number="45" style="v"/>അഥ മധ്യേമന്ദിരം പ്രവിശ്യ തത്രത്യാൻ ക്രയിവിക്രയിണോ ബഹിഷ്കുർവ്വൻ</para>
  <para style="p">
    <verse number="46" style="v"/>അവദത് മദ്ഗൃഹം പ്രാർഥനാഗൃഹമിതി ലിപിരാസ്തേ കിന്തു യൂയം തദേവ ചൈരാണാം ഗഹ്വരം കുരുഥ|</para>
  <para style="p">
    <verse number="47" style="v"/>പശ്ചാത് സ പ്രത്യഹം മധ്യേമന്ദിരമ് ഉപദിദേശ; തതഃ പ്രധാനയാജകാ അധ്യാപകാഃ പ്രാചീനാശ്ച തം നാശയിതും ചിചേഷ്ടിരേ;</para>
  <para style="p">
    <verse number="48" style="v"/>കിന്തു തദുപദേശേ സർവ്വേ ലോകാ നിവിഷ്ടചിത്താഃ സ്ഥിതാസ്തസ്മാത് തേ തത്കർത്തും നാവകാശം പ്രാപുഃ|</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അഥൈകദാ യീശു ർമനിദരേ സുസംവാദം പ്രചാരയൻ ലോകാനുപദിശതി, ഏതർഹി പ്രധാനയാജകാ അധ്യാപകാഃ പ്രാഞ്ചശ്ച തന്നികടമാഗത്യ പപ്രച്ഛുഃ</para>
  <para style="p">
    <verse number="2" style="v"/>കയാജ്ഞയാ ത്വം കർമ്മാണ്യേതാനി കരോഷി? കോ വാ ത്വാമാജ്ഞാപയത്? തദസ്മാൻ വദ|</para>
  <para style="p">
    <verse number="3" style="v"/>സ പ്രത്യുവാച, തർഹി യുഷ്മാനപി കഥാമേകാം പൃച്ഛാമി തസ്യോത്തരം വദത|</para>
  <para style="p">
    <verse number="4" style="v"/>യോഹനോ മജ്ജനമ് ഈശ്വരസ്യ മാനുഷാണാം വാജ്ഞാതോ ജാതം?</para>
  <para style="p">
    <verse number="5" style="v"/>തതസ്തേ മിഥോ വിവിച്യ ജഗദുഃ, യദീശ്വരസ്യ വദാമസ്തർഹി തം കുതോ ന പ്രത്യൈത സ ഇതി വക്ഷ്യതി|</para>
  <para style="p">
    <verse number="6" style="v"/>യദി മനുഷ്യസ്യേതി വദാമസ്തർഹി സർവ്വേ ലോകാ അസ്മാൻ പാഷാണൈ ർഹനിഷ്യന്തി യതോ യോഹൻ ഭവിഷ്യദ്വാദീതി സർവ്വേ ദൃഢം ജാനന്തി|</para>
  <para style="p">
    <verse number="7" style="v"/>അതഏവ തേ പ്രത്യൂചുഃ കസ്യാജ്ഞയാ ജാതമ് ഇതി വക്തും ന ശക്നുമഃ|</para>
  <para style="p">
    <verse number="8" style="v"/>തദാ യീശുരവദത് തർഹി കയാജ്ഞയാ കർമ്മാണ്യേതാതി കരോമീതി ച യുഷ്മാൻ ന വക്ഷ്യാമി|</para>
  <para style="p">
    <verse number="9" style="v"/>അഥ ലോകാനാം സാക്ഷാത് സ ഇമാം ദൃഷ്ടാന്തകഥാം വക്തുമാരേഭേ, കശ്ചിദ് ദ്രാക്ഷാക്ഷേത്രം കൃത്വാ തത് ക്ഷേത്രം കൃഷീവലാനാം ഹസ്തേഷു സമർപ്യ ബഹുകാലാർഥം ദൂരദേശം ജഗാമ|</para>
  <para style="p">
    <verse number="10" style="v"/>അഥ ഫലകാലേ ഫലാനി ഗ്രഹീതു കൃഷീവലാനാം സമീപേ ദാസം പ്രാഹിണോത് കിന്തു കൃഷീവലാസ്തം പ്രഹൃത്യ രിക്തഹസ്തം വിസസർജുഃ|</para>
  <para style="p">
    <verse number="11" style="v"/>തതഃ സോധിപതിഃ പുനരന്യം ദാസം പ്രേഷയാമാസ, തേ തമപി പ്രഹൃത്യ കുവ്യവഹൃത്യ രിക്തഹസ്തം വിസസൃജുഃ|</para>
  <para style="p">
    <verse number="12" style="v"/>തതഃ സ തൃതീയവാരമ് അന്യം പ്രാഹിണോത് തേ തമപി ക്ഷതാങ്ഗം കൃത്വാ ബഹി ർനിചിക്ഷിപുഃ|</para>
  <para style="p">
    <verse number="13" style="v"/>തദാ ക്ഷേത്രപതി ർവിചാരയാമാസ, മമേദാനീം കിം കർത്തവ്യം? മമ പ്രിയേ പുത്രേ പ്രഹിതേ തേ തമവശ്യം ദൃഷ്ട്വാ സമാദരിഷ്യന്തേ|</para>
  <para style="p">
    <verse number="14" style="v"/>കിന്തു കൃഷീവലാസ്തം നിരീക്ഷ്യ പരസ്പരം വിവിച്യ പ്രോചുഃ, അയമുത്തരാധികാരീ ആഗച്ഛതൈനം ഹന്മസ്തതോധികാരോസ്മാകം ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="15" style="v"/>തതസ്തേ തം ക്ഷേത്രാദ് ബഹി ർനിപാത്യ ജഘ്നുസ്തസ്മാത് സ ക്ഷേത്രപതിസ്താൻ പ്രതി കിം കരിഷ്യതി?</para>
  <para style="p">
    <verse number="16" style="v"/>സ ആഗത്യ താൻ കൃഷീവലാൻ ഹത്വാ പരേഷാം ഹസ്തേഷു തത്ക്ഷേത്രം സമർപയിഷ്യതി; ഇതി കഥാം ശ്രുത്വാ തേ ഽവദൻ ഏതാദൃശീ ഘടനാ ന ഭവതു|</para>
  <para style="p">
    <verse number="17" style="v"/>കിന്തു യീശുസ്താനവലോക്യ ജഗാദ, തർഹി, സ്ഥപതയഃ കരിഷ്യന്തി ഗ്രാവാണം യന്തു തുച്ഛകം| പ്രധാനപ്രസ്തരഃ കോണേ സ ഏവ ഹി ഭവിഷ്യതി| ഏതസ്യ ശാസ്ത്രീയവചനസ്യ കിം താത്പര്യ്യം?</para>
  <para style="p">
    <verse number="18" style="v"/>അപരം തത്പാഷാണോപരി യഃ പതിഷ്യതി സ ഭംക്ഷ്യതേ കിന്തു യസ്യോപരി സ പാഷാണഃ പതിഷ്യതി സ തേന ധൂലിവച് ചൂർണീഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="19" style="v"/>സോസ്മാകം വിരുദ്ധം ദൃഷ്ടാന്തമിമം കഥിതവാൻ ഇതി ജ്ഞാത്വാ പ്രധാനയാജകാ അധ്യാപകാശ്ച തദൈവ തം ധർതും വവാഞ്ഛുഃ കിന്തു ലോകേഭ്യോ ബിഭ്യുഃ|</para>
  <para style="p">
    <verse number="20" style="v"/>അതഏവ തം പ്രതി സതർകാഃ സന്തഃ കഥം തദ്വാക്യദോഷം ധൃത്വാ തം ദേശാധിപസ്യ സാധുവേശധാരിണശ്ചരാൻ തസ്യ സമീപേ പ്രേഷയാമാസുഃ|</para>
  <para style="p">
    <verse number="21" style="v"/>തദാ തേ തം പപ്രച്ഛുഃ, ഹേ ഉപദേശക ഭവാൻ യഥാർഥം കഥയൻ ഉപദിശതി, കമപ്യനപേക്ഷ്യ സത്യത്വേനൈശ്വരം മാർഗമുപദിശതി, വയമേതജ്ജാനീമഃ|</para>
  <para style="p">
    <verse number="22" style="v"/>കൈസരരാജായ കരോസ്മാഭി ർദേയോ ന വാ?</para>
  <para style="p">
    <verse number="23" style="v"/>സ തേഷാം വഞ്ചനം ജ്ഞാത്വാവദത് കുതോ മാം പരീക്ഷധ്വേ? മാം മുദ്രാമേകം ദർശയത|</para>
  <para style="p">
    <verse number="24" style="v"/>ഇഹ ലിഖിതാ മൂർതിരിയം നാമ ച കസ്യ? തേഽവദൻ കൈസരസ്യ|</para>
  <para style="p">
    <verse number="25" style="v"/>തദാ സ ഉവാച, തർഹി കൈസരസ്യ ദ്രവ്യം കൈസരായ ദത്ത; ഈശ്വരസ്യ തു ദ്രവ്യമീശ്വരായ ദത്ത|</para>
  <para style="p">
    <verse number="26" style="v"/>തസ്മാല്ലോകാനാം സാക്ഷാത് തത്കഥായാഃ കമപി ദോഷം ധർതുമപ്രാപ്യ തേ തസ്യോത്തരാദ് ആശ്ചര്യ്യം മന്യമാനാ മൗനിനസ്തസ്ഥുഃ|</para>
  <para style="p">
    <verse number="27" style="v"/>അപരഞ്ച ശ്മശാനാദുത്ഥാനാനങ്ഗീകാരിണാം സിദൂകിനാം കിയന്തോ ജനാ ആഗത്യ തം പപ്രച്ഛുഃ,</para>
  <para style="p">
    <verse number="28" style="v"/>ഹേ ഉപദേശക ശാസ്ത്രേ മൂസാ അസ്മാൻ പ്രതീതി ലിലേഖ യസ്യ ഭ്രാതാ ഭാര്യ്യായാം സത്യാം നിഃസന്താനോ മ്രിയതേ സ തജ്ജായാം വിവഹ്യ തദ്വംശമ് ഉത്പാദയിഷ്യതി|</para>
  <para style="p">
    <verse number="29" style="v"/>തഥാച കേചിത് സപ്ത ഭ്രാതര ആസൻ തേഷാം ജ്യേഷ്ഠോ ഭ്രാതാ വിവഹ്യ നിരപത്യഃ പ്രാണാൻ ജഹൗ|</para>
  <para style="p">
    <verse number="30" style="v"/>അഥ ദ്വിതീയസ്തസ്യ ജായാം വിവഹ്യ നിരപത്യഃ സൻ മമാര| തൃതീയശ്ച താമേവ വ്യുവാഹ;</para>
  <para style="p">
    <verse number="31" style="v"/>ഇത്ഥം സപ്ത ഭ്രാതരസ്താമേവ വിവഹ്യ നിരപത്യാഃ സന്തോ മമ്രുഃ|</para>
  <para style="p">
    <verse number="32" style="v"/>ശേഷേ സാ സ്ത്രീ ച മമാര|</para>
  <para style="p">
    <verse number="33" style="v"/>അതഏവ ശ്മശാനാദുത്ഥാനകാലേ തേഷാം സപ്തജനാനാം കസ്യ സാ ഭാര്യ്യാ ഭവിഷ്യതി? യതഃ സാ തേഷാം സപ്താനാമേവ ഭാര്യ്യാസീത്|</para>
  <para style="p">
    <verse number="34" style="v"/>തദാ യീശുഃ പ്രത്യുവാച, ഏതസ്യ ജഗതോ ലോകാ വിവഹന്തി വാഗ്ദത്താശ്ച ഭവന്തി</para>
  <para style="p">
    <verse number="35" style="v"/>കിന്തു യേ തജ്ജഗത്പ്രാപ്തിയോഗ്യത്വേന ഗണിതാം ഭവിഷ്യന്തി ശ്മശാനാച്ചോത്ഥാസ്യന്തി തേ ന വിവഹന്തി വാഗ്ദത്താശ്ച ന ഭവന്തി,</para>
  <para style="p">
    <verse number="36" style="v"/>തേ പുന ർന മ്രിയന്തേ കിന്തു ശ്മശാനാദുത്ഥാപിതാഃ സന്ത ഈശ്വരസ്യ സന്താനാഃ സ്വർഗീയദൂതാനാം സദൃശാശ്ച ഭവന്തി|</para>
  <para style="p">
    <verse number="37" style="v"/>അധികന്തു മൂസാഃ സ്തമ്ബോപാഖ്യാനേ പരമേശ്വര ഈബ്രാഹീമ ഈശ്വര ഇസ്ഹാക ഈശ്വരോ യാകൂബശ്ചേശ്വര ഇത്യുക്ത്വാ മൃതാനാം ശ്മശാനാദ് ഉത്ഥാനസ്യ പ്രമാണം ലിലേഖ|</para>
  <para style="p">
    <verse number="38" style="v"/>അതഏവ യ ഈശ്വരഃ സ മൃതാനാം പ്രഭു ർന കിന്തു ജീവതാമേവ പ്രഭുഃ, തന്നികടേ സർവ്വേ ജീവന്തഃ സന്തി|</para>
  <para style="p">
    <verse number="39" style="v"/>ഇതി ശ്രുത്വാ കിയന്തോധ്യാപകാ ഊചുഃ, ഹേ ഉപദേശക ഭവാൻ ഭദ്രം പ്രത്യുക്തവാൻ|</para>
  <para style="p">
    <verse number="40" style="v"/>ഇതഃ പരം തം കിമപി പ്രഷ്ടം തേഷാം പ്രഗൽഭതാ നാഭൂത്|</para>
  <para style="p">
    <verse number="41" style="v"/>പശ്ചാത് സ താൻ ഉവാച, യഃ ഖ്രീഷ്ടഃ സ ദായൂദഃ സന്താന ഏതാം കഥാം ലോകാഃ കഥം കഥയന്തി?</para>
  <para style="p">
    <verse number="42" style="v"/>യതഃ മമ പ്രഭുമിദം വാക്യമവദത് പരമേശ്വരഃ| തവ ശത്രൂനഹം യാവത് പാദപീഠം കരോമി ന| താവത് കാലം മദീയേ ത്വം ദക്ഷപാർശ്വ ഉപാവിശ|</para>
  <para style="p">
    <verse number="43" style="v"/>ഇതി കഥാം ദായൂദ് സ്വയം ഗീതഗ്രന്ഥേഽവദത്|</para>
  <para style="p">
    <verse number="44" style="v"/>അതഏവ യദി ദായൂദ് തം പ്രഭും വദതി, തർഹി സ കഥം തസ്യ സന്താനോ ഭവതി?</para>
  <para style="p">
    <verse number="45" style="v"/>പശ്ചാദ് യീശുഃ സർവ്വജനാനാം കർണഗോചരേ ശിഷ്യാനുവാച,</para>
  <para style="p">
    <verse number="46" style="v"/>യേഽധ്യാപകാ ദീർഘപരിച്ഛദം പരിധായ ഭ്രമന്തി, ഹട്ടാപണയോ ർനമസ്കാരേ ഭജനഗേഹസ്യ പ്രോച്ചാസനേ ഭോജനഗൃഹസ്യ പ്രധാനസ്ഥാനേ ച പ്രീയന്തേ</para>
  <para style="p">
    <verse number="47" style="v"/>വിധവാനാം സർവ്വസ്വം ഗ്രസിത്വാ ഛലേന ദീർഘകാലം പ്രാർഥയന്തേ ച തേഷു സാവധാനാ ഭവത, തേഷാമുഗ്രദണ്ഡോ ഭവിഷ്യതി|</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അഥ ധനിലോകാ ഭാണ്ഡാഗാരേ ധനം നിക്ഷിപന്തി സ തദേവ പശ്യതി,</para>
  <para style="p">
    <verse number="2" style="v"/>ഏതർഹി കാചിദ്ദീനാ വിധവാ പണദ്വയം നിക്ഷിപതി തദ് ദദർശ|</para>
  <para style="p">
    <verse number="3" style="v"/>തതോ യീശുരുവാച യുഷ്മാനഹം യഥാർഥം വദാമി, ദരിദ്രേയം വിധവാ സർവ്വേഭ്യോധികം ന്യക്ഷേപ്സീത്,</para>
  <para style="p">
    <verse number="4" style="v"/>യതോന്യേ സ്വപ്രാജ്യധനേഭ്യ ഈശ്വരായ കിഞ്ചിത് ന്യക്ഷേപ്സുഃ, കിന്തു ദരിദ്രേയം വിധവാ ദിനയാപനാർഥം സ്വസ്യ യത് കിഞ്ചിത് സ്ഥിതം തത് സർവ്വം ന്യക്ഷേപ്സീത്|</para>
  <para style="p">
    <verse number="5" style="v"/>അപരഞ്ച ഉത്തമപ്രസ്തരൈരുത്സൃഷ്ടവ്യൈശ്ച മന്ദിരം സുശോഭതേതരാം കൈശ്ചിദിത്യുക്തേ സ പ്രത്യുവാച</para>
  <para style="p">
    <verse number="6" style="v"/>യൂയം യദിദം നിചയനം പശ്യഥ, അസ്യ പാഷാണൈകോപ്യന്യപാഷാണോപരി ന സ്ഥാസ്യതി, സർവ്വേ ഭൂസാദ്ഭവിഷ്യന്തി കാലോയമായാതി|</para>
  <para style="p">
    <verse number="7" style="v"/>തദാ തേ പപ്രച്ഛുഃ, ഹേ ഗുരോ ഘടനേദൃശീ കദാ ഭവിഷ്യതി? ഘടനായാ ഏതസ്യസശ്ചിഹ്നം വാ കിം ഭവിഷ്യതി?</para>
  <para style="p">
    <verse number="8" style="v"/>തദാ സ ജഗാദ, സാവധാനാ ഭവത യഥാ യുഷ്മാകം ഭ്രമം കോപി ന ജനയതി, ഖീഷ്ടോഹമിത്യുക്ത്വാ മമ നാമ്രാ ബഹവ ഉപസ്ഥാസ്യന്തി സ കാലഃ പ്രായേണോപസ്ഥിതഃ, തേഷാം പശ്ചാന്മാ ഗച്ഛത|</para>
  <para style="p">
    <verse number="9" style="v"/>യുദ്ധസ്യോപപ്ലവസ്യ ച വാർത്താം ശ്രുത്വാ മാ ശങ്കധ്വം, യതഃ പ്രഥമമ് ഏതാ ഘടനാ അവശ്യം ഭവിഷ്യന്തി കിന്തു നാപാതേ യുഗാന്തോ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="10" style="v"/>അപരഞ്ച കഥയാമാസ, തദാ ദേശസ്യ വിപക്ഷത്വേന ദേശോ രാജ്യസ്യ വിപക്ഷത്വേന രാജ്യമ് ഉത്ഥാസ്യതി,</para>
  <para style="p">
    <verse number="11" style="v"/>നാനാസ്ഥാനേഷു മഹാഭൂകമ്പോ ദുർഭിക്ഷം മാരീ ച ഭവിഷ്യന്തി, തഥാ വ്യോമമണ്ഡലസ്യ ഭയങ്കരദർശനാന്യശ്ചര്യ്യലക്ഷണാനി ച പ്രകാശയിഷ്യന്തേ|</para>
  <para style="p">
    <verse number="12" style="v"/>കിന്തു സർവ്വാസാമേതാസാം ഘടനാനാം പൂർവ്വം ലോകാ യുഷ്മാൻ ധൃത്വാ താഡയിഷ്യന്തി, ഭജനാലയേ കാരായാഞ്ച സമർപയിഷ്യന്തി മമ നാമകാരണാദ് യുഷ്മാൻ ഭൂപാനാം ശാസകാനാഞ്ച സമ്മുഖം നേഷ്യന്തി ച|</para>
  <para style="p">
    <verse number="13" style="v"/>സാക്ഷ്യാർഥമ് ഏതാനി യുഷ്മാൻ പ്രതി ഘടിഷ്യന്തേ|</para>
  <para style="p">
    <verse number="14" style="v"/>തദാ കിമുത്തരം വക്തവ്യമ് ഏതത് ന ചിന്തയിഷ്യാമ ഇതി മനഃസു നിശ്ചിതനുത|</para>
  <para style="p">
    <verse number="15" style="v"/>വിപക്ഷാ യസ്മാത് കിമപ്യുത്തരമ് ആപത്തിഞ്ച കർത്തും ന ശക്ഷ്യന്തി താദൃശം വാക്പടുത്വം ജ്ഞാനഞ്ച യുഷ്മഭ്യം ദാസ്യാമി|</para>
  <para style="p">
    <verse number="16" style="v"/>കിഞ്ച യൂയം പിത്രാ മാത്രാ ഭ്രാത്രാ ബന്ധുനാ ജ്ഞാത്യാ കുടുമ്ബേന ച പരകരേഷു സമർപയിഷ്യധ്വേ; തതസ്തേ യുഷ്മാകം കഞ്ചന കഞ്ചന ഘാതയിഷ്യന്തി|</para>
  <para style="p">
    <verse number="17" style="v"/>മമ നാമ്നഃ കാരണാത് സർവ്വൈ ർമനുഷ്യൈ ര്യൂയമ് ഋതീയിഷ്യധ്വേ|</para>
  <para style="p">
    <verse number="18" style="v"/>കിന്തു യുഷ്മാകം ശിരഃകേശൈകോപി ന വിനംക്ഷ്യതി,</para>
  <para style="p">
    <verse number="19" style="v"/>തസ്മാദേവ ധൈര്യ്യമവലമ്ബ്യ സ്വസ്വപ്രാണാൻ രക്ഷത|</para>
  <para style="p">
    <verse number="20" style="v"/>അപരഞ്ച യിരൂശാലമ്പുരം സൈന്യവേഷ്ടിതം വിലോക്യ തസ്യോച്ഛിന്നതായാഃ സമയഃ സമീപ ഇത്യവഗമിഷ്യഥ|</para>
  <para style="p">
    <verse number="21" style="v"/>തദാ യിഹൂദാദേശസ്ഥാ ലോകാഃ പർവ്വതം പലായന്താം, യേ ച നഗരേ തിഷ്ഠന്തി തേ ദേശാന്തരം പലായന്താ, യേ ച ഗ്രാമേ തിഷ്ഠന്തി തേ നഗരം ന പ്രവിശന്തു,</para>
  <para style="p">
    <verse number="22" style="v"/>യതസ്തദാ സമുചിതദണ്ഡനായ ധർമ്മപുസ്തകേ യാനി സർവ്വാണി ലിഖിതാനി താനി സഫലാനി ഭവിഷ്യന്തി|</para>
  <para style="p">
    <verse number="23" style="v"/>കിന്തു യാ യാസ്തദാ ഗർഭവത്യഃ സ്തന്യദാവ്യശ്ച താമാം ദുർഗതി ർഭവിഷ്യതി, യത ഏതാല്ലോകാൻ പ്രതി കോപോ ദേശേ ച വിഷമദുർഗതി ർഘടിഷ്യതേ|</para>
  <para style="p">
    <verse number="24" style="v"/>വസ്തുതസ്തു തേ ഖങ്ഗധാരപരിവ്വങ്ഗം ലപ്സ്യന്തേ ബദ്ധാഃ സന്തഃ സർവ്വദേശേഷു നായിഷ്യന്തേ ച കിഞ്ചാന്യദേശീയാനാം സമയോപസ്ഥിതിപര്യ്യന്തം യിരൂശാലമ്പുരം തൈഃ പദതലൈ ർദലയിഷ്യതേ|</para>
  <para style="p">
    <verse number="25" style="v"/>സൂര്യ്യചന്ദ്രനക്ഷത്രേഷു ലക്ഷണാദി ഭവിഷ്യന്തി, ഭുവി സർവ്വദേശീയാനാം ദുഃഖം ചിന്താ ച സിന്ധൗ വീചീനാം തർജനം ഗർജനഞ്ച ഭവിഷ്യന്തി|</para>
  <para style="p">
    <verse number="26" style="v"/>ഭൂഭൗ ഭാവിഘടനാം ചിന്തയിത്വാ മനുജാ ഭിയാമൃതകൽപാ ഭവിഷ്യന്തി, യതോ വ്യോമമണ്ഡലേ തേജസ്വിനോ ദോലായമാനാ ഭവിഷ്യന്തി|</para>
  <para style="p">
    <verse number="27" style="v"/>തദാ പരാക്രമേണാ മഹാതേജസാ ച മേഘാരൂഢം മനുഷ്യപുത്രമ് ആയാന്തം ദ്രക്ഷ്യന്തി|</para>
  <para style="p">
    <verse number="28" style="v"/>കിന്ത്വേതാസാം ഘടനാനാമാരമ്ഭേ സതി യൂയം മസ്തകാന്യുത്തോല്യ ഊർദധ്വം ദ്രക്ഷ്യഥ, യതോ യുഷ്മാകം മുക്തേഃ കാലഃ സവിധോ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="29" style="v"/>തതസ്തേനൈതദൃഷ്ടാന്തകഥാ കഥിതാ, പശ്യത ഉഡുമ്ബരാദിവൃക്ഷാണാം</para>
  <para style="p">
    <verse number="30" style="v"/>നവീനപത്രാണി ജാതാനീതി ദൃഷ്ട്വാ നിദാവകാല ഉപസ്ഥിത ഇതി യഥാ യൂയം ജ്ഞാതും ശക്നുഥ,</para>
  <para style="p">
    <verse number="31" style="v"/>തഥാ സർവ്വാസാമാസാം ഘടനാനാമ് ആരമ്ഭേ ദൃഷ്ടേ സതീശ്വരസ്യ രാജത്വം നികടമ് ഇത്യപി ജ്ഞാസ്യഥ|</para>
  <para style="p">
    <verse number="32" style="v"/>യുഷ്മാനഹം യഥാർഥം വദാമി, വിദ്യമാനലോകാനാമേഷാം ഗമനാത് പൂർവ്വമ് ഏതാനി ഘടിഷ്യന്തേ|</para>
  <para style="p">
    <verse number="33" style="v"/>നഭോഭുവോർലോപോ ഭവിഷ്യതി മമ വാക് തു കദാപി ലുപ്താ ന ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="34" style="v"/>അതഏവ വിഷമാശനേന പാനേന ച സാംമാരികചിന്താഭിശ്ച യുഷ്മാകം ചിത്തേഷു മത്തേഷു തദ്ദിനമ് അകസ്മാദ് യുഷ്മാൻ പ്രതി യഥാ നോപതിഷ്ഠതി തദർഥം സ്വേഷു സാവധാനാസ്തിഷ്ഠത|</para>
  <para style="p">
    <verse number="35" style="v"/>പൃഥിവീസ്ഥസർവ്വലോകാൻ പ്രതി തദ്ദിനമ് ഉന്മാഥ ഇവ ഉപസ്ഥാസ്യതി|</para>
  <para style="p">
    <verse number="36" style="v"/>യഥാ യൂയമ് ഏതദ്ഭാവിഘടനാ ഉത്തർത്തും മനുജസുതസ്യ സമ്മുഖേ സംസ്ഥാതുഞ്ച യോഗ്യാ ഭവഥ കാരണാദസ്മാത് സാവധാനാഃ സന്തോ നിരന്തരം പ്രാർഥയധ്വം|</para>
  <para style="p">
    <verse number="37" style="v"/>അപരഞ്ച സ ദിവാ മന്ദിര ഉപദിശ്യ രാചൈ ജൈതുനാദ്രിം ഗത്വാതിഷ്ഠത്|</para>
  <para style="p">
    <verse number="38" style="v"/>തതഃ പ്രത്യൂഷേ ലാകാസ്തത്കഥാം ശ്രോതും മന്ദിരേ തദന്തികമ് ആഗച്ഛൻ|</para>
  <chapter number="22" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അപരഞ്ച കിണ്വശൂന്യപൂപോത്സവസ്യ കാല ഉപസ്ഥിതേ</para>
  <para style="p">
    <verse number="2" style="v"/>പ്രധാനയാജകാ അധ്യായകാശ്ച യഥാ തം ഹന്തും ശക്നുവന്തി തഥോപായാമ് അചേഷ്ടന്ത കിന്തു ലോകേഭ്യോ ബിഭ്യുഃ|</para>
  <para style="p">
    <verse number="3" style="v"/>ഏതസ്തിൻ സമയേ ദ്വാദശശിഷ്യേഷു ഗണിത ഈഷ്കരിയോതീയരൂഢിമാൻ യോ യിഹൂദാസ്തസ്യാന്തഃകരണം ശൈതാനാശ്രിതത്വാത്</para>
  <para style="p">
    <verse number="4" style="v"/>സ ഗത്വാ യഥാ യീശും തേഷാം കരേഷു സമർപയിതും ശക്നോതി തഥാ മന്ത്രണാം പ്രധാനയാജകൈഃ സേനാപതിഭിശ്ച സഹ ചകാര|</para>
  <para style="p">
    <verse number="5" style="v"/>തേന തേ തുഷ്ടാസ്തസ്മൈ മുദ്രാം ദാതും പണം ചക്രുഃ|</para>
  <para style="p">
    <verse number="6" style="v"/>തതഃ സോങ്ഗീകൃത്യ യഥാ ലോകാനാമഗോചരേ തം പരകരേഷു സമർപയിതും ശക്നോതി തഥാവകാശം ചേഷ്ടിതുമാരേഭേ|</para>
  <para style="p">
    <verse number="7" style="v"/>അഥ കിണ്വശൂന്യപൂപോത്മവദിനേ, അർഥാത് യസ്മിൻ ദിനേ നിസ്താരോത്സവസ്യ മേഷോ ഹന്തവ്യസ്തസ്മിൻ ദിനേ</para>
  <para style="p">
    <verse number="8" style="v"/>യീശുഃ പിതരം യോഹനഞ്ചാഹൂയ ജഗാദ, യുവാം ഗത്വാസ്മാകം ഭോജനാർഥം നിസ്താരോത്സവസ്യ ദ്രവ്യാണ്യാസാദയതം|</para>
  <para style="p">
    <verse number="9" style="v"/>തദാ തൗ പപ്രച്ഛതുഃ കുചാസാദയാവോ ഭവതഃ കേച്ഛാ?</para>
  <para style="p">
    <verse number="10" style="v"/>തദാ സോവാദീത്, നഗരേ പ്രവിഷ്ടേ കശ്ചിജ്ജലകുമ്ഭമാദായ യുവാം സാക്ഷാത് കരിഷ്യതി സ യന്നിവേശനം പ്രവിശതി യുവാമപി തന്നിവേശനം തത്പശ്ചാദിത്വാ നിവേശനപതിമ് ഇതി വാക്യം വദതം,</para>
  <para style="p">
    <verse number="11" style="v"/>യത്രാഹം നിസ്താരോത്സവസ്യ ഭോജ്യം ശിഷ്യൈഃ സാർദ്ധം ഭോക്തും ശക്നോമി സാതിഥിശാലാा കുത്ര? കഥാമിമാം പ്രഭുസ്ത്വാം പൃച്ഛതി|</para>
  <para style="p">
    <verse number="12" style="v"/>തതഃ സ ജനോ ദ്വിതീയപ്രകോഷ്ഠീയമ് ഏകം ശസ്തം കോഷ്ഠം ദർശയിഷ്യതി തത്ര ഭോജ്യമാസാദയതം|</para>
  <para style="p">
    <verse number="13" style="v"/>തതസ്തൗ ഗത്വാ തദ്വാക്യാനുസാരേണ സർവ്വം ദൃഷ്ദ്വാ തത്ര നിസ്താരോത്സവീയം ഭോജ്യമാസാദയാമാസതുഃ|</para>
  <para style="p">
    <verse number="14" style="v"/>അഥ കാല ഉപസ്ഥിതേ യീശു ർദ്വാദശഭിഃ പ്രേരിതൈഃ സഹ ഭോക്തുമുപവിശ്യ കഥിതവാൻ</para>
  <para style="p">
    <verse number="15" style="v"/>മമ ദുഃഖഭോഗാത് പൂർവ്വം യുഭാഭിഃ സഹ നിസ്താരോത്സവസ്യൈതസ്യ ഭോജ്യം ഭോക്തും മയാതിവാഞ്ഛാ കൃതാ|</para>
  <para style="p">
    <verse number="16" style="v"/>യുഷ്മാൻ വദാമി, യാവത്കാലമ് ഈശ്വരരാജ്യേ ഭോജനം ന കരിഷ്യേ താവത്കാലമ് ഇദം ന ഭോക്ഷ്യേ|</para>
  <para style="p">
    <verse number="17" style="v"/>തദാ സ പാനപാത്രമാദായ ഈശ്വരസ്യ ഗുണാൻ കീർത്തയിത്വാ തേഭ്യോ ദത്വാവദത്, ഇദം ഗൃഹ്ലീത യൂയം വിഭജ്യ പിവത|</para>
  <para style="p">
    <verse number="18" style="v"/>യുഷ്മാൻ വദാമി യാവത്കാലമ് ഈശ്വരരാജത്വസ്യ സംസ്ഥാപനം ന ഭവതി താവദ് ദ്രാക്ഷാഫലരസം ന പാസ്യാമി|</para>
  <para style="p">
    <verse number="19" style="v"/>തതഃ പൂപം ഗൃഹീത്വാ ഈശ്വരഗുണാൻ കീർത്തയിത്വാ ഭങ്ക്താ തേഭ്യോ ദത്വാവദത്, യുഷ്മദർഥം സമർപിതം യന്മമ വപുസ്തദിദം, ഏതത് കർമ്മ മമ സ്മരണാർഥം കുരുധ്വം|</para>
  <para style="p">
    <verse number="20" style="v"/>അഥ ഭോജനാന്തേ താദൃശം പാത്രം ഗൃഹീത്വാവദത്, യുഷ്മത്കൃതേ പാതിതം യന്മമ രക്തം തേന നിർണീതനവനിയമരൂപം പാനപാത്രമിദം|</para>
  <para style="p">
    <verse number="21" style="v"/>പശ്യത യോ മാം പരകരേഷു സമർപയിഷ്യതി സ മയാ സഹ ഭോജനാസന ഉപവിശതി|</para>
  <para style="p">
    <verse number="22" style="v"/>യഥാ നിരൂപിതമാസ്തേ തദനുസാരേണാ മനുഷ്യപുुത്രസ്യ ഗതി ർഭവിഷ്യതി കിന്തു യസ്തം പരകരേഷു സമർപയിഷ്യതി തസ്യ സന്താപോ ഭവിഷ്യതി|</para>
  <para style="p">
    <verse number="23" style="v"/>തദാ തേഷാം കോ ജന ഏതത് കർമ്മ കരിഷ്യതി തത് തേ പരസ്പരം പ്രഷ്ടുമാരേഭിരേ|</para>
  <para style="p">
    <verse number="24" style="v"/>അപരം തേഷാം കോ ജനഃ ശ്രേഷ്ഠത്വേന ഗണയിഷ്യതേ, അത്രാർഥേ തേഷാം വിവാദോഭവത്|</para>
  <para style="p">
    <verse number="25" style="v"/>അസ്മാത് കാരണാത് സോവദത്, അന്യദേശീയാനാം രാജാനഃ പ്രജാനാമുപരി പ്രഭുത്വം കുർവ്വന്തി ദാരുണശാസനം കൃത്വാപി തേ ഭൂപതിത്വേന വിഖ്യാതാ ഭവന്തി ച|</para>
  <para style="p">
    <verse number="26" style="v"/>കിന്തു യുഷ്മാകം തഥാ ന ഭവിഷ്യതി, യോ യുഷ്മാകം ശ്രേഷ്ഠോ ഭവിഷ്യതി സ കനിഷ്ഠവദ് ഭവതു, യശ്ച മുഖ്യോ ഭവിഷ്യതി സ സേവകവദ്ഭവതു|</para>
  <para style="p">
    <verse number="27" style="v"/>ഭോജനോപവിഷ്ടപരിചാരകയോഃ കഃ ശ്രേഷ്ഠഃ? യോ ഭോജനായോപവിശതി സ കിം ശ്രേഷ്ഠോ ന ഭവതി? കിന്തു യുഷ്മാകം മധ്യേഽഹം പരിചാരകഇവാസ്മി|</para>
  <para style="p">
    <verse number="28" style="v"/>അപരഞ്ച യുയം മമ പരീക്ഷാകാലേ പ്രഥമമാരഭ്യ മയാ സഹ സ്ഥിതാ</para>
  <para style="p">
    <verse number="29" style="v"/>ഏതത്കാരണാത് പിത്രാ യഥാ മദർഥം രാജ്യമേകം നിരൂപിതം തഥാഹമപി യുഷ്മദർഥം രാജ്യം നിരൂപയാമി|</para>
  <para style="p">
    <verse number="30" style="v"/>തസ്മാൻ മമ രാജ്യേ ഭോജനാസനേ ച ഭോജനപാനേ കരിഷ്യധ്വേ സിംഹാസനേഷൂപവിശ്യ ചേസ്രായേലീയാനാം ദ്വാദശവംശാനാം വിചാരം കരിഷ്യധ്വേ|</para>
  <para style="p">
    <verse number="31" style="v"/>അപരം പ്രഭുരുവാച, ഹേ ശിമോൻ പശ്യ തിതഉനാ ധാന്യാനീവ യുഷ്മാൻ ശൈതാൻ ചാലയിതുമ് ഐച്ഛത്,</para>
  <para style="p">
    <verse number="32" style="v"/>കിന്തു തവ വിശ്വാസസ്യ ലോപോ യഥാ ന ഭവതി ഏതത് ത്വദർഥം പ്രാർഥിതം മയാ, ത്വന്മനസി പരിവർത്തിതേ ച ഭ്രാതൃണാം മനാംസി സ്ഥിരീകുരു|</para>
  <para style="p">
    <verse number="33" style="v"/>തദാ സോവദത്, ഹേ പ്രഭോഹം ത്വയാ സാർദ്ധം കാരാം മൃതിഞ്ച യാതും മജ്ജിതോസ്മി|</para>
  <para style="p">
    <verse number="34" style="v"/>തതഃ സ ഉവാച, ഹേ പിതര ത്വാം വദാമി, അദ്യ കുക്കുടരവാത് പൂർവ്വം ത്വം മത്പരിചയം വാരത്രയമ് അപഹ്വോഷ്യസേ|</para>
  <para style="p">
    <verse number="35" style="v"/>അപരം സ പപ്രച്ഛ, യദാ മുദ്രാസമ്പുടം ഖാദ്യപാത്രം പാദുകാഞ്ച വിനാ യുഷ്മാൻ പ്രാഹിണവം തദാ യുഷ്മാകം കസ്യാപി ന്യൂനതാസീത്? തേ പ്രോചുഃ കസ്യാപി ന|</para>
  <para style="p">
    <verse number="36" style="v"/>തദാ സോവദത് കിന്ത്വിദാനീം മുദ്രാസമ്പുടം ഖാദ്യപാത്രം വാ യസ്യാസ്തി തേന തദ്ഗ്രഹീതവ്യം, യസ്യ ച കൃപാണോे നാസ്തി തേന സ്വവസ്ത്രം വിക്രീയ സ ക്രേതവ്യഃ|</para>
  <para style="p">
    <verse number="37" style="v"/>യതോ യുഷ്മാനഹം വദാമി, അപരാധിജനൈഃ സാർദ്ധം ഗണിതഃ സ ഭവിഷ്യതി| ഇദം യച്ഛാസ്ത്രീയം വചനം ലിഖിതമസ്തി തന്മയി ഫലിഷ്യതി യതോ മമ സമ്ബന്ധീയം സർവ്വം സേത്സ്യതി|</para>
  <para style="p">
    <verse number="38" style="v"/>തദാ തേ പ്രോചുഃ പ്രഭോ പശ്യ ഇമൗ കൃപാണൗ| തതഃ സോവദദ് ഏതൗ യഥേഷ്ടൗ|</para>
  <para style="p">
    <verse number="39" style="v"/>അഥ സ തസ്മാദ്വഹി ർഗത്വാ സ്വാചാരാനുസാരേണ ജൈതുനനാമാദ്രിം ജഗാമ ശിഷ്യാശ്ച തത്പശ്ചാദ് യയുഃ|</para>
  <para style="p">
    <verse number="40" style="v"/>തത്രോപസ്ഥായ സ താനുവാച, യഥാ പരീക്ഷായാം ന പതഥ തദർഥം പ്രാർഥയധ്വം|</para>
  <para style="p">
    <verse number="41" style="v"/>പശ്ചാത് സ തസ്മാദ് ഏകശരക്ഷേപാദ് ബഹി ർഗത്വാ ജാനുനീ പാതയിത്വാ ഏതത് പ്രാർഥയാഞ്ചക്രേ,</para>
  <para style="p">
    <verse number="42" style="v"/>ഹേ പിത ര്യദി ഭവാൻ സമ്മന്യതേ തർഹി കംസമേനം മമാന്തികാദ് ദൂരയ കിന്തു മദിച്ഛാനുരൂപം ന ത്വദിച്ഛാനുരൂപം ഭവതു|</para>
  <para style="p">
    <verse number="43" style="v"/>തദാ തസ്മൈ ശക്തിം ദാതും സ്വർഗീയദൂതോ ദർശനം ദദൗ|</para>
  <para style="p">
    <verse number="44" style="v"/>പശ്ചാത് സോത്യന്തം യാതനയാ വ്യാകുലോ ഭൂത്വാ പുനർദൃഢം പ്രാർഥയാഞ്ചക്രേ, തസ്മാദ് ബൃഹച്ഛോണിതബിന്ദവ ഇവ തസ്യ സ്വേദബിന്ദവഃ പൃഥിവ്യാം പതിതുമാരേഭിരേ|</para>
  <para style="p">
    <verse number="45" style="v"/>അഥ പ്രാർഥനാത ഉത്ഥായ ശിഷ്യാണാം സമീപമേത്യ താൻ മനോദുഃഖിനോ നിദ്രിതാൻ ദൃഷ്ട്വാവദത്</para>
  <para style="p">
    <verse number="46" style="v"/>കുതോ നിദ്രാഥ? പരീക്ഷായാമ് അപതനാർഥം പ്രർഥയധ്വം|</para>
  <para style="p">
    <verse number="47" style="v"/>ഏതത്കഥായാഃ കഥനകാലേ ദ്വാദശശിഷ്യാണാം മധ്യേ ഗണിതോ യിഹൂദാനാമാ ജനതാസഹിതസ്തേഷാമ് അഗ്രേ ചലിത്വാ യീശോശ്ചുമ്ബനാർഥം തദന്തികമ് ആയയൗ|</para>
  <para style="p">
    <verse number="48" style="v"/>തദാ യീശുരുവാച, ഹേ യിഹൂദാ കിം ചുമ്ബനേന മനുഷ്യപുത്രം പരകരേഷു സമർപയസി?</para>
  <para style="p">
    <verse number="49" style="v"/>തദാ യദ്യദ് ഘടിഷ്യതേ തദനുമായ സങ്ഗിഭിരുക്തം, ഹേ പ്രഭോ വയം കി ഖങ്ഗേന ഘാതയിഷ്യാമഃ?</para>
  <para style="p">
    <verse number="50" style="v"/>തത ഏകഃ കരവാലേനാഹത്യ പ്രധാനയാജകസ്യ ദാസസ്യ ദക്ഷിണം കർണം ചിച്ഛേദ|</para>
  <para style="p">
    <verse number="51" style="v"/>അധൂനാ നിവർത്തസ്വ ഇത്യുക്ത്വാ യീശുസ്തസ്യ ശ്രുതിം സ്പൃഷ്ട്വാ സ്വസ്യം ചകാര|</para>
  <para style="p">
    <verse number="52" style="v"/>പശ്ചാദ് യീശുഃ സമീപസ്ഥാൻ പ്രധാനയാജകാൻ മന്ദിരസ്യ സേനാപതീൻ പ്രാചീനാംശ്ച ജഗാദ, യൂയം കൃപാണാൻ യഷ്ടീംശ്ച ഗൃഹീത്വാ മാം കിം ചോരം ധർത്തുമായാതാഃ?</para>
  <para style="p">
    <verse number="53" style="v"/>യദാഹം യുഷ്മാഭിഃ സഹ പ്രതിദിനം മന്ദിരേഽതിഷ്ഠം തദാ മാം ധർത്തം ന പ്രവൃത്താഃ, കിന്ത്വിദാനീം യുഷ്മാകം സമയോന്ധകാരസ്യ ചാധിപത്യമസ്തി|</para>
  <para style="p">
    <verse number="54" style="v"/>അഥ തേ തം ധൃത്വാ മഹായാജകസ്യ നിവേശനം നിന്യുഃ| തതഃ പിതരോ ദൂരേ ദൂരേ പശ്ചാദിത്വാ</para>
  <para style="p">
    <verse number="55" style="v"/>ബൃഹത്കോഷ്ഠസ്യ മധ്യേ യത്രാഗ്നിം ജ്വാലയിത്വാ ലോകാഃ സമേത്യോപവിഷ്ടാസ്തത്ര തൈഃ സാർദ്ധമ് ഉപവിവേശ|</para>
  <para style="p">
    <verse number="56" style="v"/>അഥ വഹ്നിസന്നിധൗ സമുപവേശകാലേ കാചിദ്ദാസീ മനോ നിവിശ്യ തം നിരീക്ഷ്യാവദത് പുമാനയം തസ്യ സങ്ഗേഽസ്ഥാത്|</para>
  <para style="p">
    <verse number="57" style="v"/>കിന്തു സ തദ് അപഹ്നുത്യാവാദീത് ഹേ നാരി തമഹം ന പരിചിനോമി|</para>
  <para style="p">
    <verse number="58" style="v"/>ക്ഷണാന്തരേഽന്യജനസ്തം ദൃഷ്ട്വാബ്രവീത് ത്വമപി തേഷാം നികരസ്യൈകജനോസി| പിതരഃ പ്രത്യുവാച ഹേ നര നാഹമസ്മി|</para>
  <para style="p">
    <verse number="59" style="v"/>തതഃ സാർദ്ധദണ്ഡദ്വയാത് പരം പുനരന്യോ ജനോ നിശ്ചിത്യ ബഭാഷേ, ഏഷ തസ്യ സങ്ഗീതി സത്യം യതോയം ഗാലീലീയോ ലോകഃ|</para>
  <para style="p">
    <verse number="60" style="v"/>തദാ പിതര ഉവാച ഹേ നര ത്വം യദ് വദമി തദഹം ബോദ്ധും ന ശക്നോമി, ഇതി വാക്യേ കഥിതമാത്രേ കുക്കുടോ രുരാവ|</para>
  <para style="p">
    <verse number="61" style="v"/>തദാ പ്രഭുണാ വ്യാധുട്യ പിതരേ നിരീക്ഷിതേ കൃകവാകുരവാത് പൂർവ്വം മാം ത്രിരപഹ്നോഷ്യസേ ഇതി പൂർവ്വോക്തം തസ്യ വാക്യം പിതരഃ സ്മൃത്വാ</para>
  <para style="p">
    <verse number="62" style="v"/>ബഹിർഗത്വാ മഹാഖേദേന ചക്രന്ദ|</para>
  <para style="p">
    <verse number="63" style="v"/>തദാ യൈ ര്യീശുർധൃതസ്തേ തമുപഹസ്യ പ്രഹർത്തുമാരേഭിരേ|</para>
  <para style="p">
    <verse number="64" style="v"/>വസ്ത്രേണ തസ്യ ദൃശൗ ബദ്ധ്വാ കപോലേ ചപേടാഘാതം കൃത്വാ പപ്രച്ഛുഃ, കസ്തേ കപോലേ ചപേടാഘാതം കൃതവാന? ഗണയിത്വാ തദ് വദ|</para>
  <para style="p">
    <verse number="65" style="v"/>തദന്യത് തദ്വിരുദ്ധം ബഹുനിന്ദാവാക്യം വക്തുമാരേഭിരേ|</para>
  <para style="p">
    <verse number="66" style="v"/>അഥ പ്രഭാതേ സതി ലോകപ്രാഞ്ചഃ പ്രധാനയാജകാ അധ്യാപകാശ്ച സഭാം കൃത്വാ മധ്യേസഭം യീശുമാനീയ പപ്രച്ഛുഃ, ത്വമ് അഭിഷികതോസി ന വാസ്മാൻ വദ|</para>
  <para style="p">
    <verse number="67" style="v"/>സ പ്രത്യുവാച, മയാ തസ്മിന്നുക്തേഽപി യൂയം ന വിശ്വസിഷ്യഥ|</para>
  <para style="p">
    <verse number="68" style="v"/>കസ്മിംശ്ചിദ്വാക്യേ യുഷ്മാൻ പൃഷ്ടേഽപി മാം ന തദുത്തരം വക്ഷ്യഥ ന മാം ത്യക്ഷ്യഥ ച|</para>
  <para style="p">
    <verse number="69" style="v"/>കിന്ത്വിതഃ പരം മനുജസുതഃ സർവ്വശക്തിമത ഈശ്വരസ്യ ദക്ഷിണേ പാർശ്വേ സമുപവേക്ഷ്യതി|</para>
  <para style="p">
    <verse number="70" style="v"/>തതസ്തേ പപ്രച്ഛുഃ, ർതിഹ ത്വമീശ്വരസ്യ പുത്രഃ? സ കഥയാമാസ, യൂയം യഥാർഥം വദഥ സ ഏവാഹം|</para>
  <para style="p">
    <verse number="71" style="v"/>തദാ തേ സർവ്വേ കഥയാമാസുഃ, ർതിഹ സാക്ഷ്യേഽൻസസ്മിൻ അസ്മാകം കിം പ്രയോജനം? അസ്യ സ്വമുഖാദേവ സാക്ഷ്യം പ്രാപ്തമ്|</para>
  <chapter number="23" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>തതഃ സഭാസ്ഥാഃ സർവ്വലോകാ ഉത്ഥായ തം പീലാതസമ്മുഖം നീത്വാപ്രോദ്യ വക്തുമാരേഭിരേ,</para>
  <para style="p">
    <verse number="2" style="v"/>സ്വമഭിഷിക്തം രാജാനം വദന്തം കൈമരരാജായ കരദാനം നിഷേധന്തം രാജ്യവിപര്യ്യയം കുർത്തും പ്രവർത്തമാനമ് ഏന പ്രാപ്താ വയം|</para>
  <para style="p">
    <verse number="3" style="v"/>തദാ പീലാതസ്തം പൃഷ്ടവാൻ ത്വം കിം യിഹൂദീയാനാം രാജാ? സ പ്രത്യുവാച ത്വം സത്യമുക്തവാൻ|</para>
  <para style="p">
    <verse number="4" style="v"/>തദാ പീലാതഃ പ്രധാനയാജകാദിലോകാൻ ജഗാദ്, അഹമേതസ്യ കമപ്യപരാധം നാപ്തവാൻ|</para>
  <para style="p">
    <verse number="5" style="v"/>തതസ്തേ പുനഃ സാഹമിനോ ഭൂത്വാവദൻ, ഏഷ ഗാലീല ഏതത്സ്ഥാനപര്യ്യന്തേ സർവ്വസ്മിൻ യിഹൂദാദേശേ സർവ്വാല്ലോകാനുപദിശ്യ കുപ്രവൃത്തിം ഗ്രാഹീതവാൻ|</para>
  <para style="p">
    <verse number="6" style="v"/>തദാ പീലാതോ ഗാലീലപ്രദേശസ്യ നാമ ശ്രുത്വാ പപ്രച്ഛ, കിമയം ഗാലീലീയോ ലോകഃ?</para>
  <para style="p">
    <verse number="7" style="v"/>തതഃ സ ഗാലീൽപ്രദേശീയഹേരോദ്രാജസ്യ തദാ സ്ഥിതേസ്തസ്യ സമീപേ യീശും പ്രേഷയാമാസ|</para>
  <para style="p">
    <verse number="8" style="v"/>തദാ ഹേരോദ് യീശും വിലോക്യ സന്തുതോഷ, യതഃ സ തസ്യ ബഹുവൃത്താന്തശ്രവണാത് തസ്യ കിഞി्ചദാശ്ചര്യ്യകർമ്മ പശ്യതി ഇത്യാശാം കൃത്വാ ബഹുകാലമാരഭ്യ തം ദ്രഷ്ടും പ്രയാസം കൃതവാൻ|</para>
  <para style="p">
    <verse number="9" style="v"/>തസ്മാത് തം ബഹുകഥാഃ പപ്രച്ഛ കിന്തു സ തസ്യ കസ്യാപി വാക്യസ്യ പ്രത്യുത്തരം നോവാച|</para>
  <para style="p">
    <verse number="10" style="v"/>അഥ പ്രധാനയാജകാ അധ്യാപകാശ്ച പ്രോത്തിഷ്ഠന്തഃ സാഹസേന തമപവദിതും പ്രാരേഭിരേ|</para>
  <para style="p">
    <verse number="11" style="v"/>ഹേരോദ് തസ്യ സേനാഗണശ്ച തമവജ്ഞായ ഉപഹാസത്വേന രാജവസ്ത്രം പരിധാപ്യ പുനഃ പീലാതം പ്രതി തം പ്രാഹിണോത്|</para>
  <para style="p">
    <verse number="12" style="v"/>പൂർവ്വം ഹേരോദ്പീലാതയോഃ പരസ്പരം വൈരഭാവ ആസീത് കിന്തു തദ്ദിനേ ദ്വയോ ർമേലനം ജാതമ്|</para>
  <para style="p">
    <verse number="13" style="v"/>പശ്ചാത് പീലാതഃ പ്രധാനയാജകാൻ ശാസകാൻ ലോകാംശ്ച യുഗപദാഹൂയ ബഭാഷേ,</para>
  <para style="p">
    <verse number="14" style="v"/>രാജ്യവിപര്യ്യയകാരകോയമ് ഇത്യുക്ത്വാ മനുഷ്യമേനം മമ നികടമാനൈഷ്ട കിന്തു പശ്യത യുഷ്മാകം സമക്ഷമ് അസ്യ വിചാരം കൃത്വാപി പ്രോക്താപവാദാനുരൂപേണാസ്യ കോപ്യപരാധഃ സപ്രമാണോ ന ജാതഃ,</para>
  <para style="p">
    <verse number="15" style="v"/>യൂയഞ്ച ഹേരോദഃ സന്നിധൗ പ്രേഷിതാ മയാ തത്രാസ്യ കോപ്യപരാധസ്തേനാപി ന പ്രാപ്തഃ| പശ്യതാനേന വധഹേेതുകം കിമപി നാപരാദ്ധം|</para>
  <para style="p">
    <verse number="16" style="v"/>തസ്മാദേനം താഡയിത്വാ വിഹാസ്യാമി|</para>
  <para style="p">
    <verse number="17" style="v"/>തത്രോത്സവേ തേഷാമേകോ മോചയിതവ്യഃ|</para>
  <para style="p">
    <verse number="18" style="v"/>ഇതി ഹേതോസ്തേ പ്രോച്ചൈരേകദാ പ്രോചുഃ, ഏനം ദൂരീകൃത്യ ബരബ്ബാനാമാനം മോചയ|</para>
  <para style="p">
    <verse number="19" style="v"/>സ ബരബ്ബാ നഗര ഉപപ്ലവവധാപരാധാഭ്യാം കാരായാം ബദ്ധ ആസീത്|</para>
  <para style="p">
    <verse number="20" style="v"/>കിന്തു പീലാതോ യീശും മോചയിതും വാഞ്ഛൻ പുനസ്താനുവാച|</para>
  <para style="p">
    <verse number="21" style="v"/>തഥാപ്യേനം ക്രുശേ വ്യധ ക്രുശേ വ്യധേതി വദന്തസ്തേ രുരുവുഃ|</para>
  <para style="p">
    <verse number="22" style="v"/>തതഃ സ തൃതീയവാരം ജഗാദ കുതഃ? സ കിം കർമ്മ കൃതവാൻ? നാഹമസ്യ കമപി വധാപരാധം പ്രാപ്തഃ കേവലം താഡയിത്വാമും ത്യജാമി|</para>
  <para style="p">
    <verse number="23" style="v"/>തഥാപി തേ പുനരേനം ക്രുശേ വ്യധ ഇത്യുക്ത്വാ പ്രോച്ചൈർദൃഢം പ്രാർഥയാഞ്ചക്രിരേ;</para>
  <para style="p">
    <verse number="24" style="v"/>തതഃ പ്രധാനയാജകാദീനാം കലരവേ പ്രബലേ സതി തേഷാം പ്രാർഥനാരൂപം കർത്തും പീലാത ആദിദേശ|</para>
  <para style="p">
    <verse number="25" style="v"/>രാജദ്രോഹവധയോരപരാധേന കാരാസ്ഥം യം ജനം തേ യയാചിരേ തം മോചയിത്വാ യീശും തേഷാമിച്ഛായാം സമാർപയത്|</para>
  <para style="p">
    <verse number="26" style="v"/>അഥ തേ യീശും ഗൃഹീത്വാ യാന്തി, ഏതർഹി ഗ്രാമാദാഗതം ശിമോനനാമാനം കുരീണീയം ജനം ധൃത്വാ യീശോഃ പശ്ചാന്നേതും തസ്യ സ്കന്ധേ ക്രുശമർപയാമാസുഃ|</para>
  <para style="p">
    <verse number="27" style="v"/>തതോ ലോाകാരണ്യമധ്യേ ബഹുസ്ത്രിയോ രുദത്യോ വിലപന്ത്യശ്ച യീശോഃ പശ്ചാദ് യയുഃ|</para>
  <para style="p">
    <verse number="28" style="v"/>കിന്തു സ വ്യാഘുട്യ താ ഉവാച, ഹേ യിരൂശാലമോ നാര്യ്യോ യുയം മദർഥം ന രുദിത്വാ സ്വാർഥം സ്വാപത്യാർഥഞ്ച രുദിതി;</para>
  <para style="p">
    <verse number="29" style="v"/>പശ്യത യഃ കദാപി ഗർഭവത്യോ നാഭവൻ സ്തന്യഞ്ച നാപായയൻ താദൃശീ ർവന്ധ്യാ യദാ ധന്യാ വക്ഷ്യന്തി സ കാല ആയാതി|</para>
  <para style="p">
    <verse number="30" style="v"/>തദാ ഹേ ശൈലാ അസ്മാകമുപരി പതത, ഹേ ഉപശൈലാ അസ്മാനാച്ഛാദയത കഥാമീദൃശീം ലോകാ വക്ഷ്യന്തി|</para>
  <para style="p">
    <verse number="31" style="v"/>യതഃ സതേജസി ശാഖിനി ചേദേതദ് ഘടതേ തർഹി ശുഷ്കശാഖിനി കിം ന ഘടിഷ്യതേ?</para>
  <para style="p">
    <verse number="32" style="v"/>തദാ തേ ഹന്തും ദ്വാവപരാധിനൗ തേന സാർദ്ധം നിന്യുഃ|</para>
  <para style="p">
    <verse number="33" style="v"/>അപരം ശിരഃകപാലനാമകസ്ഥാനം പ്രാപ്യ തം ക്രുശേ വിവിധുഃ; തദ്ദ്വയോരപരാധിനോരേകം തസ്യ ദക്ഷിണോ തദന്യം വാമേ ക്രുശേ വിവിധുഃ|</para>
  <para style="p">
    <verse number="34" style="v"/>തദാ യീശുരകഥയത്, ഹേ പിതരേതാൻ ക്ഷമസ്വ യത ഏതേ യത് കർമ്മ കുർവ്വന്തി തൻ ന വിദുഃ; പശ്ചാത്തേ ഗുടികാപാതം കൃത്വാ തസ്യ വസ്ത്രാണി വിഭജ്യ ജഗൃഹുഃ|</para>
  <para style="p">
    <verse number="35" style="v"/>തത്ര ലോകസംഘസ്തിഷ്ഠൻ ദദർശ; തേ തേഷാം ശാസകാശ്ച തമുപഹസ്യ ജഗദുഃ, ഏഷ ഇതരാൻ രക്ഷിതവാൻ യദീശ്വരേണാഭിരുചിതോ ഽഭിഷിക്തസ്ത്രാതാ ഭവതി തർഹി സ്വമധുനാ രക്ഷതു|</para>
  <para style="p">
    <verse number="36" style="v"/>തദന്യഃ സേനാഗണാ ഏത്യ തസ്മൈ അമ്ലരസം ദത്വാ പരിഹസ്യ പ്രോവാച,</para>
  <para style="p">
    <verse number="37" style="v"/>ചേത്ത്വം യിഹൂദീയാനാം രാജാസി തർഹി സ്വം രക്ഷ|</para>
  <para style="p">
    <verse number="38" style="v"/>യിഹൂദീയാനാം രാജേതി വാക്യം യൂനാനീയരോമീയേബ്രീയാക്ഷരൈ ർലിഖിതം തച്ഛിരസ ഊർദ്ധ്വേഽസ്ഥാപ്യത|</para>
  <para style="p">
    <verse number="39" style="v"/>തദോഭയപാർശ്വയോ ർവിദ്ധൗ യാവപരാധിനൗ തയോരേകസ്തം വിനിന്ദ്യ ബഭാഷേ, ചേത്ത്വമ് അഭിഷിക്തോസി തർഹി സ്വമാവാഞ്ച രക്ഷ|</para>
  <para style="p">
    <verse number="40" style="v"/>കിന്ത്വന്യസ്തം തർജയിത്വാവദത്, ഈശ്വരാത്തവ കിഞ്ചിദപി ഭയം നാസ്തി കിം? ത്വമപി സമാനദണ്ഡോസി,</para>
  <para style="p">
    <verse number="41" style="v"/>യോഗ്യപാത്രേ ആവാം സ്വസ്വകർമ്മണാം സമുചിതഫലം പ്രാപ്നുവഃ കിന്ത്വനേന കിമപി നാപരാദ്ധം|</para>
  <para style="p">
    <verse number="42" style="v"/>അഥ സ യീശും ജഗാദ ഹേ പ്രഭേ ഭവാൻ സ്വരാജ്യപ്രവേശകാലേ മാം സ്മരതു|</para>
  <para style="p">
    <verse number="43" style="v"/>തദാ യീശുഃ കഥിതവാൻ ത്വാം യഥാർഥം വദാമി ത്വമദ്യൈവ മയാ സാർദ്ധം പരലോകസ്യ സുഖസ്ഥാനം പ്രാപ്സ്യസി|</para>
  <para style="p">
    <verse number="44" style="v"/>അപരഞ്ച ദ്വിതീയയാമാത് തൃതീയയാമപര്യ്യന്തം രവേസ്തേജസോന്തർഹിതത്വാത് സർവ്വദേശോഽന്ധകാരേണാവൃതോ</para>
  <para style="p">
    <verse number="45" style="v"/>മന്ദിരസ്യ യവനികാ ച ഛിദ്യമാനാ ദ്വിധാ ബഭൂവ|</para>
  <para style="p">
    <verse number="46" style="v"/>തതോ യീശുരുച്ചൈരുവാച, ഹേ പിത ർമമാത്മാനം തവ കരേ സമർപയേ, ഇത്യുക്ത്വാ സ പ്രാണാൻ ജഹൗ|</para>
  <para style="p">
    <verse number="47" style="v"/>തദൈതാ ഘടനാ ദൃഷ്ട്വാ ശതസേനാപതിരീശ്വരം ധന്യമുക്ത്വാ കഥിതവാൻ അയം നിതാന്തം സാധുമനുഷ്യ ആസീത്|</para>
  <para style="p">
    <verse number="48" style="v"/>അഥ യാവന്തോ ലോകാ ദ്രഷ്ടുമ് ആഗതാസ്തേ താ ഘടനാ ദൃഷ്ട്വാ വക്ഷഃസു കരാഘാതം കൃത്വാ വ്യാചുട്യ ഗതാഃ|</para>
  <para style="p">
    <verse number="49" style="v"/>യീശോ ർജ്ഞാതയോ യാ യാ യോഷിതശ്ച ഗാലീലസ്തേന സാർദ്ധമായാതാസ്താ അപി ദൂരേ സ്ഥിത്വാ തത് സർവ്വം ദദൃശുഃ|</para>
  <para style="p">
    <verse number="50" style="v"/>തദാ യിഹൂദീയാനാം മന്ത്രണാം ക്രിയാഞ്ചാസമ്മന്യമാന ഈശ്വരസ്യ രാജത്വമ് അപേക്ഷമാണോ</para>
  <para style="p">
    <verse number="51" style="v"/>യിഹൂദിദേശീയോ ഽരിമഥീയനഗരീയോ യൂഷഫ്നാമാ മന്ത്രീ ഭദ്രോ ധാർമ്മികശ്ച പുമാൻ</para>
  <para style="p">
    <verse number="52" style="v"/>പീലാതാന്തികം ഗത്വാ യീശോ ർദേഹം യയാചേ|</para>
  <para style="p">
    <verse number="53" style="v"/>പശ്ചാദ് വപുരവരോഹ്യ വാസസാ സംവേഷ്ട്യ യത്ര കോപി മാനുഷോ നാസ്ഥാപ്യത തസ്മിൻ ശൈലേ സ്വാതേ ശ്മശാനേ തദസ്ഥാപയത്|</para>
  <para style="p">
    <verse number="54" style="v"/>തദ്ദിനമായോജനീയം ദിനം വിശ്രാമവാരശ്ച സമീപഃ|</para>
  <para style="p">
    <verse number="55" style="v"/>അപരം യീശുനാ സാർദ്ധം ഗാലീല ആഗതാ യോഷിതഃ പശ്ചാദിത്വാ ശ്മശാനേ തത്ര യഥാ വപുഃ സ്ഥാപിതം തച്ച ദൃഷ്ട്വാ</para>
  <para style="p">
    <verse number="56" style="v"/>വ്യാഘുട്യ സുഗന്ധിദ്രവ്യതൈലാനി കൃത്വാ വിധിവദ് വിശ്രാമവാരേ വിശ്രാമം ചക്രുഃ|</para>
  <chapter number="24" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>അഥ സപ്താഹപ്രഥമദിനേഽതിപ്രത്യൂഷേ താ യോഷിതഃ സമ്പാദിതം സുഗന്ധിദ്രവ്യം ഗൃഹീത്വാ തദന്യാഭിഃ കിയതീഭിഃ സ്ത്രീഭിഃ സഹ ശ്മശാനം യയുഃ|</para>
  <para style="p">
    <verse number="2" style="v"/>കിന്തു ശ്മശാനദ്വാരാത് പാഷാണമപസാരിതം ദൃഷ്ട്വാ</para>
  <para style="p">
    <verse number="3" style="v"/>താഃ പ്രവിശ്യ പ്രഭോ ർദേഹമപ്രാപ്യ</para>
  <para style="p">
    <verse number="4" style="v"/>വ്യാകുലാ ഭവന്തി ഏതർഹി തേജോമയവസ്ത്രാന്വിതൗ ദ്വൗ പുരുഷൗ താസാം സമീപേ സമുപസ്ഥിതൗ</para>
  <para style="p">
    <verse number="5" style="v"/>തസ്മാത്താഃ ശങ്കായുക്താ ഭൂമാവധോമുഖ്യസ്യസ്ഥുഃ| തദാ തൗ താ ഊചതു ർമൃതാനാം മധ്യേ ജീവന്തം കുതോ മൃഗയഥ?</para>
  <para style="p">
    <verse number="6" style="v"/>സോത്ര നാസ്തി സ ഉദസ്ഥാത്|</para>
  <para style="p">
    <verse number="7" style="v"/>പാപിനാം കരേഷു സമർപിതേന ക്രുശേ ഹതേന ച മനുഷ്യപുത്രേണ തൃതീയദിവസേ ശ്മശാനാദുത്ഥാതവ്യമ് ഇതി കഥാം സ ഗലീലി തിഷ്ഠൻ യുഷ്മഭ്യം കഥിതവാൻ താം സ്മരത|</para>
  <para style="p">
    <verse number="8" style="v"/>തദാ തസ്യ സാ കഥാ താസാം മനഃസു ജാതാ|</para>
  <para style="p">
    <verse number="9" style="v"/>അനന്തരം ശ്മശാനാദ് ഗത്വാ താ ഏകാദശശിഷ്യാദിഭ്യഃ സർവ്വേഭ്യസ്താം വാർത്താം കഥയാമാസുഃ|</para>
  <para style="p">
    <verse number="10" style="v"/>മഗ്ദലീനീമരിയമ്, യോഹനാ, യാകൂബോ മാതാ മരിയമ് തദന്യാഃ സങ്ഗിന്യോ യോഷിതശ്ച പ്രേരിതേഭ്യ ഏതാഃ സർവ്വാ വാർത്താഃ കഥയാമാസുഃ</para>
  <para style="p">
    <verse number="11" style="v"/>കിന്തു താസാം കഥാമ് അനർഥകാഖ്യാനമാത്രം ബുദ്ധ്വാ കോപി ന പ്രത്യൈത്|</para>
  <para style="p">
    <verse number="12" style="v"/>തദാ പിതര ഉത്ഥായ ശ്മശാനാന്തികം ദധാവ, തത്ര ച പ്രഹ്വോ ഭൂത്വാ പാർശ്വൈകസ്ഥാപിതം കേവലം വസ്ത്രം ദദർശ; തസ്മാദാശ്ചര്യ്യം മന്യമാനോ യദഘടത തന്മനസി വിചാരയൻ പ്രതസ്ഥേ|</para>
  <para style="p">
    <verse number="13" style="v"/>തസ്മിന്നേവ ദിനേ ദ്വൗ ശിയ്യൗ യിരൂശാലമശ്ചതുഷ്ക്രോശാന്തരിതമ് ഇമ്മായുഗ്രാമം ഗച്ഛന്തൗ</para>
  <para style="p">
    <verse number="14" style="v"/>താസാം ഘടനാനാം കഥാമകഥയതാം</para>
  <para style="p">
    <verse number="15" style="v"/>തയോരാലാപവിചാരയോഃ കാലേ യീശുരാഗത്യ താഭ്യാം സഹ ജഗാമ</para>
  <para style="p">
    <verse number="16" style="v"/>കിന്തു യഥാ തൗ തം ന പരിചിനുതസ്തദർഥം തയോ ർദൃഷ്ടിഃ സംരുദ്ധാ|</para>
  <para style="p">
    <verse number="17" style="v"/>സ തൗ പൃഷ്ടവാൻ യുവാം വിഷണ്ണൗ കിം വിചാരയന്തൗ ഗച്ഛഥഃ?</para>
  <para style="p">
    <verse number="18" style="v"/>തതസ്തയോഃ ക്ലിയപാനാമാ പ്രത്യുവാച യിരൂശാലമപുരേഽധുനാ യാന്യഘടന്ത ത്വം കേവലവിദേശീ കിം തദ്വൃത്താന്തം ന ജാനാസി?</para>
  <para style="p">
    <verse number="19" style="v"/>സ പപ്രച്ഛ കാ ഘടനാഃ? തദാ തൗ വക്തുമാരേഭാതേ യീശുനാമാ യോ നാസരതീയോ ഭവിഷ്യദ്വാദീ ഈശ്വരസ്യ മാനുഷാണാഞ്ച സാക്ഷാത് വാക്യേ കർമ്മണി ച ശക്തിമാനാസീത്</para>
  <para style="p">
    <verse number="20" style="v"/>തമ് അസ്മാകം പ്രധാനയാജകാ വിചാരകാശ്ച കേനാപി പ്രകാരേണ ക്രുശേ വിദ്ധ്വാ തസ്യ പ്രാണാനനാശയൻ തദീയാ ഘടനാഃ;</para>
  <para style="p">
    <verse number="21" style="v"/>കിന്തു യ ഇസ്രായേലീയലോകാൻ ഉദ്ധാരയിഷ്യതി സ ഏവായമ് ഇത്യാശാസ്മാഭിഃ കൃതാ| തദ്യഥാ തഥാസ്തു തസ്യാ ഘടനായാ അദ്യ ദിനത്രയം ഗതം|</para>
  <para style="p">
    <verse number="22" style="v"/>അധികന്ത്വസ്മാകം സങ്ഗിനീനാം കിയത്സ്ത്രീണാം മുഖേഭ്യോഽസമ്ഭവവാക്യമിദം ശ്രുതം;</para>
  <para style="p">
    <verse number="23" style="v"/>താഃ പ്രത്യൂഷേ ശ്മശാനം ഗത്വാ തത്ര തസ്യ ദേഹമ് അപ്രാപ്യ വ്യാഘുട്യേത്വാ പ്രോക്തവത്യഃ സ്വർഗീസദൂതൗ ദൃഷ്ടാവസ്മാഭിസ്തൗ ചാവാദിഷ്ടാം സ ജീവിതവാൻ|</para>
  <para style="p">
    <verse number="24" style="v"/>തതോസ്മാകം കൈശ്ചിത് ശ്മശാനമഗമ്യത തേഽപി സ്ത്രീണാം വാക്യാനുരൂപം ദൃഷ്ടവന്തഃ കിന്തു തം നാപശ്യൻ|</para>
  <para style="p">
    <verse number="25" style="v"/>തദാ സ താവുവാച, ഹേ അബോധൗ ഹേ ഭവിഷ്യദ്വാദിഭിരുക്തവാക്യം പ്രത്യേതും വിലമ്ബമാനൗ;</para>
  <para style="p">
    <verse number="26" style="v"/>ഏതത്സർവ്വദുഃഖം ഭുക്ത്വാ സ്വഭൂതിപ്രാപ്തിഃ കിം ഖ്രീഷ്ടസ്യ ന ന്യായ്യാ?</para>
  <para style="p">
    <verse number="27" style="v"/>തതഃ സ മൂസാഗ്രന്ഥമാരഭ്യ സർവ്വഭവിഷ്യദ്വാദിനാം സർവ്വശാസ്ത്രേ സ്വസ്മിൻ ലിഖിതാഖ്യാനാഭിപ്രായം ബോധയാമാസ|</para>
  <para style="p">
    <verse number="28" style="v"/>അഥ ഗമ്യഗ്രാമാഭ്യർണം പ്രാപ്യ തേനാഗ്രേ ഗമനലക്ഷണേ ദർശിതേ</para>
  <para style="p">
    <verse number="29" style="v"/>തൗ സാധയിത്വാവദതാം സഹാവാഭ്യാം തിഷ്ഠ ദിനേ ഗതേ സതി രാത്രിരഭൂത്; തതഃ സ താഭ്യാം സാർദ്ധം സ്ഥാതും ഗൃഹം യയൗ|</para>
  <para style="p">
    <verse number="30" style="v"/>പശ്ചാദ്ഭോജനോപവേശകാലേ സ പൂപം ഗൃഹീത്വാ ഈശ്വരഗുണാൻ ജഗാദ തഞ്ച ഭംക്ത്വാ താഭ്യാം ദദൗ|</para>
  <para style="p">
    <verse number="31" style="v"/>തദാ തയോ ർദൃഷ്ടൗ പ്രസന്നായാം തം പ്രത്യഭിജ്ഞതുഃ കിന്തു സ തയോഃ സാക്ഷാദന്തർദധേ|</para>
  <para style="p">
    <verse number="32" style="v"/>തതസ്തൗ മിഥോഭിധാതുമ് ആരബ്ധവന്തൗ ഗമനകാലേ യദാ കഥാമകഥയത് ശാസ്ത്രാർഥഞ്ചബോധയത് തദാവയോ ർബുദ്ധിഃ കിം ന പ്രാജ്വലത്?</para>
  <para style="p">
    <verse number="33" style="v"/>തൗ തത്ക്ഷണാദുത്ഥായ യിരൂശാലമപുരം പ്രത്യായയതുഃ, തത്സ്ഥാനേ ശിഷ്യാണാമ് ഏകാദശാനാം സങ്ഗിനാഞ്ച ദർശനം ജാതം|</para>
  <para style="p">
    <verse number="34" style="v"/>തേ പ്രോചുഃ പ്രഭുരുദതിഷ്ഠദ് ഇതി സത്യം ശിമോനേ ദർശനമദാച്ച|</para>
  <para style="p">
    <verse number="35" style="v"/>തതഃ പഥഃ സർവ്വഘടനായാഃ പൂപഭഞ്ജനേന തത്പരിചയസ്യ ച സർവ്വവൃത്താന്തം തൗ വക്തുമാരേഭാതേ|</para>
  <para style="p">
    <verse number="36" style="v"/>ഇത്ഥം തേ പരസ്പരം വദന്തി തത്കാലേ യീശുഃ സ്വയം തേഷാം മധ്യ പ്രോത്ഥയ യുഷ്മാകം കല്യാണം ഭൂയാദ് ഇത്യുവാച,</para>
  <para style="p">
    <verse number="37" style="v"/>കിന്തു ഭൂതം പശ്യാമ ഇത്യനുമായ തേ സമുദ്വിവിജിരേ ത്രേഷുശ്ച|</para>
  <para style="p">
    <verse number="38" style="v"/>സ ഉവാച, കുതോ ദുഃഖിതാ ഭവഥ? യുഷ്മാകം മനഃസു സന്ദേഹ ഉദേതി ച കുതഃ?</para>
  <para style="p">
    <verse number="39" style="v"/>ഏഷോഹം, മമ കരൗ പശ്യത വരം സ്പൃഷ്ട്വാ പശ്യത, മമ യാദൃശാനി പശ്യഥ താദൃശാനി ഭൂതസ്യ മാംസാസ്ഥീനി ന സന്തി|</para>
  <para style="p">
    <verse number="40" style="v"/>ഇത്യുക്ത്വാ സ ഹസ്തപാദാൻ ദർശയാമാസ|</para>
  <para style="p">
    <verse number="41" style="v"/>തേഽസമ്ഭവം ജ്ഞാത്വാ സാനന്ദാ ന പ്രത്യയൻ| തതഃ സ താൻ പപ്രച്ഛ, അത്ര യുഷ്മാകം സമീപേ ഖാദ്യം കിഞ്ചിദസ്തി?</para>
  <para style="p">
    <verse number="42" style="v"/>തതസ്തേ കിയദ്ദഗ്ധമത്സ്യം മധു ച ദദുഃ</para>
  <para style="p">
    <verse number="43" style="v"/>സ തദാദായ തേഷാം സാക്ഷാദ് ബുഭുജേ</para>
  <para style="p">
    <verse number="44" style="v"/>കഥയാമാസ ച മൂസാവ്യവസ്ഥായാം ഭവിഷ്യദ്വാദിനാം ഗ്രന്ഥേഷു ഗീതപുസ്തകേ ച മയി യാനി സർവ്വാണി വചനാനി ലിഖിതാനി തദനുരൂപാണി ഘടിഷ്യന്തേ യുഷ്മാഭിഃ സാർദ്ധം സ്ഥിത്വാഹം യദേതദ്വാക്യമ് അവദം തദിദാനീം പ്രത്യക്ഷമഭൂത്|</para>
  <para style="p">
    <verse number="45" style="v"/>അഥ തേഭ്യഃ ശാസ്ത്രബോധാധികാരം ദത്വാവദത്,</para>
  <para style="p">
    <verse number="46" style="v"/>ഖ്രീഷ്ടേനേത്ഥം മൃതിയാതനാ ഭോക്തവ്യാ തൃതീയദിനേ ച ശ്മശാനാദുത്ഥാതവ്യഞ്ചേതി ലിപിരസ്തി;</para>
  <para style="p">
    <verse number="47" style="v"/>തന്നാമ്നാ യിരൂശാലമമാരഭ്യ സർവ്വദേശേ മനഃപരാവർത്തനസ്യ പാപമോചനസ്യ ച സുസംവാദഃ പ്രചാരയിതവ്യഃ,</para>
  <para style="p">
    <verse number="48" style="v"/>ഏഷു സർവ്വേഷു യൂയം സാക്ഷിണഃ|</para>
  <para style="p">
    <verse number="49" style="v"/>അപരഞ്ച പശ്യത പിത്രാ യത് പ്രതിജ്ഞാതം തത് പ്രേഷയിഷ്യാമി, അതഏവ യാവത്കാലം യൂയം സ്വർഗീയാം ശക്തിം ന പ്രാപ്സ്യഥ താവത്കാലം യിരൂശാലമ്നഗരേ തിഷ്ഠത|</para>
  <para style="p">
    <verse number="50" style="v"/>അഥ സ താൻ ബൈഥനീയാപര്യ്യന്തം നീത്വാ ഹസ്താവുത്തോല്യ ആശിഷ വക്തുമാരേഭേ</para>
  <para style="p">
    <verse number="51" style="v"/>ആശിഷം വദന്നേവ ച തേഭ്യഃ പൃഥഗ് ഭൂത്വാ സ്വർഗായ നീതോഽഭവത്|</para>
  <para style="p">
    <verse number="52" style="v"/>തദാ തേ തം ഭജമാനാ മഹാനന്ദേന യിരൂശാലമം പ്രത്യാജഗ്മുഃ|</para>
  <para style="p">
    <verse number="53" style="v"/>തതോ നിരന്തരം മന്ദിരേ തിഷ്ഠന്ത ഈശ്വരസ്യ പ്രശംസാം ധന്യവാദഞ്ച കർത്തമ് ആരേഭിരേ| ഇതി||</para>
</usx>
