<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Kalanga Bible Translation</book>
  <para style="ide">65001 - Unicode (UTF8)</para>
  <para style="h">BaRoma</para>
  <para style="toc1">Lukwalo gwemaRoma</para>
  <para style="toc2">BaRoma</para>
  <para style="toc3">BaR</para>
  <para style="mt2">Lukwalo gwaPhawuli ekwalila</para>
  <para style="mt1">BAROMA</para>
  <para style="imt">Tjinginiso</para>
  <para style="ip">
    <char style="bk">Lukwalo gwebaRoma</char> gungabe gwakakwagwa naMpositoli Phawuli hule kwemakole angaba makumi mahanu anamana kuyenda kumakumi mahanu ana hhanakadzi Khirisitu azwagwa. Phawuli waka esanhu akayenda kuRoma ndizo wakatumila lukwalo elaya Makhirisitu akuRoma, asimaJuta nemaJuta. Lukwalo igogu wakagukwala ali munzi-nkulu weKhorinte, paaka egala nayigogo lubaka. Phawuli wakakwala kuyetila kuti njudzi dzose dzigalemoyo kakale dzibe nemazwibhato kuna Yesu Khirisitu (BaRoma 16.26).</para>
  <para style="ip">
    <char style="bk">Lukwalo gwebaRoma,</char> lukwalo gunohingisiwa neMakhirisitu hango dzose nelubaka gose nentha yewhisisika kwetjenesa kwaPhawuli etjenesa nekwejidzo latingawana munaYesu Khirisitu. Mulukwalo igogu Phawuli unotondeka kuThesitamente Whulukugwi. Bazibi banjinji banoti tshinde lelukwalo igogu ivesi 1.16, inoti, “Ngobe andina honi nekweNdebo Mbuya. masimba eNdzimu etjidza nhu wose unogalamoyo; Njhuta kutanga, kukotebela Nghiriki.” Tjikamu tjekutanga tjelukwalo (BaRoma 1.1-12.21) tjakalingisana kwazo nelunamato, tjikamu tjebubili (BaRoma 13.1-15.33) tjinamilayo minjinji inobhatika yebutjilo gweTjikhirisitu.</para>
  <para style="iot">Nlongoloso Yezwimukati</para>
  <para style="io1">Phawuli unotangisa nezwitula neleba kuti unokwalila yani (BaRoma 1.1-15).</para>
  <para style="io1">Phawuli unokwala nekwetjimo tjenhu nekuti nhu angawamutjila tjini jidzo muna Yesu Khirisitu (BaRoma 1.16-11.36).</para>
  <para style="io1">Phawuli unopa milayo inolawula tjila kweMakhirisitu (BaRoma 12.1-15.13).</para>
  <para style="io1">Phawuli unofidza nelebelesa gubungano lekuRoma (16).</para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />Phawuli, nlanda waKhirisitu Yesu, wakatiwa mpositoli, kakale wakahaligwa sumikila Ndebo Mbuya yeNdzimu, <verse eid="ROM 1:1" /><verse number="2" style="v" sid="ROM 1:2" />yaakagadzabgwe ngebalebesambeli babe muwhalo dzakayengemala, <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />nekweNkololo uwe, Khirisitu Yesu He wedu, ngezwagwa kwenyama waka eli wen'umba yaDavida, <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />kakale ngeMeya yebuyengemali wakagadziwa ngesimba kuti abe Nkololo weNdzimu, nentha yemuka kubafi, iye Yesu Khirisitu He wedu. <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />Ngentha iye taka amutjila ngoni nebupositoli kuti kube nekuwhilila kwebugalimoyo munjudzi dzose, kuyetila gudzo lezina lile. <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />Pakati kwabo bo namwibo, makadan'wa kuti mube baYesu Khirisitu.<verse eid="ROM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />Kunayibo bose bamuRoma banodikala beNdzimu, bakadan'wa kuti babe baka yengemala.</para>
  <para style="p" vid="ROM 1:7">Ngoni nekunyalala kunobva kuNdzimu tate bedu naHe Yesu Khirisitu ngakube kumuli.<verse eid="ROM 1:7" /></para>
  <para style="s">Ntembezelo Weboka</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />Tjekutanga, ndomubokela kuNdzimu wangu muzina laYesu Khirisitu, ngobe galamoyo kwenyu kolebgwa muhango yose. <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />Ndzimu unsupi wangu, iye wandinonamata ngemeya yangu wose mukusumikila ndebo mbuya yeNkololo uwe, unoziba kuti ndogala ndimusa mumitembezelo yangu gose lubaka, <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />nditembezela ndikumbila kuti ngeludo gweNdzimu, hapa kuyetikala ndibhudilile hha ndiwhomukumba. <verse eid="ROM 1:10" /><verse number="11" style="v" sid="ROM 1:11" />Ngobe ndoyemula hangana namwi kudze ndimupe tjipo tjemeya tjinowhomusimisa. <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />Ndobva kuti, imwi nami tingakuludzilana, ngegalamoyo, umwe esimisiwa nekwewumwe, kwenyu ngekwangu.<verse eid="ROM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13" />Anditohaka kuti musizibe, hama dzangu, kuti ndandigala ndigwisa kuti ndihhe kumuli (koga ndandikon'wa kudza kunoti ngwenuwali), kudze ndiwane mitjelo mumuli, sekwandakawana mubamwe Bataya. <verse eid="ROM 1:13" /><verse number="14" style="v" sid="ROM 1:14" />Ndina nlandu kuMaGiriki nebasi MaGiriki, kuna bakatjenjela nezwilengwe. <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />Ndizo mukati kwangu ndoyemula kwazo kuti ndisumikile ndebo mbuya kumuli imwi mumuRoma.<verse eid="ROM 1:15" /></para>
  <para style="s">Masimba eNdebo Mbuya</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />Ngobe andina honi nekweNdebo Mbuya. Masimba eNdzimu etjidza nhu wose unogalamoyo; Njhuta kutanga, kukotebela Nghiriki. <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" /><note caller="-" style="x"><char style="xo" closed="false">1.17 </char><char style="xt" closed="false"><ref loc="HAB 2:4">Habh 2.4</ref>.</char></note>Lulama kunobva kuNdzimu kozumbunugwa mundebo mbuya, kubva mukugalamoyo koga, sekwakwaka kwagwa. “Bakalulama banowhotjila ngegalamoyo.”<verse eid="ROM 1:17" /></para>
  <para style="s">Kuzwipa Nlandu Kwebanhu</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />Ngobe buhongola gweNdzimu golakidziwa gubva kudzimu gugwisana nebasina bubuya nebakayipa banotshambidzila lebeswa ngebuyipi gwabo; <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />ngobe tjingazibgwa ngekweNdzimu tjipatjena kubali; ngobe Ndzimu wakabalakidza itjo. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />Kubvila pakuyetiwa kwehango tjimo tjeNdzimu tjesabonakala, simba lile lisingapele nebukulu gugwe gwakabonakala, kuwhisisika ngentha yemihingo iye, kuyetila kuti banhu basiwane tjabangadzeta natjo. <verse eid="ROM 1:20" /><verse number="21" style="v" sid="ROM 1:21" />Ngobe nekene bakaziba Ndzimu, abazotongowunkudza seNdzimu kakale abazotongowuboka, koga kumbula kwabo nemikumbulo yabo isina hanya yakabe nehhalima bakahaya kuwhisisa mumimoyo yabo. <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />Nekene baka bezwita bakatjenjela, bakaba zwilengwe, <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />kakale bakahandulila gudzo leNdzimu usingabole bakalifananisa nemifananidzo yebanhu banofa, neenyunywana, neezwibanda zwemakumbo mana neezwibanda zwinosoba.<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />Ndizo Ndzimu wakabaletjedzela mukutjiba kwemimoyo yabo muzwibi, belengudza mibili yabo pakati kwabo. <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />Bakahandulila lebeswa leNdzimu ndemanyepwa, kakale bakanamata bakahingila zwinhu zwakabumbiwa besiya Mbumbi iye wakafanila, wakakombolegwa nekusingapele! Akujalo.<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />Nentha yayikoku, Ndzimu wakabaletjedzela kunjemulo dzebupombgwe dzisina gudzo, ngobe betjikadzi babo bakasiya dana nebalume, bakathama kusi kwembumbiko. <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />Nebetjilume bo bakasiya dana nebetjikadzi ngekwembumbiko, baka tjiba bamwe balume. Balume beyeta zwiyeto nebamwe balume besina honi, baka amutjila mubali nlango ngekutjinya kwabo.<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />Pehhugwi kwayikoko, saku besakabona kuli kuhine kuti babvume Ndzimu, Ndzimu wakabaletjedzela kumikumbulo yakaleleka, kuti bathame zwisakalizanila yetiwa. <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />Balihhele bubi gose, kusalulama, tjiba, zwiyeto zwakayipa. Balihhele fupa, bubulayi, kakabadzana, tjengela, mikumbulo yakayipa, nebun'wa, <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />banyepi, babengi beNdzimu, bana masapa, banozwikudza, banozwiloba fuba, banobumba zila dzeyeta zwibi, basingawhilile bazwadzi, <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />basina kuwhisisa; banovuna zwilangano; basina ludo; basina mawhilangoni. <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />Nekene beziba nlayo weNdzimu, unoti ibabo banothama zwinhu zwakajalo tjakabalizanila whufa, abatongoyendila mbeli bethama zwinhu izwezwi koga, banobvumilana nebanozwithama.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s">Tonga kweNdzimu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />Ndizo, iwe nhu, awuna tjawungadzeta natjo, kene uli yani, hapa utonga bamwe; tjimwe netjimwe tjawunotongela bamwe, unozwitilika nlandu, ngobe iwe unotonga nothama bo zwinhu zwakajalo. <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />Ngwenu teziba kuti tonga kweNdzimu etonga ibabo banothama zwinhu zwakajalo kumulebeswa. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />Ndizo hapa iwe, nhu koga, ubatonga koga uthama zwinhu zwakajalo bo, unokumbula kuti tonga kweNdzimu unowhokudzeta? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />Kene unolingila pasi bukulu gwelulama kukwe, nemoyonlefu, nebigamoyo kukwe, amutoziba kuti lulama kweNdzimu ndekwekuti kumutungamilile kuti muhanduke? <verse eid="ROM 2:4" /><verse number="5" style="v" sid="ROM 2:5" />Koga nentha yewoma miholo kwenyu nemimoyo yenyu isingade handuka, mozwibutitikila buhongola muhhuba lebuhongola gweNdzimu, paanowholakidzila tonga kukwe kubuya. <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />Ndzimu “Unowhowamutjidza nhu nenhu kuyendidzana nehinga kukwe.” <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />Unowhopa butjilo gusingapele, ibabo bana moyonlefu banohaka gudzo nelukudzo nekusafa, ngethama zwinhu zwakanaka. <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />Koga kuna ibabo banozwikudza kakale belamba lebeswa betobela zila mbi, kowhoba nebuhongola nemon'wa. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />Kowhobe nebulemo nemanikana kunhu wose unothama zwakayipa, kutanga kuNjhuta, nekuNghiriki; <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />koga gudzo, lemekedzo nekunyalala kunhu wose unothama tjakanaka, kutanga kuNjhuta, kose nekuNghiriki. <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />Ngobe Ndzimu haatolakidza luhalawulo.<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />Bose banotjinya balikuhhe kwenlayo banowhopalala balikuhhe kwenlayo, bose banotjinya balipasi kwenlayo banowhotongwa ngenlayo. <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />Ngobe atayibo banowha nlayo bakalulama mbeli kweNdzimu, koga ndi ibabo banotobela nlayo banowholulamisiwa. <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />Ndizo, hapa Bataya, basina nlayo, bethama zwinhu zwimunlayo ngembumbiko, banlayo ngekwabo, nekene besina nlayo, <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />banolakidza kuti kunohakika ngenlayo kwakakwagwa mumimoyo yabo, hana dzabo dzili busupi bo, nemikumbulo yabo ibabvumila, kene ibadzibisa. <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />Ikoku kowhoyetikala hhuba Ndzimu laanowhotonga zwakasumbikika zwimumimoyo yebanhu ndaYesu Khirisitu, sekwakunolebgwa ngeNdebo Mbuya yandinosumikila.<verse eid="ROM 2:16" /></para>
  <para style="s">MaJuta neNlayo</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />Iwe, hapa uzwiti uNjhuta; wakasendama panlayo kakale uzwiloba fuba ngekwekudlidzana kuko neNdzimu; <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />hapa uziba ludo gugwe kakale ubvuma tjakanaka, ngobe utobela nlayo; <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />hapa unalebeswa kuti ndiwe unotungamila mapofu, utjedza kuna bamuhhalima, <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />unotambunudza zwilengwe, ndhiyi wezwitole, uhhele luzibo nelebeswa kunobva munlayo; <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />iwe ke, unodiya bamwe, awutozwidiya? Iwe unosumikila kuti usikwibe,<note caller="+" style="f"><char style="fr" closed="false">2.21 </char><char style="ft" closed="false">usiswade</char></note> iwe awutokwiba? <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />Iwe unoti banhu basite bupombgwe, iwe unothama bupombgwe? Iwe unohema midzimu yakabehhewa, unotjebela mathempeli? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />Iwe nozwiloba fuba nekwenlayo, koga nosakudza Ndzimu ngevuna nlayo? <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />Sekwakwaka kwagwa, “Ndzimu unotukwa neBataya ngentha iyo.”<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />Thumbigwa kuna tjilemela hapa utobela nlayo, koga hapa uvuna nlayo, thumbigwa kuko kohanduka kukaba sathumbigwa. <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />Hapa basaka thumbigwa bethama zwinohakiwa ngenlayo, abatowholingwa sebakathumbigwa? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />Usaka thumbigwa mumbili koga etobela nlayo unowhomuwana nlandu imwi, nekene muna lutjayo gwakakwagwa kakale makathumbigwa koga muvuna nlayo. <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />Njhuta wakwako ate Njhuta tjakuhhe, kakale thumbigwa kwelebeswa akuta kwakuhhe kwembili koga. <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />Nhu uNjhuta hapa kubvila mukati; kakale thumbigwa whuthumbigwa kwemoyo, kuli kweMeya, kusi ngenlayo wakakwagwa. Lumbidziwa kwewakajalo akutobva kubanhu, koga kobva kuNdzimu.<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />Ndigupi bubuya guyapo mukuba Njhuta, kene ndiwupi mbhayilo uyapo mukuthumbigwa? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />Nezila dzose! Kwekutanga whuti, wakagalabgwe maJuta ngekubapa n'hingo wemilayo yeNdzimu. <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />Hapa bamwe basingagalebgwe ke? Kusagalamoyo kwabo kungathama galikabgwe kweNdzimu kukasibe tjimwe? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />Akuzojalo! Ndzimu ngaabe lebeswa, nenhu wose abe nyepi. Sekwakwaka kwagwa.</para>
  <para style="q1" vid="ROM 3:4">“Kudze ubon'we kuti unalebeswa hapa ulebeleka;</para>
  <para style="q2" vid="ROM 3:4">kakale ukunde hapa utongwa.”<verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />Koga hapa bubi gwedu gulakidza lulama kweNdzimu, towhotini ngono? Ndzimu haazolulama hapa ehhisa buhongola gugwe pehhugwi kwedu? (Ndolebeleka senhu.) <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />Akuzojalo! Hapa kuli kuti kwaka kwakajalo, Ndzimu ungatonga hango tjini?<verse eid="ROM 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7" />Umwe ungati, “Hapa kuli kuti nyepa kwangu kothama lebeswa leNdzimu likawanda kukaba gudzo kuwunli, ngentha yeni ngono nditjawan'wa nlandu sentjinyi?” <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />Ngentha yeni tisingathame bubi kuyetila kuti tjibuya tjihhe? Sekwatinolebgwa zwakayipa nebamwe kuyi tojalo. Wanikwa nlandu kwabo kwakabalizana.<verse eid="ROM 3:8" /></para>
  <para style="s">Akuna Wakalulama</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />Totini ngono? Iswi maJuta tihine kupinda ibo? Aa, akuzojalo! Tatjitjenesa kale kuti maJuta neBataya bakafanana bose batjinyi. <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />Sekwakwaka kwagwa kuti.</para>
  <para style="q1" vid="ROM 3:10">“Akuna wakalulama, aa, kene iye un'ompela wose;<verse eid="ROM 3:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="ROM 3:11" />kene unowhisisa,</para>
  <para style="q2" vid="ROM 3:11">kene unohaka Ndzimu.<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />Bose bakapambuka bakayenda ntome,</para>
  <para style="q2" vid="ROM 3:12">bose banothama zwakaleleka;</para>
  <para style="q2" vid="ROM 3:12">akuna unothama tjakanaka, kene iye un'ompela.”<verse eid="ROM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />“Whulo dzabo dzizwikumbu zwakahama;</para>
  <para style="q2" vid="ROM 3:13">Milomo yabo ihhele tuka nematama akayipa.”</para>
  <para style="q2" vid="ROM 3:13">“Buhungu gwenyoka gumumilomo yabo.”<verse eid="ROM 3:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ROM 3:14" />“Milomo yabo ihhele tuka nehaya.”<verse eid="ROM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />“Makumbo abo, anolibilidzila tebula malopa,<verse eid="ROM 3:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16" />Paladza nebuyendasi kumubutjilo gwabo.<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />Zila yekunyalala abatoyiziba.”<verse eid="ROM 3:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18" />“Akuna unohla Ndzimu pabali.”<verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />Ngwenu teeziba kuti kene ini tjinolebgwa ngenlayo, tjolebegwa ibabo bapasi kwenlayo, kuyetila kuti wose nlomo utjemegwe nehango yose izwipe nlandu kuNdzimu. <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />Ndizo mukubona kweNdzimu, akuna nhu unowholulamisiwa ngetobela nlayo; koga, ngentha yenlayo toziba kuti jinyo ini.<verse eid="ROM 3:20" /></para>
  <para style="s">Tambunudziwa kwedu neNdzimu</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />Koga ngwenu ndulamo yeNdzimu yatjizumbunugwa, kuhhe kwenlayo, nekene nlayo upa busupi kose nebalebesambeli.<verse eid="ROM 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 3:22" />Ikoku lulama kunobva kuNdzimu kobva mukugalamoyo kuna Yesu Khirisitu kunayibo bose banogalabgwe. Akuzosiyana, <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />ngentha yekuti wose nhu wakatjinya, unotayila swikilila gudzo leNdzimu, <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />kakale unolulamisiwa mpho, ngengoni ndensununguko yakahha ndiKhirisitu Yesu. <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />Iye wakahhisiwa neNdzimu setjibhayilo tjebgwililulana, ngebugalimoyo mulopa lile. Wakakuthama ikoku elayidza lulama kukwe, nentha yekuti azolanga matjinyo akatiwa ntolo, <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />Ndzimu wakakuthama elayidza kuti mulubaka gwangwenuwali iye tjekukwe wakalulama nekuti unowunlulamisa iwhoyo unakugalabgwe munaYesu.<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />Kuponi, ngono, zwiloba fuba kwedu? Akutobagwa. Nentha yeni? Nentha yetobela nlayo? Aa, koga nentha yebugalimoyo. <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />Ngobe tobvuma kuti nhu unolulamisiwa ngegalamoyo, kusineni nethama mihingo inohakiwa nenlayo. <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />Ndzimu, uNdzimu wemaJuta koga? Haata Ndzimu weBataya bo? Ee, ndeweBataya bo, <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />saku kuna Ndzimu un'ompela, unowhobalulamisa ngebugalimoyo gwabo ibabo bakathumbigwa, nebasakathumbigwa, ngebugalimoyo gwabo bo. <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />Toyelaha nlayo ngono ngentha yegalamoyo? Aa akuzojalo! Towunsimisa.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s">Lulama kwa Abhurahhamu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />Towhotini ngono kuti Abhurahhamu, batategulugulu bedu, bakawanani, kuyendilana nezwinhu zwenyama? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />Hapa kuli kuti Abhurahhamu wakalulamisiwa ngentha yemihingo iye, waka engazwiloba fuba; koga kusi mbeli kweNdzimu. <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />Lukwalo gotini? Goti, “Abhurahhamu wakagalamoyo kuNdzimu, galamoyo kukwe kukabagwa selulama.” <verse eid="ROM 4:3" /><verse number="4" style="v" sid="ROM 4:4" />Ndizo hapa nhu ehinga, mbhayilo uwe awutobagwa setjipo tjengoni, koga unobagwa sefanilo. <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />Koga, kunhu usingahinge, koga egalamoyo kuna iye unolulamisa basina bubuya, bugalibgwe gugwe gobagwa selulama. <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />NaDavida unoleba bo nekwekombolegwa kwenhu Ndzimu waakabona lulama kukwe kusi ngentha yemihingo.<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />“Bakakombolegwa ndibabo bakayetigwa mazwibhatigwa tjinya kwabo,</para>
  <para style="q2" vid="ROM 4:7">nematjinyo abo akafukidziwa.<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />Wakakombolegwa iwhoyo nhu unajinyo lisingowhobagwa pehhugwi kukwe ndiHe.”<verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />Ikoku kombolegwa ndekwe bakathumbigwa boga, kene nebasakathumbigwa bo? Toti galabgwe kwa Abhurahhamu kwakabagwa selulama. <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />Kwakabagwa selulama lini, ngentha yeni? Waka atjithumbigwa, kene waka esanhu? Akuta kuli kuti waka atjithumbigwa, waka esanhu! <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />Wakawamutjila tjilakidzilo tjethumbigwa, lutjayo gwelulama gwaakabanago ngegalamoyo esakathumbigwa. Ndizo, ndiye tate bayibo bose bano galabgwe koga basakathumbigwa, kudza balulamisiwe. <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />Kakale ndiye tate webakathumbigwa, kusi thumbigwa koga, kakale beyenda munhambo dzegalamoyo dzakayendiwa natate bedu Abhurahhamu esakathumbigwa.<verse eid="ROM 4:12" /></para>
  <para style="s">Tjigadzabgwe tjeNdzimu Tjowamutjigwa ngeGalamoyo</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />Kwakakusi ngentha yenlayo kwakathama Abhurahhamu neludzi gugwe bawamutjile tjigadzabgwe kuti unowhoba nghalinhaka wehango, koga kwakakulingentha yelulama kunohha ngegalabgwe. <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />Hapa ibabo banotjila ngenlayo beli bagalinhaka, galabgwe akuna tjilemela, netjigadzabgwe atjina n'hingo, <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />ngobe nlayo unohhisa buhongola. Kakale hapa kusina nlayo akuna jinyo.<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />Ndizo kuli ngegalabgwe, kudze tjigadzabgwe tjibe mungoni kakale tjipiwe kuludzi gose gwaAbhurahhamu, kusi ibabo banotobela nlayo boga, koga nekuna ibabo bana kugalamoyo kwaAbhurahhamu, ngobe nditate bedu tose. <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />Sekwakwaka kwagwa, “Ndakuthama tate benjudzi njinji.” Nditate bedu mbeli kweNdzimu, muwunli waakagalabgwe, ndiNdzimu unomusa bakatjifa kakale unothama zwinhu zwisipo zwikabayapo. <verse eid="ROM 4:17" /><verse number="18" style="v" sid="ROM 4:18" />Ngegalabgwe koga kusina tjimwe, Abhurahhamu wakagalamoyo akabatate benjudzi njinji, sekwaakabudziwa, “Ndizo ludzi gugo gowhojalo.” <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />Haazotongoba nyolonyolo mukugalamoyo paakakumbula mbili uwe, iwo waka wefanana newakafa ngobe waka anamakole angaswika gulu, kene paakalinga <note caller="+" style="f"><char style="fr" closed="false">4.19 </char><char style="ft" closed="false">sabhata mimba kwewetjikadzi</char></note>haya mbeleko kwaSara. <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />Azotongonyanyayidza tjigadzabgwe tjeNdzimu, koga galamoyo kukwe kwakakula akapa gudzo kuNdzimu, <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />enalebeswa kuti Ndzimu unamasimba ethama tjaagadzabgwe. <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />Ndizo galamoyo kukwe “kwakabagwa selulama.” <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />Matama anoti, “kwakabaligwa kuwunli,” azokwaligwa iye yega, <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />akakwaligwa kose naswi bo, Ndzimu unowholulamisa iswi tinogalamoyo muwunli iye wakamusa Yesu He wedu kubafi, <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />wakabulawa ngentha yematjinyo edu, akamusiwa emusigwa lulamisiwa kwedu.<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s">Lulama kuNdzimu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />Sayikoku wali takatjilulamisiwa ngegalabgwe, tina kunyalala neNdzimu ndaHe wedu Yesu Khirisitu, <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />Muwunli takawana nkoba wengina mungoni dzatimile mudzili, tohanha mukugalabgwe kwedu kuti towhoba negobe mugudzo leNdzimu. <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />Kusi ikoko koga, kakale tohanha mukudziyidzika kwedu, ngobe toziba kuti dziyidzika kota ukaba nemoyonlefu; <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />moyolenfu, unota ukaba nemazwibhato, nemazwibhato anota ukaba nekugalabgwe. <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />Galabgwe akutotibhatisa honi, ngobe ludo gweNdzimu gwakaduliligwa mumimoyo yedu ngeMeya Yakayengemala, yaakatipa.<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />Nelubaka gwakatambunuka, tisina masimba, Khirisitu wakafila basina bubuya<note caller="+" style="f"><char style="fr" closed="false">5.6 </char><char style="ft" closed="false">basingahle Ndzimu</char></note>. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />Akuta kangana kuti nhu afile umwe nhu wakalulama, kene zwako umwe ungada zwe kuti afile nhu wakanaka. <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />Koga Ndzimu unotilayidza ludo gugwe nethama whoku. Titji batjinyi, Khirisitu wakatifila. <verse eid="ROM 5:8" /><verse number="9" style="v" sid="ROM 5:9" />Saku takatjilulamisiwa ngelopa laKhirisitu, unowhotjidziwa ngekungapani ke, mubuhongola gweNdzimu. <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />Saku nelubaka titjizwita zweNdzimu, takabgwililulanisiwa ndiye ngefa kweNkololo uwe, saku takabgwililulanisiwa, towhotjidziwa nekungapani ke ngebutjilo gugwe! <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />Atayiko koga, koga tohanha muNdzimu ndiHe wedu Yesu Khirisitu, iye wakata tikawamutjila bgwililulanisiwa kwedu.<verse eid="ROM 5:11" /></para>
  <para style="s">Adamu naKhirisitu</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />Sayikoku jinyo lakahha muhango ngentha yenhu un'ompela, lufu gwakangina ngentha yejinyo, ndizo nayiyeyi zila lufu gwakapalalila kunhu wose, ngobe wose nhu unajinyo. <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />Jinyo lakalitjila muhango nlayo waMozisi usanhu wabayapo, nekene watjibeyapo. Koga jinyo alizotongobagwa kusina nlayo. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />Koga ke, lufu gwakatonga kubvila mulubaka gwaAdamu kunoswika lubaka gwaMozisi, kose nekunayibabo basakatongotjinya nezila yetjinya kwaAdamu.</para>
  <para style="p" vid="ROM 5:14">Adamu waka ali tjilakidzilo tjayiwhoyo wake ewhohha. <verse eid="ROM 5:14" /><verse number="15" style="v" sid="ROM 5:15" />Koga jinyo netjipo tjengoni akuzofanana. Ngobe hapa kuli kuti ngetjinya kwenhu un'ompela banjinji bakafa, ngoni dzeNdzimu dzabenji, tjipo tjengoni tjinobuya nenhu un'ompela, iye Yesu Khirisitu, tjakahhala kubanji! <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />Kakale, tjipo tjempho atjina mbhudilo inonga tjinya kwenhu un'ompela; tongewa kwetjinya kwenhu un'ompela kwakahhisa longwa nlandu, koga tjipo tjempho tjakahha hule kwetjinya kwebanjinji kakale tjakalezi lulamisiwa. <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />Hapa kuli kuti, ngentha yejinyo lenhu un'ompela, lufu gwakatonga ngenhu iwhoyo, koga ke, ibabo banowhowamutjila ngoni njinji dzeNdzimu netjipo tjelulama banowhotonga kungapani mubutjilo ngentha yaYesu Khirisitu.<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />Sayikoku jinyo lewun'ompela lakahhisa lahiwa kwebanhu bose, ndizo ke yeta kwakalulama kwenhu un'ompela kwakahhisa sawan'wa nlandu nepa butjilo kubanhu bose. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />Saku sawhilila kwenhu un'ompela kwakata banhu banjinji bakaba batjinyi, ngentha yewhilila kwenhu un'ompela banhu banjinji banowholulamisiwa.<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />Nlayo wakahhisiwa kuyetila kuti jinyo lingawanda. Koga pakawanda jinyo ngoni dzakawanda kupindisisa, <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />kuyetila kuti sayikoku jinyo lakatonga mulufu, ngentha yaYesu Khirisitu He wedu ngoni bo dzitonge ngendulamo kuyetila kuti kube nebutjilo gusingapele.<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s">Takafa kuJinyo, Tibapenyu munaKhirisitu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />Towhotini ngono? Tiyendile mbeli tili mujinyo, kudza kuti ngoni dziwande? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />Akuzojalo! iswi takafa kujinyo; tingatjila tjini mulili kakale? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />Kene amutoziba kuti toseni takabvubikiwa muna Khirisitu Yesu takabvubikiwa mukufa kukwe? <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />Takabiganyiwa naye ngebvubikiwa mulufu, kuyetila kuti sayikoku Khirisitu akamusiwa kubafi ngesimba laTate, naswi bo titjile mubutshwa gwebupenyu.<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />Hapa kuli kuti takabhatshanyiwa naye mulufu gunonga gugwe, towhobhatana naye kakale mukumuka kukwe. <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />Ngobe toziba kuti mbumbiko yedu whulukugwi yakakowhomegwa naye, kuyetila kuti mbili wematjinyo upaladziwe, kudze tisibe balanda bejinyo, <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />ngobe kene yani watjifa watjisunungugwa mujinyo. <verse eid="ROM 6:7" /><verse number="8" style="v" sid="ROM 6:8" />Hapa kuli kuti takafa naKhirisitu, togalamoyo kuti towhotjila bo naye. <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />Ngobe tiziba kuti saku Khirisitu akamuka kubafi, haangapamhe akafa kakale; lufu agutjina masimba pehhugwi kukwe. <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />Lufu gwaakafa wakafa kujinyo kan'ompela, koga butjilo gwaanotjila unotjilila Ndzimu. <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />Ndizo ke, muzwibale sebakafa kujinyo koga banotjila kuNdzimu muna Khirisitu Yesu.<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />Ndizo ke musiletjedzele jinyo likalawula mibili yenyu inofa, limuta kuti muwhilile njemulo dzalo dzakayipa. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />Musipe nhango dzemibili yenyu kujinyo kuti dzihingisiwe kusakalulama, koga muzwipile kuNdzimu, sayibabo bakadusiwa mukufa bakahhisiwa mubupenyu, mupe nhango dzemibili yenyu kuNdzimu sezwihingiswa zwendulamo. <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />Ngobe jinyo alingabe nesimba pehhugwi kwenyu, saku musipasi kwenlayo, koga mulipasi kwengoni.<verse eid="ROM 6:14" /></para>
  <para style="s">Balanda beNdulamo</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />Ngono ke? Titjinye zwedu ngentha yekuti atita pasi kwenlayo koga tipasi kwengoni? Aa, akuzojalo! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />Amutoziba kuti hapa muzwita balanda banowhilila bewumwe nhu, mubalanda bayiwhoyo wamunowhilila. Mubalanda bejinyo, ilo linoyendesa nhu kulufu, kene mubalanda bewhilila, iko kunoyendesa kundulamo? <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />Koga toboka Ndzimu ngobe, nekene maka muli balanda bejinyo, makawhilila nemimoyo yenyu yose diyiwa kwamakawamutjila. <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />Matjisunungugwa mukutjinya mabe balanda bendulamo. <verse eid="ROM 6:18" /><verse number="19" style="v" sid="ROM 6:19" />Ndolebeleka ndebo iyeyi nezila yelebeleka kwebanhu, ngobe mubanyolonyolo mukutjila kwenyu. Ngezila yamakamupila mibili mukulawugwa nekusatjena nebubi gwakagukula, ngwenu ngayitjilawugwa nendulamo kudze muyengemale.<verse eid="ROM 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20" />Lubaka mutjibalanda bejinyo, maka makasununguka musingalawugwe ngendulamo. <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />Ndiwupi mbhayilo wamakawana muzwinhu zwamatjibe nehoni nazo? Kubupelo zwinhu izwezo zomukokela lufu! <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />Koga ngobe ngwenu matjisununguka mujinyo kakale matjibe balanda beNdzimu, mbhayilo wamunowana whuyengemala kwekuzwipila kuNdzimu, bhelelo lako ibutjilo gusingapele. <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />Ngobe mbhayilo wejinyo lufu, koga tjipo tjempho tjeNdzimu, butjilo gusingapele muna Khirisitu Yesu He wedu.<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s">Tjilakidzilo tjeBukwe</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />Amutoziba, hama dzangu-ngobe ndolebeleka kubanhu banoziba nlayo-kuti nlayo unasimba pehhugwi kwenhu hapa nhu atjimpenyu? <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />Konga sawhoku, mfumakadzi wakasungwa ngenlayo kunlume uwe hapa nlume etjimpenyu; koga hapa nlume uwe efa wasununguka munlayo wendobolo. <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />Ndizo, hapa elobogwa newumwe nhu, nlume uwe atjatjila, unoyi imhombwekadzi. Koga hapa nlume efa wasununguka munlayo iwhoyo atoba ali mhombwekadzi hapa elobogwa newumwe nlume. <verse eid="ROM 7:3" /><verse number="4" style="v" sid="ROM 7:4" />Sayikoku ke, hama dzangu, namwibo makafa kunlayo ngembili waKhirisitu, kuyetila kuti mube babe, iye wakamusiwa kubafi, kudze tibe nezwizwalo kuNdzimu. <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />Nelubaka titjatjila munyama, njemulo dzedu dzetjinya, dzimusiwa ngenlayo, dzakadzihinga mumibili yedu, kuyetila kuti mbhudilo kube lufu. <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />Koga ngwenu, tasunungugwa munlayo, nekuti takafa kuna kwaka kwakatitapa, kuyetila kuti tihinge tisi kusi kwenlayo wakakwagwa nkulukugwi koga tili mubutjilo gutshwa gweMeya.<verse eid="ROM 7:6" /></para>
  <para style="s">Nlayo neJinyo</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />Towhotini ngono? Nlayo ijinyo? Aa, akuzojalo! Lebeswa ndoba ndisakaziba kuti ini tjinya hapa kusina nlayo, ndoba ndisakaziba kuti tjiba ini hapa nlayo waka usati “Usitjibe.” <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />Koga tjinya, kwakawana nkoba munlayo, kukamusa zila dzose dzetjiba mundili. Ngobe kuhhe kwenlayo, jinyo lakafa. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />Ndakanditjila kuhhe kwenlayo gumwe lubaka; koga pakahha nlayo, jinyo lakamuka likaba bhenyu, imi ndikafa. <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />Ndakawana kuli kuti nlayo waka wakafanila hhisa bupenyu, kundili wakahhisa lufu. <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />Ngentha yekuti tjinya, pakwakawana nkoba munlayo, kwakanditjebela ngenlayo, kukandihhisila lufu.<verse eid="ROM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12" />Ndizo, nlayo wakayengemala, nendawulo yakayengemala, yakalulama kakale imbuya. <verse eid="ROM 7:12" /><verse number="13" style="v" sid="ROM 7:13" />Tjibuya, ngono, tjingabe tjakahhisa lufu kundili? Aa, akuzojalo! Koga kudza tjinya kuzibgwe sejinyo, kwakahhisa lufu mundili ngekwaka kuli kubuya, kuyetila kuti ngendawulo jinyo lingapindilila.<verse eid="ROM 7:13" /></para>
  <para style="s">Sawililana Kumutili</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />Toziba kuti nlayo umeya; koga imi ndiwenyama, ndakatengesewa kuba nlanda wejinyo. <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />Anditowhisisa tjandinothama. Tjandinoyemula thama anditotjithama, koga tjandinohema nditjo tjandinothama. <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />Hapa ndithama tjandisingahake thama, ndobvuma kuti nlayo umbuya. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />Ngono hapa kwakajalo, akutji imi ndinokuthama, kwabejinyo linogala mundili. <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />Ndoziba kuti akuna tjakanaka tjinogala mundili, mutjimo tjenyama. Ndoyemula thama tjakanaka, koga anditotubula. <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />Ngentha yekuti tjakanaka tjandinoyemula thama, anditotjithama, koga tjakayipa tjandisingahake thama nditjo tjandinothama. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />Andithama tjandisingahake thama, akutji imi ndinotjithama, koga ijinyo linogala mundili linokuthama.<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />Ndowana nlayo iwhoyu uhinga mundili. Nekutobe ndihaka thama tjakanaka, bubi guntome kwangu. <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />Mukati kwangu ndohanhila nlayo weNdzimu; <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />koga ndobona umwe nlayo munhango dzembili wangu, ugwisana nenlayo wenkumbulo wangu, kakale undithama ntapwa wenlayo wejinyo unohinga munhango dzembili wangu. <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />Ndakamanikana seni! Ndiyani unowhondiwangulila muna iwhoyu mbili welufu kene? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />Ngaabokewe Ndzimu muna Yesu Khirisitu He wedu!</para>
  <para style="p" vid="ROM 7:25">Ndizo ke, imi tjekwangu munkumbulo wangu ndohingila nlayo weNdzimu, koga ngenyama yangu ndohingila nlayo wejinyo.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s">Butjilo muMeya</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />Ndizo ke, akutjina wan'wa nlandu kwayibabo bamuna Khirisitu Yesu. (Basingayende ngekwenyama, banoyenda ngekwemeya.)<note caller="+" style="f"><char style="fr" closed="false">8.1 </char><char style="ft" closed="false">Akutapo muwhalo dzantolo dze tjiGiriki</char></note> <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />Ngobe nlayo weMeya yebutjilo muna Khirisitu Yesu wandisunungula munlayo wejinyo nelufu. <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />Ngobe Ndzimu wathama nlayo tjawakakon'wa thama, wakaba nyolonyolo ngentha yenyama. Wakatumila Nkololo uwe eli mutjimo tjenhu wejinyo, akapa nlandu kujinyo, <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />kuyetila kuti kose kunohakiwa nenlayo kuhhadzisiwe mutili, iswi tisingatjile butjilo gwenyama koga titjila ngekweMeya. <verse eid="ROM 8:4" /><verse number="5" style="v" sid="ROM 8:5" />Ibabo banotjila butjilo gwenyama mikumbulo yabo inokumbula kwenyama; koga ibabo banotjila ngekweMeya mikumbulo yabo inokumbula kweMeya. <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />Nkumbulo wenyama lufu, koga nkumbulo unolawugwa ngeMeya ubutjilo nekunyalala; <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />nkumbulo wenyama utjita kuNdzimu. Awutowhilila nlayo weNdzimu, lebeswa awungatange ukawuwhilila. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />Nayibabo banotjila butjilo gwenyama abangahanhise Ndzimu.<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />Imwi, amutotjila munyama, koga motjila muMeya, hapa Meya yeNdzimu inogala mumuli. Kene yani nayani usina Meya yaKhirisitu muwunli, haata ali nhu waKhirisitu.<verse eid="ROM 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 8:10" />Koga hapa Khirisitu alimukuli, mbili uwo wakafa ngentha yejinyo, koga meya imhenyu ngentha yendulamo. <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />Koga hapa meya iye iwhoyo wakamusa Yesu kubafi igala mumuli, iye wakamusa Khirisitu Yesu kubafi unowhopa kakale mibili yenyu yenyama butjilo ngeMeya iye, iyo inowhogala mumuli.<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />Ndizo, makamu angu, tina nlandu, koga kusi kunyama, kuti titjile sekunoda nyama. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />Ngobe hapa mutjila sekunohakiwa nenyama, mowhofa; koga hapa mungabulaya zwiyeto zwenyama ngeMeya, mowhotjila. <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />Ngobe bose banotungamigwa ngeMeya yeNdzimu, bana beNdzimu. <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />Ngobe amuzowamutjila meya yebulanda inomubgwiliza mukahla, koga makawamutjila meya yeba bana beNdzimu, kakale nayiyeyo Meya tolila titi, “Abha<note caller="+" style="f"><char style="fr" closed="false">8.15 </char><char style="ft" closed="false">kubva kuti Tate</char></note>, Tate.” <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />Meya ngekwayo inobvumilana nemeya yedu, kuti tibana beNdzimu. <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />Hapa kuli kuti tibana beNdzimu, tinghalinhaka, nghalinhaka dzeNdzimu kakale tinghalinhaka kan'ompela naKhirisitu, hapa kuli kuti ngelebeswa todziyidzika bo mukudziyidzika kukwe kuyetila kuti tikudziwe bo mugudzo lile.<verse eid="ROM 8:17" /></para>
  <para style="s">Gudzo Linowhohha</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />Ndobvuma dziyidzika kwedu kwemisi ino kuhomanana akungalizanyisiwe negudzo latinowhowamutjila. <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />Mbumbiko ngekuhanha, yakalindila zumbunugwa kwebakololo beNdzimu. <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />Ngobe mbumbiko yakapalaligwa netjimo tjayo, kusikuda kwayo, koga ngekuda kwayiwhoyo wakayipaladza, kwakalingiligwa <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />kuti mbumbiko tjekwayo inowhosunungugwa mubulanda gwekubola kakale inginisiwe mugudzo lelusununguko gwebana beNdzimu. <verse eid="ROM 8:21" /><verse number="22" style="v" sid="ROM 8:22" />Toziba kuti mbumbiko yose inogomela, inakugwadziwa (sewetjikadzi etshibama)<note caller="+" style="f"><char style="fr" closed="false">8.22 </char><char style="ft" closed="false">lizanyisiwa kwemagwadzo</char></note> kudza kuwhoswika ngwenuwali. <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />Akuta kuli mbumbiko yoga, koga iswi tjekwedu bo, tina mitjelo yekutanga yeMeya, togomela mukati takalindila yetiwa bakololo nesunungugwa kwemibili yedu. <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />Ngobe mukugalabgwe ikoku takatjidziwa. Koga galabgwe muna tjinoboneka akuta galabgwe. Ndiyani ungagalabgwe muna tjaatjibe natjo kale? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />Koga hapa tigalabgwe muna tjatisanhu tikabenatjo, totjilinda ngemoyonlefu.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />Sayikoku, Meya inotibhatsha mubunyolonyolo gwedu. Atitoziba kuti titembezeleleni, koga Meya tjekwayo inotibhatsha ngeliga dikahana kusingake kukalebgwa ngematama. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />Kakale iye unoholesesa mimoyo yedu unoziba nkumbulo weMeya, ngobe Meya inolebelekela bayengemali kuyendidzana nekuda kweNdzimu.<verse eid="ROM 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />Kakale toziba kuti muzwinhu zose Ndzimu unohinga kuti kunakile ibabo banoda Ndzimu, bakadan'wa kuyendidzana nendongoloso iye. <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />Ibabo baakaziba kutanga, wakabva abahala kuti babe netjiso tjeNkololo uwe, kuyetila kuti abe mbano yenkololo kubunji gwebagalimoyo. <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />Ibabo baakahala wakabadana; kakale ibabo baakahala wakabalulamisa; kakale ibabo baakalulamisa wakabakudza.<verse eid="ROM 8:30" /></para>
  <para style="s">Ludo gweNdzimu muna Khirisitu</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />Towhotini ngono, ngekwayikoku? Hapa Ndzimu alikuntha yedu, ndiyani ungagwisana naswi? <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />Iye usakagugutila Nkololo uwe, koga wakawumpila iswi tose, unokon'wa neni kuti panhu pan'ompela naye atipe zwinhu zose? <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />Ndiyani unowhotilika nlandu bakahagwa neNdzimu? Ndzimu ndiye nlulamisi webanhu. <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />Ndiyani unowana nlandu? NdiKhirisitu Yesu, iye wakatifila, pehhugwi kwayikoku wakamuka, ukuluboko gweludli gweNdzimu kakale unotilebelekela kuNdzimu. <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />Ini kunowhotipalalanya neludo gwaKhirisitu? Kungaba manikana, kene bulemo, kene dziyidziwa, kene hhala, kene yenda mbudlo, kene mbatsha, kene bhangatjeke? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />Sekwakwaka kwagwa,</para>
  <para style="q1" vid="ROM 8:36">“Ngentha yenyu tolingana nelufu hhuba lose;</para>
  <para style="q2" vid="ROM 8:36">tobagwa semhwizi dzakalinda bhayiwa.”<verse eid="ROM 8:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37" />Akuzojalo! Muzwinhu zose izwezwi takakunda kupinda kose kunda, tili muna iwhoya wakatida. <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />Ndinalebeswa kuti kene kuli lufu, kene butjilo, kene batumwa beNdzimu, kene batongi, kene zwinhu zwiyapo kene zwinohha, kene api masimba, <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />kene yenda pehhugwi, kene jitila pasi, kene tjipi tjakabumbiwa akungatithubukanye neludo gweNdzimu gumuna Khirisitu Yesu He wedu.<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s">Ndzimu Nebanhu Babe</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />Ndoleba lebeswa muna Khrisitu, anditonyepa, hana yangu inobvumilana nami muMeya Yakayengemala, <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />ndinabuyendasi gukulu newha zogwadza kusingapele mumoyo wangu. <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />Ngobe ndandingayemula kuti kadzene imi tjekwangu ndibe nebhiso kakale ndakathubukanyiwa naKhirisitu kuyetigwa ibabo bandina bukamu nabo gwenyama, ibabo beludzi gwangu. <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />Ibo banhu bekuIsirayeli, tjabo igudzo, nezwibvumilano, newamutjila nlayo, nenamata, nekugadziwabgwe neba bakololo. <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />Bobatategulugulu babo ndigo ludzi gunozwagwa Khirisitu ngekwenyama. Ndzimu upehhugwi kwayiko kose ngaalumbidziwe tjoselele! Ngekusingapele.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />Akuta kuli kuti dama leNdzimu lakalakon'wa. Akutayibo bose beludzi gwaIsirayeli maIsirayeli. <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />Kakale akutobva kuti bana ba Abhurahhamu, ngobe bali beludzi gwa Abhurahhamu. Koga Ndzimu wakati, “Bana babo ndebanowhozwagwa na Isaka.” <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />Nedzimwe zila, akuta bana ngekwenyama banoyi bana beNdzimu, koga ibana betjigadzabgwe banoyi ludzi. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />Ngobe tjigadzabgwe tjakalebgwa sawhoku, “Mulubaka igogu ndowhohanduka, Sara unowhoba nenkololo.”<verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />Kusi ikoku koga, nebana baRibheka bakabezwagwa natate ban'ompela, tate bedu Isaka. <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />Bana besanhu bazwagwa kene basanhu bathama tjinhu tjakanaka kene tjakayipa, kuyetila kuti n'hingo weNdzimu wehalula uyendilembeli, kusi ngezwiyeto koga kuli ngekuhalula kukwe, <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />wakabudziwa kuyi, “Whola unowhohingila ntjetjana.” <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />Sekwakwaka kwagwa kuyi, “Jakobe ndakawundha, Isawu ndakawumbenga.”<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />Towhotini ngono? Ndzimu una salulama? Aa akuzojalo! <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />Ngobe wakati kuna Mozisi, “Ndowhoba nemawhilangoni kuna wandinowhila ngoni, kakale ndowhoba nebuyendasi kuna iwhoyo wandinoda ba nebuyendasi kuwunli.” <verse eid="ROM 9:15" /><verse number="16" style="v" sid="ROM 9:16" />Ndizo akutobva mukuyemula kene mumatatabuko enhu, koga kobva muba nengoni kweNdzimu. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />Ngobe lukwalo goti kuna Faro, “Ndakakumilidza, ndikumilidzila kulakidza simba langu mukuli, kuyetila kuti zina langu likudziwe hango yose.” <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />Ndizo Ndzimu unoba nemawhilangoni kuna iwhoyo waanoda whila ngoni, kakale unota akaba nkukutu iwhoyo waanoda kuti abe nkukutu.<verse eid="ROM 9:18" /></para>
  <para style="s">Buhongola gweNdzimu Nemawhilangoni awe</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />Umwe wenyu unowhoti kundili, “Ngentha yeni Ndzimu etjatiwana nlandu? Ngobe ndiyani ungagwisana neludo gugwe?” <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />Iwe nhu! ndiwe yani, ungadza ukahandudzana neNdzimu? Tjakabumbiwa tjingati kumbumbi watjo, “Wakandibumbilani ujali kene?” <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />Mbumbi wehali haana masimba pehhugwi kwentapwe iwo zwawo webumba zwidla zwelayidza bunyambi zwinohinga hapa kuna mihingo ipehhugwi nezwinohingisiwa misi yose?<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />Kungayin'wi, hapa Ndzimu akada layidza buhongola gugwe nekuti simba lile lizibgwe, koga akaba nemoyonlefu kuna ibabo baakagwadziligwa, bakayetigwa kuti bapaladziwe? <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />Kungayin'wi hapa akakuthama ikoku etila kuti bukulu gwegudzo lile guzibgwe nayibabo baanamawhilangoni kubali, ibo baakagala athama ebathamila gudzo, <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />kene iswibo, baakadana, kusi kumaJuta boga, koga kose nekuBataya? <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />Sekwaanoleba mulukwalo gwaWhosiya, eti,</para>
  <para style="q1" vid="ROM 9:25">“Baka basi banhu bangu</para>
  <para style="q2" vid="ROM 9:25">ndowhobadana nditi ‘Banhu bangu.’</para>
  <para style="q1" vid="ROM 9:25">Newaka esingadiwe</para>
  <para style="q2" vid="ROM 9:25">ndowundhana nditi ‘Ndhikani wangu.’ ”<verse eid="ROM 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ROM 9:26" />“Kakale muna igogo bugalo kwakakwayi ‘Amutabanhu bangu,’</para>
  <para style="q2" vid="ROM 9:26">ibabo banhu banowhodan'wa beyi ‘Bakololo beNdzimu mpenyu.’ ”<verse eid="ROM 9:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ROM 9:27" />Isaya unolila kwazo ngekwaIsirayeli. “Kene zwako bunjinji gwemaIsirayeli gunga gwensetje wegungwa, ibabo bahomanana bakasala ndibo boga banowhotjidziwa. <verse eid="ROM 9:27" /><verse number="28" style="v" sid="ROM 9:28" />Ngobe He unowhohinga, nekulibilidza kakale nebuhhalo, n'hingo uwe wetonga hango.” <verse eid="ROM 9:28" /><verse number="29" style="v" sid="ROM 9:29" />Konga sekwakalebgwa na Isaya hule eti, “Kadzene He wemasimba asakatisiyila ibabo bahomanana batjakabhatilila kuwunli, toba takaba seSodoma, kakale toba takayetiwa seGomora.”<verse eid="ROM 9:29" /></para>
  <para style="s">Isirayeli neNdebo Mbuya</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />Towhotini ngono? Bataya bakaba besingahakisise ndulamo, batjiyiwamutjila ndulamo ngekugalamoyo; <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />koga Isirayeli iye waka ehakisisa ndulamo ngenlayo, haazobhudilila mukuhhadzisa nlayo iwhoyo. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />Ngentha yeni? Ngobe abazoyihakisisa ngekugalamoyo, koga bakabe beyihakisisa ngemihingo. Bakakunhiwa nebgwe linokunha. <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />Sekwakwaka kwagwa kuyi.</para>
  <para style="q1" vid="ROM 9:33">“Bonani, ndobiga muZiyoni bgwe</para>
  <para style="q2" vid="ROM 9:33">linowhokunha banhu,</para>
  <para style="q2" vid="ROM 9:33">hongwe inowhobaliga,</para>
  <para style="q1" vid="ROM 9:33">iye unogalamoyo muwunli atowhobhatisiwa honi.”<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />Makamu, ndoyemula mumoyo wangu kakale nditembezela kuNdzimu kuti maIsirayeli atjidziwe. <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />Ndingapa busupi ngekwabo kuti banobilayela kwazo nekweNdzimu, koga bilayela kwabo akuna luzibo. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />Ngobe abatoziba ndulamo yeNdzimu, bakada bhatilila mukukumbula kwabo, abazozwisa pasi kwendulamo yeNdzimu. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />Khirisitu ndiye bupelo gwenlayo, kuyetila kuti wose unogalamoyo alulamisiwe.<verse eid="ROM 10:4" /></para>
  <para style="s">Tjidziwa Ndekwebanhu Bose</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />Mozisi wakakwala kuti nhu unolondolodza ndulamo inobva munlayo, unowhotjila ndiyo. <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />Koga ndulamo inobva mukugalamoyo inoti. Usiti mumoyo uwo, “Ndiyani unowhoyenda pehhugwi kudzimu?” (kubviwa kuti ejetusa Khirisitu pasi) <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />kene “Ndiyani unowhongina pasi mugomba?<note caller="+" style="f"><char style="fr" closed="false">10.7 </char><char style="ft" closed="false">gomba linoyi Abhisi lojita linoswika kubafi</char></note>” (kubviwa kuti enomusa Khirisitu kubafi). <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />Koga kobva kutini? Kobva kuti, “Dama lipedlo nawe; limunlomo uwo kakale limumoyo uwo,” ndilo dama lebugalimoyo latinosumikila. <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />Hapa ubvuma nenlomo uwo uti, “Yesu ndiHe,” ugalamoyo mumoyo uwo kuti Ndzimu wakawumusa kubafi, nowhotjidziwa. <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />Ngobe nemoyo uwo nogalamoyo ukalulamisiwa, unobvuma nenlomo uwo ukatjidziwa. <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />Sewhalo dziti, “Kene yani unogalamoyo muwunli atowhobhatisiwa honi.” <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />Njhuta azosiyana neNghiriki, ngobe He iyezwe, ndiye He wayibo bose, kakale unokombolela bose banodana zina lile, <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />ngekuti, “Wose nhu unodana zina laHe unowhotjidziwa.”<verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />Bangawundhana tjini wabasakagalamoyo muwunli ngono? Kakale bangagalamoyo tjini muwunli besakatongowha nekukwe? Kakale bangawha tjini kusina nsumikili? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />Kakale bangasumikila tjini besatumwa? Sekwakwaka kwagwa kuyi, “Akanaka seni makumbo ayibabo banosumikila ndebo mbuya!” <verse eid="ROM 10:15" /><verse number="16" style="v" sid="ROM 10:16" />Koga akuta ibo bose bakawhilila ndebo mbuya. Ngekuti Isaya unoti, “He, ndiyani wakagalamoyo muna tjatakaleba?” <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />Ndizo galamoyo kobva muna tjawawha, tjawawha tjobva mukusumikigwa kwedama laKhirisitu.<verse eid="ROM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 10:18" />Koga ndobhuzwa, abazowha kene? Ee lebeswa, bakawha tjose; ngobe</para>
  <para style="q1" vid="ROM 10:18">“Whi labo lakatjihhala muhango yose,</para>
  <para style="q2" vid="ROM 10:18">matama abo akatjiswika kubupelo gwehango.”<verse eid="ROM 10:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />Ndobhuzwa kakale, Isirayeli azoziba kene? Kutanga Mozisi unoti,</para>
  <para style="q1" vid="ROM 10:19">“Ndowhomuta mukaba nefupa</para>
  <para style="q2" vid="ROM 10:19">kuna ibabo basitjaba;</para>
  <para style="q1" vid="ROM 10:19">ndowhohingisa tjaba tjina bulengwe</para>
  <para style="q2" vid="ROM 10:19">ndikamuta kuti mumon'we.”<verse eid="ROM 10:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />Isaya wakaleba akasima eti,</para>
  <para style="q1" vid="ROM 10:20">“Ndakawan'wa nayibabo basakandihaka;</para>
  <para style="q2" vid="ROM 10:20">Ndakazwilakidza kuna ibabo basakabhuzwa nekwangu.”<verse eid="ROM 10:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21" />Koga nekwaIsirayeli Isaya unoti, “Hhuba lose ndahwa ndatambunudzila maboko angu kubanhu basingawhe kakale banonyanyayidza.”<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s">Mawhilangoni eNdzimu kuIsirayeli</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />Ndokotjibhuzwa nditi, “Ndzimu wakalaha banhu babe?” Aa akuzojalo! Imi tjekwangu ndi Isirayeli, ndiweludzi gwaAbhurahhamu, ndiwen'umba yaBhenjamini. <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />Ndzimu haazobalaha banhu babe, ibo baakagala aziba kubvila kutanga. Amutoziba kuti lukwalo gotini nekwetjikumbilo tjaElija kuNdzimu, kuti Ndzimu abone Isirayeli nlandu? Goti. <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />“He, batjibulaya balebesambeli benyu, batjikolomola zwibeso zwepisila zwibhayilo; ndimi ndoga ndasala, ngono banovima butjilo gwangu bo.” <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />Ndzimu wakawun'handula etini? Wakati, “Ndazwibiganyidzila banhu balizwiwulu zwili kutondeka basanhu bakatongopfigamila Bhali<note caller="+" style="f"><char style="fr" closed="false">11.4 </char><char style="ft" closed="false">ndzimu wemanyepwa </char></note>.” <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />Ndizo ke, nangwenuwali bayapo batjakabhatilila kuNdzimu ngentha yehagwa ngengoni. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />Hapa kuli kuti kungengoni, akutji ngemihingo (ngobe ngoni dzobe dzisitji ngoni). Koga hapa kuli kuti kungemihingo, akutji ngengoni; ngobe ngoni dzobe dzisitji ngoni.<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />Kobva kutini ngono? Kobva kuti, banhu beIsirayeli bakakon'wa wana tjabaka behaka, koga bahalugwa bakatjiwana. Bamwe bose bakayetiwa bakabe bakukutu. <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />Sekwakwaka kwagwa kuti, “Ndzimu wakabapa meya yetshumwayela, meho ekuti basibone nezebe dzekuti basiwhe kudza kuwhoswika hhuba lanasi.” <verse eid="ROM 11:8" /><verse number="9" style="v" sid="ROM 11:9" />Kose naDavida unoti,</para>
  <para style="q1" vid="ROM 11:9">“Zodliwa zwabo ngazwibe bulimbo nedati kubali,</para>
  <para style="q2" vid="ROM 11:9">zwibe zwinobaliga kakale zwibe nlango wabo.<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />Meho abo ngaabe nebupofu kuyetila kuti basibone,</para>
  <para style="q2" vid="ROM 11:10">kakale nhunji dzabo ngadzikondame<note caller="+" style="f"><char style="fr" closed="false">11.10 </char><char style="ft" closed="false">babe mubulemo</char></note> tjoselele.”<verse eid="ROM 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />Ndizo ndobhuzwa, bakakunhiwa kuyetila kuti bawe? Aa akuzojalo! Koga ngentha yetjinya kwabo, tjidziwa kwakahha kuBataya kuyetila kuti maIsirayeli abe nefupa. <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />Hapa tjinya kwabo kuli fumwa yehango, nekon'wa kwabo kuli fumwa kuBataya, ngono bgwiliziwa kwabo bose kowhohhisa fumwa ingapani!<verse eid="ROM 11:12" /></para>
  <para style="s">Tjidziwa kweBataya</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />Ndolebeleka namwi imwi Bataya, sangwenu ndili mpositoli kuBataya, ndokudza n'hingo wangu kwazo, <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />kuyetila kuti ndilonge banhu beludzi gwangu fupa, ndizo kuti bamwe babo batjidziwe. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />Ngobe hapa lahiwa kwabo kuli lulamisiwa kwehango, wamutjigwa kwabo kowhobani hapa kusi tjila kwebafi!<verse eid="ROM 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 11:16" />Hapa bhemu letjinkwa linodusiwa setjipo tjekutanga lakayengemala, kubva kuti tjinkwa tjose tjakayengemala; hapa ndzi wenti wakayengemala, nenhabi bo dzakayengemala. <verse eid="ROM 11:16" /><verse number="17" style="v" sid="ROM 11:17" />Hapa dzimwe nhabi dzakathubugwa, iwe, lutabi gwenti wentoba wemuhango, watjimedzekewa muwunli, watjibe negobe bo muntubgwi unobva mundzi wenti wentoba iwhoyo, <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />usizwikudze sewunopinda dzimwe nhabi. Hapa uthama ujalo, kumbula whoku; akuta iwe wakasenga ndzi koga ndzi ndiwo wakasenga iwe.<verse eid="ROM 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 11:19" />Nokotjileba uti, “Nhabi dzakathubugwa kuyetila kuti ndimedzekewe.” <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />Ilebeswa, bakathubugwa nentha yesagalamoyo, iwe sima ngegalamoyo. Usizwikudze; koga, iba nekuhla. <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />Ngobe hapa Ndzimu esakaletjedzela nhabi dzakazwimelela munti, nawebo atowhokuletjedzela. <verse eid="ROM 11:21" /><verse number="22" style="v" sid="ROM 11:22" />Tjibona ke ngoni nebuhongola, kweNdzimu. Unabuhongola kuna ibabo bakatjinya; koga Ndzimu unangoni kukuli hapa uyendilambeli uli mungoni dzidze, kuhhe kwayikoku nowhothubugwa bo. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />Kose nayibabo, hapa bengasiyana nesagalamoyo banowhomedzekewa, ngobe Ndzimu unotubula bamedzeka kakale. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />Hapa kuli kuti wakavun'wa pantoba wemuhango, uli ntoba wehango ngembumbiko, ukawhomedzekewa muntoba wakadzwagwa, kunopesana nembumbiko, kowhobe kulelu kungapani kuti idzedzi nhabi dzentoba dzimedzekewe muna mayi kene?<verse eid="ROM 11:24" /></para>
  <para style="s">Ngoni dzeNdzimu Kubanhu Bose</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />Ngobe anditoyemula kuti musizibe, makamu angu, ndohaka kuti muwhisise yetji tjamamusingazibe, kuyetila kuti musizwibone sebakatjenjela, bukukutu igogu gwatjiswikila amwe maIsirayeli, kudza kunoswika nhambo yekuti Bataya bakapelela batjidziwe. <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />Ndizo Isirayeli wose unowhotjidziwa; sekwakwaka kwagwa kuti,</para>
  <para style="q1" vid="ROM 11:26">“MuZiyoni kowhobva Nsununguli;</para>
  <para style="q2" vid="ROM 11:26">unowhodusa bubi gose muna Jakobe.<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />Itjetji nditjo tjibvumilano tjangu nabo,</para>
  <para style="q2" vid="ROM 11:27">hapa ndedusa matjinyo abo.”<verse eid="ROM 11:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="ROM 11:28" />Ngekwendebo mbuya, bazwita zweNdzimu, kuyetila imwi; koga ngekwehalulo, badikani, ngentha yabobatategulu babo. <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />Ngobe zwipo zweNdzimu azwitohanduka nedana kweNdzimu akutohanduka. <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />Sekwamakatongobe musingawhilile Ndzimu, koga ngwenu matjiwamutjila mawhilangoni ngentha yesawhilila kwabo, <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />kakale abatjawhilila Ndzimu, kuyetila kuti ibo bo bawhigwe ngoni kuli ngentha yemawhilangoni amakawamutjila. <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />Ndzimu wakata banhu bose basungwa bekusawhilila, kuyetila kuti abe nemawhilangoni kuna ibo bose.<verse eid="ROM 11:32" /></para>
  <para style="s">Ndzimu Ngaalumbidziwe</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />Ekee bukulu gwebutjenjebvu neluzibo gweNdzimu! Ekee sumbikala kwetonga kukwe, nesalondeka kwezila dzidze! <verse eid="ROM 11:33" /><verse number="34" style="v" sid="ROM 11:34" />Selukwalo guti,</para>
  <para style="q1" vid="ROM 11:34">“Ndiyani ungaziba nkumbulo waHe?</para>
  <para style="q2" vid="ROM 11:34">Kene ndiyani ungaba nkumbuludzi uwe?<verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />Kene ndiyani wakatongopa Ndzimu tjipo,</para>
  <para style="q2" vid="ROM 11:35">etila kuti Ndzimu ekowumbgwiliza?”<verse eid="ROM 11:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ROM 11:36" />Ngobe kose kobva kuwunli, kungentha iye, kakale kukuwunli. Ngaakudziwe tjoselele. Ngekusingapele kose Akujalo.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s">Butjilo Mun'hingo weNdzimu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />Ndizo ndomukumbila, makamu angu, ngemawhilangoni eNdzimu, kuti mupile mibili yenyu ibe tjibhayilo tjinotjila, tjakayengemala kakale tjinowamutjilika kuNdzimu, kunoba kuli iko namata kwelebeswa kwakatambunuka. <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />Musibe nezwiyeto zwayiyeyi ino hango, koga ngebumbiwa butshwa kwemikumbulo yenyu muhanduke mube nembumbiko ndzwa. Kuyetila kuti mutubule holesesa nelakidza tjinoba tjili kuda kweNdzimu, kubuya kakale kunowamutjilika kakale kwakapelela.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />Ngengoni dzandakapiwa ndoti kuwumwe newumwe upakati kwenyu, usizwise pehhugwi kupinda kwawuli iko; koga ukumbule, zwakalizanilana nebugalimoyo Ndzimu gwaakupa. <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />Ngobe sayikoku mbili un'ompela una ndungululo njinji, akuta kuli kuti dzose ndungululo dzina n'hingo iwo zwawo, <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />iswi bo, tili banjinji, timbili un'ompela muna Khirisitu, koga tili ndungululo dzakasiyana. <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />Tina zwipo zwatakapiwa ngengoni, zwakasiyana. Hapa kuli bulebesambeli, ayiguhingiseni kuyendidzana nebugalimoyo gwedu; <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />hapa kuli hinga, ngatihingeni; hapa kuli diya, ngatidiyeni; <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />hapa kuli kuludzila, ngaakuludzile; unopa, ngaape akahalabvuka; ntungamili, ngaatungamile ngezwipila; unowhila ngoni, ngaakuthame nekuhanha.<verse eid="ROM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />Ludo ngagupelele ngelebeswa, bengani tjakayipa; mubhatilile kuna tjakalulama. <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />Mudane ngeludo gwehama, kudzani bamwe kupinda zwikudza imwi. <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />Musibe simbe koga hingani nekuzwipila, mupisike mumeya, muhingile He. <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />Hanhani mukugalabgwe, ibani nemoyonlefu mukudziyidziwa, mutembezele tjoselele. <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />Wahhani bayengemali; muzwipile tjengeta bezi.<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />Kumbilani Ndzimu akombolele ibabo banomuvima; kumbilani kombolela kusi tuka. <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />Hanhani nebanohanha, mulile nebanolila. <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />Galisanani nekuwhanana nebamwe; musizwikudze, koga whananani nebanozwininipisa; musizwibone butjenjebvu.<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />Musibgwilizile tjakayipa netjakayipa, koga lemekedzani tjinoboneka tjili tjibuya kuna ibo bose. <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />Yetani kose kumumatatabuko enyu kuti mugalisane nekunyalala nebanhu bose. <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />Badikani, musibgwilizile imwi, koga mukusiyile kubuhongola gweNdzimu; ngobe kwaka kwagwa kuti “Bgwilizila ndekwangu, ndowhobgwilizila,” kujalo He. <verse eid="ROM 12:19" /><verse number="20" style="v" sid="ROM 12:20" />Koga, “Hapa tjita tjenyu tjina hhala, mutjipe zodliwa; hapa tjina nyota, mutjin'wise; ngobe ngeyeta mujalo mowhotjibutitikila masimbe emoto mun'holo.” <verse eid="ROM 12:20" /><verse number="21" style="v" sid="ROM 12:21" />Musikundiwe netjakayipa, koga kundani tjakayipa ngetjakanaka.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s">Zwisa pasi kuButungamili gweTjaba</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />Wose nhu ngaabe pasi kwesimba lebutungamili gupehhugwi kukwe, ngobe akuna butungamili kuhhe kwegunobva kuNdzimu; kakale igogo guyapo gwakahagwa ndiNdzimu. <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />Ndizo ke, kene yani unomilana nebutungamili, unomilana netjakahagwa ndiNdzimu, kakale ibabo banomilana nago banowhotongewa. <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />Ngobe batungamili abatohlisa kubakalulama, banohlisa kuna banothama zwakayipa. Ngono awusingahake hla butungamili thama tjakalulama, gowhokulumbidza, <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />ngobe ntungamili un'hingi weNdzimu unohingila kuti kukululamile. Koga hapa uthama tjakayipa, ihla; ngobe simba lelanga lebutungamili lohinga; ngobe gun'hingi weNdzimu, unolanga batjinyi. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />Ndizo umwe newumwe wakafanila ba pasi kwenlayo, kusi ngentha yekuti angalangiwa koga, koga nangentha yehana.<verse eid="ROM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6" />Ndizo nentha yayikoku lipani luketo; ngobe batungamili bahingi beNdzimu, banohinga n'hingo wabo lubaka gose. <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />Lipani kose kwakafanila lipiwa, lipani luketo kubaketisi, ibani nemazwibhato kuna ibabo bamubugalo gweyetigwa mazwibhato, lemekedzani ibabo bamubugalo gwelemekedzewa.<verse eid="ROM 13:7" /></para>
  <para style="s">Zwakafanila Yetiwa Wumwe Kuwumwe</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />Musibe nenlandu kuwumwe nhu, kuhhe kwekuti makafanila ba neludo umwe kuwumwe; ngobe iye unoda umwe wahhadzisa nlayo. <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />Milayo inoti, “Usite bupombgwe; Usibulaye; Usiswade<note caller="+" style="f"><char style="fr" closed="false">13.9 </char><char style="ft" closed="false">usikhwibe</char></note>; Usitjibe,” nekene wupi umwe nlayo, yakahanganyiwa mudama yeli, “Ida mbakidzani uwo nezila yawunozwida ndiyo.” <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />Ludo agutota tjakayipa kumbakidzani; ndizo ke, da whuhhadzisa nlayo.<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />Mukuthameni ikoku, muziba kuti kwatjibe gupi lubaka, kwatjibe lubaka gwekuti mumuke muwhope, ngobe tjidziwa kwatjibe pedlo naswi ngwenu kupinda titanga galamoyo; <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />busiku gweepela, tjedza tjabepedlo, atitjisiyani ke mihingo yemuhhalima, timbale zwiyambalo zwengwa zwetjedza; <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />ayitjileni nezila yakatambunuka, sebanhu banotjila masikati; kusina hanhisa mibili kose nelaladza, kusina bupombgwe nesazwibhata, kusina kakabadzana kose nefupa. <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />Mbalani He Yesu Khirisitu, musibvumile mbili ukayeta njemulo dzawo.<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s">Musibone Bamwe Nlandu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />Wamutjilani nhu usakasima mukugalamoyo, musi kakabadzane naye nekwekumbula kukwe. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />Umwe nhu unogalamoyo kuti angadla tjimwe netjimwe, koga nhu unyolonyolo mukugalamoyo unodla milibo koga. <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />Iwhoyo unodla asilingile pasi usingadle, nayiwhoyo usingadle asibone nlandu unodla; ngobe Ndzimu wawuwamutjila. <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />Uyani iwe kuti ungabona nlandu nlanda wewumwe? Ndimbeli kwaBatezi babe koga kwaangama kene kwaangawa. Unowhoma; ngobe Batezi banamasimba ekuti ame.<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />Umwe unokudza hhuba lin'ompela kupinda amwe mahhuba, koga kuwumwe ose mahhuba akalizana. Umwe newumwe ngaagutshikane munkumbulo uwe. <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />Iwhoyo unokudza hhuba lin'ompela, unoyetila He. Nayiwhoyo unodla, unodlila He, ngobe eboka Ndzimu; nayiwhoyo usingadle, unoba esingadlile He, kakale eboka Ndzimu. <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />Akuna pakati kwedu unozwitjilila, kakale akuna unozwifila. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />Hapa titjila, totjilila He; kakale hapa tifa, tofila He, ndizo kene totjila kene tofa, tibanhu baHe. <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />Ngentha yayikoku Khirisitu wakafa akabampenyu kakale, kuyetila kuti abe He webakafa nebapenyu. <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" />Notongelani hama iyo? Kene, ngentha yeni ulingila pasi hama iyo? Ngobe toseni towhoma mbeli kwetjigalo tjetonga tjeNdzimu. <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />Ngobe kwaka kwagwa kuti,</para>
  <para style="q1" vid="ROM 14:11">“Malebeswa ose hapa nditjila, kujalo He,</para>
  <para style="q2" vid="ROM 14:11">tjose tjibvi tjowhopfigamila imi,</para>
  <para style="q2" vid="ROM 14:11">kakale lulimi gose gowholumbidza Ndzimu.”<verse eid="ROM 14:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />Ndizo ke, umwe newumwe unowhozwihandulila kuNdzimu.<verse eid="ROM 14:12" /></para>
  <para style="s">Usiyete kuti Bamwe Bawe</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />Ndizo ke, ayiletjeni gala titongana, koga ibani netjisungo tjekuti musitongosa tjimwe muzila tjingakunha kene tjingadzinganyidza gamu ledu. <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />Ndoziba, kakale ndinalebeswa muna He Yesu, kuti akuna tjina hambgwa nekwatjo; koga tjina hambgwa kuna iwhoyo unokumbula kuti tjina hambgwa. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />Hapa gamu lilo likubadziwa netjawunodla, awutjatjila muludo. Usipaladze gamu lilo lakafigwa ndiKhirisitu ngetjawunodla. <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />Usiyete kuti tjakanaka tjitjo tjilebgwe zwakayipa. <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />Ngobe bumambo gweNdzimu agutedla nen'wa, koga indulamo nekunyalala nehanha muMeya Yakayengemala. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />Iwhoyo unohingila Khirisitu nayeyi zila unowamutjilika kuNdzimu, kakale uno bvumikala kubanhu.<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />Atiyemuleni zwinhu zwinohhisa kunyalala nezwinhu zwinotitjidza pakubakana kwedu. <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />Musipaladze n'hingo weNdzimu nentha yezodliwa. Zose zodliwa zwibuyanana; koga akuzotambunuka kuti nhu ayete kuti bamwe bakunhiwe ngentha yetjaanodla. <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />Kwakatambunuka kuti usidle nyama kene usin'we wayini, kene kuti usithame kene ini tjinoyeta kuti gamu lilo likunhiwe. <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />Galamoyo kwawunako ngakube pakati kuko neNdzimu. Unakuhanha iye usingazwibone nlandu muna tjaanothama etjibona tjakatambunuka. <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />Koga iye unozeyeza, unowan'wa nlandu hapa edla, ngobe unoba esina kugalamoyo; tjimwe netjimwe tjisingabve mukugalamoyo ijinyo.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="s">Musizwihanhise, Hanhisani Bamwe</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />Iswi bakasima takafanila sengela banyolonyolo mitolo yabo, kakale tisitongozwihanhisa. <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />Umwe newumwe wedu wakafanila hanhisa mbakidzani uwe munatjakanaka, kuyetila kuti awumbake. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />Ngobe naKhirisitu haazotongozwihanhisa; koga, sekwakwaka kwagwa, “Masapa ayibabo banomutuka akawila kundili.” <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />Tjose tjakakwagwa mumahhuba akapinda tjakakwaligwa diya iswi, kuyetila kuti ngeba nemoyonlefu nange kukuludzila kwewhalo tingaba nekugalabgwe. <verse eid="ROM 15:4" /><verse number="5" style="v" sid="ROM 15:5" />Ndzimu, iye unomupa moyonlefu nekumukuludzila, ngaamuthame mube nenkumbulo unofanana pakati kwenyu, iwo zwawo Khirisitu Yesu waaka enawo, <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />kuyetila kuti moseni ngewhi lin'ompela mungakudza Ndzimu Tate baHe wedu Yesu Khirisitu.<verse eid="ROM 15:6" /></para>
  <para style="s">Ndebo Mbuya kuBataya</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />Ayiwamutjilaneni zwakanaka, sayikoku Khirisitu akatiwamutjila, kuyetila gudzo leNdzimu. <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />Ndizo ndoti Khirisitu wakatiwa n'hingi kuna bakathumbigwa kuyetila lakidzila kuti Ndzimu unalebeswa, ehhadzisa gadziwabgwe kwakayetiwa kuna bobatategulu, <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />kose nekuti Bataya bakudze Ndzimu ngentha yemawhilangoni awe; sekwakwaka kwagwa kuti,</para>
  <para style="q1" vid="ROM 15:9">“Ndowhomulumbidza pakati kweBataya,</para>
  <para style="q2" vid="ROM 15:9">kakale ndowhomba ndilumbidza zina lenyu.”<verse eid="ROM 15:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10" />Kakale unoti,</para>
  <para style="q1" vid="ROM 15:10">“Hanhani, imwi Bataya, nebanhu beNdzimu.”<verse eid="ROM 15:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11" />Kakale unoti,</para>
  <para style="q1" vid="ROM 15:11">“Lumbidzani He Bataya mose;</para>
  <para style="q2" vid="ROM 15:11">banhu bose ngabawunlumbidze.”<verse eid="ROM 15:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />Kakale Isaya unoti,</para>
  <para style="q1" vid="ROM 15:12">“Kowhobayapo ndzi waJese,</para>
  <para style="q2" vid="ROM 15:12">unowhomilidziwa kuti atonge Bataya;</para>
  <para style="q2" vid="ROM 15:12">muwunli Bataya banowhogalabgwe.”<verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />Ndizo ke, Ndzimu unopa kugalabgwe ngaamuhhadze nekuhanha nange kunyalala mukugalamoyo, kuyetila kuti mube nekugalabgwe ngentha yemasimba eMeya Yakayengemala.<verse eid="ROM 15:13" /></para>
  <para style="s">Tjakayeta Phawuli Akakwala Ejali</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />Hama dzangu, ndogutshikana kuti imwi, muhhele bubuya, muhhele luzibo gose, motubula diyana. <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />Koga ndamukwalila ndakasimisa nekwezwimwe zwinhu, ndimukumbudza, ngentha yengoni dzandakapiwa neNdzimu, <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />kuyetila kuti ndibe n'hingi waKhirisitu Yesu kuBataya, ndihinga semphirisiti ndisumikila ndebo mbuya yeNdzimu, kuyetila kuti Bataya babe mpilo unowamutjilika, wakayengemadziwa ngeMeya Yakayengemala. <verse eid="ROM 15:16" /><verse number="17" style="v" sid="ROM 15:17" />Muna Khirisitu Yesu, ndina kuhanha nehingila kwangu Ndzimu. <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />Anditowhogala ndaleba nekwezwimwe zwinhu kuhhe kwezwakayetiwa ndiKhirisitu ehingisa imi, kuti Bataya bazibe whilila Ndzimu, ngedama nange zwiyeto, <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />ngemasimba ezwilakidzilo neematjenamiso, nangemasimba eMeya yeNdzimu. Ndizo, kubvila kuJerusalema kupoteleka kunoti kuIliyirikamu ndasumikila ndebo mbuya yaKhirisitu ngekuhhele. <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />Ndizo ndakathama kuti kube tjinangwa tjangu kuti ndisumikile ndebo mbuya, Khirisitu kwaasakatongolebgwa nekukwe, kuyetila kuti ndisibake pehhugwi kwekwakabambiwa newumwe nhu; <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />koga sekwakwaka kwagwa kuti,</para>
  <para style="q1" vid="ROM 15:21">“Banowhobona ibabo basakatongobudziwa nekukwe,</para>
  <para style="q2" vid="ROM 15:21">banowhowhisisa nayibabo basakatongowha nekukwe.”<verse eid="ROM 15:21" /></para>
  <para style="s">Phawuli Unobaakanyila Nokumba kuRoma</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />Ndizo wali ndandisingatubule kwelubaka gulefu hha kumuli. <verse eid="ROM 15:22" /><verse number="23" style="v" sid="ROM 15:23" />Koga ke ngwenu saku kusitjina ntha mumitunhu iyeyi yandisasumikila muyili, ndoyemula, sekwandagala ndithama makole manjinji, kuti ndihhe kumuli, <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />hapa ndiyenda kuSipeyini (ndogalabgwe ndowhomubona ndili mugwendo gwangu, kakale mowhondibhatsha, hule kwekuti ndamukumba kwelubakanyana.) <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />Kwangwenuwali nditjayenda kuJerusalema ndiyendisa bhatsho kubayengemali. <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />Ngobe beMakhedoniya nebeku Akhayiya bakakuhanhila pa banohaya pakati kwebayengemali bemuJerusalema. <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />Bakakuthama ikoku bakahalabvuka, iko mulebeswa bagala bana nlandu wekuti bababhatshe; ngobe hapa kuli kuti Bataya bakaba negobe mumakombolelo emeya emaJuta, Bataya bakafanila kuti bahingise zwinhu zwabanazo, bhatsha maJuta. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />Ndizo hapa ndapedza n'hingo iwhoyu, ndatjibawamutjidza zwipo zwabakapiwa, ndowhopinda kumuli ndiyenda kuSipeyini; <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />kakale ndoziba kuti, hapa ndihha kumuli, ndowhohha ndili mubuhhalo gwemakombolelo akapelela aKhirisitu.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />Ndizo ndomukumbilisisa, hama, muzina laHe wedu Yesu Khirisitu kose nange ludo gweMeya, mubhatane nami mungwa yangu, munditembezelela kuNdzimu, <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />kuti ndibe nekudzibiligwa kuna ibabo basi bagalimoyo muJudiya, kakale bhatsha kwangu kuwamutjilike kubayengemali muJerusalema; <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />kuyetila kuti ngekuda kweNdzimu, ndihhe kumuli ndakahanha, kakale banamwi kundinyaluluse. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />Ndzimu wekunyalala abe namwi mose. Akujalo.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s">Phawuli Unolezwa Bamwe Banhu kuRoma</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />Ndomutulila hazwadzi yedu Foyebhi, n'hingikadzi<note caller="+" style="f"><char style="fr" closed="false">16.1 </char><char style="ft" closed="false">un'hingi</char></note> mugubungano letshipi liku Senkhiriya, <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />kuyetila kuti muwuwamutjile muna He, sekwakalulamila bayengemali, kakale muwumbhatshe kene neni tjaanoba ehaka kumuli, ngobe untungamili wakatjidza banhu banjinji, kose nami wakanditjidza.<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />Mubuyise Phirisika naAkhwila, batinohinga tose muna Khirisitu Yesu, <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />bakalonga butjilo gwabo mumboli ngentha yangu; anditoboka ibo boga, ndoboka kose nemakubungano etshipi ose eBataya. <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />Mubuyise kose negubungano letshipi linonginila munzi wabo.</para>
  <para style="p" vid="ROM 16:5">Mubuyise ndhikani wangu Efayenetasi, unoba ali iye wekutanga handukila kuna Khirisitu muAsiya. <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />Mubuyise Mariya, iye wakamuhingila zwakalema. <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />Mubuyise Andhironikasi naJuniyasi, hama dzangu, taka takasungwa tose; banozibgwa kwazo nebapositoli, kakale bakanditangila handukila kuna Khirisitu.<verse eid="ROM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8" />Mubuyise Ampiliyatasi, ndhikani wangu muna He. <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />Mubuyise Ebhanasi, watinohinga tose muna Khirisitu, naSitakisi ndhikani wangu. <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />Mubuyise Aphelisi iye wakagagwabgwe muna Khirisitu. Mubuyise ben'ha waArisitobhalasi. <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />Mubuyise hama yangu Herodiyoni. Mubuyise ibabo bamuna He ben'ha waNakhisasi.<verse eid="ROM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12" />Mubuyise Thirayifina naThirayifosa, bakadzimayi banohinga kwazo muna He. Mubuyise ndhikani Phesisi, nkadzimayi wakahinga zwakalema muna He. <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" />Mubuyise Rufusi, iye wakahagwa waHe, mubuyise namme babe, bakandibhata semwana wabo. <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />Mubuyise Asiyikiritasi, Filegoni, Hemesi, Phathirobhasi, Hemasi nebagalimoyo babanabo. <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />Mubuyise Filologasi, Juliya, Nereyasi nehazwadzi iye, kose naOlimpasi, nebayengemali bose babanabo.<verse eid="ROM 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 16:16" />Mulebelesane neputa kwakayengemala<note caller="+" style="f"><char style="fr" closed="false">16.16 </char><char style="ft" closed="false">zila yelezwana kwebanhu beku Asiya</char></note>. Ose makubungano etshipi yaKhirisitu anomulebelesa.<verse eid="ROM 16:16" /></para>
  <para style="s">Laya Kwebupelo</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />Ndomukumbilisisa, hama dzangu, kuti mube nehhiho bhabi kuna ibabo banomupalalanya pakati bepinganyidza bugalimoyo gwenyu, bepesana nezwidiyo zwamakadiyiwa; thubukanani nabo. <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />Banhu bakajalo abatohingila Khirisitu He wedu; banohingila mitumbu yabo, kakale banohingisa zwilebo zwinozipilila betjengela ibabo bana mimoyo minyolonyolo. <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />Kozibgwa nebanhu bose kuti munamazwibhato, ndizo ndomuhanhila, koga ndohaka kuti mutjenjelele tjakalulama, kakale musibe neluboko munatjakayipa. <verse eid="ROM 16:19" /><verse number="20" style="v" sid="ROM 16:20" />Ndzimu wekunyalala tjinyolotjo unowhopwanya Satane kusi kwemakumbo enyu.</para>
  <para style="p" vid="ROM 16:20">Ngoni dzaHe wedu Yesu Khirisitu dzibe namwi.<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />Thimothi, iye watinohinga tose unomubuyisa, kose nehama dzangu Lusiyasi naJasoni naSosipeta.<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />Imi Thetiyasi, nkwali wayigogu lukwalo, ndomubuyisa muzina laHe.<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />Gayiyasi, wandigele kuwunli, kakale gubungano letshipi palinohanganila unomubuyisa. Erasitasi, mbhatikwama wenzi-nkulu, negamu ledu Khuwatasi, banomubuyisa. <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />[Ngoni dzaHe wedu Yesu Khirisitu dzibe namwi mose. Akujalo.]<note caller="+" style="f"><char style="fr" closed="false">16.24 </char><char style="ft" closed="false">vesi iyeyi ayitapo muwhalo whulukugwi dzeTjiGiriki</char></note><verse eid="ROM 16:24" /></para>
  <para style="s">Ntembezelo Wehhalila, Unolumbidza</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />Ngwenu ke kuNdzimu iye unotubula musimisa nekwendebo mbuya yangu yandinosumikila nekwaYesu Khirisitu, kuyendidzana nezumbunugwa kwemasazibgwa akabe akasumbikika kwelubaka gulefu kubvisila ntolo tjoselele, <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />koga atjibe patjena kakale ezibgwa nenjudzi dzose, ngentha yewhalo dzebalebesambeli, kuyendidzana nelaya kweNdzimu watjoselele, kuyetila kuti bose babe nemazwibhato ekugalabgwe.<verse eid="ROM 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 16:27" />Ngaakudziwe ndiYesu Khirisitu, iye yega Ndzimu wakatjenjela, ngekusingapele kose. Akujalo.<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>