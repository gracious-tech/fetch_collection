<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Kalanga Bible Translation</book>
  <para style="h">BaFiliphi</para>
  <para style="toc1">Lukwalo GwaPhawuli kubaFiliphi</para>
  <para style="toc2">BaFiliphi BaFil</para>
  <para style="toc3">BaFil</para>
  <para style="mt2">Lukwalo gwaPhawuli ekwalila</para>
  <para style="mt1">BAFILIPHI</para>
  <para style="imt">Tjinginiso</para>
  <para style="ip">Phawuli wakakwala lukwalo igogu ekwalila bagalimoyo bekuFiliphi kwapinda makole makumi matanhatu nelin'ompela hule kwezwagwa kwaKhirisitu. Wakakwala lukwalo igogu eli mujele, kokumbuligwa kuti waka eli kuRoma (BaFiliphi 1.13). Lukwalo igogu gwakakwaligwa gubungano lebagalimoyo laka lili munzi-nkulu weFiliphi. Tingadiyika kuhomanana nekwebaFiliphi mulukwalo gweMihingo. Filiphi waka uli nzi-nkulu wentunhu weMakhedoniya. Ndilo gubungano lebagalimoyo lekutanga lakabeyapo muntunhu weMakhedoniya. Phawuli naSilasi bakabamba gubungano lebagalimoyo ilelo bali bose, bakasungwa bakatongohhaliligwa mujele busiku gose mahhuba betjiko (Mihingo 16).</para>
  <para style="ip">Phawuli waka enazwinangwa zwinjinji ekwala lukwalo igogu. Wakahingisa lubaka igogu kuti aboke gubungano lebagalimoyo pehhugwi kwetjipo tjabaka bawuntumila hule kwewha kuti waka elimujele (BaFiliphi 4.10-19). Wakabazibisa bo mulukwalo igogu nekwemamo awe mujele, akabazibisa nekwaThimothi na Ephafuroditosi kuti babawamutjile (BaFiliphi 2.19-30) babakudze, babalemekedze kakale bawhilile butungamili gwabo.</para>
  <para style="iot">Nlongoloso Yezwimukati</para>
  <para style="io1">Phawuli unobuyisa gubungano lebagalimoyo lekuFiliphi (BaFiliphi 1.1-2)</para>
  <para style="io1">Unotebela nebazibisa nekwemamo awe mujele neleba zwinhu zwaanohaka kuti zwitambunudziwe (BaFiliphi 1.3-2.30)</para>
  <para style="io1">Unobazibisa kuti hapa nhu eli Nkhirisitu unofanila tjila tjini (BaFiliphi 3.1-4.9)</para>
  <para style="io1">Phawuli unopedzisila neboka baFiliphi pehhugwi kwetjipo tjabakawuntumila efidza nebabuyisa (BaFiliphi 4.10-23)</para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />Kubva kuna Phawuli naThimothi, balanda baKhirisitu Yesu,</para>
  <para style="p" vid="PHP 1:1">Kubayengemali bose bamuna Khirisitu Yesu bakuFiliphi, nebalisi bemakubungano, nebatjengeti.<verse eid="PHP 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2" />Ngoni nekunyalala kunobva kuNdzimu Tate bedu naHe Yesu Khirisitu ngakube kumuli.<verse eid="PHP 1:2" /></para>
  <para style="s">Ntembezelo waPhawuli etembezelela baFiliphi</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />Hapa ndimukumbula ndoboka Ndzimu wangu lubaka gose, <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />mumitembezelo yangu yose ndomutembezelela mose ndilihhele kuhanha, <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />ndiboka hingidzana kwenyu nami mun'hingo wendebo mbuya kubvila hhuba lekutanga kudza kuba ngwenuwali. <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />Ndina kugalabgwe kuti iwhoyo wakatanga bamba n'hingo wakanaka mumuli unowuhinga akawupedza kudza kunoti muhhuba laKhirisitu Yesu. <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />Kwakandilulamila kuti ndimukumbule sayikoku mose, ngobe mogala muli mumoyo wangu, mokobelana nemi mungoni dzandinadzo pakudzibilila nesungigwa ndebo mbuya kose nemukuyisimisa. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />Ndzimu ndiye nsupi wangu, kuti ndomuhuba kungapani mose neludo gwaKhirisitu Yesu.<verse eid="PHP 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9" />Untembezelo wangu kuti ludo gwenyu guwande tjoselele gulihhele luzibo nenjele, <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />kuyetila kuti muhale tjakalulama, kakale mube babuya musibe nenlandu kuyetila hhuba laKhirisitu, <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />mulihhele mitjelo yekululama inohha naYesu Khirisitu kuti Ndzimu akudziwe kakale alumbidziwe.<verse eid="PHP 1:11" /></para>
  <para style="s">Kuti Titjile ndiKhirisitu</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />Hama dzangu ndohaka kuti muzibe kuti kwakayetikala kundili kwakabhatsha kwazo mukuyendilambeli kwendebo mbuya, <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />kwakayetikala kuyetila kuti banolinda n'umba yembhati wentunhu nebamwe bose bazibe kuti ndakasungigwa Khirisitu. <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />Sungwa kwangu kwakayeta hama njinji dzikaba nekugalabgwe kwakasima muna He, ngwenu besumikila dama leNdzimu besingahle.<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />Ilebeswa bamwe banosumikila Khirisitu nentha yendandala kose nekakabadzana, koga bamwe banokuthama bena yemula kwakanaka. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />Bakajalo banokuthama kubva muludo, beziba kuti ndakapiwa n'hingo wedzibilila ndebo mbuya, <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />bamwe banosumikila nekwa Khirisitu bezwikudza, besina malebeswa, bekumbula kuti bangapamhidzila dziyila kwangu ndili mubusungwa.<verse eid="PHP 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 1:18" />Ngono ini ikoku? Kuti kene ngezila yemalebeswa kene yemanyepwa, andineni nako, Khirisitu unosumikigwa ngezila dzose, imi ikoku kondihanhisa. <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />Ee, ndohanha, ngobe ndoziba kuti nemitembezelo yenyu nebhatsho leMeya yaYesu Khirisitu ikoku kowhondiswikisa mukusunungugwa<note caller="+" style="f"><char style="fr" closed="false">1.19 </char><char style="ft" closed="false">dama ileli lingaba tjidziwa</char></note> kwangu. <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />Sekwandinoyemula kakale ndigalabgwe kuti anditowhobhakhwa nehoni, koga ngebanetjilopa ngwenuwali semahhuba ose Khirisitu unowhokudziwa mumbili wangu, ngebutjilo kene ngelufu gwangu. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />Ngobe kundili tjila ndiKhirisitu, fa kuhine. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />Hapa kuli butjilo munyama koleba kundili kuti ndowhohinga azwala mitjelo, koga kuti ndihale kupi anditoziba. <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />Ndokwebegwa yeno nayeno. Imi ndohaka yenda ndinogala naKhirisitu, kundili ikoku kuhine kwazo. <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />Kuti ndisiyende ndigale mumbili kungabhatsha imwi bukulu. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />Nentha yekuti ndinalebeswa nekwako, ndoziba kuti ndowhogala ndikayendilambeli namwi mose, kuyetila kula nehanha kwenyu mubugalimoyo, <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />kuyetila kuti ndihanhila kwenyu kube kunjinji muna Khirisitu Yesu, pandinowhohha kakale kumuli.<verse eid="PHP 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />Koga tjila kwenyu ngakube kunoyendidzana nendebo mbuya yaKhirisitu, kuyetila kuti kene ndahha ndiwhomubona kene anditapo, ndiwhe kuti mumile makasima muli mumeya in'ompela, nenkumbulo un'ompela mugwisa muli panhu pan'ompela kuyetila bugalimoyo gwendebo mbuya, <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />musingahlisidzigwe nezwita zwenyu kene nayipi zila, kubali guli busupi gopaladziwa, koga kumuli kuli tjidziwa kunobva kuNdzimu. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />Ngobe itjinhu tjamakapiwa kuti mube banogalamoyo munaKhirisitu, kakale kuti mudziyile mudziyilila iye, <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />muli mungwa iyo zwayo iyeyo yamakabona, kwangwenu yamunowha kuti nditjili muyili.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">Zwitebamisa kwaKhirisitu Nebukulu Gugwe</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />Hapa kuli kuti kuna kuludzila muna Khirisitu, kene nyaladziwa muludo, kene dlidzana muMeya, kene bunyolo nemawhilangoni, <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />hhadzisani hanha kwangu nekuti mube banhu bana nkumbulo un'ompela, mube neludo gun'ompela, mubvumilana, muna nkumbulo wakafanana. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />Musitongothama tjinhu ngekuzwikumbula imwi moga kene nekuzwiloba fuba, koga nezwitebamisa bonani bamwe sebahine pamuli. <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />Umwe newumwe wenyu asigale akathaabalila zwinhu zwizwe koga, koga athaabalile zwinhu zwebamwe bo. <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />Mube nenkumbulo iwo zwawo wakabe uli muna Khirisitu Yesu,<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />iye, nekene waka anambumbiko<note caller="+" style="f"><char style="fr" closed="false">2.6 </char><char style="ft" closed="false">dama ileli lingabva kuti ali mutjimo</char></note> yeNdzimu,</para>
  <para style="q2" vid="PHP 2:6">asakatola lizana neNdzimu setjinhu tjaangabhatilila patjili,<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />koga wakazwitebamisa,</para>
  <para style="q2" vid="PHP 2:7">ekatola mbumbiko<note caller="+" style="f"><char style="fr" closed="false">2.7 </char><char style="ft" closed="false">dama ileli lingabva tjimo</char></note> yenlanda akazwagwa senhu.<verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />Wakawanikwa alimutjimo tjenhu, akazwitebamisa, akawhilila kudzina kuswika kulufu,</para>
  <para style="q2" vid="PHP 2:8">igo lufu gwepatjileyanyo.<verse eid="PHP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />Ndizo ke Ndzimu wawumilidzila pehhugwi kwazo,</para>
  <para style="q2" vid="PHP 2:9">akawumpa zina lipehhugwi kwemazina ose,<verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />kuyetila kuti tjimwe netjimwe tjibvi tjipfigamila zina laYesu,</para>
  <para style="q2" vid="PHP 2:10">kudzimu, nemuhango, nakusi kwehango,<verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />nendimi dzose dzowholeba kuti Yesu Khirisitu ndiHe</para>
  <para style="q2" vid="PHP 2:11">kuyetila kuti gudzo libe kuNdzimu Tate.<verse eid="PHP 2:11" /></para>
  <para style="s">Penya Sezwivoneko Muhango</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />Ndizo ke, badikani bangu, sekwamagala muwhilila, ngwenuwali, musingakuthame ndilipo koga, bukulu ndisipo, hingilani tjidziwa kwenyu mulihhele hla nekutetema, <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />ngobe ndiNdzimu unohinga mumuli, ehingila kuti eyete kuda kukwe nehanha kukwe kubuya.<verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />Thamani zwinhu zose musingan'un'urike, kene kakabadzana, <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />kuyetila kuti mube banhu basingasoleke kakale basina nlandu, bana beNdzimu basingasoleke pakati kwetjizekugwana tjakakombama, tjakayipa, imwi mupenyelela pakati kwatjo sezwivoneko muhango iyeyi, <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />makabhatisisa kwazo dama lebupenyu, kuyetila kuti muhhuba laKhirisitu ndizwilobe fuba nditi andizohihinikila suli kene hingila suli.<verse eid="PHP 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 2:17" />Nekene ndingatebugwa setjibhayilo tjinon'wiwa pehhugwi kwetjibhayilo nebusumikili gunobva kubugalibgwe gwenyu, ndohanha ndihanhisisa panhu pan'ompela namwi mose. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />Nezila iyo zwayo, imwi bo makafanila hanha nehanhisisa panhu pan'ompela nami.<verse eid="PHP 2:18" /></para>
  <para style="s">Thimothi naEphafuroditosi</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />Ndogalabgwe muna He Yesu kuti nekulibilidza ndowhotuma Thimothi kuti ahhe kumuli kuyetila kuti ndikuludzigwe nendebo dzakanaka dzinobva kumuli. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />Ngobe andina umwe unankumbulo unonga uwe, unogala ekumbula nekwebutjilo gwenyu kwemalebeswa. <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />Bose banolinga zwebutjilo gwabo koga, kusi zwaYesu Khirisitu. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />Koga moziba kuti Thimothi wakazwilakidza kuti unobhatsha, kuti iye nami, senkololo natatayi, wakahinga nami mun'hingo wendebo mbuya. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />Ndogalabgwe kuti ndowhowuntuma nekutjimbidza hule kwetanga ndabona kuti zwinhu zoyenda tjini kundili. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />Kakale ndina kugalabgwe muna He kuti nami bo ndowhotjimbidza hha kumuli.<verse eid="PHP 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />Ndakubona kwakalizanila kuti ndimutumile Ephafuroditosi hama yangu yatinohinga tose kakale yatinogwa ngwa tose, ntumwa wenyu unondibhatsha nezwandinotayila nazo, <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />ngobe unomuhuba kwazo kakale wakamanikana ngobe makawha kuti waka egwala. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />Malebeswa waka egwala kwazo akagwilofa. Koga Ndzimu wakawuyetila mawhilangoni, esingayetile iye yega, eyetila nami bo ngobe ndaka ndowhoba nebuyendasi pehhugwi kwegumwe buyendasi. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />Ndinahuha kwazo kuti ndiwuntumile kumuli kuyetila kuti mube nekuhanha hapa mawumbona kakale, nami bo kuti buyendasi gwangu gutelele. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />Ndizo ke muwuwamutjile muna He nekuhanha kukulu, mukudze balume bakajali, <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />ngobe wakagwilofila n'hingo waKhirisitu, esa bupenyu gugwe mumboli kuyetila kuti apeleledze bhatsho lenyu kundili.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">Lulama Kwemalebeswa</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />Tjebupelo hama dzangu, hanhani muna He. Akutondidziyidza pamhulula mukwalila tjinhu tjin'ompela, komuthama mukaba bakatjengeteka. <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />Mutjenjelele mbgwa, bahingi bezwibi, ibabo banotjeka mibili. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />Ngobe iswi tibakawamutjila thumbigwa kwemalebeswa, banonamata Ndzimu mumeya, gudzo ledu limuna Khrisitu Yesu, atina kugutshikana mumbili. <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />Nenguba imi ndina kugalabgwe munyama zwangu, hapa umwe nhu ekumbula kuti unatjinhu tjaangagalilabgwe nyama imi ndinatjo tjinopindisa, <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />ndakathumbigwa muhhuba lebuhhanakadzi lezwagwa, ndinhu wekuIsirayeli, weludzi gwaBhenjamini, Nhhebheru wakazwagwa nebaHhebheru, ngekwenlayo ndiMFarisi, <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />ngekuzwipila kwazo kwazo ndaka ndidziyidza gubungano, ngekwendulamo pasi kwenlayo ndakandisina nlandu. <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />Koga kene wupi mbhayilo wandakabanawo ndowuntola selahikigwa, ndiyetila Khirisitu. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />Lebeswa tjimwe netjimwe ndotjitola semalala ngentha yebukulu gweziba Khirisitu Yesu He wangu. Ngetha iye ndakalahikigwa nezwinhu zose, kakale ndozwitola semalala kuyetila kuti ndiwane Khirisitu, <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />kakale ndiwanike muwunli, ndisina lulama kwangu ngekwenlayo, koga ndina lulama kunobva mubugalimoyo muna Khirisitu, lulama kunobva kuNdzimu ngegalamoyo, <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />kuyetila kuti ndiwunzibe, nemasimba awe emuka kubafi, ndihingidzane naye mudziyila kukwe, ndifanane naye mulufu gugwe, <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />kudze hapa kuyetikala ndiwamutjile bo musiwa kubafi.<verse eid="PHP 3:11" /></para>
  <para style="s">Labuka Ndakalinga Kunoyendewa</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />Akuta kuli kuti imi ndakatjikuwamutjila ikoku, kene kuti ndakatjiyetiwa apelela; koga ndogwisila kuti mbhayilo ube wangu, ngobe Khirisitu Yesu wakandita ndikaba uwe. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />Hama dzangu anditozwitola sekuti ndakatjiyeta mbhayilo ukaba wangu, koga tjinhu tjin'ompela tjandinothama, whukangan'wa tjihule kwangu, ndigwisa wabilila tjimbeli kwangu. <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />Ndosundidzila tjose kuti ndiyende mbeli kumbhayilo weNdzimu wedanigwa pehhugwi, muna Khirisitu Yesu.<verse eid="PHP 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15" />Bamwe bedu batjikula mumeya ngababe nenkumbulo wakajalo; koga hapa kungaswika kuti mukumbule neyimwe zila ipoga nekwetjimwe, ikoko bo Ndzimu unowomuzumbunulila. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />Koga ayibhatisiseni ngemalebeswa ikoku kwatatjiwana.<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />Hama dzangu, todzani imi, mulingisise ibabaya banotjila sayikoku ngobe makafanila kuti mutitole setjiyelesedzo. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />Ngobe sekwandakagala ndimubudza, ndeemubudza nemihodzi, banjinji banotjila sezwita zwetjileyanyo tjaKhirisitu. <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />Bupelo gwabo whupaladziwa, ndzimu wabo injemulo dzemibili yabo, banozwikudza muzwinhu zwinobhatisa honi, mikumbulo yabo yakalinga zwinhu zwehango iyeyi. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />Koga fumwa yedu tose iyapo kudzimu, takalinda Ntjidzi wedu unobva ikweno iye He Yesu Khirisitu, <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />iye unowhohandula mibili yedu isina masimba kuti ifanane nembili uwe uhhele gudzo, ehingisa masimba awe anothama akatubula kuti zwinhu zose zwibe pasi kukwe.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s">Milayo</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />Ndizo ke hama dzangu dzandinoda kakale dzandinohuba, tjiyala tjangu nehanha kwangu, mani makasima muna He, badikani bangu.<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />Ndokumbila Eyudiya, ndikumbila bo naSinithekhi kuti babe nenkumbulo un'ompela munaHe. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />Nawe bo ndokukumbila, iwe unohinga nami, kuti ubhatshe bafumakadzi ibaba, ngobe bakahinga ngekuzwipila mundebo mbuya bena Kilementi nebamwe bose bandinohinga nabo, banamazina amulukwalo gwebupenyu.<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />Hanhani muna He, ndopamha kakale nditi hanhani.<verse eid="PHP 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 4:5" />Banhu bose ngabazibe ba nemoyonlefu kwenyu. He watjibapedlo. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />Musidziyidzike ngekwetjimwe tjinhu, koga muzwinhu zose tulani zwikumbilo zwenyu kuNdzimu, ngetembezela nange kumbila ngekuzwitebamisa, kuna boka. <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />Kunyalala kunobva kuNdzimu, iko kunopinda whisisa kose, kowhotjengeta mimoyo yenyu nemikumbulo yenyu muna Khirisitu Yesu.<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />Tjebupelo, hama dzangu, kungaba kene ini tjemalebeswa, kene ini tjinokudzika, kene ini tjakalulama, kene ini tjibuyanana, kene ini tjinodikala, kene ini tjakafanila kuti tjilumbidziwe, hapa tjiliyapo tjakanaka, kakale hapa tjiliyapo tjinolumbidzika; kumbulani nekwezwinhu izwezwi. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />Tjamakadiyika kakale mukatjiwamutjila, kakale mukatjiwha kakale mukatjibona mundili, mutjithame, Ndzimu bekunyalala banowhoba nemwi.<verse eid="PHP 4:9" /></para>
  <para style="s">Boka Zwipo</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />Ndohanha kwazo muna He kuti hule kwelubaka mamusidzila ndikumbula kwenyu. Makamundiyalakana koga makahaya nkoba wamungahingisa kuti mukulakidze. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />Anditokuleba ngobe ndin'un'urika nekwezwandinohaya, ngobe ndakazwidiya kuti muamwe ne amwe mamo andili muwali ngandigutshikane. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />Ndoziba kuti haya ini, kakale ndoziba kuti ba nekunjinji ini, mumamo api zwawo ndakadiyika kuti lingisana nekunjinji kene lingisana nehhala kwakatini, bufumi nebuhayi kwakatini. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />Ndotubula yeta zwinhu zose ndili muna iye unondisimisa.<verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />Koga tjinhu tjibuya tjamakathama kuti muhanganyile nami lubaka ndili mubulemo. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />Imwi bekuFiliphi tjekwenyu moziba kuti mumahhuba ekutanga kwendebombuya, pandakabva kuMakhedoniya, akuna gubungano lakabhatana nami mukupa nemukuwamutjila kuhhe kwenyu, <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />kene ndili kuThesalonika makatumila bhatsho mupamha mupamha. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />Akutoleba kuti ndohaka zwipo zwenyu, koga ndohaka kuti mube nemitjelo inopamhidzila zwibuya zwamakathama. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />Ndakawamutjila kose, nekunjinji, ndina kose kwandinohaka hule kwekuti ndawamutjila kubva kuna Ephafuroditosi zwipo zwamakatumila, mpilo unonhuwilila, tjibhayilo tjinowamutjilika kakale tjinohanhisa kuNdzimu. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />Ndizo ke Ndzimu wangu unowhohingisa fumwa iye ihhele gudzo kuti amupe kose kwamunohaya, ekuthama ndiKhirisitu Yesu. <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />Ngaakudziwe Ndzimu wedu ibo Tate, tjoselele ngekusingapele kose, Ngakujalo.<verse eid="PHP 4:20" /></para>
  <para style="s">Lezwa Kwebupelo</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />Buyisani bakayengemala bose muna Khirisitu Yesu. Hama dzose dzinami dzomubuyisa. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />Bakayengemala bose banomubuyisa, bukulu ben'ha waKhesari.<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />Ngoni dzaHe Yesu Khirisitu ngadzibe nemeya yenyu.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>