<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Kalanga Bible Translation</book>
  <para style="h">Mako</para>
  <para style="toc1">Lukwalo gwemaMako</para>
  <para style="toc2">Mako</para>
  <para style="toc3">Mak</para>
  <para style="mt2">Ndebo Mbuya Sekwayakakwagwa</para>
  <para style="mt1">ndiMAKO</para>
  <para style="imt">Tjinginiso</para>
  <para style="ip">
    <char style="bk">Ndebo Mbuya sekwayakakwagwa ndiMako</char> gumwe lukwalo gwewhalo dzilina dzeThesitamente Ndzwa dzinoleba nekwebutjilo gwaYesu Khirisitu. Gumwe negumwe lukwalo goyi “ndebo mbuya,” whalo idzedzi dzakakwagwa naMatewu, naMako, naLuka naJohane hule kwefa kwaYesu. <char style="bk">Ndebo Mbuya sekwayakakwagwa ndiMako</char> ndigo lukwalo gufutshwanana pana ndebo mbuya dzilina. Kokumbuligwa kuti lukwalo igogu gwakakwagwa hule kwemakole angaba makumi ali kutanhatu kunoti makumi ali kutondeka hule kwezwagwa kwaYesu. Bazibi banjinji banokumbulila kuti lukwalo igogu gwakakwagwa muRoma ngetjinangwa tjekuludzila MaKhirisitu emaRoma.</para>
  <para style="ip">
    <char style="bk">Mako</char> unozibgwa eyi <char style="bk">Johane Mako,</char> waka ali nkhwinya waMpositoli Phawuli kose naBhanabhasi koga zina lile lakatjinyidzika paakaletja tola gwendo gweyenda esumikila (Mihingo 13.13). Hule kwelubaka Mako wakawhoyenda naBhanabhasi (Mihingo 15.37-39). Mako waka ezibgwa senkhwinya waPhethiro (1 Phethiro 5.13). Nekutobe Mako waka esabona butjilo gwaYesu ngemeho, bazibi banokumbulila kuti Mako wakakwala busupi gwaPhethiro nekuti busupi igogu ndilo tshinde <char style="bk">leNdebo Mbuya sekwayakakwagwa ndiMako</char>. Mako unoleba kwazo nekwebudiyiwa nediya kwaYesu nekwelubaka gwebupelo.</para>
  <para style="iot">Nlongoloso Yezwimukati</para>
  <para style="io1">Tjinginiso tjelukwalo gwaMako (Mako 1.1-13).</para>
  <para style="io1">Mako unoleba nekwen'hingo waYesu etjimuGalile (Mako 1.14-8.21).</para>
  <para style="io1">Mako unoleba nekwegwendo gwaYesu gweyenda kuJerusalema (Mako 8.22-10.52).</para>
  <para style="io1">Mako unofidza ngekwala nekwaYesu eli muJerusalema, kose nefa nemuka kubafi kukwe (Mako 11.1-16.8).</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">Sumikila KwaJohane Mbvubiki</para>
  <para style="r">(<ref loc="MAT 3:1-12">Matewu 3.1-12</ref>; <ref loc="LUK 3:1-18">Luka 3.1-18</ref>; <ref loc="JHN 1:19-28">Johane 1.19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Tangisa kwendebo mbuya yaYesu Khirisitu, Nkololo weNdzimu; <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />Sekwayaka kwagwa mulukwalo gwenlebesambeli Isaya kuyi,</para>
  <para style="q1" vid="MRK 1:2">“Linga, ndotuma ntumwa wangu mbeli kuko,</para>
  <para style="q2" vid="MRK 1:2">unowhokubaakanyila zila.<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />Whi lenhu unodanilila ali mutjilambanyika,</para>
  <para style="q2" vid="MRK 1:3">eti, ‘Baakanyani zila yaHe, mutambunudze zidlana dzidze.’ ”<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />Johane waka ebvubika banhu ali mutjilambanyika, kakale esumikila bvubikiwa kwekuti banhu bahanduke, batigwe mazwibhatigwa matjinyo. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Banhu bekuJudiya bose nebekuJerusalema bakabhuda bakayenda kuwunli, akababvubika mugwizi gunoyi Jorodani, hule kwebvuma matjinyo abo.<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />Johane waka embala tjiyambalo tjebukuse gwekamela, akasungilila mwandabula wegukuta munhunji, edla mhaho nebutji; <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Waka esumikila eti, “Uyapo umwe nkulu pandili unohha hule kwangu, wandisina mamo ekuti nditumbe ndisunungule mitjili yehangu dzidze. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Imi tjekwangu ndomubvubika nevula. Koga iye unowhomubvubika neMeya Yakayengemala.”<verse eid="MRK 1:8" /></para>
  <para style="s">Bvubikiwa Nelikwa kwaYesu</para>
  <para style="r">(Matewu 3.13-4-11; <ref loc="LUK 3:21">Luka 3.21</ref>,<ref loc="LUK 3:22">22</ref>; <ref loc="LUK 4:1-13">4.1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Kwakakotjiti mumahhuba iyawo, Yesu Khirisitu wakaswika ebva kuNazaretha, ntunhu wekuGalile, akabvubikiwa naJohane muJorodani. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Tjinyolotjo etjambobhuda muvula, wakabona kudzimu kuhhuka, Meya Yakayengemala ikadelukila pehhugwi kukwe senjiba. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Kukawhakala whi linobva kudzimu liti, “UNkololo wangu unodikala, wandinohanhila.”<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Tjinyolotjo, Meya Yakayengemala ikawundzibila kutjilambanyika. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Akanobeko kutjilambanyika kwemahhuba ali makumi mana elikiwa naSatane; waka egala nemhuka dzehango, batumwa beNdzimu baka bewumbhatsha.<verse eid="MRK 1:13" /></para>
  <para style="s">Yesu Unodana Babhati beWhobe Bana</para>
  <para style="r">(<ref loc="MAT 4:12-22">Matewu 4.12-22</ref>; <ref loc="LUK 4:14-15">Luka 4.14-15</ref>; <ref loc="LUK 5:1-11">5.1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Sangwenuke, hule kwekusinobe Johane asiwa mujele, Yesu wakangina muGalile, esumikila ndebo mbuya yeNdzimu, <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />eti, “Lubaka gwalizana, bumambo gweNdzimu gwasedzela, handukani mugalemoyo ndebo mbuya.”<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Sangwenu, wakati eyenda pamhili yegungwa lekuGalile, akabona Simoni, na Andhireya nun'una waSimoni, beposela njanga mugungwa, nekuti baka bali babhati bewhobe. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Yesu wakati kubali, “Buyani munditobele, ndowhomuta mukabe babhati bebanhu.” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Tjinyolotjo, bakafupatila njanga<note caller="+" style="f"><char style="fr" closed="false">1.18 </char><char style="ft" closed="false">tjiswino tjebhata whobe</char></note> dzabo bakawuntobela.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Akati atitshelele mbeli, akabona Jakobe naJohane bakololo baZebhedi, nayibo bo baka bali mukepe begambela njanga dzabo. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Tjinyolotjo, wakabadana bakasiya tatayi Zebhedi mukepe nebahingi banolipiwa, bakawuntobela.<verse eid="MRK 1:20" /></para>
  <para style="s">Nlume Unameyambi</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luka 4.31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Bakayenda kuKhaphenawume, wakangina musinagogu nsi wesabatha akadiya. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Banhu bakatjenamisiwa nediya kukwe. Ngobe haazotongothama sebakwali, koga waka ediya senhu unamasimba.<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />Nayigogo lubaka musinagogu yabo kwaka kuna nlume waka aligegwe nemeyambi; <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />wakadanilila eti, “Siyana naswi, tineni nawe iwe Yesu wekuNazaretha? Wahha wotipaladza kani? Ndokuziba kuti ndiwe yani, ndiwe Wakayengemala weNdzimu.”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />Yesu akayitjemela eti, “Nyalala ubhude muwunli!”<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />Meyambi yakati yawunzunguza, ikabe ibhuda muwunli, ilila newhi lipehhugwi. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />Bose bakatjenama, kwekuti bakabhuzwana beti, “Ini ikoku? Tjidiyo tjitshwa! Ngemasimba unobudza meyambi, dzikathama tjaaleba.”<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />Tjinyolotjo kwakalebgwa nekukwe, kukahhala muntunhu wose wakakombeledza Galile.<verse eid="MRK 1:28" /></para>
  <para style="s">Yesu Unotjidza Banhu Banjinji</para>
  <para style="r">(<ref loc="MAT 8:14-17">Matewu 8.14-17</ref>; <ref loc="LUK 4:38-41">Luka 4.38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Hule kwayikoko bakati babhuda musinagogu bakanongina mun'umba yaSimoni na Andhireya, bena Jakobe naJohane. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Koga mezwale baSimoni baka balilele begwala bugwele gweluhhahhamo<note caller="+" style="f"><char style="fr" closed="false">1.30 </char><char style="ft" closed="false">bugwele gwembvango, nhu etetema, dama lakawolobegwa ndelinoti nyon'o (koga lisi TjiKalanga)</char></note>, bakawumbudza nekwabo. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Akabe ebatola neluboko akabamilidza, bugwele gweluhhahhamo<note caller="+" style="f"><char style="fr" closed="false">1.31 </char><char style="ft" closed="false">nhu etetema, dama lakawolobegwa ndelinoti nyon'o (koga lisi TjiKalanga)</char></note> gukapela mubali, bakatangisa bapakulila zodliwa.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Kukati atjibe madekwana, banhu bakahhisa bose baka begwala, nebaka baligegwe nemeyambi. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Nzi-nkulu wose wakakubungana pankoba. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Akatjidza banjinji baka begwala nghwele dzakasiyana siyana; akatata meyambi njinji asingadzibvumile kuti dzilebeleke, ngobe dzaka dziwunziba.<verse eid="MRK 1:34" /></para>
  <para style="s">Unosumikila MuGalile</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luka 4.42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Busikwana, Yesu wakamuka akayenda kubugalo gwakanyalala enotembezela. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Simoni nebamwe babe bakawuntobela. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />Bakati bawuwana bakati kuwunli, “Banhu bose banomuhaka.”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Wakati kubali, “Ayindeni kumizi imbeli, ndinosumikila bo ko; nekuti ndiko kwandakahhila.”<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />Wakayenda muGalile yose, esumikila mumasinagogu abo kakale etata nangemeyambi.<verse eid="MRK 1:39" /></para>
  <para style="s">Yesu Unolapa Nhu</para>
  <para style="r">(<ref loc="MAT 8:1-4">Matewu 8.1-4</ref>; <ref loc="LUK 5:12-16">Luka 5.12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Kukaswika nhu kuna Yesu, nghwele wemapele, (akapfigama ewunkumbila) eti, “Hapa muda zwenyu, muna masimba enditjenesa.”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Yesu wakawuwhila ngoni, akatambunudza luboko akawumbhata eti, “Ndoda; tjenesewa.” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Tjinyolotjo, mapele akawunsiya akatjenesewa. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />Akawunkowhomesedza akawunletja akayenda zwe. <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />Yesu wakati kuwunli, “Ubone kuti awutobudza nhu tjinhu; koga uyende unozwilakidza kumphirisiti, kakale upe tjibhayilo tjetjenesewa kuko selaya kwaMozisi, kuyetila kuti gube busupi kubanhu.”<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />Koga iye wakati ebhuda ipapo akayenda ebudza banhu bose, akapaladzila kubanhu bose, kukadza kukata kuti Yesu asitjatubule ngina mumizi-mikulu, akanogala mutjilambanyika, banhu bakakotjihha kuwunli bebva kuntha dzose.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Yesu Unolapa Nlume Wakalobgwa neGulukadzi<note caller="+" style="f"><char style="fr" closed="false">2.1 </char><char style="ft" closed="false">bugwele gweswaba imwe ntha yembili</char></note></para>
  <para style="r">(<ref loc="MAT 9:1-8">Matewu 9.1-8</ref>; <ref loc="LUK 5:17-26">Luka 5.17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Hule kwemahhuba wakabgwilila muKhaphenawume, banhu bakabudzana kuti umun'umba. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Banhu banjinji bakakubungana, gubungano lakabe gulu kwekuti kwaka kusitjina bugalo kene ipo pankoba wen'umba, akasumikila dama kubali. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Kwakaswika banhu bana, baka bakasenga umwe waka alobgwa negulukadzi<note caller="+" style="f"><char style="fr" closed="false">2.3 </char><char style="ft" closed="false">bugwele gweswaba imwe ntha yembili</char></note>. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Bakakon'wa swika pedlo naYesu nentha yebunji gwebanhu, bakakwakwamula imwe ntha yedenga len'umba bakajitisila nhobo yaaka alilele payili unogwala. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Yesu wakati ebona galamoyo kwabo, akati kunghwele, “Nkololo, wayetigwa mazwibhatigwa matjinyo awo.”<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Kwaka kuna bamwe bakwali baka baligele ipapo, mumimoyo yabo beti, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“Ndiyani iwhoyu unoleba ejali? Unoleba haya! Ndiyani ungayetila mazwibhatigwa matjinyo kuhhe kweNdzimu yega?”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Tjinyolotjo Yesu wakaziba mumeya iye kuti banozwibhuzwa, akati kubali, “Kungentha yeni muzwibhuzwanya zwinhu zwakajali mumimoyo yenyu? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Ndikupi kulelu kuti nditi kuna wakalobgwa negulukadzi<note caller="+" style="f"><char style="fr" closed="false">2.9 </char><char style="ft" closed="false">bugwele gweswaba imwe ntha yembili</char></note>, ‘Wayetigwa mazwibhatigwa matjinyo awo,’ kene kuti, ‘Milika utole nhobo iyo uyende’? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Koga ke, kuti mutjibona ke kuti Nkololo wenhu una masimba muhango, eyetila mazwibhatigwa matjinyo.” Wakati kunlume wakalobgwa negulukadzi<note caller="+" style="f"><char style="fr" closed="false">2.10 </char><char style="ft" closed="false">bugwele gweswaba imwe ntha yembili</char></note> <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“Ndoti kukuli, milika utole nhobo iyo uyende kunzi uwo.”<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />Tjinyolotjo wakamilika akatola nhobo iye bakalinga bose, akayenda; kwekuti bakasala baka kahabala bose, bakakudza Ndzimu, beti, “Atanhu tikakubona kwakajali.”<verse eid="MRK 2:12" /></para>
  <para style="s">Yesu Unodana Levi</para>
  <para style="r">(<ref loc="MAT 9:9-13">Matewu 9.9-13</ref>; <ref loc="LUK 5:27-32">Luka 5.27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Wakapamha akayenda kunsumho wegungwa; gubungano lose lakawunkubunganila, akabadiya. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Wakati epindazwe akabona Levi nkololo wa Alifayasi, aligele pan'umba inoketisigwa, Yesu akati kuwunli, “Unditobele.” Wakamilika akawuntobela.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Kwakakoyetikala kuti Yesu paaka aligele mun'umba edla zodliwa, baketisi nebatjinyi banjinji bakabuyabo bakagala naYesu nebadiyiwa babe; ngobe baka bali banjinji baka bawuntobela. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Bakwali nebaFarisi bakati bewumbona edla nebatjinyi nebaketisi, bakabhuzwa badiyiwa babe beti, “Kungentha yeni edla nebaketisi nebatjinyi?”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Yesu paakakuwha, wakati kubali, “Bapenyu abatohaka nlapi, koga unohakiwa ngebanogwala; andizohhila kuti ndiwhodana bakalulama, koga batjinyi.”<verse eid="MRK 2:17" /></para>
  <para style="s">Mbhuzo Nekweyila Zodliwa</para>
  <para style="r">(<ref loc="MAT 9:14-17">Matewu 9.14-17</ref>; <ref loc="LUK 5:33-39">Luka 5.33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Badiyiwa baJohane nebaFarisi baka beyila zodliwa; banhu bakahha pawunli bakawumbhuzwa beti, “Kungentha yeni badiyiwa baJohane nebebaFarisi beyila zodliwa, koga benyu badiyiwa besingayile zodliwa?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Yesu akabahandula eti, “Bezi bebukwe bangayila zodliwa iye nkwaha anabo mun'umba yebukwe? Hapa nkwaha atjinabo abangayile zodliwa. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Koga kowhoswika mahhuba nkwaha paanowhodusiwa mubali, ndipo pabanowhoyila zodliwa ilelo hhuba.”<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“Akuna nhu unopfumila tjigamba<note caller="+" style="f"><char style="fr" closed="false">2.21 </char><char style="ft" closed="false">tjibatha, bamwe banoti tjigamba tjiTebele</char></note> tjitshwa patjiyambalo tjikulukugwi. Ngobe tjigamba tjitshwa tjingamwawula tjiyambalo tjikulukugwi gabu likapindilila. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Akuna nhu unosa wayini ndzwa mumikabo mikulukugwi; ngobe aangajalo, wayini inowhopalula mikabo, nayiyo wayini ikatebuka, nemikabo ikapwapwatika; koga wayini ndzwa ndeyinosiwa mumikabo mitshwa.”<verse eid="MRK 2:22" /></para>
  <para style="s">Mbhuzo NekweSabatha</para>
  <para style="r">(<ref loc="MAT 12:1-8">Matewu 12.1-8</ref>; <ref loc="LUK 6:1-5">Luka 6.1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Kwakakoyetikala kuti muwumwe nsi wesabatha epalama mudziminda; beli mugwendo badiyiwa babe bakakowha miholo yezwidlo. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />BaFarisi bakati kuwunli, “Linga, banoyetilani tjisingabvumigwe muhhuba lesabatha?”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />Wakabahandula eti, “Amuzotongobala tjakayetiwa naDavida, ahaya kakale abhakhwa nehhala, iye nayibabo baaka enabo. <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Kuti wakangina tjini mun'umba yeNdzimu, mumahhuba Abhiyatha ali mphirisiti nkulu, akadla tjinkwa tjakayengemala, tjakatjisingabvumigwe dliwa nenhu kuhhe kwebaphirisiti, kakale akabapa bo baaka enabo?”<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Akati kubali, “Sabatha lakayetigwa banhu koga kusi kuti banhu bakayetigwa sabatha. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Nayikokoke Nkololo wenhu ndihe we kene ilo sabatha.”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">Nlume Unaluboko Gwakahwehwana</para>
  <para style="r">(<ref loc="MAT 12:9-14">Matewu 12.9-14</ref>; <ref loc="LUK 6:6-11">Luka 6.6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Wakangina musinagogu kakale, ngono kwaka kuna nlume imhomo waka analuboko gwakahwehwana. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Bakawunlingisisa, kudze babone kuti kene unowhowuntjidza muhhuba lesabatha, kuyetila kuti bawuntilike nlandu. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Wakati kuna waka ana luboko gwakaswaba, “Milika, ume pakati kwebanhu.” <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Wakababhuzwa eti, “Kumunlayo kuti muhhuba lesabatha uthame tjibuya kene tjakayipa, kuti utjengetedze butjilo kene kuti ubulaye?”</para>
  <para style="p" vid="MRK 3:4">Koga ibo bakanyalala. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />Akabalinga bose nemoyo unogwadza, egwadziwa nekuti baka bana mimoyo mikukutu, akabe oti kuna iwhoyo nlume, “Tambunudza luboko gugo.” Akagutambunudza, luboko gugwe gwaka gwatjilulama. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />BaFarisi bakabhudila kuhhe, tjinyolotjo bakalangana nebanhu baHherodi kuti bangawumbulaya tjini.<verse eid="MRK 3:6" /></para>
  <para style="s">Gubungano Pagungwa</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Koga Yesu wakazwihalula iye nebadiyiwa babe, bakayenda kugungwa, gubungano gulugulu linobva kuGalile nekuJudiya lakawuntobela. <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />Nebanobva kuJerusalema neku Idumiya nebamwe bakabebva seli yaJorodani, nebekuTire nekuSidoni lakabe gubungano gulugulu, bakati bewha zwinhu zwikulukulu zwaka zwiyetiwa naYesu bakahha kuwunli. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Wakabudza badiyiwa babe kuti kube nekepe tjitukununu tjaangangina mutjili, nentha yekuti kwaka kuna gubungano gulugulu, banhu baka bengawuzwiya; <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />nekuti wake apolesa banhu banjinji, kwekuti banhu banabugwele bakawunkubunganila, behaka kuti bangowunkunha. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Meyambi yaka iti iwumbona, iwila pasi imimila iti, “Unkololo weNdzimu.”<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />Yesu wakabakowhomesedza kanjinji kuti basitongowunta akazibgwa kuti ndiye yani.<verse eid="MRK 3:12" /></para>
  <para style="s">Yesu Unohala Bapositoli Bali Gumi Nebabili</para>
  <para style="r">(<ref loc="MAT 10:1-4">Matewu 10.1-4</ref>; <ref loc="LUK 6:12-16">Luka 6.12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Wakatanha pehhugwi kwedombo akadana baanoda bakahha kuwunli. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Wakahala balume baligumi nebabili baakadana eti bapositoli, kuti babe naye, kakale akabatuma kuti banosumikila <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />nekuti babe nemasimba etata meyambi.<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />Simoni waakapa zina linoyi Phethiro; <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Jakobe nkololo waZebhedi naJohane nun'una waJakobe, baakapa zina linoyi Bhowanejesi, kuleba kuti bakololo betitima; <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />bamwe baka balipo ndi Andhireya, naFiliphi, naBhatholomewu, naMatewu, naTomasi, naJakobe nkololo wa Alifiyasi, naThediyasi, naSimoni wekuKhenani, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />NaJudasi Isikariyoti, iye wakawuntengesa.<verse eid="MRK 3:19" /></para>
  <para style="s">Yesu naBhalazebhube</para>
  <para style="r">(<ref loc="MAT 12:22-32">Matewu 12.22-32</ref>; <ref loc="LUK 11:14-23">Luka 11.14-23</ref>; <ref loc="LUK 12:10">12.10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Bakangina mun'umba bose. Gubungano likabakubunganila kakale, bakakon'wa ikodla tjinkwa. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Ben'ha uwe bakati bekuwha bakayenda benowumbhata, ngobe banhu baka beti, “Wepenga.”<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Bakwali bakabva kuJerusalema bakati, “Ugegwe naBhelezebhule, unotata meyambi ehingisa he wemeyambi.”<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Wakabadanila pedlo akababudza nezwifananidzo eti, “Satane angatata Satane tjini? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Hapa bumambo gwakapalalana pakati tjekwago, bumambo igogo agungame. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />N'ha unangwa pakati kwawo awungame. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Hapa Satane ezwigwisa epalalana pakati, haangame, bupelo gugwe gobe gwatjiswika.”<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />“Akuna nhu ungangina mun'umba wenlume wakasima, akawunkwibila<note caller="+" style="f"><char style="fr" closed="false">3.27 </char><char style="ft" closed="false">swadila</char></note> nhundu dzidze, kuhhe kwekuti atange asunga nlume wakasima, ekoti okuba nhundu.”<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />“Lebeswa ndoti kumuli, bakololo bebanhu banowhoyetigwa mazwibhatigwa matjinyo ose, nekene tuka kungapani; <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />koga unotuka Meya Yakayengemala atowhoyetigwa mazwibhatigwa, koga unowhoba nenlandu wejinyo ilelo nekusingapele.” <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />Nentha yekuti baka beti, “Una meyambi.”<verse eid="MRK 3:30" /></para>
  <para style="s">Mayi baYesu neBanun'una babe</para>
  <para style="r">(<ref loc="MAT 12:46-50">Matewu 12.46-50</ref>; <ref loc="LUK 8:19-21">Luka 8.19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Kwakakoswika meyabe nebanun'una babe, bakama kuhhe bakatumila banhu kuti bawundhane. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Gubungano laka lakawunkombeledza, lakati kuwunli, “Meyabo nebanun'una babo banokuhaka bakuhhe.”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Akabahandula ebhuzwa eti, “Mme bangu ndiyani, banun'una bangu ndiboyani?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Etjebuka tjebuka banhu baka baligele bakawunkombeledza, wakati, “Lingani mme bangu nebanun'una bangu ndi ibaba! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Umwenemwe unothama kuda kweNdzimu, ndiye nun'una, nehazwadzi namme bangu.”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Tjifananidzo TjeNdzwali</para>
  <para style="r">(<ref loc="MAT 13:1-9">Matewu 13.1-9</ref>; <ref loc="LUK 8:4-8">Luka 8.4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Wakatangisa diya pawhunde yegungwa. Akakubunganigwa nebanhu banjinji, ndizo wakangina mukepe, akagala mugungwa, koga gubungano lose lebanhu laka lili pamhili yegungwa, pamavu. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Wakabadiya zwinhu zwinjinji ngezwifananidzo, akati mukudiya kukwe. <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />“Whililani; lingani! kuna umwe ndzwali wakayenda kunodzwala. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Wakati ewaya, imwe mbewu ikawila muzila, nyunyi dzikabuya dzikayidla. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Imwe mbewu yakawila pana mahalabgwana, paka pasina mavu manjinji; ikalibilidza mela nekuti kwaka kusina mavu manjinji. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Koga kwakati hhuba litanha ikatshwa; saku yaka isina midzi yakabva yaswaba. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Imwe mbewu yakawila mumimhiwa, mimhiwa ikakula ikayizwiya, ikasazwala. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Imwe mbewu yakawila mumavu akanaka ikazwala, ikakula ikawanda, ikazwala, imwe kwakapamhiwa kagulu, imwe kuli makumi matanhatu, imwe kuli makumi matatu.”<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Wakati kubali, “Unazebe dzewha, ngaawhe.”<verse eid="MRK 4:9" /></para>
  <para style="s">Tjaka Tjiyetigwa Zwifananidzo</para>
  <para style="r">(<ref loc="MAT 13:10-17">Matewu 13.10-17</ref>; <ref loc="LUK 8:9-10">Luka 8.9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Wakakoti atjibe yega, banhu baka bakawunkombeledza nebadiyiwa baligumi nebabili bakawumbhuzwa nekwezwifananidzo. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Yesu wakati kubali, “Imwi makapiwa kuti muzibe zwakasumbikika zwebumambo gweNdzimu, koga kubamwe ibabo bakuhhe, kose kolebgwa ngezwifananidzo; <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" /><note caller="-" style="x"><char style="xo" closed="false">4.12 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">Isa 6.9-10</ref>.</char></note>kuyetila kuti,</para>
  <para style="q1" vid="MRK 4:12">“ ‘Babone</para>
  <para style="q2" vid="MRK 4:12">koga basibonesese,</para>
  <para style="q1" vid="MRK 4:12">kakale bawhe</para>
  <para style="q2" vid="MRK 4:12">koga basitongowhisisa;</para>
  <para style="q1" vid="MRK 4:12">ngobe bangahanduka kakale,</para>
  <para style="q2" vid="MRK 4:12">bakayetigwa mazwibhatigwa.’ ”<verse eid="MRK 4:12" /></para>
  <para style="s">Yesu Unopetunula Tjifananidzo TjeNdzwali</para>
  <para style="r">(<ref loc="MAT 13:18-23">Matewu 13.18-23</ref>; <ref loc="LUK 8:11-15">Luka 8.11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Yesu akati kubali, “Amutotjiwhisisa tjifananidzo itjetji? Ngono mowhoziba tjini tjinolebgwa nezwifananidzo zwimwe zose? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Ndzwali unodzwala dama. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Dama palinodzwagwa; banoti beliwha, tjinyolotjo Satane ebuya etola dama ladzwagwa, ibabo ndiyo mbewu imuzila. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Sayikoko bo, mbewu imumahalabgwana, ndi ibabo banoti bewha dama tjinyolotjo bakaliwamutjila nekuhanha; <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />abana midzi, koga banobhatilila kwelubakanyana; panoswika bulemo kene dziyidzika ngentha yedama, banobva banyala moyo tjinyolotjo. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Bamwe imbewu yakadzwagwa pakati kwemimhiwa; ndi ibabo banowha dama, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />koga da zwinhu zwehango, nehanhila fumwa, neyemula zwimwe zwinhu, kunginila kutshambidzila dama, likosaba nemitjelo. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Koga mbewu yakadzwagwa mumavu akanaka ndi ibabo banowha dama, bakaliwamutjila, bakakozwala mitjelo, yakapamhiwa kagulu, imwe kuli makumi matanhatu, imwe kuli makumi matatu.”<verse eid="MRK 4:20" /></para>
  <para style="s">Tjivoneko Kusi Kwetundu</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luka 8.16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Yesu wakati kubali, “Kuna tjivoneko tjinotongosiwa kusi kwetundu kene kusi kwembheta? Koga haate tjisiwa pehhugwi kwetjigadziko tjetjivoneko? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Nekuti akuna tjakasumbikika tjisingowhodusigwa patjena; kakale akuna tjinowhogala tjakasumbikika, koga tjowhobhuda patjena. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Hapa kene upi nhu enazebe dzowha, ngaawhe.”<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />Wakati kakale kubali, “Yelani njele kuti tjamunowha ini, kakale tjilizanyo tjamunopa nditjo tjamunowhowamutjila bo, kene kwakajalo kumuli kowhopamhidzigwa. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Ngobe unako unowhopiwa kunjinji; koga usina, nayikoko kwaanako unowhokutolegwa.”<verse eid="MRK 4:25" /></para>
  <para style="s">Tjifananidzo Tjemhudzi Inokula</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Wakati, “Bumambo gweNdzimu gonga nhu wakadzwala mbewu mumavu; <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Akakonda enolala emuka siku nesikati, mela ukapombonoka ukakula koga asingazibe kuti wakula tjini. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Mavu ngekwawo anozwikudzila, kotanga kwabhuda mela, kukotjifunda, kukotobela n'holo watjiyibva. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Koga hapa kwatjiyibva, unobva alonga sikela, ngobe lubaka gwevuna gobe gwaswika.”<verse eid="MRK 4:29" /></para>
  <para style="s">Tjifananidzo Tjemhudzi Yemasitadiya</para>
  <para style="r">(<ref loc="MAT 13:31">Matewu 13.31</ref>,<ref loc="MAT 13:32-34">32-34</ref>; <ref loc="LUK 13:18-19">Luka 13.18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Yesu wakati, “Bumambo gweNdzimu tingagufananisa neni? Kene iko kuti tingagufananisa natjipi tjifananidzo? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Gonga mhudzi yemasitadi, inoti payinodzwagwa mumavu inobe ili nhukununu pamhudzi dzosedzose dziyapo muhango. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Koga hapa yadzwagwa inokula ikabe whuluwhulu kupinda zwilimwa zose, inopalula nhabi whuluwhulu kwekuti nyunyi dzemumhepo dzobaka zwihaka dzikawana ntuzi.”<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Wakalebeleka nabo dama ehingisa zwifananidzo kuyendilana nekuti baka bewhisisa kungapani. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Haazotongolebeleka nabo neyimwe zila isi zwifananidzo, koga baka beti batjibe boga nebadiyiwa babe ekotjibatjenesela zwinhu zose.<verse eid="MRK 4:34" /></para>
  <para style="s">Yesu Unodzikamisa Dutu</para>
  <para style="r">(<ref loc="MAT 8:23-27">Matewu 8.23-27</ref>; <ref loc="LUK 8:22-25">Luka 8.22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Hhuba ilo zwalo ilelo, kwakati kwatjibe madekwana akati kubali, “Ayitjulukileni seli.” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Besiya mbunga, bakangina bo mukepe, iye waka atjingina kale, bakayenda, kwakakuna zwimwe zwikepe ipapo. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Kukakomilika dutu gulugulu, vula dzalo dzikangina mukepe tjikabe tjohhala vula. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Yesu waka ali kuhule mukepe alilelezwe panhobo akasazamila nsazamilo; bakawumusa beti, “Ndhiyi, amuna hanya kuti tepalala?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Akabe emilika etjemela mhepo, eti kugungwa, “Dzikama! Nyalala uti whu!” Mhepo ikanyalala kukabe nekunyalala kukulukulu. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Akabe oti kubali, “Mohlilani zwingapa? Amuna bugalimoyo?”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Bakahla kwazo bakati umwe kuwumwe, “Ndiyani iwhoyu unowhiligwa nemhepo nange gungwa lose?”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">Yesu Unotjidza nlume una Meyambi</para>
  <para style="r">(<ref loc="MAT 8:28-34">Matewu 8.28-34</ref>; <ref loc="LUK 8:26-39">Luka 8.26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Bakaswika seli yegungwa, kuhango yebaGerasini. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Akati abhuda mukepe, akahanganidziwa nenlume ugegwe nemeyambi ebva mumakuwhu aka ali zwikumbu. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Nlume iwhoyo waka egala kuzwikumbu; kakale akuna nhu waka angatjawunsunga, kene nange miketane. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Waka etongosungwa nemitjili nemiketane, ethubulazwe kose, akuna nhu waka etubula wuntebamisa. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Lubaka gose siku nesikati waka ali kumatombo nekuzwikumbu emimila ezwitjeka nemabgwe.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Wakati ebona Yesu atjikulekule akawuntihhilila akaswika akawunamata; <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />emimila newhi lipehhugwi eti, “Yesu Nkololo weNdzimu upehhugwihhugwi muneni nami? Ndomukumbila ngeNdzimu, musindidziyidze!” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Ngobe waka ati, “Bhuda muwunli iwe meyambi!”<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Yesu wakawumbhuzwa eti, “Zina lilo ndiyani?”</para>
  <para style="p" vid="MRK 5:9">Wakahandula eti, “Zina langu loyi Ligiyoni; ngobe tibanjinji.” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Meyambi yakawunkumbilisisa kuti dzisitatigwe kuhhe kwehango iyeyo.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Sangwenu kwaka kuna ngubi yengulube yakabe ifula muwhunde yedombo; <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />meyambi dzakawunkumbilisisa dziti, “Mutitatile kungulube tinogala mudzili.” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Yesu wakadzibvumila. Meyambi dzikabhuda munlume dzikangina mungulube, ngulube dzakakulumuka nelubilo dzijitila nepakakungulukila dzikanowila mugungwa, dzakadzingaba zwiwulu zwibili; dzikakapitiwa nevula mugungwa dzikafa.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Balisi bakatihha bakanoleba munzi-nkulu nemuhangwanyana yose. Banhu bakabhuda kudze banobona kuti ini tjaka tjayetika. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Bakaswika kuna Yesu, bakabona waka aligegwe nemeyambi njinji aligele akambala zvibuyanana nenkulumbulo uwe wakatambunuka; bakahla. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Bakabakubona bakababudza tjayetika kuna waka aligegwe nemeyambi nekungulube.<verse eid="MRK 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17" />Bakawunkumbilisisa kuti abhude muntunhu wabo.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Yesu wakati angina mukepe, nlume iwhoyo waka atongogagwa nemeyambi akawunkumbilisisa kuti abe naye.<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />Koga Yesu wakalamba, wakati kuwunli, “Yenda kanyi kumakamu awo, ubabudze zwinhu zwikulukulu zwawayetigwa naHe nekuti wawhigwa ngoni tjini.”<verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />Wakamilika ipapo akatangisa zibisa muDikapolisi<note caller="+" style="f"><char style="fr" closed="false">5.20 </char><char style="ft" closed="false">mizi-mikulu ili gumi</char></note> bukulu gwezwinhu zwaakayetigwa naYesu; banhu bose bakatjenama.<verse eid="MRK 5:20" /></para>
  <para style="s">Nkololokadzi waJayirosi neNkadzimayi wakabhata ngubo yaYesu</para>
  <para style="r">(<ref loc="MAT 9:18-26">Matewu 9.18-26</ref>; <ref loc="LUK 8:40-56">Luka 8.40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Yesu wakati abgwilila seli yeya ali mukepe, mbunga nkulunkulu ukawunkubunganila; iye waka ali muwhunde yegungwa. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Kukaswika umwe webatungamili besinagogu, zina loyi Jayirosi, paakabona Yesu wakapfigama pamakumbo awe. <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />Akawunkumbilisisa eti, “Nkololokadzi wangu ntukununu wefa. Ndomukumbila mubuye mowhumbiga maboko, kuyetila kuti anaye, kakale atjile.”<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />Ndizo Yesu wakayenda naye; banhu banjinji bakawuntobela, besundanyidza.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />Kwakakuna umwe nkadzimayi waka egwala bugwele gwebhihha malopa kwemakole ali gumi nemabili. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />Waka adziyila kwazo eyenda kubalapi, atjipedza kose kwaaka anako, bugwele gusingabe hine, koga guyendilambeli. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Waka awha nekwaYesu, wakayenda hule kukwe pakati kwebanhu akabhata tjiyambalo tjaYesu. <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />Ngobe waka eti, “Dzene ndatubula bhata tjiyambalo tjitje ndinganaya.”<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />Tjinyolotjo bhuda malopa kwakama; akawha mumbili uwe kuti watjinaya bugwele gwapela. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Tjinyolotjo Yesu wakawha kuti masimba abhuda muwunli, akatjebuka akati kumbunga, “Ndiyani wabhata tjiyambalo tjangu?”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Badiyiwa babe bakati kuwunli, “Banhu banjinji mobona kuti banosundanyidza besedzela pedlo namwi mungabhuzwa tjini kuti, ‘Ndiyani wandibhata?’ ”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Koga Yesu wakatjebuka yeno nayeno kuti abone waka athama tjinhu tjakajalo. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Nkadzimayi ehla kakale etetema eziba tjayetika kuwunli, wakabuya akapfigama mbeli kukwe akawumbudza malebeswa ose. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Iye akahandula eti, “Nkololokadzi, galamoyo kuko kwathama ukanaya; yenda nekunyalala, bugwele gugo agupole.”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Atjalebeleka kwakaswika bamwe bebva kunzi wentungamili wesinagogu bakati, “Nkololokadzi wenyu watjinyika. Mutjadziyidzilani Ndhiyi?”<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Asingade whilila tjabanoleba, Yesu wakati kuntungamili wesinagogu, “Usihle, galamoyo koga.” <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Haazobvumila kuti kube nenhu unowuntobela kuhhe kwaPhethiro naJakobe naJohane nkulu waJakobe. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Paakaswika kun'umba yentungamili wesinagogu, wakabona sagadzikana kwebanhu, banhu bakabelila kakale bembila pehhugwi. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Wakati angina akababhuzwa eti, “Motilani hhoba yose iyeyi kakale molilani? Nsikana haazofa ulele.”<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />Bakawunseka bulengwe. Koga iye wakati abadusa mun'umba, akatola tatayi namayi bensikana nebaaka ahha nabo, bakangina kwaka kulilele nsikana. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Ewumbhata neluboko wakati kuwunli, <char style="tl">“Thalitha kowumi”</char> kunobva kuti, “Nsikana, ndoti kukuli muka.”<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />Tjinyolotjo nsikana wakamuka akayendayenda (waka anamakole ali gumi nemabili). Bakatjenama kwazo. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Wakakowhomesedza kuti akuna nhu wakafanila ziba nekwako, kakale wakati bape nsikana tjimwe tjinhu adle.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">Yesu Unolandugwa kuNazaretha</para>
  <para style="r">(<ref loc="MAT 13:53-58">Matewu 13.53-58</ref>; <ref loc="LUK 4:16-30">Luka 4.16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Wakabva ipapo akayenda kuhango yakanyi kwabo; badiyiwa babe bakawuntobela. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Hhuba lesabatha lakati laswika, akatangisa diya musinagogu; banjinji bakawha ediya bakatjenama, beti, “Iwhoyu nlume wakakuwana poni kose ikoku?” Ibutjenjebvu ludzini gwaakapiwa? Mihingo mikulukulu yakajali ngemaboko awe! <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Haata ali iye mbehhi iwhoyu, nkololo waMariya, nkulu waJakobe naJosesi naJuda naSimoni? Hazwadzi dzidze atayidzo dzatinadzo pano? Bakawugwadziligwa.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />Koga Yesu wakati kubali “Nlebesambeli haana lukudzo muhango yakanyi kwabo, nemuhama dzidze, nemun'umba yakanyi kwabo.”<verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />Ipapo haazotubula thama mihingo mikulu, kuhhe kwekuti wakabiga maboko bahomanana baka begwala akabatjidza. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Wakatjenamisiwa nesagalamoyo kwabo. Akayenda epoteleka nemizi ediya.<verse eid="MRK 6:6" /></para>
  <para style="s">Yesu Unotuma Badiyiwa Gumi neBabili</para>
  <para style="r">(<ref loc="MAT 10:5-15">Matewu 10.5-15</ref>; <ref loc="LUK 9:1-6">Luka 9.1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />Wakadana badiyiwa bali gumi nebabili akatangisa batuma, beyenda bali babili babili, akabapa masimba pehhugwi kwemeyambi. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />Wakabalaya eti basisenge kene tjinhu hapa beli mugwendo, kene iyo whomo, kene tjinkwa, kene mari mumamwandabula abo, kuhhe kweludozo koga. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Koga bambale mbhatata, basimbale zwiyambalo zwibili. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Wakati kubali, “Munzi wamunoswikila, galani muwunli mudza mumilika. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Kukaba nentunhu usingowhomuwamutjila kakale belamba muwhilila, hapa mobhuda mo mupule whuluba ipamakumbo enyu kuti gube busupi pehhugwi kwabo.”<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Bakabhuda, bakayenda bakasumikila kuti banhu bahanduke. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Bakatata meyambi njinji, bakahhodza banjinji baka begwala mafuta, bakanaya.<verse eid="MRK 6:13" /></para>
  <para style="s">Fa kwaJohane Mbvubiki</para>
  <para style="r">(<ref loc="MAT 14:1-12">Matewu 14.1-12</ref>; <ref loc="LUK 9:7-9">Luka 9.7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Mambo Hherodi wakawha nekukwe; nentha yekuti zina laYesu lakalozibgwa pose pose. Bamwe bakati, “Johane mbvubiki wamuka kubafi; ndizo wali masimba iyawa ehinga muwunli.”<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Bamwe bakati, “ndi Elija.”</para>
  <para style="p" vid="MRK 6:15">Bamwe bakati, “Unlebesambeli, se umwe bo webalebesambeli.”<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />Koga Hherodi, paakakuwha wakati, “NdiJohane wandakathubula n'holo, wamuka.” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />Ngobe Hherodi waka atumila banhu bakabhata Johane, bakawumposela mujele, ngentha yaHherodiyasi nkadzi wenkulu uwe Filiphi; ngobe waka atjiwuntola abe nkadzi uwe. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Kana Johane waka ati kuna Hherodi, “Akutamunlayo kuti utole nkadzi wenkulu uwo.”<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />Hherodiyasi wakabe ne lubengo naye, akayemula kuti awumbulaye; koga haazotubula; <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />ngobe Hherodi waka ehla Johane, eziba kuti waka ali nhu wakalulama kakale wakayengemala, akawuntjengeta zwakanaka. Wakati hha ewha elebeleka, ehangana n'holo; koga ehanhila wuwhilila.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Koga nkoba ukabeyapo hhuba Hherodi paakathama nzano wehhuba lezwagwa kukwe, etila babhatshi babe nebatungamili bengwa nebalume bapehhugwi beGalile. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Nkololokadzi waHherodiyasi paakangina akazana, wakahanhisa Hherodi nebezi babe; mambo akati kunsikana, “Undikumbile kene ini tjawunoyemula, ndowhokupa.” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Akatuna kuwunli eti, “Kene ini tjawunondikumbila, ndowhokupa itjo, kene ukati ndikupalulile pakati bumambo gwangu.”<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />Wakabhuda, akanobhuzwa kuna meyabe eti, “Ndi kumbileni?”</para>
  <para style="p" vid="MRK 6:24">Ibo bakati, “N'holo waJohane mbvubiki.”<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Wakahanduka nekulibilidza kuna mambo, akakumbila eti, “Ndohaka kuti mundipe n'holo waJohane mbvubiki ngwenuwali uli mundilo.”<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />Mambo wakabhakhwa nebuyendasi kwazo; koga nentha yekuti waka awunghadzabgwe kakale nentha yebezi babe haazotubula kuti awunlambile. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Tjinyolotjo mambo wakatuma nlume wengwa akalaya kuti abuye nen'holo uwe. Wakayenda akanowunthubula mujele, <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />akahhisa n'holo uwe uli mundilo akapa nsikana; nsikana akano swiswa meyabe. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Badiyiwa babe (Johane) bakati bekuwha ikoku, bakabuya bakawhotola mbili uwe, bakanowumbiganya mukumbu.<verse eid="MRK 6:29" /></para>
  <para style="s">Yesu Unopa Banhu bali Zwiwulu Zwihanu Zodliwa</para>
  <para style="r">(<ref loc="MAT 14:13-21">Matewu 14.13-21</ref>; <ref loc="LUK 9:10-17">Luka 9.10-17</ref>; <ref loc="JHN 6:1-14">Johane 6.1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Bapositoli bakahanduka kuna Yesu, bakawumbudza zwinhu zose zwabathama nezwabadiya. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Iye akati kubali, “Buyani moga ngeno ku tjilambanyika mutongo nyaluluka kwelubakanyana.” Nentha yekuti kwaka kuna banjinji baka bebuya bamwe beyenda, bakahaya lubaka gwenyaluluka kene iko kuti badle zodliwa. <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Bakamilika bakayenda nekepe baliboga kubugalo gwakanyalala.<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />Koga banhu bakababona bemilika, banjinji bakawunziba bakalabuka bebhuda mumizi-mikulu yose bakabatangila bakawunkubunganila. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Yesu wakati ebhuda mugungwa akabona mbunga webanhu banjinji, akabawhila ngoni nentha yekuti baka benga mhwizi dzisina nlisi; akatangisa badiya zwinhu zwinjinji. <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />Hhuba lakati lohwa, badiyiwa babe bakabuya kuwunli bakati, “Pano ihango, kakale hhuba lahwa; <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />paladzani banhu, bayende kumizi nekubugalo gupedlo banozwitengela tjabangadla.”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Wakabahandula eti, “Mubapeni tjabangadla.” Badiyiwa bakati kuwunli, “Tingayenda tinotenga zodliwa zwemari ingapa madinari<note caller="+" style="f"><char style="fr" closed="false">6.37 </char><char style="fq" closed="false">madinari </char><char style="ft" closed="false">waka uli nlipo wemimwedzi ili hhanakadzi</char></note> ali makhulu mabili tibape badle?”<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />Wakati kubali, “Muna zwinkwa zwingana? Yendani munohola.”</para>
  <para style="p" vid="MRK 6:38">Bakati baziba bakati, “Tina zwinkwa zwihanu newhobe mbili.”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />Wakababva kuti bagadze banhu pasi bali mabunga pabuhwa gunyolo. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Bakagala pasi bali mabunga, amwe mabunga bali gulu amwe bali makumi mahanu.<verse eid="MRK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 6:41" />Wakati atola zwinkwa zwihanu newhobe mbili akalinga pehhugwi kudzimu, akakombolela, akapemula zwinkwa, akazwipa badiyiwa babe kuti bazwigadzike mbeli kwebanhu; akabakobela bose whobe mbili. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Bakadla bose bakaguta. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Bakanunga zwitundu gumi nezwibili zwezwipemu zwakasala zwezwinkwa newhobe. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Bakadla zwinkwa baka bali zwiwulu zwihanu, kubagwa banhu betjilume koga.<verse eid="MRK 6:44" /></para>
  <para style="s">Yesu Unoyenda Pehhugwi Kwevula</para>
  <para style="r">(<ref loc="MAT 14:22-33">Matewu 14.22-33</ref>; <ref loc="JHN 6:15-21">Johane 6.15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Tjinyolotjo wakatjimbidzisa badiyiwa babe kuti bangine mukepe bayende seli, kuBhethisayida, iye akasala epaladza banhu. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Wakati atjipaladza banhu, akamilika akayenda kudombo enotembezela. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />Kwakati kwatjibe madekwana, kepe tjaka tjili mugungwa, iye waka aliyega muhango. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Wakabona kuti banohinga zwakabangalala kudze bandise kepe nentha yekuti mhepo njinji yaka igwisana nabo, kukati mahhakuyedza akaswika kubali enangayila pehhugwi kwevula, enga unoyi unopindazwe. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Koga ibo bakati bebona eyenda pehhugwi kwegungwa bakakumbulila kuti ipuku bakabe bemimila; <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />nekuti bakawumbona bose, bakahla.</para>
  <para style="p" vid="MRK 6:50">Koga tjinyolotjo wakalebeleka eti kubali, “Gadzikanani, ndimi, musihle!” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Wakangina mukepe pabaka balipo. Mhepo ikanyalala, bakatjenama kwazo, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />ngobe abazowhisisa jenamiso lezwinkwa, mimoyo yabo yaka yakasima.<verse eid="MRK 6:52" /></para>
  <para style="s">Yesu Unotjidza Banogwala kuGenesareti</para>
  <para style="r">(<ref loc="MAT 14:34-36">Matewu 14.34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Bakati batjuluka batjiba seli yeya, bakaswika muhango yeGenesareti, bakasungilila kepe pansumho wegungwa. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Bakati babhuda mukepe, banhu bakabva bawunziba, <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />bakatjimbidza bakahhala hangwanyana yose iyeyo, bakatangisa hhisa bagwele bali panhobo pose pose pabaka bawha kuti ndipo paayako. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Kose kwaaka eswika, mumizi, mumizi-mikulu nemumitunhu baka beladzika bagwele pantha dzetengesela, bewunkumbilisisa kuti babvumigwe kunha mpeto wetjiyambalo tjitje; banhu nebunji bakawunkunha bakanaya.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Zwidiyo Zwe Bakulukugwi</para>
  <para style="r">(<ref loc="MAT 15:1-9">Matewu 15.1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Kwakati atjikubunganigwa nebaFarisi, nebamwe bebakwali, baka babva kuJerusalema, <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />bakabona kuti bamwe badiyiwa babe baka bedla zodliwa (tjinkwa) nemaboko ana hambgwa, asakangugwa.<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />(Nekuti Bafarisi, neMaJuta ose, kuhhe kwekuti bangula maboko bakabe basingadle, uli nlenje webawhola; <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />baka beti hapa bebva kuntha dzetengesela, baka basingadle kuhhe kwekuti batanga bazwitjenesa; kakale kuna imwe milenje minjinji yabaka bethama, inohanganyisila ngudziwa kwemikombe, nedzinhobo, nedzihali nezwidla zwetshipi.)<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />BaFarisi nebakwali bakawumbhuzwa beti, “Nentha yeni badiyiwa babo basingatobele nlenje webawhola, bedla besakangula, maboko abo anahambgwa?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Wakabahandula eti, “Isaya wakalebesambeli nekwenyu! batjengeli, sekwakwaka kwagwa,</para>
  <para style="q1" vid="MRK 7:6">“ ‘Banhu ibaba banondilemekedza nemilomo yabo,</para>
  <para style="q2" vid="MRK 7:6">koga mimoyo yabo ikulekule nami.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Akuna tjakunohinga ndinamata kwabo,</para>
  <para style="q2" vid="MRK 7:7">ngobe bediya milayo yebanhu</para>
  <para style="q2" vid="MRK 7:7">sekunoyi milayo yangu.’<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />“Mosendeka ntome milayo yeNdzimu mubhatilila munlenje webanhu.”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Wakati kubali, “Muna zila yolamba zwenyu nlayo weNdzimu, muyetila londolodza nlenje wenyu. <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Nekuti Mozisi wakati, ‘Lemekedza tate babo namme babo’, kakale, ‘Iye unoleba zwakayipa nekwatate babe kene nekwamme babe, ngaafe kwelebeswa’, <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />koga imwi moti, ‘Hapa nhu ebudza mayi natatayi eti, tjamakafanila wana tjibva kundili <char style="it">iKhobhani</char>’ (kuleba kuti, itjipo tjapiwa Ndzimu) <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />amutjawumbvumila tila tatayi namayi tjimwe tjinhu, <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />muhayisa dama leNdzimu masimba nentha yemilenje yenyu yamunotula kubanhu, nekumwe kunjinji kwakajalo kwamunothama.”<verse eid="MRK 7:13" /></para>
  <para style="s">Zwinhu Zwinothama Nhu Akasibembuyanana</para>
  <para style="r">(<ref loc="MAT 15:10-20">Matewu 15.10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Wakadana banhu kakale, ebadanila kuwunli, akati kubali, “Mundiwhilile moseni, kakale muwhisise. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Akuna tjinu tjikuhhe kwenhu tjinoti tjangina muwunli tjikawunsa hambgwa; koga zwinhu zwinobhuda muwunli ndizo zwinowunsa hambgwa.” <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />(Hapa kuna unazebe dzewha, ngaawhe).<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Wakati angina mun'umba ebva kugubungano, badiyiwa babe bakawumbhuzwa nekwetjifananidzo. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Akati kubali, “Namwibo amutowhisisa bo? Amutowhisisa kuti kene kulini kukuhhe hapa kungina munhu akungawunse hambgwa. <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Nekuti akutongina mumoyo koga kongina muntumbu, kupinda kunobhuda kuhhe kwembili?” (Ndizo wakaleba ejalo ebva atjenesa zodliwa zose.)<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Kakale wakati, “Kunobhuda munhu ndiko kunowunsa hambgwa. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Nentha yekuti kunobva mukati, kobhuda mumoyo wenhu, mikumbulo mibi, nepinga, nebubava, nebubulayi, nebupombgwe, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />netjiba, neyipa moyo, netjengela, nebupitipiti, nehhiho lakayipa, netukana, nezwikudza, nebulengwe. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Zose izwezwi zwinhu zwibi zobhuda mukati, zwikolonga nhu hambgwa.”<verse eid="MRK 7:23" /></para>
  <para style="s">Bugalimoyo Gwenkadzimayi</para>
  <para style="r">(<ref loc="MAT 15:21-28">Matewu 15.21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Ebva ipapo wakamilika akayenda kuntunhu weTire neSidoni. Wakangina mun'umba, akasada kuti kuzibgwe nenhu; koga aazosumbikika. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Tjinyolotjo, umwe nkadzimayi waka ana nkololokadzi uwe una meyambi wakawha nekukwe, akayenda akaswika ewumpfigamila. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Nkadzimayi iwhoyu waka ali Nghiriki, akazwaligwa muntunhu weFonisiya, muSiriya, wakawunkumbilisisa kuti atate meyambi munkololokadzi uwe. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Koga Yesu wakati kuwunli, “Letja bana batange baguta, ngobe akuzotambunuka kuti utole tjinkwa tjebana uposela mbgwa.”<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />Nkadzimayi wakahandula eti, “Ndobvuma He, koga nayidzo mbgwa dzikusi kwethebuli, dzodla mabvurupfuru anoligiwa nebana.”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Iye akati kuwunli, “Seleba kuko tjiyenda kwawunonda meyambi yabhuda munkololokadzi uwo.”<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Paakaswika kun'umba iye wakanowana meyambi yabhuda munkololokadzi uwe, nsikana alilelezwe panhobo.<verse eid="MRK 7:30" /></para>
  <para style="s">Yesu Unotjidza Mantshi Tjembebebe</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Wakati abva muntunhu weTire epalula pakati kweSidoni akaswika kugungwa leGalile ali pakati kwentunhu weDikapolisi. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Bakahhisa kuwunli umwe waka ali mbebebe kakale ali mantshi. Bakawunkumbila kuti awumbige maboko. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />Wakawuntola akayenda naye ntome bebhuda mugubungano, akasa zwinyala zwizwe muzebe dzidze akapfila mate aka kunha lulimi gugwe. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Wakati alinga pehhugwi kudzimu wakaliga dikahana, akati, <char style="tl">“Efatha,”</char> hapa kuhanduligwa kobva kuti “Hhulika.”<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />Tjinyolotjo zebe dzidze dzika hhulika lulimi gugwe gukasununguka akalebeleka zwakanaka. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Wakabalaya kuti basibudze nhu; koga wakati abalaya kujalo, ibo bakabudza hango yose. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Betjenama kwazo beti, “Unothama zwinhu zose zwakanaka tjose. Unota kuti bomantshi zwiwhe nembebebe dzilebeleke.”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Yesu Unopa Zodliwa Banhu bali Zwiwulu Zwina</para>
  <para style="r">(<ref loc="MAT 15:32-39">Matewu 15.32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Mumahhuba iyawo, kwakati kwakubungana mbunga nkulunkulu kwazo, banhu besina tjabanodla, Yesu wakadana badiyiwa babe, akati kubali, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“Ndowhila ngoni banhu ngentha yekuti bagala nami mahhuba matatu kakale akuna tjabanodla. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Ndikati ngabatjibgwilila kumizi yabo benahhala inowhobakulila bakawila muzila; kakale bamwe babo bakabva kulekule.”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Badiyiwa babe bakahandula beti, “Nhu ungawana poni tjinkwa tjingagutsha banhu bose ibaba ipapa mutjilambanyika?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Wakababhuzwa eti, “Muna zwinkwa zwingana?”</para>
  <para style="p" vid="MRK 8:5">Ibo bakati, “Zwili kutondeka.”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Wakati banhu bagale pasi pamavu; akatola zwinkwa zwili kutondeka, atjiboka kuNdzimu wakazwipemula akazwipa badiyiwa babe kuti bazwipe banhu; badiyiwa bakata bejalo. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Baka bana whobe nhukununu homanana; atjiboka kuNdzimu, wakati nayidzo bo dzipiwe banhu. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Bakadla, bakaguta; bakawolela zwipemu zwezodliwa zwasiyiwa nebanhu zwikahhala zwitundu zwili kutondeka. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Banhu baka bangaswika zwiwulu zwina. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Wakabaletja bakayenda; tjinyolotjo akangina mukepe nebadiyiwa babe, bakayenda kuntunhu weDalimanutha.<verse eid="MRK 8:10" /></para>
  <para style="s">BaFarisi Banokumbila Tjilakidzilo</para>
  <para style="r">(<ref loc="MAT 16:1-4">Matewu 16.1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />BaFarisi bakahha bakatangisa kakabadzana naye, behaka kuti abalakidze tjilakidzilo tjinobva kudzimu, bewunlika. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Wakaliga dikahana, akati, “Tjizekugwana itjetji tjohakilani tjilakidzilo? Lebeswa, ndoti kumuli, akuna tjilakidzilo tjinowhopiwa tjizekugwana itjetji.”<verse eid="MRK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13" />Wakabasiya engina mukepe akabva ipapo akayenda kuyimwe ntha.<verse eid="MRK 8:13" /></para>
  <para style="s">Mbidzo yebaFarisi neyaHherodi</para>
  <para style="r">(<ref loc="MAT 16:5-12">Matewu 16.5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Badiyiwa babe baka bakangan'wa senga tjinkwa; baka bana tjin'ompela koga mukepe. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Wakabalaya, akati, “Mutjenjelele mbidzo yebaFarisi, nembidzo yaHherodi.”<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Bakalebeleka tjekwabo, beti, “Atina tjinkwa.”<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />Yesu eziba nekwako wakati, “Nentha yeni mulebeleka nekuti amuna tjinkwa? Amanhu mawhisisa kene mabonesesa? Mimoyo yenyu mikukutu? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Muna meho koga amutobona, kakale muna zebe koga amutowha? Kakale amutjakumbula? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Pandaka pemulila banhu bali zwiwulu zwihanu zwinkwa zwihanu, makawolela zwitundu zwingana zwezwipemu?”</para>
  <para style="p" vid="MRK 8:19">Bakati, kuwunli, “Gumi nezwibili.”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />“Yezwiya kee, zwaka zwili kutondeka zwakapemuligwa baka bali zwiwulu zwina, makawolela zwitundu zwingana?”</para>
  <para style="p" vid="MRK 8:20">Bakati, “Zwili kutondeka.”<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Wakati kubali, “Ngono amanhu mawhisisa?”<verse eid="MRK 8:21" /></para>
  <para style="s">Yesu Unotjidza Bhofu paBhethisayida</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Bakaswika kuBhethisayida. Bamwe banhu bakahhisa nlume waka ali bhofu, bakawunkumbilisisa kuti awumbhate. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Wakabhata nlume waka ali bhofu neluboko, akawuntungamila baka bhuda munzi; akati awumpfila mumeho, akawumbiga maboko, akawumbhuzwa, eti, “Kuna tjawunobona?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />Wakamilidza meho, akati, “Ndobona banhu; beyenda yenda semiti.”<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Hule kwayikoko wakawumbiga maboko kakale pameho awe; akabona zwakanaka, wakapofunuka akabona zwinhu zose zwili tjimo tjakwako. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Yesu wakawusunungula kuti ayende kanyi kukwe, eti kuwunli, “Usitongogala wangina munzi.”<verse eid="MRK 8:26" /></para>
  <para style="s">Matama aPhethiro nekwaYesu</para>
  <para style="r">(<ref loc="MAT 16:13-20">Matewu 16.13-20</ref>; <ref loc="LUK 9:18-21">Luka 9.18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Yesu wakayendilambeli nebadiyiwa babe, bakayenda kumizi yekuKhesariya Filiphi; belimuzila wakabhuzwa badiyiwa babe, eti, “Banhu banoti ndimi yani?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />Bakahandula beti, “Johane mbvubiki; bamwe banoti ndimwi Elija; bamwe banoti muwumwe webalebesambeli.”<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />Eba eti kubali, “Imwi, moti ndimi yani?”</para>
  <para style="p" vid="MRK 8:29">Phethiro akahandula eti, “Ndimwi Khirisitu.”<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />Wakabalaya kuti basibudze nhu nekukwe.<verse eid="MRK 8:30" /></para>
  <para style="s">Yesu Unoleba Nekwedziyidzika Kukwe Kose Nelufu Gugwe</para>
  <para style="r">(<ref loc="MAT 16:21-28">Matewu 16.21-28</ref>; <ref loc="LUK 9:22-27">Luka 9.22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Wakatangisa badiya kuti Nkololo wenhu wakafanila dziyidzika kwazo, alandugwe ngebawhola nebaphirisiti bakulu nebakwali, ekotjibulawa, hule kwemahhuba matatu ekomuka kakale. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Zwinhu izwezwi wakazwileba patjena. Phethiro akawuntola akatangisa wuntjemela. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />Koga wakati etjebuka ebona badiyiwa babe, akatjemela Phethiro eti, “Ibva hule kwangu Satane! Ngobe awutokumbula zwinhu zweNdzimu koga unokumbula sekumbula kwebanhu.”<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Wakati adana banhu nebadiyiwa babe panhu pan'ompela, akati kubali, “Yani nayani unohaka nditobela ngaazwitoboke atole tjileyanyo tjitje anditobele. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Ngobe kene yani unowholondolodza bupenyu gugwe gowhunlahikila; koga kene yani unolahikigwa nebupenyu gugwe ngentha yangu neyendebo mbuya unowhogulondolodza. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Ngobe kotjidzani kuti nhu awane hango yose, koga ekolahikigwa nebutjilo gugwe? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Ini nhu tjaangapa kuyetila kuti atenge butjilo gugwe? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Ngobe kene yani unahoni nami nematama angu mutjizekugwana itjetji tjihhele bupombgwe netjinya, Nkololo wenhu unowhoba nehoni bo naye, hapa ebuya ali mugudzo laTate babe enabatumwa beNdzimu bakayengemala.”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Wakati kubali, “Ndolebesa ndoti kumuli, kuna bamwe bamile ipapa basingawholabila lufu basanhu bakabona bumambo gweNdzimu guhha nemasimba.”<verse eid="MRK 9:1" /></para>
  <para style="s">Handugwa</para>
  <para style="r">(<ref loc="MAT 17:1-13">Matewu 17.1-13</ref>; <ref loc="LUK 9:28-36">Luka 9.28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Hule kwemahhuba matanhatu Yesu wakatola Phethiro, naJakobe naJohane akayenda nabo pehhugwi kwedombo lefulefu, pabakaba boga; Yesu akahanduka akabe tjimwe tjimo mbeli kwabo. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />Zwiyambalo zwizwe zwakaba zwitjenatjena rwaa, akuna nhu muhango ungazwithama zwikaba zwitjenatjena sayikoko. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Kwakabonakala pabali Elija naMozisi; belebeleka naYesu. <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />Phethiro akati kuna Yesu, “Ndhiyi, kwakanaka kuti tipano; letjani tibake matumba matatu, limwe libe lenyu, limwe libe laMozisi, limwe libe la Elija.” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Baka bohla kwazosa, asingatjazibe kuti angatini.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Kwakaswika gole likabakwitidza, kukabe newhi lakabva mugole, liti, “Iwhoyu ndiye Nkololo wangu wandinoda; muwuwhilile!” <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />Tjinyolotjo bakati betjebuka tjebuka, bakabona kusitjina nhu pabali, kuhhe kwaYesu yega.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Bakati bejita mudombo, Yesu akabalaya kuti basitongobudza iye nhu tjababona, kudza kunoswika lubaka gwemuka kweNkololo wenhu kubafi.<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />Bakadzikitidza, bebhuzwana kuti, “Muka kuna bakatjifa kobvani?” <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />Bakawumbhuzwa kuti, “Nentha yeni bakwali beti Elija wakafanila buya kutanga?”<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Yesu wakahandula eti, “Elija unobuya kutanga kuti agadzikanye zwinhu zose; ngono kwakakwaligwani kuti Nkololo wenhu wakafanila dziyidzika kakale ayetiwe tjinhu tjisina n'hingo? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Koga ndomubudza, Elija wakatjibuya, kakale bakawunthama kose kwabaka beyemula, sekwakwaka kwagwa nekukwe.”<verse eid="MRK 9:13" /></para>
  <para style="s">Yesu Unosunungula Mbisana Ugegwe neMeyambi</para>
  <para style="r">(<ref loc="MAT 17:14-21">Matewu 17.14-21</ref>; <ref loc="LUK 9:37-43">Luka 9.37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Bakati beswika kubamwe badiyiwa, bakabona bunga lebanhu gulugulu lakabakombeledza bakwali bekakabadzana nabo. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Tjinyolotjo banhu bose bebona Yesu, bakaba nekuhanha kukulu, bakawuntihhilila benowunlezwa. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />Wakababhuzwa eti, “Mokakabadzana nabo nekweni?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Umwe nlume mubunga wakahandula eti, “Ndhiyi, ndahhisa mbisana wangu kumuli, ugegwe nemeyambi inowunkon'wesa lebeleka. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Meya iyeyo hapa iwunswikila, inowumposela pasi. Unobhuda mafulo munlomo, unolobanya meno kakale unowoma mbili. Ndakumbila badiyiwa benyu kuti bayitate, koga bakonegwa.”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Yesu akahandula eti, “Ekee! Tjizekugwana tjisina bugalimoyo, ndowhoba namwi kukadza kukaba lini? Ndowhomuyetila moyonlefu kukadza kukaba lini? Muwunhhise kundili.” <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Ndizo bakawun'hhisa kuwunli.</para>
  <para style="p" vid="MRK 9:20">Meya ikati ibona Yesu, tjinyolotjo ikawumbhata mbisana, akawila pasi ikawunkayikanya, ikawumposela pasi, akabhuda mafulo munlomo. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />Yesu wakabhuzwa tatayi, eti, “Wabe nelubaka gungapani akajali?”</para>
  <para style="p" vid="MRK 9:21">Tatayi bakahandula beti, “Kubvisila atjimwana. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />Inosowumposela mumoto nemuvula kuti iwumbulaye. Koga hapa kuna tjamungathama, mutiwhile ngoni, mutitjidzeni.”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Yesu wakahandula, eti, “Zwinhu zose zose zoyetikala kuna iye unogalamoyo.”<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Tjinyolotjo tate bembisana bakalebela pehhugwi, beti, “Ndogalamoyo, munditjidze ndikunde kusagalamoyo kwangu!”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Yesu wakati ebona kuti mbunga webanhu unolabuka uhha kubali, akatjemela meyambi eti, “Iwe meya yembebebe nebhubulazebe, ndoti bhuda muwunli usipamhe ukahanduka kakale.”<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Hule kwemimila newunkayikanya zwakayipa yakabhuda muwunli. Mbisana wakalingika sewafa; banjinji bakati, “Watjifa.” <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Koga Yesu wakawumbhata neluboko akawumilidza, akama.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Yesu atjingina mun'umba, badiyiwa babe bakawumbhuzwa bali boga beti, “Kungentha yeni iswi takonegwa yitata?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />Wakabahandula eti, “Whogu ludzi gobhuda koga ngentembezelo.”<verse eid="MRK 9:29" /></para>
  <para style="s">Yesu Unopamha Leba Nekwelufu Gugwe</para>
  <para style="r">(<ref loc="MAT 17:22-23">Matewu 17.22-23</ref>; <ref loc="LUK 9:43-45">Luka 9.43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Bakamilika beyenda, bakapalama muGalile. Yesu waka asingade kuti kube nenhu unoziba kuti baponi; <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />nentha yekuti waka ediya badiyiwa babe. Wakati kubali, “Nkololo wenhu unowhonotugwa mumaboko ebanhu, banowhowumbulaya; hapa abulawa, hule kwemahhuba matatu unowhomuka.”<verse eid="MRK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32" />Koga abazotongowawhisisa matama iyawa, kakale bakabehla wumbhuzwa nekwako.<verse eid="MRK 9:32" /></para>
  <para style="s">Ndiyani Nkulu Pabamwe?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Matewu 18.1-5</ref>; <ref loc="LUK 9:46-48">Luka 9.46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Bakaswika kuKhaphenawume. Akati ali mun'umba akababhuzwa eti, “Mamukakabadzana nekweni tilimuzila?”<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />Koga bakanyalala nentha yekuti belimuzila baka bekakabadzana nekuti ndiyani nkulu pabamwe. <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />Wakagala pasi, akadana bose baligumi nebabili akati, “Hapa nhu ehaka kuti abe wekutanga, wakafanila kuti abe webupelo, kakale abe nlanda wabo bose.” <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />Wakatola mwana ntukununu akawumisa pakati kwabo; akati awumilidza mumaboko awe, akati kubali, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“Kene yani unowamutjila mwana unonga iwhoyu muzina langu unowamutjila imi; kakale kene yani unondiwamutjila, haatowamutjila imi koga unowamutjila iye wakandituma.”<verse eid="MRK 9:37" /></para>
  <para style="s">Usingagwisane Naswi Ndewedu</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luka 9.49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Johane eba eti kuwunli, “Ndhiyi, tabona umwe nlume etata meyambi nezina lenyu tikawunlambisa, ngobe asi umwe wedu.”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Yesu wakahandula eti, “Musiwunlambise. Akuna nhu unothama n'hingo nkulunkulu muzina langu ungabva mulubakanyana ehanduka eleba zwakayipa nekwangu, <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />ngobe kene yani usingagwisane naswi ndewedu. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Lebeswa, ndoti kumuli, nhu unomupa nkombe wevula kuti mun'we ngobe muli baKhirisitu, haatowholahikigwa nembhayilo uwe.”<verse eid="MRK 9:41" /></para>
  <para style="s">Zwiliko Zwejinyo</para>
  <para style="r">(<ref loc="MAT 18:6-9">Matewu 18.6-9</ref>; <ref loc="LUK 17:1-2">Luka 17.1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />“Kene yani unothama kuti ibaba batjetjana banogalamoyo mundili batjinye, kowhobe kuli kuhine kuwunli kuti aposegwe mugungwa akasungiligwa hongwe whuluwhulu muntshibha. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Hapa luboko gugo gukuta kuti utjinye, uguthubule. Kuhine kuti ungine mubutjilo ulitjilema, pana kuti uyende kugehena unamaboko mabili, kuna moto usingadzime. <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />(Kuna gonye lisingafe, nemoto usingadzime.) <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Hapa gumbo lilo lita kuti utjinye, ulithubule. Kuhine kuti ungine mubutjilo unagumbo lin'ompela pana kuti uposegwe mugehena unamakumbo mabili. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />(Kuna gonye lisingafe, nemoto usingadzime.) <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Hapa hhiho lilo lita kuti utjinye, ulikopole. Kuhine kuti ungine mubumambo gweNdzimu unahhiho lin'ompela pana kuti uposegwe mugehena unameho mabili, <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />kuna gonye labo lisingafe, nemoto usingadzime.”<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />“Ngobe umwe nemwe unowhotjenesewa ngemoto, semunyu utjenesa tjibhayilo.”<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />“Munyu wakalulama, koga hapa munyu usingatjawhakale babilila, ungamusidzigwa tjini kakale?”</para>
  <para style="p" vid="MRK 9:50">“Ibani nemunyu mumuli, mugalisane nekunyalala.”<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Unodiya Nekwelambana Mubukwe</para>
  <para style="r">(<ref loc="MAT 19:1-12">Matewu 19.1-12</ref>; <ref loc="LUK 16:18">Luka 16.18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Yesu wakamilika muhango iyeyo akayenda kuhango yeJudiya seli yaJorodani. Mabunga ebanhu akahha kakale kuwunli; segala kukwe, wakabadiya.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Bamwe baFarisi bakahha kuwunli bekawunlika nembhuzo beti, “Kumunlayo kuti nlume alambane nenkadzi uwe?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Wakabahandula eti, “Mozisi wakamulaya etini?”<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />Bakahandula beti, “Mozisi wakabvumila kuti nlume akwalile nkadzi lukwalo gwelambana awuntate.”<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Koga Yesu wakati kubali, “Ngentha yebukukutu gwemimoyo yenyu wakamukwalila nlayo iwhoyu, <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Koga kubvila kutangisa, ‘Ndzimu wakabathama wetjilume newetjikadzi.’ <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />‘Ngentha yayikoku nlume unowhosiya tatayi namayi akanamatilana nenkadzi uwe, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />kakale bubili gwabo banowhoba nyama in'ompela.’ Ndizo abatjibabili, batjiba nyama in'ompela. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Tjabhatshanyiwa neNdzimu, kusibe nenhu unotjipalalanya.”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Batjibe mun'umba, badiyiwa bakabhuzwa Yesu kakale nekwendebo iyeyi. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Wakahandula eti, “Kene yani unolambana nenkadzi uwe, etola umwe nkadzi, unothama bupombgwe kuwunli. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Nenkadzi unolambana nenlume uwe, etogwa newumwe nlume, unothama bupombgwe nawe.”<verse eid="MRK 10:12" /></para>
  <para style="s">Yesu Unokombolela Bana Batjetjana</para>
  <para style="r">(<ref loc="MAT 19:13-15">Matewu 19.13-15</ref>; <ref loc="LUK 18:15-17">Luka 18.15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Banhu baka behhisa bana batjetjana kunaYesu kuti ababhate. Badiyiwa babe bakabatjemela. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Yesu ekubona ikoku, wakamon'wa. Akati kubali, “Bvumilani bana bahhe kundili, musibadzibise, ngobe bumambo gweNdzimu ndegwebakajali. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Lebeswa ndoti kumuli, kene yani usingowhowamutjila bumambo gweNdzimu semwana ntjetjana atowhogungina.” <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Wakabaguga, akabakombolela ebabiga maboko.<verse eid="MRK 10:16" /></para>
  <para style="s">Nlume Wakafuma</para>
  <para style="r">(<ref loc="MAT 19:16-30">Matewu 19.16-30</ref>; <ref loc="LUK 18:18-30">Luka 18.18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Wakati eyenda muzila, umwe nlume akawuntihhilila akaswika epfigama mbeli kukwe, eti, “Ndhiyi wakalulama, ini tjandingathama kudze ndiwamutjile butjilo gusingapele?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />Yesu wakawun'handula eti, “Nentha yeni unditi ndakalulama? Akuna wakalulama kuhhe kweNdzimu koga. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Noyiziba milayo inoti. ‘Usibulaye, Usite bupombgwe, Usikhwibe, Usipe buswupi gwemanyepwa, Usitjebele, Lemekedza meyabo natate babo.’ ”<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Wakawun'handula eti, “Ndhiyi, yose iyeyi ndakayitobela kubvila nditjintjetjana.”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Yesu wakawunlinga akawundha. Akati kuwunli, “Notayila netjinhu tjin'ompela; yenda unotengesa kose kwawunako, upe bahayi, nowhoba nefumwa kudzimu; ukotjibuya, unditobele.” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />Matama iyawa akawumpedza masimba. Wakayenda ana buyendasi mumoyo ngobe waka anafumwa njinji.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Yesu wakatjebuka akati kubadiyiwa babe, “Kolema seni kuti bakafuma bangine mubumambo gweNdzimu!”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Badiyiwa bakatjenamisiwa nematama awe. Koga Yesu wakati kakale kubali, “Bana bangu, kobalemela seni ibabo banogalabgwe mufumwa kuti bangine mubumambo gweNdzimu! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Kulelulelu kuti kamela lipalame muhuli yelunji pana kuti mfumi angine mubumambo gweNdzimu.”<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Badiyiwa bakatjenama kwazo, bakabhuzwana beti, “Ngono ndiyani ungatjidziwa?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Yesu wakabalinga akati kubali, “Nenhu akutoyetika, koga kusini neNdzimu; ngobe neNdzimu, zwinhu zose zoyetika.”<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Phethiro wakati kuna Yesu, “Bonani, iswi takasiya kose tikatobela imwi.”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Yesu wakahandula eti, “Lebeswa ndoti kumuli, akuna nhu wakasiya nzi kene bakuluyi kene banun'una kene hazwadzi kene mayi kene tatayi kene bana kene minda, nentha yangu neyendebo mbuya, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />usingowhowamutjila kwakapamhiwa ka gulu ngwenuwali mulubaka igogu, mizi nebakuluyi nebanun'una nedzihazwadzi nabome nebana nedziminda, kose nedziyidziwa, nebutjilo gusingapele mutjibaka tjinohha. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Koga banjinji bekutanga banowhoba bebupelo; nebebupelo banowhoba bekutanga.”<verse eid="MRK 10:31" /></para>
  <para style="s">Yesu Unoleba Gwebutatu Nekwelufu Gugwe</para>
  <para style="r">(<ref loc="MAT 20:17-19">Matewu 20.17-19</ref>; <ref loc="LUK 18:31-34">Luka 18.31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Bakabelimuzila beyenda kuJerusalema, bakatungamigwa naYesu; badiyiwa bakatjenama, bakabetobela bakabehla. Wakatola kakale baligumi nebabili akama nabo ntome akatangisa babudza nekunowhoyetikala kuwunli, <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />eti kubali, “Whililani, toyenda kuJerusalema; Nkololo wenhu unowhotugwa kubaphirisiti bakulu nebakwali. Bakawuntongela bulawa kakale banowhowuntula kuBataya; <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />banowhowunkuwelela, bakawumpfila, bakawunloba, kakale banowhowumbulaya; hule kwemahhuba matatu unowhomuka.”<verse eid="MRK 10:34" /></para>
  <para style="s">Tjikumbilo tjaJakobe naJohane</para>
  <para style="r">(<ref loc="MAT 20:20-28">Matewu 20.20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Kwakahha kuwunli Jakobe naJohane, bakololo baZebhedi, bakati kuwunli, “Ndhiyi, toyemula kuti mutiyetile kene ini tjatinokumbila.”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />Wakababhuzwa eti, “Moyemula kuti ndimuyetileni?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />Bakahandula beti, “Mutibvumile tigale umwe kuludli, umwe kulumehwe, mugudzo lenyu.”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />Koga Yesu wakahandula eti, “Amutoziba tjamunokumbila. Mungan'wa nkombe wandinon'wa kene mungabvubikiwa nezila yandinowhobvubikiwa ndiyo?”<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />Bakati kuwunli, “Totubula.”</para>
  <para style="p" vid="MRK 10:39">Yesu akati kubali, “Mowhon'wa nkombe wandinowhon'wa; kakale mowhobvubikiwa bvubikiwa kwandinowhobvubikiwa ndiko, <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />koga kwegala kuludli gwangu kene kulumehwe gwangu akuta imi unokubvumila; koga ndekwayibabo kwakwaka baakanyigwa.”<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Bamwe baligumi bakati bekuwha bakagwadziligwa Jakobe naJohane. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Yesu wakabadana, akati kubali, “Moziba kuti ibabo bakafanila tonga Bataya banobatshambidzila; nebanobatungamila banohingisa masimba pehhugwi kwabo. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Koga akuzofanila kuti kujalo kumuli; koga kene yani unowhoba nkulu pakati kwenyu wakafanila ba n'hingi wenyu; <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />kakale unohaka kuti abe wekutanga pakati kwenyu wakafanila kuti abe nlanda wayibo bose. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Ngobe kene iye Nkololo wenhu haazohhila kuti awhohingigwa, koga wakahhila whohingila nepa butjilo gugwe kuti gube tjibhayilo tjebanjinji.”<verse eid="MRK 10:45" /></para>
  <para style="s">Yesu Unolapa Bhofu Bhathimewusi</para>
  <para style="r">(<ref loc="MAT 20:29-34">Matewu 20.29-34</ref>; <ref loc="LUK 18:35-43">Luka 18.35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Bakaswika kuJerikho. Kwakati Yesu nebadiyiwa babe kose negubungano lebanhu gulugulu bebhuda muJerikho, umwe nlume webhofu unoyi Bhathimewusi, nkololo waThimewusi, waka aligele ntome kwezila ekumbila lubhatsho, <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />paakati ewha kuti ndiYesu weNazaretha akatangisa mimila eti, “Yesu, Nkololo waDavida, mundiwhile ngoni!”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Banhu banjinji bakawuntjemela bakawumbva kuti anyalale, koga wakayendilambeli emimilila pehhugwi kwazo eti, “Nkololo waDavida, mundiwhile ngoni!”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Yesu wakama akati, “Muwundhaneni.”</para>
  <para style="p" vid="MRK 10:49">Ndizo bakalidana ilelo bhofu beti kulili, “Iba netjilopa; milika, unokudana!”<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />Lakalahila kutjena ngubo yalo, likapapadzuka likayenda kuna Yesu.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />Yesu wakati kulili, “Unohaka kuti ndikutileni?”</para>
  <para style="p" vid="MRK 10:51">Bhofu lakahandula liti, “Rabhi, ndohaka kuti ndibone.”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Yesu wakati kuwunli, “Tjiyenda, galamoyo kuko kwakuthama ukanaya.”</para>
  <para style="p" vid="MRK 10:52">Tjinyolotjo wakabva apofunuka, akatobela Yesu muzila.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Yesu Unongina muJerusalema saMambo</para>
  <para style="r">(<ref loc="MAT 21:1-11">Matewu 21.1-11</ref>; <ref loc="LUK 19:28-40">Luka 19.28-40</ref>; <ref loc="JHN 12:12-19">Johane 12.12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Bakati batjibapedlo neJerusalema, pedlo neBhethifeji neBhethani, padombo leMitoba, wakatuma badiyiwa babe babili, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />eti kubali, “Yendani kunzi umbeli kwenyu, hapa mungina mowhowana gondolo lekakambe lisakatongotan'wa nenhu lakasungiligwa. Mulisunungule mubuye nalo. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Kukaba nenhu unomubhuzwa eti, ‘Mokuyetilani ikoku?’ muwumbudze kuti, ‘He banohaka lihingisa, banowholihandusa nekulibilidza.’ ”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />Bakayenda bakanowana gondolo lakaswungiligwa pankoba kuhhe, pedlo nezila. Bakalisunungula. <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />Banhu baka belimile ipapo bakababhuzwa beti, “Mothamani, mosunungulilani gondolo lekakambe ilelo?”<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />Bakabahandula selayiwa kwabo naYesu, banhu ibabo bakabaletja bakayenda. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Bakabuya nalo gondolo lekakambe kuna Yesu, bakatilika ngubo dzabo pehhugwi kwalo, akalitanha. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Nebanhu banjinji bakawala zwiyambalo zwabo muzila, bamwe bakawala nhabi dzinamahhani dzabakabatema muminda. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Bakatungamila mbeli nebaka betobela baka pululudza beti, “Whosana! Wakakombolegwa iye unohha muzina laHe! <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />Gwakakombolegwa bumambo gunohha, bumambo gwatate bedu Davida! Whosana pehhugwihhugwi!”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Yesu wakaswika muJerusalema, akangina muthempeli; atjilinga tjimwe netjimwe, saku kwaka kwatjihwa, wakamilika eyenda kuBhethani nebadiyiwa babe baligumi nebabili.<verse eid="MRK 11:11" /></para>
  <para style="s">Yesu Unotuka Nkuyu</para>
  <para style="r">(<ref loc="MAT 21:18-19">Matewu 21.18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Tjimuka bebva kuBhethani, Yesu wakaatjiba nehhala. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Ebona nkuyu unamahhani uli tjakule nyana, wakasedzela eti pamwe angawana makuyu. Koga akawana usakazwala unamahhani koga, ngobe kwakakusi lubaka gwezwala kwawo. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Eba etuka nti iwhoyo eti, “Kusitjabe nenhu unowhotongodla mitjelo iyo kene lini.”</para>
  <para style="p" vid="MRK 11:14">Badiyiwa babe bakawuwha ejalo.<verse eid="MRK 11:14" /></para>
  <para style="s">Yesu Unongina muThempeli</para>
  <para style="r">(<ref loc="MAT 21:12-17">Matewu 21.12-17</ref>; <ref loc="LUK 19:45-48">Luka 19.45-48</ref>; <ref loc="JHN 2:13-22">Johane 2.13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Beswika muJerusalema, Yesu wakangina muthempeli eba etangisa tata ibabo baka betenga netengesa mukati. Wakapitula mathebuli ebaka betengesa mari nezwigalo zwayibabo baka betengesa njiba; <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />asongobvumila kuti kube nenhu unopalama muthempeli ana tjaakasenga. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Wakadiya, akati kubali, “Akuzokwagwa kuti, ‘N'umba yangu inowhodan'wa kuyi in'umba yentembezelo yenjudzi dzose’? Koga imwi matjiyithama guwhu lembava.”<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Baphirisiti bakulu nebakwali bakakuwha ikoku, bakahaka sekwabanga wumbulaya; baka bewunhla, nentha yekuti mbunga wose waka utjenamisiwa nediya kukwe.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />Hhuba latjihwa bakabhuda munzi-nkulu.<verse eid="MRK 11:19" /></para>
  <para style="s">Tjidiyo Tjinobva paNkuyu</para>
  <para style="r">(<ref loc="MAT 21:20-22">Matewu 21.20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Tjimuka mangwanana bepinda, bakabona nkuyu iwhoya watjiwoma kubvila kumidzi. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Phethiro wakaalakana, eba eti kuna Yesu, “Rabhi, lingani! Nkuyu wamakalonga bhiso watjiwoma!”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />Yesu wakahandula eti, “Galanimoyo kuNdzimu. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Lebeswa, ndoti kumuli, hapa kene yani eti kudombo ileli, ‘Sipuka, uwile mugungwa,’ kakale esingan'un'une mumoyo uwe koga egalamoyo kuti tjaanoleba tjowhoyetikala, unowhotjitigwa. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Ndizo ndomubudza, kene ini tjamunokumbila ngentembezelo, galanimoyo kuti matjitjiwamutjila, mowhoba natjo. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Hapa mutembezela, kunanhu wamakagwadziligwa, muwuyetile mazwibhatigwa, kuyetila kuti Tate babo bakudzimu bamuyetile bo mazwibhatigwa matjinyo enyu. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />(Koga hapa musingayetile bamwe mazwibhatigwa matjinyo abo, naTate babo bakudzimu abatowhomuyetila bo mazwibhatigwa matjinyo enyu.)”<verse eid="MRK 11:26" /></para>
  <para style="s">Mbhuzo nekweSimba laYesu</para>
  <para style="r">(<ref loc="MAT 21:23-27">Matewu 21.23-27</ref>; <ref loc="LUK 20:1-8">Luka 20.1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Bakabgwilila kakale kuJerusalema, lubaka Yesu eyendayenda muthempeli, baphirisiti bakulu nebakwali nebawhola bakahha kuwunli, <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />bakati, “Zwinhu izwezwi nozwihinga nesimba lipi, kene ndiyani wakakupa simba kuti uzwithame?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />Yesu wakabahandula eti, “Ndowhomubhuzwa mbhuzo un'ompela; mundihandule, ndiko kwandinowhomubudza kuti kungesimba lipi ndihinga izwezwi zwinhu. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Bvubika kwaJohane, kwakakubva kudzimu, kene kubanhu? Mundihandule!”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Baka kakabadzana tjekwabo, beti, “Hapa titi, ‘Kwakabva kudzimu,’ unowhoti, ‘Nentha yeni ngono musakagalamoyo muwunli?’ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Ngono titi, ‘Kwakabva mubanhu?’” (Bakabehla banhu, ngobe wose nhu waka eti Johane waka ali nlebesambeli welebeswa.) <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Ndizo bakahandula Yesu beti, “Atitoziba.”</para>
  <para style="p" vid="MRK 11:33">Yesu eba eti bo kubali, “Nami bo anditowhomubudza kuti kunge simba lipi ndithama zwinhu izwezwi.”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Tjifananidzo Tjebakasayidziwa Minda yeMahhambi</para>
  <para style="r">(<ref loc="MAT 21:33-46">Matewu 21.33-46</ref>; <ref loc="LUK 20:9-19">Luka 20.9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Wakatangisa lebeleka nabo nezwifananidzo eti, “Umwe nlume wakalima minda yemahhambi. Akayihoha, akatsha gomba leswinila wayini, kakale akabaka dumba lefulefu lebalindi. Wakabva eyisayidza bamwe balimi, akabe eyenda kuyimwe hango. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Kwakati kwaswika lubaka gwemahhambi akabe etuma nlanda uwe kuna baakasayidza minda kuti anopiwa gobe lemitjelo yeminda. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Koga bakawumbhata bakawunloba, bakawuntata besina tjabawumpa. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Akatuma umwe webalanda babe kubali kakale, bakaswika bewumphobola mun'holo, bakawumbhata nezila inobhatisa honi. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Akatuma umwe kakale, iwhoyo bakaswika bewumbulaya; nebamwe banjinji, bamwe bakaswika bebaloba, bamwe bakaswika bebabulaya. <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />Waka atjisaligwa newun'ompela waangatuma, nkololo uwe waaka eda. Wakaba iye webupelo waakatuma, eti, ‘Swiyo banowhoba nemazwibhato kunkololo wangu.’ <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />Koga ibabo baka basayidziwa minda bakati umwe kuwumwe, ‘Iwhoyu ndiye nghalinhaka uwe. Buyani, tiwumbulaye, nhaka ibe yedu.’ <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Ndizo bakawuntola bakawumbulaya, bakawumposela kuhhe kweminda yemahhambi.”<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />“Mweni weminda unowhothamani? Unowhohha ebapaladza bose, etola minda epa bamwe. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Amuzotongobala lukwalo igogu.</para>
  <para style="q1" vid="MRK 12:10">“ ‘Bgwe ilo tjekwalo lakalambiwa nebabaki</para>
  <para style="q2" vid="MRK 12:10">ndilo latjiba bgwe linotambunudza mbako.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />Ikoku kwaka kuli thama kwaHe,</para>
  <para style="q2" vid="MRK 12:11">kakale kohanhisa mumeho edu’?”<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Bakayedza wunsunga, ngobe beziba kuti tjifananidzo tjaayeleba wayebva ibo. Koga bakabehla mbunga webanhu, ndizo bakawunsiya bekayenda.<verse eid="MRK 12:12" /></para>
  <para style="s">Mbhuzo Nekwelipa Luketo</para>
  <para style="r">(<ref loc="MAT 22:15-22">Matewu 22.15-22</ref>; <ref loc="LUK 20:20-26">Luka 20.20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Bakawuntumila Bafarisi nebanhu baHherodi, kuti bawumbhatshile muzwilebo zwizwe. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Bakahha kuwunli bakati, “Ndhiyi toziba kuti imwi mumulebeswa. Amuna hanya kuti nhu ndiyani, ngobe amuneni netjigalo tjenhu; koga modiya zila yeNdzimu ngelebeswa. Kumunlayo lipa luketo kuna Khesari kene akuta munlayo? Tikete kene tisikete?”<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />Koga iye eziba kuzwitisa kwabo. Wakababhuzwa eti, “Mondilikilani? Hhisani ngeno loso, ndibone.”<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />Bakawumpa, eba eti kubali, “Ibuso gwani igogu, kakale kwakakwagwa ngekwayani mulili?”</para>
  <para style="p" vid="MRK 12:16">Beba behandula beti, “NdegwaKhesari.”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Yesu eba eti kubali, “Ipani Khesari kwaKhesari neNdzimu kweNdzimu.”</para>
  <para style="p" vid="MRK 12:17">Bakakaabala mbeli kukwe.<verse eid="MRK 12:17" /></para>
  <para style="s">Mbhuzo Nekwemuka Kubafi</para>
  <para style="r">(<ref loc="MAT 22:23-33">Matewu 22.23-33</ref>; <ref loc="LUK 20:27-40">Luka 20.27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Kwakakotjihha kuwunli baSadusi, ibo banoti akuna muka kubafi; bakawumbhuzwa mbhuzo, beti, <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“Ndhiyi, Mozisi wakatikwalila nlayo kuti hapa nkadzi efigwa nenlume besina mwana, nun'una wenlume wakafanila ngina nkadzi iwhoyo, azwalile nkuluyi bana. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Ndizo kwakakuna bakololo benhu un'ompela bali kutondeka. Mbano yakatola nkadzi ikakotjinyika basina bana. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Webubili wakangina nkadzi iwhoyo, koga wakafa bo besina bana. Ndiko zwako kwakayetikala kuna webutatu. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Bose beli kutondeka, akuna wakaba nemwana nayiwhoyo nkadzi. Iwhoyo nkadzi wakapedzisila afa bo. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Ngono pakumuka kubafi, nkadzi iwhoyo unowhobe wani? Ngobe bose bali kutondeka wakaba nkadzi wabo.”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Yesu wakati kubali, “Saziba whalo kene masimba eNdzimu ateyiko kunota mukalahika wali? <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Ngobe hapa bakafa bemuka, abatjalobola kene lobogwa; koga beenga batumwa kudzimu. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Ngono ngekwemusiwa kwebafi, amuzobala mulukwalo gwaMozisi, panolebgwa nekwedenje lemhiwa, kuti Ndzimu wakati kuwunli, ‘NdiNdzimu waAbhurahhamu, Ndzimu wa Isaka, Ndzimu waJakobe’? <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Haata Ndzimu webanhu bakafa, koga ndiNdzimu webanhu bapenyu. Makalahika kwazo!”<verse eid="MRK 12:27" /></para>
  <para style="s">Nlayo Nkulu Kupinda Yose</para>
  <para style="r">(<ref loc="MAT 22:34-40">Matewu 22.34-40</ref>; <ref loc="LUK 10:25-28">Luka 10.25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Umwe webakwali wakaswika akabawha bekakabadzana. Ebona kuti Yesu wabapa n'handulo yakanaka, wakabhuzwa Yesu eti, “Ndiwupi nlayo unkulu kupinda yose?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Yesu wakahandula eti, “Nlayo unkulu kuyimwe yose ndiwhoyu unoti, ‘Whilila Isirayeli, He Ndzimu wedu, ndiye yega He. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Ude He Ndzimu uwo ngemoyo uwo wose, nange meya iyo yose, nange nkumbulo uwo wose kakale ngemasimba awo wose.’ <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Webubili ndiwhoyu, ‘Ida mbakidzani uwo nezila yawunozwida iwe.’ Akuna nlayo unopinda iyeyi milayo.”<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />Nkwali wakahandula eti, “Maleba zwakanaka, Ndhiyi. Ilebeswa kuti Ndzimu un'ompela, akuna umwe kuhhe kukwe. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Wundha ngemoyo uwo wose, nange whisisa kuko kose, nange masimba awo wose, neda mbakidzani uwo nezila yawunozwida iwe, kopinda yose mipilo inopisiwa nezwibhayilo zose.”<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />Yesu wakati ebona kuti wahandula zwakanaka akati kuwunli, “Awuta uli kulekule nebumambo gweNdzimu.”</para>
  <para style="p" vid="MRK 12:34">Hule kwayipapo akuna wakatongoda wumbhuzwa mibhuzo kakale.<verse eid="MRK 12:34" /></para>
  <para style="s">Mbhuzo nekwaMesiya</para>
  <para style="r">(<ref loc="MAT 22:41-46">Matewu 22.41-46</ref>; <ref loc="LUK 20:41-44">Luka 20.41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Yesu ediya eli muthempeli wakabhuzwa eti, “Nentha yeni bakwali beti Khirisitu unkololo waDavida? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Davida tjekukwe, eleba ngeMeya Yakayengemala, wakati.</para>
  <para style="q1" vid="MRK 12:36">“ ‘He wakati kuna He wangu.</para>
  <para style="q2" vid="MRK 12:36">Gala kuluboko gwangu gweludli</para>
  <para style="q2" vid="MRK 12:36">ndidze ndilonge zwita zwizo kusi kwemakumbo awo.’<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />Davida nekukwe unowundhana eti He; koyetikala tjini ngono kuti abe nkololo uwe?”</para>
  <para style="s" vid="MRK 12:37">Yesu Unotjenjedza Banhu nekweBakwali</para>
  <para style="r" vid="MRK 12:37">(<ref loc="MAT 23:1-36">Matewu 23.1-36</ref>; <ref loc="LUK 20:45-47">Luka 20.45-47</ref>)</para>
  <para style="p" vid="MRK 12:37">Lukawu gwebanhu gwakawuwhilila nekuhanha. <verse eid="MRK 12:37" /><verse number="38" style="v" sid="MRK 12:38" />Muzwidiyo zwizwe wakati, “Mutjenjelele bakwali, banoda yendayenda bakambala zwiyambalo zwilefulefu nebuyisiwa munhanga dzetengesela, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />kakale banoda piwa zwigalo zwakanaka mumasinagogu nebugalo gwebanhu banagudzo panobe pedliwa. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Banotjebela njhilikadzi bedzitolela nhundu nezwimun'umba dzadzo, beyeta mahonga ndibon'we ngemitembezelo milefulefu. Banowhowanikwa nlandu nkulunkulu.”<verse eid="MRK 12:40" /></para>
  <para style="s">Tjipo tjeTjilikadzi</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luka 21.1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Yesu wakagala ntome kwayipapo paka pesiwa zwipo akalinga kuti banhu banopa mari tjini museme. Bakafuma banjinji baka beposela mari njinji. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Kwakabuya umwe n'hayi wetjilikadzi akaswika eposela madlanyana mbili dzinolizana nemaloso ekhopa. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />Wakadana badiyiwa babe akati, “Lebeswa, ndoti kumuli, n'hayi wetjilikadzi iwhoyu wasa museme kunopinda kwebamwe banhu bose. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Ngobe bose ibaba banokola mufumwa yabanayo bakasa museme, koga iye mubuhayi gugwe, wasa yose mari yaanayo mubutjilo gugwe gose.”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Yesu Unoleba Nekwekolomoka kweThempeli</para>
  <para style="r">(<ref loc="MAT 24:1">Matewu 24.1</ref>,<ref loc="MAT 24:2">2</ref>; <ref loc="LUK 21:5-6">Luka 21.5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Wakati ebhuda muthempeli, umwe webadiyiwa babe akati kuwunli, “Ndhiyi, lingani kuti mabgwe akanaka tjini, nezwakabakwa, kuti zwakanaka tjini!”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />Yesu wakawun'handula eti, “Nobona zwibakwa zwikulu izwezwi? Akuna bgwe linowhosala lilipehhugwi kwelimwe ipapa, lisingowholigigwa pasi.”<verse eid="MRK 13:2" /></para>
  <para style="s">Mamanikano neDziyidziwa</para>
  <para style="r">(<ref loc="MAT 24:3-14">Matewu 24.3-14</ref>; <ref loc="LUK 21:7-19">Luka 21.7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Wakati egala paDombo leMitoba lakalingisana nethempeli, Phethiro, naJakobe, naJohane na Andhireya bakawumbhuzwa baliboga beti, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“Mutibudzeni, tjowhobe tjili tjipi, ini tjinowhobe tjilakidzilo hapa zwinhu zose izwezwi zwehhadzisika?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Ndizo Yesu wakati kubali, “Mutjenjele kuti kusibe nenhu unomulaha. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Banjinji banowhohha muzina langu beti, ‘Ndi iye!’ banowholaha banhu banjinji. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Koga hapa muwha nekwengwa nebunyebenyebe nekwengwa musilobgwe nehana; ngobe zwinhu izwezwi zwakafanila yetikala, koga bupelo gowhobe gusanhu gukaswika. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Ngobe tjaba tjowhomukila tjimwe tjaba, nebumambo gowhomukila gumwe bumambo; kowhoba netengenyeka kwehango mumitunhu yakasiyana, kowhobe nebhamba; izwezwi zwinhu zowhobatanga kwelayidza gwadza kwelubaka gunohha.”<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />“Koga imwi mutjenjele ngoba banowhomuyendesa kumbahhe, mowholobgwa mumasinagogu; mukamisiwa mbeli kwebabhati bemitunhu nabomambo ngentha yangu, gulibusupi kubali. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Ndebo mbuya yakafanila tanga yasumikigwa mutjaba tjose kutanga. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Koga hapa bemusunga bemuyendesa kulubahhe musidziyidzike nekuti mowholebani; koga mulebe kene ini kwamunowhopiwa nayigogo lubaka, ngobe koba kusi imwi munolebeleka, koga kuli Meya Yakayengemala. <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />Nkuluyi nenun'una banowhotengsana kuti umwe abulayiwe, tatayi banowhohandukila mwana, nebana banowhohandukila bazwadzi bakata kuti babulayiwe, <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />kakale mowhobengewa nebanhu bose ngentha yezina langu. Koga unosimidzila kukanoti kubupelo unowhotjidziwa.<verse eid="MRK 13:13" /></para>
  <para style="s">Bubi Gwepaladza</para>
  <para style="r">(<ref loc="MAT 24:15-28">Matewu 24.15-28</ref>; <ref loc="LUK 21:20-24">Luka 21.20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />“Koga hapa mubona mbipo inohemesa yepaladza ili pabugalo gusakafanila (unobala ngaapedzisise), bamuJudiya ngabatihhile kumatombo; <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />upehhugwi kwen'umba asijite, kene iko ngina mun'umba iye, kuti atole tjimwe tjinhu; <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />umuminda asihanduke kuti anotola tjiyambalo tjitje. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Koga kowhobabangalalila ibabo bakazwisenga nebanomwisa mumahhuba iyawo! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Tembezelani kuti ikoku kusitikale mulubaka gwembaba. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Ngoba kowhoba nedziyidzika kukulukulu kusakatongoba yapo kubvila pakutanga kwembumbiko Ndzimu yaakabumba kudza kuba ngwenuwali, akutowhopamha kukabeyapo kakale. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Kadzene He asakathubula mahhuba iyawo, kwakusingawhoba nenhu unotjidziwa; koga nentha yebakahalugwa babe, baakahala, wakathubula mahhuba ihawo.”<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />“Hapa umwe nhu angati, lingani whoyu Khirisitu! kene, lingani whoyaa! musikugalemoyo ikoko. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Kowhohha boKhirisitu bemanyepwa nebalebesambeli bemanyepwa, banowhothama zwilakidzilo nematjenamiso, beyetila kuti balahe banhu, hapa kuyetikala, ibabo bakahalugwa. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Koga mutjenjele ngobe ndatjimubudza zwinhu zose zwisanhu zwaswika.<verse eid="MRK 13:23" /></para>
  <para style="s">Buya kweNkololo weNhu</para>
  <para style="r">(<ref loc="MAT 24:29-31">Matewu 24.29-31</ref>; <ref loc="LUK 21:25-28">Luka 21.25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />“Koga mumahhuba iyawo, hule kwedziyidzika ikoko, hhuba lowhoti zwi, mwedzi awutowhoba ntjena, <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />nyenyedzi dzowhowa dzibva kudzimu, masimba ose akudzimu anowhozunguzika. <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />Ndiko kwabanowhobona Nkololo wenhu ehha eli mumakole ena masimba makulu negudzo. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Kakale unowhotuma batumwa beNdzimu, bakakubunganya bahalugwa babe kubvila kumabhiko mana, kubvila kubupelo gwehango kunoti kubupelo gwekudzimu.<verse eid="MRK 13:27" /></para>
  <para style="s">Tjidiyo tjinobva munti weNkuyu</para>
  <para style="r">(<ref loc="MAT 24:32-35">Matewu 24.32-35</ref>; <ref loc="LUK 21:29-33">Luka 21.29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />“Muzwidiye tjidiyo kubva mutjifananidzo tjenti wenkuyu, hapa lutabi gwawo gwabe gunyolo gutangisa sinila mahhani, moziba kuti tjilimo tjeesedzela. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Kwakajalo bo ke, hapa mubona zwinhu izwezwi zwiyetikala, zibani kuti waba pedlo, waba pankoba. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Lebeswa, ndoti kumuli, tjizekugwana itjetji atjitowhopinda zwinhu zose izwezwi zwisanhu zwayetikala. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Kudzimu nehango kowhopinda, koga matama angu atowhopinda.”<verse eid="MRK 13:31" /></para>
  <para style="s">Akuna Unoziba Hhuba kene Lubaka</para>
  <para style="r">(<ref loc="MAT 24:36-44">Matewu 24.36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />“Koga akuna unoziba nekwehhuba ilelo nelubaka igogo, kene ibo batumwa kudzimu, kene iye Nkololo, kuhhe kwaTate boga. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Tjenjelani mulinde, mutembezele; ngobe amutoziba kuti lubaka gowhoswika lini. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Konga nhu wakayenda kuyimwe hango ikulekule akasiya nzi uwe, ekapa balanda babe masimba, umwe newumwe akalingisana nen'hingo uwe, akalaya nlindi wenkoba kuti agale akalinda. <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />Ndizo lindani ngobe amutoziba kuti mweni wenzi unowhobuya lini, kene madekwana kene pakati kwebusiku, kene mahhakuyedza, kene mangwanana. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Kungayetikala abuye musakalindila, amuwane makayizela. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Kwandinoleba kumuli ndokuleba kubanhu bose, ndoti. Lindani!”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Banolangana kuti babulaye Yesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">Matewu 26.1-5</ref>; <ref loc="LUK 22:1">Luka 22.1</ref>,<ref loc="LUK 22:2">2</ref>; <ref loc="JHN 11:45-53">Johane 11.45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Kwaka kwasala mahhuba mabili kuti kube Phasika nenzano weTjinkwa Tjisina Mbidzo, baphirisiti bakulu nebakwali baka behaka zila yakasumbikala yabangabhata nayo Yesu, bawumbulaye; <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />bakati, “Kusibe palubaka gwenzano, ngobe banhu bangabva bemusa hhoba.”<verse eid="MRK 14:2" /></para>
  <para style="s">Yesu Unohhodzewa Mafuta kuBhethani</para>
  <para style="r">(<ref loc="MAT 26:6-13">Matewu 26.6-13</ref>; <ref loc="JHN 12:1-8">Johane 12.1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Kwakati ali muBhethani mun'umba yaSimoni wakatongoba nebugwele gwemapele, atjigele akapeyama<note caller="+" style="f"><char style="fr" closed="false">14.3 </char><char style="ft" closed="false">bakabedla bakapeyama bena pabakasendama</char></note> edla, kukaswika nkadzimayi akasenga kumbwana tjakatiwa nebgwe linoyi alabhasita, tjemafuta enadi akwako, anantengo upehhugwi, akahha akatjihhula, akaadululila pan'holo waYesu. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />Kuna bamwe bakamon'wa bakalebelesana, beti, “Mafuta iyawa azanisigwani wali? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Ngobe mafuta iyawa aangatengesewa nentengo unopinda madinari ali makhulu matatu<note caller="+" style="f"><char style="fr" closed="false">14.5 </char><char style="fq" closed="false">madinari ali makhulu matatu </char><char style="ft" closed="false">nlipo wegole lose</char></note> kukapiwa bahayi.” Bakan'un'una nekwayetiwa nenkadzimayi iwhoyu.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />Koga Yesu wakati, “Siyanani naye; mowundziyidzilani wali? Wathama tjinhu tjakanaka kundili. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Kana bahayi mogala munabo lubaka gose, hapa muda mungabatila tjakanaka kene gupi lubaka; koga imi atitowhogala tili tose lubaka gose. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Iye wathama tjaanotubula; wahhodza mbili wangu mafuta kutjina lubaka, ewululamisila biganyiwa. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Lebeswa, ndoti kumuli, kene poni panowhosumikigwa ndebo mbuya muhango yose, ikoku kwayetiwa nenkadzimayi iwhoyu kowholebgwa nekwako, kuli tjikumbuludzo nekukwe.”<verse eid="MRK 14:9" /></para>
  <para style="s">Judasi Unobvuma Tengesa Yesu</para>
  <para style="r">(<ref loc="MAT 26:14-16">Matewu 26.14-16</ref>; <ref loc="LUK 22:3-6">Luka 22.3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Judasi Isikariyoti, umwe webaligumi nebabili, wakayenda kubaphirisiti bakulu kuti abatengesele Yesu. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Bakati bekuwha bakahanha, bakawunghadzabgwe kuti banowhowumpa mari. Judasi wakahaka zila yakalulama kuti atengese Yesu.<verse eid="MRK 14:11" /></para>
  <para style="s">Yesu Unodla Tjilayilo neBadiyiwa Babe</para>
  <para style="r">(<ref loc="MAT 26:17-25">Matewu 26.17-25</ref>; <ref loc="LUK 22:7-14">Luka 22.7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Johane 13.21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Muhhuba lekutanga lenzano weTjinkwa Tjisina Mbidzo, lilihhuba laka libhayiwa mhwizana yephasika, badiyiwa baYesu bakati kuwunli, “Mohaka kuti tinomubaakanyila poni kuti mudlile Phasika?”<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Wakatuma badiyiwa babe babili, eti kubali, “Yendani kunzi-nkulu, mowhohangana nenlume wakasenga tjilongo tjevula, muwuntobele, <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />paanowhongina, muti kumweni wenzi, ‘Ndhiyi wati, iponi n'umba yebezi, pandinowhodlila Phasika ndina badiyiwa bangu?’ <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Unowhomulakidza n'umba whulu ipehhugwi, ina zwidla zose yakalinda hingisiwa; mutibaakanyile muyili.”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Badiyiwa bakayenda, bakangina munzi-nkulu, bakawana kuli sekwaababudza; baka baakanya zodliwa zwePhasika.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Kwakati kwatjibe madekwana akabuya nebadiyiwa babe bali gumi nebabili. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Bakati baligele bedla, Yesu akati, “Lebeswa, ndoti kumuli, umwe wenyu unowhonditengesa, iye unodla nami.”<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Bakahhigwa nebuyendasi, umwe newumwe akati kuwunli, “Kungaba imi?”<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />Wakati kubali, “Uwumwe webali gumi nebabili, unoseba nami mundilo. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Ngoba Nkololo wenhu unoyenda sekwakwaka kwagwa nekukwe, koga ndoti kwakawubangalalila iwhoyo nlume unowhotengesa Nkololo wenhu! Kwakowhoba kuhine hapa aasakazwagwa.”<verse eid="MRK 14:21" /></para>
  <para style="s">Tjilayilo tjaHe</para>
  <para style="r">(<ref loc="MAT 26:26-30">Matewu 26.26-30</ref>; <ref loc="LUK 22:14-20">Luka 22.14-20</ref>; <ref loc="1CO 11:23-25">1 BaKhorinte 11.23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Bakati betjadla, Yesu akatola tjinkwa, akaboka kuNdzimu, akatjipemula akabapa eti, “Tolani; umbili wangu iwhoyu.”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Akatola nkombe, akaboka, akabapa, bakan'wa bose. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />Akati kubali, “Malopa angu etjibvumilano iyawa, malopa anotebuligwa banjinji. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Lebeswa, ndoti kumuli, anditjowhon'wa kakale kwemitjelo yemahhambi, kudza kuba ilelo hhuba landinowhokun'wa kuli kutshwa mubumambo gweNdzimu.”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Bakati batjimba lumbo gwakakwagwa, bakabhuda bakayenda kuDombo leMitoba.<verse eid="MRK 14:26" /></para>
  <para style="s">Yesu Unolebesambeli Landugwa Kukwe naPhethiro</para>
  <para style="r">(<ref loc="MAT 26:31-35">Matewu 26.31-35</ref>; <ref loc="LUK 22:31-34">Luka 22.31-34</ref>; <ref loc="JHN 13:36-38">Johane 13.36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Yesu wakati kubali, “Mose mowhopalala; ngobe kwakakwagwa kuti, ‘Ndowhobulaya nlisi, mhwizi dzikapalala.’ <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />Hule kwemusiwa kwangu, ndowhobambeli kwenyu kuyenda kuGalile.”<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />Phethiro wakati kuwunli, “Nekene bose bepalala, imi andingamusiye.”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Koga Yesu wakati kuwunli, “Lebeswa, ndoti kukuli, igogu busiku gwanasi, gukurume lisanhu lalila kabili, nowhoba watjindilandula katatu.”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />Koga Phethiro akaleba nemasimba ose eti, “Kene kulifa namwi, anditowhomulandula.”</para>
  <para style="p" vid="MRK 14:31">Bose bakajalo bo.<verse eid="MRK 14:31" /></para>
  <para style="s">Yesu Unotembezela muGetshemani</para>
  <para style="r">(<ref loc="MAT 26:36-46">Matewu 26.36-46</ref>; <ref loc="LUK 22:39-46">Luka 22.39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Bakaswika pabugalo gunoyi Getshemani; akati kubadiyiwa babe, “Galani pano, nditjanotembezela.” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Wakatola Phethiro, naJakobe naJohane akayenda nabo, akatangisa hhigwa nebuyendasi nedziyidzika kwazo. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Akaba eti kubali, “Meya yangu ihhele buyendasi kwazo, kwandingafa; galani pano, mulinde.”<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Wakayenda mbedlanyana, akawila pasi, akatembezela kuti hapa kuyetikala, lubaka igogu ngaguwumpinde. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Wakati, “Abha<note caller="+" style="f"><char style="fr" closed="false">14.36 </char><char style="ft" closed="false">kubva kuti tate mululimi gwe Aramayiki kene TjiHhebheru</char></note>, Tate! Zose zwinhu kumuli zoyetikala; dusani nkombe iwhoyu kundili; koga kusibe ngekuda kwangu, koga kube ngekuda kwenyu.”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Wakahanduka akabawana bakayizela, akaba eti kuna Phethiro, “Simoni, wakayizela? Wakonegwa linda kwe awa in'ompela? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Lindani, mutembezele kudze musingine mukulikwa; meya inoda, koga nyama ayina masimba.”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Wakabgwilila akanotembezela kakale epamha matama iwo zwawo. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Wakahanduka kakale, akabawana balilele, ngobe bakabekuligwa newhope; baka besingatjazibe kuti bawun'handule betini.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />Wakahanduka gwebutatu, akati kubali, “Mutjilele munyaluluka zwenyu? Kwakwana; lubaka gwatjiswika; Nkololo wenhu unotengesewa mumaboko ebatjinyi. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Milikani, ayindeni; lingani, ntengesi wangu waswika.”<verse eid="MRK 14:42" /></para>
  <para style="s">Sungwa kwaYesu</para>
  <para style="r">(<ref loc="MAT 26:47-56">Matewu 26.47-56</ref>; <ref loc="LUK 22:47-53">Luka 22.47-53</ref>; <ref loc="JHN 18:3-12">Johane 18.3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Ipapo etjalebeleka, kwakaswika Judasi, umwe webaligumi nebabili, ehha nembunga webanhu bakasenga mabhangatjeke nedziswimbo; bebva kubaphirisiti bakulu nebakwali nebawhola. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Ntengesi waka abapa tjilakidzilo, eti, “Iwhoyo wandinowhoputa ndiye; muwumbhate, muyende naye makawunlisa.”<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />Wakati eswika akayenda kuwunli nekulibilidza, akati, “Ndhiyi!” Akawumputa. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Bakawumbhata, bakayenda naye. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Koga umwe webaka balimile ipapo wakahomola bhangatjeke, akatema nlanda wemphirisiti upehhugwi akawunthubula zebe. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Yesu wakati kubali, “Mabhuda makasenga mabhangatjeke nedziswimbo kunga kunoyi monobhata hhibava koga muwhobhata imi? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Hhuba nehhuba tatili toseni muthempeli ndidiya, koga amuzotongondibhata. Koga ke whalo ngadzihhadzisike.”<verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />Bose bakawunsiya, bakatihha.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Umwe nhhuhha waka ewuntobela, akapombela jila lelineni esakambala tjimwe kusi; bakawumbhata, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />koga wakasubvunuka, akasiya jila lelineni, akatihha elimbudlo.<verse eid="MRK 14:52" /></para>
  <para style="s">Yesu Alimbeli kweLubahhe gweBatungamili bemaJuta</para>
  <para style="r">(<ref loc="MAT 26:57-68">Matewu 26.57-68</ref>; <ref loc="LUK 22:54-55">Luka 22.54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Johane 18.13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Bakayendisa Yesu kumphirisiti upehhugwi; nebaphirisiti bakulu nebawhola nebakwali bose baka bakakubungana. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Phethiro wakawuntobela eli tjakulenyana, ekadza akanongina mun'ha wemphirisiti upehhugwi; waka aligele nebalindi, bedziya moto. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />Baphirisiti bakulu nelubahhe gose bakahaka busupi gwaka gungathama kuti Yesu abulawe; koga bakaguhaya. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Ngobe banjinji bakapa busupi gwemanyepwa nekukwe, kakale zwilebo zwabo zwaka zwisingayendilane.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Bamwe bakamilika beleba busupi gwemanyepwa, beti, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“Takawha eti, ‘Ndowhokolomola thempeli ileli lakabakiwa nemaboko, ndikabaka limwe mumahhuba matatu, lisakabakiwa nemaboko.’ ” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Kene ibabo, busupi gwabo aguzoyendilana.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Kukaba kumilika mphirisiti upehhugwi pakati kwabo ekabhuzwa Yesu, eti, “Awuna n'handulo? Ini ikoku kunolebgwa nebalume ibaba nekuko?”<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />Koga wakanyalala, azohandula tjimwe. Mphirisiti upehhugwi akabva ewumbhuzwa kakale eti, “Ndiwe Khirisitu, Nkololo weWakakombolegwa?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />Yesu wakahandula eti, “Ndi iye. Mowhobona Nkololo wenhu aligele kuludli gweMasimba, ehha nemakole ekudzimu.”<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Mphirisiti upehhugwi wakapalula zwiyambalo zwizwe, akati, “Titjahakilani basupi? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Mawha tuka Ndzimu kwaathama, motini nekukwe?”</para>
  <para style="p" vid="MRK 14:64">Bose bakati unanlandu wakafanila fa.<verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />Bamwe bakatangisa wumpfila, bakawunzwina kubuso, bewunloba, beti, “Lebesambeli” Nebalindi bakawuwamutjila ngekuwunloba.<verse eid="MRK 14:65" /></para>
  <para style="s">Phethiro Unolandula Yesu</para>
  <para style="r">(<ref loc="MAT 26:69-75">Matewu 26.69-75</ref>; <ref loc="LUK 22:56-62">Luka 22.56-62</ref>; <ref loc="JHN 18:15-18">Johane 18.15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Phethiro waka alipasi mun'ha, kukaswika umwe webahingikadzi bemphirisiti upehhugwi; <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />ebona Phethiro aligele edziya moto, wakawunlingisisa, eba eti, “Iwe bo, wawuna Yesu wekuNazaretha.”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Koga Phethiro wakalandula eti, “Anditowunziba, kakale anditowhisisa tjawunoleba.” Eba ebhudila kuhhe eyenda kugutukutu. Gukurume liba lilila.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />N'hingikadzi iwhoya akawumbona, akatangisa kakale budza bamwe baka belimile ipapo, eti, “Iwhoyu nlumetate uwumwe wabo.” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Koga Phethiro akalandula kakale.</para>
  <para style="p" vid="MRK 14:70">Hule kwelubakanyana ibabo baka belimile ipapo bakati kuna Phethiro, “Ilebeswa uwumwe wabo; ngobe uNghalile.”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Akatangisa tukana, netuna eti, “Anditowunziba iwhoyu nhu wamunoleba nekukwe.”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Tjinyolotjo gukurume liba lilila gwebubili. Phethiro eba ekumbula matama alebgwa naYesu kuti, “Gukurume lisanhu lalila kabili unowhoba wandilandula katatu.” Wakati ekumbula matama iyawo akalila.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Yesu Alimbeli kwaPilatu</para>
  <para style="r">(<ref loc="MAT 27:1">Matewu 27.1</ref>,<ref loc="MAT 27:2">2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luka 23.1-5</ref>; <ref loc="JHN 18:28-38">Johane 18.28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Kwakati kungoba mangwanana koga, baphirisiti bakulu, bena bawhola nebakwali, nelubahhe gose bakalangana; bakasunga Yesu bakayenda naye kuna Pilatu. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />Pilatu wakawumbhuzwa eti, “Ndiwe Mambo wemaJuta?”</para>
  <para style="p" vid="MRK 15:2">Iye wakawun'handula eti, “Wajalo.”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Baphirisiti bakulu bakawuntilika milandu nekwezwinhu zwinjinji. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Pilatu akawumbhuzwa kakale eti, “Awuna tjawunohandula? Linga bunji gwemilandu yabanokutilika.”<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Koga Yesu azohandula tjimwe, Pilatu kukawutjenamisa.<verse eid="MRK 15:5" /></para>
  <para style="s">Yesu Unotongegwa Bulawa</para>
  <para style="r">(<ref loc="MAT 27:15-26">Matewu 27.15-26</ref>; <ref loc="LUK 23:13-25">Luka 23.13-25</ref>; Johane 18.39-19.16)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Panzano iwhoyu waka ebasunungulila nsungwa un'ompela wabanobe bakumbila kuti awunsunungule. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Pakati kwebapanduki baka bali mujele, baka basungigwa bulaya mumahhuba ebhonyongo, kwakakuna nlume waka eyi Bharabhasi. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Banhu bakahha, bakatangisa kumbila kuti abayetile sekwaaka wolobela bayetila. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />Koga Pilatu wakababhuzwa eti, “Mohaka kuti ndimusunungulile Mambo wemaJuta?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Ngobe waka eziba kuti baphirisiti bakulu bawunsungisa ngentha yendandala koga.<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />Koga baphirisiti bakulu bakafulila banhu kuti ngabati kusunungugwe Bharabhasi. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />Pilatu ekahandula eti kubali, “Ngono moti ndiwuyete tjini iwhoyu wamunodana muti Mambo wemaJuta?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Bakamimila kakale beti, “Muwunkowhomele!”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Pilatu wakati kubali, “Nentha yeni, wayetani tjakayipa?”</para>
  <para style="p" vid="MRK 15:14">Koga bakamimilila pehhugwi beti, “Muwunkowhomele!”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Ndizo Pilatu, ehaka gutsha mimoyo yebanhu, wakabasunungulila Bharabhasi; kukati atjiwunloba Yesu, akabaswiswa iye kuti banowukowhomela.<verse eid="MRK 15:15" /></para>
  <para style="s">Wohholegwa kwaYesu</para>
  <para style="r">(<ref loc="MAT 27:27-31">Matewu 27.27-31</ref>; <ref loc="JHN 19:2">Johane 19.2</ref>,<ref loc="JHN 19:3">3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Bagwi bengwa bakatola Yesu bakayenda naye kun'umba (n'umba yembhati wentunhu) bakadana bunga lose lebagwi bengwa. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Bakawumbadza zwiyambalo zwembala welubende, bakaluka tjiyala tjemimhiwa bakawumbadza itjo mun'holo. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Bakatangisa wupfigamila bewunlezwa beti, “Ngakudziwe, Mambo wemaJuta!” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Bakawunloba mun'holo nelukombo, bakawumpfila mate, bakawupfigamila bewunamata. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Batjithama kose kunosekesa, bakawumbula tjiyambalo tjembala welubende, bekawumbadza zwiyambalo zwizwe. Bakawuntola bakayenda naye kuti banowunkowhomela.<verse eid="MRK 15:20" /></para>
  <para style="s">Yesu Unokowhomegwa</para>
  <para style="r">(<ref loc="MAT 27:32-44">Matewu 27.32-44</ref>; <ref loc="LUK 23:26-43">Luka 23.26-43</ref>; <ref loc="JHN 19:17-27">Johane 19.17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Bakabhata nemasimba umwe nlume waka epinda zwe ebva kuminda, unoyi Simoni wekuKhureni, tate ba Alekizanda naRufusi, kuti asenge tjileyanyo tjaYesu. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Bakawuyendisa kubugalo gunoyi Goligotha (kunobva kuti bugalo gwepepe tjen'holo). <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Bakapa Yesu wayini yakahanganyisiwa nemure<note caller="+" style="f"><char style="fr" closed="false">15.23 </char><char style="ft" closed="false">unti unon'wiwa kuti nhu asiwhe gwadziwa</char></note>; koga Yesu akayilamba. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Bakati bawukowhomela, bakakobana zwiyambalo zwizwe, bekandila malipa kudze babone kuti umwe nemwe unowhotolani. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />Kwaka kuli awa yebutatu kubvila hhuba libhuda<note caller="+" style="f"><char style="fr" closed="false">15.25 </char><char style="ft" closed="false">awa yehhanalume mangwanana</char></note> nelubaka bekowhomela Yesu. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Kwaka kwakakwagwa nlandu uwe kuyi, “Mambo wemaJuta.” <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Kwaka kowhomegwa naye mbava mbili, imwe kuluboko gweludli, imwe kuluboko gwelumehwe gugwe. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />(Kwakahhadzisika lukwalo gunoti, “Wakabagwa kan'ompela nebanotjinya.”)<verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />Banhu baka bepinda ipapo baka bedzungudza miholo bewuntuka beti, “Yaa! Iwe unokolomola thempeli ukolibaka mumahhuba matatu, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />uzwitjidze, ujite patjileyanyo!”<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Baphirisiti bakulu kose nebakwali bo baka bewunseka, beti, “Wakatjidza bamwe, ngaatjizwitjidza bo. <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Khirisitu, Mambo we Isirayeli, ngaajite ngwenuwali patjileyanyo, kuti tibone, tigalemoyo.”</para>
  <para style="p" vid="MRK 15:32">Nayibabo baka bakowhomegwa naye bakawugongobola bo.<verse eid="MRK 15:32" /></para>
  <para style="s">Fa kwaYesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">Matewu 27.45-56</ref>; <ref loc="LUK 23:44-49">Luka 23.44-49</ref>; <ref loc="JHN 19:28-30">Johane 19.28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Kwakati kwaba awa yebutanhatu kubvila hhuba libhuda<note caller="+" style="f"><char style="fr" closed="false">15.33 </char><char style="ft" closed="false">awa yegumi nemabili, hhuba lili panhongoma</char></note> kukaba hhalima hango yose, kukadza kukaba awa yebuhhanalume kubvila hhuba libhuda.<note caller="+" style="f"><char style="fr" closed="false">15.33 </char><char style="ft" closed="false">awa gumi nemahanu, hhuba letewuka</char></note> <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Ne awa yebuhhanalume kubvila hhuba libhuda Yesu wakamimila newhi lipehhugwi eti, <char style="tl">“Eloyi, Eloyi lama sabakathani?”</char> kunobva kuti, “Ndzimu wangu, Ndzimu wangu, mandisiyilani?”<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Bamwe banhu baka balimile ipapo bakati bekuwha bakati, “Iwhani, unodana Elija.” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />Umwe akabva elabuka enobvubika lungudze muwayini inohababa akagubhayila paluhanga akawumpa kuti an'we, eti, “Letjani tibone kuti kene Elija unowhohha ewhowudelusa.”<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Yesu wakamimila newhi lipehhugwi, akafa.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Jila letjisitilo tjethempeli lakapaluka likaba kabili, kutangisila pehhugwi kudza kunoti pasi. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Kukati nlawuli webagwi bengwa waka elimile ipapo, ewumbona efa, wakati, “Lebeswa iwhoyu nlume wayeli Nkololo weNdzimu!”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Kwaka kuna betjikadzi baka bakalingilila beli tjakulenyana, pakati kwabo kwaka kuna Mariya wekuMagadala, naSalome, naMariya mayi baJakobe ntjetjana naJosesi. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Ndibo baka betobela Yesu etji kuGalile, bewumbhatsha; nebamwe betjikadzi bakababva naye kuJerusalema.<verse eid="MRK 15:41" /></para>
  <para style="s">Mbiganyo waYesu</para>
  <para style="r">(<ref loc="MAT 27:57-61">Matewu 27.57-61</ref>; <ref loc="LUK 23:50-56">Luka 23.50-56</ref>; <ref loc="JHN 19:38-42">Johane 19.38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Kwakati kwatjitewuka, nentha yekuti kwaka kuli hhuba leBaakanyila, lili hhuba linotobegwa nesabatha, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Josefa weku Arimathiya, ali umwe welubahhe waka ekudziwa kwazo nebanhu, nayiye bo tjekukwe waka akalindila bumambo gweNdzimu, wakazwipila akangina kuna Pilatu, akakumbila mbili waYesu. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Pilatu wakatjenama kuti watjifa kale; akadana nlawuli webagwi bengwa, akawumbhuzwa kuti watjifa kale. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Atjiwha kubva kunlawuli webagwi bengwa kuti watjifa, wakabvumila Josefa kuti atole mbili waYesu. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Josefa wakatenga jila lelineni, akawuntulula, akawumpetelela nejila, akawubuluka mukumbu tjaka tjakatshiwa muhongwe; wakahhalila nkoba wekumbu nehongwe. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Mariya wekuMagadala naMariya mayi baJosesi bakabona paabiganyiwa.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Muka kwaYesu Kubafi</para>
  <para style="r">(<ref loc="MAT 28:1-8">Matewu 28.1-8</ref>; <ref loc="LUK 24:1-12">Luka 24.1-12</ref>; <ref loc="JHN 20:1-10">Johane 20.1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Kwakati Sabatha lapinda, Mariya wekuMagadala naMariya mayi baJakobe, naSalome, bakatenga mhoza kuti bayende banohhodza mbili waYesu. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Mangwanana ngwanana, muhhuba lekutanga letshipi bekayenda kukumbu, hhuba libhuda. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Baka bebhuzwana beti, “Ndiyani unowhotikunguludzila hongwe ipa nkoba wekumbu kene?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Bakati belinga, bakabona hongwe yakunguludzigwa kutjena nekene yaka ili whuluwhulu. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Bakati bengina mukumbu, bakabona nhhuhha aligele kuludli akambala tjiyambalo tjilefu tjitjena. Bakatjenama kwazo.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />Wakati kubali, “Musitjename; mohaka Yesu wekuNazaretha wakakowhomegwa. Wamuka, atapo pano; lingani pababakawuladzika. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Koga yendani, munobudza badiyiwa babe kose naPhethiro, kuti, ‘Unowhoba mbeli kwenyu kuyenda kuGalile; monhowumbona ikweno, sekwaakamubudza.’ ”<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Bakabhuda mukumbu betihha; nentha yetetema netjenama kwaka kwabaswikila; lebeswa abazotongobudza iyenhu, ngoba bakabehla.</para>
  <para style="s" vid="MRK 16:8">BUPELO GUKULUKUGWI GWENDEBO MBUYA <note caller="+" style="f"><char style="fr" closed="false">16.8 </char><char style="ft" closed="false">Dzimwe whalo dzantolo adzina bupelo igogu gweNdebo Mbuya (vesi 9-20).</char></note></para>
  <para style="s" vid="MRK 16:8">Yesu Unozwilakidza kuna Mariya wekuMagadala</para>
  <para style="r" vid="MRK 16:8">(<ref loc="MAT 28:9">Matewu 28.9</ref>,<ref loc="MAT 28:10">10</ref>; <ref loc="JHN 20:11-18">Johane 20.11-18</ref>)</para>
  <para style="p" vid="MRK 16:8">[<verse eid="MRK 16:8" /><verse number="9" style="v" sid="MRK 16:9" />Yesu wakati amuka kubafi mangwanana muhhuba lekutanga letshipi, wakatanga zwilakidza kuna Mariya wekuMagadala waaka adusa meyambi dzili kutondeka. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Wakamilika, akanobabudza ibabo baka batongoba naYesu, kuli kuti babetjalila bekuwa. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Bakati batjiwha kuti Yesu unotjila, kakale wawumbona, bakasikugalemoyo.<verse eid="MRK 16:11" /></para>
  <para style="s">Yesu Unozwilakidza kuBagalimoyo babe</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luka 24.13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Hule kwayikoko wakazwilakidza ali tjimwe tjimo kububili gwabo belimuzila beyenda kuminda. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Bakayenda bakanobudza bamwe bose, nayibabo bo abazobagalamoyo.<verse eid="MRK 16:13" /></para>
  <para style="s">Yesu Unozwilakidza kuBaligumi ne Un'ompela</para>
  <para style="r">(<ref loc="MAT 28:16-20">Matewu 28.16-20</ref>; <ref loc="LUK 24:36-49">Luka 24.36-49</ref>; <ref loc="JHN 20:19-23">Johane 20.19-23</ref>; <ref loc="ACT 1:6-8">Mihingo 1.6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Hule kwayikoko wakazwilakidza kubaligumi ne un'ompela, bose beligele bedla, wakan'un'una nesagalamoyo kwabo nemimoyo yabo mikukutu, ngobe besagalamoyo bebudziwa nebakawumbona hule kwemuka kukwe. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />Wakati kubali, “Yendani muhango yose, musumikile ndebo mbuya kutjaba tjose. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Iwhoyo unogalamoyo akabvubikiwa unowhotjidziwa; koga usingagalemoyo unowhowan'wa nlandu. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Zwilakidzilo izwezwi zowhotobela banogalamoyo. Ngezina langu banowhotata meyambi; banowholebeleka nendimi ndzwa; <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />banowhobhata nyoka nemaboko nehapaya ben'wa tjinobulaya, atjitowhobakubadza, banowhobiga maboko banogwala bakatjila.”<verse eid="MRK 16:18" /></para>
  <para style="s">Wulukila Kudzimu kwaYesu</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luka 24.50-53</ref>; <ref loc="ACT 1:9-11">Mihingo 1.9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Hule kwayikoko He Yesu alebeleka nabo, wakamilidzigwa pehhugwi kudzimu, akanogala pasi kuluboko gweludli gweNdzimu. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Bakayenda bakasumikila ntha dzose, He ehinga nabo, ehhadzisa whi ngezwilakidzilo zwakazwiyetikala. Akujalo.]</para>
  <para style="s" vid="MRK 16:20">GUMWE BUPELO GUKULUKUGWI<note caller="+" style="f"><char style="fr" closed="false">16.20 </char><char style="ft" closed="false">Dzimwe whalo dzantolo dzina bupelo igogu gufutshwanana gwe Ndebo Mbuya, pehhugwi kwawhogu bupelo (vesi 9-20).</char></note></para>
  <para style="p" vid="MRK 16:20">[<verse eid="MRK 16:20" /><verse number="9" style="v" sid="MRK 16:9" />Bafumakadzi bakayenda kuna Phethiro nebakwinya babe, bakababudza kose kwababudziwa. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Hule kwayipapo, Yesu tjekukwe, ehingisa badiyiwa babe, wakayendisa ndebo mbuya yebupenyu, gwejidzo lisingapele kubvila kunobhuda hhuba kunoti kunongina hhuba.]<verse eid="MRK 16:10" /></para>
  <chapter eid="MRK 16" />
</usx>