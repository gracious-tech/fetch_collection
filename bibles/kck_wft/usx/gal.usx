<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Kalanga Bible Translation</book>
  <para style="h">BaGalathiya</para>
  <para style="toc1">Paul's Letter to the GALATIANS</para>
  <para style="toc2">BaGalathiya</para>
  <para style="toc3">BaG</para>
  <para style="mt2">Lukwalo gwaPhawuli ekwalila</para>
  <para style="mt1">BAGALATHIYA</para>
  <para style="imt">Tjinginiso</para>
  <para style="ip">
    <char style="bk">Lukwalo gwebaGalathiya</char> gwakakwagwa neMpositoli Phawuli (BaG 1.1). Gwaka guli lukwalo Phawuli gwaakakwalila makubungano etshipi ebaGalathiya hule kwemakole angaba makumi mana ana hhanakadzi kunoti makumi mahanu ana kutondeka Khirisitu azwagwa. BaGalathiya bakafanila baka bali banhu bagele muntunhu wehango yeRoma unoyi Galathiya. Akuna unalebeswa kuti Phawuli waka aliponi nelubaka ekwala lukwalo igogu, angaba waka ali kunzi-nkulu we Efesu kene kunzi-nkulu weKhorinte.</para>
  <para style="ip">Phawuli waka ekwalila MaKhirisitu, emaJuta ne asi maJuta, mumakubungano ebagalimoyo aka eli muGalathiya. Waka ekwala akalingisana nediya kwemanyepwa kwaka kuti MaKhirisitu akafanila tobela milayo yemaJuta imuThesitamente whulukugwi, kwazo kwazo thumbigwa. Kwaka kuna bunga leMaKhirisitu lakalidan'wa BeTjijuta lakalihaka kuti MaKhirisitu asi maJuta athumbigwe. Kakale baka benyanyayidza bupositoli gwaPhawuli nesimba lile. Phawuli wakamila bupositoli gugwe ngeleba nekukwe (BaG 1.11-2.14) kakale wakamila ndebo mbuya ngetjenesa kuti tjidziwa kohha ngegalamoyo muna Yesu Khirisitu koga (BaG 2.16). Kungentha yeludo Ndzimu gwaanolayidza, akuta ngentha yetjinoyetiwa nebanhu.</para>
  <para style="iot">Nlongoloso Yezwimukati</para>
  <para style="io1">Phawuli unotangisa lukwalo gugwe nelezwa makubungano etshipi amuGalathiya (BaG 1.1-5)</para>
  <para style="io1">Phawuli unotjenesa mamo awe kakale emila fanilo iye yediya nelayidza kuti wakayedza tjila ngenlayo koga kwaka kusingahinge (BaG 1.6-2.21)</para>
  <para style="io1">Phawuli unotjenesa ndima inozan'wa nenlayo nengoni mukutjidziwa (3-4)</para>
  <para style="io1">Unokotjipa milayo yetjila kubuya kweMaKhirisitu (BaG 5.1-6.10)</para>
  <para style="io1">Phawuli unofidza lukwalo gugwe nelezwa netetedza kuti banhu basikangan'we kuti handugwa neNdzimu uba nhu ntshwa itjinhu tjikulu kwazo kupinda milayo yebanhu, senlayo wethumbigwa (BaG 6.11-18)</para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />Kubva kundili imi Phawuli mpositoli, usakaba mpositoli kubva mubanhu kene ngentha yenhu, koga ngentha yaYesu Khirisitu naNdzimu Tate, ibo bakawumusa kubafi, <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />nebagalimoyo bose bandinabo,</para>
  <para style="p" vid="GAL 1:2">Kumakubungano ebagalimoyo amuGalathiya.<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />Ngoni nekunyalala kunobva kuNdzimu Tate bedu naHe Yesu Khirisitu ngakube kumuli.<verse eid="GAL 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4" />Khirisitu wakapila butjilo gugwe ngentha yematjinyo edu kudze atisunungule mutjibaka tjino tjibi, kuli kuda kweNdzimu Tate bedu; <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />ngabakudziwe lini nalini. Akujalo.<verse eid="GAL 1:5" /></para>
  <para style="s">Ndebo Mbuya In'ompela</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />Ndotjenamisiwa nekuti molibilidza wunsiya iye wakamudanila mungoni dzaKhirisitu mukudukila kuyimwe ndebo mbuya, <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />kusi kuti kuna imwe ndebo mbuya, koga kuna bamwe banomudziyidza kakale banohaka tjinya ndebo mbuya yaKhirisitu. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />Koga hapa kene iswi, kene ntumwa wekudzimu, angasumikila kumuli ndebo mbuya inoleyana neyatakasumikila kumuli, ngaalongwe bhiso. <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />Sekwatakaleba, ndoti kakale ngwenuwali, hapa umwe nhu esumikila ndebo mbuya inoleyana neyamakawamutjila, ngaalongwe bhiso.<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />Ndeehaka diwa nebanhu, kene neNdzimu? Kene ndoyedza hanhisa banhu? Hapa kuli kuti nditjahanhisa banhu, kobva kuti anditanlanda waKhirisitu.<verse eid="GAL 1:10" /></para>
  <para style="s">Phawuli Sekwaakaba Mpositoli</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />Itini ndimuzibise, makamu, kuti ndebo mbuya yakasumikigwa nami ayita ndebo mbuya yenhu. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />Ngobe andizoyiwamutjidziwa nenhu, kene iko yidiyiwa nenhu, koga yakahha ngezumbunulo yaYesu Khirisitu.<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />Makawha nekwebutjilo gwangu gwandakanditjila mulunamato gwetjiJuta, kuti ndakadziyidza tjini gubungano letshipi yeNdzimu ndikagwisa lipaladza; <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />kakale ndakakula mukuziba milenje yelunamato gwetjiJuta kupinda thaka dzangu njinji mubanhu beludzi gwangu, ndaka ndakazwipila kwazo kwazo mumilenje abobatategulu bangu.<verse eid="GAL 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15" />Koga Ndzimu iye wakandihala ndisanhu azwagwa, kakale wakandidana ngengoni dzidze, <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />paakahanhila zumbunula Nkololo uwe kundili<note caller="+" style="f"><char style="fr" closed="false">1.16 </char><char style="fq" closed="false">paakahanhila zumbunula Nkololo uwe kundili </char><char style="ft" closed="false">TjiGiriki tjoti “Paakahanhila zumbunula Nkololo uwe mundili”</char></note>, kuyetila kuti ndisumikile nekukwe pakati kweBataya, andizotongobinga iye nhu ndinohaka mano, <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />kene iko yenda kuJerusalema kuna ibabo bakanditangila ba bapositoli, koga ndakayenda ku Arabhiya; ndikakotjibgwilila kuDamasikasi. <verse eid="GAL 1:17" /><verse number="18" style="v" sid="GAL 1:18" />Kwapinda makole matatu ndakakotjiyenda kuJerusalema ndinokumba Khefasi<note caller="+" style="f"><char style="fr" closed="false">1.18 </char><char style="ft" closed="false">Phethiro</char></note>, tikaba tose kwemahhuba ali gumi nemahanu. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />Akuna umwe mpositoli wandakabona kuhhe kwaJakobe nun'una waHe.<verse eid="GAL 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20" />(Tjandinomukwalila itjo, mbeli kweNdzimu, atjita manyepwa!)<verse eid="GAL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21" />Ndakakotjiyenda kumitunhu yeSiriya neSilisiya. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />Ndaka ndisingazibgwe tjiso mumakubungano ebagalimoyo aKhirisitu muJudiya; <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />baka bengowha koga kuyi, “Iwhoya wakatongoba etidziyidza ngwenu wesumikila bugalimoyo gwaakatongogwisa paladza.” <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />Bakakudza Ndzimu ngentha yangu.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">Phawuli Nebamwe Bapositoli</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />Kukakotjiti hule kwemakole ali gumi nemana ndikayenda kakale kuJerusalema ndinaBhanabhasi, takayenda naThayithasi. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />Ndakayenda ngentha yezumbunulo; ndikabazibisa (tili ntome, ibabo baka belingwa sebatungamili) ndebo mbuya yandinosumikila pakati kweBataya, swiyo neyimwe zila ndakahingila kene kuti ndohingila suli. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />Kene Thayithasi, wandaka ndinaye, nenguba waka ali Nghiriki azotongomanikidziwa kuti athumbigwe. <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />Iyeyi ndebo yakamuka ngobe bamwe bakabezwita bagalimoyo, benyepa besi ibo, baka bangina nezila yakasumbikala mugubungano, bali whodzi, behakisisa nekwelusununguko gwedu gwatinago muna Khirisitu Yesu, kuyetila kuti batiyete balanda, <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />koga atizotongogala tababvumila kuyetila kuti lebeswa lendebo mbuya litjengetegwe imwi.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />Ibabo baka belingwa sebapehhugwi (tjabaka bali itjo atjitoti tjimwe kundili; Ndzimu haana luhalawulo), ndobva ibabo, baka belingwa sebapehhugwi akuna tjabakapamhidzila kundili, <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />koga ke, bakati bebona kuti ndakagagwabgwe sumikila ndebo mbuya kubanhu basakathumbigwa<note caller="+" style="f"><char style="fr" closed="false">2.7 </char><char style="fq" closed="false">basakathumbigwa </char><char style="ft" closed="false">kobviwa Bataya</char></note>, saPhethiro bo akagagwabgwe sumikila ndebo mbuya kubanhu bakathumbigwa<note caller="+" style="f"><char style="fr" closed="false">2.7 </char><char style="fq" closed="false">bakathumbigwa </char><char style="ft" closed="false">kobviwa MaJuta</char></note> <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />(ngobe iwhoyo wakayeta Phethiro akaba mpositoli kubanhu bakathumbigwa nami wakandiyeta bo mpositoli kuBataya), <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />bakati bebona ngoni dzandakapiwa, Jakobe naKhefasi<note caller="+" style="f"><char style="fr" closed="false">2.9 </char><char style="ft" closed="false">Phethiro</char></note> naJohane, ibo baka bezibgwa bali mhanda, bakatibhata luboko imi naBhanabhasi belakidza kuti tohingidzana, kuti iswi tiyende kuBataya ibo bayende kubakathumbigwa. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />Tjabakakumbila koga whuti tikumbule bahayi, tjinoba tjaka tjili itjo tjinhu tjandakagala ndihaka thama kwazo.<verse eid="GAL 2:10" /></para>
  <para style="s">Phawuli Unotjemela Khefasi bali ku Antiyoku</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />Koga Khefasi<note caller="+" style="f"><char style="fr" closed="false">2.11 </char><char style="ft" closed="false">Phethiro</char></note> paakabuya ku Antiyoku ndaka nyanyayidzana naye mbeli kwebanhu, ngobe waka etjinya. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />Ngobe kwakati kusanhu kukaswika bamwe balume baka bebva kuna Jakobe, waka edla neBataya; koga pabakaswika wakabva pabali akazwipalalanya nabo, ehla bunga lebakathumbigwa. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />Amwe maJuta bo akathama sa iye, kukata kuti naBhanabhasi bo atobele bupitipiti gwabo. <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />Koga pandakabona kuti abatobhudila patjena nekwelebeswa lendebo mbuya, ndakati kuna Khefasi, mbeli kwabo bose, “Hapa iwe, nekene uli Njhuta, utjila seNtaya usingatjile seNjhuta, ungahaka kuti Bataya batjile semaJuta tjini wali?”<verse eid="GAL 2:14" /></para>
  <para style="s">MaJuta neBataya Banotjidziwa ngeKugalamoyo</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />Iswi tjekwedu, timaJuta ngezwagwa atita Bataya banotjinya, <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />koga toziba kuti nhu atolulamisiwa ngelondolodza nlayo, koga unolulamisiwa ngegalamoyo muna Yesu Khirisitu. Naswi bo takagalamoyo muna Khirisitu Yesu, kudze tilulamisiwe ngegalamoyo muna Khirisitu, kusi ngelondolodza nlayo, ngobe ngelondolodza nlayo akuna unowholulamisiwa. <verse eid="GAL 2:16" /><verse number="17" style="v" sid="GAL 2:17" />Koga hapa, mukuyedza kwedu kuti tilulamisiwe muna Khirisitu, iswi tjekwedu takawanika tili batjinyi, kobva kuti Khirisitu unlanda wejinyo ngono? Lebeswa akuzojalo! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />Koga hapa nditangisa ndimusidzila kakale zwandakakolomola, ndoba ndilakidzila kuti ndinhu unotjuluka nlayo. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />Ngobe ngenlayo ndakafa kunlayo, kuyetila kuti nditjilile Ndzimu. Ndakatjikowhomegwa kan'ompela naKhirisitu, <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />akutji imi unotjila, koga ndiKhirisitu unotjila mundili; nebutjilo gwandinotjila ngwenu munyama ndotjila ngegalamoyo muNkololo weNdzimu, iye wakandida akapila butjilo gugwe ngentha yangu. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />Anditolamba ngoni dzeNdzimu; ngobe hapa lulamisiwa kwakuli ngenlayo, kobva kuti Khirisitu wakafila suli.<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">Nlayo kene Bugalimoyo</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />Zwilengwe zwebaGalathiya! Kati maloyewa nani? Fa kwaYesu Khirisitu kwakatjenesewa nekuhhele, kukanga sekunoyi wakakowhomegwa patjileyanyo mbeli kwemeho enyu. <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />Itini ndimubhuzwe whoku kun'ompela. Makawamutjila Meya ngentha yelondolodza nlayo, kene ngentha yegalamoyo tjamakawha? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />Kati muzwilengwe zwingapa? Mungati makatangisa neMeya, ngono meepeleledza nezwenyama? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />Zwinhu zwinjinji zwakayetikala kumuli zwakayetikalila suli? Lebeswa azwizoyetikalila suli! <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />Iwhoyo unomupa Meya kakale eyeta matjenamiso pakati kwenyu unokuthama ngentha yeyeta kwenyu tjinohakiwa ngenlayo, kene ngentha yegalamoyo kwenyu tjamakawha?<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3.6 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 15:6">Kut 15.6</ref>; <ref loc="ROM 3:4">BaR 3.4</ref>.</char>
    </note>Ndizo ke Abhurahhamu “wakagalamoyo kuNdzimu, galamoyo kukwe kukabagwa selulama.” <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />Mobona ke kuti ibanhu be bugalimoyo banoyi bana ba Abhurahhamu. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />Nelukwalo, gubona tjinowhohha, kuti Ndzimu unowholulamisa Bataya ngegalamoyo, gwakabva gwasumikila ndebo mbuya kuna Abhurahhamu, guti, “Njudzi dzose dzowhokombolegwa mukuli.” <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />Ndizo ke, ibabo banoba bali banhu bekugalamoyo bakakombolegwa kan'ompela na Abhurahhamu waka ana kugalamoyo.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3.10 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 27:26">Matam 27.26</ref>. </char>
    </note>Ngobe bose bakabhatilila mulondolodza nlayo bapasi kwebhiso, kana kwakakwagwa kuti, “Unabhiso umwe newumwe usingatobele kakale esingathame zose zwinhu zwakakwagwa mulukwalo gwenlayo.” <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" /><note caller="-" style="x"><char style="xo" closed="false">3.11 </char><char style="xt" closed="false"><ref loc="HAB 2:4">Habh 2.4</ref>.</char></note> Ngwenu kwabe patjena kuti akuna nhu ungayi wakalulama mbeli kweNdzimu ngelondolodza nlayo; ngobe “Iye unolulamisiwa ngekugalamoyo unowhotjila<note caller="+" style="f"><char style="fr" closed="false">3.11 </char><char style="ft" closed="false">unowholalama</char></note>” <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" /><note caller="-" style="x"><char style="xo" closed="false">3.12 </char><char style="xt" closed="false"><ref loc="LEV 18:5">BaL 18.5</ref>.</char></note> koga nlayo awuzosendama pa bugalimoyo, ngobe “Iwhoyo <char style="it">unothama </char> kose kunohakwa ngeNlayo unowhotjila<note caller="+" style="f"><char style="fr" closed="false">3.12 </char><char style="ft" closed="false">unowholalama</char></note> ndiko.”<verse eid="GAL 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3.13 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 21:23">Matam 21.23</ref>.</char>
    </note> Khirisitu wakatiwangula<note caller="+" style="f"><char style="fr" closed="false">3.13 </char><char style="ft" closed="false">wakatisunungula</char></note> mubhiso lenlayo, paakaba bhiso iye ekuyetila iswi, ngobe kwakakwagwa kuti, “Unabhiso wose nhu unolembeleka panti,” <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />kuyetila kuti kombolegwa kwa Abhurahhamu kuswike kuBataya muna Khirisitu Yesu, kudze tiwamutjile tjigadzabgwe tjeMeya ngekugalamoyo.<verse eid="GAL 3:14" /></para>
  <para style="s">Nlayo neTjigadzabgwe</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />Makamu angu, itini ndiyelesedze netjinhu tjakawolobeleka. Akuna nhu ungakolomola kene ungapamhidza tjibvumilano tjinoba tjalongwa nkando<note caller="+" style="f"><char style="fr" closed="false">3.15 </char><char style="fq" closed="false">tjalongwa nkando </char><char style="ft" closed="false">tjakabvumigwaniwa nebeni batjo</char></note>. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />Zwigadzabgwe zwakayetiwa kuna Abhurahhamu nekumwana uwe<note caller="+" style="f"><char style="fr" closed="false">3.16 </char><char style="fq" closed="false">nekumwana uwe </char><char style="ft" closed="false">TjiGiriki tjoti “Mbewu iye”</char></note>. Lukwalo agutoti, “Nekubana<note caller="+" style="f"><char style="fr" closed="false">3.16 </char><char style="fq" closed="false">Nekubana </char><char style="ft" closed="false">TjiGiriki tjoti “Nekumbewu”</char></note>,” gubva banjinji, koga gobva un'ompela, “Nekumwana uwo<note caller="+" style="f"><char style="fr" closed="false">3.16 </char><char style="fq" closed="false">Nekumwana uwo </char><char style="ft" closed="false">TjiGiriki tjoti “Nekumbewu iyo”</char></note>,” iye Khirisitu. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />Tjandinobva ndiyetji. Nlayo, wakahha kwapinda makole ali makulu mana ana makumi matatu awutokolomola tjibvumilano tjaka tjalongwa nkando<note caller="+" style="f"><char style="fr" closed="false">3.17 </char><char style="fq" closed="false">tjalongwa nkando </char><char style="ft" closed="false">tjakabvumigwaniwa nebeni batjo</char></note> neNdzimu, kuyetila kuti tjigadzabgwe tjibe suli. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />Ngobe hapa nhaka ipiwa ngenlayo, akutjingetjigadzabgwe, koga ke Ndzimu wakayipa Abhurahhamu ngetjigadzabgwe.<verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />Nlayo waka uli weni ngono? Wakahhisiwa bo ngentha yematjinyo, kuswikila mwana, iwhoyo wakapiwa tjigadzabgwe atjiswika; nlayo wakahhisiwa nebatumwa beNdzimu, ngebunyayi. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />Koga ke, bunyayi gohinga hapa mabunga elimanji pana lin'ompela; koga Ndzimu un'ompela.<verse eid="GAL 3:20" /></para>
  <para style="s">Tjinangwa tjeNlayo</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />Kobva kuti nlayo unopesana nezwigadzabgwe zweNdzimu? Lebeswa akuzojalo, ngobe hapa nlayo wakahhisiwa ungalesi butjilo, kubva kuti, lebeswa, ndulamo inoba ili ngenlayo. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />Koga lukwalo gwakasa zwinhu zose pasi kwesimba lejinyo, kudze tjaka tjagadziwabgwe ngebugalimoyo muna Yesu Khirisitu tjipiwe ibabo banogalamoyo.<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />Bugalimoyo gusanhu gukahha, taka tili batapwa pasi kwenlayo, takahhaliligwa kuswika bugalimoyo gwaka guwhohha gudzina guzumbunugwa. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />Ndizo ke nlayo waka uli ntjengeti wedu kudzina Khirisitu ehha, kuyetila kuti tilulamisiwe ngebugalimoyo. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />Koga ke saku bugalimoyo gwatjihha, atitjipasi kwentjengeti.<verse eid="GAL 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />Ndizo ke mose mubana beNdzimu, ngekugalamoyo muna Khirisitu Yesu, <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />ngobe sayikoku bunji gwenyu makabvubikiwa muna Khirisitu matjimbala Khirisitu. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />Akutjina Njhuta kene Nghiriki, akutjina nlanda kene wakasununguka, akutjina wetjilume kene wetjikadzi, ngobe mose makalizana mbeli kwaKhirisitu Yesu. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />Kakale hapa muli baKhirisitu, kubva kuti mumbewu ya Abhurahhamu, nghalinhaka sekwakunoleba tjigadzabgwe.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />Ndobva kuti, nghalinhaka hapa atjimwana azosiyana nenlanda, nekene zwako ali mweni welukata, <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />koga unoba ali pasi kwebanowunlela nebantjengeti benhaka bamunlayo, kudza kunoswika lubaka gwakabigwa natate babe. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />Naiyeyo zila, pataka tili bana taka tili balanda bemilenje yemeya dzehango. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />Koga lubaka gwakafanila gwatjiswika, Ndzimu wakatuma Nkololo uwe, wakazwagwa nemfumakadzi pasi kwenlayo, <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />kuti awangule ibabo baka bali pasi kwenlayo, kuyetila kuti iswi tiyetiwe bakololo.<verse eid="GAL 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6" />Ngentha yekuti mubakololo, Ndzimu wakatuma Meya yeNkololo uwe mumimoyo yedu inodanilila iti “Abha,<note caller="+" style="f"><char style="fr" closed="false">4.6 </char><char style="ft" closed="false">muTjiAramayiki koleba kuti “Tate bangu”</char></note> Tate.” <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />Ndizo ke, awutjinlanda, koga watjiba nkololo weNdzimu, hapa uli nkololo kubva kuti ungalinhaka.<verse eid="GAL 4:7" /></para>
  <para style="s">Dziyidzika kwaPhawuli nekwe BaGalathiya</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />Mumahhuba akapinda pamaka musingazibe Ndzimu, maka muli bahingi bezwisi midzimwana ngembumbiko, <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />koga ngwenu ngentha yekuti meeziba Ndzimu, kene kuti meezibgwa ngeNdzimu, mebgwilila tjini kumilenje yemeya dzisina masimba kakale dzisina n'hingo, muhaka ba balanda badzo? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />Motjengetedza mahhuba, nemimwedzi, nezwibaka, nemakole! <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />Ndowha ndihla hinga kwangu kungapa kumuli ndingaba ndakahingila suli.<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />Ndomukumbilisisa makamu angu ibani sekwandili iko, ngobe ndatjiba sekwamuli iko. Akuna tjamakanditjinyila. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />Moziba kuti kwaka kuli ngentha yesawha zwibuyanana mumbili kwakayeta kuti ndisumikile kumuli kwekutanga, <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />nekene gwala kwangu kwaka kuli tjiliko kumuli, amuzondilingila pasi kene ndihema, koga makandiwamutjila sentumwa weNdzimu, saKhirisitu Yesu ntja. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />Ngono kombolegwa kwamaka munako kuponi? Ngobe ndingapa busupi gwekuti hapa kwaka kubvuma maka muwhokopola meho enyu mukandipa iwo. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />Ndatjiba tjita tjenyu ngobe ndomubudza lebeswa?<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />Banhu ibabo banoyeta sekunoyi banomuda, koga abatokuthama mukululama tjabanohaka whuti muthubukane nami, beyetila kuti mukobatobela. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />Ngobe diwa udigwa tjinhu itjinhu tjakanaka kwazo kakale kugala kuyetikala, kusingayetikale hapa ndinamwi koga. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />Ngawana dzangu, ndopamha muwhila magwadzo etshibama kakale, kuswikila mamo aKhirisitu abumbiwa mumuli. <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />Ndandiyemula kuti ndibe namwi ngwenuwali kakale nditeledze whi langu, ngobe ndodziyidzika nekwenyu.<verse eid="GAL 4:20" /></para>
  <para style="s">Tjidiyo tjinobva kuna Hagari naSara</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />Tongondibudzani imwi munoyemula tjila pasi kwenlayo, kati amutowha tjinolebgwa nenlayo? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />Ngobe kwakakwagwa kuti, Abhurahhamu waka enabakololo babili, umwe wakawunzwala nenlandakadzi, umwe wakawunzwala nemfumakadzi wakasununguka. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />Koga nkololo unozwagwa nenlandakadzi wakazwagwa ngekwekwenyama, nkololo wemfumakadzi wakasununguka wakazwagwa ngekwetjigadzabgwe. <verse eid="GAL 4:23" /><verse number="24" style="v" sid="GAL 4:24" />Iwhoyu umfananidzo. bafumakadzi ibaba banomilila zwibvumilano zwibili. Tjimwe ndetjeku Dombo leSinayi tjinozwala mwana wekubulanda, iwhoyu ndiHagari. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />Hagari iDombo leSinayi likuhango yeArabhiya, unoyendelana neJerusalema yangwenuwali, ngobe umubulanda nebana babe. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />Koga Jerusalema lipehhugwi lakasununguka, ndibo mme bedu. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />Ngobe whalo dzoti,</para>
  <para style="q1" vid="GAL 4:27">“Hanha, iwe nkadzi usina mbeleko!</para>
  <para style="q2" vid="GAL 4:27">Pululudza kakale umimile nekuhanha, iwe usakatongowha gwadza kwetshibama!</para>
  <para style="q1" vid="GAL 4:27">Ngobe bana bemfumakadzi wakasiyiwa banji kwazo</para>
  <para style="q2" vid="GAL 4:27">Kupinda bana bewunanlume.”<verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />Ngono iswi <note caller="+" style="f"><char style="fr" closed="false">4.28 </char><char style="ft" closed="false">dzimwe whalo whulukugwi dzoti, imwi makamu mubana betjigadzabgwe bo saIsaka. </char></note>makamu tibana, betjigadzabgwe bo saIsaka. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />Koga semuna igoguya lubaka iwhoya wakazwagwa ngekwenyama wakadziyidza iwhoya wakazwagwa ngekweMeya, kwakajalo kene nanasi. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />Koga lukwalo gotini? Goti, “Tata nlandakadzi kose nenkololo uwe, ngobe nkololo wenlandakadzi haangakobane nhaka nenkololo wemfumakadzi usinlanda.” <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />Ndizoke, makamu iswi atitabana benlandakadzi koga tibana bemfumakadzi wakasununguka.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">Londolodzani Lusununguko Gwenyu</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />Tjimani ke makasima mulusununguko gwatakapiwa naKhirisitu, musibvumile kuti mubgwilile kakale kujogwe lebulanda.<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />Whililani, imi Phawuli, ndoti kumuli hapa muwamutjila thumbigwa, Khirisitu haatjina bhatsho kumuli. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />Ndopamha ndikowhomesedza nlume wose unobvuma thumbigwa, kuti waba nenlandu wekuti atjengete nlayo wose. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />Khirisitu haatjina bhatsho kumuli, ndobva imwi munoti makalulamisiwa nenlayo, matjibe kuhhe kwengoni. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />Ngobe iswi ngeMeya takamilila tjigadzabgwe tjekuti towholulamisiwa nebugalimoyo. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />Ngobe muna Yesu Khirisitu thumbigwa kene sathumbigwa akutobva tjimwe, tjinohakika bugalimoyo gunozwilakidza ngemihingo yeludo.<verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />Makamuyeta zwakanaka, ndiyani wakamudzingayidza kuti mume whilila lebeswa? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />Tetedza ikoku akutoyetiwa newunomudana. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />Mbidzo nhukununu inobidza bhundu lose. <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />Ndogalabgwe munaHe, kuti hamutowhoba newumwe nkumbulo wakasiyana nekwandinoleba, nayiwhoya unomudziyidza unowhotongewa kene kuli yani.<verse eid="GAL 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11" />Hama dzangu hapa nditjasumikila thumbigwa nditjadziyidzigwani ngono? Hapa kuli kuti kwakajalo sumikila nekwetjileyanyo akungasilinge nhu. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />Ndoyemula kuti ibabo banomudziyidza kadzene babengazwisunula.<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />Hama dzangu imwi makadanigwa kulusununguko, musihingise lusununguko igogu kuti guhhadzise njemulo dzembili nekwakajaloke hingilani umwe newumwe muludo. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />Ngobe nlayo unohhadzisiwa mudama lin'ompela linoti, “Ida mbakidzani uwo sekwaunozwida iwe.” <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />Ngono hapa mulumana mudlana semhuka, mutjenjele kuti musipedzane.<verse eid="GAL 5:15" /></para>
  <para style="s">Meya Nenjemulo Dzenyama</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />Kwandinoleba ndiwhoku, tjilani ngeMeya, mukajalo amutowhogutsha njemulo dzembili. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />Ngobe njemulo dzembili dzogwisana neMeya, nenjemulo dzeMeya dzogwisana nedzembili, ngobe ikoku kubili koleyana, kuti usitubule thama tjawunohaka thama. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />Koga hapa mutungamigwa neMeya, amutjipasi kwenlayo.<verse eid="GAL 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19" />Sangwenu mihingo yenjemulo dzembili ipatjena ndiyeyi. pinga, hambgwa, zwiyeto zwinobhatisa honi, <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />namata zwidzimwana, buloyi, lubengo, gwa, fupa, buhongola, haka kuko woga, kakatilana, tjebela, meya dzinoda kwemabunga adzo koga, <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />tjiba, laladza, zwihanhisa kusakafanila, nekumwe kwakajalo. Ndomubudza sekwandakamubudza kutanga kuti, ibabo banothama zwinhu zwakajalo abangagale nhaka yebumambo gweNdzimu.<verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />Koga mitjelo yeMeya ndiyeyi. ludo, hanha, kunyalala, moyo nlefu, ngoni, bubuya, galikamoyo, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />bunyolo, zwibhata, akuna nlayo unonyanyayidzana nayikoku. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />Kakale ibabo baKhirisitu Yesu bakakowhomela mibili yabo nezwayinohaka, nenjemulo dzayo patjileyanyo. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />Hapa titjila muMeya, ayindeni tili muMeya. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />Tisibe banhu banohaka gudzo lisina n'hingo, tihokayidzana, kakale tiyetilana fupa.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">Sengesanani Bulemo</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />Makamu hapa umwe akuligwa nejinyo, imwi bemeya makafanila wuntambunudza akalulama, nemoyo nyolonyolo. Mutjenjele kuti namwi bo, musilikiwe. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />Sengesanani bulemo, nethama mujalo mobamuhhadzisa nlayo waKhirisitu. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />Hapa nhu ekumbula kuti utjimwe tjinhu iye esitjimwe, unozwitjengela. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />Umwe newumwe ngaalingisise n'hingo uwe, ekotjizwikudza ke esingazwilizanye newumwe nhu. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />Ngobe nhu nenhu wakafanila senga ntolo uwe.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />Iwhoyo unodiyiwa dama leNdzimu ngaakobele iwhoyo unowundhiya kose kwakanaka.<verse eid="GAL 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7" />Musitjengegwe, Ndzimu atosekewa, nhu tjaanodzwala nditjo tjaanovuna. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />Ngobe iwhoyo unodzwala tjinohanhisa njemulo dzembili uwe unowhovuna bola munyama, koga iwhoyo unodzwala mumeya unowhovuna butjilo gusingapele. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />Tisinyale mukuthama zwibuya, ngobe mulubaka gwakafanila towhovuna, hapa tisinganyale moyo. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />Sayikoku tina nkoba ngatithameni kwakalulama kubanhu bose, bukulu kuna ibabo ben'ha webugalimoyo.<verse eid="GAL 6:10" /></para>
  <para style="s">Tjemela Kwebupelo Nebuyisa</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />Lingani kuti ndomukwalila ndihingisa mabala makulu tjini ngeluboko gwangu. <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />Ndiyibabo banohaka lakidza bubuya munyama banomumanikidza kuti muthumbigwe, beyetila kuti basidziyidziwe ngentha yetjileyanyo tjaKhirisitu. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />Ngobe kene ibo nekwabo bakathumbigwa abatotjengeta nlayo, koga banohaka kuti imwi muthumbigwe, kuyetila kuti bawane gudzo ngentha yemibili yenyu. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />Koga ke imi ngandisiwane gudzo, kuhhe kwe gudzo letjileyanyo tjaHe wedu Yesu Khirisitu, muwunli iye hango yakakowhomegwa kundili, nemibo ndakakowhomegwa kuyili. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />Ngobe thumbigwa akuna tjakunohinga, kene iko sathumbigwa akunabo tjakunohinga, koga tjikulu whuba mbumbiko ntshwa. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />Kunyalala nemawhilangoni ngakube kuna ibabo banoyenda munlayo iwhoyu, maIsirayeli eNdzimu.<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />Kubvisila ngwenuwali kusitjabe nenhu unondidziyidza, ngobe mabanga andinawo mumbili anolayidza kuti ndilanda waYesu.<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />Ngoni dzaHe wedu Yesu Khirisitu ngadzibe nemeya dzenyu makamu. Akujalo.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>