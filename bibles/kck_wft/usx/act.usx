<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">-KALANGA Bible Translation</book>
  <para style="h">Mihingo yeBapositoli</para>
  <para style="toc1">LUKWALO GWEMIHINGO MIHINGO</para>
  <para style="toc2">MIHINGO</para>
  <para style="toc3">Mih</para>
  <para style="mt1">MIHINGO</para>
  <para style="mt2">yeBapositoli</para>
  <para style="imt">Tjinginiso</para>
  <para style="ip">
    <char style="bk">Mihingo yeBapositoli</char> unlondesedzo wetangisa kweGubungano nekuti lakakula tjini kubva muJerusalema kunoti kuJudiya, kuSamariya, nekudzimwe hango, seleba kwaYesu esanhu ayenda kudzimu (Mihingo 1.8). Lukwalo igogu gwakakwagwa ndiLuka, iyezwe wakakwala <char style="bk">Ndebo mbuya sekwagwa kwayo ndiLuka</char>. Waka ali nlapi kakale eziba londesedza kuna njele. Whalo idzedzi mbili, Ndebo mbuya iye neLukwalo gweMihingo, wakadzikwala dziyenda kuna Thiyofilasi waka eli Nghiriki, koga ke nekutobe kwakajalo whalo idzedzi dzaka dzakalingisana netjaba tjeMakhirisitu kuhanganyila maGiriki nemaJuta (Mihingo 1.1).</para>
  <para style="ip">
    <char style="bk">Lukwalo gweMihingo</char> gungaba gwakakwagwa hule kwemakole angaba makumi ali kutanhatu kuyenda kumakumi ali kutondeka Khirisitu azwagwa ngobe lukwalo igogu gopela Phawuli esanhu akabhuda mujele. Luka waka eyenda naMpositoli Phawuli ndizo ke angaba akakwala lukwalo igogu ali munzi-nkulu we Antiyokhi. <char style="bk">Lukwalo gweMihingo</char> whuyendilambeli <char style="bk">kweNdebo mbuya yaLuka,</char> gotangisa Yesu eyenda kudzimu. Tjinangwa tjaLuka tjekwala lukwalo igogu nditjo zwatjo tjekwala ndebo mbuya. Waka ehaka kuti Thiyofilasi, neMaKhirisitu sewanda kwawo babe nelebeswa netjabakadiyiwa, ndizo wakakwala nlondesedzo yebutjilo gwaYesu ne andama tjeTjikhirisitu yakatambunuka.</para>
  <para style="ip">
    <char style="bk">Lukwalo gweMihingo</char> gotilakidza kuti Gubungano lemahhuba ekutanga laka lilingika tjini nekuti kwaka kuli tjini tjila ngekugalamoyo kuna Yesu. Bapositoli banotilakidza kuti tingabhatilila tjini kumasimba eMeya Yakayengemala mukusumikila ndebo mbuya kubanhu.</para>
  <para style="iot">Nlongoloso Yezwimukati</para>
  <para style="io1">Meya Yakayengemala inohha kubadiyiwa kwekutanga gubungano likotangisa kula (Mihingo 1.1-8.1).</para>
  <para style="io1">Gubungano lodziyidziwa, lotangisa palalila lihhala kuhhe kweJerusalema (Mihingo 8.2-12.23).</para>
  <para style="io1">Phawuli uyenda gwendo gwesumikila kwekutanga (Mihingo 12.24-14.28).</para>
  <para style="io1">Lubahhe gokubungana muJerusalema kuti kube netjisungo tjezwakalingisana nebagalimoyo batshwa (Mihingo 15.1-35).</para>
  <para style="io1">Phawuli uyenda gwendo gwesumikila kwebubili (Mihingo 15.36-18.22).</para>
  <para style="io1">Phawuli uyenda gwendo gwesumikila kwebutatu (Mihingo 18.23-20.38).</para>
  <para style="io1">Phawuli unosungwa muJerusalema (Mihingo 21.1-26.32).</para>
  <para style="io1">Phawuli unoyendesewa kuRoma (Mihingo 27.1-28.31).</para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />Ndakatongokukwalila, Thiyofilasi, mulukwalo gwekutanga. Ndikubudza kose kwakayetiwa naYesu nekwaakadiya, <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />kuswika pahhuba laakatogwa eyenda kudzimu, hule kwekusinobe alaya bapositoli baaka ahalula ngeMeya Yakayengemala. <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />Kwemahhuba makumi mana wakazwilakidza kubali nebusupi gusingalambike kuti iye umpenyu. Bakawumbona akalebeleka nabo nekwebumambo gweNdzimu. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />Pabakakubungana wakabalaya eti, “Musitongobhuda muJerusalema, koga mulindile tjigadzabgwe tjaTate, eti, tjamakawha ndileba nekwatjo. <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />Johane wakabe ebvubika muvula, koga imwi mowhobvubikiwa neMeya Yakayengemala mahhuba asi mangana anotobela.”<verse eid="ACT 1:5" /></para>
  <para style="s">Yesu Unotogwa Eyenda Kudzimu</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />Bakati bahangana naYesu bali panhu pan'ompela bakawumbhuzwa beti, “He, mulubaka guno motjowhobgwiliza Bumambo gwaIsirayeli?”<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />Wakati kubali, “Akutekwenyu kuti muzibe lubaka nezwibaka zwakabigwa naTate ngemasimba abo, akuzolingisana namwi kuti mukuzibe ikoko. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />Koga mowhowamutjila masimba, Meya Yakayengemala payinowhojitila pehhugwi kwenyu, mukakobe basupi bangu muJerusalema, nemuJudiya yose, nemuSamariya kudzina kunoswika kubupelo gwehango.” <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" />Hule kwekusinobe apedza leba ikoku, wakasengegwa kudzimu bakawunlinga bose, akasumbikiwa negole kuti basitjawumbone.<verse eid="ACT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10" />Bakati betjakazutulila meho hhuhhugwi paakatogwa oyenda, tjinyolotjo, balume babili bakambala zwiyambalo zwitjena bakama ntome kwabo, <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />bakati kubali, “Ye imwi balume bekuGalile, mumilileni ipapo makazutulila meho kumakole? Yesu iwhoyu watogwa mbeli kwenyu akayenda kudzimu, unowhohanduka nezila iyo zwayo yamawumbona eyenda nayo.”<verse eid="ACT 1:11" /></para>
  <para style="s">Mathiyasi Unohagwa kuti atole Bugalo gwaJudasi</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />Bapositoli bakabe bebgwilila kuJerusalema, bejetuka mudombo leMitoba, kwaka kuli gwendo gwesabatha<note caller="+" style="f"><char style="fr" closed="false">1.12 </char><char style="ft" closed="false">gwendo gungaba khilomitha in'ompela</char></note> kubva munzi-nkulu weJerusalema. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />Bangina munzi-nkulu, bakayenda kun'umba yapehhugwi, kwabake begala. Kwaka kuli Phethiro, naJohane, naJakobe, naAndhireya, naFiliphi, naTomasi, naBhatholomewu, naMatewu, naJakobe nkololo waAlifiyasi, naSimoni (Njhuta unogwila lusununguko) naJudasi nkololo waJakobe. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />Baka bogala bekubungana betembezela beli moyo un'ompela, kose nebetjikadzi, naMariya mayi baYesu nebanun'una baYesu.<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />Mumahhuba iyawo Phethiro wakamilika kuti alebeleke pakati kwebagalimoyo (banhu ibabo baka bangaba gulu nemakumi mabili). <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />Akati, “Hama dzangu, kwaka kwakafanila kuti lukwalo guhhadzisike sekwakalebgwa neMeya Yakayengemala ngenlomo Davida elebesambeli nekwaJudasi wakatungamila banhu bakasunga Yesu. <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />Judasi waka ali umwe wegubungano ileli, kakale waka akabhata tjimwe tjikamu tjen'hingo iwhoyu.”<verse eid="ACT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18" />(Nlume iwhoyu wakatenga minda nemari yaakawana nemihingo iye yakayipa, ndiyo yaakafila muyili; awila pasi nen'holo akapatuka mabula awe akabhudila kuhhe akahhala pasi. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />Banhu bose banogala muJerusalema bakakuwha, ndizo bakadana minda iyeyo beti Akelidama nelulimi gwabo, kuleba kuti, “Minda yeMalopa.”)<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />“Nekuti kwakakwagwa mulukwalo gweNjimbo kuti,</para>
  <para style="q1" vid="ACT 1:20">“ ‘N'umba iye ngayibe dongo;</para>
  <para style="q2" vid="ACT 1:20">ngakusibe nenhu unowhogala mo.’</para>
  <para style="m" vid="ACT 1:20">Kwakakwagwa kakale kuti,</para>
  <para style="q1" vid="ACT 1:20">‘Tjigalo tjaabe ehingila mutjili ngatjitogwe newumwe.’<verse eid="ACT 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21" />“Ndizo ke pakati kwebalume bose ibaba bakatitobela kubva mulubaka He Yesu eyenda muhango etjila naswi, <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />kubvisila kulubaka gwebvubika kwaJohane, kudzina kunoswika lubaka gwaakamilidziwa Yesu edusiwa mutili, ngakube newumwe unowhogadziwa kuti abe nsupi wekumuka kukwe panhu pan'ompela naswi.”<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />Ndizo bakahalula balume babili. Josefa wake eyi Bhasabhasi (wake ezibgwa kuti ndiJasitasi), naMathiyasi. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />Bakakotjitembezela beti, “He, moziba mikumbulo yebanhu bose, tjitilakidzani kuti pakati kwebanhu babili ibaba ndiwupi wamahalula <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />kuti ahinge bupositoli mubugalo gwakasiyiwa naJudasi, eyenda kubugalo gugwe.” <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />Batjikandila malipa kuti bahale umwe pabubili gwabo, lipa likawila pana Mathiyasi, akabva atogwa kuti abe wumwe webapositoli bali gumi newun'ompela.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">Buya kweMeya Yakayengemala</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />Kwakati hhuba lePhentekhositi laswika, baka bakakubungana panhu pan'ompela. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />Tjinyolotjo kwakawhakala nsindo ubva kudzimu unonga wemhepo inohhuhhudza nemasimba, ukahhala n'umba yose pabaka baligele. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />Bakabona kunofanana nendimi dzemoto, dzakakopalalana dzikawila pehhugwi kwabo bose. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />Bose bakahhala Meya Yakayengemala bakatangisa lebeleka nedzimwe ndimi, sekwabakapiwa ngeMeya kuti balebe.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />Kwaka kuna maJuta aka egala muJerusalema, balume bakazwipila bakabebva muhango dzepasi lose. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />Bakati bewha hhoba, kukakubungana mbunga nkulunkulu, bose bakatjenama, ngobe umwe newumwe wakabawha belebeleka nelulimi gugwe gwekwaakazwagwa. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />Bakatjenama bakati, “Banhu ibaba banolebeleka abate bekuGalile? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />Ngono nentha yeni tibawha belebeleka nendimi dzedu dzekwatakazwaligwa? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />Tobva kuPhathiya, nekuMedesi, nekuElamu, nekuMesophothamiya, nekuJudiya, nekuKhapadosiya, nekuPhontiyu, nekuAsiya, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />nekuPhurayijiya, nekuPhamfiliya, nekuIgipita, nedzimwe ntha dzekuLibhiya pedlo neKhureni. Bamwe bezi banobva kuRoma, <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />maJuta neBataya bakahanduligwa kulunamato gwetjiJuta, bamwe bedu banobva kuKhiriti nekuArabhiya, koga tose tobawha belebeleka nendimi dzedu beleba mihingo mikulu yakayetiwa neNdzimu.” <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />Kwakabahanganya miholo, bakabhuzwana beti, “Kolebani ikoku?”<verse eid="ACT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13" />Koga bamwe bakabakejula beti, “Balume ibaba bakalaladzisiwa newayini ndzwa.”<verse eid="ACT 2:13" /></para>
  <para style="s">Phethiro Unolebeleka Negubungano</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />Phethiro wakakotjimilika nebamwe bapositoli bali gumi newun'ompela, akatangisa lebeleka nembunga ngewhi lipehhugwi eti, “Banhu beJudiya namwi mose banogala muJerusalema, whililani kundili ndimubudze kuti ikoku kobva kutini. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />Banhu ibaba abazolaladza sekwamunokumbulila; ngwenuwali lubaka gwe awa yebutatu kubvisila bhuda kwehhuba. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />Koga whoku ndiko kwakalebgwa naJoweli nlebesambeli eti,<verse eid="ACT 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17" />“ ‘Whoku ndiko kwandinowhothama mumahhuba ebupelo, kojalo Ndzimu.</para>
  <para style="q2" vid="ACT 2:17">ndowhodululila Meya yangu pehhugwi kwebanhu bose.</para>
  <para style="q1" vid="ACT 2:17">Bakololo nebakololokadzi benyu banowholebesambeli;</para>
  <para style="q2" vid="ACT 2:17">bahhuhha benyu banowhobona zwilakidzilo,</para>
  <para style="q2" vid="ACT 2:17">banhutana benyu banowhowolota mawoloto.<verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />Kene nekubalanda nebalandakadzi bangu,</para>
  <para style="q2" vid="ACT 2:18">ndowhodululila bo Meya yangu mumahhuba iyawo,</para>
  <para style="q2" vid="ACT 2:18">banowholebesambeli.<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />Ndowhoyeta makaabadzo muhhuhhugwi</para>
  <para style="q2" vid="ACT 2:19">nematjenamiso pasi pano muhango.</para>
  <para style="q1" vid="ACT 2:19">Kowhobe nemalopa, nemoto, nebusi gwakazwinikidza<note caller="+" style="f"><char style="fr" closed="false">2.19 </char><char style="ft" closed="false">Busi gwakazwinikidza koleba “bhototi”</char></note>;<verse eid="ACT 2:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="ACT 2:20" />hhuba lowhodzimwa kukabe hhalima,</para>
  <para style="q2" vid="ACT 2:20">mwedzi ukahandugwa ukabe malopa,</para>
  <para style="q2" vid="ACT 2:20">kose ikoku kowhoyetikala hhuba gulu laHe linotjenamisa lisanhu laswika.<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />Yani nayani unodana zina laHe unowhotjidziwa.’ ”<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />“Whililani matama iyawa, imwi balume bekuIsirayeli! Yesu wekuNazaretha, nlume wakalakidza masimba ekudzimu akabon'wa patjena ngemakaabadzo nezwilakidzilo zwakayetiwa neNdzimu ehingisa iye. Mose mokuziba ikoko, ngobe kwakayetiwa pakati kwenyu, <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />Yesu iwhoyo wakatuligwa mumaboko enyu kuyendidzana nendongoloso yeNdzimu; imwi mukawumbulaya nekuti makalekedza banhu basina nlayo bakawunkowhomela patjileyanyo. <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />Koga Ndzimu wakawumusa kubafi, akawunsunungula kumasimba ago, nekuti kwaka kusingake kukayetikala kuti lufu guwumbhatilile. <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />Nekuti Davida wakati eleba nekukwe akati,</para>
  <para style="q1" vid="ACT 2:25">“ ‘Ndakabona He ali mbeli kwangu lubaka gose,</para>
  <para style="q2" vid="ACT 2:25">upedlo nami, kakale anditowhozunguziwa;<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />Ndizo ke moyo wangu unakuhanha</para>
  <para style="q2" vid="ACT 2:26">nematama angu ahhele kuhanha;</para>
  <para style="q1" vid="ACT 2:26">nembili wangu unowhogala mukugalabgwe.<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />Nekuti amutowhosiya meya yangu ili muHhedesi<note caller="+" style="f"><char style="fr" closed="false">2.27 </char><char style="ft" closed="false">bugalo gwebafi</char></note>;</para>
  <para style="q2" vid="ACT 2:27">amutowhobvumila wakaYengemala wenyu kuti abole.<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />Makandizibisa zila dzebupenyu,</para>
  <para style="q2" vid="ACT 2:28">kakale buyapo gwenyu gowhondihhadza nekuhanha.’ ”<verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />“Hama, ndolebeleka namwi ndinatjilopa nekwabatategulu bedu Davida bamunoziba mose. Bakafa bakabiganyiwa, nekumbu tjabo tjipano patiyapo kudzina kube nasi. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />Baka bali nlebesambeli, kakale beziba kuti Ndzimu wakabagadzabgwe kuti unowhogadza umwe wetjizekugwana tjabo patjigalo tjabo tjebumambo. <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />Davida waka abona kuti Ndzimu unowhothamani mulubaka gunotobela, ndizo ke wakalebeleka nekwemuka kwaKhirisitu eti,</para>
  <para style="q1" vid="ACT 2:31">“ ‘Haazosiyiwa muHhedesi;</para>
  <para style="q2" vid="ACT 2:31">kakale mbili uwe awuzobola.’<verse eid="ACT 2:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="ACT 2:32" />Yesu iwhoyo, Ndzimu wakawumusa kubafi, kakale tose tibasupi bayikoku. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />Wakamilidzigwa kuluboko gweludli gweNdzimu, atjiwamutjila Meya Yakayengemala inobva kuna Tate sekwabakagadzabgwe, watjidulula ikoku kwamunobona nekwamunowha. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />Ngobe Davida azowulukila kudzimu; koga iye tjekukwe wakati,</para>
  <para style="q1" vid="ACT 2:34">‘He wakati kuna He wangu.</para>
  <para style="q2" vid="ACT 2:34">Gala kuluboko gwangu gweludli,<verse eid="ACT 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35" />ndidze ndiyete zwita zwizo kuti zwibe tjigadziko tjemakumbo awo.’<verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />“Banhu bose beIsirayeli ngabazibe zwakwako kuti Yesu iwhoyu, wamakakowhomela patjileyanyo, ndiyezwe watiwa neNdzimu kuti abe He kakale abe Khirisitu!”<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />Banhu bakati bewha ikoko bakadziyidzika mumimoyo, bakati kuna Phethiro nebamwe bapositoli, “Tithameni hama dzedu?”<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />Phethiro wakati kubali, “Handukani mumatjinyo enyu mubvubikiwe muzina laYesu Khirisitu kuti muyetigwe mazwibhatigwa matjinyo enyu, kuti mukowamutjila tjipo tjeMeya Yakayengemala. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />Ngobe tjigadzabgwe ndetjenyu nebana benyu, nebamwe bose banowhodan'wa naHe Ndzimu wedu.”<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />Wakapa busupi ne amwe matama manjinji kakale akabakuludzila, eti, “Muzwitjidze mutjizekugwana itjetji tjakayipa!” <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />Banjinji babo bakagalamoyo matama awe bakabvubikiwa, muhhuba ilelo kwakapamhidzigwa banhu bali zwiwulu zwitatu. <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />Bakayendila mbeli muzwidiyo zwebapositoli nekuzwipila, bedlidzana, nepemulilana tjinkwa netembezela.<verse eid="ACT 2:42" /></para>
  <para style="s">Dlidzana Kwebagalimoyo</para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />Wose nhu wakahhigwa nehla kukulu bapositoli pabaka bethama matjenamiso manjinji nezwilakidzilo zwinjinji. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />Banogalamoyo bose baka bali panhu pan'ompela bedlidzana, kakale bekobelana zwinhu zose zwabaka banazo. <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />Bakatengesa zwinhu zwabaka banazo bakakobelana mari nebamwe bose kuyendidzana nekuti baka bana zwinotayila zwingapani. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />Hhuba nehhuba baka bekubungana muthempeli, kakale baka bekobelana tjinkwa kudzin'umba dzabo bedla zodliwa bali panhu pan'ompela, nemimoyo yabo yakahalabvuka inakuhanha, <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />belumbidza Ndzimu, bediwa nebanhu bose. He wakapamhidzila banhu baka betjidziwa kugubungano labo mahhuba ose.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">Phethiro Unopodza Tjilema Tjakatjikumbila</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />Kwakati limwe hhuba Phethiro naJohane beyenda kuthempeli mulubaka gwe awa yebuhhanalume kubvisila hhuba libhuda, latewuka, guli lubaka gwentembezelo. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />Umwe nlume waka ali tjilema kubvila pakuzwagwa kukwe, waka esengewa mahhuba ose esiwa pankoba wethempeli unoyi Nkoba Wakanaka kuti akumbile zwipo kuna baka bengina muthempeli. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />Wakati ebona Phethiro naJohane betjowhongina muthempeli, akakumbila kuti bawumpe zwipo. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />Phethiro wakawunlingisisa, anaJohane, akati kuwunli, “Utilinge!” <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />Akabalinga ekumbulila kuti unowhowana tjimwe tjinhu kubali. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />Koga Phethiro wakati kuwunli, “Andina siliva nezeezi, koga ndokupa kwandinako; muzina laYesu Khirisitu wekuNazaretha, milika uyende!” <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />Akabe ewumbhata neluboko gweludli akawumilidza. Tjinyolotjo makumbo awe nezwingoringori kwakabva kwasima; <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />wakatjuluka akama nemakumbo awe, akatangisa yendayenda akangina nabo muthempeli, eyenda etjulukana elumbidza Ndzimu. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />Banhu bose baka bali mukati bakawumbona eyenda elumbidza Ndzimu, <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />bakati bebona kuti ndiye waka egala paNkoba Wakanaka wethempeli ali tjikumbili, bakatjenama kuti ini tjayetikala kuwunli.<verse eid="ACT 3:10" /></para>
  <para style="s">Matama aPhethiro muThempeli</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />Wakati etjakakwakwatila Phethiro naJohane bali mugutukutu laSolomoni, sekwalaka lidan'wa, banhu bakalabuka behha kubali bakatjenama. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />Phethiro wakati ebona banhu, akati kubali, “Banhu bakanyi kwedu bekuIsirayeli, motjenamisiwa neni muna ikoku, kakale motilingilani zwingapa kunga kunoyi tathama kuti iwhoyu nhu ayende ngemasimba edu nebuyengemali gwedu? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />Ndzimu waAbhurahhamu, naIsaka, naJakobe, Ndzimu wabobatategulu bedu, wakapa gudzo kuna Yesu nlanda uwe. Iye wamakatula mbeli kwaPilatu mukawunlandula, nekutobe wakabe akumbula kuti awunletje ayende. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />Waka akayengemala akalulama, koga imwi makawunlandula, mukahala kuti musununguligwe mbulayi. <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />Makabulaya iye unotungamilila kubupenyu, koga Ndzimu wakawumusa kubafi. Ngono iswi tibasupi bayikoku. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />Ngezina lile, nange galamoyo muzina lile, kwathama kuti nlume iwhoyu wabe ali tjilema wamunobona kakale wamunoziba asime; whugalamoyo muzina laYesu kwathama kuti anaye mbeli kwenyu mose.”<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />“Sangwenuke, hama dzangu, ndoziba kuti makakuthama nekusaziba, sekwakathama bo batungamili benyu. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />Koga Ndzimu tjaakaleba ntolontolo ehingisa balebesambeli, kuti Khirisitu unowhodziyidzika; wakakuhhadzisa. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />Handukani, mubgwilile kuNdzimu, kudze muyetigwe mazwibhatigwa matjinyo enyu, <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />kuyetila kuti zwibaka zwenyaluluka zwihhe zwibva mubuyapo gwaHe, nekuti amutumile Khirisitu Yesu waakamuhalulila iye, <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />iye wakafanila gala kudzimu kudzina kunoswika lubaka gwekuti zwinhu zose zwakalebgwa neNdzimu ngemilomo yebalebesambeli bakayengemala bantolo zwihhadzisike. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />Ngobe Mozisi wakati, ‘He Ndzimu wenyu unowhomutumila nlebesambeli, unowhobe umwe webanhu bakanyi kwenyu sami. Muwhilile zwinhu zose zwaanowhomubudza kuti muzwithame. <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />Kowhoyetikala kuti umwe nemwe usingowhowuwhilila nlebesambeli iwhoyo unowhopalalanyiwa nebanhu akapaladziwa.’ <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />Balebesambeli bose bakalebeleka kubvisila kuna Samuyeli, nebamwe bakawuntobela, bakabeleba matama iwo zwawo ezwinhu zwinoyetikala mumahhuba ano. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />Mubakololo bebalebesambeli nebetjibvumilano Ndzimu tjaakapa bobatategulu benyu, eti kuna Abhurahhamu, ‘Kubvila mutjizekugwana tjitjo ludzi gose gwamuno muhango gowhokombolegwa.’ <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />Ndzimu, atjihala nlanda uwe, wakawuntuma kumuli kutanga, kuti amukombolele ngeyeta kuti muhanduke muzila dzenyu mbi.”<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">Phethiro naJohane bali mbeli kweLubahhe</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />Bakati batjalebeleka nebanhu, baphirisiti, nebalindi bethempeli, nebaSadusi bakaswika, <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />bakadziyidzika kwazo nekuti baka bediya banhu kakale besumikila musiwa kwebafi muzina laYesu. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />Bakababhata, koga saku aka abe madekwana, bakabahhalilila mujele kuti bakobabona tjimuka. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />Koga bunji gwebakawha dama bakagalamoyo; banhu betjilume bakagalamoyo bakabengaswika zwiwulu zwihanu.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />Hhuba linotobela batungamili, nebawhola, nebakwali bakakubungana muJerusalema. <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />Anasi mphirisiti nkulu wakabe alipo bo, naKhayiyafasi, naJohane, naAlekizanda nebamwe balume ben'ha wemphirisiti nkulu. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />Bakati batjibahhisa mbeli kwabo, bakababhuzwisa beti, “Mahingisa masimba kene zina lani kuti muthame ikoku?”<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />Koga Phethiro alihhele Meya Yakayengemala wakabahandula eti. “Batungamili bebanhu namwi bawhola, <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />hapa kuli kuti nasi tobhuzwisisiwa nekwen'hingo wakanaka wayetiwa kutjilema itjetji, nekuti tjatjila tjini, <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />tjikuzibani ke moseni, nebanhu bose beIsirayeli. Kwayetiwa ngezina laYesu Khirisitu weNazaretha, wamakakowhomela patjileyanyo, koga Ndzimu waakamusa kubafi, kuti iwhoyu nlume ame mbeli kwenyu ali mpenyu sayikoku. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />Ndiye</para>
  <para style="q1" vid="ACT 4:11">“ ‘bgwe lakalambiwa namwi babaki,</para>
  <para style="q2" vid="ACT 4:11">koga latjiba bgwe linotambunudza mbako.’<verse eid="ACT 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12" />Akuna tjidziwa kunobva muwumwe, nekuti akuna limwe zina pasi kwekudzimu lakapiwa banhu kuti titjidziwe ndilo.”<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />Bakati bebona ba netjilopa kwaPhethiro naJohane, kakale bebona kuti banhu baka basakazwidiya, bakatjenama, bakabona kuti balume ibaba baka bena Yesu. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />Koga bebona nlumetate waka atjidziwa alimile nabo, bakahaya tjabaka bangaleba. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />Batjibalaya kuti babve palubahhe, bakasala belebeleka beli boga. <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />Bakabhuzwana beti, “Tibathameni ibaba balume? Umwe nemwe unogala muJerusalema unoziba kuti bathama jenamiso, latisingatubule landula. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />Koga kudze tidzibile andama kwayikoku, ayitjemeleni balume ibaba kuti basitjalebeleke nekwezina ileli kakale kuwumwe nhu.”<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />Bakabe botjibadanila mukati, bakabalaya kuti basitjalebeleke kene diya ngezina laYesu kakale. <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />Koga Phethiro naJohane bakahandula beti, “Kwakatambunuka mumeho eNdzimu kuti tiwhilile imwi pana kuti tiwhilile Ndzimu? Muzwibonele imwi; <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />nekuti atingatubule saleba tjatabona netjatawha.” <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />Bakati babahlihlidzila kakale, bakabaletja kuti bayende zwabo. Bakahaya kuti babathameni, nekuti banhu bose baka belumbidza Ndzimu ngentha yetjayetikala. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />Nlume wakabe tjilakidzilo tjepodzewa tjayetiwa pehhugwi kukwe waka ali nlumetate una makole ezwagwa anopinda makumi mana.<verse eid="ACT 4:22" /></para>
  <para style="s">Ntembezelo Webagalimoyo</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />Bakati balekedzewa bakayenda kubamwe babo bakanoleba kuti baphirisiti bakulu nebawhola batini kubali. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />Bamwe babo bakati bekuwha, bakamilidzila mawhi abo panhu pan'ompela kuNdzimu betembezela beti, “He Wemasimba, imwi makathama kudzimu nehango negungwa, nezwinhu zose zwimukati. <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />Makalebeleka ngeMeya Yakayengemala, ngenlomo watate bedu Davida nlanda wenyu, muti,</para>
  <para style="q1" vid="ACT 4:25">“ ‘Bataya bakamon'welani;</para>
  <para style="q2" vid="ACT 4:25">nebanhu banokumbulilani zwinhu zwisina n'hingo?<verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />Bomambo behango banolangana,</para>
  <para style="q2" vid="ACT 4:26">nebatongi bakakubungana</para>
  <para style="q2" vid="ACT 4:26">begwisana naHe nange Wakahhodzewa waHe.’<verse eid="ACT 4:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27" />Ngobe lebeswa Hherodi naPhontiyu Pilatu bakahangana panhu pan'ompela neBataya nebanhu beIsirayeli bamunzi-nkulu uno kuti balangane bagwise nlanda wenyu wakayengemala Yesu, wakahhodzewa. <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />Bakayeta tjakatjabigwa neluboko gwenyu nendongoloso yenyu ntolontolo kuti tjowhoyetikala. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />Kwangwenu ke He, lingani hlihlidzila kwabo, bvumilani balanda benyu balebe dama lenyu basingahle, <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />pakutambunudza luboko gwenyu mutjidze banogwala, muyete nezwilakidzilo nemakaabadzo ngezina lenlanda wenyu wakayengemala Yesu.”<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />Hule kwekusinobe batembezela, bugalo gwabaka bali muguli gwakazunguzika. Bose bakahhala Meya Yakayengemala bakasumikila dama leNdzimu basingahle.<verse eid="ACT 4:31" /></para>
  <para style="s">Bagalimoyo Banokobana Zwabanazo</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />Banogalamoyo bose baka bana moyo un'ompela nenkumbulo un'ompela. Akuna waka eti zwinhu zwaanazo ndezwizwe yega, koga baka bekobana zwinhu zose zwabakabanazo. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />Ngemasimba makulu bapositoli bakayendilambeli bepa busupi nekwekumuka kwaHe Yesu, kakale ngoni whulu dzaka dzili mubali bose. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />Kwaka kusina banhu banohaya pakati kwabo, ngobe nezwimwe zwibaka baka bana minda kene dzin'umba bakadzitengesa bakabuya nemari yentengo wadzo <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />bakayisa pamakumbo ebapositoli, ikokobegwa banhu bose kuyendilana nehaya kwabo.<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />Ndizo Josefa, Nlevi wekuSayiphurasi, wakakopiwa zina lodada ngebapositoli linoyi Bhanabhasi, (Kunobva kuti nkololo wekuludzila bamwe), <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />wakatengesa minda iye akahhisa mari yentengo wayo pamakumbo ebapositoli.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">Ananiyasi naSafira</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />Kwakati umwe nlume unoyi Ananiyasi nemfumakadzi uwe unoyi Safira, bakatengesa bo tjabaka banatjo. <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />Bakatjengelana nemfumakadzi uwe kuti basumbike imwe mari yabakawana, akalesi imwe, akayibiga pamakumbo ebapositoli. <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />Koga Phethiro wakati kuwunli, “Ananiyasi, kungentha yeni Satane alawula moyo uwo kuti unyepele Meya Yakayengemala usumbike imwe mari yawawana pakutengesa minda? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />Kati pawabe usanhu wayitengesa yabe isi iyo? Pawayitengesa, yaka isimumasimba awo? Kwakungina tjini ikoku mumoyo uwo? Awuzonyepela banhu, koga wanyepela Ndzimu.” <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />Ananiyasi wakati ewha matama iyawa, akawila pasi akafa. Luhlo gukulukulu gukawila bose bakakuwha. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />Bahhuhha bakamilika bakapetelela mbili uwe bakawunsengela kuhhe bakanowumbiganya.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />Hule kwema awa angaba matatu mfumakadzi uwe wakangina asingazibe tjayetikala. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />Phethiro wakawumbhuzwa eti, “Undibudze, ndiwo ntengo wamakatengesa nawo minda?”</para>
  <para style="p" vid="ACT 5:8">Wakahandula eti, “Ee ndiwo.”<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />Ndizo Phethiro wakati kuwunli, “Matilani kuti mulangane kudze mulike Meya yaHe? Linga! Makumbo ebanhu bayenda kunobiganya nlume uwo abe pankoba, nawebo banowhokusengela kuhhe.” <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />Tjinyolotjo wakawila pasi pamakumbo awe akafa. Bahhuhha bakangina bakawuwana afa bakawunsenga bakanowumbiganya ntome kwenlume uwe. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />Kwakaba nekuhla kukulu mugubungano lose, nemubanhu bose bakawha zwinhu izwezwi.<verse eid="ACT 5:11" /></para>
  <para style="s">Bapositoli Banotjidza Banji</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />Bapositoli bakayeta zwilakidzilo nemakaabadzo pakati kwebanhu. Bagalimoyo bose baka bali panhu pan'ompela mugutukutu laSolomoni. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />Akuna wakayedza hanganyila nabo, koga baka belingigwa pehhugwi nebanhu. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />Koga ke banogalamoyo baka bepamhidzilika kunaHe nebunji, lukawu gwebalume nebafumakadzi, <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />kwakayeta kuti banhu bahhise banogwala mudzizila bakabaladzika pamibhetha nedzinhobo kuti ntuzi waPhethiro, epindazwe, ube pehhugwi kwebamwe babo. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />Banhu bakakubungana bebva kumizi yakakombeledza Jerusalema, behhisa banogwala nebanodziyidziwa nemeyambi, bose bakanaya.<verse eid="ACT 5:16" /></para>
  <para style="s">Bapositoli Banodziyidziwa</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />Koga mphirisiti nkulu wakamilika nebamwe bose baaka anabo, baka bali bamwe bebaSadusi, balihhele fupa, <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />bakasunga bapositoli bakabasa mujele lebanhu bose. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />Koga busiku ntumwa waHe wakahhula mikoba yejele akabadusa, eti, <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />“Yendani munoma muthempeli mubudze banhu matama ose ebutjilo igogu.” <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />Bakati bewha ikoku, mangwanana ngwanana bakamukila kuthempeli bakanodiya banhu sekwabakalayiwa.</para>
  <para style="p" vid="ACT 5:21">Mphirisiti nkulu nebaaka enabo bakati beswika bakadana lubahhe nemakulukota ose eIsirayeli, bakati bapositoli banotogwa kujele babuyiwe nabo. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />Koga bahingi bakawana jele lakaberabegwa koga abazobawana, bakabgwilila benobudza bakababatuma, beti, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />“Jele taliwana lakaberabegwa kwemalebeswa ose, balindi bakalinda mikoba; koga patahhula mikoba tawana kusina nhu mukati.” <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />Nkulu webalindi bethempeli nemphirisiti nkulu nebamwe baphirisiti baka kaabala pabakabikigwa matama akajalo, bakahaya kuti ini tjinowhoyetikala. <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />Kukaswika umwe akati, “Lingani! balume bamakamasa mujele bamile muthempeli banodiya banhu.” <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />Nkulu webalindi wakayenda nebalindi bakanobuya nabo, besingahingise masimba, nekuti baka behla kuti banhu bangabakhikhitidza nemabgwe.<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />Hule kwekusinobe babuya nabo, bakabagadza mbeli kwelubahhe, mphirisiti nkulu akababhuzwa, <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />eti, “Atizomukowhomesedza kuti musidiye ngezina ileli, koga imwi mahhadza Jerusalema nezwidiyo zwenyu, kakale mohaka kuti malopa enlume iwhoyu abe pehhugwi kwedu.”<verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />Phethiro nebamwe bapositoli bakahandula beti, “Takafanila whilila Ndzimu pana kuti tiwhilile banhu. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />Ndzimu wabotate bedu wakamusa Yesu kubafi, wamakabulaya ngekuwunlembeledza patjileyanyo. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />Ndzimu wawumilidzila kuludli gugwe seNtungamili neNtjidzi; kuyetila pa banhu bekuIsirayeli nkoba wehanduka neyetigwa mazwibhatigwa matjinyo. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />Iswi neMeya Yakayengemala Ndzimu yaakapa banhu banoyiwhilila, tibasupi bayizwezwi zwinhu.”<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />Bakati bekuwha ikoku bakamon'wa kwazo bekayemula kuti bababulaye. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />Koga umwe Mfarisi waka eyi Gamaliyeli, ali ndhiyi wenlayo, waka elingigwa pehhugwi kwazo nebanhu bose, wakamilika pakati kwabo mulubahhe akalaya kuti balume ibaba badusigwe kuhhe kwelubakanyana. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />Akati kubali, “Balume beIsirayeli, ibani nenjele muna tjamunohaka thama kubalume ibaba. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />Mumahhuba akapinda kwakaba newumwe nlume unoyi Thediyasi, wakazwithama nhu wakwako, banhu bangaba makulu mana bakabhatana naye. Wakabulawa, banhu baka bewuntobela bakapalala, kose kukafuba. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />Hule kukwe kwakabayapo Judasi wekuGalile, mumahhuba ebagwa kwebanhu, akatjebela banhu kuti bawuntobele. Nayiye bo wakabulawa, nebatobeli babe bakapalala. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />Ndizo ke muna iyeyi ndebo yangwenuwali ndomupa mano ekuti; siyanani nebalume ibaba! Mubaletje bayende! Nekuti hapa kuli kuti ndongoloso yabo kene tjabanothama tjobva mubanhu, tjowhokona. <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />Koga hapa kuli kuti ndetjeNdzimu, amungabakunde. Mungangozwiwana mugwisana neNdzimu!”<verse eid="ACT 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40" />Bakabvumilana naye. Bakadana bapositoli bakati basukutigwe. Bakababudza kuti basitongolebeleka nekwezina laYesu, bekabaletja bakayenda zwabo. <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />Bapositoli bakamilika palubahhe, bakahanha kuti bawanikwa bakafanila kuti babhatisiwe honi nentha yezina laYesu. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />Hhuba nehhuba, baka besingaletje diya nesumikila muthempeli nemudzin'umba kuti Yesu ndiye Khirisitu.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">Halugwa Kwebalume bali Kutondeka</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />Mumahhuba iyawo kwakati badiyiwa bowanda, maJuta anolebeleka tjiGiriki akan'un'una nekwemaJuta anolebeleka tjiHhebheru. MaJuta anolebeleka tjiGiriki aka eti akuna unahanya nekwetjilikadzi dzawo pan'hingo wekobegwa zodliwa pahhuba nehhuba. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />Ndizo badiyiwa bali gumi nebabili bakadana bunga lose lebadiyiwa, bakati kubali, “Akuzolulama kuti tisiye sumikila dama leNdzimu tinokoba zodliwa. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />Hama, halani balume bali kutondeka pakati kwenyu banozibgwa balihhele Meya nebutjenjebvu, batingapa n'hingo iwhoyu. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />Iswi towhozwipila mukutembezela nesumikila dama.”<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />Ndebo iyeyo yakahanhisa bunga lose. Bakahala Sitefani, nlume uhhele bugalimoyo neMeya Yakayengemala; naFiliphi, naPhurokhorasi, naNikhano, naThimoni, naPhamenasi, naNikholasi weku Antiyokhi, waka ahandukila kulunamato gwetjiJuta. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />Bakahhisa balume ibaba kubapositoli, bakatembezela bakababiga maboko.<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />Ndizo ke dama leNdzimu lakaandama; badiyiwa baka bali muJerusalema bakawanda, nebamwe bo baphirisiti banjinji bakatangisa galamoyo.<verse eid="ACT 6:7" /></para>
  <para style="s">Sitefani Unobhakhwa</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />Sangwenu ke Sitefani, alihhele ngoni nemasimba, wakayeta matjenamiso makulukulu nezwilakidzilo pakati kwebanhu. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />Koga bamwe bemusinagogu yeBanhu Bakasunungugwa (sekwayake idan'wa), nemaJuta ekuKhureni, neekuAlekizandha, neekuSilisiya, neekuAsiya, akamilika akatangisa kakabadzana naSitefani. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />Koga abazotubula kulila butjenjebvu neMeya yaaka elebeleka ndiyo. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />Bakanobudzila ntome bamwe balume pakasumbikika kuti banyepe beti, “Takawha Sitefani eleba matama akayipa etuka Mozisi neNdzimu.” <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />Bakadzonga banhu nebawhola, nebakwali, bakabhata Sitefani bakawunlesi mbeli kwelubahhe. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />Bakahhisa banhu banopa busupi gwemanyepwa, bakahha benyepa beti, “Iwhoyu nlume atoletja leba zwinhu zwakayipa nekwebugalo gwakayengemala igogu nekwenlayo; <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />ngobe takawuwha eti Yesu wekuNazaretha unowhopwanya thempeli ileli akapitulanya milayo yatakapiwa naMozisi.” <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />Bose baka baligele mulubahhe bakalingisisa Sitefani, bakabona kuti buso gugwe gwaka gunga buso gwentumwa weNdzimu.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">Ndebo yaSitefani ali mbeli kweLubahhe</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />Mphirisiti nkulu akawumbhuzwa eti, “Ikoku kumalebeswa?”<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />Iye wakahandula eti. “Makamu angu namwi botate, mundiwhilile! Ndzimu wegudzo wakazwilakidza kunatate bedu Abhurahhamu batji kuMesophothamiya basanhu bakagala kuHharani. <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />Akati kubali, ‘Ibva pahango iyo nekubanhu babo, uyende kuhango yandinowhokulakidza iyo.’ <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />Ndizo bakafuluka muhango yemaKhaladiya bakanogala kuHharani. Hule kwefa kwatate babo, Ndzimu wakabadusa ikweno akabagadza muhango iyeyi yamabagele muyili; <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />koga Ndzimu azotongobapa nhaka muyili, ndibva kene ipo pangalizana nenhambo yegumbo. Koga wakabagadzabgwe kuti unowhobapa iyo, ibo netjizekugwana tjabo tjinowhohha hule kwabo, nekutobe lubaka igogo baka basina mwana. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />Ndzimu wakalebeleka nabo nezila iyeyi. ‘Tjizekugwana tjitjo tjowhobe ntaya muhango isi yatjo, tjowhoyetiwa balanda banobhakhwa zwinogwadza kwemakole ali makulu mana. <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />Koga ndowhotonga tjaba itjetjo tjabanowhohingila sebalanda,’ kujalo Ndzimu, ‘hule kwayikoko banowhobhuda muhango iyeyo, bakandinamata mubugalo igogu.’ <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />Akakopa Abhurahhamu tjibvumilano tjethumbiwa. Abhurahhamu akaba tate baIsaka akawunthumbila muhhuba lebuhhanakadzi hule kwezwagwa kukwe. Hule kwayikoko Isaka wakaba tate baJakobe, Jakobe akaba tate babobatategulu bali gumi nebabili.”<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />“Ngentha yekuti botategulu baka bana fupa nekwaJosefa, bakawuntengesa kuti anobe nlanda kuIgipita; koga Ndzimu wakaba anaye, <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />akawunsunungula mubulemo gugwe gose, akawumpa butjenjebvu akayeta kuti adiwe naFaro mambo wekuIgipita; iye wakawunthama mbhati wehango yose yeIgipita nen'umba iye yose. <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />Kwakahha bhamba muIgipita nemuKhenani kukadziyigwa kwazo, botate bedu bakahaya zodliwa. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />Jakobe wakati awha kuti kuna zodliwa kuIgipita, akatuma botate bedu kwekutanga. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />Bakati boyenda gwebubili, Josefa akababudza kuti ndiye yani, Faro akazibisiwa nekwehama dzaJosefa. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />Josefa wakati kubuyiwe natate babe Jakobe nehama dzose, kwaka kuli banhu bali makumi ali kutondeka nebahanu, <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />Jakobe wakayenda kuIgipita, kwaakanofila iye nabotate bedu, <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />bakasengwa bakabgwiliziwa kuShekemu bakabiganyiwa mukumbu tjakatengwa naAbhurahhamu nemari kubakololo baHhamo muShekemu.”<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />“Kwakati lubaka gwasedzela kuti Ndzimu ahhadzise tjaakagadzabgwe Abhurahhamu, banhu bakawanda muIgipita <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />kudza kuswika lubaka gwewumwe mambo wakatonga Igipita waka asingatjazibe Josefa. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />Wakabhata banhu bakanyikwedu zwakayipa, akabatshambidzila botate bedu, ebamanikidza kuti balahe bana babo batjambozwagwa kuti basitjile. <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />Mulubaka igogo Mozisi wakazwagwa, waka akanaka mbeli kweNdzimu. Wakalegwa kwemimwedzi mitatu ali mun'umba yatatayi; <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />paakadusigwa kuhhe, nkololokadzi waFaro wakawuntola akanowunlela senkololo uwe. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />Mozisi wakadiyiwa butjenjebvu gose gwemaGipita akabe nemasimba mukulebeleka nemuzwiyeto.”<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />“Mozisi wakati atjibe nemakole makumi mana, kukaswika mumoyo uwe kuti anokumba banhu bakanyi kwabo MaIsirayeli. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />Wakabona umwe wabo ebhakhwa zwakayipa, akawunghwila, akabgwilizila ngekhikitidza Nghipita. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />Waka ekumbula kuti hama dzidze dzokuwhisisa kuti Ndzimu unowun'hingisa dzisunungula, koga dzaka dzisingakuwhisise. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />Hhuba linotobela Mozisi wakawana MaIsirayeli egwa. Akayedza kuti abawangule, eti kubali, ‘Balume, muhama; mohakilani kubadzana?’ <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />Koga iwhoyo waka ethama zwakayipa kuwumwe, wakasundila Mozisi kutjena eti, ‘Ndiyani wakuthama kuti ube nlawuli nentongi pehhugwi kwedu? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />Wehaka ndibulaya sekwawakabulaya Nghipita hhulo?’ <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />Mozisi wakati ekuwha ikoku akatihhila kuhango yeMidiyana kwaakanogala ali ntaya akazwala bakololo babili.”<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />“Kwapinda makole makumi mana, ntumwa weNdzimu wakaboneka kuwunli, mudenje lemhiwa linopfuta moto, mutjilambanyika tjeDombo leSinayi. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />Mozisi wakati ebona ikoku, akatjenamisiwa netjaaka akalinga. Paakasedzela eti anobona ali pedlo, wakawha whi laHe. <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />‘Imi ndiNdzimu wabobatategulu babo, Ndzimu waAbhurahhamu, naIsaka, naJakobe.’ Mozisi wakatetema, akasiyedze linga. <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />He wakati kuwunli, ‘Mbula hangu dzidzo; ngobe bugalo gwawumile po mavu akayengemala. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />Ndabona zwakwako tshambidzigwa kwebanhu bangu muIgipita, ndawha lila kwabo, kakale ndajetuka kuti ndibasunungule. Iwe tjibuya, ndokutuma kuIgipita.’ ”<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />“Ndiyezwe Mozisi iwhoyu wabakalamba nematama anoti, ‘Ndiyani wakuthama kuti ube nlawuli nentongi?’ Ndzimu wakawuntuma senlawuli nensununguli, ehingisa ntumwa weNdzimu wakaboneka mudenje lemhiwa. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />Wakabatungamila kuti babhude muhango yeIgipita athama matjenamiso nezwilakidzilo muIgipita, nepaGungwa Haba, nemutjilambanyika kwemakole ali makumi mana. <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />Ndiyezwe Mozisi iwhoyo wakabudza banhu bekuIsirayeli eti, ‘Ndzimu unowhomumusila nlebesambeli unonga imi pakati kwenyu.’ <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />Ndiye waka ali mugubungano mutjilambanyika panhu pan'ompela nentumwa weNdzimu wakalebeleka naye paDombo leSinayi, nabotate bedu; akawamutjila matama ebutjilo akawawamutjidza nekutili bo.”<verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />“Botate bedu bakalamba wuwhilila. Koga bakawunsundila ntome, mumimoyo yabo bakabgwilila kuIgipita, <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />beti kuna Aroni, ‘Utithamile midzimwana inowhotitungamila; ngobe iwhoyu Mozisi wakatitungamila tibva kuhango yeIgipita, atitjaziba kuti kwayetikani kuwunli!’ <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />Ndigo lubaka gwabakabumba ndzimwana wemhulu, bakahhisa tjibhayilo kundzimwana, bakahanhila mihingo yemaboko abo. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />Koga Ndzimu wakabafupatila, akabasiya kuti banamate zwivoneko zwekumakole. Sekwakwaka kwagwa mulukwalo gwebalebesambeli.</para>
  <para style="q1" vid="ACT 7:42">“ ‘Imwi banhu beIsirayeli,</para>
  <para style="q2" vid="ACT 7:42">makatongondipa zwibhayilo zwemhuka nemipilo,</para>
  <para style="q2" vid="ACT 7:42">kwemakole ali makumi mana mutjilambanyika?<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />Makasenga thebhanekili laMoloki,</para>
  <para style="q2" vid="ACT 7:43">nenyenyedzi yendzimwana wenyu Refani, zwifananidzo zwamakazwitila kuti muzwinamate.</para>
  <para style="q1" vid="ACT 7:43">Ndizo ndemutatila mbeli kweBhabhiloni.’ ”<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />“Bobatategulu baka bana thebhanekili lebusupi mutjilambanyika. Laka layetiwa sekwaka kwalebgwa ngewakabudza Mozisi kuti lithamiwe tjini, kufanana nezila yaaka abona. <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />Hule kwekube bawamutjila thebhanekili, botate bedu bakabuya nalo betungamigwa naJoshuwa pabakatolela hango dzimwe njudzi dzaka dzatakhwa neNdzimu. Lakaba ipapo kudzina kunoswika lubaka gwaDavida, <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />iye wakadiwa zwe neNdzimu, akakumbila kuti abakile Ndzimu waJakobe bugalo. <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />Koga ndiSolomoni wakawhobakila Ndzimu n'umba.<verse eid="ACT 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48" />“Koga, uPehhugwihhugwi atogala mudzin'umba dzakabakiwa nebanhu. Sekwakalebgwa nenlebesambeli eti.<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />“ ‘Kudzimu tjigalo tjangu tjebumambo,</para>
  <para style="q2" vid="ACT 7:49">hango tjigadziko tjemakumbo angu.</para>
  <para style="q1" vid="ACT 7:49">In'umba yakatini yamungandibakila?</para>
  <para style="q2" vid="ACT 7:49">Kene guyayi bugalo pandinganyaluluka? Unojalo He.<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />Haata maboko angu akabumba zose zwinhu izwezwi?’<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />“Imwi banhu bemitshibha yakawoma, basakathumbigwa mumimoyo nemuzebe! Makafanana nabotate benyu. Mogala mulamba Meya Yakayengemala! <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />Ndiwupi webalebesambeli wabasakadziyidza botate benyu ibabo? Bakabulaya banhu bakalebesambeli hha kweWakalulama, iyezwe imwi wamatjitengesa mukabulaya, <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />imwi makawamutjila nlayo wakahhisiwa nebatumwa beNdzimu koga amuzowuntobela.”<verse eid="ACT 7:53" /></para>
  <para style="s">Khikitidziwa kwaSitefani</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />Bakati bewha ikoku bakamon'wa bakalobanya meno. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />Koga iye alihhele Meya Yakayengemala, wakalinga kudzimu akabona gudzo leNdzimu, naYesu alimile kuludli gweNdzimu, <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />akaba eti, “Lingani, ndobona kudzimu kwakahhuka, neNkololo wenhu alimile kuludli gweNdzimu.”<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />Bakamimila nemawhi apehhugwi, bakazwina zebe dzabo, bakalabuka panhu pan'ompela beyenda kuwunli, <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />bakawunhhuhhuta bewundhusila kuhhe kwenzi-nkulu, bakawunkhikitidza ngemabgwe, basupi bakabiga zwiyambalo zwabo pamakumbo ewumwe nhhuhha unoyi Sawuli. <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />Pabaka bewunkhikitidza ngemabgwe, Sitefani wakatembezela eti, “He Yesu, wamutjilani meya yangu.” <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />Akabe epfigama akadanilila newhi lipehhugwi, eti, “He musibabone nlandu nekwejinyo ileli.” Hule kwekuti aleba ikoku akayezela.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />Sawuli wakabvumilana nebulawa kukwe.</para>
  <para style="s" vid="ACT 8:1">Dziyidziwa kweGubungano</para>
  <para style="p" vid="ACT 8:1">Muhhuba ilelo gubungano letshipi muJerusalema lakadziyidziwa kwazo, bose bakapalala bakatihhila kuntunhu wekuJudiya neSamariya, kuhhe kwebapositoli boga. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />Balume bakazwipila bakabiganya Sitefani, bakawunlilila kwazo.<verse eid="ACT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 8:3" />Koga Sawuli wakatangisa paladza gubungano letshipi, eyenda engina imwe neyimwe n'umba, ekakata bagalimoyo betjilume nebetjikadzi ebaposela mujele.<verse eid="ACT 8:3" /></para>
  <para style="s">Dama Losumikigwa muSamariya</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />Bagalimoyo ibabo bakapalala bakayenda besumikila dama pose pabanoyenda. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />Filiphi wakayenda kunzi-nkulu wekuSamariya akanosumikila nekwaKhirisitu. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />Mabunga ebanhu paakawha Filiphi elebeleka kakale bebona matjenamiso aaka ethama, bakawhilila ngemoyo un'ompela nange njele tjaaka eleba. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />Meyambi dzakadzibhuda mubanhu dzilila kwazo, nebanjinji baka bakalobgwa negulukadzi kene baka bali zwilema bakapodzewa. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />Ndizo kwakaba nekuhanha kukulu muna iwhoyo nzi-nkulu.<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />Kwaka kuna umwe nlume waka eyi Simoni egala munzi-nkulu iwhoyo, waka atjenamisa tjaba tjeSamariya ngemasalamusi awe. Nekuti waka ezwita nhu nkulukulu. <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />Banhu bose munzi-nkulu, bakulu nebatukununu, baka bewuwhilila, beti, “Iwhoyu nlume umasimba eNdzimu anodan'wa eyi Makulu.” <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />Baka bewuwhilila ngentha yekuti lubaka gwaka gwatjibe gulefu egala ebatjenamisa nemasalamusi awe. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />Koga bakati bagalamoyo Filiphi esumikila ndebo mbuya yebumambo gweNdzimu nezina laYesu Khirisitu, bakabvubikiwa, bose betjilume nebetjikadzi. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />NaSimoni bo wakagalamoyo, akati atjibvubikiwa akagala akazwisesekedza kuna Filiphi. Ebona zwilakidzilo nematjenamiso makulu aka eyetiwa wakatjenama kwazo.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />Sangwenu kwakati bapositoli bakuJerusalema bawha kuti Samariya yawamutjila dama leNdzimu, bakatumila Phethiro naJohane, <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />ibo bakati baswika bakabatembezelela kuti bawamutjile Meya Yakayengemala; <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />nekuti yaka isanhu yajitila pehhugwi kwabo bose, baka babvubikiwa muzina laHe Yesu koga. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />Bakababiga maboko bakawamutjila Meya Yakayengemala.<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />Simoni wakati ebona kuti bapositoli banobiga banhu maboko bakawamutjila Meya, akabaswiswa mari, <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />eti, “Mundipe bo masimba iyawa kuti nhu wandinobiga maboko, awamutjile Meya Yakayengemala.”<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />Koga Phethiro wakati kuwunli, “Siliva iyo ngayife nawe, nekuti unokumbula kuti ungatenga tjipo tjeNdzimu nemari! <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />Awuna bugalo kene gobe mundebo iyeyi, nekuti moyo uwo awuzotambunuka mbeli kweNdzimu. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />Handuka usiyane nebubi gugo igogu, utembezele kuna He kuti hapa kuyetikala akuyetile mazwibhatigwa ba nenkumbulo wakajali. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />Nekuti ndobona kuti unafupa kakale umubusungwa gwezwiyeto zwibi.”<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />Simoni wakabahandula eti, “Tembezelani kuna He kuti kusitongobe netjimwe tjezwinhu zwawaleba tjinowhoyetikala pehhugwi kwangu.” <verse eid="ACT 8:24" /><verse number="25" style="v" sid="ACT 8:25" />Sangwenu bakati bapa busupi kakale basumikila dama laHe, bakabgwilila kuJerusalema, beyenda besumikila ndebo mbuya mumizi minjinji yeMaSamariya.<verse eid="ACT 8:25" /></para>
  <para style="s">Filiphi neGulukota lekuIthiyopiya</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />Koga ntumwa waHe wakati kuna Filiphi, “Milika uyende kuburwa, kumwaha unobva kuJerusalema unoti kuGaza.” Umwaha usingatjahingisiwe. <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />Akamilika akayenda. Linga, kwaka kuna nlume wekuIthiyopiya, ali nsunugwa, waka ehingila Khandesi, mambokadzi weIthiyopiya, ali iye mbhati wedzimari, waka abuya kuJerusalema ewhonamata, <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />wakati obgwilila aligele mukoloyi iye, waka ebala matama enlebesambeli Isaya. <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />Meya ikati kuna Filiphi, “Labuka ubhatisane zila nekoloyi iyeyi.” <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />Filiphi akalabuka eyenda kuyili, akawuwha ebala lukwalo gwenlebesambeli Isaya, akawumbhuzwa eti, “Unowhisisa tjawunobala?”<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />Wakahandula eti, “Ndingawhisisa tjini kusina wanditjenesela?” Eba ekumbila Filiphi kuti atanhe mukoloyi. <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />Sangwenu ke tjikamu tjelukwalo tjaaka ebala kwaka kuli yetji.</para>
  <para style="q1" vid="ACT 8:32">“Semhwizi inonobulayiwa</para>
  <para style="q2" vid="ACT 8:32">kene semhwizana imbeli kwenteseli wayo yakanyalala,</para>
  <para style="q2" vid="ACT 8:32">nayiye haazotongohhula nlomo uwe.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />Mukulengudziwa kukwe wakalambigwa kuti nlandu uwe ubhakhwe nezila yakatambunuka.</para>
  <para style="q2" vid="ACT 8:33">Ndiyani ungaziba nekwetjizekugwana tjitje?</para>
  <para style="q2" vid="ACT 8:33">Ngobe butjilo gugwe gwakawhapugwa kubva muhango.”<verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />Nsunugwa wakati kuna Filiphi, “Nlebesambeli waka eleba nekwaani ipapa, ndokumbila undibudze, waka ezwibva iye kene waka ebva umwe?” <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />Filiphi akabe ehhula nlomo, ewumbudza ndebo mbuya yaYesu etangisila pana iyeyo ndima yelukwalo. <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />Bakati betjayenda mumwaha bakaswika pana vula, nsunugwa akati, “Bona, yeyi vula! Ini tjingandikonesa kuti ndibvubikiwe?” <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />(Filiphi wakati, “Hapa ugalamoyo nemoyo uwo wose, unotubula.” Iye akahandula eti, “Ndogalamoyo kuti Yesu Khirisitu ndiye nkololo weNdzimu.”)<verse eid="ACT 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38" />Wakabudza banhu babe kuti bamise koloyi. bakajetuka bubili gwabo bakangina muvula, Filiphi nensunugwa, akawubvubika. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />Bakati bebhuda muvula, Meya yaHe ikawhapula Filiphi; nsunugwa akasala asingatjawumbone, akayendila mbeli zwe akahanha kwazo. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />Koga Filiphi wakabon'wa abe kuAzotasi, waka eyenda engina mumizi yose imuzila esumikila kudzina kunoswika kuKhesariya.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">Handugwa kwaSawuli</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />Koga Sawuli, waka etjahlisidzila zwe badiyiwa baHe ngekubabulaya, wakayenda kumphirisiti nkulu <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />akanokumbila whalo dzeyenda kumasinagogu ekuDamasikasi, kuti akawana kuna bamwe batobeli bayiyeyi Zila, betjilume kene betjikadzi, abuye nabo bakasungwa kuJerusalema.<verse eid="ACT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3" />Ngono wakati atjimugwendo oswika kuDamasikasi, tjinyolotjo kwakapenya tjedza tjinobva kudzimu pawunli. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />Wakawila pasi akawha whi liti kuwunli, “Sawuli, Sawuli, unondidziyidzilani kene?”<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />Iye wakati, “Ndimwi yani He?”</para>
  <para style="p" vid="ACT 9:5">Whi likahandula liti, “Ndimi Yesu, wawunodziyidza; <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />koga, milika ungine munzi-nkulu, nowhobudziwa tjawunowhothama.”<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />Balume baaka eyenda nabo bakama bakanyalala bakati whuu, bewha whi koga nhu unolebeleka basingawumbone. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />Sawuli wakamuka pasi; akati ahhula meho akasibone tjinhu; ndizo ke bakawukweba ngeluboko bakayenda naye kuDamasikasi. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />Wakaba bhofu kwemahhuba matatu, kakale asingadle asingan'we.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />Kwake kuna umwe ndhiyiwa muDamasikasi zina lile lake liyi Ananiyasi. He wakati kuwunli mutjilakidzo, “Ananiyasi.”</para>
  <para style="p" vid="ACT 9:10">Iye akahandula eti, “Ndipano He.”<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />He wakati kuwunli, “Milika uyende kuzila inoyi Tambunuka, unobhuzwa mun'umba yaJudasi nekwenlume unoyi Sawuli wekuThasasi; nekuti linga, unotembezela saku wali, <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />kakale wabona nlume unoyi Ananiyasi ebuya ewhowumbiga maboko kuti apofunuke.”<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />Koga Ananiyasi wakahandula eti, “He, ndakawha kubva kubanjinji nekwenlume iwhoyu, kuti wakathama bubi gungapani kubayengemali benyu bemuJerusalema; <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />napano unamasimba aakapiwa nebaphirisiti bakulu kuti asunge banhu bose banodana zina lenyu.”<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />Koga He wakati kuwunli, “Yenda ngobe watjibe tjidla tjangu tjahagwa tjinowhosenga zina langu mbeli kweBataya nabomambo nebana baIsirayeli; <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />ngobe ndowhowunlakidza kuti wakafanila dziyila kungapani edziyilila zina langu.”<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />Ndizo Ananiyasi wakamilika eyenda akanongina mun'umba iyeyo. Ewumbiga maboko wakati, “Gamu langu Sawuli, He Yesu iye wakazwilakidza kukuli muzila yawakabuya nayo, wandituma kudze ubone kakale, ukohhadziwa neMeya Yakayengemala.” <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />Tjinyolotjo kwakawa zwinhu zwinonga makwapa zwibva mumeho awe akatangisa bona kakale. Akamilika akanobvubikiwa, <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />akadla zodliwa akawana masimba.</para>
  <para style="s" vid="ACT 9:19">Sawuli Unosumikila muDamasikasi</para>
  <para style="p" vid="ACT 9:19">Wakagala kwemahhuba manjinji ana badiyiwa muDamasikasi. <verse eid="ACT 9:19" /><verse number="20" style="v" sid="ACT 9:20" />Wakabva atangisa leba nekwaYesu mumasinagogu, eti, “Unkololo weNdzimu.”<verse eid="ACT 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21" />Bose bakawuwha bakatjenama beti, “Kati atayiye iwhoyu nhu wakamusa bhonyongo, muJerusalema, nekwebanhu baka bedana zina ileli? Ngono haazohhila iko zwako kuti ayende nabo kumphirisiti nkulu bali bakasungwa?”<verse eid="ACT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22" />Koga Sawuli wakayendilambeli ekula mumasimba, akahanganya miholo maJuta aka egala muDamasikasi ngelakidza kuti Yesu ndiye Khirisitu.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />Kwakati kwapinda mahhuba manjinji maJuta akalangana kuti awumbulaye; <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />koga Sawuli wakakuziba langana kwawo. Aka akalinda mikoba yenzi siku nesikati, kuyetila kuti awumbulaye; <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />koga badiyiwa bakawuntjuludza guma lenzi-nkulu bakawudelusa ali mutundu, guli busiku.<verse eid="ACT 9:25" /></para>
  <para style="s">Sawuli ali muJerusalema</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />Wakati aswika kuJerusalema akayedza kuti azwibhatshanye nebamwe badiyiwa; koga bakawunhla, ngobe besingagalemoyo kuti watjibe ndhiyiwa. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />Koga Bhanabhasi wakawuntola, akawuhhisa kubapositoli, akabalondesedzela kuti wakabona He tjini ali muzila, akalebeleka naye, nekuti wakasumikila tjini kuDamasikasi muzina laYesu. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />Ndizo wakagala nabo, eyenda muJerusalema esumikila muzina laHe akahalabvuka. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />Wakalebeleka kakale ekakabadzana nemaJuta anolebeleka tjiGiriki; koga ibo baka yedza wumbulaya. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />Koga hama dzakati dzakuziba, dzikawunsa kuKhesariya, dzikawuyendesa kuThasasi.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />Ndizo gubungano letshipi muJudiya, nemuGalile, nemuSamariya yose lakabe nekunyalala likabakika; kakale ngeyenda mukuhla He nenyaladziwa neMeya yakaYengemala, lakakula.<verse eid="ACT 9:31" /></para>
  <para style="s">Phethiro ali kuLayida nekuJopha</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />Sangwenu kwakati Phethiro eyenda yeno nayeno pakati kwabo bose, wakaswika kose nekubayengemali baka begala kuLayida. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />Ikweno wakanowana nlume unoyi Eniyasi, waka alilele pasi asingamuke mungubo kwemakole ali hhanakadzi akalobgwa negulukadzi. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />Phethiro wakati kuwunli, “Eniyasi, Yesu Khirisitu unokupodza; milika uwalule ngubo dzidzo.” Tjinyolotjo akamilika. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />Bose bagali bekuLayida neSharoni bakawumbona, bakahandukila kuna He.<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />KuJopha kwaka kuna umwe ndhiyiwa wetjikadzi waka eyi Thabitha, kunobva kuti Dokhasi, wake ana mihingo yakanaka yebhatsha bahayi. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />Mumahhuba iyawo wakagwala akafa; bakati bawungudza bakawunlalisa mun'umba yapehhugwi. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />Saku Layida yaka ili pedlo neJopha, badiyiwa bakati bewha kuti Phethiro uyikweno, bakawuntumila balume babili benowunkumbilisisa beti, “Tokumbila ubuye nekulibilidza.” <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />Ndizo Phethiro wakamilika akayenda nabo. Akati aswika bakawuyendisa kun'umba yapehhugwi. Njhilikadzi dzose dzakama ntome kukwe dzilila, dziwunlakidza nhako nezwimwe zwiyambalo zwaka zwipfumiwa naDokhasi atjinabo. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />Koga Phethiro wakabadusila kuhhe bose, akapfigama akatembezela; akati ehandukila kutjidumbu akati, “Thabitha, muka.” Akahhula meho awe, akati ebona Phethiro akamuka akagala. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />Akaba ewumbhata neluboko akawumilidza. Akadana bayengemali nenjhilikadzi akabaswisa iye ali mpenyu. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />Kukazibgwa muJopha yose, banjinji bakagalamoyo muna He. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />Akagala muJopha kwemahhuba manjinji anaSimoni, nsuki wemakukuta.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">Phethiro naKhoneliyasi</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />KuKhesariya kwaka kuna umwe nlume unoyi Khoneliyasi, waka ali nlawuli webagwi bengwa bali gulu, belubabi gwaka gudan'wa guyi ngwa yeIthali, <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />nlume wakazwipila kakale ehla Ndzimu, iye nen'ha uwe wose, waka epa banhu zwipo akahalabvuka, kakale etembezela kuNdzimu lubaka gose. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />Mu awa yebuhhanalume kubvisila hhuba libhuda, wakabona ntumwa weNdzimu mutjilakidzo eti kuwunli, “Khoneliyasi.”<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />Wakawunlingisisa ehla, akati, “Ini He?”</para>
  <para style="p" vid="ACT 10:4">Ntumwa weNdzimu wakahandula eti kuwunli, “Mitembezelo iyo nezwipo zwizo kwanoswika setjikumbuludzo kuNdzimu. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />Ngono ke tjitumila balume bayende kuJopha, banobuya nenlume unoyi Simoni, una limwe zina linoyi Phethiro; <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />unogala newumwe unoyi Simoni, nsuki wemakukuta, unan'umba intome kwegungwa.” <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />Ntumwa weNdzimu waka elebeleka naye wakati ayenda, akadana balanda babe babili, newumwe webagwi bengwa wakazwipila waka ewun'hingila, <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />apedza balondesedzela kose, wakabatuma kuJopha.<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />Hhuba linotobela, bakati batjimugwendo bosedzela pedlo nenzi-nkulu, Phethiro akayenda pehhugwi kwen'umba enotembezela, masikati mu awa yebutanhatu kubvisila hhuba libhuda. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />Akabe nehhala akayemula tjinodliwa; koga bakati batjabhika, akabe onga nhu wayizela <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />akabona kudzimu kuhhuka, kukajetuka tjimwe tjinhu, tjinonga jila, lakabhakhwa ngentha dzilina likaswika pano pasi. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />Mukati kwalo kwaka kuna njudzi dzose dzemhuka dzina makumbo mana nezwibandana zwemuhango, nenyunyi dzose dzemumhepo. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />Kukaswika whi kuwunli liti, “Milika Phethiro, bulaya udle.”<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />Koga Phethiro wakati, “Hayi aa, He; ngobe andanhu ndikatongodla tjinhu tjinahambgwa kene tjisakatjena.”<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />Whi lakaswika kuwunli gwebubili liti, “Usiti tjatjenesewa neNdzimu tjinahambgwa.” <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />Ikoku kwakayetikala katatu, tjinhu itjetjo tjikakotogwa tjinyolotjo tjikayenda kudzimu.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />Phethiro wakati etjakakaabala kuti tjilakidzo itjetjo tjolebani, linga, balume baka batumwa naKhoneliyasi batjibhuzwisisa kuti n'umba yaSimoni ndiyipi bakama pankoba <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />bakabhuzwa kuti Simoni unoyi Phethiro umwezi ipapo.<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />Phethiro wakati etjakumbulisisa nekwetjilakidzo, Meya ikati kuwunli, “Linga kuna balume batatu banokuhaka. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />Muka ujetuke, uyende nabo usinyetanyete; ngobe ndimi ndabatuma.” <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />Phethiro akajita akayenda kubalume ibabo akati, “Ndimi nhu wamunohaka; ini tjamahhila?”<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />Bakati, “Khoneliyasi unobe ali nlawuli webagwi bengwa, ali nlume wakatambunuka unohla Ndzimu, unolebgwa zwakanaka nekukwe mutjaba tjose tjemaJuta, wakabudziwa nentumwa wakayengemala weNdzimu kuti akudane uhhe kun'umba iye, kudze awhe tjawunowholeba.” <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />Ndizo wakabanginisa kuti babe bezi babe.</para>
  <para style="p" vid="ACT 10:23">Hhuba linotobela wakamuka eyenda nabo, nedzimwe hama dzaka dzili muJopha dzakayenda naye. <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />Hhuba linotobela bakanongina muKhesariya. Khoneliyasi waka akabamilila akoka hama dzidze nebakwinya babe bapedlo. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />Phethiro wakati engina, Khoneliyasi ekawuhanganidza, akabe ewila pasi pamakumbo awe akawunamata. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />Koga Phethiro wakawumilidza eti, “Milika, nami bo ndinhu sawe.” <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />Elebeleka naye, wakangina mun'umba akawana banhu banjinji bakakubungana; <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />akati kubali, “Moziba imwi tjekwenyu kuti akutemunlayo kuti Njhuta ahangane kene iko kuti akumbe nhu wegumwe ludzi; koga Ndzimu wandilakidza kuti ndisitongoti umwe nhu unahambgwa kene haazotjena. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />Ndizo pandakawhodan'wa, ndabuya ndisatongolamba. Ngono ndobhuzwa kuti mandidanilani?”<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />Khoneliyasi wakati, “Mahhuba mana akapinda, mu awa iyeyi, ndaka ndili muntembezelo we awa yebuhhanalume kubvisila bhuda kwehhuba, ndili mun'umba yangu; linga, ndakabona nlume alimile mbeli kwangu akambala zwiyambalo zwinopenya, <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />eti, ‘Khoneliyasi, ntembezelo uwo wawhakala nezwipo zwizo zwaswika mbeli kweNdzimu setjikumbuludzo. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />Tuma banhu bayende kuJopha banokumbila Simoni unoyi Phethiro; unogala mun'umba yaSimoni, nsuki wemakukuta, unogala pawhunde yegungwa.’ <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />Ndizo ndakakutumila banhu nekulibilidza, wathama zwakanaka ukabuya. Ndizo ke tipano tili mubuyapo gweNdzimu, kuti tiwhe kose kwawalayiwa naHe.”<verse eid="ACT 10:33" /></para>
  <para style="s">Phethiro Elebeleka</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />Phethiro wakahhula nlomo uwe akati. “Lebeswa lose ndabona kuti Ndzimu haana luhalawulo, <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />koga mutjimwe netjimwe tjaba kene yani unowunhla kakale eyeta tjakalulama unowuwamutjila. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />Moliziba dama laakatumila kubanhu beIsirayeli, esumikila ndebo mbuya yekunyalala muna Yesu Khirisitu (Kuti ndiHe webanhu bose), <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />dama lakasumikigwa muJudiya yose, kutangisila muGalile hule kwembvubiko yakasumikigwa naJohane. <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />kuti Ndzimu wakahhodza Yesu wekuNazaretha tjini neMeya Yakayengemala nangemasimba; nekuti wakayenda eyeta zwinhu zwakanaka kakale epodza bose baka bakatshambidzigwa nasatane, nentha yekuti Ndzimu waka anaye. <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />Iswi tibasupi bezwinhu zose zwaakayeta muhango yemaJuta nemuJerusalema. Bakawumbulaya ngekuwunlembeledza patjileyanyo; <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />koga Ndzimu wakawumusa muhhuba lebutatu akawulakidza patjena; <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />kusi kubanhu bose, koga kutili taka tahagwa neNdzimu kuti tibe basupi, tikadla tikan'wa naye hule kwemuka kukwe kubafi. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />Kakale wakatilaya kuti tisumikile kubanhu, nekuti tipe busupi kuti iye ndiye wakahhodzewa neNdzimu kuti abe ntongi wemilandu yebapenyu nebakafa. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />Balebesambeli bose banopa busupi nekukwe kuti nhu wose unogalamoyo muwunli unowana kuyetigwa mazwibhatigwa matjinyo ngezina lile.”<verse eid="ACT 10:43" /></para>
  <para style="s">Bataya Banowamutjila Meya Yakayengemala</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />Phethiro wakati etjaleba ikoku, Meya Yakayengemala ikajetukila pehhugwi kwabo bose baka bewha dama. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />Bagalimoyo baka bali bamwe bebakathumbigwa, baka bahha naPhethiro, bakatjenama ngobe tjipo tjeMeya Yakayengemala tjakatjadululigwa pehhugwi kweBataya bo. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />Nekuti bakabawha belebeleka nedzimwe ndimi bekudza Ndzimu. Phethiro akabe eti, <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />“Kuna ungalambisa banhu ibaba kuti balongwe muvula babvubikiwe, ibo bawamutjila Meya Yakayengemala saswi?” <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />Akalaya kuti babvubikiwe muzina laYesu Khirisitu. Bakawunkumbila kuti atongogala kwemahhubanyana.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">Phethiro Ebikila Gubungano lekuJerusalema</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />Bapositoli nehama dzaka dzili kuJudiya bakawha kuti Bataya bo bawamutjila dama leNdzimu. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />Ndizo Phethiro wakati ayenda kuJerusalema, bakathumbigwa bakanyanyayidzana naye, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />beti, “Wandilani kubanhu basakathumbigwa ukanodla nabo?” <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />Koga Phethiro wakakabalondesedzela kose kwakayetikala. <verse eid="ACT 11:4" /><verse number="5" style="v" sid="ACT 11:5" />“Ndaka ndili munzi-nkulu weJopha nditembezela; ndikanga ndinowolota abona tjilakidzilo, kudeluka tjinhu, tjinonga jila gulugulu, lakajetusiwa libva kudzimu nentha dzalo dzili na; likajitila kundili. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />Ndakati ndilingisisa mukati abona mhuka dzemakumbo mana nemhuka dzehango nezwibandana nenyunyi dzemumhepo. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />Ndikawha whi liti kundili, ‘Milika, Phethiro, bulaya udle.’ <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />Koga ndikati, ‘Hayi aa, He; munlomo wangu akunhu kukatongongina tjinhu tjinahambgwa kene tjisakatjena.’ <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />Koga whi lakandihandula gobubili libva kudzimu liti, ‘Usiti tjatjenesewa neNdzimu tjinahambgwa.’ <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />Ikoku kwakayetikala katatu, kose kukaba kubgwiliziwa kudzimu. <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />Lubaka igogo kwakaswika balume batatu pan'umba yataka tiliko, baka batumwa kundili bebva kuKhesariya. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />Meya ikandibudza kuti ndiyende nabo, ndisizeyeze. Bagalimoyo ibaba bali kutanhatu bakayenda nami, tikanongina mun'umba yawhoyu nlume. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />Akatibudza kuti wakabona tjini ntumwa weNdzimu alimile mun'umba iye eti, ‘Tuma banhu kuJopha banobuya naSimoni unoyi Phethiro; <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />unowhokutulila matama awunowhotjidziwa ndiwo, iwe nen'ha uwo wose.’ <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />Pandakatangisa lebeleka, Meya Yakayengemala yakajetukila pehhugwi kwabo sekwayakayeta kutili bo kutanga. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />Ndikakokumbula tjakalebgwa naHe eti, ‘Johane waka ebvubika nevula koga imwi mowhobvubikiwa neMeya Yakayengemala.’ <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />Saku Ndzimu akabapa tjipo itjo zwatjo tjaakatipa iswi bo patakagalamoyo muna He Yesu Khirisitu, imi ndiyani kuti ndidzibise Ndzimu?”<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />Pabakawha ikoku bakanyalala bakati whuu! Bakalumbidza Ndzimu, beti, “Kobva kuti Ndzimu wabvumila Bataya bo kuti bahanduke kudze bawane butjilo.”<verse eid="ACT 11:18" /></para>
  <para style="s">Gubungano leTshipi lekuAntiyoku</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />Sangwenu ibabo baka bapaladziwa ngedziyidziwa kwaSitefani bakatandula bakadzina bakanoswika kuFonishiya nekuSayiphurasi nekuAntiyoku, besumikila dama kumaJuta woga. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />Koga baka balipo bamwe babo, balume bekuSayiphurasi, nebekuKhureni, bakati beswika kuAntiyoku bakalebeleka nemaJuta anolebeleka tjiGiriki bo, besumikila nekwaHe Yesu. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />Luboko gwaHe gwaka guli pehhugwi kwabo, banjinji bakagalamoyo baka handukila kuna He.<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />Ndebo iyeyi yakaswika kuzebe dzegubungano letshipi lekuJerusalema, bakatuma Bhanabhasi kuAntiyoku. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />Wakati aswika akabona ngoni dzeNdzimu, akahanha. akabakuludzila nelinoti babhatilile muna He nemimoyo yakazwipila. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />Bhanabhasi waka ali nlume wakanaka, uhhele Meya Yakayengemala negalamoyo. Banhu banjinji bakagalamoyo kuna He.<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />Ndizo Bhanabhasi wakayenda kuThasasi enohaka Sawuli; <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />Akati awuwana, akabuya naye kuAntiyoku. Kwegole lose baka behangana negubungano letshipi, bediya lukawu gwebanhu; badiyiwa bakatanga dan'wa kuyi MaKhirisitu muAntiyoku.<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />Mumahhuba iyawo kwakabuya balebesambeli kuAntiyoku, bebva kuJerusalema. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />Umwe wabo unoyi Agabhasi wakamilika akalebesambeli ngeMeya kuti kowhobe nebhamba gulu muhango yose; ikoku kwakayetikala mumahhuba ebuhe gwaKilawudiyasi. <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />Badiyiwa bakabvumilana kuti, wose nhu kuyendidzana nekuti unotubula kungapani, atumile bhatsho kuhama dzikuJudiya; <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />bakayeta bejalo, bakatuma Bhanabhasi naSawuli kuti bakuyendise kubawhola.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">Kumwe Dziyidziwa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />Mulubaka igogo mambo Hherodi wakasunga bamwe baka bali begubungano letshipi. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />Wakabulaya Jakobe nkulu waJohane ngebhangatjeke; <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />paakabona kuti kwahanhisa maJuta, wakayendilambeli akasunga Phethiro bo. Ikoku kwakayetikala kuli mahhuba eTjinkwa Tjisina Mbidzo. <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />Wakati awumbhata akawunsa mujele, kwaakalindiwa nemabunga mana elabadzana, limwe nelimwe bunga lili bagwi bengwa bana, etila kuti akowuntonga mbeli kwebanhu hule kwePhasika. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />Ndizo Phethiro wakagadziwa mujele; koga gubungano letshipi lakawuntembezelela tjoselele kuNdzimu.<verse eid="ACT 12:5" /></para>
  <para style="s">Phethiro Unosunungugwa Mujele</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />Busiku igo ntja Hherodi gwaaka ewhomuka ewundhusa, Phethiro waka alilele pakati kwebagwi bengwa babili, akasungwa neketane mbili, balindi baka bali pankoba bakalinda jele. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />Linga, kwakakoboneka ntumwa waHe, kukapenya tjedza mun'umba yejele yose; akazunguza Phethiro nelubabvu ewumusa, eti, “Muka, libilidza.” Ketane dzakawa dzibva pamaboko awe. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />Ntumwa weNdzimu wakati kuwunli, “Mbala zwiyambalo umbale nembhatata dzidzo.” Akathama sayikoko. Akati kuwunli, “Uzwipombele nejila lilo unditobele.” <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />Wakabhuda akawuntobela; waka asingazibe kuti tjayetiwa nentumwa weNdzimu tjaka tjili lebeswa, koga wakakumbula kuti unobona tjilakidzilo. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />Bakati bapinda balindi bekutanga nebebubili bakaswika pankoba wetshipi unongina munzi-nkulu. Wakahhulika woga, bakabhuda bakayenda, bakayenda bakatjuluka zila in'ompela; tjinyolotjo ntumwa weNdzimu akabe ewunsiya.<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />Kwakati Phethiro opedzisisa akati, “Ndatjibona kuti He watuma ntumwa uwe akandisunungula kubva mumaboko aHherodi nemuna kose kwakalingiligwa nemaJuta kuti kowhoyetikala.”<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />Paakaziba kose ikoku wakayenda kun'umba yaMariya, mayi baJohane waka ana limwe zina linoyi Mako, paka pakakubungana banjinji betembezela. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />Wakati ekowhodza pankoba, kwakahha umwe nlandakadzi unoyi Roda ewhodabila. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />Wakati ewha whi laPhethiro, akasihhule nkoba ngentha yehanha, koga akalabuka enoleba kuti Phethiro upankoba. <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />Bakati kuwunli, “Unopenga.” Koga iye wakakowhomesedza kuti kwakajalo. Bakati, “Untumwa uwe!”<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />Koga Phethiro wakayendila mbeli ekowhodza; bakati bahhula, bakawumbona bakatjenama. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />Koga iye akamilidza luboko kuti banyalale, akabalondesedzela kuti He wawundhusa tjini mujele. Wakati, “Ikoku mukubudze Jakobe nebamwe bagalimoyo.” Akabe emilika eyenda kugumwe bugalo.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />Kukati kwayedza, kukamuka hhoba isihoma pakati kwebagwi bengwa kuti kwayetikani kuna Phethiro. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />Hherodi wakati awumvima akawun'haya, akabhuzwisisa balindi akalaya kuti babulawe.</para>
  <para style="p" vid="ACT 12:19">Hherodi akabe emilika kuJudiya eyenda kuKhesariya, akanogala ko kwelubaka nyana.<verse eid="ACT 12:19" /></para>
  <para style="s">Fa kwaHherodi</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />Hherodi waka akagwadziligwa banhu bekuTire nebekuSidoni; ndizo bakayenda kuwunli ngemoyo un'ompela, hule kwekumbilisisa Bhulasitasi, nlume waka ali nlingi wen'umba yebulalo yamambo, kuti ababhatshe, bakakumbila kunyalala, ngentha yekuti hango yabo yaka iwana zodliwa kuhango yamambo.<verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />Pahhuba laka labigwa, Hherodi akambala zwiyambalo zwizwe zwebumambo, wakagala patjigalo tjetonga tjitje, akalebeleka nabo. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />Banhu bakamimila, beti, “Iwhi lendzimwana, haata lenhu!” <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />Tjinyolotjo ntumwa waHe wakawunloba, nekuti waka asakudza Ndzimu; akadliwa newhonyana akafa.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />Koga dama leNdzimu laka yendilambeli li andama likawanda.<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />Bhanabhasi naSawuli bakati bapedza n'hingo wabo bakahanduka bebva kuJerusalema, bakabuya naJohane waka ana limwe zina linoyi Mako.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">Hagwa Netumwa kwaBhanabhasi naSawuli</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />Sangwenu mugubungano letshipi lekuAntiyoku kwaka kuna balebesambeli nebadiyi. Bhanabhasi, naSimiyoni waka eyi Ntema<note caller="+" style="f"><char style="fr" closed="false">13.1 </char><char style="ft" closed="false">angaba waka ana ganda dema</char></note>, naLusiyasi wekuKhureni, naManayeni waka akula naHherodi mbhati wentunhu, naSawuli. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />Bakati batjanamata He kakale beyila zodliwa, Meya Yakayengemala ikati, “Mundihalulileni Bhanabhasi naSawuli kuti bate n'hingo wandakabadanila iwo.”<verse eid="ACT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3" />Kukati hule kwetembezela neyila zodliwa bakababiga maboko bakati bayende zwakanaka.<verse eid="ACT 13:3" /></para>
  <para style="s">KuSayiphurasi</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />Ndizo bakati batumwa ngeMeya Yakayengemala, bakayenda kuSelusiya; bebva ipapo bakayenda kuSayiphurasi. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />Bakati beswika kuSalamisi, bakasumikila dama leNdzimu mumasinagogu emaJuta. Baka bena Johane ali mbhatshi wabo.<verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />Bakati batandula tjigwizi tjose bedzina benoswika kuPhafosi, bakawana umwe Njhuta unoyi Bha-Yesu waka ali n'anga, eli nlebesambeli wemanyepwa, <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />waka ana mbhati wentunhu wetjigwizi itjetjo waka eyi Sajiyasi Phawulasi, waka ana bulubi gwakapiza. Sajiyasi Phawulasi wakadana Bhanabhasi naSawuli kuti awhe bo dama leNdzimu. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />Koga Elimasi (Ngobe nditjo tjaka tjibva zina lile neTjiGiriki) wakabalambisa, ehaka dzibila mbhati wentunhu wetjigwizi mukugalamoyo. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />Koga Sawuli, waka ana limwe zina linoyi Phawuli, alihhele Meya Yakayengemala, wakawunlingisisa, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />akati, “Iwe nkololo waSatane, iwe tjita tjekululama kose, uhhele bupitipiti nebubi, tongoletja tjinya Zila yaHe yakatambunuka. <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />Sangwenu tjilinga, luboko gwaHe gupehhugwi kuko, unowhobe bhofu ukasitubule bona hhuba kwelubaka.”</para>
  <para style="p" vid="ACT 13:11">Tjinyolotjo kwakaswika busi nehhalima pehhugwi kukwe akatangisa haka banhu kuti bawunkakate neluboko. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />Mbhati wentunhu wakagalamoyo paakabona tjaka tjayetikala, ngobe waka atjenamisiwa nediya kwaHe.<verse eid="ACT 13:12" /></para>
  <para style="s">MuAntiyoku muPhisidiya</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />Phawuli nebamwe babe bakamilika bakayenda ngekepe bebva paPhafosi, bakaswika kuPhega muPhamfiliya. Johane akabasiya akabgwilila kuJerusalema; <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />koga bakayendilambeli bebva kuPhega bakaswika kuAntiyoku yekuPhisidiya. Munsi weSabatha bakayenda kusinagogu bakagala pasi. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />Hule kwebagwa kwenlayo newhalo dzebalebesambeli, batungamili besinagogu bakabatumila banhu, beti, “Hama, hapa muna dama lingasimisa banhu, mulilebe.” <verse eid="ACT 13:15" /><verse number="16" style="v" sid="ACT 13:16" />Ndizo Phawuli wakamilika, akamilidza luboko gugwe akati. “Balume beIsirayeli, namwi imwi munohla Ndzimu, whililani. <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />Ndzimu webanhu ibaba bekuIsirayeli wakahalula botate bedu akabata bakaba banhu bakulukulu pabakagala muhango yeIgipita, koga akakobadusa muyili neluboko gunasimba. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />Kwemakole angaba makumi mana wakabayetila moyonlefu mutjilambanyika. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />Wakati apaladza zwitjaba zwili kutondeka muhango yeKhenani, akabapa hango yazo senhaka, kwemakole angaba makhulu mana anamakumi mahanu.”<verse eid="ACT 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 13:20" />“Hule kwayikoku wakabapa batongi kukadza kukanoswika pana Samuyeli nlebesambeli. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />Bakakokumbila mambo; Ndzimu akabapa Sawuli nkololo waKhishi, nlume weludzi gwaBhenjamini, kwemakole makumi mana. <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />Akati atjiwundhusa, akabamilidzila Davida kuti abe mambo wabo; waakapa busupi eti, ‘Ndawuwana Davida nkololo waJese nlume unodikala mumoyo wangu, iye unowhothama kuda kwangu kose.’ <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />Muludzi gwenlume iwhoyu, Ndzimu walesi Ntjidzi kuna Isirayeli, iye Yesu, sekwaaka gadzabgwe. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />Asanhu abuya, Johane wakabe asumikila nekwebvubikiwa kwekuhanduka kubanhu bose beIsirayeli. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />Johane wakati opedza n'hingo uwe, akati, ‘Mokumbula kuti ndimi yani? Andita iye. Koga lingani, hule kwangu kuna unowhobuya, wandisakalizanila sunungula mitjili yehangu dzidze.’ ”<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />“Hama, imwi bana baAbhurahhamu, nayibabo bapakati kwenyu banohla Ndzimu, takatumigwa matama etjidziwa ikoku. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />Ngentha yekuti bagali bemuJerusalema nebatongi abazowunziba kakale abazowhisisa zwakazwilebgwa nebalebesambeli zwaka zwigala zwibagwa mumasabatha ose, bakahhadzisa tjakalebgwa ngewuwana nlandu. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />Bakakumbila Pilatu kuti awumbulaye nekutobe baka basawana nlandu wakalizanila kuti abulawe. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />Bakati bahhadzisa kose kwaka kwalebgwa nekukwe, bakawuntulula patjileyanyo, bakanowumbiganya mukumbu. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />Koga Ndzimu wakawumusa kubafi; <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />kakale akabonakala kwemahhuba manjinji kuna bakabuya naye bebva kuGalile kuswika kuJerusalema, ndibo batjibe basupi babe kubanhu. <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />Ndizo tomubudza ndebo mbuya Ndzimu yaakagadzabgwe botate bedu, <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />ikoku Ndzimu watjikuhhadzisa kutili iswi bana babo ngemusa Yesu; sekwakwaka kwagwa mulukwalo gweNjimbo gwebubili,</para>
  <para style="q1" vid="ACT 13:33">“ ‘Iwe uNkololo wangu,</para>
  <para style="q2" vid="ACT 13:33">nasi ndakuzwala.’<verse eid="ACT 13:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34" />Ndzimu wakawumusa kubafi, kuti asitjabgwilile mukubola, sekwaakaleba nezila inoti,</para>
  <para style="q1" vid="ACT 13:34">‘Ndowhokupa makombolelo akayengemala</para>
  <para style="q2" vid="ACT 13:34">andakagadzabgwe Davida.’<verse eid="ACT 13:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35" />Ndizo eti kakale mugumwe lumbo,</para>
  <para style="q1" vid="ACT 13:35">‘Amutowhobvumila wakayengemala wenyu kuti abole.’<verse eid="ACT 13:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ACT 13:36" />Nekuti Davida wakati ahingila tjizekugwana tjitje sekuda kweNdzimu, akayezela, akanoladzikiwa nabotate babe, akabola; <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />koga iye wakamusiwa neNdzimu haazotongobola. <verse eid="ACT 13:37" /><verse number="38" style="v" sid="ACT 13:38" />Tjikuzibani ke, makamu, kuti ngentha yawhoyu nlume, kosumikigwa kumuli yetigwa mazwibhatigwa matjinyo nesunungugwa muna kose kwaka kusingasunungugwe ngenlayo waMozisi, <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />kakale ngentha iye umwe newumwe unogalamoyo unosunungugwa. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />Tjenjelani, kudze musitongowigwa netjakalebgwa nebalebesambeli.<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />‘Lingani, imwi bakejuli! tjenamani mupalale;</para>
  <para style="q1" vid="ACT 13:41">nekuti ndowhothama tjiyeto mumahhuba enyu,</para>
  <para style="q2" vid="ACT 13:41">tjiyeto tjamusingowhogalamoyo,</para>
  <para style="q2" vid="ACT 13:41">nekutobe tjikalebgwa kumuli.’ ”<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />Bakati bobhuda, banhu bakakumbila kuti zwinhu izwezwi zwilebgwe kakale musabatha linotobela. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />Kwakati n'hangano wemusinagogu wapela, maJuta nebamwe banhu baka bakahandukila kulunamato gweTjiJuta bakatobela Phawuli naBhanabhasi. Phawuli naBhanabhasi bakabakuludzila kuti bayendilembeli bali mungoni dzeNdzimu.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />Nsi wesabatha wakatobela kwakagulo kubungana banhu bose benzi-nkulu kuti bawhowha dama laHe. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />Koga maJuta akati ebona lukawu gwebanhu, akaba nefupa, akaleyana nezwaka zwalebgwa naPhawuli, akawuntuka. <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />Phawuli naBhanabhasi bakalebeleka netjilopa beti, “Kwakwakafanila kuti dama leNdzimu lilebgwe kumuli kutanga. Koga saku mulilamba, muzwiwana musakafanila butjilo gusingapele, lingani, iswi toyehandukila kuBataya. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />Nekuti, He watilaya ejalo,</para>
  <para style="q1" vid="ACT 13:47">“ ‘Ndokusa kuti ube tjedza kuBataya,</para>
  <para style="q2" vid="ACT 13:47">kuti uhhise tjidziwa kubupelo gwehango.’ ”<verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />Bataya bakati bekuwha ikoku, bakahanha kakale bakakudza dama laHe; nayibabo bose bakahaligwa butjilo gusingapele bakagalamoyo.<verse eid="ACT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49" />Dama laHe lakaandama muntunhu wose. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />Koga maJuta akadzonga bafumakadzi bakazwipila banonamata baka bezibgwa kose nebalume baka bali batungamili munzi-nkulu, bakata kuti Phawuli naBhanabhasi badziyidziwe, bakabatata muntunhu wabo. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />Koga bakapula whuluba ipamakumbo abo, bakayenda kuIkhoniyamu. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />Badiyiwa bakahhala nekuhanha neMeya Yakayengemala.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">Bali muIkhoniyamu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />Bakati baswika kuIkhoniyamu bakangina musinagogu yemaJuta, bakalebeleka nezila yekuti bunji gwemaJuta nemaGiriki bakagalamoyo. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />Koga maJuta asingagalemoyo akadzonga Bataya bakabalonga meya dzakayipa kuti baheme bagalimoyo. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />Ndizo bakagala kwelubaka gulefulefu, belebeleka ngetjilopa nekwaHe, iyebo akapa busupi gwedama lile lengoni, nezwilakidzilo nange makaabadzo kwaka kuyetiwa ngemaboko abo. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />Koga banhu bemunzi-nkulu iwhoyo bakathubukana pakati; bamwe bakama nemaJuta, bamwe bakama nebapositoli.<verse eid="ACT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5" />Kwakati Bataya nemaJuta, kan'ompela nebatongi babo, bohaka kuti babadziyidze kakale babakhikitidze ngemabgwe, <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />bakakuwha bakatihhila kumizi-mikulu yekuLikhoniya inoyi Lisitira neDebhi, nekumitunhu ipedlo; <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />bakati beswikako bakasumikila Ndebo Mbuya.<verse eid="ACT 14:7" /></para>
  <para style="s">MuLisitira nekuDebhi</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />MuLisitira kwaka kuna umwe nlume waka aligele, asingatubule hingisa makumbo awe; waka ali tjilema kubvisila mukuzwagwa kukwe, esanhu akatongoyenda. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />Wakawhilila Phawuli elebeleka; naPhawuli, akawunlingisisa akati ebona kuti unogalamoyo kuti angapodzewa, <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />akaleba newhi lipehhugwi eti, “Milika ume nemakumbo awo.” Akabe emilika eyenda. <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />Banhu bakati bebona tjayetiwa naPhawuli, bakamilidza mawhi abo neTjiLikhoniya beti, “Midzimwana yabuya kutili inga banhu!” <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />Bakati Bhanabhasi ndiZewusi, nentha yekuti Phawuli waka ali iye nlebeleki nkulu bakawunti ndiHhemesi. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />Mphirisiti waZewusi, waka ana thempeli limbeli kwenzi-nkulu, wakabuya nemikono nendalama kunkoba wenzi ehaka kuti awhopila tjibhayilo kan'ompela nebamwe.<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />Koga bapositoli, Bhanabhasi naPhawuli bakati bekuwha, bakapalula zwiyambalo zwabo bakalabuka bengina pakati kwembunga webanhu, bemimila beti, <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />“Balume mokuyetilani ikoku? Iswi tibanhu bo, totjila samwi, tamuhhisila ndebo mbuya, kuti musiyane nezwinhu zwisina n'hingo izwezwi muhhe kuNdzimu wakabumba kudzimu nehango negungwa nayiko kose kumukati. <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />Mulubaka gwakapinda wakabvumila njudzi dzose kuti dziyende nezila dzadzo; <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />koga wakasiya kuna busupi, nekuti wakayeta zwakanaka akamupa vula inobva kudzimu nemitjelo muzwibaka zwakatambunuka, akagutsha mimoyo yenyu nezodliwa nehanha.” <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />Kene nematama iyawa, kwakabalemela kuti badze batubule misa banhu kuti basibabhayile tjibhayilo.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />Koga maJuta akabuya ebva kuAntiyoku nekuIkhoniyamu; akati atjithama banhu bakabvumilana nawo, akakhikitidza Phawuli ngemabgwe akawunkakatila kuhhe kwenzi-nkulu, ekumbula kuti watjifa. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />Koga badiyiwa bakati bawunkombeledza, akamuka akangina munzi-nkulu; kukati tjimuka akayenda naBhanabhasi kuDebhi.<verse eid="ACT 14:20" /></para>
  <para style="s">Bgwilila kwabo kuAntiyoku ikuSiriya</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />Bakati basumikila ndebo mbuya munzi-nkulu iwhoyo banhu banjinji bakahanduka bakaba badiyiwa, bakakobgwilila kuLisitira nekuIkhoniyamu, nekuAntiyoku, <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />besimisa meya dzebadiyiwa, bebakuludzila kuti bayendilembeli bali mukugalamoyo, beti, “Takafanila dziyidzika kwazo kudze tingine mubumambo gweNdzimu.” <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />Bakati bahala bawhola bakabapa zwigalo mulimwe nelimwe gubungano letshipi, netembezela neyila zodliwa, bakabasa kuna He wabaka begalamoyo.<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />Bakakopinda nepaPhisidiya bakaswika kuPhamfiliya. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />Bakati basumikila dama muPhega, bakajetukila kuAthaliya; <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />bebva ipapo bakatanha kepe bakayenda kuAntiyoku, kwabaka basiwa mungoni dzeNdzimu ngentha yen'hingo wabaka bahhadzisa.<verse eid="ACT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27" />Bakati baswika bakakubunganya gubungano letshipi panhu pan'ompela bakaleba kose kwakayetiwa neNdzimu ebahingisa, nekuti waka ahhulila Bataya nkoba wegalamoyo. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />Bakagala kwelubaka gulefulefu nebadiyiwa.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">N'hangano wekuJerusalema</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />Koga kwakaswika bamwe balume bebva kuJudiya bediya bagalimoyo kuti, “Hapa musakathumbigwa kuyendidzana nenlayo waMozisi, amungatjidziwe.” <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />Phawuli naBhanabhasi baka kakabadzana nabo kwazo, kukamuka hhoba. Phawuli naBhanabhasi nebamwe bakahagwa kuti bayende kuJerusalema benobona bapositoli nebawhola nekwembhuzo iwhoyu.<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />Ndizo, bakati belimuzila batumwa negubungano letshipi, bakapinda nemuFonishiya nemuSamariya, beyenda bebabudza nekwehandugwa kweBataya, bakalonga kuhanha kukulukulu mubagalimoyo bose. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />Bakati beswika kuJerusalema, bakawamutjigwa nengubungano letshipi nebapositoli nebawhola, bakababudza kose kwaka kwayetiwa neNdzimu ebahingisa. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />Koga kwakamilika bamwe baka bali belubabi gweBafarisi, baka batjiba bagalimoyo, bakati, “Kwakafanila kuti bathumbigwe, kakale balayiwe kuti batjengete nlayo waMozisi.”<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />Bapositoli nebawhola bakakubungana kuti balingisise ndebo iyeyi. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />Hule kwekuti kwakakabadzaniwa kwazo, Phethiro wakamilika akati kubali, “Hama, moziba kuti mumahhuba ekutanga Ndzimu wakahala pakati kwenyu, kuti ahingise nlomo wangu kuti Bataya bawhe dama lendebo mbuya bagalemoyo. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />Ndzimu unobe ali iye unoziba mimoyo yebanhu wakabapa busupi, ngekubapa Meya Yakayengemala sekwaakayeta kutili; <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />haazotongosiyanisa pakati kwedu nabo, koga wakatjenesa mimoyo yabo ngekugalamoyo. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />Sangwenu imwi molikilani Ndzimu ngetilika jogwe pamitshibha yebadiyiwa, latisakatongotubula senga iswi kene botate bedu? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />Koga togalamoyo kuti towhotjidziwa ngengoni dzaYesu He, sayibo bo.”<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />Gubungano lose lakanyalala; bakawhilila Bhanabhasi naPhawuli belondesedza zwilakidzilo nemakaabadzo akayetiwa neNdzimu pakati kweBataya ehingisa ibo. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />Bakati bapedza lebeleka, Jakobe akahandula eti, “Makamu, whililani kundili. <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />Simiyoni wamulondesedzela kuti Ndzimu wakakumba tjini Bataya kwekutanga, kuti kubva mubali azwiyetile banhu banodan'wa ngezina lile. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />Matama ebalebesambeli anobvumilana nayikoko, sekwakwaka kwagwa kuti,<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />“ ‘Hule kwayikoku ndowhohanduka,</para>
  <para style="q2" vid="ACT 15:16">ndikamusidzila bugalo gwaDavida, gunoba gwatjiwa,</para>
  <para style="q1" vid="ACT 15:16">ndowhomusidzila matongo ago kakale,</para>
  <para style="q2" vid="ACT 15:16">ndikagumusa,<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />kuti bamwe banhu bose bahake He,</para>
  <para style="q2" vid="ACT 15:17">neBataya bose banodan'wa nezina langu,<verse eid="ACT 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18" />kujalo He, wakanoyeta zwinhu zose izwezwi zwinozibgwa kubvisila ntolo.’<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />“Ndizo imi sebona kwangu ndoti tisidziyidze Bataya banobe bahandukila kuNdzimu, <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />koga tibakwalile kuti basiyane nezwinhu zwisakalulama zwakapigwa kumidzimwana, nebupombgwe, nedla nyama yetjafa ngosiniwa<note caller="+" style="f"><char style="fr" closed="false">15.20 </char><char style="ft" closed="false">ngedzipiwa pawhulo</char></note>, nedla malopa. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />Nekuti kubvisila kuzwizekugwana zwantolo kwakasumikigwa nekwaMozisi mumizi-mikulu yose, nekuti whalo dzidze dzobagwa masabatha ose mumasinagogu.”<verse eid="ACT 15:21" /></para>
  <para style="s">Lukwalo Gwakakwaligwa Bataya Banogalamoyo</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />Kukabonakala kuli tjinhu tjakanaka kubapositoli nebawhola, nekugubungano letshipi lose, kuti bahale banhu pakati kwabo bayende kuAntiyoku naPhawuli naBhanabhasi. Bakatuma Judasi unoyi Bhasabhasi, naSilasi, baka bali batungamili kubagalimoyo. <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />Bakasenga lukwalo gunoti.</para>
  <para style="pi" vid="ACT 15:23">“Makamu, bapositoli nebawhola, kubagalimoyo beBataya bakuAntiyoku nekuSiriya, nekuSilisiya, tomubuyisa. <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />Saku tawha kuti bamwe banhu banobva pakati kwedu bakamudziyidza nematama, bedzonga mikumbulo yenyu, nekutobe taka tisabatuma, <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />kwaboneka kwakatambunuka kutili, hule kwekuti tabvumilana, kuti tihale balume tibatume kumuli bena badikani bedu Bhanabhasi naPhawuli, <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />balume bakapila butjilo gwabo ngentha yezina laHe wedu Yesu Khirisitu. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />Ndizo tatuma Judasi naSilasi, banowhoswika bemubudza zwinhu izwezwi ngemilomo yabo. <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />Nekuti kwaboneka kuli tjinhu tjakanaka kuMeya Yakayengemala nekutili kuti tisimusile gumwe bulemo gunopinda zwinhu izwezwi zwakafanila. <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />kuti muzwidzibe muna zwabhayigwa midzimwana, nemalopa, netjafa ngosiniwa<note caller="+" style="f"><char style="fr" closed="false">15.29 </char><char style="ft" closed="false">ngedzipiwa pawhulo</char></note>, nebupombgwe. Mukazwidziba muzwinhu izwezwi mowhobe mata zwakanaka. Musale.”<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />Ndizo bakatumwa bakayenda kuAntiyoku; bakati bakubunganya gubungano letshipi panhu pan'ompela, bakabapa lukwalo. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />Bakati batjigubala, bakahanha kakale bakasimisiwa. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />Judasi naSilasi baka bali balebesambeli tjekwabo, bakalebeleka nehama bakadzisimisa ngematama manjinji. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />Hule kwekuti bagala lubaka, bakapelekedzewa nebagalimoyo bakabgwilila kuna baka babatuma nekunyalala. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />(Koga kwakahanhisa Silasi kuti abve asalazwe ipapo.)<verse eid="ACT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 15:35" />Koga Phawuli naBhanabhasi bakasala kuAntiyoku, bediya kakale besumikila dama laHe, nebamwe bo banjinji.<verse eid="ACT 15:35" /></para>
  <para style="s">Phawuli naBhanabhasi Banopalalana</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />Hule kwemahhubanyana Phawuli wakati kuna Bhanabhasi, “Ayibgwilile tinokumba bagalimoyo bakumizi-mikulu yose yatakasumikila dama laHe, tibone kuti batjini.” <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />Koga Bhanabhasi waka ehaka kuti bayende naJohane unoyi Mako. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />Koga Phawuli wakawana kusakatambunuka kuti bayende nenhu wakabgwilila hule bali kuPhamfiliya, akasiyende nabo kun'hingo. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />Bakatangisa kakabadzana zwinogwadza, bakabva bapalalana; Bhanabhasi akatola Mako bakatanha kepe beyenda kuSayiphurasi, <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />koga Phawuli wakahala Silasi bakayenda, hule kwekuti basiwa mungoni dzaHe ngebagalimoyo. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />Akapinda nemuSiriya neSilisiya, esimisa makubungano.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">Thimothi Unoyenda naPhawuli naSilasi</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />Wakaswika kose nekuDebhi nekuLisitira. Kwaka kuna umwe ndhiyiwa waka ali ipapo, waka eyi Thimothi, meyabe baka bali Njhuta, beli nghalimoyo; koga tatayi baka bali Nghiriki. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />Bagalimoyo bekuLisitira nekuIkhoniyamu baka beleba zwakanaka nekukwe. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />Phawuli waka ehaka kuti Thimothi awumpelekedze; akawuntola akawuthumbila eyetila maJuta aka ali mumitunhu iyeyo, ngobe ose aka eziba kuti tate babe uNghiriki. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />Baka beti hapa bepinda mumizi-mikulu, bebazibisa tjaka tjabvumigwaniwa nebapositoli nebawhola baka bali kuJerusalema. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />Ndizo makubungano etshipi akasimisiwa mukugalamoyo, kakale akawanda mahhuba ose.<verse eid="ACT 16:5" /></para>
  <para style="s">MuThirowasi. Tjilakidzo tjaPhawuli</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />Bakapalama muntunhu wePhurayijiya neGalathiya, kuli kuti balambisiwa neMeya Yakayengemala kuti basumikile dama muAsiya. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />Bakati baswika pakalingisana neMayisiya, bakayedza kuti bayende kuBhithiniya, koga Meya yaYesu ayizobabvumila; <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />ndizo bakati bapinda Mayisiya, bakajitila kuThirowasi. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />Phawuli akabona tjilakidzo busiku. ebona nlume wekuMakhedoniya alimile ewunkumbila eti, “Yambukilani ngeno kuMakhedoniya mutibhatshe.” <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />Hule kwebona tjilakidzilo, tjinyolotjo takazwilulamisila yenda kuMakhedoniya, tikutola sekuti Ndzimu watidana kuti tinosumikila ndebo mbuya kubali.<verse eid="ACT 16:10" /></para>
  <para style="s">KuFilipi. Handugwa kwaLidiya</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />Takati timilika paThirowasi tikayenda nekepe takalinga kuSamothiresi, hhuba linotobela tikayenda kuNeyapholisi, <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />timilikapo tikayenda kuFiliphi, unobe uli nzi-nkulu wekutanga muntunhu weMakhedoniya, uli pasi kwebutungamili gweRoma. Takagala munzi-nkulu iwhoyo kwemahhuba; <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />nsi weSabatha takayenda kuhhe kwenzi pawhunde yegwizi, kwataka tikumbulila kuti kungabe nebugalo gwetembezela; tikagala pasi kuti tilebeleke nebafumakadzi baka bakubungana panhu pan'ompela. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />Umwe webaka bakatiwhilila umfumakadzi waka eyi Lidiya, waka ebva kunzi-nkulu weThiyathira, waka etengesa matjila ana mbala n'haba, waka enamata Ndzimu. He wakahhula moyo uwe kuti awhilile tjaka tjilebgwa naPhawuli. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />Wakati abvubikiwa iye nen'ha uwe wose, akatikumbila eti, “Hapa mandibona ndili nhu unogalamoyo kunaHe, ihhani muwhogala kun'umba yangu.” Akatikulila ngematama.<verse eid="ACT 16:15" /></para>
  <para style="s">Mujele kuFiliphi</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />Tikati toyenda kubugalo kunotembezelegwa, tikahanganidziwa nensikana unlandakadzi unameya yekandila waka ehhisila bobatezi babe mari njinji ngekandila kukwe. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />Wakatobela Phawuli naswi tose edanilila eti, “Balume ibaba balanda beNdzimu Upehhugwihhugwi, banomubudza zila yetjidziwa.” <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />Wakakuthama kwemahhuba manjinji. Kudzina Phawuli emon'wa, wakahanduka akati kumeya iyeyo, “Ndokulaya muzina laYesu Khirisitu kuti ubhude muwunli.” Ikabhuda tjinyolotjo. <verse eid="ACT 16:18" /><verse number="19" style="v" sid="ACT 16:19" />Koga bobatezi babe bakati bebona kuti tjababegalabgwe kuti tjowhobapa mari tjayenda, bakabhata Phawuli naSilasi bakabahhuhhutila panotengesegwa bakabasa mbeli kwebutungamili; <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />bakati babahhisa kubatongi bemilandu bakati, “Balume ibaba maJuta, kakale banoporonganya nzi-nkulu wedu. <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />Banodiya milenje isimunlayo kuti iswi tili maRoma tiyibvume kene tiyitobele.” <verse eid="ACT 16:21" /><verse number="22" style="v" sid="ACT 16:22" />Mbunga wakanginilila bo ukagwisa Phawuli naSilasi.</para>
  <para style="p" vid="ACT 16:22">Batongi bemilandu bakapalula zwiyambalo zwabo bakati basukutigwe. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />Bakati babaloba kwazo, bakabaposela mujele, belaya nlindi wejele kuti abatjengete. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />Wakati alayiwa, akabasa mujele lamukatikati akabasungilila makumbo pamhanda.<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />Koga pakati kwebusiku Phawuli naSilasi baka betembezela bemba njimbo dzeNdzimu, basungwa baka bakabawhilila, <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />tjinyolotjo kwakabe nekutengenyeka kwehango, mbviwa dzejele dzikazunguzika; tjinyolotjo mikoba yejele ikahhuka, nketane dzaka dzakasunga banhu dzikasununguka dzose. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />Nlindi wejele paakamuka, wakabona mikoba yejele yakahhuka, akahomola bhangatjeke kuti azwibulaye nalo, ekumbula kuti basungwa batihha. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />Koga Phawuli wakamimila newhi gulugulu eti, “Usizwikubadze, tiyapo tose.”<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />Wakakumbila zwivoneko akalabuka engina mukati, etetema neluhlo akawila mbeli kwaPhawuli naSilasi, <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />akabadusila kuhhe akati, “Balume, ndithameni kudze nditjidziwe?”<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />Ibo bakati, “Galamoyo muna He Yesu, nowhotjidziwa, iwe nen'ha uwo wose.” <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />Bakasumikila dama laHe kuwunli nekubanhu bose baka bali mun'umba iye. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />Wakabatola lubaka gwebusiku igogo, akabangudza mabanga abo, akabva abvubikiwa tjinyolotjo, kose nen'ha uwe wose. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />Akakotjiyenda nabo kun'umba iye, akabapa zodliwa; wakahanha kwazo ngobe waka atjigalamoyo kuNdzimu, iye nen'ha uwe wose.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />Kwakati kwayedza, batongi bemilandu bakatuma mapholisa, beti, “Mubaletje bayende.”<verse eid="ACT 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 16:36" />Nlindi wejele wakaleba matama iyawo kuna Phawuli, eti, “Batongi bemilandu bati muletjewe muyende; ndizo sangwenu tjibhudani muyende nekunyalala.”<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />Koga Phawuli wakati kubali, “Batiloba mbeli kwebanhu, tisina landu, iswi tili bazwagwa bemuRoma, bakatiposela mujele, ngono ngwenu boyehaka kuti batiduse nezila yakasumbikika? Ayi! Ngababuye ibo bawhotidusa.”<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />Mapholisa akabudza batongi bemilandu matama iyawa, bakahla bose pabakawha kuti baka bali bazwagwa bemuRoma. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />Ndizo bakabuya bewhokumbila mazwibhatigwa kubali. Bakabadusa bakabakumbila kuti babhude munzi-nkulu. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />Bakabhuda mujele, bakakumba Lidiya; bakati babona bagalimoyo, bakabasimisa bakamilika boyenda.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">MuThesalonika</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />Sangwenu bakati bapinda nemuAmfipholisi neApoloniya, bakaswika kuThesalonika, paka pena sinagogu yemaJuta. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />Phawuli wakangina sekwaaka agala ethama, akakakabadzana nabo nekwedziwhalo kweMasabatha matatu, <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />ebatjenesela kuti kwaka kwakafanila kuti Khirisitu adziyile nekuti amuke kubafi, eti, “Yesu wandinosumikila kumuli, ndiye Khirisitu.” <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />Bamwe babo bakagalamoyo, bakahanduka bakabhatana naPhawuli naSilasi; sekwakayetiwa nebamwe bemaGiriki bakazwipila namata nebafumakadzi banjinji banabugalo gupehhugwi.<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />Koga amwe maJuta akaba nefupa, akatola bamwe bebanhu banamimoyo yakayipa, bakakubunganya mbunga webanhu, bakatangisa bhonyongo munzi-nkulu, bakanonginilila n'umba yaJayisoni, behaka kuti babadusile kuhhe kubanhu. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />Bakati babahaya, bakakakatila Jayisoni nebamwe bagalimoyo mbeli kwebatungamili benzi-nkulu, beyenda bemimila beti, “Balume ibaba baka poronganya hango yose batjibuya pano bo, <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />ngono Jayisoni waba wamutjila; kakale banothama zwinhu zwisingayendidzane nemilayo yaKhesari, beti kuna umwe mambo unoyi Yesu.” <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />Banhu bose nebatungamili benzi-nkulu bakamon'wa pabakakuwha ikoku. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />Bakati batjilipisa Jayisoni nebamwe, bakabaletja bakayenda.<verse eid="ACT 17:9" /></para>
  <para style="s">KuBheriya</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />Bagalimoyo bakatjimbidza bakayendesa Phawuli naSilasi busiku kuBheriya, bakati beswika bakangina musinagogu yemaJuta. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />Koga maJuta iyawa abaka ana bunhu kupinda ekuThesalonika, ngobe aka amutjila dama nekuzwipila, eholesesa dziwhalo mahhuba ose kudze abone kuti tjoselele zwinhu izwezo zwakajalo. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />Bunji gwabo bakagalamoyo, nebetjikadzi beTjiGiriki banjinji bana bugalo gupehhugwi nebetjilume bo. <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />Koga maJuta ekuThesalonika akati awha kuti Phawuli wasumikila dama leNdzimu kuBheriya bo, akabuya bo ewhobudzila banhu ntome emusa bhonyongo. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />Nekulibilidza bagalimoyo bakayendisa Phawuli kugungwa, koga Silasi naThimothi bakasala ipapo. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />Balume bakabepelekedza Phawuli bakayenda naye bakadza bakanoswika kuAthenisi; wakati atjibalayila kuna Silasi naThimothi kuti babuye kuwunli nekulibilidza, bakabva bahanduka.<verse eid="ACT 17:15" /></para>
  <para style="s">KuAthenisi</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />Phawuli waka akabamilila kuAthenisi, wakadziyidzika mumeya paakabona kuti nzi-nkulu wose waka ulihhele midzimwana. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />Ndizo wakakakabadzana nemaJuta nebanhu bakazwipila namata musinagogu, nemubugalo gunotengesegwa nebanhu bose baka bali ipapo mahhuba ose. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />Wakahangana bo nebazibi banoyi maSitoyiki nebekuEpikuriya. Bamwe bakati, “Iwhoyu nteketi unolebani?”</para>
  <para style="p" vid="ACT 17:18">Bamwe bakati, “Unonga nsumikili wemeyambi dzebanhu bakulekule.” Ngobe waka esumikila nekwaYesu nemuka kubafi. <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />Bakawumbhata, bakawuhhisa kuna Ariyopagasi, beti, “Tohaka ziba kuti ini ikoku diya kutshwa kwawunoleba? <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />Ngobe unoleba zwinhu zwatisakatongowha nezebe dzedu; tohaka ziba ke kuti zwinhu izwezwi zolebani.” <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />Sangwenu banhu bekuAthenisi nebahhi baka begala imhomo baka beda pedza lubaka gwabo gose kusina tjimwe tjinhu tjabanothama kuhhe kweleba kene wha tjinhu tjitshwa.<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />Phawuli wakamilika akama pakati kweAriyopagasi, akati, “Imwi balume beAthenisi, ndobona kuti ngezila dzose mubanamati kwazo. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />Ngobe ndati ndipinda ndikalingisisa zwinhu zwamunonamata, ndikawana kuna tjibeso tjakakwagwa kuti, ‘Kundzimu usingazibgwe.’ Itjetjo tjamunonamata musingatjizibe, nditjo tjandinoleba nekwatjo mbeli kwenyu. <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />Ndzimu iye wakathama hango nezwinhu zose zwimukati, iye ali He wekudzimu nehango, haatogala mumathempeli akayetiwa nebanhu, <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />kakale haatohingigwa ngemaboko ebanhu, sekunoyi kuna tjaanotayila, sangwenu kuli iye unopa banhu bose butjilo, nemeya yabanofema, nezwinhu zose. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />Kubva munhu un'ompela, wakayeta njudzi dzose dzebanhu, kuti bagale muhango yose, kuli kuti wabamisila zwibaka zwabo, nemiganhu yekwabanogala, <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />kuyetila kuti bahake Ndzimu, kuti swiyo banga aambamba bakawuwana. Iye haate kulekule naswi, <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />nekuti</para>
  <para style="q1" vid="ACT 17:28">“ ‘Muwunli ndimo matinotjila neyenda kose newana mamo edu.’</para>
  <para style="m" vid="ACT 17:28">Sekwakalebgwa nebamwe batetembeli benyu beti,</para>
  <para style="q1" vid="ACT 17:28">‘Nekuti iswi tibe tshinde lile.’<verse eid="ACT 17:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="ACT 17:29" />Saku tili tshinde leNdzimu, atizofanila kumbula kuti Ndzimu nebukulu gugwe unonga zeezi, kene siliva, kene bgwe, tjifananidzo tjemihingo yekumbula kwebanhu. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />Ndzimu azotongoba nehanya nelubaka gwesazibgwa kukwe; koga ngwenu welaya banhu bose pose pose kuti bahanduke. <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />Nekuti wakabiga hhuba, laanowhotonga hango yose ngendulamo, ehingisa nlume waakahala; wakapa banhu bose busupi ngekwayikoku ngewumusa kubafi.”<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />Bakati bewha nekwemuka kubafi, bamwe babo bakakejula; koga bamwe bakati, “Tohaka kuwha kakale uleba nekwendebo iyeyi.” <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />Ndizo Phawuli wakabva pakati kwabo. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />Koga bamwe balume bakabhatana naye bakagalamoyo, pakati kwabo kwaka kuna Diyonisiyasi ali umwe welubahhe gweAriyopagasi, nemfumakadzi unoyi Damarisi, nebamwe babaka banabo.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">MuKhorinte</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />Hule kwayikoku wakamilika paAthenisi, akayenda kuKhorinte. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />Ikweno wakawana umwe Njhuta waka eyi Akhwila, ali nghali wekuPhontasi, etjambobva kuIthali nemfumakadzi uwe unoyi Phurisila, ngobe Kilawudiyasi waka alaya kuti MaJuta ose afuluke muRoma. Ndizo wakayenda akanobabona; <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />wakagala nabo, bakahinga bose, nekuti waka ehinga n'hingo iwo zwawo bo; ngobe bose n'hingo wabo waka uli wethama matente. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />Waka ezuwisana nabo musinagogu masabatha ose, eyedza gadzamoyo maJuta nemaGiriki.<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />Pakabuya Silasi naThimothi bebva kuMakhedoniya, Phawuli wakazwipila sumikila, epa busupi kumaJuta kuti Yesu ndiye Khirisitu. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />Bakati bonyanyayidzana naye, bewuntuka, akahahamula zwiyambalo zwizwe, akati kubali, “Lopa lenyu ngalibe pehhugwi kwenyu<note caller="+" style="f"><char style="fr" closed="false">18.6 </char><char style="fq" closed="false">Lopa lenyu ngalibe pehhugwi kwenyu </char><char style="ft" closed="false">kobva kuti Mazwikokela lufu</char></note>! imi andina nlandu. Kubvisila ngwenu ndowhoyenda kuBataya.” <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />Akamilika po, akayenda kun'umba yewumwe nlume unoyi Thayithasi Jasitasi, waka enamata Ndzimu, n'umba iye yaka ili ntome kwesinagogu. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />Khirisipasi, ntungamili wesinagogu, waka galamoyo muna He, nen'ha uwe wose; neBaKhorinte banjinji bakati bewha ndebo mbuya bakagalamoyo bakabvubikiwa.<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />Mutjilakidzo gumwe busiku, He wakati kuna Phawuli, “Usihle, koga lebeleka, usinyalale; <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />ngobe ndinawe, akuna nhu unowhokugwisa akakukubadza; ngobe ndina banhu banjinji munzi-nkulu iwhoyu.” <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />Akagalapo kwegole lina mimwedzi ili mitanhatu, ediya dama leNdzimu pakati kwabo.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />Koga Galiyo paakaba mbhati wentunhu weAkhayiya, maJuta akabhatana akagwisa Phawuli, akawuhhisa palubahhe, <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />eti, “Nlume iwhoyu unokwebela banhu kuti banamate Ndzimu nezila inopesana nenlayo.”<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />Koga kwakati Phawuli obva ehhula nlomo uwe, Galiyo akati kumaJuta, “Yeyi imwi maJuta, hapa kwakuli kuti indebo yetjisakatambunuka kene tjibi tjayetiwa, ndabe ndiwhomuwhilila; <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />koga saku kuli ndebo yenyanyayidzana nekwematama nemazina nenlayo wenyu, muzwibonele tjekwenyu; imi ndolamba bantongi wezwinhu zwakajali.” <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />Akabatata palubahhe. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />Ose maJuta akabhata Sositheni, ntungamili wesinagogu, akawunloba mbeli kwelubahhe. Koga Galiyo asongoba nehanya nako ikoku.<verse eid="ACT 18:17" /></para>
  <para style="s">Bgwilila kuAntiyoku</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />Hule kwayikoku Phawuli wakagala mahhuba manjinji, akakotjibva pabagalimoyo, akayenda ngekepe kuSiriya, wakayenda naPhurisila naAkhwila. Wakakukubula n'holo uwe atjipaSenkhiriya, ngobe waka atuna. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />Bakaswika kuEfesu, iye akabasiya po. Wakangina musinagogu, akakakabadzana nemaJuta. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />Bakati bewunkumbila kuti agale kwelubaka gulefu, akalamba. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />Koga wakati ebasiya, akati, “Ndowhohanduka kakale kumuli hapa Ndzimu eda.” Akabva paEfesu ngekepe.<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />Wakati aswika paKhesariya, akangina akalezwa gubungano letshipi, akakoyenda kuAntiyoku. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />Wakati agala lubaka ipapo, akamilika, akatandula muntunhu weGalathiya newePhurayijiya, eyenda engina mumizi nemizi esimisa badiyiwa bose.<verse eid="ACT 18:23" /></para>
  <para style="s">Apholosi ali kuEfesu nekuKhorinte</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />Kwaka kuna umwe Njhuta unoyi Apholosi, wakabuya kuEfesu. Waka ali nzwagwa wekuAlekizandha, ali nhu wakazwidiya; waka eziba whalo kwazo. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />Nlume iwhoyu waka adiyiwa muzila dzaHe; ngekuzwipila mumeya, wakalebeleka kakale akadiya tjakatambunuka nekwaYesu, nekutobe waka eziba bvubika kwaJohane koga. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />Wakatangisa lebeleka enatjilopa musinagogu; koga Phurisila naAkhwila bakati bawuwha, bakawuntola bakayenda naye, bakawuntjenesela zila yeNdzimu zwibuyanana. <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />Wakati akumbula kuti apindile kuAkhayiya, bagalimoyo bakawunkuludzila, bakakwalila badiyiwa kuti bawuwamutjile. Wakati aswika, akabhatsha kwazo banhu baka bagalamoyo kuli ngengoni, <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />ngobe ngekakabadzana kwakasima, wakakunda maJuta patjena pakati kwebanhu, elakidza ngewhalo kuti Yesu ndiye Khirisitu.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">Phawuli ali mu Efesu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />Kwakayetikala kuti mulubaka Apholosi ali muKhorinte, Phawuli wakapalama mukati kwentunhu upehhugwi enojitila muEfesu, akahangana nebamwe badiyiwa. <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />Eba eti kubali, “Maka amutjila Meya Yakayengemala pamaka galamoyo?”</para>
  <para style="p" vid="ACT 19:2">Bakahandula beti, “Aa, atizotongogala tawha kuti kuna Meya Yakayengemala.”<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />Eba eti kubali, “Ngono makabvubikiwa kwakatini?”</para>
  <para style="p" vid="ACT 19:3">Bakahandula beti, “Bvubika kwaJohane.”<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />Phawuli eba eti, “Johane waka ebvubika mbvubiko wehanduka, ebudza banhu kuti bagalemoyo muna iye unowhohha hule kukwe, kuli iye, Yesu.”<verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />Bakati bakuwha ikoku bakabvubikiwa muzina laHe Yesu. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />Phawuli akati ababiga maboko, Meya Yakayengemala ikajitila pehhugwi kwabo; bakatangisa lebeleka nendimi kakale baka lebesambeli. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />Bose baka bangaswika gumi nebabili.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />Waka engina musinagogu elebeleka asingahle, kwemimwedzi mitatu, ekakabadzana nabo kakale ebakumbilisisa kuti bawamutjile zwaanoleba nekwebumambo gweNdzimu. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />Koga kwakati bamwe bewomesa mimoyo kakale besingagalemoyo, beleba zwakayipa nekweZila iyeyo mbeli kwegubungano, wakabva pabali, akatola badiyiwa, akanozuwisana nabo mahhuba ose bali mukwele tjaThiranuse. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />Ikoku kwakayendilambeli kuyetikala kwemakole mabili, kwekuti bose bagali bemuAsiya bakawha dama laHe, bose maJuta nemaGiriki.<verse eid="ACT 19:10" /></para>
  <para style="s">Bakololo baSikeva</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />Ndzimu wakayeta matjenamiso makulu ngemaboko aPhawuli, <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />kwekuti baka betola dzihangatjefu kene dzikhiba pambili uwe dziyendisiwa kubagwele, nghwele dzikabasiya nemeyambi dzikabhuda mubali. <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />Kukakoti amwe maJuta aka epoteleka, edusa meyambi mubanhu, akayedza hingisa zina laHe Yesu pehhugwi kwayibabo bana meyambi, eti, “Ndokutata ngezina laYesu unosumikigwa naPhawuli.” <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />Bakololo bali kutondeka bemphirisiti nkulu unoyi Sikeva, waka ali Njhuta, baka bekuthama ikoku.<verse eid="ACT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15" />Koga meyambi yakabahandula iti, “Yesu ndowunziba, Phawuli ndowunziba; koga imwi ndimwi boyani?”<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />Nlume waka ana meyambi wakabatjulukila, akabakulila, akabakunda bose, bakabhuda mun'umba betihha bali mbudlo kakale bakubala. <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />Ikoku kwakazibgwa nebagali bose bemuEfesu, maJuta nemaGiriki; bakawigwa neluhlo bose; zina laHe Yesu likakudziwa. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />Nebagalimoyo bakabuya nebunji, bebvuma kakale belebulula zwiyeto zwabo. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />Nebanoyeta masalamusi bakalesi nebunji whalo dzabakabehingisa panhu pan'ompela, bakadzipisa mbeli kwebanhu bose; bakabala ntengo wadzo bakawana ulizwiwulu zwili makumi mahanu zwemaloso esiliva. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />Ndizo dama laHe lakakula ngemasimba likaandama.<verse eid="ACT 19:20" /></para>
  <para style="s">Bhonyongo muEfesu</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />Kwatjipinda ikoku, Phawuli wakazwipila mumeya, kuti apinde muMakhedoniya nemuAkhayiya, eyenda kuJerusalema, eti, “Hapa ndaswika ko, ndakafanila kuti ndiswike kose nekuRoma.” <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />Akati atjituma babili baka bewumbhatsha banoyi Thimothi naErasitasi kuti bayende kuMakhedoniya, iye akagala muAsiya kwelubakanyana.<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />Mulubaka igogo kwakamuka bhonyongo lisihoma ngekweZila yaHe. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />Ngobe umwe nlume waka eyi Dimethiriyasi, ali mpfuli wesiliva, waka ethama zwitshwantshwa zwesiliva zwethempeli laAthemisi, elipa ntengo upehhugwi kubabehhi. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />Wakabakubunganya babehhi, kose nebamwe banamihingo inonga yabo, akati kubali, “Botate, moziba kuti fumwa yedu inobva mun'hingo iwhoyu. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />Mobona, kakale mowha, kuti kusi muno muEfesu koga, koga nemuAsiya yose, Phawuli iwhoyu unotetedza banhu ebadiyila ntome nebunji, eti, midzimu inoyetiwa ngemaboko hayite midzimu. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />Kuna mboli isi yekuti n'hingo wedu iwhoyu ube nezina lakayipa koga; koga nethempeli yendzimukadzi Athemisi inowholengudziwa, nekuti ungalahikigwa nebukulu gwawo, iye unonamatiwa muAsiya yose nemuhango yose.”<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />Bakati bekuwha ikoku, bakahhala buhongola, bakamimila beti, “Unkulukulu Athemisi weBaEfesu!” <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />Banhu munzi-nkulu baka hangana miholo; bakalabuka panhu pan'ompela benongina munhanga, behhuhhuta Gayiyasi naArisitakhasi, balume bekuMakhedoniya, banoba bali ibo baka beyenda njendo naPhawuli. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />Phawuli akati ehaka nongina mumbunga, badiyiwa bakawundzibisa; <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />nebamwe bo baka bali babhati bakulu bemuAsiya baka beli bakwinya babe, bakawuntumila dama bewuntetedza kuti asitongoyedza ikongina munhanga. <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />Kwakayetikala kuti bamwe baka bemimila yetji, bamwe bemimila yetjiya; kana gubungano laka lakadzongeka; bunji gwebanhu baka basingazibe kuti bakubunganilani. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />Bamwe mugubungano bakasunda Alekizanda kuti ayende mbeli, saku kuli iye waka ahagwa nemaJuta kuti ayende mbeli. Alekizandha akaba emilidza luboko, kudze banhu banyalale, eyedza kuti alebeleke. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />Koga bakati bebona kuti uNjhuta, bakatola lubaka gungaba ma awa mabili, bemimila panhu pan'ompela, beti, “Unkulukulu Athemisi weBaEfesu!”<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />Nkwalili wenzi-nkulu wakati atubula dzikamisa mbunga, akati, “Imwi banhu beEfesu, unhu wakatini usingazibe kuti nzi-nkulu weEfesu ndiwo nlondolodzi wethempeli laAthemisi nkulukulu, nebgwe lakayengemala lakawa libva kudzimu? <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />Saku mubona ke kuti zwinhu izwezwi azwingalandugwe, makafanila dzikama, musithame tjinhu mupaparika. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />Mahhisa balume ibaba ipapa nekene basi mbava mumathempeli kene banotuka ndzimukadzi wedu. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />Hapa kuli kuti Dimethiriyasi nebabehhi baanabo bana ndebo yabanayo nekwewumwe nhu, mbahhe dzemilandu dzakahhuka, kuna batongi bemilandu; ngabayende banotilikana milandu. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />Koga hapa kuna tjimwe kakale tjamunohaka, tjowholulamisiwa mun'hangano umunlayo. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />Ngobe kuna mboli yekuti tingawanikwa tina nlandu nekwebhonyongo layetikala nasi, iko kusina tjatingati nditjo tjayeta kuti kujalo.” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />Wakati aleba matama iyawa, akapaladza gubungano.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">KuMakhedoniya nekuAkhayiya</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />Kwakati bhonyongo latjipela, Phawuli akadana badiyiwa, akabasimisa ngematama, atjibawoneka wakamilika eyenda kuMakhedoniya. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />Wakati apinda mumitunhu yose iyeyo, eyenda ebakulumbidza kwazo, akaswika kuGirisi. <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />Wakapedza mimwedzi mitatu aliko, maJuta paakalangana nekukwe waka atjiba pedlo nemilika eyenda nekepe kuSiriya, ehaka kuti apinde kuMakhedoniya ohanduka. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />Wakapelekedzewa naSopata wekuBheriya, ali nkololo waPhayirusi; naArisitakhasi naSekundhusi, baThesalonika; naGayiyasi wekuDebhi, naThimothi; kose naThikhikhasi naThirofimasi bekuAsiya. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />Ibaba bakayendilambeli bakanotilinda kuThirowasi, <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />koga takayenda ngekepe tibva kuFiliphi hule kwemahhuba eTjinkwa Tjisina Mbidzo, mumahhuba mahanu takaswika kubali muThirowasi, patakagala kwemahhuba ali kutondeka.<verse eid="ACT 20:6" /></para>
  <para style="s">Phawuli Unokumba kuThirowasi Kwebupelo</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />Muhhuba lekutanga letshipi takakubungana kuti tipemule tjinkwa, Phawuli wakalebeleka nabo, kuli kuti unohaka yenda tjimuka; ndizo wakalebeleka kukadza kukaba pakati kwebusiku. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />Kwaka kuna zwivoneko zwinjinji mun'umba yapehhugwi kwataka takakubungana muyili. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />Umwe nhhuhha unoyi Yuthikasi waka aligele pawhindhi, wakabhakhwa newhope Phawuli etjayendilambeli nelebeleka; akati akuligwa neyizela, akawa ebva kun'umba yebutatu uyenda pehhugwi akanonungwa atjifa. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />Koga Phawuli wakajita akaswika ehunama ewunghumbatila, eti, “Musidziyidzike, umpenyu.” <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />Kukati Phawuli atanha akayenda kun'umba ipehhugwi atjipemula tjinkwa akadla, akalebeleka nabo lubaka gulefulefu, kukadza kukayedza, akamilika oyenda. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />Bakayenda nenhhuhha kanyi etjila, bakagadzikana mimoyo kwazo.<verse eid="ACT 20:12" /></para>
  <para style="s">Gwendo gwebva muThirowasi kunoti kuMilethasi</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />Koga iswi, tatjitungamila tiyenda kukepe, takamilika ngekepe tiyenda kuAsosi, Phawuli paaka ewhotanhila po; nekuti iye tjekukwe waka azwipila kuti unowhoyenda ikweno ngemakumbo. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />Akati ahangana naswi paAsosi, tikawuntanhisa tikayenda kuMithayilini. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />Timilika ipapo takayenda ngekepe, tjimuka tikanoswika pakalingisana neKhiyosi; muhhuba lebubili takanoswika kuSamosi; muhhuba lebutatu takanoswika kuMilethasi. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />Phawuli waka atjikumbula kuti asipinde nekuEfesu, kuyetila kuti asitole lubaka ali muAsiya; ngobe waka elibilidzila kuti hapa kutubuka, anobe muJerusalema muhhuba lePhentekhositi.<verse eid="ACT 20:16" /></para>
  <para style="s">Ndebeleko yaPhawuli Yewoneka Bawhola bemuEfesu</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />Phawuli ali muMilethasi, wakakumbila bawhola begubungano letshipi leEfesu kuti bahhe kuwunli. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />Bakati bahha kuwunli, akati kubali, “Imwi tjekwenyu moziba sekwandakatjila pakati kwenyu lubaka gose kubvila muhhuba lekutanga nditshamba muAsiya, <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />ndihingila He nekutebama ndilihhele mihodzi kakale ndiwigwa nezwiliko ngentha yelangana kwemaJuta; <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />moziba kuti andizotongobgwilila hule mukusumikila kumuli tjimwe netjimwe tjaka tjina bhatsho, ndidiya patjena nekubva payimwe n'umba ndiyenda kuyimwe n'umba, <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />ndibudza maJuta nemaGiriki nekwehandukila kuNdzimu negalabgwe muna He wedu Yesu. <verse eid="ACT 20:21" /><verse number="22" style="v" sid="ACT 20:22" />Sangwenu, ndoyenda kuJerusalema, ndilawugwa ngeMeya, ndisingazibe kuti ini tjinowhoyetikala kundili ikweno; <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />kuhhe kwekuti Meya Yakayengemala inoleba kundili mumizi-mikulu yose kuti sungwa nebulemo kwakandilindila. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />Koga anditokutola kuti butjilo gwangu guna tjilemela kundili, tjandinohaka koga whufidza ndima yangu nen'hingo wandakawamutjila kubva kuna He Yesu, wekuti ndilebe ndebo mbuya yengoni dzeNdzimu.”<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />“Sangwenu, whililani! Ndoziba kuti imwi mose, bandakayenda pakati kwenyu ndisumikila bumambo amutjowhopamha mukandibona kakale. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />Ndizo ndomubudza muhhuba lanasi kuti andina nlandu nekwelopa lenyu mose, <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />ngobe andizozeeza muzibisa ndongoloso yeNdzimu yose. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />Muzwilise kakale mulise nemhwizi dzose, Meya Yakayengemala yakamubiga kuti mube balisi badzo, kuti mutjengete gubungano letshipi leNdzimu laakatenga ngelopa lile. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />Ndoziba kuti hule kwekube ndayenda kowhohha mhele dzinohlisa pakati kwenyu, dzisingowhosiya kene iyo mhwizi, <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />napakati kwenyu kowhoba nebanhu banoleba zwinhu zwakapeyama, beyetila kwebela badiyiwa kubali. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />Ndizo tjenjelani, mukumbule kuti kwemakole matatu, siku nesikati, andizotongoma laya umwe newumwe wenyu ndilila n'hodzi.”<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />“Sangwenu ndomusa kuNdzimu nekudama lengoni dzidze, ilo linotubula mubaka nemupa nhaka pakati kwabo bose bakayengemadziwa. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />Andizotongotjiba siliva yewumwe nhu kene zeezi kene tjiyambalo. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />Imwi tjekwenyu moziba kuti maboko angu iyawa akahingila zwandinotayila, nezwinotayila bandinabo. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />Muna iko kose ndakamulakidza kuti ngehinga zwakasima wakafanila bhatsha ibabo banohaka bhatsho, ukumbula matama aHe Yesu, kuti wakati, ‘Pa kwakakombolegwa kupinda wamutjila.’ ”<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />Wakati apedza lebeleka, akapfigama akatembezela kan'ompela nabo bose. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />Bakalila bose bakagumbatila Phawuli bakawumputa, <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />bena buyendasi kwazo ngentha yetjaaleba, kuti abatjowhopamha bakawumbona kakale. Bakawumpelekedza bakanoswika kukepe.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">Phawuli Unoyenda kuJerusalema</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />Takati tapalalana nabo, takayenda ngekepe, takananga kuKhosi, tjimuka takaswika kuRodzi, tibva ipapo takanoswika kuPatara. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />Tikawana kepe tjaka tjiyambukila kuFonishiya, tikangina mutjili, tikayenda. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />Takati tebona Sayiphurasi, tikayisiyila kulumehwe, tikayenda kuSiriya, tikama kuTire; ngobe kepe tjaka tjinodelusa ntolo watjo ko. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />Takati tawana badiyiwa, tikagala ipapo mahhuba ali kutondeka. Bakakumbilisisa Phawuli ngeMeya, kuti asitongotshamba muJerusalema. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />Kwakati mahhuba edu apela tikamilika toyendilambeli negwendo gwedu; bakatipelekedza bose, kose nebafumakadzi nebana, tikadza tikanobhuda munzi-nkulu; tikaswika tipfigama munsetje wegungwa titembezela, tikabe tobawoneka. <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />Takatanha kepe, ibo bakabgwilila kumizi yabo.<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />Takati tawidza gwendo gwekuTire, tikaswika kuPhitholemayisi; tikabuyisa bagalimoyo tikagala kubali hhuba lin'ompela. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />Hhuba linotobela takamilika tikanoswika kuKhesariya; tikaswika kun'umba yaFiliphi, mvangeli, tikagala kuwunli, waka ali umwe webali kutondeka<note caller="+" style="f"><char style="fr" closed="false">21.8 </char><char style="ft" closed="false">bali kutondeka baka bahagwa nebapositoli kuti babhatshe kobela njhilikadzi kuJerusalema</char></note>. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />Waka ana bakololokadzi bali bana batjimhandala dzakapelela, baka belebesambeli. <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" />Takati tagala ipapo kwemahhuba, kukaswika nlebesambeli unoyi Agabhasi ebva kuJudiya. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />Akati ahha kutili akatola mwandabula waPhawuli akazwisunga nawo maboko nemakumbo, eba eti, “Meya Yakayengemala ikati, ‘MaJuta akuJerusalema anowhosunga mweni wemwandabula iwhoyu, bakawuyendisa kuBataya.’ ”<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />Tikati tikuwha ikoku, iswi kose nebagali bayipapo tikawuntetedza kuti asiyende kuJerusalema. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />Phawuli akabe ehandula eti, “Motani wali, mukuwa sayikoku, mundivuna moyo? Ngobe ndakalulamila kusi kuti ndisungwe koga, koga kene iko kuti ndibulawe kuJerusalema ngentha yezina laHe Yesu.”<verse eid="ACT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14" />Takati takon'wa wuntetedza, tikanyalala, tikati, “Kuda kwaHe ngakuyetiwe.”<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />Hule kwemahhuba iyawa takazwibaakanya tikayenda kuJerusalema. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />Bamwe bebadiyiwa bekuKhesariya bakayenda naswi, bakatiswikisa kun'umba yaMinasoni wekuSayiphurasi, umwe webadiyiwa bekutanga, kuyetila kuti tigale kuwunli.<verse eid="ACT 21:16" /></para>
  <para style="s">Swika kwaPhawuli kuJerusalema</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />Takati taswika kuJerusalema, bagalimoyo bakatiwamutjila ngekuhanha. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />Muhhuba linotobela Phawuli wakayenda naswi kuna Jakobe; bawhola bose bo baka balipo. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />Hule kwebabuyisa, wakalondesedza tjimwe netjimwe tjakayetiwa neNdzimu pakati kweBataya ngekusumikila kukwe. <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />Bakati batjikuwha bakakudza Ndzimu. Bakakoti kuwunli, “Nobona gamu ledu, azwiwulu zwingana maJuta akagalamoyo; ose akazwipila londolodza nlayo, <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />akatjibudziwa nekuko kuti nodiya maJuta agele pakati kweBataya kuti alahe nlayo waMozisi, uwabudza kuti asithumbile bana bawo kene iko tobela milenje. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />Ndizo, tithame tjini? Banowhowha kuti wabuya. <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />Tjithama tjatinokubudza. Tina balume bana bakatuna; <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />tjitola balume ibabo unozwitjenesa panhu pan'ompela nabo, ubalipile kuti batesegwe miholo yabo. Kudze banhu bose bazibe kuti akuna malebeswa mundebo inolebgwa ngekuko, nekuti iwe notjila ngetobela nlayo. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />Koga Bataya bakatjigalamoyo takabatumila lukwalo, gunoleba tjatakabvumilana, kuti basitongodla zwabhayigwa midzimwana, nemalopa, nezwakasiniwa, nekuti bazwidzibe mubupombgwe.”<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />Phawuli wakatola balume ibabo, tjimuka akanozwitjenesa panhu pan'ompela nabo. Akakotjiyenda kuthempeli, kudze azibise kuti mahhuba etjenesewa anopela lini nekuti kowhohhisiwa tjibhayilo tjewumwe newumwe wabo.<verse eid="ACT 21:26" /></para>
  <para style="s">Sungwa kwaPhawuli muThempeli</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />Kwakati mahhuba ali kutondeka ebva epela, maJuta anobva kuAsiya, akawumbona muthempeli, akabudzila ntome banhu bose akabadzonga mikumbulo, akawumbhata, <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />emimila eti, “Balume beIsirayeli bhatshani! Iwhoyu nhu ndiye unodiyila nhu wose ntome ntha dzose nekwebanhu bedu nenlayo nange bugalo igogu; pehhugwi kwayikoku unohha nemaGiriki muthempeli, kakale walonga hambgwa mubugalo igogu gwakayengemala.” <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />Ngobe baka batongowumbona ana Thirofimasi wekuEfesu munzi-nkulu, bakakumbulila kuti Phawuli wabuya naye muthempeli.<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />Nzi-nkulu wose wakadzongeka, banhu bakalabuka bose kan'ompela; bakawumbhata Phawuli, bakawuhhuhhutila kuhhe kwethempeli, mikoba ikahhaligwa tjinyolotjo. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />Bakati batjayedza kuti bawumbulaye, kukaswika matama kunlawuli webagwi bengwa kuti Jerusalema yose yadzongeka. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />Nlawuli webagwi bengwa wakamilika nekulibilidza akatola bagwi bengwa nebatungamili bebagwi bengwa, akalabukila ko; banhu bakati bebona nlawuli webagwi nebagwi, bakama loba Phawuli. <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />Nlawuli webagwi wakaswika akawundzula, akalaya kuti asungwe ngeketane mbili. Wakabhuzwisisa kuti ndiye yani nekuti waka athamani. <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />Bamwe mumbunga baka bemimila beleba yetji bamwe beleba yetjiya; ngono nlawuli webagwi bengwa akasitubule wha lebeswa ngentha yehhoba, akalaya kuti bawuyendise kunzi webagwi bengwa. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />Wakati aswika pamatanho, akasengwa nebagwi bengwa ngentha yebuhongola gwembunga; <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />kana banhu banjinji bakatobela, beyenda bemimila beti, “Ngaabulawe!”<verse eid="ACT 21:36" /></para>
  <para style="s">Phawuli unozwimila mbeli kweNlawuli weBagwi Bengwa</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />Kukati Phawuli ebva enginisiwa munzi webagwi bengwa, akati kunlawuli webagwi bengwa, “Ndingaleba tjimwe tjinhu kumuli?”</para>
  <para style="p" vid="ACT 21:37">Akahandula eti, “Noziba TjiGiriki? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />Ngono awuta iwe Nghipita wakatanga bupanduki mumahhuba akapinda, akatungamila babulayi bali zwiwulu zwina yenda kutjilambanyika?”<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />Phawuli wakahandula eti, “NdiNjhuta, ndobva kuThasasi muSilisiya, ndinghali wenzi-nkulu unatjilumbi; ndomukumbila, mundibvumileni ndilebeleke nebanhu.”<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />Wakati awumbvumila, Phawuli, alimile pamatanho, akanyaladza banhu ngemilidza luboko gugwe; kukati kwatjibe nekunyalala kukulu, akalebeleka nabo neTjiHhebheru, eti.<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />“Makamu nabotate, whililani kuzwimila kwandinoyeta mbeli kwenyu.” <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />Bakati bewha kuti unolebeleka nabo nelulimi gweTjiHhebheru, bakanyalala kwazo.</para>
  <para style="p" vid="ACT 22:2">Eba eti. <verse eid="ACT 22:2" /><verse number="3" style="v" sid="ACT 22:3" />“NdiNjhuta, wakazwaligwa muThasasi kuSilisiya, koga ndakakulila munzi-nkulu uno, ndikadiyiwa pamakumbo aGamaliyeli nekwezila yenlayo wabotate bedu, ndaka ndakazwipila hingila Ndzimu sekwamunoyeta bo imwi nasi. <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />Ndakadziyidza Zila iyeyi kuswika palufu, ndisunga betjilume nebetjikadzi ndibaposela mujele, <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />semphirisiti nkulu nelubahhe gwebawhola bose bengapa busupi kuti ndoleba lebeswa. Ndakawamutjila whalo dzinobva kubali dziyenda kubamwe babo bakuDamasikasi, ndizo ndakayenda ikweno ndinosunga banhu ibaba kudze ndibalesi kuJerusalema bakasungwa ngemiketane kuyetila kuti bawholangiwa.”<verse eid="ACT 22:5" /></para>
  <para style="s">Phawuli Unoleba Nekwehanduka Kukwe</para>
  <para style="r">(<ref loc="ACT 9:1-19">Mihingo 9.1-19</ref>; <ref loc="ACT 26:12-18">26.12-18</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />“Nditjimugwendo gwangu ndiyenda kuDamasikasi, kungaba pakati kwemasikati kwakapenya tjedza tjinobva kudzimu pandiyako. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />Ndiba ndiwila pasi awha whi liti kundili, ‘Sawuli, Sawuli, unondidziyidzilani kene?’ <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />Ndikahandula nditi, ‘Ndimwi yani, He?’ Akati kundili, ‘Ndimi Yesu wekuNazaretha wawunodziyidza.’ <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />Bandaka ndinabo bakabona tjedza koga whi lewaka elebeleka nami abazoliwha. <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />Ndiba nditi, ‘Ndithameni ngono, He?’ He bakati kundili, ‘Milika uyende kuDamasikasi, ikweno nowhobudziwa kose kwawakamisigwa kuti ukuyete.’ <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />Ndakati ndisingatjabone ngentha yepenya kwetjedza, ndikakotungamigwa ndakabhakhwa luboko nayibabo bandaka ndiyenda nabo, ndikayenda kuDamasikasi.”<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />“Umwe nlume unoyi Ananiyasi, waka akalulama etobela nlayo, kulebgwa zwakanaka nekukwe ngemaJuta ose anogala imhomo, <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />wakahha kundili, akati abemile ntome kwangu akati, ‘Gamu langu Sawuli, wamutjila bona kuko.’ Ngetjibaka itjetjo zwatjo ndakapofunuka, ndikawumbona. <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />Eba eti, ‘Ndzimu wabobatategulu bedu wakuhalula kuti uzibe kuda kukwe, kuti ubone Iye Wakalulama kakale uwhe whi linobva munlomo uwe; <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />ngobe nowhoba nsupi uwe kubanhu bose muna zwawabona nezwawawha. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />Sangwenu utjimilileni? Milika ubvubikiwe, ungudziwe matjinyo awo, udana zina lile.’ ”<verse eid="ACT 22:16" /></para>
  <para style="s">Dan'wa kwaPhawuli kuti Anosumikila kuBataya</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />“Ndakati ndabgwilila kuJerusalema nditjatembezela ndili muthempeli, aswikigwa nembono, <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />ndikabona He beti kundili, ‘Libilidza ubhude tjinyolotjo muJerusalema, ngobe abatowhowamutjila busupi gugo nekwangu.’ <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />Ndiba nditi, ‘He, ibo tjekwabo banoziba kuti ndaka ndiyenda muyimwe neyimwe sinagogu ndihhalilila mujele kakale ndiloba banogalamoyo mumuli. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />Kakale kwakati kutebugwa lopa laSitefani, nsupi wenyu, ndaka ndilimile ipapo bo, ndibvumila bulawa kukwe ndakabhata zwiyambalo zwayibabo baka bewumbulaya.’ <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />He beba beti kundili, ‘Yenda, ngobe ndowhokutuma kule kule kuBataya.’ ”<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />Banhu bakawuwhilila akadza akaswika pakuleba dama ileli; bakakotjimimila beti, “Dusani muhango nhu wakajali! Ngobe haazofanila kuti atjile!” <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />Baka bemimila belahanya zwiyambalo zwabo, bepukula whuluba, <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />nlawuli webagwi bengwa akalaya kuti bawunginise munzi webagwi bengwa, akabalaya kuti aholesesewe ngesukutigwa, kudze kuzibgwe kuti ini tjayeta kuti banhu bathame hhoba zwingapa nekukwe. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />Bakati batjiwunsunga nemitjili kuti asukutigwe, Phawuli akati kunlawuli webagwi bengwa waka alimile ntome kukwe, “Kobvumigwa kuti musukutile nhu wekuRoma, asawanikwa nlandu?”<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />Ntungamili webagwi bengwa wakati ekuwha ikoku akayenda kunlawuli webagwi bengwa akati kuwunli, “Ini ikoku kwawehaka thama? Ngobe iwhoyu nlume unhu wekuRoma.”<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />Ndizo nlawuli webagwi bengwa wakati kuna Phawuli, “Tongondibudza, unhu wekuRoma kene?”</para>
  <para style="p" vid="ACT 22:27">Iye wakahandula eti, “Ee.”<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />Nlawuli webagwi bengwa eba eti, “Ba nghali wekuRoma ikoku ndakakutenga nentengo usin'homa.”</para>
  <para style="p" vid="ACT 22:28">Phawuli eba ehandula eti, “Koga imi ndi iye ngezwagwa.”<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />Koga ibabo baka behaka kuti bawun'holesese bakatsheduka pawunli tjinyolotjo; nlawuli webagwi bengwa akatangisa hla bo, kana wakabona kuti Phawuli unghali wekuRoma koga iye waawunsunga.<verse eid="ACT 22:29" /></para>
  <para style="s">Phawuli Unoyendisiwa Kulubahhe</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />Koga tjimuka, nlawuli webagwi bengwa ehaka ziba itjo ntja tjakayeta kuti maJuta awunlonge nlandu, wakawunsunungula, akalaya kuti baphirisiti bakulu nelubahhe guhangane, akahhisa Phawuli akawunghadza mbeli kwabo.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />Phawuli wakalingisisa banhu belubahhe, akati, “Makamu angu, ndatjila mbeli kweNdzimu nehana mbuyanana kuswika ileli hhuba.” <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />Mphirisiti nkulu unoyi Ananiyasi wakalaya baka balimile pedlo kuti bawumadule nlomo. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />Phawuli eba eti kuwunli, “Ndzimu unowhokuloba, iwe guma lakadzulugwa nekalaga! Ugele kuti unditonge nekwenlayo, koga iwe tjekuko uvuna nlayo ngelaya kuti ndimadugwe!”<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />Baka balimile pedlo bakati, “Unotuka Mphirisiti nkulu weNdzimu?”<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />Phawuli akahandula eti, “Ndandisingazibe, makamu angu, kuti ndiye Mphirisiti Nkulu; ngobe kwaka kwagwa kuti, ‘Usitongoleba zwakayipa nekwentongi webanhu.’ ”<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />Ngobe Phawuli wakaziba kuti bamwe babo baSadusi bamwe baFarisi, akamilidza whi mulubahhe, eti, “Makamu angu, imi ndiMfarisi, ndinkololo weMfarisi; ndolongwa nlandu ngentha yegalabgwe kwangu mumuka kwebafi.”<verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />Wakati aleba ikoku, kukaba nekukakabadzana pakati kwebaFarisi nebaSadusi; gubungano likathubukana pakati. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />Ngobe baSadusi banoti akuna muka kubafi, akuna ntumwa weNdzimu, akuna Meya; koga baFarisi banobvuma kuti kose ikoku kuyapo. <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />Kukabe nekukakatilana kukulu; bamwe bebakwali belubabi gwebaFarisi bakamilika bakakakabala beti, “Akuna tjakayipa tjatinowana munlume iwhoyu. Hapa kuli kuti meya kene ntumwa weNdzimu wakalebeleka naye ke?”<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />Kukati kakabadzana kwakula, nlawuli webagwi bengwa, ngentha yehla kuti bangabva bepalulanya Phawuli, akatumila bagwi bengwa kuti banowuntsara pabali, bawunlesi munzi webagwi bengwa.<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />Busiku gunotobela He wakama ntome kukwe akati, “Sima, ngobe sekwawapa busupi nekwangu muJerusalema, wakafanila nopa busupi nekuRoma kakale.”<verse eid="ACT 23:11" /></para>
  <para style="s">Langana Nekwebutjilo GwaPhawuli</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />Kukati kwayedza, maJuta akalangana akazwisunga ngetuna kuti aangadle kene iko n'wa kuswika abulaya Phawuli. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />Baka bepinda makumi mana ibabo bakalangana ikoku. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />Bakayenda kubaphirisiti bakulu nekubawhola, benoti, “Tazwisunga ngetuna kuti atitowholabila zodliwa kuswika tabulaya Phawuli. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />Ndizo, imwi kan'ompela nelubahhe zibisani nlawuli webagwi bengwa kuti awunlesi kumuli sekunoyi mohaka whisisa ndebo iye. Iswi takamilila kuti tiwumbulaye asanhu akaswika pedlo.”<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />Koga nkololo wehazwadzi yaPhawuli wakawha langana kwabo; ndizo wakayenda akanobudza Phawuli munzi webagwi bengwa. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />Phawuli wakadana umwe webatungamili bebagwi bengwa akati, “Yendisani nhhuhha iwhoyu kunlawuli webagwi bengwa; una tjaanohaka wumbudza.” <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />Ndizo wakawuyendisa kunlawuli webagwi bengwa akati, “Phawuli umujele wandikumbila kuti ndihhise nhhuhha iwhoyu kumuli, ngobe una tjaanohaka mubudza.”<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />Nlawuli webagwi bengwa wakawumbhata neluboko, akati atshedukila ntome akawumbhuzwa baliboga, eti, “Ini tjawunohaka ndibudza?”<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />Wakahandula eti, “MaJuta abvumilana kuti amukumbile kuti muhhise Phawuli kulubahhe mangwana, sekunoyi banohaka bhuzwisisa lebeswa kakale nekukwe. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />Koga musibabvumile; ngobe kuna balume banopinda makumi mana bakawumbgwatilila, bakazwisunga ngetuna kuti abatowhodla kene n'wa kuswika bawumbulaya; sangwenu batjizwilulamisa, bakalinda mbvumo yenyu.”<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />Ndizo nlawuli webagwi bengwa wakasunungula nhhuhha, ewunkowhomesedza eti, “Usibudze kene iye nhu kuti wandibudza ikoku.”<verse eid="ACT 23:22" /></para>
  <para style="s">Phawuli Unoyendesewa Kuna Felikisi Mbhati Wentunhu</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />Wakadana balawuli bebagwi bengwa babili akati kubali, “Lulamisani bagwi bengwa bali makhulu mabili, nebagwi bembizi bali makumi ali kutondeka, nebabhayani bali makulu mabili muyende kuKhesariya mu awa yebutatu yebusiku. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />Muwanile Phawuli mbizi yekuti atanhe bo, anoswika zwibuyanana kuna Felikisi mbhati wentunhu.” <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />Akakwala lukwalo gunoti.<verse eid="ACT 23:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="ACT 23:26" />“Imi Kilawudiyasi Lisiyasi, kuna Unolemekedzewa mbhati wentunhu Felikisi, ndomubuyisa. <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />Nlume iwhoyu waka abhakhwa nemaJuta, betjowhowumbulaya, imi ndikahha nebagwi bengwa bangu ndikawuwangulila, hule kwekuti ndaziba kuti unghali wekuRoma. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />Ndiyemula ziba kuti banowuntilika nlandu weni, ndakawuyendisa kulubahhe gwabo. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />Ndikawana kuli kuti banowuntilika nlandu wezwinhu zwenlayo wabo, koga kusina nlandu wekuti angasungwa kene kuti abulawe. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />Hule kwekuti ndabudziwa kuti kuna langana kwayetiwa nekukwe, ndawuntumila kumuli nekulibilidza, ndabudza bo nebanowuntilika nlandu kuti balebe mbeli kwenyu kuti banowuntilika nlandu weni.”<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />Ndizo bagwi bengwa bakatola Phawuli selayiwa kwabo, bakayenda naye busiku bakadza bakanoti kuAntiphathirisi. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />Tjimuka bagwi bemakumbo bakabgwilila kunzi webagwi bengwa, besiya bagwi bembizi kuti bayendilembeli naye. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />Bakati baswika kuKhesariya bakayendisa lukwalo kumbhati wentunhu, bakatula Phawuli bo mbeli kukwe. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />Wakati abala lukwalo, akabhuzwa kuti ndewawupi ntunhu. Akati awha kuti ndewe kuSilisiya <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />wakati, “Ndowhokuwhilila hapa banokutilika nlandu baswika.” Akalaya kuti alindiwe ali mun'umba yaHherodi.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />Hule kwemahhuba mahanu mphirisiti nkulu unoyi Ananiyasi wakahha anabamwe bawhola nenlebeleki unoyi Thethulasi. Bakatula ndebo yabo nekwaPhawuli mbeli kwembhati wentunhu; <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />akati atjidan'wa, Thethulasi akatangisa wuntilika nlandu eti. “Saku tina kunyalala kungapa ngentha yenyu, kakale kwaba nemilayo inoyetigwa tjaba tjino, ngentha yebutjenjebvu gwenyu. <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />Unolemekedzewa Felikisi, tokuwamutjila ikoku nezila dzose nemubugalo gose tina kuboka kukulu. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />Koga, kuyetila kuti tisimubhatilile, ndomukumbila kuti mutiwhilile kwelubakanyana. <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />Ngobe tawana kuti nlume iwhoyu umbatsha mutjaba, unodzonganya maJuta muhango yose, kakale untungamili wembunga wakalahika wemaNazarini. <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />Wakatongoyedza longa hambgwa thempeli, koga tikawumbhata. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" /><note caller="+" style="f"><char style="fr" closed="false">24.7 </char><char style="ft" closed="false">dzimwe whalo adzina vesi 7. </char><char style="fp" closed="false">Taka towhuntonga nenlayo wedu koga nlawuli webagwi bengwa unoyi Lisiyasi wakahha, akatitolela iye nebuhongola, eti ibabo banowuntilika nlandu ngabahhe kumuli.</char></note> <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />Ngekuwumbhuzwisisa imwi tjekwenyu, mowhotubula bhuda nelebeswa nekwemilandu yatinowuntilika iyo.” <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />MaJuta bo akanginila ndebo iyeyo, besimisa kuti kose ikoku kumalebeswa.<verse eid="ACT 24:9" /></para>
  <para style="s">Phawuli Unozwimila mbeli kwaFelikisi</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />Kwakati mbhati wentunhu atjiwulakidza ngeluboko kuti alebeleke, Phawuli akalebeleka eti. “Ndoziba kuti kwaba makole manjinji muli ntongi wetjaba tjino, ndizo ke ndotula kuzwimila kwangu ndakasununguka. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />Sekwamungabvuma bo, akwanhu kwapinda mahhuba aligumi nemabili ndakayenda kunonamata kuJerusalema; <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />abazondiwana ndikakabadzana nenhu kene ndidzonganya mbunga webanhu, muthempeli kene musinagogu, kene munzi-nkulu. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />Kakale abana tjinobhatika tjinolakidza kuti milandu yabanonditilika iyo ilebeswa. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />Koga ke ndobvuma whoku mbeli kwenyu, kuti nekweZila, yabanodana beti whulahika, ndonamata Ndzimu wabotate bedu, ndigalamoyo kose kwakabigwa munlayo kene kwakakwagwa muwhalo dzebalebesambeli, <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />ndina kugalabgwe muNdzimu ikoko kwabanako bo ibaba, kuti ibabo bakalulama nebabi banowhomuka kubafi. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />Ndizo ndogala ndigwisa tjose ba nehana mbuyanana mbeli kweNdzimu nambeli kwebanhu.”<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />“Hule kwemakole manjinji, ndakabuya kuyetila kuti ndihhise zwipo zwengoni nepila zwibhayilo, mutjaba tjakanyi kwangu. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />Ndaka nditjathama ikoku, bakandiwana ndatjenesewa muthempeli, kusina mbunga wandinawo, kene bhonyongo landaka ndithama. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />Koga kuna amwe maJuta aka ebva kuAsiya, akafanila ba ali pano mbeli kwenyu enditilika nlandu, hapa kuli kuti kuna tjaanatjo nekwangu. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />Kene ibaba balume tjekwabo ngabalebe kuti bakandiwana kupi tjinya pandakama mbeli kwelubahhe, <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />kuhhe kwetjinhu yetji tjin'ompela tjandakamimila ndilimile pakati kwabo. ‘Ngentha yekumuka kubafi mondilonga nlandu muhhuba lanasi.’ ”<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />Koga Felikisi, analuzibo guhhele nekweZila, wakamisa ndebo, eti, “Lisiyasi nlawuli webagwi bengwa paanobuya, ndowhopedzisa ndebo yenyu.” <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />Akalaya nlawuli webagwi bengwa kuti Phawuli alisiwe koga abe nensununguko yakalizanila, nekuti kubvumigwe bakwinya babe bawumbhatshe nezwaanohaka.<verse eid="ACT 24:23" /></para>
  <para style="s">Phawuli Alimbeli kwaFelikisi naDurusila</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />Hule kwemahhuba Felikisi wakabuya nemfumakadzi uwe waka eyi Durusila, waka ali Njhuta; wakati kudan'we Phawuli akawuwhilila elebeleka nekwegalabgwe muna Khirisitu Yesu. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />Phawuli wakati etjaleba nekwendulamo, nekuzwidziba netongewa kunowhohha, Felikisi akahhigwa nekuhla akati, “Yenda kwangwenuwali; hapa ndawana lubaka ndowhokudana.” <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />Mulubaka igogo waka akalingilila kuti unowhopiwa mari naPhawuli, ndizo waka ogala ewundhana elebeleka naye.<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />Kwapinda makole mabili, Phoshiyasi Fesitasi wakangina mubugalo gwaFelikisi; koga ngentha yekuti Felikisi waka ehaka diwa nemaJuta, wakasiya Phawuli ali mujele.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">Tjikumbilo TjaPhawuli Kuna Khesari</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />Hule kwemahhuba matatu Fesitasi aswika muntunhu, wakayenda kuJerusalema ebva kuKhesariya. <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />Baphirisiti bakulu nebatungamili bemaJuta bakawunzibisa nekwaPhawuli; bakawuntetedza, <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />bekumbila kuti abhatshe nehhisa Phawuli kuJerusalema, kana baka belangana kuti bawumbgwatilile muzila bawumbulaye. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />Fesitasi wakahandula eti, “Phawuli wakahhaliligwa kuKhesariya, kakale ndowhoyenda ko tjinyolotjo. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />Ndizo, bamwe batungamili pakati kwenyu ngabayende nami, hapa kuna tjaakatjinya bawuntilike nlandu.”<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />Wakati agala nabo kwemahhuba angaswika hhanakadzi kene gumi, akayenda kuKhesariya; tjimuka akadana lubahhe gwetonga akalaya kuti Phawuli ahhisiwe. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />Phawuli wakati atjibuya, maJuta aka abuya ebva kuJerusalema akawunkombeledza, ewuntilika milandu minjinji yakasima yaasingatubule pa busupi nekwayo. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />Phawuli wakazwihandulila eti, “Andizotjuluka nlayo wemaJuta, kene iko tjinyila thempeli, kene iko tjinyila Khesari.”<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />Koga Fesitasi, ehaka diwa nemaJuta, wakati kuna Phawuli, “Unohaka yenda kuJerusalema, kuti unotongegwa milandu iyeyi mbeli kwangu?”<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />Koga Phawuli wakati, “Ndimile mbeli kwelubahhe gwetonga gwaKhesari, ndipo pandakafanila tongegwa; maJuta akuna tjandakabatjinyila, sekwamunoziba bo. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />Hapa kuli kuti ndintjinyi, kuna tjandakathama tjandakafanila fila, anditohaka kuti ndidzete lufu; koga hapa milandu yabanonditilika isi lebeswa, akuna unganditula mumaboko abo. Iyeyi ndebo inopindila kuna Khesari.”<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />Ndizo Fesitasi, hule kwelebeleka nelubahhe, wakahandula eti, “Wakumbila kuti ndebo iyeyi ipindisigwe kuna Khesari; unowhopindisigwa kuna Khesari.”<verse eid="ACT 25:12" /></para>
  <para style="s">Phawuli ali mbeli kwaAgiripha naBhenisi</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />Kwakati kwapinda mahhubanyana, mambo Agiripha naBhenisi bakaswika kuKhesariya bewhowamutjila Fesitasi. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />Bakati batjigala mahhuba manjinji, Fesitasi akabikila mambo nekwaPhawuli, eti, “Kuna nlume wakasiyiwa naFelikisi ali nsungwa; <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />ndikati ndili kuJerusalema, baphirisiti bakulu nebawhola bemaJuta bakandibudza nekukwe, bekumbila kuti awanike nlandu. <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />Ndikababudza kuti akuta mpanga wemaRoma kuti nhu awanike nlandu iye asanhu akalingisana nebanowuntilika nlandu, kakale akapiwa lubaka gwekuti azwihandulile munlandu waatilikiwa. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />Bakati babuya pano bose, andizononoka, koga tjimuka ndakagala nelubahhe gwetonga ndikalaya kuti nlume iwhoyo ahhisiwe. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />Banowuntilika nlandu bakamilika, koga abazohhisa nlandu wakayipa sekwandaka ndikumbula; <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />koga bakabenyanyayidzana naye nekwelunamato gwabo, nekwewumwe nlume unoyi Yesu, wakafa, koga Phawuli waka esimisa kuti umpenyu. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />Ndahaya kuti ndihakisise tjini nekwendebo iyeyo, ndakawumbhuzwa kuti unohaka yenda kuJerusalema anotongegwa ndebo iyeyo ko. <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />Koga Phawuli wakati akumbila kuti asiyiwe alimujele akamilila tongwa namambo, ndakalaya kuti ahhaliligwe ndidze ndiwuntumile kuna Khesari.”<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />Agiripha wakati kuna Fesitasi, “Ndohaka zwiwhila nlume iwhoyo.”</para>
  <para style="p" vid="ACT 25:22">Fesitasi wakahandula eti, “Mowhozwiwhila iye mangwana.”<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />Ndizo tjimuka Agiripha naBhenisi bakabuya bakambala zwakanaka kwazo, bakangina mun'umba whulu yelubahhe bana batungamili bebagwi bengwa nebanhu bapehhugwi benzi-nkulu. Ndizo Fesitasi akalaya kuti Phawuli ahhisiwe. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />Fesitasi wakati, “Mambo Agiripha namwi mose mupano naswi, mowumbona nlume iwhoyu, maJuta ose, akuJerusalema ne amuno akandikumbila, emimila eti haazofanila yendilambeli etjila. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />Koga ndakawana kusina tjaathama tjakalizanila lufu. Ndizo sekwaaka akumbila kuti apindisigwe mbeli kuna mambo, ndakabona kuti ndiwuyendise. <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />Koga andina tjinhu tjakwako tjandingakwalila mambo wangu nekukwe. Ndizo ndawunlesi mbeli kwenyu, bukulu mbeli kwenyu imwi Mambo Agiripha, kudze, hule kwekuwun'holesesa, ndiwane tjandingakwala. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />Ngobe kundili konga tjinhu tjisina nkumbulo, kuti nditumile nsungwa, ndisingalayidze kuti nlandu uwe ndeweni.”<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">Phawuli Unozwimila Mbeli kwa Agiripha</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />Agiripha wakati kuna Phawuli, “Unambvumo yekuti uzwilebelekele.”</para>
  <para style="p" vid="ACT 26:1">Phawuli akatambunudza luboko gugwe akatangisa kuzwimila, eti. <verse eid="ACT 26:1" /><verse number="2" style="v" sid="ACT 26:2" />“Ndokumbula kuti ndina mhahha kuti ndime mbeli kwenyu nasi, Mambo Agiripha, ndizwimila nekwemilandu yose yandinotilikiwa ngemaJuta, <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />ngobe moziba kwazo milenje yemaJuta nenyanyayidzana kwawo; ndizo ndomukumbila kuti mundiwhilile makabiga moyo.”<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />“Tjila kwangu kubvila nditjintshwa, nditjila muhango yakanyi kwangu nemuJerusalema, kozibgwa nemaJuta ose. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />Bakakuziba ntolo kubvila nditjintjetjana bengapa busupi, hapa beda, kuti ndakatobela lunamato gwedu, nditjila seMfarisi. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />Sangwenu ndimile pano nditongegwa galabgwe tjigadzabgwe tjakayetiwa neNdzimu kuna bobatategulu bedu, <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />itjo tjinhu njudzi dzedu dzili gumi nembili tjadzakalingilila tjiwamutjila, dzinamata Ndzimu siku nesikati dzakalonga moyo. Ngono ngentha yayikoku galabgwe, maJuta anonditilika nlandu mambo! <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />Ngentha yeni imwi mupano mukumbula kuti akutowhofa kwayetikala kuti Ndzimu unomusa bafi?”<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />“Imi tjekwangu ndaka ndiwana kwakalulama kuti ndiyete zwinhu zwinoleyana nezina laYesu wekuNazaretha. <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />Ndakathama ndijalo muJerusalema; andizotongohhalilila bayengemali banjinji mujele koga ngesimba lebaphirisiti bakulu, koga pabaka bebulawa nami bo ndaka ndibvumilana nako. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />Ndakandigozwa balanga muyimwe neyimwe sinagogu, ndibamanikidza kuti batuke Ndzimu wabo; kakale ngebagwadziligwa moyo, ndakabadziyidza kudza kunoswika kumizi-mikulu yebataya.”<verse eid="ACT 26:11" /></para>
  <para style="s">Phawuli Unoleba Nekuhanduka Kukwe</para>
  <para style="r">(<ref loc="ACT 9:1-19">Mihingo 9.1-19</ref>; <ref loc="ACT 22:6-16">22.6-16</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />“Ndizo ndakayenda kuDamasikasi ndina simba nembvumo yebaphirisiti bakulu. <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />Kukati pakati kwemasikati, mambo, ndili muzila ndikabona tjedza tjibva kudzimu, tjinopenya kupinda hhuba, tjipenya pandili nepana ibabo bandaka ndiyenda nabo. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />Tikati tawila pasi tose, ndikawha whi lilebeleka nami neTjiHhebheru liti, ‘Sawuli, Sawuli, unondidziyidzilani kene? Nozwikubadza nepfulana nemimhiwa<note caller="+" style="f"><char style="fr" closed="false">26.14 </char><char style="ft" closed="false">Kokukubadza milana nekuda kweNdzimu</char></note>.’ <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />Ndikabhuzwa nditi, ‘Ndimwi yani He?’ He akati, ‘Ndimi Yesu wawunodziyidza. <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />Koga milika ume nemakumbo awo; ngobe ndazwilakidza kukuli ndiyetila kuhala kuti ube n'hingi kakale upe busupi nekwezwinhu zwawabona nezwandinowhokulakidza, <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />ndowhokuwangulila kubanhu nekuBataya, bandinokutuma kubali <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />kuti uhhule meho abo, kuti babve musimba laSatane nemuhhalima, bayende kutjedza beyenda kuNdzimu, kudze bayetigwe mazwibhatigwa matjinyo abo nekuti bawane bugalo pakati kwebakayengemadziwa ngekugalamoyo mundili.’ ”<verse eid="ACT 26:18" /></para>
  <para style="s">Phawuli Unoleba Nekwen'hingo Uwe</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />“Ndizo ke, mambo Agiripha, andizolamba whilila mbono wekudzimu, <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />koga ndakasumikila kubanhu bekuDamasikasi kutanga, ndikakotjisumikila kuna bekuJerusalema nentunhu wose weJudiya, kose nekuBataya, kuti bahanduke kakale batendebukile kuNdzimu bayete mihingo yakafanila handuka kwabo. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />Ngentha yayikoku maJuta akandibhata muthempeli akayedza kuti andibulaye. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />Ndandibhatshiwa neNdzimu kudzina kuswika nasi, ndizo ndilimile pano ndipa busupi kubatukununu nekubakulu, ndisingalebe kumwe kuhhe kwekwakalebgwa ngebalebesambeli naMozisi beti kowhoyetikala. <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />kuti Khirisitu wakafanila dziyila, nekuti, nekuba iye wekutanga muka kubafi, unowhosumikila tjedza kubanhu beludzi gugwe nekuBataya.”<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />Etjalebeleka ezwimila, Fesitasi wakalebeleka newhi lipehhugwi eti, “Unopenga Phawuli; diyika kuko kunjisa kwekupengesa.”<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />Koga Phawuli wakati, “Anditopenga, unokudziwa Fesitasi, koga ndoleba lebeswa lakatambunuka. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />Ngobe mambo banoziba nekwezwinhu izwezwi, kakale ndolebeleka nabo ndakahalabvuka; ngobe ndinalebeswa kuti akuna tjimwe tjayizwezwi zwinhu tjabasingazibe, ngobe ikoku akuzoyetika pakasumbikika. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />Mambo Agiripha, mogalamoyo balebesambeli? Ndoziba kuti mogalamoyo.”<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />Agiripha wakati kuna Phawuli, “Nokumbula kuti nelubakanyana igogu ungandithama Nkhirisitu!”<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />Phawuli wakati, “Gungabe gufupi kene gulefu, ndotembezela kuNdzimu kuti athame kusibe imwi moga koga nayibo bose banondiwha muhhuba lanasi babe sekwandili iko, kuhhe kweketane idzedzi.”<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />Mambo nembhati wentunhu naBhenisi bakamilika, kose nebabaka baligele nabo; <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />bakati batjibva ipapo, bakalebelesana beti, “Nlume iwhoyu akuna tjaathama tjaakafanila bulayigwa kene sigwa mujele.” <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />Agiripha wakati kuna Fesitasi, “Nlume iwhoyu waangabe asunungugwa hapa waka esakumbila pindisigwa kuna Khesari.”<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">Phawuli Unoyenda kuRoma</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />Kwakati kwatjimisiwa kuti takafanila yenda kuIthali ngekepe, bakayendisa Phawuli nebamwe basungwa kunlawuli webagwi bengwa wetjikamu tja Ogasitani, unoyi Juliyasi. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />Takatanha kepe tjeku Adiramithiyamu, tjaka tjobva tjimilika tjiyenda tjipinda pamahhambuko apansumho wehango yeAsiya, takayenda, taka tina Arisitakhasi wekuMakhedoniya ebva muThesalonika. <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />Tjimuka takaswika kuSidoni; Juliyasi waka akabhata Phawuli zwakanaka, akawumbvumila kuti ayende anobona bakwinya babe bawumbhatshe nezwaanohaka. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />Tikati timilika ipapo nekepe tikayenda nekundzibo yeSayiphurasi yakasitila, ngobe mhepo yaka ileyana naswi. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />Tikati tapalama gungwa lipakati kweSilisiya nePhamfiliya, tikaswika kuMayira, imuLisiya. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />Ikweno nlawuli webagwi bengwa wakanowana kepe tjekuAlekizandha tjakatjiyenda kuIthali, akatitanhisa itjo.<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />Takayenda polepole kwemahhuba, tikanoswika zwakalema pawhunde yeSinidasi. Nentha yekuti mhepo yaka isingatibvumile kuti tiyendile mbeli, takayenda tili kundzibo yakasitila yeKhiriti takalingisana neSalimoni. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />Takayipinda zwakalema, tikaswika pabugalo gunoyi Pakasumbikika Pakanaka, pedlo napo kwaka kuna nzi-nkulu weLaseya.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />Saku taka tatjitola lubaka gulefu, pindila mbeli kwaka kusingatjathame ngobe hhuba leyila zodliwa<note caller="+" style="f"><char style="fr" closed="false">27.9 </char><char style="ft" closed="false">Iwhoyu nsi waka ubayapo kubupelo gwaNdlana kene tangisa kwaHhedzi, mulubaka igogu tjimo tjemhepo tjobe tjakayipa kwazo kusingayendike nekepe.</char></note> laka latjipinda, Phawuli akabapa mano, <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />eti, “Botate, ndobona kuti gwendo gowhobe nekukubala nelahikigwa kukulu, kusi kusilahikigwa kwentolo nayitjo kepe koga, koga nebutjilo gwedu bo.” <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />Koga nlawuli webagwi bengwa wakawhilila ntungamili wekepe nemweni wekepe kupinda tjinolebgwa naPhawuli. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />Ngono nentha yekuti panoswikila zwikepe paka pasakalulamila gala po mumbaba, bunji gwebanhu bakati kungin'we mugungwa kuyendiwe, kuti swiyo kungaswikiwa kuFenikisi, panoswikila zwikepe muKhiriti pakalinga kubunandzwa gwakadziba kunohwa hhuba nekuburwa gwakadziba kunohwa hhuba, kuti kugagwe po lubaka gwembaba.<verse eid="ACT 27:12" /></para>
  <para style="s">Dutu Mugungwa</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />Kukati kwafulilidza mhetshwana inobva kuburwa, bekumbula kuti tjababakalingilila tjeyetikala, bakasunungula kepe bakayenda besumha nemhili yeKhiriti. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />Koga nelubakanyana kwakaswika dutu linabuhongola, linoyi bunandzwa-bhehhuba, libva muhango; <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />kukati dutu latjitikulila, kepe tjisingatjatubule yenda tjakalinga kunobva dutu, takaletja tjikayenda sekwatjinosundiwa nemhepo. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />Takati tipinda pakasitigwa netjigwizi tjitukununu tjinoyi Khawuda tikatubula kweba nghoro wekepe, koga zwakalema; <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />bakati batjiwumilidza bakawunsa pehhugwi, bakatola mitjili yawo bakayipombela pakepe; ngentha yekuti baka behla kuti bangalobelela pansetje weSiritisi, bakajitisa tjinomisa kepe, kepe tjikasundiwa nemhepo. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />Dutu lina buhongola laka yendilambeli litigwisa, tjimuka bakatangisa posela ntolo wekepe kuhhe; <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />muhhuba lebutatu bakaposela zwihingiswa zwekepe kuhhe ngemaboko abo. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />Kwakatola mahhuba manjinji kusingabonakale hhuba kene nyenyedzi, kuna dutu lisihoma, galabgwe kwedu kuti towhowana jidzo kwakadza kuka pela.<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />Bakati baba nemahhuba basingadle, Phawuli akamilika pakati kwabo, akati, “Balume, katshene maka mandiwhilila, kuti tisimilike kuKhiriti tobe tisakalahikigwa kakale tisakakubaligwa zwingapa. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />Ndemubudza ke sangwenu, gadzikanani mumimoyo; ngobe akuna unowholahikigwa nebutjilo pakati kwenyu, kuhhe kwekepe nditjo tjinowhopalala. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />Ngobe busiku gwanasi ntome kwangu kwakulimile ntumwa weNdzimu wandili uwe kakale wandinonamata. <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />Wati kundili, ‘Usihle, Phawuli; wakafanila kuti unoma mbeli kwaKhesari. Linga, Ndzimu waba nengoni akatjidza bose ibabo bawunoyenda nabo.’ <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />Ndizo ke gadzikanani mumimoyo balume, nekuti ndina kugalabgwe muNdzimu kuti kowhoyetikala sekwandabudziwa. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />Koga dutu lowhotisundila kutjimwe tjigwizi.”<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />Gwakabe guli busiku gwebugumi lina kuna, tiwunga tisundiwa nedutu mugungwa leAdiriya, banoyendesa kepe bakakumbulila kuti batjibe pedlo nehango. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />Ndizo bakayela gungwa bakawana lidzika kungapa mamitha ali makumi matatu nematanhatu; bakati bati tshelele bakayela kakale bakawana mamitha ali makumi mabili nekutondeka. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />Bakati bohla kuti kwaba pedlo nepana hongwe kusi, bakadelusa kuhule kwekepe zwibhati zwina, bakatembezelela kuti kuyedze. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />Kukati banoyendesa kepe bohaka kuti batihhe babhude mukepe, batjidelusa nghoro bakawunsa mugungwa, beyeta sekunoyi banoposela zwibhati mbeli, <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />Phawuli akati kunlawuli webagwi bengwa nekubagwi bengwa, “Balume ibaba bakasagala mukepe, amungatjile.” <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />Bagwi bengwa bakaba bethubula misungo yaka yakasunga nghoro, bakaletja ukayenda.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />Kukati kweyedza, Phawuli akabakuludzila kuti badle zodliwa, eti, “Nasi ihhuba lebugumi nemana makangolindila musingalonge tjimwe munlomo, kusina tjamadla. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />Ndizo ndomukuludzila kuti mudle zodliwa; ndiko kwamunowhoba nemasimba, saku kusina kene ilo vudzi limun'holo kene wayani pakati kwenyu linowhopalala.” <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />Akati aleba ikoku, akatola tjinkwa, akaboka Ndzimu mbeli kwabo bose akatjipemula akatangisa dla. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />Bose bakakuludzika bakadla bo. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />(Toseni banhu bamukepe taka tili makulu mabili anamakumi ali kutondeka nebatanhatu.<note caller="+" style="f"><char style="fr" closed="false">27.37 </char><char style="ft" closed="false">276</char></note>) <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />Bakati batjidla baguta, bakatapudza ntolo wekepe, belahila zwidlo mugungwa.<verse eid="ACT 27:38" /></para>
  <para style="s">Pwapwatika Kwekepe</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />Kukati kwayedza, basizibe hango iyeyo, koga bakabona kuti kuna nsetje, ndipo pabakakumbulila kuti hapa kubvuma, bamise kepe po. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />Ndizo bakadelusa zwibhati bakazwisiya mugungwa, ngeno besunungula misungo yaka yakabhata migoti inoyendisa kepe; bekotjimilidza jila lambeli kudze mhepo itjisundile kumhili. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />Koga tjakanolobana nensetje wepanohangana makungwa mabili; mbeli kwekepe kukalamba kulimile kusingayende, kuhule kwekepe kukavunika nentha yemabundo evula aka ana buhongola.<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />Bagwi bengwa bakaluka mano kuti babulaye basungwa, swiyo umwe wabo waka angaloba bhamu akatihha; <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />koga nlawuli webagwi bengwa, ehaka tjidza Phawuli, wakabadzibisa thama tjabaka bakumbula. Akabudza baka betubula loba bhamu kuti babhude mukepe kutanga bayende kumavu, <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />bamwe bose batobele bakabhatilila pamakwasayila kene zwipemu zwekepe. Nayiyeyi zila bose bakanoswika pahango beli bapenyu.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">Phawuli ali muMalitha</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />Hule kwekube tatjila, takakoziba kuti tjigwizi itjetjo tjaka tjiyi Malitha. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />Bagali bemuhango iyeyo bakatilakidza bunhu gusakawolobegwa, ngobe bakatiwamutjila tose, bakabesa moto yezo kwaka kwatjitangisa na kakale kupota. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />Phawuli waka ahaka fukatigwa lewhuni, akati edzisa mumoto kukabhuda nyoka yawha pisa ikawumpombela luboko. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />Bagali bemuhango iyeyo bakati bebona tjibandana tjakalembeleka paluboko gugwe, bakati umwe kuwumwe, “Akuna mbhuzo kuti nlume iwhoyu umbulayi. Nekutobe atjila mugungwa, koga ndulamo ayitowumbvumila kuti atjile.” <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />Koga, iye akahahamulila tjibandana mumoto tjikasiwunlume. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />Bakalindila kuti azwimbe kene kuti angowila pasi efa; koga bakati balindila kwelubaka gulefulefu bakabona kusina tjakayipa tjinowunswikila, bakahandula mikumbulo yabo bakati undzimwana.<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />Sangwenu pedlo nebugalo igogo kwaka kuna minda yenlume waka eli he wetjigwizi itjetjo, waka eyi Phabhulasi, wakatiwamutjila ngebunhu akatipa bugalo kwemahhuba matatu. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />Kwakayetikala kuti tate baPhabhulasi baka balilele pasi begwala bugwele gweluhhahhamo nentumbgwana wemahaba; Phawuli akabakumba akatembezela, akati ababiga maboko, bakapola. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />Kukati kwayetikala ikoku, bose banhu mutjigwizi baka bena dzinghwele bakahha bakapolesewa. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />Bakatipa zwipo zwinjinji; nekene toyenda, bakatilongela mukepe kene ini tjinohakika mugwendo.<verse eid="ACT 28:10" /></para>
  <para style="s">Gwendo gwebva muMalitha kuyendiwa kuRoma</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />Hule kwemimwedzi mitatu takamilika takatanha kepe tjekuAlekizandha tjaka tjama patjigwizi itjetjo mulubaka gwembaba, tjaka tjakanamatidziwa mifananidzo yeMaphahla emidzimwana inoyi Khasita naPholakisi, mbeli kwatjo. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />Takama paSiyirakhuse, tikagalapo kwemahhuba matatu. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />Kubva ipapo takayenda ngekepe tikanoswika paRegiyamu; hule kwehhuba lin'ompela kukamilika mhepo inobva kuburwa, muhhuba lebubili takaswika kuPhuteyoli. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />Ipapo takawana bagalimoyo, bakatikumbila kuti tigale nabo kwemahhuba ali kutondeka. Tikakotjiyenda kuRoma. <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />Bagalimoyo bayikoko, bakati bawha nekwedu, bamwe bakabuya bebva kunhanga yetengesela yekuAphiyasi, bamwe bebva kun'umba Dzebezi Nhatu bewhotihanganidza. Phawuli wakati ebabona akaboka Ndzimu, akasima.<verse eid="ACT 28:15" /></para>
  <para style="s">MuRoma</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />Takati taswika kuRoma, Phawuli akabvumigwa gala yega, ana nghwi wengwa wakawunlinda.<verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />Hule kwemahhuba matatu wakadana batungamili bemaJuta panhu pan'ompela; bakati bakubungana, akati kubali, “Makamu angu, nekutobe kusina tjandakatjinya kubanhu bakanyi kwedu kene tjinoleyana nemilenje yabobatategulu bedu, koga ndakasungwa kuJerusalema atugwa mumaboko emaRoma. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />Bakati bandiholesesa, bakayemula ndisunungula, ngobe kwaka kusina nlandu wekuti ndingabulawa. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />Koga maJuta akati alamba, ndikabe nditi ndipindisigwe kuna Khesari, nekutobe ndaka ndisina tjandingatjeta tjaba tjangu natjo. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />Ndiko ikoku kwandakumbilila kuti ndimubone ndilebeleke namwi, saku kuli ngentha yekugalabgwe kwebanhu beIsirayeli kwayeta kuti ndisungwe neketane iyeyi.”<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />Bakati kuwunli, “Akuna whalo dzataka amutjila dzibva kuJudiya dzinoleba nekuko, kakale akuna umwe wehama wakaswika pano akakubudzilila kene leba tjakayipa nekuko. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />Koga toyemula kuti tiwhe nawe tjawunokumbula; ngobe toziba kuti kolebgwa zwakayipa nekwezila iyeyi mubugalo gose.”<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />Bakati babiga hhuba, bakabuya kun'umba kwaaka egala bali banjinji. Akabalondesedzela ndebo iyeyo kubvila mangwanana kudza kunoswika madekwana, epa busupi nekwebumambo gweNdzimu kakale eyedza kuti abatjenesele nekwaYesu kubva munlayo waMozisi nekubva mubalebesambeli. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />Bamwe bakagutshikana nekwaakaleba, koga bamwe abazogalamoyo. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />Ndizo, baka kakabadzana, bakakomilika beyenda hule kwekuti Phawuli aleba ndebo in'ompela. “Meya Yakayengemala yaka yakatambunuka payakati kunlebesambeli Isaya nekwabobatategulu benyu.<verse eid="ACT 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26" />“ ‘Yenda kubanhu ibaba uti,</para>
  <para style="q1" vid="ACT 28:26">wha, mowhowha koga mukasiwhisise;</para>
  <para style="q2" vid="ACT 28:26">nebona, mowhobona koga mukasibonesese.<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />Ngobe moyo webanhu ibaba wati zwi,</para>
  <para style="q2" vid="ACT 28:27">nezebe dzabo dzatjiti tshi,</para>
  <para style="q2" vid="ACT 28:27">nemeho abo bawavululwata.</para>
  <para style="q1" vid="ACT 28:27">Swiyo bangabva bebona nemeho abo,</para>
  <para style="q2" vid="ACT 28:27">bakawha nezebe dzabo,</para>
  <para style="q2" vid="ACT 28:27">kakale bakapedzisisa nemimoyo yabo,</para>
  <para style="q1" vid="ACT 28:27">bakahandukila kundili kuti</para>
  <para style="q2" vid="ACT 28:27">ndibapodze.’ ”<verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />“Zibani ke kuti tjidza kweNdzimu ikoku kwatjiyendesewa kuBataya, banowhowhilila.” <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" /><note caller="+" style="f"><char style="fr" closed="false">28.29 </char><char style="ft" closed="false">Dzimwe Whalo whulukugwi dzeTjiGiriki adzina vesi 29</char></note> [Wakati aleba matama iyawa, maJuta akamilika oyenda, ekakabadzana kwazo.]<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />Wakagalapo kwemakole mabili ahhele egala paanozwilipila, ewamutjila bose baka behha kuwunli, <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />esumikila bumambo gweNdzimu kakale ediya nekwaHe Yesu Khirisitu akahalabvuka asingadzibisiwe.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>