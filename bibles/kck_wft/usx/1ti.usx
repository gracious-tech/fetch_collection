<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Kalanga Bible Translation</book>
  <para style="ide">65001 - Unicode (UTF8)</para>
  <para style="h">1 Thimothi</para>
  <para style="toc1">Lukwalo Gwekutanga gwaPhawuli ekwalila THIMOTHI</para>
  <para style="toc2">1 THIMOTHI</para>
  <para style="toc3">1 Thim</para>
  <para style="mt2">Lukwalo Gwekutanga gwaPhawuli ekwalila</para>
  <para style="mt1">THIMOTHI</para>
  <para style="imt">Tjingiso</para>
  <para style="ip">Lukwalo gwekutanga gwaThimothi gwakakwagwa gubva kumpositoli Phawuli ekwalila ndhiyiwa uwe Thimothi. Lukwalo gwekutanga gwaThimothi kokumbuligwa kuti gwakakwagwa mumakole makumi matanhatu nemabili kunoti kumakole makumi matanhatu nemana hule kwezwagwa kwaKhirisitu. Kokumbuligwa kuti nelubaka igogu gukwagwa butjilo gwaPhawuli gwakabe gwatjibe pedlo nebupelo. Phawuli waka enabukamu gupedlopedlo kwazo naThimothi. Mulubaka gunjinji waka ewundhana eti unkololo uwe. (BaFiliphi 2.22, 1 Thimothi 1.2, 1.18).</para>
  <para style="ip">Whogu ndigo gumwe lukwalo pawhalo dzilina Phawuli dzaakakwalila nhu, dzimwe dzose waka ekwalila makubungano ebagalimoyo. Dzimwe whalo nhatu ndiyedzi 2 Thimothi, Thayithasi, naFilimoni. Mulukwalo gwekutanga gwaThimothi unolaya kuti banhu banganamata Ndzimu tjini bali mugubungano (1 Thimothi 2.1-15), fanilo inohakika kuti nhu abe ntugamili wegubungano (1 Thimothi 3.1-13), netjenjedzo nekwebadiyi bemanyepwa (1 Thimothi 1.3-11, 4.1-5, 6.2-5). Ndima idzedzi dzolakidza kuti Phawuli waka ediya tjini Thimothi kuti abe ntungamili mumakubungano. Lukwalo gwekutanga gwaThimothi guna milenje minjinji ingabhatsha batungamili bemakubungano mumahhuba ano kuti bangatungamila tjini n'hingo mugubungano.</para>
  <para style="iot">Nlongoloso Yezwimukati</para>
  <para style="io1">Phawuli unotanga nelezwa Thimothi (1 Thimothi 1.1-2)</para>
  <para style="io1">Phawuli unotjenjedza Thimothi nekwebadiyi bemanyepwa (1 Thimothi 1.3-11)</para>
  <para style="io1">Phawuli unolondesedza kuti kungentha yeni eboka bukulukulu gwaYesu Khirisitu. (1 Thimothi 1.12-9)</para>
  <para style="io1">Unotobela nelaya Thimothi nekwenamata Ndzimu mugubungano nange pehhugwi kwebatungamili begubungano (1 Thimothi 2-3)</para>
  <para style="io1">Phawuli unofidza lukwalo gugwe nepa Thimothi milayo yebupelo (1 Thimothi 4-6)</para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />Kubva kuna Phawuli mpositoli waKhirisitu Yesu ngelaya kweNdzimu Ntjidzi wedu naKhirisitu Yesu, unobe ali iye kugalabgwe kwedu.<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />Kuna Thimothi nkololo wangu wemalebeswa mubugalimoyo.</para>
  <para style="p" vid="1TI 1:2">Ngoni, nemawhilangoni, nekunyalala kunobva kuNdzimu Tate bedu naKhirisitu Yesu He wedu ngakube nawe.<verse eid="1TI 1:2" /></para>
  <para style="s">Tjenjedzo NeKwezwidiyo Zwemanyepwa</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />Sekwandakakukulumbidza ndiyenda kuMakhedoniya, gala ikweno kuEfesu kuyetila kuti ulaye bamwe banhu kuti basitjadiye zwidiyo zwemanyepwa,<note caller="+" style="f"><char style="fr" closed="false">1.3 </char><char style="ft" closed="false">zwidiyo zwemanyepwa zwakasiyana nezwidiyo zwebapositoli </char><char style="fp" closed="false" /></note> <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />nekuti basibhatikane nekwengano nangelongoloso dzisingapele dzabobatategulu dzinohhisa kakabadzana, pana kuti dziyendisilembeli n'hingo weNdzimu webugalimoyo; <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />tjinangwa tjenlayo iwhoyu kube neludo gunobva mumoyo wakatjena, nemuhana mbuyanana, nebugalimoyo gwelebeswa. <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />Bamwe bakathewuka muzwinhu izwezwi, bekangina mudada. <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />Banoyemula kuti babe badiyi benlayo, koga abatoziba tjabanoleba, nekwabanokowhomesedza abatokuwhisisa.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />Ngwenu toziba kuti nlayo umbuya hapa nhu ewuhingisa nezila yakatambunuka. <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />Toziba ikoku, kuti nlayo awuzobaakanyigwa bakalulama koga wakayetigwa basina nlayo nebasingawhilile, nebasingahle Ndzimu nebatjinyi, nebasakayengemala nebanahambgwa, wakayetigwa banobulaya botatayi nebanobulaya bomayi babo, nebabulayi bebanhu, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />wakayetigwa basingazwibhate, betjilume banowalilana nhobo<note caller="+" style="f"><char style="fr" closed="false">1.10 </char><char style="ft" closed="false">nebetjikadzi banowalilana nhobo</char></note>, banotapa banhu bebatengesa, banoleba manyepwa, banopa busupi gwemanyepwa, kene kumwe zwako kunoleyana nezwidiyo zwakatambunuka. <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />Zwidiyo izwezwi zoyendidzana nendebo mbuya inagudzo leNdzimu wakakombolegwa, iyo yandakagaliwabgwe nekwayo.<verse eid="1TI 1:11" /></para>
  <para style="s">Boka Mawhilangoni eNdzimu</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />Ndoboka Khirisitu Yesu He wedu wakandipa masimba ngobe wakandibona kuti ndogalikabgwe akandihala kuti ndibe mun'hingo uwe, <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />nekene ndakatongoleba zwakayipa nekweNdzimu, ndiwundziyidza ndiwuntuka. Ndakawhigwa ngoni ngobe ndakandikuthama mukusaziba ndilihhele sagalamoyo, <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />nengoni dzaHe wedu dzakaba njinji tjose pehhugwi kwangu, kose nebugalimoyo neludo kumuna Khirisitu Yesu. <verse eid="1TI 1:14" /><verse number="15" style="v" sid="1TI 1:15" />Matama iyawa anogalikabgwe kakale anofanila wamutjigwa, anoti Khirisitu Yesu wakahha muhango kuti ewhotjidza batjinyi. Imi ndimi ntjinyi kupinda bose, <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />koga nentha yayikoku imi ndakawhigwa ngoni, kuti ndizo mundili imi ntjinyi nkulu Khirisitu Yesu alakidze moyonlefu uwe wakapelela kuli tjilakidzilo kuna ibabo banowhogalamoyo muwunli kuti bawane butjilo gusingapele. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />Kakale ngwenu kuna Mambo welubaka gose, usingafe, usingabon'we, iye Ndzimu woga, ngaalemekedzewe kakale akudziwe nekusingapele. Akujalo.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />Thimothi nkololo wangu, ndokupa nlayo iwhoyu kuyendidzana neleba kwebulebesambeli kwakatongolebgwa nekuko, hingisa matama iyawo kudze kuti ugwe ngwa mbuya. <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />Mukuthama ikoku wakafanila bhatilila mubugalimoyo nehana mbuyanana. Bamwe banhu bakapaladza bugalimoyo gwabo nentha yesawhilila hana dzabo. <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />Pakati kwabo kuna Hhemenasi naAlekizanda, bandakapa Satane kudze badiyike kuti basituke Ndzimu.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">Zila Yetembezela muGubungano Lebagalimoyo</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />Tjekutanga ndizo ndokuludzila kuti, kumbila, mitembezelo, netembezelela, neboka kuyetigwe banhu bose, <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />kuyetigwe bomambo nayibo bose bamubugalo gwebutungamili, kuyetila kuti titjile butjilo gwakatebama guhhele kunyalala, gunokudza Ndzimu, gunolemekedzeka munakose. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />Ikoku kubuya, kakale kowamutjilika mbeli kweNdzimu Ntjidzi wedu, <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />iye unoyemula kuti banhu bose batjidziwe kakale bahhe muluzibo gwelebeswa. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />Ngobe kuna Ndzimu un'ompela, nenyayi un'ompela pakati kweNdzimu nebanhu, iye nhu Khirisitu Yesu, <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />iye wakazwipila setjibhayilo tjebanhu bose, busupi gwayikoku gwakabhuda patjena mulubaka gwakafanila. <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />Nentha yayikoku ndakahagwa kuti ndibensumikili nekuba mpositoli kakale ndili ndhiyi webugalimoyo nelebeswa kubataya, ndolebesa anditoleba manyepwa.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />Ndizo ndoyemula kuti mubugalo gose balume batembezele, bakamilidza maboko akayengemala basina buhongola kene kakabadzana. <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />Kakale banhu betjikadzi bazwimbadze zwiyambalo zwibuyanana, zwakatebama kakale zwinalukudzo, basiluke mavudzi abo kunotjenamisa, besimbale man'ina ezeezi kene nendalama nezwiyambalo kunotengwa nemari njinji, <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />koga babe nezwiyeto zwakanaka, zwakafanila betjikadzi banozwiti banohla Ndzimu. <verse eid="1TI 2:10" /><verse number="11" style="v" sid="1TI 2:11" />Banhu betjikadzi ngabadiyike bakanyalala benakuzwitebamisa kwakapelela. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />Anditobvumila kuti nhu wetjikadzi adiye kene kuti abe nemasimba pehhugwi kwenhu wetjilume, ngaanyalale. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />Ngobe ndiAdamu wakatanga bumbiwa kukotobela Eva. <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />Kakale Adamu aazotjebegwa, koga nkadzi iwhoyu ndiye wakatjebegwa akabva abantjinyi. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />Koga nekene kwakajalo unowhotjidziwa ngetshibama mwana, hapa kuli kuti unoyendilambeli mubugalimoyo nemuludo, nangekuyengemala kuna kudzikama.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">Batungamili BemuGubungano</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />Ndebo iyeyi inogalikabgwe. hapa kuna nhu unoyemula ba netjigalo tjentungamili wegubungano, unoyemula n'hingo wakanaka. <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />Ndizo ntungamili wegubungano unofanila ba nhu usingasoleke, nlume unamfumakadzi un'ompela, unozwibhata, unanjele, unolemekedzeka, unotubula wamutjila banhu, unotubula diya. <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />Usingalaladze, usina buhongola koga unamoyo wakatebama, usingade kakabadzana nebamwe, kakale nhu usingade mari. <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />Wakafanila tubula tungamila nzi uwe zwibuyanana, unotjengeta bana babe bezwitebamisa kakale benamazwibhato nezila dzose. <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />Ngobe hapa nhu esingatubule tungamila nzi uwe engatubula tjengeta tjini gubungano leNdzimu? <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />Azofanila kuti abenhu ntjetjana pabugalimoyo, ngobe hapa kwakajalo angazwikudza ekowanikwa nlandu sekwakayetika kuna Satane. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />Wakafanila ba nhu unolebgwa zwakanaka nekukwe nebanhu bakuhhe kwegubungano kuyetila kuti asiwile mutjiliko tjelingigwa pasi nebhakhwa nedati laSatane.<verse eid="1TI 3:7" /></para>
  <para style="s">Batjengeti Banobhatsha Mugubungano Lebagalimoyo</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />Batjengeti bo bakafanila ba banhu banamazwibhato, banhu banalebeswa muleba kwabo, basingan'we wayini njisasa kene banoda mari kwazo. <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />Bakafanila bhatilila mumalebeswa akazumbunugwa nekwegalamoyo kwemakhirisitu benahana mbuyanana. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />Ngabatange baholesesewa, hapa kuli kuti abatowanikwa nlandu ngabahinge sebatjengeti. <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" />Sayikoko bo betjikadzi<note caller="+" style="f"><char style="fr" closed="false">3.11 </char><char style="fq" closed="false">betjikadzi </char><char style="ft" closed="false">bafumakadzi bebatjengeti kene batjengeti betjikadzi</char></note> ngababe banhu banolemekedzeka, basina bun'wa, bakadzikama, banogalikabgwe muzwinhu zose. <verse eid="1TI 3:11" /><verse number="12" style="v" sid="1TI 3:12" />Batjengeti ngababe nlume unamfumakadzi un'ompela, ngababe banhu banotungamila bana babo netungamila mizi yabo zwibuyanana. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />Ngobe banohinga zwibuyanana sebatjengeti bemugubungano banozwiwanila lemekedzewa kakale banowhoba banhu basingahle nekwebugalimoyo gwabo muna Khirisitu Yesu.<verse eid="1TI 3:13" /></para>
  <para style="s">Tjakasumbikika Tjikulukulu tjeBugalimoyo Gwedu</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />Ndogalabgwe kuti ndowhohha kukuli nekutjimbidza, koga ndokukwalila milayo iyeyi kuyetila kuti, <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />hapa ndinganonoka iwe uzibe kuti banhu bakafanila zwibhata tjini mun'umba yeNdzimu inoba ili ilo gubungano leNdzimu unotjila, mhanda nepakasendama malebeswa. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />Topa busupi kuti tjikulu kwazo itjetjo tjakasumbikika tjelunamato gwedu,</para>
  <para style="q1" vid="1TI 3:16">Wakaboneka ali nhu wenyama,</para>
  <para style="q2" vid="1TI 3:16">wakalayidziwa eli wakalulama ngeMeya,</para>
  <para style="q2" vid="1TI 3:16">wakabon'wa nebatumwa beNdzimu.</para>
  <para style="q1" vid="1TI 3:16">Wakasumikigwa munjudzi,</para>
  <para style="q2" vid="1TI 3:16">banhu behango bekagalamoyo muwunli,</para>
  <para style="q2" vid="1TI 3:16">akayendisiwa pehhugwi mugudzo.<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">Badiyi Bemanyepwa</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />Meya inoleba patjena kuti mumahhuba ebupelo bamwe banhu banowhothewuka pabugalimoyo, banowhowhilila meya dzemanyepwa, bakatobela zwidiyo zwemeyambi. <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />Zwidiyo zwakajali zo andamisiwa nebatjengeli bemanyepwa bana hana dzakafa dzinonga dzakapisiwa netshipi inopisa, <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />banodzibisa banhu lobola, bediya kuti zwimwe zodliwa azwitodliwa zwinoba zwakabumbiwa neNdzimu kuti zwiwamutjigwe nekuboka kwayibabo banogalamoyo kakale beziba malebeswa. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />Ngobe kose kwakabumbiwa neNdzimu kwakanaka, akuna tjinofanila lambiwa hapa kuli kuti kowamutjigwa muboka, <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />ngobe kobe kwayengemadziwa nedama leNdzimu nangentembezelo.<verse eid="1TI 4:5" /></para>
  <para style="s">N'hingi Wakanaka WaKhirisitu Yesu</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />Hapa ungadiya milayo iyeyi mbeli kwebagalimoyo, nowhoban'hingi mbuya waKhirisitu Yesu, wakalelegwa mumatama ebugalimoyo, nange muzwidiyo zwibuya zwawunotobela. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />Ugalile kule nengano dzebulengwe nezwilebo zwinasahla Ndzimu. Gala uzwidiya hla Ndzimu. <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />Ngobe zwisimisa mbili kuna gumwe lubhatsho, koga hla Ndzimu kobhatsha muzwinhu zose, ngobe kuna tjigadzabgwe tjebutjilo gwangwenuwali nemubutjilo gunohha. <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />Ndebo iyeyi imalebeswa kakale yakafanila wamutjigwa nemaboko mabili. <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />Ndizo ndiko tihinga zwakabangalala kakale tigwisa nemasimba ose, ngobe galabgwe kwedu takakusa kuNdzimu unotjila, unoba Ntjidzi webanhu bose, bukulu ibabo banogalamoyo.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />Laya kakale udiye zwinhu izwezwi. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />Kusibe nenhu unokulingila pasi nentha yebutjetjana gugo, koga iba tjilakidzilo kubagalimoyo, palebeleka kuko, nezila yawunothama nayo zwinhu, muludo, mubugalimoyo, nemukuyengemala. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />Kuswika ndatjihha, uzwipile balila banhu whalo, nelaya kose nediya. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />Usihayile hanya tjipo tjawunatjo, tjawakawamutjidziwa nebulebesambeli, nelubaka lubahhe gwebawhola pagwakakubiga maboko. <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />Hinga mihingo iyeyi, uyihinge nekuzwipila, kuyetila kuti bose babone bhudilila kuko. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />Uzwitjengete kakale ulondolodze tjawunodiya, ubhatilile muzwinhu izwezwi, ngobe ngethama ujalo nowhozwitjidza iwe nayibabo banokuwha.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s">Zila Yetungamila Bagalimoyo</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />Usitjemele nlumetate whola pakuli nebuhongola, koga uwunkulumbidze sekwawunokulumbidza tate babo. Ubhate balume batjetjana pakuli sekunoyi banun'una babo, <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />betjikadzi bawhola ubabhate sabomeyabo, nebetjikadzi batjetjana sehazwadzi dzidzo ube nemoyo mbuyanana kwazo.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />Lemekedza tjilikadzi dzitjilikadzi kwemalebeswa. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />Koga hapa kuli kuti tjilikadzi ina bana kene bana bebana, bakafanila kuti batange zwidiya hhadzisa nlandu webugalimoyo wezwipila kuna ben'ha wabo, kakale balinge bazwadzi babo saku bazwadzi babo bakabalela bo, ngobe ikoku kowamutjilika mbeli kweNdzimu. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />Tjilikadzi yelebeswa, yatjisala isitjina kene yani, galabgwe kwayo kose yatjikusa kuNdzimu kakale inoyendilambeli ilimuntembezelo ikumbila kuNdzimu siku nesikati. <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />Koga tjilikadzi inotjilila nzipo yakafa nenguba itjila. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />Ubalaye sayikoku kuyetila kuti bawanike bakatjena. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />Hapa kuna nhu usingatjengete hama dzidze, bukulu ben'ha uwe kobva kuti kene bugalimoyo wakagulaha kakale umbi kupinda usingagalemoyo. <verse eid="1TI 5:8" /><verse number="9" style="v" sid="1TI 5:9" />Tjilikadzi inamakole ezwagwa apasi kwemakole makumi matanhatu isikwagwe mulukwalo gwebhatsho, kakale tjilikadzi inokwagwa yakafanila ba yakaba mfumakadzi kunlume un'ompela, <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />kakale yakafanila lebgwa zwakanaka nekwayo inazwiyeto zwibuya selela bana, nebhata bezi zwakanaka, nengudza makumbo ebayengemali, nebhatsha bamumamanikano nezwipila yeta zose zwiyeto zwibuya.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />Koga ke ulambe kwala pasi tjilikadzi njhetjana, ngobe hapa pisa kwelopa kwekulila zwipila kuna Khirisitu dzoyemula lobogwa, <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />nayikoku kodzithama dziwanike nlandu wethubula tjituno tjadzakathama kutanga. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />Kuhhe kwayikoko dzozwidiya busimbe, dzihwa dzipoteleka nemizi, adzitoba simbe koga, pehhugwi kwayikoku dzotendeleka dziyeta bun'wa, neda leba ndebo dzebamwe dzileba zwinhu zwadzisakafanila leba. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />Ndizo ke ndobona kuli hine kuti tjilikadzi njhetjana dzilobogwe dzibe nebana dzitjengete mizi yadzo, dzisipe tjita nkoba wetileba zwakayipa. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />Ngobe dzimwe tjilikadzi dzakatjithewuka dzikatobela Satane. <verse eid="1TI 5:15" /><verse number="16" style="v" sid="1TI 5:16" />Hapa kuna nghalimoyo wetjikadzi<note caller="+" style="f"><char style="fr" closed="false">5.16 </char><char style="ft" closed="false">dzimwe whalo dzoti nlume kene nkadzi kene nlume koga</char></note> una hama dzitjilikadzi, ngaadzibhatshe dzisibe ntolo wegubungano, kudze gubungano litubule bhatsha tjilikadzi kwelebeswa.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />Bawhola banotungamila gubungano nezila yakatambunuka ngabalemekedzewe kwakapamhiwa, bukulu ibabo banobhata n'hingo wesumikila newediya, <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />ngobe lukwalo goti, “Usisunge nlomo wen'ombe inohokola zwidlo,”<note caller="-" style="x"><char style="xo" closed="false">5.18 </char><char style="xt" closed="false"><ref loc="DEU 25:4">Matam 25.4</ref>.</char></note> kakale koyi, “N'hingi wakafanila lipiwa mbhayilo uwe.”<note caller="-" style="x"><char style="xo" closed="false">5.18 </char><char style="xt" closed="false"><ref loc="LUK 10:7">Luk 10.7</ref>.</char></note> <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />Usibvume bon'wa nlandu kwewhola kuhhe kwekuti kuna busupi gunobva kubanhu babili kene batatu. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />Koga ibabo banolambila mumatjinyo ubatjemele mbeli kwebanhu, kuyetila kuti bamwe bose bahle.<verse eid="1TI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21" />Ndokulaya mbeli kweNdzimu naKhirisitu Yesu nebatumwa beNdzimu bakahalugwa kuti utjengete milayo iyeyi, usingahalawule kakale usingamile nhu. <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />Usitjimbidze biga nhu maboko, kene wanikwa uhanganyila mumatjinyo ebamwe banhu, uzwitjengete ulimbuyanana.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />Tjiletja n'wa vula yoga, hingisa wayini homanana kuyetila ntumbu uwo saku ugala ugwala.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />Matjinyo ebamwe banhu apatjena anobatangila noswika kubugalo gwetongewa, koga matjinyo ebamwe anowhobhuda patjena mumahhuba anohha. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />Nayiyeyo zwayo zila zwiyeto zwakanaka zoboneka patjena, nekene zwisipatjena azwingasumbikike tjatjose.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />Bose bamujogwe lebulanda bakafanila bona bobatezi babo sebakafanigwa nelemekedzewa kuhhele, kuyetila kuti zina leNdzimu nediya kwedu kusilengudziwe. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />Ibabo bana bobatezi banogalamoyo basibalingile pasi nentha yekuti batjiba hama, koga bakafanila bahingila kwazo ngobe ibabo babanohingila bagalimoyo kakale badikani.</para>
  <para style="s" vid="1TI 6:2">Zwidiyo Zwemanyepwa Nefumwa Yemalebeswa</para>
  <para style="p" vid="1TI 6:2">Diya kakale ubakuludzile nekwezwinhu izwezwi. <verse eid="1TI 6:2" /><verse number="3" style="v" sid="1TI 6:3" />Hapa kuna nhu unodiya zwidiyo zwemanyepwa esingabvumilane nematama emalebeswa aHe wedu Yesu Khirisitu nezwidiyo zwinoyendidzana nehla Ndzimu, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />unoba alihhele zwikudza, kakale akuna tjaanoziba, unhu unoda nyanyayidzana kusina bhenyu, nekakabadzana nekwematama kunozwala ndandala, negwa, netukana nekumbulilana zwinhu zwakayipa, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />nekwebelana kusingapele pakati kwebanhu banamikumbulo yakaleleka bakalahikigwa nemalebeswa banokumbula kuti namata ndiyo zila yewana bufumi.<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />Koga namata ulihhele gutshikana kopa mbhayilo nkulunkulu, <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />ngobe akuna tjatakahha natjo munayeyi hango kakale towhobhuda muhango iyeyi tisina tjatakasenga. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />Koga hapa tina zodliwa nezwiyambalo, ikoku kwakafanila tigutsha. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />Koga ibabo banohaka fuma banowila mukulikwa, nemudati lenjemulo njinji dzebulengwe dzinokubadza, dzinoyeta nhu akakolomoka kakale akapalala. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />Ngobe da mari ndiwo ndzi webubi gose, kungentha yeda mari bamwe bakathewuka muzila yebugalimoyo, bakazwikokela buyendasi gunjinji mumimoyo yabo.<verse eid="1TI 6:10" /></para>
  <para style="s">Layiwa Kwakanangana naThimothi</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />Koga iwe, nhu weNdzimu, ibva muna kose ikoku; gwisa kuti ube nekululama, nehla Ndzimu, nebugalimoyo, neludo, nemoyonlefu, nekutebama. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />Igwa ngwa mbuya yebugalimoyo, ubhatilile mubutjilo gusingapele igo gwawakadanigwa pawakatula bvuma kubuya mbeli kwebasupi banjinji. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />Mbeli kweNdzimu iye unopa zwinhu zose butjilo, nambeli kwaKhirisitu Yesu wakatula bvuma kubuya mubusupi gugwe gwaakatula mbeli kwaPhontiyu Pilatu, <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />ndokulaya kuti ulondolodze nlayo nezila yakatjena usingawanikwe nlandu kuswikila He wedu Yesu Khirisitu eboneka. <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />Bon'wa kukwe kowhozumbunugwa nelubaka gwakafanila newakakombolegwa, Ntongi uyega, Mambo wabomambo, kakale ali He wabohe. <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />Iye yega usingake akafa, kakale egala mutjedza tjisingake tjikaswikiwa patjili, akuna nhu wakatongowumbona kene ungawumbona. Ngaalemekedzewe kakale atonge nekusingapele. Akujalo.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />Ibabo bakafuma muhango iyeyi ubalaye kuti basizwikudze kakale basigalebgwe mufumwa dzisina malebeswa, koga bagalebgwe kuNdzimu unotipa nekuhhele kose kuti tihanhe. <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />Ubalaye kuti bayete zwakanaka babe nezwiyeto zwakanaka zwinjinji, bape kakale bazwipile kobela fumwa yabo bamwe. <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />Nayiyeyo zila banoba bezwibigila fumwa inowhoba mbviwa yelubaka gunohha kuti ndizo bawane butjilo gwemalebeswa.<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />Iwe Thimothi londolodza tjawakapiwa. Thubukana nendebo dzebulengwe nehambgwa, nesahla Ndzimu nekakabadzana nekwayikoku kunoyi luzibo kunyepewa. <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />Bamwe pabakakuwamutjila bakabva bathewuka muzila yebugalimoyo.</para>
  <para style="p" vid="1TI 6:21">Ngoni ngadzibe namwi mose.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>