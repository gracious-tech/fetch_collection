<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Kalanga Bible Translation</book>
  <para style="h">Matewu</para>
  <para style="toc1">NDEBO MBUYA SEKWAGWA KWAYO MATEWU</para>
  <para style="toc2">Matewu</para>
  <para style="toc3">Mat</para>
  <para style="mt2">Ndebo Mbuya sekwayakakwagwa</para>
  <para style="mt1">ndiMATEWU</para>
  <para style="imt">Tjinginiso</para>
  <para style="ip">
    <char style="bk">Ndebo Mbuya sekwagwa kwayo ndiMatewu </char> gumwe lukwalo gwewhalo dzilina dzeThesitamente Ndzwa dzinoleba nekwebutjilo gwaYesu Khirisitu. Gumwe negumwe lukwalo goyi “ndebo mbuya,” whalo idzedzi dzakakwagwa naMatewu, naMako, naLuka naJohane hule kwefa kwaYesu. Bazibi abana luzibo kuti lukwalo igogu Matewu wakagukwala lini ntjantja, koga kungaba makole ali makumi ali kutanhatu hule kwezwagwa kwaKhirisitu. Kakale akutozibgwa kuti wakagukwala ali poni, koga banjinji banokumbulila kuti wakagukwala ali muhango yePhalisitani pamwe kakale eli munzi-nkulu weJerusalema.</para>
  <para style="ip">
    <char style="bk">Matewu</char> ndiye nkwali, waka ali nketisi esanhu akadan'wa naYesu kuti abe ndhiyiwa. Limwe zina lile laka liyi Levi. Waka ali umwe weBapositoli bali gumi nebabili kakale ekwalila batungamili beMaJuta. Ikoku koboneka ngobe wakatondeka muwhalo dzinopinda makumi alikutanhatu dzeThesitamente whulukugwi. Waka ehaka layidza kuti Yesu ndiye Mesiya, ntjidzi wakahagwa neNdzimu, kwaka kulebesewambeli nekukwe. Matewu wakakwala zwinjinji nekwebumambo gweNdzimu. MaJuta aka ekumbula kuti Mesiya unowhoba mambo webumambo gwezwetongwa kwehango. Matewu unogwisana nebugalimoyo igogo ngetjenesa nekwebumambo gweNdzimu.</para>
  <para style="ip">
    <char style="bk">Ndebo Mbuya sekwagwa kwayo ndiMatewu </char> lukwalo gwakanakila tangisa Thesitamente Ndzwa nentha yebutondeki gwago kuThesitamente whulukugwi. Bazibi banokumbulila kuti Matewu waka eyedzelela kwagwa kwewhalo dzaMozisi, whalo hanu dzekutanga dzeThesitamente Whulukugwi. Sumikila kwaYesu eli kuDombo (Matewu ` kungafananisiwa neNdzimu paaka epa Mozisi nlayo (Matama 19.3-23.33).</para>
  <para style="iot">Nlongoloso Yezwimukati</para>
  <para style="io1">Matewu unotangisa ndebo mbuya ngeleba nekwezwagwa kwaYesu Khirisitu netangisa kwen'hingo uwe (Matewu 1.1-4.25).</para>
  <para style="io1">Matewu unoleba nekwen'hingo waYesu nediya kukwe kunjinji (Matewu 5.1-25.46).</para>
  <para style="io1">Tjikamu tjebupelo tjelukwalo gwaMatewu tjoleba nekwen'hingo waYesu mukufa kukwe nemuka kubafi (Matewu 26.1-28.20).</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Ludzi gwaYesu Khirisitu</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luka 3.23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Lukwalo gunolondesedza ludzi gwaYesu Khirisitu nkololo waDavida, nkololo waAbhurahhamu.<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />Abhurahhamu wakazwala Isaka, Isaka ali tate baJakobe, Jakobe ali tate baJuda nebakuluyi nebanun'una babe, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Juda ali tate baFarezi naZera ebazwala nenkadzi unoyi Thamara, Pherezi ali tate baHhezironi, Hhezironi ali tate ba Aramu; <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />Aramu ali tate ba Aminadabhu, Aminadabhu ali tate baNashoni, Nashoni ali tate baSalimoni, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Salimoni ali tate baBhowazi ewunzwala naRahhabhu, Bhowazi ali tate ba Obhedi ewunzwala naRuthi, Obhedi ali tate baJese, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Jese ali tate bamambo Davida.</para>
  <para style="p" vid="MAT 1:6">Davida waka ali tate baSolomoni, ewunzwala nenkadzi waka ali nkadzi wa Uriya <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />Solomoni ali tate baRehobhowamu, Rehobhowamu ali tate ba Abhija, Abhija ali tate ba Asafu, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />Asafu ali tate baJehoshafati, Jehoshafati ali tate baJoramu, Joramu ali tate ba Uziya, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Uziya ali tate baJothamu, Jothamu ali tate ba Ahazi, Ahazi ali tate baHezekhiya, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Hezekhiya ali tate baManase, Manase ali tate ba Amoni<note caller="+" style="f"><char style="fr" closed="false">1.10 </char><char style="ft" closed="false">dzimwe whalo dzoti</char></note>, Amoni<note caller="+" style="f"><char style="fr" closed="false">1.10 </char><char style="ft" closed="false">dzimwe whalo dzoti</char></note> ali tate baJosiya, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Josiya ali tate baJekhoniya nebakuluyi nebanun'una babe mulubaka gwetapwa beyendisiwa kuBhabhiloni.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Hule kwetapwa beyendisiwa kuBhabhiloni Jekhoniya wakazwala Sheyalithiyeli, Sheyalithiyeli ali tate baZerubhabheli, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Zerubhabheli ali tate ba Abhiyudi, Abhiyudi ali tate ba Eliyakhimu, Eliyakhimu ali tate ba Azo, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />Azo ali tate baZadoku, Zadoku ali tate ba Akhimu, Akhimu ali tate ba Eliyudi, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Eliyudi ali tate ba Eliyaza, Eliyaza ali tate baMathani, Mathani ali tate baJakobe, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Jakobe ali tate baJosefa, nlume waMariya, iye wakatshibama Yesu unoyi Khirisitu.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Ndizo kubvisila kuna Abhurahhamu kunoswika kunaDavida, zwizekugwana zose zwaka zwili gumi nezwina, kubvila kuna Davida kunoswika lubaka gwetapwa beyendisiwa kuBhabhiloni, zwizekugwana zwili gumi nezwina, kubvila pakutapwa beyendisiwa kuBhabhiloni kunoswika pakuzwagwa kwaKhirisitu zwizekugwana zwili gumi nezwina.<verse eid="MAT 1:17" /></para>
  <para style="s">Zwagwa kwaYesu</para>
  <para style="r">(<ref loc="LUK 2:1-7">Luka 2.1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Ndizo zwagwa kwaYesu Khirisitu kwakaba nayeyi zila. Mme babe Mariya waka ewhobhikila kuna Josefa, besanhu batongoyizela bose, waka wan'wa akazwisenga mimba yeMeya Yakayengemala. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Josefa atjibe nlume uwe, ali nlume wakatambunuka asingade wumbhatisa honi mutjaba, wakaba nenkumbulo welambana naye banhu besingazibe. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Etja alakana nekwako, wakahhigwa newoloto, wakawolota ntumwa waHe eti kuwunli, “Josefa, nkololo waDavida, usihle tola Mariya abe nkadzi uwo. Ngobe wakazwisenga mimba yeMeya Yakayengemala. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Unowhotshibama nkololo, uwuntumile zina linoyi Yesu. Unowhotjidza banhu babe mumatjinyo abo.”<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Kose ikoku kwakayetikala kuti kuhhadzisike tjakalebgwa naHe ngenlebesambeli, eti, <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“Bona! mhandala inowhozwisenga, ikatshibama nkololo, zina lile lowhoyi Imanuweli” (kunobva kuti, “Ndzimu unaswi”).<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Josefa akamuka muwhope, akatobela tjaalayiwa nentumwa waHe, akatola nkadzi uwe; <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />azotongongina mungubo naye akadza akatshibama nkololo. Josefa akawuntumila zina linoyi Yesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Bezi banobva kuBhehhuba</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Kwakati pakuzwagwa kwaYesu muBhethelehhema, muntunhu weJudiya, mulubaka Hherodi ali iye mambo, kwakaswika muJerusalema batjenjebvu baka bebva kubhehhuba. <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />Beti, “Uponi iye wazwagwa ali Mambo wemaJuta? Tabona nyenyedzi iye kubhehhuba, tahha kuwhowunamata.”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Mambo Hherodi ekuwha ikoku, kwakawumanikanya, kan'ompela nebanhu bose bemuJerusalema. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Waka kubunganya bose baphirisiti bakulu nebakwali, akababhuzwa kuti Khirisitu unowhozwaligwa poni.<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />Bakawun'handula beti, “MuBhethelehhema leJudiya, ngobe kwaka kwagwa nenlebesambeli kuti.<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />“ ‘Nawebo Bhethelehhema, hango yaJuda,</para>
  <para style="q2" vid="MAT 2:6">awuta ntukununu pabatungamili baJuda,</para>
  <para style="q1" vid="MAT 2:6">ngobe mukuli kowhobhuda ntungamili</para>
  <para style="q2" vid="MAT 2:6">unowholisa banhu bangu banoyi Isirayeli.’”<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Hherodi wakakodanila ntome batjenjebvu, akawha kubva kubali kuti nyenyedzi yabonakala gupi lubaka. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Wakati kubali, “Yendani kuBhethelehhema munohakisisa nekwemwana iwhoyo, hapa muwuwana, mundibudze, kuyetila kuti nami bo ndiyende ndinowunamata.”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Bakati batjiwha matama amambo, baka yenda, bakabona iyeyiya nyenyedzi yabaka babona kubhehhuba yakabatungamila, ikadza ikanoma pehhugwi kwayipapo kwaka kuna mwana. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Bakati beyibona nyenyedzi bakahanha kupindisisa; <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />bakangina mun'umba bakabona mwana enaMariya, meyabe, bakapfigama bakakotana bakawunamata, bakahhula whomo dzabo bakawumpa zwipo, zeezi nenyonje nemafuta anonhuwilila anoyi mure.<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />Hule kwekuti Ndzimu abalaya ngewoloto kuti basibgwilile kuna Hherodi, bakabgwilila kuhango yabo neyimwe zila.<verse eid="MAT 2:12" /></para>
  <para style="s">Tihhila ku Igipita</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Batjiyenda, ntumwa waHe wakaswika kuna Josefa ngewoloto, eti, “Milika, tola mwana nameyabe, mutihhile ku Igipita, mugale ko ndidze ndikubudze uyeteni, Hherodi unovima mwana kuyetila kuti awumbulaye.”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Wakamuka, akatola mwana namayi busiku, akayenda ku Igipita, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />wakagala ikweno Hherodi akadza akatjinyika, kuti kuhhadzisike tjakalebgwa naHe ngenlebesambeli, eti, “Ndakadanila Nkololo wangu kuhhe kwe Igipita.”<verse eid="MAT 2:15" /></para>
  <para style="s">Bulawa kwebana</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Hherodi atjibona kuti batjenjebvu bawuntjengela, wakamon'wa kwazo, akatumila whi linoti kubulayiwe bose bana betjilume, muBhethelehhema nemuntunhu iwhoyo wose banamakole mabili kuyenda pasi. Igogu lubaka gwakaguyendidzana nelubaka batjenjebvu pabakabona nyenyedzi, sebudza kwabo Hherodi.<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />Ipapo kwakahhadzisika tjakalebgwa nenlebesambeli Jeremiya, eti,<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“Kwakawhakala guwo</para>
  <para style="q2" vid="MAT 2:18">munzi-nkulu weRama,</para>
  <para style="q1" vid="MAT 2:18">Rasheli elilila bana babe;</para>
  <para style="q2" vid="MAT 2:18">elamba nyaladziwa,</para>
  <para style="q2" vid="MAT 2:18">ngobe batjibulawa.”<verse eid="MAT 2:18" /></para>
  <para style="s">Bgwilila kwabo bebva ku Igipita</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Kwakati Hherodi atjifa, ntumwa waHe akaswika ngewoloto kunaJosefa ku Igipita, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />eti, “Muka utole mwana nameyabe, uyende kuhango ye Isirayeli, batjifa baka bevima butjilo gwemwana.” <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Wakamilika etola mwana namayi, akabgwilila kuhango ye Isirayeli.<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />Koga wakati ewha kuti Akhelasi unotonga hango yeJudiya mubugalo gwatatayi Hherodi, wakahla yenda ko. Wakati atjilumwa zebe muwoloto, akayenda akanogala muntunhu weGalile, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />wakagala munzi-nkulu unoyi Nazaretha, kuyetila kuti kuhhadzisike tjakalebgwa nebalebesambeli, kuti, “Unowhodan'wa eyi Nanzarini.”<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Sumikila kwaJohane Mbvubiki</para>
  <para style="r">(<ref loc="MRK 1:1-8">Mako 1.1-8</ref>; <ref loc="LUK 3:1-18">Luka 3.1-18</ref>; <ref loc="JHN 1:19-28">Johane 1.19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Mumahhuba iyawo kwakahha Johane mbvubiki, esumikila mutjilambanyika tjeJudiya, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />eti, “Handukani, ngobe bumambo gwekudzimu gwatjisedzela.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Ngobe ndiye wakalebgwa nekukwe nenlebesambeli Isaya, eti,</para>
  <para style="q1" vid="MAT 3:3">“Whi lewunomimila mutjilambanyika,</para>
  <para style="q2" vid="MAT 3:3">‘Baakanyani zila yaHe,</para>
  <para style="q2" vid="MAT 3:3">mutambunudze zidlana dzidze.’ ”<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Johane waka ena tjiyambalo tjebukuse gwekamela panhunji enamwandabula wegukuta; waka edla mhaho nebutji gwemuhango. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Banhu bemuJerusalema bose nebemuJudiya bose, nebemuntunhu wose umuwhunde yaJorodani bakabhuda bakayenda kuwunli. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Wakababvubika mugwizi gunoyi Jorodani, hule kwebvuma matjinyo abo.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Koga wakati ebona baFarisi nebaSadusi banjinji behha kuti ewhobabvubika, akati kubali, “Imwi bana benyoka, ndiyani wamutjenjedza kuti mutihhe buhongola gunohha? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Ibani nezwiyeto zwinolakidza handuka. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Kusiswike mumuli nkumbulo unoti, ‘Tina Abhurahhamu, ndibo tate bedu.’ Ndoti kumuli, ‘Ndzimu unotubula thama bana ba Abhurahhamu nemabgwe iyawa.’ <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Kakale dumulo latjibigwa kale pamidzi yemiti. Umwe newumwe nti usingazwale mitjelo yakanaka unotemewa, ukaposegwa mumoto. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Imi ndomubvubika muvula ndilayidza kuti mahanduka. Koga iye unohha hule kwangu unamasimba kundipinda, wandisakalizanila senga hangu dzidze; unowhomubvubika neMeya Yakayengemala nange moto. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Wakabhata luselo gugwe gwewulusa, kakale unowhosiya kusina tjiyapo palutombo gugwe, akakubunganya zwidlo esa mudula lile, koga bunye unowhogupisa mumoto usingadzimike.”<verse eid="MAT 3:12" /></para>
  <para style="s">Bvubikiwa kwaYesu</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mako 1.9-11</ref>; <ref loc="LUK 3:21">Luka 3.21</ref>,<ref loc="LUK 3:22">22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Kwakabva kuswika Yesu ebva kuGalile, pagwizi gunoyi Jorodani, kuti Johane awumbvubike. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Koga Johane wakayedza wundzibisa, eti, “Imi ndohaka kuti ndibvubikiwe nawe, koga iwe nohha kundili?”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Koga Yesu ehandula, wakati, “Ngakujalo kwangwenu; ngobe kwakatilizanila kuti tihhadzise ndulamo yose.” Johane akaba ebvuma.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Yesu atjibvubikiwa, wakabva abhuda muvula tjinyolotjo, kudzimu kwakahhuka, akabona Meya yeNdzimu ijita senjiba, ikadelukila pawunli; <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />nayigogo lubaka, whi likabva kudzimu, liti, “Iwhoyu uNkololo wangu wandinoda, muwunli ndina kuhanha.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Likwa kwaYesu</para>
  <para style="r">(<ref loc="MRK 1:12">Mako 1.12</ref>,<ref loc="MRK 1:13">13</ref>; <ref loc="LUK 4:1-13">Luka 4.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Meya yakatungamilila Yesu kutjilambanyika kuti anolikiwa nasatane. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Hule kwekuti atjiyila zodliwa kwemahhuba ali makumi mana, siku nesikati, wakawha hhala. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Nliki wakahha kuwunli, akati, “Sayikoku uli Nkololo weNdzimu, laya mabgwe iyawa kuti ahanduke abe zwinkwa.”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Koga wakahandula eti, “Kwakakwagwa kuti, ‘Nhu atowhotjila netjinkwa tjoga, koga ngelimwe nelimwe dama linobhuda munlomo weNdzimu.’ ”<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Satane akakowuntola akawuyendisa kunzi-nkulu wakayengemala; akawunghadza patjilungwane tjethempeli, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />eba eti kuwunli, “Hapa uli Nkololo weNdzimu, uzwiposele pasi, ngobe kwakakwagwa kuyi,</para>
  <para style="q1" vid="MAT 4:6">“ ‘Unowholaya batumwa babe nekuko,</para>
  <para style="q2" vid="MAT 4:6">banowhokubhata mumaboko abo</para>
  <para style="q2" vid="MAT 4:6">kuyetila kuti usikunhiwe nebgwe.’ ”<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yesu wakati kuwunli, “Kwakakwagwa kakale kuti, ‘Usilike He Ndzimu uwo.’ ”<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Satane akawuntola kakale, akawunsa pehhugwi kwedombo lefulefu, akawulakidza bumambo gwehango dzose kose negudzo lago. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Eba eti kuwunli, “Kose ikoku ndowhokupa, hapa ungandikotamila ukandinamata.”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Yesu eba ehandula eti, “Yenda kutjena Satane! kwakakwagwa kuti, ‘Nowhonamata He Ndzimu uwo, iye yega ndiye wawunowhohingila.’ ”<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Satane akawunsiya, batumwa beNdzimu bakahha bakawumbhatsha.<verse eid="MAT 4:11" /></para>
  <para style="s">Yesu Unotangisa N'hingo Uwe muGalile</para>
  <para style="r">(<ref loc="MRK 1:14">Mako 1.14</ref>,<ref loc="MRK 1:15">15</ref>; <ref loc="LUK 4:14">Luka 4.14</ref>,<ref loc="LUK 4:15">15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Yesu wakati ewha kuti Johane wakasungwa eba eyenda kuGalile, <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />ebva muNazaretha wakanogala muKhaphenawume ntome kwegungwa, muntunhu waZebhuloni naNafithali, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />kuyetila kuti kuhhadzisike tjakalebgwa nenlebesambeli Isaya, eti,<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Hango yaZebhuloni nehango yaNafithali,</para>
  <para style="q2" vid="MAT 4:15">tjekugungwa, seli yaJorodani,</para>
  <para style="q2" vid="MAT 4:15">Galile yeBataya,<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />banhu baka baligele muhhalima</para>
  <para style="q2" vid="MAT 4:16">batjibona tjedza tjikulu,</para>
  <para style="q1" vid="MAT 4:16">kose nayibabo bagele muntunhu nemuntuzi welufu,</para>
  <para style="q2" vid="MAT 4:16">tjedza tjatjiswika kubali.”<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Kubvila ipapo Yesu wakatangisa sumikila eti, “Handukani, ngobe bumambo gwekudzimu gwatjisedzela.”<verse eid="MAT 4:17" /></para>
  <para style="s">Yesu Unodana Bateyi bewhobe</para>
  <para style="r">(<ref loc="MRK 1:6-20">Mako 1.6-20</ref>; <ref loc="LUK 5:1-11">Luka 5.1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Eyenda muwhunde yegungwa leGalile, wakabona nkuluyi nenun'una betjilume, Simoni unoyi Phethiro na Andhireya, beposela njanga mugungwa; ngobe beli bateyi bewhobe. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Eba eti kubali, “Munditobeleni, ndowhomuthama babhati bebanhu.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Bakabva basiya njanga dzabo, bakawuntobela.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Epindilambeli, wakabona bakololo baZebhedi, Jakobe nenun'una uwe Johane, beli mukepe naZebhedi tate babo, bepfuma njanga dzabo, akabadana. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Bakabva basiya tatayi kose nekepe, bakawuntobela.<verse eid="MAT 4:22" /></para>
  <para style="s">Yesu Unodiya, Unosumikila kakale Unolapa</para>
  <para style="r">(<ref loc="LUK 6:17-19">Luka 6.17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yesu wakayenda muGalile yose, ediya mumasinagogu abo kakale esumikila ndebo mbuya yebumambo kakale elapa gose ludzi gwebugwele negwala kwebanhu kose. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Siriya yose yakawha nekukwe, banhu bakahhisa kuwunli bose baka begwala, begwadziwa nenghwele dzakasiyana siyana nemagwadzo akasiyana siyana, bagegwe nemeyambi, banabugwele gwezwifafa, bakalobgwa nebugwele gwegulukadzi, akabalapa. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Wakatobegwa nemabunga manjinji ebanhu banobva kuGalile, banobva kumizi-mikulu ili gumi inoyi Dikapolisi, banobva kuJerusalema neJudiya, nebanobva seli yaJorodani.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Zwidiyo zwekuDombo</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Yesu ebona mabunga ebanhu, wakatanha padombo, atjigala pasi badiyiwa babe bakahha kuwunli. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Wakahhula nlomo uwe akabadiya.<verse eid="MAT 5:2" /></para>
  <para style="s">Kombolegwa</para>
  <para style="r">(<ref loc="LUK 6:20-23">Luka 6.20-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />Eti, “Bakakombolegwa bahayi mumeya,</para>
  <para style="q2" vid="MAT 5:3">ngobe tjabo bumambo gwekudzimu.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Bakakombolegwa banolila,</para>
  <para style="q2" vid="MAT 5:4">ngobe banowhonyaladziwa.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Bakakombolegwa banamimoyo minyolo,</para>
  <para style="q2" vid="MAT 5:5">ngobe banowhogala nhaka yehango.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Bakakombolegwa banahhala nenyota yendulamo.</para>
  <para style="q2" vid="MAT 5:6">Ngobe banowhogutshiwa.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Bakakombolegwa bana mawhilangoni,</para>
  <para style="q2" vid="MAT 5:7">ngobe banowhowamutjila mawhilangoni.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Bakakombolegwa bana moyo ntjena,</para>
  <para style="q2" vid="MAT 5:8">ngobe banowhobona Ndzimu.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Bakakombolegwa bawanguli.</para>
  <para style="q2" vid="MAT 5:9">Ngobe banowhodan'wa beyi bakololo beNdzimu.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Bakakombolegwa ibabo banodziyidziwa nentha yendulamo,</para>
  <para style="q2" vid="MAT 5:10">ngobe tjabo bumambo gwekudzimu.”<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />“Makakombolegwa hapa banhu bemutuka, bemudziyidza, beleba kose kwakayipa nekwenyu, benyepa, nentha yangu. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Hanhani mupululudze, ngobe mbhayilo wenyu unkulunkulu kudzimu, ngobe nayeyi zila banhu bakadziyidza balebesambeli bakahha kumutangila.”<verse eid="MAT 5:12" /></para>
  <para style="s">Mumunyu Netjedza</para>
  <para style="r">(<ref loc="MRK 9:50">Mako 9.50</ref>; <ref loc="LUK 14:34">Luka 14.34</ref>,<ref loc="LUK 14:35">35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />“Mumunyu wehango; koga hapa munyu usingatjawhakale bumunyu, bumunyu gwawo gungamusidzigwa tjini wali? Awutjina n'hingo, wenolahigwa kuhhe koga ukatshambiwa zwawo nebanhu.”<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />“Mutjedza tjehango. Nzi-nkulu wakabakiwa pehhugwi kwedombo awutosumbikika. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Kakale awungabesedzele tjivoneko, ukotjifumika netundu, koga notjibiga pehhugwi patjena; kudze tjivonekele bose bamun'umba. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Netjedza tjenyu ngatjipenye kubanhu, kuyetila kuti babone mihingo yenyu yakanaka kakale bape Tate benyu bakudzimu gudzo.”<verse eid="MAT 5:16" /></para>
  <para style="s">Diya nekweNlayo</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />“Musikumbule kuti ndakahhila whokolomola nlayo kene balebesambeli; andizohhila whopaladza, koga kuti ndiwhokuhhadzisa. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Ngobe lebeswa, ndoti kumuli, kuswikila kudzimu nehango kupinda, akuna kene don'we kene bala dukununu lakakwagwa muNlayo linowhodzima, kudzina kose kuhingikala. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Yani nayani unowhonyebesa umwe wayeyi milayo mitukununu, kakale ewhodiya banhu kujalo, unowhoba ntukunu mubumambo gwekudzimu; koga yani nayani unowhoyitobela kakale eyidiya, unowhoba nkulu mubumambo gwekudzimu. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Ndoti kumuli, kuhhe kwekuti lulama kwenyu kupinda lulama kwebakwali nebaFarisi, amutowhongina mubumambo gwekudzimu.”<verse eid="MAT 5:20" /></para>
  <para style="s">Diya Nekwebuhongola</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />“Makawha kuti kubanhu bantolo kwakayi, ‘Usibulaye; kene yani unobulaya unowhotongewa.’ <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Koga ndoti kumuli wose nhu wagwadziligwa gamu lile unowhotongewa; unotuka gamu lile unowhoyendisiwa kulubahhe; unowhoti kugamu lile, ‘Tjilengwe,’ unowhoposegwa mumoto wegehena. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Hapa kuli kuti nohhisa tjipo patjibeso, ukotjikumbula kuti kuna gamu lilo lisingawililane nawe, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />siya tjipo tjitjo ntome kwetjibeso, uyende unolebelesana negamu lilo kutanga, ukotjihanduka uwhopa tjipo tjitjo.”<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />“Tjimbidza upedze sawililana newunokutilika nlandu, mutjimuzila muyenda kulubahhe, ngobe wakusungisa akakuyendisa kuntongi, ntongi angakuyendisa kugombgwa, ukaposegwa mujele. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Lebeswa ndoti kukuli, awutowhobhuda udza ulipa peni yebupelo.”<verse eid="MAT 5:26" /></para>
  <para style="s">Diya nekweBupombgwe</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />“Matjiwha kuti kwakayi, ‘Usite bupombgwe.’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Koga ndoti kumuli wose nhu unolinga mfumakadzi ewuntjiba wata bupombgwe kale naye mumoyo uwe. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Ndizo hapa hhiho lilo leludli likuta kuti utjinye, ulikopole, ulilahe. Kuhine kuti ulahikigwe nendungululo yembili in'ompela pana kuti mbili wose uposegwe mugehena. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Hapa luboko gugo gweludli gukuthama kuti utjinye, uguthubule, ugulahe. Kuhine kuti ulahikigwe nendungululo yembili in'ompela pana kuti mbili wose uposegwe mugehena.”<verse eid="MAT 5:30" /></para>
  <para style="s">Diya Nekwelambana</para>
  <para style="r">(<ref loc="MAT 19:9">Matewu 19.9</ref>; <ref loc="MRK 10:11">Mako 10.11</ref>,<ref loc="MRK 10:12">12</ref>; <ref loc="LUK 16:18">Luka 16.18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />“Kwakalebgwa kakale kuti, ‘Kene yani unolambana nenkadzi uwe, ngawumpe lukwalo gwelambana.’ <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Koga ndoti kumuli, wose unolambana nenkadzi uwe, kuhhe kwekuti ata bupombgwe, unowunta mhombgwe; kakale kene yani unotola nkadzi wakatatiwa unota bupombgwe.”<verse eid="MAT 5:32" /></para>
  <para style="s">Diya Nekwetuna</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“Kakale makawha kuti kwakayi kubanhu bantolo, ‘Usikon'we hhadzisa tuna kuko, koga uhhadzise kuna He kose tuna kuko.’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Koga ndoti kumuli, musitongogala matuna, musitune nekudzimu, ngobe itjigalo tjeNdzimu, <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />kene nehango, ngobe ndepanonyalulukila makumbo awe, kene neJerusalema, ngobe unzi-nkulu waMambo nkulu. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Kakale usitune nen'holo uwo, ngobe awungake ukata vudzi likaba jena kene likaba dema. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Tjawunoleba ngatjibe ‘Ee’ hapa ubva ‘Ee’ kene tjibe ‘Aa’ hapa ubva ‘Aa’; kumwe kunopinda ikoku ndekunobva mububi.”<verse eid="MAT 5:37" /></para>
  <para style="s">Diya Nekwebgwilizila</para>
  <para style="r">(<ref loc="LUK 6:29">Luka 6.29</ref>,<ref loc="LUK 6:30">30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“Makawha kuti kwakayi, ‘Hhiho ngalilipiwe ngehhiho, hhino ngehhino.’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Koga ndoti kumuli, musinyanyayidzane nenhu mbi. Koga unokuloba paluhaya gweludli uwumpe kakale luhaya gwelumehwe. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Kakale hapa umwe nhu ekutilika nlandu ekulipisa ekutolela tjiyambalo, uwunletje atole nebhatji lilo. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Hapa umwe nhu ekubhata nemasimba kuti uwumpeleke gwendo gwakalizana khilomitha, yenda naye makhilomitha mabili. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Ipa kene yani unokumbila kukuli, kakale usiwunlambile unohaka adzima kukuli, uwumpe.”<verse eid="MAT 5:42" /></para>
  <para style="s">Da Zwita</para>
  <para style="r">(<ref loc="LUK 6:27">Luka 6.27</ref>,<ref loc="LUK 6:28">28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“Makawha kuti kwakayi, ‘Ida mbakidzani uwo, uheme tjita tjitjo.’ <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Koga ndoti kumuli, idani zwita zwenyu, kakale mutembezelele banomudziyidza, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />kuyetila kuti mube bakololo baTate benyu bakudzimu. Ngobe banothama hhuba likabhuda kubanhu banota zwibi nekubanhu babuya, kakale banonisila vula bakalulama nebasakalulama. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Ngobe hapa muda ibabo banomuda, ndiwupi mbhayilo wamunowhowana? Baketisi abatokuthama bo ikoku? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Kakale hapa mulezwa makamu enyu koga, ini tjamunothama kupinda bamwe? Bataya abatothama bo bejalo? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Ndizo ke pelelani, saTate benyu bakudzimu bakapelela.”<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Tjidiyo Nekwebhatshana</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />“Ibani nenjele kuti amutothama lulama mbeli kwebanhu, muyetila kuti babone. Hapa muthama mujalo amuna mbhayilo unobva kuna Tate benyu bakudzimu.”<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />“Ndizo hapa ubhatsha nhu unohaka lubhatsho, usiyende ukuhhadza hango yose, sekwakunoyetiwa nebatjengeli mumasinagogu nemudzizila, beyetila kuti banhu babakudze. Lebeswa ndoti kumuli, batjiwamutjila mbhayilo wabo nekuhhele. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Koga hapa ubhatsha unohaka lubhatsho, usiletje luboko gugo gwelumehwe gukaziba kuti luboko gugo gweludli gothamani, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />kuyetila kuti bhatsha kwawathama kusizibgwe nenhu. Tate babo, ibo banobona tjakasumbikika, banowhokupa mbhayilo.”<verse eid="MAT 6:4" /></para>
  <para style="s">Ntembezelo</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luka 11.2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />“Kakale hapa mutembezela, musinge batjengeli, ngobe banoda tembezela balimile mumasinagogu nepanohangana dzizila, beyetila bon'wa nebanhu. Lebeswa ndoti kumuli, batjiwamutjila mbhayilo wabo nekuhhele. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Koga hapa utembezela, ngina mun'umba, uhhalile nkoba utembezele kuna Tate babo basingaboneke. Tate babo, ibo banobona tjinoyetiwa pakasumbikika, banowhokupa mbhayilo.”<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />“Kakale mukutembezela, musihingise matama manjinji seBataya, ngobe banokumbula kuti banowhowhiwa nekuti banohingisa matama manjinji. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Musinge ibo, Tate benyu banoziba tjamunohaka musanhu mabakumbila.”<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />“Ndizo ke, mutembezele nayeyi zila,</para>
  <para style="q1" vid="MAT 6:9">“ ‘Tate bedu bakudzimu.</para>
  <para style="q2" vid="MAT 6:9">Zina lenyu ngaliyengemadziwe;<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Bumambo gwenyu ngaguhhe;</para>
  <para style="q2" vid="MAT 6:10">kuda kwenyu ngakuyetiwe, muhango sekwakunoyetiwa kudzimu.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Mutipeni zodliwa zwedu zwemisi nemisi.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Mutiyetileni mazwibhatigwa milandu yedu,</para>
  <para style="q2" vid="MAT 6:12">sekwatinobayetila mazwibhatigwa ibabo bana milandu naswi.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Musitinginise mukulikwa,</para>
  <para style="q2" vid="MAT 6:13">koga mutisunungule mububi.’ ”<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />“Ngobe hapa muyetila banhu mazwibhatigwa matjinyo abo, Tate benyu bakudzimu banowhomuyetila bo mazwibhatigwa. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Koga hapa musingayetile banhu mazwibhatigwa matjinyo abo, Tate benyu bakudzimu abatowhomuyetila bo mazwibhatigwa matjinyo enyu.”<verse eid="MAT 6:15" /></para>
  <para style="s">Diya Nekweyila Zodliwa</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />“Hapa muyila zodliwa, musinge batjengeli, banohobesa buso kudza banhu babone kuti bakayila zodliwa. Lebeswa ndoti kumuli, batjiwamutjila mbhayilo wabo nekuhhele. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Koga hapa wakayila zodliwa, ngula buso uhhole mafuta mun'holo, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />kuyetila kuti banhu basibone kuti wakayila zodliwa, kubone Tate babo boga basingaboneke, Tate babo, banobona tjakasumbikika, banowhokupa mbhayilo.”<verse eid="MAT 6:18" /></para>
  <para style="s">Fumwa yeKudzimu</para>
  <para style="r">(<ref loc="LUK 12:33">Luka 12.33</ref>,<ref loc="LUK 12:34">34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />“Musibige fumwa yenyu muhango, payinodliwa nezwikonyana nebulala, nembava padzinongina dziswada. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Koga bigani fumwa yenyu kudzimu, payisingadliwe nezwikonyana kene nebulala, pasingangine mbava dzikaswada. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Ngobe pana fumwa iyo, ndipo moyo uwo pawunowhogala uliko bo.”<verse eid="MAT 6:21" /></para>
  <para style="s">Tjedza Tjembili</para>
  <para style="r">(<ref loc="LUK 11:34-36">Luka 11.34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />“Hhiho litjivoneko tjembili. Ndizo ke, hapa hhiho lilo lili bhenyu, mbili uwo wose unoba ulihhele tjedza. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Koga hapa hhiho lilo lisi bhenyu, mbili uwo wose unoba ulihhele hhalima. Ngono ke hapa tjedza tjimukuli tjili hhalima, ngono hhalima linji kungapani ke!”<verse eid="MAT 6:23" /></para>
  <para style="s">Ndzimu Nefumwa</para>
  <para style="r">(<ref loc="LUK 16:13">Luka 16.13</ref>; <ref loc="LUK 12:22-31">12.22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />“Akuna nhu ungahingila bohe babili; ngobe angada umwe akahema umwe, kene unowhozwipila kuwumwe akalingila umwe pasi. Amungahingile Ndzimu kose nemari.”<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />“Ndizo ke ndomubudza, musizwimanikanye nekwebutjilo gwenyu, kuti mowhodlani kene kuti mowhon'wani, kene nekwemibili yenyu, kuti mowhombalani. Butjilo agutopinda zodliwa, nembili awutopinda zwiyambalo? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Lingani nyunyi dzemumhepo. Adzitodzwala kene kowha kene iko sa muzwidandale, koga Tate benyu bakudzimu banodzipa zodliwa. Amuna tjilemela kupinda idzo? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Ndiyani wenyu angapamhidzila bulefu gwebutjilo gugwe ngekuzwimanikanya?”<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />“Nentha yeni muzwimanikanya nekwembala? Lingani kuti maluba ehango anokula tjini, haatohinga kene pfuma zwiyambalo. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Koga ke ndomubudza, kene naSolomoni mugudzo lile lose waka esakambala selin'ompela lawo. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Koga hapa Ndzimu embadza buhwa gwehango nayeyi zila, gunotjila nasi mangwana guposegwa mumoto patjibeso, atowhomumbadza kupinda igo imwi, banhu bana bugalimoyo gutukununu?”<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />“Ndizo ke musizwimanikanye muti, ‘Towhodlani?’ kene muti, ‘Towhon'wani?’ kene muti, ‘Towhombalani?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Ngobe Bataya banozwihaka zwinhu zose izwezwi, naTate benyu bakudzimu banoziba kuti mozwihaka zose. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Koga hakani bumambo gweNdzimu nendulamo iye kutanga, zose izwezwi zwinhu mowhozwipiwa bo. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Ndizo ke, musizwimanikanye nelemangwana, lemangwana lowhozwimanikanya nekwalo. Limwe nelimwe hhuba lina mamanikano alo akalilizana.”<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Tonga Bamwe</para>
  <para style="r">(<ref loc="LUK 6:37">Luka 6.37</ref>,<ref loc="LUK 6:38">38</ref>,<ref loc="LUK 6:41">41</ref>,<ref loc="LUK 6:42">42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />“Musitonge, kuyetila kuti musitongewe bo. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Zila yamunotonga bamwe, ndiyo yamunowhotongewa nayo bo, tjilizanyo tjamunopa, nditjo tjamunowhowana bo. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Ngentha yeni ubona lubaza ngumuhhiho legamu lilo, koga iwe usingabone danda limuhhiho lilo? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Kene ungati kugamu lilo, ‘Letja ndikuduse lubaza gumuhhiho lilo,’ tjini, iwe unadanda muhhiho lilo? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Iwe ntjengeli, tanga wadusa danda limuhhiho lilo, ukotjibona zwakanaka kuti uduse lubaza gumuhhiho legamu lilo.”<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />“Musipe mbgwa tjakayengemala dzingabva dzimuhandukila dzimupalulanya; musiposele ndalama dzenyu dzakanaka mbeli kwewhotji, ngobe dzingadzikanyanga ngemakumbo adzo.”<verse eid="MAT 7:6" /></para>
  <para style="s">Kumbila, Haka, Kokodza</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luka 11.9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />“Kumbilani, mowhopiwa; hakani, mowhowana; kokodzani, mowhohhuligwa. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Ngobe wose nhu unokumbila unowamutjila, unohaka unowana, newunokokodza unowhohhuligwa. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Ndiwupi nlumetate, pakati kwenyu, angati nkololo uwe ewunkumbila tjinkwa, iye akawumpa bgwe? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Kene hapa ekumbila whobe, akawumpa nyoka? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Hapa imwi ke, babi, muziba pa bana benyu zwipo zwibuya, ngono Tate benyu bakudzimu banowhopa kunjinji kungapani ibabo banobakumbila zwipo zwibuya!”<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />“Ndizo kose kwamunoyemula kuti banhu bakuthame kumuli, mukuthame bo kubali; ngobe ikoku ndiko kunobviwa nenlayo nebalebesambeli.”<verse eid="MAT 7:12" /></para>
  <para style="s">Nkoba Ntukununu</para>
  <para style="r">(<ref loc="LUK 13:24">Luka 13.24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />“Mungine nenkoba ntukununu; ngobe wakahama nkoba nezila imhabi, inoyenda kulufu, banjinji banotobela iyo. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Koga untukununu nkoba nezila inhehlanana, inoyenda kubutjilo, bahomanana banoyiwana.”<verse eid="MAT 7:14" /></para>
  <para style="s">Nti Nemitjelo Yawo</para>
  <para style="r">(<ref loc="LUK 6:43">Luka 6.43</ref>,<ref loc="LUK 6:44">44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“Mutjenjele kuna balebesambeli bemanyepwa, banohha kumuli belingika semhwizi, koga mukati beli mhele dzina buhongola. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Mowhobaziba nemihingo yabo. Mahhambi anotjegwa pamatenje emimhiwa, kene mhaya pazwihoho? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Ndizo ke, nti mbuya unamitjelo mibuya, koga nti mbi unamitjelo mibi. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Nti mbuya awungatongoba nemitjelo mibi, nenti mbi awungatongoba nemitjelo mibuya. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Wose nti usingazwale mitjelo mibuya unothubugwa, uposegwa mumoto. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Ndizo ke, mowhobaziba ngezwiyeto zwabo.”<verse eid="MAT 7:20" /></para>
  <para style="s">Andizotongogala Ndamuziba</para>
  <para style="r">(<ref loc="LUK 13:25-27">Luka 13.25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“Akuta wose nhu unoti kundili, ‘He, He,’ unowhongina mubumambo gwekudzimu, koga iye unoyeta kuda kwaTate bangu bakudzimu. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Muhhuba ilelo banjinji banowhoti kundili, ‘He, He, atizolebesambeli muzina lenyu, muzina lenyu tikadusa meyambi kakale tikathama mihingo mikulu muzina lenyu?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Ndokotjibabhudila patjena nditi, ‘Andizotongogala ndamuziba. Yendani kutjena nami, bayeti bezwibi!’ ”<verse eid="MAT 7:23" /></para>
  <para style="s">Babaki Babili</para>
  <para style="r">(<ref loc="LUK 6:47-49">Luka 6.47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“Ndizo ke, wose nhu unowha matama angu iyawa, akawatobela, unowhofanana nentjenjebvu wakabaka n'umba iye pahongwe; <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />kukana vula, kukahha nkubila, mhepo ikahhuhhudza ikaloba n'umba iyeyo, koga ayizokolomoka, ngobe yaka yakabambiwa pahongwe.”<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />“Wose nhu unowha matama angu iyawa, akasawatobela, unowhofanana netjilengwe tjakabaka n'umba yatjo pavunje, <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />kukana vula, kukahha nkubila, mhepo ikahhuhhudza ikaloba n'umba iyeyo ikakolomoka, yakakolomoka zwakagwadza.”<verse eid="MAT 7:27" /></para>
  <para style="s">Masimba aYesu</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Yesu atjipedza zwilebo izwezwi, mabunga ebanhu akatjenamisiwa nediya kukwe, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />ngobe ediya senhu unamasimba, kusi sebakwali babo.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Yesu unolapa Nhu Wetjilume</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mako 1.40-45</ref>; <ref loc="LUK 5:12-16">Luka 5.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Yesu wakati ejita padombo, akatobegwa nebanhu banjinji; <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />kukahha nghwele wemapele kuwunli, akapfigama pawunli eti, “He, hapa muhaka mungandiyeta ndikapola<note caller="+" style="f"><char style="fr" closed="false">8.2 </char><char style="ft" closed="false">munganditjenesa</char></note>.”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Yesu wakatambunudza luboko gugwe akawumbhata, eti, “Ndohaka, pola<note caller="+" style="f"><char style="fr" closed="false">8.3 </char><char style="ft" closed="false">ngudzika</char></note>!” Tjinyolotjo mapele akapela, akapola. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Yesu eba eti kuwunli, “Usibudze nhu. Koga yenda, unozwilakidza kumphirisiti, kakale upe tjipo selaya kwaMozisi, kuyetila kuti gube busupi kubanhu.”<verse eid="MAT 8:4" /></para>
  <para style="s">Galabgwe Kwenlawuli webagwi bengwa</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luka 7.1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Yesu wakati angina muKhaphenawume, kukahha kuwunli nlawuli webagwi bengwa bali gulu, ekumbila lubhatsho, eti, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />“He, n'hingi wangu ulele kanyi wakalobgwa negulukadzi atotubula muka, unowha zogwadza kwazo.”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Yesu eba eti kuwunli, “Ndowhobuya ndiwhowunlapa.”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Nlawuli webagwi bengwa bali gulu wakahandula eti, “He, andizolizanila kuti mungangina mun'umba yangu. Lebani dama koga, n'hingi wangu unowhonaya. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Namibo ndinhu upasi kwemasimba ebapehhugwi kwangu bo, ndina bagwi bengwa bapasi kwangu. Ndoti kuna whoyu, ‘Yenda,’ akayenda; kuwumwe ndoti, ‘Ihha ngeno,’ unohha. Ndoti kunlandalume wangu, ‘Thama whoku,’ akakuthama.”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Yesu wakati ewha matama iyawa, akatjenama, akati kuna baka bewuntobela, “Lebeswa ndoti kumuli, kene iko mu Isirayeli andizotongowana bugalimoyo gwakajali. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Ndomubudza, banjinji banowhobva kubhehhuba nekumahwahhuba, banowhogala bakadla na Abhurahhamu na Isaka naJakobe mubumambo gwekudzimu, <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />koga bakololo bebumambo banowhoposegwa kuhhe, kuhhele hhalima; imhomo banhu banowholila bakalobanya meno.” <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Yesu wakati kunlawuli webagwi bengwa, “Yenda! Ngakuyetikale segalamoyo kuko kuti kowhoyetikala.”</para>
  <para style="p" vid="MAT 8:13">N'hingi wakabva anaya tjinyolotjo.<verse eid="MAT 8:13" /></para>
  <para style="s">Yesu Unolapa Banhu Banjinji</para>
  <para style="r">(<ref loc="MRK 1:29-34">Mako 1.29-34</ref>; <ref loc="LUK 4:38-41">Luka 4.38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Yesu wakati engina mun'umba yaPhethiro akabona mezwale babe balilele, begwala bugwele gweluhhahhamo; <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />wakababhata luboko, bakabva banaya, bakamilika bakawumpakulila zodliwa.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Madekwana iyawo bakahhisa kuwunli banhu banjinji baka baligegwe nemeyambi; akadzitata meya ngedama, akapodza bose baka begwala. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Kuyetila kuti kuhhadzisike tjakalebgwa nenlebesambeli Isaya, eti, “Wakatidusa gwala akalapa nghwele dzedu.”<verse eid="MAT 8:17" /></para>
  <para style="s">Baka bewhoba Batobeli baYesu</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luka 9.57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Yesu wakati ebona atjikubunganigwa nebanhu banjinji kwazo akadusa dama kuti kuyendiwe seli yeya. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Nkwali wakahha kuna Yesu eti, “Ndhiyi, ndowhomutobela kose kwamunoyenda.”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Yesu wakawun'handula eti, “Mhungubgwe dzina mimwina nenyunyi dzemumhepo dzina zwihaka; koga Nkololo wenhu haana paangaladzika n'holo.”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Umwe webadiyiwa wakati kuwunli, “He, mundibvumileni nditange ndanobuluka tate bangu.”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Koga Yesu wakati kuwunli, “Unditobele, usiye bafi babuluke bafi babo.”<verse eid="MAT 8:22" /></para>
  <para style="s">Yesu Unodzikamisa Dutu</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mako 4.35-41</ref>; <ref loc="LUK 8:22-25">Luka 8.22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Paakangina mukepe, badiyiwa babe bakawuntobela. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Tjinyolotjo, kwakamilika dutu linabuhongola mugungwa, kwekuti kepe tjaka tjatjihhaligwa nemabundo evula; koga iye waka alilele. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Bakayenda benowumusa beti, “He, mutitjidze, topalala.”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Eba eti kubali, “Eke banhu bana bugalimoyo gutukununu. Nentha yeni muhla?” Eba emuka etjemela mhepo negungwa; kube kunyalala.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Bakatjenama beti, “Unhu wakatini iwhoyu, unowhiligwa nemhepo kose negungwa?”<verse eid="MAT 8:27" /></para>
  <para style="s">Yesu Unolapa Balume Babili Bagegwe Nemeyambi</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mako 5.1-20</ref>; <ref loc="LUK 8:26-39">Luka 8.26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Wakati eswika seli yeya, kuhango yebaGadarini, akahanganidziwa nebalume babili bagegwe nemeyambi, bebhuda mumakuwhu aka ali zwikumbu, baka behlisa kwekuti kwaka kusina nhu angapinda nezila iyeyo. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Bakamimila beti, “Mohakani kutili, imwi Nkololo weNdzimu? Mahhila kuti muwhotidziyidza lubaka gusanhu gwaswika?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Kwaka kuna ngubi yewhotji dzaka dzifula tjakulenyana nabo. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Meyambi dzakawunkumbilisisa dziti, “Hapa mutitata, mutitatile kungubi yewhotji.”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Wakadzihandula eti, “Yendani.” Ndizo dzakabhuda dzikanongina muwhotji; whotji dzose dzakakulumuka dzijitila nepakakungulukila dzikanowila mugungwa, dzikafila muvula.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />Balisi bakatihha, bakati bengina munzi-nkulu bakabudza banhu kose ikoku, netjaka tjayetika kubalume baka baligegwe nemeyambi. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Banhu bose bakabhuda bakayenda kuna Yesu; bakati bewumbona, bakawunkumbila kuti abhude muntunhu wabo ayende.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Yesu Unolapa Nlume Wakalobgwa Negulukadzi</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mako 2.1-12</ref>; <ref loc="LUK 5:17-26">Luka 5.17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Wakangina mukepe, akatjulukila seli, akayenda kunzi-nkulu wakanyi kukwe. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Banhu bakahhisa kuwunli nghwele wakalobgwa negulukadzi, alilele panhobo; Yesu wakati ebona galamoyo kwabo eba eti ku nghwele, “Sima nkololo wangu; watjiyetigwa mazwibhatigwa matjinyo awo.”<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Koga bamwe bakwali mumikumbulo yabo bakati, “Iwhoyu nlume unotuka Ndzimu!”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Koga Yesu eziba mikumbulo yabo, wakati, “Kungentha yeni mu alakana zwibi mumimoyo yenyu? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Ndikupi kulelu. Leba uti, ‘Wayetigwa mazwibhatigwa matjinyo awo,’ kene leba uti, ‘Milika uyende’? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Koga ke ndohaka kuti muzibe kuti Nkololo wenhu una masimba muhango, eyetila mazwibhatigwa matjinyo.” Wakati kunlume wakalobgwa negulukadzi, “Milika, tola nhobo iyo uyende kanyi kuko.”<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />Wakamilika akayenda kanyi kukwe. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Banhu bekubona ikoku, bakahhigwa nekuhla, bakakudza Ndzimu, iye wakapa banhu masimba akajali.<verse eid="MAT 9:8" /></para>
  <para style="s">Yesu Unodana Matewu</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mako 2.13-17</ref>; <ref loc="LUK 5:27-32">Luka 5.27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Yesu wakati eyenda ebva ipapo, akabona nlume unoyi Matewu aligele pan'umba inoketisigwa; wakati kuwunli, “Unditobele.”</para>
  <para style="p" vid="MAT 9:9">Wakamilika akawuntobela.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Yesu wakati atjibagele pathebuli mun'umba, baketisi nebatjinyi banjinji bakahha bewhodla naYesu nebadiyiwa babe. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />BaFarisi bakati bekubona ikoku, bakati kubadiyiwa babe, “Kungentha yeni ndhiyi wenyu edla nebaketisi nebatjinyi?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Koga wakati ebawha, akati, “Bapenyu abatohaka nlapi, koga unohakiwa ngebanogwala. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Yendani munodiyika kuti ikoku kobvani, ‘Ndoyemula mawhilangoni, kusi tjibhayilo.’ Ngobe andizohhila kuti ndiwhodana bakalulama, koga batjinyi.”<verse eid="MAT 9:13" /></para>
  <para style="s">Mbhuzo Nekweyila Zodliwa</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mako 2.18-22</ref>; <ref loc="LUK 5:33-39">Luka 5.33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Nayigogo lubaka, badiyiwa baJohane bakahha kuwunli beti, “Kungentha yeni iswi nebaFarisi tiyila zodliwa, koga badiyiwa benyu besingayile zodliwa?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Yesu wakati kubali, “Bezi bebukwe bangalila iye nkwaha atjinabo mun'umba yebukwe? Anowhoswika mahhuba, nkwaha paanowhodusiwa mubali, ndipo pabanowhoyila zodliwa.”<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“Akuna nhu unopfumila tjigamba tjitshwa patjiyambalo tjikulukugwi, ngobe tjigamba tjomwawula tjiyambalo, tjiyambalo tjikapaluka tjipindilila. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Kene wayini ndzwa ayitosiwa mumikabo mikulukugwi; hapa isiwa muyili, mikabo inopatuka; wayini itebuka, mikabo ipwapwatika; koga wayini ndzwa inosiwa mumikabo mitshwa, nayiyeyo zila kose kolondolodzeka.”<verse eid="MAT 9:17" /></para>
  <para style="s">Nkololokadzi weNtungamili, neMfumakadzi Wakabhata Jila laYesu</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mako 5.21-43</ref>; <ref loc="LUK 8:40-56">Luka 8.40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Etjalebeleka, kwakaswika ntungamili akapfigama mbeli kukwe eti, “Nkololokadzi wangu utjambotjinyika; koga ke buyani muwumbige maboko, unowhomuka.”<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />Yesu wakamilika akawuntobela, nebadiyiwa babe.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Kwakahha mfumakadzi waka atjiba nemakole aligumi nemabili egwala bugwele gwebhihha malopa, hule kukwe, akabhata mpeto wetjiyambalo tjitje; <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />eti mumoyo uwe, “Hapa ndingabhata tjiyambalo tjitje koga, ndowhonaya.”<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Yesu wakatjebuka, ewumbona akati, “Sima, nkololokadzi; galamoyo kuko kwathama ukanaya.” Tjinyolotjo nkadzimayi wakabva anaya.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Yesu paakaswika kun'umba yentungamili, ebona balidzi benyele, nembunga webanhu uthama hhoba, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />wakati, “Ibvani; ngobe nsikana haazofa koga ulele.” Bakawunseka. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Kwakati banhu batjibhudila kuhhe, akangina akawumilidza neluboko, nsikana akamuka. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Kwakalebgwa nekwako muntunhu iwhoyo wose.<verse eid="MAT 9:26" /></para>
  <para style="s">Yesu Unolapa Mapofu Mabili</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yesu wakapindilambeli ebva ipapo, mapofu mabili akawuntobela, emimila eti, “Nkololo waDavida, mutiwhile ngoni.”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Wakati engina mun'umba, mapofu akahha kuwunli; Yesu akababhuzwa eti, “Mogalamoyo kuti ndotubula kuthama ikoku?”</para>
  <para style="p" vid="MAT 9:28">Bakahandula beti, “Ee, He.”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Wakabhata meho abo, eti, “Segalamoyo kwenyu, ngakuyetikale kumuli.” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Meho abo akabva apofunuka. Yesu akabakowhomesedza eti, “Mube nelebeswa kuti akuna nhu unoziba nekwako.”<verse eid="MAT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31" />Koga bakayenda bakanobudza banhu muntunhu wose iwhoya.<verse eid="MAT 9:31" /></para>
  <para style="s">Yesu Unolapa Mbebebe</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Bakati boyenda, kwakahhisiwa kuwunli mbebebe igegwe nemeyambi. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Meyambi yatakwa, mbebebe yakalebeleka; banhu bakatjenama, beti, “Akuna tjinhu tjakajali tjakatongoboneka mu Isirayeli.”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Koga Bafarisi bakati, “Unotata meyambi ehingisa he wemeyambi.”<verse eid="MAT 9:34" /></para>
  <para style="s">Yesu Unowhila Banhu Ngoni</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yesu wakayenda mumizi-mikulu yose nemumizi yose, ediya mumasinagogu abo kakale esumikila ndebo mbuya yebumambo, elapa dzose nghwele negwala kose. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Wakati ebona mabunga ebanhu, akabawhila ngoni, ngobe baka bakadziyidzika basitjina tjabanotubula, semhwizi dzisina nlisi. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Wakati kubadiyiwa babe, “Gowo linjinji, koga bahingi ndibo bahomanana; <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />ndizo tembezelani mukumbile He mweni wegowho kuti atumile bahingi kugowho lile.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Badiyiwa Bali Gumi Nebabili</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mako 3.13-19</ref>; <ref loc="LUK 6:12-16">Luka 6.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Wakadana badiyiwa babe bali gumi nebabili akabapa masimba pehhugwi kwemeyambi, masimba edzitata, nelapa dzose nghwele negwala kose. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Mazina ebapositoli bali gumi nebabili ndiyawa. Wekutanga ndiSimoni, iye unoyi Phethiro, nenun'una uwe Andhireya; Jakobe nkololo waZebhedi naJohane nun'una uwe; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filiphi naBhatholomewu; Tomasi naMatewu nketisi; Jakobe nkololo waAlifiyasi naThediyasi; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Simoni wekuKhenani, naJudasi Isikariyoti, iye wakawuntengesa.<verse eid="MAT 10:4" /></para>
  <para style="s">Tumwa kweBadiyiwa bali Gumi nebabili</para>
  <para style="r">(<ref loc="MRK 6:7-13">Mako 6.7-13</ref>; <ref loc="LUK 9:1-6">Luka 9.1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Ibaba beli gumi nebabili Yesu wakabatuma, ebalaya eti, “Musitongoyenda kuBataya, kakale musingine mumizi yemaSamariya. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Koga yendani kumhwizi dzakalahika dzeludzi gwa Isirayeli. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Yendani musumikila, muti, ‘Bumambo gwekudzimu gwatjibe pedlo.’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Mupodze banogwala, mumuse bafi, mutjenese bagwele bemapele, mutate meyambi. Makawamutjidziwa mpho, ndizo ipani bo mpho. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Musisenge zeezi, kene siliva, kene mhangula mumamwandabula enyu, <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />kene whomo yegwendo, kene zwiyambalo zwibili, kene mbhatata, kene ludozo; ngobe n'hingi wakafanila wahhiwa nezodliwa.”<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />“Kene muna wupi ntunhu wamunoba maswika, hakani nhu unaludo gwemuwamutjila, mugale kuwunli mudza mupindila mbeli. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Hapa muswika munzi, mubalezwe. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Hapa banhu benzi iwhoyo bemuwamutjila kunyalala kwenyu kube kubali, koga hapa besingamuwamutjile kunyalala kwenyu kubgwilile kumuli. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" /><note caller="-" style="x"><char style="xo" closed="false">10.14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Mih 13.51</ref>.</char></note>Kakale hapa umwe nhu esingawamutjile kene esingawhilile matama enyu, mupule whuluba pamakumbo enyu nelubaka mubhuda mun'umba iyeyo kene munzi iwhoyo. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Lebeswa, ndoti kumuli, kowhoba kuhine kuhango yeSodoma neGomora muhhuba letongewa pana kunzi iwhoyo.”<verse eid="MAT 10:15" /></para>
  <para style="s">Dziyidziwa Kunohha</para>
  <para style="r">(<ref loc="MRK 13:9-13">Mako 13.9-13</ref>; <ref loc="LUK 21:12-17">Luka 21.12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />“Ndomutuma semhwizi pakati kwemhele, ndizo tjenjelani senyoka kakale mube basina nlandu senjiba. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Mube nehhiho bhabi kubanhu, ngobe banowhomuyendesa kumbahhe, bakamuloba mumasinagogu abo, <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />kakale mowhoyendesewa kubabhati bemitunhu nekuna bomambo nentha yangu, kuti mube busupi mbeli kwabo nekuBataya. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Hapa bemusunga, musizwimanikanye nekwetjamunowholeba kene kuti mowholebeleka mutini, tjamunowholeba mowhotjipiwa mulubaka igogo, <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />ngobe akuta imwi munowholebeleka, koga iMeya yaTate benyu inolebeleka mumuli.”<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />“Nkuluyi nenun'una banowhotengsana kuti umwe abulayiwe, tatayi banowhohandukila mwana, nebana banowhohandukila bazwadzi bakata kuti babulayiwe, <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />kakale mowhobengewa nebanhu bose ngentha yezina langu. Koga unosimidzila kukanoti kubupelo unowhotjidziwa. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Hapa bemudziyidza muwumwe nzi, mutihhile kuwumwe; ngobe lebeswa, ndoti kumuli, amutowhoba mapedza yenda kumizi yose ye Isirayeli, esanhu ahha Nkololo wenhu.”<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />“Ndhiyiwa haata pehhugwi kwendhiyi uwe, nenlanda haata pehhugwi kwabatezi babe; <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />kwakalizanila kuti ndhiyiwa abe sendhiyi uwe, nenlanda abe sabatezi babe. Hapa kuli kuti badana mweni wenzi beti Bhelezebhule, banowholeba zwakayipa kungapani nekwebanhu benzi uwe!”<verse eid="MAT 10:25" /></para>
  <para style="s">Wamakafanila Hla</para>
  <para style="r">(<ref loc="LUK 12:2-7">Luka 12.2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />“Ndizo musibahle, ngobe akuna tjakafumikiwa tjisingowhozumbunugwa, kene tjakasumbikala tjisingowhozibgwa. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Tjandinomubudza muhhalima, mutjilebe masikati, netjamunonyebezegwa, mutjimimile muli pehhugwi kwedzin'umba. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Kakale musihle ibabo banobulaya mbili koga besingatubule bulaya meya, koga ihlani iye unotubula paladza mbili kose nemeya mugehena. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Bontiintii zwibili azwitotengesewa nepeni? Koga tjin'ompela atjingatange tjikawila pasi kusi kuda kwaTate benyu. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Koga kene iwo mavudzi emiholo yenyu akabagwa. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Ndizo, musihle; muna tjilemela kupinda bontiintii zwinjinji.”<verse eid="MAT 10:31" /></para>
  <para style="s">Bvuma Nelandula Khirisitu</para>
  <para style="r">(<ref loc="LUK 12:8">Luka 12.8</ref>,<ref loc="LUK 12:9">9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“Wose nhu unondibvuma mbeli kwebanhu, nami bo ndowhumbvuma mbeli kwaTate bangu bakudzimu, <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />koga yani nani unondilandula mbeli kwebanhu, ndowhowunlandula bo mbeli kwaTate bangu bakudzimu.”<verse eid="MAT 10:33" /></para>
  <para style="s">Andizohhisa Kunyalala, Koga Thumo</para>
  <para style="r">(<ref loc="LUK 12:51-53">Luka 12.51-53</ref>; <ref loc="LUK 14:26">14.26</ref>,<ref loc="LUK 14:27">27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />“Musikumbule kuti ndahha ndihhisa kunyalala muhango; andizohha ndihhisa kunyalala, koga ndahhisa thumo. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Ndahhila whogwisanya nkololo natatayi, nenkololokadzi nameyabe, nlongo namezwale, <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />zwita zwenhu kowhoba banhu ben'ha uwe.”<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />“Iwhoyo unoda tatayi kene mayi kupinda imi haazondifanila, newunoda nkololo uwe kene nkololokadzi uwe kupinda imi haazondifanila, <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />nayiwhoyo usingatole tjileyanyo tjitje ekanditobela, haazondifanila. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Iwhoyo unowana butjilo gugwe gowhunlahikila, koga iwhoyo unolahikigwa nebutjilo gugwe ngentha yangu unowhoguwana.”<verse eid="MAT 10:39" /></para>
  <para style="s">Mbhayilo</para>
  <para style="r">(<ref loc="MRK 9:41">Mako 9.41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />“Unomuwamutjila unowamutjila imi, newunondiwamutjila unowamutjila wakandituma. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Iwhoyo unowamutjila nlebesambeli nentha yekuti unlebesambeli unowhowamutjila mbhayilo wenlebesambeli, nayiwhoyo unowamutjila nhu wakalulama nentha yelulama kukwe unowhowamutjila mbhayilo wenhu wakalulama. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Nayiwhoyo nhu unopa umwe wayibaba batukununu kene nkombe wevula inotonhola ngobe eli ndhiyiwa, lebeswa, ndoti kumuli, atowholahikigwa nembhayilo uwe.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Batumwa Banobva Kuna Johane Mbvubiki</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luka 7.18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Yesu atjipedza laya badiyiwa babe bali gumi nebabili, wakamilika eyenda kunodiya nesumikila mumizi-mikulu yabo.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Johane elimujele wakati ewha nekwemihingo yaKhirisitu, akatumila dama ngebadiyiwa babe <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />eti kuwunli, “Ndimwi unowhohha, kene timilile umwe?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Yesu wakabahandula eti, “Yendani munobudza Johane zwamunobona nezwamunowha. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Mapofu anopofunuka nezwilema zoyenda, bagwele bemapele banotjenesewa, bomantshi zowha, bakafa banomusiwa, nendebo mbuya inosumikigwa kubahayi. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Wakakombolegwa usingandigwadziligwe.”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Bakati bemilika boyenda, Yesu eba etangisa lebeleka kumabunga nekwaJohane. “Makayenda kutjilambanyika munobonani? Luhanga guzunguziwa nemhepo? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Makamuyendilani? Kunobona nlume wakambala zwiyambalo zwakanaka? Ibabo banombala zwiyambalo zwakanaka bamun'umba dzabomambo. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Maka muyendilani ngono? Kunobona nlebesambeli? Ee, ndomubudza, unopinda nlebesambeli kakale. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Ndiye kwakakwagwa nekukwe kuyi, ‘Linga, ndotuma ntumwa wangu mbeli kuko, unowhokubaakanyila zila iwe usanhu waswika.’ <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />Lebeswa, ndoti kumuli, pakati kwayibabo bakazwagwa nebetjikadzi akuna unkulu pana Johane Mbvubiki; koga iwhoyo untukunu mubumambo gwekudzimu unkulu pawunli. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Kubvila mumahhuba aJohane Mbvubiki kudza kube ngwenuwali bumambo gwekudzimu gwagwisiwa nemasimba, nebanhu bemasimba banogutola ngemasimba. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Ngobe whalo dzebalebesambeli bose kose nenlayo kwakalebesambeli kudza kuwhoswika lubaka gwaJohane; <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />ndizo hapa kuli kuti moda kuwamutjila, ndiye Elija wakayi unobuya. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Unazebe dzowha, ngaawhe.”<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />“Tjizekugwana itjetji ndingatjifananisa neni wali? Tjonga bana bagele panotengesegwa banodana bamwe babo beti, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />‘Tamulidzila nyele, amuzozana; tikamba njimbo dzelufu amuzolila.’ <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Ngobe Johane wakabuya esingadle esingan'we, banoti, ‘Una meyambi’; <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Nkololo wenhu wakabuya edla kakale en'wa, banoti, ‘Lingani, tjidli nenlaladzi, unkwinya webaketisi nebatjinyi!’ Koga ke butjenjebvu golayidziwa ngemihingo yago kuti gumalebeswa.”<verse eid="MAT 11:19" /></para>
  <para style="s">Mizi-mikulu Yebasingagalemoyo</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luka 10.13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Wakatangisa sola imwe mizi-mikulu kwaakathama mihingo mikulu minjinji, nentha yekuti abazohanduka. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />Eti, “Khorazini! neBhethisayida! kwakamubangalalila, ngobe kadzene mihingo mikulu yakayetiwa mumuli yaka yayetiwa muTire nemuSidoni, banoba bakahanduka ntolo, baligele pamilota bakambala zwiyambalo zwemasaka. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Koga ndoti kumuli, kowhoba kuhine kuTire neSidoni muhhuba letongewa pana kumuli. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Iwe bo, Khaphenawume, nowhomilidzigwa pehhugwi kudzimu? Nowhojitisigwa pasi kuHhedesi<note caller="+" style="f"><char style="fr" closed="false">11.23 </char><char style="fq" closed="false">kuHhedesi </char><char style="ft" closed="false">kubugalo gwebafi</char></note>. Ngobe kadzene mihingo mikulu yakayetiwa mukuli yaka yayetiwa muSodoma, inoba iliyapo kuswika nasi. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Koga ndomubudza kuti kowhoba kuhine kuhango yeSodoma muhhuba letongewa pana kukuli.”<verse eid="MAT 11:24" /></para>
  <para style="s">Ihhani Kundili Munyaluluke</para>
  <para style="r">(<ref loc="LUK 10:21">Luka 10.21</ref>,<ref loc="LUK 10:22">22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Nayigogo lubaka Yesu wakati, “Ndomuboka, Tate, He wekudzimu nehango, kuti makasumbikila zwinhu izwezwi batjenjebvu nebanowhisisa, mukazwilayidza bana batjetjana, <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />ee, Tate, ngobe ikoku ndiko kwakabe kumuhanhisa.”<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />“Zose zwinhu zwapiwa imi naTate bangu, kakale akuna unoziba Nkololo kuhhe kwaTate, kakale akuna unoziba Tate kuhhe kweNkololo nayiwhoyo Nkololo waanohala wunlayidza.”<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />“Ihhani kundili, moseni imwi makanyala munolemegwa, ndowhomunyalulusa. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Sengani jogwe langu, mudiyike kubva kundili, ngobe ndozwitebamisa kakale ndina moyo nyolo, mowhowana kunyaluluka mumeya dzenyu. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Ngobe jogwe langu lilelu, nentolo wangu awutolema.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Mbhuzo nekweSabatha</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mako 2.23-28</ref>; <ref loc="LUK 6:1-5">Luka 6.1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Mulubaka igogo Yesu wakapalama mudziminda kuli nsi wesabatha; badiyiwa babe baka bena hhala, bakakowha miholo yezwidlo bakadla. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Koga baFarisi bakati bekubona ikoku, bakati kuwunli, “Linga! badiyiwa babo banothama tjisingabvumigwe yetiwa muhhuba lesabatha.”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Wakabahandula eti, “Amuzotongobala tjakayetiwa naDavida, abhakhwa nehhala, nayibabo baaka enabo. <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Kuti wakangina tjini mun'umba yeNdzimu akadla Tjinkwa Tjakayengemala, tjaaka asingabvumigwe dla iye kene ibabo baaka enabo, tjaka tjili tjebaphirisiti koga? <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Kene amuzobala munlayo kuti muhhuba lesabatha baphirisiti muthempeli banotjinya sabatha tjini, koga abana nlandu? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Ndomubudza, tjikulu<note caller="+" style="f"><char style="fr" closed="false">12.6 </char><char style="ft" closed="false">tjikulu. Kungabviwa nhu nkulu</char></note> pathempeli tjiyipapa. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Kakale kadzene maka maziba kuti kobvani kuti, ‘Ndoyemula mawhilangoni kusi tjibhayilo,’ moba musingawane nlandu banhu basina nlandu. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Ngobe Nkololo wenhu ndihe weSabatha.”<verse eid="MAT 12:8" /></para>
  <para style="s">Nlume Unaluboko Gwakahwehwana</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mako 3.1-6</ref>; <ref loc="LUK 6:6-11">Luka 6.6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Ebva ipapo wakayenda akanongina kusinagogu labo. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Mukati kwaka kuna nlume unaluboko gwakahwehwana. Beba bewumbhuzwa beti, “Kumunlayo lapa muhhuba lesabatha?” kuyetila kuti bawuntilike nlandu.<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Eba ebahandula eti, “Hapa umwe pakati kwenyu, enamhwizi in'ompela ikowila mugomba muhhuba lesabatha, haangayiduse? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Tjilemela tjenhu tjikulu kungapani kupinda mhwizi! Ndizo kumunlayo thama tjinhu tjibuya muhhuba lesabatha.” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Eba eti kunlume iwhoya, “Tambunudza luboko gugo.”</para>
  <para style="p" vid="MAT 12:13">Iwhoyo nlume eba egutambunudza, gwakalulama, gukatambunuka segumwe. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Koga baFarisi bakabhudila kuhhe bakanolangana kuti bangawumbulaya tjini.<verse eid="MAT 12:14" /></para>
  <para style="s">Nlanda Wakahagwa neNdzimu</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Yesu, eziba nekwayikoku, wakabva ipapo. Banhu banjinji bakawuntobela, akabalapa bose, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />akabalaya kuti basibudze bamwe nekukwe. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Ikoku kwakakuhhadzisa tjakalebgwa nenlebesambeli Isaya.<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Whoyu nlanda wangu wandahala,</para>
  <para style="q2" vid="MAT 12:18">ndhikani wangu unohanhigwa nemoyo wangu.</para>
  <para style="q1" vid="MAT 12:18">Ndowhosa Meya yangu muwunli,</para>
  <para style="q2" vid="MAT 12:18">unowhosumikila ndulamo kuBataya.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Haatowhokakabadzana nenhu kene thama hhoba,</para>
  <para style="q2" vid="MAT 12:19">akuna unowhowha whi lile mudzizila;<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />haatowhovuna luhanga gwakaleleka</para>
  <para style="q2" vid="MAT 12:20">kene dzima tjivoni tjinopfungayila,</para>
  <para style="q1" vid="MAT 12:20">edza eyeta kuti ndulamo ikunde,<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />neBataya banowhogalabgwe muzina lile.”<verse eid="MAT 12:21" /></para>
  <para style="s">Yesu naBhelezebhule</para>
  <para style="r">(<ref loc="MRK 3:20-30">Mako 3.20-30</ref>; <ref loc="LUK 11:14-23">Luka 11.14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Kwakakohhisiwa kuwunli mbebebe yebhofu igegwe nemeyambi, akayilapa, mbebebe yakalebeleka kakale ikabona. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Banhu bose bakatjenama, bakati, “Kungaba iye Nkololo waDavida iwhoyu?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Koga Bafarisi bekuwha ikoku bakati, “Whuhingisa Bhelezebhule koga, he wemeyambi, kungata kuti iwhoyu nlume atate meyambi.”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Eziba mikumbulo yabo, wakati kubali, “Gose bumambo hapa gwakapalalana pakati tjekwago gopalala, kakale akuna nzi-nkulu kene n'umba inogwa tjekwayo inowhoma; <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />kakale hapa Satane etata Satane, unogwa tjekukwe; bumambo gugwe gowhoma tjini ngono? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Kakale hapa imi nditata meyambi ndihingisa Bhelezebhule, bakololo benyu banodzitata behingisa yani? Ndizo banowhoba batongi benyu. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Koga hapa kuli Meya yeNdzimu yandinohingisa tata meyambi, kobva kuti bumambo gweNdzimu gwatjihha kumuli.”<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />“Kene nhu angangina tjini mun'umba yenhu wakasima akakuba nhundu dzidze, kuhhe kwekuti atange asungilila iwhoyo nhu wakasima? Ekotjikuba zwe.”<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />“Usinami unogwa nami, ne usingakubunganye nami unopaladza. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Ndizo ndomubudza, banhu banowhoyetigwa mazwibhatigwa lose jinyo nejinyo letuka, koga tuka Meya akutowhoyetigwa mazwibhatigwa. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Kene yani unoleba zwakayipa nekweNkololo wenhu unowhoyetigwa mazwibhatigwa; koga kene yani unoleba zwakayipa nekweMeya Yakayengemala atowhoyetigwa mazwibhatigwa, kene mulubaka igogu kene mulubaka gunohha.”<verse eid="MAT 12:32" /></para>
  <para style="s">Nti Nemitjelo Yawo</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luka 6.43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />“Thamani nti ube mbuya, nentjelo wawo ube mbuya; kene muthame nti ube mbi nentjelo wawo uyipe; ngobe nti unozibgwa ngentjelo wawo. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Imwi ludzi gwenyoka! mungaleba tjini tjakalulama, imwi makayipa? Ngobe nlomo unoleba zwihhele mumoyo. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Nhu wakalulama, mukululama kukwe kobhuda tjakalulama, koga nhu mbi, mububi gugwe kobhuda tjibi.”<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />“Ndomubudza, muhhuba letongewa banhu banowhozwitjenesa nekwelimwe nelimwe dama lisina n'hingo laba leba; <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />ngobe ngematama awo nowhosunungugwa, kakale ngematama awo nowhowan'wa nlandu.”<verse eid="MAT 12:37" /></para>
  <para style="s">Bilayegwa kweTjilakidzilo</para>
  <para style="r">(<ref loc="MRK 8:11">Mako 8.11</ref>,<ref loc="MRK 8:12">12</ref>; <ref loc="LUK 11:29-32">Luka 11.29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Nayigogo lubaka elebeleka, bamwe bakwali nebaFarisi bakati kuwunli, “Ndhiyi, toyemula bona tjilakidzilo tjinobva kumuli.”<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Koga wakabahandula eti, “Tjizekugwana tjibi kakale tjisingagalikebgwe kuNdzimu tjohaka tjilakidzilo; koga akuna tjilakidzilo tjatjinowhopiwa kuhhe kwetjilakidzilo tjenlebesambeli Jona. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Sayikoku Jona akaba muntumbu wewhobe, kwemahhuba matatu, siku nesikati, Nkololo wenhu bo unowhoba pasi mumoyo wehango kwemahhuba matatu, siku nesikati. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Banhu bekuNiniva banowhohha mbeli muhhuba letongewa bena tjizekugwana itjetji bekatjiwana nlandu; ngobe bakahanduka pakusumikila kwaJona, tjikulu<note caller="+" style="f"><char style="fr" closed="false">12.41 </char><char style="ft" closed="false">tjikulu. Kungabviwa nhu nkulu</char></note> pana Jona tjipano. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Mambokadzi wekuBurwa unowhomuka muhhuba letongewa ana tjizekugwana itjetji akatjiwana nlandu; ngobe wakabuya ebva kubupelo gwehango ewhowha butjenjebvu gwaSolomoni, tjikulu<note caller="+" style="f"><char style="fr" closed="false">12.42 </char><char style="ft" closed="false">tjikulu. Kungabviwa nhu nkulu</char></note> pana Solomoni tjipano.”<verse eid="MAT 12:42" /></para>
  <para style="s">Bgwilila kweMeyambi</para>
  <para style="r">(<ref loc="LUK 11:24-26">Luka 11.24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“Hapa meyambi yabhuda munhu, inopalama muhango pasina vula ihaka nyaluluka, koga ikakuhaya. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Inokotjiti, ‘Ndowhobgwilila kun'umba yangu kwandakabva.’ Hapa ibuya inowana kusina tjimukati, yakatshwayigwa kakale yakabaakanyiwa. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Inokotjiyenda ke inobuya nedzimwe meya dzili kutondeka dzakayipa kuyipinda, dzihha dzingina dzigala mukati; mamo ebupelo enhu iwhoyo anoyipa kupinda ekutanga. Kowhojalo bo kutjizekugwana itjetji tjibi.”<verse eid="MAT 12:45" /></para>
  <para style="s">Mayi baYesu Nemakamu Awe</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mako 3.31-35</ref>; <ref loc="LUK 8:19-21">Luka 8.19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Etjalebeleka kubanhu, meyabe nebanun'una babe bakama kuhhe, behaka lebeleka naye. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />(Umwe pakati kwabo wakati kuwunli, “Iwha ngeno! Meyabo nebanun'una babo bamile kuhhe, banohaka lebeleka nawe.”<note caller="+" style="f"><char style="fr" closed="false">12.47 </char><char style="ft" closed="false">Dzimwe whalo whulukugwi adzina vesi 47</char></note>)<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Koga wakawun'handula eti, “Ndiyani mme bangu, kakale ndiboyani banun'una bangu?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Etondeka badiyiwa babe, wakati, “Ababa mme bangu nebanun'una bangu! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Ngobe kene yani unota kuda kwaTate bangu bakudzimu unun'una wangu, nehazwadzi, namme bangu.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Tjifananidzo tjeNdzwali</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mako 4.1-9</ref>; <ref loc="LUK 8:4-8">Luka 8.4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Ilelo zwalo hhuba Yesu wakabhuda mun'umba akanogala pawhunde yegungwa. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Banhu banjinji bakawunkubunganila, kwakata kuti adze agale mukepe; mbunga wose wakama munsetje. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Wakababudza zwinhu zwinjinji ngezwifananidzo.</para>
  <para style="p" vid="MAT 13:3">Eti, “Whililani! Ndzwali wakayenda enodzwala. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Wakati ewaya, imwe mbewu ikawila muzila, nyunyi dzikabuya dzikayidla. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Imwe mbewu yakawila pana mahalabgwana, paka pasina mavu manjinji, ikalibilidza mela nekuti kwaka kusina mavu manjinji, <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />koga kwakati hhuba litanha mela ukatshwa; saku waka usina midzi wakabva waswaba. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Imwe mbewu yakawila mumimhiwa, mimhiwa ikakula ikazwiya mela. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Imwe mbewu yakawila pamavu akanaka ikazwala, imwe kwakapamhiwa kagulu, imwe kuli makumi matanhatu, imwe kuli makumi matatu.”<verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />Yesu wakafidza eti, “Unazebe ngaawhe.”<verse eid="MAT 13:9" /></para>
  <para style="s">N'hingo weZwifananidzo</para>
  <para style="r">(<ref loc="MRK 4:10-12">Mako 4.10-12</ref>; <ref loc="LUK 8:9">Luka 8.9</ref>,<ref loc="LUK 8:10">10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Badiyiwa bakakotjihha kuwunli beti, “Molebelekelani nabo nezwifananidzo?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Wakabahandula eti, “Imwi makapiwa luzibo gwezwakasumbikika zwebumambo gwekudzimu, koga ibo abazogupiwa. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Ngobe iwhoyo unako unowhopiwa kunjinji, akaba nekwakawanda; koga usina, nayikoko kwaanako unowhokutolegwa. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Ndizo ndilebeleka nabo nezwifananidzo, ngobe nekutobe bebona abatobona, nekutobe bewha abatowha, kakale abatowhisisa. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Kohhadzisika lebesambeli kwa Isaya kunoti.</para>
  <para style="q1" vid="MAT 13:14">“ ‘Mowhowha koga amutowhowhisisa,</para>
  <para style="q2" vid="MAT 13:14">kakale mowhobona koga musikuse munkumbulo.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Ngobe mimoyo yebanhu ibaba yanyamba,</para>
  <para style="q2" vid="MAT 13:15">zebe dzabo dzolemegwa newha,</para>
  <para style="q2" vid="MAT 13:15">nemeho abo batjiwahhalila,</para>
  <para style="q1" vid="MAT 13:15">swiyo bangabona nemeho abo,</para>
  <para style="q2" vid="MAT 13:15">bakawha nezebe dzabo,</para>
  <para style="q1" vid="MAT 13:15">kakale bakawhisisa nemimoyo yabo,</para>
  <para style="q2" vid="MAT 13:15">bakahandukila kundili kuti ndibapodze.’ ”<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />“Koga akakombolegwa meho enyu ngobe anobona, nezebe dzenyu dzakakombolegwa ngobe dzowha. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Lebeswa, ndoti kumuli, balebesambeli banjinji nebanhu bakalulama banjinji bakabeyemula bona tjamunobona, koga abazotjibona, newha tjamunowha, koga abazotjiwha.”<verse eid="MAT 13:17" /></para>
  <para style="s">Yesu Unotjenesa nekweTjifananidzo tjeNdzwali</para>
  <para style="r">(<ref loc="MRK 4:13-20">Mako 4.13-20</ref>; <ref loc="LUK 8:11-15">Luka 8.11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“Tjiwhani ke kuti tjifananidzo tjendzwali tjolebani. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Hapa nhu ewha ndebo yebumambo koga esingayiwhisise, mbi unohha etola tjakadzwagwa mumoyo uwe; iyeyi ndiyo mbewu yakadzwagwa muzila. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Mbewu yakawila pana mahalabgwana, kobviwa iwhoyo unowha dama, tjinyolotjo eliwamutjila nekuhanha; <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />koga nentha yekuti alina midzi muwunli, lotjila kwelubaka nyana, panoswika bulemo kene dziyidzika ngentha yedama, unobva anyala moyo tjinyolotjo. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Mbewu yakawila mumimhiwa, kobviwa iwhoyo unowha dama, koga da zwinhu zwehango nehanhila fumwa kukotshambidzila dama, likosaba nemitjelo. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Mbewu yakadzwagwa mumavu akanaka, kobviwa iwhoyo unowha dama akaliwhisisa; lebeswa unoba nemitjelo yakapamhiwa, imwe kagulu, imwe kuli makumi matanhatu, imwe kuli makumi matatu.”<verse eid="MAT 13:23" /></para>
  <para style="s">Tjifananidzo Tjedihwa</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Wakababudza tjimwe tjifananidzo, eti, “Bumambo gwekudzimu gungafananisiwa nenhu wakadzwala mbewu yakanaka muminda iye; <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />koga kwakati banhu balilele, tjita tjitje tjakahha tjikadzwala dihwa pakati kwezwidlo, tjikamilika tjiyenda. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Zwidlo zwakati zwamela zwikakula, zwatjifunda, dihwa likaboneka bo. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Balanda bemweni wenzi bakahha kuwunli beti, ‘Tate, kati maka musadzwala mbewu yakanaka muminda yenyu? Kwaba nedihwa tjini kakale?’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Wakabahandula eti, ‘Itjita tjakakuthama ikoku.’ Balanda beba beti kuwunli, ‘Mohaka kuti tiyende tinolisipula?’ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Akabahandula eti, ‘Aa; ngobe mungati musipula dihwa mukosipulilanya nezwidlo. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Letjani kose kukule kudze kunoti palubaka gwevuna. Palubaka gwevuna ndowhobudza banoba bevuna kuti. Kubunganyani dihwa kutanga mulite masunga anowhopisiwa; mukotjikubunganya zwidlo muzwihhise kutjidandale tjangu.’ ”<verse eid="MAT 13:30" /></para>
  <para style="s">Tjifananidzo tjeMhudzi yeMasitadi</para>
  <para style="r">(<ref loc="MRK 4:30-32">Mako 4.30-32</ref>; <ref loc="LUK 13:18">Luka 13.18</ref>,<ref loc="LUK 13:19">19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Wakababudza tjimwe tjifananidzo, eti, “Bumambo gwekudzimu gonga mhudzi yemasitadi nhu yaakadzwala muminda iye; <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />ndiyo mhudzi nhukununu panayidzo dzose, koga hapa yakula iwhuluwhulu kupinda zwilimwa zose kakale inokula ikaba nti, nyunyi dzemumhepo dzobuya dzibaka zwihaka munhabi dzawo.”<verse eid="MAT 13:32" /></para>
  <para style="s">Tjifananidzo tjeMbidzo</para>
  <para style="r">(<ref loc="LUK 13:20">Luka 13.20</ref>,<ref loc="LUK 13:21">21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Wakababudza tjimwe tjifananidzo. “Bumambo gwekudzimu gonga mbidzo mfumakadzi yaakatola akasa muzwilizanyo zwitatu zwebgwisa, zwikadza zwikabila zose.”<verse eid="MAT 13:33" /></para>
  <para style="s">Hingisa Zwifananidzo kwaYesu</para>
  <para style="r">(<ref loc="MRK 4:33">Mako 4.33</ref>,<ref loc="MRK 4:34">34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Kose ikoku Yesu wakakuleba kuli zwifananidzo; haana tjaakaleba kubali esingalebe tjifananidzo. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Ikoku kwakakuhhadzisa tjakalebgwa nenlebesambeli.</para>
  <para style="q1" vid="MAT 13:35">“Ndowhohhula nlomo wangu ndileba zwifananidzo,</para>
  <para style="q2" vid="MAT 13:35">ndowholeba tjabe tjakasumbikala kubvila pabambiwa kwehango.”<verse eid="MAT 13:35" /></para>
  <para style="s">Yesu Unotjenesa Tjifananidzo tjeDihwa</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Wakamilika esiya gubungano lebanhu akangina mun'umba. Badiyiwa babe bakahha kuwunli, beti, “Mutitjenesele tjifananidzo tjedihwa muminda.”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Wakahandula eti, “Unodzwala mbewu yakanaka uNkololo wenhu; <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />minda ihango, mbewu yakanaka kobviwa bana bebumambo; dihwa kobviwa bana benhu mbi, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />kakale tjita tjakabadzwala ndisatane; gowho ibupelo gwetjibaka, banokowha ibatumwa beNdzimu. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Sedihwa likubunganyiwa lipisiwa nemoto, kowhojalo bo pakupela kwetjibaka. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Nkololo wenhu unowhotuma batumwa babe, banowhodusa mubumambo gugwe kose kunohhisa jinyo nebayeti bezwibi bose, <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />baka baposela mubibi lemoto; imhomo banhu banowholila bakalobanya meno. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Bakalulama banowhopenya sehhuba mubumambo gwaTate babo. Unazebe ngaawhe.”<verse eid="MAT 13:43" /></para>
  <para style="s">Tjifananidzo tjeFumwa Yakasumbikala</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“Bumambo gwekudzimu gonga fumwa yakasumbikala muminda, nhu yaanoti ayiwana akayifumika; kukotjiti ngentha yehanha kukwe akayenda enotengesa kose kwaanako akatenga minda iyeyo.”<verse eid="MAT 13:44" /></para>
  <para style="s">Tjifananidzo tjeNdalama</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />“Kakale bumambo gwekudzimu gonga ntengi unohaka ndalama dzakanakisisa, <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />paakawana ndalama in'ompela inantengo upehhugwi, wakayenda akanotengesa kose kwaanako akayitenga.”<verse eid="MAT 13:46" /></para>
  <para style="s">Tjifananidzo tjeNjanga</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“Kakale, bumambo gwekudzimu gonga njanga yakaposegwa mugungwa ikabhata njudzi dzose dzewhobe; <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />yakati yahhala, banhu bakayikwebela pansetje bakagala pasi bakahala dzakanaka bedzisa mutjidla dzakayipa belaha. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Ndizo kowhojalo pabupelo gwetjibaka. Batumwa beNdzimu banowhobuya bethewula babi mubakalulama, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />bekobaposela mubibi lemoto; imhomo banhu banowholila bakalobanya meno.”<verse eid="MAT 13:50" /></para>
  <para style="s">Malebeswa Matshwa Nemakulukugwi</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />“Makuwhisisa kose ikoku?”</para>
  <para style="p" vid="MAT 13:51">Bakawun'handula beti, “Ee.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Eba eti kubali, “Ndizo wose nkwali watjiba ndhiyiwa mubumambo gwekudzimu unonga mweni wenzi unodusa mudula lile fumwa dzwa nefumwa whulukugwi.”<verse eid="MAT 13:52" /></para>
  <para style="s">Yesu Unolandugwa kuNanzaretha</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mako 6.1-6</ref>; <ref loc="LUK 4:16-30">Luka 4.16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Yesu wakati atjipedza zwifananidzo izwezwi akabva ipapo, <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />eswika muhango yakanyi kukwe wakabadiya musinagogu yabo, bakatjenama, beti, “Nlume iwhoyu wawana poni butjenjebvu igogu nemihingo mikulu iyeyi? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Haata iye nkololo wembehhi? Meyabe abatoyi Mariya? Banun'una babe haata Jakobe naJosefa naSimoni naJuda? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Nehazwadzi dzidze dzose atinadzo pano? Ngono iwhoyu nlume wakakuwana poni kose ikoku?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Bakawugwadziligwa.</para>
  <para style="p" vid="MAT 13:57">Koga Yesu wakati kubali, “Ndimuhango yakanyi kukwe nemun'ha uwe koga nlebesambeli paasingakudziwe.” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Haazothama mihingo mikulu minjinji ipapo, ngentha yesagalamoyo kwabo.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Fa kwaJohane Mbvubiki</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mako 6.14-29</ref>; <ref loc="LUK 9:7-9">Luka 9.7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Nayigogo lubaka Hherodi, ntungamili wentunhu weGalile<note caller="+" style="f"><char style="fr" closed="false">14.1 </char><char style="ft" closed="false">ntunhu waka wakapalalanyiwa kana, iye ali mambo welubabi gweGalile</char></note>, wakawha nekwegudzo laYesu; <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />akati kubahingi babe, “NdiJohane Mbvubiki, wamuka kubafi; ndizo wali masimba iyawa ehinga muwunli.”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Ngobe Hherodi waka abhata Johane akawuhhalilila mujele, ngentha yaHherodiyasi, nkadzi wenkulu uwe Filiphi; <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />kana Johane waka ati kuwunli, “Akuta munlayo kuti abe nkadzi uwo.” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Nekene waka ehaka wumbulaya, wakahla banhu, ngobe bakabewuziba senlebesambeli.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Koga kwakati hhuba lezwagwa kwaHherodi laswika, nkololokadzi waHherodiyasi wakazana mbeli kwabo, akahanhisa Hherodi, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />kwakata akawunghadzabgwe etuna kuti unowhowumpa kene ini tjaangakumbila.<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />Abudziwa namayi, wakati, “Mundipeni n'holo waJohane Mbvubiki uli mundilo.”<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />Mambo wakawha zogwadza; koga ngentha yetuna kwaakata mbeli kwebezi babe wakati ngaawumpiwe; <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />wakalaya kuti Johane anothubugwa n'holo kujele, <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />n'holo uwe wakahhisiwa uli mundilo ukaswiswiwa nsikana, akawuyendisa kuna meyabe. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Badiyiwa babe bakabuya bakatola mbili bakawumbiganya; bakakotjinobudza Yesu.<verse eid="MAT 14:12" /></para>
  <para style="s">Yesu Unopa Zodliwa Banhu Bali Zwiwulu Zwihanu</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mako 6.30-44</ref>; <ref loc="LUK 9:10-17">Luka 9.10-17</ref>; <ref loc="JHN 6:1-14">Johane 6.1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Yesu wakati ekuwha ikoku, akamilika ipapo nekepe akayenda kubugalo gwakanyalala aliyega. Koga banhu bakati beziba kuti wayenda poni, bakawuntobela nemakumbo bebva mumizi. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Wakati ebhuda mugungwa akabona mbunga webanhu banjinji; akabawhila ngoni, akalapa banogwala.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Kwatjiba madekwana, badiyiwa babe bakahha kuwunli beti, “Pano ihango, kakale kwahwa; paladzani banhu bayende kumizi banotenga zodliwa zwabo.”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Yesu wakati, “Abazofanila yenda; mubapeni tjabangadla.”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Bakawun'handula beti, “Tina zwinkwa zwihanu newhobe mbili koga.”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Eba eti, “Mukuhhiseni ngeno.” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Eba eti banhu bagale pabuhwa; akatola zwinkwa izwezo zwihanu newhobe idzedzo mbili, akalinga pehhugwi kudzimu, akakombolela, akapemulanya akaswiswa badiyiwa zodliwa, badiyiwa bakapa banhu. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Bose bakadla bakaguta. Bakawolela zwipemu zwezodliwa zwasala zwikahhala zwitundu zwiligumi nezwibili. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Banhu bakadla bakabengaswika zwiwulu zwihanu, betjilume boga, kusingabagwe betjikadzi nebana.<verse eid="MAT 14:21" /></para>
  <para style="s">Yesu Unoyenda Pehhugwi Kwevula</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Wakakotjiti badiyiwa bangine mukepe babe beyenda, bayende seli yeyaa, iye etjapaladza banhu. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Hule kwekuti banhu bayenda, wakayenda kudombo aliyega enotembezela. Kwakadza kukaba madekwana atji ikweno, aliyega, <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />nayigogo lubaka kepe tjaka tjatjiyenda tjatjiba kulekule kwazo nehango, tjikuligwa nemabundo evula; kana mhepo yaka ileyana natjo.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Mahhakuyedza wakabuya kubali, eyenda pehhugwi kwevula. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Koga badiyiwa bakati bewumbona eyenda pehhugwi kwegungwa bakalobgwa nehana, bakati, “Ipuku!” bakamimila nentha yehla.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Koga tjinyolotjo Yesu wakalebeleka eti kubali, “Gadzikanani, ndimi, musihle.”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Phethiro wakawun'handula eti, “He, hapa kuli imwi, itini ndibuye kumuli ndili pehhugwi kwevula.”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Wakahandula eti, “Buya.” Ndizo Phethiro wakabhuda mukepe akatangisa yenda pehhugwi kwevula eyenda kuna Yesu. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Koga wakati ebona mhepo akahhigwa nehla, akatangisa nyula muvula emimila eti, “He, munditjidzeni.”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Tjinyolotjo Yesu wakawuwabilila neluboko akawubvubula, wakati kuwunli, “Nhu unabugalimoyo gutukununu, nentha yeni wasola?”<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Bakati bengina mukepe mhepo iba inyalala. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Ibabo baka beli mukepe bakawunamata, beti, “Lebeswa muNkololo weNdzimu.”<verse eid="MAT 14:33" /></para>
  <para style="s">Yesu Unolapa Banogwala muGenesareti</para>
  <para style="r">(<ref loc="MRK 6:53-56">Mako 6.53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Bakati batjibe seli yeya, bakaswika muhango yeGenesareti. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Banhu bekubugalo igogo bakati bewumbona, bakahaka banhu bose banogwala bentunhu iwhoyo bakabahhisa kuwunli, <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />bakakumbila kuti abvumile bagwele bakunhe mpeto wetjiyambalo tjitje; bose bakatjikunha bakanaya.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Diya Kwebanhu Bantolo</para>
  <para style="r">(<ref loc="MRK 7:1-13">Mako 7.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Kwakakohha bamwe baFarisi nebakwali kuna Yesu bebva kuJerusalema, bakati, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Nentha yeni badiyiwa babo betjuluka nlenje webawhola? Ngobe abatongula maboko hapa bedla zodliwa.”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Koga wakabahandula eti, “Kungentha yeni imwi bo mutjuluka nlayo weNdzimu ngentha yenlenje wenyu? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Ngobe Ndzimu wakati, ‘Lemekedza tate namme babo,’ kakale, ‘Iwhoyo unoleba zwakayipa nekwatatayi kene mayi, ngaafe kwelebeswa.’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Koga imwi moti, ‘Hapa kene yani ebudza tatayi kene mayi eti, tjipo tjandowhomupa tjapiwa Ndzimu, haazotjafanila lemekedza tate babe.’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Ndizo ke, ngentha yenlenje wenyu, mathama kuti nlayo weNdzimu usibe nen'hingo. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Imwi batjengeli! Waka akatambunuka Isaya elebesambeli nekwenyu, eti.<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />“ ‘Banhu ibaba banondilemekedza nemilomo yabo,</para>
  <para style="q2" vid="MAT 15:8">koga mimoyo yabo ikulekule nami.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Akuna tjakunohinga ndinamata kwabo,</para>
  <para style="q2" vid="MAT 15:9">ngobe bediya milayo yebanhu sekunoyi milayo yangu.’ ”<verse eid="MAT 15:9" /></para>
  <para style="s">Zwinhu Zwinothama Nhu Akasayengemala</para>
  <para style="r">(<ref loc="MRK 7:14-23">Mako 7.14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Wakadana banhu, ebadanila kuwunli, akati kubali, “Iwhani muwhisise. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Akuta tjinongina munlomo tjikothama nhu akasayengemala, koga tjinobhuda munlomo, nditjo tjinothama nhu akasayengemala.”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Badiyiwa bakahha bakati kuwunli, “Moziba kuti baFarisi bamon'wa bewha tjamaleba?”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Wakahandula eti, “Wose nti usakadzwagwa naTate bangu bakudzimu unowhosipugwa. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Siyanani nabo; mapofu ebatungamili. Hapa bhofu litungamila limwe bhofu, bubili gwawo anowila mugomba.”<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Koga Phethiro wakati kuwunli, “Mutitjenesele tjifananidzo itjetji.”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Wakahandula eti, “Namwi bo amanhu mukaba nekuwhisisa? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Amutowhisisa kuti kose kunongina munlomo kopindila kuntumbu, kupinda kunobhuda kuhhe kwembili? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Koga itjetjo tjinobhuda munlomo tjibva mumoyo, yetji nditjo tjinothama nhu akasayengemala. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Ngobe mumoyo kobhuda mikumbulo mibi, nebulaya, nebupombgwe, nepinga<note caller="+" style="f"><char style="fr" closed="false">15.19 </char><char style="fq" closed="false">nepinga </char><char style="ft" closed="false">yizela nenhu musakatolana</char></note>, neswada, nebusupi gwemanyepwa netukana. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Izwezwi zwinhu ndizo zwinothama nhu akasayengemala; koga dla usangula maboko akutothama nhu akasayengemala.”<verse eid="MAT 15:20" /></para>
  <para style="s">Bugalibgwe Gwemfumakadzi</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mako 7.24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yesu wakamilika ipapo, akayenda kuntunhu weTire neSidoni. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Kwakahha kuwunli mfumakadzi wekuKhenani waka egala muntunhu iwhoyo, elila eti, “Mundiwhile ngoni, He, Nkololo waDavida; nkololokadzi wangu ugegwe nemeyambi kwazo.”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Koga azowun'handula. Badiyiwa babe bakahha bakawunkumbilisisa, beti, “Muwutateni, ngobe unotitobela etiyetila hhoba.”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Wakabahandula eti, “Ndakatumiwa kumhwizi dzakalahika dzeludzi gwa Isirayeli koga.”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Koga mfumakadzi wakahha akapfigama mbeli kukwe, eti, “He, mundibhatshe.”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Wakawun'handula eti, “Akuzonaka kuti utole tjinkwa tjebana uposela mbgwa.”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Mfumakadzi wakahandula eti, “Ndobvuma, He, kene idzo mbgwa bo dzodla mabhurupfuru anowa pathebuli yabatezi badzo.”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Yesu wakawun'handula eti, “Umfumakadzi unabugalimoyo gusihoma! Ngakuyetikale seyemula kuko.” Nkololokadzi uwe wakabva alapika tjinyolotjo.<verse eid="MAT 15:28" /></para>
  <para style="s">Yesu Unolapa Banhu Banjinji</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yesu wakapindilambeli kubva ipapo akayenda esumha negungwa leGalile. Wakatanha dombo, akagala ipapo. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Banhu banjinji bakahha kuwunli, behhisa banohudza, mapofu, zwilema, mbebebe, nebamwe banjinji njinji, bakabasa pamakumbo awe, akabalapa, <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />banhu bakatjenema, bebona mbebebe dzelebeleka, zwilema zwalulama, banohudza betubula yenda, mapofu ebona; bakakudza Ndzimu wa Isirayeli.<verse eid="MAT 15:31" /></para>
  <para style="s">Yesu Unopa Zodliwa Banhu Bali Zwiwulu Zwina</para>
  <para style="r">(<ref loc="MRK 8:1-10">Mako 8.1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Yesu wakakotjidana badiyiwa babe ekati, “Ndowhila ngoni bunga ileli, ngobe taba tose kwemahhuba matatu, abana tjabanodla; kakale anditoda kuti nditi ngabayende nehhala, ngobe kungayetikala bakuligwe nehhala bawe muzila.”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Badiyiwa beba beti kuwunli, “Ngono mutjilambanyika tingawana poni tjinkwa tjingagutsha bunga gulugulu zwingapa?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Yesu eba ebabhuzwa eti, “Muna zwinkwa zwingana?”</para>
  <para style="p" vid="MAT 15:34">Beba behandula beti, “Zwili kutondeka, newhobe nhukununu homanana.”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Ebudza banhu kuti bagale pasi pamavu, <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />wakatola zwinkwa zwili kutondeka newhobe, atjiboka kuNdzimu wakazwipemula akazwipa badiyiwa, badiyiwa bakapa mabunga. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Bakadla bose bakaguta; bakawolela zwipemu zwezodliwa zwasiyiwa nebanhu zwikahhala zwitundu zwili kutondeka. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Kwakadla banhu beli zwiwulu zwina betjilume, kusingabagwe betjikadzi nebana.<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />Hule kwepaladza mabunga, wakangina mukepe akayenda kuntunhu weMagadani.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">BaFarisi NebaSadusi Banohaka Bona Tjilakidzilo</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mako 8.11-13</ref>; <ref loc="LUK 12:54-56">Luka 12.54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Kwakahha baFarisi nebaSadusi, bewunlika bekumbila kuti abalakidze tjilakidzilo tjinobva kudzimu. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Wakabahandula, eti, “Hapa kwatjihwa, moti, ‘Kowhoba nemhetshwana; ngobe pehhugwi kumakole kuhaba.’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Mangwanana moti, ‘Nasi kowhoba kuna dutu, ngobe kuna makole kakale matematema.’ Motubula bona kuti kumakole kwakatini, koga amutotubula whisisa zwilakidzilo zwelubaka. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Tjizekugwana tjibi kakale tjisingagalikebgwe kuNdzimu tjohaka tjilakidzilo, koga akuna tjilakidzilo tjatjinowhopiwa kuhhe kwetjilakidzilo tjaJona.”</para>
  <para style="p" vid="MAT 16:4">Wakamilika ebasiya eyenda.<verse eid="MAT 16:4" /></para>
  <para style="s">Mbidzo yebaFarisi nebaSadusi</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mako 8.14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Badiyiwa bakati beyenda seli yeya, bakabe bekangan'wa yenda netjinkwa. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yesu wakati kubali, “Mube nehhiho bhabi, mutjenjelele mbidzo yebaFarisi nebaSadusi.”<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Bakalebeleka tjekwabo, beti, “Kungentha yekuti atizohha netjinkwa.”<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Koga Yesu, eziba ikoku, wakati, “Banhu bana bugalimoyo gutukununu, ngentha yeni mulebeleka nekuti amuna tjinkwa? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Amanhu mawhisisa nangwenu? Amutjakumbula nekwezwinkwa zwihanu zwebanhu bali zwiwulu zwihanu, nekuti makawolela zwitundu zwingana? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Kene zwinkwa zwili kutondeka zwebanhu bali zwiwulu zwina, nekuti makawolela zwitundu zwingana? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Kungentha yeni musingawhisise kuti anditobva tjinkwa? Mutjenjelele mbidzo yebaFarisi nebaSadusi.”<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Bakakotjiwhisisa kuti wayesingababudze kuti batjenjelele mbidzo yetjinkwa, koga diya kwebaFarisi nebaSadusi.<verse eid="MAT 16:12" /></para>
  <para style="s">Ndebo yaPhethiro nekwaYesu</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mako 8.27-30</ref>; <ref loc="LUK 9:18-21">Luka 9.18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Yesu paakaswika muntunhu unoyi Khesariya Filiphi, wakabhuzwa badiyiwa babe, eti, “Banhu banoti Nkololo wenhu ndiyani?”<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Bakahandula beti, “Bamwe banoti ndimwi Johane Mbvubiki, bamwe banoti ndimwi Elija, bamwe banoti ndimwi Jeremiya kene umwe webalebesambeli.”<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Akababhuzwa eti, “Imwi moti ndimi yani?”<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Simoni Phethiro wakahandula eti, “Ndimwi Khirisitu, Nkololo weNdzimu mpenyu.”<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Yesu wakawun'handula eti, “Wakakombolegwa, iwe Simoni nkololo waJona! Ngobe ikoku awuzokulakidziwa nenyama nelopa, koga wakulakidziwa naTate bangu bakudzimu. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Kakale ndokubudza, Phethiro. Uhongwe, pahongwe iyeyi ndowhobaka gubungano lebagalimoyo bangu, masimba elufu<note caller="+" style="f"><char style="fr" closed="false">16.18 </char><char style="ft" closed="false">mikoba yekuHhedesi, kubugalo gwebafi</char></note> atowhobakulila. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Ndowhokupa zwihhuliso zwebumambo gwekudzimu, kakale kene ini tjawunosunga muhango tjowhosungwa kudzimu, kakale kene ini tjawunosunungula muhango tjowhosunungugwa kudzimu.”<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Wakakotjilaya badiyiwa babe kuti basitongobudza kene nhu kuti ndiye Khirisitu.<verse eid="MAT 16:20" /></para>
  <para style="s">Yesu Unoleba Nekwedziyidzika Kukwe Kose Nelufu Gugwe</para>
  <para style="r">(Mako 8.31-9.1; <ref loc="LUK 9:22-27">Luka 9.22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Kubvila igogo lubaka Yesu wakatangisa zibisa badiyiwa babe kuti wakafanila yenda kuJerusalema, bawhola nebaphirisiti bakulu nebakwali bawundziyidze kwazo, kakale abulawe, muhhuba lebutatu ekomusiwa kubafi.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Phethiro wakawuntola akama naye ntome akatangisa wuntjemela eti, “Akuna tjakajalo, tjingatjekwa tjikalahwa, He! Whoko akungatange kukayetikala kumuli.”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Koga wakatjebuka akati kuna Phethiro, “Ibva hule kwangu<note caller="+" style="f"><char style="fr" closed="false">16.23 </char><char style="fq" closed="false">Ibva hule kwangu </char><char style="ft" closed="false">ibva pandili</char></note>, Satane! Utjiliko kundili; ngobe awuto alakana zwinhu zweNdzimu koga no alakana se alakana kwebanhu.”<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Yesu wakakotjiti kubadiyiwa babe, “Hapa nhu ehaka yenda nami, ngaazwitoboke atole tjileyanyo tjitje anditobele. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Ngobe kene yani unowholondolodza butjilo gugwe gowhunlahikila, koga kene yani unolahikigwa nebutjilo gugwe ngentha yangu, unowhoguwana. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Kotjidzani kuti nhu awane hango yose koga ekolahikigwa nebutjilo gugwe? Kene ini nhu tjaangapa tjakalizana butjilo gugwe? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Ngobe Nkololo wenhu ndiko kwaatjowhohha nebatumwa babe ali mugudzo laTate babe, ekotjipa wose nhu mbhayilo, ewumpila tjaathama. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Lebeswa, ndoti kumuli, kuna bamwe bamile ipapa basingawhofa basanhu bakabona Nkololo wenhu ebuya ali mubumambo gugwe.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Handuka Mamo</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mako 9.2-13</ref>; <ref loc="LUK 9:28-36">Luka 9.28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Hule kwemahhuba matanhatu, Yesu wakatola Phethiro naJakobe naJohane nun'una waJakobe, akabatungamila eyenda nabo pehhugwi kwedombo lefulefu, pabakaba boga. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Wakahanduka mamo mbeli kwabo, buso gugwe gukapenya sehhuba, zwiyambalo zwizwe zwikaba zwitjenatjena setjedza. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Ipapo kukaboneka pabali Mozisi na Elija, belebeleka naye. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Phethiro eba eti kuna Yesu, “He, kwakanaka kuti tipano; hapa muda, ndowhobaka matumba matatu ipapa, lenyu nelaMozisi nela Elija.”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Akati etjalebeleka, gole linopenya likabakwitidza, whi limugole liba liti, “Iwhoyu ndiye Nkololo wangu wandinoda, unondihanhisa kwazo. Muwuwhilile!”<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Badiyiwa pabakawha ikoku, bakawila pasi bakakotamisa miholo behla kwazo. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Yesu wakayenda kubali akababhata, eti, “Milikani, musihle.” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Bakati bemilidza meho abo, akuna nhu wabakabona kuhhe kwaYesu yega.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Bakati bejita mudombo, Yesu akabakowhomesedza eti, “Musibudze kene nhu tjamabona, kuswikila Nkololo wenhu amusiwa kubafi.”<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Badiyiwa bakawumbhuzwa beti, “Ngentha yeni bakwali beti Elija wakafanila buya kutanga?”<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Wakahandula eti, “Elija unobuya, kakale unowhogadzikanya zwinhu zose; <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />koga ndoti kumuli Elija wakatjibuya kale, abazotongowunziba, koga bakawunta keni ini tjabanoda. Ndizo ke kose neNkololo wenhu banowhowundziyidza bo nayiyeyo zila.”<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />Ndizo badiyiwa bakawhisisa kuti wayelebeleka nabo nekwaJohane Mbvubiki.<verse eid="MAT 17:13" /></para>
  <para style="s">Yesu Unotjidza Mbisana Unameyambi</para>
  <para style="r">(<ref loc="MRK 9:14-29">Mako 9.14-29</ref>; <ref loc="LUK 9:37-43">Luka 9.37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Bakati babgwilila kumbunga, kukahha nlume kuwunli akapfigama mbeli kukwe eti, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />“He, ibani nemawhilangoni kunkololo wangu, ngobe unabugwele gwezwifafa, gowundziyidza kwazo; lubaka gunjinji unowila mumoto nemuvula. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Ndabuya naye kubadiyiwa benyu, bakon'wa wuntjidza.”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Yesu wakahandula eti, “Ekee! Tjizekugwana tjisina bugalimoyo tjakakombama, ndowhoba namwi kukadza kukaba lini? Ndowhomuyetila moyonlefu kukadza kukaba lini? Muwunlesini kundili.” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yesu wakatjemela meyambi ikabhuda mumbisana, mbisana akabva anaya.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Badiyiwa bakahha kuna Yesu bakawumbhuzwa bali boga beti, “Kungentha yeni iswi takonegwa yitata?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Wakati kubali, “Nentha yekuti muna bugalimoyo gutukununu. Lebeswa, ndoti kumuli, hapa muna bugalimoyo gungapa mhudzi yemasitadi, mowhoti kudombo ileli, ‘Ibva ipapa ube hapayaa,’ lowhobva; akuna tjamusingawhotubula thama.” <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" /><note caller="+" style="f"><char style="fr" closed="false">17.21 </char><char style="ft" closed="false">dzimwe whalo dzeTjiGiriki whulukugwi dzina vesi 21. “Koga ludzi igogu gobhuda netembezela, neyila zodliwa koga.”</char></note> <note caller="-" style="x"><char style="xo" closed="false">17.21 </char><char style="xt" closed="false"><ref loc="MRK 9:29">Mak 9.29</ref>.</char></note><verse eid="MAT 17:21" /></para>
  <para style="s">Yesu Unopamha Leba Nekwelufu Gugwe</para>
  <para style="r">(<ref loc="MRK 9:30-32">Mako 9.30-32</ref>; <ref loc="LUK 9:43-45">Luka 9.43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Badiyiwa bakati bakakubungana muGalile. Yesu akati kubali, “Nkololo wenhu watjibapedlo netugwa mumaboko ebanhu. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Banowhowumbulaya, kakale unowhomusiwa muhhuba lebutatu.”</para>
  <para style="p" vid="MAT 17:23">Ipapo badiyiwa bakahhala buyendasi.<verse eid="MAT 17:23" /></para>
  <para style="s">Lipiwa Kweluketo Gwethempeli</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Bakati beswika kuKhaphenawume, baketisi bakabuya kuna Phethiro bakawumbhuzwa beti, “Ndhiyi wenyu unolipa luketo gwethempeli wali?”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Phethiro wakahandula eti, “Ee, unolipa.”</para>
  <para style="p" vid="MAT 17:25">Phethiro wakati angina mun'umba Yesu akatanga lebeleka naye eti, “Nokubona tjini, Simoni? Bomambo behango banotola luketo kuna yani? Kubakololo babo<note caller="+" style="f"><char style="fr" closed="false">17.25 </char><char style="fq" closed="false">Kubakololo babo </char><char style="ft" closed="false">banhu babo</char></note> kene kubamwe<note caller="+" style="f"><char style="fr" closed="false">17.25 </char><char style="fq" closed="false">kubamwe </char><char style="ft" closed="false">bahhi</char></note>?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Phethiro paakahandula eti, “Kubamwe<note caller="+" style="f"><char style="fr" closed="false">17.26 </char><char style="fq" closed="false">Kubamwe </char><char style="ft" closed="false">bahhi</char></note>.”</para>
  <para style="p" vid="MAT 17:26">Yesu wakati kuwunli, “Kobva kuti bakololo bakasununguka<note caller="+" style="f"><char style="fr" closed="false">17.26 </char><char style="fq" closed="false">bakololo bakasununguka </char><char style="ft" closed="false">banhu babo abatolipa</char></note>. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Koga atitohaka bagwadzisa, iwe tjiyenda kugungwa, unoteya whobe newhuka, whobe yawunobhata kwekutanga ukayihhula nlomo nowhowana kuna loso linantengo upehhugwi; ubape ilo, unlipo wangu nawe.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Ndiyani Nkulu Pabamwe?</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mako 9.33-37</ref>; <ref loc="LUK 9:46-48">Luka 9.46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Lubaka igogo badiyiwa bakahha kuna Yesu bakati, “Ndiyani ungayi ndiye nkulu mubumambo gwekudzimu?”<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Yesu wakadana mwana ntjetjana, akawunsa pakati kwabo, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />eba eti, “Lebeswa ndoti kumuli, kuhhe kwekuti mungaba sebana batjetjana, amungafe mangina mubumambo gwekudzimu. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Kene yani unozwitebamisa semwana ntjetjana iwhoyu, iwhoyo ndiye nkulu mubumambo gwekudzimu. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Kene yani unowamutjila mwana wakajali muzina langu, unowamutjila imi.”<verse eid="MAT 18:5" /></para>
  <para style="s">Zwiliko Zwinothama kuti Nhu Atjinye</para>
  <para style="r">(<ref loc="MRK 9:42-48">Mako 9.42-48</ref>; <ref loc="LUK 17:1">Luka 17.1</ref>,<ref loc="LUK 17:2">2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />“Kene yani unothama kuti batjetjana ibaba banogalamoyo mundili batjinye, kowhoba kuhine kuwunli kuti kusungiligwe hongwe whuluwhulu pantshibha uwe ekoposegwa mugungwa. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Yakabangalaligwa hango, ngentha yezwiliko zwinota banhu bakatjinya! Ngobe kwakafanila kuti zwiliko zwihhe, koga ke wakabangalaligwa iwhoyo nhu tjiliko watjinohha ndiye!”<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />“Hapa luboko gugo kene gumbo lilo likuthama kuti utjinye, ulithubule ulilahe; ngobe kuhine kuti ungine mubupenyu ulitjilema kene uhudza, pana kuti uposegwe mumoto unopfuta nekusingapele unamaboko mabili nemakumbo mabili. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Hapa hhiho lilo lita kuti utjinye, ulikopole ulilahile kulekule. Kuhine kuti ungine mubupenyu nehhiho lin'ompela pana kuti uposegwe mumoto wegehena unameho mabili.”<verse eid="MAT 18:9" /></para>
  <para style="s">Tjifananidzo Tjemhwizi Yakalahika</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luka 15.3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />“Mube nemalebeswa kuti amutolingila pasi umwe webatjetjana ibaba; ngobe ndomubudza kuti kudzimu batumwa babo banogala balimbeli kwaTate bangu bakudzimu.” <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" /><note caller="+" style="f"><char style="fr" closed="false">18.11 </char><char style="ft" closed="false">Dzimwe whalo dzina vesi 11, ina matama amuna Luka 19.10.</char></note><verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />“Mokumbulani? Hapa nhu ana mhwizi dzili gulu, kukolahika in'ompela yadzo, atosiya dzimwe dzili makumi ali hhanalume nehhanalume kumatombo, enohaka in'ompela yakalahika? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Hapa eyiwana, lebeswa, ndoti kumuli, unoyihanhila kwazo kupinda yedziya dzili makumi ali hhanalume nehhanalume dzisatongolahika. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Ndizo ke Tate bangu bakudzimu abatoda kuti kene umwe webatjetjana ibaba alahike.”<verse eid="MAT 18:14" /></para>
  <para style="s">Hapa Umwe Nhu Atjinya</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />“Hapa gamu lilo lakutjinya, yenda kulili ulilayidze nlandu walo, muli babili. Hapa ekuwhilila, wawana gamu lilo. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Koga hapa esingakuwhilile, tola un'ompela kene babili zwabo mulebeleke naye, kuyetila kuti limwe nelimwe dama libe nebusupi gunobva kubasupi babili kene batatu. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Hapa elamba bawhilila, zibisani gubungano, hapa elamba whilila gubungano, ngaatjibe seNtaya kene nketisi kumuli.”<verse eid="MAT 18:17" /></para>
  <para style="s">Bvumila Nesabvumila</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />“Lebeswa, ndoti kumuli, kene ini tjamunosunga muhango tjowhosungwa kudzimu, kakale kene ini tjamunosunungula pasi muhango tjowhosunungugwa kudzimu.”<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />“Kakale, lebeswa ndoti kumuli, hapa babili benyu bebvumilana muhango nekwetjimwe tjinhu tjabanokumbila, banowhotjithamigwa naTate bangu bakudzimu. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Ngobe pakakubungana babili kene batatu muzina langu, imi ndiyapo bo pakati kwabo.”<verse eid="MAT 18:20" /></para>
  <para style="s">Tjifananidzo tjeNlanda Usingayetile Bamwe Mazwibhatigwa</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Phethiro wakakohha akati kuwunli, “He, gamu langu linganditjinyila kukadza kukaba kangana, ndiliyetila mazwibhatigwa? Ndingawuyetila mazwibhatigwa kukadza kukaba kutondeka?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yesu wakati kuwunli, “Anditoti kukuli kukadza kukaba kutondeka, koga kukadza kukaba makumi ali kutondeka akapamhiwa kakutondeka. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Ndizo ke bumambo gwekudzimu gungafananisiwa namambo wakayemula ziba kuti balanda babe banowukweleda kungapani. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Wakati etanga lingisisa, bakahhisa kuwunli umwe waka enakwelete tjematalenta<note caller="+" style="f"><char style="fr" closed="false">18.24 </char><char style="fq" closed="false">talenta </char><char style="ft" closed="false">unsindo wetshipi dzinonga zeezi, talenta lin'ompela laka lakalizana nema kg ali 30 </char></note> ali zwiwulu zwili gumi. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Nlanda esingatubule lipa kwelete, batezi babe bakati ngaatengesewe, kose nemfumakadzi uwe, nebana babe, nayiko kose kwaanako, mari yawanikwa ilipe kwelete. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Nlanda wakapfigama, akakumbila eti, ‘Mundiyetileni moyonlefu ndowholipa kose.’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Ngentha yewuwhila ngoni batezi benlanda bakawuyetila mazwibhatigwa kwelete, bakawunletja akayenda zwe.”<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />“Koga nlanda iwhoya zwe, ebhuda wakahangana newumwe webalanda waka anakwelete tjitje tjemaloso edinari<note caller="+" style="f"><char style="fr" closed="false">18.28 </char><char style="ft" closed="false">dinari lin'ompela laka lakalizana nenlipo wehhuba lin'ompela unopiwa n'hingi</char></note> ali gulu. Wakawundzipa pawhulo eti kuwunli, ‘Lipa kwelete tjangu ngwenuwali.’ <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Nlanda iwhoyo wakapfigama ekawunkumbilisisa eti, ‘Undiyetile moyonlefu, ndowhokulipa.’ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Koga wakalamba, akayenda naye akanowuhhalilila mujele kuswikila alipa kwelete tjitje. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Bamwe balanda baaka ehinga nabo, pabakabona tjayetikala bakagwadziwa kwazo, bakayenda bakanobudza mambo wabo kose kwayetikala. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Mambo akakotjiwundhana akati kuwunli, ‘Iwe nlanda mbi, ndakakuyetila mazwibhatigwa kwelete tjitjo tjose, ngobe wakandikumbila kuti ndikuyetile mazwibhatigwa. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Wawusakafanila whila ngoni bo umwe nlanda sawe, sekwandaka kuwhila ngoni bo?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Mambo wakamon'wa akawuhhalilila mujele, kuswikila alipa kwelete tjitje tjose.”<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />“Ndizo Tate bangu bakudzimu bo banowhothama bejalo kumwe newumwe wenyu hapa musingayetile makamu enyu mazwibhatigwa kubva mumimoyo yenyu.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Yesu Unodiya Nekwelambana Kwebakalobolana</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mako 10.1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Yesu wakati apedza lebeleka matama iyawa, akabva muGalile akayenda kuntunhu weJudiya, seli yaJorodani. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Banhu banjinji bakawuntobela, akabatjidza ikweno.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Bamwe baFarisi bakahha kuwunli bewhowunlika bebhuzwa beti, “Kumunlayo kuti nlume alambane nenkadzi uwe, ewunlambila kene ini zwako?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Yesu wakahandula eti, “Amuzobala kuti wakababumba kubvila kutangisa wakabathama wetjilume newetjikadzi, <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />kakale wakati, ‘Ngentha yayikoku nlume unowhosiya tatayi namayi akanamatilana nenkadzi uwe, bubili gwabo banowhoba nyama in'ompela’? <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Abatjibabili, koga batjiba nyama in'ompela. Ndizo ke tjabhatshanyiwa neNdzimu, ngakusibe nenhu unotjipalalanya.”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Bakati kuwunli, “Nentha yeni ngono Mozisi akalaya kuti nlume awumpe lukwalo gwelambana, ekoti ewuntata?”<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Wakati kubali, “Ngentha yebukukutu gwemimoyo yenyu Mozisi wakabvumila kuti mulambane nebakadzi benyu, koga kubvila kutangisa kwaka kusakajalo. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Kakale ndoti kumuli. Kene yani unolambana nenkadzi uwe, kuhhe kwekuti athama bupombgwe, eba elobola umwe, wathama bupombgwe.”<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Badiyiwa bakati kuwunli, “Hapa kuli kuti kwakajalo pakati kwenlume nenkadzi uwe, salobola kuhine.”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Koga Yesu wakabahandula eti, “Akuta banhu bose bangawamutjila ndebeleko iyeyi, kuhhe kwebakayipiwa koga. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Ngobe kuna ngomwa dzakazwagwa dzakajalo, kuna dzimwe dzakayetiwa ngomwa nebanhu, kakale kuna dzimwe ngomwa dzakazwithama ngomwa dziyetila bumambo gwekudzimu. Unotubula wamutjila tjidiyo itjetji, ngaatjiwamutjile.”<verse eid="MAT 19:12" /></para>
  <para style="s">Yesu Unokombolela Bana Batjetjana</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mako 10.13-16</ref>; <ref loc="LUK 18:15-17">Luka 18.15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Bamwe banhu bakahhisa bana batjetjana kuwunli kuti ababige maboko, koga badiyiwa babe bakabatjemela ibabo banhu. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Koga Yesu wakati, “Letjani bana bahhe kundili, musibadzibise; ngobe bumambo gwekudzimu ndegwebakajali.”<verse eid="MAT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15" />Wakababiga maboko, akamilika akayenda.<verse eid="MAT 19:15" /></para>
  <para style="s">Nhhuhha Wakafuma</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mako 10.17-31</ref>; <ref loc="LUK 18:18-30">Luka 18.18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Umwe wakahha kuwunli akati, “Ndhiyi, nditjipi tjiyeto tjibuya tjandakafanila thama kudze ndibe nebupenyu gusingapele?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Wakati kuwunli, “Unondibhuzwilani nekwetjibuya? Un'ompela koga umbuya. Hapa uhaka ngina mubupenyu gusingapele tjengeta milayo.”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Nhhuhha wakahandula eti, “Ipi?”</para>
  <para style="p" vid="MAT 19:18">Yesu wakati, “Usibulaye, usithame bupombgwe, usikwibe, usilebele nhu manyepwa, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />lemekedza tate babo na meyabo, kakale ude mbakidzani uwo nezila yawunozwida iwe.”<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Nhhuhha wakahandula eti, “Yose iyeyi ndakayitobela; ini tjandinotayila?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yesu wakati kuwunli, “Hapa uhaka ba nhu wakatambunuka, yenda unotengesa kose kwawunako, upe bahayi, nowhoba nefumwa kudzimu; ubuye, unditobele.”<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Nhhuhha wakati ewha ikoku, akayenda anabuyendasi; ngobe waka anafumwa njinji.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Yesu wakati kubadiyiwa babe, “Lebeswa, ndoti kumuli, kowholema kuti mfumi angine mubumambo gwekudzimu. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Ndopamha kakale, ndomubudza, kulelulelu kuti kamela lipalame muhuli yelunji, pana kuti mfumi angine mubumambo gweNdzimu.”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Badiyiwa babe pabakawha ikoku bakatjenama kwazo, bakati “Ngono ndiyani ungatjidziwa?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yesu wakabalinga akati kubali, “Nebanhu akutoyetika. Koga neNdzimu zwinhu zose zoyetika.”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Phethiro akaba eti kuwunli, “Bonani, iswi takasiya kose tikatobela imwi. Ngono towhowanani?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Yesu wakati kubali, “Lebeswa, ndoti kumuli, muhango tshwa, hapa Nkololo wenhu atjigala patjigalo tjitje tjegudzo, imwi makanditobela mowhogala bo pazwigalo zwili gumi nezwibili zwetonga, mutonga njudzi dzili gumi nembili dza Isirayeli. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Wose wakasiya mizi, kene bakuluyi kene banun'una kene hazwadzi, kene tatayi kene mayi, kene bana, kene minda, nentha yezina langu, unowhowamutjila kwakapamhiwa ka gulu kakale unowhodla nhaka yebutjilo gusingapele. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Koga banjinji bekutanga banowhoba bekupedzisila, bekupedzisila banowhoba bekutanga.”<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Bahingi Muminda Yemahhambi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“Bumambo gwekudzimu gonga mweni weminda wakabindukila mangwanana enohaka banhu bangawun'hingila muminda iye yemahhambi. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Hule kwebvumilana nabo kuti unowhobapa dinari hapa bahinga hhuba lose, wakabayendesa kuminda yemahhambi. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Wakati ebhuda eyenda zwe ne awa yebutatu kubvisila bhuda kwehhuba, akabona bamwe balimile panotengesegwa besina tjabanothama. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Wakati kubali, ‘Yendani bo kuminda yemahhambi, ndowhomupa kwandinobona kwakalizanila.’ Ndizo bakayenda. <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Wakapamha akabhuda kakale mu awa yebutanhatu neyebuhhanalume kubvisila bhuda kwehhuba, akayeta sayikoko zwako. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Mu awa yegumi lina kun'ompela kubvisila bhuda kwehhuba, akawana bamwe balimile basina tjabanothama, akati kubali, ‘Mumilileni ipapa hhuba lose musina tjamunothama?’ <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Bakati kuwunli, ‘Kungentha yekuti akuna watipa n'hingo.’ Iye eba eti kubali, ‘Namwi bo yendani kuminda yemahhambi.’ ”<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />“Abamadekwana mweni weminda yemahhambi wakati kuna unolinga minda nebahingi, ‘Dana bahingi bose ubape mibhayilo yabo, utange nebapedzisila, upedzisile nebatanga.’ <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Baka batangisa n'hingo mu awa yegumi lina kun'ompela kubvisila bhuda kwehhuba, bakati beswika umwe newumwe akawamutjidziwa dinari. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Kwakati ibabaya batanga, beswika, bakakumbula kuti banowhopiwa njinji; koga umwe newumwe wakawamutjidziwa dinari. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Bakati bewamutjila mbhayilo wabo bakan'un'urika kumweni weminda, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />beti, ‘Ibaba baswika kubupelo bahinga awa in'ompela, koga mabalizanya naswi tahwa tihinga hhuba lose ngeno hhuba litipisa.’ <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Koga wakahandula umwe wabo eti, ‘Nkwinya andizokutjinyila tjimwe; atizobvumilana dinari lin'ompela? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Tola kuko uyende, ludo gwangu kuti ndipe wapedzisila ngina mun'hingo kwakalizana nekwandakupa. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Anditobvumigwa yeta sekwandinoda netjinoba tjili tjangu? Kene nogwadziligwa kuti ndina moyo wakanaka?’ ”<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />Yesu wakafidza neti, “Ndizo bekupedzisila banowhoba bekutanga, bekutanga banowhoba bekupedzisila.”<verse eid="MAT 20:16" /></para>
  <para style="s">Yesu Unoleba Gwebutatu Nekwelufu Gugwe</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mako 10.32-34</ref>; <ref loc="LUK 18:31-34">Luka 18.31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Yesu wakati elimuzila eyenda kuJerusalema, akatola badiyiwa babe bali gumi nebabili ekayenda nabo ntome, ekababudza, akati kubali, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Whililani, toyenda kuJerusalema; Nkololo wenhu unowhotugwa kubaphirisiti bakulu nebakwali, bakawuntongela bulawa, <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />bekowuntula mumaboko eBataya kuti akuwelegwe, alobgwe ekotjikowhomegwa patjileyanyo. Muhhuba lebutatu unowhomusiwa kubafi.”<verse eid="MAT 20:19" /></para>
  <para style="s">Tjikumbilo Tjamayi Bebakololo baZebhede</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mako 10.35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Mayi bebakololo baZebhedi bakakohha kuwunli, bena bakololo babo, bakapfigama mbeli kukwe bakaba netjabanokumbila.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Wakati kubali, “Mohakani mme?”</para>
  <para style="p" vid="MAT 20:21">Bakati kuwunli, “Mundigadzebgwe kuti bakololo bangu ibaba babili banowhogala umwe kuludli gwenyu umwe kulumehwe gwenyu, mubumambo gwenyu.”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Yesu wakahandula eti, “Amutoziba tjamunokumbila. Mungatubula n'wa nkombe wandinowhon'wa?”</para>
  <para style="p" vid="MAT 20:22">Bakati kuwunli, “Totubula.”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Eba eti kubali, “Mowhon'wa nkombe wangu, koga kwegala kuludli gwangu nekulumehwe gwangu akuta imi unokubvumila, koga ndekwayibabo kwakwaka baakanyigwa naTate bangu.”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Bali gumi bakati bekuwha, bakagwadziligwa ibaba babili, nkuluyi nenun'una. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Yesu wakabadana bose akati kubali, “Moziba kuti banotonga Bataya banobatshambidzila, nebanobatungamila banohingisa masimba pehhugwi kwabo. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Akutowhojalo pakati kwenyu; koga kene yani unowhoba nkulu pakati kwenyu wakafanila ba n'hingi wenyu, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />kene yani unowhoba wekutanga pakati kwenyu wakafanila ba nlanda wenyu; <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />kene iye Nkololo wenhu haazobinga kuti awhohingigwa, koga wakahhila whohingila nepa butjilo gugwe kuti gube tjibhayilo tjesunungula banjinji.”<verse eid="MAT 20:28" /></para>
  <para style="s">Yesu Unotjidza Mapofu Mabili</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mako 10.46-52</ref>; <ref loc="LUK 18:35-43">Luka 18.35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Yesu nebadiyiwa babe bakati bebhuda muJerikho mbunga nkulunkulu ukawuntobela. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Kwaka kuna balume babili baka bali mapofu baka baligele ntome kwezila, pabakawha kuti Yesu unopinda nayipapo, bakatanga mimila beti, “He, nkololo waDavida, mutiwhile ngoni!”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Mbunga wakabatjemela uti ngabanyalale; koga ibo bakamimilila pehhugwi beti, “He, Nkololo waDavida, mutiwhile ngoni!”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Yesu wakama akabadana akati kubali, “Mohaka kuti ndimuyetileni?”<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Bakahandula beti, “He, tohaka kuti meho edu abone.”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Yesu wakabawhila ngoni, akabhata meho abo, tjinyolotjo bakabva babona, bakawuntobela.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Ngina kwaYesu saMambo muJerusalema</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mako 11.1-11</ref>; <ref loc="LUK 19:28-40">Luka 19.28-40</ref>; <ref loc="JHN 12:12-19">Johane 12.12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Bakati besedzela pedlo neJerusalema, batjiba panzi unoyi Bhethifeji, paDombo leMitoba, Yesu akatuma badiyiwa babili, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />eti kubali, “Yendani kunzi umbeli kwenyu mowhowana kakambe tjakasungiligwa tjina gondolo latjo; muzwisunungule mubuye nazo kundili. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Kukaba nenhu unoleba tjinhu kumuli, muhandule muti, ‘He banohaka zwihingisa,’ unowhozwiletja nekulibilidza.”<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Ikoku kwakayetikala kuti kuhhadzise tjakatjalebgwa nenlebesambeli eti,<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“Budza nkololokadzi weZiyoni uti,</para>
  <para style="q2" vid="MAT 21:5">linga, mambo uwo unohha kukuli,</para>
  <para style="q1" vid="MAT 21:5">Akazwitebamisa, akatanha kakambe,</para>
  <para style="q2" vid="MAT 21:5">negondolo, mhulu yekakambe.”<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Badiyiwa bakayenda, bakathama sekwabaka babudziwa naYesu. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Bakabuya nekakambe negondolo latjo, bakatilika zwiyambalo zwabo pehhugwi kwazo, Yesu akatanha. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Bunji gwebanhu bakawala zwiyambalo zwabo muzila, bamwe bekatema nhabi dzemiti bakadziwala muzila. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Mabunga aka eyenda mbeli kukwe ne aka ewuntobela, aka emimila eti, “Whosana<note caller="+" style="f"><char style="fr" closed="false">21.9 </char><char style="ft" closed="false">Dama letjiHhebheru linobva kuti “Tjidza!” lakaba dama lelumbidza</char></note> kuNkololo waDavida! Wakakombolegwa iye unohha muzina laHe! Whosana pehhugwihhugwi!”<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Wakati angina muJerusalema, nzi-nkulu wose wakadzongeka, banhu beti, “Ndiyani iwhoyu?”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Mabunga akahandula eti, “Ndi Yesu nlebesambeli unobva kuNazaretha, hango yeGalile.”<verse eid="MAT 21:11" /></para>
  <para style="s">Yesu Unongina muThempeli.</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mako 11.15-19</ref>; <ref loc="LUK 19:45-48">Luka 19.45-48</ref>; <ref loc="JHN 2:13-22">Johane 2.13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Yesu wakangina muthempeli akatata bose baka betengesa netenga muthempeli, akapitula mathebuli ebanhu baka betengesa mari nezwigalo zwayibabo baka betengesa njiba. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Wakati kubali, “Kwakakwagwa kuyi, ‘N'umba yangu inowhodan'wa iyi in'umba yetembezela’; koga imwi moyithama guwhu lembava.”<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Mapofu nezwilema bakabuya kuwunli muthempeli akabatjidza. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Koga baphirisiti bakulu nebakwali bakati bebona zwinhu zwinotjenamisa zwaaka ethama, nebana bemimila muthempeli, beti, “Whosana kuNkololo waDavida!” bakahhala buhongola; <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />bakati kuwunli, “Nowha tjabanoleba?”</para>
  <para style="p" vid="MAT 21:16">Yesu wakati kubali, “Ndowha; kati amuzotongobala lukwalo panoti, ‘Mumilomo yebana neyengawana kowhobhuda lumbidza kwakapelela’?”<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Yesu wakabasiya, akabhuda munzi-nkulu akayenda kuBhethani, akanoyizela ko busiku igogo.<verse eid="MAT 21:17" /></para>
  <para style="s">Yesu Unolonga Nkuyu bhiso</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mako 11.12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Mangwanana, obgwilila kunzi-nkulu, waka enahhala. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Wakati ebona nkuyu untome kwezila akayenda kuwunli, koga akuna tjaakanowana pawunli kuhhe kwemahhani woga. Wakati kuwunli, “Kusitjabe nentjelo unobhuda mukuli kene lini.” Tjinyolotjo nkuyu wakaswaba.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Badiyiwa pabakawumbona bakatjenama kwazo beti, “Nkuyu watjimbidza swaba tjini?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Yesu wakahandula eti, “Lebeswa, ndoti kumuli, hapa muna kugalamoyo musina kun'un'una, amutowhothama tjandathama kunkuyu koga, koga kene muti kudombo ileli, ‘Sipuka uposegwe mugungwa,’ kowhoyetikala. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Kene ini tjamunokumbila mumitembezelo, mowhotjiwamutjila, hapa muna kugalamoyo.”<verse eid="MAT 21:22" /></para>
  <para style="s">Mbhuzo nekweSimba laYesu</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mako 11.27-33</ref>; <ref loc="LUK 20:1-8">Luka 20.1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Yesu wakati atjingina muthempeli, baphirisiti bakulu nebawhola bakabuya kuwunli elipakati kwediya banhu, bakawumbhuzwa beti, “Zwinhu izwezwi nozwithama nesimba lipi, kakale ndiyani wakakupa simba ileli?”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yesu wakabahandula eti, “Ndowhomubhuzwa mbhuzo; mukandihandula, ndowhomubudza kuti kungesimba lipi ndithama zwinhu izwezwi. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Bvubika kwaJohane kwakakubva poni? Kwakakubva kudzimu kene kwakakubva kubanhu?”</para>
  <para style="p" vid="MAT 21:25">Bakakakabadzana tjekwabo beti, “Hapa tingati, ‘Kwakakubva kudzimu,’ iye unowhoti kutili, ‘Nentha yeni ngono musakagalamoyo muwunli?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Koga hapa tingati, ‘Kwakabva kubanhu,’ tohla lukawu gwebanhu; ngobe bose banogalamoyo kuti Johane waka eli nlebesambeli.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Ndizo ke bakahandula Yesu beti, “Atitoziba.”</para>
  <para style="p" vid="MAT 21:27">Iye wakati kubali, “Nami bo anditowhomubudza ke kuti kunge simba lipi ndithama zwinhu izwezwi.”<verse eid="MAT 21:27" /></para>
  <para style="s">Tjifananidzo Tjebakololo Babili</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />“Ngono mokumbulani? Nlume waka ena bakololo babili; akayenda kuna wekutanga akati, ‘Nkololo wangu yenda unohinga kuminda yemahhambi nasi.’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Wakahandula eti, ‘Anditohaka’; koga hule kwelubaka wakahandula nkumbulo akayenda. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Tate bakayenda kuna webubili bakaleba tjinhu itjo zwatjo; akahandula eti, ‘Ee ndoyenda tate,’ koga azoyenda. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Pabubili gwabo ndiwupi wakayeta kuda kwatate babe?”</para>
  <para style="p" vid="MAT 21:31">Bakati, “Wekutanga.”</para>
  <para style="p" vid="MAT 21:31">Yesu akakoti kubali, “Lebeswa, ndoti kumuli baketisi nemhombgwe banongina mubumambo gweNdzimu kumutangila. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Ngobe Johane wakahha kumuli ali muzila yendulamo, amuzowunghalamoyo, koga baketisi nemhombgwe bakawunghalamoyo; nekene makati makubona ikoku, amuzohanduka mukawunghalamoyo.”<verse eid="MAT 21:32" /></para>
  <para style="s">Tjifananidzo tjeBalimi Beminda Yemahhambi</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mako 12.1-12</ref>; <ref loc="LUK 20:9-19">Luka 20.9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />“Iwhani tjimwe tjifananidzo. Kwakakuna nlume wakalima minda yemahhambi, akayihoha akatsha gomba leswinila wayini, akabaka dumba lefulefu lebalindi, akakotjiyisayidza bamwe balimi, akabe eyenda kuyimwe hango. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Lubaka gweyibva kwemahhambi gwasedzela, wakatuma balanda babe kuna baakasayidza minda, kuti banopiwa iye mitjelo; <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />baakasayidza minda bakabhata balanda babe bakaloba un'ompela, bakabulaya umwe, baka khikithidza umwe nemabgwe. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Wakapamha tumila bamwe balanda, banjinji kupinda bekutanga; bakababhata zwakafanana nebekutanga. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Wakapedzisila netuma nkololo uwe, eti, ‘Banowhoba nemazwibhato kunkololo wangu.’ <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Koga bakati bebona nkololo, bakalebelesana beti, ‘Whoyu ndiye nghalinhaka; ayiwumbulayeni titole nhaka iye.’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Bakawumbhata bakawumposela kuhhe kweminda, bakawumbulaya.”<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />“Ngono hapa mweni weminda obuya unowhota etini kubanhu ibabo baaka asayidza minda?”<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Baphirisiti bakulu nebawhola bakahandula beti, “Unowhobabulaya zwinogwadza ibabo babi baaka asayidza minda, ekotola minda iye eyisayidza bamwe banowhowumpa mitjelo muzwibaka zweyibva kwayo.”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yesu wakati kubali, “Amuzotongobala dziwhalo.</para>
  <para style="q1" vid="MAT 21:42">“ ‘Bgwe ilo tjekwalo lakalambiwa nebabaki</para>
  <para style="q2" vid="MAT 21:42">ndilo latjiba bgwe linotambunudza mbako.</para>
  <para style="q1" vid="MAT 21:42">Ikoku kwaka kuli thama kwaHe;</para>
  <para style="q2" vid="MAT 21:42">kakale kohanhisa mumeho edu’ ”?<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />“Ndizo ke ndomubudza, bumambo gweNdzimu mowhogutolegwa gukapiwa njudzi dzinozwala mitjelo yago.” <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" /><note caller="+" style="f"><char style="fr" closed="false">21.44 </char><char style="ft" closed="false">dzimwe whalo whulukugwi dzina vesi 44. Wose nhu unowila pehhugwi kwebgwe ilelo unowhovunikana akaba zwipivu; koga hapa liwila nhu lowhupwanya.</char></note><verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Baphirisiti bakulu nebaFarisi bakati bewha zwifananidzo zwizwe bakaziba kuti waka eleba nekwabo. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Koga pabakayedza wunsunga, bakahla lukawu gwebanhu, ngobe banhu baka bewuntola senlebesambeli.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Tjifananidzo Tjenzano Webukwe</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luka 14.15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yesu wakalebeleka nabo kakale ehingisa zwifananidzo eti, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“Bumambo gwekudzimu gungafananisiwa namambo wakayetila nkololo uwe nzano webukwe. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Wakatuma balanda babe kuti banodana ibabo baka bakokewa kubukwe; koga baka basingahake hha. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Wakapamha akatuma bamwe balanda, eti kubali, ‘Mubudze ibabo bakokewa kuti zodliwa zwatjilulama. Mikono yangu yakakola yatjibulawa, kose kwatjilulama; tjihhani kunzano.’ <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Koga ibo abazotongoba nehanya nako, bakayendilambeli nemihingo yabo, umwe wakayenda kuminda iye, umwe akayenda kwaanotengesela. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Bamwe bakabhata balanda babe nezila inowhisa zogwadza, bakababulaya. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Mambo wakamon'wa, akatuma bagwi bengwa, bakanopaladza babulayi, bakapisa nzi-nkulu wabo. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Akakotjiti kubalanda babe, ‘Nzano webukwe watjilulamisiwa, koga bakokewa abazolizanila hha kunzano. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Tjiyendani mudzizila, mukoke nebunji bamunowhowana, kuti bahhe kunzano webukwe.’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Balanda ibabo bakayenda mudzizila bakakubunganya bose banhu babakawana, bakalulama nebakayipa; ndizo ke n'umba yenzano webukwe yakahhala bezi.”<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />“Mambo paakangina kuti anobona bezi, wakabona kuna umwe nlume usina tjiyambalo tjenzano webukwe. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Wakabhuzwa eti, ‘Nkwinya wangina tjini muno usina tjiyambalo tjenzano webukwe?’ Iye akahama koga. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Mambo eba eti kubahingi, ‘Muwunsunge maboko nemakumbo, muwumposele kuhhe muhhalima; imhomo banhu banowholila bakalobanya meno.’ <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Ngobe banjinji bakadan'wa, koga bahomanana bakahalugwa.”<verse eid="MAT 22:14" /></para>
  <para style="s">Mbhuzo Nekweluketo</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mako 12.13-17</ref>; <ref loc="LUK 20:20-26">Luka 20.20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Bafarisi bakayenda bakanolangana kuti bangawumbhatshila tjini muzwilebo zwizwe. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Bakatuma badiyiwa babo kuwunli, bena banhu baka beli batobeli baHherodi, beti, “Ndhiyi, toziba kuti imwi mumulebeswa, modiya zila yeNdzimu ngelebeswa, amuna hanya kuti nhu ndiyani; ngobe amuneni netjigalo tjenhu. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Tjitongotibudzani, mokubona tjini. Kumunlayo lipa luketo kuna Khesari, kene akuta munlayo?”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Koga Yesu, eziba bubi gwabo, wakati, “Imwi batjengeli! Mondilikilani? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Mundilakidze mari inolipisiwa luketo.”</para>
  <para style="p" vid="MAT 22:19">Bakawumpa loso<note caller="+" style="f"><char style="fr" closed="false">22.19 </char><char style="ft" closed="false">mutjiGiriki idinari</char></note>. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Yesu eba eti kubali, “Ibuso gwani igogu, kakale kwakakwagwa nekwayani mulili?”<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Bakahandula beti, “NdegwaKhesari.”</para>
  <para style="p" vid="MAT 22:21">Iye eba eti kubali, “Ipani Khesari kwaKhesari. Mupe kweNdzimu kuNdzimu.”<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Bakati bekuwha ikoku bakatjenama kwazo; bakamilika bakayenda bakawunsiya.<verse eid="MAT 22:22" /></para>
  <para style="s">Mbhuzo Nekwemuka Kubafi</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mako 12.18-27</ref>; <ref loc="LUK 20:27-40">Luka 20.27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Hhuba ilo zwalo kwakahha baSadusi kuwunli, ibo banoti akuna muka kubafi, bakawumbhuzwa, beti, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“Ndhiyi, Mozisi wakati, ‘Hapa nlume efa, esina bana, nun'una uwe wakafanila ngina tjilikadzi iyeyo, azwalile nkuluyi bana.’ <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Kwaka kuna bakololo benhu un'ompela bali kutondeka pakati kwedu; mbano yakatola nkadzi, ikakotjinyika basina bana, ikasiyila nun'una wayo nkadzi wayo. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Kwakayetikala sayikoko kuna wobubili newebutatu, kukajalo kudza kunoti kuna wekutondeka. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Hule kwayikoko nkadzi wakatjinyika bo. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Ngono pakumuka kubafi, nkadzi iwhoyo unowhobe wani? Ngobe bose bali kutondeka wakaba nkadzi wabo.”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yesu wakabahandula eti, “Makalahika, ngobe amutoziba whalo kene masimba eNdzimu. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Ngobe pakumuka kubafi abatjalobola kene lobogwa, koga beenga batumwa kudzimu. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Nekwemuka kwebafi, kati amuzobala tjakalebgwa neNdzimu kumuli, eti, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Ndimi Ndzimu wa Abhurahhamu, Ndzimu wa Isaka, Ndzimu waJakobe’? Haata Ndzimu webakafa, koga ndewebapenyu.”<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Mbunga pawakawha ikoku, bakatjenamisiwa nediya kukwe.<verse eid="MAT 22:33" /></para>
  <para style="s">Nlayo Nkulu</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mako 12.28-34</ref>; <ref loc="LUK 10:25-28">Luka 10.25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />BaFarisi pabakawha kuti wanyaladza baSadusi, bakakubungana. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Umwe wabo, nzibi wenlayo, wakawumbhuzwa ewunlika, eti, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Ndhiyi ndiwupi nlayo unkulu kupinda yose?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Yesu wakahandula eti, “ ‘Ida He Ndzimu uwo nemoyo uwo wose, nemeya iyo yose nange nkumbulo uwo wose.’ <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Whoyu ndiwo nlayo nkulu kakale uli wekutanga. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Wobubili wakafanana nawo. ‘Ida mbakidzani uwo nezila yawunozwida iwe.’ <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Nlayo wose nebalebesambeli kwakabambiwa pehhugwi kwemilayo iyeyi mibili.”<verse eid="MAT 22:40" /></para>
  <para style="s">Mbhuzo nekwaMesiya</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mako 12.35-37</ref>; <ref loc="LUK 20:41-44">Luka 20.41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />BaFarisi batjakakubungana panhu pan'ompela, Yesu wakababhuzwa, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />eti, “Mokumbulani nekwaKhirisitu? Unkololo wani?”</para>
  <para style="p" vid="MAT 22:42">Bakahandula beti, “Unkololo waDavida.”<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Yesu wakababhuzwa eti, “Nentha yeni ngono, Davida, paaka afemegwa neMeya unowundhana He, eti,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />“ ‘He wakati kuna He wangu,</para>
  <para style="q2" vid="MAT 22:44">Gala kuluboko gwangu gweludli,</para>
  <para style="q2" vid="MAT 22:44">Ndidze ndise zwita zwizo kusi kwemakumbo awo’?<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Ngono hapa kuli kuti Davida wakawundhana eti, He, unokoba nkololo uwe tjini?”<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Akuna wakatubula wun'handula, kubva ilelo hhuba akuna wakatongolika wumbhuzwa mibhuzo kakale.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Yesu Unoleba NekwebaFarisi Nebakwali</para>
  <para style="r">(<ref loc="MRK 12:38">Mako 12.38</ref>,<ref loc="MRK 12:39">39</ref>; <ref loc="LUK 11:43">Luka 11.43</ref>,<ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45">20.45</ref>,<ref loc="LUK 20:46">46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Yesu wakakotjiti kubadiyiwa babe nekumabunga, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“Bakwali nebaFarisi banogala patjigalo tjaMozisi; <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />ndizo yetani kakale mulondolodze kene ini tjabanomubudza, koga kusi tjabanoyeta; ngobe abatoyeta tjabanosumikila. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Banosunga mitolo inolema, isingasengeke, beyikhiga pamapfudzi ebanhu; ibo tjekwabo besingade yimilidza kene nelunyala gwabo. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Banoyeta zwiyeto zwabo zose kuti babon'we nebanhu; banothama mamwandabula anokwagwa mavesi abanombala pamhahha nepaluboko, akaba mapabipabi, nezwitjakala zwezwiyambalo zwikaba zwilefulefu. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Banoda bugalo gwebanhu banagudzo panobe pedliwa kakale banoda piwa zwigalo zwakanaka mumasinagogu. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Banohanhila lezwewa nezila inolemekedza munhanga dzetengesela, kakale banoda dan'wa beyi ndhiyi. <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Koga imwi musidan'we muyi ndhiyi, ngobe ndhiyi wenyu un'ompela, imwi mumakamu mose. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Musidane nhu muti tate muhango ino, ngobe munaTate ban'ompela, bakudzimu. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Kakale musidan'we muyi he, ngobe he wenyu un'ompela, ndiKhirisitu. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Unkulu pakati kwenyu unowhoba n'hingi wenyu. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Kene yani unozwimilidza unowhotebamisiwa, unozwitebamisa unowhomilidziwa.”<verse eid="MAT 23:12" /></para>
  <para style="s">Butjengeli Gwabo</para>
  <para style="r">(<ref loc="MRK 12:40">Mako 12.40</ref>; <ref loc="LUK 11:39-42">Luka 11.39-42</ref>,<ref loc="LUK 11:44">44</ref>,<ref loc="LUK 11:52">52</ref>; <ref loc="LUK 20:47">20.47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“Koga kwakamubangalalila imwi bakwali nebaFarisi, batjengeli! Ngobe mohhalilila banhu bumambo gwekudzimu; ngobe imwi tjekwenyu amutongina kakale amutobvumila bangangina kuti bangine.” <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" /><note caller="+" style="f"><char style="fr" closed="false">23.14 </char><char style="ft" closed="false">Dzimwe whalo dzosa matama amuna </char><char style="xt"><ref loc="MRK 12:40">Mak 12.40</ref></char> na <char style="xt"><ref loc="LUK 20:47">Luk 20.47</ref></char>Kwakamubangalalila imwi bakwali nebaFarisi, batjengeli! Ngobe motolela njhilikadzi fumwa, moyeta mitembezelo milefulefu muzwitisa. Mowhowan'wa nlandu nkulunkulu.</note><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />“Kwakamubangalalila imwi bakwali nebaFarisi, batjengeli! mokalabula makungwa nehango kuti muhandule un'ompela abe ndhiyiwa welunamato gweTjiJuta, eti hapa ahanduka mukowunthama kuti abe nkololo wegehena kwakapamhiwa kabili kupinda kwamuli iko.”<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />“Kwakamubangalalila imwi mapofu ebatungamili, moti, ‘Hapa nhu etuna nethempeli akutoleba tjimwe; koga hapa nhu etuna nezeezi lethempeli, watjisungwa netuna kukwe.’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Imwi zwilengwe zwemapofu! Ndikupi kukulu, zeezi kene thempeli lakayengemadza zeezi? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Moti, ‘Hapa nhu etuna netjibeso tjepisila zwibhayilo akuta tjimwe; koga hapa nhu etuna netjipo tjipatjibeso tjepisila zwibhayilo watjisungwa netuna kukwe.’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Imwi mapofu! Ndikupi kukulu, tjipo kene tjibeso tjepisila zwibhayilo tjinoyengemadza tjipo? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Ndizo unotuna netjibeso tjepisila zwibhayilo, unotuna natjo nayiko kose kupehhugwi kwatjo; <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />newunotuna nethempeli, unotuna nalo nawhoyo unogala mulili; <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />newunotuna nekudzimu, unotuna netjigalo tjeNdzimu kose nawhoyo unogala patjili.”<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />“Kwakamubangalalila imwi bakwali nebaFarisi, batjengeli! ngobe mopa tjegumi tjeminti, nedili nekumini, matjisiya zwinhu zwenlayo zwinatjilemela. Kusumikilisa<note caller="+" style="f"><char style="fr" closed="false">23.23 </char><char style="fq" closed="false">kusumikilisa </char><char style="ft" closed="false">ndulamo</char></note> nemawhilangoni nebugalimoyo; kose ikoku moba makakuthama, musingasiye kumwe. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Imwi mapofu ebatungamili, mowungunula nhuzi kuti musin'we hambgwa, koga mumidza kamela!”<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />“Kwakamubangalalila imwi bakwali nebaFarisi, batjengeli! ngobe mosuka kuhhe kwenkombe, nakuhhe kwendilo, koga mukati kuli hhele bubava nepupa. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Iwe bhofu leMfarisi! suka mukati kwenkombe namukati kwendilo kutanga, kuyetila kuti nakuhhe kutjene bo.”<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />“Kwakamubangalalila imwi bakwali nebaFarisi, batjengeli! ngobe makafanana nezwikumbu zwitjenatjena zwakadzulugwa kuhhe nekalaga, kuhhe zolingika zwakanaka kwazo koga mukati zwihhele mafupa ebanhu bakafa nehambgwa yose. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Ndizo namwi bo kuhhe molingika makalulama kubanhu, koga mukati muhhele butjengeli, nebubi.”<verse eid="MAT 23:28" /></para>
  <para style="s">Yesu Unolebesambeli Nekwelobgwa Kwabo</para>
  <para style="r">(<ref loc="LUK 11:47-51">Luka 11.47-51</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“Kwakamubangalalila imwi, bakwali nebaFarisi, batjengeli! ngobe mobakila zwikumbu zwebalebesambeli, munakisa zwikumbu zwebakalulama, <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />muti, ‘Tiloba takatitjila mumahhuba abobatategulu bedu toba tisakabvumilana nabo mukutebula malopa ebalebesambeli.’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Mukujalo mopa busupi, kuti mubakololo bayibabo bakabulaya balebesambeli. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Tjiyendilani mbeli ke, mupedzise tjakatangisiwa nabobatategulu benyu. <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Imwi nyoka, bana bezwipakupaku, mungadzeta tjini sumikilisiwa kunomuyendesa kugehena? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Ndizo ke ndomutumila balebesambeli, nebatjenjebvu nebakwali, bamwe babo mowhobabulaya mukabakowhomela patjileyanyo, bamwe mowhobaloba mumasinagogu enyu mukabavima muwumwe newumwe nzi, <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />kuyetila kuti malopa ebakalulama bose akatebugwa muhango abe pehhugwi kwenyu, kubvisila kumalopa a Abheli nlume waka asina nlandu kunoswika kumalopa aZakhariya nkololo waBharakhiya, wamakabulayila pakati kwebugalo gwakayengemala netjibeso tjepisila zwibhayilo. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Ndolebesa, ndoti kumuli, kose ikoku kowhohha pehhugwi kwetjizekugwana itjetji.”<verse eid="MAT 23:36" /></para>
  <para style="s">Da Jerusalema KwaYesu</para>
  <para style="r">(<ref loc="LUK 1:34">Luka 1.34</ref>,<ref loc="LUK 1:35">35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“Jerusalema, Jerusalema, unobulaya balebesambeli kakale nokhikitidza nemabgwe bawunotumigwa! Kukangana ndihaka kubunganya bana babo sesetje inokuzwa zwikukwana zwayo kusi kwemaphaphiro ayo, koga iwe usingahake! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Tjilinga, n'umba iyo yatjifupatigwa, yabedongo. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Ndokubudza, awutjondibona kakale, udza uti, ‘Wakakombolegwa iye unohha muzina laHe.’ ”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Yesu Unoleba Nekwekolomogwa kweThempeli.</para>
  <para style="r">(<ref loc="MRK 13:1">Mako 13.1</ref>,<ref loc="MRK 13:2">2</ref>; <ref loc="LUK 21:5">Luka 21.5</ref>,<ref loc="LUK 21:6">6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Yesu wakabhuda muthempeli oyenda, badiyiwa babe pabakahha bowunlakidza zwibakwa zwethempeli. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Wakabahandula eti, “Mokubona kose ikoku, amutokubona? Lebeswa, ndoti kumuli, akuna bgwe linowhosala lilipehhugwi kwelimwe ipapa, lisingowholigigwa pasi.”<verse eid="MAT 24:2" /></para>
  <para style="s">Mamanikano neDziyidziwa</para>
  <para style="r">(<ref loc="MRK 13:3-13">Mako 13.3-13</ref>; <ref loc="LUK 21:7-19">Luka 21.7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Wakati egala paDombo leMitoba, badiyiwa babe bakahha kuwunli baliboga bakabhuzwa beti, “Mutibudzeni, kowhobe kuli lini, kakale tjilakidzilo tjinolakidza hha kwenyu nekuti bupelo gwelubaka gweesedzela, tjowhobe tjili tjipi?”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yesu wakabahandula eti, “Mutjenjele kuti kusibe nenhu unomulaha. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Ngobe banjinji banowhohha muzina langu, beti, ‘Ndimi Khirisitu,’ banowholaha banhu banjinji. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Mowhowha nekwengwa nebunyebenyebe nekwengwa; musilobgwe nehana ngobe zwinhu izwezwi zwakafanila yetikala, koga bupelo gowhoba gutjawhohha. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Tjaba tjowhomukila tjimwe tjaba, nebumambo gowhomukila gumwe bumambo, kowhoba nedzihhala<note caller="+" style="f"><char style="fr" closed="false">24.7 </char><char style="fq" closed="false">nedzihhala </char><char style="ft" closed="false">nebhamba</char></note> netengenyeka kwehango mumitunhu yakasiyana. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Kose ikoku konga tanga gwadza kwemimba.”<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />“Banowhomulonga mukudziyidzika, bakamubulaya; tjaba tjose tjowhomuhema ngentha yezina langu. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Banjinji bawhofupatila bugalimoyo gwabo, bakatengesana bakahemana. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Kowhohha balebesambeli bemanyepwa banjinji bakatungamilila banjinji ntome<note caller="+" style="f"><char style="fr" closed="false">24.11 </char><char style="fq" closed="false">bakatungamilila banjinji ntome </char><char style="ft" closed="false">bakalaha banhu banjinji</char></note>. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Ngentha yekuti bubi gowanda, ludo gwebanji gowhotelela. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Koga iwhoyo unosimidzila kukadza kukaba kubupelo unowhotjidziwa. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Ndebo mbuya iyeyi yebumambo inowhosumikigwa hango yose, sebusupi kunjudzi dzose; bupelo gukotjihha.”<verse eid="MAT 24:14" /></para>
  <para style="s">Lubaka Gwakayipa</para>
  <para style="r">(<ref loc="MRK 13:14-23">Mako 13.14-23</ref>; <ref loc="LUK 21:20-24">Luka 21.20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“Hapa mubona pabugalo gwakayengemala kwabemile mbipo inohemesa yepaladza, yakalebgwa nenlebesambeli Daniyeli, (unobala ngaawhisise), <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />ibabo bamuJudiya ngabatihhile kumatombo; <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />ukutjilungwane ngaasijite kuti anotola tjimukati kwen'umba iye; <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />umuminda ngaasihanduke kuti awhotola tjiyambalo tjitje. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Koga kowhobabangalalila ibabo bakazwisenga nebanomwisa mumahhuba iyawo! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Mutembezele kuti tihha kwenyu kusibe mulubaka gwembaba, kene kuli sabatha. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Ngobe kowhoba nedziyidzika kukulu, kusakatongoba yapo kubvisila pakutanga kwehango kudza kuba ngwenuwali, akutowhopamha kukabeyapo kakale. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Kadzene mahhuba iyawo aka asathubugwa, kwakusingawhoba nenhu unotjidziwa; koga nentha yebakahalugwa mahhuba iyawo anowhothubugwa.”<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />“Kukaba nenhu unoti kumuli, ‘Lingani, whoyu Khirisitu!’ kene ‘Whoyaa!’ musikugalemoyo ikoku. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Ngobe kowhohha boKhirisitu bemanyepwa nebalebesambeli bemanyepwa, banowhothama zwilakidzilo nematjenamiso makulu, beyetila laha banhu, hapa kutubuka, kene nebakahalugwa bo. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Lingani, ndamubudza lubaka gusanhu gwaswika.”<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />“Hapa beti kumuli, ‘Lingani, umutjilabanyika,’ musiyende ko; hapa beti, ‘Lingani, umun'umba dzamukati,’ musikugalemoyo ikoku. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Ngobe sepenya kwethari kubva kubhehhuba kunobonekwa kukadza kukanoti kumahwahhuba, hha kwenkololo wenhu kowhojalo bo.”<verse eid="MAT 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28" />“Kene poni pana tjakafila po<note caller="+" style="f"><char style="fr" closed="false">24.28 </char><char style="fq" closed="false">tjakafila po </char><char style="ft" closed="false">ntumbu</char></note>, magola anowhokubungana po.”<verse eid="MAT 24:28" /></para>
  <para style="s">Buya kweNkololo Wenhu</para>
  <para style="r">(<ref loc="MRK 13:24-27">Mako 13.24-27</ref>; <ref loc="LUK 21:25-28">Luka 21.25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“Tjinyolotjo hule kwedziyidzika kwemahhuba iyawo hhuba lowhoti zwi, mwedzi awutowhobantjena, nyenyedzi dzowhowa dzibva kudzimu, masimba ekudzimu anowhozunguzika; <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />kokotjiboneka tjilakidzilo tjeNkololo wenhu kudzimu, ipapo ke njudzi dzose dzemuhango dzowholila, kakale dzowhobona Nkololo wenhu ehha eli mumakole ekudzimu anamasimba negudzo gulu. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Unowhotuma batumwa beNdzimu babe nensindo nkulu welunyanga, ngono banowhokubunganya bahalugwa babe kubva kumabhiko mana ehango, kubva kugumwe bupelo gwekudzimu kunoti kugumwe.”<verse eid="MAT 24:31" /></para>
  <para style="s">Tjidiyo Tjenkuyu</para>
  <para style="r">(<ref loc="MRK 13:28-31">Mako 13.28-31</ref>; <ref loc="LUK 21:29-33">Luka 21.29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“Diyikani tjidiyo kubva mutjifananidzo wenkuyu. Hapa lutabi gwenkuyu guba gunyolo, gutangisa sinila mahhani, mobva maziba kuti tjilimo tjeesedzela. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Kwakajalo bo ke, hapa mubona zwinhu zose izwezwi, zibani kuti waba<note caller="+" style="f"><char style="fr" closed="false">24.33 </char><char style="ft" closed="false">waba. Kungabviwa nhu kene lubaka</char></note> pedlo, waba pankoba. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Lebeswa, ndoti kumuli, tjizekugwana itjetji atjitowhopela zwinhu zose izwezwi zwidza zwiyetikala. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Kudzimu nehango kowhopinda, koga matama angu atowhopinda.”<verse eid="MAT 24:35" /></para>
  <para style="s">Akuna Unoziba Hhuba Nelubaka</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mako 13.32-37</ref>; <ref loc="LUK 17:26-30">Luka 17.26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“Koga akuna unoziba nekwehhuba ilelo nelubaka igogo kuhhe kwaTate boga, kene ibo batumwa bekudzimu, kene iye Nkololo. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Sekwakwaka kuli iko mumahhuba aNowa, hha kweNkololo wenhu kowhojalo bo. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Ngobe semumahhuba iyawo kusanhu kwaswika nkubila, baka bedla ben'wa, belobola belobogwa, kudza kuswika hhuba lakangina Nowa mukepe, <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />abazotongoziba tjimwe kudza kuswika nkubila ukabatola bose. Ndizo ke hha kweNkololo wenhu kowhojalo bo. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Mulubaka igogo balume babili banowhoba beli muminda, kowhotogwa un'ompela kukasala un'ompela. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Bafumakadzi babili banowhoba bali paduni bekhwa; kowhotogwa un'ompela umwe akasiyiwa. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />Ndizo ke, tjenjelani, mulinde ngobe amutoziba kuti He wenyu unohha hhuba lipi. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Koga zibani whoku, kuti kadzene mweni wenzi waka aziba kuti mbava inohha muna gupi lubaka busiku, unoba akalinda akasabvumila kuti mbava ingine mun'umba. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Ndizo ke namwi bo galani makazwilulamisa; ngobe Nkololo wenhu unowhohha mulubaka gwamusingakumbulile.”<verse eid="MAT 24:44" /></para>
  <para style="s">N'hingi Unogalikabgwe kene Usingagalikebgwe</para>
  <para style="r">(<ref loc="LUK 12:41-48">Luka 12.41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“Ndiwupi ke n'hingi wakatjenjela unogalikabgwe, wayi nahe uwe alinge bahingi benzi, kuti abape zodliwa mulubaka gwakafanila? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Wakakombolegwa iwhoyo n'hingi unowhowanika nahe uwe ethama sayikoku pahanduka kukwe. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Lebeswa, ndoti kumuli, unowhowunthama mbhati wezwinhu zose zwaanazo. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Koga hapa iwhoyo n'hingi ali n'hingi mbi, ekoti tjemumoyo, ‘He wangu wanonoka handuka,’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />ekotangisa loba bamwe bahingi baanohinga nabo, edla kakale en'wa nebalaladzi, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />he wen'hingi iwhoyo unowhohha muhhuba n'hingi iwhoyo laasingakumbulile nemulubaka gwaasingazibe. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />He uwe unowhowumpalulanya, akawunsa kubugalo gun'ompela nebatjengeli; ikweno banhu banowhokuwa bekalobanya meno ngentha.”<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Tjifananidzo Tjebasikana Bali Gumi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />“Bumambo gwekudzimu gungafananisiwa nebasikana bali gumi bakatola zwivoneko zwabo kuti banohanganidza nkwaha. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Bahanu babo baka beli zwilengwe, bahanu baka bakatjenjela. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Bezwilengwe bakatola zwivoneko, bakasatola mafuta; <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />koga bakatjenjela bakatola mafuta bakasa muzwidla nemuzwivoneko. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Nkwaha wakanonoka swika, bakadza bakatshumwayila bakadza bakayizela.”<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />“Kwakati kwabapakati kwebusiku kukamimigwa kuyi, ‘Lingani, nkwaha! bhudani muwun'hanganidze.’ <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Basikana bose bakamuka, bakalulamisa zwivoneko zwabo. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Bezwilengwe bakati kubakatjenjela, ‘Mutipeni bo mafuta, ngobe zwivoneko zwedu zweedzima.’ <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Koga bakatjenjela bakahandula beti, ‘Swiyo akasitilizane iswi namwi; kuhine muyende kuna banotengesa muzwitengele enyu.’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Bakati bayenda benotenga, nkwaha akasala eswika, baka bakazwilulamisa bakangina naye mun'umba yenzano webukwe; kukahhaligwa nkoba.”<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />“Hule kwelubaka basikana ibabaya bamwe bakahanduka, beti, ‘He, He, mutihhulile.’ <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Koga wakahandula eti, ‘Lebeswa, ndoti kumuli, imwi anditomuziba.’ ”<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />“Galani makamilila, ngobe amutoziba hhuba nelubaka.”<verse eid="MAT 25:13" /></para>
  <para style="s">Tjifananidzo Tjebalanda Batatu</para>
  <para style="r">(<ref loc="LUK 19:11-27">Luka 19.11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />“Bumambo gwekudzimu gowhofanana nekuti nenhu wakati eyenda gwendo akadana balanda babe akabatjengetesa fumwa iye. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Umwe wakawumpa matalenta<note caller="+" style="f"><char style="fr" closed="false">25.15 </char><char style="fq" closed="false">matalenta </char><char style="ft" closed="false">talenta laka lipinda nlipo wemakole ali gumi nemahanu waka ulipiwa n'hingi</char></note> mahanu, umwe akawumpa mabili umwe akawumpa lin'ompela, bose kuyendidzana netubula kwabo. Eba eyenda. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Tjinyolotjo wakaapiwa matalenta mahanu wakabva ayenda enohaba nawo; akawunzwalila amwe mahanu. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Sayikoko bo, iwhoya waka ana mabili wakathama amwe mabili. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Koga iwhoya waka apiwa lin'ompela wakalitshila pasi, akasumbika mari yahe uwe.”<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />“Hule kwemahhuba manjinji he webalanda ibabo wakahanduka, akabadana kudze abone kuti bakasala behinga tjini. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Iwhoya waka awamutjila matalenta mahanu wakabuya, ehhisa amwe mahanu pehhugwi, eti, ‘He, makandisiyila matalenta mahanu; ndakathama amwe mahanu pehhugwi kwawo.’ <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />He uwe wakahandula eti, ‘Wakathama zwakanaka nlanda mbuya unogalikabgwe; wagalikabgwe muzwinhu zwihomanana; ndowhokuthama ntjengeti wezwinhu zwinjinji, buya uhanhe nahe uwo.’ <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Iwhoya waka awamutjila mabili wakabuya akati, ‘He, makandisiyila matalenta mabili; ndakathama amwe mabili pehhugwi kwawo.’ <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />He uwe wakahandula eti, ‘Wakathama zwakanaka nlanda mbuya unogalikabgwe; wagalikabgwe muzwinhu zwihomanana; ndowhokuthama ntjengeti wezwinhu zwinjinji, buya uhanhe nahe uwo.’ <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Waka apiwa talenta lin'ompela wakabuya akati, ‘He, ndomuziba kuti munlume unamoyo nkukutu, mokowha pamusakadzwala, mowolela pamusawulusa; <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />ndaka ndihla, ndikanda ndikanovukidzila talenta lenyu mumavu, yeleli tolani lagala lili lenyu.’ <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Koga he uwe wakawun'handula eti, ‘Iwe hhisimbe lenlanda mbi! Waka uziba kuti ndokowha pandisakadzwala, kakale ndowolela pandisawulusa? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Kadzene waka wayendisa mari yangu kubhenki kudza nditi ndihanduka ndiyiwane yazwala. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Muwuntolele talenta ilelo mupe unamatalenta aligumi. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Ngobe wose nhu unako unowhopiwa kunjinji, akaba nekwakawanda; koga usina, nayikoko kwaanako unowhokutolegwa. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Poselani nlanda iwhoyu usina bhatsho muhhalima likuhhe; ikweno banhu banowhokuwa bakalobanya meno.’ ”<verse eid="MAT 25:30" /></para>
  <para style="s">Tongwa Kwebupelo</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“Hapa Nkololo wenhu obuya ali mugudzo lile, batumwa beNdzimu bose banaye, ipapo unowhogala patjigalo tjitje tjegudzo. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Njudzi dzose dzowhokubungana mbeli kukwe, iye unowhodzipalalanya senlisi ethewula mhwizi mumbudzi. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Unowhosa mhwizi kuludli gugwe, koga mbudzi unowhodzisa kulumehwe. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Mambo unowhoti kuna ibabo bakuludli gugwe, ‘Ihhani ngeno imwi bakakombolegwa baTate bangu, wamutjilani bumambo gwamakabaakanyigwa kubvila hango payakabumbiwa. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Ngobe ndaka ndinahhala mukandipa zodliwa, ndaka ndinanyota mukandipa vula, ndaka ndilimwezi mukandiwamutjila mumizi yenyu, <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />ndakandiyenda mbudlo mukandimbadza, ndakandigwala mukandikumba, ndaka ndili mujele mukahha kundili.’ <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Bakalulama banowhohandula beti, ‘He, kati takamubona lini munahhala tikamupa zodliwa, kene munanyota tikamupa vula? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Takamubona lini mulimwezi tikamuwamutjila mumizi yedu, kene mulimbudlo tikamumbadza? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Takamubona lini mugwala, kene muli mujele timukumba?’ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Mambo unowhohandula eti, ‘Lebeswa, ndoti kumuli, sekwamakayeta kuwumwe untukunu wemakamu angu iyawa, makakuyeta kundili.’ ”<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />“Unowhoti kuna ibabo bakulumehwe gugwe, ‘Yendani kutjena nami, imwi bakalongwa bhiso, muyende kumoto usingadzime, wakabaakanyigwa satane nebatumwa babe; <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />nekuti ndaka ndinahhala amuzondipa zodliwa, ndaka ndinanyota amuzondipa vula. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Ndaka ndilimwezi amuzondiwamutjila mumizi yenyu, ndilimbudlo amuzondimbadza, ndigwala nendilimujele amuzondikumba.’ <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Banowhohandula bo beti, ‘He kati takamubona lini munahhala kene munanyota kene mulimwezi kene makati piti kene mugwala kene mulimujele, tikasamubhatsha?’ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Iye unowhobahandula eti, ‘Lebeswa, ndoti kumuli, sekwamusakayetila umwe ntukunu wayibaba, amuzokuyeta kundili.’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Banowhoyendesewa kulangiwa kusigapele, koga bakalulama mubupenyu gusingapele.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Banolangana kuti babulaye Yesu</para>
  <para style="r">(<ref loc="MRK 14:1">Mako 14.1</ref>,<ref loc="MRK 14:2">2</ref>; <ref loc="LUK 22:1">Luka 22.1</ref>,<ref loc="LUK 22:2">2</ref>; <ref loc="JHN 11:45-53">Johane 11.45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Kwakayetikala kuti Yesu apedza badiya kose ikoku, wakati kubadiyiwa babe, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Moziba kuti hule kwemahhuba mabili kowhoba kwabe nzano wePhasika, Nkololo wenhu unowhotugwa kubanhu kuti bawunkowhomele patjileyanyo.”<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Baphirisiti bakulu nebawhola bakakokubungana palubahhe gwemphirisiti upehhugwi unoyi Khayiyafasi, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />bakalangana kuti basunge Yesu nezila yakasumbikala bawumbulaye. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Koga bakati, “Tisikuthame nzano uli pakati ngobe banhu bangabva bemusa hhoba.”<verse eid="MAT 26:5" /></para>
  <para style="s">Yesu Unohhodzewa paBhethani</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mako 14.3-9</ref>; <ref loc="JHN 12:1-8">Johane 12.1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Yesu paaka ali muBhethani, mun'umba yaSimoni wakatongoba anabugwele gwemapele, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />etjadla, kukahha kuwunli nkadzimayi akasenga kumbwana tjakatiwa nebgwe linoyi alabhasita, tjemafuta anantengo upehhugwi, akaadululila pan'holo uwe. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Koga badiyiwa babe bakati bekubona ikoku, bakamon'wa beti, “Anozanisigwani zwingapa? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Ngobe mafuta iyawa aangatengesewa nentego upehhugwi mari yawan'wa ikapiwa bahayi.”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Koga Yesu, ekuziba ikoku, wakati kubali, “Modziyidzilani nkadzimayi iwhoyu? Kana wathama zwakanaka kundili. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Bahayi mogala munabo lubaka gose, koga imi amutowhoba nami tjoselele. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Dululila mafuta mumbili wangu kwaathama, wakuyetila ndilulamisila mbiganyo wangu. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Lebeswa, ndoti kumuli, kene poni panowhosumikigwa ndebo mbuya muhango yose, ikoku kwayetiwa nenkadzimayi iwhoyu kowholebgwa nekwako, kuli tjikumbuludzo nekukwe.”<verse eid="MAT 26:13" /></para>
  <para style="s">Judasi Unobvuma Tengesa Yesu</para>
  <para style="r">(<ref loc="MRK 14:10">Mako 14.10</ref>,<ref loc="MRK 14:11">11</ref>; <ref loc="LUK 22:3-6">Luka 22.3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Ipapo umwe webadiyiwa babe baligumi nebabili, waka eyi Judasi Isikariyoti, wakayenda kubaphirisiti bakulu, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />akababhuzwa eti, “Mowhondipani hapa ndingamupa iye?” Bakawunlipa nezwipivu zwesiliva zwili makumi matatu. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Kubvisila lubaka igogo wakahaka lubaka gwakatambunuka kuti awuntengese.<verse eid="MAT 26:16" /></para>
  <para style="s">Yesu Unodla Tjilayilo tjePhasika neBadiyiwa Babe</para>
  <para style="r">(<ref loc="MRK 14:12-21">Mako 14.12-21</ref>; <ref loc="LUK 22:7-13">Luka 22.7-13</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Johane 13.21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Muhhuba lekutanga lenzano weTjinkwa Tjisina Mbidzo, badiyiwa bakahha kuna Yesu, bakati, “Mohaka kuti tinomubaakanyila poni kuti mudle zodliwa zwephasika?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Wakati, “Yendani kuwumwe nlume munzi-nkulu, muwumbudze muti, ‘Ndhiyi unoti, lubaka gwangu gwatjiswika; ndowhodlila phasika kun'umba iyo nebadiyiwa bangu.’ ”<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />Badiyiwa bakathama sebudziwa kwabo naYesu, bakabaakanya zodliwa zwephasika.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Kwakati kwatjibe madekwana aligele pazodliwa ena badiyiwa babe bali gumi nebabili; <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />bakati bedla, akati, “Lebeswa, ndoti kumuli, umwe wenyu unowhonditengesa.”<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Bakahhigwa nebuyendasi kwazo, umwe newumwe akati kuwunli, “Kungaba imi, He?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Yesu wakahandula eti, “Iwhoyo waseba nami mundilo ndiye unowhonditengesa. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Nkololo wenhu unoyenda sekwakwaka kwagwa nekukwe, koga kwakawubangalalila iwhoyo nlume unowhotengesa Nkololo wenhu! Kwakowhoba kuhine hapa iwhoyo nlume waasakazwagwa.”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Judasi, iwhoyo wakawuntengesa, wakati, “Kungaba imi, Ndhiyi?”</para>
  <para style="p" vid="MAT 26:25">Yesu wakahandula eti, “Wajalo.”<verse eid="MAT 26:25" /></para>
  <para style="s">Tjilayilo tjaHe</para>
  <para style="r">(<ref loc="MRK 14:22-26">Mako 14.22-26</ref>; <ref loc="LUK 22:14-20">Luka 22.14-20</ref>; <ref loc="1CO 11:23-25">1 BaKhorinte 11.23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Bakati betjadla, Yesu akatola tjinkwa, akaboka kuNdzimu, akatjipemula, akaswiswa badiyiwa babe, eti, “Tolani, idlani; umbili wangu iwhoyu.”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Wakatola nkombe, akati atjiboka, akabaswiswa eti, “In'wani muwunli, mose; <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />ngobe iyawa malopa angu etjibvumilano, anotebuligwa banjinji kuti bayetigwe mazwibhatigwa matjinyo. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Ndomubudza anditjowhon'wa kakale kwemitjelo yemahhambi, kudza kuba ilelo hhuba landinowhokun'wa kuli kutshwa ndinamwi mubumambo gwaTate bangu.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Bakati batjimba lumbo gwakakwagwa, bakabhuda bakayenda kuDombo leMitoba.<verse eid="MAT 26:30" /></para>
  <para style="s">Yesu Unolebesambeli Landugwa Kukwe naPhethiro</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mako 14.27-31</ref>; <ref loc="LUK 22:31-34">Luka 22.31-34</ref>; <ref loc="JHN 13:36-38">Johane 13.36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Yesu wakati kubali, “Mubusiku gwanasi mose mowhopalala ngentha yangu; ngobe kwakakwagwa kuti, ‘Ndowhobulaya nlisi, mhwizi dzengubi dzikapalala.’ <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />Hule kwemusiwa kwangu, ndowhobambeli kwenyu kuyenda kuGalile.”<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Phethiro wakahandula, eti, “Nekene bose bepalala ngentha yenyu, imi andingamusiye.”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Yesu wakati kuwunli, “Lebeswa, ndoti kukuli, igogu busiku gwanasi, gukurume lisanhu lalila, nowhoba watjindilandula katatu.”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Phethiro wakati kuwunli, “Kene kulifa namwi, anditowhomulandula.”</para>
  <para style="p" vid="MAT 26:35">Bose badiyiwa babe bakajalo bo.<verse eid="MAT 26:35" /></para>
  <para style="s">Yesu Unotembezela muGetshemani</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mako 14.32-42</ref>; <ref loc="LUK 22:39-46">Luka 22.39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Yesu wakayenda nebadiyiwa babe kubugalo gunoyi Getshemani, akati kubadiyiwa babe, “Galani pano, nditjanotembezela hapayaa.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Wakatola Phethiro nebakololo baZebhedi babili, akatangisa hhigwa nebuyendasi nedziyidzika. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Akaba eti kubali, “Meya yangu ihhele buyendasi kwazo, kuswikila mulufu; galani pano, mulinde nami.”<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Wakamilika akayenda nhambwana, akapfigama akakotama buso gukakunha pasi, akatembezela, eti, “Tate bangu, hapa kuyetikala, nkombe iwhoyu ngawundipinde; koga ke, kusi ngekuda kwangu, koga kuli kuda kwenyu.”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Wakabgwilila kubadiyiwa babe akabawana bakayizela; akaba eti kuna Phethiro, “Makonegwa tubula linda nami kwe awa in'ompela koga? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Lindani mutembezele kudze musingine mukulikwa, meya inoda, koga nyama ayina masimba.”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Yesu wakapamha gobubili, akabva pabali akanotembezela eti, “Tate bangu, hapa kuli kuti nkombe iwhoyu awungapinde ndisawun'wa, kuda kwenyu ngakuyetikale.” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Wakabgwilila kakale akabawana bakayizela, ngobe bakabekuligwa newhope.<verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />Ebva kakale pabali, wakayenda kutjena nabo akanotembezela gobutatu, epamha matama iwo zwawo. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Wakabgwilila kubadiyiwa babe akati kubali, “Mutjilele munyaluluka zwenyu? Lingani, lubaka gwatjiswika, Nkololo wenhu unotengesewa mumaboko ebatjinyi. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Milikani, ayindeni; lingani, ntengesi wangu waswika.”<verse eid="MAT 26:46" /></para>
  <para style="s">Sungwa kwaYesu</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mako 14.43-50</ref>; <ref loc="LUK 22:47-53">Luka 22.47-53</ref>; <ref loc="JHN 18:3-12">Johane 18.3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Wakati etjalebeleka, kwakaswika Judasi, umwe webaligumi nebabili, ehha nembunga webanhu bakasenga mabhangatjeke nedziswimbo, bebva kubaphirisiti bakulu nebawhola bebanhu. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Ntengesi waka abapa tjilakidzilo, eti, “Iwhoyo wandinowhoputa ndiye; muwumbhate.”<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />Wakasedzela kuna Yesu nekulibilidza, akati, “Kunyalala kumuli, Ndhiyi!” Akawumputa.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Yesu wakawun'handula eti, “Nkwinya, wabingani pano?”</para>
  <para style="p" vid="MAT 26:50">Ipapo bakabuya bakawumbhata bakayenda naye. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Umwe webaka bena Yesu wakahomola bhangatjeke neluboko, akatema nlanda wemphirisiti nkulu, akawunthubula zebe. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Ipapo Yesu wakati kuwunli, “Bgwiliza bhangatjeke lilo pabugalo gwalo; ngobe bose banohingisa bhangatjeke banowhopaladziwa nebhangatjeke. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Nokumbula kuti ndingakonegwa kumbila kuna Tate bangu, tjinyolotjo banowhonditumila mabunga ebagwi bengwa ali gumi nemabili ebatumwa beNdzimu? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Ngono dzinga hhadzisika tjini whalo dzinoti kwakafanila kuti kube sayikoko?”<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Mulubaka igogo Yesu wakati kulukawu gwebanhu, “Mabhuda makasenga mabhangatjeke nedziswimbo kunga kunoyi monobhata hhibava koga muwhobhata imi? Hhuba nehhuba ndakagala muthempeli ndidiya, koga amuzotongondibhata. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Koga kose ikoku kwayetikala, kuti kuhhadzisike whalo dzebalebesambeli.”</para>
  <para style="p" vid="MAT 26:56">Ipapo badiyiwa babe bose bakawunsiya bakatihha.<verse eid="MAT 26:56" /></para>
  <para style="s">Yesu ali paLubahhe</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mako 14.53-65</ref>; <ref loc="LUK 22:54">Luka 22.54</ref>,<ref loc="LUK 22:55">55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13">Johane 18.13</ref>,<ref loc="JHN 18:14">14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Bakabasunga Yesu bakawuntola bakayenda naye kuna Khayiyafasi mphirisiti upehhugwi, paka patjikubungana bakwali nebawhola. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Koga Phethiro wakabatobela elitjakulenyana, akadza akanoswika mun'ha wemphirisiti upehhugwi, wakangina bo, akanogala pasi nebalindi kudze abone kuti ini tjinowhoyetikala. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Baphirisiti bakulu nelubahhe gose bakahaka busupi gwemanyepwa gwaka gungathama kuti Yesu abulawe, <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />koga bakaguhaya, nekutobe kwakahha basupi banjinji bewunlebela manyepwa. Kubupelo kwakahha balume babili mbeli, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />bakati, “Iwhoyu nlume wakati, ‘Ndotubula kolomola thempeli leNdzimu, ndikalibaka mumahhuba matatu.’ ”<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Mphirisiti upehhugwi wakamilika akati kuna Yesu, “Awuna n'handulo? Ini ikoku kunolebgwa nebalume ibaba nekuko?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Koga Yesu wakanyalala. Mphirisiti upehhugwi wakati kuwunli, “Ndokutunisa neNdzimu mpenyu, utibudze kuti kene ndiwe Khirisitu, Nkololo weNdzimu.”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Yesu wakawun'handula eti, “Majalo. Koga ndomubudza, kubva lubaka igogu mowhobona Nkololo wenhu aligele kuludli gweMasimba, ehha ali mumakole ekudzimu.”<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Ipapo mphirisiti upehhugwi wakapalula zwiyambalo zwizwe, akati, “Watuka Ndzimu. Titjahakilani basupi? Mawha tuka Ndzimu kwaathama. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Motini nekukwe?”</para>
  <para style="p" vid="MAT 26:66">Bakahandula beti, “Iwhoyu wakafanila fa.”<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Bakakotjiwumpfila mubuso, bakawunloba; bamwe bakawupwawhula, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />beti, “Lebesambeli, iwe Khirisitu! Ndiyani wakuloba?”<verse eid="MAT 26:68" /></para>
  <para style="s">Phethiro Unolandula Yesu</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mako 14.66-72</ref>; <ref loc="LUK 22:56-62">Luka 22.56-62</ref>; <ref loc="JHN 18:15-18">Johane 18.15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Phethiro waka aligele kuhhe mun'ha. Kwakahha n'hingikadzi kuwunli akati, “Nawebo wawuna Yesu Nghalile.”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Koga iye wakakulamba mbeli kwabo bose, eti, “Anditoziba kuti noleba nekweni.” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Akabva ipapo akayenda mugutukutu, umwe n'hingikadzi akawumbona, akati kubanhu baka balimile ipapo, “Iwhoyu nlumetate wayena Yesu wekuNazaretha.”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Wakapamha akalamba, etuna, eti, “Anditowunziba iwhoyo nlume.”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Kwapela lubakanyana baka belimile ipapo bakati kuna Phethiro, “Lebeswa iwe uwumwe wabo, ngobe lebeleka kuko kolakidza kujalo.”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Iye wakatanga tukana ntome etuna eti, “Anditowunziba iwhoyo nlume.”</para>
  <para style="p" vid="MAT 26:74">Tjinyolotjo gukurume liba lilila. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Phethiro eba ekumbula matama alebgwa naYesu, eti, “Gukurume lisanhu lalila, nowhondilandula katatu.” Akabhuda ipapo akayenda kuhhe akanolila zwinogwadza.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Yesu Unoyendesewa kuna Pilatu</para>
  <para style="r">(<ref loc="MRK 15:1">Mako 15.1</ref>; <ref loc="LUK 23:1">Luka 23.1</ref>,<ref loc="LUK 23:2">2</ref>; <ref loc="JHN 18:28-32">Johane 18.28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Mangwanana ngwanana, bose baphirisiti bakulu nebawhola, bakalangana kuti Yesu abulawe. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Bakawunsunga bakayenda naye kuna Pilatu, mbhati wentunhu.<verse eid="MAT 27:2" /></para>
  <para style="s">Zwisungilila kwaJudasi</para>
  <para style="r">(<ref loc="ACT 1:18">Mihingo 1.18</ref>,<ref loc="ACT 1:19">19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Judasi, ntengesi, paakaziba kuti Yesu wawanikwa nlandu, wakazwisola, akabgwiliza makumi matatu ezwipivu zwesiliva kubaphirisiti bakulu nebawhola, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />eti, “Ndatjinya netengesa lopa lisina nlandu.”</para>
  <para style="p" vid="MAT 27:4">Ibo bakawun'handula beti, “Tineni nako iswi? Ndekuko whoko.”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Judasi wakalahila pasi zwipivu zwesiliva muthempeli, akabva ipapo, akayenda akanozwisungilila.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Koga baphirisiti bakulu bakatola zwipivu zwesiliva, bakati “Akuta munlayo kuti mari iyeyi tiyibige mukwama tjemari ngobe imari yelopa.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Ndizo bakalangana, bakatenga minda yembumbi wehali, kuti kube ipo pabanobiganyila bahhi. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Ndizo nanasi minda iyeyo inodan'wa kuyi Minda yeLopa.<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />Ipapo kwakahhadzisika tjakalebgwa nenlebesambeli Jeremiya, eti, “Bakatola zwipivu zwili makumi matatu zwesiliva, unoba uli ntengo uwe wakawalebgwa nebamwe bakololo ba Isirayeli, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />bakatenga nawo minda yembumbi wehali, sekwandakalayiwa naHe.”<verse eid="MAT 27:10" /></para>
  <para style="s">Pilatu Unobhuzwanya Yesu</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mako 15.2-5</ref>; <ref loc="LUK 23:3-5">Luka 23.3-5</ref>; <ref loc="JHN 18:33-38">Johane 18.33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Yesu wakama mbeli kwembhati wentunhu; mbhati wentunhu akawumbhuzwa eti, “Ndiwe Mambo wemaJuta?”</para>
  <para style="p" vid="MAT 27:11">Yesu wakahandula eti, “Wajalo.” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Koga paakatilikiwa nlandu nebaphirisiti bakulu nebawhola akuna tjaakahandula.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />Pilatu wakati kuwunli, “Kati awutowha kuti minjinji tjini milandu yabanokutilika?”<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />Koga iye azotongohandula, kene iwo nlandu un'ompela; kwakayeta kuti mbhati wentunhu atjename kwazo.<verse eid="MAT 27:14" /></para>
  <para style="s">Yesu Unotongegwa Bulawa</para>
  <para style="r">(<ref loc="MRK 15:6-15">Mako 15.6-15</ref>; <ref loc="LUK 23:13-25">Luka 23.13-25</ref>; Johane 18.39-19.16)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Panzano mbhati wentunhu waka ana nlenje wesunungula nsungwa un'ompela waka ekumbigwa nebanhu. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Mulubaka igogo kwaka kuna nsungwa waka eli tjihwarahwara kwazo, waka eyi Bharabhasi<note caller="+" style="f"><char style="fr" closed="false">27.16 </char><char style="fq" closed="false">Bharabhasi </char><char style="ft" closed="false">dzimwe whalo whulukugwi dzoti Yesu Bharabhasi</char></note>. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Bakati bakubungana panhu pan'ompela Pilatu akati kubali, “Mohaka kuti ndimusunungulile yani? Bharabhasi<note caller="+" style="f"><char style="fr" closed="false">27.17 </char><char style="fq" closed="false">Bharabhasi </char><char style="ft" closed="false">dzimwe whalo whulukugwi dzoti Yesu Bharabhasi</char></note> kene Yesu unodan'wa eyi Khirisitu?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Ngobe waka eziba kuti bawunsungisa ngentha yendandala.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Pilatu wakati etjigele patjigalo tjetonga milandu, mfumakadzi uwe akawuntumila whi, eti, “Kusibe netjimwe tjinhu tjawunothama pehhugwi kwenlume iwhoya wakalulama, ngobe nasi ndadziyidzika kwazo nekukwe muwoloto.”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Baphirisiti bakulu nebawhola bakatetedza banhu kuti bakumbile sununguligwa Bharabhasi, Yesu abulawe. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Mbhati wentunhu wakapamha kakale akati kubali, “Pabubili gwabo ndiwupi wamunohaka kuti ndisunungule?”</para>
  <para style="p" vid="MAT 27:21">Bakahandula beti, “Bharabhasi.”<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Pilatu wakababhuzwa eti, “Ngono ndikotjithamani naYesu, iye unodan'wa eyi Khirisitu?”</para>
  <para style="p" vid="MAT 27:22">Bose bakati, “Ngaakowhomegwe.”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Iye wakati, “Nentha yeni, wayetani tjakayipa?”</para>
  <para style="p" vid="MAT 27:23">Koga bakamimilila pehhugwi beti, “Ngaakowhomegwe.”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Pilatu paakabona kuti akuna tjakunobhatsha, kakale kwemuka hhoba wakatola vula akangula maboko mbeli kwebunga lebanhu eti, “Imi andina nlandu nekwelopa lenlume iwhoyu; mukuthame imwi.”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Banhu bose bakahandula, beti, “Lopa lile ngalibe pehhugwi kwedu nebana bedu!”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Wakabasunungulila Bharabhasi, kukati atjiwunloba Yesu, akabaswiswa iye kuti banowukowhomela.<verse eid="MAT 27:26" /></para>
  <para style="s">Bagwi Bengwa Banokuwelela Yesu.</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mako 15.16-20</ref>; <ref loc="JHN 19:2">Johane 19.2</ref>,<ref loc="JHN 19:3">3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Bagwi bengwa bembhati wentunhu bakakotjitola Yesu, bakangina naye mun'umba yembhati wentunhu, bakakubunganya bagwi bose mbeli kukwe. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Bakawumbula zwiyambalo zwizwe bakawumbadza ngubo yembala welubende. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Bakaluka tjiyala tjemimhiwa bakawumbadza mun'holo, bakawumbhatisa luhanga muluboko gugwe gweludli. Bakatanga pfigama mbeli kukwe bewunseka beti, “Ngaakudziwe, Mambo wemaJuta.” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Bakawumpfila mate, bakawuntolela luhanga bakawunloba nago mun'holo. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Bakati bapedza wunkuwelela, bakawumbula ngubo bakawumbadza zwiyambalo zwizwe bakawuntola bakayenda naye kuti banowunkowhomela.<verse eid="MAT 27:31" /></para>
  <para style="s">Yesu Unokowhomegwa paTjileyanyo</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mako 15.21-32</ref>; <ref loc="LUK 23:26-43">Luka 23.26-43</ref>; <ref loc="JHN 19:17-27">Johane 19.17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Bakati bebhuda bakahangana nenlume wekuKhureni, zina lile eyi Simoni; nlume iwhoyu bakawumbhata nemasimba kuti awunsengele tjileyanyo tjitje. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Bakati baswika pabugalo gunoyi Goligotha (kunobva kuti bugalo gwepepe tjen'holo), <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />bakawumpa wayini yakahanganyiwa nendulu kuti an'we; koga wakati ayilabila akalamba yin'wa. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Bakati batjiwunkowhomela patjileyanyo, bakakobana zwiyambalo zwizwe ngekandila malipa; <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />bakagala ipapo bakawunlinda. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Pehhugwi kwen'holo uwe bakakwala nlandu uwe, kwakakwagwa kuti, “Iwhoyu ndiYesu, Mambo wemaJuta.” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Bakakowhomela mbava mbili ntome kukwe, imwe kuludli gugwe imwe kulumehwe gugwe.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />Banhu baka bepinda ipapo baka bedzungudza miholo bewuntuka, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />beti, “Iwe unokolomola thempeli ukolibaka mumahhuba matatu, uzwitjidze! Hapa uli Nkololo weNdzimu, jita patjileyanyo.”<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Nebaphirisiti bakulu, bena bakwali nebawhola, baka bewunseka, beti, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Wakatjidza bamwe koga iye atotubula zwitjidza. NdiMambo weIsirayeli, ngaatjijita patjileyanyo, ndiko kwatinowhogalamoyo muwunli. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Unogalabgwe kuNdzimu; Ndzimu ngaawuwangulile ke ngwenuwali, hapa ewundha; ngobe waka eti, ‘NdiNkololo weNdzimu.’ ”<verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />Nembava bo dzakakowhomegwa naye dzakawugongobola bo nezila iyo zwayo.<verse eid="MAT 27:44" /></para>
  <para style="s">Lufu gwaYesu</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mako 15.33-41</ref>; <ref loc="LUK 23:44-49">Luka 23.44-49</ref>; <ref loc="JHN 19:28-30">Johane 19.28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Ne awa yebutanhatu kubvisila bhuda kwehhuba kwakaba nehhalima hango yose kukadza kukanoswika awa yebuhhanalume kubvisila bhuda kwehhuba. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Ne awa yebuhhanalume kubvisila bhuda kwehhuba, Yesu wakadanilila newhi lipehhugwi, eti, <char style="tl">“Eloyi, Eloyi lama sabakathani?”</char> kunobva kuti, “Ndzimu wangu, Ndzimu wangu, mandisiyilani?”<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Bamwe banhu baka balimile ipapo bakati bekuwha ikoku bakati, “Nlume iwhoyu unodana Elija.” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Umwe wabo wakalabuka akatola lungudze, akagubvubika muwayini inohababa, akagubhayila paluhanga, akawunswiswa kuti an'we.<verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />Koga bamwe bakati, “Tongoma, letja tibone kuti Elija unowhobuya kene ewhowuntjidza.”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Yesu wakalila kakale newhi lipehhugwi akafema kwebupelo, meya iye ikabhuda.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Jila letjisitilo tjethempeli lakapaluka likaba kabili, kutangisila pehhugwi kudza kunoti pasi. Hango yakazunguzika, hongwe dzikapatuka pakati, <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />zwikumbu zwakahhulika, nemibili yebayengemali bakabafa yakamusiwa bakaba bapenyu. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Bakabhuda muzwikumbu, hule kwemuka kukwe, bakangina munzi-nkulu wakayengemala bakabon'wa nebanji.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Nlawuli webagwi bengwa bali gulu nebaaka anabo, bakalinda Yesu, bakati bebona tengenyeka kwehango, nekose kwakayetikala, bakahla kwazo, bakati, “Lebeswa iwhoyu wayeli Nkololo weNdzimu!”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Kwaka kuna bafumakadzi banjinji ipapo, bakalingilila bali tjakulenyana, baka batebela Yesu kubva kuGalile, bewumbhatsha muzwimwe zwinhu. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Pakati kwabo kwaka kuna Mariya wekuMagadala, naMariya mayi baJakobe naJosefa, namayi bebakololo baZebhedi.<verse eid="MAT 27:56" /></para>
  <para style="s">Biganyiwa kwaYesu</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mako 15.42-47</ref>; <ref loc="LUK 23:50-56">Luka 23.50-56</ref>; <ref loc="JHN 19:38-42">Johane 19.38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Kwakati kwatjitewuka, kukaswika nlume waka akafuma weku Arimathiya, zina lile eyi Josefa, waka ali ndhiyiwa waYesu bo. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Nlume iwhoyu wakayenda kuna Pilatu akanokumbila mbili waYesu. Pilatu wakalaya kuti awumpiwe. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Josefa wakatola mbili, akawumpombela nejila lelineni buyanana, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />akawumbiganya mukumbu tjitje tjitshwa, tjaaka atsha muhongwe; wakakunguludzila hongwe whuluwhulu pankoba wekumbu, akamilika akayenda. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Mariya wekuMagadala newumwe Mariya bakabelipo bo, beligele bakalingisana nekumbu.<verse eid="MAT 27:61" /></para>
  <para style="s">Balindi Bakalinda Kumbu</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Hhuba linotobela, kuleba kuti, kwapinda hhuba leBaakanyila, baphirisiti bakulu nebaFarisi bakakubungana kuna Pilatu, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />bakati, “He, titjakumbula kuti ntjebeli iwhoya wakatini, atjimpenyu, wakati, ‘Hule kwemahhuba matatu ndowhomuka kakale.’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Ndizo ke layani kuti kumbu tjitje tjilindiwe zwakasima kudza kunoti hhuba lebutatu, kuyetila kuti badiyiwa babe basihhe bewhowunkwiba, bekobudza banhu, beti ‘Wamuka kubafi,’ ngobe butjebeli gwekupedzisila gowhoyipa kupinda gwekutanga.”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Pilatu wakati kubali, “Tolani bagwi bengwa banolinda, muyende munotjilinda sekwamungatubula.”<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />Ndizo bakayenda bakanodzibilila kumbu ngebuwila hongwe yakatjihhalila nelonga balindi kuti batjilinde.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Muka Kubafi kwaYesu</para>
  <para style="r">(<ref loc="MRK 16:1-10">Mako 16.1-10</ref>; <ref loc="LUK 24:1-12">Luka 24.1-12</ref>; <ref loc="JHN 20:1-10">Johane 20.1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Kwatjipinda sabatha, kotangisa hhuba lekutanga letshipi, Mariya wekuMagadala newumwe Mariya bakayenda benobona kumbu. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Kwakabe nekutengenyeka kwehango kukulu; ngobe ntumwa waHe wakajita ebva kudzimu akahha akakunguludzila kutjena hongwe yaka yakazwina kumbu akagala pehhugwi kwayo. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Bon'wa kukwe waka epenya sethari, zwiyambalo zwizwe zwili zwitjenatjena semakaha. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Nentha yehlisa kukwe balindi bakatetema bakanga banhu bakafa.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Ntumwa weNdzimu wakalebeleka nebafumakadzi akati, “Musihle; ndoziba kuti mohaka Yesu waka akakowhomegwa patjileyanyo. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Atapo pano; wamuka, seleba kukwe. Ihhani mubone bugalo paalilele. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Tjiyendani nekulibilidza munobudza badiyiwa babe kuti wamuka kubafi, umbeli kwenyu kuyenda kuGalile; mowhonowumbona ikweno. Ndatjimubudza.”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Bakabva pakumbu nekulibilidza balihhele hla koga bakahanha kwazo, bakalabuka benobudza badiyiwa babe.<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />Ngono Yesu wakabahanganidza akati, “Dumilani!” Bakasedzela bakapfigama bakabhata makumbo awe, bakawunamata. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Yesu akakotjiti kubali, “Musihle; yendani munobudza makamu angu kuti ayende kuGalile, banowhondibona ikweno.”<verse eid="MAT 28:10" /></para>
  <para style="s">Balindi Banolondesedza Zwayetikala.</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Bafumakadzi bakati bayenda, bamwe bebalindi bakayenda kunzi-nkulu, bakanobudza baphirisiti bakulu zose zwayetikala. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Hule kwekuti baphirisiti bakulu bakubungana nebawhola bakalangana kuti bate betini, bakapa bagwi bengwa mari njinji, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />bakati kubali, “Mubudze banhu muti, ‘Badiyiwa babe bakabuya busiku bakakhwiba mbili uwe iswi tililele.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Hapa ikoku kungaswika muzebe dzembhati wentunhu, towholebeleka naye iswi akagutshikana kuti imwi amuna nlandu.”<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Balindi bakatola mari bakathama sekwabaka babudziwa; ndebo iyeyi yakahhala mumaJuta kudza kuba nasi.<verse eid="MAT 28:15" /></para>
  <para style="s">Yesu Unozwilakidza kuBadiyiwa Babe</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mako 16.14-18</ref>; <ref loc="LUK 24:36-49">Luka 24.36-49</ref>; <ref loc="JHN 20:19-23">Johane 20.19-23</ref>; <ref loc="ACT 1:6-8">Mihingo 1.6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Badiyiwa bali gumi newun'ompela bakayenda kuGalile, kudombo Yesu laaka ababva kuti bayende kulili. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Bakati bewumbona, bakawunamata; koga bamwe bakabvubvuma. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Yesu wakasedzela kubali akalebeleka nabo eti, “Simba lose lekudzimu nemuhango latjipiwa imi. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Tjiyendani ke munothama badiyiwa benjudzi dzose, mubabvubike muzina laTate, neleNkololo neleMeya Yakayengemala. <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Mubadiye kuti balondolodze kose kwandakamulaya; lingani, ndinamwi lubaka gose, kudza kunoti kubupelo gwelubaka.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>