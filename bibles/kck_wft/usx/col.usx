<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">- Kalanga Bible Translation</book>
  <para style="ide">65001 - Unicode (UTF8)</para>
  <para style="h">BaKolose</para>
  <para style="toc1">Lukwalo gwaPhawuli ekwalila BAKOLOSE</para>
  <para style="toc2">BaKolose</para>
  <para style="toc3">BaK</para>
  <para style="mt2">Lukwalo gwaPhawuli ekwalila</para>
  <para style="mt1">BAKOLOSE</para>
  <para style="imt">Tjinginiso</para>
  <para style="ip">
    <char style="bk">Lukwalo gweBaKolose </char> gwakakwagwa naMpositoli Phawuli (BaKolose 1.1). Wakagukwala ali mujele, angaba waka ali muRoma. Wakagukwala hule kwemakole angaba makumi ali matanhatu Khirisitu azwagwa. Lukwalo gweBaKolose kan'ompela negweBaEfesu negweBaFiliphi kose negwaFilimoni, dzodan'wa kuyi whalo dzemujele saku Phawuli akadzikwala alimujele. Wakakwala lukwalo igogu ekwalila gubungano lebagalimoyo limunzi-nkulu weKolose. Phawuli haazotongotangisa gubungano lebagalimoyo muKolose, seleba kukwe (BaKolose 2.1) koga wakazwipa nlandu kuti alitjengetedze. Kungayetika kuti ndi Ephafurasi wakalitangisa saku waka ebva kuKolose.</para>
  <para style="ip">Phawuli waka emanikanyiwa nediya kwemanyepwa kwakakuyetika mugubungano lebagalimoyo likuKolose. Wakaleba kwazo nekwako mulukwalo. Kungaba kwaka kuna MaKhirisitu emaJuta aka ehaka kuti amwe MaKhirisitu atobele milayo yetjiJuta inobva muThesitamente Whulukugwi, kwazokwazo nlayo wethumbigwa. Phawuli unokusa patjena kuti MaKhirisitu kudze awamutjigwe neNdzimu anohaka Khirisitu koga (BaKolose 1.15-20) nekuti zwidiyo zwinobva mumikumbulo yebanhu azwina tjazwinobhatsha (BaKolose 2.8).</para>
  <para style="iot">Nlongoloso Yezwimukati</para>
  <para style="io1">Phawuli unotangisa nebuyisa gubungano lebagalimoyo bekuKolose (BaKolose 1.1-2)</para>
  <para style="io1">Phawuli unokwala nekwebukulu gwaKhirisitu, kwazokwazo akalingisana nediya kwemanyepwa muKolose (BaKolose 1.3-3.4)</para>
  <para style="io1">Semudzimwe whalo njinji dzaPhawuli, kubvila pakati kunoti kubupelo gwelukwalo unopa milayo yakalingisana netjila kweMaKhirisitu kubuya (BaKolose 3.5-4.6)</para>
  <para style="io1">Phawuli unofidza nebuyisa nelaya kuti lukwalo igogu gubagwe mu amwe makubungano ebagalimoyo (BaKolose 4.7-18)</para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />Kubva kuna Phawuli mpositoli waKhirisitu Yesu ngekuda kweNdzimu, naThimothi gamu ledu.<verse eid="COL 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 1:2" />Kubayengemali nehama dzinogalikabgwe muna Khirisitu, bakuKolose.</para>
  <para style="p" vid="COL 1:2">Ngoni nekunyalala kunobva kuNdzimu Tate bedu ngakube kumuli.<verse eid="COL 1:2" /></para>
  <para style="s">Ntembezelo Weboka</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />Togala tiboka Ndzimu, ibo Tate baHe wedu Yesu Khirisitu, hapa timutembezelela, <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />ngobe takawha nekwebugalimoyo gwenyu muna Khirisitu Yesu nange ludo gwamunago kubayengemali bose, <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />ngentha yekugalabgwe kwamakabigigwa kudzimu kakale kwamakatjiwha nekwako mudama lemalebeswa, iyo ndebo mbuya <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />yakatjihha kumuli, nayiyeyo zwayo zila, inozwala mitjelo kakale inokula muhango yose, sekwayakathama pakati kwenyu, kubvila hhuba lamakatanga yiwha newhisisa ngoni dzeNdzimu mumalebeswa, <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />sekwamakadiyiwa na Iphafurasi unodikala watinohinga tose. Iphafurasi unlanda waKhirisitu unogalikabgwe unohinga alimile mugumbo ledu, <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />wakatibudza nekweludo gwamunago muMeya.<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />Ngentha yayikoku, kubvisila muhhuba latakawha nekwako, atizotongoletja mutembezelela, kakale tikumbila kuti kadzene Ndzimu bangamuhhadza neluzibo gwekuda kwabo ngebutjenjebvu gose newhisisa kose kunobva muMeya, <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />kuti mutjile nezila yakalulamila He, kakale muthama kunowuhanhisa, muba nemitjelo mumihingo yose yakanaka, mupamhidzigwa muluzibo gweNdzimu. <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />Ngamusimisiwe nemasimba ose, kuyendidzana negudzo limumasimba awe, kuyetila kuti mutubule simidzila kose neba nemoyonlefu, mulihhele kuhanha, <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />muboka ibo Tate bakatithama kuti <note caller="+" style="f"><char style="fr" closed="false">1.12 </char><char style="fq" closed="false">tibe </char><char style="ft" closed="false">dzimwe whalo whulukugwi dzoti mube</char></note>tibe negobe munhaka yebayengemali mutjedza. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />Ibo bakatibvubula kubva mumasimba ehhalima, bakatihhisa kubumambo gweNkololo wabo unodikala, <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />muwunli takasunungugwa, kuleba kuti, yetigwa mazwibhatigwa matjinyo.<verse eid="COL 1:14" /></para>
  <para style="s">Nhu unoyi Khirisitu neN'hingo uwe</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />Khirisitu umfananidzo weNdzimu usingabon'we, ndiye mbano yembumbiko yose, <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />ngobe muwunli zwinhu zose zwakabumbiwa, zwikudzimu nezwimuhango, zwinobon'wa nemeho nezwisingabon'we, kungabe zwigalo zwebuhe kene butongi kene masimba emeya kene butungamili; zwinhu zose zwakabumbiwa muwunli kakale zwibumbigwa iye. <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />Khirisitu waka elipo zwinhu zose zwisanhu zwikabepo, kakale muwunli zose zwinhu zwimubugalo gwazo gwakatambunuka. <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />Ndiye n'holo wembili, ilo gubungano lebagalimoyo<note caller="+" style="f"><char style="fr" closed="false">1.18 </char><char style="fq" closed="false">gubungano lebagalimoyo </char><char style="ft" closed="false">kungabviwa bose bagalimoyo bamubugalo gose, gose lubaka</char></note>, ndiye mabambo, mbano yebakamusiwa kubafi, kuyetila kuti iye yega abe nebugalo gwekutanga muna kose. <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />Ngobe Ndzimu bakahanha kuti pelela kwabo kube muwunli, <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />muwunli, Ndzimu wakabgwilulanya kuwunli zwinhu zose, kungabe zwimuno muhango kene zwikudzimu, eyeta lunyalalo ngemalopa awe akatebuka patjileyanyo.<verse eid="COL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21" />Imwi makatongobe makathubukana neNdzimu mulizwita zwizwe mumikumbulo, muthama mihingo yakayipa, <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />Ndzimu watjizwibgwilulanya namwi ehingisa mbili wenyama weNkololo uwe ngelufu, kuti amuwamutjile makayengemala, makatjena, musina nlandu mbeli kukwe, <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />hapa kuli kuti moyendilambeli muli mubugalimoyo, makagadzikana makasima, musingatsheduke muna tjakalingiligwa nendebo mbuya yamakawha, iyo yakasumikigwa kuyimwe neyimwe mbumbiko ipasi kwekudzimu, imi Phawuli yandakatiwa n'hingi wayo.<verse eid="COL 1:23" /></para>
  <para style="s">N'hingo waPhawuli seNlanda weGubungano leBagalimoyo</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />Ngwenu ndohanha mudziyila kwangu ndidziyilila imwi, kakale mumbili wangu ndohhadzisa tjinotayila mukudziyidzika kwaKhirisitu ndiyetila mbili uwe, ilo gubungano lebagalimoyo<note caller="+" style="f"><char style="fr" closed="false">1.24 </char><char style="fq" closed="false">gubungano lebagalimoyo </char><char style="ft" closed="false">kungabviwa bose bagalimoyo bamubugalo gose, gose lubaka</char></note>, <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />ndakaba n'hingi kuyendidzana netjigalo tjandakapiwa neNdzimu, nditjipigwa imwi, kudze ndisumikile dama leNdzimu nebuhhalo, <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />itjetjo tjakasumbikala, tjakasumbikika kubvila ntolo ntolo nekuzwizekugwana zwinjinji, koga ngwenu tjazumbunuligwa bayengemali babe. <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />Ndzimu wakahala thama kuti bazibe kuti bukulu gwegudzo layitjetji tjakasumbikala ligulu kungapani kuBataya, kunoba ali iye Khirisitu umumuli, ilo gudzo lamunogalabgwe. <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />Ndiye watinosumikila, titjenjedza nhu wose kakale tidiya nhu wose nebutjenjebvu gose, kuyetila kuti tihhise nhu wose akapelela muna Khirisitu. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />Ngentha yayikoku ndohinga zwakasima, ndigwisa nemasimba ose aakandipa anohinga mundili.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />Ndohaka kuti muzibe kuti ndodziyila kungapani, nentha yenyu nangentha yebanhu bekuLayodisiya kuhanganyila nebamwe bose basanhu bakatongondibona. <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />Ndiyetila kuti mimoyo yabo ikulumbidzigwe yakabhatana muludo, kuti bawane fumwa yose yewhisisa neluzibo gwetjakasumbikika tjeNdzimu, iye Khirisitu, <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />muwunli kwakasumbikiwa yose fumwa yebutjenjebvu neyeluzibo.<verse eid="COL 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="COL 2:4" />Ikoku ndokulebela kuyetila kuti kusibe nenhu unomutjebela nendebeleko yebupitipiti. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />Ngobe nekene ndisinamwi munyama, koga ndinamwi mumeya, ndihanha kwazo ndakalinga mazwibhato enyu nesima kwebugalimoyo gwenyu muna Khirisitu.<verse eid="COL 2:5" /></para>
  <para style="s">Buhhalo Gwebupenyu muna Khirisitu</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />Saku makawamutjila Khirisitu Yesu saHe, tjilani muli muwunli, <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />makadzikigwa muwunli kakale makabakiwa muwunli, kakale makasima mubugalimoyo, sekwamakadiyiwa, mulihhele boka kunjinji.<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />Mutjenjele, kuti kusibe nenhu unomuta ntapwa nezwidiyo zwebutjenjebvu gwebanhu, netjebela kusina n'hingo, kunoyendidzana nemilenje yebanhu, kunoyendidzana nemeya dzinolawula dzehango, kusingayendidzane naKhirisitu. <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />Ngobe mbumbiko yose yeNdzimu nebuhhalo inogala mumbili uwe, <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />kakale imwi matjiba nebuhhalo gwebutjilo muwunli, iye un'holo webutongi gose nebutungamili gose.<verse eid="COL 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="COL 2:11" />Muwunli makathumbigwa nethumbiwa kusingayetiwe ngemaboko enhu, koga lawugwa kwenyu nembili wenyama kwakapedzewa pamakathumbigwa naKhirisitu; <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />ngobe makabiganyiwa kan'ompela naye mukubvubikiwa, mukapamha mukamusiwa kan'ompela naye ngegalamoyo mukuhinga kweNdzimu, iye wakawumusa kubafi. <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" />Kakale imwi, baka bakafa mumatjinyo nemusathumbigwa kwenyama, Ndzimu wakamuyeta mukaba bapenyu panhu pan'ompela naKhirisitu, hule kwekuti amuyetila mazwibhatigwa matjinyo enyu, <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />wakadzima lukwalo gwemilandu yedu, gwaka gugwisana naswi kakale gutiwana nlandu; wakagulaha negukowhomela patjileyanyo. <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />Wakakulila batongi bemeya nebatungamili, akababhatisa honi palenje, akabakunda patjileyanyo.<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />Ndizo ke musibvumile kuti yani kene yani amuwane nlandu nekwetjamunodla kene tjamunon'wa, kene nekwenzano welunamato, kene nekwenzano wegala kwemwedzi, kene nekwensi weSabatha. <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />Izwezwi zwinhu untuzi wekwaka kuwhohha, koga ke tjinobhatika ndiye Khirisitu. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />Musibvumile tjebegwa, kungayeta mukasawamutjila mbhayilo wenyu. Mutjebegwa nenhu unokuludzila zwitebamisa nenamata batumwa bekudzimu, akabhatilila mumibono yaanoba nayo; engozwikudza ngenkumbulo uwe wenyama esingaalakane, <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />esakabhatilila paN'holo, ipo mbili wose, pawunowana bhatsho lose wakabhatshanyiwa ngendungululo dzawo nange ndzinga dzawo, unokula ukudziwa neNdzimu.<verse eid="COL 2:19" /></para>
  <para style="s">Fa neTjila naKhirisitu</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />Saku makafa panhu pan'ompela naKhirisitu mumeya dzinolawula dzemuhango, nentha yeni ngono mutjila sekunoyi mutjibanhu behango ino? Motobelelani milenje inoti. <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />“Usibhate! Usilabile! Usikunhe!”? <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />Milayo iyeyi, inoleba nekwezwinhu zwinopalala hule kwehingisiwa, inobva mulaya nediya kwebanhu. <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />Milayo iyeyi, lebeswa, inolingika seyina butjenjebvu mukukuludzila namata kwezwithamila, zwitebamisa, newhisa mbili zogwadza, koga ayina tjayinobhatsha banhu mudziba njemulo mbi dzenyama.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />Saku makamusiwa panhu pan'ompela naKhirisitu tjihakani zwinhu zwipehhugwi, kuna Khirisitu, kwaaligele kuluboko gweludli gweNdzimu. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />Mikumbulo yenyu ngayigale ikumbula zwinhu zwipehhugwi, kusi zwinhu zwehango ino. <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />Ngobe imwi makafa, bupenyu gwenyu gwakasumbikiwa naKhirisitu muNdzimu. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />Hapa Khirisitu, unoba bupenyu gwedu ebon'wa, namwi bo mowhobon'wa panhu pan'ompela naye mugudzo.<verse eid="COL 3:4" /></para>
  <para style="s">Bupenyu Gukulukugwi neBupenyu guTshwa</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />Bulayani njemulo dzenyu dzehango ino. pinga, hambgwa, tjiba, yemula yeta zwibi, pupa, iko namata midzimwana. <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />Ngobe nentha yezwinhu izwezwi buhongola gweNdzimu gojitila pehhugwi kwayibabo basingawhilile. <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />Imwi makatongotjila muzila idzedzi mubutjilo gwamakatongotjila.<verse eid="COL 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 3:8" />Koga tjisiyanani nako kose ikoku. mon'wa, buhongola, hema, tuka, neleba masapa nemilomo yenyu. <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />Musinyepelane, ngobe makatjimbula nhu nkulukugwi kose nezwiyeto zwizwe <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />makatjimbala nhu ntshwa, unoyetiwa ntshwa muluzibo mutjiso tjeMbumbi uwe. <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />Ipapa akutjina Njhuta kene Nghiriki, wakathumbigwa kene usakathumbigwa, ntaya kene Nsekethiya, nlanda kene wakasununguka, koga Khirisitu ndiye kose, kakale umunakose.<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />Sebanhu bakahagwa neNdzimu, bakayengemala kakale banodikala, ibani nengoni, nemoyo wakanaka, nekuzwitebamisa, nemoyo nyolo, nemoyo nlefu. <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />Muyetilane moyo nlefu kakale muyetilane mazwibhatigwa hapa kuli kuti kuna pamunoleyana. Muyetilane bo mazwibhatigwa, saHe akamuyetila mazwibhatigwa. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />Pehhugwi kwako kose ikoku ibani neludo, gunoba igo gunohanganya kose mukubhatana kwakapelela. <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />Bvumilani kunyalala kwaKhirisitu kulawule mumimoyo yenyu, ngobe makadanigwa mumbili un'ompela, kakale galani muboka. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />Bvumilani dama laKhirisitu kuti ligale mumuli nebunji gwalo, mudiyane kakale mutambunudzane mubutjenjebvu gose, kakale mumbe njimbo nenjimbo dzinolumbidza Ndzimu nenjimbo dzemeya, muboka Ndzimu mumimoyo yenyu. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />Kakale tjimwe netjimwe tjamunothama, kungaba mukulebeleka kene muzwiyeto, mukuthame kose muzina laHe Yesu, muboka Ndzimu Tate muwunli.<verse eid="COL 3:17" /></para>
  <para style="s">Whisisa Khirisitu Mubupenyu Gutshwa</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />Bafumakadzi, muzwise pasi kubalume benyu, sekwakwakafanila kuna He.<verse eid="COL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19" />Balume dani bafumakadzi benyu, musibakayikanye.<verse eid="COL 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20" />Bana ibani nemazwibhato kubazwadzi benyu muzwinhu zose, ngobe ikoku kohanhisa He.<verse eid="COL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21" />Botate, musihokayidze bana benyu, ngobe bangabva benyala moyo.<verse eid="COL 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22" />Balanda, whililani bobatezi benyu bemuhango ino muzwinhu zose, musikuthame hapa bakamulinga koga mubahanhisa, koga mukuthame nemimoyo yakahalabvuka muhla He. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />Tjimwe netjimwe tjamunothama, mutjihinge nemimoyo yenyu yose, sekunoyi mohingila He, kusibanhu, <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />muziba kuti mowhowamutjila nhaka kubva kuna he kuli mbhayilo yenyu; mohingila He Khirisitu. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />Ngobe unoyeta tjakayipa unowhowamutjila kunoyendilana netjakayipa tjaakathama, akuna luhalawulo.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />Bobatezi bhatani balanda benyu nezila yakalulama kakale yakalizanila, mugale muziba bo kuti imwi muna Batezi benyu kudzimu.<verse eid="COL 4:1" /></para>
  <para style="s">Zwinofanila Yetiwa</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />Muzwipile mukutembezela, mube makalinda mutembezela, muboka Ndzimu, <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />kakale mutitembezelele bo kuti Ndzimu atihhulile nkoba wesumikila dama, kuti tisumikile sumbikala kwaKhirisitu, ngobe ndiko kwakathama kuti ndibensungwa sangwenu, <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />kuti nditubule kusa patjena, sekwandakafanila.<verse eid="COL 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 4:5" />Mutjenjele mukutjila kwenyu mbeli kwebakuhhe, muhingisa lubaka gwamunowana nezila yakatambunuka. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />Matama amunoleba ngaahhale ngoni, azipe, kudze muzibe kuti mungahandula tjini nhu wose.<verse eid="COL 4:6" /></para>
  <para style="s">Buyisa Kwebupelo</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />Thikhikhasi unowhomubudza nekwangu, igamu linodikala kakale un'hingi unogalikabgwe nenlanda watinohinga tose tihingila He. <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />Ndizo wali ndawuntuma kumuli, kudze muzibe kuti titjini nekuti akuludzile mimoyo yenyu, <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />unohha na Onesimasi, gamu linodikala kakale linogalikabgwe, unoba ali umwe wenyu. Banowhomubudza kose kunoyetikala ngeno.<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />Arisitakhasi, nsungwa kan'ompela nami, unomubuyisa, naMako gamu laBhanabhasi (iye wamakalayiwa nekukwe; hapa angaswika kumuli, muwuwamutjile), <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />naYesu, unoyi Jasitasi. Ibaba ndibo boga balume beludzi gunothumbigwa pakati kwebanohinga nami mubumambo gweNdzimu, banondikulumbidza kakale babhatsho gulu kundili.<verse eid="COL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 4:12" />Iphafurasi, unoba ali umwe wenyu, nlanda waKhirisitu Yesu, unomubuyisa, unogala emukumbula mumitembezelo iye, emutembezelela nemoyo uwe wose, kuti musime mube neluzibo guhhele mukuda kweNdzimu kose. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />Ndopa busupi kuti unohinga zwakalema, ehingila imwi nayibabo bakuLayodisiya nebakuHhiyerapolisi. <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />Luka, nlapi unodikala, naDemasi banomubuyisa.<verse eid="COL 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 4:15" />Mundibuyisile makamu akuLayodisiya, naNimfa negubungano lebagalimoyo linonginila mun'umba iye. <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />Hapa lukwalo igogu matjigubaligwa, mube nelebeswa kuti gobagwa bo kugubungano lebagalimoyo lekuLayodisiya, imwi mutole gwandakakwalila bekuLayodisiya mugubale bo. <verse eid="COL 4:16" /><verse number="17" style="v" sid="COL 4:17" />Mubudze Akhiphasi muti, “Bona kuti nofidza n'hingo waakawamutjila kubva kuna He.”<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />Imi Phawuli, ndokwala buyisa ikoku neluboko gwangu. Musikangan'we kuti ndinsungwa.</para>
  <para style="p" vid="COL 4:18">Ngoni ngadzibe namwi.<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>