<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Kalanga Bible Translation</book>
  <para style="h">1 BaKhorinte</para>
  <para style="toc1">Lukwalo GwaPhawuli Gwekutanga KuBaKHORINTE</para>
  <para style="toc2">1 BaKhorinte</para>
  <para style="toc3">1 BaKho</para>
  <para style="mt2">Lukwalo Gwekutanga gwaPhawuli ekwalila</para>
  <para style="mt1">BAKHORINTE</para>
  <para style="imt">Tjinginiso</para>
  <para style="ip">
    <char style="bk">Lukwalo Gwekutanga gwaPhawuli ekwalila BaKhorinte</char> gwakakwagwa ndiMpositoli Phawuli mumakole angaba makumi mahanu anakuhanu hule kwezwagwa kwaKhirisitu (BaKhorinte 1.1). Igogu lukwalo ndigo gwekutanga gwewhalo mbili dzakakwagwa ndiPhawuli ekwalila gubungano leku Khorinte. Angabe akakwala igogu lukwalo nelubaka egala kuEfesu esanhu akayenda kuKhorinte elimuzila yeyenda nebva kuMakhedoniya (BaKhorinte 16.5-9).</para>
  <para style="ip">Lukwalo igogu gwakalingisana nendebo Phawuli dzaakawana dzibva kubamwe begubungano nekwezwinhu zwinomanikana zwakazwiyetiwa mugubungano lebagalimoyo, zwinonga kakabadzana nekusazwibhata. Nzi-nkulu weku Khorinte waka uzibgwa kwazo nekwe sazwibhata ndizo akutotjenamisa kuti gubungano lakalakalingisana nendebo dzakajali. Lukwalo gwekutanga gweBaKhorinte kakale guna danho linozibgwa kwazo linoleba nekweludo (13).</para>
  <para style="iot">Nlongoloso Yezwimukati</para>
  <para style="io1">1. Phawuli unobuyisa kakale ebokela banhu beku Khorinte kuNdzimu (BaKhorinte 1.1-9).</para>
  <para style="io1">Unolebeleka kakale nekwendebo dzaakawha ngekwe kakabadzana kumugubungano leKhorinte (BaKhorinte 1.10-4.21).</para>
  <para style="io1">Unolebeleka kakale nekwendebo dzesazwibhata neyendesana kunlayo (BaKhorinte 5-6).</para>
  <para style="io1">Hule kwayikoko unopa nlayo nekwendebo dzendobolo, pila midzimu, tembezela, zwipo zwemeya, nemuka kubafi (BaKhorinte 7-15).</para>
  <para style="io1">Kwebupelo unopeta nekwezwinotiwa nekwendebo dzebutjilo (BaKhorinte 16).</para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />Kubva kuna Phawuli, wakadan'wa ngekuda kweNdzimu kuti abe mpositoli waKhirisitu Yesu, nehama yedu Sositheni.<verse eid="1CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 1:2" />Kugubungano leNdzimu liku Khorinte, kuna bakayengemadziwa muna Khirisitu Yesu, bakadan'wa kuti babe bayengemali panhu pan'ompela nayibabo banodana zina laHe wedu Yesu Khirisitu mubugalo gose, He wabo newedu bo.<verse eid="1CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />Ngoni nekunyalala kunobva kuNdzimu Tate bedu naHe Yesu Khirisitu ngakube kumuli.<verse eid="1CO 1:3" /></para>
  <para style="s">Makombolelo Muna Khirisitu</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />Ndoboka Ndzimu wangu lubaka gose nekwenyu ngentha yemawhilangoni eNdzimu amakapiwa muna Khirisitu Yesu, <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />kuti muwunli makafumisiwa muzila dzose ngekulebeleka nange luzibo gose. <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />saku busupi gwaKhirisitu gwakahhadzisika pakati kwenyu. <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />kudze kuti musitayile kene tjili tjipi tjipo tjemeya, mutjakamilila zumbunugwa kwaHe wedu Yesu Khirisitu; <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />iye unowhomutjengeta kuswika kubupelo, musina nlandu muhhuba laHe wedu Yesu Khirisitu. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />Ndzimu unogalikamoyo, iye wamakadan'wa ndiye kuti mudlidzane neNkololo uwe, Yesu Khirisitu He wedu.<verse eid="1CO 1:9" /></para>
  <para style="s">Kakabadzana muGubungano</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />Ndomukumbila, makamu, nezina laHe wedu Yesu Khirisitu, kuti mose mubvumilane kakale kusibe nekukakabadzana pakati kwenyu, koga kuti mubhatane munkumbulo un'ompela nebona zwinhu nezila in'ompela. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />Ngobe ndakabudziwa nebanhu baKhilo kuti kuna kukakabadzana pakati kwenyu, makamu angu. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />Tjandinobva ndetjekuti umwe newumwe wenyu unoti, “Imi ndiwa Phawuli,” kene “Imi ndiwa Apholosi,” kene “Imi ndiwa Khefasi<note caller="+" style="f"><char style="fr" closed="false">1.12 </char><char style="ft" closed="false">Zina letji Aramayiki, kunobva kuti Phethiro netjiGiriki</char></note>,” kene “Imi ndiwa Khirisitu.” <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />Khirisitu wakapalalana? Phawuli wakakowhomelegwa imwi? Kene kuti makabvubikiwa muzina laPhawuli?<verse eid="1CO 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14" />Ndoboka Ndzimu kuti akuna wenyu wandakabvubika kuhhe kwaKhirisipasi naGayiyasi; <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />swiyo kungabe newumwe unoti makabvubikiwa muzina langu. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />(Ndakabvubika bo ben'ha waSitefanasi. Hule kwayikoko anditoziba kene kuna umwe wandakabvubika.) <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />Nekuti Khirisitu haazondituma kuti ndibvubike koga kuti ndisumikile ndebo mbuya, kusi ngematama ebutjenjebvu anozipilila, swiyo tjileyanyo tjaKhirisitu tjingakotolegwa masimba.<verse eid="1CO 1:17" /></para>
  <para style="s">Khirisitu Masimba Nebutjenjebvu GweNdzimu</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />Ngobe ndebo yetjileyanyo bulengwe kuna banopalala, koga kutili banotjidziwa masimba eNdzimu. <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />Ngobe kwakakwagwa kuti,</para>
  <para style="q1" vid="1CO 1:19">“Ndowhopaladza butjenjebvu gwebakatjenjela,</para>
  <para style="q2" vid="1CO 1:19">neluzibo gwebanoziba ndowhogulamba.”<verse eid="1CO 1:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="1CO 1:20" />Uponi ntjenjebvu? Uponi nkwali? Uponi nyanyayidzi welubaka guno? Ndzimu haazoyeta butjenjebvu gwehango gukabe bulengwe?<verse eid="1CO 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21" />Ngobe saku, mubutjenjebvu gweNdzimu, hango ayizoziba Ndzimu ngebutjenjebvu, kwakahanhisa Ndzimu ngebulengwe gwetjatinosumikila kuti atjidze ibabo banogalamoyo. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />Ngobe maJuta anohaka zwilakidzilo maGiriki anohaka butjenjebvu, <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />koga iswi tosumikila Khirisitu wakakowhomegwa, utjikunhiso kumaJuta kakale alibulengwe kubataya, <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />koga kuna ibabo bakadan'wa, bose maJuta nemaGiriki, Khirisitu umasimba eNdzimu nebutjenjebvu gweNdzimu. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />Ngobe bulengwe gweNdzimu gwakatjenjela kupinda butjenjebvu gwebanhu, kakale butela gweNdzimu gwakasima kupinda masimba ebanhu.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />Ngobe lingisisani dan'wa kwenyu, makamu; abatebanjinji benyu bakabe bakatjenjela kuyendilana nekwezwilizanyiso zwehango ino, abatebanjinji bakabe bana masimba, abatebanjinji bakabe bazwaligwa mumamo apehhugwi; <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />koga Ndzimu wakahala zwinhu zwebulengwe zwehango ino kuti abhatise honi batjenjebvu, Ndzimu wakahala zwinhu zwinabutela zwehango ino kuti abhatise honi bana masimba, <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />Ndzimu wakahala zwinhu zwipasi nezwinolingigwa pasi muhango, nezwinhu zwisipo, kuti ayete zwinhu zwiyapo zwibezwisina n'hingo, <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />ndizo kuti kusibe nenhu unowhozwiloba fuba mbeli kwebuyapo kweNdzimu. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />Ndiye tshinde lebutjilo gwenyu muna Khirisitu Yesu, iye ubutjenjebvu gwedu gunobva kuNdzimu, nendulamo yedu, neyengemadziwa newangugwa kwedu; <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />ndizo, sekwakakwagwa kuti, “Unozwikudza, ngaazwikudze ngekwaHe.”<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s">Ndebo nekwaKhirisitu Wakabambugwa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />Pandakahha kumuli, makamu, andizohha ndisumikila busupi gwemasazibgwa<note caller="+" style="f"><char style="fr" closed="false">2.1 </char><char style="fq" closed="false">busupi </char><char style="ft" closed="false">Dzimwe whalo whulukugwi dzina dama linoti </char><char style="fq" closed="false">gwemasazibgwa kene tjakasumbikala </char></note> eNdzimu ngematama anozipilila apehhugwi kene butjenjebvu. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />Ngobe ndakahala kusaziba tjimwe pakati kwenyu kuhhe kwaYesu Khirisitu iye wakakowhomegwa. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />Kwandakahha kumuli, ndakabe ndinabutela kakale ndihla kwazo nditetema, <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />kakale sumikila kwangu nendebo yangu kwaka kusi kwematama anozipa ebutjenjebvu, koga kuli kwelakidziwa kweMeya nemasimba, <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />kuti kugalamoyo kwenyu kusisendame mubutjenjebvu gwebanhu koga kusendame mumasimba eNdzimu.<verse eid="1CO 2:5" /></para>
  <para style="s">Butjenjebvu gweNdzimu</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />Koga kuna ibabo bakatjikula mumeya toleba ndebo yebutjenjebvu, nekutobe gusi butjenjebvu gwelubaka gwangwenu kene gwebatongi belubaka gwangwenu, ibo banowhopinda. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />Koga toleba butjenjebvu gweNdzimu gwemasazibgwa gwakasumbikika, igo Ndzimu gwaakahaka kuti tikudziwe ndigo hango isanhu ikabambiwa. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />Akuna umwe webatongi belubaka igogu waka ekuwhisisa ikoku; ngobe hapa bakabakuwhisisa, bakabasingowhokowhomela He wegudzo. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />Koga sekwakakwagwa kuti,</para>
  <para style="q1" vid="1CO 2:9">“Tjisakabon'wa nehhiho, kene zebe tjayisakawha,</para>
  <para style="q2" vid="1CO 2:9">kene moyo tjawusakawamutjila,</para>
  <para style="q2" vid="1CO 2:9">ndizwo zwinhu Ndzimu zwaakabaakanyila banowundha,”<verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />Ndzimu wakatilakidza izo neMeya. Ngobe Meya inohakisisa zwinhu zose, nange zwinhu zwakasumbikika zweNdzimu. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />Ngobe ndiyani angaziba mikumbulo yenhu kuhhe kwemeya yenhu imuwunli? Ndizo akuna nhu unozibisisa mikumbulo yeNdzimu kuhhe kweMeya yeNdzimu. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />Iswi atizowamutjila meya yehango, koga takawamutjila Meya inobva kuNdzimu, kuti tiwhisise zwipo zwatakapiwa neNdzimu.<verse eid="1CO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13" />Kakale toleba ikoku ngematama asingadiyiwe nebutjenjebvu gwebanhu koga anodiyiwa ngeMeya, titjenesa malebeswa emeya kuna banaMeya. <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />Nhu usina Meya haangawamutjile zwinhu zweMeya zwinobva kuNdzimu, ngobe zobe zwilibulengwe kuwunli, kakale haangatubule kuti azwiwhisise ngobe zowhisisiwa ngekubhatshiwa neMeya. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />Nhu weMeya unolingisisa zwinhu zose, koga iye akuna nhu unotubula wunlingisisa. <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />Ngobe,</para>
  <para style="q1" vid="1CO 2:16">“Ndiyani ungaziba nkumbulo waHe</para>
  <para style="q2" vid="1CO 2:16">kuti ungawunlaya?”</para>
  <para style="m" vid="1CO 2:16">Koga iswi tinankumbulo waKhirisitu.<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">Balanda beNdzimu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />Koga imi, makamu angu, ndakandisingatubule kuti ndilebeleke namwi sebanhu bemeya, koga sebanhu benyama, sebana batjetjana muna Khirisitu. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />Ndakamupa nkaka, kusi zodliwa zwakasima; ngobe maka musanhu malulamila kuzwiwamutjila; nayiko nanasi amunhu mazwilulamila, <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />ngobe mutjibanhu benyama. Ngobe hapa kutjina fupa nekakabadzana pakati kwenyu, amute banhu benyama kene, amutozwibhata sebanhu bemahhuba ose? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />Ngobe hapa umwe eti, “Imi ndiwa Phawuli,” umwe eti, “Imi ndiwa Apholosi,” amute banhu koga kene?<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />Apholosi ini ngono? Phawuli ini? Balanda bamakagalamoyo nentha yabo, sewumwe newumwe kwaakatumwa kuti ahinge naHe. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />Ndakadzwala, Apholosi akadilidzila, koga Ndzimu wakakulisa. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />Ndizo unodzwala kene unodilidzila haate tjimwe, koga Ndzimu yega ndiye unokulisa. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />Unodzwala newunodilidzila bakalizana, umwe newumwe unowamutjila mbhayilo uwe kuyendilana nehinga kukwe. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />Ngobe iswi tibahingi beNdzimu.</para>
  <para style="p" vid="1CO 3:9">Imwi muminda yeNdzimu, mutjibakwa tjeNdzimu.<verse eid="1CO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 3:10" />Kuyendilana nengoni dzeNdzimu dzandakapiwa, ndakateya mbviwa sembaki unabunyambi, kakale umwe nhu unobaka pehhugwi kwadzo. Nhu umwe newumwe ngaayele njele kuti unobaka tjini pehhugwi kwadzo. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />Ngobe akuna dzimwe mbviwa dzingateyiwa kuhhe kwedzakateyiwa kale, dzinobe dzili Yesu Khirisitu. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />Sangwenu hapa umwe ebaka pehhugwi kwembviwa nezeezi, siliva, mabgwe anantengo upehhugwi, whuni, buhwa, kene mahanga. <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />n'hingo wewumwe newumwe unowhobe patjena; ngobe Hhuba ilelo lowhowunsa patjena, ngobe kowhozumbunugwa ngemoto, kakale moto unowholika n'hingo wakatiwa newumwe newumwe. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />Hapa n'hingo wabakiwa nenhu pehhugwi kwembviwa ukasala ulimile, iwhoyo nhu unowhowamutjila mbhayilo. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />Hapa n'hingo wenhu ungatshwa, unowholahikigwa, nekutobe iye tjekukwe ewhotjidziwa, koga kunga kunoyi wabhugwa mumoto.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />Amutoziba kuti imwi muthempeli yeNdzimu nekuti Meya yeNdzimu inogala mumuli? <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />Hapa kene yani zwe epaladza thempeli yeNdzimu, Ndzimu unowhowumpaladza. Nekuti thempeli yeNdzimu yakayengemala, ndimwi thempeli iyeyo.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />Kusibe newunozwitjengela. Hapa kuna umwe wenyu unokumbula kuti wakatjenjela muhango ino, ngaabe tjilengwe kuyetila kuti abe ntjenjebvu. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />Ngobe butjenjebvu gwehango iyeyi bulengwe kuNdzimu. Selukwalo guti, “Unobhata bakatjenjela mubupitipiti gwabo,” <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />kakale goti, “He unoziba kuti mikumbulo yebakatjenjela ayita tjimwe.” <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />Ndizo ngakusibe newunozwiloba fuba nekwebanhu. Ngobe zwinhu zose ndezwenyu, <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />kungabe Phawuli kene Apholosi kene Khefasi<note caller="+" style="f"><char style="fr" closed="false">3.22 </char><char style="ft" closed="false">Zina letji Aramayiki, kunobva kuti Phethiro netjiGiriki</char></note> kene hango kene butjilo kene lufu kene iko ngwenuwali kene lubaka gunohha, kose ndekwenyu; <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />imwi muba Khirisitu; Khirisitu ali weNdzimu.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">Bapositoli baKhirisitu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />Yeyi ndiyo zila imwe umwe yaangatitola ndiyo, sebalanda baKhirisitu nebatjengeti bezwakasumbikika zweNdzimu. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />Pehhugwi kwayikoko kohakika kuti bantjengeti babe banogalikabgwe. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />Koga kundili tjinhu tjitukununu kuti nditongwe namwi kene nagupi lubahhe zwago. Imi tjekwangu anditozwitonga. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />Akuna tjandinoziba tjinogwisana nami, koga akutobva kuti andina nlandu. He ndiye unonditonga. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />Ndizo musitonge lubaka gusanhu gukaswika, mililani He adze aswike, iye unowhohhisa zwinhu zwakasumbikika mutjedza akasa patjena mikumbulo yemoyo. Umwe newumwe ekotjiwamutjila lumbidziwa kunobva kuNdzimu.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />Kose ikoku ndakakuhingisa kundili nekuna Apholosi kuyetila imwi, makamu, kudze muzwidiye kubva mutili kuyetila kuti musipinde tjakakwagwa, kuti kusibe newumwe wenyu unohonga ekudza umwe kupinda wumwe. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />Ngobe ndiyani unobona tjakasiyana tjimubamwe? Ini tjawunatjo tjawusakawamutjila? Hapa wakatjiwamutjila, unozwilobelani fuba sekunonga kunoyi tjaka tjisi tjipo?<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />Sangwenu makatjigutshikana kale! Makatjifuma kale! Makatjibe bomambo iswi tisipo! Toyemula kuti kadzene mamuli bomambo, kuyetila kuti naswi bo tibe bomambo toseni namwi! <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />Ngobe ndokumbula kuti Ndzimu wakapa bugalo gwebupelo iswi bapositoli, sebanhu banotongegwa fa; ngobe tabe banolingiligwa nehango, nebatumwa beNdzimu nebanhu. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />Tizwilengwe nentha yaKhirisitu, koga imwi makatjenjela muna Khirisitu! Tina butela, koga imwi makasima! Imwi mokudziwa, koga iswi atitokudziwa! <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />Kudzina kuwhobe ngwenu tinahhala nenyota, takapalukigwa kakale tolobgwa kakale atina pogala, <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />kakale tohinga zwakalema, tihinga nemaboko edu. Hapa tilebegwa haya, tokombolela; hapa tidziyidziwa, tosimidzila; <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />hapa titukiwa togwisa handula ngematama anabunhu; tayetiwa tikabe malala ehango, bonkongobogwa muzwinhu zose.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />Anditokwala ikoku kuti ndimubhatise honi, koga kuti ndimukuludzile sebana bangu banodikala. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />Ngobe nekutobe mungabe muna banomulela banjinji muna Khirisitu, amuna botate banjinji. Ngobe ndakabe tate benyu munaKhirisitu Yesu ngemusumikilila ndebo mbuya. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />Ndizo ndomukuludzila, kuti mube bayedzeleli bangu. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />Ngobe ndamutumila Thimothi, mwana wangu unodikala kakale egalikamoyo muna He, kuti amukumbudze zila dzangu muna Khirisitu Yesu, sekwandinobadiya kuntha dzose mumakubungano ose.<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />Bamwe banozwikudza, sekunonga kunoyi anditowhohha. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />Koga ndowhohha kumuli ngwenungwenu, hapa He eda, ndowhohha ndihakisisa nekwebanhu ibaba banozwikudza kusi nekwezwilebo zwabo koga, koga kose nekuti bana api masimba. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />Ngobe bumambo gweNdzimu aguta gwepanlomo koga ndegwemasimba. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />Moyemulani? Ndihhe kumuli nehamu, kene neludo mumeya yebunyolonyolo?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">Sazwibhata muGubungano leBagalimoyo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />Lebeswa, kolebgwa iko kuti kuna kusazwibhata pakati kwenyu, sazwibhata kusanhu kukawanika kene pakati kweBataya; ngobe nlume unoyizela nemfumakadzi watate babe. <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />Kakale mozwikudza kwazo! Mamusakafanila kuti mulile? Unothama ikoku ngaatakhwe pakati kwenyu. <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />Ngobe nekutobe mbili wangu usipo koga ndiyapo mumeya, kakale ndinga ndinoyi ndiyapo, ndatjileba tongwa kale panhu wakathama tjinhu tjakajali. <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />Hapa mukubungana muzina laHe Yesu, ndinamwi mumeya, nemasimba aHe wedu Yesu, <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />mutulile nhu iwhoyu kuna Satane kuti awumpaladze munyama, kudze meya iye itjidziwe muhhuba laHe.<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />Zwikudza kwenyu akuzonaka. Amutoziba kuti mbidzo homanana inobidza bhundu lose? <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />Dusani mbidzo whulukugwi kuti mube nebhundu dzwa, malebeswa saku musakasiwa mbidzo. Ngobe Khirisitu, mhwizana yedu yephasika, wakayetiwa tjibhayilo. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />Ndizo ayihanhileni nzano, tisina mbidzo whulukugwi, iyo mbidzo yebengana nebubi, koga netjinkwa tjisina mbidzo tjebubuya nemalebeswa.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />Ndakamukwalila mulukwalo gwangu kuti musiwhanane nebanhu basakazwibhata; <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />ndisingabve basakazwibhata bemuhango ino, kene bapupi nembava, kene banonamata midzimwana, ngobe kobe kobva kuti matjifanila bva muhango. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />Koga ndakamukwalila<note caller="+" style="f"><char style="fr" closed="false">5.11 </char><char style="fq" closed="false">ndakamukwalila </char><char style="ft" closed="false">ndomukwalila</char></note> kuti musidlidzane nenhu unazina linoyi gamu koga ananlandu wekusazwibhata kene bupupi, kene unonamata midzimwana, kene unotukana, kene nlaladzi, kene mbobola. Musitongogala madla naye.<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />Ngobe ndineni netonga banhu bakuhhe? Ata banhu bamukati kwegubungano lebanamati bamakafanila tonga? <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />Ndzimu unowhotonga banhu bakuhhe. “Tatani nhu mbi pakati kwenyu.”<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">Longa Nlandu Amwe MaKhirisitu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />Hapa umwe wenyu esingawhisisane nehama, angaba netjilopa tjeyenda kunlayo mbeli kwebasakalulama pana kuti ayende kubayengemali? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />Amutoziba kuti bayengemali banowhotonga hango? Hapa hango yowhotongewa namwi, mungakon'wa tonga milandu mitukununu? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />Amutoziba kuti towhotonga batumwa beNdzimu? Nekungapani ke, ndebo dzebutjilo guno! <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />Ngono hapa muna milandu yakajali, moyiyendeselani kubanolingigwa pasi negubungano? <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />Ndoleba ikoku kuti ndimubhatise honi. Kungabe kuli kuti akuna nhu pakati kwenyu unabutjenjebvu gwakalizana kuti ungatonga nlandu wemakamu? <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />Koga hama inoyenda kunlayo igwisana neyimwe hama, mbeli kwebanhu basingagalemoyo!<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />Kuti mulongane nlandu pakati kwenyu kolakidza kuti matjikundiwa kale. Kungentha yeni musingalekedze mukatjinyigwa? Kungentha yeni musingalekedze mukatjebegwa? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />Koga imwi tjekwenyu moyeta zwakayipa mutjebela, nayiko mutjebela hama dzenyu. <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />Amutoziba kuti basakalulama abatowhodla nhaka yebumambo gweNdzimu? Musitjengegwe; kungabe kusazwibhata, kene banamati bemidzimwana, kene bupombgwe kene pinga, kene nlume unowalilana nhobo newumwe nlume kene nkadzi unowalilana nhobo newumwe nkadzi, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />kene mbava, kene bapupi, kene balaladzi, kene banotukana, kene batjebeli akuna umwe wababo ungadla nhaka yebumambo gweNdzimu. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />Bamwe benyu bakabakajalo. Koga makangudziwa, makatjenesewa, makalulamisiwa muzina laHe Yesu Khirisitu nemuMeya yeNdzimu wedu.<verse eid="1CO 6:11" /></para>
  <para style="s">Hingisilani Mibili yenyu Gudzo leNdzimu</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />“Zwinhu zose zobvumigwa kundili,” koga ateyizo zose zwinobhatsha. “Zwinhu zose zobvumigwa kundili,” koga andingayetiwe nlanda netjimwe tjazo. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />“Zodliwa zwakayetigwa ntumbu nentumbu ndewezodliwa.” Kakale Ndzimu unowhopaladza kose bubili gwako. Mbili awuzoyetigwa kusazwibhata, koga kuti uhingile He, kakale He banolawula mbili. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />Ndzimu wakamusa He kubafi naswi bo unowhotimusa ngemasimba awe.<verse eid="1CO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15" />Amutoziba kuti mibili yenyu inhango dzaKhirisitu? Ndizo ndingatola nhango dzaKhirisitu ndikadzithama nhango dzemhombgwe? Aa! <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />Amutoziba kuti unozwibhatshanya nemhombgwe unobe mbili un'ompela nayo? Ngobe, sekwakakwagwa, kuti “Babili banowhoba nyama in'ompela.” <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />Koga iye wakabhatana naHe unobe meya in'ompela naye.<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />Thubukanani nekusazwibhata. Matjinyo amwe ose anoyetiwa nenhu akuhhe kwembili; koga mhombgwe inotjinyila mbili yayo. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />Amutoziba kuti mibili yenyu ithempeli leMeya Yakayengemala imukati kwenyu, yamunayo ibva kuNdzimu? Amutji imwi tjekwenyu; <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />makatengwa nentengo. Ndizo kudzani Ndzimu mumibili yenyu.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">Mibhuzo Nekwendobolo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />Sangwenu ndeelingisana nekwendebo dzamakakwala nekwadzo.</para>
  <para style="p" vid="1CO 7:1">Kwakanaka kuti nlume asitole mfumakadzi. <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />Koga nentha yelikwa kwebupombgwe, nlume umwe newumwe ngaabe nemfumakadzi uwe, nemfumakadzi umwe newumwe abe nenlume uwe. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />Nlume ngaawalilane nhobo nemfumakadzi uwe, nemfumakadzi ayete ejalo bo kunlume uwe. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />Ngobe mfumakadzi atolawula mbili uwe, koga unolawugwa nenlume; sayikoko bo nlume atolawula mbili uwe, koga unolawugwa nemfumakadzi uwe. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />Musitongonyimana kuhhe kwekuti kube kuli kwelubakanyana mabvumilana, kuyetila kuti muzwipile kuntembezelo; mukobva muhangana kakale, swiyo Satane engakobva emulika nentha yesazwidziba.<verse eid="1CO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 7:6" />Ndoleba ikoku kuli tjibvumilano, usinlayo. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />Ndoyemula kuti katshene bose banhu bali sekwandili iko imi tjekwangu. Koga umwe newumwe unatjipo tjitje tjinobva kuNdzimu, umwe unatjegumwe ludzi umwe unatjegumwe bo.<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />Kuna ibabo basakalobola nebasakalobogwa nenjhilikadzi ndoti kwakanaka kuti bagale baliboga sekwandili iko. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />Koga hapa basingatubule kuti bazwidzibe, ngabangine mundobolo. Ngobe kuhine kuti ulobole kene ulobogwe pana kuti utshwe nenjemulo.<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />Kuna bamundobolo ndopa nlayo, kusi imi koga kuli He, kuti mfumakadzi asisiyane nenlume uwe <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />koga hapa akasiyana naye, ngaagale ali yega kene abgwilile kunlume uwe nekuti nlume asitongolamba mfumakadzi uwe.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />Kubamwe bose ndoti, kusi He, hapa hama inamfumakadzi usinghalimoyo, kakale mfumakadzi ebvuma gala naye, asitongowunlamba. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />Hapa nkadzi ananlume usinghalimoyo, kakale nlume ebvuma gala naye, asitongowunlamba. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />Ngobe nlume usinghalimoyo unotjenesewa nemfumakadzi uwe, nemfumakadzi usinghalimoyo unotjenesewa nenlume uwe. Kusakajalo bana benyu babowhobe basakatjena, koga hapa kwakajalo bakayengemala. <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />Koga hapa usingagalemoyo eyemula kuti kupalalaniwe akujalo; hapa kwakajalo nghalimoyo wetjilume kene wetjikadzi wakasununguka haazoyetiwa nlanda. Ngobe Ndzimu wakatidanila mukunyalala. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />Mfumakadzi, unoziba tjini kuti kene unowhotjidza nlume uwo? Iwe nlume, unoziba tjini kuti kene unowhotjidza mfumakadzi uwo?<verse eid="1CO 7:16" /></para>
  <para style="s">Tjila Sekwawakadan'wa neNdzimu</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />Koga, umwe newumwe ngaatjile butjilo gwaakapiwa naHe, igo gwaakadanigwa tjila muguli neNdzimu. Whoyu ndiwo nlayo wangu kumakubungano ebagalimoyo ose. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />Uyapo pakudan'wa kukwe waka atjithumbigwa kale? Ngaasihake kuti aduse mabanga ethumbigwa kukwe. Uyapo pakudan'wa kukwe waka esakathumbigwa? Ngaasihake kuti athumbigwe. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />Ngobe akute kuli thumbigwa kene sathumbigwa kuna n'hingo watjimwe, koga tjikulu whutjengeta milayo yeNdzimu. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />Umwe newumwe ngaagale alimutjimo tjaakadan'wa alimutjili. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />Waka ulinlanda pawakadan'wa? Usizwidziyidze. Koga hapa ungawana lusununguko gugo, thama sayikoko. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />Ngobe nhu wakadan'wa naHe alinlanda wakasununguka muna He. Sayikoku bo wakadan'wa akasununguka unlanda waKhirisitu. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />Makatengwa ngentengo; musibe balanda bebanhu. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />Ndizo, makamu, mutjimo umwe newumwe tjaakadan'wa neNdzimu ali itjo, ngaagale mutjili.<verse eid="1CO 7:24" /></para>
  <para style="s">Mibhuzo Nekwebasakalobogwa Nenjhilikadzi</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />Sangwenu kuna basakalobogwa, andina nlayo unobva kuna He, ndopa nkumbulo wangu senhu unogalikabgwe ngemawhilangoni aHe.<verse eid="1CO 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 7:26" />Ndokumbula kuti hapa takalinga dziyidzika mulubaka guno, kwakanaka kuti nhu agale ali sekwaali. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />Wakalobola? Usihake kuti uthubukane nemfumakadzi. Awuzolobola? Usihake kuti ulobole. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />Koga hapa ulobola, awuzotjinya, nensikana hapa elobogwa haazotjinya. Koga banongina mundobolo banowhohangana nemamanikano emuhango, ndandiyemula mubhatsha kuti mukuleye ikoku.<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />Makamu, ndobva kuti, lubaka gwakabigiwa gwatjibe gufupifupi; kubva ngwenu kuyenda mbeli, bana bafumakadzi ngabatjile sebasina, <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />banolila ngabatjile sebasingalile, banohanha sebasingahanhe, banotenga sebasina zwinhu, <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />banohingidzana nehango sebasingahingidzane nayo. Ngobe tjimo tjehango ino tjowhopinda.<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />Ndohaka kuti musununguke mukuzwimanikanya. Nlume usakalobola unozwimanikanya nekwaHe, kuti angahanhisa He tjini; <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />koga nlume wakalobola unozwimanikanya nezwehango, kuti angahanhisa mfumakadzi uwe tjini, <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />neyemula kukwe kwakapalalana. Nkadzimayi kene nsikana usakalobogwa unozwimanikanya nekwendebo dzaHe, kuti angabe wakayengemala mumbili nemumeya iye tjini; koga nkadzimayi wakalobogwa unozwimanikanya nezwehango, kuti angahanhisa nlume uwe tjini.<verse eid="1CO 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35" />Whoku ndokulebela kuti mube netjamunowana tjekwenyu, kusi kuti ndina tjandinomudzibisa, koga kuti mutjile nezila yakatambunuka makazwipila kwakapelela kuna He, musina mikumbulo mibili.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />Hapa kuna unokumbula kuti unozwibhata nekusakatambunuka kunsikana waanodanana naye, watjikula, malopa awe ewunkulila, watjizwipila, ngaathame seyemula kukwe. Ngabalobolane akutajinyo. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />Koga wayeta tjisungo mumoyo uwe, malopa awe asingawunkulile koga elawula njemulo dzidze, kakale azwibudza mumoyo uwe kuti awutjengete alimhandala, unoyeta tjakalulama. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />Ndizo ke unolobola nsikana uwe unothama zwakanaka; kakale newunozwidziba ngina mundobolo unoyeta zwakanakisisa.<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />Mfumakadzi wakasungiligwa panlume uwe hapa etjatjila. Hapa nlume afa, wakasununguka kuti atogwe newaanohaka, koga hapa ali unogalamoyo munaHe. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />Koga sebona kwangu kwakalulama kuti agale akajalo sekwaali iko. Kakale ndokumbula kuti ndina Meya yeNdzimu.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">Mbhuzo Nekwezodliwa Zwinopigwa Midzimwana</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />Nekwakalingisana nekwezodliwa zwinopigwa midzimwana.</para>
  <para style="p" vid="1CO 8:1">Toziba kuti “Tose tina luzibo.” “Luzibo” goyeta nhu akahonga, koga ludo gosimisa. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />Hapa kuna umwe uno alakana kuti unoziba tjinhu, haanhu akaziba sekwaakafanila ziba. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />Koga hapa nhu eda Ndzimu, unozibgwa neNdzimu.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />Ndizo, hapa kuli kwakalingisana nedla zodliwa zwinopigwa midzimwana, toziba kuti, “midzimwana ayita tjimwe muhango,” kakale nekuti “akuna umwe Ndzimu kuhhe kwe un'ompela.” <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />Nekutobe kuna inoyi midzimwana kudzimu kene muhango sayikoku kuna “midzimwana” minjinji “nabohe” banjinji, <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />koga kutili kuna Ndzimu un'ompela, ibo Tate, kunobva zwinhu zose kakale ibo batinotjilila, naHe un'ompela Yesu Khirisitu, zwinhu zose zobva nemuwunli kakale ndiye watinotjila ndiye.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />Kusineni, akuta ibo bose bana luzibo igogu. Koga bamwe, nentha yekuti bakawolobela midzimwana kudza kube nasi, banodla zodliwa sekunoyi zwapigwa midzimwana; nehana dzabo, dzisakasima, dzoba nehambgwa. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />Zodliwa azwingatisedzedze kuNdzimu. Atita tilibabi kupindisisa hapa tisingadle, kakale atitabahine hapa tikadla.<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />Yelani njele, kuyetila kuti sununguka kwenyu ikoku kusibe tjikunhiso kubasakasima mukugalamoyo. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />Ngobe hapa umwe engakubona, iwe unoyi unaluzibo, udla muthempeli yemidzimwana, hapa hana iye inabutela ikoku akungawunkuludzile kuti adle zodliwa zwakapigwa midzimwana? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />Kubva kuti iwhoyu nghalimoyo unabutela, Khirisitu waakafila, wapaladziwa ngeluzibo gugo. <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />Ndizo, tjinyila hama dzidzo kakale ukubadza hana dzadzo dzinabutela unobe watjinyila Khirisitu. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />Ndizo ke, hapa zodliwa zwithama kuti hama itjinye, anditowhodla nyama tjatjose, swiyo ndikakothama kuti hama itjinye.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">Fanilo neMihingo yeMpositoli</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />Andizosununguka? Anditempositoli? Andizobona Yesu He wedu? Imwi amute mihingo yangu muna He? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />Hapa ndisimpositoli kubamwe, koga ke kumuli ndimpositoli; ngobe mulutjayo gunolakidza bupositoli gwangu muna He.<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />Kuna ibabo banohaka kuti bandiholesese whoku ndiko kuzwidzibilila kwangu. <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />Atitobvumigwa kuti tidle zodliwa kene n'wa tjatinohaka kene? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />Atitobvumigwa kuti tipelekedziwe nebafumakadzi bedu banogalamoyo, sebamwe bapositoli nebanun'una baHe naKhefasi<note caller="+" style="f"><char style="fr" closed="false">9.5 </char><char style="ft" closed="false">Zina letji Aramayiki, kunobva kuti Phethiro netjiGiriki</char></note>? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />Kene ndiBhanabhasi nami koga bakafanila kuti bahingile butjilo gwabo? <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />Ndiyani unohinga senghwi wengwa ezwilipila? Ndiyani unodzwala minda yemahhambi asingadle mitjelo yayo? Ndiyani unolisa zwipfuwo zwaasingakame?<verse eid="1CO 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8" />Whoku ndokuleba nezila yebona kwebanhu? Nlayo awutojalo bo kene? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />Ngobe kwakakwagwa munlayo waMozisi kuti, “Usisunge nlomo wen'ombe hapa ihokola zwidlo.” In'ombe idzedzo Ndzimu dzaana hanya nadzo? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />Haatobva iswi toga? Kwakakwaligwa iswi, ngobe nlimi wakafanila lima analingililo newunohokola analingililo yewana tjimwe tjaanokobegwa muzwidlo. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />Hapa takadzwala zwibuya zwemeya pakati kwenyu, kungabe kunjisa kuti tivune muzwinhu zwenyu zwamunazo? <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />Hapa bamwe benafanilo yebhatshiwa namwi, iswi atinayo bo inopinda iyeyo?</para>
  <para style="p" vid="1CO 9:12">Kusineni, atizohingisa fanilo iyeyo, takawhilidzila muzwinhu zwipi nazwipi pana kuti tise tjisitilo muzila yendebo mbuya yaKhirisitu. <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />Amutoziba kuti bakapiwa n'hingo wemuthempeli banowana zodliwa zwabo muthempeli, banohinga patjibeso tjepisila zwibhayilo abatokobegwa mipilo? <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />Nezila iyo zwayo, He wakalaya kuti banosumikila ndebo mbuya bakafanila wana tjabanotjila natjo kubva mundebo mbuya.<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />Koga andizohingisa kene ipi zwayo yayidzedzi fanilo, kene iko kuti ndokwalila kuti ndipiwe zwinhu izwezo. Ngobe kungabe kuhine kuti ndife pana kuti kube newumwe unonditolela tjandakafanila kuti ndizwikudze natjo. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />Andizofanila zwikudza ngentha yekuti ndosumikila ndebo mbuya. Ngobe ndakafanila yisumikila. Kungandibangalila kungapani hapa ndisingasumikile ndebo mbuya! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />Ngobe ndikayeta ikoku kuli kuda kwangu, ndowhobe nembhayilo, koga hapa kusi kuda kwangu, ndobe ndiyeta n'hingo wandakatumwa ndigaliwabgwe neNdzimu. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />Ngono mbhayilo wangu ini? Ndiko ikoku. kuti mukusumikila kwangu ndiyete ndebo mbuya isibe nenlipo, ndisingahingise nekuhhele fanilo yangu yelipiwa mundebo mbuya.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />Ngobe nekutobe ndakasununguka ndisinlanda webanhu bose, ndakazwiyeta ndikabe nlanda wabo bose, kuti ndizo ndiwanile Khirisitu bamwe banji.<verse eid="1CO 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 9:20" />KumaJuta ndakabe seNjhuta, kuti ndiwane maJuta; kuna bapasi kwenlayo ndakabe sewupasi kwenlayo koga imi ndisi pasi kwenlayo kuti ndiwane bapasi kwenlayo. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />Kuna bakuhhe kwenlayo ndakazwita senhu ukuhhe kwenlayo kusi kuti andina nlayo kuNdzimu koga ndili pasi kwenlayo waKhirisitu-kuti ndiwane bakuhhe kwenlayo. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />Kuna bana butela ndakazwita se unabutela bo, kudze kuti ndibahhise kuna Khirisitu. Ndakabe zwinhu zose kubanhu bose, kuti ndizo ngezila dzose nditubule tjidza bamwe banhu.<verse eid="1CO 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 9:23" />Ndokuyeta kose ikoku ndiyetila ndebo mbuya, kuti ndibe negobe mumakombolelo ayo. <verse eid="1CO 9:23" /><verse number="24" style="v" sid="1CO 9:24" />Amutoziba kuti mutjantangetange banhu bose banolabuka, koga un'ompela ndiye unowana mbhayilo? Ndizo labukani kuti muwane mbhayilo. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />Umwe newumwe nlabuki unozwidziba muzwinhu zose. Whoku banokuthama bekuyetila tjiyala tjinohakala, koga iswi tokuyetila kuti tiwane tjiyala tjisingahakale. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />Ndizo ke imi anditolabuka sewunotatamila tjisipo, anditoposa tjibhakele senhu unoloba mhepo; <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />koga ndonanha mbili wangu ndiwuntshambidzila, kudze kuti ndisilahiwe hule kwesumikila kubamwe.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">Tjenjedzo nekwenamata midzimwana</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />Ndohaka kuti muzibe, makamu angu, bobatategulu bedu bose baka bali kusi kwegole, kakale bose bakapalama nemugungwa, <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />kakale bose bakabvubikiwa mugole nemugungwa bakaba batobeli baMozisi, <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />kakale bose bakadla zodliwa zwemeya zwakafanana <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />kakale bose bakan'wa tjinon'wiwa tjemeya tjakafanana. Ngobe bakan'wa muHongwe yemeya yaka ibapelekedza, Hongwe iyeyo yaka ili Khirisitu. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />Kusineni bunji gwabo Ndzimu haazohanha nekwabo, ngobe bakafa bakapalala mutjilambanyika. <verse eid="1CO 10:5" /><verse number="6" style="v" sid="1CO 10:6" />Zwinhu zose izwezwi zwilakidzilo zwetjenjedza iswi, kuti tisiyemule bubi sekwabakathama. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />Musibe banamati bemidzimwana sekwaka kuli bamwe; sekwakakwagwa kuti, “Banhu bakagala pasi kuti badle kakale ban'we bakamilika bakazanila midzimwana.” <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />Tisitongongina mukusazwibhata sekwakayetiwa nebamwe babo, kwakayeta kuti muhhuba lin'ompela kufe banhu bali zwiwulu zwili makumi mabili nezwitatu (23,000). <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />Tisilike Khirisitu, sekwakayetiwa nebamwe babo bakabulawa nenyoka, <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />kene iko n'un'urika, sekwakayetiwa nebamwe babo bakapaladziwa neMpaladzi. <verse eid="1CO 10:10" /><verse number="11" style="v" sid="1CO 10:11" />Sangwenu zwinhu izwezwi zwakayetikala kuli setjitjenjedzo kubali, koga zwakakwaligwa diya iswi, iswi taswikigwa nebupelo gwelubaka. <verse eid="1CO 10:11" /><verse number="12" style="v" sid="1CO 10:12" />Ndizo unokumbula kuti umile ngaayele njele ngobe angabva ewa. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />Akuna tjiliko tjingakuwila tjisi tjakawolobeleka kubanhu. Ndzimu unogalikamoyo, haangabvumile kuti ulikwe kupehhugwi kwemasimba awunawo, koga hapa kuna tjiliko unokupa bo zila yepudzumuka nayo, kuti utubule kuti utjikulile. <verse eid="1CO 10:13" /><verse number="14" style="v" sid="1CO 10:14" />Ndizo ke, hama dzangu dzinodiwa, letjani namata midzimwana. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />Ndolebeleka nebanhu bana mikumbulo; muzwitongele ndebo yandinoleba. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />Nkombe wekombolela watinokombolela, awuta wekuti tihanganyile mumalopa aKhirisitu kene? Tjinkwa tjatinopemula, atjite tjekuti tihanganyile mumbili waKhirisitu kene? <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />Ngobe kuna tjinkwa tjin'ompela, iswi tili banjinji timbili un'ompela, ngobe tohanganyila mukudla tjinkwa tjin'ompela.<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />Kumbulani banhu beIsirayeli; ibabo banodla zwibhayilo abatobhatika pan'hingo wetjibeso tjezwibhayilo? <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />Ndobva kutini ngono? Kuti zodliwa zwinopigwa midzimwana zwitjimwe, kene iko kuti ndzimwana utjimwe kene? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />Aa, ndobva kuti tjinopigwa midzimwana banotjipa kumeyambi kusi Ndzimu. Anditohaka kuti muhanganyile nemeyambi. <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />Amungan'we nkombe waHe nenkombe wemeyambi. Amungadle zodliwa zwaHe nezodliwa zwemeyambi. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />Tikayikanye He kuti abe nefupa? Tina masimba kuwumpinda?<verse eid="1CO 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />“Zwinhu zose zobvumigwa,” koga ateyizo zose zwinobhatsha. “Zwinhu zose zobvumigwa,” koga ateyizo zose zwinobaka. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />Kusibe newunohaka kuti kunakile iye yega, koga kuti kunakile mbakidzani uwe. <verse eid="1CO 10:24" /><verse number="25" style="v" sid="1CO 10:25" />Dlani kosekose kunotengesewa panotengesegwa zodliwa musingabhuzwe iwo mbhuzo inoyendelana nenkumbulo neholesesa. <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />Ngobe “hango ndeya He, nayiko kose kumuyili.”<verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />Hapa umwe webasingagalemoyo akakukoka kuti uwhodla tjilayilo ukobvuma yenda, udle tjimwe netjimwe tjasiwa mbeli kuko usingabhuzwe iwo mbhuzo unoyendelana nenkumbulo neholesesa. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />Koga umwe nhu akati kukuli, “Whoku kwapigwa kumidzimwana,” nentha yenhu iwhoyu wakubudza, nangentha yehana <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />ndobva, hana iye kusi iyo-usidle.</para>
  <para style="p" vid="1CO 10:29">Ngobe kungentha yeni sununguka kwangu kulawugwa nehana yewumwe nhu? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />Hapa ndidla ngeboka, nentha yeni ndingalebgwa zwakayipa ngentha yetjandabokela?<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />Ndizo, kene unodla kene unon'wa, kene kungabeni tjawunothama, yeta zwinhu zose uyetila gudzo leNdzimu. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />Musigwadziligwe MaJuta kene MaGiriki kene gubungano leNdzimu, <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />sekwandinoyedza kuti ndihanhise banhu bose muzwinhu zose zwandinoyeta, ndisingahake tjandingawana imi, koga tjingawan'wa nebanji, kuti ndizo batjidziwe.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />Todzani imi, saku ndakatodza Khirisitu.<verse eid="1CO 11:1" /></para>
  <para style="s">Mbala tjinhu mun'holo nhu eNamata</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />Ndomukudza ngobe mondikumbula muzwinhu zose kakale motjengeta zwidiyo zwandakamudiya izo. <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />Koga ndohaka kuti muwhisise kuti n'holo wenlume wose ndiKhirisitu, n'holo wenkadzi unlume, n'holo waKhirisitu ndiNdzimu. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />Umwe newumwe nlume unotembezela kene unolebesambeli ana tjaakasa pan'holo unolengudza n'holo uwe, <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />koga umwe newumwe nhu wetjikadzi unotembezela kene unolebesambeli asakambala tjimwe mun'holo unolengudza n'holo uwe-kofanana nekuti wakakerewa n'holo. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />Ngobe hapa nhu wetjikadzi esingambale tjimwe mun'holo, wakafanila kera mavudzi awe; koga hapa kusa honi kuti nhu wetjikadzi akere kene akukubule, ngaasunge tukwi. <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />Nlume azofanila mbala tjimwe mun'holo uwe, saku ali tjiso negudzo leNdzimu; koga nhu wetjikadzi igudzo lenlume. <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />Ngobe nlume haazobva munkadzi, koga nhu wetjikadzi wakabva munlume. <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />Kakale nlume haazobumbiwa ebumbigwa nhu wetjikadzi, koga nhu wetjikadzi wakabumbiwa ebumbigwa nlume. <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />Ndizo nhu wetjikadzi wakafanila sunga tukwi kulayidza kuti upasi kwemasimba, nentha yebatumwa beNdzimu. <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />Nekene kwakajalo, kuna He nhu wetjikadzi ate ali tjimwe kuhhe kwenlume nenlume ate ali tjimwe kuhhe nkadzi; <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />ngobe nkadzi wakabva munlume, ngwenu nlume unotshibamiwa nenhu wetjikadzi. Zwinhu zose zobva kuNdzimu.<verse eid="1CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13" />Muzwibonele imwi; kwakatambunuka kuti nkadzi atembezele kuNdzimu asakasunga tukwi? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />Mbumbiko tjekwayo ayitomudiya kuti hapa nlume ana mavudzi malefulefu kobhatisa honi, <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />koga hapa nhu wetjikadzi enamavudzi malefulefu, igudzo lile? Ngobe mavudzi awe malefulefu wakawapiwa kuti awumfukidze. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />Hapa kuna unohaka nyanyayidza nekwayikoku, akuna umwe nlenje iswi watinawo, kene iwo makubungano eNdzimu awana umwe nlenje.<verse eid="1CO 11:16" /></para>
  <para style="s">Tjilayilo tjaHe</para>
  <para style="r">(<ref loc="MAT 26:26-29">Matewu 26.26-29</ref>; <ref loc="MRK 14:22-25">Mako 14.22-25</ref>; <ref loc="LUK 22:14-20">Luka 22.14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />Koga mumilayo inotobela anditomukudza, ngobe hapa mukubungana, amutokubunganila kuti kube kubuya koga kuti bubi guyendilembeli. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />Ngobe, tjekutanga, hapa muhangana segubungano, ndowha kuyi kuna sawhisisana pakati kwenyu; ndingati ndokugalamoyo ikoku, <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />kwakafanila kuti kube nekupalalana pakati kwenyu kuyetila kuti ibabo belebeswa pakati kwenyu bazibgwe. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />Hapa mukubungana, akuta tjilayilo tjaHe itjetjo tjamunodla. <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />Ngobe sedla kwenyu, umwe newumwe unoyendilambeli edla zodliwa zwizwe, umwe unahhala, umwe wakalaladza. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />Amuna mizi pamunodla nen'wa? Kene molengudza gubungano leNdzimu mubhatisa honi basina tjimwe? Nditini kumuli? Ndimulobele mhande nethama ikoku? Aa, andingathame ndijali.<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />Ngobe imi ndakakuwamutjila kubva kuna He ikoku bo kwandakamudiya, kuti He Yesu mubusiku gwaakatengesewa wakatola tjinkwa, <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />akati atjiboka, akatjipemula, akati, “Iwhoyu umbili wangu unopigwa imwi. Mukuthame ikoku mundikumbula.” <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />Nayiyeyo zila zwayo, bapedza dla, wakatola nkombe, eti, “Nkombe iwhoyu tjibvumilano tjitshwa mumalopa angu. Mukuthame ikoku, gose lubaka hapa muwun'wa, mundikumbula.”<verse eid="1CO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26" />Gose lubaka pamunodla tjinkwa itjetji mun'wa nkombe iwhoyu, mosumikila fa kwaHe edza ebuya. <verse eid="1CO 11:26" /><verse number="27" style="v" sid="1CO 11:27" />Ndizo ke, kene yani, unodla tjinkwa kene unon'wa nkombe waHe asakafanila unowhoba nenlandu wetjinyila mbili nelopa laHe. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />Nhu ngaazwiholesese, ekotjiti odla tjinkwa nen'wa nkombe. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />Ngobe kene yani unodla nen'wa esingawhisise mbili waHe, unozwikokela tongewa pehhugwi kukwe. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />Ndizo wali banjinji pakati kwenyu banabutela kakale banogwala, nebamwe bakatjifa. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />Koga kadzene taka tazwiholesesa kwelebeswa, toba tisingowhotongewa. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />Koga hapa titongewa naHe, totambunudziwa kuyetila kuti tisiwan'we nlandu kan'ompela nehango.<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />Ndizo ke, makamu angu, hapa mukubungana kuti mudle, mumililane. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />Hapa umwe wenyu enahhala, ngaadle kunzi uwe, kuyetila kuti musikubunganile wan'wa nlandu. Zwimwe zwasala ndowhohha ndizwitambunudza pakubuya kwangu.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">Zwipo zwinobva muMeya Yakayengemala</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />Ngwenu ke, nekwezwipo zweMeya, makamu, anditohaka kuti mube banhu basingazibe. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />Moziba kuti pamaka muli Bataya kuNdzimu, makamakalahika, kungabe kene nayipi zila zwako, munamata midzimwana isingalebeleke. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />Ndizo ke ndohaka kuti mukuwhisise kuti akuna nhu unolebeleka ngeMeya yeNdzimu unoti “Yesu ngaalongwe bhiso!” kakale akuna ungati “Yesu ndiHe” kuhhe kwekuti elebeleka ngeMeya Yakayengemala.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />Kuna zwipo zwakasiyana, koga Meya ili iyo zwayo; <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />kuna mihingo bo yakasiyana, koga He kuli iye zwe; <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />kakale kuna hinga kwakasiyana, koga ndiNdzimu iyezwe unokufemela kose munhu wose. <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />Umwe newumwe unopiwa kuzwilakidza kweMeya muwunli kubhatsha bose. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />Umwe Meya inowumpa leba kwebutjenjebvu ngeMeya, umwe unopiwa leba kweluzibo ngeMeya iyo zwayo, <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />umwe unopiwa kugalamoyo ngeMeya iyo zwayo, umwe unopiwa zwipo zwepolesa ngeMeya iyo zwayo, <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />umwe unopiwa thama matjenamiso, umwe unopiwa bulebesambeli, umwe unopiwa tubula siyanisa dzimeya, umwe unopiwa tjipo tjendimi dzakasiyana siyana, umwe unopiwa tjipo tjetjenesa ndimi. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />Kose ikoku kofemegwa ngeMeya in'ompela ili iyo zwayo, inokobela zwipo kuwumwe newumwe sekuda kwayo.<verse eid="1CO 12:11" /></para>
  <para style="s">Mbili un'ompela unaNhango njinji</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />Sembili uli un'ompela una nhango njinji, nhango dzose dzembili, nekene dzilinjinji, dzimbili un'ompela, Khirisitu bo wakajalo. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />Ngobe ngeMeya in'ompela takabvubikiwa mumbili un'ompela, maJuta kene maGiriki, balanda kene bakasunungugwa-kakale tose takatiwa kuti tin'we kweMeya in'ompela.<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />Ngobe mbili awuna nhango in'ompela koga una njinji. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />Hapa gumbo lingati, “Ngobe andita luboko, andita wembili,” ikoku akutowholithama likasibe nhango yembili. <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />Hapa zebe ingati, “Ngobe andita hhiho, andita wembili,” ikoku akutowhoyithama ikasibe nhango yembili. <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />Kadzene mbili wose waka uli hhiho, wawowha neni? Hapa mbili wose waka uli zebe, wawonhuwidza neni? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />Koga sekwawuli, Ndzimu wakabiganya imwe neyimwe nhango mumbili, sehala kukwe. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />Hapa nhango dzose dzembili dzadzili nhango in'ompela, mbili wawhoba poni? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />Sekwawuli iko, unanhango njinji, koga ulimbili un'ompela.<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />Hhiho alingati kuluboko, “Andina n'hingo nawe,” kene n'holo uti kugumbo, “Andina n'hingo nawe.” <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />Koga nayidzo nhango dzembili dzinolingika dzisina n'hingo atingatjile kuhhe kwadzo, <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />nhango dzembili dzatinokumbula kuti adzina n'hingo ndidzo dzatinokudza kwazo, nenhango dzembili dzisingadusigwe patjena dzobhakwa ngenjele whulu <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />kupinda nhango dzinodusigwa patjena. Koga Ndzimu wakabumba mbili, epa gudzo gulu kunhango dzinolingigwa pasi, <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />kuyetila kuti kusibe nesawhisisana mumbili, koga kuyetila kuti nhango dzibhatshane nekwakalizana. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />Hapa imwe nhango idziyidzika, dzose dzodziyidzika panhu pan'ompela; hapa in'ompela ikudziwa, dzohanha dzose panhu pan'ompela.<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />Mabe mbili waKhirisitu nenhango dzawo umwe newumwe. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />Mugubungano lebagalimoyo Ndzimu wakahala bapositoli kutanga, bebubili balebesambeli, bebutatu badiyi, kukotjiti bayeti bematjenamiso, kukotjiti bapolesi, bawahhi, babhati bemihingo, nebalebeleki bendimi dzakasiyana siyana. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />Bose babapositoli? Bose babalebesambeli? Bose babadiyi? Bose banoyeta matjenamiso? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />Bose banazwipo zwepolesa? Bose banolebeleka nedzindimi? Bose banothalusa ndimi? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />Koga yemulani ngemalebeswa zwipo zwipehhugwi.</para>
  <para style="p" vid="1CO 12:31">Ndowhomulakidza zila mbuya kwazo.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">Ludo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />Hapa ndilebeleka nendimi dzebanhu nedzebatumwa beNdzimu, koga ndisina ludo, ndonga tshipi inolidziwa ita hhoba, kene kilogo inolila. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />Ne hapa ndinamasimba ebulebesambeli, ndiwhisisa zwakasumbikika zose neluzibo gose, nehapa ndina kugalamoyo kose, kunomilidza matombo, koga ndisina ludo, andita ndili tjimwe. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />Hapa ndikoba kose kwandinako, ndingapa mbili wangu kuti upisiwe<note caller="+" style="f"><char style="fr" closed="false">13.3 </char><char style="ft" closed="false">dzimwe whalo dzoti. Kudze ndizwikudze</char></note>, koga ndisina ludo, anditobuyigwa netjimwe.<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />Ludo guna moyonlefu kakale guna bunhu, ludo aguna fupa kene kuzwikudza, <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />agutohaya mazwibhato. Ludo agutozwihakila yago zila, agutogwadzisiwa moyo kakale gotjimbidza kangan'wa tjinyigwa, <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />agutohanhila tjakaleleka, koga gohanhila tjaakalulama. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />Ludo agutonyala moyo muzwinhu zose, gogalamoyo zwinhu zose, gogalabgwe zwinhu zose, gosimidzila muzwinhu zose.<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />Ludo agutopela, hapa kuli bulebesambeli, kowhopinda, hapa kuli ndimi, dzowhopela, hapa kuli luzibo, gowhopela. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />Ngobe luzibo gwedu aguzopelela nelebesambeli kwedu akuzopelela, <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />koga panowhohha kwakapelela, kusakapelela kowhopinda.<verse eid="1CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11" />Nditji mwana, ndaka ndilebeleka semwana, ndaka ndikumbula semwana, ndi alakana semwana; pandakaba nlumetate, ndakasiyana neyeta kwebutjetjana. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />Ngobe ngwenuwali tobona mutjiboni kusingaboneseseke, koga nayigogo lubaka towhoba takalingisana kubuso. Kwangwenu ndoziba nyana, nayigogo lubaka ndowhowhisisa ngekuhhele, sewhisisiwa kwangu kwakapelela.<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />Ndizo ikoku kutatu. Galamoyo, galabgwe, neludo akutowhopinda, koga kukulu pana iko kose ludo.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">Zwipo Zwinopiwa ngeMeya</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />Tobelani zila yeludo, kakale yemulani kwazo zwipo zwemeya, kwazo kwazo kuti mulebesembeli. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />Ngobe unolebeleka nelulimi gweMeya atolebeleka nebanhu koga unolebeleka neNdzimu; ngobe akuna unowuwhisisa, koga unoleba zwakasumbikika muMeya. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />Koga unolebesambeli unolebeleka nebanhu ebasimisa, ebakulumbidza, kakale ebanyaladza. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />Unolebeleka nelulimi gweMeya unozwibaka iye, koga unolebesambeli unobaka gubungano.<verse eid="1CO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5" />Ngwenu ndohaka kuti mose mulebeleke nendimi, koga kwazokwazo kuti mulebesembeli. Unolebesambeli unkulu pana unolebeleka nendimi, kuhhe kwekuti kube newunotjenesa, kudze gubungano libakike. <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />Ndizo makamu, hapa ndihha kumuli ndilebeleka nendimi, ndoba ndimutjidza neni kuhhe kwekuti ndihhisa zumbunulo kene luzibo kene bulebesimbeli kene tjidiyo?<verse eid="1CO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 14:7" />Kene zwinolidziwa zwisina butjilo, zwinonga nyele kene dende, hapa zwisina nsindo wakapalalana, nhu ungaziba tjini kuti ndikupi kunolila? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />Hapa lunyanga gulila, nensindo usingazibgwe ndiyani unowhozwilulamisila ngwa? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />Ngono imwi dumbu; hapa mulebeleka nelulimi gweMeya ndebo isingawhisisike, banhu banowhoziba tjini kuti kwayin'wi? Ngobe mowhoba mulebeleka mumhepo. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />Lebeswa kuna ndimi njinji dzakasiyana muno muhango, kakale akuna lulimi gusina tjagunobva; <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />koga hapa ndisingazibe kuti gobvani, ndowhoba ndili ntaya kunlebeleki nayiye ali ntaya bo kundili. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />Kwakajalo nekumuli; saku makazwipila kuti mube nezwipo zweMeya, hingani zwakabangalala musimisa bukulu kunobaka gubungano.<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />Ndizo ke, unolebeleka nelulimi gweMeya wakafanila tembezelela kuti abe nemasimba etjenesa. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />Ngobe hapa nditembezela nelulimi gweMeya, meya yangu inoba itembezela koga nkumbulo awuna bhatsho. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />Nditetjini ngono? Ndowhotembezela nemeya ndikatembezela nenkumbulo kakale; ndowhomba nemeya ndikamba nenkumbulo bo kakale. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />Hapa uboka<note caller="+" style="f"><char style="fr" closed="false">14.16 </char><char style="fq" closed="false">uboka </char><char style="ft" closed="false">uboka Ndzimu</char></note> nemeya, umwe nhu usingawhisise angati, “Akujalo” tjini, kuboka kuko, iye asingazibe kuti notini? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />Ngobe ungaboka nekuhhele, koga umwe nhu esingabakike.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />Ndoboka Ndzimu kuti ndolebeleka nendimi kumupinda mose; <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />kusineni, mugubungano kuhine ndilebeleke matama mahanu ndihhisa nkumbulo wangu, kuti ndilaye bamwe, pana kuti ndilebe matama alizwiwulu zwiligumi ngelulimi gweMeya.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />Makamu, musibe batjetjana mukukumbula kwenyu; ibani ngawana mumatjinyo, koga mukukumbula ibani bawhola. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />Munlayo kwakakwagwa kuti,</para>
  <para style="q1" vid="1CO 14:21">“Ndihingisa banhu bendimi dzisingawhisisike</para>
  <para style="q2" vid="1CO 14:21">nemilomo yebataya,</para>
  <para style="q1" vid="1CO 14:21">ndowholebeleka nebanhu ibaba,</para>
  <para style="q2" vid="1CO 14:21">nekene kwakajalo abatowhondiwhilila, kujalo He.”<verse eid="1CO 14:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="1CO 14:22" />Ndizo wali, ndimi tjilakidzilo tjisi tjebagalimoyo, koga tjebasingagalemoyo, bulebesimbeli aguta tjilakidzilo tjebasingagalemoyo, koga ndetjebagalimoyo.<verse eid="1CO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23" />Ndizo ke, hapa gubungano lose lahangana banhu bose beba belebeleka nendimi, banhu bakuhhe kene basingagalemoyo hapa beswika, abatowhoti mopenga? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />Koga hapa moseni mulebesambeli, kukongina usingagalemoyo kene nhu wekuhhe, unotambunudziwa namwi mose ekolayidziwa butjinyi gugwe namwi mose, <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />zwakasumbikika zwemoyo uwe zobapatjena; unowhokotama akanamata Ndzimu epa busupi kuti Ndzimu upakati kwenyu kwelebeswa.<verse eid="1CO 14:25" /></para>
  <para style="s">Mamo Akatambunuka Mugubungano</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />Nditini ngono makamu? Hapa mukubungana, umwe unalumbo gwemba, umwe unatjidiyo tjediya, umwe una zumbunulo, umwe unolebeleka nelulimi gweMeya, kene tjenesa. Kose ikoku ngakuyetigwe kuti kubakiwe gubungano. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />Hapa umwe elebeleka nelulimi gweMeya, ngakube nebabili koga kene batatu koga betobedzana, umwe atjenese. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />Koga hapa kusina unotjenesa, umwe newumwe wabo ngaanyalale pakati kwegubungano, alebeleke yega tjemumoyo neNdzimu. <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />Ngakulebeleke balebesambeli babili kene batatu, bamwe bahakisise kuti tjinolebgwa malebeswa kene? <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />Umwe ugele hapa akapiwa zumbunulo, wayelebeleka kutanga ngaanyalale. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />Ngobe moseni mungalebesambeli mutobedzana, kuyetila kuti moseni mudiyike kakale mukulumbidzike; <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />kakale meya yebalebesambeli inolawugwa nebalebesambeli. <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />Ngobe Ndzimu haata Ndzimu wekwakaleyana koga ndiNdzimu wekunyalala.</para>
  <para style="p" vid="1CO 14:33">Sekwakuli iko mumakubungano ose ebayengemali, <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />banhu betjikadzi bakafanila nyalala mugubungano. Ngobe abatobvumigwa lebeleka, koga bakafanila zwisa pasi, nenlayo unojalo bo. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />Hapa kuna tjabanoyemula ziba, ngababhuzwe balume babo kanyi. Ngobe kobhatisa honi kuti nhu wetjikadzi alebeleke mugubungano.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />Ini! Dama leNdzimu lakatangisila pamuli, kene lakaswika kuna imwi moga? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />Hapa kuna unokumbula kuti unlebesambeli, kene unatjipo tjemeya, wakafanila ziba nekuhhele kuti tjandinomukwalila unlayo waHe. <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />Usingawamutjile ikoku, nayiye atowamutjigwa.<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />Ndizo ke, makamu angu, yemulani lebesambeli, kakale musidzibise lebeleka nendimi; <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />koga zwinhu zose zwakafanila yetiwa zwakanaka ngendongoloso.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">Muka Kubafi kwaKhirisitu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />Ndohaka mukumbudza, makamu, nekwendebo mbuya yandaka sumikila kumuli, yamakawamutjila, yamumile pehhugwi kwayo, <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />yamunotjidziwa ndiyo, hapa kuli kuti makabhatilila mudama landakasumikila kumuli kuhhe kwekuti makagalilamoyo suli.<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />Ngobe ndakamupa tjikulu tjandakawamutjila bo, kuti Khirisitu wakafila matjinyo edu sekwakunolebgwa newhalo, <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />kuti wakabiganyiwa, kuti wakamusiwa kubafi muhhuba lebutatu sekwakunolebgwa newhalo, <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />nekuti wakazwilakidza kuna Khefasi<note caller="+" style="f"><char style="fr" closed="false">15.5 </char><char style="ft" closed="false">Zina letji Aramayiki, kunobva kuti Phethiro netjiGiriki</char></note>, akakozwilakidza kuna beligumi nebabili. <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />Akakozwilakidza kubagalimoyo banopinda makulu mahanu, mulubaka gun'ompela bunji gwabo batjibapenyu, nekutobe bamwe bakatjiyizela. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />Wakakozwilakidza kuna Jakobe, nekubapositoli bose.<verse eid="1CO 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8" />Kubupelo, wakazwilakidza kundili, imi ndinonga wakazwagwa nelubaka gusiyigo. <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" />Kana ndintukunu pabapositoli, andizofanila dan'wa ndiyi mpositoli, ngobe ndakadziyidza gubungano leNdzimu. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />Koga ndi iko kwandili iko ngengoni dzeNdzimu, kakale ngoni dzidze kundili adzizotongoba suli. Koga ndakahinga zwakasima kupinda bose, nenguba kwaka kusi imi, koga kuli ngoni dzeNdzimu dzimundili. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />Kuti kwaka kuli imi kene kwaka kuli ibo, sayikoku ke tosumikila, kakale imwi makagalamoyo.<verse eid="1CO 15:11" /></para>
  <para style="s">Muka kwedu Kubafi</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />Hapa kusumikigwa kuti Khirisitu wakamuka kubafi, bamwe benyu bangati akuna musiwa kubafi tjini? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />Koga hapa kusina kumuka kubafi, kobva kuti Khirisitu haazomusiwa; <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />hapa Khirisitu esakamusiwa, kubva kuti tosumikilila suli namwi mogalilamoyo suli. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />Toba tisingalebe lebeswa nekweNdzimu, ngobe takapa busupi kuti Ndzimu wakamusa Khirisitu, waasakamusa hapa kuli lebeswa kuti bafi abatomusiwa. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />Hapa bafi besingamusiwe, kubva kuti Khirisitu haazomusiwa. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />Hapa Khirisitu esakamusiwa, galamoyo kwenyu akuna n'hingo, kakale mutji mumatjinyo enyu. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />Ndizo na ibabo bakalala beli muna Khirisitu bakapalala. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />Hapa mubutjilo igogu tili banhu bakagalamoyo muna Khirisitu koga, tibanhu banofanila whigwa ngoni kwazosa.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />Koga ke lebeswa ndelekuti Khirisitu wakamusiwa kubafi, alimbano yebakatjiyizela. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />Ngobe saku lufu gwakahha ngenhu, muka kubafi kwahha bo ngenhu. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />Ngobe semuna Adamu wose nhu unofa, sayikoko muna Khirisitu wose nhu unowhoyetiwa akaba mpenyu. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />Koga umwe newumwe nenlongoloso iye. Khirisitu sentjelo wekutanga, kukotjiti pakubuya kukwe ibabo banotobela Khirisitu. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />Kukotjiswika bupelo, paanowhotula bumambo kuna Ndzimu Tate hule kwepaladza gose butongi nebutungamili gose nemasimba ose. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />Ngobe wakafanila tonga kudzina asa zwita zwizwe zose kusi kwemakumbo awe. <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />Tjita tjebupelo tjinowhopaladziwa, lufu. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />Ngobe lukwalo goti, “Ngobe Ndzimu wakasa zwinhu zose pasi kukwe, kusi kwemakumbo awe.” Koga hapa guti, “Zose zwinhu,” kupatjena kuti akutohanganyila Ndzimu tjekukwe, iye unosa zwinhu zose pasi kwaKhirisitu. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />Hapa zwinhu zose zwatjiba pasi kukwe, Nkololo tjekukwe unowhoba pasi kukwe iye unosa zwinhu zose pasi kukwe, kuyetila kuti Ndzimu abe zwinhu zose kunhu wose.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />Banhu banobvani hapa beti banobvubikigwa bafi? Hapa bafi besingamusiwe kubafi, kungentha yeni banhu bebvubikigwa bafi? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />Kungentha yeni tizwisa mumboli lubaka gose? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />Kakale hhuba nehhuba ndolingisana nelufu makamu angu! Ikoku ilebeswa, sekwandinozwiloba fuba ngekwenyu muna Khirisitu Yesu He wedu. <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />Ndobuyigwa neni hapa ndakagwisana nezwibanda kuEfesu ndikuyetila hanhisa banhu? Hapa bafi besingamusiwe, “Ayidleni tin'weni, ngobe mangwana towhofa.”<verse eid="1CO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />Musitjebegwe. “Bakhwinya basakalulama banotjinya mazwibhato akanaka.” <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />Musani mikumbulo yenyu yakalulama, musitjatjinye. Ngobe bamwe abana luzibo nekweNdzimu. Ndoleba ikoku mwaza kuti mubhakhwe nehoni.<verse eid="1CO 15:34" /></para>
  <para style="s">Mbili weMuka kuBafi</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />Umwe nhu unowhobhuzwa eti, “Bafi banomusiwa tjini? Banomuka bana mbili upi?” <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />Iwe tjilengwe! Tjawunodzwala atjitoba tjipenyu hapa tjisatanga tjafa. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />Kakale hapa udzwala, awutodzwala mbili unowhoba iwo zwawo wemela, koga nodzwala mbewu yoga, kene ndeyepfunde kene kumwe zwako. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />Koga Ndzimu unotjipa mbili waahala iye, imwe neyimwe mbewu inopiwa mbili wayo.<verse eid="1CO 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39" />Ngobe yose mibili ayitofanana, kuna ludzi gwenhu, kuna gwemhuka, negwenyunyi, negwewhobe.<verse eid="1CO 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40" />Kakale kuna mibili yekudzimu nemibili yemuhango; penyelela kwembili wekudzimu kosiyana nepenyelela kwembili wemuhango. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />Kuna tjedza tjehhuba, tjakasiyana netjedza tjemwedzi, kakale tjakasiyana netjedza tjenyenyedzi; imwe nyenyedzi tjedza tjayo tjosiyana netjeyimwe nyenyedzi.<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />Ndizo ke kwakajalo bo nemuka kwebafi. Mbili unotshigwa unobola, mbili unomusiwa awutobola. <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />Unotshigwa usina gudzo, unomusiwa unagudzo, unotshigwa usinasimba, ukamusiwa unasimba. <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />Unotshigwa ulimbili wenyama, pawunomusiwa, unoba wabe mbili wemeya. Hapa kuna mbili wenyama kunambili wemeya kakale. <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />Ndizo kwakakwagwa kuti, “Nhu wekutanga Adamu wakabanhu mpenyu,” Adamu webupelo wakaba meya inopa bupenyu. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />Koga akuta mbili wemeya wakatanga, umbili wenyama, kukotjihha mbili wemeya. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />Nhu wekutanga wakabumbiwa nentapwe ebva muhango; nhu webubili unobva kudzimu. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />Sekwaaka ali iko nhu wakabumbiwa nentapwe, banhu bakabumbiwa nentapwe bakajalo bo; sekwaali iko nhu wekudzimu, banhu bekudzimu bakajalo bo. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />Sayikoku tinatjiso tjenhu wakabumbiwa nentapwe, towhobe netjiso tjenhu wekudzimu.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />Ndomubudza, makamu. Nyama nelopa akungawamutjile nhaka yebumambo gweNdzimu, kene iko kunobola akungawamutjile nhaka yekusingabole.<verse eid="1CO 15:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51" />Whililani! Ndomubudza tjakasumbikika. Atitowholala toseni, koga tose towhohandugwa, <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />nelubakanyana, setshika kwehhiho, palila kwelunyanga gwebupelo. Ngobe lunyanga gowholila, bafi banowhomusiwa besingatjabole, kakale towhohandugwa. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />Ngobe mbili iwhoyu unobola wakafanila mbala kusabola, nembili iwhoyu unofa wakafanila mbala safa. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />Hapa mbili unobola umbala kusabola, nembili unofa umbala safa, Kowhohhadzisika lukwalo gunoti, “Lufu gwamidziwa mukukundiwa.”<verse eid="1CO 15:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55" />“Lufu wee, kunda kuko kuponi?</para>
  <para style="q1" vid="1CO 15:55">Lufu wee, lubolela gugo kuponi?”<verse eid="1CO 15:55" /></para>
  <para style="m">
    <verse number="56" style="v" sid="1CO 15:56" />Lubolela gwelufu ijinyo, masimba ejinyo unlayo. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />Koga toboka Ndzimu, unotiwamutjidza kukunda muna He Yesu Khirisitu wedu.<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />Ndizo ke, makamu angu anodikan'wa, simani, musingazunguzike, misi yose muzwipile ngekuhhele mun'hingo waHe, muziba kuti, muna He n'hingo wenyu awuta uli suli.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">Zwipo zwinopiwa Bagalimoyo Banohaya</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />Ngwenu ke, nekwemali inopiwa bayengemali. Makafanila yeta bo sekwandakalaya makubungano ekuGalathiya. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />Muhhuba lekutanga leyimwe neyimwe tshipi, umwe newumwe pakati kwenyu wakafanila ba netjaanosa ntome etjibiga, kuyendidzana newana kukwe, kuyetila kuti kusitangise kubunganyiwa ndatjiswika. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />Hapa ndiswika, ndowhotuma ibabo bamahala bena lukwalo kuti bayendise tjipo tjenyu kuJerusalema. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />Hapa kuhakika kuti nami bo ndiyende, banowhoyenda nami.<verse eid="1CO 16:4" /></para>
  <para style="s">Ndongoloso yaPhawuli</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />Ndowhomukumba ndatjibva kuMakhedoniya, ngobe ndohaka palama nekuMakhedoniya, <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />pamwe swiyo ndowhotongogala namwi kwelubaka, kene mbaba yose, kuyetila kuti mundibhatshe mugwendo gwangu, kene poni kwandinowhohala yenda. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />Ngobe anditohaka mubona ngwenuwali ndipinda; ndogalabgwe ndowhotongoba namwi kwelubaka, hapa He bebvuma.<verse eid="1CO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8" />Koga ndowhogala kuEfesu kudza kuswika nsi wePhentekhositi, <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />ngobe kwahhulika nkoba nkulu kuti ndihinge zwakanaka, koga ke kunazwita zwinjinji.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />Thimothi paanobuya, muwuwamutjileni zwakanaka kudze asihle, ngobe unohinga n'hingo waHe sami. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />Kusibe nenhu unowunlingila pasi. Muwumbhatsheni nekunyalala mugwendo gugwe, kudze ahanduke kundili; ngobe ndakawunlindila, iye nebamwe bagalimoyo.<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />Ngekwegamu ledu Apholosi, ndakalika wuntetedza kuti awhomukumba enabamwe bagalimoyo, koga kwakabe kusi kuda kukwe kuti ahhe ngwenuwali. Unowhohha paanowhowana lubaka gwakalulama.<verse eid="1CO 16:12" /></para>
  <para style="s">Matama Ebupelo</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />Tjenjelani, mume makasima mukugalamoyo kwenyu, mube netjilopa, musime. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />Kose kwamunothama mukuthame ngeludo.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />Moziba kuti n'ha waSitefanasi wakaba wekutanga handuka muAkhayiya, kakale bakazwipila hingila bayengemali. Ndomukumbila, makamu, <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />kuti muzwise pasi kwebanhu bakajalo napasi kwewumwe newumwe unobhatika mun'hingo ne unohinga.<verse eid="1CO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17" />Ndohanha nehha kwaSitefanasi, naFotjunathasi, naAkhayikhasi, kubepo kwabo kwakatjidza kuhhalila sabapo kwenyu; <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />ngobe bakanyalulusa meya yangu kan'ompela neyenyu. Muzibe banhu bakajali.<verse eid="1CO 16:18" /></para>
  <para style="s">Buyisa Kwebupelo</para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />Makubungano ekuAsiya anomubuyisa. Akhwila naPhirisika, kan'ompela negubungano linonginila mun'umba yabo, banomubuyisa kwazo muzina laHe. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />Bose bagalimoyo banomubuyisa.</para>
  <para style="p" vid="1CO 16:20">Buyisanani neputa kwakayengemala<note caller="+" style="f"><char style="fr" closed="false">16.20 </char><char style="fq" closed="false">Buyisanani neputa kwakayengemala </char><char style="ft" closed="false">zila yelezwana kwebanhu beku Asiya</char></note>.<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />Imi Phawuli, ndokwala negwangu luboko ndimulebelesa.<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />Hapa kene yani esina ludo kuna He, ngaabe nebhiso.</para>
  <para style="p" vid="1CO 16:22">
    <char style="tl">Marana tha</char>-He wedu, ihhani!<verse eid="1CO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23" />Ngoni dzaHe Yesu ngadzibe namwi.<verse eid="1CO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />Ludo gwangu gube namwi mose muna Khirisitu Yesu. Akujalo.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>