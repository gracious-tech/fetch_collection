<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CO" style="id">- Kalanga Bible Translation</book>
  <para style="h">2 BaKhorinte</para>
  <para style="toc1">Paul's Second Letter to the CORINTHIANS</para>
  <para style="toc2">2 BaKhorinte</para>
  <para style="toc3">2 BaKho</para>
  <para style="mt2">Lukwalo Gwebubili gwaPhawuli ekwalila</para>
  <para style="mt1">BAKHORINTE</para>
  <para style="imt">Tjinginiso</para>
  <para style="ip">
    <char style="bk">Lukwalo Gwebubili gweBaKhorinte</char> gwakakwagwa naMpositoli Phawuli hule kwemakole angaba makumi mahanu nemahanu kuyenda kumakumi mahanu ana kutanhatu Khirisitu azwagwa (2 BaKhorinte 1.1). Igogu lukwalo ndegwebubili gwatinago Phawuli gwaakakwalila gubungano lekuKhorinte. Bazibi banogalamoyo kuti Phawuli kutanga waka akwalila banhu bekuKhorinte ehingisa matama makukutu. Atinago lukwalo gwaanobva muna (2 BaKhorinte 2.3-4). <char style="bk">Lukwalo Gwebubili gweBaKhorinte</char> Phawuli angaba akagukwala ali kuMakhedoniya (2 BaKhorinte 2.13).</para>
  <para style="ip">
    <char style="bk">Lukwalo Gwebubili gweBaKhorinte</char> gwakasiyana nedzimwe whalo, ngobe goleba nekukwe nezwiwha kukwe. Phawuli unoleba nekwehanha kukwe nekwematama akanaka akabva kuna Thayithasi eleba nekwegubungano lekuKhorinte. Mulukwalo igogu tohangana netjidiyo tjipabi nekwepa kunoyendidzana nezwiyetikalo zwimuThesintamente Ndzwa, mutjikamu Phawuli epa milayo nekwemali yaka idusiwa nebanhu inoyendisiwa kuti inobhatsha bagalimoyo kuJerusalema (2 BaKhorinte 8.1-9.15). Ungati bapositoli bemanyepwa basimugubungano bakabehingisa lubengo gwebamwe banhu bamugubungano baka bebenga Phawuli kuti bazwimilidze. Bakabeyeta kuti banhu basigalebgwe simba laPhawuli, kungaba iko kwakayeta akaleba zwakasima nekwemasimba awe sempositoli waYesu Khirisitu kubupelo <char style="bk">gweLukwalo Gwebubili gweBaKhorinte.</char></para>
  <para style="iot">Nlongoloso Yezwimukati</para>
  <para style="io1">Phawuli unotangisa nebuyisa gubungano (2 BaKh 1.1-7).</para>
  <para style="io1">Phawuli unoleba nekwenjendo dzidze nematama aakawamutjila nekwabo nen'handulo yabo yelukwalo gwaakabakwalila (2 BaKh 1.8-7.16).</para>
  <para style="io1">Phawuli unopa milayo nekwemali yakalobgwa nebanhu inoyendisiwa kuti inobhatsha bagalimoyo kuJerusalema (2 BaKh 8.1-9.15).</para>
  <para style="io1">Kubupelo, Phawuli unomila bupositoli gugwe nebazibisa nekwehha kukwe kunotobela (2 BaKh 10.1-13.10).</para>
  <chapter number="1" style="c" sid="2CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1" />Kubva kuna Phawuli, mpositoli waKhirisitu Yesu ngekuda kweNdzimu, naThimothi gamu ledu.</para>
  <para style="p" vid="2CO 1:1">Kugubungano leNdzimu likuKhorinte, nekubayengemali bose bamuntunhu wose we Akhayiya.<verse eid="2CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 1:2" />Ngoni nekunyalala kunobva kuNdzimu tate bedu naHe Yesu Khirisitu ngakube kumuli.<verse eid="2CO 1:2" /></para>
  <para style="s">Phawuli Unoboka Ndzimu</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3" />Ngaalumbidziwe Ndzimu, Tate baHe wedu Yesu Khirisitu, Tate bemawhilangoni ibo bali Ndzimu wekuludzila kose, <verse eid="2CO 1:3" /><verse number="4" style="v" sid="2CO 1:4" />banotinyaladza mumagwadzo edu ose, kuyetila kuti titubule nyaladza ibabo bamumagwadzo kene api zwayo, nenyaladza iswi tjekwedu kwatinonyaladziwa ndiko neNdzimu. <verse eid="2CO 1:4" /><verse number="5" style="v" sid="2CO 1:5" />Ngobe saku tidziyidzika kan'ompela naKhirisitu mukudziyidzika kukwe kunjinji, muna Khirisitu tina kunyaladziwa kunjinji kakale bo. <verse eid="2CO 1:5" /><verse number="6" style="v" sid="2CO 1:6" />Hapa iswi tidziyidziwa, ndekwenyaladziwa netjidziwa kwenyu; hapa tinyaladziwa, ndekwenyaladziwa kwenyu, kwamunowana hapa mudzikitidza nemoyonlefu muli mukudziyidzika kwatinodziyidziwa bo. <verse eid="2CO 1:6" /><verse number="7" style="v" sid="2CO 1:7" />Kumugalabgwe kwedu akutozunguzika; ngobe toziba kuti saku muli mukudziyidzika kan'ompela naswi, mowhonyaladziwa kan'ompela naswi.<verse eid="2CO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8" />Atitohaka kuti musizibe, makamu, nekwedziyidzika kwatakabenako mu Asiya; kwaka kuli kunjisa, kuli pehhugwi kwemasimba edu, kuswikila tatoboka igo butjilo tjekwago. <verse eid="2CO 1:8" /><verse number="9" style="v" sid="2CO 1:9" />Lebeswa, takatozwiwha tawamutjila ntongo welufu; koga ikoku kwaka kuwhoyeta kuti tisibhatilile mukutubula kwedu koga tibhatilile kuNdzimu unomusa bafi; <verse eid="2CO 1:9" /><verse number="10" style="v" sid="2CO 1:10" />wakatibvubula mumboli yakabangalala yelufu, kakale unowhotitjidza; tegalabgwe muwunli kuti unowhotitjidza kakale, <verse eid="2CO 1:10" /><verse number="11" style="v" sid="2CO 1:11" />sekwamunotibhatsha nemitembezelo. Ndizo banjinji banowhotibokela makombolelo atakapiwa kuli handugwa kwemitembezelo yebanji.<verse eid="2CO 1:11" /></para>
  <para style="s">Phawuli Unotjowhopela Akakumba</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12" />Zwiloba fuba kwedu ndiwhoku. Busupi gwehana dzedu kuti takazwibhata nekuyengemala nehalabvuka kunobva kuNdzimu muhango, kwazo kwazo mbeli kwenyu, kusi ngebutjenjebvu gwemuhango koga ngengoni dzeNdzimu. <verse eid="2CO 1:12" /><verse number="13" style="v" sid="2CO 1:13" />Ngobe tomukwalila tjamungabala mukawhisisa tjoga; ndogalabgwe mowhowhisisa nekuhhele, <verse eid="2CO 1:13" /><verse number="14" style="v" sid="2CO 1:14" />semamuwhisisa nyana kuti mungazwikudza nekwedu sayikoku naswi bo tingazwikudza nekwenyu, muhhuba laHe Yesu.<verse eid="2CO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15" />Ngentha yekuti ndaka ndina lebeswa nayikoku, ndaka ndihaka buya kumuli kutanga, kuyetila kuti mube nemakombolelo akapamhiwa kabili; <verse eid="2CO 1:15" /><verse number="16" style="v" sid="2CO 1:16" />ndaka ndihaka mukumba nditjimugwendo gweyenda kuMakhedoniya, nepinda kumuli kakale ndebva kuMakhedoniya kudze mundipeleke kuJudiya. <verse eid="2CO 1:16" /><verse number="17" style="v" sid="2CO 1:17" />Kuti nkumbulo wangu waka usigedzikene pandakandihaka thama ikoku? Kene kuti ndobaakanya ndongoloso dzangu senhu wamuno muhango, ndakalulamila kuti “Ee, ee” na “Aa, aa” lubaka igo zwago? <verse eid="2CO 1:17" /><verse number="18" style="v" sid="2CO 1:18" />Koga seNdzimu egalikabgwe, dama ledu kumuli alizoba “Ee” na “Aa.” <verse eid="2CO 1:18" /><verse number="19" style="v" sid="2CO 1:19" />Ngobe Nkololo weNdzimu, Yesu Khirisitu, iye watakasumikila kumuli, imi naSilivenasi naThimothi, waka asi “Ee” na “Aa,” koga muwunli kogala kuli “Ee.” <verse eid="2CO 1:19" /><verse number="20" style="v" sid="2CO 1:20" />Ngobe zose zwigadzabgwe zweNdzimu zowana “Ee” wazo muwunli. Ndizo tileba titi Ngekusingapele Kose Akujalo muzina lile, tikudza Ndzimu. <verse eid="2CO 1:20" /><verse number="21" style="v" sid="2CO 1:21" />Koga ndiNdzimu unotita iswi namwi kuti tibe muna Khirisitu takasima, kakale wakatihhodza; <verse eid="2CO 1:21" /><verse number="22" style="v" sid="2CO 1:22" />wakatisa lutjayo gugwe kakale wakatipa Meya iye mumimoyo yedu, setjigadzabgwe tjezwinhu zwinowhohha.<verse eid="2CO 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23" />Koga ndodana Ndzimu kuti abe nsupi wangu-sahha kwangu kuKhorinte kwaka kuli zila yemutjengeta. <verse eid="2CO 1:23" /><verse number="24" style="v" sid="2CO 1:24" />Kusi kuti tolawula galamoyo kwenyu; tohinga namwi tihingila hanha kwenyu, ngobe mumile makasima mukugalamoyo kwenyu.<verse eid="2CO 1:24" /></para>
  <chapter eid="2CO 1" />
  <chapter number="2" style="c" sid="2CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1" />Ndakapeleledza ndabona kuti ndisitjabe nekumwe mukumba kunowhomuwhisa zogwadza kakale. <verse eid="2CO 2:1" /><verse number="2" style="v" sid="2CO 2:2" />Ngobe hapa ndingamuwhisa zogwadza, ndiyani ungandiyeta ahanha kuhhe kwenyu imwi bandawhisa zogwadza? <verse eid="2CO 2:2" /><verse number="3" style="v" sid="2CO 2:3" />Ndakakwala sekwandakathama, kuyetila kuti pandinobuya ndisiwhisiwe zogwadza nayibabo baka bakafanila ndithama kuti ndihanhe, ngobe ndaka ndimugalabgwe mose, kuti hanha kwangu kowhobahanha kwenyu mose. <verse eid="2CO 2:3" /><verse number="4" style="v" sid="2CO 2:4" />Ndakamukwalila ndina kudziyidzika kakale ndiwha zogwadza mumoyo, ndilila n'hodzi, kusi kuti ndohaka muwhisa zogwadza koga kuti muzibe ludo gukulu gwandinomuda nago.<verse eid="2CO 2:4" /></para>
  <para style="s">Tila Wakugwadzisa Mazwibhatigwa</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5" />Koga hapa kuna wagwadzisa umwe, azogwadzisa imi, koga nedzimwe zila wagwadzisa imwi mose-ndisikubige kukaba tjinhu tjikulukulu kwazo. <verse eid="2CO 2:5" /><verse number="6" style="v" sid="2CO 2:6" />Langiwa kukwe nebunji gwenyu kwakalizanila; <verse eid="2CO 2:6" /><verse number="7" style="v" sid="2CO 2:7" />koga ke makafanila wuyetila mazwibhatigwa newunkuludzila, kuti ndizo asikuligwe ngebuyendasi gwakapindilila. <verse eid="2CO 2:7" /><verse number="8" style="v" sid="2CO 2:8" />Ndizo ndomukumbilisisa kuti mulayidze ludo gwenyu kuwunli. <verse eid="2CO 2:8" /><verse number="9" style="v" sid="2CO 2:9" />Ikoku ndiko kwathama kuti ndimukwalile, kuyetila kuti ndimuholesese nekuti ndizibe kuti kene mubanhu banowhilila muzwinhu zose. <verse eid="2CO 2:9" /><verse number="10" style="v" sid="2CO 2:10" />Kene yani wamunoyetila mazwibhatigwa, nami bo ndowuyetila mazwibhatigwa. Tjandayetila mazwibhatigwa, hapa kuli kuti ndina tjandayetila mazwibhatigwa, kungentha yenyu mbeli kwaKhirisitu, <verse eid="2CO 2:10" /><verse number="11" style="v" sid="2CO 2:11" />kudze tidzibilile Satane mukutikulila; ngobe akuta kuli kuti atitoziba bupitipiti gugwe.<verse eid="2CO 2:11" /></para>
  <para style="s">Sagadzikana Kwenkumbulo waPhawuli ali kuThirowasi</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12" />Pandakabuya kuThirowasi ndiwhosumikila ndebo mbuya yaKhirisitu, He bakandihhulila nkoba; <verse eid="2CO 2:12" /><verse number="13" style="v" sid="2CO 2:13" />koga nkumbulo wangu awusongogadzikana ngobe gamu langu Thayithasi andizowuwana ko. Ndizo ndakamilika ndiyenda kuMakhedoniya.<verse eid="2CO 2:13" /></para>
  <para style="s">Kukunda</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14" />Koga ke Ndzimu ngaabokewe, iye muna Khirisitu unogala etitungamila mukukunda, kakale uno andamisa nhuwilila kweluzibo gugwe pose pose ehingisa iswi. <verse eid="2CO 2:14" /><verse number="15" style="v" sid="2CO 2:15" />Ngobe kuNdzimu iswi tinhuwilila kwaKhirisitu pakati kwayibabo banotjidziwa nayibabo banopalala, <verse eid="2CO 2:15" /><verse number="16" style="v" sid="2CO 2:16" />kuwumwe tinhuwa kunohhisa lufu, kuwumwe bo tinhuwilila kunohhisa bupenyu. Ndiyani wakalizanila n'hingo wakajali? <verse eid="2CO 2:16" /><verse number="17" style="v" sid="2CO 2:17" />Ngobe iswi atitonga ibabo, bunji gwabo banoyingidza dama leNdzimu; koga sebanhu bakatambunuka, bakatumwa neNdzimu, mbeli kweNdzimu tolebeleka muna Khirisitu.<verse eid="2CO 2:17" /></para>
  <chapter eid="2CO 2" />
  <chapter number="3" style="c" sid="2CO 3" />
  <para style="s">Balanda beTjibvumilano Tjitshwa</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1" />Tetangisa zwikudza kakale? Kene kuti tohaka whalo dzinoleba kuti ndiswi boyani dzinohha kumuli kene dzinobva kumuli, sekunoyetiwa nebamwe? <verse eid="2CO 3:1" /><verse number="2" style="v" sid="2CO 3:2" />Imwi tjekwenyu mulukwalo gwedu, gwakakwagwa mumimoyo yedu<note caller="+" style="f"><char style="fr" closed="false">3.2 </char><char style="fq" closed="false">yedu </char><char style="ft" closed="false">dzimwe whalo whulukugwi dzoti mumimoyo yenyu</char></note>, gunozibgwa kakale gunobagwa nebanhu bose; <verse eid="2CO 3:2" /><verse number="3" style="v" sid="2CO 3:3" />kakale molayidza kuti mulukwalo gunobva kuna Khirisitu, guli mbhudilo yehinga kwedu, gusakakwagwa ne inki koga gwakakwagwa neMeya yeNdzimu mpenyu, gusakakwagwa pamabgwe ezwipatalala koga gwakakwagwa mumimoyo yebanhu.<verse eid="2CO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4" />Ikoku ndiko galabgwe kwedu kuNdzimu muna Khirisitu. <verse eid="2CO 3:4" /><verse number="5" style="v" sid="2CO 3:5" />Iswi tjekwedu atingati totubula thama kene ini; tubula kwedu kobva kuNdzimu, <verse eid="2CO 3:5" /><verse number="6" style="v" sid="2CO 3:6" />iye wakatita tikatubula ba bahingi betjibvumilano tjitshwa, tjisi tjenlayo wakakwagwa koga tjeMeya; ngobe nlayo wakakwagwa unobulaya, koga Meya inopa bupenyu.<verse eid="2CO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7" />Ndizo hapa n'hingo wakahhisa lufu, waka wakakwagwa pabgwe, waka unagudzo, kwakata kuti maIsirayeli akon'we linga Mozisi kubuso ngentha yepenya kwago, nekutobe kwaka kutelela, <verse eid="2CO 3:7" /><verse number="8" style="v" sid="2CO 3:8" />ngono n'hingo weMeya awutowhoba netjedza tjikulu? <verse eid="2CO 3:8" /><verse number="9" style="v" sid="2CO 3:9" />Ngobe hapa n'hingo wakahhisa tongewa waka unagudzo, gudzo len'hingo unohhisa ndulamo lakafanila bagulu kusipano! <verse eid="2CO 3:9" /><verse number="10" style="v" sid="2CO 3:10" />Lebeswa, tjaka tjina gudzo atjitjina gudzo, ngentha yegudzo linopinda latjo kwazo. <verse eid="2CO 3:10" /><verse number="11" style="v" sid="2CO 3:11" />Ngobe hapa kuli kuti tjakapinda tjaka tjina gudzo, ngono tjisingapinde tjina gudzo gulu kungapani!<verse eid="2CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12" />Saku ke tina kugalabgwe kungapa, tina tjilopa, <verse eid="2CO 3:12" /><verse number="13" style="v" sid="2CO 3:13" />atitonga Mozisi, wakafukidza buso gugwe nejila kuyetila kuti maIsirayeli basibone pela kwepenya kwakakutelela. <verse eid="2CO 3:13" /><verse number="14" style="v" sid="2CO 3:14" />Koga mikumbulo yabo yakayetiwa ikalutala; ngobe kudza kuwhoti nasi, hapa bebala tjibvumilano tjikulukugwi, jila ileliya zwalo losala lisakadusiwa, ngobe lodusiwa muna Khirisitu koga. <verse eid="2CO 3:14" /><verse number="15" style="v" sid="2CO 3:15" />Ee, kudza kuwhoti nasi hapa nlayo waMozisi ubagwa jila lokwitidza mikumbulo<note caller="+" style="f"><char style="fr" closed="false">3.15 </char><char style="fq" closed="false">mikumbulo </char><char style="ft" closed="false">tjiGiriki tjoti mimoyo</char></note> yabo; <verse eid="2CO 3:15" /><verse number="16" style="v" sid="2CO 3:16" />koga hapa nhu ehandukila kuna He jila lodusiwa. <verse eid="2CO 3:16" /><verse number="17" style="v" sid="2CO 3:17" />Ngwenu He ndibo Meya, kakale ipapo Meya yaHe payiyapo, ndipo pana lusununguko. <verse eid="2CO 3:17" /><verse number="18" style="v" sid="2CO 3:18" />Iswi toseni, buso gwedu gusakafukidziwa nejila, tolakidza<note caller="+" style="f"><char style="fr" closed="false">3.18 </char><char style="fq" closed="false">tolakidza </char><char style="ft" closed="false">Kene takalinga </char></note> gudzo laHe, tohandugwa tifananisiwa naye, tibva mulimwe gudzo tihanduligwa kulimwe; linobva kuna He banoba bali Meya.<verse eid="2CO 3:18" /></para>
  <chapter eid="2CO 3" />
  <chapter number="4" style="c" sid="2CO 4" />
  <para style="s">Fumwa yeMeya muHali dzeNtapwe</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1" />Ndizo ke, saku wali ngemawhilangoni eNdzimu tina n'hingo iwhoyu watinawo, atitonyala moyo. <verse eid="2CO 4:1" /><verse number="2" style="v" sid="2CO 4:2" />Takatjisiyana nezila dzinohemesa dzakasumbikika; tolamba tjila butjilo gwebupitipiti kene gwetjinya dama leNdzimu, koga ngeleba lebeswa patjena tozwikudza kuhana yenhu wose mbeli kweNdzimu. <verse eid="2CO 4:2" /><verse number="3" style="v" sid="2CO 4:3" />Nekutobe ndebo mbuya yedu yakakwitidziwa, yakakwitidziwa kuna ibabo banopalala. <verse eid="2CO 4:3" /><verse number="4" style="v" sid="2CO 4:4" />Kubali ndzimu wehango ino wakayeta mikumbulo yebasingagalemoyo ikasawhisisa, kudze basibone tjedza tjendebo mbuya yaKhirisitu, iye umbumbiko yeNdzimu. <verse eid="2CO 4:4" /><verse number="5" style="v" sid="2CO 4:5" />Ngobe tjatinosumikila atitosumikila nekwedu, koga tosumikila Yesu Khirisitu saHe, iswi tili sebahingi benyu ngentha yaYesu. <verse eid="2CO 4:5" /><verse number="6" style="v" sid="2CO 4:6" />Ngobe iye Ndzimu wakati, “Tjedza ngatjipenye kubva muhhalima,” ndiye zwe wakayeta tjedza tjikapenya mumimoyo yedu, tjedza tjeluzibo gwegudzo leNdzimu tjinoboneka mubuso gwaYesu Khirisitu.<verse eid="2CO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7" />Koga tina fumwa iyeyi muhali dzentapwe, kulakidza kuti masimba makulu ndeeNdzimu haata edu. <verse eid="2CO 4:7" /><verse number="8" style="v" sid="2CO 4:8" />Togwadzisiwa ngezila dzose, koga atitokundiwa; topinganyidziwa, koga atitonyala moyo; <verse eid="2CO 4:8" /><verse number="9" style="v" sid="2CO 4:9" />todziyidziwa, koga Ndzimu atotifupatila; tolobgwa tikalala pasi, koga tisingafe; <verse eid="2CO 4:9" /><verse number="10" style="v" sid="2CO 4:10" />togala takasenga lufu gwaYesu mumbili, kuyetila kuti butjilo gwaYesu guboneke bo mumibili yedu. <verse eid="2CO 4:10" /><verse number="11" style="v" sid="2CO 4:11" />Ngobe mukutjila kwedu togala takalingisana nelufu tibulayiwa ngentha yaYesu, kuyetila kuti butjilo gwaYesu guboneke mumibili yedu inofa. <verse eid="2CO 4:11" /><verse number="12" style="v" sid="2CO 4:12" />Ndizo wali lufu gohinga mutili, koga butjilo gohinga mumuli.<verse eid="2CO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13" />Saku tina iyo zwayo meya yegalamoyo yaaka enayo iye wakakwala eti, “Ndakagalamoyo, ndizo ndaka lebeleka,” naswi bo togalamoyo, ndizo tilebeleka, <verse eid="2CO 4:13" /><verse number="14" style="v" sid="2CO 4:14" />tiziba kuti iwhoyo wakamusa He Yesu unowhotimusa bo naYesu akatihhisa kan'ompela namwi mbeli kukwe. <verse eid="2CO 4:14" /><verse number="15" style="v" sid="2CO 4:15" />Ngobe kose ikoku kungentha yenyu, kuyetila kuti sengoni dziswikilila kubanhu banjinji boka kuwande, kube gudzo leNdzimu.<verse eid="2CO 4:15" /></para>
  <para style="s">Tjila Ngegalamoyo</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16" />Ndizo ke atitonyala moyo. Nekutobe mbumbiko yedu yakuhhe ihakala, mbumbiko yedu yamukati inoyetiwa ikaba ntshwa mahhuba ose. <verse eid="2CO 4:16" /><verse number="17" style="v" sid="2CO 4:17" />Ngobe dziyidzika kwedu ikoku kutukununu kwelubakanyana kotilulamisila gudzo gulu lisingapele linopinda dziyidzika kose, <verse eid="2CO 4:17" /><verse number="18" style="v" sid="2CO 4:18" />ngobe atitolinga zwinhu zwinoboneka koga tolinga zwinhu zwisingaboneke; kana zwinhu zwinoboneka zopinda, koga zwisingaboneke zobayapo tjoselele.<verse eid="2CO 4:18" /></para>
  <chapter eid="2CO 4" />
  <chapter number="5" style="c" sid="2CO 5" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1" />Ngobe toziba kuti hapa dumba lamuno muhango latinogala mulili likolomogwa, tina mbako unobva kuNdzimu, n'umba isakabakiwa ngemaboko enhu, iyapo ngekusingapele kudzimu. <verse eid="2CO 5:1" /><verse number="2" style="v" sid="2CO 5:2" />Saku wali totawumba, tiyemula kuti timbale bugalo gwedu gwekudzimu, <verse eid="2CO 5:2" /><verse number="3" style="v" sid="2CO 5:3" />kudze ngegumbala tisiwanike tili mbudlo. <verse eid="2CO 5:3" /><verse number="4" style="v" sid="2CO 5:4" />Hapa titji mudumba ileli, tolemegwa nehungu; ngobe atitohaka sambala, koga tohaka kuti timbale bugalo gwedu gwekudzimu kudze mbili unofa umidziwe nebutjilo. <verse eid="2CO 5:4" /><verse number="5" style="v" sid="2CO 5:5" />Iye watibaakanya etilulamisila ikoku ndiNdzimu, ndiyezwe watipa Meya setjigadzabgwe.<verse eid="2CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6" />Ndizo wali tina tjilopa gose lubaka; toziba kuti hapa titjikanyi mumbili tikulekule naHe, <verse eid="2CO 5:6" /><verse number="7" style="v" sid="2CO 5:7" />ngobe totjila ngegalamoyo, kusi ngebona. <verse eid="2CO 5:7" /><verse number="8" style="v" sid="2CO 5:8" />Tina tjilopa tjibuya, kakale tokumbula kuti kuhine ba kulekule nembili, tili kanyi naHe. <verse eid="2CO 5:8" /><verse number="9" style="v" sid="2CO 5:9" />Ndizo ke kuti tikanyi kene tikulekule, tozwipila wun'hanhisa. <verse eid="2CO 5:9" /><verse number="10" style="v" sid="2CO 5:10" />Ngobe toseni takafanila ma mbeli kwetjigalo tjetonga tjaKhirisitu, kudze umwe newumwe awamutjile tjakawumfanila, kuyendidzana nethama kukwe etjatjila mumbili, kubuya kene kubi.<verse eid="2CO 5:10" /></para>
  <para style="s">Whanana neNdzimu muna Khirisitu</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11" />Ndizo ke, saku tiziba kuti ini hla He, totetedza banhu; koga tjatili itjo tjozibgwa neNdzimu, kakale ndogalabgwe kuti namwi bo tjatili itjo motjiziba muhana dzenyu. <verse eid="2CO 5:11" /><verse number="12" style="v" sid="2CO 5:12" />Atitozwikudza kumuli kakale, koga tomuzibisa tjinothama mukazwida nekwedu, kuyetila kuti mutubule handula ibabo banozwiloba fuba nekwemamo enhu kusi nekwemoyo uwe. <verse eid="2CO 5:12" /><verse number="13" style="v" sid="2CO 5:13" />Hapa tilahikigwa nenkumbulo, ndekweNdzimu; hapa mikumbulo yedu yakatambunuka, kobhatsha imwi. <verse eid="2CO 5:13" /><verse number="14" style="v" sid="2CO 5:14" />Kana ludo gwaKhirisitu gotilawula, ngobe tokubvuma kuti un'ompela wakafila bose; ndizo kobva kuti bose bakafa. <verse eid="2CO 5:14" /><verse number="15" style="v" sid="2CO 5:15" />Kakale wakafila banhu bose, kudze ibabo banotjila basitjazwitjilile koga batjilile iye wakabafila akamusiwa kakale.<verse eid="2CO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16" />Kubvisila ngwenuwali, ndizo ke, akuna watitjaziba ngehhiho lenyama; nekene takatongoziba Khirisitu ngehhiho lenyama, akuzotjajalo. <verse eid="2CO 5:16" /><verse number="17" style="v" sid="2CO 5:17" />Ndizo ke, hapa umwe eli muna Khirisitu, watjibe mbumbiko ndzwa; whulukugwi yatjipinda, lingani, ndzwa yatjihha. <verse eid="2CO 5:17" /><verse number="18" style="v" sid="2CO 5:18" />Kose ikoku kobva kuNdzimu, iye wakati bgwililulanya naye ehingisa Khirisitu kakale akatipa n'hingo webgwililulanya; <verse eid="2CO 5:18" /><verse number="19" style="v" sid="2CO 5:19" />kubva kuti, muna Khirisitu Ndzimu waka ebgwililulanya hango kuwunli, asingababalile matjinyo abo, kakale wakatipa ngekutigalabgwe ndebo webgwililulanya.<verse eid="2CO 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 5:20" />Ndizo tibamilili baKhirisitu, Ndzimu eta tjikumbilo tjitje ehingisa iswi. Tomukumbilisisa muzina laKhirisitu, bgwililulanyiwani kuNdzimu. <verse eid="2CO 5:20" /><verse number="21" style="v" sid="2CO 5:21" />Ngentha yedu wakawunthama akaba jinyo iye waka asingazibe jinyo, kuyetila kuti muwunli tingaba bakalulama beNdzimu.<verse eid="2CO 5:21" /></para>
  <chapter eid="2CO 5" />
  <chapter number="6" style="c" sid="2CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1" />Sebahingi kan'ompela neNdzimu, tomukumbilisisa kuti musiwamutjilile ngoni dzeNdzimu suli. <verse eid="2CO 6:1" /><verse number="2" style="v" sid="2CO 6:2" />Ngobe iye unoti,</para>
  <para style="q1" vid="2CO 6:2">“Mulubaka gwakafanila,</para>
  <para style="q2" vid="2CO 6:2">ndakamuwhilila,</para>
  <para style="q1" vid="2CO 6:2">ndikamutjidza,</para>
  <para style="q2" vid="2CO 6:2">muhhuba letjidziwa.”</para>
  <para style="m" vid="2CO 6:2">Lingani, ngwenuwali gwatjiba lubaka gunowamutjilika; lingani, kwatjiba hhuba letjidziwa.<verse eid="2CO 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3" />Atitodzibila nhu kene nayipi zila, kuyetila kuti kusibe netjakayipa tjinowanika nekwen'hingo wedu, <verse eid="2CO 6:3" /><verse number="4" style="v" sid="2CO 6:4" />koga tolayidza ba bahingi beNdzimu nezila dzose. Ngekusimidzila kukulu, mukudziyidzika, mubulemo, mumamanikano, <verse eid="2CO 6:4" /><verse number="5" style="v" sid="2CO 6:5" />mukulobgwa, hhaliligwa mujele, maponyongo, hinga zwakalema, sayizela, yila zodliwa; <verse eid="2CO 6:5" /><verse number="6" style="v" sid="2CO 6:6" />ngebubuya, luzibo, moyolenfu, bunhu, Meya Yakayengemala, ludo gwelebeswa, <verse eid="2CO 6:6" /><verse number="7" style="v" sid="2CO 6:7" />ndebo yemalebeswa, nemasimba eNdzimu; nezwigo zwendulamo zweluboko gweludli negwelumehwe; <verse eid="2CO 6:7" /><verse number="8" style="v" sid="2CO 6:8" />mukulemekedzewa nesalemekedzewa, mukulebgwa zwakayipa nelebgwa zwakanaka. Tobhakhwa sebanyepi, koga iswi timulebeswa; <verse eid="2CO 6:8" /><verse number="9" style="v" sid="2CO 6:9" />sebasingazibgwe, koga tizibgwa kwazo; sebanofa, koga lingani tibapenyu; sebalangiwa, koga tikasibulawe; <verse eid="2CO 6:9" /><verse number="10" style="v" sid="2CO 6:10" />sebamubuyendasi, koga tihanha; sebahayi, koga tiyeta banji bakafuma; sebasina tjabo, koga tinako kose.<verse eid="2CO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11" />Talebeleka takahalabvuka kumuli, baKhorinte; mimoyo yedu yakahhulika. <verse eid="2CO 6:11" /><verse number="12" style="v" sid="2CO 6:12" />Amutokwebegwa hule naswi, koga mokwebegwa hule nemimoyo yenyu. <verse eid="2CO 6:12" /><verse number="13" style="v" sid="2CO 6:13" />Ndeelebeleka sekunoyi ndolebeleka nebana. Hhulani mimoyo yenyu bo.<verse eid="2CO 6:13" /></para>
  <para style="s">Tjenjelelani basi bagalimoyo</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14" />Musibe netjinomuhanganya nebanhu basingagalemoyo. Ngobe ndulamo nebubi kungahingidzana tjini? Kene kuti tjedza tjingawililana nehhalima? <verse eid="2CO 6:14" /><verse number="15" style="v" sid="2CO 6:15" />Ini Khirisitu tjaangabvumilana naBheliyali? Kene ini nghalimoyo tjaanatjo tjinofanana netje usingagalemoyo? <verse eid="2CO 6:15" /><verse number="16" style="v" sid="2CO 6:16" />Nditjipi tjibvumilano tjingabapo pakati kwethempeli leNdzimu nemidzimwana yakabehhewa? Ngobe tithempeli leNdzimu mpenyu; seNdzimu kwaakati,</para>
  <para style="q1" vid="2CO 6:16">“Ndowhogala mubali</para>
  <para style="q2" vid="2CO 6:16">kakale ayenda pakati kwabo,</para>
  <para style="q1" vid="2CO 6:16">ndowhoba Ndzimu wabo,</para>
  <para style="q2" vid="2CO 6:16">ibo banowhoba banhu bangu.”<verse eid="2CO 6:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="2CO 6:17" />Ndizo ke He banoti,</para>
  <para style="q1" vid="2CO 6:17">“Ibvani pabali,</para>
  <para style="q2" vid="2CO 6:17">mupalalane nabo,</para>
  <para style="q1" vid="2CO 6:17">musikunhe tjinhu tjina hambgwa;</para>
  <para style="q2" vid="2CO 6:17">ndiko kwandinowhomuwamutjila,<verse eid="2CO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2CO 6:18" />ndowhoba tate kumuli,</para>
  <para style="q2" vid="2CO 6:18">imwi mukaba bakololo nebakololokadzi bangu,</para>
  <para style="q2" vid="2CO 6:18">kujalo He Masimba ose.”<verse eid="2CO 6:18" /></para>
  <chapter eid="2CO 6" />
  <chapter number="7" style="c" sid="2CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1" />Saku wali tina zwigadzabgwe izwezwi, badikani, atizwitjenapadzeni muna kose kunosa mbili nemeya hambgwa, tizwiyengemadze mukuhla Ndzimu.<verse eid="2CO 7:1" /></para>
  <para style="s">Hanha kwaPhawuli</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2" />Mutihhulile mimoyo yenyu; akuna watatjinyila, akuna watatjinya nkumbulo, akuna watatjebela. <verse eid="2CO 7:2" /><verse number="3" style="v" sid="2CO 7:3" />Anditoleba ikoku kuyetila muwana nlandu, ngobe ndakatongokuleba kuti mumumimoyo yedu, tofa toseni kakale totjila toseni. <verse eid="2CO 7:3" /><verse number="4" style="v" sid="2CO 7:4" />Ndomugalabgwe kwazo; ndozwida kwazo nekwenyu; ndihhele nyaladzika. Mukudziyidzika kwedu kose, ndihhele hanha.<verse eid="2CO 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5" />Kene patakaswika kuMakhedoniya, mibili yedu ayizotongowana kunyaluluka koga takadziyidzika nezila dzose-kuhhe kwedu tigwa mukati kwedu tihla. <verse eid="2CO 7:5" /><verse number="6" style="v" sid="2CO 7:6" />Koga Ndzimu, iye unonyaladza bakapaluka moyo, wakatinyaladza ngebuya kwaThayithasi, <verse eid="2CO 7:6" /><verse number="7" style="v" sid="2CO 7:7" />kusi ngebuya kukwe koga, koga kose ngenyaladzika kwaakawamutjila kubva kumuli, sekwaakatibudza ndihuba kwenyu, ndilila kwenyu, neda ndibona kwenyu, kwakata ahanha kwazo.<verse eid="2CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8" />Nekutobe ndakamuta mukaba nebuyendasi nelukwalo gwangu, anditozwisola, nenguba ndakazwisola, ngobe ndobona kuti lukwalo igoguya gwakamuwhisa zogwadza, koga kwakaba kwelubaka nyana. <verse eid="2CO 7:8" /><verse number="9" style="v" sid="2CO 7:9" />Sangwenu, ndohanha, kusi ngentha yekuti makawha zogwadza, koga ngobe wha zogwadza kwakamuta mukahanduka; makawha zogwadza kunobva kuNdzimu, kudze musilahikigwe netjimwe ngentha yedu. <verse eid="2CO 7:9" /><verse number="10" style="v" sid="2CO 7:10" />Ngobe wha zogwadza kunobva kuNdzimu kota nhu akahanduka, handuka kota nhu akatjidziwa, iko kunohhisa sazwisola, koga wha zogwadza kwemuhango kohhisa lufu. <verse eid="2CO 7:10" /><verse number="11" style="v" sid="2CO 7:11" />Lingani kuti ikoku wha zogwadza kunobva kuNdzimu kwathama mukazwipila kungapani. Zwipila layidza kuti amuna nlandu, gwadziwa moyo kungapa, musa zebe kungapa, huba kungapa, zwipila kungapa, bgwilizila kungapa! Mutjimwe netjimwe tjayeyi ndebo mazwilayidza kuti amuna nlandu.<verse eid="2CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 7:12" />Nekutobe ndakamukwalila, kwakaba kusi kuti kungentha yewatjinya, kene watjinyigwa, koga kudze zwipila kwenyu kutili kuzumbunugwe kumuli mbeli kweNdzimu. <verse eid="2CO 7:12" /><verse number="13" style="v" sid="2CO 7:13" />Ndizo ke takanyaladzika.</para>
  <para style="p" vid="2CO 7:13">Kakale pehhugwi kwenyaladzika kwedu takahanha kwazo ngentha yehanha kwaThayithasi, ngobe moseni makata nkumbulo uwe ukanyaluluka. <verse eid="2CO 7:13" /><verse number="14" style="v" sid="2CO 7:14" />Ngobe hapa ndakalayidza zwida kwangu nekwenyu kuwunli, andizotongobhakhwa nehoni; koga ngobe kose kwatakaleba nekwenyu kwaka kuli lebeswa, ndizo zwiloba fuba kwedu mbeli kwaThayithasi nekwenyu kwalayidza kuti kumalebeswa. <verse eid="2CO 7:14" /><verse number="15" style="v" sid="2CO 7:15" />Neludo gugwe kumuli gokula, hapa ekumbula mazwibhato enyu mose, nezila yamakawuwamutjila nayo muhla, mutetema. <verse eid="2CO 7:15" /><verse number="16" style="v" sid="2CO 7:16" />Ndohanha, ngobe ndina kugalabgwe kwakapelela mumuli.<verse eid="2CO 7:16" /></para>
  <chapter eid="2CO 7" />
  <chapter number="8" style="c" sid="2CO 8" />
  <para style="s">Pa kweNkhirisitu</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1" />Makamu, tohaka kuti muzibe nekwengoni dzeNdzimu dzakalakidziwa mumakubungano ekuMakhedoniya, <verse eid="2CO 8:1" /><verse number="2" style="v" sid="2CO 8:2" />ngobe mukulikwa kwedziyidzika kukulu, hanha kwabo kunjinji kwakata kuti bakobane bakasununguka nenguba bakabe bali bahayi basina tjabo. <verse eid="2CO 8:2" /><verse number="3" style="v" sid="2CO 8:3" />Ndopa busupi kuti bakapa kunoyendidzana newana kwabo, nekupehhugwi kwewana kwabo, sekuda kwabo, <verse eid="2CO 8:3" /><verse number="4" style="v" sid="2CO 8:4" />beti kumbilisisa nemoyo wabo wose kuti babe neluboko bo mukubhatsha bayengemali. <verse eid="2CO 8:4" /><verse number="5" style="v" sid="2CO 8:5" />Ikoku taka tisakakulingilila kubva kubali, koga kutanga bakazwipila kuna He kose nekutili ngekuda kweNdzimu. <verse eid="2CO 8:5" /><verse number="6" style="v" sid="2CO 8:6" />Ndizo ke tatjikumbila Thayithasi kuti saku agala atjitangisa, wakafanila pedzisa n'hingo mbuya iwhoyu, wengoni, pakati kwenyu. <verse eid="2CO 8:6" /><verse number="7" style="v" sid="2CO 8:7" />Sangwenu muthama zwakanaka kwazo muzwinhu zose-mubugalimoyo, mukulebeleka, muluzibo, mukuzwipila kwakapelela, nemuludo gwamakadiyika kubva kutili-bonani kuti mothama zwakanaka bo mun'hingo mbuya iwhoyu.<verse eid="2CO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8" />Anditoleba ikoku senlayo, koga ndohaka bona kuti kene ludo gwenyu bo ndegwelebeswa negufananidza nezwipila kwebamwe. <verse eid="2CO 8:8" /><verse number="9" style="v" sid="2CO 8:9" />Ngobe moziba ngoni dzaHe wedu Yesu Khirisitu, kuti nekutobe waka akafuma, koga nentha yenyu wakaba n'hayi, kuyetila kuti ngebuhayi gugwe mungafuma.<verse eid="2CO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10" />Mundebo iyeyi ndomupa mano. Kuhine kuti ngwenuwali mufidze tjamakatangisa thama makenyi. Ndimwi makaba bekutanga kuthama, kusi thama koga, koga kose neyemula kuthama, <verse eid="2CO 8:10" /><verse number="11" style="v" sid="2CO 8:11" />kuyetila kuti yemula kwenyu kungalizanyisiwa nepedza n'hingo, kuyendidzana newana kwenyu. <verse eid="2CO 8:11" /><verse number="12" style="v" sid="2CO 8:12" />Ngobe hapa zwipila kuliyapo, kowamutjilika kuyendidzana nenhu tjaanatjo, kusingayendidzane netjaasina.<verse eid="2CO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 8:13" />Anditobva kuti bamwe balelusegwe imwi mulemesegwe, koga kuti kube nelizana. <verse eid="2CO 8:13" /><verse number="14" style="v" sid="2CO 8:14" />Imwi kwamunako ngwenuwali kunjinji kubawahhe muna zwabanohaya, kudze kwabanako kunjinji limwe hhuba kumuwahhe bo muna zwamunohaya, kuyetila kuti kube nekulizana. <verse eid="2CO 8:14" /><verse number="15" style="v" sid="2CO 8:15" />Sekwakwaka kwagwa, “Iwhoyo wakakubunganya kunjinji haana kunjisa, newakakubunganya kuhomanana haatotayila.”<verse eid="2CO 8:15" /></para>
  <para style="s">Thayithasi Nebakhwinya Babe</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16" />Koga Ndzimu ngaabokewe, iye unolonga ludo igo zwago gumundili gwemubhatsha, mumoyo waThayithasi. <verse eid="2CO 8:16" /><verse number="17" style="v" sid="2CO 8:17" />Ngobe haazongowamutjila wunkulumbidza kwedu koga, koga nekuzwipila kukwe unobuya kumuli tjekukwe. <verse eid="2CO 8:17" /><verse number="18" style="v" sid="2CO 8:18" />Totuma kan'ompela naye limwe gamu ledu linozibgwa kwazo mumakubungano ose ngesumikila ndebo mbuya kwalo; <verse eid="2CO 8:18" /><verse number="19" style="v" sid="2CO 8:19" />kusi ikokuya koga, koga wahagwa ngemakubungano kuti ayende naswi mun'hingo wengoni iwhoyu watinoyendilambeli nawo, kudze tilayidze gudzo laHe nelayidza zwipila kwedu bhatsha.<verse eid="2CO 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 8:20" />Tohaka kuti kusibe nenhu unotibona nlandu nekwezila yatinobhata nayo itjetji tjipo tjikulu, <verse eid="2CO 8:20" /><verse number="21" style="v" sid="2CO 8:21" />ngobe tozwipila thama tjinhu tjinolumbidzika kusi mbeli kwaHe koga, koga nambeli kwebanhu.<verse eid="2CO 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22" />Kan'ompela nabo totuma umwe nghalimoyo watakalika kanjinji tikawana akazwipila mumihingo minjinji, koga ke ngwenu watjizwipila kupinda kutanga ngentha yemugalabgwe kukwe kukulu. <verse eid="2CO 8:22" /><verse number="23" style="v" sid="2CO 8:23" />Thayithasi unkwinya wangu wandinohanganyila naye kakale tohinga tose mun'hingo wenyu; hawa makamu edu batumwa bemakubungano ebagalimoyo, banoyeta Khirisitu akakudziwa. <verse eid="2CO 8:23" /><verse number="24" style="v" sid="2CO 8:24" />Ndizo ke ipani busupi, kumakubungano, gweludo gwenyu nezwida kwedu namwi kubalume ibaba.<verse eid="2CO 8:24" /></para>
  <chapter eid="2CO 8" />
  <chapter number="9" style="c" sid="2CO 9" />
  <para style="s">Wahha Bagalimoyo Banohaya</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1" />Akutohaka kuti imi ndimukwalile nekwewahha bayengemali nezwipo, <verse eid="2CO 9:1" /><verse number="2" style="v" sid="2CO 9:2" />ngobe ndoziba zwipila bhatsha kwenyu, ndizo ndizwida nekwenyu kubanhu bekuMakhedoniya, nditi imwi beku Akhayiya makatjilulamila pa kubvisila makenyi; zwipila kwenyu kungapa kwatjithama bunji gwabo bakazwipila bo. <verse eid="2CO 9:2" /><verse number="3" style="v" sid="2CO 9:3" />Koga ndotuma bagalimoyo kuyetila kuti zwida nekwenyu kwedu kusibe suli mun'hingo iwhoyu, kuyetila kuti muzwibaakanye, sekwandakati mowhobe matjikululamila; <verse eid="2CO 9:3" /><verse number="4" style="v" sid="2CO 9:4" />ngobe hapa banhu bekuMakhedoniya bengabuya nami bekowana kuti amuzozwibaakanya, towhobhakhwa nehoni ngobe timugalabgwe, ndisilebe ke imwi tjekwenyu, dzenyu honi dzowhobanjinji. <verse eid="2CO 9:4" /><verse number="5" style="v" sid="2CO 9:5" />Ndizo ndakumbula kuti kwakafanila tetedzewa bagalimoyo kuti banditangele buya kumuli, babaakanyile tjipo itjetji tjamakagadzabgwe nekwatjo, lubaka gusanhu gwaswika. Kuyetila kuti tjibe tjalulama, kuli tjipo tjeludo kusi kuti ifanilo.<verse eid="2CO 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6" />Kumbulani whoku. Iwhoyo unodzwala kuhomanana unowhokowha kuhomanana, unodzwala kunjinji unowhokowha kunjinji. <verse eid="2CO 9:6" /><verse number="7" style="v" sid="2CO 9:7" />Umwe newumwe wakafanila yeta seda kwemoyo uwe, esingan'un'une kene bhakhwa nemasimba, ngobe Ndzimu unoda nhu unopa akahalabvuka. <verse eid="2CO 9:7" /><verse number="8" style="v" sid="2CO 9:8" />Ndzimu unotubula mukombolela kupindisisa, kuyetila kuti mugale munako kose kwakamulizana, nekuti muwahhe wose n'hingo mbuya. <verse eid="2CO 9:8" /><verse number="9" style="v" sid="2CO 9:9" />Sekwakwaka kwagwa kuti,</para>
  <para style="q1" vid="2CO 9:9">“Uno andamisa, unopa bahayi;</para>
  <para style="q2" vid="2CO 9:9">lulama kukwe kuyapo ngekusingapele.”<verse eid="2CO 9:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="2CO 9:10" />Iye unopa ndzwali mbewu netjinkwa kuti adle unowhomupa kakale akayiwandisa mbewu yenyu, akawandisa gowho lelulama kwenyu. <verse eid="2CO 9:10" /><verse number="11" style="v" sid="2CO 9:11" />Mowhofumisiwa kene nayipi zila kudze mutubule pa makahalabvuka, iko kunowhothama Ndzimu akabokewa, kuhingisiwa iswi; <verse eid="2CO 9:11" /><verse number="12" style="v" sid="2CO 9:12" />ngobe thama n'hingo iwhoyu akutohhisa zwinohakiwa ngebayengemali koga, koga kothama neNdzimu bo akabokewa nezila njinji. <verse eid="2CO 9:12" /><verse number="13" style="v" sid="2CO 9:13" />Ngentha yen'hingo iwhoyu wamakahinga malakidza tubula kwenyu, bamwe banowholumbidza Ndzimu ngentha yelemekedza kwenyu ndebo mbuya yaKhirisitu yamunosumikila, nangekobelana nabo nebamwe bose makahalabvuka; <verse eid="2CO 9:13" /><verse number="14" style="v" sid="2CO 9:14" />ibo bemuhuba bemutembezelela, ngentha yengoni njinji dzeNdzimu dzimumuli. <verse eid="2CO 9:14" /><verse number="15" style="v" sid="2CO 9:15" />Ngaabokewe Ndzimu ngentha yetjipo tjitje tjinotjenamisa!<verse eid="2CO 9:15" /></para>
  <chapter eid="2CO 9" />
  <chapter number="10" style="c" sid="2CO 10" />
  <para style="s">Phawuli Unodzibilila N'hingo Uwe</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1" />Imi, Phawuli, ndomukumbila tjekwangu, ngekuzwitebamisa nemazwibhato aKhirisitu, imi wakatebama hapa ndakalingana namwi, koga ndili nkukutu hapa ndili kule namwi! <verse eid="2CO 10:1" /><verse number="2" style="v" sid="2CO 10:2" />Ndomukumbilisisa kuti hapa ndili pakati kwenyu kusihakike kuti ndilayidze bukukutu nekuzwigalabgwe sekwandakalingilila lakidza bamwe banhu banokumbulila kuti totjila butjilo gwehango ino. <verse eid="2CO 10:2" /><verse number="3" style="v" sid="2CO 10:3" />Ngobe nekutoba titjila muhango, koga atitogwa ngwa sekunoyetiwa nebanhu benyama, <verse eid="2CO 10:3" /><verse number="4" style="v" sid="2CO 10:4" />ngobe zwigo zwengwa yedu ate zwemuhango koga ndezweNdzimu zwina masimba ekolomola pakasima. <verse eid="2CO 10:4" /><verse number="5" style="v" sid="2CO 10:5" />Tokolomola kakabadzana nemikumbulo yezwikudza yose inogwisana nezibgwa kweNdzimu, wose nkumbulo towunta ntapwa kuti ube nemazwibhato kuna Khirisitu, <verse eid="2CO 10:5" /><verse number="6" style="v" sid="2CO 10:6" />hapa mazwibhato enyu apelela, towhoba takalulamila langa kose saba nemazwibhato.<verse eid="2CO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7" />Lingani tjimbeli kwemeho enyu. Hapa kuna unozwigalabgwe kuti ndewaKhirisitu, ngaazwikumbudze kuti saku iye eli waKhirisitu, naswibo tibaKhirisitu. <verse eid="2CO 10:7" /><verse number="8" style="v" sid="2CO 10:8" />Andina honi, nenguba ndizwiloba fuba kwazo nyana nekwemasimba edu, atakapiwa naHe kuti timubake asi ekuti timupaladze. <verse eid="2CO 10:8" /><verse number="9" style="v" sid="2CO 10:9" />Anditohaka kuti ndinge ndinomuhlisidzila newhalo. <verse eid="2CO 10:9" /><verse number="10" style="v" sid="2CO 10:10" />Ngobe banoti, “Whalo dzidze dzolema kakale dzakasima, koga iye tjekukwe hapa alipano unlelulelu, netjaanoleba atjitogala tjawhakala.” <verse eid="2CO 10:10" /><verse number="11" style="v" sid="2CO 10:11" />Ibabo banhu bakajalo ngabazibe kuti tjatinoleba ngelukwalo tisipo, nditjo tjatinothama hapa tilipo.<verse eid="2CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12" />Atitoyedza zwilizanyisa kene zwifananisa nebamwe bayibabo banozwikudza. Koga hapa bezwilizanyisa nebamwe babo, kakale bezwifananisa nebamwe babo, kobva kuti abatowhisisa. <verse eid="2CO 10:12" /><verse number="13" style="v" sid="2CO 10:13" />Koga atitowhozwikudza kupinda tjilizanyo, koga towhozwikudza kunoyendidzana netjilizanyo tjatakapiwa neNdzimu, kudze tiswikilile nekumuli. <verse eid="2CO 10:13" /><verse number="14" style="v" sid="2CO 10:14" />Ngobe atitopindilila, sekunoyi atizoswika kumuli; takaba bekutanga buya kumuli nendebo mbuya dzaKhirisitu. <verse eid="2CO 10:14" /><verse number="15" style="v" sid="2CO 10:15" />Atitozwikudza kunopinda tjiyelo tjedu, tizwikudza nemihingo yebamwe balume; koga togalabgwe kuti hapa galamoyo kwenyu kukula, n'hingo wedu pakati kwenyu unowhokula kwazo, kuyendidzana neyelegwa kwedu neNdzimu <verse eid="2CO 10:15" /><verse number="16" style="v" sid="2CO 10:16" />kudze tisumikile ndebo mbuya kuhango dzikule, mbeli kweyenyu, tisingazwilobe fuba ngemihingo yatjiyetiwa muminda yewumwe nhu.<verse eid="2CO 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 10:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10.17. </char>
      <char style="xt" closed="false">
        <ref loc="JER 9:24">Jer 9.24</ref>.</char>
    </note> “Unozwikudza, ngaazwikudze ali muna He.” <verse eid="2CO 10:17" /><verse number="18" style="v" sid="2CO 10:18" />Ngobe nhu unowamutjigwa ata unozwimilidza, koga nhu unowamutjigwa ndewamilidziwa naHe.<verse eid="2CO 10:18" /></para>
  <chapter eid="2CO 10" />
  <chapter number="11" style="c" sid="2CO 11" />
  <para style="s">Phawuli neBapositoli Bemanyepwa</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1" />Ndoyemula kuti mundiyetile moyonlefu mubulengwe gwangu gutikinini. Mundiyetile moyonlefu! <verse eid="2CO 11:1" /><verse number="2" style="v" sid="2CO 11:2" />Ndowha ndimubinda kwazo, binda kweNdzimu, ngobe ndakamupa kuna Khirisitu ndimuyendisa senlongo wakapelela kunlume uwe un'ompela. <verse eid="2CO 11:2" /><verse number="3" style="v" sid="2CO 11:3" />Koga ndohlila kuti saku nyoka yakatjengela Eva ngebupitipiti gwayo, mikumbulo yenyu inowhopambuka kubva mukuzwipila kuna Khirisitu kwakatjena. <verse eid="2CO 11:3" /><verse number="4" style="v" sid="2CO 11:4" />Ngobe hapa umwe nhu ebuya esumikila nekwewumwe Yesu usi watakasumikila nekukwe, kene hapa muwamutjila meya yakasiyana neyamakawamutjila, kene hapa mubvuma imwe ndebo mbuya yakasiyana neyamakabvuma, mobva mazwipila kuyili.<verse eid="2CO 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 11:5" />Ndokumbula kuti andita ndili ntukunu kene nayipi zila kubapositoli ibabo banoyi bakulukulu. <verse eid="2CO 11:5" /><verse number="6" style="v" sid="2CO 11:6" />Nekutobe ndisinyambi mukulebeleka, koga ndinaluzibo; ikoku takuthama kukaba patjena kumuli, nezila dzose, muzwinhu zose.<verse eid="2CO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7" />Ndingaba ndakatjinya kuti ndizwise pasi kuyetila kuti imwi mukudziwe, ngobe ndakasumikila ndebo mbuya yeNdzimu mpho kumuli? <verse eid="2CO 11:7" /><verse number="8" style="v" sid="2CO 11:8" />Ndakatjebela amwe makubungano ngewamutjila wahha kwabo kuti nditubule hingila imwi. <verse eid="2CO 11:8" /><verse number="9" style="v" sid="2CO 11:9" />Kakale patakatilitoseni ndina tjandinohaka, akuna wandakatilika bulemo, ngobe zwandakandihaka ndakazwipiwa nebagalimoyo bakabva kuMakhedoniya. Ndizo andizobantolo kumuli kene nayipi zila, nemulubaka gunohha anditowhoba ntolo kumuli. <verse eid="2CO 11:9" /><verse number="10" style="v" sid="2CO 11:10" />Selebeswa laKhirisitu lili mundili wali, ikoku zwiloba fuba kwangu akuna angakumisa mumitunhu ye Akhayiya. <verse eid="2CO 11:10" /><verse number="11" style="v" sid="2CO 11:11" />Ngentha yeni? Kungentha yekuti anditomuda? Ndzimu unoziba kuti ndomuda!<verse eid="2CO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12" />Tjandinothama ndowhoyendilambeli nditjithama, kuyetila lengudza ibabo banoti, mun'hingo wabo wezwikudza, banohinga nezila yatinohinga nayo. <verse eid="2CO 11:12" /><verse number="13" style="v" sid="2CO 11:13" />Ngobe ibabo balume ba bapositoli bemanyepwa, bahingi banotjebela, banozwithama bapositoli baKhirisitu. <verse eid="2CO 11:13" /><verse number="14" style="v" sid="2CO 11:14" />Akutotjenamisa, ngobe nayiye Satane unozwisumbika akazwithama ntumwa weNdzimu wetjedza. <verse eid="2CO 11:14" /><verse number="15" style="v" sid="2CO 11:15" />Ndizo akutokaabadza hapa balanda babe bezwisumbika bo bezwithama balanda bendulamo. Bhelelo labo lowhoba tjakalizanila zwiyeto zwabo.<verse eid="2CO 11:15" /></para>
  <para style="s">Dziyidzika kwaPhawuli ali Mpositoli</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16" />Ndopamha, kusibe ne unondibona bulengwe; koga hapa mundibona sayikoku, mundiwamutjile setjilengwe, kuyetila kuti nami bo ndizwikudze nyana bo. <verse eid="2CO 11:16" /><verse number="17" style="v" sid="2CO 11:17" />Tjandinoleba anditotjileba nesimba laHe, koga ndotjileba setjilengwe, mukuzwikudza ikoku; <verse eid="2CO 11:17" /><verse number="18" style="v" sid="2CO 11:18" />saku banhu banjinji bezwiloba fuba nekwezwinhu zwehango, nami bo ndowhozwiloba fuba. <verse eid="2CO 11:18" /><verse number="19" style="v" sid="2CO 11:19" />Ngobe moyetila zwilengwe moyonlefu makahanha, nekutobe imwi tjekwenyu makatjenjela! <verse eid="2CO 11:19" /><verse number="20" style="v" sid="2CO 11:20" />Mosimidzila hapa nhu emuthama balanda, kene emugwisa, kene emutshambidzila, kene emulingila pasi, kene emupwawhula. <verse eid="2CO 11:20" /><verse number="21" style="v" sid="2CO 11:21" />Ndina honi leba kuti takatisina masimba, takakon'wa thama zwinhu izwezo!</para>
  <para style="p" vid="2CO 11:21">Koga kene ini umwe nhu tjaanozwikudza nditjo, ndolebeleka setjilengwe, nami bo ndingazwikudza nditjo. <verse eid="2CO 11:21" /><verse number="22" style="v" sid="2CO 11:22" />Ibo BaHhebheru? Nami bo ndiNhhebheru. Ibo maIsirayeli? Nami bo ndi Isirayeli. Batjizekugwana tja Abhurahhamu? Namibo ndi itjo. <verse eid="2CO 11:22" /><verse number="23" style="v" sid="2CO 11:23" />Babahingi baKhirisitu? Ndolebeleka sempengo-koga ndin'hingi uhine-ndakahinga mihingo minjinji kwazo, ndakaba nsungwa kanjinji kwazo, ndikalobgwa kunjisasa, agwisa fa kanjisa. <verse eid="2CO 11:23" /><verse number="24" style="v" sid="2CO 11:24" />Kwatjibe kahanu ndisukutigwa nemaJuta hamu dzili makumi matatu anahhanalume. <verse eid="2CO 11:24" /><verse number="25" style="v" sid="2CO 11:25" />Ndakabumbugwa nemakombo kwatjiba katatu; ndakakhikitidziwa nemabgwe kan'ompela. Ndakapalaligwa nekepe katatu; ndaka angama mugungwa siku nesikati kan'ompela. <verse eid="2CO 11:25" /><verse number="26" style="v" sid="2CO 11:26" />Ndandigala ndinanjendo, ndiba mumboli yenjizi, mboli yegwisiwa nembobola, mboli yegwisiwa nebanhu bakanyi kwangu, mboli yegwisiwa neBataya, mboli munzi-nkulu, mboli mutjilambanyika, mboli mugungwa, mboli yegwisiwa nebagalimoyo bemanyepwa; <verse eid="2CO 11:26" /><verse number="27" style="v" sid="2CO 11:27" />ndahinga zwinolema, kanjinji ndisingayizele busiku ndakayila zodliwa kakale ndina nyota, mulubaka gunjinji ndisina zodliwa, ndipota ndakati piti. <verse eid="2CO 11:27" /><verse number="28" style="v" sid="2CO 11:28" />Kakale, ndisingabale zwimwe zwinhu, kuna ntolo wemahhuba ose upehhugwi kwangu, wedziyidzika kwangu nekwemakubungano ose. <verse eid="2CO 11:28" /><verse number="29" style="v" sid="2CO 11:29" />Ndiyani usakasima, nami bo andita ndisakasima? Ndiyani wayetiwa kuti awile mujinyo, imi andina buyendasi?<verse eid="2CO 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30" />Hapa ndingazwiloba fuba, ndowhozwiloba fuba nekwezwinhu zwinolayidza sasima kwangu. <verse eid="2CO 11:30" /><verse number="31" style="v" sid="2CO 11:31" />Ndzimu Tate baHe Yesu, ibo bakakombolegwa nekusingapele, banoziba kuti anditonyepa. <verse eid="2CO 11:31" /><verse number="32" style="v" sid="2CO 11:32" />KuDamasikasi, mbhati wentunhu upasi kwaMambo Aretasi wakabiga balindi munzi-nkulu weDamasikasi kuyetila kuti andisunge, <verse eid="2CO 11:32" /><verse number="33" style="v" sid="2CO 11:33" />koga ndakadelusigwa kuhhe ngehuli imuguma ndili mutundu, akasandibhata.<verse eid="2CO 11:33" /></para>
  <chapter eid="2CO 11" />
  <chapter number="12" style="c" sid="2CO 12" />
  <para style="s">Zumbunuligwa kwaPhawuli, neMibono Iye</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1" />Ndakafanila zwiloba fuba; nekutobe kusina tjandinowana nekwako, koga ndowhoyendilambeli ndileba nekwemibono nezumbunuligwa kunobva kunaHe. <verse eid="2CO 12:1" /><verse number="2" style="v" sid="2CO 12:2" />Ndoziba nlume umuna Khirisitu, wakadzamuligwa kudzimu kwebutatu, mumamakole aligumi nemana akapinda, kuti kene waka elimunyama kene waka esimunyama anditoziba, koziba Ndzimu. <verse eid="2CO 12:2" /><verse number="3" style="v" sid="2CO 12:3" />Kuti kene waka elimunyama kene waka esimunyama anditoziba, koziba Ndzimu, <verse eid="2CO 12:3" /><verse number="4" style="v" sid="2CO 12:4" />koga tjandinoziba whuti nlume iwhoyu wakadzamuligwa kuPharadayisi, kakale wakawha matama asingake akabudziwa umwe nhu, nhu tjaasingake akahhula nlomo nekwatjo. <verse eid="2CO 12:4" /><verse number="5" style="v" sid="2CO 12:5" />Ndowhozwiloba fuba ndilimilile iwhoyu nlume, koga imi tjekwangu anditowhozwikudza, kuhhe kwekuzwikudza nesasima kwangu. <verse eid="2CO 12:5" /><verse number="6" style="v" sid="2CO 12:6" />Nekene ndingahaka zwikudza, ndoba ndisitjilengwe, ngobe ndowhobandileba lebeswa. Koga ndozwidziba, kuyetila kuti kusibe ne unokumbula nekwangu kupinda tjaanobona mundili netjaanowha kubva kundili.<verse eid="2CO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 12:7" />Kudze ndisikule kwazo mukuzumbunuligwa, ndakabhayiwa nemhiwa mumbili, ntumwa waSatane, kuti undidziyidze, kuyetila kuti ndisizwikudze. <verse eid="2CO 12:7" /><verse number="8" style="v" sid="2CO 12:8" />Ndaka kumbilisisa He katatu nekwemhiwa iwhoyu, kuti ubhude mundili; <verse eid="2CO 12:8" /><verse number="9" style="v" sid="2CO 12:9" />koga wakati kundili, “Ngoni dzangu dzakakulizana, ngobe masimba angu anohhadzisika mukusasima.” Ndizo ke ndowhozwiloba fuba nesasima kwangu ndakahanha, kudze masimba aKhirisitu agale pehhugwi kwangu. <verse eid="2CO 12:9" /><verse number="10" style="v" sid="2CO 12:10" />Ndizo nentha yaKhirisitu, ndogutshikana nesasima, tukwa, bulemo, dziyidzika, nemamanikano; ngobe hapa ndisakasima, ipapo ndipo ke pandinamasimba.<verse eid="2CO 12:10" /></para>
  <para style="s">Phawuli Wakamanikana nekweBaKhorinte</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11" />Ndandili tjilengwe! Makandisundidzila kuba itjo, ngobe ndaka ndakafanila kudziwa ndimwi. Ngobe andizotongoba ndili ntukununu kubapositoli ibaba banoyi bakulu, nekutobe ndisitjimwe. <verse eid="2CO 12:11" /><verse number="12" style="v" sid="2CO 12:12" />Zwilakidzilo zwempositoli wakwako zwakayetiwa pakati kwenyu ngemoyo nlefu, kunohanganyisila zwilakidzilo nematjenamiso nemihingo mikulu kwazo. <verse eid="2CO 12:12" /><verse number="13" style="v" sid="2CO 12:13" />Mungaba makabhakhwa zwakayipa, kwakasiyana ne amwe makubungano ose, kuhhe kwekuti imi tjekwangu andizotongoba ntolo kumuli? Mundiyetile mazwibhatigwa nlandu iwhoyu!<verse eid="2CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14" />Ngwenuwali ndatjilulamila hha kumuli kwebutatu. Anditowhoba ntolo, ngobe anditohaka tjimwe tjenyu koga ndohaka imwi; ngobe bana abazofanila lela bazwadzi babo, koga bazwadzi ndibo bakafanila lela bana babo. <verse eid="2CO 12:14" /><verse number="15" style="v" sid="2CO 12:15" />Ndowhohingisa kwandinako kakale azwipila nayiko kose kwandili iko ndakahanha, kuti ndimubhatshe. Hapa ndimuda kwazo, imi ndingakodiwa kuhomanana?<verse eid="2CO 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 12:16" />Ngatitini andizoba ntolo kumuli, koga imwi moti ndakanditjebela, ndikamukunda ngemutjebela. <verse eid="2CO 12:16" /><verse number="17" style="v" sid="2CO 12:17" />Ndingaba ndakamutjebela ndihingisa umwe webandakatuma kumuli? <verse eid="2CO 12:17" /><verse number="18" style="v" sid="2CO 12:18" />Ndakatetedza Thayithasi kuti ahhe kumuli, ndikawumpa nghalimoyo akawumpeleka. Thayithasi wakamutjebela? Atizohinga nemeya yakafanana? Atizotshamba nhambo dzakafanana?<verse eid="2CO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19" />Mabamukumbula lubaka gose kuti tatizwidzibilila mbeli kwenyu? Tabatilebeleka muna Khirisitu tilimbeli kweNdzimu, kose ikoku kuli musimisa, badikani. <verse eid="2CO 12:19" /><verse number="20" style="v" sid="2CO 12:20" />Ngobe ndohla kuti pamwe swiyo ndingabuya akomuwana musi sekwandinoyemula, nekuti mungandiwana ndisi sekwamunoyemula; kuti pamwe kungaba nekakabadzana, nefupa, nemon'wa, nenyimana, netukana, nelebana zwakayipa, nezwida, nesawililana. <verse eid="2CO 12:20" /><verse number="21" style="v" sid="2CO 12:21" />Ndohla kuti hapa ndibuya kakale Ndzimu wangu angandiswabisa mbeli kwenyu, kakale kungahaka kuti ndilile ndililila bunji gwayibabo bakatjinya mumahhuba akapinda, basakahanduka muhambgwa yesazwibhata, mubupombgwe, netjibana kwabaka bethama.<verse eid="2CO 12:21" /></para>
  <chapter eid="2CO 12" />
  <chapter number="13" style="c" sid="2CO 13" />
  <para style="s">Buyisa Netjemela Kwebupelo</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1" />Ngwenu ndekwebutatu ndibuya kumuli. Imwe neyimwe ndebo yakafanila kuti ibe nebusupi gunobva kubasupi babili kene batatu. <verse eid="2CO 13:1" /><verse number="2" style="v" sid="2CO 13:2" />Ndakabatjemela ibabo bakatjinya mumahhuba akapinda kose nebamwe bose, kakale ndobatjemela ngwenuwali ndisipo pabali, sekwandakabatjemela ndilipo pandakakumba gwebubili, kuti hapa ndingabuya kakale anditowhobaletja, <verse eid="2CO 13:2" /><verse number="3" style="v" sid="2CO 13:3" />saku muhaka busupi kuti Khirisitu unolebeleka mundili. Akuta kuli kuti haana masimba elingisana namwi, koga unamasimba pakati kwenyu. <verse eid="2CO 13:3" /><verse number="4" style="v" sid="2CO 13:4" />Ngobe wakakowhomegwa mukusasima, koga unotjila ngemasimba eNdzimu. Ngobe atizosima muwunli, koga mukuhingidzana namwi towhotjila naye ngemasimba eNdzimu.<verse eid="2CO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5" />Muzwilingisise, kudze mubone kuti kene makabhatilila mukugalamoyo kwenyu. Muzwiholesese. Amutobona kuti Yesu Khirisitu umumuli? Kuhhe kwekuti mukon'wa gutsha holeseso! <verse eid="2CO 13:5" /><verse number="6" style="v" sid="2CO 13:6" />Ndogalabgwe mowhobona kuti atizokon'wa. <verse eid="2CO 13:6" /><verse number="7" style="v" sid="2CO 13:7" />Koga totembezela kuNdzimu kuti musiyete tjisaka tambunuka, kusi kuti banhu babone kuti iswi tagutsha holeseso, koga kuyetila kuti imwi muyete tjakatambunuka, nekutobe tingangatakon'wa. <verse eid="2CO 13:7" /><verse number="8" style="v" sid="2CO 13:8" />Ngobe akuna tjatingathama tileyana nelebeswa, koga tohingila lebeswa. <verse eid="2CO 13:8" /><verse number="9" style="v" sid="2CO 13:9" />Tohanha hapa iswi tisakasima, koga imwi makasima. Tjatinotembezelela whuti mukule kwakapelela. <verse eid="2CO 13:9" /><verse number="10" style="v" sid="2CO 13:10" />Ndokwala ikoku nditjikule namwi, kuyetila kuti pandinobuya ndisibe nkukutu pakuhingisa kwangu simba He labakandipa lebaka lisi lepaladza.<verse eid="2CO 13:10" /></para>
  <para style="s">Matama Epeta</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11" />Tjebupelo, makamu, hanhani. Tambunudzani zila dzenyu, whililani tjikumbilo tjangu<note caller="+" style="f"><char style="fr" closed="false">13.11 </char><char style="fq" closed="false">whililani tjikumbilo tjangu </char><char style="ft" closed="false">kakale kobva kuti mukulumbidzane</char></note>, umwe akuludzile umwe, galisanani nekunyalala, Ndzimu weludo nekunyalala unowhoba namwi.<verse eid="2CO 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 13:12" />Lezwanani neputa<note caller="+" style="f"><char style="fr" closed="false">13.12 </char><char style="ft" closed="false">zila yelezwana kwebanhu beku Asiya</char></note> kwakayengemala.</para>
  <para style="p" vid="2CO 13:12">Bose bayengemali banomubuyisa. <verse eid="2CO 13:12" /><verse number="13" style="v" sid="2CO 13:13" />Ngoni dzaHe Yesu Khirisitu neludo gweNdzimu nehanganyila kweMeya Yakayengemala akube namwi mose. <verse eid="2CO 13:13" /><verse number="14" style="v" sid="2CO 13:14" />Akujalo.<verse eid="2CO 13:14" /></para>
  <chapter eid="2CO 13" />
</usx>