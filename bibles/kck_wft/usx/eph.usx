<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Kalanga Bible Translation</book>
  <para style="h">BaEfesu</para>
  <para style="toc1">Lukwalo GwaPhawuli kubaEfesu</para>
  <para style="toc2">Lukwalo GwaPhawuli kubaEfesu</para>
  <para style="toc3">BaE</para>
  <para style="mt2">Lukwalo gwaPhawuli ekwalila</para>
  <para style="mt1">BAEFESU</para>
  <para style="imt">Tjinginiso</para>
  <para style="ip">
    <char style="bk">Lukwalo gwaPhawuli ekwalila baEfesu</char> gwakakwagwa mulubaka gun'ompela nelukwalo gwebaKolose, makole makumi matanhatu hule kwezwagwa gwaKhirisitu. Nkwali unozwitula eti ndimpositoli Phawuli (BaEfesu 1.1). Bazibi banjinji banobvuma kuti Phawuli wakakwala lukwalo gwebaEfesu nekene gusina buyisa kukwe kunowan'wa mulukwalo gwebaKolose. Nentha yayikoku kungabe kuli kuti gwakapoteleka ku amwe makubungano muntunhu. Phawuli kakale unoti waka ali mujele paakakwala lukwalo igogu (BaEfesu 3.1, BaEfesu 4.1, neBaEfesu 6.20). Phawuli wakabhatisa Thikhikhasi lukwalo kwaakabe alimugwendo gugwe enokumba gubungano leku Efesu (BaEfesu 6.21-22).</para>
  <para style="ip">Efesu wakabe uli nzi-nkulu nkulu weRoma muntunhu weAsiya Mina. Efesu yaka izibgwa kwazo nekwethempeli yayo yaka ipigwa ndzimwana unoyi Athemisi wemaGiriki (Mihingo 19.23-31). Gubungano leku Efesu lakatangisa lakasima kwazo koga lakabe lizwikudza (Zumbunulo 2.1-7).</para>
  <para style="ip">Mukutangisa kudze kunoti pakati kwelukwalo Phawuli unotjenesa kwazo kuti Ndzimu wakahala tjini banhu babe akabatjidza mumatjinyo abo munaYesu Khirisitu. Unofananidza gubungano sembili, Khirisitu ali iye n'holo; kakale unolifananidza netjibakwa, Khirisitu ali bgwe linotambunudza mbako. Kubvisila pakati napakati kwelukwalo Phawuli unopa tjenjedzo nekwebutjilo gweNkhirisitu.</para>
  <para style="iot">Nlongoloso Yezwimukati</para>
  <para style="io1">Mudanho (BaEfesu 1.1-2) Phawuli unozwitula kakale ebuyisa baEfesu (Baefesu 1.1-2)</para>
  <para style="io1">Unopa tjenjedzo nekwe dlidzana kwegubungano lebagalimoyo naKhirisitu (BaEfesu 1.3-3.21)</para>
  <para style="io1">Phawuli unokwala kakale nekwezila maKhirisitu kwaakafanila tjila ndiyo (BaEfesu 4.1-6.20)</para>
  <para style="io1">Kwebupelo Phawuli unopa matama epeta (BaEfesu 6.21-24)</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Kubva kuna Phawuli, mpositoli waKhirisitu Yesu ngekuda kweNdzimu.</para>
  <para style="p" vid="EPH 1:1">Kubayengemali baku Efesu banogalamoyo bo muna Khirisitu Yesu.<verse eid="EPH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2" />Ngoni nekunyalala kunobva kuNdzimu Tate bedu naHe Yesu Khirisitu ngakube kumuli.<verse eid="EPH 1:2" /></para>
  <para style="s">Makombolelo eMeya muna Khirisitu</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1.3 </char>
      <char style="xt" closed="false">
        <ref loc="2CO 1:3">2 BaKho 1.3</ref>.</char>
    </note> Ngakulumbidziwe Ndzimu Tate baHe Yesu Khirisitu wedu, bakatikombolela iswi muna Khirisitu nemakombolelo ose emeya amubugalo gwekudzimu, <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />ngobe bakatihala nentha yaKhirisitu kusanhu kukabumbiwa hango, kuti tibe bakayengemala kakale basina nlandu mbeli kwabo.</para>
  <para style="p" vid="EPH 1:4">Nentha yeludo gugwe <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />wakatihala kale kuti tibe bakololo<note caller="+" style="f"><char style="fr" closed="false">1.5 </char><char style="ft" closed="false">bakololo kungabviwa bana (kuhanganyiwa nebakadzi)</char></note> babe muna Yesu Khirisitu, nentha yekuti kwakakuwhunhanisa nekuti ndiko kwaakabe ehaka thama, <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" /><note caller="-" style="x"><char style="xo" closed="false">1.6 </char><char style="xt" closed="false"><ref loc="COL 1:13">BaK 1.13</ref>.</char></note> kuti kulumbidziwe ngoni dzidze dzihhele gudzo dzaakatipa mpho akasununguka muna Unodikala. <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" /><note caller="-" style="x"><char style="xo" closed="false">1.7 </char><char style="xt" closed="false"><ref loc="COL 1:14">BaK 1.14</ref>.</char></note> Muwunli tina lusununguko ngelopa lile, ngeyetigwa mazwibhatigwa matjinyo edu, kuyendidzana nebukulu bengoni dzidze <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />dzaakatipa nebunji gwadzo mubutjenjebvu nangekuwhisisa, <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />wakayeta kuti tizibe tjakasumbikala tjekuda kukwe, kuyendidzana netjaaka ehaka tjaakapeleledza kale muna Khirisitu <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" /><note caller="-" style="x"><char style="xo" closed="false">1.10 </char><char style="xt" closed="false"><ref loc="GAL 4:4">BaG 4.4</ref>. </char></note>sendongoloso yeswika kwehhadzisika kwelubaka, hanganya zwinhu zose zwibe kusi kwentungamili un'ompela muna Khirisitu, zwinhu zwikudzimu nezwinhu zwimuhango.<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />Muwunli, kuyendidzana nendongoloso iye iwhoyo unothama zwinhu zose kuyendidzana netjinangwa tjekuda kukwe, <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />iswi bakagalabgwe kutanga muna Khirisitu, takahaligwa kuti titjilile lumbidziwa kwegudzo lile.<verse eid="EPH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13" />Muwunli, imwi bo makawha dama lelebeswa, iyo ndebo mbuya yetjidziwa kwenyu, mukagalamoyo muwunli, makatjayiwa lutjayo gweMeya Yakayengemala yaakagadzabgwe, <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" /><note caller="-" style="x"><char style="xo" closed="false">1.14 </char><char style="xt" closed="false"><ref loc="2CO 1:22">2 BaKho 1.22</ref>.</char></note>meya ili iyo tjigadzabgwe tjenhaka yedu kudze kuwan'we lusununguko gwa ibabo babe, kudze kuti gudzo lile lilumbidziwe.<verse eid="EPH 1:14" /></para>
  <para style="s">Ntembezelo waPhawuli</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1.15 </char>
      <char style="xt" closed="false">
        <ref loc="COL 1:9">BaK 1.9</ref>.</char>
    </note>Nentha yayikoku, ngobe ndakawha nekwebugalimoyo gwenyu muna He Yesu neludo gwenyu gwamunago kubayengemali bose, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" /><note caller="-" style="x"><char style="xo" closed="false">1.16 </char><char style="xt" closed="false"><ref loc="COL 1:3">BaK 1.3</ref>.</char></note> andizoletja mubokela kuNdzimu, sekwandinomukumbula mumitembezelo yangu. <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />Ndogala ndikumbila kuti Ndzimu baHe wedu Yesu Khirisitu, Tate banokudziwa, bamupe meya yebutjenjebvu neyezumbunula kudze mubazibe, <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" /><note caller="-" style="x"><char style="xo" closed="false">1.18 </char><char style="xt" closed="false"><ref loc="DEU 33:3">Matam 33.3</ref>.</char></note> mimoyo yenyu ngayibe netjedza, kudze muzibe kuti ini bugalibgwe gwamakadanigwa igo, nekuti ini bunji gwenhaka iye inagudzo kubayengemali, <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />nekuti ini bukulu gungapo ngapo gwesimba lile limutili iswi banogalamoyo, kuyendidzana nehinga kwemasimba awe makulu <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" /><note caller="-" style="x"><char style="xo" closed="false">1.20 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Njimb 110.1</ref>.</char></note>kwaakapeleledza muna Khirisitu paakawumusa kubafi akawunghadza kuluboko gugwe gweludli kubugalo gwekudzimu, <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" /><note caller="-" style="x"><char style="xo" closed="false">1.21 </char><char style="xt" closed="false"><ref loc="COL 1:6">BaK 1.6</ref>; <ref loc="COL 2:10">2.10</ref>,<ref loc="COL 2:15">15</ref>.</char></note> pehhugwi kwebutongi bose nebutungamili nemasimba nekunda, napehhugwi kwezina limwe nelimwe linodan'wa, kusi kwelubaka igogu koga, koga nemuna gunowhohha; <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" /><note caller="-" style="x"><char style="xo" closed="false">1.22 </char><char style="xt" closed="false"><ref loc="PSA 8:6">Njimb 8.6</ref>; <ref loc="COL 1:18">BaK 1.18</ref>.</char></note>wakasa zwinhu zose kusi kwemasimba awe akawunthama akabe ntungamili wezwinhu zose eyetila gubungano lebagalimoyo, <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" /><note caller="-" style="x"><char style="xo" closed="false">1.23 </char><char style="xt" closed="false"><ref loc="ROM 12:5">BaR 12.5</ref>; <ref loc="COL 2:17">BaK 2.17</ref>.</char></note>gubungano ilelo ndilo mbili uwe, pelela kwayiye unopeleledza tjimwe netjimwe nezila dzose.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">Bva Mulufu ungina muButjilo</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />Imwi wakamuthama bapenyu, pamakamakafa nentha yezwibi nematjinyo <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />kwamakatongoba mutjila mukuli, mutebela zila dzehango ino, mutebela ntungamili wesimba lemhepo, iyo meya inohinga ngwenu mubanhu basingatobele nlayo. <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />Toseni takatongotjila munjemulo dzenyama yedu, titebela njemulo dzembili nenkumbulo, ndizo ngembumbiko takabe takafanila delukigwa nebuhongola, senhu wose.<verse eid="EPH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4" />Koga Ndzimu, uhhele mawhilangoni, neludo gukulu gwaakatida ndigo, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />nekene takabe takafa nentha yematjinyo edu, wakathama kuti titjile toseni naKhirisitu (nengoni makatjidziwa), <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />wakatimusa kubafi naye, akatigadza naye mubugalo gwekudzimu muna Khirisitu Yesu, <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />kuti mulubaka gunohha angalakidza bunji gwengoni dzidze gusina tjilizanyo mukutiwhilangoni kukwe muna Khirisitu Yesu. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" /><note caller="-" style="x"><char style="xo" closed="false">2.8 </char><char style="xt" closed="false"><ref loc="GAL 2:16">BaG 2.16</ref>.</char></note>Nentha yengoni makatjidziwa nekugalamoyo; koga ikoku akuta nentha yethama kwenyu, itjipo tjeNdzimu- <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />kusi nentha yemihingo, kuyetila kuti kusitongobe nenhu unozwikudza. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Nentha yekuti takabumbiwa na iye, takabumbiwa muna Khirisitu Yesu tibumbigwa mihingo mibuya, Ndzimu yabakabaakanya kale, kuti titjile muyili.<verse eid="EPH 2:10" /></para>
  <para style="s">Bun'ompela muna Khirisitu</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Ndizo kumbulani kuti kuna lubaka pamakatongobe Bataya ngezwagwa, ibabo banozwiti “bakathumbigwa” bemudana “basakathumbigwa,” kunothamiwa mumbili ngemaboko- <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" /><note caller="-" style="x"><char style="xo" closed="false">2.12 </char><char style="xt" closed="false"><ref loc="ISA 57:19">Isa 57.19</ref>.</char></note> kumbulani kuti mulubaka igogo makabe makathubukanyiwa naKhirisitu, musibetjaba tjaIsirayeli, kakale muli basingazibgwe muzwibvumilano zwetjigadzabgwe, musina kugalabgwe kakale musina Ndzimu muhango. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />Koga ngwenu, muna Khirisitu Yesu, imwi makatongobe muli kulekule, matjisedzedzewa pedlo ngelopa laKhirisitu. <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />Ngobe iye ndiye kunyalala kwedu, iye wakatithama bubili gwedu tikaba banhu ban'ompela, kakale nembili uwe wakakolomola lukuta gwelubengo gunotipalalanya, <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />ngekolomola nlayo wemilayo pafa kukwe, kuyetila kuti muwunli angabumba nhu ntshwa un'ompela mubugalo gwebabili, kuti kube nekunyalala, <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />kakale angatibgwilulanye bubili gwedu kuNdzimu, mumbili un'ompela ngetjileyanyo, kuyetila pedza lubengo. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" /><note caller="-" style="x"><char style="xo" closed="false">2.17 </char><char style="xt" closed="false"><ref loc="ISA 57:19">Isa 57.19</ref>.</char></note>Kakale wakahha akasumikila ndebo mbuya yekunyalala kuna imwi makabe muli kule, kakale akasumikila ndebo mbuya yekunyalala nekuna ibabo bakabe balipedlo. <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />Ngobe nentha iye tose bubili gwedu totubula hha kuna Tate ngeMeya in'ompela.<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />Ndizo ke, amutjibataya kene bahhi, koga matjiba bazwagwa behango in'ompela nebayengemali neben'ha weNdzimu, <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />makabakigwa pehhugwi kwembviwa yebapositoli nebalebesambeli, Khirisitu Yesu tjekukwe ali bgwe lendzibo linotambunudza mbako; <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />muwunli, mbako wose wakabhatana, unokula ukabe thempeli lakayengemala muna He; <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />muwunli, namwi bo makabumbiwa kuti mube bugalo Ndzimu gwaanogala muguli ngeMeya.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">N'hingo waPhawuli ehingila Bataya</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Nentha yayikoku, imi, Phawuli, nsungwa nentha yesumikila nekwaKhirisitu Yesu ndiyetila imwi Bataya <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" /><note caller="-" style="x"><char style="xo" closed="false">3.2 </char><char style="xt" closed="false"><ref loc="COL 1:25">BaK 1.25</ref>.</char></note> ndokutola kuti makatjiwha nekwen'hingo wengoni dzeNdzimu wakapiwa imi kuyetigwa imwi, <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />ndibva kuti, tjakasumbikala ndakatjizibisiwa ngezumbunulo, sekwandakwala ngebufupi. <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />Hapa mubala ipapa mungawhisisa luzibo gwangu gwetjakasumbikika nekwaKhirisitu, <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />tjisakatongozibgwa nezwimwe zwizekugwana zwakapinda sekwatjazumbunugwa ngwenu kubapositoli babe bakayengemala nebalebesambeli ngeMeya, <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" /><note caller="-" style="x"><char style="xo" closed="false">3.6 </char><char style="xt" closed="false"><ref loc="COL 1:27">BaK 1.27</ref>.</char></note> ndizo, Bataya batjibe bagali nhaka kan'ompela nabo, nhango dzembili un'ompela, kakale banagobe mutjigadzabgwe muna Khirisitu Yesu ngendebo mbuya.<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />Nentha yendebo mbuya iyeyi ndakayetiwa nlanda ngetjipo tjengoni dzeNdzimu tjandakapiwa ngehinga kwemasimba awe. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />Kundili, kene ndili ntukunu pakati kwebatukunu bose bebayengemali, ngoni idzedzi ndakadzipiwa, kuti ndisumikile kuBataya ndebo mbuya yefumwa isingapele yaKhirisitu, <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" /><note caller="-" style="x"><char style="xo" closed="false">3.9 </char><char style="xt" closed="false"><ref loc="COL 1:26">BaK 1.26</ref>.</char></note>nethama kuti banhu bose babone nlondesedzo yemasazibgwa yakasumbikala kubvila ntolo muNdzimu iye wakabumba zwinhu zose; <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />kuyetila kuti ngegubungano lebagalimoyo butjenjebvu gunjinji gwakasiyana siyana gweNdzimu, ngwenuwali, guzibisiwe batongi nebutungamili mubugalo gwekudzimu. <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />Ikoku kwaka kuyendidzana netjinangwa tjisingapele tjaakapeleledza muna Khirisitu Yesu He wedu, <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />muwunli nange kugalamoyo muwunli tohha kuNdzimu tizwiloba fuba kakale tizwigalabgwe. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Ndizo ndomukumbila kuti musinyale moyo nentha yayikoku dziyila kwangu ndidziyilila imwi, kuligudzo lenyu.<verse eid="EPH 3:13" /></para>
  <para style="s">Ludo gwaKhirisitu</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Nentha yayikoku ndopfigama mbeli kwaTate, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />ibo kunobva kubali zina lewumwe newumwe n'ha ukudzimu newumwe newumwe n'ha umuhango, <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />kuti kuyendidzana nebunji gwegudzo labo bangamusimisa mukati kwenyu nemasimba ngeMeya yabo, <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />nekuti Khirisitu agale mumimoyo yenyu ngekugalamoyo; kuti imwi, saku makadzikigwa mukatshitshinhigwa muludo, <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />kudze imwi kan'ompela nebayengemali bose, mube nemasimba ewhisisa bupabi nebulefu nebukulu nedzika kweludo gwaKhirisitu, <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />neziba ludo gwaKhirisitu igo gunopinda luzibo, kudze muhhadziwe nebuhhalo gose gweNdzimu.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />Iye unotubula thama kunjisa kunopinda kose kwatinokumbila kene kwatinokumbula ngemasimba awe anohinga mutili, <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />ngaakudziwe nezwizekugwana zose lini nalini, mugubungano nemuna Khirisitu Yesu, nekusingapele kose! Akujalo.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">Bhatana kweMbili</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Ndizo imi, nsungwa nentha yehingila He, ndomukumbila kuti mutjile nezila inoyendidzana nedan'wa kwamakawamutjila, <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" /><note caller="-" style="x"><char style="xo" closed="false">4.2 </char><char style="xt" closed="false"><ref loc="COL 3:12-13">BaK 3.12-13</ref>.</char></note>mutebame kakale mube banyolo, mube nemoyonlefu, mulakidze sanyalamoyo neludo kuwumwe newumwe, <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />mugwisa londolodza bhatana kweMeya ngekunyalala kunotibhatshanya. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />Kuna mbili un'ompela neMeya in'ompela, sayikoku bo namwi makadanigwa mukugalabgwe kun'ompela pamakadan'wa, <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />He un'ompela, kugalamoyo kun'ompela, bvubikiwa kun'ompela, <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />Ndzimu un'ompela kakale ali Tate bedu toseni, ibo bapehhugwi kwedu toseni kakale ngekwedu tose, kakale bamutili tose.<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />Koga umwe newumwe wedu wakawamutjila ngoni kuyendidzana netjilizanyo tjepa kwaKhirisitu. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" /><note caller="-" style="x"><char style="xo" closed="false">4.8 </char><char style="xt" closed="false"><ref loc="PSA 68:18">Njimb 68.18</ref>.</char></note> Ndizo lukwalo guti,</para>
  <para style="q1" vid="EPH 4:8">“Wakati ewulukila pehhugwi</para>
  <para style="q2" vid="EPH 4:8">akayenda nebatapwa banjinji,</para>
  <para style="q2" vid="EPH 4:8">akapa banhu zwipo.”<verse eid="EPH 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />(Hapa kuyi, “Wakawuluka,” kobvani kuhhe kwekuti wakadelukila kakale mubugalo gupasi gwehango? <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Iwhoyu wakadeluka ndiye kakale wakawulukila pehhugwi kwekudzimu kose, kuti abe posepose.) <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />Nezwipo zwizwe zwakabe zwili zwekuti bamwe babe bapositoli, bamwe babe balebesambeli, bamwe babe bavangeli bamwe babe balisi nebadiyi, <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />kuti kululamisiwe bayengemali mun'hingo wehingila gubungano, mukubumbiwa kwembili waKhirisitu, <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />kudzina toseni tingina mukubhatana kwekugalamoyo neziba Nkololo weNdzimu, nekula kwakapelela, nange swika tjiyelo tjakapelela tjebuhhalo gwaKhirisitu, <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />kuyetila kuti tisitjabe ngawana, dzinoposegwa yeno nayeno kakale dzinosengwa ngeyimwe neyimwe mhepo yezwidiyo, ngebupitipiti nendongoloso dzebanhu dzinotjengela. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" /><note caller="-" style="x"><char style="xo" closed="false">4.15 </char><char style="xt" closed="false"><ref loc="COL 1:18">BaK 1.18</ref>.</char></note> Koga, tileba malebeswa muludo, towhokula muna kose tikaba mbili uwe iwhoyo un'holo, iye Khirisitu, <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" /><note caller="-" style="x"><char style="xo" closed="false">4.16 </char><char style="xt" closed="false"><ref loc="COL 2:19">BaK 2.19</ref>.</char></note> kubva muwunli, mbili wose, wakabhatshanyiwa ukalukiwa ngeyimwe neyimwe ndzinga, hapa imwe neyimwe ndungululo ihinga zwakanaka, unokula ukazwibumba muludo.<verse eid="EPH 4:16" /></para>
  <para style="s">Butjilo Gutshwa muna Khirisitu</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Ndizo ke ndoleba ikoku ndipa busupi muna He, kuti musitjabe mutjatjila sekunotjila Bataya, bemikumbulo isina n'hingo, <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />mikumbulo yabo imuhhalima, bakathubukana nebutjilo gweNdzimu nentha yesaziba kumubali, nentha yebukukutu gwemimoyo yabo; <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />abatjina honi batjizwipila mubutjilo gwenzipo, bethama hambgwa yose besina tjinobadziba.<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />Ikoku akutayiko imwi kwamakadiyika nekwaKhirisitu! <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />Ndizo matjiwha nekukwe kakale makadiyiwa nekukwe, saku lebeswa lili munaYesu. <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />Thubukanani nembumbiko whulukugwi yezwiyeto zwebutjilo gwenyu gwekutanga yakabodzewa nenjemulo mbi dzebupitipiti, <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />muyetiwe mube batshwa mumeya nemumikumbulo yenyu, <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" /><note caller="-" style="x"><char style="xo" closed="false">4.24 </char><char style="xt" closed="false"><ref loc="COL 3:10">BaK 3.10</ref>.</char></note> kakale mumbale mbumbiko ndzwa, yakabumbiwa ikafanana neNdzimu mundulamo yelebeswa nebuyengemali.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4.25 </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 8:16">Zakh 8.16</ref>; <ref loc="ROM 12:5">BaR 12.5</ref>.</char>
    </note>Ndizo, letjani manyepwa, umwe newumwe ngaalebe lebeswa kumbakidzani uwe, ngobe tinhango dzembili un'ompela. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />Mon'wani koga musitjinye; hhuba lisidze likanongina mutjakamon'wa, <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />musipe Satane nkoba. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />Mbava ngayisitjakwibe, koga ngayihinge, ihinge n'hingo wakanaka ngemaboko ayo, kuyetila kuti itubule bhatsha banohaya. <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />Kusibhude matama akayipa mumilomo yenyu, koga kubhude matama akanakila baka, sekwakunobe kuhakika, kuyetila kuti kubhatshe ibabo banowha. <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />Musiwhise zogwadza Meya Yakayengemala yeNdzimu, yamakatjayiwa nayo lutjayo gwehhuba lesunungugwa. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />Hungu yose nebuhongola negwadziwa moyo nehhoba nemanyepwa kubhude mumuli, nebengana kose, <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" /><note caller="-" style="x"><char style="xo" closed="false">4.32 </char><char style="xt" closed="false"><ref loc="COL 3:13">BaK 3.13</ref>.</char></note>koga mululame kuwumwe newumwe, mube nemimoyo minyolo, muyetile umwe newumwe mazwibhatigwa, seNdzimu akamuyetila mazwibhatigwa muna Khirisitu.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s">Tjila Mutjedza</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />Ndizo ibani bayedzeleli beNdzimu, sebana banodikala. <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" /><note caller="-" style="x"><char style="xo" closed="false">5.2 </char><char style="xt" closed="false"><ref loc="EXO 29:18">Ful 29.18</ref>.</char></note>Kakale mutjile muludo, saKhirisitu akatida akapila butjilo gugwe nentha yedu, akabe mpilo unonhuwilila netjibhayilo kuNdzimu.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />Koga bupombgwe nehambgwa yose kene tjiba kusitongogala kwalebgwa pakati kwenyu, akuzofanila bayengemali. <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />Kusibe nendebo dzinohemesa, kene ndebo dzebulengwe, kene dada kusina mano kuna masapa, kusakalulama, koga ngakube nekuboka. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />Ibani nelebeswa ngekwayikoku, kuti akuna nhu unoyeta bupombgwe kene usakatjena, kene unotjiba (kunobviwa unonamata midzimwana), una gobe mubumambo gwaKhirisitu negweNdzimu.<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />Ngakusibe nenhu unomutjebela ngematama emanyepwa, kungentha yayizwezwi zwinhu buhongola gweNdzimu guwhodelukila pehhugwi kwebanhu basina nlayo. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Ndizo ke musidlidzane nabo. <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />Ngobe makatongobe hhalima, koga ngwenu mabetjedza muna He; tjilani sebana betjedza <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />(ngobe ntjelo wetjedza unowan'wa muna kose kubuya kakale kwakalulama kwelebeswa). <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />Mugwise tjose ziba tjinohanhisa He. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Musihanganyile mumihingo yehhalima isina tjimwe, koga muyidusile patjena. <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />Ngobe kobhatisa honi kene iko leba nekwezwinhu zwabanothama pakasumbikika; <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />koga hapa tjinhu tjidusigwa patjena ngetjedza tjeeboneka. <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />Ngobe tjimwe netjimwe tjinoboneka patjena itjedza. Ndizo koyi,</para>
  <para style="q1" vid="EPH 5:14">“Muka, iwe ulele,</para>
  <para style="q2" vid="EPH 5:14">muka kubafi,</para>
  <para style="q1" vid="EPH 5:14">tjedza tjaKhirisitu tjowhopenya mukuli.”<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Mulingisise zila yamunotjila ndiyo, musitjile sebanhu basakatjenjela, koga mutjile sebakatjenjela, <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" /><note caller="-" style="x"><char style="xo" closed="false">5.16 </char><char style="xt" closed="false"><ref loc="COL 4:5">BaK 4.5</ref>.</char></note> muhingisa lubaka ngezila yakatambunuka, ngobe mahhuba akayipa. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />Ndizo musibe zwilengwe, koga whisisani kuti ini kuda kwaHe.<verse eid="EPH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18" />Kakale musilaladzisiwe newayini, kunoyeta mukatjila butjilo gusina zwidziba; koga hhalani ngeMeya, <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" /><note caller="-" style="x"><char style="xo" closed="false">5.19 </char><char style="xt" closed="false"><ref loc="COL 3:16-17">BaK 3.16-17</ref>.</char></note>mubuyisane ngenjimbo, mumba njimbo dzinolumbidza Ndzimu, nange njimbo dzemeya, imbani mukudza He ngemimoyo yenyu yose, <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />lubaka gose nange kose muboka kuNdzimu ibo Tate muzina laHe wedu Yesu Khirisitu.<verse eid="EPH 5:20" /></para>
  <para style="s">Bafumakadzi neBalume</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />Muzwitebamise umwe kuwumwe ngentha yeba nemazwibhato kuna Khirisitu.<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5.22-6.9 </char>
      <char style="xt" closed="false">BaK 3.18-4.1.</char>
    </note>Bafumakadzi, muzwitebamise kubalume benyu, sekwamunothama kuna He. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Ngobe nlume un'holo wemfumakadzi saKhirisitu ali n'holo wegubungano, mbili uwe, kakale iye tjekukwe ndiye Ntjidzi wawo. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Segubungano lizwitebamisa kuna Khirisitu, ndizo bafumakadzi bo ngabazwitebamise kubalume babo mutjimwe netjimwe.<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />Balume, idani bafumakadzi benyu, saKhirisitu akada gubungano akapila butjilo gugwe ngentha yalo, <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />kuti swiyo angaliyengemadza, hule kwelitjenesa elingudza nevula ngedama, <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />kudze azwihhisile gubungano kuwunli lakanaka, lisakahwehwana lisina hambgwa kene tjimwe tjinhu, koga lakayengemala lisina nlandu. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />Ndizo ke balume bakafanila da bafumakadzi babo semibili yabo. Iwhoyo unoda mfumakadzi uwe unozwida iye tjekukwe. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />Ngobe akuna nhu unohema mbili uwe, koga unowumpa zodliwa akawuntjengeta, saKhirisitu ethama kugubungano, <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />ngobe tinhango dzembili uwe. <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" /><note caller="-" style="x"><char style="xo" closed="false">5.31 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Kut 2.24</ref>.</char></note>“Nentha yayikoku nlume unowhosiya tatayi namayi akanamatilana nemfumakadzi uwe, bubili gwabo banowhoba nyama in'ompela.” <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />Ikoku masazibgwa makulu kwazo, koga ndoleba nekwaKhirisitu negubungano, <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />koga ke, umwe newumwe wenyu ngaade mfumakadzi uwe sekwaanozwida iye tjekukwe, nemfumakadzi abe nemazwibhato kunlume uwe.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">Bana Nebazwadzi</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />Bana, ibani nemazwibhato kubazwadzi benyu muna He, ngobe ikoku kwakalulama. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" /><note caller="-" style="x"><char style="xo" closed="false">6.2 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Ful 20.12</ref>.</char></note>“Lemekedza tate babo nameyabo” (iwhoyu ndiwo nlayo wekutanga unatjigadzabgwe), <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" /><note caller="-" style="x"><char style="xo" closed="false">6.3 </char><char style="xt" closed="false"><ref loc="MAT 5:16">Mat 5.16</ref>.</char></note> “kudze kukuyendile zwakanaka kakale utjile butjilo gulefu muhango.”<verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6.4 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:21">BaK 3.21</ref>.</char>
    </note>Botate, musithame bana benyu bakaba nebuhongola, koga mubakulise nezila inamazwibhato nenlayo waHe.<verse eid="EPH 6:4" /></para>
  <para style="s">Balanda naBobatezi</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6.5 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:22-25">BaK 3.22-25</ref>.</char>
    </note>Balanda, ibani nemazwibhato kuna bobatezi benyu bemuhango, mubahle mubateteme nemoyo wakapelela, sekwamuna mazwibhato kuna Khirisitu. <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />Musikuthame hapa bakamulinga koga, mubahanhisa, koga mukuthame sebalanda baKhirisitu, banothama kuda kweNdzimu kubva mumoyo. <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />Muhinge nemimoyo yakapelela sekunoyi mohingila He, amutohingila banhu, <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />saku muziba kuti nhu wose unowhowamutjila mbhayilo unobva kuna He unoyendidzana nehinga kukwe kwakanaka, kusineni nekuti unlanda kene wakasununguka.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />Bobatezi, thamani mujalo bo kubalanda benyu, letjani bahlihlidzila, saku muziba kuti iwhoyo uBatezi wabo kakale ali He wenyu bo ukudzimu, kakale iye aana luhalawulo.<verse eid="EPH 6:9" /></para>
  <para style="s">Dzibiligwa kose Kunobva KuNdzimu</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />Tjebupelo, simani muna He nemusimba lile gulu. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />Mbalani zwiyambalo zwengwa zwamunopiwa neNdzimu, kudze muzwigwile mubutjengeli gwaSatane. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Ngobe atitogwisana nenyama nelopa, koga togwisana nebutungamili, nemasimba, nebatongi behango belubaka guno gwehhalima, nemeya yebubi ikubugalo gwekudzimu. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />Ndizo mbalani zwiyambalo zwengwa zwamunopiwa neNdzimu, kudze mutubule zwigwila muhhuba lebubi, kakale hapa mapedza zwigwila, mume makasima.<verse eid="EPH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6.14 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 11:5">Isa 11.5</ref>; <ref loc="ISA 59:17">59.17</ref>; <ref loc="1TH 5:8">1 BaTh 5.8</ref>. </char>
    </note>Ndizo ke mani makasima, makazwisunga nhunji nemwandabula wemalebeswa, makambala tjidzibililo tjendulamo pafuba, <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" /><note caller="-" style="x"><char style="xo" closed="false">6.15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">Isa 52.7</ref>.</char></note>nemakumbo enyu makambala kuzwilulamisa kunobva mundebo mbuya yekunyalala, <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />pehhugwi kwayikoku kose, mutole tjidzibililo tjebugalimoyo, tjamungahingisa dzima yose misebe yembi inopfuta. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" /><note caller="-" style="x"><char style="xo" closed="false">6.17 </char><char style="xt" closed="false"><ref loc="ISA 59:17">Isa 59.17</ref>.</char></note>Kakale tolani whuntshi yetjidzibililo yejidzo, nethumo leMeya, ilo dama leNdzimu. <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />Tembezelani lubaka gose muMeya, ngemitembezelo yakasiyana siyana nange kumbila kwakasiyana siyana. Nentha yayikoku mulinde muna moyonlefu kwazo, mutembezelela banhu beNdzimu bose, <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />munditembezelele bo, kuti hapa ndihhula nlomo wangu, ndipiwe matama kudze ndisihle leba masazibgwa endebo mbuya, <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />wandilimilili wayo ndilimumiketane, kudze ndilebeleke nekwayo ndina tjilopa, sekwandakafanila kuti ndilebeleke.<verse eid="EPH 6:20" /></para>
  <para style="s">Buyisa Kwebupelo</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6.21 </char>
      <char style="xt" closed="false">
        <ref loc="COL 4:7-8">BaK 4.7-8</ref>.</char>
    </note> Thikhikhasi hama inodikala ali nlanda unogalikabgwe muna He unowhomubudza kose, kudze muzibe nekwangu nekwandinothama. <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />Ndawuntuma kumuli nentha yayikoku, kuyetila kuti muzibe kuti titjini, nekuti akuludzile mimoyo yenyu.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />Kunyalala neludo guna kugalamoyo, kunobva kuNdzimu Tate naHe Yesu Khirisitu ngakube kubagalimoyo. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />Ngoni ngadzibe kuna bose banoda He wedu Yesu Khirisitu neludo gusingapele.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>