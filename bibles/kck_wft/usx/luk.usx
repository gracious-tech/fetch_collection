<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- Kalanga Translation Project</book>
  <para style="h">LUKA</para>
  <para style="toc1">Ndebo Mbuya Ngekwa Luka</para>
  <para style="toc2">Luka</para>
  <para style="toc3">Luk</para>
  <para style="mt2">Ndebo Mbuya Sekwayakakwagwa</para>
  <para style="mt1">ndiLUKA</para>
  <para style="imt">Tjinginiso</para>
  <para style="ip">
    <char style="bk">Ndebo Mbuya sekwayakakwagwa ndiLuka</char> gumwe lukwalo gwewhalo dzilina dzeThesitamente Ndzwa dzinoleba nekwebutjilo gwaYesu Khirisitu. Gumwe negumwe lukwalo goyi “ndebo mbuya,” whalo idzedzi dzakakwagwa naMatewu, naMako, naLuka naJohane hule kwefa kwaYesu. Luka azokwala nekwebutjilo gwaYesu koga, koga wakakwala kose nezwinhu badiyiwa baYesu zwabakayeta hule kwefa nemuka kubafi kwaYesu mulukwalo gunoyi <char style="bk">Mihingo yeBapositoli</char>. Akuna unoziba kuti <char style="bk">Ndebo Mbuya sekwayakakwagwa ndiLuka</char> yakakwagwa lini nekuti yakakwaligwa poni, koga bazibi nebunji banobvumilana kuti yakakwagwa hule kwemakole angaba makumi ali kutondeka Yesu azwagwa.</para>
  <para style="ip">
    <char style="bk">Nkwali ndiLuka, </char> waka ali nlapi. Zila iye yekwala nebiga matama inolakidza kuti waka eli nlume wakadiyika. Luka waka ehaka kwala nlongoloso yebutjilo gwaYesu yakatambunuka, elondesedza zwiyetikalo setobelelana kwazo, kudze banhu babe netjabanozwidiya mukubala nlongoloso iyeyo (Luk 1.1-3). Waka asi Njhuta (BaKolose 4.10-14) kakale waka ekwala nezila inowhisisiwa nenhu usi Njhuta. Ikoku koboneka nezila yaanotjenesa nekwemilenje yeMaJuta (Luk 1.8).</para>
  <para style="ip">
    <char style="bk">Ndebo Mbuya sekwayakakwagwa ndiLuka</char> inofanana nelukwalo gwaMatewu negwaMako, ngobe dzoleba nekwezinhu zwakafanana kakale nezila yakafanana. Pakati kwewhalo idzedzi butatu gwadzo, lukwalo gwaLuka ndigo guna nlongoloso yezwagwa kwaJohane Mbvubiki inamongo. Kakale Luka unoleba kwazo nekweyetila mazwibhatigwa (Luk 3.3, 11.4, 17.3-4, 23.34, 24.47) netembezela (Luk 3.21, 5.16, 6.12, 11.1-12, 22.32).</para>
  <para style="iot">Nlongoloso Yezwimukati</para>
  <para style="io1">Tjinginiso tjeNdebo Mbuya sekwayakakwagwa ndiLuka (Luk 1.1-4).</para>
  <para style="io1">Luka unoleba nekwezwagwa kwaYesu nekuti Yesu wakalulamisigwa n'hingo tjini (Luk 1.5-4.13).</para>
  <para style="io1">Luka unoleba nekwen'hingo wakayetiwa naYesu, kwazo kwazo matjenamiso aakayeta nezwidiyo zwaakadiya (Luk 4.14-21.38).</para>
  <para style="io1">Mumatanho mabili ebupelo, unoleba kuti Yesu wakafa tjini, akabiganyiwa tjini, nekuti wakamuka kubafi (Luk 22.1-24.53).</para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="s">Tjinginiso</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />Banjinji bakatola lubaka kuti bakubunganye ndongoloso yezwinhu zwatinogalabgwe pakati kwedu. <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />Setiwamutjidza kwabakathama ibo baka balipo kutanga nebasumikili bedama, <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />ndabona kwakalulama kuti hule kwelonda nkwala wezwinhu zose nebunyambi ndibvila kwazwinotangisila, kuti ndimukwalile kutobelana kwazo, imwi He Thiyofilasi. <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />Kuyetila kuti muzibe lebeswa lezwinhu zwamakabudziwa.<verse eid="LUK 1:4" /></para>
  <para style="s">Lebesewambeli Kwezwagwa KwaJohane Mbvubiki</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />Kwaka kuli yapo mumahhuba aHherodi mambo weJudiya, umwe mphirisiti waka eyi Zakhariya, ali webunga lebaphirisiti baAbhiya. Zakhariya waka ana mfumakadzi waka ali weludzi gwa Aroni zina lile eyi Elizabethi. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />Bose bubili gwabo baka bali banhu bakalulama mbeli kweNdzimu betobela milayo yose nayiko kose kunolebgwa naHe basina nlandu. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />Koga baka besina mwana nentha yekuti Elizabethi wakahaya mbeleko<note caller="+" style="f"><char style="fr" closed="false">1.7 </char><char style="ft" closed="false">nkadzi usingabhate mimba</char></note>, bose baka bakwegula baba nemakole manjinji.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />Kwakayetikala kuti ali mun'hingo webuphirisiti gugwe mbeli kweNdzimu, kuli lubaka gwebunga labo lebaphirisiti, <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />kuyendidzana nenlenje webuphirisiti, waka ahagwa ngemalipa kuti angine muthempeli yaHe apise mhoza<note caller="+" style="f"><char style="fr" closed="false">1.9 </char><char style="ft" closed="false">nti unonhuwilila</char></note>. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />Bunga lebanhu lose laka litembezela lili kuhhe mulubaka gwepfungayidziwa kwemhoza<note caller="+" style="f"><char style="fr" closed="false">1.10 </char><char style="ft" closed="false">nti unonhuwilila</char></note>. <verse eid="LUK 1:10" /><verse number="11" style="v" sid="LUK 1:11" />Wakabona ntumwa waHe alimile kuludli gwetjibeso tjinopfungayidzigwa mhoza<note caller="+" style="f"><char style="fr" closed="false">1.11 </char><char style="ft" closed="false">nti unonhuwilila</char></note>. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />Zakhariya ewumbona wakadziyidzika, akahhigwa nehla. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />Koga ntumwa wekudzimu wakati kuwunli, “Usihle, Zakhariya, ngobe ntembezelo uwo wawhika, nkadzikulu uwo Elizabethi unowhokuzwalila nkololo, nowhowumpa zina linoyi Johane. <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />Iwe nowhohanha ukahanhisisa, nebanhu banjinji banowhohanhila zwagwa kukwe; <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />ngobe unowhoba nhu nkulunkulu pabuso gwaHe, atowhon'wa wayini kene kunolaladzisa, unowhobe nhu uhhele neMeya Yakayengemala kubvila atji muntumbu wameyabe. <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />Unowhohandusila bunji gwebana ba Isirayeli kuna He Ndzimu wabo. <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />Unowhoyenda elimbeli kukwe ali mumeya nemasimba a Elija, kudze ahandusile mimoyo yabotate kubana, nebasingawhilile kuti babe nebutjenjebvu guna bakalulama, elulamisila banhu kuti balinde buya kwaHe.”<verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />Zakhariya wakahandula eti kuntumwa wekudzimu, “Ikoku kunhu ndowhoziba tjini kuti kowhoyetika? Ngobe imi ndakwegula nenkadzikulu wangu waba nemakole manjinji.”<verse eid="LUK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19" />Ntumwa wekudzimu wakahandula eti, “Ndoyi Gabhuriyeli, unoma mbeli koNdzimu; ndatumwa kuti ndiwhokubudza ndebo mbuya idzedzi. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />Tjilinga ke, unowhoba mbebebe awutowhotubula lebeleka kudza kuswika hhuba linoyetika zwinhu izwezwi, nentha yekuti awutogalamoyo, mawhi andakubudza iwo anowhohhadzisika mulubaka gwawo.”<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />Banhu baka bali kuhhe bakamilila Zakhariya, bakatjenamisiwa nenonoka bhuda kukwe muthempeli. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />Wakati abhuda, akakon'wa iko lebeleka nabo, bakabva baziba kuti wabona tjilakidzilo tjeNdzimu muthempeli; wakawholebeleka nabo nemaboko, etendeka koga nezwinyala kusitjina whi linobhuda.<verse eid="LUK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23" />Kwakati lubaka gugwe gwehinga muthempeli gwapela, akayenda kunzi uwe. <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />Hule kwemahhuba iyawo Elizabethi nkadzikulu uwe wakabhata mimba, koga akazwisumbika kwemimwedzi mihanu eti, <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />“Ndiko hinga kwaHe kundili mumahhuba awe ekunditjebuka kuti andiduse honi pakati kwebanhu.”<verse eid="LUK 1:25" /></para>
  <para style="s">Lebesewambeli Kwezwagwa kwaYesu</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />Mumwedzi webutanhatu Ndzimu wakatuma ntumwa Gabhuriyeli kuti ayende kunzi-nkulu wehango yeGalile unoyi Nazaretha, <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />kumhandala yaka ili muludo nenhhuhha unoyi Josefa wen'umba yaDavida, zina lemhandala liyi Mariya. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />Wakaswika kuwunli akati, “Hanha! iwe unodiwa, He banawe.”<verse eid="LUK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29" />Koga wakadziyidziwa nezwilebo zwentumwa eti munkumbulo uwe, “Whubuyisa kwakatini ikoku?” <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />Ntumwa wekudzimu wakati kuwunli, “Usihle Mariya, wawana ngoni dzeNdzimu. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />Nowhobhata mimba ukatshibama nkololo, unowhowumpa zina linoyi Yesu. <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />Unowhoba nhu nkulunkulu, unowhodan'wa eyi uNkololo we Upehhugwihhugwi; He Ndzimu banowhowumpa tjigalo tjebumambo tjatate babe Davida. <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />Unowhotonga pehhugwi kwen'umba yaJakobe nekusingapele, bumambo gugwe agutowhopela.”<verse eid="LUK 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34" />Ipapo Mariya wakati kuntumwa wekudzimu, “Kowhoyetika tjini ikoku imi ndisingazibe nlume?”<verse eid="LUK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35" />Ntumwa wekudzimu wakahandula eti, “Meya Yakayengemala inowhobuya pehhugwi kuko, nemasimba e Upehhugwihhugwi anowhokufukidza, kobva kuti iwhoyu wawunowhotshibama unowhoyi wakayengemala, unowhodan'wa eyi Nkololo weNdzimu. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />Tjilinga, na Elizabethi hama iyo bo, wakazwisenga mimba yenkololo iye akwegula, kwaba mimwedzi mitanhatu akazwisenga, iye waka eyi haatozwala. <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />Nekuti neNdzimu akuna tjisingatike.”<verse eid="LUK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38" />Mariya ekahandula eti, “Ndinlandakadzi waHe; ngakuyetike kundili semawhi enyu.” Ipapo ntumwa wekudzimu wakabva pawunli.<verse eid="LUK 1:38" /></para>
  <para style="s">Mariya Unokumba Elizabethi</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />Mumahhuba iyawo Mariya wakamilika akayenda kuhango yezwitombwana nekulibilidza, kunzi-nkulu waJuda. <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />Wakanongina mun'umba yaZakhariya akabuyisa Elizabethi. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />Kwakayetika kuti Elizabethi ewha buyisa kwaMariya, mwana umuntumbu wakatjuluka ehanha, Elizabethi wakahhala neMeya Yakayengemala. <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />Wakalebelekela pehhugwi ekati, “Waka kombolegwa iwe pakati kwebafumakadzi, mwana wawakasenga wakakombolegwa. <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />Kwayenda kutini mubupenyu gwangu kuti imi ndikumbiwe namayi baHe wangu? <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />Nentha yekuti whi lebuyisa kuko lati lingina muzebe dzangu mwana akatjuluka nentha yehanha kukwe muntumbu wangu. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />Waka kombolegwa iwhoyo wakagalamoyo kuti kowhohhadzisika kose kwakalebgwa naHe kuna iye.”<verse eid="LUK 1:45" /></para>
  <para style="s">Lumbo GwaMariya Gwelumbidza</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />Mariya wakati,</para>
  <para style="q1" vid="LUK 1:46">“Meya yangu inokudza He,<verse eid="LUK 1:46" /></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47" />nemeya yangu inakuhanha muNdzimu Ntjidzi wangu,<verse eid="LUK 1:47" /></para>
  <para style="q2">
    <verse number="48" style="v" sid="LUK 1:48" />nentha yekuti wakatjebuka akabona lingigwa muvula kwenlandakadzi uwe,</para>
  <para style="q1" vid="LUK 1:48">lingani mubone kubva ngwenuwali kuyenda mbeli zwizekugwana zose zowhondidana zwiti nkadzimayi waka kombolegwa.<verse eid="LUK 1:48" /></para>
  <para style="q2">
    <verse number="49" style="v" sid="LUK 1:49" />Iye wandiyetila zwinhu zwikulukulu unamasimba makulu.</para>
  <para style="q1" vid="LUK 1:49">Nezina lile lakayengemala.<verse eid="LUK 1:49" /></para>
  <para style="q2">
    <verse number="50" style="v" sid="LUK 1:50" />Mawhilangoni awe apehhugwi</para>
  <para style="q2" vid="LUK 1:50">kwebanowunhla kubva kutjizekugwana kunoti kutjizekugwana.<verse eid="LUK 1:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51" />Luboko gugwe gwalakidza masimba;</para>
  <para style="q2" vid="LUK 1:51">wakapaladza banozwida mumimoyo yabo.<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />Wakabadelusa muzwigalo zwabo ibabo bana masimba,</para>
  <para style="q2" vid="LUK 1:52">akamilidza banolingigwa pasi ebasa pehhugwi.<verse eid="LUK 1:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53" />Wakagutsha banahhala ebapa zwinozipa,</para>
  <para style="q2" vid="LUK 1:53">bafumi wakabahandusa basina tjabakasenga.<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54" />Wakatjidza nlandalume uwe Isirayeli,</para>
  <para style="q2" vid="LUK 1:54">muku alakana mawhilangoni awe.<verse eid="LUK 1:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55" />Seleba kukwe kunabotate bedu,</para>
  <para style="q2" vid="LUK 1:55">kuna Abhurahhamu neludzi gugwe nekusingapele.”<verse eid="LUK 1:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />Mariya wakagala naye mimwedzi mitatu, akabgwilila kun'ha uwe.<verse eid="LUK 1:56" /></para>
  <para style="s">Zwagwa kwaJohane Mbvubiki</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />Ipapo lubaka gwa Elizabethi gwatjiswika gwesununguka, wakatshibama mbisana. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />Babakidzani babe nehama dzidze bakawha kuti He bawuyetila mawhilangoni makulu, bakahanha kan'ompela naye.<verse eid="LUK 1:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59" />Nehhuba lebuhhanakadzi bakahha bewhothumbila mwana, bakawuntumila zina linoyi Zakhariya laka lili zina latatayi. <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />Meyabe bakati akutayiko, “Wakafanila dan'wa eyi Johane.”<verse eid="LUK 1:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61" />Banhu bakati, “Akuna weludzi gwenyu unazina lakajalo.” <verse eid="LUK 1:61" /><verse number="62" style="v" sid="LUK 1:62" />Bakalebeleka nemaboko bebhuzwa tatayi kuti banohaka kuti mwana apiwe zina lipi.<verse eid="LUK 1:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 1:63" />Wakakumbila kuti apiwe gwangwariba, akakwala eti, “Zina lile ndiJohane.” Bose bakatjenama. <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />Tjinyolotjo nlomo uwe wakahhulika, lulimi gugwe gukasununguka akalebeleka ekudza Ndzimu. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />Banhu baka beli babakidzani babo bakawigwa nehla, kose ikoku kwakalebgwa muhango yose yezwitombwana yeJudiya. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />Bose bakakuwha bakatjenama beti tjemumoyo, “Mwana iwhoyu unowhobe mwana wakatini?” Ngobe luboko gwaHe gwaka guli pehhugwi kukwe.<verse eid="LUK 1:66" /></para>
  <para style="s">Bulebesambeli gwaZakhariya</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />Tate babe Zakhariya bakahhadziwa neMeya Yakayengemala baka lebesambeli beti,<verse eid="LUK 1:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />“Wakakombolegwa He Ndzimu wa Isirayeli!</para>
  <para style="q2" vid="LUK 1:68">Nekuti wahha kubanhu babe akabasunungula.<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />Wakatimilidzila lunyanga gwejidzo mun'umba</para>
  <para style="q2" vid="LUK 1:69">yenlandalume uwe Davida.<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />Seleba kukwe nemilomo yebalebesambeli babe bakayengemala bantolo,<verse eid="LUK 1:70" /></para>
  <para style="q2">
    <verse number="71" style="v" sid="LUK 1:71" />kuti atitjidze kuzwita zwedu</para>
  <para style="q2" vid="LUK 1:71">tidusiwa mumaboko ebanotihema,<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />kuti atiyetile mawhilangoni aakagadzabgwe bobatategulu bedu,</para>
  <para style="q2" vid="LUK 1:72">ekumbula tjibvumilano tjitje tjakayengemala;<verse eid="LUK 1:72" /></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73" />tjibvumilano tjaakathama kuna tate bedu Abhurahhamu;<verse eid="LUK 1:73" /></para>
  <para style="q2">
    <verse number="74" style="v" sid="LUK 1:74" />kuti atisunungule mumaboko ezwita zwedu,</para>
  <para style="q2" vid="LUK 1:74">kuyetila kuti tiwutembezele tiwun'hingila tisingahle,<verse eid="LUK 1:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75" />mukuyengemala nelulama mbeli kukwe mumahhuba</para>
  <para style="q2" vid="LUK 1:75">ebupenyu gwedu gose.<verse eid="LUK 1:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />Iwe mwana unowhodan'wa uyi nlebesambeli weNdzimu Upehhugwihhugwi,</para>
  <para style="q1" vid="LUK 1:76">ngentha yekuti unowhoyenda mbeli kwaHe</para>
  <para style="q2" vid="LUK 1:76">ukula zila dzidze,<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />upa banhu luzibo gwetjidziwa</para>
  <para style="q2" vid="LUK 1:77">ngeyetigwa mazwibhatigwa matjinyo abo,<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />ngentha yemawhilangoni eNdzimu wedu,</para>
  <para style="q1" vid="LUK 1:78">tibhudigwa netjedza tjinobva pehhugwi tjiwhotikumba<verse eid="LUK 1:78" /></para>
  <para style="q2">
    <verse number="79" style="v" sid="LUK 1:79" />kuti tjipe tjedza kubanhu bagele muhhalima balimuntuzi welufu,</para>
  <para style="q2" vid="LUK 1:79">kuti tjitungamile makumbo edu kuti ayende muzila yekunyalala.”<verse eid="LUK 1:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />Mwana wakakula, akasima mumeya, egala mutjilambanyika kudza kuswika hhuba laakalakidziwa kubanhu be Isirayeli.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s">Zwagwa KwaYesu</para>
  <para style="r">(<ref loc="MAT 1:18-25">Matewu 1.18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />Kwakayetika kuti mumahhuba aKhesari Agasitasi kwakabhuda nlayo waka uti banhu muhango yose bakafanila kwalisiwa. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />Kwalisiwa ikoku kwekutanga kwakayetiwa Kwiriniyasi ali mbhati wentunhu weSiriya. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />Banhu bose bakayenda kuti benokwalisa, nhu wose eyenda kunzi-nkulu wakanyi kwabo.<verse eid="LUK 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4" />NaJosefa bo wakayenda ebva muntunhu weGalile, munzi-nkulu unoyi Nazaretha, akayenda kuntunhu weJudiya, kunzi unoyi Bhethelehhema ngobe waka ebaligwa kun'umba yeludzi gwaDavida. <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />Wakayenda enokwalisa naMariya waaka ewholobola, atjikuligwa.<note caller="+" style="f"><char style="fr" closed="false">2.5 </char><char style="ft" closed="false">Matewu danho1. Vesi 31</char></note> <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />Kwakayetika kuti betji ikweno, mahhuba awe etshibama akaswika. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />Wakatshibama mbisana mbano iye; akawumpetela nematjila, akawunladzika munghoro nentha yekuti n'umba dzebezi dzakadzili hhele.<verse eid="LUK 2:7" /></para>
  <para style="s">Balisi neBatumwa beNdzimu</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />Kwakakuna balisi bemhwizi muhango iyeyo, begala kumakula bakalisa, kakale belinda mhwizi dzabo busiku. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />Ntumwa waHe wakaboneka kubali, kwidzima kwaHe kukabakombeledza, bakahhala luhlo kwazo. <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />Ntumwa weNdzimu wakati kubali, “Musihle, ndawhotula ndebo mbuya inowhohanhisa banhu bose. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />Nasi mazwaligwa Ntjidzi, iye Khirisitu He, munzi-nkulu waDavida. <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />Yetji tjowhobe tjilakidzilo kumuli. ‘Mowhowana mwana akapetelegwa nematjila akaladzikiwa munghoro.’ ”<verse eid="LUK 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13" />Tjinyolotjo kwakabe negubungano lekudzimu gulugulu lina ntumwa weNdzimu limba likudza Ndzimu liti,<verse eid="LUK 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14" />“Gudzo ngalibe kuNdzimu Upehhugwihhugwi,</para>
  <para style="q2" vid="LUK 2:14">kunyalala muhango nehanha ngakube kubanhu bose!”<verse eid="LUK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />Kwakati ke batumwa beNdzimu babgwilila kudzimu, balisi bemhwizi bakalebelesana, beti, “Ayindeni ngwenuwali kuBhethelehhema tinobona tjayetika tjatazibisiwa naHe.”<verse eid="LUK 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16" />Bakayenda nekulibilidza, bakaswika bewana Mariya naJosefa, nemwana alilele munghoro. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />Bakati batjibona ikoku, bakathama kuti kuzibgwe kose kwalebgwa kubali nekwemwana iwhoyu. <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />Bose bakawha, kwakabatjenamisa kwakakulebgwa nebalisi bemhwizi. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />Koga Mariya wakatjengeta zose zwinhu izwezwi mumoyo akakumbulisisa nekwazo. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />Balisi bemhwizi baka bgwilila, bekudza kakale belumbidza Ndzimu nezwabaka babona nezwabaka bawha, zwaka zwiyendilana nebudziwa kwabo.<verse eid="LUK 2:20" /></para>
  <para style="s">Yesu Unotumigwa Zina</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />Muhhuba lebuhhanakadzi, paakathumbigwa, wakatumigwa zina linoyi Yesu, zina laka lalebgwa nentumwa weNdzimu iye asanhu akabe muntumbu wameyabe.<verse eid="LUK 2:21" /></para>
  <para style="s">Yesu Unoyendisiwa kuThempeli.</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22" />Lubaka gwetjenesewa kutobegwa nlayo waMozisi gwaswika, bakayenda naye kuJerusalema kuti bawunlesi kuna He, <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />sekwakwaka kwagwa munlayo waHe kuyi, “Yose mbano yetjilume inowhodan'wa iyi yakayengemala kuna He,” <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" />nekuti bahhise tjibhayilo sekwakunolebgwa munlayo waHe, “njiba mbili, kene whukunjiba njetjana mbili.”<verse eid="LUK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25" />Kwaka kuna nlumetate muJerusalema zina lile eyi Simiyoni, waka akalulama, ali nhu unohla Ndzimu, akamilila hhuba lenyaladziwa kwe Isirayeli, neMeya Yakayengemala yaka ilipehhugwi kukwe. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />Waka azibisiwa neMeya Yakayengemala kuti atowhofa asanhu akabona Khirisitu waHe. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />Etungamigwa ngeMeya, wakanongina muthempeli; bazwadzi bakahhisa mwana wabo Yesu kuti bawunthamile nlenje umunlayo, <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />wakatola mwana akawumilidza akawumbhata nemaboko awe akaboka Ndzimu eti,<verse eid="LUK 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29" />“He tjiletjani nlanda wenyu ayende nekunyalala</para>
  <para style="q2" vid="LUK 2:29">seleba kwedama lenyu.<verse eid="LUK 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30" />Ngobe meho angu atjibona kutjidza kwenyu<verse eid="LUK 2:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31" />kwamabaakanya mbeli kwebanhu bose,<verse eid="LUK 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32" />tjedza tjevonekela Bataya,</para>
  <para style="q2" vid="LUK 2:32">negudzo lebanhu benyu Isirayeli.”<verse eid="LUK 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />Tatayi namayi baka tjenamisiwa nayikoku kwakalebgwa nekukwe; <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />Simiyoni akabakombolela, eti kuna Mariya meyabe, “Iwhoyu mwana unowhota kuti banjinji bawe nebanjinji bamuke mu Isirayeli, unowhoba tjilakidzilo tjinolebgwa kusakalulama nekwatjo <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />(nempanga unowhobhaya moyo uwo), kudze mikumbulo yemimoyo minjinji ibe patjena.”<verse eid="LUK 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36" />Kwaka kuna umwe nlebesambeli wetjikadzi unoyi Ana, ali nkololokadzi waFanuweli wen'umba ya Aseri, waka atjikwegula, pakulobogwa kukwe alimhandala ihhele wakatjila nenlume makole ali kutondeka koga. <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />Waka ali tjilikadzi atjiba nemakole makumi ali hhanakadzi nemana, asingabve pathempeli, enamata siku nesikati ngetembezela neyila zodliwa. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />Eswika bo ipapo, tjinyolotjo wakaboka Ndzimu, akaleba nekwemwana kubanhu bose baka bakamilila sunungugwa kweJerusalema.<verse eid="LUK 2:38" /></para>
  <para style="s">Bgwilila kwabo kuNazaretha</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39" />Bapedza thama kose betobela nlayo waHe bakabgwilila kuNazaretha kunzi-nkulu wabo, kuntunhu weGalile. <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />Mwana wakakula kakale akasima mumeya, alihhele butjenjebvu, ngoni dzeNdzimu dzaka dzili pehhugwi kukwe.<verse eid="LUK 2:40" /></para>
  <para style="s">Mbisana Yesu ali muThempeli.</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />Bazwadzi babe bakabeyenda gole limwe nelimwe kuJerusalema kunzano wePhasika. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />Kwakati aba nemakole ali gumi nemabili bakayenda kuJerusalema sekwenlenje wenzano. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />Nzano wakati wapela, bobgwilila, mbisana Yesu akasalazwe kuJerusalema, bazwadzi babe bakasizibe. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />Koga ibo baka bekumbulila kuti upakati kwebamwe baka beli mugwendo, bakayenda hhuba lose, bakati bowun'haka pakati kwehama nebabakidzani babo bakawun'haya. <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />Bakati bawun'haya bakabgwilila kuJerusalema benowun'haka. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />Hule kwemahhuba matatu bakawuwana muthempeli aligele pakati kwebadiyi akabawhilila, ebabhuzwanya mibhuzo. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />Bose bakawuwha bakatjenamisiwa newhisisa kukwe nen'handulo dzidze. <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />Bakati bewumbona baka tjenama, meyabe bakati kuwunli, “Nkololo wangu nentha yeni utibhata ujali, imi natate babo tatikuhaka tina buyendasi.”<verse eid="LUK 2:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49" />Iye akabahandula eti, “Mamundihakilani, kati amutoziba kuti ndakafanila ba mun'hingo waTate bangu?” <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />Koga ibo abazowhisisa handula kukwe.<verse eid="LUK 2:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51" />Wakamilika akayenda nabo, bakanoswika kuNazaretha, wakabawhilila ezwitebamisa pasi kwabo; koga meyabe bakatjengeta kose ikoku mumoyo wabo. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />Yesu wakakula mubutjenjebvu nemutjimo, ediwa nebanhu neNdzimu.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s">Sumikila kwaJohane Mbvubiki</para>
  <para style="r">(<ref loc="MAT 3:1-12">Matewu 3.1-12</ref>; <ref loc="MRK 1:1-8">Mako 1.1-8</ref>; <ref loc="JHN 1:19-28">Johane 1.19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />Negole legumi nemahanu letonga kwaThibheriyasi Khesari, Phontiyu Pilatu ali mbhati wentunhu weJudiya naHherodi ali ntungamili weGalile, nun'una uwe Filiphi ali ntungamili wentunhu we Ithuriyasi nehangwanyana yeTirakhonisi naLisaniyasi ali ntungamili we Abhilini, <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />Anasi naKhayiyafasi ndibo baka bali baphirisiti bakulu, dama leNdzimu lakahha kuna Johane nkololo waZakhariya ali mutjilambanyika. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />Wakayenda kuhango yeJorodani, esumikila bvubikiwa kwekuti banhu bahanduke, bayetigwe mazwibhatigwa matjinyo. <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />Sekwakwaka kwagwa mulukwalo gwa Isaya nlebesambeli.</para>
  <para style="q1" vid="LUK 3:4">“Whi lewunodanilila ali</para>
  <para style="q2" vid="LUK 3:4">mutjilambanyika, eti baakanyani zila yaHe,</para>
  <para style="q2" vid="LUK 3:4">mutambunudze zidlana dzidze.<verse eid="LUK 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5" />Wose nkuku unowhovukidziwa,</para>
  <para style="q2" vid="LUK 3:5">matombo nezwitombwana kowhojitisiwa,</para>
  <para style="q1" vid="LUK 3:5">zila dzakakombama dzowhotambunudziwa,</para>
  <para style="q2" vid="LUK 3:5">zila dzina makadi dzowhobaakanyiwa;<verse eid="LUK 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6" />nebanhu bose banowhobona jidzo leNdzimu.”<verse eid="LUK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />Wakakoti kumbunga waka wahha kuwunli kuti uwhobvubikiwa, “Imwi tjizekugwana tjenyoka, ndiyani wakamuluma zebe kuti mutihhe buhongola gunohha? <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />Ibani nezwiyeto zwinolakidza handuka, musitange mati mumikumbulo yenyu, ‘Tina Abhurahhamu ndibo tate bedu’; ngobe ndoti kumuli, Ndzimu unotubula thama bana ba Abhurahhamu nemabgwe iyawa. <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />Kuna hanhu<note caller="+" style="f"><char style="fr" closed="false">3.9 </char><char style="ft" closed="false">dumulo</char></note> latjibigwa kale pamidzi yemiti, nti wose usingazwale mitjelo yakanaka unowhotemewa ukaposegwa mumoto.”<verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />Banhu bakawumbhuzwa ke beti, “Ngono titetjini.”<verse eid="LUK 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11" />Iye wakahandula eti, “Una zwiyambalo zwibili ngaape tjimwe kuna usina, unazodliwa ngathame bo ejalo.”<verse eid="LUK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12" />Baketisi bakabuya bo behaka bvubikiwa beti kuwunli, “Ndhiyi ngono iswi titetjini?”<verse eid="LUK 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13" />Wakabahandula eti, “Musilipise mupindisa kwamakatumwa.”<verse eid="LUK 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14" />Bagwi bengwa bakabhuzwa bo beti, “Iswi titetjini?”</para>
  <para style="p" vid="LUK 3:14">Akakoti kubali, “Musitolele banhu zwinhu nemasimba, kene pa nhu nlandu iye esina nlandu, mugutshiwe nembhayilo wenyu.”<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />Ipapo banhu baka bakalingilila kwazo, bezwibhuzwa mumimoyo yabo nekwaJohane, kuti angaba iye Khirisitu kani, <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />Johane wakahandula bose eti, “Imi ndobvubika nevula, koga kuna unamasimba apehhugwi kwe angu unowhobuya, mitjili yehangu dzidze andizolizanila yisunungula, iye unowhomubvubika neMeya Yakayengemala nemoto. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />Wakabhata luselo gugwe gwewulusa, kudze asiye kusina tjiyapo palutombo gugwe, ekokubunganya zwidlo ezwisa mudula lile, koga bunye unowhogupisa mumoto usingadzimike.”<verse eid="LUK 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18" />Ndizo ngematama manjinji wakabakuludzila banhu, akasumikila ndebo mbuya kubali. <verse eid="LUK 3:18" /><verse number="19" style="v" sid="LUK 3:19" />Koga Hherodi ntungamili, waka atjemegwa kuti asitole Hherodiyasi, nkadzi wenkulu uwe, nezwimwe zwibi zose zwaaka athama, <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />wakapamidzila bubi gugwe ngesunga Johane akawuhhalilila mujele.<verse eid="LUK 3:20" /></para>
  <para style="s">Bvubikiwa kwaYesu</para>
  <para style="r">(<ref loc="MAT 3:13-17">Matewu 3.13-17</ref>; <ref loc="MRK 1:9-11">Mako 1.9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />Kwakakoyetikala kuti banhu bose behha bewhobvubikiwa, Yesu atjibvubikiwa bo etembezela, kudzimu kwakahhuka, <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />Meya Yakayengemala ikajitila pehhugwi kukwe ili mutjimo tjembili, senjiba, whi likabva kudzimu liti, “Iwe uNkololo wangu wandinoda, ndohanha kwazo mukuli.”<verse eid="LUK 3:22" /></para>
  <para style="s">Bobatategulu baYesu Khirisitu</para>
  <para style="r">(<ref loc="MAT 1:1-17">Matewu 1.1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />Yesu paakatangisa diya, waka ana makole ezwagwa angaba makumi matatu, ali nkololo waJosefa (sekumbula kwebanhu), iye waka ali nkololo waHheli, <verse eid="LUK 3:23" /><verse number="24" style="v" sid="LUK 3:24" />nkololo waMathati, iye ali nkololo waLevi, nkololo waMeliki, waka ali nkololo waJanayi, iye ali nkololo waJosefa, <verse eid="LUK 3:24" /><verse number="25" style="v" sid="LUK 3:25" />waka ali nkololo waMathathiyasi, iye ali nkololo wa Amosi waka ali nkololo waNahhamu, iye ali nkololo wa Esili wakabe ali nkololo waNagayi. <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />Waka ali nkololo waMaathi, wakabe ali nkololo waMathathiyasi, waka ali nkololo waSemeyini, ali nkololo waJoseki, waka ali nkololo waJoda, <verse eid="LUK 3:26" /><verse number="27" style="v" sid="LUK 3:27" />iye waka ali nkololo waJowanani, iye ali nkololo waResa waka ali nkololo waZerubhabheli waka ali nkololo waSheyalithiyeli ali nkololo waNeri. <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />Waka ali nkololo waMeliki ali nkololo wa Adi, unobe nkololo waKhosamu waka ali nkololo wa Elimadamu, unobe waka ali nkololo wa Eri. <verse eid="LUK 3:28" /><verse number="29" style="v" sid="LUK 3:29" />Iye waka ali nkololo waJoshuwa ali nkololo wa Eliyeza, nkololo waJorimu, waka ali nkololo waMathati, nkololo waLevi. <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />Waka ali nkololo waSimiyoni, ali nkololo waJuda, waka ali nkololo waJosefa waka ali nkololo waJonamu ali nkololo wa Eliyakhimu, <verse eid="LUK 3:30" /><verse number="31" style="v" sid="LUK 3:31" />iye waka ali nkololo waMileya, waka ali nkololo waMena, ali nkololo waMathatha, ali nkololo waNathani nkololo waDavida, <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />iye waka ali nkololo waJese waka ali nkololo wa Obhedi, ali nkololo waBhowazi ali nkololo waSalimoni waka ali nkololo waNashoni, <verse eid="LUK 3:32" /><verse number="33" style="v" sid="LUK 3:33" />iye waka ali nkololo wa Aminadabhu, ali nkololo wa Adimini waka ali nkololo wa Ani, ali nkololo waHhezironi, ali nkololo waPherezi waka ali nkololo waJuda. <verse eid="LUK 3:33" /><verse number="34" style="v" sid="LUK 3:34" />Waka ali nkololo waJakobe ali nkololo wa Isaka waka ali nkololo wa Abhurahhamu ali nkololo waThera nkololo waNahhori, <verse eid="LUK 3:34" /><verse number="35" style="v" sid="LUK 3:35" />iye waka ali nkololo waSerugu waka ali nkololo waRewu, ali nkololo waPhelegi, waka ali nkololo wa Ebha, waka ali nkololo waShela. <verse eid="LUK 3:35" /><verse number="36" style="v" sid="LUK 3:36" />Waka ali nkololo waKhenani waka ali nkololo wa Afakisadi iye ali nkololo waShemu, nkololo waNowa, waka ali nkololo waLameki, <verse eid="LUK 3:36" /><verse number="37" style="v" sid="LUK 3:37" />iye waka ali nkololo waMethusela, ali nkololo wa Inoki waka ali nkololo waJaredi ali nkololo waMahalaleli, ali nkololo waKhenani, <verse eid="LUK 3:37" /><verse number="38" style="v" sid="LUK 3:38" />Waka ali nkololo wa Inosi iye ali nkololo waSethi waka ali nkololo wa Adamu, nkololo weNdzimu.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s">Likwa kwaYesu</para>
  <para style="r">(<ref loc="MAT 4:1-11">Matewu 4.1-11</ref>; <ref loc="MRK 1:12">Mako 1.12</ref>,<ref loc="MRK 1:13">13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />Yesu alihhele Meya Yakayengemala wakahanduka ebva kuJorodani, akatungamigwa neMeya kuyenda kutjilambanyika <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />kwaakalikiwa naSatane mahhuba ali makumi mana. Mumahhuba ihawo akuna zodliwa zwaakadla; kwapela mahhuba ihawo wakawha hhala.<verse eid="LUK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3" />Satane wakati kuwunli, “Hapa uli nkololo weNdzimu laya bgwe ileli kuti lihanduke libe tjinkwa.”<verse eid="LUK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4" />Yesu wakahandula eti, “Kwakakwagwa kuti, ‘Nhu atowhotjila netjinkwa<note caller="+" style="f"><char style="fr" closed="false">4.4 </char><char style="ft" closed="false">tjiwonga</char></note> tjoga.’ ”<verse eid="LUK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5" />Satane wakawunsa pehhugwi, tjinyolotjo akawulakidza bumambo gwehango dzose. <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />Satane akati kuwunli, “Ndowhokupa masimba ose iyawa negudzo lawo; ngobe ndakawawamutjidziwa ndowapa wandinoda apa. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />Hapa ungandinamata, bumambo gose gowhobe gugo.”<verse eid="LUK 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8" />Yesu wakawun'handula eti, “Kwakakwagwa kuti, ‘Nowhonamata He Ndzimu uwo koga, iye yega ndiye wawunowhohingila.’ ”<verse eid="LUK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9" />Wakayenda naye kuJerusalema akawuntanhisa pehhugwi kwetjilungwane tjethempeli, akakoti kuwunli, “Hapa uli nkololo weNdzimu, uzwiligile pasi. <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />Ngobe kwakakwagwa kuti, ‘Unowholaya batumwa babe kuti bakutjengete.’ <verse eid="LUK 4:10" /><verse number="11" style="v" sid="LUK 4:11" />Kakale, ‘Banowhokusenga mumaboko abo kuyetila kuti usikunhiwe nebgwe.’ ”<verse eid="LUK 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12" />Yesu wakahandula eti kuwunli, “Koyi, ‘Usilike He Ndzimu uwo.’ ”<verse eid="LUK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13" />Satane apedza zose zwiliko, wakawunsiya kwelubaka.<verse eid="LUK 4:13" /></para>
  <para style="s">Yesu Unotangisa N'hingo uwe muGalile</para>
  <para style="r">(<ref loc="MAT 4:12-17">Matewu 4.12-17</ref>; <ref loc="MRK 1:14">Mako 1.14</ref>,<ref loc="MRK 1:15">15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />Yesu wakabgwilila kuGalile ali mumasimba eMeya, kwakalebgwa nekukwe muntunhu wose. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />Wakadiya mumasinagogu abo, elumbidziwa nebanhu bose.<verse eid="LUK 4:15" /></para>
  <para style="s">Yesu Unolandugwa muNazaretha</para>
  <para style="r">(<ref loc="MAT 13:53-58">Matewu 13.53-58</ref>; <ref loc="MRK 6:1-6">Mako 6.1-6</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />Wakaswika kuNazaretha kwaaka alegwa; senlenje uwe, wakayenda kusinagogu munsi wesabatha. Wakamilika akabala; <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />wakapiwa lukwalo gweNlebesambeli Isaya, akaguhhula akawana pakakwagwa kuti,<verse eid="LUK 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18" />“Meya yaHe ipehhugwi kwangu,</para>
  <para style="q2" vid="LUK 4:18">nentha yekuti wakandihhodza kuti ndisumikile ndebo mbuya kubahayi.</para>
  <para style="q1" vid="LUK 4:18">Wakandituma kuti ndisumikile sunungugwa kwebatapwa,</para>
  <para style="q2" vid="LUK 4:18">nepofunuka kwemapofu,</para>
  <para style="q1" vid="LUK 4:18">nesunungugwa kwebakatshambidzigwa,<verse eid="LUK 4:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="LUK 4:19" />kuti ndisumikile gole laHe linowamutjilika<note caller="+" style="f"><char style="fr" closed="false">4.19 </char><char style="ft" closed="false">gole lengoni dzaHe, lesunungugwa kwebatapwa nebasungwa</char></note>.”<verse eid="LUK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />Wakahhalila lukwalo akagubwiliza kunlanda wesinagogu akanogala pasi. Banhu bose baka bali musinagogu bakawunlingisisa, <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />akatangisa lebeleka nabo eti, “Muhhuba lanasi, lukwalo igogu gwahhadzisika muzebe dzenyu.”<verse eid="LUK 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22" />Bose bakaleba zwakanaka nekukwe, betjenamisiwa nematama ahhele ngoni aka ebhuda munlomo uwe. Bakabhuzwana beti, “Kati haata nkololo waJosefa iwhoyu?”<verse eid="LUK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23" />Iye wakahandula eti, “Mowhondilebela gungulupesa linoti, ‘Nlapi tjizwilapa.’ Kwatakawha kwawakathama kuKhaphenawume tongokuthama bo namuno muhango yakanyi kwenyu.” <verse eid="LUK 4:23" /><verse number="24" style="v" sid="LUK 4:24" />Akakoti kubali kakale, “Ndolebesa ndoti kumuli, akuna nlebesambeli unowamutjigwa muhango yakanyi kwabo.” <verse eid="LUK 4:24" /><verse number="25" style="v" sid="LUK 4:25" />Koga lebeswa ndoti, “Kwaka kuna njhilikadzi njinji muhango ye Isirayeli mumahhuba a Elija, pakwakahhaligwa kudzimu kwemakole matatu nemimwedzi mitanhatu, kukaba bhamba gulu muhango yose. <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />Koga ke Elija waka asatumwa kuyimwe yadzo, wakatumwa kuZarephathi, ntunhu weSidoni, kumfumakadzi waka ali tjilikadzi. <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" />Lubaka gwenlebesambeli Elisha kuna banjinji baka bana bugwele gwemapele mu Isirayeli, koga akuna wakatjenesewa, kuhhe kwaNaamani wekuSiriya.”<verse eid="LUK 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28" />Bose baka beli musinagogu pabakawha ikoku bakahhala buhongola. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />Bakamilika bakawudusila kuhhe kwenzi-nkulu, bewunkakatila kunopelela dunhu laka lakabakigwa nzi-nkulu wabo, beyetila kuti bawumposele pasi. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />Koga iye wakasodzoroka nepakati kwabo akayenda zwe.<verse eid="LUK 4:30" /></para>
  <para style="s">Yesu Unotjidza Nlume unaMeyambi</para>
  <para style="r">(<ref loc="MRK 1:21-28">Mako 1.21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />Wakayenda kuKhaphenawume, nzi-nkulu weGalile. Waka ebadiya nsi wesabatha; <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />bakatjenamisiwa nediya kukwe, nekuti dama lile laka lina simba. <verse eid="LUK 4:32" /><verse number="33" style="v" sid="LUK 4:33" />Musinagogu kwaka kuna nlume waka aligegwe nemeyambi, meya isakayengemala, wakamimila newhi lipehhugwi, eti, <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />“Siyana naswi, tineni nawe iwe Yesu wekuNazaretha? Wahha wotipaladza kani? Ndokuziba kuti ndiwe yani, ndiwe Wakayengemala weNdzimu.”<verse eid="LUK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35" />Yesu wakayitjemela eti, “Nyalala, ubhude muwunli.” Meyambi yakawunlahila pasi pakati kwebanhu, ikabhuda muwunli isawunkubadza.<verse eid="LUK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36" />Bose bakatjenama, bakalebelesana beti, “Idama lakatini ileli? Ngobe ngekukunda nangemasimba unolaya meyambi dzikabhuda.” <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />Kwakalebgwa nekwaYesu muntunhu wose.<verse eid="LUK 4:37" /></para>
  <para style="s">Yesu Unopodza Banhu banjinji</para>
  <para style="r">(<ref loc="MAT 8:14-17">Matewu 8.14-17</ref>; <ref loc="MRK 1:29-34">Mako 1.29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />Wakabhuda musinagogu akayenda kun'ha waSimoni, mezwale baSimoni baka begwala bugwele gweluhhahhamo, baka bakumbilila kuti abatjidze. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />Wakamilika akatjemela bugwele, luhhahhamo gukapela, tjinyolotjo bakamilika baka bayetila zodliwa.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />Hhuba lakati lingina, bose baka bana bagwele bana nghwele dzakasiyana bakabuya nabo akababiga maboko akabapolesa. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />Meyambi dzakabhuda mubanjinji, dzikuwa dziti, “Ndimwi Nkololo weNdzimu!”</para>
  <para style="p" vid="LUK 4:41">Koga wakadzitjemela, asingadzibvumile kuti dzilebeleke, ngobe dzaka dziwunziba kuti ndiye Khirisitu.<verse eid="LUK 4:41" /></para>
  <para style="s">Yesu Unosumikila muMasinagogu</para>
  <para style="r">(<ref loc="MRK 1:35-39">Mako 1.35-39</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />Kwayedza, wakamilika akayenda kubugalo gwakanyalala, banhu bakasala bewun'haka, bakawuwana, baka kumbila kuti asiyende, <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />koga wakabahandula eti, “Ndakafanila sumikila bumambo gweNdzimu kuyimwe mizi bo, nditjo tjandakatumwa.”<verse eid="LUK 4:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 4:44" />Waka esumikila mumasinagogu emuJudiya.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s">Yesu Unodana Badiyiwa Bekutanga</para>
  <para style="r">(<ref loc="MAT 4:18-22">Matewu 4.18-22</ref>; <ref loc="MRK 1:16-20">Mako 1.16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />Kwakayetika kuti banhu bemanikidza kuti bawhe dama leNdzimu, waka alime pagan'wa gulugulu leGenesareti. <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />Wakabona zwikepe zwibili zwilimile pagan'wa, babhati bewhobe baka babhuda muzwili bengudza njanga<note caller="+" style="f"><char style="fr" closed="false">5.2 </char><char style="ft" closed="false">tjinhu tjinonga tjiswino tjinohingisiwa bhata whobe </char></note> dzabo. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />Wakangina mutjimwe kepe tjakatjili tjaSimoni, akawunkumbila kuti atjisundile mukati nyana muvula, akagala pasi akadiya banhu ali mukepe.<verse eid="LUK 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4" />Wakati apedza lebeleka akati kuna Simoni, “Nginani pakadzika mujitise njanga dzenyu mubhate whobe.”<verse eid="LUK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5" />Simoni wakahandula eti, “He, tahinga zwakabangalala busiku gose, atina kene tjatabhata, koga nentha yekuti ndimwi maleba totjowhojitisa njanga.” <verse eid="LUK 5:5" /><verse number="6" style="v" sid="LUK 5:6" />Bakati bata sayikoko bakabhata whobe njinji kwazo, njanga dzabo dzaka dzopaluka, <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />bakadana bamwe babo, baka bali kuzwimwe zwikepe, kuti babuye bawhobabhatsha, bakabuya bakababhatsha, bakahhadza zwikepe bubili gwazo zwikagulo nyula<note caller="+" style="f"><char style="fr" closed="false">5.7 </char><char style="ft" closed="false">nyungila </char></note>. <verse eid="LUK 5:7" /><verse number="8" style="v" sid="LUK 5:8" />Simoni Phethiro abona ikoku, wakapfigama mbeli kwaYesu eti, “Ibvani pandili He, nentha yekuti ndinhu uhhele tjinya!”<verse eid="LUK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 5:9" />Iye nebamwe baaka enabo, bakatjenamisiwa nebunji gwewhobe dzabaka babhata. <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />Jakobe naJohane, bakololo baZebhedi, baka bali bakwinya baSimoni, bakatjenama bo. Yesu wakati kuna Simoni, “Usihle, kubvila ngwenuwali unowhoba ubhata banhu.”<verse eid="LUK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 5:11" />Bakati badusila zwikepe kumhili, bakasiya kose, bakawuntobela.<verse eid="LUK 5:11" /></para>
  <para style="s">Yesu Unotjidza Nlume Unabugwele Gwemapele</para>
  <para style="r">(<ref loc="MAT 8:1-4">Matewu 8.1-4</ref>; <ref loc="MRK 1:40-45">Mako 1.40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />Kwakayetika kuti ali muwumwe nzi-nkulu, kwakabuya nlume waka ali hhele mapele, wakati abona Yesu akakotamisa n'holo akapfigama mbeli kukwe akawunkumbilisisa eti, “He, hapa muda zwenyu mungandiyeta ndikatjena.”<verse eid="LUK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13" />Wakatambunudza luboko gugwe, akawumbhata eti, “Ee! ndoda, tjenesewa.” Tjinyolotjo mapele akapela. <verse eid="LUK 5:13" /><verse number="14" style="v" sid="LUK 5:14" />Wakawunlaya eti, “Usibudze kene nhu, yenda unozwilakidza kumphirisiti upe tjibhayilo tjetjenesewa kuko selaya kwaMozisi, kuyetila kuti gube busupi kubanhu.”<verse eid="LUK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15" />Koga lebgwa nekwaYesu kwakahhala, kukakubungana banhu banjinji pawunli bewhowuwha kakale bewhopodzewa nghwele dzabo. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />Koga wakazwidusa mubanhu, akayenda kutjilambanyika akanotembezela.<verse eid="LUK 5:16" /></para>
  <para style="s">Yesu Unotjidza Nhu Wakalobgwa Negulukadzi</para>
  <para style="r">(<ref loc="MAT 9:1-8">Matewu 9.1-8</ref>; <ref loc="MRK 2:1-12">Mako 2.1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />Limwe hhuba ediya, kwaka kuna BaFarisi nebadiyi benlayo beligele ipapo bebva mumizi yose yemuGalile, neJudiya, neJerusalema. Simba laHe laka linaye kuti apodze bagwele. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />Kwakahha bamwe balume bakasenga ntengate nenhobo umwe nlume waka egwala, akalobgwa negulukadzi, bakabehaka ngina naye bawunladzike mbeli kukwe; <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />koga bakahaya zila yabangangina nayo nentha yebunji gwebanhu, bakatanha pehhugwi kwen'umba iyeyo bakawunginisa nemudenga ali panhobo, bakawunghadzika pakati kwebanhu, mbeli kwaYesu. <verse eid="LUK 5:19" /><verse number="20" style="v" sid="LUK 5:20" />Wakati ebona galamoyo kwabo, akati, “Nlumetate, wayetigwa mazwibhatigwa matjinyo awo.”<verse eid="LUK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21" />Bakwali nebaFarisi bakatangisa bhuzwa beti, “Ndiyani iwhoyu, unolebeleka etuka Ndzimu? Ndiyani ungayetila mazwibhatigwa matjinyo kuhhe kweNdzimu yega?”<verse eid="LUK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22" />Koga Yesu aziba mikumbulo yabo wakabahandula, eti, “Kungentha yeni muzwibhuzwanya mumimoyo yenyu? <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />Ndikupi kulelulelu, kuti, ‘Wayetigwa mazwibhatigwa matjinyo awo,’ kene kuti, ‘Milika uyende’? <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />Koga ke kudze muzibe kuti Nkololo wenhu una masimba muhango, eyetila mazwibhatigwa matjinyo” wakati kunlume wakalobgwa negulukadzi, “Ndoti kukuli, milika, tola nhobo iyo uyende kunzi uwo.”<verse eid="LUK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 5:25" />Tjinyolotjo wakamilika mbeli kwabo akatola nhobo yaaka alilele payili, akabva ipapo, akayenda kunzi uwe, elumbidza Ndzimu. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />Bose bakatjenama, bakakudza Ndzimu bakahhala kuhla, beti, “Nasi tabona zwinhu zwisakawolobeleka.”<verse eid="LUK 5:26" /></para>
  <para style="s">Yesu Unodana Levi</para>
  <para style="r">(<ref loc="MAT 9:9-13">Matewu 9.9-13</ref>; <ref loc="MRK 2:13-17">Mako 2.13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />Hule kwayikoku wakabhuda akayenda, akabona nketisi waka aligele pan'umba inoketisigwa, zina lile eyi Levi, akati kuwunli, “Unditobele.” <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />Wakamilika, akasiya kose, akawuntobela.<verse eid="LUK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29" />Levi wakawuyetila nzano nkulu wezodliwa mun'umba iye; kukabuya bunga gulugulu lebaketisi nebamwe banhu, bakadla nabo. <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" />Ngono nebaFarisi bakwali babo bakan'un'urika kubadiyiwa babe, beti, “Kati mokuyetilani dla nen'wa muli panhu pan'ompela nebaketisi nebatjinyi?”<verse eid="LUK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31" />Yesu wakabahandula ekati, “Basingagwale abatohaka nlapi, koga unohakiwa ngebanogwala. <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />Andizohhila kuti ndiwhodana bakalulama, koga batjinyi, kuti bahanduke.”<verse eid="LUK 5:32" /></para>
  <para style="s">Mbhuzo Nekweyila Zodliwa</para>
  <para style="r">(<ref loc="MAT 9:14-17">Matewu 9.14-17</ref>; <ref loc="MRK 2:18-22">Mako 2.18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />Bakati kuwunli, “Kungentha yeni badiyiwa baJohane beyila zodliwa lubaka gunjinji kakale betembezela, nebadiyiwa bebaFarisi banota bejalo, koga babo banogala bedla ben'wa zwabo.”<verse eid="LUK 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34" />Yesu wakabahandula eti, “Mungata kuti bezi bebukwe bayile zodliwa iye nkwaha atjinabo mun'umba yebukwe? <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />Anowhoswika mahhuba, nkwaha paanowhodusiwa mubali, ndipo pabanowhoyila zodliwa mumahhuba ihawo.”<verse eid="LUK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36" />Wakababudza tjifananidzo kakale, eti, “Akuna nhu unopalula tjigamba pajila dzwa akatjipfumila patjiyambalo tjikulukugwi; hapa angathama ejalo, unowhopalula jila dzwa, nejekana lapalugwa pajila dzwa alitowhoyendilana netjiyambalo tjikulukugwi. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />Akuna nhu unosa wayini ndzwa mumapepe makulukugwi; ayengathama ejalo, wayini ndzwa inowhopalula mapepe ikatebuka, mapepe akapwapwatika. <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />Koga wayini ndzwa inosiwa mumapepe matshwa. <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />Kakale akuna nhu unoti an'wa wayini whulukugwi ekoyemula ndzwa; ngobe unoti, ‘Whulukugwi ihine.’ ”<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s">Yesu ndiHe weSabatha</para>
  <para style="r">(<ref loc="MAT 12:1-8">Matewu 12.1-8</ref>; <ref loc="MRK 2:23-28">Mako 2.23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />Munsi wesabatha, epalama mudziminda, badiyiwa babe bakakowha miholo yezwidlo bakadla, bezwizozonga mumaboko abo. <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />Koga bamwe baFarisi bakati, “Kati motilani tjisingabvumigwe yetiwa muhhuba lesabatha?”<verse eid="LUK 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3" />Yesu wakabahandula eti, “Imwi amuzobala tjakayetiwa naDavida abhakhwa nehhala, iye nayibabo baaka enabo. <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />Kuti wakangina tjini mun'umba yeNdzimu, akatola tjinkwa tjakayengemala, tjaka tjisingabvumigwe dliwa nenhu kuhhe kwebaphirisiti, akadla, kakale akabapa bo baaka enabo?”<verse eid="LUK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 6:5" />Eba eti kubali, “Nkololo wenhu ndihe wesabatha.”<verse eid="LUK 6:5" /></para>
  <para style="s">Nlume Unaluboko Gwakahwehwana</para>
  <para style="r">(<ref loc="MAT 12:9-14">Matewu 12.9-14</ref>; <ref loc="MRK 3:1-6">Mako 3.1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />Umwe nsi wesabatha, paakangina musinagogu akadiya, kwaka kuna nlume waka ana luboko gwakahwehwana. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />Bakwali nebaFarisi bakawunteya, behaka bona kuti unowhotjidza kene muhhuba lesabatha, kuyetila kuti bawuwanile nlandu. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />Koga iye wakaziba mikumbulo yabo, akakoti kunlume unaluboko gwakahwehwana, “Milika, ume pakati.” Akamilika. <verse eid="LUK 6:8" /><verse number="9" style="v" sid="LUK 6:9" />Ipapo Yesu akati kubali, “Ndomubhuzwa, kumunlayo kuti uthame tjakalulama muhhuba lesabatha kene kuti uthame tjakayipa, kuti utjengetedze butjilo kene kuti ugupaladze?” <verse eid="LUK 6:9" /><verse number="10" style="v" sid="LUK 6:10" />Wakabalinga bose ekotjiti kunlume iwhoyo, “Tambunudza luboko gugo.” Akathama ejalo, luboko gugwe gwaka gwatjitambunuka.<verse eid="LUK 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 6:11" />Bakahhala buhongola, bakalangana kuti Yesu bangawunta betini.<verse eid="LUK 6:11" /></para>
  <para style="s">Badiyiwa bali Gumi Nebabili</para>
  <para style="r">(<ref loc="MAT 10:1-4">Matewu 10.1-4</ref>; <ref loc="MRK 3:13-19">Mako 3.13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />Mumahhuba iyawo wakayenda kudombo enotembezela, akatembezela kuNdzimu busiku gose. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />Kwayedza wakadana badiyiwa babe, akahala bali gumi nebabili, baakapa zina linoyi bapositoli; <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />Simoni waakadana eti Phethiro nenun'una uwe Andhireya, naJakobe naJohane, naFiliphi naBhatholomewu, <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />naMatewu naTomasi, naJakobe nkololo wa Alifiyasi, naSimoni (Njhuta unogwila lusununguko), <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />naJudasi nkololo waJakobe naJudasi Isikariyoti, wakakoba ntengesi.<verse eid="LUK 6:16" /></para>
  <para style="s">Yesu Unosumikila, kakale epodza</para>
  <para style="r">(<ref loc="MAT 4:23-25">Matewu 4.23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />Wakajita nabo, akanoma mugula nebadiyiwa babe banjinji, kwaka kuna lukawu gwebanhu baka bebva muJudiya yose nemuJerusalema yose nemuntha dzimunsumho wegungwa leTire neSidoni, baka babuya kuti bawhowha esumikila nekuti abapodze nghwele dzabo; <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />nebaka bedziyidziwa nemeyambi bakapodzewa. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />Banhu bose bakayedza wunkunha, ngobe masimba aka ebhuda muwunli ebatjidza bose.<verse eid="LUK 6:19" /></para>
  <para style="s">Hanha neBuyendasi</para>
  <para style="r">(<ref loc="MAT 5:1-12">Matewu 5.1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />Wakalinga badiyiwa babe akati,</para>
  <para style="q1" vid="LUK 6:20">“Makakombolegwa imwi bahayi;</para>
  <para style="q2" vid="LUK 6:20">ngobe tjenyu bumambo gweNdzimu!”<verse eid="LUK 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21" />“Makakombolegwa imwi banahhala ngwenuwali;</para>
  <para style="q2" vid="LUK 6:21">ngobe mowhogutshiwa!”</para>
  <para style="q1" vid="LUK 6:21">“Makakombolegwa imwi munolila ngwenuwali;</para>
  <para style="q2" vid="LUK 6:21">nentha yekuti mowhoseka!”<verse eid="LUK 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 6:22" />“Makakombolegwa imwi hapa banhu bemuhema, bemumbuka bemudusa pakati kwabo, bemutuka, betola mazina enyu se akayipa, ngentha yeNkololo wenhu! <verse eid="LUK 6:22" /><verse number="23" style="v" sid="LUK 6:23" />Muhanhe muhhuba ilelo, mutambe nekuhanha, ngobe mbhayilo wenyu unkulunkulu kudzimu; ngobe bobatategulu babo ndiko kwabakathama bo kubalebesambeli.”<verse eid="LUK 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24" />“Koga kwakamubangalalila imwi bafumi;</para>
  <para style="q2" vid="LUK 6:24">ngobe matjiwana nyaladziwa kwenyu.”<verse eid="LUK 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25" />“Kwakamubangalalila imwi makaguta ngwenuwali,</para>
  <para style="q2" vid="LUK 6:25">ngobe mowhobhakhwa nehhala!”</para>
  <para style="q1" vid="LUK 6:25">“Kwakamubangalalila imwi munoseka ngwenuwali,</para>
  <para style="q2" vid="LUK 6:25">ngobe mowholila mukakuwa.”<verse eid="LUK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 6:26" />“Kwakamubangalalila hapa mulebgwa zwakanaka nebanhu bose, ngobe botate babo baka beleba zwakanaka nekwebalebesambeli bemanyepwa.”<verse eid="LUK 6:26" /></para>
  <para style="s">Idani Zwita Zwenyu</para>
  <para style="r">(<ref loc="MAT 5:38-48">Matewu 5.38-48</ref>; <ref loc="MAT 7:12">7.12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />“Koga ndoti kumuli imwi makawhilila. Idani zwita zwenyu, banomuhema mubatile zwibuyanana. <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />Kombolelani banomutuka, mutembezelele banomubhata zwakayipa. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />Unokuloba luhaya gun'ompela uwumpe gumwe, wakutolela bhatji usiwundzibise kuti atole kose neyempe. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />Nhu wose unokukumbila tjimwe tjinhu uwumpe, wakutolela tjinhu tjitjo usitobele unobhuzwa. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" />Kwamunoyemula kuti banhu bakuthame kumuli, mukuthame bo kubali.”<verse eid="LUK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32" />“Hapa muda ibabo banomuda, bokewa kwenyu ndikupi? Ngobe batjinyi banoda banobada bo. <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />Hapa muyetila kwakalulama banomuyetila kwakalulama, mungabokewa kene? Ngobe batjinyi banota sayikoko bo. <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />Hapa mu adzima bangamubgwiliza, mungabokewa nani? Ngobe batjinyi bano adzima batjinyi bo, bakalingilila kuti banowhobgwiliziwa. <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" />Koga idani zwita zwenyu, mubayetile zwakalulama, mu adzime musingalingilile kuti mubgwiliziwe. Mbhayilo wenyu unowhoba nkulunkulu, imwi mowhobe bana be Upehhugwihhugwi; iye unangoni kuna basingaboke nebayeti bezwibi. <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />Ibani nemawhilangoni saTate benyu bena mawhilangoni.”<verse eid="LUK 6:36" /></para>
  <para style="s">Tilika Bamwe Nlandu</para>
  <para style="r">(<ref loc="MAT 7:1-5">Matewu 7.1-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />“Musitilike nlandu, namwi bo amutowhotilikiwa nlandu, musitonge, namwi bo amutowhotongewa, yetilani mazwibhatigwa, namwi mowhoyetigwa bo mazwibhatigwa. <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />Ipani, namwi mowhopiwa bo; tjiyelo tjakanaka, tjakatshambidzigwa, tjikazunguziwa, tjitebukana, tjowhosiwa pamakumbo enyu. Ngobe tjiyelo tjamunowhopa natjo mowhoyelegwa bo natjo hha mobgwiliziwa.”<verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />Wakakoleba tjifananidzo kubali eti, “Bhofu lingatungamila limwe bhofu? Bubili gwawo aangawile mugomba? <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" />Ndhiyiwa aangabe pehhugwi kwendhiyi uwe, koga umwe nemwe hapa atjidiyiwa unowhonga ndhiyi uwe.”<verse eid="LUK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41" />“Nobonelani lubaza muhhiho lehama iyo, koga usingabone danda limuhhiho lilo? <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />Kene ungati kuhama iyo, ‘Hama, letja ndikuduse lubaza gumuhhiho lilo,’ tjini iwe usingabone danda limuhhiho lilo tjini? Iwe ntjengeli, dusa danda limuhhiho lilo kutanga, ndiko kwawunowhobona zwibuyanana kuti uduse lubaza gumuhhiho lehama iyo.”<verse eid="LUK 6:42" /></para>
  <para style="s">Nti Nemitjelo Yawo</para>
  <para style="r">(<ref loc="MAT 7:16-20">Matewu 7.16-20</ref>; <ref loc="MAT 12:33-35">12.33-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />“Nti mbuya awutozwala zwizwalo zwakayipa, kene nti mbi awutozwala zwizwalo zwibuya. <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" />Nti umwe newumwe unozibgwa ngezwizwalo zwawo, makuyu haatotjegwa pamatenje emimhiwa, nemahhambi haatotjegwa pamatenje emimhiwa. <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" />Nhu wakalulama, mukululama kukwe kobhuda tjakalulama mukati kwemoyo uwe, koga nhu mbi, mububi gugwe kobhuda tjibi mukati kwemoyo uwe; ngobe nlomo unoleba zwihhele mumoyo.”<verse eid="LUK 6:45" /></para>
  <para style="s">Babaki Ben'umba Babili</para>
  <para style="r">(<ref loc="MAT 7:24-27">Matewu 7.24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />“Mondidanilani muti ‘He, He,’ imwi musingathame zwandinomulaya? <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />Wose nhu unohha kundili ewha zwidiyo zwangu kakale ezwitobela, ndowhomulakidza kuti wakafanana nani. <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />Wakafanana nenlume wakabaka n'umba, wakatanga netsha edza enobhata lutombo, akakobamba n'umba pehhugwi kwelutombo; kukati kuba nenkubila, gwizi gukahhala gukapembela nehango vula ikalobelela pan'umba, koga ayizotubula yizunguza ngobe yaka yabakika.<note caller="+" style="f"><char style="fr" closed="false">6.48 </char><char style="ft" closed="false">lutombo kobviwa hongwe yakawala</char></note> <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />Koga unowha ekosatobela, unofanana nenlume wakabakila n'umba iye pavunje isakabambiwa; kwakati gwizi gwahhala gukapembela nehango, vula ikalobelela pan'umba, tjinyolotjo ikawa, wa kwayo kwakaba kukulukulu.”<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">Yesu Unolapa Nlanda weNlume wekuRoma</para>
  <para style="r">(<ref loc="MAT 8:5-13">Matewu 8.5-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />Wakati apedza lebeleka nebanhu akangina muKhaphenawume. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />Kwaka kuna umwe nlawuli webagwi bengwa bali gulu, waka ana nlandalume uwe waaka eda kwazo, nlandalume iwhoyo waka egwalilofa. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />Wakati awha nekwaYesu, akawuntumila bawhola beMaJuta kudze banowunkumbila kuti abuye ewhotjidza nlandalume uwe. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />Bakati baswika kuna Yesu tjinyolotjo bekawunkumbilisisa beti, “Nlume iwhoyu wakalizanila kuti muwuntile ikoku, <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />ngobe unoda tjaba tjedu kwazo, wakatibakila sinagogu.”<verse eid="LUK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 7:6" />Yesu wakayenda nabo. Wakati atjibapedlo nen'umba, nlawuli webagwi bengwa bali gulu wakatuma bakwinya babe kuwunli, benoti, “Tate, musizwidziyidze, andizolizanila kuti mungangina mun'umba yangu. <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />Kene imi ndahla ndibona ndisakafanila kuti ndingahha kumuli. Koga lebani dama, n'hingi wangu unowhopola. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />Nami bo, ndinhu unohinga elipasi kwemasimba ebapehhugwi kwangu, ndina bagwi bengwa bapasi kwangu, ndoti kuna whoyu, ‘Yenda,’ akayenda, kuwumwe ndoti, ‘Ihha ngeno,’ unohha, ndoti kunlandalume wangu, ‘Thama whoku,’ akakuthama.”<verse eid="LUK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9" />Yesu paakawha matama iyawa, wakatjenamisiwa nenlume iwhoyu, akatjebuka gubungano laka liwuntobela akati, “Ndomubudza, kene iko mu Isirayeli andizotongowana bugalimoyo gwakajali.”<verse eid="LUK 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 7:10" />Ibabo baka batumwa bakati batjibgwilila kun'umba, bakanowana nlandalume waka egwala anaya.<verse eid="LUK 7:10" /></para>
  <para style="s">Yesu Unomusa Nkololo weTjilikadzi</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />Hhuba lakatobela wakayenda kunzi-nkulu unoyi Nayini, bunji gwebadiyiwa babe nebunji gwebanhu bakayenda naye. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />Wakati abepedlo nenkoba wenzi-nkulu akahangana nebanhu bakasenga nlume waka atjinyika benowumbiganya, waka ali iye yega mwana wetjilikadzi, banhu banjinji bemunzi-nkulu iwhoyo baka beyenda netjilikadzi iyeyo. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />He wakati ebona nkadzikulu iwhoyu akawuwhila ngoni, akakoti kuwunli, “Musilile.” <verse eid="LUK 7:13" /><verse number="14" style="v" sid="LUK 7:14" />Wakasedzela akabhata ntengate, baka bakasenga mbili wemfi bakama, iye akati kumfi, “Nhhuhha ndoti kukuli muka.” <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />Waka atjinyika wakamuka akagala akatangisa lebeleka, Yesu akawuwamutjidza kuna meyabe.<verse eid="LUK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16" />Banhu bose bakahhigwa nehla, bakakudza Ndzimu beti, “Kwamuka nlebesambeli nkulunkulu pakati kwedu,” kakale, “Ndzimu wakumba banhu babe.”<verse eid="LUK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 7:17" />Kwakalebgwa nekukwe muJudiya yose nehango dzipedlo.<verse eid="LUK 7:17" /></para>
  <para style="s">Batumwa Banobva kuna Johane Mbvubiki</para>
  <para style="r">(<ref loc="MAT 11:2-19">Matewu 11.2-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />Badiyiwa baJohane bakawumbudza zwinhu zose izwezwi, <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />Johane akadana babili, akabatuma kuna He eti, “Ndimwi unowhohha, kene timilile umwe?”<verse eid="LUK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20" />Bakaswika kuna Yesu bakati, “Johane Mbvubiki watituma kumuli eti, ‘Ndimwi unowhohha kene timilile umwe?’ ”<verse eid="LUK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21" />Mulubaka igogo wakapodza baka begwala banjinji, akapodza nghwele njinji akatata kose nemeyambi, akapofunula mpho banjinji baka beli mapofu. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />Wakabahandula eti, “Bgwililani munobudza Johane zwamabona nezwamawha. Mapofu anopofunuka nezwilema zoyenda, bagwele bemapele banotjenesewa, bomantshi zowha, bakafa banomusiwa, nendebo mbuya inosumikigwa kubahayi. <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />Wakakombolegwa nhu usingagwadziwe moyo ngentha yangu!”<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />Batumwa baJohane bakati bayenda akatangisa lebeleka nebanhu nekwaJohane eti, “Makayenda kutjilambanyika munobonani? Luhanga guzunguziwa nemhepo? <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />Maka munobonani? Nlume wakambala zwiyambalo zwakanaka? Banombala zwiyambalo zwakanaka baligele zwibuyanana, bagele mumiha yabomambo. <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />Makabhuda munobonani ngono? Nlebesambeli? Ee! ndomubudza, unopinda nlebesambeli. <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" />Ndiye iwhoyu kwakakwagwa nekukwe kuyi, ‘Linga, ndotuma ntumwa wangu mbeli kuko, unowhokubaakanyila zila iwe usanhu waswika.’ <verse eid="LUK 7:27" /><verse number="28" style="v" sid="LUK 7:28" />Ndomubudza, pakati kwayibo bose bakazwagwa nebetjikadzi akuna unkulu pana Johane; koga iwhoyo untukunu mubumambo gweNdzimu unkulu pawunli.”<verse eid="LUK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29" />(Banhu bose kose nebaketisi bakati bekuwha ikoku, bakabvuma kuti zila yeNdzimu yakalulama, ngobe bose baka babvubikiwa mbvubiko waJohane. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />Koga BaFarisi nebazibi benlayo bakalamba ndongoloso yeNdzimu nekwabo, ngobe besabvubikiwa ndiJohane.)<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />“Ngono ndowhobafananisa nani ibaba banhu bayitjetji tjizekugwana. Bakafanana nani kene? <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />Banonga bana bagele pabugalo gwetengesela, bedanilila bamwe beti, ‘Tamulidzila nyele amuzozana, tikamba njimbo dzelufu amuzolila.’ <verse eid="LUK 7:32" /><verse number="33" style="v" sid="LUK 7:33" />Ngobe Johane Mbvubiki wakabuya esingadle tjinkwa esingan'we wayini; moti, ‘Una meyambi.’ <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />Nkololo wenhu wakahha edla kakale en'wa, ngono moti, ‘Lingani, tjidli nenlaladzi, nkwinya webaketisi nebatjinyi.’ <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />Koga ke butjenjebvu golayidziwa ngebana bose bago.”<verse eid="LUK 7:35" /></para>
  <para style="s">Yesu ali Kunzi weMfarisi unoyi Simoni</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />Umwe webaFarisi wakawunkumbila kuti anodla naye, akayenda kun'umba yeMfarisi, akanodla. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />Umwe mfumakadzi munzi-nkulu iwhoyo, waka ali ntjinyi, wakati aziba kuti Yesu unodla kun'umba yeMfarisi, akabuya nekumbwana tjakayetiwa nebgwe linoyi alabhasita, tjemafuta anonhuwilila, <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />alimile hule kukwe, ntome kwemakumbo awe, elila, wakatangisa wanyolodza makumbo aYesu nemihodzi iye, akaabuhika nemavudzi awe, akawaputa, akaahhodza mafuta. <verse eid="LUK 7:38" /><verse number="39" style="v" sid="LUK 7:39" />Mfarisi waka akoka Yesu ebona ikoku, wakalebeleka netjemumoyo<note caller="+" style="f"><char style="fr" closed="false">7.39 </char></note> eti, “Iwhoyu nlume kadzene waali nlebesambeli, unoba aziba kuti ndiyani kakale umfumakadzi ludzini iwhoyu nhu unowunkunha, ngobe untjinyi.”<verse eid="LUK 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40" />Yesu wakalebeleka naye eti, “Simoni ndinatjinhu tjandinohaka kubudza.”</para>
  <para style="p" vid="LUK 7:40">Simoni wakahandula eti, “Lebani Ndhiyi.”<verse eid="LUK 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41" />Yesu wakati, “Kwaka kuna Nkweletesi waka enabanhu babili banowunkolota, umwe waka anakoloto tjemaloso esiliva ali makulu mahanu, umwe anakoloto tjemaloso esiliva ali makumi mahanu. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />Bakati bubili gwabo bahaya kuti bangawunlipa neni iye akabayetila mazwibhatigwa zwikwelete zwabo. Tjindibudza, ndiwupi pakati kwabo unowhowundha kwazo?”<verse eid="LUK 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43" />Simoni wakahandula eti, “Ndokumbula kuti iwhoya wakayetigwa mazwibhatigwa koloto tjinjinji.”</para>
  <para style="p" vid="LUK 7:43">Yesu eba ehandula eti, “Walebesa.” <verse eid="LUK 7:43" /><verse number="44" style="v" sid="LUK 7:44" />Ehandukila kumfumakadzi, wakati kuna Simoni, “Unobona mfumakadzi iwhoyu? Ndangina mun'umba iyo, ukasandipa vula yengula makumbo angu, koga iye wangudza makumbo angu nemihodzi iye akaabuhika nemavudzi awe. <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />Awuzotongondiputa koga nkadzimayi iwhoyu tjinga kwandangina muno haazotongoma puta makumbo angu. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />Awuzotongohhodza n'holo wangu mafuta, koga nkadzimayi iwhoyu wahhodza makumbo angu nemafuta anonhuwilila. <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />Ndizo ndoti kukuli, wayetigwa mazwibhatigwa matjinyo awe manjinji, ngobe walayidza da kwazo kwazo; koga iwhoyo unoyetigwa mazwibhatigwa mahomanana, unoda kuhomanana.”<verse eid="LUK 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48" />Akaba eti kumfumakadzi, “Wayetigwa mazwibhatigwa matjinyo awo.”<verse eid="LUK 7:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49" />Bakabedla naye bakatangisa lebeleka tjekwabo beti, “Ndiyani iwhoyu unoyetila mazwibhatigwa matjinyo?”<verse eid="LUK 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50" />Koga Yesu wakati kumfumakadzi, “Galamoyo kuko kwakutjidza; tjiyenda mukunyalala.”<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s">Bakadzimayi baka beyenda naYesu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />Hule kwayikoku wakayenda kumizi-mikulu nekumizi, esumikila ndebo mbuya yebumambo gweNdzimu. Ibabaya baligumi nebabili bakaba banaye, <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />nebamwe bafumakadzi, bakabatjidziwa mumeyambi nenghwele, Mariya, waka eli wekuMagadala, waka adusiwa meyambi dzili kutondeka, <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />naJowana mfumakadzi waTjuza, n'hingi waHherodi, naSusana, nebamwe banjinji, bakabe bewun'hingila bewahha nefumwa yabaka banayo.<verse eid="LUK 8:3" /></para>
  <para style="s">Tjifananidzo tjeNdzwali</para>
  <para style="r">(<ref loc="MAT 13:1-9">Matewu 13.1-9</ref>; <ref loc="MRK 4:1-9">Mako 4.1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />Banhu banjinji bakati bakubungana kuwunli bebva mumizi yakasiyana siyana, akalebeleka nabo netjifananidzo. <verse eid="LUK 8:4" /><verse number="5" style="v" sid="LUK 8:5" />“Ndzwali wakayenda enodzwala mbewu iye, wakati edzwala imwe mbewu ikawila muzila, ikatshambiwa, nenyunyi dzemumhepo dzikabuya dzikayidla. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />Imwe yakawila pana mahalabgwana, payakamela, yakaswaba ngobe yakahaya bunyolo. <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />Imwe yakawila mumimhiwa; mimhiwa ikakula nayo ikayizwiya. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />Imwe yakawila mumavu akanaka ikamela ikakombola ikazwala zwidlo zwinjinji, zwakapamhiwa kagulu.” Wakati aleba ikoku wakadanilila eti, “Unazebe dzewha, ngaawhe.”<verse eid="LUK 8:8" /></para>
  <para style="s">N'hingo weZwifananidzo</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />Badiyiwa bakati bawumbhuzwa kuti tjifananidzo itjetji tjobvani, <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />akati kubali, “Imwi makapiwa luzibo gwezwakasumbikika zwebumambo gweNdzimu; koga kubamwe ndoleba nezwifananidzo, kuyetila kuti nekene bebona basibone, nekene bewha basiwhisise.”<verse eid="LUK 8:10" /></para>
  <para style="s">Yesu Unotjenesa Tjifananidzo tjeNdzwali</para>
  <para style="r">(<ref loc="MAT 13:18-23">Matewu 13.18-23</ref>; <ref loc="MRK 4:13-20">Mako 4.13-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />“Tjifananidzo tjoleba whoku. Mbewu idama leNdzimu, <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />Yakawila muzila ndi ibabaya bakawha dama; Satane ekotjibuya ehha edusa dama mumimoyo yabo, kuti basitongo galamoyo bakatjidziwa. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />Yakawila pana mahalabgwana ndi ibabaya banoti bawha dama bakaliwamutjila nekuhanha; koga abana midzi, bano galamoyo kwelubakanyana, mulubaka gwelikwa banowa. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />Yakawila mumimhiwa, ndi ibabaya banowha dama, koga bekoti pakuyenda kwabo bekosilingiwa neda zwinhu, nefumwa, nezipa kwebutjilo, bekosaba nemitjelo yakakombola. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />Koga yakawila mumavu akanaka ndi ibabaya banoti bawha dama bakalilondolodza mumoyo wakanaka unalebeswa, bekotjiba nemitjelo ina moyonlefu.”<verse eid="LUK 8:15" /></para>
  <para style="s">Tjedza kusi kwetjidla</para>
  <para style="r">(<ref loc="MAT 13:10-17">Matewu 13.10-17</ref>; <ref loc="MRK 4:10-12">Mako 4.10-12</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />“Akuna nhu unobesedzela tjivoneko ekotjifumika netundu. Kene ekosa tjivoneko kusi kwembheta, koga unotjisa patjigadziko patjena eyetila kuti unongina mun'umba angine kuna tjedza.<verse eid="LUK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 8:17" />“Akuna tjakasumbikala tjisingawhoba patjena, kene tjakasumbikala tjisingowhozibgwa tjikaba patjedza.<verse eid="LUK 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 8:18" />“Mutjenjelele kuti mowha tjini; ngobe unako unowhopiwa kunjinji, koga usina unowhotolegwa nayikoko kwaanokumbula kuti unako.”<verse eid="LUK 8:18" /></para>
  <para style="s">Mayi baYesu nebanun'una babe</para>
  <para style="r">(<ref loc="MAT 12:46-50">Matewu 12.46-50</ref>; <ref loc="MRK 3:31-35">Mako 3.31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />Kwakakobuya meyabe nebanun'una babe, koga bakakon'wa swika kuwunli ngentha yebunji gwebanhu. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />Wakabudziwa kuyi, “Meyabo nebanun'una babo bakuhhe banohaka kubona.”<verse eid="LUK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21" />Koga wakahandula eti, “Mme bangu nebanun'una bangu ndi ibaba banowha dama leNdzimu bekolithama.”<verse eid="LUK 8:21" /></para>
  <para style="s">Yesu Unodzikamisa Dutu</para>
  <para style="r">(<ref loc="MAT 8:23-27">Matewu 8.23-27</ref>; <ref loc="MRK 4:35-41">Mako 4.35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />Limwe hhuba wakangina mukepe nebadiyiwa babe akati kubali, “Ayitjulukileni seli yeya yegungwa.” Bakatangisa yendesa kepe, <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />batjimugwendo iye wakabhakhwa newhope akayezela, kukabuya dutu mukati kwegungwa, kepe tjakatjehhala vula, beba mumboli. <verse eid="LUK 8:23" /><verse number="24" style="v" sid="LUK 8:24" />Bakayenda bakanowumusa, bedanilila beti, “He, He, tapalala!”</para>
  <para style="p" vid="LUK 8:24">Ipapo wakamuka akatjemela mhepo, nemiduka kwevula. Kose kwakama kukabe nekunyalala. <verse eid="LUK 8:24" /><verse number="25" style="v" sid="LUK 8:25" />Akakoti kubali, “Galamoyo kwenyu kuponi?”</para>
  <para style="p" vid="LUK 8:25">Ibo behla bakatjenama bakati umwe kuwumwe, “Ndiyani ngono iwhoyu, unotjemela mhepo kene gungwa kukawuwhilila?”<verse eid="LUK 8:25" /></para>
  <para style="s">Yesu Unotjidza Nhu Unameyambi</para>
  <para style="r">(<ref loc="MAT 8:28-34">Matewu 8.28-34</ref>; <ref loc="MRK 5:1-20">Mako 5.1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />Bakaswika kuhango yebaGerasini, yaka ili seli kweGalile. <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />Ebhuda etshamba pasi, wakahanganidziwa nenlume waka ebva munzi-nkulu waka aligegwe nemeyambi; kwatjiba lubaka asingambale zwiyambalo, kakale asingagale mun'umba koga egala mumakuwhu aka ali zwikumbu. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />Paakabona Yesu wakamimila akawila pasi mbeli kukwe, newhi lipehhugwi eti, “Muneni nami, imwi Yesu, Nkololo weNdzimu Upehhugwihhugwi? Ndomukumbila musindidziyidze.” <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />Ngobe waka alaya meyambi kuti ibhude munlume iwhoyo. (Ngobe lubaka gunjinji yaka iwundziyidza; baka begala bakawunsunga nemiketane nemitjili koga ethubula kose kwakawunsunga, kakale meyambi yaka iwuntakulila kutjilambanyika.) <verse eid="LUK 8:29" /><verse number="30" style="v" sid="LUK 8:30" />Yesu wakawumbhuzwa eti, “Zina lilo loyi yani?”</para>
  <para style="p" vid="LUK 8:30">Iye wakati, “Ligiyoni,” nentha yekuti meyambi njinji dzakadzangina muwunli. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />Dzakawunkumbila kuti asidzitatile kugomba lisina bupelo.<verse eid="LUK 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32" />Kwaka kuna ngubi yengulube dzaka dzifula muwhunde yedombo; dzikawunkumbilisisa kuti adziletjedze dzingine zwadzo mungulube, ndizo akadzibvumila. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />Meyambi dzakakotjibhuda munlume iwhoyo dzikanongina mungulube, ngulube dzakavondomoka dzikatihha dzijitila nepakakungulukila dzikanowila mugungwa dzikafa.<verse eid="LUK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34" />Balisi bakati bebona tjayetika bakatihha bakanoleba munzi-nkulu nemuhangwanyana yose. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />Banhu bakayenda kuti banobona tjakatjayetika, bakaswika kuna Yesu, bakawana nlume waka adusiwa meyambi aligele mbeli kwaYesu, akambala nenkumbulo uwe wakatambunuka; bakahla. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />Bakabakubona bakababudza kuti nlume waka aligegwe nemeyambi watjidziwa tjini. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />Ipapo bose banhu bentunhu webaGerasini bakawunkumbila kuti abve pabali; ngobe bakabhakhwa nehla kukulu; ndizo wakangina mukepe akabgwilila hule. <verse eid="LUK 8:37" /><verse number="38" style="v" sid="LUK 8:38" />Nlume waka adusiwa meyambi, wakawunkumbila kuti ayende bo naye.</para>
  <para style="p" vid="LUK 8:38">Koga Yesu wakawundzibisa, eti, <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />“Bgwilila kanyi kuko unobalakidza bukulu gwezwinhu zwawayetigwa neNdzimu.”</para>
  <para style="p" vid="LUK 8:39">Wakayenda, eleba munzi-nkulu wose bukulu gwezwinhu zwaayekatigwa naYesu.<verse eid="LUK 8:39" /></para>
  <para style="s">Nkololokadzi waJayirosi neMfumakadzi Wakabhata Jila laYesu</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />Kwakayetika kuti Yesu ahanduka, banhu bakawuwamutjila nehana kukulu ngobe bose baka bakawumilila. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />Kwakabuya nlume waka eyi Jayirosi waka ali ntungamili wesinagogu; akawila pamakumbo aYesu akawunkumbilisisa kuti ayende naye kun'umba iye, <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />waka ana nkololokadzi un'ompela, unamakole angaba gumi nemabili, waka egwalilofa.</para>
  <para style="p" vid="LUK 8:42">Wakati oyenda banhu bakawunsundanyidza. <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />Kukati nkadzimayi waka anabugwele gwebhihha malopa kwemakole ali gumi nemabili, kusina nlapi unotubula wunlapa, <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />akabuya hule kukwe, akabhata mpeto wetjiyambalo tjitje; tjinyolotjo bhuda malopa kukama. <verse eid="LUK 8:44" /><verse number="45" style="v" sid="LUK 8:45" />Yesu wakati, “Ndiyani wandibhata?”</para>
  <para style="p" vid="LUK 8:45">Banhu bose bakalandula, Phethiro nebamwe bakabelipo bakati, “He, mbunga unomuzwiya umusundanyidza imwi mukoti ndiyani wandibhata!”<verse eid="LUK 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46" />Yesu wakati, “Kunanhu wandibhata ngobe ndawha kuti masimba abhuda mundili.” <verse eid="LUK 8:46" /><verse number="47" style="v" sid="LUK 8:47" />Nkadzimayi ebona kuti haangazwisumbike, wakasedzela etetema, akawila mbeli kukwe akaleba mbeli kukwe nebanhu bose kuti wawumbhatilani, kakale kuti tjinyolotjo wabva apola. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />Yesu wakati kuwunli, “Nkololokadzi, galamoyo kuko kwathama ukanaya; yenda nekunyalala.”<verse eid="LUK 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />Etjalebeleka kwakaswika umwe nlume ebva kun'umba yentungamili wesinagogu, akati, “Nkololokadzi wenyu watjinyika; musitjadziyidze Ndhiyi.”<verse eid="LUK 8:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50" />Koga Yesu wakati akuwha akawun'handula eti, “Usihle; galamoyo koga, iye unowhonaya.”<verse eid="LUK 8:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51" />Wakati aswika kun'umba akadzibisa nhu wose ngina mun'umba, kuhhe kwaPhethiro naJakobe naJohane, natatayi namayi bemwana. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />Banhu bose baka bekuwa belilila mwana; koga wakati, “Musilile; haazofa koga ulele.”<verse eid="LUK 8:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53" />Koga bakawunseka bulengwe beziba kuti wafa. <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />Wakabhata nsikana neluboko akadanilila, eti, “Mwana, muka.” <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />Meya iye ikahanduka, tjinyolotjo akamuka; akabalaya kuti bawumpe zodliwa adle. <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />Bazwadzi babe bakatjenama kwazo; iye akabakowhomesedza kuti basibudze nhu tjayetika.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s">Yesu Unotuma Badiyiwa Bali Gumi Nebabili</para>
  <para style="r">(<ref loc="MAT 10:5-15">Matewu 10.5-15</ref>; <ref loc="MRK 6:7-13">Mako 6.7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />Wakadana badiyiwa babe bali gumi nebabili akabapa masimba pehhugwi kwemeyambi, akabapa nemasimba elapa nghwele, <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />akabatuma kuti banosumikila nekwebumambo gweNdzimu, nekuti batjidze bose banogwala. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />Wakati, kubali, “Musitole kene tjinhu mugwendo gwenyu, kene ludozo, kene whomo, kene zodliwa, kene mari, musitole kene zwiyambalo zwibili. <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />Iyeyo n'umba yamunongina, mugale muyili, mudza mubhuda munzi iwhoyo. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" />Banhu bakasamuwamutjila, mupule whuluba pamakumbo enyu hapa mobhuda munzi iwhoyo, kuti gube busupi pehhugwi kwabo.”<verse eid="LUK 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 9:6" />Bakamilika bakayenda mumizi yose, besumikila ndebo mbuya betjidza banogwala pose pose.<verse eid="LUK 9:6" /></para>
  <para style="s">Hherodi Unotjenamisiwa naYesu</para>
  <para style="r">(<ref loc="MAT 14:1-12">Matewu 14.1-12</ref>; <ref loc="MRK 6:14-29">Mako 6.14-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />Sangwenu Hherodi ntungamili wakawha kose kwaka kuyetikala, akatjenama, ngobe bamwe baka beti Johane wamuka kubafi, <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />bamwe baka beti Elija wamuka, bamwe bakati umwe webalebesambeli bantolo wamuka. <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />Hherodi wakati, “Johane ndakawunthubula n'holo; koga iwhoyu wandinowha kuyi unothama zwinhu zwakajali ndiyani?” Akayedza kuti awumbone.<verse eid="LUK 9:9" /></para>
  <para style="s">Yesu unopa zodliwa bali zwiwulu zwihanu</para>
  <para style="r">(<ref loc="MAT 14:13-21">Matewu 14.13-21</ref>; <ref loc="MRK 6:30-44">Mako 6.30-44</ref>; <ref loc="JHN 6:1-14">Johane 6.1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />Bapositoli bakati bahanduka bakawumbudza kwabaka bathama. Akabatola akayenda nabo bali boga kunzi-nkulu unoyi Bhethisayida. <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />Banhu bakati baziba, bakatobela; wakabawamutjila, akababudza nekwebumambo gweNdzimu, akatjidza bakabehaka tjidziwa.<verse eid="LUK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12" />Hhuba latewuka badiyiwa babe bali gumi nebabili bakahha kuwunli bakati, “Paladzani banhu, bayende kumizi nekubugalo gupedlo banowana zodliwa nepabangalala; ngobe pano ihango.”<verse eid="LUK 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13" />Koga wakabahandula eti, “Mubapeni tjabangadla.”</para>
  <para style="p" vid="LUK 9:13">Ibo bakati, “Tina zwinkwa zwihanu newhobe mbili koga, kuhhe kwekuti tiyende tinotenga zodliwa zwebanhu bose ibaba.” <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />Kwaka kuna balume bangaswika zwiwulu zwihanu.</para>
  <para style="p" vid="LUK 9:14">Wakati kubadiyiwa babe, “Itani kuti bagale bali mabunga ana banhu bali makumi mahanu.”<verse eid="LUK 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15" />Bakathama bejalo, baka bagadza pasi. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />Akatola zwinkwa zwihanu newhobe mbili akalinga pehhugwi kudzimu, akaboka akazwipemula, akazwipa badiyiwa babe kuti bape banhu. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />Bakadla bakaguta bose. Bakawolela zwipemu zwaka zwasala, zwikahhala zwitundu zwiligumi nezwibili.<verse eid="LUK 9:17" /></para>
  <para style="s">Phethiro unoleba kuti Yesu ndiye Khirisitu</para>
  <para style="r">(<ref loc="MAT 16:13-19">Matewu 16.13-19</ref>; <ref loc="MRK 8:27-29">Mako 8.27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />Kwakayetika kuti etembezela aliyega, badiyiwa babe bakahha pawunli; akababhuzwa eti, “Banhu banoti ndimi yani?”<verse eid="LUK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19" />Bakahandula beti, “Bamwe banoti ndimwi Johane Mbvubiki; bamwe banoti, ndimwi Elija; bamwe banoti muwumwe webalebesambeli bantolo wakamuka kubafi.”<verse eid="LUK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20" />Akababhuzwa eti, “Imwi moti ndimi yani?”</para>
  <para style="p" vid="LUK 9:20">Phethiro wakahandula eti, “Ndimwi Khirisitu weNdzimu.”<verse eid="LUK 9:20" /></para>
  <para style="s">Yesu Unoleba Nekwedziyidzika Kukwe Kose Nelufu Gugwe</para>
  <para style="r">(<ref loc="MAT 16:20-28">Matewu 16.20-28</ref>; Mako 8.30-9-1)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />Koga wakabakowhomesedza akabalaya kuti basibudze kene nhu, <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />eti kubali, “Nkololo wenhu wakafanila dziyidzika kwazo, alandugwe ngebawhola nebaphirisiti bakulu nebakwali, ekotjibulawa, muhhuba lebutatu ekomusiwa kubafi.”<verse eid="LUK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23" />Wakati kubali bose, “Hapa nhu ehaka nditobela ngaazwitoboke atole tjileyanyo tjitje mahhuba ose, anditobele. <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" />Ngobe kene yani zwe unowholondolodza butjilo gugwe gowhunlahikila; koga kene yani unolahikigwa nebutjilo gugwe ngentha yangu, unowhogulondolodza. <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />Kotjidzani kuti nhu awane hango yose koga ekolahikigwa nebutjilo gugwe? <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />Hapa nhu anahoni nami nematama angu, iwhoyo nhu Nkololo wenhu unowhobe nehoni naye, hapa obuya alimugudzo lile nelaTate nelebatumwa bakayengemala. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />Ndomubudza lebeswa, kuna bamile ipapa basingawholabila lufu, basanhu bakabona bumambo gweNdzimu.”<verse eid="LUK 9:27" /></para>
  <para style="s">Handugwa Tjimo</para>
  <para style="r">(<ref loc="MAT 17:1-8">Matewu 17.1-8</ref>; <ref loc="MRK 9:2-8">Mako 9.2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />Hule kwemahhuba angaba hhanakadzi Yesu aleba zwinhu izwezwi, wakatola Phethiro naJohane naJakobe, akatanha nabo pehhugwi kwedombo kuti banotembezela. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />Wakati etembezela buso gugwe gukahanduka mamo ago, zwiyambalo zwizwe zwikaba zwitjenatjena zwipenyelela. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />Linga, kwaka kuna balume babili, Mozisi na Elija, belebeleka naye, <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />baka boneka mukupenya belebeleka nekwefa kukwe, kwaaka kuwhohhadzisika muJerusalema. <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />Koga Phethiro nebamwe baka babhakhwa newhope, bakati bepapadzuka, bakabona penya kukwe nebalume babili balimile naye. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />Kwakati balume ibabo bopalalana naye, Phethiro wakati kuna Yesu, “He, kwakanaka kuti tipano; letjani tibake matumba matatu, limwe libe lenyu, limwe libe laMozisi, limwe libe la Elija” (Asingazibe kuti unolebani.)<verse eid="LUK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34" />Atjalebeleka ikoku, kwakahha gole likabafukidza; bakahla kwazo pabakabengina mugole. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" />Kwakabhuda whi mugole likati, “Whoyu ndiye Nkololo wangu, wandakahala; muwuwhilile!”<verse eid="LUK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 9:36" />Whi lakati lawhika, Yesu akawanika ali yega. Bakakutjengeta mumimoyo yabo, akuna nhu wabakabudza tjabakabona mumahhuba ihawo.<verse eid="LUK 9:36" /></para>
  <para style="s">Tjidziwa Kwembisana Unameyambi</para>
  <para style="r">(<ref loc="MAT 17:14-18">Matewu 17.14-18</ref>; <ref loc="MRK 9:14-27">Mako 9.14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />Hhuba lakatobela bakati bajita mudombo, bakahanganidziwa nebanhu banjinji. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />Umwe nlume mubunga wakadanilila eti, “Ndhiyi, ndomukumbila mulinge nkololo wangu, ngobe ndiye yega mwana wangu; <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />unobhakwa nemeyambi ekomimila; ejalo ebhuda mafulo munlomo, inowunligila pasi, ayitogozwa wunletja. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />Ndakumbila badiyiwa benyu kuti bayitate koga abazotubula.”<verse eid="LUK 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41" />Yesu wakahandula eti, “Ekee! Tjizekugwana tjisina bugalimoyo tjisingawhilile, ndowhoba namwi kukadza kukaba lini, ndimuyetila moyonlefu? Hhisa nkololo uwo ngeno.”<verse eid="LUK 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42" />Wakati ebuya naye meyambi ikawunkayikanya iwundziyidza. Koga Yesu wakatjemela meyambi, mbisana akanaya, akawumbgwiliza kuna tatayi. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />Bose bakatjenamisiwa nemasimba makulu eNdzimu.</para>
  <para style="s" vid="LUK 9:43">Yesu Unolebeleka Nekwefa Kukwe</para>
  <para style="r" vid="LUK 9:43">(<ref loc="MAT 17:22">Matewu 17.22</ref>,<ref loc="MAT 17:23">23</ref>; <ref loc="MRK 9:30-32">Mako 9.30-32</ref>)</para>
  <para style="p" vid="LUK 9:43">Koga bakati betjaka tjenamisiwa nezwinhu zwaaka ethama, akaba eti kubadiyiwa babe, <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" />“Matama iyawa ngaangine muzebe dzenyu; Nkololo wenhu unowhotugwa mumaboko ebanhu.” <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />Koga abazotongowawhisisa matama ihawo, akabe matama akasumbikika kubali, kudze basiwhisise; kakale bakahla wumbhuzwa nekwawo.<verse eid="LUK 9:45" /></para>
  <para style="s">Ndiyani Nkulu Pabamwe?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Matewu 18.1-5</ref>; <ref loc="MRK 9:33-37">Mako 9.33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />Kwakaba nekukakabadzana pakati kwebadiyiwa babe, behaka ziba kuti ndiyani ungayi ndiye nkulu pakati kwabo. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />Yesu aziba mikumbulo yabo wakatola mwana ntjetjana akawumisa pedlo naye, <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />akati kubali, “Unowamutjila mwana iwhoyu muzina langu unowamutjila imi; ne unondiwamutjila unowamutjila wakandituma; ngobe iwhoyo untukunu pakati kwenyu mose ndiye unkulu.”<verse eid="LUK 9:48" /></para>
  <para style="s">Usingagwisane Namwi Ndewenyu</para>
  <para style="r">(<ref loc="MRK 9:38-40">Mako 9.38-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />Johane wakati kuwunli, “He, tabona umwe nlume etata meyambi nezina lenyu tikawundzibisa ngobe asingamutobele naswi.”<verse eid="LUK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50" />Yesu wakati kuwunli, “Musiwundzibise; ngobe usingagwisane namwi ndewenyu.”<verse eid="LUK 9:50" /></para>
  <para style="s">Nzi wemaSamariya Unowunlamba Wamutjila Yesu</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />Lubaka gweyenda kudzimu gwakati gwasedzela, Yesu wakazwimisila yenda kuJerusalema. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />Wakatuma batumwa bakayenda mbeli kukwe, bakangina muntunhu wemaSamariya, benowubaakanyila kose. <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />Koga banhu abazowuwamutjila, ngobe kwaka kuli patjena kuti umuzila unoyenda kuJerusalema. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />Badiyiwa babe Jakobe naJohane bakati bebona ikoku bakati, “He, mohaka kuti tidane moto ubve kudzimu ubapaladze?”<verse eid="LUK 9:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 9:55" />Yesu wakatjebuka akabatjemela. <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />Bakayenda kuwumwe nzi unotobela.<verse eid="LUK 9:56" /></para>
  <para style="s">Banowhoba Batobeli baYesu</para>
  <para style="r">(<ref loc="MAT 8:19-22">Matewu 8.19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />Bakati beyenda muzila umwe nlume akati kuna Yesu, “Ndowhomutobela kose kwamunoyenda.”<verse eid="LUK 9:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58" />Yesu wakawun'handula eti, “Mhungubgwe dzina mimwina, nenyunyi dzemumhepo dzina zwihaka; koga Nkololo wenhu haana paangaladzika n'holo.”<verse eid="LUK 9:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59" />Wakakoti kuwumwe, “Unditobele.”</para>
  <para style="p" vid="LUK 9:59">Koga iye wakahandula eti, “He, mundibvumileni nditange ndanobiganya tate bangu.”<verse eid="LUK 9:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60" />Koga Yesu wakati kuwunli, “Siya bafi babiganye bafi babo; koga iwe yenda unosumikila bumambo gweNdzimu.”<verse eid="LUK 9:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61" />Umwe wakati, “Ndowhomutobela, He; koga mundibvumileni ndinowoneka ben'ha wangu.”<verse eid="LUK 9:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62" />Yesu wakati kuwunli, “Akuna nhu unoti akabhata bhadza akakotjebuka hule wakafanila bumambo gweNdzimu.”<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s">Yesu Unotuma Banhu Bali Makumi Ali Kutondeka Nebabili</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />Hule kwayikoku He wakahala bamwe bali makumi ali kutondeka nebabili, akabatuma bali babili babili, kumizi nemizana yaaka owhonda kuyili. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />Eti kubali, “Gowo ligulugulu, koga bahingi ndibo bahomanana; ndizo tembezelani mukumbile He mweni wegowho kuti atumile bahingi kugowho lile. <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" />Tjiyendani zwenyu; lingani, ndomutuma semhwizana pakati kwemhele. <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />Musisenge kwama tjemari, kene whomo, kene mbhatata; musibuyise iye nhu muzila. <verse eid="LUK 10:4" /><verse number="5" style="v" sid="LUK 10:5" />Kene yipi n'umba yamunongina, mutange mati, ‘Kunyalala ngakube mun'umba iyeyi!’ <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />Hha nkololo wekunyalala alipo, kunyalala kwenyu kowhogala pehhugwi kukwe; koga hapa esipo, kunyalala kowhobgwilila kumuli. <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" />Mugale mun'umba iyeyo, mudla mun'wa tjabanomupa, ngobe n'hingi wakalizanila mbhayilo uwe; musitendeleke dzin'umba. <verse eid="LUK 10:7" /><verse number="8" style="v" sid="LUK 10:8" />Mukangina munzi bakamuwamutjila mudle tjabigiwa mbeli kwenyu; <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />mutjidze bagwele bamukati, muti kubali, ‘Bumambo gweNdzimu gwasedzela kumuli.’ <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" />Koga mukangina munzi bakasamuwamutjila, nginani mudzizila dzawo muti, <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" />‘Kene iyo whuluba yenzi wenyu yakanamatila mumakumbo edu toyipulila kumuli; koga zibani kuti bumambo gweNdzimu gwasedzela.’ <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" />Ndomubudza, muhhuba ilelo kowhoba kuhine kwakayetika kuSodoma pana kunowhoyetika muna iwhoyo nzi.”<verse eid="LUK 10:12" /></para>
  <para style="s">Mizi Yebasingagalemoyo</para>
  <para style="r">(<ref loc="MAT 11:20-24">Matewu 11.20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />“Kwakakubangalalila iwe Khorazini! Kwakakubangalalila iwe Bhethisayida! ngobe kadzene mihingo mikulu yakayetiwa mumuli yaka yayetiwa muTire nemuSidoni, banoba bakahanduka ntolo, baligele pamilota bakambala zwiyambalo zwemasaka. <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />Koga kowhoba kuhine kuTire neSidoni muhhuba letongewa pana kumuli. <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />Nawe, Khaphenawume, nowhomilidzigwa pehhugwi kudzimu? Nowhojitisigwa pasi kuHhedesi.”<verse eid="LUK 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16" />“Unomuwha unowha imi, ne unomulamba unolamba imi, unolamba imi unolamba wakandituma.”<verse eid="LUK 10:16" /></para>
  <para style="s">Handuka kweBakatumwa bali Makumi ali Kutondeka</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />Ibabaya bali makumi ali kutondeka bakahanduka bakahanha, beti, “He kene meyambi dzadzitiwhilila muzina lenyu!”<verse eid="LUK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18" />Yesu wakati kubali, “Ndakabona Satane ewa ebva kudzimu sepenya kwevula. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />Lingani, ndamupa masimba ekuti mutshambe nyoka nemhani, mutshambe kose nemasimba ose etjita; akuna tjinowhomukubadza. <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />Koga kene kwakajalo musihanhile ikoku, kuti meyambi dzozwisa pasi kwenyu; koga hanhilani kuti mazina enyu akakwagwa kudzimu.”<verse eid="LUK 10:20" /></para>
  <para style="s">Yesu Unohanha</para>
  <para style="r">(<ref loc="MAT 11:25-27">Matewu 11.25-27</ref>; <ref loc="MAT 13:16">13.16</ref>,<ref loc="MAT 13:17">17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />Palubaka igogo Yesu wakahanha muMeya Yakayengemala akati, “Ndomuboka, Tate, He wekudzimu nehango, kuti makasumbikila zwinhu izwezwi batjenjebvu nebanowhisisa, mukazwilayidza bana batjetjana; ee, Tate, ngobe ikoku kwaka kuli kuda kwenyu kwengoni.”<verse eid="LUK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22" />“Zose zwinhu zwapiwa imi naTate bangu; kakale akuna unoziba kuti Nkololo ndiyani kuhhe kwaTate, kene kuti Tate ndiyani kuhhe kweNkololo nayiwhoyo Nkololo waanohala wunlayidza.”<verse eid="LUK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23" />Akati ohandukila kubadiyiwa babe boga akati, “Akakombolegwa meho anobona tjamunobona! <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />Ngobe ndomubudza kuti balebesambeli banjinji nabomambo banjinji bakayemula bona tjamunobona, koga abazotjibona, newha tjamunowha koga abazotjiwha.”<verse eid="LUK 10:24" /></para>
  <para style="s">Tjifananidzo tjeNsamariya Wakalulama</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />Nzibi wenlayo wakamilika akawunlika, eti, “Ndhiyi, ndingatatjini kuti ndiwane butjilo gusingapele?”<verse eid="LUK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26" />Wakati kuwunli, “Kwaka kwagwani munlayo? Unokuwhisisa tjini?”<verse eid="LUK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27" />Wakahandula eti, “Ida He Ndzimu uwo nemoyo uwo wose, nemeya iyo yose, nemasimba awo wose, nenkumbulo uwo wose; ude mbakidzani uwo nezila yawunozwida iwe.”<verse eid="LUK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28" />Wakati kuwunli, “Wahandula zwakanaka, thama ikoko, unowhotjila.”<verse eid="LUK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29" />Koga iye ehaka zwilulamisa wakati kuna Yesu, “Mbakidzani wangu ndiyani?”<verse eid="LUK 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30" />Yesu akahandula eti, “Umwe nlume waka ebva kuJerusalema eyenda kuJerikho, akawilana nembava dzikawuntolela zwiyambalo zwizwe zose dzikawunloba, dzikawunsiya ogwilofa. <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />Kukayetika kuti umwe mphirisiti wakapinda nezila iyeyo; wakati ewumbona akanyenyeledza nantome. <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" />NeNlevi bo, wakati epinda napapo, ewumbona akangolinga koga, akapinda nantome. <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" />Koga Nsamariya waka ali mugwendo, wakaswika ipapo akati ewumbona akawuwhila ngoni. <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />Akayenda pawunli akawungudza mabanga, akaahhodza mafuta newayini, akaasunga, akawuntanhisa zomba iye, akayenda naye kun'umba yebezi, akawuyenga. <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />Tjimuka oyenda wakatola maloso mabili edinari akaapa ntjengeti wen'umba yebezi, eti, ‘Yenga nhu iwhoyu, ukahingisa imwe mari pehhugwi kweyandakupa, pandinohanduka ndohha ndikubgwiliza.’ ”<verse eid="LUK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36" />“Ngono unokumbula kuti pabatatu ibaba ndiwupi wakalakidza kuti umbakidzani wenhu waka awilana nembava?”<verse eid="LUK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37" />Wakahandula eti, “Iwhoya wakawuyetila mawhilangoni.”</para>
  <para style="p" vid="LUK 10:37">Yesu akakoti kuwunli, “Yenda unothama sayikoko.”<verse eid="LUK 10:37" /></para>
  <para style="s">Yesu Unokumba Mariya naMaritha</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />Sangwenu bakati beyenda, akangina muyimwe mizi; umwe mfumakadzi waka eyi Maritha akawuwamutjila mun'umba iye. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />Waka ana nun'una unoyi Mariya, wakanogala pedlo naHe ewhilila zwidiyo zwizwe. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />Koga Maritha wakabhatikana nebhika, akayenda kuna Yesu akati, “He, amuna hanya kene kuti nun'una wangu atondibhatsha unondiletja ndibhika ndoga? Muwumbudze andibhatshe.”<verse eid="LUK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41" />Koga He wakawun'handula eti, “Maritha, Maritha, awutagedzikene kakale nodziyidzika nezwinhu zwinjinji; <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />tjin'ompela tjinhu tjinohakika. Mariya wahala tjikamu tjibuyana, tjaasingowhotolegwa itjo.”<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s">Yesu Unodiya Tembezela</para>
  <para style="r">(<ref loc="MAT 6:9-13">Matewu 6.9-13</ref>; <ref loc="MAT 7:7-11">7.7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />Limwe hhuba Yesu waka etembezela ali pagumwe bugalo, akati apedza, umwe webadiyiwa babe wakati, “He, tongotidiyani tembezela, saJohane bo akadiya badiyiwa babe.”<verse eid="LUK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2" />Akaba eti kubali, “Hapa mutembezela, muti.</para>
  <para style="q1" vid="LUK 11:2">“ ‘Tate,</para>
  <para style="q2" vid="LUK 11:2">zina lenyu ngaliyengemadziwe.</para>
  <para style="q2" vid="LUK 11:2">Bumambo gwenyu ngaguhhe.<verse eid="LUK 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3" />Mutipeni zodliwa zwedu zwemisi nemisi,<verse eid="LUK 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4" />mutiyetileni mazwibhatigwa matjinyo edu, ngobe iswi tjekwedu toyetila mazwibhatigwa ibabo bana milandu naswi; musitinginise mukulikwa.’ ”<verse eid="LUK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5" />Kakale wakati kubali, “Ndiyani wenyu unankwinya waanganda kuwunli pakati kwebusiku akaswika kuwunli eti, ‘Nkwinya, undi adzime zwinkwa zwitatu; <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />ngobe kwaswika nkwinya umugwendo, andina kene zodliwa zwandingawumpa’; <verse eid="LUK 11:6" /><verse number="7" style="v" sid="LUK 11:7" />Iye ekohandula ali mukati eti, ‘Usindidziyidze; nkoba wahhaligwa, imi nebana tatjibelele, andingamuke ndikakupa tjinhu’? <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />Ndomubudza kene akalamba muka nentha yekuti unkwinya uwe, koga nentha yekuti unohwelela ekumbila unowhomuka akawumpa tjaanohaka. <verse eid="LUK 11:8" /><verse number="9" style="v" sid="LUK 11:9" />Ndomubudza, kumbilani, mowhopiwa, hakani mowhowana; kokodzani mowhohhuligwa. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />Nhu wose unokumbila unowamutjila, unohaka unowana, newunokokodza unowhohhuligwa. <verse eid="LUK 11:10" /><verse number="11" style="v" sid="LUK 11:11" />Nditate bakatini, pakati kwenyu, bangati mwana wabo ebakumbila whobe, bakawumpa nyoka; <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />kene akati ekumbila bumbulu, ibo bakawuwamutjidza mhani? <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />Hapa imwi ke, babi, muziba pa bana benyu zwipo zwibuya, ngono Tate benyu bakudzimu banowhopa nebunji gungapani Meya Yakayengemala kuna banokumbila!”<verse eid="LUK 11:13" /></para>
  <para style="s">Yesu naBhalazebhule</para>
  <para style="r">(<ref loc="MAT 12:22-30">Matewu 12.22-30</ref>; <ref loc="MRK 3:20-27">Mako 3.20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />Wakati etata meyambi yaka ili mbebebe; meyambi ikati yabhuda, nlume umbebebe akalebeleka, banhu bakatjenama. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />Koga bamwe babo bakati, “Unotata meyambi naBhelezebhule, he wemeyambi.”<verse eid="LUK 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 11:16" />Bamwe, bewunlika, bakahaka tjilakidzilo tjinobva kudzimu, kubva kuwunli. <verse eid="LUK 11:16" /><verse number="17" style="v" sid="LUK 11:17" />Koga iye, eziba mikumbulo yabo wakati kubali, “Bumambo gose gwakathubukana gopalala, nen'ha wakathubukana unokolomoka. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />Ngono hapa kuli kuti Satane bo wakathubukana pakati, bumambo gugwe gungama tjini? Ndoleba nentha yekuti mati ndotata meyambi ndihingisa masimba aBhelezebhule. <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />Kakale hapa imi nditata meyambi ndihingisa Bhelezebhule, bakololo benyu banodzitata behingisa yani? Ndizo banowhoba batongi benyu. <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />Koga hapa kuli lunyala gweNdzimu gwandinohingisa tata meyambi, kobva kuti bumambo gweNdzimu gwatjihha kumuli.”<verse eid="LUK 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21" />“Hapa nlume wakasima, ana mathumo awe ose, edzibilila nzi uwe, nhundu dzidze dzakatjengeteka. <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />Koga hapa kubuya wakasima kuwumpinda ewugwisa akawunkunda, unowuntolela mathumo awe aanogalabgwe, ekokuba fumwa iye yose.”<verse eid="LUK 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23" />“Usi kuntha yangu unogwisana nami, usingakubunganye nami unopaladza.”<verse eid="LUK 11:23" /></para>
  <para style="s">Bgwilila kweMeyambi</para>
  <para style="r">(<ref loc="MAT 12:43-45">Matewu 12.43-45</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />“Hapa meyambi yabhuda munhu, inopalama muhango pasina vula ihaka nyaluluka; iti yakuhaya ikoti, ‘Ndowhobgwilila kun'umba yangu kwandakabva.’ <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />Hapa ibuya inowana n'umba yakatshwayigwa kakale yakabaakanyiwa. <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />Inokotjiyenda inobuya nedzimwe meya dzili kutondeka dzakayipa kuyipinda, dzihha dzingina dzigala mukati; mamo ebupelo enhu iwhoyo anowhoyipa kupinda ekutanga.”<verse eid="LUK 11:26" /></para>
  <para style="s">Hanha Kwelebeswa</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />Atjalebeleka ikoku, umwe nkadzimayi mubunga wakamilidza whi lile akati kuwunli, “Wakakombolegwa ntumbu wakakusenga nehhamu lawakamwa!”<verse eid="LUK 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28" />Koga iye wakati, “Koga bakakombolegwa banowha dama leNdzimu bekolitjengeta!”<verse eid="LUK 11:28" /></para>
  <para style="s">Tjilakidzilo tjaJona</para>
  <para style="r">(<ref loc="MAT 12:38-42">Matewu 12.38-42</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />Kwakati banhu bakubungana nekuwanda, akatangisa leba eti, “Itjetji tjizekugwana tjibi; tjohaka tjilakidzilo, koga akuna tjilakidzilo tjatjinowhopiwa kuhhe kwetjilakidzilo tjaJona. <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />Ngobe saku Jona waka ali tjilakidzilo kubanhu bekuNiniva, Nkololo wenhu unowhoba tjilakidzilo bo kutjizekugwana itjetji. <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" />Mambokadzi wekuBurwa unowhomuka muhhuba letongewa ana tjizekugwana itjetji akatjiwana nlandu; ngobe wakabuya ebva kubupelo gwehango ewhowha butjenjebvu gwaSolomoni, tjikulu pana Solomoni tjipano. <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" />Banhu bekuNiniva banowhohha mbeli muhhuba letongewa bena tjizekugwana itjetji bekatjiwana nlandu; ngobe bakahanduka pakusumikila kwaJona, tjikulu pana Jona tjipano.”<verse eid="LUK 11:32" /></para>
  <para style="s">Tjedza TjeMbili</para>
  <para style="r">(<ref loc="MAT 5:15">Matewu 5.15</ref>; <ref loc="MAT 6:22">6.22</ref>,<ref loc="MAT 6:23">23</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />“Akuna nhu unoti abesedzela tjivoneko ekotjisumbika mun'umba ipasi mumavu kene kusi kwetundu, koga unotjitilika pehhugwi kwetjigadziko kuti unongina abone tjedza. <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />Hhiho lilo litjivoneko tjembili uwo; hapa hhiho lilo lili bhenyu, mbili uwo wose uhhele tjedza; koga hapa lisi bhenyu, mbili uwo wose uhhele hhalima. <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />Ndizo mube nenjele kudze tjedza tjimumuli tjisibve tjiba hhalima. <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />Hapa mbili wose ulihhele tjedza, kusina pana hhalima, wose unopenya, sepenya kwetjivoneko tjinomupa tjedza.”<verse eid="LUK 11:36" /></para>
  <para style="s">Yesu Unolonga Nlandu BaFarisi neBazibi Benlayo</para>
  <para style="r">(<ref loc="MAT 23:1-36">Matewu 23.1-36</ref>; <ref loc="MRK 12:38-40">Mako 12.38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />Akati atjalebeleka umwe Mfarisi akawunkumbila kuti ayende naye kunzi uwe anodla zodliwa; wakayenda akanodla naye. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />Mfarisi iwhoyo wakatjenamisiwa nekuti azotongongula maboko asanhu adla zodliwa. <verse eid="LUK 11:38" /><verse number="39" style="v" sid="LUK 11:39" />Ndizo He wakati kuwunli, “Sangwenu imwi baFarisi mongudza kuhhe kwenkombe nakuhhe kwendilo, koga mukati muhhele kutjebela nebuyipi. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />Imwi zwilengwe! Iye wakayeta kukuhhe atayiye wakayeta kumukati? <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />Koga ipani bahayi ikoku kumukati; kose kowhoba kubuyanana kumuli.”<verse eid="LUK 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42" />“Kwakamubangalalila imwi baFarisi! ngobe modusa tjegumi tjemilibo yenthariyo, inonga minti neruwe neyimwe milibo, koga amuna hanya nendulamo neludo gweNdzimu; yezwi ndizo zwamakafanila thama, musingasiye zwimwe zwisayetiwa.”<verse eid="LUK 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43" />“Kwakamubangalalila imwi baFarisi! ngobe moda zwigalo zwakanaka mumasinagogu, nebuyisiwa nelukudzo munhanga dzetengesela. <verse eid="LUK 11:43" /><verse number="44" style="v" sid="LUK 11:44" />Kwakamubangalalila! ngobe monga zwikumbu zwisingabon'we, banhu banoyenda pehhugwi kwazo basingazibe.”<verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />Umwe webazibi benlayo wakahandula eti, “Ndhiyi, hapa mujalo mobhatisa honi kose naswi bo.”<verse eid="LUK 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46" />Wakati, “Kwakamubangalalila imwi bazibi benlayo bo! nekuti mosengesa banhu mitolo inolema kuyisenga, koga imwi musingayikunhe kene nelunyala gwenyu gun'ompela. <verse eid="LUK 11:46" /><verse number="47" style="v" sid="LUK 11:47" />Kwakamubangalalila, ngobe mobakila zwikumbu zwebalebesambeli bakabulawa nabobatategulu benyu. <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />Kubva kuti mubasupi kakale mobvumilana nezwiyeto zwabobatategulu benyu; ngobe bakababulaya, imwi mobakila zwikumbu zwabo. <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />Ndizo ke Butjenjebvu gweNdzimu gwakati, ‘Ndowhobatumila balebesambeli nebapositoli, bamwe banowhobabulaya bamwe bakabadziyidza,’ <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />kuyetila kuti malopa ebalebesambeli bose, akatebugwa kubva hango ibumbiwa, abhuzwiwe kutjizekugwana itjetji, <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />kubvila kumalopa aAbheli kuswika kumalopa aZakhariya, iye wakafila pakati kwetjibeso tjepisila zwibhayilo nen'umba yethempeli. Ee, ndomubudza, anowhobhuzwiwa kutjizekugwana itjetji.”<verse eid="LUK 11:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52" />“Kwakamubangalalila imwi bazibi benlayo! makadusa tjihhuliso tjeluzibo; mukasangina imwi, mukadzibila ibabo baka bengina.”<verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />Wakati ebva ipapo, bakwali neBaFarisi bakatangisa wundziyidza zwakalema, bewuntanga kudze alebe zwinhu zwinjinji, <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />bakawunteya, kuti bawumbhate muna tjaangaleba.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s">Tjemegwa nekweBatjengeli</para>
  <para style="r">(<ref loc="MAT 10:26">Matewu 10.26</ref>,<ref loc="MAT 10:27">27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />Kwakati kwatjikubungana zwiwulu zwinjinji zwebanhu kwekuti baka botshambana, akatangisa lebeleka nebadiyiwa babe kutanga, eti, “Mutjenjelele mbidzo yebaFarisi, ibutjengeli. <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" />Akuna tjakafumikiwa tjisingowhozumbunugwa, kene tjakasumbikika tjisingowhozibgwa. <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />Ndizo ke kose kwamaleba muhhalima kowhowhakala masikati, kwamanyebezela mun'umba yamukati kowhokalakatiwa pehhugwi kwedzin'umba.”<verse eid="LUK 12:3" /></para>
  <para style="s">Ndiyani Wakafanila Hliwa</para>
  <para style="r">(<ref loc="MAT 10:28-31">Matewu 10.28-31</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />“Ndomubudza, bakwinya bangu, musihle banobulaya mbili, hule kwayikoko kusina tjimwe tjabangathama. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />Koga ndowhomuluma zebe kuti wamakafanila hla ndiyani. Ihlani iye unoti abulaya, akaba nemasimba etola nhu akawumposela kugehena; ee, ndomubudza, muwunhle!”<verse eid="LUK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 12:6" />“Bontiintii zwihanu azwitotengesewa nemapeni mabili? Koga, akuna tjimwe tjazo tjinokanganika mbeli kweNdzimu. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />Ngentha yeni, kene iwo mavudzi emiholo yenyu akabagwa. Musihle, muna tjilemela kupinda bontiintii zwinjinji.”<verse eid="LUK 12:7" /></para>
  <para style="s">Bvuma Nelamba Khirisitu</para>
  <para style="r">(<ref loc="MAT 10:32">Matewu 10.32</ref>,<ref loc="MAT 10:33">33</ref>; <ref loc="MAT 12:32">12.32</ref>; <ref loc="MAT 10:19">10.19</ref>,<ref loc="MAT 10:20">20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />“Ndomubudza, wose nhu unondibvuma mbeli kwebanhu, Nkololo wenhu unowhumbvuma bo mbeli kwebatumwa beNdzimu; <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />Koga unondilamba mbeli kwebanhu unowholambiwa bo mbeli kwebatumwa beNdzimu.”<verse eid="LUK 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 12:10" />“Umwe newumwe unoleba dama linotuka Nkololo wenhu unowhoyetigwa mazwibhatigwa; koga umwe newumwe unoleba etuka Meya Yakayengemala atowhoyetigwa mazwibhatigwa.”<verse eid="LUK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11" />“Hapa bemuyendesa kumasinagogu nekubatongi nekubutungamili, musidziyidzike kuti mowhohandula mutini kene kuti mowholebani; <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />ngobe Meya Yakayengemala inowhomudiya mulubaka igogo kuti mulebe mutini.”<verse eid="LUK 12:12" /></para>
  <para style="s">Tjilakidzilo Tjetjilengwe Tjemfumi</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />Umwe mugubungano wakati kuwunli, “Ndhiyi, budzani nkulu wangu kuti akobane nhaka nami.”<verse eid="LUK 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14" />Akawun'handula eti, “Yenlumewe, ndiyani wakandiyeta kuti ndibentongi nenkobi pehhugwi kwenyu?” <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />Akati kubali, “Whililani, mutjenjelele tjiba; ngobe butjilo gwenhu aguneni nekuti una fumwa njinji kungapani.”<verse eid="LUK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16" />Akababudza tjifananidzo, eti, “Minda yewumwe nlume wakafuma yakaba nezwidlo zwinjinji; <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />akakumbula munkumbulo uwe akati, ‘Ngono nditetjini, nekuti andina matula ebiga zwidlo zwangu?’ <verse eid="LUK 12:17" /><verse number="18" style="v" sid="LUK 12:18" />Eba eti, ‘Ndowhothama ndijali. Ndowhokolomola matula angu ose, ndikabaka amwe makulukulu; hapa ndajalo ndikotjibiga zwidlo zwangu nenhundu dzangu. <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />Ndikotjiti mumeya yangu, Meya, unafumwa njinji inolizana makole manjinji; nyebunuka, udle, un'we, uhanhisise.’ <verse eid="LUK 12:19" /><verse number="20" style="v" sid="LUK 12:20" />Koga Ndzimu wakati kuwunli, ‘Iwe tjilengwe! busiku gwanasi meya iyo inohakika kubva kukuli; ngono zwinhu zose izwezwi zwawabaakanya, zowhobe zwani?’ ”<verse eid="LUK 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21" />“Wakajalo ke nhu unozwikubunganyila fumwa, iye asakafuma kuNdzimu.”<verse eid="LUK 12:21" /></para>
  <para style="s">Galabgwe muNdzimu</para>
  <para style="r">(<ref loc="MAT 6:25-34">Matewu 6.25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />Wakati kubadiyiwa babe, “Ndizo ke ndomubudza, musizwimanikanye nekwebutjilo gwenyu, kuti mowhodlani, kene nekwemibili yenyu muti towhombalani. <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />Ngobe Butjilo gopinda zodliwa, nembili unopinda zwiyambalo. <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />Kumbulani makungubo<note caller="+" style="f"><char style="fr" closed="false">12.24 </char><char style="ft" closed="false">nyunyi inoyi whabayi ne Tjitebele</char></note>. Haatodzwala kene kowha, haana tjidandale kene dula, koga Ndzimu unowapa zodliwa. Tjenyu ke tjilemela tjingapani kupinda tjenyunyi! <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />Ndiyani wenyu angapamhidzila bulefu gwebutjilo gugwe ngekuzwimanikanya? <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />Hapa musingatubule thama tjinhu tjilelulelu sayitjetji, mozwimanikanyilani nekumwe kose? <verse eid="LUK 12:26" /><verse number="27" style="v" sid="LUK 12:27" />Bonani maluba, kuti anokula tjini; haatohinga kene pfuma zwiyambalo; koga ke ndomubudza, kene naSolomoni mugudzo lile lose waka esakambala selin'ompela lawo. <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />Koga hapa Ndzimu embadza buhwa gwehango nayeyi zila gunoti nasi gumuminda gutjila mangwana guposegwa mutjibeso, unowhomumbadza kungapani imwi, banhu bana bugalimoyo gutukununu!<verse eid="LUK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 12:29" />“Musihake kuti mowhodlani kene kuti mowhon'wani, nayiyo mikumbulo yenyu isibe nekudziyidzika. <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />Ngobe njudzi dzose dzehango dzozwihaka zwinhu izwezwi; Tate benyu banoziba kuti mozwihaka. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />Koga ke, imwi hakani bumambo gwabo, izwezwi zwinhu zowhobazwenyu bo.”<verse eid="LUK 12:31" /></para>
  <para style="s">Fumwa iKudzimu</para>
  <para style="r">(<ref loc="MAT 6:19-21">Matewu 6.19-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32" />“Musihle, imwi mhwizi homanana, ngobe whuda kwaTate benyu kuti bamupe bumambo. <verse eid="LUK 12:32" /><verse number="33" style="v" sid="LUK 12:33" />Tengesani zwinhu zwenyu, mupe bahayi; muzwiwanile whomo dzisingahakale, dzefumwa yekudzimu isingame, kusina mbava ingasedzela, kene ntjenje ungapaladza. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />Ngobe pana fumwa iyo, ndipo moyo uwo pawunowhogala uliko bo.”<verse eid="LUK 12:34" /></para>
  <para style="s">Galani Makalindila</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />“Nhunji dzenyu ngadzigale dzakasungwa, nezwivoneko zwenyu ngazwigale zwipfuta, <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" />muthame sebanhu bakalindila he wabo ebva kunzano wepiza bukwe, kuti bawuhhulile tjinyolotjo paanokokodza. <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />Bakakombolegwa balanda banowhowanikwa nahe wabo bakalindila, pabanobuya; lebeswa ndoti kumuli, unowhombala akabagadza pasi, akabapakulila zodliwa. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />Bakakombolegwa balanda ibabo hapa he wabo angabuya pakati kwebusiku kene koyedza, akawana bakajalo! <verse eid="LUK 12:38" /><verse number="39" style="v" sid="LUK 12:39" />Koga zibani whoku, kuti kadzene mweni wenzi waka eziba kuti mbava yaka iwhohha gupi lubaka, waka asingowhosiya nzi uwe kukhwibiwa. <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />Namwi bo galani makazwilulamisa; ngobe Nkololo wenhu unowhohha mulubaka gwamusingakumbulile.”<verse eid="LUK 12:40" /></para>
  <para style="s">Bakagalikabgwe kene Basakagaligabgwe</para>
  <para style="r">(<ref loc="MAT 24:45-51">Matewu 24.45-51</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />Phethiro wakati kuwunli, “He tjifananidzo itjetji motjileba kutili kene moleba kubanhu bose?”<verse eid="LUK 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42" />He wakati, “Ndiwupi ke mbhati wakatjenjela unogalikabgwe, unowhoyi nahe uwe alinge bahingi benzi, kuti abape zodliwa mulubaka gwakafanila? <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />Wakakombolegwa iwhoyo nlanda unowhowanika nahe uwe ethama sayikoku pahanduka kukwe. <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />Lebeswa, ndoti kumuli, unowhowunthama mbhati wezwinhu zose zwaanazo. <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />Koga hapa iwhoyo nlanda angati tjemumoyo, ‘He wangu wanonoka handuka,’ ekotangisa loba balandalume nebalandakadzi, kakale edla en'wa elaladza, <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />he wenlanda iwhoyo unowhohha muhhuba nlanda iwhoyo laasingakumbulile nemulubaka gwaasingazibe, unowhowunloba zwinogwadza, akawunghadza nebasingagalemoyo.”<verse eid="LUK 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47" />“Iwhoyo nlanda waka eziba kuda kwahe uwe, koga akasalulamila kene yeta sekuda kukwe, unowhowamutjila lobgwa kukulu. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />Koga iye waka asingazibe, akayeta kwakafanila lobgwa, unowhowamutjila lobgwa kuhomanana. Umwe newumwe wakapiwa kunjinji, kohakika kunjinji kuwunli; nhu banhu wabanopa kunjinji, banowhohaka bo kunjinji kuwunli.”<verse eid="LUK 12:48" /></para>
  <para style="s">Yesu Mpalalanyi</para>
  <para style="r">(<ref loc="MAT 10:34-36">Matewu 10.34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />“Ndakahhila kuwhoposela moto muhango; ndoyemula kuti dzene wawopfuta! <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" />Ndina bvubikiwa kwandakafanila bvubikiwa nako; ndowha ndakamanikana tjose kudza kunoyetikala. <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />Mokumbula kuti ndahha ndihhisa kunyalala muhango? Akuzojalo, ndomubudza, koga ke ndakahhila whopalalanya; <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />nekuti kubva ngwenuwali mun'umba in'ompela banhu bahanu banowhobe bakapalalana, batatu begwisana nebabili nebabili begwisana nebatatu; <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />banowhothubukana, tate banogwisana nenkololo wabo, nkololo egwisana natatayi, mayi begwisana nenkololokadzi, nkololokadzi egwisana namayi, mezwale begwisana nenlongo, nlongo egwisana namezwale.”<verse eid="LUK 12:53" /></para>
  <para style="s">Whisisa lubaka</para>
  <para style="r">(<ref loc="MAT 16:2-3">Matewu 16.2-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />Wakati kubunga lebanhu, “Hapa mubona gole limilika kunongina hhuba, tjinyolotjo moti, ‘Kohha masusu’; kubva kuyetika. <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />Hapa mubona mhepo inobva kuburwa ihhuhhudza, moti, ‘Kowhopisa kwazo’; kubva kuyetika. <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />Imwi batjengeli! Moziba lingika kwehango nehhuhhugwi; koga ngentha yeni musingatubule pedzisisa lubaka igogu?”<verse eid="LUK 12:56" /></para>
  <para style="s">Lebelesana NeTjita Tjitjo</para>
  <para style="r">(<ref loc="MAT 5:25-26">Matewu 5.25-26</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />“Ngentha yeni musingazwibonele kuti tjakalulama nditjipi? <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />Utjayenda newunokutilika nlandu kuntongi, yedza kuti mubve mayipedza muli muzila, ngobe angakukwebela kuntongi, ntongi akakuyendesa kugombgwa, likokusa mujele. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />Ndokubudza, awutowhobhuda udza ulipa loso lebupelo.”<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s">Handuka Kubva Mumatjinyo Awo Kene Ufe</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />Kwaka kuna bamwe baka balipo nayigogo lubaka bakawumbudza nekwemalopa ebaGalile, Pilatu aakahanganya nezwibhayilo zwabo. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />Akabahandula eti, “Mokumbula kuti banhu bekuGalile ibaba baka bali batjinyi kupinda bamwe bose banhu bekuGalile, ngobe bakagwadzisiwa sayikoku? <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />Ndomubudza, akuzojalo; koga kuhhe kwekuti muhanduke mowhopalala bo sayibo. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />Kene ibabaya bali gumi nehhanakadzi bakawigwa nembako nlefunlefu wekuSilowamu ukababulaya, mokumbula kuti ndibo baka bali batjinyi kupinda banhu bose baka begala muJerusalema? <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />Ndomubudza, akuzojalo; koga kuhhe kwekuti muhanduke mowhopalala bo sayibo.”<verse eid="LUK 13:5" /></para>
  <para style="s">Tjifananidzo tjeNkuyu Usina Zwizwalo</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />Wakaleba kakale tjifananidzo itjetji. “Umwe nlume wakadzwala nkuyu muminda iye yemahhambi; akahha ewhohaka mitjelo akawana nkuyu usina mitjelo. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />Akati kun'hingi, ‘Linga, kwabe makole matatu ndihha ndiwhohola mitjelo yenkuyu iwhoyu, koga ndiwana kusina; uwunteme, unozanisilani mavu?’ <verse eid="LUK 13:7" /><verse number="8" style="v" sid="LUK 13:8" />N'hingi wakawun'handula eti, ‘Muwunletje, tate, gole ileli bo, ndiwun'hakulile ndiwunse mpfudze. <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />Hapa wazwala mitjelo gole linohha, kwakalulama; koga hapa kusakajalo, mungatjiwuntema.’ ”<verse eid="LUK 13:9" /></para>
  <para style="s">Yesu Unotjidza Nkadzimayi Wetjilema Munsi weSabatha</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />Sangwenu waka ediya muyimwe yemasinagogu munsi wesabatha. <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />Kwaka kuna umwe nkadzimayi waka ali tjilema eyetiwa nemeyambi kwemakole gumi nehhanakadzi, waka akakotama, asingatubule tambunuka. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />Yesu wakati ewumbona, akawundhana akati kuwunli, “Nkadzimayi, wasunungugwa mubulema gugo.” <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />Akawumbiga maboko, tjinyolotjo akatambunuka, akalumbidza Ndzimu.<verse eid="LUK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14" />Koga ntungamili wesinagogu, amon'wa nentha yekuti Yesu waka atjidza nhu munsi wesabatha, wakati kubanhu, “Kuna mahhuba matanhatu ehinga; mubuye mumahhuba iyawo muwhopodzewa, koga kusi munsi wesabatha.”<verse eid="LUK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15" />He wakawun'handula eti, “Imwi batjengeli! Umwe newumwe wenyu atosunungula akahhulila n'ombe iye kene kakambe tjitje danga nsi wesabatha, akapamha akanotjin'wisa? <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />Nkadzimayi iwhoyu, ali nkololokadzi wa Abhurahhamu waka akasungwa naSatane kwemakole ali gumi nehhanakadzi, wayesakafanila sunungugwa mubusungwa igogu munsi wesabatha?” <verse eid="LUK 13:16" /><verse number="17" style="v" sid="LUK 13:17" />Atjaleba ikoku, zwita zwizwe zose zwakabhakhwa nehoni; banhu bose bakahanhisiwa nezwinhu zwakanaka zwaakayeta.<verse eid="LUK 13:17" /></para>
  <para style="s">Tjifananidzo Tjemhudzi Yemasitadi</para>
  <para style="r">(<ref loc="MAT 13:31">Matewu 13.31</ref>,<ref loc="MAT 13:32">32</ref>; <ref loc="MRK 4:30-32">Mako 4.30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />Wakakotjiti, “Bumambo gweNdzimu gongani? Kakale ndingagufananisa neni? <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />Gwakafanana nemhudzi yemasitadi yakatogwa newumwe nlume akayidzwala munhiba iye; ikakula ikabe nti, nyunyi dzemumhepo dzikabaka zwihaka munhabi dzawo.”<verse eid="LUK 13:19" /></para>
  <para style="s">Tjifananidzo Tjembidzo</para>
  <para style="r">(<ref loc="MAT 13:33">Matewu 13.33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />Akapamha akati, “Bumambo gweNdzimu ndowhogufananisa neni? <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />Gonga mbidzo mfumakadzi yaakatola akasa muzwilizanyo zwitatu zwebgwisa, zwikadza zwikabila zose.”<verse eid="LUK 13:21" /></para>
  <para style="s">Nkoba Ntukununu</para>
  <para style="r">(<ref loc="MAT 7:13">Matewu 7.13</ref>,<ref loc="MAT 7:14">14</ref>,<ref loc="MAT 7:21-23">21-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />Wakapinda nemumizi-mikulu nemumizana, eyenda ediya, alimugwendo eyenda kuJerusalema. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />Umwe akawumbhuzwa eti, “He, ibabo banowhotjidziwa bahomanana?”</para>
  <para style="p" vid="LUK 13:23">Iye wakati kubali, <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />“Gwisani kuti mungine nenkoba ntukununu; ngobe banjinji, ndomubudza, banowhogwisa ngina koga abatowhotubula. <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" />Hapa batezi ben'umba batjimilika bakahhalila nkoba, mowhotangisa ma kuhhe pankoba mukokodza, muti, ‘He, mutihhulile.’ Banowhomuhandula beti, ‘Anditoziba kwamunobva.’ <verse eid="LUK 13:25" /><verse number="26" style="v" sid="LUK 13:26" />Ndipo pamunowhotangisa muti, ‘Takatidla tin'wa namwi, makamudiya mudzizila dzedu.’ <verse eid="LUK 13:26" /><verse number="27" style="v" sid="LUK 13:27" />Koga banowhoti, ‘Ndomubudza, anditoziba kuti mobva poni; ibvani pandili, imwi mose bahingi bezwakayipa!’ <verse eid="LUK 13:27" /><verse number="28" style="v" sid="LUK 13:28" />Kowhobe nelila nelobanya meno, hapa mobona Abhurahhamu na Isaka naJakobe nebalebesambeli bose bali mubumambo gweNdzimu imwi mutatigwa kuhhe. <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />Banhu banowhobva kubhehhuba nekumahwahhuba, nekubunandzwa nekuburwa, bakagala mubumambo gweNdzimu. <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" />Lingani, bekupedzisila banowhoba bekutanga, bekutanga banowhoba bekupedzisila.”<verse eid="LUK 13:30" /></para>
  <para style="s">Da Jerusalema kwaYesu</para>
  <para style="r">(<ref loc="MAT 23:37-39">Matewu 23.37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />Lubaka igogo bamwe baFarisi bakabuya bakati kuwunli, “Ibva ipapa, ngobe Hherodi unohaka kubulaya.”<verse eid="LUK 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32" />Akati kubali, “Yendani munobudza mhungubgwe iyeya kuti, ‘Ndotata meyambi kakale ndopodza banogwala nasi namangwana, koga muhhuba lebutatu ndopedza n'hingo wangu. <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />Kusineni ndakafanila yenda mugwendo gwangu nasi namangwana nehhuba linotobela; ngobe akungayetikale kuti nlebesambeli afile kuhhe kweJerusalema.’ ”<verse eid="LUK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34" />“Jerusalema, Jerusalema, nobulaya balebesambeli bawunotumigwa ubakhikitidza nemabgwe! ndandingakubunganya bana babo kangana sesetje inokuzwa zwikukwana zwayo kusi kwemaphaphiro ayo, koga iwe usingahake! <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />Linga n'umba iyo labe dongo, ndokubudza, awutjowhondibona udza uti, ‘Wakakombolegwa iye unohha muzina laHe!’ ”<verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s">Yesu Unopodza Nlume Unogwala</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />Umwe nsi wesabatha wakayenda kun'umba yewumwe ntungamili waka ali Mfarisi kunodla zodliwa, baka bakawunlinga. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />Kwaka kuna nlume mbeli kukwe waka akazwimba makumbo nemaboko. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />Yesu wakalebeleka nebazibi benlayo nebaFarisi, eti, “Kumunlayo podza munsi wesabatha, kene aa?”<verse eid="LUK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 14:4" />Koga bakanyalala. Akawuntola akawumpodza, akawunletja akayenda. <verse eid="LUK 14:4" /><verse number="5" style="v" sid="LUK 14:5" />Akaba eti kubali, “Ndiyani pakati kwenyu, una nkololo kene n'ombe ingati yawila mutshime munsi wesabatha, usingowhoyidusa nekulibilidza?”<verse eid="LUK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 14:6" />Abazotubula wun'handula ikoku.<verse eid="LUK 14:6" /></para>
  <para style="s">Zwitebamisa Nebunhu</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />Wakaleba tjifananidzo kubanhu baka bakokewa, paakabona hala kwabo bugalo gupehhugwi, eti kubali, <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" />“Hapa wakokewa kene nayani kunzano wepiza bukwe, usigale mubugalo gupehhugwi, swiyo kwakokewa nlume unokudziwa kupinda iwe, <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />iye wamukoka bubili gwenyu unokohha kukuli eti, ‘Ipa bugalo kunlume whoyu,’ ukomilika wabe nehoni wonogala pabugalo gupasipasi. <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />Koga hapa wakokewa, yenda unogala pabugalo gupasipasi, kuti hapa wakukoka ebuya akoti kukuli, ‘Nkwinya, milika unogala kubugalo gupehhugwi’; ndiko kwawunowhokudziwa pakati kwabo bose bagele nawe. <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" />Wose nhu unozwimilidza unowhotebamisiwa, unozwitebamisa unowhomilidziwa.”<verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />Wakati kuna baka bawunkoka, “Hapa unatjilayilo kene nzano, usikoke bakwinya babo kene hama dzidzo kene beludzi gugo kene babakidzani babo bakafuma, swiyo bangakokukoka bo, ukakobgwiliziwa zwawabapa. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />Koga hapa unanzano koka bahayi, nezwilema, nebanohudza, nemapofu. <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />Nowhokombolegwa ngobe abatotubula kubgwiliza. Koga nowhobgwiliziwa muhhuba lemuka kwebakalulama.”<verse eid="LUK 14:14" /></para>
  <para style="s">Tjifananidzo TjeNzano Nkulu</para>
  <para style="r">(<ref loc="MAT 22:1-10">Matewu 22.1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />Umwe waka aligele ipapo pazodliwa ewha zwinhu izwezwi wakati kuwunli, “Wakakombolegwa nhu unowhodla tjinkwa mubumambo gweNdzimu!”<verse eid="LUK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16" />Koga Yesu wakati kuwunli, “Umwe nhu wakathama nzano nkulu, akakoka banhu banjinji; <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />akatuma nlanda uwe lubaka gwenzano gwatjiswika kuti anoti kubanhu baaka akoka, ‘Tjihhani kose kwalulama.’ <verse eid="LUK 14:17" /><verse number="18" style="v" sid="LUK 14:18" />Koga bose bakakumbila mazwibhatigwa, wekutanga wakati, ‘Ndatenga minda, nditjatongonoyibona; ndokumbila undiyetile mazwibhatigwa.’ <verse eid="LUK 14:18" /><verse number="19" style="v" sid="LUK 14:19" />Umwe akati, ‘Ndatenga n'ombe dzili gumi dzinolima, ndohaka nodzibona; ndokumbila undiyetile mazwibhatigwa.’ <verse eid="LUK 14:19" /><verse number="20" style="v" sid="LUK 14:20" />Umwe akati, ‘Ndatola nkadzi, ndizo andingatubule hha.’ <verse eid="LUK 14:20" /><verse number="21" style="v" sid="LUK 14:21" />Nlanda wakahanduka akalakidza he uwe kose ikoku. Mweni wenzi akamon'wa akati kunlanda, ‘Libilidza uyende mudzizila nemuzidlana dzenzi-nkulu ukoke bahayi nebanohudza nemapofu kose nezwilema, ubuye nabo.’ <verse eid="LUK 14:21" /><verse number="22" style="v" sid="LUK 14:22" />Nekulibilidza nlanda wakati, ‘Tate tjamatilaya tjayetiwa koga kutjina bugalo mun'umba.’ <verse eid="LUK 14:22" /><verse number="23" style="v" sid="LUK 14:23" />He wakati kunlanda, ‘Yenda mumagubhule, nemudziwhuta, mutetedze banhu kuti babuye, n'umba yangu ihhale. <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />Ngobe ndomubudza, akuna umwe webalume ibaba bandakakoka unowholabila zodliwa zwangu.’ ”<verse eid="LUK 14:24" /></para>
  <para style="s">Ntengo Kuti Ubendhiyiwa</para>
  <para style="r">(<ref loc="MAT 10:37">Matewu 10.37</ref>,<ref loc="MAT 10:38">38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />Makubungano makulukulu akayenda naye; iye wakatjebuka akati, <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" />“Hapa nhu ehha kundili, asingaheme tatayi kene mayi, kene nkadzi uwe nebana babe, bakulu babe nebanun'una kene hazwadzi dzidze, ee, kene butjilo gugwe, haangabe ndhiyiwa wangu. <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" />Kene yani usingasenge tjileyanyo tjitje akanditobela, haangabe ndhiyiwa wangu. <verse eid="LUK 14:27" /><verse number="28" style="v" sid="LUK 14:28" />Ndiyani pakati kwenyu unoti eyemula baka dumba lefulefu lebalindi, akasatanga negala pasi elinga kuti kowundlila bungana, nekuti unanlipo wakalizana kuti ayipedze? <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />Hapa atjiyibamba, asingatjatubule yipedza, bose banoyibona banotangisa wunseka, <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />beti, ‘Nlume iwhoyu wakatangisa baka akasatubula pedza.’ <verse eid="LUK 14:30" /><verse number="31" style="v" sid="LUK 14:31" />Kene ndiyani mambo, unoti enogwa newumwe mambo, akasitange agala pasi akabhuzwa kuti nebagwi bali zwiwulu zwili gumi angatubula gwisana newunohha nezwiwulu zwili makumi mabili ehanganidzana naye? <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />Hapa kusakajalo, unoti atjikulekule, akatumila bamilili benokumbila kunyalala. <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />Ndizo ke, kene yani pakati kwenyu usingasiye kose kwaanako haangabe ndhiyiwa wangu.”<verse eid="LUK 14:33" /></para>
  <para style="s">Munyu Usitjina n'hingo</para>
  <para style="r">(<ref loc="MAT 5:13">Matewu 5.13</ref>; <ref loc="MRK 9:50">Mako 9.50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />“Munyu wakanaka; koga hapa walahikigwa nebumunyu gwawo, bumunyu gwawo gungamusidzigwa tjini wali? <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />Unobe usakatjifanila mavu kene pakabutitikiwa mpfudze; banhu banowunlaha. Una zebe dzewha, ngaawhe.”<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s">Mhwizi Yakalahika</para>
  <para style="r">(<ref loc="MAT 18:12-14">Matewu 18.12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />Sangwenu baketisi nebatjinyi bakabesedzela bose kuti bawuwhe. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />Bafarisi nebakwali bakan'un'urika, beti, “Nlume iwhoyu unowamutjila batjinyi kakale unodla nabo.”<verse eid="LUK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3" />Ndizo wakababudza tjifananidzo itjetji eti. <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" />“Ndiyani wenyu ungati ana mhwizi dzili gulu, kukalahika in'ompela usingawhosiya dzimwe dzili makumi ali hhanalume nehhanalume mutjilambanyika, enohaka in'ompela yakalahika, akadza akayiwana? <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />Hapa ayiwana unoyitola, nekuhanha kukulu, eyisa pamapfudzi awe. <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />Unoti aswika kanyi, akadana bakwinya babe nebabakidzani babe, eti kubali, ‘Hanhani nami ngobe mhwizi yangu yayakalahika ndayiwana.’ <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />Sayikoku bo, ndomubudza, kowhobe nekuhanha kunjinji kudzimu nentha yentjinyi un'ompela unohanduka kupinda makumi ali hhanalume nehhanalume ebakalulama basingatjowhohakika kuti bahanduke.”<verse eid="LUK 15:7" /></para>
  <para style="s">Loso Lakalahika</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />“Kene nkadzimayi, una mari yemaloso esiliva ali gumi, hapa alahikigwa nelin'ompela, atopfutisa tjivoneko ekotshwayila n'umba, akadza akaliwana? <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />Unoti aliwana akadana bakwinya babe, nebabakidzani babe panhu pan'ompela, eti, ‘Hanhani nami, ngobe loso langu laka lalahika ndaliwana.’ <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />Sayikoku ke, ndomubudza, kuna kuhanha kubatumwa beNdzimu hapa ntjinyi un'ompela ahanduka.”<verse eid="LUK 15:10" /></para>
  <para style="s">Nkololo Wakalahika</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />Wakati, “Kwaka kuna umwe nlume waka anabakololo babili; <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />ntukunu wakati kuna tatayi, ‘Tate, mundipe gobe langu lefumwa.’ Tatayi baka bakobela fumwa yabo. <verse eid="LUK 15:12" /><verse number="13" style="v" sid="LUK 15:13" />Hule kwemahhuba asimangana, nkololo ntukunu wakakuba kose kwaaka anako, akayenda kuhango ikulekule, akanozanisa fumwa iye ngebutjilo gusina mazwibhato. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />Akati apedza kose, kukabe nehhala whuluwhulu muhango iyeyo, akatangisa dziyila. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />Wakahaka n'hingo kuwumwe nghali wehango iyeyo, akawuyendesa kuminda kuti abe epa whotji dzidze zodliwa. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />Akayemula dlazwe kuba tjaka tjidliwa newhotji; akuna nhu wakawumpa zodliwa. <verse eid="LUK 15:16" /><verse number="17" style="v" sid="LUK 15:17" />Koga wakati ahhigwa nenkumbulo wakatambunuka akati tjemumoyo, ‘Kuna balanda bangana banohingila tate bangu banodla kumwe belaha, koga imi ipapa ndifa nehhala! <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />Ndowhomilika ndikayenda kuna tate bangu, ndikaswika nditi kubali, “Tate, ndakatjinyila kudzimu kose namwi; <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />Andizotjafanila dan'wa ndiyi nkololo wenyu, mundibhate sewumwe webalanda benyu.” ’ <verse eid="LUK 15:19" /><verse number="20" style="v" sid="LUK 15:20" />Wakamilika akayenda kuna tate babe.”</para>
  <para style="p" vid="LUK 15:20">“Koga etji nhambo nyana kuswika kunzi, tate babe bakawumbona, bakawuwhila ngoni, bakalabuka bakawunghumbatila bakawuputa. <verse eid="LUK 15:20" /><verse number="21" style="v" sid="LUK 15:21" />Nkololo wakati kubali, ‘Tate, ndakatjinyila kudzimu kose namwi; andizotjafanila dan'wa ndiyi nkololo wenyu.’ <verse eid="LUK 15:21" /><verse number="22" style="v" sid="LUK 15:22" />Koga tatayi bakati kubalanda babo, ‘Libilidzani muhhise tjiyambalo tjilefu tjakanakisisa, muwumbadze; muse rin'i muluboko gugwe, nehangu mumakumbo awe; <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />buyani negondolo lakakola mulibulaye, tidle tihanhe; <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />ngobe nkololo wangu iwhoyu waka akafa, weetjila kakale; waka alahika, wawanika.’ Nzano ukatangisa.”<verse eid="LUK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />“Sangwenu nkololo whola waka ali kuminda; wakati asedzela pedlo nenzi, akawha kumbiwa kuzaniwa. <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />Akadana umwe webalanda akabhuzwa kuti koyetikani. <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />Akawun'handula eti, ‘Nun'una wenyu wabuya, tate benyu babulaya gondolo lakakola, ngobe bawuwamutjila akatjengeteka alimbuyanana.’ <verse eid="LUK 15:27" /><verse number="28" style="v" sid="LUK 15:28" />Koga iye wakamon'wa akasada ngina munzi. Tate babe bakabhuda bakawuntetedza, <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />koga wakahandula tate babe eti, ‘Lingani, makole manjinji ose iyawa ndimuhingila, andizotongolamba tjamandilaya; koga amuzotongondipa kene tjibudzana, kuti ndihanhe nebakwinya bangu. <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />Koga iwhoyu nkololo wenyu wati abuya, iye wakazanisa fumwa yenyu nemhombwe, mawumbulayila gondolo lakakola!’ <verse eid="LUK 15:30" /><verse number="31" style="v" sid="LUK 15:31" />Bakati kuwunli, ‘Nkololo unogala unami, kose kwangu ndekuko. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />Kwakwakafanila kuti tihanhe tizane, ngobe whoyu nun'una uwo waakafa, ngono weetjila; waakalahika, koga wawanika.’ ”<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s">Tjifananidzo Tjentjengeti Wakatjenjela</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />Wakati kubadiyiwa babe, “Kwaka kuna umwe nlume wakafuma waka ana ntjengeti wefumwa iye, kukahhisiwa matama kuwunli kuti nlume iwhoyo unozanisa kakale unopaladza fumwa iye. <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />Wakadana ntjengeti iwhoyo akati kuwunli, ‘Ini ikoku kwandinowha nekuko? Hhisa ndongoloso yehinga kuko, ngobe awungatjabe ntjengeti.’ <verse eid="LUK 16:2" /><verse number="3" style="v" sid="LUK 16:3" />Ntjengeti iwhoyo wakati munkumbulo uwe, ‘Ndowhothamani, saku he wangu onditolela butjengeti? Andina masimba etsha, kakale ndina honi dzeyenda ndikumbila. <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />Ndakumbula kuti ndowhothamani, hapa ndatakhwa n'hingo kuti banhu bandiwamutjile mun'umba dzabo.’ <verse eid="LUK 16:4" /><verse number="5" style="v" sid="LUK 16:5" />Ndizo, akadana bose baka bana zwikwelete zwahe uwe, akati kuna wekutanga, ‘Kwelete tjitjo tjingapani kuna he wangu?’ <verse eid="LUK 16:5" /><verse number="6" style="v" sid="LUK 16:6" />Wakati, ‘Gulu lezwiyelo zwemafuta.’ Akaba eti kuwunli, ‘Tola lukwalo gwekwelete tjitjo, ugale pasi nekulibilidza ukwale makumi mahanu.’ <verse eid="LUK 16:6" /><verse number="7" style="v" sid="LUK 16:7" />Kuwumwe wakati, ‘Unakwelete tjingapani?’ akati, ‘Gulu lezwiyelo zwezwidlo.’ Akati kuwunli, ‘Tola lukwalo gwekwelete tjitjo, ukwale makumi ali hhanakadzi.’ <verse eid="LUK 16:7" /><verse number="8" style="v" sid="LUK 16:8" />He wakalumbidza ntjengeti usakalulama ngentha yebutjenjebvu gugwe; ngobe bakololo behango ino bakatjenjelela hingidzana netjizekugwana tjabo kupinda bakololo betjedza.”<verse eid="LUK 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9" />Yesu wakayendilambeli eti, “Ndomubudza, hingisani fumwa yehango ino isakalulama kuti muzwithamile bakwinya, kuyetila kuti payinopela bamuwamutjile kubugalo gusingapele. <verse eid="LUK 16:9" /><verse number="10" style="v" sid="LUK 16:10" />Unogalikabgwe mukuhomanana nemukunjinji bo unogalikabgwe, usingagalikebgwe mukuhomanana nemukunjinji bo haatogalikabgwe. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />Hapa mamusinga galikemoyo nefumwa yehango iyeyi isakalulama, ndiyani ungamugalabgwe akamupa fumwa yemalebeswa? <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />Hapa mamusingagalikebgwe nekwebamwe, ndiyani unowhomupa kwenyu?”<verse eid="LUK 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13" />“Akuna nlanda ungahingila bohe babili; ngobe angada umwe akahema umwe, kene unowhozwipila kuwumwe akalingila umwe pasi. Amungahingile Ndzimu kose nemari.”<verse eid="LUK 16:13" /></para>
  <para style="s">Zwimwe Zwilebo zwaYesu</para>
  <para style="r">(<ref loc="MAT 11:12">Matewu 11.12</ref>,<ref loc="MAT 11:13">13</ref>; <ref loc="MAT 5:31">5.31</ref>,<ref loc="MAT 5:32">32</ref>; <ref loc="MRK 10:11">Mako 10.11</ref>,<ref loc="MRK 10:12">12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />Bafarisi, bakabeda mari, pabakawha ikoku, bakawunkejula. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />Koga wakati kubali, “Muyibabo banozwilulamisa mbeli kwebanhu, koga Ndzimu unoziba mimoyo yenyu, ngobe tjinokudziwa pakati kwebanhu tjohemesa pabuso gweNdzimu.”<verse eid="LUK 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16" />“Nlayo nebalebesambeli kwakabepo kudza kuwhoswika Johane; kubvila ipapo ndebo mbuya yebumambo gweNdzimu inosumikigwa, kakale umwe newumwe unongina muguli ngemasimba. <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" />Koga kulelu kuti kudzimu nehango kupinde, pana kuti kutukununu kumunlayo kuhaye n'hingo.”<verse eid="LUK 16:17" /></para>
  <para style="s">Lambana Kwebakatolana</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />“Umwe newumwe unolambana nenkadzi uwe ekotola umwe unothama bupombgwe, nayiwhoyo unotola nkadzi wakalambana nenlume unothama bupombgwe.”<verse eid="LUK 16:18" /></para>
  <para style="s">Nlume Wakafuma naLazaro</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />“Kwaka kuna umwe nlume wakafuma, ana zwiyambalo zwembala welubende zwakanaka zwejila lelineni egala edla zwinozipa mahhuba ose. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />Pankoba uwe kwaka kuna umwe n'hayi unoyi Lazaro, waka alihhele malonda, <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />Lazaro waka eyemula dla zwinowa pathebuli yemfumi; pehhugwi kwayikoko nembgwa dzaka dzihha dzinazwa malonda awe. <verse eid="LUK 16:21" /><verse number="22" style="v" sid="LUK 16:22" />N'hayi iwhoyo wakati afa batumwa bekudzimu bakawunsengela kufuba tja Abhurahhamu. Mfumi wakafa bo akabiganyiwa; <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />akati ali kuHhedesi, ali mukudziyila, wakamilidza meho awe, akabona Abhurahhamu alikulekule, naLazaro ali pafuba tjitje. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />Akadanilila eti, ‘Tate Abhurahhamu, mundiwhile ngoni, tumani Lazaro abvubike lunyala gugwe muvula andidonedzele atonhodze lulimi gwangu; ngobe ndogwadziwa mumoto iwhoyu.’ <verse eid="LUK 16:24" /><verse number="25" style="v" sid="LUK 16:25" />Koga Abhurahhamu wakati, ‘Nkololo, kumbula lubaka gwebutjilo gugo wakawamutjila zwinhu zwakanaka, Lazaro bo wakawamutjila zwinhu zwakayipa; koga sangwenu weenyaladziwa pano, iwe weegwadziwa. <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />Kuhhe kwayikoku kose, pakati kwedu nawe kuna gomba gulugulu liyapo, kuti bangabva ngeno behha kukuli basitubule, kakale kusibe newunobva ikoko ehha kutili.’ <verse eid="LUK 16:26" /><verse number="27" style="v" sid="LUK 16:27" />Eba eti, ‘Ngono ndomukumbilisisa, tate, muwuntume kun'umba yatate bangu, <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />ngobe ndina bakololo batate bangu bahanu, anobazibisa, bangakohha kubugalo igogu gwegwadziwa.’ <verse eid="LUK 16:28" /><verse number="29" style="v" sid="LUK 16:29" />Koga Abhurahhamu wakati, ‘Bana Mozisi nebalebesambeli; ngababawhilile.’ <verse eid="LUK 16:29" /><verse number="30" style="v" sid="LUK 16:30" />Wakahandula akati, ‘A a, tate Abhurahhamu; koga hapa kungayenda kubali nhu wabva kubafi, banowhohanduka.’ <verse eid="LUK 16:30" /><verse number="31" style="v" sid="LUK 16:31" />Wakati kuwunli, ‘Hapa basingawhilile Mozisi nebalebesambeli, nekutobe kukamuka umwe kubafi akungabakuludzile kuti bawhilile bahanduke.’ ”<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s">Jinyo</para>
  <para style="r">(<ref loc="MAT 18:6">Matewu 18.6</ref>,<ref loc="MAT 18:7">7</ref>,<ref loc="MAT 18:21">21</ref>,<ref loc="MAT 18:22">22</ref>; <ref loc="MRK 9:42">Mako 9.42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />Wakati kubadiyiwa babe, “Zwiliko zwinota kuti mutjinye zowhobuya; koga kwakawubangalalila iwhoyo unozwilesi! <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />Kwakowhoba kuhine kuwunli kuti asungiligwe gwiyilo muntshibha uwe ekoposegwa mugungwa, pana kuti athame kuti umwe webatjetjana ibaba atjinye. <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" />Mutjenjele mube nenjele!”</para>
  <para style="p" vid="LUK 17:3">“Hapa hama iyo itjinya uyitjemele, ikahanduka uyiyetile mazwibhatigwa; <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />kakale hapa ekutjinyila kunoswika kutondeka pahhuba, ebuya kakale kukuli kunoswika kutondeka eti, ‘Ndozwisola,’ uwuyetile mazwibhatigwa.”<verse eid="LUK 17:4" /></para>
  <para style="s">Bugalibgwe</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />Bapositoli bakati kuna He, “Pamhidzilani bugalimoyo gwedu.”<verse eid="LUK 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6" />He wakahandula eti, “Kadzene mamuna bugalimoyo gunolizana nemhudzi yemasitadi, mamowhotubula kuti muti kuntungulu iwhoyu, ‘Sipuka unodzikigwa mugungwa,’ ntungulu wawhoomuwhilila.”<verse eid="LUK 17:6" /></para>
  <para style="s">N'hingo weNlanda</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />“Uyapo pakati kwenyu, unanlanda unolima kene unolisa mhwizi, angati kuwunli hapa abuya ebva kuminda, ‘Gala pasi udle zodliwa’? <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />Koga haangati kuwunli, ‘Undiyetile tjilayilo, umbale zwakanaka undipakulile, undimilile ndidle ndin'we; ukotjiti iwe wodla won'wa’? <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />Akuzofanila kuti nlanda abokegwe tobela nlayo? <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />Ndizo namwibo bo, hapa mathama kose kwamalayiwa kuti mukuthame, muti, ‘Tibalanda basibatjimwe; tathama n'hingo wedu watakafanila thama.’ ”<verse eid="LUK 17:10" /></para>
  <para style="s">Yesu Unopodza Banhu Baligumi</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />Wakati alimuzila eyenda kuJerusalema akapalama pakati kweSamariya neGalile. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />Wakati engina muwumwe nzi akahanganidziwa nebamwe balume bali gumi, baka bana bugwele gwemapele, bakama kulenyana naye. <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />Bakamimila beti, “Yesu, He, mutiwhile ngoni.”<verse eid="LUK 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14" />Wakati ebabona akati kubali, “Yendani munozwilakidza kubaphirisiti.”</para>
  <para style="p" vid="LUK 17:14">Bakati betjimuzila betjayenda bakabva bapola. <verse eid="LUK 17:14" /><verse number="15" style="v" sid="LUK 17:15" />Umwe wabo wakati ebona kuti wapola, akabgwilila hule, elumbidza Ndzimu newhi lipehhugwi; <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />wakaswika akawila pasi mbeli kwaYesu akaboka kwazo. Waka ali Nsamariya. <verse eid="LUK 17:16" /><verse number="17" style="v" sid="LUK 17:17" />Yesu wakati, “Banhu batjenesewa babesi gumi? Bamwe bali hhanalume baponi? <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />Kwahayika wahanduka ewholumbidza Ndzimu kuhhe kwentaya iwhoyu?” <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />Wakati kuwunli, “Milika uyendezo, bugalimoyo gugo gwakutjidza.”<verse eid="LUK 17:19" /></para>
  <para style="s">Buya kweBumambo</para>
  <para style="r">(<ref loc="MAT 24:23-28">Matewu 24.23-28</ref>,<ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />Wakabhuzwiwa nebaFarisi kuti bumambo gweNdzimu gowhohha lini, akahandula eti, “Bumambo gweNdzimu agutohha nezila inoboneka; <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />akuna nebanowhoti, ‘Linga, whogogu!’ kene, ‘Whoguyaa!’ ngobe bumambo gweNdzimu gumukati kwenyu.”<verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />Wakakoti kubadiyiwa, “Kowhoswika lubaka gwekuti mowhoyemula bona limwe lemahhuba eNkololo wenhu, koga amutowholibona. <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />Banowhoti kumuli, ‘Lingani, whoguyaa!’ kene, ‘Lingani, guyipapa!’ Musiyende ko, musibatobele. <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />Sevula inopenya ibayima mumakole, ibvila kuyimwe ntha inoti kuyimwe ntha, Nkololo wenhu unowhojalo bo muhhuba lile. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />Koga wakafanila tanga adziyidzika kwazo kwazo kakale alandugwa netjizekugwana itjetji. <verse eid="LUK 17:25" /><verse number="26" style="v" sid="LUK 17:26" />Sekwakwaka kuli iko mumahhuba aNowa, kowhojalo bo mumahhuba eNkololo wenhu. <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />Bakabedla, ben'wa, belobola, belobogwa, kudza kuswika hhuba lakangina Nowa mukepe, nkubila ukahha ubulaya bose. <verse eid="LUK 17:27" /><verse number="28" style="v" sid="LUK 17:28" />Sekwakwakayetika mulubaka gwaLoti, bakabedla, ben'wa, betenga, betengesa, bedzwala, bebaka, <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />koga hhuba lakabhuda Loti muSodoma moto nesalifa kwakatebuka kubva kudzimu, kukapaladza zwinhu zose. <verse eid="LUK 17:29" /><verse number="30" style="v" sid="LUK 17:30" />Kowhojalo bo muhhuba Nkololo wenhu laanowhobonakala.”<verse eid="LUK 17:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 17:31" />“Muhhuba ilelo, iwhoyo unoba ali kutjilungwane, nhundu dzidze dzili mun'umba, asijite kuti adzitole; ne unoba ali kuminda bo asihanduke ewhobona zwihule. <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />Mukumbule nkadzi waLoti. <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" />Unohaka londolodza butjilo gugwe gowhunlahikila, koga unolahikigwa nebutjilo gugwe unowhogutjengetedza. <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />Ndomubudza, muna igogo busiku babili banowhobe balilele panhobo in'ompela; umwe unowhotogwa umwe akasala. <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />Bakadzimayi babili banowhoba bekhwa; kowhotogwa un'ompela umwe akasiyiwa.” <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />(Balume babili banowhobe bali muminda; umwe unowhotogwa umwe akasiyiwa.)<verse eid="LUK 17:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37" />Bakawun'handula nembhuzo beti, “Poni, He?”</para>
  <para style="p" vid="LUK 17:37">Iye eba eti kubali, “Ipapo panambili wetjinhu tjakafa magola ndipo paanowhokubungana.”<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s">Tjifananidzo tjeTjilikadzi neNtongi</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />Wakababudza tjifananidzo, tjebadiya kuti batembezele tjoselele basitongonyala moyo. <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />Wakati, “Muwumwe nzi-nkulu kwaka kuna ntongi waka asingahle Ndzimu kakale asina mazwibhato kunhu. <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />Kwaka kuna tjilikadzi munzi-nkulu iwhoyo, yaka igala ihha kuwunli, iti, ‘Mundigwile kutjita tjangu.’ <verse eid="LUK 18:3" /><verse number="4" style="v" sid="LUK 18:4" />Wakalamba kwelubaka gulefulefu, koga hule wakakoti mumoyo uwe, ‘Kene zwangu ndisingahle Ndzimu kene ndisina mazwibhato kunhu, <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />koga nentha yekuti tjilikadzi iyeyi inondisilinga, ndowhotonga ndebo yayo, kuyetila kuti ndisinyale neholela hha kukwe.’ ”<verse eid="LUK 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6" />He wakakotjiti, “Iwhani kuti ntongi mbi unotini. <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />Ngono Ndzimu haatowhopa ndulamilo kubahalugwa babe, banolila kuwunli siku nesikati? Angabanonokela? <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />Ndomubudza, unowhobapa ndulamilo nekulibilidza. Koga Nkololo wenhu unowhowana bugalimoyo muhango pakubuya kukwe kene?”<verse eid="LUK 18:8" /></para>
  <para style="s">Tjifananidzo tjeMfarisi neNketisi</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />Wakabudza bamwe banhu baka bezwigalabgwe kuti bakalulama kakale belingila pasi bamwe tjifananidzo itjetji. <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />“Balume babili bakayenda benotembezela kuthempeli, umwe wakaali Mfarisi umwe ali nketisi. <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" />Mfarisi wakama yega akatembezela eti, ‘Ndzimu, ndomuboka ngentha yekuti anditonga bamwe banhu, batjebeli, basakalulama, mhombgwe, kene sayiwhoyu nketisi. <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />Ndoyila zodliwa kabili patshipi, muna kose kwandinowana ndodusa tjegumi.’ <verse eid="LUK 18:12" /><verse number="13" style="v" sid="LUK 18:13" />Koga nketisi, alimile kule nyana, asingake akamilidzila meho awe kudzimu, koga akakotamisa n'holo, wakatembezela eti, ‘Ndzimu, mundiwhile ngoni imi ntjinyi!’ <verse eid="LUK 18:13" /><verse number="14" style="v" sid="LUK 18:14" />Ndomubudza, nlume iwhoyu wakabgwilila kunzi uwe alulamisiwa kupinda Mfarisi, ngobe wose nhu unozwimilidza unowhotebamisiwa, koga unozwitebamisa unowhomilidziwa.”<verse eid="LUK 18:14" /></para>
  <para style="s">Yesu Unokombolela Bana Batjetjana</para>
  <para style="r">(<ref loc="MAT 19:13-15">Matewu 19.13-15</ref>; <ref loc="MRK 10:13-16">Mako 10.13-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />Baka bolezi kose nebana batjambozwagwa kuwunli kuti ababige maboko; koga badiyiwa bakati bekubona ikoku baka batjemela. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />Koga Yesu wakabadana, akati, “Letjani bana bahhe kundili musibadzibise; ngobe bumambo gweNdzimu ndegwebakajali. <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />Lebeswa ndoti kumuli, kene yani usingowhowamutjila bumambo gweNdzimu semwana ntjetjana aatowhogungina.”<verse eid="LUK 18:17" /></para>
  <para style="s">Ntungamili Wakafuma</para>
  <para style="r">(<ref loc="MAT 19:16-30">Matewu 19.16-30</ref>; <ref loc="MRK 10:17-31">Mako 10.17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />Umwe ntungamili wakawumbhuzwa, eti, “Ndhiyi mbuya, ndithameni kudze ndiwamutjile butjilo gusingapele?”<verse eid="LUK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19" />Yesu wakati kuwunli, “Nentha yeni unditi ndimbuya? Akuna umbuya kuhhe kweNdzimu yega. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />Unowhisisa milayo. ‘Usite bupombgwe, Usibulaye, Usikwibe, Usipe busupi gwemanyepwa, Lemekedza tate babo nameyabo.’ ”<verse eid="LUK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21" />Wakahandula eti, “Yose iyeyi ndakayitobela kubvila nditjintjetjana.”<verse eid="LUK 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22" />Yesu paakawha n'handulo iye, wakati kuwunli, “Unotayila netjinhu tjin'ompela. Tengesa kose kwawunako ukobele bahayi ntengo wako, unowhobe nefumwa kudzimu; ukotjihha, unditobele.” <verse eid="LUK 18:22" /><verse number="23" style="v" sid="LUK 18:23" />Wakati ewha matama iyawa akangin'wa nebuyendasi, ngobe waka akafuma kwazo.<verse eid="LUK 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24" />Yesu ewunlinga wakati, “Kolema kwazo seni kuti ibabo banafumwa bangine mubumambo gweNdzimu! <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />Kulelulelu kuti kamela lipalame muhuli yelunji, pana kuti mfumi angine mubumambo gweNdzimu.”<verse eid="LUK 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26" />Ibabo bakawha matama iyawa bakati, “Ngono ndiyani ungatjidziwa?”<verse eid="LUK 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27" />Koga Yesu wakati, “Zwisingayetike ngebanhu zoyetika ngeNdzimu.”<verse eid="LUK 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28" />Phethiro eba eti, “Bonani, iswi takasiya kose tikatobela imwi.”<verse eid="LUK 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29" />Yesu eba eti kubali, “Lebeswa, ndoti kumuli, akuna nhu wakasiya n'ha uwe kene nkadzi uwe kene bakuluyi kene banun'una kene bazwadzi kene bana ngentha yebumambo gweNdzimu, <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />usingowhowamutjila kwakapamhidzigwa kanjinji mulubaka igogu nebutjilo gusingapele mutjibaka tjinohha.”<verse eid="LUK 18:30" /></para>
  <para style="s">Yesu Unolebesambeli Gwebutatu Nekwelufu Gugwe</para>
  <para style="r">(<ref loc="MAT 20:17-19">Matewu 20.17-19</ref>; <ref loc="MRK 10:32-34">Mako 10.32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />Yesu wakatola bali gumi nebabili, akati kubali, “Whililani! toyenda kuJerusalema, kowhonohhadzisika kose kwakakwagwa nebalebesambeli nekweNkololo wenhu. <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />Ngobe unowhotugwa mumaboko eBataya, unowhokuwelegwa, akabhakhwa zwakayipa kakale akapfigwa mate; <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />banowhowunsukuta bakawumbulaya, koga muhhuba lebutatu unowhomuka.”<verse eid="LUK 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34" />Koga akuna tjayizwezwi zwunhu tjabakawhisisa; matama iyawa aka akasumbikika kubali, abazotongoziba tjaka tjilebgwa.<verse eid="LUK 18:34" /></para>
  <para style="s">Yesu Unopodza Bhofu Lakalitjila Nekumbila</para>
  <para style="r">(<ref loc="MAT 20:29-34">Matewu 20.29-34</ref>; <ref loc="MRK 10:46-52">Mako 10.46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />Kwakayetika kuti atjibe pedlo neJerikho, umwe nlume webhofu waka aligele ntome kwezila ekumbila; <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />ewha bunga liyenda ntome kukwe, wakabhuzwa kuti koyetikani.<verse eid="LUK 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 18:37" />Bakawumbudza beti, “Yesu wekuNazaretha unopinda ipapa.”<verse eid="LUK 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38" />Wakamimila eti, “Yesu, Nkololo waDavida, mundiwhile ngoni.”<verse eid="LUK 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39" />Baka balimbeli bakawuntjemela beti ngaanyalale; koga iye wakamimila newhi lipehhugwi, eti, “Nkololo waDavida mundiwhile ngoni!”<verse eid="LUK 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40" />Ndizo Yesu wakama, akalaya kuti ahhisiwe kuwunli; wakati atjibe pawunli akawumbhuzwa, eti, <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />“Unohaka kuti ndikuyetileni?”</para>
  <para style="p" vid="LUK 18:41">Iye wakahandula eti, “He, ndohaka kuti ndibone kakale.”<verse eid="LUK 18:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42" />Yesu wakati kuwunli, “Bona; galamoyo kuko kwakuthama ukanaya.”<verse eid="LUK 18:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 18:43" />Tjinyolotjo wakabona akawuntobela, ekudza Ndzimu; banhu bose bakati bekubona ikoku, bakalumbidza Ndzimu.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s">Yesu naZakhewu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />Yesu wakangina muJerikho, waka epinda. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />Kwaka kuna nlume waka eyi Zakhewu, ali nketisi nkulu, kakale akafuma. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />Waka ehaka bona kuti Yesu unhu wakatini, koga waka kon'wa ngentha yebunji gwebanhu, ngobe alimfupi. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />Ndizo wakalabukila mbeli akanotanha nti wenkuyu kudze atubule wumbona, ngobe waka ewhopinda nayipapo. <verse eid="LUK 19:4" /><verse number="5" style="v" sid="LUK 19:5" />Yesu wakati eswika ipapo akalinga pehhugwi, akati, “Zakhewu libilidza udeluke; ngobe nasi ndonoyezela kun'umba iyo.”<verse eid="LUK 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 19:6" />Wakadeluka nekulibilidza, akawamutjila Yesu nekuhanha. <verse eid="LUK 19:6" /><verse number="7" style="v" sid="LUK 19:7" />Bakakubona kose ikoku bakan'un'urika beti, “Wayenda kunoba mwezi wentjinyi.”<verse eid="LUK 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8" />Zakhewu wakamilika akati kuna He, “He, ndopalalanya fumwa yangu pakati ndikobela bahayi. Hapa kuli kuti ndaka ndatjebela umwe nhu tjimwe tjinhu, ndotjibgwiliza tjaka pamhiwa kanna.”<verse eid="LUK 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9" />Yesu wakati kuwunli, “Nasi jidzo laswika mun'umba iyeyi, ngobe na iyebo unkololo wa Abhurahhamu. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" />Ngobe Nkololo wenhu wakahhila whohaka netjidza bakalahika.”<verse eid="LUK 19:10" /></para>
  <para style="s">Tjifananidzo Tjemaloso Ezeezi</para>
  <para style="r">(<ref loc="MAT 25:14-30">Matewu 25.14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />Bakati batjakawhilila zwinhu izwezwi, akayendilambeli ebabudza tjifananidzo, saku waka aba pedlo neJerusalema, kakale ngobe baka bekumbula kuti bumambo gweNdzimu gwaka guwhoswika tjinyolotjo. <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />Ndizo ke wakati, “Umwe nlume waka ali wen'umba yebumambo, wakayenda kuhango ikule kule kuti anombadziwa bumambo eko handuka. <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />Wakadana balanda babe bali gumi, akabapa maloso emamina<note caller="+" style="f"><char style="fr" closed="false">19.13 </char><char style="ft" closed="false">loso lin'ompela laka lakalizana nenlipo wemimwedzi mitatu </char></note> aligumi, akati kubali, ‘Muzwalise mari iyeyi ndidze ndihanduke.’ <verse eid="LUK 19:13" /><verse number="14" style="v" sid="LUK 19:14" />Koga banhu behango iye baka bewumbenga, ndizo bakasala betuma banhu hule kukwe beti, ‘Atitohaka kuti iwhoyu nlume abe mambo wedu.’<verse eid="LUK 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15" />“Wakati ahanduka, atjimbadziwa bumambo, akalaya kuti ibabo balanda baaka apa mari badan'we, kuyetila ziba kuti mari yakazwala kungapani. <verse eid="LUK 19:15" /><verse number="16" style="v" sid="LUK 19:16" />Wekutanga wakahha eti, ‘He, loso lenyu lemina lakazwala maloso ali gumi.’ <verse eid="LUK 19:16" /><verse number="17" style="v" sid="LUK 19:17" />Akati kuwunli, ‘Wakathama zwakanaka, nlanda mbuya! Ngobe wagalikabgwe mutjinhu tjitukununu, unowhobe ntungamili wemizi-mikulu ili gumi.’ <verse eid="LUK 19:17" /><verse number="18" style="v" sid="LUK 19:18" />Webubili akahha eti, ‘He, loso lenyu lemina lakazwala maloso ali mahanu.’ <verse eid="LUK 19:18" /><verse number="19" style="v" sid="LUK 19:19" />Eba eti kuwunli, ‘Unowhobe ntungamili wemizi-mikulu ili mihanu.’ <verse eid="LUK 19:19" /><verse number="20" style="v" sid="LUK 19:20" />Umwe akahha eti, ‘He, yeli loso lenyu lemina, ndakalibiga ndakalipetela nejekana; <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />ndaka ndihla, ngobe munhu unamoyo nkukutu; motola pamusakabiga, mokowha pamusakadzwala.’ <verse eid="LUK 19:21" /><verse number="22" style="v" sid="LUK 19:22" />Eba eti kuwunli, ‘Ndokuwana nlandu ngentha yematama awo, iwe nlanda mbi! Wawuziba kuti ndinamoyo nkukutu, ndotola pandisakabiga, ndokowha pandisakadzwala? <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />Ngentha yeni ngono usakayendesa mari yangu kubhenki kuyetila kuti nditi ndihanduka ndiyiwane yazwala?’ <verse eid="LUK 19:23" /><verse number="24" style="v" sid="LUK 19:24" />Wakati kuna bakabalimile ipapo, ‘Muwuntolele loso ilelo mupe unamaloso aligumi.’ <verse eid="LUK 19:24" /><verse number="25" style="v" sid="LUK 19:25" />Bakawun'handula beti, ‘He, unamaloso aligumi!’ <verse eid="LUK 19:25" /><verse number="26" style="v" sid="LUK 19:26" />‘Ndoti kumuli, wose nhu unako unowhopiwa kunjinji; koga usina, nayikoko kwaanako unowhokutolegwa. <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" />Koga zwita zwangu, zwaka zwisingahake kuti ndibe ntungamili wazo, muzwilezi ngeno muzwibulaye mbeli kwangu.’ ”<verse eid="LUK 19:27" /></para>
  <para style="s">Ngina kwaYesu muJerusalema Ewamutjigwa Nempululu</para>
  <para style="r">(<ref loc="MAT 21:1-11">Matewu 21.1-11</ref>; <ref loc="MRK 11:1-11">Mako 11.1-11</ref>; <ref loc="JHN 12:12-19">Johane 12.12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />Yesu wakati atjileba ikoku, akapindilambeli, eyenda kuJerusalema. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />Akati aswika pedlo neBhethifeji neBhethani, padombo linoyi leMitoba, akatuma badiyiwa babili, <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />eti, “Yendani kunzi umbeli, mowhoti mungina mowhowana gondolo lekakambe, lisakatongotan'wa nenhu, lakasungiligwa, mulisunungule mubuye nalo. <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />Hapa kukaba nenhu unomubhuzwa, eti, ‘Molisunungulilani?’ muhandule muti, ‘He banohaka lihingisa.’ ”<verse eid="LUK 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32" />Ndizo bakayenda baka batumwa, bakawana kwakajalo sebudziwa kwabo. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />Bakati betjasunungula gondolo lekakambe, bobatezi balo bakati, “Mosunungulilani kakambe itjetji?”<verse eid="LUK 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34" />Baka bahandula beti, “He banotjihaka.” <verse eid="LUK 19:34" /><verse number="35" style="v" sid="LUK 19:35" />Bakahhisa gondolo lekakambe kuna Yesu, bakawala pehhugwi kwalo zwiyambalo zwabo, bakagadza Yesu pehhugwi kwalo. <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />Wakati eyenda akatanha kakambe banhu bakawala zwiyambalo zwabo muzila.<verse eid="LUK 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37" />Wakati atjiba pedlo, panojitila peDombo leMitoba, lukawu gwebadiyiwa gukatangisa lumbidza Ndzimu ngemawhi apehhugwi guna kuhanha ngentha yemihingo mikulukulu yagwaka gwabona, <verse eid="LUK 19:37" /><verse number="38" style="v" sid="LUK 19:38" />guti, “Wakakombolegwa Mambo unobuya muzina laHe! kunyalala kudzimu negudzo pehhugwihhugwi.”<verse eid="LUK 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39" />Bamwe bebaFarisi baka bali pakati kwelukawu bakati kuwunli, “Ndhiyi tjemelani badiyiwa benyu.”<verse eid="LUK 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40" />Wakabahandula eti, “Ndomubudza, hapa ibaba benganyalala, mabgwe iwo ngekwawo anowhomimila.”<verse eid="LUK 19:40" /></para>
  <para style="s">Yesu Unolilila Jerusalema</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />Wakati atjibe pedlo nenzi-nkulu, ewumbona akawunlilila, <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />eti, “Kadzene wawuziba nasi zwinhu zwinokuhhisila kunyalala! Koga ngwenuwali zwakasumbikika kumeho awo. <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />Ngobe kowhoswika mahhuba ekuti zwita zwizo zowhothama bhakasa linokukombeledza, kakale zwikuzwinila ntha dzose, <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />zwikokupwanyila pasi, iwe nebana bawunabo, kakale azwitowhosiya bgwe lilipehhugwi kwelimwe mukuli; ngobe usakaziba lubaka gwekumbiwa kuko.”<verse eid="LUK 19:44" /></para>
  <para style="s">Yesu Unoyenda Kuthempeli</para>
  <para style="r">(<ref loc="MAT 21:12-17">Matewu 21.12-17</ref>; <ref loc="MRK 11:15-19">Mako 11.15-19</ref>; <ref loc="JHN 2:13-22">Johane 2.13-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />Wakangina muthempeli akatangisa tata baka betengesa, <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />eti, “Kwakakwagwa kuti, ‘N'umba yangu inowhobe n'umba yentembezelo’; koga imwi matjiyithama guwhu lembava.”<verse eid="LUK 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47" />Wakabe ediya muthempeli mahhuba ose. Baphirisiti bakulu nebakwali nebatungamili bebanhu baka begwisa wumbulaya; <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />koga bakahaya zila yabangakuhinga ndiyo, ngobe banhu bose baka bakawunteedza kakale bewhilila kwazo matama awe.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s">Mbhuzo Ngekwesimba laYesu</para>
  <para style="r">(<ref loc="MAT 21:23-27">Matewu 21.23-27</ref>; <ref loc="MRK 11:27-33">Mako 11.27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />Limwe hhuba, wakati ediya banhu muthempeli kakale esumikila ndebo mbuya, baphirisiti bakulu nebakwali bena bawhola, bakahha, <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />bakati kuwunli, “Tongotibudza, zwinhu izwezwi nozwithama nalipi simba, kene ndiyani wakakupa simba ileli?”<verse eid="LUK 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3" />Akabe ebahandula eti, “Ndowhomubhuzwa bo mbhuzo. Tjitongo ndibudzani, <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />bvubika kwaJohane kwakakubva kudzimu kene kubanhu?”<verse eid="LUK 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5" />Baka kulebeleka tjekwabo, beti, “Tikati, ‘Kwakabva kudzimu,’ unowhoti, ‘Ngentha yeni musakagalamoyo muwunli?’ <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />Koga tikati, ‘Kubanhu,’ bose banhu banowhotikhikitidza ngemabgwe; ngobe banogalabgwe kuti Johane waka ali nlebesambeli.” <verse eid="LUK 20:6" /><verse number="7" style="v" sid="LUK 20:7" />Ndizo bakahandula beti, “Atitoziba kuti kwakabva poni.”<verse eid="LUK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8" />Yesu eba eti kubali, “Ngono nami bo anditowhomubudza kuti kunge simba lipi ndithama zwinhu izwezwi.”<verse eid="LUK 20:8" /></para>
  <para style="s">Tjifananidzo Tjebalimi Beminda Yemahhambi</para>
  <para style="r">(<ref loc="MAT 21:33-46">Matewu 21.33-46</ref>; <ref loc="MRK 12:1-12">Mako 12.1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />Wakatangisa budza banhu tjifananidzo yetji. “Umwe nlume wakalima minda yemahhambi, akayisayidza balimi, akayenda kuyimwe hango kwelubaka. <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />Lubaka gweyibva kwemahhambi gwaswika, akatuma nlanda uwe kuna baakasayidza minda, kuti anopiwa gobe lemitjelo yeminda; koga baakasayidza minda bakawunloba akabgwilila akalembedza maboko. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />Wakapamha akatuma umwe nlanda; bakawunloba kakale bakawumbhata nezila inobhatisa honi, akabgwilila akalembedza maboko. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />Wakatuma umwe webutatu; bakawunkubadza kakale bakawuntata. <verse eid="LUK 20:12" /><verse number="13" style="v" sid="LUK 20:13" />Mweni weminda ekotjiti, ‘Ndowhota nditini? Ndowhotuma nkololo wangu, wandinoda; kungayetika iye bakawuwhilila.’ <verse eid="LUK 20:13" /><verse number="14" style="v" sid="LUK 20:14" />Koga balimi bakati bewumbona bakalangana beti, ‘Iwhoyu ndiye nghalinhaka; atiwumbulayeni, kuyetila kuti nhaka ibve yabe yedu.’ <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />Bakawumposela kuhhe kweminda bakawumbulaya.”</para>
  <para style="p" vid="LUK 20:15">“Ngono mweni weminda unowhobatani? <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />Unowhohha ebapaladza balimi ibabo, etola minda eyipa bamwe.”</para>
  <para style="p" vid="LUK 20:16">Banhu bakati bekuwha ikoku bakati, “Ngakusijalo!”<verse eid="LUK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17" />Koga wakabalinga akati, “Kobvani ke ikoku kwakakwagwa.</para>
  <para style="q1" vid="LUK 20:17">“ ‘Bgwe ilo tjekwalo lakalambiwa nebabaki</para>
  <para style="q2" vid="LUK 20:17">ndilo latjiba bgwe linotambunudza mbako’?<verse eid="LUK 20:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18" />Wose nhu unowila pehhugwi kwebgwe ilelo unowhovunikana akaba zwipivu; koga hapa liwila nhu lowhupwanya.”<verse eid="LUK 20:18" /></para>
  <para style="s">Mbhuzo Ngelipa Miketiso</para>
  <para style="r">(<ref loc="MAT 22:15-22">Matewu 22.15-22</ref>; <ref loc="MRK 12:13-17">Mako 12.13-17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />Bakwali nebaphirisiti bakulu bakayedza wunsunga nayigogo lubaka, koga bakahla banhu; ngobe bakaziba kuti waleba tjifananidzo itjetji ebva ibo. <verse eid="LUK 20:19" /><verse number="20" style="v" sid="LUK 20:20" />Ndizo bakawunlonga hhiho, bakawuntumila whodzi, dzakadzizwita banhu bakalulama, kudze dziwhilile tjaanoleba, kuti dziwunsungise kubutungamili gwembhati wentunhu. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />Dzakawumbhuzwa dziti, “Ndhiyi, toziba kuti moleba nediya tjakatambunuka, kakale amutohalawula, koga imwi modiya zila yeNdzimu ngelebeswa. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />Kumunlayo lipa luketo kuna Khesari, kene akuta munlayo?”<verse eid="LUK 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23" />Koga iye wakabona butjengeli gwadzo, akaba eti kudzili, <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />“Tongondilakidzani loso. Ibuso gwani igogu, kakale kwakakwagwa ngekwayani mulili?”</para>
  <para style="p" vid="LUK 20:24">Dzibe dzihandula dziti, “Khesari.”<verse eid="LUK 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25" />Iye ekotjiti kudzili, “Ipani Khesari kwaKhesari, neNdzimu kweNdzimu.”<verse eid="LUK 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26" />Dzikasitubule wumbhatshila ngematama awe pakati kwebanhu; kakale dzakatjenamisiwa ngen'handulo iye dzikanyalala.<verse eid="LUK 20:26" /></para>
  <para style="s">Muka Kubafi</para>
  <para style="r">(<ref loc="MAT 22:23-33">Matewu 22.23-33</ref>; <ref loc="MRK 12:18-27">Mako 12.18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />Kwakakotjihha kuwunli bamwe baSadusi, ibabo banoti akuna muka kubafi, bakawumbhuzwa beti, <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />“Ndhiyi, Mozisi wakatikwalila kuti hapa nkulu wenhu afa, kuli kuti waanankadzi koga basina bana, nun'una uwe wakafanila tola nkadzi iwhoyo azwalile nkuluyi bana. <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />Ngono kwakakuna bakololo benhu un'ompela bali kutondeka; mbano ikatola nkadzi ikakotjinyika basina bana; <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />webubili akangina nkadzi iwhoyo, <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />webutatu akangina nkadzi iwhoyo bo, kukayendila mbeli kujalo kukadza kukaswika kuna wekutondeka, bose akuna wakafa ata mwana naye. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />Hule kwayipapo nkadzi iwhoya akafa bo. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />Ngono pakumuka kubafi, nkadzi iwhoyo unowhobe wani? Ngobe bose bali kutondeka wakaba nkadzi wabo.”<verse eid="LUK 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34" />Yesu wakahandula eti, “Banhu banotjila mumahhuba anasi banolobola kakale banolobogwa; <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />koga ibabo banobagwa sebakafanila kuti babe belubaka gunohha kakale bemuka kubafi abatolobola kene lobogwa, <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />abangatjafe kakale, ngobe belizana nebatumwa bekudzimu kakale batjibe bana beNdzimu, saku beli bana bemuka kubafi. <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" />Koga kuti bafi banomusiwa, kene naMozisi wakakulayidza, mundima yedenje lemhiwa, paanodana He eti, ‘Ndzimu wa Abhurahhamu, Ndzimu wa Isaka, Ndzimu waJakobe.’ <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />Haate Ndzimu webafi, koga ndewebapenyu; ngobe bose banotjilila iye.”<verse eid="LUK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39" />Bamwe bakwali bakahandula beti, “Ndhiyi, mahandula zwibuyanana.” <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />Ngobe baka besingatjahake wumbhuzwa umwe mbhuzo.<verse eid="LUK 20:40" /></para>
  <para style="s">Mbhuzo NgekwaMesiya</para>
  <para style="r">(<ref loc="MAT 22:41-46">Matewu 22.41-46</ref>; <ref loc="MRK 12:35-37">Mako 12.35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />Koga wakati kubali, “Bangati Khirisitu unkololo waDavida tjini? <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" />Ngobe Davida tjekukwe unoti muLukwalo gweNjimbo,</para>
  <para style="q1" vid="LUK 20:42">“ ‘He wakati kuna He wangu,</para>
  <para style="q2" vid="LUK 20:42">Gala kuluboko gwangu gweludli,<verse eid="LUK 20:42" /></para>
  <para style="q2">
    <verse number="43" style="v" sid="LUK 20:43" />ndidze ndithame zwita zwizo tjigadziko tjemakumbo awo.’<verse eid="LUK 20:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44" />Iye Davida unowundhana eti He; ngono unkololo uwe tjini?”<verse eid="LUK 20:44" /></para>
  <para style="s">Mutjenjelele Bakwali</para>
  <para style="r">(<ref loc="MAT 23:1-36">Matewu 23.1-36</ref>; <ref loc="MRK 12:38-40">Mako 12.38-40</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />Banhu bose bakawhilila, iye wakati kubadiyiwa babe, <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />“Mutjenjelele bakwali, banoda yenda bakambala zwiyambalo zwilefulefu, banoda buyisiwa munhanga dzetengesela nepiwa zwigalo zwakanaka mumasinagogu nebugalo gwebanhu banagudzo panobe pedliwa, <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />banotjebela njhilikadzi bedzitolela nhundu nezwimun'umba dzadzo, beyeta mahonga ndibon'we ngemitembezelo milefulefu. Banowhowanikwa nlandu nkulunkulu.”<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s">Tjipo tjeTjilikadzi</para>
  <para style="r">(<ref loc="MRK 12:41-44">Mako 12.41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />Yesu wakati emilidza meho, akabona bafumi besa zwipo zwabo museme yezwipo; <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />akabona imwe tjilikadzi inodziyila, isa maloso mabili matukununu. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />Akati, “Ndomubudza lebeswa, tjilikadzi iyeyi inodziyila yasa kunjinji kupinda bose. <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />Ngobe bose ibaba banokola mufumwa yabanayo bakasa tjipo museme, koga tjilikadzi mubuhayi gwayo ysa kose kwayinako.”<verse eid="LUK 21:4" /></para>
  <para style="s">Yesu Unoleba Nekwekolomogwa kweThempeli</para>
  <para style="r">(<ref loc="MAT 24:1">Matewu 24.1</ref>,<ref loc="MAT 24:2">2</ref>; <ref loc="MRK 13:1">Mako 13.1</ref>,<ref loc="MRK 13:2">2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />Bamwe bakati beleba nekwethempeli, sekwalakanakisiwa ngemabgwe akanaka nange zwipo, Yesu wakati, <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />“Nekwezwinhu izwezwi zwamunobona, kowhohha lubaka pakusingowhosala bgwe lilipehhugwi kwelimwe ipapa, lisingowholigigwa pasi.”<verse eid="LUK 21:6" /></para>
  <para style="s">Mamanikano Nedziyidziwa</para>
  <para style="r">(<ref loc="MAT 24:3-14">Matewu 24.3-14</ref>; <ref loc="MRK 13:3-13">Mako 13.3-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7" />Bakawumbhuzwa beti, “Ndhiyi, kowhoyetikala lini, kakale tjilakidzilo tjowhobe tjili tjipi hapa ikoku kwabepedlo neyetikala?”<verse eid="LUK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8" />Wakati, “Mutjenjele kuti kusibe nenhu unomulaha; ngobe banjinji banowhohha muzina langu beti, ‘Ndi iye!’ kakale beti, ‘Lubaka gwebupelo gwasedzela!’ Musibatobele. <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />Hapa muwha nekwengwa nepandukilana, musihle; ngobe zwinhu izwezwi zwakafanila yetikala kutanga, koga bupelo agutowhoswika tjinyolotjo.”<verse eid="LUK 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10" />Wakayendilambeli eti kubali, “Tjaba tjowhomukila tjaba, bumambo gowhomukila bumambo. <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />Kowhobe nekutengenyeka kwehango kukulu nebhamba lakabangalala nedzinghwele muhango yose; kowhoba nezwinhu zwinohlisa kwazo nezwilakidzilo zwikulu zwinobva kudzimu. <verse eid="LUK 21:11" /><verse number="12" style="v" sid="LUK 21:12" />Koga kusanhu kwayetika kose ikoku, banowhomusunga bakamudziyidza, bakamuyendesa kumasinagogu nemajele, kakale mowhoyendisiwa kuna bomambo nebabhati bemitunhu ngentha yezina langu. <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />Igogu gowhobe guli lubaka gwekuti mupe busupi. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" />Simani mimoyo, musizwidziyidze kuti mowhobahandula tjini; <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />ngobe ndowhomupa matama nebutjenjebvu, gusingowhokuligwa kene nyanyayidziwa nayibo bose banopesana namwi. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />Mowhosungisiwa ngebazwadzi benyu, nangebana babotate benyu, nange makamu enyu, nange bakwinya benyu, bamwe benyu banowhobulawa. <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />Banhu bose banowhomubenga ngentha yezina langu. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />Koga akuna kene vudzi len'holo wenyu linowhopaladzika. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />Ngesimidzila kwenyu mowhotjengetedza butjilo gwenyu.”<verse eid="LUK 21:19" /></para>
  <para style="s">Yesu Unoleba Nekwekolomogwa kweJerusalema</para>
  <para style="r">(<ref loc="MAT 24:15-21">Matewu 24.15-21</ref>; <ref loc="MRK 13:14-19">Mako 13.14-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />“Mukabona Jerusalema yakombeledzewa nengwa muzibe kuti paladziwa kwabepedlo. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />Nayigogo lubaka bamuJudiya batihhile kumatombo, bamukati kwenzi-nkulu babhude muwunli, nebakuhhe kwawo basibgwilile muwunli; <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" />ngobe kowhobe kwabemisi yebgwilizila, kudze kose kwakakwagwa kuhhadzisike. <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />Koga kowhobabangalalila ibabo bakazwisenga nebanomwisa mumahhuba iyawo! Ngobe kowhoba nebuyendasi gukulu muhango, nebuhongola pehhugwi kwebanhu ibaba; <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />banowhobulawa ngemapangatjeke, kakale banowhoba batapwa kunjudzi dzose; neJerusalema inowhokanyangiwa ngeBataya, kudzina lubaka gweBataya gwahhadzisika.”<verse eid="LUK 21:24" /></para>
  <para style="s">Buya kweNkololo weNhu</para>
  <para style="r">(<ref loc="MAT 24:29-31">Matewu 24.29-31</ref>; <ref loc="MRK 13:24-27">Mako 13.24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />“Kakale kowhoba nezwilakidzilo muhhuba nemumwedzi nemunyenyedzi, kose nemuhango zwitjaba zowhodziyidzika, zwihanganyiwa miholo ngewona nange kumidukana kwevula yegungwa, <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />banhu banowhotongopela meya ngentha yehla nesaziba kuti ini tjinowhoyetika muhango; ngobe masimba ekudzimu anowhozunguzika. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" />Nelubaka igogo ndipo pabanowhobona Nkololo wenhu ehha ali mugole, anamasimba negudzo gulu. <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />Hapa zwinhu izwezwi zwitangisa yetika, mumilike mumuse miholo mulinge pehhugwi, ngobe sunungugwa kwenyu kobe kwabepedlo.”<verse eid="LUK 21:28" /></para>
  <para style="s">Tjidiyo tjeNkuyu</para>
  <para style="r">(<ref loc="MAT 24:32-35">Matewu 24.32-35</ref>; <ref loc="MRK 13:28-31">Mako 13.28-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />Yesu wakakobabudza tjifananidzo yetji. “Mulinge nkuyu neyimwe miti yose; <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />hapa itangisa sinila mahhani, mobva maziba kuti tjilimo tjeesedzela. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />Kwakajalo bo ke, hapa mubona zwinhu izwezwi zwiyetika, zibani kuti bumambo gweNdzimu gwatjiba pedlo.”<verse eid="LUK 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32" />“Lebeswa, ndoti kumuli, tjizekugwana itjetji atjitowhopinda kose kusanhu kwahhadzisika. <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />Kudzimu nehango kowhopinda, koga matama angu atowhopinda.”<verse eid="LUK 21:33" /></para>
  <para style="s">Ibani Nenjele</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />“Ibani nenjele kudze mimoyo yenyu isikuligwe ngedla nange kulaladza kose nezwinodikala mubutjilo igogu, hhuba ilelo libva limuswikila tjinyolotjo makafala <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />sedati, ngobe hhuba ilelo lowhohhila bose banhu banogala muhango. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />Mugale makalinda, mutembezela lubaka gose kuti mube nemasimba esubvunuka muna kose ikoku kunowhoyetika, nekuti mume mbeli kweNkololo wenhu.”<verse eid="LUK 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />Hhuba nehhuba waka ehwa ediya muthempeli, busiku eyenda kudombo leMitoba. <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />Banhu bose baka bebindukila mangwanana behha kuwunli muthempeli bewhowuwhilila.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s">Langana nekwaYesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">Matewu 26.1-5</ref>; <ref loc="MRK 14:1">Mako 14.1</ref>,<ref loc="MRK 14:2">2</ref>; <ref loc="JHN 11:45-53">Johane 11.45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />Sangwenu nzano weTjinkwa Tjisina Mbidzo, unoyi Phasika waka wasedzela. <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />Baphirisiti bakulu nebakwali baka behaka zila yekuti bangawumbulaya tjini; koga baka behla banhu.<verse eid="LUK 22:2" /></para>
  <para style="s">Judasi Unobvuma Tengesa Yesu</para>
  <para style="r">(<ref loc="MAT 26:14-16">Matewu 26.14-16</ref>; <ref loc="MRK 14:10">Mako 14.10</ref>,<ref loc="MRK 14:11">11</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3" />Ipapo Satane wakangina muna Judasi unoyi Isikariyoti, waka ali umwe webaligumi nebabili. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />Wakayenda kubaphirisiti bakulu nebalawuli bebalindi bethempeli, akalebeleka nabo kuti angatengesa Yesu tjini, kubali. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />Bakahanha kwazo bakabvumilana kuti banowhowumpa mari. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />Ndizo wakabvuma, akahaka nkoba wewuntengesa kusina lukawu gwebanhu.<verse eid="LUK 22:6" /></para>
  <para style="s">Yesu Unobaakanyila Dla Phasika</para>
  <para style="r">(<ref loc="MAT 26:17-25">Matewu 26.17-25</ref>; <ref loc="MRK 14:12-21">Mako 14.12-21</ref>; <ref loc="JHN 13:21-30">Johane 13.21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />Lakaswika hhuba lenzano weTjinkwa Tjisina Mbidzo, lilihhuba laka libhayiwa mhwizana yephasika. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />Ndizo ke Yesu wakatuma Phethiro naJohane, eti, “Yendani munotilulamisila phasika, kuyetila kuti tiyidle.”<verse eid="LUK 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9" />Ibo bakati kuwunli, “Mohaka kuti tinoyilulamisila poni?”<verse eid="LUK 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10" />Wakati kubali, “Lingani, hapa mungina munzi-nkulu, mowhohangana nenlume wakasenga tjilongo tjevula, muwuntobele kunzi waanowhongina, <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />muti kumweni wenzi, ‘Ndhiyi wati kumuli, iponi n'umba yebezi, pandinowhodlila phasika ndina badiyiwa bangu?’ <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />Unowhomutondekela n'umba whulu ipehhugwi ina zwidla zose yakalinda hingisiwa; mubaakanyile muyili.”<verse eid="LUK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13" />Bakayenda, bakawana kuli sekwaababudza; baka baakanya phasika.<verse eid="LUK 22:13" /></para>
  <para style="s">Tjilayilo tjaHe</para>
  <para style="r">(<ref loc="MAT 26:26-30">Matewu 26.26-30</ref>; <ref loc="MRK 14:22-26">Mako 14.22-26</ref>; <ref loc="1CO 11:23-25">1 BaKhorinte 11.23-25</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />Lubaka gwaswika, wakagala kuti adle nebapositoli. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />Wakati kubali, “Ndandiyemula kwazo kuti ndidle phasika iyeyi namwi ndisanhu ndadziyidziwa; <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />ngobe ndomubudza, anditjoyidla kuswika tjayinobva tjahhadzisika mubumambo gweNdzimu.”<verse eid="LUK 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17" />Wakatola nkombe unawayini, atjiboka kuNdzimu wakati kubali, “Tolani whoku, mukobane; <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />ngobe ndomubudza kubvila ngwenuwali anditjowhon'wa kwemitjelo yemahhambi kudzina bumambo gweNdzimu guhha.”<verse eid="LUK 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19" />Wakatola tjinkwa akaboka kuNdzimu, akatjipemula, akabapa eti, “Iwhoyu umbili wangu unopigwa imwi. Mukuthame ikoku mundikumbula.” <verse eid="LUK 22:19" /><verse number="20" style="v" sid="LUK 22:20" />Kakale bapedza dla, wakatola nkombe, akati, “Nkombe iwhoyu tjibvumilano tjitshwa mumalopa angu anotebuligwa imwi.”<verse eid="LUK 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 22:21" />“Koga lingani, luboko gwa iwhoyo unowhonditengesa ndinago pazodliwa. <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />Ngobe Nkololo wenhu unoyenda sekwakwaka bigiwa neNdzimu; koga kwakawubangalalila iwhoyo nlume unowhowuntengesa!”<verse eid="LUK 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 22:23" />Bakatangisa bhuzwana kuti ndiyani unowhothama tjinhu tjakajalo pakati kwabo.<verse eid="LUK 22:23" /></para>
  <para style="s">Nyanyayidzana Nekwebukulu</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />Kwakaba nesabvumilana pakati kwabo, kuti ndiyani waka ewhoba nkulu pabali bose. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />Yesu wakati kubali, “Bomambo beBataya banobatshambidzila, ibabo banobatungamila banozwiti ‘Babhatshi bebanhu.’ <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />Koga ngakusijalo pakati kwenyu; nkulu pakati kwenyu ngaange sentjetjana, ntungamili ngaange sen'hingi. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />Ndiyani nkulu, ugele epiwa zodliwa, kene unobhika epakula? Akuta ugele epiwa zodliwa? Koga imi ndipakati kwenyu ndimupakulila.”<verse eid="LUK 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28" />“Imwi ndimwi mama nami tjoselele mukulikwa kwangu. <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />Ndizo ndomupa bumambo, sekwandakapiwa bumambo naTate bangu, <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" />kuti mudle kakale mun'we nami mubumambo gwangu, mugale pazwigalo zwetonga njudzi dzili gumi nembili dza Isirayeli.”<verse eid="LUK 22:30" /></para>
  <para style="s">Yesu Unolebesambeli Landugwa Kukwe NaPhethiro</para>
  <para style="r">(<ref loc="MAT 26:31-35">Matewu 26.31-35</ref>; <ref loc="MRK 14:27-31">Mako 14.27-31</ref>; <ref loc="JHN 13:36-38">Johane 13.36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />“Simoni, Simoni! Whilila! Satane unohaka mulika, emuhhunga sezwidlo. <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />Koga ndakutembezelela kuti galamoyo kuko kusipele; kakale hapa wahanduka, usimise hama dzidzo.”<verse eid="LUK 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33" />Phethiro wakati kuwunli, “He, ndazwipila kuti ndiyende namwi kujele kene ndife namwi.”<verse eid="LUK 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34" />Yesu wakati, “Ndokubudza, Phethiro, gukurume alitowholila nasi, udza ulandula katatu kuti unondiziba.”<verse eid="LUK 22:34" /></para>
  <para style="s">Kwama, Whomo neBhangatjeke</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />Wakati kubali, “Pandakamutuma musina whomo kene kwama tjemari kene hangu, kuna tjamakatayila kene?”</para>
  <para style="p" vid="LUK 22:35">Bakahandula beti, “Akuna.”<verse eid="LUK 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36" />Akaba eti kubali, “Koga ngwenu, unakwama tjemari ngaatjitole, newuna whomo ngaayitole bo. Usina bhangatjeke ngaatengese tjiyambalo tjitje atenge bhangatjeke. <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />Ndomubudza, lukwalo igogu gwakafanila hhadzisika mundili, gunoti, ‘Wakabagwa kan'ompela nebatjinyi’; ngobe kose kwakakwagwa nekwangu kuna sekwakunohhadzisika.”<verse eid="LUK 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38" />Badiyiwa bakahandula beti, “He kuna mabhangatjeke mabili ipapa.”</para>
  <para style="p" vid="LUK 22:38">Akati kubali, “Kwalulama.”<verse eid="LUK 22:38" /></para>
  <para style="s">Yesu Unotembezela muDombo leMitoba</para>
  <para style="r">(<ref loc="MAT 26:36-46">Matewu 26.36-46</ref>; <ref loc="MRK 14:32-42">Mako 14.32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />Yesu wakabhuda akayenda kuDombo leMitoba, sekwaagala ethama; badiyiwa babe bakawuntobela. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />Atjiswika po wakati kubali, “Tembezelani kudze musingine mukulikwa.”<verse eid="LUK 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 22:41" />Wakatsheduka pabali akayenda nhambwana ingaposewa bgwe likawilapo, akapfigama akatembezela eti, <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />“Tate, hapa muda, dusani nkombe iwhoyu kundili; koga kusibe ngekuda kwangu, koga ngakuyetiwe kuda kwenyu.” <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />(Kwakaswika ntumwa ebva kudzimu akahha ewunsimisa. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />Anahungu whuluwhulu wakatembezela ngemasimba; akadona matukuta anonga madon'we emalopa anodonela pasi.)<verse eid="LUK 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45" />Amilika pakutembezela wakayenda kubadiyiwa akanowana bakayizela nentha yebuyendasi, <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />akati kubali, “Mulelileni? Mukani mutembezele kudze musingine mukulikwa.”<verse eid="LUK 22:46" /></para>
  <para style="s">Sungwa kwaYesu</para>
  <para style="r">(<ref loc="MAT 26:47-56">Matewu 26.47-56</ref>; <ref loc="MRK 14:43-50">Mako 14.43-50</ref>; <ref loc="JHN 18:3-11">Johane 18.3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />Etjalebeleka, kwakaswika mbunga webanhu, utungamigwa naJudasi umwe webaligumi nebabili. Wakasedzela kuna Yesu akawumputa; <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />Yesu eba eti kuwunli, “Judasi, notengesa Nkololo wenhu ngewumputa?”<verse eid="LUK 22:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49" />Ibabo baka bena Yesu bebona kuti ini tjinotobela bakabhuzwa beti, “He, titeme nebhangatjeke?” <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />Umwe wabo akatema nlanda wemphirisiti upehhugwi akawunthubula zebe yekuludli.<verse eid="LUK 22:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51" />Koga Yesu wakati, “Aa aa ngakusijalo!” Akabhata zebe yenlume iwhoyo akawumpodza.<verse eid="LUK 22:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52" />Yesu wakakotjiti kubaphirisiti bakulu nebalawuli bebalindi bethempeli nebawhola, baka bawhowumbhata, “Mabinga hhibava kani, makasenga mabhangatjeke nedziswimbo? <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />Mahhuba ose tatili toseni muthempeli, amuzondibhata. Koga igogu lubaka gwenyu, nekulawula kwemasimba ehhalima.”<verse eid="LUK 22:53" /></para>
  <para style="s">Phethiro Unolandula Yesu</para>
  <para style="r">(<ref loc="MAT 26:57">Matewu 26.57</ref>,<ref loc="MAT 26:58">58</ref>,<ref loc="MAT 26:69-75">69-75</ref>; <ref loc="MRK 14:53">Mako 14.53</ref>,<ref loc="MRK 14:54">54</ref>,<ref loc="MRK 14:66-72">66-72</ref>; <ref loc="JHN 18:12-18">Johane 18.12-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />Bakawunsunga bakayenda naye kun'umba yemphirisiti upehhugwi. Phethiro akatobela ali tjakulenyana. <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />Bakati babesa moto pakati kwen'ha, bakagala pasi, Phethiro bo akagala pakati kwabo. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />Umwe n'hingikadzi wakati ewumbona aligele akavonekewa nemoto, akawunlingisisa, eba eti, “Iwhoyu nlume wayena Yesu.”<verse eid="LUK 22:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57" />Koga Phethiro wakalandula, eti, “Iwe nkadzimayi, anditowunziba imi.”<verse eid="LUK 22:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58" />Hule kwelubakanyana umwe kakale wakawumbona akati, “Iwe uwumwe wabo.”</para>
  <para style="p" vid="LUK 22:58">Koga Phethiro wakahandula eti, “Nlumewe! andita ndili umwe wabo.”<verse eid="LUK 22:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59" />Kwapinda lubaka gungabe awa, umwe kakale, wakati, “Ilebeswa iwhoyu nlumetate babeli bose, ngobe uNghalile.”<verse eid="LUK 22:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60" />Koga Phethiro wakati, “Nlumewe! tjawunoleba anditotjiziba.”</para>
  <para style="p" vid="LUK 22:60">Ipapo etjalebeleka gukurume liba lilila. <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />He wakahanduka akalinga Phethiro. Phethiro akakumbula matama aHe anoti, “Gukurume lisanhu lalila nasi, nowhondilandula katatu.” <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />Phethiro wakabhudila kuhhe akanolila zwinogwadza.<verse eid="LUK 22:62" /></para>
  <para style="s">Yesu Unowohholegwa kakale Elobgwa</para>
  <para style="r">(<ref loc="MAT 26:67">Matewu 26.67</ref>,<ref loc="MAT 26:68">68</ref>; <ref loc="MRK 14:65">Mako 14.65</ref>)</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />Balume baka bakasunga Yesu bakatangisa wunkuwelela kakale bewunloba. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />Bakawunzwina meho bakati kuwunli, “Lebesambeli! Ndiyani wakuloba?” <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />Bakawuntuka bamwe betukana nekukwe.<verse eid="LUK 22:65" /></para>
  <para style="s">Yesu Unoyendisiwa kuna Pilatu naHherodi</para>
  <para style="r">(<ref loc="MAT 26:59-66">Matewu 26.59-66</ref>; <ref loc="MRK 14:55-64">Mako 14.55-64</ref>; <ref loc="JHN 18:19-24">Johane 18.19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />Kwakati kuyedza, bawhola nebaphirisiti bakulu kose nebakwali bakakubungana; bakayendisa Yesu kulubahhe gwabo. <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />Bakati kuwunli, “Hapa uli iwe Khirisitu utibudze.”</para>
  <para style="p" vid="LUK 22:67">Koga iye wakahandula eti, “Hapa ndingamubudza, amutowhogalamoyo; <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />kakale hapa ndingamubhuzwa amutowhondihandula. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />Koga kubvisila ngwenuwali Nkololo wenhu unowhoba aligele kuludli gwemasimba eNdzimu.”<verse eid="LUK 22:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70" />Bose bakati, “UNkololo weNdzimu ngono?”</para>
  <para style="p" vid="LUK 22:70">Akabahandula eti, “Moti ndi iye.”<verse eid="LUK 22:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71" />Ipapo bakati, “Titjahakilani gumwe busupi? Tazwiwhila tjabva munlomo uwe.”<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s">Yesu Alimbeli kwaPilatu</para>
  <para style="r">(<ref loc="MAT 27:1">Matewu 27.1</ref>,<ref loc="MAT 27:2">2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">Mako 15.1-5</ref>; <ref loc="JHN 18:28-38">Johane 18.28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />Mbunga wose wakamilika uyenda naye kuna Pilatu. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />Bakatangisa wuntilika milandu beti, “Tawuwana ebudzila tjaba tjedu ntome, eti tisilipe luketo kuna Khesari, kakale ezwiti ndiye Khirisitu, mambo.”<verse eid="LUK 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3" />Pilatu wakawumbhuzwa eti, “Ndiwe Mambo wemaJuta?”</para>
  <para style="p" vid="LUK 23:3">Iye wakawun'handula eti, “Wajalo.”<verse eid="LUK 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4" />Pilatu eba eti kubaphirisiti bakulu nekumbunga, “Nlume iwhoyu anditowuwana ananlandu.”<verse eid="LUK 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5" />Koga banhu bakayendila mbeli, beti, “Unodzonga banhu, ediya muJudiya yose, ebvila kuGalile edza ewhoti muno.”<verse eid="LUK 23:5" /></para>
  <para style="s">Yesu Alimbeli KwaHherodi</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />Pilatu paakawha ikoku, wakabhuzwa kuti nlume iwhoyo uNghalile. <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />Paakaziba kuti ndewebugalo gunotongwa naHherodi, wakawumpindisila kuna Hherodi, muna igogo lubaka Hherodi waka ali muJerusalema. <verse eid="LUK 23:7" /><verse number="8" style="v" sid="LUK 23:8" />Hherodi wakahanha kwazo ebona Yesu, ngobe gwaka gwaba lubaka gulefulefu eyemula wumbona, ngentha yekuti waka ewha nekukwe, waka egalabgwe kuti unowhobona jenamiso linoyetiwa nayiye. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />Ndizo wakawumbhuzwa mibhuzo minjinji; koga Yesu akuna tjaakahandula. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />Baphirisiti bakulu nebakwali bakabalimile ipapo, bewuntilika milandu yakasima. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />Hherodi nebagwi bengwa babe bakawunseka bekawundhadila; bakawumbadza tjiyambalo tjakanaka, bekawumbgwiliza kuna Pilatu. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />Muhhuba ilelo Pilatu naHherodi bakaba bakwinya, kuhule baka bebengana.<verse eid="LUK 23:12" /></para>
  <para style="s">Yesu Unotongegwa Bulawa</para>
  <para style="r">(<ref loc="MAT 27:15-26">Matewu 27.15-26</ref>; <ref loc="MRK 15:6-15">Mako 15.6-15</ref>; Johane 18.39-19.16)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />Pilatu wakadana baphirisiti bakulu, nebatungamili, nebanhu, <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />akati kubali, “Mahhisa nhu iwhoyu kundili muti unhu unodiyila banhu ntome; koga imi hule kweholesesa andizowana iwhoyu nhu ananlandu muzwinhu zose zwamunoleba; <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />kene naHherodi bo, wawumbgwiliza kutili. Akuna tjaathama tjingata kuti abulawe. <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />Ndizo, ndowhowunloba, awunsunungula.” <verse eid="LUK 23:16" /><verse number="17" style="v" sid="LUK 23:17" />(Wakajalo ngobe panzano wephasika waka akafanila kuti abasunungulile nsungwa un'ompela.)<note caller="+" style="f"><char style="fr" closed="false">23.17 </char><char style="ft" closed="false">vesi 17 ayipo mudzimwe whalo whulukugwi dzetjiGiriki</char></note><verse eid="LUK 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18" />Banhu bose bakamimila panhu pan'ompela beti, “Ngaabulawe, mutisunungulile Bharabhasi.” <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />Bharabhasi unlume waka akasungwa elimujele, nentha yepanduka kwaka kwayetika munzi-nkulu, kose nebulaya.<verse eid="LUK 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20" />Pilatu wakapamha akalebeleka nabo ngobe waka ehaka sunungula Yesu; <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />koga bakamimila beti, “Muwunkowhomele, muwunkowhomele!”<verse eid="LUK 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22" />Wakati kubali, kwebutatu, “Nentha yeni, wathamani tjakayipa? Akuna nlandu wandawana muwunli waangabulayigwa; ndowhowunloba akowunsunungula.”<verse eid="LUK 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23" />Koga bakayendilambeli bemimila nemawhi apehhugwi kuti akowhomegwe. Mimila kwabo kwakakunda. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />Ndizo Pilatu wakati ngakuyetiwe sehaka kwabo. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />Wakabasunungulila iye waka akasungwa alimujele ngentha yepanduka nebulaya, wabaka bakumbila; akabapa Yesu kudze bate ludo gwabo.<verse eid="LUK 23:25" /></para>
  <para style="s">Kowhomegwa kwaYesu paTjileyanyo</para>
  <para style="r">(<ref loc="MAT 27:32-44">Matewu 27.32-44</ref>; <ref loc="MRK 15:21-32">Mako 15.21-32</ref>; <ref loc="JHN 19:17-27">Johane 19.17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />Bakati beyenda naye, bakahangana naSimoni wehango yekuKhureni, waka atjamboswika ebvazwe kuminda, bakawumbhata bakawumpikisa tjileyanyo, akayenda akatjisenga alihule kwaYesu.<verse eid="LUK 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 23:27" />Wakatobegwa nebanhu banjinji, kose nebafumakadzi baka bekuwa bewunlilila. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />Yesu ebatjebuka wakati, “Bakololokadzi beJerusalema musindililile, muzwililile imwi nebana benyu. <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />Lingani, anohha mahhuba pabanowholeba beti, ‘Bakakombolegwa bakahaya mbeleko, nezwizwalo zwisakazwala, nemahhamu asakatongomwisa!’ <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" />Ipapo banowhoti kumatombo, ‘Mutiwile’; nekuzwitombwana, ‘Mutivukidzile.’ <verse eid="LUK 23:30" /><verse number="31" style="v" sid="LUK 23:31" />Ngobe hapa bethama bejali kulukuni gunyolo kowhobatjini kulukuni gwakawoma?”<verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />Kuna bamwe batjinyi babili bakayendiwa nabo bo kuti banobulawa. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />Bakati baswika kubugalo gunoyi Pepe tjeN'holo, bakawunkowhomela patjileyanyo ipapo, kan'ompela nebatjinyi, umwe kuludli gugwe umwe kulumehwe gugwe. <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />Yesu wakati, “Tate mubayetile mazwibhatigwa; ngobe abatoziba tjabanothama.”</para>
  <para style="p" vid="LUK 23:34">Bagwi bengwa bakakobana zwiyambalo zwizwe ngekandila malipa. <verse eid="LUK 23:34" /><verse number="35" style="v" sid="LUK 23:35" />Banhu bakama, bakalingilila; koga batungamili bakawunseka, beti, “Wakatjidza bamwe; ngaazwitjidze, hapa ali Khirisitu, N'halugwa weNdzimu!”<verse eid="LUK 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36" />Bagwi bengwa bakawunseka bo, bakawumpa wayini inohababa, <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />beti, “Hapa uli Mambo wemaJuta, uzwitjidze!”<verse eid="LUK 23:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38" />Kwaka kwakakwagwa pehhugwi kukwe kuyi, “Iwhoyu Ndiye Mambo WemaJuta.”<verse eid="LUK 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39" />Umwe webatjinyi waka akalembedziwa patjileyanyo wakawugongobola eti, “Awuta iye Khirisitu? Uzwitjidze, utitjidze bo!”<verse eid="LUK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40" />Koga umwe wakawuntjemela eti, “Awutohla Ndzimu, saku wawanika nlandu bo kan'ompela naye? <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />Iswi kwakatilizana; ngobe towamutjila mbhayilo wakafanila zwiyeto zwedu; koga nlume iwhoyu akuna tjaatjinya.” <verse eid="LUK 23:41" /><verse number="42" style="v" sid="LUK 23:42" />Eba eti, “Yesu, undikumbule hapa uswika mubumambo gugo.”<verse eid="LUK 23:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43" />Yesu wakawun'handula eti, “Lebeswa, ndoti kukuli, nasi nowhoba nami muPharadayisi.”<verse eid="LUK 23:43" /></para>
  <para style="s">Tjinyika kwaYesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">Matewu 27.45-56</ref>; <ref loc="MRK 15:33-41">Mako 15.33-41</ref>; <ref loc="JHN 19:28-30">Johane 19.28-30</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />Kwaka kwatjibe lubaka hhuba lili panhongoma<note caller="+" style="f"><char style="fr" closed="false">23.44 </char><char style="ft" closed="false">Awa yebutanhatu kubvisila hhuba labhuda</char></note>, kwakaba hhalima hango yose kuswikila hhuba litewuka<note caller="+" style="f"><char style="fr" closed="false">23.44 </char><char style="ft" closed="false">Awa yehhanalume kubvisila hhuba labhuda</char></note>, <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />hhuba lakadzima; netjisitilo tjethempeli tjakapaluka tjikaba kabili. <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />Yesu, emimila newhi lipehhugwi, wakati, “Tate, mumaboko enyu ndotula meya yangu!” Atjijalo wakafema gwebupelo.<verse eid="LUK 23:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47" />Nlawuli webagwi bengwa bali gulu wakati abona tjayetika, akalumbidza Ndzimu, eti, “Lebeswa, iwhoyu nlume wayesina nlandu waakalulama!”<verse eid="LUK 23:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 23:48" />Banhu bose baka babuya bewholingilila, babona tjayetika bakabgwilila kumizi yabo balihhele buyendasi. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />Bose baka bezibana naYesu nebafumakadzi baka bawuntobela kubvila kuGalile bakama kulekule bakabona kose kwaka kuyetika.<verse eid="LUK 23:49" /></para>
  <para style="s">Mbiganyo waYesu</para>
  <para style="r">(<ref loc="MAT 27:57-61">Matewu 27.57-61</ref>; <ref loc="MRK 15:42-47">Mako 15.42-47</ref>; <ref loc="JHN 19:38-42">Johane 19.38-42</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50" />Kwaka kuna nlume unoyi Josefa, ali umwe wemakombgwa, ali mbuya kakale akalulama, <verse eid="LUK 23:50" /><verse number="51" style="v" sid="LUK 23:51" />waka esabvumilana nenkumbulo neyeta kwabo, waka ebva kunzi wemaJuta unoyi Arimathiya akalindila bumambo gweNdzimu. <verse eid="LUK 23:51" /><verse number="52" style="v" sid="LUK 23:52" />Nlume iwhoyu wakayenda kuna Pilatu enokumbila kuti apiwe mbili waYesu. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />Wakawuntulula patjileyanyo, akawumpetelela nejila lelineni. Akanowumbiganya mukumbu tjakatshiwa muhongwe, tjisanhu tjikatongobiganyiwa nhu mutjili. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />Laka lili hhuba leBaakanyila, kotangisa sabatha.<verse eid="LUK 23:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55" />Bafumakadzi baka babva naye kuGalile baka tobela hule, baka bona kumbu, kose nebiganyiwa kwembili uwe; <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />bakakotjibgwilila kanyi, baka baakanya mhoza nemafuta.</para>
  <para style="p" vid="LUK 23:56">Bakanyaluluka muhhuba lesabatha sekunoleba nlayo.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s">Muka Kubafi</para>
  <para style="r">(<ref loc="MAT 28:1-10">Matewu 28.1-10</ref>; <ref loc="MRK 16:1-8">Mako 16.1-8</ref>; <ref loc="JHN 20:1-10">Johane 20.1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />Muhhuba lekutanga letshipi, kutjimangwanana ngwanana, bakayenda kukumbu bakasenga mhoza yabaka bathama. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />Bakawana bgwe laka lakahhalila kumbu lakunguludzigwa kutjena nekumbu, <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />koga bakati bangina mukumbu mbili waHe Yesu bakawun'haya. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />Bakati batjimile betjakatjenamisiwa nayikoku, bakabona babemile nebalume babili bakambala zwiyambalo zwinopenya; <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />ngentha yehla bakakotamisa miholo pasi, ibabo banhu beba beti, “Mohakilani umpenyu kubafi? <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />Aatapo pano, wamuka, kumbulani tjaakamubudza etji kuGalile, <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />wakati, ‘Nkololo wenhu wakafanila tengesewa kubatjinyi, akakowhomegwa, muhhuba lebutatu unowhomuka.’ ”<verse eid="LUK 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8" />Bakaalakana matama awe, <verse eid="LUK 24:8" /><verse number="9" style="v" sid="LUK 24:9" />bakati bahanduka bebva kukumbu, bakabudza badiyiwa bali gumi lina un'ompela nebamwe bose kose ikoku. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />Kwaka kuli Mariya wekuMagadala naJowana naMariya mayi baJakobe nebamwe babaka banabo, bakabudza bapositoli; <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />koga matama iyawa akanga zwilebo zwisina mano, abazobagalamoyo. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />(Koga Phethiro wakamilika elabuka eyenda kukumbu, wakati eswika ehohhela mukumbu, akabona matjila elineni woga, akamilika eyenda ezwibhuzwa kuti ini tjayetika.)<verse eid="LUK 24:12" /></para>
  <para style="s">Gwendo Gweku Emawusi</para>
  <para style="r">(<ref loc="MRK 16:12">Mako 16.12</ref>,<ref loc="MRK 16:13">13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />Hhuba ilelo zwalo bamwe babo babili baka beyenda kunzi unoyi Emawusi, kungaba mamayili ali kutondeka ubva muJerusalema, <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />baka beyenda belebeleka nekwezwinhu zose izwezwi zwayetika. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />Bakati batjazuwa belebeleka nekwezwinhu izwezwi, Yesu tjekukwe akasedzela, akabhatisana nabo zila. <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />Koga meho abo akakon'wa wunziba. <verse eid="LUK 24:16" /><verse number="17" style="v" sid="LUK 24:17" />Eba eti kubali, “Moyenda muzuwa nekweni kene?”</para>
  <para style="p" vid="LUK 24:17">Bakama, belingika besakahanha. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />Umwe wabo, unoyi Kilopasi, waka wun'handula eti, “Umwezi kani muJerusalema usingazibe zwayetika ko mumahhuba iyawa?”<verse eid="LUK 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19" />Eba eti kubali, “Zwinhu zwipi?”</para>
  <para style="p" vid="LUK 24:19">Beba behandula beti, “NekwaYesu wekuNazaretha, waka ali nlebesambeli ana masimba makulu mumatama nemukuyeta, mbeli kweNdzimu nebanhu bose. <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />Nekuti baphirisiti bakulu nebatungamili bedu bakawunsungisa kuti atongegwe lufu, bekawunkowhomela. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />Koga taka tagalabgwe kuti ndiye unowhosunungula Isirayeli. Pehhugwi kwayikoku kose, ileli ihhuba lebutatu kwayetika ikoku. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />Kakale bamwe bomme bebunga ledu batitjenamisa nasi, bayenda mahhakuyedza kukumbu <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />mbili uwe bakawun'haya; kakale bahanduka beti babona mbono webatumwa bekudzimu, bakababudza kuti umpenyu. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />Bamwe batatili toseni bayenda kukumbu, bakanowana kuli sekwalebgwa nebafumakadzi; koga iye tjekukwe abazowumbona.”<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />Iye eba eti kubali, “Imwi zwilengwe, mimoyo yenyu inononoka galamoyo kose kwakalebgwa nebalebesambeli! <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />Kwaka kusakafanila kene kuti Khirisitu adziyidzike nayiyeyi zila ekotjingina mugudzo lile?” <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />Wakabatjenesela tjakalebgwa nekukwe muwhalo, etangisila kuna Mozisi, nebalebesambeli bose.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />Batjiba pedlo nenzi wabaka beyenda kuwunli, iye wakathama senhu unopinda, <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />koga bakawunkumbilisisa beti, “Yezela pano naswi, ngobe kwatjihwa, hhuba lamila.” Wakangina akagala nabo. <verse eid="LUK 24:29" /><verse number="30" style="v" sid="LUK 24:30" />Nelubaka edla nabo, wakatola tjinkwa, akaboka, akatjipemula akabapa itjo. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />Meho abo akahhulika bakawunziba; eba emila mbeli kwabo. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />Bakabhuzwana beti, “Tatisingawhe kuhanha mumimoyo yedu lubaka gwayelebeleka naswi muzila, etitjenesela whalo?”<verse eid="LUK 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33" />Bakamilika tjinyolotjo bakabgwilila kuJerusalema; bakanowana badiyiwa bali gumi newun'ompela bakakubungana nebamwe babaka banabo, <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />bakati kubali, “He bamuka kwemalebeswa, bazwilakidza kuna Simoni!”<verse eid="LUK 24:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35" />Ibabo babili bakababudza tjayetika bali muzila, nekuti bakakowunziba tjini epemula tjinkwa.<verse eid="LUK 24:35" /></para>
  <para style="s">Yesu Unozwilakidza Kubadiyiwa Babe</para>
  <para style="r">(<ref loc="MAT 28:16-20">Matewu 28.16-20</ref>; <ref loc="MRK 16:14-18">Mako 16.14-18</ref>; <ref loc="JHN 20:19-23">Johane 20.19-23</ref>; <ref loc="ACT 1:6-8">Mihingo 1.6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />Bakati betjalebeleka, Yesu tjekukwe akama pakati kwabo, akati, “Kunyalala ngakube kumuli.”<verse eid="LUK 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37" />Bakalobgwa nehana, bakahla bekumbula kuti babona puku. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />Iye akaba eti kubali, “Ngentha yeni mudziyidzika, nentha yeni muna kubvubvuma mumimoyo yenyu? <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />Lingani maboko nemakumbo angu; ndimi, mundibhate mubone ngobe puku atjina mafupa nenyama sekwamunobona ndinako.”<verse eid="LUK 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40" />Wakati eleba ejalo akabalakidza maboko nemakumbo awe.<note caller="+" style="f"><char style="fr" closed="false">24.40 </char><char style="ft" closed="false">dzimwe whalo whulukugwi adzina vesi 40</char></note> <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />Kwakati besanhu bakagalamoyo tjabanobona ngentha yehanha netjenama, akaba ebabhuzwa eti, “Muna tjinodliwa pano kene?” <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />Bakawumpa nhango yewhobe yakagotjewa, <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />wakayitola akayidla mbeli kwabo.<verse eid="LUK 24:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44" />Ekotjiti kubali, “Ndiwo matama angu andakamubudza iyawa, lubaka titjitoseni, kuti kose kwakakwagwa nekwangu munlayo waMozisi nebalebesambeli nemunjimbo kwakafanila hhadzisika.”<verse eid="LUK 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45" />Ipapo wakabahhula mikumbulo kudze bawhisise whalo, <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />akababva eti, “Ndizo kwakakwagwa, kuti Khirisitu wakafanila dziyila ekomuka kubafi muhhuba lebutatu, <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />kose nekuti handuka neyetigwa mazwibhatigwa matjinyo kwakafanila sumikigwa muzina lile kuzwitjaba zose kutangisila muJerusalema. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />Imwi muna busupi nekwezwinhu izwezwi. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" />Lingani, ndowhomutumila tjamakagadziwabgwe naTate bangu; koga mugale munzi-nkulu, kuswikila mangin'wa nemasimba anobva pehhugwi.”<verse eid="LUK 24:49" /></para>
  <para style="s">Wulukila Kudzimu kwaYesu</para>
  <para style="r">(<ref loc="MRK 16:19">Mako 16.19</ref>,<ref loc="MRK 16:20">20</ref>; <ref loc="ACT 1:9-11">Mihingo 1.9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />Wakabhuda nabo, akabatungamila bakayenda bakadza bakanoti kuBhethani, akamilidza maboko awe, akabakombolela. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />Kwakayetika kuti atjabakombolela, wakapalalanyiwa nabo, akatogwa akawulukila kudzimu. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />Bakawunamata, bakabgwilila kuJerusalema bakahanha kwazo, <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />bakagala tjoselele beli muthempeli, belumbidza beboka Ndzimu.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>