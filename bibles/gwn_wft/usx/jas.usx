<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Gwandara</book>
  <para style="toc3">Yak</para>
  <para style="toc2">Yakubu</para>
  <para style="toc1">Takada Dege Anya Yakubu</para>
  <para style="mt2">Takada dege anya</para>
  <para style="mt1">YAKUBU</para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />Takada mu butu dege anyana Yakubu, bunwa ni Mirikisi nja Obagizi Yesu Kiristi,</para>
  <para style="p" vid="JAS 1:1">Manki ta anya juriya gom sha bi de su yaapi a siki durinya:</para>
  <para style="p" vid="JAS 1:1">Mma yi ku gesuwa.<verse eid="JAS 1:1" /></para>
  <para style="s">Beigaskye N/ ja Simi</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />Yayuwa na, Ema ku mbo peri siki nde ku geni kiya ku a siki gwada a kowoni turiki, <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />sobon ku shina nkye gwada ni beigaskye ku a siki Obagizi yaa zo ku takuwa. <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />Se takuwa ku a siki Obagizi gama ANKI yi na kwa ma dedeta ntani a siki Yesu Kiristi, de kwa lesa mbodaa ba. <verse eid="JAS 1:4" /><verse number="5" style="v" sid="JAS 1:5" />Nde nseda ku lesa simi, bilade e minya Mirikisi de ma ba konwawa simi teke ba nonwa; yomu na Mirikisi yaa beyi simi. <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />Sede nde ka yi lepa, dole na ki beigaskye kede ki ma nsu dishiya bi, sobon nsude mani dishiya bi ema kankye nyanye de angwe ruwa, pula yi ma ta kowoni anga. <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />Nde ki te ma yomu, kede ki sa dishiya nkye ka samu mbode ka bila anya Mirikisi, <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />sobon ema nsu dishiya bi la, e sa ankeli yi anya daakaka ba a siki guru mbode ema yi.<verse eid="JAS 1:8" /></para>
  <para style="s">Nsu Mbo nani nja Potoruwa.</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />Yayuwa de su ma potoruwa a siki nsubiya Yesu su yi peri siki nde Mirikisi dege su a bisi. <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />Sede Yayiwa de mani mbo nani kede e la kiya yi ema mbodaa na, sobon mbo nani yaa bise kankye pure sanwa. <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />Sobon nde nana butu yi dimi yaa sa sanwa kyekeri, pure yi yaa puari a kisi. kyawu yi yaa bebeta. Yomu na, nsu mbo nani sua muntu bila mbo nani su, a siki yuru nja butu ni ANKI yi.<verse eid="JAS 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />Anabirika ma nja nseminji de yi dishiya a siki gwada, sobon nde e yi dishiya a siki gwada mu, e shiya yaa keleba nani wuta nleyi ni gbogbo de Mirikisi yi anikowori de yaa ba worede sua so yi.<verse eid="JAS 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 1:13" />Dun nsude samu gwada, kede nkye, &lt;&lt;Mirikisi na ma gwada ni.&gt;&gt; Sobon Mirikisi yaa taba gwada nsebeki ni mbo mumungu ba, Mirikisi nkiya yi yaa gwada nseda ba; <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />Sede kowoni nsebeki, te anya mumungu memeri dishiya e yi de shirigye yi, yaa sa nki yi a siki mumungu mbo. <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />Anya ni, mungu tunani de ki boyi a siki ke, yaa yapu lepi; nde ki te sigeba nlepi, yaa keyi ke ta muntu.<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />yayuwa na de ma so, Kede nseda shirigye ku. <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />Kowoni mbo kyakyawu nja dedeta kyawuta butu dege anya Mirikisi Adaa mu ni bisi, e shi de ki la asikye ni bisi, guru mbo worosu mu sua juyi, sede Mirikisi yaa juyi ba. <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />Mirikisi zabi mu de muma yaya yi de su yapu te anya kelima beta yi ni gaskye, de muma yaya yi ni pari ni kowoni mbode yi.<verse eid="JAS 1:18" /></para>
  <para style="s">Zi Nja Yi</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />Yayuwa na, worede mma so, ku shina ni mbo mu: Konse ema ni seberi zi, sede kede ema nsu seberi beta nja seberi anwashi ba, <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />sobon anwashi ni nsebeki yaa taba sayi zunwa gangasi anya Mirikisi ba. <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />Nkayomu, ku bila guru mbo rebi, nja mungu ali de gyewe ku, ku bwala kiya ku de ku keleba kelima beta ni Mirikisi a dishiya ku, de e sila ku.<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />Sede kede ku ma nsu zi kelima beta Mirikisi kin ba, nde ku yi yomu kuma shirigye kiya ku naka. Sede ku yi mbode Mirikisi pala. <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />Dun nseda de zi kelima beta Mirikisi, sede nde e yi mbode yaa pala ba ema kankye nsude kone pusika yi a mudubi <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />se a beyi de e kone kiya yi, de e te mayi dandani e mosi yiride kamani e yi ma. <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />Sede nsude beyi ankeli anya karanta beta Mirikisi mu de e shina ma nsu zon yenshi, Mirikisi yaa sa yi anabirika a siki guru mbode ema yi, nde ema nsu zi na kin e kwa mosi ba, sede ema nsu yi anki nshi.<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />Nde nseda yaa kone nki yi kankye ema nsubiya Yesu na, sede nde yaa ka baki yi ba ema shishirigye kiya yi nja biya Yesu yi ma wopi na ka. <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />nsude yaa so biya Mirikisi Adaa mu ni gaskye ema dole na e kula nja yaya male yi nja mata makeyi a siki ni beki siki asu nja e tele kiya yi de kede mbo mumungu durinya mu e bebeta yi.<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s">Kwabe A kiya Nana Bombom</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />Yayuwa na, nsubiya Yesu Obagizi nsu dereja a siki Yesu Kiristi, kede ku nana bombom. <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />A siki tala ku nde nseda zo ni keikei nsu gyolo nyowa ni arika ni zinari, se potoruwa nse sa kukukyo keikei e shi ma du zo a siki tala ku. <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />Nde ku beyi ankeli ku anya nseminji de sa keikei kyakyawu ku nkye, &lt;&lt;Zo de ki zunwa a kingbolo kyakyawu mu,&gt;&gt; Sede ku gye potoruwa nseminji nkye, &lt;&lt;Ki sakisi anya ni&gt;&gt; ko &lt;&lt;Ku nkye zo de ki zunwa a kisi,&gt;&gt; <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />Nde ku yi yomu, ku nana bombom nja nkyaku naka nja ku yi shiriya ni mumungu tunani a dishiya ku naka bo?<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />Ku zi, yayuwa na de mma so: Mirikisi zabi worede su ma potoruwa a siki durinya mu de su ma nsu mbo nani a siki beigaskye nja de su si gado solota de Mirikisi yi anikowori ba worede su so yi. <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />Sede ku nene potoruwa ntani. Ba nsu mbo nani la su sa ku Genbeki bo? Ba osu na su ma keyi ku ta anya anikari a laki shiriya bo? <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />nsu mbo nani osu na su ma worede su ma pala beta saba a kiya seni Yesu Kiristi nja du oku de kuma na yi bo?<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />Nde kuma nsubiya doka de ma a siki takada Mirikisi amu: de pala nkye &lt;&lt;Ku so dengeri ku yiride kwa so kiya ku,&gt;&gt; nde ku yi yomu, ku yi kyakya. <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />Sede nde ku nana bombom nja nkyaku ku shina nkye e ma lepi nja kuma nsu watala doka Mirikisi naka. <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />Du nsude biya guru doka mu se keriya ndandaa e ma kankye keriya guru doka naka. <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />Mirikisi de pala nkye, &lt;&lt;Kede ki kwana nja mata nseda,&gt;&gt; e kwa pala nkye, &lt;&lt;Kede ki kisa nse.&gt;&gt; Nde ki kwana nja mata nseda ba sede ki kisa nseda, e ke ki ma nsu watala doka naka.<verse eid="JAS 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 2:12" />Sobon yomu beta ku nja zunwa ku e ma kankye worede sua yi su shiriya a siki doka de yaa ba ku yenshi, <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />sobon Mirikisi yaa taba zi toseyi worede su ma zi toseyi nse ba. sede toseyi yaa shakiya ni shiriya.<verse eid="JAS 2:13" /></para>
  <para style="s">Beigaskye Nja Anki</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />Yayuwa na, mina ma kyawu e yi de nsebeki nkye e mani beigaskye sede beigaskye e yi nana anki e yi ba. Beigaskye e yi yaa sila nshi? <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />Kuzukam, nde yayiwa ni minzi ko ni mase de mani keikei sa ba ko mbosi ni si kowoni nana ba. <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />Nde nseda ku gye su nkye, &lt;&lt;Ku sonka lapiya! Mirikisi e ba ku mbosi nja keikei de kwa sa!&gt;&gt; sede e ba su mbode sua bila ba, mina ma kyawu yi? <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />Yomu na, nde beigaskye e te mani ANKI ba, e ma mumuntu.<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />Sede nseda yi yaa pala nkye, &lt;&lt;E ke ki ma ni beigaskye; E ni Ni mani ANKI.&gt;&gt;</para>
  <para style="p" vid="JAS 2:18">Nana ni beigaskye ake de mani ANKI ba, e ni Na nana ke beigaskye te anya ANKI de mma yi. <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />Ku yeda nkye Mirikisi ma daa la? e man kyawu! Ko arizeni osu ma su yeda yomu, ari sua yi womba.<verse eid="JAS 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JAS 2:20" />Eke Odundu nsebeki ko ka bila de nnana ke beigaskye de mani ANKI ba e man wopi la? <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />De adaatolo mu Abireyi la yaa e yi Ishaku beyi sedeka anya ni beyi sedeka, ba te anya yi na Mirikisi nkye e ma nse gangasi bo? <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />Ku geni de beigaskye nja anki ni Abireyi su meyi tepiya gabada, sobon yomu beigaskye e yi sika te anya anki yi. <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />Yomu na takada Mirikisi sika de pala nkye, &lt;&lt;Abireyi yeda ni Mirikisi, sobon yomu Mirikisi sa e yi a siki ntani de su ma gangasi,&gt;&gt; Mirikisi sukwa e yi nkye oboki e yi. <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />Ku geni, nsebeki yaama mere lepi te anya beigaskye kin naba sede te anki kyakyawu de e mayi du.<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />Yomu na du, Rahab de ma mase kilaki Obagizi la e yi ma nse gangasi sobon de e yi mbo kyakyawu na bo? de e boyi Izireyila de su zo kone nja de e sa su biya turiki daa mbom na bo? <verse eid="JAS 2:25" /><verse number="26" style="v" sid="JAS 2:26" />Yiri de nki de mani aworo ba e ma kankye gan, yomuna beigaskye de mani ANKI ba e ma kankye gan.<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s">Arishiya Mumungu</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />Yayuwa na, kede nyowa ku su ma nsu Male ba, sobon ku shina nkye omu de ma male ni beta Mirikisi sua yi mu shiriya de pi ni ririgye ntani. <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />Guru amu mua yi kusukuri a turiki nyowa. Nde nsude yi lepi a siki mbo de yaa pala ba, e sika nsebeki naka, yaa kpanku nki e yi guru.<verse eid="JAS 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JAS 3:3" />Nde mu sa nizami a baki ni doki de e yi mbode mua bila de e yi, mua yi yaa juyi nki doki mu. <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />Ko mu la kwanto totolo de ema misali. Kode nkye kwanto e ma totolo akusuka nsu sori yaa yiri yi, sede ni gwala piri na nsu tunkwa kwanto yaa juyi ta a turiki de sua so. <verse eid="JAS 3:4" /><verse number="5" style="v" sid="JAS 3:5" />Yomuna arishiya ma ganga dende a siki nki, sede yaa pala mbo totolo de pi sori e yi. Kone yiri de totolo sanwa yaa suwuta guru ni arishiya wuta dende.<verse eid="JAS 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JAS 3:6" />Arishiya nsebeki ema kankye wuta la, yaa shiriya mungu mbo a siki ganga ni nki guru. Arishiya yaa bebeta zunwa ni nsebeki, e kwa alaka ni leyi ni nsebeki ni wuta, ema wuta de butu yiri gizi wuta la.<verse eid="JAS 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 3:7" />Guru yiri nama bikiya, nsusuwa, alankpa nja nama de su ma a siki riki nsebeki na yaa sa su de su yi mbode yaa so. <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />Sede ba nsude yaa shakiya ni arishiya e yi ba. Yaa taba pushe ni yi mungu mbo ba, e ma ni kapi de yaa kisa nsebeki.<verse eid="JAS 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 3:9" />Ni arishiya na mua yobo Obagizi nja Adaa amu, nja shi na mua pala bebeki beta gyen ntani, sobon Mirikisi yi mu a siki kamani e yi la. <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />Butu a siki baki amu na mua yobo Mirikisi nja basi ntani. Yayuwa na, nsubiya Yesu mbo mu e yi kyawu yomu ba. <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />Riki kyakyawu nja riki de mani giri sua butu a ndani riki daa ba? <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />Yayuwa na, ntasi bori yaa yapu yaya ni zetu, ko akayam yaa yapu bori? yomuna ndani riki kyakyawu yaa taba butu riki mumungu ba.<verse eid="JAS 3:12" /></para>
  <para style="s">Simi Yiri Bi</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />Waa man simi nja shina a siki aku? Bila de e nana simi e yi a siki kyakyawu ali e yi, te anya ANKI bwala kiya de yaa yi na e butu a siki ni simi. <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />Sede nde kwa yi zunwa mumungu nja kwa yi kishi nja nkiku nja kwa yi sokiya a siki dishiya aku, kede ku dukwa geba a kiya yi ko ku ki gaskye. <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />Yiri &lt;&lt;Simi mu&gt;&gt; e butu a bisi anya Mirikisi na zo ba sede e ma ni durinya la, e ma ni seki ba, e ma ni obiri la. <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />Sobon anya de kishi nja sokiya ma a siki e yi, kwa samu dege dishiya nja kowoni yiri mungu mbo.<verse eid="JAS 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 3:17" />Sede simi de butu anya Mirikisi ni pari e shina e man seki; zunwa selema nja so ntani, nja nsu so kula ni ntani, nja buala kiya, nsu toseyi nyowa, e ma nana bombom ba ko zunwa munabuki <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />nsu zunwa selema nja ntani sua sa ntani su yi zunwa gangasi nja Mirikisi.<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s">Beyi Kiya Ke Ba Mirikisi</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />Mina yaa zoni rikishi nja topula a siki aku? Sobon mumungu mbo de sua yi yanki a dishiya ku bo? <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />Kwa bila mbo ku samu ba. ku kisa nse nja yi kyashi, sede ku samu mbode kwa bila ba, se kwa yi topula nja rikishi nzun yomu ku samu ba, sobon ku ologba Mirikisi ba. <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />Se ku minya Mirikisi, e ba ku ba, sobon ku minya ni mungu nupi, kwa bila de ku yi anpani nshi a turiki de ma kyakyawu ba.<verse eid="JAS 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 4:4" />Oku ntani mere aminshi, ku shina nkye yi oboki nja ntani durinya yaa sa geba nja Mirikisi na bo? Du nsu de e zabi de yi oboki nja durinya e ma oboki geba ni Mirikisi naka. <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />Ko kwa yi tunani e ma kokowe la de takada Mirikisi pala nkye, aworo de ma a siki mu yaa samu de mu so Mirikisi na kin? <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />Sede Mirikisi ba mu aniyeri e yi nyowa. E shina sa takada Mirikisi pala nkye:</para>
  <para style="q1" vid="JAS 4:6">&lt;&lt;Mirikisi yaa yi geba nja nsu dege dolo</para>
  <para style="q2" vid="JAS 4:6">Sede yaa beyi aniyeri e yi ba worede su ma bwala kiya su.&gt;&gt;<verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />Sobon yomu ku beyi kiya ku, te nja Mirikisi. Ku yi geba nja obiri, se obiri yaa yi gudu bila ku. <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />Ku zo mala Mirikisi, e shi ma du yaa zo mala nku. Oku nsu lepi, ku bila yi lepi, de ku yi mbo kyakyawu, oku nsu dishiya bi. <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />Ku yi kuka, ku yi beki siki nja anwe. Dala ku e ma kuka nja peri siki ku e ma beki siki. <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />Ku bwala kiya ku a geba Obagizi, se Mirikisi yaa la ku a bisi.<verse eid="JAS 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />Yayuwa, kede ku ma nsu pala beta mumungu a kiya yayiwa a beyi e yi ba. Du nsude e yi beta mumungu a kiya yayiwa yi e yi lepi. Nde ki ki biya mbode Mirikisi pala ki ki biya doka e yi naka, a kiya yomu ka nana nkye ka yi doka shiriya naka. <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />Mirikisi na kin e ma nsu bayi doka nja nsu shiriya, waa ma e ke de ka yi dengeri ake shiriya?<verse eid="JAS 4:12" /></para>
  <para style="s">Dukwa Geba A kiya Gobe</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />Kuzukam ku zi ni, oku de kwa nkye, &lt;&lt;Yawu ko gobe mua te anya mu ko geri nsuni, mua yi shekera anya ni de mu yi bije mu samu riba gyolo nyowa.&gt;&gt; <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />Mina sa kwa pala yomu, ku taba shina mbo de yaa paru gobe ba. Ki shina ko yaya na leyi ke yaa ma? ki ma kankye gidagida na de yaa butu kwanki piri se e beta. <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />E yi kyawu de ku pala nkye, &lt;&lt;Nde Obagizi yeda ko nde muma ni leyi mua yi nsu mu ko nsuni.&gt;&gt; <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />Sede, kwa dege dolo nja dukwa geba. Guru dukwa geba aku e ma mungu mbo la <verse eid="JAS 4:16" /><verse number="17" style="v" sid="JAS 4:17" />Sobon yomu du nsude shina mbo kyakyawu de e kamata de yi se e yi ba, e yi lepi naka.<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s">Su Gila nsu Mbo Nani</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />Kuzukam, ku zi ni oku ntani nsu mbo nani, ku yi kuka nja kuruwa sobon beki siki de yaa zo a kiya ku. <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />Mbo nani ku e rubu, ngana sua suku keyi sa nki ku. <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />Aziripa nja zinari aku sua bebeta. Se sikwa asu yaa ma sheeda a kiya aku nkye kuma nsu nonwa nja yaa suku nama nki aku kankye wuta. Oku de ku tala mbo nani aku nana karishe. <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />Kone! ku ki ba worede su yi ku ANKI a bikiya aku gyolo asu, nsu yi ANKI mu su ma yi kuka. Kuka ni nsu yi ANKI mu e keyi anya ni Obagizi nsu girima. <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />Ku yi zunwa zi dadi a siki durinya nja zunwa yiride kwa bila. Ku yi nki kankye timshiya de yaa pekye nana yanka. <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />Ku bebeta ntani mere lepi nja ntani gangasi ku kisa su, ku nkye su ma nsu lepi su kuma yi geba nja ku ba.<verse eid="JAS 5:6" /></para>
  <para style="s">Kadishiya A siki Genbeki</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />Sobon yomu, yayuwa, ku kadishiya ari nana de Obagizi yaa zo. Kone yiri kadishiya de nsu bikiya su mayi sua pekye ari kwanki de mbo bikiya yaa yi kyakyawu yaa kwa pekye de riki ni nunkwa nja riki karishe. <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />Oku ma du, ku yi kadishiya nja ku sakisi nsori, sobon zo ni Obagizi yi kusa. <verse eid="JAS 5:8" /><verse number="9" style="v" sid="JAS 5:9" />Yayuwa, kede ku yi mumungu beta nja nkiya ku, sobon kede Mirikisi e yi ku shiriya. nsu shiriya e yi kusa de e zo!<verse eid="JAS 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 5:10" />Yayuwa, ku kokoyi kadishiya nja takuwa anya nsu anebi de su Genbeki anya pala beta a siki seni Obagizi, ku biya seni tepiya asu de su sakisi nsori a siki Genbeki. <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />Yiride ku shina, mu la worede su sakisi nsori su ma nsu anabirika la. Ku zi yiride Ayuba sakisi nsori nja ku geni mbode Obagizi zo yii nshi a karishe. Obagizi de sika ni toseyi nja aniyeri.<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />Yayuwa na, totolo mbode mma bila de ku shina e shiya ma, kede ku melese ni bisi ko ni kisi ko ni mbodaa jaja. Bila de &lt;&lt;Ee&gt;&gt; aku e ma &lt;&lt;ee&gt;&gt; nja &lt;&lt;Yi,&gt;&gt; aku e ma yi, sobon kede Mirikisi e yi ku shiriya.<verse eid="JAS 5:12" /></para>
  <para style="s">Lepa Ni Beigaskye</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />Ko nse daa ma a siki aku de ma Genbeki? se e yi lepa de Mirikisi e sua yi nto. Ko nse daa ma a siki ku de mayi peri siki? Se e yi wonka ni yobo Mirikisi. <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />Nde nse daa a siki aku ma yi suwo? e sukwa toree ni nsubiya Yesu de su zo yii lepa, su nya yi mayi a kiya a siki seni ni Obagizi. <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />Sobon lepa de su yi a siki beigaskye yaa sa nsu suwo yaa worikye; Obagizi yaa dege yi a bisi. Nde e yi lepi, Mirikisi yaa yape yi lepi e yi. <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />Nkayomu ku gye nkiya ku lepi aku se ku yi nkiya ku lepa sobon de Mirikisi e worikye ku. Lepa ni nse gangasi e ma ni sori nja yaa yi anki. <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />Iliya ma nsebeki na kankye omu. E yi lepa soseyi de kede Mirikisi e zon riki ni bisi, Mirikisi kwa yi riki ba ni shekera wuku ni rebi. <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />De Iliya kwa sakye yi lepa, se bisi sonka riki, kisi kuma butu ni mbosi. <verse eid="JAS 5:18" /><verse number="19" style="v" sid="JAS 5:19" />Yayuwa na, nde nseda ku bila turiki gaskye se nse daa keyi zo a turiki, <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" />Nseni e shina nkye: Du nsude juyi nsu lepi bila mungu mbode e mayi e sila nshi dege muntu kuma e ripe lepi nyowa .<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>