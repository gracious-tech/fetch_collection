<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Gwandara</book>
  <para style="h">1 Tasolonikawa</para>
  <para style="toc1">Takada ni Bulusu ni Pari ta Tasolonikawa</para>
  <para style="toc2">1 Tasolonikawa</para>
  <para style="toc3">1 Tas</para>
  <para style="mt2">Takada Bulusu ni Pari ta</para>
  <para style="mt1">TASOLONIKAWA</para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />Manki butu anya Bulusu, nja Selasi, nja Timoti,</para>
  <para style="p" vid="1TH 1:1">Te anya nsubiya Yesu de su ma a siki Tasalonika de su ma ni Mirikisi Adaa mu nja Yesu Kiristi:</para>
  <para style="p" vid="1TH 1:1">E ni Bulusu mma yi ku lepa de Mirikisi e yi ku Aniyeri nja keseyi dishiya e ma nja ku.<verse eid="1TH 1:1" /></para>
  <para style="s">Beigaskye ni Tasalonika Nja Yiri zunwa Asu A siki Beta Mirikisi</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />Mua gbede Mirikisi a kiya aku guru kowoni nana, mua yi lepa sobon ku. <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />Mua turunwa nku a geba Mirikisi nja adaa mu a kiya ANKI aku ni beigaskye de kwa yi, nja so de kwa yi, ni kadishiya de ku man shi ni sa dishiya a siki Obagizi Yesu Kiristi. <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />Yayuwa de Mirikisi yaa so, mu shina nkye, Mirikisi zabi ku de kuma yaya e yi, <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />Sobon manki amu zo anya aku ni soki kelima ba, sede ni sori Mirikisi, nja Aworo, nja yeda dishiya. Ku shina yiri zunwa kyakyawu de mu yi a sisika aku. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />Ku kokoyi anya mu nja Obagizi; kode nkye ku Genbeki nyowa, nzun yomu ku keleba manki anya Aworo Mirikisi ni peri siki. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />Yomuna kuma mbode sua kokoyi anya guru nsubiya Yesu ni kesa Makidoniya nja Akaya. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />Manki Mirikisi Butu anya ku ba Makidoniya nja Akaya kin naba, sede nabari beigaskye aku a siki Mirikisi su shina anya guru. Nkayomu mu mani mbodaa de mua pala a kiya e yi ba, <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />sobon ntani a kowoni anya sua pala yiride ku keleba su. Su pala yiri de su juyi bila boka de su biya Mirikisi nsu leyi nja nsu gaskye, <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />de ku pekye Yaa yi de butu a siki bisi, Mirikisi dege Yaa ni a kumsha, Yaa yi e shiya ma Yesu de butu mu bila Genbeki de yaa zo.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">Anki Mirikisi de Bulusu Yi A Tasalonika</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />Ku shina, Yayuwa, zo amu anya aku e ma wopi abo. <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />Yiri de ku shina mu rigye Genbeki nja basi a pilibi, sede mu yeda Mirikisi amu de samu mua beyi manki ko de ntani nyowa sua yi geba nja mu. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />Yayuwa manki Mirikisi de mu keyi ku e ma kusukuri ko mumungu na ba, ko kwa mua yi kokori de mu shirigye ku naba. <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />Sede mua keleba manki ba ku yiri de Mirikisi yeda de mu yi. Ba mua so de mu bwala ku dishiya naba sede Mirikisi de ba mu, E shi de yaa gwada dishiya amu. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />Ku shina mua yi zanki baki na ba, ko mua sa mbode mu ripe baki de mu boyi opu na ba, Mirikisi e shiya ma sheeda amu. <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />Mua bila yobo anya ntani, ko anya nseda aku na ba.</para>
  <para style="p" vid="1TH 2:6">Ko de nkye muma yayamanki ni Kiristi mua ma ku loni ba, <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />sede nzun yomu muma nsu soki kiya nja ku, yiride amaa yaa goyi yaa e yi dende. <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />Sobon de mua so ku soseyi na sa mu zi dadi keyi ku manki nabari Mirikisi, ba manki Mirikisi kin ba sede ku jima mu a dishiya nja mbo kyakyawu de kwa yi. <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />Yomu na, yayuwa ku turunwa, pama mu nja Genbeki de mu geni; mbode sa mu yi ANKI ndederi ni nana de kede mu ma ku loni ba, kwanki de mua keyi ku kelima ni manki Mirikisi.<verse eid="1TH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10" />Ku ma sheeda la, yomu na Mirikisi ma sheeda mu du, yiride mu yi zunwa seki, nja zunwa Gangasi nja zunwa mere lepi de mu yi a sisika ku oku guru de ku yeda ni Mirikisi. <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />Nta yiride ku shina mu biya ku yiride adaa yaa yi nja yaya yi. <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />Mua ja ku sori guyam, nja kadishiya nja mua yi ologba ku de ku yi zunwa yiride Mirikisi yaa so, e shi de sukwa ku a gizi solota nja girima e yi.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />Mu sakye sigeba gbede Mirikisi, sobon de ku keleba kelima ni Mirikisi, de ku zi anya mu, ku yeda e ma kelima nsebeki na ba, sede yiride e ma, kelima Mirikisi, de yaa yi ANKI a siki ku oku de ku beigaskye. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />Oku, yayuwa, ku ma nsu kokoyi anya nsubiya Yesu Kiristi, de su ma a Yawudiya: Ku Genbeki nja ntani kesa aku yiri de nsubiya Yesu su Genbeki nja Yawudawa. <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />Yawudawa osu na su kisa Obagizi Yesu: nja anebi se su kula mu ta woze. Su dege Mirikisi la yi sua yi geba nja guru ntani <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />sua yi kokori de su nana mu beyi manki ba worede su ma Yawudawa ba, sobon de kede su samu sila. Yomu na kowon nana sua shika yi lepi. A karishe anwashi Mirikisi zo a kiya asu.<verse eid="1TH 2:16" /></para>
  <para style="s">Buri Bulusu Na De E geni Ntani Tasalonika</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />Sede, yayuwa, de mu juyi bila ku kwanki piri, a siki nki ba a dishiya ba, mua yi kokori de mu geni ku ndani nja ndani, <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />Mua so de mu zo anya ku, ni gaskye e ni Bulusu, kwanki ni kwanki, sede obiri tele mu. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />Mina ma sa dishiya amu, ni peri siki, ko lende de mua yi dolo a geba ni Obagizi amu Yesu nana de yaa zo, mba oku na ba? <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />Gaskye, ku ma mbo dege dolo amu nja peri siki amu.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />Sobon kwana bi de mu geni ku ba mu yi yaa ka dishiya ba, mu geni e yi kyawu de su bila mu atotolo geri ni Atina. <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />Sobon yomu na, E ni Bulusu nja Selasi mu saka Timoti, yayiwa nja oboki ANKI mu a siki ni anya ni beyi manki gangasi ni Kiristi, de ja ku sori nki nja ja ku sori guyam a siki ni beigaskye ku, <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />sobon de kede takaasi mu e sa nseda e butu ni dishiya e yi anya Mirikisi. Oku nkiya ku ku shina nkye Genbeki su yi mu sobon nshina la. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />Gaskye, a kwanki de muma nja ku, mu pala gye ku nkye mua sha takaasi. Yomu na e ma, yiri de ku shina. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />Sobon yomu na, ni yaa ka dishiya ba, beyi manki de ni zi nabari ni beigaskye ku. Ni puari geba sobon kede obiri nsu gwada e yuru a siki dishiya ku de takaasi mu e ma wopi.<verse eid="1TH 3:5" /></para>
  <para style="s">Manki Ja Sori Guyam Ni Timoti</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />Sede kuzukam de Timoti zo dege anya ku e keyi mu manki nabari kyakyawu a kiya ni beigaskye ku nja so aku. E pala gye mu nkye kuma turunwa mu kuma so de ku geni mu, yiri de omu ma mua so de mu geni ku. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />Nkayomu, yayuwa, a siki ni guru beki siki nja takaasi muma ni sori guyam a kiya ku sobon beigaskye ku. <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />Kuzukam dishiya mu bwala, tunde ku sakisi nsori a siki ni Obagizi. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />Woni yiri gbede na mua yi Mirikisi soseyi sobon ku, a kiya ni peri siki de muma nshi a geba Mirikisi sobon oku? <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />Ndederi nja nana mua yi lepa soseyi sobon de mu geni ku ndani ni ndani de mu ba ku mbode ku lesa nshi a siki beigaskye ku.<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />Kuzukam Mirikisi mu nja Adaa mu nkiya yi nja Obagizi mu Yesu e gyala mu turiki de mu zo anya ku. <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />Obagizi e sa so aku de kuma nshi e ja yowa nja konse nja guru ntani, yiri de omu ma muma yi ku nshi. <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />Mua yi lepa de Obagizi ja ku sori dishiya de kuma ntani de kuma mere lepi nja nsuseki a geba ni Mirikisi amu nja Adaa a nana de Obagizi mu Yesu yaa zo nja ntani e yi nsuseki.<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">Zunwa de Jima Mirikisi</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />A karishe, yayuwa, mu gye ku yiri de kwa yi zunwa de yaa jima Mirikisi, yiri de ku kokoyi anya mu. Kuzukam mua gama ku nja Obagizi Yesu de ku sigeba ni yi yomu kede ku bila ba. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />Sobon ku shina yiri doka de mu ba ku te anya ni yiko Obagizi Yesu.<verse eid="1TH 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 4:3" />Da mu nama nupi Mirikisi de e sa ku kuma nsuseki: sobon yomu ku bila ali lepi nungwe; <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />konse e shina yiri de yaa ka nki e yi a siki turiki de e mani seki, <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />ba ni mumungu memeri ba yiri ni worede ma Yawudawa ba su mayi, worede shina Mirikisi ba; <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />kede nseda e kwana nja mata yayiwa e yi ko e yi yayiwa e yi lepi a kiya mbo mu. Obagizi yaa yi guru nsude yi yiri lepi mu tala yiri de mu rigye gye ku mu sakye ja ku kuni. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />Mirikisi sukwa mu de mu yi zunwa dola naba, sede mu yi zunwa ni mere dola la. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />Sobon yomu guru nsude ki kokoyi de mu yi ku mu e ki nsebeki na ba sede e ki Mirikisi la, Mirikisi de ba ku Aworo e yi nsuseki.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />Kuzukam a kiya ni so kiya ku e kamata de mu rubuta ku nshi gagaba, sobon oku nkiya ku Mirikisi kokoyi ku nkye ku so nkiya ku. <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />Yomu na kuma ku so yayuwa ku guru a siki ni kesa Makidoniya. Nzun yomu yayuwa, mua gye ku, ku sigeba ni so nkiya ku ni gaskye.<verse eid="1TH 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 4:11" />Ku yi guru kokori aku de ku yi zunwa selema, de ku zi ni ANKI de e ma a geba ku nja ku yi ANKI ni nani aku, yiri de mu gye ku, <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />yomu na kwa man girima a geba ni worede su ma nsubiya Yesu ba de kede ku la leyi ja nseda ba.<verse eid="1TH 4:12" /></para>
  <para style="s">Zo ni Obagizi Yesu</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />Yayuwa, mua so de kede ku mani rishi shina a kiya ni worede su muntu ba, dun kede ku yi beki siki yiri de ntani, worede su mani sa dishiya ba. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />Mu beigaskye Yesu muntu e kwa dege ja yomu na mu yeda Mirikisi yaa dege worede su muntu a siki ni Yesu zo gabada nja Yesu. <verse eid="1TH 4:14" /><verse number="15" style="v" sid="1TH 4:15" />Mua gye ku yiri de beta Obagizi pala nkye, omu de mua man leyi, a kwanki de Obagizi yaa zo, mua rigye worede su muntu dege ba. <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />Mu beigaskye Obagizi nkiya yi e yi yaa sonka dege bisi, nja sukwa nsu sori, nja murinya totolo ni meleku nja wula koho ni Mirikisi, worede su muntu a siki ni Yesu na sua para dege a kumsha. <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />A beyi yomu, omu de mu man leyi de su bila mu sori Mirikisi yaa la mu yere nja su a siki ni gidagida de mu gomu nja Obagizi a bisi. Yomu na mua ma nja Obagizi gbogbo. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />Nkayomu se ku ba nkiya ku sori guyam nja kelima mu.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />Kuzukam, yayuwa, a kiya kwanki nja nana mu e kamata de mu rubuta ku nshi ba, <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />sobon ku rigye shina guru nkye nana ni Obagizi yaa zo kankye bolowa ndederi. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />Kwanki de ntani su ma pala nkye, &lt;&lt;mwa yi zunwa selema nja mwa yi zunwa lapiya&gt;&gt; dandani alaka yaa zo a kiya su, yiride zapi yapu yaa ka mase nsu siki, sua taba sila ba.<verse eid="1TH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4" />Sede oku, yayuwa, kuma a siki dopuwa naba, de nana mu yaa san ku kankye bolowa. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />Guru ku kuma yaya ni asikye nja nana la, Mu ma ni dederi ko ni dopuwa naba. <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />Sobon yomu, kede mu ma kankye worede su ma nsubiya Yesu ba, de su mayi kwana, sede mu yi zunwa ni kpanku nja ka nkimu. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />Sobon worede ma yi kwana, su mayi kwana ndederi la, nja worede su ma bugu, su ma bugu ndederi la. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />Sede tunde mu ma ntani nana na, se mu yi zunwa ni kpanku. Mu sa riga keripi ni beigaskye nja so, nja gongo ni sadishiya ni sila e ma kankye golonka ni tele kiya. <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />Mirikisi zabi mu de mu Genbeki yi ba sede mu samu sila anya Obagizi mu Yesu kiristi. <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />E shi de muntu sobon ni omu de ko mu man leyi ko mu muntu, mu zunwa nja nshi. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />Sobon yomu ku sigeba ni ja nkiya ku sori guyam nja ku sua nkiya ku nto, yiride ku kuma yi.<verse eid="1TH 5:11" /></para>
  <para style="s">Karishe Beta</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />Sede muma ologba ku, yayuwa, ku beyi girima te nja worede su ma yi pama ni ANKI a siki ku, worede su ma yi ANKI Obagizi nja worede su ma gila ku. <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />Ku geni su ni girima soseyi ni so sobon ANKI su. ku yi zunwa selema nja nkiya ku. <verse eid="1TH 5:13" /><verse number="14" style="v" sid="1TH 5:14" />Mwa ologba ku, yayuwa, ku gila worede su ma okyabo, ku ja worede dishiya asu muntu sori guyam, ku sa worede man sori ba nto , ku kadishiya nja nkiya ku. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />Ku kone kede nseda e lama mungu mbo nja mungu mbo, sede kowon kwanki ku yi kokori de ku yi mbo kyakyawu nja nkiya ku ni kuma konwawa du.<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />Ku yi peri siki a kowoni kwanki, <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />ku yi lepa a kowoni kwanki, <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />A siki kowoni ali guru ku gbede Mirikisi. da mu nama mbode Mirikisi yaa bila de ku yi a siki Kiristi Yesu.<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />Kede ku nana beta ni Aworo Nsuseki; <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />kede ku nene manki Mirikisi de butu anya ni anebi. <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />Ku gonta kowoni mbo: ku ka mbode ma kyakyawu <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />Ku kiyaye nkiya ku dege guru mbo mumungu.<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />Bila de Mirikisi de ma beyi selema e wonkye ku guru e kwa kiyaye aworo ku, nja dishiya ku, nja nki ku e ma mere dola ari nana de Obagizi Yesu Kiristi yaa zo. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />Mirikisi de sukwa ku e ma nsu aminshi la yaa yi mbode e pala.<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />Yayuwa, ku yi mu lepa. <verse eid="1TH 5:25" /><verse number="26" style="v" sid="1TH 5:26" />Ku geshe guru yayuwa ni runguma so nsuseki. <verse eid="1TH 5:26" /><verse number="27" style="v" sid="1TH 5:27" />Mma ologba ku a siki seni Obagizi de ku karanta takada mu te nja yayuwa guru.<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />Aniyeri ni Obagizi mu Yesu Kiristi e ma nja ku. E ma yomu.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>