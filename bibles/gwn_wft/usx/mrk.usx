<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">Gwandara</book>
  <para style="h">Marikusu</para>
  <para style="toc1">Manki te anya Marikusu</para>
  <para style="toc2">Marikusu</para>
  <para style="toc3">Mk</para>
  <para style="mt2">Manki te anya</para>
  <para style="mt1">Marikusu</para>
  <para style="imt">Kiya Beta</para>
  <para style="ip">
    <char style="bk">Manki te anya Marikusu </char> para nja kelima de nkye &lt;&lt;Nabari Kyakyawu a kiya Yesu Kiristi, Yaa ni Mirikisi.&gt;&gt; Yesu ma kankye woto nseminji nsu yiko. Yiko yaa nana a siki kokoyi yi, a siki sori yi a kiya arizeni, nja a siki yape ntani lepi su. Yesu yi beta a kiya e yi nkye e ma Yaa ni Mirikisi, nsude zo de beyi leyi yi de sila ntani dege lepi.</para>
  <para style="ip">
    <char style="bk">Marikusu</char> Beyi nabari Yesu a turiki tiriri, A turiki nsu sori, nja nana mbode Yesu yi, pi kelima yi nja kokoyi yi. E beyi beta kiya Yaaya nsu tunkwasa nja tunkwasa nja gwada ni Yesu, nsu rubutu dandani e la ANKI Yesu ni worikye nja kokoyi a bisi. Kwanki te a geba yayagizi Yesu shina yi soseyi, sede nsu yi geba Yesu su pi laki kwana yaya makaranta. Ripe ni beta sheeda mbode paru ni Yesu karishe mako ni leyi durinya, musama bishina yi nja dege yi.</para>
  <para style="ip">Bi karikye nja manki, de e ma a siki ni ripe la yi, Guru su la yi kankye rubutu de nseda yi de pi nsude ma pari yi <char style="bk">Marikusu</char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s1">Yaaya Nsu yi Tunkwasa Gyala Turiki</para>
  <para style="r">
    <ref loc="MAT 3:1-12">Mat 3.1-12</ref>; <ref loc="LUK 3:1-18">Lk 3.1-18</ref>; <ref loc="JHN 1:19-28">Jn 1.19-28</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Da mu nama nabari kyakyawu a kiya Yesu Kiristi, Yaa ni Mirikisi. <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />E ma rubuta a siki takada Anebi Ishaya nkye:</para>
  <para style="q1" vid="MRK 1:2">&lt;&lt;Na saka yaa manki na te a geba ke,</para>
  <para style="q2" vid="MRK 1:2">nsude yaa gyala ke turiki.&gt;&gt;<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />&lt;&lt;Murinya nsu sukwa a siki denka nkye,</para>
  <para style="q1" vid="MRK 1:3">&lt;Ku gyala turiki ba Obagizi,</para>
  <para style="q2" vid="MRK 1:3">ku gyala turiki tiriri beyi.&gt;&gt;&gt;<verse eid="MRK 1:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MRK 1:4" />Se Yaaya zo, yaa yi ntani tunkwasa a siki denka nja beyi manki tunkwasa ni juyi bila lepi nja yape lepi. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Se guru ntani kesa Yawudiya nja guru ntani Wurishelima butu te woze anya yi. Sua pala lepi su, Yaaya yaa yi su tunkwasa a siki totolo minya ni Joda. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />Yaaya sa keyi ni gesa nakurimi, e yi shompa ni pata a goto yi, ema suku ngirinya nja sha riki zuma. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Yaaya ema beyi manki nkye: &lt;&lt;A beyi na nseda de pi ni Yaa zo, de ko angwe takalami e yi ni deta de Na dure kunshe ba. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Ni yi ku tunkwasa ni riki, sede eshi yaa yi ku tunkwasa ni Aworo Nsuseki.&gt;&gt;<verse eid="MRK 1:8" /></para>
  <para style="s">Tunkwasa nja Gwada Ni Yesu</para>
  <para style="r">
    <ref loc="MAT 3:13-4:11">Mat 3.13—4.11</ref>; <ref loc="LUK 3:21">Lk 3.21</ref>,<ref loc="LUK 3:22">22</ref>; <ref loc="LUK 4:1-13">4.1-13</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />A kwanki ni Yesu zo a Nazere ni kesa Galili se Yaaya yi Yesu tunkwasa a totolo minya ni Joda. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />De Yesu ma butu dege siki riki, e geni bisi bure se Aworo Mirikisi sonka a kiya yi kankye nkurisha. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Se murinya butu a bisi nkye: &lt;&lt;Ki ma Yaa na la, de Na so; Na yi peri siki nja ke soseyi.&gt;&gt; <verse eid="MRK 1:11" /><verse number="12" style="v" sid="MRK 1:12" />Dandani Aworo Mirikisi te ni Yesu a siki denka, <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Yesu ma siki denka nana aribeni, Obiri ma gwada yi. Yesu ma nja nama bikiya, sede meleku zo ma kula nshi.<verse eid="MRK 1:13" /></para>
  <para style="s">Yesu Sukwa Yayagizi yi ni Pari</para>
  <para style="r">
    <ref loc="MAT 4:12-22">Mat 4.12-22</ref>; <ref loc="LUK 4:14">Lk 4.14</ref>,<ref loc="LUK 4:15">15</ref>; <ref loc="LUK 5:1-11">5.1-11</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />A beyi de su sa Yaaya a jaru, Yesu te a Galili, yaa beyi manki kyakyawu ni solota Mirikisi. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />Nkye, &lt;&lt;Kwanki yi wo,&gt;&gt; Ku juyi de ku yeda ni nabari kyakyawu. Solota gizi Mirikisi e yi kusa!&gt;&gt; <verse eid="MRK 1:15" /><verse number="16" style="v" sid="MRK 1:16" />De Yesu meyi tepiya a keteri totolo riki ni Galili, e geni Biturusu nja yayiwa e yi Anduru su ma kutiri eya a siki totolo riki, sobon su ma nsu ka gunda la, <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Yesu gye su nkye, &lt;&lt;Zo, de ku biya ni,&gt;&gt; &lt;&lt;Na sa ku de kuma nsu keyi ntani zo anya na.&gt;&gt; <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Dandani su bila eya asu su biya Yesu. <verse eid="MRK 1:18" /><verse number="19" style="v" sid="MRK 1:19" />De e sigeba piri, e geni Yakubu yaa ni Zabedi nja yayiwa e yi Yaaya a siki kwanto, sua gyala eya asu. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Dandani Yesu sukwa su, se su bila adaa asu Zabedi a siki kwanto nja nsu ANKI gyolo anya na su biya Yesu.<verse eid="MRK 1:20" /></para>
  <para style="s">Yesu Kula Mumungu Aworo</para>
  <para style="r">
    <ref loc="LUK 4:31-37">Lk 4.31-37</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Yesu nja yayagizi yi te Kapanawu, de nana asibi yi, Yesu te a siki kolonwa e para kokoyi. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Ntani su yi mamanki ni mbode yaa kokoyi, sobon e kokoyi su kankye nsude mani yiko, ba kankye male ni doka Musa ba. <verse eid="MRK 1:22" /><verse number="23" style="v" sid="MRK 1:23" />Dandani nseda de mani mumungu aworo a siki kolonwa yi kuruwa nkye, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />&lt;&lt;Yesu ni Nazere, mina ka bila nja mu? Ki zo de ki kisa mu la? Ni shina waa ma e ke, Nsuseki ni Mirikisi. <verse eid="MRK 1:24" /><verse number="25" style="v" sid="MRK 1:25" />Se Yesu kwabe mungu aworo nkye. &lt;&lt;Ripe baki ke!&gt;&gt; &lt;&lt;Ku butu bila yi!&gt;&gt; <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />Mumungu aworo kiriba yi a kisi ari nki yi yaa kakada se e butu bila yi ni kuruwa. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />Ntani su yi mamanki su ma minya nkiya su nkye, &lt;&lt;Kai! mina ma da mu? nsum ma sabuwa kokoyi aba, yaa yi beta ni yiko! Ari yaa ba mungu aworo doka sua biya.&gt;&gt; <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />Dandani nabari Yesu kakada guru gunduma ni Galili.<verse eid="MRK 1:28" /></para>
  <para style="s">Yesu worikye Ntani Nyowa</para>
  <para style="r">
    <ref loc="MAT 8:14-17">Mat 8.14-17</ref>; <ref loc="LUK 4:38-41">Lk 4.38-41</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Dandani de Yesu bila siki kolonwa, su te nja Yakubu nja Yaaya a gizi ni Biturusu nja Anduru. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Amaa ni mata Sima yaa yi suwo ni mashapo, se su gye Yesu mbode paru nshi. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Se Yesu te anya e yi, e keyi nani e dege yi a bisi. se dandani mashapo bila e yi ari e yi su mbosi. <verse eid="MRK 1:31" /><verse number="32" style="v" sid="MRK 1:32" />De nyema yi, nana puari, ntani keyi Yesu guru nsu worede su man suwo yiri yiri nja nsu arizeni. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Se guru ntani geri gomu a baki kopa de Yesu ma shi, <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />se Yesu worikye ntani nyowa worede man suwo yiri yiri. E kwa butu nsu arizeni nyowa, sede e bila arizeni yi beta ba sobon su shina ko waa ma shi.<verse eid="MRK 1:34" /></para>
  <para style="s">Yesu Beyi Manki a Galili</para>
  <para style="r">
    <ref loc="LUK 4:42-44">Lk 4.42-44</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Nsasape, de anya tuku yi dopuwa, Yesu dege a bisi, bila gizi e te anya de ntani ma shi ba, de yi lepa. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Biturusu nja nsu oboki e yi su te de su bila e yi, <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />de su geni yi, su nkye: &lt;&lt;Ntani sua bila ke.&gt;&gt; <verse eid="MRK 1:37" /><verse number="38" style="v" sid="MRK 1:38" />Yesu keleba nkye, &lt;&lt;Bila de mu te anya daa mbom, a dende geri de ma kusa, de Ni beyi manki anya na du. Mbode keyi ni zo naka.&gt;&gt; <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />Yesu gyowe guru kesa Galili, yaa beyi manki a siki kolonwa asu yaa butu ntani arizeni.<verse eid="MRK 1:39" /></para>
  <para style="s">Yesu Worikye Nseminji Nsu Kputuru</para>
  <para style="r">
    <ref loc="MAT 8:1-4">Mat 8.1-4</ref>; <ref loc="LUK 5:12-16">Lk 5.12-16</ref></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Nseminji nsu kputuru zo dure anya Yesu yaa ologba yi nkye, nde ki yeda, ki worikye ni.&gt;&gt;<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Yesu sika ni toseyi, e munka nani kpa nseminji ni. nkye &lt;&lt;E ni yeda,&gt;&gt; &lt;&lt;Ki worikye!&gt;&gt; <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Dandani kputuru bila e yi se e worikye.<verse eid="MRK 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 1:43" />Yesu gila yi soseyi, dandani e seleme yi: <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />&lt;&lt;Nkye kone kede ki gye nseda ba. Sede ki te, de ki nana kiya ke ba Pirisi de ki ba su sedeka de Musa beyi doka sobon ni wonka rebi ke, de ema sheeda ba su.&gt;&gt; <verse eid="MRK 1:44" /><verse number="45" style="v" sid="MRK 1:45" />Sede e sigeba ni pala nabari gye ntani mbode paru, a kiya yomu Yesu yuru a geri a pili gagaba sede e boyi a woze anya de nseda ma ba. Nzun yomu ntani su ma zo anya yi butu a kowoni geri.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Yesu worikye Nsude Nki yi Sharuwa</para>
  <para style="r">
    <ref loc="MAT 9:1-8">Mat 9.1-8</ref>; <ref loc="LUK 5:17-26">Lk 5.17-26</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />A beyi kwanki piri, de Yesu sakye yuru a kapanawu, ntani zi nkye e zo a gizi. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Ntani Nyowa tala ari anya ma ba, ko a woze ni kopa, se Yesu ba su manki ni Mirikisi. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Worosu su ntani wuru, la nsude nki yi sha ruwa zo nshi. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Tunde su samu turiki de sua keyi zo anya Yesu ba sobon yowa ntani, su bure lenda a bisi laki de Yesu ma a siki e yi, beyi de su bure lenda su sonka kalanga de nsu nki sha ruwa nja mbode e kwakwana asikye yi. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />De Yesu geni beigaskye asu, e gye nsu nki sharuwa nkye, &lt;&lt;Yaa na, Ni yape lepi ke. <verse eid="MRK 2:5" /><verse number="6" style="v" sid="MRK 2:6" />Kuzukam worosu su male ni kokoyi doka Musa zunwa anya ni, su meyi tunani a dishiya su nkye, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />&lt;&lt;Mina sa de nse mu e meyi beta yomu? Yaa saba Mirikisi! Waa ma sori yape lepi mba Mirikisi e shi dandaa ba?&gt;&gt; <verse eid="MRK 2:7" /><verse number="8" style="v" sid="MRK 2:8" />Dandani Yesu shina a siki aworo e yi mbode sua yi tunani a siki dishiya asu, se e gye su nkye, &lt;&lt;Mina sa de kwa yi tunani yomu? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Wona pi soki: De su gye nsude nki sharuwa nkye, &lt;Su yape lepi ke,&gt; ko su nkye, &lt;Dege a bisi, la kalanga ake de ki yi tepiya&gt;? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Sede ku shina nkye Yaa nsebeki mani sori de yaa yape lepi a durinya.&gt;&gt; E gye nsude nki sharuwa nkye, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />&lt;&lt;Na gye ke, Dege a bisi, la kalanga ke de ki te a gizi.&gt;&gt; <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />Nsude nki sharuwa dege a bisi, la kalanga butu a geba guru ntani. Mbo mu ba konwawa mamanki se su yobo Mirikisi, nkye, &lt;&lt;Mu taba geni mbodaa yomu ba!&gt;&gt;<verse eid="MRK 2:12" /></para>
  <para style="s">Yesu Sukwa Lawi</para>
  <para style="r">
    <ref loc="MAT 9:9-13">Mat 9.9-13</ref>; <ref loc="LUK 5:27-32">Lk 5.27-32</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Jaja Yesu kwa sakye ta baki ndani miya ni Galili. Ntani nyowa biya yi se e para kokoyi su. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />De Yesu ma a siki tepiya, e geni Lawi nsu keleba gendu yaa ni Halipa, zunwa anya keleba gendu. Yesu gye yi nkye, &lt;&lt;Biya ni&gt;&gt; Se Lawi dege biya e yi.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />De Yesu ma si mbosi nyema a gizi Lawi, nsu keleba gendu nja &lt;&lt;Nsu lepi&gt;&gt; Sua si mbosi nja yayagizi e yi, anya ni ntani nyowa biya e yi. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />De male doka Musa de su ma Parisiyawa su geni Yesu yaa si mbosi nja &lt;&lt;Nsu lepi&gt;&gt; Nja nsu keleba gendu, su minya yayagizi e yi: nkye &lt;&lt;Mina sa de Yesu yaa si mbosi nja nsu keleba gendu nja &lt;&lt;Nsu lepi&gt;?&gt;&gt;<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />De Yesu zi yomu, e gye su nkye, &lt;&lt;Ba nsu lapiya na sua bila nsu megeni ba, sede nsu suwo. Ba Ni zo de nsukwa ntani gangasi na ba, sede nsu lepi.&gt;&gt;<verse eid="MRK 2:17" /></para>
  <para style="s">Su Minya Yesu Beta A kiya Azimi</para>
  <para style="r">
    <ref loc="MAT 9:14-17">Mat 9.14-17</ref>; <ref loc="LUK 5:33-39">Lk 5.33-39</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Kuzukam yayagizi Yaaya nja Parisiyawa su ma yi azimi, worosu su ntani zo minya Yesu nkye &lt;&lt;Mina sa de yayagizi Yaaya nja yayagizi Parisiyawa sua yi azimi, sede na ke sua yi ba?&gt;&gt;<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Yesu keleba su nkye, &lt;&lt;Yaya na oboki ango sua yi azimi a kwanki ni buki amere tunde ango tuku ma nja su? Sua yi ba tunde e tuku ma nja su. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Sede kwanki yaa zo de sua la minzi okeshe bila su, a nana ni sua yi azimi.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />&lt;&lt;Yesu pala nkye ba nsude yaa la kukukyo riga wuri dumki ni sabuwa. Nde e yi yomu, sabuwa keikei yaa saga bila wuri, saga yi yaapi ni da mungu. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Ba nsude yaa nya kunu zanki a siki gwala wuri, nde e yi yomu wuri riki yaa wokye gwala riki yaa nya yaa lesa riki nja gwala, sobon sabuwa riki sua nya yi a sabuwa gwala la.<verse eid="MRK 2:22" /></para>
  <para style="s">Su Minya Yesu Beta A kiya Nana Asibi</para>
  <para style="r">
    <ref loc="MAT 12:1-8">Mat 12.1-8</ref>; <ref loc="LUK 6:1-5">Lk 6.1-5</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Nana asibi daa Yesu meyi tepiya a siki bikiya ni alikama, se yayagizi e yi su para watala kiya ni alikama murishe sua suku. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Parisiyawa gye Yesu nkye, &lt;&lt;Kone, mina sa yayagizi ake sua yi mbode doka nana nkye kede su yi a nana asibi?&gt;&gt;<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />Yesu keleba nkye, &lt;&lt;Ku taba karanta de Dowuda nja oboki tepiya e yi su yi kwanki de sua zi nyunwa bo? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />De e yuru a laki Mirikisi a kwanki ni Abiya tolense ni pirisi, de e suku mbode doka nkye e suku ba. se e kwa ba nsu oboki tepiya yi suku.&gt;&gt;<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Se Yesu gye su nkye &lt;&lt;Su yi nana asibi ba nsebeki la, ba su yi nsebeki sobon nana asibi ba. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Sobon yomu Yaa nsebeki e ma Obagizi ari ni nana asibi.&gt;&gt;<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">Nseminji Nsu Nani Shi Ruwa</para>
  <para style="r">
    <ref loc="MAT 12:9-14">Mat 12.9-14</ref>; <ref loc="LUK 6:6-11">Lk 6.6-11</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Kwanki daa Yesu yuru a kolonwa, nseminji de nani yi sharuwa ma anya ni. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Worosu su ntani sua bila turiki de sua basi Yesu, sua kone ko yaa worikye ntani a nana asibi. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Yesu gye nseminji de nani yi sharuwa, &lt;&lt;Dege a bisi a geba ni konwawa.&gt;&gt;<verse eid="MRK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 3:4" />Se Yesu minya su nkye, &lt;&lt;Mina ma doka nana asibi: mu yi kyakyawu ko mumungu, mu sila nleyi ntani na ko mu kisa ntani na?&gt;&gt; sede su zunwa shuru.<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />Yesu kone su ni anwashi, e kwa yi beki siki ni loni dishiya, e gye nseminji ni nkye, &lt;&lt;Munka nani ke.&gt;&gt; Nseminji ni munka nani yi dandani e samu worikye. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Se Parisiyawa bila kolonwa butu a woze de su te gama baki su nja worosu ntani Yirudiya yiride sua kisa Yesu.<verse eid="MRK 3:6" /></para>
  <para style="s">Ntani Nyowa Biya Yesu</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Yesu nja yayagizi e yi te a kesa ni Galili, se ntani nyowa su kwa biya e yi dege Yawudiya. <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />Wurishelima, nja Edom, nja gunduma de nyenteri Joda nja gyewe ni Taya nja Sidon, de su zi guru mbode Yesu yaa yi. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Sobon yowa ntani Yesu gye yayagizi e yi su keyi kwanto dende, de kede ntani su yi yowa ba. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Yesu worikye ntani nyowa, sobon yomu na nsu suwo sua bila de su kpa yi. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Guru kwanki de mungu aworo geni yi, sua puari a geba e yi ni kuruwa nkye, &lt;&lt;E ke ki ma Yaa Mirikisi la.&gt;&gt; <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />Sede Yesu ba su gila nsori nkye kede su pala ko waa ma e shi ba.<verse eid="MRK 3:12" /></para>
  <para style="s">Yesu Zabi Yayamanki Gom Sha Bi</para>
  <para style="r">
    <ref loc="MAT 10:1-4">Mat 10.1-4</ref>; <ref loc="LUK 6:12-16">Lk 6.12-16</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Yesu te nyunwa kiya ogbo dunsi e sukwa worede yaa so, se su zo anya e yi. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />E zabi gom sha bi, e sa de su ma yaya manki, de su ma nja shi de e saka su te ni manki <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />de su mani sori ni kula arizeni. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />Gom sha bi de Yesu zabi su osu nama: Sima de Yesu sa yi seni Biturusu; <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Yakubu yaa ni Zabedi nja yayiwa e yi Yaaya, e ba su seni Buwanaji, de mane yi ma yaya ni akpala; <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />Anduru, Pilibu, Batalomi, Matiyu, Tomasi, Yakubu yaa ni Alipasu, Tadiyu, Sima nsude meyi topula sobon ntani yi, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />nja Yawuda Isikariyoti nsu de butu Yesu a beyi.<verse eid="MRK 3:19" /></para>
  <para style="s">Yesu nja Seleki Arizeni</para>
  <para style="r">
    <ref loc="MAT 12:22-32">Mat 12.22-32</ref>; <ref loc="LUK 11:14-23">Lk 11.14-23</ref>; <ref loc="LUK 12:10">12.10</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Se Yesu yuru a gizi daa, jaja ntani tala nyowa, de Yesu nja yayagizi e yi su iya si mbosi ba. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />De ntani gizi e yi zi mbom, su te de su keyi te nshi a gizi, su nkye, &lt;&lt;E meyi somiya.&gt;&gt; <verse eid="MRK 3:21" /><verse number="22" style="v" sid="MRK 3:22" />Se male ni doka Musa de su zo dege Wurishelima nkye, &lt;&lt;E mani arizeni! butu anya seleki arizeni mbode sa de yaa yiya kula arizeni naka.&gt;&gt;<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Sobon yomu na Yesu sukwa su e yi su abenshi nkye, &lt;&lt;Yaya na obiri yaa butu obiri? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Nde solota sua yi geba ni nkiya su solota ni yaa sakisi ba. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Nde gizi te laba bi, gizi ni yaa sakisi ba. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Nde obiri yaa yi geba nja nki yi ari e la nki yi yaa sakisi ba; karishe yi zo naka. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />Nseda yaa yi yaa yuru a gizi ni nsude mani sori de kwa yi keyi ba sede e domuna yi. tuku yaa yi yaa kwa yi keikei a gizi e yi. <verse eid="MRK 3:27" /><verse number="28" style="v" sid="MRK 3:28" />Yesu nkye Mma gye ku gaskye, guru lepi nja saba de ntani su mayi Mirikisi sua yape su nshi. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Sede nsude saba Aworo Nsuseki sua taba yape yi ba; E yi lepi ni gbogbo.&gt;&gt;<verse eid="MRK 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 3:30" />Yesu pala yomu sobon su nkye, &lt;&lt;E mani mumungu aworo.&gt;&gt;<verse eid="MRK 3:30" /></para>
  <para style="s">Amaa ni Yesu nja Yayuwa E yi</para>
  <para style="r">
    <ref loc="MAT 12:46-50">Mat 12.46-50</ref>; <ref loc="LUK 8:19-21">Lk 8.19-21</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Se amaa ni Yesu nja yayuwa e yi su zo. Sakisi a woze, su saka nseda de e sukwa yi. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Ntani nyowa su zunwa gyewe Yesu, se su gye yi nkye, &lt;&lt;Amaa ke nja yayuwa ke sua bila ake a woze.&gt;&gt;<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Yesu minya su nkye, &lt;&lt;Waa ma amaa na nja yayuwa na?&gt;&gt;<verse eid="MRK 3:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 3:34" />Se Yesu kone worede zunwa gyewe yi nkye, &lt;&lt;Amaa na nja yayuwa na osu na ka anya mu! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Guru nsude yi mbode Mirikisi yaa so e shiya ma yayuwa naa menza nja mata nja amaa naa nja adaa naa.<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Abenshi A kiya ni Nsu Nyunkwa</para>
  <para style="r">
    <ref loc="MAT 13:1-9">Mat 13.1-9</ref>; <ref loc="LUK 8:4-8">Lk 8.4-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Yesu kwa para kokoyi a baki totolo riki. Ntani de su gomu gyowe yi su ma nyowa, de sa ari Yesu yuru a siki kwanto te zunwa, sede guru ntani su zunwa a karishe a keteri riki. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />E kokoyi su mbo nyowa ni abenshi, a siki kokoyi e yi e gye su nkye: <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />&lt;&lt;Ku zi! Nsu bikiya te de nyunkwa yiri a bikiya e yi. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />De e ma kiya yaapi yiri, worosu su puari a kiya turiki, se nsusuwa zo kwa yi suku. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Worosu su puari anya dunsi, de mani kesa nyowa ba. Dandani su butu sobon kesa yi nyowa anya ni ba. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Sede nana zo a bisi, zapi nana yi yowa se nyokoshi, su kyekeri sobon ririnya su ta kisi ba. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Worosu su yiri puari a siki ankwanya, ankwanya dege yi girima e kapa su, ari su yi yaya ba. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Worosu su puari a siki kesa kyakyawu. E butu, e dege a bisi ari e yi yaya, talatin, sitin, ari sen deri.&gt;&gt;<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Se Yesu pala nkye, &lt;&lt;Nsude mani kuni zi, se e zi.&gt;&gt;<verse eid="MRK 4:9" /></para>
  <para style="s">Delili ni Abenshi</para>
  <para style="r">
    <ref loc="MAT 13:10-17">Mat 13.10-17</ref>; <ref loc="LUK 8:9">Lk 8.9</ref>,<ref loc="LUK 8:10">10</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />De Yesu ma e shi dandaa e yi, yayagizi e yi gom sha bi nja worosu nsu biya yi su minya Yesu maana abenshi mu. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Se Yesu gye su nkye, &lt;&lt;Mbode ma boyi a siki solota bisi Mirikisi ba ku de ku shina. Sede worosu su ntani sua gye su ni abenshi, <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />Sobon de,</para>
  <para style="q1" vid="MRK 4:12">&lt;Sua kone nja kone</para>
  <para style="q2" vid="MRK 4:12">sede sua geni; ba,</para>
  <para style="q1" vid="MRK 4:12">sua zi nja zi.</para>
  <para style="q2" vid="MRK 4:12">sede sua gane ba.</para>
  <para style="q1" vid="MRK 4:12">sobon kede su juyi de Mirikisi e yape su ba!&gt;&gt;&gt;<verse eid="MRK 4:12" /></para>
  <para style="s">Nsu Nyunkwa</para>
  <para style="r">
    <ref loc="MAT 13:18-23">Mat 13.18-23</ref>; <ref loc="LUK 8:11-15">Lk 8.11-15</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Se Yesu gye su nkye, &lt;&lt;Oku ku gane abenshi mu bo? Yaya na kwa gane ni abenshi worosu su? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Kelima Mirikisi la e ma kankye yiri de nsu bikiya nunkwa. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Worosu su ntani su ma kankye yiri de puari a kiya turiki, nde su zi kelima Mirikisi. Dandani de su zi, obiri zo la kelima de su nunkwa a siki asu. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Worosu su, ma kankye yiri de puari a kiya dunsi, de su zi kelima dandani su yeda ni nshi ni perisiki. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Sede tunde su man ririnya ba, su dede ni kwanki piri. De genbeki ko gwada zo sobon kelima ni dandani sua puari. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Worosu su, su ma kankye yiri de su nunkwa a siki ankwanya, su zi kelima; <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />sede ngala durinya mu, nja so keikei durinya, nja kode yi worosu su mbo zo la kelima mu, e sa yi yapu yaya ba, <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Worosu su, su ma kankye yiri de su nunkwa a siki kesa kyakyawu, su zi kelima, su yeda nshi, su yapu yaya, talatin, sitin ari sen deri pi mbode su nunkwa.&gt;&gt;<verse eid="MRK 4:20" /></para>
  <para style="s">Anya Sakisi Ni Pitila</para>
  <para style="r">
    <ref loc="LUK 8:16-18">Lk 8.16-18</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Yesu gye su nkye, &lt;&lt;Kwa la pitila ripe ni gongo ko boyi a kisi gbodo? ba kwa lete yi a kiya gwala de su ma lete pitila na bo? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Sobon kowon mbo de ma a boyi sua pelesa yi, nja kuma ba mbode e ma ni asiri de sua bure yi a pili ba. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Nsude mani kuni zi se e zi.&gt;&gt; <verse eid="MRK 4:23" /><verse number="24" style="v" sid="MRK 4:24" />&lt;&lt;Se Yesu sigeba gye su nkye. Ku zi kyakyawu,&gt;&gt; &lt;&lt;Gongo de ku yi gonta nshi, e shina sua gonta ku nshi, ari sua ja ku nshi. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Nsude manshi sua ja yi nshi; nsude manshi ba, ko mbode e manshi sua keleba bila e yi.&gt;&gt;<verse eid="MRK 4:25" /></para>
  <para style="s">Abenshi A kiya Yiri de Tompa</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Yesu kwa pala nkye, &lt;&lt;Solota gizi Mirikisi ma kankye. Nseminji de yaapi yiri a bikiya e yi. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Ndederi nja nnana, ko e yi kwana ko e pelenka, yiri tompa yi girima, kode nkye e shina ko yaya na e tompa ba. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Kesa nkiya yi yaa beyi girima nja yaa yi yaya; tompa e shiya mani pari, se e butu nkiya, se a karishe yaa ma saba. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Sede ampani nunu, yaa sa rije a siki e yi, sobon kwanki ni kwa yi keikei bikiya zo.&gt;&gt;<verse eid="MRK 4:29" /></para>
  <para style="s">Kokongye ni Saba Mosta</para>
  <para style="r">
    <ref loc="MAT 13:31">Mat 13.31</ref>,<ref loc="MAT 13:32">32</ref>,<ref loc="MAT 13:34">34</ref>; <ref loc="LUK 13:18">Lk 13.18</ref>,<ref loc="LUK 13:19">19</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Yesu kwa sakye pala nkye, &lt;&lt;Minana mua gwada solota gizi Mirikisi nshi? ko woni misali la mua yi abenshi nja shi? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />E ma kankye saba mosta, de e ma dende yiri de muma nunkwa a kesa. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Nzun yomu nde su nunkwa yi, yaa yi girima yaa pi guru ntasi bikiya, yaya nani yi yaa yi girima de nsusuwa sua yi gizi asu a wurinya e yi.&gt;&gt;<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Yesu gye su beta nyowa ni abenshi, yiride sua gane. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Yesu taba gye su mbodaa ba se ni abenshi. Sede nde e ma nja yayagizi e yi, yaa gye su mbo guru.<verse eid="MRK 4:34" /></para>
  <para style="s">Yesu Tele Agaguwa</para>
  <para style="r">
    <ref loc="MAT 8:23-27">Mat 8.23-27</ref>; <ref loc="LUK 8:22-25">Lk 8.22-25</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Nana ni de nyema yi, Yesu gye yayagizi yi nkye, &lt;&lt;Mu nyenteri ta keteri ni.&gt;&gt; <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />De su bila ntani a beyi, su te yere nja Yesu a siki kwanto, worosu su kwanto su ma anya ni nja shi. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Se bisi yi beki kili nja totolo akusuka, ari e ma dege riki totolo riki ma dukwa kwanto, ari yaa bila de e wokye. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Yesu ma a beyi ni kwanto la kiya jaa mbo kwana yaa yi kwana. Yayagizi e yi dege yi su nkye, &lt;&lt;Male, mua muntu ko e suwo ke?&gt;&gt;<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Se Yesu pelenka, E kwabe akusuka se e gye riki nkye, &lt;&lt;Yi shuru! de ki sakisi!&gt;&gt; Se akusuka sakisi sip.<verse eid="MRK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40" />Yesu gye yayagizi yi nkye, &lt;&lt;Mina sa de kwa yi womba? Ari kuzukam ku mani beigaskye bo?&gt;&gt;<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Su zi womba soseyi su minya nkiya su nkye, &lt;&lt;Waa ma nseminji mu? De ari akusuka nja agaguwa sua beyi girima!&gt;&gt;<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">Worikye Nseminji Nsu Arizeni</para>
  <para style="r">
    <ref loc="MAT 8:28-34">Mat 8.28-34</ref>; <ref loc="LUK 8:26-39">Lk 8.26-39</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Yesu nja yayagizi e yi su nyenteri te a keteri totolo riki te a gunduma ni Geresinawa. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />De Yesu butu a siki kwanto, nseminji nsu mumungu aworo butu dege anya de su ma bishina gan zo gomu ni Yesu. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Nseminji mu yaa kwana anya de su ma bishina gan, nseda iya domuna yi ba, ko ni serika. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Sobon su sha domuna e yi a nani nja seni, sede yaa yenkye serika de ma a seni yi. Ba nsude ma sori de yaa sa yi bwala. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Ndederi nja nana e ma anya de su ma bishina gan nja kiya ogbo dunsi ema yi kuruwa nsori yaa yanka nki yi ndunsi.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />De nseminji ni geni Yesu nnyisa, e yi gudu zo dure nguyam a kisi a geba yi. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Se nseminji ni yi kuruwa nsori nkye, &lt;&lt;Mina ka bila nja ni, Yesu Yaa Mirikisi Nsu Girima? Ni gama ke ni Mirikisi kede ki ba mu Genbeki ba!&gt;&gt; <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Sobon Yesu gye yi nkye, &lt;&lt;Butu bila nki nseminji mu, e ke mumungu aworo!&gt;&gt;<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Se Yesu minya e yi nkye, &lt;&lt;Mina ma seni ke?&gt;&gt;</para>
  <para style="p" vid="MRK 5:9">Se e keleba nkye, &lt;&lt;Seni na ma Rijon,&gt;&gt; &lt;&lt;Sobon mu man nyowa a nki yi.&gt;&gt; <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Se e yi ologba Yesu jaja kede ki butu mu bila anya mu ba.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Anya ni alede nyowa sua si mbosi a keteri ni ogbo anya ni. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Se arizeni ologba Yesu nkye, &lt;&lt;Ki kula mu de mu te a siki alede; Bila mu de mu te a siki asu.&gt;&gt; <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Yesu ba su dama, mumungu aworo butu a siki nseminji ni yuru a siki ni alede. Alede ni, su keyi dupu bi, se su ruruga gudu yuru a siki totolo riki anya ni su tenke. <verse eid="MRK 5:13" /><verse number="14" style="v" sid="MRK 5:14" />Worede su ma kpanku alede su yi gudu te a siki totolo geri nja dende geri su pala mbode paru, se ntani butu te de su geni mbode paru. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />De su zo anya Yesu, su geni nseminji de mani mumungu aworo zunwa anya ni, e ma a siki ankeli e yi; se su zi womba. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Worede su geni mbode paru sigeba ni pala gye ntani mbode paru nja nsu arizeni nja alede. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Se ntani su para ologba Yesu de bila kesa asu.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />De Yesu ma yuru a siki kwanto, anya ni nsu arizeni ni ologba Yesu de te nja shi. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Sede Yesu yeda yi ba, nkye, &lt;&lt;Te a gizi anya yayuwa ake ki gye su guru mbode Obagizi yi ke nshi, nja yiri de e nana aniyeri e yi a kiya ake.&gt;&gt; <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Anya ni nseminji ni te sigeba ni pala nabari a siki gunduma Gom a kiya totolo ni mbode Yesu yi nshi. Ntani guru su yi mamanki ni mbode paru.<verse eid="MRK 5:20" /></para>
  <para style="s">Yaa Mase De Muntu Nja Mase de Meyi Suwo</para>
  <para style="r">
    <ref loc="MAT 9:18-26">Mat 9.18-26</ref>; <ref loc="LUK 8:40-56">Lk 8.40-56</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />De Yesu kwa nyenteri te a keteri totolo riki a siki kwanto, ntani nyowa tala gyowe yi tunde e ma a siki totolo riki. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Se daa a siki ni toree ni kolonwa tala su, seni e yi ma Yayirus, zo anya ni. De e geni Yesu, e puari a geba e yi <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />e yi ologba Yesu soseyi nkye, &lt;&lt;Yaa na ni mase e ma baki muntu. Zo de ki ja yi nani a kiya de e worikye e kuma man leyi.&gt;&gt; <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />Se Yesu te nja shi.</para>
  <para style="p" vid="MRK 5:24">Ntani nyowa su biya yi ari su ma masa Yesu. <verse eid="MRK 5:24" /><verse number="25" style="v" sid="MRK 5:25" />Mase daa ma anya ni de e meyi suwo nya zini ni shekera gom sha bi. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />Mase ni sha Genbeki soseyi a nani ni nsu megeni nyowa e kisa guru mbode e ma nshi, nzun yomu suwo ma ja yowa. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />De mase ni zi nabari Yesu, e zo a beyi Yesu e kpa riga Yesu, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />sobon e yi tunani a dishiya e yi nkye, &lt;&lt;Nde ni kpa riga e yi kin, Na worikye.&gt;&gt; <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />Dandani suwo zini e yi sakisi e zi nki e yi worikye dege siki Genbeki.<verse eid="MRK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30" />Dandani Yesu zi sori butu dege nki e yi. Yesu juyi kone ntani e minya su nkye, &lt;&lt;Waa kpa riga na?&gt;&gt;<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Se yayagizi e yi keleba nkye, &lt;&lt;Ki geni ntani su yi yowa su ma kpa ke, &lt;&lt;nzun yomu ki ma minya nkye waa kpa ke?&gt;&gt;&gt;<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Sede Yesu sigeba ni kone ko yaa geni nsude kpa yi. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />De mase ni geni mbode paru nja shi, nki e yi ma kakada sobon womba, e zo puari a geba Yesu, pala gye yi guru gaskye ni mbode paru nshi. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Yesu pala gye yi nkye, &lt;&lt;Yaa mase, beigaskye ke worikye nke. Sonka ni selema ki worikye dege suwo ke.&gt;&gt;<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Tunde Yesu ma a kiya beta se worosu su ntani zo dege gizi ni Yayirus, Tolense kolonwa su nkye. &lt;&lt;Yaa ke ni mase muntu,&gt;&gt; &lt;&lt;Mina sa de ki ma dama male yomu jaja?&gt;&gt;<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Sede Yesu da mu ni mbode su ma pala ba, e pala gye tolense ni kolonwa nkye, &lt;&lt;Kede ki yi womba; beigaskye kin.&gt;&gt;<verse eid="MRK 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37" />Yesu yeda de nseda e biya yi ba sede Biturusu, nja Yakubu nja Yaaya yayiwa ni Yakubu. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />De su zo a gizi ni tolense kolonwa, Yesu geni yiri de ntani rikishe, su meyi kuka ni kuruwa nsori. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Yesu yuru a siki gye su nkye, &lt;&lt;Mina sa de ku meyi kuka ni kuruwa yomu? Yaa mase mu muntu ba e meyi kwana la.&gt;&gt; <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />Ntani su yi Yesu dala.</para>
  <para style="p" vid="MRK 5:40">A beyi de Yesu butu ntani guru a woze, e la adaa ni yaa mase ni nja amaa e yi nja yayagizi e yi de su ma nja shi, su yuru a siki anya de yaa mase ni ma. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Yesu ka nani yaa mase ni gye yi nkye, &lt;&lt;Talita kumi,&gt;&gt; e shiya ma, &lt;&lt;Yaa mase, Ni ma gye ke, dege a bisi!&gt;&gt;. <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />Dandani yaa mase ni dege a bisi meyi tepiya gyewe yaa mase ni mani shekera gom sha bi. Mbo mu sa ntani guru meyi mamanki. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Yesu ja su kuni kede su sa nseda e shina mbo mu ba, e gye su nkye su beyi mbosi de e si.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">Anebi Man Girima A geri yi Ba</para>
  <para style="r">
    <ref loc="MAT 13:53-58">Mat 13.53-58</ref>; <ref loc="LUK 4:16-30">Lk 4.16-30</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Yesu bila anya ni e kuma mbayi te a geri e yi, yayagizi e yi su te nja shi. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />De nana Asibi zo, e para kokoyi a kolonwa, ntani nyowa de su zi yi su yi mamanki.</para>
  <para style="p" vid="MRK 6:2">Su minya nkye, &lt;&lt;Anga na nseminji mu e samu mbo worosu mu?&gt;&gt; &lt;&lt;Woni simi na su beyi, de ari ema yi mbo mamanki yomu! <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Da mu nama yaa ni kapinta ni bo? Yaa ni Meremu yayiwa ni nsu Yakubu, Yusupu ni Yawuda nja Sima bo? Ba yayuwa yi mata na su ma nja mu mu bo?&gt;&gt; Se su zi anwashi yi.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />Se Yesu gye su nkye, &lt;&lt;Anebi yaa lesa dereja ba, se a geri yi, a siki yayuwa yi nja siki gizi yi.&gt;&gt; <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />Yesu yi ANKI mamanki daa anya ni ba, sede Yesu worikye worede su man lapiya ba piri la te anya ja su nani a kiya. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Yesu yi mamanki sobon ni ki beigaskye asu.</para>
  <para style="s" vid="MRK 6:6">Yesu Saka Yayagizi yi Gom Sha bi</para>
  <para style="r" vid="MRK 6:6">
    <ref loc="MAT 10:5-15">Mat 10.5-15</ref>; <ref loc="LUK 9:1-6">Lk 9.1-6</ref></para>
  <para style="p" vid="MRK 6:6">Se Yesu gyewe geri dende e ma kokoyi ntani. <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />Yesu sukwa yayagizi yi gom sha bi, e saka su bi bi e ba su sori a kiya ni mumungu aworo.<verse eid="MRK 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 6:8" />Da mu nama doka de Yesu ba su: &lt;&lt;Kede ku la mbodaa sobon tepiya aku sede gwala kede, ko mbosi, ko Angala, ko gyolo a siki arijiwu ku ko mbo shompa. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Ku sa takalami sede kede ku keyi riga bi ba. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Guru gizi de ku yuru, ku zunwa anya ni ari kwanki de kwa bila geri ni. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Guru anya de su keleba ku ba ko su ki zi beta aku, ku kekebe kula seni aku kwanki de kwa butu bila geri ni, yaa ma sheeda a kiya asu.&gt;&gt;<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Yomu na su butu te beyi manki gye ntani nkye su juyi bila mungu mbo asu. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Su butu arizeni nyowa su shapa worede man lapiya ba mayi se su worikye.<verse eid="MRK 6:13" /></para>
  <para style="s">Muntu Yaaya Nsu Tunkwasa</para>
  <para style="r">
    <ref loc="MAT 14:1-12">Mat 14.1-12</ref>; <ref loc="LUK 9:7-9">Lk 9.7-9</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />De Seleki Yiridu zi nabari mu, sobon seni Yesu gyewe ko anga. Worosu su ma nkye, &lt;&lt;Yaaya nsu tunkwasa na su dege yi dege kumsha, mbode sa de e ma yi ANKI mamanki naka.&gt;&gt;<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Worosu su nkye, &lt;&lt;E ma Iliya la.&gt;&gt;</para>
  <para style="p" vid="MRK 6:15">Worosu su kwa ma nkye, &lt;&lt;E ma anebi la, dege siki nsu anebi daa la.&gt;&gt;<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />Sede de Yiridu zi beta mu, e pala nkye, Yaaya, de ni butu yi kiya, na e dege a kumsha!&gt;&gt;<verse eid="MRK 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17" />Sobon Yiridu beyi doka su ka Yaaya, e sa su domuna yi sa a siki jaru, Yiridu yi yomu na sobon Yirudiya, mata ni yayiwa e yi Pilibu, de Yiridu amere yi. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Sobon Yaaya ma te pala gye Yiridu nkye, &lt;&lt;Doka nkye e yi kyawu de ki amere mata yayiwa ake ba.&gt;&gt; <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />Sobon Yirudiya ema zi anwashi Yaaya a dishiya yi e bila turiki de e kisa e yi. Sede e samu turiki de yaa kisa yi ba, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />sobon Yiridu ema zi womba Yaaya, e shina nkye Yaaya ma nse gangasi la nsuseki. Nde Yaaya ma yi Yiridu beta, ema suwe yi a dishiya soseyi; nzun yomu Yiridu yaa yi peri siki de yaa zi beta Yaaya.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />A karishe dama zo ba Hirudiya. A nana buki yapu ni Yiridu yi mbosi ba nsu akimi yi, nja toree shoja yi nja toree kesa Galili. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />De yaa mase ni Yirudiya yi wasa a geba ni Yiridu, Yiridu nja bakwe yi guru su zi dadi.</para>
  <para style="p" vid="MRK 6:22">Anya ni seleki gye yaa mase ni nkye, &lt;&lt;Minya guru mbode ki ma so, na ba ke.&gt;&gt; <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Seleki yi anikowori ni melese, &lt;&lt;Guru mbode ki minya ni na ba ke, ko rebi ni solota na na la ba ke.&gt;&gt;<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />E butu te a woze anya ni amaa yi e minya nkye, &lt;&lt;Mina na pata yi?&gt;&gt;</para>
  <para style="p" vid="MRK 6:24">Amaa yi keleba nkye, &lt;&lt;Kiya ni Yaaya nsu tunkwasa,&gt;&gt;<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Dandani yaa mase ni yi seseberi kuma mbayi te anya seleki e gye nkye: &lt;&lt;Kukuzum ni bila de ki ba ni kiya Yaaya nsu tunkwasa a siki tiree.&gt;&gt;<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />De seleki zi yomu e damu soseyi, sede sobon ni melese de e rigye yi nja bakwe de ma anya ni, e so de e nana yi ba. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Dandani seleki saka yayagizi yi de su butu kiya Yaaya zo nshi. Nseminji ni te, e butu kiya Yaaya a siki ni jaru, <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />e keyi zo nshi a siki tiree, e ba yaa mase ni, e shi kuma e la ba amaa e yi. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />De yayagizi Yaaya zi nabari mbode paru, su zo la nki e yi bishina.<verse eid="MRK 6:29" /></para>
  <para style="s">Yesu ba Ntani Dupu Biyari Mbosi</para>
  <para style="r">
    <ref loc="MAT 14:13-21">Mat 14.13-21</ref>; <ref loc="LUK 9:10-17">Lk 9.10-17</ref>; <ref loc="JHN 6:1-14">Jn 6.1-14</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Yaya manki de Yesu saka su kuma mbayi zo anya Yesu su pala gye yi guru mbode su yi nja mbode su kokoyi. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Sobon ntani nyowa de su ma zo sua te su samu dama de su si mbosi ba, e pala gye su nkye, &lt;&lt;Ku zo mu te anya de nseda ma ba de ku pushe.&gt;&gt;<verse eid="MRK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 6:32" />Anya ni su yuru a siki kwanto su te anya de nseda ma a siki e yi ba. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />Sede ntani nyowa de geni su su ma bila anya ni su biya su ngudu a seni dege geri geri nyowa su rigye su te anya ni. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />De Yesu sonka e geni ntani tala nyowa, Yesu zi toseyi asu soseyi, sobon su ma kankye timshiya de su mani nsu kone su ba. Se e para kokoyi su mbo nyowa.<verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />De nyema e yi, yayagizi e yi gye yi nkye, &lt;&lt;Anya mu ntani ma a siki e yi ba,&gt;&gt; &lt;&lt;Nana kusa puari. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Seleme ntani de su te a siki geri nja dende geri kusa de su bila mbosi de su si.&gt;&gt;<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Sede Yesu keleba nkye, &lt;&lt;Oku ku ba su mbodaa de su si.&gt;&gt;</para>
  <para style="p" vid="MRK 6:37">Yayagizi e yi gye yi nkye, &lt;&lt;Da mu yaala nsebeki wonta takusi ni ANKI gyolo de sua biya yi! Mua kisa gyolo nyowa mu a kiya mbosi de mua ba su de su si?&gt;&gt;<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />Yesu minya su nkye, &lt;&lt;Buredi kona ku ma nshi?&gt;&gt; &lt;&lt;Ku te de ku geni.&gt;&gt;</para>
  <para style="p" vid="MRK 6:38">De su te kone, su nkye, &lt;&lt;Buredi biyari nja gunda bi.&gt;&gt;<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />Se Yesu gye Yayagizi e yi de su gye ntani su zuzunwa kunji kunji a kiya sanwa. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Su zunwa a kisi kunji kunji worosu su deri deri worosu amsin amsin. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />De Yesu la buredi guda biyari e kone bisi, e gbede Mirikisi se e sua buredi. Se e ba yayagizi e yi de su ba ntani. E kwa laba gunda bi ni ba su guru. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Guru asu su si su koshi, <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />yayagizi e yi su kwa yi obubu gom sha bi de sika ni buredi nja gunda de rigye. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Yowa ni ntani de su si mbosi su keyi menza dupu biyari.<verse eid="MRK 6:44" /></para>
  <para style="s">Yesu Yi Tepiya A kiya Riki</para>
  <para style="r">
    <ref loc="MAT 14:22-33">Mat 14.22-33</ref>; <ref loc="JHN 6:15-21">Jn 6.15-21</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Dandani Yesu sa yayagizi e yi yuru a siki kwanto de su rigye yi geba te a Beseda, e shi kuma e seleme ntani. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />A beyi de Yesu seleme ntani, e nunwa kiya ni ogbo de e yi lepa.<verse eid="MRK 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47" />De nyema yi, kwanto ma sisika totolo miya, Yesu ma meyi eshi ndandaa yi a kesa. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />De Yesu geni yayagizi yi su ma yi pama ni kwanto, sobon akusuka meyi geba nja su. Kyakya keripi wuru nsape na Yesu butu te anya su, e meyi tepiya a kiya riki. E ma so de e bise su, <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />sede su geni yi meyi tepiya a kiya riki, su ma geni kankye potoruwa la. Su yi kuruwa nsori, <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />sobon guru asu de su geni yi su yi womba.</para>
  <para style="p" vid="MRK 6:50">Dandani Yesu yi beta nja su nkye, &lt;&lt;Ku yi sori dishiya! Eni la. Kede ku yi womba.&gt;&gt; <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Anya ni Yesu nunwa kwanto nja su, akusuka kuma sakisi sip. Guru asu su yi mamanki, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />sobon su gane mina ma maana ni ntani dupu biyari de Yesu ba su mbosi si mu ba; sobon su gane a dishiya su ba.<verse eid="MRK 6:52" /></para>
  <para style="s">Yesu Worikye Nsu Suwo a Genesere</para>
  <para style="r">
    <ref loc="MAT 14:34-36">Mat 14.34-36</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />De Yesu nja yayagizi yi su nyenteri ndani ruwa, su sonka a kyekeri kesa ni ganesere su domuna kwanto anya ni. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />De su butu a siki kwanto, ntani su gane Yesu. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Su butu a woze ngudu dege siki kesa ni, su kwa yi worede su meyi suwo a kiya kalanga asu te anya de su zi nkye Yesu ma. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Guru anya de Yesu te a siki dende geri ko totolo geri ko beyi geri su ma la nsu mere lapiya kwakwana a keteri baki bije. Su ma ologba Yesu de nsu mere lapiya mu su kpa baki riga e yi, guru nsude kpa Yesu e worikye.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Mbode Ma Sere Nja Mbode Man Dola</para>
  <para style="r">
    <ref loc="MAT 15:1-9">Mat 15.1-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />De Parisiyawa nja worosu su male doka Musa de su zo dege Wurishelima su zo tala anya Yesu <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />su geni worosu su yayagizi Yesu su ma si mbosi ni nani &lt;&lt;Dodola,&gt;&gt; woto nani de su wonkye ba. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />Parisiyawa nja ririgye Yawudawa su ma si mbosi ba, se su wonkye nani su, sobon kokoyi de su samu anya ni nsu adaatolo su. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Nde su kuma dege bije sua si mbosi ba, se su yi wonka. wonka ni alada Kankye nsu wonkye koshiya, gbodo, tuni, nja buta.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Se Parisiyawa nja male doka Musa minya Yesu nkye, &lt;&lt;Mina sa de yayagizi ke su ma biya alada ni nsu salaki mu ba, de su ma si mbosi ni &lt;Nani&gt; dodola?&gt;&gt;<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Yesu keleba nkye, &lt;&lt;Anebi Ishaya yi beta a kiya ku munabuki kyakya la akwanki beyi; yiri de ema a rubuta nkye:</para>
  <para style="q1" vid="MRK 7:6">&lt;&lt;Ntani worosu mu su ma ba ni girima ni baki la,</para>
  <para style="q2" vid="MRK 7:6">sede dishiya asu yi nyisa nja ni.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Su ma yi ni bowuta abanza la;</para>
  <para style="q2" vid="MRK 7:7">kokoyi asu ma doka ni ntani la.<verse eid="MRK 7:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8" />Ku bila doka Mirikisi kuma biya kokoyi ntani.&gt;&gt;<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Se Yesu gye su nkye: &lt;&lt;Ku bila doka Mirikisi a keteri de ku biya alada aku! <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Sobon Musa pala nkye, &lt;Ki ba adaa ake nja amaa ake girima, &lt;Guru nsude basi adaa e yi ko amaa e yi e ma dole na su kisa e yi.&gt; <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Sede ku nkye nde nsebeki gye adaa yi ko amaa yi nkye: &lt;Guru mbode kwa samu anya na ema Koban&gt; Woto, kyawuta de ni la sa keteri ba Mirikisi, <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />yomu la ku nana yi, de e sua adaa ko amaa e yi nto. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Yomu na ku la kelima Mirikisi ma mbodaa ba sobon ni alada aku, de ku kokoyi yaya aku. Yomu la kuma yi mbo nyowa.&gt;&gt;<verse eid="MRK 7:13" /></para>
  <para style="s">Mbode Yaa sa Nsebeki de E ma Sere Ba</para>
  <para style="r">
    <ref loc="MAT 15:10-20">Mat 15.10-20</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Yesu sakye sukwa ntani e gye su nkye, &lt;&lt;Ku zi ni, guru aku, de ku gane. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Ba mbosi de ma yuru a siki nsebeki dege woze e shiya ma sa nsebeki e ma nsu &lt;Dola&gt; ba. Sede mbode e ma butu dege siki nsebeki e shiya masa nse e ma nsu &lt;Dola.&gt;&gt;&gt; <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />Guru nsu kuni zi, e zi.<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />A beyi de Yesu bila ntani e yuru a gizi, yayagizi e yi minya e yi maana ni abenshi mu. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Yesu minya su nkye, &lt;&lt;Oku ma ku gane bo?&gt;&gt; Ba mbosi de e ma yuru a siki nsebeki dege woze e shiya yaa sa nsebeki e ma nsu &lt;Dola ba.&gt; <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Sobon ba e ma yuru a siki dishiya e yi na ba sede ema yuru a siki siki yi la, tuku de e butu a nki yi.&gt;&gt; De Yesu pala yomu, e la guru mbosi ma &lt;&lt;Sere.&gt;&gt;<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Yesu sigeba ni beta nkye: &lt;&lt;Mbode ma butu dege siki nsebeki e shiya yaa sa yi e ma nsu &lt;Dola.&gt; <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Sobon dege siki dishiya nsebeki la, mumungu tunani e ma butu, kankye nsu nungwe berikete, ni bolowa, ni kisa nse, ni kwana ni mata nseda, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />opu, ni mungu mbo, ni shishirigye, ni so zunwa rishi kumnya, ni kyashi nse, ni bebeta nkyaku seni, ni dege kiya nja ali Odundu. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Guru mumungu ali mu su ma butu dege siki dishiya la osu na su ma sa nsebeki e ma nsu &lt;Dola.&gt;&gt;&gt;<verse eid="MRK 7:23" /></para>
  <para style="s">Beigaskye Ni Mase De ma Yawudawa ba</para>
  <para style="r">
    <ref loc="MAT 15:21-28">Mat 15.21-28</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Yesu dege bila anya ni e te a kesa Taya nja. Yesu yuru a gizi daa e yeda de nseda e shina ba; nzun yomu e yi yaa boyi kiya e yi ba. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Dandani mase daa de e zi nabari Yesu, mase de yaa yi ni mase e mani mumungu aworo zo puari a geba Yesu. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Mase ni ema mase Heleniyawa na, su yapu yi a Pinikiya a kesa ni Suriya. Mase ni ologba Yesu de e kula arizeni bila yaa yi ni mase.<verse eid="MRK 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27" />Yesu gye mase ni nkye, &lt;&lt;Bila yaya dende de su si mbode su ma so,&gt;&gt; &lt;&lt;Sobon e yi kyawu de kula mbosi ni yaya dende ba kere ba.&gt;&gt; <verse eid="MRK 7:27" /><verse number="28" style="v" sid="MRK 7:28" />Mase ni keleba nkye, &lt;&lt;Ee, Obagizi,&gt;&gt; &lt;&lt;sede ko kere sua si mbosi de puari dege kingbolo ni si mbosi yaya dende lo.&gt;&gt;<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Se Yesu gye yi nkye, &lt;&lt;Sobon yiri beta de ki yi, ki te a gizi; arizeni butu bila yaa ake wo.&gt;&gt;<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Mase ni te a gizi e san yaa yi kwakwana a kiya gbodo, arizeni butu bila yi.<verse eid="MRK 7:30" /></para>
  <para style="s">Yesu Worikye Kuruma Nja Nsu arishiya loni</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Se Yesu bila kesa Taya e biya Sidon, e te a totolo riki ni Galili nja a siki gunduma Gom. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Anya ni worosu su ntani su keyi nseminji daa kuruma de eya yi beta sere sere ba zo nshi, su ologba Yesu de e ja nseminji ni nani de e worikye yi.<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />A beyi de Yesu ja nseminji ni te a keteri, anya de ntani ma ba, se Yesu sa yaa nani yi a kuni nseminji ni. Se Yesu nya nseminji ni anyanya a kuni e kwa kpa arishiya yi. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Se Yesu dege ni ndani yi a bisi e shika aminshi nsori gye yi nkye, &lt;&lt;Ipata!&gt;&gt; mane yi ma &lt;&lt;Ki bure!&gt;&gt;. <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />Dandani, kuni nseminji ni bure, arishiya yi de loni kunshe e para yi beta kyakyawu.<verse eid="MRK 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36" />Yesu kobe su kede su gye nseda ba. Sede Yesu ma nana su osu kuma su ma sigeba ni beyi nabari mbode paru. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Ntani su zi mamanki soseyi. Su nkye, &lt;&lt;Yesu yi guru mbo kyakyawu.&gt;&gt; &lt;&lt;E sa kuruma su ma zi nja nsu arishiya loni su ma yi beta.&gt;&gt;<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Yesu Ba Ntani Dubu wuru Mbosi</para>
  <para style="r">
    <ref loc="MAT 15:32-39">Mat 15.32-39</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />A kwanki ni ntani nyowa su kwa tala. Tunde su mani mbosi ba, Yesu sukwa yayagizi e yi nkye, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />&lt;&lt;Ni ma zi toseyi ni ntani mu; su ma nja ni kwana su wuku naka su si mbosi ba. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Nde Ni seleme su te a gizi ni nyunwa, sua lense leyi a turiki, sobon worosu su asu su zo dege anya nsu nyisa.&gt;&gt;<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Yayagizi e yi keleba, &lt;&lt;Sede angana a siki sanwa mu mua samu mbosi nyowa de yaa deta ntani mu?&gt;&gt;<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Yesu minya asu, &lt;&lt;Buredi kona ku ma nshi?&gt;&gt; Su nkye,</para>
  <para style="p" vid="MRK 8:5">&lt;&lt;Bokwe.&gt;&gt;<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Yesu gye ntani su zuzunwa a kisi. De Yesu la buredi gunda bokwe e gbede Mirikisi, se Yesu sua buredi ni se e ba yayagizi e yi de su ba ntani, osu kuma su yi mbode Yesu gye su. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Su man worosu su gunda dende du; Yesu gbede Mirikisi sobon nsu e kwa gye yayagizi e yi su laba ba ntani. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Ntani su suku ari su koshi. Yayagizi Yesu su kwa yi worede rigye obubu bokwe. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Yowa ntani de su ma anya ni su keyi menza dupu wuru se Yesu seleme su, <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />anya ni Yesu nja yayagizi e yi su dege yuru a siki kwanto su te a kesa Dalmanuta.<verse eid="MRK 8:10" /></para>
  <para style="s">Parisiyawa Sua Bila Alama</para>
  <para style="r">
    <ref loc="MAT 16:1-4">Mat 16.1-4</ref></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Parisiyawa su zo su ma minya Yesu beta. Sua bila de su gwada Yesu, su minya Yesu alama dege bisi. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Se Yesu shika aminshi nsori nkye, &lt;&lt;Mina sa de ntani kwanki mu su ma minya alama ni mbo beyi mamanki? Na gye ku gaskye, ba alama de sua ba su ba.&gt;&gt; <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />Se Yesu dege meyi bila su, e kuma mbayi te yuru a siki kwanto nyenteri te a keteri totolo Minya daa.<verse eid="MRK 8:13" /></para>
  <para style="s">Darigaza Ni Parisiyawa Nja Yiridu</para>
  <para style="r">
    <ref loc="MAT 16:5-12">Mat 16.5-12</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Yayagizi Yesu su moshi de su keyi buredi, sede buredi ndandaa de ma nja su a siki kwanto. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Yesu kobe su nkye. &lt;&lt;Ku yi ankeli,&gt;&gt; &lt;&lt;Ni ali ntani Parisiyawa nja Yiridu.&gt;&gt;<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Su pala yomu na, &lt;&lt;Sobon su mani buredi ba.&gt;&gt;<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />De Yesu gane beta asu, Yesu minya asu nkye: &lt;&lt;Mina sa de kuma yi beta a kiya de ku mani buredi ba? Ari kuzukam ku tuku geni ko gane wobo? Dishiya aku tuku yi tori la? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Ku mani ndani sede kuma geni ba, ku mani kuni sede kuma zi bo? Kua turunwa bo? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />A kwanki de ni sua buredi biyari ba ntani dupu biyari, obubu kona de sika ni buruburu de ku kwa yi?&gt;&gt;<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />&lt;&lt;De Ni sua buredi bokwe ba ntani dupu wuru, obubu kona de ku kwa yi ni buruburu de rigye?&gt;&gt;</para>
  <para style="p" vid="MRK 8:20">Su keleba nkye, &lt;&lt;Obubu bokwe.&gt;&gt;<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Yesu gye su nkye, &lt;&lt;Ku tuku gane wobo?&gt;&gt;<verse eid="MRK 8:21" /></para>
  <para style="s">Yesu Worikye Makapi Nseminji ni Kesa Beseda</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />De Yesu nja yayagizi e yi su zo a kesa Beseda, worosu su ntani keyi nseda makapi zo anya Yesu su yi ologba Yesu de e kpa yi. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Yesu ka makapi ni nani e keyi te a beyi dende geri. De Yesu nya nseminji makapi ni anyanya a ndani se e ja e yi nani yi, Yesu minya e yi nkye, &lt;&lt;Ki ma geni mbodaa?&gt;&gt;<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />Makapi ni dege ni ndani kone bisi nkye, &lt;&lt;Ni ma geni ntani; su ma kankye ntasi sua yi tepiya gyewe.&gt;&gt;<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Yesu sakye kpa nani e yi a ndani makapi ni. Se e bure ndani e yi ndani yi worikye, e ma geni sere. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Yesu seleme yi te a gizi, nkye, &lt;&lt;Kede ki te a siki dende geri.&gt;&gt;<verse eid="MRK 8:26" /></para>
  <para style="s">Biturusu Pala Nkye Yesu Ma Kiristi</para>
  <para style="r">
    <ref loc="MAT 16:13-20">Mat 16.13-20</ref>; <ref loc="LUK 9:18-21">Lk 9.18-21</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Yesu nja yayagizi e yi su keyi dende geri de ma a siki kesa Keseriya Pilibi. A kiya turiki Yesu minya su, &lt;&lt;Ntani su ma pala nkye Ni ma waa?&gt;&gt;<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />Su keleba nkye, &lt;&lt;Worosu su su nkye Yaaya nsu Tunkwasa la; worosu su nkye Iliya la; worosu su su ma nkye, daa a siki ririgye anebi la.&gt;&gt;<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />Yesu minya asu nkye, &lt;&lt;Sede oku pa&gt;&gt; &lt;&lt;Ku nkye ni ma waa?&gt;&gt;</para>
  <para style="p" vid="MRK 8:29">Biturusu keleba nkye, &lt;&lt;Ki ma Kiristi la.&gt;&gt;<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />Yesu gila su kede su gye nseda a kiya e yi ba<verse eid="MRK 8:30" /></para>
  <para style="s">Yesu Pala Yiri Muntu De Yaa yi</para>
  <para style="r">
    <ref loc="MAT 16:21-28">Mat 16.21-28</ref>; <ref loc="LUK 9:22-27">Lk 9.22-27</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Se Yesu para kokoyi yayagizi e yi nkye e ma dole na de Yaa Nsebeki yaa Genbeki a kiya mbo nyowa, toree nja tolense pirisi nja male doka Musa sua ki yi, ari su kisa yi a beyi kwana wuku yaa dege a kumsha. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Yesu yi beta mu a pili, se Biturusu za yi te a keteri e para kwabe yi.<verse eid="MRK 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33" />Sede Yesu juyi kone yayagizi e yi, e kwabe Biturusu nkye. &lt;&lt;Dege anya na, e ke Obiri!&gt;&gt; &lt;&lt;Ki mani mbodaa ni Mirikisi a siki dishiya ake ba, sede tunani nsebeki la.&gt;&gt;<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Se Yesu sukwa ntani zo anya e yi nja yayagizi e yi nkye: &lt;&lt;Guru nsude e ma so de e biya ni, e ma dole na e ki kiya e yi de e la gidiri e yi de e biya ni. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Guru nsude ma so leyi e yi yaa lesa yi, sede guru nsude lesa leyi yi sobon e ni nja nabari kyakyawu yaa sila ni leyi e yi. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Mina yi nsebeki kyawu nde e samu durinya mu guru, se e lesa leyi e yi? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Mina nsebeki yaa la beyi a kiya ni leyi e yi? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Guru nsude meyi kumnya na nja beta na a siki mungu kwanki ni mere aminshi nja nsu yowa lepi mu, Yaa nsebeki ma yaa zi kumnya e yi a kwanki de yaa zo a siki girima ni Adaa e yi nja ni meleku nsuseki.&gt;&gt;<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Se Yesu gye su nkye, &lt;&lt;Na gye ku gaskye, worosu de su sakisi anya mu sua taba muntu ba ari de solota Mirikisi te zo nsori e yi.&gt;&gt;<verse eid="MRK 9:1" /></para>
  <para style="s">Shenja Kamani Yesu</para>
  <para style="r">
    <ref loc="MAT 17:1-13">Mat 17.1-13</ref>; <ref loc="LUK 9:28-36">Lk 9.28-36</ref></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />A beyi kwana shida Yesu la Biturusu, nja Yakubu nja Yaaya nja shi e keyi su te a kiya ogbo dunsi, anya ni kame yi shenja a geba asu. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />Riga de e sa e juyi peri shari, de ba nseda a durinya de yaa yiya wonkye keyi ni yomu ba. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Se anebi Iliya nja anebi Musa, su butu sakisi nja su sua yi beta nja Yesu.<verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />Biturusu gye Yesu nkye, &lt;&lt;Male, e yi kyawu de mu ma anya mu. Bila de mu yi rugwa wuku daa ma na ke, daa ma ni Musa nja daa ma ni Iliya.&gt;&gt; <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />E lesa mbo de yaa pala, su zi womba soseyi.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Se gidagida butu zo ripe su, se su zi murinya a siki gidagida: &lt;&lt;Nsum e ma Yaa na la, de mma so, ku zi yi!&gt;&gt;<verse eid="MRK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8" />Dandani, su kone gyewe, su geni nseda anya ni nja su ba sede Yesu.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />De su ma sonka dege kiya ogbo dunsi, Yesu gila su kede su gye nseda mbo de su geni ba se a kwanki de Yaa nsebeki dege a kumsha. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />Se su keyi beta ni a siki dishiya asu, sua gye nkiya su nkye &lt;&lt;Mina ma dege ni kumsha.&gt;&gt;<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />Se su minya yi, &lt;&lt;Mina sa male ni doka Musa pala nkye dole na Iliya yaa zo a pari tuku?&gt;&gt;<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Yesu keleba nkye, &lt;&lt;Gaskye na, Iliya yaa para zo, de e gyala guru mbo. Sede e ma a rubutu a siki beta Mirikisi nkye Yaa nsebeki yaa Genbeki soseyi sua ki yi? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Sede ni ma gye ku, Iliya rigye zo, nja su yi mbo de su geni dama, yiri de su rubuta a kiya e yi.&gt;&gt;<verse eid="MRK 9:13" /></para>
  <para style="s">Yesu Worikye Yaa Minzi De E man Ni Arizeni</para>
  <para style="r">
    <ref loc="MAT 17:14-21">Mat 17.14-21</ref>; <ref loc="LUK 9:37-43a">Lk 9.37-43a</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />De su kuma zo anya ririgye yayagizi e yi, se su geni ntani nyowa tala gyewe nja nsu male doka Musa sua yi musu nja su. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />De guru ntani geni Yesu, su yi mamanki soseyi se su yi gudu te a geba e yi su ma geshe yi.<verse eid="MRK 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16" />Yesu minya su. &lt;&lt;Mina kwa yi musu a kiya e yi nja su?&gt;&gt;<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Se nseda a siki worede su tala anya ni pala nkye, &lt;&lt;Male, ni zo yaa na. De e ma nsu arishiya loni anya ke mungu aworo yaa nani yi beta. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Du kwanki de e dege yi, yaa leyi kutiri a kisi. yaa butu ni kumpa a baki yi, yaa suku ankuri nja sangala ankuri. Ni gye yayagizi ke de su butu yi su yi yaa ba.&gt;&gt;<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Yesu gye su nkye, &lt;&lt;Oku ntani sana de ku ki beigaskye,&gt;&gt; &lt;&lt;Ari woshe la Na zunwa a siki ku? Ari woshe la Na yi takuwa nja ku? ku zo yaa ni kayi ni de Ni geni.&gt;&gt;<verse eid="MRK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20" />De su keyi yaa ni zo nshi de mungu aworo geni Yesu, dandani e la yaa ni kutiri a kisi nki e yi ma kakada. E puari a kisi yaa butu kumpa a baki e yi.<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />Yesu minya Adaa ni yaa ni nkye, &lt;&lt;Tun woshe la mbo mu saa nshi?&gt;&gt; Adaa e yi keleba nkye,</para>
  <para style="p" vid="MRK 9:21">&lt;&lt;Tun dege kwanki de e ma yaa den.&gt;&gt; <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />&lt;&lt;Yaa leyi kutiri a siki wuta nja riki de e kisa e yi. Sede nde ka yi yaa yi mbodaa, zi toseyi mu de ki sua mu nto.&gt;&gt;<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Yesu pala nkye, &lt;&lt;&lt;Mina sa de ki minya nkye nde ka yi yaa&gt;&gt;&gt; &lt;&lt;Guru mbo ema nsu yu la anya nsu de beigaskye.&gt;&gt; <verse eid="MRK 9:23" /><verse number="24" style="v" sid="MRK 9:24" />Dandani Adaa ni yaa mu nkye, &lt;&lt;Ni ki beigaskye, sua ni nto de ni yeda!&gt;&gt;<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />De Yesu geni ntani sua yi gudu zo anya ni, e gye mungu aworo nkye, &lt;&lt;E ke aworo kuruma nja nsu arishiya loni,&gt;&gt; &lt;&lt;Ni ba ke doka, ki butu a siki e yi kede ki sakye yuru a siki e yi gagaba.&gt;&gt;<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Mungu aworo yi kuruwa, e dukwa e yi se e butu. Sua kone Yaa mu kankye gan ntani nyowa sua nkye, &lt;&lt;E muntu la&gt;&gt; <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Sede Yesu keyi nani, se e dege sakisi a bisi.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />A beyi de Yesu bila anya ni, yayagizi e yi minya yi nkye, &lt;&lt;Mina sa de omu mu yi yaa butu arizeni mu ba?&gt;&gt;<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />Yesu keleba nkye, &lt;&lt;Yiri aworo mu yaa butu ba se te anya lepa.&gt;&gt;<verse eid="MRK 9:29" /></para>
  <para style="s">Yesu sakye yi Beta A kiya Muntu yi</para>
  <para style="r">
    <ref loc="MAT 17:22">Mat 17.22</ref>,<ref loc="MAT 17:23">23</ref>; <ref loc="LUK 9:43b-45">Lk 9.43b-45</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Se Yesu nja yayagizi e yi su bila anya ni su biya kesa ni Galili. Yesu bila de nse daa e shina anya de su ma ba, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />sobon Yesu ma kokoyi yayagizi e yi. E gye su nkye, &lt;&lt;Sua la Yaa nsebeki a beyi a nani ntani. De su kisa yi, a beyi kwana wuku yaa dege.&gt;&gt; <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Sede su gane ni beta de yaa yi nupi ba kuma sua zi womba de su minya yi.<verse eid="MRK 9:32" /></para>
  <para style="s">Waa Ma Totolo?</para>
  <para style="r">
    <ref loc="MAT 18:1-5">Mat 18.1-5</ref>; <ref loc="LUK 9:46-48">Lk 9.46-48</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />De Yesu nja yayagizi su zo a Kapanawu. De su yuru a gizi, e minya su nkye, &lt;&lt;Mina kwa yi musu a kiya e yi a turiki?&gt;&gt; <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />Sede su yi shuru sobon a turiki su ma yi musu a kiya waa ma totolo.<verse eid="MRK 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35" />Yesu zunwa a kisi, e sukwa gom sha bi e gye su nkye, nsude yaa bila de e ma ni pari, dole na yaa kuma ma ni karishe nja bunwa ni guru&gt;&gt;<verse eid="MRK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36" />Yesu la yaa dende e sa yi sakisi a sisika asu. E runguma yaa ni, e gye su nkye, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />Du nsude keleba yaa dende mu a siki seni na e ni na e keleba; nsude keleba ni ba e ni na e keleba ni ba sede nsude saka ni na e keleba.&gt;&gt;<verse eid="MRK 9:37" /></para>
  <para style="s">Du Nsude Yaa yi Geba Nja Mu Ba E ma Namu</para>
  <para style="r">
    <ref loc="LUK 9:49">Lk 9.49</ref>,<ref loc="LUK 9:50">50</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Yaaya gye Yesu nkye, &lt;&lt;Male&gt;&gt; &lt;&lt;Mu geni nseda yaa butu arizeni a siki seni ke mu nani yi, sobon e ma a siki mu na ba.&gt;&gt;<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Yesu pala nkye, &lt;&lt;Kede ku nani yi,&gt;&gt; &lt;&lt;Ba nsude yaa yi mbo mamanki a siki seni na de yaa pala mbo mumungu a kiya na a beyi ba, <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Du nsude yaa yi geba ngye mu ba e ma namu la. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Ni ma gye ku gaskye, du nsude e ba ku koshiya ni riki a siki seni na sobon ku ma ni Kiristi yaa lesa nani wuta e yi ba.<verse eid="MRK 9:41" /></para>
  <para style="s1">Mbode Yaa Sa ntani Yi Lepi</para>
  <para style="r">
    <ref loc="MAT 18:6-9">Mat 18.6-9</ref>; <ref loc="LUK 17:1">Lk 17.1</ref>,<ref loc="LUK 17:2">2</ref></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />&lt;&lt;Nde nseda yaa sa daa a siki yaya dende de su yeda nja ni su yi lepi, yaa pi yi kyawu de su domuna yi anpirinya a wuya de su leyi kutiri ta siki totolo riki. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Nde nani ke yaa sa ke lepi, ki yenkye yi kutiri. Yaa pi ke kyawu de ki yuru anya Mirikisi ni nani daa nja de ki yuru a siki wuta ni nani bi, wuta de yaa muntu ba. <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />Anya ni osunso de sua suku su sua muntu ba, wuta ni kwa sua kisa yi ba. <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Nde seni ke yaa sa ke yi lepi, ki yenkye yi kutiri. yaa pi ke kyawu de ki yuru anya Mirikisi ni yeyenkye seni daa, nja de ki yuru gizi wuta nja seni bi. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />Anya ni osunso de sua suku su sua muntu ba, wuta ni kwa sua kisa yi ba. <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Nde ndani ke yaa sa ke yi lepi, ki butu yi. Yaa pi ke kyawu de ki yuru a siki gizi Mirikisi ni ndani daa nja de ka yuru a gizi wuta ni ndani ke bi, <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />Anya ni</para>
  <para style="q1" vid="MRK 9:48">&lt;&lt;&lt;osunso de sua suku su sua muntu ba,</para>
  <para style="q2" vid="MRK 9:48">wuta ni kwa sua kisa yi ba.&gt;&gt;&gt; <verse eid="MRK 9:48" /><verse number="49" style="v" sid="MRK 9:49" />Konse sua serikekye yi ni wuta kankye giri. <verse eid="MRK 9:49" /><verse number="50" style="v" sid="MRK 9:50" />&lt;&lt;Giri e man kyawu, sede nde zanki e yi yaa, ni mina kwa gyale yi? Se ku mani giri a dishiya aku, ku yi zunwa selema nja guru ntani.&gt;&gt;<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Yesu Kokoyi A kiya Kisa amere</para>
  <para style="r">
    <ref loc="MAT 19:1-12">Mat 19.1-12</ref>; <ref loc="LUK 16:18">Lk 16.18</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Yesu dege anya ni e te a kesa ni Yawudiya e nyenteri totolo riki ni Yoda. Ntani nyowa su zo tala anya e yi, Yesu kokoyi su yiri de e saba.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Se worosu Parisiyawa zo de su gwada yi su minya yi nkye, &lt;&lt;Eman kyawu na a siki doka Musa de nseminji e shika mata yi?&gt;&gt;<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Yesu keleba nkye, &lt;&lt;Mina doka Musa pala?&gt;&gt;<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />Su keleba nkye, &lt;&lt;Musa ba mu dama de mu rubuta takada ni kisa amere de mu shika mata mu.&gt;&gt;<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Yesu keleba, &lt;&lt;Sobon tori kiya ku na Musa rubuta ku doka mu.&gt;&gt; <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />&lt;&lt;Sede a pari takada Mirikisi e yi &lt;su ma nseminji nja mase la.&gt; <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />&lt;Sobon yomu nseminji yaa bila adaa yi nja Amaa yi yaa mala nja mata yi, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />Yomu la osu bi sua ma kankye nki daa.&gt; Sua ma nki bi gagaba, sede daa. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Nkayomu mbo de Mirikisi gama, kede nsebeki e laba.&gt;&gt;<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />De su ma a gizi, yayagizi Yesu minya yi a kiya mbom jaja. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Yesu keleba nkye, &lt;&lt;Du nseminji de kula mata yi de amere mase daa e yi lepi ni kwana nja mata nseda nja e sa mata yi de yi lepi. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Nde mase kisa amere nja minji e yi de e yi amere nja nseminji daa, e yi lepi kwana nja mata nseda aka.&gt;&gt;<verse eid="MRK 10:12" /></para>
  <para style="s">Yaya Dende Nja Yesu</para>
  <para style="r">
    <ref loc="MAT 19:13-15">Mat 19.13-15</ref>; <ref loc="LUK 18:15-17">Lk 18.15-17</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Ntani su ma zo yaya dende anya Yesu de sa su anabirika, yayagizi e yi kwabe su. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />De Yesu geni yomu, e yi anwashi, E gye su nkye, &lt;&lt;Ku bila yaya dende de su zo anya na, kede ku nana su ba, sobon solota Mirikisi e ma ni yiri asu la. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Ni ma gye ku gaskye, du nsude yeda ni solota Mirikisi yiride yaya dende sua yi ba yaa yuru a siki gizi Mirikisi ba.&gt;&gt; <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Se Yesu la yaya dende, e ja su nani yaa sa su anabirika.<verse eid="MRK 10:16" /></para>
  <para style="s">Yaa Minzi Nsu Mbo Nani</para>
  <para style="r">
    <ref loc="MAT 19:16-30">Mat 19.16-30</ref>; <ref loc="LUK 18:18-30">Lk 18.18-30</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />De Yesu dege bila anya ni, se nseminji daa butu ngudu zo anya e yi zo dure a geba e yi e minya nkye. &lt;&lt;Male kyakyawu,&gt;&gt; &lt;&lt;Mina na yi de na samu leyi ni gbogbo?&gt;&gt;<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />Yesu keleba nkye, &lt;&lt;Mina sa ki sukwa ni male kyakyawu?&gt;&gt; &lt;&lt;Ba nseda de ma male kyakyawu ba sede Mirikisi dandaa e yi. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Ki shina doka: Kede ki yi lepi kwana nja mata nseda, kede ki yi bolowa, kede ki beyi sheeda ni yaruwa, kede ki shushe nse da ba, ki ba Adaa ke nja Amaa ke girima.&gt;&gt;&gt;<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />E gye yi nkye, &lt;&lt;Male&gt;&gt; &lt;&lt;Guru mbo mu ni ma yi tunde ni ma yaa dende.&gt;&gt;<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Yesu kone yi ni so nkye, &lt;&lt;Mbo daa kin na ki lesa.&gt;&gt; &lt;&lt;Te de ki la guru mbode ki ma nshi see de ki ba potoruwa, yomu na ka mani bogolo a bisi. tuku de ki zo de biya ni.&gt;&gt;<verse eid="MRK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 10:22" />Anya ni e domuna ndani yi. E dege ta meyi ni beki siki sobon e ma ni mbo nani nyowa.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Yesu kone yayagizi yi nkye, &lt;&lt;Yaa man wuya de nsu mbo nani su yuru a solota gizi Mirikisi!&gt;&gt;<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Yayagizi e yi su yi mamanki a kiya kelima yi. Sede Yesu gye su jaja nkye, &lt;&lt;Yaya na, woni yiri wuya yaa ma de nsebeki yaa yuru a siki solota Mirikisi! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Yaa pi soki de nakurimi te biya ndani aromuna nja de nsu mbo a nani yaa yuru a siki solota gizi Mirikisi.&gt;&gt;<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Yayagizi e yi su yi mamanki soseyi, se su gye nkiya su nkye, &lt;&lt;Waana yaa sila?&gt;&gt;<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Yesu kone su nkye, &lt;&lt;Anya nsebeki yaa yiwu, sede anya Mirikisi yaa yiwu ba; sobon guru mbo yaa yiwu anya Mirikisi.&gt;&gt;<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Biturusu gye yi nkye, &lt;&lt;Mu bila guru mbo de mua yi mu biya ke!&gt;&gt;<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Yesu keleba nkye, &lt;&lt;Ni ma gye ku gaskye,&gt;&gt; &lt;&lt;Ba nsude bila gizi ko yayuwa e yi menza ko yayuwa e yi mata ko Adaa ko Amaa ko yaya ko bikiya sobon ni manki kyakyawu mu. <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />De yaa lesa samu nani wuta e yi sen deri a kwanki mu, ni &lt;gizi, ko yayuwa menza, ko yayuwa mata, ko Amaa, ko yaya nja bikiya, sede nja Genbeki nja sana nsu zo yaa samu leyi ni gbogbo. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Sede ntani nyowa de su ma ni pari sua ma ni karishe, ni karishe kuma sua ma ni pari.&gt;&gt;<verse eid="MRK 10:31" /></para>
  <para style="s">Yesu Pala Yiri Muntu E yi Jaja</para>
  <para style="r">
    <ref loc="MAT 20:17-19">Mat 20.17-19</ref>; <ref loc="LUK 18:31-34">Lk 18.31-34</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />De su ma a turiki su ma te ni Wurishelima, Yesu la geba asu, yayagizi e yi su ma biya e yi su meyi mamanki, worede ma biya su a beyi su ma zi womba. Yesu sakye la yayagizi yi gom sha bi mu a keteri e ma gye su mbode yaa a paru nja nshi nkye. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />&lt;&lt;Mua te a Wurishelima,&gt;&gt; &lt;&lt;Yaa nsebeki sua butu yi a beyi ba tolense ni pirisi nja male ni doka Musa. Sua yi shiriya ni muntu nja sua leyi beyi a nani worede su ma Yawudawa ba, <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />sua yi dala nene nja sua nya yi anyanya. sua dukwa e yi ari su kisa yi. A beyi kwana wuku yaa dege nleyi.&gt;&gt;<verse eid="MRK 10:34" /></para>
  <para style="s">Yakubu Nja Yaaya Su Ologba Yesu</para>
  <para style="r">
    <ref loc="MAT 20:20-28">Mat 20.20-28</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Se Yakubu nja Yaaya, yaya ni Zabedi, zo anya Yesu su nkye. &lt;&lt;Male,&gt;&gt; &lt;&lt;Mua bila de mu pata ke mbodaa.&gt;&gt;<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />Yesu nkye, &lt;&lt;Mina kwa bila de ni yi ku nshi?&gt;&gt;<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />Su keleba nkye, &lt;&lt;Bila de daa a siki amu e zunwa a nani dama ake daa kuma a nani guni ake a siki nana solota ni dereja ake.&gt;&gt;<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />Yesu nkye, &lt;&lt;Ku shina mbode kwa minya ba,&gt; Kwa yi yaa sha a koshiya Genbeki de na sha ko kwa yi yaa yi tunkwasa ni yiri tunkwasa de sua yi ni nshi?<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />Su keleba nkye, &lt;&lt;Mua yi yaa,&gt;&gt; Yesu gye su nkye, &lt;&lt;Kwa yi yaa sha a koshiya de na sha nja yiri tunkwasa de Ni yi, <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />sede zunwa a nani dama ko a nani guni e ni na na beyi ba. Anya mu e ma ni worede su rigye shiriya su nshi la.&gt;&gt;<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />De ririgye yayagizi e yi gom zi yomu, su zi anwashi Yakubu nja Yaaya. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Yesu sukwa su anya daa e gye su nkye, &lt;&lt;Ku shina nkye a siki worede su ma Yawudawa ba de su shina su ni solota su ma nana ntani yiko, nja toree asu su ma nana yiko a kiya su. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Sede yomu na yaa ma nja ku ba. Sobon du nsude yaa bila de e ma totolo dole na e ma bunwa aku, <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />yomuna guru nsude yaa bila de e ma ni pari dole na e ma bunwa ni konwawa. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Sobon Yaa nsebeki e zo de su bowuta e yi na ba, sede de e yi ntani bowuta, nja de e beyi leyi e yi de e sila ntani nyowa<verse eid="MRK 10:45" /></para>
  <para style="s">Yesu Bure Ndani Makapi de Sua Sukwa yi Batimawus</para>
  <para style="r">
    <ref loc="MAT 20:29-34">Mat 20.29-34</ref>; <ref loc="LUK 18:35-43">Lk 18.35-43</ref></para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Se su zo a Yeriko. Yesu nja yayagizi e yi nja ntani nyowa, sua bila de su butu a geri ni, makapi daa de seni yi ma Batimawus yaa ni Timawus, e zunwa a keteri turiki e ma yi pata. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />De e zi nkye Yesu ni Nazere na e ma bise e dege murinya nsori nkye, &lt;&lt;Yesu Yaa ni Dowuda, ki zi toseyi na!&gt;&gt;<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Ntani nyowa su kwabe yi nkye yi shuru, sede e dege murinya nsori nkye, &lt;&lt;Yesu Yaa ni Dowuda, ki zi toseyi na!&gt;&gt;<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Yesu sakisi nkye, &lt;&lt;Sukwa yi de e zo.&gt;&gt; se su sukwa makapi ni su nkye, &lt;&lt;Yi perisiki! Dege a bisi ni seni ake! Yaa sukwa ke.&gt;&gt; <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />Anya ni e la ogbodo yi kutiri, e tirimi ni te anya Yesu.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />Yesu minya yi nkye, &lt;&lt;Mina ka bila de ni yi ke nshi?&gt;&gt;</para>
  <para style="p" vid="MRK 10:51">Makapi nkye, &lt;&lt;Male, Na bila de ni geni anya.&gt;&gt;<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Yesu gye yi nkye, &lt;&lt;Ki te,&gt;&gt; &lt;&lt;beigaskye ake worikye ke.&gt;&gt; Dandani e ma geni anya se e biya Yesu te.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Yesu Yuru A Wurishelima Kankye Seleki</para>
  <para style="r">
    <ref loc="MAT 21:1-11">Mat 21.1-11</ref>; <ref loc="LUK 19:28-40">Lk 19.28-40</ref>; <ref loc="JHN 12:12-19">Jn 12.12-19</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />De Yesu nja yayagizi e yi su zo kusa ni Wurishelima nja Betapaji nja Betani anya dunsi zetu, se Yesu saka yayagizi e yi bi su la geba, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />e gye su nkye, &lt;&lt;Ku yuru a siki dende geri de ma a geba ku, kwa geni yaa janki de su domuna e yi ba nsude taba nyunwa e yi wo ba. Ku konse yi zo nshi. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Nde nseda minya ku nkye, &lt;Mina sa kwa yi yomu?&gt; ku gye yi nkye, Nsugizi amu nkye mu konse te nshi yaa kuma ku nshi kuzukam.&gt;&gt;&gt;<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />De su te su geni yaa janki a woze a baki turiki, su domuna a kopa gizi. Se su konse yi, <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />worosu su ntani sakisi anya ni su minya nkye, &lt;&lt;Mina yi, de kuma konse yaa janki?&gt;&gt; <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />Su keleba kyakya yiri de Yesu gye su nkye su pala, se woroni bila su te ma su. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />De su zo ni yaa janki keyi Yesu su kwa yi riga su nya ANKI janki ni, Yesu zunwa a kiya yi. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Ntani nyowa nya ogbodo asu a turiki, worosu su nya genya de su sala dege bikiya. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Worede su ma a geba nja worede su ma biya e yi a beyi su dege murinya asu su ma nkye,</para>
  <para style="q1" vid="MRK 11:9">&lt;&lt;Osana!&gt;&gt;</para>
  <para style="q1" vid="MRK 11:9">&lt;&lt;Anabirika ma nja nsude e ma zo a siki seni Obagizi!&gt;&gt;<verse eid="MRK 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />&lt;&lt;Anabirika ma nja solota ni Adaa amu Dowuda!&gt;&gt;</para>
  <para style="q1" vid="MRK 11:10">&lt;&lt;Osana te nja Mirikisi a siki Bisi!&gt;&gt;<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Yesu yuru a Wurishelima e bise a Laki Lepa. E kone guru mbo, sede tunde nyema yi, Yesu butu te ni Betani nja yayagizi e yi.<verse eid="MRK 11:11" /></para>
  <para style="s">Yesu Shire Laki Lepa</para>
  <para style="r">
    <ref loc="MAT 21:18">Mat 21.18</ref>,<ref loc="MAT 21:19">19</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />De geri shekeri su bila Betani, Yesu zi nyunwa. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Yesu geni ntasi bori nsu genya, e te de kone ko e man yaya. De te anya ni, e san mbodaa ba sede genya la kin, sobon e ma kwanki de bori yaa yi yaya na ba. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Se Yesu gye ntasi bori nkye, &lt;&lt;Nseda yaa sakye suku yaya ke ba ni gbogbo gbogbo.&gt;&gt; Yayagizi e yi zi mbode e pala.<verse eid="MRK 11:14" /></para>
  <para style="s">Yesu ta Laki Mirikisi</para>
  <para style="r">
    <ref loc="MAT 21:12-17">Mat 21.12-17</ref>; <ref loc="LUK 19:45-48">Lk 19.45-48</ref>; <ref loc="JHN 2:13-22">Jn 2.13-22</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />De Yesu bise te a Wurishelima, e yuru a Laki Lepa e para kula worede su ma la keikei see nja nsu see keikei. Yesu kiri teburu ni nsu shenja gyolo nja kingbolo ni nsu la tatambiri see, <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Yesu nana konwawa la mbo see a baki kopa yuru a Laki lepa. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Se Yesu kokoyi su, nkye, e ma rubuta a siki beta Mirikisi nkye:</para>
  <para style="q1" vid="MRK 11:17">&lt;&lt; &lt;Gizi na sua sukwa yi</para>
  <para style="q2" vid="MRK 11:17">gizi lepa ni guru ntani bo?&gt;</para>
  <para style="m" vid="MRK 11:17">Sede ku leyi ma kunguni bolowa.&gt; &gt;&gt;<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Tolense pirisi nja Male ni doka Musa su zi yomu su para bila turiki de sua kisa yi, sua womba yi, sobon guru ntani de su tala sua yi mamanki a kiya mbode yaa kokoyi.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />De nyema yi, su butu bila geri ni.<verse eid="MRK 11:19" /></para>
  <para style="s">Ntasi Bori De Kyekeri</para>
  <para style="r">
    <ref loc="MAT 21:20-22">Mat 21.20-22</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />De geri shekeri, su ma bise, su geni ntasi bori ni kyekeri butu a ririnya yi. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Biturusu turunwa e gye Yesu nkye, &lt;&lt;Male, kone ntasi bori de ki yii baki mu e kyekeri&gt;&gt; <verse eid="MRK 11:21" /><verse number="22" style="v" sid="MRK 11:22" />Yesu keleba su nkye, &lt;&lt;Ku beigaskye nja Mirikisi,&gt;&gt; <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />&lt;&lt;Ni ma gye ku gaskye, du nsude beigaskye ni Mirikisi yaa gye dunsi mu nkye, &lt;dege te, de ki puari a siki totolo minya,&gt; nde ki laba dishiya e yi a kiya mbode e pala ba, yaa paru. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Nkayomu Ni ma gye ku, Guru mbode ku pata a siki lepa, ku beigaskye nkye kwa samu, yomuna yaa ma na ku. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Guru kwanki de kwa yi lepa, nde ku keyi nseda a dishiya ku yape yi, sobon Adaa ku ni bisi ma yaa yape lepi aku. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />Sede nde ku yape yayuwa ku ba yomuna Adaa ku ni bisi yaa yape lepi aku ba.<verse eid="MRK 11:26" /></para>
  <para style="s">Toree Yawudawa Minya Sori Ni Yesu</para>
  <para style="r">
    <ref loc="MAT 21:23-27">Mat 21.23-27</ref>; <ref loc="LUK 20:1-8">Lk 20.1-8</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />De Yesu nja yayagizi e yi Su kwa yuru a geri Wurishelima, Yesu ma gyewe a siki Laki lepa, se tolense ni nsu pirisi, nja Male ni doka Musa nja toree su zo anya ni. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />Su minya nkye, &lt;&lt;Ni woni sori na ki ma yi mbo worosu mu?&gt;&gt; &lt;&lt;Waa ba ke sori de ka yi mbo mu?&gt;&gt;<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />Yesu keleba nkye, &lt;&lt;Na minya ku mbodaa. Nde ku gye ni, Na gye ku ko ni woni sori na ni ma yi mbo worosu mu. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Ku gye ni! Tunkwasa ni Yaaya e ma dege bisi na, ko dege anya nsebeki la?&gt;&gt;<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Se su yi shewura nja nkiya su su nkye, &lt;&lt;Nde mu nkye dege bisi na,&gt; yaa minya mu nkye, &lt;To mina sa de ku beigaskye nja ni ba?&gt; <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Sede nde mu nkye, &lt;Dege anya nsebeki na&gt; sua zi womba ntani shina nkye Yaaya e ma anebi la.<verse eid="MRK 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 11:33" />Se su keleba Yesu nkye, &lt;&lt;Mu shina ba.&gt;&gt;</para>
  <para style="p" vid="MRK 11:33">Yesu nkye, &lt;&lt;E ni na gye ku ko ni woni sori na mma yi mbo worosu mu ba.&gt;&gt;<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Abenshi ni Nsu Keleba Bikiya Gyolo</para>
  <para style="r">
    <ref loc="MAT 21:33-46">Mat 21.33-46</ref>; <ref loc="LUK 20:9-19">Lk 20.9-19</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Se Yesu para yi beta nja su a siki abenshi: &lt;&lt;Nseda yi bikiya yi ntani inebi. E gina golonwa gyowe yi, e yanka romu ni keleba riki ntasi inebi nja gina anya ni nsu kpanku bikiya. Se e la bikiya mu beyi aya e yi tepiya te anya daa. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />A kwanki de keyi bikiya nunu e saka bunwa yi daa de e keleba yi yaya inebi ni bikiya yi. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Sede su keyi, su dukwa e yi su kule yi te nani wopi. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Se e sakye saka bunwa daa te anya asu; Su dukwa e yi su yi wulakanshi. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Se e sakye saka bunwa daa, su kisa yi. E saka worosu su nyowa; su dukwa worosu su, su kisa worosu su.<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />E ma ni nseda rigye de yaa sakye yi, yaa e yi ndandaa, nsude e ma so. E saka yi a karishe guru, nkye, &lt;Sua geni girima ni yaa na.&gt;<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />&lt;&lt;Sede nsu aya bikiya gye nkiya su, osu na yaa si gado e yi. ku zo de mu kisa yi de gado e ma namu.&gt; <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Se su keyi kisa yi, su leyi kutiri a beyi bikiya inebi.<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />&lt;&lt;Mina nsu bikiya inebi mu yaa yi? Yaa zo kisa nsu aya bikiya ni, yaa la bikiya ba worosu su a nani . <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Ku taba karanta a siki takada Mirikisi bo:</para>
  <para style="q1" vid="MRK 12:10">&lt;&lt; &lt;Dunsi de nsu gini ki yi ampani nshi</para>
  <para style="q2" vid="MRK 12:10">e shiya ma nsu de pi kyawu guru;<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />Obagizi na yi mbo nsum,</para>
  <para style="q2" vid="MRK 12:11">e ma mbo mamanki na a ndani mu&gt;?&gt;&gt;<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Se toree Yawudawa su bila turiki de sua ka Yesu Sobon su gane e yi beta ni abenshi a kiya su na. Sede sua zi womba ntani de su tala; se su bila e yi te ma su.<verse eid="MRK 12:12" /></para>
  <para style="s">Beyi Gendu Ba Kaisar</para>
  <para style="r">
    <ref loc="MAT 22:15-22">Mat 22.15-22</ref>; <ref loc="LUK 20:20-26">Lk 20.20-26</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Worosu Parisiyawa nja worosu ntani Yirudiya saka su anya Yesu de su ka yi a siki beta yi. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Su zo anya Yesu su nkye, &lt;&lt;Male, mu shina ki ma nse gangasi na. Ntani su ma yiri daa na anya ke, sobon ki ma nana bombom nja ntani ba; sede ki ma kokoyi doka Mirikisi de ma a kiya gaskye. Ema kyakya na mu beyi gendu ba keisa ko mu ki beyi? <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />Mu beyi ko kede mu beyi?&gt;&gt;</para>
  <para style="p" vid="MRK 12:15">Sede Yesu shina munabuki asu. Yesu minya su nkye, &lt;&lt;Mina sa de kwa yi kokori gwada ni?&gt;&gt; &lt;&lt;Ku zo ni kobo de sua beyi gendu nshi de Ni geni.&gt;&gt; <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />Su zo kobo de sua biya gendu keyi Yesu, e minya su nkye, &lt;&lt;Woto nja seni mu e ma ni waa?&gt;&gt;</para>
  <para style="p" vid="MRK 12:16">Su nkye, &lt;&lt;Ni keisa la,&gt;&gt;<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Se Yesu gye su nkye, &lt;&lt;Ku ba Keisa mbode e ma ni Keisa nja ku ba Mirikisi mbode ma ni Mirikisi.&gt;&gt;</para>
  <para style="p" vid="MRK 12:17">Su yi mamanki soseyi a kiya mbode e pala.<verse eid="MRK 12:17" /></para>
  <para style="s">Minya A kiya Dege A kumsha</para>
  <para style="r">
    <ref loc="MAT 22:23-33">Mat 22.23-33</ref>; <ref loc="LUK 20:27-40">Lk 20.27-40</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Se Sadokiyawa, worede su ma nkye dege a kumsha ma ba, su minya Yesu. <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />Su nkye, &lt;&lt;Male,&gt;&gt; &lt;&lt;Musa rubuta ba mu nkye nde yayiwa nseda muntu bila mata yi ba yaya, ema dole na yayiwa yi amere mase mu de su yapu yaya ba yayiwa yi de muntu ni. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Mu mani worosu yayuwa bokwe. Ni pari yi amere ari e muntu e man yaya ba. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Ni bi amere mase makeyi, e shi ma e muntu, ba yaa. Ema yomu na nja ni wuku. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Yomu na, ba nseda a siki asu bokwe de yapu yaya ba. A karishe guru, mase ni muntu du. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />A nana dege kumsha yaa ma mata waa a siki asu, tunde guru asu bokwe su amere yi?&gt;&gt;<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Yesu keleba nkye, &lt;&lt;Tunani dishiya aku ma kyakya ba sobon ku shina mbode ma a siki takada Mirikisi ba ku kuma shina yiko Mirikisi ba. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Nde worede su muntu dege a kumsha, sua yi amere ko su la yaamase beyi amere ba; guru sua ma kankye meleku de su ma a siki bisi. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />A kiya dege kumsha ku karanta a takada Musa bo, sobon su rubuta nabari ni sanwa de suwuta nkye, &lt;E ni na ni ma Mirikisi ni Abireyi, Mirikisi ni Ishaku nja Mirikisi ni Yakubu&gt;? <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />E ma Mirikisi ni worede su muntu na ba, sede ni worede su man leyi na. Ku yi totolo kusukuri la&gt;&gt;<verse eid="MRK 12:27" /></para>
  <para style="s">Totolo Doka</para>
  <para style="r">
    <ref loc="MAT 22:34-40">Mat 22.34-40</ref>; <ref loc="LUK 10:25-28">Lk 10.25-28</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Daa a siki male doka Musa zo zi su su ma yi musu. E gane Yesu keleba su kyakya la, e minya Yesu nkye, &lt;&lt;A siki guru doka, wona pi girima?&gt;&gt;<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Yesu keleba nkye, &lt;&lt;Doka de pi girima,&gt;&gt; e shiya ma nsum: &lt;Ku zi, Oku ntani Izireyila, Obagizi Mirikisi amu, Obagizi ma daa na. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Ki so Obagizi Mirikisi ake ni guru dishiya ake, nja guru leyi ake, nja guru ankeli ake, nja kuma guru sori ake.&gt; <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Ni bi e shiya ma nsum: &lt;Ki so dengeri ake kankye kiya ake.&gt; Ba doka daa de pi worosu mu girima ba.&gt;&gt;<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />Se Male doka nkye, &lt;&lt;Gaskye na ki pala, Mirikisi ma daa la nseda ma kankye e shi ba. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Ki so yi nja guru dishiya ake, nja guru ankeli ake, nja guru sori ake, nja ki so dengeri ake kankye kiya ake e pi beiko nja sedeka girima&gt;&gt;<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />De Yesu geni e keleba ni simi, se e gye yi nkye, &lt;&lt;Ki yi nyisa nja solota Mirikisi ba.&gt;&gt; A beyi nsum e sakye minya yi mbodaa gagaba.<verse eid="MRK 12:34" /></para>
  <para style="s">Yaa Waa Ma Kiristi</para>
  <para style="r">
    <ref loc="MAT 22:41-46">Mat 22.41-46</ref>; <ref loc="LUK 20:41-44">Lk 20.41-44</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />De Yesu ma kokoyi ntani a siki laki Mirikisi, e minya nkye, &lt;&lt;Mina sa male doka Musa su ma nkye Kiristi ma Yaa ni Dowuda? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Sobon Dowuda nkiya yi, de aworo e yi beta, nkye:</para>
  <para style="q1" vid="MRK 12:36">&lt;&lt;&lt;Obagizi gye Obagizi na:</para>
  <para style="q2" vid="MRK 12:36">Zunwa a nani dama na</para>
  <para style="q1" vid="MRK 12:36">ari ni sa obokigeba ake</para>
  <para style="q2" vid="MRK 12:36">a tapi seni ke.&gt;&gt;&gt;<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />Dowuda nkiya yi sukwa yi &lt;Obagizi.&gt; Yaya na yaa ma yaa yi?&gt;&gt;</para>
  <para style="s" vid="MRK 12:37">Yesu Pelesa Male Nsu Kokoyi Doka Musa</para>
  <para style="r" vid="MRK 12:37">
    <ref loc="MAT 23:1-36">Mat 23.1-36</ref>; <ref loc="LUK 20:45-47">Lk 20.45-47</ref></para>
  <para style="p" vid="MRK 12:37">Ntani de su zi su yi peri siki. <verse eid="MRK 12:37" /><verse number="38" style="v" sid="MRK 12:38" />A siki kokoyi yi, Yesu pala nkye, &lt;&lt;Ku sa ndani nja nsu male ni doka Musa. Sua bila de su gyewe a siki ntani ni angwe dololo nja de su geshe su a siki bije, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />nja anya zunwa de pi kyawu a siki kolonwa nja beyi girima anya buki. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Osu na sua si keyi mata makeyi a gizi asu nja sua yi lepa nyisa. yiri asu na sua yi shiriya nsu zapi.&gt;&gt;<verse eid="MRK 12:40" /></para>
  <para style="s">Beiko Ni Mase Makeyi</para>
  <para style="r">
    <ref loc="LUK 21:1-4">Lk 21.1-4</ref></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Yesu zuzunwa anya beyi beiko yaa kone ntani de sua sa gyolo a siki akpati ni kolonwa. Nyowa nsu mbo a nani sa gyolo nyowa. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Sede potoruwa mase makeyi daa zo sa rebi ni toro bi de e ma shi.<verse eid="MRK 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 12:43" />Yesu sukwa yayagizi e yi, e gye su nkye, &lt;&lt;Ni ma gye ku gaskye, potoruwa mase makeyi mu e saka gyolo mbo beiko pi guru ntani. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Guru su beyi dege siki mbo nani su; sede mase makeyi mu, e beyi guru mbo de e ma nshi.&gt;&gt;<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Worosu Alama Ni Karishe Kwanki</para>
  <para style="r">
    <ref loc="MAT 24:1">Mat 24.1</ref>,<ref loc="MAT 24:2">2</ref>; <ref loc="LUK 21:5">Lk 21.5</ref>,<ref loc="LUK 21:6">6</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />De Yesu butu bila Laki lepa, daa a siki yayagizi yi gye yi nkye, &lt;&lt;Male, kone! yiri totore dunsi nja kyakyawu gini worosu mu!&gt;&gt;<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />Se Yesu keleba nkye. &lt;&lt;Ku kone guru totolo gini woromu?&gt;&gt; &lt;&lt;Ba dunsi daa de yaa kwana a kiya daa ba; sua juru su guru.&gt;&gt;<verse eid="MRK 13:2" /></para>
  <para style="s">Genbeki ni Pari</para>
  <para style="r">
    <ref loc="MAT 24:3-14">Mat 24.3-14</ref>; <ref loc="LUK 21:7-19">Lk 21.7-19</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />De Yesu zunwa a kiya dunsi zetu de ma kone Laki lepa Mirikisi, anya ni Biturusu, Yakubu, Yaaya, nja Anduru su minya Yesu a boyi, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />&lt;&lt;Gye mu, woshe na mbo mu yaa paru? nja mina ma alama de yaa nana de mbo worosu mu yaa bila paru?&gt;&gt; <verse eid="MRK 13:4" /><verse number="5" style="v" sid="MRK 13:5" />Se Yesu gye su nkye: ku kone de kede nseda e shishirigye ku. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Ntani nyowa sua zo a siki seni na, sua nkye, &lt;Eni na ni ma Yesu sua shishirigye ntani nyowa. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Nde ku zi sua yi yanki nja nabari yanki, kede dishiya ku e dege, dole na mbo mu sua paru, sede karishe tuku zowo ba. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Kesa daa yaa yi geba ni kesa daa, solota daa yaa yi geba ni solota daa. Sua yi totolo zizika kesa anya nyowa, sua yi totolo nunwa. Nsu mu ma kankye pari ni Genbeki yapu yaa la.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />&lt;&lt;Sede ku kpanku nkiya ku. Sobon sua la ku beyi ba salaki de su dukwa ku a kolonwa. sobon e ni sua te nku a geba ni nsu gomuna nja nsu seleki de ku sakisi beyi sheeda ni nabari kyakyawu mu a geba su. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Sede dole nabari kyakyawu ni solota gizi bisi sua pala nabari yi a konaga a guru durinya. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Nde su te zo nku a geba shiriya, kede e dama ku a kiya mbode kwa pala. ku pala mbode su ba ku a kwanki ni, sobon oku na kwa yi beta ba, sede Aworo Nsuseki.<verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />&lt;&lt;Yayiwa yaa butu yayiwa e yi a beyi de su kisa yi, adaa yaa butu yaa e yi a beyi, yaya sua yi geba ni nsu adaa su ari sua sa de su kisa su. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Guru ntani sua ki zini ku sobon eni, sede nsude sakisi ni sori ari karishe yaa samu sila.<verse eid="MRK 13:13" /></para>
  <para style="s">Mungu Genbeki</para>
  <para style="r">
    <ref loc="MAT 24:15-28">Mat 24.15-28</ref>; <ref loc="LUK 21:20-24">Lk 21.20-24</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />&lt;&lt;Nde ku geni mbo rebi de yaa zo ni bebeta mbo kyakyawu de sakisi anya de kamata ba, bila de nsu karanta e gane, worede su ma a Yawudiya su yi gudu te a kiya totolo dunsi. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Kede nsude ma a kiya lenda e sonka kisi ko e yuru a gizi de e la mbodaa a siki yi ba. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Kede nsude ma a bikiya e kuma de e la ogbodo yi ba. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Gbotuma mata nsu siki nja worede sua ba yaya su nono a kwanki de mbo mu yaa paru! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Ku yi lepa de kede mbo woromu su paru kwanki ni yari, <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Sobon yaa ma kwanki ni Genbeki la soseyi de su taba geni yiri yi ba tun de Mirikisi yi durinya ari zo a kuzukam nja sua kara yi yiri gagaba. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Nde ba Obagizi na rigye kwanki ba, ba nsude yaa taba sila ba. Sede sobon yaya e yi, worede e zabi su, na rigye kwanki ni. <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />A kwanki ni nde nseda gye ku nkye, &lt;Kone, anya mu na Kiristi ma&gt; ko &lt;kone, anya ni e shiya ka!&gt; kede ku yeda. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Sobon Kiristi ni yaruwa nja anebi ni yaruwa sua butu, sua nana alama nja yi anki mamanki de su shishirigye worede su zabi su nde yaa yi yaa ma yomu. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Sobon yomu ku kone nkiya ku, Eni rigye gye ku guru mbode yaa paru a geba.<verse eid="MRK 13:23" /></para>
  <para style="s">Zo ni Yaa Nsebeki</para>
  <para style="r">
    <ref loc="MAT 24:29-31">Mat 24.29-31</ref>; <ref loc="LUK 21:25-28">Lk 21.25-28</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />&lt;&lt;Sede a nana ni, a beyi Genbeki mu. &lt;&lt;&lt;Nana yaa yi dopuwa, wonta yaa beyi asikye yi ba; <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />kemu yaa puari dege bisi, sua kuma zizika yiko ni bisi. <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />&lt;&lt;A kwanki ni ntani sua geni Yaa nsebeki de yaa zo a siki a gidagida nja totolo sori nja girima. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Yaa saka meleku yi de su tala guru worede su zabi su dege keteri ni durinya guru, dege karishe ni durinya zo te a karishe ni bisi.<verse eid="MRK 13:27" /></para>
  <para style="s">Kokoyi a kiya Ntasi Bure</para>
  <para style="r">
    <ref loc="MAT 24:32-35">Mat 24.32-35</ref>; <ref loc="LUK 21:29-33">Lk 21.29-33</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />Kuzukam ku kokoyi abenshi anya ni yaya ntasi bori: Nde ku geni genya e yi para nya, ku shina nkye damina kusa. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Yomuna, nde ku geni mbo worosu mu yaa paru, ku shina nkye ema baki kopa. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Mma gye ku gaskye, ntani sana mu sua taba bise ba se guru mbo worosu mu paru. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Bisi nja kisi yaa bise, sede kelima na yaa taba bise ba.<verse eid="MRK 13:31" /></para>
  <para style="s">Ba Nsude Shina Nana Ko Kwanki ba</para>
  <para style="r">
    <ref loc="MAT 24:36-44">Mat 24.36-44</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />Sede nseda shina nana ko woni kwanki na yaa zo ba, ko meleku ni bisi, ko Yaa, sede adaa ndandaa yi kin. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />ku kone kiya ku, ku zunwa ni shiri! sobon ku shina nana ko kwanki de yaa zo ba. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Ema kankye nseminji de yaa yi tepiya, e bila gizi yi a nani nsu bunwa e yi, e ba konwawa ANKI de yaa yi, na gye nsu kpanku kopa de e sigeba ni kpanku. <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />Nkayomu ku sigeba ni kone sobon ku shina nana de nsugizi aku yaa kuma mbayi ko nyema, ko nsisika ndederi, ko de zakala yaa yi kala, ko mbaki sasape. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Nde e te zo dandani, kede e san ku ma yi kwana. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Mbode Ni ma pala gye ku, Ni pala gye konwawa la: &lt;Ku zunwa ni kpanku&gt;&gt;&gt;<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Toree Yawudawa Bila Turiki De sua ka Yesu</para>
  <para style="r">
    <ref loc="MAT 26:1-5">Mat 26.1-5</ref>; <ref loc="LUK 22:1">Lk 22.1</ref>,<ref loc="LUK 22:2">2</ref>; <ref loc="JHN 11:45-53">Jn 11.45-53</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Kuzukam e rigye nana bi de sua yi buki ni nyenteri nja buki ni buredi nsu darigaza ba, toree pirisi nja male ni doka Musa sua bila turiki de su ka Yesu de su kisa yi. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Su pala nkye, &lt;&lt;Sede a kwanki buki ni naba,&gt;&gt; &lt;&lt;Dun kede ntani su yi rikishi.&gt;&gt;<verse eid="MRK 14:2" /></para>
  <para style="s">Su Shapa Yesu Mayi Kemeshi a Betani</para>
  <para style="r">
    <ref loc="MAT 26:6-13">Mat 26.6-13</ref>; <ref loc="JHN 12:1-8">Jn 12.1-8</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />De Yesu ma a betani e zunwa ma si mbosi a gizi sima de ma kputuru, mase daa zo ni tuni meyi kemeshi ni nardi sere nsu gyolo nyowa, de su yi ni nardi zala, e wokye tuni mayi kemeshi se e nya Yesu nshi a kiya. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />Worede su ma anya ni yi anwashi su gye nkiya su nkye, &lt;&lt;Mina sa ka yi banza ni tularee mu yomu? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />E yi kyawu de su la tularee mu see ni gyolo nyowa de su ba potoruwa.&gt;&gt; Se su kobe mase ni anwashi. <verse eid="MRK 14:5" /><verse number="6" style="v" sid="MRK 14:6" />Yesu gye su nkye, &lt;&lt;Mina sa kwa dama mase mu? Mase mu e yi Ni mbo kyakyawu de e yi. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Potoruwa ma nja ku a kowon nana, kwa yi yaa sua su nto kwanki de kwa so, Sede e ni ba kowon kwanki na ni ma nja ku ba. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Mase mu yi mbode e yi yaa yi. E shapa Ni mayi a nki de e gyala ni kapi nana bishina na. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Mma gye ku gaskye, Guru anya de sua beyi manki ni nabari kyakyawu mu a durinya, mbode mase mu yi sua pala yi, de su turunwa nshi.&gt;&gt;<verse eid="MRK 14:9" /></para>
  <para style="s">Juda Yeda de Butu Yesu Abeyi</para>
  <para style="r">
    <ref loc="MAT 26:14-16">Mat 26.14-16</ref>; <ref loc="LUK 22:3-6">Lk 22.3-6</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Anya ni Yawuda Isikariyoti, daa a siki ni sha bi, te anya ni toree pirisi de butu Yesu a beyi ba su. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />De su zi yomu su yi peri siki ari su yi anikowori de su beyi gyolo. Yawuda bila turiki de yaa butu Yesu a beyi ba su.<verse eid="MRK 14:11" /></para>
  <para style="s">Yesu Si Mbosi ni Nyenteri Nja Yayagizi e yi</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />A nana ni pari ni buki buredi de mani darigaza ba, de e ma alada de sua beyi sedeka ni timshiya ni yenteri. Yayagizi Yesu minya nkye, &lt;&lt;Angana ka bila de mu te shiriya ke mbosi ni buki Nyenteri?&gt;&gt;<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Se Yesu saka yayagizi e yi bi, e gye su nkye, &lt;&lt;Ku te a siki totolo geri, kwa gomu ni nseminji daa keyi tuni ni riki. Ku biya yi. <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />Se ku gye nsu gizi de e yuru nkye, &lt;male nkye mu minya ke: Angana yaa si mbosi ni nyenteri nja yayagizi yi?&gt; <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Yaa nana ku totolo laki bisi de su gyale yi sobon buki. Ku shiriya mbosi ni buki nyenteri anya ni.&gt;&gt;<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Se yayagizi Yesu bila anya ni, te a siki totolo geri su sani mbo yiride Yesu gye su, se su shiriya buki ni nyenteri.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />De nyema yi, Yesu zo nja yayagizi e yi gom sha bi anya ni. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />De su zunwa su ma si mbosi, Yesu gye su nkye, &lt;&lt;Ni ma gye ku gaskye, daa a siki ku yaa butu ni a beyi nsude yaa si mbosi nja Ni.&gt;&gt;<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Se yayagizi Yesu para yi beki siki, su ma minya nkiya su dandaa nkye, &lt;&lt;E ni na ba ko?&gt;&gt;<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />Yesu keleba nkye, &lt;&lt;Nseda a siki aku gom sha bi,&gt;&gt; &lt;&lt;Daa de e ma si mbosi nja gongo ni. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Yaa Nsebeki yaa te yiride su rubuta a kiya e yi. Sede gbotu ni nseminji de yaa butu yaa Nsebeki a beyi! Yaa pi kyawu de su yapu yi ba,&gt;&gt;<verse eid="MRK 14:21" /></para>
  <para style="s">Obagizi si Mbosi ni Karishe</para>
  <para style="r">
    <ref loc="MAT 26:26-30">Mat 26.26-30</ref>; <ref loc="LUK 22:14-20">Lk 22.14-20</ref>; <ref loc="1CO 11:23-25">1 Kor 11.23-25</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />De su ma a siki si mbosi, Yesu la buredi, E gbede Mirikisi e lalaba, ba yayagizi e yi nkye, &lt;&lt;Ku keleba; nsu mu na ma kankye nki na.&gt;&gt;<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Se Yesu la koshiya riki inebi, a beyi de E gbede Mirikisi e ba yayagizi yi, se guru asu su sha a siki yi.<verse eid="MRK 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 14:24" />Yesu gye su nkye, &lt;&lt;Da mu na ma kankye zini na ni sabuwa anikowori, de nya sobon ntani nyowa,&gt;&gt; <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />&lt;&lt;Mma gye ku gaskye, Na saki sha riki zanki ni yaya ntasi mu kuma gagaba se nana de Na sha sabuwa a siki solota Mirikisi.&gt;&gt;<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />De su yi wonka yobo Mirikisi, su butu te a ogbo ni Zetu.<verse eid="MRK 14:26" /></para>
  <para style="s">Yesu Pala Nkye Biturusu yaa yi Musu Shina yi</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Yesu gye su nkye, &lt;&lt;Guru aku kwa yi gudu bila ni, &lt;&lt;Sobon e ma rubuta a takada Mirikisi nkye,</para>
  <para style="q1" vid="MRK 14:27">&lt;&lt;&lt;Na dukwa nsu kiwo,</para>
  <para style="q2" vid="MRK 14:27">guru timshiya sua yaapi a woze.<verse eid="MRK 14:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28" />Sede a beyi de Ni dege, Na rigye ku te a geba a siki geri Galili.&gt;&gt;<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />Biturusu pala nkye, &lt;&lt;Ko nde guru asu su yi gudu bila ke, Eni na yi gudu ba.&gt;&gt;<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Yesu keleba nkye, &lt;&lt;Mma gye ku gaskye&gt;&gt; &lt;&lt;A siki ndederi ni yawu mu kapi de zakala yi kala son bi ka yi musu shina Na son wuku.&gt;&gt;<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />Sede Biturusu pala nkye, &lt;&lt;Ko sua kisa ni nja ke, na taba bila ke ba.&gt;&gt; Guru asu su pala yomu.<verse eid="MRK 14:31" /></para>
  <para style="s">Yesu Yi Lepa A Gesemani</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Se Yesu nja yayagizi e yi su te anya de sua sukwa seni yi Gesemani, se Yesu gye yayagizi e yi nkye, &lt;&lt;Ku zunwa anya mu de Ni te yi lepa.&gt;&gt; <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Yesu la Biturusu, Yakubu, Yaaya nja shi, se E para yi beki siki soseyi nja geni beki. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Yesu gye su nkye &lt;&lt;Dishiya na e sika ni beki siki ari kankye na muntu,&gt;&gt; &lt;&lt;Ku zunwa anya mu ku sigeba ni kpanku.&gt;&gt;<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />De Yesu te a geba piri, E bwala kiya e yi a kisi e yi lepa nkye nde e ma dole na de kwanki Genbeki mu e bise Ni. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Yesu nkye, &lt;&lt;Aba, Adaa&gt;&gt; &lt;&lt;Kowoni mbo ma nsu yu la anya ke. De ki la koshiya Genbeki mu bila ni. Ba mbode e ni na so ba, sede mbode E ke ka so.&gt;&gt;<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Se Yesu kuma mbayi te anya yayagizi e yi e san su su mayi kwana e gye Biturusu nkye. &lt;&lt;Sima,&gt;&gt; &lt;&lt;Ku ma yi kwana la? kwa yi yaa kpanku ko ni keripi daa bo? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Ku kpanku ku yi lepa de kede ku puari a siki gwada. Aworo mayi memeri, sede nki e man sori ba.&gt;&gt;<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Se Yesu kuma mbayi, te yi lepa jaja a kiya mbode e yi lepa daa. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Se Yesu kuma zo e san su su ma yi kwana jaja, sobon de ndani su sika ni kwana. se su lesa mbode sua pala gye yi.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />De Yesu kuma ni wuku e gye su nkye, &lt;&lt;Ku tuku yi kwana nja pushe? E deta! kwanki zowo. kone Yaa Nsebeki su leyi beyi a nani nsu lepi. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Ku dege! De mu te! Nsu butu Ni a beyi yaa zo ka!&gt;&gt;<verse eid="MRK 14:42" /></para>
  <para style="s">Su ka Yesu</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />De Yesu ma a siki beta, Yawuda, daa a siki gom sha bi, e zo. E shi nja ntani nyowa su keikei ni yanki nja gwala, butu dege anya toree pirisi, nja male doka Musa, nja toree geri.<verse eid="MRK 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 14:44" />Kuzukam Yawuda nsude butu Yesu a beyi rigye shiriya alama nja su nkye: &lt;&lt;Nsude Ni runguma yi nseminji naka; ku keyi te, ku keyi kyakyawu.&gt;&gt; <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />Su te dandani anya Yesu, Yawuda pala nkye, &lt;&lt;Male!&gt;&gt; Se e runguma Yesu. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Se woroni ka Yesu nsori. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Se daa a siki worede sakisi anya ni butu obalaba e butu kuni bunwa ni tolense pirisi.<verse eid="MRK 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48" />Se Yesu gye su nkye, &lt;&lt;Ni ma bolowa naba&gt;&gt; &lt;&lt;De ku butu ni obalaba nja gwala de ku ka ni? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Ni ma nja ku kowon nana, ku yi yaa ka ni ba, sede e paru yomu na de mbode su rubuta a siki takada Mirikisi e sika. <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />Se guru yayagizi Yesu su yi gudu bila e yi.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Se yaa sambari daa biya Yesu, e sa riga nki ba, se domuna ogbodo kede, de sua bila de su keyi, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />e yi gudu totombolo, bila ogbodo yi,<verse eid="MRK 14:52" /></para>
  <para style="s">Yesu A geba ni Salaki Yawudawa</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Se su keyi Yesu te a geba tolense pirisi, se guru toree pirisi, nja worosu toree geri nja male ni doka Musa zo gom yere. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Biturusu biya Yesu nnyisa, ari a siki papada gizi ni tolense ni pirisi. Anya ni e zunwa nja nsu kpanku, de e zi dimi wuta.<verse eid="MRK 14:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55" />Tolense pirisi nja salaki sua bila yiri sheeda de su ka Yesu nlepi de su kisa yi, sede su samu lepi daa a kiya yi ba. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Ntani nyowa su pala yaruwa a kiya Yesu, sede baki su zo daa ba.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Anya ni worosu su dege a bisi pala sheeda ni yaruwa a kiya Yesu nkye: <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />&lt;&lt;Mu zi nseminji mu yaa pala nkye, &lt;Yaa juru gizi Mirikisi de nani nsebeki gina a beyi nana wuku yaa gina da de su gina ni nani nsebeki ba.&gt;&gt;&gt; <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Nzun yomu baki su zo daa ba.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Se tolense pirisi dege a bisi a geba e minya Yesu nkye, &lt;&lt;Ki ma ni mbode ka pala a kiya sheeda mu bo? Mina ma sheeda mu de ntani sua pala a kiya ke?&gt;&gt; <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />Sede Yesu ma meyi shuru e keleba su ba.</para>
  <para style="p" vid="MRK 14:61">Se tolense ni pirisi minya Yesu jaja nkye, E ke na ki ma Kiristi, Yaa ni Mirikisi nsu anabirika<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />Se Yesu nkye. &lt;&lt;E ni na,&gt;&gt; &lt;&lt;Kwa geni Yaa Nsebeki zunwa a nani dama ni Nsude Pi girima de yaa zo a gidagida ni bisi.&gt;&gt;<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Se tolense ni pirisi saga riga e yi. E minya. &lt;&lt;Woni sheeda na kwa bila jaja?&gt;&gt; <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />&lt;&lt;Ku zi saba de nseminji mu yi Mirikisi. Mina ma tunani ku?&gt;&gt;</para>
  <para style="p" vid="MRK 14:64">Se guru asu su yanka Shiriya nkye e deta muntu. <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />Se worosu su nya Yesu anyanya, se su domuna e yi ndani, su mamari yi, su nkye, &lt;&lt;Gye mu waa dukwa ke! se dogori leyi te su dukwa yi.<verse eid="MRK 14:65" /></para>
  <para style="s">Biturusu yi Musu Shina Yesu Sen wuku</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Biturusu ma a papada gizi, se daa a siki bunwa mase ni tolense zo anya ni. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />De e geni Biturusu yaa zi wuta e te kusa nshi e kapa yi ndani.</para>
  <para style="p" vid="MRK 14:67">Yaa mase ni pala nkye. &lt;&lt;E ke ma du ki ma nja Yesu ni Nazere la.&gt;&gt;<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Sede Biturusu yi musu Nkye, &lt;&lt;Ni shina mbode ki ma yi beta a kiya yi ba,&gt;&gt; Se Biturusu butu gyowe te a baki kolonwa. Se anya ni zakala yi kala<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />De bunwa mase geni Biturusu anya ni, se e gye worede su sakisi anya ni nkye, &lt;&lt;Nse mu ma daa a sika su.&gt;&gt; <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Biturusu yi musu jaja.</para>
  <para style="p" vid="MRK 14:70">A beyi kwanki piri, worede sakisi anya ni kusa ni Biturusu, su nkye gaskye nseminji mu ma a sika su du, e ke ma ki ma nsu Galiliya la.&gt;&gt;<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Se Biturusu para melese nja basi kiya yi nkye, &lt;&lt;Ni shina nseminji de kwa yi beta a kiya yi mu ba.&gt;&gt;<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Dandani zakala yi kala ni bi. Se Biturusu yi tunani kelima de Yesu pala gye yi nkye: kapi de zakala yi kala ni bi ka yi musu shina ni sen wuku.&gt;&gt; Nki yi seni se Biturusu wokye nkuka.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Su Keyi Yesu Zo A geba Bilatu</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Mbaki sasape, toree pirisi nja toree, male ni doka Musa nja guru salaki su yi showura. Se su domuna Yesu, te nshi a geba Bilatu.<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />Bilatu minya nkye. &lt;&lt;Eke na ki ma seleki Yawudawa?&gt;&gt;</para>
  <para style="p" vid="MRK 15:2">Yesu keleba nkye. &lt;&lt;Ee, yomuna yiri de ki pala.<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Toree Pirisi su yi yaruwa ja Yesu a kiya mbo nyowa. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Se Bilatu sakye minya Yesu nkye. &lt;&lt;Eke ka keleba bo? geni yiride su ma sua yaruwa ja ke.&gt;&gt;<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Sede Yesu keleba ba, se Bilatu zi mamanki.<verse eid="MRK 15:5" /></para>
  <para style="s">Su yi Yesu Shiriya ni Kisa</para>
  <para style="r">
    <ref loc="MAT 27:15-26">Mat 27.15-26</ref>; <ref loc="LUK 23:13-25">Lk 23.13-25</ref>; <ref loc="JHN 18:39-19:16">Jn 18.39—19.16</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Mbode Bilatu saba yi a kwanki buki nyenteri e ma shika su yaa jaru daa de ntani su pata yi. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Se nseminji daa de seni e yi ma Baraba yaa jaru nja worosu su ntani de sua yi geba ni solota Roma su ma nsu kisa ntani a kwanki de su ma yi rikishi. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Ntani nyowa zo su ma pata Bilatu de yi su yiri mbode e saba yi su nshi.<verse eid="MRK 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9" />Bilatu minya nkye, &lt;&lt;Kwa bila de ni shika ku seleki Yawudawa?&gt;&gt; <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Bilatu shina nkye sobon kishi na toree pirisi su la Yesu beyi a nani e yi. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />Sede toree pirisi su worosu ntani de Bilatu e shika su Baraba.<verse eid="MRK 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 15:12" />Bilatu minya su nkye. &lt;&lt;Mina kwa bila de ni yi ni seleki Yawudawa?&gt;&gt;<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Ntani yi kuruwa nkye, &lt;&lt;Gidiri yi!&gt;&gt;<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Bilatu minya nkye. &lt;&lt;Mina ma delili? woni Mungu mbo na e yi?&gt;&gt;</para>
  <para style="p" vid="MRK 15:14">Sede su dege Murinya nkye, &lt;&lt;Gidiri yi<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Bilatu bila de e jima ntani, se Bilatu shika Baraba ba su, se e dukwa Yesu, e la Yesu ba su de su gidiri.<verse eid="MRK 15:15" /></para>
  <para style="s">Shoja Su yi Yesu Siya</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Se shoja su la Yesu te a siki kolonwa seleki, su sukwa guru ririgye ni shoja. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Se su sa Yesu arikimba nsu ruwa gawura kankye ni seleki, su yi lendee ni ankwanya su sa yi nshi a kiya. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Se su geshe Yesu nkye, &lt;&lt;Leyi ke e dede, seleki ni Yawudawa!&gt;&gt; <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Se su sigeba ni kwala yi gwala a kiya nja su nya yi anyanya. Su dunkye ni guyam asu a kisi, su geshe yi yiride su ma geshe seleki. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Se su yi Yesu siya, su butu arikimba nsu ruwa gawura su sa yi riga e yi. Se su te nshi a woze de su gidiri.<verse eid="MRK 15:20" /></para>
  <para style="s">Su Gidiri Yesu</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Se nseminji daa dege Sayiri, nsu seni Sima, adaa ni Alezanda nja Rupus, yaa bise a turiki de butu a kesa daa, shoja su sa Sima dole de e la gidiri ni Yesu. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Se su zo Yesu anya de sua sukwa yi goligota de ma anya ni keshi kwankwa kiya. <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Se su ba Yesu riki ni ntasi inebi yada ni mayi mur, sede e sha ba. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Se su gidiri Yesu. su laba keyi yi, su yi kuriya de su geni nsude yaa shi.<verse eid="MRK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25" />A dede keripi wuku na su gidiri Yesu. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Se su rubuta doka lete a kiya e yi nkye: SELEKI NI YAWUDAWA <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Su gidiri bolowa bi nja Yesu, daa a nani dama daa a nani guni <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />nsum na shika mbode su rubuta a siki beta Mirikisi nkye, &lt;&lt;Su kiriga yi a siki nsu lepi.&gt;&gt; <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />Guru worede sua bise su ma basi Yesu, su zizika kiya su pala nkye, &lt;&lt;E ke de ki nkye ka juru laki Mirikisi de ki gina yi a kwana wuku, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />sonka dege gidiri zo a kisi de ki sila nkiya ke!&gt;&gt;<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Yomuna toree pirisi nja male ni doka Musa su yi Yesu siya nkye. &lt;&lt;E sila ni worosu su,&gt;&gt;&lt;&lt;Sede eya sila nkiya yi ba! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Bila de Kiristi, seleki ni Izireyila, e sonka a kisi kuzukam dege gidiri, de mu geni tuku na mua beigaskye!&gt;&gt; Worede su gidiri su nja Yesu yere osu ma su gye yi beki beta.<verse eid="MRK 15:32" /></para>
  <para style="s">Muntu Ni Yesu</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />A kyakya sisika nana dopuwa ripe kesa kpataka ari keripi wuku ni nyema. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />De keripi wuku yi se Yesu yi kuka ni totolo murinya nkye, &lt;&lt;Eloi, Eloi, lama sabatana?&gt;&gt; woto, &lt;&lt;Mirikisi na, Mirikisi na, mina sa ki moshi ni yomu?&gt;&gt;<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Se worede su sakisi anya ni zi yomu, su pala nkye, &lt;&lt;Ku zi, e ma sukwa anebi Iliya.&gt;&gt;<verse eid="MRK 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36" />Se yaa minzi daa yi gudu te, e sika soso ni riki inebi de musha, e sukwa a gwala, se e ba Yesu de e sha nkye. &lt;&lt;Ku bila de mu geni ko anebi Iliya yaa sonka yi dege gidiri.&gt;&gt;<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Ni totolo murinya, Yesu shika aminshi ni karishe.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Se labile ni Laki lepa Mirikisi laba bi dege bisi zo a kisi. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />De tolense shoja Roma de sakisi a geba gidiri Yesu, geni yiride yi kuka nja yiride e muntu, e pala nkye, &lt;&lt;Ni yeda gaskye nseminji mu e ma Yaa ni Mirikisi la!&gt;&gt;<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Worosu mata de su sakisi nyisa sua kone mbode yaa paru. A siki asu Meremu Magadaliya, nja Meremu amaa ni Yakubu dende ni Yusupu, nja Salomi. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Mata woromu su biya Yesu tun dege Galili de su ma kula nshi. Worosu mata nyowa de su sa yi te A Wurishelima su ma anya ni du.<verse eid="MRK 15:41" /></para>
  <para style="s">Su Bishina Yesu</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />De nyema yi, sua yi shiri kapi nana asibi, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Se Yusupu ni Arimatiya, tolense a siki salaki, de ema pekye zo ni Solota Mirikisi, e te minya Bilatu de beyi ganga nki ni Yesu de bishina ba womba. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Bilatu zi mamanki de Yesu rigye muntu, se Bilatu sukwa tolense shoja daa, e minya yi ko Yesu rigye muntu. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />De e zi dege anya ni tolense shoja Roma nkye yomuna, se Bilatu ba Yusupu nki Yesu. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Yusupu see woriki peri, e sonka ni nki Yesu, e lende yi a siki woriki peri e sa yi a siki kumsha de su yanka a siki dunsi, se su kiri dunsi totolo ripe baki kumsha. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Meremu Magadaliya nja Meremu amaa ni Yusupu su geni anya de su la nki Yesu sa.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Yesu Dege A kumsha</para>
  <para style="r">
    <ref loc="MAT 28:1-8">Mat 28.1-8</ref>; <ref loc="LUK 24:1-12">Lk 24.1-12</ref>; <ref loc="JHN 20:1-10">Jn 20.1-10</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />De nana asibi bise, Meremu Magadaliya, nja Meremu amaa ni Yakubu, nja Salomi su see keikei kemeshi de su shapa nki Yesu. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Mbaki sasape ni nana pari ni ladi, kapi de nana e butu, su ma a turiki su ma te ni kumsha <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />se su minya nkiya su, &lt;&lt;Waa kiri dunsi totolo mu bila baki kumsha?&gt;&gt;<verse eid="MRK 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4" />Sede su keyi anya ni, su dege ndani a bisi, su geni, su rigye kiri dunsi te a keteri. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />De su yuru a kisi kumsha, su geni yaa sambari domuna angwe peri zuzunwa a nani dama, se su yanzi.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />E pala nkye. &lt;&lt;Kede ku yi womba,&gt;&gt; &lt;&lt;Kwa bila Yesu ni Nazere la, nsude su gidiri. E dege wo! E ma anya mu kuma ba. ku kone anya de su leyi sa a siki e yi. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Sede ku te, gye yayagizi e yi nja Biturusu, &lt;E rigye ku te a geba a Galili, te anya ni kwa geni yi, yiride e gye ku.&gt;&gt;&gt;<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Se mata woroni butu a kumsha ngudu, sua kakada nja womba. Su gye nseda beta ba, sobon sua zi womba.<verse eid="MRK 16:8" /></para>
  <para style="s">KARSHE WURI NI MANKI</para>
  <para style="s">Yesu pelesa Kiya yi ba Meremu Magadaliya</para>
  <para style="r">
    <ref loc="MAT 28:9">Mat 28.9</ref>,<ref loc="MAT 28:10">10</ref>; <ref loc="JHN 20:11-18">Jn 20.11-18</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />De Yesu rigye dege nsasape ni nana pari ni asibi, Yesu pelesa kiya yi ba Meremu Magadaliya, nsude Yesu butu arizeni bokwe a nki yi <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Se e te gye worede su ma yere nja shi sua yi sasa nja kuka. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />De su zi nkye Yesu man leyi ari meremu Magadaliya geni yi, su ki beigaskye ba.<verse eid="MRK 16:11" /></para>
  <para style="s">Yesu Pelesa Kiya yi Ba Nsubiya yi bi</para>
  <para style="r">
    <ref loc="LUK 24:13-35">Lk 24.13-35</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />A beyi yomu Yesu nana nki e yi a kamani daa mbom ba ntani bi de sua yi tepiya te a dende geri daa. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Su kuma te beyi manki ba yayagizi e yi bi; sede osu ma du su yeda ni beta su ba,<verse eid="MRK 16:13" /></para>
  <para style="s">Yesu Pelesa Kiya yi Ba Yayagizi yi Gom Sha Daa</para>
  <para style="r">
    <ref loc="MAT 28:16-20">Mat 28.16-20</ref>; <ref loc="LUK 24:36-49">Lk 24.36-49</ref>; <ref loc="JHN 20:19-23">Jn 20.19-23</ref>; <ref loc="ACT 1:6-8">Ank 1.6-8</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Dege beyi Yesu nana kiya yi te nja gom sha daa a kwanki de sua si mbosi; se Yesu kobe su de su ki beigaskye nja lesa zi de su ki yeda ni worede gye su nkye su geni yi, a beyi de e dege.<verse eid="MRK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15" />Yesu gye su nkye, &lt;&lt;Ku te a siki durinya guru de ku beyi nabari kyakyawu ba guru ntani. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Du nsude beigaskye, su yi tunkwasa yaa sila, sede nsude ki beigaskye yaa bebeta. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Da mu nama alama de yaa biya worede su beigaskye nja ni: A seni na sua kula arizeni; sua yi beta ni arishiya mbombom; <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />sua la mesi a nani su; nde su sha guba, yaa dama su ba; sua ja nani su a kiya nsu suwo sua worikye.&gt;&gt;<verse eid="MRK 16:18" /></para>
  <para style="s">Su La Yesu Te A bisi</para>
  <para style="r">
    <ref loc="LUK 24:50-53">Lk 24.50-53</ref>; <ref loc="ACT 1:9-11">Ank 1.9-11</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />A beyi de Yesu yi beta nja su, Mirikisi leyi te a bisi te zunwa a nani dama e yi. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Se yayagizi e yi te beyi manki a kowon anga, Obagizi yi ANKI nja su te kelima beta su nja te turiki yi mbo mamanki.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>