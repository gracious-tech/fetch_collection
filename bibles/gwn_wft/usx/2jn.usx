<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">2YAH - Gwandara</book>
  <para style="h">2 Yaaya</para>
  <para style="toc1">Takada Yaaya ni bi</para>
  <para style="toc2">2 Yaaya</para>
  <para style="toc3">2 Yah</para>
  <para style="mt2">Takada bi ni</para>
  <para style="mt1">Yaaya</para>
  <para style="imt">Waa ma e ke</para>
  <para style="ip">Takada Yaaya ni bi Yaaya rubuta e yi te nja &lt;&lt;Iwa gizi nja yaya yi,&gt;&gt; de yi ologba su de su so nkyasu nja de e gila su a kiya nsu male yaruwa nja kokoyi asu.</para>
  <para style="iot">Mbode ma siki yi</para>
  <para style="io1">Waa ma e ke 1-3</para>
  <para style="io1">Kyawu so 4-6</para>
  <para style="io1">Gila a kiya male yaruwa 7-11</para>
  <para style="io1">Beta karishe 12-13</para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />Takada mu Butu dege anya tolense,</para>
  <para style="p" vid="2JN 1:1">Te nja iwa gizi de Mirikisi zabi nja yaya yi, worede mma so su ni gaskye. Ba Eni dandaa na ba, sede ari guru worede su shina gaskye du, <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />sobon gaskye ni Mirikisi, de ma a siki amu nja yaa ma nja mu ari gbogbo:<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />Aniyeri, toseyi nja selema ni Mirikisi Adaa dege anya Yesu Kiristi, Yaa ni Adaa, yaa ma nja mu a siki gaskye nja so.<verse eid="2JN 1:3" /></para>
  <para style="s">Gaskye Nja So</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />Ni yi peri siki soseyi de ni san worosu su a siki yaya aku sua yi tepiya a siki gaskye, yiride Adaa ba mu doka. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />Kuzukam, nsubiya Yesu, ba ni ma rubuta ku takada mu nkye e ma sabuwa doka na ba, sede mbode mu zi butu a pari. Ni gye ku nkye ku so nkiya ku. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />Nsum na e ma so: mu biya doka Mirikisi. Yiri de ku zi butu a pari, doka yi nama yi tepiya a siki so.<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />Nsu shirigye ntani nyowa worede su ki yeda nkye Yesu Kiristi zo a siki nki, su butu zo a siki durinya. Yiri asu su ma nsu shishirigye ntani na nja oboki geba ni Kiristi. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />Ku kone nkyawu kede ku lesa mbode ku yi ANKI a kiya e yi, sede de ku keleba nani wuta aku kyakya. <verse eid="2JN 1:8" /><verse number="9" style="v" sid="2JN 1:9" />Du nsude sakisi a siki kokoyi ni Kiristi ba e ma ni Mirikisi ba; nsu de e sigeba a siki kokoyi Kiristi e mani Adaa nja Yaa. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />Nde nseda zo anya ke nja kokoyi mu ba, kede ki leyi bise a siki gizi ke ko ki yi nnaba. <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />Du nsude yi nnaba e ma lobo a siki mungu mbode yaa yi.<verse eid="2JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />Ni mani mbo nyowa de Na gye ku nshi, sede Na so de ni rubuta ku nshi a takada ni mbo rubutu ba, Ni ma sa dishiya de ni zo anya ku de ni yi beta nja ku pisika nja pisika, de perisiki amu e sika.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />Yaya ni yayiwa ke ni mase nsubiya Yesu de Mirikisi zabi sua geshe ke.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>