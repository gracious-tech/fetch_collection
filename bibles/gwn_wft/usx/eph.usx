<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Gwandara</book>
  <para style="h">APISAWA</para>
  <para style="toc1">Apisawa</para>
  <para style="toc2">Apisawa</para>
  <para style="toc3">Api</para>
  <para style="mt1">Apisawa</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Dege anya Bulusu, yamanki Yesu Kiristi te anya nupi Mirikisi,</para>
  <para style="p" vid="EPH 1:1">Te anya ntani Mirikisi de su ma zunwa Apisa, nsu aminshi de ma a siki Yesu Kiristi:<verse eid="EPH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2" />Aniyeri nja selema dege anya Mirikisi Adaa mu nja Obagizi Yesu Kiristi ema nja ku.<verse eid="EPH 1:2" /></para>
  <para style="s">Anabirika ni Aworo A siki Kiristi</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />Bilade mu yobo Mirikisi nja Adaa ni Obagizi mu Yesu Kiristi! sobon zumunshi mu nja Yesu e samu anabirika a siki solota bisi ni ko yiri anabirika a siki Kiristi. <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />Mirikisi zabi mu de muma na yi te anya zumunshi nja Kiristi kapi de su yi durinya, sobon de muman nsuseki nja de muma mere lepi a geba Mirikisi. sobon so de e mayi mu <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />Mirikisi e rigye zabi mu de Muma yaya goyi yi a siki Yesu Kiristi, nsum nama nupi nja zi dadi yi. <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />Mirikisi yi yomu la de mu yobo dereja girima yi sobon aniyeri de e ba mu kyawuta teke ta anya Yaa yi de yaa so soseyi. <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />Sobon a siki Kiristi la mu samu yenshi te anya zini yi, na mu samu yape lepi mu, te anya yowa ni aniyeri Mirikisi, <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />de e ba mu teke! nja guru simi nja shina beta yi. <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />Mirikisi sa mu shina mbode e shiriya a boyi ni nupi yi de ema nshi, e shiriya de e sika yi te anya Kiristi, <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />Nupi Mirikisi nama, nde kwanki yi, yaa tala guru mbo te anya yiko Kiristi, kowoni mbode ma siki bisi nja a kisi, de Kiristi ema kamkiya.<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />Guru mbo ema yiride Mirikisi shiriya nja de nupi; Mirikisi zabi mu de muma ntani yi te anya zumunshi nja Kiristi sobon nupi yi, ema yomu na sobon mbode e shiriya dege pari naka. <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />Sobon Mirikisi zabi omu Yawudawa na, de mu para sadishiya anya Kiristi, mu yobo dereja girima Mirikisi. <verse eid="EPH 1:12" /><verse number="13" style="v" sid="EPH 1:13" />Oku de kuma Yawudawa ba te anya Kiristi ku zi kelima ni manki gaskye, nabari kyakyawu ni sila. Akwanki de ku beigaskye nja Kiristi, Mirikisi ba ku Aworo Nsuseki yiride e yi ku anikowori nkye yaa yi, ema kankye alama sheeda nkye kuma na yi na. <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />Aworo Nsuseki nama mu tabeshi de Mirikisi yaa ba mu gado de e yi mu anikowori, de yaama namu kwanki de Mirikisi yaa sila worede su ma na yi. Nsum ma ni yobo dereja yi.<verse eid="EPH 1:14" /></para>
  <para style="s">Bulusu Yi Ntani Apisawa Lepa</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Sobon delili mu la, tunde Ni zi beta a kiya beigaskye ku a siki Obagizi Yesu nja so aku de kuma yi guru ntani Mirikisi. <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />Ni bila gbede Mirikisi sobon oku ba, du kwanki de mma yi lepa. <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />Ni ologba Mirikisi ni Obagizi amu Yesu Kiristi, Adaa nsu girima, de e ba ku Aworo, de yaa ba ku simi nja bure ndani, sobon de ku shina Mirikisi. <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />Ni yi lepa de ndani dishiya aku e mani asikye de ku shina ko mina ma sadishiya de e sukwa ku a kiya yi, nja yowa ni dereja girima gado mu sobon nsubiya Mirikisi. <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />Mma yi lepa de ku shina woni yiri totolo sori na de Mirikisi man shi, sori yi e pi geba shina de yaa yi ANKI a siki amu, <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />ni sori mu na Mirikisi dege kiristi dege muntu e beyi anya zunwa nsu dereja a nani dama yi a bisi. <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />Anya ni Kiristi yaa yi solota a kiya guru sori bisi nja yiko, nsu solota, e man seni de pi kowoni yiri seni de sua beyi, ba a siki durinya mu kin ba ari kwanki nsu zo. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />Mirikisi sa guru mbo a nani yi nja zabi Yesu de ema tolense a kiya ni kowoni mbo sobon nsubiya yi, <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />nsubiya Yesu na su ma nki ni kiristi, a siki nsubiya Yesu e shiya ema kamkiya asu de sika kowoni mbo a turiki guru.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">Dege Muntu zo a Leyi</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />A kwanki de bise kuma mumuntu ntani la a siki lepi aku, <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />de ku ma a siki yi a kwanki de kwa biya turiki ni durinya nja mumungu aworo nsu solota ni durinya mu, mumungu aworo de yaa yi ANKI kuzukam a siki ni worede su ki biya doka ni Mirikisi. <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />Guru amu muma yomu la a kwanki de bise a beyi, muma biya mbode nki amu yaa bila nja biya mbode tunani dishiya amu samu de mu yi. Nta yiride worede mani durinya, dole anwashi Mirikisi yaa sonka a kiya amu. <verse eid="EPH 2:3" /><verse number="4" style="v" sid="EPH 2:4" />Sede sobon yowa so de Mirikisi manshi anya mu, nja yowa aniyeri yi de yi mu nshi, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />e samu mu mani leyi nja Kiristi kode muma kankye mumuntu ntani a siki lepi sede te anya aniyeri Yesu la e sila mu. <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />Se Mirikisi dege mu a bisi nja Kiristi se e ba mu anya zunwa gabada a siki solota bisi nja Yesu Kiristi, <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />Mirikisi yi yomuna de kwanki nsu zo yaa nana yowa aniyeri yi de e manshi a kiya mu, e nana mu aniyeri yi a siki Yesu Kiristi. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />Sobon ta anya aniyeri la mu samu sila, te anya beigaskye, da mu ma yi aku naba, sede kyawuta ni Mirikisi, <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />ba sobon ni ANKI kyakyawu de mu yi naba, de kede nseda dege dolo. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Omu muma keikei ANKI ni Mirikisi la, de Mirikisi yi mu a siki Yesu Kiristi de mu yi ANKI de ma kyakyawu, de Mirikisi shiriya mu de mu yi, dege pari.<verse eid="EPH 2:10" /></para>
  <para style="s">Muma Daa A siki Yesu</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Nkayomu, ku shina nkye oku de su yapu ku ma Yawudawa ba yiride kuma a beyi de su sukwa ku &lt;&lt;Kuma nsu yanka naba&gt;&gt; se worede sukwa kiya su &lt;&lt;nkye nsu yanka&gt;&gt; de su yi su te anya nani nsebeki. <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />Ku turunwa nkye a kwanki a beyi su laba ku bila Kiristi, kuma mbodaa ba a siki ntani Izireyila kuma bakwe la a siki seda ni anikowori, ba sadishiya nja Mirikisi a siki durinya. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />Sede kuzukam ku ma a siki Kiristi Yesu, oku de kuma nyisa Mirikisi ka yi ku zo mala nshi te anya zini Kiristi.<verse eid="EPH 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14" />Sobon Yesu e shiya ma selema amu, e shi de sa worede su ma Yawudawa ba nja worede su ma Yawudawa su ma daa. E juru golonwa de laba su, woto geba de su ma yi nja nkyasu. <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />De Yesu muntu a kiya gidiri e watala sori ni doka Musa nja sari yi, yomu na, Yesu kuman Yawudawa nja worede ma Yawudawa ba su ma daa, nja de su ma sabuwa ntani, yomuna su samu zunwa selema nja nkiasu. <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />Yesu yi yomuna de e shiriya ntani bi mu nja Mirikisi de su ma nki daa; te anya muntu Yesu a gidiri na e nana geba de su ma yi nja nkiasu. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />Yesu zo bayi manki nabari kyakyawu ni selema ba worede su ma Yawudawa ba, osu de su yi nyisa nja Mirikisi, nja Yawudawa, osu de su yi kusa Mirikisi. <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />Te anya Yesu la guru amu Yawudawa nja worede su ma Yawudawa ba mua yi yaa zo a geba Adaa te turiki daa a siki Aworo Mirikisi. <verse eid="EPH 2:18" /><verse number="19" style="v" sid="EPH 2:19" />Sobon yomu, oku de kuma Yawudawa ba kuma bakwe na gagaba; kuma yaya kesa na gabada nja ntani Mirikisi ku kwa ma juriya gizi Mirikisi, <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />Oku ma, Mirikisi gina ku a kiya kutiri de yayamanki nja nsu anebi su gini, Kiristi Yesu nama dunsi nsu anpani de ka gini nkiya yi <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />Te anya Yesu na Mirikisi yada guru laki gabada, e shina ma sa laki ni de yi girima ari ema laki lepa nsuseki de Mirikisi la sa keteri ba Obagizi. <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />A siki zumunshi nja Yesu na Mirikisi gina ku nja ririgye ntani gabada de ku ma anya de Mirikisi yaa zunwa te anya Aworo yi.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">Bulusu Beyi Manki Mirikisi Ba Worede Su ma Yawudawa Ba</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Sobon yomuna E ni, Bulusu, ni ma yaa jaru ni Yesu Kiristi sobon oku worede kuma Yawudawa ba.<verse eid="EPH 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 3:2" />Ni shina ku zi nabari yiri de Mirikisi a siki ni aniyeri yi e ba ni anki sobon oku, <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />e shiya ma, mbode ma a boyi su sa ku shina, Mirikisi gye ni asiri dishiyeyi yiride ni rigye rubuta anabari yi piri ba ku. <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />Nde ku karanta daa mu, tuku, kwa gane ni mbode ni shina a kiya gaskye manki Kiristi. <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />Mirikisi gye ntani kwanki daa manki mu ba yiri de e pelesa ba yayamanki yi nsuseki nja nsu anebi nsuseki te anya ni Aworo. <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />Manki mu e shiya ma ta anya nabari kyakyawu ni Yesu Kiristi worede su ma Yawudawa ba su ma yaya de si gado gabada nja mu Yawudawa, de muma nki daa, osu ma su mani lobo a siki ni anikowori de Mirikisi yi mu nshi ta anya ni Yesu Kiristi.<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />Su la ni de ni ma bunwa ni nabari kyakyawu mu te anya ni ANKI ni aniyeri de Mirikisi ba ni anya ni ANKI ni sori yi. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />Kode nkye E ni Bulusu na ni ma dende a siki ni ntani Mirikisi, e ni la su ba ni aniyeri mu: de ni ba worede su ma Yawudawa ba manki kyakyawu a kiya ni Yesu Kiristi, <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />de ni pelesa gye ntani guru yiri de Mirikisi mayi shiri ni betayi, de ema a boyi tun kwanki ni da anya ni Mirikisi, de yi mbo guru. <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />Nupi yi naka kuzukam, ta anya ni nsubiya Yesu, su pala simi ni Mirikisi gye nsu solota nja nsu sori a siki bisi, <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />da mu ma shiri Mirikisi na a kiya ni mbode de e man shi tun dege pari su sika yi a siki ni Yesu Kiristi Obagizi amu, <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />A siki yi na mu mani sori dishiya de mua te a geba Mirikisi ba womba ta anya beigaskye de mu manshi a siki Yesu Kiristi. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Sobon yomu, ni ma yi ologba ku, kede ku butu dishiya sobon Genbeki de ni ma geni sobon ku, Genbeki mu ema aku riba.<verse eid="EPH 3:13" /></para>
  <para style="s">Lepa Bulusu Sobon Ntani Apisawa</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Sobon ni yomu Ni dure a geba Adaa amu ni bisi, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />daa de dege anya yi na guru zuriya ni bisi nja ni durinya su samu seni asu. <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />Ni ma yi lepa de Mirikisi dege siki yowa ni girima yi e ba ku sori guyamu nja sori dishiya te anya ni Aworo yi, <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />de Kiristi e mani anya zunwa a siki dishiya aku te anya beigaskye aku. Ni yi lepa de, ku sakisi nsori soseyi a siki ni so aku, <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />sobon de oku nja guru nsubiya Yesu ku mani sori shina, de ku shina yiri so ni Yesu teke de ema nshi ni bure yi nja nyisa yi nja girima yi nja yiri ondum yi. <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />De ku kwa shina so ni Kiristi de pi sori ni shina nsebeki, de ku sika ni guru shina ni Mirikisi.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />Kuzukam yobo ma nja Mirikisi amu de te anya ni sori yi ema yi mbo teke pi guru mbode mua ologba yi, ko mbode mua yi tunani yi a dishiya mu, <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />yobo ma nja Mirikisi a siki ntani nsubiya yi sa siki Yesu Kiristi ari dege kwanki guru, ari gbogbo nja gbogbo! Ema yomu.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">Mu Ma Daa A siki Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Eni Bulusu ni ma yaa jaru sobon manki Obagizi Yesu, Mma ologba ku de ku yi zunwa de yi kyawu ni sukwa de su yi ku. <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />Kowoni kwanki kuma nsu la kiya ku kuma mbodaa ba nja nsu soki kiya; nja kadishiya, ku ma nsu yeda ni nkiaku a siki so. <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />Ku sakisi nsori soseyi de ku sa zunwa daa aku mu de Aworo Mirikisi ba ku te anya selema de domuna ku gabada. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />Omu nsubiya Yesu mu ma nki daa muma Aworo daa, yomu na ku mani sadishiya daa de su sukwa ku sobon nshi, <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />Obagizi daa, beigaskye daa, tunkwasa daa; <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />Mirikisi daa Adaa ni guru ntani, de ema a bisi guru nja anya ni guru ni kuma guru mbo.<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />Sede Mirikisi ba kowoni nse kyawuta yi kyakya yowa aniyeri Kiristi. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />Daa mu nama mbode sa Beta Mirikisi nkye:</para>
  <para style="q1" vid="EPH 4:8">&lt;&lt;A kwanki de Yesu dege ta a bisi,</para>
  <para style="q2" vid="EPH 4:8">e la worede su sa su a jaru te gabada nja shi</para>
  <para style="q2" vid="EPH 4:8">e ba ntani yi ANKI mbombom.<verse eid="EPH 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />Mina ma &lt;&lt;nyunwa a bisi de e nyunwa&gt;&gt; ema nana nkye e para sonka zo a kisi la. <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Nsude sonka ni e shiya ma nsude nyunwa te a bisi ni guru bisi, de e sika bisi ni kisi guru. <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />Yesu zabi worosu su ma yayamanki, worosu su ma anebi, worosu su ma nsu pala nabari kyakyawu ba ntani, worosu su ma pasito, nja Male nsu kokoyi ntani beta Mirikisi, <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />Kiristi yi yomu na de e gina ntani Mirikisi de su yi anki bowuta <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />de guru amu mu ma daa a siki beigaskye nja shina ni Yaa Mirikisi kuma mu ma dedeta ntani a siki Yesu, de mu yi girima keyi yiride Kiristi bila de mu keyi.<verse eid="EPH 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 4:14" />Nkayomu kede mu ma kankye yaya dende ba, ko mu ma kankye worede su ma jujuyi ankeli asu ni sabuwa kokoyi kankye worede su shina mbode su ma yi ba, de ntani nsu wayo su ma shirigye su ni zaki baki asu. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />Sobon yomu, mu pala gaskye a siki so, de mu yi girima a siki guru mbode mua yi kankye Yesu de e shiya ma kamkiya nsubiya Yesu, de ma, Kiristi. <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />Sobon e shiya ma kamkiya de ka yi guru nki, de su gomu ka nkiasu anya ni ANKI kowoni jijiya, de su yi girima nja de su yi sori a siki ni so, yiride kowoni ganga nki yaa yi ANKI yi,<verse eid="EPH 4:16" /></para>
  <para style="s">Sabuwa La yi A siki Yesu</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Sobon yomu mma gye ku, gila na mma yi ku a siki seni Obagizi, kede ku yi zunwa kankye worede shina Mirikisi ba, nsu tunani banza. <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />Dishiya asu shika ni mungu mbo su laba su ni leyi de Mirikisi beyi sobon lesa shina de su manshi te anya lesa zi asu. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />Su mani rishi kumnya, su la nkya su sa ma nsu kwana nja mata ntani sua yi memeri ni yi kowoni yiri mbo rebi.<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />Oku kwa, yomuna ku kokoyi a kiya Yesu ba. <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />Ni shina ku zi nabari yi sobon kuma ntani yi na, su kokoyi ku gaskye de ma a siki Yesu. <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />Mbode su kokoyi ku, a kiya ni zunwa aku a kwanki de bise, ku butu mumungu ali aku, e shiya ma ali de ma bebeta sobon ni so mbo worede su ma shirigye ku; <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />de kuma sabuwa a siki tunani aku nja ali aku; <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />de ku la sabuwa ali de ma kankye Mirikisi de su yi a siki ni kamani yi a siki gaskye ni gangasi nja zunwa seki.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />Nkayomu! konwawa e bila yaruwa, konse e pala gye dengeri yi nsubiya Yesu gaskye, sobon mu ma ganga nki daa na. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />&lt;&lt;A siki ni anwashi aku kede ku yi lepi&gt;&gt; Kede anwashi aku e keyi ari nana e puari kuma yi anwashi, <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />kede ku ba obiri turiki. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />Nsude mayi bolowa, kede e yi bolowa gagaba, sede e yi ANKI tukuru, e yi ANKI kyakyawu ni nani yi, de e mani mbode yaa sua worede su manshi ba nto.<verse eid="EPH 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EPH 4:29" />Kede mumungu beta e butu a baki aku, sede ema beta de mani moriya de yaa sua ntani nto a kiya ni mbode sua bila, yomuna beta aku yaa sua worede su zi nto. <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />Kede ku bebeta Aworo Nsuseki ni Mirikisi la yi, ema alama sheeda na a kiya ku a nana sila. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />Ku bila guru mungu dishiya, nja zapi la yi, ni anwashi, ni rikishi, yi beta mumungu a kiya yayiwa ake, nja ka yi nse a dishiya. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />Ku yi ali kyakyawu nja ku zi toseyi nkiaku, ku yape nkiaku, yiride a siki ni Yesu Mirikisi yape ku.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="nb">
    <verse number="1" style="v" sid="EPH 5:1" />Tunde ku ma yaya de Mirikisi yaa so, se ku kokoyi dege anya yi a siki zunwa ku. <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />Ku yi zunwa ni so nja nkiaku yiride kiristi so mu, e beyi kiya yi ba mu kankye sedeka kyakyawu nsu kemeshi nja sedeka anya Mirikisi.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />Sede a siki aku kede su samu nseda de ema nsu kwana nja mase ko minzi nseda ba, ko nungwe berikete ba ko nsu opu ni mbo, sobon yiri mbo woromu yi kyawu ni yaya Mirikisi ba. <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />Kede ku yi anpani ni bebeki beta, ko kelima beta ni Odundu ko wasa banza, sobon e yi kyawu ni ntani Mirikisi ba, sede mu gbede Mirikisi. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />Ku shina nkye, ba nsu yi lepi nungwe, ko nsu mungu dishiya ko opu nse, de e shi nja nsu bowuta boka su ma daa na, su mani gado a siki solota kiristi nja Mirikisi ba. <verse eid="EPH 5:5" /><verse number="6" style="v" sid="EPH 5:6" />Kede nseda e shirigye ku ni kelima wopi, sobon yiri lepi woromu na anwashi Mirikisi ma sonka a kiya worede su ki biya beta yi. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Nkayomu kede ku gama kiya nja su. <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />Sobon oku ma a kwanki de bise kuma ntani dopuwa la, sede kuzukam kuma asikye na a siki Obagizi. Ku yi zunwa ni yaya asikye <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />sobon asikye yaa yapu ali kyakyawu, nja zunwa ni gangasi anya ni Mirikisi, nja pala gaskye <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />nja yi mbode yaa jima Obagizi. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Kede ku mani mbo daa ni yi nja ali dopuwa de mani anpani ba, sede ku pelesa su a pili. <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />Ema mbo kumnya la de nsubiya Yesu su pala mbode ntani mumungu su ma yi a boyi. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />Sede kowoni mbode ma a siki asikye yaa pelesa a pili, <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />sobon asikye la yaa pelesa kowoni mbo. Daa mu nama mbode sa beta Mirikisi pala nkye:</para>
  <para style="q1" vid="EPH 5:14">&lt;&lt;Pelenka, eke de ka yi kwana,</para>
  <para style="q2" vid="EPH 5:14">dege a kwana, eke de ki muntu,</para>
  <para style="q1" vid="EPH 5:14">kiristi yaa ba ke asikye.&gt;&gt;<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Sobon yomu ku kula, ni yiride ku mayi zunwa, kede kuma kankye worede ma nsimi ba, sede nsu simi <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />ku yi anpani ni kowoni dama de ku yi mbo kyakyawu, sobon kwanki de mu ma a siki yi mu e sika ni mungu mbo. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />Nkayomu kede ku ma Odundu ba, sede ku shina mbode Obagizi yaa bila de ku yi. <verse eid="EPH 5:17" /><verse number="18" style="v" sid="EPH 5:18" />Kede ku sha giya bugu, de yaa sa ku bebeta. momoko yomu, se mu bila Aworo Mirikisi de biya mu a turiki kyakyawu. <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />Ku yi beta nja nkyaku ni kelima wonka zabura, ni wonka yobo nja wonka aworo. Yi wonka yobo dege dishiya ku te nja Obagizi. <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />Kowoni nana ku gbede Mirikisi Adaa mu sobon guru mbo, a siki seni Obagizi Yesu Kiristi.<verse eid="EPH 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />Ku ba nkyaku girima a siki ni womba Kiristi.<verse eid="EPH 5:21" /></para>
  <para style="s">Zunwa Mase Nja Minzi A siki Amere</para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />Oku mata amere, ku ba menza aku girima yiri de kwa ba Obagizi. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Sobon yaa minzi mani yiko a kiya mata yi yiride Kiristi mani yiko a kiya nsubiya yi woto, nki yi, de e shi ma nsu sila su. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Kuzukam yiride nsubiya Yesu beyi kiya su te nja Kiristi, yomuna mata ku beyi kiya ku kpataka ba menza ku a kowoni turiki.<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />Oku menza amere, ku so mata aku, yiride Kiristi so nsubiya yi de e beyi kiya yi de e muntu sobon e shi. <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />Yesu yi yomuna de sayi e man nsuseki, de shire yi te anya wonkye yi ni riki ni kelima beta Mirikisi, <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />Yesu yi yomuna de e la mu nsubiya yi ba kiya yi de muma nsu dereja soseyi ba dola ko pita ko worosu su suwo, sede nsuseki nja mere lepi. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />A turiki yomuna, menza amere ema dole la de ku so mata aku yiride kwa so nkyaku. Du nsude so mata yi e so kiya yi aka. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />A beyi yomu, ba nseda de taba ki nki yi ba, sede yaa beyi mbosi yaa kula nshi, yiride Kiristi yi nsubiya yi <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />Sobon omu mu ma ganga nki Kiristi na. <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />Kankye yiride ema rubuta a siki beta Mirikisi nkye, &lt;&lt;Sobon yomu nseminji yaa bila adaa yi nja amaa yi de e mala mata yi, osu bi su ma nki daa.&gt;&gt; <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />Mbomu eman wuya shina. Sede eni mmayi beta a kiya Kiristi nja nsubiya yi na. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />Nzun yomu, kowoni nseda aku ema dole na de e so mata yi yiride yaa so kiya yi, nja ema dole na mase e ba minzi yi girima.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s1">Yaya nja nsu Adaa asu</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />Oku yaya, ku ba adaa ku nja amaa ku girima a siki Obagizi, sobon nsum e shiya ma kyakya. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />Daa mu e shina ma doka Musa de nkye &lt;&lt;Ku ba adaa aku nja amaa aku girima&gt;&gt; nsu mu e shiya ma doka Mirikisi ni pari de ma ni anikowori. <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />&lt;&lt;De ku samu zunwa lapiya nja de ku dede a durinya<verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />Oku nsu adaa, kede ku yi mbode yaa sa yaya ku su yi anwashi ba; sede ku kokoyi su mbo kyakyawu nja poro su a turiki ni Obagizi.<verse eid="EPH 6:4" /></para>
  <para style="s">Bunwa nja nsugizi</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />Oku bunwa, ku ba nsugizi aku ni durinya girima ku nana su ali girima a siki womba Mirikisi, ni dishiya daa, yiride kwa yi kiristi nshi. <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />Ku ba su girima ba ni geni ndani ba, nta yiri worede su ma bila yobo anya ntani, sede ku ma kankye bunwa ni Kiristi, ku yi mbode Mirikisi yaa so dege dishiya aku. <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />Ku yi bowuta ni guru dishiya daa, yiride kwa bowuta Obagizi, ba nsebeki ba, <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />Ku shina nkye Obagizi yaa ba kowoni nse nani wuta ni mbo kyakyawu de e yi, ko ema bunwa ko ema bunwa ba.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />Oku nsugizi, oku ma ku yi yomu nja bunwa aku, kede ku ba su womba ba, ku shina oku nja su guru kuma ni Obagizi bisi la, nsude yaa nana bombom ba.<verse eid="EPH 6:9" /></para>
  <para style="s">Keyi Yanki Ni Mirikisi</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />A karishe, ku yi sori a siki Obagizi nja a siki sori yiko yi. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />Ku sa guru keyi yanki ni Mirikisi de ku sakisi yi geba ni kowoni turiki de obiri yaa zo ku nshi. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Sobon topula amu ma a kiya nsebeki nsu nki nja zini na ba, sede a kiya ni mungu aworo ni bisi, nja nsu solota, a kiya yiko ni durinya, nja a kiya nsu sori dopuwa ni durinya nja a kiya aworo mumungu ni sana mu. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />Nkayomu ku sa guru keyi yanki ni Mirikisi, sobon nde nana mumungu zo, de ku yi yaa sakisi ni sori, a beyi de ku yi kowoni mbo, ku yi yaa sakisi nsori. <verse eid="EPH 6:13" /><verse number="14" style="v" sid="EPH 6:14" />Sobon yomu ku sakisi ni sori, gaskye ema kankye shompa de gyowe goto aku, nja golonka ema kankye gangasi ni keyi yanki, <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />de ku yi shiri ni keyi nabari kyakyawu ni selema, kankye takalami a seni aku. <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />A beyi guru mbomu, se beigaskye ema kankye manta de kwa yi yaa tele kiya aku dege kowoni papasa de obiri yaa ribi ku nshi. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />Se ku la tangiya ni keripi de mani sila aku nja ku la obalaba ni Aworo nsuseki de e shiya ma kelima ni Mirikisi. <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />Se ku yi lepa kowoni nana a siki sori Aworo Mirikisi nja ku yi lepa yiri, yiri, ni kpanku. Ku mani nsum a dishiya aku, se kuma ashiri kowoni kwanki de ku yi nsubiya Yesu guru lepa. <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />Ku yi ni lepa du, de guru kwanki de Ni bure baki Ni beyi manki Mirikisi ba womba, de ni pelesa asiri ni nabari kyakyawu ba ntani. <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />Sobon ni nabari kyakyawu mu na Ni ma wakili kode Ni ma a jaru. Ku yi ni lepa de Ni pala nabari mu ba womba, yiride e kamata de Ni yi.<verse eid="EPH 6:20" /></para>
  <para style="s">Gesuwa ni Karishe</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />Tikikus, yayiwa amu nja bunwa nsu aminshi de ma a siki Obagizi, yaa gye ku mbo guru de ku shina yiride Ni ma nja mbode Ni ma yi. <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />Ni ma saka yi ta anya ku sobon ni delili mu, de ku shina yiride mu ma, de e ja ku sori guyam.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />Yayuwa selema butu anya Mirikisi Adaa nja Obagizi Yesu Kiristi ema nja ku, ni so nja beigaskye.<verse eid="EPH 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EPH 6:24" />Aniyeri ema nja guru worede su ma so Obagizi amu Yesu Kiristi nja so de yaa yaba. Ema yomu.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>