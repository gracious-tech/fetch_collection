<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">-</book>
  <para style="h">Matiyu</para>
  <para style="toc1">Manki te Baki Matiyu</para>
  <para style="toc2">Matiyu</para>
  <para style="toc3">Mat</para>
  <para style="mt2">Manki te anya</para>
  <para style="mt1">Matiyu</para>
  <para style="imt">Kiya Beta</para>
  <para style="ip">
    <char style="bk">Manki te anya Matiyu </char> pala nabari kyakyawu nkye Yesu e shina ma anikowori sila, nseda de te anya yi de Mirikisi sika anikowori de yi ntani yi a takada yi ni wuri. Anikowori mu ema ni Yodawa na kin ba, sede ni guru ntani durinya.</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Tariyi Nsu Adaatolo Yesu</para>
  <para style="r">
    <ref loc="LUK 3:23-38">Lk 3.23-38</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Nsum eshiya ma takada tariyi ni nsu adaatolo Yesu Kiristi, juriya ni Dowuda, de ma dege juriya ni Abireyi.<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />Abireyi ema adaa ni Ishaku, Ishaku ema adaa ni Yakubu, Yakubu ema adaa ni Yawuda nja yayuwa yi; <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Yawuda e shiya ema adaa ni Periza nja Zera, de amaa su ema Tama, Periza ema adaa Yeziron, Yeziron ema adaa ni Aram, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />Aram ema adaa ni Aminada, Aminada ema adaa ni Nashon, Nashon ema adaa ni Salmo, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Salmo ema adaa ni Boaza de amaa yi ma Rahab, Boaza ema adaa ni Obadiya amaa yi ema Rutu, Obadiya ema adaa ni Yesi, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Yesi ema Adaa ni seleki Dowuda. Dowuda ema adaa ni Sulemanu de amaa yi ema mata ni Wuriya, <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />Sulemanu ema adaa ni Rehebuwa, Rehebuwa ema adaa ni Abiya, Abiya ema Adaa ni Asa, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />Asa ema adaa ni Yehoshepa, Yehoshepa ema adaa ni Yaram, Yaram ema adaa ni Azariya, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Azariya ema adaa ni Yota, Yota ema adaa ni Ahazi, Ahazi ema adaa ni Ezikiye, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Ezikiye ema adaa ni Manase, Manase ema adaa ni Amo, Amo ema adaa ni Yosiya, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Yosiya ema adaa ni Yekoniya nja yayiwa yi kwanki de su ka yi su ta kesa Babila, <verse eid="MAT 1:11" /><verse number="12" style="v" sid="MAT 1:12" />Kwanki de su kwa yi su ta Babila, Yekoniya ema adaa ni Sheyatiye, Sheyatiye ema adaa ni Zerubabe, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Zerubabe ema adaa ni Abiwudu, Abiwudu ema adaa ni Eliyaki, Eliyaki ema adaa ni Azuro, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />Azuro ema adaa ni Saduku, Saduku ema adaa ni Akimu, Akimu ema adaa ni Aliyudu, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Aliyudu ema adaa ni Eliyazara, Eliyazara ema adaa ni Mata naa, Mata naa ema adaa ni Yakubu, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Yakubu ema adaa ni Yusupu, de ema minzi ni Meremu amaa Yesu, de sua sukwa yi nkye Kiristi.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Kode nkye, juriya butu a kiya Abireyi ta Dowuda, ema juriya gom sha wuru, butu a kiya Dowuda ta kwanki de su kwa yi Izireyila ta bowuta a Babila, su ma juriya gom sha wuru, butu a kwanki bowuta a Babila ta kwanki de su yapu kiristi juriya gom sha wuru.<verse eid="MAT 1:17" /></para>
  <para style="s">Yapu Ni Yesu Kiristi</para>
  <para style="r">
    <ref loc="LUK 2:1-7">Lk 2.1-7</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Yomuna su yapu Yesu kiristi. Kwanki de Yusupu mase sari yi Meremu amaa ni Yesu, tunde e abenshi a gizi yi woba, na ema a siki butu anya Aworo Nsuseki. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yusupu minzi sari yi ema nse gangasi, sede yaa bila de beyi kumnya a geba ntani ba, yaa bila de e shika yi a boyi.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />De ema kiya tunani mu, meleku ni Mirikisi gye Yusupu a siki nansi, nkye, &lt;&lt;Yusupu yaa ni Dowuda, kede ki zi womba ni la Meremu de ema mata ke, nkaa siki de e manshi butu anya ni Aworo Mirikisi la. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Yaa yapu Yaa, yaa beyi seni Yesu, sobon e shiya yaa sila ntani yi dege siki lepi.&gt;&gt;<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Guru mbo mu paru de beta Mirikisi de e pala a baki Anebi Ishaya nkye: <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />&lt;&lt;Yaa mase de puari nse minzi ba yaa man siki yaa yapu Yaa, sua sa yi seni nkye Imanuwe.&gt;&gt; Maana yi ema, &lt;Mirikisi ma nja mu.&gt;&gt;<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Anya ni de Yusupu dege a kwana e yi mbode meleku Mirikisi gye yi anansi nkye, Meremu e shiya ma mata yi. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Sede E taba shina yi ba, kami de e yapu yaa ni. E sa yi seni Yesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Bakwe Dege Anse</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Kwanki de su yapu Yesu a kesa batalami ni Yawudiya, de Yiridu, e ma Seleki, nsu worede shina kemu butu ni anse su zo a Wurishelima su nkye <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />&lt;&lt;Seleki Yawudawa de su yapu managa? Mu geni kemu butu ni anse, mu zo de mu bowuta yi.&gt;&gt;<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />De Seleki Yiridu zi yomu se dishiya yi dege, yomuna guru worede su ma Wurishelima dishiya su dege. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Yiridu sukwa guru toree ni pirisi nja male ni doka Musa, e minya su nkye angana su yapu kiristi.<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />Su keleba nkye, &lt;&lt;A kesa batalami ni Yawudiya.&gt;&gt; Yiride Anebi rubuta nkye:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />&lt;&lt; &lt;E ke batalami ni kesa Yawudiya,</para>
  <para style="q2" vid="MAT 2:6">e ke ki ma dende naba a siki gunduma ni Yawuda;</para>
  <para style="q1" vid="MAT 2:6">Dege a siki ke sua yapu Seleki de yaa yi solota kesa mu,</para>
  <para style="q2" vid="MAT 2:6">nsu kpanku ntani na Izireyila&gt;&gt;&gt;.<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Se Yiridu sukwa nsu worede shina kemu a boyi de e zi anya su dede kwanki de kemu butu. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />E saka su a batalami, nkye, &lt;&lt;Ku te de ku minya nkyawu a kiya ni yaa de su yapu, ku kuma de ku ka yi ni manki, de eni ma nte de ni bowuta yi.&gt;&gt;<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />De su zi beta Seleki, su sigeba ntepiya asu, kemu de su geni anse, e ta geba asu e zo sakisi anya de su yapu Yesu. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />De su geni kemu sakisi anya ni, su yi perisiki nyowa. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />De su yuru a gizi ni, su geni Yaa ni nja Amaa e yi Meremu, se su dure a geba e yi su bowuta yi. Su bure Angala, su ba yi kyawuta ni zinari, tularee myrrh. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />De kwanki yi ni kuma ta geri asu, Su kuman beyi biya turiki ni gagaba, sobon Mirikisi gye su anansi nkye, kede su kuma ta ayan Yiridu gagaba.<verse eid="MAT 2:12" /></para>
  <para style="s">Yusupu nja Meremu Sila Ta Masa</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />De nsu shina kemu kuma mbeyi, meleku Obagizi zo ayan Yusupu anansi e gye yi nkye, &lt;&lt;Dege a bisi! De ki la Yaa dende nja Amaa yi, de ku ta kesa Masa. Seni gye ku tuku de ku kuma mbeyi, sobon Yiridu yabila de e kisa Yaa de su yapu mu.&gt;&gt; <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Yusupu dege a bisi, e la Yaa nja Amaa yi, ndederi su ta kesa Masa. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Ema anya ni ari Yiridu muntu. Da mu e sika mbo de Anebi pala butu ayan Obagizi: &lt;&lt;Ni sukwa Yaa na butu a kesa Masa.&gt;&gt;<verse eid="MAT 2:15" /></para>
  <para style="s">Su Kisa Yaya Dende</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />De Yiridu geni nsu worede shina kemu su kuma zo ba, su leyi e ma kankye e shina mbode yaa yi ba anya ni dishiya yi dege. E saka manki nkye su kisa yaya dende de su yapu ashekera bi ko daa de e kasa shekera bi, a kesa batalami nja geri de mala nsu, sobon nsu shina kemu pala nkye su geni kemu shekera bi de bise a beyi. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Mbo de Yiridu yi e sika beta de Anebi Yirimiya pala.<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />&lt;&lt;Su zi murinya a Rama</para>
  <para style="q2" vid="MAT 2:18">Murinya kuka ni beki siki ni zapi,</para>
  <para style="q1" vid="MAT 2:18">Rayila yaa yi kuka sobon yaya yi,</para>
  <para style="q2" vid="MAT 2:18">e ki de e kadishiya,</para>
  <para style="q2" vid="MAT 2:18">sobon yaya yi de su muntu.&gt;&gt;<verse eid="MAT 2:18" /></para>
  <para style="s">Su Kuma Ta Kesa Nazere</para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 2:19" />Kwanki de Yiridu muntu, Meleku Obagizi zo ayan Yusupu anansi a kesa Masa e gye nkye <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />nkye, &lt;&lt;Dege a bisi, de ki la yaa nja Amaa e yi de ki ta kesa Izireyila, nsu worede sua bila de su kisa su muntu.&gt;&gt;<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Anya ni Yusupu dege a bisi, e la yaa nja Amaa e yi kuma ta kesa ni Izireyila. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />De Yusupu zi nkye seleki ma yaa ni Yiridu ni kesa Yawudiya, de seni yi ema Arikilayus yi womba ni te anya ni, dun su gila yi anansi, se kuma ta gunduma ni Galili, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />anya ni Yusupu te zunwa a geri de sua sukwa yi Nazare. Dun e sika beta de Anebi su pala nkye: &lt;&lt;Sua sukwa yi Yesu ni Nazare.&gt;&gt;<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Yaaya Nsu Tunkwasa Gyala Turiki</para>
  <para style="r">
    <ref loc="MRK 1:1-8">Mk 1.1-8</ref>; <ref loc="LUK 3:1-18">Lk 3.1-18</ref>; <ref loc="JHN 1:19-28">Jn 1.19-28</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />A kwanki ni Yaaya nsu tunkwasa zo, yaa beyi manki Mirikisi a denka ni Yawudiya. <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />E pala nkye, &lt;&lt;Ku juyi bila lepi,&gt;&gt; &lt;&lt;Sobon solota bisi e ma nani.&gt;&gt; <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Yaaya e shiya ma nsu de Anebi Ishaya yi beta a kiya e yi nkye,</para>
  <para style="q1" vid="MAT 3:3">&lt;&lt;Murinya nseda yaa sukwa a siki denka,</para>
  <para style="q2" vid="MAT 3:3">&lt;Ku gyala turiki pekye Obagizi,</para>
  <para style="q2" vid="MAT 3:3">Ku sa turiki yi de ma tiriri<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Yaaya e sa keyi pata nakurimi, shompa a goto yi. Mbosi yi ma ngirinya nja riki zunwa. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Ntani butu dege Wurishelima zo anya e yi nja guru kesa Yawudiya ni kowoni totolo riki Yoda, su butu te adenka de su zi manki de Yaaya keyi su. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />De su ma pala lepi asu, Yaaya yi su tunkwasa a siki totolo riki ni Yoda.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />De Yaaya geni ntani nyowa de su shina doka Musa de sua sukwa su nkye Parisiyawa nja nsu pala doka Sadokiyawa su zo de yi su tunkwasa, e minya su nkye &lt;&lt;Oku yaya ogbozi waa gila ku de ku gudu dege anwashi Mirikisi de yaa te zo? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Ku yi mbode nana nkye ku juyi bila mbo mumungu, sobon ntasi kyakyawu yaa yi yaya kyakyawu. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Kede ku dege dolo nkye, &lt;Ku mani Abireyi ma adaa ku.&gt; Na gye ku Mirikisi yaa juyi dunsi mu de su ma yaya Abireyi. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Ko kuzukam gapiya Mirikisi e ma kisi ririnya ntasi, yaa pekye de e geni du ntasi de yaa yapu yaya kyakyawu ba, sua sala yi kutiri a siki wuta.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />&lt;&lt;Yaaya nkye eni ni yi ku tunkwasa ni riki de ku bila lepi. Sede a beyi na nseda de pi ni yaa zo, Ni deta de na kunshe takalami yi ba. Yaa yi ku tunkwasa ni Aworo Mirikisi nja wuta. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />E keyi tengeri a nani yi de dukwa guru saba a pita asheke nyanye butu a siki saba yi, Anya ni yaa tala saba nya arigogo yi, akweyi nyanye si wuta a wuta de yaa muntu ba.&gt;&gt;<verse eid="MAT 3:12" /></para>
  <para style="s">Su yi Yesu Tunkwasa</para>
  <para style="r">
    <ref loc="MRK 1:9-11">Mk 1.9-11</ref>; <ref loc="LUK 3:21">Lk 3.21</ref>,<ref loc="LUK 3:22">22</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Se Yesu zo a Galili ni kesa Yoda de Yaaya e yi tunkwasa. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Sede Yaaya yaa bila de e yi Yesu tunkwasa ba. E pala nkye, &lt;&lt;Na bila de e ke na ki yi ni tunkwasa, mina sa ki zo anyana?&gt;&gt;<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Yesu pala gye yi nkye, &lt;&lt;E ma kyakya la de ki yi ni tunkwasa de e shika guru mbo gangasi.&gt;&gt; Se Yaaya yeda de yi Yesu tunkwasa.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />De Yesu yi tunkwasa, e butu a siki riki. Se bisi bure ba yi, e geni Aworo Mirikisi sonka a kiya yi kankye tatambiri nja asikye. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Se murinya butu A bisi pala nkye, &lt;&lt;Da mu ema Yaa naa, de mma so; Nja shi Naa yi perisiki soseyi.&gt;&gt;<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Obiri Gwada Yesu</para>
  <para style="r">
    <ref loc="MRK 1:12">Mk 1.12</ref>,<ref loc="MRK 1:13">13</ref>; <ref loc="LUK 4:1-13">Lk 4.1-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Anya ni Aworo Mirikisi la Yesu biya nshi ta siki denka de obiri e gwada yi. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />De Yesu si mbosi ba e sha ba ari nana aribeni nja ndederi aribeni, e zi nyunwa. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Anya ni obiri zo de e gwada yi, &lt;&lt;E gye yi nkye nde ki ma Yaa ni Mirikisi, gye dunsi mu de e ma mbosi.&gt;&gt;<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Yesu keleba nkye, &lt;&lt;E ma rubutu a siki takada Mirikisi: &lt;Nsebeki yaa man leyi ba sobon mbosi na kede ba, se nsude yeda ni kelima beta Mirikisi.&gt; &gt;&gt;<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Se obiri la Yesu te nshi a Wurishelima geri nsuseki, E sa yi sakisi a kiya bisi laki Mirikisi, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />&lt;&lt;e gye yi nkye, nde ki ma Yaa Mirikisi,&gt;&gt; &lt;&lt;Kutiri kiya ke de ki zo a kisi. E ma rubutu a siki takada Mirikisi nkye:</para>
  <para style="q1" vid="MAT 4:6">&lt;&lt;&lt;Mirikisi beyi doka ba Meleku sobon ke,</para>
  <para style="q2" vid="MAT 4:6">sua zo de su la ke a nani su,</para>
  <para style="q2" vid="MAT 4:6">de kede seni ke e titimi a dunsi ba.&gt; &gt;&gt;<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yesu keleba yi nkye, &lt;&lt;E ma rubutu a siki takada Mirikisi nkye, &lt;Kede ki gwada Obagizi Mirikisi ke.&gt; &gt;&gt;<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Obiri kwa la Yesu te a kiya bisi dunsi nsu nyisa e nana yi guru solota a siki durinya ni girima su nja dereja su. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />&lt;&lt;Obiri gye yi nkye na ba ke,&gt;&gt; mbo de ki geni mu guru, &lt;&lt;nde ka dure de ki bowuta ni.&gt;&gt;<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Yesu gye yi nkye, &lt;&lt;Dege anya naa, obiri! E ma rubuta a siki takada Mirikisi: &lt;Dure ba Obagizi Mirikisi ake, de ki bowuta e shi dandaa e yi.&gt; &gt;&gt;<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Anya ni obiri bila e yi ni kwanki piri, Meleku Mirikisi zo anya ni de sua ni nto.<verse eid="MAT 4:11" /></para>
  <para style="s">Yesu Para Beyi Manki</para>
  <para style="r">
    <ref loc="MRK 1:14">Mk 1.14</ref>,<ref loc="MRK 1:15">15</ref>; <ref loc="LUK 4:14">Lk 4.14</ref>,<ref loc="LUK 4:15">15</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />De Yesu zi nkye Yaaya e ma jaru, e kuma ta Galili. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />E bila Nazare e te ma a Kapanawu a keteri riki, a Geri ni Zebulun nja Naptali. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />De e sika mbo de anebi Ishaya pala.<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />&lt;&lt;Kesa Zebulun nja Kesa Naptali,</para>
  <para style="q2" vid="MAT 4:15">Turiki de ta totolo riki, anya ni Yoda,</para>
  <para style="q2" vid="MAT 4:15">Galili kesa ni worede su ma Yawudawa ba,<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Nsu worede su zunwa a siki dopuwa</para>
  <para style="q2" vid="MAT 4:16">Su geni totolo asikye;</para>
  <para style="q1" vid="MAT 4:16">Worede su zunwa a siki kesa wurinya ni muntu</para>
  <para style="q2" vid="MAT 4:16">asikye zo anya su&gt;&gt;.<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Dege kwanki ni Yesu para beyi manki e yi, &lt;&lt;Nkye ku juyi bila lepi, sobon solota Mirikisi a bisi e yi kusa.&gt;&gt;<verse eid="MAT 4:17" /></para>
  <para style="s">Yesu Sukwa Ntani Nsu ka Gunda wuru</para>
  <para style="r">
    <ref loc="MRK 1:16-20">Mk 1.16-20</ref>; <ref loc="LUK 5:1-11">Lk 5.1-11</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />De Yesu yaa yi tepiya a baki totolo riki ni Galili, e geni yayuwa ntani bi, Saminu de sua sukwa yi nkye Biturusu, nja Anduru, sua kutiri eya a siki riki, su ma nsu ka gunda la. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yesu pala gye su nkye, &lt;&lt;Zo de ku biya ni,&gt;&gt; &lt;&lt;na sa de ku ma nsu ka ntani zo anya naa.&gt;&gt; <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Dandani su bila eya asu su biya yi.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />E sigeba ntepiya yi, e geni Yakubu nja dende yi Yaaya de su ma yaya ni Zabedi. Su ma siki kwanto nja Adaa asu Zabedi, sua gyala eya asu, Yesu sukwa su. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Dandani su bila kwanto nja Adaa asu su biya Yesu.<verse eid="MAT 4:22" /></para>
  <para style="s">Yesu Kokoyi nja Worikye Nsu Suwo.</para>
  <para style="r">
    <ref loc="LUK 6:17-19">Lk 6.17-19</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yesu te a guru a kesa Galili, e kokoyi su a siki kolonwa, e keyi su manki kyakyawu ni solota bisi, e worikye guru suwo nja shuwuta de ntani man shi. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Su keyi beta e yi te anya guru a kesa Suriya, su kwa yi ntani nyowa nsu suwo yiri yiri, worede sua zi zapi suwo, nsu mumungu aworo, okpinkpi, nki sha ruwa, se Yesu worikye su guru. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Ntani nyowa butu dege kesa Galili, ni geri gom, Wurishelima, Yawudiya, nja gunduma de su ma keteri riki ni Yoda.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Yesu Kokoyi A kiya Totolo Ogbo</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />De Yesu geni ntani tala nyowa, e nyunwa bisi ogbo e zuzunwa. Yayagizi yi zo anya yi, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Yesu sa kutiri kokoyi su nkye:<verse eid="MAT 5:2" /></para>
  <para style="s">Peri siki gaskye</para>
  <para style="r">
    <ref loc="LUK 6:20-23">Lk 6.20-23</ref></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />&lt;&lt;Anabirika ni Mirikisi ma nja nsu worede su shina mushashi asu a siki Aworo Mirikisi,</para>
  <para style="q2" vid="MAT 5:3">solota gizi Mirikisi e ma na su.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Anabirika ni Mirikisi ma nja nsude sua yi beki siki,</para>
  <para style="q2" vid="MAT 5:4">sua samu takuwa Anya Mirikisi.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Anabirika ni Mirikisi ma nja nsu soki kiya,</para>
  <para style="q2" vid="MAT 5:5">sua si gado ni durinya mu.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Anabirika ni Mirikisi ma nja nsu zi nyunwa nja nsu kishi de su yi mbo gangasi,</para>
  <para style="q2" vid="MAT 5:6">Mirikisi yaa koshi nsu.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Anabirika ni Mirikisi ma nja nsu toseyi,</para>
  <para style="q2" vid="MAT 5:7">Mirikisi yaa zi toseyi su.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Anabirika ni Mirikisi ma nja nsude dishiya asu ema sere,</para>
  <para style="q2" vid="MAT 5:8">sua geni Mirikisi.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Anabirika ni Mirikisi ma nja nsu bila zunwa selema,</para>
  <para style="q2" vid="MAT 5:9">sua sukwa asu nkye yaya Mirikisi.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Anabirika ni Mirikisi ma nja nsu de su ki su sobon yi mbo gangasi anya Mirikisi,</para>
  <para style="q2" vid="MAT 5:10">solota gizi bisi ma na su.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />&lt;&lt;Anabirika ni Mirikisi ma nja worede ntani sua basi ku, sua ki ku sua pala guru mbo mumungu a kiya aku sobon e ni. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Yi peri siki nja dala sobon nani wuta aku ma siki bisi, yomuna su yi nja Anebi de su rigye ku zo.<verse eid="MAT 5:12" /></para>
  <para style="s">Giri Nja Asikye</para>
  <para style="r">
    <ref loc="MRK 9:50">Mk 9.50</ref>; <ref loc="LUK 14:34">Lk 14.34</ref>,<ref loc="LUK 14:35">35</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />&lt;&lt;Ku ma kankye giri na a durinya. Sede nde giri bila zanki yi, sede sua nkye kona yaa yi zanki jaja? E mani kyawu mbodaa gagaba, sede sua la yi kutiri de ntani su taka yi a kisi.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />&lt;&lt;Ku ma kankye asikye a durinya. Geri de ma a kiya ogbo yaa boyi ba. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Ba nsude yaa sa wuta apitila de sa a kisi gbodo ba; sede e la lete ogbolo de e beyi asikye ba guru ntani a gizi. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />E ma yomu na, ku nana asikye ku de ntani su geni, de su geni gangasi ku de su yobo Adaa ku de e ma siki bisi.<verse eid="MAT 5:16" /></para>
  <para style="s">Sika Doka Musa Nja Mbode Nsu Anebi Kokoyi.</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />&lt;&lt;Kede ku sa dishiya nkye ni zo de ni nana doka ni Anebi Musa; Ni zo de ni nana ba sede ni sika yi. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Na gye ku gaskye, sede bisi nja kisi su bise, ba mbodaa a siki doka dende ko totolo de yaa butu ba, se kwanki de mbo guru e sika a beta Mirikisi. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Sobon yomu du nsude nyenteri dende a siki ni doka mu, de e kokoyi worosu de su yi yiride e shi e yi yaa ma dende a siki solota ni bisi, sede guru nsude biya doka nja de kokoyi worosu doka mu yaa ma tolense a siki bisi. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Mma gye ku nkye, sede gangasi ku te pi ni Parisiyawa nja nsu male ni doka Musa ba, ka taba yuru solota gizi bisi ba.<verse eid="MAT 5:20" /></para>
  <para style="s">Kokoyi A kiya ni Anwashi</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />&lt;&lt;Ku zi de su pala gye ntani kwanki de bise, &lt;Kede ku kisa nse ba, nsude e kisa nsebeki sua yi shiriya.&gt; <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Sede na gye ku nsude e yi anwashi nja yayiwa e yi sua yi shiriya. Nsude e kwa gye yayiwa e yi nkye, &lt;ki ma Odundu,&gt; sua ka yi ta anyan toree. Nsude gye yayiwa yi nkye, &lt;E ke sari!&gt; sua sa yi a gizi wuta ni Mirikisi.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />&lt;&lt;Sobon yomu na, nde ka sa sedeka ke anya munka sedeka nde ki turunwa nkye yayiwa ke ema mbo da a dishiya yi a kiya ke, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />bila sedeka ke a geba anya munka sedeka. De ki kuma de ki te shiriya nja yayiwa ake, tuku de ki zo sa sedeka ke.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />&lt;&lt;Yi seberi de ku shiriya nja nsu de keyi kara ke, kwanki de ku tuku ma a turiki kami de kwa keyi laki shiriya, nde ku te keyi laki shiriya yaa la ke ba sakada, e shi yaa la ke ba yaya gwala, de su la ke kutiri a siki jaru. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Na gye ku gaskye, ka butu a woze ba sede ki biya gyolo de sua biya ke guru.<verse eid="MAT 5:26" /></para>
  <para style="s">Nsu kwana Nja Mata Nse Da</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />&lt;&lt;Ku zi de su pala nkye, &lt;Kede ku kwana nja mata nse da.&gt; <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Sede Na gye ku kuzukam, du nsude kone mase de e yi memeri a dishiya e yi e rigye e kwana nja e shi a dishiya e yi naka. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Nde ndani ke te sakye de ka yi lepi, butu yi kutiri. E pi de ki lesa ganga nki ke da nja de guru nki ke yaa te a gizi wuta Mirikisi. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Nde nani ke ni dama sakye de ki yi lepi, yanka yi kutiri. Yaa pi kyawu de ganga nki ke daa e ma ba nja de guru nki ke yuru a gizi wuta Mirikisi.<verse eid="MAT 5:30" /></para>
  <para style="s">Kokoyi A kiya Kisa Amere</para>
  <para style="r">
    <ref loc="MAT 19:9">Mat 19.9</ref>; <ref loc="MRK 10:11">Mk 10.11</ref>,<ref loc="MRK 10:12">12</ref>; <ref loc="LUK 16:18">Lk 16.18</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />&lt;&lt;Mirikisi pala nkye, &lt;Guru nsude kula mata yi e beyi takada de nana nkye e kula yi.&gt; <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Sede Na gye ku guru nsu de kula mata yi, mbade e keyi yaa kwana nja yaa minzi da ba, e sa yi de e ma nsu lepi kwana menza worosu su naka, du nsude amere mase de minzi yi kula yi e yi lepi ni kwana nja mata nse da naka.<verse eid="MAT 5:32" /></para>
  <para style="s">Kokoyi A kiya Melese</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />&lt;&lt;Ku zi de su pala gye ntani de su bise a beyi nkye, &lt;Kede ku yi anikowori ni yaruwa, sede ku keyi anikowori de ku yi nja Obagizi.&gt; <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Sede Na gye ku, kede ku melese ba kyashi: ko ni bisi, sobon e ma anya zunwa Mirikisi la; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />ko nja kisi, sobon e ma anya de Mirikisi yaa sa tapi seni yi la; ko ki melese nja Wurishelima sobon e ma totolo geri ni Seleki la. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Kede ki melese nja kiya ke, sobon ka yi yaa sa gesa daa de e ma peri ko beki ba. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Ki pala nkye &lt;ee,&gt; ko &lt;yi,&gt; mbode pi yomu e butu anya mungu nse la.<verse eid="MAT 5:37" /></para>
  <para style="s">Yesu Kokoyi A kiya Lama Mbo</para>
  <para style="r">
    <ref loc="LUK 6:29">Lk 6.29</ref>,<ref loc="LUK 6:30">30</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />&lt;&lt;Ku zi de su pala a siki doka Musa nkye, &lt;Ki te butu ndani ni nseda e kuma sua butu ke ndani ake, nde ki butu nseda ankuri, e ke ma sua butu ke ankuri du.&gt; <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Sede Na gye ku, kede ku ki mungu nse ba. Nde nse da mari ke a kumatu ni dama juyi kumatu ni guni beyi de e kwa mari ke. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Nja ko nse da la ke te a geba shiriya de ki beyi riga ke, bila e yi de e la ogbodo ke du. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Nde nse daa nsu sori sa ke de ku yi tepiya meli da, te nja nshi ni meli bi. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Nde nse da ologba ke mbo de ki ma nshi beyi, nsu de bila lemese se anya ke kede ki nane yi ba.<verse eid="MAT 5:42" /></para>
  <para style="s">So Oboki Geba Ke</para>
  <para style="r">
    <ref loc="LUK 6:27">Lk 6.27</ref>,<ref loc="LUK 6:28">28</ref>,<ref loc="LUK 6:32-36">32-36</ref></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />&lt;&lt;Ku zi de su pala a siki takada Mirikisi nkye, &lt;So guru nsude e ma dengeri ke, de ki ki obokigeba ke.&gt; <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Sede Na gye ku: so obokigeba ke nja ki yi worede su ma ki ke lepa, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Sobon de ku ma yaya ni Adaa ku de ma a siki bisi. Nsu de e sa nana de si walawala ba worede sua yi lepi nja nsu yi kyakyawu, e beyi riki ba nsu de sua yi mbo kyakyawu nja worede ma gangasi ba. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Nde Kwa so worede sua bila ku na kin, mina ma nani wuta de kwa keleba? Ko nsu keleba gendu sua yi yomu du! <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Nde kwa yi gesuwa nja yayiwa ku na kin, mina ku yi de e pi worosu ntani? Nsu worede de su ma Yawudawa ba sua yi yomu du bo! <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Kuma dedeta, nta yiri de Adaa ku de e ma bisi e ma dedeta.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Yesu Kokoyi A kiya Beyi Sedeka</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />&lt;&lt;Yesu pala nkye kede ku yi ANKI ku ni gangasi de ntani su geni ku, de su yobo ku. Nde ku yi yomu, Kwa mani nani wuta anya adaa ku Mirikisi bisi ba.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />&lt;&lt;Nde kwa ba nsu worede sua bila mbo da anya ku, kede ku wula tapire nsu yiride nsu munabuki sua yi a kolonwa nja kiya turiki, de ntani su yobo su. Na gye ku gaskye su keleba nani wuta su naka. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Sede nde ka ba nsu de manshi ba, kede kisa ntani su shina mbo de ka beyi ba, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Sobon mbo de kwa beyi e ma riripe. Anya ni Adaa aku de yaa geni a riripe, yaa ba ku nani wuta ku.<verse eid="MAT 6:4" /></para>
  <para style="s">Kokoyi A kiya Ni Lepa</para>
  <para style="r">
    <ref loc="LUK 11:2-4">Lk 11.2-4</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />&lt;&lt;Kwanki de kwa yi lepa, kede ku ma kankye munabuki, Sua bila de su sakisi a bisi a kolonwa nja kiya turiki de ntani su geni su. Na pala gye ku gaskye, su keleba nani wuta naka. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Sede nde ka yi lepa, te siki laki ke, de ripe kopa de ki yi lepa nja Adaa, e shi de ka geni yi ba. Anya ni Adaa nde yaa te geni mbode ka yi riripe, a ba ke nani wuta ke. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Kwanki de ka te yi lepa, kede ki yi yowa beta, kankye worede de su ma Yawudawa ba, sua geni kankye boka asu yaa zi sobon yowa lepa asu de sua yi. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Kede ku yi kankye nta yiride su, Adaa aku shina mbo de kwa so kami de kwa ologba yi.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />&lt;&lt;Yomuna kwa yi lepa;</para>
  <para style="q1" vid="MAT 6:9">&lt;&lt; &lt;Adaa amu de ma a siki bisi,</para>
  <para style="q1" vid="MAT 6:9">Seni ake eman girima,<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Solota ake e zo,</para>
  <para style="q1" vid="MAT 6:10">Nupi ka e paru</para>
  <para style="q2" vid="MAT 6:10">A durinya yiride sua yi a bisi.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Ba mu mbosi ni yawu nja ni kowoni nana.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Yape mu lepi de mu yi,</para>
  <para style="q2" vid="MAT 6:12">yiride de mua yape nsu worede de su yi mu lepi.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Kede ki bila de mu puari a siki gwada ba,</para>
  <para style="q1" vid="MAT 6:13">Sede ki butu mu bila ayan nsu mungu.&gt;<verse eid="MAT 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />Nde ku yape lepi de nse da yi ku, Adaa ku de ma a bisi yape lepi de ku yi. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Sede nde ku yape lepi de nseda yi ku ba, Adaa ku yaa yape lepi de ku yi ba.<verse eid="MAT 6:15" /></para>
  <para style="s">Kokoyi A kiya Azimi</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />&lt;&lt;Kwanki de kwa yi azimi, kede ku domuna ndani kankye yiri de munabuki sua yi, sua domuna ndani de ntani su shina, nkye sua yi azimi. Na gye ku gaskye, su keleba nani wuta asu naka. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Sede kwanki de kwa yi azimi, wonkye ndani de ku shapa mayi a kiya ku. <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />Nkaa kede ntani su shina ka yi azimi, sede Adaa ke de sua geni yi ba; nja Adaa ke, e shi de yaa geni mbo geni ka yi a boyi, yaa ba ke nani wuta ke.<verse eid="MAT 6:18" /></para>
  <para style="s">Kokoyi A kiya Nsu nani a bisi</para>
  <para style="r">
    <ref loc="LUK 12:33">Lk 12.33</ref>,<ref loc="LUK 12:34">34</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />&lt;&lt;Kede ku tala mbo nani aku a siki durinya ba, anya gana nja sikwan yaa bebeta yi, nja anya de bolowa sua wokye yuru de sukwa yi ba. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Sede e yi kyawu de ku tala mbo nani aku a bisi, anya de gana nja de sikwan yaa kpa yi ba, nja ayan de bolowa sua wokye yuru a siki de sukwa yi ba. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Anya de mbo nani ke ma a shi anya ni la dishiya ke e ma du.<verse eid="MAT 6:21" /></para>
  <para style="s">Asikye ni Nki</para>
  <para style="r">
    <ref loc="LUK 11:34-36">Lk 11.34-36</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />&lt;&lt;Ndani ke e ma nta pitila de yaa ba nki ke asikye Nde ndani ake man kyawu, nki ake guru yaa sika ni asikye. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Sede nde ndani ke ma kyawu ba, guru nki ke yaa sika ni dopuwa. Nde asikye de ma nja ke e ma dopuwa, dopuwa ke e yi girima!<verse eid="MAT 6:23" /></para>
  <para style="s">Mirikisi nja Mbo nani</para>
  <para style="r">
    <ref loc="LUK 16:13">Lk 16.13</ref>; <ref loc="LUK 12:22-31">12.22-31</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />&lt;&lt;Ba nsu de yaa ma bunwa ni ntani bi ba. Sede ki ki da de ki so da, ko ki biya da de ki ki da. Ka taba so Mirikisi nja gyolo a kwanki da ba.<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />&lt;&lt;Nkaa yomu Na gye ku, kede ku damu a kiya ni leyi ku, mbo de kwa si ko mbo de kwa sha; ko keyi de kwa sa nki ku. Leyi ku pi mbo si, nki ku pi keyi bo? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Kone nsusuwa bisi; sua nyunkwa ba, sua kwa nwenyi ba, sua tala a siki rigogo ba; nzun yomu Mirikisi adaa ku yaa ba su mbo si. Bele oku, ku pi nsusuwa bo? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Waa a siki ku yaa jan nki yi leyi ni kwana da, sobon damuwa ke?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />&lt;&lt;Mina sa Ka damu a kiya keyi de ka sa nki? Kone pure de sua yi girima ma su a pili. Su yi yanki ba su kwa dumki keyi ba. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Sede Na gye ku ko seleki Sulemanu guru dereja e yi e taba kyawu keyi da a siki pure mu ba. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Nkaayom Mirikisi yaa sa sanwa ni pili keyi, sanwa de yaa ma yawu gobe sua suwuta yi a kongo, belete oku, ki pi sanwa dereja anya Mirikisi bo, Oku mere beigaskye ni Mirikisi? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Sobon yomu kede ku damu nkye, &lt;Mina mua si? ko Mina mua sha? ko Mina mua sa?&gt; <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Worede de su shina Mirikisi ba osu na sua bila yiri mbo worede mu, Adaa ku de e ma a bisi e shina nkye kwa bila guru mbo mu. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Sede ku sa kiya bila solota yi nja gangasi ni Mirikisi, guru mbo de kwa bila sua ba ku. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Sobon yomu kede ku damu, a kiya gobe, sobon gobe yaa damu ni kiya yi. Kowoni nana mani damuwa e yi de yaa zo nshi.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Kede Ku Yi Nse da Shiriya</para>
  <para style="r">
    <ref loc="LUK 6:37">Lk 6.37</ref>,<ref loc="LUK 6:38">38</ref>,<ref loc="LUK 6:41">41</ref>,<ref loc="LUK 6:42">42</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />&lt;&lt;Kede ku yi worosu shiriya, sobon kede Mirikisi yi ku shiriya. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Yayiwa yiri shiriya de ku yi worosu, yiri yi na Mirikisi yi ku nshi du, mbo mumungu de ki la yi nseda ni mbo mumungu ni Mirikisi yaa gwada ke nshi du.<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />&lt;&lt;Mina sa de ka kone dola de ma ndani yayiwa ke de ki lesa de kone ongbomu de ma siki ndani ke? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Yaya na ka gye yayiwa ke nkye, &lt;Zo de butu ke dola de e ma andani ke,&gt; De ki bila ongbomu ma a siki andani ake? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />E ke munabuki, butu ongbomu de ma ndani ke kami de ki geni dola de ma ndani yayiwa ke sasa.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />&lt;&lt;Kede ku la mbo de ma nsuseki ba kere, de kede e juyi da e sua ke. Kede ki la serika ke kutiri a geba alede, ki la sua taka yi, sua la yi ma mbo taka nseni.<verse eid="MAT 7:6" /></para>
  <para style="s">Ku Minya, Ku Bila, Ku Buga Kopa</para>
  <para style="r">
    <ref loc="LUK 11:9-13">Lk 11.9-13</ref></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Ku sigeba Minya, sua ba ku; Ku sigeba bila, kwa samu; Ku sigeba buga kopa, kopa yaa bure ba ku. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Du nsu de sigeba minya yaa keleba, nsu de sigeba ni bila yaa samu, kopa bure ba worede de buga. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Waa na a siki ku, nde yaa yi minya mbo si yaa beyi dunsi? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Ko waa yaa yi yaa minya gunda yaa beyi mesi? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Nde oku, de kwa yi mungu mbo ku shina mbo de kwa ba yaya aku, Bele Adaa aku de ma a siki bisi yaa beyi mbo kyakyawu ba worede su minya yi bo! <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Ku yi mbode kwa bila de worede su su yi ku nshi, de ntani su yi ba ku, yomuna ku yi ba ntani, Da mu e shiya ma mbo de doka Musa kokoyi nja Anebi Mirikisi pala.<verse eid="MAT 7:12" /></para>
  <para style="s">Kopa Diriri Nja Kopa Nsu de Bure</para>
  <para style="r">
    <ref loc="LUK 13:24">Lk 13.24</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />&lt;&lt;Biya ta kopa de ma diriri. Sobon kopa te a gizi wuta turiki yi bure e mani ngala ba, worede de sua biya yi su ma nyowa. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Sede kopa ni leyi ema diriri turiki yi e mani Genbeki, nsu worede sua tapiya ashi suman piri yomu.<verse eid="MAT 7:14" /></para>
  <para style="s">Ntasi Nja Yaya yi</para>
  <para style="r">
    <ref loc="LUK 6:43">Lk 6.43</ref>,<ref loc="LUK 6:44">44</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />&lt;&lt;Kula ni kiya ku sobon worosu anebi nsu yaruwa sua zo; sua zo ku kankye timshiya sede a siki a su su ma kere bikiya la. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Kwa shina su ta anya yaya de sua yapu, ankwanya yaa taba yapu yaya Inebi ba, sua samu yaya bori a siki ankwanya sanwa ba? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Ntasi kyakyawu yaa yapu yaya kyakyawu, da de e yi kyawu ba yaa yapu yaya mumungu. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Ntasi kyakyawu yaa yapu yaya mumungu ba, mumungu ntasi yaa yapu yaya kyakyawu ba. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Nja du ntasi de yapu yaya kyakyawu ba sua sala yi kutiri a siki wuta. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Sobon yomu na kwa shina anebi ni yaruwa.<verse eid="MAT 7:20" /></para>
  <para style="s">Yesu nkye Ni shina ke Bo</para>
  <para style="r">
    <ref loc="LUK 13:25-27">Lk 13.25-27</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />&lt;&lt;Ba guru worede de sua sukwa ni. &lt;Obagizi, Obagizi,&gt; Osu na sua yuru a gizi bisi ba, sede nsu worede de sua yi mbo de Adaa na de e ma siki bisi yaa so. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Nde nana shiriya te zo, ntani nyowa sua nkye, &lt;Obagizi, Obagizi! a siki seni ke mu pala manki Mirikisi, a siki seni ake mu kula arizeni mu yi ANKI ni mbo mamanki ni yowa bo!&gt; <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Se Na gye su nkye, ku dege anya na mungu ntani, &lt;Ni shina ku ba!&gt;<verse eid="MAT 7:23" /></para>
  <para style="s">Nsu Simi nja Odundu Nsu Gini</para>
  <para style="r">
    <ref loc="LUK 6:47-49">Lk 6.47-49</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />&lt;&lt;Sobon yomu guru nsu de zi beta na de e yi ANKI nshi e ma kankye nsu de yi gini e yi a kiya dunsi. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Su yi riki, ndani minya totolo yowa a kiya e yi, akusuka wula a kiya gizi ni, sede e puari ba, sobon de su gina kutiri yi a kiya dunsi. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Sede guru nsu de zi beta na de ANKI nshi ba e ma kankye Odundu, nsu de gini gina yi a kiya nyashi. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Su yi riki, ndani minya totolo buga yi, akusuka wula a kiya gizi ni, gizi yi mumungu puari.&gt;&gt;<verse eid="MAT 7:27" /></para>
  <para style="s">Yiko Ni Yesu</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />De Yesu gama beta e yi, yowa ntani su zi mamanki a kiya mbode e kokoyi su. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Kokoyi e ma kankye male ni doka Musa ba, sede e yi kokoyi ni yiko.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Yesu Worikye Nseminji De Ma kputuru</para>
  <para style="r">
    <ref loc="MRK 1:40-45">Mk 1.40-45</ref>; <ref loc="LUK 5:12-16">Lk 5.12-16</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />De Yesu sonka a bisi zo a keteri dunsi, yowa ntani su biya yi. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Nseminji de ma kputuru e zo dunkye a geba e yi nkye, &lt;&lt;Obagizi nde ki yeda, ki sa ni de ni worikye.&gt;&gt;<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Yesu munka nani yi kpa nseminji nsu kputuru. &lt;&lt;E pala nkye ni yeda de ki worikye!&gt;&gt; dandani e worikye dege suwo yi. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Yesu gye yi nkye, &lt;&lt;Kone kede ki gye nseda ba. Sede te, de ki nana kiya ke ba pirisi de ki beyi sedeka yiride Musa e pala, de nana sheeda worikye.&gt;&gt;<verse eid="MAT 8:4" /></para>
  <para style="s">Yesu Worikye Bunwa Ni Tolense Shoja</para>
  <para style="r">
    <ref loc="LUK 7:1-10">Lk 7.1-10</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />De Yesu yuru akapanawu, se totolo tolense shoja ni Roma zo anya yi yaa bila de Yesu e sua yi nto. <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />&lt;&lt;Nkye Obagizi,&gt;&gt; &lt;&lt;Bunwa naa e man lapiya ba ema a gizi yaa zi nki yowa nja suwo nki sharuwa.&gt;&gt;<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Yesu gye yi nkye, &lt;&lt;Na te de worikye yi.&gt;&gt; <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Tolense shoja keleba yi nkye, &lt;&lt;Obagizi, Ni deta de ka zo a gizi na ba. Sede ki pala kelima kin, bunwa na yaa worikye. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Ko eni ma ni ma yiko nseda na du, sede ni man shoja agizina. Na gye nseda nkye, &lt;Te,&gt; Yaa dege te; nseda na gye nkye, &lt;zo,&gt; yaa zo. Ni gye bunwa na, yi ANKI mu yaa yi.&gt;&gt;<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />De Yesu zi yomu e yi mamanki e gye nsu worede su biya yi nkye, &lt;&lt;Na gye ku gaskye, Ni taba geni nseda a siki Izireyila de beigaskye yomu ba. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Na gye ku gaskye ntani nyowa de su shina Mirikisi ba sua butu anya nyisa, sua zo anya buki a pili nja Abireyi, Ishaku nja Yakubu a gizi bisi. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Sede worede su ma yaya solota ba, sua la su kutiri a siki dopuwa, anya de sua yi kuka nja suku ankuri.&gt;&gt;<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Yesu gye tolense shoja Roma nkye, &lt;&lt;Te ma ke a gizi, mbode ki beigaskye e shiya sua yi ke nshi,&gt;&gt; anya ni bunwa tolense shoja worikye dandani<verse eid="MAT 8:13" /></para>
  <para style="s">Yesu Worikye Ntani Nyowa</para>
  <para style="r">
    <ref loc="MRK 1:29-34">Mk 1.29-34</ref>; <ref loc="LUK 4:38-41">Lk 4.38-41</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />De Yesu ta a gizi ni Biturusu, e geni amaa ni mata yi kwakwana a kiya gbodo yaa yi suwo mashapo. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Yesu kpa nani nki yi suwo mashapo bila e yi, e dege a bisi e yi su mbosi.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />De nyema yi, su kwa yi ntani nyowa de mani arizeni zo anya Yesu, E butu mumungu aworo nja bete, e kwa worikye worede su ma suwo. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />E yi yomu de e sika mbode anebi Ishaya pala nkye, &lt;&lt;E shi e la suwo amu. nja shuwuta mu.&gt;&gt;<verse eid="MAT 8:17" /></para>
  <para style="s">Sua Ma Nsu Biya Yesu</para>
  <para style="r">
    <ref loc="LUK 9:57-62">Lk 9.57-62</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />De Yesu geni yowa ntani gyowe yi, e gye yayagizi yi nkye su nyenteri te ni keteri ni riki. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Se male ni kokoyi doka ni Musa zo anya yi gye yi nkye, &lt;&lt;Male, Na biya ke te anya de ka te guru.&gt;&gt;<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Yesu keleba yi nkye, &lt;&lt;Kere bikiya e man romu, nsusuwa bisi mani gizi kwana, sede E ni Yaa nsebeki ni man anya de Na la kiya ja ba.&gt;&gt;<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Daa a siki yayagizi yi gye yi nkye, &lt;&lt;Obagizi, na te de ni bishina adaa na tuku.&gt;&gt;<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Sede Yesu gye yi nkye, &lt;&lt;Biya ni, de ki bila worede shina Mirikisi ba de su bishina yayuwa asu de su muntu.&gt;&gt;<verse eid="MAT 8:22" /></para>
  <para style="s">Yesu Sakisi Ni Totolo Akusuka</para>
  <para style="r">
    <ref loc="MRK 4:35-41">Mk 4.35-41</ref>; <ref loc="LUK 8:22-25">Lk 8.22-25</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Se Yesu yuru a siki kwanto, Yayagizi yi yuru biya e yi. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Dandani totolo akusuka dege a siki totolo riki, riki wula yuru a siki kwanto, Yesu ma yi kwana. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Yayagizi yi dege yi, su nkye, &lt;&lt;Obagizi, sila mu! Mua bila muntu!&gt;&gt;<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />&lt;&lt;Yesu keleba su, oku mere beigaskye, mina sa kwa yi womba?&gt;&gt; Se e dege a bisi kwabe akusuka nja angwe riki guru su yi ship.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Konwawa su yi mamanki su minya nkye, &lt;&lt;Woni yiri nsebeki mu? De akusuka nja angwe riki su zi betayi?&gt;&gt;<verse eid="MAT 8:27" /></para>
  <para style="s">Yesu Worikye Menza Bi De Su ma Mumungu Aworo.</para>
  <para style="r">
    <ref loc="MRK 5:1-20">Mk 5.1-20</ref>; <ref loc="LUK 8:26-39">Lk 8.26-39</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />De Yesu keyi keteri riki ni gunduma Ganesere, menza bi de suman Aworo mumungu su butu a siki kumsha sa nshi. Su ma mbo womba nja nseda ma sori de yaa biya a turiki ni ba. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />&lt;&lt;Dandani Su yi kuruwa nkye mina na ka bila anya mu, E ke Yaa Mirikisi?&gt;&gt; &lt;&lt;Ki zo de ki ba mu poro tunde kwanki mu keyi wo ba?&gt;&gt;<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />E yi nyisa nja su ba de sua ke anyade alede si mbo si. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Mumungu aworo su pata Yesu nkye, &lt;&lt;Nde ka kula mu de mu butu ta woze, kula mu de mu te a siki alede mu.&gt;&gt; <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />E gye su nkye, &lt;&lt;Ku te!&gt;&gt; Su butu te siki alede, guru alede su te yuru a siki totolo riki se guru asu su muntu teke a siki riki. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Nsu worede sua kiwo alede su yi gudu te siki geri, su gye ntani mbode e paru nja menza de su ma ni mumungu aworo. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Se guru ntani geri su butu te woze de su geni Yesu. De su geni Yesu, su ologba de e bila kesa su.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Yesu Worikye Nsu Nki Sharuwa</para>
  <para style="r">
    <ref loc="MRK 2:1-12">Mk 2.1-12</ref>; <ref loc="LUK 5:17-26">Lk 5.17-26</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Yesu nyunwa kwanto de e bise te a geri yi kapanawu. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Worosu su ntani keyi nsude nki yi sharuwa zo nshi, kwakwana a kalanga. De Yesu geni beigaskye asu e gye nsude nki yi sharuwa nkye, &lt;&lt;kadishiya, Yaa, su yape lepi ake.&gt;&gt;<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Male ni kokoyi doka Musa gye nkyasu nkye, &lt;&lt;Nseminji mu yaa saba Mirikisi!&gt;&gt; <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />Anya ni Yesu shina mbode sua tunani dishiya asu, e minya su nkye, &lt;&lt;Mina sa de kwa shiriya mungu mbo a dishiya oku? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Wona pi soki: de su nkye, &lt;Lepi ke su yape,&gt; Ko su nkye, &lt;Dege a bisi de ki yi tepiya&gt;? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Sede na bila de ku shina nkye Yaa nsebeki e man yiko a durinya mu de yape lepi.&gt;&gt; Se e gye nsu nki sharuwa, &lt;&lt;Nkye dege a bisi, la kalanga ake de ki te a gizi.&gt;&gt; <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Se nseminji nsu nki sharuwa dege a bisi te a gizi. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />De ntani geni mbo de e paru, su zi womba, se su yobo Mirikisi de e ba nsebeki sori.<verse eid="MAT 9:8" /></para>
  <para style="s">Yesu Sukwa Matiyu.</para>
  <para style="r">
    <ref loc="MRK 2:13-17">Mk 2.13-17</ref>; <ref loc="LUK 5:27-32">Lk 5.27-32</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />De Yesu bila anya ni, e geni nseminji daa sua sukwa yi nkye Matiyu e zunwa kingbolo keleba gendu, e gye yi nkye, &lt;&lt;biya ni,&gt;&gt; Matiyu dege biya yi.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />De Yesu yaa si mbosi a gizi Matiyu, yowa nsu keleba gendu nja &lt;&lt;Nsu lepi&gt;&gt; Su zo si mbosi nja shi nja yayagizi yi. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />De ntani Parisiyawa su geni, su minya yayagizi Yesu nkye, &lt;&lt;Mina sa de male aku yaa si mbosi nja nsu keleba gendu nja nsu &lt;lepi&gt;?&gt;&gt;<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />De Yesu zi yomu keleba nkye, &lt;&lt;Nsude mani lapiya yabila Nsu Mengeni ba, nsu de yaa yi suwo e shiya yaa te Anya Nsu Mengeni bo. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Sede ku te minya mbo de beta Mirikisi pala: &lt;Toseyi Na na so, ba sedeka zini nama na ma bila ba.&gt; Sobon Ni zo de ni sukwa nsu worede yi mbo gangasi aba, sede nsu lepi.&gt;&gt;<verse eid="MAT 9:13" /></para>
  <para style="s">Su Minya Yesu Beta A kiya Azimi.</para>
  <para style="r">
    <ref loc="MRK 2:18-22">Mk 2.18-22</ref>; <ref loc="LUK 5:33-39">Lk 5.33-39</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Se yayagizi Yaaya nsu tunkwasa su zo anya Yesu, su minya yi nkye, &lt;&lt;Mina sa omu nja parisiyawa mua yi azimi, sede yayagizi ake sua yi azimi ba?&gt;&gt;<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Yesu keleba su nkye, &lt;&lt;Mina sa de oboki ango sua yi beki siki a buki tunde e ma nja su? Kwanki yaa zo de sua la ango bila su; kwanki ni sua yi azimi.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />&lt;&lt;Ba nseda de yaa yi pashi keyi wuri nja sabuwa keyi, anya de e dumki yaa saga, saga ni yaa pi ni pari mungu. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Ba nsude yaa la riki ni Inebi sabuwa nya siki gwala de ma wuri. Nde su la nya gwala, gwala yaa wokye, riki inebi yaa nya kisi sua yi asara gwala. Momoko yomu riki inebi sabuwa su nya a sabuwa gwala yomuna, sua lesa riki inebi ko gwala ba.&gt;&gt;<verse eid="MAT 9:17" /></para>
  <para style="s">Yaa Mase De Muntu Nja Mase De E kpa Riga Yesu.</para>
  <para style="r">
    <ref loc="MRK 5:21-43">Mk 5.21-43</ref>; <ref loc="LUK 8:40-56">Lk 8.40-56</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />De Yesu ma siki gye su mbo mu, tolense ni kolonwa daa zo dunkye a geba e yi, yaa ologba Yesu nkye, &lt;&lt;Yaa na ni mase muntu kuzukam zo de ki sa nani ke a kiya e yi, de ema leyi.&gt;&gt; <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Yesu nja yayagizi yi su dege a bisi te nja shi.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />De Yesu ma a kiya tepiya mase daa de yi shekera gom sha bi yaa nya zini e biya a beyi zo kpa Yesu a baki riga. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />E pala a dishiya e yi nkye, &lt;&lt;Nde ni kpa riga yi kede na worikye.&gt;&gt;<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Yesu juyi se geni yi nkye. &lt;&lt;Yaa na ni mase,&gt;&gt; Kadishiya, &lt;&lt;beigaskye ke sakye worikye.&gt;&gt; Dandani mase ni worikye dege nya zini yi.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />De Yesu ta a gizi tolense ni kolonwa e sa ni nsu wula tapire muntu nja ntani yowa sua yi kuruwa, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Yesu gye su nkye, &lt;&lt;Ku butu te woze. Yaa mase mu muntu ba yaa yi kwana la.&gt;&gt; Guru asu su yi Yesu dala ni nene. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />A beyi de Yesu butu ntani guru de su te woze, e te a siki laki e la yaa mase a nani, se yaa mase dege a bisi. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Nabari mbo mu gyowe te guru gunduma ni.<verse eid="MAT 9:26" /></para>
  <para style="s">Yesu Worikye Makapi Nja Nsude Arishiya Loni.</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />De Yesu bila anya ni, e ma siki tepiya makapi bi sua biya e yi, Sua yi kuruwa nkye, &lt;&lt;Zi toseyi mu, Yaa ni Dowuda!&gt;&gt;<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />De Yesu te siki gizi daa, makapi bi zo anya e yi, &lt;&lt;E minya su, ku yeda e ni Na yaa worikye ku?&gt;&gt;</para>
  <para style="p" vid="MAT 9:28">&lt;&lt;Su keleba yi, ee, Obagizi mu yeda.&gt;&gt;<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Se Yesu kpa ndani asu e pala nkye, &lt;&lt;E paru nja ku yiride ku beigaskye&gt;&gt;; <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Se ndani asu bure. Yesu gye su nkye, &lt;&lt;Kede ku gye nseda ba.&gt;&gt; <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Sede su te a woze te beyi nabari gyowe gunduma ni guru.<verse eid="MAT 9:31" /></para>
  <para style="s">Yesu Worikye Nse Minzi de Ma yi Beta Ba</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />De sua te woze, nseminji daa de mani mungu aworo eya yi beta ba su keyi zo anya ni Yesu. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />De arizeni butu bila nseminji de eya yi beta ba, e para beta. Ntani yowa su zi mamanki su pala nkye, &lt;&lt;Mu taba geni mbodaa yomu a siki Izireyila ba.&gt;&gt;<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Sede ntani parisiyawa su pala nkye, &lt;&lt;Tolense ni arizeni e shiya ba Yesu sori de yaa butu arizeni.&gt;&gt;<verse eid="MAT 9:34" /></para>
  <para style="s">Nsu Anki Su ma Nyowa Ba</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yesu te gyowe guru totolo geri nja dende, kokoyi su a siki kolonwa, e keyi su manki kyakyawu ni solota nja worikye kowoni suwuta nja suwo. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />De Yesu geni yowa ntani, e zi toseyi asu, sobon de su ma a siki Genbeki siki nja su ma nsude yaa sua su nto ba, kankye timshiya de su beeta. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Se e gye yayagizi yi, &lt;&lt;Nkye ANKI e yi yowa nsu ANKI su yi yowa ba. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Sobon yomu ku yi lepa de Obagizi nsu ANKI saka nsu yi ANKI a bikiya yi.&gt;&gt;<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Yesu saka Yayagizi yi gom sha bi</para>
  <para style="r">
    <ref loc="MRK 3:13-19">Mk 3.13-19</ref>; <ref loc="LUK 6:12-16">Lk 6.12-16</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Yesu sukwa yayagizi yi gom sha bi e ba su sori de su butu mumungu aworo nja de su worikye kowoni suwo nja suwuta.<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />Da mu e shiya ma seni yaamanki gom sha bi: Ni pari, Sima, de sua sukwa yi Biturusu, nja yayiwa e yi Anduru; Yakubu yaa ni Zabedi, nja yayiwa e yi Yaaya; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Pilibu nja Batalomi; Tomasi nja Matiyu nsu keleba gendu; Yakubu yaa ni Alipa nja Tadus; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Sima de ma Kaana nja Yawuda Isikariyoti, nsude butu Yesu a beyi.<verse eid="MAT 10:4" /></para>
  <para style="s">Yesu Saka Yayagizi yi Gom sha Bi</para>
  <para style="r">
    <ref loc="MRK 6:7-13">Mk 6.7-13</ref>; <ref loc="LUK 9:1-6">Lk 9.1-6</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Menza gom sha bi Yesu saka su ni manki nkye: Kede ku te a siki worede su shina Obagizi nja geri Samariya ba. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Sede ku te anya Izireyila de su ma kankye timshiya worede su beta . <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Nde ku te, ku gye su manki nkye: &lt;Solota gizi bisi yi kusa.&gt; <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Ku worikye nsu suwo, ku dege worede su muntu nleyi, ku worikye worede su ma kputuru, Ku kula arizeni, kyawuta ku keleba kyawuta ku beyi. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Kede ku keyi zinari ko aziripa ko riga, ko gyolo ba; <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Kede ku la Angala ba, ko riga, ko takalami ko gwala. Nsu ANKI yi kyawu de su beyi nani wuta mbode e yi.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />&lt;&lt;Guru totolo geri ko dende geri de ku yuru, ku bila nse gangasi anya ni ku zunwa nja shi ari nana de kwa bila anya ni. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Nde ku yuru a siki gizi, ku yi su selema. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Nde nsu gizi ni keleba ku, se selema aku e ma Nja e shi; nde e ma ba bila de selema aku e kuma biya ku. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Nde nse da yi ku naba ba ko e zi beta aku ba, ku kekebe kula ni seni ku nde kwa bila gizi ko totolo geri ni. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Na gye ku gaskye yaa pi zi toseyi ntani Sodoma nja Gomora, a nana shiriya ntani kesa de su ki ku.<verse eid="MAT 10:15" /></para>
  <para style="s">Genbeki Nsu zo</para>
  <para style="r">
    <ref loc="MRK 13:9-13">Mk 13.9-13</ref>; <ref loc="LUK 12:11-12">Lk 12.11-12</ref>; <ref loc="LUK 21:12-19">21.12-19</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Na saka ku a woze kankye timshiya a siki kere bikiya. kuma nsu wayo nta mesi kuma miyo kankye nkurisha.<verse eid="MAT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17" />&lt;&lt;Ku sa ndani ni ntani durinya mu; Sua la ku ba yaya gwala de su dukwa ku a siki Kolonwa. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Sobon eni sua zo nku a geba toree nja seleki de ema su sheeda nja worede shina Mirikisi ba. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Kwanki de su ka ku, kede ku damu ni mbo de kwa pala ba ko mina kwa pala. A kwanki ni Mirikisi yaa ba ku mbo de kwa pala. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Sobon oku na kwa yi beta ba; Aworo ni Adaa ku yaa yi beta a siki ku. <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />Yayuwa sua la yayuwa su a beyi de su kisa su; yomuna adaa yaa yi yaya yi, yaya sua yi geba nja nsu adaa su sua sa su de su muntu. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Guru ntani sua ki ku sobon eni, sede du nsude sakisi nsori ari karishe yaa sila. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Nde su ki ku a geri daa ku yi gudu de ku kuma te a geri daa. Na gye ku gaskye kwa gama gyowe guru kesa Izireyila ba de Yaa nsebeki yaa kuma zo. <verse eid="MAT 10:23" /><verse number="24" style="v" sid="MAT 10:24" />Yaa makaranta yaa taba pi male yi ba, ko bunwa yaa pi nsugizi yi ba. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />E deta de yaa makaranta e ma kankye male yi, nja bunwa e ma kankye nsu gizi yi. Nde su sukwa tolense gizi nkye tolense arizeni, yaya gizi sua sukwa su nkye kona!<verse eid="MAT 10:25" /></para>
  <para style="s">Nsude Su Zi Womba yi</para>
  <para style="r">
    <ref loc="LUK 12:2-7">Lk 12.2-7</ref></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />Sobon yomu kede ku zi womba su ba, ba mbo de ma a boyi de sua de yaa ki ma a bure ba, ko mbo de ma boyi de sua shina yi ba. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Mbo de Na gye ku a siki dopuwa ku pala yi a siki asikye, nja mbo de ku zi a kuni ku pala yi a pegye. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Kede ku zi womba worede sua kisa nki ku sede sua kisa leyi aku ba; sede ku zi womba Mirikisi, e shi de yaa kisa nki aku nja leyi aku de ala kutiri te siki wuta. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Nkwankwala bi sua la see toro bi na bo, ba daa a siki asu de puari a kesa ba ni shina adaa ku. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Ko gesa kiya ku guru su kirigayi. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Sobon yomu kede ku zi womba ba; ku mani anpani pi nkwankwala nyowa.<verse eid="MAT 10:31" /></para>
  <para style="s">Nana Yeda ni Kiristi A geba ntani</para>
  <para style="r">
    <ref loc="LUK 12:8-9">Lk 12.8-9</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />Sede guru nsude nana kiya su nkye su ma nna na a geba ntani, Eni ma Na nana nkye su ma nna na a geba adaa na ni bisi. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Sede guru nsude ki ni a geba ntani, Eni ma na ki yi a geba adaa de ma a bisi.<verse eid="MAT 10:33" /></para>
  <para style="s">Ba zunwa Selema naba Sede Topula</para>
  <para style="r">
    <ref loc="LUK 12:51-53">Lk 12.51-53</ref>; <ref loc="LUK 14:26-27">14.26-27</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Kede ku geni nta Ni zo de ni keyi selema na zo a durinya. ayi, Ni zo ku nselema ba, sede Ni zo ku ni obalaba la. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Ni zo de sa yaminzi nja adaa yi de su yi rikishi, yaamase nja amaa yi, mase amere nja minzi yi. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />Obokigeba ake yaa ma ntani siki gizi ke.&gt; <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />Nsude yaa so Adaa yi ko amaa yi pi ni e deta de yaa ma nna ba; Nsude so yaa yi ni minzi ko ni mase pi ni e deta de yaa ma nna ba. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Guru nsude la gidiri yi de e biya ni ba e deta de yaa ma nna ba. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Du nsu de yaa so leyi yi yaa lesa yi; du nsu de lesa leyi yi sobon eni yaa samu yi.<verse eid="MAT 10:39" /></para>
  <para style="s">Nani wuta</para>
  <para style="r">
    <ref loc="MRK 9:41">Mk 9.41</ref></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />&lt;&lt;Du nsude keleba ku eni na e keleba, nja nsude keleba ni e keleba nsude e saka ni la. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Du nsude keleba anebi sobon de e ma anebi yaa keleba nani wuta ni anebi. Guru nsude keleba nse gangasi sobon de ema nse gangasi yaa keleba nani wuta ni nse gangasi. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Guru nsude e ba nseda koshiya riki a siki keseyi yaya naa dende mu sobon ema yayagizi na, Na gye ku gaskye, yaa lesa nani wuta yi ba.&gt;&gt;<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Yesu Nja Yaaya Nsu Tunkwasa</para>
  <para style="r">
    <ref loc="LUK 7:18-35">Lk 7.18-35</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />A beyi de Yesu gama ba yayagizi yi gom sha bi doka, e sigeba ni kokoyi nja beyi manki a siki geri ni Galili. <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />De Yaaya nsu tunkwasa zi a jaru mbo de kiristi yaa yi, e saka yayagizi yi te anya Yesu. <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />De su minya yi, &lt;&lt;E ke na ki ma nsu de yaa zo, ko mu sa ndani pekye nse daa?&gt;&gt; <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Yesu keleba nkye, &lt;&lt;Ku kuma mbayi ku te gye Yaaya mbo de ku zi nja mbode ku geni: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Makapi sua geni, Gurugu sua yi tepiya, worede su ma kputuru sua samu worikye, Kuruma sua zi kuni, worede de muntu sua dege nleyi, nabari manki kyakyawu su gye potoruwa. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Nsu anabirika la worede de su zi shaka na a dishiya su ba!&gt;&gt;<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />De yayagizi Yaaya kuma beyi, Yesu para beta gye yowa ntani a kiya Yaaya: &lt;&lt;Mina ku te adenka de ku te geni? Akusuka de yaa wula sanwa a denka? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Minana ku ta a woze de ku geni? nseminji de sa keikei yi kyakyawu la? E ma yomu ba worede sa yiride keikei yi kyakyawu su ma kolonwa seleki la. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Se mina ku te a woze de ku geni Anebi la? Ee, Na gye ku, e pi Anebi. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Da mu e shiya ma nsude su yi rubutu a kiya e yi nkye:</para>
  <para style="q1" vid="MAT 11:10">&lt;&lt;&lt;Na saka yamanki na a geba ke,</para>
  <para style="q2" vid="MAT 11:10">de gyala turiki ke kami de ki zo.&gt;<verse eid="MAT 11:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Na gye ku gaskye: A siki guru worede mata yapu su nse da ma totolo kankye Yaaya nsu tunkwasa ba; kuzukam nsu de e ma dende a solota siki bisi e pi Yaaya. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Dege kwanki Yaaya nsu yi tunkwasa zo a kuzukam, solota siki gizi bisi ma Genbeki nsu sori topula sua leyi nsori. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Guru anebi nja doka ni Musa su yi beta a kiya Yaaya. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Nde ku yeda de kwa keleba yi, e shiya ma Iliya, de yaa zo. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Nsu de man kuni zi e zi.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />&lt;&lt;Kuzukam, ni mina na ma gonta ntani kukuzum? Su ma kankye yaya dende de su zuzunwa a baki bize sua sukwa nki asu.<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />&lt;&lt;&lt;Mu wula ku tapire</para>
  <para style="q2" vid="MAT 11:17">ku ki de ku yi wasa;</para>
  <para style="q1" vid="MAT 11:17">Mu yi ku wonka muntu ku ki ku yi kuka.&gt;<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />De Yaaya zo e yi azimi e sha ba, e si ba su pala nkye, &lt;E mani Mumungu aworo a siki e yi.&gt; <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />De Yaa nsebeki zo yaa si yaa sha, guru ntani su nkye, su yowa si nja sha, oboki nsu keleba gendu, nja nsu yi &lt;&lt;Lepi,&gt;&gt;&gt; Sede nzun yomu su ma nana simi Mirikisi, nana ema gaskye te anya ni ANKI e yi.&gt;&gt;<verse eid="MAT 11:19" /></para>
  <para style="s">Geri De Su ki Bila Lepi</para>
  <para style="r">
    <ref loc="LUK 10:13-15">Lk 10.13-15</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Se Yesu para kwabe totore geri de e yi ANKI mamanki a siki yi sobon su ki juyi bila mbo mumungu sua yi ba. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />&lt;&lt;Gbotuma aku, Korasin! Gbotuma aku, Beseda! Nde mbo mamanki de su yi a siki aku su yi a geri Taya nja Sidon, nde sua juyi te anya Mirikisi su saa keyi sasa nja busi nki su. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Sede Na gye ku, gaskye yaa pi zi toseyi Taya nja Sidon nja de yaa zi toseyi ku a nana shiriya Mirikisi. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Oku, ntani Kapanawu, kwa geni kankye kwala nkyaku te a bisi? Yi, Sua la ke kutiri te anya zunwa nsu muntu. Nde mbo mamanki de su yi a siki ake sua yi a kesa Sodoma, de ari kuzukam sua juru yi ni wuta ba. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Sede Na gye ku nana de Mirikisi yaa yi shiriya, yaa pi zi toseyi ntani kesa Sodoma pi ku.&gt;&gt;<verse eid="MAT 11:24" /></para>
  <para style="s">Ku zo anyana De ku samu pushe</para>
  <para style="r">
    <ref loc="LUK 10:21-22">Lk 10.21-22</ref></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />A kwanki ni Yesu pala nkye, Mma yobo ke, Adaa, Mirikisi m nja kisi, Ni gbede ni ke sobon mbo de ki boyi anya worede de suman simi nja nsu shina, ki pelesa ba yaya dende. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Ee, Adaa, da mu e shiya ma mbo kyakyawu de ki yi. <verse eid="MAT 11:26" /><verse number="27" style="v" sid="MAT 11:27" />&lt;&lt;Guru mbo mu Adaa ba ni su. Nse daa shina Yaa ba se Adaa kede na shina yi, yomuna nse daa shina Adaa ba se Yaa nja worede jima Ya yaa pelesa Adaa ba su.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />&lt;&lt;Ku zo anya naa, guru ku de ku gezi ni loni ka yi, na ba ku pushe. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Ku la ganse na sa a wuya ku de ku kokoyi anya na, sobon Ni ma din nja soki dishiya, Anya ni kwa samu pushe a siki leyi aku. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Sobon ganse na e man soki la nja kemeshi, yi de na ba ku e man loni ba.&gt;&gt;<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Minya Beta A kiya Nana Asibi</para>
  <para style="r">
    <ref loc="MRK 2:23-28">Mk 2.23-28</ref>; <ref loc="LUK 6:1-5">Lk 6.1-5</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />A nana asibi Yesu te a bikiya alikama, yayagizi yi sua zi nyunwa su dure zabi worede su su saba alikama suku. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />De Parisiyawa geni mbo de yayagizi Yesu sua yi, su gye yi nkye, &lt;&lt;Geni, yayagizi ke sua yi mbo de e man kyawu ba nana asibi!&gt;&gt;<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />E keleba su nkye, &lt;&lt;Ku karanta bo mina Dowuda yi a nana de e shi nja nsu oboki ANKI su yi de sua zi nyunwa? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />E te a laki Mirikisi, e shi nja oboki tepiya yi su suku buredi de su la sa keteri, de doka yeda su de su suku ba, se pirisi na kede. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Ko ku karanta a siki doka Musa ba de nana asibi pirisi yaa yuru a siki laki Mirikisi su yi banza nnana asibi nzun yomu ema lepi ba? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Na gye ku nkye nsude pi laki Mirikisi e ma anya mu. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />&lt;Toseyi Naa mma bila, ba sedeka daba ba,&gt; Nde ku shina mbo de kelima mu ma yi nupi, kwa taba geni lepi worede man lepi ba. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Yaa nsebeki e ma Obagizi asibi.&gt;&gt;<verse eid="MAT 12:8" /></para>
  <para style="s">Nse minzi Nsu Nani Sharuwa</para>
  <para style="r">
    <ref loc="MRK 3:1-6">Mk 3.1-6</ref>; <ref loc="LUK 6:6-11">Lk 6.6-11</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Yesu dege anya ni e yuru a siki kolonwa su, <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />nse minzi da nsu nani sharuwa anya ni. Sua bila anya de sua ka Yesu ni beta, su minya yi nkye, &lt;&lt;E yi kyawu de su worikye nsu suwo nana asibi?&gt;&gt;<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Yesu gye su nkye, nde nse da ku e mani timshiya se e puari a siki romu a nana asibi, ka yuru de ki butu yi bo? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Nsebeki pi timshiya dereja soseyi! sobon yomu, doka amu pala nkye kede mu sua nse daa nto nana asibi ba.&gt;&gt;<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Se e gye nseminji de nani yi sharuwa nkye, &lt;&lt;Munka nani ake.&gt;&gt; Se e munka nani yi dandani nani yi worikye. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Sede parisiyawa su te yi showura de su kisa Yesu.<verse eid="MAT 12:14" /></para>
  <para style="s">Bunwa de Mirikisi zabi yi</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />De Yesu zi mbode su yi a kiya e yi, e dege ma yi bila anya ni; yowa ntani su biya yi, guru e worikye worede sua yi suwo. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />E gila su kede su gye nseda kowaa ma e shi. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />E pala yomuna sobon de e sika mbode Anebi Ishaya e pala:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />&lt;&lt;Damu e shiya ma bunwa na de Ni zabi,</para>
  <para style="q2" vid="MAT 12:18">Nsude Na so, ni e shi na yi perisiki;</para>
  <para style="q1" vid="MAT 12:18">Na sa Aworo Na a kiya e yi, Yaa gye worede su shina Mirikisi ba shiriya na.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Yaa yi rikishi ko kuka ba;</para>
  <para style="q2" vid="MAT 12:19">Ba nsude yaa zi murinya yi a kiya turiki ba.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Kakala de bila watala yaa taba watala ba,</para>
  <para style="q2" vid="MAT 12:20">pitila nsu ayanki yaa taba bita ba.</para>
  <para style="q1" vid="MAT 12:20">yaa taba butu dishiya se gaskye shakiya<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />A siki seni e yi worede su ma Yawudawa ba sua sadishiya su nja shi.&gt;&gt;<verse eid="MAT 12:21" /></para>
  <para style="s">Yesu Nja Baazabu</para>
  <para style="r">
    <ref loc="MRK 2:23-28">Mk 2.23-28</ref>; <ref loc="LUK 6:1-5">Lk 6.1-5</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Anya ni su zo ni makapi kuruma de yaa yi beta ba sobon e mani aworo mumungu. Yesu worikye yi, de e zi nja de e kwa yi beta. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Se guru ntani su yi mamanki ni mbode Yesu yi. &lt;&lt;Su nkye, e shiya ma Yaa ni Dowuda bo? <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />De parisiyawa zi mbo de Yesu e yi, su pala nkye, &lt;&lt;E kula arizeni sobon Bezabu tolense ni arizeni na bayi sori de e ma kula arizeni. <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Yesu shina tunani dishiya asu, e pala nkye, &lt;&lt;Guru solota de yaa topula nja kiya yi yaa puari, nja kowoni geri ko gizi de laba bi yaa sigeba ba. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Nde obiri te topula nja kiya yi, e laba nki yi bi ema yi geba nja nki yi. Yaya na solota yi yaa sakisi? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Nja nde ku nkye Ni kula arizeni ni sori bezabu, ni sori waa ntani ku sua kula su te a woze? Yomu, Yaya kutiri ku sua Pala mumungu a kiya ku du. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Sede nde Ni kula arizeni ni sori Aworo Mirikisi, e nana nkye solota ni Mirikisi e zo anya ku aka<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />&lt;&lt;Ko jaja, ba nsu de yaa yuru a gizi nsu sori de e kwa yi mbo de e manshi ba, sede yaa para e domuna yi; tukuna yaa kwa yi keyi a gizi yi.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />&lt;&lt;Du nsu de e ma nja ni ba; e ma yi geba nja ni, nja du nsu de yaa sua nto tala ba yaa zizila. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Sobon yomu na gye ku, guru lepi nja saba de ntani su yi sua yape su nshi; sede du nsude yi beta saba a kiya Aworo Mirikisi, Mirikisi yaa taba yape yi ba ko a kwanki mu ko nsu zo. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Du nsude yi beta ni nene a kiya yaa nsebeki sua yape yi, sede nsu de yi beta ni nene a kiya Aworo Nsuseki na yape yi ba, ko a kwanki mu ko a kwanki nsu zo.<verse eid="MAT 12:32" /></para>
  <para style="s">Ntasi nja Yaya</para>
  <para style="r">
    <ref loc="LUK 6:43-45">Lk 6.43-45</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />Sa ntasi de yi kyawu yaa yi yaya kyakyawu, ntasi de yi kyawu ba, yaa yi yaya kyakyawu ba. Sua shina ntasi te anya Yaya de yapu. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Oku yaya ogbozi oku de ku ma mungu kwa pala mbo kyakyawu? dege mbo de e ma dishiya nse beki na baki yaa pala bo. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Nsu de e ma kyakyawu yaa beyi mbo kyakyawu butu a siki mbode e man shi a rigogo yi, nsude e ma mungu nsebeki mbo mumungu yaa butu a siki dishiya yi. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Sede Na gye ku a nana shiriya kowon nse yaa te pala guru mungu beta de e yi. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Kelima baki ke na sua yike shiriya, ko yaa butu ke ko yaa butu ke ba.&gt;&gt;<verse eid="MAT 12:37" /></para>
  <para style="s">Parisiyawa Sua Bila Alama anya Yesu</para>
  <para style="r">
    <ref loc="MRK 8:11-12">Mk 8.11-12</ref>; <ref loc="LUK 11:29-32">Lk 11.29-32</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Se worede su su parisiyawa nja male kokoyi doka Musa su gye Yesu nkye. &lt;&lt;Male, mua bila de ki nana mu mbo mamanki dege anya ke.&gt;&gt;<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Yesu keleba nkye, &lt;&lt;Mungu ntani kwanki mu nsu reshi yeda nja Mirikisi kwa bila geni mbo mamanki! Yesu gye su nkye. Sede ba mbo da ba sua nana ku nshi de pi mbo mamanki ni Anebi Yunusa de ku geni. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Ku geni yiri de Yunusa yi kwana wuku a siki totolo gunda, yomuna yaa nsebeki yaa yi nana wuku nja dederi wuku a siki ni kesa <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Nana shiriya ntani Neneba sua dege sua geni lepi aku, sobon su juyi te anya Mirikisi kwanki de Yunusa e keyi su manki Obagizi; kuzukam nsu de e pi Yunusa aka anya mu. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Nana shiriya mata seleki Sheba ni kudu yaa dege yaa geni lepi ku; sobon de e butu a kesa e zo zi mbo kyakyawu de seleki Sulemanu yaa kokoyi; Na gye ku nse da ma anya mu de e pi seleki Sulemanu.<verse eid="MAT 12:42" /></para>
  <para style="s">Kuma ni Mungu Aworo</para>
  <para style="r">
    <ref loc="LUK 11:24-26">Lk 11.24-26</ref></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />&lt;&lt;Kwanki de Mungu aworo te butu bila nse beki, yaa te bila anya de yaa te zunwa. Nde te samu ba. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Yaa gye kiya nkye, &lt;Na kuma te a gizi na.&gt; E te zo geni nse da man ba, anya ma sere, su gyala yi kyakyawu. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Yaa kuma te kwa yi mumungu aworo bokwe de su pi sori, sua te zunwa anya ni. Mbo de e paru nja nse ni yaa pi mbo de paru nshi a pari, yomuna yaa paru nja mungu ntani ni kwanki mu&gt;&gt;<verse eid="MAT 12:45" /></para>
  <para style="s">Amaa Yesu Nja Yayuwa Yesu</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />De Yesu e ma siki beta Amaa e yi nja yayuwa yi su zo. Su sakisi a woze, sua bila de su yi beta nja Yesu. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Anya ni nse da a siki asu gye yi nkye, &lt;&lt;Geni, Amaa ke nja yayuwa ke su sakisi a woze, sua bila de su yi beta nja ke.&gt;&gt; <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Yesu minya su nkye, &lt;&lt;Waa na e ma Amaa na? Nsu waa su ma yayuwa na?&gt;&gt; <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Yesu munka nani te anya yayagizi yi, nkye, &lt;&lt;Da mu na ma Amaa naa na nja nsu yayuwa na. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Du nsu de yi mbo de Adaa na de ma siki bisi yaa bila e shiya ma, yayiwa na nja Amaa na.&gt;&gt;<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Abenshi ni nsu Nunkwa</para>
  <para style="r">
    <ref loc="MRK 4:1-9">Mk 4.1-9</ref>; <ref loc="LUK 8:4-8">Lk 8.4-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />A nana ni Yesu butu bila gizi e zunwa a keteri totolo riki. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Ntani nyowa gyowe yi Yesu se e yuru zunwa a siki kwanto, ntani nyowa sakisi a baki riki. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Yesu yi beta nyowa gye su mbo ni kokongye, E pala nkye: &lt;&lt;Nsu bikiya da te de nunkwa yiri a bikiya e yi. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />De ma a kiya yaapi yiri, worede su yiri puari a kiya turiki nsusuwa kwa yi si. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Worede su puari a kiya dunsi anyan de man kesa nyowa ba. E butu seberi, sobon kesa ma anya ni soseyi ba. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Sede de zapi nana butu a bisi, yiri de butu, e kyekeri sobon ririnya e yi ta kisi soseyi ba. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Worede su puari a siki ankwanya, de su yi girima ankwanya sukwa su. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Jaja worede su puari a siki kesa kyakyawu, su yi yaya nyowa: worede su deri, worede su sitin, worede su man talatin.&gt;&gt; <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Yesu e pala nkye, &lt;&lt;Nsu de mani kuni zi e zi!&gt;&gt;<verse eid="MAT 13:9" /></para>
  <para style="s">Delili ni Abenshi</para>
  <para style="r">
    <ref loc="MRK 4:10-12">Mk 4.10-12</ref>; <ref loc="LUK 8:9-10">Lk 8.9-10</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Yayagizi e yi zo anya e yi su minya e yi nkye, &lt;&lt;Minana sa de ka gye ntani beta ni kokongye?&gt;&gt;<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Yesu gye su nkye, sobon oku su yeda ku de ku shina mbo de ma riripe a solota ni bisi, sede osu su bila su de su shina ba <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Guru nsu de e mani mbo Mirikisi yaa ja yi nshi, nsu de e mani shi ba ko dende piri de e mani shi anya yi sua keleba bila nani yi. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Mbo de sa na yi su beta ni kokongye aka: &lt;&lt;Suman ndani sede sua geni anya ba; Suman kuni sede sua zi ko sua gane ba.<verse eid="MAT 13:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14" />Mbo de anebi Ishaya pala e paru nja su:</para>
  <para style="q1" vid="MAT 13:14">&lt;&lt;&lt;Kwa te zi sede kwa gane ba;</para>
  <para style="q2" vid="MAT 13:14">Kwa te sa ndani sede kwa geni ba.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Sobon dishiya ni ntani mu e mani tori;</para>
  <para style="q2" vid="MAT 13:15">yaa yi wuya de su zi ni kuni asu;</para>
  <para style="q2" vid="MAT 13:15">nja su ripe ndani asu. Sobon ndani asu yaa te geni,</para>
  <para style="q2" vid="MAT 13:15">kuni asu yaa te zi.</para>
  <para style="q1" vid="MAT 13:15">Dishiya asu yaa te gane sua juyi beyi, na Mirikisi yaa worikye su.&gt; <verse eid="MAT 13:15" /><verse number="16" style="v" sid="MAT 13:16" />Sede anabirika, na ma ndani ku sobon ndani aku yaa geni, kuni aku sobon sua zi. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Na gye ku gaskye, anebi nyowa nja worede de su yi mbo gangasi sua bila de su geni mbo de kwa geni sede su geni ba, su zi mbo de kwa zi, sede su zi ba.<verse eid="MAT 13:17" /></para>
  <para style="s">Yesu Gye su Abenshi ni Nsu nunkwa</para>
  <para style="r">
    <ref loc="MRK 4:13-20">Mk 4.13-20</ref>; <ref loc="LUK 8:11-15">Lk 8.11-15</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />&lt;&lt;Ku zi mbo de kokongye ni nsu nunkwa yaa nupi. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Du nsu de zi manki ni solota Mirikisi na e gane ba, mungu nse yaa zo butu mbo de su nunkwa a dishiya asu, su ma kankye yiri de puari a kiya turiki. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />yiri de puari a kiya dunsi e shina ma nsu de zi manki Mirikisi dandani e keleba ni perisiki. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Sede a ririnya te a siki siki kesa ba, yaa te dede ba. De Genbeki zo ko gwada su sobon kelima de e zi, se dandani e puari. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Yiri da de puari a siki ankwanya sanwa e shiya ma nsu de zi kelima Mirikisi, sede damuwa ni mbo kwanki mu nja bila mbo ni nani su nana kelima Mirikisi sukwa yi, e sa beta Mirikisi yi yaya ba. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Sede yiri de puari a siki kesa kyakyawu e shiya ma worede de su zi beta ni Mirikisi de su gane. worede su yapu yaya deri, worede su sitin, nja talatin talatin ni mbo de su nunkwa.&gt;&gt;<verse eid="MAT 13:23" /></para>
  <para style="s">Abenshi A kiya Sanwa</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yesu sakye gye su kokongye da: Nkye, &lt;&lt;Solota bisi e ma kankye nsu de nunkwa yiri kyakyawu a bikiya e yi. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Sede kwanki de kowon nse e ma yi kwana, obokigeba te nunkwa sanwa a siki alikama ni se e te ma yi. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />De alikama yi girima e yi kiya. se sanwa e yi girima du<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />&lt;&lt;Bunwa ni nsu bikiya ni zo anya e yi nkye, &lt;Obagizi, yiri kyakyawu na ki nunkwa a bikiya ake bo? Sanwa butu angana?&gt;<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />Obagizi keleba nkye. &lt;Obokigeba na na su yi mbo mu.&gt;</para>
  <para style="p" vid="MAT 13:28">&lt;&lt;Bunwa yi minya yi nkye, &lt;Ka bila de mu te butu su?&gt;<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />&lt;&lt;&lt;Yi,&gt; Nsu bikiya keleba nkye,&gt; &lt;Sobon nde ku te a butu sanwa, kwa butu alikama du. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Bila su guru asu de su yi girima gaba da kwanki de sua yi keikei bikiya, na gye worede de sua yi keikei bikiya: De su para yenkye sanwa de su domuna yi gizi gizi kutiri a siki wuta; se ku tala alikama zo nya a siki rigogo na.&gt; &gt;&gt;<verse eid="MAT 13:30" /></para>
  <para style="s">Abenshi Ni Saba Mosta</para>
  <para style="r">
    <ref loc="MRK 4:30-32">Mk 4.30-32</ref>; <ref loc="LUK 13:18-19">Lk 13.18-19</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Yesu sakye gye su kokongye daa: Nkye: &lt;&lt;Solota gizi bisi e ma kankye saba mosta, de nse daa la nunkwa a bikiya e yi. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />E shiya ma piri a siki yiri de mu manshi, nde e yi girima, e shi yaa ma totolo a siki guru ntasi de ma a siki bikiya. De nsusuwa sua yi gizi asu a siki yaya nani e yi.&gt;&gt;<verse eid="MAT 13:32" /></para>
  <para style="s">Kokongye ni Darigeza</para>
  <para style="r">
    <ref loc="LUK 13:20-21">Lk 13.20-21</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Yesu sakye gye su kokongye daa: nkye, &lt;&lt;Solota gizi bisi e ma kankye derigaza de mase daa la suruka nja atuwa nsu yowa e sa atuwa juyi guru.&gt;&gt;<verse eid="MAT 13:33" /></para>
  <para style="s">Yesu yi Anpani ni Kokongye</para>
  <para style="r">
    <ref loc="MRK 4:33-34">Mk 4.33-34</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yesu gye guru mbo worosu mu te yowa ntani kokongye; e taba gye su beta daa ba sede abenshi. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Yomu na yaa sika mbode Mirikisi e pala a baki Anebi nkye:</para>
  <para style="q1" vid="MAT 13:35">&lt;&lt;Na bure baki naa a siki kokongye,</para>
  <para style="q2" vid="MAT 13:35">Na pala mbode e ma a boyi tunde su kapa durinya.&gt;&gt;<verse eid="MAT 13:35" /></para>
  <para style="s">Abenshi A kiya Sanwa</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />De Yesu bila yowa ntani e yuru a siki gizi. Yayagizi e yi su zo anya e yi su minya nkye, &lt;&lt;Gye mu mina ma maana kokongye a kiya sanwa de ma pili.&gt;&gt; <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />Yesu keleba, nsu de e nyunkwa yiri kyakyawu ema Yaa nsebeki. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Bikiya e shiya ma durinya, yiri kyakyawu e shiya ma nsude su ma yaya solota. Sanwa e shiya ma yaya mungu nse, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Obokigeba de nunkwa sanwa e shiya ma mungu nse. kwanki kwa yi keikei ni bikiya e shiya ma karishe durinya, nsu worede sua kwa yi keikei bikiya osu na ma meleku.<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />Yiride su kwa yi sanwa tala de su suwuta e yi yomuna yaa paru a karishe durinya. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Yaa nsebeki yaa saka meleku e yi, sua tala guru worede sua sa ntani solota e yi lepi nja guru nsude yi mungu mbo. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Sua kutiri su ta siki wuta anyade su yi kuka nja suku ankuri. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Ntani gangasi Mirikisi sua yi asikye kankye nana a gizi ni Adaa su. Ku zi, nsu e man kuni e zi bila de e zi.<verse eid="MAT 13:43" /></para>
  <para style="s">Abenshi Ni Mbo De Mbo Nani De Ma A boyi</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />Solota ni bisi e man kankye dukiya de boyi a siki bikiya. De nseminji daa samu, Aku manshi boyi a kesa, e yi perisiki, e la mbode e manshi guru se e kuma te see bikiya ni.<verse eid="MAT 13:44" /></para>
  <para style="s">Abenshi ni Pili</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />&lt;&lt;Jaja, Solota bisi e ma kankye, yaa bije de yaa bila dunsi kyakyawu. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />De e te samu daa de yi kyawu soseyi, e te la mbo guru de e manshi, de se dunsi kyakyawu.<verse eid="MAT 13:46" /></para>
  <para style="s">Abenshi A kiya Eya</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />&lt;&lt;Kuma jaja, Solota ni bisi ma kankye eya de su kutiri te a siki totolo riki e ka gunda yiri yiri. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />De eya sika ni gunda, nsu ka gunda su butu yi ta keteri riki. Su zabi gunda kyakyawu nya a siki obubu, mumungu su la kutiri a woze. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Yomu na yaa ma a karishe durinya. Obagizi yaa saka Meleku e yi yaa zo laba mungu ntani dege gangasi ntani. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Sua la su kutiri a siki wuta, ayan de sua yi kuka nja suku akuri.<verse eid="MAT 13:50" /></para>
  <para style="s">Sabuwa Gaskye nja Wuri</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Yesu minya su. &lt;&lt;Ku gane guru mbode ni gye ku?&gt;&gt;</para>
  <para style="p" vid="MAT 13:51">Su keleba nkye, &lt;&lt;Ee,&gt;&gt; <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />E gye su nkye, &lt;&lt;Nkaa guru nsu male doka Musa de ma yayagizi solota bisi su ma kankye nsugizi de e la sabuwa nja wuri dukiya de e ma a siki rigogo e yi.&gt;&gt;<verse eid="MAT 13:52" /></para>
  <para style="s">Su ki Yesu Anazere</para>
  <para style="r">
    <ref loc="MRK 6:1-6">Mk 6.1-6</ref>; <ref loc="LUK 4:16-30">Lk 4.16-30</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />De Yesu gama gye su kokongye, e bila anya ni. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Yesu kuma zo a geri e yi, E para kokoyi su a kolonwa, se sua zi mamanki. &lt;&lt;Angana nseminji samu simi nja mbo mamanki sori mu?&gt;&gt; Su minya. <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />&lt;&lt;e shiya ma yaa ni kapinta mu bo? Meremu, e shiya e ma Amaa e yi bo nsu yayuwa e yi na su ma, Yakubu, Sima, Yusupu, nja Yawuda bo? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Guru yayiwa e yi mata na su ma nja mu bo? Angana e samu guru sori yi mbo mu?&gt;&gt; <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Anya ni se su zi anwashi e yi.</para>
  <para style="p" vid="MAT 13:57">Sede Yesu gye su nkye, &lt;&lt;Anebi e man girima a geri e yi nja gizi e yi ba.&gt;&gt;<verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />E yi ANKI mamanki nyowa anya ni ba Sobon de su ki beigaskye.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Muntu Ni Yaaya Nsu yi Tunkwasa</para>
  <para style="r">
    <ref loc="MRK 6:14-29">Mk 6.14-29</ref>; <ref loc="LUK 9:7-9">Lk 9.7-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Kwanki ni Yiridu e ma seleki ni Galili, e zi nabari a kiya Yesu. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />&lt;&lt;E gye nsu keleba manki e yi nkye, &lt;&lt;Yaaya nsu yi tunkwasa, e shiya dege a kumsha,&gt;&gt; mbode saa e man sori de yaa yi ANKI mamanki naka.&gt;&gt;<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Kuzukam Yiridu e sa su kaa Yaaya nsu yi tunkwasa ta jaru de su kula yi sobon Yirudiya, mata yayiwa e yi Pilibu, <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Yaaya e ma gye Yiridu nkye: &lt;&lt;E yi kyawu de amere Yirudiya mata yayiwa ke ba.&gt;&gt; <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Yiridu yaa so de e kisa Yaaya, sede yaa zi womba ntani, sobon su la Yaaya e ma Anebi la.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />De sua yi buki turunwa nana de su yapu seleki Yiridu, yaa ni Yirudiya yi wasa a geba ntani de sa seleki Yiridu e yi peri siki nyowa <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />E yi anikowori ni melese nkye, guru mbode ki ologba na ba ke. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />E biya beta ni amaa yi, e pala nkye, &lt;&lt;Dandani kuzukam ba ni kiya Yaaya nsu yi tunkwasa akoriya.&gt;&gt; <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Seleki da mu, sede sobon melese de e yi a geba guru worede su ma bakwe, E gye su su beyi mbode e minya <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />E sa su butu Yaaya kiya a jaru. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Su keyi kiya Yaaya a siki koriya zo nshi munka yaamase ni, abenshi keyi amaa yi. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Yayagizi Yaaya su zo la nki e yi te bishina. Su te gye Yesu.<verse eid="MAT 14:12" /></para>
  <para style="s">Yesu Ba Ntani Dupu Biyari Mbosi</para>
  <para style="r">
    <ref loc="MRK 6:30-44">Mk 6.30-44</ref>; <ref loc="LUK 9:10-17">Lk 9.10-17</ref>; <ref loc="JHN 6:1-14">Jn 6.1-14</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />De Yesu zi mbode paru nja Yaaya, e dege yuru kwanto ta ayan de nseda ma a siki yi ba. De ntani zi yomu, se konse bila geri e yi biya Yesu su yi tepiya a seni. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />De Yesu sonka a siki kwanto de e geni yowa ntani, e zi toseyi asu e worikye worede suman lapiya ba.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />De nyema yi yayagizi yi zo gye e yi nkye, &lt;&lt;Anya mu nseda ma asikye yi ba, gye ntani mu de su te a siki geri de su bila mbosi.&gt;&gt;<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Yesu keleba, &lt;&lt;E ma dole na de su ta anya daa ba. ku ba su mbo si de su si.&gt;&gt;<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Su keleba nkye &lt;&lt;Mu mani mbodaa anya mu ba sede buredi biyari nja gunda bi,&gt;&gt;<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Yesu pala nkye. &lt;&lt;Ku zo nshi anya mu,&gt;&gt; <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />E gye su guru su zunwa a kiya sanwa. E la buredi biyari nja gunda bi e kone bisi, e gbede Mirikisi se e laba buredi. Se e ba yayagizi e yi, yayagizi e yi su ba ntani. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Guru ntani su si ari su koshi, yayagizi e yi sukwa yi worede rigye sika obubu gom sha bi. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Yowa ntani de su si su ma menza dubu biyari, bon mata nja yaya dende.<verse eid="MAT 14:21" /></para>
  <para style="s">Yesu yi Tepiya A kiya Riki</para>
  <para style="r">
    <ref loc="MRK 6:45-52">Mk 6.45-52</ref>; <ref loc="JHN 6:15-21">Jn 6.15-21</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Dandani Yesu saa yayagizi yi su yuru a kwanto su te a geba e yi a keteri daa, se e gye ntani su kuma ta gizi. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />De e seleme ntani, e nyunwa bisi dunsi e shi dan daa de yi lepa. De nyema yi, Yesu ma anya ni e shi dan daa, <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Sede kwanto tuku ma nyisa a siki riki, kwanto yaa zizika sobon akusuka de yaa topula a kiya e yi.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />kyakya ni pekye keripi wuru ni dederi Yesu ma yi tepiya a kiya riki ma zo ayan yayagizi e yi. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />De yayagizi yi geni ni ema yi tepiya a kiya riki, su yi womba. Su nkye, &lt;&lt;potoruwa la,&gt;&gt; Se guru asu su yi kuruwa sobon ni womba.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Dandani Yesu gye su nkye: &lt;&lt;Ku kadishiya. E ni na. Kede ku zi womba ba.&gt;&gt;<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Anya ni Biturusu nkye, &lt;&lt;Obagizi, nde e ma e ke la! sa ni de ni yi tepiya a kiya riki zo anya ake.&gt;&gt;<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Yesu sukwa yi nkye &lt;&lt;Zo,&gt;&gt; .</para>
  <para style="p" vid="MAT 14:29">Se Biturusu butu a siki kwanto yi tepiya a kiya riki de e te anya Yesu. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />De e zi akusuka man sori, e zi womba anya ni e para takisi riki. &lt;&lt;E yi kuruwa nkye, sila ni Obagizi.&gt;&gt;<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Dandani Yesu munka nani e yi keyi nkye, &lt;&lt;Mina sa de ki beigaskye piri, de ki shaka a dishiya ake?&gt;&gt;<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />De guru asu su yuru a kwanto akusuka sakisi sip. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Se worede ma a siki kwanto su bowuta Yesu. &lt;&lt;Su nkye ni gaskye ki ma Yaa Mirikisi la!&gt;&gt;<verse eid="MAT 14:33" /></para>
  <para style="s">Yesu Worikye nsu suwo a Genesere</para>
  <para style="r">
    <ref loc="MRK 6:53-56">Mk 6.53-56</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />De su nyenteri riki ta kesa ganesere. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />De ntani anya ni gane Yesu. Su beyi manki ta guru geri de gyowe su, su keyi worede sua yi suwo zo anya Yesu. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Su ologba Yesu de worede su ma yi suwo su kpa keteri riga yi guru, de su samu worikye.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Mbode nsu Adaatolomu kokoyi</para>
  <para style="r">
    <ref loc="MRK 7:1-13">Mk 7.1-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Se worosu su Parisiyawa nja male ni kokoyi doka Musa su zo anya Yesu dege Wurishelima su minya, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />&lt;&lt;Mina sa de yayagizi ake su ki biya alaada ni toree? Sua wonkye nani asu kami de su si mbosi ba!&gt;&gt;<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Yesu keleba nkye, &lt;&lt;Mina sa de ku ki biya doka Mirikisi sobon mbode alaada aku? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Mirikisi pala nkye, &lt;Ki beyi girima ni Adaa nja Amaa ke&gt; &lt;Nsu de e basi Adaa yi ko Amaa yi sua saa de muntu.&gt; <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Sede ku pala nkye nde nsebeki mani mbode yaa ba adaa e yi ko amaa e yi, &lt;du mbode kwa samu anyana e ma kyawuta de na ba Mirikisi la,&gt; <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Sobon kokoyi alaada ni adaatolo aku. Ku la beta Mirikisi ma mbo daa ba. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Oku munabuki! E ma gaskye la de Ishaya yi beta a kiya aku:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />&lt;&lt; &lt;Ntani worosu mu sua ba ni girima ni baki la,</para>
  <para style="q2" vid="MAT 15:8">Sede dishiya asu e ma nyisa nja ni.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Wopi sua bowuta ni;</para>
  <para style="q2" vid="MAT 15:9">Sobon sua kokoyi doka nsebeki sua geni kankye doka na!&gt;&gt;&gt;<verse eid="MAT 15:9" /></para>
  <para style="s">Mbode Yaa sa Nsebeki Yaman Dole</para>
  <para style="r">
    <ref loc="MRK 7:14-23">Mk 7.14-23</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Yesu sukwa tala ntani e gye su nkye, &lt;&lt;Ku zi de ku gane. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Ba mbode ma yuru a siki a baki nsebeki na yaa sa yi e ma dodola ba; sede, mbode yaa butu dege baki yi na yaa sa yi e ma dola.&gt;&gt;<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Se yayagizi e yi su zo anya e yi su minya nkye, &lt;&lt;Ki shina nkye parisiyawa su yi anwashi a kiya mbode ki pala?&gt;&gt;<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Yesu keleba nkye, &lt;&lt;Guru ntasi de Adaa na de ma a siki bisi na nunkwa ba sua butu yi aririnya kutiri. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Bila su; Su ma nsu ka makapi gwala la. Nde makapi yaa te kaa makapi gwala guru asu sua puari a siki romu.&gt;&gt;<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Biturusu nkye, &lt;&lt;Gye mu maana kokongye mu.&gt;&gt; <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Yesu gye su nkye, &lt;&lt;Ari ni yawo ku tuku gane bo. <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Ku shina bo du mbode yuru a baki ke yaa bise ta a siki tuku yaa butu ANKI ke bo? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Sede mbode ma butu a siki baki nsebeki e butu a siki dishiya la, mbode yaa sa ke de ka te ma &lt;ni dola nse anya Mirikisi.&gt; <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Dege a siki dishiya la mungu tunani yaa zo, kisa nse, kwana nja mase de maana ke ba, bolowa, goyi beyi ni nsu yaruwa, pala mbo mumungu a kiya nseda. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Mbode yaa sa nsebeki man &lt;Dola naka;&gt; sede si mbosi ba wonkye nani yaa taba saa nsebeki e man dola ba.&gt;&gt;<verse eid="MAT 15:20" /></para>
  <para style="s">Mase De Beigaskye</para>
  <para style="r">
    <ref loc="MRK 7:24-30">Mk 7.24-30</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yesu bila anya ni ta siki gunduma Taya nja Sidon. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Mase ni kesa Kaana zo anya yi, e yi kuka nkye, &lt;&lt;Obagizi, Yaa ni Dowuda, zi toseyi na! Kone yaa na ni mase yaa Genbeki nja aworo mumungu.&gt;&gt;<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Yesu sa mase mu baki ba. Yayagizi yi su zo anya yi su beyi kadishiya nkye, &lt;&lt;Kula yi de e te, ema biya mu ni kuka.&gt;&gt;<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Yesu keleba nkye, &lt;&lt;Su saka Ni zo anya ntani Izireyila de ma timshiya de beeta na kowon.&gt;&gt;<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Anya ni mase ni zo dunkye a geba e yi. E pala nkye, &lt;&lt;Obagizi, Sa ni nani!&gt;&gt;<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Yesu keleba nkye, &lt;&lt;E man kyawu de kula mbosi yaya dende ba kere.&gt;&gt;<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />&lt;&lt;Mase ni keleba nkye ee ema gaskye,&gt;&gt; Obagizi,&gt;&gt; &lt;&lt;Sede mbosi de puari dege teburu obagizi na kere yaa la si.&gt;&gt;<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Yesu keleba yi nkye, &lt;&lt;Mase beigaskye ema nsori! Mbode ka so ema yomu.&gt;&gt; Anya ni yaa mase worikye.<verse eid="MAT 15:28" /></para>
  <para style="s">Yesu Ba Ntani Yowa Mbosi Si</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Anya ni Yesu bila baki totolo riki ni Galili. E nyunwa kiya dunsi e zuzunwa a kisi. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Ntani nyowa su zo anya yi, su zo ni gurugu, ni makapi, ni worede sua yi tepiya tigbotigbo, ni sari, nja guru yiri suwo de ntani man shi, su sa su a geba Yesu; worikye su. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Guru ntani su yi mamanki de su geni sari yaa yi beta, worede sua yi tigbotigbo su worikye, gurugu su ma yi tepiya, makapi su ma geni. Anya ni su yobo Mirikisi ni Izireyila.<verse eid="MAT 15:31" /></para>
  <para style="s">Yesu Ba Ntani Dubu Wuru Mbosi Si</para>
  <para style="r">
    <ref loc="MRK 8:1-10">Mk 8.1-10</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Yesu sukwa yayagizi yi nkye, &lt;&lt;Na zi toseyi ntani woromu; su ma nja ni kwana asu wuku naka su si mbosi ba. Na bilade su kuma te ni nyunwa ba, sobon kede su lense muntu a turiki gizi.&gt;&gt;<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Yayagizi yi su keleba yi nkye, &lt;&lt;Angana mua samu buredi de yaa deta ntani worosu mu a siki denka mu?&gt;&gt;<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />&lt;&lt;Yesu minya nkye, Buredi kona ku man shi?&gt;&gt;</para>
  <para style="p" vid="MAT 15:34">&lt;&lt;Su keleba buredi bokwe nja gunda piri.&gt;&gt;<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Se Yesu gye ntani su zuzunwa a kisi. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Yesu la buredi bokwe nja gunda ni, e gbede Mirikisi, e sua buredi ni se e ba yayagizi yi, su laba ba ntani guru. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Guru asu su si koshi. A beyi guru Yayagizi yi sukwa yi worede rigye sika obubu bokwe de kekeriya rigye. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Yowa ntani worede si mbosi su ma dupu wuru, boni mata nja yaya dende. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />A beyi de Yesu seleme ntani, se e yuru a siki kwanto ta kesa Magadan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Ntani Sua Bila Alama</para>
  <para style="r">
    <ref loc="MRK 8:11-13">Mk 8.11-13</ref>; <ref loc="LUK 12:54-56">Lk 12.54-56</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Parisiyawa nja sadokiyawa su zo anya Yesu de su gwada yi, su minya yi de e nana su alama dege bisi.<verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />Yesu keleba nkye, &lt;&lt;De nyema yi, kwa pala nkye, &lt;Anya seenyi kyakyawu, sobon de gidagida yi zaan.&gt; <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Nde anya kwa yi, &lt;Kwa nkye sua yi riki, sobon gidagida yi beki.&gt; Ku shina yiride bisi juyi nde ku kone gidagida, sede kwa geni alama ni kwanki mu ba. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Ntani ni sana mu! mungu ntani nja mere aminshi anya Mirikisi su ma bila alama, sua nana su nshi ba sede alama ni anebi Yunusa.&gt;&gt;</para>
  <para style="p" vid="MAT 16:4">Yesu bila su te ma yi.<verse eid="MAT 16:4" /></para>
  <para style="s">Derigaza ni Parisiyawa nja Sadokiyawa</para>
  <para style="r">
    <ref loc="MRK 8:14-21">Mk 8.14-21</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />De Yesu nja yayagizi yi nyenteri riki te keteri, su mosi de su keyi buredi. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yesu gye su yayagizi yi nkye, &lt;&lt;Mani ankeli aku,&gt;&gt; Ku kone kiya ku a kiya derigaza ni parisiyawa nja sadokiyawa.&gt;&gt;<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Su yi beta nja nki asu nkye, &lt;&lt;Sobon de mu keyi buredi ba.&gt;&gt;<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Shina mbode sua pala nja nki asu, Yesu minya su nkye, &lt;&lt;Oku de kuma ni beigaskye ba, mina saa de kwa pala gye nkyaku nkye ku man buredi ba? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Ari kuzukam ku gane ni bo? Ku turunwa ni buredi biyari de Ni si ni ntani dupu biyari mu bo? Obubu kona de sika na ku kwa yi? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Ko buredi bokwe de ni si ni ntani dupu wuru, obubu kona sika de ku kwa yi tala? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Minana sa de ku gane nkye na yi beta nja ku a kiya buredi naba? Ku mani ankeli nja nki aku a kiya ni derigaza ni Parisiyawa nja Sadokiyawa.&gt;&gt; <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Anya ni yayagizi e yi su shina nkye Yesu yaa yi beta nja su a kiya derigaza de sua nya aburedi naba, sede a kiya mbode Parisiyawa nja Sadokiyawa sua kokoyi la.<verse eid="MAT 16:12" /></para>
  <para style="s">Biturusu Sheeda Yesu Ma Kiristi</para>
  <para style="r">
    <ref loc="MRK 8:27-30">Mk 8.27-30</ref>; <ref loc="LUK 9:18-21">Lk 9.18-21</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />De Yesu zo gunduma ni keseriya Pilibi, e minya yayagizi yi nkye, &lt;&lt;Ntani su ma nkye Yaa nsebeki ema waa?&gt;&gt; <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Su keleba nkye, &lt;&lt;Worosu su man nkye ki ma Yaaya nsu tunkwasa la; Worosu su nkye Iliya; nja worosu nkye, Yirimiya ko daa a siki Anebi la.&gt;&gt;<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Yesu minya nkye, &lt;&lt;Sede oku paa,&gt;&gt; ku nkye Ni ma waa?&gt;&gt;<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Sima Biturusu keleba nkye, &lt;&lt;Ki ma Kiristi Yaa Mirikisi nsu leyi.&gt;&gt;<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Yesu keleba, &lt;&lt;Anabirika ma nja ke, Sima yaa ni Yunusa, Gaskye mu butu anya nsebeki naba, sede anya Adaa na ni siki bisi. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Sede Na gye ke, Biturusu, ki ma dunsi, nja a kiya dunsi mu Na gina shoshi, ko muntu yaa taba shakiya yi ba. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Na ba ke mukuli solota gizi bisi; mbode ku yeda nshi a durinya Mirikisi yeda nshi a bisi, mbode ku ki a durinya Mirikisi ki yi a bisi.&gt;&gt; <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Se Yesu kobe yayagizi yi nkye, kede su gye nseda nkye e shiya ma Kiristi ba.<verse eid="MAT 16:20" /></para>
  <para style="s">Yesu yi Beta A kiya Muntu yi</para>
  <para style="r">
    <ref loc="MRK 8:31-9:1">Mk 8.31—9.1</ref>; <ref loc="LUK 9:22-27">Lk 9.22-27</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Butu a kwanki ni Yesu gye yayagizi yi a pili, Na te a Wurishelima de ni Genbeki nyowa a nani toree ni pirisi, nja male ni doka Musa, Sua kisa yi de e muntu, nana ni wuku na dege ni leyi.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Biturusu ja Yesu ta keteri e kwabe yi nkye mina sa de ka pala yomu, &lt;&lt;Mirikisi sonka, Obagizi! Yaa paru yomu nja ke ba!&gt;&gt;<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Yesu juyi gye Biturusu nkye, &lt;&lt;Dege anya mu, obiri! Ki ma dunsi titimi na ba ni; Sobon tunani ake e butu anyan Mirikisi aba, ema tunani nsebeki la.&gt;&gt;<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Se Yesu gye yayagizi yi nkye, &lt;&lt;Guru nsu de yaa so biya ni, yaa mosi nki yi de e la gidiri yi tuku de yaa biya ni. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Guru nsude yaa bila sila nleyi yi, yaa lesa yi, sede nsu de ki leyi yi sobon eni, yaa samu yi. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Mina kyakyawu samu nde kisa mu guru mbo de ma a durinya de ki lesa leyi ake? Ko mina ka beyi de ka samu leyi ake a bisi? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Yaa nsebeki yaa zo a siki dereja ni Adaa yi nja meleku Mirikisi, Yaa zo ba konse nani wuta yi ni mbo de yi a durinya, <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Na gye ku gaskye, worosu su de su sakisi anya mu sua muntu ba; Se su geni Yaa nsebeki de yaa zo a siki solota yi.&gt;&gt;<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Nki Yesu Shenja</para>
  <para style="r">
    <ref loc="MRK 9:2-13">Mk 9.2-13</ref>; <ref loc="LUK 9:28-36">Lk 9.28-36</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />A beyi kwana shida Yesu la Biturusu, Yakubu nja Yaaya yayiwa ni Yakubu, E sa su nyunwa kiya dunsi nkyasu. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Su ma anya ni nki Yesu shenja a geba asu. Pisika yi, yi asikye kankye nana, riga yi ma peri kankye asikye. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Dandani se su geni Musa nja Iliya, sua yi beta nja Yesu.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Biturusu gye Yesu nkye, &lt;&lt;Obagizi, e yi kyawu de mu ma anya mu. Nde Ki yeda, Na yi rugwa wuku anya mu, da ma Na ke, da ma ni Musa, da ma ni Iliya.&gt;&gt;<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />De e ma kiya beta, gidagida zo ripe su, murinya beta butu a siki a gidagida nkye, &lt;&lt;Da mu e shiya ma Yaa Na, de Ni mma so. Ku zi mbo de yaa gye ku!&gt;&gt; <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />De yayagizi e yi su zi yomu, su yi womba, su saa ndani asu a kisi. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Yesu zo kpa su. &lt;&lt;Nkye ku dege,&gt;&gt; &lt;&lt;Kede ku zi womba ba.&gt;&gt; <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />De su dege a bisi, su geni nse daa anya ni ba se Yesu.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />De su ma sonka bila kiya dunsi, Yesu ba yayagizi e yi doka nkye, &lt;&lt;Kede su gye nse da mbo de su geni ba! Se kwanki de su dege Yaa nsebeki a siki kumsha.&gt;&gt;<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Yayagizi e yi su minya yi nkye, &lt;&lt;Mina sa de male ni doka Musa su pala nkye e ma dole na Iliya e zo npari.?&gt;&gt;<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Yesu keleba nkye, &lt;&lt;E ma yomu la Iliya yaa zo npari de gyala mbo guru. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Sede Na gye ku, Iliya e zo ntani shina yi ba, sobon yomu su yi mbo de sua so. Yomu na sua yi nja Yaa nsebeki.&gt;&gt; <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Se yayagizi e yi su shina nkye yaa yi beta nja su a kiya Yaaya nsu tunkwasa.<verse eid="MAT 17:13" /></para>
  <para style="s">Worikye Ni Yaa Nsu Arizeni</para>
  <para style="r">
    <ref loc="MRK 9:14-29">Mk 9.14-29</ref>; <ref loc="LUK 9:37-43a">Lk 9.37-43a</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />De su kuma te anya de ntani yi yowa, nseminji daa zo ayan Yesu, e dure a geba e yi. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />E pala nkye, &lt;&lt;Obagizi, Ki zi toseyi yaa na! Sobon e man suwo okpinkpi kon kwanki yaa sa yi puari a siki wuta nja riki. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Ni keyi zo anya yayagizi ake, su yi yaa worikye yi ba.&gt;&gt;<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Yesu keleba, &lt;&lt;Yi oku de ku ki beigaskye nja mungu ntani! Ari woshe Na ma nja ku? Ari woshe Na yi takuwa nja ku? ka yi Yaa ni zo anya mu!&gt;&gt; <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yesu kwabe arizeni nkye butu! E butu bila yaa ni, dandani yaa ni worikye.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Se yayagizi Yesu zo anya e yi a boyi su minya yi, &lt;&lt;Mina sa de omu mu yi yaa kula arizeni butu ba?&gt;&gt;<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Yesu gye su nkye, &lt;&lt;Sobon ku man beigaskye piri, Na gye ku gaskye, nde ku man beigaskye piri kankye saba mosta, kwa gye ogbo mu nkye, &lt;Dege anya mu de ki te anya ni&gt; Yaa dege te. Ba mbode yaa pi sori aku ba.&gt;&gt; <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Yiri arizeni mu yaa butu ba se ku yi azimi nja lepa.&gt;&gt;<verse eid="MAT 17:21" /></para>
  <para style="s">Yesu saki yi Beta A kiya Muntu yi</para>
  <para style="r">
    <ref loc="MRK 9:30-32">Mk 9.30-32</ref>; <ref loc="LUK 9:43b-45">Lk 9.43b-45</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />De Yesu nja yayagizi yi guru su zo gabada a Galili, Yesu pala gye su nkye, &lt;&lt;Sua butu Yaa nsebeki a beyi sua la yi beyi a nani ntani. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Sua kisa yi, a beyi kwana wuku Yaa dege nleyi.&gt;&gt; Yayagizi yi su yi beki siki.<verse eid="MAT 17:23" /></para>
  <para style="s">Beyi Gendu Ni Gizi Mirikisi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />De Yesu nja yayagizi yi zo Akapanawu, worede sua keleba gendu a siki gizi Mirikisi su zo minya Biturusu nkye, &lt;&lt; Male aku yaa biya gendu gizi Mirikisi bo?&gt;&gt;<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Biturusu keleba nkye. &lt;&lt;Ee, yaa biya,&gt;&gt;</para>
  <para style="p" vid="MAT 17:25">De Biturusu yuru a siki gizi, Yesu na para yi beta, &lt;&lt;E minya nkye Biturusu, mina ki geni?&gt;&gt; &lt;&lt;Anya waa seleki durinya sua keleba gendu, anya ntani asu ko yaya bakwe?&gt;&gt;<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />&lt;&lt;Biturusu keleba nkye!&gt;&gt; Anya worosu su.</para>
  <para style="p" vid="MAT 17:26">&lt;&lt;Se Yesu gye yi nkye, yaya asu sua biya ba. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Sede kede mu yi ntani mu lepi ba. Te atotolo riki de kisa akurigya ake. Gunda de ki ka ni pari, bure baki yi ka geni toro daa, la de ki biya gendu Na nja na ku.&gt;&gt;<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Waa maa Tolense A siki A bisi</para>
  <para style="r">
    <ref loc="MRK 9:33-37">Mk 9.33-37</ref>; <ref loc="LUK 9:46-48">Lk 9.46-48</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Kwanki ni yayagizi Yesu zo anya e yi su minya yi, nkye, &lt;&lt;Waa ma tolense a solota gizi bisi?&gt;&gt;<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Yesu sukwa yaa dende zo sakisi a sisika asu. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Yesu gye su nkye, Na gye ku gaskye, nde ku shenja man kankye yaya dende mu ba, kwa yuru a solota gizi bisi ba. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Sobon yomu guru nsude la kiya yi ma mbodaa ba kankye yaa dende, e shiya yaa ma tolense a solota gizi bisi. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Guru nsude keleba yaa dende piri mu sobon seni na eni E ka e keleba.<verse eid="MAT 18:5" /></para>
  <para style="s">Gwada te Lepi</para>
  <para style="r">
    <ref loc="MRK 9:42-48">Mk 9.42-48</ref>; <ref loc="LUK 17:1">Lk 17.1</ref>,<ref loc="LUK 17:2">2</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />Sede guru nsude saa yaa dende daa a siki worede su yeda nja ni yi lepi, yaa pi yi kyawu de su domuna yi dunsi leda de su leyi kutiri ta siki andun totolo riki.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />&lt;&lt;Gbotu durinya de sua sa ntani sua yi lepi! e ma dole na mbo de yaa sa lepi e zo, sede gbetuma ni nsude yaa sa de paru anya yi! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Nde nani ko seni ake yaa sa de ki yi lepi, yanka yi kutiri. E pi kyawu de ka yuru a gizi Mirikisi nja nani kputuru nja de ka yuru a gizi wuta ni dindindin . <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Nde ndani ake yaa sakye de ka yi lepi, butu yi. E pi kyawu de ka yuru a gizi Mirikisi nja ndani daa, de ka yuru a siki wuta nja ndani bi.<verse eid="MAT 18:9" /></para>
  <para style="s">Abenshi Ni Timshiya De Beta</para>
  <para style="r">
    <ref loc="LUK 15:3-7">Lk 15.3-7</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Kone kede ku nene yaya dende worosu mu. Na gye ku meleku asu a siki bisi sua geni pisika Mirikisi adaa su kowon nana. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Yaa nsebeki zo na de e sila worede beta. <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />Mina ma tunani aku? Nde nsebeki mani timshiya deri, de daa a siki asu beeta, yaa bila teseyi ni tera de e te bila daa de beeta bo? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Nde e samu yi, Na gye ku gaskye, Yaa yi peri siki a kiya e yi pi teseyi ni tera worede su beta ba. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />E ma yomu la nja Adaa a bisi yaa bila de kede yaa dende daa e beta ba.<verse eid="MAT 18:14" /></para>
  <para style="s">Yayiwa De Yike Lepi</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Nde Yayiwa ake yike lepi, te de ki gye yi lepi yi. Sede e ma oku bi nja shi. Nde na e zi ke, ki kuman yayiwa ake zo anya ake. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Sede nde e zi ke ba, kuma de ki la nseda ko ntani bi de su te nja ke, Sobon de su ma sheeda ake, de guru beta de ka pala ntani bi ko wuku su ma ashina ake. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Nde e ki de e zi su, te de ki pala mbo de paru guru gye nsu biya Yesu; De ki gye yi, nde e zi beta ntani shoshi ba, bila yi ema kankye nsu biya boka nja nsu keleba gendu.<verse eid="MAT 18:17" /></para>
  <para style="s">Mbode Su ki nja Mbode su Yeda</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />&lt;&lt;Na gye ku gaskye, guru mbo de ku yeda a durinya Mirikisi yeda nshi a bisi, mbode ku ki a durinya Mirikisi yaa ki a bisi.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />&lt;&lt;Na sakye gye ku gaskye: Nde ntani bi yeda ni mbodaa a durinya de su yi lepa a kiya e yi, Adaa ku de e ma a siki bisi yaa yi ku nshi. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Guru anya de ntani bi ko wuku ma a siki e yi de su tala a siki seni na, Ni ma anya ni nja su.&gt;&gt;<verse eid="MAT 18:20" /></para>
  <para style="s">Abenshi A kiya Bunwa De ma toseyi ba</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Se Biturusu zo anya Yesu e minya yi nkye, &lt;&lt;Obagizi, senkwaa na yape yayiwa na lepi de yi ni? Sen bokwe?&gt;&gt;<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yesu keleba nkye, Sen bokwe aba, Sede sen bokwe bokwe sen Sebeyii,<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />&lt;&lt;Nkaa, solota ni bisi e ma kankye seleki de yaa bila kikiriga mbo nani e yi de e ma nja bunwa e yi. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />De Seleki para kiriga mbo de e ma nshi, se su keyi bunwa e yi daa de keleba basi gyolo ni dupu gom anya e yi. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Tunde bunwa yi e man gyolo de yaa biya ba, seleki pala nkye su leyi, ni mata yi, ni yaya yi nja mbo de e manshi guru see de su biya gyolo de e keleba. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />&lt;&lt;Se bunwa ni dunkye ni gunyam yi a geba seleki. &lt;Yi ni akuri,&gt; e pata yi, &lt;Na biya mbo guru de ni keleba anya ke, kwanki de ni samu. <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Seleki e zi toseyi yi, e yape yi guru mbo de e keleba anya bunwa yi se e bila yi te.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />&lt;&lt;Se nseminji mu butu a woze, e geni yayiwa bunwa daa de sua yi ANKI gabada de keleba basi gyolo dinari deri anya yi dun e kuma nshi beyi ba. &lt;E keyi wuya ariga nkye!&gt; biya ni gyolo de ki keleba anyana.&gt;<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />&lt;&lt;Yayiwa bunwa de sua yi ANKI gabada dudu dure agunyamu e yi e pata yi nkye, &lt;Yankuri ma ke nja ni, Na ba ke gyolo de ni keleba anya ake guru.&gt;<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />&lt;&lt;Sede bunwa ni ki. E keyi te kule a jaru, sede e biya yi guru bashi de keleba. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />De worosu bunwa de sua yi ANKI gabada geni mbo de paru, su zi anwashi su te gye seleki mbo de paru guru.<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />&lt;&lt;De Seleki sukwa bunwa ni ta siki. &lt;E gye yi nkye e ke mungu bunwa,&gt; &lt;Ni yape ke guru basi de ki keleba anyana, sobon de ki ologba ni nkye ni kadishiya. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Ashe e ke ma ka zi toseyi oboki ANKI ake nta yiride ni zi toseyi ake bo?&gt; <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />A siki anwashi nsugizi e pala nkye su keyi te sa a jaru de Genbeki, se kwanki de e biya guru basi de e keleba.<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />&lt;&lt;Se Yesu gye su nkye, yomu na Adaa na de ma a siki bisi yaa yi nja ku guru sede ku yape lepi yayiwa aku dege siki dishiya aku.&gt;&gt;<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Yesu Kokoyi A kiya Laba Amere</para>
  <para style="r">
    <ref loc="MRK 10:1-12">Mk 10.1-12</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />De Yesu gama pala mbo worosu mu e bila Galili ta kesa yawudiya a turiki de e ma gunduma totolo riki ni Yoda. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Ntani yowa su biya e yi, E worikye su guru suwo asu anya ni.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Woron su Parisiyawa su zo anya Yesu su minya yi nkye, &lt;&lt;Eman kyawu de nseminji e kula mata e yi a kiya kowon mbo de e paru?&gt;&gt;<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />&lt;&lt;Yesu minya su nkye,&gt;&gt; Ku karanta takada Mirikisi bo, de pala nkye dege pari de Mirikisi yi ntani, &lt;E yi nseminji nja mase,&gt; <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />e pala nkye, &lt;Sobon yomu nse Minzi yaa bila adaa yi nja amaa yi de e mala mata yi, sua ma bi gagaba sede sua ma ologba nki daa&gt;? <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Kuzukam su ma ntani bi gagaba, sede nse daa. Nkaa yomu mbode Mirikisi gama kede nsebeki e laba. <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />Parisiyawa su minya nkye, &lt;&lt;Mina sa&gt;&gt; de Musa beyi doka nkye nse minzi e ba mata e yi takada de e shika e yi?&gt;&gt;<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Yesu gye su nkye, &lt;&lt;Musa gye ku de ku kula mata aku sobon tori dishiya aku de kuman shi. e ma yomu na a pari ba. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Na gye ku nkye, guru nseminji de kula mata e yi, mba dun de e keyi kwana nja minzi nseda ba, du nsu amere mase ni, e yi lepi.&gt;&gt; <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />Yayagizi e yi gye yi nkye, &lt;&lt;Nde amere yaa ma yomu, e yi kyawu de mu yi amere ba.&gt;&gt; <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Yesu gye su nkye ba kowon se yaa yeda beta mu naba, sede nsu worosu de Mirikisi yeda su de su yi. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Worosu menza tunde Mirikisi yi su su ma kankye nse minzi ba, worosu su nsebeki na yi su, worosu su su yi nkyasu sobon de su gye ntani beta solota Mirikisi. Guru nsude yeda beta mu se la.<verse eid="MAT 19:12" /></para>
  <para style="s">Yesu sa Yaya Dende Anabirika</para>
  <para style="r">
    <ref loc="MRK 10:13-16">Mk 10.13-16</ref>; <ref loc="LUK 18:15-17">Lk 18.15-17</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Se ntani kwa yi yaya dende zo de Yesu e sa su nani de yi su lepa. Se yayagizi yi kwabe nsu worede su zo yaya dende. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Yesu gye su nkye, &lt;&lt;Ku bila yaya dende de su zo anya na, kede ku nana su ba, gizi Mirikisi e ma ni worede su ma kankye yaya dende.&gt;&gt; <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />De Yesu sa nani anabirika a kiya su, se e dege bila anya ni te ma yi.<verse eid="MAT 19:15" /></para>
  <para style="s">Yaa Sambari Nsu Mbo A nani</para>
  <para style="r">
    <ref loc="MRK 10:17-31">Mk 10.17-31</ref>; <ref loc="LUK 18:18-30">Lk 18.18-30</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Kuzukam nseminji daa zo anya Yesu e minya nkye, &lt;&lt;Male, mina kyakyawu Na yi de Na samu leyi ni dindindin?&gt;&gt; <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />&lt;&lt;Yesu gye yi nkye! Mina sa de ka minya ni beta a kiya nsude e man kyakyawu?&gt;&gt; &lt;&lt;Nse daa e man kyakyawu ba se Mirikisi. Sede ki biya Mbode doka pala&gt;&gt; Mirikisi e shiya sakye de ka man leyi ni dindindin.<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />&lt;&lt;Nse minzi ni minya Yesu nkye doka wona?&gt;&gt;</para>
  <para style="p" vid="MAT 19:18">Yesu gye yi nkye kede ki kisa nse ba, &lt;&lt;&lt;Kede ki kwana nja mata nseda ba, kede ki yi bolowa ba, kede ki beyi sheeda yaruwa ba. <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />Ki ba Adaa ake nja Amaa ake girima,&gt; nja de &lt;Ki so dengeri ake yiride ka so kiya ake.&gt;&gt;&gt; <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />&lt;&lt;Yaa sambari ni pala nkye Ni yi mbo guru de ka pala mu. Mina kwa rigye de na yi?&gt;&gt; <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />Yesu pala gye yi nkye, &lt;&lt;Nde ka so de ki ma kyakya, te, la mbo guru de ki ma shi see de ki laba ba potoruwa, tukuna ka mani mbo nani ake a bisi. se ki zo biya ni.&gt;&gt;<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />De yaa sambari mu zi mbode Yesu pala, e yi anwashi te ma yi, sobon e mani mbo nani nyowa. <verse eid="MAT 19:22" /><verse number="23" style="v" sid="MAT 19:23" />Se Yesu gye yayagizi e yi nkye, &lt;&lt;Na gye ku gaskye, e man Genbeki de nsu mbo nani nyowa e yuru a solota gizi bisi. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Ku zi Na sakye gye ku, e pi de nakurimi a biya ndani ni aromuna de nsu nani e yuru a solota ni Mirikisi.&gt;&gt;<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />De yayagizi e yi su zi beta de e pala, su yi mamanki nyowa, Su pala nkye, nde yaa ma yomu, &lt;&lt;Se waa na yaa sila?&gt;&gt;<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />De Yesu zi kone su nkye, &lt;&lt;Anya nsebeki e man wuya, sede anya Mirikisi e man wuya ba.&gt;&gt;<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Biturusu pala nkye. Ki shina ma ke nta, &lt;&lt;Mu bila mbo guru mua biya ke! Omu de mua biya ke Minana mua samu?&gt;&gt;<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Yesu gye su nkye, Na gye ku gaskye, a kwanki de yaa zo gyala guru mbo, Yaa nsebeki yaa zunwa a kingbolo solota yi nsu dereja a sabuwa sana. Oku worede ku biya ni kwa zunwa a kingbolo solota gom, de ku yi shiriya nja gizi ni Izireyila gom sha bi. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Guru nsude bila gizi yi, ko yayiwa yi menza ko mata, ko Adaa yi ko Amaa yi, ko mata yi ko yaya yi, ko bikiya yi sobon eni yaa keleba nani wuta sen deri nja leyi ni dindindin. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Sede nsu worede su ma pari sua zo ma karishe worede su ma karishe sua zo ma pari.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Nsu Yanki A bikiya Ntasi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />&lt;&lt;Yesu gye su nkye solota gizi Mirikisi e ma kankye nsu gizi de e butu mbaki nsape yaa bila nsu worede sua yi yanki a bikiya ni ntasi inebi e yi. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />E yeda de e biya su gyolo dinari ni yanki nana daa se e gye su de su te a bikiya e yi. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />De keripi tera yi e butu e geni woron su sakisi abije mani yanki mbodaa ni yi ba. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />E gye su nkye, &lt;Oku ma Ku te yi ANKI a bikiya na, de ni biya ku mbo de ma dede.&gt;<verse eid="MAT 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 20:5" />Se su te.</para>
  <para style="p" vid="MAT 20:5">E kwa sakye butu beyi keripi gom sha bi nja keripi wuku e kwala worosu de su te yanki a bikiya yi. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />De keripi biyari ni nyema yi e butu san worosu sakisi sua yi yanki mbodaa ba. E minya su nkye, &lt;Mina na sa ku de ku sakisi anya mu nana da mani yanki mbodaa ni yi ba?&gt;<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />Su keleba yi nkye. &lt;&lt; &lt;Sobon de nse daa la mu yanki ba,&gt;</para>
  <para style="p" vid="MAT 20:7">&lt;&lt;E gye su nkye, &lt;Oku ma ku te de ku yi yanki a bikiya na.&gt;<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />&lt;&lt;De nyema yi, nsu bikiya gye nsu de yaa kone bikiya e yi, &lt;Sukwa nsu worede sua yi yanki de ki biya su gyolo asu, para nja nsu worede su zo a beyi kami de kaa baa nsu worede zo pari.&gt;<verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />&lt;&lt;Nsu ANKI de zo keripi biyari su zo guru su keleba gyolo ni ANKI asu. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />De worede su la su zo ni pari, sua sa dishiya nkye sua keleba gyolo pi yomu. Sede guru asu su keleba kyakya. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />De su keleba gyolo asu, su para mungu beta nja nsu bikiya. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />Su nkye, &lt;worede su zo a beyi su yi yanki ni keripi daa,&gt; &lt;Ki ba su gyolo kyakya nja mu de muma yi yanki a siki dimi de nana si mu,&gt;<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />&lt;&lt;Sede e keleba da a siki asu, &lt;Oboki na, Ni shushe ke ba. Ki yeda de ka yi yanki a kiya gyolo dinari daa na bo? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Keleba gyolo e ke de ki te. Na so de ni ba nsu worede ni la su a beyi nta yiri de ni ba ke. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />E ni Ni man dama de na yi mbo kyakyawu ni gyolo na bo? Ko kaa zi anwashi na de ni man mbo nani nyowa?&gt;<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />&lt;&lt;Sobon yomu ni karishe sua ma ni pari, ni pari sua ma ni karishe.&gt;&gt;<verse eid="MAT 20:16" /></para>
  <para style="s1">Yesu sakye yi beta a kiya muntu e yi ni son Wuku</para>
  <para style="r">
    <ref loc="MRK 10:32-34">Mk 10.32-34</ref>; <ref loc="LUK 18:31-34">Lk 18.31-34</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Se Kuzukam Yesu yaa bise te ni Wurishelima, e la yayagizi yi gom sha bi ta keteri e gye su nkye, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />&lt;&lt; Ku zi, Mua te a Wurishelima, sua la Yaa nsebeki ba toree ni pirisi nja male ni doka Musa. Sua sa yi de e muntu <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />sua leyi beyi ba nsu worede su shina Mirikisi ba, de su yi siya nja sua yi amberemu nja sua gidiri yi. Nana ni wuku yaa dege nleyi!&gt;&gt;<verse eid="MAT 20:19" /></para>
  <para style="s1">Amaa yi Pata</para>
  <para style="r">
    <ref loc="MRK 10:35-45">Mk 10.35-45</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Amaa ni yaya Zabedi zo anya ni Yesu nja yaya e yi, e dunkye a kisi, yaa ologba yi nkye.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />E minya nkye, &lt;&lt;Minana ka so?&gt;&gt;</para>
  <para style="p" vid="MAT 20:21">&lt;&lt;Yeda de yaya na bi mu su zunwa daa a nani dama ake nja daa e zunwa a nani guni a gizi solota ake.&gt;&gt; <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />Yesu gye su nkye &lt;&lt;Ku shina mbo de kwa minya ba,&gt;&gt; . &lt;&lt;Kwa yi yaa sha Genbeki de na sha?&gt;&gt;</para>
  <para style="p" vid="MAT 20:22">&lt;&lt;Su keleba nkye&gt;&gt; Mua yi yaa.<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Yesu gye su nkye, &lt;&lt;Gaskye kwa yi yaa sha Genbeki, sede ku zunwa adama ko aguni na e ni na ni man nsu beyi ba. Adaa na ni bisi e shina yaa ba worede e gyala sobon osu.&gt;&gt; <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />De yayagizi e yi gom su zi mbo de pala, su zi anwashi nja yayiwa su bi worosu ni. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Se Yesu sukwa su guru anya daa kaka e pala nkye, &lt;&lt;Ku shina nkye toree ni nsu worede su shina Mirikisi ba ntani asu Genbeki, nja girima su. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Kede e ma yomu a sisika ku ba, guru nsu de yaa so e ma tolense a siki aku se dole e ma bunwa ni woron su, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Nja nsude yaa bila de ema ni pari dole ema bunwa aku, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />nta yiri de Yaa nsebeki e zo de su yi bowuta naba, sede e shi e bowuta su, nja de beyi leyi yi amomoko ntani nyowa.&gt;&gt;<verse eid="MAT 20:28" /></para>
  <para style="s1">Makapi menza bi sua geni anya</para>
  <para style="r">
    <ref loc="MRK 10:46-52">Mk 10.46-52</ref>; <ref loc="LUK 18:35-43">Lk 18.35-43</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />De Yesu nja yayagizi e yi sua bila Yeriko, ntani nyowa su biya yi. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Makapi ntani bi su zunwa a keteri turiki, de su zi nkye Yesu yaa bise, su sukwa Yesu nsori su ma nkye, &lt;&lt;Obagizi, Yaa ni Dowuda, ki zi toseyi amu!&gt;&gt;<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Ntani nyowa su yi su rikishi su gye su nkye su yi shuru, sede su ja murinya nyowa, su ma nkye, &lt;&lt;Obagizi, Yaa ni Dowuda, ki zi toseyi amu!&gt;&gt;<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Yesu sakisi sukwa su. &lt;&lt;Minana kwa bila de Ni yi ku nshi?&gt;&gt; Yesu minya su.<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />&lt;&lt;Su keleba nkye,&gt;&gt; Obagizi, &lt;&lt;Mua bilade mu sakye geni.&gt;&gt;<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Yesu zi toseyi asu e kpa ndani asu. dandani ndani asu bure su ma geni se su biya Yesu.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">Yesu Yuru A Wurishelima</para>
  <para style="r">
    <ref loc="MRK 11:1-11">Mk 11.1-11</ref>; <ref loc="LUK 19:28-40">Lk 19.28-40</ref>; <ref loc="JHN 12:12-19">Jn 12.12-19</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />De Yesu nja yayagizi e yi su kusa nja Wurishelima su keyi Betapaji a ntasi ni Zetu, Yesu saka yayagizi e yi bi, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />Yesu gye su nkye, &lt;&lt;Ku te a geri dende de ma a geba aku, anya ni kwa geni janki domuna nja yaa a keteri e yi. Ku konse su de ku ka yi ni nshi. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Nde nse daa yi ku beta, ku gye yi nkye Obagizi yaa so su, yaa saka nja shi anjima.&gt;&gt;<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Mbo mu paru de e sika beta de pala a baki ni Anebi:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />&lt;&lt;Gye yaya mata ni Siyona,</para>
  <para style="q2" vid="MAT 21:5">&lt;Geni, seleki aku yaa zo anya ku,</para>
  <para style="q1" vid="MAT 21:5">&lt;&lt;Nsu dishiya din, yaa yi tepiya a kiya janki,</para>
  <para style="q2" vid="MAT 21:5">a kiya dende ni janki na yaa yi tepiya.&gt;&gt;<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Yayagizi e yi su te yi yiride de Yesu ba su doka nkye su yi. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Su ka yi janki nja dende e yi zo, susa su keyi asu, Yesu e zunwa a kiya asu. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Ntani nyowa su tona keikei asu a turiki, woron su watala yaya nani ntasi gima tona a turiki. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Ntani de su ma a geba e yi nja worede sua biya yi a beyi su yi kuruwa nkye, &lt;&lt;Osana te ni Yaa Dowuda!&gt;&gt; &lt;&lt;Anabirika ma nja yaa ni nsu de zo a seni ni Obagizi!&gt;&gt; &lt;&lt;Osana ma nja nsude pi girima!&gt;&gt;<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />De Yesu yuru a Wurishelima, Guru totolo geri su nyanji su minya nkye, &lt;&lt;Da mu ma waa?&gt;&gt; <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Yowa ntani keleba, &lt;&lt;E ma Yesu, Anebi butu a Nazare ni Galili.&gt;&gt;<verse eid="MAT 21:11" /></para>
  <para style="s1">Yesu ta Laki Mirikisi</para>
  <para style="r">
    <ref loc="MRK 11:15-19">Mk 11.15-19</ref>; <ref loc="LUK 19:45-48">Lk 19.45-48</ref>; <ref loc="JHN 2:13-22">Jn 2.13-22</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />De Yesu yuru anya gizi Mirikisi e kula guru nsu worede sua see keyi nja nsu worede sua la keyi see nja nsu see keyi anya ni butu a woze. E juyi kingbolo ni nsu beyi gyolo ni riba nja bensi ni nsu sa yi ni tatambiri. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />&lt;&lt;E gye su nkye,&gt;&gt; Su rubuta yi a siki takada doka, &lt;&lt; &lt;Gizi na sua sukwa yi nkye gizi lepa,&gt; Se mala yi yi de ma &lt;Gizi nsu bolowa.&gt; &gt;&gt;<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Ntani makapi nja gurugu zo anya yi a gizi Mirikisi, e worikye su. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Sede totolo ni pirisi nja male ni doka geni mbo mamanki de Yesu e yi yaya dende sua yi kuruwa anya ni gizi Mirikisi, &lt;&lt;Osana ma Yaa ni Dowuda,&gt;&gt; su zi anwashi.<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />&lt;&lt;Ki zi mbo de yaya dende mu sua pala?&gt;&gt; Su minya Yesu.</para>
  <para style="p" vid="MAT 21:16">Yesu keleba nkye, &lt;&lt;EE&gt;&gt; Ki taba karanta takada Mirikisi bo?</para>
  <para style="q1" vid="MAT 21:16">&lt;&lt;&lt;A baki ni yaya nja yaya dende</para>
  <para style="q2" vid="MAT 21:16">yaa sa de ki yobo Mirikisi.<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Anya ni e bila su e butu bila totolo geri ni ta Betani, anya de e kwana.<verse eid="MAT 21:17" /></para>
  <para style="s">Yesu sa Ntasi Bori kyekeri</para>
  <para style="r">
    <ref loc="MRK 11:12-14">Mk 11.12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Mbaki nsape, de e ma turiki ni kuma ta totolo geri, e zi nyunwa. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />E geni ntasi bori sakisi a keteri turiki, e te anya e yi sede e samu yaya a siki e yi ba se genya. Se e gye ntasi bori nkye, &lt;&lt;Ka sakye yi yaya gagaba!&gt;&gt; Dandani ntasi bori kyekeri.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />De yayagizi e yi su geni mbo de paru, su yi mamanki. Su minya Yesu.&lt;&lt;Mina sa de ntasi bori kyekeri seberi yomu?&gt;&gt;<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Yesu keleba gye su nkye, &lt;&lt;Na gye ku gaskye, nde ku beigaskye de ku laba dishiya bi ba, mbo de paru ni ntasi bori mu kina kwa yi ba, sede kwa gye totolo dunsi, &lt;Te, gizi nkye ake a siki totolo riki,&gt; Yaa kwa zi ku. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Nde ku beigaskye, kwa keleba guru mbo de ki minya a siki ni lepa.&gt;&gt;<verse eid="MAT 21:22" /></para>
  <para style="s1">Su Minya Yesu Beta A kiya Yiko</para>
  <para style="r">
    <ref loc="MRK 11:27-33">Mk 11.27-33</ref>; <ref loc="LUK 20:1-8">Lk 20.1-8</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />De Yesu yuru a siki gizi Mirikisi, de, yaa kokoyi, tolense pirisi nja toree ni ntani zo anya yi. &lt;&lt;Woni sori na ka yi mbo mu nja shi?&gt;&gt; Su minya yi. &lt;&lt;Kuma waa ba ke sori mu?&gt;&gt;<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yesu keleba su, &lt;&lt;Eni ma na minya ku beta daa. Nde ku keleba ni, E ni ma Na gye ku woni sori Ni ma yi mbo mu nja shi. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Yaaya nsu yi tunkwasa butu angana zo? E butu a bisi ko anya nse beki la?&gt;&gt;</para>
  <para style="p" vid="MAT 21:25">Su yi musu nja nkyasu nkye, &lt;&lt;Nde mu nkye, &lt;E butu a bisi,&gt; Yaa minya, &lt;Mina sa de mu yeda nja shi ba?&gt; <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Sede nde mu nkye, &lt;Dege anya nsebeki&gt; Mua zi womba ni ntani, nkaa guru su shina Yaaya e ma anebi la.&gt;&gt;<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Se su keleba Yesu, &lt;&lt;Mu shina ba.&gt;&gt;</para>
  <para style="p" vid="MAT 21:27">Se Nkye, &lt;&lt;Eni ma Na gye ku sori dawa na yi mbo mu nja shi ba.&gt;&gt;<verse eid="MAT 21:27" /></para>
  <para style="s">Abenshi Ni Yaya bi</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />&lt;&lt;Se Yesu gye toree Parisiyawa nkye mina ma tunani aku? Nseminji daa man yaya bi. E te anya ni pari nkye, &lt;Yaa naa ta bikiya yawu de ki te yi ANKI.&gt;<verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />Yaa ni pari keleba nkye, &lt;&lt;&lt;Na te ba,&gt; Sede karishe e shenja dishiya e yi e te.<verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />&lt;&lt;Se Adaa su te anya ni yaa ni bi e gye yi mbo de e pala gye yaa ni pari. E keleba, &lt;Na te, Adaa,&gt; Sede e te ba.<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />&lt;&lt;Waa a siki yaya bi worosu mu yi mbo de Adaa asu yaa so?&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">Su keleba nkye, &lt;&lt;Ni pari&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">Yesu gye su nkye, &lt;&lt;Na gye ku gaskye, nsu keleba gendu nja ki laki sua rigye ku yuru a gizi Mirikisi. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Bila ngye ku, Yaaya zo de e nana ku turiki gangasi, ku yeda nja shi ba, sede nsu keleba gendu nja ki laki su keleba Yi. De ku geni mbo mu ku shenja dishiya de ku yeda nja Mirikisi ba.<verse eid="MAT 21:32" /></para>
  <para style="s1">Abenshi A kiya nsu Keleba Bikiya Ni Aya</para>
  <para style="r">
    <ref loc="MRK 12:1-12">Mk 12.1-12</ref>; <ref loc="LUK 20:9-19">Lk 20.9-19</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />&lt;&lt;Ku zi kokongye da jaja: nse daa de man bikiya e nunkwa saba ntasi inebi. E yi golonwa gyowe yi, E yanka anya de sua tapi riki yaya ntasi inebi e gina laki nsu de yaa kone bikiya e yi. Se e la bikiya yi ba worosu nsu yi bikiya se e te ma yi atepiya. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />De kwanki yanki bikiya yi, e saka bunwa e yi manki anya nsu worosu de keleba bikiya e yi ni aya de su beyi yaya ntasi.<verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />&lt;&lt;Nsu worede keleba bikiya anya yi su ka bunwa yi woroni; su doka nse daa, su kisa nse daa, su kutiri worosu su dunsi ari su muntu. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Se e saka worosu su bunwa de su pi ni pari, su yi su yiri mbode su yi nsu pari. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Ni karishe, e saka yaa yi anya su. &lt;E pala nkye,&gt; Sua ba yaa na girima.<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />&lt;&lt;Sede nsu keleba bikiya aya su geni yaa yi, su gyen nkyasu, &lt;To nsu de yaa si gado bikiya aka. Ku zo de mu kisa yi de mu la gado mu maana mu.&gt; <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Se su leyi kutiri a beyi golonwa ni bikiya ntasi su kisa yi.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />&lt;&lt;Too, nde nsu bikiya zo, mina yaa yi nja nsu worede keleba aya ni bikiya e yi?&gt;&gt;<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />&lt;&lt;Su gye yi nkye, yaa kwa yi mungu ate kisa de e geni mungu asu,&gt;&gt; &lt;&lt;Yaala bikiya e yi ba woron nsu aya, de sua beyi na yi kwanki de sua yi yanki mbo su nyunkwa a bikiya e yi.&gt;&gt;<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yesu gye su nkye, &lt;&lt;Ku taba karanta takada beta Mirikisi bo?</para>
  <para style="q1" vid="MAT 21:42">&lt;&lt;&lt;Dunsi de nsu gini ki yi</para>
  <para style="q2" vid="MAT 21:42">e shiya ma dunsi de sua saa a keteri kyakyawu;</para>
  <para style="q1" vid="MAT 21:42">Obagizi yi yomu,</para>
  <para style="q2" vid="MAT 21:42">ema mbo mamanki la a ndani amu&gt;?<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />&lt;&lt;Nkaa yomu Na gye ku sua keleba solota gizi bisi anya ku sua la ba worede sua yaya ni mbo gangasi de Mirikisi yaa so. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Nsude e puari a kiya dunsi mu yaa watala piripiri, se nsu de dunsi puari a kiya e yi yaa leda yi ka nkye atuwa.&gt;&gt;<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />De tolense ni pirisi nja parisiyawa su zi kokongye Yesu, su shina nkye yaa yi beta nja su. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Sua bila turiki de su ka yi. Sede sua yi womba yowa ntani, de su leyi nkye Yesu e ma Anebi la.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s1">Abenshi Ni Buki Amere</para>
  <para style="r">
    <ref loc="LUK 14:15-24">Lk 14.15-24</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yesu sakye yi su beta ni kokongye nkye: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />&lt;&lt;Gizi bisi e ma ka nkye seleki de shiriya buki amere ba yaa yi. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Seleki saka bunwa e yi nkye e te de e sukwa guru worede e ba su manki de su zo ayan buki, sede su ki de su zo.<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />&lt;&lt;Se e saka worosu su bunwa yi nyowa nkye, &lt;Gye worede ni ba su manki de su zo ni shiriya mbosi ni nana: Ni yanka saa totolo su pendeyi, mbo guru ema shiri. Ku zo anya buki ni amere yaa na.&gt;<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />&lt;&lt;Sede ntani su kula nja su ba kowon nse daa ta bikiya e yi, nse daa ta anya bize e yi. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Se woron su kaa bunwa e yi, su dukwa su ari su kisa su. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Seleki yi anwashi nyowa. E saka shoja e yi de su kisa nsu worede de su kisa bunwa e yi de su juru su totolo geri asu guru.<verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />&lt;&lt;Se nseminji ni gye bunwa e yi, &lt;Ni shiriya Buki amere wo, sede nsu worede ni gesu su deta de sua zo ba. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Ku te guru a turiki turiki de ku sukwa guru nsu de ku geni de su zo anya buki amere.&gt; <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Se bunwa yi butu a woze te a turiki turiki guru ntani de su samu, ni kyakyawu ni mumungu, se kolonwa buki sika nja bakwe.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />&lt;&lt;Sede de seleki zo a siki de e geni bakwe, e geni nse minzi daa de e sa keyi buki ba. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />&lt;Oboki,&gt; e minya, &lt;ki yi yaya na ki yuru anya mu de kisa keyi buki ba?&gt; nse minzi ni shina beta de yaa pala ba.<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />&lt;&lt;Se seleki gye nsu bunwa nkye, &lt;Ku domuna yi nani nja seni, de ku kutiri yi ta woze, a siki dopuwa, anya de sua yi kuka nja suku ankuri.&gt;<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />Se Yesu gama nkye, &lt;&lt;Su sukwa ntani nyowa, sede su zabi piri na a siki su.&gt;&gt;<verse eid="MAT 22:14" /></para>
  <para style="s">Minya Beta A kiya Biya Gendu</para>
  <para style="r">
    <ref loc="MRK 12:13-17">Mk 12.13-17</ref>; <ref loc="LUK 20:20-26">Lk 20.20-26</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Se Parisiyawa te a woze su yi shiri saa toroko de su keyi a kiya beta de yaa pala. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Su saka yayagizi su nja woron su ntani ni Yirudiya, Su nkye, &lt;&lt;Male&gt;&gt; Mu shina ki ma nsu pala gaskye la ka kokoyi beta Mirikisi dede ni gaskye. Ka mala nsebeki ba, sobon kaba su ankeli de kishi na ko waa ma osu ba. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Gye mu, e man kyawu de mu biya gendu ba Kesa ko yi?<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Sede Yesu, shina mungu de ma dishiya asu, nkye, &lt;&lt;Oku munabuki, mina sa de kwa sa toroko de e ka ni? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Ku nana ni gyolo de kwa yi anpani ni biya gendu.&gt;&gt; Se Su keyi gyolo dinari daa, <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />se e minya su nkye, &lt;&lt;Woto ni waa ko pisika waa ma damu?&gt;&gt;<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />&lt;&lt;Su keleba nkye,&gt;&gt; Ni Kesa.</para>
  <para style="p" vid="MAT 22:21">Se Yesu gye su nkye, &lt;&lt;Ku ba Keisa mbode mani Keisa, nja mbode mani Mirikisi ku ba Mirikisi.&gt;&gt;<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />De Parisiyawa su zi yomu, su yi mamanki. Se su bila yi te ma yi.<verse eid="MAT 22:22" /></para>
  <para style="s1">Minya Beta A kiya Dege A kumsha</para>
  <para style="r">
    <ref loc="MRK 12:18-27">Mk 12.18-27</ref>; <ref loc="LUK 20:27-40">Lk 20.27-40</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Nana ni ntani sadokiyawa, de su yeda ni dege a kumsha ba, su zo anya Yesu su minya yi. <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />Su nkye, &lt;&lt;Male,&gt;&gt; &lt;&lt;Musa gye mu nkye nde nseminji muntu de e man yaya ba, dole yayiwa e yi e bila mata e yi de e yapu yaya beyi. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Kuzukam su yi yayuwa bokwe a siki amu. Ni pari e yi amere e la muntu, e man yaya ba, e bila mata yi ba yayiwa e yi. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Yomuna mbode e sa yayiwa yi ni bi nja yayiwa yi ni wuku, e kwa paru ni guru yayuwa yi bokwe su la muntu. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Karishe, mase ni muntu. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Kuzukam, kwanki de worede muntu sua dege, sede mata waa a siki asu bokwe mu, sobon guru asu su yi amere nja shi?&gt;&gt;<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yesu keleba nkye, &lt;&lt;Ku yi tunani dede ba sobon de ku shina takada ko sori beta mirikisi ba. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Kwanki de nsu muntu sua dege ntani sua yi amere ko su beyi mase ni amere ba; sede ntani sua ma kankye meleku Mirikisi. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Sede a kiya dege ni nsu muntu ku karanta mbode Mirikisi pala gye ku ba, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />&lt;Eni ma Mirikisi ni Abireyi, Mirikisi Ishaku, nja Mirikisi ni Yakubu&gt;? E ma Mirikisi ni muntu kede aba sede Mirikisi ni worede su ma leyi du.&gt;&gt;<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />De ntani nyowa zi mbode Yesu pala mu, su yi mamanki ni mbode E kokoyi su.<verse eid="MAT 22:33" /></para>
  <para style="s">Totolo Doka</para>
  <para style="r">
    <ref loc="MRK 12:28-34">Mk 12.28-34</ref>; <ref loc="LUK 10:25-28">Lk 10.25-28</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />De Parisiyawa zi mbo de Yesu gye Sadokiyawa, se su yi beta gagaba. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Se daa a siki male doka ni Musa, gwada yi nja beta:<verse eid="MAT 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 22:36" />&lt;&lt;Male, doka waa na pi girima a siki doka de ki beyi?&gt;&gt; <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Yesu gye su nkye: &lt;&lt;&lt;So Obagizi Mirikisi nja guru dishiya ake nja guru leyi ake nja guru ankeli ake.&gt; <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Da mu e shiya ma pari nja totolo a siki doka. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Se ni bi e ma yomu: &lt;Ki so degeri ake ka nkye kiya ake.&gt; <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Guru doka ni Musa nja ni nsu anebi e ma a kiya doka bi la.&gt;&gt;<verse eid="MAT 22:40" /></para>
  <para style="s">Minya Beta A kiya Waa ma Yesu</para>
  <para style="r">
    <ref loc="MRK 12:35-37">Mk 12.35-37</ref>; <ref loc="LUK 20:41-44">Lk 20.41-44</ref></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />To de Parisiyawa su tala anya daa, Yesu minya su, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />&lt;&lt;Mina ma tunani aku a kiya Kiristi? E ma Yaa ni waa?&gt;&gt;</para>
  <para style="p" vid="MAT 22:42">Su pala nkye, &lt;&lt;Yaa ni Dowuda.&gt;&gt;<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Yesu gye su nkye, &lt;&lt;Mina sa de Dowuda, yaa yi beta sobon ni sori Aworo Mirikisi, yaa sukwa yi nkye, &lt;Obagizi&gt;?<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />&lt;&lt;&lt;Obagizi pala gye Obagizi na:</para>
  <para style="q2" vid="MAT 22:44">&lt;&lt;Zunwa a nani dama na</para>
  <para style="q1" vid="MAT 22:44">Se ni sa obokigeba ake</para>
  <para style="q2" vid="MAT 22:44">A kisi seni ake.&gt;&gt;&gt;<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Nde Dowuda sukwa Yesu &lt;Obagizi,&gt; yaya na yaa ma yaa yi?&gt;&gt; <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Nse daa pala kelima gye yi gagaba, dege a nana ni tageba nse daa sakye minya yi beta jaja gaba.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Yesu Biriza Asiri Toree Susupe Anikowori nja Parisiyawa</para>
  <para style="r">
    <ref loc="MRK 12:38">Mk 12.38</ref>,<ref loc="MRK 12:39">39</ref>; <ref loc="LUK 11:43">Lk 11.43</ref>,<ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45">20.45</ref>,<ref loc="LUK 20:46">46</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Se Yesu gye yowa ntani nja yayagizi yi nkye. <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />&lt;&lt;Male ni kokoyi doka Musa, nja parisiyawa su zunwa a kingbolo ni Musa.&gt; <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Sobon yomu dole ku ba su girima de ku biya guru mbode su gye ku nkye ku yi. Sede kede ku yi mbode su ma yi, sobon su ma yi mbode doka Musa pala ba. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Sua domuna ka yi nsu loni nja Genbeki la ja ntani a kiya, sede osu sua ko kpa yaa nani asu de su sua su to ni la keyi ni ba.<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />&lt;&lt;Guru mbode sua yi, sua yi de ntani su geni su. Kone lendee asu eman beta Mirikisi a siki yi de su la domuna agan asu, kone yiri girima de e sonka ari gunyam; <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Sua so de su ba su girima anya buki nja zunwa kingbolo nsu girima a siki kolonwa; <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />sua so de su geshe su nja bayi girima a siki bije, de ntani su sukwa su &lt;Male,&gt;<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />&lt;&lt;Sede e yi kyawu de su sukwa ku &lt;Male ba,&gt; sobon kuma male daa na se guru aku kuma yayiwa nkyaku na. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Kede ku sukwa nseda a durinya mu &lt;Adaa ba&gt;, sobon kuma ni Adaa daa na, nsude e ma a siki bisi. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Kede oku ma su sukwa aku &lt;Male ba&gt;, sobon kuma male daa de e ma Yesu kiristi. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Nsu de e ma tolense a siki aku dole e ma bunwa aku. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Guru nsude e la kiya e yi e ma tolense Mirikisi yaa kuman shi ma yaa dende, nsude e la kiya yi e ma yaa dende, Mirikisi yaa sa yi ma tolense.<verse eid="MAT 23:12" /></para>
  <para style="s">Yesu Bebeta Anki Geni Ndani</para>
  <para style="r">
    <ref loc="MRK 12:40">Mk 12.40</ref>; <ref loc="LUK 11:39-42">Lk 11.39-42</ref>,<ref loc="LUK 11:44">44</ref>,<ref loc="LUK 11:52">52</ref>; <ref loc="LUK 20:47">20.47</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Gbotuma aku, male ni doka Musa nja ntani parisiyawa, Munabuki! Ku ripe turiki solota ni bisi a pisika ni ntani, oku nkyaku ku yuru ba, ku bila worosu de sua yi kokori yuru de su yuru ba. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Gbotuma aku, male ni doka Musa nja parisiyawa, munabuki! Kwa si keyi mata makeyi nja yi nyisa lepa! dun su geni ku. nkaa yomu sua yi ku poro nyowa.<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />&lt;&lt;Gbotuma aku, male ni doka Musa nja parisiyawa, Munabuki! Kuma tepiya yenteri totolo riki nja kesa kwa juyi nseda de ema daa ku; nde ema daa ku, kwa sayi de ema yaa wuta yiride ku ma.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />&lt;&lt;Gbotuma aku, nsu jaa makapi! Ku kokoyi nkye, &lt;Nde nseda melese ni laki Mirikisi, ema mbodaa ba; sede nde e melese ni zinari de ma a siki laki ni Mirikisi, dole la melese sakisi.&gt; <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Eke makapi Odundu! Mina pi kyawu, zinari na ko laki Mirikisi de sa zinari ma nsuseki? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Ku kwa nkye, &lt;Nde nse daa melese ni bagedi ni Mirikisi, melese yi keyi ema mbo daa ba; sede nde e melese ni kyawuta de ma kiya anya sedeka ni Mirikisi, dole la melese sakisi.&gt; <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Oku makapi ntani! Mina e pi kyawu, sedeka ko bagedi ni Mirikisi de sa sedeka ma nsuseki? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Nkaa yomu, nsu de melese nja bagedi ni Mirikisi, e melese nshi na nja kuma guru sedeka de ma a kiya e yi. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Nja Nsu de melese ni laki Mirikisi, e melese ni Mirikisi nja mbode ma a siki e yi. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Du nsude melese ni bisi e melese ni kingbolo solota Mirikisi nja Mirikisi de zuzunwa a kiya e yi.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />&lt;&lt;Gbotuma aku, Male ni doka Musa nja parisiyawa, Munabuki! Kuma ba Mirikisi sedeka daa a siki gom ni keyi bikiya aku, genya ni yaji nja otoruwa, sede ku ki mbode pi kyawu a siki doka shiriya, toseyi, gaskye nja aminshi. E man kyawu de ku kokoyi yiri mbo woromu na e yi kyawu de ku yi su, kede ku bila su ba. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Oku nsu jaa makapi! Kuma tasi oshunsho, sede kuma sherenka nakurimi.<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />&lt;&lt;Gbotuma aku, Male doka Musa nja parisiyawa, munabuki! Kuma kankye nsu wonkye beyi ni koshiya nja gongo, sede siki e yi mani sere ba. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Makapi parisiyawa! Ku shire siki ni koshiya nja gongo tuku, de woze yi ma sere du.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />&lt;&lt;Gbotuma aku, male doka Musa nja parisiyawa, munabuki! Kwa yi kankye kumsha de su shapa peri penti, de su gyala woze yi sere, sede siki siki yi ema zala keshi ntani nja rurubu nki gan de ma sere ba. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Yomu na oku ma, ntani ma kone ku nta kuma ntani gangasi na, sede a siki dishiya aku sika ni munabuki nja mungu mbo.<verse eid="MAT 23:28" /></para>
  <para style="s">Yesu Pala yi poro su</para>
  <para style="r">
    <ref loc="LUK 11:47-51">Lk 11.47-51</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />&lt;&lt;Gbotuma aku, male doka Musa nja parisiyawa, munabuki! Kuma gyala kumsha kyakyawu sobon anebi kuma gyala anya bishina nsu gangasi tunde suman leyi. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Ku nkye, &lt;Daa su nkye muma a kwanki ni nsu adaatolo amu, de mua yada nani ni kisa nsu anebi.&gt; <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Kuzukam ku beyi sheeda kuma yaya ni worede su kisa anebi la. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Ku sika, se, gongo ni lepi ni nsu adaatolo aku su yi!<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />&lt;&lt;Oku mesi! Oku yaya ogbozi! Kwa yi yaya na de kwa yuru a poro gizi wuta ba? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Nkaa yomu Na saka ku anebi, nja nsu simi, nja male. Kwa kisa worosu asu kwa lete worosu a bisi ni gidiri, kwa yi worosu asu amberemu a siki kolonwa aku nja kula su dege geri da ta geri da. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Na saka ntani mu ni a laki ni zini nsu ntani gangasi worede su kisa a durinya mu, dege kiya ni Abila nse gangasi zo a kiya ni Zakariya yaa ni Berekiya, de ku kisa a sisika ni anya munka sedeka. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Na gye ku gaskye, guru mbo mu woromu yaa zo a kiya ni ntani kwanki mu.<verse eid="MAT 23:36" /></para>
  <para style="s">Yesu So Ntani Wurishelima</para>
  <para style="r">
    <ref loc="LUK 13:34">Lk 13.34</ref>,<ref loc="LUK 13:35">35</ref></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />&lt;&lt;Aya oku ntani Wurishelima, ntani Wurishelima, oku de ku kisa Anebi ku ripi worede de ni saka su zo anya ku ndunsi, sonkwana ni ma bila de ntala yaya ku gabada, yiri de kaza yaa tala yaya yi a siki a gonki keleba yi sede ku ki. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Kone, gizi aku ema kupayi. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Na pala gye ku, kwa geni ni gagaba se nana de ku nkye, &lt;Anabirika ma nja nsu de yaa zo a siki seni ni Obagizi.&gt;&gt;&gt;<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">Yesu yi Beta A kiya Juru Ni Laki Mirikisi</para>
  <para style="r">
    <ref loc="MRK 13:1">Mk 13.1</ref>,<ref loc="MRK 13:2">2</ref>; <ref loc="LUK 21:5">Lk 21.5</ref>,<ref loc="LUK 21:6">6</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Yesu bila gizi Mirikisi yaa yi tepiya se yayagizi e yi zo anya yi de su jaa ankeli e yi ta a beta gini. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />&lt;&lt;Sede Yesu gye su nkye,&gt;&gt; Ku geni guru mbo mu? &lt;&lt;Na gye ku gaskye, ba dunsi daa de yaa te ma kiya daa ba; kowoni daa sua kutiri yi te a kisi.&gt;&gt;<verse eid="MAT 24:2" /></para>
  <para style="s">Wuya nja Genbeki</para>
  <para style="r">
    <ref loc="MRK 13:3-13">Mk 13.3-13</ref>; <ref loc="LUK 21:7-19">Lk 21.7-19</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />De Yesu zunwa a kiya Ogbo ntasi zetu, yayagizi e yi su zo anya yi a boyi. &lt;&lt;Su nkye,&gt;&gt; Gye mu, &lt;&lt;Woshe na mbo mu yaa paru, nja mina ma alama ni zo ake nja alama ni karishe durinya mu?&gt;&gt;<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yesu keleba nkye: &lt;&lt;Ku kone kyakyawu kede nse daa e shirigye ku ba. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Ntani yowa sua zo a siki seni na, sua nkye, &lt;E ni na ni ma kiristi,&gt; Sua shishirigye ku. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Kwa zi beta yanki nja nkye ni yanki, sede kede ku zi womba ba. Sobon dole na yaa paru, sede karishe e tuku zo wo ba. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Kesa sua yi yanki nja kesa, solota kesa daa sua yi geba nja solota kesa daa. Sua yi nyunwa nja juru kesa anya guru a durinya. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Guru mbo mu e ma kankye pari ni Genbeki ni yapu yaa la. <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />&lt;&lt;Se sua la ku ba su de su ba ku Genbeki ari sua sa de ku muntu, guru worede shina Obagizi ba sua zi anwashi aku sobon de kwa biya ni. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />A kwanki ni ntani nyowa sua juyi bila beigaskye nja butu nkyasu a beyi sua kin nkyasu, <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />anebi nsu yi yaruwa nyowa sua butu de su shishirigye ntani nyowa. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Sobon mungu ntani sua jan nyowa guru anya a woze, so ni ntani nyowa yaa seni, <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />sede nsude e sakisi nsori ari karishe yaa sila. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Nabari kyakyawu ni solota Mirikisi sua pala yi anya guru durinya de e ma sheeda ba nsu worede shina beta Mirikisi ba, tukuna karishe yaa zo.<verse eid="MAT 24:14" /></para>
  <para style="s">Mumungu Wuya</para>
  <para style="r">
    <ref loc="MRK 13:14-23">Mk 13.14-23</ref>; <ref loc="LUK 21:20-24">Lk 21.20-24</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />&lt;&lt;Nde na ku geni mbo sakisi anya nsuseki &lt;Mbode rebi de yaa zo ni bebeta,&gt; de suyi beta anya anebi Daniye nsu de yaa karanta yi gane. <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />Se worede su ma Yawudiya su yi gudu ta a kiya dunsi. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Kede nse daa e sonka alenda laki e yi ta kisi de e la mbo daa butu a gizi e yi ba. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Kede nsu de ma bikiya e kuma beyi te la keyi e yi ba. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Gbotuma mata de man siki nja worede su ma yaya de yaa sha nono! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Ku yi lepa kede gudu mu e sa ku kwanki yari ko nana pushe ni asibi. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Nde na kwanki te yi sua Genbeki, de butu a pari ni durinya ari kuzukam su yi yiri e yi ba sua kwa sakye yi yiri e yi ba. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Nde su rigye nana ni naba, ba nsu de yaa te sila ba a siki nsebeki, sede sobon nsu worede su zabi su e shiya sa sua rigye nana ni. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Kwanki ni nse daa yaa gye ku nkye, &lt;Ku geni, kiristi de ma anya ni!&gt; ko, &lt;Ema anya mu!&gt; kede ku yeda ba. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Sobon nsu yi yaruwa nkye su ma kiristi nja nsu yi yaruwa nkye su ma Anebi sua zo yi mbo mamanki totolo de su zi ntani ari nsu worede su zabi su nde yayu. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Geni, Na te gye ku kami de kwanki e yi.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />&lt;&lt;Nde nse da gye ku nkye, &lt;E shi aka anya ni, a woze adenka,&gt; kede ku butu a woze; ko, &lt;su nkye e shi aka, a siki siki laki,&gt; kede ku yeda ba. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Yiride Kwa geni asikye de yaa butu ni anse e ma yomuna anyema, de konse yaa geni, yomuna yaa na zo Yaa nsebeki. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Nkaa yomu guru anya de gan ema, anya ni onguru shakushaku sua tala.<verse eid="MAT 24:28" /></para>
  <para style="s">Zo ni Yaa Nsebeki</para>
  <para style="r">
    <ref loc="MRK 13:24-27">Mk 13.24-27</ref>; <ref loc="LUK 21:25-28">Lk 21.25-28</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />&lt;&lt;Dandani beyi ni Genbeki ni nana ni Nana yaa yi dopuwa, Wonta yaa beyi asikye ba; kemu sua puari butu a bisi, nja guru sori de e ma bisi sua zizika.<verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />&lt;&lt;A kwanki ni alama ni Yaa nsebeki yaa butu a bisi, se guru nsu worede su ma durinya sua yi sasa. Sua geni zo ni Yesu butu a siki gidagida a bisi, nja sori nja yowa dereja. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Yaa saka meleku yi ni totolo kala ni koho sukwa, nja de sua tala worede e zabi su butu keteri wuru ni karishe bisi te ni durinya.<verse eid="MAT 24:31" /></para>
  <para style="s">Mbo shina ni Ntasi Bori</para>
  <para style="r">
    <ref loc="MRK 13:28-31">Mk 13.28-31</ref>; <ref loc="LUK 21:29-33">Lk 21.29-33</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />&lt;&lt;Kuzukam ku kokoyi shina mu dege ayan ntasi bori: Nde yaya nani yi yaa puari nja genya sabuwa tompa, ku shina nkye damina ma yi. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Ko e ma yomu, Nde ku geni guru mbo worosu mu, ku shina nkye e yi kusa naka, mala baki kopa. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Na gye ku gaskye, kwanki mu yaa bise ba se guru mbo mu yaa paru. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Bisi ni kisi sua bise sede beta na yaa taba bise ba.<verse eid="MAT 24:35" /></para>
  <para style="s">Nana Ko Kwanki De Nse Daa Shina Ba</para>
  <para style="r">
    <ref loc="MRK 13:32-37">Mk 13.32-37</ref>; <ref loc="LUK 17:26-30">Lk 17.26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />&lt;&lt;Nse daa shina nana ko kwanki ni ba, ko meleku de su ma a bisi ko Yaa, sede Adaa e shina kin shina. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Nta yiri de e paru a kwanki Nuwu, yomuna yaa paru nana zo ni Yaa nsebeki. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Nana de e ma kami kwanki de riki yaa zo juru anya guru, ntani sua si nja sha, sua yi amere nja beyi mase amere, ari nana de Nuwu yuru A kwanto; <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />nja su shina mbodaa a kiya mbode yaa paru ba ari riki zo la su guru te. Yomuna yaa te paru kwanki de Yaa Nsebeki yaa zo. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Menza bi sua ma bikiya; sua la daa sua bila daa. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Mata bi sua leda nja dunsi nani; sua la daa sua bila daa.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />&lt;&lt;Nkaa yomu kuma a kiya kone, sobon ku shina kowoni nana na Obagizi aku yaa zo ba. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Nde nsugizi shina ko woni kwanki na ndederi bolowa yaa zo, yaa man shiri yaa bila gizi e yi wokye de bolowa e te yuru a siki e yi ba. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Nkaa yomu oku ma se ku zunwa nshiri, sobon Yaa nsebeki yaa zo kwanki de ku shina nkye yaa zo ba.<verse eid="MAT 24:44" /></para>
  <para style="s">Gangasi ko Mumungu Bunwa</para>
  <para style="r">
    <ref loc="LUK 12:41-48">Lk 12.41-48</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />&lt;&lt;Waa na ma bunwa mu nsu aminshi nja nsu simi, de tolense e sayi a kiya bunwa e yi de sua kula ni gizi e yi de e ba su mbo si asu a kwanki kyakyawu? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Bunwa mu Yaa ma nsu anabirika nde nsugizi yi san shi yaa yi yomu a kwanki de e kuma. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Na gye ku gaskye, yaa sayi de yaa kula ni guru mbode e manshi. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Sede nde ema mungu bunwa yaa gye kiya yi nkye, &lt;Nsugizi na yaa zunwa ni kwanki nyowa,&gt; <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />Se e shi geba ndukwa ririgye bunwa de su ma nja shi ema ma yi ma si ma sha ari e bugu. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Nsugizi ni bunwa ni yaa zo nana de e sa dishiya ba nja kwanki de e shina ba. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Nsugizi e yi yaa yi dukwa yaa sa de samu lobo yi munabuki. anya de yaa yi kuka nja suku akuri.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">Abenshi ni yaya mata gom</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />&lt;&lt;A kwanki ni solota ni gizi Mirikisi bisi e ma kankye yaya mata gom de shina menza ba su la pitila asu de su gomu nja minzi okeshe. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Biyari a siki asu su ma Odundu biyari su ma wayo. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Worede suman Odundu su la pitila asu sede su keyi mayi de sua ja a keteri asu ba. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Worede suman wayo, osu, su keyi mayi a siki gwala nja pitila asu. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Minzi okeshe la kwanki nyowa e zo ba, guru asu sua yi ndani kwana se su yi kwana.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />&lt;&lt;A sisika ni ndederi su zi sukwa sua nkye: &lt;Minzi e zo! ku butu de ku san shi!&gt;<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />&lt;&lt;Se guru yaya mase su dege a bisi de su gyala pitila asu. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />nsu worede su ma Odundu su gye nsu wayo nkye, &lt;Ku sua mayi aku ba mu; pitila amu yaa bila bita.&gt;<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />&lt;&lt; &lt;Su keleba su nkye&gt; Yi, &lt;Yaa deta mu nja ku ba. E yi kyawu de ku te anya nsu la ma yi see de ku see na ku.&gt;<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />&lt;&lt;De su tuku ma turiki ni te se mayi, minzi okeshe keyi. Yaya mase de su yi shiri su yuru a siki nja shi anya buki ni amere. Su la kopa ripe.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />&lt;&lt;Dege beyi worosu su mata de shina nseminji ba kwa zo su nkye. &lt;Nsugizi! Nsugizi! &lt;Bure mu kopa!&gt;<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />&lt;&lt;Sede e keleba, &lt;Na gye ku gaskye, ni shina ku ba.&gt;<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Nkaayom ku sigeba ni kone, sobon ku shina nana ko kwanki de Nsugizi ku yaa zo ba.<verse eid="MAT 25:13" /></para>
  <para style="s">Abenshi A kiya Ntani Wuku</para>
  <para style="r">
    <ref loc="LUK 19:11-27">Lk 19.11-27</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />&lt;&lt; Jaja, yaa ma kankye yaa minzi daa de e ta tepiya, e sukwa bunwa e yi e bila keyi e yi a nani asu. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />To e ba daa gyolo biyari, nse daa e beyi bi, se daa kuma e beyi daa, kowoni nse a siki asu e beyi dede sori e yi. Se e te ma yi atepiya. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Nseminji de keleba gyolo biyari e te yi bize e samu gyolo biyari jaja. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Yomuna, nsude keleba bi e samu riba bi a kiya yi <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Sede nseminji de e keleba gyolo daa te yanka romu a kisi e boyi gyolo ni nsugizi yi. <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />A beyi kwanki nyowa nsugizi asu kuma zo yaa yi kikiriga nja su. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Se nseminji de keleba gyolo biyari zo riba biyari jaa nkye. &lt;Tolense,&gt; Ki ba ni ni gyolo biyari. Geni, ni samu riba gyolo biyari jaja.&gt;<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />&lt;&lt;Nsugizi e yi keleba, ki yi dede, bunwa kyakyawu nsu aminshi! Ki yi aminshi a kiya mbo piri; Na sakye sigeba a kiya mbo nyowa. Zo de ki yi perisiki nja nsugizi ake!&gt; <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Se nseminji nsu de keleba gyolo bi zo nneyi du nkye. &lt;Nsugizi,&gt; Ki ba ni gyolo bi; Geni, ni samu riba gyolo bi a kiya yi jaja.<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />&lt;&lt;Nsugizi keleba, ki yi dede, bunwa kyakyawu nsu aminshi! Ki yi aminshi a kiya mbo dende; Na sa ke sigeba a kiya mbo nyowa. Zo de ki yi perisiki nja nsugizi ake&gt; <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Nseminji de e keleba gyolo daa zo nkye. &lt;Nsugizi,&gt; Eni ni shina ki ma nsebeki nsu wuya alina, ka kwa anya de ki nyunkwa ba ka tala anya de ki yaapi saba ba. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />E shina sa de ni zi womba ni yanka romu ni boyi gyolo ake a kisi. Geni, keleba mbo de ki ba ni.&gt;<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />&lt;&lt;Nsugizi yi keleba nkye, &lt;E ke mungu, okyabo bunwa! Ashe ki shina nkye na kwa yi anya de ni nunkwa ba kuma na tala anya de ni yaapi saba ba? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Yaa yi kyawu, de ki la gyolo na sa a laki ni nsu kula ngyolo, de ni zo na keleba gyolo naa ni riba a kiya e yi.<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />&lt;&lt;&lt;Sobon yomu ku keleba gyolo na dege anya e yi. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Du nsude e man nshi sua jaa e yi, ari yaman nshi nyowa. du nsu de man nshi ba, guru mbode e man nshi sua keleba dege anya e yi. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Ku la mungu bunwa mu kutiri a woze, a siki dopuwa, anya de sua yi kuka nja suku kadishiya<verse eid="MAT 25:30" /></para>
  <para style="s">Karishe Shiriya</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />&lt;&lt;Nde yaa nsebeki zo a siki girima, nja guru meleku e yi, yaa zunwa a kingbolo solota gizi bisi ni girima e yi. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Guru kesa ni durinya sua tala a geba e yi, anya ni e shi yaa laba ntani mbombom dege nki asu, kankye yiride nsu kiwo yaa laba timshiya dege akuya. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />E shi yaa sa timshiya a nani dama e yi yaa sa akuya a nani guni e yi.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />&lt;&lt;Se Seleki yaa gye worede su ma a nani dama e yi, &lt;Zo, oku worede Adaa na sa ku anabirika ni solota bisi; Ku si gado ku, de su shiriya ku nshi tun kwanki de su yi durinya. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Sobon Na zi nyunwa ku ba ni mbosi de ni si, Na zi kishi ku ba ni riki de ni sha, Ni zo ku bakwee ku keleba ni a gizi aku, <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Ni ma keikei ba ku ba ni, Ni ma yi suwo ku kula ni, Ni ma a jaru ku zo geshe ni.<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />&lt;&lt;Se ntani gangasi sua keleba e yi nkye, &lt;Obagizi, woshe na mu geni ke ka zi nyunwa na mu ba ke mbo si, ko kaa zi kishi mu ba ke mbode sha,? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />woshe na mu geni ke bakwe na mu keleba ke yuru a gizi, ko totombolo na mu ba ke keikei? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Woshe de mu geni ke yi suwo ko a jaru de mu te geshe ke?&gt;<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />&lt;&lt;Seleki yaa keleba nkye, &lt;Ni gye ku gaskye, du mbo kyakyawu de ki yi yayuwa na dende ni siki yawo na, E ni na ki yi ni nshi.&gt;<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />&lt;&lt;Anya ni yaa gye worede su ma nani guni yi, &lt;Dege anya mu, oku de su yi ku gbetuma, yuru a siki wuta ni dindindin de su shiriya ba obiri nja meleku yi. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />De ni ma zi nyunwa ku ba ni mbosi ba, Ni ma bila de sha riki ku ba ni de ni sha ba, <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Ni ma bakwe ku keleba ni yuru ni a siki gizi ku ba, Ni bila keikei ku ba ni keikei ba, Na yi suwo ni ma jaru ku zo anyana ba.&gt;<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />&lt;&lt;Osu ma sua keleba nkye. &lt;Obagizi, woshe na mu geni ke kaa zi nyunwa ko kaa bila sha riki ko ki zo mu bakwe ko ka bila keikei ko ki yi suwo ko ki ma jaru, mu sua ke nto ba?&gt;<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />&lt;&lt;Yesu yaa keleba, Na gye ku gaskye, du mbode ku yi dende ni siki woromu ba, e ni na ku yi ni nshi ba.&gt;&gt; <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />&lt;&lt;Se sua la mungu ntani kutiri te anya ni zi nki ni dindindin, sede ntani gangasi sua ma ni leyi ni dindindin.&gt;&gt;<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">Su yi Shiri De Su kisa Yesu</para>
  <para style="r">
    <ref loc="MRK 14:1">Mk 14.1</ref>,<ref loc="MRK 14:2">2</ref>; <ref loc="LUK 22:1">Lk 22.1</ref>,<ref loc="LUK 22:2">2</ref>; <ref loc="JHN 11:45-53">Jn 11.45-53</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />De Yesu gama gye su guru mbo mu, se e gye yayagizi yi nkye, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />&lt;&lt;Nta yiride ku shina, buki ni yenteri rigye nana bi de yaa bise, sua la Yaa nsebeki beyi de su gidiri yi.&gt;&gt;<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Se tolense ni pirisi nja toree ntani su tala a kolonwa ni tolense ni pirisi, de seni yi ma Kayapa, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />de su yi shewura de su ka Yesu a boyi de su kisa. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Sede su pala nkye, &lt;&lt;Ba a kwanki ni buki nkaa kede ntani su dege ni rikishi.&gt;&gt;<verse eid="MAT 26:5" /></para>
  <para style="s">Su Shapa Yesu Mayi Kemeshi a Betani</para>
  <para style="r">
    <ref loc="MRK 14:3-9">Mk 14.3-9</ref>; <ref loc="JHN 12:1-8">Jn 12.1-8</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Too Yesu ma Betani a gizi ni nsu de sua sukwa yi nkye Sima de ma kputuru, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />mase daa zo anya e yi ni tuni tularee nsu kemeshi de mani gyolo nyowa, kwanki de Yesu yaa si mbosi e la tularee nya Yesu e shi a kiya.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />De yayagizi yi geni mbo de mase mu yi, su zi anwashi. Su minya Yesu nkye &lt;&lt;Mina sa de mase mu yaa bebeta tularee mu?&gt;&gt; <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />&lt;&lt;Yaa yi kyawu de su la tularee mu see ngyolo yowa de su laba gyolo ba potoruwa.&gt;&gt; <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />Yesu keleba su nkye, ku shina mbo mu, &lt;&lt;Mina sa de kwa dama mase mu? E yi ni mbo kyakyawu. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Potoruwa kwa ma nja su kowoni nana, sede e ni kwa geni ni kowon nana ba. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />De e nya tularee mu nki na, yaa shiri pekye kwanki de sua bishina Ni. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Na gye ku gaskye, guru anya de sua keyi nabari kyakyawu mu te a siki durinya, mbode mase mu yi sua pala yi, de su turunwa nshi.&gt;&gt;<verse eid="MAT 26:13" /></para>
  <para style="s">Yawuda Yeda De E butu Yesu A beyi</para>
  <para style="r">
    <ref loc="MRK 14:10">Mk 14.10</ref>,<ref loc="MRK 14:11">11</ref>; <ref loc="LUK 22:3-6">Lk 22.3-6</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Se daa a siki gom sha bi, de sua sukwa yi nkye Yawuda Isikariyoti, te anya tolense pirisi <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />Yawuda minya su nkye, &lt;&lt;Mina kwa ba ni nde ni ka Yesu ba ku?&gt;&gt; Se su kiriga gyolo talatin butu beyi. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Dege kwanki ni Yawuda yaa bila turiki de yaa la Yesu ba su.<verse eid="MAT 26:16" /></para>
  <para style="s">Yesu Si Mbosi Nja Yayagizi yi</para>
  <para style="r">
    <ref loc="MRK 14:12-21">Mk 14.12-21</ref>; <ref loc="LUK 22:7-13">Lk 22.7-13</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Jn 13.21-30</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />A nana ni pari buki ni buredi de mani darigeza ba, yayagizi Yesu zo anya e yi su minya yi nkye, &lt;&lt;Anga na ka so de mu shiriya ke mbosi ni buki nyenteri?&gt;&gt;<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />E keleba nkye, &lt;&lt;Ku te a siki totolo geri anya ni nseminji daa ku gye yi nkye, &lt;Male nkye: kwanki e yi kusa. Yaa si mbosi ni buki nyenteri a gizi ake nja yayagizi yi.&gt;&gt;&gt; <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Yayagizi Yesu su yi yiride e pala gye su nkye su shiriya mbosi ni buki yenteri.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />De nyema yi, Yesu zunwa de si mbosi nja yayagizi yi gom sha bi. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />De sua si mbosi, e pala nkye, &lt;&lt;Na gye ku gaskye, daa a siki aku yaa butu ni a beyi.&gt;&gt;<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Su da mu soseyi se sua minya nkyasu dan daa sua nkye, &lt;&lt;Ni shina e ni na ba, Obagizi?&gt;&gt;<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Yesu keleba gye su nkye, &lt;&lt;Daa de sa nani a siki gongo mbosi nja ni e shiya yaa butu ni a beyi. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Yaa nsebeki yaa te ayiride e ma rubuta a kiya yi. Sede gbotu ni nsude yaa butu Yaa nsebeki a beyi! Yaa ma nkyawu de su yapu yi ba.&gt;&gt;<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Se Yawuda, de yaa butu Yesu a beyi, nkye, &lt;&lt;Ni shina eni na ba, Male?&gt;&gt;</para>
  <para style="p" vid="MAT 26:25">Yesu keleba gye yi nkye, &lt;&lt;Ee, eke na.&gt;&gt;<verse eid="MAT 26:25" /></para>
  <para style="s">Jibi ni Mirikisi</para>
  <para style="r">
    <ref loc="MRK 14:22-26">Mk 14.22-26</ref>; <ref loc="LUK 22:14-20">Lk 22.14-20</ref>; <ref loc="1CO 11:23-25">1 Kor 11.23-25</ref></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />De sua si mbosi, Yesu la buredi, e gbede Mirikisi se e sua, e ba yayagizi e yi nkye, &lt;&lt;La de ku suku; nki na ka.&gt;&gt;<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Se e la koshiya, e gbede Mirikisi se e la ba su, nkye, &lt;&lt;Ku sha a siki e yi, guru aku. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />E shiya ma zini ni sabuwa ni anikowori, de nya sobon yowa ntani de yape lepi asu. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Na gye ku gaskye, Na sakye sha riki yaya ntasi mu gagaba dege kuzukam ta nana de na sha sabuwa nja ku a gizi ni Adaa na.&gt;&gt;<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />De su yi wonka yobo, su butu ta woze ni dunsi ntasi zetu.<verse eid="MAT 26:30" /></para>
  <para style="s">Biturusu nkye E shina Yesu Ba</para>
  <para style="r">
    <ref loc="MRK 14:27-31">Mk 14.27-31</ref>; <ref loc="LUK 22:31-34">Lk 22.31-34</ref>; <ref loc="JHN 13:36-38">Jn 13.36-38</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Se Yesu gye su nkye, ndederi mu guru aku kwa yi gudu bila ni e ni dan daa na sobon mbode yaa paru nja ni, su rubuta yi nkye:</para>
  <para style="q1" vid="MAT 26:31">&lt;&lt; &lt;Na dukwa nsu kiwo ni saa,</para>
  <para style="q2" vid="MAT 26:31">Se timshiya ni siki saa sua laba.&gt;<verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />&lt;&lt;Sede kwanki de su degeni a siki kumsha, Na rigye ku te Galili.&gt;&gt;<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Biturusu pala nkye, &lt;&lt;Ko guru asu sua yi gudu sobon mbode yaa paru nja ke, E ni na yi gudu ba.&gt;&gt;<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Yesu pala nkye, &lt;&lt;Na gye ke gaskye,&gt;&gt; &lt;&lt;Ndederi mu, kami de zakala yaa yi kala, kankye ki shina ni ba sen wuku.&gt;&gt;<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Biturusu pala gye yi nkye, &lt;&lt;Ko sua ki sa ni nja ke, Na taba ki ke ba.&gt;&gt;</para>
  <para style="p" vid="MAT 26:35">Guru yayagizi yi su yeda nja mbode Biturusu e pala.<verse eid="MAT 26:35" /></para>
  <para style="s">Yesu Yi Lepa a Gesemani</para>
  <para style="r">
    <ref loc="MRK 14:32-42">Mk 14.32-42</ref>; <ref loc="LUK 22:39-46">Lk 22.39-46</ref></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Se Yesu nja yayagizi yi su te anya de sua sukwa yi nkye Gesemani, se e gye su nkye, &lt;&lt;Ku zunwa anya mu de Ni ta geba anya ni te yi lepa.&gt;&gt; <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />E la Biturusu nja yaya ni Zabedi bi te nja shi, se e para yi beki siki nja da mu. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Se Yesu pala gye su nkye, &lt;&lt;Beki siki ma dishiya naa zi kankye ni ma a baki muntu. Ku zunwa anya mu de ku sua ni nto lepa.&gt;&gt;<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />De e ja ta geba piri, e puari ripe ndani yi a kisi e yi lepa nkye, &lt;&lt;Adaa Na, nde e jima ke ki la yi koshiya ni Genbeki mu bila ni, sede e ma so Na aba, sede so ke.&gt;&gt; <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />De e kuma zo anya yayagizi yi e sa su sua yi kwana. &lt;&lt;E minya Biturusu nkye. Kwa yi yaa de ku zunwa lepa nja ni ba, ko ni keripi daa bo?&gt;&gt; <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />&lt;&lt;Ku kone nja de ku yi lepa sobon kede ku puari a siki ni gwada ba. Aworo e yeda sede nki seni.&gt;&gt;<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />E kuma te ni bi te yi lepa nkye, &lt;&lt;Adaa Na, nde yaa ma dole la de kala koshiya mu bilani ba sede Ni sha yi, ki yi mbode ka so.&gt;&gt;<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />De e kuma beyi, e sakye geni su sua yi kwana, sobon ndani asu yi loni. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Se e kwa bila su te yi lepa ni sen wuku, e kwa pala mbode e pala npari.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Se e kuma te ayan yayagizi yi e gye su nkye, &lt;&lt;Ku tuku Kwana ma ku kwa pushe? Geni, kwanki na e yi kusa, Yaa nsebeki sua butu yi a beyi de su la yi beyi a nani ntani nsu lepi. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Dege, de mu te! nsu butu ni a beyi yaa zo ka!&gt;&gt;<verse eid="MAT 26:46" /></para>
  <para style="s">Su ka Yesu</para>
  <para style="r">
    <ref loc="MRK 14:43-50">Mk 14.43-50</ref>; <ref loc="LUK 22:47-53">Lk 22.47-53</ref>; <ref loc="JHN 18:3-12">Jn 18.3-12</ref></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />De e ma a siki beta, Yawuda, daa a siki ni yayagizi yi gom sha bi nja ntani yowa zo ni obalaba nja gwala, toree ni pirisi nja toree ni ntani su saka su. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Nsu butu ni a beyi ba su alama nkye: &lt;&lt;Nsude ku geni Ni runguma yi e shiya Ka ku ka yi.&gt;&gt; <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Su te anya Yesu kwanki daa, Yoda nkye, &lt;&lt;Gesuwa, Male!&gt;&gt; Se e runguma yi.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Yesu gye yi nkye, &lt;&lt;Oboki na, yi mbode keyi ke zo.&gt;&gt;</para>
  <para style="p" vid="MAT 26:50">Se ntani woroni ja zo a geba yi, su kpa Yesu se su keyi. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />De su geni yomu, daa a siki worosu de sua biya Yesu kaa tokopi e yi, ja yi butu se e sala bunwa tolense ni pirisi, e butu yi kuni.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Yesu gye yi nkye, &lt;&lt;Saa obalaba ake a gizi e yi anyade e manshi,&gt;&gt; &lt;&lt;Guru nsu worosu de su yi anpani ni obalaba kisa nse sua muntu ni obalaba. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Yesu gye su nkye kede ku geni nkye Na yi yaa sukwa Adaa na, de saka manki ni meleku e yi de su pi keshi ni shoja gom sha bi de sua sa ni nani bo? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Sede yaya na mbode su rubuta a siki takada Mirikisi yaa sika ema dole na e paru yomu?&gt;&gt;<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />A kwanki ni Yesu gye yowa ntani nkye, &lt;&lt;Ku butu zo anya Na ni obalaba nja gwala kankye nsu de yaa ki biya doka, Ni zunwa kokoyi ku a siki gizi Mirikisi, kuka ni ba. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Sede guru mbo mu yaa paru de beta de anebi rubuta a siki takada Mirikisi e sika.&gt;&gt; Se guru yayagizi yi su bila yi te ma su ngudu.<verse eid="MAT 26:56" /></para>
  <para style="s">Yesu ma A geba Salaki</para>
  <para style="r">
    <ref loc="MRK 14:53-65">Mk 14.53-65</ref>; <ref loc="LUK 22:54">Lk 22.54</ref>,<ref loc="LUK 22:55">55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13">Jn 18.13</ref>,<ref loc="JHN 18:14">14</ref>,<ref loc="JHN 18:19-24">19-24</ref></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Nsu worede kaa Yesu su keyi ta ayan Kayapa, tolense ni pirisi, anya de male ni doka Musa nja toree su gom. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Sede Biturusu biya yi ni nyisa, e te a siki kolonwa tolense ni pirisi. E yuru te zunwa nja nsu yaa kone de e geni mbode yaa paru nja Yesu. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Se tolense ni pirisi nja guru salaki, sua bila turiki de sua ka Yesu nlepi daa de yaa sa de su kisa yi. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Sede su samu lepi mbo daa a kiya e yi ba, sede ntani nsu sheeda yaruwa nyowa su zo a geba.</para>
  <para style="p" vid="MAT 26:60">A karishe ntani bi butu zo a geba <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />su nkye, &lt;&lt;Nse mu pala nkye, &lt;Yaa yi yaa jiru laki Mirikisi ni Mirikisi de e sakye gina yi nana wuku.&gt;&gt;&gt;<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Se tolense ni pirisi dege sakisi a bisi gye Yesu nkye, &lt;&lt;Ka keleba bo? Mina ma sheeda de menza worosu mu sua beyi a kiya ke?&gt;&gt; <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Sede Yesu ma ma yi shuru.</para>
  <para style="p" vid="MAT 26:63">Tolense ni pirisi gye yi nkye, &lt;&lt;Ni gama ke ni Mirikisi nsu leyi: Gye mu ko e ke na ki ma kiristi, Yaa ni Mirikisi.&gt;&gt;<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Yesu gye yi nkye. &lt;&lt;Ee, e ma ma yi yomu yiri de ki pala.&gt;&gt; &lt;&lt;Sede Na gye guru aku: ta geba kwa geni Yaa nsebeki zunwa a nani dama Mirikisi ni sori yaa zo a siki gidagida ni bisi!&gt;&gt;<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Se tolense ni pirisi saga riga e yi ni basi leyi nkye, &lt;&lt;E yi beta saba! Mina sa de mua bila sheeda daa jaja? Geni, ku zi saba Mirikisi de pala. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Mina ma tunani ku?&gt;&gt;</para>
  <para style="p" vid="MAT 26:66">Su keleba nkye. &lt;&lt;E deta de e muntu,&gt;&gt;<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Se su nya yi anyanya a pisika yi su dudu kwa yi. Worosu mari yi <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />su nkye, &lt;&lt;Yi mu beta, nde eke na ki ma Kiristi. Gye mu waa dukwa ke?&gt;&gt;<verse eid="MAT 26:68" /></para>
  <para style="s">Biturusu Ki Yesu</para>
  <para style="r">
    <ref loc="MRK 14:66-72">Mk 14.66-72</ref>; <ref loc="LUK 22:56-62">Lk 22.56-62</ref>; <ref loc="JHN 18:15-18">Jn 18.15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref></para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Kuzukam Biturusu zunwa a papada gizi, se bunwa mase daa zo anya e yi. E pala nkye, &lt;&lt;Eke ma ki ma nja Yesu ni Galiliya na bo?,&gt;&gt;<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Sede e yi musu anya su guru nkye. &lt;&lt;Ni shina mbode kwa yi beta a kiya e yi ba,&gt;&gt;<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Se Biturusu butu kopa a kolonwa te woze, anya ni yaa mase daa kwa geni yi e gye ntani de su ma anya ni nkye, &lt;&lt;Nse mu e ma nja Yesu ni Nazare.&gt;&gt;<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Biturusu sakye ki Yesu jaja, ni melese nkye: &lt;&lt;Ni shina nseminji mu ba!&gt;&gt;<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />A beyi piri, worede sakisi anya ni te anya Biturusu su gye yi nkye, &lt;&lt;Gaskye ki ma daa a siki asu, beta ake pelesa ke.&gt;&gt;<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Se Biturusu para basi kiya yi se e melese ba su nkye, &lt;&lt;Ni shina nseminji mu ba!&gt;&gt;</para>
  <para style="p" vid="MAT 26:74">Anya ni zakala yi kala. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Se Biturusu turunwa beta de Yesu pala gye yi: &lt;&lt;Kami de zakala yaa yi kala, ka ki ni sen wuku.&gt;&gt; Se e butu ta woze te yi kuka nsu sori.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Yesu ma A geba Bilatu</para>
  <para style="r">
    <ref loc="MRK 15:1">Mk 15.1</ref>; <ref loc="LUK 23:1">Lk 23.1</ref>,<ref loc="LUK 23:2">2</ref>; <ref loc="JHN 18:28-32">Jn 18.28-32</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Mbaki sape, guru toree ni pirisi nja toree ni ntani zo ni showura de su kisa Yesu. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Su domuna yi, su keyi te ba Bilatu de ma gomuna.<verse eid="MAT 27:2" /></para>
  <para style="s">Muntu ni Yawuda</para>
  <para style="r">
    <ref loc="ACT 1:18">Ank 1.18</ref>,<ref loc="ACT 1:19">19</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />De Yawuda nsu de e butu Yesu a beyi, e geni yiri de poro yi, se e shenja dishiya yi e kuma ni gyolo aziripa talatin keyi te ba tolense ni pirisi nja toree ntani Yawudawa. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Nkye, &lt;&lt;Ni yi lepi&gt;&gt; &lt;&lt;E ni na ni beyi zini nsu de e yi lepi ba&gt;&gt; &lt;&lt;Mina e ma su ma anya mu?&gt;&gt; su gye yi nkye, &lt;&lt;e ma a laki ake na&gt;&gt; <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />Anya ni Yawuda e keyi gyolo zo ba su a siki laki Mirikisi se e butu. Yaa te lete kiya e yi. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Toree ni pirisi su kwa yi gyolo su pala nkye, &lt;&lt;Ema dedena ba de mu sa gyolo mu a siki bogolo gizi Mirikisi sobon ema gyolo ni zini na&gt;&gt; <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Se su yi showura su la gyolo see anya nsu yi tuni de su bishina bakwe. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Sobon yomu, sua sukwa yi anya zini ari yawu. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Se beta de Anebi Yirimiya pala e sika nkye: &lt;&lt;Su la gyolo ni aziripa talatin, mbo de yaya ni Izireyila su shiriya a kiya e yi, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />Se su yi ampani nshi su see anya de nsu yi tuni, yiride Mirikisi beyi doka&gt;&gt;<verse eid="MAT 27:10" /></para>
  <para style="s">Bilatu Minya Yesu Beta</para>
  <para style="r">
    <ref loc="MRK 15:2-5">Mk 15.2-5</ref>; <ref loc="LUK 23:3-5">Lk 23.3-5</ref>; <ref loc="JHN 18:33-38">Jn 18.33-38</ref></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />De Yesu sakisi a geba gomuna, se gomuna minya yi, e ke na ki ma seleki ni Yawudawa? &lt;&lt;E ma yiri de ki pala&gt;&gt; Yesu gye yi yomu. <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />De Toree ni pirisi nja salaki su basi yi, e pala nkye mbo da ba. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Se Bilatu minya yi, &lt;&lt;Ka zi beta de sua pala a kiya ake mu?&gt;&gt; <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Sede Yesu gye yi mbo daba, kowoni dandaa ari gomuna yi mamanki soseyi.<verse eid="MAT 27:14" /></para>
  <para style="s">Su yi Yesu Poro ni Muntu</para>
  <para style="r">
    <ref loc="MRK 15:6-15">Mk 15.6-15</ref>; <ref loc="LUK 23:13-25">Lk 23.13-25</ref>; <ref loc="JHN 18:39-19:16">Jn 18.39—19.16</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />A kwanki buki nyenteri gomuna yaa shika nse daa a siki nsu yaya jaru. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Kwanki ni su ma ni nseda de yaa yi rishi ji a jaru, sua sukwa yi Baraba. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Su tala kiya su se Bilatu minya su nkye, &lt;&lt;Waana na shika ku nshi: Baraba ko Yesu de su sukwa yi Kiristi?&gt;&gt; <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Sobon e shina kishi na e sa su beyi Yesu a nani e yi. <verse eid="MAT 27:18" /><verse number="19" style="v" sid="MAT 27:19" />De Bilatu zunwa a Kolonwa shiriya, mata yi saka manki anya e yi nkye, &lt;&lt;Kede ki yi nse gangasi mu mbodaa ba sobon e yi lepi ba, ni sha Genbeki anansi sobon e shi.&gt;&gt; <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />Sede tolense ni pirisi nja toree su masa ntani de e shika Baraba de su kisa Yesu. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Gomuna minya su waana a siki asu bi mu kwa bila de ni shika ku nshi?&gt; su keleba nkye Shika mu &lt;&lt;Baraba,&gt;&gt;. <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Bilatu minya su nkye, mina na yi nja Yesu de sua sukwa yi Kiristi? Bilatu minya su. Su keleba guru asu nkye &lt;&lt;Su gidiri yi!&gt;&gt; <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Bilatu minya su nkye &lt;&lt;Yaya? woni lepi na e yi?&gt;&gt; Su yi kuruwa nsori guru asu nkye, &lt;&lt;Gidiri yi!&gt;&gt; <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />De Bilatu geni nkye e ma mbodaa de yaa yi ba, sede ntani sua bila dege dishiya, e la riki wonkye nani e yi a geba yowa ntani de su tala. nkye, &lt;&lt;Ni butu nani na a kiya zini nse mu de e man lepi ba&gt;&gt; E gye su nkye, &lt;&lt;E ma yanki aku na!&gt;&gt; <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />Guru ntani su keleba nkye, &lt;&lt;A laki zini e yi e ma a kiya amu nja yaya mu!&gt;&gt; <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />Se e shika Baraba. Sede e yi Yesu anberemu, e la yi ba su de su gidiri yi.<verse eid="MAT 27:26" /></para>
  <para style="s">Shoja su yi Yesu Siya</para>
  <para style="r">
    <ref loc="MRK 15:16-20">Mk 15.16-20</ref>; <ref loc="JHN 19:2">Jn 19.2</ref>,<ref loc="JHN 19:3">3</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Se shoja ni gomuna su la Yesu te nshi a siki pada asu se su tala guru shoja de su ma anya ni de su gyowe yi. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Su tube Yesu keikei su sayi riga yiri ni solota seleki, <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Su yi lendee ni tengiya solota nja ankwanya su sayi a kiya. Su beyi gwala a nani dama e yi se su dure a geba e yi sua yi baa. Sua pala nkye, &lt;&lt;E ke seleki Yawudawa!&gt;&gt; <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Su nya yi anyanya, se su keleba gwala a nani yi su kwakwala yi a kiya. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Beyi de su yi baa, se su tibi yi riga de su sa yi. su kuma keikei yi sa yi. Se su te nshi anya de su ta gidiri yi.<verse eid="MAT 27:31" /></para>
  <para style="s">Su Gidiri Yesu</para>
  <para style="r">
    <ref loc="MRK 15:21-32">Mk 15.21-32</ref>; <ref loc="LUK 23:26-43">Lk 23.26-43</ref>; <ref loc="JHN 19:17-27">Jn 19.17-27</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Su ma a siki tepiya, se su gom ni nse daa ni Bakureni, seni yi ma Sima, su sa yi dole de la gidiri ni Yesu. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Su lesa anya de sua sukwa yi nkye Goligota, wato anya ni kwankwa kiya. <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Anya ni su ba Yesu riki de yada ni ruwa inebi de musha de e sha, de e kpa baki yi, e ki sha.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />De su gidiri yi, se su laba riga yi su kutiri kuriya. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Su zunwa a kisi, sua kone yi anya ni. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />A bisi ni kiya e yi su rubuta mbo de sua su keyi: &lt;&lt;DA MU E SHINA EMA YESU, SELEKI NI YAWUDAWA.&gt;&gt; <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Su gidiri bolowa bi nja shi, daa a nani dama nja daa a nani guni yi.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />Worede sua bise anya ni guru sigeba nene nshi, sua zizika kiya su: <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />Sua nkye, &lt;&lt;E ke de ka pala nkye ka juru gizi Mirikisi de ka gina yi a siki nana wuku, sila kiya aka de ki sonka zo a kisi dege gidiri maana! Nde ki ma yaa ni Mirikisi!&gt;&gt;<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Yomu na toree ni pirisi, nja male ni kokoyi doka Musa nja totore ni ntani su basi Yesu. <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />&lt;&lt;Su nkye e sila worosu,&gt;&gt;Sede eya sila kiya yi ba! &lt;&lt;E shina ma seleki ni Izireyila! Se e sonka a kiya gidiri dun mu beigaskye nja shi. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />E sadishiya e yi nja Mirikisi. Bila de Mirikisi e sila ke kuzukam nde yaa bila yi, e pala nkye, eni ma yaa ni Mirikisi na.&gt;&gt;&gt; <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Yomu na bolowa de su gidiri nja Yesu, osu ma gye Yesu mumungu beta.<verse eid="MAT 27:44" /></para>
  <para style="s">Muntu Ni Yesu</para>
  <para style="r">
    <ref loc="MRK 15:33-41">Mk 15.33-41</ref>; <ref loc="LUK 23:44-49">Lk 23.44-49</ref>; <ref loc="JHN 19:28-30">Jn 19.28-30</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Dege sisika nana a kiya ari keripi wuku dopuwa ripe anya guru a kesa. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />A dedeyi keripi wuku Yesu yi kuka ni totolo wurinya nkye, &lt;&lt;Eloi, Eloi, lamasabatani?&gt;&gt; Maana yi ema, Mirikisi na, Mirikisi na, mina na sa ki juyi ni bayi bila ni?&gt;&gt; <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />De worede sakisi anya ni su zi yomu, su nkye &lt;&lt;Yaa sukwa Iliya.&gt;&gt; <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Dandani nse daa a siki asu yi gudu te la soso. E juku yi a siki riki ntasi inebi de musha, e sukwa yi a gwala e ba Yesu de e sha. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Sede worosu pala nkye, &lt;&lt;Ku bila yi eshi dandaa, de mu geni ko Iliya yaa zo sila nshi.&gt;&gt; <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Se de Yesu yi kuka ni totolo murinya, E sheke amunshi yi se e sika aworo yi. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Se dandani labile de ma a siki laki Mirikisi laba gizi bi dege bisi ari kisi. Kisi yi mosi dunsi wokye. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Su bure kumsha se nki ntani nsuseki nyowa de su muntu su dege nleyi. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Su bubutu a siki kumsha asu beyi de Yesu dege a siki kumsha, se su yuru atotolo geri nsuseki, ntani nyowa geni su. <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />a kwanki de tolense shoja ni Roma nja worosu de sua kone Yesu su geni kisi e yi mosi nja guru mbo de e paru, su zi womba, su nkye, &lt;&lt;Gaskye nse mu e ma Yaa ni Mirikisi na!&gt;&gt; <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />Mata nyowa sua kone mbo de a paru nyisa. sua biya Yesu dege Galili de su kula ni mbo de yaa bila. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Asiki asu Meremu dege Magadaliya ma, nja Meremu amaa ni Yakubu nja Yusupu, nja Amaa ni yaya Zabedi.<verse eid="MAT 27:56" /></para>
  <para style="s">Bishina ni Yesu</para>
  <para style="r">
    <ref loc="MRK 15:42-47">Mk 15.42-47</ref>; <ref loc="LUK 23:50-56">Lk 23.50-56</ref>; <ref loc="JHN 19:38-42">Jn 19.38-42</ref></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />De nyema yi, se nseda nsu mbo nani dege Arimatiya, seni yi ma yusupu, e shi ma ema daa asiki yayagizi Yesu. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Yaa ta anya ni Bilatu ologba yi de e bayi nki ni Yesu. Bilatu bayi doka su bayi. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Se Yusupu la nki ni Yesu lende a siki woriki sabuwa. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />Se e la yi sa a siki kumsha yi de e yanka a siki dunsi. Se e kiri totolo dunsi ripe baki kumsha se e te ma yi. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Meremu dege magadaliya nja Meremu daa su zunwa a geba kumsha.<verse eid="MAT 27:61" /></para>
  <para style="s">Nsu Kone Kumsha</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Nana daa, de a biya nana ni shiri, toree ni pirisi nja parisiyawa su ta geba Bilatu, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />&lt;&lt;Tolense,&gt;&gt; su nkye, &lt;&lt;mu turunwa kwanki de e man leyi yaa gye ntani nkye, &lt;Beyi nana wuku na dege. <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Sobon yomu ba mu doka de mu kpanku kumsha yi ari nana ni wuku. Nde mu yi yomu ba, Yayagizi yi sua ta la gaan yi mbolowa sua kuma zo agye ntani nkye e dege. Yaruwa de pala akarishemu yaa dege dishiya pi ni pari.&gt;&gt; <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Bilatu gye su nkye, &lt;&lt;Ku la shoja de ku te,&gt;&gt; &lt;&lt;de kone kumsha yiride kuma bila.&gt;&gt;<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />Se su te sua kone kumsha su ripe a kiya dunsi su sa nsu kpanku.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Dege Yesu a kumsha</para>
  <para style="r">
    <ref loc="MRK 16:1-10">Mk 16.1-10</ref>; <ref loc="LUK 24:1-12">Lk 24.1-12</ref>; <ref loc="JHN 20:1-10">Jn 20.1-10</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />A beyi nana asibi, nsasape nana peri, meremu dege magadaliya nja woni Meremu su te de su kone kumsha<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />Dandani su yi totolo juru kesa, se meleku ni Obagizi zo dege bisi, e kiri dunsi a baki kumsha, se zunwa a kiya yi. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Keikei yi ma periperi kankye oruru. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Nsu kpanku su zi womba yi na su birikita na su kwakwana ka ke gan ni ntani.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Meleku beta nja mata. &lt;&lt;Kede ku zi womba, Eni shina nkye kwa bila Yesu la, nsu de su sa yi a bisi gidiri. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />E shi ma anya mu ba; E shi a dege, yiride a gye ku. Zo de ku geni anya de kwana. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Se ku te seseberi de ku gye yayagizi e yi: &lt;E shi de dege nleyi yaa rigye ku geba ta Galili. Anya ni kwa geni yi.&gt; Kuzukam Ni gye ku.&gt;&gt;<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Se mase ni yi seberi bila kumsha, ni womba sede e mani perisiki, se e yi gudu te gye yayagizi yi.<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />De Yesu gomu nja su. E gye su nkye&lt;&lt;gesuwa,&gt;&gt; Su zo anya yi, na su dunkye a seni yi na su bayi girima. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Se Yesu gye su nkye, &lt;&lt;Kede ku yi womba. te de ku gye yayuwa na de su te a Galili; anya ni sua geni.&gt;&gt;<verse eid="MAT 28:10" /></para>
  <para style="s1">Manki nsu kone kumsha</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />De mata worosu mu ma turiki asu, na nsu kone kumsha yuru atotolo geri na su beyi manki gye tolense pirisi guru mbo de e paru. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />De tolense pirisi nja toree ntani su tala su yi showura, na su ba shoja gyolo nyowa, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />su gye su, &lt;&lt;Ku pala nkye yayagizi e yi na su zo ndederi na su leyi mbolowa de mua yi kwana. <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Nde manki mu bise a kuni gomuna, mua keleba baki ku nkye ku shina ni mbodaa ba, mua butu ku a siki ngala.&gt;&gt;<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Nsu kpanku keleba gyolo su yi yiri de su gye su. Se manki mu kakada a siki ntani Yawudawa ari kuzukam.<verse eid="MAT 28:15" /></para>
  <para style="s">Yesu Butu Yayagizi yi Gom Sha da</para>
  <para style="r">
    <ref loc="MRK 16:14-18">Mk 16.14-18</ref>; <ref loc="LUK 24:36-49">Lk 24.36-49</ref>; <ref loc="JHN 20:19-23">Jn 20.19-23</ref>; <ref loc="ACT 1:6-8">Ank 1.6-8</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />De yayagizi gom sha daa te a Galili a ogbo de Yesu gye su nkye su te. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />De su geni Yesu su bowuta yi se worosu asu yi shaka. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Se Yesu zo anya su nkye, &lt;&lt;Guru yiko a bisi nja kisi su ba ni <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Sobon yomu ku te de ku gye ntani guru de su ma yayagizi na, ku yi su tunkwasa a siki seni adaa nja ni Yaa nja ni Aworo Nsuseki, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />nja de ku kokoyi su de su biya guru doka de ni ba ku. E ni na ma nja ku kowon kwanki, ari karishe durinya.&gt;&gt;<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>