<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">1YAH- Gwandara</book>
  <para style="h">1 Yaaya</para>
  <para style="toc1">Takada Yaaya ni bi</para>
  <para style="toc2">1 Yaaya</para>
  <para style="toc3">1 Yah</para>
  <para style="mt2">Takada Pari ni</para>
  <para style="mt1">Yaaya</para>
  <para style="imt">Waa ma e ke</para>
  <para style="ip">Takada ni Pari ni Yaaya e mani aniyi delili bi: de e jaa nsubiya Yesu sori guyam de su yi zumunshi nja Mirikisi nja Yaa yi Yesu Kiristi, nja de e gila su a kiya kokoyi yaruwa de yaa bebeta zumunshi mu. Kokoyi mu ma nkye Yesu zo a durinya mu ni aniyi nki yiri ni nsebeki na ba, nkye Yesu ma nsebeki naba. Yaaya rubuta takada mu de e jaa nsubiya Yesu sori guyam de su mani tebeshi soseyi a siki beigaskyesu de sukwa so nkyasu kankye yiride Mirikisi so su du.</para>
  <para style="iot">Mbode ma Siki yi</para>
  <para style="io1">Waa ma e ke 1.1-4</para>
  <para style="io1">Asikye nja dopuwa</para>
  <para style="io1">Yaya Mirikisi nja yaya Obiri 3.1-24</para>
  <para style="io1">Gwada aworo 4.1-6</para>
  <para style="io1">Mirikisi ma so la 4.7-21</para>
  <para style="io1">Shakiya a durinya 5.1-21</para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">Kelima Ni Leyi</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />Muma keyi ku manki kyakyawu de e ma tun dege pari, de mu zi, nsude mu geni ni ndani amu, nsude mu kone nja mu kpa ni nani amu woto e shiya ma kelima ni leyi. <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />Leyi mu Mirikisi pelesa mu nshi; mu geni yi mu beyi sheeda a kiya e yi, nja mu gye ku nkye leyi ni dindindin ema nja Adaa nja e nana kiya e yi ba mu. <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />Mua gye ku mbode mu geni nja mbode mu zi, de oku ma ku yi zumunshi nja mu. Zumunshi amu nja Adaa nja Yaa e yi, Yesu Kiristi. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />Mu rubuta ku takada mu de peri siki mu e sika.<verse eid="1JN 1:4" /></para>
  <para style="s">Yi Tepiya A siki Asikye</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />Osu na ma manki de mu zi dege anya Yesu na mua gye ku nkye: Mirikisi ma asikye la; a siki yi dopuwa ma ko piri ba. <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />Nde mu nkye mu mayi zumunshi nja Mirikisi, sede nde ari kuzukam mua yi tepiya a siki dopuwa, mu mayi yaruwa la gaskye ma a siki amu ba. <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />Sede nde mua yi tepiya a siki asikye, yiride eshi ema asikye, mua yi zumunshi nja nkiya mu, zini Yesu, Yaa Mirikisi, wonkye mu dege siki guru lepi.<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />Sede nde mu nkye mu mani lepi ba, mu ma shishirigye nkiya mu na gaskye ma a siki amu ba. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />Sede nde mu pala lepi amu, Mirikisi ma nsu aminshi la yaa yape lepi amu nja yaa wonkye guru rishi gangasi amu. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />Nde mu nkye mu man lepi ba, mu nkye Mirikisi ma nsu yaruwa naka nja kelima yi mani anya zunwa a siki dishiya amu ba.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />Oku yaya na, Ni rubuta ku mbomu sobon kede ku yi lepi. Sede nde nseda yi lepi, mu mani nsude yaa sua mu nto yi beta nja Adaa mu Yesu Kiristi, nse gangasi. <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />Yesu na muntu a kiya gidiri sobon de su yape lepi amu, ba sobon lepi amu ndandaa ba sede nzun ntani durinya guru.<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />Nde mu biya doka Mirikisi e nana nkye mu shina yi naka. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />Du nsude nkye, &lt;&lt;Ni shina Mirikisi,&gt;&gt; Sede yaa biya doka Mirikisi ba ema nsu yaruwa la, gaskye ma a siki yi ba. <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />Sede nsude beyi gaskye ni kelima Mirikisi, so ni Mirikisi ma a sisika dishiya yi. Yomuna mua shina nkye mu ma a siki yi. <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />Du nsude pala nkye ema zunwa a siki Mirikisi, ema dole na e yi tepiya yiride Yesu yi.<verse eid="1JN 2:6" /></para>
  <para style="s">Sabuwa Doka</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />Oku nsu oboki na, doka sabuwa na mma rubuta ku nshi ba sede wuri la, de ku shina tun pari. Doka ni wuri na e ma manki de ku zi. <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />Sede nzun yomu mma rubuta ku doka sabuwa; gaskye Yesu sua geni anya e yi nja anya ku, sobon dopuwa yaa bise, asikye ni gaskye e rigye para asikye wo.<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />Du nsude nkye yaa biya Yesu, sede nde yaa yi geba ni yayiwa e yi e tuku ma a siki dopuwa. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />Du nsude yaa so yayiwa e yi yaa yi zunwa a siki ni asikye, ba mbode yaa sa yi titimi. <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />Sede nsude yaa yi geba nja yayiwa e yi e ma a siki dopuwa nja yaa yi tepiya a siki dopuwa; e shina ko agana yaa te ba, sobon dopuwa sa yi ma makapi.<verse eid="1JN 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1JN 2:12" />Ni rubuta ku nshi, yaya na de mma so,</para>
  <para style="q2" vid="1JN 2:12">Sobon seni Yesu su yape lepi aku.<verse eid="1JN 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1JN 2:13" />Ni rubuta ku nshi, nsu Adaa,</para>
  <para style="q2" vid="1JN 2:13">sobon ku shina Yesu de ma tun dege pari.</para>
  <para style="q1" vid="1JN 2:13">Ni ma rubuta ku nshi oku yaya sambari,</para>
  <para style="q2" vid="1JN 2:13">sobon ku shakiya obiri</para>
  <para style="q1" vid="1JN 2:13">Ni ma rubuta ku nshi oku yaya dende</para>
  <para style="q2" vid="1JN 2:13">sobon ku shina Mirikisi Adaa mu.<verse eid="1JN 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1JN 2:14" />Ni ma rubuta ku nshi, nsu Adaa na,</para>
  <para style="q2" vid="1JN 2:14">sobon ku shina Yesu de ma tun dege pari.</para>
  <para style="q1" vid="1JN 2:14">Ni ma rubuta ku nshi, yaya sambari,</para>
  <para style="q2" vid="1JN 2:14">sobon ku man sori,</para>
  <para style="q2" vid="1JN 2:14">nja kelima Mirikisi zunwa a dishiya ku,</para>
  <para style="q2" vid="1JN 2:14">nja ku shakiya obiri.<verse eid="1JN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />Kede ku so durinya ko mbode ma a siki yi. Guru nsude so durinya, so ni Mirikisi Adaa mu ma a siki dishiya yi ba. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />Sobon guru mbode e ma a durinya mu, ema memeri nki nsebeki na, nja memeri ndani nja dukwa geba ni banza a kiya mbode e manshi nja mbode yaa yi, ba e butu anya ni Mirikisi Adaa mu na ba sede e butu a durinya la. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />Durinya nja mungu memeri yi yaa bise, sede nsude yi mbode Mirikisi yaa bila yaama gbogbo.<verse eid="1JN 2:17" /></para>
  <para style="s">Gila A kiya Nsu Oboki Geba Yesu</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />Oku yaya na, daa mu ma kwanki karishe la; Yiride ku zi nkye nsu oboki geba Kiristi sua zo, a kuzukam oboki geba ni Kiristi nyowa su zo wo. Yomu na mua shina nkye mu ma a kwanki ni karishe. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />Su butu dege siki amu, sede gaskye su ma namu na ba. De su ma nja mu na da sua butu bila mu ba; sede butu asu a siki amu nana nkye su ma namu na ba.<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />Sede oku de Nsuseki mu zabi de e ba ku Aworo yi, sobon guru aku ku shina gaskye. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />Ni rubuta ku nshi sobon ku man rishi shina gaskye na ba, sede sobon ku shina yaruwa yaa butu a siki gaskye ba. <verse eid="1JN 2:21" /><verse number="22" style="v" sid="1JN 2:22" />Waa ma nsu yaruwa mu? E shiya ma nsude yi musu nkye Yesu ma Kiristi naba. Yiri nse mu e shiya ma oboki geba ni Yesu, sobon e yi musu ni Adaa nja Yaa. <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />Ba nsude yi musu ni Yaa de yaa ma ni Adaa; nsude yeda nja Yaa e yeda ni Adaa du. <verse eid="1JN 2:23" /><verse number="24" style="v" sid="1JN 2:24" />Oku mbode ku zi butu dege pari ema a dishiya aku. Nde ku yi yomu, oku ma kwa ma a siki Yaa nja a siki ni Adaa. <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />Nsum na ma anikowori yi de e yi mu nshi ni leyi ni gbogbo.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />Mma rubuta ku mbo mu a kiya worede sua yi kokori de su sa ku bila turiki kyakyawu. <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />Sede oku, de ku keleba Aworo Mirikisi ma a siki aku, ba se male daa mbom zo kokoyi ku ba. Sobon Aworo yi yaa kokoyi ku guru mbo, mbode yaa kokoyi ku e ma gaskye la ba yaruwa naba. Sobon yomu ku sigeba ni biya Yesu yiride Aworo yi ma kokoyi ku.<verse eid="1JN 2:27" /></para>
  <para style="s">Yaya Mirikisi</para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />Kuzukam, oku yaya na worede mma so, ku sigeba ni zunwa a siki Kiristi, sobon nana de yaa nana kiya yi mua ma nja shi ba womba nja ba kumnya a geba e yi.<verse eid="1JN 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1JN 2:29" />Nde ku shina nkye Kiristi e ma gangasi na, kwa shina nkye guru nsude yi mbode ma kyakya e ma yaa Mirikisi la.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">Yaya Mirikisi</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />Ku kone yiri totolo so de Adaa ma nshi nyowa a kiya amu, ari de sa sua sukwa mu yaya Mirikisi! Yomu na mu kwa ma! Delili de durinya shina mu ba sobon su shina Adaa ba. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />Oku nsu oboki na de mma so, kuzukam mu ma yaya Mirikisi, mbode mua ma ta a geba su tuku bure mu nshi wo ba. Sede mu shina nkye kwanki de Kiristi te zo, mua ma kankye e shi, sobon mua geni yi yiri de e ma. <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />Guru nsu de mani sa dishiya mu anya Kiristi yaa wonkye kiya yi ma nsu seki, yiride eshi ema nsuseki.<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />Guru nsu de yi lepi e watala doka ni Mirikisi naka; gaskye, lepi e shiya ma rishi biya doka. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />Sede ku shina nkye e zo de e la lepi mu. A siki Yesu lepi ma ba. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />Ba nsude zunwa a siki Kiristi de yaa sigeba ni yi lepi. Du nsude sigeba ni yi lepi e taba shina Yesu ko e geni yi ba.<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />Oku yaya na, kede ku yeda de nseda shishirigye ku. Nsude yi mbode ma gangasi e shiya ma nse gangasi nse, kankye yiride Kiristi ma nse gangasi. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />Du nsude sigeba ni yi lepi e ma ni obiri la, sobon obiri e ma nsu yi lepi na tun dege pari. Delili de Yaa ni Mirikisi zo e shiya ma de e zo juru ANKI ni obiri. <verse eid="1JN 3:8" /><verse number="9" style="v" sid="1JN 3:9" />Ba nsude e ma yapu ni Mirikisi de yaa sigeba ni yi lepi, sobon yiri ni Mirikisi ma a siki yi; yaa sigeba ni yi lepi ba, sobon e ma yapu ni Mirikisi. <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />Yomuna mua shina worede su ma yaya ni Mirikisi nja worede su ma yaya ni obiri: Du nsude e yi mbode ma kyakya ba e ma yaa ni Mirikisi na ba; ko nsude yaa so yayuwa e yi ba.<verse eid="1JN 3:10" /></para>
  <para style="s">Ku So Nkiya ku</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />Nsum na e ma manki de ku zi dege pari: Mu so nkiya mu. <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />Kede ku ma kankye Kayinu, nsude e mani dishiya ni obiri ari e kisa yayiwa yi. Mina sa e kisa yayiwa yi? sobon mbode yaa yi e mani obiri, ni yayiwa yi ema gangasi. <verse eid="1JN 3:12" /><verse number="13" style="v" sid="1JN 3:13" />Kede ema ku mbo mamanki, yayuwa naa, nde ntani durinya ki ku. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />Mu shina nkye mu bise dege muntu te man leyi, sobon mu so yayuwa amu. Du nsude so ma a siki yi ba e ma mumuntu nse la. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />Du nsude yaa yi geba nja yayiwa yi e ma nsu kisa nse la, ku shina nkye nsude kisa nse yaa man leyi ni dindindin ba.<verse eid="1JN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 3:16" />Yomuna mu shina yiride so e ma: Yesu Kiristi beyi leyi yi sobon mu. Omu ma e ma dole na mu beyi leyi mu sobon yayuwa amu. <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />Nde nsedaa ku mani mbo nani nde e geni yayiwa e yi ma siki ngala, sede e zi toseyi e yi ba, yaya na so ni Mirikisi yaa ma a siki yi? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />Oku yaya na de mma so, kede so mu e ma ni kelima nja ni baki kin ba sede ni ANKI nja gaskye.<verse eid="1JN 3:18" /></para>
  <para style="s">Sori Dishiya A geba Mirikisi</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />Yomuna mua shina nkye mu ma ni gaskye, nja mu sori dishiya mu man pushe a geba Mirikisi <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />Nde dishiya amu ba mu lepi, girima ni Mirikisi pi mbode ma a dishiya amu, e kuma shina guru.<verse eid="1JN 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 3:21" />Oku oboki na, nde dishiya amu ba mu lepi ba, mu man sori dishiya a geba ni Mirikisi. <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />Mua keleba a anya e yi guru mbode mu ologba yi sobon mu biya doka yi nja mua yi mbode jima yi.<verse eid="1JN 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1JN 3:23" />Nsum na e ma doka yi: Mu beigaskye nja seni Yaa e yi Yesu Kiristi, nja mu so nkimu, iride Kiristi gye mu. <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />Worede su biya doka ni Mirikisi sua zunwa a siki e yi Mirikisi kuma a siki su . Yomuna mu shina nkye e zunwa a siki mu: Mu shina sobon ni Aworo de e ba mu.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">Gwada Kowon Aworo</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />Oku nsu oboki na, kede ku beigaskye nja kowoni aworo, sede ku gwada kowoni aworo de ku geni ko e ma ni Mirikisi la, sobon anebi nsu yaruwa nyowa su butu yuru anya guru a siki durinya. <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />Yomu na kwa shina Aworo ni Mirikisi: Du aworo de e yeda nkye Yesu Kiristi zo a siki nki naba e ma dege anya Mirikisi naba, <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />Sede aworo de yeda nkye Yesu zo dege anya Mirikisi na ba. E shiya e ma aworo ni oboki geba Yesu, de kwa zi nkye yaa zo ko kuzukam e ma a durinya.<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />Oku, yaya dende, ku butu anya Mirikisi la nja ku shakiya su, sobon Aworo Mirikisi de e ma a siki dishiya ku e pi daa de ma a siki durinya. <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />Su mani durinya la sobon yomu, durinya sua zi su. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />Sede omu mu mani Mirikisi la, du nsude shina Mirikisi yaa zi mu; sede nsude mani Mirikisi ba yaa zi mu ba. Yomu na mua shina aworo ni gaskye nja aworo ni yaruwa.<verse eid="1JN 4:6" /></para>
  <para style="s">Mirikisi E ma Nsu So La</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />Oku oboki na, mu so nkiya mu, so e butu anya Mirikisi la. Nsude mani so a dishiya e yi yapu yi mani Mirikisi la e kwa shina Mirikisi. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />Du nsude mani so a dishiya e yi ba e shina Mirikisi ba, sobon Mirikisi e ma so la. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />Yomu na Mirikisi nana so e yi a sisika amu: E saka Yaa yi ndandaa zo a siki durinya de mu samu leyi anya e yi. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />Yomu na so ni gaskye ma: ba omu na mu so Mirikisi ba, sede Mirikisi la so mu e saka Yaa e yi zo ma sedeka ni yape lepi mu. <verse eid="1JN 4:10" /><verse number="11" style="v" sid="1JN 4:11" />Oku nsu oboki na, tunde Mirikisi yaa so mu, omu ma du mu so nkiya mu. <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />Ba nseda de e taba geni Mirikisi ba; sede nde mua so nkiya mu, Mirikisi ma a siki amu nja so e yi sika a siki amu.<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />Mu shina nkye mu ma a siki yi nja e shi e ma a siki amu, sobon Mirikisi e ba mu Aworo yi <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />Nja mu geni mu sheeda nkye Adaa saka Yaa yi de zo ma nsude yaa sila ni durinya. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />Du nsude yeda nkye Yesu ma Yaa Mirikisi la, Mirikisi yaa zunwa a siki dishiyeyi e shi ma du e ma a siki Mirikisi. <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />Yomu na mu shina mu kwa beyi gaskye a kiya so de Mirikisi ma nshi sobon mu.</para>
  <para style="p" vid="1JN 4:16">Mirikisi e ma so la. Du nsude man so e ma a siki Mirikisi, nja Mirikisi ma a siki yi. <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />A turiki nsum na, so sika a siki mu ari mua mani sori dishiya a nana ni shiriya, sobon a siki durinya mu mua ma yiride e ma. <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />Ba womba a siki so. Sede so ni gaskye yaa butu womba, sobon womba e ma poro la. Nsude yaa zi womba e mani so ni gaskye ba.<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />Mua yi so sobon Mirikisi para so mu, <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />Nde nsude nkye, &lt;&lt;Mma so Mirikisi,&gt;&gt; Se yaa yi geba nja yayiwa e yi, e ma nsu yaruwa na. Du nsude yaa so yayiwa e yi, de yaa geni ba, yaya yaa so Mirikisi, de e taba geni ba, <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />Kiristi ba mu doka nkye: Du nsude yaa so Mirikisi dole na yaa so yayiwa e yi du.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">Shakiya A kiya Durinya</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />Du nsude beigaskye nkye Yesu e ma Kiristi e ma yaa ni Mirikisi la: nja du nsude yaa so Adaa yaa so yaa du. <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />Yomu na mu shina nkye mua so yaya ni Mirikisi: te anya so Mirikisi nja biya doka yi. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />Osu na e ma so ni Mirikisi: mu biya doka yi nja doka yi e man loni ba, <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />Sobon kowon yaa Mirikisi e man sori de yaa shakiya ni durinya. Beigaskye mu a siki Kiristi e shiya samu shakiya ni durinya. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />Waa ma nsude yaa shakiya durinya mu? sede nsude beigaskye nkye Yesu nama Yaa ni Mirikisi.<verse eid="1JN 5:5" /></para>
  <para style="s">Sheeda A kiya Yesu Kiristi</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />Su pelesa Yesu nkye e ma Yaa Mirikisi te anya tunkwasa yi a siki riki nja zini yi de nya a kiya gidiri. Ba ni riki ndandaa yi naba, sede a siki riki nja zini. Aworo de mani gaskye, e beyi sheeda a kiya e yi. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />Mu mani mbo wuku de beyi sheeda: <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />Aworo Mirikisi, ni riki tunkwasa nja zini de nya a kiya gidiri sobon omu; osu wuku mu la su sheeda nkye Yesu e ma Yaa Mirikisi la. <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />Mu yeda ni sheeda ni nsebeki, sede sheeda ni Mirikisi e pi sobon sheeda ni Mirikisi, de e beyi a kiya Yaa yi. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />Du nsude Yeda nja Yaa ni Mirikisi yaa mani sheeda mu a dishiya e yi. Du nsude ki yeda nja Mirikisi e la yi ma nsu yaruwa, sobon e ki yeda ni sheeda de Mirikisi beyi a kiya Yaa yi. <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />Osu na e ma sheeda nkye: Mirikisi ba mu leyi ni gbogbo, leyi mu e ma a siki Yaa e yi na. <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />Du nsude man Yaa e man leyi; du nsu de man Yaa ni Mirikisi ba e man leyi ba.<verse eid="1JN 5:12" /></para>
  <para style="s">Leyi Ni Dindindin</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />Ni rubuta ku mbo worosu mu oku de ku yeda ni seni Yaa ni Mirikisi de ku shina nkye ku ma ni leyi ni dindindin. <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />Osu na ma sori dishiya de mu ma nshi a geba Mirikisi: nkye nde mu minya kowoni mbo a siki nupi yi, yaa zi mu. <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />Tunde mu shina nkye mu te ologba e yi yaa zi mu, mu shina nkye yaa ba mu du mbode mu ologba yi.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />Nde nseda geni yayiwa e yi ni minzi ko ni mase yi lepi de e keyi ni muntu ba, se e yi lepa de Mirikisi e ba nsu lepi mu leyi. Mma yi beta mu a kiya worede lepi asu keyi ni muntu ba. Mu man lepi de e ma ni muntu. Ba lepi muntu na Ni nkye ku yi lepa a kiya e yi ba. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />Guru mbo mumungu e ma lepi la, ba guru lepi na yaa keyi nse ta muntu ba.<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />Mu shina nkye du nsude e ma yapu ni Mirikisi yaa sigeba ni yi lepi ba; sobon Yaa Mirikisi yaa tengele su, obiri yaa kpa su ba. <verse eid="1JN 5:18" /><verse number="19" style="v" sid="1JN 5:19" />Mu shina nkye mu ma yaya Mirikisi la, nja guru durinya ma a nani obiri. <verse eid="1JN 5:19" /><verse number="20" style="v" sid="1JN 5:20" />Mu shina nkye Yaa ni Mirikisi zo de e ba mu shina, de mu shina nkye e shiya ma gaskye. Omu muma a siki yi e shi de e ma gaskye, ko Yaa yi Yesu Kiristi. E shiya ma Mirikisi ni gaskye nja leyi ni gbogbo.<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />Oku yaya na de mma so ku, ku yi nyisa dege boka.<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>