<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Gwandara</book>
  <para style="h">Pilimon</para>
  <para style="toc1">Takada Bulusu Ta Anya Pilimon</para>
  <para style="toc2">Pilimon</para>
  <para style="toc3">Pilm</para>
  <para style="mt2">Takada Bulusu Ta Nya</para>
  <para style="mt1">Pilimon</para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />Manki dege Bulusu, de ma a jaru sobon Kiristi Yesu, nja yayiwa mu Timoti,</para>
  <para style="p" vid="PHM 1:1">Te anya oboki anki mu Pilimon, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />nja nsubiya Yesu de su ma tala a gizi ke, nja yayiwa mu ni mase Apiya, nja yayiwa mu Akibu de ma yi anki kankye shoja ba womba:<verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />Bila de Mirikisi Adaa mu nja Obagizi Yesu Kiristi e ba ku aniyeri nja selema.<verse eid="PHM 1:3" /></para>
  <para style="s">So Nja Beigaskye ni Pilimon</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />Yayiwa na Pilimon, guru kwanki de mma yi lepa, mma turunwa nke a siki lepa na mma gbede Mirikisi. <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />Sobon ni zi nabari so de ki ma nana guru ntani Mirikisi nja beigaskye ke de ki manshi a siki Obagizi Yesu. <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />Lepa na e shiya ma de zumunshi mu nja ke yiri ni nsu beigaskye gane soseyi a kiya guru mbo anabirika mbo kyakyawu de ma namu a siki Kiristi. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />Yayiwa na So ke, e zo ni nyowa perisiki nja sori guyamu! sobon ntani Mirikisi nyowa samu sori dishiya.<verse eid="PHM 1:7" /></para>
  <para style="s">Bulusu Ologba Sobon Ni Onisimus</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />Nkayomua Ni yi sori dishiya, kankye yayiwa ke a siki Kiristi, de Ni gye ke ki yi mbode e kamata de ki yi. <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />Sede sobon mma so ke, na ni geni e yi kyawu de Ni pata ke. Ni yi yomuna kode Ni ma Bulusu, susupe nse a siki Kiristi Yesu, a kwanki mu ni kwa ma yaa jaru sobon Kiristi Yesu. <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />Mma yi ologba ke amomoko yaa na Onisimus, de ni ma kankye adaa yi a siki Kiristi; a kwanki de ni ma a siki jaru Ni ma adaa yi ni siki aworo. <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />A beyi ema ni ampani ba, sede kuzukam ema nsu ampani anya mu guru.<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />Mma saka yi zo anya ke kuzukam, nsude dishiya na ma anya yi. <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />Mma bila de e ma anya mu nja ni, de Ni ma a siki jaru sobon nabari kyakyawu, de e sua ni nto a momoko ke. <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />Sede Na bila de ni sa ke dole de ki sua ni nto ba; sede Na bila de ki yi ni yeda dishiya ke. Nkayomu Na yi mbodaa ba se ni yeda ke.<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />Yaa ma nkye Onisimus e bila ke ni kwanki piri, sobon de ki kua keleba yi de e yi zunwa nja ke ni ari gbogbo naa. <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />Kuzukam e ma bunwa na kokowe ba, sede e pi bunwa: e shi ema yayiwa de mma so a siki Kiristi. Ema nsude mma so na soseyi sede anya ke ki pi so yi! Kankye bunwa nja kankye yayiwa asiki Obagizi<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />Nde, ki mani tunani nkye muma oboki ANKI ke, ki yi naba yiride ka yi ni naba. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />Nde Onisimus yi ke mbodaa mumungu ko ki ma biya yi bashi mbodaa ki sa ni de ni biya. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />E ni Bulusu mma rubuta mbo mu nnani na: Na biya ba ke. ki shina nkye na biya ke bashi ni kiya ke sobon e ni na keyi ke nabari kyakyawu. <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />Yayiwa na, na ologba ke, de ki yi aniyeri sobon Obagizi, yiri ni yayiwa a siki Kiristi, bwala ni dishiya!<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />Ni tabata ka yi mbode ni rubuta ke nshi, ni shina ka yi pi mbode ni minya ke de ki yi<verse eid="PHM 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22" />Ari kuzukam, mma bila de ki gyala ni laki de sonka a siki yi, sobon ni sadishiya nkye Mirikisi yaa zi lepa ku guru de E kuma ni zo anya ku.<verse eid="PHM 1:22" /></para>
  <para style="s">Gesuwa Ni Karishe</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />Apaparasi, nsude ma nja ni a jaru sobon kiristi Yesu, saka ku ni gesuwa yi, <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />yomu du nzun nsu oboki ANKI na Marikusu, Aristakus, Demasi nja Luka.<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />Bila de aniyeri ni Obagizi Yesu Kiristi ema nja ku guru.<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>