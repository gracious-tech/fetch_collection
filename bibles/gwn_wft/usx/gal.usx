<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Gwandara</book>
  <para style="h">GALATIYAWA</para>
  <para style="toc1">Galatiyawa</para>
  <para style="toc2">Galatiyawa</para>
  <para style="toc3">Gal</para>
  <para style="mt1">Galatiyawa</para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />E ni Bulusu, yamanki, dege anya ntani ko nsebeki na ba, sede Mirikisi na sukwa ni, te anya Yesu Kiristi nja Mirikisi Adaa mu, de dege yi a kumsha, <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />nja guru yayuwa de su ma nja ni Bulusu,</para>
  <para style="p" vid="GAL 1:2">Ta anya nsubiya Yesu de su ma nja Ni a Galatiya sua gesheku:<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />Aniyeri nja selema butu dege anya Mirikisi Adaa amu nja Obagizi Yesu Kiristi, <verse eid="GAL 1:3" /><verse number="4" style="v" sid="GAL 1:4" />de beyi kiya yi sobon lepi amu de e sila mu dege mungu kwanki mu, ni nupi Mirikisi nja Adaa mu, <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />nsude girima ni gbogbo ma nja shi. Emayomu.<verse eid="GAL 1:5" /></para>
  <para style="s">Ba Manki Daa mbom Ba</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />Eni Bulusu ni yi mamanki de dandani ku juyi bila Mirikisi de sukwa ku te anya aniyeri ni Yesu Kiristi de ku juyi biya manki daa mbom, <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />de ema manki Kiristi na ba. E nana kankye worosu ntani sua bila de su sa ku de kuma dundundu nja sua yi kokori de su nana manki Kiristi. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />Sede nde omu ko meleku Mirikisi dege bisi beyi manki daa mbom de pi daa de omu mu gye ku, bila de nse ni e ma lalasheshe nsebeki! <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />Yiride mu rigye gye ku, kuzukam Na sakye gye ku: Nde nseda yaa gye ku manki de e pi daa de ku keleba, ku bila de nse ni e ma lalasheshe!<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />Kuzukam Na so yeda ni ntani naba ko yeda ni Mirikisi la? Ko Na so de Ni jima ntani na? Nde Na bila de njima ntani na, Na ma bunwa Kiristi ba.<verse eid="GAL 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />Na so de ku shina, yayuwa, manki ni Kiristi de ni keyi ku nshi e ma mbode butu anya nsebeki naba. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />Ni keleba manki mu anya nsebeki na ba, ko nsebeki na kokoyi ni ba; sede, Ni keleba te anya ni bure ndani dege anya Yesu Kiristi.<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />Ku zi yiride ni yi zunwa na a siki alada Yawudawa, yiride ni ma ba nsubiya Yesu takaasi, nja ni ma yi kokori de ni bebeta nsubiya Yesu. <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />Yiride ku shina nkye a siki adini Yawudawa, Ni pi ntani nyowa de muma sana daa nja ni ma ni kishi alada ni nsu adaatolo mu. <verse eid="GAL 1:14" /><verse number="15" style="v" sid="GAL 1:15" />Sede Mirikisi, de zabi ni sa a keteri kapi de su yapu ni nja de e sukwa ni a siki aniyeri e yi, e jima Mirikisi <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />de pelesa Yaa yi Yesu de ni beyi manki kyakyawu ba worede su ma Yawudawa ba, Ni bila showura anya nseda ba, <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />Ni ta Wurishelima de ni geni worede su ma yayamanki kapi e ni naba, sede dandani Ni te a kesa Larabawa se ni kwa kuma ta Dimasiku. <verse eid="GAL 1:17" /><verse number="18" style="v" sid="GAL 1:18" />Se a beyi shekera wuku, Ni te a Wurishelima ni san Biturusu ni yi nana gom sha biyari nja shi. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />Ni geni nseda a siki yayamanki ba, se Yakubu, yayiwa ni Obagizi. <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />Mbode mma rubuta ku nshi mu e ma gaskye na ari a geba Mirikisi e ma yaruwa naba. <verse eid="GAL 1:20" /><verse number="21" style="v" sid="GAL 1:21" />Dege a beyi Ni ta kesa Suriya nja Kilikiya. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />Sede nsubiya Yesu de su ma Yawudiya su shina ni ba. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />Sede su zi nkye: &lt;&lt;Nseminji de adaa e ma ba nsubiya Yesu takaasi kuzukam e ma nsu beyi manki beigaskye de e ma bebeta e yi adaa.&gt;&gt; <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />Se su yobo Mirikisi sobon ni juyi keleba Yesu.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">Yayamanki Su Yeda Nja Bulusu</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />A beyi shekera gom sha wuru Ni kwa sakye kuma ta Wurishelima, a kwanki ni nja Banaba. Ni la Taru te nja ni du. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />Mirikisi nana ni nshi a siki bure ndani nkye Ni te. De ni ka yi anya ni Ni gom nja toree nsubiya Yesu ni nana su yiride Ni ma pala manki nabari kyakyawu ba worede su ma Yawudawa ba. Sede Ni yi a boyi a geba toree nsubiya Yesu, a siki womba sobon kede anki Na de na yi e ma kokowe ba. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />Ko Taru oboki tepiya na, de ma nja ni, Ni keyi dole de su yii yanka ba, kode e ma nseminji Hellas na. <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />Beta mu dege sobon worosu yayuwa nsu yaruwa de su butu, worosu mu yuru a sisika mu a boyi sua bila de su shina yenshi de mu manshi a siki Yesu Kiristi nja de su sa mu ma bunwa. <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />Sede mu bila su ko piri ba, sobon gaskye ni manki mu e ma nja ku.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />Sede worede su la su ma toree a beyi, su ja mbo daa a kiya beta na ba; guru mbode sua yi e nana mbodaa mbom anya na ba, Sobon Mirikisi yaa yi shiriya ni geni ndani ntani na ba, Nka yomu ntani worosu mu sua ja mbodaa a manki na ba. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />Sede a kiya yomu su geni yiri de su ba ni yiko beyi manki ba worede su ma Yawudawa ba, yiride Biturusu yaa beyi manki ba Yawudawa. <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />Sede Mirikisi de yaa yi ANKI a siki dishiya Biturusu de e sayi ma yamanki ba Yawudawa, yaa yi ANKI nja ni de ni ma yamanki ba worede su ma Yawudawa ba. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />Yakubu, nja Biturusu nja Yaaya, su ma tolense, su shina nkye Mirikisi ba ni aniyi anki; se su sha nani nja Banaba worede su sa nsubiya Yesu sakisi, de su geni aniyeri de Mirikisi ba ni. Su yeda de mu te anya worede su ma Yawudawa ba, se osu sua ta anya Yawudawa. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />Mbode su gye mu de mu yi e shina mu turunwa ni potoruwa, da mu e shina ma mbode Na yi memeri de ni yi.<verse eid="GAL 2:10" /></para>
  <para style="s">Bulusu Kwabe Biturusu</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />A kwanki de Biturusu zo Antakiya, Ni yi geba ni mbode yi, sobon mbode e yi e ma kyakya ba. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />Kapi worosu su ntani su zo anya Yakubu, Biturusu yaa si mbosi nja worede su ma Yawudawa ba. Sede de ntani ni keyi ayan, e para ja kiya e yi mbayi bila worede su ma Yawudawa ba sobon yaa yi womba worede su ma ni keshi worede su yi su yanka. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />Yomu na worosu su Yawudawa nsubiya Yesu hada kiya nja Biturusu su yi munabuki, sobon munabuki asu su ja Banaba de yi mbode su yi.<verse eid="GAL 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 2:14" />De Ni geni sua yi zunwa dede yiride manki gaskye Kiristi pala ba, Ni gye Biturusu a geba ntani guru nkye, &lt;&lt;Ki ma Yawudawa na, sede ki ma yi zunwa kankye worede su ma Yawudawa ba. Yaya ari kuzukam ki ka worede su ma Yawudawa ba de su biya alada ni Yawudawa?<verse eid="GAL 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />&lt;&lt;Omu de su yapu mu ma Yawudawa &lt;Ba ntani de su ma Yawudawa ba nsu lepi&gt; <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />Ku shina nkye nsebeki yaa samu zunwa ni mere lepi anya Mirikisi, te anya biya doka Musa na ba, sede anya beigaskye a siki Kiristi Yesu. Yomuna omu du, mu sa beigaskye amu a siki Kiristi Yesu de mu yi zunwa mere lepi a siki Beigaskye anya Kiristi ba sobon biya doka Musa ba, sobon anya biya doka Musa yaa sa nse daa yaa yi zunwa mere lepi ba.<verse eid="GAL 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17" />&lt;&lt;Nde, mua bila zunwa mere lepi a siki Kiristi, e nana kankye omu nkiya mu mu ma nsu lepi naka, da mu ma kankye Kiristi yaa goyi beyi lepi naka? Yi e ma yomu na ba! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />Nde Ni sakye gina mbode Ni juru, e nana nkye Ni ma nsu watala doka naka. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />Sobon te anya doka Musa Ni muntu a siki doka de Ni man leyi anya Mirikisi. <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />Su gidiri Ni nja Kiristi kuzukam ba E ni na Ni man la yi gagaba, Sede Kiristi de ma zunwa a siki Na. La yi de Ni man shi a siki nki na, E ni mayi zunwa beigaskye a siki Yaa ni Mirikisi, de so ni nja beyi kiya e yi ba ni. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />E ni nki aniyeri ni Mirikisi ba, sobon nde gangasi anya Mirikisi sua samu te anya doka Musa na, muntu ni Kiristi e ma baza naka&gt;&gt;<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">Beigaskye ko Biya Doka Musa</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />Oku Odundu ntani Galatiya! Waa ripe dishiya ku? A pili Ni kokoyi ku a kiya muntu Yesu Kiristi a gidiri. <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />Na so de ni minya ku mbo daa: Ku keleba Aworo Mirikisi sobon de ku biya doka Musa na ko sobon beigaskye ni kelima beta Mirikisi de ku zi? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />Kuma Odundu na yomu? Beyi de ku para ni Aworo Mirikisi, Kuzukam kwa so de ku karikye a siki nki ni kokori ni kiya ku? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />Ku sha Genbeki totolo awopi la? Nde yomu na gaskye e ma wopi la. <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />Mirikisi ba ku Aworo e yi nja yi ANKI mamanki a siki aku sobon de ku biya doka Musa la, ko sobon beigaskye ni mbode ku zi?<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />Ku kone Abireyi: &lt;&lt;E yeda ni Mirikisi, su kiriga yi a siki ntani gangasi anya Mirikisi.&gt;&gt; <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />Sobon yomu ku shina nsu beigaskye ni Mirikisi osu na su ma yaya ni Abireyi. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />Takada ni Mirikisi pala nkye worede su ma Yawudawa ba sua yi yaa ma Mere lepi anya Mirikisi te anya beigaskye, de su rigye beyi manki kyakyawu te anya Abireyi nkye: &lt;&lt;Te anya ake guru ntani sua samu anabirika. <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />Sobon yomu worede man beigaskye sua samu anabirika Abireyi, nsu beigaskye.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />Sobon guru worede su sa dishiya asu nja doka Musa, su ma a siki lalasheshe sobon e ma rubuta a siki takada beta Mirikisi nkye, &lt;&lt;lalasheshe nama guru nsu de sigeba ni yi mbode ma rubuta a siki takada doka Mirikisi ba.&gt;&gt; <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />E ma a pili nkye ba nse daa de yaa samu zunwa mere lepi anya Mirikisi a siki doka Musa, sobon beta Mirikisi pala nkye, &lt;&lt;nsu yi gangasi anya Mirikisi sua mani la yi te anya beigaskye.&gt;&gt; <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />Doka Musa ma te anya beigaskye naba; &lt;&lt;Sobon beta Mirikisi nkye, &lt;&lt;nsude sigeba ni yi mbo mu guru, e shi na yaa mani leyi.&gt;&gt; <verse eid="GAL 3:12" /><verse number="13" style="v" sid="GAL 3:13" />Kiristi sila mu dege siki lalasheshe ni doka Musa e kuma ma lalasheshe sobon mu, sobon e ma rubuta a siki takada Mirikisi nkye: &lt;&lt;Lalasheshe na du nsude su lete yi a kiya gidiri.&gt;&gt; <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />Yesu Kiristi see mu sobon anabirika de Mirikisi ba Abireyi e zo anya worede su ma Yawudawa ba te anya Yesu Kiristi, sobon te anya beigaskye mua samu anikowori ni Aworo Mirikisi.<verse eid="GAL 3:14" /></para>
  <para style="s">Doka Musa Nja Anikowori</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />Yayuwa, bila de ni yi ku misali a kiya ni mbode ku saba e shi, nde ntani bi seda ba ni nsu de yaa ja mbodaa a kiya e yi ko e rigye mbodaa a kiya e yi ba. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />Anikowori de Mirikisi ba Abireyi nja zuriya e yi. Takada Mirikisi pala nkye &lt;Ntani zuriya nyowa ba,&gt;&gt; sobon e ma kankye yaa yi beta a kiya ntani nyowa naka, sede nkye &lt;&lt;E ma beta a kiya nse daakaka la,&gt;&gt; E shiya ma Kiristi. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />Mbode ni mayi nupi e shiya ma da mu: Doka Musa mu, de zo a beyi shekera deri wuru ni talatin, yaa taba shire anikowori mu de Mirikisi e yi ba, ari de yaa ki yi. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />Sobon nde gado mu ma te doka Musa la, e ma anikowori kuma gagaba, sede Mirikisi a siki ni aniyeriyi e ba Abireyi te anya ni anikowori de e yi.<verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />Nde yomu na, mina ma nupi ni doka Musa? Mirikisi ja doka Musa sobon de e nana lepi amu kapi de Yaa ni anikowori Mirikisi yaa zo. Doka sonka butu anya Meleku Mirikisi te anya Musa, nsude sakisi a sisika ntani nja Mirikisi. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />Sede Mirikisi nkiya e yi, e yi Abireyi anikowori ba dole na nseda e sakisi a sisika su kankye yiri ni Musa ba.<verse eid="GAL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />Nka yomuna, doka, yaa yi geba nja anikowori Mirikisi na? Yi, yomuna ba! Sede nde doka yaa beyi la yi, da mu e nana kankye mua samu gangasi Mirikisi te anya doka Musa naka. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />Sede Takada beta Mirikisi pala nkye guru ntani durinya su ma a siki lepi, sobon mbode Mirikisi yi anikowori sua samu te turiki beigaskye a siki Yesu Kiristi, sua ba worede su yeda anya beigaskye.<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />Kapi de kwanki beigaskye mu e zo, doka domuna mu a siki lepi, ari kwanki de beigaskye pelesa. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />Yomuna su la mu sa a nani doka Musa de e keyi mu ta anya Kiristi, de mu samu zunwa mere lepi anya Mirikisi te anya beigaskye. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />Kuzukam de beigaskye zo, muma a domuna a siki doka gagaba.<verse eid="GAL 3:25" /></para>
  <para style="s">Yaya ni Mirikisi</para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />Guru aku kuma yaya Mirikisi te anya beigaskye a siki Yesu Kiristi. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />Guru aku de ku yi tunkwasa a siki Kiristi, kuma kankye Kiristi naka. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />Ba nana bombom a sisika Yawudawa, ko worede su ma Yawudawa ba, ko sakani yaa nja bunwa, ko nseminji ko mase, guru aku kuma daa a siki Yesu Kiristi. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />Nde kuma ni Kiristi la, to kuma yaya ni Abireyi naka, yaya nsu si gado te anya ni anikowori de Mirikisi yi Abireyi.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />Mbode ni mayi kokori pala e shiya ma nsu si gado nde e ma yaa dende, e ma mbom nja bunwa ba, kode nkye mbo guru ma na yi la. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />Ema a nani ni yuwa goyi yi nja nsu kpanku yi ari e keyi kwanki de adaa yi sa. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />Yomuna, kwanki de muma yaya dende, muma bunwa na a nani nsu sori ni solota ni durinya mu. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />Sede kwanki yi, Mirikisi saka Yaa yi, de su yapu yi te anya ni mase, su yapu Yesu te anya doka Musa, <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />de E sila worede ma a siki doka Musa, de muma anihi yaya Mirikisi. <verse eid="GAL 4:5" /><verse number="6" style="v" sid="GAL 4:6" />Sobon de kuma yaya Mirikisi e shiya sa Mirikisi saka Aworo ni Yaa yi a siki dishiya amu, Aworo de ma sukwa nkye, &lt;&lt;Abba, Adaa.&gt;&gt; <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />Sobon yomu, kuma bunwa na gagaba, sede ki ma yaa la; tunde ki ma yaa la, Mirikisi sa kuma yaya nsude si gado.<verse eid="GAL 4:7" /></para>
  <para style="s">Bulusu Da mu A kiya Ntani Galatiyawa</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />A beyi, de ku shina Mirikisi ba, kuma bunwa ni worosu su boka de te anya alita su ma mbodaa naba. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />Sede kuzukam de ku shina Mirikisi, ko ankye Mirikisi shina ku, mina sa de kuma sakye kuma mbayi te anya mbo worede su ma ni sori ba, mbo banza na kuma? Kuma so de ku sakye ma bunwa asu na ja? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />Kuma kiyaye kyakyawu nana nja wonta nja kwanki ni kuma shekera aku! <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />Ni yi womba sobon oku, e ma kankye Genbeki de ni sha a kiya aku e ma abanza la.<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />Ni ma yi ologba ku, yayuwa, kuma kankye e ni, sobon Eni ma ni ma kankye oku. Ku yi ni mbodaa mumungu ba. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />Ku shina nkye, suwo de ni yi e shiya sa Ni para keyi ku nabari kyakyawu ni Kiristi na ni pari. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />Ko de nkye suwo na de ni yi ma gwada na anya aku, nzun yomu ku yi ni nene ko siya ba. De kwa yi yomu, ku yi ni naaba kankye Ni ma meleku ni Mirikisi la anya aku, ko kankye ni ma Yesu Kiristi na nki yi. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />Mina paru ni guru peri siki aku de ku yi? E ni na iya beyi sheeda soseyi a kiya aku, de aya paru la, de ku butu ndani aku ba ni. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />Kuzukam ku la ni Ni ma oboki geba aku la sobon de ni ma gye ku gaskye?<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />Ntani woroni su ka ku ni nani bi bi, sede mbode ma dishiya asu kyawu ba. Mbode su ma so e shiya ma su laba ku nja mu, de guru tunani aku e juyi ta anya asu la. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />E man kyawu de ku mani memeri, nde tunani aku e ma kyakyawu, e ma yomu kowoni nana ba se ni ma nja ku ba. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />Oku yaya na, kuma kankye yaya dende de na sakye zi zapi yapu ku ni bi, ari Yesu Kiristi samu ayan zunwa a siki aku, <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />de ma so na Ni ma nja ku kuzukam de ni yi ku beta ni murinya kyakyawu, sobon ni da mu soseyi a kiya aku!<verse eid="GAL 4:20" /></para>
  <para style="s">Ajara Nja Sera</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />Ku gye ni, oku de kwa so de ku biya doka Musa, ku shina mbode doka Musa e ma pala? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />Sobon e ma a rubutu nkye Abireyi e mani yaya menza bi la, daa ma yaa ni mase de ma bunwa, daa ma yaa mase sari. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />Yaa ni Abireyi de su yapu yi anya mase bunwa su yapu a turiki de man kyawu ba; sede yaa de su yapu yi anya mase sari su yapu yi na sobon Mirikisi yi anikowori nkye sua yapu yi.<verse eid="GAL 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24" />Mbo worosu mu su ma misali la, mata bi mu su ma kankye anikowori bi la. Anikowori daa e ma dege ogbo ni Siyona de yapu yaya de ma bunwa: E shiya ma Ajara. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />Kuzukam Ajara e ma kankye totolo ogbo Sina a siki kesa larabawa e shiya ma misali totolo geri Wurishelima, sobon e shi nja yaya yi su ma bunwa la. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />Sede Wurishelima de ma a bisi e ma yaya mase sari de ma ni yenshi, e shiya ma kankye amaa mu. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />sobon e ma a rubutu nkye:</para>
  <para style="q1" vid="GAL 4:27">&lt;&lt;Ki yi peri siki, e ke mase sari de ki ma awari,</para>
  <para style="q2" vid="GAL 4:27">de man yaya ba;</para>
  <para style="q1" vid="GAL 4:27">ki wokye kuruwa,</para>
  <para style="q2" vid="GAL 4:27">e ke de ki taba zi zapi ni yapu ba;</para>
  <para style="q1" vid="GAL 4:27">sobon nyowa na ma yaya ni mase de minzi e yi bila yi</para>
  <para style="q2" vid="GAL 4:27">e pi nsude mani minzi.<verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />Kuzukam, oku yayuwa, omu ma kankye Ishaku la, yaa de Mirikisi yi anikowori. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />A kwanki ni yaa de su yapu yi a turiki de man kyawu ba, e sa yaa de su yapu yi te anya ni sori Aworo a geba nja e shi e ma beyi takaasi. Yomuna e ma ari kuzukam. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />Sede mina na beta Mirikisi pala? &lt;&lt;Kula mase bunwa mu nja yaa yi de su butu, sobon yaa ni mase bunwa mu yaa si gado nja yaa ni mase sari mu ba.&gt;&gt; <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />Sobon yomuna, yayuwa, muma yaya ni mase bunwa mu na ba, sede muma yaya ni mase sari de mani yenshi.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">Yenshi A siki Yesu Kiristi</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />E ma Sobon zunwa yenshi na Yesu butu mu. Sobon yomu ku sakisi nsori, kede ku bila nkiya ku ni loni keyi lepi a siki zunwa aku ni bunwa.<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />Ku zi beta na! E ni Bulusu, ni ma gye ku nde ku bila nkiya ku su yi ku yanka, Yesu e mani moriya anya ku ba naka. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />Ni ma sakye turunwa ku guru nsude bila ki e yi su yi yanka ema dole la de e biya doka Musa guru. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />Oku de kuma yi kokori de kuma nsu mere lepi anya Mirikisi te anya biya doka Musa ku rigye butu kiya ku bila Kiristi naka; ku kuma bila aniyeri ni Mirikisi naka. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />Sede te anya ni beigaskye nja anya Aworo na muma pekye gangasi Mirikisi de mu sa dishiya. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />Sobon a siki ni Yesu Kiristi ko su yi ke yanka ko su yi ke yanka ba e ma mbodaa na anya mu ba. Mbode mu pi kone e shiya ma beigaskye e ma nana kiya te anya so.<verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />Ni pari kuma sigeba kyakyawu. Kuzukam waa nana ku de ku ki sadishiya ni gaskye? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />Yiri zaki beki yaruwa mu e butu dege anya Mirikisi de sukwa ku na ba. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />Yiri de su nkye, &lt;&lt;Darigaza piri na masa buredi ma kibu.&gt;&gt; <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />Sobon tala kiya mu a siki Obagizi Ni shina kwa taba keleba beta daa mbom de pi nna ba. nsude ma sa ku tututu yaa keleba poro, ko waa ma e shi. <verse eid="GAL 5:10" /><verse number="11" style="v" sid="GAL 5:11" />Yayuwa, nde ari kuzukam ni ma beyi manki Kiristi ni yanka, mina sa de ari kuzum ni ma geni takaasi anya ntani? Nde e ma yomu la mina sa de kokoyi na a kiya muntu ni Yesu a gidiri e ma sa ntani lepi. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />Worede sua sa ku Genbeki nja sua bila de su yi ku yanka, yaa yi su kyawu de su la kiya su beyi de su ma memeleta!<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />Oku, yayuwa na, Mirikisi sukwa ku de ku samu yenshi la. Sede kede ku yi anpani ni yenshi aku mu de ku yi zunwa ni lepi a siki nki ku; nde e ma yomu, ku bowuta nkyiaku a siki so. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />Sobon guru doka Musa su tala e yi akelima daakaka la: &lt;&lt;E shiya ma ki so dengeri ake kankye kiya ke.&gt;&gt; <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />Nde kuma yi topula nja nkyiaku nja suku nkiya ku, ku kone, nde ku yi zunwa yomu, kwa bebeta kiya ku naka gabada.<verse eid="GAL 5:15" /></para>
  <para style="s">Zunwa Ni Aworo Mirikisi Nja Zunwa Ni Ali Nsebeki</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />Mbode Mma bila de ku shina e shiya ma, ku bila de Aworo Mirikisi e nana ku yiri de kwa yi zunwa, nde ku yi yomu kwa taba yi zunwa yiri ali nsebeki ba. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />Sobon mumungu zunwa ni nsebeki yaa yi geba nja Aworo Mirikisi, Aworo Mirikisi yaa yi geba nja zunwa ni ali nsebeki. Guru asu sua yi geba nja nkiasu, sobon kede ku yi mbode kwa bila de ku yi ba. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />Sede nde kuma yi zunwa a siki Aworo Mirikisi, doka Musa man sori a kiya ku ba.<verse eid="GAL 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19" />Zunwa ni ali nsebeki e ma a pili: Osu na ma kwana nja mase ko ni minzi de su yi amere ba, nja ali nungwe sususu, kazanta nja so zunwa dadi de man kyawu ba, <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />nja bowuta boka, nja ali ni dobo nja ali geba nja nkyiaku, yi rikishi nja nkyiaku, ni kishi ni nkyiaku, nja anwashi, nja so kiya ku, ni lalaba nkyiaku, nja dege ankeli, <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />nja ali sha bugu, ni yi buki ni sha mbo yiri yiri, yiri mbo worosu mu. Ni ma ja ku kuni, kankye yiride ni ja ku kuni dege pari, nkye guru worede su ma yi yiri zunwa mu sua mani gado solota gizi Mirikisi ba.<verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />Sede Aworo Nsuseki yaa samu de mu yi zunwa so, zunwa ni peri siki, zunwa ni selema, zunwa ni kadishiya, zunwa ni kiriki, ni zunwa kyakyawu nja nkyiaku, nja zunwa ni aminshi, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />ni zunwa bwala kiya nja zunwa ka nki. yiri mbo worosu mu ba doka daa a kiya su ba. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />Yomuna guru worede su ma ni Yesu su gidiri zunwa ni ali ni nsebeki nja mumungu mbo yiri, yiri de nki mayi memeri asu. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />Tunde mua yi zunwa a siki Aworo Mirikisi na, bila de mu sigeba ni tepiya amu a siki Aworo Mirikisi. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />Kede muma nsu dege dolo, ko muma nsu dege ankeli nkiya mu nja nsu kishi nkyiaku.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">Ku yi Nkyiaku Mbo Kyakyawu</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />Yayuwa, nde ku geni nseda yaa yi lepi, Oku de ku mani Aworo Mirikisi ku kuma nshi zo a turiki kyakyawu. Sede ku kone kiya ku, kede oku ma du ku puari a siki lepi. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />Nde nseda ku ma a siki Genbeki, dole na ku sua yi nto a kwanki ni, ku yi yomu na kwa sika doka Yesu Kiristi. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />Nde nseda ma geni kiya e yi kankye e ma mbodaa na kuma e ma mbodaa na ba, yaa shishirigye kiya e yi naka. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />Sede kowoni nse e gwada anki e yi de e geni. Nde e man kyawu se e yobo kiya e yi, ba se e gwada kiya e yi nja nseda ba. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />Sobon yomu kowoni nse e zi loni keyi yi.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />Guru nsude su kokoyi yi beta ni Yesu Kiristi se e laba guru mbo kyakyawu de e man nshi nja nsude kokoyi yi.<verse eid="GAL 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7" />Kede ku shishirigye kiya ku: Sua taba nana Mirikisi wayo ba. Mbode nsebeki nunkwa e shina yaa nweyi. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />Yayuwa nsude nunkwa mbode nki yaa bila, yaa butu mbode ma muntu; nsude nunkwa mbode yi Aworo Mirikisi kyawu, yaa mani leyi ni gbogbo dege anya ni Aworo Mirikisi. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />Sobon yomu kede mu geji ni yi mbo kyakyawu ba, sobon kwanki yaa zo de mua tala mbode mu yi nde mu bila mbo kyakyawu de mua yi ba. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />Nkayomu, de mu mani kwanki mu, mu yi ntani guru mbo kyakyawu, musama worede su ma yayuwa amu a siki Yesu Kiristi.<verse eid="GAL 6:10" /></para>
  <para style="s">Ba Yanka Sede Sabuwa Yapu</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />Ku kone yiri totolo rubutu de Ni yi ampani ni nani na na ni rubuta ku nshi!<verse eid="GAL 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 6:12" />Worede sua so de su geni su kokori de su sa ku dole de ku yi yanka. Mbode sa sua yi ku yomu e shiya ma sua yi womba ni Genbeki de sua sha sobon gidiri ni Yesu. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />Ko worede su yi su yanka su ma biya doka Musa ba, su ma so de su yi ku yanka de su dege dolo a kiya aku nkye osu na su yi ku yanka. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />Eni na taba dege dolo ba sede dege Dolo na ema a kiya ni gidiri Obagizi Yesu Kiristi, te anya muntu yi a kiya gidiri na ali durinya mu muntu bila ni, Eni kuma ni butu nani na a siki mbo durinya mu guru. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />Ko su yi ni yanka ko su yi yanka ba ema mbodaa anya na ba; totolo mbo e shiya ma sabuwa yapu de manshi a siki Yesu. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />Ni yi lepa de selema nja gangasi Mirikisi e ma nja guru worede su ma biya doka mu, osu la su ma Izireyila ni Mirikisi.<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />A karishe, kede nseda e sa ni a siki ngala a kiya ni mbodaa, sobon alama pita de Ni manshi nki na e nana Ni ma bunwa Yesu la.<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />Yayuwa. Aniyeri ni Obagizi mu Yesu Kiristi e ma nja aworo ku, E ma yomu.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>