<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">21 - Gwandara</book>
  <para style="h">2 TASOLONIKAWA</para>
  <para style="toc1">Takada Bulusu ni Bi ta Tasolonikawa</para>
  <para style="toc2">2 Tasolonikawa</para>
  <para style="toc3">2 Tas</para>
  <para style="mt2">Takada Bulusu ni Bi ta</para>
  <para style="mt1">TASOLONIKAWA</para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />Manki butu anya Bulusu, nja Selasi nja Timoti</para>
  <para style="p" vid="2TH 1:1">Te anya nsubiya Yesu de su ma a siki Tasalonika worede su ma ni Mirikisi Adaa mu nja Obagizi Yesu Kiristi:<verse eid="2TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2" />Aniyeri nja selema dege anya Mirikisi Adaa mu nja Obagizi Yesu Kiristi.<verse eid="2TH 1:2" /></para>
  <para style="s">Gbede Nja Lepa</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />E ma dole na kowon kwanki mu gbede Mirikisi sobon ku, yayuwa, e yi kyawu yomu, sobon beigaskye ku yaa ja yowa soseyi, nja yiri so de ku ma nshi nja nkiyaku yaa ja yowa. <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />Sobon yomu, a siki ntani Mirikisi mua yi dege dolo a kiya ku ni sori dishiya nja beigaskye ku a siki guru takaasi nja gwada de ku geni.<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />Guru worosu mu ma alama de nana nkye shiriya Mirikisi ma kyakya, yomu na kwana ntani de deta zunwa a siki solota Mirikisi, sobon nshi na kuma Genbeki. <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />Mirikisi ma nsu gaskye la: Sobon yomu Mirikisi yaa sa worede sua sa ku Genbeki osu ma sua Genbeki, <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />Mirikisi yaa ba ku pushe, oku de kuma a siki Genbeki, nja mu du, da mu yaa paru a nana de Obagizi Yesu butu a bisi ni arishiya wuta nja meleku Mirikisi. <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />Yaa ba worede shina Mirikisi ba poro nja worede su ki biya nabari kyakyawu ni Obagizi Yesu. <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />Mirikisi yaa ba su poro nja bebeta ni gbogbo, sua laba su a geba Obagizi nja girima ni yiko e yi. <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />A nana de Yesu yaa zo a siki dereja e yi ntani e yi nsuseki sua bowuta e yi nja guru worede su beigaskye. Da mu ma nzun oku, sobon de ku beigaskye ni sheeda amu.<verse eid="2TH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11" />Sobon yomu a siki dishiya mu, mua sigeba ni yi ku lepa, de Mirikisi e sa ku a siki worede su deta sukwa ni Yesu, te anya ni yiko e yi e shiya asika kowoni mbo kyakyawu de kwa yi nja kowoni anki de butu te turiki beigaskye ku. <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />Yomuna mua yi ku lepa de seni Obagizi mu Yesu sua la yi ni girima a siki ku, nja oku ma sua la ku ni girima a siki yi, te anya aniyeri Mirikisi nja Obagizi Yesu Kiristi.<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">Gabo Nse</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />Yayuwa na, mua so de mu gye ku beta a kiya ni kuma zo ni Obagizi mu Yesu Kiristi nja tala amu de mu gomu nja e shi, mua ologba ku yayuwa, <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />Kede dishiya ku e dege a kiya worosu su mbo mamanki, ko takada de e ma kankye e butu anya mu na, de yaa pala nkye nana ni Obagizi rigye zo wo. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />Kede ku yeda de nseda e shirigye ku a kowoni turiki, sobon a nana ni Obagizi yaa zo ba se ntani su yi gabo tuku seleki gabo mere biya doka yaa pelesa, nseminji mu Mirikisi yaa alaka e yi <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />nsu gabo mu yaa yi geba nja Mirikisi yaa kuma ba kiya yi girima a kiya guru mbode sua sukwa Mirikisi ko bowuta e yi, ari yaa zunwa a laki lepa ni Mirikisi, yaa la kiya yi kankye e ma Mirikisi la.<verse eid="2TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5" />Ku turunwa kwanki de ni ma nja ku ni gye ku mbo worosu mu bo? <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />Se kuzukam ku shina mbode yaa nana e yi zo, sobon de e pelesa a kwanki de e ma kyakya. <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />Sobon sori de mungu nse mu ma nshi a boyi e rigye ma a siki ANKI a durinya; sede Mirikisi de yaa nani yi kuzukam yaa sigeba ni nani yi ari nana de Mirikisi yaa la yi bila turuki. <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />Se nsu gabo mu yaa pelesa, nsude Obagizi Yesu yaa kisa e yi ni aminshi baki e yi nja yaa bebeta e yi ni girima nana de yaa zo. <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" />Sua shina zo ni gabo mu te anya shiri anki ni mungu nse de yaa zo yi guru yiri mbo mamanki yaruwa, nja totolo alama nja yiko e yi, <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />A siki guru turuki ni mungu de e shirigye worede su ma turuki bebeta. Sua bebeta sobon su ki biya gaskye de su samu sila. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />Sobon yomu Mirikisi yaa yiri su mungu shishirigye de su yeda ni yaruwa. <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />Sobon Mirikisi yaa poro guru worede su ki yeda ni gaskye sede sua zi dadi yi mungu mbo.<verse eid="2TH 2:12" /></para>
  <para style="s">Ku Sakisi Nsori</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />Sede e ma dole na mu gbede Mirikisi sobon ku, yayuwa de Obagizi yaa so ku, sobon butu a pari Mirikisi zabi ku de ku sila te anya anki Aworo nsuseki nja yeda ku ni gaskye. <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />Mirikisi sukwa ku te anya nabari kyakyawu de mu ba ku, de ku samu girima ni Obagizi mu Yesu Kiristi. <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />Sobon yomu, yayuwa, ku sakisi nsori de ku keyi gaskye de mu kokoyi ku, ko kelima beta baki ko rubutu a takada. <verse eid="2TH 2:15" /><verse number="16" style="v" sid="2TH 2:16" />Bila de Obagizi mu Yesu Kiristi nkiyeyi nja Mirikisi Adaamu, de yaa so mu a siki aniyeri e yi e ba mu sori guyam nja kyakyawu sa dishiya, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />Mirikisi e ba ku sori dishiya de ku sakisi nsori a kiya guru mbo kyakyawu nja kelima beta e yi.<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s">Mua ologba ku de Ku yi mu Yi Mu Lepa</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />A karishe, yayuwa, ku yi mu lepa de manki ni Obagizi e sigeba soseyi nja de e samu girima, yiride e samu a siki aku. <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />Ku yi mu lepa de Mirikisi butu mu a nani mungu ntani sobon guru ntani na su beigaskye ba. <verse eid="2TH 3:2" /><verse number="3" style="v" sid="2TH 3:3" />Sede Obagizi e ma nsu aminshi na, yaa ja ku sori guyam yaa tengele ku dege obiri. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />Mu aminshe ni Obagizi nkye ku mayi mbode mu gye ku nkye ku yi kuma kwa sigeba ni yi su. <verse eid="2TH 3:4" /><verse number="5" style="v" sid="2TH 3:5" />Obagizi e biya ni dishiya ku a siki so ni Mirikisi nja takuwa ni kiristi.<verse eid="2TH 3:5" /></para>
  <para style="s">Kwabe A kiya Zunwa Wopi</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />Yayuwa, a siki seni Obagizi mu Yesu Kiristi, mwa ba ku doka, ku butu turiki yayuwa de su mayi zunwa okyabo nja worede su ma biya mbode ku kokoyi anya mu ba. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />Sobon oku nkiya ku ku shina nkye e kamata de ku yi yiri mbode mwa yi. Mwa yi zunwa okyabo ba kwanki de mu ma nja ku. <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />Mu si mbosi nseda mu ki biya gyolo ba. Sede mu sha Genbeki; mu yi ANKI ndederi ni nana de kede mu ja nseda loni ba. <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />Mu yi yomu, ba nkye sobon mu mani sori bila sua nto anya ku na ba, sede mwa bila de muma mbo kokoyi anya ku. <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />Ko kwanki de mu ma nja ku, mu ba ku doka nkye, &lt;&lt;Nsude yi ANKI ba, yaa si mbosi ba.&gt;&gt;<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />Mu zi nkye worosu su a siki aku su mayi zunwa okyabo su mayi mbodaa ba se yuru a beta ntani kurum. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />Yiri ntani worosu mu mwa ologba su a siki Obagizi Yesu Kiristi de su sakisi yi ANKI de su samu mbode sua si. <verse eid="2TH 3:12" /><verse number="13" style="v" sid="2TH 3:13" />Sede oku, yayuwa, kede ku geji a kiya yi mbo kyakyawu ba.<verse eid="2TH 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TH 3:14" />Nde nseda a siki aku ki biya doka de ma a siki takada mu, ku kula ni yiri ntani worosu mu. Kede ku yi zunwa nja su, ari de su zi kumnya. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />Sede kede ku la su ma oboki geba ku, sede ku yi su beta kankye yayuwa.<verse eid="2TH 3:15" /></para>
  <para style="s">Kelima Karishe</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />Kuzukam bila de Obagizi selema, e ba ku selema a siki guru kwanki nja kowon turuki. Obagizi e ma nja ku guru.<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />E ni Bulusu, ni rubuta gesuwa mu nnani na, da mu nama sheeda de ma a siki guru takada na. Yomu na Ni ma rubuta.<verse eid="2TH 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18" />Aniyeri ni Obagizi mu Yesu Kiristi e ma nja ku guru. E ma yomu<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>