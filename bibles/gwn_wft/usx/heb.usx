<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Gwandara</book>
  <para style="h">ABIRANIYAWA</para>
  <para style="toc3">Heb</para>
  <para style="toc1">Abiraniyawa</para>
  <para style="toc2">Abi</para>
  <para style="mt2">MANKI TA ANYA NSU</para>
  <para style="mt">ABIRANIYAWA</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">Kelima Mirikisi zo Dege Anya Yaa yi</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Kwanki a beyi Mirikisi yi beta nja nsu Adaatolo mu a kwanki nyowa nja a turiki nyowa te anya nsu anebi, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />sede a kwanki karishe Mirikisi yi beta nja mu te anya Yaa yi. Te anya Yaa yi na Mirikisi yi guru mbo a durinya, nsude Mirikisi zabi de yi gado a kiya mbo guru a karishe. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Yesu e shiya ma asikye ni dereja Mirikisi nja kyakya yiri ni kamani yi, e shiya yaa keyi guru ntani durinya ni yiko kelima yi. A beyi de e wonkye lepi ni nsebeki guru, e zunwa a bisi a nani dama ni Mirikisi, nsu yiko.<verse eid="HEB 1:3" /></para>
  <para style="s">Totolo Girima ni Yaa Mirikisi</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />Yomuna Yaa Man Girima pi meleku, yiride Mirikisi beyi seni de e pi na su sori.<verse eid="HEB 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5" />Sobon Mirikisi taba gye meleku daa a bisi nkye,</para>
  <para style="q1" vid="HEB 1:5">&lt;&lt;Ki ma Yaa na ba;</para>
  <para style="q2" vid="HEB 1:5">yawu Ni ma Adaa ke ba.&gt;&gt;</para>
  <para style="m" vid="HEB 1:5">Ko kwa Mirikisi e pala gye meleku daa nkye,</para>
  <para style="q1" vid="HEB 1:5">&lt;&lt;Na ma Adaa yi,</para>
  <para style="q2" vid="HEB 1:5">nja yaa ma Yaa na.&gt;&gt; <verse eid="HEB 1:5" /><verse number="6" style="v" sid="HEB 1:6" />Sede kwanki de Mirikisi yaa bila saka Yaa yi ni pari a siki durinya nkye,</para>
  <para style="q1" vid="HEB 1:6">&lt;&lt;Ema dole guru meleku Mirikisi su bowuta yi.&gt;&gt;&gt;&gt;<verse eid="HEB 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 1:7" />Sede a kiya meleku Mirikisi nkye,</para>
  <para style="q1" vid="HEB 1:7">&lt;&lt;Yaa sa melekuyi su ma kankye aworo Mirikisi,</para>
  <para style="q2" vid="HEB 1:7">se bunwa yi sua ma kankye arishiya wuta.&gt;&gt;<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Sede a kiya Yaa, Mirikisi nkye,</para>
  <para style="q1" vid="HEB 1:8">&lt;&lt;Solota ke, Mirikisi, yaama ni din din, din!</para>
  <para style="q2" vid="HEB 1:8">Ki yi solota a kiya ntani ake ni gaskye.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />Ka so mbode ma gangasi nja ka ki mumungu.</para>
  <para style="q1" vid="HEB 1:9">E shiya sa Mirikisi, Mirikisi ake, e zabi ke</para>
  <para style="q2" vid="HEB 1:9">se e ba ke peri siki ni girima</para>
  <para style="q2" vid="HEB 1:9">de pi ni nsu oboki tepiya ake.&gt;&gt;<verse eid="HEB 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />Mirikisi kwa pala nkye,</para>
  <para style="q1" vid="HEB 1:10">&lt;&lt;Dege pari, Obagizi, kapa kutiri durinya,</para>
  <para style="q2" vid="HEB 1:10">Ni nani ake ki yi bisi.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />Sua beeta, sede eke ki na;</para>
  <para style="q2" vid="HEB 1:11">guru asu sua sopa kankye keikei.<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />Ka lende su kankye yadi,</para>
  <para style="q2" vid="HEB 1:12">sua shenja kankye keikei.</para>
  <para style="q1" vid="HEB 1:12">Sede e ke ka ma yiride ki ma,</para>
  <para style="q2" vid="HEB 1:12">kama gbogbo.&gt;&gt;<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Mirikisi taba gye meleku yi daa nkye:</para>
  <para style="q1" vid="HEB 1:13">&lt;&lt;Zunwa anya mu a nani dama na</para>
  <para style="q2" vid="HEB 1:13">ari Na sa oboki gebake</para>
  <para style="q2" vid="HEB 1:13">a kisi seni ke.&gt;&gt;<verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />Nsu waa, ma meleku? Osu na su ma aworo de Mirikisi saka su de su sua worede Mirikisi yaa sila nsu nto.<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">Totolo Sila ni Mirikisi</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />E shiya sa e ma dole na mu sakisi nkyawu, a kiya gaskye de mu zi, sobon kede mu bila turiki. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Sobon manki de meleku ba nsu adaatolo mu e ma gaskye, se guru nsude ki zi yi, ko e ki yeda nshi yaa keleba poro. <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />Yaya na mua butu nde mu ki kula ni totolo sila mu? Mirikisi nkiyeyi la pala sila mu npari, worede su zi yi npari su tabata mu nshi. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />A kwanki ni jaja Mirikisi ja sheeda e yi te anya alama, ni anki mamanki ni mbo yiri yiri, nja laba kyawuta ni Aworo mbombom ni nupi yi.<verse eid="HEB 2:4" /></para>
  <para style="s">Yesu Keyi mu te Sila</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Mirikisi taba sa meleku yi de su yi solota durinya nsu zo ba, nsude mua yi beta a kiya yi. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Sede nseda taba sheeda anya daa a siki beta Mirikisi nkye,</para>
  <para style="q1" vid="HEB 2:6">&lt;&lt;Waa ma nsebeki, Mirikisi, de ka da mu nshi;</para>
  <para style="q2" vid="HEB 2:6">ko Yaa nsebeki de ka kula nshi?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Ki sa yi a kwanki piri pi meleku;</para>
  <para style="q2" vid="HEB 2:7">ki domuna e yi lende ni dereja nja girima,<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />Mirikisi sa yi ma nsu solota a kiya guru mbo.&gt;&gt;</para>
  <para style="m" vid="HEB 2:8">Beta Mirikisi pala nkye, Miriksi sa su ma seleki a kiya guru mbo&gt;&gt;; Da mu ma nzun mbo guru. Sede a kuzukam, mu geni nsebeki mayi solota a kiya mbo guru ba. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />Sede mu geni Yesu, de a kwanki piri Mirikisi sa meleku pi yi. Kuzukam su yi lende ni dereja nja girima sobon Genbeki ari e muntu, sobon te anya aniyeri Mirikisi e muntu sobon konwawa.<verse eid="HEB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10" />Sobon yomu e ma kyakya na Mirikisi, de yi guru mbo paru sobon nshi, te anya e yi la sua samu guru mbo, Yesu e shiya ma pari ni sa sila su ma kyakya te anya Genbeki. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />Sobon nsude sa ntani ma nsuseki nja worede su sa su ma nsuseki guru su ma daa. Sobon yomu Yesu yaa zi kumnya ni sukwa su yayuwa e yi ba. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />E pala gye Mirikisi nkye,</para>
  <para style="q1" vid="HEB 2:12">&lt;&lt;Na gye ntani na mbode ki yi;</para>
  <para style="q2" vid="HEB 2:12">Na yobo ke a siki tala su.&gt;&gt;<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />Ari kuzukam nkye,</para>
  <para style="q1" vid="HEB 2:13">&lt;&lt;Na sadishiya nja Mirikisi.&gt;&gt;</para>
  <para style="m" vid="HEB 2:13">E kwa pala nkye,</para>
  <para style="q1" vid="HEB 2:13">&lt;&lt;E ni naka anya mu, nja yaya de Mirikisi ba ni.&gt;&gt;<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Tunde yaya mu su ma ntani nsu nama nja zini, e shi ma du e ma kankye nsebeki. Sobon te anya muntu e yi e juru sori ni muntu, wato obiri, de man sori a kiya muntu, <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />de kunshe worede su ma bunwa muntu tunde su yapu su sobon womba. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Sobon meleku na Yesu sua su nto ba, sede juriya ni Abireyi. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />Sobon yomu, e yi kyawu de e ma kankye yayuwa yi a kowon turiki, de e ma pirisi nsu toseyi nja aminshi a siki anki Mirikisi, de e munka sedeka de yaa la lepi ntani. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Sobon e shi nkiyeyi Genbeki a kwanki de su gwada yi, yomu la yaa sua worede sua gwada su nto.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">Yesu Pi Musa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Nkayomu, yayuwa na nsubiya Yesu, de Mirikisi sukwa ku! ku turunwa Yesu, de ma Yamanki Mirikisi, nja tolense pirisi ni beigaskye de mua sheeda e yi. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />Yesu yi aminshi nja nsude sakye yi, yiri de Musa ma nsu aminshi a siki ankiyi a gizi Mirikisi. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Sede girima ni Yesu pi ni Musa, yiride nsu gini gizi pi gizi nkiya yi girima. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Sobon kowoni gizi e mani nsude gina yi, sede nsude gina guru mbo ma Mirikisi. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Musa ma bunwa kyakyawu nsu aminshi a siki ankiyi a gizi Mirikisi, e sheeda mbode Mirikisi nkye yaa paru a geba; <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Sede Kiristi e ma Yaa nsu aminshi a gizi Mirikisi. Omu la muma gizi yi, nde mu mani ja sori guyam nja sadishiya ni dege dolo.<verse eid="HEB 3:6" /></para>
  <para style="s">Pushe sobon ntani Mirikisi</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Akayomu, yiride Aworo nsuseki pala:</para>
  <para style="q1" vid="HEB 3:7">&lt;&lt;Yawu nde ki zi murinya Mirikisi,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />kede ku yi rishi zi,</para>
  <para style="q1" vid="HEB 3:8">yiride nsu adaatolo ku su yi rishi zi nja Mirikisi,</para>
  <para style="q2" vid="HEB 3:8">woto a kwanki de su gwade yi a siki denka,<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />Mirikisi nkye, anya de nsu adaku gwada ni</para>
  <para style="q2" vid="HEB 3:9">shekera aribeni su geni mbode ni yi.<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />E shiya sa ni yi anwashi nja ntani Ni nkye,</para>
  <para style="q2" vid="HEB 3:10">&lt;Kowon kwanki su ma Ki ni a dishiya su,</para>
  <para style="q2" vid="HEB 3:10">su ki su biya turiki na.&gt;<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Se a siki anwashi Ni yi anikowori nkye:</para>
  <para style="q2" vid="HEB 3:11">&lt;Sua taba yuru a kesa de Ni yi su anikowori ba.&gt; &gt;&gt;<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Yayuwa na, ku yi ankeli kede nseda ku e mani mungu dishiya ni rishi yeda de sa ku juyi bila Mirikisi nsu leyi. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Sede ku ja nkiyaku sori guyam kowon nana, sobon kede nseda ku e man nsu tori kiya te anya shirigye ni lepi. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Muma nsu zunwa nja Kiristi na nde mu sakisi nsori ari karishe a kiya yeda de mu yi dege pari. <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />Da mu nama mbode beta Mirikisi pala:</para>
  <para style="q1" vid="HEB 3:15">&lt;&lt;Nde ku zi murinya Mirikisi yawu,</para>
  <para style="q2" vid="HEB 3:15">kede ku yi tori kiya</para>
  <para style="q1" vid="HEB 3:15">yiride ku yi rishi zi.&gt;&gt;<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Nsu waa zi beta Mirikisi de su ki zi? Osu na ma worede Musa butu su a kesa Masa bo? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />nja nsu waa Mirikisi yi anwashi nsu shekera aribeni? Nja worede su yi lepi, de su puari muntu a siki denka? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Nsu waa Mirikisi melese nkye, &lt;&lt;Sua yuru a siki pushe yi ba, ba worede su yi lesa zi na bo? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Se mu geni su yuru ba, sobon rishi beigaskye.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Nkayomu tunde Mirikisi yi mu anikowori yuru a siki pushe, se mu yi ankeli kede nseda a siki amu e lesa yuru a siki gizi pushe ni. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Sobon mu zi manki nabari kyakyawu ni Yesu kankye yiride ntani Izireyila su zi du; sede manki nabari kyakyawu de su zi e ma ni moriya anya su ba, sobon su keleba yi ni beigaskye ba. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Sede omu de mu beigaskye la mua yuru a siki kesa pushe ni Mirikisi mu, yiride e pala nkye,</para>
  <para style="q1" vid="HEB 4:3">&lt;&lt;Sobon de ni yi anwashi ni melese nkye,</para>
  <para style="q2" vid="HEB 4:3">&lt;Sua taba yuru a siki kesa pushe na ba.&gt; &gt;&gt;</para>
  <para style="m" vid="HEB 4:3">Mirikisi pala yomu ko de e rigye gama ankiyi tun a kwanki de su yi durinya. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Sobon anya daa a siki beta Mirikisi yi beta a kiya nana ni bokwe nkye: &lt;&lt;A nana ni bokwe Mirikisi pushe a siki guru ankiyi de yi.&gt;&gt; <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />Yomuna Mirikisi yi beta anya daa a siki beta e yi nkye, &lt;&lt;Sua taba yuru a siki kesa pushe naba.&gt;&gt;<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />Worede para zi manki nabari kyakyawu mu su yuru a kesa pushe mu ba sobon su yi lesa zi. Nzun yomu worede su beigaskye su yeda su de su yuru a siki pushe mu <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Nkayomua Mirikisi kwa shiriya nana daa, de e ma yawu, de Mirikisi yi beta a kiya nana mu a beyi shekera nyowa de su bise a baki Dowuda a siki beta Mirikisi nkye:</para>
  <para style="q1" vid="HEB 4:7">&lt;&lt;Yawu nde ku zi murinya Mirikisi,</para>
  <para style="q2" vid="HEB 4:7">kede ku yi tori kiya.&gt;&gt;<verse eid="HEB 4:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 4:8" />Nde Yoshuwa ba ntani Mirikisi pushe mu, Mirikisi yaa kua yi beta a beyi a kiya nana pushe daa mbom ba. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Nkayomu e nana nkye nana Pushe de ma kankye nana pushe ni Asibi sobon ntani Mirikisi; <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />guru worede su yuru a siki pushe ni Mirikisi de e yi anikowori sua pushe a siki ANKI asu kankye yiride Mirikisi pushe de e gama ANKI yi. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Nkayomu, mu yi kokori amu de mu yuru a siki pushe mu, sobon kede nseda e yi yaa yuru ba yiride nsu adaatolo mu su yi sobon rishi beigaskye.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />Kelima Mirikisi e man leyi nja sori anki. E mani shapi pi kowoni obalaba nsu baki bi, e ma laba leyi nja aworo, e ma laba gaba nki nja romo keshi; e pelesa tunani nsebeki nja guru mbode ma a siki dishiya. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Ba mbode ma boyi Mirikisi ba. Guru mbode e yi ma a bure a geba yi. Konwawa yaa sakisi a geba e yi yaa pala guru mbode e yi a siki zunwa yi ni durinya mu.<verse eid="HEB 4:13" /></para>
  <para style="s">Yesu ma Totolo tolense Pirisi</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Nkayomu, tunde mu mani totolo pirisi de e nyunwa te a bisi a geba Mirikisi, e shiya ma Yesu Yaa ni Mirikisi, se mu sakisi nsori a siki beigaskye de mu yeda nshi. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Totolo Pirisi amu e ma nsude shina rishi sori amu la. E shiya su gwade yi a turiki mbombom, kankye yiride su gwada mu, nzun yomu e yi lepi ba. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Nkayom, bila de mu yi sori dishiya de mu zo a geba kingbolo solota Mirikisi, anya de mua keleba toseyi nja aniyeri de yaa sua mu nto a kwanki de mwa bila e yi.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Mirikisi zabi kowoni totolo pirisi dege siki ntani la de e yi ANKI sobon ririgye ntani a kiya ANKI de ma ni Mirikisi, e shiya ma nsu munka kyawuta nja sedeka sobon lepi. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />Tunde e shi tolense pirisi e mani rishi sori a turiki nyowa, e yi yaa yi ankuri ni ntani worede su shina mbode su meyi ba, su shina nkye mbode su meyi e ma mumungu. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />E shiya sa e kamata e munka sedeka sobon lepi yi, tuku de e munka sobon lepi ni ntani.<verse eid="HEB 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 5:4" />Nseda yaa zabi kiya yi de yi ANKI nsu dereja mu ba; e ma te anya sukwa Mirikisi la de man totolo pirisi, kankye yiride Mirikisi sukwa Aruna. <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />Yomuna Kiristi e ba kiya e yi girima de e ma totolo pirisi ba. Sede Mirikisi gye yi nkye,</para>
  <para style="q1" vid="HEB 5:5">&lt;&lt;Ki ma Yaa na la;</para>
  <para style="q2" vid="HEB 5:5">yawu mu ni ma Adaa ke.&gt;&gt;<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />E kwa yi beta anya daa a siki beta Mirikisi nkye,</para>
  <para style="q1" vid="HEB 5:6">&lt;&lt;Ka ma pirisi ni gbogbo,</para>
  <para style="q2" vid="HEB 5:6">kankye yiride ANKI ni Melkizedek ma.&gt;&gt;<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />A kwanki de Yesu ma a durinya mu, e yi lepa nja ologba ni kuka nsori ni anwe te nja Mirikisi de yaa yi yaa sila nshi dege muntu, Mirikisi keleba lepa yi sobon beyi girima de Yesu meyi. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Kode nkye Yesu e ma Yaa Mirikisi la, e kokoyi beyi girima te nja Mirikisi a turiki Genbeki de e geni. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />De Yesu ma dedeta, se e ma tutiri sila ni gbogbo te nja guru worede su ma beyi girima, <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />yomuna Mirikisi zabi yi de e ma totolo pirisi a kiya sari ni Melkizedek.<verse eid="HEB 5:10" /></para>
  <para style="s">Gila A kiya Juyi Bila beigaskye</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Mu mani mbo nyowa de mua gye ku a kiya ni mbo mu, sede mua gye ku ba sobon ku man seberi shina mbo ba. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Gaskye e kamata de ku ma male nsu kokoyi beta Mirikisi, sede ku kwa bila de nseda e kokoyi ku beta Mirikisi dege pari tuku. E kamata de Ku si mbosi nsu sori, sede ku tuku ma sha nono! <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Guru nsude ma sha nono e tuku ma yaa dende la, e shina mbodaa a kiya kokoyi gangasi ba. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Sede mbosi nsu sori e ma ni toree ntani la, worede su ma kokoyi dishiya su de su shina sakani mumungu nja mbo kyakyawu.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Nkayomu bila de mu sigeba a kiya kokoyi ni pari de mu keleba a kiya ni Kiristi de muma dedeta ntani, kede e ma nkye mu kwa kapa kutiri kokoyi a kiya beigaskye ni Mirikisi nja juyi bila mbo mumungu de yaa keyi mu te amuntu; <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />nja kokoyi a kiya tunkwasa nja ja nani anabirika, nja a kiya dege a kumsha, nja shiriya nana karishe. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Sigeba na mwa yi! Nde Mirikisi yeda.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Sobon worede su juyi bila beigaskye su, yaa yi kyawu de akwa juyi su zo a beigaskye jaja? Worede su taba ma a siki asikye Mirikisi, su kwa kpa kyawuta ni bisi worede su samu lobo asu a siki Aworo Nsuseki, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />worede su zi zanki beta Mirikisi nja sori ni sana nsu zo. <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />Nde su juyi bila beigaskye asu! e yi kyawu de akwa kuma nsu mbayi ba, sobon su kwa gidiri Yaa Mirikisi ni bi aka a siki juyi mbayi asu de su yi nja su beyi kumnya a geba ntani.<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />Mirikisi yi kesa de riki ma sonka a kiya e yi kowoni kwanki, de ma butu ni sanwa mbombom nsu anpani ba nsu bikiya ayan, kesa mu na ma keleba anabirika Mirikisi. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Sede kesa de ma butu ni ankwanya nja mumungu sanwa e ma ni ampani ba Mirikisi yaa yi kesa ni gbotuma. A karishe yaa suwuta e yi.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Sede yayuwa mu kode muma gye ku yiri beta mu, muma ni shaka a kiya ku ba, de mu nkye ku la turiki de pi kyawu de yaa sila nku. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Mirikisi ma gangasi la; yaa mosi ni anki ku de ku yi ba ko so aku de ku ma nana nsubiya Yesu kwanki de kuma sua su nto ba ku sigeba ni sua su nto. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Mwa so kowoni nse a siki ku e sigeba ni yi anki ni sori dishiya ari karishe, de ku samu sika ni mbo worede ku sadishiya a kiya su. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />Mwa bila de kuma okyabo ba, sede ku kokoyi mbode worede su beigaskye su meyi, suuuuuui</para>
  <para style="b" vid="HEB 6:12">u kadishiya ari su keleba mbode Mirikisi yi su anikowori nkye yaa ba su.<verse eid="HEB 6:12" /></para>
  <para style="s">Tebeshi Ni Anikowori Mirikisi</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Kwanki de Mirikisi yi Abireyi anikowori, Mirikisi yi anikowori ni melese. Tunde nseda ma de pi yi girima ba e melese ni nkiya e yi, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />Mirikisi nkye, &lt;&lt;Ni gaskye na sa ke anabirika nja Na sa juriya ke e ma nyowa.&gt;&gt; <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />A beyi de Abireyi yi takuwa nja kadishiya, e keleba mbode Mirikisi yi anikowori. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />Ntani su ma melese ni worede su pi su girima, yomuna melese asu yaama gaskye de kede su yi musu. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />De Mirikisi bila de e nana mu anikowori yi a pili nkye yaa taba shenja anikowori yi ni anabirika de yi mu nshi ba; se e yi anikowori ni melese. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />Mbo guda bi ma, de sua shenja ba Mirikisi yaa taba pala yaruwa ba. Tunde nsum ma mbo ja sori guyam na soseyi anya mu, omu de mu samu sila e kamata de mu ka mbomu de mu sadishiya a kiya e yi nsori. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />Sadishiya mu e ma gaskye la de ma kankye mbode ka dishiya mu, mua yi womba ko shaka ba. E shiya yaa yuru ari siki beyi totolo labile mu ni anya Nsuseki ni gizi Mirikisi. <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />Yesu de e shiya ma ni pari de yuru anya ni. E yuru sobon nja mu la e shi de e ma Totolo Pirisi ni ari gbogbogbo kankye yiride Melkizedek ma pirisi ni Mirikisi.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">Melkizedek Pirisi</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Melkizedek mu e ma seleki ni Salemu nja pirisi ni Mirikisi nsu girima la. E gom nja Abireyi kwanki de e ma kuma mbayi dege yanki de e sha geba seleki wuru e sa Abireyi Anabirika, <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />Abireyi ba Melkizedek daa a siki gom ni mbode e keleba dege anya yanki. Maana Melkizedek e shiya ma &lt;&lt;Seleki gangasi&gt;&gt;; sobon e ma seleki Salemu, maana seni yi ma, &lt;&lt;Seleki Selema.&gt;&gt; <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />Seleki Melkizedek e mani adaa nja amaa ba, e mani juriya ba, e mani pari ko karishe ni leyi ba, e ma kankye Yaa ni Mirikisi de e ma pirisi ni gbogbo na.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Ku kone yiri girima nseminji mu: De ari Abireyi adaa ni nsu adaatolo amu beyi daa a siki gom ni mbode e keleba anya yanki de yi! <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Doka Musa pala nkye juriya Lawi worede su ma pirisi na sua keleba daa a siki gom dege anya ntani, de su ma yayuwa su kode osu ma su ma juriya ni Abireyi na. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Melkizedek, e ma juriya Lawi na ba, nzun yomu e keleba daa a siki gom dege nani Abireyi e sa Abireyi anabirika e shi de Mirikisi yi anikowori. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />E ma mbo musu naba nsude e ma sa ntani anabirika e pi nsude ma keleba anabirika girima. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />A kiya beta ni Pirisi sua ba su daa a siki gom ni worede muntu; sede ni Melkizedek yaa keleba daa a siki gom anya worede mani leyi, yiride takada beta Mirikisi pala. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Ari mua nkye, kwanki de Abireyi beyi daa a siki gom, Lawi de juriya su ma keleba daa a siki gom ma beyi. <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />Sobon kwanki de Melkizedek gomu nja Abireyi, su tuku yapu Lawi woba, e tuku ma a siki adaatolo yi.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />E ma te anya sari nsu pirisi na su ba ntani Izireyila Doka. Kuzukam nde ANKI nsu pirisi e ma kyakya, ba yiride pirisi daa yaa zo ba, daa de e ma dege siki sari Melkizedek, ba kankye ni juriya ni Aruna ba. <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Sobon nde su shenja sari nsu pirisi, sua shenja doka du. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Obagizi amu, de su meyi beta a kiya e yi, butu dege siki juriya daa mbom la, nseda a siki juriya su taba ma pirisi ba. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Mu shina nkyawu nkye Obagizi mu su yapu yi dege siki juriya ni Yawuda la; Musa yi beta a kiya juriya yi ba kwanki de e meyi beta a kiya ni pirisi.<verse eid="HEB 7:14" /></para>
  <para style="s">Pirisi Kankye Melkizedek</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />Beta mu butu a pili; de pirisi daa mbom pelesa, de ma kankye Melkizedek. <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />E ma pirisi, ba te anya doka nja kayida ni nsebeki naba, sede te anya sori ni leyi de ma yaba. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Sobon beta Mirikisi nkye, &lt;&lt;Ka ma pirisi ni gbogbogbo, te anya sari ni Melkizedek.&gt;&gt; <verse eid="HEB 7:17" /><verse number="18" style="v" sid="HEB 7:18" />Su la doka susupe, sa a keteri, sobon rishi sori yi nja rishi anpani yi. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />Sobon Doka Musa yaa taba sa mbodaa e ma dedeta ba. Sede kuzukam su shiriya sadishiya daa de mwa zo kusa ni Mirikisi.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />Mirikisi kwa melese. Su taba melese ba kwanki de worosu su ma pirisi. <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />Sede Yesu ma pirisi te anya melese de Mirikisi yi nkye,</para>
  <para style="q1" vid="HEB 7:21">&lt;&lt;Mirikisi melese nsori</para>
  <para style="q2" vid="HEB 7:21">yaa taba shenja dishiyeyi ba:</para>
  <para style="q1" vid="HEB 7:21">&lt;Ka ma pirisi ni gbogbo.&gt;&gt;&gt;<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />Bombom mu, na sa Yesu mani tabeshi ni anikowori kyakyawu.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />Mu mani pirisi Worosu su nyowa: Sobon su muntu su sigeba ni yanki asu ba. <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />Sede Yesu zunwa ari gbogbo, sobon anki yi ni pirisi bise te anya nseda mbom ba. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Sobon yomu e mani sori, kuzukam nja kowoni kwanki, de sila ni worede su zo anya Mirikisi biya anya e yi, sobon yaa zunwa ari gbogbo yaa pata Mirikisi a kiya asu.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />Sobon yiri totolo pirisi na mua bila. E ma Nsuseki; e mani mbo basi ko lepi ba; su leyi sa a keteri dege nsu lepi nja su beyi girima de pi nsu bisi. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />E ma kankye ririgye toree pirisi ba; e ma munka sedeka kowoni nana sobon lepi yi mpari nja lepi ni ririgye ntani. E munka sedeka, sen daa a kiya ntani guru, kwanki de e beyi nki yi. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Doka ni Musa zabi ntani worede su deta de sua ma totolo pirisi ba; Sede Mirikisi yi anikowori nja melese, de zo a beyi doka, e zabi Yaa de dedeta gbogbo.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">Yesu Totolo Ni Pirisi</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Mbode mua pala e shiya ma mu mani Tolense Pirisi, de e zunwa a nani dama ni solota Nsu Girima a siki bisi. <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />Yaa yi anki kankye totolo Pirisi anya Nsuseki, anya bowuta ni gaskye de Obagizi shiriya, ba nsebeki ba.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />Kowoni totolo pirisi sua sayi de e munka kyawuta nja sedeka te nja Mirikisi, yomuna Kiristi du yaa mani mbode yaa munka. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Nde yaa ma siki durinya mu, yaa ma pirisi ba, sobon worosu su pirisi ma de sua munka kyawuta de doka Yawudawa yeda nshi. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />Anki de pirisi sua yi a laki Mirikisi e ma kankye kamani nja kuruma ni gaskye mbode ma bisi na. Sobon yomu na e paru nja Musa. A kwanki de yaa bila gina rugwa Nsuseki, Mirikisi gye yi nkye, &lt;&lt;Ki man tebeshi de ki yi kowon mbo yiride su nana ke nshi a kiya dunsi.&gt;&gt; <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Sede kuzukam, Mirikisi ba Yesu anki pirisi de pi na su kyawu, kankye yiride seda mu pi kyawu, de Yesu na ma nsu sakisi a sisika Mirikisi nja ntani, sobon seda mu e ma a kiya anikowori de su pi kyawu na.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />Nde seda ni pari yi mungu ba, ba delili ni seda ni bi. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Sede Mirikisi geni lepi ntani yi de nkye,</para>
  <para style="q1" vid="HEB 8:8">&lt;&lt;Nzi Obagizi nkye, Nana yaa zo,</para>
  <para style="q2" vid="HEB 8:8">De Na shiriya sabuwa seda nja ntani ni Izireyila nja ntani ni Yawuda.<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />Yaa taba ma kankye seda de Ni yi nja nsu adaatolo asu ba</para>
  <para style="q2" vid="HEB 8:9">A nana de Ni la su a nani butu bila kesa ni masa.</para>
  <para style="q1" vid="HEB 8:9">Su yi aminshi ni seda de Ni yi nja su ba,</para>
  <para style="q2" vid="HEB 8:9">de ni butu su a siki kesa ni Masa,</para>
  <para style="q2" vid="HEB 8:9">sobon yomu Mirikisi nkye Na zi su ba.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Mirikisi nkye, Kuzukam, nsum na yaa ma seda de Na yi nja ntani Izireyila,</para>
  <para style="q2" vid="HEB 8:10">Obagizi nkye, a kwanki nsu zo:</para>
  <para style="q1" vid="HEB 8:10">Na sa doka na a tunani asu</para>
  <para style="q2" vid="HEB 8:10">nja Na rubuta yi a dishiya asu</para>
  <para style="q1" vid="HEB 8:10">Na ma Mirikisi asu</para>
  <para style="q2" vid="HEB 8:10">nja osu sua ma ntani na.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Ba nseda su de yaa kokoyi yayuwa e yi ba</para>
  <para style="q2" vid="HEB 8:11">ko e gye dengeri su, nkye, &lt;Ki shina Obagizi.&gt;</para>
  <para style="q1" vid="HEB 8:11">Sobon guru asu sua shina ni,</para>
  <para style="q2" vid="HEB 8:11">dege dende ari totolo.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />Na yape lepi su</para>
  <para style="q2" vid="HEB 8:12">Na kwa turunwa lepi su gagaba.&gt;&gt;<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />A kiya beta ni sabuwa seda mu, Mirikisi sa seda ni pari sopa; guru mbode sopa nja bebeta yaa dede ba de yaa beeta.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">Yiri Bowuta A bisi Nja Durinya</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Seda ni pari ma ni doka ni bowuta nja anya bowuta nsuseki de ntani shiriya a durinya mu. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />Ntani Izireyila gina rugwa ba Mirikisi, a siki yi e ma ni gwala lete pitila, teburu nja buredi de su beyi ba Mirikisi. Woze yi sua sukwa e yi Anya Nsuseki. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />A beyi labile ni bi, rugwa daa ma de sua sukwa yi anya de pi Seki. <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />A siki anya de pi seki mu begedi aziripa daa ma de sua suwuta tularee nsu kemeshi nja Akpati Anikowori mani zinari a keteri yi guru. Akpati Anikowori mu su ripe yi ni aziripa a siki yi gongo ni aziripa nja maana ma, nja gwala tepiya ni Aruna de tompa ni genya, nja dunsi bi palapa de su rubuta doka a siki yi. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />A bisi Akpati seda meleku bi ma a kiya e yi de su ma nana dereja Mirikisi, meleku woromu su bure kelebeta asu ripe anya de Mirikisi yaa nana toseyi nja yape lepi. Sede kuzukam e ma kwanki de Na gye ku guru mbo naba.<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />Yomuna de su gyala guru mbo woroni. Pirisi su ma a woze ni rugwa kowon nana su ma yi anki su, <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />sede tolense pirisi e shi dandaa e yi na e ma yuru a sikisiki rugwa de yi lepa, son daa a shekera, e ma yuru ni zini, de yaa munka Mirikisi sobon kiya yi nja lepi de ntani yi de su shina nkye e ma lepi ba. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Yomuna Aworo Nsuseki ma nana nkye turiki ni yuru anya Nsuseki mu tuku bure woba tunde rugwa ni pari tuku sakisi ayan. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />Da mu e shiya ma alama ni kwanki mu, E ma nana nkye kyawuta nja sedeka de Pirisi munka te nja Mirikisi yaa sa dishiya nsebeki de mayi bowuta e ma sere ba. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />Tunde e ma a kiya mbosi, riki ni sha, nja worosu buki ni wonkye nki. Woromu guru ma doka ni geni ndani la, kapi de Mirikisi kapa sabuwa doka. <verse eid="HEB 9:10" /><verse number="11" style="v" sid="HEB 9:11" />Sede Kiristi rigye zo ma tolense pirisi ni mbo kyakyawu de rigye ma kuzukam. E yuru a Rugwa de pi girima nja kyawu soseyi; ba rugwa de nsebeki na gini ba, woto, yiri rugwa ni ma durinya mu ba. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />Kiristi yuru anya de Pi Seki son daa na, e la zini ni nsu akuya nja nsu saa de e munka sedeka ba; sede, e yi anpani ni zini yi de mu samu sila ni gbogbo. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Zini nsu akuya nja saa nja busi yaa saa su yaapi a nki ntani worede su man seki ba, nsum ma sa nsu dola ema mere dola a nki. <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />Tunde nsum ma gaskye la, mina mua pala a kiya zini Kiristi! de e beyi kiya e yi te nja Mirikisi te anya Aworo ni gbogbo e munka nki yi sedeka dedeta ba Mirikisi. Zini Yesu yaa shire tunani dishiya mu sere de mu juyi bila mbo mumungu, sobon de mu bowuta Mirikisi Nsu Leyi!<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />Sobon delili mu na Kiristi ma nsu sakisi a sisika Mirikisi nja ntani a siki sabuwa seda mu, sobon worede Mirikisi sukwa su, su samu anabirika ni gbogbo de Mirikisi yi su anikowori. Da mu e ma yomu la sobon muntu daa rigye paru de ba ntani yenshi dege lepi de su yi a kwanki de seda ni pari tuku ma.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />Nde nseda yi seda a kiya nsude yaa si gado yi e ma dole na nseni e muntu tuku. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Sobon anikowori ni nsu si gado e mani sori ba sobon nsude yi anikowori e man leyi; ba nsude yaa yi anpani ni anikowori yi ba, se a beyi de muntu. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />E shiya sa anikowori ni pari e mani sori de yaa sila ni ntani ba, se su yi anpani ni zini. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Beyi de Musa gye ntani guru mbode ma a siki takada doka Musa. Se e la zini nsu saa nja akuya, e dama e yi nja riki, se e la ntasi dende de sua sukwa yi isop nja gesa ni timshiya de ma zanza e yaapi a siki takada doka nja guru ntani. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />Musa nkye, &lt;&lt;Osu na ma zini seda, de Mirikisi beyi doka nkye ntani su biya.&gt;&gt; <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Yomuna du Musa kwa yaapi zini a rugwa Mirikisi nja guru mbode sua yi anpani nshi ni bowuta. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Gaskye, te doka Musa na guru mbo ni zini na yaa ma sere, zini te nya ba sua yape lepi ba.<verse eid="HEB 9:22" /></para>
  <para style="s">Sedeka ni Kiristi La Lepi</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Mbo worosu mu, e ma kamani ni mbo worede su ma a bisi, dole su wonkye su a turiki ni. Sede mbode ma a bisi nkyasu sua bila kyakyawu sedeka de pi worosu mu. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />Sobon Kiristi yuru a siki anya Pi Seki de nsebeki na yi ba, de e ma kamani ni anihi mbode ma a bisi. E yuru a siki bisi nkiya yi, anya de e beyi kiya yi a geba Mirikisi sobon mu. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Tolense Pirisi ni Yawudawa yaa yuru anya Pi Seki kowon shekera ni zini daba. Sede Kiristi yuru a siki anya ni de e munka nki yi kowon kwanki naba, <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />sobon yomu la, e ma dole na Yesu e Genbeki nyowa tun dege pari durinya. Sede kuzukam, e pelesa kiya yi son daa a karishe sana sobon de e butu lepi ntani te anya beyi kiya yi sedeka. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Konse e ma dole na e muntu sen daa, a beyi nsum Mirikisi yaa yi shiriya, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />Yomuna Mirikisi munka Kiristi sedeka son daa de e la lepi ntani nyowa; Yaa kuma zo ni bi, ba yaa zo de e la lepi na ba, sede e sila ni worede sua pekye yi.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Doka ni ntani Yawudawa ma kamani mbo kyakyawu de yaa zo a geba na; e shiya ma aniyi mbo woroni ba. Sobon yaa taba sila ntani dege lepi su ba, te sedeka de sua beyi shekera beyi shekera? <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Nde ntani de sua bowuta Mirikisi wonkye lepi su, sua kwa yi tunani lepi ba, yomuna guru sedeka yaa sakisi. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Sede sedeka mu, sua munka yi a kowon shekera de su turunwa ntani lepi su na, <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Sobon zini ni saa ko ni timshiya yaa taba shire lepi ba.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />Sobon delili mu na, Kiristi yaa bilade zo a siki durinya, e pala gye Mirikisi nkye:</para>
  <para style="q1" vid="HEB 10:5">&lt;&lt;Ka bila Sedeka nja beiko ba,</para>
  <para style="q2" vid="HEB 10:5">sede ki ba ni nki.<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />Ka bila de ntani su beyi sedeka ni daba susuwuta a begedi ba</para>
  <para style="q2" vid="HEB 10:6">ko sedeka ni shire lepi su ba.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />Se Kiristi nkye, &lt;Mirikisi E ni naka anya mu,</para>
  <para style="q2" vid="HEB 10:7">Obagizi, na yi mbode ka so,</para>
  <para style="q2" vid="HEB 10:7">Yiride e ma rubutu a takada doka Musa.&gt;&gt;&gt;<verse eid="HEB 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />A pari e pala nkye, &lt;&lt;Sedeka nja beiko, nja sedeka daba susuwuta a begedi, nja sedeka ni yape lepi ba,&gt;&gt; &lt;kode doka yaa bilade su yi su yomu&gt;. <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />Se e pala nkye, &lt;&lt;Obagizi, E ni naka anya mu, de na yi mbode ka so.&gt;&gt; Se Mirikisi la sedeka ni wuri e sa sedeka ni Kiristi amomoko ni bi anya su. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Sobon Yesu Kiristi yi mbode Mirikisi yaa bila de yi, guru amu su wonkye mu dege lepi te anya sedeka de yi ni nki yi son daa sobon guru amu nsuseki.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />Kowoni pirisi ni Yawudawa sua yi ANKI asu kowon nana sua munka sedeka yirida a kwanki nyowa; sede sedeka mu yaa taba la lepi ni ntani ba. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Sede Kiristi munka sedeka son daa sobon lepi, sedeka de man kyawu gbogbo, e zunwa a nani dama ni Mirikisi. <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />Anya ni e pekye ari Mirikisi sa nsu oboki gebeyi a kisi seni yi de e taka su. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Ni sedeka daa mu, se, Mirikisi sa ntani su ma dedeta gbogbo worede su wonkye su dege lepi.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />Se Aworo Nsuseki kwa beyi sheeda mu a kiya Yesu. E pala nkye,<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />&lt;&lt;Nsum nama seda de Na yi nja su</para>
  <para style="q2" vid="HEB 10:16">Obagizi nkye, mbode Na yi mpari naka a kwanki nsu zo.</para>
  <para style="q1" vid="HEB 10:16">Na sa doka na a dishiya su,</para>
  <para style="q2" vid="HEB 10:16">Na sayi a siki tunani su.&gt;&gt;<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />Se e kwa pala nkye: &lt;&lt;Na turunwa ni lepi su nja mungu de su mayi gagaba dirim.&gt;&gt; Mma kwa turunwa nsu gagaba.&gt;&gt;<verse eid="HEB 10:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 10:18" />De Mirikisi yape ntani lepi su, sedeka ni la lepi ma kuma ba<verse eid="HEB 10:18" /></para>
  <para style="s">Mu Zo Kusa Ni Mirikisi</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Yayuwa na, tunde mwa sadishiya nkye mwa yuru anya Pi Seki te anya muntu ni Yesu, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />E bure mu turiki sabuwa, turiki ni leyi, te anya labile, de ma nki yi, <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />Mu mani totolo pirisi nsu kone gizi ni Mirikisi. <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />Se mu zo kusa ni Mirikisi ni dishiya kyakyawu nja tabeshi gaskye, ni dishiya mu sere de ma wonkye dege lepi nja wonkye nki ni riki sere. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Bila de mu sakisi nsori a kiya sadishiya, sobon mu yeda nkye Mirikisi yaa yi mbode e yi anikowori. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Bila de mu kula ni nkyamu, de mu sua nkyamu nto anya so nja yi mbo kyakyawu. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />Kede mu bila tala kiya mu, yiride worosu su su ma yi. De mwa yi yomu, se mu ja nkyamu sori guyam, tunde mu shina nkye nana zo ni Obagizi yi kusa.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Sobon ba woni sedeka de yaa la lepi nde mu sigeba ni yi lepi a beyi de mu rigye shina gaskye. <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />De yaama yomu, mbode rigye e shiya ma pekye a siki womba ni shiriya de yaa zo nja wuta nsu zapi de yaa shuwuta nsu oboki geba Mirikisi! <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Du nsude ki biya doka Musa sua kisa yi ba toseyi anya sheeda ni ntani bi ko wuku. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Yaya, na, worede nene Yaa Mirikisi? Nsude yi banza ni zini ni seda Mirikisi de wonkye su dege lepi? Nsude basi Aworo ni aniyeri Nsuseki, woni mumungu poro na kwa geni sua yi nse ni? <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Sobon mu shina nsude nkye, &lt;&lt;E ni na na lama; lama ma nna na,&gt;&gt; e kwa nkye, &lt;&lt;Obagizi yaa yi ntani yi shiriya.&gt;&gt; <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />Yaa ma mbo womba de nsebeki puari a nani Mirikisi nsu leyi. <verse eid="HEB 10:31" /><verse number="32" style="v" sid="HEB 10:32" />Ku turunwa yiri mbode paru nja ku a beyi. A kwanki de bishe, beyi de asikye Mirikisi nana a kiya ku, ku Genbeki mbo nyowa, nzun yomu ku sakisi nsori. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />A worosu kwanki su ma basi ku a pili nja ku Genbeki soseyi, a worosu su kwanki ku la kiya ku ma daa nja worede su yi su yomu. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Ku zi toseyi worede su ma a jaru, ku yi peri siki de su keleba ku mbode ku man shi, sobon ku shina nkye oku nkiyaku ku mani mbo kyakyawu de yaa ma ari gbogbo. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />Sobon yomu ku sakisi nsori dishiya sobon nani wuta ku yaa ma totolo. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />E kamata de ku yi takuwa, sobon de ku yi mbode yaa jima Mirikisi de ku keleba mbode e yi ku anikowori. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />Yiride, takada Mirikisi nkye,</para>
  <para style="q1" vid="HEB 10:37">&lt;&lt;Yaa dede ba,</para>
  <para style="q2" vid="HEB 10:37">nsu zo mu yaa zo;</para>
  <para style="q2" vid="HEB 10:37">yaa taba dede ba.<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />Ntani na gangasi, sua mani leyi te anya beigaskye;</para>
  <para style="q1" vid="HEB 10:38">Sede nde nseda a siki su juyi mbayi,</para>
  <para style="q2" vid="HEB 10:38">Na zi dadi yi ba.<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Sede omu muma ntani de su juyi beyi te alaka na ba, sede worede su beigaskye ni sila su na.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">Beigaskye</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Beigaskye e shiya ma tabeshi nkye mbode mu sadishiya mua samu kode nkye mu geni yi ni ndani mu ba sede mu yeda mwa keleba. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Te anya beigaskye la nsu adatolomu jima Mirikisi.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />Sobon te anya beigaskye na mu shina nkye Mirikisi yi durinya te anya kelima e yi, sobon mbode mwa geni mu su yi te anya mbode mua geni ba na.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />Beigaskye na sa Abila beyi sedeka de jima Mirikisi pi yayiwa e yi Kayinu. Te anya beigaskye, Abila samu jima anya Mirikisi nkye e ma nse gangasi, sobon Mirikisi nkiya yi yeda nsedeka yi, te anya beigaskye Abila, kode nkye e muntu e tuku meyi beta.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />Te anya beigaskye la Enoku muntu ba. momoko yomu, su leyi ta bisi anya Mirikisi, nseda geni yi ba, sobon Mirikisi leyi ta bisi. Beta Mirikisi pala nkye kami de su la Enoku ta bisi su beyi sheeda nkye e jima Mirikisi. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Ba nsude yaa jima Mirikisi nde e beigaskye ba, sobon du nsude yaa zo anya Mirikisi dole na e beigaskye nkye Mirikisi ma nja yaa ba worede sua bila e yi nani wuta.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />Te anya beigaskye na Nuwu zi gila ni Mirikisi a kiya mbode yaa paru a geba de e geni ba. Nuwu yi biyaya nja Mirikisi e ki la kwanto totolo de e shi nja ntani gizi yi su sila. Te anya yomuna Mirikisi bebeta durinya mu, se Nuwu keleba gangasi Mirikisi te anya beigaskye.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />Te anya beigaskye na Abireyi yi biyaya kwanki de Mirikisi sukwa yi de e te a kesa de Mirikisi yi anikowori de yaa beyi. E bila kesa e yi e shina ko angana yaa te ba. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Te anya beigaskye Abireyi ma bakwe a kesa de Mirikisi yi anikowori de yaa beyi. Abireyi zunwa a rugwa, nja Ishaku nja Yakubu, de su keleba anikowori yiri daa dege anya Mirikisi. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />Sobon Abireyi zunwa ma pekye totolo geri de Mirikisi shiriya nja gina, geri totolo de kutiri kapa.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />Te anya beigaskye e shina sa Abireyi ma adaa, kode nkye e rigye sopa soseyi nja Saratu awari mase e mani yaya ba. Yaa pekye Mirikisi de sika anikowori yi. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Kode Abireyi ma kankye mumuntu nse e sopa yaa yapu ba, Mirikisi beyi yaya nyowa kankye kemu bisi nja yaya kankye nyashi ndani riki.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />Guru ntani worosu mu su yi zunwa beigaskye ari nana de su muntu, su keleba anikowori de Mirikisi yi su nshi ba, sede su geni yi nyisa nja su keleba e yi ni peri siki de su geni yi, nja su kwa yeda su ma bakwe la a siki durinya mu. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Worede su pala yomu, su nana a pili nkye su ma bila kesa ni kiya su. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Nde ntani worosu mu su yi tunani kesa de su bila e yi a beyi ba, da sua man dama de su kuma nbeyi. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />De yaama yomu, su yi memeri kesa kyakyawu de sua bila, woto bisi. Sobon yomu Mirikisi yaa zi kumnya de su sukwa yi Mirikisi asu ba, sobon Mirikisi gyala geri totolo sobon nsu.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />Te anya beigaskye na Abireyi, la yaa yi Ishaku beyi sedeka, a kwanki Mirikisi gwada e yi. Abireyi de e shiya ma nsu de yaa keleba anikowori mu, yaa so de e la yaa daa kin beyi sedeka, <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />kode nkye Mirikisi gye yi nkye te anya Ishaku na ka mani juriya de ni yi anikowori.<verse eid="HEB 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 11:19" />Sobon Abireyi shina nkye Mirikisi yaa yiya dege Ishaku a kumsha, Abireyi keleba Ishaku nleyi dege muntu.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />Te anya beigaskye na Ishaku sa yaya ni Yakubu nja Isuwa anabirika a kiya mbode paru nsu a geba.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />Te anya beigaskye na Yakubu sa kowoni yaa ni Yusupu anabirika kapi de e muntu, nja e yi Mirikisi bowuta de kwana a kiya gwala e yi.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />Te anya beigaskye na Yusupu, a kwanki de e kusa muntu, Yusupu yi beta a kiya butu ni yaya ni Izireyila dege kesa ni Masa nja e kwa ja su de su la keshi nde su te bila Masa.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />Te anya beigaskye na Adaa nja Amaa ni Musa la yi boyi wonta wuku a beyi de su yapu yi. Sobon su geni ema yaa kyakyawu la, sua zi womba ni ki biya doka ni seleki ba.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />Te anya beigaskye na Musa, de yi girima, e ki de su shina nkye e ma yaa ni yaa Piriyona ni mase. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Musa yeda de Genbeki nja ntani Mirikisi momoko de e yi zunwa ni zi dadi ni lepi ni kwanki piri. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Musa yeda de Genbeki nja ntani Mirikisi sobon ni Kiristi de pi dereja guru mbo nani de ma a kesa ni Masa, sobon ndani yi yaa geni nani wuta de yaa samu a geba. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />Te anya beigaskye na Musa bila kesa Masa ba womba ni anwashi ni seleki. sobon e geni Mirikisi de ndani nsebeki yaa geni ba e ki de e kuma nbeyi. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Te anya beigaskye na Musa shiriya buki ni nyenteri e gye su nkye su shapa zini a kopa, sobon kede Meleku ni muntu e kisa yaya pari ni Izireyila ba.<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />Te anya beigaskye na ntani ni Izireyila nyenteri totolo riki a kyekeri kesa; de ntani Masa sua yi kokori de osu ma su nyenteri du, riki alaka su.<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />Te anya beigaskye na golonwa ni Yeriko puari a kisi a beyi de yaya Izireyila gyowe yi a nana bokwe.<verse eid="HEB 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 11:31" />Te anya beigaskye na su kisa Rahab mase kilaki nja worede su ki zi Mirikisi, sobon e la nsu leka kesa Izireyila boyi.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />Ni sigeba? sobon Ni man kwanki nyowa de na yi beta a kiya ni Gidiyon nja Barak, nja Samsi, nja Yepta, nja Dowuda, nja Samela nja nsu anebi ba. <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />Te anya beigaskye su yi yanki nja kesa nyowa su yi nasara. Su yi mbode ma kyakyawu se su keleba mbode Mirikisi yi su anikowori. Su ripe baki zaki, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />su bita sori wuta, su sila ntani worede sua bila kisa su ni obalaba. Su ma mere sori, sede su zo ma nsori; su man sori anya yanki nja su shi shoja ni kesa bombom ni yanki. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Te anya beigaskye mata keleba dengi asu de muntu kuma ma nleyi.</para>
  <para style="p" vid="HEB 11:35">Worosu, ki yeda ni pushe, su muntu a siki takaasi de su dege nleyi de yaa pi kyawu. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />Su yi worosu dala nja dukwa, worosu su su domuna su ni serika kutiri a jaru. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Su kutiri su ndunsi, su laba su keshi bi, su kisa su ni obalaba. Su mayi kukyani gyewe ni keikei ni pata akuya, su mayi zunwa potoruwa, nja takaasi nja Genbeki. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />Durinya ma kyawu ba e yi su memeri ni zunwa ba. Sua kukyani a denka nja a kiya dunsi totolo, nja a siki koga dunsi nja romu a kisi.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />Guru ntani mu jima Mirikisi sobon beigaskye su, nzun yomu guru asu muntu ba nsude keleba mbode Mirikisi yi su anikowori. <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />Sobon Mirikisi shiriya mbo kyakyawu ba mu. Nupi ni Mirikisi e shiya ma de omu nja su gabada mwa dedeta.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">Mirikisi Adaa mu</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Nkayomu, tunde muma ni sheeda ntani nyowa de su gyowe mu. Bilade mu butu guru mbode tengele mu a turiki, nja lepi de yaa domuna mu, se mu yi gudu ni tatarigye de ma a geba mu. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />Bila de mu nya ndani mu anya Yesu, e shi de beigaskye mu ma dege pari ta karishe. E yi takuwa ni Genbeki ni muntu a gidiri! sobon peri siki de yaa pekye nyi e damu ni kumnya ni muntu a gidiri ba, nja sede kuzukam e zunwa a nani dama kingbolo solota Mirikisi. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />Ku yi tunani a kiya Genbeki de e sha; yiri ki zini de samu dege nani nsu lepi! Sobon yomu kede mu bila nkiya mu de mu butu dishiya.<verse eid="HEB 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4" />A siki topula ku a kiya lepi ku tuku ki ari ku keyi baki muntu woba. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />Ku musi ni kelima ni ja sori guyam de Mirikisi pala gye ku yaya yi?</para>
  <para style="q1" vid="HEB 12:5">&lt;&lt;Mirikisi nkye, Yaa na, kede ku la yi kankye wasa nde Obagizi yi ku gyala,</para>
  <para style="q2" vid="HEB 12:5">nja kede ku lense dishiya nde Obagizi kwabe ku.<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Sobon Obagizi yaa gyala kowoni nsude yaa so,</para>
  <para style="q2" vid="HEB 12:6">nja yaa poro kowoni nsude e yeda de e ma yaa yi.&gt;&gt;<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />Ku kadishiya ni Genbeki de kwa sha kankye yiride Adaa yaa poro yaa yi; Mirikisi yaa yi ku yomu sobon de ku ma yaya yi la. Ko woni yaa na adaa yi yaa poro yi ba? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Nde e poro ku yiride yaa yi ririgye yaya yi ba, ema kankye kuma yaya yi naba, sede yaya shegye. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />A keteri ni nsu adaa mu ni nki, nde su ma poro mu nzun yomu mwa ba su girima. Yaya na yaa pi mu kyawu nde mu beyi kiya mu te nja adaa mu ni aworo de yaa yiya ba mu leyi! <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Nsu adaa mu ni durinya sua ba mu poro a kwanki piri, yiride su geni de Jima su; sede Mirikisi poro mu sobon de e yi mu kyawu, sobon de muma nsuseki kankye e shi. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Kowoni poro de su mayi mu, yaa samu beki siki, ba peri siki na ba. Sede a beyi ntani de su poro su sua kokoyi yiride sua beyi girima te anya poro de su sha, sua samu selema ni nani wuta ni leyi gangasi.<verse eid="HEB 12:11" /></para>
  <para style="s">Gila A kiya ki Mirikisi</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Sobon yomu, ku munka nani ku de geji de ku samu sori nja ja guyam ku sori. <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />Ku sigeba yi tepiya a turiki tiriri, de seni de sharuwa yaama kputuru ba, sede sua worikye.<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Ku yi kokori de ku yi zunwa selema nja guru ntani, nja ku yi zunwa seki, sobon nseda yaa geni Obagizi ba se ni seki. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Ku kone kede nseda ku juyi dege aniyeri ni Mirikisi nja kede nseda ku e ma kankye ntasi nsu lasi de yaa girima de sa ngala nja de yaa ma ba ntani guru guba. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />kede nseda ku e ma nsu lepi nungwe ko e ma mere ali ni Mirikisi kankye Isuwa, sobon gongo ni mbosi daa e lesa gado ni yaa pari. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />A beyi yomu, ku shina yiride Isuwa bila de adaa yi sa yi anabirika; su ki yi, sobon e samu turiki de yaa shenja mbode yi ba, Kode Isuwa ologba adaa yi ni anwe. <verse eid="HEB 12:17" /><verse number="18" style="v" sid="HEB 12:18" />Oku ku zo yiride ntani Izireyila zo ba. Ba e ma ogbo ni sina de sakisi a beyi naba de yaa suwuta, ogbo de ripe ni dopuwa beki kiri, nja totolo agaguwa; <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />wula koho, ni totolo murinya. De ntani zi murinya mu su zi womba su ologba de kede murinya mu e yi beta nja su gagaba. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />Sobon sua yi yaa ka dishiya ni doka de nkye, &lt;&lt;Nde daba daa kpa totolo ogbo mu, dole na de su kutiri ndunsi de e muntu.&gt;&gt; <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Mbode su geni e ma mbo womba, Musa pala nkye, &lt;&lt;E ni ma kakada ni womba.&gt;&gt;<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />Sede ku zo anya ogbo Siyona, totolo geri Mirikisi nsu leyi, de ma Wurishelima a bisi, nja anya de meleku dupu ni dupu tala yi peri siki. <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />Ku zo anya tala ni peri siki ni yaya Mirikisi ni pari de seni su rubuta a bisi. Ku zo anya ni Mirikisi, nsude yaa yi ntani guru shiriya, nja anya aworo ni ntani gangasi yaa ma dedeta. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />Ku zo anya Yesu nsude sakisi a sisika mu nja Mirikisi de zo ni sabuwa seda, nja zini de nya de yi anikowori mbo kyakyawu, de pi zini ni Abila.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />Ku kula, kede ku ki zi nsude meyi beta nja ku. Nde nsu adaatolo mu sila dege anwashi ni Mirikisi ba de su ki zi kelima beta e yi anya Musa, yaa ma nkye kona nja mu, nde mu ki zi nsude yaa yi beta nja ku dege bisi! <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />A kwanki ni murinya yi zizika kisi mu, sede kuzukam e yi anikowori nkye, &lt;&lt;Na zizika kisi na kurum ba sede nzun bisi du.&gt;&gt; <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Kelima mu, &lt;&lt;Sen daa jaja&gt;&gt; Nana nkye Mirikisi yaa zizika guru mbode yi mbode yaa zizika ba na yaa rigye.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />Nkayomu, mu gbede Mirikisi, sobon mu keleba solota de yaa taba zizika ba. Bila de mu gbede nja bowuta Mirikisi a turiki de a jima yi ni girima nja womba. <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />Sobon gaskye Mirikisi ma kankye wuta de yaa si kowoni mbo.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">Yiride Kwa Jima Mirikisi</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Ku sigeba nso nkiyaku kankye nsu biya Yesu. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Kede ku bila yi bakwe nnaba a gizi ku. Sobon yomuna worosu su keleba meleku a gizi asu ba nshina su ba. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Ku turunwa ni worede su ma a jaru, kankye oku ma kuma a jaru nja su. Turunwa ni worede su ma Genbeki, kankye oku ma kuma Genbeki du.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />Amere e ma mbo dereja anya ku guru, nseminji amere nja mase amere su yi aminshi nja nkiya su. Sobon Mirikisi yaa yi guru worede su meyi nungwe nja worede su ma kwana nja mata nseda shiriya. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />Ku laba kiya ku dege so ni gyolo nja ku yi gbogila ni mbode ku manshi. Sobon Mirikisi pala nkye, &lt;&lt;Na taba bila ku ba; Na taba mosi nku ba.&gt;&gt; <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />Bila de mu ma nsori dishiya, de mu nkye,</para>
  <para style="q1" vid="HEB 13:6">&lt;&lt;Obagizi e shiya ma nsu sua mu nto, Na taba zi womba ba</para>
  <para style="q2" vid="HEB 13:6">Mina nsebeki yaa yi ni?&gt;&gt;<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Ku turunwa ni toree ku ni da, worede su kokoyi ku kelima beta Mirikisi. Ku kone yiri zunwa de su yi kapi su muntu, ku biya seni beigaskyesu. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Yesu Kiristi e ma yiri daa jiya, yawu nja gbogbo.<verse eid="HEB 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 13:9" />Kede ku bila kokoyi sabuwa de la ankeli ku bila kyakyawu turiki. Aniyeri Mirikisi yaa sa dishiya ku de ma nsori, ba biya alada a kiya ni mbosi ba; worede su biya doka mu e mani moriya anya su ba. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />Pirisi worede sua yi anki anya bowuta ntani Yawudawa su mani yenshi ni si mbosi anya munka sedeka mu ba. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Tolense ni pirisi ni Yawudawa keyi zini ni daba zo atotolo anya Nsuseki te munka kankye sedeka ni wonkye lepi; sede nki ni daba sua gesa yi a woze ni anya tala. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Sobon delili mu Yesu muntu a beyi totolo geri, sobon de e wonkye ntani dege lepi ni zini e yi. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Nkayomu, bila de mu te a beyi geri de mu zi kumnya nja shi. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Sobon mu man totolo geri de ma namu ni kiya mu a durinya mu ba, sede mwa sa ndani pekye totolo geri de yaa zo.<verse eid="HEB 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15" />Nkayomu, bila de mu sigeba ni yobo Mirikisi de ma kankye sedeka mu te anya Yesu, de ma beiko de beyi te arishiya de pala nkye e ma Obagizi. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Kede ku bilayi kyakyawu nja sua nkiyaku nto nkiku de mu yi mbo kyakyawu nja de mu laba mbode mu manshi nja worosu su, sobon yiri sedeka mu yaa jima Mirikisi<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Ku yi biyaya ni kowoni toree ku nja ku yi mbode su gye ku. Sobon osu na sua kpanku dishiya ku, osu na ma ntani de dole sua beyi kikiriga a kiya ku. Ku yi mbode sua bila de su yi ANKI su ni peri siki; nde e ma yomu ba sua yi ni basi leyi, yomu taba sua ku nto ba.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Ku sigeba nlepa sobon omu. Sobon dishiya mu e ma sere, sobon mwa bila de mu yi mbo kyakya kowoni kwanki. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Mma ologba ku soseyi de ku yi lepa de Mirikisi kuma ni mbayi zo anya ku.<verse eid="HEB 13:19" /></para>
  <para style="s">Lepa Karishe</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Bila Mirikisi de beyi selema, de te anya zini seda e dege Obagizi mu Yesu dege kumsha, Yesu de ma kankye totolo nsu kpanku timshiya, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />Na yi ku lepa de Mirikisi sika ku ni kowoni mbo kyakyawu de ku yi mbo de jima Mirikisi. Te anya Kiristi, nsude guru dereja ma na yi gbogbo! E ma yomu.<verse eid="HEB 13:21" /></para>
  <para style="s">Kelima Karishe</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Mma ologba ku, yayuwa de ku yi ankuri ni manki ni ja sori guyam; takada de Ni rubuta ku nshi nyowa ba.<verse eid="HEB 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 13:23" />Mma bila de ku shina nkye yayiwa mu Timoti su butu yi jaru. Nde e zo seberi, E ni nja shi mwa zo anya ku de e geni ku.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Geshe ni guru toree ku nja guru ntani Mirikisi. Nsubiya Yesu de ma kesa Italiya su ma gesheku.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />Bila de aniyeri Mirikisi e ma nja ku guru.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>