<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Gwandara</book>
  <para style="toc3">2 Bit</para>
  <para style="toc2">2 Biturusu</para>
  <para style="toc1">Takada Ni Bi dege Biturusu</para>
  <para style="mt2">TAKADA NI BI NI</para>
  <para style="mt1">Biturusu</para>
  <para style="imt">Waa ma e ke</para>
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />Takada butu anya Sima Biturusu, de ma bunwa nja yamanki Yesu Kiristi,</para>
  <para style="p" vid="2PE 1:1">Te anya worede su samu gangasi ni Mirikisi mu nja nsu sila mu Yesu Kiristi de ba mu beigaskye nsu dereja yiri namu:<verse eid="2PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2" />Bila de aniyeri Mirikisi nja selema yi ema nja ku teke te anya shina Mirikisi nja Yesu Obagizi mu.<verse eid="2PE 1:2" /></para>
  <para style="s">Zunwa Ma Kyakya Nja Nsubiya Yesu</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />Mirikisi a siki sori yi e ba mu guru mbode mua bila de mu yi zunwa de jima Mirikisi te turiki shina de e sukwa mu a siki dereja nja kyakyawu gangasi yi. <verse eid="2PE 1:3" /><verse number="4" style="v" sid="2PE 1:4" />Te turiki mbo woromu naa e ba mu totolo kyawuta de e yi anikowori yi nsu dereja, sobon te turiki kyawuta mu la kwa sila dege mungu memeri de ma a siki durinya de mu yi zumunshi a siki nki yi ni Mirikisi.<verse eid="2PE 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2PE 1:5" />Sobon delili mu, ku yi guru kokori aku de ku ja beigaskye ku ali kyakyawu; ali kyakyawu ku, ku ja yi shina Mirikisi; <verse eid="2PE 1:5" /><verse number="6" style="v" sid="2PE 1:6" />a siki shina Mirikisi, ku ma nsu ka kiya ku, a siki ka kiya ku ma nsu takuwa a siki takuwa ku ma nsu ali yiri ni Mirikisi; <verse eid="2PE 1:6" /><verse number="7" style="v" sid="2PE 1:7" />ali yiri ni Mirikisi, ku ma nsu so yayuwa ku; a siki so yayuwa, ku ja so ni ntani ni gaskye. <verse eid="2PE 1:7" /><verse number="8" style="v" sid="2PE 1:8" />Nde ku mani ali mu teke, yaa taba sa ku de kuma nsu mere yaya kankye ntani ba nja mere girima a siki shina ku Obagizi Yesu Kiristi. <verse eid="2PE 1:8" /><verse number="9" style="v" sid="2PE 1:9" />Sede nde nsude lesa ali mu, e ma kankye nsude yaa geni geba ba, e ma makapi la, nja e mosi nkye Obagizi Yesu Kiristi rigye shire lepi yi de bise.<verse eid="2PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10" />Nkayomu, yayuwa na, se ku ja guru kokori de ku sa sukwa ku nja zabi ku e ma mbo keleba anya Mirikisi, sobon nde ku yi mbo mu, kwa taba pauri anya beigaskye ku ba, <verse eid="2PE 1:10" /><verse number="11" style="v" sid="2PE 1:11" />yomuna Mirikisi yaa yi ku totolo naba a siki solota ni Obagizi mu Yesu Kiristi nsu sila mu.<verse eid="2PE 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />Sobon yomu Na kuku turunwa ku kowoni nana a kiya mbo woromu, kode ku rigye shina su wo ku sakisi nsori a siki gaskye de ku keleba. <verse eid="2PE 1:12" /><verse number="13" style="v" sid="2PE 1:13" />Ni geni e ma kyakya la de ni kuku turunwa ku tunde ni tuku man leyi a siki nki mu. <verse eid="2PE 1:13" /><verse number="14" style="v" sid="2PE 1:14" />sobon Ni shina Ni kusa muntu wo, yiride Obagizi mu Yesu Kiristi rigye nana ni nshi sere. <verse eid="2PE 1:14" /><verse number="15" style="v" sid="2PE 1:15" />Sobon yomu Na yi kokori na de ni geni nkye ko a beyi de ni bila ku kwa kuku turunwa ni mbo worosu mu a siki dishiya ku.<verse eid="2PE 1:15" /></para>
  <para style="s">Worede Geni Dereja Kiristi</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />A kwanki de mu gye ku manki nabari kyakyawu a kiya Yesu Kiristi de nana sori ni zo yi, mu yi ku kokongye na ba ko mu yi ampani ni simi mu ba, sede ni ndani mu mu geni girima dereja yi. <verse eid="2PE 1:16" /><verse number="17" style="v" sid="2PE 1:17" />Sobon e keleba girima nja dereja anya Mirikisi Adaa de mu zi murinya butu anya Mirikisi Nsu Girima ni Dereja, nkye, &lt;&lt;Da mu na e ma Yaa na, de mma so; Ni shi na dishiya na yaa yi peri siki&gt;&gt; <verse eid="2PE 1:17" /><verse number="18" style="v" sid="2PE 1:18" />Omu nkiya mu mu zi murinya mu de zo butu a bisi de muma nja shi a ogbo nsuseki.<verse eid="2PE 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19" />Muma tebeshi ni kelima ni mbode anebi pala, su nana mu nkye mbo woromu ema gaskye la, yaa yi kyawu de ku beyi dishiya ku a siki yi, kankye asikye nana a siki dopuwa, ari de anya kwa yi ema kankye asikye kemu a siki dishiya ku. <verse eid="2PE 1:19" /><verse number="20" style="v" sid="2PE 1:20" />Sede npari, ku shina nkye ba manki beta Mirikisi de anebi daa pala de mani tunani dishiya su. <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" />Ba manki Mirikisi de anebi beyi de ma sobon ni tunani dishiya ni nsebeki ba, sede ntani beyi manki ni dege anya Mirikisi yiri de Aworo Nsuseki sa su de su pala.<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s">Male Nsu yi Yaruwa</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />Sede a da a siki ntani Mirikisi anebi nsu yaruwa su ma a siki su, yomuna sua samu nsu male ni yaruwa a siki ku. De sua kokoyi ntani mbode ma gaskye ba nja sua yi musu shina Nsude butu su bila lepi, yi yomu yaa zo su ni seberi bebeta. <verse eid="2PE 2:1" /><verse number="2" style="v" sid="2PE 2:2" />Ntani yowa sua biya turiki ni ali mbo kumnya de sua yi, yomuna sua sa ntani nyowa sua yi beta mumungu a kiya turiki gaskye. <verse eid="2PE 2:2" /><verse number="3" style="v" sid="2PE 2:3" />Sobon ni opu nsu male yaruwa mu, sua sika ku ni kokongye yaruwa de su samu gyolo anya ku. Mirikisi rigye pala karishe alaka su wo, bebeta su yaa pekye su. <verse eid="2PE 2:3" /><verse number="4" style="v" sid="2PE 2:4" />Mirikisi bila meleku worede su yi lepi ba, sede e kutiri su te a wuta, e domuna su ni serika a siki romu nsu dopuwa anya de sua pekye nana de Mirikisi yaa yi su shiriya; <verse eid="2PE 2:4" /><verse number="5" style="v" sid="2PE 2:5" />Nde Mirikisi bila ntani durinya de bise a beyi ba, E saka su ni totolo riki de lende ntani nsu lepi, sede E sila ni Nuwu, yaa manki ni gangasi ni Mirikisi, nja worosu su ntani bokwe; <verse eid="2PE 2:5" /><verse number="6" style="v" sid="2PE 2:6" />Nde Mirikisi suwuta totolo geri sodoma nja Gomora su ma busi, e sa su de su man misali ni mbode yaa paru nja worede mani ali yiri Mirikisi ba; <verse eid="2PE 2:6" /><verse number="7" style="v" sid="2PE 2:7" />Nde Mirikisi butu Lotu, nseminji gangasi anya Mirikisi, Lotu geni beki siki ni zunwa ali dola mere biya doka Mirikisi de ntani mu sua yi. <verse eid="2PE 2:7" /><verse number="8" style="v" sid="2PE 2:8" />Lotu nseminji gangasi na anya Mirikisi, sede e zunwa a siki mumungu ntani, leyi basi sobon mbo rebi de su ma yi sobon su ma ntani mere biya doka na. <verse eid="2PE 2:8" /><verse number="9" style="v" sid="2PE 2:9" />Nde mbo mu ma yomu, Obagizi shina yiri de yaa sila ni ntani gangasi dege mbode ma mumungu nja de yaa domuna mungu ntani ari pekye nana shiriya. <verse eid="2PE 2:9" /><verse number="10" style="v" sid="2PE 2:10" />Musama worede sua biya mumungu memeri nkiya su su ki biya yiko Mirikisi</para>
  <para style="p" vid="2PE 2:10">Male ni yaruwa woromu su ma nsori dishiya nja dege kiya, ntani woromu su ma pauri geba ni basi meleku ni bisi ba; <verse eid="2PE 2:10" /><verse number="11" style="v" sid="2PE 2:11" />Ko meleku, de su pi male ni yaruwa mu sori, meleku mu su taba yi beta mumungu ko basi su a geba Obagizi ba. <verse eid="2PE 2:11" /><verse number="12" style="v" sid="2PE 2:12" />Sede male ni yaruwa woromu sua yi beta ni saba de su shina kiya yi ba. Su ma kankye nama bikiya, de su man tunani ba, sua yi mbode dishiya su gye su de su yi, nama bikiya de ntani sua ka su kisa, yomuna sua bebeta kankye nama sanwa. <verse eid="2PE 2:12" /><verse number="13" style="v" sid="2PE 2:13" />Male yaruwa sa ntani a siki damuwa nyowa, osu ma du Mirikisi yaa biya su ni guru Genbeki de su ba ntani. su yi mbode dishiya su gye su de su yi sua yi ko nnana jaja, su ma nsu saba la, nsu so zunwa ni buki ni si mbosi nja sha mboyi nja ku. <verse eid="2PE 2:13" /><verse number="14" style="v" sid="2PE 2:14" />A kwanki guru, su sika ni memeri kwana nja mata ni ntani, sua taba geji ni yi mbo mumungu ba, sua biya ntani de su ma mere sori a beigaskye de su puari, su ma nsu opu mbo, su ma lalasheshe. <verse eid="2PE 2:14" /><verse number="15" style="v" sid="2PE 2:15" />Male ni yaruwa mu, su bila turiki gaskye de su ma biya turiki ni balamu yaa ni beyor, de yaa so riba gyolo ni mungu. <verse eid="2PE 2:15" /><verse number="16" style="v" sid="2PE 2:16" />Sede su kwabe sobon ni mumungu mbo de yaa yi, de janki yi beta ni arishiya nsebiki de nana anebi yi mbo kankye somiya.<verse eid="2PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17" />Male ni yaruwa mu su ma kankye ndan miya de kyekeri, su ma kankye a gidagida de agaguwa wula de nana riki pauri, gaskye ma ndandaa, Mirikisi rigye shiriya su anya zunwa su wo a siki dopuwa. <verse eid="2PE 2:17" /><verse number="18" style="v" sid="2PE 2:18" />Ntani woromu, te yi mumungu beta ni banza, ni ali bila zunwa nki ni lepi, kokori su ma de su ja worede sila dege mbo mumungu de su yi ali mumungu de yaa sa su peri siki. <verse eid="2PE 2:18" /><verse number="19" style="v" sid="2PE 2:19" />Male ni yaruwa mu, su yi su anikowori ni ba su yenshi, sede osu nkiya su su ma bunwa ni mbo mumungu de sua yi, sobon konse e ma bunwa ni kowoni mbode yaa yi. <verse eid="2PE 2:19" /><verse number="20" style="v" sid="2PE 2:20" />Nde ntani sila dege mumungu mbo de ma a siki durinya ta turiki ni shina Obagizi Yesu Kiristi nsude e shiya ma nsu Sila mu, se a beyi su kuma te yi mbo mumungu de su bila adaa, mbo mumungu mu kuma shakiya su, su kuma yi mungu pi yiri de su ma dege pari de su beigaskye anya Obagizi. <verse eid="2PE 2:20" /><verse number="21" style="v" sid="2PE 2:21" />Yiri ntani woromu yaa pi su de su shina turiki gangasi ni Mirikisi ba, nja de su shina yi na su kuma te biya turiki de ma mumungu nja su ma ozagbo ni doka Mirikisi de su kokoyi su. <verse eid="2PE 2:21" /><verse number="22" style="v" sid="2PE 2:22" />Ashe mbode su yi mu ema gaskye la nja keri beta de su pala nkye: &lt;&lt;Kere kuma mbeyi te rishe buburiya yi&gt;&gt; nja &lt;&lt;Alede de su yi wonka e kuma te kwakwana a dola.&gt;&gt;<verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s">Nana De Obagizi Kuma Zo</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />Oku nsu oboki na, kuzukam nsumu na ma takada ni bi de mma rubuta ku nshi. Ni rubuta ku nshi guru de ni ja ku sori guyam de ku yi tunani kyakyawu. <verse eid="2PE 3:1" /><verse number="2" style="v" sid="2PE 3:2" />Eni ma bila de ku turunwa ni kelima beta de anebi nsuseki nja doka de su ba ku te anya Obagizi mu nsu sila mu te anya yayamanki yi. <verse eid="2PE 3:2" /><verse number="3" style="v" sid="2PE 3:3" />Mbo ni pari de ku shina e shiya ma a nana karishe nsu siya sua zo, sua ku siya sobon de kwa biya Mirikisi, sua biya turiki ni memeri mungu su. <verse eid="2PE 3:3" /><verse number="4" style="v" sid="2PE 3:4" />Sua minya nkye, &lt;&lt;Zo yi de e yi anikowori managa? Tunde nsu adatolomu muntu, kowoni mbo sigeba yiri de e ma dege pari de su yi durinya.&gt;&gt; <verse eid="2PE 3:4" /><verse number="5" style="v" sid="2PE 3:5" />Nsu pala yomu su ma yi dende geri na nkye te anya kelima Mirikisi na a kwanki de bise, Mirikisi yi bisi nja kisi. Mirikisi yi kesa dege siki riki nja riki de gyowe yi. <verse eid="2PE 3:5" /><verse number="6" style="v" sid="2PE 3:6" />Te totolo riki mu la Mirikisi juru nja bebeta durinya guru. <verse eid="2PE 3:6" /><verse number="7" style="v" sid="2PE 3:7" />Yomuna te kelima beta mu Mirikisi yi bisi nja kisi su tele ni beta Mirikisi sobon de su suwuta yi ni wuta, ntani worede shina Mirikisi ba su tele su pekye nana shiriya nja juru.<verse eid="2PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8" />Yayuwa na de mma so: kede ku mosi mbo ndandaa mu, nana daa anya Obagizi ema kankye shekera dubu daa la, shekera dubu daa ema kankye nana daa la. <verse eid="2PE 3:8" /><verse number="9" style="v" sid="2PE 3:9" />Obagizi yaa ki seberi ni sika anikowori ba, yiride worosu su ma kone lesa seberi Mirikisi, sede yaa kadishiya pekye ku, sobon yaa bila de kede nseda e bebeta ba, sede yaa so de guru ntani su juyi bila lepi asu.<verse eid="2PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10" />Sede nana ni Obagizi yaa zo kankye bolowa la. De bisi yaa beta ni totolo kuruwa; Guru mbode ma a bisi yaa bebeta ni wuta nja guru mbode ma a siki durinya sua beta.<verse eid="2PE 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2PE 3:11" />Tunde Mirikisi yaa juru guru mbo woromu yomu, woni yiri ntani na e kamata de ku ma? Se mu yi zunwa seki nja zunwa ali de jima Mirikisi. <verse eid="2PE 3:11" /><verse number="12" style="v" sid="2PE 3:12" />Yiride mua sa ndani pekye nana zo ni Mirikisi nja de mua yi kokori de mu sa nana mu de e zo seberi, nana de Mirikisi yaa juru bisi ni wuta, nja guru mbode su ma a siki bisi nja kisi sua nyeleka ni dimi wuta. <verse eid="2PE 3:12" /><verse number="13" style="v" sid="2PE 3:13" />Sede a siki anikowori Mirikisi: mua sa ndani pekye sabuwa bisi nja kisi, gizi anya de ntani gangasi sua zunwa.<verse eid="2PE 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14" />sobon yomu, yayuwa na de mma so, tunde kuma nya ndani pekye nana mu, ku yi kokori de ku yi zunwa mere lepi nja ba dola a geba Mirikisi, nja ku yi zunwa selema a geba yi. <verse eid="2PE 3:14" /><verse number="15" style="v" sid="2PE 3:15" />Ku turunwa nkye ka dishiya ni Obagizi ema nana nkye yaa bila de ntani su sila, yiride yayiwa mu Bulusu rubuta ku nshi, ni simi de Mirikisi beyi. <verse eid="2PE 3:15" /><verse number="16" style="v" sid="2PE 3:16" />Kowoni nana ema yi beta a kiya yiri mbo woromu na a siki guru takada yi. A siki takada yi e rubuta worosu mbo de su man wuya shina, de worosu ntani mere shina nja worede man sori a siki beigaskye ba, su ma shenja maana yi, yiride su yi ni worosu anya a siki beta Mirikisi. Nka su ma keyi kiya su alaka na.<verse eid="2PE 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17" />Sobon yomu, yayuwa na de ma so, tunde ku rigye shina mbomu yomu, se ku kpanku dishiya ku de kede ku biya turiki ntani mere biya doka Mirikisi nja de kede ku juyi bila beigaskye ku <verse eid="2PE 3:17" /><verse number="18" style="v" sid="2PE 3:18" />Sede ku sigeba ni yi girima a siki aniyeri nja shina ni Obagizi amu nja nsu Sila mu Yesu Kiristi. Te anya yi dereja dege kuzukam ari gbogbo! Ema yomu.<verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>