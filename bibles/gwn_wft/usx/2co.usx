<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CO" style="id">2 CO Gwandara-Nigeria</book>
  <para style="h">2Korentiyawa</para>
  <para style="toc1">Manki Bulusu ni Bi Te Anya Ntani Korentiyawa</para>
  <para style="toc2">2 Korentiyawa</para>
  <para style="toc3">2 Kor</para>
  <para style="mt2">Manki ni Bi Bulusu ta</para>
  <para style="mt">Korentiyawa</para>
  <chapter number="1" style="c" sid="2CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1" />Takada butu anya ni Bulusu yaamanki Yesu Kiristi nja yeda ni Mirikisi, nja yayiwa amu Timoti,</para>
  <para style="p" vid="2CO 1:1">Te anya nsubiya Yesu de ma a siki Korenti guru ni ntani Mirikisi de su ma a kesa ni Akaya<verse eid="2CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 1:2" />Aniyeri nja selema ni Mirikisi Adaamu, nja Obagizi Yesu Kiristi e ma nja ku guru.<verse eid="2CO 1:2" /></para>
  <para style="s">Mirikisi Nsu beyi Takuwa Ba Guru Ntani</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3" />Yobo te anya Mirikisi nja Adaa ni Obagizi mu Yesu Kiristi, Adaa mu nsu toseyi nja Mirikisi de beyi guru takuwa. <verse eid="2CO 1:3" /><verse number="4" style="v" sid="2CO 1:4" />Mirikisi de e ma ba mu takuwa a siki guru Genbeki mu, sobon de mu ba worede su ma a siki Genbeki takuwa, ni yiri takuwa de mu samu anya Mirikisi. <verse eid="2CO 1:4" /><verse number="5" style="v" sid="2CO 1:5" />Sobon yiri Genbeki de Kiristi sha a kiya amu, yomu la a siki Kiristi la mua samu takuwa teke. <verse eid="2CO 1:5" /><verse number="6" style="v" sid="2CO 1:6" />Nde mua sha Genbeki, e ma sobon takuwa ku nja sila aku la. Nde mu yi takuwa e ma sobon ni oku la, yiri de Genbeki ku sa ku kuma nsu kadishiya yiri de omu ma mu sha Genbeki. <verse eid="2CO 1:6" /><verse number="7" style="v" sid="2CO 1:7" />Sa dishiya amu de mu manshi anya aku e mani sori, sobon mu shina yiri Genbeki de kuma sha yiri de mu sha du, yomu la oku kwa samu yiri takuwa de omu ma mu samu.<verse eid="2CO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8" />Yayuwa, mua so de kuman rishi shina ba, ni Genbeki de mu sha a kesa ni Asiya. mu zi nki soseyi, ari mu butu dishiya nkye mua mani leyi gagaba. <verse eid="2CO 1:8" /><verse number="9" style="v" sid="2CO 1:9" />Ari ema kankye su yi mu tala ni muntu. Ema yomu na sobon kede mu la dishiya ja kiya mu ba sede anya Mirikisi, de yaa dege worede su muntu. <verse eid="2CO 1:9" /><verse number="10" style="v" sid="2CO 1:10" />Mirikisi butu mu shika mumungu muntu, mu shina Mirikisi yaa butu mu shika mungu mbo. Anya Mirikisi na mu sa dishiya amu yaa kuma sigeba ni butu mu shika guru mumungu mbo, <verse eid="2CO 1:10" /><verse number="11" style="v" sid="2CO 1:11" />Yiride kwa sua mu to a siki lepa aku. Ntani nyowa sua gbede Mirikisi a kiya amu sobon aniyeri de su yi mu nshi ni keleba lepa nyowa.<verse eid="2CO 1:11" /></para>
  <para style="s">Bulusu Saki Shiri Ni Tepiya e yi</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12" />Kuzukam mbode sa mua dege dolo e shiya ma tunani dishiya amu beyi sheeda nkye omu mu yi zunwa seeki a durinya ni dishiya daa, musama a siki zunwa mu nja ku, mu yi yomu na ni gaskye yiri ali ni Mirikisi, Mu yi mbomu a siki simi ni durinya mu na ba sede a siki aniyeri ni Mirikisi. <verse eid="2CO 1:12" /><verse number="13" style="v" sid="2CO 1:13" />Sobon mu rubuta ku mbodaa mbom na ba sede mbo de kwa yi yaa karanta ko shina. Ni sa dishiya nkye ku shina yomu. <verse eid="2CO 1:13" /><verse number="14" style="v" sid="2CO 1:14" />Yiri de ku rigye shina mu guru ba, kwa te shina mu kyakyawu a nana de Obagizi Yesu yaa zo, ari kwa dukwa geba akyiyamu yiri de omu ma mua dukwa geba nku.<verse eid="2CO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15" />Sobon ni yeda de ku manshi a kiya na, ni ma yi shiri de ni para zo anya aku de ku samu anabirika son bi. <verse eid="2CO 1:15" /><verse number="16" style="v" sid="2CO 1:16" />Ni yi shiri de ni biya anya aku nde na te a Makidoniya nja nde ni dege a Makidoniya ma kuma biya anya aku, de ku sua ni nto a siki tepiya na de na ta Yawudiya. <verse eid="2CO 1:16" /><verse number="17" style="v" sid="2CO 1:17" />De ni shiriya mbomu, kuma geni ni shina mbode na yi bo? ko ni yi de ni jima durinya la sobon nde ni pala nkye &lt;&lt;EE&gt;&gt; ko ni nkye &lt;&lt;Ayi&gt;&gt;?<verse eid="2CO 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 1:18" />Sede mu tabata nkye Mirikisi ma nsu aminshi la, manki amu de zo anya aku ba e ma ni &lt;&lt;Ee&gt;&gt; ko &lt;&lt;Yi&gt;&gt; na ba. <verse eid="2CO 1:18" /><verse number="19" style="v" sid="2CO 1:19" />Sobon Yaa ni Mirikisi, Yesu Kiristi, de e ni nja selasi nja Timoti, de mu beyi manki e yi ba ku e man &lt;&lt;Ee&gt;&gt; nja &lt;&lt;Yi,&gt;&gt; na ba sede a siki e yi kowon kwanki e ma &lt;&lt;Ee na.&gt;&gt; <verse eid="2CO 1:19" /><verse number="20" style="v" sid="2CO 1:20" />Sobon guru anikowori de Mirikisi yi, e ma&lt;&lt;Ee &gt;&gt; a siki Kiristi. Nja te anya Yesu mua pala nkye &lt;&lt;e ma yomu&gt;&gt; ta anya mu mua ba Mirikisi dereja. <verse eid="2CO 1:20" /><verse number="21" style="v" sid="2CO 1:21" />Kuzukam Mirikisi na e yi mu nja ku de ku sakisi nsori a siki Kiristi. Mirikisi e shiya la zabi mu, <verse eid="2CO 1:21" /><verse number="22" style="v" sid="2CO 1:22" />Mirikisi samu alama nkye muma na yi la, nja e sa Aworo e yi a dishiya amu, de e ma tabata mu mbode mua keleba a geba.<verse eid="2CO 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23" />Mirikisi ma sheeda na nde na pala yaruwa na de mbode sa ni de ni kuma te A korenti a kwanki ni gagaba, de kede ni yi anwashi nja ku. <verse eid="2CO 1:23" /><verse number="24" style="v" sid="2CO 1:24" />Ba e ma kankye mua nana ku yiko a kiya beigaskye na ba, sede mua yi anki nja ku sobon de ku yi perisiki, sobon a siki beigaskye la ku sakisi nsori.<verse eid="2CO 1:24" /></para>
  <chapter eid="2CO 1" />
  <chapter number="2" style="c" sid="2CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1" />Sobon yomu na ni nkye na sakye zo anya ku gagaba de kede ni sa ku beki siki ba. <verse eid="2CO 2:1" /><verse number="2" style="v" sid="2CO 2:2" />Nde ni sa ku beki siki, waa sa ni peri siki sede oku de ni sa ku bekisiki? <verse eid="2CO 2:2" /><verse number="3" style="v" sid="2CO 2:3" />Ni rubuta yiri de ni saba nkye kwanki de ma zo kede ema ni beki siki anya worede sua sa ni perisiki. Ni ma sadishiya anya ku guru, kwa yi peri siki nja ni guru aku. <verse eid="2CO 2:3" /><verse number="4" style="v" sid="2CO 2:4" />Sobon ni rubuta ku takada mu a siki basi dishiya nja beki siki nja anwe nyowa, de ni sa ku beki siki na ba sede de ku shina yowa ni so de ni manshi a kiya ku.<verse eid="2CO 2:4" /></para>
  <para style="s">Yape Nsude Yi ke Lepi</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5" />Nde nseda sa ku beki siki, Eni na e sa ni ba sede e sa guru aku na du, Ni yi yomu de mba ku wuya na ba. <verse eid="2CO 2:5" /><verse number="6" style="v" sid="2CO 2:6" />Yiri poro de ntani nyowa sua beyi nkye e deta yomu. <verse eid="2CO 2:6" /><verse number="7" style="v" sid="2CO 2:7" />Kuzukam, se ku yape yi nja ku beyi sori dishiya, sobon kede yowa beki siki mu e sa yi kuman beyi. <verse eid="2CO 2:7" /><verse number="8" style="v" sid="2CO 2:8" />Na gila ku, nkayomu, se ku nana yi so aku. <verse eid="2CO 2:8" /><verse number="9" style="v" sid="2CO 2:9" />Delili de ni rubuta takada mu, e shiya ma de ni geni nde kwa sakisi a siki gwada nja kwa bayi girima a siki guru mbo. <verse eid="2CO 2:9" /><verse number="10" style="v" sid="2CO 2:10" />Guru nsude ku yape yi, eni ma ni yape nse ni du. Du mbode ni rigye yape nde mbodaa ma de na yape ni yape a siki ni Kiristi sobon aku, <verse eid="2CO 2:10" /><verse number="11" style="v" sid="2CO 2:11" />De kede obiri e sha kiya amu. Sobon de kede mu lesa shina mumungu shiri ni obiri ba.<verse eid="2CO 2:11" /></para>
  <para style="s">Yamanki Ni sabuwa anikowori</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12" />De ni zo a Taruwasa de ni beyi manki Kiristi kyakyawu nja Obagizi rigye bure ni turiki, <verse eid="2CO 2:12" /><verse number="13" style="v" sid="2CO 2:13" />Ni tuku man selema a dishiya wo ba, sobon ni geni yayiwa na Taru anya ni ba. se ni yi su selema de ni ta Makidoniya.<verse eid="2CO 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14" />Sede mma gbede Mirikisi, nsude yaa biya mu yaa sa mu sigeba a siki Kiristi nja a siki amu na guru anya sua zi kemeshi ni shina Yesu. <verse eid="2CO 2:14" /><verse number="15" style="v" sid="2CO 2:15" />Sobon omu na muma kankye mbo kemeshi ni Kiristi anya Mirikisi a siki worede su sila nja worede su bebeta sobon su yi nyisa ni Mirikisi. <verse eid="2CO 2:15" /><verse number="16" style="v" sid="2CO 2:16" />Anya worosu su de sua bila muntu mua yi kemeshi ni muntu; te anya worede Mirikisi sila su muma kankye kemeshi ni leyi la. Waa yaa la loni ni ANKI mu? <verse eid="2CO 2:16" /><verse number="17" style="v" sid="2CO 2:17" />Sobon mu ma kankye ririgye ntani ba, de su la beta ni Mirikisi ma mbo ni riba la. yiri de e gye mu, a siki Kiristi na mua yi beta a geba Mirikisi ni dishiya daa, kankye ntani de Mirikisi saka su.<verse eid="2CO 2:17" /></para>
  <chapter eid="2CO 2" />
  <chapter number="3" style="c" sid="2CO 3" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1" />Mua yobo kiya amu na jaja ba? Ko mua bila takada yobo dege anya aku la, ko butu a anya ku kankye yiri de worosu su ntani sua yi na? <verse eid="2CO 3:1" /><verse number="2" style="v" sid="2CO 3:2" />Sede oku nkiya ku kuma kankye takada amu la, de su rubuta a dishiya mu, de konwawa e geni nja de konwawa e karanta. <verse eid="2CO 3:2" /><verse number="3" style="v" sid="2CO 3:3" />Ku ma kankye takada na de Kiristi rubuta, de ema nani wuta ni anki amu, su rubuta ni nani naba sede ni Aworo Mirikisi nsu leyi, ba a kiya dunsi na su rubuta yi ba sede a dishiya ni nsebeki.<verse eid="2CO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4" />Mu pala yomu la sobon sa dishiya de mu ma nshi a siki Mirikisi te anya Kiristi. <verse eid="2CO 3:4" /><verse number="5" style="v" sid="2CO 3:5" />Mu shina nkye muma sori ni yi anki mu nkiyamu ba, sede Mirikisi la ba mu sori de mua yi anki mu. <verse eid="2CO 3:5" /><verse number="6" style="v" sid="2CO 3:6" />Mirikisi e shiya sa mu muma bunwa anki ni sabuwa anikowori, ba ni takada ba sede ni Aworo; sobon doka mu de su rubuta e zon muntu, sede Aworo de yaa beyi leyi.<verse eid="2CO 3:6" /></para>
  <para style="s">Dereja Ni Sabuwa Anikowori</para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7" />Kuzukam nde anki kokoyi doka Musa de zo ni muntu, nsude su rubuta e yi a siki dunsi, zo ni dereja, de kede yaya Izireyila su kone pisika Musa tiriri ba sobon dereja yi, ko de dereja ni ema nsu bise la, <verse eid="2CO 3:7" /><verse number="8" style="v" sid="2CO 3:8" />ba anki Aworo la e pi ma ni dereja bo? <verse eid="2CO 3:8" /><verse number="9" style="v" sid="2CO 3:9" />Nde anki kokoyi doka Musa de sa ntani su ma nsu lepi mani dereja yomu, yomuna du anki ni sabuwa anikowori de zo ni gangasi ni Mirikisi e pi dereja! <verse eid="2CO 3:9" /><verse number="10" style="v" sid="2CO 3:10" />Sobon seda wuri anikowori ema ni dereja kuzukam gagaba nde su te gonta yi nja sabuwa anikowori. <verse eid="2CO 3:10" /><verse number="11" style="v" sid="2CO 3:11" />Nde doka Musa de dereja yi yaa bise zo ni dereja yomu, sabuwa anikowori Mirikisi yaa zo ni dereja totolo de pi!<verse eid="2CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12" />Sobon yomu, tunde mu man sa dishiya mu, mu puari geba ba. <verse eid="2CO 3:12" /><verse number="13" style="v" sid="2CO 3:13" />Muma kankye Musa na ba, de ripe pisika e yi ni woriki de kede yaya Izireyila su kone dereja asikye de yaa bise. <verse eid="2CO 3:13" /><verse number="14" style="v" sid="2CO 3:14" />Sede dishiya asu ki zi, ari kuzukam dopuwa ripe dishiya asu a du kwanki de su te karanta anikowori ni wuri. su butu dopuwa ni ba, sobon te anya Kiristi la kin sua samu asikye yi. <verse eid="2CO 3:14" /><verse number="15" style="v" sid="2CO 3:15" />Ari kuzukam kwanki de su karanta takada doka Musa, ni ripe dishiya asu su shina gaskye ba. <verse eid="2CO 3:15" /><verse number="16" style="v" sid="2CO 3:16" />Sede nsude juyi te anya Obagizi, Mirikisi yaa bure ni a pisika yi. <verse eid="2CO 3:16" /><verse number="17" style="v" sid="2CO 3:17" />Kuzukam Obagizi la e ma Aworo, anya de Aworo ni Mirikisi zunwa, anya ni ntani sua samu yenshi. <verse eid="2CO 3:17" /><verse number="18" style="v" sid="2CO 3:18" />Guru amu, de mua geni sereyi, muma kamani dereja Obagizi, su juyi mu ma kankye kamani de yaa ja yowa a siki dereja, de butu anya ni Obagizi, de ema Aworo.<verse eid="2CO 3:18" /></para>
  <chapter eid="2CO 3" />
  <chapter number="4" style="c" sid="2CO 4" />
  <para style="s">Mbo Nani A siki Tuni Kesa</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1" />Nkayomu, tunde te anya toseyi ni Mirikisi mu mani ANKI mu, mu butu dishiya ba. <verse eid="2CO 4:1" /><verse number="2" style="v" sid="2CO 4:2" />Sede mu ki kowoni ali mumungu de ma boyi nja kumnya; mua yi munabuki ko yaruwa ni kelima Mirikisi ba. Sede mua pala gaskye a pili te yomu na kowoni nse yaa sheeda gaskye ni dishiya amu a geba Mirikisi. <verse eid="2CO 4:2" /><verse number="3" style="v" sid="2CO 4:3" />Nde manki kyakyawu mu ma riripe, e ma riripe anya worede su yi lepi la. <verse eid="2CO 4:3" /><verse number="4" style="v" sid="2CO 4:4" />De obiri durinya mu ripe ndani dishiya worede su beigaskye ba, sobon kede su geni asikye ni dereja manki kyakyawu ni Kiristi, de e shi ma kamani Mirikisi. <verse eid="2CO 4:4" /><verse number="5" style="v" sid="2CO 4:5" />Sobon mua beyi manki ni kiya mu na ba, sede ni Yesu Kiristi Obagizi mu, muma kankye bunwa aku la sobon Yesu. <verse eid="2CO 4:5" /><verse number="6" style="v" sid="2CO 4:6" />Sobon Mirikisi, de pala nkye, &lt;&lt;Bila de asikye e beyi asikye a siki dopuwa,&gt;&gt; e sa asikye yi de ba mu a siki dishiya mu de mu geni girima dereja ni kamani Mirikisi a siki Kiristi.<verse eid="2CO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7" />Sede muma ni mbo nani mu a siki tuni kesa de nana nkye guru totolo sori mu butu anya Mirikisi la ba anya mu nsebeki ba. <verse eid="2CO 4:7" /><verse number="8" style="v" sid="2CO 4:8" />Mu sha Genbeki a kowoni turiki, sede mu lense dishiya ba, mu sha pama ni ANKI; Worosu su kwanki mua yi shaka, sede mu butu dishiya ba. <verse eid="2CO 4:8" /><verse number="9" style="v" sid="2CO 4:9" />Mu geni takaasi, sede Mirikisi mosi mu ba; ntani zi mu suwo, sede mu bebeta ba. <verse eid="2CO 4:9" /><verse number="10" style="v" sid="2CO 4:10" />Kowoni kwanki mu ma baki muntu yiri de su yi Yesu, sobon yiri zunwa de Yesu yi e pelesa a nkimu. <verse eid="2CO 4:10" /><verse number="11" style="v" sid="2CO 4:11" />Sobon omu de mu man leyi kowoni kwanki mu ma a siki baki muntu sobon Yesu, de su geni ali e yi nkimu nsu muntu. <verse eid="2CO 4:11" /><verse number="12" style="v" sid="2CO 4:12" />E shiya sa, muma baki muntu sobon de oku ku man leyi ni gbogbo.<verse eid="2CO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13" />E ma a rubutu a siki beta Mirikisi nkye: &lt;&lt;Ni beigaskye; sobon yomu ni yi beta.&gt;&gt; Ni aworo ni beigaskye yiri de omu du mu yeda sobon yomu mma pala manki Mirikisi, <verse eid="2CO 4:13" /><verse number="14" style="v" sid="2CO 4:14" />Sobon mu shina nkye Mirikisi de dege Obagizi Yesu a kumsha yaa dege mu du yere nja ku yaa la mu te anya de e ma. <verse eid="2CO 4:14" /><verse number="15" style="v" sid="2CO 4:15" />Guru mbom yaa ma sobon moriya ku la, de aniyeri de zo anya ku yaa jaa yowa teke de yaa ma delili de ntani sua gbede Mirikisi, sobon dereja e yi.<verse eid="2CO 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16" />Nkayomu mu butu dishiya ba. Kode nkimu yaa bebeta, nzun yomu kowoni nana aworo amu yaa ma sabuwa. <verse eid="2CO 4:16" /><verse number="17" style="v" sid="2CO 4:17" />Sobon Genbeki ni kwanki piri de mua sha mu yaa dede ba e shi na yaa ba dereja ni dindindin de pi guru Genbeki mu. <verse eid="2CO 4:17" /><verse number="18" style="v" sid="2CO 4:18" />Sobon yomu ba mbode ndani mu yaa geni na mua kone ba, sede mbo de ndani geni ba. Sobon mbo de ndani ma geni yaa dede ba, mbode ndani ma geni ba e shi la yaa ma gbogbo.<verse eid="2CO 4:18" /></para>
  <chapter eid="2CO 4" />
  <chapter number="5" style="c" sid="2CO 5" />
  <para style="s">Gizi Amu Ni Bisi</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1" />Kuzukam mu shina nkye gizi amu ni durinya mu e ma kankye rugwa de yaa bebeta la, Mirikisi yaa ba mu nki daa sabuwa dege bisi de yaa bebeta ba, ba nani nsebeki na gina yi ba. <verse eid="2CO 5:1" /><verse number="2" style="v" sid="2CO 5:2" />Kode mua yi beki siki a dishiya amu, mua yi memeri de mu bila nkimu de mu sa nki ni bisi. <verse eid="2CO 5:2" /><verse number="3" style="v" sid="2CO 5:3" />sobon nde mu sa keikei, mua taba ma totombolo gagaba. <verse eid="2CO 5:3" /><verse number="4" style="v" sid="2CO 5:4" />Sobon de mu ma a siki nki de ma kankye rugwa durinya mu, mu yi beki siki nja Genbeki, sobon mua yi memeri de ma totombolo ba sede mu sa keikei ni bisi, sobon mbode ma ni nki nsu leyi yaa sha kiya ni muntu. <verse eid="2CO 5:4" /><verse number="5" style="v" sid="2CO 5:5" />Kuzukam Mirikisi la yi mu sobon ni delili ni sabuwa leyi mu nja de e ba mu Aworo de e nana mu mbode yaa yi mu nshi a geba.<verse eid="2CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6" />Nkayomu kowon kwanki mu mani sori dishiya, kode mu shina nkye nde mu ma a siki nki nsum yaa laba mu nja Obagizi. <verse eid="2CO 5:6" /><verse number="7" style="v" sid="2CO 5:7" />Sobon yomu mua yi zunwa beigaskye la ba ni geni ndani ba. <verse eid="2CO 5:7" /><verse number="8" style="v" sid="2CO 5:8" />Mu mani sori dishiya, nja mu yeda de mu bila nki mu, de mu te zunwa nja Obagizi a bisi. <verse eid="2CO 5:8" /><verse number="9" style="v" sid="2CO 5:9" />So amu na de mu yi mbo de yaa jima Mirikisi, ko mu ma a siki durinya mu nja shi ko mu ma nja shi a bisi. <verse eid="2CO 5:9" /><verse number="10" style="v" sid="2CO 5:10" />Sobon ema dole la konwawa yaa sakisi a geba kingbolo shiriya Kiristi de yii shiriya. Konse yaa keleba nani wuta ni mbo de e yi a siki nki e yi ko kyakyawu la ko mumungu.<verse eid="2CO 5:10" /></para>
  <para style="s">Shiriya Ntani Nja Mirikisi</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11" />Tunde mu shina womba Obagizi a dishiya amu nja mua yi kokori de mu lelebe ntani de su beigaskye te nja Mirikisi. Mbode mua yi Mirikisi shina nja yomuna oku ma du e ma a dishiya ku. <verse eid="2CO 5:11" /><verse number="12" style="v" sid="2CO 5:12" />Mua yi kokori de mu yobo kiya amu naba, sede mma ba ku delili de ku dukwa geba nja mu, sobon ku samu manki de kwa gye worede sua dege kiya momoko dishiya daa a geba Mirikisi. <verse eid="2CO 5:12" /><verse number="13" style="v" sid="2CO 5:13" />Nde e ma kankye mua yi somiya na, e ma sobon Mirikisi la. nde mu ma a siki ankeli amu, e ma nani wuta ku la. <verse eid="2CO 5:13" /><verse number="14" style="v" sid="2CO 5:14" />Guru mbo de mma yi, e ma sobon so ni Kiristi na yaa biya mu. Tunde mu beigaskye nkye Kiristi muntu sobon konwawa, sobon yomu e ma kankye guru amu mu muntu nja shi. <verse eid="2CO 5:14" /><verse number="15" style="v" sid="2CO 5:15" />E muntu sobon konwawa nde worede su keleba sabuwa la yi sua yi zunwa ni geni dama gagaba. Sede, sua yi zunwa de Kiristi yaa so, Yesu de muntu sobon oku e kwa dege.<verse eid="2CO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16" />Dege kuzukam ta geba mua taba kone nseda te anya shina nsebeki ba, kode mu taba kone Kiristi a siki yiri tunani nsebeki, mua saki kone yi yomu kuma gagaba. <verse eid="2CO 5:16" /><verse number="17" style="v" sid="2CO 5:17" />Nkayomu guru nsude ma a siki Kiristi, e ma sabuwa yapu la; mbo wuri guru e bila, mbo guru e ma sabuwa! <verse eid="2CO 5:17" /><verse number="18" style="v" sid="2CO 5:18" />Guru mbo mu e ma dege anya Mirikisi na, de shiriya mu nja kiya e yi te anya Kiristi nja ba mu ANKI ni shiriya ntani nja Mirikisi: <verse eid="2CO 5:18" /><verse number="19" style="v" sid="2CO 5:19" />Manki amu e shiya ma Mirikisi ma shiriya nsebeki nja kiya yi a siki Kiristi, yaa kiriga lepi ni ntani a kiya asu ba. Mirikisi ba mu ANKI ni shiriya ntani nja shi. <verse eid="2CO 5:19" /><verse number="20" style="v" sid="2CO 5:20" />Nkayomu mu ma ndani ntani la anya Kiristi, Mirikisi yaa bila ntani anya amu. Mirikisi yaa ologba ku amomoko Kiristi: Ku shiriya nja Mirikisi. <verse eid="2CO 5:20" /><verse number="21" style="v" sid="2CO 5:21" />Yesu taba yi lepi ba sede Mirikisi sayi de ma nsu lepi. Sobon anya e yi la mua samu gangasi ni Mirikisi.<verse eid="2CO 5:21" /></para>
  <chapter eid="2CO 5" />
  <chapter number="6" style="c" sid="2CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1" />Tunde mu ma nsu yi anki Mirikisi na mua ologba ku kede ku keleba aniyeri ni Mirikisi a wopi ba. <verse eid="2CO 6:1" /><verse number="2" style="v" sid="2CO 6:2" />Ema rubuta a siki takada Mirikisi nkye,</para>
  <para style="q1" vid="2CO 6:2">&lt;&lt;A kwanki ni aniyeri. Ni zi ku,</para>
  <para style="q2" vid="2CO 6:2">a nana sila nku ni sua ku nto.&gt;&gt;</para>
  <para style="m" vid="2CO 6:2">Mma gye ku, kuzukam na e ma kwanki aniyeri Mirikisi, kuzukam na e ma nana sila!<verse eid="2CO 6:2" /></para>
  <para style="s">Genbeki Ni Bulusu</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3" />Kede mu ma delili mbo de yaa sa nse da e titimi ba, sobon kede mu lesa samu nani wuta ANKI mu ba. <verse eid="2CO 6:3" /><verse number="4" style="v" sid="2CO 6:4" />A kiya yomu, guru mbo de mua yi mu nana ntani mu ma nsu yi ANKI Mirikisi a siki turiki gaskye: ni kadishiya; ni ngala; ni wuya nja Genbeki; <verse eid="2CO 6:4" /><verse number="5" style="v" sid="2CO 6:5" />su dukwa mu, su samu a siki jaru nja dege ankeli; mu yi ANKI wuya, ba kwana ndederi nja nyunwa; <verse eid="2CO 6:5" /><verse number="6" style="v" sid="2CO 6:6" />a siki zunwa sere, a siki shina de mu man shi, nja kadishiya nja kiriki; a siki Aworo Mirikisi mu nana nkye mu ma nsu ANKI Mirikisi la a siki so nja gaskye; <verse eid="2CO 6:6" /><verse number="7" style="v" sid="2CO 6:7" />a siki beta ni gaskye nja sori ni Mirikisi; nja keyi yanki ni gangasi a nani dama nja ni guni; <verse eid="2CO 6:7" /><verse number="8" style="v" sid="2CO 6:8" />a siki girima nja rishi beyi girima, sua ba mu takaasi nja yobo mu; sua yi beta ni bebeta mu seni; su la mu ma nsu yaruwa; ari kuzukam mua pala gaskye; <verse eid="2CO 6:8" /><verse number="9" style="v" sid="2CO 6:9" />su shina mu sere, sede sua yi kankye su shina mu ba; mu ma kankye a baki muntu, ari kuzukam mu man leyi, su dukwa mu sede su kisa mu ba; <verse eid="2CO 6:9" /><verse number="10" style="v" sid="2CO 6:10" />A siki Genbeki, mua yi peri siki; kode nkye mu ma potoruwa ari kuzum mu ma nsu mbo nani na nyowa, mu mani mbo da ba, sede ari kuzum mu mani mbo guru.<verse eid="2CO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11" />Oku ntani korentiyawa, mu boyi ku mbo da ba, mu bure dishiya amu ba ku. <verse eid="2CO 6:11" /><verse number="12" style="v" sid="2CO 6:12" />Omu la mu ki ku ba, sede oku la ku yeda mu ba. <verse eid="2CO 6:12" /><verse number="13" style="v" sid="2CO 6:13" />Mma yi ku beta kankye Adaa nja yaya e yi la, oku du ku bure dishiya aku.<verse eid="2CO 6:13" /></para>
  <para style="s">Kede Ku Gama Kiya Nja Worede de Ki Biya Yesu</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14" />Kede ku gama kiya nja worede de sua ki Yesu. Mina gama gangasi nja mungu? Ko mina gama asikye nja dopuwa? <verse eid="2CO 6:14" /><verse number="15" style="v" sid="2CO 6:15" />Mina ma a sisika Kiristi nja obiri? Mina yada nsubiya Yesu nja worede de suabiya Yesu ba? <verse eid="2CO 6:15" /><verse number="16" style="v" sid="2CO 6:16" />Mina gama laki lepa Mirikisi nja kunguni boka? Omu muma kankye laki lepa Mirikisi nsu leyi na. Yiri de Mirikisi pala nkye: &lt;&lt;Na zunwa nja su nja Na yi tepiya a siki asu, nja Na ma Mirikisi asu, nja osu sua ma ntani na.&gt;&gt;<verse eid="2CO 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="2CO 6:17" />&lt;&lt;Nkayomu Mirikisi pala nkye, ku butu a siki asu</para>
  <para style="q2" vid="2CO 6:17">ku laba kiya aku,</para>
  <para style="q4" vid="2CO 6:17">Nzi Obagizi.</para>
  <para style="q1" vid="2CO 6:17">Kede ku kpa mbo de e man dola ba,</para>
  <para style="q2" vid="2CO 6:17">Yomu na E ni na keleba ku.&gt;&gt;<verse eid="2CO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2CO 6:18" />Na ma Adaa aku,</para>
  <para style="q2" vid="2CO 6:18">Oku kwa ma yaya na menza nja mata,</para>
  <para style="q2" vid="2CO 6:18">Nzi Obagizi nsu yiko.&gt;&gt;<verse eid="2CO 6:18" /></para>
  <chapter eid="2CO 6" />
  <chapter number="7" style="c" sid="2CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1" />Tunde Mirikisi yi mu anikowori mu, oboki na, bila de mu sa nkimu ma sere sere siki kowon mbo de yaa sa nki nja aworomu dola, de mu yi zunwa seki nja beyi girima ba Mirikisi.<verse eid="2CO 7:1" /></para>
  <para style="s">Peri Siki Ni Bulusu</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2" />Ku shika dishiya aku daa nja mu. Mu yi nseda lepi ba, mu shushe nseda ba, ko mu bebeta nseda ba. <verse eid="2CO 7:2" /><verse number="3" style="v" sid="2CO 7:3" />Ni pala yomu de ni ba nseda lepi na ba; Ni pala yomu yiride ku samu anya a dishiya mu ko mu mani leyi ko mu muntu. <verse eid="2CO 7:3" /><verse number="4" style="v" sid="2CO 7:4" />Ni mani sori dishiya anya aku soseyi; Na dukwa geba ni oku. Ni samu sori dishiya; a siki guru takaasi Ni meyi perisiki soseyi.<verse eid="2CO 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5" />Ko kwanki de mu zo a kesa Makidoniya, mu pushe ba, sede sua dama mu guru anya de mu juyi, a woze sua bila mu nrikishi, a siki womba ma a siki amu. <verse eid="2CO 7:5" /><verse number="6" style="v" sid="2CO 7:6" />Sede Mirikisi, de yaa ba worede su mani sori dishiya ba, e ba mu sori guyam kwanki de Taru zo, <verse eid="2CO 7:6" /><verse number="7" style="v" sid="2CO 7:7" />ba zo e yi na kin sa ku peri siki ba sede sobon sori guyam de ku beyi. E gye mu yiri sa dishiya de ku yi a kiya na, yowa basi dishiya, mala beyi de ku yi sobon e ni, sobon yomu peri siki na e pi ni pari.<verse eid="2CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8" />Ko nde nisa ku beki siki a kiya takada de ni rubuta, E dama Ni ba. Ko de e dama Ni a beyi, Ni shina takada ni e dama ku, sede ni kwanki piri na. <verse eid="2CO 7:8" /><verse number="9" style="v" sid="2CO 7:9" />Kuzukam Ni yi peri siki, kode nkye Ni sa ku beki siki, sede sobon basi dishiya aku e sa ku juyi. Sobon beki siki aku e ma yiri de Mirikisi yaa so, sobon yomu e ma ku asara mbodaa ba anya amu a kowon turiki. <verse eid="2CO 7:9" /><verse number="10" style="v" sid="2CO 7:10" />Beki siki yiri ni Mirikisi yaa zo juyi bila mungu mbo nja sila e ma suwo nse ba, sede beki siki ni durinya yaa zo muntu. <verse eid="2CO 7:10" /><verse number="11" style="v" sid="2CO 7:11" />Geni mbo de beki siki Mirikisi yi a dishiya aku: e sa ku memeri yi mbo, e sa ku shina nkye ku yi mbo kyakya ba, e sa ku yi anwashi, ku yi womba, ari ku sa dishiya, ku yi sori guyam, a kowon turiki ku nana mu nkye ku mani lepi ba. <verse eid="2CO 7:11" /><verse number="12" style="v" sid="2CO 7:12" />Ko kwanki de ni rubuta ku takada, ba a kiya nsu de yi lepi na ba ko nsu de su yi lepi, sede Ni rubuta de Mirikisi e geni yiri de ku yeda mu. <verse eid="2CO 7:12" /><verse number="13" style="v" sid="2CO 7:13" />A siki guru mbo mu mu man sori guyam.</para>
  <para style="p" vid="2CO 7:13">A siki sori guyam de ku ba mu, mua yi peri siki yiride mu geni Taru meyi perisiki nja guru aku, sobon sori guyam de ku yi. <verse eid="2CO 7:13" /><verse number="14" style="v" sid="2CO 7:14" />Ni gye Taru nkye Na dukwa geba sobon oku, ku ba ni kumnya ba. Sede guru mbode mu gye ku e ma gaskye la, dukwa geba amu nja ku a kiya Taru e ma gaskye anya e yi. <verse eid="2CO 7:14" /><verse number="15" style="v" sid="2CO 7:15" />So de Taru man shi a kiya guru aku e man yowa soseyi nde e turunwa ni yiride guru ku kwa beyi girima, ku keleba e yi nja womba nja beyi girima. <verse eid="2CO 7:15" /><verse number="16" style="v" sid="2CO 7:16" />Ni yi peri siki Ni man sori dishiya nku.<verse eid="2CO 7:16" /></para>
  <chapter eid="2CO 7" />
  <chapter number="8" style="c" sid="2CO 8" />
  <para style="s">Sedeka Ni nsu biya Mirikisi</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1" />Kuzukam, yayuwa na, mua bila de ku shina a kiya ni aniyeri de Mirikisi yi nsu biya Yesu de su ma a Makidoniya. <verse eid="2CO 8:1" /><verse number="2" style="v" sid="2CO 8:2" />A siki totolo gwada nja takaasi, ni perisiki ku si geba ni beyi sedeka aku ni gyolo te ba ntani worede su ko de nkye kuma a siki lesa, sede ku beyi ni dishiya ku da ba ntani. <verse eid="2CO 8:2" /><verse number="3" style="v" sid="2CO 8:3" />Ni sheeda mbo de su yi, su beyi kyakya sori asu. Su kwa beyi pi mbo de su manshi, ba nse da sa su dole ba. <verse eid="2CO 8:3" /><verse number="4" style="v" sid="2CO 8:4" />Su ologba mu de su samu dama de su sua worede de su ma biya Mirikisi nto. <verse eid="2CO 8:4" /><verse number="5" style="v" sid="2CO 8:5" />Su beyi pi mbo de mu sa dishiya de sua yi, sede npari su beyi kiya asu ba Obagizi nja omu du su beyi kiya asu te anya nupi Mirikisi. <verse eid="2CO 8:5" /><verse number="6" style="v" sid="2CO 8:6" />Sobon yomu mu ologba Taru de e si geba ni tala sedeka tunde e shina e tala npari, yaa sua ku nto de ku karikye anki ku ni aniyeri. <verse eid="2CO 8:6" /><verse number="7" style="v" sid="2CO 8:7" />Sede a yiri de kwa si geba a kowoni mbo, a siki beigaskye, a siki beta aku, a siki shina, ko a siki shina gaskye, ko a siki memeri de ku yi mbode e yi kyawu, nja so de ku manshi anya mu, sobon yomu ku si geba ni anki ku ni aniyeri nja beyi sedeka.<verse eid="2CO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8" />Ba mma sa ku dole na ba, sede na bila de ngonta kyakyawu dishiya ni so aku de ku manshi ba worede su. <verse eid="2CO 8:8" /><verse number="9" style="v" sid="2CO 8:9" />Sobon ku shina aniyeri ni Obagizi mu Yesu Kiristi, ko de nkye e ma nsu mbo nani, sede sobon oku Yesu kuma ma potoruwa, de te anya potoruwa e yi mu samu mbo guru anya Mirikisi.<verse eid="2CO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10" />Showura na de na ba ku kyakyawu a kiya beta mu: Shekera de bise oku na ku ma ni pari ba anya beyi, sede nzun memeri de ku yi yomu. <verse eid="2CO 8:10" /><verse number="11" style="v" sid="2CO 8:11" />Kuzukam ku karikye anki, ni yiri dishiya de ku para nshi, ku yi anki mu kyakya sori aku de ku man shi. <verse eid="2CO 8:11" /><verse number="12" style="v" sid="2CO 8:12" />Sobon nde ku man memeri beyi kyawuta, kyawuta ku ma mbo keleba anya Mirikisi te yiri mbo de nse beki manshi, Mirikisi mma so de ku beyi pi mbo de sori aku yaa yiya yi ba. <verse eid="2CO 8:12" /><verse number="13" style="v" sid="2CO 8:13" />Ba nkye mmaso de nja ku keyi nsu loni; de worede su kuma mba nsu mbo de man loni ba, sede guru aku kuma ni lobo kyakya. <verse eid="2CO 8:13" /><verse number="14" style="v" sid="2CO 8:14" />A kwanki mu de ku mani mbo a nani nyowa se ku sua su nto a siki mbo de sua bila, kwanki de ku manshi ba osu ma sua sua ku nto a siki mbo de kwa bila. Yomuna konwawa yaa man lobo yi kyakya, <verse eid="2CO 8:14" /><verse number="15" style="v" sid="2CO 8:15" />Yiri de ema a rubuta a siki beta Mirikisi: &lt;&lt;Ba nsu de tala nyowa e shina yaman nyowa ba, nsu de tala piri e manshi piri ba.&gt;&gt;<verse eid="2CO 8:15" /></para>
  <para style="s">Nsu Bulusu Saka Taru Ta Korenti</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16" />Ni gbede Mirikisi, de e sa a dishiya ni Taru yiri tunani de ni manshi a dishiya na a kiya ku. <verse eid="2CO 8:16" /><verse number="17" style="v" sid="2CO 8:17" />Sobon Taru ema zo anya ku kokowe na ba, sede e ma zo anya ku sobon mbo de e rigye sa a dishiya yi de yi naka. <verse eid="2CO 8:17" /><verse number="18" style="v" sid="2CO 8:18" />Mua saka ku yayiwa mu nja Taru de guru nsu biya Yesu sua yobo yi a kiya anki de yaa yi sobon nabari kyakyawu mu. <verse eid="2CO 8:18" /><verse number="19" style="v" sid="2CO 8:19" />Abeyi yomu, e shiya nsu biya Yesu zabi de ema oboki tepiya amu a kiya anki ni aniyeri de mu ma yi mu beyi sobon de Obagizi e samu girima, nja de mu nana nkye muma ni dishiya ni sua nto. <verse eid="2CO 8:19" /><verse number="20" style="v" sid="2CO 8:20" />Mua bila de muma mbo basi a kiya ni kyawuta de su ba mu ni dishiya daa mu ba. <verse eid="2CO 8:20" /><verse number="21" style="v" sid="2CO 8:21" />Sobon kokori mu e shiya de mu yi mbode ma kyakya, ba a geba Obagizi kin naba sede a ndani ntani du.<verse eid="2CO 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22" />Mua saka yayiwa mu nja su nsum de e nana mu a kowoni kwanki nkye e meyi memeri sua ntani nto soseyi, nja yiri de yaa yi kuzukam pi yiri de yaa yi sobon ni totolo yeda de e manshi a kiya ku. <verse eid="2CO 8:22" /><verse number="23" style="v" sid="2CO 8:23" />Ku turunwa nkye Taru, ema oboki anki na la eni nja shi mu mayi anki mu sobon ku la; yayuwa worede su ma nja shi, nsubiya Yesu la su saka su anki asu ema ba Kiristi girima. <verse eid="2CO 8:23" /><verse number="24" style="v" sid="2CO 8:24" />Nkayomu ku nana ntani yiri so de ku manshi a kiya asu nja delili dukwa geba amu a kiya ku, sobon de nsubiya Yesu su geni nkye e man gaskye la.<verse eid="2CO 8:24" /></para>
  <chapter eid="2CO 8" />
  <chapter number="9" style="c" sid="2CO 9" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1" />E ma dole na de ni rubuta ku nshi a kiya ANKI mu de kwa yi ntani Mirikisi nshi. <verse eid="2CO 9:1" /><verse number="2" style="v" sid="2CO 9:2" />Sobon ni shina nkye ku man memeri de ku sua ntani nto soseyi, e ni mma dukwa geba a kiya ba ntani Makidoniya, ni gye su nkye tun shekera nsuni oku ntani Akaya kuma shiri de ku beyi, yiri beyi kiya ku e rigye sa worede su dege a bisi. <verse eid="2CO 9:2" /><verse number="3" style="v" sid="2CO 9:3" />Sede e ni saka yayuwa mu sobon ni dukwa geba de mua yi a kiya ku mbo mu nana nkye mua yi a rikishi na ba, sede ku ma ashiri, yiri de e ni gye ku de ku ma. <verse eid="2CO 9:3" /><verse number="4" style="v" sid="2CO 9:4" />Sobon nde nsu biya Yesu ni Makidoniya su sa ku de ku shiriya kyawuta ku ba, yaa ma mu mbo kumnya nde a paru yomu, mua sha kumnya yiri de mu dukwa geba a kiya ku, sede e ni kede na man sha kumnya ba nzun oku <verse eid="2CO 9:4" /><verse number="5" style="v" sid="2CO 9:5" />Sobon yomu e ma ni dole la de ni saka yayuwa a geba na kapi de ni zo nja sua karikye tala kyawuta sedeka de ku yi anikowori. De e ma sedeka de ku beyi ni dishiya da, ba nsu de ku beyi ni bebeki beta ba.<verse eid="2CO 9:5" /></para>
  <para style="s">Beyi ni Dishiya Da</para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6" />Ku turunwa ni mbo mu, du nsu de nunkwa yiri piri yaa mani keyi bikiya piri, nja du nsu de nunkwa nyowa yaa samu keyi bikiya nyowa. <verse eid="2CO 9:6" /><verse number="7" style="v" sid="2CO 9:7" />Kowoni nse e beyi yiri de e yi tunani a dishiya e yi de yaa beyi, kede e beyi ni anwashi ko e ma yi dole na de e beyi ba, Mirikisi yaa so nsu de beyi ni dishiya da. <verse eid="2CO 9:7" /><verse number="8" style="v" sid="2CO 9:8" />Mirikisi yaa yi yaa ba ku anabirika nyowa pi mbo de kuma bila, sobon de a kowoni kwanki ku mani guru mbo de kuma bila ari pi mbo de ku ma bila, de ku yi anki aniyeri nshi. <verse eid="2CO 9:8" /><verse number="9" style="v" sid="2CO 9:9" />Yiri de ema a rubuta a siki beta Mirikisi nkye,</para>
  <para style="q1" vid="2CO 9:9">&lt;&lt;Yaa ba potoruwa kyawuta ni dishiya da;</para>
  <para style="q2" vid="2CO 9:9">gangasi yi si geba gbogbo.&gt;&gt;<verse eid="2CO 9:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="2CO 9:10" />Mirikisi na ema ba nsu nunkwa yiri de yaa nunkwa e kwa beyi mbo nsi, yomu na Mirikisi yaa ba ku yiri de kwa nunkwa e shiya yaa sa yiri mu e yi girima, yomu na Mirikisi yaa sa beyi amu de mua yi ni dishiya da mu e ja ku yowa ni anki ku ni gangasi anya Mirikisi. <verse eid="2CO 9:10" /><verse number="11" style="v" sid="2CO 9:11" />Mirikisi yaa sa ku anabirika a siki guru mbo de ku ma nsu beyi ni dishiya da a kowoni kwanki, te yomu na ntani nyowa sua gbede Mirikisi sobon sedeka aku de ku beyi te anya mu.<verse eid="2CO 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 9:12" />Sobon anki ku ni aniyeri de kwa yi yaa biya mbo de ntani Mirikisi sua so kede ba sede yaa sa ntani nyowa su gbede Mirikisi. <verse eid="2CO 9:12" /><verse number="13" style="v" sid="2CO 9:13" />Sobon anki kyawuta de kuma yi, yaa sa ntani sua yobo Mirikisi sobon ni beyi girima aku nja yeda aku nja manki Kiristi, nja beyi ni dishiya da de ku yi su nshi nja ririgye ntani guru. <verse eid="2CO 9:13" /><verse number="14" style="v" sid="2CO 9:14" />A siki lepa asu sua turunwa nku a siki dishiya asu, sobon aniyeri de baki mma yi yaa pala ba de Mirikisi yi ku nshi. <verse eid="2CO 9:14" /><verse number="15" style="v" sid="2CO 9:15" />Mu gbede Mirikisi sobon kyawuta de e yi mu nshi de mua yi yaa pala ba.<verse eid="2CO 9:15" /></para>
  <chapter eid="2CO 9" />
  <chapter number="10" style="c" sid="2CO 10" />
  <para style="s">Bulusu Tele Kiya e yi A kiya Anki E yi</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1" />E ni Bulusu nkiya na, mma ologba ku, e ni de su ma nkye &lt;&lt;Ni ma ni soki kiya sobon Kiristi&gt;&gt; nde ni te ma nja ku ndani ni ndani, sede &lt;&lt;Ba puari geba&gt;&gt; nde ni ma nja ku ba! <verse eid="2CO 10:1" /><verse number="2" style="v" sid="2CO 10:2" />Mma yi ologba ku kede ku sa ni nnana ku sori nde ni te zo sobon ni shina na yi yaa nana worede de su ma tunani nkye mbo de mua yi e ma ni yiri durinya mu la. <verse eid="2CO 10:2" /><verse number="3" style="v" sid="2CO 10:3" />Kode nkye mua zunwa a siki durinya la, sede yanki mu e ma yiri de durinya sua yi na ba. <verse eid="2CO 10:3" /><verse number="4" style="v" sid="2CO 10:4" />Keyi yanki mu de mua yi yanki nshi e ma keyi yanki durinya mu na ba sede mua yi ampani ni keyi yanki Mirikisi na de mu juru tunani yaruwa ni dishiya ntani. <verse eid="2CO 10:4" /><verse number="5" style="v" sid="2CO 10:5" />Mua juru kowoni yiri musu de e ma nana ntani shina Mirikisi, mua kuma ni kowoni tunani dishiya nse beki de su biya doka ni Kiristi. <verse eid="2CO 10:5" /><verse number="6" style="v" sid="2CO 10:6" />Nja muma shiri de mu ba nsu lesa zi poro, nde ku beyi girima te nja Kiristi.<verse eid="2CO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7" />Ku kone mbo de e ma paru a sisika aku maana. Nde nse da ku nkye e ma ni Kiristi la, bila de nse ni e shina nkye omu ma du mu ma ni Kiristi la. <verse eid="2CO 10:7" /><verse number="8" style="v" sid="2CO 10:8" />Ko nde mma dukwa geba a kiya sori de Obagizi ba mu de mu gina ku, ba de mu juru ku na ba, e ni taba zi kumnya a kiya sori mu ba. <verse eid="2CO 10:8" /><verse number="9" style="v" sid="2CO 10:9" />E ni ma bila de ni ba ku womba a takada de ni rubuta ku nshi na ba. <verse eid="2CO 10:9" /><verse number="10" style="v" sid="2CO 10:10" />Sobon worosu su aku su pala nkye. &lt;&lt;A siki takada Bulusu e ma nana sori nja wuya, sede nde e ma nja mu, e ma nsu beta soseyi na ba nja beta e yi ma mbo da na ba.&gt;&gt; <verse eid="2CO 10:10" /><verse number="11" style="v" sid="2CO 10:11" />Yiri ntani mu su shina nkye yiri de mu rubuta a siki takada mu a kwanki de mu ma nja su ba, yomuna mua yi nde muma nja ku.<verse eid="2CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12" />Waa ma omu! mu deta de mu la kiya mu kankye ntani de su ma la kiya su su pi konwawa ba. Ntani worede mu su ma gonta kiya su nja nkyasu, su ma Odundu la. <verse eid="2CO 10:12" /><verse number="13" style="v" sid="2CO 10:13" />Sede omu mua dukwa geba pi yiride e kamata ba sede mua dukwa geba a kiya yanka de Mirikisi ba mu, yanka de yada nzun oku. <verse eid="2CO 10:13" /><verse number="14" style="v" sid="2CO 10:14" />Oku ma ku ma a siki yanka mu de Mirikisi ba ni, Sobon yomu mu bise bikiya ni yiri ba de ni te ari anya ku sobon manki kyakyawu ni Kiristi. <verse eid="2CO 10:14" /><verse number="15" style="v" sid="2CO 10:15" />Dukwa geba amu e pi yiri de e kamata mu yi ba, e kuma ma te anya ANKI worosu su de su yi naba. Sede sa dishiya mu e shiya ma de, beigaskye aku e sigeba, yomuna ANKI amu a siki ku yaa ja yowa soseyi. <verse eid="2CO 10:15" /><verse number="16" style="v" sid="2CO 10:16" />De mu beyi manki nabari kyakyawu a worosu su kesa de su ma a geba nku. Ba sobon de mu bila de mu yi seni te anya ANKI de worosu su rigye yi a kesa daa ba.<verse eid="2CO 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 10:17" />Sede, Yiri de beta Mirikisi pala nkye, &lt;&lt;Du nsude yaa dukwa geba e yi, e dukwa geba sobon ni Obagizi.&gt;&gt; <verse eid="2CO 10:17" /><verse number="18" style="v" sid="2CO 10:18" />Sobon ba nsude e ma yobo kiya yi la sua yeda nshi ba, sede nsude Obagizi yobo yi.<verse eid="2CO 10:18" /></para>
  <chapter eid="2CO 10" />
  <chapter number="11" style="c" sid="2CO 11" />
  <para style="s">Bulusu Nja Yaya Manki Yaruwa</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1" />Mma ologba ku de ku kadishiya nja Odundu na de mmayi; sede ku kadishiya nja ni. <verse eid="2CO 11:1" /><verse number="2" style="v" sid="2CO 11:2" />Mmayi kishi aku kishi sobon so ni Mirikisi de e mayi a kiya ku. Ni shiriya ku amere nja Kiristi, na so de ni la ku ba yi ba dola kankye okeshe ba Yesu. <verse eid="2CO 11:2" /><verse number="3" style="v" sid="2CO 11:3" />Sede mmayi womba kede yiri mbode paru nja Awawu e paru nja ku mesi shirigye yi ni wayo e yi, kede oku ma dishiya ku e tari bila sisika beyi kiya nja aminshi a siki Kiristi. <verse eid="2CO 11:3" /><verse number="4" style="v" sid="2CO 11:4" />Sobon nde nseda zo ku ni manki Yesu daa mbom ba Yesu nsude mu keyi ku manki e yi ba, ko nde ku keleba aworo daa mbom de ma daa de ku keleba anya mu ba, ko e ma manki daa mbom nja nsude ku keleba anya mu, kode nkye e ma mbo mu nja nsude mu kokoyi ku. <verse eid="2CO 11:4" /><verse number="5" style="v" sid="2CO 11:5" />Sede worede oku kwa sukwa &lt;&lt;Toree yayamanki&gt;&gt; su pi ni mbodaa ba. <verse eid="2CO 11:5" /><verse number="6" style="v" sid="2CO 11:6" />Kode nkye su kokoyi ni yiride na yi beta ba, sede ni man shina mbo. Mu nana ku mbo worosu mu a kowoni turiki. <verse eid="2CO 11:6" /><verse number="7" style="v" sid="2CO 11:7" />Ni yi lepi aka de ni bwala kiya na de su dege ku te a totolo meseyi te anya beyi manki Mirikisi kyakyawu te anya ku kyawuta? <verse eid="2CO 11:7" /><verse number="8" style="v" sid="2CO 11:8" />E ma kankye ni keleba gyolo anya worosu su nsubiya Yesu nsori de ni yi ku ANKI. <verse eid="2CO 11:8" /><verse number="9" style="v" sid="2CO 11:9" />A kwanki de ni ma nja ku ni lesa mbodaa ba, ni mani mbode na yi ni gyolo nzun yomu ni dama ku ba, sede yayuwa de su butu dege Makidoniya na su ba ni guru mbode mma so. Ni ja ku loni a kwanki ni ba, Na kuma sigeba ni yi yomu. <verse eid="2CO 11:9" /><verse number="10" style="v" sid="2CO 11:10" />Sobon gaskye ni Kiristi de ma a siki na, ba nseda a siki kesa ni Akaya de yaa nana ni dukwa geba. <verse eid="2CO 11:10" /><verse number="11" style="v" sid="2CO 11:11" />Mina sa de ni pala yomu? Sobon ni ma so ku ba na? Mirikisi shina mma so ku! <verse eid="2CO 11:11" /><verse number="12" style="v" sid="2CO 11:12" />Na sigeba ni yi mbode ni mayi a siki ku ni ki keleba gyolo anya ku, sobon de worede sua dukwa geba nkye su mayi ANKI kyakya yiride mua yi. <verse eid="2CO 11:12" /><verse number="13" style="v" sid="2CO 11:13" />Sobon yiri ntani woroni su ma yayamanki gaskye naba, nsu ANKI yaruwa la, su la kiya su ma kankye yayamanki ni Kiristi. <verse eid="2CO 11:13" /><verse number="14" style="v" sid="2CO 11:14" />E ma mbo mamanki naba sobon obiri nkiya yi e ma la nki e yi ma kankye meleku ni asikye. <verse eid="2CO 11:14" /><verse number="15" style="v" sid="2CO 11:15" />Sobon yomu e ma mbo mamanki naba nde yayamanki obiri juyi kiya su kankye yayamanki ni gangasi, a karishe sua samu nani wuta asu kyakya ni ANKI su.<verse eid="2CO 11:15" /></para>
  <para style="s">Bulusu Dukwa Geba A kiya Genbeki E yi</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16" />Mma sakye pala jaja: Kede nseda e geni kankye ni ma Odundu. Sede nde ku mayi tunani yomuna, ku keleba ni kankye Odundu yiri de ku mayi tunani, de ni samu mbo dukwa geba piri. <verse eid="2CO 11:16" /><verse number="17" style="v" sid="2CO 11:17" />Yiri dukwa geba mu de ni mayi, ba nkye Obagizi na sani mayi beta mu ba, sede a siki beta mu mma dukwa geba kankye Odundu la. <verse eid="2CO 11:17" /><verse number="18" style="v" sid="2CO 11:18" />Tunde ntani worosu su sua dukwa geba kankye yiride ntani durinya sua yi, bila de e ni ma ni yi yomu. <verse eid="2CO 11:18" /><verse number="19" style="v" sid="2CO 11:19" />Oku de ku man wayo soseyi, ari de kwa yi peri siki de ku zi beta nsu Odundu. <verse eid="2CO 11:19" /><verse number="20" style="v" sid="2CO 11:20" />Nde nseda sa ku ma bunwa Ku ma beyi girima, ko nde e keleba ku mbode e ma na ku ko e more ku ko e nana ku sori ko e yi ku mari a pisika. <verse eid="2CO 11:20" /><verse number="21" style="v" sid="2CO 11:21" />E ni yaa ma ni mbo kumnya nde ni pala nkye muma nsori ni yi mbo worosu mu ba! nde nseda yi sori dishiya e dukwa geba a kiya mbodaa, e ni ma na yi sori dishiya de ni yi yomu, anya mu de mmayi beta kankye Odundu la. <verse eid="2CO 11:21" /><verse number="22" style="v" sid="2CO 11:22" />Nde su ma ntani Ibireniyawa la, e ni ma du ni ma Ibireniyawa la. Nde su ma geni kankye su ma ntani Izireyila la, yomuna e ni ma du. Nde su ma zuriya ni Abireyi la e ni ma ni ma zuriya ni Abireyi la. <verse eid="2CO 11:22" /><verse number="23" style="v" sid="2CO 11:23" />Nde su ma nsu ANKI Kiristi la, ni pi su. Mmayi beta kankye nsude kiya e yi tari, ni pi su kokori soseyi, ni yi ANKI pi konwawa, ni ma jaru kowoni kwanki, ni sha dukwa nyowa, ni geni muntu a kowoni kwanki. <verse eid="2CO 11:23" /><verse number="24" style="v" sid="2CO 11:24" />Sen biyari ni ma keleba ambere talatin ni tera a nani Yawudawa. <verse eid="2CO 11:24" /><verse number="25" style="v" sid="2CO 11:25" />Sen wuku ni sha dukwa a nani ntani Roma, su ribi ni ndunsi sen daa, sen wuku kwanto wokye ni ma a siki e yi, ni yi dederi nja nana a siki ni totolo riki, <verse eid="2CO 11:25" /><verse number="26" style="v" sid="2CO 11:26" />A siki tepiya na a kowoni kwanki. Ni gomu ni aseri a siki riki ni gomu nja bolowa, a siki aseri anya ntani na, ni sha Genbeki anya yayuwa na Yawudawa, ni kwa sha wuya soseyi a nani worede su ma Yawudawa ba, ni yuru a Genbeki a siki totolo geri, ni sha wuya a siki sanwa, ni geni aseri a siki totolo riki nja ni yuru a siki aseri nja yayuwa nsu yaruwa. <verse eid="2CO 11:26" /><verse number="27" style="v" sid="2CO 11:27" />Ni yi ANKI soseyi, ni sha wuya A kowoni kwanki ni iya kwana ba; ni zi nyunwa nja kishi riki, a kwanki nyowa ni lesa mbosi; ni sha yari a kwanki nyowa, ni lesa keyi sa nki. <verse eid="2CO 11:27" /><verse number="28" style="v" sid="2CO 11:28" />Boni worosu mbo bombom de su ma paru nja ni, nzun yomu ni man sori kula ni ntani nsubiya Yesu. <verse eid="2CO 11:28" /><verse number="29" style="v" sid="2CO 11:29" />Nde nseda a siki nsubiya Yesu lesa sori, na zi kankye eni la ni lesa sori, nde nseda puari a siki lepi, na zi beki siki soseyi. <verse eid="2CO 11:29" /><verse number="30" style="v" sid="2CO 11:30" />Nde e ma dole na de ni dukwa geba, na dukwa geba ni mbode nana lesa sori na. <verse eid="2CO 11:30" /><verse number="31" style="v" sid="2CO 11:31" />Mirikisi Adaa ni Obagizi Yesu, nsude deta yobo ni gbogbo shina nkye ni ma pala yaruwa naba. <verse eid="2CO 11:31" /><verse number="32" style="v" sid="2CO 11:32" />A siki kesa ni Dimasiku gomuna de ma kisi seleki Aretas e sa nsu kpanku kopa ni totolo geri de su ka ni. <verse eid="2CO 11:32" /><verse number="33" style="v" sid="2CO 11:33" />Sede su la ni sa a siki obubu su biya ni te taga ni golonwa totolo geri ni sila a nani seleki.<verse eid="2CO 11:33" /></para>
  <chapter eid="2CO 11" />
  <chapter number="12" style="c" sid="2CO 12" />
  <para style="s">Mbode Yesu Pelesa Ba Bulusu</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1" />Dole Na ndukwa geba. Kode e mani ampani mbodaa ba, na sigeba ni pala mbode Obagizi bure ni ndani de Ni geni nja de e nana ni a siki pelesa. <verse eid="2CO 12:1" /><verse number="2" style="v" sid="2CO 12:2" />Ni shina nseminji daa de shekera gom sha wuru de bise su leyi ta a bisi ni wuku te anya sori Kiristi. Ko e ma a siki nki ko a siki aworo ni shina ba Mirikisi la shina. <verse eid="2CO 12:2" /><verse number="3" style="v" sid="2CO 12:3" />Ni shina nseminji mu su leyi te a bisi, ko e ma a siki nki la ko e ma a siki aworo la ni shina ba, sede Mirikisi la shina, <verse eid="2CO 12:3" /><verse number="4" style="v" sid="2CO 12:4" />su la yi te anya de Mirikisi ma. e zi mbode e ma boyi de baki yaa yi yaa pala ba, mbode nsebeki yaa yi yaa pala su ba. <verse eid="2CO 12:4" /><verse number="5" style="v" sid="2CO 12:5" />Na dukwa geba a kiya yiri nseminji mu, sede na taba dukwa geba a kiya kiya na ba, sede a kiya mbo worede su nana lesa sori na. <verse eid="2CO 12:5" /><verse number="6" style="v" sid="2CO 12:6" />Nde ni so de ndukwa geba, na taba ma Odundu ba, sobon na pala gaskye la. Sede na dukwa geba ba kede nseda e la ni pi yiride e ma geni ni nja yiride e zi ni mmayi beta. <verse eid="2CO 12:6" /><verse number="7" style="v" sid="2CO 12:7" />Sobon kede ndukwa geba a kiya totolo bure ndani de Mirikisi nana ni nshi na su kiri ni suwo a nki de e ma kankye ankwanya a siki nki na, da mu e ma yamanki obiri la de e saka de e ba ni ngala de e nana ni dukwa geba. <verse eid="2CO 12:7" /><verse number="8" style="v" sid="2CO 12:8" />Sen wuku ni ologba Obagizi de e laba ni nsuwo mu. <verse eid="2CO 12:8" /><verse number="9" style="v" sid="2CO 12:9" />Sede Mirikisi gye ni nkye, &lt;&lt;Aniyeri na e deta ke, sobon te anya lesa sori ke na ntani sua geni sika sori na.&gt;&gt; Nkayomu na dukwa geba soseyi ni peri siki a kiya lesa sori na, sobon de sori Kiristi e zunwa nja ni. <verse eid="2CO 12:9" /><verse number="10" style="v" sid="2CO 12:10" />Mbode sa naka, ni gane ni rishi sori na, nja basi de su ma basi ni, nja Genbeki de ni ma sha, nja takaasi de mma geni, nja wuya de su ma ba ni sobon Kiristi. Sobon a kwanki de ni lesa sori, a kwanki ni na mma man sori.<verse eid="2CO 12:10" /></para>
  <para style="s">Bulusu Damu A kiya Nsubiya Yesu A korenti</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11" />Ni yi Odundu, sede oku na ku sa ni de ni yi yomu. E kamata de ku yobo ni, kode ni ma mbodaa ba nzun yomu be nana nkye &lt;&lt;Toree yayamanki&gt;&gt; aku mu su pi ni ba. <verse eid="2CO 12:11" /><verse number="12" style="v" sid="2CO 12:12" />Mbode nana nkye ni ma yamanki ni gaskye, e shiya ma anki alama, nja mbo mamanki de ni yi a siki aku ni ka dishiya osu na su nana nkye ni ma yamanki ni gaskye. <verse eid="2CO 12:12" /><verse number="13" style="v" sid="2CO 12:13" />Te woni turiki na ni nkye kuma kyakya nja ntani nsubiya Yesu ba? ko sobon de ni nana ku de ku sua ni nto ni gyolo na? Ku yape ni lepi mu! <verse eid="2CO 12:13" /><verse number="14" style="v" sid="2CO 12:14" />Kuzukam Ni yi shiri de ni zo anya ku ni son wuku, Na taba dama ku de ku sua ni nto ba, sobon oku na, ni ma so ba gyolo aku na mma bila ba. E yi kyawu de yaya na su la loni nsu adaa asu ba, sede nsu adaa asu na su la loni yaya asu. <verse eid="2CO 12:14" /><verse number="15" style="v" sid="2CO 12:15" />Na yi peri siki nde ni kisa guru mbode manshi nzun beyi kiya na sobon de nsua ku nto. Nde ni so ku soseyi oku kwa rigye so de ku man shi a kiya na naka? <verse eid="2CO 12:15" /><verse number="16" style="v" sid="2CO 12:16" />Kwa yeda nja ni, ni ma ku loni keyi ba. Sede, nseda nkye ni nana ku wayo na, ni shishirigye ku! <verse eid="2CO 12:16" /><verse number="17" style="v" sid="2CO 12:17" />Ni shushe ku te anya ntani de ni saka su anya ku? <verse eid="2CO 12:17" /><verse number="18" style="v" sid="2CO 12:18" />Ni ologba Taru de e te anya ku nja ni saka yayiwa mu daa nsubiya Yesu te nja shi. Ko Taru shushe ku la? Eni nja Taru aworo ndandaa na e ma biya mu bo? Turiki ndandaa na mua biya bo?. <verse eid="2CO 12:18" /><verse number="19" style="v" sid="2CO 12:19" />Ku mayi tunani nkye mua yi kokori de mu tele kiya mu anya ku la? Mirikisi na ma sheeda mu mua yi beta kankye ntani de su ma ni Kiristi; guru mbode mu yi, yayuwa na, mua yi de mu ja ku sori guyamu la. <verse eid="2CO 12:19" /><verse number="20" style="v" sid="2CO 12:20" />Sobon ni ma zi womba kede kwanki de ni zo Na san ku yiri de mma bila ba, oku ma ku sani yiri de kuma bila ba. Ni mayi womba sobon na san rikishi, nja kishi nja zapi leyi, nja so kiya, nja bebeta nkiya ku seni, nja guluma nkiya ku, nja dege kiya nja dege ankeli ntani. <verse eid="2CO 12:20" /><verse number="21" style="v" sid="2CO 12:21" />Ni ma zi womba nde ni zo anya ku Mirikisi yaa sani de nzi kumnya a geba aku, ni mayi womba kede ni yi beki siki sobon ntani nyowa de su mayi mbo mumungu su ki de juyi bila mungu mbo asu, lepi ni nungwe nja akusuka nja so zunwa dadi.<verse eid="2CO 12:21" /></para>
  <chapter eid="2CO 12" />
  <chapter number="13" style="c" sid="2CO 13" />
  <para style="s">Jaa Kuni Bulusu Ni Karishe</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1" />Nsum nama zo na ni wuku de mma zo anya ku. &lt;&lt;Ema dole na su zi sheeda beta a baki ntani bi ko wuku&gt;&gt; Yiride ema a rubuta a siki beta Mirikisi. <verse eid="2CO 13:1" /><verse number="2" style="v" sid="2CO 13:2" />Zo Na ni bi anya ku ni jaa worede su yi mungu mbo kuni nja ririgye ntani guru su bila yi mungu mbo. Kuzukam mma sakye pala jaja ko de ni ma nja ku anya ni ba: Sobon nde ni kuma mbeyi Na bila worede su ma yi lepi ko mungu mbo ba. <verse eid="2CO 13:2" /><verse number="3" style="v" sid="2CO 13:3" />Tunde kwa bila de ni nana ku nkye Kiristi yaa yi beta te anya na. Kiristi lesa sori a siki ku ba, sede e nana sori yi a siki ku. <verse eid="2CO 13:3" /><verse number="4" style="v" sid="2CO 13:4" />Kode su gidiri Kiristi te anya rishi sori, nzun yomu e man leyi te anya sori Mirikisi. Kode nkye, muma ntani mere sori la a siki Kiristi, nzun yomu te anya sori Mirikisi mua man leyi nja shi sobon anki de muma yi a siki aku. <verse eid="2CO 13:4" /><verse number="5" style="v" sid="2CO 13:5" />Ku gonta kiya ku de ku geni ko kuma biya Yesu Kiristi a siki aminshi; ku gonta kiya ku. Ko ku shina nkye Yesu Kiristi ema a siki ku bo? Nde ku te shina ba, kwa puari a siki gwada. <verse eid="2CO 13:5" /><verse number="6" style="v" sid="2CO 13:6" />Ni beigaskye kwa shina nkye mu ma yayamanki Mirikisi ni gaskye. <verse eid="2CO 13:6" /><verse number="7" style="v" sid="2CO 13:7" />Kuzukam mua yi lepa te nja Mirikisi de kede ku yi mbo mumungu ba. Ba nkye mu ma yi kokori de mu la kiya mu kankye mu shakiya ni gwada na ba sede de ku yi mbode ema kyakya kode nkye ntani sua geni kankye mua yi yaa yi kyakya ba. <verse eid="2CO 13:7" /><verse number="8" style="v" sid="2CO 13:8" />Sobon mua taba yi mbode yaa yi geba nja gaskye ba, sede mua biya gaskye. <verse eid="2CO 13:8" /><verse number="9" style="v" sid="2CO 13:9" />Mua yi perisiki du kwanki de mu lesa sori nde oku ku man sori; lepa amu e shina de ku ma sisika. <verse eid="2CO 13:9" /><verse number="10" style="v" sid="2CO 13:10" />Mbode sa ni rubuta mbo mu naka a kwanki de ni ma nja ku ba, sobon nde ni zo kede ni yi ku beta nsori, sori de Obagizi ba ni de ni gina ku, ba de njuru ku ba.<verse eid="2CO 13:10" /></para>
  <para style="s">Gesuwa Bulusu Ni karishe</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11" />A karishe, yayuwa na se na daa. ku yi kokori de ku yi zunwa de ma kyakya, ku zi ologba de mma yi ku nshi, ku yeda ni nkiaku, ku yi zunwa selema. Yomuna Mirikisi ni selema nja so yaa ma nja ku.<verse eid="2CO 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 13:12" />Ku geshe nkiaku ni gesuwa nsuseki. <verse eid="2CO 13:12" /><verse number="13" style="v" sid="2CO 13:13" />Guru nsubiya Mirikisi sua geshe ku.<verse eid="2CO 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 13:14" />Aniyeri Obagizi Yesu Kiristi, nja so ni Mirikisi, nja zumunshi ni Aworo Nsuseki ema nja ku guru. Emayomu.<verse eid="2CO 13:14" /></para>
  <chapter eid="2CO 13" />
</usx>