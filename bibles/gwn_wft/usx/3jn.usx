<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">3YH- Gwandara</book>
  <para style="h">3 Yaaya</para>
  <para style="toc1">Takada Yaaya ni wuku</para>
  <para style="toc2">3 Yaaya</para>
  <para style="toc3">3 Yah</para>
  <para style="mt2">Takada ni wuku</para>
  <para style="mt1">Yaaya</para>
  <para style="imt">Waa ma e ke</para>
  <para style="ip">Takada Yaaya ni wuku e rubuta yi te nja tolense ni nsubiya Yesu nsu seni Gayusu. Yaaya yobo Gayusu sobon mbo kyakyawu de e mayi nsubiya Yesu, e sakye gila su nseminji nsu seni Diyotaripis de meyi gaba nja nsu ANKI Obagizi.</para>
  <para style="iot">Mbode ma siki yi</para>
  <para style="io1">Pala waa e ke 1-4</para>
  <para style="io1">Yobo Gayusu 5-8</para>
  <para style="io1">Bebeta Diyotaripis 9-10</para>
  <para style="io1">Gaskye ni Dimitiriyus 11-12</para>
  <para style="io1">A karishe 13-15</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />E ni Yaaya tolense ni nsubiya Yesu Ni rubuta ku takada mu,</para>
  <para style="p" vid="3JN 1:1">Te anya ni oboki na Gayusu, nsude ni ma so ni gaskye.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />Oboki na de mma so, Mma yi lepa de ki mani selema a kowoni turiki nja lapiya nkyake yiride leyi ke e mani lapiya. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Ni yi peri siki de worosu su yayuwa zo beyi sheeda a kiya yiride ki sakisi nsori a siki gaskye nja yiride ki meyi tepiya a siki gaskye. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Mbode yaa pi sa ni perisiki e shiya de ni zi nkye yaya na su ma yi tepiya a siki gaskye.<verse eid="3JN 1:4" /></para>
  <para style="s">Yobo Gayusu</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Oboki na de na so, ki mani gaskye a siki guru mbode ki meyi sobon yayuwa nsubiya Yesu, kode su ma bakwe na anya ake. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />Ntani de ki sua gye nsubiya Yesu yiri so de ki ma nshi. Sigeba ni sua su nto a siki tepiya su de su meyi a turiki de yaa jima Mirikisi. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Ntani worosu mu su butu awuje sobon manki seni Kiristi, su ma keleba kyawuta ni mbodaa anya nsubiya boka ba. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Nkayomu e kamata de mu sua yiri ntani worosu mu nto de nana nkye mua yi ANKI yere a kiya gaskye.<verse eid="3JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Ni rubuta takada mu te nja nsubiya Yesu, sede Diyotaripis, de so e ma tolense a siki asu, ki de zi beta amu. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Nde ni te zo anya ku, Na pelesa mbode e yi a boyi: yaa yi yowa beta a kiya mu! E dete yi ba; e ki yi yayuwa nnaba, ari e nana nsubiya Yesu de sua bila yi su nnaba, e kula su butu bila siki nsubiya Yesu.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />E ke oboki na, kede ki biya mbo mumungu sede mbode ma kyakyawu. Du nsude yi mbo kyakyawu e mani Mirikisi la. Du nsude yi mbo mumungu e shina Mirikisi ba kpataka. <verse eid="3JN 1:11" /><verse number="12" style="v" sid="3JN 1:12" />Dimitiriyus konwawa meyi beta kyakyawu a kiya e yi ari gaskye nkiya yi meyi beta a kiya yi du. Omu ma mu beyi sheeda a kiya e yi, ki shina nkye sheeda mu ma gaskye la.<verse eid="3JN 1:12" /></para>
  <para style="s">Gesuwa Karishe</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Ni mani mbo nyowa de na rubuta ke nshi, na bila de ni rubuta su a takada nja mbo rubutu ba. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />Ni ma sadishiya de ngeni ke ndede ba, de mu gomu pisika npisika.<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />Selema ma nja ke. Nsu oboki ake sua geshe ke. Geshe nsu oboki amu anya ni guru.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>