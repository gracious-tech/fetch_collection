<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id" />
  <para style="h">Salmu</para>
  <para style="toc1">Salmu</para>
  <para style="toc2">Salmu</para>
  <para style="toc3">Salmu</para>
  <para style="mt1">Salmu</para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="s">Dalan ksolok nian</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1" />Ema nebee hetan ksolok mak ema nebee la moris tuir ema aat sira nia lia menon,</para>
  <para style="q2" vid="PSA 1:1">la sama sala nain sira nia ain fatin,</para>
  <para style="q2" vid="PSA 1:1">la tuur hamutuk ho ema kontra door sira,<verse eid="PSA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2" />maibee nia gosta teb-tebes NAI Maromak nia lei;</para>
  <para style="q2" vid="PSA 1:2">loron-kalan nia medita ba lei nee.<verse eid="PSA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:3 </char>
      <char style="xt" closed="false">
        <ref loc="JER 17:8">Jeremias 17:8</ref>
      </char>
    </note>Ema nee hanesan ai huun ida nebee kuda besik iha bee dalan,</para>
  <para style="q2" vid="PSA 1:3">nia foo fuan tebar tuir nia tempu,</para>
  <para style="q1" vid="PSA 1:3">nia tahan nunka namlaik.</para>
  <para style="q2" vid="PSA 1:3">Nia halo saida deit, hetan rezultadu diak.<verse eid="PSA 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4" />Ema aat sira nee oin seluk;</para>
  <para style="q2" vid="PSA 1:4">sira hanesan hare kulit mamuk nebee anin huu lakon tiha.<verse eid="PSA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5" />Entaun ema aat sira nee sei la aguenta iha loron justisa;</para>
  <para style="q2" vid="PSA 1:5">sala nain sira nee la bele tama hamutuk ho ema nebee moris loos.<verse eid="PSA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6" />Tanba NAI Maromak kuidadu lalaok ema moris loos nian,</para>
  <para style="q2" vid="PSA 1:6">maibee ema aat sira nia lalaok lori sira ba mate.<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="s">Liurai nebee Nai Maromak hili</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 4:25">Apostolu sira nia Istoria 4:25</ref>,<ref loc="ACT 4:26">26</ref></char>
    </note>Nusaa mak nasaun jentiu sira kombina malu?</para>
  <para style="q2" vid="PSA 2:1">Povu sira tau lia ba malu atu manaan saida?<verse eid="PSA 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2" />Liurai sira iha mundu hamriik hamutuk;</para>
  <para style="q2" vid="PSA 2:2">nai ulun sira nee futu lia</para>
  <para style="q1" vid="PSA 2:2">kontra NAI Maromak</para>
  <para style="q2" vid="PSA 2:2">no kontra liurai nebee mak Nia foti tiha ona.</para>
  <para style="q1" vid="PSA 2:2">Ema sira nee dehan,<verse eid="PSA 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3" />“Mai ita halo ita nia aan livre husi Maromak ho liurai nebee Nia hili nee;</para>
  <para style="q2" vid="PSA 2:3">mai ita harahun tiha korenti nebee mak futu metin ita.”<verse eid="PSA 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4" />Nai Maromak hamnasa fali sira;</para>
  <para style="q2" vid="PSA 2:4">Nia tuur iha lalehan hodi goza sira.<verse eid="PSA 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5" />Depois Nia hasee sira ho hirus;</para>
  <para style="q2" vid="PSA 2:5">Nia hatauk sira ho laran nakali dehan,<verse eid="PSA 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6" />“Hau hatuur tiha ona Hau nia liurai</para>
  <para style="q2" vid="PSA 2:6">iha Siaun, Hau nia foho santu.”<verse eid="PSA 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 2:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:7 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 13:33">Apostolu sira nia Istoria 13:33</ref>; <ref loc="HEB 1:5">Ebreu 1:5</ref>, <ref loc="HEB 5:5">5:5</ref></char>
    </note>Liurai dehan, “Hau sei foo sai buat nebee NAI Maromak deklara tiha ona mai hau.</para>
  <para style="q2" vid="PSA 2:7">Nia deklara nunee:</para>
  <para style="q1" vid="PSA 2:7">‘O nee Hau nia oan.</para>
  <para style="q2" vid="PSA 2:7">Agora ba oin, Hau o nia Aman.<verse eid="PSA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8" />Husu mai Hau mak Hau sei foo nasaun hotu-hotu ba o;</para>
  <para style="q2" vid="PSA 2:8">husi rai ulun too rai ikun sei sai o nia riku-soin.<verse eid="PSA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:9 </char>
      <char style="xt" closed="false">
        <ref loc="REV 2:26">Apokalipse 2:26</ref>,<ref loc="REV 2:27">27</ref>, <ref loc="REV 12:5">12:5</ref>, <ref loc="REV 19:15">19:15</ref></char>
    </note>O sei baku tohar sira ho rota besi;</para>
  <para style="q2" vid="PSA 2:9">o sei halo rahun sira hanesan ema baku rahun sanan rai.’”<verse eid="PSA 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10" />Nee duni liurai sira, sai matenek ba;</para>
  <para style="q2" vid="PSA 2:10">nai ulun mundu nian, aprende di-diak ba.<verse eid="PSA 2:10" /></para>
  <para style="q1">
    <verse number="11-12" style="v" sid="PSA 2:11-12" />Serbi NAI Maromak ho hamtauk,</para>
  <para style="q2" vid="PSA 2:11-12">hakruuk ba Nia<note caller="+" style="f"><char style="fr" closed="false">2:11-12 </char><char style="ft" closed="false">Liafuan “hakruuk ba Nia” ho lian Ebreu la klaru.</char></note> ho nakdedar.</para>
  <para style="q1" vid="PSA 2:11-12">Se lae Nia hirus, halo imi mate derepenti iha dalan,</para>
  <para style="q2" vid="PSA 2:11-12">tanba Nia laran nakali lalais.</para>
  <para style="b" vid="PSA 2:11-12" />
  <para style="q1" vid="PSA 2:11-12">Ema hotu nebee hamahon aan iha Nia, sira hetan ksolok.<verse eid="PSA 2:11-12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="s">Orasaun husu tulun iha tempu susar</para>
  <para style="d">Salmu David nian, bainhira nia halai sees husi nia oan Absalão.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1" />NAI Maromak, hau nia inimigu barak loos;</para>
  <para style="q2" vid="PSA 3:1">iha ema barak hamriik kontra hau!<verse eid="PSA 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2" />Ema barak koalia kona ba hau dehan,</para>
  <para style="q2" vid="PSA 3:2">“Maromak sei la salva nia.”<verse eid="PSA 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3" />Maibee NAI, Ita Boot defende hau;</para>
  <para style="q2" vid="PSA 3:3">Ita Boot tane aas hau no foti sae hau nia ulun.<verse eid="PSA 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4" />Hau bolu NAI Maromak;</para>
  <para style="q2" vid="PSA 3:4">husi Nia foho santu Nia hataan hau.<verse eid="PSA 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5" />Hau toba hakmatek no hadeer fali ho diak,</para>
  <para style="q2" vid="PSA 3:5">tanba NAI kuidadu hau.<verse eid="PSA 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6" />Hau la tauk hau nia inimigu rihun ba rihun</para>
  <para style="q2" vid="PSA 3:6">nebee asalta hau husi sor-sorin.<verse eid="PSA 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7" />NAI, hamriik ba;</para>
  <para style="q2" vid="PSA 3:7">hau nia Maromak, mai salva hau ba!</para>
  <para style="q1" vid="PSA 3:7">Tuku tiha hau nia inimigu sira nia hasan;</para>
  <para style="q2" vid="PSA 3:7">halo tohar tiha ema aat sira nia nehan.<verse eid="PSA 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8" />NAI Maromak, salvasaun mai husi Ita Boot.</para>
  <para style="q2" vid="PSA 3:8">Foo bensaun ba Ita Boot nia povu.<verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="s">Orasaun molok deskansa kalan</para>
  <para style="d">Salmu David nian, ba dirijenti koru. Akompanha ho viola.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1" />Maromak, Ita Boot sempre defende hau;</para>
  <para style="q2" vid="PSA 4:1">hataan hau bainhira hau bolu Ita Boot!</para>
  <para style="q1" vid="PSA 4:1">Uluk hau iha fatin kloot, Ita Boot foo fatin luan mai hau;</para>
  <para style="q2" vid="PSA 4:1">hanoin hau ba, rona hau nia orasaun.<verse eid="PSA 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2" />Imi ema sira nee, imi atu hafoer hau nia naran too bainhira?</para>
  <para style="q2" vid="PSA 4:2">Too bainhira loos mak imi gosta buat nebee la iha folin,</para>
  <para style="q2" vid="PSA 4:2">no duni tuir lia falsu?<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="ft" closed="false">Matenek nain balu dehan, liafuan “lia falsu” nee hatudu ba maromak falsu.</char></note><verse eid="PSA 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3" />Keta haluha katak NAI Maromak hili tiha ona ema nebee moris loos hodi sai Ninian;</para>
  <para style="q2" vid="PSA 4:3">NAI rona bainhira hau bolu Nia.<verse eid="PSA 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:4 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:26">Éfezu 4:26</ref>
      </char>
    </note>Maski tauk ho nakdedar, maibee la bele halo sala;</para>
  <para style="q2" vid="PSA 4:4">bainhira o iha o nia toba fatin, hakmatek hodi reflete aan.<verse eid="PSA 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5" />Fiar ba NAI Maromak</para>
  <para style="q2" vid="PSA 4:5">hodi oferese sakrifisiu nebee loos ba Nia.<verse eid="PSA 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6" />Iha ema barak mak husu, “See mak sei foo moris diak ba ami?</para>
  <para style="q2" vid="PSA 4:6">NAI, leno ami ho Ita Boot nia oin.”<verse eid="PSA 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7" />Ksolok nebee Ita Boot foo tiha ona mai hau</para>
  <para style="q2" vid="PSA 4:7">boot liu fali ksolok nebee sira hetan husi sira nia ai haan ho tua bar-barak.<verse eid="PSA 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8" />NAI, hau sei toba dukur ho hakmatek;</para>
  <para style="q2" vid="PSA 4:8">Ita Boot deit mak halo hau moris seguru.<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="s">Orasaun iha dadeer-saan atu Nai Maromak proteje</para>
  <para style="d">Salmu David nian, ba dirijenti koru. Akompanha ho korneta.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1" />NAI Maromak, see tilun ba hau nia liafuan;</para>
  <para style="q2" vid="PSA 5:1">foo atensaun ba hau nia halerik.<verse eid="PSA 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2" />Hau nia Liurai, hau nia Maromak,</para>
  <para style="q2" vid="PSA 5:2">hau harohan husu tulun ba Ita Boot deit;</para>
  <para style="q2" vid="PSA 5:2">rona hau nia orasaun ba.<verse eid="PSA 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3" />NAI Maromak, dadeer-dadeer Ita Boot rona hau nia lian;</para>
  <para style="q2" vid="PSA 5:3">iha dadeer-saan hau hasae hau nia orasaun ba Ita Boot</para>
  <para style="q2" vid="PSA 5:3">hodi hein Ita Boot nia resposta.<verse eid="PSA 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4" />Tanba Ita Boot Maromak ida nebee la haksolok ho hahalok aat;</para>
  <para style="q2" vid="PSA 5:4">buat aat la bele hela iha Ita Boot nia prezensa.<verse eid="PSA 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5" />Ema nebee foti aan la bele hamriik iha Ita Boot nia oin;</para>
  <para style="q2" vid="PSA 5:5">Ita Boot odi ema aat hotu-hotu.<verse eid="PSA 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6" />NAI Maromak, Ita Boot sempre harahun bosok-teen sira;</para>
  <para style="q2" vid="PSA 5:6">Ita Boot hakribi ema nebee hamrook raan ho lohi door sira.<verse eid="PSA 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7" />Maibee tanba Ita Boot nia domin rohan-laek,</para>
  <para style="q2" vid="PSA 5:7">hau bele tama iha Ita Boot nia uma;</para>
  <para style="q1" vid="PSA 5:7">hau hakruuk ba Ita Boot nia fatin santu</para>
  <para style="q2" vid="PSA 5:7">hodi adora Ita Boot.<verse eid="PSA 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8" />NAI Maromak, hanorin hau atu moris tuir Ita Boot nia lia loos<note caller="+" style="f"><char style="fr" closed="false">5:8 </char><char style="ft" closed="false">Lian Ebreu iha nee bele mos signifika “Ita Boot sempre halo buat nebee loos.”</char></note></para>
  <para style="q2" vid="PSA 5:8">tanba hau iha inimigu barak;</para>
  <para style="q1" vid="PSA 5:8">halo tetuk Ita Boot nia dalan iha hau nia oin para hau bele lao tuir.<verse eid="PSA 5:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:9 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:13">Roma 3:13</ref>
      </char>
    </note>Liafuan nebee sai husi hau nia inimigu sira nia ibun, la iha ida mak loos;</para>
  <para style="q2" vid="PSA 5:9">sira nia laran nakonu ho hanoin aat.</para>
  <para style="q1" vid="PSA 5:9">Sira nia kakorok hanesan rate nebee nakloke;</para>
  <para style="q2" vid="PSA 5:9">sira nia liafuan kos-kose ema.<verse eid="PSA 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10" />Maromak, tesi sira nia lia hodi kastigu sira;</para>
  <para style="q2" vid="PSA 5:10">husik sira nia manobra halo sira rasik monu.</para>
  <para style="q1" vid="PSA 5:10">Sira kontra ona Ita Boot;</para>
  <para style="q2" vid="PSA 5:10">hasai sira husi Ita Boot nia prezensa tanba sira nia sala barak.<verse eid="PSA 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11" />Maibee see-see deit mak buka mahon iha Ita Boot, sira kontenti;</para>
  <para style="q2" vid="PSA 5:11">sira sempre hananu haksolok.</para>
  <para style="q1" vid="PSA 5:11">Proteje ema nebee hadomi Ita Boot</para>
  <para style="q2" vid="PSA 5:11">atu nunee sira nia laran bele haksolok.<verse eid="PSA 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12" />Tebes duni, NAI Maromak, Ita Boot foo bensaun ba ema nebee moris loos;</para>
  <para style="q2" vid="PSA 5:12">Ita Boot nia laran diak haleu sira hodi defende sira.<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="s">Ema moras halerik husu tulun</para>
  <para style="d">Salmu David nian, ba dirijenti koru. Akompanha ho viola tali walu.<note caller="+" style="f"><char style="fr" closed="false">6:0 </char><char style="ft" closed="false">Orijinal laduun klaru, karik instrumentu muzika ida ho tali walu, bele mos termu muzika ida seluk.</char></note></para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:1">Salmu 38:1</ref>
      </char>
    </note>NAI Maromak, maski Ita Boot hirus hela hau, maibee keta siak hau;</para>
  <para style="q2" vid="PSA 6:1">maski Ita Boot nia laran nakali hela, maibee keta kastigu hau.<verse eid="PSA 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2" />NAI, hau nia forsa lakon tiha, hanoin hau ba!</para>
  <para style="q2" vid="PSA 6:2">NAI, hau nia ruin sira moras hotu kura hau ba!<verse eid="PSA 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3" />Hau nia laran susar teb-tebes.</para>
  <para style="q2" vid="PSA 6:3">Too bainhira NAI, too bainhira?<verse eid="PSA 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4" />NAI, see Ita Boot nia oin mai hau;</para>
  <para style="q2" vid="PSA 6:4">salva hau ba!</para>
  <para style="q1" vid="PSA 6:4">Hatudu Ita Boot nia domin rohan-laek mai hau</para>
  <para style="q2" vid="PSA 6:4">hodi hasai hau husi susar laran.<verse eid="PSA 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5" />Tanba ema nebee mate ona la temi tan Ita Boot nia naran.</para>
  <para style="q2" vid="PSA 6:5">Iha ema mate sira nia fatin, see mak atu hahii Ita Boot?<verse eid="PSA 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6" />Hau halerik too kole teb-tebes;</para>
  <para style="q2" vid="PSA 6:6">kalan tomak, hau nia matan been suli habokon hau nia kama;</para>
  <para style="q2" vid="PSA 6:6">hau tanis too hau nia toba fatin bokon hotu.<verse eid="PSA 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7" />Hau nia matan sai malahuk tiha tanba hau nia laran dodok nee;</para>
  <para style="q2" vid="PSA 6:7">hau nia matan haree la moos ona tanba hau nia inimigu sira nia hahalok.<verse eid="PSA 6:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:8 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:23">Mateus 7:23</ref>; <ref loc="LUK 13:27">Lucas 13:27</ref></char>
    </note>Imi hotu nebee halo buat aat, hadook aan husi hau,</para>
  <para style="q2" vid="PSA 6:8">tanba NAI Maromak rona ona hau nia halerik.<verse eid="PSA 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9" />Hau husu tulun ba NAI, Nia rona ona hau;</para>
  <para style="q2" vid="PSA 6:9">NAI simu hau nia orasaun.<verse eid="PSA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10" />Hau nia inimigu sira hotu sei moe ho tauk teb-tebes;</para>
  <para style="q2" vid="PSA 6:10">derepenti sira hakiduk ho moe boot.<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="s">Orasaun husu justisa</para>
  <para style="d">Salmu nee David kanta ba NAI Maromak kona ba Kuxe, ema ida husi suku Benjamim.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1" />NAI, hau nia Maromak, hau hamahon aan iha Ita Boot.</para>
  <para style="q2" vid="PSA 7:1">Iha ema buka atu halo aat hau;</para>
  <para style="q2" vid="PSA 7:1">tulun hau no salva hau ba.<verse eid="PSA 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2" />Se lae, sira hanesan liaun lees matak tiha hau;</para>
  <para style="q2" vid="PSA 7:2">sira sei lees hau nia isin halo rohan-rohan, ema atu salva hau la iha.<verse eid="PSA 7:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3-4" style="v" sid="PSA 7:3-4" />NAI, hau nia Maromak, hau nia sala saida?</para>
  <para style="q2" vid="PSA 7:3-4">Hau halo aat ba hau nia belun ka?</para>
  <para style="q1" vid="PSA 7:3-4">Hau halo violensia arbiru deit hasoru hau nia inimigu ka?</para>
  <para style="q2" vid="PSA 7:3-4">Se karik hau halo buat sira nee,<verse eid="PSA 7:3-4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5" />entaun husik hau nia inimigu duni hau hodi kaer tiha hau ba;</para>
  <para style="q2" vid="PSA 7:5">husik nia sama hau ba rai</para>
  <para style="q3" vid="PSA 7:5">too latan tiha hau iha rai rahun.<verse eid="PSA 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6" />NAI Maromak, hamriik ho hirus ba.</para>
  <para style="q2" vid="PSA 7:6">Tuba rai metin hodi hasoru hau nia inimigu tanba sira nia laran nakali.</para>
  <para style="q2" vid="PSA 7:6">Hau nia Maromak, hadeer ona ba hodi foo sai lia loos.<verse eid="PSA 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7" />Halibur hamutuk povu husi rai hotu-hotu para haleu Ita Boot;</para>
  <para style="q2" vid="PSA 7:7">tuur iha fatin aas hodi ukun sira.<verse eid="PSA 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8" />NAI mak tesi povu sira nia lia.</para>
  <para style="q2" vid="PSA 7:8">NAI, hau ema ida nebee moris loos no la sala ida.</para>
  <para style="q2" vid="PSA 7:8">Maromak Aas Liu, foo justisa mai hau ba.<verse eid="PSA 7:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:9 </char>
      <char style="xt" closed="false">
        <ref loc="REV 2:23">Apokalipse 2:23</ref>
      </char>
    </note>Maromak, Ita Boot sempre halo buat nebee loos;</para>
  <para style="q2" vid="PSA 7:9">Ita Boot koko ema nia neon ho laran.</para>
  <para style="q1" vid="PSA 7:9">Hapara tiha ema aat sira nia hahalok aat;</para>
  <para style="q2" vid="PSA 7:9">foo hakmatek ba ema nebee moris loos.<verse eid="PSA 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10" />Maromak mak defende hau;</para>
  <para style="q2" vid="PSA 7:10">Nia salva ema sira nebee laran moos.<verse eid="PSA 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11" />Maromak sempre tesi lia ho loos;</para>
  <para style="q2" vid="PSA 7:11">loro-loron Nia hamonu kastigu ba ema aat.<verse eid="PSA 7:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12" />Se sira la hakribi sira nia sala,</para>
  <para style="q2" vid="PSA 7:12">entaun Maromak sei kadi Nia surik,</para>
  <para style="q2" vid="PSA 7:12">Nia sei dada Nia rama atu hana.<verse eid="PSA 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13" />Sasaan kroat para hamate ema, Nia prepara tiha ona;</para>
  <para style="q2" vid="PSA 7:13">rama oan nebee Nia atu hana, Nia sunu lakan tiha ona.<verse eid="PSA 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14" />Haree ba, ema sira nee kuda hahalok aat,</para>
  <para style="q2" vid="PSA 7:14">sira haburas hanoin aat</para>
  <para style="q2" vid="PSA 7:14">hodi foo rezultadu liafuan bosok.<verse eid="PSA 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15" />Sira kee rai kuak ba ema seluk,</para>
  <para style="q2" vid="PSA 7:15">maibee sira rasik monu tama ba laran.<verse eid="PSA 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16" />Hahalok aat nebee sira halo kona fali sira;</para>
  <para style="q2" vid="PSA 7:16">violensia nebee sira halo hanehan fali sira nia ulun.<verse eid="PSA 7:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17" />Hau sei foo agradese ba NAI Maromak tanba Nia sempre halo buat nebee loos;</para>
  <para style="q2" vid="PSA 7:17">hau sei hananu hahii NAI Maromak Aas Liu nia naran.<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="s">Nai Maromak iha lalehan foti aas ema kriatura</para>
  <para style="d">Salmu David nian, tuir muzika Gitit. Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1" />NAI Maromak, ami nia Nai,</para>
  <para style="q2" vid="PSA 8:1">Ita Boot nia naran furak teb-tebes iha mundu tomak!</para>
  <para style="b" vid="PSA 8:1" />
  <para style="q1" vid="PSA 8:1">Ita Boot nia naran aas liu lalehan;<verse eid="PSA 8:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 8:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:2 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:16">Mateus 21:16</ref>
      </char>
    </note>labarik ho kiikoan sira nebee sei susu hela hahii Ita Boot.</para>
  <para style="q1" vid="PSA 8:2">Ita Boot hatuur tiha ona Ita nia kbiit hodi hasoru Ita Boot nia inimigu sira,</para>
  <para style="q2" vid="PSA 8:2">halo funu baluk sira ho ema nebee mak rai odi sai nonook tiha.<verse eid="PSA 8:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3" />Hau hateke sae ba lalehan; lalehan nee Ita Boot nia liman fuan mak halo;</para>
  <para style="q2" vid="PSA 8:3">hau haree ba fulan ho fitun nebee mak Ita Boot hatuur tiha ona iha nia fatin.<verse eid="PSA 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:4 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 7:17">Job 7:17</ref>,<ref loc="JOB 7:18">18</ref>; <ref loc="PSA 144:3">Salmu 144:3</ref>; <ref loc="HEB 2:6-8">Ebreu 2:6-8</ref></char>
    </note>Ami ema kriatura see loos, too Ita Boot interese ami?</para>
  <para style="q2" vid="PSA 8:4">Ami ema kbiit-laek nee see loos, too Ita Boot tau matan mai ami?<verse eid="PSA 8:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5" />Ita Boot halo ami kiik liu uitoan anju sira;</para>
  <para style="q2" vid="PSA 8:5">Ita Boot foo fatin aas ba ami hodi foti aas ami nia naran.<verse eid="PSA 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:6 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 15:27">1 Korintu 15:27</ref>; <ref loc="EPH 1:22">Éfezu 1:22</ref>; <ref loc="HEB 2:8">Ebreu 2:8</ref></char>
    </note>Ita Boot foti ami ukun buat hotu-hotu nebee Ita Boot nia liman halo tiha ona;</para>
  <para style="q2" vid="PSA 8:6">Ita Boot halo buat hotu-hotu hakruuk mai ami:<verse eid="PSA 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7" />bibi ho karau sira hotu,</para>
  <para style="q2" vid="PSA 8:7">ho mos animal fuik sira,<verse eid="PSA 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8" />manu fuik iha lalehan,</para>
  <para style="q2" vid="PSA 8:8">ikan iha tasi laran</para>
  <para style="q2" vid="PSA 8:8">ho saida deit mak moris iha tasi laran.<verse eid="PSA 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9" />NAI Maromak, ami nia Nai,</para>
  <para style="q2" vid="PSA 8:9">Ita Boot nia naran furak teb-tebes iha mundu tomak!<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="s">Kantiku hahii Nai Maromak tanba Nia justisa</para>
  <para style="d">Salmu David nian, ba dirijenti koru. Tuir muzika “Oan mane mate.”<note caller="+" style="f"><char style="fr" closed="false">9:0 </char><char style="ft" closed="false">Liafuan Ebreu nee nia signifikadu la klaru.</char></note></para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1" />NAI Maromak, hau sei agradese ba Ita Boot ho hau nia laran tomak;</para>
  <para style="q2" vid="PSA 9:1">hau sei hatete sai buat furak hotu nebee Ita Boot halo.<verse eid="PSA 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2" />Hau sei kontenti ho haksolok tanba Ita Boot nia diak;</para>
  <para style="q2" vid="PSA 9:2">Maromak Aas Liu, hau sei hananu hahii Ita Boot nia naran.<verse eid="PSA 9:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3" />Hau nia inimigu sira hakiduk tiha ona;</para>
  <para style="q2" vid="PSA 9:3">sira sidi monu, sira mate iha Ita Boot nia oin.<verse eid="PSA 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4" />Tanba Ita Boot tuur iha kadeira ukun nudar Juis nebee loos,</para>
  <para style="q2" vid="PSA 9:4">Ita Boot defende hau hodi foo justisa lo-loos mai hau.<verse eid="PSA 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5" />Ita Boot siak ona nasaun jentiu sira;</para>
  <para style="q2" vid="PSA 9:5">Ita Boot halo rahun ona ema aat sira;</para>
  <para style="q2" vid="PSA 9:5">Ita Boot halakon tiha ona sira nia naran too tinan ba tinan.<verse eid="PSA 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6" />Hau nia inimigu sira mate mohu ona, sira hanesan uma nebee rahun tiha ona.</para>
  <para style="q2" vid="PSA 9:6">Ita Boot fokit sai tiha sira nia sidade hotu;</para>
  <para style="q2" vid="PSA 9:6">ema nunka atu hanoin tan sira tinan ba tinan.<verse eid="PSA 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7" />Maibee NAI Maromak ukun tinan ba tinan;</para>
  <para style="q2" vid="PSA 9:7">Nia hametin tiha ona Nia kadeira ukun para tesi lia.<verse eid="PSA 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8" />Nia ukun mundu ho justisa;</para>
  <para style="q2" vid="PSA 9:8">Nia tesi lia ba ema hotu ho lo-loos.<verse eid="PSA 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9" />NAI nee abrigu ba ema kbiit-laek sira;</para>
  <para style="q2" vid="PSA 9:9">Nia sai sira nia abrigu iha tempu susar.<verse eid="PSA 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10" />NAI, ema nebee konhese Ita Boot konfia Ita Boot,</para>
  <para style="q2" vid="PSA 9:10">tanba Ita Boot nunka husik ema nebee mak harohan ba Ita Boot.<verse eid="PSA 9:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11" />Hananu hahii NAI Maromak ba, Nia ukun iha Siaun;<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">Iha nee “Siaun” hatudu ba sidade Jerusalém.</char></note></para>
  <para style="q2" vid="PSA 9:11">foo sai ba nasaun jentiu sira kona ba buat nebee Nia halo tiha ona.<verse eid="PSA 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12" />Tanba Maromak buka tuir ema oho door;</para>
  <para style="q2" vid="PSA 9:12">Nia sempre hanoin ema kbiit-laek sira;</para>
  <para style="q2" vid="PSA 9:12">Nia la haluha sira nia halerik.<verse eid="PSA 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13" />NAI Maromak, haree ba, hau nia inimigu sira hanehan hau!</para>
  <para style="q2" vid="PSA 9:13">Hanoin hau ba, hasees tiha hau husi odamatan mate nian,<verse eid="PSA 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14" />atu hau bele baa tuur iha odamatan sidade Jerusalém nian<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">Lian Ebreu dehan “Oan feto Siaun”. Nee hatudu ba sidade Jerusalém.</char></note></para>
  <para style="q2" vid="PSA 9:14">hodi konta sai Ita Boot nia diak</para>
  <para style="q2" vid="PSA 9:14">no haksolok tanba Ita Boot salva tiha ona hau.<verse eid="PSA 9:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15" />Nasaun jentiu sira monu tiha ona ba rai kuak nebee sira rasik mak kee;</para>
  <para style="q2" vid="PSA 9:15">sira nia ain belit tiha ona iha lasu nebee sira rasik mak monta subar.<verse eid="PSA 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16" />Bainhira NAI Maromak foo justisa, Nia hatudu sai Nia Aan;</para>
  <para style="q2" vid="PSA 9:16">ema aat sira nia hahalok rasik sai lasu hodi halo sira monu.<verse eid="PSA 9:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17" />Ema aat sira tuun dadauk ba ema mate sira nia fatin;</para>
  <para style="q2" vid="PSA 9:17">nasaun hotu-hotu nebee mak haluha Maromak sei sai nunee.<verse eid="PSA 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18" />Maibee Maromak sei la haluha ema kiak sira;</para>
  <para style="q2" vid="PSA 9:18">ema kbiit-laek sira nia esperansa sei la mohu.<verse eid="PSA 9:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19" />NAI Maromak, hamriik ba! Keta husik ema kriatura mak manaan fali Ita Boot;</para>
  <para style="q2" vid="PSA 9:19">haruka nasaun jentiu sira hotu hataan iha Ita Boot nia oin.<verse eid="PSA 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20" />NAI, hatauk sira ba;</para>
  <para style="q2" vid="PSA 9:20">nasaun sira nee tenki hatene katak sira ema kriatura deit.<verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="s">Orasaun husu justisa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1" />NAI Maromak, tansaa mak Ita Boot hamriik dook nunee?</para>
  <para style="q2" vid="PSA 10:1">Tansaa mak Ita Boot subar Aan bainhira ami iha susar laran?<verse eid="PSA 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2" />Ema aat sira foti aan hodi hanehan ema kbiit-laek sira;</para>
  <para style="q2" vid="PSA 10:2">husik sira monu ba lasu nebee mak sira rasik halo tiha ona.<verse eid="PSA 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3" />Ema aat sira gaba aan kona ba saida mak sira nia laran kaan;</para>
  <para style="q2" vid="PSA 10:3">ema nebee matan naklosu ba sasaan hatete aat NAI Maromak hodi hatuun Nia naran.<verse eid="PSA 10:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4" />Ema aat sira nee foti aan dehan Maromak sei la husu tuir sira;</para>
  <para style="q2" vid="PSA 10:4">iha sira nia neon tomak la iha fatin ba Maromak.<verse eid="PSA 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5" />Sira nia moris diak hela deit;</para>
  <para style="q2" vid="PSA 10:5">sira la interese Maromak nia lei;<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="ft" closed="false">Lian Ebreu iha nee la klaru. Bele mos signifika, “Ita Boot nia justisa aas liu, sira la haree.”</char></note></para>
  <para style="q2" vid="PSA 10:5">sira sempre hamoe sira nia inimigu.<verse eid="PSA 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6" />Sira hatete ba sira nia aan, “La iha buat ida mak atu doko hau;</para>
  <para style="q2" vid="PSA 10:6">susar nunka atu kona hau.”<verse eid="PSA 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:7 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:14">Roma 3:14</ref>
      </char>
    </note>Sira nia ibun nakonu ho hotar, lia bosok ho ameasa;</para>
  <para style="q2" vid="PSA 10:7">sira kaan koalia liafuan nebee halo susar ema no halo aat ema.<verse eid="PSA 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8" />Sira subar nonook besik aldeia;</para>
  <para style="q2" vid="PSA 10:8">husi sira nia subar fatin sira oho ema nebee la hatene buat ida.</para>
  <para style="q1" vid="PSA 10:8">Sira hafuhu ema nebee sira atu oho;<verse eid="PSA 10:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 10:9" />sira hein hanesan liaun nebee helik iha ai huun.</para>
  <para style="q1" vid="PSA 10:9">Sira hein atu kaer ema kbiit-laek;</para>
  <para style="q2" vid="PSA 10:9">sira kaer ema kbiit-laek sira nee ho lasu hodi dada sai.<verse eid="PSA 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10" />Ho sira nia forsa sira hamonu tiha vitima sira nee</para>
  <para style="q2" vid="PSA 10:10">hodi sama hanehan ba rai.<verse eid="PSA 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11" />Sira hatete ba sira nia aan, “Maromak sei la nota ida;</para>
  <para style="q2" vid="PSA 10:11">Nia taka tiha ona Nia matan, Nia la haree saida mak hau halo.”<verse eid="PSA 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12" />NAI Maromak, hamriik ba! Maromak, foti Ita Boot nia liman hasoru sira;</para>
  <para style="q2" vid="PSA 10:12">keta haluha ema kbiit-laek sira.<verse eid="PSA 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13" />Tansaa mak ema aat sira hatete aat Maromak?</para>
  <para style="q2" vid="PSA 10:13">Tansaa mak sira dehan ba sira nia aan, “Nia sei la kastigu hau”?<verse eid="PSA 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14" />Maibee Ita Boot nia matan haree duni ema nebee iha terus ho susar laran;</para>
  <para style="q2" vid="PSA 10:14">Ita Boot nia liman sempre prontu hodi tulun sira.</para>
  <para style="q1" vid="PSA 10:14">Vitima sira nee oferese sira nia aan ba Ita Boot;</para>
  <para style="q2" vid="PSA 10:14">Ita Boot mak ajudador ba oan kiak sira.<verse eid="PSA 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15" />Silu tohar tiha ema aat sira nia liman ba;</para>
  <para style="q2" vid="PSA 10:15">eziji sira para hataan hotu hahalok aat nebee sira halo tiha ona.<verse eid="PSA 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16" />NAI Maromak nee Liurai tinan ba tinan;</para>
  <para style="q2" vid="PSA 10:16">nasaun jentiu sira sei lakon mohu husi Nia rain.<verse eid="PSA 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17" />NAI, Ita Boot rona ema mukit sira nia hakarak;</para>
  <para style="q2" vid="PSA 10:17">Ita Boot hametin sira nia laran hodi see tilun ba sira nia halerik.<verse eid="PSA 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18" />Ita Boot defende oan kiak sira ho vitima sira nebee ema hanehan,</para>
  <para style="q2" vid="PSA 10:18">atu nunee ema iha mundu la bele halo teror tan.<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="s">Laran metin ba NAI Maromak iha susar laran</para>
  <para style="d">Salmu David nian, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1" />NAI Maromak mak hau nia mahon.</para>
  <para style="q2" vid="PSA 11:1">Nusaa mak imi dehan fali mai hau,</para>
  <para style="q2" vid="PSA 11:1">“Salva o nia aan hanesan manu fuik nebee mak semo ba foho.<verse eid="PSA 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2" />O haree ka lae, ema aat sira prepara hela sira nia rama;</para>
  <para style="q2" vid="PSA 11:2">sira tau hela rama oan ba rama inan;</para>
  <para style="q2" vid="PSA 11:2">sira hein iha fatin nakukun atu hana ema diak sira.<verse eid="PSA 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3" />Bainhira lei nia huun rahun tiha ona,</para>
  <para style="q2" vid="PSA 11:3">ema nebee moris loos atu halo saida tan?”<verse eid="PSA 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4" />NAI Maromak iha hela Nia uma santu;</para>
  <para style="q2" vid="PSA 11:4">NAI tuur hela iha Nia kadeira ukun iha lalehan.</para>
  <para style="q1" vid="PSA 11:4">Nia matan haree tu-tuir ema hotu-hotu iha mundu</para>
  <para style="q2" vid="PSA 11:4">hodi koko sira.<verse eid="PSA 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5" />Ema nebee moris loos ho mos ema aat sira, NAI koko hotu;</para>
  <para style="q2" vid="PSA 11:5">ema nebee gosta violensia, Maromak hakribi.<verse eid="PSA 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6" />Nia sei fakar tuun ahi klaak ho fatuk lakan ba ema aat sira;</para>
  <para style="q2" vid="PSA 11:6">Nia sei haruka anin manas hodi halo terus sira.<verse eid="PSA 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7" />NAI sempre halo buat nebee loos;</para>
  <para style="q2" vid="PSA 11:7">Nia gosta hahalok nebee loos;</para>
  <para style="q2" vid="PSA 11:7">ema diak sei haree Nia oin.<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="s">Orasaun bainhira iha ema aat sira nia klaran</para>
  <para style="d">Salmu David nian, ba dirijenti koru. Akompanha ho viola tali walu.<note caller="+" style="f"><char style="fr" closed="false">12:0 </char><char style="ft" closed="false">Orijinal laduun klaru, karik instrumentu muzika ida ho tali walu, bele mos termu muzika ida seluk.</char></note></para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1" />NAI Maromak, salva ami ba! Tanba ema nebee moris loos la iha tan ona;</para>
  <para style="q2" vid="PSA 12:1">ema nebee foo laran ba Ita Boot, sira lakon mohu tiha ona husi mundu nee.<verse eid="PSA 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2" />Hela deit ema nebee gosta lohi sira nia maluk;</para>
  <para style="q2" vid="PSA 12:2">sira nia ibun kos-kose ema;</para>
  <para style="q2" vid="PSA 12:2">sira nia laran nakonu ho buat bosok.<verse eid="PSA 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3" />Hau harohan atu NAI Maromak taka tiha ibun nebee kos-kose ema,</para>
  <para style="q2" vid="PSA 12:3">hapara tiha nanaal nebee nakonu ho gaba aan.<verse eid="PSA 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4" />Ema sira nee dehan, “Hodi ami nia liafuan, ami sei manaan;</para>
  <para style="q2" vid="PSA 12:4">saida mak ami hakarak koalia, ami koalia deit; see mak atu manda tan ami?”<verse eid="PSA 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5" />NAI Maromak dehan, “Sira hanehan ema kiak;</para>
  <para style="q2" vid="PSA 12:5">sira halo ema kbiit-laek halerik.</para>
  <para style="q1" vid="PSA 12:5">Nunee Hau sei hamriik;</para>
  <para style="q2" vid="PSA 12:5">Hau sei hatuur ema kbiit-laek sira iha fatin seguru nebee durante nee sira hein hela.”<verse eid="PSA 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6" />NAI nia promesa perfeitu hotu,</para>
  <para style="q2" vid="PSA 12:6">hanesan osan mutin nebee hamoos dala hitu ona iha ahi.<verse eid="PSA 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7" />NAI Maromak, Ita Boot sei kuidadu ema kbiit-laek sira;</para>
  <para style="q2" vid="PSA 12:7">Ita Boot sei hamahon ami husi ema aat sira tinan ba tinan.<verse eid="PSA 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8" />Ema hotu-hotu iha mundu gaba hahalok aat,</para>
  <para style="q2" vid="PSA 12:8">too ema aat sira lao livre iha fat-fatin.<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="s">Halerik husu tulun ba Nai Maromak</para>
  <para style="d">Salmu David nian, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1" />NAI Maromak, Ita Boot atu haluha hau too bainhira? Too tinan ba tinan ka?</para>
  <para style="q2" vid="PSA 13:1">Ita Boot atu subar oin husi hau too bainhira?<verse eid="PSA 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2" />Too bainhira mak hau nia laran tenki susar nunee;</para>
  <para style="q2" vid="PSA 13:2">hau nia fuan loron-kalan taridu hela deit?</para>
  <para style="q2" vid="PSA 13:2">Too bainhira mak hau nia inimigu sira manaan hela deit?<verse eid="PSA 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3" />NAI, hau nia Maromak, hateke mai hau, no hataan hau ba;</para>
  <para style="q2" vid="PSA 13:3">foo iis foun mai hau.</para>
  <para style="q1" vid="PSA 13:3">Se lae hau mate,<verse eid="PSA 13:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 13:4" />depois hau nia inimigu dehan, nia manaan tiha ona;</para>
  <para style="q1" vid="PSA 13:4">haree hau monu nunee,</para>
  <para style="q2" vid="PSA 13:4">hau nia funu baluk haklalak.<verse eid="PSA 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5" />Maibee hau konfia Ita Boot nia domin rohan-laek;</para>
  <para style="q2" vid="PSA 13:5">hau nia laran haksolok tanba Ita Boot sei salva hau.<verse eid="PSA 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6" />Hau sei hananu ba NAI Maromak</para>
  <para style="q2" vid="PSA 13:6">tanba Nia halo tiha ona buat diak mai hau.<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="s">Halerik tanba ema nia hahalok aat</para>
  <para style="d">Salmu David nian, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">14:1 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:10-12">Roma 3:10-12</ref>
      </char>
    </note>Ema beik sira koalia iha sira nia laran dehan,</para>
  <para style="q2" vid="PSA 14:1">“Maromak la iha!”</para>
  <para style="q1" vid="PSA 14:1">Ema sira nee mesak aat deit; sira nia hahalok aat teb-tebes;</para>
  <para style="q2" vid="PSA 14:1">la iha ema ida mak halo buat diak.<verse eid="PSA 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2" />NAI Maromak hateke tuun husi lalehan mai ita ema</para>
  <para style="q2" vid="PSA 14:2">hodi haree iha ema balu matenek ka lae,</para>
  <para style="q2" vid="PSA 14:2">ema balu harohan ba Maromak ka lae.<verse eid="PSA 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3" />Maibee ema hotu lao sala dalan ona, sira hotu sai aat tiha ona;</para>
  <para style="q2" vid="PSA 14:3">la iha ema ida mak halo buat diak;</para>
  <para style="q2" vid="PSA 14:3">ida mos la iha.<verse eid="PSA 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4" />Ema aat sira nee la hatene buat ida ka?</para>
  <para style="q2" vid="PSA 14:4">Sira haan matak hau nia povu hanesan fali sira haan halimar paun fuan ida;</para>
  <para style="q2" vid="PSA 14:4">sira nunka bolu NAI Maromak nia naran.<verse eid="PSA 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5" />Maibee haree ba, ema sira nee sei tauk teb-tebes,</para>
  <para style="q2" vid="PSA 14:5">tanba Maromak hamutuk ho ema nebee moris loos.<verse eid="PSA 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6" />Imi ema aat sira hamnasa fali ema kbiit-laek sira nia planu,</para>
  <para style="q2" vid="PSA 14:6">maibee NAI Maromak foo mahon ba kbiit-laek sira nee.<verse eid="PSA 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7" />Hau harohan atu Maromak hamriik iha foho Siaun hodi salva Israel.</para>
  <para style="q2" vid="PSA 14:7">Bainhira NAI Maromak hadia fali Nia povu nia moris,</para>
  <para style="q2" vid="PSA 14:7">Jacó nia jerasaun sei haksolok, Israel sei kontenti.<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="s">See mak bele adora Nai Maromak</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1" />NAI Maromak, see mak bele tama ba iha Ita Boot nia uma kreda?</para>
  <para style="q2" vid="PSA 15:1">See mak bele sae ba iha Ita Boot nia foho santu?<verse eid="PSA 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2" />Ema nebee lao iha dalan loos,</para>
  <para style="q2" vid="PSA 15:2">no halo buat nebee loos;</para>
  <para style="q3" vid="PSA 15:2">nia koalia lia loos husi nia laran.<verse eid="PSA 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3" />Nia la hatete aat ema,</para>
  <para style="q2" vid="PSA 15:3">no la halo buat aat hasoru nia maluk;</para>
  <para style="q3" vid="PSA 15:3">nia la hatuun ema seluk.<verse eid="PSA 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4" />Nia hakribi ema aat,</para>
  <para style="q2" vid="PSA 15:4">maibee respeita ema nebee hamtauk NAI Maromak;</para>
  <para style="q3" vid="PSA 15:4">nia kaer metin nia promesa maski todan ba nia.<verse eid="PSA 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5" />Nia foo empresta osan ba ema kiak,</para>
  <para style="q2" vid="PSA 15:5">la husu funan.</para>
  <para style="q1" vid="PSA 15:5">Nia lakohi simu ema nia osan para foo sasin falsu</para>
  <para style="q2" vid="PSA 15:5">kontra ema nebee la sala.</para>
  <para style="b" vid="PSA 15:5" />
  <para style="q1" vid="PSA 15:5">See deit mak halo buat sira nee</para>
  <para style="q2" vid="PSA 15:5">nunka atu nakdoko.<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="s">Haksolok tanba Nai Maromak nia diak</para>
  <para style="d">Salmu<note caller="+" style="f"><char style="fr" closed="false">16:0 </char><char style="ft" closed="false">Lian Ebreu dehan, “<char style="it">Miktam</char>”. Liafuan nee nia signifikadu la klaru.</char></note> David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1" />Maromak, kuidadu hau ba,</para>
  <para style="q2" vid="PSA 16:1">tanba hau hamahon aan iha Ita Boot.<verse eid="PSA 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2" />NAI Maromak, hau hatete ba Ita Boot dehan, “Ita Boot mak hau nia Nai;</para>
  <para style="q2" vid="PSA 16:2">buat diak hotu-hotu nebee hau iha mai husi Ita Boot.”<verse eid="PSA 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3" />Maromak nia povu santu iha rai nee furak teb-tebes;</para>
  <para style="q2" vid="PSA 16:3">hau kontenti liu ho sira.<verse eid="PSA 16:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4" />Ema nebee halai ba maromak sel-seluk sei susar ba beibeik.</para>
  <para style="q2" vid="PSA 16:4">Hau sei la foo oferta raan nian ba maromak sira nee;</para>
  <para style="q2" vid="PSA 16:4">hau nia ibun sei la temi sira nia naran.<verse eid="PSA 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5" />NAI Maromak, hau nia riku-soin mak Ita Boot;</para>
  <para style="q2" vid="PSA 16:5">Ita Boot foo bensaun mai hau;</para>
  <para style="q2" vid="PSA 16:5">hau nia destinu iha Ita Boot nia liman laran.<verse eid="PSA 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6" />Fatin nebee Ita Boot foo mai hau furak;</para>
  <para style="q2" vid="PSA 16:6">riku-soin nebee Ita Boot foo mai hau kapaas teb-tebes.<verse eid="PSA 16:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7" />Hau sei hahii NAI Maromak, tanba Nia hatudu dalan mai hau;</para>
  <para style="q2" vid="PSA 16:7">iha oras kalan mos hau nia konsiensia hanorin hau.<verse eid="PSA 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8" />Hau nia matan sempre hateke ba NAI;</para>
  <para style="q2" vid="PSA 16:8">Nia iha hela hau nia sorin, nunee la iha buat ida mak bele halo hau nakdoko.<verse eid="PSA 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9" />Nee mak hau nia laran haksolok, hau nia fuan kontenti;</para>
  <para style="q2" vid="PSA 16:9">hau nia isin mos hakmatek hela.<verse eid="PSA 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:10 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 13:35">Apostolu sira nia Istoria 13:35</ref>
      </char>
    </note>Tanba Ita Boot sei la husik hau iha ema mate sira nia fatin;</para>
  <para style="q2" vid="PSA 16:10">ema ida nebee moris loos, Ita Boot la husik nia isin dodok iha rate laran.<verse eid="PSA 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:11 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 2:25-28">Apostolu sira nia Istoria 2:25-28</ref>
      </char>
    </note>Ita Boot hatudu ona dalan moris mai hau;</para>
  <para style="q2" vid="PSA 16:11">Ita Boot sei halo hau nia laran haksolok teb-tebes iha Ita Boot nia oin;</para>
  <para style="q2" vid="PSA 16:11">hau kontenti tinan ba tinan iha Ita Boot nia liman loos.<verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="s">Ema laran moos halerik husu justisa</para>
  <para style="d">Orasaun David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1" />NAI Maromak, hau husu justisa, rona hau ba;</para>
  <para style="q2" vid="PSA 17:1">foo atensaun ba hau nia halerik.</para>
  <para style="q1" vid="PSA 17:1">See tilun ba hau nia orasaun</para>
  <para style="q2" vid="PSA 17:1">tanba hau nia ibun la bosok ida.<verse eid="PSA 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2" />Ita Boot sei deklara sai katak hau la sala,</para>
  <para style="q2" vid="PSA 17:2">tanba Ita Boot hatene saida mak loos.<verse eid="PSA 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3" />Ita Boot hatene mo-moos hau nia laran;</para>
  <para style="q2" vid="PSA 17:3">iha kalan Ita Boot mai investiga hau.</para>
  <para style="q1" vid="PSA 17:3">Ita Boot koko tiha ona hau maibee la hetan buat aat ida iha hau;</para>
  <para style="q2" vid="PSA 17:3">hau nia ibun sempre koalia buat nebee loos.<verse eid="PSA 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4" />Hau la halo tuir ema aat nia hahalok;</para>
  <para style="q2" vid="PSA 17:4">hau hadook aan husi dalan violensia nian,</para>
  <para style="q2" vid="PSA 17:4">tanba hau kaer metin Ita Boot nia ukun fuan.<verse eid="PSA 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5" />Hau sempre lao tuir Ita Boot nia dalan;</para>
  <para style="q2" vid="PSA 17:5">hau nia ain la sidi ida.<verse eid="PSA 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6" />Maromak, hau harohan ba Ita Boot, tanba Ita Boot sei hataan hau;</para>
  <para style="q2" vid="PSA 17:6">see tilun hodi rona hau nia lian.<verse eid="PSA 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7" />Hatudu Ita Boot nia domin rohan-laek mai hau.</para>
  <para style="q2" vid="PSA 17:7">Ita Boot mak salva ema nebee buka mahon iha Ita Boot;</para>
  <para style="q1" vid="PSA 17:7">Bainhira sira iha Ita Boot nia liman loos,</para>
  <para style="q2" vid="PSA 17:7">sira nia inimigu la bele halo buat ida.<verse eid="PSA 17:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8" />Proteje hau hanesan Ita Boot kuidadu Ita Boot nia matan fuan;</para>
  <para style="q2" vid="PSA 17:8">subar hau iha Ita Boot nia liras okos<verse eid="PSA 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9" />atu ema aat la bele ataka hau;</para>
  <para style="q2" vid="PSA 17:9">atu inimigu sira nebee haleu hau la bele oho hau.<verse eid="PSA 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10" />Ema sira nee fuan toos;</para>
  <para style="q2" vid="PSA 17:10">sira koalia gaba aan.<verse eid="PSA 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11" />Agora sira lao toman ona hau hodi haleu hau,</para>
  <para style="q2" vid="PSA 17:11">sira nia matan lakan atu soe tuun hau ba iha rai.<verse eid="PSA 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12" />Sira hanesan liaun nebee mak hakarak atu lees hau;</para>
  <para style="q2" vid="PSA 17:12">sira hanesan liaun siak nebee mak hafuhu hela atu ataka hau.<verse eid="PSA 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13" />NAI Maromak, hamriik hasoru sira ba, hamonu sira ba;</para>
  <para style="q2" vid="PSA 17:13">ho Ita Boot nia surik salva hau husi ema aat sira nee.<verse eid="PSA 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14" />NAI, hodi Ita Boot nia liman salva hau husi sira,</para>
  <para style="q2" vid="PSA 17:14">husi ema sira nebee mak hetan diak deit iha mundu nee.</para>
  <para style="q1" vid="PSA 17:14">Hau harohan atu buat nebee Ita Boot rai ba ema aat sira bele enxe sira nia kabun halo nakonu,</para>
  <para style="q2" vid="PSA 17:14">too sira nia oan sira bosu di-diak;</para>
  <para style="q2" vid="PSA 17:14">sira nia oan nurak sira mos hetan hotu.<verse eid="PSA 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15" />Maibee hau nia matan sei haree Ita Boot,</para>
  <para style="q2" vid="PSA 17:15">tanba hau moris loos;</para>
  <para style="q1" vid="PSA 17:15">bainhira hau hadeer fali,</para>
  <para style="q2" vid="PSA 17:15">hau sei haksolok haree Ita Boot nia ilas.<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="s">Liurai David agradese ba Nai Maromak tanba halakon nia inimigu</para>
  <para style="d">Salmu husi NAI Maromak nia atan David, ba dirijenti koru. Salmu nee nia kanta ba NAI Maromak bainhira NAI Maromak hasai nia husi Saul nia liman laran ho mos husi nia inimigu sira. David kanta nunee.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1" />NAI Maromak, hau hadomi Ita Boot;</para>
  <para style="q2" vid="PSA 18:1">Ita Boot mak hau nia forsa.<verse eid="PSA 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2" />NAI mak fatuk kuak boot nebee hau subar iha laran;</para>
  <para style="q2" vid="PSA 18:2">Nia mak lutu haleu hau;</para>
  <para style="q2" vid="PSA 18:2">Nia hau nia Salvador.</para>
  <para style="b" vid="PSA 18:2" />
  <para style="q1" vid="PSA 18:2">Nia mak hau nia Maromak;</para>
  <para style="q2" vid="PSA 18:2">Nia mak fatuk kuak boot nebee hau subar iha laran.</para>
  <para style="q1" vid="PSA 18:2">Nia defende hau;</para>
  <para style="q2" vid="PSA 18:2">Nia kbiit salva hau;</para>
  <para style="q2" vid="PSA 18:2">Nia mak hau nia abrigu.<verse eid="PSA 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3" />Hahii NAI Maromak! Tanba hau temi Nia naran,</para>
  <para style="q2" vid="PSA 18:3">Nia salva hau husi hau nia inimigu sira.<verse eid="PSA 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4" />Uluk tali mate nian bobar tiha hau;</para>
  <para style="q2" vid="PSA 18:4">mota tuun makaas halo hau mout;<verse eid="PSA 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5" />korenti rate nian futu ona hau;</para>
  <para style="q2" vid="PSA 18:5">lasu mate nian iha hela hau nia oin.<verse eid="PSA 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6" />Iha susar laran hau temi NAI Maromak nia naran;</para>
  <para style="q2" vid="PSA 18:6">hau halerik husu tulun ba Maromak.</para>
  <para style="q1" vid="PSA 18:6">Husi Nia hela fatin, Nia rona hau nia lian;</para>
  <para style="q2" vid="PSA 18:6">hau nia lia halerik tama too iha Nia tilun.<verse eid="PSA 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7" />Depois rai nakdoko no nakdedar;</para>
  <para style="q2" vid="PSA 18:7">foho nia huun nakdoko no nakdedar hotu,</para>
  <para style="q2" vid="PSA 18:7">tanba Nia hirus.<verse eid="PSA 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8" />Suar sai husi Nia inus laran;</para>
  <para style="q2" vid="PSA 18:8">ahi lakan makaas sai husi Nia ibun laran;</para>
  <para style="q2" vid="PSA 18:8">ahi klaak lakan mean sai husi Nia ibun.<verse eid="PSA 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9" />Nia loke lalehan hodi tuun mai;</para>
  <para style="q2" vid="PSA 18:9">kalohan metan iha hela Nia ain okos.<verse eid="PSA 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10" />Nia manda anju tula Nia semo mai;</para>
  <para style="q2" vid="PSA 18:10">Nia haruka anin lori Nia mai lalais.<verse eid="PSA 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11" />Nia falun Aan ho nakukun;</para>
  <para style="q2" vid="PSA 18:11">Nia taka Aan ho kalohan metan.<verse eid="PSA 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12" />Iha Nia oin rai lakan fera kalohan metan nee,</para>
  <para style="q2" vid="PSA 18:12">jelu fatuk ho ahi lakan monu tuun.<verse eid="PSA 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13" />NAI Maromak nia lian tarutu husi lalehan;</para>
  <para style="q2" vid="PSA 18:13">Maromak Aas Liu nia lian sai mai.<verse eid="PSA 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14" />Nia hana Nia rama, inimigu sira halai namkari;</para>
  <para style="q2" vid="PSA 18:14">Nia haruka rai lakan boot duni lakon tiha sira.<verse eid="PSA 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15" />NAI, Ita Boot siak sira</para>
  <para style="q2" vid="PSA 18:15">hodi huu iis makaas sai husi inus.</para>
  <para style="q1" vid="PSA 18:15">Ho nunee Ita Boot halo tasi been sai maran tiha,</para>
  <para style="q2" vid="PSA 18:15">no kolu molik tiha mundu.<verse eid="PSA 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16" />Husi fatin aas nebaa, Maromak nia liman kaer metin hau;</para>
  <para style="q2" vid="PSA 18:16">Nia dada hau sai husi bee naruk nia laran.<verse eid="PSA 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17" />Nia salva hau husi hau nia inimigu nebee forti,</para>
  <para style="q2" vid="PSA 18:17">husi ema nebee odi hau no makaas liu hau.<verse eid="PSA 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18" />Iha dezastre laran sira ataka hau,</para>
  <para style="q2" vid="PSA 18:18">maibee NAI Maromak tane hau.<verse eid="PSA 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19" />Nia lori hau ba iha rai luan;</para>
  <para style="q2" vid="PSA 18:19">Nia salva hau tanba Nia haksolok ho hau.<verse eid="PSA 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20" />NAI haree hau diak tanba hau moris loos;</para>
  <para style="q2" vid="PSA 18:20">Nia halo diak mai hau tanba hau nia liman moos.<verse eid="PSA 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21" />Hau lao tuir nafatin NAI nia dalan;</para>
  <para style="q2" vid="PSA 18:21">hau nunka fila kotuk ba hau nia Maromak.<verse eid="PSA 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22" />Nia lei tomak sempre iha hau nia oin;</para>
  <para style="q2" vid="PSA 18:22">hau la lao sees husi Nia ukun fuan.<verse eid="PSA 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23" />Nia haree hau nia laran moos hela;</para>
  <para style="q2" vid="PSA 18:23">hau kuidadu hau nia aan atu la bele halo sala.<verse eid="PSA 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24" />NAI halo diak mai hau tanba hau moris loos,</para>
  <para style="q2" vid="PSA 18:24">Nia hatene hau nia liman moos.<verse eid="PSA 18:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25" />NAI Maromak, Ita Boot foo laran ba ema nebee foo laran ba Ita Boot;</para>
  <para style="q2" vid="PSA 18:25">Ita Boot hatudu laran diak ba ema nebee laran moos.<verse eid="PSA 18:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26" />Ita Boot sempre halo loos ba ema nebee moris loos,</para>
  <para style="q2" vid="PSA 18:26">maibee Ita Boot hatene oinsaa hasoru ema nebee halo manobra.<verse eid="PSA 18:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27" />Ita Boot salva ema kbiit-laek sira,</para>
  <para style="q2" vid="PSA 18:27">maibee hatuun ema nebee mak foti aan.<verse eid="PSA 18:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28" />NAI Maromak, Ita Boot mak halakan hau nia ahi oan:</para>
  <para style="q2" vid="PSA 18:28">Hau nia Maromak leno hau iha nakukun laran.<verse eid="PSA 18:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29" />Ho Ita Boot nia tulun</para>
  <para style="q2" vid="PSA 18:29">hau bele avansa hodi kontra tropas inimigu sira;</para>
  <para style="q1" vid="PSA 18:29">ho hau nia Maromak nia ajuda</para>
  <para style="q2" vid="PSA 18:29">hau bele haksoit liu sira nia moru aas hodi tama ba laran.<verse eid="PSA 18:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30" />NAI Maromak nee, Nia dalan perfeitu:</para>
  <para style="q2" vid="PSA 18:30">Nia liafuan sempre loos;</para>
  <para style="q2" vid="PSA 18:30">Nia defende ema nebee mak buka mahon iha Nia.<verse eid="PSA 18:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31" />So NAI deit mak Maromak, la iha tan seluk.</para>
  <para style="q2" vid="PSA 18:31">So ita nia Maromak deit mak fatuk lolon boot nebee hau helik ba.<verse eid="PSA 18:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32" />Maromak mak foo forsa mai hau;</para>
  <para style="q2" vid="PSA 18:32">Nia kuidadu hau iha dalan.<verse eid="PSA 18:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33" />
    <note caller="+" style="x">
      <char style="xo" closed="false">18:33 </char>
      <char style="xt" closed="false">
        <ref loc="HAB 3:19">Habakuk 3:19</ref>
      </char>
    </note>Nia halo hau nia ain hanesan rusa fuik nian;</para>
  <para style="q2" vid="PSA 18:33">Nia halo hau hamriik metin iha fatin aas.<verse eid="PSA 18:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34" />Nia treinu hau atu halo funu,</para>
  <para style="q2" vid="PSA 18:34">nunee hau bele uza rama diak nian hodi hana.<verse eid="PSA 18:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35" />NAI Maromak, Ita Boot defende hau hodi salva hau nia moris;</para>
  <para style="q2" vid="PSA 18:35">Ita Boot tane hau;</para>
  <para style="q2" vid="PSA 18:35">Ita Boot nia tulun halo hau sai ema boot.<verse eid="PSA 18:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36" />Ita Boot prepara dalan luan atu hau lao tuir,</para>
  <para style="q2" vid="PSA 18:36">ho nunee hau nia ain la sidi ba buat ida.<verse eid="PSA 18:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37" />Hau duni tuir hau nia inimigu sira too toman sira;</para>
  <para style="q2" vid="PSA 18:37">hau la hakiduk too sira mohu hotu.<verse eid="PSA 18:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38" />Hau halo rahun tiha sira too sira la bele hamriik tan;</para>
  <para style="q2" vid="PSA 18:38">sira monu iha hau nia ain okos.<verse eid="PSA 18:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39" />Ita Boot foo forsa mai hau atu halo funu;</para>
  <para style="q2" vid="PSA 18:39">Ita Boot halo ema nebee kontra hau hakruuk mai hau.<verse eid="PSA 18:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40" />Ita Boot halo hau nia inimigu sira halai rungu-ranga;</para>
  <para style="q2" vid="PSA 18:40">hau halo rahun tiha ema nebee odi hau.<verse eid="PSA 18:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41" />Sira tanis husu tulun, maibee la iha ema ida atu salva sira;</para>
  <para style="q2" vid="PSA 18:41">sira halerik husu tulun ba NAI Maromak, maibee Nia la hataan.<verse eid="PSA 18:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42" />Hau baku rahun sira hanesan rai rahun nebee anin lori;</para>
  <para style="q2" vid="PSA 18:42">hau sama sira hanesan ema sama tahu iha dalan.<verse eid="PSA 18:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43" />Ita Boot salva hau bainhira povu ataka hau;</para>
  <para style="q2" vid="PSA 18:43">Ita Boot halo hau sai nai ulun ba nasaun jentiu sira;</para>
  <para style="q2" vid="PSA 18:43">ema nebee uluk hau la konhese agora serbi hau.<verse eid="PSA 18:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44" />Ema rai liur foin rona hau nia lian, sira halo tuir kedas;</para>
  <para style="q2" vid="PSA 18:44">sira lao hakruuk too iha hau nia oin.<verse eid="PSA 18:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45" />Sira nia fuan lakon;</para>
  <para style="q2" vid="PSA 18:45">sira sai husi sira nia abrigu ho tauk no nakdedar.<verse eid="PSA 18:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46" />Hahii NAI Maromak! Maromak nee moris!</para>
  <para style="q2" vid="PSA 18:46">Nia mak fatuk lolon boot nebee hau helik ba.</para>
  <para style="q1" vid="PSA 18:46">Foti aas Nia naran!</para>
  <para style="q2" vid="PSA 18:46">Nia mak hau nia Salvador.<verse eid="PSA 18:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47" />Maromak mak selu fali buat nebee hau nia inimigu sira halo mai hau;</para>
  <para style="q2" vid="PSA 18:47">Nia hamonu nasaun jentiu sira iha hau nia okos;<verse eid="PSA 18:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48" />Maromak salva hau husi hau nia inimigu sira.</para>
  <para style="q2" vid="PSA 18:48">Tebes, Ita Boot foti hau aas liu hau nia funu baluk sira;</para>
  <para style="q2" vid="PSA 18:48">Ita Boot salva hau husi ema nebee gosta violensia.<verse eid="PSA 18:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49" />
    <note caller="+" style="x">
      <char style="xo" closed="false">18:49 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:9">Roma 15:9</ref>
      </char>
    </note>Tanba nee NAI Maromak, hau sei hahii Ita Boot iha nasaun hotu-hotu nia klaran;</para>
  <para style="q2" vid="PSA 18:49">hau sei hananu hahii Ita Boot nia naran.<verse eid="PSA 18:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50" />Maromak foo vitoria ba liurai nebee Nia hili hodi halo nia manaan liu dook;</para>
  <para style="q2" vid="PSA 18:50">Nia hatudu Nia laran luak ba liurai nebee mak Nia fihir,</para>
  <para style="q2" vid="PSA 18:50">ba David ho nia jerasaun nafatin ba nafatin.<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="s">Nai Maromak nia liman fatin ho Nia lei hatudu sai Nia furak</para>
  <para style="d">Salmu David nian, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1" />Lalehan konta sai Maromak nia kbiit boot</para>
  <para style="q2" vid="PSA 19:1">hodi deklara buat furak nebee Nia liman kria tiha ona.<verse eid="PSA 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2" />Loron hatoo lia menon ba loron;</para>
  <para style="q2" vid="PSA 19:2">kalan foo sai matenek ba kalan.<verse eid="PSA 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3" />Lalehan nee la koalia, la uza liafuan;</para>
  <para style="q2" vid="PSA 19:3">la iha lian ruma mak atu bele rona husi nebaa.<verse eid="PSA 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">19:4 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 10:18">Roma 10:18</ref>
      </char>
    </note>Maski nunee lalehan nia lian sai ba iha rai tomak;</para>
  <para style="q2" vid="PSA 19:4">nia liafuan too iha rai ulun rai ikun iha mundu tomak.</para>
  <para style="b" vid="PSA 19:4" />
  <para style="q1" vid="PSA 19:4">Iha lalehan Maromak harii hela tenda ba loro matan.<verse eid="PSA 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5" />Loro matan nee mosu mai hanesan noivu ida nebee hakat sai husi nia festa kazamentu;</para>
  <para style="q2" vid="PSA 19:5">nia lao hanesan mane forti ida nebee haksolok hodi halai tuir dalan.<verse eid="PSA 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6" />Loromatan lao tuir lalehan husi rohan ba rohan;</para>
  <para style="q2" vid="PSA 19:6">buat hotu-hotu senti loron nia manas.<verse eid="PSA 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7" />NAI Maromak nia lei perfeitu,</para>
  <para style="q2" vid="PSA 19:7">halo ita nia moris sai matak.</para>
  <para style="q1" vid="PSA 19:7">NAI nia mandamentu ita bele konfia,</para>
  <para style="q2" vid="PSA 19:7">halo ema matan tomak sai matenek.<verse eid="PSA 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8" />NAI nia regra loos,</para>
  <para style="q2" vid="PSA 19:8">halo haksolok ita nia laran.</para>
  <para style="q1" vid="PSA 19:8">NAI nia ukun fuan nabilan,</para>
  <para style="q2" vid="PSA 19:8">leno ita nia matan.<verse eid="PSA 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9" />Ita hamtauk ba NAI, nee diak,</para>
  <para style="q2" vid="PSA 19:9">dura tinan ba tinan.</para>
  <para style="q1" vid="PSA 19:9">NAI nia desizaun sempre loos,</para>
  <para style="q2" vid="PSA 19:9">justu ba ema hotu-hotu.<verse eid="PSA 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10" />Buat sira nee folin boot liu osan mean,</para>
  <para style="q2" vid="PSA 19:10">liu fali osan mean moos nian;</para>
  <para style="q1" vid="PSA 19:10">midar liu bani been,</para>
  <para style="q2" vid="PSA 19:10">liu fali bani been nebee husi nia knuuk.<verse eid="PSA 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11" />Buat sira nee hanorin Ita Boot nia atan;</para>
  <para style="q2" vid="PSA 19:11">see mak kaer metin, hetan bensaun boot.<verse eid="PSA 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12" />Maibee see mak bele hatene nia sala rasik?</para>
  <para style="q2" vid="PSA 19:12">Perdua hau nia sala nebee hau rasik la rekonhese.<verse eid="PSA 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13" />Kuidadu mos Ita Boot nia atan hau husi hahalok nebee hau rasik hatene katak nee sala;</para>
  <para style="q2" vid="PSA 19:13">keta husik sala hirak nee domina hau.</para>
  <para style="q1" vid="PSA 19:13">Nunee hau sei livre husi hahalok aat;</para>
  <para style="q2" vid="PSA 19:13">hau sei la halo sala hasoru Ita Boot.<verse eid="PSA 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14" />Hau harohan atu hau nia liafuan ho hau nia reflesaun</para>
  <para style="q2" vid="PSA 19:14">monu ba Ita Boot nia laran.</para>
  <para style="q1" vid="PSA 19:14">NAI Maromak, Ita Boot mak fatuk lolon boot nebee hau helik ba;</para>
  <para style="q2" vid="PSA 19:14">Ita Boot mak hau nia Salvador.<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="s">Orasaun atu liurai manaan funu</para>
  <para style="d">Salmu David nian, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1" />Hau harohan atu NAI Maromak hataan o nia orasaun bainhira o iha susar laran;</para>
  <para style="q2" vid="PSA 20:1">atu Jacó nia Maromak hamahon o.<verse eid="PSA 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2" />Hau harohan atu Nia haraik tulun ba o husi Nia fatin santu;</para>
  <para style="q2" vid="PSA 20:2">atu Nia foo suporta ba o husi foho Siaun.<verse eid="PSA 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3" />Hau harohan atu Nia konsidera o nia oferta hotu;</para>
  <para style="q2" vid="PSA 20:3">animal nebee o tunu hodi halo sakrifisiu mos monu ba Nia laran.<verse eid="PSA 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4" />Hau harohan atu Maromak foo buat nebee o nia laran hakarak,</para>
  <para style="q2" vid="PSA 20:4">no halo o nia planu hotu sai diak.<verse eid="PSA 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5" />Depois ita sei haklalak kontenti tanba o manaan;</para>
  <para style="q2" vid="PSA 20:5">ita sei foti sae ita nia bandeira hodi ita nia Maromak nia naran.</para>
  <para style="q1" vid="PSA 20:5">Hau harohan atu NAI Maromak foo hotu buat nebee o husu.<verse eid="PSA 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6" />Agora hau hatene katak,</para>
  <para style="q2" vid="PSA 20:6">NAI Maromak salva liurai nebee Nia hili ona;</para>
  <para style="q1" vid="PSA 20:6">husi Nia lalehan santu, Nia hataan liurai nia orasaun;</para>
  <para style="q2" vid="PSA 20:6">hodi Nia kbiit, Nia halo liurai manaan.<verse eid="PSA 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7" />Ema balu konfia nia kareta funu, balu konfia nia kuda,</para>
  <para style="q2" vid="PSA 20:7">maibee ami konfia ami nia NAI Maromak nia naran.<verse eid="PSA 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8" />Sira sei monu hakdasak,</para>
  <para style="q2" vid="PSA 20:8">maibee ami sei hadeer hodi tuba rai metin.<verse eid="PSA 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9" />NAI, halo liurai manaan ba;</para>
  <para style="q2" vid="PSA 20:9">bainhira ami harohan ba Ita Boot, hataan ami ba!<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="s">Kantiku hahii Nai Maromak tanba liurai manaan funu</para>
  <para style="d">Salmu David nian, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1" />NAI Maromak, liurai haksolok haree Ita Boot nia kbiit;</para>
  <para style="q2" vid="PSA 21:1">nia kontenti teb-tebes tanba Ita Boot halo nia manaan.<verse eid="PSA 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2" />Ita Boot foo buat nebee nia laran hakarak;</para>
  <para style="q2" vid="PSA 21:2">buat nebee nia ibun husu, Ita Boot hataan duni.<verse eid="PSA 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3" />Ita Boot simu liurai hodi foo bensaun boot ba nia;</para>
  <para style="q2" vid="PSA 21:3">Ita Boot tau koroa osan mean diak nian ba iha nia ulun.<verse eid="PSA 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4" />Nia husu Ita Boot atu foo vida naruk, Ita Boot foo;</para>
  <para style="q2" vid="PSA 21:4">Ita Boot halo nia moris nafatin ba nafatin.<verse eid="PSA 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5" />Ita Boot halo liurai manaan, nunee nia naran sai boot;</para>
  <para style="q2" vid="PSA 21:5">Ita Boot halo nia sai konhesidu, no ema respeita teb-tebes nia.<verse eid="PSA 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6" />Loos duni, Ita Boot foo bensaun ba nia la hotu la remata;</para>
  <para style="q2" vid="PSA 21:6">Ita Boot halo nia haksolok teb-tebes iha Ita Boot nia oin.<verse eid="PSA 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7" />Liurai konfia NAI Maromak;</para>
  <para style="q2" vid="PSA 21:7">Maromak Aas Liu nia domin rohan-laek</para>
  <para style="q2" vid="PSA 21:7">halo liurai la nakdoko.<verse eid="PSA 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8" />Liurai, o nia liman sei kaer o nia inimigu sira hotu;</para>
  <para style="q2" vid="PSA 21:8">o nia liman loos sei kaptura ema nebee odi o.<verse eid="PSA 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9" />Bainhira o mosu iha sira nia oin,</para>
  <para style="q2" vid="PSA 21:9">o sei soe sira ba iha ahi lakan boot.</para>
  <para style="q1" vid="PSA 21:9">NAI Maromak sei hirus hodi tolan tiha sira;</para>
  <para style="q2" vid="PSA 21:9">Nia ahi sei haan mutuk tiha sira.<verse eid="PSA 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10" />O sei halo rahun tiha sira nia jerasaun iha mundu;</para>
  <para style="q2" vid="PSA 21:10">sira nia bei-oan sei lakon mohu husi ema nia klaran.<verse eid="PSA 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11" />Maski o nia inimigu sira kombina malu hasoru o</para>
  <para style="q2" vid="PSA 21:11">hodi halo manobra oi-oin, sira sei la manaan.<verse eid="PSA 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12" />O hana sira ho o nia rama,</para>
  <para style="q2" vid="PSA 21:12">halo sira halai tiha.<verse eid="PSA 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13" />NAI Maromak, hodi Ita Boot nia forsa hamriik ba!</para>
  <para style="q2" vid="PSA 21:13">Ami sei hananu hodi hahii Ita Boot nia kbiit.<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="s">Harohan ba Nai Maromak iha susar laran</para>
  <para style="d">Salmu David nian, ba dirijenti koru. Tuir muzika Rusa Dadeer-saan.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:46">Mateus 27:46</ref>; <ref loc="MRK 15:34">Marcos 15:34</ref></char>
    </note>Hau nia Maromak, hau nia Maromak, tansaa mak Ita Boot husik hau mesak?</para>
  <para style="q2" vid="PSA 22:1">Hau halerik ho laran dodok para Ita Boot tulun hau;</para>
  <para style="q3" vid="PSA 22:1">tansaa mak Ita Boot dook loos husi hau?<verse eid="PSA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2" />Hau nia Maromak, loron hau halerik husu tulun, maibee Ita Boot la hataan;</para>
  <para style="q2" vid="PSA 22:2">hau halerik kalan, maibee la hetan pas.<verse eid="PSA 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3" />Ita Boot mak santu;</para>
  <para style="q2" vid="PSA 22:3">Ita Boot mak Liurai nebee ema Israel sira adora.<verse eid="PSA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4" />Ami nia bei-ala sira fiar Ita Boot;</para>
  <para style="q2" vid="PSA 22:4">sira fiar mak Ita Boot tulun sira.<verse eid="PSA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5" />Sira tanis hakilar ba Ita Boot mak Ita Boot salva sira;</para>
  <para style="q2" vid="PSA 22:5">sira fiar ba Ita Boot la saugati.<verse eid="PSA 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6" />Maibee hau hanesan ular oan deit, laos ema;</para>
  <para style="q2" vid="PSA 22:6">ema hotu hatete aat hau, no hakribi hau.<verse eid="PSA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7" />Ema hotu nebee haree hau hamoe hau;</para>
  <para style="q2" vid="PSA 22:7">sira dulas ibun mai hau hodi doko ulun.<verse eid="PSA 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8" />Sira dehan, “Nia fiar NAI Maromak;</para>
  <para style="q2" vid="PSA 22:8">husik Maromak mak salva nia.</para>
  <para style="q1" vid="PSA 22:8">Se Maromak kontenti ho nia,</para>
  <para style="q2" vid="PSA 22:8">entaun Maromak mak hasai nia ba.”<verse eid="PSA 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9" />Maibee Ita Boot mak lori hau sai husi hau nia inan nia kanotak;</para>
  <para style="q2" vid="PSA 22:9">Ita Boot hatoba hau iha hau nia inan nia hirus matan.<verse eid="PSA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10" />Husi kedas hau moris, hau nee Ita Boot nian;</para>
  <para style="q2" vid="PSA 22:10">dezde hau sei iha hau nia inan nia kabun laran, Ita Boot sai tiha ona hau nia Maromak.<verse eid="PSA 22:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11" />Keta dook husi hau,</para>
  <para style="q2" vid="PSA 22:11">tanba susar besik hela hau,</para>
  <para style="q3" vid="PSA 22:11">no ema atu tulun hau la iha.<verse eid="PSA 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12" />Karau aman barak haleu hau;</para>
  <para style="q2" vid="PSA 22:12">karau aman mesak forti deit mak serku hau.<verse eid="PSA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13" />Sira hanesan liaun nebee hakilar hodi lees ema;</para>
  <para style="q2" vid="PSA 22:13">sira loke sira nia ibun luan hodi kontra hau.<verse eid="PSA 22:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14" />Hau nia forsa hanesan bee nebee fakar sai ba rai;</para>
  <para style="q2" vid="PSA 22:14">hau nia ruin sira hotu naksalak tiha ona.</para>
  <para style="q1" vid="PSA 22:14">Hau nia fuan hanesan lilin</para>
  <para style="q2" vid="PSA 22:14">nebee nabeen tiha ona iha hau nia laran.<verse eid="PSA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15" />Hau nia ibun maran dekor hanesan sanan rai;</para>
  <para style="q2" vid="PSA 22:15">hau nia nanaal toos tiha ona iha hau nia ibun laran;</para>
  <para style="q2" vid="PSA 22:15">Ita Boot latan tiha ona hau iha rai rahun.<verse eid="PSA 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16" />Ema aat lubuk ida hobur hau;</para>
  <para style="q2" vid="PSA 22:16">sira serku hau hanesan asu;</para>
  <para style="q3" vid="PSA 22:16">sira sona borus hau nia liman ho ain.<note caller="+" style="f"><char style="fr" closed="false">22:16 </char><char style="ft" closed="false">Orijinal iha linha nee la klaru. </char></note><verse eid="PSA 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17" />Hau nia ruin tomak bele sura;</para>
  <para style="q2" vid="PSA 22:17">ema hateke mai hau no fihir hau.<verse eid="PSA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18" />Sira fahe hau nia hena ba malu;</para>
  <para style="q2" vid="PSA 22:18">sira dada rifa para hatene, hau nia hena nee monu ba see.<verse eid="PSA 22:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19" />Maibee NAI Maromak, Ita Boot keta dook husi hau.</para>
  <para style="q2" vid="PSA 22:19">Ita Boot mak hau nia forsa; mai lalais tulun hau.<verse eid="PSA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20" />Salva hau husi surik;</para>
  <para style="q2" vid="PSA 22:20">salva hau nia moris husi asu forti sira nee.<verse eid="PSA 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21" />Dada sai hau husi liaun nia ibun laran;</para>
  <para style="q2" vid="PSA 22:21">salva hau husi karau fuik nia dikur.<note caller="+" style="f"><char style="fr" closed="false">22:21 </char><char style="ft" closed="false">Orijinal iha linha nee la klaru.</char></note><verse eid="PSA 22:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22" />Hau sei koalia sai ba hau nia maluk sira kona ba Ita Boot nia diak;</para>
  <para style="q2" vid="PSA 22:22">iha povu nia leet hau sei hahii Ita Boot.<verse eid="PSA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23" />Imi sira nebee hamtauk NAI Maromak, hahii NAI ba!</para>
  <para style="q2" vid="PSA 22:23">Imi Jacó nia jerasaun, hotu-hotu foti aas NAI ba!</para>
  <para style="q2" vid="PSA 22:23">Imi Israel nia jerasaun, hotu-hotu respeita Nia ho tauk ba!<verse eid="PSA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24" />Tanba Nia la hakribi no la hatuun</para>
  <para style="q2" vid="PSA 22:24">ema nebee terus ho susar.</para>
  <para style="q1" vid="PSA 22:24">Nia la subar oin ba sira,</para>
  <para style="q2" vid="PSA 22:24">maibee see tilun ba sira bainhira sira halerik husu tulun.<verse eid="PSA 22:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25" />Hau sei hahii Ita Boot iha ema lubuk boot nia leet;</para>
  <para style="q2" vid="PSA 22:25">iha fiar nain sira nia oin hau sei foo oferta nebee hau promete tiha ona atu foo ba Ita Boot.<verse eid="PSA 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26" />Ema kiak sira sei haan too bosu;</para>
  <para style="q2" vid="PSA 22:26">ema nebee buka NAI Maromak sei hahii Nia.</para>
  <para style="q2" vid="PSA 22:26">Hau hein katak sira hetan moris diak too tinan ba tinan.<verse eid="PSA 22:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27" />Ema husi rai ulun too rai ikun iha mundu tomak</para>
  <para style="q2" vid="PSA 22:27">sei hanoin NAI Maromak hodi fila ba Nia;</para>
  <para style="q1" vid="PSA 22:27">ema husi suku hotu-hotu</para>
  <para style="q2" vid="PSA 22:27">sei hakneak hakruuk iha Nia oin.<verse eid="PSA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28" />Tanba NAI mak Ukun Nain;</para>
  <para style="q2" vid="PSA 22:28">Nia ukun nasaun hotu-hotu.<verse eid="PSA 22:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29" />Ema riku hotu-hotu iha mundu sei halo festa hodi adora Nia;</para>
  <para style="q2" vid="PSA 22:29">ema nebee atu tuun ba iha rai rahun, sira hotu sei hakneak iha Nia oin.<verse eid="PSA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30" />Ema nebee seidauk moris sei serbi Nia;</para>
  <para style="q2" vid="PSA 22:30">jerasaun sira aban-bainrua sei koalia kona ba Nai Maromak.<verse eid="PSA 22:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31" />Sira sei foo sai Nia salvasaun; <note caller="+" style="f"><char style="fr" closed="false">22:31 </char><char style="ft" closed="false">Liafuan Ebreu iha nee bele signifika “salvasaun”, bele mos “justisa”.</char></note></para>
  <para style="q2" vid="PSA 22:31">sira sei foo hatene ba ema sira nebee seidauk moris</para>
  <para style="q2" vid="PSA 22:31">katak Maromak salva tiha ona Nia povu.<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="s">Nai Maromak mak hau nia Bibi Atan</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1" />NAI Maromak mak hau nia Bibi Atan;</para>
  <para style="q2" vid="PSA 23:1">hau la falta buat ida.<verse eid="PSA 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">23:2 </char>
      <char style="xt" closed="false">
        <ref loc="REV 7:17">Apokalipse 7:17</ref>
      </char>
    </note>Nia halo hau toba iha duut matak;</para>
  <para style="q2" vid="PSA 23:2">Nia lori hau ba iha bee matan.<verse eid="PSA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3" />Nia hafoun fali hau nia laran;</para>
  <para style="q2" vid="PSA 23:3">Nia lori hau tuir dalan loos</para>
  <para style="q3" vid="PSA 23:3">atu ema foti aas Nia naran.<verse eid="PSA 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4" />Maski hau lao</para>
  <para style="q2" vid="PSA 23:4">iha fatin nebee nakukun teb-tebes,</para>
  <para style="q1" vid="PSA 23:4">hau la tauk buat ida</para>
  <para style="q2" vid="PSA 23:4">tanba Ita Boot hamutuk ho hau.</para>
  <para style="q1" vid="PSA 23:4">Ita Boot nia ai tonka ho rota</para>
  <para style="q2" vid="PSA 23:4">proteje hau hodi halo hau nia laran hakmatek.<verse eid="PSA 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5" />Ita Boot tau meza mai hau</para>
  <para style="q2" vid="PSA 23:5">iha hau nia inimigu sira oin;</para>
  <para style="q1" vid="PSA 23:5">Ita Boot simu hau hanesan bainaka boot ida,</para>
  <para style="q2" vid="PSA 23:5">no enxe hau nia kopu too nakonu.<verse eid="PSA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6" />Tebes duni, Ita Boot nia diak ho Ita Boot nia laran luak sei hamutuk ho hau</para>
  <para style="q2" vid="PSA 23:6">iha hau nia moris tomak;</para>
  <para style="q1" vid="PSA 23:6">hau sei hela iha NAI Maromak nia uma</para>
  <para style="q2" vid="PSA 23:6">nafatin ba nafatin.<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="s">Nai Maromak mak Liurai boot</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">24:1 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 10:26">1 Korintu 10:26</ref>
      </char>
    </note>Mundu ho buat hotu iha mundu nee, NAI Maromak nian;</para>
  <para style="q2" vid="PSA 24:1">rai ho buat hotu nebee moris iha rai nee, Ninian hotu.<verse eid="PSA 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2" />Tanba Nia mak harii buat hirak nee iha tasi leten;</para>
  <para style="q2" vid="PSA 24:2">Nia hatuur buat sira nee hotu iha bee leten.<verse eid="PSA 24:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3" />See mak bele sae ba NAI Maromak nia foho?</para>
  <para style="q2" vid="PSA 24:3">See mak bele hamriik iha Nia fatin santu?<verse eid="PSA 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">24:4 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:8">Mateus 5:8</ref>
      </char>
    </note>Ema nebee liman moos ho laran moos,</para>
  <para style="q2" vid="PSA 24:4">ema nebee la adora fatuk lulik ka ai lulik,</para>
  <para style="q2" vid="PSA 24:4">ema nebee la halo juramentu falsu.<verse eid="PSA 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5" />Ema sira nee sei simu bensaun husi NAI Maromak;</para>
  <para style="q2" vid="PSA 24:5">Maromak nudar sira nia Salvador sei deklara katak sira la sala.<verse eid="PSA 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6" />Ema hanesan nee mak harohan ba Maromak;</para>
  <para style="q2" vid="PSA 24:6">sira hakbesik aan ba Jacó nia Maromak.<verse eid="PSA 24:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7" />Imi portaun sira, foti sae imi nia ulun ba;</para>
  <para style="q2" vid="PSA 24:7">imi odamatan antigu nian, loke aan ba,</para>
  <para style="q2" vid="PSA 24:7">para Liurai kbiit boot bele tama mai.<verse eid="PSA 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8" />Liurai kbiit boot nee see?</para>
  <para style="q2" vid="PSA 24:8">Nia nee NAI Maromak, Nia forsa teb-tebes ho kbiit boot;</para>
  <para style="q2" vid="PSA 24:8">Nia nee NAI Maromak, funu nain boot.<verse eid="PSA 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9" />Imi portaun sira, foti sae imi nia ulun ba;</para>
  <para style="q2" vid="PSA 24:9">imi odamatan antigu nian, loke aan ba,</para>
  <para style="q2" vid="PSA 24:9">para Liurai kbiit boot bele tama mai.<verse eid="PSA 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10" />Liurai kbiit boot nee see?</para>
  <para style="q2" vid="PSA 24:10">NAI Maromak Aswain,</para>
  <para style="q2" vid="PSA 24:10">Nia mak Liurai kbiit boot.<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="s">Orasaun husu tulun ba Nai Maromak</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1" />NAI, hau nia Maromak,</para>
  <para style="q2" vid="PSA 25:1">hau konfia Ita Boot.<verse eid="PSA 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2" />Hau fiar Ita Boot;</para>
  <para style="q2" vid="PSA 25:2">keta husik hau moe leet;</para>
  <para style="q2" vid="PSA 25:2">keta husik hau nia inimigu sira mak manaan.<verse eid="PSA 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3" />Ema nebee laran metin ba Ita Boot,</para>
  <para style="q2" vid="PSA 25:3">sei la moe leet;</para>
  <para style="q1" vid="PSA 25:3">ema nebee traidor nar-naran deit,</para>
  <para style="q2" vid="PSA 25:3">nia mak moe.<verse eid="PSA 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4" />NAI Maromak, hatudu Ita Boot nia dalan mai hau;</para>
  <para style="q2" vid="PSA 25:4">hanorin hau atu lao tuir Ita Boot nia ain fatin.<verse eid="PSA 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5" />Tulun hau atu moris tuir Ita Boot nia lia loos, no hanorin hau,</para>
  <para style="q2" vid="PSA 25:5">tanba Ita Boot mak hau nia Salvador;</para>
  <para style="q2" vid="PSA 25:5">loron-kalan hau laran metin ba Ita Boot.<verse eid="PSA 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6" />NAI, hori uluk kedas Ita Boot hatudu ona Ita Boot nia laran luak ho domin rohan-laek;</para>
  <para style="q2" vid="PSA 25:6">hatudu nafatin ba.<verse eid="PSA 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7" />Keta hanoin tan pekadu nebee hau halo bainhira sei joven;</para>
  <para style="q2" vid="PSA 25:7">haluha tiha sala nebee hau halo kontra Ita Boot.</para>
  <para style="q1" vid="PSA 25:7">NAI, hanoin hau ba,</para>
  <para style="q2" vid="PSA 25:7">tanba Ita Boot nia domin ho Ita Boot nia diak.<verse eid="PSA 25:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8" />NAI Maromak nee laran diak no laran moos,</para>
  <para style="q2" vid="PSA 25:8">nunee mak Nia hanorin sala nain sira tuir Nia dalan.<verse eid="PSA 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9" />Nia tulun ema mukit sira atu halo buat nebee loos;</para>
  <para style="q2" vid="PSA 25:9">Nia hanorin sira kona ba Nia dalan.<verse eid="PSA 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10" />NAI nia dalan nakonu ho domin ho lia loos;</para>
  <para style="q2" vid="PSA 25:10">Nia hatudu dalan nee ba ema sira nebee kaer metin Nia promesa ho Nia lei.<verse eid="PSA 25:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11" />NAI Maromak, hau nia sala boot, perdua hau ba,</para>
  <para style="q2" vid="PSA 25:11">atu nunee ema foti aas Ita Boot nia naran.<verse eid="PSA 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12" />Ema nebee mak hamtauk NAI Maromak,</para>
  <para style="q2" vid="PSA 25:12">Maromak sei hanorin sira oinsaa atu moris.<verse eid="PSA 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13" />Sira sei moris diak;</para>
  <para style="q2" vid="PSA 25:13">sira nia jerasaun sei hela metin nafatin iha sira nia rain.<verse eid="PSA 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14" />NAI sai belun ba ema nebee hamtauk Nia;</para>
  <para style="q2" vid="PSA 25:14">Nia foo hatene Nia promesa ho Nia lei ba sira.<verse eid="PSA 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15" />Hau nia matan hateke metin ba NAI,</para>
  <para style="q2" vid="PSA 25:15">tanba so Nia deit mak sei hasai hau nia ain husi lasu laran.<verse eid="PSA 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16" />See oin mai hau hodi hanoin hau ba,</para>
  <para style="q2" vid="PSA 25:16">tanba hau mesak deit no kbiit-laek.<verse eid="PSA 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17" />Halo kamaan susar nebee iha hau nia laran;</para>
  <para style="q2" vid="PSA 25:17">hasai hau husi terus laran.<verse eid="PSA 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18" />Hateke ba hau nia naha todan ho hau nia laran taridu;</para>
  <para style="q2" vid="PSA 25:18">hamoos tiha hau nia sala hotu.<verse eid="PSA 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19" />Haree ba, hau nia inimigu barak teb-tebes;</para>
  <para style="q2" vid="PSA 25:19">sira odi loos hau!<verse eid="PSA 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20" />Kuidadu hau nia moris hodi salva hau;</para>
  <para style="q2" vid="PSA 25:20">keta husik ema hamoe hau,</para>
  <para style="q2" vid="PSA 25:20">tanba hau hamahon aan iha Ita Boot.<verse eid="PSA 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21" />NAI Maromak, hau hein katak hau nia hahalok loos ho laran moos bele proteje hau,</para>
  <para style="q2" vid="PSA 25:21">tanba hau laran metin iha Ita Boot.<verse eid="PSA 25:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22" />Maromak, salva Israel</para>
  <para style="q2" vid="PSA 25:22">husi susar laran ba!<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="s">Ema laran moos harohan husu justisa</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1" />NAI Maromak, foo justisa mai hau,</para>
  <para style="q2" vid="PSA 26:1">tanba hau ema nebee moris loos;</para>
  <para style="q2" vid="PSA 26:1">hau konfia NAI ho laran tomak.<verse eid="PSA 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2" />NAI, koko hau no prova hau ba;</para>
  <para style="q2" vid="PSA 26:2">tetu di-diak hau nia neon ho laran,<verse eid="PSA 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3" />tanba hau sempre hanoin hela deit Ita Boot nia domin rohan-laek,</para>
  <para style="q2" vid="PSA 26:3">no hau konfia Ita Boot tanba Ita Boot sempre kaer metin Ita Boot nia liafuan.<verse eid="PSA 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4" />Hau la tuur hamutuk ho ema lohi door;</para>
  <para style="q2" vid="PSA 26:4">hau mos la ranxu ema nebee koalia oin ida hahalok oin seluk.<verse eid="PSA 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5" />Hau haree ema aat sira halibur hamutuk, hau hakribi;</para>
  <para style="q2" vid="PSA 26:5">hau lakohi tuur hamutuk ho ema nebee hahalok aat.<verse eid="PSA 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6" />NAI Maromak, hau nia liman moos hatudu katak hau la sala;</para>
  <para style="q2" vid="PSA 26:6">hau lao haleu Ita Boot nia altar<verse eid="PSA 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7" />hodi hahii Ita Boot ho lian makaas</para>
  <para style="q2" vid="PSA 26:7">no konta sai buat furak nebee Ita Boot halo tiha ona.<verse eid="PSA 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8" />NAI Maromak, hau gosta uma nebee mak Ita Boot hela ba,</para>
  <para style="q2" vid="PSA 26:8">fatin nebee mak Ita Boot nia naroman nabilan horik ba.<verse eid="PSA 26:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9" />Keta dasa sai hau hamutuk ho sala nain sira;</para>
  <para style="q2" vid="PSA 26:9">keta hasai hau nia vida hamutuk ho ema nebee hamrook ba raan.<verse eid="PSA 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10" />Sira nia liman toman halo buat aat;</para>
  <para style="q2" vid="PSA 26:10">sira nia liman loos nakonu ho korupsaun.<verse eid="PSA 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11" />Maibee hau nee ema nebee moris loos;</para>
  <para style="q2" vid="PSA 26:11">salva hau, hatudu Ita Boot nia laran luak mai hau.<verse eid="PSA 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12" />Hau nia ain hamriik metin iha rai tetuk;</para>
  <para style="q2" vid="PSA 26:12">Hau sei hahii NAI Maromak iha ema lubuk boot nia leet.<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="s">Hahii Nai Maromak no husu tulun</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1" />NAI Maromak nia naroman leno hau nia dalan;</para>
  <para style="q2" vid="PSA 27:1">Nia mak hau nia Salvador.</para>
  <para style="q2" vid="PSA 27:1">Hau atu tauk see?</para>
  <para style="q1" vid="PSA 27:1">NAI mak abrigu ba hau nia moris.</para>
  <para style="q2" vid="PSA 27:1">Hau atu nakdedar ba see?<verse eid="PSA 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2" />Bainhira ema aat mai atu tolan hau,</para>
  <para style="q2" vid="PSA 27:2">hau nia inimigu ho funu baluk sira nee mak sei sidi no monu.<verse eid="PSA 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3" />Maski tropas mai serku hau,</para>
  <para style="q2" vid="PSA 27:3">hau nia laran sei la tauk;</para>
  <para style="q1" vid="PSA 27:3">maski funu mosu kontra hau,</para>
  <para style="q2" vid="PSA 27:3">hau fiar nafatin.<verse eid="PSA 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4" />Iha deit buat ida mak hau husu ba NAI Maromak;</para>
  <para style="q2" vid="PSA 27:4">ida nee deit mak hau buka.</para>
  <para style="q1" vid="PSA 27:4">Hau hakarak atu loro-loron durante hau nia moris tomak,</para>
  <para style="q2" vid="PSA 27:4">hau hela iha NAI nia uma</para>
  <para style="q1" vid="PSA 27:4">hodi hateke ba NAI nia furak,</para>
  <para style="q2" vid="PSA 27:4">no harohan ba Nia iha Nia uma kreda.<verse eid="PSA 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5" />Tanba iha tempu susar,</para>
  <para style="q2" vid="PSA 27:5">Nia sei halo hau hakmatek iha Nia tenda laran;</para>
  <para style="q1" vid="PSA 27:5">Nia sei subar hau iha Nia fatin santu;</para>
  <para style="q2" vid="PSA 27:5">Nia sei hatuur hau iha fatuk boot ida nia leten.<verse eid="PSA 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6" />Nia foti aas tiha ona hau</para>
  <para style="q2" vid="PSA 27:6">iha hau nia inimigu sira hotu nia klaran.</para>
  <para style="q1" vid="PSA 27:6">Hau sei haklalak hodi lori sakrifisiu ba iha Nia fatin santu;</para>
  <para style="q2" vid="PSA 27:6">hau sei hananu no halo muzika ba NAI.<verse eid="PSA 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7" />NAI Maromak, bainhira hau bolu Ita Boot, see tilun mai hau;</para>
  <para style="q2" vid="PSA 27:7">hatudu Ita Boot nia laran diak hodi hataan mai hau.<verse eid="PSA 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8" />Hau hatete ba hau nia aan, “Adora Nia ba!”</para>
  <para style="q2" vid="PSA 27:8">NAI, hau sei adora duni Ita Boot.<verse eid="PSA 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9" />Keta subar Ita Boot nia oin mai hau;</para>
  <para style="q2" vid="PSA 27:9">keta duni sai Ita Boot nia atan ho hirus,</para>
  <para style="q2" vid="PSA 27:9">tanba Ita Boot tulun tiha ona hau.</para>
  <para style="q1" vid="PSA 27:9">Maromak hau nia salvador,</para>
  <para style="q2" vid="PSA 27:9">keta duni hau fila, keta husik hau mesak.<verse eid="PSA 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10" />Maski hau nia inan-aman husik hau mesak mos,</para>
  <para style="q2" vid="PSA 27:10">NAI, Ita Boot sei simu hau.<verse eid="PSA 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11" />NAI Maromak, hanorin Ita Boot nia dalan mai hau;</para>
  <para style="q2" vid="PSA 27:11">lori hau tuir dalan loos</para>
  <para style="q2" vid="PSA 27:11">tanba hau iha inimigu barak.<verse eid="PSA 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12" />Keta saran hau ba hau nia funu baluk sira,</para>
  <para style="q2" vid="PSA 27:12">tanba iha sasin falsu hamriik hasoru hau;</para>
  <para style="q2" vid="PSA 27:12">sira duun matak hau hodi ameasa hau.<verse eid="PSA 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13" />Hau fiar katak hau sei moris</para>
  <para style="q2" vid="PSA 27:13">hodi haree NAI nia diak.<verse eid="PSA 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14" />Laran metin ba NAI;</para>
  <para style="q2" vid="PSA 27:14">sai forti ba, aten brani ba.</para>
  <para style="q2" vid="PSA 27:14">Laran metin ba NAI!<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="s">Harohan husu tulun</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1" />NAI Maromak, hau harohan ba Ita Boot.</para>
  <para style="q2" vid="PSA 28:1">Ita Boot mak fatuk lolon boot nebee hau helik ba;</para>
  <para style="q2" vid="PSA 28:1">keta taka tilun mai hau.</para>
  <para style="q1" vid="PSA 28:1">Se Ita Boot nonook nafatin,</para>
  <para style="q2" vid="PSA 28:1">hau sei sai hanesan sira nebee mak tuun ba rai kuak.<verse eid="PSA 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2" />Hau see oin ba iha Ita Boot nia Fatin nebee Lulik Liu</para>
  <para style="q2" vid="PSA 28:2">hodi foti sae hau nia liman;</para>
  <para style="q1" vid="PSA 28:2">hau halerik husu tulun ba Ita Boot;</para>
  <para style="q2" vid="PSA 28:2">rona hau nia lian ba!<verse eid="PSA 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3" />Keta duni sai hau hamutuk ho ema aat sira,</para>
  <para style="q2" vid="PSA 28:3">hamutuk ho sira nebee mak toman halo buat aat,</para>
  <para style="q1" vid="PSA 28:3">sira nebee mak finji koalia diak ba sira nia maluk,</para>
  <para style="q2" vid="PSA 28:3">maibee rai odi iha laran.<verse eid="PSA 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">28:4 </char>
      <char style="xt" closed="false">
        <ref loc="REV 22:12">Apokalipse 22:12</ref>
      </char>
    </note>Selu fali sira tuir saida mak sira halo;</para>
  <para style="q2" vid="PSA 28:4">foo ba sira tuir sira nia hahalok aat.</para>
  <para style="q1" vid="PSA 28:4">Selu fali sira tuir saida mak sira nia liman halo tiha ona;</para>
  <para style="q2" vid="PSA 28:4">foo todan ba sira tuir sira merese simu.<verse eid="PSA 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5" />Sira la rekonhese buat nebee mak NAI Maromak halo tiha ona</para>
  <para style="q2" vid="PSA 28:5">ho buat nebee mak Nia liman kria tiha ona.</para>
  <para style="q1" vid="PSA 28:5">Nunee Nia sei sobu sira,</para>
  <para style="q2" vid="PSA 28:5">no nunka atu harii fila fali.<verse eid="PSA 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6" />Hahii NAI Maromak,</para>
  <para style="q2" vid="PSA 28:6">tanba Nia rona ona hau nia halerik husu tulun.<verse eid="PSA 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7" />NAI mak hau nia forsa, Nia defende hau;</para>
  <para style="q2" vid="PSA 28:7">hau nia laran metin ba Nia;</para>
  <para style="q1" vid="PSA 28:7">Nia tulun hau hodi halo hau nia laran haksolok teb-tebes;</para>
  <para style="q2" vid="PSA 28:7">hau hananu hau nia kantiku hodi hahii Nia.<verse eid="PSA 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8" />NAI Maromak foo forsa ba Nia povu;</para>
  <para style="q2" vid="PSA 28:8">Nia mak abrigu hodi salva liurai nebee mak Nia hili tiha ona.<verse eid="PSA 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9" />NAI, salva Ita Boot Nia povu.</para>
  <para style="q2" vid="PSA 28:9">Sira nee Ita Boot nia riku-soin, foo bensaun ba!</para>
  <para style="q1" vid="PSA 28:9">Sai sira nia Bibi Atan</para>
  <para style="q2" vid="PSA 28:9">hodi tau matan ba sira tinan ba tinan.<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="s">Nai Maromak nia lian hanesan rai lakan ho rai tarutu</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">29:1 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 96:7-9">Salmu 96:7-9</ref>
      </char>
    </note>Imi sira nebee hela iha lalehan, hahii NAI Maromak ba;</para>
  <para style="q2" vid="PSA 29:1">hahii NAI tanba Nia kbiit boot ho forsa.<verse eid="PSA 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2" />Hahii NAI tanba nia naran boot;</para>
  <para style="q2" vid="PSA 29:2">adora Nia tanba Nia santu ho furak.<verse eid="PSA 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3" />NAI Maromak nia lian baku iha tasi leten;</para>
  <para style="q2" vid="PSA 29:3">Maromak kbiit boot nia lian tarutu;</para>
  <para style="q2" vid="PSA 29:3">NAI nia lian tarutu iha tasi boot nia leten.<verse eid="PSA 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4" />NAI nia lian makaas teb-tebes;</para>
  <para style="q2" vid="PSA 29:4">NAI nia lian hatudu sai Nia kbiit.<verse eid="PSA 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5" />NAI nia lian silu tohar ai huun boot sedru;</para>
  <para style="q2" vid="PSA 29:5">too ai huun boot iha foho Líbanu nian mos NAI fera tiha sai rohan-rohan.<verse eid="PSA 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6" />Nia halo foho Líbanu nian haksoit hanesan fali karau oan;</para>
  <para style="q2" vid="PSA 29:6">foho Sirión<note caller="+" style="f"><char style="fr" closed="false">29:6 </char><char style="ft" closed="false">Foho Sirión nia naran seluk mak Hermon.</char></note> mos haksoit hanesan karau fuik nia oan.<verse eid="PSA 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7" />NAI nia lian halo rai lakan makaas.<verse eid="PSA 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8" />NAI nia lian doko rai fuik maran;</para>
  <para style="q2" vid="PSA 29:8">NAI doko rai fuik maran Kades nian.<verse eid="PSA 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9" />NAI nia lian dulas ai huun boot,</para>
  <para style="q2" vid="PSA 29:9">too ai huun sira iha ai laran tuan mos tahan namtate hotu.</para>
  <para style="q1" vid="PSA 29:9">Iha Nia uma kreda, ema hotu-hotu haklalak dehan,</para>
  <para style="q2" vid="PSA 29:9">“Foti aas Nia naran!”<verse eid="PSA 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10" />NAI Maromak tuur iha Nia kadeira ukun iha bee boot leten;</para>
  <para style="q2" vid="PSA 29:10">NAI tuur hodi ukun nudar Liurai tinan ba tinan.<verse eid="PSA 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11" />NAI foo kbiit ba Nia povu;</para>
  <para style="q2" vid="PSA 29:11">NAI foo bensaun ba Nia povu hodi foo pas ho hakmatek ba sira.<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="s">Agradese ba Nai Maromak tanba hetan kura</para>
  <para style="d">Salmu David nian. Kantiku bainhira selebra loron inaugurasaun uma kreda.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1" />NAI Maromak, hau sei gaba Ita Boot,</para>
  <para style="q2" vid="PSA 30:1">tanba Ita Boot dada tiha ona hau sai husi rai kuak;</para>
  <para style="q2" vid="PSA 30:1">Ita Boot la husik hau nia inimigu sira foti aan hasoru hau.<verse eid="PSA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2" />NAI, hau nia Maromak, uluk hau halerik husu tulun ba Ita Boot;</para>
  <para style="q2" vid="PSA 30:2">agora Ita Boot kura tiha ona hau.<verse eid="PSA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3" />NAI, Ita Boot lori ona hau sai husi matebian sira nia fatin;</para>
  <para style="q2" vid="PSA 30:3">Ita Boot la husik hau lao hamutuk ho ema sira nebee tuun dadauk ba rai kuak.<verse eid="PSA 30:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4" />Imi povu nebee foo laran ba NAI Maromak, hananu hahii Nia ba;</para>
  <para style="q2" vid="PSA 30:4">hahii Nia naran santu,<verse eid="PSA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5" />tanba Nia hirus iha tempu badak deit,</para>
  <para style="q2" vid="PSA 30:5">maibee Nia hatudu Nia laran luak ba ita durante ita nia moris tomak.</para>
  <para style="q1" vid="PSA 30:5">Ita bele tanis halerik iha oras kalan,</para>
  <para style="q2" vid="PSA 30:5">maibee iha dadeer-saan ita hetan ksolok.<verse eid="PSA 30:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6" />Uluk hau senti hakmatek, hau dehan,</para>
  <para style="q2" vid="PSA 30:6">“Hau nunka atu nakdoko.”<verse eid="PSA 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7" />NAI Maromak, bainhira Ita Boot hatudu Ita Boot nia laran luak mai hau,</para>
  <para style="q2" vid="PSA 30:7">Ita Boot halo hau hamriik metin hanesan foho boot ida.</para>
  <para style="q1" vid="PSA 30:7">Maibee bainhira Ita Boot subar oin mai hau,</para>
  <para style="q2" vid="PSA 30:7">hau nia fuan taridu.<verse eid="PSA 30:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8" />NAI Maromak, uluk hau harohan ba Ita Boot;</para>
  <para style="q2" vid="PSA 30:8">hau husu atu Nai hanoin hau.<verse eid="PSA 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9" />Hau dehan, “Se karik hau mate,</para>
  <para style="q2" vid="PSA 30:9">se karik hau tuun ba iha rai kuak, iha folin saida?</para>
  <para style="q1" vid="PSA 30:9">Rai rahun bele hahii Ita Boot ka?</para>
  <para style="q2" vid="PSA 30:9">Rai rahun bele deklara katak Ita Boot nia laran diak dura nafatin ka?<verse eid="PSA 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10" />NAI, rona hau, hatudu Ita Boot nia laran luak mai hau;</para>
  <para style="q2" vid="PSA 30:10">NAI, ajuda hau ba!”<verse eid="PSA 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11" />Uluk hau tanis lelir,</para>
  <para style="q2" vid="PSA 30:11">maibee Ita Boot foo ksolok mai hau, halo hau bidu.</para>
  <para style="q1" vid="PSA 30:11">Ita Boot hasai tiha hena lutu nian husi hau</para>
  <para style="q2" vid="PSA 30:11">hodi foo hatais fali hena ksolok nian.<verse eid="PSA 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12" />Nunee hau sei la nonook; hau sei hananu hahii Ita Boot.</para>
  <para style="q2" vid="PSA 30:12">NAI, hau nia Maromak, hau sei agradese ba Ita Boot tinan ba tinan.<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="s">Hakmatek iha Nai Maromak nia liman laran</para>
  <para style="d">Salmu David nian, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1" />NAI Maromak, hau hamahon aan iha Ita Boot;</para>
  <para style="q2" vid="PSA 31:1">keta husik hau moe leet;</para>
  <para style="q2" vid="PSA 31:1">salva hau tanba Ita Boot sempre halo buat nebee loos.<verse eid="PSA 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2" />See tilun mai hau;</para>
  <para style="q2" vid="PSA 31:2">mai lalais hodi salva hau.</para>
  <para style="q1" vid="PSA 31:2">Sai hau nia subar fatin, hanesan fatuk lolon boot para hau helik ba;</para>
  <para style="q2" vid="PSA 31:2">sai hanesan lutu metin ida hodi satan netik hau.<verse eid="PSA 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3" />Ita Boot mak fatuk kuak nebee hau subar iha laran;</para>
  <para style="q2" vid="PSA 31:3">Ita Boot mak lutu haleu hau.</para>
  <para style="q1" vid="PSA 31:3">Lori hau hodi hatudu dalan mai hau,</para>
  <para style="q2" vid="PSA 31:3">atu nunee ema foti aas Ita Boot nia naran.<verse eid="PSA 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4" />Kuidadu hau para hau la bele monu ba lasu nebee ema prepara hela ba hau,</para>
  <para style="q2" vid="PSA 31:4">tanba Ita Boot mak hau nia subar fatin.<verse eid="PSA 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">31:5 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 23:46">Lucas 23:46</ref>
      </char>
    </note>Hau entrega hau nia moris ba iha Ita Boot nia liman;</para>
  <para style="q2" vid="PSA 31:5">NAI Maromak, Ita Boot nia laran sempre hanoin hau, salva hau ba.<verse eid="PSA 31:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6" />NAI Maromak, hau<note caller="+" style="f"><char style="fr" closed="false">31:6 </char><char style="ft" closed="false">Iha dokumentu Ebreu antigu ida ho mos tradusaun antigu balu dehan, “Ita Boot”. </char></note> odi ema nebee adora estatua lulik, buat sira nee la iha folin.</para>
  <para style="q2" vid="PSA 31:6">Hau laos hanesan ema sira nee, hau konfia Ita Boot.<verse eid="PSA 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7" />Hau sei kontenti haksolok</para>
  <para style="q2" vid="PSA 31:7">tanba Ita Boot nia domin rohan-laek.</para>
  <para style="q1" vid="PSA 31:7">Ita Boot haree tiha ona hau nia terus;</para>
  <para style="q2" vid="PSA 31:7">Ita Boot hatene ona hau nia laran susar.<verse eid="PSA 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8" />Ita Boot la entrega hau ba inimigu sira nia liman laran,</para>
  <para style="q2" vid="PSA 31:8">maibee tau hau nia ain iha fatin luan.<verse eid="PSA 31:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9" />NAI Maromak, hau iha fatin kloot laran;</para>
  <para style="q2" vid="PSA 31:9">hanoin hau ba.</para>
  <para style="q1" vid="PSA 31:9">Hau nia matan sai malahuk tiha tanba hau nia laran dodok;</para>
  <para style="q2" vid="PSA 31:9">hau nia isin ho klamar terus hotu.<verse eid="PSA 31:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10" />Hau nia vida nakonu ho tristi;</para>
  <para style="q2" vid="PSA 31:10">hau nia moris tomak hau halerik hela deit.</para>
  <para style="q1" vid="PSA 31:10">Terus ho susar nee halo hau nia forsa tuun ba dadauk</para>
  <para style="q2" vid="PSA 31:10">too hau nia ruin sira mamar hotu ona.<verse eid="PSA 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11" />Hau nia inimigu sira hatuun hau;</para>
  <para style="q2" vid="PSA 31:11">hau nia vizinhu sira hatete aat hau;</para>
  <para style="q1" vid="PSA 31:11">hau nia belun sira haree hau, sira tauk;</para>
  <para style="q2" vid="PSA 31:11">ema nebee hasoru hau iha estrada halai sees tiha.<verse eid="PSA 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12" />Ema haluha hau hanesan fali hau mate tiha ona;</para>
  <para style="q2" vid="PSA 31:12">hau hanesan vazu nebee nakfera tiha ona.<verse eid="PSA 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13" />Hau rona ema barak bis-bisu</para>
  <para style="q2" vid="PSA 31:13">hodi hatauk hau husi sor-sorin.</para>
  <para style="q1" vid="PSA 31:13">Sira kombina malu hodi kontra hau;</para>
  <para style="q2" vid="PSA 31:13">sira halo planu atu hasai hau nia vida.<verse eid="PSA 31:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14" />Maibee NAI, hau konfia Ita Boot;</para>
  <para style="q2" vid="PSA 31:14">hau dehan, “Ita Boot mak hau nia Maromak.”<verse eid="PSA 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15" />Hau nia vida tomak iha Ita Boot nia liman laran;</para>
  <para style="q2" vid="PSA 31:15">hasai hau husi hau nia inimigu sira nia liman,</para>
  <para style="q2" vid="PSA 31:15">husi ema nebee halo terus hau.<verse eid="PSA 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16" />Halo Ita Boot nia oin leno Ita Boot nia atan hau;</para>
  <para style="q2" vid="PSA 31:16">salva hau hodi Ita Boot nia domin rohan-laek.<verse eid="PSA 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17" />NAI, hau harohan ba Ita Boot;</para>
  <para style="q2" vid="PSA 31:17">keta husik hau moe leet.</para>
  <para style="q1" vid="PSA 31:17">Husik ema aat sira mak moe ba;</para>
  <para style="q2" vid="PSA 31:17">husik sira tuun lian-laek ba iha ema mate nia fatin.<verse eid="PSA 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18" />Halo sira nia ibun nonook tiha,</para>
  <para style="q2" vid="PSA 31:18">tanba sira foti aan hatuun ema nebee moris loos</para>
  <para style="q2" vid="PSA 31:18">hodi hatete aat sira.<verse eid="PSA 31:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19" />Ita Boot rai hela buat mesak furak</para>
  <para style="q2" vid="PSA 31:19">hodi foo ba ema nebee hamtauk Ita Boot;</para>
  <para style="q1" vid="PSA 31:19">iha ema hotu nia oin, Ita Boot haraik buat diak sira nee</para>
  <para style="q2" vid="PSA 31:19">ba ema nebee buka mahon iha Ita Boot.<verse eid="PSA 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20" />Ita Boot subar sira iha Ita Boot nia prezensa</para>
  <para style="q2" vid="PSA 31:20">atu ema nia planu aat la bele kona sira;</para>
  <para style="q1" vid="PSA 31:20">Ita Boot halo sira seguru iha Ita Boot nia fatin,</para>
  <para style="q2" vid="PSA 31:20">dook husi ema nebee duun sira.<verse eid="PSA 31:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21" />Hahii NAI Maromak,</para>
  <para style="q2" vid="PSA 31:21">tanba Nia hatudu Nia domin nebee furak teb-tebes mai hau.</para>
  <para style="q1" vid="PSA 31:21">Bainhira inimigu sira serku hau,<verse eid="PSA 31:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="PSA 31:22" />hau tauk hodi hanoin,</para>
  <para style="q2" vid="PSA 31:22">“Maromak dasa sai tiha ona hau husi Nia oin!”</para>
  <para style="q1" vid="PSA 31:22">Maibee lae, bainhira hau halerik husu tulun ba Nia,</para>
  <para style="q2" vid="PSA 31:22">Nia rona hela hau nia orasaun.<verse eid="PSA 31:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23" />Povu hotu nebee foo laran ba NAI Maromak, hadomi Nia ba!</para>
  <para style="q2" vid="PSA 31:23">NAI tau matan ba ema nebee moris loos,</para>
  <para style="q2" vid="PSA 31:23">maibee ema nebee foti aan, Nia foo kastigu tuir sira nia hahalok.<verse eid="PSA 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24" />Imi sira nebee laran metin ba NAI,</para>
  <para style="q2" vid="PSA 31:24">sai forti ba, aten brani ba!<verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="s">Haksolok tanba hetan perdaun husi Nai Maromak</para>
  <para style="d">Salmu David nian para hanorin ema.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">32:1 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 4:7">Roma 4:7</ref>,<ref loc="ROM 4:8">8</ref></char>
    </note>Se ema kontra Maromak nia lei maibee Maromak foo perdaun,</para>
  <para style="q2" vid="PSA 32:1">ema nee hetan bensaun.</para>
  <para style="q1" vid="PSA 32:1">Se nia halo sala maibee Maromak hamoos tiha nia sala,</para>
  <para style="q2" vid="PSA 32:1">ema nee hetan ksolok.<verse eid="PSA 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2" />Se NAI Maromak la husu tuir ona nia sala,</para>
  <para style="q2" vid="PSA 32:2">no ema nee la hatene bosok,</para>
  <para style="q2" vid="PSA 32:2">ema nee hetan bensaun.<verse eid="PSA 32:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3" />Uluk bainhira hau lakohi foo sai hau nia sala,</para>
  <para style="q2" vid="PSA 32:3">loron tomak hau halerik hela deit,</para>
  <para style="q2" vid="PSA 32:3">too hau nia ruin sira sai mamar hotu.<verse eid="PSA 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4" />Tanba loron-kalan</para>
  <para style="q2" vid="PSA 32:4">Ita Boot nia liman hanehan makaas hau;</para>
  <para style="q1" vid="PSA 32:4">hau nia forsa lakon tiha</para>
  <para style="q2" vid="PSA 32:4">hanesan bee nebee maran iha bailoron.<verse eid="PSA 32:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5" />Too ikus hau foo sai tiha hau nia sala ba Ita Boot;</para>
  <para style="q2" vid="PSA 32:5">hau la subar tan hau nia pekadu.</para>
  <para style="q1" vid="PSA 32:5">Hau dehan, “Hau sei konfesa hau nia hahalok aat ba NAI Maromak.”</para>
  <para style="q2" vid="PSA 32:5">Nunee Ita Boot hamoos tiha hau nia sala hodi halo hau livre.<verse eid="PSA 32:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6" />Nee duni diak liu ema nebee foo laran ba Ita Boot aproveita harohan ba Ita Boot</para>
  <para style="q2" vid="PSA 32:6">durante sira sei bele. <note caller="+" style="f"><char style="fr" closed="false">32:6 </char><char style="ft" closed="false">Iha nee orijinal laduun klaru. Bele mos signifika “iha susar laran”.</char></note></para>
  <para style="q1" vid="PSA 32:6">Bainhira bee boot sae,</para>
  <para style="q2" vid="PSA 32:6">sei la too iha sira.<verse eid="PSA 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7" />Ita Boot mak hau nia subar fatin;</para>
  <para style="q2" vid="PSA 32:7">Ita Boot kuidadu hau para susar la bele kona hau.</para>
  <para style="q1" vid="PSA 32:7">Ema sei haleu hau hodi haklalak hahii Ita Boot</para>
  <para style="q2" vid="PSA 32:7">tanba Ita Boot salva ona hau.<verse eid="PSA 32:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8" />Hau<note caller="+" style="f"><char style="fr" closed="false">32:8 </char><char style="ft" closed="false">Matenek nain balu dehan, “Hau” nee Maromak.</char></note> sei hanorin o hodi hatudu dalan ba o;</para>
  <para style="q2" vid="PSA 32:8">Hau sei sai o nia matadalan hodi tau matan ba o.<verse eid="PSA 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9" />Keta neon-laek hanesan kuda ka kuda buru,</para>
  <para style="q2" vid="PSA 32:9">tenki tau tali ba iha nia ibun laran para bele domina nia;</para>
  <para style="q2" vid="PSA 32:9">se lae nia la halo tuir o nia hakarak.<verse eid="PSA 32:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10" />Ema aat hetan terus barak,</para>
  <para style="q2" vid="PSA 32:10">maibee NAI Maromak nia domin rohan-laek haleu ema nebee mak konfia iha Nia.<verse eid="PSA 32:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11" />Imi nebee moris loos, haksolok ho kontenti tanba NAI nia diak;</para>
  <para style="q2" vid="PSA 32:11">imi nebee laran moos, haklalak ho hananu ba!<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="s">Hahii adora Nai Maromak</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1" />Imi nebee moris loos, haklalak ba NAI Maromak;</para>
  <para style="q2" vid="PSA 33:1">ema laran moos hahii Nia, nee buat furak ida.<verse eid="PSA 33:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2" />Toka viola hodi hahii NAI;</para>
  <para style="q2" vid="PSA 33:2">halo muzika ba Nia ho viola tali sanulu.<verse eid="PSA 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3" />Hananu kantiku foun ba Nia;</para>
  <para style="q2" vid="PSA 33:3">toka di-diak muzika hodi haklalak.<verse eid="PSA 33:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4" />Tanba NAI Maromak nia liafuan loos;</para>
  <para style="q2" vid="PSA 33:4">Nia sempre halo buat nebee loos.<verse eid="PSA 33:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5" />NAI gosta lia loos ho justisa;</para>
  <para style="q2" vid="PSA 33:5">Nia domin rohan-laek halo nakonu mundu rai klaran.<verse eid="PSA 33:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6" />NAI Maromak koalia deit, lalehan iha;</para>
  <para style="q2" vid="PSA 33:6">Nia huu deit iis husi ibun, loro matan, fulan ho fitun mosu.<verse eid="PSA 33:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7" />Nia butuk hamutuk tasi been iha fatin ida;</para>
  <para style="q2" vid="PSA 33:7">Nia haloot tasi been iha armazen laran.<verse eid="PSA 33:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8" />Mundu tomak, hamtauk NAI Maromak ba;</para>
  <para style="q2" vid="PSA 33:8">ema hotu iha mundu, admira ba,<verse eid="PSA 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9" />tanba Nia koalia deit, buat hotu iha;</para>
  <para style="q2" vid="PSA 33:9">Nia foo orden deit, buat hotu hamriik metin.<verse eid="PSA 33:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10" />NAI Maromak teri netik tiha nasaun jentiu sira nia planu;</para>
  <para style="q2" vid="PSA 33:10">Nia halo povu jentiu sira nia hakarak la sai realidade.<verse eid="PSA 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11" />Maibee NAI nia planu dura nafatin ba nafatin;</para>
  <para style="q2" vid="PSA 33:11">buat nebee Nia laran hakarak, sempre realiza husi jerasaun ba jerasaun.<verse eid="PSA 33:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12" />Nasaun nebee rekonhese katak NAI mak sira nia Maromak, sira hetan ksolok;</para>
  <para style="q2" vid="PSA 33:12">povu nebee Nia hili sai Ninian, sira hetan bensaun.<verse eid="PSA 33:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13" />NAI Maromak hateke tuun husi lalehan</para>
  <para style="q2" vid="PSA 33:13">hodi haree ema hotu-hotu;<verse eid="PSA 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14" />husi Nia kadeira ukun, Nia fihir</para>
  <para style="q2" vid="PSA 33:14">buat hotu nebee moris iha mundu.<verse eid="PSA 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15" />Nia mak foo neon ba ema hotu;</para>
  <para style="q2" vid="PSA 33:15">Nia hatene buat hotu nebee sira halo.<verse eid="PSA 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16" />Liurai ida bele iha militar barak too iha nebee mos, sira la bele salva nia;</para>
  <para style="q2" vid="PSA 33:16">funu nain ida bele iha forsa boot too iha nebee mos, sei la ajuda nia.<verse eid="PSA 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17" />Ema laran metin ba kuda forti ida atu manaan funu, laran metin saugati;</para>
  <para style="q2" vid="PSA 33:17">kuda bele makaas too iha nebee mos, la bele salva nia.<verse eid="PSA 33:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18" />Maibee NAI Maromak nia matan hateke ba ema nebee hamtauk Nia;</para>
  <para style="q2" vid="PSA 33:18">Nia tau matan ba ema nebee laran metin ba Nia domin rohan-laek,<verse eid="PSA 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19" />atu salva sira husi mate;</para>
  <para style="q2" vid="PSA 33:19">atu foo moris ba sira iha tempu rai hamlaha.<verse eid="PSA 33:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20" />Ita hein ho laran metin ba NAI Maromak;</para>
  <para style="q2" vid="PSA 33:20">Nia mak tulun ita no defende ita.<verse eid="PSA 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21" />Ita nia laran haksolok,</para>
  <para style="q2" vid="PSA 33:21">tanba ita konfia Nia naran santu.<verse eid="PSA 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22" />NAI, haraik Ita Boot nia domin rohan-laek nafatin mai ami,</para>
  <para style="q2" vid="PSA 33:22">tanba ami laran metin ba Ita Boot.<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="s">Hahii Nai Maromak tanba Nia foo mahon ba ita</para>
  <para style="d">Salmu David nian, bainhira nia finji bulak iha Abimelek nia oin, nunee Abimelek duni sai nia.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1" />Hau sei foti aas NAI Maromak iha hau nia moris tomak;</para>
  <para style="q2" vid="PSA 34:1">hau nia ibun sei hahii nafatin Nia.<verse eid="PSA 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2" />Hau sei hahii adora NAI;</para>
  <para style="q2" vid="PSA 34:2">ema kbiit-laek sira, rona hodi haksolok ba.<verse eid="PSA 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3" />Mai ita hamutuk foti aas NAI nia naran;</para>
  <para style="q2" vid="PSA 34:3">hamutuk ho hau tane aas Nia.<verse eid="PSA 34:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4" />Uluk hau harohan ba NAI Maromak, Nia hataan hau;</para>
  <para style="q2" vid="PSA 34:4">Nia salva tiha hau husi buat hotu nebee hatauk hau.<verse eid="PSA 34:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5" />Ema nebee hateke ba Nia sei kontenti haksolok;</para>
  <para style="q2" vid="PSA 34:5">sira nunka atu moe.<verse eid="PSA 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6" />Iha tempu nebaa hau, ema kbiit-laek nee halerik, NAI Maromak rona hau;</para>
  <para style="q2" vid="PSA 34:6">Nia hasai hau husi terus hotu-hotu.<verse eid="PSA 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7" />NAI nia anju harii nia tenda</para>
  <para style="q2" vid="PSA 34:7">haleu ema nebee hamtauk Maromak</para>
  <para style="q2" vid="PSA 34:7">hodi salva sira.<verse eid="PSA 34:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">34:8 </char>
      <char style="xt" closed="false">
        <ref loc="1PE 2:3">1 Pedro 2:3</ref>
      </char>
    </note>Mai koko hodi haree NAI nia diak;</para>
  <para style="q2" vid="PSA 34:8">ema nebee hamahon aan iha Nia, sira hetan ksolok.<verse eid="PSA 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9" />Imi NAI Maromak nia povu, hamtauk Nia ba,</para>
  <para style="q2" vid="PSA 34:9">tanba ema nebee hamtauk Nia, sira la falta buat ida.<verse eid="PSA 34:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10" />Liaun karik bele hamlaha tanba la hetan hahaan,</para>
  <para style="q2" vid="PSA 34:10">maibee ema nebee buka NAI Maromak, buat diak ida la falta ba nia.<verse eid="PSA 34:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11" />Oan sira, mai rona hau nia liafuan;</para>
  <para style="q2" vid="PSA 34:11">hau sei hanorin imi oinsaa hamtauk NAI Maromak.<verse eid="PSA 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">34:12 </char>
      <char style="xt" closed="false">
        <ref loc="1PE 3:10-12">1 Pedro 3:10-12</ref>
      </char>
    </note>Imi sira nee, see mak buka moris diak,</para>
  <para style="q2" vid="PSA 34:12">no hakarak teb-tebes atu hetan moris naruk ho haksolok?<verse eid="PSA 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13" />Tenki kuidadu imi nia ibun para la bele koalia aat,</para>
  <para style="q2" vid="PSA 34:13">no la bele koalia bosok.<verse eid="PSA 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14" />Fila kotuk ba buat aat hodi halo buat nebee diak;</para>
  <para style="q2" vid="PSA 34:14">hakaas aan atu moris dame malu ho ema hotu-hotu, buka nafatin dame too hetan.<verse eid="PSA 34:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15" />NAI Maromak tau matan ba ema nebee mak moris loos;</para>
  <para style="q2" vid="PSA 34:15">Nia see tilun ba sira nia halerik.<verse eid="PSA 34:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16" />Maibee NAI kontra ema nebee mak halo aat,</para>
  <para style="q2" vid="PSA 34:16">too hasai tiha sira nia naran husi mundu.<verse eid="PSA 34:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17" />Ema moris loos halerik, NAI rona sira;</para>
  <para style="q2" vid="PSA 34:17">Nia hasai sira husi sira nia susar.<verse eid="PSA 34:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18" />NAI besik ba ema nebee laran dodok;</para>
  <para style="q2" vid="PSA 34:18">Nia salva ema nebee lakon esperansa.<verse eid="PSA 34:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19" />Ema moris loos hetan terus oi-oin,</para>
  <para style="q2" vid="PSA 34:19">maibee NAI Maromak hasai sira husi terus hirak nee hotu.<verse eid="PSA 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20" />
    <note caller="+" style="x">
      <char style="xo" closed="false">34:20 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 19:36">João 19:36</ref>
      </char>
    </note>Nia kuidadu ema nee nia ruin tomak;</para>
  <para style="q2" vid="PSA 34:20">ruin ida mos la tohar.<verse eid="PSA 34:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21" />Ema aat sei mate ho nia hahalok rasik;</para>
  <para style="q2" vid="PSA 34:21">see mak odi ema moris loos, sira sei hetan kastigu.<verse eid="PSA 34:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22" />NAI Maromak sei salva Nia atan sira;</para>
  <para style="q2" vid="PSA 34:22">ema nebee buka mahon iha Nia, la iha ida mak hetan kastigu.<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="s">Orasaun husu tulun bainhira hasoru inimigu</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1" />NAI Maromak, ema nebee halo funu hasoru hau, Ita Boot halo funu hasoru sira ba;</para>
  <para style="q2" vid="PSA 35:1">ema nebee ataka hau, Ita Boot ataka sira ba.<verse eid="PSA 35:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2" />Kaer metin ekipamentu funu nian hodi satan netik hau;</para>
  <para style="q2" vid="PSA 35:2">hamriik hodi mai tulun hau.<verse eid="PSA 35:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3" />Foti Ita Boot nia diman ho baliu funu nian</para>
  <para style="q2" vid="PSA 35:3">kontra ema nebee mak duni tuir hau.</para>
  <para style="q1" vid="PSA 35:3">Hatete mai hau katak,</para>
  <para style="q2" vid="PSA 35:3">Ita Boot mak hau nia Salvador.<verse eid="PSA 35:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4" />Hau harohan atu ema nebee hakarak halakon hau nia vida</para>
  <para style="q2" vid="PSA 35:4">sai moe boot ho oin tuun.</para>
  <para style="q1" vid="PSA 35:4">Hau husu atu ema nebee hanoin aat mai hau</para>
  <para style="q2" vid="PSA 35:4">hakiduk ho oin mean.<verse eid="PSA 35:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5" />Haruka NAI nia anju duni sai tiha sira</para>
  <para style="q2" vid="PSA 35:5">hanesan anin huu lakon hare kulit.<verse eid="PSA 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6" />NAI nia anju duni hela sira,</para>
  <para style="q2" vid="PSA 35:6">husik dalan nebee sira liu sai nakukun ho namdoras.<verse eid="PSA 35:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7" />Tanba sira subar lasu mai hau maski hau la sala;</para>
  <para style="q2" vid="PSA 35:7">maski hau la sala, sira kee rai kuak mai hau.<verse eid="PSA 35:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8" />Hau harohan atu dezastre boot kona sira derepenti;</para>
  <para style="q2" vid="PSA 35:8">husik sira monu ba iha lasu nebee sira rasik monta mai hau;</para>
  <para style="q2" vid="PSA 35:8">husik sira mate mohu iha rai kuak laran.<verse eid="PSA 35:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9" />Nunee hau nia laran sei haksolok;</para>
  <para style="q2" vid="PSA 35:9">hau sei kontenti tanba NAI Maromak salva ona hau.<verse eid="PSA 35:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10" />Ho hau nia aan tomak hau sei deklara,</para>
  <para style="q2" vid="PSA 35:10">“NAI, see mak hanesan Ita Boot?!</para>
  <para style="q1" vid="PSA 35:10">Ita Boot salva kbiit-laek sira husi ema nebee forsa liu sira;</para>
  <para style="q2" vid="PSA 35:10">ema kiak ho ema kbiit-laek sira nebee ema hanehan, Ita Boot tulun sira.”<verse eid="PSA 35:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11" />Ema aat sira hamriik foo sasin falsu hasoru hau;</para>
  <para style="q2" vid="PSA 35:11">sira husu hau kona ba buat nebee hau la hatene.<verse eid="PSA 35:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12" />Hau nia diak, sira selu fali ho hahalok aat;</para>
  <para style="q2" vid="PSA 35:12">hau tristi teb-tebes.<verse eid="PSA 35:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13" />Uluk sira moras, hau hatais hena lutu</para>
  <para style="q2" vid="PSA 35:13">hodi haraik aan ho jejun.</para>
  <para style="q1" vid="PSA 35:13">Hau hakruuk hodi harohan<verse eid="PSA 35:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 35:14" />hanesan fali hau harohan ba hau nia belun ka hau nia maun-alin.</para>
  <para style="q1" vid="PSA 35:14">Hau hakruuk hodi tanis ho laran susar</para>
  <para style="q2" vid="PSA 35:14">hanesan fali hau tanis halerik ba hau nia inan.<verse eid="PSA 35:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15" />Maibee bainhira hau monu, sira hotu kontenti;</para>
  <para style="q2" vid="PSA 35:15">sira haleu hau hodi hatete aat hau.</para>
  <para style="q1" vid="PSA 35:15">Ema fuik nebee hau la konhese</para>
  <para style="q2" vid="PSA 35:15">koalia aat hau la para.<verse eid="PSA 35:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16" />Ema nebee la fiar Maromak, tarata aat hau;</para>
  <para style="q2" vid="PSA 35:16">sira ruun nehan mai hau.<verse eid="PSA 35:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17" />NAI Maromak, Ita Boot hateke deit nunee too bainhira?</para>
  <para style="q2" vid="PSA 35:17">Salva hau tanba sira ataka hau;</para>
  <para style="q2" vid="PSA 35:17">salva hau nia moris husi liaun sira nee.<verse eid="PSA 35:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18" />Depois hau sei agradese ba Ita Boot iha povu nia leet;</para>
  <para style="q2" vid="PSA 35:18">hau sei hahii Ita Boot iha ema lubun boot nia klaran.<verse eid="PSA 35:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">35:19 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:4">Salmu 69:4</ref>; <ref loc="JHN 15:25">João 15:25</ref></char>
    </note>Keta husik hau nia inimigu bosok-teen sira nee haksolok fali ho hau nia terus.</para>
  <para style="q2" vid="PSA 35:19">Sira odi hau maski hau la sala; keta husik sira baku matan ba malu kona ba hau.<verse eid="PSA 35:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20" />Sira la koalia liafuan dame nian,</para>
  <para style="q2" vid="PSA 35:20">maibee sira konta fali istoria falsu</para>
  <para style="q2" vid="PSA 35:20">kontra ema sira nebee hela hakmatek iha rai nee.<verse eid="PSA 35:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21" />Sira halo ibun luan hodi hatete,</para>
  <para style="q2" vid="PSA 35:21">“Ha! Buat nebee o halo, ami haree rasik ho matan.”<verse eid="PSA 35:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22" />NAI Maromak, Ita Boot haree ona ida nee; keta nonook deit;</para>
  <para style="q2" vid="PSA 35:22">Nai, keta dook husi hau.<verse eid="PSA 35:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23" />Hadeer ona, hamriik hodi defende hau;</para>
  <para style="q2" vid="PSA 35:23">hau nia Nai, hau nia Maromak, sai hau nia Defensor ba!<verse eid="PSA 35:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24" />NAI hau nia Maromak, Ita Boot sempre halo buat nebee loos;</para>
  <para style="q2" vid="PSA 35:24">deklara ba katak hau la sala ida.</para>
  <para style="q2" vid="PSA 35:24">Keta husik sira haksolok fali ho hau nia terus.<verse eid="PSA 35:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25" />Keta husik sira dehan ba malu,</para>
  <para style="q2" vid="PSA 35:25">“Haree ba, saida mak ita hakarak nee akontese tiha ona!”</para>
  <para style="q1" vid="PSA 35:25">Keta husik sira dehan,</para>
  <para style="q2" vid="PSA 35:25">“Ita tolan tiha ona nia.”<verse eid="PSA 35:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26" />Hau harohan atu ema nebee kontenti bainhira susar kona hau,</para>
  <para style="q2" vid="PSA 35:26">sira sai moe too bilaan tiha;</para>
  <para style="q1" vid="PSA 35:26">husik ema nebee mak foti aan hasoru hau,</para>
  <para style="q2" vid="PSA 35:26">sira moe boot ho oin tuun.<verse eid="PSA 35:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27" />Hau harohan atu ema nebee hakarak haree hau manaan justisa,</para>
  <para style="q2" vid="PSA 35:27">ema sira nee haklalak ho haksolok hodi hatete fila-fila,</para>
  <para style="q1" vid="PSA 35:27">“NAI Maromak nee boot!</para>
  <para style="q2" vid="PSA 35:27">Nia kontenti bainhira Nia atan hetan diak.”<verse eid="PSA 35:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28" />Hau nia ibun sei foo sai Ita Boot nia justisa;</para>
  <para style="q2" vid="PSA 35:28">loron-kalan hau sei hahii Ita Boot.<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="s">Ema aat nia sala ho Nai Maromak nia diak</para>
  <para style="d">Husi NAI Maromak nia atan David. Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">36:1 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:18">Roma 3:18</ref>
      </char>
    </note>Ema aat sira nia hahalok aat sai fali matadalan ba sira;</para>
  <para style="q2" vid="PSA 36:1">ema sira nee la hatene hamtauk Maromak.<verse eid="PSA 36:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2" />Iha sira nia matan rasik, sira diak loos,</para>
  <para style="q2" vid="PSA 36:2">too sira la haree sira nia sala, no la hakribi sira nia hahalok.<verse eid="PSA 36:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3" />Liafuan nebee sai husi sira nia ibun mesak aat ho bosok;</para>
  <para style="q2" vid="PSA 36:3">sira lakohi halo tan buat nebee mak diak ho buat nebee loos.<verse eid="PSA 36:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4" />Maski iha sira nia toba fatin mos, sira planu buat aat;</para>
  <para style="q2" vid="PSA 36:4">sira tau sira nia aan iha dalan nebee la loos;</para>
  <para style="q2" vid="PSA 36:4">sira nunka fila kotuk ba buat aat.<verse eid="PSA 36:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5" />NAI Maromak, Ita Boot nia domin too iha lalehan aas ba;</para>
  <para style="q2" vid="PSA 36:5">Ita Boot nia lia loos too iha kalohan.<verse eid="PSA 36:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6" />Ita Boot nia diak hanesan foho aas sira;</para>
  <para style="q2" vid="PSA 36:6">Ita Boot nia justisa hanesan tasi nia klean.</para>
  <para style="q1" vid="PSA 36:6">NAI, Ita Boot foo mahon ba ema ho mos ba animal.<verse eid="PSA 36:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7" />Maromak, Ita Boot nia domin folin boot;</para>
  <para style="q2" vid="PSA 36:7">ema hotu hamahon aan iha Ita Boot nia liras okos.<verse eid="PSA 36:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8" />Sira haan too bosu ho hahaan diak nian husi Ita Boot nia uma;</para>
  <para style="q2" vid="PSA 36:8">Ita Boot foo bee ksolok nian husi Ita Boot nia mota ba sira hemu.<verse eid="PSA 36:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9" />Tanba Ita Boot mak buat moris hotu nia huun;</para>
  <para style="q2" vid="PSA 36:9">husi Ita Boot nia naroman ami bele hetan naroman.<verse eid="PSA 36:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10" />Foo domin nafatin ba ema nebee mak konhese Ita Boot;</para>
  <para style="q2" vid="PSA 36:10">foo Ita Boot nia justisa ba ema nebee mak moris loos.<verse eid="PSA 36:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11" />Keta husik ema foti aan sira sama hau;</para>
  <para style="q2" vid="PSA 36:11">la bele husik ema aat sira nia liman duni lakon hau.<verse eid="PSA 36:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12" />Haree ba, ema aat sira nee monu oinsaa;</para>
  <para style="q2" vid="PSA 36:12">sira monu tuun ba rai too la bele hamriik fali!<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="s">Keta laran moras ba ema aat</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1" />Keta preokupa ho ema aat sira;</para>
  <para style="q2" vid="PSA 37:1">keta laran moras ba ema nebee halo sala.<verse eid="PSA 37:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2" />Tanba sira hanesan duut nebee fasil namlaik;</para>
  <para style="q2" vid="PSA 37:2">sira sei mate hanesan ai matak nebee la kleur maran tiha.<verse eid="PSA 37:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3" />Fiar ba NAI Maromak no halo buat nebee diak;</para>
  <para style="q2" vid="PSA 37:3">hela iha rai nee ho hakmatek.<verse eid="PSA 37:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4" />Buka o nia ksolok husi NAI</para>
  <para style="q2" vid="PSA 37:4">mak Nia sei foo buat nebee o nia laran hakarak.<verse eid="PSA 37:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5" />Entrega o nia moris ba NAI Maromak;</para>
  <para style="q2" vid="PSA 37:5">fiar ba Nia mak Nia sei halo ida nee ba o:<verse eid="PSA 37:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6" />Nia sei leno sai o nia hahalok loos</para>
  <para style="q2" vid="PSA 37:6">hanesan loro matan dadeer nian leno rai;</para>
  <para style="q1" vid="PSA 37:6">ema sei haree katak o nee loos hela,</para>
  <para style="q2" vid="PSA 37:6">hanesan ema haree loro matan meudia nian.<verse eid="PSA 37:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7" />Hakmatek iha NAI Maromak nia oin ba;</para>
  <para style="q2" vid="PSA 37:7">pasiensia hodi hein Nia.</para>
  <para style="q1" vid="PSA 37:7">Keta preokupa ema nia planu aat;</para>
  <para style="q2" vid="PSA 37:7">lalika laran susar bainhira ema aat hetan moris diak.<verse eid="PSA 37:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8" />Hadook aan husi hirus, keta laran nakali;</para>
  <para style="q2" vid="PSA 37:8">lalika preokupa, nee sei lori o ba dalan aat.<verse eid="PSA 37:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9" />Tanba ema aat sei lakon mohu,</para>
  <para style="q2" vid="PSA 37:9">maibee ema nebee laran metin ba NAI Maromak, sira sei hela nafatin iha rai nee.<verse eid="PSA 37:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10" />La kleur tan, ema aat sira nee sei mohu tiha;</para>
  <para style="q2" vid="PSA 37:10">o buka sira mos la hetan.<verse eid="PSA 37:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">37:11 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:5">Mateus 5:5</ref>
      </char>
    </note>Maibee ema nebee haraik aan sei hela metin iha rai nee;</para>
  <para style="q2" vid="PSA 37:11">sira sei moris haksolok iha pas ho hakmatek nia laran.<verse eid="PSA 37:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12" />Ema aat halo planu foer hasoru ema nebee moris loos</para>
  <para style="q2" vid="PSA 37:12">hodi ruun nehan ba sira.<verse eid="PSA 37:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13" />Maibee NAI Maromak hamnasa fali ema aat sira nee,</para>
  <para style="q2" vid="PSA 37:13">tanba Nia hatene katak sira nia loron besik ona.<verse eid="PSA 37:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14" />Ema aat losu sai sira nia surik</para>
  <para style="q2" vid="PSA 37:14">no dada sira nia rama</para>
  <para style="q1" vid="PSA 37:14">atu hamonu ema kiak ho kbiit-laek sira,</para>
  <para style="q2" vid="PSA 37:14">atu hamate ema nebee lao tuir dalan loos.<verse eid="PSA 37:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15" />Maibee sira nia surik sei sona borus fali sira nia fuan rasik;</para>
  <para style="q2" vid="PSA 37:15">sira nia rama sei silu tohar.<verse eid="PSA 37:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16" />Diak liu moris loos ho sasaan uitoan deit</para>
  <para style="q2" vid="PSA 37:16">duke sai ema aat ho riku-soin barak.<verse eid="PSA 37:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17" />Tanba ema aat sira nia liman sei silu tohar,</para>
  <para style="q2" vid="PSA 37:17">maibee NAI Maromak tane ema nebee moris loos.<verse eid="PSA 37:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18" />NAI Maromak tau matan ba ema laran moos;</para>
  <para style="q2" vid="PSA 37:18">rai nebee Nia foo ba sira sai sira nian nafatin ba nafatin.<verse eid="PSA 37:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19" />Iha tempu susar, sira laos mes-mesak;</para>
  <para style="q2" vid="PSA 37:19">rai hamlaha, sira hetan hahaan too bosu.<verse eid="PSA 37:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20" />Maibee ema aat sei mate mohu.</para>
  <para style="q2" vid="PSA 37:20">NAI Maromak nia inimigu hanesan ai funan iha rai fuik;</para>
  <para style="q2" vid="PSA 37:20">sira sei mohu, sei mohu lakon hanesan ahi suar.<verse eid="PSA 37:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21" />Ema aat empresta, la foo fila,</para>
  <para style="q2" vid="PSA 37:21">maibee ema nebee moris loos gosta foo ba ema.<verse eid="PSA 37:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22" />Ema nebee NAI Maromak foo bensaun, sira sei hela metin iha rai nee,</para>
  <para style="q2" vid="PSA 37:22">maibee ema nebee Maromak foo malisan, sei lakon mohu.<verse eid="PSA 37:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23" />Ema nebee halo haksolok NAI Maromak nia laran,</para>
  <para style="q2" vid="PSA 37:23">Maromak sei hatudu dalan ba nia.<verse eid="PSA 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24" />Maski nia sidi maibee nia la monu,</para>
  <para style="q2" vid="PSA 37:24">tanba NAI kaer metin nia liman.<verse eid="PSA 37:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25" />Hori uluk hau sei joven too agora hau katuas ona,</para>
  <para style="q2" vid="PSA 37:25">hau seidauk haree Maromak husik ema laran moos moris mesak;</para>
  <para style="q2" vid="PSA 37:25">hau seidauk haree sira nia oan sira tane liman hodi husu hahaan ba ema.<verse eid="PSA 37:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26" />Sira foo ho laran luak no sempre prontu foo sasaan ba ema empresta;</para>
  <para style="q2" vid="PSA 37:26">sira nia oan sira sai bensaun ba ema.<verse eid="PSA 37:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27" />Fila kotuk ba buat aat hodi halo buat diak,</para>
  <para style="q2" vid="PSA 37:27">nunee o sei hela iha rai nee tinan ba tinan.<verse eid="PSA 37:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28" />Tanba NAI Maromak gosta justisa;</para>
  <para style="q2" vid="PSA 37:28">ema nebee foo laran ba Nia, Nia nunka husik mesak.</para>
  <para style="b" vid="PSA 37:28" />
  <para style="q1" vid="PSA 37:28">Ema aat sira sei rahun hotu;</para>
  <para style="q2" vid="PSA 37:28">sira nia jerasaun sei lakon mohu.<verse eid="PSA 37:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29" />Ema moris loos sei hela metin iha rai nee;</para>
  <para style="q2" vid="PSA 37:29">sira sei horik iha rai nee tinan ba tinan.<verse eid="PSA 37:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30" />Ema moris loos nia ibun foo sai buat matenek nian;</para>
  <para style="q2" vid="PSA 37:30">nia nanaal hatete buat nebee loos.<verse eid="PSA 37:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31" />Nia rai Maromak nia lei iha nia laran;</para>
  <para style="q2" vid="PSA 37:31">nia ain sei la sidi.<verse eid="PSA 37:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32" />Ema aat hafuhu ema moris loos</para>
  <para style="q2" vid="PSA 37:32">hodi buka dalan atu oho sira.<verse eid="PSA 37:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33" />Maibee NAI Maromak sei la husik sira iha ema aat nia liman laran;</para>
  <para style="q2" vid="PSA 37:33">ema lori sira too iha tribunal mos, Maromak la husik juis hamonu kastigu ba sira.<verse eid="PSA 37:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34" />Laran metin ba NAI Maromak;</para>
  <para style="q2" vid="PSA 37:34">lao tuir nafatin Nia dalan.</para>
  <para style="q1" vid="PSA 37:34">Nia sei foti o hela metin iha rai nee;</para>
  <para style="q2" vid="PSA 37:34">bainhira ema aat mohu hotu, o sei haree.<verse eid="PSA 37:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35" />Hau haree ona ema aat sira hanehan ema;</para>
  <para style="q2" vid="PSA 37:35">ema aat sira nee moris buras hanesan ai huun boot.<verse eid="PSA 37:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36" />Maibee hau liu tan husi nebaa, sira la iha tiha ona;</para>
  <para style="q2" vid="PSA 37:36">maski hau buka sira, la hetan tan.<verse eid="PSA 37:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37" />Hateke ba ema nebee laran moos; haree ba ema nebee moris loos.</para>
  <para style="q2" vid="PSA 37:37">Tanba ema nebee mak buka dame sei hetan futuru nebee diak.<verse eid="PSA 37:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38" />Maibee sala nain sira sei mate mohu;</para>
  <para style="q2" vid="PSA 37:38">ema aat sira nia futuru sei la iha.<verse eid="PSA 37:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39" />NAI Maromak mak salva ema nebee moris loos;</para>
  <para style="q2" vid="PSA 37:39">iha tempu susar, Nia mak sira nia subar fatin.<verse eid="PSA 37:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40" />NAI tulun sira hodi lori sira sai;</para>
  <para style="q2" vid="PSA 37:40">Nia hasai sira husi ema aat hodi salva sira,</para>
  <para style="q2" vid="PSA 37:40">tanba sira buka mahon iha Nia.<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="s">Ema moras halerik husu tulun</para>
  <para style="d">Salmu David nian, husu Maromak atu hanoin nia.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1" />NAI Maromak, maski Ita Boot hirus hela hau, maibee keta siak hau;</para>
  <para style="q2" vid="PSA 38:1">maski Ita Boot nia laran nakali hela, maibee keta kastigu hau.<verse eid="PSA 38:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2" />Ita Boot nia rama oan tama ona hau nia isin;</para>
  <para style="q2" vid="PSA 38:2">Ita Boot nia liman hanehan hela hau.<verse eid="PSA 38:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3" />Ita Boot nia laran nakali halo hau nia isin sai moras hotu;</para>
  <para style="q2" vid="PSA 38:3">hau nia sala halo hau nia isin lolon tomak sai fraku tiha.<verse eid="PSA 38:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4" />Hau mout tiha iha hau nia hahalok aat nia laran;</para>
  <para style="q2" vid="PSA 38:4">hau senti hau nia sala todan liu ona.<verse eid="PSA 38:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5" />Hau nia hahalok beik</para>
  <para style="q2" vid="PSA 38:5">halo hau nia kanek sai dodok dois.<verse eid="PSA 38:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6" />Hau hakruuk too bonko;</para>
  <para style="q2" vid="PSA 38:6">loro-loron hau laran susar hela deit.<verse eid="PSA 38:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7" />Isin manas sunu hau nia aan tomak;</para>
  <para style="q2" vid="PSA 38:7">hau nia isin sai moras hotu.<verse eid="PSA 38:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8" />Hau la bele liu ona; hau nia forsa mohu ona;</para>
  <para style="q2" vid="PSA 38:8">hau laran dodok hodi halerik.<verse eid="PSA 38:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9" />Nai Maromak, Ita Boot hatene hotu hau nia hakarak;</para>
  <para style="q2" vid="PSA 38:9">Ita Boot rona hau nia halerik.<verse eid="PSA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10" />Hau nia fuan nakdedar; hau nia forsa la iha ona;</para>
  <para style="q2" vid="PSA 38:10">hau nia matan sai malahuk tiha ona.<verse eid="PSA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11" />Hau nia belun sira ho maluk sira lakohi besik hau tanba hau nia kanek,</para>
  <para style="q2" vid="PSA 38:11">too hau nia familia sira mos hamriik husi dook deit.<verse eid="PSA 38:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12" />Ema nebee hakarak oho hau monta lasu mai hau;</para>
  <para style="q2" vid="PSA 38:12">ema nebee hakarak halo terus hau kombina malu atu hamonu hau;</para>
  <para style="q2" vid="PSA 38:12">loro-loron sira halo manobra tuun-sae.<verse eid="PSA 38:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13" />Hau hanesan fali ema tilun diuk, la bele rona buat ida;</para>
  <para style="q2" vid="PSA 38:13">hau hanesan ema monok, la hatene koalia.<verse eid="PSA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14" />Hau hanesan ema nebee la rona buat ida;</para>
  <para style="q2" vid="PSA 38:14">hau hanesan ema nebee la bele foo resposta.<verse eid="PSA 38:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15" />NAI Maromak, hau hein hela Ita Boot;</para>
  <para style="q2" vid="PSA 38:15">Nai, hau nia Maromak, Ita Boot sei hataan hau,<verse eid="PSA 38:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16" />tanba hau husu tiha ona ba Ita Boot dehan,</para>
  <para style="q2" vid="PSA 38:16">“Keta husik sira haksolok fali ho hau nia terus</para>
  <para style="q2" vid="PSA 38:16">ka foti aan hasoru hau bainhira hau monu.”<verse eid="PSA 38:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17" />Hau besik atu monu;</para>
  <para style="q2" vid="PSA 38:17">hau terus la hotu.<verse eid="PSA 38:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18" />Hau foo sai hau nia sala;</para>
  <para style="q2" vid="PSA 38:18">hau nia hahalok aat halo hau la hakmatek.<verse eid="PSA 38:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19" />Hau nia inimigu sira mesak bo-boot deit;</para>
  <para style="q2" vid="PSA 38:19">iha ema barak teb-tebes odi hau, maski hau la halo buat aat ba sira.<verse eid="PSA 38:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20" />Hau nia hahalok diak, sira selu fali ho hahalok aat;</para>
  <para style="q2" vid="PSA 38:20">sira kontra hau tanba hau hakarak halo buat nebee diak.<verse eid="PSA 38:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21" />NAI Maromak, keta husik hau mesak;</para>
  <para style="q2" vid="PSA 38:21">hau nia Maromak, keta dook nafatin husi hau.<verse eid="PSA 38:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22" />Hau nia Nai, hau nia Salvador,</para>
  <para style="q2" vid="PSA 38:22">mai lalais hodi tulun hau.<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="s">Ita ema nia moris badak deit</para>
  <para style="d">Salmu David nian, ba dirijenti koru Jedutun.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1" />Iha tempu ida hau dehan, “Hau sei kuidadu hau nia lalaok</para>
  <para style="q2" vid="PSA 39:1">atu hau nia ibun la bele koalia sala;</para>
  <para style="q1" vid="PSA 39:1">bainhira ema aat iha hela hau nia oin,</para>
  <para style="q2" vid="PSA 39:1">hau sei taka hau nia ibun.”<verse eid="PSA 39:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2" />Hau nonook deit,</para>
  <para style="q2" vid="PSA 39:2">la hatete buat ida; atu koalia buat diak mos lae.</para>
  <para style="q1" vid="PSA 39:2">Maski hau nonook, maibee hau nia laran susar ba beibeik;<verse eid="PSA 39:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 39:3" />hau nia fuan la hakmatek.</para>
  <para style="q1" vid="PSA 39:3">Hau hanoin hela, hau nia neon aumenta susar</para>
  <para style="q2" vid="PSA 39:3">too hau loke ibun hodi koalia:<verse eid="PSA 39:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4" />“NAI Maromak, foo hatene took mai hau kona ba hau nia destinu,</para>
  <para style="q2" vid="PSA 39:4">no hau moris too tinan hira;</para>
  <para style="q2" vid="PSA 39:4">foo hanoin mai hau katak, hau nia moris badak deit.<verse eid="PSA 39:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5" />Ita Boot halo hau nia tinan badak hanesan sasukat liman ida-rua deit.</para>
  <para style="q2" vid="PSA 39:5">Tuir Ita Boot haree, hau nia vida tomak hanesan buat malahuk ida,</para>
  <para style="q2" vid="PSA 39:5">hanesan fali anin nebee huu liu deit.<verse eid="PSA 39:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6" />Loos duni, ema kriatura hanesan lalatak nebee liu ona;</para>
  <para style="q2" vid="PSA 39:6">sira moris fadigadu hela hodi rai riku-soin,</para>
  <para style="q1" vid="PSA 39:6">maibee saugati deit;</para>
  <para style="q2" vid="PSA 39:6">sira la hatene aban-bainrua see mak atu hetan riku-soin nee.<verse eid="PSA 39:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7" />Nai Maromak, agora hau hein tan saida?</para>
  <para style="q2" vid="PSA 39:7">Hau laran metin ba Ita Boot.<verse eid="PSA 39:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8" />Hasai hau husi hau nia hahalok aat hotu;</para>
  <para style="q2" vid="PSA 39:8">keta husik ema beik hamnasa fali hau.<verse eid="PSA 39:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9" />Hau nonook, la loke hau nia ibun,</para>
  <para style="q2" vid="PSA 39:9">tanba Ita Boot rasik mak halo ida nee mai hau.<verse eid="PSA 39:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10" />Hasai tiha Ita Boot nia kastigu husi hau;</para>
  <para style="q2" vid="PSA 39:10">hau la bele ona, tanba Ita Boot nia liman baku hela hau.<verse eid="PSA 39:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11" />Bainhira Ita Boot siak ema</para>
  <para style="q2" vid="PSA 39:11">hodi kastigu nia tanba nia sala,</para>
  <para style="q1" vid="PSA 39:11">Ita Boot estraga tiha nia riku-soin hanesan fali ular mak haan.</para>
  <para style="q2" vid="PSA 39:11">Loos duni, ema hotu-hotu nia moris hanesan anin nebee huu liu deit.<verse eid="PSA 39:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12" />NAI Maromak, rona hau nia orasaun;</para>
  <para style="q2" vid="PSA 39:12">see tilun mai hau nia halerik husu tulun;</para>
  <para style="q2" vid="PSA 39:12">keta fila kotuk ba hau nia matan been.</para>
  <para style="q1" vid="PSA 39:12">Tanba hau iha nee hanesan Ita Boot nia bainaka ida;</para>
  <para style="q2" vid="PSA 39:12">hau ema lao rai hanesan hau nia bei-ala sira.<verse eid="PSA 39:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13" />Hasees tiha Ita Boot nia oin husi hau,</para>
  <para style="q2" vid="PSA 39:13">atu hau bele kontenti fali</para>
  <para style="q2" vid="PSA 39:13">molok hau baa no la iha tan.”<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="s">Orasaun agradese no husu tulun</para>
  <para style="d">Salmu David nian, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1" />Hau hein NAI Maromak ho pasiensia;</para>
  <para style="q2" vid="PSA 40:1">too ikus Nia fila oin mai hau hodi rona hau nia halerik.<verse eid="PSA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2" />Nia foti hau sai husi rai kuak perigu nian;</para>
  <para style="q2" vid="PSA 40:2">Nia hasai hau husi tahu boot nia laran.</para>
  <para style="q1" vid="PSA 40:2">Nia tau hau nia ain iha fatuk leten</para>
  <para style="q2" vid="PSA 40:2">hodi foo fatin seguru atu hau hamriik metin.<verse eid="PSA 40:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3" />Nia tau knananuk foun iha hau nia ibun,</para>
  <para style="q2" vid="PSA 40:3">kantiku hodi hahii ita nia Maromak.</para>
  <para style="q1" vid="PSA 40:3">Ema barak sei haree;</para>
  <para style="q2" vid="PSA 40:3">sira sei hamtauk NAI Maromak hodi konfia Nia.<verse eid="PSA 40:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4" />See mak konfia NAI Maromak,</para>
  <para style="q2" vid="PSA 40:4">see mak la sadere ba ema nebee foti aan,</para>
  <para style="q2" vid="PSA 40:4">see mak la lao hamutuk ho ema nebee adora maromak falsu,</para>
  <para style="q2" vid="PSA 40:4">ema sira nee mak hetan ksolok.<verse eid="PSA 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5" />NAI, hau nia Maromak,</para>
  <para style="q2" vid="PSA 40:5">Ita Boot halo tiha ona buat furak barak mai ami;</para>
  <para style="q2" vid="PSA 40:5">Ita Boot nia planu ba ami nia moris mos boot.</para>
  <para style="q1" vid="PSA 40:5">La iha ida mak hanesan Ita Boot;</para>
  <para style="q2" vid="PSA 40:5">hau atu konta sai buat nebee Ita Boot halo,</para>
  <para style="q2" vid="PSA 40:5">barak teb-tebes, hau sura la bele.<verse eid="PSA 40:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">40:6 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 10:5-7">Ebreu 10:5-7</ref>
      </char>
    </note>Ita Boot nia hakarak laos atu ema lori oferta no oho animal sai sakrifisiu ba Ita Boot;</para>
  <para style="q2" vid="PSA 40:6">Ita Boot la presiza animal nebee ema tunu halo sakrifisiu.</para>
  <para style="q1" vid="PSA 40:6">Ita Boot la husu sakrifisiu nebee ema foo hodi husu perdaun,</para>
  <para style="q2" vid="PSA 40:6">maibee Ita Boot loke ona hau nia tilun.<verse eid="PSA 40:6" /></para>
  <para style="q1">
    <verse number="7-8" style="v" sid="PSA 40:7-8" />Entaun hau dehan, “Maromak, hau mak nee, hau mai ona.</para>
  <para style="q2" vid="PSA 40:7-8">Hau gosta teb-tebes halo tuir Ita Boot nia hakarak,</para>
  <para style="q1" vid="PSA 40:7-8">hanesan hakerek ona kona ba hau iha Livru Sagradu.</para>
  <para style="q2" vid="PSA 40:7-8">Ita Boot nia lei iha hela hau nia laran.”<verse eid="PSA 40:7-8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9" />NAI Maromak, hau foo sai tiha ona iha povu nia leet katak</para>
  <para style="q2" vid="PSA 40:9">Ita Boot salva ami.</para>
  <para style="q1" vid="PSA 40:9">Ita Boot hatene katak</para>
  <para style="q2" vid="PSA 40:9">hau la taka hau nia ibun.<verse eid="PSA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10" />Hau la subar Ita Boot nia lia loos iha hau nia laran;</para>
  <para style="q2" vid="PSA 40:10">hau koalia sai katak Ita Boot sempre foo laran ba Ita Boot nia povu, Ita Boot mak Salvador.</para>
  <para style="q1" vid="PSA 40:10">Hau la taka ba ema lubuk boot katak,</para>
  <para style="q2" vid="PSA 40:10">Ita Boot sempre hadomi Ita Boot nia povu no kaer metin Ita Boot nia liafuan.<verse eid="PSA 40:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11" />NAI Maromak, keta taka Ita Boot nia laran luak mai hau;</para>
  <para style="q2" vid="PSA 40:11">halo Ita Boot nia domin ho Ita Boot nia lia loos hamahon hau nafatin.<verse eid="PSA 40:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12" />Tanba susar nebee haleu hau barak teb-tebes, hau sura la bele;</para>
  <para style="q2" vid="PSA 40:12">hau nia sala butuk aas liu ona, halo hau la haree rai;</para>
  <para style="q1" vid="PSA 40:12">hau nia sala barak liu fali hau nia fuuk lahan;</para>
  <para style="q2" vid="PSA 40:12">hau nia forsa la iha tiha.<verse eid="PSA 40:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13" />NAI Maromak, favor salva hau;</para>
  <para style="q2" vid="PSA 40:13">NAI, mai lalais tulun hau ba.<verse eid="PSA 40:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14" />Hau harohan atu ema hotu nebee hakarak hasai hau nia vida</para>
  <para style="q2" vid="PSA 40:14">moe boot ho oin tuun;</para>
  <para style="q1" vid="PSA 40:14">husik ema nebee hakarak atu hau hetan dezastre</para>
  <para style="q2" vid="PSA 40:14">hakiduk ho naran aat.<verse eid="PSA 40:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15" />Husik ema nebee hamnasa hahaek mai hau</para>
  <para style="q2" vid="PSA 40:15">sai moe boot too bilaan tiha.<verse eid="PSA 40:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16" />Maibee halo ema hotu nebee harohan ba Ita Boot</para>
  <para style="q2" vid="PSA 40:16">sai kontenti ho haksolok;</para>
  <para style="q1" vid="PSA 40:16">husik ema nebee buka Ita Boot nia salvasaun dehan beibeik,</para>
  <para style="q2" vid="PSA 40:16">“NAI Maromak nee boot!”<verse eid="PSA 40:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17" />Hau nee ema kiak ho kbiit-laek,</para>
  <para style="q2" vid="PSA 40:17">maibee Nai Maromak hanoin hau.</para>
  <para style="q1" vid="PSA 40:17">Ita Boot mak tulun hau no salva hau;</para>
  <para style="q2" vid="PSA 40:17">hau nia Maromak, keta demora.<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="s">Orasaun husu Nai Maromak atu kura moras</para>
  <para style="d">Salmu David nian, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1" />Ema nebee konsidera ema kiik, sira hetan ksolok;</para>
  <para style="q2" vid="PSA 41:1">bainhira sira iha susar laran, NAI Maromak salva sira.<verse eid="PSA 41:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2" />NAI foo mahon ba sira hodi kuidadu sira;</para>
  <para style="q2" vid="PSA 41:2">sira moris haksolok iha rai nee.</para>
  <para style="q2" vid="PSA 41:2">Nia la husik sira monu iha sira nia inimigu nia liman laran.<verse eid="PSA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3" />Bainhira sira moras iha sira nia toba fatin, NAI tau matan ba sira</para>
  <para style="q2" vid="PSA 41:3">hodi foo fali isin diak ba sira.<verse eid="PSA 41:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4" />Uluk hau harohan nunee: “NAI Maromak, hanoin hau ba!</para>
  <para style="q2" vid="PSA 41:4">Hau halo sala kontra Ita Boot; kura hau ba.”<verse eid="PSA 41:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5" />Hau nia inimigu sira hatete aat hau dehan,</para>
  <para style="q2" vid="PSA 41:5">“Bainhira mak nia mate, atu nia naran la temi tan?”<verse eid="PSA 41:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6" />Kuandu sira ida mai haree hau,</para>
  <para style="q2" vid="PSA 41:6">sira finji koalia diak mai hau,</para>
  <para style="q1" vid="PSA 41:6">maibee sira nia laran hakarak buka hatene hau nia susar,</para>
  <para style="q2" vid="PSA 41:6">depois sira sai baa konta iha fat-fatin.<verse eid="PSA 41:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7" />Ema nebee odi hau bis-bisu ba malu kona ba hau;</para>
  <para style="q2" vid="PSA 41:7">sira hanoin buat aat mai hau dehan,<verse eid="PSA 41:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8" />“Moras aat kona ona nia;</para>
  <para style="q2" vid="PSA 41:8">atu hamriik tan husi nia toba fatin mos la bele ona.”<verse eid="PSA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">41:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:23">Mateus 26:23</ref>; <ref loc="MRK 14:18">Marcos 14:18</ref>; <ref loc="LUK 22:21">Lucas 22:21</ref>; <ref loc="JHN 13:18">João 13:18</ref></char>
    </note>Maski hau nia belun diak,</para>
  <para style="q2" vid="PSA 41:9">hau konfia loos nia,</para>
  <para style="q1" vid="PSA 41:9">nia tuur haan hamutuk ho hau,</para>
  <para style="q2" vid="PSA 41:9">nia sai fali hau nia inimigu.<verse eid="PSA 41:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10" />NAI Maromak, hanoin hau ba;</para>
  <para style="q2" vid="PSA 41:10">foti sae hau, nunee hau bele selu fali sira.<verse eid="PSA 41:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11" />Hau hatene katak Ita Boot nia laran haksolok ho hau,</para>
  <para style="q2" vid="PSA 41:11">tanba hau nia inimigu la manaan hau.<verse eid="PSA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12" />Ita Boot tulun hau tanba hau nia laran moos;</para>
  <para style="q2" vid="PSA 41:12">Ita Boot hatuur hau iha Ita Boot nia oin too tinan ba tinan.<verse eid="PSA 41:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">41:13 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:48">Salmu 106:48</ref>
      </char>
    </note>Hahii NAI, Israel nia Maromak,</para>
  <para style="q2" vid="PSA 41:13">nafatin ba nafatin.</para>
  <para style="q1" vid="PSA 41:13">Amen, amen.<verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="s">Hamrook buka Nai Maromak</para>
  <para style="d">Salmu husi Korá nia oan para hanorin ema. Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1" />Hanesan rusa hamrook teb-tebes atu hemu bee mota nian,</para>
  <para style="q2" vid="PSA 42:1">nunee mos hau hamrook teb-tebes ba Ita Boot, hau nia Maromak.<verse eid="PSA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2" />Hau hamrook ba Ita Boot, Maromak Moris.</para>
  <para style="q2" vid="PSA 42:2">Bainhira loos mak hau baa too iha Ita Boot nia oin?<verse eid="PSA 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3" />Loron-kalan matan been mak sai fali hau nia hahaan,</para>
  <para style="q2" vid="PSA 42:3">tanba loron tomak ema hatete mai hau dehan,</para>
  <para style="q2" vid="PSA 42:3">“O nia Maromak iha nebee?”<verse eid="PSA 42:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4" />Hau nia laran susar;</para>
  <para style="q2" vid="PSA 42:4">hau hanoin hetan</para>
  <para style="q1" vid="PSA 42:4">uluk hau baa iha Maromak nia uma,</para>
  <para style="q2" vid="PSA 42:4">iha Kbiit Nain nia mahon.</para>
  <para style="q1" vid="PSA 42:4">Hau hamutuk ho ema lubun boot</para>
  <para style="q2" vid="PSA 42:4">haklalak haksolok hahii Maromak.<verse eid="PSA 42:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5" />Hau husu ba hau nia aan,</para>
  <para style="q2" vid="PSA 42:5">“Tansaa mak o tristi?</para>
  <para style="q2" vid="PSA 42:5">Tansaa mak o nia laran la hakmatek?”</para>
  <para style="q1" vid="PSA 42:5">Laran metin ba Maromak ba,</para>
  <para style="q2" vid="PSA 42:5">tanba hau sei hahii fila fali Nia,</para>
  <para style="q2" vid="PSA 42:5">hau nia Salvador ho hau nia Maromak.<verse eid="PSA 42:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6" />Hau nia laran tristi teb-tebes;</para>
  <para style="q2" vid="PSA 42:6">tanba nee, husi rai Jordaun nian nee,</para>
  <para style="q1" vid="PSA 42:6">husi foho Hermon nia tutun, husi foho Mizar,</para>
  <para style="q2" vid="PSA 42:6">hau hanoin Ita Boot.<verse eid="PSA 42:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7" />Ita Boot nia mota tuun ho lian makaas</para>
  <para style="q2" vid="PSA 42:7">too bee boot mos tarutu simu malu iha fat-fatin.</para>
  <para style="q2" vid="PSA 42:7">Ita Boot nia laloran nadodon mai, halo mout tiha hau.<verse eid="PSA 42:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8" />Iha loron, NAI Maromak hatudu Nia domin rohan-laek;</para>
  <para style="q2" vid="PSA 42:8">iha kalan, hau hananu ba Nia,</para>
  <para style="q2" vid="PSA 42:8">hanesan orasaun ida ba Maromak, hau nia moris huun.<verse eid="PSA 42:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9" />Maromak mak fatuk kuak boot nebee hau subar iha laran.</para>
  <para style="q2" vid="PSA 42:9">Hau hatete ba Nia,</para>
  <para style="q1" vid="PSA 42:9">“Tansaa mak Ita Boot haluha hau?</para>
  <para style="q2" vid="PSA 42:9">Tansaa mak hau nia inimigu hanehan hau</para>
  <para style="q2" vid="PSA 42:9">too hau moris halerik nunee?”<verse eid="PSA 42:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10" />Hau nia inimigu hamoe hau,</para>
  <para style="q2" vid="PSA 42:10">halo hau nia ruin sira rahun tiha.</para>
  <para style="q1" vid="PSA 42:10">Loron tomak sira hatete mai hau dehan,</para>
  <para style="q2" vid="PSA 42:10">“O nia Maromak iha nebee?”<verse eid="PSA 42:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11" />Hau husu ba hau nia aan,</para>
  <para style="q2" vid="PSA 42:11">“Tansaa mak o tristi?</para>
  <para style="q2" vid="PSA 42:11">Tansaa mak o nia laran la hakmatek?”</para>
  <para style="q1" vid="PSA 42:11">Laran metin ba Maromak ba,</para>
  <para style="q2" vid="PSA 42:11">tanba hau sei hahii fila fali Nia,</para>
  <para style="q2" vid="PSA 42:11">hau nia Salvador ho hau nia Maromak.<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="s">Orasaun halerik iha ema nia rain</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1" />Hau nia Maromak, tesi hau nia lia ba hodi deklara katak hau la sala;</para>
  <para style="q2" vid="PSA 43:1">defende hau kontra nasaun nebee la fiar Ita Boot;</para>
  <para style="q2" vid="PSA 43:1">salva hau husi ema sira nebee laran aat ho bosok-teen.<verse eid="PSA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2" />Tanba Ita Boot mak Maromak, hau nia subar fatin.</para>
  <para style="q2" vid="PSA 43:2">Tansaa mak Ita Boot soe hela hau?</para>
  <para style="q1" vid="PSA 43:2">Tansaa mak hau nia inimigu hanehan hau</para>
  <para style="q2" vid="PSA 43:2">too hau moris halerik nunee?<verse eid="PSA 43:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3" />Haruka Ita Boot nia naroman ho Ita Boot nia lia loos</para>
  <para style="q2" vid="PSA 43:3">hodi gia hau;</para>
  <para style="q1" vid="PSA 43:3">husik buat sira nee lori hau ba iha Ita Boot nia foho santu,</para>
  <para style="q2" vid="PSA 43:3">ba iha fatin nebee Ita Boot hela ba.<verse eid="PSA 43:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4" />Too iha nebaa, hau sei baa iha Maromak nia altar oin;</para>
  <para style="q2" vid="PSA 43:4">hau sei baa iha Maromak, hau nia ksolok nia huun.</para>
  <para style="q1" vid="PSA 43:4">Maromak, hau nia Maromak,</para>
  <para style="q2" vid="PSA 43:4">hau sei toka viola hodi hahii Ita Boot.<verse eid="PSA 43:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5" />Hau husu ba hau nia aan,</para>
  <para style="q2" vid="PSA 43:5">“Tansaa mak o tristi?</para>
  <para style="q2" vid="PSA 43:5">Tansaa mak o nia laran la hakmatek?”</para>
  <para style="q1" vid="PSA 43:5">Laran metin ba Maromak ba,</para>
  <para style="q2" vid="PSA 43:5">tanba hau sei hahii fila fali Nia,</para>
  <para style="q2" vid="PSA 43:5">hau nia Salvador ho hau nia Maromak.<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="s">Orasaun bainhira inimigu hanehan</para>
  <para style="d">Salmu husi Korá nia oan para hanorin ema. Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1" />Maromak, ami rona tiha ona ho ami nia tilun rasik;</para>
  <para style="q2" vid="PSA 44:1">ami nia bei-ala sira konta tiha ona mai ami</para>
  <para style="q1" vid="PSA 44:1">buat nebee Ita Boot halo iha sira nia tempu,</para>
  <para style="q2" vid="PSA 44:1">iha tempu uluk nian.<verse eid="PSA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2" />Ho Ita Boot nia liman, Ita Boot duni sai tiha nasaun jentiu sira</para>
  <para style="q2" vid="PSA 44:2">hodi tau fali ami nia bei-ala sira;</para>
  <para style="q1" vid="PSA 44:2">Ita Boot halo rahun tiha povu jentiu sira,</para>
  <para style="q2" vid="PSA 44:2">no halo ami nia bei-ala sira sai buras.<verse eid="PSA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3" />Sira laos uza sira nia surik mak hadau rai nee;</para>
  <para style="q2" vid="PSA 44:3">sira laos uza sira nia forsa rasik mak manaan,</para>
  <para style="q1" vid="PSA 44:3">maibee sira manaan tanba Ita Boot nia liman loos ho Ita Boot nia forsa,</para>
  <para style="q2" vid="PSA 44:3">ho mos Ita Boot nia oin nabilan,</para>
  <para style="q2" vid="PSA 44:3">tanba Ita Boot nia laran kontenti ho sira.<verse eid="PSA 44:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4" />Ita Boot mak hau nia Liurai ho hau nia Maromak;</para>
  <para style="q2" vid="PSA 44:4">Ita Boot deklara katak Jacó nia jerasaun sei manaan. <note caller="+" style="f"><char style="fr" closed="false">44:4 </char><char style="ft" closed="false">Jacó nia jerasaun mak povu Israel. </char></note><verse eid="PSA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5" />Ho Ita Boot nia kbiit ami duni sai ami nia inimigu sira;</para>
  <para style="q2" vid="PSA 44:5">ho Ita Boot nia naran ami sama ami nia funu baluk sira.<verse eid="PSA 44:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6" />Hau la tau hau nia fiar iha hau nia rama;</para>
  <para style="q2" vid="PSA 44:6">hau nia surik la halo hau manaan.<verse eid="PSA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7" />Maibee Ita Boot mak halo ami manaan ami nia inimigu sira;</para>
  <para style="q2" vid="PSA 44:7">Ita Boot halo moe ami nia funu baluk sira.<verse eid="PSA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8" />Iha loron tomak ami konta Ita Boot nia diak;</para>
  <para style="q2" vid="PSA 44:8">ami sei hahii Ita Boot nia naran nafatin ba nafatin.<verse eid="PSA 44:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9" />Maibee agora Ita Boot fila kotuk hodi hatuun fali ami;</para>
  <para style="q2" vid="PSA 44:9">Ita Boot la hamutuk tiha ona ho ami nia militar sira.<verse eid="PSA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10" />Ita Boot halo ami hakiduk iha ami nia inimigu sira nia oin;</para>
  <para style="q2" vid="PSA 44:10">ami nia funu baluk sira hadau tiha ami nia sasaan.<verse eid="PSA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11" />Ita Boot husik ema oho ami hanesan fali ema oho bibi;</para>
  <para style="q2" vid="PSA 44:11">sira halo ami namkari iha nasaun jentiu sira.<verse eid="PSA 44:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12" />Ita Boot faan Ita Boot nia povu ho folin baratu deit,</para>
  <para style="q2" vid="PSA 44:12">la interese atu husu folin diak nian.<verse eid="PSA 44:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13" />Ita Boot halo ami moe iha vizinhu sira nia oin;</para>
  <para style="q2" vid="PSA 44:13">ema nebee haleu ami hatete aat ami no hatuun ami.<verse eid="PSA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14" />Ita Boot halo ami sai naran aat iha nasaun jentiu sira nia leet;</para>
  <para style="q2" vid="PSA 44:14">estranjeiru sira doko ulun ba ami.<verse eid="PSA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15" />Loron-kalan hau senti hau nia naran sai foer tiha ona;</para>
  <para style="q2" vid="PSA 44:15">hau moe boot,<verse eid="PSA 44:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16" />tanba rona ema hatuun ami ho tarata ami,</para>
  <para style="q2" vid="PSA 44:16">no haree inimigu sira ho ema nebee odi ami.<verse eid="PSA 44:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17" />Buat hirak nee hotu mai iha ami nia leten,</para>
  <para style="q2" vid="PSA 44:17">afinal ami la haluha Ita Boot;</para>
  <para style="q2" vid="PSA 44:17">ami la kontra Ita Boot nia lei ho promesa.<verse eid="PSA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18" />Ami la fila kotuk ba Ita Boot;</para>
  <para style="q2" vid="PSA 44:18">ami la lao sees husi Ita Boot nia dalan.<verse eid="PSA 44:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19" />Maibee Ita Boot harahun tiha ami iha animal fuik nia hela fatin;</para>
  <para style="q2" vid="PSA 44:19">Ita Boot falun ami ho nakukun boot.<verse eid="PSA 44:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20" />Se karik ami haluha tiha ami nia Maromak nia naran</para>
  <para style="q2" vid="PSA 44:20">ka tane liman fali ba maromak seluk,<verse eid="PSA 44:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21" />Ita Boot hatene hela,</para>
  <para style="q2" vid="PSA 44:21">tanba Ita Boot hatene hotu ema nia segredu iha laran.<verse eid="PSA 44:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">44:22 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 8:36">Roma 8:36</ref>
      </char>
    </note>Loron-kalan ema buka dalan atu oho ami tanba ami tuir Ita Boot.</para>
  <para style="q2" vid="PSA 44:22">Sira haree ami hanesan bibi malae nebee mak sira atu oho.<verse eid="PSA 44:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23" />Nai Maromak, hadeer ona ba! Nusaa mak Ita Boot toba dukur?</para>
  <para style="q2" vid="PSA 44:23">Hamriik ba! Keta husik hela ami tinan ba tinan.<verse eid="PSA 44:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24" />Tansaa mak Ita Boot subar Ita Boot nia oin?</para>
  <para style="q2" vid="PSA 44:24">Tansaa Ita Boot haluha ami nia terus ho susar?<verse eid="PSA 44:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25" />Ami monu tuun tiha ona ba iha rai rahun;</para>
  <para style="q2" vid="PSA 44:25">ami monu taka rabat iha rai.<verse eid="PSA 44:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26" />Hamriik hodi tulun ami ba;</para>
  <para style="q2" vid="PSA 44:26">salva ami tanba Ita Boot nia domin rohan-laek.<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="s">Kantiku ba liurai nia festa kazamentu</para>
  <para style="d">Salmu husi Korá nia oan, para hanorin ema. Kantiku kazamentu nian, tuir muzika “Ai funan liriu.” Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1" />Hau nia laran nakonu ho liafuan murak;</para>
  <para style="q2" vid="PSA 45:1">hau nia ibun hanesan matenek nain nia lapizeira;</para>
  <para style="q2" vid="PSA 45:1">hau hakarak oferese hau nia poezia ba liurai.<verse eid="PSA 45:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2" />O mak bonitu liu ema hotu-hotu;</para>
  <para style="q2" vid="PSA 45:2">liafuan mesak furak sai husi o nia ibun;</para>
  <para style="q2" vid="PSA 45:2">Maromak foo bensaun ba o nafatin ba nafatin.<verse eid="PSA 45:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3" />Aswain, sikat o nia surik iha o nia kanotak;</para>
  <para style="q2" vid="PSA 45:3">hatudu sai o nia kbiit ho o nia furak!<verse eid="PSA 45:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4" />Uza o nia kbiit nee lao ba oin too manaan</para>
  <para style="q2" vid="PSA 45:4">hodi defende lia loos, hahalok haraik aan ho justisa;</para>
  <para style="q2" vid="PSA 45:4">uza o nia forsa hodi halo buat boot.<verse eid="PSA 45:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5" />Liurai, o nia rama oan kroat,</para>
  <para style="q2" vid="PSA 45:5">tama borus o nia inimigu sira nia fuan;</para>
  <para style="q2" vid="PSA 45:5">nasaun jentiu sira monu iha o nia ain okos.<verse eid="PSA 45:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">45:6 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 1:8">Ebreu 1:8</ref>,<ref loc="HEB 1:9">9</ref></char>
    </note>Nai,<note caller="+" style="f"><char style="fr" closed="false">45:6 </char><char style="ft" closed="false">Lian Ebreu dehan “Maromak”. </char></note> o sei ukun tinan ba tinan;</para>
  <para style="q2" vid="PSA 45:6">o sempre ukun o nia reinu ho lo-loos.<verse eid="PSA 45:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7" />O haksolok bainhira ema halo buat diak;</para>
  <para style="q2" vid="PSA 45:7">o hakribi hahalok aat.</para>
  <para style="q1" vid="PSA 45:7">Tanba nee, Nai o nia Maromak foti o aas liu o nia maluk sira;</para>
  <para style="q2" vid="PSA 45:7">Nia kose mina ba o nia ulun hodi halo o nia laran haksolok.<verse eid="PSA 45:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8" />O nia ropa hotu-hotu tau ai morin ho mina morin diak nian ho ai kameli;</para>
  <para style="q2" vid="PSA 45:8">o nia palasiu enfeita ho elefante nia nehan;</para>
  <para style="q2" vid="PSA 45:8">muzika viola nian halo kontenti o nia laran.<verse eid="PSA 45:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9" />Feto nebee hela iha o nia palasiu, balu raan liurai;</para>
  <para style="q2" vid="PSA 45:9">liurai nia noiva hatais osan mean husi rai Ofir hodi tuur iha o nia sorin loos.<verse eid="PSA 45:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10" />Liurai feto, rona mai, hanoin di-diak hodi see tilun;</para>
  <para style="q2" vid="PSA 45:10">haluha tiha o nia o nia povu ho o nia aman nia uma laran.<verse eid="PSA 45:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11" />O nia furak halo liurai gosta teb-tebes o;</para>
  <para style="q2" vid="PSA 45:11">nia mak o nia nai; hakruuk ba nia.<verse eid="PSA 45:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12" />Povu husi sidade Tiru sei mai foo prezenti;</para>
  <para style="q2" vid="PSA 45:12">ema riku sira iha povu nia leet sei buka manaan o nia laran.<verse eid="PSA 45:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13" />Liurai feto nee iha nia kuartu laran,</para>
  <para style="q2" vid="PSA 45:13">nia bonita teb-tebes.</para>
  <para style="q1" vid="PSA 45:13">Nia vestidu naruk enfeita ho osan mean;<verse eid="PSA 45:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 45:14" />nia hena kor oi-oin deit.</para>
  <para style="q1" vid="PSA 45:14">Ema lori nia ba iha liurai nia oin;</para>
  <para style="q2" vid="PSA 45:14">nia maluk feto raan sira akompanha nia husi kotuk.<verse eid="PSA 45:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15" />Ho kontenti ho haksolok,</para>
  <para style="q2" vid="PSA 45:15">sira hakat dadauk mai tama iha liurai nia palasiu.<verse eid="PSA 45:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16" />Liurai,<note caller="+" style="f"><char style="fr" closed="false">45:16 </char><char style="ft" closed="false">Lian Ebreu la temi “liurai”.</char></note> o sei iha oan mane hodi tuur iha o nia kadeira ukun;</para>
  <para style="q2" vid="PSA 45:16">o sei foti sira hodi ukun rai tomak.<verse eid="PSA 45:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17" />Hau sei foti aas o nia naran husi jerasaun ba jerasaun,</para>
  <para style="q2" vid="PSA 45:17">nunee nasaun hotu-hotu sei gaba o tinan ba tinan.<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="s">Nai Maromak Aswain hamutuk ho ita</para>
  <para style="d">Kantiku ida husi jerasaun Korá nian, tuir muzika Alamot. Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1" />Maromak mak foo mahon mai ita no foo forsa mai ita;</para>
  <para style="q2" vid="PSA 46:1">Nia sempre tulun ita iha susar laran.<verse eid="PSA 46:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2" />Tanba nee ita sei la tauk,</para>
  <para style="q2" vid="PSA 46:2">maski rai nakdoko</para>
  <para style="q2" vid="PSA 46:2">too foho naksobu tuun ba tasi klaran.<verse eid="PSA 46:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3" />Maski tasi siak nafurin sae</para>
  <para style="q2" vid="PSA 46:3">too laloran baku makaas halo foho nakdoko,</para>
  <para style="q2" vid="PSA 46:3">ita sei la nakdedar.<verse eid="PSA 46:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4" />Iha mota ida halo haksolok povu iha Maromak nia sidade,</para>
  <para style="q2" vid="PSA 46:4">Maromak Aas Liu hela iha fatin santu nee.<verse eid="PSA 46:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5" />Maromak iha fatin nee, nunee sidade nee sei la monu.</para>
  <para style="q2" vid="PSA 46:5">Dadeer-saan rai huun mutin, Maromak sei tulun sidade nee.<verse eid="PSA 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6" />Nasaun jentiu sira rungu-ranga, liurai sira nakdoko;</para>
  <para style="q2" vid="PSA 46:6">Maromak nia lian tarutu halo rai nabeen tiha.<verse eid="PSA 46:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7" />NAI Maromak Aswain hamutuk ho ita;</para>
  <para style="q2" vid="PSA 46:7">Jacó nia Maromak mak ita nia abrigu.<verse eid="PSA 46:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8" />Mai hodi haree saida mak NAI Maromak halo tiha ona.</para>
  <para style="q2" vid="PSA 46:8">Haree ba! Nia hatudu buat boot iha mundu.<verse eid="PSA 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9" />Nia hapara funu husi rai ulun too rai ikun iha mundu tomak.</para>
  <para style="q2" vid="PSA 46:9">Nia silu tohar tiha rama no halo rahun tiha diman.</para>
  <para style="q2" vid="PSA 46:9">Ai belar nebee ema uza hodi defende aan, Nia sunu tiha.<verse eid="PSA 46:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10" />Maromak dehan, “Hakmatek ba, no rekonhese katak Hau mak Maromak.</para>
  <para style="q2" vid="PSA 46:10">Ema iha nasaun hotu-hotu haboot Hau nia naran;</para>
  <para style="q2" vid="PSA 46:10">ema iha mundu tomak foti aas Hau nia naran.”<verse eid="PSA 46:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11" />NAI Maromak Aswain hamutuk ho ita;</para>
  <para style="q2" vid="PSA 46:11">Jacó nia Maromak mak ita nia abrigu.<verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="s">Nai Maromak Liurai boot</para>
  <para style="d">Salmu husi Korá nia oan, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1" />Povu husi nasaun hotu-hotu, basa liman ba;</para>
  <para style="q2" vid="PSA 47:1">haklalak hahii Maromak ho haksolok.<verse eid="PSA 47:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2" />Tanba NAI Maromak Kbiit Nain nee makaas;</para>
  <para style="q2" vid="PSA 47:2">Nia mak Liurai boot hodi ukun mundu tomak.<verse eid="PSA 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3" />Nia halo nasaun jentiu sira hakruuk mai ita;</para>
  <para style="q2" vid="PSA 47:3">Nia halo povu jentiu sira monu iha ita nia ain okos.<verse eid="PSA 47:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4" />Nia hili rai nee hodi foo ba ita povu Israel;<note caller="+" style="f"><char style="fr" closed="false">47:4 </char><char style="ft" closed="false">Lian Ebreu hakerek “Jacó”. Nee hatudu ba Jacó nia jerasaun, povu Israel. </char></note></para>
  <para style="q2" vid="PSA 47:4">Nia hadomi teb-tebes ita, ita mos kontenti ho rai nee.<verse eid="PSA 47:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5" />NAI Maromak sae dadauk baa tuur iha Nia kadeira ukun, povu haklalak;</para>
  <para style="q2" vid="PSA 47:5">NAI hakat sae, korneta lian akompanha Nia.<verse eid="PSA 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6" />Hananu hahii Maromak, hananu hahii ba Nia;</para>
  <para style="q2" vid="PSA 47:6">hananu hahii ba ita nia Liurai, hananu hahii ba,<verse eid="PSA 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7" />tanba Maromak nee mundu tomak nia Liurai;</para>
  <para style="q2" vid="PSA 47:7">hananu salmu hodi hahii Nia ba.<verse eid="PSA 47:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8" />Maromak ukun nasaun hotu-hotu;</para>
  <para style="q2" vid="PSA 47:8">Maromak tuur iha Nia kadeira ukun santu nian.<verse eid="PSA 47:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9" />Nai ulun nasaun sira nee halibur hamutuk</para>
  <para style="q2" vid="PSA 47:9">ho povu nebee Abraão nia Maromak hili nanis ona,</para>
  <para style="q1" vid="PSA 47:9">tanba liurai hotu-hotu iha mundu nee Maromak nian;</para>
  <para style="q2" vid="PSA 47:9">Nia mak boot liu hotu-hotu.<verse eid="PSA 47:9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="s">Jerusalém Nai Maromak nia sidade</para>
  <para style="d">Salmu husi Korá nia oan. Kantiku ida.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1" />NAI Maromak nee boot;</para>
  <para style="q2" vid="PSA 48:1">ita nia Maromak merese duni atu ita hahii</para>
  <para style="q1" vid="PSA 48:1">iha Nia sidade,</para>
  <para style="q2" vid="PSA 48:1">iha Nia foho santu.<verse eid="PSA 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">48:2 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:35">Mateus 5:35</ref>
      </char>
    </note>Foho nee aas ho furak,</para>
  <para style="q2" vid="PSA 48:2">halo haksolok mundu tomak.</para>
  <para style="q1" vid="PSA 48:2">Nee mak foho Siaun, iha liu parte norte,</para>
  <para style="q2" vid="PSA 48:2">Liurai boot nia sidade.<verse eid="PSA 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3" />Iha sidade nia moru laran,</para>
  <para style="q2" vid="PSA 48:3">Maromak hatudu ona katak Nia rasik mak defende sidade nee.<verse eid="PSA 48:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4" />Liurai nasaun sel-seluk halibur sira nia tropas;</para>
  <para style="q2" vid="PSA 48:4">sira hamutuk avansa ba oin.<verse eid="PSA 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5" />Bainhira sira haree sidade nee, sira hakfodak;</para>
  <para style="q2" vid="PSA 48:5">sira tauk hodi halai.<verse eid="PSA 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6" />Iha nebaa, sira nakdedar makaas;</para>
  <para style="q2" vid="PSA 48:6">sira terus hanesan feto nebee atu tuur ahi;<verse eid="PSA 48:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="PSA 48:7" />sira hanesan roo Tarsis nebee anin lorosae riba tuun-sae.<verse eid="PSA 48:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8" />Uluk ita rona tiha ona;</para>
  <para style="q2" vid="PSA 48:8">agora ita mos haree ona</para>
  <para style="q1" vid="PSA 48:8">iha NAI Maromak Aswain nia sidade,</para>
  <para style="q2" vid="PSA 48:8">iha ita nia Maromak nia sidade.</para>
  <para style="q1" vid="PSA 48:8">Maromak harii metin sidade nee too tinan ba tinan.<verse eid="PSA 48:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9" />Maromak, iha Ita Boot nia uma kreda,</para>
  <para style="q2" vid="PSA 48:9">ami medita Ita Boot nia domin rohan-laek.<verse eid="PSA 48:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10" />Maromak, ema iha fat-fatin temi Ita Boot nia naran,</para>
  <para style="q2" vid="PSA 48:10">too ema husi rai ulun rai ikun iha mundu tomak mos hahii Ita Boot;</para>
  <para style="q2" vid="PSA 48:10">Ita Boot nia liman loos nakonu ho justisa.<verse eid="PSA 48:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11" />Foho Siaun haksolok;</para>
  <para style="q2" vid="PSA 48:11">Judá oan sira kontenti</para>
  <para style="q2" vid="PSA 48:11">tanba Ita Boot nia justisa.<verse eid="PSA 48:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12" />Lao haleu Siaun, hadulas sidade nee tomak;</para>
  <para style="q2" vid="PSA 48:12">sura took nia tore aas;<verse eid="PSA 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13" />fihir di-diak sidade nia moru;</para>
  <para style="q2" vid="PSA 48:13">sukat moru nia aas no mahar,</para>
  <para style="q1" vid="PSA 48:13">atu nunee o bele konta ba jerasaun tuir mai katak,<verse eid="PSA 48:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14" />Maromak nee mak ita nia Maromak nafatin ba nafatin;</para>
  <para style="q2" vid="PSA 48:14">Nia sai ita nia matadalan too tinan ba tinan.<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="s">Konfia riku-soin la iha folin</para>
  <para style="d">Salmu husi Korá nia oan, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1-2" style="v" sid="PSA 49:1-2" />Imi husi nasaun hotu-hotu, rona mai!</para>
  <para style="q1" vid="PSA 49:1-2">Kiik ho boot, riku ho kiak,</para>
  <para style="q2" vid="PSA 49:1-2">hotu-hotu nebee moris iha mundu, see tilun mai.<verse eid="PSA 49:1-2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3" />Hau nia ibun sei koalia buat matenek;</para>
  <para style="q2" vid="PSA 49:3">buat nebee hau nia laran medita sei halo imi kompriende.<verse eid="PSA 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4" />Hau sei see tilun ba lia matenek nian;</para>
  <para style="q2" vid="PSA 49:4">hau sei toka viola hodi esplika lia matenek nee.<verse eid="PSA 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5" />Iha loron dezastre,</para>
  <para style="q2" vid="PSA 49:5">bainhira ema aat haleu hau, hau atu tauk saida?<verse eid="PSA 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6" />Sira nee konfia sira nia riku-soin;</para>
  <para style="q2" vid="PSA 49:6">sira foti aan tanba riku boot.<verse eid="PSA 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7" />La iha ema ida mak bele selu kotu nia vida</para>
  <para style="q2" vid="PSA 49:7">ka foo nia riku ba Maromak atu salva nia moris.<verse eid="PSA 49:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8" />Tanba ema nia vida folin karun liu;</para>
  <para style="q2" vid="PSA 49:8">nia selu ho riku-soin saida deit mos la too<verse eid="PSA 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9" />atu nia bele moris nafatin ba nafatin,</para>
  <para style="q2" vid="PSA 49:9">atu nia la bele tama ba rai kuak.<verse eid="PSA 49:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10" />Ita hotu haree katak ema matenek mate,</para>
  <para style="q2" vid="PSA 49:10">hanesan mos ema nebee beik-teen la hatene buat ida.</para>
  <para style="q2" vid="PSA 49:10">Sira hotu husik sira nia riku-soin ba ema seluk.<verse eid="PSA 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11" />Uluk sira iha rai luan;</para>
  <para style="q2" vid="PSA 49:11">too ikus rate mak sai fali sira nia uma tinan ba tinan;</para>
  <para style="q2" vid="PSA 49:11">rai kuak mak sai sira nia hela fatin husi jerasaun ba jerasaun.<verse eid="PSA 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12" />Maski ema riku, nia la bele moris nafatin;</para>
  <para style="q2" vid="PSA 49:12">nia hanesan animal nebee too tempu ida sei mate.<verse eid="PSA 49:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13" />Ema nebee konfia nia aan, nia dalan mak nee;</para>
  <para style="q2" vid="PSA 49:13">ida nee mak destinu ba ema nebee mak laran metin ba nia lia fuan rasik.<verse eid="PSA 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14" />Sira nia destinu mak mate;</para>
  <para style="q2" vid="PSA 49:14">sira hanesan bibi malae,</para>
  <para style="q1" vid="PSA 49:14">mate mak sira nia bibi atan hodi lori sira ba matebian sira nia fatin;</para>
  <para style="q2" vid="PSA 49:14">sira tuun kedas ba iha rai kuak.</para>
  <para style="q1" vid="PSA 49:14">Rai sei haan tiha sira nia isin;</para>
  <para style="q2" vid="PSA 49:14">sira dook tiha ona husi sira nia uma diak nian.<verse eid="PSA 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15" />Maibee Maromak sei salva hau husi matebian sira nia fatin;</para>
  <para style="q2" vid="PSA 49:15">Nia sei dada hau sae ba iha Nia prezensa.<verse eid="PSA 49:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16" />Keta preokupa bainhira ema seluk hetan riku;</para>
  <para style="q2" vid="PSA 49:16">se nia riku-soin aumenta ba beibeik mos lalika tauk,<verse eid="PSA 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17" />tanba ema nee mate, sei la lori buat ida;</para>
  <para style="q2" vid="PSA 49:17">nia riku-soin la baa hamutuk ho nia.<verse eid="PSA 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18" />Iha nia moris tomak nia konsidera nia aan ema nebee hetan bensaun;</para>
  <para style="q2" vid="PSA 49:18">ema nebee moris diak hanesan nee, ema seluk sempre gaba.<verse eid="PSA 49:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19" />Maski nunee nia sei baa hamutuk ho sira nebee baa uluk ona;</para>
  <para style="q2" vid="PSA 49:19">nia nunka atu haree tan naroman moris nian.<verse eid="PSA 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20" />Ema nebee riku maibee falta kompriensaun,</para>
  <para style="q2" vid="PSA 49:20">sira hanesan animal nebee too tempu ida sei mate.<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="s">Sakrifisiu nebee loos</para>
  <para style="d">Salmu Asaf nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1" />NAI Maromak Kbiit Nain</para>
  <para style="q2" vid="PSA 50:1">lia tuun hodi bolu ema iha mundu tomak,</para>
  <para style="q1" vid="PSA 50:1">husi lorosae too loromonu.<verse eid="PSA 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2" />Maromak nia naroman leno sai</para>
  <para style="q2" vid="PSA 50:2">husi foho Siaun, fatin nebee furak teb-tebes.<verse eid="PSA 50:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3" />Ita nia Maromak mai,</para>
  <para style="q2" vid="PSA 50:3">Nia sei la nonook;</para>
  <para style="q1" vid="PSA 50:3">ahi lakan boot iha hela Nia oin;</para>
  <para style="q2" vid="PSA 50:3">anin makaas haleu Nia.<verse eid="PSA 50:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4" />Nia bolu lalehan ho rai atu asisti</para>
  <para style="q2" vid="PSA 50:4">bainhira Nia foo justisa ba Nia povu; Nia dehan,<verse eid="PSA 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5" />“Halibur povu nebee foo laran mai Hau;</para>
  <para style="q2" vid="PSA 50:5">sira nee halo promesa ho Hau liu husi sakrifisiu tunu.”<verse eid="PSA 50:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6" />Lalehan foo sai katak Maromak tesi lia sempre loos,</para>
  <para style="q2" vid="PSA 50:6">tanba Nia nee Justisa Nain.<verse eid="PSA 50:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7" />“Hau nia povu, rona mai, Hau sei koalia;</para>
  <para style="q2" vid="PSA 50:7">Israel, Hau sei foo sasin kontra o.</para>
  <para style="q2" vid="PSA 50:7">Hau mak Maromak, o nia Maromak.<verse eid="PSA 50:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8" />Laos tanba o nia sakrifisiu la too mak Hau foo sala ba o;</para>
  <para style="q2" vid="PSA 50:8">sakrifisiu tunu nebee imi foo, sempre iha Hau nia oin.<verse eid="PSA 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9" />Hau la presiza karau husi o nia luhan</para>
  <para style="q2" vid="PSA 50:9">ka bibi husi o nia luhan laran,<verse eid="PSA 50:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10" />tanba animal hotu-hotu iha ai laran Hau nian;</para>
  <para style="q2" vid="PSA 50:10">karau iha foho rihun ba rihun mos Hau nian.<verse eid="PSA 50:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11" />Hau hatene manu hotu-hotu iha foho;</para>
  <para style="q2" vid="PSA 50:11">buat saida deit mak book aan iha rai fuik, Hau nian hotu.<verse eid="PSA 50:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12" />Se Hau hamlaha karik, Hau la hatete ba o,</para>
  <para style="q2" vid="PSA 50:12">tanba mundu ho buat hotu nebee mak iha laran, nee Hau nian.<verse eid="PSA 50:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13" />Imi hanoin katak Hau haan naan karau aman ka?</para>
  <para style="q2" vid="PSA 50:13">Hau hemu bibi aman nia raan ka?<verse eid="PSA 50:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14" />Diak liu foo agradesimentu nudar o nia sakrifisiu ba Maromak;</para>
  <para style="q2" vid="PSA 50:14">halo tuir o nia promesa ba Maromak Aas Liu.<verse eid="PSA 50:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15" />Bainhira o iha susar laran, harohan mai Hau</para>
  <para style="q2" vid="PSA 50:15">mak Hau sei salva o, no o sei foti aas Hau nia naran.”<verse eid="PSA 50:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16" />Maibee ba ema aat, Maromak hatete nunee:</para>
  <para style="q1" vid="PSA 50:16">“O temi beibeik Hau nia ukun fuan atu halo saida?</para>
  <para style="q2" vid="PSA 50:16">O nia ibun koalia hela deit hau nia promesa atu halo saida?<verse eid="PSA 50:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17" />Afinal o lakohi atu Hau koriji o;</para>
  <para style="q2" vid="PSA 50:17">o soe Hau nia liafuan ba kotuk.<verse eid="PSA 50:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18" />Bainhira o haree naok-teen, o baa hamutuk ho nia;</para>
  <para style="q2" vid="PSA 50:18">o ranxu ema nebee halo sala seksual.<verse eid="PSA 50:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19" />O husik o nia ibun koalia buat aat;</para>
  <para style="q2" vid="PSA 50:19">o foo o nia nanaal ba liafuan bosok.<verse eid="PSA 50:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20" />O tuur koalia aat o nia maun-alin;</para>
  <para style="q2" vid="PSA 50:20">o hatete aat o nia inan nia oan.<verse eid="PSA 50:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21" />Bainhira o halo buat sira nee, Hau nonook deit,</para>
  <para style="q2" vid="PSA 50:21">too o hanoin Hau mos hanesan ho o.</para>
  <para style="q1" vid="PSA 50:21">Maibee agora Hau foo sala ba o</para>
  <para style="q2" vid="PSA 50:21">hodi foo sai o nia hahalok ida-idak.<verse eid="PSA 50:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22" />Imi sira nebee haluha Maromak, rona mai!</para>
  <para style="q2" vid="PSA 50:22">Se lae Hau sei lees tiha imi, la iha ema ida bele salva imi.<verse eid="PSA 50:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23" />Bainhira ema foo agradese mai Hau,</para>
  <para style="q2" vid="PSA 50:23">nee mak sakrifisiu ida nebee foti aas Hau nia naran;</para>
  <para style="q1" vid="PSA 50:23">ema nebee mak lao iha dalan loos,</para>
  <para style="q2" vid="PSA 50:23">Hau, Maromak sei hatudu Hau nia salvasaun ba nia.”<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s">Orasaun husu perdaun</para>
  <para style="d">Salmu David nian, bainhira profeta Natan mai hasee David tanba nia halo sala ho Batseba. Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1" />Nai Maromak, hanoin hau ba!</para>
  <para style="q2" vid="PSA 51:1">Tanba Ita Boot nia domin nunka hotu.</para>
  <para style="q1" vid="PSA 51:1">Ita Boot nee laran luak,</para>
  <para style="q2" vid="PSA 51:1">nunee halakon tiha hau nia hahalok aat hotu-hotu.<verse eid="PSA 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2" />Fase moos hau nia pekadu;</para>
  <para style="q2" vid="PSA 51:2">hamoos hau nia sala.<verse eid="PSA 51:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3" />Tanba hau rekonhese hau nia hahalok aat;</para>
  <para style="q2" vid="PSA 51:3">hau nia sala sempre mosu iha hau nia hanoin.<verse eid="PSA 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">51:4 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:4">Roma 3:4</ref>
      </char>
    </note>Hau halo sala kontra Ita Boot, so Ita Boot deit;</para>
  <para style="q2" vid="PSA 51:4">hau halo tiha ona buat nebee aat iha Ita Boot nia oin.</para>
  <para style="q1" vid="PSA 51:4">Nunee Ita Boot hakotu hau nia lia, kona duni;</para>
  <para style="q2" vid="PSA 51:4">Ita Boot hatuun kastigu mai hau nee loos.<verse eid="PSA 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5" />Tebes duni, hau moris mai sala nanis kedas;</para>
  <para style="q2" vid="PSA 51:5">hau sala nain husi tempu nebee hau nia inan foin isin rua.<verse eid="PSA 51:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6" />Maibee Ita Boot hakarak atu hau nia laran tenki moos,</para>
  <para style="q2" vid="PSA 51:6">nunee hanorin hau atu hau sai matenek.<verse eid="PSA 51:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7" />Hisik bee ba hau hodi ai hisopu para hau sai moos;</para>
  <para style="q2" vid="PSA 51:7">fase moos tiha hau mak hau sei sai mutin liu fali kabas rahun.<verse eid="PSA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8" />Foo ksolok ho kontenti mai hau.</para>
  <para style="q2" vid="PSA 51:8">Ita Boot harahun tiha ona hau nia ruin;</para>
  <para style="q2" vid="PSA 51:8">agora husik hau hamriik fali ho haksolok.<verse eid="PSA 51:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9" />Keta haree ba hau nia sala;</para>
  <para style="q2" vid="PSA 51:9">halakon tiha hau nia pekadu.<verse eid="PSA 51:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10" />Maromak, halo hau nia neon moos;</para>
  <para style="q2" vid="PSA 51:10">hafoun hau nia laran halo hau laran metin ba Ita Boot.<verse eid="PSA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11" />Keta duni sai hau husi Ita Boot nia oin;</para>
  <para style="q2" vid="PSA 51:11">keta hasai Ita Boot nia Espiritu Santu husi hau.<verse eid="PSA 51:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12" />Halo hau haksolok fila fali tanba Ita Boot salva tiha ona hau;</para>
  <para style="q2" vid="PSA 51:12">halo hau nia laran prontu atu moris tuir Ita Boot nia hakarak.<verse eid="PSA 51:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13" />Depois hau sei hanorin Ita Boot nia dalan ba ema sala nain sira,</para>
  <para style="q2" vid="PSA 51:13">atu nunee sira bele fila fali ba Ita Boot.<verse eid="PSA 51:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14" />Maromak hau nia Salvador,</para>
  <para style="q2" vid="PSA 51:14">salva hau husi ema nebee mak eziji hau nia raan fakar.<note caller="+" style="f"><char style="fr" closed="false">51:14 </char><char style="ft" closed="false">Lian Ebreu iha nee dehan, “salva hau husi raan”. La klaru, salmista tauk ema seluk atu oho nia ka, nia oho tiha ona ema seluk ka, nia husu para aban-bainrua nia la bele oho ema.</char></note></para>
  <para style="q2" vid="PSA 51:14">Nunee hau sei hananu kona ba Ita Boot nia salvasaun.<verse eid="PSA 51:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15" />Nai Maromak, loke hau nia ibun</para>
  <para style="q2" vid="PSA 51:15">mak hau sei hahii Ita Boot.<verse eid="PSA 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16" />Se hau oho animal hodi halo sakrifisiu ba Ita Boot, nee la halo haksolok Ita Boot nia laran;</para>
  <para style="q2" vid="PSA 51:16">Maski hau lori sakrifisiu tunu mos, la halo Ita Boot kontenti.<verse eid="PSA 51:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17" />Maromak, hau nia sakrifisiu mak hau nia fuan nebee rahun,</para>
  <para style="q2" vid="PSA 51:17">hau nia laran nebee dodok, nakonu ho arependimentu.</para>
  <para style="q2" vid="PSA 51:17">Sakrifisiu nee monu duni ba Ita Boot nia laran.<verse eid="PSA 51:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18" />Hatudu Ita Boot nia laran diak ba povu Siaun para povu bele hetan diak;</para>
  <para style="q2" vid="PSA 51:18">harii fila fali moru haleu sira nia sidade Jerusalém nee.<verse eid="PSA 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19" />Depois Ita Boot nia laran sei kontenti ho sakrifisiu lo-loos,</para>
  <para style="q2" vid="PSA 51:19">sakrifisiu tunu nebee ami oferese tomak ba Ita Boot.</para>
  <para style="q2" vid="PSA 51:19">Ami sei oferese karau aman boot hodi tunu iha Ita Boot nia altar.<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="s">Kastigu ba ema aat sira</para>
  <para style="d">Salmu David nian, bainhira ema Edom ida naran Doeg baa kesar ba Saul dehan, “David baa tiha ona iha Ahimelek nia uma.” Salmu nee para hanorin ema. Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1" />Eroi boot, nusaa mak o gaba aan kona ba hahalok aat</para>
  <para style="q2" vid="PSA 52:1">hasoru ema nebee Maromak hadomi?<verse eid="PSA 52:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2" />Lohi door, o iha planu atu halo aat ema;</para>
  <para style="q2" vid="PSA 52:2">o nia ibun kroat hanesan tudik.<verse eid="PSA 52:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3" />O gosta buat aat liu fali buat diak;</para>
  <para style="q2" vid="PSA 52:3">o gosta koalia bosok liu fali koalia buat nebee loos.<verse eid="PSA 52:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4" />Lohi-teen, o gosta koalia liafuan nebee halo terus ema.<verse eid="PSA 52:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5" />Nee duni, Maromak sei riba tuun o tinan ba tinan;</para>
  <para style="q2" vid="PSA 52:5">Nia sei kaer o hodi rakut o sai husi o nia tenda;</para>
  <para style="q2" vid="PSA 52:5">Nia sei fokit o sai husi ema moris sira nia rain.<verse eid="PSA 52:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6" />Ema nebee moris loos sei haree no tauk;</para>
  <para style="q2" vid="PSA 52:6">sira sei hamnasa o hodi dehan,<verse eid="PSA 52:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7" />“Haree took ema nee!</para>
  <para style="q2" vid="PSA 52:7">Nia la buka mahon iha Maromak,</para>
  <para style="q1" vid="PSA 52:7">maibee konfia fali nia riku-soin bar-barak,</para>
  <para style="q2" vid="PSA 52:7">no hamahon aan iha hahalok nebee aat.”<verse eid="PSA 52:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8" />Maibee hau nee hanesan ai huun oliveira</para>
  <para style="q2" vid="PSA 52:8">nebee moris buras iha Maromak nia uma.</para>
  <para style="q1" vid="PSA 52:8">Hau konfia Maromak nia domin rohan-laek</para>
  <para style="q2" vid="PSA 52:8">nafatin ba nafatin.<verse eid="PSA 52:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9" />Maromak, hau sei agradese ba Ita Boot tinan ba tinan</para>
  <para style="q2" vid="PSA 52:9">tanba buat nebee Ita Boot halo tiha ona;</para>
  <para style="q1" vid="PSA 52:9">hau sei haklaken Ita Boot nia naran iha Ita Boot nia povu nia leet,</para>
  <para style="q2" vid="PSA 52:9">tanba Ita Boot nee diak.<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="s">Ema nia hahalok aat</para>
  <para style="d">Salmu David nian para hanorin ema. Tuir muzika “Mahalat.” Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">53:1 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:10-12">Roma 3:10-12</ref>
      </char>
    </note>Ema beik sira koalia iha sira nia laran dehan,</para>
  <para style="q2" vid="PSA 53:1">“Maromak la iha!”</para>
  <para style="q1" vid="PSA 53:1">Ema sira nee mesak aat deit; sira nia dalan aat teb-tebes;</para>
  <para style="q2" vid="PSA 53:1">la iha ema ida mak halo buat diak.<verse eid="PSA 53:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2" />Maromak hateke tuun husi lalehan mai ita ema</para>
  <para style="q2" vid="PSA 53:2">hodi haree, iha ema balu matenek ka lae,</para>
  <para style="q2" vid="PSA 53:2">ema balu harohan ba Maromak ka lae.<verse eid="PSA 53:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3" />Maibee ema hotu lao sala dalan ona, sira hotu sai aat tiha ona;</para>
  <para style="q2" vid="PSA 53:3">la iha ema ida mak halo buat diak;</para>
  <para style="q2" vid="PSA 53:3">ida mos la iha.<verse eid="PSA 53:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4" />Ema aat sira nee la hatene buat ida ka?</para>
  <para style="q2" vid="PSA 53:4">Sira haan matak hau nia povu hanesan fali sira haan halimar paun fuan ida;</para>
  <para style="q2" vid="PSA 53:4">sira nunka bolu Maromak nia naran.<verse eid="PSA 53:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5" />Maibee haree ba, ema sira nee sei tauk teb-tebes;</para>
  <para style="q2" vid="PSA 53:5">tauk nee laos tauk baibain nebee sira senti iha sira nia moris.</para>
  <para style="q1" vid="PSA 53:5">Maromak nia povu, ema nebee ataka imi, Maromak sei halo sira nia ruin naklekar;</para>
  <para style="q2" vid="PSA 53:5">Maromak lakohi simu sira, nunee imi sei hatuun sira.<verse eid="PSA 53:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6" />Hau harohan atu Maromak hamriik iha foho Siaun hodi salva Israel.</para>
  <para style="q2" vid="PSA 53:6">Bainhira Maromak hadia fali Nia povu nia moris,</para>
  <para style="q2" vid="PSA 53:6">Jacó nia jerasaun sei haksolok, Israel sei kontenti.<verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="s">Orasaun husu Nai Maromak proteje</para>
  <para style="d">Salmu David nian, bainhira ema Zifi sira baa kesar ba Saul dehan, “David subar hela iha ami nia leet.” Salmu nee para hanorin ema. Akompanha ho viola. Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1" />Maromak, hodi Ita Boot nia naran salva hau ba;</para>
  <para style="q2" vid="PSA 54:1">hodi Ita Boot nia kbiit foo justisa mai hau.<verse eid="PSA 54:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2" />Maromak, rona hau nia orasaun;</para>
  <para style="q2" vid="PSA 54:2">see tilun ba hau nia lia fuan.<verse eid="PSA 54:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3" />Ema foti aan sira mai hodi ataka hau;</para>
  <para style="q2" vid="PSA 54:3">ema laran aat hakarak hasai hau nia vida;</para>
  <para style="q2" vid="PSA 54:3">sira la interese Maromak.<verse eid="PSA 54:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4" />Maibee Maromak mak ajuda hau;</para>
  <para style="q2" vid="PSA 54:4">Nai Maromak sempre kuidadu hau.<verse eid="PSA 54:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5" />Husik hau nia inimigu sira nia hahalok aat fila fali ba sira;</para>
  <para style="q2" vid="PSA 54:5">harahun tiha sira, tanba Ita Boot sempre halo buat nebee loos.<verse eid="PSA 54:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6" />NAI Maromak, ho laran tomak hau sei oferese sakrifisiu ba Ita Boot;</para>
  <para style="q2" vid="PSA 54:6">hau sei hahii Ita Boot nia naran, tanba Ita Boot nee diak.<verse eid="PSA 54:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7" />Ita Boot salva tiha ona hau husi susar laran;</para>
  <para style="q2" vid="PSA 54:7">hau nia matan haree tiha ona hau nia inimigu sira lakon.<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="s">Halerik bainhira belun diak sai fali inimigu</para>
  <para style="d">Salmu David nian para hanorin ema. Akompanha ho viola. Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1" />Maromak, see tilun ba hau nia orasaun;</para>
  <para style="q2" vid="PSA 55:1">keta fila kotuk ba hau nia hamulak.<verse eid="PSA 55:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2" />Rona hau hodi hataan hau ba;</para>
  <para style="q2" vid="PSA 55:2">hau hanoin la hetan too hau nia laran dodok.<verse eid="PSA 55:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3" />Tanba hau nia inimigu sira hakilar hau;</para>
  <para style="q2" vid="PSA 55:3">ema aat ameasa hau;</para>
  <para style="q1" vid="PSA 55:3">sira hanehan hau;</para>
  <para style="q2" vid="PSA 55:3">sira odi hau ho laran nakali.<verse eid="PSA 55:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4" />Hau nia fuan nakdedar;</para>
  <para style="q2" vid="PSA 55:4">ameasa mate nian hanehan hau.<verse eid="PSA 55:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5" />Hau tauk ho nakdedar</para>
  <para style="q2" vid="PSA 55:5">too isin fulun hamriik.<verse eid="PSA 55:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6" />Hau hanoin, “Diak liu hau iha liras manu pombu nian,</para>
  <para style="q2" vid="PSA 55:6">atu hau bele semo sai hodi hakmatek.<verse eid="PSA 55:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7" />Hau atu semo dook</para>
  <para style="q2" vid="PSA 55:7">baa hela iha rai fuik;<verse eid="PSA 55:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8" />hau atu baa lalais buka fatin mahon,</para>
  <para style="q2" vid="PSA 55:8">dook husi anin boot ho udan boot.”<verse eid="PSA 55:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9" />Nai Maromak, halo ema aat sira nia neon lakon tiha;</para>
  <para style="q2" vid="PSA 55:9">husik sira koalia arbiru ba,</para>
  <para style="q2" vid="PSA 55:9">tanba hau haree violensia ho rungu-ranga iha sidade laran.<verse eid="PSA 55:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10" />Loron-kalan sira lao haleu sidade hodi kontrola iha moru leten;</para>
  <para style="q2" vid="PSA 55:10">iha moru laran nakonu ho hanoin aat ho krimi.<verse eid="PSA 55:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11" />Estraga door sira lao hela iha sidade nee;</para>
  <para style="q2" vid="PSA 55:11">iha estrada ninin sira hanehan ema no haan matak ema nia riku-soin la para.<verse eid="PSA 55:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12" />Se karik hau nia inimigu mak hatete aat hau,</para>
  <para style="q2" vid="PSA 55:12">hau sei aguenta;</para>
  <para style="q1" vid="PSA 55:12">se karik funu baluk ida mak foti aan hasoru hau,</para>
  <para style="q2" vid="PSA 55:12">hau sei bele subar aan husi nia.<verse eid="PSA 55:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13" />Maibee o mak halo fali, o ho hau hanesan;</para>
  <para style="q2" vid="PSA 55:13">o nee hau nia maluk, hau nia belun diak.<verse eid="PSA 55:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14" />Ita nain rua uluk ranxu malu diak loos;</para>
  <para style="q2" vid="PSA 55:14">ita tama iha Maromak nia uma kreda iha ema barak nia leet.<verse eid="PSA 55:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15" />Husik hau nia inimigu sira mate mean;</para>
  <para style="q2" vid="PSA 55:15">husik sira tuun moris ba ema mate sira nia fatin,</para>
  <para style="q1" vid="PSA 55:15">tanba hahalok aat iha hela sira nia uma,</para>
  <para style="q2" vid="PSA 55:15">iha hela sira nia laran.<verse eid="PSA 55:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16" />Maibee hau harohan ba NAI Maromak</para>
  <para style="q2" vid="PSA 55:16">mak Maromak salva hau.<verse eid="PSA 55:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17" />Iha tempu kalan, dadeer-saan ho meudia,</para>
  <para style="q2" vid="PSA 55:17">hau halerik ho laran susar;</para>
  <para style="q2" vid="PSA 55:17">Nia rona hau nia lian.<verse eid="PSA 55:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18" />Nia salva hau;</para>
  <para style="q2" vid="PSA 55:18">maski ema nadodon mai hodi ataka hau,</para>
  <para style="q2" vid="PSA 55:18">buat ida la kona hau.<verse eid="PSA 55:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19" />Maromak nee Liurai hori uluk kedas;</para>
  <para style="q2" vid="PSA 55:19">Nia sei rona hau hodi hatuun sira,</para>
  <para style="q1" vid="PSA 55:19">tanba sira nee lakohi arepende,</para>
  <para style="q2" vid="PSA 55:19">no la hamtauk Maromak.<verse eid="PSA 55:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20" />Hau nia kolega ataka fali nia maun-alin koran sira;</para>
  <para style="q2" vid="PSA 55:20">nia kontra fali nia promesa ho sira.<verse eid="PSA 55:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21" />Nia koalia ho ibun midar,</para>
  <para style="q2" vid="PSA 55:21">maibee nia laran hakarak funu;</para>
  <para style="q1" vid="PSA 55:21">nia liafuan kabeer liu fali mina,</para>
  <para style="q2" vid="PSA 55:21">maibee kroat hanesan surik.<verse eid="PSA 55:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22" />Entrega o nia preokupasaun ba NAI Maromak</para>
  <para style="q2" vid="PSA 55:22">mak Nia sei kuidadu o;</para>
  <para style="q2" vid="PSA 55:22">Nia nunka husik ema nebee moris loos atu nakdoko.<verse eid="PSA 55:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23" />Maibee Maromak, Ita Boot sei soe tuun tiha ema aat sira</para>
  <para style="q2" vid="PSA 55:23">ba iha rai kuak naruk;</para>
  <para style="q1" vid="PSA 55:23">oho-door ho traidor sira nia vida sei la naruk;</para>
  <para style="q2" vid="PSA 55:23">sira mate ho tinan badak.</para>
  <para style="q1" vid="PSA 55:23">Maibee hau nee konfia Ita Boot.<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="s">Laran metin ba Nai Maromak iha tempu susar</para>
  <para style="d">Salmu David nian, bainhira ema Filístia sira kaer nia iha sidade Gat. Salmu nee para hanorin ema. Tuir muzika “Manu pombu iha ai huun nebee dook.” Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1" />Maromak, hatudu Ita Boot nia laran luak mai hau,</para>
  <para style="q2" vid="PSA 56:1">tanba ema sama hela hau;</para>
  <para style="q2" vid="PSA 56:1">loron-kalan hau nia inimigu sira hanehan hau.<verse eid="PSA 56:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2" />Hau nia funu baluk sira sama hela hau loron-kalan;</para>
  <para style="q2" vid="PSA 56:2">ema barak foti aan ataka hau.<verse eid="PSA 56:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3" />Maromak Aas Liu, bainhira hau tauk,</para>
  <para style="q2" vid="PSA 56:3">hau konfia Ita Boot.<verse eid="PSA 56:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4" />Hau hahii Maromak tanba buat nebee Nia promete ona;</para>
  <para style="q2" vid="PSA 56:4">hau fiar Nia, nunee hau la tauk.</para>
  <para style="q2" vid="PSA 56:4">Ema mundu nee bele halo saida ba hau?<verse eid="PSA 56:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5" />Loron-kalan hau nia inimigu sira bobar hau nia liafuan;</para>
  <para style="q2" vid="PSA 56:5">sira sempre iha hanoin aat ba hau.<verse eid="PSA 56:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6" />Sira kombina malu;</para>
  <para style="q2" vid="PSA 56:6">sira hafuhu hau;</para>
  <para style="q1" vid="PSA 56:6">sira haree tu-tuir hau nia dalan;</para>
  <para style="q2" vid="PSA 56:6">sira hakarak atu hasai hau nia vida.<verse eid="PSA 56:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7" />Maromak, keta husik sira moris, tanba sira nia hahalok aat;</para>
  <para style="q2" vid="PSA 56:7">hamonu nasaun jentiu sira ho hirus ba.<verse eid="PSA 56:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8" />Hau nia terus Ita Boot mak sura;</para>
  <para style="q2" vid="PSA 56:8">hau nia matan been Ita Boot tau iha botir.</para>
  <para style="q2" vid="PSA 56:8">Buat sira nee hotu Ita Boot hakerek iha Ita Boot nia livru.<verse eid="PSA 56:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9" />Bainhira hau harohan,</para>
  <para style="q2" vid="PSA 56:9">hau nia inimigu sira sei hakiduk.</para>
  <para style="q2" vid="PSA 56:9">Hau hatene katak Maromak hamutuk ho hau.<verse eid="PSA 56:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10" />Hau hahii Maromak tanba buat nebee Nia promete ona;</para>
  <para style="q2" vid="PSA 56:10">hau hahii NAI Maromak tanba promesa nebee Nia halo.<verse eid="PSA 56:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11" />Hau fiar Maromak, nunee hau la tauk.</para>
  <para style="q2" vid="PSA 56:11">Ema mundu nee bele halo saida ba hau?<verse eid="PSA 56:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12" />Maromak, hau sei kumpri hau nia juramentu ba Ita Boot;</para>
  <para style="q2" vid="PSA 56:12">hau sei foo oferta agradesimentu nian ba Ita Boot.<verse eid="PSA 56:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13" />Tanba Ita Boot hasai tiha ona hau husi mate;</para>
  <para style="q2" vid="PSA 56:13">Ita Boot kuidadu hau nia ain la sidi,</para>
  <para style="q1" vid="PSA 56:13">nunee hau bele lao iha Maromak nia oin,</para>
  <para style="q2" vid="PSA 56:13">iha naroman moris nian.<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="s">Orasaun ho laran metin ba Nai Maromak iha tempu susar</para>
  <para style="d">Salmu David nian, bainhira nia halai sees husi Saul hodi tama iha fatuk kuak laran. Salmu nee para hanorin ema. Tuir muzika “Keta harahun.” Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1" />Maromak, hatudu Ita Boot nia laran luak mai hau;</para>
  <para style="q2" vid="PSA 57:1">hanoin hau ba,</para>
  <para style="q2" vid="PSA 57:1">tanba hau hamahon aan iha Ita Boot.</para>
  <para style="q1" vid="PSA 57:1">Hau sei hamahon aan iha Ita Boot nia liras okos</para>
  <para style="q2" vid="PSA 57:1">too dezastre liu tiha.<verse eid="PSA 57:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2" />Hau harohan ba Maromak Aas Liu;</para>
  <para style="q2" vid="PSA 57:2">hau husu tulun ba Maromak tanba Nia halo buat diak mai hau.<verse eid="PSA 57:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3" />Nia sei hatuun salvasaun husi lalehan mai hau;</para>
  <para style="q2" vid="PSA 57:3">Nia sei hamoe ema sira nebee mak sama hau.</para>
  <para style="q1" vid="PSA 57:3">Maromak haraik Nia domin rohan-laek ho Nia lia loos.<verse eid="PSA 57:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4" />Hau toba hela iha liaun nia klaran;</para>
  <para style="q2" vid="PSA 57:4">sira gosta lees matak ema hodi haan;</para>
  <para style="q1" vid="PSA 57:4">sira nia nehan hanesan diman ho rama oan;</para>
  <para style="q2" vid="PSA 57:4">sira nia nanaal kroat hanesan surik.<verse eid="PSA 57:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5" />Maromak, hatudu Ita Boot nia Aan aas liu lalehan;</para>
  <para style="q2" vid="PSA 57:5">halo Ita Boot nia kbiit domina mundu tomak.<verse eid="PSA 57:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6" />Hau nia inimigu sira monta tiha ona redi ba hau nia ain;</para>
  <para style="q2" vid="PSA 57:6">hau sai muroon tiha;</para>
  <para style="q1" vid="PSA 57:6">sira kee rai kuak iha dalan nebee hau atu liu,</para>
  <para style="q2" vid="PSA 57:6">maibee sira rasik mak monu tama ba laran.<verse eid="PSA 57:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7" />Maromak, hau laran metin ba Ita Boot;</para>
  <para style="q2" vid="PSA 57:7">hau nia laran metin;</para>
  <para style="q2" vid="PSA 57:7">hau sei toka muzika hodi hananu hahii Ita Boot.<verse eid="PSA 57:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8" />Hau hatete ba hau nia aan, hadeer ba!</para>
  <para style="q2" vid="PSA 57:8">Viola ho viola tali sanulu, hadeer ba!</para>
  <para style="q2" vid="PSA 57:8">Hau sei fanu loro matan.<verse eid="PSA 57:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9" />Nai Maromak, hau sei hahii Ita Boot iha nasaun hotu-hotu nia klaran;</para>
  <para style="q2" vid="PSA 57:9">hau sei hananu ba Ita Boot iha povu sira nia leet,<verse eid="PSA 57:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10" />tanba Ita Boot nia domin boot too iha lalehan;</para>
  <para style="q2" vid="PSA 57:10">Ita Boot nia lia loos firmi too iha kalohan.<verse eid="PSA 57:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11" />Maromak, hatudu Ita Boot nia Aan aas liu lalehan;</para>
  <para style="q2" vid="PSA 57:11">halo Ita Boot nia kbiit domina mundu tomak.<verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="s">Orasaun husu justisa</para>
  <para style="d">Salmu David nian para hanorin ema. Tuir muzika “Keta harahun.” Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1" />Ukun nain sira, imi koalia lia loos ka?</para>
  <para style="q2" vid="PSA 58:1">Imi tesi ema nia lia ho lo-loos ka lae?<verse eid="PSA 58:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2" />Lae, imi nia hanoin aat;</para>
  <para style="q2" vid="PSA 58:2">imi nia liman halao violensia iha rai.<verse eid="PSA 58:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3" />Husi kabun laran kedas ema aat lao sala dalan;</para>
  <para style="q2" vid="PSA 58:3">moris mai kedas sira lao sala hodi bosok ema.<verse eid="PSA 58:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4" />Sira iha veneno hanesan samea nia veneno,</para>
  <para style="q2" vid="PSA 58:4">hanesan samea kobra nebee taka tiha nia tilun<verse eid="PSA 58:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5" />para nia nain toka muzika, nia la bele rona;</para>
  <para style="q2" vid="PSA 58:5">muzika bele kapaas mos, nia lakohi atu rona.<verse eid="PSA 58:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6" />Maromak, harahun tiha sira nia nehan iha sira nia ibun laran;</para>
  <para style="q2" vid="PSA 58:6">NAI, halo tohar tiha liaun sira nee nia nehan ba.<verse eid="PSA 58:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7" />Husik sira lakon hanesan bee nebee suli lakon;</para>
  <para style="q2" vid="PSA 58:7">husik sira sai namlaik hanesan duut iha dalan.<verse eid="PSA 58:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8" />Halo sira mohu hanesan karakol nia kabeen nebee maran tu-tuir;</para>
  <para style="q2" vid="PSA 58:8">halo sira hanesan bebee nebee abortu tiha, nunka hetan loro matan.<verse eid="PSA 58:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9" />Molok ema bele sunu ai sanak lotuk hodi hamanas sanan,</para>
  <para style="q2" vid="PSA 58:9">Maromak sei dasa sai tiha ema aat sira.<note caller="+" style="f"><char style="fr" closed="false">58:9 </char><char style="ft" closed="false">Versikulu nee iha lian Ebreu la klaru.</char></note><verse eid="PSA 58:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10" />Ema moris loos sei haksolok bainhira sira haree Maromak kastigu ema aat sira;</para>
  <para style="q2" vid="PSA 58:10">sira sei solur sira nia ain iha ema aat sira nia raan laran.<verse eid="PSA 58:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11" />Ema sei dehan, “Loos duni, ema moris loos sei simu nia kolen;</para>
  <para style="q2" vid="PSA 58:11">tebes, Maromak mak foo justisa ba mundu.”<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="s">Husu tulun ba Nai Maromak hodi kontra inimigu</para>
  <para style="d">Salmu David nian, bainhira Saul haruka ema hafuhu David nia uma para oho nia. Salmu nee para hanorin ema. Tuir muzika “Keta harahun.” Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1" />Maromak, salva hau husi hau nia inimigu sira;</para>
  <para style="q2" vid="PSA 59:1">satan netik hau husi sira nebee mak ataka hau.<verse eid="PSA 59:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2" />Salva hau husi ema sira nebee halo aat;</para>
  <para style="q2" vid="PSA 59:2">hasai hau husi ema oho door sira nia liman laran.<verse eid="PSA 59:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3" />NAI Maromak, haree ba, sira hein hela hau atu hakotu hau nia vida;</para>
  <para style="q2" vid="PSA 59:3">ema forti sira kombina malu hodi kontra hau;</para>
  <para style="q2" vid="PSA 59:3">afinal hau la halo buat ida ba sira.<verse eid="PSA 59:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4" />Hau la sala, maibee sira halai mai atu asalta hau.</para>
  <para style="q2" vid="PSA 59:4">Hamriik hodi tulun hau, haree rasik ba.<verse eid="PSA 59:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5" />NAI Maromak Aswain,</para>
  <para style="q2" vid="PSA 59:5">Ita Boot mak Israel nia Maromak;</para>
  <para style="q1" vid="PSA 59:5">hadeer ba hodi kastigu nasaun jentiu sira;</para>
  <para style="q2" vid="PSA 59:5">keta hanoin tan traidor laran aat sira.<verse eid="PSA 59:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6" />Sira fila iha oras kalan,</para>
  <para style="q2" vid="PSA 59:6">hakilar hanesan asu nebee hatenu</para>
  <para style="q2" vid="PSA 59:6">hodi lao haleu sidade.<verse eid="PSA 59:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7" />Haree ba, sira fakar sai liafuan tarata husi sira nia ibun;</para>
  <para style="q2" vid="PSA 59:7">liafuan nebee sai husi sira nia ibun kroat hanesan surik;</para>
  <para style="q2" vid="PSA 59:7">sira hanoin dehan, “See mak atu rona?”<verse eid="PSA 59:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8" />Maibee NAI Maromak, Ita Boot hamnasa fali sira;</para>
  <para style="q2" vid="PSA 59:8">Ita Boot goza fali nasaun jentiu sira nee hotu.<verse eid="PSA 59:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9" />Ita Boot mak hau nia forsa, hau laran metin ba Ita Boot;</para>
  <para style="q2" vid="PSA 59:9">Maromak, Ita Boot mak hau nia abrigu.<verse eid="PSA 59:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10" />Hau nia Maromak nia domin rohan-laek, Nia sei mai simu hau;</para>
  <para style="q2" vid="PSA 59:10">hau nia Maromak sei halo hau manaan hau nia inimigu sira.<verse eid="PSA 59:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11" />Nai Maromak, Ita Boot defende ami;</para>
  <para style="q2" vid="PSA 59:11">keta oho sira, atu nunee hau nia povu la bele haluha.</para>
  <para style="q1" vid="PSA 59:11">Ho Ita Boot nia kbiit halo sira namkari</para>
  <para style="q2" vid="PSA 59:11">hodi hatuun tiha sira ba.<verse eid="PSA 59:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12" />Sala sai husi sira nia ibun;</para>
  <para style="q2" vid="PSA 59:12">sira nia ibun koalia buat aat,</para>
  <para style="q2" vid="PSA 59:12">nunee husik sira nia hahalok foti aan sai lasu ba sira nia aan rasik.</para>
  <para style="q1" vid="PSA 59:12">Sira gosta foo malisan no koalia liafuan bosok,<verse eid="PSA 59:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 59:13" />nunee hamohu sira ho Ita Boot nia hirus ba;</para>
  <para style="q2" vid="PSA 59:13">hamohu sira too sira la iha tan.</para>
  <para style="q1" vid="PSA 59:13">Depois ema husi rai ulun too rai ikun hatene katak,</para>
  <para style="q2" vid="PSA 59:13">Maromak ukun Jacó nia jerasaun.<note caller="+" style="f"><char style="fr" closed="false">59:13 </char><char style="ft" closed="false">Jacó nia jerasaun mak ema Israel. </char></note><verse eid="PSA 59:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14" />Sira fila iha oras kalan,</para>
  <para style="q2" vid="PSA 59:14">hakilar hanesan asu nebee hatenu</para>
  <para style="q2" vid="PSA 59:14">hodi lao haleu sidade.<verse eid="PSA 59:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15" />Sira lao rai buka ai haan;</para>
  <para style="q2" vid="PSA 59:15">bainhira sira la bosu, sira hakilar.<verse eid="PSA 59:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16" />Maibee hau sei hananu kona ba Ita Boot nia forsa;</para>
  <para style="q2" vid="PSA 59:16">iha dadeer-saan hau sei kanta sai Ita Boot nia domin rohan-laek,</para>
  <para style="q1" vid="PSA 59:16">tanba Ita Boot mak hau nia abrigu,</para>
  <para style="q2" vid="PSA 59:16">hau nia subar fatin iha tempu susar.<verse eid="PSA 59:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17" />Ita Boot mak hau nia forsa; hau hananu hahii Ita Boot;</para>
  <para style="q2" vid="PSA 59:17">Maromak, Ita Boot mak hau nia abrigu;</para>
  <para style="q2" vid="PSA 59:17">hau nia Maromak, Ita Boot hadomi hau.<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="s">Orasaun husu atu manaan funu</para>
  <para style="d">Salmu David nian, bainhira David funu hasoru ema Aram Naharaim ho Aram Zoba. Iha tempu nebaa, Joab fila fali hodi oho tiha ema Edom rihun sanulu resin rua iha Rai Masin. Salmu nee para hanorin ema. Tuir muzika “Ai funan promesa nian.” Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1" />Maromak, Ita Boot soe tiha ona ami, halo ami lakon;</para>
  <para style="q2" vid="PSA 60:1">Ita Boot hirus hela ami, simu fali ami ba!<verse eid="PSA 60:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2" />Ita Boot halo rai nakdoko hodi fera rai nakloke tiha;</para>
  <para style="q2" vid="PSA 60:2">halo tomak fila fali ba, tanba atu naksobu ona.<verse eid="PSA 60:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3" />Ita Boot halo Ita Boot nia povu terus aat liu ona;</para>
  <para style="q2" vid="PSA 60:3">Ita Boot obriga ami hemu tua too lanu todan.<verse eid="PSA 60:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4" />Maibee ema nebee hamtauk Ita Boot,</para>
  <para style="q2" vid="PSA 60:4">Ita Boot foo sinal atu sira sees aan husi rama oan.<verse eid="PSA 60:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5" />Hodi Ita Boot nia liman loos salva ami no tulun ami ba,</para>
  <para style="q2" vid="PSA 60:5">atu nunee ema nebee Ita Boot hadomi bele hetan salvasaun.<verse eid="PSA 60:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6" />Maromak lia tuun husi Nia hela fatin dehan,</para>
  <para style="q2" vid="PSA 60:6">“Hau sei manaan!</para>
  <para style="q1" vid="PSA 60:6">Hau sei fahe rai Sikem ba Hau nia povu;</para>
  <para style="q2" vid="PSA 60:6">Hau sei sukat rai Sukot.<verse eid="PSA 60:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7" />Rai Gileade Hau nian,</para>
  <para style="q2" vid="PSA 60:7">rai Manassés mos Hau nian;</para>
  <para style="q1" vid="PSA 60:7">ema Efraim Hau nia kapaseti,</para>
  <para style="q2" vid="PSA 60:7">ema Judá Hau nia rota.<verse eid="PSA 60:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8" />Rai Moab Hau nia basia hodi fase liman;</para>
  <para style="q2" vid="PSA 60:8">rai Edom fatin para soe Hau nia sandalias ba;</para>
  <para style="q2" vid="PSA 60:8">Hau haksolok haklalak tanba Hau manaan rai Filístia.”<verse eid="PSA 60:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9" />Maromak, see loos mak atu lori hau ba iha sidade nebee forti?</para>
  <para style="q2" vid="PSA 60:9">See loos mak atu lori hau ba iha rai Edom?<verse eid="PSA 60:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10" />Maromak, Ita Boot soe duni ami ka?</para>
  <para style="q2" vid="PSA 60:10">Maromak, Ita Boot lakohi avansa ho ami nia militar sira ka?<verse eid="PSA 60:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11" />Tulun ami hodi kontra inimigu sira,</para>
  <para style="q2" vid="PSA 60:11">tanba ema kriatura nia ajuda la iha folin.<verse eid="PSA 60:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12" />Hamutuk ho Maromak ita sei manaan;</para>
  <para style="q2" vid="PSA 60:12">Nia sei sama ita nia inimigu sira.<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="s">Orasaun husu atu Nai Maromak proteje</para>
  <para style="d">Salmu David nian, akompanha ho viola. Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1" />Maromak, rona hau nia halerik;</para>
  <para style="q2" vid="PSA 61:1">see tilun ba hau nia orasaun.<verse eid="PSA 61:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2" />Husi rai dook hau harohan ba Ita Boot,</para>
  <para style="q2" vid="PSA 61:2">tanba senti la bele ona.</para>
  <para style="q1" vid="PSA 61:2">Lori hau baa tau iha fatuk nebee aas liu hau,<verse eid="PSA 61:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 61:3" />tanba Ita Boot mak hau nia fatin seguru;</para>
  <para style="q2" vid="PSA 61:3">Ita Boot mak fatin seguransa nebee metin hasoru inimigu sira.<verse eid="PSA 61:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4" />Husik hau hela iha Ita Boot nia tenda tinan ba tinan;</para>
  <para style="q2" vid="PSA 61:4">husik hau hamahon aan iha Ita Boot nia liras okos.<verse eid="PSA 61:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5" />Tanba Maromak, Ita Boot rona tiha ona hau nia promesa;</para>
  <para style="q2" vid="PSA 61:5">bensaun nebee Ita Boot rai ba ema nebee hamtauk Ita Boot, hau mos simu ona.<verse eid="PSA 61:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6" />Foo vida naruk ba liurai;</para>
  <para style="q2" vid="PSA 61:6">husik nia moris too jerasaun ba jerasaun.<verse eid="PSA 61:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7" />Hau husu atu liurai bele ukun iha Maromak nia prezensa nafatin ba nafatin;</para>
  <para style="q2" vid="PSA 61:7">proteje nia hodi Ita Boot nia domin rohan-laek ho lia loos.<verse eid="PSA 61:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8" />Nunee hau sei hananu hahii Ita Boot nia naran nafatin ba nafatin;</para>
  <para style="q2" vid="PSA 61:8">hau sei halo tuir hau nia promesa loron ba loron.<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="s">Laran metin ba Nai Maromak</para>
  <para style="d">Salmu David nian, ba dirijenti koru Jedutun.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1" />Hau besik Maromak mak hau nia laran hakmatek;</para>
  <para style="q2" vid="PSA 62:1">so Nia deit mak bele salva hau.<verse eid="PSA 62:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2" />Nia mak fatuk lolon boot nebee hau helik ba;</para>
  <para style="q2" vid="PSA 62:2">Nia mak hau nia Salvador.</para>
  <para style="q1" vid="PSA 62:2">Nia mak hau nia abrigu;</para>
  <para style="q2" vid="PSA 62:2">la iha buat ida bele doko hau.<verse eid="PSA 62:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3" />Imi hotu atu ataka hau too bainhira?!</para>
  <para style="q2" vid="PSA 62:3">Imi atu hamonu hau</para>
  <para style="q1" vid="PSA 62:3">hanesan fali imi hamonu moru nebee haliis tiha ona</para>
  <para style="q2" vid="PSA 62:3">ka lutu nebee besik naksobu.<verse eid="PSA 62:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4" />Ema sira nee halo planu atu hatuun hau husi hau nia fatin aas;</para>
  <para style="q2" vid="PSA 62:4">sira gosta bosok.</para>
  <para style="q1" vid="PSA 62:4">Sira nia ibun foo bensaun,</para>
  <para style="q2" vid="PSA 62:4">maibee sira nia laran foo malisan.<verse eid="PSA 62:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5" />Hau besik Maromak mak hau nia laran hakmatek;</para>
  <para style="q2" vid="PSA 62:5">Nia deit mak foo esperansa mai hau.<verse eid="PSA 62:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6" />Nia mak fatuk lolon boot nebee hau helik ba;</para>
  <para style="q2" vid="PSA 62:6">Nia mak hau nia Salvador.</para>
  <para style="q1" vid="PSA 62:6">Nia mak hau nia abrigu;</para>
  <para style="q2" vid="PSA 62:6">la iha buat ida bele doko hau.<verse eid="PSA 62:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7" />Maromak mak salva hau no tane aas hau;</para>
  <para style="q2" vid="PSA 62:7">Nia mak fatuk lolon boot teb-tebes nebee hau helik ba;</para>
  <para style="q2" vid="PSA 62:7">Nia mak foo mahon mai hau.<verse eid="PSA 62:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8" />Maluk sira, konfia ba Maromak iha imi nia moris tomak;</para>
  <para style="q2" vid="PSA 62:8">saida mak iha imi nia laran fakar sai ba Nia,</para>
  <para style="q2" vid="PSA 62:8">tanba Maromak mak foo mahon mai ita.<verse eid="PSA 62:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9" />Ema kiik sira hanesan buat mamuk ida;</para>
  <para style="q2" vid="PSA 62:9">ema boot sira hanesan lia mamuk deit.</para>
  <para style="q1" vid="PSA 62:9">Se tetu iha dasin karik,</para>
  <para style="q2" vid="PSA 62:9">sira hotu kamaan liu fali anin.<verse eid="PSA 62:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10" />Keta mehi atu uza violensia hodi sai riku;</para>
  <para style="q2" vid="PSA 62:10">keta laran metin ba sasaan nebee o hadau husi ema.</para>
  <para style="q1" vid="PSA 62:10">Se karik o nia riku-soin aumenta barak mos,</para>
  <para style="q2" vid="PSA 62:10">lalika laran metin ba riku-soin nee.<verse eid="PSA 62:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11" />Maromak koalia tiha ona;</para>
  <para style="q2" vid="PSA 62:11">hau rona fila-fila ona katak,</para>
  <para style="q1" vid="PSA 62:11">kbiit tomak Maromak nian;<verse eid="PSA 62:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 62:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">62:12 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 34:11">Job 34:11</ref>; <ref loc="JER 17:10">Jeremias 17:10</ref>; <ref loc="MAT 16:27">Mateus 16:27</ref>; <ref loc="ROM 2:6">Roma 2:6</ref>; <ref loc="REV 2:23">Apokalipse 2:23</ref></char>
    </note>Nai Maromak, Ita Boot nia domin nunka hotu.</para>
  <para style="q1" vid="PSA 62:12">Ita Boot selu ema ida-idak</para>
  <para style="q2" vid="PSA 62:12">tuir buat nebee sira halo tiha ona.<verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="s">Hamrook ba Nai Maromak</para>
  <para style="d">Salmu David nian, bainhira nia iha rai fuik maran Judá nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1" />Maromak, Ita Boot mak hau nia Maromak;</para>
  <para style="q2" vid="PSA 63:1">hau hakarak teb-tebes atu besik Ita Boot;</para>
  <para style="q1" vid="PSA 63:1">hau nia laran hamrook ba Ita Boot;</para>
  <para style="q2" vid="PSA 63:1">hau nia aan tomak buka Ita Boot;</para>
  <para style="q1" vid="PSA 63:1">hau hanesan rai nebee maran dekor,</para>
  <para style="q2" vid="PSA 63:1">krekas, la iha bee.<verse eid="PSA 63:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2" />Hau haree tiha ona Ita Boot iha fatin santu;</para>
  <para style="q2" vid="PSA 63:2">hau fihir Ita Boot nia kbiit ho Ita Boot nia forsa.<verse eid="PSA 63:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3" />Ita Boot nia domin diak liu fali vida,</para>
  <para style="q2" vid="PSA 63:3">nunee hau nia ibun sei hahii Ita Boot.<verse eid="PSA 63:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4" />Hau nia moris tomak hau sei agradese ba Ita Boot;</para>
  <para style="q2" vid="PSA 63:4">hau sei foti sae hau nia liman hodi harohan ba Ita Boot.<verse eid="PSA 63:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5" />Ita Boot sei habosu hau ho hahaan mesak di-diak deit;</para>
  <para style="q2" vid="PSA 63:5">hau sei hananu ho haksolok hodi hahii Ita Boot.<verse eid="PSA 63:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6" />Iha hau nia toba fatin hau hanoin kona Ita Boot;</para>
  <para style="q2" vid="PSA 63:6">iha kalan tomak hau medita kona ba Ita Boot,<verse eid="PSA 63:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7" />tanba Ita Boot mak tulun hau;</para>
  <para style="q2" vid="PSA 63:7">iha Ita Boot nia liras okos, hau hamahon aan hodi hananu ho haksolok.<verse eid="PSA 63:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8" />Hau neon metin ba Ita Boot;</para>
  <para style="q2" vid="PSA 63:8">Ita Boot nia liman loos tane hau.<verse eid="PSA 63:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9" />Maibee ema nebee hakarak hakotu hau nia vida,</para>
  <para style="q2" vid="PSA 63:9">sira sei tuun ba iha rai kuak naruk nia laran.<verse eid="PSA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10" />Sira sei mate ho surik;</para>
  <para style="q2" vid="PSA 63:10">sira sei sai asu fuik nia ai haan.<verse eid="PSA 63:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11" />Maibee liurai sei haksolok tanba Maromak nia diak;</para>
  <para style="q2" vid="PSA 63:11">ema hotu nebee jura hodi Maromak nia naran sei hahii Nia,</para>
  <para style="q2" vid="PSA 63:11">tanba ema bosok-teen sira nia ibun sei taka metin tiha.<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="s">Orasaun husu tulun hasoru inimigu</para>
  <para style="d">Salmu David nian, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1" />Hau nia Maromak, rona hau nia lia halerik;</para>
  <para style="q2" vid="PSA 64:1">hau nia inimigu hatauk hau, kuidadu hau nia vida ba.<verse eid="PSA 64:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2" />Ema aat sira kombina malu hasoru hau, subar hau ba;</para>
  <para style="q2" vid="PSA 64:2">ema lubun boot gosta halo buat aat, proteje hau ba.<verse eid="PSA 64:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3" />Sira halo kroat sira nia liafuan hanesan fali halo kroat surik;</para>
  <para style="q2" vid="PSA 64:3">sira nia ibun foo sai liafuan moruk hanesan rama inan tiru sai rama oan.<verse eid="PSA 64:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4" />Sira hafuhu ema laran moos hodi tiru;</para>
  <para style="q2" vid="PSA 64:4">sira tiru lalais deit, la tauk buat ida.<verse eid="PSA 64:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5" />Sira foo korajen ba malu ho planu aat;</para>
  <para style="q2" vid="PSA 64:5">sira foo ideia ba malu atu monta sira nia lasu iha fatin subar;</para>
  <para style="q2" vid="PSA 64:5">sira dehan, “See mak atu haree?”<verse eid="PSA 64:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6" />Sira kombina malu ho planu aat hodi dehan,</para>
  <para style="q2" vid="PSA 64:6">“Ita prontu ona, ita nia planu diak loos ona.”</para>
  <para style="q2" vid="PSA 64:6">Tebes, ema nia fuan ho laran klean duni!<verse eid="PSA 64:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7" />Maibee Maromak sei hana sira ho rama oan;</para>
  <para style="q2" vid="PSA 64:7">sira kanek derepenti deit.<verse eid="PSA 64:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8" />Nia sei halo sira nia liafuan rasik kona fali sira</para>
  <para style="q2" vid="PSA 64:8">hodi hamohu tiha sira;</para>
  <para style="q2" vid="PSA 64:8">ema hotu nebee haree sei doko ulun hodi hatete aat sira.<verse eid="PSA 64:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9" />Nunee ema hotu-hotu sei tauk;</para>
  <para style="q2" vid="PSA 64:9">sira sei rekonhese Maromak nia servisu;</para>
  <para style="q2" vid="PSA 64:9">sira sei foo sai buat diak nebee Maromak halo tiha ona.<verse eid="PSA 64:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10" />Ema moris loos sei haksolok tanba NAI Maromak nia diak;</para>
  <para style="q2" vid="PSA 64:10">sira sei hamahon aan iha Nia;</para>
  <para style="q1" vid="PSA 64:10">ema hotu nebee moris ho laran moos sei tane aas Maromak nia naran.<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="s">Hananu agradese ba Nai Maromak nia bensaun</para>
  <para style="d">Salmu David nian. Kantiku ida, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1" />Maromak, ami hahii Ita Boot iha sidade Siaun;</para>
  <para style="q2" vid="PSA 65:1">ami sei halo tuir ami nia promesa ba Ita Boot.<verse eid="PSA 65:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2" />Ita Boot hataan ema nebee harohan ba Ita Boot;</para>
  <para style="q2" vid="PSA 65:2">ema hotu-hotu sei mai adora Ita Boot.<verse eid="PSA 65:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3" />Bainhira sala barak hanehan ami,</para>
  <para style="q2" vid="PSA 65:3">Ita Boot hamoos tiha ami nia sala sira nee.<verse eid="PSA 65:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4" />Ema sira nebee Ita Boot hili</para>
  <para style="q2" vid="PSA 65:4">hodi lori baa hela iha Ita Boot nia fatin santu,</para>
  <para style="q2" vid="PSA 65:4">ema sira nee hetan ksolok.</para>
  <para style="q1" vid="PSA 65:4">Iha Ita Boot nia uma,</para>
  <para style="q2" vid="PSA 65:4">iha Ita Boot nia uma kreda santu,</para>
  <para style="q1" vid="PSA 65:4">ami hetan buat mesak diak deit,</para>
  <para style="q2" vid="PSA 65:4">halo ami bosu.<verse eid="PSA 65:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5" />Maromak ami nia Salvador,</para>
  <para style="q2" vid="PSA 65:5">Ita Boot hatudu Ita Boot nia forsa hodi hataan ami no salva ami.</para>
  <para style="q1" vid="PSA 65:5">Ema husi rai ulun too rai ikun iha mundu tomak konfia Ita Boot;</para>
  <para style="q2" vid="PSA 65:5">ema nebee hela iha tasi balu mos laran metin ba Ita Boot.<verse eid="PSA 65:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6" />Ita Boot mak forma foho hodi Ita Boot nia kbiit,</para>
  <para style="q2" vid="PSA 65:6">Ita Boot hatudu sai Ita Boot nia forsa.<verse eid="PSA 65:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7" />Ita Boot hapara tasi siak ho laloran boot;</para>
  <para style="q2" vid="PSA 65:7">Ita Boot hakalma nasaun sira nebee rungu-ranga.<verse eid="PSA 65:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8" />Ema husi rai ulun too rai ikun iha mundu tomak</para>
  <para style="q2" vid="PSA 65:8">admira ho Ita Boot nia milagre;</para>
  <para style="q1" vid="PSA 65:8">ema husi lorosae too loromonu,</para>
  <para style="q2" vid="PSA 65:8">Ita Boot halo sira haklalak ho haksolok.<verse eid="PSA 65:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9" />Ita Boot tau matan ba rai nee hodi rega rai</para>
  <para style="q2" vid="PSA 65:9">sai buras teb-tebes.</para>
  <para style="q1" vid="PSA 65:9">Mota Maromak nian, bee nakonu;</para>
  <para style="q2" vid="PSA 65:9">Ita Boot prepara rai nunee</para>
  <para style="q2" vid="PSA 65:9">para povu bele hetan ai haan.<verse eid="PSA 65:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10" />Ita Boot hatuun udan ba rai nebee toos nain fila tiha ona;</para>
  <para style="q2" vid="PSA 65:10">Ita Boot foo udan been hodi halo rai sai mamar tiha;</para>
  <para style="q2" vid="PSA 65:10">Ita Boot foo bensaun ba ai horis sira.<verse eid="PSA 65:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11" />Tanba Ita Boot nia diak mak tin-tinan Ita Boot foo rezultadu diak ba toos;</para>
  <para style="q2" vid="PSA 65:11">Ita Boot nia ain fatin halo rai sai bokur tiha.<verse eid="PSA 65:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12" />Duut iha rai fuik sai matak ho buras;</para>
  <para style="q2" vid="PSA 65:12">foho sira mos haksolok hotu.<verse eid="PSA 65:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13" />Iha rai luan bibi nakonu;</para>
  <para style="q2" vid="PSA 65:13">iha toos trigu buras;</para>
  <para style="q2" vid="PSA 65:13">hotu-hotu haklalak hananu ho haksolok.<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="s">Hahii Nai Maromak</para>
  <para style="d">Salmu. Kantiku ida, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1" />Mundu tomak, haklalak ho haksolok ba Maromak;<verse eid="PSA 66:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 66:2" />hananu foti aas Nia naran ba;</para>
  <para style="q2" vid="PSA 66:2">hahii tane aas Nia naran!<verse eid="PSA 66:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3" />Hatete ba Maromak dehan, “Ita Boot halo buat mesak furak!</para>
  <para style="q2" vid="PSA 66:3">Ita Boot nia kbiit boot teb-tebes,</para>
  <para style="q2" vid="PSA 66:3">halo Ita Boot nia inimigu hakruuk lambe rai iha Ita Boot nia futar oin.<verse eid="PSA 66:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4" />Mundu tomak hakruuk ba Ita Boot;</para>
  <para style="q2" vid="PSA 66:4">sira hananu hahii Ita Boot;</para>
  <para style="q2" vid="PSA 66:4">sira hananu hahii Ita Boot nia naran.”<verse eid="PSA 66:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5" />Mai hodi haree buat nebee Maromak halo tiha ona;</para>
  <para style="q2" vid="PSA 66:5">Nia halo buat mesak furak ba ita ema.<verse eid="PSA 66:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">66:6 a </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Ézodu 14:21</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="JOS 3:14-17">Josué 3:14-17</ref>
      </char>
    </note>Nia halo tasi fila ba rai maran;</para>
  <para style="q2" vid="PSA 66:6">Nia povu lao ain hodi hakur mota.</para>
  <para style="q1" vid="PSA 66:6">Mai ita haksolok tanba Nia diak.<verse eid="PSA 66:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="PSA 66:7" />Nia ukun ho kbiit tinan ba tinan;</para>
  <para style="q1" vid="PSA 66:7">Nia matan haree nasaun jentiu sira;</para>
  <para style="q2" vid="PSA 66:7">ema nebee kontra Maromak lalika foti aan.<verse eid="PSA 66:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8" />Povu jentiu sira, hahii ami nia Maromak ba;</para>
  <para style="q2" vid="PSA 66:8">hasae imi nia lian sai makaas hodi hahii Nia.<verse eid="PSA 66:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9" />Nia kuidadu ami nia moris;</para>
  <para style="q2" vid="PSA 66:9">Nia halo ami nia ain hamriik metin.<verse eid="PSA 66:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10" />Maromak, Ita Boot koko ona ami,</para>
  <para style="q2" vid="PSA 66:10">hanesan ema koko osan mutin.<verse eid="PSA 66:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11" />Ita Boot lori tiha ona ami ba iha dadur laran;</para>
  <para style="q2" vid="PSA 66:11">Ita Boot tula naha todan ba iha ami nia kabaas.<verse eid="PSA 66:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12" />Inimigu sira sae kuda sama ami nia ulun, Ita Boot husik deit;</para>
  <para style="q2" vid="PSA 66:12">ami lao ona liu husi ahi laran ho bee laran,</para>
  <para style="q2" vid="PSA 66:12">maibee too ikus Ita Boot lori ami ba iha fatin nebee nakonu ho buat diak.<verse eid="PSA 66:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13" />Hau sei mai iha Ita Boot nia uma lori sakrifisiu tunu;</para>
  <para style="q2" vid="PSA 66:13">hau sei kumpri hau nia promesa<verse eid="PSA 66:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14" />nebee mak hau nia ibun temi tiha ona,</para>
  <para style="q2" vid="PSA 66:14">buat nebee hau promete bainhira hau iha susar laran.<verse eid="PSA 66:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15" />Hau sei oferese animal nebee bokur ba Ita Boot nudar sakrifisiu tunu;</para>
  <para style="q2" vid="PSA 66:15">hau sei tunu bibi malae aman halo suar morin sae;</para>
  <para style="q2" vid="PSA 66:15">hau sei oferese karau aman ho bibi aman ba Ita Boot.<verse eid="PSA 66:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16" />Imi hotu nebee hamtauk Maromak, mai rona ba;</para>
  <para style="q2" vid="PSA 66:16">hau hakarak foo sai ba imi buat nebee mak Nia halo ona mai hau.<verse eid="PSA 66:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17" />Uluk hau nia ibun husu tulun ba Nia ho lian makaas;</para>
  <para style="q2" vid="PSA 66:17">hau nia nanaal hahii hela Nia.<verse eid="PSA 66:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18" />Se karik hau rai hela buat aat ruma iha hau nia laran,</para>
  <para style="q2" vid="PSA 66:18">Nai Maromak la rona hau nia orasaun.<verse eid="PSA 66:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19" />Maibee Maromak rona duni;</para>
  <para style="q2" vid="PSA 66:19">Nia see tilun tiha ona ba hau nia orasaun.<verse eid="PSA 66:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20" />Hahii Maromak,</para>
  <para style="q2" vid="PSA 66:20">tanba Nia nunka fila kotuk ba hau nia orasaun;</para>
  <para style="q2" vid="PSA 66:20">Nia la hakotu Nia domin rohan-laek mai hau.<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="s">Agradese ba Nai Maromak tanba hetan bensaun oi-oin</para>
  <para style="d">Salmu. Kantiku ida, akompanha ho viola, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1" />Maromak, hanoin ami no foo bensaun ba ami;</para>
  <para style="q2" vid="PSA 67:1">halo Ita Boot nia oin nabilan leno ami,<verse eid="PSA 67:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2" />atu nunee ema iha mundu nee bele hatene Ita Boot nia dalan;</para>
  <para style="q2" vid="PSA 67:2">nasaun hotu-hotu bele rekonhese Ita Boot nia kbiit atu salva ema.<verse eid="PSA 67:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3" />Maromak, hau harohan atu povu hotu-hotu hahii Ita Boot;</para>
  <para style="q2" vid="PSA 67:3">nasaun hotu-hotu hahii Ita Boot.<verse eid="PSA 67:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4" />Halo nasaun sira nee kontenti hodi hananu haksolok,</para>
  <para style="q2" vid="PSA 67:4">tanba Ita Boot ukun ema ho justisa</para>
  <para style="q2" vid="PSA 67:4">no hatudu dalan ba nasaun sira iha mundu.<verse eid="PSA 67:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5" />Maromak, hau harohan atu povu hotu-hotu hahii Ita Boot;</para>
  <para style="q2" vid="PSA 67:5">nasaun hotu-hotu hahii Ita Boot.<verse eid="PSA 67:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6" />Toos foo tiha ona nia rezultadu;</para>
  <para style="q2" vid="PSA 67:6">Maromak, ita nia Maromak, foo ona bensaun ba ita.<verse eid="PSA 67:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7" />Maromak foo bensaun ba ita,</para>
  <para style="q2" vid="PSA 67:7">atu ema husi rai ulun too rai ikun iha mundu tomak hamtauk Nia.<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="s">Israel haklalak tanba manaan funu</para>
  <para style="d">Salmu David nian. Kantiku ida, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1" />Bainhira Maromak hamriik, Nia inimigu sira halai namkari;</para>
  <para style="q2" vid="PSA 68:1">Nia funu baluk sira halai sees husi Nia oin.<verse eid="PSA 68:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2" />Nia huu lakon tiha sira hanesan huu ahi suar;</para>
  <para style="q2" vid="PSA 68:2">ema aat sira sei mate mohu iha Maromak nia oin</para>
  <para style="q2" vid="PSA 68:2">hanesan lilin nebee nabeen bainhira besik ahi.<verse eid="PSA 68:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3" />Maibee ema moris loos haksolok;</para>
  <para style="q2" vid="PSA 68:3">sira kontenti iha Maromak nia oin;</para>
  <para style="q2" vid="PSA 68:3">sira haklalak ho haksolok.<verse eid="PSA 68:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4" />Hananu ba Maromak;</para>
  <para style="q2" vid="PSA 68:4">hananu hahii Nia naran.</para>
  <para style="q1" vid="PSA 68:4">Nia tuur iha kalohan leten;</para>
  <para style="q2" vid="PSA 68:4">foti aas Nia naran ba!</para>
  <para style="q1" vid="PSA 68:4">Nia naran mak NAI;</para>
  <para style="q2" vid="PSA 68:4">haksolok haklalak iha Nia oin ba!<verse eid="PSA 68:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5" />Maromak iha hela Nia fatin santu, Nia mak aman ba oan kiak sira;</para>
  <para style="q2" vid="PSA 68:5">Nia mak defende feto faluk sira.<verse eid="PSA 68:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6" />Maromak foo uma ba ema nebee mak la iha maluk;</para>
  <para style="q2" vid="PSA 68:6">Nia hasai ema dadur sira hodi foo moris diak ba sira,</para>
  <para style="q2" vid="PSA 68:6">maibee kontra door sira hela deit iha rai fuik maran.<verse eid="PSA 68:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7" />Maromak, bainhira Ita Boot lao iha Ita Boot nia povu nia oin;</para>
  <para style="q2" vid="PSA 68:7">bainhira Ita Boot marxa liu husi rai fuik maran,<verse eid="PSA 68:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">68:8 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 19:18">Ézodu 19:18</ref>
      </char>
    </note>rai nakdoko, lalehan mos hatuun udan</para>
  <para style="q2" vid="PSA 68:8">tanba Sinai nia Maromak mai tiha ona;</para>
  <para style="q2" vid="PSA 68:8">Israel nia Maromak too tiha ona.<verse eid="PSA 68:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9" />Maromak, Ita Boot hatuun udan boot mai</para>
  <para style="q2" vid="PSA 68:9">hodi halo Ita Boot nia rai nebee maran dekor sai matak fali ona.<verse eid="PSA 68:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10" />Nunee Ita Boot nia povu hela metin iha nebaa;</para>
  <para style="q2" vid="PSA 68:10">Maromak, Ita Boot habosu tiha ona ema kbiit-laek sira tanba Ita Boot laran diak.<verse eid="PSA 68:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11" />Nai Maromak hatuun Nia orden;</para>
  <para style="q2" vid="PSA 68:11">feto barak mos hatutan Nia liafuan dehan,<verse eid="PSA 68:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12" />“Liurai sira ho militar sira halai hotu!”</para>
  <para style="q2" vid="PSA 68:12">Sasaan nebee tropas sira hadau, feto sira iha uma mak fahe ba malu.<verse eid="PSA 68:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13" />Too ema nebee toba deit iha bibi luhan mos</para>
  <para style="q2" vid="PSA 68:13">simu manu pombu, nia liras taka ho osan mutin,</para>
  <para style="q2" vid="PSA 68:13">nia fulun osan mean nebee nabilan.<verse eid="PSA 68:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14" />Maromak Kbiit Nain halo liurai sira namkari</para>
  <para style="q2" vid="PSA 68:14">hanesan neve nebee monu iha foho Zalmon leten.<verse eid="PSA 68:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15" />Foho Basán, foho boot;</para>
  <para style="q2" vid="PSA 68:15">foho Basán, foho nebee iha tutun barak.<verse eid="PSA 68:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16" />Foho tutun barak nee,</para>
  <para style="q2" vid="PSA 68:16">tansaa mak o laran moras</para>
  <para style="q1" vid="PSA 68:16">ba foho nebee Maromak hili atu sai Nia hela fatin?</para>
  <para style="q2" vid="PSA 68:16">NAI Maromak sei hela iha nebaa tinan ba tinan.<verse eid="PSA 68:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17" />Maromak nia kuda kareta rihun ba rihun,</para>
  <para style="q2" vid="PSA 68:17">tokon ba tokon;</para>
  <para style="q1" vid="PSA 68:17">Nai Maromak mai tiha ona husi Sinai, tama iha fatin santu.<verse eid="PSA 68:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">68:18 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:8">Éfezu 4:8</ref>
      </char>
    </note>Bainhira Nia sae ba iha fatin aas,</para>
  <para style="q2" vid="PSA 68:18">Nia lori inimigu sira nebee Nia kaer iha funu laran;</para>
  <para style="q1" vid="PSA 68:18">Nia simu prezenti husi ema,</para>
  <para style="q2" vid="PSA 68:18">too ema kontra door sira mos foo prezenti.</para>
  <para style="q2" vid="PSA 68:18">Depois NAI Maromak hela iha nebaa.<verse eid="PSA 68:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19" />Hahii Nai Maromak, ita nia Salvador;</para>
  <para style="q2" vid="PSA 68:19">loro-loron Nia lori ita nia naha.<verse eid="PSA 68:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20" />Ita nia Maromak nee Maromak Salvador;</para>
  <para style="q2" vid="PSA 68:20">NAI Maromak Kbiit Nain hasai ita husi mate.<verse eid="PSA 68:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21" />Tebes duni, Maromak sei baku rahun tiha Nia inimigu sira nia ulun;</para>
  <para style="q2" vid="PSA 68:21">ema sira nebee moris nafatin iha sala laran, Maromak sei halo rahun tiha sira nia ulun fatuk.<verse eid="PSA 68:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22" />Nai hatete, “Hau sei lori inimigu sira mai husi rai Basán;</para>
  <para style="q2" vid="PSA 68:22">sira nebee iha tasi kidun mos, Hau sei lori hotu<verse eid="PSA 68:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23" />atu o nia ain bele sama iha funu baluk sira nee nia raan,</para>
  <para style="q2" vid="PSA 68:23">no o nia asu sira mos lambe hotu.”<verse eid="PSA 68:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24" />Maromak, ami haree Ita Boot nia prosisaun lao mai;</para>
  <para style="q2" vid="PSA 68:24">Hau nia Maromak, hau nia Liurai, Ita Boot nia prosisaun lao ba iha fatin santu.<verse eid="PSA 68:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25" />Koru lao iha oin, tokador sira toka husi kotuk;</para>
  <para style="q2" vid="PSA 68:25">iha klaran feto klosan sira baku babadook.<verse eid="PSA 68:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26" />Sira kanta, “Hahii Maromak iha ema lubuk boot nia leet;</para>
  <para style="q2" vid="PSA 68:26">Israel oan sira, hahii NAI Maromak ba.”<verse eid="PSA 68:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27" />Haree ba, suku kiik Benjamim lao uluk iha prosisaun;</para>
  <para style="q2" vid="PSA 68:27">nai ulun Judá sira lao hamutuk;</para>
  <para style="q2" vid="PSA 68:27">nai ulun Zebulón ho nai ulun Naftali lao tuir.<verse eid="PSA 68:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28" />Maromak, manda Ita Boot nia kbiit ba;</para>
  <para style="q2" vid="PSA 68:28">Maromak, hatudu Ita Boot nia forsa mai ami hanesan uluk Ita Boot hatudu tiha ona.<verse eid="PSA 68:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29" />Bainhira Ita Boot sai mai husi Ita Boot nia uma kreda iha Jerusalém,</para>
  <para style="q2" vid="PSA 68:29">liurai sira lori oferta ba Ita Boot.<verse eid="PSA 68:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30" />Siak tiha animal fuik sira nebee subar hela iha duut manulain nia laran;</para>
  <para style="q2" vid="PSA 68:30">hasee makaas karau aman forti sira nebee helik iha karau oan nia leet.</para>
  <para style="q1" vid="PSA 68:30">Sama hanehan tiha sira nebee mak duni tuir osan mutin;</para>
  <para style="q2" vid="PSA 68:30">duni lakon tiha nasaun sira nebee mak gosta funu.<verse eid="PSA 68:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31" />Ema lori sasaan folin karun husi rai Ejitu;</para>
  <para style="q2" vid="PSA 68:31">rai Etiópia sei lolo liman ba Maromak.<verse eid="PSA 68:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32" />Imi povu husi nasaun hotu-hotu, hananu ba Maromak;</para>
  <para style="q2" vid="PSA 68:32">hananu hahii Nai Maromak ba.<verse eid="PSA 68:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33" />Nia sae kuda haleu kalohan antigu nian;</para>
  <para style="q2" vid="PSA 68:33">rona ba, Nia lian sai mai boot makaas hanesan rai tarutu.<verse eid="PSA 68:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34" />Foo sai Maromak nia kbiit;</para>
  <para style="q2" vid="PSA 68:34">Nia ukun iha Israel;</para>
  <para style="q2" vid="PSA 68:34">Nia forsa iha kalohan laran.<verse eid="PSA 68:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35" />Maromak nee makaas iha Nia fatin santu;</para>
  <para style="q2" vid="PSA 68:35">Israel nia Maromak foo forsa ho kbiit ba Nia povu.</para>
  <para style="b" vid="PSA 68:35" />
  <para style="q1" vid="PSA 68:35">Hahii Maromak!<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="s">Orasaun bainhira iha susar laran</para>
  <para style="d">Salmu David nian, tuir muzika “Ai funan liriu.” Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1" />Maromak, salva hau,</para>
  <para style="q2" vid="PSA 69:1">tanba bee sae too tiha ona hau nia kakorok.<verse eid="PSA 69:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2" />Hau mout iha tahu been naruk laran;</para>
  <para style="q2" vid="PSA 69:2">hau nia ain la sama metin ba rai.</para>
  <para style="q1" vid="PSA 69:2">Hau iha hela bee boot laran;</para>
  <para style="q2" vid="PSA 69:2">korenti makaas atu halo hau mout.<verse eid="PSA 69:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3" />Hau halerik husu tulun too fraku ona;</para>
  <para style="q2" vid="PSA 69:3">hau nia kakorok sai maran tiha;</para>
  <para style="q1" vid="PSA 69:3">hau hein Maromak nia tulun</para>
  <para style="q2" vid="PSA 69:3">too hau nia matan sai kole tiha.<verse eid="PSA 69:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">69:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:19">Salmu 35:19</ref>; <ref loc="JHN 15:25">João 15:25</ref></char>
    </note>Ema odi hau maski hau la halo aat ba sira;</para>
  <para style="q2" vid="PSA 69:4">sira nee barak liu fali hau nia fuuk lahan.</para>
  <para style="q1" vid="PSA 69:4">Ema barak loos sai hau nia inimigu maski hau la halo sala hasoru sira;</para>
  <para style="q2" vid="PSA 69:4">sira hakarak atu halakon hau nia vida.</para>
  <para style="q1" vid="PSA 69:4">Sira eziji hau atu foo fali sira nia sasaan;</para>
  <para style="q2" vid="PSA 69:4">afinal hau nunka hadau buat ida husi sira.<verse eid="PSA 69:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5" />Maromak, Ita Boot hatene hau nee ema beik ida;</para>
  <para style="q2" vid="PSA 69:5">Ita Boot haree mo-moos hau nia sala.<verse eid="PSA 69:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6" />NAI, Nai Maromak Aswain,</para>
  <para style="q2" vid="PSA 69:6">keta husik ema nebee laran metin ba Ita Boot sai moe bainhira haree hau.</para>
  <para style="q1" vid="PSA 69:6">Israel nia Maromak,</para>
  <para style="q2" vid="PSA 69:6">keta husik ema nebee buka Ita Boot sai moe too oin tuun tanba hau.<verse eid="PSA 69:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7" />Ema tarata hau tanba hau tuir Ita Boot;</para>
  <para style="q2" vid="PSA 69:7">sira hamoe hau aat loos.<verse eid="PSA 69:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8" />Hau sai tiha ona ema fuik ba hau nia familia rasik;</para>
  <para style="q2" vid="PSA 69:8">hau sai ema leet ba hau nia maun-alin sira.<verse eid="PSA 69:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">69:9 a </char>
      <char style="xt" closed="false">
        <ref loc="JHN 2:17">João 2:17</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:3">Roma 15:3</ref>
      </char>
    </note>Hau foo aan tomak hodi defende Ita Boot nia uma, maski ida nee lori hau ba mate;</para>
  <para style="q2" vid="PSA 69:9">ema hatete aat Ita Boot, sira nia liafuan kona hotu hau.<verse eid="PSA 69:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10" />Bainhira hau haraik aan ho jejun,</para>
  <para style="q2" vid="PSA 69:10">ema insulta fali hau;<verse eid="PSA 69:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11" />bainhira hau tau hena lutu,</para>
  <para style="q2" vid="PSA 69:11">ema soe piadas mai hau.<verse eid="PSA 69:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12" />Ema nebee tuur iha portaun sidade nian konta hau nia vida;</para>
  <para style="q2" vid="PSA 69:12">ema lanu-teen sira mos kanta kona ba hau.<verse eid="PSA 69:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13" />Maibee NAI Maromak, hau harohan ba Ita Boot;</para>
  <para style="q2" vid="PSA 69:13">Maromak, iha tempu nebee Ita Boot desidi,</para>
  <para style="q2" vid="PSA 69:13">hataan hau hodi salva hau</para>
  <para style="q1" vid="PSA 69:13">tanba Ita Boot nia domin boot teb-tebes</para>
  <para style="q2" vid="PSA 69:13">no Ita Boot sempre halo buat nebee loos.<verse eid="PSA 69:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14" />Hasai hau husi tahu laran;</para>
  <para style="q2" vid="PSA 69:14">keta husik hau mout.</para>
  <para style="q1" vid="PSA 69:14">Salva hau husi ema nebee mak odi hau;</para>
  <para style="q2" vid="PSA 69:14">dada sai hau husi bee naruk laran.<verse eid="PSA 69:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15" />Keta husik mota boot halo mout hau</para>
  <para style="q2" vid="PSA 69:15">ka bee naruk tolan hau;</para>
  <para style="q2" vid="PSA 69:15">keta husik rai kuak naruk taka tiha hau.<verse eid="PSA 69:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16" />NAI Maromak, hataan hau, tanba Ita Boot nia domin rohan-laek nee diak;</para>
  <para style="q2" vid="PSA 69:16">Ita Boot laran luak teb-tebes, see oin mai hau.<verse eid="PSA 69:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17" />Keta subar Ita Boot nia oin ba Ita atan hau;</para>
  <para style="q2" vid="PSA 69:17">hau iha hela susar laran, hataan ho lalais ba.<verse eid="PSA 69:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18" />Mai besik hau hodi foo liberdade mai hau;</para>
  <para style="q2" vid="PSA 69:18">salva hau husi hau nia inimigu sira.<verse eid="PSA 69:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19" />Ita Boot hatene katak ema hatete aat hau,</para>
  <para style="q2" vid="PSA 69:19">ema hamoe hau no hafoer hau nia naran;</para>
  <para style="q2" vid="PSA 69:19">hau nia inimigu sira, Ita Boot hatene hotu.<verse eid="PSA 69:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20" />Sira nia liafuan aat kona ba hau halo hau laran dodok</para>
  <para style="q2" vid="PSA 69:20">too hau lakon esperansa;</para>
  <para style="q1" vid="PSA 69:20">hau hein atu ema hanoin netik hau, maibee la iha;</para>
  <para style="q2" vid="PSA 69:20">hau hein atu ema foo korajen mai hau, maibee ida mos la mosu.<verse eid="PSA 69:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">69:21 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:48">Mateus 27:48</ref>; <ref loc="MRK 15:36">Marcos 15:36</ref>; <ref loc="LUK 23:26">Lucas 23:26</ref>; <ref loc="JHN 19:28">João 19:28</ref>,<ref loc="JHN 19:29">29</ref></char>
    </note>Sira kahur buat moruk ba hau nia hahaan;</para>
  <para style="q2" vid="PSA 69:21">bainhira hau hamrook, sira foo fali tua siin.<verse eid="PSA 69:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">69:22 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 11:9">Roma 11:9</ref>,<ref loc="ROM 11:10">10</ref></char>
    </note>Hau harohan atu hahaan nebee prepara hela iha sira nia oin sai lasu ba sira;</para>
  <para style="q2" vid="PSA 69:22">husik sira nia selebrasaun sai fali rai kuak ba sira.<verse eid="PSA 69:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23" />Husik sira nia matan sai delek atu sira la bele haree;</para>
  <para style="q2" vid="PSA 69:23">husik sira lori todan too sira nia kotuk bonko tinan ba tinan.<verse eid="PSA 69:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24" />Fakar tiha Ita Boot nia hirus ba iha sira nia leten;</para>
  <para style="q2" vid="PSA 69:24">husik Ita Boot nia laran nakali kona sira ba.<verse eid="PSA 69:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25" />
    <note caller="+" style="x">
      <char style="xo" closed="false">69:25 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:20">Apostolu sira nia Istoria 1:20</ref>
      </char>
    </note>Husik sira nia fatin sai fuik;</para>
  <para style="q2" vid="PSA 69:25">la iha ema ida hela tan iha sira nia tenda laran.<verse eid="PSA 69:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26" />Tanba ema nebee mak Ita Boot baku, sira halo nia terus tan;</para>
  <para style="q2" vid="PSA 69:26">ema nebee Ita Boot hakanek, sira konta ba-mai kona ba nia terus.<verse eid="PSA 69:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27" />Foo sai sira nia sala ida-ida;</para>
  <para style="q2" vid="PSA 69:27">la bele salva tan sira.<verse eid="PSA 69:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">69:28 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 32:32">Ézodu 32:32</ref>; <ref loc="REV 3:5">Apokalipse 3:5</ref>, <ref loc="REV 13:8">13:8</ref>, <ref loc="REV 17:8">17:8</ref></char>
    </note>Hasai tiha sira nia naran husi lista ema moris nian;</para>
  <para style="q2" vid="PSA 69:28">keta husik sira nia naran hakerek hamutuk ho ema nebee mak moris loos.<verse eid="PSA 69:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29" />Maibee hau nee terus ho laran susar;</para>
  <para style="q2" vid="PSA 69:29">Maromak, foo Ita Boot nia salvasaun hodi hamahon hau.<verse eid="PSA 69:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30" />Depois hau sei kanta hodi hahii Maromak;</para>
  <para style="q2" vid="PSA 69:30">hau sei agradese hodi foti aas Nia naran.<verse eid="PSA 69:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31" />Ida nee sei halo haksolok NAI Maromak nia laran liu fali oferta karau aman,</para>
  <para style="q2" vid="PSA 69:31">liu fali sakrifisiu karau aman dikur naruk.<verse eid="PSA 69:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32" />Bainhira ema mukit haree hau hahii Maromak, sira sei kontenti;</para>
  <para style="q2" vid="PSA 69:32">imi nebee adora Maromak, laran metin fali ba.<verse eid="PSA 69:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33" />Tanba NAI Maromak rona ema nebee kiak;</para>
  <para style="q2" vid="PSA 69:33">Nia la fila kotuk ba Nia ema sira nebee mak iha dadur laran.<verse eid="PSA 69:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34" />Lalehan ho rai, hahii Nia ba;</para>
  <para style="q2" vid="PSA 69:34">tasi ho buat hotu nebee moris iha laran, hahii Nia ba!<verse eid="PSA 69:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35" />Tanba Maromak sei salva Siaun;</para>
  <para style="q2" vid="PSA 69:35">Nia sei harii fali sidade sira nebee mak iha rai Judá,</para>
  <para style="q1" vid="PSA 69:35">depois Nia povu sei hela iha nebaa</para>
  <para style="q2" vid="PSA 69:35">hodi sai nain ba rai.<verse eid="PSA 69:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36" />Too Nia atan sira nia jerasaun mos sei sai nain nafatin ba rai nee;</para>
  <para style="q2" vid="PSA 69:36">ema nebee hadomi Nia naran sei hela iha nebaa.<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="s">Orasaun husu tulun ba Nai Maromak</para>
  <para style="d">Salmu David nian, husu atu Maromak hanoin nia. Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1" />Maromak, favor salva hau;</para>
  <para style="q2" vid="PSA 70:1">NAI, mai lalais tulun hau.<verse eid="PSA 70:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2" />Hau harohan atu ema nebee hakarak hasai hau nia vida,</para>
  <para style="q2" vid="PSA 70:2">sai moe boot ho oin tuun;</para>
  <para style="q1" vid="PSA 70:2">husik ema nebee hakarak atu hau hetan dezastre,</para>
  <para style="q2" vid="PSA 70:2">hakiduk ho naran aat.<verse eid="PSA 70:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3" />Husik ema nebee hamnasa hahaek mai hau</para>
  <para style="q2" vid="PSA 70:3">fila ho moe boot.<verse eid="PSA 70:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4" />Maibee halo ema hotu nebee harohan ba Ita Boot</para>
  <para style="q2" vid="PSA 70:4">sai kontenti ho haksolok;</para>
  <para style="q1" vid="PSA 70:4">husik ema nebee buka Ita Boot nia salvasaun</para>
  <para style="q2" vid="PSA 70:4">dehan beibeik, “Maromak nee boot!”<verse eid="PSA 70:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5" />Hau nee ema kiak ho kbiit-laek;</para>
  <para style="q2" vid="PSA 70:5">Maromak, mai lalais ona.</para>
  <para style="q1" vid="PSA 70:5">Ita Boot mak tulun hau no salva hau;</para>
  <para style="q2" vid="PSA 70:5">NAI, keta demora.<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="s">Katuas ida harohan atu Nai Maromak proteje</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1" />NAI Maromak, hau hamahon aan iha Ita Boot;</para>
  <para style="q2" vid="PSA 71:1">keta husik hau moe leet.<verse eid="PSA 71:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2" />Ita Boot sempre halo buat nebee loos;</para>
  <para style="q2" vid="PSA 71:2">salva hau ba, hasai tiha hau husi susar laran;</para>
  <para style="q2" vid="PSA 71:2">see tilun mai hau hodi salva hau.<verse eid="PSA 71:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3" />Ita Boot mak fatuk lolon boot, husik hau helik ba;</para>
  <para style="q2" vid="PSA 71:3">hatuun orden atu salva hau,</para>
  <para style="q1" vid="PSA 71:3">tanba Ita Boot mak fatuk kuak nebee hau subar iha laran;</para>
  <para style="q2" vid="PSA 71:3">Ita Boot mak lutu haleu hau.<verse eid="PSA 71:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4" />Hau nia Maromak, hasai tiha hau husi ema aat sira nia liman laran;</para>
  <para style="q2" vid="PSA 71:4">salva hau husi ema laran aat ho hanehan door sira.<verse eid="PSA 71:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5" />Nai Maromak, Ita Boot mak hau nia esperansa;</para>
  <para style="q2" vid="PSA 71:5">NAI, husi joven kedas hau konfia Ita Boot.<verse eid="PSA 71:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6" />Husi kedas hau moris mai, hau sadere nanis ona ba Ita Boot;</para>
  <para style="q2" vid="PSA 71:6">husi hau nia inan nia kabun laran, Ita Boot tau matan mai hau.</para>
  <para style="q2" vid="PSA 71:6">Hau sempre hahii Ita Boot.<verse eid="PSA 71:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7" />Hau sai tiha ona ezemplu ba ema barak;</para>
  <para style="q2" vid="PSA 71:7">Ita Boot mak fatin seguru diak nian mai hau.<verse eid="PSA 71:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8" />Hau nia ibun sempre hahii Ita Boot;</para>
  <para style="q2" vid="PSA 71:8">iha loron tomak hau haklaken Ita Boot nia furak.<verse eid="PSA 71:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9" />Keta soe hau bainhira hau idade ona;</para>
  <para style="q2" vid="PSA 71:9">keta husik hau bainhira hau nia forsa hotu.<verse eid="PSA 71:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10" />Tanba hau nia inimigu sira hatete aat hau;</para>
  <para style="q2" vid="PSA 71:10">ema nebee hein atu oho hau, sira kombina malu hela.<verse eid="PSA 71:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11" />Sira dehan, “Maromak husik ona nia.</para>
  <para style="q2" vid="PSA 71:11">Mai ita duni nia hodi kaer tiha nia,</para>
  <para style="q2" vid="PSA 71:11">tanba la iha ida mak atu salva nia.”<verse eid="PSA 71:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12" />Hau nia Maromak, keta dook husi hau;</para>
  <para style="q2" vid="PSA 71:12">Maromak, mai lalais tulun hau.<verse eid="PSA 71:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13" />Hau harohan atu ema nebee kontra hau, Ita Boot hatuun sira hodi halo sira lakon;</para>
  <para style="q2" vid="PSA 71:13">husik ema nebee mak hakarak halo aat hau, sai moe boot ho oin tuun.<verse eid="PSA 71:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14" />Maibee hau nee sempre laran metin ba Ita Boot;</para>
  <para style="q2" vid="PSA 71:14">hau sei kontinua hahii Ita Boot liu tan.<verse eid="PSA 71:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15" />Hau nia ibun sei foo sai buat diak nebee Ita Boot halo tiha ona;</para>
  <para style="q2" vid="PSA 71:15">loron-kalan hau sei foo sai Ita Boot nia salvasaun,</para>
  <para style="q2" vid="PSA 71:15">maski hau sura la bele.<verse eid="PSA 71:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16" />NAI Maromak Kbiit Nain, hau sei gaba buat makaas nebee Ita Boot halo;</para>
  <para style="q2" vid="PSA 71:16">hau sei gaba Ita Boot nia justisa, so Ita Boot nian deit.<verse eid="PSA 71:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17" />Maromak, husi kedas hau joven, Ita Boot hanorin ona hau;</para>
  <para style="q2" vid="PSA 71:17">too agora hau foo sai nafatin buat furak nebee Ita Boot halo.<verse eid="PSA 71:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18" />Maromak, agora hau katuas fuuk mutin ona,</para>
  <para style="q2" vid="PSA 71:18">keta husik hau mesak,</para>
  <para style="q1" vid="PSA 71:18">atu hau foo sai Ita Boot nia kbiit ba jerasaun tuir mai,</para>
  <para style="q2" vid="PSA 71:18">atu hau konta Ita Boot nia forsa ba ema hotu nebee sei moris aban-bainrua.<verse eid="PSA 71:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19" />Maromak, Ita Boot nia justisa too iha lalehan;</para>
  <para style="q2" vid="PSA 71:19">Ita Boot halo buat mesak boot.</para>
  <para style="q2" vid="PSA 71:19">Maromak, see mak hanesan Ita Boot?<verse eid="PSA 71:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20" />Maski Ita Boot halo hau terus ho susar barak,</para>
  <para style="q2" vid="PSA 71:20">Ita Boot sei halo hau moris fali;</para>
  <para style="q1" vid="PSA 71:20">hau too iha rai kuak laran mos,</para>
  <para style="q2" vid="PSA 71:20">Ita Boot sei dada hau sai.<verse eid="PSA 71:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21" />Ita Boot sei halo hau nia naran boot liu fali uluk;</para>
  <para style="q2" vid="PSA 71:21">Ita Boot sei foo ksolok fali mai hau.<verse eid="PSA 71:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22" />Hau nia Maromak, hau sei toka viola hodi hahii Ita Boot,</para>
  <para style="q2" vid="PSA 71:22">tanba Ita Boot sempre kaer metin Ita Boot nia liafuan.</para>
  <para style="q1" vid="PSA 71:22">Israel nia Maromak santu,</para>
  <para style="q2" vid="PSA 71:22">hau sei hananu hahii Ita Boot ho muzika viola tali walu.<verse eid="PSA 71:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23" />Hau nia ibun sei haklalak ho haksolok;</para>
  <para style="q2" vid="PSA 71:23">hau sei hananu hahii Ita Boot,</para>
  <para style="q2" vid="PSA 71:23">tanba Ita Boot salva tiha ona hau.<verse eid="PSA 71:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24" />Loron-kalan hau nia ibun sei koalia sai Ita Boot nia justisa,</para>
  <para style="q2" vid="PSA 71:24">tanba ema sira nebee hakarak halo aat hau</para>
  <para style="q2" vid="PSA 71:24">sai moe boot ho oin tuun tiha.<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="s">Orasaun ba liurai</para>
  <para style="d">Salmu Salomão nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1" />Maromak, hanorin Ita Boot nia justisa ba liurai;</para>
  <para style="q2" vid="PSA 72:1">hanorin Ita Boot nia lia loos ba liurai oan,<verse eid="PSA 72:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2" />atu liurai bele foo justisa ba Ita Boot nia povu tuir dalan loos,</para>
  <para style="q2" vid="PSA 72:2">atu nia bele tesi lia lo-loos ba Ita Boot nia ema nebee kbiit-laek.<verse eid="PSA 72:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3" />Nunee foho sira nee sei buras hodi foo moris diak ba povu,</para>
  <para style="q2" vid="PSA 72:3">no ema iha rai nee bele moris loos.<verse eid="PSA 72:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4" />Hau harohan atu liurai bele defende ema kbiit-laek iha povu nia leet,</para>
  <para style="q2" vid="PSA 72:4">salva ema kiak nia oan,</para>
  <para style="q2" vid="PSA 72:4">no halakon tiha hanehan door sira.<verse eid="PSA 72:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5" />Hau harohan atu liurai dura hanesan loro matan,</para>
  <para style="q2" vid="PSA 72:5">dura hanesan fulan, husi jerasaun ba jerasaun.<verse eid="PSA 72:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6" />Halo liurai sai hanesan udan been monu tuun mai rai</para>
  <para style="q2" vid="PSA 72:6">hodi rega duut nebee foin lere.<verse eid="PSA 72:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7" />Durante nia ukun, halo ema moris loos sai buras</para>
  <para style="q2" vid="PSA 72:7">hodi moris diak, too fulan lakon tiha husi lalehan.<verse eid="PSA 72:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">72:8 </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 9:10">Zacarias 9:10</ref>
      </char>
    </note>Hau harohan atu liurai ukun husi tasi ba tasi,</para>
  <para style="q2" vid="PSA 72:8">husi Mota Eufrates too rai ulun rai ikun iha mundu tomak.<verse eid="PSA 72:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9" />Halo suku sira iha rai fuik maran hakneak hakruuk iha liurai nia oin;</para>
  <para style="q2" vid="PSA 72:9">halo nia inimigu sira lambe rai.<verse eid="PSA 72:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10" />Hau harohan atu liurai Tarsis ho liurai sira husi tasi balu</para>
  <para style="q2" vid="PSA 72:10">lori prezenti ba nia,</para>
  <para style="q1" vid="PSA 72:10">no liurai sira husi rai Sabá ho Seba</para>
  <para style="q2" vid="PSA 72:10">lori prezenti foo ba nia.<verse eid="PSA 72:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11" />Hau harohan atu liurai hotu-hotu hakneak hakruuk ba nia,</para>
  <para style="q2" vid="PSA 72:11">no nasaun hotu-hotu serbi nia.<verse eid="PSA 72:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12" />Tanba liurai salva ema kiak sira nebee halerik ba nia;</para>
  <para style="q2" vid="PSA 72:12">nia ajuda ema kbiit-laek sira nebee mak la iha ema atu tau matan.<verse eid="PSA 72:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13" />Nia hanoin ema kiik ho ema kiak sira</para>
  <para style="q2" vid="PSA 72:13">hodi salva sira nia moris.<verse eid="PSA 72:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14" />Nia salva sira husi ema nebee hanehan sira ho ema nebee halo violensia ba sira,</para>
  <para style="q2" vid="PSA 72:14">tanba sira nia moris folin boot iha nia matan.<verse eid="PSA 72:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15" />Viva liurai!</para>
  <para style="q2" vid="PSA 72:15">Hau harohan atu ema lori oferta osan mean husi rai Sabá foo ba liurai,</para>
  <para style="q1" vid="PSA 72:15">no ema sempre halo orasaun ba nia</para>
  <para style="q2" vid="PSA 72:15">hodi foo bensaun ba nia iha loron tomak.<verse eid="PSA 72:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16" />Hau harohan atu iha nia rai tomak iha hahaan barak;</para>
  <para style="q2" vid="PSA 72:16">iha foho tutun mos toos bele buras.</para>
  <para style="q1" vid="PSA 72:16">Hau husu atu ai fuan tebar hanesan iha rai Líbanu,</para>
  <para style="q2" vid="PSA 72:16">no nia povu iha sidade mos buras hanesan duut matak iha rai fuik.<verse eid="PSA 72:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17" />Hau harohan atu liurai nia naran dura ba nafatin,</para>
  <para style="q2" vid="PSA 72:17">dura hanesan loro matan iha lalehan.</para>
  <para style="q1" vid="PSA 72:17">Hau husu atu nasaun hotu-hotu hetan bensaun liu husi nia,</para>
  <para style="q2" vid="PSA 72:17">no ema bolu nia ema ida nebee hetan ksolok.<verse eid="PSA 72:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18" />Hahii NAI Maromak, Israel nia Maromak!</para>
  <para style="q2" vid="PSA 72:18">Nia mesak deit mak halo buat furak.<verse eid="PSA 72:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19" />Hahii, foti aas Nia naran tinan ba tinan.</para>
  <para style="q2" vid="PSA 72:19">Hau harohan atu Maromak nia kbiit hakonu mundu tomak.</para>
  <para style="q3" vid="PSA 72:19">Amen, amen.<verse eid="PSA 72:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="PSA 72:20" />Orasaun husi David, Jessé nia oan too iha nee deit.<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="s">Nai Maromak mak Justisa Nain</para>
  <para style="d">Salmu Asaf nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1" />Maromak nee diak ba Israel;</para>
  <para style="q2" vid="PSA 73:1">tebes, Nia diak ba ema nebee mak laran moos.<verse eid="PSA 73:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2" />Maibee hau nee, hau nia ain besik atu sidi;</para>
  <para style="q2" vid="PSA 73:2">uitoan tan hau atu monu ona,<verse eid="PSA 73:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3" />tanba hau laran moras ba ema nebee foti aan;</para>
  <para style="q2" vid="PSA 73:3">hau haree sira moris diak maski sira nia hahalok aat.<verse eid="PSA 73:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4" />Ema sira nee la hatene terus;</para>
  <para style="q2" vid="PSA 73:4">sira nia isin diak no forti.<verse eid="PSA 73:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5" />Sira la hetan susar nebee ema baibain hetan iha mundu nee;</para>
  <para style="q2" vid="PSA 73:5">dezastre la kona sira hanesan ema seluk.<verse eid="PSA 73:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6" />Tanba nee sira hahenu sira nia hahalok foti aan;</para>
  <para style="q2" vid="PSA 73:6">sira foo hatais sira nia aan ho violensia.<verse eid="PSA 73:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7" />Sira nia laran hakiak sala;</para>
  <para style="q2" vid="PSA 73:7">sira nia neon nakonu ho buat nebee la iha folin.<verse eid="PSA 73:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8" />Sira soe lia hodi hatete buat mesak aat;</para>
  <para style="q2" vid="PSA 73:8">sira foti aan hodi ameasa atu hanehan ema seluk.<verse eid="PSA 73:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9" />Sira loke ibun hodi kontra lalehan;</para>
  <para style="q2" vid="PSA 73:9">sira nia liafuan foti aan lao haleu mundu tomak.<verse eid="PSA 73:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10" />Tanba nee povu fila hodi tuir sira,</para>
  <para style="q2" vid="PSA 73:10">no fiar sira nia liafuan hotu.<verse eid="PSA 73:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11" />Sira dehan, “Oinsaa Maromak atu hatene buat sira nee?</para>
  <para style="q2" vid="PSA 73:11">Maromak Aas Liu hatene saida?”<verse eid="PSA 73:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12" />Ema aat sira hanesan nee duni;</para>
  <para style="q2" vid="PSA 73:12">sira sempre moris diak, sira nia riku-soin aumenta ba beibeik.<verse eid="PSA 73:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13" />Hau kuidadu beibeik atu moris ho laran moos,</para>
  <para style="q2" vid="PSA 73:13">maibee saugati deit;</para>
  <para style="q1" vid="PSA 73:13">hau fase hau nia liman hanesan sinal katak hau la sala ida,</para>
  <para style="q2" vid="PSA 73:13">maibee la vale buat ida.<verse eid="PSA 73:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14" />Tanba loron tomak hau terus hela deit;</para>
  <para style="q2" vid="PSA 73:14">iha dadeer-dadeer hau hetan kastigu.<verse eid="PSA 73:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15" />Se karik hau dehan nunee,</para>
  <para style="q2" vid="PSA 73:15">entaun hau hanesan fali traidor ba Ita Boot nia povu.<verse eid="PSA 73:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16" />Bainhira hau koko atu kompriende buat sira nee,</para>
  <para style="q2" vid="PSA 73:16">hau senti susar teb-tebes.<verse eid="PSA 73:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17" />Too hau tama iha Maromak nia uma kreda</para>
  <para style="q2" vid="PSA 73:17">mak foin hau kompriende ema sira nee nia destinu.<verse eid="PSA 73:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18" />Tebes duni, Ita Boot tau sira iha fatin namdoras;</para>
  <para style="q2" vid="PSA 73:18">Ita Boot halo sira monu too rahun tiha.<verse eid="PSA 73:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19" />Derepenti deit sira mohu;</para>
  <para style="q2" vid="PSA 73:19">sira tauk teb-tebes too tauk nee hamate fali sira.<verse eid="PSA 73:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20" />Sira hanesan mehi deit,</para>
  <para style="q2" vid="PSA 73:20">ita hadeer mai la iha tiha;</para>
  <para style="q1" vid="PSA 73:20">Nai Maromak, bainhira Ita Boot hamriik,</para>
  <para style="q2" vid="PSA 73:20">Ita Boot sei la hanoin tan sira.<verse eid="PSA 73:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21" />Bainhira hau nia laran senti tristi</para>
  <para style="q2" vid="PSA 73:21">no hau nia fuan moras,<verse eid="PSA 73:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22" />hau sai beik tiha, la kompriende buat ida;</para>
  <para style="q2" vid="PSA 73:22">hau nia hahalok hasoru Ita Boot hanesan fali animal fuik.<verse eid="PSA 73:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23" />Maski nunee hau nafatin besik Ita Boot;</para>
  <para style="q2" vid="PSA 73:23">Ita Boot kaer metin hau nia liman loos.<verse eid="PSA 73:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24" />Ita Boot hanorin hau no hatudu dalan mai hau;</para>
  <para style="q2" vid="PSA 73:24">too ikus Ita Boot sei simu hau hodi foti sae hau.<verse eid="PSA 73:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25" />Iha lalehan nebaa, Ita Boot mak tulun hau; se laos Ita Boot, see tan?</para>
  <para style="q2" vid="PSA 73:25">Iha mundu nee, hau hakarak mak Ita Boot deit.<verse eid="PSA 73:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26" />Hau nia isin ho hau nia laran bele sai fraku,</para>
  <para style="q2" vid="PSA 73:26">maibee Maromak mak hakbiit hau nia laran;</para>
  <para style="q2" vid="PSA 73:26">hau nia riku-soin mak Nia too tinan ba tinan.<verse eid="PSA 73:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27" />Ema nebee dook husi Ita Boot sei mate mohu;</para>
  <para style="q2" vid="PSA 73:27">Ita Boot harahun tiha ema nebee mak la foo laran ba Ita Boot.<verse eid="PSA 73:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28" />Maibee hau nee gosta liu besik Maromak;</para>
  <para style="q2" vid="PSA 73:28">hau hamahon aan iha NAI Maromak Kbiit Nain;</para>
  <para style="q2" vid="PSA 73:28">hau sei foo sai buat diak nebee Ita Boot halo.<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="s">Halerik ba Nai Maromak tanba uma kreda rahun</para>
  <para style="d">Salmu Asaf nian para hanorin ema.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1" />Maromak, tansaa mak Ita Boot soe ami nafatin ba nafatin?</para>
  <para style="q2" vid="PSA 74:1">Tansaa mak Ita Boot laran nakali hasoru Ita Boot nia bibi sira?<verse eid="PSA 74:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2" />Hori uluk kedas Ita Boot hili povu ida nee;</para>
  <para style="q2" vid="PSA 74:2">Ita Boot salva tiha ona povu nee sai Ita Boot nian;</para>
  <para style="q2" vid="PSA 74:2">hanoin fila fali ami ba!</para>
  <para style="q1" vid="PSA 74:2">Uluk Ita Boot hela iha foho Siaun;</para>
  <para style="q2" vid="PSA 74:2">hanoin fali fatin nee ba.<verse eid="PSA 74:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3" />Hakmaan Ita Boot nia ain lao ba iha fatin santu;</para>
  <para style="q2" vid="PSA 74:3">fatin nee rahun aat liu ona;</para>
  <para style="q2" vid="PSA 74:3">buat hotu-hotu inimigu estraga tiha ona.<verse eid="PSA 74:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4" />Ita Boot nia funu baluk haklalak ona iha Ita Boot nia fatin santu;</para>
  <para style="q2" vid="PSA 74:4">sira hasae tiha ona sira nia bandeira.<verse eid="PSA 74:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5" />Sira tama hanesan fali ema nebee kaer baliu</para>
  <para style="q2" vid="PSA 74:5">hodi tesi ai huun buras.<verse eid="PSA 74:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6" />Sira kaer baliu ho martelu</para>
  <para style="q2" vid="PSA 74:6">hodi sobu rahun tiha uma nia didin nebee ema bahat halo furak.<verse eid="PSA 74:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7" />Sira sunu mutuk tiha Ita Boot nia fatin santu too rai;</para>
  <para style="q2" vid="PSA 74:7">sira hafoer Ita Boot nia hela fatin.<verse eid="PSA 74:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8" />Sira hatete iha sira nia laran, “Mai ita hanehan makaas ema sira nee hotu!”</para>
  <para style="q2" vid="PSA 74:8">Fatin hotu-hotu nebee ema adora Maromak iha rai nee, sira sunu hotu ona.<verse eid="PSA 74:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9" />Ami la haree tan sinal husi Maromak;</para>
  <para style="q2" vid="PSA 74:9">profeta mos la iha ona;</para>
  <para style="q2" vid="PSA 74:9">ami sira nee la iha ida mak hatene bainhira mak hotu.<verse eid="PSA 74:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10" />Maromak, inimigu sira sei hatete aat Ita Boot too bainhira?</para>
  <para style="q2" vid="PSA 74:10">Funu baluk sira nee sei koalia aat Ita Boot nia naran nafatin ba nafatin ka?<verse eid="PSA 74:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11" />Tansaa mak Ita Boot dada fali Ita Boot nia liman loos?</para>
  <para style="q2" vid="PSA 74:11">Foti Ita Boot nia liman hodi halo mohu tiha sira ba.<verse eid="PSA 74:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12" />Maibee Maromak nee hau nia Liurai hori uluk kedas;</para>
  <para style="q2" vid="PSA 74:12">Ita Boot lori salvasaun ba mundu.<verse eid="PSA 74:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">74:13 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Ézodu 14:21</ref>
      </char>
    </note>Uluk Ita Boot hafahe tasi hodi Ita Boot nia kbiit;</para>
  <para style="q2" vid="PSA 74:13">Ita Boot mak fera samea boot nia ulun iha tasi laran.<verse eid="PSA 74:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">74:14 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 41:1">Job 41:1</ref>; <ref loc="PSA 104:26">Salmu 104:26</ref>; <ref loc="ISA 27:1">Isaias 27:1</ref></char>
    </note>Samea boot Leviatán nia ulun fatuk bar-barak, Ita Boot harahun tiha</para>
  <para style="q2" vid="PSA 74:14">hodi foo haan animal nebee hela iha rai fuik maran.<verse eid="PSA 74:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15" />Ita Boot loke tiha bee matan ho mota;</para>
  <para style="q2" vid="PSA 74:15">mota sira nebee suli la para, Ita Boot hamaran tiha.<verse eid="PSA 74:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16" />Loron Ita Boot nian, kalan mos Ita Boot nian;</para>
  <para style="q2" vid="PSA 74:16">Ita Boot hatuur fulan ho loro matan.<verse eid="PSA 74:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17" />Ita Boot tau mundu nia baliza;</para>
  <para style="q2" vid="PSA 74:17">tempu udan no tempu bailoron, Ita Boot halo rua nee hotu.<verse eid="PSA 74:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18" />NAI Maromak, keta haluha katak inimigu hamnasa fali Ita Boot;</para>
  <para style="q2" vid="PSA 74:18">ema beik-teen sira nee hatete aat Ita Boot nia naran.<verse eid="PSA 74:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19" />Keta entrega Ita Boot nia manu pombu<note caller="+" style="f"><char style="fr" closed="false">74:19 </char><char style="ft" closed="false">Matenek nain barak dehan, “manu pombu” hatudu ba povu Israel.</char></note> ba animal fuik;</para>
  <para style="q2" vid="PSA 74:19">keta haluha Ita Boot nia povu kbiit-laek sira tinan ba tinan.<verse eid="PSA 74:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20" />Hanoin nafatin Ita Boot nia promesa mai ami,</para>
  <para style="q2" vid="PSA 74:20">tanba fatin nakukun iha rai nee mesak violensia nia knuuk deit.<verse eid="PSA 74:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21" />Keta husik ema hamoe tan vitima sira;</para>
  <para style="q2" vid="PSA 74:21">halo ema kiak ho kbiit-laek hahii Ita Boot nia naran.<verse eid="PSA 74:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22" />Maromak, hamriik ba! Defende Ita Boot nia lia;</para>
  <para style="q2" vid="PSA 74:22">keta haluha katak ema beik-teen sira hatete aat Ita Boot iha loron tomak.<verse eid="PSA 74:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23" />Keta haluha Ita Boot nia inimigu sira nia lian;</para>
  <para style="q2" vid="PSA 74:23">ema nebee kontra Ita Boot hakilar la para.<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="s">Nai Maromak mak Justisa Nain</para>
  <para style="d">Salmu Asaf nian, tuir muzika “Keta halo rahun.” Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1" />Maromak, ami hahii Ita Boot.</para>
  <para style="q2" vid="PSA 75:1">Ami hahii Ita Boot tanba Ita Boot besik ami.</para>
  <para style="q2" vid="PSA 75:1">Ema konta sai buat furak nebee Ita Boot halo.<verse eid="PSA 75:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2" />Ita Boot dehan, “Hau hili tiha ona tempu atu foo justisa;</para>
  <para style="q2" vid="PSA 75:2">too tempu nee Hau sei tesi lia ho lo-loos.<verse eid="PSA 75:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3" />Bainhira mundu ho ema hotu iha mundu nakdoko,</para>
  <para style="q2" vid="PSA 75:3">Hau mak halo metin mundu nia huun.<verse eid="PSA 75:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4" />Ba ema nebee foti aan, Hau dehan, ‘Keta foti aan tan.’</para>
  <para style="q2" vid="PSA 75:4">Ba ema aat, Hau dehan, ‘Keta foti sae imi nia dikur.<verse eid="PSA 75:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5" />Keta foti sae imi nia dikur hasoru lalehan;</para>
  <para style="q2" vid="PSA 75:5">keta koalia kontra demais.’”<verse eid="PSA 75:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6" />La iha ema ida mak bele foti sae nia aan;</para>
  <para style="q2" vid="PSA 75:6">atu husi lorosae ka loromonu ka husi rai fuik maran, la bele hotu.<verse eid="PSA 75:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7" />Maromak mak Justisa Nain;</para>
  <para style="q2" vid="PSA 75:7">Nia mak hatuun ema balu no foti sae ema seluk.<verse eid="PSA 75:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8" />Iha NAI Maromak nia liman laran iha kopu ida</para>
  <para style="q2" vid="PSA 75:8">nakonu ho tua ulun;</para>
  <para style="q1" vid="PSA 75:8">Nia fui tua nee foo ba ema aat ida-idak iha mundu;</para>
  <para style="q2" vid="PSA 75:8">sira tenki hemu too tua nia teen hotu kedas.<verse eid="PSA 75:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9" />Maibee hau sei foo sai Maromak nia diak nafatin ba nafatin;</para>
  <para style="q2" vid="PSA 75:9">hau sei kanta hahii Jacó nia Maromak.<verse eid="PSA 75:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10" />Maromak dehan, “Hau sei tesi sai tiha ema aat sira nia dikur hotu,</para>
  <para style="q2" vid="PSA 75:10">maibee ema moris loos sira nia dikur, Hau sei foti sae.”<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="s">Nai Maromak manaan tiha ona Nia inimigu sira</para>
  <para style="d">Salmu Asaf nian. Kantiku ida, akompanha ho viola. Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1" />Maromak konhesidu iha rai Judá;</para>
  <para style="q2" vid="PSA 76:1">Nia naran boot iha Israel.<verse eid="PSA 76:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2" />Nia uma harii tiha ona iha Jerusalém;</para>
  <para style="q2" vid="PSA 76:2">Nia hela fatin iha Siaun.<verse eid="PSA 76:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3" />Iha nebaa Nia silu tohar ona inimigu nia rama oan nebee nabilan;</para>
  <para style="q2" vid="PSA 76:3">surik ho ekipamentu funu nian sel-seluk, Nia halo tohar hotu.<verse eid="PSA 76:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4" />Ita Boot nabilan furak tebes;</para>
  <para style="q2" vid="PSA 76:4">Ita Boot makaas liu fali foho nebee iha hori uluk kedas.<verse eid="PSA 76:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5" />Inimigu aswain sira nia sasaan ema hadau tiha;</para>
  <para style="q2" vid="PSA 76:5">inimigu sira nee toba latan tiha ona;</para>
  <para style="q2" vid="PSA 76:5">funu nain sira nia forsa lakon tiha ona.<verse eid="PSA 76:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6" />Jacó nia Maromak, Ita Boot nia lian makaas</para>
  <para style="q2" vid="PSA 76:6">halo kuda ho nia nain toba latan hotu.<verse eid="PSA 76:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7" />Ita Boot makaas teb-tebes!</para>
  <para style="q2" vid="PSA 76:7">Bainhira Ita Boot hirus, see mak aguenta hamriik iha Ita Boot nia oin?<verse eid="PSA 76:7" /></para>
  <para style="q1">
    <verse number="8-9" style="v" sid="PSA 76:8-9" />Maromak, Ita Boot hamriik tiha ona hodi foo justisa,</para>
  <para style="q2" vid="PSA 76:8-9">atu salva ema mukit sira hotu iha mundu.</para>
  <para style="q1" vid="PSA 76:8-9">Bainhira Ita Boot hatuun Ita Boot nia desizaun husi lalehan,</para>
  <para style="q2" vid="PSA 76:8-9">mundu tauk hodi nonook tiha.<verse eid="PSA 76:8-9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10" />Ema bele hirus mos, sira sei hahii liu tan Ita Boot;</para>
  <para style="q2" vid="PSA 76:10">mate restu sira sei adora Ita Boot.<note caller="+" style="f"><char style="fr" closed="false">76:10 </char><char style="ft" closed="false">Lian Ebreu iha versikulu nee, signifikadu la klaru.</char></note><verse eid="PSA 76:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11" />Halo promesa ba NAI o nia Maromak, no halo tuir promesa nee;</para>
  <para style="q2" vid="PSA 76:11">ema hotu nebee hela haleu Nia, lori imi nia oferta foo ba Ida nebee halo ema tauk.<verse eid="PSA 76:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12" />Nia halo ukun nain sira lakon esperansa;</para>
  <para style="q2" vid="PSA 76:12">liurai sira iha mundu hamtauk Nia.<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="s">Iha tempu susar, hanoin Nai Maromak nia diak uluk nian</para>
  <para style="d">Salmu Asaf nian, ba dirijenti koru Jedutun.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1" />Hau halerik husu tulun ba Maromak;</para>
  <para style="q2" vid="PSA 77:1">hau halerik ba Maromak atu Nia rona hau.<verse eid="PSA 77:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2" />Iha susar laran, hau buka Nai Maromak;</para>
  <para style="q2" vid="PSA 77:2">kalan-kalan hau lolo liman la kole,</para>
  <para style="q2" vid="PSA 77:2">maibee hau la hetan ksolok.<verse eid="PSA 77:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3" />Bainhira hau hanoin kona ba Maromak, hau halerik;</para>
  <para style="q2" vid="PSA 77:3">bainhira hau medita, hau lakon esperansa liu tan.<verse eid="PSA 77:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4" />Ita Boot halo hau toba la dukur;</para>
  <para style="q2" vid="PSA 77:4">hau laran susar too hau la iha liafuan.<verse eid="PSA 77:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5" />Hau hanoin fila fali loron uluk nian;</para>
  <para style="q2" vid="PSA 77:5">hau hanoin hetan tempu uluk nian.<verse eid="PSA 77:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6" />Iha tempu nebaa hau kanta iha oras kalan.</para>
  <para style="q2" vid="PSA 77:6">Agora hau nia laran medita, hau husu ba hau nia aan,<verse eid="PSA 77:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7" />“Nai Maromak soe tiha ona ita nafatin ba nafatin ka?</para>
  <para style="q2" vid="PSA 77:7">Nia lakohi hatudu tan ona Nia laran diak ka?<verse eid="PSA 77:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8" />Nia domin rohan-laek nee lakon tinan ba tinan ka?</para>
  <para style="q2" vid="PSA 77:8">Nia promesa nebee Nia halo la vale tan ona ka?<verse eid="PSA 77:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9" />Maromak haluha ona Nia laran diak ka?</para>
  <para style="q2" vid="PSA 77:9">Nia hirus taka tiha Nia laran luak ka?”<verse eid="PSA 77:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10" />Nunee hau hanoin, “Maromak Aas Liu nia liman loos la tulun ita hanesan uluk ona;</para>
  <para style="q2" vid="PSA 77:10">ida nee mak halo hau nia laran moras.”<verse eid="PSA 77:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11" />Maibee NAI Maromak, hau sei hanoin buat diak nebee Ita Boot halo;</para>
  <para style="q2" vid="PSA 77:11">hau sei la haluha Ita Boot nia milagre husi tempu uluk nian.<verse eid="PSA 77:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12" />Hau sei hanoin beibeik Ita Boot nia servisu hotu</para>
  <para style="q2" vid="PSA 77:12">hodi medita buat furak nebee Ita Boot halo.<verse eid="PSA 77:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13" />Maromak, Ita Boot nia dalan nee santu;</para>
  <para style="q2" vid="PSA 77:13">la iha tan maromak ida mak boot hanesan ami nia Maromak.<verse eid="PSA 77:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14" />Ita Boot Maromak ida nebee halo milagre;</para>
  <para style="q2" vid="PSA 77:14">Ita Boot hatudu sai Ita Boot nia kbiit iha nasaun hotu-hotu nia leet.<verse eid="PSA 77:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15" />Ita Boot salva ona Ita Boot nia povu hodi Ita Boot nia liman rasik;</para>
  <para style="q2" vid="PSA 77:15">Ita Boot salva Jacó ho José nia jerasaun.<verse eid="PSA 77:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16" />Maromak, uluk bee haree Ita Boot mai;</para>
  <para style="q2" vid="PSA 77:16">bainhira haree, bee nakdoko tiha,</para>
  <para style="q2" vid="PSA 77:16">too tasi klean boot mos nakdedar.<verse eid="PSA 77:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17" />Kalohan fakar tuun bee;</para>
  <para style="q2" vid="PSA 77:17">lalehan tarutu makaas;</para>
  <para style="q2" vid="PSA 77:17">Ita Boot nia rama oan semo baa semo mai nabilan loos.<verse eid="PSA 77:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18" />Ita Boot halo rai tarutu makaas iha anin fuik laran;</para>
  <para style="q2" vid="PSA 77:18">rai lakan husi Ita Boot leno mundu;</para>
  <para style="q2" vid="PSA 77:18">rai nakdedar too nakdoko.<verse eid="PSA 77:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19" />Ita Boot lao liu husi tasi laran;</para>
  <para style="q2" vid="PSA 77:19">Ita Boot nia dalan liu husi bee boot,</para>
  <para style="q2" vid="PSA 77:19">maibee Ita Boot nia ain fatin la haree hetan.<verse eid="PSA 77:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20" />Ita Boot foti Moisés ho Arão hodi lori Ita Boot nia povu</para>
  <para style="q2" vid="PSA 77:20">hanesan bibi atan nebee lori nia bibi.<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="s">Lisaun husi Israel nia istoria</para>
  <para style="d">Salmu Asaf nian para hanorin ema.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1" />Hau nia povu, rona hau nia hanorin;</para>
  <para style="q2" vid="PSA 78:1">see tilun ba hau nia liafuan.<verse eid="PSA 78:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:2 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:35">Mateus 13:35</ref>
      </char>
    </note>Hau sei konta istoria;</para>
  <para style="q2" vid="PSA 78:2">hau sei foo sai liafuan matenek nian nebee dezde uluk taka hela.<verse eid="PSA 78:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3" />Buat sira nee ita rona tiha ona no hatene tiha ona;</para>
  <para style="q2" vid="PSA 78:3">ita nia bei-ala sira konta tiha ona mai ita.<verse eid="PSA 78:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4" />Ita sei la subar buat sira nee ba sira nia oan sira;</para>
  <para style="q2" vid="PSA 78:4">ita sei konta ba jerasaun tuir mai</para>
  <para style="q1" vid="PSA 78:4">buat furak nebee mak NAI Maromak halo,</para>
  <para style="q2" vid="PSA 78:4">Nia kbiit, ho milagre nebee mak Nia halo tiha ona.<verse eid="PSA 78:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5" />Nia foo Nia regra ba Jacó nia jerasaun;</para>
  <para style="q2" vid="PSA 78:5">Nia hatuur Nia lei iha Israel.</para>
  <para style="q1" vid="PSA 78:5">Nia haruka ita nia bei-ala sira nee</para>
  <para style="q2" vid="PSA 78:5">hanorin tutan lei nee ba sira nia oan sira,<verse eid="PSA 78:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6" />atu nunee jerasaun tuir mai bele hatene,</para>
  <para style="q2" vid="PSA 78:6">too jerasaun nebee seidauk moris mos</para>
  <para style="q2" vid="PSA 78:6">bele hanorin tutan ba sira nia oan sira.<verse eid="PSA 78:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7" />Nunee sira sei konfia iha Maromak;</para>
  <para style="q2" vid="PSA 78:7">sira sei la haluha buat nebee mak Nia halo tiha ona,</para>
  <para style="q2" vid="PSA 78:7">maibee sira sei moris tuir Nia lei.<verse eid="PSA 78:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8" />Sira sei la hanesan sira nia bei-ala sira uluk.</para>
  <para style="q2" vid="PSA 78:8">Bei-ala sira nee ulun toos no kontra door;</para>
  <para style="q1" vid="PSA 78:8">sira nia laran la metin ba Maromak;</para>
  <para style="q2" vid="PSA 78:8">sira la foo laran ba Nia.<verse eid="PSA 78:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9" />Uluk tropas suku Efraim nian kaer hela rama,</para>
  <para style="q2" vid="PSA 78:9">too iha loron funu nian, sira hakiduk.<verse eid="PSA 78:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10" />Sira la kaer metin Maromak nia promesa;</para>
  <para style="q2" vid="PSA 78:10">sira lakohi moris tuir Nia lei.<verse eid="PSA 78:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11" />Sira haluha saida mak Nia halo tiha ona,</para>
  <para style="q2" vid="PSA 78:11">milagre nebee Nia hatudu tiha ona ba sira.<verse eid="PSA 78:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:12 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 7:8-12:32">Ézodu 7:8—12:32</ref>
      </char>
    </note>Nia halo buat boot iha sira nia bei-ala sira nia oin,</para>
  <para style="q2" vid="PSA 78:12">iha rejiaun Zoan iha Ejitu nia rain.<verse eid="PSA 78:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:13 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Ézodu 14:21</ref>,<ref loc="EXO 14:22">22</ref></char>
    </note>Nia fahe tiha tasi halo dalan para sira bele hakur;</para>
  <para style="q2" vid="PSA 78:13">Nia halo tasi been hamriik hanesan moru.<verse eid="PSA 78:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:14 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:21">Ézodu 13:21</ref>,<ref loc="EXO 13:22">22</ref></char>
    </note>Loron, Nia foo kalohan hodi hatudu dalan ba sira;</para>
  <para style="q2" vid="PSA 78:14">kalan tomak, Nia foo ahi hodi leno sira nia dalan.<verse eid="PSA 78:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15" />Nia fera tiha fatuk bo-boot iha rai fuik</para>
  <para style="q2" vid="PSA 78:15">hodi foo bee ba sira hemu, bee nee boot hanesan tasi.<verse eid="PSA 78:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:16 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:1-7">Ézodu 17:1-7</ref>; <ref loc="NUM 20:2-13">Númerus 20:2-13</ref></char>
    </note>Nia halo bee suli sai husi fatuk kuak,</para>
  <para style="q2" vid="PSA 78:16">too bee suli tuun hanesan mota.<verse eid="PSA 78:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17" />Maski nunee sira halo sala nafatin hasoru Maromak;</para>
  <para style="q2" vid="PSA 78:17">iha rai fuik maran, sira kontra Maromak Aas Liu.<verse eid="PSA 78:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:18 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 16:2-15">Ézodu 16:2-15</ref>; <ref loc="NUM 11:4-23">Númerus 11:4-23</ref>,<ref loc="NUM 11:31-35">31-35</ref></char>
    </note>Sira koko Maromak</para>
  <para style="q2" vid="PSA 78:18">hodi eziji hahaan nebee mak sira kaan.<verse eid="PSA 78:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19" />Sira sadik Maromak dehan,</para>
  <para style="q2" vid="PSA 78:19">“Maromak bele tau meza iha rai fuik nee ka?<verse eid="PSA 78:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20" />Loos duni, Nia fera tiha fatuk</para>
  <para style="q2" vid="PSA 78:20">hodi halo bee fakar sai;</para>
  <para style="q2" vid="PSA 78:20">bee nee suli sai makaas.</para>
  <para style="q1" vid="PSA 78:20">Maibee Nia bele foo paun ba ita ka?</para>
  <para style="q2" vid="PSA 78:20">Nia bele fahe naan ba Nia povu ka?”<verse eid="PSA 78:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21" />Bainhira NAI Maromak rona ida nee, Nia hirus teb-tebes;</para>
  <para style="q2" vid="PSA 78:21">Nia ahi lakan makaas kontra Jacó nia jerasaun;</para>
  <para style="q2" vid="PSA 78:21">Nia laran nakali hasoru Israel,<verse eid="PSA 78:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22" />tanba sira la fiar ba Nia;</para>
  <para style="q2" vid="PSA 78:22">sira la fiar Nia kbiit atu salva sira.<verse eid="PSA 78:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23" />Maibee Maromak foo orden ba kalohan;</para>
  <para style="q2" vid="PSA 78:23">Nia loke odamatan lalehan nian.<verse eid="PSA 78:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:24 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:31">João 6:31</ref>
      </char>
    </note>Nia hamonu paun manaa ba sira hanesan udan para sira bele haan;</para>
  <para style="q2" vid="PSA 78:24">Nia foo hahaan lalehan nian ba sira.<verse eid="PSA 78:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25" />Ema mundu nian haan tiha ona hahaan anju sira nian;</para>
  <para style="q2" vid="PSA 78:25">Nia foo hahaan ba sira too sira bosu di-diak.<verse eid="PSA 78:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26" />Nia foo orden ba anin lorosae nian;</para>
  <para style="q2" vid="PSA 78:26">hodi Nia kbiit Nia halo anin tasi mane huu,<verse eid="PSA 78:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27" />lori manu fuik barak loos hanesan rai henek iha tasi ibun;</para>
  <para style="q2" vid="PSA 78:27">Nia hamonu naan manu barak teb-tebes hanesan rai rahun.<verse eid="PSA 78:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28" />Nia halo manu sira nee monu tuun ba iha sira nia akampamentu,</para>
  <para style="q2" vid="PSA 78:28">haleu sira nia tenda hotu.<verse eid="PSA 78:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29" />Sira haan too bosu di-diak,</para>
  <para style="q2" vid="PSA 78:29">tanba Nia foo tiha ona ba sira buat nebee mak sira kaan.<verse eid="PSA 78:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30" />Maibee naan nee sei iha hela sira nia ibun laran,</para>
  <para style="q2" vid="PSA 78:30">sira sei kaan nafatin atu haan tan,<verse eid="PSA 78:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31" />Maromak nia laran nakali hasoru sira.</para>
  <para style="q2" vid="PSA 78:31">Nia hamate mane forti sira iha sira nia leet;</para>
  <para style="q2" vid="PSA 78:31">Nia lere tiha mane klosan Israel nian.<verse eid="PSA 78:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32" />Maski Maromak halo nunee mos, sira halo sala nafatin;</para>
  <para style="q2" vid="PSA 78:32">maski Nia halo tiha ona milagre, sira la fiar nafatin.<verse eid="PSA 78:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33" />Entaun sira nia moris la vale buat ida, no tauk domina sira,</para>
  <para style="q2" vid="PSA 78:33">too Nia hakotu sira nia iis, Nia habadak sira nia tinan.<verse eid="PSA 78:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34" />Bainhira Maromak oho sira balu, sira seluk sempre hakbesik ba Nia;</para>
  <para style="q2" vid="PSA 78:34">sira fila fali hodi harohan ba Nia.<verse eid="PSA 78:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35" />Sira hanoin fali katak Maromak mak fatuk lolon boot hodi satan netik sira;</para>
  <para style="q2" vid="PSA 78:35">Maromak Aas Liu mak sira nia Salvador.<verse eid="PSA 78:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36" />Maibee sira gaba Nia ho sira nia ibun tutun deit;</para>
  <para style="q2" vid="PSA 78:36">sira nia nanaal bosok Nia.<verse eid="PSA 78:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:37 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 8:21">Apostolu sira nia Istoria 8:21</ref>
      </char>
    </note>Sira nunka foo laran ba Nia;</para>
  <para style="q2" vid="PSA 78:37">sira la kaer metin Nia promesa.<verse eid="PSA 78:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38" />Bele nunee mos Nia hatudu nafatin Nia laran diak ba sira;</para>
  <para style="q2" vid="PSA 78:38">Nia hamoos sira nia sala</para>
  <para style="q2" vid="PSA 78:38">hodi la halo mohu sira.</para>
  <para style="q1" vid="PSA 78:38">Dala barak Nia hirus iha Nia laran deit;</para>
  <para style="q2" vid="PSA 78:38">Nia la fakar sai Nia laran nakali.<verse eid="PSA 78:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39" />Nia rekonhese katak ema sira nee isin ho raan deit,</para>
  <para style="q2" vid="PSA 78:39">hanesan anin nebee huu liu tiha la fila ona.<verse eid="PSA 78:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40" />Dala barak sira kontra Maromak iha rai fuik;</para>
  <para style="q2" vid="PSA 78:40">iha rai fuik maran nee sira halo Nia laran dodok!<verse eid="PSA 78:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41" />Sira koko Maromak fila-fila;</para>
  <para style="q2" vid="PSA 78:41">sira halo Israel nia Maromak Santu laran moras.<verse eid="PSA 78:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42" />Sira haluha tiha Nia kbiit;</para>
  <para style="q2" vid="PSA 78:42">sira la hanoin tan tempu nebee Nia liberta sira husi inimigu sira.<verse eid="PSA 78:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43" />Iha tempu nebaa Nia hatudu sai sinal iha rai Ejitu;</para>
  <para style="q2" vid="PSA 78:43">Nia hatudu milagre iha rejiaun Zoan nian.<verse eid="PSA 78:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:44 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 7:17-21">Ézodu 7:17-21</ref>
      </char>
    </note>Mota iha sira nia rain, Nia halo nakfilak sai raan hotu,</para>
  <para style="q2" vid="PSA 78:44">nunee sira la bele hemu tan bee husi mota.<verse eid="PSA 78:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:45 a </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:20-24">Ézodu 8:20-24</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:1-6">Ézodu 8:1-6</ref>
      </char>
    </note>Nia haruka lalar barak hobur sira hodi haan tiha sira;</para>
  <para style="q2" vid="PSA 78:45">Nia manda manduku hodi estraga rai nee.<verse eid="PSA 78:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:46 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 10:12-15">Ézodu 10:12-15</ref>
      </char>
    </note>Ai haan nebee iha sira nia toos laran, Nia foo ba lakataru haan;</para>
  <para style="q2" vid="PSA 78:46">produsaun toos nian, gafanhotu haan tiha.<verse eid="PSA 78:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:47 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 9:22-25">Ézodu 9:22-25</ref>
      </char>
    </note>Nia halo mate sira nia uvas ho udan jelu fatuk;</para>
  <para style="q2" vid="PSA 78:47">Nia hamate sira nia ai figeira ho jelu fatuk.<verse eid="PSA 78:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48" />Nia halo udan jelu fatuk monu ba sira nia karau leten;</para>
  <para style="q2" vid="PSA 78:48">Nia husik rai lakan kona sira nia bibi.<verse eid="PSA 78:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49" />Nia fakar sai Nia laran nakali ba sira;</para>
  <para style="q2" vid="PSA 78:49">Nia hirus teb-tebes, Nia hakribi sira nia hahalok, Nia kontra sira.</para>
  <para style="q2" vid="PSA 78:49">Nia haruka Nia anju lubuk ida atu baa hamohu sira.<verse eid="PSA 78:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50" />Nia prepara dalan atu hasai Nia hirus;</para>
  <para style="q2" vid="PSA 78:50">Nia la salva sira husi mate,</para>
  <para style="q2" vid="PSA 78:50">maibee Nia entrega sira ba iha moras aat.<verse eid="PSA 78:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:51 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:29">Ézodu 12:29</ref>
      </char>
    </note>Nia oho dasa tiha ema Ejitu sira nia oan mane boot hotu;</para>
  <para style="q2" vid="PSA 78:51">husi Ham nia jerasaun, oan mane primeiru mate mohu.<verse eid="PSA 78:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:52 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:17-22">Ézodu 13:17-22</ref>
      </char>
    </note>Depois Nia lori sai Nia povu liu husi rai fuik</para>
  <para style="q2" vid="PSA 78:52">hanesan bibi atan lori nia bibi.<verse eid="PSA 78:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:53 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:26-28">Ézodu 14:26-28</ref>
      </char>
    </note>Nia tau matan ba sira iha dalan, nunee sira la tauk,</para>
  <para style="q2" vid="PSA 78:53">maibee tasi halo mout tiha sira nia inimigu.<verse eid="PSA 78:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:54 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:17">Ézodu 15:17</ref>; <ref loc="JOS 3:14-17">Josué 3:14-17</ref></char>
    </note>Nia lori Nia povu ba iha Nia rai santu,</para>
  <para style="q2" vid="PSA 78:54">ba iha foho nebee Nia hadau tiha ona ho Nia kbiit.<verse eid="PSA 78:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:55 </char>
      <char style="xt" closed="false">
        <ref loc="JOS 11:16-23">Josué 11:16-23</ref>
      </char>
    </note>Nia duni sai tiha nasaun sira nebee hela iha nebaa</para>
  <para style="q2" vid="PSA 78:55">para Nia povu avansa ba oin.</para>
  <para style="q1" vid="PSA 78:55">Nia fahe rai nee ba Nia povu para sai sira nian;</para>
  <para style="q2" vid="PSA 78:55">ema sira nee nia uma Nia foo ba suku Israel mak hela fali.<verse eid="PSA 78:55" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:56 </char>
      <char style="xt" closed="false">
        <ref loc="JDG 2:11-15">Juis sira 2:11-15</ref>
      </char>
    </note>Maibee ema Israel koko nafatin Maromak Aas Liu</para>
  <para style="q2" vid="PSA 78:56">hodi kontra Nia;</para>
  <para style="q2" vid="PSA 78:56">sira la halo tuir Nia regra.<verse eid="PSA 78:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57" />Sira la foo laran ba Maromak, sira fila kotuk ba Nia hanesan sira nia bei-ala sira;</para>
  <para style="q2" vid="PSA 78:57">sira nee kleuk tuun-sae hanesan rama aat ida.<verse eid="PSA 78:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58" />Sira halo Maromak hirus tanba sira hamulak iha sira nia foho lulik;</para>
  <para style="q2" vid="PSA 78:58">sira halo Nia laran moras tanba sira adora fali estatua lulik.<verse eid="PSA 78:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59" />Haree nunee Maromak nia laran nakali;</para>
  <para style="q2" vid="PSA 78:59">Nia fila kotuk ba ema Israel sira.<verse eid="PSA 78:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:60 </char>
      <char style="xt" closed="false">
        <ref loc="JOS 18:1">Josué 18:1</ref>; <ref loc="JER 7:12-14">Jeremias 7:12-14</ref>, <ref loc="JER 26:6">26:6</ref></char>
    </note>Nia husik tiha Nia hela fatin iha sidade Silo;</para>
  <para style="q2" vid="PSA 78:60">Nia abandona tenda nebee Nia harii tiha ona iha ema mundu nia leet.<verse eid="PSA 78:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:61 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 4:4-22">1 Samuel 4:4-22</ref>
      </char>
    </note>Nia husik tiha inimigu sira hadau kaixoti promesa nian;</para>
  <para style="q2" vid="PSA 78:61">kaixoti nebee hatudu sai Nia kbiit ho Nia furak monu fali ba inimigu sira nia liman laran.<verse eid="PSA 78:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62" />Nia hirus teb-tebes Nia povu;</para>
  <para style="q2" vid="PSA 78:62">Nia husik Nia ema rasik mate ho surik.<verse eid="PSA 78:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63" />Ahi haan tiha sira nia mane klosan sira;</para>
  <para style="q2" vid="PSA 78:63">sira nia feto klosan sira la kanta tan iha festa kazamentu.<verse eid="PSA 78:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64" />Sira nia nai lulik sira mate ho surik;</para>
  <para style="q2" vid="PSA 78:64">feto faluk sira la bele tanis lelir.<verse eid="PSA 78:64" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65" />Depois Nai Maromak hadeer fali hanesan ema hadeer husi matan dukur,</para>
  <para style="q2" vid="PSA 78:65">hanesan funu nain tua lanu nebee hatene tuir nia aan fali.<verse eid="PSA 78:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66" />Nia duni lakon tiha Nia inimigu sira;</para>
  <para style="q2" vid="PSA 78:66">Nia halo sira moe tinan ba tinan.<verse eid="PSA 78:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67" />Maibee Nia la simu José nia jerasaun;</para>
  <para style="q2" vid="PSA 78:67">Nia la hili ona suku Efraim.<verse eid="PSA 78:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68" />Nia hili fali suku Judá;</para>
  <para style="q2" vid="PSA 78:68">Nia laran monu ba foho Siaun.<verse eid="PSA 78:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69" />Iha nebaa Nia harii Nia uma kreda hanesan foho aas ida;</para>
  <para style="q2" vid="PSA 78:69">uma kreda nee dura nafatin ba nafatin hanesan mundu.<verse eid="PSA 78:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70" />
    <note caller="+" style="x">
      <char style="xo" closed="false">78:70 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 16:11">1 Samuel 16:11</ref>,<ref loc="1SA 16:12">12</ref>; <ref loc="2SA 7:8">2 Samuel 7:8</ref>; <ref loc="1CH 17:7">1 Krónikas 17:7</ref></char>
    </note>Nia hili Nia atan David sai liurai;</para>
  <para style="q2" vid="PSA 78:70">Nia fihir David husi nia servisu nudar bibi atan.<verse eid="PSA 78:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71" />David tau matan hela ba bibi, Maromak bolu nia</para>
  <para style="q2" vid="PSA 78:71">atu sai fali bibi atan ba Maromak nia povu rasik,</para>
  <para style="q2" vid="PSA 78:71">ba ema Israel, Jacó nia jerasaun.<verse eid="PSA 78:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72" />David tau matan ba sira ho fuan ho laran;</para>
  <para style="q2" vid="PSA 78:72">nia ukun sira ho matenek.<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="s">Orasaun husu Nai Maromak salva nasaun</para>
  <para style="d">Salmu Asaf nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">79:1 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 25:8-10">2 Liurai 25:8-10</ref>; <ref loc="2CH 36:17-19">2 Krónikas 36:17-19</ref>; <ref loc="JER 52:12-14">Jeremias 52:12-14</ref></char>
    </note>Maromak, nasaun jentiu sira tama tiha ona iha Ita Boot nia rain;</para>
  <para style="q2" vid="PSA 79:1">sira halo foer Ita Boot nia uma kreda santu;</para>
  <para style="q2" vid="PSA 79:1">sira sobu rahun tiha ona sidade Jerusalém.<verse eid="PSA 79:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2" />Sira husik Ita Boot nia atan sira nia mate isin</para>
  <para style="q2" vid="PSA 79:2">sai fali manu fuik nia hahaan;</para>
  <para style="q1" vid="PSA 79:2">Ita Boot nia povu nia mate isin</para>
  <para style="q2" vid="PSA 79:2">sai tiha ona hahaan ba animal fuik.<verse eid="PSA 79:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3" />Sira halo Ita Boot nia povu nia raan suli haleu Jerusalém tomak hanesan fali bee;</para>
  <para style="q2" vid="PSA 79:3">la iha ema ida atu hakoi mate isin sira nee.<verse eid="PSA 79:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4" />Ami moe iha vizinhu sira nia oin;</para>
  <para style="q2" vid="PSA 79:4">ema nebee haleu ami hatete aat ami no hatuun ami.<verse eid="PSA 79:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5" />NAI Maromak, Ita Boot atu hirus ami too bainhira?</para>
  <para style="q2" vid="PSA 79:5">Too tinan ba tinan ka?</para>
  <para style="q2" vid="PSA 79:5">Too bainhira mak Ita Boot nia laran nakali mai ami?<verse eid="PSA 79:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6" />Fakar tuun Ita Boot nia hirus ba nasaun sira nebee la konhese Ita Boot,</para>
  <para style="q2" vid="PSA 79:6">ba iha nasaun sira nebee la bolu Ita Boot nia naran.<verse eid="PSA 79:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7" />Tanba sira haan hotu tiha ona Jacó nia jerasaun;</para>
  <para style="q2" vid="PSA 79:7">sira estraga tiha ona nia hela fatin.<verse eid="PSA 79:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8" />Keta sura ami nia bei-ala sira nia sala ba iha ami nia leten;</para>
  <para style="q2" vid="PSA 79:8">hatudu lalais ita Boot nia laran luak mai ami,</para>
  <para style="q2" vid="PSA 79:8">tanba ami fraku liu ona.<verse eid="PSA 79:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9" />Maromak, ami nia Salvador, tulun ami ba</para>
  <para style="q2" vid="PSA 79:9">atu ema foti aas Ita Boot nia naran;</para>
  <para style="q1" vid="PSA 79:9">salva ami no perdua ami nia sala</para>
  <para style="q2" vid="PSA 79:9">atu ema tane aas Ita Boot nia naran.<verse eid="PSA 79:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10" />La bele husik nasaun jentiu sira dehan fali,</para>
  <para style="q2" vid="PSA 79:10">“Ema sira nee nia Maromak iha nebee?”</para>
  <para style="q1" vid="PSA 79:10">Halo ami haree Ita Boot selu fali nasaun jentiu sira</para>
  <para style="q2" vid="PSA 79:10">tanba sira fakar Ita Boot nia atan sira nia raan.<verse eid="PSA 79:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11" />See tilun ba ema dadur sira nia halerik;</para>
  <para style="q2" vid="PSA 79:11">hodi Ita Boot nia forsa salva sira nebee mak ema atu oho.<verse eid="PSA 79:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12" />Nai, liafuan aat nebee mak ami nia vizinhu sira koalia hasoru Ita Boot,</para>
  <para style="q2" vid="PSA 79:12">tiru fali ba iha sira nia hirus matan dala hitu.<verse eid="PSA 79:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13" />Nunee ami nudar Ita Boot nia povu,</para>
  <para style="q2" vid="PSA 79:13">nudar bibi nebee Ita Boot tau matan,</para>
  <para style="q1" vid="PSA 79:13">ami sei agradese ba Ita Boot tinan ba tinan;</para>
  <para style="q2" vid="PSA 79:13">ami sei hahii Ita Boot husi jerasaun ba jerasaun.<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="s">Orasaun atu Nai Maromak hadia fali nasaun</para>
  <para style="d">Salmu Asaf nian, tuir muzika “Ai funan liriu promesa nian.” Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">80:1 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 25:22">Ézodu 25:22</ref>
      </char>
    </note>Bibi atan Israel,</para>
  <para style="q2" vid="PSA 80:1">Ita Boot hatudu dalan ba José nia jerasaun hanesan bibi atan ida lori nia bibi;</para>
  <para style="q2" vid="PSA 80:1">see tilun mai ami ba.</para>
  <para style="q1" vid="PSA 80:1">Ita Boot tuur iha anju kerubin nia leten hodi ukun;</para>
  <para style="q2" vid="PSA 80:1">hatudu Ita Boot nia naroman nabilan<verse eid="PSA 80:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 80:2" />ba Efraim, Benjamim ho Manassés sira nia jerasaun.</para>
  <para style="q1" vid="PSA 80:2">Hatudu Ita Boot nia kbiit;</para>
  <para style="q2" vid="PSA 80:2">mai salva ami ba.<verse eid="PSA 80:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3" />Maromak, hadia fali ami nia moris ba;</para>
  <para style="q2" vid="PSA 80:3">halo Ita Boot nia oin nabilan leno ami,</para>
  <para style="q2" vid="PSA 80:3">atu nunee ami bele hetan salvasaun.<verse eid="PSA 80:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4" />NAI Maromak Aswain,</para>
  <para style="q2" vid="PSA 80:4">too bainhira mak Ita Boot nia laran nakali hodi lakohi rona Ita Boot nia povu nia orasaun?<verse eid="PSA 80:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5" />Ita Boot foo laran tristi ba ami hanesan fali hahaan;</para>
  <para style="q2" vid="PSA 80:5">Ita Boot foo ami hemu matan been manko nakonu.<verse eid="PSA 80:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6" />Ita Boot halo nasaun vizinhu sira istori malu kona ba ami nia rain;</para>
  <para style="q2" vid="PSA 80:6">Ita Boot husik ami nia inimigu sira hamnasa hahaek mai ami.<verse eid="PSA 80:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7" />Maromak Aswain, hadia fali ami nia moris ba;</para>
  <para style="q2" vid="PSA 80:7">halo Ita Boot nia oin nabilan leno ami,</para>
  <para style="q2" vid="PSA 80:7">atu nunee ami bele hetan salvasaun.<verse eid="PSA 80:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8" />Ami nee hanesan ai uvas huun ida nebee Ita Boot lori sai husi rai Ejitu;</para>
  <para style="q2" vid="PSA 80:8">Ita Boot duni sai tiha nasaun jentiu sira hodi kuda fali ai uvas nee.<verse eid="PSA 80:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9" />Ita Boot hamoos tiha rai ba ai uvas nee,</para>
  <para style="q2" vid="PSA 80:9">nunee nia abut tama klean iha rai too buras nakonu rai nee.<verse eid="PSA 80:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10" />Foho sira hamahon aan iha nia lalatak;</para>
  <para style="q2" vid="PSA 80:10">ai huun boot sedru helik iha nia sanak.<verse eid="PSA 80:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11" />Nia sanak naruk too iha tasi Mediteráneu;</para>
  <para style="q2" vid="PSA 80:11">nia dikin too iha mota Eufrates.<verse eid="PSA 80:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12" />Maibee tansaa mak Ita Boot halo rahun tiha lutu?</para>
  <para style="q2" vid="PSA 80:12">Agora ema nebee liu bele foti uvas nee nia fuan;<verse eid="PSA 80:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13" />fahi fuik husi ai laran mai estraga hela;</para>
  <para style="q2" vid="PSA 80:13">animal husi rai fuik mai haan dadauk.<verse eid="PSA 80:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14" />Maromak Aswain, fila fali mai ami;</para>
  <para style="q2" vid="PSA 80:14">hateke tuun husi lalehan hodi haree.</para>
  <para style="q1" vid="PSA 80:14">Tau matan ba uvas huun nee;<verse eid="PSA 80:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 80:15" />ida nee Ita Boot nia liman loos mak kuda;</para>
  <para style="q2" vid="PSA 80:15">ida nee oan mane nebee Ita Boot rasik foti sae sai Ita Boot nian.<verse eid="PSA 80:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16" />Ita Boot nia uvas huun ema tesi tuun tiha ona;</para>
  <para style="q2" vid="PSA 80:16">ahi haan mutuk tiha ona.</para>
  <para style="q1" vid="PSA 80:16">Hatudu Ita Boot nia oin hirus ba ema sira nee;</para>
  <para style="q2" vid="PSA 80:16">halo sira mate mohu tiha.<verse eid="PSA 80:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17" />Proteje ema ida nebee mak iha hela Ita Boot nia liman loos;</para>
  <para style="q2" vid="PSA 80:17">nia nee ema nia oan mane nebee Ita Boot rasik foti sae sai Ita Boot nian.<verse eid="PSA 80:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18" />Depois ami sei la fila kotuk ba Ita Boot;</para>
  <para style="q2" vid="PSA 80:18">halo ami moris nafatin mak ami sei temi Ita Boot nia naran.<verse eid="PSA 80:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19" />NAI Maromak Aswain, hadia fali ami moris ba;</para>
  <para style="q2" vid="PSA 80:19">halo Ita Boot nia oin nabilan leno ami,</para>
  <para style="q2" vid="PSA 80:19">atu nunee ami bele hetan salvasaun.<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="s">Kantiku selebrasaun nian</para>
  <para style="d">Salmu Asaf nian, tuir muzika Gitit. Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1" />Haklalak haksolok ba Maromak, Nia mak ita nia forsa;</para>
  <para style="q2" vid="PSA 81:1">hananu haklalak ba Jacó nia Maromak!<verse eid="PSA 81:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2" />Hananu ba, baku babadook ba;</para>
  <para style="q2" vid="PSA 81:2">toka viola ho viola tali sanulu.<verse eid="PSA 81:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">81:3 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 10:10">Númerus 10:10</ref>
      </char>
    </note>Huu karau dikur iha tempu fulan nurak;</para>
  <para style="q2" vid="PSA 81:3">huu tan bainhira fulan nakonu hodi loke ita nia loron boot.<verse eid="PSA 81:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4" />Ida nee mak Israel nia lei,</para>
  <para style="q2" vid="PSA 81:4">regulamentu husi Jacó nia Maromak.<verse eid="PSA 81:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5" />Bainhira Maromak baa kontra ema Ejitu,</para>
  <para style="q2" vid="PSA 81:5">Nia foo orden nee ba José.</para>
  <para style="b" vid="PSA 81:5" />
  <para style="q1" vid="PSA 81:5">Hau rona ona lian ida nebee hau la konhese dehan,<verse eid="PSA 81:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6" />“Hau muda sai tiha naha todan iha imi nia kabaas;</para>
  <para style="q2" vid="PSA 81:6">imi nia liman livre ona husi bote todan.<verse eid="PSA 81:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">81:7 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:7">Ézodu 17:7</ref>; <ref loc="NUM 20:13">Númerus 20:13</ref></char>
    </note>Uluk imi iha susar laran, imi harohan mai Hau, Hau salva tiha imi;</para>
  <para style="q2" vid="PSA 81:7">Hau hataan imi husi kalohan ho rai tarutu nia laran;</para>
  <para style="q2" vid="PSA 81:7">Hau koko tiha ona imi iha bee Meriba nian.<verse eid="PSA 81:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8" />Hau nia povu, rona mai, Hau sei foo atensaun ba imi;</para>
  <para style="q2" vid="PSA 81:8">Israel, tuir loos imi rona mai Hau!<verse eid="PSA 81:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">81:9 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 20:2">Ézodu 20:2</ref>,<ref loc="EXO 20:3">3</ref>; <ref loc="DEU 5:6">Deuteronómiu 5:6</ref>,<ref loc="DEU 5:7">7</ref></char>
    </note>Iha imi nia leet maromak seluk la bele iha;</para>
  <para style="q2" vid="PSA 81:9">imi la bele adora maromak falsu.<verse eid="PSA 81:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10" />Hau mak NAI imi nia Maromak;</para>
  <para style="q2" vid="PSA 81:10">Hau mak lori imi sai husi rai Ejitu.</para>
  <para style="q2" vid="PSA 81:10">Loke imi nia ibun ba mak Hau foo haan imi too bosu.<verse eid="PSA 81:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11" />Maibee Hau nia povu lakohi rona Hau;</para>
  <para style="q2" vid="PSA 81:11">Israel lakohi hakruuk mai Hau.<verse eid="PSA 81:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12" />Nunee Hau halo sira nia fuan toos tiha</para>
  <para style="q2" vid="PSA 81:12">hodi tuir deit sira nia hanoin rasik.<verse eid="PSA 81:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13" />Hau hakarak atu Hau nia povu rona mai Hau;</para>
  <para style="q2" vid="PSA 81:13">Hau hakarak tebes atu Israel lao tuir Hau nia dalan.<verse eid="PSA 81:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14" />Se sira rona Hau, Hau sei halo sira nia inimigu sira lakon lalais deit;</para>
  <para style="q2" vid="PSA 81:14">Hau fila Hau nia liman hodi kontra sira nia funu baluk.<verse eid="PSA 81:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15" />Ema nebee odi NAI Maromak, sira sei tauk ho nakdedar iha Nia oin;</para>
  <para style="q2" vid="PSA 81:15">sira sei hetan kastigu tinan ba tinan.<verse eid="PSA 81:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16" />Maibee Hau sei foo haan paun diak nian ba imi;</para>
  <para style="q2" vid="PSA 81:16">Hau sei habosu imi ho bani been husi fatuk kuak.”<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="s">Nai Maromak mak Juis boot</para>
  <para style="d">Salmu Asaf nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1" />Maromak tuur iha Nia fatin iha tribunal lalehan nian</para>
  <para style="q2" vid="PSA 82:1">hodi foo justisa ba maromak sel-seluk.<note caller="+" style="f"><char style="fr" closed="false">82:1 </char><char style="ft" closed="false">Matenek nain barak dehan, “maromak sel-seluk” nee hatudu ba maromak sira nebee mak nasaun jentiu sira adora. Balu tan dehan ida nee hatudu ba ukun nain sira.</char></note><verse eid="PSA 82:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2" />Nia dehan, “Too bainhira mak imi tesi lia la loos</para>
  <para style="q2" vid="PSA 82:2">hodi defende fali ema aat?<verse eid="PSA 82:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3" />Imi tenki foo justisa lo-loos ba ema kiik ho oan kiak sira;</para>
  <para style="q2" vid="PSA 82:3">defende ema kbiit-laek ho ema mukit sira nia direitu.<verse eid="PSA 82:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4" />Salva ema kiik ho kiak sira;</para>
  <para style="q2" vid="PSA 82:4">hasai sira husi ema aat sira nia liman laran.<verse eid="PSA 82:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5" />Maromak sel-seluk nee la hatene buat ida, sira la kompriende;</para>
  <para style="q2" vid="PSA 82:5">sira lao iha nakukun laran;</para>
  <para style="q2" vid="PSA 82:5">nunee mundu rai klaran nakdoko tiha.<verse eid="PSA 82:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">82:6 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 10:34">João 10:34</ref>
      </char>
    </note>Hau dehan, ‘Imi sira nee maromak;</para>
  <para style="q2" vid="PSA 82:6">imi hotu Maromak Aas Liu nia oan.’<verse eid="PSA 82:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7" />Maski nunee too tempu ida imi sei mate hanesan ema hotu mate;</para>
  <para style="q2" vid="PSA 82:7">imi nia vida sei remata hanesan ukun nain sira seluk.”<verse eid="PSA 82:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8" />Maromak, hamriik ba hodi foo justisa mai mundu,</para>
  <para style="q2" vid="PSA 82:8">tanba nasaun hotu-hotu Ita Boot nian.<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="s">Orasaun husu tulun hodi kontra inimigu</para>
  <para style="d">Salmu Asaf nian. Kantiku ida.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1" />Maromak, la bele nonook deit;</para>
  <para style="q2" vid="PSA 83:1">keta taka tilun;</para>
  <para style="q2" vid="PSA 83:1">Maromak, keta lian-laek nunee.<verse eid="PSA 83:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2" />Haree ba, Ita Boot nia inimigu sira book aan ona;</para>
  <para style="q2" vid="PSA 83:2">ema nebee odi Ita Boot foti aas sira nia ulun.<verse eid="PSA 83:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3" />Sira futu lia hasoru Ita Boot nia povu;</para>
  <para style="q2" vid="PSA 83:3">sira kombina malu kontra ema nebee Ita Boot tau matan.<verse eid="PSA 83:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4" />Sira dehan, “Mai ita harahun tiha sira nia nasaun</para>
  <para style="q2" vid="PSA 83:4">atu nunee ema la temi tan Israel nia naran.”<verse eid="PSA 83:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5" />Sira lian ida halo planu;</para>
  <para style="q2" vid="PSA 83:5">sira konkorda hamutuk atu kontra Ita Boot.<verse eid="PSA 83:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6" />Sira nee mak ema Edom ho ema Ismael,</para>
  <para style="q2" vid="PSA 83:6">ema Moab ho ema Hagar,<verse eid="PSA 83:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7" />ema Gebál, Amon ho Amalék,</para>
  <para style="q2" vid="PSA 83:7">ema Filístia, ho ema husi sidade Tiru.<verse eid="PSA 83:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8" />Ema Asíria mos hamutuk tiha ona ho sira</para>
  <para style="q2" vid="PSA 83:8">hodi haforsa Ló nia jerasaun sira nee.<verse eid="PSA 83:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">83:9 a </char>
      <char style="xt" closed="false">
        <ref loc="JDG 7:1-23">Juis sira 7:1-23</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="JDG 4:6-22">Juis sira 4:6-22</ref>
      </char>
    </note>Halakon sira ba, hanesan Ita Boot uluk halakon ema Midián,</para>
  <para style="q2" vid="PSA 83:9">hanesan Ita Boot halakon komandante Sízera ho liurai Jabín iha mota Kisón;<verse eid="PSA 83:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10" />sira nee mate mohu iha rai Endor;</para>
  <para style="q2" vid="PSA 83:10">sira sai tiha ona adubu ba rai nee.<verse eid="PSA 83:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">83:11 a </char>
      <char style="xt" closed="false">
        <ref loc="JDG 7:25">Juis sira 7:25</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="JDG 8:12">Juis sira 8:12</ref>
      </char>
    </note>Halo sira nia ema boot sira sai hanesan jeneral Oreb ho Zeeb;</para>
  <para style="q2" vid="PSA 83:11">halo sira nia ukun nain sira hotu sai hanesan liurai Zebah ho Zalmuna;<verse eid="PSA 83:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12" />sira nain rua dehan, “Mai ita hadau tiha rai nebee Maromak tau matan</para>
  <para style="q2" vid="PSA 83:12">hodi sai fali ita nian.”<verse eid="PSA 83:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13" />Hau nia Maromak, halo sira hanesan rai rahun nebee anin fuik lori,</para>
  <para style="q2" vid="PSA 83:13">hanesan duut maran nebee anin huu lakon tiha.<verse eid="PSA 83:13" /></para>
  <para style="q1">
    <verse number="14-15" style="v" sid="PSA 83:14-15" />Duni tuir sira ho Ita Boot nia anin makaas;</para>
  <para style="q2" vid="PSA 83:14-15">hatauk sira ho Ita Boot nia anin fuik,</para>
  <para style="q1" vid="PSA 83:14-15">hanesan ahi haan ai laran,</para>
  <para style="q2" vid="PSA 83:14-15">hanesan ahi sunu mutuk foho.<verse eid="PSA 83:14-15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16" />NAI Maromak, halo sira moe boot,</para>
  <para style="q2" vid="PSA 83:16">atu nunee sira bele buka Ita Boot.<verse eid="PSA 83:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17" />Halo sira moe ho oin tuun tinan ba tinan;</para>
  <para style="q2" vid="PSA 83:17">husik sira mate ho naran aat.<verse eid="PSA 83:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18" />Halo sira rekonhese katak Ita Boot mak NAI Maromak;</para>
  <para style="q2" vid="PSA 83:18">Ita Boot mesak mak Maromak Aas Liu iha mundu rai klaran.<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="s">Hakarak atu hela iha Nai Maromak nia uma</para>
  <para style="d">Salmu husi Korá nia oan, tuir muzika “Gitit.” Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1" />NAI Maromak Aswain,</para>
  <para style="q2" vid="PSA 84:1">Ita Boot nia hela fatin furak teb-tebes!<verse eid="PSA 84:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2" />Hau lakohi hein tan, hau hakarak teb-tebes</para>
  <para style="q2" vid="PSA 84:2">atu tama iha NAI nia uma kreda;</para>
  <para style="q1" vid="PSA 84:2">hau nia isin ho klamar haklalak haksolok</para>
  <para style="q2" vid="PSA 84:2">ba Maromak Moris.<verse eid="PSA 84:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3" />NAI Maromak Aswain,</para>
  <para style="q2" vid="PSA 84:3">hau nia Liurai, hau nia Maromak,</para>
  <para style="q1" vid="PSA 84:3">besik iha Ita Boot nia altar,</para>
  <para style="q2" vid="PSA 84:3">manu liin halo nia knuuk;</para>
  <para style="q1" vid="PSA 84:3">manu lakateu mos halo nia uma</para>
  <para style="q2" vid="PSA 84:3">para luut sira nia oan iha nebaa.<verse eid="PSA 84:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4" />Ema nebee hela iha Ita Boot nia uma</para>
  <para style="q2" vid="PSA 84:4">hodi adora hela deit Ita Boot, sira hetan ksolok.<verse eid="PSA 84:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5" />Ema nebee mak hetan kbiit husi Ita Boot,</para>
  <para style="q2" vid="PSA 84:5">ema nebee hakarak ho laran atu baa iha Ita Boot nia foho santu, sira hetan ksolok.<verse eid="PSA 84:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6" />Bainhira sira lao liu husi Rai Klean Tanis nian,</para>
  <para style="q2" vid="PSA 84:6">bee matan barak mosu iha nebaa;</para>
  <para style="q2" vid="PSA 84:6">udan monu rai hodi foo bensaun ba rai nee.<verse eid="PSA 84:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7" />Sira lao forti ba dadauk,</para>
  <para style="q2" vid="PSA 84:7">too sira ida-ida tama iha Maromak nia prezensa iha foho Siaun.<verse eid="PSA 84:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8" />NAI Maromak Aswain, rona hau nia orasaun;</para>
  <para style="q2" vid="PSA 84:8">Jacó nia Maromak, see tilun mai hau.<verse eid="PSA 84:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9" />Maromak, haree di-diak liurai nebee mak defende ami;</para>
  <para style="q2" vid="PSA 84:9">tau matan ba liurai nebee mak Ita Boot hili ona nee.<verse eid="PSA 84:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10" />Diak liu loron ida iha Ita Boot nia uma kreda</para>
  <para style="q2" vid="PSA 84:10">duke loron rihun ida iha fatin seluk.</para>
  <para style="q1" vid="PSA 84:10">Hau gosta liu hein odamatan iha hau nia Maromak nia uma</para>
  <para style="q2" vid="PSA 84:10">duke hela iha ema aat nia tenda laran.<verse eid="PSA 84:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11" />Tanba NAI Maromak mak loro matan hodi leno ita, Nia defende ita;</para>
  <para style="q2" vid="PSA 84:11">Nia hatudu laran diak ba ita no foti aas ita;</para>
  <para style="q1" vid="PSA 84:11">NAI nunka subar buat diak</para>
  <para style="q2" vid="PSA 84:11">ba ema nebee lao tuir dalan loos.<verse eid="PSA 84:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12" />NAI Maromak Aswain,</para>
  <para style="q2" vid="PSA 84:12">ema hotu nebee laran metin ba Ita Boot, sira hetan ksolok.<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="s">Orasaun atu nasaun moris diak</para>
  <para style="d">Salmu husi Korá nia oan, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1" />NAI Maromak, uluk Ita Boot hatudu laran diak ba Ita Boot nia rain</para>
  <para style="q2" vid="PSA 85:1">hodi halo Jacó nia jerasaun moris diak fali.<verse eid="PSA 85:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2" />Ita Boot perdua tiha ona hahalok aat nebee Ita Boot nia povu halo</para>
  <para style="q2" vid="PSA 85:2">hodi taka tiha sira nia sala hotu-hotu.<verse eid="PSA 85:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3" />Ita Boot lakohi hirus tan sira,</para>
  <para style="q2" vid="PSA 85:3">no la fakar tan Ita Boot nia laran nakali ba sira.<verse eid="PSA 85:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4" />Maromak ami nia Salvador, hadia fali ami nia moris ba;</para>
  <para style="q2" vid="PSA 85:4">halakon tiha Ita Boot nia laran moras ba ami.<verse eid="PSA 85:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5" />Ita Boot sei hirus ami nafatin ba nafatin ka?</para>
  <para style="q2" vid="PSA 85:5">Ita Boot atu hanaruk Ita Boot nia hirus husi jerasaun ba jerasaun ka?<verse eid="PSA 85:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6" />Halo Ita Boot nia povu moris fali ba</para>
  <para style="q2" vid="PSA 85:6">atu ami bele haksolok ho Ita Boot nia diak.<verse eid="PSA 85:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7" />NAI Maromak, hatudu Ita Boot nia domin rohan-laek mai ami</para>
  <para style="q2" vid="PSA 85:7">hodi salva ami.<verse eid="PSA 85:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8" />Hau sei see tilun ba buat nebee NAI Maromak koalia;</para>
  <para style="q2" vid="PSA 85:8">Nia promete pas ba Nia povu, ba ema nebee foo laran ba Nia,</para>
  <para style="q2" vid="PSA 85:8">naran katak sira la bele fila fali ba buat beik.<verse eid="PSA 85:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9" />Tebes, Nia salvasaun besik ema nebee mak hamtauk Nia,</para>
  <para style="q2" vid="PSA 85:9">nunee Nia kbiit sei hela metin iha ita nia rain.<verse eid="PSA 85:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10" />Domin ho lia loos hasoru malu;</para>
  <para style="q2" vid="PSA 85:10">justisa ho pas rei malu.<verse eid="PSA 85:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11" />Lia loos sei moris buras husi rai;</para>
  <para style="q2" vid="PSA 85:11">justisa sei hateke tuun husi lalehan.<verse eid="PSA 85:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12" />Loos duni, NAI Maromak sei haraik buat nebee diak;</para>
  <para style="q2" vid="PSA 85:12">ita nia toos sei foo ai haan barak.<verse eid="PSA 85:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13" />Lia loos lao uluk iha Nia futar oin</para>
  <para style="q2" vid="PSA 85:13">hodi prepara dalan ba Nia atu lao tuir.<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="s">Orasaun husu tulun</para>
  <para style="d">Orasaun David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1" />NAI Maromak, rona hau hodi hataan hau ba,</para>
  <para style="q2" vid="PSA 86:1">tanba hau kiak ho kbiit-laek.<verse eid="PSA 86:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2" />Kuidadu hau nia moris, tanba hau foo laran ba Ita Boot;</para>
  <para style="q2" vid="PSA 86:2">salva Ita Boot nia atan hau, tanba hau konfia Ita Boot.</para>
  <para style="q2" vid="PSA 86:2">Ita Boot mak hau nia Maromak.<verse eid="PSA 86:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3" />Nai, loron-kalan hau halerik ba Ita Boot;</para>
  <para style="q2" vid="PSA 86:3">hanoin hau ba.<verse eid="PSA 86:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4" />Nai, foo ksolok ba Ita Boot nia atan hau,</para>
  <para style="q2" vid="PSA 86:4">tanba hau fiar Ita Boot.<verse eid="PSA 86:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5" />Nai, Ita Boot nee diak no gosta perdua ema;</para>
  <para style="q2" vid="PSA 86:5">Ita Boot sempre hatudu domin rohan-laek ba ema nebee mak harohan ba Ita Boot.<verse eid="PSA 86:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6" />NAI Maromak, rona hau nia orasaun;</para>
  <para style="q2" vid="PSA 86:6">hau halerik husu tulun ba Ita Boot, see tilun ba.<verse eid="PSA 86:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7" />Iha tempu susar, hau harohan ba Ita Boot;</para>
  <para style="q2" vid="PSA 86:7">Ita Boot sei hataan hau.<verse eid="PSA 86:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8" />Nai Maromak, iha maromak sel-seluk nia leet, la iha ida mak hanesan Ita Boot;</para>
  <para style="q2" vid="PSA 86:8">la iha buat ida mak bele kompara ho buat nebee Ita Boot halo tiha ona.<verse eid="PSA 86:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">86:9 </char>
      <char style="xt" closed="false">
        <ref loc="REV 15:4">Apokalipse 15:4</ref>
      </char>
    </note>Nai, nasaun hotu-hotu nebee Ita Boot halo</para>
  <para style="q2" vid="PSA 86:9">sei mai adora Ita Boot;</para>
  <para style="q2" vid="PSA 86:9">sira sei foti aas Ita Boot nia naran.<verse eid="PSA 86:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10" />Tanba Ita Boot makaas no halo buat mesak furak;</para>
  <para style="q2" vid="PSA 86:10">Ita Boot deit mak Maromak.<verse eid="PSA 86:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11" />NAI Maromak, hanorin Ita Boot nia dalan mai hau,</para>
  <para style="q2" vid="PSA 86:11">atu hau bele moris tuir Ita Boot nia lia loos;</para>
  <para style="q1" vid="PSA 86:11">halo hau nia laran firmi,</para>
  <para style="q2" vid="PSA 86:11">atu hau bele hamtauk deit ba Ita Boot nia naran.<verse eid="PSA 86:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12" />Nai, hau nia Maromak, hau sei hahii Ita Boot ho hau nia laran tomak;</para>
  <para style="q2" vid="PSA 86:12">hau sei foti aas Ita Boot nia naran tinan ba tinan.<verse eid="PSA 86:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13" />Tanba Ita Boot nia domin mai hau boot teb-tebes;</para>
  <para style="q2" vid="PSA 86:13">Ita Boot salva tiha ona hau nia vida husi matebian sira nia fatin.<verse eid="PSA 86:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14" />Maromak, ema foti aan sira ataka hela hau;</para>
  <para style="q2" vid="PSA 86:14">grupu laran aat hakarak hasai hau nia vida;</para>
  <para style="q2" vid="PSA 86:14">sira la interese Ita Boot.<verse eid="PSA 86:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15" />Maibee Nai, Ita Boot nee Maromak laran diak no laran luak;</para>
  <para style="q2" vid="PSA 86:15">Ita Boot Pasiensia Nain, nakonu ho domin rohan-laek no sempre halo buat nebee mak loos.<verse eid="PSA 86:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16" />Fila oin mai hau hodi hanoin hau ba;</para>
  <para style="q2" vid="PSA 86:16">haraik Ita Boot nia forsa ba Ita Boot nia atan hau;</para>
  <para style="q2" vid="PSA 86:16">hau Ita Boot nia atan feto nia oan, salva hau ba.<verse eid="PSA 86:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17" />Hatudu netik sinal ida katak Ita Boot laran diak mai hau.</para>
  <para style="q2" vid="PSA 86:17">Nunee ema nebee odi hau bele haree no moe,</para>
  <para style="q2" vid="PSA 86:17">tanba NAI Maromak, Ita Boot tulun ona hau no foo ksolok mai hau.<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="s">Sidade Siaun nee Nai Maromak nian</para>
  <para style="d">Salmu husi Korá nia oan. Kantiku ida.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1" />NAI Maromak harii tiha ona Nia sidade iha foho santu.<verse eid="PSA 87:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2" />NAI gosta portaun sidade Siaun nian</para>
  <para style="q2" vid="PSA 87:2">liu fali hela fatin hotu-hotu iha rai Israel. <note caller="+" style="f"><char style="fr" closed="false">87:2 </char><char style="ft" closed="false">Lian Ebreu dehan “Jacó”. Iha nee refere ba Israel.</char></note><verse eid="PSA 87:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3" />Maromak nia sidade,</para>
  <para style="q2" vid="PSA 87:3">ema konta buat mesak furak kona ba o.<verse eid="PSA 87:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4" />Maromak dehan, “Bainhira Hau temi ema sira nebee rekonhese Hau,</para>
  <para style="q2" vid="PSA 87:4">Hau temi mos rai Rahab <note caller="+" style="f"><char style="fr" closed="false">87:4 </char><char style="ft" closed="false">Rahab nee mak rai Ejitu. Naran nee uza iha poezia.</char></note> ho Babilónia nia naran,</para>
  <para style="q1" vid="PSA 87:4">ho tan rai Filístia, Tiru ho Etiópia.</para>
  <para style="q2" vid="PSA 87:4">Hau sei foo sai dehan, sira mos Siaun oan.”<verse eid="PSA 87:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5" />Loos duni, kona ba Siaun ema sei dehan,</para>
  <para style="q2" vid="PSA 87:5">“Sira nee hotu moris iha nebaa,</para>
  <para style="q2" vid="PSA 87:5">no Maromak Aas Liu rasik sei harii sidade nee.”<verse eid="PSA 87:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6" />Bainhira NAI rejista Nia povu, Nia sei hakerek,</para>
  <para style="q2" vid="PSA 87:6">“Ida nee moris iha Siaun.”<verse eid="PSA 87:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7" />Ema sei bidu rame-rame hodi hananu,</para>
  <para style="q2" vid="PSA 87:7">“Siaun, o mak hau nia bee matan inan.”<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="s">Orasaun iha tempu susar boot</para>
  <para style="d">Salmu husi Korá nia oan, tuir muzika “Mahalat Leanot.” Kantiku ida husi Heman, ema Kanaán, para hanorin ema. Ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1" />NAI Maromak, hau nia Salvador,</para>
  <para style="q2" vid="PSA 88:1">loron-kalan hau halerik husu tulun ba Ita Boot.<verse eid="PSA 88:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2" />Simu hau nia orasaun ba;</para>
  <para style="q2" vid="PSA 88:2">see tilun ba hau nia harohan.<verse eid="PSA 88:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3" />Hau nia laran nakonu ho susar;</para>
  <para style="q2" vid="PSA 88:3">hau besik ona ba iha ema mate nia fatin.<verse eid="PSA 88:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4" />Ema sura tiha ona hau hamutuk ho ema nebee lao tuun dadauk ba rai kuak;</para>
  <para style="q2" vid="PSA 88:4">hau hanesan ema ida nebee la iha forsa.<verse eid="PSA 88:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5" />Hau hela mes-mesak iha ema mate sira nia klaran;</para>
  <para style="q2" vid="PSA 88:5">hau hanesan vitima nebee ema oho hodi latan iha rate laran.</para>
  <para style="q1" vid="PSA 88:5">Ema mate sira nee Ita Boot la hanoin tan ona;</para>
  <para style="q2" vid="PSA 88:5">Ita Boot la tulun ona sira.<verse eid="PSA 88:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6" />Ita Boot soe tiha ona hau tuun liu iha rai kuak naruk,</para>
  <para style="q2" vid="PSA 88:6">iha fatin nakukun teb-tebes.<verse eid="PSA 88:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7" />Ita Boot nia hirus halo todan hau;</para>
  <para style="q2" vid="PSA 88:7">Ita Boot halo laloran makaas mai hotu hodi hanehan hau.<verse eid="PSA 88:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8" />Ita Boot haketak tiha hau husi hau nia belun diak;</para>
  <para style="q2" vid="PSA 88:8">Ita Boot halo sira hakribi hau;</para>
  <para style="q1" vid="PSA 88:8">hau iha hela fatin kloot, no sai la diak;<verse eid="PSA 88:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 88:9" />hau nia matan malahuk tanba hau tristi liu.</para>
  <para style="q1" vid="PSA 88:9">NAI Maromak, loro-loron hau harohan ba Ita Boot;</para>
  <para style="q2" vid="PSA 88:9">hau hasae hau nia liman ba Ita Boot.<verse eid="PSA 88:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10" />Ita Boot hatudu milagre ba ema mate sira ka?</para>
  <para style="q2" vid="PSA 88:10">Matebian sira hadeer fali hodi hahii Ita Boot ka?<verse eid="PSA 88:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11" />Ema foo sai Ita Boot nia domin iha rate laran ka?</para>
  <para style="q2" vid="PSA 88:11">Ema deklara Ita Boot nia salvasaun iha mate sira nia rain ka?<verse eid="PSA 88:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12" />Iha fatin nakukun nian, ema rekonhese Ita Boot nia milagre ka?</para>
  <para style="q2" vid="PSA 88:12">Iha fatin nebee ema haluha buat hotu-hotu, ema sei hatene Ita Boot nia justisa ka?<verse eid="PSA 88:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13" />Maibee NAI Maromak, hau harohan husu tulun ba Ita Boot;</para>
  <para style="q2" vid="PSA 88:13">dadeer-dadeer hau nia orasaun sae ba iha Ita Boot nia oin.<verse eid="PSA 88:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14" />NAI, tansaa mak Ita Boot la simu hau?</para>
  <para style="q2" vid="PSA 88:14">Tansaa mak Ita Boot subar oin mai hau?<verse eid="PSA 88:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15" />Komesa husi joven, hau hetan terus no besik atu mate;</para>
  <para style="q2" vid="PSA 88:15">Ita Boot husik hela todan iha hau nia leten too hau lakon esperansa.<verse eid="PSA 88:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16" />Ita Boot nia laran nakali domina hela hau;</para>
  <para style="q2" vid="PSA 88:16">Ita Boot asalta hau halo hau mohu.<verse eid="PSA 88:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17" />Iha loron tomak Ita Boot nia hirus hanesan bee boot ida nebee dulas haleu,</para>
  <para style="q2" vid="PSA 88:17">halo hau mout sal-sala.<verse eid="PSA 88:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18" />Ita Boot hasai tiha ona hau husi hau nia belun ho vizinhu sira;</para>
  <para style="q2" vid="PSA 88:18">agora nakukun mak sai fali hau nia belun.<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="s">Nai Maromak nia promesa ba liurai David</para>
  <para style="d">Salmu husi Etán, ema Kanaán, para hanorin ema.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1" />NAI Maromak, hau sei hananu tinan ba tinan kona ba Ita Boot nia domin rohan-laek;</para>
  <para style="q2" vid="PSA 89:1">husi jerasaun ba jerasaun hau nia ibun sei foo sai katak Ita Boot sempre halo buat nebee mak loos.<verse eid="PSA 89:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2" />Hau sei deklara katak Ita Boot nia domin metin nafatin ba nafatin;</para>
  <para style="q2" vid="PSA 89:2">Ita Boot nia lia loos dura hanesan lalehan.<verse eid="PSA 89:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3" />Uluk Ita Boot hatete nunee: “Hau halo ona promesa ho ema ida nebee Hau hili;</para>
  <para style="q2" vid="PSA 89:3">Hau jura tiha ona ba Hau nia atan David dehan,<verse eid="PSA 89:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">89:4 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 7:12-16">2 Samuel 7:12-16</ref>; <ref loc="1CH 17:11-14">1 Krónikas 17:11-14</ref>; <ref loc="PSA 132:11">Salmu 132:11</ref>; <ref loc="ACT 2:30">Apostolu sira nia Istoria 2:30</ref></char>
    </note>‘Hau sei halo o nia jerasaun ukun tinan ba tinan;</para>
  <para style="q2" vid="PSA 89:4">sira sei sai liurai husi jerasaun ba jerasaun.’ ”<verse eid="PSA 89:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5" />NAI Maromak, lalehan hahii buat furak nebee Ita Boot halo;</para>
  <para style="q2" vid="PSA 89:5">espiritu bo-boot sira halibur malu hahii NAI tanba NAI sempre halo buat nebee mak loos.<verse eid="PSA 89:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6" />Iha lalehan, see mak bele kompara ho NAI?</para>
  <para style="q2" vid="PSA 89:6">Hotu-hotu nebee iha lalehan, see mak hanesan NAI?<verse eid="PSA 89:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7" />Maromak makaas liu fali espiritu bo-boot nebee haleu Nia;</para>
  <para style="q2" vid="PSA 89:7">sira hotu hamtauk teb-tebes Nia.<verse eid="PSA 89:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8" />NAI Maromak Aswain, see mak makaas hanesan Ita Boot?</para>
  <para style="q2" vid="PSA 89:8">NAI, Ita Boot sempre halo buat nebee mak loos.<verse eid="PSA 89:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9" />Ita Boot mak ukun tasi nebee nafurin sae;</para>
  <para style="q2" vid="PSA 89:9">bainhira laloran makaas, Ita Boot mak halo hakmatek fali.<verse eid="PSA 89:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10" />Ita Boot buti mate samea boot Rahab;</para>
  <para style="q2" vid="PSA 89:10">hodi Ita Boot nia liman forti Ita Boot halo inimigu sira halai namkari tiha.<verse eid="PSA 89:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11" />Lalehan nee Ita Boot nian, rai mos Ita Boot nian hotu;</para>
  <para style="q2" vid="PSA 89:11">mundu ho buat hotu-hotu iha laran, Ita Boot mak harii.<verse eid="PSA 89:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12" />Parte norte ho sul, Ita Boot mak kria;</para>
  <para style="q2" vid="PSA 89:12">foho Tabor ho Hermon haksolok hodi hahii Ita Boot nia naran.<verse eid="PSA 89:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13" />Ita Boot nia liman forsa;</para>
  <para style="q2" vid="PSA 89:13">Ita Boot nia liman forti;</para>
  <para style="q2" vid="PSA 89:13">Ita Boot nia liman loos makaas teb-tebes.<verse eid="PSA 89:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14" />Ita Boot ukun nudar Liurai tuir lia loos ho justisa;</para>
  <para style="q2" vid="PSA 89:14">Ita Boot ukun ho domin, no sempre halo buat nebee mak loos.<verse eid="PSA 89:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15" />NAI Maromak, ema nebee hatene haklalak hodi hahii Ita Boot,</para>
  <para style="q2" vid="PSA 89:15">ema nebee lao iha Ita Boot nia futar oin naroman,</para>
  <para style="q2" vid="PSA 89:15">sira nee hetan ksolok.<verse eid="PSA 89:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16" />Loron-kalan sira haksolok tanba Ita Boot nia naran;</para>
  <para style="q2" vid="PSA 89:16">sira haksolok haklalak tanba Ita Boot nia lia loos.<verse eid="PSA 89:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17" />Tanba Ita Boot mak sira nia kbiit no sira nia forsa;</para>
  <para style="q2" vid="PSA 89:17">Ita Boot nia laran diak halo ami manaan.<verse eid="PSA 89:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18" />Tebes duni, NAI Maromak mak hili ema ida sai ami nia defensor;</para>
  <para style="q2" vid="PSA 89:18">ami nia liurai nee nia Nain mak Israel nia Maromak Santu.<verse eid="PSA 89:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19" />Uluk Ita Boot koalia liu husi mehi</para>
  <para style="q2" vid="PSA 89:19">hodi hatete ba Ita Boot nia povu santu dehan,</para>
  <para style="q1" vid="PSA 89:19">“Hau tau tiha ona koroa liurai nian ba iha aswain ida nia ulun;</para>
  <para style="q2" vid="PSA 89:19">Hau foti sae mane joven ida husi povu nia leet.<verse eid="PSA 89:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20" />
    <note caller="+" style="x">
      <char style="xo" closed="false">89:20 a </char>
      <char style="xt" closed="false">
        <ref loc="1SA 13:14">1 Samuel 13:14</ref>; <ref loc="ACT 13:22">Apostolu sira nia Istoria 13:22</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="1SA 16:12">1 Samuel 16:12</ref>
      </char>
    </note>Hau hetan Hau nia atan David;</para>
  <para style="q2" vid="PSA 89:20">Hau kose Hau nia mina santu ba nia hodi halo nia sai liurai.<verse eid="PSA 89:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21" />Hau nia liman sei tane nia;</para>
  <para style="q2" vid="PSA 89:21">Hau nia liman sei halo nia forsa.<verse eid="PSA 89:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22" />Inimigu sira sei la liu nia;</para>
  <para style="q2" vid="PSA 89:22">ema aat sei la hanehan nia.<verse eid="PSA 89:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23" />Hau sei sama hanehan nia funu baluk sira iha nia oin;</para>
  <para style="q2" vid="PSA 89:23">ema nebee odi nia, Hau sei oho tiha.<verse eid="PSA 89:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24" />Hau sei hadomi nia hodi kaer metin Hau nia promesa ba nia;</para>
  <para style="q2" vid="PSA 89:24">hodi Hau nia naran, nia sei manaan.<verse eid="PSA 89:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25" />Hau sei halo nia liman ukun tasi;</para>
  <para style="q2" vid="PSA 89:25">nia liman loos ukun mota.<verse eid="PSA 89:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26" />Nia sei dehan sai mai Hau,</para>
  <para style="q2" vid="PSA 89:26">‘Ita Boot mak hau nia Aman,</para>
  <para style="q2" vid="PSA 89:26">hau nia Maromak;</para>
  <para style="q2" vid="PSA 89:26">Ita Boot mak fatuk lolon boot nebee hau helik ba para hetan salvasaun.’<verse eid="PSA 89:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27" />
    <note caller="+" style="x">
      <char style="xo" closed="false">89:27 </char>
      <char style="xt" closed="false">
        <ref loc="REV 1:5">Apokalipse 1:5</ref>
      </char>
    </note>Hau sei foti nia nudar Hau nia oan mane boot;</para>
  <para style="q2" vid="PSA 89:27">nia mak liurai boot liu iha mundu.<verse eid="PSA 89:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28" />Hau sei foo Hau nia domin ba nia tinan ba tinan;</para>
  <para style="q2" vid="PSA 89:28">Hau nia promesa ho Hau nia lei la hotu la remata.<verse eid="PSA 89:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29" />Hau sei halo nia jerasaun ukun tinan ba tinan;</para>
  <para style="q2" vid="PSA 89:29">sira nia ukun sei dura hanesan lalehan.<verse eid="PSA 89:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30" />Se karik nia oan sira husik tiha Hau nia lei,</para>
  <para style="q2" vid="PSA 89:30">no la tuir Hau nia regulamentu,<verse eid="PSA 89:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31" />se karik sira viola Hau nia regra,</para>
  <para style="q2" vid="PSA 89:31">no la kaer metin Hau nia ukun fuan,<verse eid="PSA 89:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32" />entaun Hau sei kastigu sira ho rota tanba sira halo sala hasoru Hau;</para>
  <para style="q2" vid="PSA 89:32">Hau sei baku sira ho sikoti tanba sira halo pekadu.<verse eid="PSA 89:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33" />Maibee Hau sei la hasai fali Hau nia domin husi nia;</para>
  <para style="q2" vid="PSA 89:33">Hau sei la haluha Hau nia promesa.<verse eid="PSA 89:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34" />Hau sei la kontra hau nia promesa ho nia;</para>
  <para style="q2" vid="PSA 89:34">liafuan nebee sai husi Hau nia ibun, sei la muda.<verse eid="PSA 89:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35" />Hau sei la bosok David;</para>
  <para style="q2" vid="PSA 89:35">Hau jura tiha ona dala ida hodi Hau nia naran santu;</para>
  <para style="q2" vid="PSA 89:35">juramentu nee dura ba nafatin katak,<verse eid="PSA 89:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36" />nia jerasaun sei ukun tinan ba tinan;</para>
  <para style="q2" vid="PSA 89:36">nia ukun dura iha Hau nia oin hanesan loro matan;<verse eid="PSA 89:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37" />nia ukun harii metin nafatin ba nafatin hanesan fulan;</para>
  <para style="q2" vid="PSA 89:37">fulan nee mos foo sasin lo-loos husi kalohan.”<verse eid="PSA 89:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38" />Maibee agora Ita Boot la simu liurai hodi soe tiha nia;</para>
  <para style="q2" vid="PSA 89:38">Ita Boot hirus teb-tebes ho ema nebee mak Ita Boot hili ona nee.<verse eid="PSA 89:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39" />Ita Boot kansela tiha promesa ho Ita Boot nia atan;</para>
  <para style="q2" vid="PSA 89:39">Ita Boot soe nia koroa ba iha rai rahun.<verse eid="PSA 89:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40" />Ita Boot baku rahun tiha hotu moru sidade nian</para>
  <para style="q2" vid="PSA 89:40">hodi estraga tiha nia fatin seguru.<verse eid="PSA 89:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41" />Ema hotu nebee liu husi nebaa hadau nia sasaan;</para>
  <para style="q2" vid="PSA 89:41">nia vizinhu sira hamnasa fali nia.<verse eid="PSA 89:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42" />Ita Boot halo nia funu baluk sira manaan;</para>
  <para style="q2" vid="PSA 89:42">Ita Boot halo nia inimigu sira hotu kontenti.<verse eid="PSA 89:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43" />Ita Boot mos fila tiha nia surik nia kroat,</para>
  <para style="q2" vid="PSA 89:43">no la ajuda nia iha funu laran.<verse eid="PSA 89:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44" />Ita Boot hasai tiha nia poder;</para>
  <para style="q2" vid="PSA 89:44">nia kadeira ukun, Ita Boot soe tiha ba rai.<verse eid="PSA 89:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45" />Ita Boot habadak tiha ona nia vida joven;</para>
  <para style="q2" vid="PSA 89:45">Ita Boot falun nia ho moe.<verse eid="PSA 89:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46" />NAI Maromak, Ita Boot subar Aan beibeik too bainhira? Too tinan ba tinan ka?</para>
  <para style="q2" vid="PSA 89:46">Ita Boot nia hirus lakan hanesan ahi too bainhira?<verse eid="PSA 89:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47" />Keta haluha katak hau nia moris badak deit;</para>
  <para style="q2" vid="PSA 89:47">Ita Boot kria ema umanu la iha folin.<verse eid="PSA 89:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48" />See mak bele moris ba beibeik no nunka mate?</para>
  <para style="q2" vid="PSA 89:48">See mak bele halai sees husi forsa rai kuak nian?<verse eid="PSA 89:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49" />Nai Maromak, uluk Ita Boot jura ho laran atu foo domin rohan-laek ba David.</para>
  <para style="q2" vid="PSA 89:49">Agora Ita Boot nia domin nee iha nebee ona?<verse eid="PSA 89:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50" />Nai, haree ba, ema tarata Ita Boot nia atan hau;</para>
  <para style="q2" vid="PSA 89:50">hau hulan hela liafuan aat nebee ema barak hatete kona ba hau.<verse eid="PSA 89:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51" />NAI, Ita Boot nia inimigu sira tarata hau;</para>
  <para style="q2" vid="PSA 89:51">iha nebee-nebee deit sira hatete aat liurai nebee Ita Boot hili tiha ona.<verse eid="PSA 89:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52" />Hahii NAI Maromak tinan ba tinan!</para>
  <para style="q2" vid="PSA 89:52">Amen, amen.<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="s">Husu Nai Maromak nia laran diak tanba ita ema nia moris badak deit</para>
  <para style="d">Orasaun husi Moisés, Maromak nia liman-ain.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1" />Nai Maromak, Ita Boot mak ami nia hela fatin</para>
  <para style="q2" vid="PSA 90:1">husi jerasaun ba jerasaun.<verse eid="PSA 90:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2" />Molok Ita Boot halo mundu rai klaran,</para>
  <para style="q2" vid="PSA 90:2">foho sira seidauk mosu,</para>
  <para style="q1" vid="PSA 90:2">Ita Boot Maromak nanis kedas ona;</para>
  <para style="q2" vid="PSA 90:2">Ita Boot Maromak nafatin ba nafatin.<verse eid="PSA 90:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3" />Ita Boot halo ema fila fali ba rai rahun;</para>
  <para style="q2" vid="PSA 90:3">Ita Boot dehan, “Imi ema isin ho raan, fila fali ba rai rahun ba.”<verse eid="PSA 90:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">90:4 </char>
      <char style="xt" closed="false">
        <ref loc="2PE 3:8">2 Pedro 3:8</ref>
      </char>
    </note>Ba Ita Boot, tinan rihun ida</para>
  <para style="q2" vid="PSA 90:4">hanesan fali loron ida, liu lalais deit,</para>
  <para style="q2" vid="PSA 90:4">hanesan oras balu nebee ema seguransa hein iha tempu kalan.<verse eid="PSA 90:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5" />Ita Boot dasa sai tiha ema, sira lakon hanesan mehi;</para>
  <para style="q2" vid="PSA 90:5">sira hanesan duut nebee moris iha dadeer-saan.<verse eid="PSA 90:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6" />Iha dadeer duut nee tubun buras,</para>
  <para style="q2" vid="PSA 90:6">maibee iha lokraik namlaik tiha too maran.<verse eid="PSA 90:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7" />Ita Boot nia hirus halo ami atu mohu;</para>
  <para style="q2" vid="PSA 90:7">Ita Boot nia laran nakali halo ami tauk teb-tebes.<verse eid="PSA 90:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8" />Ita Boot halekar ami nia pekadu iha Ita Boot nia oin;</para>
  <para style="q2" vid="PSA 90:8">ami nia sala segredu Ita Boot leno sai mo-moos.<verse eid="PSA 90:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9" />Loron ba loron Ita Boot nia hirus taka tomak ami nia moris;</para>
  <para style="q2" vid="PSA 90:9">ami nia moris remata ho halerik.<verse eid="PSA 90:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10" />Ami nia vida too tinan hitu-nulu deit;</para>
  <para style="q2" vid="PSA 90:10">se ami iha forsa karik, bele too walu-nulu.</para>
  <para style="q1" vid="PSA 90:10">Bele nunee mos, tinan hirak nee hotu ami hetan susar ho terus;</para>
  <para style="q2" vid="PSA 90:10">tempu nee liu lalais deit, depois ami semo lakon tiha.<verse eid="PSA 90:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11" />La iha ema ida bele hatene Ita Boot nia hirus nee forsa too iha nebee.</para>
  <para style="q2" vid="PSA 90:11">Ita Boot nia laran nakali makaas liu, halo ami hamtauk teb-tebes Ita Boot.<verse eid="PSA 90:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12" />Hanorin ami atu hatene sura ami nia loron,</para>
  <para style="q2" vid="PSA 90:12">nunee ami bele sai matenek.<verse eid="PSA 90:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13" />NAI Maromak, fila mai ba!</para>
  <para style="q2" vid="PSA 90:13">Ita Boot atu hirus too bainhira?</para>
  <para style="q2" vid="PSA 90:13">Hanoin Ita Boot nia atan sira ba.<verse eid="PSA 90:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14" />Iha dadeer-saan, habosu ami ho Ita Boot nia domin rohan-laek,</para>
  <para style="q2" vid="PSA 90:14">atu ami bele kanta haksolok ho kontenti iha ami nia moris tomak.<verse eid="PSA 90:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15" />Durante tempu naruk Ita Boot halo ami terus;</para>
  <para style="q2" vid="PSA 90:15">foo ksolok fali mai ami durante tempu naruk ba;</para>
  <para style="q1" vid="PSA 90:15">durante tinan barak ami hetan susar;</para>
  <para style="q2" vid="PSA 90:15">halo ami haksolok fali durante tinan barak.<verse eid="PSA 90:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16" />Husik Ita Boot nia atan ami haree buat nebee mak Ita Boot halo;</para>
  <para style="q2" vid="PSA 90:16">husik ami nia oan sira haree Ita Boot nia furak.<verse eid="PSA 90:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17" />Nai ami nia Maromak, hatudu laran diak mai ami;</para>
  <para style="q2" vid="PSA 90:17">halo ami nia servisu lao ba oin;</para>
  <para style="q2" vid="PSA 90:17">halo ami nia knaar lao ba oin.<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="s">Hela iha Nai Maromak nia mahon</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1" />Ema nebee moris hamahon aan iha Maromak Aas Liu,</para>
  <para style="q2" vid="PSA 91:1">ema nebee hakmatek iha Maromak Kbiit Nain nia mahon,<verse eid="PSA 91:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2" />nia sei hatete ba NAI Maromak,</para>
  <para style="q2" vid="PSA 91:2">“Ita Boot mak fatin seguru mai hau, Ita Boot mak lutu haleu hau;</para>
  <para style="q2" vid="PSA 91:2">hau nia Maromak, hau konfia Ita Boot.”<verse eid="PSA 91:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3" />Tebes duni, Maromak sei salva o</para>
  <para style="q2" vid="PSA 91:3">husi lasu nebee kasador sira tau iha dalan,</para>
  <para style="q2" vid="PSA 91:3">no husi moras aat nebee hamate ema.<verse eid="PSA 91:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4" />Nia sei falun o hodi Nia liras;</para>
  <para style="q2" vid="PSA 91:4">o sei hamahon aan iha Nia liras okos;</para>
  <para style="q2" vid="PSA 91:4">Nia domin sei haleu o hodi defende o.<verse eid="PSA 91:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5" />O sei la tauk buat aat iha kalan;</para>
  <para style="q2" vid="PSA 91:5">o sei la tauk rama oan nebee semo iha loron.<verse eid="PSA 91:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6" />Moras aat nebee lao iha nakukun laran,</para>
  <para style="q2" vid="PSA 91:6">ka moras nebee ameasa ema iha loron manas mos o sei la tauk.<verse eid="PSA 91:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7" />Maski ema rihun ida monu iha o nia sorin,</para>
  <para style="q2" vid="PSA 91:7">maski ema rihun sanulu monu iha o nia liman loos,</para>
  <para style="q2" vid="PSA 91:7">maibee buat ida la kona o.<verse eid="PSA 91:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8" />O nia matan sei hateke tuir deit;</para>
  <para style="q2" vid="PSA 91:8">o sei haree oinsaa ema aat hetan kastigu.<verse eid="PSA 91:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9" />Se o halo NAI Maromak sai o nia fatin seguru,</para>
  <para style="q2" vid="PSA 91:9">se o halo Maromak Aas Liu sai o nia hela fatin,<verse eid="PSA 91:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10" />entaun buat aat sei la kona o;</para>
  <para style="q2" vid="PSA 91:10">dezastre sei la mai besik o nia hela fatin.<verse eid="PSA 91:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">91:11 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:6">Mateus 4:6</ref>; <ref loc="LUK 4:10">Lucas 4:10</ref></char>
    </note>Tanba Maromak sei haruka Nia anju sira mai kuidadu o</para>
  <para style="q2" vid="PSA 91:11">iha o nia moris tomak.<verse eid="PSA 91:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">91:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:6">Mateus 4:6</ref>; <ref loc="LUK 4:11">Lucas 4:11</ref></char>
    </note>Sira sei lolo liman hodi tane o,</para>
  <para style="q2" vid="PSA 91:12">atu o nia ain la bele kona fatuk.<verse eid="PSA 91:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">91:13 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:19">Lucas 10:19</ref>
      </char>
    </note>O sei sama liaun ho samea kobra;</para>
  <para style="q2" vid="PSA 91:13">o sei sama hanehan liaun forti ho samea boot.<verse eid="PSA 91:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14" />NAI Maromak dehan, “Hau sei salva ema nebee hadomi Hau;</para>
  <para style="q2" vid="PSA 91:14">Hau sei proteje ema nebee hatene tuir Hau nia naran.<verse eid="PSA 91:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15" />Bainhira nia husu tulun mai Hau, Hau sei hataan;</para>
  <para style="q2" vid="PSA 91:15">Hau sei hamutuk ho nia iha susar laran;</para>
  <para style="q2" vid="PSA 91:15">Hau sei defende nia no foti aas nia.<verse eid="PSA 91:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16" />Hau sei haraik vida naruk ba nia hodi halo nia kontenti;</para>
  <para style="q2" vid="PSA 91:16">Hau sei hatudu Hau nia salvasaun ba nia.”<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s">Kantiku hahii Nai Maromak</para>
  <para style="d">Salmu. Kantiku ba loron Sabadu.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1" />Hahii NAI Maromak nee buat diak ida;</para>
  <para style="q2" vid="PSA 92:1">Maromak Aas Liu, hananu hahii Ita Boot nia naran nee furak.<verse eid="PSA 92:1" /></para>
  <para style="q1">
    <verse number="2-3" style="v" sid="PSA 92:2-3" />Iha dadeer-saan hau toka viola</para>
  <para style="q2" vid="PSA 92:2-3">hodi foo sai Ita Boot nia domin rohan-laek;</para>
  <para style="q1" vid="PSA 92:2-3">iha kalan hau halo muzika ho viola tali sanulu</para>
  <para style="q2" vid="PSA 92:2-3">hodi deklara katak Ita Boot sempre halo buat nebee loos;</para>
  <para style="q2" vid="PSA 92:2-3">hahii Ita Boot nunee buat furak ida.<verse eid="PSA 92:2-3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4" />NAI Maromak, hau kontenti tanba buat nebee Ita Boot halo;</para>
  <para style="q2" vid="PSA 92:4">hau hananu haksolok tanba buat nebee Ita Boot nia liman halo tiha ona.<verse eid="PSA 92:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5" />NAI, Ita Boot nia servisu furak loos;</para>
  <para style="q2" vid="PSA 92:5">Ita Boot nia hanoin klean teb-tebes.<verse eid="PSA 92:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6" />Ema sira nebee kakutak mamuk la hatene;</para>
  <para style="q2" vid="PSA 92:6">ema beik-teen la kompriende katak,<verse eid="PSA 92:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7" />ema aat bele buras lalais hanesan duut;</para>
  <para style="q2" vid="PSA 92:7">ema nebee gosta hahalok aat bele moris diak,</para>
  <para style="q2" vid="PSA 92:7">maibee too ikus sira sei mohu tinan ba tinan.<verse eid="PSA 92:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8" />Maibee NAI Maromak, Ita Boot iha fatin aas tinan ba tinan.<verse eid="PSA 92:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9" />Tebes duni NAI,</para>
  <para style="q2" vid="PSA 92:9">ema nebee hahalok aat sei halai namkari hotu;</para>
  <para style="q2" vid="PSA 92:9">Ita Boot nia inimigu sira sei mate mohu.<verse eid="PSA 92:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10" />Ita Boot hasae tiha ona hau nia dikur hanesan karau aman fuik nia dikur;</para>
  <para style="q2" vid="PSA 92:10">Ita Boot fui mina morin diak nian ba hau nia leten.<verse eid="PSA 92:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11" />Hau nia matan haree ona hau nia inimigu sira monu;</para>
  <para style="q2" vid="PSA 92:11">hau nia tilun rona ona hau nia funu baluk sira halai saruntu malu.<verse eid="PSA 92:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12" />Ema nebee moris loos sei buras hanesan ramus huun;</para>
  <para style="q2" vid="PSA 92:12">sira sei sai forti hanesan ai huun sedru iha rai Líbanu.<verse eid="PSA 92:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13" />Sira nee kuda tiha ona iha NAI Maromak nia uma;</para>
  <para style="q2" vid="PSA 92:13">sira sei buras iha ita nia Maromak nia uma kreda.<verse eid="PSA 92:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14" />Maski sira idade ona mos, sira sei matak ho buras;</para>
  <para style="q2" vid="PSA 92:14">sira sei foo fuan ba beibeik.<verse eid="PSA 92:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15" />Sira foo sai dehan, “NAI Maromak nee sempre halo buat nebee loos;</para>
  <para style="q2" vid="PSA 92:15">Nia mak fatuk lolon boot nebee hau helik ba;</para>
  <para style="q2" vid="PSA 92:15">la iha buat aat ida iha Nia.”<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="s">Nai Maromak ukun tinan ba tinan</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1" />NAI Maromak mak Liurai, Nia hatais murak mean;</para>
  <para style="q2" vid="PSA 93:1">NAI hatudu sai Nia kbiit.</para>
  <para style="q1" vid="PSA 93:1">Nia harii metin mundu nee,</para>
  <para style="q2" vid="PSA 93:1">mundu nunka atu nakdoko.<verse eid="PSA 93:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2" />Ita Boot ukun nanis kedas;</para>
  <para style="q2" vid="PSA 93:2">Ita Boot iha hori uluk liu.<verse eid="PSA 93:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3" />NAI Maromak, laloran tasi hasae lian;</para>
  <para style="q2" vid="PSA 93:3">tasi nia lian makaas;</para>
  <para style="q2" vid="PSA 93:3">laloran tasi tarutu hasae nia lian.<verse eid="PSA 93:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4" />NAI iha fatin aas ba, Nia makaas teb-tebes;</para>
  <para style="q2" vid="PSA 93:4">makaas liu bee boot nebee tarutu,</para>
  <para style="q2" vid="PSA 93:4">makaas liu laloran tasi nebee baku ba-mai.<verse eid="PSA 93:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5" />NAI, Ita Boot nia mandamentu dura nafatin;</para>
  <para style="q2" vid="PSA 93:5">Ita Boot nia uma santu teb-tebes too tinan ba tinan.<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="s">Nai Maromak mak Justisa Nain</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1" />NAI Maromak, Ita Boot mak kastigu ema nebee halo buat aat;</para>
  <para style="q2" vid="PSA 94:1">Ita Boot mak selu fali buat aat nebee sira halo;</para>
  <para style="q2" vid="PSA 94:1">Maromak, hatudu Aan ba!<verse eid="PSA 94:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2" />Juis mundu tomak nian, hamriik ba;</para>
  <para style="q2" vid="PSA 94:2">selu fali ema foti aan sira tuir buat nebee sira merese hetan.<verse eid="PSA 94:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3" />NAI, ema aat sira atu kontenti too bainhira?</para>
  <para style="q2" vid="PSA 94:3">Ema aat sira nee sei haklalak too bainhira?<verse eid="PSA 94:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4" />Sira muta sai liafuan gaba aan;</para>
  <para style="q2" vid="PSA 94:4">ema nebee hahalok aat, sira mesak foti aan deit.<verse eid="PSA 94:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5" />NAI, sira sama rahun Ita Boot nia povu;</para>
  <para style="q2" vid="PSA 94:5">sira hanehan povu nebee Ita Boot rasik hili.<verse eid="PSA 94:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6" />Sira oho feto faluk ho ema lao rai;</para>
  <para style="q2" vid="PSA 94:6">sira hakotu oan kiak sira nia vida.<verse eid="PSA 94:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7" />Sira dehan, “NAI la haree ida;</para>
  <para style="q2" vid="PSA 94:7">Jacó nia Maromak la preokupa.”<verse eid="PSA 94:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8" />Imi kakutak mamuk sira iha povu nia leet, rona mai.</para>
  <para style="q2" vid="PSA 94:8">Imi ema beik-teen sira nee, bainhira mak imi bele kompriende?<verse eid="PSA 94:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9" />Ida nebee kria tilun nee la rona fali ka?</para>
  <para style="q2" vid="PSA 94:9">Ida nebee halo matan nee la haree fali ka?<verse eid="PSA 94:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10" />Ida nebee foo disiplina ba nasaun jentiu sira la hatene foo kastigu ka?</para>
  <para style="q2" vid="PSA 94:10">Ida nebee hanorin ema, Nia konhesimentu la iha fali ka?<verse eid="PSA 94:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">94:11 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 3:20">1 Korintu 3:20</ref>
      </char>
    </note>NAI hatene ema hotu nia hanoin;</para>
  <para style="q2" vid="PSA 94:11">Nia konsidera ema nia hanoin buat mamuk ida.<verse eid="PSA 94:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12" />NAI Maromak, ema nebee Ita Boot koriji,</para>
  <para style="q2" vid="PSA 94:12">ema nebee Ita Boot hanorin kona ba Ita Boot nia lei,</para>
  <para style="q2" vid="PSA 94:12">sira nee hetan ksolok.<verse eid="PSA 94:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13" />Ita Boot halo sira hakmatek iha tempu susar,</para>
  <para style="q2" vid="PSA 94:13">too rai kuak prontu ona ba ema aat sira.<verse eid="PSA 94:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14" />Tanba NAI Maromak nunka soe Nia povu;</para>
  <para style="q2" vid="PSA 94:14">Nia nunka husik hela povu nebee Nia rasik hili ona.<verse eid="PSA 94:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15" />Justisa sei bazeia fali ba lia loos,</para>
  <para style="q2" vid="PSA 94:15">no ema nebee laran moos sei moris tuir.<verse eid="PSA 94:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16" />See mak sei hamriik defende hau hodi hasoru ema aat?</para>
  <para style="q2" vid="PSA 94:16">See mak atu firmi defende hau kontra ema nebee gosta halo aat?<verse eid="PSA 94:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17" />Se laos NAI Maromak mak ajuda hau,</para>
  <para style="q2" vid="PSA 94:17">la kleur tan hau sei baa hela iha rai kuak nebee la iha lian.<verse eid="PSA 94:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18" />NAI, bainhira hau dehan, “Hau nia ain kois,”</para>
  <para style="q2" vid="PSA 94:18">Ita Boot nia domin rohan-laek suporta hau.<verse eid="PSA 94:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19" />Bainhira hau preokupa buat barak iha hau nia laran,</para>
  <para style="q2" vid="PSA 94:19">Ita Boot konsola hau, halo hau haksolok.<verse eid="PSA 94:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20" />Ukun nain laran aat nebee uza lei hodi hanehan povu</para>
  <para style="q2" vid="PSA 94:20">bele koopera ho Ita Boot ka?<verse eid="PSA 94:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21" />Ema aat sira nee kombina malu kontra ema nebee moris loos;</para>
  <para style="q2" vid="PSA 94:21">sira foo kastigu mate ba ema nebee laran moos.<verse eid="PSA 94:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22" />Maibee NAI sai tiha ona hau nia abrigu;</para>
  <para style="q2" vid="PSA 94:22">hau nia Maromak mak fatuk lolon boot nebee hau helik ba.<verse eid="PSA 94:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23" />Nia sei kastigu sira tuir buat aat nebee sira halo;</para>
  <para style="q2" vid="PSA 94:23">Nia sei oho tiha sira tanba sira nia hahalok aat;</para>
  <para style="q2" vid="PSA 94:23">NAI ita nia Maromak sei dasa sai tiha sira.<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="s">Kantiku hahii nian</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1" />Mai ita hananu haksolok ba NAI Maromak;</para>
  <para style="q2" vid="PSA 95:1">mai ita haklalak makaas tanba Nia mak fatuk lolon boot hodi salva ita.<verse eid="PSA 95:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2" />Mai ita baa iha Nia oin hodi foo agradese,</para>
  <para style="q2" vid="PSA 95:2">no toka muzika hodi hananu hahii Nia.<verse eid="PSA 95:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3" />Tanba NAI nee Maromak boot;</para>
  <para style="q2" vid="PSA 95:3">Nia mak Liurai boot, Nia aas liu maromak sel-seluk.<verse eid="PSA 95:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4" />Rai nee nia klean iha Nia liman laran;</para>
  <para style="q2" vid="PSA 95:4">foho aas hotu-hotu Ninian.<verse eid="PSA 95:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5" />Tasi nee Ninian, tanba Nia mak kria;</para>
  <para style="q2" vid="PSA 95:5">Nia liman mak forma rai maran.<verse eid="PSA 95:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6" />Mai ita hakruuk hodi adora Nia;</para>
  <para style="q2" vid="PSA 95:6">mai ita hakneak iha NAI Maromak ita nia Kriador nia oin.<verse eid="PSA 95:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">95:7 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 3:7-11">Ebreu 3:7-11</ref>
      </char>
    </note>
    <note caller="+" style="x">
      <char style="xo" closed="false">95:7 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 3:15">Ebreu 3:15</ref>, <ref loc="HEB 4:7">4:7</ref></char>
    </note>Tanba Nia mak Ita nia Maromak;</para>
  <para style="q2" vid="PSA 95:7">ita nee Nia povu nebee Nia tau matan,</para>
  <para style="q2" vid="PSA 95:7">bibi nebee Nia kuidadu.</para>
  <para style="b" vid="PSA 95:7" />
  <para style="q1" vid="PSA 95:7">Ohin loron, imi tenki rona Nia liafuan;<verse eid="PSA 95:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">95:8 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:1-7">Ézodu 17:1-7</ref>; <ref loc="NUM 20:2-13">Númerus 20:2-13</ref></char>
    </note>la bele ulun toos hanesan imi nia bei-ala sira uluk halo iha rai Meriba,</para>
  <para style="q2" vid="PSA 95:8">hanesan uluk sira halo iha area Masá iha rai fuik maran.<verse eid="PSA 95:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9" />Iha nebaa sira haree Hau nia milagre,</para>
  <para style="q2" vid="PSA 95:9">maibee sira koko Hau nafatin;</para>
  <para style="q2" vid="PSA 95:9">sira sadik nafatin Hau.<verse eid="PSA 95:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10" />Durante tinan haat-nulu Hau hirus sira hodi dehan,</para>
  <para style="q1" vid="PSA 95:10">“Sira nee povu ida nebee sempre lao sees husi dalan loos,</para>
  <para style="q2" vid="PSA 95:10">no lakohi rona Hau nia liafuan.”<verse eid="PSA 95:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">95:11 a </char>
      <char style="xt" closed="false">
        <ref loc="NUM 14:20-23">Númerus 14:20-23</ref>; <ref loc="DEU 1:34-36">Deuteronómiu 1:34-36</ref>; <ref loc="HEB 4:3">Ebreu 4:3</ref>,<ref loc="HEB 4:5">5</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="DEU 12:9">Deuteronómiu 12:9</ref>,<ref loc="DEU 12:10">10</ref></char>
    </note>Nee mak Hau hirus too Hau jura dehan,</para>
  <para style="q2" vid="PSA 95:11">“Ema sira nee sei la tama iha Hau nia fatin deskansa.”<verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="s">Nai Maromak mak Liurai ho Juis boot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1" />Hananu kantiku foun ba NAI Maromak;</para>
  <para style="q2" vid="PSA 96:1">mundu tomak, hananu ba NAI.<verse eid="PSA 96:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2" />Hananu ba NAI, hahii Nia naran;</para>
  <para style="q2" vid="PSA 96:2">loro-loron foo sai Nia salvasaun.<verse eid="PSA 96:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3" />Deklara sai ba nasaun hotu-hotu kona ba Nia kbiit;</para>
  <para style="q2" vid="PSA 96:3">konta sai ba povu hotu-hotu kona ba buat furak nebee Nia halo tiha ona.<verse eid="PSA 96:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4" />NAI Maromak nee boot, Nia serve atu ita hahii;</para>
  <para style="q2" vid="PSA 96:4">ema tenki hamtauk Nia liu fali maromak sel-seluk.<verse eid="PSA 96:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5" />Tanba nasaun jentiu sira nia maromak la vale buat ida,</para>
  <para style="q2" vid="PSA 96:5">maibee NAI mak halo lalehan.<verse eid="PSA 96:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6" />Nia hatudu sai Nia naran boot ho Nia naroman nabilan;</para>
  <para style="q2" vid="PSA 96:6">Nia kbiit ho Nia furak iha hela Nia fatin santu.<verse eid="PSA 96:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">96:7 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 29:1">Salmu 29:1</ref>,<ref loc="PSA 29:2">2</ref></char>
    </note>Imi nasaun sira hotu, hahii NAI Maromak;</para>
  <para style="q2" vid="PSA 96:7">hahii NAI tanba Nia kbiit boot ho forsa.<verse eid="PSA 96:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8" />Foti aas NAI nia naran, tanba Nia merese duni;</para>
  <para style="q2" vid="PSA 96:8">lori oferta hodi mai iha Nia uma kreda.<verse eid="PSA 96:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9" />Adora NAI iha Nia fatin santu ho furak;</para>
  <para style="q2" vid="PSA 96:9">mundu tomak, nakdedar iha Nia oin ba.<verse eid="PSA 96:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10" />Hatete ba nasaun hotu-hotu dehan,</para>
  <para style="q2" vid="PSA 96:10">“NAI Maromak mak Liurai.</para>
  <para style="q1" vid="PSA 96:10">Mundu nee hamriik metin no nunka atu muda;</para>
  <para style="q2" vid="PSA 96:10">Nia sei tesi lia ba povu hotu-hotu ho lo-loos.”<verse eid="PSA 96:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11" />Lalehan, haksolok ba; mundu, kontenti ba;</para>
  <para style="q2" vid="PSA 96:11">tasi ho buat hotu iha laran, hasai lian ba;<verse eid="PSA 96:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 96:12" />rai maran ho buat hotu nebee iha rai leten, haklalak ba.</para>
  <para style="q1" vid="PSA 96:12">Ai huun hotu-hotu iha ai laran sei hananu ho haksolok<verse eid="PSA 96:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 96:13" />iha NAI Maromak nia oin</para>
  <para style="q1" vid="PSA 96:13">tanba Nia mai,</para>
  <para style="q2" vid="PSA 96:13">Nia mai atu foo justisa ba mundu.</para>
  <para style="q1" vid="PSA 96:13">Nia sei foo justisa ba mundu ho lo-loos;</para>
  <para style="q2" vid="PSA 96:13">Nia tesi povu nia lia tuir Nia lia loos.<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="s">Nai Maromak mak Ukun Nain boot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1" />NAI Maromak mak Liurai;</para>
  <para style="q2" vid="PSA 97:1">mundu rai klaran, kontenti ba;</para>
  <para style="q2" vid="PSA 97:1">rai sira iha tasi balu, haksolok ba!<verse eid="PSA 97:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2" />Kalohan nakukun haleu hela Nia;</para>
  <para style="q2" vid="PSA 97:2">Nia ukun nudar Liurai tuir lia loos ho justisa.<verse eid="PSA 97:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3" />Ahi lakan iha Nia oin</para>
  <para style="q2" vid="PSA 97:3">hodi haan Nia inimigu sira iha fat-fatin.<verse eid="PSA 97:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4" />Rai lakan husi Nia leno mundu;</para>
  <para style="q2" vid="PSA 97:4">haree nunee, rai nakdedar tiha.<verse eid="PSA 97:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5" />Foho sira nabeen iha NAI Maromak nia oin hanesan fali lilin;</para>
  <para style="q2" vid="PSA 97:5">iha mundu tomak nia Nai nia prezensa, foho sira nabeen tiha.<verse eid="PSA 97:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6" />Lalehan foo sai katak Maromak sempre halo buat nebee loos;</para>
  <para style="q2" vid="PSA 97:6">nasaun hotu-hotu haree Nia kbiit boot.<verse eid="PSA 97:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7" />Ema hotu nebee adora estatua lulik,</para>
  <para style="q2" vid="PSA 97:7">sira nebee gaba aan kona ba buat maten, sira sei moe leet;</para>
  <para style="q2" vid="PSA 97:7">maromak hirak nee hotu-hotu tenki hakruuk ba Nia.<verse eid="PSA 97:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8" />NAI Maromak, bainhira Ita Boot foo justisa,</para>
  <para style="q2" vid="PSA 97:8">ema iha sidade Siaun rona hodi haksolok;</para>
  <para style="q2" vid="PSA 97:8">vila hotu-hotu iha rai Judá kontenti.<verse eid="PSA 97:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9" />Tanba NAI, Ita Boot mak ukun mundu tomak;</para>
  <para style="q2" vid="PSA 97:9">Ita Boot aas liu dook maromak sel-seluk.<verse eid="PSA 97:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10" />Imi nebee hadomi NAI Maromak, hakribi buat aat ba,</para>
  <para style="q2" vid="PSA 97:10">tanba Nia tau matan ba ema nebee foo laran ba Nia;</para>
  <para style="q2" vid="PSA 97:10">Nia hasai sira husi ema aat nia liman laran.<verse eid="PSA 97:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11" />Naroman leno ema nebee moris loos;</para>
  <para style="q2" vid="PSA 97:11">ksolok leno ema nebee laran moos.<verse eid="PSA 97:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12" />Imi sira nebee moris loos, haksolok tanba NAI nia diak;</para>
  <para style="q2" vid="PSA 97:12">hahii Nia naran santu ba.<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="s">Nai Maromak mak ukun mundu</para>
  <para style="d">Salmu.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1" />Hananu kantiku foun ba NAI Maromak,</para>
  <para style="q2" vid="PSA 98:1">tanba Nia halo ona buat furak teb-tebes.</para>
  <para style="q1" vid="PSA 98:1">Hodi Nia liman loos;</para>
  <para style="q2" vid="PSA 98:1">hodi Nia liman santu,</para>
  <para style="q2" vid="PSA 98:1">Nia manaan tiha ona Nia inimigu.<verse eid="PSA 98:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2" />NAI deklara tiha ona Nia vitoria;</para>
  <para style="q2" vid="PSA 98:2">Nia hatudu sai Nia justisa ba nasaun hotu-hotu.<verse eid="PSA 98:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3" />Nia hatudu Nia domin rohan-laek ba Israel;</para>
  <para style="q2" vid="PSA 98:3">Nia kaer metin Nia promesa ba ita;</para>
  <para style="q1" vid="PSA 98:3">rai ulun too rai ikun iha mundu tomak haree tiha ona</para>
  <para style="q2" vid="PSA 98:3">salvasaun husi ita nia Maromak.<verse eid="PSA 98:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4" />Mundu tomak, haklalak haksolok ba NAI Maromak ba;</para>
  <para style="q2" vid="PSA 98:4">toka muzika hodi hananu ho haksolok.<verse eid="PSA 98:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5" />Toka viola halo muzika ba NAI;</para>
  <para style="q2" vid="PSA 98:5">toka viola ho knananuk murak.<verse eid="PSA 98:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6" />Huu korneta, huu karau dikur;</para>
  <para style="q2" vid="PSA 98:6">haklalak haksolok iha NAI nia oin; Nia mak Liurai.<verse eid="PSA 98:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7" />Tasi ho buat hotu iha laran, hasai lian ba;</para>
  <para style="q2" vid="PSA 98:7">mundu ho buat hotu nebee moris iha laran mos hasae lian ba.<verse eid="PSA 98:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8" />Mota sira, basa liman ba;</para>
  <para style="q2" vid="PSA 98:8">foho sira, hananu rame-rame hodi haksolok ba.<verse eid="PSA 98:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9" />Hananu iha NAI Maromak nia oin,</para>
  <para style="q2" vid="PSA 98:9">tanba Nia mai atu foo justisa ba mundu.</para>
  <para style="q1" vid="PSA 98:9">Nia sei foo justisa ba mundu ho lo-loos;</para>
  <para style="q2" vid="PSA 98:9">Nia foo justisa ba povu tuir lia loos.<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="s">Nai Maromak mak Liurai santu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">99:1 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 25:22">Ézodu 25:22</ref>
      </char>
    </note>NAI Maromak nee Liurai;</para>
  <para style="q2" vid="PSA 99:1">nasaun hotu-hotu tauk ho nakdedar.</para>
  <para style="q1" vid="PSA 99:1">Nia tuur iha anju kerubin nia leten hodi ukun;</para>
  <para style="q2" vid="PSA 99:1">rai nakdoko.<verse eid="PSA 99:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2" />NAI Maromak nee Ukun Nain boot iha Siaun;</para>
  <para style="q2" vid="PSA 99:2">Nia domina nasaun hotu-hotu.<verse eid="PSA 99:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3" />Sira sei hahii Nia</para>
  <para style="q2" vid="PSA 99:3">tanba Nia naran boot ho makaas;</para>
  <para style="q2" vid="PSA 99:3">Nia nee santu.<verse eid="PSA 99:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4" />Liurai Kbiit Nain, Ita Boot gosta justisa;</para>
  <para style="q2" vid="PSA 99:4">Ita Boot hatuur lia loos;</para>
  <para style="q2" vid="PSA 99:4">Ita Boot harii justisa ho lo-loos iha Israel<note caller="+" style="f"><char style="fr" closed="false">99:4 </char><char style="ft" closed="false">Lian Ebreu dehan “Jacó”. Iha nee hatudu ba povu Israel.</char></note>.<verse eid="PSA 99:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5" />Foti aas NAI ita nia Maromak;</para>
  <para style="q2" vid="PSA 99:5">hakruuk iha Nia ain hodi adora Nia;</para>
  <para style="q2" vid="PSA 99:5">Nia nee santu.<verse eid="PSA 99:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6" />Uluk Moisés ho Arão serbi Nia nudar nai lulik;</para>
  <para style="q2" vid="PSA 99:6">Samuel mos ema ida nebee bolu Maromak nia naran.</para>
  <para style="q1" vid="PSA 99:6">Sira harohan ba NAI Maromak</para>
  <para style="q2" vid="PSA 99:6">mak Nia hataan sira.<verse eid="PSA 99:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">99:7 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 33:9">Ézodu 33:9</ref>
      </char>
    </note>Husi kalohan riin laran, Nia koalia ba sira;</para>
  <para style="q2" vid="PSA 99:7">sira kaer metin lei no mandamentu nebee Nia foo ba sira.<verse eid="PSA 99:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8" />NAI ami nia Maromak, Ita Boot hataan sira;</para>
  <para style="q2" vid="PSA 99:8">Maromak, Ita Boot perdua sira nia sala,</para>
  <para style="q2" vid="PSA 99:8">maibee Ita Boot mos kastigu sira tanba sira nia sala.<verse eid="PSA 99:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9" />Foti aas NAI ita nia Maromak;</para>
  <para style="q2" vid="PSA 99:9">adora Nia iha Nia foho santu,</para>
  <para style="q2" vid="PSA 99:9">tanba NAI ita nia Maromak nee santu.<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s">Haklalak haksolok ba NAI Maromak</para>
  <para style="d">Salmu agradesimentu nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1" />Mundu tomak, haklalak haksolok ba NAI Maromak;<verse eid="PSA 100:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 100:2" />adora NAI Maromak ho kontenti;</para>
  <para style="q2" vid="PSA 100:2">mai iha Nia oin ho hananu haksolok.<verse eid="PSA 100:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3" />Rekonhese katak NAI mak Maromak;</para>
  <para style="q2" vid="PSA 100:3">Nia mak halo ita, ita nee Ninian.</para>
  <para style="q1" vid="PSA 100:3">Ita nee Nia povu;</para>
  <para style="q2" vid="PSA 100:3">ita hanesan bibi nebee iha Nia luhan laran.<verse eid="PSA 100:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4" />Hakat tama liu husi portaun boot ba iha Nia uma oin</para>
  <para style="q2" vid="PSA 100:4">hodi foo agradese ba Nia no foti aas Nia naran.<verse eid="PSA 100:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">100:5 </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:34">1 Krónikas 16:34</ref>; <ref loc="2CH 5:13">2 Krónikas 5:13</ref>, <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Esdras 3:11</ref>; <ref loc="PSA 106:1">Salmu 106:1</ref>, <ref loc="PSA 107:1">107:1</ref>, <ref loc="PSA 118:1">118:1</ref>, <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Jeremias 33:11</ref></char>
    </note>Tanba NAI Maromak nee diak;</para>
  <para style="q2" vid="PSA 100:5">Nia domin dura tinan ba tinan;</para>
  <para style="q2" vid="PSA 100:5">Nia foo laran ba ita husi jerasaun ba jerasaun.<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="s">Liurai nia promesa ba Nai Maromak</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1" />NAI Maromak, hau sei kanta kona ba domin ho justisa;</para>
  <para style="q2" vid="PSA 101:1">hau sei hananu hahii Ita Boot.<verse eid="PSA 101:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2" />Hau sei kuidadu hau nia aan hodi moris tuir dalan loos.</para>
  <para style="q2" vid="PSA 101:2">Bainhira mak Ita Boot atu mai?</para>
  <para style="q1" vid="PSA 101:2">Hau sei moris ho laran moos</para>
  <para style="q2" vid="PSA 101:2">iha hau nia uma laran.<verse eid="PSA 101:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3" />Hau sei la tau buat aat iha hau nia oin;</para>
  <para style="q2" vid="PSA 101:3">hau hakribi buat nebee ema fiar-laek sira halo;</para>
  <para style="q2" vid="PSA 101:3">hau sei la hola parte iha sira nia hahalok.<verse eid="PSA 101:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4" />Hau sei hadook aan husi ema nebee hanoin kleuk;</para>
  <para style="q2" vid="PSA 101:4">hau sei la partisipa iha buat aat saida deit.<verse eid="PSA 101:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5" />Ema nebee mak hatete aat nia maluk iha kotu-kotuk,</para>
  <para style="q2" vid="PSA 101:5">hau sei halo nia mohu;</para>
  <para style="q1" vid="PSA 101:5">see-see deit mak foti aan no gaba aan,</para>
  <para style="q2" vid="PSA 101:5">hau la tolera.<verse eid="PSA 101:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6" />Hau nia matan sei fihir ema nebee foo laran ba Maromak iha rai nee,</para>
  <para style="q2" vid="PSA 101:6">atu sira hela hamutuk ho hau;</para>
  <para style="q1" vid="PSA 101:6">ema nebee moris tuir dalan loos</para>
  <para style="q2" vid="PSA 101:6">sei serbi hau.<verse eid="PSA 101:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7" />Lohi door sira sei la hela iha hau nia uma;</para>
  <para style="q2" vid="PSA 101:7">bosok-teen sira sei la hamriik iha hau nia oin.<verse eid="PSA 101:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8" />Dadeer-dadeer hau sei halo mohu tiha</para>
  <para style="q2" vid="PSA 101:8">ema aat hotu-hotu iha rai nee;</para>
  <para style="q1" vid="PSA 101:8">ema nebee gosta halo buat aat,</para>
  <para style="q2" vid="PSA 101:8">hau sei halakon tiha husi NAI Maromak nia sidade.<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="s">Orasaun iha susar laran</para>
  <para style="d">Ema kbiit-laek ida nia orasaun, bainhira nia fraku, nunee nia fakar sai nia susar ba NAI Maromak.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1" />NAI Maromak, rona hau nia orasaun;</para>
  <para style="q2" vid="PSA 102:1">simu hau nia halerik ba.<verse eid="PSA 102:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2" />Keta subar Ita Boot nia oin mai hau</para>
  <para style="q2" vid="PSA 102:2">bainhira hau iha susar laran.</para>
  <para style="q1" vid="PSA 102:2">See Ita Boot nia tilun mai hau;</para>
  <para style="q2" vid="PSA 102:2">bainhira hau harohan, hataan hau ho lalais ba.<verse eid="PSA 102:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3" />Tanba hau nia moris liu lalais deit hanesan ahi suar;</para>
  <para style="q2" vid="PSA 102:3">hau nia isin tomak manas hanesan ahi klaak.<verse eid="PSA 102:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4" />Hau nia fuan namlaik tiha hanesan duut nebee ema baku ba rai;</para>
  <para style="q2" vid="PSA 102:4">hau la hanoin tan atu haan.<verse eid="PSA 102:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5" />Iha terus laran hau halerik makaas;</para>
  <para style="q2" vid="PSA 102:5">hau sai krekas, kulit taka ruin.<verse eid="PSA 102:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6" />Hau hanesan manu kakuuk iha rai fuik,</para>
  <para style="q2" vid="PSA 102:6">hanesan manu kakuuk iha uma dodok nia laran.<verse eid="PSA 102:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7" />Hau toba la dukur,</para>
  <para style="q2" vid="PSA 102:7">hau hanesan manu fuik nebee mes-mesak loos iha uma kakuluk leten.<verse eid="PSA 102:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8" />Loron tomak hau nia inimigu sira hatete aat hau;</para>
  <para style="q2" vid="PSA 102:8">sira nebee koalia hasoru hau temi hau nia naran hodi foo malisan mai hau.<verse eid="PSA 102:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9" />Hau nia hahaan mak ahu kdesan;</para>
  <para style="q2" vid="PSA 102:9">hau hemu fali hau nia matan been.<verse eid="PSA 102:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10" />Tanba Ita Boot hirus teb-tebes hau;</para>
  <para style="q2" vid="PSA 102:10">Ita Boot foti hau hodi soe tiha ona hau.<verse eid="PSA 102:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11" />Hau nia moris hanesan lalatak nebee mohu bainhira loro matan monu;</para>
  <para style="q2" vid="PSA 102:11">hau namlaik hanesan tiha duut.<verse eid="PSA 102:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12" />Maibee NAI Maromak, Ita Boot ukun tinan ba tinan;</para>
  <para style="q2" vid="PSA 102:12">Ita Boot nia naran dura husi jerasaun ba jerasaun.<verse eid="PSA 102:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13" />Ita Boot sei hamriik hodi hatudu Ita Boot nia domin ba sidade Siaun,</para>
  <para style="q2" vid="PSA 102:13">tanba tempu ona atu Ita Boot hatudu Ita Boot nia diak ba sidade nee;</para>
  <para style="q2" vid="PSA 102:13">tempu nebee Ita Boot marka nee too tiha ona.<verse eid="PSA 102:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14" />Tanba Ita Boot nia atan sira hadomi sidade nee nia fatuk;</para>
  <para style="q2" vid="PSA 102:14">too rai rahun nebee iha dalan mos, sira hanoin teb-tebes.<verse eid="PSA 102:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15" />Nasaun hotu-hotu sei hamtauk NAI nia naran;</para>
  <para style="q2" vid="PSA 102:15">liurai sira iha mundu sei tauk Ita Boot nia kbiit.<verse eid="PSA 102:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16" />Tanba NAI Maromak sei harii fila fali Siaun</para>
  <para style="q2" vid="PSA 102:16">hodi hatudu sai Nia kbiit boot.<verse eid="PSA 102:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17" />Nia sei hataan ema kiak rabat rai sira nia orasaun;</para>
  <para style="q2" vid="PSA 102:17">Nia sei la fila kotuk ba sira nia hamulak.<verse eid="PSA 102:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18" />Hakerek ida nee ba jerasaun tuir mai,</para>
  <para style="q2" vid="PSA 102:18">atu ema nebee seidauk moris bele hahii NAI Maromak.<verse eid="PSA 102:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19" />NAI iha Nia fatin santu iha leten aas ba hateke tuun;</para>
  <para style="q2" vid="PSA 102:19">husi lalehan Nia haree mai mundu<verse eid="PSA 102:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20" />hodi rona ema dadur sira nia halerik,</para>
  <para style="q2" vid="PSA 102:20">no hasai sira nebee hetan kastigu mate.<verse eid="PSA 102:20" /></para>
  <para style="q1">
    <verse number="21-22" style="v" sid="PSA 102:21-22" />Nunee liurai sira ho povu sira sei halibur hamutuk</para>
  <para style="q2" vid="PSA 102:21-22">hodi adora NAI Maromak.</para>
  <para style="q1" vid="PSA 102:21-22">Sira sei hahii NAI Maromak iha Jerusalém;</para>
  <para style="q2" vid="PSA 102:21-22">sira sei foo sai Nia naran iha Siaun.<verse eid="PSA 102:21-22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23" />Hau nia moris foin too iha klaran, Maromak halo hau nia isin nebee forti sai fraku tiha;</para>
  <para style="q2" vid="PSA 102:23">Nia habadak hau nia vida.<verse eid="PSA 102:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24" />Nunee hau dehan,</para>
  <para style="q1" vid="PSA 102:24">“Hau nia Maromak, Ita Boot moris tinan ba tinan;</para>
  <para style="q2" vid="PSA 102:24">hau foin too iha dalan klaran, keta hasai hau nia iis.”<verse eid="PSA 102:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25" />
    <note caller="+" style="x">
      <char style="xo" closed="false">102:25 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 1:10-12">Ebreu 1:10-12</ref>
      </char>
    </note>Hori uluk liu Ita Boot halo mundu nee;</para>
  <para style="q2" vid="PSA 102:25">lalehan nee Ita Boot nia liman fatin.<verse eid="PSA 102:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26" />Buat sira nee hotu aban-bainrua sei lakon, maibee Ita Boot iha nafatin;</para>
  <para style="q2" vid="PSA 102:26">buat sira nee sei sai bosan hanesan faru tuan.</para>
  <para style="q1" vid="PSA 102:26">Ita Boot sei troka buat sira nee hanesan troka hena,</para>
  <para style="q2" vid="PSA 102:26">no sei la iha tan.<verse eid="PSA 102:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27" />Maibee Ita Boot nunka muda;</para>
  <para style="q2" vid="PSA 102:27">Ita Boot nia moris sei la remata.<verse eid="PSA 102:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28" />Ita Boot nia atan sira nia oan sei moris ho hakmatek;</para>
  <para style="q2" vid="PSA 102:28">sira nia jerasaun sei dura iha Ita Boot nia oin.<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="s">Nai Maromak nia domin</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1" />Hau hatete ba hau nia aan, hahii NAI Maromak ba;</para>
  <para style="q2" vid="PSA 103:1">ho laran tomak, hahii Nia naran santu ba.<verse eid="PSA 103:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2" />Hau hatete ba hau nia aan, hahii NAI Maromak ba;</para>
  <para style="q2" vid="PSA 103:2">keta haluha Nia laran diak.<verse eid="PSA 103:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3" />Tanba Nia foo perdaun ba o nia sala hotu,</para>
  <para style="q2" vid="PSA 103:3">no kura o nia moras hotu-hotu.<verse eid="PSA 103:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4" />Nia hasai o husi rai kuak laran</para>
  <para style="q2" vid="PSA 103:4">hodi foo domin rohan-laek no laran luak ba o.<verse eid="PSA 103:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5" />Nia foo buat diak ba o tuir o nia hakarak,</para>
  <para style="q2" vid="PSA 103:5">atu nunee Nia halo o joven fila fali hanesan manu makikit.<verse eid="PSA 103:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6" />NAI Maromak sempre halo buat nebee loos</para>
  <para style="q2" vid="PSA 103:6">hodi foo justisa ba vitima sira nebee ema hanehan.<verse eid="PSA 103:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7" />Nia foo hatene Nia dalan ba Moisés;</para>
  <para style="q2" vid="PSA 103:7">Nia hatudu Nia hahalok ba ema Israel.<verse eid="PSA 103:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">103:8 </char>
      <char style="xt" closed="false">
        <ref loc="JAS 5:11">Tiago 5:11</ref>
      </char>
    </note>NAI Maromak nee laran diak no laran luak;</para>
  <para style="q2" vid="PSA 103:8">Nia Pasiensia Nain, no nakonu ho domin rohan-laek.<verse eid="PSA 103:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9" />Nia bele foo sala mai ita maibee laos beibeik;</para>
  <para style="q2" vid="PSA 103:9">Nia bele hirus ita maibee la rai hirus nafatin ba nafatin.<verse eid="PSA 103:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10" />Nia bele kastigu ita maibee kastigu nia todan la too buat nebee ita merese simu;</para>
  <para style="q2" vid="PSA 103:10">Nia foo kastigu ita laos tuir buat aat hotu nebee ita halo tiha ona.<verse eid="PSA 103:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11" />Tanba hanesan lalehan aas liu mundu,</para>
  <para style="q2" vid="PSA 103:11">nunee mos Maromak nia domin aas teb-tebes ba ema nebee mak hamtauk Nia.<verse eid="PSA 103:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12" />Hanesan lorosae dook husi loromonu,</para>
  <para style="q2" vid="PSA 103:12">nunee mos Nia hadook ita nia sala husi ita.<verse eid="PSA 103:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13" />Nudar aman hadomi nia oan sira,</para>
  <para style="q2" vid="PSA 103:13">nunee mos NAI Maromak hadomi ema nebee mak hamtauk Nia.<verse eid="PSA 103:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14" />Tanba Nia hatene ita nee halo husi saida;</para>
  <para style="q2" vid="PSA 103:14">Nia la haluha katak ita nee rai rahun.<verse eid="PSA 103:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15" />Ita ema nia moris hanesan duut;</para>
  <para style="q2" vid="PSA 103:15">ita buras hanesan ai funan iha rai fuik.<verse eid="PSA 103:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16" />Bainhira anin huu, semo lakon tiha;</para>
  <para style="q2" vid="PSA 103:16">ema atu buka tuir nia fatin, la hetan ona.<verse eid="PSA 103:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17" />Maibee husi huun too rohan</para>
  <para style="q2" vid="PSA 103:17">NAI Maromak hadomi ema nebee mak hamtauk Nia,</para>
  <para style="q2" vid="PSA 103:17">no Nia laran diak hamutuk ho sira nia oan bei-oan sira,<verse eid="PSA 103:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18" />ho ema nebee kaer metin Nia promesa,</para>
  <para style="q2" vid="PSA 103:18">no la haluha halo tuir Nia lei.<verse eid="PSA 103:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19" />NAI Maromak harii tiha ona Nia kadeira ukun iha lalehan;</para>
  <para style="q2" vid="PSA 103:19">Nia mak Liurai hodi ukun buat hotu-hotu.<verse eid="PSA 103:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20" />Imi anju sira, hahii NAI ba.</para>
  <para style="q2" vid="PSA 103:20">Imi nee iha forsa boot hodi halao Nia orden;</para>
  <para style="q2" vid="PSA 103:20">imi halo tuir Nia liafuan.<verse eid="PSA 103:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21" />Tropas lalehan nian, hahii NAI ba.</para>
  <para style="q2" vid="PSA 103:21">Imi nee Nia atan hodi halo tuir Nia hakarak.<verse eid="PSA 103:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22" />Buat hotu nebee Nia halo,</para>
  <para style="q2" vid="PSA 103:22">iha nebee-nebee deit mak Nia ukun, hahii NAI ba.</para>
  <para style="b" vid="PSA 103:22" />
  <para style="q1" vid="PSA 103:22">Hau hatete ba hau nia aan, hahii NAI Maromak ba.<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="s">Hahii ita nia Kriador</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1" />Hau hatete ba hau nia aan, hahii NAI Maromak ba.</para>
  <para style="b" vid="PSA 104:1" />
  <para style="q1" vid="PSA 104:1">NAI hau nia Maromak, Ita mak boot teb-tebes;</para>
  <para style="q2" vid="PSA 104:1">Ita Boot hatudu sai Ita nia naran boot ho naroman nabilan.<verse eid="PSA 104:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2" />Ita Boot falun Aan ho naroman hanesan fali hena naruk;</para>
  <para style="q2" vid="PSA 104:2">Ita Boot haluan lalehan hanesan ema dada tenda.<verse eid="PSA 104:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3" />Ita Boot harii Ita Boot nia hela fatin iha kalohan mahar nia leten;</para>
  <para style="q2" vid="PSA 104:3">Ita Boot halo kalohan sai Ita Boot nia kuda kareta;</para>
  <para style="q2" vid="PSA 104:3">Ita Boot sae anin nia liras hanesan ema sae kuda.<verse eid="PSA 104:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">104:4 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 1:7">Ebreu 1:7</ref>
      </char>
    </note>Ita Boot haruka anin lori Ita Boot nia lia menon,</para>
  <para style="q2" vid="PSA 104:4">no halo ahi lakan sai Ita Boot nia atan.<verse eid="PSA 104:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5" />Ita Boot hatuur mundu ba iha nia fatin;</para>
  <para style="q2" vid="PSA 104:5">mundu nunka atu sees husi nia fatin nee.<verse eid="PSA 104:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6" />Ita Boot falun mundu ho bee naruk hanesan hena naruk;</para>
  <para style="q2" vid="PSA 104:6">bee nee taka tomak foho aas sira.<verse eid="PSA 104:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7" />Depois Ita Boot siak halo bee halai tiha;</para>
  <para style="q2" vid="PSA 104:7">Ita Boot nia lian tarutu halo bee suli sees tiha.<verse eid="PSA 104:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8" />Bee suli liu husi foho tuun ba iha rai klean,</para>
  <para style="q2" vid="PSA 104:8">too iha fatin nebee Ita Boot hatudu ona.<verse eid="PSA 104:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9" />Ita Boot tau baliza atu bee la bele suli liu;</para>
  <para style="q2" vid="PSA 104:9">bee sei la taka mundu tan.<verse eid="PSA 104:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10" />Ita Boot halo bee matan suli ba mota kiik;</para>
  <para style="q2" vid="PSA 104:10">bee nee suli tuun liu husi foho nia leet.<verse eid="PSA 104:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11" />Nunee animal fuik bo-boot sira bele hemu;</para>
  <para style="q2" vid="PSA 104:11">kuda buru fuik hemu too hamrook lakon.<verse eid="PSA 104:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12" />Manu fuik halo nia knuuk besik bee nee;</para>
  <para style="q2" vid="PSA 104:12">manu sira nee hananu iha ai sanak leten.<verse eid="PSA 104:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13" />Husi Ita Boot nia uma iha leten, Ita Boot hatuun udan been ba foho;</para>
  <para style="q2" vid="PSA 104:13">Ita Boot nia liman fatin halo rai nee bosu.<verse eid="PSA 104:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14" />Ita Boot halo duut buras ba animal,</para>
  <para style="q2" vid="PSA 104:14">no halo ai horis atu ema bele uza.</para>
  <para style="q1" vid="PSA 104:14">Nunee rai bele produs ai haan,<verse eid="PSA 104:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 104:15" />tua hodi halo ema nia laran kontenti,</para>
  <para style="q1" vid="PSA 104:15">mina hodi halo ema nia oin nabilan,</para>
  <para style="q2" vid="PSA 104:15">no hahaan hodi halo sira forti.<verse eid="PSA 104:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16" />Ai huun sedru rai Líbanu nian hetan bee diak;</para>
  <para style="q2" vid="PSA 104:16">ai huun nee NAI Maromak nian, Nia mak kuda.<verse eid="PSA 104:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17" />Iha nebaa manu fuik halo sira nia knuuk;</para>
  <para style="q2" vid="PSA 104:17">manu fuik boot halo nia uma iha ai sentru nia sanak.<verse eid="PSA 104:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18" />Foho aas sai bibi fuik sira nia hela fatin;</para>
  <para style="q2" vid="PSA 104:18">fatuk kuak sai laku nia subar fatin.<verse eid="PSA 104:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19" />Ita Boot halo fulan hodi marka tempu;</para>
  <para style="q2" vid="PSA 104:19">loro matan hatene bainhira mak atu tuun.<verse eid="PSA 104:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20" />Ita Boot foo nakukun, halo rai kalan tiha,</para>
  <para style="q2" vid="PSA 104:20">nunee animal ai laran nian sai mai.<verse eid="PSA 104:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21" />Liaun forti lian boot hodi kasa animal,</para>
  <para style="q2" vid="PSA 104:21">atu buka ai haan nebee Maromak prepara.<verse eid="PSA 104:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22" />Bainhira loro matan sae, liaun sira nee fila fali</para>
  <para style="q2" vid="PSA 104:22">hodi latan aan iha sira nia hela fatin.<verse eid="PSA 104:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23" />Depois ema lao sai baa halao sira nia servisu;</para>
  <para style="q2" vid="PSA 104:23">sira halo sira nia knaar too kalan.<verse eid="PSA 104:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24" />NAI Maromak, Ita Boot nia liman fatin barak teb-tebes!</para>
  <para style="q2" vid="PSA 104:24">Ita Boot halo buat sira nee hotu ho matenek;</para>
  <para style="q2" vid="PSA 104:24">mundu nee nakonu ho buat nebee Ita Boot halo.<verse eid="PSA 104:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25" />Haree ba, iha tasi boot teb-tebes, luan teb-tebes;</para>
  <para style="q2" vid="PSA 104:25">iha tasi laran iha buat moris kiik no boot,</para>
  <para style="q2" vid="PSA 104:25">barak loos, sura la bele.<verse eid="PSA 104:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26" />
    <note caller="+" style="x">
      <char style="xo" closed="false">104:26 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 41:1">Job 41:1</ref>; <ref loc="PSA 74:14">Salmu 74:14</ref>; <ref loc="ISA 27:1">Isaias 27:1</ref></char>
    </note>Iha nebaa roo lao baa lao mai;</para>
  <para style="q2" vid="PSA 104:26">iha mos samea boot Leviatán, Ita Boot forma nia atu halimar iha tasi laran.<verse eid="PSA 104:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27" />Kriatura hotu-hotu laran metin ba Ita Boot</para>
  <para style="q2" vid="PSA 104:27">atu foo ai haan ba sira tuir nia tempu.<verse eid="PSA 104:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28" />Bainhira Ita Boot foo ba sira,</para>
  <para style="q2" vid="PSA 104:28">sira foti tiha;</para>
  <para style="q1" vid="PSA 104:28">bainhira Ita Boot loke liman,</para>
  <para style="q2" vid="PSA 104:28">sira bosu ho hahaan mesak diak nian.<verse eid="PSA 104:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29" />Bainhira Ita Boot subar Ita Boot nia oin,</para>
  <para style="q2" vid="PSA 104:29">sira fuan lakon tiha;</para>
  <para style="q1" vid="PSA 104:29">bainhira Ita Boot hasai tiha sira nia iis,</para>
  <para style="q2" vid="PSA 104:29">sira mate hodi fila fali ba rai rahun.<verse eid="PSA 104:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30" />Bainhira Ita Boot foo Ita Boot nia iis</para>
  <para style="q2" vid="PSA 104:30">mak kriatura sira hetan moris;</para>
  <para style="q2" vid="PSA 104:30">Ita Boot hafoun mundu rai klaran.<verse eid="PSA 104:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31" />Maromak nia naroman nabilan sei dura nafatin ba nafatin;</para>
  <para style="q2" vid="PSA 104:31">hau hein atu NAI haksolok ho buat nebee Nia kria tiha ona.<verse eid="PSA 104:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32" />Bainhira Nia hateke ba mundu, rai nakdedar;</para>
  <para style="q2" vid="PSA 104:32">Nia liman kaer kona foho, foho suar sae.<verse eid="PSA 104:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33" />Iha hau nia moris tomak hau sei hananu ba NAI;</para>
  <para style="q2" vid="PSA 104:33">durante hau sei iha iis, hau sei hananu hahii hau nia Maromak.<verse eid="PSA 104:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34" />Hau hein katak hau nia liafuan hirak nee bele halo kontenti Nia laran;</para>
  <para style="q2" vid="PSA 104:34">hau haksolok tanba NAI Maromak.<verse eid="PSA 104:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35" />Hau harohan atu sala nain sira bele lakon husi mundu,</para>
  <para style="q2" vid="PSA 104:35">no ema aat la iha tan.</para>
  <para style="q1" vid="PSA 104:35">Hau hatete ba hau nia aan, hahii NAI Maromak ba.</para>
  <para style="b" vid="PSA 104:35" />
  <para style="q1" vid="PSA 104:35">Hahii NAI Maromak!<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="s">Nai Maromak kaer metin Nia promesa ba Nia povu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1" />Foo agradese ba NAI Maromak, haboot Nia naran ba;</para>
  <para style="q2" vid="PSA 105:1">foo konhese ba nasaun jentiu sira kona ba saida mak Nia halo tiha ona.<verse eid="PSA 105:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2" />Hananu ba Nia, kanta hahii ba Nia;</para>
  <para style="q2" vid="PSA 105:2">foo sai buat furak hotu nebee Nia halo.<verse eid="PSA 105:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3" />Tane aas Nia naran santu;</para>
  <para style="q2" vid="PSA 105:3">imi sira nebee mak buka NAI, haksolok ba.<verse eid="PSA 105:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4" />Foti matan ba NAI Maromak, hateke ba Nia kbiit;</para>
  <para style="q2" vid="PSA 105:4">buka beibeik Nia oin.<verse eid="PSA 105:4" /></para>
  <para style="q1">
    <verse number="5-6" style="v" sid="PSA 105:5-6" />Imi Maromak nia atan Abraão nia jerasaun sira,</para>
  <para style="q2" vid="PSA 105:5-6">Jacó nia oan sira, Maromak hili ona imi,</para>
  <para style="q1" vid="PSA 105:5-6">keta haluha buat furak nebee Nia halo tiha ona,</para>
  <para style="q2" vid="PSA 105:5-6">Nia milagre ho Nia desizaun nebee Nia hatuun nudar Juis.<verse eid="PSA 105:5-6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7" />Nia mak NAI ita nia Maromak;</para>
  <para style="q2" vid="PSA 105:7">Nia foo justisa ba iha mundu tomak.<verse eid="PSA 105:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8" />Nia hanoin nafatin Nia promesa too tinan ba tinan;</para>
  <para style="q2" vid="PSA 105:8">buat nebee Nia promete ona, Nia kaer metin nafatin too jerasaun rihun ba rihun.<verse eid="PSA 105:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:9 a </char>
      <char style="xt" closed="false">
        <ref loc="GEN 12:7">Jénesis 12:7</ref>, <ref loc="GEN 17:8">17:8</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="GEN 26:3">Jénesis 26:3</ref>
      </char>
    </note>Nee mak promesa nebee Nia halo ho Abraão,</para>
  <para style="q2" vid="PSA 105:9">juramentu nebee Nia halo ho Isac.<verse eid="PSA 105:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:10 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 28:13">Jénesis 28:13</ref>
      </char>
    </note>Nia hametin juramentu nee ba Jacó nudar lei ida;</para>
  <para style="q2" vid="PSA 105:10">Nia promesa ba Israel nee vale tinan ba tinan.<verse eid="PSA 105:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11" />Nia promete dehan, “Hau sei foo rai Kanaán ba o</para>
  <para style="q2" vid="PSA 105:11">hodi sai o nia riku-soin.”<verse eid="PSA 105:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12" />Fo-foun bei-ala sira nee ema uitoan deit, uitoan teb-tebes;</para>
  <para style="q2" vid="PSA 105:12">sira sei oin foun hela iha rai Kanaán nee.<verse eid="PSA 105:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13" />Iha tempu nebaa sira lao rai husi nasaun ba nasaun,</para>
  <para style="q2" vid="PSA 105:13">husi liurai ida nia reinu ba liurai seluk nia rain.<verse eid="PSA 105:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:14 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 20:3-7">Jénesis 20:3-7</ref>
      </char>
    </note>Bele nunee mos Maromak la husik atu ema hanehan sira;</para>
  <para style="q2" vid="PSA 105:14">Nia defende sira hodi siak liurai sira dehan,<verse eid="PSA 105:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15" />“Keta book ema nebee Hau hili;</para>
  <para style="q2" vid="PSA 105:15">keta halo aat Hau nia profeta sira.”<verse eid="PSA 105:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:16 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:53-57">Jénesis 41:53-57</ref>
      </char>
    </note>Depois Maromak hamosu rai hamlaha</para>
  <para style="q2" vid="PSA 105:16">hodi halo aat tiha ai haan hotu-hotu iha rai Kanaán.<verse eid="PSA 105:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:17 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 37:28">Jénesis 37:28</ref>, <ref loc="GEN 45:5">45:5</ref></char>
    </note>Nia haruka ema ida baa uluk iha rai Ejitu;</para>
  <para style="q2" vid="PSA 105:17">nee mak José, ninia maun sira faan tiha nia nudar atan.<verse eid="PSA 105:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:18 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 39:20-40:23">Jénesis 39:20—40:23</ref>
      </char>
    </note>Ema hakanek nia ain ho korenti besi;</para>
  <para style="q2" vid="PSA 105:18">sira tau besi kabuar ba iha nia kakorok,<verse eid="PSA 105:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19" />too buat nebee nia foo sai akontese duni,</para>
  <para style="q2" vid="PSA 105:19">no NAI Maromak nia liafuan hatudu katak nia nee loos.<verse eid="PSA 105:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:20 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:14">Jénesis 41:14</ref>
      </char>
    </note>Too ikus liurai haruka ema hasai José husi dadur laran;</para>
  <para style="q2" vid="PSA 105:20">ukun nain nasaun halo nia livre.<verse eid="PSA 105:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:21 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:39-41">Jénesis 41:39-41</ref>
      </char>
    </note>Liurai foti nia sai nai ulun iha palasiu,</para>
  <para style="q2" vid="PSA 105:21">atu tau matan ba liurai nia riku-soin hotu,<verse eid="PSA 105:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22" />atu manda liurai nia liman-ain sira tuir nia hakarak,</para>
  <para style="q2" vid="PSA 105:22">no hanorin matenek ba katuas lia nain sira.<verse eid="PSA 105:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:23 a </char>
      <char style="xt" closed="false">
        <ref loc="GEN 46:6">Jénesis 46:6</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="GEN 47:11">Jénesis 47:11</ref>
      </char>
    </note>Hotu tiha Jacó tama ba iha rai Ejitu;</para>
  <para style="q2" vid="PSA 105:23">Israel hela iha ema Ham nia rain nudar estranjeiru.<verse eid="PSA 105:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:24 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 1:7-14">Ézodu 1:7-14</ref>
      </char>
    </note>NAI Maromak halo Nia povu sai buras teb-tebes;</para>
  <para style="q2" vid="PSA 105:24">Nia halo sira forsa liu fali sira nia funu baluk sira.<verse eid="PSA 105:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25" />Nia halo funu baluk sira nia laran fila atu odi Nia povu,</para>
  <para style="q2" vid="PSA 105:25">atu kombina malu hodi kontra Nia atan sira.<verse eid="PSA 105:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:26 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 3:1-4:17">Ézodu 3:1—4:17</ref>
      </char>
    </note>Maromak haruka Nia atan Moisés</para>
  <para style="q2" vid="PSA 105:26">hamutuk ho ema ida nebee Nia hili, nee mak Arão.<verse eid="PSA 105:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27" />Sira nain rua hatudu Maromak nia milagre iha Ham nia rain;</para>
  <para style="q2" vid="PSA 105:27">sira hatudu sai Nia sinal iha povu nia klaran.<verse eid="PSA 105:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:28 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 10:21-23">Ézodu 10:21-23</ref>
      </char>
    </note>Maromak haruka nakukun taka metin rai</para>
  <para style="q2" vid="PSA 105:28">tanba Ejitu oan sira kontra tiha ona Nia liafuan.<verse eid="PSA 105:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:29 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 7:17-21">Ézodu 7:17-21</ref>
      </char>
    </note>Nia halo sira nia bee nakfilak ba raan</para>
  <para style="q2" vid="PSA 105:29">hodi hamate tiha ikan hotu-hotu.<verse eid="PSA 105:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:30 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:1-6">Ézodu 8:1-6</ref>
      </char>
    </note>Sira nia rai nakonu tiha ho manduku,</para>
  <para style="q2" vid="PSA 105:30">too tama iha ukun nain sira nia kuartu laran.<verse eid="PSA 105:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:31 a </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:20-24">Ézodu 8:20-24</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:16">Ézodu 8:16</ref>,<ref loc="EXO 8:17">17</ref></char>
    </note>Nia foo orden mak lalar barak mosu mai,</para>
  <para style="q2" vid="PSA 105:31">susuk nakonu tiha sira nia nasaun.<verse eid="PSA 105:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:32 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 9:22-25">Ézodu 9:22-25</ref>
      </char>
    </note>Nia la hatuun udan ba sira nia rain, maibee hatuun fali udan jelu fatuk;</para>
  <para style="q2" vid="PSA 105:32">rai lakan taa ba-mai iha sira nia rain.<verse eid="PSA 105:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33" />Nia baku tuun tiha sira nia ai uvas ho ai figeira;</para>
  <para style="q2" vid="PSA 105:33">ai huun iha sira nia rain tomak, Nia silu tohar tiha.<verse eid="PSA 105:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:34 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 10:12-15">Ézodu 10:12-15</ref>
      </char>
    </note>Nia foo orden mak gafanhotu mosu mai,</para>
  <para style="q2" vid="PSA 105:34">barak teb-tebes, sura la bele.<verse eid="PSA 105:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35" />Gafanhotu hirak nee haan ai horis hotu-hotu iha sira nia rain;</para>
  <para style="q2" vid="PSA 105:35">buat nebee moris iha rai leten, gafanhotu haan hotu kedas.<verse eid="PSA 105:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:36 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:29">Ézodu 12:29</ref>
      </char>
    </note>Nia oho dasa tiha sira nia oan mane boot hotu iha rai nee;</para>
  <para style="q2" vid="PSA 105:36">sira nia oan mane primeiru mate mohu.<verse eid="PSA 105:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:37 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:33-36">Ézodu 12:33-36</ref>
      </char>
    </note>Depois Maromak lori Israel oan sira sai husi rai Ejitu;</para>
  <para style="q2" vid="PSA 105:37">sira sai lori ho osan mutin ho osan mean;</para>
  <para style="q2" vid="PSA 105:37">husi Israel nia suku hotu, la iha ema ida mak lao sidi.<verse eid="PSA 105:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38" />Bainhira sira hakat sai, ema Ejitu sira laran kamaan,</para>
  <para style="q2" vid="PSA 105:38">tanba sira tauk ona ema Israel.<verse eid="PSA 105:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:39 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:21">Ézodu 13:21</ref>,<ref loc="EXO 13:22">22</ref></char>
    </note>Maromak habelar kalohan hodi taka Nia povu,</para>
  <para style="q2" vid="PSA 105:39">no prepara ahi lakan atu foo naroman iha kalan.<verse eid="PSA 105:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:40 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 16:2-15">Ézodu 16:2-15</ref>
      </char>
    </note>Sira husu naan, Nia haruka manu kiukae barak ba sira;</para>
  <para style="q2" vid="PSA 105:40">Nia hatuun paun husi lalehan, sira haan too bosu.<verse eid="PSA 105:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:41 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:1-7">Ézodu 17:1-7</ref>; <ref loc="NUM 20:2-13">Númerus 20:2-13</ref></char>
    </note>Nia loke fatuk boot, bee haksoit sai,</para>
  <para style="q2" vid="PSA 105:41">suli iha rai fuik maran hanesan mota.<verse eid="PSA 105:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42" />Tanba Nia hanoin nafatin Nia promesa santu</para>
  <para style="q2" vid="PSA 105:42">nebee uluk Nia foo ba Nia atan Abraão.<verse eid="PSA 105:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43" />Nunee Maromak lori sai Nia povu ho haksolok;</para>
  <para style="q2" vid="PSA 105:43">povu nebee Nia hili, Nia halo sira livre ho haklalak ho kontenti.<verse eid="PSA 105:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44" />
    <note caller="+" style="x">
      <char style="xo" closed="false">105:44 </char>
      <char style="xt" closed="false">
        <ref loc="JOS 11:16-23">Josué 11:16-23</ref>
      </char>
    </note>Nia foo tiha nasaun sira seluk nia rain ba sira;</para>
  <para style="q2" vid="PSA 105:44">buat nebee ema seluk halo too kosar metan suli, sira mak sai nain fali,<verse eid="PSA 105:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45" />atu nunee sira kaer metin Nia ukun fuan,</para>
  <para style="q2" vid="PSA 105:45">no halo tuir Nia lei.</para>
  <para style="b" vid="PSA 105:45" />
  <para style="q1" vid="PSA 105:45">Hahii NAI Maromak!<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="s">Nai Maromak nia diak ba Nia povu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">106:1 </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:34">1 Krónikas 16:34</ref>; <ref loc="2CH 5:13">2 Krónikas 5:13</ref>, <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Esdras 3:11</ref>; <ref loc="PSA 100:5">Salmu 100:5</ref>, <ref loc="PSA 107:1">107:1</ref>, <ref loc="PSA 118:1">118:1</ref>, <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Jeremias 33:11</ref></char>
    </note>Hahii NAI Maromak!</para>
  <para style="b" vid="PSA 106:1" />
  <para style="q1" vid="PSA 106:1">Foo agradese ba NAI Maromak, tanba Nia nee diak;</para>
  <para style="q2" vid="PSA 106:1">Nia domin dura tinan ba tinan.<verse eid="PSA 106:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2" />See mak bele foo sai buat boot nebee NAI halo?</para>
  <para style="q2" vid="PSA 106:2">See mak bele hahii lo-loos Nia?<verse eid="PSA 106:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3" />Ema nebee mak kaer metin justisa,</para>
  <para style="q2" vid="PSA 106:3">ema nebee sempre halo buat nebee loos,</para>
  <para style="q2" vid="PSA 106:3">sira nee hetan ksolok.<verse eid="PSA 106:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4" />NAI Maromak, bainhira Ita Boot hatudu laran luak ba Ita Boot nia povu, keta haluha hau;</para>
  <para style="q2" vid="PSA 106:4">bainhira Ita Boot salva povu nee, tulun hotu hau ba,<verse eid="PSA 106:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5" />atu hau bele moris diak hamutuk ho ema sira nebee Ita Boot hili tiha ona,</para>
  <para style="q2" vid="PSA 106:5">atu hau bele haksolok ho Ita Boot nia povu,</para>
  <para style="q2" vid="PSA 106:5">atu hau bele tane aas Ita Boot hamutuk ho Ita Boot nia ema rasik.<verse eid="PSA 106:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6" />Ami halo tiha ona sala, hanesan mos ami nia bei-ala sira;</para>
  <para style="q2" vid="PSA 106:6">ami halo tiha ona pekadu, ami nia hahalok aat.<verse eid="PSA 106:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">106:7 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:10-12">Ézodu 14:10-12</ref>
      </char>
    </note>Uluk bainhira ami nia bei-ala sira iha rai Ejitu,</para>
  <para style="q2" vid="PSA 106:7">sira la foo folin ba milagre nebee Ita Boot halo;</para>
  <para style="q1" vid="PSA 106:7">sira la hanoin tan domin rohan-laek nebee Ita Boot hatudu fila-fila ba sira;</para>
  <para style="q2" vid="PSA 106:7">sira kontra Maromak Aas Liu iha Tasi Mean.<verse eid="PSA 106:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8" />Maski nunee Maromak salva sira,</para>
  <para style="q2" vid="PSA 106:8">atu ema bele foti aas Nia naran,</para>
  <para style="q2" vid="PSA 106:8">atu Nia bele hatudu sai Nia kbiit boot.<verse eid="PSA 106:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">106:9 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21-31">Ézodu 14:21-31</ref>
      </char>
    </note>Nia siak Tasi Mean, tasi maran kedas;</para>
  <para style="q2" vid="PSA 106:9">Nia lori sira liu husi tasi klaran hanesan fali liu iha rai fuik maran.<verse eid="PSA 106:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10" />Nia salva sira husi funu baluk sira nia liman;</para>
  <para style="q2" vid="PSA 106:10">Nia liberta sira husi inimigu sira nia liman laran.<verse eid="PSA 106:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11" />Bee halo mout tiha ema nebee kontra sira;</para>
  <para style="q2" vid="PSA 106:11">ema sira nee la iha ida mak moris.<verse eid="PSA 106:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">106:12 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:1-21">Ézodu 15:1-21</ref>
      </char>
    </note>Depois bei-ala sira fiar ba Nia promesa,</para>
  <para style="q2" vid="PSA 106:12">no hananu hahii Nia.<verse eid="PSA 106:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13" />Maibee lalais deit sira haluha fali buat nebee Maromak halo tiha ona;</para>
  <para style="q2" vid="PSA 106:13">sira lakohi hein tan Nia lia menon.<verse eid="PSA 106:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">106:14 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 11:4-34">Númerus 11:4-34</ref>
      </char>
    </note>Iha rai fuik, sira kaan teb-tebes atu haan hahaan diak nian;</para>
  <para style="q2" vid="PSA 106:14">iha rai fuik maran sira koko Maromak.<verse eid="PSA 106:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15" />Nunee Nia foo ba sira buat nebee sira husu,</para>
  <para style="q2" vid="PSA 106:15">maibee Nia mos haruka moras aat ba iha sira nia leet.<verse eid="PSA 106:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">106:16 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 16:1-35">Númerus 16:1-35</ref>
      </char>
    </note>Iha sira nia akampamentu, sira laran moras ba Moisés ho Arão,</para>
  <para style="q2" vid="PSA 106:16">Arão nee NAI Maromak mak hili sai nai lulik.<verse eid="PSA 106:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17" />Nunee rai nakloke aan hodi tolan tiha Datan;</para>
  <para style="q2" vid="PSA 106:17">rai taka hakoi tiha Abiram ho nia grupu.<verse eid="PSA 106:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18" />Ahi lakan sae iha sira nia klaran</para>
  <para style="q2" vid="PSA 106:18">hodi haan mutuk tiha ema aat sira nee.<verse eid="PSA 106:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">106:19 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 32:1-14">Ézodu 32:1-14</ref>
      </char>
    </note>Iha foho Horeb ami nia bei-ala sira halo estatua karau oan;</para>
  <para style="q2" vid="PSA 106:19">sira adora fali estatua nebee fui husi osan mean.<verse eid="PSA 106:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20" />Maromak ida nebee kbiit boot sira husik tiha;</para>
  <para style="q2" vid="PSA 106:20">sira troka fali ho estatua karau aman, animal nebee haan duut deit.<verse eid="PSA 106:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21" />Sira haluha tiha Maromak, sira nia Salvador;</para>
  <para style="q2" vid="PSA 106:21">Maromak nee mak halo buat boot iha rai Ejitu,<verse eid="PSA 106:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22" />Nia halo milagre iha ema Ham nia rain,</para>
  <para style="q2" vid="PSA 106:22">no halo buat nebee makaas iha Tasi Mean.<verse eid="PSA 106:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23" />Nee mak Nia dehan, Nia hakarak halo mohu tiha sira.</para>
  <para style="q2" vid="PSA 106:23">Maibee Moisés, ema ida nebee Nia hili tiha ona hamriik iha klaran</para>
  <para style="q1" vid="PSA 106:23">hodi tahan netik Nia hirus ba sira.</para>
  <para style="q2" vid="PSA 106:23">Nunee Maromak la konsege halo mohu sira.<verse eid="PSA 106:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">106:24 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 14:1-35">Númerus 14:1-35</ref>
      </char>
    </note>Depois bei-ala sira nee lakohi simu rai nebee furak nee;</para>
  <para style="q2" vid="PSA 106:24">sira la fiar ba Nia promesa.<verse eid="PSA 106:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25" />Sira murmura iha sira nia tenda laran,</para>
  <para style="q2" vid="PSA 106:25">no lakohi rona NAI Maromak.<verse eid="PSA 106:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26" />Nunee Nia foti Nia liman hodi jura katak,</para>
  <para style="q2" vid="PSA 106:26">Nia sei hamate tiha sira iha rai fuik maran.<verse eid="PSA 106:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27" />
    <note caller="+" style="x">
      <char style="xo" closed="false">106:27 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 26:33">Levítiku 26:33</ref>
      </char>
    </note>Nia sei halo sira nia jerasaun namkari iha nasaun sel-seluk;</para>
  <para style="q2" vid="PSA 106:27">sira sei lao lemo rai iha rai sel-seluk.<verse eid="PSA 106:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">106:28 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 25:1-13">Númerus 25:1-13</ref>
      </char>
    </note>Sira entrega aan ba estatua Baal iha foho Peor</para>
  <para style="q2" vid="PSA 106:28">hodi haan fali naan sakrifisiu nebee ema foo ba matebian sira.<verse eid="PSA 106:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29" />Sira nia hahalok nee halo Maromak hirus,</para>
  <para style="q2" vid="PSA 106:29">nunee moras aat mosu iha sira nia klaran.<verse eid="PSA 106:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30" />Maibee Fineias hamriik hodi tahan netik,</para>
  <para style="q2" vid="PSA 106:30">nee mak moras aat nee para tiha.<verse eid="PSA 106:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31" />Buat nebee Fineias halo nee, buat diak ida,</para>
  <para style="q2" vid="PSA 106:31">no ema sei la haluha husi jerasaun ba jerasaun.<verse eid="PSA 106:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32" />
    <note caller="+" style="x">
      <char style="xo" closed="false">106:32 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 20:2-13">Númerus 20:2-13</ref>
      </char>
    </note>Iha bee Meriba nian, bei-ala sira halo NAI Maromak hirus;</para>
  <para style="q2" vid="PSA 106:32">Moisés hetan terus tanba sira nia hahalok aat nee,<verse eid="PSA 106:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33" />tanba sira kontra Maromak nia Espiritu,</para>
  <para style="q2" vid="PSA 106:33">nunee Moisés la hatene tuir liafuan nebee sai husi nia ibun laran.<verse eid="PSA 106:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34" />
    <note caller="+" style="x">
      <char style="xo" closed="false">106:34 </char>
      <char style="xt" closed="false">
        <ref loc="JDG 2:1-3">Juis sira 2:1-3</ref>, <ref loc="JDG 3:5">3:5</ref>,<ref loc="JDG 3:6">6</ref></char>
    </note>Sira lakohi halo mohu nasaun jentiu sira</para>
  <para style="q2" vid="PSA 106:34">nebee NAI Maromak haruka sira halo mohu,<verse eid="PSA 106:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35" />maibee sira ba ranxu fali nasaun sira nee</para>
  <para style="q2" vid="PSA 106:35">hodi halo tuir fali sira nia lisan.<verse eid="PSA 106:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36" />Sira adora fali ema jentiu sira nia estatua;</para>
  <para style="q2" vid="PSA 106:36">ida nee lori sira ba rai kuak.<verse eid="PSA 106:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37" />
    <note caller="+" style="x">
      <char style="xo" closed="false">106:37 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 17:17">2 Liurai 17:17</ref>
      </char>
    </note>Sira oho sira nia oan mane ho oan feto</para>
  <para style="q2" vid="PSA 106:37">nudar sakrifisiu ba maromak falsu.<verse eid="PSA 106:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38" />
    <note caller="+" style="x">
      <char style="xo" closed="false">106:38 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 35:33">Númerus 35:33</ref>
      </char>
    </note>Sira oho ema nebee la sala;</para>
  <para style="q2" vid="PSA 106:38">sira fakar sira nia oan feto ho oan mane nia raan</para>
  <para style="q1" vid="PSA 106:38">hodi foo ba ema Kanaán nia maromak falsu nudar sakrifisiu.</para>
  <para style="q2" vid="PSA 106:38">Nunee raan nebee fakar nee halo rai nee sai foer tiha.<verse eid="PSA 106:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39" />Sira hafoer sira nia aan ho buat nebee sira halo;</para>
  <para style="q2" vid="PSA 106:39">sira nia hahalok nee hanesan feto kaben nain nebee halai tuir fali mane seluk.<verse eid="PSA 106:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40" />
    <note caller="+" style="x">
      <char style="xo" closed="false">106:40 </char>
      <char style="xt" closed="false">
        <ref loc="JDG 2:14-18">Juis sira 2:14-18</ref>
      </char>
    </note>Tanba nee NAI Maromak nia laran nakali ba Nia povu;</para>
  <para style="q2" vid="PSA 106:40">Nia hakribi fali povu nebee Nia hili nudar Nia riku-soin.<verse eid="PSA 106:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41" />Nia entrega sira ba iha nasaun jentiu sira nia liman laran,</para>
  <para style="q2" vid="PSA 106:41">atu sira nia funu baluk mak ukun fali sira.<verse eid="PSA 106:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42" />Sira nia inimigu hanehan sira</para>
  <para style="q2" vid="PSA 106:42">hodi ukun sira ho kroat.<verse eid="PSA 106:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43" />Dala barak Maromak salva sira,</para>
  <para style="q2" vid="PSA 106:43">maibee sira fila kontra fali Nia,</para>
  <para style="q2" vid="PSA 106:43">nunee sira mout dadauk ba iha sira nia sala.<verse eid="PSA 106:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44" />Maski nunee Nia rona sira nia halerik;</para>
  <para style="q2" vid="PSA 106:44">Nia foo atensaun ba sira iha susar laran.<verse eid="PSA 106:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45" />Nia hanoin nafatin Nia promesa ba sira;</para>
  <para style="q2" vid="PSA 106:45">Nia la kastigu sira, tanba Nia domin boot teb-tebes.<verse eid="PSA 106:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46" />Inimigu sira hotu nebee dadur tiha Nia povu,</para>
  <para style="q2" vid="PSA 106:46">Nia halo sira nia laran hanoin fali dadur sira nee.<verse eid="PSA 106:46" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47" />
    <note caller="+" style="x">
      <char style="xo" closed="false">106:47 </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:35">1 Krónikas 16:35</ref>,<ref loc="1CH 16:36">36</ref></char>
    </note>NAI ami nia Maromak, salva ami ba;</para>
  <para style="q2" vid="PSA 106:47">halibur fali ami husi nasaun sel-seluk,</para>
  <para style="q1" vid="PSA 106:47">atu ami bele foo agradese ba Ita Boot nia naran santu,</para>
  <para style="q2" vid="PSA 106:47">no haksolok hahii Ita Boot.<verse eid="PSA 106:47" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48" />Hahii NAI, Israel nia Maromak,</para>
  <para style="q2" vid="PSA 106:48">nafatin ba nafatin.</para>
  <para style="q1" vid="PSA 106:48">Ema hotu-hotu dehan, “Amen!”</para>
  <para style="b" vid="PSA 106:48" />
  <para style="q1" vid="PSA 106:48">Hahii NAI Maromak!<verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="s">Agradese ba Nai Maromak tanba Nia domin rohan-laek</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">107:1 </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:34">1 Krónikas 16:34</ref>; <ref loc="2CH 5:13">2 Krónikas 5:13</ref>, <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Esdras 3:11</ref>; <ref loc="PSA 100:5">Salmu 100:5</ref>, <ref loc="PSA 106:1">106:1</ref>, <ref loc="PSA 118:1">118:1</ref>, <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Jeremias 33:11</ref></char>
    </note>Foo agradese ba NAI Maromak tanba Nia nee diak;</para>
  <para style="q2" vid="PSA 107:1">Nia domin dura tinan ba tinan.<verse eid="PSA 107:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2" />Imi sira nebee NAI salva ona, konta imi nia istoria ba;</para>
  <para style="q2" vid="PSA 107:2">Nia hasai tiha ona imi husi funu baluk sira nia liman laran;<verse eid="PSA 107:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3" />Nia halibur imi fila fali husi nasaun sel-seluk,</para>
  <para style="q2" vid="PSA 107:3">husi lorosae-loromonu, husi tasi feto tasi mane.<verse eid="PSA 107:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4" />Iha ema balu lao lemo-lemo tiha iha rai fuik maran,</para>
  <para style="q2" vid="PSA 107:4">la hetan dalan ba sidade ida atu hela.<verse eid="PSA 107:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5" />Sira hamlaha-hamrook;</para>
  <para style="q2" vid="PSA 107:5">sira lakon esperansa ona.<verse eid="PSA 107:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6" />Iha susar laran, sira halerik ba NAI Maromak;</para>
  <para style="q2" vid="PSA 107:6">Nia salva tiha sira husi susar nee.<verse eid="PSA 107:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7" />Nia lori sira tuir dalan loos</para>
  <para style="q2" vid="PSA 107:7">too iha sidade ida nebee sira bele hela.<verse eid="PSA 107:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8" />Sira tenki foo agradese ba NAI tanba Nia domin rohan-laek;</para>
  <para style="q2" vid="PSA 107:8">agradese ba buat furak nebee mak Nia halo ba ita ema.<verse eid="PSA 107:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9" />Tanba sira nebee hamrook, Nia foo hemu too hamrook lakon;</para>
  <para style="q2" vid="PSA 107:9">sira nebee hamlaha, Nia foo ai haan diak nian ba sira too bosu.<verse eid="PSA 107:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10" />Iha ema balu dadur tiha, sira tuur hela iha fatin nebee nakukun teb-tebes;</para>
  <para style="q2" vid="PSA 107:10">korenti besi halo sira terus,<verse eid="PSA 107:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11" />tanba sira kontra tiha ona Maromak nia liafuan,</para>
  <para style="q2" vid="PSA 107:11">no lakohi simu Maromak Aas Liu nia lia menon.<verse eid="PSA 107:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12" />Nunee Nia hatodan sira ho servisu too kosar metan suli;</para>
  <para style="q2" vid="PSA 107:12">sira atu monu sal-sala no la iha ema ida mak tulun.<verse eid="PSA 107:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13" />Iha susar laran, sira halerik ba NAI Maromak;</para>
  <para style="q2" vid="PSA 107:13">Nia salva sira husi susar nee.<verse eid="PSA 107:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14" />Nia lori sira sai husi fatin nakukun liu,</para>
  <para style="q2" vid="PSA 107:14">no hakotu tiha korenti nebee kesi sira.<verse eid="PSA 107:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15" />Sira tenki foo agradese ba NAI tanba Nia domin rohan-laek;</para>
  <para style="q2" vid="PSA 107:15">agradese ba buat furak nebee mak Nia halo ba ita ema.<verse eid="PSA 107:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16" />Tanba Nia sobu aat tiha portaun boot nebee halo husi riti;</para>
  <para style="q2" vid="PSA 107:16">Nia taa kotu tiha besi nebee satan portaun.<verse eid="PSA 107:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17" />Iha ema balu hetan moras tanba sira nia hahalok aat;</para>
  <para style="q2" vid="PSA 107:17">sira hetan terus tanba sira nia pekadu rasik.<verse eid="PSA 107:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18" />Sira baruk ho hahaan hotu-hotu;</para>
  <para style="q2" vid="PSA 107:18">sira besik too ona iha odamatan mate nian.<verse eid="PSA 107:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19" />Iha susar laran, sira halerik ba NAI Maromak;</para>
  <para style="q2" vid="PSA 107:19">Nia salva sira husi susar nee.<verse eid="PSA 107:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20" />Nia lia tuun mak sira hetan kura;</para>
  <para style="q2" vid="PSA 107:20">Nia salva sira husi rai kuak.<verse eid="PSA 107:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21" />Sira tenki foo agradese ba NAI tanba Nia domin rohan-laek;</para>
  <para style="q2" vid="PSA 107:21">agradese ba buat furak nebee mak Nia halo ba ita ema.<verse eid="PSA 107:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22" />Sira tenki foo oferta agradesimentu nian,</para>
  <para style="q2" vid="PSA 107:22">no kanta ho haksolok hodi foo sai buat nebee Nia halo.<verse eid="PSA 107:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23" />Iha ema balu sae roo hodi lao iha tasi laran;</para>
  <para style="q2" vid="PSA 107:23">sira hakur tasi boot hodi halo kontratu.<verse eid="PSA 107:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24" />Sira haree buat nebee mak NAI Maromak halo,</para>
  <para style="q2" vid="PSA 107:24">buat furak nebee Nia halo iha tasi klean.<verse eid="PSA 107:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25" />Nia lia tuun, anin boot sai mai</para>
  <para style="q2" vid="PSA 107:25">hodi hiit sae laloran.<verse eid="PSA 107:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26" />Laloran hirak nee sae too lalehan, tuun too rai klean;</para>
  <para style="q2" vid="PSA 107:26">marineiru sira iha perigu laran, sira tauk teb-tebes.<verse eid="PSA 107:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27" />Sira oin halai no lao rungu-ranga hanesan ema lanu;</para>
  <para style="q2" vid="PSA 107:27">sira nia neon lakon tiha.<verse eid="PSA 107:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28" />Iha susar laran, sira halerik ba NAI Maromak;</para>
  <para style="q2" vid="PSA 107:28">Nia hasai sira husi susar nee.<verse eid="PSA 107:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29" />Nia hapara anin boot,</para>
  <para style="q2" vid="PSA 107:29">no halo laloran hakmatek.<verse eid="PSA 107:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30" />Sira hotu kontenti tanba buat sira nee sai kalma fali;</para>
  <para style="q2" vid="PSA 107:30">Nia lori sira ba rai nebee mak sira atu baa.<verse eid="PSA 107:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31" />Sira tenki foo agradese ba NAI tanba Nia domin rohan-laek;</para>
  <para style="q2" vid="PSA 107:31">agradese ba buat furak nebee mak Nia halo ba ita ema.<verse eid="PSA 107:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32" />Sira tenki foti aas Nia naran iha ema lubuk boot nia klaran,</para>
  <para style="q2" vid="PSA 107:32">no hahii Nia iha nai ulun sira nia leet.<verse eid="PSA 107:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33" />Maromak halo mota sai tiha rai fuik maran;</para>
  <para style="q2" vid="PSA 107:33">Nia halo bee matan sai fali rai maran dekor.<verse eid="PSA 107:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34" />Rai nebee bokur sai tiha rai masin,</para>
  <para style="q2" vid="PSA 107:34">tanba ema nebee hela iha fatin nee, sira nia hahalok aat.<verse eid="PSA 107:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35" />Nia halo rai fuik maran nakfilak ba bee lihun;</para>
  <para style="q2" vid="PSA 107:35">rai maran dekor, Nia halo sai fali bee matan.<verse eid="PSA 107:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36" />Ema sira nebee hamlaha, Nia lori sira baa moris iha nebaa;</para>
  <para style="q2" vid="PSA 107:36">sira mos harii sidade iha nebaa atu bele hela.<verse eid="PSA 107:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37" />Sira kari fini iha toos no kuda uvas;</para>
  <para style="q2" vid="PSA 107:37">sira hetan rezultadu barak.<verse eid="PSA 107:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38" />Nia foo bensaun ba sira, nunee sira aumenta barak;</para>
  <para style="q2" vid="PSA 107:38">sira nia animal mos la menus.<verse eid="PSA 107:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39" />Depois ema hanehan sira no halo sira susar ho tristi</para>
  <para style="q2" vid="PSA 107:39">hodi hatuun sira no halo sira balu mate.<verse eid="PSA 107:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40" />Maromak hamoe fali nai ulun hanehan door sira</para>
  <para style="q2" vid="PSA 107:40">hodi halo sira lao lemo rai iha rai fuik nebee la iha dalan.<verse eid="PSA 107:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41" />Maibee Nia foti sae ema kiak sira husi susar laran,</para>
  <para style="q2" vid="PSA 107:41">no halo sira nia familia aumenta barak hanesan bibi.<verse eid="PSA 107:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42" />Ema moris loos haree hodi haksolok,</para>
  <para style="q2" vid="PSA 107:42">maibee ema aat hotu-hotu taka sira nia ibun.<verse eid="PSA 107:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43" />Ema nebee iha matenek sei foo atensaun ba buat sira nee</para>
  <para style="q2" vid="PSA 107:43">hodi medita NAI Maromak nia domin rohan-laek.<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="s">Orasaun husu tulun tanba inimigu ataka</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1" />Maromak, hau laran metin ba Ita Boot;</para>
  <para style="q2" vid="PSA 108:1">ho hau nia laran tomak, hau sei toka muzika hodi hananu hahii Ita Boot.</para>
  <para style="q1" vid="PSA 108:1">Hau hatete ba hau nia aan, hadeer ba!<verse eid="PSA 108:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 108:2" />Viola ho viola tali sanulu, hadeer ba!</para>
  <para style="q2" vid="PSA 108:2">Hau sei fanu loro matan.<verse eid="PSA 108:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3" />NAI Maromak, hau sei foo agradese ba Ita Boot iha nasaun hotu-hotu nia klaran;</para>
  <para style="q2" vid="PSA 108:3">hau sei hananu hahii Ita Boot iha povu sira nia leet.<verse eid="PSA 108:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4" />Tanba Ita Boot nia domin aas liu lalehan;</para>
  <para style="q2" vid="PSA 108:4">Ita Boot nia lia loos firmi too iha kalohan.<verse eid="PSA 108:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5" />Maromak, hatudu Ita Boot nia Aan aas liu lalehan;</para>
  <para style="q2" vid="PSA 108:5">halo Ita Boot nia kbiit domina mundu tomak.<verse eid="PSA 108:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6" />Hodi Ita Boot nia liman loos salva ami no tulun ami ba,</para>
  <para style="q2" vid="PSA 108:6">atu nunee ema nebee Ita Boot hadomi bele hetan salvasaun.<verse eid="PSA 108:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7" />Maromak lia tuun husi Nia hela fatin dehan,</para>
  <para style="q2" vid="PSA 108:7">“Hau sei manaan!</para>
  <para style="q1" vid="PSA 108:7">Hau sei sukat rai Sikem hodi foo ba Hau nia povu;</para>
  <para style="q2" vid="PSA 108:7">Hau sei fahe rai Sukot ba sira.<verse eid="PSA 108:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8" />Rai Gileade Hau nian,</para>
  <para style="q2" vid="PSA 108:8">rai Manassés mos Hau nian;</para>
  <para style="q1" vid="PSA 108:8">ema Efraim Hau nia kapaseti,</para>
  <para style="q2" vid="PSA 108:8">ema Judá Hau nia rota liurai.<verse eid="PSA 108:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9" />Rai Moab Hau nia basia hodi fase liman;</para>
  <para style="q2" vid="PSA 108:9">rai Edom fatin para soe Hau nia sandalias ba;</para>
  <para style="q2" vid="PSA 108:9">Hau haksolok haklalak tanba Hau manaan rai Filístia.”<verse eid="PSA 108:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10" />Maromak, see loos mak atu lori hau ba iha sidade nebee forti?</para>
  <para style="q2" vid="PSA 108:10">See loos mak atu lori hau ba iha rai Edom?<verse eid="PSA 108:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11" />Maromak, Ita Boot soe duni ami ka?</para>
  <para style="q2" vid="PSA 108:11">Maromak, Ita Boot lakohi avansa ho ami nia militar sira ka?<verse eid="PSA 108:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12" />Tulun ami hodi kontra inimigu sira,</para>
  <para style="q2" vid="PSA 108:12">tanba ema kriatura nia ajuda la iha folin.<verse eid="PSA 108:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13" />Hamutuk ho Maromak ita sei manaan;</para>
  <para style="q2" vid="PSA 108:13">Nia sei sama ita nia inimigu sira.<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="s">Ema laran moras halerik ba Nai Maromak</para>
  <para style="d">Salmu David nian, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1" />Hau nia Maromak, hau hahii Ita Boot;</para>
  <para style="q2" vid="PSA 109:1">keta nonook deit,<verse eid="PSA 109:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2" />tanba ema aat ho ema lohi door loke sira nia ibun hodi kontra hau;</para>
  <para style="q2" vid="PSA 109:2">sira nia ibun koalia lia bosok hasoru hau.<verse eid="PSA 109:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3" />Sira haleu hau hodi foo sai liafuan odi;</para>
  <para style="q2" vid="PSA 109:3">sira ataka hau maski hau la sala.<verse eid="PSA 109:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4" />Hau hadomi sira no halo orasaun ba sira,</para>
  <para style="q2" vid="PSA 109:4">maibee sira duun fali hau.<verse eid="PSA 109:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5" />Hau nia hahalok diak, sira selu fali ho aat;</para>
  <para style="q2" vid="PSA 109:5">hau hadomi sira maibee sira odi fali hau.<verse eid="PSA 109:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6" />Foti ema aat ruma hodi kontra hau nia inimigu;</para>
  <para style="q2" vid="PSA 109:6">haruka ema ida hamriik iha nia liman loos hodi foo sala ba nia.<verse eid="PSA 109:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7" />Bainhira juis tesi nia lia, hau husu atu juis hatuun desizaun katak nia sala duni;</para>
  <para style="q2" vid="PSA 109:7">konsidera nia orasaun mos hanesan pekadu ida.<verse eid="PSA 109:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">109:8 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:20">Apostolu sira nia Istoria 1:20</ref>
      </char>
    </note>Habadak tiha nia vida ba;</para>
  <para style="q2" vid="PSA 109:8">husik ema seluk hadau tiha nia kargu.<verse eid="PSA 109:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9" />Husik nia oan sira sai oan kiak,</para>
  <para style="q2" vid="PSA 109:9">no nia feen sai faluk tiha.<verse eid="PSA 109:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10" />Husik nia oan sira lao lemo rai hodi tane liman ba ema seluk;</para>
  <para style="q2" vid="PSA 109:10">husik ema duni sira sai husi sira nia uma nebee naksobu tiha ona.<verse eid="PSA 109:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11" />Halo nia la bele selu fali nia tusan too osan nain foti tiha nia riku-soin hotu;</para>
  <para style="q2" vid="PSA 109:11">husik ema fuik mai hadau hotu tiha buat nebee nia hetan husi nia kosar been.<verse eid="PSA 109:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12" />Hau husu atu la iha ema ida halo tan buat diak ba nia,</para>
  <para style="q2" vid="PSA 109:12">ka hanoin nia oan nebee nia husik hela.<verse eid="PSA 109:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13" />Halo nia jerasaun sira lakon mohu,</para>
  <para style="q2" vid="PSA 109:13">nunee sira nia naran hasai tiha husi jerasaun tuir mai.<verse eid="PSA 109:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14" />NAI Maromak, hanoin hetan nafatin nia bei-ala sira nia sala ba;</para>
  <para style="q2" vid="PSA 109:14">keta hamoos nia inan nia pekadu.<verse eid="PSA 109:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15" />Husik sira nia sala hela nafatin iha NAI Maromak nia oin,</para>
  <para style="q2" vid="PSA 109:15">atu nia naran la temi tan iha mundu nee.<verse eid="PSA 109:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16" />Tanba nia nunka hanoin atu hatudu laran diak ba ema,</para>
  <para style="q2" vid="PSA 109:16">maibee nia halo terus ema kiak ho kbiit-laek sira ho ema nebee lakon esperansa</para>
  <para style="q2" vid="PSA 109:16">hodi oho sira.<verse eid="PSA 109:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17" />Nia gosta foo sai malisan ba ema;</para>
  <para style="q2" vid="PSA 109:17">husik malisan nee fila fali ba nia.</para>
  <para style="q1" vid="PSA 109:17">Nia lakohi foo bensaun ba ema;</para>
  <para style="q2" vid="PSA 109:17">husik bensaun mos dook tiha husi nia.<verse eid="PSA 109:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18" />Malisan sai tiha hanesan fali hena nebee nia hatais loro-loron;</para>
  <para style="q2" vid="PSA 109:18">halo malisan tama tiha ona iha nia isin lolon hanesan bee nebee nia hemu;</para>
  <para style="q2" vid="PSA 109:18">halo malisan tama liu ba iha nia ruin hanesan mina nebee nia kose.<verse eid="PSA 109:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19" />Halo malisan falun nia hanesan ropa nebee nia hatais,</para>
  <para style="q2" vid="PSA 109:19">no sempre kesi metin nia hanesan sintu.<verse eid="PSA 109:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20" />NAI Maromak, hatuun kastigu hirak nee hodi selu fali ema nebee duun hau;</para>
  <para style="q2" vid="PSA 109:20">foo kastigu nee ba ema nebee mak hatete aat hau.<verse eid="PSA 109:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21" />Maibee NAI Maromak Kbiit Nain,</para>
  <para style="q2" vid="PSA 109:21">tulun hau, atu ema foti aas Ita Boot nia naran;</para>
  <para style="q2" vid="PSA 109:21">salva hau, tanba Ita Boot nia domin nee diak teb-tebes.<verse eid="PSA 109:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22" />Tanba hau kiak no kbiit-laek,</para>
  <para style="q2" vid="PSA 109:22">no hau nia fuan kanek too laran.<verse eid="PSA 109:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23" />Uitoan tan hau lakon hanesan lalatak nebee mohu bainhira loro matan monu;</para>
  <para style="q2" vid="PSA 109:23">hau hanesan gafanhotu nebee anin huu lakon tiha.<verse eid="PSA 109:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24" />Hau nia ain tuur nakdedar tanba jejun;</para>
  <para style="q2" vid="PSA 109:24">hau nia isin sai krekas, kulit taka ruin.<verse eid="PSA 109:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25" />
    <note caller="+" style="x">
      <char style="xo" closed="false">109:25 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:39">Mateus 27:39</ref>; <ref loc="MRK 15:29">Marcos 15:29</ref></char>
    </note>Ema nebee duun hau hamnasa fali hau;</para>
  <para style="q2" vid="PSA 109:25">sira haree hau, sira doko ulun.<verse eid="PSA 109:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26" />NAI hau nia Maromak, tulun hau ba;</para>
  <para style="q2" vid="PSA 109:26">salva hau tuir Ita Boot nia domin rohan-laek.<verse eid="PSA 109:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27" />Foo hatene ba sira katak Ita Boot nia liman mak halo ida nee,</para>
  <para style="q2" vid="PSA 109:27">NAI Maromak mak salva hau.<verse eid="PSA 109:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28" />Sira bele hotar hau,</para>
  <para style="q2" vid="PSA 109:28">maibee Ita Boot sei foo bensaun;</para>
  <para style="q1" vid="PSA 109:28">husik ema nebee ataka hau hetan moe,</para>
  <para style="q2" vid="PSA 109:28">maibee Ita Boot nia atan hau hetan ksolok.<verse eid="PSA 109:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29" />Husik ema nebee duun hau hetan naran foer</para>
  <para style="q2" vid="PSA 109:29">hodi falun aan ho moe hanesan fali taka hena.<verse eid="PSA 109:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30" />Hau nia ibun sei agradese ba NAI Maromak;</para>
  <para style="q2" vid="PSA 109:30">hau sei hahii Nia iha ema lubuk boot nia klaran.<verse eid="PSA 109:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31" />Tanba Maromak defende ema kbiit-laek sira</para>
  <para style="q2" vid="PSA 109:31">hodi salva sira husi ema nebee atu hamonu kastigu mate ba sira.<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="s">Nai Maromak foo kbiit ba liurai</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">110:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:44">Mateus 22:44</ref>; <ref loc="MRK 12:36">Marcos 12:36</ref>; <ref loc="LUK 20:42">Lucas 20:42</ref>,<ref loc="LUK 20:43">43</ref>; <ref loc="ACT 2:34">Apostolu sira nia Istoria 2:34</ref>,<ref loc="ACT 2:35">35</ref>; <ref loc="1CO 15:25">1 Korintu 15:25</ref>; <ref loc="EPH 1:20-22">Éfezu 1:20-22</ref>; <ref loc="COL 3:1">Kolose 3:1</ref>; <ref loc="HEB 1:13">Ebreu 1:13</ref>, <ref loc="HEB 8:1">8:1</ref>, <ref loc="HEB 10:12">10:12</ref>,<ref loc="HEB 10:13">13</ref></char>
    </note>NAI Maromak hatete ona ba hau nia nai nunee:</para>
  <para style="q2" vid="PSA 110:1">“Mai tuur iha Hau nia sorin loos,</para>
  <para style="q2" vid="PSA 110:1">too Hau halo o nia inimigu sira taka rabat iha o nia ain okos.”<verse eid="PSA 110:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2" />NAI Maromak sei haboot o nia kbiit nudar liurai;</para>
  <para style="q2" vid="PSA 110:2">o ukun husi Siaun;</para>
  <para style="q2" vid="PSA 110:2">too o nia inimigu sira mos o sei ukun!<verse eid="PSA 110:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3" />Iha loron nebee o hamriik iha foho santu atu halo funu,</para>
  <para style="q2" vid="PSA 110:3">o nia tropas sira sei prontu;</para>
  <para style="q1" vid="PSA 110:3">o nia mane joven sira sei mai</para>
  <para style="q2" vid="PSA 110:3">hanesan mahobeen iha dadeer-saan.<verse eid="PSA 110:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">110:4 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 5:6">Ebreu 5:6</ref>, <ref loc="HEB 6:20">6:20</ref>, <ref loc="HEB 7:17">7:17</ref>,<ref loc="HEB 7:21">21</ref></char>
    </note>NAI Maromak jura tiha ona,</para>
  <para style="q2" vid="PSA 110:4">no sei la muda Nia promesa dehan,</para>
  <para style="q2" vid="PSA 110:4">“O sai nai lulik tinan ba tinan, hanesan Melkizedek.”<verse eid="PSA 110:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5" />Nai Maromak iha hela o nia sorin loos;</para>
  <para style="q2" vid="PSA 110:5">iha loron nebee Nia fakar sai Nia hirus,</para>
  <para style="q2" vid="PSA 110:5">Nia sei hamohu tiha liurai husi rai sel-seluk.<verse eid="PSA 110:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6" />Nia sei hamonu kastigu ba nasaun jentiu sira</para>
  <para style="q2" vid="PSA 110:6">hodi halakon tiha ukun nain sira iha mundu tomak,</para>
  <para style="q2" vid="PSA 110:6">too mate isin bar-barak bou hamutuk.<verse eid="PSA 110:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7" />Liurai sei hemu bee husi mota oan iha dalan ninin,</para>
  <para style="q2" vid="PSA 110:7">nunee nia sei forti fali hodi foti sae nia ulun.<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="s">Mai ita hahii Nai Maromak</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1" />Hahii NAI Maromak!</para>
  <para style="b" vid="PSA 111:1" />
  <para style="q1" vid="PSA 111:1">Hau sei agradese ba NAI Maromak ho hau nia laran tomak</para>
  <para style="q2" vid="PSA 111:1">bainhira hau halibur malu ho ema nebee moris loos.<verse eid="PSA 111:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2" />NAI Maromak halo buat mesak furak;</para>
  <para style="q2" vid="PSA 111:2">see mak gosta haree buat nebee Maromak halo, sira medita buat sira nee.<verse eid="PSA 111:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3" />Nia hahalok hatudu sai Nia naran boot ho Nia naroman nabilan;</para>
  <para style="q2" vid="PSA 111:3">Nia sempre halo buat nebee loos too tinan ba tinan.<verse eid="PSA 111:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4" />Nia halo ita la bele haluha Nia milagre;</para>
  <para style="q2" vid="PSA 111:4">NAI nee laran luak no laran diak.<verse eid="PSA 111:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5" />Nia foo ai haan ba ema nebee mak hamtauk Nia;</para>
  <para style="q2" vid="PSA 111:5">Nia hanoin nafatin Nia promesa tinan ba tinan.<verse eid="PSA 111:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6" />Nia hatudu Nia kbiit ba Nia povu</para>
  <para style="q2" vid="PSA 111:6">hodi entrega nasaun seluk nia rai ba sira.<verse eid="PSA 111:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7" />Nia sempre halo buat nebee loos ho justu;</para>
  <para style="q2" vid="PSA 111:7">Nia lei tomak ita bele konfia.<verse eid="PSA 111:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8" />Lei sira nee vale too tinan ba tinan;</para>
  <para style="q2" vid="PSA 111:8">ita tenki moris tuir ho fuan tomak ho laran moos.<verse eid="PSA 111:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9" />Maromak foo liberdade ba Nia povu;</para>
  <para style="q2" vid="PSA 111:9">Nia hatuur Nia promesa ho lei ba sira tinan ba tinan.</para>
  <para style="q2" vid="PSA 111:9">Nia naran santu, Nia makaas teb-tebes.<verse eid="PSA 111:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">111:10 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 28:28">Job 28:28</ref>; <ref loc="PRO 1:7">Provérbiu 1:7</ref>, <ref loc="PRO 9:10">9:10</ref></char>
    </note>Matenek nia huun mai husi hamtauk NAI Maromak;</para>
  <para style="q2" vid="PSA 111:10">ema hotu nebee halo tuir Nia liafuan sei hatene klean.</para>
  <para style="q1" vid="PSA 111:10">Hahii Nia tinan ba tinan!<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="s">Ema diak hetan ksolok</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1" />Hahii NAI Maromak!</para>
  <para style="b" vid="PSA 112:1" />
  <para style="q1" vid="PSA 112:1">Ema nebee hamtauk NAI Maromak,</para>
  <para style="q2" vid="PSA 112:1">no gosta teb-tebes Nia ukun fuan,</para>
  <para style="q2" vid="PSA 112:1">sira hetan ksolok.<verse eid="PSA 112:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2" />Sira nia oan sira naran boot iha rai nee;</para>
  <para style="q2" vid="PSA 112:2">ema moris loos nia jerasaun sei hetan bensaun.<verse eid="PSA 112:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3" />Sira nia uma laran sei iha riku-soin bar-barak;</para>
  <para style="q2" vid="PSA 112:3">sira nia hahalok diak nafatin too tinan ba tinan.<verse eid="PSA 112:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4" />Maski iha nakukun laran, naroman sempre leno ema nebee laran moos;</para>
  <para style="q2" vid="PSA 112:4">sira nee laran diak, laran luak no moris loos.<verse eid="PSA 112:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5" />Ema nebee liman nakloke hodi foo empresta osan ba ema seluk,</para>
  <para style="q2" vid="PSA 112:5">no halao sira nia moris ho lo-loos,</para>
  <para style="q2" vid="PSA 112:5">sira hetan diak.<verse eid="PSA 112:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6" />Tebes duni, ema nebee moris ho laran moos nunka atu nakdoko;</para>
  <para style="q2" vid="PSA 112:6">ema seluk sei hanoin nafatin sira tinan ba tinan.<verse eid="PSA 112:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7" />Sira sei la tauk bainhira rona notisia nebee la diak;</para>
  <para style="q2" vid="PSA 112:7">sira nia laran metin, sira abut metin iha NAI Maromak.<verse eid="PSA 112:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8" />Sira nia laran hakmatek, sira sei la tauk;</para>
  <para style="q2" vid="PSA 112:8">too ikus sira haree sira nia inimigu lakon.<verse eid="PSA 112:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">112:9 </char>
      <char style="xt" closed="false">
        <ref loc="2CO 9:9">2 Korintu 9:9</ref>
      </char>
    </note>Sira fahe buat bar-barak ba ema kiak sira;</para>
  <para style="q2" vid="PSA 112:9">sira nia hahalok diak iha nafatin too tinan ba tinan;</para>
  <para style="q2" vid="PSA 112:9">sira sei makaas, no hetan respeitu.<verse eid="PSA 112:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10" />Haree nunee, ema aat sira sei hirus;</para>
  <para style="q2" vid="PSA 112:10">sira sei ruun nehan too sira lakon mohu tiha;</para>
  <para style="q2" vid="PSA 112:10">ema aat sira nia hakarak sei la vale tiha.<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="s">Nai Maromak nia diak</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1" />Hahii NAI Maromak!</para>
  <para style="b" vid="PSA 113:1" />
  <para style="q1" vid="PSA 113:1">NAI Maromak nia atan sira, hahii Nia ba;</para>
  <para style="q2" vid="PSA 113:1">hahii NAI nia naran.<verse eid="PSA 113:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2" />Foti aas NAI nia naran</para>
  <para style="q2" vid="PSA 113:2">agora too tinan ba tinan.<verse eid="PSA 113:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3" />Husi lorosae too loromonu,</para>
  <para style="q2" vid="PSA 113:3">hahii NAI nia naran ba.<verse eid="PSA 113:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4" />NAI Maromak nee domina nasaun hotu-hotu;</para>
  <para style="q2" vid="PSA 113:4">Nia kbiit aas liu lalehan.<verse eid="PSA 113:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5" />See mak hanesan ita nia NAI Maromak?</para>
  <para style="q2" vid="PSA 113:5">Nia tuur iha leten aas ba hodi ukun.<verse eid="PSA 113:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6" />Husi nebaa Nia hakruuk hodi hateke tuun</para>
  <para style="q2" vid="PSA 113:6">mai lalehan ho rai.<verse eid="PSA 113:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7" />Nia foti sae ema kiak husi rai rahun;</para>
  <para style="q2" vid="PSA 113:7">Nia hasae ema kbiit-laek husi ahu kdesan laran.<verse eid="PSA 113:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8" />Nia halo sira tuur hamutuk ho liurai oan sira;</para>
  <para style="q2" vid="PSA 113:8">sira tuur hamutuk ho nai ulun sira nebee ukun Nia povu.<verse eid="PSA 113:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9" />Feto nebee la kous, Maromak halo nia hetan oan,</para>
  <para style="q2" vid="PSA 113:9">nunee nia moris ho haksolok iha nia uma laran.</para>
  <para style="b" vid="PSA 113:9" />
  <para style="q1" vid="PSA 113:9">Hahii NAI Maromak!<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="s">Nai Maromak lori sai Nia povu husi rai Ejitu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">114:1 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:51">Ézodu 12:51</ref>
      </char>
    </note>Uluk povu Israel sai husi rai Ejitu;</para>
  <para style="q2" vid="PSA 114:1">Jacó nia jerasaun sai husi rai nebee koalia lian estranjeiru.<verse eid="PSA 114:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2" />Iha tempu nebaa rai Judá sai Maromak nia fatin santu;</para>
  <para style="q2" vid="PSA 114:2">ema Israel sai povu nebee Nia ukun.<verse eid="PSA 114:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">114:3 a </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Ézodu 14:21</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="JOS 3:16">Josué 3:16</ref>
      </char>
    </note>Tasi haree, halai sees tiha;</para>
  <para style="q2" vid="PSA 114:3">mota Jordaun hakiduk fali ba kotuk.<verse eid="PSA 114:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4" />Foho boot sira haksoit hanesan bibi aman;</para>
  <para style="q2" vid="PSA 114:4">foho kiik sira haksoit hanesan bibi oan.<verse eid="PSA 114:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5" />Tasi, tansaa mak o halai sees tiha?</para>
  <para style="q2" vid="PSA 114:5">Mota Jordaun, tansaa mak o hakiduk fali ba kotuk?<verse eid="PSA 114:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6" />Foho boot sira, tansaa mak imi haksoit hanesan bibi aman?</para>
  <para style="q2" vid="PSA 114:6">Foho kiik sira, tansaa mak imi haksoit hanesan bibi oan?<verse eid="PSA 114:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7" />Mundu tomak, tauk ho nakdedar iha Nai Maromak nia oin ba;</para>
  <para style="q2" vid="PSA 114:7">hamtauk iha Jacó nia Maromak nia oin.<verse eid="PSA 114:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">114:8 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:1-7">Ézodu 17:1-7</ref>; <ref loc="NUM 20:2-13">Númerus 20:2-13</ref></char>
    </note>Nia halo fatuk lolon boot sai fali bee lihun;</para>
  <para style="q2" vid="PSA 114:8">fatuk nebee toos sai tiha bee matan.<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="s">NAI mesak deit mak Maromak boot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1" />NAI Maromak, ami laos husu atu Ita Boot tane aas ami nia naran, nee lae!</para>
  <para style="q2" vid="PSA 115:1">Maibee tane aas Ita Boot nia naran,</para>
  <para style="q1" vid="PSA 115:1">tanba Ita Boot nia domin rohan-laek</para>
  <para style="q2" vid="PSA 115:1">no Ita Boot sempre kaer metin Ita Boot nia liafuan.<verse eid="PSA 115:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2" />Tansaa mak nasaun jentiu sira husu fali dehan,</para>
  <para style="q2" vid="PSA 115:2">“Sira nia Maromak iha nebee?”<verse eid="PSA 115:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3" />Ami nia Maromak iha lalehan;</para>
  <para style="q2" vid="PSA 115:3">Nia halo saida deit tuir Nia hakarak.<verse eid="PSA 115:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">115:4 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 135:15-18">Salmu 135:15-18</ref>; <ref loc="REV 9:20">Apokalipse 9:20</ref></char>
    </note>Maibee ema jentiu sira adora fali estatua lulik nebee ema kriatura mak halo</para>
  <para style="q2" vid="PSA 115:4">husi osan mean ho osan mutin.<verse eid="PSA 115:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5" />Iha ibun maibee la bele koalia;</para>
  <para style="q2" vid="PSA 115:5">iha matan maibee la bele haree.<verse eid="PSA 115:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6" />Iha tilun maibee la bele rona;</para>
  <para style="q2" vid="PSA 115:6">iha inus maibee la bele horon.<verse eid="PSA 115:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7" />Iha liman maibee la bele senti;</para>
  <para style="q2" vid="PSA 115:7">iha ain maibee la bele lao;</para>
  <para style="q2" vid="PSA 115:7">sira la bele hasai lian husi sira nia kakorok.<verse eid="PSA 115:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8" />Ema nebee kria estatua lulik sira nee, sira sai hanesan fali buat nebee sira kria nee;</para>
  <para style="q2" vid="PSA 115:8">ema nebee fiar ba estatua sira nee mos sei sai nunee hotu.<verse eid="PSA 115:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9" />Israel oan sira, laran metin ba NAI Maromak ba;</para>
  <para style="q2" vid="PSA 115:9">Nia mak tulun imi no defende imi.<verse eid="PSA 115:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10" />Arão nia jerasaun, laran metin ba NAI Maromak ba;</para>
  <para style="q2" vid="PSA 115:10">Nia mak tulun imi no defende imi.<verse eid="PSA 115:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11" />Imi sira nebee hamtauk NAI Maromak, laran metin ba NAI Maromak ba;</para>
  <para style="q2" vid="PSA 115:11">Nia mak tulun imi no defende imi.<verse eid="PSA 115:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12" />NAI hanoin ita, no sei foo bensaun ba ita;</para>
  <para style="q2" vid="PSA 115:12">Nia sei foo bensaun ba povu Israel;</para>
  <para style="q2" vid="PSA 115:12">Nia sei foo bensaun ba Arão nia jerasaun.<verse eid="PSA 115:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">115:13 </char>
      <char style="xt" closed="false">
        <ref loc="REV 11:18">Apokalipse 11:18</ref>, <ref loc="REV 19:5">19:5</ref></char>
    </note>Ema kiik ka ema boot nebee hamtauk NAI,</para>
  <para style="q2" vid="PSA 115:13">Nia sei foo bensaun ba sira.<verse eid="PSA 115:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14" />Hau harohan atu NAI Maromak halo imi sai buras,</para>
  <para style="q2" vid="PSA 115:14">atu imi ho imi nia oan sira aumenta barak.<verse eid="PSA 115:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15" />NAI foo bensaun ba imi;</para>
  <para style="q2" vid="PSA 115:15">Kriador lalehan ho rai nian foo bensaun ba imi.<verse eid="PSA 115:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16" />Lalehan nebaa NAI nian,</para>
  <para style="q2" vid="PSA 115:16">maibee mundu nee Nia foo tiha ona ba ema kriatura.<verse eid="PSA 115:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17" />Laos ema mate mak hahii NAI;</para>
  <para style="q2" vid="PSA 115:17">laos ema nebee mak tuun tiha ona ba fatin lian-laek mak gaba Nia.<verse eid="PSA 115:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18" />Maibee ita nee mak hahii adora NAI,</para>
  <para style="q2" vid="PSA 115:18">agora too tinan ba tinan.</para>
  <para style="b" vid="PSA 115:18" />
  <para style="q1" vid="PSA 115:18">Hahii NAI Maromak!<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="s">Agradese ba Nai Maromak nia salvasaun</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1" />Hau hadomi NAI Maromak tanba Nia rona hau nia lian;</para>
  <para style="q2" vid="PSA 116:1">Nia rona hau bainhira hau husu tulun.<verse eid="PSA 116:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2" />Nia see tilun mai hau,</para>
  <para style="q2" vid="PSA 116:2">nunee durante hau sei moris, hau sei harohan nafatin ba Nia.<verse eid="PSA 116:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3" />Uluk tali mate nian bobar hela hau;</para>
  <para style="q2" vid="PSA 116:3">susar rate nian haleu hau;</para>
  <para style="q2" vid="PSA 116:3">hau tristi ho laran dodok.<verse eid="PSA 116:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4" />Depois hau bolu NAI Maromak nia naran;</para>
  <para style="q2" vid="PSA 116:4">hau harohan, “NAI, mai salva hau ba!”<verse eid="PSA 116:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5" />NAI nee laran diak no sempre halo buat nebee loos;</para>
  <para style="q2" vid="PSA 116:5">ita nia Maromak nee laran luak.<verse eid="PSA 116:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6" />NAI foo mahon ba ema nebee mak matan tomak;</para>
  <para style="q2" vid="PSA 116:6">Nia salva hau bainhira hau la bele halo buat ida.<verse eid="PSA 116:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7" />Hau hatete ba hau nia aan, “Hakmatek fila fali ba,</para>
  <para style="q2" vid="PSA 116:7">tanba NAI halo buat diak ba o.”<verse eid="PSA 116:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8" />NAI, Ita Boot hasai tiha ona hau husi mate;</para>
  <para style="q2" vid="PSA 116:8">Ita Boot hamaran tiha hau nia matan been,</para>
  <para style="q2" vid="PSA 116:8">no halo hau nia ain la sidi.<verse eid="PSA 116:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9" />Nunee hau lao iha NAI nia prezensa,</para>
  <para style="q2" vid="PSA 116:9">iha ema moris sira nia rain.<verse eid="PSA 116:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">116:10 </char>
      <char style="xt" closed="false">
        <ref loc="2CO 4:13">2 Korintu 4:13</ref>
      </char>
    </note>Uluk hau dehan, “Hau terus aat liu.”</para>
  <para style="q2" vid="PSA 116:10">Bele nunee mos hau konfia NAI Maromak.<verse eid="PSA 116:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11" />Iha konfuzaun laran hau dehan,</para>
  <para style="q2" vid="PSA 116:11">“Ema hotu-hotu bosok-teen.”<verse eid="PSA 116:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12" />Oinsaa mak hau bele selu fali</para>
  <para style="q2" vid="PSA 116:12">NAI Maromak nia diak tomak nebee Nia halo ona mai hau?<verse eid="PSA 116:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13" />Hau sei hasae oferta tua hodi agradese tanba NAI salva tiha ona hau;</para>
  <para style="q2" vid="PSA 116:13">hau sei bolu NAI nia naran.<verse eid="PSA 116:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14" />Ho nunee hau kumpri hau nia promesa ba NAI</para>
  <para style="q2" vid="PSA 116:14">iha Nia povu hotu nia oin.<verse eid="PSA 116:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15" />NAI Maromak hanoin teb-tebes</para>
  <para style="q2" vid="PSA 116:15">bainhira Nia ema ida mate.<verse eid="PSA 116:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16" />Tebes duni NAI, hau serbi Ita Boot;</para>
  <para style="q2" vid="PSA 116:16">hau nee Ita Boot nia atan, hanesan mos hau nia inan.</para>
  <para style="q2" vid="PSA 116:16">Ita Boot hasai tiha ona hau husi lasu.<verse eid="PSA 116:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17" />Hau sei foo oferta agradesimentu nian ba Ita Boot</para>
  <para style="q2" vid="PSA 116:17">hodi bolu Ita Boot nia naran.<verse eid="PSA 116:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18" />Hau sei kumpri hau nia promesa ba NAI</para>
  <para style="q2" vid="PSA 116:18">iha Nia povu hotu nia oin,<verse eid="PSA 116:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19" />iha NAI nia uma oin</para>
  <para style="q2" vid="PSA 116:19">iha Jerusalém.</para>
  <para style="b" vid="PSA 116:19" />
  <para style="q1" vid="PSA 116:19">Hahii NAI Maromak!<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="s">Mundu tomak hahii Nai Maromak</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">117:1 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:11">Roma 15:11</ref>
      </char>
    </note>Imi nasaun hotu-hotu, hahii NAI Maromak;</para>
  <para style="q2" vid="PSA 117:1">povu hotu-hotu, haboot Nia naran ba.<verse eid="PSA 117:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2" />Tanba NAI nia domin mai ita boot teb-tebes,</para>
  <para style="q2" vid="PSA 117:2">no Nia promesa ba ita dura tinan ba tinan.</para>
  <para style="b" vid="PSA 117:2" />
  <para style="q1" vid="PSA 117:2">Hahii NAI Maromak!<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="s">Orasaun agradesimentu tanba manaan funu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">118:1 </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:34">1 Krónikas 16:34</ref>; <ref loc="2CH 5:13">2 Krónikas 5:13</ref>, <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Esdras 3:11</ref>; <ref loc="PSA 100:5">Salmu 100:5</ref>, <ref loc="PSA 106:1">106:1</ref>, <ref loc="PSA 107:1">107:1</ref>, <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Jeremias 33:11</ref></char>
    </note>Foo agradese ba NAI Maromak, tanba Nia nee diak;</para>
  <para style="q2" vid="PSA 118:1">Nia domin dura tinan ba tinan.<verse eid="PSA 118:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2" />Israel oan sira, dehan sai ba,</para>
  <para style="q2" vid="PSA 118:2">“Nia domin dura tinan ba tinan.”<verse eid="PSA 118:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3" />Arão nia jerasaun sira, dehan sai ba,</para>
  <para style="q2" vid="PSA 118:3">“Nia domin dura tinan ba tinan.”<verse eid="PSA 118:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4" />Ema nebee hamtauk NAI Maromak, dehan sai ba,</para>
  <para style="q2" vid="PSA 118:4">“Nia domin dura tinan ba tinan.”<verse eid="PSA 118:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5" />Bainhira susar hanehan hau, hau halerik ba NAI Maromak;</para>
  <para style="q2" vid="PSA 118:5">Nia lori tiha hau ba iha rai luan.<verse eid="PSA 118:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">118:6 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 13:6">Ebreu 13:6</ref>
      </char>
    </note>NAI hamutuk ho hau, nunee hau la tauk ida.</para>
  <para style="q2" vid="PSA 118:6">Ema mundu nee bele halo saida ba hau?<verse eid="PSA 118:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7" />NAI hamutuk ho hau; Nia mak tulun hau;</para>
  <para style="q2" vid="PSA 118:7">hau sei haree hau nia inimigu sira lakon.<verse eid="PSA 118:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8" />Diak liu hamahon aan iha NAI</para>
  <para style="q2" vid="PSA 118:8">duke tau laran ba ema mundu nee.<verse eid="PSA 118:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9" />Diak liu hamahon aan iha NAI</para>
  <para style="q2" vid="PSA 118:9">duke tau laran ba ukun nain sira.<verse eid="PSA 118:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10" />Uluk nasaun jentiu hotu-hotu mai serku hau,</para>
  <para style="q2" vid="PSA 118:10">maibee hodi NAI nia naran, hau baku tuun tiha sira.<verse eid="PSA 118:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11" />Sira serku hau husi sor-sorin,</para>
  <para style="q2" vid="PSA 118:11">maibee hodi NAI nia naran, hau baku tuun tiha sira.<verse eid="PSA 118:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12" />Sira hobur hau hanesan bani,</para>
  <para style="q2" vid="PSA 118:12">maibee ahi haan sira lalais hanesan fali ahi haan ai tarak;</para>
  <para style="q2" vid="PSA 118:12">hodi NAI nia naran hau baku tuun tiha sira.<verse eid="PSA 118:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13" />Ema dudu hau ba kotuk, hau besik atu monu,</para>
  <para style="q2" vid="PSA 118:13">maibee NAI tulun tiha hau.<verse eid="PSA 118:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">118:14 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:2">Ézodu 15:2</ref>; <ref loc="ISA 12:2">Isaias 12:2</ref></char>
    </note>NAI mak hau nia forsa; hau hananu ba Nia;</para>
  <para style="q2" vid="PSA 118:14">Nia sai tiha ona hau nia Salvador.<verse eid="PSA 118:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15" />Ema moris loos haksolok iha sira nia tenda laran tanba sira manaan;</para>
  <para style="q2" vid="PSA 118:15">sira haklalak dehan, “NAI nia liman loos halo ona buat boot!<verse eid="PSA 118:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16" />NAI foti aas tiha ona Nia liman loos;</para>
  <para style="q2" vid="PSA 118:16">NAI nia liman loos halo ona buat boot!”<verse eid="PSA 118:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17" />Hau sei la mate maibee moris,</para>
  <para style="q2" vid="PSA 118:17">no hau sei foo sai buat nebee mak NAI halo tiha ona.<verse eid="PSA 118:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18" />NAI foo ona kastigu todan mai hau,</para>
  <para style="q2" vid="PSA 118:18">maibee Nia la entrega hau ba mate.<verse eid="PSA 118:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19" />Loke portaun moris loos nian mai hau,</para>
  <para style="q2" vid="PSA 118:19">atu hau bele tama ba laran hodi foo agradese ba NAI Maromak.<verse eid="PSA 118:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20" />Ida nee mak NAI nia portaun;</para>
  <para style="q2" vid="PSA 118:20">ema nebee moris loos sei tama husi nee.<verse eid="PSA 118:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21" />Hau foo agradese ba Ita Boot, tanba Ita Boot rona ona hau;</para>
  <para style="q2" vid="PSA 118:21">Ita Boot sai tiha ona hau nia Salvador.<verse eid="PSA 118:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">118:22 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 20:17">Lucas 20:17</ref>; <ref loc="ACT 4:11">Apostolu sira nia Istoria 4:11</ref>; <ref loc="1PE 2:7">1 Pedro 2:7</ref></char>
    </note>
    <note caller="+" style="x">
      <char style="xo" closed="false">118:22 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:42">Mateus 21:42</ref>; <ref loc="MRK 12:10">Marcos 12:10</ref>,<ref loc="MRK 12:11">11</ref></char>
    </note>Iha fatuk ida nebee badaen fatuk sira lakohi uza,</para>
  <para style="q2" vid="PSA 118:22">maibee agora fatuk nee mak sai fali fatuk nebee prinsipal.<verse eid="PSA 118:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23" />NAI Maromak rasik mak hili fatuk nee;</para>
  <para style="q2" vid="PSA 118:23">ita haree ba furak teb-tebes.<verse eid="PSA 118:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24" />Ohin loron mak NAI Maromak halo nunee;</para>
  <para style="q2" vid="PSA 118:24">mai ita haksolok ho kontenti iha loron ida nee.<verse eid="PSA 118:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25" />
    <note caller="+" style="x">
      <char style="xo" closed="false">118:25 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:9">Mateus 21:9</ref>; <ref loc="MRK 11:9">Marcos 11:9</ref>; <ref loc="JHN 12:13">João 12:13</ref></char>
    </note>NAI Maromak, favor salva ami!</para>
  <para style="q2" vid="PSA 118:25">NAI, foo rezultadu diak ba ami nia servisu.<verse eid="PSA 118:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26" />
    <note caller="+" style="x">
      <char style="xo" closed="false">118:26 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:9">Mateus 21:9</ref>, <ref loc="MAT 23:39">23:39</ref>; <ref loc="MRK 11:9">Marcos 11:9</ref>; <ref loc="LUK 13:35">Lucas 13:35</ref>, <ref loc="LUK 19:38">19:38</ref>; <ref loc="JHN 12:13">João 12:13</ref></char>
    </note>NAI foo bensaun ba ema ida nebee mai lori NAI nia naran;</para>
  <para style="q2" vid="PSA 118:26">husi NAI nia uma ami foo bensaun ba imi.<verse eid="PSA 118:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27" />NAI mak Maromak;</para>
  <para style="q2" vid="PSA 118:27">Nia foo tiha ona Nia naroman hodi leno ita.</para>
  <para style="q1" vid="PSA 118:27">Kaer ramus tahan iha liman laran ba</para>
  <para style="q2" vid="PSA 118:27">hodi halo prosisaun too iha altar.<verse eid="PSA 118:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28" />Ita Boot mak hau nia Maromak, hau sei hahii Ita Boot;</para>
  <para style="q2" vid="PSA 118:28">Ita Boot mak hau nia Maromak, hau sei foti aas Ita Boot nia naran.<verse eid="PSA 118:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29" />Foo agradese ba NAI Maromak, tanba Nia nee diak;</para>
  <para style="q2" vid="PSA 118:29">Nia domin dura tinan ba tinan.<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="s">Nai Maromak nia lei</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1" />Ema nebee moris livre husi sala,</para>
  <para style="q2" vid="PSA 119:1">no lao tuir NAI Maromak nia lei, sira hetan bensaun.<verse eid="PSA 119:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2" />Ema nebee kaer metin Nia mandamentu,</para>
  <para style="q2" vid="PSA 119:2">no buka Nia ho laran tomak, sira hetan bensaun.<verse eid="PSA 119:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3" />Sira la halo sala;</para>
  <para style="q2" vid="PSA 119:3">sira lao tuir Nia dalan.<verse eid="PSA 119:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4" />NAI, Ita Boot hatuur tiha ona regra</para>
  <para style="q2" vid="PSA 119:4">atu ami halo tuir tomak.<verse eid="PSA 119:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5" />Hau hakarak teb-tebes atu iha hau nia moris tomak,</para>
  <para style="q2" vid="PSA 119:5">hau kaer metin Ita Boot nia lei.<verse eid="PSA 119:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6" />Nunee hau sei la moe leet</para>
  <para style="q2" vid="PSA 119:6">bainhira hau fihir metin Ita Boot nia ukun fuan hotu-hotu.<verse eid="PSA 119:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7" />Ita Boot nia regulamentu loos; hau aprende dadauk</para>
  <para style="q2" vid="PSA 119:7">hodi hahii Ita Boot ho laran moos.<verse eid="PSA 119:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8" />Hau sei halo tuir Ita Boot nia lei;</para>
  <para style="q2" vid="PSA 119:8">keta husik hau mesak.<verse eid="PSA 119:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9" />Oinsaa mak joven ida bele moris loos nafatin?</para>
  <para style="q2" vid="PSA 119:9">Nia presiza moris tuir Ita Boot nia liafuan.<verse eid="PSA 119:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10" />Hau buka Ita Boot ho hau nia laran tomak;</para>
  <para style="q2" vid="PSA 119:10">keta husik hau lao sees fali husi Ita Boot nia ukun fuan.<verse eid="PSA 119:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11" />Hau rai metin Ita Boot nia liafuan iha hau nia laran</para>
  <para style="q2" vid="PSA 119:11">atu hau la bele halo sala hasoru Ita Boot.<verse eid="PSA 119:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12" />NAI Maromak, hau hahii Ita Boot;</para>
  <para style="q2" vid="PSA 119:12">hanorin Ita Boot nia lei mai hau.<verse eid="PSA 119:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13" />Regulamentu hotu-hotu nebee Ita Boot nia ibun hatete sai,</para>
  <para style="q2" vid="PSA 119:13">hau sei konta sai.<verse eid="PSA 119:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14" />Hau kontenti halo tuir Ita Boot nia mandamentu</para>
  <para style="q2" vid="PSA 119:14">hanesan fali ema kontenti ho nia riku-soin boot.<verse eid="PSA 119:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15" />Hau medita Ita Boot nia regra,</para>
  <para style="q2" vid="PSA 119:15">no fihir metin Ita Boot nia dalan.<verse eid="PSA 119:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16" />Hau haksolok teb-tebes ho Ita Boot nia regulamentu;</para>
  <para style="q2" vid="PSA 119:16">hau sei la haluha Ita Boot nia liafuan.<verse eid="PSA 119:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17" />Halo diak ba Ita Boot nia atan hau,</para>
  <para style="q2" vid="PSA 119:17">atu hau bele moris hodi halo tuir Ita Boot nia liafuan.<verse eid="PSA 119:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18" />Loke hau nia matan atu hau bele haree</para>
  <para style="q2" vid="PSA 119:18">buat furak iha Ita Boot nia lei.<verse eid="PSA 119:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19" />Hau ema lao rai iha mundu nee;</para>
  <para style="q2" vid="PSA 119:19">keta subar Ita Boot nia ukun fuan mai hau.<verse eid="PSA 119:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20" />Loron-kalan hau hamlaha-hamrook</para>
  <para style="q2" vid="PSA 119:20">ba Ita Boot nia regulamentu.<verse eid="PSA 119:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21" />Ita Boot siak ema nebee foti aan;</para>
  <para style="q2" vid="PSA 119:21">see mak lao sees husi Ita Boot nia ukun fuan, sira hetan malisan.<verse eid="PSA 119:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22" />Hasai tiha liafuan insulta no liafuan aat nebee sira hatete mai hau,</para>
  <para style="q2" vid="PSA 119:22">tanba hau kaer metin Ita Boot nia mandamentu.<verse eid="PSA 119:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23" />Maski nai ulun sira tuur hodi kombina malu hasoru hau,</para>
  <para style="q2" vid="PSA 119:23">maibee Ita Boot nia atan hau sei medita Ita Boot nia lei.<verse eid="PSA 119:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24" />Ita Boot nia mandamentu mak hau nia ksolok;</para>
  <para style="q2" vid="PSA 119:24">mandamentu nee mak hau nia matadalan.<verse eid="PSA 119:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25" />Hau tuur hakdasak hela iha rai rahun;</para>
  <para style="q2" vid="PSA 119:25">hodi Ita Boot nia liafuan hafoun fali hau nia moris ba.<verse eid="PSA 119:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26" />Hau nia lalaok moris nian hau konta tiha ona ba Ita Boot, no Ita Boot hataan;</para>
  <para style="q2" vid="PSA 119:26">hanorin Ita Boot nia lei mai hau.<verse eid="PSA 119:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27" />Halo hau kompriende Ita Boot nia regra nia lalaok oinsaa,</para>
  <para style="q2" vid="PSA 119:27">atu hau bele medita buat furak nebee Ita Boot halo.<verse eid="PSA 119:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28" />Hau tristi ho laran susar;</para>
  <para style="q2" vid="PSA 119:28">hodi Ita Boot nia liafuan haforsa hau ba.<verse eid="PSA 119:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29" />Hadook hau husi dalan bosok nian;</para>
  <para style="q2" vid="PSA 119:29">hanoin hau, hanorin Ita Boot nia lei mai hau.<verse eid="PSA 119:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30" />Hau hili tiha ona dalan loos nian;</para>
  <para style="q2" vid="PSA 119:30">hau foo aan tomak hodi halo tuir Ita Boot nia regulamentu.<verse eid="PSA 119:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31" />NAI Maromak, hau kaer metin hela Ita Boot nia mandamentu;</para>
  <para style="q2" vid="PSA 119:31">keta husik hau moe leet.<verse eid="PSA 119:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32" />Hau duni tuir Ita Boot nia ukun fuan,</para>
  <para style="q2" vid="PSA 119:32">tanba Ita Boot halo hau kompriende klean.<verse eid="PSA 119:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33" />NAI Maromak, hanorin hau kona ba Ita Boot nia lei nia lalaok,</para>
  <para style="q2" vid="PSA 119:33">atu hau bele lao tuir too rohan.<verse eid="PSA 119:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34" />Halo hau kompriende, nunee hau sei kaer metin Ita Boot nia lei</para>
  <para style="q2" vid="PSA 119:34">hodi halo tuir ho laran tomak.<verse eid="PSA 119:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35" />Tulun hau atu moris tuir Ita Boot nia ukun fuan,</para>
  <para style="q2" vid="PSA 119:35">tanba ida nee foo ksolok mai hau.<verse eid="PSA 119:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36" />Halo hau nia laran ba deit Ita Boot nia mandamentu,</para>
  <para style="q2" vid="PSA 119:36">laos ba riku-soin.<verse eid="PSA 119:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37" />Hasees tiha hau nia matan husi buat nebee la iha folin;</para>
  <para style="q2" vid="PSA 119:37">hodi Ita Boot nia liafuan hafoun fali hau nia moris ba.<verse eid="PSA 119:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38" />Halo tuir Ita Boot nia promesa ba Ita Boot nia atan hau;</para>
  <para style="q2" vid="PSA 119:38">promesa nee foo ba ema nebee hamtauk Ita Boot.<verse eid="PSA 119:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39" />Ema nia liafuan insulta halo hau laran todan atu rona; hasai tiha ba,</para>
  <para style="q2" vid="PSA 119:39">tanba Ita Boot nia regra diak.<verse eid="PSA 119:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40" />Hau hakarak teb-tebes halo tuir Ita Boot nia regra;</para>
  <para style="q2" vid="PSA 119:40">hafoun fali hau nia moris tanba Ita Boot nee diak.<verse eid="PSA 119:40" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41" />NAI Maromak, hau husu atu Ita Boot nia domin rohan-laek mai too iha hau;</para>
  <para style="q2" vid="PSA 119:41">salva hau tuir Ita Boot nia promesa.<verse eid="PSA 119:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42" />Nunee hau bele hataan ema nebee mak hatete aat hau,</para>
  <para style="q2" vid="PSA 119:42">tanba hau kaer metin Ita Boot nia liafuan.<verse eid="PSA 119:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43" />Keta hasai lia loos husi hau nia ibun,</para>
  <para style="q2" vid="PSA 119:43">tanba hau laran metin ba ita Boot nia regulamentu.<verse eid="PSA 119:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44" />Hau sei halo tuir Ita Boot nia lei beibeik,</para>
  <para style="q2" vid="PSA 119:44">too tinan ba tinan.<verse eid="PSA 119:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45" />Hau sei lao ho livre,</para>
  <para style="q2" vid="PSA 119:45">tanba hau buka Ita Boot nia regra.<verse eid="PSA 119:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46" />Hau sei koalia kona ba Ita Boot nia mandamentu iha liurai sira nia oin;</para>
  <para style="q2" vid="PSA 119:46">hau sei la moe.<verse eid="PSA 119:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47" />Hau haksolok teb-tebes ho Ita Boot nia ukun fuan,</para>
  <para style="q2" vid="PSA 119:47">tanba hau nia laran monu ba ukun fuan sira nee.<verse eid="PSA 119:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48" />Hau nia laran monu, nunee hau tane aas ita Boot nia ukun fuan sira nee;</para>
  <para style="q2" vid="PSA 119:48">hau medita Ita Boot nia lei.<verse eid="PSA 119:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49" />Hanoin nafatin Ita Boot nia liafuan ba Ita Boot nia atan hau,</para>
  <para style="q2" vid="PSA 119:49">tanba liafuan nee foo esperansa mai hau.<verse eid="PSA 119:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50" />Buat nebee konsola hau iha terus laran mak nee:</para>
  <para style="q2" vid="PSA 119:50">Ita Boot nia promesa hafoun fali hau nia moris.<verse eid="PSA 119:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51" />Ema foti aan sira sempre hatuun hau,</para>
  <para style="q2" vid="PSA 119:51">maibee hau la lao sees husi Ita Boot nia lei.<verse eid="PSA 119:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52" />NAI Maromak, hau hanoin nafatin regulamentu nebee Ita Boot foo hori uluk liu;</para>
  <para style="q2" vid="PSA 119:52">regulamentu nee halo hau nia laran hakmatek.<verse eid="PSA 119:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53" />Bainhira ema aat fila kotuk ba Ita Boot nia lei,</para>
  <para style="q2" vid="PSA 119:53">hau nia laran nakali.<verse eid="PSA 119:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54" />Hau hela iha nebee deit,</para>
  <para style="q2" vid="PSA 119:54">hau hananu kona ba Ita Boot nia lei.<verse eid="PSA 119:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55" />NAI Maromak, iha kalan hau hanoin Ita Boot nia naran;</para>
  <para style="q2" vid="PSA 119:55">hau kaer metin Ita Boot nia lei.<verse eid="PSA 119:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56" />Hau sempre halo tuir Ita Boot nia regra;</para>
  <para style="q2" vid="PSA 119:56">ida nee mak hau nia lalaok moris.<verse eid="PSA 119:56" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57" />NAI Maromak, hau nia riku-soin mak Ita Boot;</para>
  <para style="q2" vid="PSA 119:57">hau promete tiha ona atu halo tuir Ita Boot nia liafuan.<verse eid="PSA 119:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58" />Ho laran tomak hau husu atu Ita Boot haree hau diak;</para>
  <para style="q2" vid="PSA 119:58">hanoin hau tuir Ita Boot nia promesa.<verse eid="PSA 119:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59" />Hau tetu hau nia hahalok;</para>
  <para style="q2" vid="PSA 119:59">hau fila hodi hakat tuir Ita Boot nia mandamentu haruka.<verse eid="PSA 119:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60" />Hau sei halo tuir kedas Ita Boot nia ukun fuan;</para>
  <para style="q2" vid="PSA 119:60">hau sei la demora.<verse eid="PSA 119:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61" />Ema aat sira nia talin kesi metin hau;</para>
  <para style="q2" vid="PSA 119:61">bele nunee mos hau sei la haluha Ita Boot nia lei.<verse eid="PSA 119:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62" />Iha kalan boot hau hadeer hodi foo agradese ba Ita Boot,</para>
  <para style="q2" vid="PSA 119:62">tanba Ita Boot nia regulamentu nee loos.<verse eid="PSA 119:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63" />Hau sai belun ba ema hotu nebee mak hamtauk Ita Boot,</para>
  <para style="q2" vid="PSA 119:63">ba ema nebee mak kaer metin Ita Boot nia regra.<verse eid="PSA 119:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64" />NAI Maromak, mundu nee nakonu ho Ita Boot nia domin rohan-laek;</para>
  <para style="q2" vid="PSA 119:64">hanorin Ita Boot nia lei mai hau.<verse eid="PSA 119:64" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65" />NAI Maromak, Ita Boot halo ona buat diak ba Ita Boot nia atan hau</para>
  <para style="q2" vid="PSA 119:65">tuir Ita Boot nia lia fuan.<verse eid="PSA 119:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66" />Hanorin hau atu hau bele matenek hodi foti desizaun ho loos,</para>
  <para style="q2" vid="PSA 119:66">tanba hau fiar ba Ita Boot nia ukun fuan.<verse eid="PSA 119:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67" />Uluk hau lao sala dalan, Ita Boot halo hau terus,</para>
  <para style="q2" vid="PSA 119:67">maibee agora hau kaer metin Ita Boot nia liafuan.<verse eid="PSA 119:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68" />Ita Boot nee diak, no buat nebee Ita Boot halo mos diak;</para>
  <para style="q2" vid="PSA 119:68">hanorin Ita Boot nia lei mai hau.<verse eid="PSA 119:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69" />Ema foti aan sira bosok hodi hafoer hau nia naran,</para>
  <para style="q2" vid="PSA 119:69">maibee ho laran tomak hau kumpri ita Boot nia regra.<verse eid="PSA 119:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70" />Sira nia fuan toos,</para>
  <para style="q2" vid="PSA 119:70">maibee hau haksolok teb-tebes ho Ita Boot nia lei.<verse eid="PSA 119:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71" />Uluk Ita Boot halo hau terus, nee diak ba hau</para>
  <para style="q2" vid="PSA 119:71">atu hau bele aprende Ita Boot nia lei.<verse eid="PSA 119:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72" />Lei nebee sai husi Ita Boot nia ibun nee diak ba hau</para>
  <para style="q2" vid="PSA 119:72">liu fali osan mean osan mutin rihun ba rihun.<verse eid="PSA 119:72" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73" />Ita Boot nia liman mak kria hau no forma hau;</para>
  <para style="q2" vid="PSA 119:73">loke hau nia neon atu hau aprende Ita Boot nia ukun fuan.<verse eid="PSA 119:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74" />Ema sira nebee hamtauk Ita Boot haksolok bainhira sira haree hau,</para>
  <para style="q2" vid="PSA 119:74">tanba hau laran metin ba Ita Boot nia liafuan.<verse eid="PSA 119:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75" />NAI Maromak, hau hatene Ita Boot sempre tesi lia ho lo-loos;</para>
  <para style="q2" vid="PSA 119:75">uluk Ita Boot halo hau terus, tanba Ita Boot sempre hakarak atu hau sai diak.<verse eid="PSA 119:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76" />Hau husu atu Ita Boot nia domin rohan-laek bele halo hau nia laran hakmatek,</para>
  <para style="q2" vid="PSA 119:76">hanesan Ita Boot promete ona ba Ita Boot nia atan hau.<verse eid="PSA 119:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77" />Hatudu Ita Boot nia laran luak mai hau atu hau bele moris,</para>
  <para style="q2" vid="PSA 119:77">tanba Ita Boot nia lei halo haksolok hau nia laran.<verse eid="PSA 119:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78" />Halo ema foti aan sira moe leet tanba sira duun matak hau;</para>
  <para style="q2" vid="PSA 119:78">hau medita hela Ita Boot nia regra.<verse eid="PSA 119:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79" />Hau harohan atu ema sira nebee hamtauk Ita Boot, hakbesik mai hau,</para>
  <para style="q2" vid="PSA 119:79">atu sira bele kompriende Ita Boot nia mandamentu.<verse eid="PSA 119:79" /></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80" />Tulun hau atu halo tuir Ita Boot nia lei ho laran moos,</para>
  <para style="q2" vid="PSA 119:80">atu nunee hau la bele moe leet.<verse eid="PSA 119:80" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81" />Hau hein Ita Boot nia salvasaun too fraku ona,</para>
  <para style="q2" vid="PSA 119:81">maibee hau laran metin ba Ita Boot nia liafuan.<verse eid="PSA 119:81" /></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82" />Hau nia matan kole ona hodi buka Ita Boot nia promesa;</para>
  <para style="q2" vid="PSA 119:82">hau dehan, “Bainhira loos mak Ita Boot atu foo konsola hau?”<verse eid="PSA 119:82" /></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83" />Hau hanesan tua fatin nebee kuak tiha ona;</para>
  <para style="q2" vid="PSA 119:83">bele nunee mos hau la haluha Ita Boot nia lei.<verse eid="PSA 119:83" /></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84" />Ita Boot nia atan hau tenki hein too bainhira tan?</para>
  <para style="q2" vid="PSA 119:84">Bainhira loos mak Ita Boot kastigu ema nebee halo terus hau?<verse eid="PSA 119:84" /></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85" />Ema foti aan sira kee rai kuak atu hamonu hau;</para>
  <para style="q2" vid="PSA 119:85">hahalok nee kontra Ita Boot nia lei.<verse eid="PSA 119:85" /></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86" />Ita Boot nia ukun fuan hotu-hotu ema bele konfia;</para>
  <para style="q2" vid="PSA 119:86">tulun hau tanba ema halo terus hau maski hau la sala.<verse eid="PSA 119:86" /></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87" />Sira besik atu halakon hau nia vida husi mundu nee,</para>
  <para style="q2" vid="PSA 119:87">maibee hau la husik Ita Boot nia regra.<verse eid="PSA 119:87" /></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88" />Hodi Ita Boot nia domin rohan-laek hafoun fali hau nia moris ba,</para>
  <para style="q2" vid="PSA 119:88">atu hau bele kaer metin mandamentu nebee sai husi Ita Boot nia ibun.<verse eid="PSA 119:88" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89" />NAI Maromak, Ita Boot nia liafuan dura nafatin ba nafatin;</para>
  <para style="q2" vid="PSA 119:89">liafuan nee firmi iha lalehan.<verse eid="PSA 119:89" /></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90" />Ita Boot kaer metin Ita Boot nia liafuan husi jerasaun ba jerasaun;</para>
  <para style="q2" vid="PSA 119:90">Ita Boot mak harii mundu nee, nunee mundu iha nafatin.<verse eid="PSA 119:90" /></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91" />Buat hirak nee hotu dura too ohin loron</para>
  <para style="q2" vid="PSA 119:91">tanba hotu-hotu tuir Ita Boot nia orden.<verse eid="PSA 119:91" /></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92" />Se karik hau la haksolok ho Ita Boot nia lei,</para>
  <para style="q2" vid="PSA 119:92">entaun iha momentu hau hetan terus, hau mate tiha ona.<verse eid="PSA 119:92" /></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93" />Hau nunka atu haluha Ita Boot nia regra,</para>
  <para style="q2" vid="PSA 119:93">tanba liu husi regra sira nee mak ita Boot hafoun hau nia moris.<verse eid="PSA 119:93" /></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94" />Hau Ita Boot nian, salva hau ba,</para>
  <para style="q2" vid="PSA 119:94">tanba hau buka Ita Boot nia regra.<verse eid="PSA 119:94" /></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95" />Ema aat sira hein hela atu halakon hau nia vida,</para>
  <para style="q2" vid="PSA 119:95">maibee hau sei reflete Ita Boot nia regra.<verse eid="PSA 119:95" /></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96" />Hau haree buat hotu-hotu iha rohan,</para>
  <para style="q2" vid="PSA 119:96">maibee Ita Boot nia ukun fuan la iha rohan.<verse eid="PSA 119:96" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97" />Hau gosta teb-tebes Ita Boot nia lei;</para>
  <para style="q2" vid="PSA 119:97">hau medita lei nee iha loron tomak.<verse eid="PSA 119:97" /></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98" />Ita Boot nia ukun fuan sempre hamutuk ho hau,</para>
  <para style="q2" vid="PSA 119:98">halo hau matenek liu hau nia inimigu sira.<verse eid="PSA 119:98" /></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99" />Hau kompriende liu fali hau nia mestri sira,</para>
  <para style="q2" vid="PSA 119:99">tanba hau medita Ita Boot nia mandamentu.<verse eid="PSA 119:99" /></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100" />Hau kompriende klean liu fali ferik-katuas sira,</para>
  <para style="q2" vid="PSA 119:100">tanba hau halo tuir Ita Boot nia regra.<verse eid="PSA 119:100" /></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101" />Hau kuidadu hau nia aan husi dalan aat saida deit,</para>
  <para style="q2" vid="PSA 119:101">atu nunee hau bele halo tuir Ita Boot nia liafuan.<verse eid="PSA 119:101" /></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102" />Hau nunka lao sees husi Ita Boot nia regulamentu,</para>
  <para style="q2" vid="PSA 119:102">tanba Ita Boot rasik mak hanorin hau.<verse eid="PSA 119:102" /></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103" />Ita Boot nia liafuan midar tebes mai hau,</para>
  <para style="q2" vid="PSA 119:103">midar liu bani been iha hau nia ibun.<verse eid="PSA 119:103" /></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104" />Hau hetan matenek husi Ita Boot nia regra;</para>
  <para style="q2" vid="PSA 119:104">tanba nee hau hakribi hahalok aat saida deit.<verse eid="PSA 119:104" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105" />Ita Boot nia liafuan foo naroman atu hau bele lao ba oin;</para>
  <para style="q2" vid="PSA 119:105">liafuan nee ahi oan hodi leno hau nia dalan.<verse eid="PSA 119:105" /></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106" />Ita Boot nia regulamentu loos hotu, hau jura tiha ona atu halo tuir,</para>
  <para style="q2" vid="PSA 119:106">no hau sei kumpri juramentu nee.<verse eid="PSA 119:106" /></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107" />NAI Maromak, hau terus liu ona;</para>
  <para style="q2" vid="PSA 119:107">hodi Ita Boot nia liafuan hafoun fali hau nia moris ba.<verse eid="PSA 119:107" /></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108" />Hau hasae orasaun agradesimentu nian ba Ita Boot nudar oferta ida; NAI, simu ba</para>
  <para style="q2" vid="PSA 119:108">hodi hanorin Ita Boot nia regulamentu mai hau.<verse eid="PSA 119:108" /></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109" />Maski dala barak hau iha perigu laran,</para>
  <para style="q2" vid="PSA 119:109">hau sei la haluha Ita Boot nia lei.<verse eid="PSA 119:109" /></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110" />Ema aat sira tau ona lasu mai hau,</para>
  <para style="q2" vid="PSA 119:110">maibee hau la lao sees husi Ita Boot nia regra.<verse eid="PSA 119:110" /></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111" />Ita Boot nia mandamentu mak hau nia riku-soin tinan ba tinan,</para>
  <para style="q2" vid="PSA 119:111">no halo hau nia laran haksolok.<verse eid="PSA 119:111" /></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112" />Hau foo laran hodi halo tuir Ita Boot nia lei</para>
  <para style="q2" vid="PSA 119:112">agora too rohan.<verse eid="PSA 119:112" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113" />Hau odi ema nebee laran ru-rua,</para>
  <para style="q2" vid="PSA 119:113">maibee hau gosta teb-tebes Ita Boot nia lei.<verse eid="PSA 119:113" /></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114" />Ita Boot mak hau nia subar fatin; Ita Boot mak defende hau;</para>
  <para style="q2" vid="PSA 119:114">hau tau fiar ba Ita Boot nia liafuan.<verse eid="PSA 119:114" /></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115" />Imi ema aat sira, dook tiha husi hau,</para>
  <para style="q2" vid="PSA 119:115">atu hau bele halo tuir hau nia Maromak nia ukun fuan.<verse eid="PSA 119:115" /></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116" />Tane hau tuir Ita Boot nia promesa, atu nunee hau bele moris;</para>
  <para style="q2" vid="PSA 119:116">hau laran metin ba Ita Boot, keta husik hau moe leet.<verse eid="PSA 119:116" /></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117" />Tulun hau mak hau sei hetan salvasaun;</para>
  <para style="q2" vid="PSA 119:117">nunee hau sei foo laran beibeik ba Ita Boot nia lei.<verse eid="PSA 119:117" /></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118" />Ita Boot la simu ema sira nebee lao sees husi Ita Boot nia lei;</para>
  <para style="q2" vid="PSA 119:118">sira lohi tuun lohi sae mos la iha folin.<verse eid="PSA 119:118" /></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119" />Ita Boot haree ema aat iha mundu nee hanesan lixu;</para>
  <para style="q2" vid="PSA 119:119">tanba nee hau gosta teb-tebes Ita Boot nia mandamentu.<verse eid="PSA 119:119" /></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120" />Hau nia isin nakdedar tanba hau tauk Ita Boot;</para>
  <para style="q2" vid="PSA 119:120">hau tauk Ita Boot nia justisa.<verse eid="PSA 119:120" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121" />Hau halo tiha ona buat nebee loos ho justu;</para>
  <para style="q2" vid="PSA 119:121">la bele husik hela hau iha hanehan door sira nia liman laran.<verse eid="PSA 119:121" /></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122" />Kuidadu hau ata nia moris;</para>
  <para style="q2" vid="PSA 119:122">keta husik ema foti aan sira hanehan hau.<verse eid="PSA 119:122" /></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123" />Hau nia matan kole ona tanba hein hela Ita Boot atu salva hau</para>
  <para style="q2" vid="PSA 119:123">tuir Ita Boot promete tiha ona.<verse eid="PSA 119:123" /></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124" />Halo diak ba Ita Boot nia atan hau, tuir Ita Boot nia domin rohan-laek;</para>
  <para style="q2" vid="PSA 119:124">hanorin Ita Boot nia lei mai hau.<verse eid="PSA 119:124" /></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125" />Hau nee Ita Boot nia atan, halo hau kompriende,</para>
  <para style="q2" vid="PSA 119:125">atu hau hatene Ita Boot nia mandamentu.<verse eid="PSA 119:125" /></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126" />NAI Maromak, agora mak tempu ba Ita Boot atu hamriik,</para>
  <para style="q2" vid="PSA 119:126">tanba ema la halo tuir tiha ona Ita Boot nia lei.<verse eid="PSA 119:126" /></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127" />Hau gosta Ita Boot nia ukun fuan</para>
  <para style="q2" vid="PSA 119:127">liu fali osan mean, liu fali osan mean diak nian.<verse eid="PSA 119:127" /></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128" />Hau haree Ita Boot nia regra hotu-hotu loos;</para>
  <para style="q2" vid="PSA 119:128">tanba nee hau hakribi hahalok aat saida deit.<verse eid="PSA 119:128" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129" />Ita Boot nia mandamentu furak;</para>
  <para style="q2" vid="PSA 119:129">tanba nee hau halo tuir.<verse eid="PSA 119:129" /></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130" />Ita Boot nia liafuan nakloke hodi foo naroman,</para>
  <para style="q2" vid="PSA 119:130">halo ema matan tomak sira kompriende.<verse eid="PSA 119:130" /></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131" />Hau hamrook teb-tebes ba Ita Boot nia ukun fuan,</para>
  <para style="q2" vid="PSA 119:131">hanesan ema nebee hamrook too kakorok maran.<verse eid="PSA 119:131" /></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132" />Fila mai hau hodi hanoin hau,</para>
  <para style="q2" vid="PSA 119:132">hanesan Ita Boot hanoin ema hotu nebee hadomi Ita Boot.<verse eid="PSA 119:132" /></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133" />Hatudu dalan mai hau atu hau bele lao tuir Ita Boot nia liafuan;</para>
  <para style="q2" vid="PSA 119:133">keta husik buat aat ukun hau.<verse eid="PSA 119:133" /></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134" />Salva hau husi ema nebee hanehan hau,</para>
  <para style="q2" vid="PSA 119:134">atu hau bele halo tuir Ita Boot nia regra.<verse eid="PSA 119:134" /></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135" />Halo Ita Boot nia oin leno Ita Boot nia atan hau;</para>
  <para style="q2" vid="PSA 119:135">hanorin Ita Boot nia lei mai hau.<verse eid="PSA 119:135" /></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136" />Hau nia matan been suli hanesan bee mota nian,</para>
  <para style="q2" vid="PSA 119:136">tanba ema la halo tuir Ita Boot nia lei.<verse eid="PSA 119:136" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137" />NAI Maromak, Ita Boot sempre halo buat nebee loos;</para>
  <para style="q2" vid="PSA 119:137">Ita Boot nia regulamentu loos hotu.<verse eid="PSA 119:137" /></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138" />Mandamentu nebee Ita Boot hatuur nee loos;</para>
  <para style="q2" vid="PSA 119:138">ema bele konfia.<verse eid="PSA 119:138" /></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139" />Hau nia laran nakali</para>
  <para style="q2" vid="PSA 119:139">tanba hau nia inimigu sira la interese Ita Boot nia liafuan.<verse eid="PSA 119:139" /></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140" />Promesa nebee Ita Boot halo nunka falha;</para>
  <para style="q2" vid="PSA 119:140">nee mak Ita Boot nia atan hau gosta teb-tebes.<verse eid="PSA 119:140" /></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141" />Hau nee kiik no ema haree hau la iha folin,</para>
  <para style="q2" vid="PSA 119:141">maibee hau la haluha Ita Boot nia regra.<verse eid="PSA 119:141" /></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142" />Ita Boot sempre halo buat nebee loos nafatin ba nafatin;</para>
  <para style="q2" vid="PSA 119:142">Ita Boot nia lei sempre loos.<verse eid="PSA 119:142" /></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143" />Susar ho terus iha hela hau nia leten,</para>
  <para style="q2" vid="PSA 119:143">maibee hau haksolok ho Ita Boot nia ukun fuan.<verse eid="PSA 119:143" /></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144" />Ita Boot nia mandamentu loos nafatin ba nafatin;</para>
  <para style="q2" vid="PSA 119:144">halo hau kompriende ba, atu hau bele moris.<verse eid="PSA 119:144" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145" />NAI Maromak, ho laran tomak hau halerik husu tulun, hataan hau ba;</para>
  <para style="q2" vid="PSA 119:145">hau sei halo tuir Ita Boot nia lei.<verse eid="PSA 119:145" /></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146" />Hau hasae lia ba Ita Boot, salva hau ba,</para>
  <para style="q2" vid="PSA 119:146">atu hau bele kaer metin Ita Boot nia mandamentu.<verse eid="PSA 119:146" /></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147" />Hau hadeer iha dadeer-saan nakukun hodi halerik husu tulun;</para>
  <para style="q2" vid="PSA 119:147">hau laran metin ba Ita Boot nia liafuan.<verse eid="PSA 119:147" /></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148" />Hau nia matan loke nafatin iha kalan tomak,</para>
  <para style="q2" vid="PSA 119:148">atu hau bele medita Ita Boot nia promesa.<verse eid="PSA 119:148" /></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149" />Hodi Ita Boot nia domin rohan-laek rona hau nia lian ba;</para>
  <para style="q2" vid="PSA 119:149">NAI Maromak, hodi Ita boot nia justisa hafoun fali hau nia moris ba.<verse eid="PSA 119:149" /></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150" />Ema sira nebee duni tuir hau ho hanoin aat, sira besik dadauk hau;</para>
  <para style="q2" vid="PSA 119:150">sira nee dook husi Ita Boot nia lei.<verse eid="PSA 119:150" /></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151" />Maibee NAI, Ita Boot besik hela hau;</para>
  <para style="q2" vid="PSA 119:151">Ita Boot nia ukun fuan hotu-hotu loos.<verse eid="PSA 119:151" /></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152" />Husi kiik kedas hau aprende Ita Boot nia mandamentu;</para>
  <para style="q2" vid="PSA 119:152">husi nebaa hau kompriende katak, Ita Boot hatuur mandamentu nee atu dura tinan ba tinan.<verse eid="PSA 119:152" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153" />Haree ba, hau terus hela, hasai hau husi terus laran nee,</para>
  <para style="q2" vid="PSA 119:153">tanba hau la haluha Ita Boot nia lei.<verse eid="PSA 119:153" /></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154" />Ema duun hela hau, defende hau hodi salva hau ba;</para>
  <para style="q2" vid="PSA 119:154">hafoun fali hau nia moris tuir Ita Boot nia promesa.<verse eid="PSA 119:154" /></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155" />Salvasaun dook husi ema aat sira,</para>
  <para style="q2" vid="PSA 119:155">tanba sira la buka Ita Boot nia lei.<verse eid="PSA 119:155" /></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156" />NAI Maromak, Ita Boot laran luak teb-tebes;</para>
  <para style="q2" vid="PSA 119:156">hodi Ita Boot nia regulamentu hafoun fali hau nia moris ba.<verse eid="PSA 119:156" /></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157" />Iha funu baluk barak mak halo terus hau,</para>
  <para style="q2" vid="PSA 119:157">maibee hau nunka lao sees husi Ita Boot nia mandamentu.<verse eid="PSA 119:157" /></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158" />Hau haree traidor sira, hau hakribi fali,</para>
  <para style="q2" vid="PSA 119:158">tanba sira la kaer metin Ita Boot nia liafuan.<verse eid="PSA 119:158" /></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159" />Haree ba, hau gosta teb-tebes Ita Boot nia regra;</para>
  <para style="q2" vid="PSA 119:159">NAI Maromak, hodi Ita Boot nia domin rohan-laek hafoun fali hau nia moris ba.<verse eid="PSA 119:159" /></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160" />Ita Boot nia liafuan loos hotu;</para>
  <para style="q2" vid="PSA 119:160">Ita Boot nia regulamentu hotu-hotu loos no dura nafatin ba nafatin.<verse eid="PSA 119:160" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161" />Nai ulun sira halo terus hau maski hau la sala,</para>
  <para style="q2" vid="PSA 119:161">maibee hau nia laran tauk ho nakdedar deit ba Ita Boot nia liafuan.<verse eid="PSA 119:161" /></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162" />Hau haksolok ho Ita Boot nia liafuan</para>
  <para style="q2" vid="PSA 119:162">hanesan ema nebee hetan riku-soin boot.<verse eid="PSA 119:162" /></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163" />Hau la simu lia bosok, hau hakribi liu,</para>
  <para style="q2" vid="PSA 119:163">maibee hau gosta teb-tebes Ita Boot nia lei.<verse eid="PSA 119:163" /></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164" />Hau loro-loron hahii Ita Boot dala hitu,</para>
  <para style="q2" vid="PSA 119:164">tanba Ita Boot nia regulamentu loos.<verse eid="PSA 119:164" /></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165" />Ema nebee gosta Ita Boot nia lei, sira hetan pas no hakmatek nebee boot;</para>
  <para style="q2" vid="PSA 119:165">la iha buat ida mak halo sira sidi.<verse eid="PSA 119:165" /></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166" />NAI Maromak, hau hein hela Ita Boot atu salva hau;</para>
  <para style="q2" vid="PSA 119:166">hau moris tuir Ita Boot nia ukun fuan.<verse eid="PSA 119:166" /></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167" />Hau halo tuir Ita Boot nia mandamentu,</para>
  <para style="q2" vid="PSA 119:167">tanba hau gosta teb-tebes.<verse eid="PSA 119:167" /></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168" />Hau halo tuir Ita Boot nia regra ho mandamentu,</para>
  <para style="q2" vid="PSA 119:168">tanba Ita Boot hatene hotu hau nia lalaok moris.<verse eid="PSA 119:168" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169" />NAI Maromak, simu hau nia lia halerik ba;</para>
  <para style="q2" vid="PSA 119:169">hodi Ita Boot nia liafuan halo hau kompriende.<verse eid="PSA 119:169" /></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170" />Simu hau nia orasaun ba;</para>
  <para style="q2" vid="PSA 119:170">salva hau tuir Ita Boot nia promesa.<verse eid="PSA 119:170" /></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171" />Hau nia ibun sei la para hahii Ita Boot,</para>
  <para style="q2" vid="PSA 119:171">tanba Ita Boot hanorin Ita Boot nia lei mai hau.<verse eid="PSA 119:171" /></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172" />Hau nia nanaal hananu kona ba Ita Boot nia liafuan,</para>
  <para style="q2" vid="PSA 119:172">tanba Ita Boot nia ukun fuan hotu-hotu loos.<verse eid="PSA 119:172" /></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173" />Hau harohan atu Ita Boot nia liman prontu hodi tulun hau,</para>
  <para style="q2" vid="PSA 119:173">tanba hau hili atu tuir Ita Boot nia regra.<verse eid="PSA 119:173" /></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174" />NAI Maromak, hau hakarak teb-tebes atu Ita Boot salva hau;</para>
  <para style="q2" vid="PSA 119:174">Ita Boot nia lei halo haksolok hau nia laran.<verse eid="PSA 119:174" /></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175" />Halo hau moris atu hau bele hahii Ita Boot;</para>
  <para style="q2" vid="PSA 119:175">hau harohan atu Ita Boot nia regulamentu ajuda hau.<verse eid="PSA 119:175" /></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176" />Hau lao sala dalan ona hanesan bibi nebee lakon;</para>
  <para style="q2" vid="PSA 119:176">buka tuir Ita Boot nia atan hau ba,</para>
  <para style="q2" vid="PSA 119:176">tanba hau la haluha Ita Boot nia ukun fuan.<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="s">Orasaun husu tulun iha tempu susar</para>
  <para style="d">Kantiku peregrinasaun nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1" />Iha susar laran hau halerik ba NAI Maromak;</para>
  <para style="q2" vid="PSA 120:1">Nia hataan hau.<verse eid="PSA 120:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2" />NAI, salva hau</para>
  <para style="q2" vid="PSA 120:2">husi ema bosok-teen ho lohi door sira.<verse eid="PSA 120:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3" />Imi lohi door sira,</para>
  <para style="q2" vid="PSA 120:3">Imi sei simu todan saida husi Maromak?</para>
  <para style="q2" vid="PSA 120:3">Nia sei foo kastigu imi oinsaa?<verse eid="PSA 120:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4" />Nia sei uza aswain nia rama oan nebee kroat,</para>
  <para style="q2" vid="PSA 120:4">no ahi klaak boot.<verse eid="PSA 120:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5" />Hau terus hela, tanba hau ema lao rai iha rai Mezek;</para>
  <para style="q2" vid="PSA 120:5">hau tenki hela iha ema Kedar nia tenda nia leet.<verse eid="PSA 120:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6" />Hau hela kleur liu ona</para>
  <para style="q2" vid="PSA 120:6">hamutuk ho ema nebee la gosta pas.<verse eid="PSA 120:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7" />Hau hakarak pas ho hakmatek;</para>
  <para style="q2" vid="PSA 120:7">maibee bainhira hau koalia sai, sira hakarak funu.<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="s">Nai Maromak kuidadu Nia povu</para>
  <para style="d">Kantiku peregrinasaun nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1" />Hau foti matan hateke ba foho;</para>
  <para style="q2" vid="PSA 121:1">hau atu hetan tulun husi nebee?<verse eid="PSA 121:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2" />Hau hetan tulun husi NAI Maromak,</para>
  <para style="q2" vid="PSA 121:2">Ida nebee halo lalehan ho rai.<verse eid="PSA 121:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3" />Nia sei la husik o nia ain sidi;</para>
  <para style="q2" vid="PSA 121:3">Ida nebee tau matan ba o sei la dukur.<verse eid="PSA 121:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4" />Tebes duni, Ida nebee tau matan ba Israel nee,</para>
  <para style="q2" vid="PSA 121:4">Nia matan sei la dukur, Nia matan moos hela deit.<verse eid="PSA 121:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5" />NAI Maromak tau matan ba o;</para>
  <para style="q2" vid="PSA 121:5">NAI iha hela o nia sorin loos hodi foo mahon ba o.<verse eid="PSA 121:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6" />Loro matan meudia nian sei la halo o terus;</para>
  <para style="q2" vid="PSA 121:6">fulan iha kalan mos lae.<verse eid="PSA 121:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7" />NAI Maromak sei kuidadu o husi buat aat hotu-hotu;</para>
  <para style="q2" vid="PSA 121:7">Nia sei tau matan ba o nia moris.<verse eid="PSA 121:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8" />NAI sei kuidadu o bainhira o sai husi uma no fila fali ba uma,</para>
  <para style="q2" vid="PSA 121:8">agora too tinan ba tinan.<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="s">Orasaun ba sidade Jerusalém</para>
  <para style="d">Kantiku peregrinasaun husi David.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1" />Hau haksolok bainhira ema dehan mai hau,</para>
  <para style="q2" vid="PSA 122:1">“Mai ita baa iha NAI Maromak nia uma.”<verse eid="PSA 122:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2" />Jerusalém, ami nia ain hakat tama tiha ona</para>
  <para style="q2" vid="PSA 122:2">ba iha o nia portaun boot.<verse eid="PSA 122:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3" />Jerusalém nee harii metin</para>
  <para style="q2" vid="PSA 122:3">nudar sidade nebee la nakdoko.<verse eid="PSA 122:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4" />Suku sira iha Israel sae mai iha nee;</para>
  <para style="q2" vid="PSA 122:4">NAI Maromak nia povu sae mai,</para>
  <para style="q1" vid="PSA 122:4">atu hahii NAI nia naran</para>
  <para style="q2" vid="PSA 122:4">tuir mandamentu nebee Nia foo tiha ona ba Israel.<verse eid="PSA 122:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5" />Iha nee liurai David nia jerasaun sira tuur iha kadeira ukun</para>
  <para style="q2" vid="PSA 122:5">hodi tesi povu nia lia.<verse eid="PSA 122:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6" />Halo orasaun atu ema Jerusalém bele moris diak:</para>
  <para style="q2" vid="PSA 122:6">“Jerusalém, hau harohan atu ema nebee hadomi o, bele moris hakmatek,<verse eid="PSA 122:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7" />o nia palasiu laran iha pas,</para>
  <para style="q2" vid="PSA 122:7">iha o nia moru laran ema bele hela hakmatek.”<verse eid="PSA 122:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8" />Hau hakarak atu hau nia familia ho kolega sira bele hetan diak,</para>
  <para style="q2" vid="PSA 122:8">nunee hau dehan, “Imi ema Jerusalém, moris iha pas nia laran ba.”<verse eid="PSA 122:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9" />Hau hakarak atu NAI ita nia Maromak nia uma bele hetan diak,</para>
  <para style="q2" vid="PSA 122:9">nunee hau buka atu povu Jerusalém moris diak.<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="s">Orasaun husu Nai Maromak nia laran luak</para>
  <para style="d">Kantiku peregrinasaun nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1" />NAI, hau foti matan hateke ba Ita Boot;</para>
  <para style="q2" vid="PSA 123:1">Ita Boot tuur iha kadeira ukun iha lalehan.<verse eid="PSA 123:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2" />Hanesan atan sira nia matan hateke ba patraun,</para>
  <para style="q2" vid="PSA 123:2">hanesan atan feto ida nia matan hateke ba patraun feto,</para>
  <para style="q1" vid="PSA 123:2">nunee mos ami nia matan hateke ba NAI ami nia Maromak,</para>
  <para style="q2" vid="PSA 123:2">too Nia hatudu laran luak mai ami.<verse eid="PSA 123:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3" />NAI Maromak, hatudu Ita Boot nia laran luak mai ami; hanoin ami ba,</para>
  <para style="q2" vid="PSA 123:3">tanba ema hamoe ami la hotu-hotu.<verse eid="PSA 123:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4" />Ami terus aat liu ona,</para>
  <para style="q2" vid="PSA 123:4">tanba ema nebee moris diak, sira hatete aat ami;</para>
  <para style="q2" vid="PSA 123:4">ema foti aan sira hamoe ami.<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="s">Agradese tanba Nai Maromak foo mahon ba Nia povu</para>
  <para style="d">Kantiku peregrinasaun husi David.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1" />Se uluk NAI Maromak la tulun ita karik, ita oinsaa loos?</para>
  <para style="q2" vid="PSA 124:1">Povu Israel koalia tuir ba:<verse eid="PSA 124:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2" />“Se uluk NAI Maromak la tulun ita karik</para>
  <para style="q2" vid="PSA 124:2">bainhira inimigu ataka ita, ita oinsaa loos?”<verse eid="PSA 124:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3" />Bainhira sira nia laran nakali hasoru ita,</para>
  <para style="q2" vid="PSA 124:3">sira sei tolan ita moris.<verse eid="PSA 124:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4" />Bee sei sae hodi taka ita;</para>
  <para style="q2" vid="PSA 124:4">mota boot sei halo ita mout;<verse eid="PSA 124:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 124:5" />korenti bee sei sae makaas hodi dasa sai tiha ita.<verse eid="PSA 124:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6" />Hahii NAI Maromak,</para>
  <para style="q2" vid="PSA 124:6">tanba Nia la husik atu ema lees ita ho sira nia nehan.<verse eid="PSA 124:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7" />Kasador sira tau lasu mai ita,</para>
  <para style="q2" vid="PSA 124:7">maibee ita halai sai tiha ona hanesan manu fuik;</para>
  <para style="q1" vid="PSA 124:7">lasu nee kotu tiha ona,</para>
  <para style="q2" vid="PSA 124:7">nunee ita sai ho livre.<verse eid="PSA 124:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8" />Ita hetan tulun husi NAI Maromak;</para>
  <para style="q2" vid="PSA 124:8">Nia mak halo lalehan ho rai.<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="s">Hakmatek Tanba Nai Maromak foo mahon</para>
  <para style="d">Kantiku peregrinasaun nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1" />Ema nebee laran metin ba NAI Maromak, sira hanesan foho Siaun;</para>
  <para style="q2" vid="PSA 125:1">sira nunka atu nakdoko, sira metin nafatin ba nafatin.<verse eid="PSA 125:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2" />Hanesan foho haleu Jerusalém,</para>
  <para style="q2" vid="PSA 125:2">nunee mos NAI Maromak haleu Nia povu</para>
  <para style="q2" vid="PSA 125:2">agora too tinan ba tinan.<verse eid="PSA 125:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3" />Nai ulun laran aat ukun iha ema moris loos nia rain,</para>
  <para style="q2" vid="PSA 125:3">sira nia ukun sei la dura;</para>
  <para style="q1" vid="PSA 125:3">se lae keta halo be ema moris loos lolo sira nia liman</para>
  <para style="q2" vid="PSA 125:3">hodi halo fali buat aat.<verse eid="PSA 125:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4" />NAI, halo diak ba ema nebee diak;</para>
  <para style="q2" vid="PSA 125:4">foo bensaun ba ema nebee laran moos.<verse eid="PSA 125:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5" />Maibee ema nebee tuir fali dalan kleuk,</para>
  <para style="q2" vid="PSA 125:5">NAI sei soe sai hamutuk ho ema nebee hahalok aat.</para>
  <para style="q1" vid="PSA 125:5">Pas ho hakmatek ba Israel!<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="s">Orasaun atu Nai Maromak hadia fali povu nia moris</para>
  <para style="d">Kantiku peregrinasaun nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1" />Uluk NAI Maromak hadia fila fali povu Siaun nia moris,</para>
  <para style="q2" vid="PSA 126:1">ita senti ida nee mehi deit.<verse eid="PSA 126:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2" />Iha tempu nebaa ita nia ibun nakonu ho hamnasa;</para>
  <para style="q2" vid="PSA 126:2">ita nia nanaal hananu haksolok.</para>
  <para style="q1" vid="PSA 126:2">Ema husi nasaun sel-seluk dehan,</para>
  <para style="q2" vid="PSA 126:2">“NAI halo tiha buat boot ba sira.”<verse eid="PSA 126:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3" />Loos duni, iha tempu nebaa NAI halo duni buat boot ba ita,</para>
  <para style="q2" vid="PSA 126:3">nunee ita haksolok.<verse eid="PSA 126:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4" />NAI, agora hadia fali ami nia moris ba,</para>
  <para style="q2" vid="PSA 126:4">hanesan bee suli hodi haburas rai fuik maran Negebe.<verse eid="PSA 126:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5" />Ema nebee kuda fini ho matan been,</para>
  <para style="q2" vid="PSA 126:5">too tempu kolheta sei hananu haksolok.<verse eid="PSA 126:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6" />Ema nebee tanis tuir dalan</para>
  <para style="q2" vid="PSA 126:6">bainhira lori fini atu kuda iha toos,</para>
  <para style="q1" vid="PSA 126:6">sira sei lori rezultadu toos nian ba uma</para>
  <para style="q2" vid="PSA 126:6">hodi hananu ho haksolok.<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="s">Nai Maromak mak buat diak hotu nia huun</para>
  <para style="d">Kantiku peregrinasaun husi Salomão.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1" />Se karik NAI Maromak la harii uma,</para>
  <para style="q2" vid="PSA 127:1">badaen uma nian servisu saugati.</para>
  <para style="q1" vid="PSA 127:1">Se karik NAI la foo seguransa ba sidade,</para>
  <para style="q2" vid="PSA 127:1">ema nebee kontrola sidade servisu saugati deit.<verse eid="PSA 127:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2" />Imi nebee hadeer molok rai huun mutin</para>
  <para style="q2" vid="PSA 127:2">hodi servisu haluha aan too fali kalan boot</para>
  <para style="q1" vid="PSA 127:2">atu buka moris, imi servisu saugati deit,</para>
  <para style="q2" vid="PSA 127:2">tanba NAI foo deskansa ba ema nebee Nia hadomi.<verse eid="PSA 127:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3" />Oan sira hanesan riku-soin husi NAI Maromak;</para>
  <para style="q2" vid="PSA 127:3">sira nee prezenti nebee Nia foo.<verse eid="PSA 127:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4" />Oan mane nebee moris bainhira nia aman sei joven,</para>
  <para style="q2" vid="PSA 127:4">sira hanesan rama oan iha funu nain nia liman laran.<verse eid="PSA 127:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5" />Ema nebee iha rama oan barak,</para>
  <para style="q2" vid="PSA 127:5">ema nee hetan ksolok.</para>
  <para style="q1" vid="PSA 127:5">Bainhira nia koalia hasoru nia inimigu sira iha fatin tesi lia nian,</para>
  <para style="q2" vid="PSA 127:5">nia sei la moe leet.<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="s">Bensaun ba ema nebee hamtauk Nai Maromak</para>
  <para style="d">Kantiku peregrinasaun nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1" />Ema nebee hamtauk NAI Maromak</para>
  <para style="q2" vid="PSA 128:1">hodi lao tuir Nia dalan, ema nee hetan ksolok.<verse eid="PSA 128:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2" />O sei haan husi o nia kosar been rasik;</para>
  <para style="q2" vid="PSA 128:2">o sei hetan bensaun no moris diak.<verse eid="PSA 128:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3" />O nia feen sei hanesan ai uvas nebee foo fuan barak iha o nia uma;</para>
  <para style="q2" vid="PSA 128:3">o nia oan sira sei hanesan ai oliveira dikin hodi haleu o nia meza.<verse eid="PSA 128:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4" />Loos duni, ema nebee hamtauk NAI Maromak,</para>
  <para style="q2" vid="PSA 128:4">sei hetan bensaun nunee.<verse eid="PSA 128:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5" />Hau harohan atu NAI Maromak foo bensaun ba o husi Siaun;</para>
  <para style="q2" vid="PSA 128:5">hau harohan atu o haree Jerusalém moris diak</para>
  <para style="q2" vid="PSA 128:5">iha o nia vida tomak.<verse eid="PSA 128:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6" />Hau harohan atu o moris too haree o nia bei-oan sira.</para>
  <para style="q2" vid="PSA 128:6">Pas ho hakmatek ba Israel!<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="s">Orasaun hasoru inimigu</para>
  <para style="d">Kantiku peregrinasaun nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1" />“Hau nia inimigu sira hanehan hau husi joven kedas.”</para>
  <para style="q2" vid="PSA 129:1">Israel oan sira hatete tuir ba:<verse eid="PSA 129:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2" />“Hau nia inimigu sira hanehan hau husi joven kedas,</para>
  <para style="q2" vid="PSA 129:2">maibee sira nunka manaan hau.<verse eid="PSA 129:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3" />Sira taa hau nia kotuk too kanek todan,</para>
  <para style="q2" vid="PSA 129:3">hanesan fali toos nain taa rai.<verse eid="PSA 129:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4" />Maibee NAI Maromak sempre halo buat nebee loos;</para>
  <para style="q2" vid="PSA 129:4">ema aat nia talin nebee futu hau, Nia hakotu tiha.”<verse eid="PSA 129:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5" />Hau harohan atu Siaun nia inimigu sira hotu</para>
  <para style="q2" vid="PSA 129:5">hakiduk ho moe.<verse eid="PSA 129:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6" />Husik sira sai hanesan duut nebee moris iha uma kakuluk;</para>
  <para style="q2" vid="PSA 129:6">foin tubun, namlaik tiha ona.<verse eid="PSA 129:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7" />La iha ema ida mak interese atu tesi duut nee;</para>
  <para style="q2" vid="PSA 129:7">la iha ida mak hakarak atu futu hamutuk.<verse eid="PSA 129:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8" />Hau hein katak ema nebee liu husi nebaa nunka kumprimenta sira dehan,</para>
  <para style="q2" vid="PSA 129:8">“NAI Maromak nia bensaun hela ho imi;</para>
  <para style="q2" vid="PSA 129:8">ami foo bensaun ba imi hodi NAI nia naran.”<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="s">Laran metin hodi hein Nai Maromak nia tulun</para>
  <para style="d">Kantiku peregrinasaun nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1" />NAI Maromak, hau iha hela susar boot laran,</para>
  <para style="q2" vid="PSA 130:1">nee mak hau halerik husu tulun ba Ita Boot.<verse eid="PSA 130:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2" />Nai, rona hau nia lian ba;</para>
  <para style="q2" vid="PSA 130:2">see tilun ba hau nia harohan.<verse eid="PSA 130:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3" />NAI Maromak, se karik Ita Boot hanoin nafatin ami nia sala,</para>
  <para style="q2" vid="PSA 130:3">Nai, see mak bele aguenta?<verse eid="PSA 130:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4" />Maibee Ita Boot foo perdaun,</para>
  <para style="q2" vid="PSA 130:4">atu ami bele hamtauk Ita Boot.<verse eid="PSA 130:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5" />Hau laran metin hodi hein NAI Maromak;</para>
  <para style="q2" vid="PSA 130:5">hau nia aan tomak hein hela Nia;</para>
  <para style="q2" vid="PSA 130:5">hau konfia Nia liafuan.<verse eid="PSA 130:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6" />Hau laran metin hodi hein Nai Maromak,</para>
  <para style="q2" vid="PSA 130:6">liu fali ema seguransa hein loro matan sae;</para>
  <para style="q2" vid="PSA 130:6">liu fali ema seguransa hein atu rai loron lalais.<verse eid="PSA 130:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7" />Israel, laran metin ba NAI Maromak ba,</para>
  <para style="q2" vid="PSA 130:7">tanba NAI nia domin rohan-laek,</para>
  <para style="q2" vid="PSA 130:7">no Nia gosta teb-tebes atu salva ita.<verse eid="PSA 130:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">130:8 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 1:21">Mateus 1:21</ref>; <ref loc="TIT 2:14">Tito 2:14</ref></char>
    </note>Nia rasik sei halo ema Israel livre</para>
  <para style="q2" vid="PSA 130:8">husi sira nia sala hotu.<verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="s1">Laran metin ba Nai Maromak</para>
  <para style="d">Kantiku peregrinasaun husi David.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1" />NAI Maromak, hau la foti aan;</para>
  <para style="q2" vid="PSA 131:1">hau la gaba aan.</para>
  <para style="q1" vid="PSA 131:1">Hau la duni tuir buat nebee boot liu hau nia kapasidade,</para>
  <para style="q2" vid="PSA 131:1">ka buat nebee aas liu mai hau.<verse eid="PSA 131:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2" />Maibee hau kalma hela, hau hakmatek hela.</para>
  <para style="q2" vid="PSA 131:2">Hanesan bebee nebee susu bosu tiha hakmatek hela iha nia inan nia sorin,</para>
  <para style="q2" vid="PSA 131:2">hau mos hakmatek nunee.<verse eid="PSA 131:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3" />Israel oan sira, laran metin ba NAI Maromak ba,</para>
  <para style="q2" vid="PSA 131:3">agora too tinan ba tinan.<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="s">Nai Maromak nia promesa ba liurai David</para>
  <para style="d">Kantiku peregrinasaun nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1" />NAI Maromak, hanoin nafatin David ba;</para>
  <para style="q2" vid="PSA 132:1">keta haluha terus ho susar nebee nia hasoru.<verse eid="PSA 132:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2" />Nia jura ba NAI;</para>
  <para style="q2" vid="PSA 132:2">Nia halo ona juramentu ba Jacó nia Maromak Kbiit Nain dehan,<verse eid="PSA 132:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3" />“Hau sei la tama iha hau nia uma laran</para>
  <para style="q2" vid="PSA 132:3">ka deskansa iha hau nia toba fatin;<verse eid="PSA 132:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4" />hau sei halo hau nia matan lakan hela deit;</para>
  <para style="q2" vid="PSA 132:4">hau lakohi dukur,<verse eid="PSA 132:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5" />too hau hetan fatin ida ba NAI Maromak;</para>
  <para style="q2" vid="PSA 132:5">too hau hetan hela fatin ba Jacó nia Maromak Kbiit Nain.”<verse eid="PSA 132:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">132:6 </char>
      <char style="xt" closed="false">
        <ref loc="2CH 6:41">2 Krónikas 6:41</ref>,<ref loc="2CH 6:42">42</ref></char>
    </note>Iha rai Efrata ita rona kona ba kaixoti promesa nian;</para>
  <para style="q2" vid="PSA 132:6">ita hetan kaixoti nee iha rejiaun Jaar nian.<verse eid="PSA 132:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7" />Depois ita dehan, “Mai ita baa iha NAI nia hela fatin;</para>
  <para style="q2" vid="PSA 132:7">mai ita hakruuk iha Nia ain hodi adora Nia.”<verse eid="PSA 132:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8" />NAI Maromak, hamriik ba hodi tama iha Ita Boot nia fatin deskansa;</para>
  <para style="q2" vid="PSA 132:8">lori ho kaixoti promesa nian, ida nee hatudu sai Ita Boot nia kbiit.<verse eid="PSA 132:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9" />Hau harohan atu Ita Boot nia nai lulik sira hatais lia loos,</para>
  <para style="q2" vid="PSA 132:9">no Ita Boot nia povu santu hananu haksolok.<verse eid="PSA 132:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10" />Keta fila kotuk ba liurai nebee Ita Boot hili ona,</para>
  <para style="q2" vid="PSA 132:10">tanba Ita Boot promete tiha ona ba Ita Boot nia atan David.<verse eid="PSA 132:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">132:11 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 7:12-16">2 Samuel 7:12-16</ref>; <ref loc="1CH 17:11-14">1 Krónikas 17:11-14</ref>; <ref loc="PSA 89:3">Salmu 89:3</ref>,<ref loc="PSA 89:4">4</ref>; <ref loc="ACT 2:30">Apostolu sira nia Istoria 2:30</ref></char>
    </note>NAI Maromak jura tiha ona ba David;</para>
  <para style="q2" vid="PSA 132:11">Nia jura ho lo-loos, no sei la dada fila fali. Nia dehan,</para>
  <para style="q1" vid="PSA 132:11">“Hau sei foti o nia oan ida</para>
  <para style="q2" vid="PSA 132:11">hodi sai liurai iha o nia fatin.<verse eid="PSA 132:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12" />Se o nia oan sira kaer metin hau nia promesa</para>
  <para style="q2" vid="PSA 132:12">no halo tuir lei nebee Hau hanorin ba sira,</para>
  <para style="q1" vid="PSA 132:12">entaun sira nia oan sira mos sei tuur</para>
  <para style="q2" vid="PSA 132:12">hodi ukun iha o nia fatin tinan ba tinan.”<verse eid="PSA 132:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13" />NAI Maromak hili tiha ona Siaun;</para>
  <para style="q2" vid="PSA 132:13">Nia hakarak sidade nee sai Nia hela fatin. Nia dehan,<verse eid="PSA 132:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14" />“Ida nee Hau nia fatin deskansa tinan ba tinan;</para>
  <para style="q2" vid="PSA 132:14">Hau sei hela iha nee tanba Hau nia hakarak mak nee duni.<verse eid="PSA 132:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15" />Hau sei haraik bensaun ba sidade nee too ai haan nakonu;</para>
  <para style="q2" vid="PSA 132:15">Hau sei foo ai haan ba ema kiak sira haan too bosu.<verse eid="PSA 132:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16" />Nai lulik sira iha sidade nee, Hau sei foo hatais ho salvasaun;</para>
  <para style="q2" vid="PSA 132:16">povu santu nebee hela iha sidade nee sei hananu haksolok.<verse eid="PSA 132:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">132:17 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 11:36">1 Liurai 11:36</ref>
      </char>
    </note>Iha sidade nee Hau sei foo kbiit ba David;</para>
  <para style="q2" vid="PSA 132:17">Hau sei halo nia ahi oan lakan beibeik tanba Hau mak hili nia sai liurai.<verse eid="PSA 132:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18" />Hau sei halo nia inimigu sira moe boot,</para>
  <para style="q2" vid="PSA 132:18">maibee liurai nia koroa sei nabilan.”<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="s1">Moris iha unidade nia laran buat furak ida</para>
  <para style="d">Kantiku peregrinasaun husi David.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1" />Bainhira maluk sira moris neon ida laran ida,</para>
  <para style="q2" vid="PSA 133:1">nee diak no furak teb-tebes.<verse eid="PSA 133:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2" />Unidade nee hanesan mina folin karun nian</para>
  <para style="q2" vid="PSA 133:2">nebee fui ba iha nai lulik boot Arão nia ulun;</para>
  <para style="q1" vid="PSA 133:2">mina nee suli tuun ba iha nia hasan rahun;</para>
  <para style="q2" vid="PSA 133:2">suli too kona nia batina nia gola.<verse eid="PSA 133:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3" />Unidade nee hanesan mahobeen foho Hermon nian</para>
  <para style="q2" vid="PSA 133:3">nebee turu tuun ba iha foho Siaun.</para>
  <para style="q1" vid="PSA 133:3">Tanba iha foho Siaun nee NAI Maromak hatuun Nia bensaun,</para>
  <para style="q2" vid="PSA 133:3">moris tinan ba tinan.<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="s">Hahii Nai Maromak iha oras kalan</para>
  <para style="d">Kantiku peregrinasaun nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1" />NAI Maromak nia atan hotu-hotu, hahii NAI ba;</para>
  <para style="q2" vid="PSA 134:1">imi nebee serbi iha NAI nia uma iha oras kalan, hahii NAI ba.<verse eid="PSA 134:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2" />Foti sae imi nia liman iha fatin santu</para>
  <para style="q2" vid="PSA 134:2">hodi hahii NAI.<verse eid="PSA 134:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3" />NAI Maromak mak kria lalehan ho rai;</para>
  <para style="q2" vid="PSA 134:3">hau harohan atu husi foho Siaun Nia haraik bensaun ba imi.<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="s1">Kantiku hahii Nai Maromak</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1" />Hahii NAI Maromak!</para>
  <para style="b" vid="PSA 135:1" />
  <para style="q1" vid="PSA 135:1">Hahii NAI nia naran;</para>
  <para style="q2" vid="PSA 135:1">NAI nia atan sira, hahii Nia ba.<verse eid="PSA 135:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2" />Imi nebee halao knaar iha NAI nia uma,</para>
  <para style="q2" vid="PSA 135:2">iha ita nia Maromak nia uma kreda laran, hahii Nia ba.<verse eid="PSA 135:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3" />Hahii NAI Maromak tanba NAI nee diak;</para>
  <para style="q2" vid="PSA 135:3">hananu hahii Nia naran, tanba nee buat furak ida.<verse eid="PSA 135:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4" />Tanba NAI hili ona Jacó atu sai Ninian;</para>
  <para style="q2" vid="PSA 135:4">Nia hili povu Israel sai nudar Nia riku-soin rasik.<verse eid="PSA 135:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5" />Hau hatene katak NAI Maromak nee boot;</para>
  <para style="q2" vid="PSA 135:5">ita nia Nai nee boot liu maromak sel-seluk.<verse eid="PSA 135:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6" />NAI halo saida deit tuir Nia hakarak,</para>
  <para style="q2" vid="PSA 135:6">iha lalehan no iha rai,</para>
  <para style="q2" vid="PSA 135:6">iha tasi leten no mos iha tasi okos.<verse eid="PSA 135:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7" />Nia halo kalohan mosu husi rai ulun too rai ikun iha mundu tomak;</para>
  <para style="q2" vid="PSA 135:7">Nia haruka rai lakan akompanha udan;</para>
  <para style="q2" vid="PSA 135:7">Nia lori sai anin husi Nia armazen laran.<verse eid="PSA 135:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8" />Nia oho dasa tiha ema Ejitu nia oan mane boot;</para>
  <para style="q2" vid="PSA 135:8">ema nia oan primeiru ho mos animal nia oan primeiru, Nia oho hotu.<verse eid="PSA 135:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9" />Imi ema Ejitu, uluk Nia haruka Nia sinal ho milagre ba iha imi nia klaran</para>
  <para style="q2" vid="PSA 135:9">hodi kontra imi nia liurai ho nia atan sira hotu.<verse eid="PSA 135:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10" />Nia hamonu nasaun barak</para>
  <para style="q2" vid="PSA 135:10">hodi oho liurai bo-boot,<verse eid="PSA 135:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11" />hanesan Sihon, ema Amori nia liurai,</para>
  <para style="q2" vid="PSA 135:11">Og, rai Basán nia liurai,</para>
  <para style="q2" vid="PSA 135:11">ho liurai hotu-hotu iha rai Kanaán.<verse eid="PSA 135:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12" />Nia foo rai nee ba Nia povu Israel</para>
  <para style="q2" vid="PSA 135:12">nudar sira nia riku-soin.<verse eid="PSA 135:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13" />NAI Maromak, Ita Boot nia naran dura tinan ba tinan;</para>
  <para style="q2" vid="PSA 135:13">NAI, Ita Boot nia naran sei temi beibeik husi jerasaun ba jerasaun.<verse eid="PSA 135:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14" />Tanba NAI sei foo justisa ba Nia povu;</para>
  <para style="q2" vid="PSA 135:14">Nia sei hanoin Nia atan sira.<verse eid="PSA 135:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15" />
    <note caller="+" style="x">
      <char style="xo" closed="false">135:15 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 115:4-8">Salmu 115:4-8</ref>; <ref loc="REV 9:20">Apokalipse 9:20</ref></char>
    </note>Nasaun jentiu sira adora fali estatua lulik</para>
  <para style="q2" vid="PSA 135:15">nebee ema kriatura mak halo husi osan mean ho osan mutin.<verse eid="PSA 135:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16" />Iha ibun maibee la bele koalia,</para>
  <para style="q2" vid="PSA 135:16">iha matan maibee la bele haree.<verse eid="PSA 135:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17" />Iha tilun maibee la bele rona,</para>
  <para style="q2" vid="PSA 135:17">no la iha iis sai husi sira nia ibun.<verse eid="PSA 135:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18" />Ema nebee kria estatua lulik sira nee, sira sai hanesan fali buat nebee sira kria nee;</para>
  <para style="q2" vid="PSA 135:18">ema nebee fiar ba estatua sira nee mos sei sai nunee hotu.<verse eid="PSA 135:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19" />Israel oan sira, hahii NAI ba;</para>
  <para style="q2" vid="PSA 135:19">Arão nia jerasaun sira, hahii NAI ba;<verse eid="PSA 135:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20" />Levi nia jerasaun sira, hahii NAI ba;</para>
  <para style="q2" vid="PSA 135:20">imi sira nebee hamtauk NAI, hahii NAI ba.<verse eid="PSA 135:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21" />Hahii NAI iha Siaun,</para>
  <para style="q2" vid="PSA 135:21">iha Nia hela fatin Jerusalém.</para>
  <para style="b" vid="PSA 135:21" />
  <para style="q1" vid="PSA 135:21">Hahii NAI Maromak!<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="s1">Nai Maromak nia domin ba povu Israel</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">136:1 </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:34">1 Krónikas 16:34</ref>; <ref loc="2CH 5:13">2 Krónikas 5:13</ref>, <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Esdras 3:11</ref>; <ref loc="PSA 100:5">Salmu 100:5</ref>, <ref loc="PSA 106:1">106:1</ref>, <ref loc="PSA 107:1">107:1</ref>, <ref loc="PSA 118:1">118:1</ref>; <ref loc="JER 33:11">Jeremias 33:11</ref></char>
    </note>Foo agradese ba NAI Maromak, tanba Nia nee diak;</para>
  <para style="q2" vid="PSA 136:1">Nia domin dura tinan ba tinan.<verse eid="PSA 136:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2" />Foo agradese ba maromak sel-seluk nia Maromak;</para>
  <para style="q2" vid="PSA 136:2">Nia domin dura tinan ba tinan.<verse eid="PSA 136:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3" />Foo agradese ba nai hotu-hotu nia Nai;</para>
  <para style="q2" vid="PSA 136:3">Nia domin dura tinan ba tinan.<verse eid="PSA 136:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4" />Nia mesak deit mak halo milagre bo-boot;</para>
  <para style="q2" vid="PSA 136:4">Nia domin dura tinan ba tinan.<verse eid="PSA 136:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">136:5 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:1">Jénesis 1:1</ref>
      </char>
    </note>Hodi Nia matenek, Nia halo lalehan;</para>
  <para style="q2" vid="PSA 136:5">Nia domin dura tinan ba tinan.<verse eid="PSA 136:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">136:6 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:2">Jénesis 1:2</ref>
      </char>
    </note>Nia hatuur mundu iha bee leten;</para>
  <para style="q2" vid="PSA 136:6">Nia domin dura tinan ba tinan.<verse eid="PSA 136:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">136:7 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:16">Jénesis 1:16</ref>
      </char>
    </note>Nia halo loro matan ho fulan hodi foo naroman;</para>
  <para style="q2" vid="PSA 136:7">Nia domin dura tinan ba tinan.<verse eid="PSA 136:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8" />Nia halo loro matan hodi domina tempu loron;</para>
  <para style="q2" vid="PSA 136:8">Nia domin dura tinan ba tinan.<verse eid="PSA 136:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9" />Nia halo fulan ho fitun hodi domina tempu kalan;</para>
  <para style="q2" vid="PSA 136:9">Nia domin dura tinan ba tinan.<verse eid="PSA 136:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">136:10 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:29">Ézodu 12:29</ref>
      </char>
    </note>Nia oho dasa tiha ema Ejitu nia oan mane boot sira;</para>
  <para style="q2" vid="PSA 136:10">Nia domin dura tinan ba tinan.<verse eid="PSA 136:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">136:11 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:51">Ézodu 12:51</ref>
      </char>
    </note>Nia lori povu Israel sai husi ema Ejitu nia klaran;</para>
  <para style="q2" vid="PSA 136:11">Nia domin dura tinan ba tinan.<verse eid="PSA 136:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12" />Hodi Nia liman forti, hodi Nia liman makaas, Nia lori sira sai;</para>
  <para style="q2" vid="PSA 136:12">Nia domin dura tinan ba tinan.<verse eid="PSA 136:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">136:13 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21-29">Ézodu 14:21-29</ref>
      </char>
    </note>Nia fera tiha Tasi Mean fahe ba rua;</para>
  <para style="q2" vid="PSA 136:13">Nia domin dura tinan ba tinan.<verse eid="PSA 136:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14" />Nia lori sai ema Israel liu husi tasi klaran;</para>
  <para style="q2" vid="PSA 136:14">Nia domin dura tinan ba tinan.<verse eid="PSA 136:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15" />Maibee Nia soe tiha liurai Ejitu ho nia militar sira ba iha Tasi Mean;</para>
  <para style="q2" vid="PSA 136:15">Nia domin dura tinan ba tinan.<verse eid="PSA 136:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16" />Nia lori Nia povu lao liu husi rai fuik maran;</para>
  <para style="q2" vid="PSA 136:16">Nia domin dura tinan ba tinan.<verse eid="PSA 136:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17" />Nia oho dasa tiha liurai bo-boot;</para>
  <para style="q2" vid="PSA 136:17">Nia domin dura tinan ba tinan.<verse eid="PSA 136:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18" />Nia oho tiha liurai nebee forti;</para>
  <para style="q2" vid="PSA 136:18">Nia domin dura tinan ba tinan.<verse eid="PSA 136:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">136:19 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 21:21-30">Númerus 21:21-30</ref>
      </char>
    </note>Nia oho tiha Sihon, ema Amori nia liurai;</para>
  <para style="q2" vid="PSA 136:19">Nia domin dura tinan ba tinan.<verse eid="PSA 136:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20" />
    <note caller="+" style="x">
      <char style="xo" closed="false">136:20 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 21:31-35">Númerus 21:31-35</ref>
      </char>
    </note>Nia mos oho Og, ema Basán nia liurai;</para>
  <para style="q2" vid="PSA 136:20">Nia domin dura tinan ba tinan.<verse eid="PSA 136:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21" />Nia foo sira nia rai ba Nia povu nudar sira nia riku-soin;</para>
  <para style="q2" vid="PSA 136:21">Nia domin dura tinan ba tinan.<verse eid="PSA 136:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22" />Nia foo rai nee nudar riku-soin ba Nia atan Israel sira;</para>
  <para style="q2" vid="PSA 136:22">Nia domin dura tinan ba tinan.<verse eid="PSA 136:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23" />Nia hanoin ita bainhira ema hatuun ita;</para>
  <para style="q2" vid="PSA 136:23">Nia domin dura tinan ba tinan.<verse eid="PSA 136:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24" />Nia hasai ita husi ita nia inimigu sira nia liman laran;</para>
  <para style="q2" vid="PSA 136:24">Nia domin dura tinan ba tinan.<verse eid="PSA 136:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25" />Nia foo ai haan ba kriatura ida-idak;</para>
  <para style="q2" vid="PSA 136:25">Nia domin dura tinan ba tinan.<verse eid="PSA 136:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26" />Foo agradese ba Maromak iha lalehan;</para>
  <para style="q2" vid="PSA 136:26">Nia domin dura tinan ba tinan.<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="s">Israel oan sira halerik iha ema nia rain tanba Jerusalém rahun</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1" />Iha mota Babilónia nia ninin, ami tuur hodi tanis halerik</para>
  <para style="q2" vid="PSA 137:1">bainhira ami hanoin kona ba Siaun.<verse eid="PSA 137:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2" />Iha mota ninin nee ami tara ami nia viola</para>
  <para style="q2" vid="PSA 137:2">iha ai huun nia sanak.<verse eid="PSA 137:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3" />Tanba iha nebaa ema nebee halo ami dadur haruka ami kanta;</para>
  <para style="q2" vid="PSA 137:3">ema nebee halo ami terus obriga ami hananu knananuk ksolok nian;</para>
  <para style="q2" vid="PSA 137:3">sira haruka ami hananu kantiku ida kona ba Siaun iha sira nia oin.<verse eid="PSA 137:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4" />Oinsaa mak ami bele hananu ba NAI Maromak</para>
  <para style="q2" vid="PSA 137:4">durante ami iha hela ema nia rain?<verse eid="PSA 137:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5" />Jerusalém, se karik hau haluha o,</para>
  <para style="q2" vid="PSA 137:5">husik ba, hau nia liman loos nia forsa lakon tiha ba.<verse eid="PSA 137:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6" />Jerusalém, se karik hau la hanoin kona o,</para>
  <para style="q2" vid="PSA 137:6">se karik hau la konsidera o nudar ksolok ida nebee boot liu mai hau,</para>
  <para style="q2" vid="PSA 137:6">husik hau nia nanaal toos tiha iha hau nia ibun laran ba.<verse eid="PSA 137:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7" />NAI Maromak, keta haluha buat nebee mak ema Edom halo</para>
  <para style="q2" vid="PSA 137:7">iha loron nebee sidade Jerusalém monu.</para>
  <para style="q1" vid="PSA 137:7">Sira hakilar dehan, “Halo rahun tiha;</para>
  <para style="q2" vid="PSA 137:7">halo rahun too nia huun!”<verse eid="PSA 137:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">137:8 </char>
      <char style="xt" closed="false">
        <ref loc="REV 18:6">Apokalipse 18:6</ref>
      </char>
    </note>Babilónia oan sira, susar boot sei kona imi.</para>
  <para style="q2" vid="PSA 137:8">Ema nebee mak selu fali imi nia hahalok aat hasoru ami,</para>
  <para style="q2" vid="PSA 137:8">sira hetan ksolok.<verse eid="PSA 137:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9" />Ema nebee hadau imi nia oan kiik oan sira hodi riba ba fatuk,</para>
  <para style="q2" vid="PSA 137:9">sira hetan ksolok.<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="s1">Kantiku agradese tanba Nai Maromak nia tulun</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1" />NAI Maromak, ho laran tomak hau foo agradese ba Ita Boot;</para>
  <para style="q2" vid="PSA 138:1">iha maromak sel-seluk nia oin, hau hananu hahii Ita Boot.<verse eid="PSA 138:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2" />Hau see oin hakruuk ba iha Ita Boot nia fatin santu,</para>
  <para style="q2" vid="PSA 138:2">no hahii Ita Boot nia naran,</para>
  <para style="q1" vid="PSA 138:2">tanba Ita Boot nia domin rohan-laek no Ita Boot sempre kaer metin Ita Boot nia liafuan;</para>
  <para style="q2" vid="PSA 138:2">Ita Boot tane Ita Boot nia naran ho Ita Boot nia liafuan aas liu buat hotu-hotu.<verse eid="PSA 138:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3" />Bainhira hau halerik husu tulun, Ita Boot hataan hau;</para>
  <para style="q2" vid="PSA 138:3">Ita Boot nia kbiit halo hau aten brani.<verse eid="PSA 138:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4" />NAI Maromak, hau harohan atu liurai hotu-hotu iha mundu nee bele hahii Ita Boot</para>
  <para style="q2" vid="PSA 138:4">bainhira sira rona liafuan nebee sai husi Ita Boot nia ibun.<verse eid="PSA 138:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5" />Hau harohan atu sira hananu kona ba NAI nia dalan,</para>
  <para style="q2" vid="PSA 138:5">tanba NAI nia kbiit boot.<verse eid="PSA 138:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6" />Maski NAI iha leten aas ba, Nia haree diak ema kiik,</para>
  <para style="q2" vid="PSA 138:6">maibee ema foti aan sira, Nia konhese husi dook deit.<verse eid="PSA 138:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7" />Maski hau lao iha susar laran,</para>
  <para style="q2" vid="PSA 138:7">Ita Boot proteje hau nia vida.</para>
  <para style="q1" vid="PSA 138:7">Bainhira hau nia funu baluk sira hirus, Ita Boot nia liman kontra sira;</para>
  <para style="q2" vid="PSA 138:7">Ita Boot salva hau hodi Ita Boot nia liman loos.<verse eid="PSA 138:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8" />NAI, Ita Boot nia planu ba hau sei sai realidade;</para>
  <para style="q2" vid="PSA 138:8">Ita Boot nia domin dura tinan ba tinan;</para>
  <para style="q2" vid="PSA 138:8">NAI, keta husik hela Ita Boot nia liman fatin mes-mesak.<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="s">Orasaun ba Nai Maromak Matenek Nain</para>
  <para style="d">Salmu David nian, ba dirijenti koru. Kantiku.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1" />NAI Maromak, Ita Boot koko tiha ona hau,</para>
  <para style="q2" vid="PSA 139:1">no konhese hau mo-moos.<verse eid="PSA 139:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2" />Atu hau tuur ka hau hamriik, Ita Boot hatene hotu;</para>
  <para style="q2" vid="PSA 139:2">husi dook Ita Boot hatene hau nia hanoin.<verse eid="PSA 139:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3" />Atu hau lao ka hau toba, Ita Boot haree tuir;</para>
  <para style="q2" vid="PSA 139:3">Ita Boot hatene hau nia moris tomak.<verse eid="PSA 139:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4" />NAI, molok liafuan ruma sai husi hau nia ibun,</para>
  <para style="q2" vid="PSA 139:4">Ita Boot hatene hotu ona.<verse eid="PSA 139:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5" />Ita Boot besik loos hau husi oin no husi kotuk;</para>
  <para style="q2" vid="PSA 139:5">Ita Boot tula Ita Boot nia liman ba iha hau nia leten.<verse eid="PSA 139:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6" />Ita Boot konhese mo-moos hau nunee, furak teb-tebes mai hau;</para>
  <para style="q2" vid="PSA 139:6">matenek hanesan nee aas teb-tebes, hau la bele kompriende too iha nebaa.<verse eid="PSA 139:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7" />Hau tenki baa iha nebee atu bele haketak aan husi Ita Boot nia Espiritu?</para>
  <para style="q2" vid="PSA 139:7">Hau tenki halai baa iha nebee atu bele sees husi Ita Boot nia oin?<verse eid="PSA 139:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8" />Hau sae ba iha lalehan, Ita Boot iha nebaa;</para>
  <para style="q2" vid="PSA 139:8">hau halo hau nia toba fatin iha matebian sira nia fatin, Ita Boot iha nebaa.<verse eid="PSA 139:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9" />Se hau semo ba iha lorosae,</para>
  <para style="q2" vid="PSA 139:9">ka halo hau nia hela fatin iha tasi nia rohan ba,<verse eid="PSA 139:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10" />iha nebaa mos Ita Boot nia liman sei hatudu dalan mai hau;</para>
  <para style="q2" vid="PSA 139:10">Ita Boot nia liman loos kaer metin hau.<verse eid="PSA 139:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11" />Karik hau dehan, “Husik nakukun subar tiha hau;</para>
  <para style="q2" vid="PSA 139:11">husik naroman nebee haleu hau sai fali nakukun.”<verse eid="PSA 139:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12" />Maibee iha nakukun laran mos Ita Boot nia matan haree borus;</para>
  <para style="q2" vid="PSA 139:12">ba Ita Boot, kalan iha naroman hanesan fali loron nian;</para>
  <para style="q2" vid="PSA 139:12">ba Ita Boot, nakukun ho naroman hanesan deit.<verse eid="PSA 139:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13" />Ita Boot mak kria hau nia laran;</para>
  <para style="q2" vid="PSA 139:13">Ita Boot soru hau hamutuk iha hau nia inan nia kabun laran.<verse eid="PSA 139:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14" />Hau hahii Ita Boot tanba Ita Boot nee makaas;</para>
  <para style="q2" vid="PSA 139:14">hau rekonhese ho laran tomak katak,</para>
  <para style="q2" vid="PSA 139:14">Ita Boot nia liman fatin furak teb-tebes.<verse eid="PSA 139:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15" />Bainhira Ita Boot forma hau iha fatin segredu,</para>
  <para style="q2" vid="PSA 139:15">iha momentu Ita Boot suku hau iha hau nia inan nia kabun laran hanesan ema suku borda,</para>
  <para style="q2" vid="PSA 139:15">Ita Boot haree mo-moos hau nia ruin sira nee.<verse eid="PSA 139:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16" />Hau nia isin lolon seidauk forma hamutuk,</para>
  <para style="q2" vid="PSA 139:16">Ita Boot nia matan haree tiha ona hau.</para>
  <para style="q1" vid="PSA 139:16">Hau nia loron moris mai seidauk too,</para>
  <para style="q2" vid="PSA 139:16">loron hotu-hotu nebee Ita Boot atu foo mai hau, hakerek tiha ona iha Ita Boot nia livru.<verse eid="PSA 139:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17" />Maromak, Ita Boot nia hanoin, hau imajina la hetan;</para>
  <para style="q2" vid="PSA 139:17">Ita Boot nia ideia barak teb-tebes, sura la bele.<verse eid="PSA 139:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18" />Hau atu sura karik,</para>
  <para style="q2" vid="PSA 139:18">barak liu fali rai henek musan iha mundu;</para>
  <para style="q2" vid="PSA 139:18">bainhira hau hadeer, hau sei hamutuk nafatin ho Ita Boot.<verse eid="PSA 139:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19" />Maromak, hau hein atu Ita Boot hamate tiha ema aat sira.</para>
  <para style="q2" vid="PSA 139:19">Imi sira nebee hamrook ba raan, dook tiha husi hau.<verse eid="PSA 139:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20" />Sira koalia aat kona ba Ita Boot;</para>
  <para style="q2" vid="PSA 139:20">sira hatete aat Ita Boot nia naran.<verse eid="PSA 139:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21" />NAI, hau odi ema nebee mak odi Ita Boot;</para>
  <para style="q2" vid="PSA 139:21">hau hakribi ema nebee kontra Ita Boot.<verse eid="PSA 139:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22" />Hau odi loos sira;</para>
  <para style="q2" vid="PSA 139:22">hau konsidera sira nee hau nia inimigu.<verse eid="PSA 139:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23" />Maromak, koko hau hodi hatene tuir hau nia laran;</para>
  <para style="q2" vid="PSA 139:23">prova hau hodi hatene hau nia hanoin.<verse eid="PSA 139:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24" />Haree ba, keta hau halo buat aat ruma karik;</para>
  <para style="q2" vid="PSA 139:24">lori hau tuir dalan moris rohan-laek nian.<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="s">Orasaun husu atu Nai Maromak proteje</para>
  <para style="d">Salmu David nian, ba dirijenti koru.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1" />NAI Maromak, salva hau husi ema aat ba;</para>
  <para style="q2" vid="PSA 140:1">proteje hau husi ema nebee gosta violensia.<verse eid="PSA 140:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2" />Sira sempre hanoin aat;</para>
  <para style="q2" vid="PSA 140:2">loron-kalan sira sadik ema atu halo funu.<verse eid="PSA 140:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">140:3 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:13">Roma 3:13</ref>
      </char>
    </note>Sira halo sira nia liafuan kroat hodi hakanek ema hanesan samea nebee tata ema;</para>
  <para style="q2" vid="PSA 140:3">liafuan nebee sai husi sira nia ibun hanesan samodok nia veneno.<verse eid="PSA 140:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4" />NAI Maromak, kuidadu hau atu ema aat nia liman keta kona hau;</para>
  <para style="q2" vid="PSA 140:4">proteje hau husi ema nebee gosta violensia,</para>
  <para style="q2" vid="PSA 140:4">tanba sira kombina malu atu hamonu hau.<verse eid="PSA 140:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5" />Ema foti aan sira tau ona lasu mai hau;</para>
  <para style="q2" vid="PSA 140:5">sira nahe redi mai hau;</para>
  <para style="q2" vid="PSA 140:5">sira monta gaiola iha hau nia dalan.<verse eid="PSA 140:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6" />Hau hatete ba NAI, “Ita Boot mak hau nia Maromak.”</para>
  <para style="q2" vid="PSA 140:6">NAI, hau halerik husu tulun, rona hau ba.<verse eid="PSA 140:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7" />NAI, hau nia Maromak, Ita Boot nia kbiit makaas hodi salva hau;</para>
  <para style="q2" vid="PSA 140:7">Ita Boot taka hau nia ulun iha funu laran.<verse eid="PSA 140:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8" />NAI, keta foo dalan ba ema aat sira nia hakarak;</para>
  <para style="q2" vid="PSA 140:8">keta husik sira nia planu sai realidade, se lae sira sei foti aan.<verse eid="PSA 140:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9" />Ema nebee haleu hau foti sira nia ulun;</para>
  <para style="q2" vid="PSA 140:9">husik liafuan aat nebee sira hatete mai hau, fila fali ba sira.<verse eid="PSA 140:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10" />Halo ahi klaak monu tuun iha sira nia leten;</para>
  <para style="q2" vid="PSA 140:10">halo sira monu tama ba iha rai kuak klean, nunka atu sai fali.<verse eid="PSA 140:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11" />Hau hein katak sira nebee gosta hatete aat ema, la bele hela metin iha rai nee;</para>
  <para style="q2" vid="PSA 140:11">husik dezastre duni tuir ema nebee gosta violensia.<verse eid="PSA 140:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12" />Hau hatene katak NAI Maromak foo justisa lo-loos ba ema kbiit-laek</para>
  <para style="q2" vid="PSA 140:12">hodi defende ema kiak sira.<verse eid="PSA 140:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13" />Loos duni, ema nebee moris loos sei hahii Ita Boot nia naran;</para>
  <para style="q2" vid="PSA 140:13">ema nebee laran moos sei hela iha Ita Boot nia prezensa.<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="s">Orasaun bainhira iha tentasaun laran</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1" />NAI Maromak, hau harohan ba Ita Boot, mai lalais tulun hau;</para>
  <para style="q2" vid="PSA 141:1">rona hau nia lia halerik ba.<verse eid="PSA 141:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">141:2 </char>
      <char style="xt" closed="false">
        <ref loc="REV 5:8">Apokalipse 5:8</ref>
      </char>
    </note>Bainhira hau hasae orasaun ba Ita Boot,</para>
  <para style="q2" vid="PSA 141:2">simu ba nudar ai been morin;</para>
  <para style="q1" vid="PSA 141:2">bainhira hau hasae liman ba Ita Boot,</para>
  <para style="q2" vid="PSA 141:2">simu ba nudar oferta sakrifisiu iha oras kalan.<verse eid="PSA 141:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3" />NAI Maromak, tau seguransa ba hau nia ibun;</para>
  <para style="q2" vid="PSA 141:3">kontrola hau nia liafuan.<verse eid="PSA 141:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4" />Keta husik hau nia laran monu ba buat nebee la diak;</para>
  <para style="q2" vid="PSA 141:4">la bele husik hau mete hahalok aat</para>
  <para style="q1" vid="PSA 141:4">hamutuk ho ema nebee gosta halo buat aat;</para>
  <para style="q2" vid="PSA 141:4">hau lakohi tama iha sira nia festa hodi haan hamutuk ho sira.<verse eid="PSA 141:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5" />Se ema moris loos baku hau karik, nee hatudu domin;</para>
  <para style="q2" vid="PSA 141:5">se nia siak hau, nee hanesan kose mina ba hau nia ulun;</para>
  <para style="q1" vid="PSA 141:5">hau sei simu.</para>
  <para style="q2" vid="PSA 141:5">Maibee hau sempre halo orasaun kontra ema aat sira nia hahalok.<verse eid="PSA 141:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6" />Bainhira ema entrega sira ba iha juis atu hamonu kastigu ba sira,</para>
  <para style="q2" vid="PSA 141:6">ema aat sira sei rekonhese katak hau nia liafuan loos duni.<verse eid="PSA 141:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7" />Hanesan fatuk nebee ema baku rahun iha rai,</para>
  <para style="q2" vid="PSA 141:7">nunee mos sira nia ruin sei naklekar iha portaun rate nian.<note caller="+" style="f"><char style="fr" closed="false">141:5-7 </char><char style="ft" closed="false">Lian Ebreu iha versikulu nee la klaru.</char></note><verse eid="PSA 141:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8" />Maibee NAI Maromak Kbiit Nain, hau nia matan hateke nafatin ba Ita Boot;</para>
  <para style="q2" vid="PSA 141:8">hau hamahon aan iha Ita Boot, keta husik hau sai mate mean.<verse eid="PSA 141:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9" />Kuidadu hau husi lasu nebee ema aat tau ona mai hau;</para>
  <para style="q2" vid="PSA 141:9">proteje hau husi gaiola nebee sira monta ba hau.<verse eid="PSA 141:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10" />Husik ema aat monu tama ba sira nia redi rasik,</para>
  <para style="q2" vid="PSA 141:10">maibee hau lao liu ho livre.<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="s">Orasaun husu tulun</para>
  <para style="d">Salmu David nian para hanorin ema. Orasaun bainhira David iha fatuk kuak laran.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1" />Hau harohan ba NAI Maromak ho lian makaas;</para>
  <para style="q2" vid="PSA 142:1">hau hasae hau nia lian ba NAI hodi husu Nia tulun.<verse eid="PSA 142:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2" />Hau fakar sai hau nia lia halerik iha Nia oin;</para>
  <para style="q2" vid="PSA 142:2">hau konta hau nia susar ba Nia.<verse eid="PSA 142:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3" />Bainhira hau lakon esperansa,</para>
  <para style="q2" vid="PSA 142:3">Ita Boot hatene tuir hau nia moris.</para>
  <para style="q1" vid="PSA 142:3">Iha dalan nebee hau lao tuir,</para>
  <para style="q2" vid="PSA 142:3">ema subar lasu ba hau.<verse eid="PSA 142:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4" />Haree ba, la iha ema ida iha hau nia liman loos;</para>
  <para style="q2" vid="PSA 142:4">la iha ema ida interese mai hau;</para>
  <para style="q1" vid="PSA 142:4">la iha tan subar fatin ba hau;</para>
  <para style="q2" vid="PSA 142:4">la iha ema ida hanoin hau.<verse eid="PSA 142:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5" />NAI Maromak, hau halerik husu tulun ba Ita Boot;</para>
  <para style="q2" vid="PSA 142:5">hau dehan, “Ita Boot mak hau nia fatin seguru;</para>
  <para style="q2" vid="PSA 142:5">Ita Boot mak hau nia riku-soin iha mundu nee.”<verse eid="PSA 142:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6" />Rona hau nia lia halerik ba,</para>
  <para style="q2" vid="PSA 142:6">tanba hau la bele liu ona;</para>
  <para style="q1" vid="PSA 142:6">salva hau husi ema nebee duni tuir hau,</para>
  <para style="q2" vid="PSA 142:6">tanba sira forsa liu hau.<verse eid="PSA 142:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7" />Hasai hau husi dadur laran,</para>
  <para style="q2" vid="PSA 142:7">atu hau bele hahii Ita Boot nia naran.</para>
  <para style="q1" vid="PSA 142:7">Depois ema moris loos sei mai hodi haleu hau,</para>
  <para style="q2" vid="PSA 142:7">tanba Ita Boot haree hau diak.<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="s">Orasaun husu tulun</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1" />NAI Maromak, rona hau nia orasaun;</para>
  <para style="q2" vid="PSA 143:1">see tilun ba hau nia halerik, tanba Ita Boot sempre kaer metin Ita Boot nia liafuan;</para>
  <para style="q2" vid="PSA 143:1">hataan hau ba, tanba Ita Boot sempre halo buat nebee loos.<verse eid="PSA 143:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">143:2 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:20">Roma 3:20</ref>; <ref loc="GAL 2:16">Galásia 2:16</ref></char>
    </note>Keta haruka hau ata hataan iha Ita Boot nia oin kona ba sala nebee hau halo tiha ona,</para>
  <para style="q2" vid="PSA 143:2">tanba la iha ema ida mak moris loos iha Ita Boot nia futar oin.<verse eid="PSA 143:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3" />Inimigu sira duni tuir hau;</para>
  <para style="q2" vid="PSA 143:3">sira sama hau ba rai;</para>
  <para style="q2" vid="PSA 143:3">sira dadur hau iha fatin nakukun</para>
  <para style="q2" vid="PSA 143:3">hanesan fali ema nebee mak mate kleur ona.<verse eid="PSA 143:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4" />Nunee hau lakon esperansa;</para>
  <para style="q2" vid="PSA 143:4">hau nia laran tauk teb-tebes.<verse eid="PSA 143:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5" />Hau hanoin fila fali tempu uluk nian;</para>
  <para style="q2" vid="PSA 143:5">hau reflete Ita Boot nia servisu hotu;</para>
  <para style="q2" vid="PSA 143:5">hau medita saida mak Ita Boot nia liman halo tiha ona.<verse eid="PSA 143:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6" />Hau hasae hau nia liman halo orasaun ba Ita Boot;</para>
  <para style="q2" vid="PSA 143:6">hau hamrook ba Ita Boot hanesan rai maran dekor nebee hamrook ba udan been.<verse eid="PSA 143:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7" />NAI Maromak, hataan hau lalais ba;</para>
  <para style="q2" vid="PSA 143:7">hau nia esperansa lakon ba dadauk.</para>
  <para style="q1" vid="PSA 143:7">Keta subar Ita Boot nia oin mai hau;</para>
  <para style="q2" vid="PSA 143:7">se lae hau sei hanesan ema nebee mak lao tuun dadauk ba rai kuak.<verse eid="PSA 143:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8" />Dadeer-dadeer foo hanoin mai hau kona ba Ita Boot nia domin rohan-laek,</para>
  <para style="q2" vid="PSA 143:8">tanba hau laran metin ba Ita Boot.</para>
  <para style="q1" vid="PSA 143:8">Hatudu dalan nebee mak hau atu lao tuir,</para>
  <para style="q2" vid="PSA 143:8">tanba hau entrega hau nia moris ba Ita Boot.<verse eid="PSA 143:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9" />NAI Maromak, salva hau husi hau nia inimigu sira,</para>
  <para style="q2" vid="PSA 143:9">tanba hau helik aan iha Ita Boot.<verse eid="PSA 143:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10" />Hanorin hau atu halo tuir Ita Boot nia hakarak,</para>
  <para style="q2" vid="PSA 143:10">tanba Ita Boot mak hau nia Maromak.</para>
  <para style="q1" vid="PSA 143:10">Ita Boot nia Espiritu laran diak;</para>
  <para style="q2" vid="PSA 143:10">haruka Nia lori hau ba iha rai tetuk.<verse eid="PSA 143:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11" />NAI Maromak, kuidadu hau nia moris atu ema foti aas Ita Boot nia naran;</para>
  <para style="q2" vid="PSA 143:11">hasai hau husi susar laran, tanba Ita Boot sempre halo buat nebee loos.<verse eid="PSA 143:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12" />Ita Boot hadomi teb-tebes hau, nunee halo hau nia inimigu sira nonook tiha ba;</para>
  <para style="q2" vid="PSA 143:12">halo rahun tiha hau nia funu baluk sira,</para>
  <para style="q2" vid="PSA 143:12">tanba hau nee Ita Boot nia atan.<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="s">Liurai agradese Nai Maromak tanba manaan funu</para>
  <para style="d">Salmu David nian.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1" />Hahii NAI Maromak, Nia mak fatuk lolon boot nebee satan netik hau;</para>
  <para style="q2" vid="PSA 144:1">Nia mak treinu hau nia liman atu halo funu;</para>
  <para style="q2" vid="PSA 144:1">Nia treinu hau nia liman fuan atu kaer kroat.<verse eid="PSA 144:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2" />Nia nee hau nia Maromak Domin Nain, Nia mak lutu haleu hau,</para>
  <para style="q2" vid="PSA 144:2">hau nia abrigu no hau nia Salvador.</para>
  <para style="q1" vid="PSA 144:2">Nia mak defende hau, no hau hamahon aan iha Nia;</para>
  <para style="q2" vid="PSA 144:2">Nia halo nasaun sira seluk hakruuk mai hau.<verse eid="PSA 144:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">144:3 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 7:17">Job 7:17</ref>,<ref loc="JOB 7:18">18</ref>; <ref loc="PSA 8:4">Salmu 8:4</ref></char>
    </note>NAI Maromak, ami ema kriatura nee see loos, too Ita Boot hanoin ami?</para>
  <para style="q2" vid="PSA 144:3">Ami ema kbiit-laek nee see loos, too Ita Boot interese ami?<verse eid="PSA 144:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4" />Ami nee hanesan fali anin nebee huu liu deit;</para>
  <para style="q2" vid="PSA 144:4">ami nia moris hanesan lalatak nebee liu lalais deit.<verse eid="PSA 144:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5" />NAI Maromak, loke Ita Boot nia lalehan hodi tuun mai;</para>
  <para style="q2" vid="PSA 144:5">kaer kona foho, atu nunee foho suar sai.<verse eid="PSA 144:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6" />Haruka rai lakan hodi halo inimigu sira halai namkari;</para>
  <para style="q2" vid="PSA 144:6">hana Ita Boot nia rama oan halo sira halai lakon.<verse eid="PSA 144:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7" />Husi leten aas ba hatuun Ita Boot nia liman mai</para>
  <para style="q2" vid="PSA 144:7">hodi hasai hau husi bee boot laran;</para>
  <para style="q2" vid="PSA 144:7">salva hau husi inimigu rai liur sira nia liman laran.<verse eid="PSA 144:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8" />Tanba sira nia ibun nakonu ho buat bosok;</para>
  <para style="q2" vid="PSA 144:8">sira foti liman hodi halo juramentu falsu.<verse eid="PSA 144:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9" />Maromak, hau sei hananu kantiku foun ba Ita Boot;</para>
  <para style="q2" vid="PSA 144:9">hau sei toka muzika ba Ita Boot ho viola tali sanulu.<verse eid="PSA 144:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10" />Ita Boot mak halo liurai manaan;</para>
  <para style="q2" vid="PSA 144:10">Ita Boot salva Ita Boot nia atan David.<verse eid="PSA 144:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11" />Salva hau husi surik nebee hamate ema;</para>
  <para style="q2" vid="PSA 144:11">hasai hau husi inimigu rai liur nia liman laran.</para>
  <para style="q1" vid="PSA 144:11">Sira nia ibun nakonu ho buat bosok;</para>
  <para style="q2" vid="PSA 144:11">sira foti liman hodi halo juramentu falsu.<verse eid="PSA 144:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12" />Ami harohan atu ami nia oan mane joven sira</para>
  <para style="q2" vid="PSA 144:12">sai hanesan ai huun nebee buras ba dadauk,</para>
  <para style="q1" vid="PSA 144:12">no ami nia oan feto sira</para>
  <para style="q2" vid="PSA 144:12">sai hanesan ai riin palasiu nian nebee bahat tiha halo furak.<verse eid="PSA 144:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13" />Ami husu atu ami nia armazen nakonu</para>
  <para style="q2" vid="PSA 144:13">ho ai haan oi-oin,</para>
  <para style="q1" vid="PSA 144:13">ami nia bibi aumenta rihun ba rihun,</para>
  <para style="q2" vid="PSA 144:13">tokon ba tokon iha ami nia rai,<verse eid="PSA 144:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 144:14" />no ami nia karau kabuk todan.</para>
  <para style="q1" vid="PSA 144:14">Ami harohan atu inimigu sira la bele baku rahun moru nebee haleu ami nia sidade,</para>
  <para style="q2" vid="PSA 144:14">inimigu sira la bele lori ami baa dadur iha rai seluk,</para>
  <para style="q2" vid="PSA 144:14">no la iha tanis halerik iha ami nia estrada boot.<verse eid="PSA 144:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15" />Povu nebee mak moris hanesan nee, sira hetan ksolok;</para>
  <para style="q2" vid="PSA 144:15">povu nebee adora NAI nudar sira nia Maromak, sira hetan ksolok.<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="s">Hahii Nai Maromak tanba Nia laran diak</para>
  <para style="d">Salmu hahii nian husi David.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1" />Hau nia Maromak, hau nia Liurai, hau sei foti aas Ita Boot;</para>
  <para style="q2" vid="PSA 145:1">hau sei hahii Ita Boot nia naran too tinan ba tinan.<verse eid="PSA 145:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2" />Loro-loron hau sei hahii Ita Boot;</para>
  <para style="q2" vid="PSA 145:2">hau sei tane aas Ita Boot nia naran tinan ba tinan.<verse eid="PSA 145:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3" />NAI Maromak nee boot, Nia serve atu ita hahii;</para>
  <para style="q2" vid="PSA 145:3">Nia boot teb-tebes, la iha ida mak bele kompriende too iha nebaa.<verse eid="PSA 145:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4" />Jerasaun ida sei gaba Ita Boot nia servisu ba jerasaun tuir mai;</para>
  <para style="q2" vid="PSA 145:4">sira konta tutan buat boot nebee Ita Boot halo.<verse eid="PSA 145:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5" />Hau sei foo sai Ita Boot nia naran boot ho kbiit nebee furak;</para>
  <para style="q2" vid="PSA 145:5">hau sei medita buat furak nebee Ita Boot halo tiha ona.<verse eid="PSA 145:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6" />Sira sei konta buat makaas nebee Ita Boot halo;</para>
  <para style="q2" vid="PSA 145:6">hau sei foo sai katak Ita Boot nee makaas teb-tebes.<verse eid="PSA 145:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7" />Sira selebra Ita Boot nia laran osan mean,</para>
  <para style="q2" vid="PSA 145:7">no haksolok hananu kona ba Ita Boot nia lia loos.<verse eid="PSA 145:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8" />NAI Maromak nee laran luak no laran diak;</para>
  <para style="q2" vid="PSA 145:8">Nia Pasiensia Nain, no nakonu ho domin rohan-laek.<verse eid="PSA 145:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9" />NAI diak ba ema hotu-hotu;</para>
  <para style="q2" vid="PSA 145:9">Nia hadomi buat hotu nebee Nia kria ona.<verse eid="PSA 145:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10" />NAI, Ita Boot nia liman fatin sei agradese ba Ita Boot;</para>
  <para style="q2" vid="PSA 145:10">Ita Boot nia povu santu sei hahii Ita Boot.<verse eid="PSA 145:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11" />Sira foo sai Ita Boot nia kbiit boot nudar Liurai,</para>
  <para style="q2" vid="PSA 145:11">no konta kona ba Ita Boot nia forsa,<verse eid="PSA 145:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12" />atu nunee ema hotu bele hatene buat makaas nebee Ita Boot halo,</para>
  <para style="q2" vid="PSA 145:12">no Ita Boot nia ukun makaas ho furak teb-tebes.<verse eid="PSA 145:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13" />Ita Boot mak Liurai tinan ba tinan;</para>
  <para style="q2" vid="PSA 145:13">Ita Boot ukun husi jerasaun ba jerasaun.</para>
  <para style="b" vid="PSA 145:13" />
  <para style="q1" vid="PSA 145:13">NAI Maromak sempre kaer metin Nia promesa;</para>
  <para style="q2" vid="PSA 145:13">Ninia hahalok tomak nakonu ho domin.<verse eid="PSA 145:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14" />NAI tane ema nebee monu ba susar laran;</para>
  <para style="q2" vid="PSA 145:14">Nia foti sae ema nebee bonko tanba naha todan.<verse eid="PSA 145:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15" />Kriatura hotu-hotu nia matan hateke ba Ita Boot,</para>
  <para style="q2" vid="PSA 145:15">atu Ita Boot foo ai haan ba sira tuir nia tempu.<verse eid="PSA 145:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16" />Ita Boot loke liman,</para>
  <para style="q2" vid="PSA 145:16">buat moris hotu-hotu hetan ai haan too bosu.<verse eid="PSA 145:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17" />NAI halo saida deit sempre loos;</para>
  <para style="q2" vid="PSA 145:17">Ninia hahalok tomak nakonu ho domin.<verse eid="PSA 145:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18" />NAI besik ema nebee harohan ba Nia;</para>
  <para style="q2" vid="PSA 145:18">Nia besik ba see-see deit mak harohan ba Nia ho laran.<verse eid="PSA 145:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19" />Nia hataan ema nebee hamtauk Nia tuir sira nia hakarak;</para>
  <para style="q2" vid="PSA 145:19">Nia rona sira nia halerik hodi salva sira.<verse eid="PSA 145:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20" />NAI tau matan ba ema hotu nebee hadomi Nia,</para>
  <para style="q2" vid="PSA 145:20">maibee Nia sei halo rahun tiha ema aat sira hotu.<verse eid="PSA 145:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21" />Hau nia ibun sei hahii NAI Maromak;</para>
  <para style="q2" vid="PSA 145:21">kriatura ida-idak hahii Nia naran santu</para>
  <para style="q2" vid="PSA 145:21">tinan ba tinan.<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="s">Hahii Nai Maromak tanba Nia diak</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1" />Hahii NAI Maromak!</para>
  <para style="b" vid="PSA 146:1" />
  <para style="q1" vid="PSA 146:1">Hau hatete ba hau nia aan, hahii NAI ba!<verse eid="PSA 146:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 146:2" />Iha hau nia moris tomak, hau sei hahii NAI;</para>
  <para style="q2" vid="PSA 146:2">durante hau sei moris hau hananu hahii hau nia Maromak.<verse eid="PSA 146:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3" />Lalika tau laran ba ukun nain sira;</para>
  <para style="q2" vid="PSA 146:3">keta tau fiar ba ema kriatura, tanba sira la bele salva ema.<verse eid="PSA 146:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4" />Bainhira sira nia iis kotu, sira fila fali ba rai rahun;</para>
  <para style="q2" vid="PSA 146:4">iha loron nee kedas, sira nia planu mos mate ona.<verse eid="PSA 146:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5" />Ema nebee rekonhese Jacó nia Maromak nudar sira nia Ajudador,</para>
  <para style="q2" vid="PSA 146:5">ema nebee laran metin ba NAI nudar sira nia Maromak, sira hetan ksolok.<verse eid="PSA 146:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">146:6 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 4:24">Apostolu sira nia Istoria 4:24</ref>, <ref loc="ACT 14:15">14:15</ref></char>
    </note>Nia mak Kriador lalehan ho rai,</para>
  <para style="q2" vid="PSA 146:6">tasi ho buat hotu iha laran;</para>
  <para style="q2" vid="PSA 146:6">Nia kaer metin Nia liafuan too tinan ba tinan.<verse eid="PSA 146:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7" />Nia foo justisa ba sira nebee ema seluk hanehan;</para>
  <para style="q2" vid="PSA 146:7">Nia foo ai haan ba sira nebee hamlaha.</para>
  <para style="b" vid="PSA 146:7" />
  <para style="q1" vid="PSA 146:7">NAI hasai dadur sira;<verse eid="PSA 146:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 146:8" />NAI halo ema matan delek bele haree;</para>
  <para style="q1" vid="PSA 146:8">NAI foti sae ema nebee bonko tanba naha todan;</para>
  <para style="q2" vid="PSA 146:8">NAI hadomi ema nebee moris loos.<verse eid="PSA 146:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9" />NAI tau matan ba ema lao rai;</para>
  <para style="q2" vid="PSA 146:9">Nia tulun oan kiak ho feto faluk sira,</para>
  <para style="q2" vid="PSA 146:9">maibee Nia halo kleuk tiha ema aat sira nia dalan.<verse eid="PSA 146:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10" />NAI Maromak ukun tinan ba tinan;</para>
  <para style="q2" vid="PSA 146:10">Siaun oan sira, imi nia Maromak ukun husi jerasaun ba jerasaun.</para>
  <para style="b" vid="PSA 146:10" />
  <para style="q1" vid="PSA 146:10">Hahii NAI Maromak!<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="s1">Salmu hahii Nai Maromak</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1" />Hahii NAI Maromak!</para>
  <para style="b" vid="PSA 147:1" />
  <para style="q1" vid="PSA 147:1">Ita hananu hahii ita nia Maromak, nee diak no furak teb-tebes,</para>
  <para style="q2" vid="PSA 147:1">tanba Nia serve duni atu ita hahii.<verse eid="PSA 147:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2" />NAI Maromak harii fali Jerusalém;</para>
  <para style="q2" vid="PSA 147:2">Nia halibur fila fali Israel oan sira nebee ema soe ba iha rai seluk.<verse eid="PSA 147:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3" />Nia kura ema nebee laran dodok,</para>
  <para style="q2" vid="PSA 147:3">no kurtivu sira nia kanek.<verse eid="PSA 147:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4" />Nia desidi fitun hira mak iha lalehan</para>
  <para style="q2" vid="PSA 147:4">hodi foo naran ba fitun ida-idak.<verse eid="PSA 147:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5" />Ita nia Nai nee boot ho kbiit makaas;</para>
  <para style="q2" vid="PSA 147:5">Nia matenek la iha rohan.<verse eid="PSA 147:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6" />NAI Maromak foti sae ema mukit,</para>
  <para style="q2" vid="PSA 147:6">maibee soe ema aat tuun ba iha rai.<verse eid="PSA 147:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7" />Hananu kantiku agradese nian ba NAI Maromak;</para>
  <para style="q2" vid="PSA 147:7">toka viola halo muzika ba ita nia Maromak.<verse eid="PSA 147:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8" />Nia hodi kalohan taka lalehan;</para>
  <para style="q2" vid="PSA 147:8">Nia foo udan ba rai</para>
  <para style="q2" vid="PSA 147:8">hodi halo duut moris iha foho leten.<verse eid="PSA 147:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9" />Nia foo ai haan ba animal</para>
  <para style="q2" vid="PSA 147:9">ho mos ba manu metan oan nebee lian hodi husu ai haan.<verse eid="PSA 147:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10" />Laos kuda nia forsa mak halo kontenti NAI nia laran;</para>
  <para style="q2" vid="PSA 147:10">Nia laos haksolok tanba funu nain nebee forti.<verse eid="PSA 147:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11" />Maibee NAI kontenti ho ema nebee mak hamtauk Nia;</para>
  <para style="q2" vid="PSA 147:11">Nia haksolok ho ema nebee mak laran metin ba Nia domin rohan-laek.<verse eid="PSA 147:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12" />Jerusalém, tane aas NAI Maromak ba;</para>
  <para style="q2" vid="PSA 147:12">Siaun, hahii o nia Maromak ba.<verse eid="PSA 147:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13" />Tanba Nia haforsa o nia portaun boot,</para>
  <para style="q2" vid="PSA 147:13">no foo bensaun ba o nia povu.<verse eid="PSA 147:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14" />Nia halo o nia fronteira seguru,</para>
  <para style="q2" vid="PSA 147:14">no habosu o nia povu ho hahaan diak nian.<verse eid="PSA 147:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15" />Nia hatuun Nia orden ba iha rai;</para>
  <para style="q2" vid="PSA 147:15">Nia liafuan semo lalais liu.<verse eid="PSA 147:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16" />Nia kari neve<note caller="+" style="f"><char style="fr" closed="false">147:16 </char><char style="ft" closed="false">Neve ho lian Indonézia dehan “salju”.</char></note> hanesan bibi fulun mutin;</para>
  <para style="q2" vid="PSA 147:16">Nia halo namkari jelu fatuk rahun hanesan ahu kdesan.<verse eid="PSA 147:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17" />Nia tuda tuun udan jelu fatuk hanesan britas.</para>
  <para style="q2" vid="PSA 147:17">See mak bele aguenta malirin boot nebee Nia hatuun nee?<verse eid="PSA 147:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18" />Nia foo orden mak jelu nee nabeen;</para>
  <para style="q2" vid="PSA 147:18">Nia haruka anin mak bee suli tuun.<verse eid="PSA 147:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19" />Nia foo sai Nia liafuan ba Jacó nia jerasaun;</para>
  <para style="q2" vid="PSA 147:19">Nia hatuun Nia lei ho regulamentu ba Israel.<verse eid="PSA 147:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20" />Nia nunka halo nunee ba nasaun sel-seluk;</para>
  <para style="q2" vid="PSA 147:20">sira la hatene Nia lei.</para>
  <para style="b" vid="PSA 147:20" />
  <para style="q1" vid="PSA 147:20">Hahii NAI Maromak!<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="s">Lalehan ho rai hahii Nai Maromak ba!</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1" />Hahii NAI Maromak!</para>
  <para style="b" vid="PSA 148:1" />
  <para style="q1" vid="PSA 148:1">Imi nebee iha lalehan, hahii NAI Maromak ba;</para>
  <para style="q2" vid="PSA 148:1">buat hotu iha leten aas ba, hahii Nia ba.<verse eid="PSA 148:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2" />Maromak nia anju sira hotu, hahii Nia;</para>
  <para style="q2" vid="PSA 148:2">tropas lalehan nian, hahii Nia ba.<verse eid="PSA 148:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3" />Loro matan ho fulan, hahii Nia;</para>
  <para style="q2" vid="PSA 148:3">fitun sira hotu nebee lakan nabilan, hahii Nia ba.<verse eid="PSA 148:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4" />Lalehan leten aas ba, hahii Nia,</para>
  <para style="q2" vid="PSA 148:4">nunee mos bee hotu iha kalohan leten.<verse eid="PSA 148:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5" />Buat sira nee hotu hahii NAI Maromak nia naran ba,</para>
  <para style="q2" vid="PSA 148:5">tanba Nia foo orden mak buat sira nee iha.<verse eid="PSA 148:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6" />Nia harii buat sira nee nafatin ba nafatin;</para>
  <para style="q2" vid="PSA 148:6">orden nebee Nia foo nee vale tinan ba tinan.<verse eid="PSA 148:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7" />Buat hotu-hotu iha mundu, hahii NAI Maromak ba!</para>
  <para style="q2" vid="PSA 148:7">Tasi laran klean ho animal bo-boot tasi nian,<verse eid="PSA 148:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8" />rai lakan ho udan jelu fatuk, neve ho abu-abu,</para>
  <para style="q2" vid="PSA 148:8">anin boot makaas nebee halao Nia orden,<verse eid="PSA 148:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9" />foho bo-boot ho foho kiik sira hotu,</para>
  <para style="q2" vid="PSA 148:9">ai nebee foo fuan ho ai huun sedru hotu-hotu,<verse eid="PSA 148:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10" />animal fuik ho karau hotu-hotu,</para>
  <para style="q2" vid="PSA 148:10">animal nebee dolar iha rai ho mos manu fuik,<verse eid="PSA 148:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11" />liurai mundu nian ho povu nasaun hotu-hotu,</para>
  <para style="q2" vid="PSA 148:11">liurai oan sira ho ukun nain sira hotu iha mundu,<verse eid="PSA 148:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12" />mane klosan ho feto klosan sira,</para>
  <para style="q2" vid="PSA 148:12">ferik-katuas ho labarik sira.<verse eid="PSA 148:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13" />Hotu-hotu hahii NAI Maromak nia naran ba,</para>
  <para style="q2" vid="PSA 148:13">tanba Nia naran boot liu hotu-hotu;</para>
  <para style="q2" vid="PSA 148:13">Nia kbiit aas liu lalehan ho rai.<verse eid="PSA 148:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14" />Nia halo Nia povu sai forti tiha,</para>
  <para style="q2" vid="PSA 148:14">atu sira bele hahii Nia.</para>
  <para style="q1" vid="PSA 148:14">Sira nee mak ema nebee foo laran ba Nia;</para>
  <para style="q2" vid="PSA 148:14">sira nee ema Israel, ema nebee besik Nia.</para>
  <para style="b" vid="PSA 148:14" />
  <para style="q1" vid="PSA 148:14">Hahii NAI Maromak!<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="s">Kantiku hahii Nai Maromak tanba Nia tulun Israel</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1" />Hahii NAI Maromak!</para>
  <para style="b" vid="PSA 149:1" />
  <para style="q1" vid="PSA 149:1">Hananu kantiku foun ba NAI Maromak;</para>
  <para style="q2" vid="PSA 149:1">hahii Nia iha Nia povu santu sira nia klaran.<verse eid="PSA 149:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2" />Israel oan sira, kontenti ba, tanba Nia mak ita nia Kriador;</para>
  <para style="q2" vid="PSA 149:2">Siaun oan sira, haksolok ba, tanba Nia mak ita nia Liurai.<verse eid="PSA 149:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3" />Mai ita bidu hodi hahii Nia naran;</para>
  <para style="q2" vid="PSA 149:3">mai ita baku tambor ho toka viola hodi halo muzika ba Nia,<verse eid="PSA 149:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4" />tanba NAI Maromak nia laran haksolok ho Nia povu;</para>
  <para style="q2" vid="PSA 149:4">Nia tane aas ema mukit sira hodi halo sira manaan.<verse eid="PSA 149:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5" />Maromak nia povu santu, mai ita haksolok tanba Nia foti aas ita;</para>
  <para style="q2" vid="PSA 149:5">mai ita hananu haksolok iha ita nia toba fatin.<verse eid="PSA 149:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6" />Ita nia ibun sei hahii Maromak;</para>
  <para style="q2" vid="PSA 149:6">ita nia liman kaer surik oin-kotuk kroat hotu<verse eid="PSA 149:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7" />hodi selu fali nasaun jentiu sira nia hahalok aat,</para>
  <para style="q2" vid="PSA 149:7">no kastigu sira nia povu;<verse eid="PSA 149:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8" />atu kesi sira nia liurai ho korenti;</para>
  <para style="q2" vid="PSA 149:8">atu futu sira nia nai ulun sira ho korenti besi,<verse eid="PSA 149:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9" />atu kastigu nasaun sira nee tuir desizaun nebee Maromak hatuun tiha ona.</para>
  <para style="q2" vid="PSA 149:9">Ho nunee Nia povu santu sai naran boot.</para>
  <para style="b" vid="PSA 149:9" />
  <para style="q1" vid="PSA 149:9">Hahii NAI Maromak!<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="s">Knananuk hahii Nai Maromak</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1" />Hahii NAI Maromak!</para>
  <para style="b" vid="PSA 150:1" />
  <para style="q1" vid="PSA 150:1">Hahii Maromak iha Nia fatin santu;</para>
  <para style="q2" vid="PSA 150:1">hahii Nia iha Nia lalehan aas nebaa.<verse eid="PSA 150:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2" />Hahii Nia tanba Nia halo buat mesak furak;</para>
  <para style="q2" vid="PSA 150:2">hahii Nia tanba Nia boot liu buat hotu-hotu.<verse eid="PSA 150:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3" />Huu karau dikur hodi hahii Nia;</para>
  <para style="q2" vid="PSA 150:3">toka viola oi-oin hodi hahii Nia.<verse eid="PSA 150:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4" />Baku tambor no bidu hodi hahii Nia;</para>
  <para style="q2" vid="PSA 150:4">toka viola no huu fafulu hodi hahii Nia.<verse eid="PSA 150:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5" />Baku taxu hodi hahii Nia;</para>
  <para style="q2" vid="PSA 150:5">baku taxu halo lian boot hodi hahii Nia.<verse eid="PSA 150:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6" />Buat hotu-hotu nebee iha iis, hahii NAI Maromak ba.</para>
  <para style="b" vid="PSA 150:6" />
  <para style="q1" vid="PSA 150:6">Hahii NAI Maromak!<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>