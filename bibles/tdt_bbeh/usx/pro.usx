<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- ATG BSA Training 1</book>
  <para style="h">Provérbiu</para>
  <para style="toc3">Prov</para>
  <para style="toc2">Provérbiu</para>
  <para style="toc1">Provérbiu</para>
  <para style="mt1">Provérbiu</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s">Objetivu lia matenek iha livru nee</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />Lia matenek husi Salomão, liurai Israel, David nia oan:<verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />Lia matenek nee atu forma ema hodi sai matenek;</para>
  <para style="q2" vid="PRO 1:2">atu ema bele kompriende hanorin nebee klean;<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />atu hanorin ema para bele moris iha matenek nia laran</para>
  <para style="q2" vid="PRO 1:3">hodi moris loos, kaer metin justisa no halo buat nebee loos;<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />atu foo treinu ba ema nebee la iha esperiensia moris para bele sai matenek;</para>
  <para style="q2" vid="PRO 1:4">atu halo joven sira bele aprende buat oi-oin no hatene oinsaa atu foti desizaun.<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />Ema nebee matenek ona, rona ba hodi aprende liu tan;</para>
  <para style="q2" vid="PRO 1:5">lia matenek nee mos sai matadalan ba ema nebee kompriende klean ona.<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />Liafuan nee atu tulun ema kompriende lia matenek ho komparasaun,</para>
  <para style="q2" vid="PRO 1:6">atu hatene tuir matenek nain nia liafuan hodi siik liafuan nebee sira falun.<verse eid="PRO 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />Matenek nia huun mai husi hamtauk NAI Maromak,</para>
  <para style="q2" vid="PRO 1:7">maibee ema beik-teen hakribi fali matenek no lakohi simu bainhira ema eduka sira.<verse eid="PRO 1:7" /></para>
  <para style="s1">Keta halo belun ho ema aat</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />Oan, rona bainhira o nia aman eduka o;</para>
  <para style="q2" vid="PRO 1:8">la bele fila kotuk bainhira o nia inan hanorin o.<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />Ami nia liafuan nee hanesan ai funan furak nebee haleu o nia ulun;</para>
  <para style="q2" vid="PRO 1:9">hanesan korenti furak hodi hahenu iha o nia kakorok.<verse eid="PRO 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />Oan, bainhira ema aat hakarak dada o ba buat aat,</para>
  <para style="q2" vid="PRO 1:10">lalika halo tuir.<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />Karik sira dehan, “Mai tuir ami;</para>
  <para style="q2" vid="PRO 1:11">ita baa hafuhu ema iha dalan atu fakar nia raan;</para>
  <para style="q2" vid="PRO 1:11">ita baa subar para oho arbiru ema nebee la sala.<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />Ita tolan sira moris, hanesan rate tolan ema;</para>
  <para style="q2" vid="PRO 1:12">sira isin diak hela, ita halo sira tuun ba iha rai kuak.<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />Ita sei hetan sasaan oi-oin nebee folin boot;</para>
  <para style="q2" vid="PRO 1:13">ita sei hakonu ita nia uma ho sasaan nebee ita hadau.<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />Mai tama hamutuk ho ami,</para>
  <para style="q2" vid="PRO 1:14">depois sasaan nebee mak ita hadau, ita sei fahe ba malu.”<verse eid="PRO 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />Oan, keta lao tuir ema sira nee nia dalan;</para>
  <para style="q2" vid="PRO 1:15">la bele sama sira nia ain fatin.<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />Tanba sira nia ain hakat lalais hodi halo buat aat;</para>
  <para style="q2" vid="PRO 1:16">sira sempre prontu halo ema nia raan fakar.<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />Se karik manu fuik haree hela ita monta redi ba nia,</para>
  <para style="q2" vid="PRO 1:17">ita monta saugati deit.<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />Maibee ema sira nee hafuhu ema iha dalan atu fakar nia raan, afinal sira fakar sira nia raan rasik;</para>
  <para style="q2" vid="PRO 1:18">sira subar atu oho ema, afinal sira oho sira nia aan rasik.<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />See mak gosta manaan matak deit, sira nia destinu sei sai nunee;</para>
  <para style="q2" vid="PRO 1:19">riku-soin nebee sira hadau nee mak sei halakon sira nia vida.<verse eid="PRO 1:19" /></para>
  <para style="s">Matenek kompara ho senhora ida nebee bolu ema</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />Matenek nee hanesan senhora ida nebee bolu ho lian makaas iha estrada boot;</para>
  <para style="q2" vid="PRO 1:20">nia hasae nia lian iha merkadu;<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />nia bolu atensaun iha fatin publiku;</para>
  <para style="q2" vid="PRO 1:21">iha portaun sidade nian, nia koalia nunee:<verse eid="PRO 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />“Imi nebee nar-naran tuir ema, imi hakarak tuir arbiru deit too bainhira?</para>
  <para style="q2" vid="PRO 1:22">Imi goza door sira, imi kaan atu goza ema too bainhira?</para>
  <para style="q2" vid="PRO 1:22">Imi beik-teen sira, imi lakohi hatene buat ida too bainhira?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />See tilun mai bainhira hau koriji imi,</para>
  <para style="q2" vid="PRO 1:23">depois hau sei foo sai ba imi buat nebee iha hau nia laran;</para>
  <para style="q2" vid="PRO 1:23">hau sei foo hatene hau nia hanoin ba imi.<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />Hau bolu tiha ona imi, maibee imi lakohi rona;</para>
  <para style="q2" vid="PRO 1:24">hau lolo hau nia liman hodi konvida imi, maibee la iha ema ida mak interese.<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />Hau foo hanoin hela deit, imi lakohi foo atensaun;</para>
  <para style="q2" vid="PRO 1:25">hau koriji imi, imi lakohi simu.<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26-27" style="v" sid="PRO 1:26-27" />Entaun bainhira imi hetan susar boot,</para>
  <para style="q2" vid="PRO 1:26-27">hau mos sei hamnasa fali imi.</para>
  <para style="q1" vid="PRO 1:26-27">Bainhira dezastre halo imi nakdoko;</para>
  <para style="q2" vid="PRO 1:26-27">bainhira dezastre mai hanesan anin fuik hodi doko imi,</para>
  <para style="q2" vid="PRO 1:26-27">ka susar kona imi hanesan anin boot;</para>
  <para style="q1" vid="PRO 1:26-27">bainhira terus ho susar baa iha imi nia leten,</para>
  <para style="q2" vid="PRO 1:26-27">hau sei goza fali imi.<verse eid="PRO 1:26-27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />Depois ema sira nee sei bolu hau, maibee hau sei la hataan;</para>
  <para style="q2" vid="PRO 1:28">sira buka hau tuun-sae, maibee sira la hetan.<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />Sira lakohi aprende matenek,</para>
  <para style="q2" vid="PRO 1:29">no lakohi hamtauk NAI Maromak;<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />hau foo hanoin hela deit sira, sira lakohi simu;</para>
  <para style="q2" vid="PRO 1:30">hau koriji sira, sira lakohi rona.<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />Nunee sira nia hahalok rasik sei foo todan ba sira;</para>
  <para style="q2" vid="PRO 1:31">sira nia hanoin aat rasik sei lori terus ba sira.<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />See mak nar-naran tuir ema sei mate tanba sees aan husi hau;</para>
  <para style="q2" vid="PRO 1:32">ema beik-teen sira sei lakon mohu tanba sira la interese buat ida.<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />Maibee ema nebee mak rona hau, sei moris seguru;</para>
  <para style="q2" vid="PRO 1:33">sira sei hakmatek, no la tauk atu susar kona sira.”<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s">Matenek nee folin boot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />Oan, se o simu hau nia liafuan</para>
  <para style="q2" vid="PRO 2:1">hodi rai hau nia regra iha o nia laran;<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />se o loke tilun ba lia matenek</para>
  <para style="q2" vid="PRO 2:2">hodi foo laran atu kompriende;<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />se o husu atu bele hetan matenek;</para>
  <para style="q2" vid="PRO 2:3">se o husu ho lian makaas atu bele kompriende klean;<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />se o buka matenek hanesan ema buka osan mutin;</para>
  <para style="q2" vid="PRO 2:4">se o buka tuir hanesan ema buka tuir riku-soin nebee subar hela,<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />entaun o sei hatene hamtauk NAI Maromak;</para>
  <para style="q2" vid="PRO 2:5">o sei aprende konhese di-diak Maromak.<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />Tanba NAI mak foo matenek;</para>
  <para style="q2" vid="PRO 2:6">liafuan nebee sai husi Nia ibun halo ita hatene no kompriende buat barak.<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />Nia rai hela matenek ba ema nebee moris loos;</para>
  <para style="q2" vid="PRO 2:7">Nia defende ema nebee lao tuir dalan loos.<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />Nia kuidadu ema moris loos nia dalan;</para>
  <para style="q2" vid="PRO 2:8">Nia proteje ema nebee foo laran ba Nia.<verse eid="PRO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />Nunee o sei kompriende lia loos, justisa ho hahalok loos;</para>
  <para style="q2" vid="PRO 2:9">o sei hatene dalan diak hotu-hotu.<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />Tanba matenek sei tama iha o nia neon;</para>
  <para style="q2" vid="PRO 2:10">konhesimentu sei halo o nia laran kontenti.<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />O sei seguru tanba o hatene foti desizaun;</para>
  <para style="q2" vid="PRO 2:11">o sei la monu tanba o kompriende klean.<verse eid="PRO 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />Nunee o sei lao sees husi ema aat nia dalan,</para>
  <para style="q2" vid="PRO 2:12">husi ema lohi door.<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />Sira nee husik tiha dalan loos</para>
  <para style="q2" vid="PRO 2:13">hodi tuir fali dalan nakukun nian.<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />Sira gosta loos halo sala;</para>
  <para style="q2" vid="PRO 2:14">sira kontenti teb-tebes ho hahalok nebee aat;<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />sira nia lalaok kleuk;</para>
  <para style="q2" vid="PRO 2:15">sira nia hahalok lohi door.<verse eid="PRO 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />Matenek sei halo o livre husi feto aat,</para>
  <para style="q2" vid="PRO 2:16">husi feto ulun bulak nebee koalia liafuan mesak midar.<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />Feto nee husik tiha mane nebee nia kaben bainhira sei joven;</para>
  <para style="q2" vid="PRO 2:17">nia la kumpri ona juramentu nebee nia halo iha Maromak nia oin.<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />See mak tama iha feto nee nia uma, lao tuir dalan mate nian;</para>
  <para style="q2" vid="PRO 2:18">nia dalan lori ema ba iha matebian sira nia fatin.<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />See-see deit mak baa iha feto nee nia uma, nunka atu fila fali;</para>
  <para style="q2" vid="PRO 2:19">sira sei la hetan tan dalan moris.<verse eid="PRO 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />Nee duni o tenki lao tuir ema diak nia dalan;</para>
  <para style="q2" vid="PRO 2:20">lao tuir nafatin ema moris loos nia ain fatin.<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />Tanba ema moris loos mak sei moris iha rai nee;</para>
  <para style="q2" vid="PRO 2:21">ema nebee la iha sala, nia mak sei hela metin iha rai.<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />Maibee ema aat sei lakon mohu tiha husi rai nee;</para>
  <para style="q2" vid="PRO 2:22">traidor sira nia abut sei fokit sai tiha.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s">Matenek halo ita moris diak</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />Oan, keta haluha hau nia hanorin;</para>
  <para style="q2" vid="PRO 3:1">rai di-diak hau nia regra iha o nia laran.<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />Tanba buat sira nee mak sei halo o nia vida naruk,</para>
  <para style="q2" vid="PRO 3:2">no foo moris diak ba o.<verse eid="PRO 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />Kaer metin domin ho lia loos;</para>
  <para style="q2" vid="PRO 3:3">hahenu buat sira nee iha o nia kakorok;</para>
  <para style="q2" vid="PRO 3:3">hakerek buat sira nee iha o nia laran.<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:4 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 2:52">Lucas 2:52</ref>
      </char>
    </note>Nunee Maromak sei kontenti ho o, ema mos sei gosta,</para>
  <para style="q2" vid="PRO 3:4">no o sei hetan naran diak.<verse eid="PRO 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />Fiar ba NAI Maromak ho o nia laran tomak;</para>
  <para style="q2" vid="PRO 3:5">keta sadere ba o nia matenek rasik.<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />O halao buat saida deit, rekonhese Nia</para>
  <para style="q2" vid="PRO 3:6">mak Nia sei haloos o nia dalan.<verse eid="PRO 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />La bele konsidera o nia aan rasik ema matenek;</para>
  <para style="q2" vid="PRO 3:7">hamtauk NAI no hadook aan husi hahalok aat.<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />Nunee o sei iha saude diak;</para>
  <para style="q2" vid="PRO 3:8">o nia ruin sira sei forti.<verse eid="PRO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />Oferese o nia riku-soin ba NAI hodi tane aas Nia naran;</para>
  <para style="q2" vid="PRO 3:9">foo rezultadu toos nian primeiru ba Nia.<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />Nunee o nia armazen sei nakonu too resin,</para>
  <para style="q2" vid="PRO 3:10">no o nia tua fatin sei nakonu ho tua foun too suli sai.<verse eid="PRO 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:11 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 5:17">Job 5:17</ref>
      </char>
    </note>
    <note caller="+" style="x">
      <char style="xo" closed="false">3:11 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 12:5">Ebreu 12:5</ref>,<ref loc="HEB 12:6">6</ref></char>
    </note>Oan, keta fila kotuk bainhira NAI koriji o;</para>
  <para style="q2" vid="PRO 3:11">keta laran susar bainhira Nia hasee o.<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:12 </char>
      <char style="xt" closed="false">
        <ref loc="REV 3:19">Apokalipse 3:19</ref>
      </char>
    </note>Tanba NAI koriji ema nebee mak Nia hadomi,</para>
  <para style="q2" vid="PRO 3:12">hanesan aman ida koriji nia oan doben.<verse eid="PRO 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />Ema nebee sai matenek;</para>
  <para style="q2" vid="PRO 3:13">ema nebee kompriende klean, nia hetan bensaun.<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />Tanba matenek vale liu osan mutin,</para>
  <para style="q2" vid="PRO 3:14">no diak liu fali osan mean.<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />Matenek folin boot liu morteen;</para>
  <para style="q2" vid="PRO 3:15">saida deit mak o hakarak hetan, la iha ida mak bele kompara ho matenek.<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />Vida naruk iha hela matenek nia liman loos;</para>
  <para style="q2" vid="PRO 3:16">riku-soin no respeitu iha hela nia liman karuk.<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />Matenek nia dalan furak,</para>
  <para style="q2" vid="PRO 3:17">nakonu ho pas ho hakmatek.<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />Matenek nee hanesan ai huun nebee foo moris ba ema nebee kaer metin nia,</para>
  <para style="q2" vid="PRO 3:18">see mak kaer metin matenek, sira sei hetan bensaun.<verse eid="PRO 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />Hodi matenek, NAI harii mundu nia alsesu;</para>
  <para style="q2" vid="PRO 3:19">ho konhesimentu mak Nia hatuur lalehan iha nia fatin.<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />Hodi matenek, Nia halo bee matan sira nakfera hodi suli ba iha rai,</para>
  <para style="q2" vid="PRO 3:20">no kalohan hatuun mahobeen.<verse eid="PRO 3:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />Oan, kaer metin matenek, sempre uza kakutak hodi foti desizaun;</para>
  <para style="q2" vid="PRO 3:21">keta husik buat sira nee dook husi o.<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />Nunee matenek sei halo o moris naruk,</para>
  <para style="q2" vid="PRO 3:22">no sai nudar buat murak mean nebee hahenu iha o nia kakorok.<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />O sei lao ho seguru;</para>
  <para style="q2" vid="PRO 3:23">o nia ain sei la sidi.<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />Bainhira o latan aan iha o nia toba fatin, o sei la tauk buat ida;</para>
  <para style="q2" vid="PRO 3:24">bainhira o toba, o sei toba ho hakmatek.<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />Lalika tauk atu hetan dezastre derepenti;</para>
  <para style="q2" vid="PRO 3:25">lalika tauk ba dezastre nebee akontese ba ema aat sira.<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />Tanba NAI Maromak mak o nia sadere fatin;</para>
  <para style="q2" vid="PRO 3:26">Nia sei hasees tiha o nia ain husi lasu.<verse eid="PRO 3:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />Se ema merese atu simu buat diak ruma husi o,</para>
  <para style="q2" vid="PRO 3:27">no o bele foo, foo deit ba.<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />Se o nia maluk husu buat ruma nebee o iha,</para>
  <para style="q2" vid="PRO 3:28">keta dehan, “Fila ba, aban mai fali mak hau foo.”<verse eid="PRO 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />Keta hanoin aat ba o nia vizinhu,</para>
  <para style="q2" vid="PRO 3:29">tanba nia hela besik o no laran metin ba o.<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />Se ema la halo buat aat ba o,</para>
  <para style="q2" vid="PRO 3:30">keta duun matak nia.<verse eid="PRO 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />Keta laran moras ba ema nebee gosta violensia;</para>
  <para style="q2" vid="PRO 3:31">keta halo tuir sira nia hahalok.<verse eid="PRO 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />Tanba NAI hakribi ema nebee lao sees husi dalan loos,</para>
  <para style="q2" vid="PRO 3:32">maibee Nia sai belun diak ho ema nebee laran moos.<verse eid="PRO 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />NAI nia malisan iha hela ema aat nia uma laran,</para>
  <para style="q2" vid="PRO 3:33">maibee ema moris loos nia uma, Nia foo bensaun.<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />NAI hatuun fali ema nebee gosta hatuun ema seluk,</para>
  <para style="q2" vid="PRO 3:34">maibee Nia hatudu laran diak ba ema nebee haraik aan.<verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />Ema nebee matenek sei hetan respeitu,</para>
  <para style="q2" vid="PRO 3:35">maibee ema beik-teen sei hetan naran aat.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s">Matenek nee folin boot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />Oan sira, rona imi nia aman nia hanorin;</para>
  <para style="q2" vid="PRO 4:1">foo atensaun di-diak para imi kompriende klean.<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />Tanba hau foo lisaun nebee diak ba imi,</para>
  <para style="q2" vid="PRO 4:2">nunee keta fila kotuk ba hau nia hanorin.<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />Uluk hau sei kiik, iha hau nia aman nia uma,</para>
  <para style="q2" vid="PRO 4:3">hau nia inan hadomi liu hau,<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />hau nia aman hanorin hau nunee:</para>
  <para style="q2" vid="PRO 4:4">“Rai di-diak hau nia liafuan iha o nia laran;</para>
  <para style="q2" vid="PRO 4:4">kaer metin hau nia regra mak o sei moris.<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />Sai matenek ba, buka atu kompriende klean;</para>
  <para style="q2" vid="PRO 4:5">keta haluha hau nia liafuan, no keta lao sees.<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />Keta fila kotuk ba matenek, nunee nia sei hamahon o;</para>
  <para style="q2" vid="PRO 4:6">hadomi nia mak nia sei tau matan ba o.<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />Matenek nee iha folin boot liu, nunee tenki hakaas aan atu kompriende;</para>
  <para style="q2" vid="PRO 4:7">o atu selu ho o nia riku-soin tomak mos, selu ba, para hetan matenek.<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />Estima matenek mak nia sei tane o aas;</para>
  <para style="q2" vid="PRO 4:8">hakuak matenek mak nia sei halo o nia naran morin.<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />Nia sei tau ai funan furak haleu o nia ulun;</para>
  <para style="q2" vid="PRO 4:9">nia sei tau koroa nabilan iha o nia ulun.”<verse eid="PRO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />Oan, rona mai, simu hau nia liafuan,</para>
  <para style="q2" vid="PRO 4:10">nunee o nia vida sei naruk.<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />Hau hanorin lalaok matenek nian ba o;</para>
  <para style="q2" vid="PRO 4:11">hau lori o tuir dalan nebee loos.<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />Bainhira o lao, buat ruma sei la taka o nia dalan;</para>
  <para style="q2" vid="PRO 4:12">bainhira o halai, o sei la sidi.<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />Kaer metin hau nia hanorin, keta husik;</para>
  <para style="q2" vid="PRO 4:13">rai di-diak, tanba hanorin nee sei foo moris ba o.<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />Keta hakat tuir ema aat sira nia ain fatin;</para>
  <para style="q2" vid="PRO 4:14">keta lao tuir ema aat nia dalan.<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />Hadook aan husi dalan nee, keta lao tuir;</para>
  <para style="q2" vid="PRO 4:15">sees tiha hodi lao ba oin.<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />Tanba sira toba la dukur bainhira sira seidauk halo buat aat;</para>
  <para style="q2" vid="PRO 4:16">sira nia matan dukur lakon bainhira sira seidauk halo ema sidi.<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />Sira nia ai haan mak hahalok aat;</para>
  <para style="q2" vid="PRO 4:17">sira nia tua mak violensia.<verse eid="PRO 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />Ema moris loos nia dalan naroman hanesan loro matan nebee foin sae;</para>
  <para style="q2" vid="PRO 4:18">naroman nee nabilan ba beibeik too meudia boot.<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />Maibee ema aat nia dalan hanesan nakukun teb-tebes;</para>
  <para style="q2" vid="PRO 4:19">sira la hatene saida mak halo sira sidi.<verse eid="PRO 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />Oan, foo atensaun ba hau nia liafuan;</para>
  <para style="q2" vid="PRO 4:20">see tilun ba buat nebee hau koalia.<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />Keta husik buat sira nee dook husi o nia matan;</para>
  <para style="q2" vid="PRO 4:21">rai nafatin iha o nia laran.<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />Tanba ema nebee kompriende ona liafuan nee sei hetan moris;</para>
  <para style="q2" vid="PRO 4:22">nia isin lolon tomak sei hetan saude diak.<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />Kuidadu o nia laran liu buat hotu-hotu,</para>
  <para style="q2" vid="PRO 4:23">tanba o nia laran mak diriji o nia moris.<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />Kuidadu o nia aan atu la bele koalia lia bosok;</para>
  <para style="q2" vid="PRO 4:24">kuidadu o nia ibun atu keta lohi ema.<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />Hateke beibeik ba oin;</para>
  <para style="q2" vid="PRO 4:25">halo o nia matan fihir ba oin nafatin.<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:26 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 12:13">Ebreu 12:13</ref>
      </char>
    </note>Fihir di-diak dalan nebee o atu lao tuir,</para>
  <para style="q2" vid="PRO 4:26">nunee o sei lao ba oin ho diak.<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />Keta lao sees husi dalan loos hodi lao fali iha sor-sorin;</para>
  <para style="q2" vid="PRO 4:27">kuidadu o nia ain atu la bele lao tuir dalan nebee aat.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">Keta halo sala ho ema nia feen</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />Oan, foo atensaun ba matenek nebee hau hanorin ba o;</para>
  <para style="q2" vid="PRO 5:1">hau kompriende klean saida mak hau hanorin, see tilun mai.<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />Nunee o sempre iha matenek hodi foti desizaun;</para>
  <para style="q2" vid="PRO 5:2">o sei koalia sukat o nia ibun.<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />Tanba feto aat nia ibun midar hanesan bani been;</para>
  <para style="q2" vid="PRO 5:3">nia liafuan kos-kose ema liu fali mina azeite.<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />Maibee too ikus feto nee sai moruk hanesan veneno;</para>
  <para style="q2" vid="PRO 5:4">kroat hanesan surik oin-kotuk kroat hotu.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />Nia ain tuun dadauk ba iha rai kuak;</para>
  <para style="q2" vid="PRO 5:5">nia lao hela ba iha matebian sira nia fatin.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />Nia la interese ba dalan moris nian;</para>
  <para style="q2" vid="PRO 5:6">nia lao hela iha dalan kleuk, maibee nia la hatene.<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />Nee duni, oan sira, rona mai;</para>
  <para style="q2" vid="PRO 5:7">keta tau hau nia liafuan ba kotuk.<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />Hadook tiha imi nia aan husi feto hanesan nee;</para>
  <para style="q2" vid="PRO 5:8">keta baa besik iha nia odamatan.<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />Se lae o nia naran sai aat iha ema nia matan,</para>
  <para style="q2" vid="PRO 5:9">no o entrega o nia vida joven ba ema laran aat;<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />ema leet bele goza fali o nia riku-soin,</para>
  <para style="q2" vid="PRO 5:10">no o nia kosar been tama ba iha ema seluk nia uma.<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />Too ikus o sei halerik,</para>
  <para style="q2" vid="PRO 5:11">tanba o nia isin lolon tomak atu mohu ona.<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />Depois o sei dehan, “Nusaa mak uluk ema hasee makaas hau, hau fila kotuk fali?</para>
  <para style="q2" vid="PRO 5:12">Nusaa mak hau nia laran la simu bainhira ema koriji hau?<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />Uluk hau lakohi rona hau nia mestri sira;</para>
  <para style="q2" vid="PRO 5:13">hau lakohi see tilun ba ema nebee hanorin hau.<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />Agora susar boot atu kona ona hau</para>
  <para style="q2" vid="PRO 5:14">iha ema lubun boot nia klaran hau moe liu.”<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />Hemu bee husi o nia buli rasik;</para>
  <para style="q2" vid="PRO 5:15">hemu bee fresku husi o nia posu rasik.<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />O hakarak o nia bee matan suli sai fali ba iha estrada ka?</para>
  <para style="q2" vid="PRO 5:16">O hakarak o nia bee dalan suli sai ba iha rai luan ka?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />Bee nee o nian mesak deit;</para>
  <para style="q2" vid="PRO 5:17">la bele fahe fali ba ema seluk.<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />O nia feen hanesan bee matan ba o, Maromak foo bensaun ba nia;</para>
  <para style="q2" vid="PRO 5:18">o kaben ho nia bainhira o sei joven, haksolok hamutuk ho nia ba.<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />Nia hanesan rusa inan ida nebee kapaas,</para>
  <para style="q2" vid="PRO 5:19">hanesan rusa nebee furak;</para>
  <para style="q1" vid="PRO 5:19">husik ninia bonita<note caller="+" style="f"><char style="fr" closed="false">5:19 </char><char style="ft" closed="false">Lian Ebreu dehan “nia susun”, tradusaun Septuaginta dehan “nia domin”. </char></note> sempre halo o kontenti;</para>
  <para style="q2" vid="PRO 5:19">nia domin ba o halo o nia laran haksolok nafatin.<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />Oan, nusaa mak o atu kaan fali feto ulun bulak?</para>
  <para style="q2" vid="PRO 5:20">Nusaa mak o atu toba fali ho ema seluk nia feen?<verse eid="PRO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />Keta haluha, ema ida-idak nia hahalok nakloke iha NAI Maromak nia oin;</para>
  <para style="q2" vid="PRO 5:21">NAI nia matan haree hela ema hotu nia dalan.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />Ema aat nia pekadu sai hanesan lasu ida ba nia aan;</para>
  <para style="q2" vid="PRO 5:22">ninia sala hanesan tali nebee kesi metin nia.<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />Nia hahalok beik-teen halo nia lao sala dalan;</para>
  <para style="q2" vid="PRO 5:23">nia sei mate tanba la hatene domina aan.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">Hanorin oi-oin</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />Oan, se karik o nia maluk deve ema nia osan, depois o mak responsabiliza;</para>
  <para style="q2" vid="PRO 6:1">se karik o kaer liman ona ho nia hodi promete atu taka tusan nee,<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />bele dehan o nia ibun rasik mak sai lasu ba o;</para>
  <para style="q2" vid="PRO 6:2">o nia liafuan rasik kesi ona o.<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />Oan, se nunee, o tenki kore o nia aan,</para>
  <para style="q2" vid="PRO 6:3">tanba o monu tiha ona ba iha o nia maluk nia liman laran.</para>
  <para style="q1" vid="PRO 6:3">Baa haraik aan iha o nia maluk nee nia oin</para>
  <para style="q2" vid="PRO 6:3">hodi husu atu bele kansela tiha o nia promesa.<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />Keta husik o nia matan dukur;</para>
  <para style="q2" vid="PRO 6:4">keta husik o nia aan toba dukur.<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />Hasai tiha o nia aan husi lasu nee hanesan bibi rusa nebee halai sai husi lasu laran,</para>
  <para style="q2" vid="PRO 6:5">hanesan manu fuik nebee semo sai husi kasador nia liman laran.<verse eid="PRO 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />Imi baruk-teen sira, baa haree took nehek</para>
  <para style="q2" vid="PRO 6:6">hodi aprende husi nia hahalok, atu imi sai matenek.<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />Maski nehek nee la iha nai ulun,</para>
  <para style="q2" vid="PRO 6:7">la iha xefi no la iha ukun nain,<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />maibee nia halibur hahaan ba nia aan iha tempu rai manas;</para>
  <para style="q2" vid="PRO 6:8">nia rai hamutuk ai haan iha tempu kolheta.<verse eid="PRO 6:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />Imi baruk-teen sira, imi atu toba too bainhira?</para>
  <para style="q2" vid="PRO 6:9">Bainhira mak imi atu hadeer fali husi imi nia toba fatin?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:10 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 24:33">Provérbiu 24:33</ref>,<ref loc="PRO 24:34">34</ref></char>
    </note>Imi dehan, “Hau toba uitoan lai, toba halimar lai,</para>
  <para style="q2" vid="PRO 6:10">hakuak liman hodi deskansa lai.”<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />Nunee kiak sei mosu mai derepenti hanesan naok-teen hodi asalta imi,</para>
  <para style="q2" vid="PRO 6:11">mukit sei mai hanesan ema kaer kroat hodi hadau imi nia riku-soin hotu.<verse eid="PRO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />Ema aat, ema nebee la iha valor,</para>
  <para style="q2" vid="PRO 6:12">nia lao lemo-lemo hodi habelar lia bosok,<verse eid="PRO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13" />nia piska matan,</para>
  <para style="q2" vid="PRO 6:13">foo sinal ho nia ain,</para>
  <para style="q2" vid="PRO 6:13">hatudu liman fuan,<verse eid="PRO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14" />nia laran makerek hodi halo planu aat,</para>
  <para style="q2" vid="PRO 6:14">no gosta provoka ema.<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />Nee mak dezastre kona nia derepenti</para>
  <para style="q2" vid="PRO 6:15">hodi harahun tiha nia, atu salva fali la bele ona.<verse eid="PRO 6:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16" />Iha buat neen mak NAI Maromak la simu liu;</para>
  <para style="q2" vid="PRO 6:16">iha hahalok hitu mak Nia hakribi:<verse eid="PRO 6:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 6:17" />matan nebee haree ema la vale,</para>
  <para style="q2" vid="PRO 6:17">ibun nebee lohi door,</para>
  <para style="q2" vid="PRO 6:17">liman nebee halo ema sala-laek nia raan fakar,<verse eid="PRO 6:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="PRO 6:18" />laran nebee planu buat aat,</para>
  <para style="q2" vid="PRO 6:18">ain nebee lalais deit hakat baa halo aat,<verse eid="PRO 6:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="PRO 6:19" />sasin falsu nebee hasai lia bosok tuun-sae,</para>
  <para style="q2" vid="PRO 6:19">ho ema nebee provoka maun-alin atu istori malu.<verse eid="PRO 6:19" /></para>
  <para style="s">See mak halo sala ho ema nia feen, sei hetan kastigu</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />Oan, halo tuir o nia aman nia regra;</para>
  <para style="q2" vid="PRO 6:20">la bele fila kotuk ba o nia inan nia hanorin.<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />Rai metin sira nia liafuan iha o nia laran;</para>
  <para style="q2" vid="PRO 6:21">hahenu iha o nia kakorok.<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />Nunee bainhira o lao, liafuan sira nee sei sai matadalan ba o;</para>
  <para style="q2" vid="PRO 6:22">bainhira o toba, liafuan nee sei proteje o;</para>
  <para style="q2" vid="PRO 6:22">bainhira o hadeer, liafuan nee sei koalia ho o.<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />Tanba regra nee hanesan ahi oan;</para>
  <para style="q2" vid="PRO 6:23">hanorin nee hanesan naroman;</para>
  <para style="q2" vid="PRO 6:23">liafuan nee koriji o hodi foo disiplina ba o para bele tuir dalan moris nian.<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />Ho nunee o sei hadook aan husi ema seluk nia feen;</para>
  <para style="q2" vid="PRO 6:24">o sei la monu ba iha feto bulak nia liafuan midar.<verse eid="PRO 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />O nia laran keta kaan nia bonita;</para>
  <para style="q2" vid="PRO 6:25">keta laran monu ba nia matan.<verse eid="PRO 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />Tanba feto luroon, o bele selu ho paun fuan ida,</para>
  <para style="q2" vid="PRO 6:26">maibee ema nia feen, o sei selu ho o nia vida.<verse eid="PRO 6:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />Se o tau ahi lakan iha o nia hiti leten,</para>
  <para style="q2" vid="PRO 6:27">ahi nee la haan tiha o nia hena ka?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />Se o lao iha ahi klaak leten,</para>
  <para style="q2" vid="PRO 6:28">o nia ain la mutuk tiha ka?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />Nunee mos ema nebee mak toba fali ho nia maluk nia feen;</para>
  <para style="q2" vid="PRO 6:29">see deit mak book ema nia feen sei la sees husi kastigu.<verse eid="PRO 6:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />Ema naok-teen ida bainhira naok tanba hamlaha,</para>
  <para style="q2" vid="PRO 6:30">ema seluk sei la hatete aat nia.<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />Maski nunee, se ema kaer toman, nia tenki selu fali too dala hitu;</para>
  <para style="q2" vid="PRO 6:31">bele too nia sasaan uma laran tomak, tenki entrega hotu.<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />Saa tan ema nebee halo sala ho ema nia feen, nia neon la iha;</para>
  <para style="q2" vid="PRO 6:32">see mak halo hanesan nee, nia estraga nia aan rasik.<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />Ema sei baku nia no hamoe nia;</para>
  <para style="q2" vid="PRO 6:33">la iha buat ida mak bele hamoos nia moe nee.<verse eid="PRO 6:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />Tanba laen ida bainhira laran moras, nia raan sei nakali;</para>
  <para style="q2" vid="PRO 6:34">nia sei odi teb-tebes, la iha perdaun.<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />O foo multa hodi halo nia laran malirin, nia sei la simu;</para>
  <para style="q2" vid="PRO 6:35">o selu ho saida deit hodi taka o nia sala, sei la bele halakon nia odiu nee.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s">Keta beik hodi tuir feto nebee nakar</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />Oan, kaer metin hau nia liafuan;</para>
  <para style="q2" vid="PRO 7:1">rai hau nia regra iha o nia laran.<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />Kaer metin hau nia regra, nunee mak o sei moris;</para>
  <para style="q2" vid="PRO 7:2">kuidadu hau nia hanorin hanesan o kuidadu o nia matan musan.<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />Kesi hau nia liafuan ba iha o nia liman fuan;</para>
  <para style="q2" vid="PRO 7:3">hakerek iha o nia laran.<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />Hatete ba matenek dehan, “O nee hau nia biin;”</para>
  <para style="q2" vid="PRO 7:4">konsidera konhesimentu nudar o nia belun diak.<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />Matenek ho konhesimentu nee sei proteje o husi feto aat;</para>
  <para style="q2" vid="PRO 7:5">husi feto ulun bulak nebee koalia liafuan mesak midar.<verse eid="PRO 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />Iha loron ida hau hateke tuun husi hau nia uma;</para>
  <para style="q2" vid="PRO 7:6">hau hafuhu husi janela,<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />hau haree joven lubuk ida nebee la iha esperiensia moris.</para>
  <para style="q2" vid="PRO 7:7">Iha joven sira nee nia klaran,</para>
  <para style="q2" vid="PRO 7:7">hau hetan mane joven ida nebee kakutak la iha.<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />Nia lao dadauk tuir dalan ba iha kruzamentu,</para>
  <para style="q2" vid="PRO 7:8">depois hakat ba feto nia uma.<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />Loro matan tuun dadauk, rai nakaras ona,</para>
  <para style="q2" vid="PRO 7:9">kalan nakukun ona.<verse eid="PRO 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />Derepenti feto ida lao mai hasoru nia;</para>
  <para style="q2" vid="PRO 7:10">feto nee hatais ropa hanesan feto luroon, nia iha hanoin aat.<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />Nia ema ida nebee ibun boot no kontra door;</para>
  <para style="q2" vid="PRO 7:11">nia bibi ain;<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />la oras nia iha dalan, la oras mosu iha fali fatin publiku;</para>
  <para style="q2" vid="PRO 7:12">iha kruzamentu nebee deit, nia hein hela atu lasu mane.<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />Bainhira nia haree joven nee, nia hakuak hodi rei;</para>
  <para style="q2" vid="PRO 7:13">nia fihir metin mane nee hodi dehan,<verse eid="PRO 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />“Hau ohin oho animal halo oferta amizade hodi kumpri hau nia promesa;</para>
  <para style="q2" vid="PRO 7:14">naan iha uma sei barak hela.<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />Tanba nee mak hau sai mai atu hasoru o;</para>
  <para style="q2" vid="PRO 7:15">hau buka hela o, agora hau hetan ona.<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />Hau nahe tiha ona lensol husi rai Ejitu ba iha hau nia kama;</para>
  <para style="q2" vid="PRO 7:16">lensol nee hena diak nian ho kor oi-oin.<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />Hau nia toba fatin hau hamorin tiha ona</para>
  <para style="q2" vid="PRO 7:17">ho mina morin diak nian, ai kameli ho ai kanela.<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />Mai ita baa mout iha domin nia laran too dadeer-saan;</para>
  <para style="q2" vid="PRO 7:18">mai ita hamutuk goza ita nia domin.<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />Tanba hau nia laen sai hela;</para>
  <para style="q2" vid="PRO 7:19">nia baa tiha ona iha rai dook.<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />Nia baa lori ho osan bornal ida nakonu;</para>
  <para style="q2" vid="PRO 7:20">fulan tomak mak foin nia fila.”<verse eid="PRO 7:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />Feto nee hamaus joven mane nee ho liafuan oi-oin deit;</para>
  <para style="q2" vid="PRO 7:21">hodi nia ibun midar nia tenta joven nee atu lao sala dalan.<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />Derepenti joven nee tuir nia</para>
  <para style="q2" vid="PRO 7:22">hanesan karau nebee ema lori baa atu oho.</para>
  <para style="q1" vid="PRO 7:22">Joven nee hanesan rusa nebee hakat tuun ba lasu laran;<verse eid="PRO 7:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 7:23" />hein deit rama oan borus nia fuan.</para>
  <para style="q1" vid="PRO 7:23">Nia hanesan manu fuik nebee semo tama kedas ba iha gaiola laran;</para>
  <para style="q2" vid="PRO 7:23">nia la hatene katak nia iha hela perigu laran.<verse eid="PRO 7:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />Tanba nee, oan sira, rona mai;</para>
  <para style="q2" vid="PRO 7:24">foo atensaun ba hau nia liafuan.<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />La bele husik o nia laran haliis ba iha feto hanesan nee;</para>
  <para style="q2" vid="PRO 7:25">keta lao tuir nia dalan.<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />Tanba nia halo ona ema barak mate;</para>
  <para style="q2" vid="PRO 7:26">ema barak teb-tebes lakon sira nia vida tanba nia.<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />Nia uma hanesan dalan ba rai kuak;</para>
  <para style="q2" vid="PRO 7:27">dalan nee tuun ba iha matebian sira nia fatin.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s">Matenek kompara ho senhora ida nebee foo lia murak</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:1 </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:20">Provérbiu 1:20</ref>,<ref loc="PRO 1:21">21</ref></char>
    </note>Matenek nee hanesan senhora ida nebee konvida ema atu mai rona nia;</para>
  <para style="q2" vid="PRO 8:1">nia kompriende klean, nia bolu ema ho lian makaas atu hakbesik ba nia.<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />Nia hamriik iha laletek besik dalan ninin,</para>
  <para style="q2" vid="PRO 8:2">iha kruzamentu.<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />Nia hamriik besik portaun boot sidade nian;</para>
  <para style="q2" vid="PRO 8:3">nia koalia ho lian makaas besik odamatan sidade nian dehan,<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />“Povu sira, hau koalia ba imi;</para>
  <para style="q2" vid="PRO 8:4">hau hasae hau nia lian ba ema hotu-hotu.<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />Imi nebee la iha esperiensia moris, aprende oinsaa atu foti desizaun;</para>
  <para style="q2" vid="PRO 8:5">imi beik-teen sira, sai matenek ba.<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />Rona mai, tanba hau sei koalia liafuan nebee iha folin;</para>
  <para style="q2" vid="PRO 8:6">buat nebee mak hau hatete sai nee loos.<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />Saida mak hau foo sai nee tebes,</para>
  <para style="q2" vid="PRO 8:7">tanba hau hakribi atu koalia buat aat.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Saida deit mak hau hatete loos hotu;</para>
  <para style="q2" vid="PRO 8:8">hau nia ibun nunka foo sai lia bosok ka lohi.<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />Ba ema nebee kompriende klean, liafuan sira nee klaru hotu;</para>
  <para style="q2" vid="PRO 8:9">ba ema nebee iha konhesimentu, liafuan sira nee loos hotu.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />Diak liu hili hau nia hanorin duke hili osan mutin;</para>
  <para style="q2" vid="PRO 8:10">diak liu hetan konhesimentu duke hetan osan mean diak nian.<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />Tanba matenek nee valor boot liu fali murak mean;</para>
  <para style="q2" vid="PRO 8:11">buat diak hotu-hotu nebee mak o hakarak, la iha ida mak bele kompara ho matenek.<verse eid="PRO 8:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />Hau nee matenek, hau hatene tetu situasaun;</para>
  <para style="q2" vid="PRO 8:12">hau iha konhesimentu luan no hatene foti desizaun.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />Hamtauk NAI Maromak katak hakribi buat aat;</para>
  <para style="q2" vid="PRO 8:13">hau hakribi hahalok nebee foti aan, gaba aan,</para>
  <para style="q2" vid="PRO 8:13">hahalok nebee aat ho ibun nebee lohi door.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />Hau bele loke ema nia hanoin atu sira halao knaar ho diak;</para>
  <para style="q2" vid="PRO 8:14">hau iha kbiit no kompriende klean.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />Liu husi hau, liurai sira bele ukun ho diak,</para>
  <para style="q2" vid="PRO 8:15">no ukun nain sira halo lei ho lo-loos.<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />Liu husi hau, nai ulun sira ho see-see deit mak ukun iha mundu</para>
  <para style="q2" vid="PRO 8:16">bele ukun ho lo-loos.<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />Hau hadomi ema nebee hadomi hau;</para>
  <para style="q2" vid="PRO 8:17">see mak buka hau sei hetan hau.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />Riku-soin ho naran boot mai husi hau;</para>
  <para style="q2" vid="PRO 8:18">hau bele halo ema sai riku no moris diak nafatin ba nafatin.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />Buat nebee hau foo, folin boot liu fali osan mean karun nian;</para>
  <para style="q2" vid="PRO 8:19">rezultadu nebee hau foo, valor boot liu fali osan mutin diak nian.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />Hau lao tuir dalan moris loos nian;</para>
  <para style="q2" vid="PRO 8:20">hau hakat tuir dalan justisa nian.<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />Hau sei foo riku-soin ba ema nebee hadomi hau;</para>
  <para style="q2" vid="PRO 8:21">hau sei hakonu sira nia uma ho sasaan nebee folin boot.<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />Molok NAI Maromak kria buat hotu-hotu,</para>
  <para style="q2" vid="PRO 8:22">Nia kria uluk hau.<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />Hori uluk liu, lalehan ho rai seidauk iha,</para>
  <para style="q2" vid="PRO 8:23">Nia forma hau nanis kedas.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />Bainhira tasi seidauk iha, hau moris tiha ona;</para>
  <para style="q2" vid="PRO 8:24">bainhira bee matan seidauk suli sai, hau iha uluk ona.<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />Molok NAI Maromak hatuur foho bo-boot sira,</para>
  <para style="q2" vid="PRO 8:25">molok Nia forma foho kiik sira, hau moris tiha ona.<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />Antes Nia kria rai maran ka rai fuik;</para>
  <para style="q2" vid="PRO 8:26">rai rahun uitoan mos seidauk iha, hau iha tiha ona.<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />Bainhira Nia hatuur lalehan, hau iha nebaa;</para>
  <para style="q2" vid="PRO 8:27">bainhira Nia marka lalehan ho tasi nia baliza, hau iha nebaa.<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />Bainhira Nia monta kalohan iha leten,</para>
  <para style="q2" vid="PRO 8:28">no halo bee matan iha tasi okos;<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />bainhira Nia tau baliza tasi nian</para>
  <para style="q2" vid="PRO 8:29">atu nunee bee la bele suli liu baliza nebee Nia marka;</para>
  <para style="q1" vid="PRO 8:29">bainhira Nia harii mundu nia alsesu,<verse eid="PRO 8:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30" />iha momentu nebaa hau nee badaen diak ida iha Nia sorin.</para>
  <para style="q1" vid="PRO 8:30">Loro-loron hau halo haksolok Nia laran;</para>
  <para style="q2" vid="PRO 8:30">hau sempre kontenti iha Nia oin.<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />Hau kontenti ho mundu nebee Nia kria nee;</para>
  <para style="q2" vid="PRO 8:31">hau haksolok teb-tebes haree ema kriatura.<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />Agora, oan sira, see tilun mai.</para>
  <para style="q2" vid="PRO 8:32">See mak lao tuir nafatin hau nia dalan, sira hetan ksolok.<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Rona hau nia hanorin atu imi sai matenek;</para>
  <para style="q2" vid="PRO 8:33">keta taka imi nia tilun.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />Ema nebee rona hau;</para>
  <para style="q2" vid="PRO 8:34">ema nebee loro-loron firmi nafatin iha hau nia portaun boot</para>
  <para style="q2" vid="PRO 8:34">hodi hein hau iha odamatan,</para>
  <para style="q2" vid="PRO 8:34">nia hetan ksolok.<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />Tanba ema nebee buka hau too hetan, nia hetan moris,</para>
  <para style="q2" vid="PRO 8:35">no NAI Maromak kontenti ho nia.<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />Maibee see mak la hetan hau, nia halo susar nia aan rasik;</para>
  <para style="q2" vid="PRO 8:36">see mak odi hau, nia hili ona dalan mate nian.”<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s">Matenek ho beik konvida ema atu moris tuir sira</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />Matenek hanesan senhora ida nebee bahat tiha fatuk riin hitu</para>
  <para style="q2" vid="PRO 9:1">hodi harii nia uma.<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />Nia koa animal nebee nia oho;</para>
  <para style="q2" vid="PRO 9:2">nia kahur tua, nia tau meza.<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />Nia haruka nia atan feto sira baa bolu ho lian makaas</para>
  <para style="q2" vid="PRO 9:3">iha laletek sidade nian hodi dehan,<verse eid="PRO 9:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 9:4" />“Imi nebee matan tomak, tama mai.”</para>
  <para style="q1" vid="PRO 9:4">Ba ema nebee la iha neon, nia hameno nunee:<verse eid="PRO 9:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PRO 9:5" />“Hau prepara ona hahaan, mai haan ba;</para>
  <para style="q2" vid="PRO 9:5">hau kahur ona tua, mai hemu ba.<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />Soe tiha imi nia hahalok beik mak imi sei moris;</para>
  <para style="q2" vid="PRO 9:6">lao tuir dalan matenek nian ba.”<verse eid="PRO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />Se o koriji ema kontra door, nia sei hatete aat fali o;</para>
  <para style="q2" vid="PRO 9:7">se o siak ema aat, nia sei hakanek o.<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />Keta siak ema kontra door, se lae nia odi o;</para>
  <para style="q2" vid="PRO 9:8">se o siak ema matenek, nia sei hadomi o.<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />Foo moral ba ema matenek mak nia sai matenek liu tan;</para>
  <para style="q2" vid="PRO 9:9">hanorin ema nebee moris loos mak nia sei aprende liu tan.<verse eid="PRO 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:10 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 28:28">Job 28:28</ref>; <ref loc="PSA 111:10">Salmu 111:10</ref>; <ref loc="PRO 1:7">Provérbiu 1:7</ref></char>
    </note>Matenek nia huun mak hamtauk NAI Maromak;</para>
  <para style="q2" vid="PRO 9:10">see mak konhese Ida nebee Santu, ema nee kompriende klean.<verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />Se o iha matenek, o nia vida sai naruk;</para>
  <para style="q2" vid="PRO 9:11">o nia tinan moris sei aumenta.<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />Se o matenek, o nia matenek nee sei lori buat diak ba o;</para>
  <para style="q2" vid="PRO 9:12">se o ema kontra door, o rasik lori todan.<verse eid="PRO 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />Beik-teen hanesan feto nebee mak ibun boot;</para>
  <para style="q2" vid="PRO 9:13">nia kakutak mamuk, la hatene buat ida.<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />Nia tuur iha kadeira iha nia uma oin,</para>
  <para style="q2" vid="PRO 9:14">iha laletek sidade nian<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />hodi hasee ema nebee liu husi fatin nee;</para>
  <para style="q2" vid="PRO 9:15">nia konvida ema nebee mak lao tuir dalan nee hodi dehan,<verse eid="PRO 9:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="PRO 9:16" />“Imi nebee matan tomak, tama mai.”</para>
  <para style="q1" vid="PRO 9:16">Ba ema nebee la iha neon, nia hameno nunee:<verse eid="PRO 9:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 9:17" />“Bee nebee o naok, midar;</para>
  <para style="q2" vid="PRO 9:17">hahaan nebee mak o haan subar, gostu loos.”<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />Maibee sira la hatene katak see mak tama feto nee nia uma, sira sei mate;</para>
  <para style="q2" vid="PRO 9:18">nia bainaka sira iha hela rai kuak laran.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s">Liurai Salomão nia hanorin</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />Lia matenek husi Salomão:</para>
  <para style="q1" vid="PRO 10:1">Oan nebee matenek lori ksolok ba nia aman,</para>
  <para style="q2" vid="PRO 10:1">maibee oan nebee beik-teen halo nia inan laran dodok.<verse eid="PRO 10:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />Riku-soin nebee ema manaan matak deit la iha folin,</para>
  <para style="q2" vid="PRO 10:2">maibee hahalok nebee loos hasai ema husi mate.<verse eid="PRO 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />NAI Maromak la husik ema nebee moris loos atu hamlaha,</para>
  <para style="q2" vid="PRO 10:3">maibee buat nebee ema aat sira kaan, Nia la foo.<verse eid="PRO 10:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />Ema baruk-teen nia liman halo nia sai kiak,</para>
  <para style="q2" vid="PRO 10:4">maibee ema badinas nia liman halo nia sai riku.<verse eid="PRO 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />Oan nebee matenek halibur ai haan husi toos tuir nia tempu,</para>
  <para style="q2" vid="PRO 10:5">maibee oan nebee toba hela deit iha tempu kolheta, nia halo moe deit.<verse eid="PRO 10:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />Ema nebee moris loos, bensaun haleu nia ulun,</para>
  <para style="q2" vid="PRO 10:6">maibee ema aat koalia midar hodi taka nia hahalok violensia.<verse eid="PRO 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />See mak moris loos, ema gosta temi nafatin sira nia naran,</para>
  <para style="q2" vid="PRO 10:7">maibee ema aat nia naran sei sai dodok too lakon tiha.<verse eid="PRO 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />Ema nebee iha matenek sempre respeita regra,</para>
  <para style="q2" vid="PRO 10:8">maibee ema nebee koalia beik, nia sei monu.<verse eid="PRO 10:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />Ema nebee moris loos, nia dalan seguru,</para>
  <para style="q2" vid="PRO 10:9">maibee see mak lao iha dalan kleuk, ema sei hatene tuir.<verse eid="PRO 10:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />See mak halimar matan hamosu problema;</para>
  <para style="q2" vid="PRO 10:10">see mak koalia beik, nia sei monu.<note caller="+" style="f"><char style="fr" closed="false">10:10 </char><char style="ft" closed="false">Tradusaun linha nee tuir Septuaginta. Lian Ebreu dehan, “maibee see mak brani koriji ema seluk, nia halao dame.” </char></note><verse eid="PRO 10:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />Ema moris loos, nia ibun hanesan bee matan moris nian,</para>
  <para style="q2" vid="PRO 10:11">maibee ema aat koalia midar hodi taka nia hahalok violensia.<verse eid="PRO 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:12 </char>
      <char style="xt" closed="false">
        <ref loc="JAS 5:20">Tiago 5:20</ref>; <ref loc="1PE 4:8">1 Pedro 4:8</ref></char>
    </note>See mak rai odi, nia hamosu istori malu,</para>
  <para style="q2" vid="PRO 10:12">maibee see mak hadomi ema seluk, nia hatene foo perdaun.<verse eid="PRO 10:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />Ema nebee kompriende klean koalia liafuan matenek nian,</para>
  <para style="q2" vid="PRO 10:13">maibee see mak la iha neon, ema sei baku nia kotuk ho rota.<verse eid="PRO 10:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />Ema matenek rai konhesimentu iha nia laran,</para>
  <para style="q2" vid="PRO 10:14">maibee ema beik-teen nia liafuan hamosu dezastre.<verse eid="PRO 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />Ema riku nia sasaan hanesan moru forti nebee haleu nia,</para>
  <para style="q2" vid="PRO 10:15">maibee ema kiak la iha buat ida atu bele salva nia.<verse eid="PRO 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />Ema nebee hahalok loos, nia kosar been lori nia ba moris,</para>
  <para style="q2" vid="PRO 10:16">maibee ema aat nia hahalok halo nia hetan kastigu.<verse eid="PRO 10:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />See mak rona bainhira ema hanorin, nia lao tuir dalan moris nian,</para>
  <para style="q2" vid="PRO 10:17">maibee see mak lakohi simu bainhira ema koriji, nia lao sala dalan.<verse eid="PRO 10:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />See mak rai odi iha laran, nia koalia bosok;</para>
  <para style="q2" vid="PRO 10:18">see mak hatete aat ema iha fat-fatin, nia beik-teen.<verse eid="PRO 10:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />Ema nebee koalia barak, sempre hamosu pekadu,</para>
  <para style="q2" vid="PRO 10:19">maibee see mak kuidadu ibun, nia nee matenek.<verse eid="PRO 10:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />Ema moris loos nia ibun hanesan osan mutin diak nian,</para>
  <para style="q2" vid="PRO 10:20">maibee ema aat nia hanoin iha folin uitoan deit.<verse eid="PRO 10:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />Ema moris loos nia liafuan ajuda ema barak,</para>
  <para style="q2" vid="PRO 10:21">maibee ema beik-teen mate tanba neon la iha.<verse eid="PRO 10:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />NAI Maromak nia bensaun mak halo ema hetan riku-soin;</para>
  <para style="q2" vid="PRO 10:22">servisu too haluha aan la bele halo ema sai riku.<note caller="+" style="f"><char style="fr" closed="false">10:22 </char><char style="ft" closed="false">Linha nee bele mos signifika, “Nia laos foo riku-soin ho laran susar dala ida.” </char></note><verse eid="PRO 10:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />Ema beik-teen gosta halo buat aat,</para>
  <para style="q2" vid="PRO 10:23">maibee ema nebee iha ona konhesimentu gosta buka matenek.<verse eid="PRO 10:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />Buat nebee ema aat tauk, too ikus sei akontese duni ba nia;</para>
  <para style="q2" vid="PRO 10:24">saida mak ema moris loos hakarak, too ikus nia sei hetan.<verse eid="PRO 10:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />Anin boot mosu mai, huu lakon tiha ema aat,</para>
  <para style="q2" vid="PRO 10:25">maibee ema moris loos hamriik metin nafatin.<verse eid="PRO 10:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />Ema nebee baruk-teen halo nia patraun senti hanesan tua siin kona nia nehan</para>
  <para style="q2" vid="PRO 10:26">ka ahi suar tama nia matan laran.<verse eid="PRO 10:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />Ema nebee hamtauk NAI Maromak, nia vida aumenta naruk,</para>
  <para style="q2" vid="PRO 10:27">maibee ema aat nia vida habadak tiha.<verse eid="PRO 10:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />Ema moris loos nia esperansa sei lori ksolok ba nia,</para>
  <para style="q2" vid="PRO 10:28">maibee buat nebee ema aat espera sei la sai realidade.<verse eid="PRO 10:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />NAI Maromak mak abrigu ba ema nebee moris loos,</para>
  <para style="q2" vid="PRO 10:29">maibee Nia halo mohu tiha ema nebee hahalok aat.<verse eid="PRO 10:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />Ema moris loos sei hela metin iha rai nee,</para>
  <para style="q2" vid="PRO 10:30">maibee ema aat sei fokit sai tiha.<verse eid="PRO 10:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />Ema moris loos nia ibun foo sai liafuan matenek,</para>
  <para style="q2" vid="PRO 10:31">maibee ema aat nia ibun sei taka tiha.<verse eid="PRO 10:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />Ema moris loos hatene koalia buat nebee diak,</para>
  <para style="q2" vid="PRO 10:32">maibee ema aat nia ibun koalia liafuan mesak bosok deit.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />NAI Maromak hakribi dasin nebee falsu,</para>
  <para style="q2" vid="PRO 11:1">maibee dasin nebee tetu ho loos halo haksolok Nia laran.<verse eid="PRO 11:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />See mak foti aan, nia sei hetan moe,</para>
  <para style="q2" vid="PRO 11:2">maibee see mak haraik aan, nia iha matenek.<verse eid="PRO 11:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />Ema diak hatene halo buat nebee loos tanba nia laran moos,</para>
  <para style="q2" vid="PRO 11:3">maibee ema traidor sei monu tanba nia lohi door.<verse eid="PRO 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />Iha loron nebee NAI Maromak fakar sai Nia hirus, ema nia riku-soin la bele halo buat ida ba nia,</para>
  <para style="q2" vid="PRO 11:4">maibee hahalok nebee loos hasai ema husi mate.<verse eid="PRO 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />Ema nebee livre husi sala lao iha rai tetuk tanba nia moris loos,</para>
  <para style="q2" vid="PRO 11:5">maibee ema aat monu tanba nia hahalok aat.<verse eid="PRO 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />Ema laran moos sei hetan salvasaun tanba nia moris loos,</para>
  <para style="q2" vid="PRO 11:6">maibee ema traidor monu ba lasu laran tanba nia hakarak aat.<verse eid="PRO 11:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />Bainhira ema aat mate, nia mehi mos lakon;</para>
  <para style="q2" vid="PRO 11:7">buat hotu nebee nia hakarak atu hetan husi nia kbiit rasik sei saugati deit.<verse eid="PRO 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />NAI Maromak salva ema moris loos husi terus laran;</para>
  <para style="q2" vid="PRO 11:8">ema aat mak sei hetan fali terus nee.<verse eid="PRO 11:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />Ema nebee la interese NAI Maromak, uza nia ibun hodi estraga nia maluk,</para>
  <para style="q2" vid="PRO 11:9">maibee ema moris loos hatene salva aan.<verse eid="PRO 11:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />Bainhira ema laran moos hetan moris diak, ema iha sidade laran kontenti;</para>
  <para style="q2" vid="PRO 11:10">bainhira ema aat mate, ema iha sidade laran haklalak haksolok.<verse eid="PRO 11:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />Ema laran moos sai bensaun ba sira nia sidade, halo sidade nee naran boot,</para>
  <para style="q2" vid="PRO 11:11">maibee ema aat nia ibun halo sidade naksobu tiha.<verse eid="PRO 11:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />See mak hatuun nia maluk, ema nee kakutak mamuk,</para>
  <para style="q2" vid="PRO 11:12">maibee ema nebee matenek, nia nonook deit.<verse eid="PRO 11:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />See mak gosta konta ema vida, nia foo sai ema nia segredu,</para>
  <para style="q2" vid="PRO 11:13">maibee ema nebee ita bele konfia, nia hatene rai segredu.<verse eid="PRO 11:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />Bainhira la iha lideransa matenek, nasaun sei monu;</para>
  <para style="q2" vid="PRO 11:14">bainhira iha ema matenek barak hodi hatudu dalan, nasaun hamriik metin.<verse eid="PRO 11:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />Se ema ruma responsabiliza atu selu ema seluk nia tusan, ema nee sei terus,</para>
  <para style="q2" vid="PRO 11:15">maibee se nia lakohi promete nunee, nia sei moris seguru.<verse eid="PRO 11:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />Feto nebee laran diak hetan respeitu;</para>
  <para style="q2" vid="PRO 11:16">mane nebee gosta violensia hetan deit riku-soin.<verse eid="PRO 11:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />See mak hatudu laran luak ba ema, nia halo diak ba nia aan rasik,</para>
  <para style="q2" vid="PRO 11:17">maibee see mak gosta halo aat ba ema, nia halo susar nia aan rasik.<verse eid="PRO 11:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />Ema aat hakaas aan hetan riku-soin, too ikus la iha folin,</para>
  <para style="q2" vid="PRO 11:18">maibee see mak kuda hahalok loos, sei hetan rezultadu nebee folin boot.<verse eid="PRO 11:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />Ema nebee toman halo buat diak, nia hetan moris,</para>
  <para style="q2" vid="PRO 11:19">maibee see mak hatoman aan halo buat aat, nia sei mate.<verse eid="PRO 11:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />NAI Maromak hakribi ema nebee laran aat,</para>
  <para style="q2" vid="PRO 11:20">maibee Nia kontenti haree ema nebee hahalok loos.<verse eid="PRO 11:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />Tebes, ema aat sei la sees husi kastigu,</para>
  <para style="q2" vid="PRO 11:21">maibee ema moris loos sei lao livre.<note caller="+" style="f"><char style="fr" closed="false">11:21 </char><char style="ft" closed="false">Linha nee mos bele iha nia signifikadu, “maibee ema moris loos nia jerasaun sei hetan salvasaun.”</char></note><verse eid="PRO 11:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />Feto nebee bonita maibee la iha neon,</para>
  <para style="q2" vid="PRO 11:22">nia hanesan brinkus osan mean nebee tau iha fahi nia inus.<verse eid="PRO 11:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />Ema moris loos nia mehi sempre lori nia ba diak;</para>
  <para style="q2" vid="PRO 11:23">ema aat nia esperansa lori nia ba kastigu.<verse eid="PRO 11:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />Iha ema balu fahe sira nia sasaan ho laran luak, too ikus sira nia riku-soin aumenta tan;</para>
  <para style="q2" vid="PRO 11:24">iha ema balu karak-teen, too ikus sai fali kiak.<verse eid="PRO 11:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />See mak hatudu laran diak hodi foo tulun ba ema seluk, nia sei hetan moris diak;</para>
  <para style="q2" vid="PRO 11:25">see mak hametin ema seluk nia laran, ema mos sei hametin nia laran.<verse eid="PRO 11:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />See mak rai ai haan atu faan karun iha tempu susar, ema sei hatete aat nia,</para>
  <para style="q2" vid="PRO 11:26">maibee see mak faan ai haan ho folin natoon, ema sei gaba nia.<verse eid="PRO 11:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />See mak badinas halo buat diak, nia sei hetan naran diak,</para>
  <para style="q2" vid="PRO 11:27">maibee see mak duni tuir buat aat, sei hetan buat aat.<verse eid="PRO 11:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />See mak tau fiar ba nia riku-soin, nia sei monu,</para>
  <para style="q2" vid="PRO 11:28">maibee see mak moris loos sei buras hanesan ai tahan nebee matak.<verse eid="PRO 11:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />See mak lori susar ba nia uma kain, too ikus la hetan buat ida;</para>
  <para style="q2" vid="PRO 11:29">ema beik-teen sei sai atan ba ema matenek.<verse eid="PRO 11:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />Ema moris loos nia hahalok hanesan ai huun nebee mak foo moris;</para>
  <para style="q2" vid="PRO 11:30">see mak iha matenek, nia bele manaan ema nia laran.<note caller="+" style="f"><char style="fr" closed="false">11:30 </char><char style="ft" closed="false">Lian Ebreu iha nee la klaru. Bele mos signifika, “maibee violensia hasai ema nia vida.”</char></note><verse eid="PRO 11:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:31 </char>
      <char style="xt" closed="false">
        <ref loc="1PE 4:18">1 Pedro 4:18</ref>
      </char>
    </note> Ema nebee moris loos hetan sira nia kolen iha mundu nee;</para>
  <para style="q2" vid="PRO 11:31">ema aat ho ema nebee gosta halo sala mos hetan buat nebee sira merese simu.<verse eid="PRO 11:31" /></para>
  <para style="b" />
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />See mak gosta atu ema koriji, nia gosta aprende,</para>
  <para style="q2" vid="PRO 12:1">maibee see mak lakohi atu ema hasee, nia beik-teen.<verse eid="PRO 12:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />NAI Maromak kontenti ho ema nebee diak,</para>
  <para style="q2" vid="PRO 12:2">maibee Nia hamonu kastigu ba ema nebee gosta halo manobra.<verse eid="PRO 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />Ema nebee hahalok aat, nia moris sei la metin,</para>
  <para style="q2" vid="PRO 12:3">maibee ema nebee moris loos, nia abut metin nafatin.<verse eid="PRO 12:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />Feen nebee hahalok diak, hanesan koroa nebee tau ba nia laen nia ulun,</para>
  <para style="q2" vid="PRO 12:4">maibee feen nebee hamoe nia laen, halo nia laen nia ruin sai dodok tiha.<verse eid="PRO 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />Ema moris loos halo planu nebee justu ba ema seluk,</para>
  <para style="q2" vid="PRO 12:5">maibee ema aat foo hanoin ba ema seluk ho liafuan mesak bosok.<verse eid="PRO 12:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />Bainhira ema aat koalia, nee hanesan nia hafuhu ema seluk atu fakar nia raan;</para>
  <para style="q2" vid="PRO 12:6">maibee ema moris loos nia liafuan salva ema seluk.<verse eid="PRO 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />Ema aat sei monu too la iha tiha ona,</para>
  <para style="q2" vid="PRO 12:7">maibee ema nebee moris loos, nia uma kain sei hamriik metin.<verse eid="PRO 12:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />See mak iha neon matenek, ema seluk sei gaba nia,</para>
  <para style="q2" vid="PRO 12:8">maibee see mak hanoin kleuk, ema sei hatuun nia.<verse eid="PRO 12:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />Diak liu sai ema kiik maibee iha ema ida halo netik servisu ba nia,</para>
  <para style="q2" vid="PRO 12:9">duke estilus ema boot, maibee hahaan la iha.<verse eid="PRO 12:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />Ema nebee moris loos tau matan di-diak ba nia animal sira,</para>
  <para style="q2" vid="PRO 12:10">maibee ema aat atu hatudu laran diak too iha nebee mos, nia nafatin halo aat.<verse eid="PRO 12:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />Ema nebee mak servisu badinas iha nia toos, sei hetan ai haan barak,</para>
  <para style="q2" vid="PRO 12:11">maibee see mak gasta tempu ba buat nebee la iha folin, nia la iha neon.<verse eid="PRO 12:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />Ema aat kaan atu hetan riku-soin tuir dalan aat nian,</para>
  <para style="q2" vid="PRO 12:12">maibee ema nebee moris loos hanesan ai huun nebee abut metin hodi foo fuan.<verse eid="PRO 12:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />Ema aat nia ibun halo nia monu tama ba lasu,</para>
  <para style="q2" vid="PRO 12:13">maibee ema moris loos bele sai husi susar laran.<verse eid="PRO 12:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />Se ema nia ibun koalia liafuan diak, nia sei hetan buat diak;</para>
  <para style="q2" vid="PRO 12:14">bainhira nia liman halo buat diak, nia sei simu nia kolen.<verse eid="PRO 12:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />Ema beik-teen hanoin katak saida deit mak nia halo nee loos,</para>
  <para style="q2" vid="PRO 12:15">maibee ema matenek see tilun bainhira ema seluk foo hanoin.<verse eid="PRO 12:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />Bainhira ema beik-teen hirus, nia hatudu sai kedas,</para>
  <para style="q2" vid="PRO 12:16">maibee ema neon matenek, bainhira ema hatete aat nia mos, nia la hola ba lia.<verse eid="PRO 12:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />Ema nebee kaer metin lia loos, nia foo sasin ho lo-loos,</para>
  <para style="q2" vid="PRO 12:17">maibee ema bosok-teen foo sasin falsu.<verse eid="PRO 12:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />See mak koalia la sukat ibun, nia liafuan hanesan surik nebee hakanek ema,</para>
  <para style="q2" vid="PRO 12:18">maibee ema matenek nia ibun bele kura ema nia kanek.<verse eid="PRO 12:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />Liafuan nebee loos sei dura nafatin ba nafatin,</para>
  <para style="q2" vid="PRO 12:19">maibee lia bosok la kleur lakon tiha.<verse eid="PRO 12:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />Ema nebee iha planu aat, nia laran nakonu ho bosok,</para>
  <para style="q2" vid="PRO 12:20">maibee see mak halo ema dame malu, nia laran haksolok.<verse eid="PRO 12:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />Ema nebee moris loos, dezastre sei la kona nia,</para>
  <para style="q2" vid="PRO 12:21">maibee ema aat sempre hetan susar.<verse eid="PRO 12:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />NAI Maromak hakribi ema nebee ibun bosok-teen,</para>
  <para style="q2" vid="PRO 12:22">maibee Nia haksolok ho ema nebee moris tuir lia loos.<verse eid="PRO 12:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />Ema nebee neon matenek la nar-naran foo sai buat nebee nia hatene,</para>
  <para style="q2" vid="PRO 12:23">maibee ema beik-teen halekar buat beik.<verse eid="PRO 12:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />Ema nebee servisu ho badinas sei sai ukun nain,</para>
  <para style="q2" vid="PRO 12:24">maibee ema nebee baruk-teen too ikus tenki sai atan ba ema seluk.<verse eid="PRO 12:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />Preokupa demais halo ema nia laran todan,</para>
  <para style="q2" vid="PRO 12:25">maibee liafuan nebee diak halo nia laran kamaan.<verse eid="PRO 12:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />Ema nebee moris loos sai matadalan ba nia maluk,</para>
  <para style="q2" vid="PRO 12:26">maibee ema aat nia hahalok lori nia lao sala dalan.<verse eid="PRO 12:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />Ema baruk-teen kasa tiha animal, nia baruk atu tunu,</para>
  <para style="q2" vid="PRO 12:27">maibee ema nebee badinas sei hetan riku-soin folin boot.<verse eid="PRO 12:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />See mak lao tuir dalan loos, nia hetan moris;</para>
  <para style="q2" vid="PRO 12:28">dalan nee sei la lori nia ba mate.<note caller="+" style="f"><char style="fr" closed="false">12:28 </char><char style="ft" closed="false">Kopia livru nee husi tempu antigu barak. Kopia balu dehan, “maibee dalan aat lori ema ba mate.” </char></note><verse eid="PRO 12:28" /></para>
  <para style="b" />
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />Oan nebee matenek sei rona nia aman nia hanorin,</para>
  <para style="q2" vid="PRO 13:1">maibee ema kontra door lakohi rona bainhira ema hasee makaas nia.<verse eid="PRO 13:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />Ema nebee koalia liafuan diak, sei hetan buat diak,</para>
  <para style="q2" vid="PRO 13:2">maibee ema traidor kaan atu halo violensia.<verse eid="PRO 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />See mak kuidadu nia ibun, proteje nia moris,</para>
  <para style="q2" vid="PRO 13:3">maibee see mak loke nia ibun luan, sei hetan terus.<verse eid="PRO 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />Ema baruk-teen kaan buat oi-oin, maibee la hetan buat ida;</para>
  <para style="q2" vid="PRO 13:4">ema badinas hetan saida deit mak nia hakarak.<verse eid="PRO 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />Ema nebee moris loos la gosta lia falsu,</para>
  <para style="q2" vid="PRO 13:5">maibee ema aat nia hahalok halo moe rai, no estraga nia naran.<verse eid="PRO 13:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />Ema laran moos nia hahalok proteje nia;</para>
  <para style="q2" vid="PRO 13:6">ema aat nia pekadu hamonu nia.<verse eid="PRO 13:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />Iha ema balu estilus riku maibee buat ida la iha;</para>
  <para style="q2" vid="PRO 13:7">iha ema balu finji kiak maibee iha riku-soin barak.<verse eid="PRO 13:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />Ema riku bele selu nia vida bainhira ema ameasa nia,</para>
  <para style="q2" vid="PRO 13:8">maibee la iha ema ida atu ameasa ema kiak.<verse eid="PRO 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />Ema nebee moris loos, nia dalan naroman nabilan,</para>
  <para style="q2" vid="PRO 13:9">maibee ema aat nia ahi oan sei mate.<verse eid="PRO 13:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />See mak foti aan, nia hamosu istori malu,</para>
  <para style="q2" vid="PRO 13:10">maibee see mak respeita ema nia hanorin, nia iha matenek.<verse eid="PRO 13:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />Ema nebee riku matak, too tempu ida nia riku-soin sei menus,</para>
  <para style="q2" vid="PRO 13:11">maibee see mak rai uitoan-uitoan sei aumenta nia riku-soin.<verse eid="PRO 13:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />Se ema hein buat ruma maibee la mosu hela deit, nia laran susar,</para>
  <para style="q2" vid="PRO 13:12">maibee bainhira ninia hakarak akontese duni, nee hanesan ai huun nebee foo moris.<verse eid="PRO 13:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />See mak la foo folin ba liafuan diak, nia sei simu todan,</para>
  <para style="q2" vid="PRO 13:13">maibee see mak respeita regra, sei hetan buat diak.<verse eid="PRO 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />Ema matenek nia hanorin hanesan bee matan moris nian,</para>
  <para style="q2" vid="PRO 13:14">halo ema lao sees husi lasu mate nian.<verse eid="PRO 13:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />Ema nebee iha neon diak sei hetan respeitu,</para>
  <para style="q2" vid="PRO 13:15">maibee ema nebee la halo tuir nia liafuan, sei hetan dezastre.<verse eid="PRO 13:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />Ema neon matenek tetu lai foin halo buat ruma,</para>
  <para style="q2" vid="PRO 13:16">maibee ema beik halekar hahalok beik-teen.<verse eid="PRO 13:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />Ema nebee lori lia menon maibee bobar fali, nia sei hetan susar boot,</para>
  <para style="q2" vid="PRO 13:17">maibee ema nebee lori lia menon ho lo-loos, nia halo ema moris hakmatek.<verse eid="PRO 13:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />See mak lakohi simu bainhira ema hanorin nia, too ikus sai kiak no hetan moe,</para>
  <para style="q2" vid="PRO 13:18">maibee see mak rona bainhira ema koriji, nia sei hetan respeitu.<verse eid="PRO 13:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />Bainhira ema nia hakarak sai realidade, nia laran kontenti,</para>
  <para style="q2" vid="PRO 13:19">maibee ema beik-teen hakribi atu fila kotuk ba hahalok aat.<verse eid="PRO 13:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />See mak ranxu ema matenek, nia sai matenek;</para>
  <para style="q2" vid="PRO 13:20">see mak halo belun ho ema beik-teen, nia sei terus.<verse eid="PRO 13:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />Ema aat sempre hetan susar,</para>
  <para style="q2" vid="PRO 13:21">maibee ema moris loos sempre hetan buat diak.<verse eid="PRO 13:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />Ema diak rai hela riku-soin ba nia bei-oan sira,</para>
  <para style="q2" vid="PRO 13:22">maibee ema aat nia riku-soin, too ikus ema moris loos mak hetan fali.<verse eid="PRO 13:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />Ai haan bele nakonu iha ema kiak nia toos,</para>
  <para style="q2" vid="PRO 13:23">maibee tanba deit justisa lao la loos, hahaan nee lakon mohu.<verse eid="PRO 13:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />Ema nebee lakohi hanorin nia oan ho rota, nia la iha domin ba nia oan;</para>
  <para style="q2" vid="PRO 13:24">see mak hadomi nia oan, sei eduka nia.<verse eid="PRO 13:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />Ema nebee moris loos haan too kabun bosu,</para>
  <para style="q2" vid="PRO 13:25">maibee ema aat nia kabun hamlaha hela deit.<verse eid="PRO 13:25" /></para>
  <para style="b" />
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />Feto nebee matenek harii nia uma kain,</para>
  <para style="q2" vid="PRO 14:1">maibee feto beik-teen sobu nia uma kain ho nia liman rasik.<verse eid="PRO 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />See mak lao tuir dalan loos, nia hamtauk NAI Maromak,</para>
  <para style="q2" vid="PRO 14:2">maibee ema nebee lao iha dalan kleuk, hatete aat fali NAI.<verse eid="PRO 14:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />Ema beik-teen nia ibun konvida rota ba iha nia kotuk,</para>
  <para style="q2" vid="PRO 14:3">maibee ema matenek nia ibun proteje nia aan.<verse eid="PRO 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />Se la iha karau, karau nia haan fatin mamuk;</para>
  <para style="q2" vid="PRO 14:4">hodi karau nia forsa mak toos bele foo rezultadu barak.<verse eid="PRO 14:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />Sasin nebee laran moos, la bosok,</para>
  <para style="q2" vid="PRO 14:5">maibee sasin nebee lohi door, fakar sai lia falsu.<verse eid="PRO 14:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />Ema kontra door buka matenek la hetan,</para>
  <para style="q2" vid="PRO 14:6">maibee ema nebee kompriende klean ona, fasil ba nia atu aprende.<verse eid="PRO 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />Hadook aan tiha husi ema beik-teen,</para>
  <para style="q2" vid="PRO 14:7">tanba o sei la aprende buat ida husi nia liafuan.<verse eid="PRO 14:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />Ema nebee neon matenek hatene tetu nia dalan,</para>
  <para style="q2" vid="PRO 14:8">maibee ema beik-teen hanoin beik too lohi nia aan rasik.<verse eid="PRO 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />Ema beik-teen halo sala, la interese atu kasu nia sala,</para>
  <para style="q2" vid="PRO 14:9">maibee ema laran moos hakaas aan atu moris iha dame nia laran.<verse eid="PRO 14:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />Ema ida-idak mak hatene tuir nia laran susar;</para>
  <para style="q2" vid="PRO 14:10">ksolok nebee nia hetan, ema seluk la bele senti.<verse eid="PRO 14:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />Ema aat nia uma sei rahun tiha,</para>
  <para style="q2" vid="PRO 14:11">maibee ema laran moos nia tenda sei aumenta boot.<verse eid="PRO 14:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />Ema balu senti dalan nebee nia liu nee loos hela,</para>
  <para style="q2" vid="PRO 14:12">afinal dalan nee lori nia ba mate.<note caller="+" style="x"><char style="xo" closed="false">14:12 </char><char style="xt" closed="false"><ref loc="PRO 16:25">Provérbiu 16:25</ref></char></note><verse eid="PRO 14:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />Ema bele hamnasa ho laran susar;</para>
  <para style="q2" vid="PRO 14:13">bele mos haksolok, maibee too ikus tristi fali.<verse eid="PRO 14:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />Ema nebee lao sees husi dalan loos, sei simu kastigu tuir nia hahalok,</para>
  <para style="q2" vid="PRO 14:14">maibee ema diak sei simu nia kolen.<verse eid="PRO 14:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />Ema nebee nar-naran tuir ema, nia fiar buat saida deit mak nia rona,</para>
  <para style="q2" vid="PRO 14:15">maibee ema nebee neon matenek kuidadu nia lalaok.<verse eid="PRO 14:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />Ema matenek kuidadu<note caller="+" style="f"><char style="fr" closed="false">14:16 </char><char style="ft" closed="false">Lian Ebreu iha nee bele mos tradus, “Ema matenek hamtauk NAI Maromak.”</char></note> hodi hadook aan husi hahalok aat,</para>
  <para style="q2" vid="PRO 14:16">maibee ema beik-teen hanoin badak no konfia aan demais.<verse eid="PRO 14:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />See mak hirus lalais, hatudu nia beik;</para>
  <para style="q2" vid="PRO 14:17">see mak hanoin aat ema seluk, ema sei odi nia.<note caller="+" style="f"><char style="fr" closed="false">14:17 </char><char style="ft" closed="false">Linha nee tradusaun balu dehan, “maibee ema nebee hatene oinsaa halo planu, nia iha pasiensia.”</char></note><verse eid="PRO 14:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />Ema nebee nar-naran tuir ema, nia sai beik-teen,</para>
  <para style="q2" vid="PRO 14:18">maibee ema neon matenek aprende buat barak halo nia naran boot.<verse eid="PRO 14:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />Ema aat sei hakruuk iha ema diak nia oin;</para>
  <para style="q2" vid="PRO 14:19">ema nebee halo aat sei hakruuk iha ema moris loos nia portaun.<verse eid="PRO 14:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />Ema kiak la iha belun, too nia vizinhu sira mos lakohi hamaluk nia,</para>
  <para style="q2" vid="PRO 14:20">maibee ema riku iha belun barak.<verse eid="PRO 14:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />See mak hatete aat nia maluk, nia halo sala,</para>
  <para style="q2" vid="PRO 14:21">maibee see mak hatudu laran diak ba ema mukit, nia hetan ksolok.<verse eid="PRO 14:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />See mak hanoin aat ema seluk, nia lao sala dalan,</para>
  <para style="q2" vid="PRO 14:22">maibee see mak halo planu nebee diak ba ema, ema mos sei hadomi nia no foo laran ba nia.<verse eid="PRO 14:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />See mak servisu makaas, nia hetan rezultadu diak,</para>
  <para style="q2" vid="PRO 14:23">maibee see mak koalia deit sei sai kiak.<verse eid="PRO 14:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />Matenek nain nia riku-soin hanesan koroa iha nia ulun;</para>
  <para style="q2" vid="PRO 14:24">ema nebee kakutak mamuk nia hahalok beik halo nia beik liu tan.<verse eid="PRO 14:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />See mak foo sasin ho lo-loos, nia salva ema nia vida,</para>
  <para style="q2" vid="PRO 14:25">maibee see mak foo sasin falsu, nia lohi door.<verse eid="PRO 14:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />Ema nebee hamtauk NAI Maromak, moris iha pas nia laran,</para>
  <para style="q2" vid="PRO 14:26">too nia oan sira mos hetan fatin seguru.<verse eid="PRO 14:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />See mak hamtauk NAI Maromak, hetan bee matan moris,</para>
  <para style="q2" vid="PRO 14:27">nunee nia bele lao sees husi lasu mate nian.<verse eid="PRO 14:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />Se liurai iha reinu barak, nia naran sai boot;</para>
  <para style="q2" vid="PRO 14:28">se ukun nain la iha povu, nia la vale ona.<verse eid="PRO 14:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />Ema nebee pasiensia, nia kompriende klean,</para>
  <para style="q2" vid="PRO 14:29">maibee see mak hirus lalais, nia hatudu nia beik.<verse eid="PRO 14:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />Ema nebee laran hakmatek, nia isin sai fresku,</para>
  <para style="q2" vid="PRO 14:30">maibee see mak laran moras ba ema seluk, nia ruin sai dodok.<verse eid="PRO 14:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />See mak hanehan ema kiak sira, insulta sira nia Kriador,</para>
  <para style="q2" vid="PRO 14:31">maibee see mak hatudu laran luak ba ema kiik sira, foti aas Ida nebee kria sira.<verse eid="PRO 14:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />Ema aat lakon mohu tiha tanba ninia hahalok aat,</para>
  <para style="q2" vid="PRO 14:32">maibee ema nebee moris loos hetan salvasaun tanba nia laran moos.<verse eid="PRO 14:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />Ema nebee kompriende klean, matenek horik iha nia laran,</para>
  <para style="q2" vid="PRO 14:33">maibee iha ema beik-teen nia laran, matenek la iha liu.<verse eid="PRO 14:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />Povu nebee moris loos halo boot nasaun nia naran,</para>
  <para style="q2" vid="PRO 14:34">maibee pekadu halo nasaun nia naran foer.<verse eid="PRO 14:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />Liurai gosta teb-tebes atan nebee mak iha matenek,</para>
  <para style="q2" vid="PRO 14:35">maibee nia laran nakali ba atan nebee halo moe nia.<verse eid="PRO 14:35" /></para>
  <para style="b" />
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />Resposta nebee kalma halo ema nia laran malirin,</para>
  <para style="q2" vid="PRO 15:1">maibee liafuan nebee kroat provoka ema hirus.<verse eid="PRO 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />Ema matenek koalia, halo ema seluk gosta aprende,</para>
  <para style="q2" vid="PRO 15:2">maibee ema beik-teen nia ibun fakar sai buat beik.<verse eid="PRO 15:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />NAI Maromak nia matan iha fatin hotu-hotu;</para>
  <para style="q2" vid="PRO 15:3">Nia kontrola ema aat no ema diak.<verse eid="PRO 15:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />Liafuan nebee halo kamaan ema nia laran hanesan ai huun moris nian,</para>
  <para style="q2" vid="PRO 15:4">maibee ibun bosok-teen hakanek ema nia fuan.<verse eid="PRO 15:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />Ema beik-teen lakohi rona bainhira nia aman eduka nia,</para>
  <para style="q2" vid="PRO 15:5">maibee ema nebee prontu simu moral, hatudu katak nia iha matenek.<verse eid="PRO 15:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />Iha ema moris loos nia uma iha riku-soin barak,</para>
  <para style="q2" vid="PRO 15:6">maibee ema aat nia kosar been lori terus ba nia aan.<verse eid="PRO 15:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />Ema matenek fahe nia konhesimentu ba ema seluk,</para>
  <para style="q2" vid="PRO 15:7">maibee ema beik-teen la bele halo nunee.<verse eid="PRO 15:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />NAI Maromak hakribi sakrifisiu nebee ema aat hasae ba Nia,</para>
  <para style="q2" vid="PRO 15:8">maibee ema laran moos nia orasaun halo NAI nia laran haksolok.<verse eid="PRO 15:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />NAI Maromak hakribi ema aat nia hahalok,</para>
  <para style="q2" vid="PRO 15:9">maibee Nia hadomi ema nebee hakaas aan moris loos.<verse eid="PRO 15:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />Ema nebee fila kotuk ba dalan loos, sei hetan kastigu todan;</para>
  <para style="q2" vid="PRO 15:10">see mak lakohi simu bainhira ema koriji, nia sei mate.<verse eid="PRO 15:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />NAI Maromak haree borus saida mak iha rate laran ka iha matebian sira nia fatin;</para>
  <para style="q2" vid="PRO 15:11">saa tan ita ema nia laran, NAI hatene mo-moos.<verse eid="PRO 15:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />Ema kontra door lakohi atu ema koriji nia;</para>
  <para style="q2" vid="PRO 15:12">nia lakohi husu ema matenek nia hanoin.<verse eid="PRO 15:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />Ema nebee laran kontenti, nia oin nabilan,</para>
  <para style="q2" vid="PRO 15:13">maibee se nia laran terus, nia fuan mos kanek.<verse eid="PRO 15:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />Ema nebee kompriende klean hakarak teb-tebes atu aprende tan;</para>
  <para style="q2" vid="PRO 15:14">ema nebee kakutak mamuk gosta buka tuir buat beik.<verse eid="PRO 15:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />Ema kbiit-laek terus loron ba loron,</para>
  <para style="q2" vid="PRO 15:15">maibee ema nebee laran kontenti senti hanesan festa hela deit.<verse eid="PRO 15:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />Diak liu iha sasaan uitoan maibee hamtauk NAI Maromak,</para>
  <para style="q2" vid="PRO 15:16">duke iha riku-soin barak maibee laran la hakmatek.<verse eid="PRO 15:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />Diak liu haan modo tahan maibee hadomi malu,</para>
  <para style="q2" vid="PRO 15:17">duke haan naan karau diak nian maibee haree malu matan la moos.<verse eid="PRO 15:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />Ema nebee hirus-teen hamosu istori malu,</para>
  <para style="q2" vid="PRO 15:18">maibee ema nebee iha pasiensia halo ema dame malu.<verse eid="PRO 15:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />Ema baruk-teen nia dalan, ai tarak satan netik,</para>
  <para style="q2" vid="PRO 15:19">maibee ema nebee laran moos, nia dalan luan no tetuk.<verse eid="PRO 15:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />Oan nebee matenek foo ksolok ba nia aman,</para>
  <para style="q2" vid="PRO 15:20">maibee ema nebee beik-teen la respeita nia inan.<verse eid="PRO 15:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />Ema nebee la iha neon, kontenti halo buat beik,</para>
  <para style="q2" vid="PRO 15:21">maibee ema nebee iha matenek, nia lao iha dalan loos.<verse eid="PRO 15:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />Atu hetan susesu, presiza matenek nain barak hodi foo hanoin;</para>
  <para style="q2" vid="PRO 15:22">se la iha ema ida atu foo ideia, planu la lao ba oin.<verse eid="PRO 15:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />Bainhira ema foo resposta nebee kona lo-loos, nia kontenti;</para>
  <para style="q2" vid="PRO 15:23">liafuan iha folin boot bainhira foo sai tuir tempu nebee loos.<verse eid="PRO 15:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />Ema matenek hakat sae tuir dalan moris nian,</para>
  <para style="q2" vid="PRO 15:24">atu nunee nia la tuun ba iha matebian sira nia fatin.<verse eid="PRO 15:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />NAI Maromak sobu tiha ema foti aan nia uma,</para>
  <para style="q2" vid="PRO 15:25">maibee Nia defende feto faluk nia rai baliza.<verse eid="PRO 15:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />NAI Maromak hakribi ema aat nia planu,</para>
  <para style="q2" vid="PRO 15:26">maibee Nia gosta liafuan nebee hatudu laran diak.<verse eid="PRO 15:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />See mak manaan matak deit, nia lori susar ba nia uma kain,</para>
  <para style="q2" vid="PRO 15:27">maibee ema nebee lakohi halo korupsaun, nia sei moris.<verse eid="PRO 15:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />Ema moris loos tetu lai foin foo resposta,</para>
  <para style="q2" vid="PRO 15:28">maibee ema aat nia ibun fakar sai buat aat.<verse eid="PRO 15:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />NAI Maromak dook husi ema aat,</para>
  <para style="q2" vid="PRO 15:29">maibee Nia rona ema moris loos nia orasaun.<verse eid="PRO 15:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />See mak hatudu oin kontenti, nia halo haksolok ema seluk nia laran;</para>
  <para style="q2" vid="PRO 15:30">see mak foo sai lia menon nebee diak, nia halo ema nia ruin sai forti.<verse eid="PRO 15:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />See mak foo atensaun bainhira ema koriji nia atu nia moris bele sai diak,</para>
  <para style="q2" vid="PRO 15:31">nia sei hola parte iha ema matenek sira.<verse eid="PRO 15:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />See mak lakohi simu bainhira ema eduka, nia la respeita nia aan rasik,</para>
  <para style="q2" vid="PRO 15:32">maibee see mak rona bainhira ema koriji, nia aumenta matenek.<verse eid="PRO 15:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />See mak hamtauk NAI Maromak, nia aprende sai matenek;</para>
  <para style="q2" vid="PRO 15:33">ema tenki haraik aan mak foin hetan respeitu.<verse eid="PRO 15:33" /></para>
  <para style="b" />
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />Ema iha hanoin oinsaa atu hataan,</para>
  <para style="q2" vid="PRO 16:1">maibee resposta nebee sai husi nia ibun mai husi NAI Maromak.<verse eid="PRO 16:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />Tuir ema nia hanoin, saida mak nia halo loos hotu,</para>
  <para style="q2" vid="PRO 16:2">maibee NAI Maromak mak koko nia laran.<verse eid="PRO 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />Saida deit mak o atu halo, entrega ba NAI Maromak,</para>
  <para style="q2" vid="PRO 16:3">nunee o nia planu sei lao ho diak.<verse eid="PRO 16:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />NAI Maromak halo buat hotu-hotu tuir Nia planu rasik,</para>
  <para style="q2" vid="PRO 16:4">too Nia mos prepara dezastre atu bele kastigu ema aat sira.<verse eid="PRO 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />NAI Maromak hakribi see-see deit mak foti aan.</para>
  <para style="q2" vid="PRO 16:5">Hanoin di-diak, ema sira nee sei la sees husi kastigu.<verse eid="PRO 16:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />See mak iha domin, no kaer metin nia liafuan, nia sei hetan perdaun ba nia sala;</para>
  <para style="q2" vid="PRO 16:6">see mak hamtauk NAI Maromak hadook aan husi buat aat.<verse eid="PRO 16:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />Ema nebee moris halo haksolok NAI Maromak,</para>
  <para style="q2" vid="PRO 16:7">nia sei moris iha dame nia laran too nia inimigu mos diak malu ho nia.<verse eid="PRO 16:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />Diak liu iha sasaan uitoan maibee moris loos,</para>
  <para style="q2" vid="PRO 16:8">duke sai riku matak deit.<verse eid="PRO 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />Ema bele halo planu kona ba nia dalan moris,</para>
  <para style="q2" vid="PRO 16:9">maibee NAI Maromak mak desidi nia atu hakat ba loos nebee.<verse eid="PRO 16:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />Bainhira liurai koalia, nee hanesan NAI Maromak mak koalia,</para>
  <para style="q2" vid="PRO 16:10">nunee nia tesi lia sempre loos.<verse eid="PRO 16:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />Dasin nebee tetu sasaan ho lo-loos mai husi NAI Maromak;</para>
  <para style="q2" vid="PRO 16:11">Nia haruka ema faan sasaan tenki uza sasukat nebee loos.<verse eid="PRO 16:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />Liurai hakribi hahalok aat,</para>
  <para style="q2" vid="PRO 16:12">tanba justisa mak halo nia ukun bele dura.<verse eid="PRO 16:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />Ema nebee foo sai lia loos halo liurai kontenti;</para>
  <para style="q2" vid="PRO 16:13">see mak koalia buat nebee loos, liurai respeita.<verse eid="PRO 16:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />Bainhira liurai hirus, nee hatudu katak ema ruma tenki mate,</para>
  <para style="q2" vid="PRO 16:14">maibee ema matenek hatene halo malirin fali liurai nia laran.<verse eid="PRO 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />Bainhira liurai hatudu oin midar ba ema ruma, ema nee nia moris sei sai diak;</para>
  <para style="q2" vid="PRO 16:15">bainhira liurai haree diak ema, nee hanesan kalohan nebee lori udan been tuun tuir nia tempu.<verse eid="PRO 16:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />Aprende sai matenek iha valor liu dook duke osan mean;</para>
  <para style="q2" vid="PRO 16:16">kompriende klean diak liu duke osan mutin.<verse eid="PRO 16:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />Ema laran moos nia lalaok dook husi buat aat;</para>
  <para style="q2" vid="PRO 16:17">see mak lao kuidadu aan, salva nia vida.<verse eid="PRO 16:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />Ema nebee foti aan, nia moris sei sai aat;</para>
  <para style="q2" vid="PRO 16:18">ema nebee halo aan sei monu.<verse eid="PRO 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />Diak liu haraik aan no moris kiak,</para>
  <para style="q2" vid="PRO 16:19">duke goza sasaan nebee ema foti aan sira hadau.<verse eid="PRO 16:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />See mak rona bainhira ema hanorin, nia sei moris diak;</para>
  <para style="q2" vid="PRO 16:20">see mak laran metin ba NAI Maromak, nia hetan ksolok.<verse eid="PRO 16:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />Ema nebee matenek sei hetan naran diak tanba nia kompriende klean;</para>
  <para style="q2" vid="PRO 16:21">ema nebee koalia mamar, nia hanorin diak liu.<verse eid="PRO 16:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />Ema neon diak nia matenek hanesan bee matan nebee foo moris ba nia;</para>
  <para style="q2" vid="PRO 16:22">ema beik-teen hetan kastigu tanba nia hahalok beik.<verse eid="PRO 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />Ema matenek hanorin diak liu</para>
  <para style="q2" vid="PRO 16:23">tanba nia foo sai buat matenek husi nia laran.<verse eid="PRO 16:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />Liafuan nebee mamar hanesan bani nia knuuk;</para>
  <para style="q2" vid="PRO 16:24">liafuan nee midar iha ema nia laran no kura ema nia isin lolon.<verse eid="PRO 16:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />Ema balu senti dalan nebee nia liu nee loos hela,</para>
  <para style="q2" vid="PRO 16:25">afinal dalan nee lori nia ba mate.<note caller="+" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="PRO 14:12">Provérbiu 14:12</ref></char></note><verse eid="PRO 16:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />Ema nebee hamlaha obriga aan atu servisu makaas,</para>
  <para style="q2" vid="PRO 16:26">tanba nia kabun mak haruka.<verse eid="PRO 16:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />Ema nebee la iha valor moris, nia halo planu aat;</para>
  <para style="q2" vid="PRO 16:27">nia ibun hanesan fali ahi lakan nebee hakanek ema.<verse eid="PRO 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />Ema lohi door hamosu istori malu;</para>
  <para style="q2" vid="PRO 16:28">ema lori lia door halo belun diak fahe malu.<verse eid="PRO 16:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />Ema nebee gosta violensia hadau nia maluk nia laran</para>
  <para style="q2" vid="PRO 16:29">hodi lori nia lao tuir dalan nebee la diak.<verse eid="PRO 16:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />Ema nebee atu halo aat, foo sinal halimar matan;</para>
  <para style="q2" vid="PRO 16:30">ema nebee atu halo buat aat, foo sinal dulas ibun.<verse eid="PRO 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />See mak moris loos, nia hetan vida naruk;</para>
  <para style="q2" vid="PRO 16:31">nia fuuk mutin hanesan koroa nebee furak.<verse eid="PRO 16:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />Ema nebee iha pasiensia, nia diak liu fali funu nain ida;</para>
  <para style="q2" vid="PRO 16:32">ema nebee hatene domina aan, nia diak liu aswain nebee hadau sidade.<verse eid="PRO 16:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />Ema bele dada rifa,</para>
  <para style="q2" vid="PRO 16:33">maibee NAI Maromak mak desidi nia rezultadu.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />Diak liu haan paun maran fuan ida maibee haan ho hakmatek,</para>
  <para style="q2" vid="PRO 17:1">duke uma laran tomak festa hela deit maibee istori malu la hotu-hotu.<verse eid="PRO 17:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />Se patraun nia oan halo moe rai, entaun atan nebee matenek sei manda fali nia;</para>
  <para style="q2" vid="PRO 17:2">bainhira patraun mate, atan nee mak hetan riku-soin hamutuk ho patraun nia oan sira seluk.<verse eid="PRO 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />Ema uza ahi hodi koko osan mean ho osan mutin,</para>
  <para style="q2" vid="PRO 17:3">maibee ita ema nia laran, NAI Maromak mak koko.<verse eid="PRO 17:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />Ema aat see tilun ba ema nebee ibun aat;</para>
  <para style="q2" vid="PRO 17:4">ema bosok-teen gosta rona liafuan nebee hatuun ema.<verse eid="PRO 17:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />See mak hatete aat ema kiak sira, hatuun sira nia Kriador;</para>
  <para style="q2" vid="PRO 17:5">see mak hamnasa fali ema nebee hetan dezastre, nia la sees husi kastigu.<verse eid="PRO 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />Ferik-katuas sira nia ksolok mak bei-oan sira;</para>
  <para style="q2" vid="PRO 17:6">oan sira nia ksolok mak sira nia inan-aman.<verse eid="PRO 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />Ema beik-teen la merese koalia liafuan nebee aas;</para>
  <para style="q2" vid="PRO 17:7">saa tan ukun nain atu koalia lia bosok nee, la merese liu.<verse eid="PRO 17:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />Iha ema balu hanoin foo osan husi kotu-kotuk bele halo milagre ba nia;</para>
  <para style="q2" vid="PRO 17:8">hodi osan nee, nia halo saida deit, lao diak hotu.<verse eid="PRO 17:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />See mak foo perdaun ba nia maluk, nia hametin domin,</para>
  <para style="q2" vid="PRO 17:9">maibee see mak konta fila-fila nia maluk nia sala, sei lakon belun diak ida.<verse eid="PRO 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />See mak kompriende klean, ema koriji nia dala ida deit iha folin ba nia,</para>
  <para style="q2" vid="PRO 17:10">maibee see mak kakutak mamuk, ema baku dala atus ida mos nia la aprende buat ida.<verse eid="PRO 17:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />Ema aat gosta liu hamriik hasoru ukun nain sira;</para>
  <para style="q2" vid="PRO 17:11">too ikus ukun nain sira sei haruka ema foo kastigu todan ba nia.<verse eid="PRO 17:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />Diak liu hasoru animal siak nebee nia oan lakon,</para>
  <para style="q2" vid="PRO 17:12">duke hasoru ema beik-teen ida nebee halo buat beik.<verse eid="PRO 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />See mak halo aat ba ema nebee haree diak nia,</para>
  <para style="q2" vid="PRO 17:13">buat aat sei la sees husi nia uma.<verse eid="PRO 17:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />Provoka istori malu, hanesan halo kuak kanu,</para>
  <para style="q2" vid="PRO 17:14">nunee se hanoin la hanesan, lalika lori ba lia.<verse eid="PRO 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />Foo livre ba ema nebee halo sala ho hamonu fali kastigu ba ema nebee moris loos,</para>
  <para style="q2" vid="PRO 17:15">hahalok rua nee NAI Maromak hakribi hotu.<verse eid="PRO 17:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />Ema beik-teen gasta nia osan atu buka matenek, nia folin saida?</para>
  <para style="q2" vid="PRO 17:16">Nia la iha kapasidade atu aprende.<verse eid="PRO 17:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />Kolega sempre hatudu domin;</para>
  <para style="q2" vid="PRO 17:17">iha susar laran maun-alin sira sempre iha ba ita.<verse eid="PRO 17:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />See mak promete atu responsabiliza nia maluk nia tusan,</para>
  <para style="q2" vid="PRO 17:18">nia kakutak mamuk.<verse eid="PRO 17:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />Ema nebee gosta istori malu, gosta halo sala;</para>
  <para style="q2" vid="PRO 17:19">ema nebee gaba aan, konvida dezastre ba nia aan rasik.<verse eid="PRO 17:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />Ema nebee laran aat sei la hetan moris diak;</para>
  <para style="q2" vid="PRO 17:20">ema nebee ibun bosok-teen sei monu ba susar laran.<verse eid="PRO 17:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />Oan nebee beik-teen halo nia inan-aman laran dodok;</para>
  <para style="q2" vid="PRO 17:21">ema beik-teen nia inan-aman la iha ksolok.<verse eid="PRO 17:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />Laran kontenti, hanesan aimoruk diak nian;</para>
  <para style="q2" vid="PRO 17:22">fuan nebee rahun, halo ema nia ruin sai maran tiha.<verse eid="PRO 17:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />Ema aat simu prezenti husi kotu-kotuk</para>
  <para style="q2" vid="PRO 17:23">atu halakon fali justisa.<verse eid="PRO 17:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />Ema nebee kompriende klean, nia hanoin deit buat matenek,</para>
  <para style="q2" vid="PRO 17:24">maibee ema beik-teen nia hanoin halai rungu-ranga.<verse eid="PRO 17:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />Oan nebee beik-teen halo nia aman laran moras,</para>
  <para style="q2" vid="PRO 17:25">no halo nia inan kous laran susar.<verse eid="PRO 17:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />Atu haruka ema nebee la sala para selu fali multa,</para>
  <para style="q2" vid="PRO 17:26">hahalok nee la diak;</para>
  <para style="q2" vid="PRO 17:26">baku ema nebee laran diak, nee la loos.<verse eid="PRO 17:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />Ema nebee matenek kuidadu nia liafuan;</para>
  <para style="q2" vid="PRO 17:27">ema nebee kompriende klean, nia ulun malirin.<verse eid="PRO 17:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />Ema beik-teen, bainhira nia nonook, ema seluk hanoin nia ema matenek ida;</para>
  <para style="q2" vid="PRO 17:28">bainhira nia taka nia ibun, ema hanoin nia kompriende klean.<verse eid="PRO 17:28" /></para>
  <para style="b" />
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />See mak lakohi liga ema seluk, nia hanoin deit nia aan;</para>
  <para style="q2" vid="PRO 18:1">nia kontra ideia diak saida deit mak foo ba nia.<verse eid="PRO 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />Ema beik-teen lakohi atu kompriende buat ida;</para>
  <para style="q2" vid="PRO 18:2">nia so hakarak foo sai nia ideia rasik.<verse eid="PRO 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />See mak halo sala, ema sei haree nia la vale;</para>
  <para style="q2" vid="PRO 18:3">sira sei hamoe nia no tarata aat nia.<verse eid="PRO 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />Liafuan nebee sai husi ema matenek nia ibun hanesan bee nebee klean;</para>
  <para style="q2" vid="PRO 18:4">matenek nia huun hanesan bee matan nebee mak suli sai.<verse eid="PRO 18:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />Atu defende fali ema aat</para>
  <para style="q2" vid="PRO 18:5">hodi hamate justisa ba ema nebee moris loos, hahalok nee la diak.<verse eid="PRO 18:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />Ema beik-teen nia ibun hamosu istori malu;</para>
  <para style="q2" vid="PRO 18:6">nia liafuan provoka ema atu baku nia.<verse eid="PRO 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />Ema beik-teen nia liafuan halo terus nia aan rasik;</para>
  <para style="q2" vid="PRO 18:7">nia ibun sai lasu ba nia aan.<verse eid="PRO 18:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />See mak konta ema nia vida, nia liafuan hanesan fali hahaan midar;</para>
  <para style="q2" vid="PRO 18:8">liafuan nebee nia foo sai, tama too fuan laran.<verse eid="PRO 18:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />Ema nebee baruk servisu,</para>
  <para style="q2" vid="PRO 18:9">nia hanesan ho ema estraga door.<verse eid="PRO 18:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />NAI Maromak hanesan postu seguransa nebee metin;</para>
  <para style="q2" vid="PRO 18:10">ema nebee moris loos halai ba iha nebaa hodi hetan salvasaun.<verse eid="PRO 18:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />Ema riku sira nia sasaan hanesan moru forti nebee haleu sidade;</para>
  <para style="q2" vid="PRO 18:11">sira hanoin sira nia riku-soin hanesan fali moru aas hodi proteje sira.<verse eid="PRO 18:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />Ema nebee foti aan, too ikus sei monu rahun;</para>
  <para style="q2" vid="PRO 18:12">ema tenki haraik aan mak foin hetan respeitu.<verse eid="PRO 18:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />See mak seidauk rona ema nia liafuan maibee hataan kedas,</para>
  <para style="q2" vid="PRO 18:13">nia hatudu nia beik no hamoe nia aan rasik.<verse eid="PRO 18:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />Ema nebee espiritu forti sei aguenta iha moras laran,</para>
  <para style="q2" vid="PRO 18:14">maibee see ema lakon vontade moris, nia atu aguenta oinsaa?<verse eid="PRO 18:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />Ema nebee iha neon matenek aprende beibeik;</para>
  <para style="q2" vid="PRO 18:15">ema nebee kompriende klean, see tilun ba lia matenek.<verse eid="PRO 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />Prezenti nebee ema haruka uluk ba ema boot</para>
  <para style="q2" vid="PRO 18:16">loke odamatan ba nia atu tama iha ema boot nee nia prezensa.<verse eid="PRO 18:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />See mak koalia uluk iha tribunal, ema hanoin nia mak loos,</para>
  <para style="q2" vid="PRO 18:17">too ema seluk mai hodi investiga nia.<verse eid="PRO 18:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />Ema balu rezolve problema liu husi dada rifa;</para>
  <para style="q2" vid="PRO 18:18">ho nunee bele hapara ema boot sira istori malu.<verse eid="PRO 18:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />See mak hakanek nia maluk nia fuan, nia atu hakbesik fali susar liu duke tama iha moru aas laran;</para>
  <para style="q2" vid="PRO 18:19">istori malu haketak ema hanesan portaun boot nebee xavi metin.<verse eid="PRO 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />Liafuan matenek nebee ema foo sai lori buat diak ba nia;</para>
  <para style="q2" vid="PRO 18:20">nia liafuan too ikus foo rezultadu nebee halo nia kontenti.<verse eid="PRO 18:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />Ema nia liafuan bele halo ema mate ka moris;</para>
  <para style="q2" vid="PRO 18:21">see mak gosta koalia, nia liafuan sei fila fali ba nia.<verse eid="PRO 18:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />Se mane hola feto nebee diak, nia sorti boot;</para>
  <para style="q2" vid="PRO 18:22">nia simu prezenti furak ida husi NAI Maromak.<verse eid="PRO 18:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />Ema kiak husu tulun ho haraik aan,</para>
  <para style="q2" vid="PRO 18:23">maibee ema riku hataan ho siak.<verse eid="PRO 18:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />Iha ema balu lori terus ba nia kolega,</para>
  <para style="q2" vid="PRO 18:24">maibee belun nebee diak foo laran liu duke maun-alin.<verse eid="PRO 18:24" /></para>
  <para style="b" />
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />Diak liu sai ema kiak nebee moris loos</para>
  <para style="q2" vid="PRO 19:1">duke sai ema beik-teen nebee lohi door.<verse eid="PRO 19:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />Se ema hakarak teb-tebes halo buat ruma maibee la hatene halo, nee la diak;</para>
  <para style="q2" vid="PRO 19:2">see mak ansi atu lalais, sei lao sala dalan.<verse eid="PRO 19:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />Ema balu estraga sira nia moris liu husi sira nia hahalok beik,</para>
  <para style="q2" vid="PRO 19:3">depois sira nia laran hirus fali NAI Maromak.<verse eid="PRO 19:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />Ema riku hetan kolega barak,</para>
  <para style="q2" vid="PRO 19:4">maibee ema kiak nia kolega husik tiha nia mes-mesak.<verse eid="PRO 19:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />Ema nebee mak foo sasin falsu, nia sei hetan kastigu;</para>
  <para style="q2" vid="PRO 19:5">see mak habelar lia bosok, nia sei lori todan.<verse eid="PRO 19:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />Ema barak koko atu manaan ema boot nia laran;</para>
  <para style="q2" vid="PRO 19:6">ema nebee gosta foo prezenti hetan belun barak.<verse eid="PRO 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />Ema kiak nia maun-alin la gosta nia;</para>
  <para style="q2" vid="PRO 19:7">saa tan nia belun, sira hadook aan tiha husi nia.</para>
  <para style="q1" vid="PRO 19:7">Nia lao tuir hela sira hodi husu tulun,</para>
  <para style="q2" vid="PRO 19:7">maibee la hetan ema ida atu ajuda nia.<verse eid="PRO 19:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />See mak hetan matenek hodi kompriende, nia hadomi nia aan rasik;</para>
  <para style="q2" vid="PRO 19:8">see mak kaer metin buat nebee nia aprende, nia moris diak.<verse eid="PRO 19:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />Ema nebee foo sasin falsu, sei la sees husi kastigu;</para>
  <para style="q2" vid="PRO 19:9">see mak habelar lia bosok, sei lakon mohu.<verse eid="PRO 19:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />Ema beik-teen la merese atu moris hanesan ema riku;</para>
  <para style="q2" vid="PRO 19:10">aat liu tan mak atan ida ukun fali nai ulun sira.<verse eid="PRO 19:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />See mak iha neon diak, nia iha pasiensia;</para>
  <para style="q2" vid="PRO 19:11">ema gaba nia tanba nia hatene foo perdaun.<verse eid="PRO 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />Bainhira liurai laran nakali, nia hanesan liaun nebee hakilar makaas;</para>
  <para style="q2" vid="PRO 19:12">bainhira nia haree diak ema, nia hanesan mahobeen iha duut leten.<verse eid="PRO 19:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />Oan nebee kakutak mamuk lori dezastre ba nia aman;</para>
  <para style="q2" vid="PRO 19:13">feen nebee gosta istori malu, hanesan bee nebee turu tuun la para.<verse eid="PRO 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />Ema bele hetan uma ho riku-soin husi nia inan-aman,</para>
  <para style="q2" vid="PRO 19:14">maibee feen nebee neon matenek, NAI Maromak mak foo.<verse eid="PRO 19:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />Ema nebee baruk-teen toba haluha rai;</para>
  <para style="q2" vid="PRO 19:15">ema nebee lakohi book aan, sei hamlaha.<verse eid="PRO 19:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />See mak halo tuir ukun fuan, kuidadu nia vida,</para>
  <para style="q2" vid="PRO 19:16">maibee see mak lakohi foo folin ba nia lalaok moris, nia sei mate.<verse eid="PRO 19:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />See mak hatudu laran luak ba ema kiik, NAI Maromak konsidera hanesan tusan ida;</para>
  <para style="q2" vid="PRO 19:17">NAI sei selu fali nia hahalok diak nee.<verse eid="PRO 19:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />Koriji o nia oan bainhira o sei bele;</para>
  <para style="q2" vid="PRO 19:18">se o lakohi eduka nia, nee hanesan o hakarak lori nia ba mate.<verse eid="PRO 19:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />Ema nebee nervozu aat, nia tenki hetan kastigu;</para>
  <para style="q2" vid="PRO 19:19">se o salva nia, o presiza salva beibeik.<verse eid="PRO 19:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />Rona ho atensaun bainhira ema hanorin ka koriji o,</para>
  <para style="q2" vid="PRO 19:20">nunee too ikus o sai ema matenek ida.<verse eid="PRO 19:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />Ema nia ulun nakonu ho planu oi-oin,</para>
  <para style="q2" vid="PRO 19:21">maibee NAI Maromak mak desidi saida mak sei akontese.<verse eid="PRO 19:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />Buat nebee ema hakarak mak domin ho laran tomak;</para>
  <para style="q2" vid="PRO 19:22">diak liu moris kiak duke bosok tuun-sae.<verse eid="PRO 19:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />Ema nebee hamtauk NAI Maromak, sei hetan vida naruk;</para>
  <para style="q2" vid="PRO 19:23">nia sempre hetan ksolok, susar la besik nia.<verse eid="PRO 19:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />Ema baruk-teen hatama liman ba iha bikan laran,</para>
  <para style="q2" vid="PRO 19:24">maibee nia atu foti hahaan tau ba nia ibun, nia baruk.<verse eid="PRO 19:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />Se o baku ema kontra door, ema nebee la iha esperiensia moris bele aprende oinsaa atu moris;</para>
  <para style="q2" vid="PRO 19:25">se o koriji ema nebee kompriende klean ona, nia sei hatene liu tan.<verse eid="PRO 19:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />Ema nebee hadau nia aman nia uma hodi duni sai nia inan;</para>
  <para style="q2" vid="PRO 19:26">ema nee halo moe aan no hafoer nia familia nia naran.<verse eid="PRO 19:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />Oan, se o lakohi atu rona tan bainhira ema eduka o,</para>
  <para style="q2" vid="PRO 19:27">o sei fila kotuk ba buat nebee o aprende tiha ona.<verse eid="PRO 19:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />Ema nebee foo sasin falsu, nia hatuun fali justisa;</para>
  <para style="q2" vid="PRO 19:28">ema aat kaan hahalok aat hanesan fali hahaan midar.<verse eid="PRO 19:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />Ema kontra door merese hetan kastigu;</para>
  <para style="q2" vid="PRO 19:29">ema beik-teen merese atu ema baku.<verse eid="PRO 19:29" /></para>
  <para style="b" />
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />Tua provoka ema sai kontra door, serveja provoka ema halo rungu-ranga;</para>
  <para style="q2" vid="PRO 20:1">see mak hemu too lanu, nia la iha neon.<verse eid="PRO 20:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />Bainhira liurai laran nakali, nia hanesan liaun nebee hakilar makaas;</para>
  <para style="q2" vid="PRO 20:2">see mak provoka liurai nia hirus, sei lakon nia vida.<verse eid="PRO 20:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />See mak hadook aan husi konflitu, sei hetan naran diak,</para>
  <para style="q2" vid="PRO 20:3">maibee ema beik-teen gosta istori malu.<verse eid="PRO 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />Ema baruk-teen lakohi fila rai tuir nia tempu;</para>
  <para style="q2" vid="PRO 20:4">too tempu kolheta nia baa haree toos, la hetan buat ida.<verse eid="PRO 20:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />Ema nia hanoin hanesan bee posu nebee klean,</para>
  <para style="q2" vid="PRO 20:5">maibee ema nebee kompriende bele kuru.<verse eid="PRO 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />Ema barak deklara aan katak sira hatene hadomi ho laran tomak,</para>
  <para style="q2" vid="PRO 20:6">maibee ema nebee mak firmi nafatin, iha ka lae?<verse eid="PRO 20:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />Ema nebee moris loos sempre halo buat nebee diak;</para>
  <para style="q2" vid="PRO 20:7">nia oan sira mos hetan ksolok.<verse eid="PRO 20:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />Bainhira ukun nain tuur hodi foo justisa,</para>
  <para style="q2" vid="PRO 20:8">nia taes evidensia ida-idak hodi soe tiha buat nebee la diak.<verse eid="PRO 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />See mak bele deklara dehan, “Hau nia laran moos hela”?</para>
  <para style="q2" vid="PRO 20:9">See mak bele dehan, “Hau moos hela, la iha sala ida”?<verse eid="PRO 20:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />Dasin nebee tetu la loos ka sasukat nebee falsu,</para>
  <para style="q2" vid="PRO 20:10">NAI Maromak hakribi buat rua nee hotu.<verse eid="PRO 20:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />Ema bele konhese labarik sira husi sira nia lalaok;</para>
  <para style="q2" vid="PRO 20:11">sira nia hahalok hatudu sira moris loos no laran moos ka lae.<verse eid="PRO 20:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />Iha tilun hodi rona, iha matan hodi haree;</para>
  <para style="q2" vid="PRO 20:12">buat rua nee NAI Maromak mak kria hotu.<verse eid="PRO 20:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />Keta toba dukur hela deit, se lae o bele sai kiak;</para>
  <para style="q2" vid="PRO 20:13">hadeer ba, atu o bele iha ai haan barak too resin.<verse eid="PRO 20:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />Ema nebee atu sosa dehan, “Sasaan nee la diak, la diak liu!”</para>
  <para style="q2" vid="PRO 20:14">Depois nia baa gaba aan dehan nia hetan sasaan diak ho folin baratu.<verse eid="PRO 20:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />Ema bele iha osan mean ho morteen barak,</para>
  <para style="q2" vid="PRO 20:15">maibee liafuan matenek folin boot, hanesan fatuk murak karun nian.<verse eid="PRO 20:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />Se karik ema fuik deve osan iha o, depois ema seluk mak responsabiliza fali tusan nee, entaun o tenki foti pinoor husi ema nee;</para>
  <para style="q2" vid="PRO 20:16">se nia responsabiliza atu selu ema estranjeiru nia tusan ba o, rai di-diak sasaan nebee nia pinoor.<verse eid="PRO 20:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />Ai haan nebee ema naok, haan ba gostu,</para>
  <para style="q2" vid="PRO 20:17">maibee too ikus nia senti hanesan fatuk britas iha nia ibun laran.<verse eid="PRO 20:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />Rona uluk ema matenek nia hanoin mak o nia planu sai realidade;</para>
  <para style="q2" vid="PRO 20:18">molok atu baa halo funu, husu uluk matenek nain nia opiniaun.<verse eid="PRO 20:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />See mak konta ema nia vida, nia loke ema nia segredu,</para>
  <para style="q2" vid="PRO 20:19">nunee keta ranxu ema nebee ibun boot.<verse eid="PRO 20:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />See mak hatete aat nia inan-aman,</para>
  <para style="q2" vid="PRO 20:20">nia ahi oan sei mate iha tempu nakukun.<verse eid="PRO 20:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />See mak foti nia inan-aman nia riku-soin la tuir nia tempu,</para>
  <para style="q2" vid="PRO 20:21">too ikus riku-soin nee laos sai bensaun ba nia.<verse eid="PRO 20:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />Keta dehan, “Hau sei halo aat fali ema nebee mak halo aat hau;”</para>
  <para style="q2" vid="PRO 20:22">diak liu hein NAI Maromak, Nia sei tulun o.<verse eid="PRO 20:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />NAI Maromak hakribi dasin nebee tetu la loos;</para>
  <para style="q2" vid="PRO 20:23">sasukat nebee falsu Nia la gosta.<verse eid="PRO 20:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />NAI Maromak mak desidi dalan nebee ema lao tuir,</para>
  <para style="q2" vid="PRO 20:24">nunee oinsaa mak ita bele hatene buat nebee sei akontese iha ita nia moris?<verse eid="PRO 20:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />Se o promete atu foo buat ruma ba NAI Maromak maibee la tetu di-diak antes,</para>
  <para style="q2" vid="PRO 20:25">entaun o monta lasu ba o nia aan.<verse eid="PRO 20:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />Liurai nebee matenek haketak ema aat</para>
  <para style="q2" vid="PRO 20:26">hodi foo kastigu todan ba sira.<verse eid="PRO 20:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />Ita ema nia espiritu hanesan ahi oan nebee NAI Maromak foo ba ita</para>
  <para style="q2" vid="PRO 20:27">hodi leno sai buat nebee iha ita nia laran.<verse eid="PRO 20:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />Domin ho lia loos mak proteje liurai;</para>
  <para style="q2" vid="PRO 20:28">se liurai hatene hadomi, nia ukun sei dura.<verse eid="PRO 20:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />Ema gaba joven sira tanba sira forti;</para>
  <para style="q2" vid="PRO 20:29">ema respeita ferik-katuas sira tanba sira fuuk mutin.<verse eid="PRO 20:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />Liu husi baku makaas mak bele muda ema nia hahalok aat;</para>
  <para style="q2" vid="PRO 20:30">kastigu hanesan nee mak bele hamoos ema nia laran.<verse eid="PRO 20:30" /></para>
  <para style="b" />
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />Liurai nia neon iha NAI Maromak nia liman laran;</para>
  <para style="q2" vid="PRO 21:1">nia hanoin hanesan bee nebee suli tuir NAI nia dalan.<verse eid="PRO 21:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />Tuir ema nia hanoin, saida mak nia halo loos hotu,</para>
  <para style="q2" vid="PRO 21:2">maibee NAI Maromak mak koko ema nia laran.<verse eid="PRO 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />NAI Maromak gosta liu ema halo buat nebee loos ho justu,</para>
  <para style="q2" vid="PRO 21:3">duke hasae sakrifisiu ba Nia.<verse eid="PRO 21:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />Hahalok foti aan no halo aan sai hanesan fali matadalan ba ema aat;</para>
  <para style="q2" vid="PRO 21:4">hahalok nee pekadu.<verse eid="PRO 21:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />Ema nebee iha planu diak no servisu badinas sei hetan moris diak,</para>
  <para style="q2" vid="PRO 21:5">maibee ema nebee ansi atu riku lalais, sei sai kiak.<verse eid="PRO 21:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />Riku-soin nebee mak ema hetan liu husi dalan lohi</para>
  <para style="q2" vid="PRO 21:6">hanesan ahi suar nebee lakon derepenti, no hanesan lasu nebee hamate nia.<verse eid="PRO 21:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />Violensia nebee ema aat halo, too ikus sei dada nia ba rai kuak,</para>
  <para style="q2" vid="PRO 21:7">tanba nia lakohi halo buat nebee loos.<verse eid="PRO 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />Ema aat nia dalan kleuk ba-mai,</para>
  <para style="q2" vid="PRO 21:8">maibee ema laran moos nia hahalok sempre loos.<verse eid="PRO 21:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />Diak liu hela iha uma kakuluk nia lidun</para>
  <para style="q2" vid="PRO 21:9">duke hela uma ida ho feen nebee gosta istori malu.<verse eid="PRO 21:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />Ema aat nia laran hamlaha-hamrook ba violensia,</para>
  <para style="q2" vid="PRO 21:10">too nia maluk mos nia la hanoin tan.<verse eid="PRO 21:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />Bainhira kastigu ema kontra door, ema nebee la iha esperiensia moris haree hodi aprende;</para>
  <para style="q2" vid="PRO 21:11">Bainhira hanorin ema nebee iha ona matenek, nia sei aprende liu tan.<verse eid="PRO 21:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />Maromak Justisa Nain haree tu-tuir ema aat nia uma kain;</para>
  <para style="q2" vid="PRO 21:12">Nia sei hamonu ema aat ba iha dezastre laran.<verse eid="PRO 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />See mak taka tilun ba ema kbiit-laek nia halerik,</para>
  <para style="q2" vid="PRO 21:13">too tempu ida nia rasik husu ajuda, sei la hetan.<verse eid="PRO 21:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />Prezenti nebee ita foo ba ema ho nonook, sei hamaus ema nia laran;</para>
  <para style="q2" vid="PRO 21:14">prezenti nebee foo ho subar halo malirin tiha nia laran nakali.<verse eid="PRO 21:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />Bainhira justisa lao tuir nia dalan, ema nebee moris loos kontenti,</para>
  <para style="q2" vid="PRO 21:15">maibee ema nebee gosta halo buat aat sei tauk teb-tebes.<verse eid="PRO 21:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />See mak lao sees husi ema matenek nia dalan,</para>
  <para style="q2" vid="PRO 21:16">sei baa hamutuk ho matebian sira.<verse eid="PRO 21:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />See mak hakarak moris goza deit, too ikus sei sai kiak;</para>
  <para style="q2" vid="PRO 21:17">ema nebee kaan atu hemu tua no tau mina morin, nunka sai riku.<verse eid="PRO 21:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />Terus nebee ema moris loos atu hetan, too ikus monu fali ba ema aat;</para>
  <para style="q2" vid="PRO 21:18">susar nebee ema diak atu hetan, kona fali ema traidor.<verse eid="PRO 21:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />Diak liu hela iha rai fuik maran,</para>
  <para style="q2" vid="PRO 21:19">duke hela hamutuk ho feen nebee gosta istori malu no hirus door.<verse eid="PRO 21:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />Iha ema matenek nia uma iha riku-soin boot no ai haan diak nian,</para>
  <para style="q2" vid="PRO 21:20">maibee ema beik-teen gasta hotu buat nebee nia iha.<verse eid="PRO 21:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />See mak hakaas aan halo buat nebee loos no hadomi ema seluk,</para>
  <para style="q2" vid="PRO 21:21">nia sei hetan vida naruk, moris diak no respeitu.<verse eid="PRO 21:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />Ema matenek bele asalta aswain sira nia sidade</para>
  <para style="q2" vid="PRO 21:22">hodi harahun tiha fatin seguransa nebee sira konfia.<verse eid="PRO 21:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />Ema nebee kuidadu nia ibun ho nia liafuan,</para>
  <para style="q2" vid="PRO 21:23">nia proteje aan husi susar.<verse eid="PRO 21:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />See mak foti aan no gaba aan, ema bolu nia “kontra door”;</para>
  <para style="q2" vid="PRO 21:24">nia halo aan la hotu-hotu.<verse eid="PRO 21:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />Ema baruk-teen nia hakarak mak oho fali nia,</para>
  <para style="q2" vid="PRO 21:25">tanba nia liman lakohi halo servisu.<verse eid="PRO 21:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />Ema baruk-teen sempre kaan buat oi-oin deit,</para>
  <para style="q2" vid="PRO 21:26">maibee ema nebee moris loos foo sasaan ba ema ho laran luak.<verse eid="PRO 21:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />Bainhira ema aat hasae sakrifisiu ba NAI Maromak, NAI hakribi,</para>
  <para style="q2" vid="PRO 21:27">saa taan ema foo ho hanoin nebee aat.<verse eid="PRO 21:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />Ema nebee foo sasin falsu, nia sei mate,</para>
  <para style="q2" vid="PRO 21:28">maibee ema nebee rona ho atensaun, bainhira nia foo sasin, ema seluk sei simu.<verse eid="PRO 21:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />Ema aat hatudu oin mahar,</para>
  <para style="q2" vid="PRO 21:29">maibee ema nebee laran moos tetu ho kuidadu saida mak nia atu halo.<verse eid="PRO 21:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />La iha matenek, la iha neon,</para>
  <para style="q2" vid="PRO 21:30">la iha planu ida mak bele kontra NAI Maromak too manaan.<verse eid="PRO 21:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />Soldadu sira bele prepara kuda atu halo funu,</para>
  <para style="q2" vid="PRO 21:31">maibee atu manaan ka lae, NAI Maromak mak desidi.<verse eid="PRO 21:31" /></para>
  <para style="b" />
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />Naran diak nia folin boot liu riku-soin;</para>
  <para style="q2" vid="PRO 22:1">hetan respeitu diak liu duke hetan osan mean ho osan mutin.<verse eid="PRO 22:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />Iha buat ida mak halo ema riku ho ema kiak hanesan:</para>
  <para style="q2" vid="PRO 22:2">NAI Maromak mak kria sira nee hotu.<verse eid="PRO 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />Ema neon matenek haree situasaun perigu, nia lao sees tiha,</para>
  <para style="q2" vid="PRO 22:3">maibee ema matan tomak lao ba oin nafatin, too ikus hetan terus.<verse eid="PRO 22:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />Haraik aan no hamtauk NAI Maromak</para>
  <para style="q2" vid="PRO 22:4">halo ema sai riku, hetan naran diak no vida naruk.<verse eid="PRO 22:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />Dalan nebee ema aat lao tuir, iha ai tarak ho lasu,</para>
  <para style="q2" vid="PRO 22:5">maibee see mak kuidadu nia vida, nia lao sees tiha husi dalan nee.<verse eid="PRO 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />Hanorin labarik sira atu tuir dalan nebee loos,</para>
  <para style="q2" vid="PRO 22:6">nunee bainhira sira ferik-katuas ona, sira sei la husik dalan nee.<verse eid="PRO 22:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />Ema riku ukun ema kiak;</para>
  <para style="q2" vid="PRO 22:7">see mak deve ema nia osan, nia sai atan ba osan nain.<verse eid="PRO 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />Ema nebee kuda hahalok aat, nia kuu dezastre;</para>
  <para style="q2" vid="PRO 22:8">nia atu fakar sai nia hirus ba ema, la bele ona.<verse eid="PRO 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />Ema laran diak sei simu bensaun,</para>
  <para style="q2" vid="PRO 22:9">tanba nia fahe nia hahaan ba ema kiak sira.<verse eid="PRO 22:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />Duni sai tiha kontra door mak istori malu mos la iha ona;</para>
  <para style="q2" vid="PRO 22:10">haksesuk malu no hatete aat malu sei la iha tan.<verse eid="PRO 22:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />Ema nebee gosta moris ho laran moos, no koalia ho mamar,</para>
  <para style="q2" vid="PRO 22:11">nia sei sai liurai nia belun diak.<verse eid="PRO 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />NAI Maromak proteje lia loos,</para>
  <para style="q2" vid="PRO 22:12">maibee Nia hamonu tiha ema traidor nia liafuan.<verse eid="PRO 22:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />Ema baruk-teen dehan, “Liaun iha hela liur nebaa;</para>
  <para style="q2" vid="PRO 22:13">se hau sai karik, hau sei mate iha dalan.”<verse eid="PRO 22:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />Feto ulun bulak nia ibun hanesan rai kuak klean;</para>
  <para style="q2" vid="PRO 22:14">mane nebee NAI Maromak atu kastigu, sei monu tama ba laran.<verse eid="PRO 22:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />Hahalok beik belit iha labarik sira nia laran;</para>
  <para style="q2" vid="PRO 22:15">bainhira uza rota hodi hanorin mak bele halakon hahalok nee husi sira.<verse eid="PRO 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />Ema nebee haan matak ema kiak hodi hariku fali nia aan,</para>
  <para style="q2" vid="PRO 22:16">no ema nebee foo prezenti ba ema riku, too ikus sei sai kiak hotu.<verse eid="PRO 22:16" /></para>
  <para style="s">Lia matenek tolu-nulu</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />See tilun hodi rona matenek nain sira nia liafuan;</para>
  <para style="q2" vid="PRO 22:17">foo atensaun ba buat nebee hau hanorin.<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />Tanba bainhira o rai liafuan nee iha o nia laran,</para>
  <para style="q2" vid="PRO 22:18">no o nia ibun prontu foo tutan, o sei hetan ksolok.<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />Agora hau foo sai matenek nee ba o, ba o duni,</para>
  <para style="q2" vid="PRO 22:19">atu o bele laran metin ba NAI Maromak.<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />Hau hakerek lia matenek tolu-nulu ba o;</para>
  <para style="q2" vid="PRO 22:20">lia matenek nee hatudu dalan ba o, no halo o hatene klean.<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />Liafuan sira nee sei halo o hatene buat nebee loos ho tebes,</para>
  <para style="q2" vid="PRO 22:21">atu nunee o bele hataan ho lo-loos ba ema nebee haruka o mai.<verse eid="PRO 22:21" /></para>
  <para style="s2">1</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />Keta hanehan ema kiak tanba deit nia kiak;</para>
  <para style="q2" vid="PRO 22:22">bainhira tesi ema kbiit-laek nia lia, keta tau todan ba nia.<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />Tanba NAI Maromak sei defende ema kbiit-laek;</para>
  <para style="q2" vid="PRO 22:23">see mak hasai sira nia direitu, NAI sei hasai ema nee nia vida.<verse eid="PRO 22:23" /></para>
  <para style="s2">2</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />Keta halo belun ho ema nebee mak nervozu aat;</para>
  <para style="q2" vid="PRO 22:24">keta ranxu ema nebee hirus door.<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />Se lae o bele aprende hahalok aat husi nia;</para>
  <para style="q2" vid="PRO 22:25">too ikus o tama ba lasu laran, o sai fali la diak.<verse eid="PRO 22:25" /></para>
  <para style="s2">3</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />Se karik ema seluk deve osan, keta responsabiliza nia tusan nee;</para>
  <para style="q2" vid="PRO 22:26">lalika promete atu selu sasaan nebee ema seluk deve.<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />Se o la konsege selu fali tusan nee,</para>
  <para style="q2" vid="PRO 22:27">ema sei mai foti o nia sasaan too hiit hotu o nia toba fatin.<verse eid="PRO 22:27" /></para>
  <para style="s2">4</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />Fatuk nebee o nia bei-ala sira hatuur</para>
  <para style="q2" vid="PRO 22:28">hodi marka baliza rai, o la bele muda fali.<verse eid="PRO 22:28" /></para>
  <para style="s2">5</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />Haree took ema nebee matenek halao nia servisu;</para>
  <para style="q2" vid="PRO 22:29">Nia sei serbi liurai, laos ema kiik.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="s2">6</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />Bainhira o tuur hodi haan hamutuk ho nai ulun ruma,</para>
  <para style="q2" vid="PRO 23:1">foo atensaun di-diak ba saida mak iha o nia oin.<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />Se karik o gosta haan barak,</para>
  <para style="q2" vid="PRO 23:2">tau tudik ba iha o nia kakorok.<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />La bele kaan hahaan furak nebee uma nain nee prepara;</para>
  <para style="q2" vid="PRO 23:3">keta halo be nia tau hahaan nee atu lasu o.<verse eid="PRO 23:3" /></para>
  <para style="s2">7</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />Lalika gasta o nia forsa tomak atu sai riku;</para>
  <para style="q2" vid="PRO 23:4">sai matenek ba, keta duni tuir riku-soin.<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />Tanba o hateke lalais deit, riku-soin la iha tiha ona;</para>
  <para style="q2" vid="PRO 23:5">derepenti iha liras hanesan manu makikit hodi semo aas tiha.<verse eid="PRO 23:5" /></para>
  <para style="s2">8</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />Lalika haan ema karak-teen nia ai haan;</para>
  <para style="q2" vid="PRO 23:6">keta kaan hahaan furak nebee nia prepara,<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />tanba ema hanesan nee sempre sura tu-tuir sasaan nia folin;</para>
  <para style="q2" vid="PRO 23:7">nia ibun dehan, “Mai haan-hemu ba!” Maibee nia laran lakohi foo.<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />Hahaan uitoan nebee o tolan tiha ona, o sei muta sai fali;</para>
  <para style="q2" vid="PRO 23:8">ohin o gaba nia mos saugati deit.<verse eid="PRO 23:8" /></para>
  <para style="s2">9</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />Keta koalia ba ema beik-teen,</para>
  <para style="q2" vid="PRO 23:9">tanba nia sei la simu matenek nebee o foo sai ba nia.<verse eid="PRO 23:9" /></para>
  <para style="s2">10</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />Fatuk nebee uluk kedas marka baliza rai nian, o la bele muda fali;</para>
  <para style="q2" vid="PRO 23:10">keta hadau oan kiak sira nia rai.<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />Tanba sira nia Defensor iha kbiit boot;</para>
  <para style="q2" vid="PRO 23:11">Nia sei foti sira nia kazu hodi kontra fali o.<verse eid="PRO 23:11" /></para>
  <para style="s2">11</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />Foo atensaun ba hau nia hanorin;</para>
  <para style="q2" vid="PRO 23:12">see tilun ba lia matenek nebee hau foo.<verse eid="PRO 23:12" /></para>
  <para style="s2">12</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />La bele tauk atu eduka o nia oan;</para>
  <para style="q2" vid="PRO 23:13">kastigu nia ho rota sei la hamate nia.<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />Kastigu o nia oan ho rota,</para>
  <para style="q2" vid="PRO 23:14">nunee o bele salva nia husi matebian sira nia fatin.<verse eid="PRO 23:14" /></para>
  <para style="s2">13</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />Oan, se o matenek,</para>
  <para style="q2" vid="PRO 23:15">hau mos kontenti;<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />bainhira o nia ibun koalia lia loos,</para>
  <para style="q2" vid="PRO 23:16">hau nia laran sei haksolok teb-tebes.<verse eid="PRO 23:16" /></para>
  <para style="s2">14</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />Keta laran moras ba ema aat,</para>
  <para style="q2" vid="PRO 23:17">maibee hakaas aan hamtauk NAI Maromak.<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />Nunee o nia futuru sei sai diak;</para>
  <para style="q2" vid="PRO 23:18">buat nebee o hein sei akontese ba o.<verse eid="PRO 23:18" /></para>
  <para style="s2">15</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />Oan, rona mai, sai matenek ba;</para>
  <para style="q2" vid="PRO 23:19">hanoin di-diak oinsaa atu moris tuir dalan loos.<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />La bele ranxu ema nebee lanu-teen</para>
  <para style="q2" vid="PRO 23:20">ka ema nebee kaan-teen ba naan.<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />Tanba lanu-teen ho kaan-teen sei sai kiak;</para>
  <para style="q2" vid="PRO 23:21">sira hatais ropa mesak naklees tanba sira matan dukur hela deit.<verse eid="PRO 23:21" /></para>
  <para style="s2">16</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />Rona o nia aman, nia mak foo moris ba o;</para>
  <para style="q2" vid="PRO 23:22">bainhira o nia inan ferik ona, o tenki respeita nafatin nia.<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />Hakaas aan atu aprende lia loos, keta troka fali lia loos ho riku-soin;</para>
  <para style="q2" vid="PRO 23:23">sai matenek ba, aprende ba, sai ema nebee kompriende klean ba.<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />Aman ida laran haksolok teb-tebes bainhira nia oan moris loos;</para>
  <para style="q2" vid="PRO 23:24">nia kontenti teb-tebes ho oan nebee matenek.<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />Nunee halo kontenti o nia inan-aman ba;</para>
  <para style="q2" vid="PRO 23:25">halo haksolok inan nebee kous o.<verse eid="PRO 23:25" /></para>
  <para style="s2">17</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />Oan, loke o nia laran mai hau;</para>
  <para style="q2" vid="PRO 23:26">hateke beibeik ba hau nia lalaok moris.<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />Tanba feto luroon hanesan rai kuak nebee naruk;</para>
  <para style="q2" vid="PRO 23:27">feto nebee ulun bulak hanesan bee posu kloot ida.<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />Nia hanesan naok-teen nebee hafuhu hela ema atu asalta;</para>
  <para style="q2" vid="PRO 23:28">nia halo mane barak la kumpri sira nia promesa ba sira nia feen.<verse eid="PRO 23:28" /></para>
  <para style="s2">18</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />See mak terus? See mak laran susar?</para>
  <para style="q2" vid="PRO 23:29">See mak istori malu? See mak halerik?</para>
  <para style="q1" vid="PRO 23:29">See mak hetan kanek saugati?</para>
  <para style="q2" vid="PRO 23:29">See mak matan mean?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />Ema nebee hemu tua too kalan boot;</para>
  <para style="q2" vid="PRO 23:30">ema nebee gosta koko tua kahur ho buat oi-oin.<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />Keta matan lakan ba tua kor mean kapaas</para>
  <para style="q2" vid="PRO 23:31">nebee nabilan iha kalis laran</para>
  <para style="q2" vid="PRO 23:31">no suli tuun mamar loos iha kakorok.<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />Too ikus tua nee tata o hanesan samea,</para>
  <para style="q2" vid="PRO 23:32">no moruk hanesan samodok nia veneno.<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />Depois o nia matan sei haree buat nebee oin seluk liu,</para>
  <para style="q2" vid="PRO 23:33">no o nia laran foo sai liafuan arbiru.<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />O sai hanesan ema nebee bulelu iha tasi klaran;</para>
  <para style="q2" vid="PRO 23:34">o sai hanesan ema nebee latan aan iha roo nia riin leten.<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />O sei dehan, “Ema baku hau, maibee la moras ida;</para>
  <para style="q2" vid="PRO 23:35">ema tuku hau fila-fila, maibee hau la senti buat ida.</para>
  <para style="q1" vid="PRO 23:35">Bainhira loos mak hau bele hadeer fali</para>
  <para style="q2" vid="PRO 23:35">hodi hetan tan tua?”<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="s2">19</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />Keta laran moras ba ema aat,</para>
  <para style="q2" vid="PRO 24:1">lalika buka atu ranxu sira.<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />Tanba sira nia kakutak planu hela atu halo violensia;</para>
  <para style="q2" vid="PRO 24:2">sira nia ibun koalia oinsaa atu halo susar ema.<verse eid="PRO 24:2" /></para>
  <para style="s2">20</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />Hodi matenek ema harii uma;</para>
  <para style="q2" vid="PRO 24:3">hodi kapasidade nia halo uma metin;<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />hodi konhesimentu nia enxe uma</para>
  <para style="q2" vid="PRO 24:4">ho sasaan mesak furak ho folin karun.<verse eid="PRO 24:4" /></para>
  <para style="s2">21</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />Ema matenek iha poder boot;</para>
  <para style="q2" vid="PRO 24:5">ema nebee iha konhesimentu, aumenta nia forsa.<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />Tanba bainhira ema matenek hatudu dalan, o bele halo funu;</para>
  <para style="q2" vid="PRO 24:6">ho matenek nain barak nia ideia, o sei manaan.<verse eid="PRO 24:6" /></para>
  <para style="s2">22</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />Lia matenek aas liu ba ema beik-teen;</para>
  <para style="q2" vid="PRO 24:7">bainhira ema tesi lia iha portaun sidade nian, ema beik-teen taka ibun deit.<verse eid="PRO 24:7" /></para>
  <para style="s2">23</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />See mak hanoin aat hela deit,</para>
  <para style="q2" vid="PRO 24:8">ema sei hanaran problema door.<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />Planu saida deit mak ema beik-teen halo, nee pekadu;</para>
  <para style="q2" vid="PRO 24:9">see mak sai kontra door, ema sei hakribi nia.<verse eid="PRO 24:9" /></para>
  <para style="s2">24</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />Se o foti liman deit iha tempu susar,</para>
  <para style="q2" vid="PRO 24:10">o nee forsa kiik liu.<verse eid="PRO 24:10" /></para>
  <para style="s2">25</para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />Se ema lori vitima ida atu ba oho, salva tiha ba;</para>
  <para style="q2" vid="PRO 24:11">bainhira vitima nee lao bulelu ba iha fatin nebee ema atu oho nia, defende nia ba.<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />Se o dehan fali, “Kona ba ida nee, ami la hatene buat ida,”</para>
  <para style="q2" vid="PRO 24:12">Maromak ida nebee koko ema nia laran, la haree fali ka?</para>
  <para style="q1" vid="PRO 24:12">Ida nebee kuidadu o nia moris, la hatene ka?</para>
  <para style="q2" vid="PRO 24:12">Nia sei selu fali ema ida-idak tuir saida mak sira halo.<verse eid="PRO 24:12" /></para>
  <para style="s2">26</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />Oan, haan bani been nee diak ba o;</para>
  <para style="q2" vid="PRO 24:13">bani been husi nia knuuk nee midar iha o nia ibun.<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />Nunee mos matenek nee midar ba o nia moris;</para>
  <para style="q2" vid="PRO 24:14">se o hetan matenek, o nia futuru sei sai diak;</para>
  <para style="q2" vid="PRO 24:14">buat nebee o hein sei akontese ba o.<verse eid="PRO 24:14" /></para>
  <para style="s2">27</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />Keta subar hanesan ema kriminozu hodi hafuhu fali ema moris loos nia uma;</para>
  <para style="q2" vid="PRO 24:15">keta estraga nia hela fatin.<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />Tanba ema nebee moris loos bele monu too dala hitu mos, sei hamriik fila fali,</para>
  <para style="q2" vid="PRO 24:16">maibee ema aat monu ba susar laran, hakdasak kedas.<verse eid="PRO 24:16" /></para>
  <para style="s2">28</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />La bele kontenti bainhira o nia inimigu monu ba terus laran;</para>
  <para style="q2" vid="PRO 24:17">se nia monu hakdasak, o nia laran keta haksolok.<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />Tanba NAI Maromak haree o nia hahalok nee la diak,</para>
  <para style="q2" vid="PRO 24:18">nunee Nia la fakar tan Nia hirus ba ema nee.<verse eid="PRO 24:18" /></para>
  <para style="s2">29</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />Keta preokupa ho ema aat sira;</para>
  <para style="q2" vid="PRO 24:19">keta laran moras ba ema nebee hahalok aat.<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />Tanba ema aat la iha futuru diak;</para>
  <para style="q2" vid="PRO 24:20">sira nia ahi oan sei mate.<verse eid="PRO 24:20" /></para>
  <para style="s2">30</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />Oan, hamtauk NAI Maromak, hamtauk mos liurai;</para>
  <para style="q2" vid="PRO 24:21">keta lao hamutuk ho kontra door sira.<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />Tanba derepenti NAI Maromak ho liurai hamonu sira ba susar laran;</para>
  <para style="q2" vid="PRO 24:22">dezastre nebee mosu, see mak bele hatene tuir?<verse eid="PRO 24:22" /></para>
  <para style="ms1">Lia matenek tan</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />Tuir mai iha tan lia matenek husi matenek nain.</para>
  <para style="q1" vid="PRO 24:23">Se juis nebee tesi lia haliis ba parte ida, nee la loos.<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />Se nia hatete fali ba ema nebee halo sala dehan, “O la sala ida,”</para>
  <para style="q2" vid="PRO 24:24">entaun povu sei foo malisan ba nia, nasaun seluk sei hatete aat nia.<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />Maibee se nia kastigu ema nebee halo sala,</para>
  <para style="q2" vid="PRO 24:25">nia sei moris diak no hetan bensaun oi-oin.<verse eid="PRO 24:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />See mak hataan ema ho lo-loos,</para>
  <para style="q2" vid="PRO 24:26">nia hatudu nia aan nudar kolega diak ida.<note caller="+" style="f"><char style="fr" closed="false">24:26 </char><char style="ft" closed="false">Lian Ebreu dehan, “nia rei iha ibun kulit.”</char></note><verse eid="PRO 24:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />Halo hotu tiha o nia servisu iha liur,</para>
  <para style="q2" vid="PRO 24:27">prepara o nia toos,</para>
  <para style="q2" vid="PRO 24:27">depois mak foin harii o nia uma.<verse eid="PRO 24:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />Keta foo testemunha nar-naran hasoru o nia vizinhu;</para>
  <para style="q2" vid="PRO 24:28">o nia ibun keta foo sai lia falsu.<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />Keta dehan, “Saida mak nia halo mai hau, hau sei halo fali ba nia;</para>
  <para style="q2" vid="PRO 24:29">hau sei selu fali saida mak nia halo ona mai hau.”<verse eid="PRO 24:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />Hau lao liu husi ema baruk-teen nia toos;</para>
  <para style="q2" vid="PRO 24:30">hau lao liu husi ema kakutak mamuk nia toos uvas.<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />Hau haree ba, duut tarak mak buras iha toos laran;</para>
  <para style="q2" vid="PRO 24:31">duut aat mak moris nakonu tiha iha nia rai laran;</para>
  <para style="q2" vid="PRO 24:31">nia lutu fatuk mos monu tiha ona.<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />Hau hanoin di-diak kona ba buat nebee hau haree nee;</para>
  <para style="q2" vid="PRO 24:32">buat nebee hau haree nee, hau aprende hanesan lisaun ida.<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />Ema baruk teen dehan, “Hau toba uitoan lai, toba halimar lai,</para>
  <para style="q2" vid="PRO 24:33">hakuak liman hodi deskansa lai.”<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />Nunee kiak sei mosu mai derepenti hanesan naok-teen;</para>
  <para style="q2" vid="PRO 24:34">mukit sei mai hanesan ema nebee kaer kroat.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="ms1">Lia matenek balu tan husi liurai Salomão</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />Iha tan lia matenek husi Salomão. Liurai Judá ida naran Ezequias nia funsionariu mak hakerek tuir.<verse eid="PRO 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />Ema hahii Maromak tanba buat nebee Maromak la hatudu sai;</para>
  <para style="q2" vid="PRO 25:2">ema gaba liurai tanba buat nebee liurai deskobre.<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />Liurai sira nia laran, ema ida la bele hatene;</para>
  <para style="q2" vid="PRO 25:3">sira nia hanoin aas hanesan lalehan no klean hanesan tasi.<verse eid="PRO 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />Hasai tiha foer husi osan mutin</para>
  <para style="q2" vid="PRO 25:4">mak badaen bele halo buat nebee furak.<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />Hasai tiha ema aat husi liurai nia oin</para>
  <para style="q2" vid="PRO 25:5">mak liurai nia ukun bele dura tanba nia ukun ho justisa.<verse eid="PRO 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />La bele foti aan iha liurai nia oin;</para>
  <para style="q2" vid="PRO 25:6">lalika baa hamriik iha nai ulun sira nia klaran.<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />Diak liu liurai dehan ba o, “Sae mai iha nee,”</para>
  <para style="q2" vid="PRO 25:7">duke nia hatuun o iha ema boot nia oin.</para>
  <para style="b" vid="PRO 25:7" />
  <para style="q1" vid="PRO 25:7">Se o nia matan haree buat ruma,<verse eid="PRO 25:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 25:8" />la bele ansi baa hatoo keixa iha tribunal.</para>
  <para style="q1" vid="PRO 25:8">Se lae ema bele hamoe o,</para>
  <para style="q2" vid="PRO 25:8">depois o atu halo saida tan?<verse eid="PRO 25:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />Bainhira o istori malu ho o nia vizinhu,</para>
  <para style="q2" vid="PRO 25:9">keta foo sai nia segredu.<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />Se lae ema nebee rona bele hamoe fali o,</para>
  <para style="q2" vid="PRO 25:10">nunee o nia naran sai aat nafatin ba nafatin.<verse eid="PRO 25:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />Liafuan nebee hatoo tuir nia tempu</para>
  <para style="q2" vid="PRO 25:11">hanesan osan mutin nebee enfeita ho osan mean.<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />Se ema see tilun bainhira ema matenek koriji nia,</para>
  <para style="q2" vid="PRO 25:12">nee hanesan nia simu brinkus osan mean ka kadeli osan mean diak nian.<verse eid="PRO 25:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />See mak foo tutan patraun nia lia menon ho lo-loos,</para>
  <para style="q2" vid="PRO 25:13">nia hanesan bee malirin iha tempu manas</para>
  <para style="q2" vid="PRO 25:13">hodi halo kontenti patraun nia laran.<verse eid="PRO 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />Ema nebee gaba aan hodi promete atu foo prezenti, maibee la foo,</para>
  <para style="q2" vid="PRO 25:14">nia hanesan kalohan no anin nebee la hatuun udan.<verse eid="PRO 25:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />Ema nebee pasiensia bele muda nai ulun nia hanoin;</para>
  <para style="q2" vid="PRO 25:15">liafuan mamar bele halo ema ulun toos sai mamar tiha.<verse eid="PRO 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />Se o hetan bani been, hemu natoon;</para>
  <para style="q2" vid="PRO 25:16">keta hemu too bosu liu, depois muta sai fali.<verse eid="PRO 25:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />Keta baa beibeik iha o nia vizinhu nia uma;</para>
  <para style="q2" vid="PRO 25:17">keta halo be nia baruk too la gosta o.<verse eid="PRO 25:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />Ema nebee foo sasin falsu kona ba nia maluk,</para>
  <para style="q2" vid="PRO 25:18">nia hanesan ai dona, surik ka rama oan nebee mak kroat.<verse eid="PRO 25:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />Konfia ema lohi door iha susar laran,</para>
  <para style="q2" vid="PRO 25:19">nee hanesan nata hahaan ho nehan nebee dodok ka lao ho ain nebee naksalak.<verse eid="PRO 25:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />See mak hananu kantiku ksolok nian ba ema nebee laran susar,</para>
  <para style="q2" vid="PRO 25:20">nia hanesan hasai ema nia faru manas iha tempu malirin,</para>
  <para style="q2" vid="PRO 25:20">no hanesan fui tua siin ba kanek.<verse eid="PRO 25:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />Se karik o nia inimigu hamlaha, foo hahaan ba nia para nia haan,</para>
  <para style="q2" vid="PRO 25:21">se karik nia hamrook, foo bee ba nia hemu.<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />Se o halo nunee, nia sei moe, <note caller="+" style="f"><char style="fr" closed="false">25:22 </char><char style="ft" closed="false">Lian Ebreu dehan, “O tau ahi klaak ba iha nia ulun.” </char></note><note caller="+" style="x"><char style="xo" closed="false">25:21-22 </char><char style="xt" closed="false"><ref loc="ROM 12:20">Roma 12:20</ref></char></note></para>
  <para style="q2" vid="PRO 25:22">no NAI Maromak sei selu buat nebee mak o halo.<verse eid="PRO 25:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />Anin nebee huu husi parte norte halo udan tuun;</para>
  <para style="q2" vid="PRO 25:23">nunee mos koalia konta ema nia vida halo ema oin buis.<verse eid="PRO 25:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />Diak liu hela iha uma kakuluk nia lidun,</para>
  <para style="q2" vid="PRO 25:24">duke hela uma ida ho feen nebee gosta istori malu.<verse eid="PRO 25:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />Novidade diak husi rai dook,</para>
  <para style="q2" vid="PRO 25:25">hanesan bee malirin ba ema nebee hamrook.<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />Ema moris loos nebee rende iha ema aat sira nia oin,</para>
  <para style="q2" vid="PRO 25:26">hanesan bee matan merak ka hanesan bee inan nebee foer.<verse eid="PRO 25:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />Hemu bani been barak, la diak;</para>
  <para style="q2" vid="PRO 25:27">nunee mos buka naran, la diak.<verse eid="PRO 25:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />Ema nebee la hatene domina aan,</para>
  <para style="q2" vid="PRO 25:28">nia hanesan sidade nebee la iha ona moru haleu.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />Se ema beik-teen hetan naran diak,</para>
  <para style="q2" vid="PRO 26:1">nee hanesan neve monu fali iha rai manas, no hanesan udan boot iha tempu kolheta.<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />Malisan la kona ema nebee la sala,</para>
  <para style="q2" vid="PRO 26:2">hanesan manu fuik nebee semo baa semo mai, ain la kona rai.<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />Sikoti hodi baku kuda, freiu hodi tau ba kuda buru nia ibun;</para>
  <para style="q2" vid="PRO 26:3">rota hodi baku ema beik-teen nia kotuk.<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />Se ema beik-teen husu buat beik ba o, keta hataan ho beik,</para>
  <para style="q2" vid="PRO 26:4">se lae o mos beik hanesan nia.<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />Se ema beik-teen husu buat beik ba o, hataan tuir nia beik,</para>
  <para style="q2" vid="PRO 26:5">se lae nia konsidera aan matenek.<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />See mak haruka fali ema beik-teen lori lia menon,</para>
  <para style="q2" vid="PRO 26:6">nia hanesan ema nebee tesi nia ain rasik ka hemu veneno.<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />Se ema beik-teen mak foo sai fali lia matenek ruma,</para>
  <para style="q2" vid="PRO 26:7">nia liafuan hanesan ema nia ain nebee mamar tiha, lao la bele.<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />See mak tane aas ema beik-teen,</para>
  <para style="q2" vid="PRO 26:8">nia hanesan ema nebee tau fatuk ba iha fiska depois kesi metin fali.<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />Se ema beik-teen mak repete fali lia matenek ruma nebee nia rona,</para>
  <para style="q2" vid="PRO 26:9">nee hanesan lanu-teen kaer ai sanak tarak hodi baku ba-mai.<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />Ema nebee foo servisu ba ema beik-teen ka ba see-see deit mak liu dadauk,</para>
  <para style="q2" vid="PRO 26:10">nia hanesan ema hana door nebee hakanek ema arbiru.<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />Bainhira asu muta, nia rasik sei lambe fila fali;<note caller="+" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="2PE 2:22">2 Pedro 2:22</ref></char></note></para>
  <para style="q2" vid="PRO 26:11">nunee mos ema beik-teen repete fali nia hahalok beik.<verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />O haree ema nebee estilus matenek ka?</para>
  <para style="q2" vid="PRO 26:12">Nia futuru aat liu fali ema beik-teen nian.<verse eid="PRO 26:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />Ema baruk-teen dehan, “Liaun iha hela dalan nebaa;</para>
  <para style="q2" vid="PRO 26:13">liaun iha rai luan nebaa!”<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />Hanesan odamatan nia dobralisa nebee dulas aan ba-mai,</para>
  <para style="q2" vid="PRO 26:14">nunee mos ema baruk-teen duir aan ba-mai iha nia toba fatin.<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />Ema baruk-teen hatama liman ba iha bikan laran,</para>
  <para style="q2" vid="PRO 26:15">maibee nia baruk atu foti hahaan hodi tau ba nia ibun.<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />Ema baruk-teen konsidera nia aan matenek</para>
  <para style="q2" vid="PRO 26:16">liu fali ema nain hitu nebee foo resposta ho neon.<verse eid="PRO 26:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />See mak mete fali ema seluk nebee istori malu,</para>
  <para style="q2" vid="PRO 26:17">nia hanesan ema nebee dada asu nia tilun iha dalan.<verse eid="PRO 26:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18-19" style="v" sid="PRO 26:18-19" />Ema nebee lohi nia maluk</para>
  <para style="q2" vid="PRO 26:18-19">depois dehan, “Hau koalia halimar deit,”</para>
  <para style="q1" vid="PRO 26:18-19">nia hanesan ema bulak nebee hana rama oan lakan,</para>
  <para style="q2" vid="PRO 26:18-19">rama oan nebee hamate ema.<verse eid="PRO 26:18-19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />Bainhira ai sunu hotu ona, ahi la lakan tan;</para>
  <para style="q2" vid="PRO 26:20">bainhira ema lori lia door la iha ona, istori malu para ona.<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />See mak gosta istori malu, nia sunu ema atu haksesuk malu,</para>
  <para style="q2" vid="PRO 26:21">hanesan ema nebee tau ahi anar ba ahi klaak, ka tau ai ba ahi halo lakan boot.<verse eid="PRO 26:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />See mak konta ema nia vida, nia liafuan hanesan fali hahaan midar;</para>
  <para style="q2" vid="PRO 26:22">liafuan nebee nia foo sai tama too ema nia fuan laran.<verse eid="PRO 26:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />Ema laran aat nebee koalia ho ibun midar,</para>
  <para style="q2" vid="PRO 26:23">nia hanesan sanan rai nebee pinta halo furak.<verse eid="PRO 26:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />Ema nebee rai odiu, finji koalia ho ibun midar,</para>
  <para style="q2" vid="PRO 26:24">maibee nia laran bosok-teen.<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />Maski nia koalia ho mamar, keta fiar nia,</para>
  <para style="q2" vid="PRO 26:25">tanba nia laran nakonu ho hahalok aat oin hitu.<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />Maski nia lohi tuun-sae hodi subar nia odiu nee,</para>
  <para style="q2" vid="PRO 26:26">maibee nia hahalok aat sei hatudu sai iha ema lubuk boot nia oin.<verse eid="PRO 26:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />See mak kee rai kuak sei monu rasik ba iha laran;</para>
  <para style="q2" vid="PRO 26:27">see mak duir fatuk, fatuk nee sei fila hanehan nia.<verse eid="PRO 26:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />Ema bosok-teen odi ema nebee mak nia hakanek;</para>
  <para style="q2" vid="PRO 26:28">see mak kos-kose ema sei hamosu dezastre.<verse eid="PRO 26:28" /></para>
  <para style="b" />
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />Keta gaba aan kona ba loron aban,</para>
  <para style="q2" vid="PRO 27:1">tanba o la hatene saida mak sei akontese iha loron aban-bainrua.<note caller="+" style="x"><char style="xo" closed="false">27:1 </char><char style="xt" closed="false"><ref loc="JAS 4:13-16">Tiago 4:13-16</ref></char></note><verse eid="PRO 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />Lalika gaba o nia aan rasik, husik ema seluk mak gaba o;</para>
  <para style="q2" vid="PRO 27:2">husik ema nebee o la konhese mak gaba, laos o nia ibun rasik.<verse eid="PRO 27:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />Fatuk todan, rai henek mos todan,</para>
  <para style="q2" vid="PRO 27:3">maibee se beik-teen provoka ema, nee todan liu tan.<verse eid="PRO 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />See mak laran nakali, nia la hanoin ema, nia hirus hanesan bee boot nebee estraga rai;</para>
  <para style="q2" vid="PRO 27:4">aat liu tan mak ema nebee laran moras ba nia maluk, la iha ema ida mak bele aguenta.<verse eid="PRO 27:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />Diak liu koriji ema iha nia oin</para>
  <para style="q2" vid="PRO 27:5">duke hadomi nia sub-subar.<verse eid="PRO 27:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />Kolega halo kanek ita mos, nia intensaun diak,</para>
  <para style="q2" vid="PRO 27:6">maibee inimigu rei ita fila-fila.<verse eid="PRO 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />Ema nebee bosu, atu haan bani been nia enjoa tiha,</para>
  <para style="q2" vid="PRO 27:7">maibee ema nebee hamlaha, buat moruk mos nia senti midar.<verse eid="PRO 27:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />Ema nebee lao husik tiha nia uma,</para>
  <para style="q2" vid="PRO 27:8">nia hanesan manu nebee semo husik hela nia knuuk.<verse eid="PRO 27:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />Mina morin ho ai been morin halo ema nia laran haksolok;</para>
  <para style="q2" vid="PRO 27:9">ema nebee foo moral ho laran tomak ba nia kolega, halo nia kolega sai kontenti.<note caller="+" style="f"><char style="fr" closed="false">27:9 </char><char style="ft" closed="false">Tradusaun nee tuir lian Ebreu. Tradusaun Septuaginta dehan, “terus halo ema laran dodok.”</char></note><verse eid="PRO 27:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />Keta haluha o nia kolega ka o nia aman nia kolega;</para>
  <para style="q2" vid="PRO 27:10">bainhira o hetan susar, lalika baa iha o nia maun-alin nia uma;</para>
  <para style="q2" vid="PRO 27:10">diak liu baa vizinhu nebee besik duke maun-alin nebee dook.<verse eid="PRO 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />Oan, sai matenek ba, halo hau nia laran haksolok ba,</para>
  <para style="q2" vid="PRO 27:11">nunee hau bele hataan ema nebee hatuun hau.<verse eid="PRO 27:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />Ema neon matenek haree situasaun perigu, nia lao sees tiha,</para>
  <para style="q2" vid="PRO 27:12">maibee ema matan tomak lao ba oin nafatin, too ikus hetan terus.<verse eid="PRO 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />Se karik ema fuik deve osan iha o, depois ema seluk mak responsabiliza fali tusan nee, entaun o tenki foti pinoor husi ema nee;</para>
  <para style="q2" vid="PRO 27:13">se nia responsabiliza atu selu ema estranjeiru nia tusan ba o, rai di-diak sasaan nebee nia pinoor.<verse eid="PRO 27:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />Se ema kumprimenta nia vizinhu ho lian makaas iha dadeer-saan sedu,</para>
  <para style="q2" vid="PRO 27:14">nia vizinhu senti liafuan nee aat fali.<verse eid="PRO 27:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />Feen nebee mak gosta istori malu,</para>
  <para style="q2" vid="PRO 27:15">nia hanesan udan been nebee turu beibeik liu husi uma kakuluk kuak.<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />Hapara nia, nee hanesan hapara anin,</para>
  <para style="q2" vid="PRO 27:16">ka hanesan raut mina iha liman laran.<verse eid="PRO 27:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />Besi kadi besi sai kroat liu;</para>
  <para style="q2" vid="PRO 27:17">nunee mos ema aprende husi nia maluk sai diak liu.<verse eid="PRO 27:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />See mak hakiak ai figeira sei haan nia fuan;</para>
  <para style="q2" vid="PRO 27:18">see mak kuidadu nia patraun sei hetan respeitu.<verse eid="PRO 27:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />Bee bele leno sai ema nia oin;</para>
  <para style="q2" vid="PRO 27:19">nunee mos ema nia laran sai lalenok ba nia aan rasik.<verse eid="PRO 27:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />Mate ho matebian nia fatin, ru-rua nunka bosu;</para>
  <para style="q2" vid="PRO 27:20">nunee mos ema nia matan sempre kaan buat ruma.<verse eid="PRO 27:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />Ema uza ahi hodi koko osan mean ho osan mutin,</para>
  <para style="q2" vid="PRO 27:21">nunee mos bainhira ita gaba ema, ita bele hatene tuir nia laran.<verse eid="PRO 27:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />Maski o tau ema beik-teen iha lesu laran hodi fai hamutuk ho batar,</para>
  <para style="q2" vid="PRO 27:22">maibee nia hahalok beik nunka atu muda.<verse eid="PRO 27:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23-24" style="v" sid="PRO 27:23-24" />Riku-soin laos dura tinan ba tinan;</para>
  <para style="q2" vid="PRO 27:23-24">liurai nia ukun mos la dura husi jerasaun ba jerasaun.</para>
  <para style="q1" vid="PRO 27:23-24">Nunee hatene tuir o nia bibi;</para>
  <para style="q2" vid="PRO 27:23-24">kuidadu o nia animal sira ba.<verse eid="PRO 27:23-24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />Lere tiha duut iha foho atu duut nee bele buras fali;</para>
  <para style="q2" vid="PRO 27:25">duut nebee lere nee rai hamutuk para foo haan animal iha tempu malirin.<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />Nunee bibi malae oan bele iha fulun atu o halo ropa,</para>
  <para style="q2" vid="PRO 27:26">no o bele faan bibi balu hodi sosa rai.<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />O sei hetan bibi nia susu been barak hodi foo haan o nia familia,</para>
  <para style="q2" vid="PRO 27:27">too o nia atan feto sira mos hetan hotu.<verse eid="PRO 27:27" /></para>
  <para style="b" />
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />Ema aat halai maski la iha ema ida mak duni tuir nia,</para>
  <para style="q2" vid="PRO 28:1">maibee ema moris loos aten brani hanesan liaun.<verse eid="PRO 28:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />Bainhira ema iha nasaun ida sai kontra door, sei iha ukun nain barak hadau malu poder;</para>
  <para style="q2" vid="PRO 28:2">bainhira nai ulun ida matenek hodi ukun, nasaun nee forti no hakmatek.<verse eid="PRO 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />Ema kiak nebee mak halo terus fali ema kbiit-laek,</para>
  <para style="q2" vid="PRO 28:3">nia hanesan udan boot nebee estraga ai haan iha toos.<verse eid="PRO 28:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />See mak lakohi halo tuir lei, nia gaba fali ema aat,</para>
  <para style="q2" vid="PRO 28:4">maibee see mak kaer metin lei, nia kontra ema aat.<verse eid="PRO 28:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />Ema aat la kompriende justisa,</para>
  <para style="q2" vid="PRO 28:5">maibee ema nebee buka NAI Maromak kompriende di-diak.<verse eid="PRO 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />Diak liu ema kiak nebee hahalok loos,</para>
  <para style="q2" vid="PRO 28:6">duke ema riku nebee moris tuir dalan kleuk.<verse eid="PRO 28:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />Oan nebee halo tuir lei, nia nee matenek,</para>
  <para style="q2" vid="PRO 28:7">maibee see mak ranxu ema kaan-teen, halo moe nia aman.<verse eid="PRO 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />Se ema ruma hariku nia aan ho osan funan nebee makaas liu,</para>
  <para style="q2" vid="PRO 28:8">too ikus riku-soin nee monu fali ba ema nebee hatudu laran diak ba ema kiak.<verse eid="PRO 28:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />See mak taka tilun ba NAI Maromak nia ukun fuan,</para>
  <para style="q2" vid="PRO 28:9">nia atu halo orasaun mos, Maromak hakribi.<verse eid="PRO 28:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />See mak lori ema moris loos tuir fali dalan aat, sei monu ba rai kuak nebee nia rasik kee,</para>
  <para style="q2" vid="PRO 28:10">maibee ema nebee laran moos sei hetan buat diak.<verse eid="PRO 28:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />Ema riku bele konsidera nia aan matenek,</para>
  <para style="q2" vid="PRO 28:11">maibee ema kiak nebee kompriende klean, konhese hela nia.<verse eid="PRO 28:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />Bainhira ema moris loos manaan poder, ema barak kontenti loos,</para>
  <para style="q2" vid="PRO 28:12">maibee bainhira ema aat komesa ukun, ema sei subar aan tiha.<verse eid="PRO 28:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />See mak subar nia hahalok aat, nia moris sei la lao ba oin,</para>
  <para style="q2" vid="PRO 28:13">maibee see mak foo sai no husik tiha nia pekadu, Maromak sei hatudu laran luak ba nia.<verse eid="PRO 28:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />See mak sempre hamtauk NAI Maromak,<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="ft" closed="false">Bele mos tradus, “see mak tauk atu halo sala.”</char></note> sei hetan ksolok,</para>
  <para style="q2" vid="PRO 28:14">maibee see mak fuan toos, sei monu ba susar laran.<verse eid="PRO 28:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />Ema aat nebee ukun povu kbiit-laek,</para>
  <para style="q2" vid="PRO 28:15">nia hanesan liaun nebee hakilar ka animal ursu nebee ataka ema.<verse eid="PRO 28:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />Ukun nain nebee la iha kapasidade, hanehan makaas povu,</para>
  <para style="q2" vid="PRO 28:16">maibee nai ulun nebee lakohi haan matak povu nia sasaan, hanaruk nia vida.<verse eid="PRO 28:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />See mak hasai ema seluk nia vida,</para>
  <para style="q2" vid="PRO 28:17">nia sei halai hela deit durante nia moris tomak;</para>
  <para style="q2" vid="PRO 28:17">lalika tulun ema hanesan nee.<verse eid="PRO 28:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />Ema nebee moris ho laran moos, nia dalan seguru,</para>
  <para style="q2" vid="PRO 28:18">maibee ema nebee mak lao kleuk tuun-sae, sei monu derepenti.<verse eid="PRO 28:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />See mak servisu badinas iha nia toos, sei hetan ai haan barak,</para>
  <para style="q2" vid="PRO 28:19">maibee see mak halai tuir fali buat nebee la iha folin, sei sai kiak rabat rai.<verse eid="PRO 28:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />Ema nebee ita bele fiar, simu bensaun barak,</para>
  <para style="q2" vid="PRO 28:20">maibee ema nebee hakarak sai riku lalais, sei la sees husi kastigu.<verse eid="PRO 28:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />Atu nar-naran hasae ema ida hodi hatuun ema seluk, nee la diak;</para>
  <para style="q2" vid="PRO 28:21">maski nunee ema balu halo sala tan deit atu hetan paun pedasuk ida.<verse eid="PRO 28:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />See mak karak-teen, nia kaan atu sai riku lalais,</para>
  <para style="q2" vid="PRO 28:22">maibee nia la hatene katak kiak hein hela nia.<verse eid="PRO 28:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />See mak koriji ema seluk, too ikus ema sei gosta liu nia</para>
  <para style="q2" vid="PRO 28:23">duke gosta ema nebee mak gaba ho ibun tutun deit.<verse eid="PRO 28:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />See mak hadau nia inan-aman nia riku-soin,</para>
  <para style="q2" vid="PRO 28:24">depois dehan, “Nee la sala ida,”</para>
  <para style="q2" vid="PRO 28:24">nia sai maluk ba ema kriminozu.<verse eid="PRO 28:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />Ema nebee matan naklosu ba osan, hamosu istori malu,</para>
  <para style="q2" vid="PRO 28:25">maibee ema nebee laran metin ba NAI Maromak, nia sei moris diak.<verse eid="PRO 28:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />See mak sadere ba nia hanoin rasik, nia beik-teen;</para>
  <para style="q2" vid="PRO 28:26">ema nebee moris tuir matenek sei moris seguru.<verse eid="PRO 28:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />See mak tulun ema kiak, nia sei la falta buat ida,</para>
  <para style="q2" vid="PRO 28:27">maibee ema nebee mak taka matan ba ema kiak, sei hetan malisan oi-oin.<verse eid="PRO 28:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />Bainhira ema aat manaan poder, ema subar aan tiha,</para>
  <para style="q2" vid="PRO 28:28">maibee bainhira sira mate tiha, ema moris loos aumenta barak.<verse eid="PRO 28:28" /></para>
  <para style="b" />
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />See mak ulun toos nafatin maski ema koriji fila-fila,</para>
  <para style="q2" vid="PRO 29:1">sei rahun derepenti, atu hadia fali la bele ona.<verse eid="PRO 29:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />Bainhira ema moris loos ukun,<note caller="+" style="f"><char style="fr" closed="false">29:2 </char><char style="ft" closed="false">Bele mos signifika, “Bainhira ema moris aumenta barak”.</char></note> povu haksolok,</para>
  <para style="q2" vid="PRO 29:2">maibee bainhira ema aat mak ukun, povu halerik hela deit.<verse eid="PRO 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />See mak gosta matenek, nia halo haksolok nia aman nia laran,</para>
  <para style="q2" vid="PRO 29:3">maibee see mak ranxu feto luroon, nia gasta arbiru nia riku-soin too mohu.<verse eid="PRO 29:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />Liu husi justisa liurai hametin nasaun,</para>
  <para style="q2" vid="PRO 29:4">maibee liurai nebee obriga povu selu taxa makaas loos<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">Bele mos signifika, “liurai nebee halo korupsaun”.</char></note>, nia estraga fali nasaun.<verse eid="PRO 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />Ema nebee mak kos-kose nia maluk,</para>
  <para style="q2" vid="PRO 29:5">tau hela lasu ba nia maluk ain.<verse eid="PRO 29:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />Ema aat nia sala rasik sai lasu ba nia aan,</para>
  <para style="q2" vid="PRO 29:6">maibee ema moris loos sei haksolok ho hananu.<verse eid="PRO 29:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />Ema nebee moris loos hatene tuir ema kiak nia direitu,</para>
  <para style="q2" vid="PRO 29:7">maibee ema aat la interese.<verse eid="PRO 29:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />Ema kontra door halo sidade sai rungu-ranga,</para>
  <para style="q2" vid="PRO 29:8">maibee ema matenek halo malirin fali ema nia laran.<verse eid="PRO 29:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />Bainhira ema matenek lori ema beik-teen ba iha tribunal,</para>
  <para style="q2" vid="PRO 29:9">ema beik-teen nee sei hamnasa fali hodi hatete aat nia, nunee la iha dame.<verse eid="PRO 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />Ema nebee hamrook raan, nia odi ema nebee laran moos;</para>
  <para style="q2" vid="PRO 29:10">nia buka dalan atu hasai ema moris loos nia vida.<verse eid="PRO 29:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />Ema beik-teen fakar sai hotu hirus nebee iha nia laran,</para>
  <para style="q2" vid="PRO 29:11">maibee ema matenek hatene domina aan.<verse eid="PRO 29:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />Bainhira nai ulun see tilun fali ba lia bosok,</para>
  <para style="q2" vid="PRO 29:12">nia funsionariu sira sei sai aat hotu.<verse eid="PRO 29:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />Iha buat ida mak halo ema kiak ho ema hanehan door hanesan:</para>
  <para style="q2" vid="PRO 29:13">NAI Maromak mak halo sira nain rua nia matan bele haree.<verse eid="PRO 29:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />Liurai nebee foo justisa ba ema kiak ho lo-loos,</para>
  <para style="q2" vid="PRO 29:14">nia ukun sei dura nafatin.<verse eid="PRO 29:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />Koriji labarik no baku ho rota mak nia sai matenek,</para>
  <para style="q2" vid="PRO 29:15">maibee labarik nebee mak husik hela deit, sei hamoe nia inan.<verse eid="PRO 29:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />Bainhira ema aat aumenta barak, pekadu mos aumenta,</para>
  <para style="q2" vid="PRO 29:16">maibee too ikus ema moris loos sei haree sira monu.<verse eid="PRO 29:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />Eduka o nia oan, nunee nia sei halo o hakmatek;</para>
  <para style="q2" vid="PRO 29:17">nia sei halo o nia laran haksolok.<verse eid="PRO 29:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />Bainhira Maromak la foo sai Nia hakarak ba ema, povu sei moris rungu-ranga,</para>
  <para style="q2" vid="PRO 29:18">maibee ema nebee mak kaer metin ukun fuan, nia hetan ksolok.<verse eid="PRO 29:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />Koriji atan ida ho liafuan deit la too;</para>
  <para style="q2" vid="PRO 29:19">maski nia kompriende, maibee nia sei la halo tuir.<verse eid="PRO 29:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />O haree ema nebee mak koalia la hanoin antes ka?</para>
  <para style="q2" vid="PRO 29:20">Nia futuru aat liu fali ema beik-teen.<verse eid="PRO 29:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />Se patraun halo tuir nia atan nia hakarak husi joven kedas,</para>
  <para style="q2" vid="PRO 29:21">too ikus atan nee halo nia patraun terus.<verse eid="PRO 29:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />Ema nebee hirus-teen hamosu istori malu;</para>
  <para style="q2" vid="PRO 29:22">ema nebee laran nakali lalais, nia halo sala barak.<verse eid="PRO 29:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />See mak foti aan, sei sai kiik,</para>
  <para style="q2" vid="PRO 29:23">maibee ema nebee mak haraik aan, sei hetan respeitu.<verse eid="PRO 29:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />See mak hamaluk ho naok-teen, nia sai inimigu ba nia aan rasik;</para>
  <para style="q2" vid="PRO 29:24">nia jura ona atu foo sasin ho loos maibee lakohi hatete sai.<verse eid="PRO 29:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />See mak tauk ema, nia tauk nee mak hanesan lasu ba nia,</para>
  <para style="q2" vid="PRO 29:25">maibee see mak laran metin ba NAI Maromak, nia moris seguru.<verse eid="PRO 29:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />Ema barak hakaas aan atu hasoru malu ho ukun nain,</para>
  <para style="q2" vid="PRO 29:26">maibee justisa mai husi NAI Maromak.<verse eid="PRO 29:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />Ema moris loos hakribi ema lohi door;</para>
  <para style="q2" vid="PRO 29:27">ema aat hakribi fali ema laran moos.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="ms1">Lia matenek husi Agur</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Lia matenek todan husi Jaqué nia oan Agur ba Itiel ho Ukal. Nia dehan nunee: <note caller="+" style="f"><char style="fr" closed="false">30:1 </char><char style="ft" closed="false">Lian Ebreu iha versikulu nee la klaru.</char></note><verse eid="PRO 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />Hau nee beik liu ema hotu-hotu;</para>
  <para style="q2" vid="PRO 30:2">hau la iha neon.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />Hau nunka aprende atu sai matenek;</para>
  <para style="q2" vid="PRO 30:3">hau la iha konhesimentu kona ba Ida nebee santu.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />See mak sae tiha ona ba iha lalehan, depois tuun fali mai?</para>
  <para style="q2" vid="PRO 30:4">See mak raut hamutuk ona anin iha nia liman laran?</para>
  <para style="q1" vid="PRO 30:4">See mak falun bee ho hena?</para>
  <para style="q2" vid="PRO 30:4">See mak hatuur mundu nia rohan?</para>
  <para style="q1" vid="PRO 30:4">Nia naran saida? Nia oan naran saida?</para>
  <para style="q2" vid="PRO 30:4">Imi hatene karik, hatete took mai hau.<verse eid="PRO 30:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />Maromak nia liafuan hotu-hotu loos;</para>
  <para style="q2" vid="PRO 30:5">Nia defende ema nebee buka mahon iha Nia.<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />Liafuan nebee Nia foo sai, o keta aumenta fali,</para>
  <para style="q2" vid="PRO 30:6">se lae Nia siak o hodi hatudu katak o nee bosok-teen.<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />NAI, iha buat rua mak hau hakarak husu ba Ita Boot;</para>
  <para style="q2" vid="PRO 30:7">hataan buat rua nee durante hau sei moris:<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />Tulun hau atu hau la bele koalia lia bosok ka lohi ema;</para>
  <para style="q2" vid="PRO 30:8">keta husik hau sai kiak liu ka riku liu,</para>
  <para style="q2" vid="PRO 30:8">maibee foo ai haan loro-loron nian mai hau.<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />Se lae, hau hetan barak liu karik, hau bele nega fali Ita Boot</para>
  <para style="q2" vid="PRO 30:9">hodi dehan, “NAI nee see fali?”</para>
  <para style="q1" vid="PRO 30:9">Se hau sai kiak karik, hau bele naok,</para>
  <para style="q2" vid="PRO 30:9">nunee hatuun fali hau nia Maromak nia naran.<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />Keta hatete aat atan ida ba nia patraun,</para>
  <para style="q2" vid="PRO 30:10">se lae atan nee sei foo malisan ba o, too ikus o sei lori todan.<verse eid="PRO 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />Iha ema balu foo fali malisan ba sira nia aman,</para>
  <para style="q2" vid="PRO 30:11">no la husu Maromak foo bensaun ba sira nia inan.<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />Iha ema balu konsidera nia aan moos hela,</para>
  <para style="q2" vid="PRO 30:12">afinal sira nia laran foer teb-tebes, nunka fase.<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />Iha ema balu foti aan liu;</para>
  <para style="q2" vid="PRO 30:13">sira nia matan haree ema la vale.<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />Iha ema balu nia nehan hanesan surik</para>
  <para style="q2" vid="PRO 30:14">ka hanesan tudik nebee kroat</para>
  <para style="q1" vid="PRO 30:14">hodi haan ema kbiit-laek sira iha mundu;</para>
  <para style="q2" vid="PRO 30:14">hodi haan hotu ema kiak sira husi ema kriatura nia klaran.<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />Ular susu raan iha oan feto rua;</para>
  <para style="q2" vid="PRO 30:15">sira hakilar, “Foo mai! Foo mai!”</para>
  <para style="b" vid="PRO 30:15" />
  <para style="li1" vid="PRO 30:15">Iha buat tolu mak nunka atu bosu,</para>
  <para style="li2" vid="PRO 30:15">iha buat haat mak nunka dehan, “Too ona!”<verse eid="PRO 30:15" /></para>
  <para style="li3">
    <verse number="16" style="v" sid="PRO 30:16" />Rate,</para>
  <para style="li3" vid="PRO 30:16">feto nebee la bele hetan oan,</para>
  <para style="li3" vid="PRO 30:16">rai nebee presiza nafatin bee,</para>
  <para style="li3" vid="PRO 30:16">no ahi nebee nunka dehan, “Too ona.”<verse eid="PRO 30:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />See mak fihir nia aman la vale buat ida,</para>
  <para style="q2" vid="PRO 30:17">no lakohi halo tuir nia inan,</para>
  <para style="q1" vid="PRO 30:17">manu metan mota nian sei fokit sai tiha nia matan musan;</para>
  <para style="q2" vid="PRO 30:17">manu kawaa sei haan tiha nia mate isin.<verse eid="PRO 30:17" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="18" style="v" sid="PRO 30:18" />Iha buat tolu mak halo hau admira teb-tebes;</para>
  <para style="li2" vid="PRO 30:18">iha buat haat mak hau la kompriende:<verse eid="PRO 30:18" /></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 30:19" />Oinsaa manu makikit semo iha leten aas,</para>
  <para style="li3" vid="PRO 30:19">oinsaa samea dolar iha fatuk leten,</para>
  <para style="li3" vid="PRO 30:19">oinsaa roo halai iha tasi klaran,</para>
  <para style="li3" vid="PRO 30:19">no oinsaa mane ida tuir feto klosan ida.<verse eid="PRO 30:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />Feen nebee halo sala ho mane seluk, nia hahalok nunee:</para>
  <para style="q2" vid="PRO 30:20">nia haan tiha, depois hamoos nia ibun</para>
  <para style="q2" vid="PRO 30:20">hodi dehan, “Hau la halo sala ida.”<verse eid="PRO 30:20" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="21" style="v" sid="PRO 30:21" />Iha buat tolu mak halo rai la hakmatek;</para>
  <para style="li2" vid="PRO 30:21">iha buat haat mak halo rai la aguenta:<verse eid="PRO 30:21" /></para>
  <para style="li3">
    <verse number="22" style="v" sid="PRO 30:22" />Atan nebee sai fali liurai,</para>
  <para style="li3" vid="PRO 30:22">ema beik-teen nebee iha ai haan barak,<verse eid="PRO 30:22" /></para>
  <para style="li3">
    <verse number="23" style="v" sid="PRO 30:23" />feto nebee ema hakribi liu, maibee sai fali kaben nain,</para>
  <para style="li3" vid="PRO 30:23">no atan feto nebee troka fali nia patraun feto nia fatin.<verse eid="PRO 30:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="PRO 30:24" />Iha animal haat iha mundu mak kiik,</para>
  <para style="li2" vid="PRO 30:24">maibee matenek teb-tebes:<verse eid="PRO 30:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="PRO 30:25" />Nehek, maski forsa la iha,</para>
  <para style="li3" vid="PRO 30:25">sira halibur ai haan iha tempu bailoron.<verse eid="PRO 30:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="PRO 30:26" />Koelhu mos la iha kbiit,</para>
  <para style="li3" vid="PRO 30:26">maibee sira bele hela iha fatuk boot nia leet.<verse eid="PRO 30:26" /></para>
  <para style="li2">
    <verse number="27" style="v" sid="PRO 30:27" />Gafanhotu la iha liurai,</para>
  <para style="li3" vid="PRO 30:27">maibee sira halo formatura hodi lao ba oin.<verse eid="PRO 30:27" /></para>
  <para style="li2">
    <verse number="28" style="v" sid="PRO 30:28" />Teki ema bele kaer ho liman,</para>
  <para style="li3" vid="PRO 30:28">maibee nia mos bele hela iha liurai nia palasiu.<verse eid="PRO 30:28" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="29" style="v" sid="PRO 30:29" />Iha animal tolu mak lao hatudu kbiit;</para>
  <para style="li2" vid="PRO 30:29">iha buat haat mak hakat ho fiar aan:<verse eid="PRO 30:29" /></para>
  <para style="li3">
    <verse number="30" style="v" sid="PRO 30:30" />Liaun, nia mak forti liu animal sira seluk,</para>
  <para style="li3" vid="PRO 30:30">nia hasoru saida deit la hakiduk.<verse eid="PRO 30:30" /></para>
  <para style="li3">
    <verse number="31" style="v" sid="PRO 30:31" />Manu aman nebee lao loke liras,</para>
  <para style="li3" vid="PRO 30:31">bibi aman,</para>
  <para style="li3" vid="PRO 30:31">no liurai nebee hamriik iha nia tropas nia oin.<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />Se karik o hatudu hahalok beik hodi gaba o nia aan rasik,</para>
  <para style="q2" vid="PRO 30:32">karik o halo ona planu aat,</para>
  <para style="q2" vid="PRO 30:32">entaun taka tiha o nia ibun.<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />Tanba ema doko beibeik susu been, nia rezultadu sai fali manteiga;</para>
  <para style="q2" vid="PRO 30:33">ema buti metin inus, raan sai mai,</para>
  <para style="q2" vid="PRO 30:33">nunee mos provoka ema hirus hamosu istori malu.<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="ms1">Lia matenek husi liurai Lemuel nia inan</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Ida nee mak lia matenek todan nebee liurai Lemuel nia inan hanorin ba nia.<verse eid="PRO 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />Hau nia oan, hau mak tuur ahi o, uluk kedas hau promete atu entrega o ba NAI Maromak;</para>
  <para style="q2" vid="PRO 31:2">hau atu koalia saida ba o?<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />La bele gasta enerjia hodi hola feto barak;</para>
  <para style="q2" vid="PRO 31:3">keta lakon tempu ba feto sira nebee mak estraga liurai.<verse eid="PRO 31:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />Lemuel, tua la merese ba liurai;</para>
  <para style="q2" vid="PRO 31:4">liurai laos atu hemu tua;</para>
  <para style="q2" vid="PRO 31:4">ukun nain sira la bele kaan atu hemu tua forti.<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />Se sira hemu too lanu, sira sei haluha buat nebee lei haruka</para>
  <para style="q2" vid="PRO 31:5">hodi viola fali ema kbiit-laek nia direitu.<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />Tua nee ba ema nebee besik atu mate</para>
  <para style="q2" vid="PRO 31:6">ka ba ema nebee terus ho laran susar.<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />Husik sira hemu hodi haluha tiha sira nia kiak,</para>
  <para style="q2" vid="PRO 31:7">no la hanoin tan sira nia terus.<verse eid="PRO 31:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />Loke o nia ibun hodi defende ema nebee la iha kbiit atu koalia;</para>
  <para style="q2" vid="PRO 31:8">defende ema sira nebee kiak rabat rai.<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />Loke o nia ibun, tesi lia ho lo-loos</para>
  <para style="q2" vid="PRO 31:9">hodi proteje ema kiak ho ema kbiit-laek sira nia direitu.<verse eid="PRO 31:9" /></para>
  <para style="ms1">Feen nebee diak</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />Feen nebee hatudu laran osan mean, see mak bele hetan?</para>
  <para style="q2" vid="PRO 31:10">Feen hanesan nee valor boot liu fali fatuk murak diak nian.<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />Nia laen laran metin ba nia;</para>
  <para style="q2" vid="PRO 31:11">buat diak ida la falta ba nia laen.<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />Iha nia moris tomak, nia nunka halo aat ba nia laen;</para>
  <para style="q2" vid="PRO 31:12">nia halo buat mesak diak deit.<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />Nia hili bibi fulun ho kabas atu halo hena;</para>
  <para style="q2" vid="PRO 31:13">nia badinas servisu ho nia liman rasik.<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />Nia sosa ai haan nebee mai husi fatin dook;</para>
  <para style="q2" vid="PRO 31:14">nia hanesan roo nebee tula sasaan mai husi rai liur.<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />Dadeer-saan nakukun, nia hadeer ona</para>
  <para style="q2" vid="PRO 31:15">hodi prepara hahaan ba nia familia uma laran,</para>
  <para style="q2" vid="PRO 31:15">no fahe hahaan ba nia atan feto sira.<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />Nia fihir rai, depois nia sosa;</para>
  <para style="q2" vid="PRO 31:16">nia uza nia osan rasik hodi kuda uvas.<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />Nia kesi metin nia kanotak atu servisu makaas;</para>
  <para style="q2" vid="PRO 31:17">nia liman forti hodi halao nia knaar.<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />Nia hatene katak nia hetan lukru boot husi nia kosar been;</para>
  <para style="q2" vid="PRO 31:18">nia ahi oan la mate iha tempu kalan.<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />Nia liman kaer roka nebee tau tiha ona kabas rahun;</para>
  <para style="q2" vid="PRO 31:19">nia liman fuan dulas kabas.<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />Nia foo liman ba ema kiak sira;</para>
  <para style="q2" vid="PRO 31:20">nia lolo liman hodi tulun ema kbiit-laek sira.<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />Iha tempu rai malirin, nia la tauk kona ba nia familia uma laran,</para>
  <para style="q2" vid="PRO 31:21">tanba sira hotu hatais hena mahar diak nian.<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />Nia suku hena hodi taka ba nia kama;</para>
  <para style="q2" vid="PRO 31:22">nia hatais ropa furak ho folin karun nian.<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />Bainhira nia laen tuur hamutuk ho katuas lia nain sira seluk iha portaun sidade nian,</para>
  <para style="q2" vid="PRO 31:23">ema konhese kedas.<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />Nia suku ropa husi hena diak nian hodi faan,</para>
  <para style="q2" vid="PRO 31:24">no faan sintu ba ema kontratu nain sira.<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />Nia iha kbiit ho naran diak;</para>
  <para style="q2" vid="PRO 31:25">nia la tauk kona ba loron aban nian.<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />Nia koalia ho matenek;</para>
  <para style="q2" vid="PRO 31:26">nia hanorin ema ho laran luak.<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />Nia kontrola saida deit mak halao iha uma laran ho diak,</para>
  <para style="q2" vid="PRO 31:27">no nunka atu baruk.<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />Nia oan sira hamriik hodi tane aas nia;</para>
  <para style="q2" vid="PRO 31:28">nia laen mos gaba nia dehan,<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />“Iha feto barak mak halo buat diak tebes,</para>
  <para style="q2" vid="PRO 31:29">maibee o diak liu sira hotu.”<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />Oin bonita lohi deit, oin furak sei lakon lalais deit,</para>
  <para style="q2" vid="PRO 31:30">maibee feen nebee hamtauk NAI Maromak, ema tenki gaba duni.<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />Foo nia kolen tuir buat nebee nia halo tiha ona;</para>
  <para style="q2" vid="PRO 31:31">tanba nia hahalok diak nee mak ema lubuk boot gaba nia iha portaun sidade nian.<verse eid="PRO 31:31" /></para>
  <para style="q1" />
  <chapter eid="PRO 31" />
</usx>