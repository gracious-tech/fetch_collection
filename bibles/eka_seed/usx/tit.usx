<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- Ekajuk New Testament</book>
  <para style="h">Taitus</para>
  <para style="toc1">Taitus</para>
  <para style="toc2">Tait</para>
  <para style="mt2">NWER NYI POL NYONO TV</para>
  <para style="mt1">TAITUS</para>
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="nb">
    <verse number="1" style="v" sid="TIT 1:1" />Me Pol wo, ji li nlokeltum Esowo, a ntiingetib no Jisos Kraist. Esowo tum-m re me n song kak ane ba á ma yehke bo ebo go bo eltaame, fere tib bo elkahne ni etingitingi ni kpo jen a eljolo Esowo Esowo.<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Jems 3:13-17</char></note> <verse eid="TIT 1:1" /><verse number="2" style="v" sid="TIT 1:2" />N kpꞌlimi eltum nia, tib eji n kpꞌkunu ekpu re, bo bahke bele elkpin ni li go njinanjini, ni Esowo bi kil jo kim efahnge nyame no tong-r go mboma mbomo, njini kehm jolo. <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" />Go ngare nyi nno wo á lennge elkpin nio go ege alum,<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Ef 1:9-12</char></note> nya á yake no kak-m go ebo. Owo wahnge n kpꞌtiingi etib ebame, tib eji Esowo ntꞌtahre ewahre tong-m no.<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Elt 26:16-18</char></note><verse eid="TIT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4" />N kpꞌnyono nwer nyia tv Taitus ji li etingitingi mmon ewame, ye ji e kpi eltaame na anehng.<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">1 Tim 1:2</char></note></para>
  <para style="p" vid="TIT 1:4">Nong, Esowo Nsoo, a Kraist Jisos ntꞌtahre ewahre ka-a nnoobo, a elkoono.<verse eid="TIT 1:4" /></para>
  <para style="s">Nne no fuumu re á jol nnenkul ero</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />Jia ji wahnge n tahm-a sa go Krit, eji a lꞌtuungu nsol nyi kpeke li go ellimi, fere yehke anebkul ero go ejahbe ajehng ajehng ana n tong-a no. <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" />Nnenkul ero bahke jolo nne no ki kpi egahme ajehng ajehng.<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">1 Tim 3:1-7</char></note> Á bahke bele nkal awohng. Abon ebe bahke jolo ane ba ma taame tv Esowo, ba ane lꞌkꞌjo ka bo ebi re, bo kpꞌlehke elwur. Bo nehm jol ane ba lꞌkꞌjo wuk babnde.<verse eid="TIT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="TIT 1:7" />Tibre ntubesi ero bahke jolo nne no ki kpi egahme ajehng ajehng, eji á li nne no Esowo ma yake eltum ene kak-e go ebo. Á nehm jol nne no kpo lim agabbe, fere jo rak eltim sohk sohk, jo wo amahm, jo nok abohng, fere jol nne no nsol kil jo gbal-e.<verse eid="TIT 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="TIT 1:8" />Á bahke jolo nne no kpo vvrv ajenne. Ejum ajehng ajehng ji nno bahk-e jo kꞌkor. Á bahke bele ntir atahng nyi nno, fere jol go etingitingi, fere bel nnoobo eljini, fere jol nne no bahke jo mal bob elne. <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />Á bahke yiimi tꞌtahne go atingitingi alum nya bo tib-e no, eji á lꞌjo mal rehke ane, fere jo tib etingitingi mbang,<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">2 Tim 2:24</char></note> fere jo bung, ga ane ba kpo ten mbang nyio.<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">Elt 6:10</char></note><verse eid="TIT 1:9" /></para>
  <para style="s">Erehke ji li bade anehm ane</para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />Tibre ane gbalee baa, asehngesehnge ane ba ma yehke nrur, ba kil jo wuk Esowo, bo jio ji kpo bung na bung fad, fere jo nehm ane.<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">Elt 15:1,24; 1 Tim 1:3-8</char></note> <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" />Ḿ bahke sahde bo anyo. Bo ba kpo kpiidi alaaga ane akpade go ero, tib eji bo kpꞌtibi nsol nyi kehn bo jol kꞌtib. Bo kpo lim ano, eji bo lꞌbel abi akpohko.<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">2 Pit 2:1-3</char></note><verse eid="TIT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 1:12" />Nne a Krit no jolo nnyehnamahr abo wo bungu antahng antahng re, “Aneb Krit kpo kiimi afahnge ngare anyehng anyehng. Bo abi enyam bi. Bo abalehke ebno ba ma gbo ewon ba.”<verse eid="TIT 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="TIT 1:13" />Enyehnamahr jia lohko li go etingitingi. Esi jia ji wahnge a bahke jo nyam bo tꞌtahne, eji elkpin ebo lꞌjol ni nno, <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />eji bo lꞌkꞌkpe wuungu Jus atung go bo amongo, a atahm nya ane jehke no, bao ba ma ten etingitingi.<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">Mak 7:8</char></note><verse eid="TIT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 1:15" />Ane ba li saang, ejum ajehng ajehng li bo saang. Wo, ejang bi ane ba ki li saang, ba kil taame, ejum ajehng ajehng limm, ji li bo saang. Ntir atahng ebo, a ntim ebo limm saang.<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">1 Tim 4:3-5</char></note> <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" />Bo kpo bung go bo a nnyo re, bo nyi Esowo. Go bo eljini ni bo kpo tib, bo kpo ten-e ten. Bo li ana ejum nkuk go esamahr bi Esowo. Bo kpehme wuk-e. Bo fuumem go eltum ni nno anehng anehng.<verse eid="TIT 1:16" /></para>
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="s">Eljini ni aneb ero</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />Wo Taitus, jo tib nsol nyi fuumu a eltibi ni nno!<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">2 Tim 1:13</char></note> <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />Tong anebkul ba li aneblum re bo jo lim ejum ajehng ajehng biingi biingi, amahr ebo jo jol sange sange, bo fere jo bob elbo. Nong, bo bel ekakesehk ji nno, a elkoro ni nno, a elkpuumu ni nno.<verse eid="TIT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 2:3" />Ano wo fvfo a bahke tob tong anebkal ba li anebkul re bo jo lim eljini ni ane ba li ebo ebo. Nong, bo kꞌjo jol ane ba kpo kiimi afahnge lake ane bako. Bo kꞌjo jol aju ka amahm gbalee. Nobo re bo jo tib ji kpꞌnobo, <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />fere jo ka agbahme elle re, alum ebo jo kor bo, a abon ebo fvfo, <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />fere jo tib bo, ana bo bahke jo bob elbo, fere jo jol saang, jo kuuru alaaga ebo, fere bel nnoobo eljini, fere jo woomo alum ebo go elwo,<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">Ef 5:22-25</char></note> eji nne awohng awohng lꞌkꞌjo bung ebi bade alum Esowo.<verse eid="TIT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6" />Mbang nyꞌnehm nyi a bahke tob jo rehke ajangkun re bo jo bob elbo. <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" />Wofono antahng jol ano ona go ejum ajehng ajehng, eji ane lꞌleeme nnoobo nyi a kpꞌlimi.<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">1 Tim 4:12; 1 Pit 5:3</char></note> A lꞌkehm tibi, ka jo be esamahr ane. Jo tib go mbang nyi ane bahke lohko kahn re, etib eba li etahntahn etib. <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" />Jo bung alum nya nno, nya bo lꞌkꞌma jo faabe, eji lꞌriki nne no wob njahm nyehko ndon, á kꞌkpe ma bung ebꞌbi ajehng ajehng bada nahre.<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">Ell 12:10</char></note> <verse eid="TIT 2:8" /><verse number="9" style="v" sid="TIT 2:9" />Tong alokeltum re bo woomo babnde ebo go elwo, fere jo lim ejum ajehng ajehng ji bahke jo kor babnde ebo.<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">1 Pit 2:18</char></note> Bo kꞌjo faange bo go nnyo, <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />bo kꞌjo v bo ejv. Ga nob re bo jo tib eljini ni ane ba li go etingitingi, ba kpo kuuru nsol nyi babnde ebo nob nob, eji eltibi ni Esowo ntꞌtahre ewahre lꞌbel nnooba mbing tib go ejum ajehng ajehng ji bo kpꞌlimi.<verse eid="TIT 2:10" /></para>
  <para style="s">Ana nnoobo nyi Esowo ma lohng ba</para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11" />Tibre nnoobo nyi Esowo eblohng ba re ba tahre ane kpee,<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">1 Tim 2:4</char></note> <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />fere tib-r re, wahr yake eljini ni kil jo kor Esowo, a ekor nsol njini nyia, wahr fere jo jol amahr sange sange, fere jo bel etingitingi elkpin, tob jo lim nsol nyi kpo kor Esowo go njini nyia,<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">Jems 2:7</char></note> <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" />eji e kpꞌsiki efung bi Esowo ma fuulu, bi e kpꞌkunu ekpu, bi ellub ni egburu Esowo ebahre, a Jisos Kraist ntꞌtahre bahke lohngo ba,<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">Fil 3:20-21</char></note> <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" />ye ji yake elne ka tib go egahre esi, eji á lꞌfak-r yake go abꞌbi kpee, fere lim-r, e jol ane ba li saang ka-e, fere jo kak ekpuku go nnoobo alimi.<verse eid="TIT 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15" />Jo tib nsol nyia, wo jo rehke ane, fere jo nyam bo go nsahm nyi n ka-a no.<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">Tait 1:5</char></note> Nong, nne awohng awohng ki-a jo daange!<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">1 Tim 4:12</char></note><verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="s">Ji fuumu re aneb ero jo lim</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />Jo buumu bo re, bo jo woomo atul, a atubesi go elwo, fere jo wuk bo.<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">Rom 13:1-8; 1 Pit 2:13-17</char></note> Nobo re, jo kor bo, bo jo lim ejum ajehng ajehng ji kpꞌnobo. <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" />Tong bo re bo kꞌjo bung ebi bada nne awohng awohng, fere jo taange ntaange. Nobo re bo bel nnaange eljini, fere jo bum nne awohng awohng ana egburu nne.<verse eid="TIT 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 3:3" />Tibre wahrfono antahng wuku wuku e jolo agboolo, e joom wuk nyi etung, e tꞌtan mbang. E jolo aju ka ajoobo nsol gbalee nya jo mell-r go egahra ntim, fere jol aju ka elyebe ni njini. Elkpin enahre kpee jolo abꞌbi abꞌbi, a ala ateele. Ane jo ko-r ekv, wahr tob jo ko bo ekv. <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />Ngare nyi nnoobo nyi Esowo, a elkoro ni Esowo ntꞌtahre ewahre lohngo no ba,<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">Tait 2:11</char></note> <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" />á ba tahr-r na. Wahr á tahrem tib eji e ma lim nsol nyi li go etingitingi. Á tahr-r tib go ege a ndon,<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">Ef 2:8-9</char></note> eji á ru-r no go Etingi Etohko, e ma fere tuungu jini,<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">Jon 3:5</char></note> fere jol anebe nfenfe. <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />Tibre Esowo ebyaange Etingi Etohko gbalee wohng-r, ji sehnge go abo nya Jisos Kraist ntꞌtahre ewahre, <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" />eji e lꞌli eno go esamahr bi Esowo tib go ege a nnoobo, fere li elkv ni li elkpin ni li go njinanjini ni e kpꞌkunu ekpu.<verse eid="TIT 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="TIT 3:8" />Alum nyaa li go etingitingi. N kpꞌsebe re, wo yiimi tꞌtahne go nsol nyia, eji ane ba ma taame tv Esowo lꞌjo kunu ekpu, jo rod ngare abo, jo lim nnoobo. Nsol nyia kpꞌnobo, kpi nsehng nyi bahke kake ane.<verse eid="TIT 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 3:9" />Ka jo yel ellong ane ba kpo lim egboolo nfaabe, fere jo bung, lung abing nya babnso ejahre nya nya, fere jo taange ntaange, fere jo nok atemtem go alum nnyo bade atahm. Nsol nyia, nsehng anyehng anyehng kpimm, li mbol mbol. <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" />Nne no kpo wahng re ane yab, rehk-e nkpel anyehng, nkpel nyehko. Á tohko wuk, yab a ne.<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">Mat 18:15-17</char></note> <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" />Tibre a kpꞌkahne re, elkohn nne noo ebrannge. Á kpꞌlimi abiafem. Yebkimi ebi ka elne antahng.<verse eid="TIT 3:11" /></para>
  <para style="s">Esꞌkohro erehke</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />N lꞌtum Artemas, afi jolo Tikikus tv-a, nok, eji a lꞌlub ba kpir-m go Nikopolis. Tibre me n tir re, m bahke kange o elum kohro kohro.<verse eid="TIT 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="TIT 3:13" />Lub nok, wo kak Senas ji li eloya ebo, a Apollos, eji ejum ajehng ajehng lꞌkꞌrin bo go bo eljen. <verse eid="TIT 3:13" /><verse number="14" style="v" sid="TIT 3:14" />Nong, ane ebahre kpili ana bo bahke jo yake ngare ebo, kak go nnoobo eltum ni fuumu ellimi, a ni lubu lub, eji bo lꞌkꞌjol na jol, kꞌkab akab.<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">Kol 4:5</char></note><verse eid="TIT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15" />Ane kpee ba li a name kp-a kake nnyo. Kak ane ba e kpi bo kor go ejang bi Esowo nnyo. Nong, nnoobo nyi Esowo jol a nahne wahn ane kpee.<verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>