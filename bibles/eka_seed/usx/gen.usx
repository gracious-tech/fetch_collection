<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Ekajuk Bible</book>
  <para style="h">Mbomannahb</para>
  <para style="toc1">Nwer nyi Mbomannahb</para>
  <para style="toc2">Mbomannahb</para>
  <para style="toc3">Mbomo</para>
  <para style="mt1">Mbomannahb</para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s">Ana Esowo limi njini</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />Go mbomannahb Esowo limi elbung abola ndi. <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />Ndi jolo nnehme nehme, agburu alab bulu ndi kpee, a akpang enye jolem, al ahb bulu njini kpee, ejannge konngo edi ajehng ajehng, Etohko ji Esowo jo fonngo yannge go ero alahb ma bulu o kpee.<verse eid="GEN 1:2" /></para>
  <para style="s">Ngbokambang Efung: Ellennge a ejannge</para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 1:3" />Esowo kehm bungu re, &lt;&lt;Nong ellennge jol&gt;&gt;, ellennge soro jol. <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />Esowo nyehne re ellennge nˈnob, á kehm yabe ellennge yehke go ejannge. <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />Esowo lungu ellennge re, &lt;&lt;Efung,&gt;&gt; fere lung ejannge re, &lt;&lt;Atv.&gt;&gt; Elgung jˈjol, efungfu jˈjol, owo jolo ngbokambang efung.<verse eid="GEN 1:5" /></para>
  <para style="s">Etoono Efung: Ewuungu</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 1:6" />Esowo kehm bungu re, &lt;&lt;Nong ewuungu jol yab alahb ma li go ero, a ma li ga ndi. <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />Ano wo Esowo limi ewuungu, yab alahb mako tv go ero, maka jol ga ndi. Ano wo jolo no. <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />Esowo kehm lungu ewuungu re, &lt;&lt;Elbung.&gt;&gt; Elgung jˈjol, efungfu jˈjol, owo biingi etoono efung.<verse eid="GEN 1:8" /></para>
  <para style="s">Go nfung era: Agburu aya a ndi</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9" />Esowo kehm bungu re, &lt;&lt;Nong alahb ma li ga nla elbung temme feere edi anyehng, nong ndi nyi ma wum lohng.&gt;&gt; Ano wo jolo no. <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />Esowo lungu ndi nyi ma wum re, &lt;&lt;Ndi,&gt;&gt; fere lung alahb ma temme feere edi ajehng re, &lt;&lt;Agburu aya.&gt;&gt; Esowo nyehne re ebnob. <verse eid="GEN 1:10" /><verse number="11" style="v" sid="GEN 1:11" />Esowo kehm bungu re, &lt;&lt;Nong nti a ajele jini go ndi, ajele nya kpo kab amohk, a nti nyi kpo kab akab, a amohk atahng, go nkohnankohn.&gt;&gt;Ano wo jolo no. <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />Nti a ajele kehm kehme eljini go ndi, ajele nya kpo kab amohk go nkohnankohn, a nti nyi kpo kab akab, a amohk atahng, go nkohnankohn. Esowo nyehne re ebnob. <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />Elgung jˈjol, efungfu jˈjol, bi biingi nfung era.<verse eid="GEN 1:13" /></para>
  <para style="s">Go nfung eni: Njul, ebareka, a alonlo</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />Esowo kehm bungu re, &lt;&lt;Nong nsol nyi bahke jo ka ellennge jol go ewuungu, eji lˈyabe efung, a atv, nong jol elliingi ni bahke jo tib ngare<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft">Ngare a edi jia, kpˈtibi bade ngara nnale, a ngare elum.</char> </note>, afung, a nnya. <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />Nong bo jol nlennge go elbung, jo ka ellennge ga ndi. Ano wo jolo no. <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />Esowo kehm limi agburu nlennge na abal, ni ga gbal jo ya efung, ni ki ga gbal jo ya atv. Á tob limi alonlo. <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />Esowo bumu bo go elbung re ka ellennge ga ndi. <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />Eji lˈjo fili efung, a atv, fere yab ellennge a ejannge. Esowo nyehne re ebnob. <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />Elgung jˈjol, efungfu jˈjol, bi biingi nfung eni.<verse eid="GEN 1:19" /></para>
  <para style="s">Go nfung elon: Nsahre, a nruk</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />Esowo kehm bungu re, &lt;&lt;Nong ajoobo enyam nya li go elkpin rur go alahb, nong nruk jol jo fonngo yannge go ero elbung.&gt;&gt; <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />Ano wo Esowo limi agburu enyamalahb, a ajoobo enyam elahb bi bahke ruru go alahb, go nkohnankohn, nruk jolo go nkohnankohn. Esowo kehm nyehne re ebnob. <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />Esowo kehm fuulu bo, fere bung re, &lt;&lt;Jelen, wahn jol go nfange, rur go alahb, nong nruk jel rur go njini.&gt;&gt; <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />Elgung jˈjol, efungfu jˈjol, bi biingi nfung elon.<verse eid="GEN 1:23" /></para>
  <para style="s">Go nfung erakera: Enyam, a ane</para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24" />Esowo kehm bungu re, &lt;&lt;Nong enyam jini go ndi, bi li nkohnankohn, atohkondi, a enyam bi kpo tohng ala go ndi, a enyam ekulugbe go nkohnankohn. Ano wo jolo. <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />Ano wo Esowo limi enyam ekulugbe, go nkohnankohn, atohkondi go nkohnankohn, a enyam bi kpo tohng ala go ndi go nkohnankohn. Esowo kehm nyehne re ebnob.<verse eid="GEN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 1:26" />Esowo kehm bungu re, &lt;&lt;Nong wahr limen nne go egahre elfoongo, á jol ana wahr, nong bo jo fili nsahre nyi li go alahb, a nrur nyi kpˈfonngo go elbung, a atohkondi, bo tob jo fili njini kpee, a enyam bi kpo tohng ala go ndi.&gt;&gt; <verse eid="GEN 1:26" /><verse number="27" style="v" sid="GEN 1:27" />Esowo kehm limi nne go ege elfoongo, go elfoongo ni Esowo ni á lim-e no. Á limi bo, nnenlum, a nnenkal. <verse eid="GEN 1:27" /><verse number="28" style="v" sid="GEN 1:28" />Esowo kehm fuulu bo, fere tong bo re, &lt;&lt;Jolen wahn jel rur go njini, wahn jo fili. Jo fili nsahre nyi li go alahb, nruk, nyi kpˈfonngo go ero, a nnyam anyehng anyehng nyi kpˈjene go ndi.&gt;&gt; <verse eid="GEN 1:28" /><verse number="29" style="v" sid="GEN 1:29" />Esowo kehm bungu re, &lt;&lt;M ma-n ka elkohn eljele anehng anehng ni kpo kab amohk, a eti ajehng ajehng ji kpo kab akab, a amohk go atahng, go njini kpee. Bahke jolo nsol alehke ka-n <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />Me ka elkohn ajele anyehng anyehng re jol nsol alehke ka enyam kpee bi li njini, a nruk kpee nyi kpˈfonngo go ero, a enyam bi kpo tohng ala go ndi, go ejum ajehng ajehng ji kpi elkpin. Ano wo jolo. <verse eid="GEN 1:30" /><verse number="31" style="v" sid="GEN 1:31" />Esowo kehm seenge nsol kpee nyi á ma lim nyehn re ebnob sehng. Elgung jˈjol, efungfu jˈjol, bi biingi nfung erakera.<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />Ana wo Esowo limi elbung abola ndi mal, a nsol kpee nyi wob atahng.<verse eid="GEN 2:1" /></para>
  <para style="s">Go nfung esehma: Esowo re ekv</para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 2:2" />Re kehm biingi nfung esehma, Esowo eblim eltum kpee mal. Efung bi biingi nfung esehma, Esowo kehm reke ekv. <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />Esowo kehm fuulu efung bio bi biingi nfung esehma, fere lim re jol saang, tibre efung bio bi á re ekv go eltum ni á limi njini.<verse eid="GEN 2:3" /></para>
  <para style="s">Adam abola Iv</para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 2:4" />wo li ntooba nnyo mi Esowo limi elbung abola ndi. Ngare nyi Jehova limi elbung abola ndi, <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />Ngare nyio nti, a ajele ka kehme elgbale a ndi, tibre Jehova ka na elahb wohngo go ndi, nnene jolem no bahke bahme ndi. <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />Ebohng bi bi jo lohng go ndi jo suku ndi kpee. <verse eid="GEN 2:6" /><verse number="7" style="v" sid="GEN 2:7" />Owo Jehova kehm koko ebtohko bi ndi lim nne, fere v elv ni elkpin kak-e go atangewul. Nne kehm bele elkpin.<verse eid="GEN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8" />Jehova Esowo limi etahngga go Eden ji jolo ero nfam, owo á kake nne no á lim-e no. <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />Jehova Esowo kehm limi ajoobo nti gbal lohng go ndi nya fuumu fuumu amahr, fere nˈnob go ellehke. Go elka elka etahngga eti jolo o ji elkpin, a eti ji elkahne ebi, a nnoobo.<verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />Go Eden wo aya jo fab ba ka elnaange go etahngga jio, aya mao yaame o fere jol efabe alahb emni. <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />Ngbokambang efabe bo kpo lung re Pison, kpo fab sennge ejang ndi bi bo kpo lung re Havila, edi ji agul li no. <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />Agul nya li o kpˈsahb nˈnob. Ajoobo alahb nti ma esˈsv eleenge tob jolo o, a anobnobo atal nya bo kpo lung re onik. <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />Etoono efabe jehko bo kpo lung re Gihon, kpo fab sennge ejang ndi bi bo kpo lung re Kus.<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">Kus ji li Etiopia</char></note> <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />Go Efabe ebra bo kpo lung re Taigris, kpo fab go ejang ero nfam bi Asur. Go etoono efabe na ebni bo kpo lung re Yufratis.<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />Jehova Esowo bumu nne no á lim-e no go etahngga ji Eden re á jo lim eltum, fere jo kuuru edi jio. <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />Jehova Esowo kehm kake nne noa ejehke re, &lt;&lt;Á bahke ma jo li akab nti anyehng anyehng etahngga jia; <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />sehngem re eti jio ji elkahne ebi, a nnobo nobo. Tibre efung bi a lˈsi lˈli, a bahke tiki kpoko.&gt;&gt;<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />Owo Jehova Esowo kehm bungu re, &lt;&lt;Fuumem re nnenlum jol ntahngtahng, m bahke limi nkakebo no bahke fuumu a ne ka-e.<verse eid="GEN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 2:19" />Jolo re Jehova Esowo ko ndi lim ejoobo nnyam anyehng anyehng nyi li ekulugbe, a nruk a nruk kpee nyi kpo fonngo, á kehm koko bo ba goji nnenlum re á nyehn ana a bahke gungu bo abing, mbing anyehng anyehng nyi nne noo gungu nnyam anyehng anyehng, nyi nyi jolo mbing enye. <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />Ano wo nne noo gungu atohkondi abing kpee, a nruk, a nruk nyi kpˈfonngo go ero, a enyam ekulugbe.</para>
  <para style="p" vid="GEN 2:20">Ngare nyia Adam ka bel nkakebo no fuumu a ne. <verse eid="GEN 2:20" /><verse number="21" style="v" sid="GEN 2:21" />Jia limi Jehova Esowo kehm bumu Adam ellu, á lal kpˈkpoodo, eji á jo lal Esowo kehme yehke nkˈkehb anyehng fere feere edi jio bulu. <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />Ano wo Jehova Esowo ko nkˈkehb nyi á ma yehke goji nnenlum lim nnenkal, fere ko-e ba ka nnenlum.<verse eid="GEN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 2:23" />Nne noo kehm bungu re, &lt;&lt;A wo li ekahb ji lohng egame ekahb, a ngubjing nyi lohng egame ngubjing, bo bahke jo lung-e re nnenkal tibre á lohng goji nnenlum.&gt;&gt; <verse eid="GEN 2:23" /><verse number="24" style="v" sid="GEN 2:24" />Esi jia ji wahnge nne bahke tahme nde a nnyehn sa, bo song jol ajehng a nkal ewe, bo bahke fere jol ngubjing anyehng.<verse eid="GEN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25" />Nnenlum a nkal ewe, bo jolo ebun ebun jol ndon joom fili bo.<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">Abiafem nya nnenlum a nnenkal limi no</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />Go ellong enyam ekulugbe bi Jehova Esowo limi no, nnyo nyi ga wake sehnge bo kpee. Nnyo kehm bungu tong nnenkal re, &lt;&lt;Anv, Esowo lˈlohko bung re, &lt;Kana li nkab eti go eti ajehng ajehng go etahnggaa?&gt;&gt;&gt;<verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2" />Nnenkal kehm faange nnyo nyio re, &lt;&lt;Akab nti nya li etahngga e bahke ma li, <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />wo Esowo bungu re, &lt;Kana tiki li nkab go eti ji yim go elka ni etahngga, jol kana lak abo, tohko jol ano ḿ bahke kpoko.&gt;&gt;&gt;<verse eid="GEN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4" />Nnyo nyio kehm tongo nnenkal re, &lt;&lt;Ń nehm lohko kpoe.&gt;&gt; <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />&lt;&lt;Esowo kpˈkahne re ń lˈli, amahr enyahne bahke lennge ḿ bahke kahne ana Esowo, ḿ bahke kahne ji kpˈnobo, a ji kpˈsabe.&gt;&gt;<verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />Eji nnenkal nyehne re nkab eti nyio ebfuumu go amahr, fere nˈnob ellehke, fvfo bahke kake nne ngbere, á kehm bongo li fere song ka nlum no jolo a ne, á tob li. <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />Owo amahr ebo kehm lennge, bo soro liingi elbo re bo li ebun ebun; bo kehm banne abahmbahm efik kanne kpee ko bobo bulu elbo.<verse eid="GEN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />Owo nnenlum a nkal ewe kehm wuku erehm eljen akpade ni Jehova Esowo go etahngga ngare nyi edi ma naange, bo be biiri nti nyi jolo etahngga. <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />Jehova Esowo kehm lungu nnenlum re, &lt;&lt;Wo nona?&gt;&gt;<verse eid="GEN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10" />Á kehm faange re, &lt;&lt;Nyehn me ga, eji n wuk-a no á kpˈbake go etahngga, n jo fˈfahl, tibre n jolo ebun ebun, n kehm beke biiri.&gt;&gt;<verse eid="GEN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11" />Esowo kehm bungu re, &lt;&lt;Nne awo tong-a re a li ebun ebun? Wobli nkab eti go eti ji n ka-a ejehke re wo kˈlia?&gt;&gt;<verse eid="GEN 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12" />Nnenlum kehm faange re, &lt;&lt;Nnenkal no a ka-m no re á jol aname, ye wo ka-m nkab eti nyi lohng eti jio, owo li no.&gt;&gt;<verse eid="GEN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13" />Jehova Esowo kehm tongo nnenkal re, &lt;&lt;Ejum ajii a ma lim a?&gt;&gt;</para>
  <para style="p" vid="GEN 3:13">Nnenkal kehm bungu re, &lt;&lt;Nnyo nyi ma-m nehm, m ma li.&gt;&gt;<verse eid="GEN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />Owo Jehova Esowo kehm tongo nnyo re, &lt;&lt;Tib eji a ma lim ana, &lt;&lt;Nkuk a na go nllong atohkondi kpee, a enyam ekulugbe kpee, a bahke jo tohng ala go ndi, fere jo li ebtohko ndi afung nya a bahke jolo go elkpin. <verse eid="GEN 3:14" /><verse number="15" style="v" sid="GEN 3:15" />M bahke limi ń jol go ekv atemtem, wo a nnenkal, m bahke tob lim abon eba, a ba be jol go ekv, mmon ewe no nlum bahk-a wake esi, wo bahk-e kehre eselsel.&gt;&gt;<verse eid="GEN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />Eji nnenkal á tong-e re, &lt;&lt;M bahke limi jo sahb yam-a yam a lˈkehme abon jel, a bahke jo jel abon ano a elyame elyame nio. Ekor eja kpee bahke jolo ka nnenlum, ye wo bahke jo fil-a.&gt;&gt;<verse eid="GEN 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17" />Go eyaame ji Adam, á tong-e re, &lt;&lt;Tib eji a wuku nkal ewa taame li nkab eti, go eti ji n ka-n erehke re &lt;Kana tiki lio.&gt; &lt;&lt;Ndi ebbel nkuk tib esi eja; a bahke jo lim eltum sahb riid-a riidi kehm jo bel li go afung nya a bahke jolo go elkpin. <verse eid="GEN 3:17" /><verse number="18" style="v" sid="GEN 3:18" />Ndi bahke jo mahng ajoongo, a abarembv ka-a, a bahke jo li akab nti, a anyane go ekulugbe. <verse eid="GEN 3:18" /><verse number="19" style="v" sid="GEN 3:19" />A bahke jo lim eltum yehke nwuuru kehm jo li, tete a kpo feere yel ndi, tibre n ko ndi lim-a; Wo, bo ko ndi lim-a, fvfo a bahke feere yel ndi nyi a lohng no.&gt;&gt;<verse eid="GEN 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />Adam kehm gungu nkal ewe mbing re Iv, tibre ye wo bahke jolo nnyehn no ane kpee.<verse eid="GEN 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 3:21" />Owo Jehova Esowo kehm koko agunyam jamme nsol ka Adam abola Iv nkal ewe, bulu bo. <verse eid="GEN 3:21" /><verse number="22" style="v" sid="GEN 3:22" />Jehova Esowo kehm bungu re, &lt;&lt;Anv nne ebjol ana wahr, yebkahn ji kpˈnobo, a ji kpˈsabe. Wahr ki-e nongo a kpe song bong nkab eti go eti jio ji elkpin li, fere sa kpin nkahlkahl.&gt;&gt; <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />Owo Jehova Esowo kehm-e kame yehke o etahngga jio ji Eden re á song, song lim eltum go ndi nyi á lohng no. <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />Eji Esowo kame nne yehke etahngga, á kehm bumu enjel nyi bo kpo lung-e Serubim go ejang ero nfam bi etahngga ji Eden, a ekahngkahng bi jo fokko enyahng enyahng jo se agun, baabe mbang nyi li rehng go eti ji elkpin.<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">Eka ji Ken a Ebel</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />Owo Adam kehm noongo a Iv nkal ewe á kehm sake ela. Eji ngare rehnge no, á kehm soro jel Ken. Iv kehm bungu re, &lt;&lt;Go ekakebo ji Jehova, me n jel nnenlum.&gt;&gt; <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />Eji ma kang a, á kehm kpe jel etoono mmon no nlum, kehm-e gungu mbing re, Ebel.</para>
  <para style="p" vid="GEN 4:2">Ebel jolo nne no jo le ebul, Ken jolo mbahmgbe. <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />Efung abehng eji nkpake egbe ma rehng, Ken kehm koko nsol mbahmandi enye re á ba lim njom ka Jehova. <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />Abel kehm tob jak atingi agbokombang ebul re á tob ba lim njom ka Jehova. Jehova bele eyebatahng a Ebel a njom enye, <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />a belem eyebatahng a Ken a njom enye. Owo Ken eltim kehm-e sahb rˈrak, á fere go guunu.<verse eid="GEN 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 4:6" />Jehova kehm bahbe Ken re, &lt;&lt;Jenji wahnge eltim kp-a rake ano? Nˈnan a kpˈguunu? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />A lˈlim ji kpˈnobo, bo wa nehm koa? A tohko fere lim ji kpˈnobo, kunu ekpu, tibre abiafem yim na yim rib rib go ga mbutahk kp-a siki, re boba, a bahke ma ga abiafem nyao.<verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />Ken kehm tongo Ebel mmonannyehn re, &lt;&lt;Wahr tahm ekulee.&gt;&gt; Eji bo jolo go ekulugbe, Ken kehm noko a Ebel mmonannyehn wul-e.<verse eid="GEN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9" />Owo Jehova kehm bahbe Ken re, &lt;&lt;Mmonanne Ebel mee?&gt;&gt; Á kehm faange re, &lt;&lt;Me n nehme kahn. Anv, me wo kpo kpur mmonaneea?&gt;&gt;<verse eid="GEN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10" />Jehova kehm bahbe re, &lt;&lt;Jenji a ma lim? Wuungu atung! Alung mmonanne kpˈlingi tob-m go atahng ndi. <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />Nkuk a na. M ma-a kam go ndi nyio nyi lennge nnyo wo alung mmonanne go ega ebo. <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />A lˈlim eltum, ndi nehm kpe jo lak nsol gbˈgbal ka-a. A bahke jolo nne no ki kpi ekehnge go njini nyia, a bahke fere jo yannge na yannge adi adi.&gt;&gt;<verse eid="GEN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13" />Ken kehm bungu tong Jehova re, &lt;&lt;Erem ebame ebgbal sehng ana m bahke ma sol.&gt;&gt; <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />Lela a ma-m kam yehke go ndi, m bahke jo biiri go ega esamahr. A ma-m lim re me n jo yannge na yannge, kˈbel erekekv. Nne awohng awohng no nyehn-m no, bahk-m wulu.<verse eid="GEN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15" />Jehova kehm-e faange re, &lt;&lt;Bo wa nehm wul, tibre nne awohng awohng no wul-a no, m bahk-e bongo nkpel esehma.&gt;&gt; Owo Jehova kehm kake Ken elliingi, eji nne awohng awohng no lˈnyehn-e, á lˈki-e wul. <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />Ken kehm soro mehl lohng esamahr ni Jehova, fere song lene go ndi nyi Nod, go ero nfam nyio nyi Eden.<verse eid="GEN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />Owo Ken kehm noonga nkal ewe, á soro sa ela jel Enok. Ngare nyio Ken jo si ejahbe, á koo mbing a mmon ewe Enok gungu ejahbe. <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />Enok wo jolo nde no Irad, Irad jol nde no Mehujael, Mehujael jol nde no Metusael, Metusael jol nde no Lamek.<verse eid="GEN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 4:19" />Lamek baange akal abal. Awohng bo jo lung-e re, Ada, noko Jila. <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />Ada jele mmon no nlum no bo jo lung-e re Jabal; Ye wo jolo ngbokambang nne no jo lene go nkpatahk, jo le atohkondi. <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />Mmonannyehn no nlum bo jo lung-e re Jubal. Ye wo jolo ngbokambanga nne no kub ebuk, fere jo wor efiri. <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />Jila ji jolo nfahb no Ada, jele Tubal Ken. Ye wo gbo mbang jo tahl ajoobo akuungu, a abilikpi. Mmonannyehn Tubal Ken no nkal bo jo lung-e re Naama.<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />Lamek kehm tongo akal ebe, Ada abola Jila re, wuung-m wahn atung nobnob, wahn akal ba Lamek, wahn wuk-m. Me n wul nne no ba kehme elnoko aname, njankun nyi lim-m nsol. <verse eid="GEN 4:23" /><verse number="24" style="v" sid="GEN 4:24" />Lˈjol re nne no wulu Ken, bo bahk-e bongo nkpel esehma, Noo nne no lˈwul Lamek bo bahke bongo nkpel atahl ara a nkpel elku ebal.<verse eid="GEN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />Owo Adam kehm kpe noongo a nkal ewe, á kehm kpe jel mmon no nlum. Iv gung-e mbing re Set. Tibre Iv bungu re, &lt;&lt;Esowo ma-m ka mmon no nlum, enyo ji Ebel ji Ken wul-e no. <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />Set tob bele mmon no nlum, á gung-e mbing re Enos.</para>
  <para style="p" vid="GEN 4:26">Ngare nyio o wo, ane kehme ellungu mbinga Jehova nyi li saang go elkake.<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">Etˈtohngo ji Adam</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />A wo li etoora nnyo mi bo yeele bade etˈtohngo ji Adam.</para>
  <para style="p" vid="GEN 5:1">Eji Esowo limi nne, á lim-e go elfoongo ni Esowo. <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />Á limi bo nnenlum, a nnenkal, kehm fuulu bo, fere lung bo re, &lt;&lt;Nne.&gt;&gt;<verse eid="GEN 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 5:3" />Adam kange nnya atahl arakera a nnya ewubu, kehm jele mmon no foong-e no, kehm-e gungu mbing re Seti. <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />Eji bo ma jel Set, Adam kpe kang nnya atahltahl nkpel ebal, fere kpe jel abon ba nlum a ba nkal. <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />Aya kpee nya Adam kange no jolo nnya atahltahl nkpel ebal a nnya atahl arakera a nnya ewubu, kehm kpoko.<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />Eji Set ma kang nnya atahl alon a nnya elon, á kehm jele Enos mmon ewe no nlum. <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />Eji bo jele Enos, Set kpe kang nnya atahltahl nkpel ebal a nnya esehma, kpe jel abon ba nlum a ba nkal. <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />Aya kpee nya Set kange no jolo nnya atahltahl nkpel ebal nnya atahl alon, a nnya ewubbal, kehm kpoko.<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />Enos kange nnya atahl ani a nnya ewubu, kehm jele Kenan, mmon ewe no nlum. <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />Eji bo jele Kenan, Enos kpe kang nnya atahltahl nkpel ebal a nnya elku, fere kpe jel abon ba nlum a ba nkal. <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />Aya kpee nya Enos kange no jolo nnya atahltahl nkpel ebal, a nnya atahl alon, a nnya elon, kehm kpoko.<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />Eji Kenan kange nnya atahl ara, a nnya ewubu, á kehm jele Mahalalel mmon ewe no nlum. <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />Eji Kenan ma jel Mahalalel, á kpe kang nnya atahltahl nkpel ebal, a nnya atahl abal, fere kpe jel abon ba nlum a ba nkal. <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />Aya kpee nya Kenan kange no jolo nnya atahltahl nkpel ebal, a nnya atahl alon a nnya ewubu, kehm kpoko.<verse eid="GEN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15" />Eji Mahalalel ma kang nnya atahl ara a nnya elon, á kehm jele Jared mmon ewe no nlum. <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />Eji Mahalalel ma jel Jared á kpe kang nnya atahltahl nkpel ebal a eltahl a nnya ewubu, fere jel abon ba nlum a ba nkal. <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />Aya kpee nya Mahalalel kange no jolo nnya atahltahl nkpel ebal a nnya atahl ani, a nnya elku, kehm kpoko.<verse eid="GEN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18" />Eji Jared ma kang nnya atahl anehkeni, a nnya ebal, á kehm jele Enok mmon ewe no nlum. <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />Eji Jared ma jel Enok, á kpe kang nnya atahltahl nkpe ebal, fere kpe jel abon ba nlum, a ba nkal. <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />Aya kpee nya Jared kange no jolo nnya atahltahk nkpel ebal, a nnya atahl anehkeni, a nnya ebal, kehm kpoko.<verse eid="GEN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21" />Eji Enok ma kang nnya atahl ara, a nnya elon, á kehm jele Metusela mmon ewe no nlum. <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />Eji Enok ma jel Metusela, á bele eljini ni jo kor Esowo go nnya atahlku, fere kpe jel abon ba nlum, a ba nkal. <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />Aya kpee nya Enok kange no jolo nnya atahlku, nnya atahl ara, a nnya elon. <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />Enok bele eljini ni jo kor Esowo. Esowo rod-e tahm a ne, á kpeem jol, tibre Esowo rod-e tahm a ne.<verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />Metusela kange nnya atahl asehmwubu, a nnya esehma, kehm jele Lamek, mmon ewe no nlum. <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />Eji Metusela ma jel Lamek, á kpe kang nnya atahltahl atahlku a nnya atahl ani, a nnya ebal, fere kpe jel abon ba nlum a ba nkal. <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />Aya kpee nya Metusela kange no jolo nnya atahltahl nkpel ebal, a nnya atahl anehkeni a nnya esehmwubu, kehm kpoko.<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />Eji Lamek ma kang nnya atahl asehmwubu, a nnya ebal kehm jele mmon no nlum. <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />Lamek gung-e mbing re Noa, kehm bungu re, &lt;&lt;Ye wo bahk-r kake eltim go ejahkjahk eltum ni e kpˈlimi egahre abo go ndi nyi Jehova ma su.&gt;&gt; <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />Eji Lamek ma jel Noa, á kpe kang nnya atahltahl, a nnya atahl asehmwubu, a nnya elku, fere kpe jel abon ba nlum a ba nkal. <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />Aya kpee nya Lamek kange no jolo nnya atahltahl, a nnya atahlku a nnya atahl ara a nnya elku ebal, kehm kpoko.<verse eid="GEN 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />Ngare nyi Noa kange nnya atahltahl atahl alon, á jele abon ba nlum na ara. Abing ebo nya a; Sem, Ham, a Jafed.<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">Abˈbi nya ane</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />Eji aneblum kehme elnyabe go njini, bo fere jo jel abon ba nkal ka bo. <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />Abon ba nlum ba Esowo nyehne kan re anebkal ebjol anebe ano, bo kehm kehme akal baange ana koro bo. <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />Owo Jehova kehm bungu re, &lt;&lt;Elv ename ni kpi elkpin nehm kpe jol atahng nne, go njinanjini, tibre nne lohko li na ngubjing nyi kpo kpo, afung elkpin nya nne, nehm kpe jo sehnge nnya atahl arakera.&gt;&gt;<verse eid="GEN 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 6:4" />Agbungulu ane jolo njini ba bo jo lung re Nefilim, bomo ngare nyio asongo, eji abon ba nlum ba Esowo jo noongo a anebkal ba ane, bo jel abon ka bo, bo jolo atakuru nya mahne mahne nya bele elgahm.<verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />Jehova kehm nyehne re abˈbi nya ane jo lim ebgbal sehng go njini, fere kahn re ntir nyi nne go ge eltim abˈbi abˈbi nya ngare anyehng anyehng. <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />Jehova yame go eltim sehng re yeblim nne go njini. Ejum jia yame Esowo sehng. <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />Owo Jehova kehm bungu re, &lt;&lt;M bahke feenge ane kpee ba m ma lim. M bahke tob feenge enyam kpee, a ejum ajehng ajehng ji kpo tohng ala go ndi, a nruk nyi kpo fonngo go ero, tibre ma-m yam sehng re me n tohko lˈlim bo.&gt;&gt; <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />Wo Noa limi ji jo kor Esowo.<verse eid="GEN 6:8" /></para>
  <para style="s">Eka ji Noa, a egbang bi á si no</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />A wo li ntoora nnyo mi li bada Noa. Noa jolo etingitingi nne, ebi ajehng ajehng á limem go ane ba jolo go egea ngare. Á bele eljini ni jo kor Esowo. <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />Noa bele abon ba nlum na ara: ngbokambang bo jo lung-e re Sem, etoono Ham, a Jafed.<verse eid="GEN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 6:11" />Ngare nyio njini jolo abˈbi abˈbi go esamahr Esowo, atongtong jolo edi ajehng ajehng. <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />Esowo kehm seenge nyehn ana njini ma rannge, tibre ane kpee ba jolo go njini rˈrannge abang ebo. <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />Owo Esowo kehm bungu tong Noa re, m bahke feenge ane kpee, tibre boblim atongtong ebgbal sehng go njini. Etingitingi m bahke feenge bo, fere tane njini. <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />Ko eti ji bo kpo lung re sipress, wo kono egbang bi nlen, kak akimi, lim jol sahd sahd wo ko nnyake elak roongo go atahng a alatahk. <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />Ana wo a bahke sehke egbang: Alab egbang bahke jolo erula atahltahl erula atahl abal, erula ebwubu, akpang enye bahke jolo, erula atahl ara, erula elku, elwahre bahke jolo erula atahl abal erula eblon. <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />Lim elbulu ene, yake edi jo foong, bomo nkahl egbang rehng elbulu, jol ejum erula ajehng kunu esi, kak mbutahk go nkpe egbang, wo lim nkpake era go atahng, nyi li reed, a etoono, a nyi kpˈwahre. <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />M bahke koko nnyel ba bulu njini nyia kpee nyi bahke rannge ejum ajehng ajehng ji li go elkpin. Ejum ajehng ajehng go njini bahke kpoko. <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />M bahke limi egbanngalung ejame a na. A bahke yele egbang bia a abon eba ba nlum, a nkal ewa, a akal abon eba. <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />A bahke koko ejum ajehng ajehng ji li go elkpin, nlum, a nkal, bo ba woomo a na go egbang. Eji bo lˈkˈkpo. <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />Elkohn ebruk abehng abehng, a nnyam anyehng anyehng, nkal a nlum, a ejum ajehng ajehng ji kpo tohng go ndi, bo bahke bake a bum bo go elkpin. <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />Ko nsol ellehke anyehng anyehng nyi ḿ bahke jo li, wo kuuru go egbang, eji ḿ bahke jo li a enyam enyam bio.<verse eid="GEN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 6:22" />Ano wo Noa limi ejum ajehng ajehng ana Esowo tong-e no.<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">Nnyel nyi bulu njini</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />Jehova kehm tongo Noa re, &lt;&lt;Mehl wo song yel egbang, wo a ebangenahb eja kpee, tibre me n kahn re, wo wo li etingi nne go eying jia <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />Rod enyam bi li saang esamahr Esowo, enyam esehma esehma, nlum a nkal, a elkohn enyam bi ki li saang esamahr Esowo, enyam ebal ebal, nlum a nkal, <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />tob ko ajoobo nruk esehma esehma, nlum a nkal, kpur bo bo jol elkpin, eji bo lˈjel behnjehle go njini. <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />Bomo anv asongo, lˈrehng nfung esehma, m bahke tumu elahb tv ndi, bahke nake nfung atahl abal, atv atahl abal, m bahke rannge ejum ajehng ajehng ji li go elkpin, ji n limi no bum go njini.&gt;&gt; <verse eid="GEN 7:4" /><verse number="5" style="v" sid="GEN 7:5" />Noa limi ejum ajehng ajehng ji Jehova tong-e no. <verse eid="GEN 7:5" /><verse number="6" style="v" sid="GEN 7:6" />Noa kange nnya atahltahl a nnya atahl awubu ngare nyi nnyel ba go njini. <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />Owo Noa a abon ebe ba nlum, nkal ewe, go akal abon ebe kehm yele egbang re bo tahre elbo go nnyel nyio. <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />Enyam bi jolo saang esamahr Esowo, a bi ki jol saang esamahr Esowo, nkal a nlum, nkal a nlum, nruk a ajoobo enyam bi kpo tohng ala go ndi, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />nlum a nkal, kehm bake goji Noa ba yel egbang, ana Esowo kaa Noa ejehke. <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />Eji ma sehng nfung esehma, nnyel kehm bake go njini. <verse eid="GEN 7:10" /><verse number="11" style="v" sid="GEN 7:11" />Go elku a nfung ebal mi etoono nnyahng, elya ni Noa kpˈrehnge nnya atahltahl a nnya atahl awubu, efung bˈnehm o bi abˈbehl alahb nya atahng ndi bohngo lohng, abuk alahb nya elbung lennge. <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />Elahb kehm nake nfung atahl abal, a atv atahl abal. <verse eid="GEN 7:12" /><verse number="13" style="v" sid="GEN 7:13" />Efung bˈnehm o bi Noa a abon ebe ba nlum, Sem, Ham, a Jafed, a nkal ewe, akal abon ebe na ara mehle yel egbang. <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />Ajoobo enyam nkohnankohn woomo a bo o egbang ana ajoobo atohkondi go nkohnankohn, a ajoobo enyam bi kpo tohng ala go ndi, a ajoobo nrur go nkohnankohn, go ejum ajehng ajehng ji kpi akpungkpung. <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />Ejum ajehng ajehng ji kpi elkpin, nlum a nkal, ba goji Noa ba yel go egbang. <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />Ana wo jolo no, ejum ajehng ajehng ji kpi elkpin nlum a nkal, yele go egbang ana Esowo kaa Noa ejehke. Owo Jehova kehm bame bo tv. <verse eid="GEN 7:16" /><verse number="17" style="v" sid="GEN 7:17" />Go nfung atahl abal nnyel kehm kpe jo yel na budu go ndi, ana alahb jo yel ano wo jo mehl egbang bio go ndi wahre. <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />Alahb kehm sahb yˈyel, egbang jo fuungu go ero alahb. <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />Alahb soro asi jo yel bulu awahre wahre awong kpee go ndi. <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />Alahb yele bulu awong nya sahb wˈwahre, kpe wahre na sehnge erula eltahl. <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />Ejum ajehng ajehng ji jolo go elkpin, ji kpo jen ndi rannge kpee, nruk, atohkondi, enyam ekulugbe, a anyam nyame kpee nya kpo fonngo go elbung, a ane ane kpee. <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />Ejum ajehng ajehng ji kpo v elv, ji jolo egbuk, kpo kpee. <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />Ejum ajehng ajehng ji jolo go elkpin rannge kpee go ndi, ane, enyam, a ejum ajehng ajehng ji kpo tohng ala go ndi, nruk nyi kpo fonngo go ero, rannge bo kpee. Noa ntahng ntahng wo sa, a ane ba woomo a ne go egbang. <verse eid="GEN 7:23" /><verse number="24" style="v" sid="GEN 7:24" />Nnyel bulu ndi kpee go nfung atahl asehma a nfung ewubu.<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">Ana Alahb ka no</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />Owo Esowo kehm buumu Noa, a enyam ekulugbe bi woomo a ne go egbang, a atohkondi atohkondi. Á kehm tumu elfeb tv go njini, nnyel alahb kehm kehme elrede. <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />Abˈbehl alahb nya jolo go atahng ndi, a abuk alahb nya ya no go elbung sˈsahd, elahb tob rahke elnake. <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />Owo alahb ma yele bulu njini kehm kehme elrede, eji ma kang nfung atahl asehma a nfung ewubu alahb ebsahb rˈrede. <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />Go elku a nfung ebal nyi nnyahng esehma, egbang kehm ba kuumu go agburu awong nya Ararad. <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />Alahb soro na asi jo rede tete rehng nnyahng ewubu, go ngbokambang efung bi nnyahng ewubu aro awong kehme ellohngo. <verse eid="GEN 8:5" /><verse number="6" style="v" sid="GEN 8:6" />Eji ma kang nfung atahl abal, Noa kehm lennge ewindu go egbang bi a limi no, <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />kehm tumu nyakenyake mbare emel ebruk bi jo fonngo yannge na yannge tete alahb ka go ndi kpee. <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />Á kehm tumu ebbehl re á song kpur joare alahb ebka mal go ndi. <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />Jol ebbehl belem na edi ji á bahke ma kuumu, tibre alahb bulu ndi kpee, owo ebbehl kehm feere goji Noa egbang, Noa kehm tanne ebo ebe, ana ebbehl kuum-e go ebo á feere a ne kak go egbang. <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />Kpe kang kan nfung esehma, á kehm kpe yehke ebbehl tum. <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />Eji ebbehl feere no ba ngare elgung, á ko elyane oliv ni mbir mbir go ege a nnyo, ba a ni. Noa kehm kahne re alahb ebsahb rˈrede go ndi. <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />Eji ma kpe kang nfung esehma yehko, á kpe tum ebbehl, wo esennge jia ebbehl kpeem feere goji Noa. <verse eid="GEN 8:12" /><verse number="13" style="v" sid="GEN 8:13" />Go ngbokambang efung bi ngbokambang a nnyahng, eji Noa ma kang nnya atahltahl, atahl awubu a elya anehng, ngare nyia alahb ebka go ndi, owo Noa kehm laade elkong egbang kehm seenge nyehn re ndi ebwum. <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />Go eltahl a nfung esehma go etoono nnyahng ndi gohro wum kpee. <verse eid="GEN 8:14" /><verse number="15" style="v" sid="GEN 8:15" />Owo Esowo kehm bungu tong Noa re, <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />&lt;&lt;Lohng go egbang, wo a nkal ewa, a abon eba, go akal abon eba. <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />Yehke elkohn ejum ajehng ajehng go egbang ji li go elkpin, nrur, enyam, a nsol kpee nyi kpo tohng ala go ndi, eji bo lˈjel sahb rˈrur go njini. <verse eid="GEN 8:17" /><verse number="18" style="v" sid="GEN 8:18" />Owo Noa kehm lohngo go egbang, a nkal ewe, a abon ebe, go akal abon ebe. <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />Enyam kpee, a nsol kpee nyi kpo tohng ala go ndi, a nruk kpee, go ejum ajehng ajehng ji kpo jen go ndi, bo kehm jo lohng go egbang nkohnakohn.<verse eid="GEN 8:19" /></para>
  <para style="s">Noa limi njom ka Esowo</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />Owo Noa kehm limi egudu njom alimi ka Jehova. Go ellong enyam, a nruk kpee nyi jolo saang ka Esowo, Noa yehke nyandiki, ko lim njom nyi eljahme fi ka Jehova, egudu njom jio. <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />Jehova njom nyio kehme vohko esvsv eleenge, á kehm bungu go ege eltim re, &lt;&lt;N nehm kpe tiki su ndi tib esi ji nne, jol eji li li re ntir anyehng anyehng nyi nne go ge eltim tiki li ebi ntir, bomo ese ese. N nehm kpe tiki rannge nsol nyi li go elkpin kpee ana m ma lim a. <verse eid="GEN 8:21" /><verse number="22" style="v" sid="GEN 8:22" />&lt;&lt;Ana ndi tik kpe li, ngare elbahme a ngare elkpake, ngare alohk a ngare ewannge, elum a nnale, afung, a atv.&gt;&gt;<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">Egbanngalung ji Esowo limi a Noa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />Esowo kehm fuulu Noa, a abon ebe fere tong bo re, &lt;&lt;Jelen, wahn gbal, nyab rur go njini. <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />Enyam kpee bi li go njini bahke jo fahl-n fahl, ń fere jo mennge bo, fvfo nruk nyi kpo fonngo go ero, a ejum ajehng ajehng ji kpo tohng ala go ndi, a nsahre kpee nyi wob alahb. Nsol nyia kpee me nfaake kak-n go abo. <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />Ejum ajehng ajehng ji kpi elkpin, ji kpo jen go ndi ma-n ka re jol nsol alehke enyahne. Ana n ka-n nsol nyi lohng go nti, a ajele, ana nsol alehke, ano wo m ma-n tob ka ejum ajehng ajehng anv.<verse eid="GEN 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 9:4" />&lt;&lt;Ka tiki li nnyam a alung eme go atahng, alung ma li elkpin ene. <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />M bahke bahbe alung ema, alung ma elkpin ena abo ejum ajehng ajehng ji wul-a no. M bahke tob bahb go abo nya nnyam anyehng anyehng nyi wul-a no, m bahke bahbe alung go abo nne no wulu nne noko. <verse eid="GEN 9:5" /><verse number="6" style="v" sid="GEN 9:6" />&lt;&lt;Nne no lˈwul nne, nne bahke tob wul-e, tibre Esowo limi nne go ege elfoongo. <verse eid="GEN 9:6" /><verse number="7" style="v" sid="GEN 9:7" />Ka wahn, jelen, wahn rur go nfange, wahn sahb nyˈnyab go njini.&gt;&gt;<verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />Esowo kehm bungu tong Noa a abon ebe re; <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />&lt;&lt;Anv n kpˈlimi agbanngalung ejame a na, a etˈtohngo eja ji kpa-a toono, <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />a nsol kpee nyi li elkpin nyi jolo a na, nruk, atohkondi, a enyam ekulugbe, bo kpee ji lohngo go egbang a na, a ejum ajehng ajehng ji li go elkpin go njini. <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />Me n lim egbanngalung a nahne: Nnyel nehm kpe tiki jol nyi bahke tane elkpin ejum ajehng ajehng ji li go elkpin, jol elkohn nnyel ana nyio nehm kpe tiki jol nyi bahke rannge njini.&gt;&gt;<verse eid="GEN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 9:12" />Esowo kehm bung re, &lt;&lt;A wo li elliingi ni egbannalung ji n kpˈlimi me a na, a ejum ajehng ajehng ji li go elkpin a na, egbanngalung jia bahke jolo ano ano ka aying nya kpˈbake: <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />Me n bum ebangenjok go akparesemsem, ji ji bahke jolo elliingi ni egbanngalung ka-m a njini. <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />Ngare anyehng anyehng nyi akparesemsem lˈlohng go elbung, ebangenjok fere lohng go akparesemsem, <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />m bahke buumu egbannalung ejame ji n limi a na, a ejum ajehng ajehng ji li go elkpin. Alahb nehm kpe tiki yel rannge nsol kpee nyi li elkpin. <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />Ngare anyehng anyehng nyi ebangenjok lˈsi lˈlohng go akparesemsem, m bahke nyehne fere buumu egbanngalung ejame ji n limi no a ejum ajehng ajehng ji li go elkpin go njini, egbanngalung ejame li nkahlkahl.<verse eid="GEN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 9:17" />Esowo kehm tongo Noa re, &lt;&lt;Ebangenjok jio ji li elliingi ni egbanngalung ejame ji m ma lim a ejum ajehng ajehng ji li go elkpin go njini.&gt;&gt;<verse eid="GEN 9:17" /></para>
  <para style="s">Noa a abon ebe</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />Abone Noa ba lohngo go egbang, jolo Sem, Ham, go Jafed. Ham wo jolo nde no Kenan. <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />Abon ara ba Noa ba a. Ane kpee ba ma rur go njini, lohng goji bo.<verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />Noa bahme egbe agreb, á kehm tahme song bahm etahngga avain. <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />Eji á wo amahm agreb, á kehm soro gbo njok, song noongo go ege mmobkpatahk ebun ebun. <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />Ham ji jolo nde no Kenan kehm song nyehn nde nong ebun ebun, kehm lohngo ba tong abonanyehn abal ga alatahk. <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />Owo Sem abola Jafed kehm rodo ekpawobo konngo elbo go akpakebahk, fere jo jen njahm njahm song yake ekpawobo jio bulu nde abo, bo jo seenge go nkpe, bo sebem re bo nyehn ana nde bo nong ebun ebun.<verse eid="GEN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 9:24" />Eji Noa nyahme no go ellu amahm, fere seb kahn ji nkalla mmon ewe ma lim tob-e, <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />á kehm bungu re, &lt;&lt;Elsu li ka Kenan, á bahke jolo nju nyi sahb rˈrede ka abonanyehn.&gt;&gt;<verse eid="GEN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 9:26" />Á kpe bung re, &lt;&lt;Elfuulu jol ka Jehova, ye ji li Esowo bi Sem, nong Kenan jol eju ka Sem. <verse eid="GEN 9:26" /><verse number="27" style="v" sid="GEN 9:27" />Nong Esowo lim Jafed á nyange, nong Jafed lene go nkpatahk nyi Sem, nong Kenan jol eju ka-e.&gt;&gt;<verse eid="GEN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />Eji nnyel ma sehng, Noa kange nnya atahlku, a nnya atahl abal a nnya ewubu. <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />Nnya kpee nyi Noa kange no jolo nnya atahltahl nkpel ebal, nnya atahl asehma a nnya ewubu, kehm kpoko.<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s">Atˈtohngo nya abon ba Noa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />A wo li ntoora nnyo mi li bade abone Noa ba nlum, Sem, Ham, a Jafed. Bofono tob jele abon ngare nyi nnyel ma sehng.<verse eid="GEN 10:1" /></para>
  <para style="s">Etˈtohngo ji Jafed</para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 10:2" />Abon ba nlum ba Jafed ba a: Goma, Magog, Madayi, Javan, Tubal, Mesek, go Tiras. <verse eid="GEN 10:2" /><verse number="3" style="v" sid="GEN 10:3" />Abon ba nlum ba Goma ba a: Askenas, Rifad, a Togama. <verse eid="GEN 10:3" /><verse number="4" style="v" sid="GEN 10:4" />Abon ba nlum ba Javan ba a: Elisa, Tarsis<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="ft">Bo ba bumu elsi ni Speen </char></note>, go anebe Kitim, go anebe Rodan.<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="ft">Rodan wo kake elsi ni Rodish</char></note> <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />E bo atˈtohngo wo ane ba lene nkpe alahb nkpe alahb lohng no, yaame ni ellong song kak elsi nˈne, a elatahkgur jˈje, a ejahbe jˈje, a nfam a nfam ebo.<verse eid="GEN 10:5" /></para>
  <para style="s">Etˈtohngo ji Ham</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 10:6" />Abon ba nlum ba Ham ba a: Kus, Mijraim,<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft">Mijraim wo kake elsi ni Ijib</char></note> Pud,<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft">Pud wo kake elsi ni Libya</char></note> go Kenan.<verse eid="GEN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 10:7" />Abon ba nlum ba Kus ba a: Seba, Havila, Sabta, Raama, go Sabteka. Abon ba nlum ba Raama ba a: Seba abola Dedan.<verse eid="GEN 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 10:8" />Kus wo jolo nde no Nimrod, ji gbale jol egburu ntakuru a nne go njini. <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />Á jolo egburu egbaji ebim go esamahr bi Jehova, owo wahnge bo jo bung re, &lt;&lt;Ana Nimrod, ji jolo egburu mbimi ebim go esamahr Jehova.&gt;&gt; <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />Agbokambanga aji etul nya Nimrod kake no jolo Babilon, Erek, Akad, a Kalne ji jolo go Sinar.<note caller="+" style="f"><char style="fr" closed="false">10:10 </char><char style="ft">Sinai ji li Babilonia</char></note> <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />Nimrod lohngo o ndi nyio fere song lene go Asiria, owo á kpe song kak nsi nyehko nyi Nineve, Rehobod Ir, Kala, <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />go Resen ji jolo elka elka ni Nineve abola Kala ji jolo egburu ejahbe. <verse eid="GEN 10:12" /><verse number="13" style="v" sid="GEN 10:13" />Mijraim wo jolo nde no anebe Lud, a anebe Anam, a anebe Lehab, a anebe Nabtu, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />a anebe Patrus, a anebe Kashlu (a wo anebe Filistia lohng no) a anebe Kabto. <verse eid="GEN 10:14" /><verse number="15" style="v" sid="GEN 10:15" />Kenan wo jolo nde no Sidon, Sidon wo jolo ngbokambang mmon ewe no nlum. Kenan tob jolo nde no anebe Hid. <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />Anebe Jebus, anebe Amor, anebe Girgasa, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />anebe Hiv, anebe Ark, anebe Sin, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />anebe Arvad, anebe Jemar, a anebe Hamad. Eji ma kang, anebe Kenan kehm nyange, <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />nkonandi nyi Kenan bomo go Sidon asongo go Gerar, tete rehng go Gaja, sehng o rehng go Sodom, Gomora, Adma, Jeboyim tete rehng Lasa.<verse eid="GEN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 10:20" />A wo li abon ba nlum ba Ham. Ana wo bo jolo no song kak elsi ni bo, a elatahkgur nya bo, a ejahbe ji bo, a nfam a nfam ebo.<verse eid="GEN 10:20" /></para>
  <para style="s">Anebe Sem</para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />Sem ji jolo mmonannyehna Jafed no nkul tob jele abon ba nlum. Sem wo jolo nde nne no nkul go abon kpee ba Eber.<note caller="+" style="f"><char style="fr" closed="false">10:21 </char><char style="ft">Anebe Eber ba li anebe Hibru</char></note> <verse eid="GEN 10:21" /><verse number="22" style="v" sid="GEN 10:22" />Abon ba nlum ba Sem ba a: Elam, Asur, Arfasad, Lud, a Aram. <verse eid="GEN 10:22" /><verse number="23" style="v" sid="GEN 10:23" />Abon ba nlum ba Aram ba a: Uju, Hul, Geter, a Mesek. <verse eid="GEN 10:23" /><verse number="24" style="v" sid="GEN 10:24" />Arfasad wo jolo nde no Sela, Sela tob jol nde no Eber. <verse eid="GEN 10:24" /><verse number="25" style="v" sid="GEN 10:25" />Eber jele abon ba nlum abal, ngbokambang bo jo lung-e re Peleg, tibre egea ngare wo njini yabe no, mmonannyehn bo jo lung-e re Joktan. <verse eid="GEN 10:25" /><verse number="26" style="v" sid="GEN 10:26" />Joktan wo jolo nde no Almodad, Selef, Hajarmaved, Jera, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />Hadoram, Ujal, Dikla, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />Obal, Abimael, Seba, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />Ofir, Havila, abola Jobab. Ane baa kpee jolo abon ba nlum ba Joktan. <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />Ejang bi bo lene no, bomo go Mesa tete song rehng go Sefar, go ejahbe ewong ji ero nfam. <verse eid="GEN 10:30" /><verse number="31" style="v" sid="GEN 10:31" />Abon ba nlum ba Sem ba a. Ana wo bo jolo no song kak elsi ni bo, a elatahkgur nya bo, a ejahbe ji bo, a nfam a nfam ebo.<verse eid="GEN 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32" />A wo li ajahbe nya abon ba nlum ba Noa, Go ellong nia wo ajahbe yaame yel go njini kpee, ngare nyi nnyel ma sehng.<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">Nkahmbungubungu etahk ji Babel</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />Njini kpee bele ejahbe ajehng, jo bung elkohn ellum anehng. <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />Eji ane kpee mehle jo jen asongo go ero nfam, bo kehm song nyehn edi ji li balebale go Sinar kak elsi o.<verse eid="GEN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 11:3" />Bo kehm bungu tong atemtem re, &lt;&lt;Baan, wahr koon ndi, so, fere wo go agun nˈnob.&gt;&gt; Bo ko abahk ndi nyao, atal bo koom, bo ko nnyakenyake elak jo lang. <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />Bo kehm kpe bung re, &lt;&lt;Nong wahr siin ejahbe ka elnahre, fere tob si nkahmbungubungu etahk ji bahke rehnge go elbung, eji mbing enyahre lˈlohng, tohko jol ano, e bahke yaame atemtem sa rehng go nkpohka njini anyehng anyehng.<verse eid="GEN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5" />Jehova kehm badde ba nyehn ejahbe jio, a nkahmbungubungu etahk ji ane bao jo si. <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />Jehova kehm bungu re, &lt;&lt;Eji ane baa li ajehng, kpˈbungu ejahbejahbe ajehng ma kehme ellimi a na, jio ejumjum limm ji ane baa lˈseb re bo lim, bo lˈkˈma lim. <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />Nong wahr badden song lim ejahbe ji bo kpˈbungu bil bo amahr.<verse eid="GEN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 11:8" />Jehova kehm limi bo, bo yaame o edi jio faade kpee go njini, fere rahke ejahbe jio go elsehke. <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />Owo wahng ka bo jo lung ejahbe jio re Bebel,<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft">Babel lohngo re ebilamahr</char></note> tibre edi jio wo Jehova limi re bil bo amahr. Edi jˈnehm o wo Jehova limi re bo yaame faade go njini kpee.<verse eid="GEN 11:9" /></para>
  <para style="s">Etˈtohngo ji Sem ji a</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />A wo li ntoora nnyo mi li bade etˈtohngo ji Sem. Eji ma kang nnya ebal nyi nnyel ma sehng, ngare nyia Sem ebkang nnya atahl alon, á jele mmon no nlum no bo jo lung-e re Arfasad. <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />Ngare nyi Sem ma jel Arfasad, á kange nnya atahltahl atahl alon, kpe jel abon bako ba nlum, a ba nkal.<verse eid="GEN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12" />Eji Arfasad ma kang eltahl a nnya elku, á jele Sela. <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />Eji Arfasad jele Sela, á kange nnya atahltahl a nnya era. Á kpe jel abon bako ba nlum, a ba nkal.<verse eid="GEN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 11:14" />Eji Sela ma kang eltahl a nnya ewubu, á kehm jele Eber. <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />Eji Sela ma jel Eber á kange nnya atahltahl a nnya era, kpe jel abon bako ba nlum a ba nkal.<verse eid="GEN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16" />Eji Eber ma kang eltahl a nnya ewubu a nnya eni, á kehm jele Peleg. <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />Eji Eber ma jel Peleg, á kange nnya atahltahl kunu eltahl a nnya ewubu, kpe jel abon bako ba nlum a ba nkal.<verse eid="GEN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18" />Eji Peleg ma kang eltahl a nnya ewubu, á kehm jele Reu. <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />Eji Peleg ma jel Reu, á kange nnya atahl awubu a nnya esehmwubu, kpe jel abo bako ba nlum, a ba nkal.<verse eid="GEN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20" />Eji Reu ma kang eltahl a nnya ewubu a nnya ebal, á kehm jele Serug. <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />Eji Reu ma jel Serug, á kange nnya atahl awubu a nnya esehma, kpe jel abon bako ba nlum, a ba nkal.<verse eid="GEN 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22" />Eji Serug ma kang eltahl a nnya ewubu, á kehm jele Nahor. <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />Eji Serug ma jel Nahor, á kange nnya atahl awubu, kpe jel abon bako ba nlum, a ba nkal.<verse eid="GEN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24" />Eji Nahor ma kang eltahl a nnya esehmwubu, á kehm jele Tera. <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />Eji Naho ma jel Terah, á kange nnya atahl alon a nnya elku nnya eni, á kpe jel abon bako ba nlum a ba nkal.<verse eid="GEN 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26" />Eji Tera ma kang nnya atahl ara a nnya ewubu, á kehm jele Ebram, Nahor a Haran.<verse eid="GEN 11:26" /></para>
  <para style="s">Ntoora nnyo mi etˈtohngo ji Tera.</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />A wo li ntoora nnyo mi ettohngo ji Tera. Tera wo jele Ebram, Nahor a Haran. Haran wo jele Lot. <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />Haran kpo go Ur ji li go Kaldia, edi ji bo jel-e no. Ngare nyio nde Tera kpeka li go elkpin. <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />Ebram abola Nahor kehm ba ko akal. Mbing nyi nkala Ebram bo jo lung-e re Sarayi, no Nahor bo jo lung-e re Milkah; Haran wo jolo nde no Milkah abola Iskah. <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />Sarayi jolo ngum, mmon awohng awohng á belem.<verse eid="GEN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31" />Tera kehm rodo Ebram mmon ewe, a Lot ji Haran jel-e no, ji jolo mmon no mmon ewe, go Sarayi ji jolo nkala mmon ewe Ebram, bo kpee kehm mehle o Ur ji li go Kaldia jo tahm asongo go Kenan, eji bo song rehng go edi ji bo jo lung re Haran, bo kehm sake jol o.<verse eid="GEN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 11:32" />Nnya kpee nyi Tera kange no jolo nnya atahl awubu a nnya elon, o Haran wo á kpo no.<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">Ellungu ni Esowo lungu Ebram</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />Jehova tongo Ebram re, &lt;&lt;Lohng ega ejahbe, wo yake ane eba, fere tob yake nlaaga nyi nso, wo song, m bahk-a tibi edi ndi ji a bahke jolo. <verse eid="GEN 12:1" /><verse number="2" style="v" sid="GEN 12:2" />&lt;&lt;M bahk-a koko lim egburu ejahbe, m bahk-a fuulu; m bahke limi mbing enya gbal, a bahke jolo efuulu fuulu nne ka ane bako. <verse eid="GEN 12:2" /><verse number="3" style="v" sid="GEN 12:3" />M bahke fuulu ane ba lˈfuul-a, nne awohng awohng no lˈsua, m bahk-e tob su; wo wo bahke wahnge ane kpee ba li go njini bel elfuulu.&gt;&gt;<verse eid="GEN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />Ebram kehm tahme ana Jehova tong-e no; Lot tob tahme toon-e. Ngare nyio nyi Ebram mehle o Haran asongo yebkang nnya atahl ara a nnya elku. <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />Ebram rodo Sarayi nkal ewe, a Lot ji jolo nfun ewe, a nsol a nsol ebo kpee, a ane ba bo bele no go Haran tahm asongo go ndi nyi Kenan, lohko song rehng go.<verse eid="GEN 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 12:6" />Ebram jene eljen go ndi nyio tete song rehng go ejang bi egburu eti ji jolo go ejahbe ji bo jo lung re Moreh ji li kohlo Sekem. Ngare nyio anebe Kenan baa kpeka lene o. <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />Jehova kehm ba kpiri Ebram, kehm-e tongo re, &lt;&lt;Edi ndi jia m bahke kake abon eba. Ebram kehm limi egudu njom alimi ka Jehova, ye ji lohngo ba kpir-e.<verse eid="GEN 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 12:8" />Ebram mehle o asongo go awong nya li ero nfam bio bi Betel, song si ebkpatahk ebe o. Betel jolo erede, Ai jol go ero nfam. Ona wo á limi egudu njom ji Jehova, jo lung mbing nyi Jehova. <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />Ebram kehm kpe tahm o tete asongo go Negev.<verse eid="GEN 12:9" /></para>
  <para style="s">Ebram tahme go Ijib</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />Ngare nyia njal jolo go ndi nyio, Ebram kehm tahme go Ijib re a tohko song jol go, tibre njal gbale sehng. <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />Eji a yahke rehng go Ijib, a kehm tongo Sarayi nkal ewe re, &lt;&lt;N kpˈkahne re wo nne ano wo. <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />Anebe Ijib lˈsi nyehn-a nyehn, bo bahke bungu re, &lt;Nkal ewe wo a.&gt; Bo bahk-m wulu, wo bo bahk-a yake. <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />Lub bung re wo mmonannee wo, eji bo lˈki-m wul, bo lˈfil-m nob nob tib esi eja.&gt;&gt; <verse eid="GEN 12:13" /><verse number="14" style="v" sid="GEN 12:14" />Eji Ebram rehnge go Ijib, anebe Ijib nyehne re Sarayi gbo egbahme sehng. <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />Ana atubesi abalimeltum Fero nyehn-e no, bo kehm song tehke tong Fero, bo kehm-e rodo tahm a ne go ekpasiki Fero. <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />Fero fili Ebram nob nob tib esi Sarayi, Ebram gbo afang bel ejoro, adahmagbudu, a ebvankang, alum a akal, a akamel go alokeltum ba nlum, a ba nkal. <verse eid="GEN 12:16" /><verse number="17" style="v" sid="GEN 12:17" />Owo Jehova kehm tubu Fero abi ayam, a nlaaga a nlaaga enye, tib esi Sarayi nkala Ebram. <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />Fero kehm tumu tv Ebram re a ba. Kehm bungu re, &lt;&lt;Nˈnan a ma-m lim ana?&gt;&gt; Jenji wahnge a ki-m tong re nkal ewa wo? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />Nˈnan a kehm bungu re, &lt;Mmonanne wo,&gt; ma wahng m me-e ko ana nkal ewame? Anv, nyehn nkal ewa a, rod-e song a ne!&gt;&gt; <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />Fero kehm kake alokeltum ebe nsahm bade Ebram a ane ebe. Bo kehm-e song tv mbang, a nkal a nsol kpee nyi Ebram bele no.<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s">Elyaame ni Ebram a Lod yaame no</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />Ebram kehm lohngo go Ijib tahm go Negev, a nkal ewe, a nsol nyi a bele no, Lod tob tahme toon-e. <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />Ngare nyia Ebram ebgbo afang nya atohkondi, a nya asilva, a agul. <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />A mehle go Negev jo yannge adi adi, tete ba rehng go Betel, go elka elka ni Betel a Ai edi ji a tohko si ebkpatahk, <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />edi ji a gbo mbang lim egudu njom. Owo Ebram jo kak Jehova. <verse eid="GEN 13:4" /><verse number="5" style="v" sid="GEN 13:5" />Ngare nyia Lod ji jo yannge toono Ebram, tob bele atohkondi, a nkpatahk. <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />Atohkondi ebo nsol alehke joom kpe biingi bo, eji bo jolo edi ajehng, tibre nsol nyi bo bele no gbale sehng, wahnge bo ma-m kpe jol edi ajehng. <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />Ntaange kehm gboko abaabebul ba Ebram, a ba Lod. Ngare nyio anebe Kenan, a anebe Peris tob jolo ndi nyio. <verse eid="GEN 13:7" /><verse number="8" style="v" sid="GEN 13:8" />Owo Ebram kehm bungu tong Lot re, &lt;&lt;Nong wahr kˈtaange, jol alokeltum ebahre kˈbel nfem, tibre wahr akunu nya. <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />Ndi sang nong-r a kpeea? Nong wahr yab elnahre. A lˈje go ejang ebobkal, me m bahke jeke ejang eboblum; a lˈfere yehke ejang eboblum, m bahke jeke ejang ebobkal.&gt;&gt; <verse eid="GEN 13:9" /><verse number="10" style="v" sid="GEN 13:10" />Lot kehm tabe esamahr seenge, nyehn re edamme Jodan jolo alahb alahb, ana etahngga ji Jehova, tob jolo ana ndi nyi Ijib feere go ejang Joa. (Jia tohko jol Jehova kehm rannge Sodom a Gomora) <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />Owo Lod kehm yehke edamme ji Jodan asongo go ero nfam. Aneblum abal baa kehm yabe elbo: <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />Ebram lene go ndi nyi Kenan, Lod song si nkpatahk enye kohlo Sodom, ellong ajahbe nyao nya jolo go edi ji jolo ebale ebale. <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />Ngare nyio anebe Sodom jolo abˈbi ane, ba jo lim abˈbi gbalee go esamahr bi Jehova. <verse eid="GEN 13:13" /><verse number="14" style="v" sid="GEN 13:14" />Eji Lod ma tahm fi, owo Jehova kehm bungu tong Ebram re, &lt;&lt;Tab esamahr eba edi ji a yim o, wo seenge go ejang ebobkal, a ejang eboblum, tob seenge ero nfam a erede nfam. <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />M bahk-a kake ndi nyia kpee nyi a kpˈnyehne, a etˈtohngo eja go njinanjini. <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />M bahke limi etˈtohngo eja nyab fere sahb rˈrur ana erikehndi. Lˈjol re nne bahke ma fange erikehndi, lohngo re bo bahke ma fange etˈtohngo eje. <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />Mehl wo jen alab, a akpang akpang nya ndi nyia, n kpˈyake na a ka-a.&gt;&gt; <verse eid="GEN 13:17" /><verse number="18" style="v" sid="GEN 13:18" />Owo Ebram kehm kpudu nkpatahk enye, song kak elsi kohlo agburu nti nya li ka Mamre nya li go Hebron owo á limi egudu njom ji Jehova.<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">Ebram tahre Lod</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />Ngare nyia Amrafel ji jolo ntul no Sinar, a Ariok ji jolo ntul no Elasa, Kedolaoma ji jolo ntul no Elam, go Tidal ji jolo ntul no Goyim, <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />bo je ebta a Bera ji jolo ntul no Sodom, a Birsa ji jolo ntul no Gomora, a Sinab ji jolo ntula Adma, Semeber ntul no Jeboyim, a ntul no Bela (Ji li Joar). <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />Etoono ellong atul baa ba kono go edamme ji Sidim, ji li aya elkang. <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />Go ewuba nnya ebal bo woomo elwo ni Kedolaoma, eji biingi ewuba nnya era bo yiimi etahnsi. <verse eid="GEN 14:4" /><verse number="5" style="v" sid="GEN 14:5" />Go ewuba nnya eni, Kedolaoma a atul ba kpa njahm a ne, kehm tahme ebta song nok ga anebe Refa go Asterot Karnadim, anebe Juja bo ji li go Ham, anebe Emm bo ji li go Saveh Kiriateim, <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />go anebe Hor ba jolo go ejahbe ewong ji Seir, tete song rehng go El Paran kohlo go elka emahng. <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />Bo kehm feere njahm tahm go En Mishpad, ji li Kadish, bo ga bo ko ndi nyio nyi anebe Amalek kpee, a anebe Amor ba lene go Hajajon Tamar. <verse eid="GEN 14:7" /><verse number="8" style="v" sid="GEN 14:8" />Owo ntul no Sodom, a ntula Gomora, a ntul no Adma, a ntula Jeboiim, go ntula Bela, ji li Joar, kehm mehle eljen asongo song yiimi nti nti re bo nok ebta go edamme ji Sidim <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />re bo nok ebta a Kedolaoma ji ntula Elam, a Tidal ntula Goyim, go Amrafel ntula Sinar, a Ariok ntula Elasar, bo atul ani je elnoko a atul alon. <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />Edamme ji Sidim abing jolo o tvv nya bo jo ramme yehke anyake elak, eji ntula Sodom, a no Gomora jo be, ane bandiki jo gbo yel abing nyao, bako be tahm go awong. <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />Atul ani bao kehm taare nsol anebe Sodom kpee, a nyi anebe Gomora, a nsol alehke ebo kpee, feere ebo kehnge <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />Bo tob bobo Lod ji nfuna Ebram tahm a ne, a nsol a nsol enye kpee, tibre á lene Sodom. <verse eid="GEN 14:12" /><verse number="13" style="v" sid="GEN 14:13" />Nne awohng no be go ebta, kehm ba tong Ebram ji nnea Hibru. Ebram lene kohlo agburu nti nya Mamre ji nne Amor, ye ji jolo mmonannyehn no Esikol, a Aner, bo kpee ji jolo njahm a Ebram. <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />Eji Ebram wuku re nfun ewe bo me-e bob fi a ne, owo á kehm kuku ane ebe ba á ma tib bo ebnere ebta, ane atahlku ane elku ane ara, bo kpee bo jele bo go nlaaga nyi Ebram, bo kehm tahme jo kam bo tete rehng go Dan. <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />Ngare atv Ebram kehm yabe ane ebe go nlong a nlong, re bo nok a ane ba bobo Lod, bo kehm kame anebekv yehke, toono bo tete rehng go Hobah, ejang ebobkal bi Damaskus <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />Ebram fere taare nsol kpee nyi bo da no a Lod ji nfun ewe, a nsol a nsol enye kpee, feere a ne kehnge, a anebkal, a ane bako fvfo.<verse eid="GEN 14:16" /></para>
  <para style="s">Melkijedek fuulu Ebram</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />Eji Ebram kehnge ebta bi á noko ga Kedolaoma a atul ba á kpa njahm a bo, owo ntula Sodom kehm bake re á ba wan-e go edamme ji Saveh ji li Edamme ji Ntul. <verse eid="GEN 14:17" /><verse number="18" style="v" sid="GEN 14:18" />Owo Melkijedek ntula Salem<note caller="+" style="f"><char style="fr" closed="false">14:18 </char><char style="ft">Salem mbing nyehko nyi Jeusalem nyi</char></note> kehm koko nsol alehke, a amahm ba a ma. Á jolo nlimajom no Esowo bi ga wahre, <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />á kehm fuulu Ebram kehm bungu re, &lt;&lt;Nong Esowo bi ga wahre, ye ji limi elbung a ndi, fuulu Ebram. <verse eid="GEN 14:19" /><verse number="20" style="v" sid="GEN 14:20" />Nong eltehke jol ka Esowo bi ga wahre, ye ji yake anebekv eba kak-a go ebo. Owo Ebram kehm kake Melkijedek ellong anehng go ellong nsol ewubu ewubu. <verse eid="GEN 14:20" /><verse number="21" style="v" sid="GEN 14:21" />Ntula Sodom kehm bungu tong Ebram re, &lt;&lt;Ka-m ane ebame, wo ko nsol nyi a da go ebta.&gt;&gt; <verse eid="GEN 14:21" /><verse number="22" style="v" sid="GEN 14:22" />Owo Ebram kehm bungu tong ntula Sodom re, &lt;&lt;N tabe ebo ebame ton go ero ko nwongo go mbinga Jehova, Esowo bi ga wahre, ye ji limi elbung abola ndi, <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />re me nehm tiki ko ejum ajehng ajehng, ji li jˈja, jol elv afi nlehke ekpaketa n nehm ko, eji a lˈkˈtiki ma bung re, &lt;Me wo limi re Ebram gbo afang.&gt; <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />N nehm ko ejumjum, sehngem jio ji ane ebame ma li, a mbake nyi li ka ane ba toon-m no, Aner, Eskol, go Mamre. Nong bo ko mbake nyi bo.<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">Egbanngalung ji Esowo limi a Ebram</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />Eji nsol nyia kpee ma mal, Jehova kehm bungu tong Ebram go elfoongo nlem, re, &lt;&lt;Ebram ka fahl, Me wo li ekum eba, eltuuru ena bahke sahb gbˈgbal. <verse eid="GEN 15:1" /><verse number="2" style="v" sid="GEN 15:2" />Ebram kehm faange re, &lt;&lt;O Jehova, Ntubesi ewame, jenji a bahk-m kake, ga na me mmon n kpimm? Nne no bahk-m elkv li Eliesa wo ji lohng go Damaskus!&gt;&gt; <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />Ebram kehm bungu re, &lt;&lt;Abon m-e a ka ka, nlokeltum no li egama nlaaga wo bahke jolo nlehkelkv ewame.&gt;&gt; <verse eid="GEN 15:3" /><verse number="4" style="v" sid="GEN 15:4" />Owo Jehova kehm kpe bung tong-e re, &lt;&lt;Nne noa sang bahke jolo nlehkelkv ewa, mmon no a bahke jele, wo bahke jolo nlehkelkv ewa.&gt;&gt; <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />Á kehm lohngo elatahk a Ebram, kehm-e tongo re, &lt;&lt;Tab esamahr eba, wo seenge go elbung. Fange alonlo, lˈjol re a bahke ma fange.&gt;&gt; Owo Jehova kehm tongo Ebram re, &lt;&lt;Ano wo abon eba bahke ruru. <verse eid="GEN 15:5" /><verse number="6" style="v" sid="GEN 15:6" />Ebram bumu Jehova go etingitingi, owo wahnge Esowo kehm-e koko ana etingitingi nne. <verse eid="GEN 15:6" /><verse number="7" style="v" sid="GEN 15:7" />Á kpe bung re, &lt;&lt;Me wo li Jehova, ji lung-a yehke go ejahbe jio ji Ur go ndi nyio nyi anebe Kaldia, re me m ba ka-a ndi nyia, fere jol nyi nya.&gt;&gt; <verse eid="GEN 15:7" /><verse number="8" style="v" sid="GEN 15:8" />Ebram kehm bungu re, &lt;&lt;O Jehova Ntubesi ewame, anv m bahke limi renan kehm kahne re ndi nyia bahke lohko jol nyˈnyame?&gt;&gt; <verse eid="GEN 15:8" /><verse number="9" style="v" sid="GEN 15:9" />Jehova kehm-e tongo re, &lt;&lt;Ko mmon a nfong ba, a mbul, go nkom, bo bahke jolo bo ji ma kang nnya era era, tob ko elbehl ba ani, a mmon etomtom.&gt;&gt; <verse eid="GEN 15:9" /><verse number="10" style="v" sid="GEN 15:10" />Ebram kehm koko nsol nyia kpee ba ka-e. Á jo ba enyam bio, yang go ejang ebbal. Ano wo Ebram rodo ajang enyam nyao bum go edi ebbal, jol wane atem, sehngem re, nruk nyi á ki yang bo. <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />Nruk nyi kpo li atem enyam jo seb re bo ba li enyam bio, wo Ebram jo kame na bo. <verse eid="GEN 15:11" /><verse number="12" style="v" sid="GEN 15:12" />Eji njul yahke lahm a, Ebram kehm gboko ellu, lal kpˈkpoodo kpˈkpoodo, emennge ejannge jia kehm tahle na tahl ba bul-e. <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />Owo Jehova kehm bungu tong-e re, &lt;&lt;Loko kahn re etˈtohngo eja bahke jolo ajenne go njen ejahbe. Bo bahke rodo bo bum aju, fere jo nohk bo go nnya atahltahl. <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />M bahke kake ejahbe jio ji bo bahke jo loko bo erem, owo bo bahke lohngo ejahbe jio tahm, a agburu afang. <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />Wo bahke sahb kˈkul, kehm kpoko soom, bo kpa-a kak, a song kpiri babnso. <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />Go eying ebni, etˈtohngo eja bahke feere ba a. Tibre abiafem nya anebe Amor ka rur ebtuku. <verse eid="GEN 15:16" /><verse number="17" style="v" sid="GEN 15:17" />Eji njul ma lahm, ejannge fere gbo Ebram kehm nyehne nkpangenyo nyi atˈtohk jo lohng, a enyaale ji jo lul, ma lohng ba sehng go elka elka ni enyam bio bi á bumu go edi ebbal. <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />Efung bio Jehova limi egbanngalung a Ebram re, &lt;&lt;Etˈtohngo eja ji m ma ka bo edi ndi jia, bomo go aya ma Ijib, tete rehng go agburu aya ma Yufrati. <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />Ndi nyio nyi anebe Ken, a nyi anebe Keniji, a anebe Kadmon, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />a anebe Hid, anebe Periji, a anebe Refa, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />a anebe Amor, a anebe Kenan, a anebe Girgasi, go anebe Jebusi.<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">Hagar abola Ismeel</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />Ngare nyia Sarayi nkala Ebram ka jel mmon awohng awohng ka-e. Á bele mmon no nkal no lohng go Ijib no jo lok-e, bo jo lung-e re Hagar. <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />Sarayi kehm tongo Ebram re, &lt;&lt;Jehova eblim re me n kˈjel abon. Song noongo a Hagar nloketum ewame, fundiki bahke limi o re me n bom nnahba njel go ege.</para>
  <para style="p" vid="GEN 16:2">Ebram tˈtaame tv ji Sarayi bungu no. <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />Ngare nyi Ebram ma kang nnya ewubu go Kenan, Sarayi nkal ewe kehm rodo mmona Ijib no nkal no jo lok-e, no bo jo lung-e re Hagar ka nlum we, re á jol nkal ewe. <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />Á kehm noongo a Hagar, á soro sa ela.</para>
  <para style="p" vid="GEN 16:4">Eji Hagar sebe kahn re yebsa ela, nnyehn no á jo lok-e we joom kpe lub. <verse eid="GEN 16:4" /><verse number="5" style="v" sid="GEN 16:5" />Owo Sarayi kehm tongo Ebram re, &lt;&lt;Wo wo elfeeme nia li a na go ebi ji n kpˈnyehne erem a. N yake nloketum ewame kak-a go elwo, anv eji á ma kahn re yebsa ela, á me-e nehme kpe kpunu, nong Jehova lam-r awahra na.<verse eid="GEN 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6" />Ebram kehm-e tongo re, nlokeltum ewa tiki wob go ega abo, lim-e ana a tiri no. Sarayi kehm-e bibi elfili, á soro be eje tahm.<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />Enjel nyi Jehova kehm nyehne Hagar jehk kohlo elbing alahb ni jolo go elka emahng, elbing alahb nio jolo kohlo mbang nyi li rehng go Sur. <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />Enjel kehm bungu re, &lt;&lt;Hagar nlokeltum no Sarayi, gan wo a lohng no kpˈbake, anv, gan wo a fi no? Hagar kehm-e faange re, &lt;&lt;N kpˈbeke goji Sarayi, nnee ejame no n kp-e loko.&gt;&gt;<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />Enjel nyi Jehova kehm-e tongo re, &lt;&lt;Feere song goji nnee no a kp-e loko wo song woom-e go elwo. <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />Enjel kehm kpe bung re, &lt;&lt;M bahke nyange etˈtohngo eja, bo bahke gbale sehng, jol a nehm ma fange.&gt;&gt;<verse eid="GEN 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 16:11" />Enjel nyi Jehova kpe-e tong re: &lt;&lt;Anv, a li ela, a bahke jele mmon no nlum, a bahk-e gungu mbing re Ismeel<note caller="+" style="f"><char style="fr" closed="false">16:11 </char><char style="ft">Ismeel lohngo re Esowo ebwuk</char></note>, tibre Esowo ebwuk erem eba. <verse eid="GEN 16:11" /><verse number="12" style="v" sid="GEN 16:12" />Á bahke jolo njoba nne no li ana mbvankang nyi ekulegbe, abo enye bahke kuumu nne awohng awohng, ebo bi nne awohng awohng bahke tob kuum-e, á bahke jolo ebib bib elkpin a abonanyehn kpee.<verse eid="GEN 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />Hagar kpiiki Jehova ji bungu a ne mbing re: &lt;&lt;Wo wo li Esowo bi kp-m nyehne,&gt;&gt; tibre á bungu re, &lt;&lt;Anv, me n nyehn nne no kp-m nyehne.&gt;&gt; <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />Owo wahnge bo jo lungu elbing alahb nio re, Beer Lahayi Royi.<note caller="+" style="f"><char style="fr" closed="false">16:14 </char><char style="ft">Beer Lahayi Royi lohngo re elbing alahb ni nne noo no li go elkpin no kp-m nyehne</char></note> Nia kpeka li go elka elka ni Kedesh abola Bered.<verse eid="GEN 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15" />Owo Hagar kehm jele mmon no nlum ka Ebram, Ebram kehm-e gungu mbing re Ismeel. <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />Ebram kange nnya atahl ani, a nnya erakera eji Hagar jele Ismeel ka-e.<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">Egbanngalung ji nrur a yehke</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />Ngare nyi Ebram ma kang nnya atahl ani a nnya elku, a nnya eni, Jehova kehm ba kpir-e, fere tong-e re, &lt;&lt;Me wo li Esowo Bi Kpi Nsahm Kpee; jo toono abang enyame ka lim ebi ajehng ajehng. <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />M bahke tibi re egbanngalung ejame a na ebyiimi, fere sahb lˈlim eji a lˈgbal go nrur.&gt;&gt;<verse eid="GEN 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 17:3" />Ebram kehm gboko kohk esamahr go ndi, Esowo kehm-e tongo re, <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />&lt;&lt;Egame, egbanngalung ejame ji a, a na: A bahke jolo nde no ajahbe gbalee. <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />Bo wa-a nehm kpe lung re Ebram,<note caller="+" style="f"><char style="fr" closed="false">17:5 </char><char style="ft">Ebram lohngo re Nde no bo me mehl wahre</char></note> mbing enya bo bahke fere jo lung-a re Ebraham,<note caller="+" style="f"><char style="fr" closed="false">17:5 </char><char style="ft">Ebraham lohngo re nde no ane gbalee</char></note> tibre m ma-a lim nde no ajahbe gbalee. <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />M bahk-a limi a sahb rˈrur, ajahbe gbalee bahke lohngo go ega, atul bahke tob lohng go ega fvfo. <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />Egbanngalung ji m ma lim a na bahke jolo nkahlkahl, bahke jolo ka me a na, a etˈtohngo eja, a aying nya kpˈbake. A wo li egbanngalung, m bahke jolo Esowo ba, a Esowo bi etˈtohngo eja ji kpˈbake. <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />Ndi nyia kpee nyi Kenan, nyi lela a li njenne, m bahk-a kake jol erohko ndi jˈja nkahlkahl, a etˈtohngo eja ji kpˈbake, m bahke jolo Esowo ebahne.&gt;&gt;<verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />Owo Esowo kehm bungu tong Ebraham re, &lt;&lt;Wofono, tiki li re, wo bum egbanngalung ejame, wo a etˈtohngo eja, ji kpˈbake, aying nya kpˈbake. <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />A wo li egbanngalung ejame ji m ma lim a na, a etˈtohngo eja ji kpˈbake, ji li re wo tiki bum: Nnenlum awohng awohng go egahne ellong bahke yehke nrur. <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />Wofono antahng yehke elna nrur, eji lˈjol elliingi ni egbanngalung ji me ma lim a na. <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />Go aying nya kpˈbake, bo bahke jo yehke mmon awohng awohng no nlum go egahne ellong nrur, eji mmon noo ma kang nfung enehkeni, nrur nyia bahke jolo ka abon ba bo bahke jele bo ega etahk, jol afi bo gunu na bo go akpohko go njahm ejahbe, jol afi go ega etˈtohngo bo lohngem. <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />Jol afi bo jele bo go ega etahk, afi a gunu na bo go ega akpohko, bo bahke tiki yehke nrur. Egbanngalung ejame go ega ngubjing bahke jolo nkahlkahl. <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />Nnenlum awohng awohng no tohko yehke nrur, bo bahke yehke go ellong ane ebe; tibre yeb rannge egbannalung ejame.&gt;&gt;<verse eid="GEN 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />Esowo kehm kpe tong Ebraham re, &lt;&lt;Ana Sarayi nkal ewa, ke-e kpe jo lung re Sarayi, fere jo lung-e re Sara.<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="ft">Sara lohngo re mmona ntul no nkal</char></note> <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />M bahk-e fuulu, m bahke limi á tiki jel mmon no nlum ka-a, m bahk-e fuulu eji á lˈjol nnyehn no ajahbe tvv, atul ba ajahbe gbalee bahke lohngo go ege.<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />Ebraham kehm gboko kohk esamahr go ndi; kehm wolo fere tong elne re, &lt;&lt;Nnenlum no ma kang nnya atahl alon bahk kpe jol nde mmona? Anv, Sara ji ma kang nnya atahl ani, a nnya ewubu bahke ma jel mmona?&gt;&gt; <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />Ebraham kehm bungu tong Esowo re, &lt;&lt;Lˈlub jol re Ismeel bahke tob woomo go elwo ni elfuulu ena!&gt;&gt;<verse eid="GEN 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19" />Esowo kehm bungu re, &lt;&lt;Ee, li ano, wo Sara nkal ewa bahke jele mmon no nlum ka-a, a bahke jo lung-e re Aisik, m bahke limi egbanngalung ejame a ne, ji bahke jolo nkahlkahl, a etˈtohngo ji kpˈbake. <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />Go eyaame ji Ismeel, m ma-a wuk; m bahk-e tiki fuulu, m bahk-e limi á jol njˈjel, njel enye bahke ruru. Á bahke jolo nde nne no ewubu ane abal ba bahke jo fili adi, m bahke fere ko-e lim á jol egburu ejahbe. <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />Go eji Aisik wo m bahke limi Egbanngalung ejame, ye ji Sara bahk-e jele ka-a yabv anana.&gt;&gt; <verse eid="GEN 17:21" /><verse number="22" style="v" sid="GEN 17:22" />Ana Esowo bungu a Ebraham mal, á kehm-e tahme sa.<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />Efung bˈnehm o, Ebraham kehm rodo Ismeel mmon ewe, a abon ba nlum ba bo jele no go ege etahk, afi ba á gunu no go ege akpohko, bo aneblum kpee ba jolo go ege etahk, á song yehke bo nrur, ana Esowo tong-e no. <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />Ebraham jolo nnya atahl ani a nnya elku a nnya eni ngare nyi á yehke nrur, <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />Ismeel mmon ewe jolo ewubu a nnya era; <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />Ebraham, a Ismeel mmon ewe bo yehke nrur efung bˈnehm. <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />Nnenlum awohng awohng go nlaaga nyi Ebraham, afi bo jele bo o, afi bo gunu na bo go njahm ejahbe, bo kpee yehke nrur a Ebraham.<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">Njenne na era</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />Jehova kehm ba kpiri Ebraham kohlo go agburu arahn nti nya li ka Mamre, ngare nyi á jehk go mbutahk mi ebkpatahk ebe, ngare nyi njul ma fub. <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />Ebraham kehm tabe esamahr seenge nyehn ane ara yim kohl-e kpidi kpidi. Eji á nyehne bo, á kehm foomo mehl go mbutahk, re á song kpiri bo, kehm song gong go ndi.<verse eid="GEN 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 18:3" />Á kehm bungu re, &lt;&lt;Ntubesi ewame, lˈjol re ḿ ma-m nyehn ndon, kana sehng nlokeltum ewahne sa. <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />Nong bo ko abon alahb ba ka-n wahn ru akpade, fere re ekv go enˈnang ji eti jia. <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />Nong me n seb mmojum alehke ka-n wahn li bob ala, bel eko, kehm sehnge song, eji li re wahn ebba goji nlokeltum ewahne.&gt;&gt; Bo kehm faange re,</para>
  <para style="p" vid="GEN 18:5">&lt;&lt;Ebnob sehng, lim ana a ma bung.&gt;&gt;<verse eid="GEN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6" />Owo Ebraham kehm foomo yel ebkpatahk, goji Sara, kehm-e tongo re, foomo elwaare wo nyahk ngbugu abe era, nya kpˈnobo, bonngo lim abred.<verse eid="GEN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 18:7" />Á kehm beke rehng ege ega, song yehke mmona nfong no nno a nno, ba ka nlokeltum ewe, no foomo song wul-e, fere lam. <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />Á kehm koko nnyama nfong nyi bo lame no, á koo alahbbel nfong ma kpˈkpehde, a alahbbel ma li wiri wiri ba ka bo. Eji bo jo li, yefono yiimi kohlo bo o nnahb eti.<verse eid="GEN 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9" />Bo kehm-e bahbe re, &lt;&lt;Sara nkal ewa nona?&gt;&gt; Á faange bo re, &lt;&lt;Sara wob go ebkpatahk.&gt;&gt;<verse eid="GEN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10" />Jehova kehm bungu re, &lt;&lt;M bahke tiki kpe feere ba go ega yabv ngare anana, Sara nkal ewa bahke jele mmon no nlum.&gt;&gt;</para>
  <para style="p" vid="GEN 18:10">Ngare nyio Sara jol-e go njahm jo wuungu atung, á ji go mbutahk ebkpatahk.&gt;&gt; <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />Ngare nyia Ebraham abola Sara, bobsahb kˈkul, nyˈnyehnge. Sara ebkul sehng ana fuumu re á kpe jel mmon. <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />Owo Sara kehm wolo atahng atahng eji á jo tir bade re, &lt;&lt;Anv eji m ma faade mal, nlum ewame go ebtob kul, m bahke ma kpe wuk elyebe nioa?&gt;&gt;<verse eid="GEN 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13" />Owo Jehova kehm tongo Ebraham re, &lt;&lt;Jenji wahnge Sara ma wol fere bung re, &lt;M bahke lohko jel mmon anv eji m ma kula?&gt; <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />Anv ejum jia ji kpo riidi goji Jehovaa? M bahke feere ba go ega yabv, ana m ma kunu afung, Sara bahke jele mmon no nlum.&gt;&gt;<verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />Sara jo fˈfahl, á kehm gbaame re, &lt;&lt;N wolem.&gt;&gt; Jehova kehm-e tongo re, &lt;&lt;Ee, á wˈwol.&gt;&gt;<verse eid="GEN 18:15" /></para>
  <para style="s">Ana Ebraham gboongo ka Sodom</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />Eji bo ma mehl re bo yahke tahm, bo seenge go edamme ji Sodom. Ebraham kehm tob tahm jo jen a bo re á song tv bo. <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />Owo Jehova kehm bungu re, &lt;&lt;Anv nˈnob re me n behr Ebraham ejum ji n yahke lima? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />Ebraham jia bahke gbalao, fere jol egburu ejahbe, ji kpi eko, ajahbe njini kpee bahke bele elfuulu sehng go ege. <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />Tibre m me-e yehke re á tib abon ebe, a nlaaga enye, re bo toono mbang nyi Jehova, jo lim ji kpˈnobo, a ji li go nseenga nseenge. Eji Jehova lˈlim ana á nyame no tong-e.<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20" />Owo Jehova kehm bungu tong Ebraham re, &lt;&lt;Aling nya li bade Sodom a Gomora ebgbal sehng, abiafem ebo ebmaange sehng, <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />owo wahnge n fi o re me n song nyehn ji bo ma lim lˈjol re ebsab ana aling nya ma-m rehng ga. Tohko jol ano m bahke kahne.&gt;&gt;<verse eid="GEN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />Aneblum bao sennge tahm asongo go Sodom, wo Ebraham sa yiimi o esamahr Jehova. <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />Ebraham kehm jeere kohl-e kehm bungu re: &lt;&lt;A bahke feenge atingi ane semme a abi ane wohng goa? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />Anv lˈfere jol re, atingi ane atahl abal ane awubu baa o ejahbe jio mee? A bahke tiki kpe rannge, a nehm yake edi jio bum, tib esi atingi ane atahl abal ane awubu ba li oa? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />Ndan gbaaa re, wo lim elkohn ejum ana jia, wul atingi ane semme abi ane, re wo kak atingi ane, a abi ane erem jang jang. Ndan gbaaa! Anv, Nlˈlame no njini nyia kpee nehm ma lim ejum ji nnoa?&gt;&gt;<verse eid="GEN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26" />Jehova kehm bungu re, &lt;&lt;N lˈfere nyehn atingi ane atahl abal ane awubu, ejahbe jio ji Sodom, m bahke yake edi jio kpee bum tib esi atingi ane bao.&gt;&gt;<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />Ebraham kehm kpe bung re: &lt;&lt;Anv eji m ma bel esahb bung a Ntubesi ewame, jol ejumjum me n lohngem, n li ana ebtohko, a atong. <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />Lˈjol re ane alon eblohng go atingi ane atahl abal ane awubu, a bahke tiki rannge ejahbe jio kpee tib ane alon ba ma lohng go nfange nyioa? Jehova kehm bungu re,</para>
  <para style="p" vid="GEN 18:28">&lt;&lt;N lˈnyehn atingi ane atahl abal ane alon o, n nehm tiki rannge ejahbe jio.&gt;&gt;<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />Ebraham kehm kpe bung tong-e re, &lt;&lt;Anv, a lˈlub nyehn atingi ane atahl abal o mee?</para>
  <para style="p" vid="GEN 18:29">Jehova kehm-e tongo re, &lt;&lt;Tib esi atingi ane atahl abal bao, n nehm lim ano.&gt;&gt;<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />Ebraham kehm bungu re, &lt;&lt;Ntubesi ewame eltim ki-a rak, nong me m bung, lˈjol eltahl atingi ane awubu ba ba mee?&gt;&gt;</para>
  <para style="p" vid="GEN 18:30">Jehova kehm faange re, n lˈ nyehn eltahl atingi ane awubu o, n nehm lim ano. <verse eid="GEN 18:30" /><verse number="31" style="v" sid="GEN 18:31" />Ebraham kehm bungu re, &lt;&lt;Anv eji m ma bel esahb re me n bung a Ntubesi, anv atingi ane eltahl ba ba lˈjol o mee?&gt;&gt; Jehova kehm faange re, &lt;&lt;Tib esi atingi ane eltahl, n nehm rannge ejahbe jio.&gt;&gt;<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />Ebraham kehm bungu re, &lt;&lt;Ntubesi ewame, eltim ki-a rak, nong me n gohro bung nkpel nkpel anyehng nyia. A lˈfere nyehn atingi ane awubu ba ba o mee?&gt;&gt;</para>
  <para style="p" vid="GEN 18:32">Jehova kehm faange re, &lt;&lt;Tib esi atingi ane awubu, n kehm rannge ejahbe jio.&gt;&gt;<verse eid="GEN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 18:33" />Ana Jehova ma bung a Ebraham mal, á kehm tahme eje. Ebraham kehm feere kehnge go etahk.<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">Elrannge ni Esowo rannge Sodom a Gomora</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />Enjel ebal nyio rehnge go Sodom ngare elgung, Lod jii go eti mbu ji ejahbe jio. Á nyehne bo kan a me, á kehm mehle tahm re á song kpiri bo, fere gbo kohk esamahr ebe go ndi. <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />Á kehm bungu re, &lt;&lt;Atubesi ebame, ba tahm-n go etahk nlokeltum ewahne. M Bahke ma ru akpade, fere kang o. Behna efungfu behre behre wahn lohng song mbang enyahne.&gt;&gt;</para>
  <para style="p" vid="GEN 19:2">Bo kehm-e faange re, &lt;&lt;Eˈee, e bahke kange go elatahkgur.&gt;&gt;<verse eid="GEN 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3" />Á fanne bo tˈtahne, bo kehm tahme toon-e song yel ege etahk. Á lame nsol ka bo, fere lim abred nya ki kpi ayist, bo li. <verse eid="GEN 19:3" /><verse number="4" style="v" sid="GEN 19:4" />Re bo kehm tahme song noongo, aneblum go nkpohka Sodom anyehng anyehng kpee, anebkul, a ajangkun ajangkun lohngo ba sennge etahk jio kak. <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />Bo kehm lungu Lod bahb-e re, &lt;&lt;Ane ba ba go ega atv maa, bo bana? Yehke bo ba ka-r, wahr noongo a bo.&gt;&gt;<verse eid="GEN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6" />Lod kehm lohngo elatahk, bam mbu song kpiri bo, <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />kehm bungu re, &lt;&lt;Eˈee ate ebame, kana lim elkohn ebi ejum ana jia. <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />Nyehnen ga, n kpi abon ba nkal na abal, ba aneblum kala nˈnoongo a bo, nong me n ko bo ba ka-n, wahn lim bo ji kp-n koro. Kana lim ane baa ejumjum, tibre ane baa ebba, ajenne enyame nya, bo wob go egame ebo.<verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />Bo kehm faange re, &lt;&lt;Ka-r eyake go mbang,&gt;&gt; Fere tob bung re, &lt;&lt;Nne noa ba a ana njenne, anv á yahke fere jol nlamalam! E bahk-a limi ji kpˈsabe, sehnge ji e bahke limi bo.&gt;&gt; Bo soro na asi kpe jo temme Lod, fere jo gbul asongo re bo song wa mbutahk.<verse eid="GEN 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 19:10" />Aneblum bao sa go atahng ekpˈkpa tanne abo tohng Lod feere kak ekpˈkpa, bam mbu. <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />Bo wa ane ba yiimi go mbutahk amahr, anebkul, a ajankun, ajankun, mbutahk bo kpeem jo nyehn.<verse eid="GEN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />Ane abal bao kehm tongo Lod re, &lt;&lt;A kpˈkpi nne awohng awohng a, ana abon ba li anar eba, abon ba nlum, a ba nkal, afi nne awohng awohng a ejahbe jia no li ka woa? Yehke bo a kpee, <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />tibre e bahke rannge edi jia, tib aling nya ma lohng song kpiri Jehova bade ane ba li ejahbe jia ebgbal sehng, owo wahnge Jehova ma-r tum re wahr ba rannge edi jia.&gt;&gt;<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />Owo Lod kehm tahme song tong abon anar ebe ba lame re bo bahke koko abon ebe ba nkal go elbal. Á song tongo bo re, &lt;&lt;Foomen wahn lohng edi jia, tibre Jehova yahke rannge ejahbe jia.&gt;&gt; Wo abon anar ebe jo tiri re, á jo limi ayok.<verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />Ana efungfu kpi nseke nseke, enjel nyao kehm kehme Lot sohko, fere tong-e re, &lt;&lt;Foomo wo rod nkal ewa, a abon ebal eba ba nkal, ba li a, tohko jol ano, bo bahk-a tob rannge budu, ejahbe jia lˈkehme elrannge.<verse eid="GEN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 19:16" />Eji Lod jo laange, aneblum bao kehm-e jabbe go ebo, fere tob jabbe nkal, a abon abon ebe, enangebeem yehke go ejahbe jio, tibre bo fili Jehova ndon. <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />Ana bo lohngo a bo, njenne anyehng kehm tongo bo re, &lt;&lt;Been, wahn tahre elkpin enahne! Kana keebe go njahm, jol kana yiimi edi ji li balebale! Been, song go awong; tohko jol ano bo bahk-n rannge kpee!&gt;&gt;<verse eid="GEN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18" />Lod kehm faange bo re, &lt;&lt;Eˈee ntubesi titi wahn! <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />Nlokeltum ewahne ma-n fili ndon, m ma-m tib nnoobo eljini, eji ḿ ma tahre elkpin ename. N nehm ma be rehng awong nyao; elrannge nia bahk-m kpiri, m bahke kpoko. <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />Nyehnen ejahbe ga ji li kpidi kpidi, ji m bahke ma be song rehng, mojahbe no nse wo. Nong me m be song o, mojahbe kpˈseke, ano sanga? Eji n lˈtahre elkpin ename.<verse eid="GEN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21" />Enjel kehm bungu tong Lod re, &lt;&lt;Ebnob sehng, m bahke kpe lim, n nehm tob rannge ejahbe ji a ma bung bade. <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />Fvfo be song elwaare, n nehm lim ejumjum tete a song rehng o.&gt;&gt; Owo wahng ejahbe jio bo jo lung re Joar.<note caller="+" style="f"><char style="fr" closed="false">19:22 </char><char style="ft">Joar lohngo re, ejahbe ji nse</char></note><verse eid="GEN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />Ngare nyi Lod rehnge go Joar, njul eblohng. <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />Jehova kehm nake agun asulfor go elbung wohngo Sodom, a Gomora. <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />Ano wo Esowo rannge ajahbe nyao, a adi nyao kpee nya li go ebal, budu ane ba lene ajahbe nyao, a nsol kpee nyi kpo mahng go ndi. <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />Wo nkala Lod keebe njahm, wahnge á siingi ego akang.<verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />Efungfu behrebehre, etoono efung Ebraham kehm mehle feere go edi ji nyaane á yiimi no a Jehova. <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />Á kehm seenge ejang bio bi Sodom a Gomora, á tob seenge go ndi nyio nyi li balebale kpee, á kehm nyehne anyaake atˈtohk kpˈlohngo go ndi ana atˈtohk erehmengun.<verse eid="GEN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 19:29" />Eji Esowo rannge ajahbe nyao go ndi nyi jolo balebale, á bˈbuumu Ebraham, song yehke Lod go elrannge ni gbo tub edi ji á jolo no.<verse eid="GEN 19:29" /></para>
  <para style="s">Lot a abon ebe ba nkal</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />Lod, a abon abal ebe ba nkal, mehle go Joar, fere song lene go awong, tibre á jo fˈfahl ellene go Joar. Ye a abon abal ebe ba nkal lene go egohng atal. <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />Efung abehng ngbokambang a mmon no nkal kehm tongo etoono re, &lt;&lt;Nsoo ejahre ebkul, nnenlum awohng awohng a limm no bahke noongo a nahre, ana eljini nio li go njini kpee. <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />Nong wahr ka nsoo ejahre á wo amahm, eji e lˈnoongo a ne, eji elˈlim ebangenahb ejahre kˈtan, sehng goji nso ejahre.<verse eid="GEN 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 19:33" />Atv mao bo kehm limi nde bo wo amahm, ngbokambanga mmon song noongo a nde, nde kahnem ngare nyi mmon song noongo a ne, a ngare nyi mmon mehle no.<verse eid="GEN 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34" />Etoono efung behko, ngbokambanga mmon kehm tongo etoono re, &lt;&lt;Atv ma nyaane n noongo a nsoo, nong wahr kp-e ka atv maa, á kpe wo amahm, wo tob song noongo a ne, eji elˈlim ebangenahb ejahre kˈtan, sehng goji nso ejahre.&gt;&gt; <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />Owo bo kehm kpe ka nde amahm atv mao. Etoono mmon noko tob song noongo a ne. Á kpeem tob kahn ngare nyi mmon noongo a ne, a ngare nyi á mehle no.<verse eid="GEN 19:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 19:36" />Owo abon abal abal ba Lod kehm sake ela tib eji nde noongo a ebo. <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />Ngbokambanga mmon jele mmon no nlum, fere gung-e mbing re, Moab.<note caller="+" style="f"><char style="fr" closed="false">19:37 </char><char style="ft">Moab lohngo re, lohng goji nde</char></note> Ye wo li nde no anebe Moab ba li lela; <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />Etoono mmon tob jele mmon no nlum, gung-e mbing re, Ben-Ami.<note caller="+" style="f"><char style="fr" closed="false">19:38 </char><char style="ft">Ben-Ami lohngo re, mmon no ane ebame</char></note> Ye wo li nde no anebe Amon ba li lela.<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">Ebraham abola Abimelek</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />Ebraham kehm tahme o edi jio song rehng go ekidi edi ji Negeb song lene go elka elka ni Kadesh abola Sur. Á tohko jol mmongare ntiil go Gerar, <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />eji Ebraham jolo o wo á bungu re Sara nkal ewe, &lt;&lt;Mmonanyehn wo.&gt;&gt; Owo Abimelek, ntula Gerar kehm tumu re bo song ko Sara ba, á ko-e ana nkal ewe.<verse eid="GEN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 20:3" />Esowo kehm bake goji Abimelek atv amehng go nlem, kehm ba tong-e re, &lt;&lt;Á li jang jang ana ekpakv nne, eji á song rod nnenkal noo; tibre nnenkal noo ebbal nlum.&gt;&gt;<verse eid="GEN 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4" />Ngare nyia Abimelek ka lak nnenkal noo abo, owo á kehm bungu re, &lt;&lt;O ntubesi a bahke rannge ejahbe ji ki kak afema? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />Anv Ebraham me-e tong-m re, &lt;Sara mmonannee no nkal woa? Sara tobem bung a re, &lt;Ebraham mmonannee no nlum woa?&gt; Ji n limi a, ntir enyame li saang, fvfo abo enyame li saang.&gt;&gt;<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />Owo Esowo kehm-e tongo go nlem re, &lt;&lt;Etingitingi ji, n kpˈkahne re a limi jia a ntir enya saang. Owo wahnge n ki taame re wo lim ebi tob-m. Jˈnehm ji wahnge n ki taame re wo koor-e abo. <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />Anv, feera nkala nnenlum noo song ka-e, tibre nnenlum noo nnyehnamahr Esowo wo, á bahke kake ero ka-a, a bahke kpini. Á tohko feere a ne, kahn na kahn re wo a ane eba kpee, ḿ bahke kpoko.&gt;&gt;<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />Njahm fungfu, efungfu behrebehre, Abimelek kehm lungu atubesi anebeltum ebe, eji á ma tong bo kpee ji ma jol, bo ane kpee bele elfahle sehng. <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />Owo Abimelek kehm tumu re lung Ebraham, fere tong-e re, &lt;&lt;Jenji wahnge á ma-r lim ana. Ebi ajii m ma-a lim, ji wahnge á ma ko egburu ebi ana jia ba kun-m, a eti etul ejame. A ma-m lim nsol nyi ki fuumu re wo lim.&gt;&gt; <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />Abimelek kehm bahbe Ebraham re, &lt;&lt;Jenji wahng ka a limi ejum ana jia?&gt;&gt;<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />Ebraham kehm faange re, &lt;&lt;N bungu tong elname re, &lt;Etingitingi elfahle ni Esowo edi jia limm, bo bahk-m wulu tib esi nkal ewame.&gt; <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />Nne lˈ bum jio go nkpe, á lohko li mmonanee no nkal, e lohng nde awohng, sehngem re eblohngo ni e ki lohng nnyehn awohng. <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />Eji Esowo sebe re me n lohng nlaaga nsoo sa, n tong-e re, &lt;Ana wo a bahk-m tibi elkoro ena: Edi ajehng ajehng ji e lˈjee, jo tong ane re, me mmonanee no nlum wo.&gt;&gt;&gt;<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />Owo Abimelek kehm koko ejoro, a efong, go aju aneblum, a anebkal ba ka Ebraham, fere feera Sara nkal ewe ba ka-e. <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />Abimelek kehm bungu re, &lt;&lt;Nyehn ndi enyame ga nong no, edi ajehng ajehng ji lˈkor-a song lene.&gt;&gt;<verse eid="GEN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 20:16" />Á bungu tong Sara re, &lt;&lt;N kpˈkake mmonanne no nlum asilva akpohko, atahltahl nkpel ebal atahl awubu, nyaa li re wo ko bulu nsoodo nyi li bada na, go esamahr ane eba kpee, ba li a na; re wo ebˈbi ajehng ajehng a ka lim.&gt;&gt;<verse eid="GEN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 20:17" />Ebraham kehm kake ero bahb Esowo, á lim Abimelek á nob, a nkal ewe, a aju abon ba nkal, re bo kpe jo jel abon, <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />tibre Jehova bˈbulu ejˈjele ajehng ajehng ji nnenkal awohng awohng no li go nlaaga Abimelek, tib esi Sara nkala Ebraham.<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">Ana bo jele Aisik</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />Jehova tibi Sara egburu ndon ana á bungu no, á limi ka Sara ana á nyame no. <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />Sara kehm sake ela jel mmon no nlum ka Ebraham, go ngare nyˈnehm nyi Esowo nyame no tong-e, ngare nyio Ebraham ebkul. <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />Ebraham gungu mmon no Sara jele no ka-e mbing re Aisik. <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />Eji Aisik mmon ewe ma kang nfung enehkeni, Ebraham kehm-e yehke nrur ana Esowo tong-e no. <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />Ebraham kange nnya atahl alon ngare nyi Sara jele Aisik mmon ewe ka-e.<verse eid="GEN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 21:6" />Sara kehm bungu re, &lt;&lt;Esowo ma-m kak asol go nnyo, nne awohng awohng no lˈwuk bade ejum jia á bahke tob tob-m elwolo.&gt;&gt; <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />Á kpe bung re, &lt;&lt;Nne awoo jol tongo Ebraham re, Sara bahke yabe abon? Wo ga, me n jel mmon ka-e eji á ma kul.&gt;&gt;<verse eid="GEN 21:7" /></para>
  <para style="s">Ana Ebraham kame Hagar a Ismeel</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8" />Aisik mmon ewe kehm gbale fere kimi abel. Efung bˈnehm bi mmon kimi abel, Ebraham limi egburu elkak. <verse eid="GEN 21:8" /><verse number="9" style="v" sid="GEN 21:9" />Ismeel mmon no Hagar nnea Ijib jele no ka Ebraham, jo nyoko Aisik,<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false">Tohko jol ano Ismeel jo limi mbene</char></note> Sara kehm nyehne, <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />owo Sara kehm tongo Ebraham re, &lt;&lt;Kam nju a nnenkal noa a mmon ewe, tibre mmon a nju a nnenkal noa, nehm tiki jol nlehkelkv semme a Aisik mmon ewame.<verse eid="GEN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 21:11" />Ejum jia gbiingi Ebraham sehng tib esi mmon ewe Ismeel. <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />Owo Esowo kehm tongo Ebraham re, &lt;&lt;Ka taame ejum jia bada mmon noa, a njua nlokeltum ewa gbiing-a, wuungu Sara nkal ewa atung go ejum ajehng ajehng ji á kpa-a tongo, tibre go abon ba Aisik wo etˈtohngo eja bahke lohngo. <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />M bahke koko mmona njua nnenkal noo lim ejahbe, tibre ye fvfo mmon ewa wo.&gt;&gt;<verse eid="GEN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14" />Toono efung, efungfu behrebehre, Ebraham kehm rodo nsol alehke, a ekpˈkpuk alahb ji bo ko ngunyam lim song ka Hagar. Á kehm rodo nsol nyio kunu Hagar go akpakebahk, kehm-e tumu a mmon re bo song. Á kehm mehle eje tahm song kehme eldaale go elka emahng ni Beerseba.<verse eid="GEN 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 21:15" />Eji alahb ma mal go ekpˈpuk, á kehm rodo mmon noo song bum go mmonnahb eti. <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />Á kehm tahme song ji eje kpidikpidi, tahm edi ji á ji no rehng edi ji mmon jolo no, li ana nne bahke ma ro eltal rehng, á bungu re, &lt;&lt;N nehm ma ji o nyehn ana mmon noa bahke kpoko.&gt;&gt; Ana á song ji kohlo o, á jo lingi wulu wulu wulu.<verse eid="GEN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17" />Esowo kehm wuku mmon noo kpˈlingi, enjel nyi Esowo kehm sake go ero lung Hagar, kehm bungu tong-e re, &lt;&lt;Hagar nfem anyii? Ka kpe fahl; Esowo ebwuk eling mmon noo, edi ji á nong o. <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />Song mehl mmon noo yiimi, wo jabbe go ebo, tibre m bahk-e koko lim egburu ejahbe.&gt;&gt;<verse eid="GEN 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 21:19" />Esowo kehm-e lennge amahr, á soro nyehn elbing alahb. Á song tuk alahb rurur go ekpˈkpuk, song ka mmon, á wo.<verse eid="GEN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 21:20" />Esowo jolo a mmon noo eji á jo gbal. Á lene go elka emahng, á jolo nne no jo ta mban. <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />Ana á lene o elka emahng ni Paran, nnyehn song ko nkal go Ijib ba ka-e.<verse eid="GEN 21:21" /></para>
  <para style="s">Ebraham limi egbanngalung a Abimelek, go Beerseba</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />Ngare nyio Abimelek, a Fikol ji ntubesia nsoja enye kehm tongo Ebraham re, &lt;&lt;Esowo li a na go ejum ajehng ajehng ji a ma lim. <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />Tir tong-m go esamahr Esowo re, a nehm nehmem go mbang anyehng anyehng, afii jol abon ebame, afii etˈtohngo ejame. Tib-m nnoobo eljini, wo tob tib ejahbe ji a lene a ana njenne, elkohn ana ni m ma-a tib.<verse eid="GEN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24" />Ebraham kehm bungu re, &lt;&lt;Me n taame, m bahke tiri.&gt;&gt;<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />Ebraham kehm tooro tong Abimelek bade elbing alahb ni alokeltum ebe ma taare. <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />Abimelek kehm bungu re, &lt;&lt;N nehme kahn nne no ma lim ejum jia. Wo m-e a ka tong, lela wo n kpˈwuku na.&gt;&gt;<verse eid="GEN 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 21:27" />Owo Ebraham kehm koko ejoro, a efong ba ka Abimelek, bo ane abal abal kehm tiri lim egbanngalung atemtem. <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />Ebraham yehke nkala njoro na esehma nyi nse bum eje eje go ellong atohkondi enye, <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />Abimelek kehm bahbe Ebraham re, &lt;&lt;Nkal a njoro esehma nyi nse nyi a ma yehke bum eje eje lohngo renan?&gt;&gt;<verse eid="GEN 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30" />Á kehm faange re, &lt;&lt;Ko nkala njoro nyia na esehma nyi nse go egame ebo, jol ntianse re, me wo rahme elbing alahb nia.&gt;&gt;<verse eid="GEN 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 21:31" />Owo wahnge edi jio bo jo lung re Beerseba<note caller="+" style="f"><char style="fr" closed="false">21:31 </char><char style="ft" closed="false">Betseba lohngo re, elbing elahb egbanngalung, afii abing alahb asehma</char></note>, tibre edi jio wo, aneblum abal baa lim egbanngalung.<verse eid="GEN 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 21:32" />Eji bo limi egbanngalung jio o Beerseba mal, Abimelek, a Fikol ji ntubesia nsoja enye, kehm feere kehnge go ndi nyi anebe Filista. <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />Ebraham bahme elrahn eti ni bo kpo lung re tamaris go Beerseba, edi jio wo, á jo lung mbing nyi Jehova, ye ji li Esowo bi li njinanjini. <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />Ebraham kange gbalee go ndi nyi anebe Filista.<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s">Esowo wuungu eltaame ni Ebraham</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />Eji ma kang a, Esowo kehm wuungu Ebraham. Á kehm-e lungu re, &lt;&lt;Ebraham!&gt;&gt;</para>
  <para style="p" vid="GEN 22:1">Á kehm faange re, &lt;&lt;Nyehn me ga.&gt;&gt;<verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />Owo Esowo kehm-e tongo re, &lt;&lt;Rod Aisik mmon ewa, mmon mmon awohng, no kpo kor-a, wo song go ekidi ndi jio ji Moriya. Ko-e wo lim njom nyi bo kpo jahm fi go ewong ajehng go ellong awong nyao, ji m bahk-a tibi.&gt;&gt;<verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />Etoono efung, efungfu behre behre, Ebraham kehm mehle toobo mbvankang enye. Á rodo alokeltum ebe na abal tahm a bo, a Aisik mmon ewe, á kehm rak nkun nyi á bahke koko lim njom nyio nyi bo kpo jahm fi, á kehm mehle asongo edi jio ji Esowo tong-e no bade. <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />Eji ma kang nfung era, Ebraham kehm tabe esamahr ebe seenge nyehn edi jio go fee. <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />Á kehm tongo alokeltum ebe re, &lt;&lt;Jolen a, a mbvankang, me a mmon, wahr tohko je go esˈsong. E bahke tohko song kak Esowo go, kehm feere ba kpir-n.&gt;&gt;<verse eid="GEN 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6" />Ebraham kehm rodo nkun nyi bo bahke koko lim njom nyi eljahme fi, si mmon ewe Aisik, yefono antahng fili agun, a ntahme. Eji bo ane abal abal jo jen asongo, <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />Aisik kehm bungu tong Ebraham nde re, &lt;&lt;Nsoo?&gt;&gt;</para>
  <para style="p" vid="GEN 22:7">Ebraham kehm faange re, &lt;&lt;Ee, mmon ewame.&gt;&gt;</para>
  <para style="p" vid="GEN 22:7">Aisik kehm bungu re, &lt;&lt;Wo nyehn nkun a, agun fvfo nyaa a, mmonjoro nona no a bahke koko lim njom nyio nyi eljahme fi?<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />Ebraham kehm faange re, &lt;&lt;Mmon ewame, yefono Esowo antahng wo bahke kake mmonjoro no njom nyio nyi bo kpo jahm fi,&gt;&gt; Bo ane abal abal soro asi jo jen asongo.<verse eid="GEN 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9" />Eji bo ma rehng edi ji Esowo tong-e no. Ebraham kehm limi egudu njom o, fere kono nkun kpee, á kehm gbake Aisik mmon ewe alehke fere rod-e kunu egudu njom jio, go ero nkun, go egudu njom. <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />Á kehm tanne ebo rod ntahme re á wul mmon ewe. <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />Owo enjel nyi Jehova kehm rabe lung-e go ero re, &lt;&lt;Ebraham! Ebraham!&gt;&gt;</para>
  <para style="p" vid="GEN 22:11">Á kehm-e faange re, &lt;&lt;Nyehn me ga.&gt;&gt;<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />Enjel kehm-e tongo re, &lt;&lt;Ka lak mmon noo ebo, ke-e lim ejumjum. Anv, me n kahn re a kpˈfahle Esowo, tib eji a ka-m mmon ewa, a kiim tahre mmon ewa, mmon mmon awohng ewa.&gt;&gt;<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />Ebraham kehm tabe esamahr seenge, soro nyehn nkom go arakrak nti ma fehre atang enye. Á kehm song jabbe nkom ko-e ba a ne, ba lim njom nyi bo kpo jahm fi, soongo esi mmon ewe. <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />Owo Ebraham kehm lungu edi jio re, Jehova wo bahk kake. Tete tub bi lela, bo kpo bung re, &lt;&lt;Go ewong ji Jehova, Jehova bahk-r kake.&gt;&gt;<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />Enjel nyi Jehova kehm lungu Ebraham go ero, etoono nkpele, <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />kehm bungu re, &lt;&lt;Jehova wo ma bung, &lt;Me n tir elname tib ejum ji a ma lim a, a ki tahre mmon ewa bum, mmon mmon awohng ewa, <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />m bahk-a lohko fuulu, fere lim etˈtohngo eja rur ana alonlo nya li go elbung, bo bahke tob rur ana erikehndi bi li go nkpe aya. Etˈtohngo eja ji bahke taare ajahbe nya anebekv ebo fere lene, <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />sehng goji mmon ewa, ajahbe kpee go njini bahke bele elfuulu, tib eji a ma-m kpunu.<verse eid="GEN 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 22:19" />Ebraham kehm feere ba kpiri alokeltum ebe, bo kpee kehm feere kehnge go Beerseba. Ebraham lene o Beerseba.<verse eid="GEN 22:19" /></para>
  <para style="s">Abon ba nlum ba Nahor</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />Eji ma kang a, bo kehm tongo Ebraham re, &lt;&lt;Milka ji nkala mmonanne, yebtob jol nyehn abon, yeb jel abon ba nlum ka mmonanne: <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />Uji wo li ngbokambang, Buji ji mmonannyehn, Kemuel (nde no Aram), <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />Kesed, Hajo, Pildash, Jidlaf, a Betuel.&gt;&gt; <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />Betuel wo jolo nde no Rebeka. Milka jele abon ba nlum na anehkeni baa ka Nahor ji mmonannyehna Ebraham. <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />Nne elkora Nahor no bo jo lung-e re Reumah, a tob jele abon ba nlum: Tebah, Gaham, Tahas, a Maaka.<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s">Elkv ni Sara</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />Sara, kange nnya atahl arakera a nnya esehma. <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />Sara kpoo go Kiriati Aba (ji li Hebron) go ndi nyi Kenan. Ebraham kehm tahme re á song ling Sara, fere noongo elkv ene.<verse eid="GEN 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3" />Owo Ebraham kehm mehle yiimi o edˈda elkv nkal ewe, kehm tahme song bung a anebe Hid re, <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />&lt;&lt;Me njenne nyi, n li nne ajahmjahm go egahne ellong. Gung-m wahn edi ndi a, ji bahke jolo eyele akvne, ji m bahke jo kak akvne enyame.&gt;&gt;<verse eid="GEN 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5" />Owo anebe Hid kehm faange Ebraham re, <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />&lt;&lt;Nsoo, wuung-r atung. Wo egburu mmona ntul wo go egahre ellong. Jo kak akvne enya go eyele akvne ejahre ji nno. Nne ewahre awohng awohng limm no bahke sahde re wo kˈkak akvne enya go ege eyele.&gt;&gt;<verse eid="GEN 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />Ebraham kehm mehle yiimi gong go ndi, ka anebe Hid ba li afono ndi, <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />kehm bungu tong bo re, &lt;&lt;Joare kp-n lohko kor re me n jo kak akvne enyame a, wuung-m wahn atung, wahn fere tob-m gboongo Efron mmona Johar ka-m. <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />Eji á lˈgung-m egong jio ji Makipela, ji li jˈje ka-e, ji li ege esi egbe. Bahb-n ye á gung-m go ekun bi fuumu no, eji n lˈko lim eyele akvne go egahne ejahbe.&gt;&gt;<verse eid="GEN 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />Efron nnea Hid ji o ellong ane ebe, á kehm faange Ebraham go elkab anebe Hid kpee ba ba go eti mbu ejahbe eje. <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />Á bungu re, &lt;&lt;Eˈee nsoo, wuung-m atung; M ma-a ka edi jio, fere tob ka-a egohng ji li o. M ma-a ka go esamahr ane ebame. Kpa nkvne enya kak o.&gt;&gt;<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />Ebraham kehm kpe gong go ndi ka afono ejahbe bao, <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />kehm tongo Efron go ebo esamahr re bo wuk, &lt;&lt;Wuung-m atung, lˈfere kor-a, m bahk-a kake ekun bi edi jio, taame wo ko, eji n lˈjo kak akvne enyame o.&gt;&gt;<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />Efron kehm faange Ebraham re, <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />&lt;&lt;Wuung-m atung nsoo; edi ndi jio rehnge asilva akpohko atahltahl, jia lohngo jen, me, a wahra na? Kpa nkvne enya kak o.<verse eid="GEN 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 23:16" />Ebraham kehm taame tv ekun bi Efron gahme no. Ebraham ka-e asilva akpohko atahltahl go esamahr anebe Hid, toono ana ekun akpohko jolo no go ellong abajenare ngare nyio.<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />Ano wo edi ndi ji Efron ji jolo go ejahbe bo kpo lung re Makipela kohlo ejahbe Mamre, edi ndi, a egohng ji jolo o, go arahnti kpee nya jolo o, bo yake kpee, <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />ka Ebraham re jol edi eje, go esamahr anebe Hid kpee ba ba go eti mbu ji ejahbe jio. <verse eid="GEN 23:18" /><verse number="19" style="v" sid="GEN 23:19" />Eji Ebraham ma gunu edi ndi, ona wo á kake Sara nkal ewe, go egohng ji li go ejahbe Makipela, edi ndi ji jolo kohlo ejahbe Mamre, ji li go Hebron, go ndi nyi Kenan. <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />Ano wo edi ndi jio, a egohng jio, ji jolo ka anebe Hid, fere jol ka Ebraham ana eyele akvne eje.<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s">Aisik ko Rebeka go elbal</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />Ngare nyio Ebraham ebkul, sahb kˈkul, Jehova me-e fuulu ejang abehng abehng. <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />Á kehm bungu tong ntubesia abalokeltum go nlaaga enye, ye ji nsol kpee nyi Ebraham wob-e go elwo re, &lt;&lt;Kak ebo eba go egame nla eyo. <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />N kpˈsebe re wo tir go esamahr Jehova, ye ji li Esowo bi elbung abola ndi, re a nehm ko nnenkal go ellong anebkal Kenan ka mmon ewame, bo ji n li a, go ebo a ndi, <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />a bahke feere egame ejahbe, go egama nnahb, song ko nkal ba ka Aisik mmon ewame.&gt;&gt;<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />Nlokeltum noo kehm-e bahbe re, &lt;&lt;Lˈfere jol re nnenkal we nehm kor re á toon-m ba ndi nyia, anv, m bahke koko na mmon ewa feere a ne go ejahbe ji a lohngo no ba aa?&gt;&gt;<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />Ebraham kehm-e tongo re, &lt;&lt;Tiki yiimi re a nehm rod mmon ewame feere a ne go.&gt;&gt; <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />Jehova, ye ji li Esowo bi li go ero, ye ji yehk-m no go nlaaga nyi nsoo, a ejahbe ji n lohng no, á bungu tong-m, fere nyam ko nwongo a name re, &lt;Mmon ewa wo m bahk-e kake edi ndi jia.&gt; Jehova bahke tumu enjel enye gbo-a mbang, eji a lˈsong ko nkal go, ba ka mmon ewame. <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />Lˈfere jol re nnenkal we nehm kor re á toon-a ba, wob for go nwongo nyi a tiri no go egame esamahr. Fvfo ka tiki feere a mmon ewame go.&gt;&gt; <verse eid="GEN 24:8" /><verse number="9" style="v" sid="GEN 24:9" />Owo nlokeltum noo kehm kake ebo ebe go nla eyo nyi nde Ebraham, kehm koko nwongo bade ejum jia.<verse eid="GEN 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10" />Owo nlokeltum noo kehm rodo ekamel na ebwubu bi nde, á tob rodo anoobo ajoobo nsol nya nde bele no budu, kehm mehle eljen asongo go Aram Naharaim, song rehng go ejahbe ji Nahor lene no. <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />Á limi re akamel nyao jamme alahng kohlo elbing alahb ni li ga esi ejahbe jio, jolo ngare elgung nyi anebkal kpo song tuk alahb.<verse eid="GEN 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 24:12" />Owo nlokeltum noo kehm kake ero re, &lt;&lt;O Jehova, Esowo bi nsoo Ebraham, nong eljen ni n fi a lela nob, wo fere tib Ebraham nso ewame nnoobo enya. <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />Nyehn ana n yim a kohlo elbing alahb, abon ba nkal ba anebe ejahbe jia, kpˈbake ba tuk alahb. <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />Nong jol re n lˈtong mmon no nkal re, &lt;Radde etu elahb eja ka-m me n jahm nnyo, nong á lub bung re, &lt;Ko wo, me n tob tuk ka akamel enya, nong lub jol re, ye wo á me-e yehke ka nlokeltum ewa Aisik. Lˈjol ana, m bahke kahne re wob tib nso ejame nnoobo enya.&gt;&gt;<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />Re á kehm kake ero mal, owo Rebeka kehm soro lohng ba, a etulahb go ekpakebahk. Á jolo mmon no nkal no Betuel, Betuel jolo mmon no nlum no Milka, Milka wo jolo nkal a mmonannyehn Ebraham no bo jo lung-e re Nahor. <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />Mongbahme noa nobo sehng, á jolo mongunga nnenkal; nnene ka nˈnoongo ane. Á kehm badde yel go elbing alahb song tuk alahb kak etu lohng a ma.<verse eid="GEN 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 24:17" />Nlokeltum noo kehm foomo song kpir-e, fere tong-e re, &lt;&lt;Titi ka-m abon alahb go ega etu me jahm nnyo.&gt;&gt;<verse eid="GEN 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18" />Á kehm bungu tong-e re, &lt;&lt;Wo me nsoo, á kehm soro radde etulahb fili go abo, kehm-e kake á wo.<verse eid="GEN 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 24:19" />Eji á me-e ka, á ma wo, á fere tong-e re, &lt;&lt;M bahke tob tuk alahb ka akamel enya, tete bo wo biingi bo.&gt;&gt; <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />Á soro foomo yaange alahb go etu kak ejum ji bo kpo kak akamel alahb, fere kpe be tahm go elbing song tohng alahb mako ba a ma, ano wo á tohngo no ka akamel enye biingi bo kpee. <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />Jol nlokeltum noa ellum anehng anehng á bungem, á jo baab-e re á nyehn lˈjol re eljen ene Jehova eblim re nob ka-e, afii kˈnob.<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />Eji akamel ma wo alahb mal, nnenlum noa kehm yehke abangetung nwul nya agul nya jo lub egram eblon kunu ejang, a ebil ebo agul ebbal nya jo lub egram atahl alon a egram ebwubu. <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />Owo á kehm-e bahbe re, &lt;&lt;Mmonse nkal, wo mmona nyehne wo? Titi tong-m, ekpˈkpa jiaa go etahk nso ji e bahke bake ba kanga?&gt;&gt;<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />Á kehm faange re, &lt;&lt;Me mmon no Betuel wo, ye ji Milka jel-e no ka Nahor.&gt;&gt; <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />Á kehm kpe bung re, &lt;&lt;Wahr kpi akpawake ajele gbalee, a nsol nyi enyam, a ekpˈkpa ji a bahke ma kang atv.&gt;&gt;<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />Nnenlum noa kehm gongo go ndi kak Jehova, <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />rea, &lt;&lt;Eltehke jol ka Jehova, ye ji li Esowo bi nsoo Ebraham, ye ji ki ten nnoobo enye, á jolo go etingitingi ka nsoo ewame. Ana me, Jehova ma-m tv go mbang eljen tete rehng etahk abonanyehn nsoo.&gt;&gt;<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />Mmongbahme noo kehm beke song tong nnyehn, a anebe etahk ebe bada nsol nyia. <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />Rebeka bele mmonannyehn no nlum no bo jo lung-e re Leban, á kehm foomo re á song kpiri nne noa go elbing alahb. <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />Ana á nyehne abangetung nwul nyao, a ebil ebo go abo nya mmonannyehn no nkal, fere wuk Rebeka kpˈtongo ji nnenlum noa me-e tong, á kehm lohngo tahm song nyehn-e á yim no go ellong akamel kohlo elbing alahb. <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />Á kehm-e tongo re, &lt;&lt;Ba, wo ji Jehova ma-a fuulu, jenji wahnge a yim a? Me n toobo etahk bum-a, a edi ji akamel bahke jolo.&gt;&gt;<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />Owo nlokeltum noa kehm tahme etahk, bo kehm fannge akamel nsol go boa njahm, fere ko akpawake ajele, a nsol alehke akamel, tob ko alahb ba ka-e, a ane ebe re bo ru akpade ebo. <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />Eji bo ko nsol alehke ba ka-e, á tongo bo re, &lt;&lt;N nehm tiki li nsol alehke tete n tong-n ji li re me n tong-n.&gt;&gt;</para>
  <para style="p" vid="GEN 24:33">Leban kehm bungu re, &lt;&lt;Tong-r me.&gt;&gt;<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />Á kehm bungu re, &lt;&lt;Me nlokeltum no Ebraham wo. <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />Jehova ebfuulu nsoo ewame go mbuda nkunu, yeb gbo afang, Esowo me-e ka ejoro, efong, asilva, a agul,alokeltum ba nlum, a ba nkal, go akamel, a ebvankang. <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />Nkala nsoo ewame Sara ebjel mmon no nlum ka-e tvtv eji á ma kul o, á me-e ka ejum ajehng ajehng ji á kpi no. <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />Nsoo Ebraham lim-m n tir ko nwongo re, &lt;Ka tiki ko nkal goji anebe Kenan ka mmon ewame go ellong abonse nkal ba anebe Kenan, bo ji ń lene go ebo a ndi, <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />song go nnahb a nsoo, go egame ejahbe, wo song ko nkal ba ka mmon ewame.&gt;<verse eid="GEN 24:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 24:39" />Owo n kehm bahbe nsoo Ebraham re, &lt;&lt;Anv nnenkal tohko taame toon-m mee?<verse eid="GEN 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 24:40" />Á kehm-m faange re, &lt;&lt;Jehova ji m ma jen a ne, bahke tumu enjel enye á jol a na go ega eljen, eji lˈnob a na,eji a lˈko nkal ba ka mmon ewame, go ejahbe nsoo, á bahke lohngo go ebangenahb nsoo. <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />Jol a lˈsi jˈje go ejahbe nsoo, wob for go nwongo nyia, jol afii bo taamem yake nnenkal ka-a, a bahke foro go egama nwongo.&gt;&gt;<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />Eji m ba rehng elbing alahb lela, m bungu re, &lt;O Jehova, Esowo bi nsoo ewame Ebraham, titi nong eljen nia nob aname, <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />nyehn me ga yim kohlo elbing alahb; mmon no nkal lˈfere ba alahb tuk go ege etu, n lˈtong-e re, &lt;&lt;Titi, nong me n tohko wo abon alahb go ega mmotu, <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />á lˈfere tong-m re, &lt;&lt;Wo, m bahke tob tuk ka akamel enya, nong jol re, ye wo Jehova me-e yehke ka mmona nsoo ewame.<verse eid="GEN 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 24:45" />Re me n rahke ero akake go egame eltim, Rebeka soro lohng ba, a etulahb go ekpakebahk, sehng re á song tuk alahb go elbing alahb, n kehm-e tongo re, &lt;Titi, ka-m alahb me n wo.&gt;<verse eid="GEN 24:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 24:46" />Á kehm soro foomo radde etu eje go ekpakebahk kehm bungu re, &lt;Wo me, m bahke tob tuk alahb ka akamel enya. N kehm woko, á lohko tob tuk alahb ka akamel enyame.<verse eid="GEN 24:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="GEN 24:47" />N kehm-e bahbe re, &lt;Mmonse nkal, wo mmona nyehne?&gt;</para>
  <para style="p" vid="GEN 24:47">&lt;&lt;Á kehm faange re, &lt;Me mmon no Betuel wo, ye ji Milka jel-e no ka Nahor.&gt;</para>
  <para style="p" vid="GEN 24:47">N kehm soro kak-e ebil go nwul, kak-e abil nyako go abo, <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />n kehm gongo go ndi kak Jehova, n tehke Jehova, Esowo bi Ebraham nsoo ewame, ye ji ma-m tv sehng go mbang nyi nno re me n ko mmona mmonannyehna nsoo Ebraham ba ka mmon ewe. <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />Anv lˈjol re ḿ bahke tibi nsoo nnoobo eljini, fere lim etingitingi, tong-m wahn, afii ano nehm jol tong-m wahn, eji n lˈkahn esi mbang ji m bahke toono.&gt;&gt;<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />Leban, a Betuel kehm faange re, &lt;&lt;Jia lohng goji Jehova, wahr wa nehm ma tong ejum ajehng ajehng go mbang anyehng anyehng. <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />Nyehn Rebeka ga, rod-e song a ne, á song jol nkala mmona nso, ana Jehova ma tong re jol.&gt;&gt;<verse eid="GEN 24:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 24:52" />Eji nlokeltuma Ebraham wuku ji bo ma bung, á kehm gongo ndi go esamahr Jehova. <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />Owo nlokeltum kehm yehke agul, a asilva nya jolo nsol elliibi, go abomo ka Rebeka, á tob ka Leban mmonannyehn, a nnyehna Rebeka nsol nyi sahb kˈkim ekun. <verse eid="GEN 24:53" /><verse number="54" style="v" sid="GEN 24:54" />Owo nlokeltum Ebraham noa, a aneblum ba toon-e no ba kehme nsol alehke li, fere wo, bo sa o kang.</para>
  <para style="p" vid="GEN 24:54">Eji bo nyahme no etoono efungfu, nlokeltum Ebraham kehm bungu re, &lt;&lt;Yak-m wahn, me n feere song goji nsoo ewame.&gt;&gt;<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />Owo Leban, a nnyehna Rebeka kehm-e faange re, &lt;&lt;Nong mmongbahme noa tohko kpe kang a nahre nfung ewubu, afii sehnge ano; wahn kehm tahme song.&gt;&gt;<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />Á kehm bungu tong bo re, &lt;&lt;Kama wahn kpe laange, anv eji Jehova ma lim re eljen aname nob. Yak-m wahn me n song kehnge, song kpiri nsoo ewame.&gt;&gt;<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />Owo bo kehm bungu re, &lt;&lt;Nong wahr tohko lung mongbahme fere bahb-e bade ejum jia.&gt;&gt; <verse eid="GEN 24:57" /><verse number="58" style="v" sid="GEN 24:58" />Bo kehm lungu Rebeka bahb-e re, &lt;&lt;Á bahke toono nnenlum noa tahma?&gt;&gt;</para>
  <para style="p" vid="GEN 24:58">Á kehm bungu re, &lt;&lt;Ee, m bahke tahme.&gt;&gt;<verse eid="GEN 24:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59" />Owo bo kehm tumu Rebeka mmonannyehn ebo, a nlokeltum ewe, a nlokeltuma Ebraham noo, a aneblum ba toon-e no ba, bo feere kehnge. <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />Bo fuulu Rebeka, fere tong-e re, &lt;&lt;Mmonannee ewahre, nong wo lub nyange mbuda nkunu, abon eba jo nok ga ajahbe nya anebekv ebo.&gt;&gt;<verse eid="GEN 24:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61" />Owo Rebeka, a alokeltum ebe kehm toobo nsol eltahme, bo gbade akamel nsol tahm toono nnenlum noo. Nlokeltum noo ko Rebeka, bo tahm.<verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />Ngare nyia Aisik eblohng go Negev edi ji á jolo no, ba ga Beer Lahayi Royi. <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />Á kehm lohngo song rehng go emahng elgung anehng, song ji re á tir bada nsol, ana á tabe esamahr wahre, á kehm nyehne akamel kpˈbake. <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />Rebeka tob seenge mbuksong, á kehm nyehne Aisik. Á kehm badde go ekamel ji á kuumu no, <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />á kehm bahbe nlokeltum noo re, &lt;&lt;Nne awoo kpˈbake o re á ba wan-r ga emahng?&gt;&gt;</para>
  <para style="p" vid="GEN 24:65">Á kehm-e faange re, &lt;&lt;Nsoo wo o, Rebeka kehm rodo mbomo esi bulu elne.<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />Nlokeltum noo kehm tongo Aisik nsol kpee nyi á ma lim. <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />Aisik kehm-e koko ba a ne go ebehre ji nnyehn Sara, fere ko-e go elbal, á jol nkal ewe, á jo kor-e kor, Rebeka jolo ejum ekakeltim eji nnyehn ma kpo.<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s">Elkv ni Ebraham</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />Ebraham kehm kpe ko nkal noko, no bo jo lung-e re Ketura. <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />Á jele Jimran, Joksan, Medan, Midian, Isbak, go Sua ka Ebraham. <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />Joksan wo jolo nde no Seba a Dedan; etˈtohngo ji Dedan ji li anebe Asur, anebe Letus, a anebe Lewum. <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />Abon ba nlum ba Midian ba a, Efa, Efer, Hanok, Abida, a Eldaa. Bo kpee lohng go etˈtohngo ji Ketura. <verse eid="GEN 25:4" /><verse number="5" style="v" sid="GEN 25:5" />Ebraham yake ejum ajehng ajehng kpee ji á bele no ka Aisik. <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />Eji Ebraham kpeka li elkpin, á kaa abon anebe elkang ebe nsol, fere tum bo, bo tahm Aisik sa, tahm go ero nfam. <verse eid="GEN 25:6" /><verse number="7" style="v" sid="GEN 25:7" />Nnya kpee nyi Ebraham kange no, jolo nnya atahl anehkeni a nnya elku. <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />Owo Ebraham gohro v elv ene, kehm kpoko, á kange nnya tvv, sahb kˈkul. Bo kehm-e kpake kak go eyele ji ane ebe. <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />Aisik abola Ismeel, abon ebe ba nlum kehm-e kpake kak go egohng ji li ejahbe ji Makipela ji li kohlo ejahbe ji Mamre, go egbe ji Efron ji mmona Johar ji nnea Hid, <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />edi egbe jia Ebraham gunu goji anebe Hid, owo bo kpa Ebraham a nkal ewe, Sara kak. <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />Eji Ebraham ma kpo, Esowo kehm fuulu Aisik mmon ewe. Ngare nyio Aisik lene kohlo Beer Lahayi Royi.<verse eid="GEN 25:11" /></para>
  <para style="s">Abon ba Ismeel</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />A wo li ntoora nnyo mi Ismeel mmona Ebraham, ye ji nlokeltuma Sara no bo jo lung-e re Hagar ji lohng go Ijib jel-e no ka Ebraham. <verse eid="GEN 25:12" /><verse number="13" style="v" sid="GEN 25:13" />Abing abon ba nlum ba Ismeel ba a, bo gamme bo, bomo nnenkul feere ndi: Nebayod wo jolo ngbokambanga mmon no Ismeel, noko Kedar, a Adbeel, a Mibsam, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />a Mishma, a Duma, a Masa, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />a Hadad, a Tema, a Jetur, a Nafis, go Kedema. <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />A wo li abon ba nlum ba Ismeel, go bo abing, a ajahbe nya bo lene no, a nsi, a nsi ebo, a arohko arohko ajahbe nya bo lene no. Bo ba jolo atubesi ebo, ewubu etˈtohngo ebbal ebo. <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />Nnya kpee nyi Ismeel kange no jolo nnya atahl arakera, a nnya elku a nnya ebal, kehm kpoko, bo kpa-e kak eyele ji ane ebe. <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />Etˈtohngo eje ji kake elsi ebo go elka elka ni Havila rehng go Sur, kohlo nkonandi nyi Ijib, ana a kpˈtahme asongo go Asur. Bo jo bibi eljini a abonanyehn ebo kpee.<verse eid="GEN 25:18" /></para>
  <para style="s">Ana bo jele Eso abola Jekob</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />A wo li ntoora nnyo mi Aisik mmona Ebraham. Ebraham wo jolo nde no Aisik, <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />Aisik jolo nnya atahl abal kehm koko Rebeka go elbal, ye ji jolo mmona Betuel, nne Aram no lohng go Padan Aram. Rebeka jolo mmonannyehn no Leban ji lohng go Aram. <verse eid="GEN 25:20" /><verse number="21" style="v" sid="GEN 25:21" />Aisik kake ero tong Jehova, bada nkal ewe, tibre nkal jolo ngum, Jehova kehm faange ero ebe, Rebeka nkal ewe kehm soro sa ela. <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />Abon jo nokko etemtem go atahng ala. Á kehm bungu re, &lt;&lt;Jenji wahnge elkohn ejum ana jia kp-m lˈlim?&gt;&gt; Á kehm tahme re á song bahb Jehova. <verse eid="GEN 25:22" /><verse number="23" style="v" sid="GEN 25:23" />Jehova kehm bungu tong-e re, &lt;&lt;Esi ejahbe ebbal wob-a go ala, ejahbe ebbal bi bahke lohngo go ga ala bahke yabe, ejahbe ajehng bahke tahne sehnge jehko, nne no li nnenkul bahke jo loko mmonse. <verse eid="GEN 25:23" /><verse number="24" style="v" sid="GEN 25:24" />Eji ngare ejel enye rehnge no, á jele ayafele abon abal ba nlum. <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />No gbo mbang lohng jolo mbilibili, ngubjing enye jolo anyar anyar, jolo are bo kak-e na ewobo ji li agv agv; ye bo gung-e mbing re Eso<note caller="+" style="f"><char style="fr" closed="false">25:25 </char><char style="ft">Eso, lohngo re anyar anyar</char></note>. <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />Owo mmonannyehn kehm lohngo toon-e, ebo ebe jabbe go eselsel ji Eso, ye bo gung-e mbing re Jekob<note caller="+" style="f"><char style="fr" closed="false">25:26 </char><char style="ft">Jekob, nne no jabbe nne go eselsel, lohngo re nne no kpo taare nji nyi ntem</char></note>. Aisik jolo nnya atahl ara Rebeka kehm jele bo. <verse eid="GEN 25:26" /><verse number="27" style="v" sid="GEN 25:27" />Abon bao kehm gbale, Eso jolo agbaji ebim, á jolo nne no jo woomo go emahng. Wo Jekob jolo nne no jolo soom, jo woomo go abon nkpatahk. <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />Tib eji nnyam jo kor Aisik, Eso wo jo ga-e kor. Wo Rebeka, Jekob wo jo kor-e. <verse eid="GEN 25:28" /><verse number="29" style="v" sid="GEN 25:29" />Efung abehng Jekob jo lame mbed, Eso kehm kehnge emahng ba, njal yame sˈsehng, akahb jo kahm-e kahm. <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />Á kehm tongo Jekob re, &lt;&lt;Kam mbilibila mbed nyio me n li! Tibre njal ma-m yam sehng!&gt;&gt; (Ji ji wahnge bo tob jo lung-e re Edom.<note caller="+" style="f"><char style="fr" closed="false">25:30 </char><char style="ft">Edom lohngo re mbilibili</char></note>) <verse eid="GEN 25:30" /><verse number="31" style="v" sid="GEN 25:31" />Jekob kehm-e faange re, &lt;&lt;Gbo mbang gung-m ekul eba.&gt;&gt; <verse eid="GEN 25:31" /><verse number="32" style="v" sid="GEN 25:32" />Owo Eso kehm bungu re, &lt;&lt;Ga n nong go emel elkv, anv, nsehng anyii ekul ebame bahk-m kake?&gt;&gt; <verse eid="GEN 25:32" /><verse number="33" style="v" sid="GEN 25:33" />Jekob kehm bungu re, &lt;&lt;Tohko gbo mbang tir tong-m.&gt;&gt; Owo Eso kehm tiri ko nwongo, fere gungu Jekob ekul ebe. <verse eid="GEN 25:33" /><verse number="34" style="v" sid="GEN 25:34" />Owo Jekob kehm soro ka Eso ebred, a mbed nyi a ko amohk nti nya bo kpo lung re lentil lam. Eso li mbed nyia, wo alahb, mehl eje tahm. Ano wo Eso rodo ekul ebe daange.<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s">Aisik abola Abimelek</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />Njal jolo go ndi nyia, njal nyi jolo ngare nyi Ebraham jolo eje eje. Owo Aisik kehm tahme goji Abimelek ntul no Filista gona Gera, <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />Owo Jehova kehm ba kpiri Aisik, kehm-e tongo re, &lt;&lt;Ka je go Ijib, lene go ndi nyi n tong-a no re wo lene. <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />Jol go ndi nyia mongare ntiil. M bahke jolo a na, fere fuul-a. Wo wo m bahk-a kake ndi nyia a etˈtohngo eja, m bahke lohko lim enyam bi n nyame no, eji n tiri ka Ebraham nso. <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />M bahke limi etˈtohngo eja bahke ruru ana alonlo nya li go elbung, m bahke fere ka bo ndi nyia kpee. Ajahbe njini kpee bahke bele elfuulu, sehng goji etˈtohngo eja. <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />Tibre Ebraham kpun-m kpunu, fere lim nsol nyi n tong-e re á lim, fere bum atahm enyame, a ajehke enyame, go nle enyame.&gt;&gt; <verse eid="GEN 26:5" /><verse number="6" style="v" sid="GEN 26:6" />Aisik sa lene o Gerar. <verse eid="GEN 26:6" /><verse number="7" style="v" sid="GEN 26:7" />Eji aneblum ba ejahbe jio bahb-e no bada nkal ewe, á kehm faange re, &lt;&lt;Ye mmonannee wo.&gt;&gt; Tibre á jo fˈfahl re á bung re, &lt;&lt;Ye nkal ewame wo.&gt;&gt; Á tiri go ege eltim re, &lt;&lt;Aneblum ba li edi jia bahk-m wulu tib go esi Rebeka, tib eji á li nne ano.&gt;&gt; <verse eid="GEN 26:7" /><verse number="8" style="v" sid="GEN 26:8" />Eji Aisik ma kang afung gbalee edi jio, owo Abimelek ntula Filista kehm seenge sehng go ewindu, kehm soro nyehn Aisik kpi elkoro lim a Rebeka nkal ewe. <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />Owo Abimelek kehm tumu bo lung Aisik, kehm-e tongo re, &lt;&lt;Nkal ewa wo, go etingitingi! Nˈnan wahnge a tongo re, &lt;Ye mmonannee wo?&gt;&gt;&gt; Aisik kehm faange re, &lt;&lt;Tibre n tiri re m bahke tane elkpin ename tib esi eje.&gt;&gt; <verse eid="GEN 26:9" /><verse number="10" style="v" sid="GEN 26:10" />Owo Abimelek kehm bungu re, &lt;&lt;A elkohn ejum ajii a ma-r lim ana. Nnenlum awohng awohng noongo noongo a nkal ewa, kehn wob ko na ko ebi jia ba kun-r mbol mbol.&gt;&gt; <verse eid="GEN 26:10" /><verse number="11" style="v" sid="GEN 26:11" />Owo Abimelek kehm jehke ntahm ka ane kpee re, &lt;&lt;Nne awohng awohng no lˈgbiingi nnenlum noa, afi fere jolo nkal ewe, bo bahk-e tiki wulu na.&gt;&gt; <verse eid="GEN 26:11" /><verse number="12" style="v" sid="GEN 26:12" />Aisik bahme nsol go ndi nyia, kehm kpake mbuda nkunu go elya nˈnehm o, tibre Jehova fuul-e fuulu. <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />Aisik kehm gboko afang, afang enye soro asi jo gbal na tete á sahb fˈfang. <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />Á bele ejoro, a ebul gbalee, a adahmagbudu adahmagbudu. Á tob bele alokeltum gbalee, toono o, á jo teele anebe Filista ala. <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />Abing alahb kpee nya alokeltum nde rahme no ngare nyi Ebraham nde kpeka li go elkpin, anebe Filista song kpu ndi sahd. <verse eid="GEN 26:15" /><verse number="16" style="v" sid="GEN 26:16" />Owo Abimelek kehm bungu tong Aisik re, &lt;&lt;Mehl wo song ka-r eyake, tibre wob bel atahne sehng-r.&gt;&gt; <verse eid="GEN 26:16" /><verse number="17" style="v" sid="GEN 26:17" />Owo Aisik kehm mehle o, song rehng go edamme ji Gerar, song kak elsi o. <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />Aisik kehm kpe lennge abing alahb nya bo rahme no ngare nyi Ebraham nde kpeka li, nya anebe Filista sahde no eji Ebraham ma kpo. Á tik kpe gungu abing alahb nyao abing nyanehm nya Ebraham nde ka no. <verse eid="GEN 26:18" /><verse number="19" style="v" sid="GEN 26:19" />Alokeltum ba Aisik rahme elbing elahb go edamme, kehm song nyehn mbˈbehl alahb o. <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />Abaabebul ba anebe Gerar kehm kehme eltaange a abaabebul ba Aisik. Bo jo bungu re, &lt;&lt;Alahb ma mahre ma!&gt;&gt; Wahng ka á lungu elbing elahb nio re, Esek<note caller="+" style="f"><char style="fr" closed="false">26:20 </char><char style="ft">Esek lohngo re ntaange</char></note> tibre bo taange a ne o. <verse eid="GEN 26:20" /><verse number="21" style="v" sid="GEN 26:21" />Owo bo kehm kpe rahm elbing nehko. Anebe Filista kpe ba yiimi ntaange o; owo á lungu elbing alahb nio re Sitna.<note caller="+" style="f"><char style="fr" closed="false">26:21 </char><char style="ft">Sitna lohngo re akpankpan</char></note> <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />Á kehm mehle tahm edi jio sa, kpe song rahm nehko, nio nnene taangem a ne. Á kehm lungu nio re Rehobod<note caller="+" style="f"><char style="fr" closed="false">26:22 </char><char style="ft">Rehobod lohngo re nkpaange edi</char></note>, ji lohngo re, &lt;&lt;Anv Jehova ma-r ka edi, e bahke tebe a ndi nyia.&gt;&gt; <verse eid="GEN 26:22" /><verse number="23" style="v" sid="GEN 26:23" />Á kehm mehle o tahm go Beerseba. <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />Atv mao, Jehova kehm ba kpiri Aisik, kehm-e tongo re, &lt;&lt;Me wo li Esowo bi Ebraham nso. Ka fahl tibre me n li a na. M bahk-a fuulu, fere lim etˈtohngo eja rur, tib go esi Ebraham nlokeltum ewame. <verse eid="GEN 26:24" /><verse number="25" style="v" sid="GEN 26:25" />Owo Aisik kehm limi egudu njom o, jo kak Jehova. Á si mobkpatahk o, alokeltum ebe tob rahme elbing alahb o. <verse eid="GEN 26:25" /><verse number="26" style="v" sid="GEN 26:26" />Ngare nyˈnehm o, Abimelek eblohng go Gerar ba go ege, a Ahusa ntubelle ewe, a Fikol ji jolo ntubesia nsoja enye. <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />Aisik kehm bahbe bo re, &lt;&lt;Ḿ ba jen ga egame, wahn sang jo bib aname fere kam-m yake goa? <verse eid="GEN 26:27" /><verse number="28" style="v" sid="GEN 26:28" />Bo kehm-e faange re, &lt;&lt;Wahr ebnyehn gbuul re Jehova li a na, owo wahnge e bungu re, fuumu re wahr koon nwongo tir atemtem, wahr anebe Filista a na, nong wahr koon nwongo a na, <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />re wahn nehm lim-r ebi ajehng ajehng, ana wahr ki-n gbiingi go mbang anyehng anyehng, e jo gbaam-n na, fere yak-n re wahn song go elkoono. Anv Jehova ma-a fuulu.&gt;&gt; <verse eid="GEN 26:29" /><verse number="30" style="v" sid="GEN 26:30" />Owo Aisik kehm limi eyiiki ka bo, bo li, fere wˈwo. <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />Efungfu behre behre, etoono efung, bo kehm koko nwongo tir atemtem. Aisik kehm song bo re bo song, bo soro tahm-e sa asongo go elkoono. <verse eid="GEN 26:31" /><verse number="32" style="v" sid="GEN 26:32" />Efung bio alokeltum Aisik kehnge ba tong-e bade elbing alahb ni bo ma rahm. Bo bungu re, &lt;&lt;Wahr ebnyehn alahb.&gt;&gt; <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />Aisik lungu elbing alahb nio re Siba,<note caller="+" style="f"><char style="fr" closed="false">26:33 </char><char style="ft">Siba lohngo re nwongo</char></note> tete sik lela, bo kpo lung mbing ejahbe jio re Beerseba<note caller="+" style="f"><char style="fr" closed="false">26:33 </char><char style="ft">Beerseba lohngo re elbing alahb ni nwongo, afii elbing alahb ni nsol esehma</char></note>. <verse eid="GEN 26:33" /><verse number="34" style="v" sid="GEN 26:34" />Eji Eso ma kang nnya atahl abal, á baange Judid, ye ji jolo mmona Beeri ji nnea Hid, á tob ko Basemad mmon no Elon ji nnea Hid fvfo. <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />Bo jo ka Aisik a Rebeka erakatahng.<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s">Aisik fuulu Jekob</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />Eji Aisik ma kul, amahr me-e kehme elbamme, á kpeem jo ma nyehn. Á kehm lungu Eso ji jolo mmon ewe no nkul, kehm-e tongo re, &lt;&lt;Mmon ewame.&gt;&gt; Eso kehm faange re, &lt;&lt;Ee, nyehn me ga.&gt;&gt; <verse eid="GEN 27:1" /><verse number="2" style="v" sid="GEN 27:2" />Aisik kehm bungu re, &lt;&lt;Anv me kul na a, jol efung elkv ename n nehme kahn. <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />Rod nsol ebim enya, elban a ekpukpuk ji atake elban kpo woomo, wo song go emahng song bim nnyam ekulugbe ba ka-m. <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />Lam elkohn ayebeyebe nsol alehke nyi kpo kor-m, wo ko ba ka-m me n li eji n lˈfuul-a kehm kpoko. <verse eid="GEN 27:4" /><verse number="5" style="v" sid="GEN 27:5" />Rebeka jo wuungu atung eji Aisik jo bung a Eso mmon ewe. Eji Eso tahme go ekul re á song bim nnyam ba a nyi, <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />owo Rebeka kehm tongo Jekob mmon ewe re, &lt;&lt;Nyehne, me n wuk nso kpˈbungu tong Eso mmonanne re, <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />&lt;Ko nnyam ekulugbe, wo ba lam ayebeyebe nsol alehke ka-m me n li, eji n lˈka-a elfuulu ename go elwo ni Jehova kehm kpoko.&gt; <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />Wuung-m atung nˈnob mmon ewame, wo lim ji m bahk-a tongo re wo lim, <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />song go ega ebul, wo song yehke abonbul abal ba nno, ko ba ka-m, me n lam ayebeyebe nsol alehke ana nyi kpo kor nso ka-e. <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />A bahke koko song ka nso re á li, eji á lfuul-a kehm kpoko.&gt;&gt; <verse eid="GEN 27:10" /><verse number="11" style="v" sid="GEN 27:11" />Jekob kehm faange Rebeka nnyehn re, &lt;&lt;Wo Eso mmonannee li anyar anyar, me ga anyar ngubjing n kpimm. <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />Nsoo lˈfere koor-m abo mee? M bahke jolo nne enehm ka-e, ji kehn m bahke bele elfuulu, m bahke fere bel na elsu.&gt;&gt; <verse eid="GEN 27:12" /><verse number="13" style="v" sid="GEN 27:13" />Nnyehn kehm-e tongo re, &lt;&lt;Mmon ewame, nong elsu nio jol ka me, lub lim na lim ji n tong-a no; song ko abon mbul ba ka-m.&gt;&gt; <verse eid="GEN 27:13" /><verse number="14" style="v" sid="GEN 27:14" />Owo á kehm tahme song ko abon mbul abal bao ba ka nnyehn. Á kehm lame ayebeyebe nsol alehke, jang jang ana jo kor nde. <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />Owo Rebeka kehm song jak anoobo nsol ebjing nya Eso mmon ewe no nkul nya jolo a ne go etahk, ba kak Jekob mmon ewe no nse. <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />Á kehm fere rod ngunyama mbul bulu Jekob go abo a emel eje ji anyar ki jol. <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />Owo á kehm rodo ayebeyebe nsol alehke nyi á ma lam kak Jekob go ebo, a ebred ji á limi no. <verse eid="GEN 27:17" /><verse number="18" style="v" sid="GEN 27:18" />Á kehm rodo tahm goji nde kehm song lung-e re, &lt;&lt;Nsoo.&gt;&gt; Nde kehm faange re, &lt;&lt;Ee, mmon ewame, wo nne awoo?&gt;&gt; <verse eid="GEN 27:18" /><verse number="19" style="v" sid="GEN 27:19" />Jekob kehm bungu tong nde re, &lt;&lt;Me Eso ji ngbokambanga mmon ewa wo. Me n lim ana á tong-m no. Mehl ji, wo li nnyam ebim enyame, eji a lˈka-m elfuulu. <verse eid="GEN 27:19" /><verse number="20" style="v" sid="GEN 27:20" />Aisik kehm bahbe mmon ewe re, &lt;&lt;A limi renan kehm ware bel nnyam ana, mmon ewame?&gt;&gt; Jekob kehm faange re, &lt;&lt;Jehova ji li Esowo eba, ye wo limi re ware ano ka-m.&gt;&gt; <verse eid="GEN 27:20" /><verse number="21" style="v" sid="GEN 27:21" />Owo Aisik kehm tongo Jekob re, &lt;&lt;Mmon ewame, jeere ba, me n koor-a abo, eji n lˈkahn ejoare a lohko li Eso mmon ewame. <verse eid="GEN 27:21" /><verse number="22" style="v" sid="GEN 27:22" />Jekob jeere kan a kohlo Aisik nde, á kehm-e kooro abo, kehm bungu re, &lt;&lt;Ellum ni Jekob ni, ga abo nya Eso nya.&gt;&gt; <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />Á we liingem, tibre abo enye jolo anyar anyar ana nya Eso mmonannyehn. Owo á kehm-e fuulu. <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />Á kehm-e bahbe re, &lt;&lt;Anv, etingitingi wo Eso mmon ewame woa?&gt;&gt; Jekob kehm-e faange re, &lt;&lt;Ee, me wo.&gt;&gt; <verse eid="GEN 27:24" /><verse number="25" style="v" sid="GEN 27:25" />Aisik kehm-e tongo re, &lt;&lt;Ko nnyam enya ba ka-m, me n li, mmon ewame, eji n lˈka-a elfuulu ename.&gt;&gt; Jekob kehm koko ba ka-e, á li. Á tob ko amahm ba ka-e, á wo. <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />Owo Aisik nde kehm bungu re, &lt;&lt;Ba, mmon ewame, wo ba sod-m nnyo.&gt;&gt; <verse eid="GEN 27:26" /><verse number="27" style="v" sid="GEN 27:27" />Á kehm jeke go ege song sod-e nnyo. Eji Aisik wuku esˈsv ewobo eje, á kehm-e fuulu, fere bung re, &lt;&lt;Esˈsv mmon ewame li ana esˈsv egbe jio ji Jehova ma fuulu. <verse eid="GEN 27:27" /><verse number="28" style="v" sid="GEN 27:28" />Esowo ka-a ebohng bi kpo na go elbung, a afang nya ndi. Á ka-a amohk nti gbalee, a amahm nfenfe. <verse eid="GEN 27:28" /><verse number="29" style="v" sid="GEN 27:29" />Ajahbe jo lok-a, nong ane ba lohng ajahbe gbalee jo gong ka-a, jol ntubesi ka abonane, nong abon ba nlum ba lohng ala nya nne jo gong kak-a, nong elsu jol ka ane bao ba lˈsua, elfuulu jol ka ane ba lˈfuul-a. <verse eid="GEN 27:29" /><verse number="30" style="v" sid="GEN 27:30" />Aisik fuulu kan Jekob a mal me, ana Jekob lohngo nde sa, ano wo Eso mmonannyehn kehnge ebim. <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />Ye fvfo tob lame ayebeyebe msol alehke ko re á ba ka nde. Owo á kehm bungu re, &lt;&lt;Nsoo, mehl ji, wo li nnyam ebim enyame, eji á lˈka-m elfuulu ena. <verse eid="GEN 27:31" /><verse number="32" style="v" sid="GEN 27:32" />Aisik nde kehm-e bahbe re, &lt;&lt;Wo nne awoo?&gt;&gt; Á kehm faange re, &lt;&lt;Me Eso wo, ngbokambanga mmon ewa.&gt;&gt; <verse eid="GEN 27:32" /><verse number="33" style="v" sid="GEN 27:33" />Aisik kehm kehme elkahme gbohk gbohk gbohk, kehm bungu re, &lt;&lt;Anv, nne awoo no je ebim no ma ko nnyam ebim ba ka-m! N li fere fuul-e, a kehm soro lohng ba. M me-e fuulu, á bahke lohko bel elfuulu. <verse eid="GEN 27:33" /><verse number="34" style="v" sid="GEN 27:34" />Eso wuku kan alum nya nde bungu no a me, á kehm rabe eling wahre wahre are eltim yahke fooro, fere jo tong nde re, &lt;&lt;Fuul-m, tob fuul-m nsoo.&gt;&gt; <verse eid="GEN 27:34" /><verse number="35" style="v" sid="GEN 27:35" />Wo á faange na re, &lt;&lt;Mmonnane ebko enehm, ba ko elfuulu ena.&gt;&gt; <verse eid="GEN 27:35" /><verse number="36" style="v" sid="GEN 27:36" />Eso kehm bungu re, &lt;&lt;Ji sang wahnge bo gung-e mbing re Jekoba? Nkpel ebal nyi a, nyi á ma-m nehm. Á ko ekul ebame, anv yebgohro ko elfuulu ename. Á kehm kpe bahb nde re, &lt;&lt;Anv, elfuulu anehng anehng a m-e bum-ma?&gt;&gt; <verse eid="GEN 27:36" /><verse number="37" style="v" sid="GEN 27:37" />Aisik kehm faange Eso re, &lt;&lt;M me-e lim re á jol ntubesi ewa, fere lim re akunu enye kpee jol alokeltum ebe. M m-e ka elfuulu nio ni amohk nti, a amahm ma nfenfe. Anv, jenji m bahke ma lim ka-a, mmon ewame. <verse eid="GEN 27:37" /><verse number="38" style="v" sid="GEN 27:38" />Eso kehm bungu tong nde re, &lt;&lt;Nsoo, anv a kpi elfuulu anehng ni nia? Nsoo tob fuul-m! Eso jo lingi wahre wahre. <verse eid="GEN 27:38" /><verse number="39" style="v" sid="GEN 27:39" />Owo Aisik nde kehm-e faange re, &lt;&lt;Edi ellene eja bahke jo jol fee go nvemma ndi, bahke jolo edi jio ji elahb kil jo na. <verse eid="GEN 27:39" /><verse number="40" style="v" sid="GEN 27:40" />A bahke jo ko ekahngkahng nok, kehm kpini, a bahke jo loko mmonanne. Ngare nyio nyi a lˈkˈma kpe kpuumu, a bahke laade elsol ene go ega emel tub go.&gt;&gt;<verse eid="GEN 27:40" /></para>
  <para style="s">Jekob be tahm goji Leban</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />Eso bele ebi ntir atahng bada Jekob tib go elfuulu ni nde fuulu Jekob. Owo á kehm bungu tong elne re, &lt;&lt;Afung nya e bahke noongo elkv nsoo ebkabbe, owo m bahke wulu Jekob mmonannee.&gt;&gt; <verse eid="GEN 27:41" /><verse number="42" style="v" sid="GEN 27:42" />Eji bo tongo Rebeka ejum ji Eso mmon ewe no nkul bungu no, á kehm tumu lung Jekob mmon ewe no nse, kehm-e tongo re, &lt;Eso mmonanne kpi elne eltim kak, a ntir atahng nyi á kpi no re á wul-a. <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />Mmon ewame, anv lim ji n kp-a tongo a: Be tvtv anv, wo song go Haran eji Leban mmonannee. <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />Jol a ne o mmongare ntiil, tete mmonane eltim gbo-e. <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />Ngare nyi eltim lˈgbo mmonane, á fere yini ji a lim-e no, m bahke tiingi etib tv-a re wo kehnge. Jenji wahnge me m bahke tane wahn abon abal abal efungfung abehng?&gt;&gt; <verse eid="GEN 27:45" /><verse number="46" style="v" sid="GEN 27:46" />Owo Rebeka kehm bungu tong Aisik re, &lt;&lt;Elkpin ma-m kpen tib esi anebkal Hid baa. Jekob lˈko nkal go anebkal Hid, go ellong anebkal ba lene ndi nyia, fuumu re me n kˈkpe jol elkpin.&gt;&gt;<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />Owo Aisik kehm tumu bo lung Jekob, kehm-e fuulu, fere ka-e erehke re, &lt;&lt;Ka baange nnenkala Kenan awohng awohng. <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />Song tvtv anv go Padan Aram, go etahke Betuel ji li nde no jele nne. Song ko nkal o, go ellong abone Leban ba nkal, ye ji li mmonannyehn nne. <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />Nong Esowo bi kpi nsahm kpee fuul-a, fere lim-a wo jel njel, rur go nfange, tete wahn jol ajahbe tvv. <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />Nong á ka-a, a etˈtohngo eja, elfuulu ni á ka Ebraham, eji a lˈtaare ndi nyio nyi a lene no anv ana njenne, ndi nyio nyi Esowo ka Ebraham.&gt;&gt; <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />Owo Aisik kehm tumu Jekob re á song. Á kehm tahme go Padan Aram, goji Leban ji mmona Betuel. Leban ji li nnea Aram wo jolo mmonannyehna Rebeka, ji nnyehna Jekob, a Eso. <verse eid="GEN 28:5" /><verse number="6" style="v" sid="GEN 28:6" />Eso kehm sebe kahn re Aisik ebfuulu Jekob, fere tum-e tv go Padan Aram re á song ko nkal go, á tob sebe kahn re eji Aisik fuul-e no, á fere rehke Jekob re, &lt;&lt;Ka ko nnenkal no lohng go Kenan.&gt;&gt; <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />Á fere wuk re Jekob ebwuk nde, a nnyehn, tahm go Padan Aram. <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />Owo Eso kehm-e lennge re anebkal Kenan baa, joom ka Aisik nde eyebeltim ajehng ajehng. <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />Á kehm tahme goji Ismeel, song baange mmona Ismeel ji jolo mmona Ebraham, no bo jo lung-e re Mahalad, ye ji jolo mmonannyehna Nebayod no nkal. Á ko-e budu akal bako ba á bele no.<verse eid="GEN 28:9" /></para>
  <para style="s">Nlem nyi Jekob go Betel</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />Jekob kehm mehle o Beerseba asongo go Haran. <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />Eji á song rehng edi ajehng, á kehm sake kang o, tibre njul eblahm. Á kehm rodo eltal bum noongo kunu esi lal. <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />Á leeme nlem nyi á nyehne elkpakengbe ni jahme go ndi, lab tete rehng go elbung. Enjel nya Esowo jo wahre go elkpakengbe nio, bako jo badde na. <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />Go ero elkpakengbe nio, Jehova yiimi o. Á kehm bungu re, &lt;&lt;Me wo li Jehova, ji li Esowo bi Ebraham nso, a bi Aisik. M bahk-a kake ndi nyi a nong a, a etˈtohngo eja. <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />Etˈtohngo eja bahke jolo ana erikehndi go nrur, a bahke nyange, je go erede nfam, a ero nfam, go ejang ebobkal, a ejang eboblum. Go ega abo, a abo nya abon eba, wo anebe njini kpee bahke sehnge bel elfuulu. <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />Me n li a na. M bahke jo baab-a edi ajehng ajehng ji a je no, m bahke feere a na ba go ndi nyia. Me wa nehm yake, tete n lim jio ji m ma nyam tong-a.&gt;&gt; <verse eid="GEN 28:15" /><verse number="16" style="v" sid="GEN 28:16" />Eji Jekob nyahme go ellu, á kehm bungu go ege eltim re, &lt;&lt;Etingitingi Jehova li edi jia, jol me n kahnem.&gt;&gt; <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />Á jo fˈfahl, kehm bungu re, &lt;&lt;A wo li emennge emennge edie! Jol a edidi sang, etahk Esowo ji. A mbuga mi ejahbetul Esowo mi.&gt;&gt; <verse eid="GEN 28:17" /><verse number="18" style="v" sid="GEN 28:18" />Efungfu behre behre bi etoono efung, Jekob kehm rodo eltal ni á noongo no kunu esi, fere jahm ana ego, kehm yaange akehng wohngo ero eltal nio. <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />Á lungu edi jio re Betel<note caller="+" style="f"><char style="fr" closed="false">28:19 </char><char style="ft">Betel lohngo re etahk ji Esowo</char></note>, wo wuku wuku bo jo lungu ejahbe jio re Lus. <verse eid="GEN 28:19" /><verse number="20" style="v" sid="GEN 28:20" />Owo Jekob kehm nyame enyam re, &lt;&lt;Esowo lˈjol aname, fere baab-m go eljen ni n fi a, fere ka-m nsol alehke re me n li, a nsol ebjing re me n kak, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />tete n feere nseenga nseenge ba go etahk nsoo, Jehova bahke jolo Esowo ebame. <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />Eltal nia ni m ma jahm a, ana ego, bahke jolo etahk Esowo, nsol nyi a bahk-m kake kpee, m bahk-a kake ejum ajehng go nsol ewubu.<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">Jekob rehnge go Padan Aram</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />Jekob kehm soro asi go ege eljen tete a ba rehng go ndi nyio nyi anebe ero nfam. <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />Owo á kehm nyehne elbing alahb go emahng, a nlong ejoro na era nya noongo o, tibre owo bo jo ka enyam alahb elbing nio. Eltal ni bo ko bulu nnyo elbing alahb nio jolo egburu eltal. <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />Ngare nyi bo ma ko ejoro kpee ba wane o, mbaabe ebul kehm bannge eltal nio lennge nnyo elbing alahb, bo ka ejoro alahb, kehm kpe feere a eltal nio bulu. <verse eid="GEN 29:3" /><verse number="4" style="v" sid="GEN 29:4" />Jekob kehm bahbe abaabe ebul re, &lt;&lt;Abonanee, gan wo ń lohng no?&gt;&gt; Bo kehm-e faange re, &lt;&lt;Wahr lohng go Haran.&gt;&gt; <verse eid="GEN 29:4" /><verse number="5" style="v" sid="GEN 29:5" />Á kehm kpe bahb bo re, &lt;&lt;N kpˈkahne Leban ji mmona Nahor jel-e noa?&gt;&gt; Bo kehm faange re, &lt;&lt;Ee, e kp-e kahne.&gt;&gt; <verse eid="GEN 29:5" /><verse number="6" style="v" sid="GEN 29:6" />Owo Jekob kehm bahbe bo re, &lt;&lt;Ye noa nob noba?&gt;&gt; Bo kehm-e faange re, &lt;&lt;Ee, á noa nob nob, nyehn Rasel mmon ewe ga kpˈbake a ejoro. <verse eid="GEN 29:6" /><verse number="7" style="v" sid="GEN 29:7" />Á kehm tongo bo re, &lt;&lt;Njul ga kpeke li ero, ngare ka rehng nyi kehn enyam bahke ba kono edi ajehng, kaan ejoro alahb, wahn feere a bo, bo song li nsol.&gt;&gt; <verse eid="GEN 29:7" /><verse number="8" style="v" sid="GEN 29:8" />Bo kehm-e faange re, &lt;&lt;E nehm ma lim ano, tete bo lˈko atohkondi kpee ba edi ajehng fere bannge eltal nio lennge nnyo elbing alahb. Ngare nyio nyi e bahke ma ka bo alahb.&gt;&gt; <verse eid="GEN 29:8" /><verse number="9" style="v" sid="GEN 29:9" />Ana á kpi mbungu mbungu, ano wo Rasel kehm soro ba rehng a ejoro nde, tibre á jolo mbaabe ebul. <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />Eji Jekob nyehne Rasel mmona Leban ji jolo mmonannyehn no nnyehn ewe, a ejoro bi Leban, á kehm song bannge eltal nio lennge nnyo elbing alahb, fere ka ejoro Leban mmonannyehn nnyehn alahb. <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />Owo Jekob kehm bingi Rasel, fere kehm kehme ellingi wahre wahre. <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />Ngare nyio yebtong Rasel re ye ekunu nde ji, fere tong-e re ye mmon no Rebeka wo. Á kehm beke song tong nde. <verse eid="GEN 29:12" /><verse number="13" style="v" sid="GEN 29:13" />Ana Leban wuku bada Jekob mmona mmonannyehn, á kehm soro be song wan-e. Á kehm-e kake nnyo fere bing-e, kehm-e soro ko ba go ege etahk. Owo Jekob kehm-e tongo nsol kpee bade elkpin ene. <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />Owo Leban kehm-e tongo re, &lt;&lt;Wo a me alung amehng ma.&gt;&gt;</para>
  <para style="s" vid="GEN 29:14">Jekob koo Lia a Rasel go elbal</para>
  <para style="p" vid="GEN 29:14">Eji Jekob ma kang a Leban nnyahng kohro kohro, <verse eid="GEN 29:14" /><verse number="15" style="v" sid="GEN 29:15" />Leban kehm bungu tong-e re, &lt;&lt;Anv, a bahk-m lohko loko na loko a na mbol mbol tib esi ji a li ekunu ejama? Tong-m ekun eba, ana m bahk-a jo kpi. <verse eid="GEN 29:15" /><verse number="16" style="v" sid="GEN 29:16" />Leban bele abon abal ba nkal. No nkul bo jo lung-e re Lia, no nse bo jo lung-e re Rasel. <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />Lia kpoolo amahr, wo Rasel jolo nkpooda ngbahme, fere nˈnob. <verse eid="GEN 29:17" /><verse number="18" style="v" sid="GEN 29:18" />Rasel wo jo kor Jekob. Á kehm bungu re, &lt;&lt;M bahke limi eltum ka-a go nnya esehma, eji a lˈka-m Rasel, mmon ewa no nse.&gt;&gt; <verse eid="GEN 29:18" /><verse number="19" style="v" sid="GEN 29:19" />Leban kehm bungu re, &lt;&lt;Ga nob re me n ka-a ye, sehnge re me rod-e ka nne nondiki. Jol aname a.&gt;&gt; <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />Owo Jekob kehm loko Leban nnya esehma, eji á lˈko Rasel, jolo na are abon afung ba ka Jekob, tib go elkoro ni Rasel jo kor-e. <verse eid="GEN 29:20" /><verse number="21" style="v" sid="GEN 29:21" />Owo Jekob kehm bungu tong Leban re, &lt;&lt;Ka-m nkal ewame. Ngare enyame ebbiingi, n kpˈsebe re me n noongo a ne.&gt;&gt; <verse eid="GEN 29:21" /><verse number="22" style="v" sid="GEN 29:22" />Leban kehm lungu ane ba lene ejahbe re bo ba, kehm ba lim elkak elbal. <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />Elgung ba kan a me, á kehm rodo Lia, mmon ewe no nkul ka Jekob, Jekob soro noongo a ne. <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />Leban rodo monse nkal no jolo nlokeltum ewe, no bo jo lung-e re Jilpa, ka mmon ewe re á jol nlokeltum ewe. <verse eid="GEN 29:24" /><verse number="25" style="v" sid="GEN 29:25" />Efungfu se kan a me, nyehn Lia nong a Jekobe! Jekob kehm bungu tong Leban re, &lt;&lt;A elkohn ejum ajii á ma-m lim ana? Rasel sang n lok-a no re wo ka-m yea? Jenji wahnge á ma-m nehm?&gt;&gt; <verse eid="GEN 29:25" /><verse number="26" style="v" sid="GEN 29:26" />Owo Leban kehm-e faange re, &lt;&lt;Go egahre eljini, e kpehme gbo mbang rod mmon no nse ka go elbal, kehm tange mmon no nkul. <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />Nong erahde ji elkak elbal nia mal, owo e bahk-a kake Rasel a lˈkpe lim eltum go nnya esehma. <verse eid="GEN 29:27" /><verse number="28" style="v" sid="GEN 29:28" />Jekob lohko lim ano. Eji á ma mal erahde ji elkak elbal Lia, owo Leban kehme kake Rasel mmon ewe go elbal. <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />Leban rodo monse nkal no jolo nlokeltum ewe, no bo jo lung-e re Bilha ka Rasel mmon re á jol nlokeltum ewe. <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />Owo Jekob kehm tob noongo a Rasel, á jo kor-e sehnge Lia. Á kpe lim eltum ka Leban go nnya esehma.<verse eid="GEN 29:30" /></para>
  <para style="s">Abon ba Jekob</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />Eji Jehova nyehne no re Lia joom kor nlum we, á kehm-e lennge ala njel. Rasel jolo ngum. <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />Lia kehm sake ela, jel mmon no nlum. Á gung-e mbing re Ruben<note caller="+" style="f"><char style="fr" closed="false">29:32 </char><char style="ft">Ruben mbing nyi lohng re yebnyehn erem ebame</char></note>, tib á bungu re, &lt;&lt;Jehova ebnyehn erem ebame. Anv, m bahke lohko kor nlum ewame.&gt;&gt; <verse eid="GEN 29:32" /><verse number="33" style="v" sid="GEN 29:33" />Á kehm kpe sa ela. Á jele kan mmon no nlum a, á kehm bungu re, &lt;&lt;tib Jehova wuku re n nehme kor nlum ewame, ji ji wahnge á ma-m kpe ka mmon noa.&gt;&gt; Wahng ka á lung-e re Simion.<note caller="+" style="f"><char style="fr" closed="false">29:33 </char><char style="ft">Simion lohngo re nne no kpo wuk</char></note> <verse eid="GEN 29:33" /><verse number="34" style="v" sid="GEN 29:34" />Á kehm kpe sa ela behko. Eji á jele mmon no nlum, á kehm bungu re, &lt;&lt;Anv, nlum ewame bahke jolo bad bad aname, tibre me n jel abon ara ba nlum ka-e.&gt;&gt; Bo gung-e mbing re Levayi.<note caller="+" style="f"><char style="fr" closed="false">29:34 </char><char style="ft">Levayi lohngo re ebba jol bad bad</char> </note> <verse eid="GEN 29:34" /><verse number="35" style="v" sid="GEN 29:35" />Á kehm kpe sa ela. Eji á jele mmon no nlum, á kehm bungu re, &lt;&lt;Anv, m bahke tehke Jehova.&gt;&gt; Owo á kehm-e gungu mbing re Juda.<note caller="+" style="f"><char style="fr" closed="false">29:35 </char><char style="ft">Juda lohngo re tehk</char></note> Á kehm rahke njel.<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />Eji Rasel nyehne re á nehme jel mmon awohng awohng ka Jekob, á bele eteelala a mmonannyehn, á kehm bungu tong Jekob re, &lt;&lt;Ka-m abon, tohko jol ano, m bahke kpoko!&gt;&gt;<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />Jekob atahng kehm-e rake tob-e, á kehm-e tongo re, &lt;&lt;Me wo ma ko nji nyi Esowoa, ye ji ma-a lim re wo kˈjel-a? <verse eid="GEN 30:2" /><verse number="3" style="v" sid="GEN 30:3" />Owo Rasel kehm bungu re, &lt;&lt;Nyehn Bilha nloketum ewame ga, song kang a ne eji á lˈjel abon ka-m, toono o ege n tob bom ebangennahb.<verse eid="GEN 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 30:4" />Rasel kehm yake Bilha á jol nkala Jekob, Jekob kehm song kang a ne, <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />á kehm sake ela jel mmon no nlum ka-e. <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />Owo Rasel kehm bungu re, &lt;&lt;Esowo ebkim eno ka-m, fvfo yeb wuk elgboongo ename, fere ka-m mmon no nlum.&gt;&gt; Tib esi jia, á gung-e mbing re Dan.<note caller="+" style="f"><char style="fr" closed="false">30:6 </char><char style="ft">Dan lohngo Esowo ebkim eno ka-m</char></note> <verse eid="GEN 30:6" /><verse number="7" style="v" sid="GEN 30:7" />Bilha nlokeltum a Rasel kehm kpe sa ela, jel etoono mmon no nlum ka Jekob. <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />Owo Rasel kehm bungu re, &lt;&lt;Me n bel egburu enok a mmonannee no nkal, me n nok ga, Rasel kehm-e gungu mbing re Naftali.<note caller="+" style="f"><char style="fr" closed="false">30:8 </char><char style="ft">Naftali lohngo re enok ebame</char></note><verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />Eji Lia nyehne re yeb rahke njel, á fere rod nlokeltum ewe no nkal Jilpa ka Jekob á jol nkal. <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />Nlokeltuma Lia, Jilpa jele mmon no nlum ka Jekob. <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />Lia kehm bungu re, &lt;&lt;A wo li enobesi.&gt;&gt; Á kehm-e gungu mbing re Gad.<note caller="+" style="f"><char style="fr" closed="false">30:11 </char><char style="ft">Gad lohngo re enobesi</char></note><verse eid="GEN 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 30:12" />Nlokeltuma Lia, Jilpa kpe jel etoono mmon no nlum ka Jekob. <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />Lia kehm bungu re, &lt;&lt;Elkohn eyebatahng ji m ma bel ji nse sang. Anebkal bahke jo lung-m re, eyebatahng. Owo wahnge á gung-e mbing re Aser.<note caller="+" style="f"><char style="fr" closed="false">30:13 </char><char style="ft">Aser lohngo re eyebatahng</char></note><verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />Ngare nyi bo jo kiimi nkohl nyi bo kpo lung re wid, Ruben kehm tahme je go emahng song wob eti ji bo kpo lung re mandrak<note caller="+" style="f"><char style="fr" closed="false">30:14 </char><char style="ft">Mandrak lohngo eti ji kpo lim nnenkal jel tob li eti elkoro</char></note> ba ka nnyehn Lia, Rasel kehm tongo Lia re, &lt;&lt;Titi tob yehke abon mandrak mmon ewa ka-m me.<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />Lia kehm-e faange re, &lt;&lt;Wa-a ka tiki gbal eji a ma-m taare nluma? A bahke kpe taare mandrak nyi mmon ewama? Rasel kehm bungu re, &lt;&lt;Ebnob sehng, atv ma lela nong á kang ega tib esi eti mandrak mmon ewa.<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />Eji Jekob kehnge egbe ba elgung, Lia kehm song kpir-e, kehm-e tongo re, &lt;&lt;Lela a bahke kange ename, tibre me n ko eti mandrak mmon ewame ka ekun re wo kang aname. Jekob lohko kang a ne atv mao.<verse eid="GEN 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17" />Esowo wˈwuk ji Lia bungu no, á sa ela jel mmon no nlum ka Jekob no biingi abon alon. <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />Lia kehm bungu re, &lt;&lt;Esowo ma-m tuuru eji m ma ka nlum ewame nlokeltum ewame no nkal.&gt;&gt; Owo á kehm-e gungu mbing re Isakar.<note caller="+" style="f"><char style="fr" closed="false">30:18 </char><char style="ft">Isakar lohngo re eltuuru</char></note><verse eid="GEN 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 30:19" />Lia kehm kpe sa ela jel mmon no nlum ka Jekob, mmon noa wo biingi abon nlum na arakera. <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />Owo Lia kehm bungu re, &lt;&lt;Esowo ma-m yare ka ayare nya nno. Anv nlum ewame bahk-m kpunu, tibre me n jel abon arakera ba nlum ka-e.&gt;&gt; Lia kehm-e gungu mbing re Jebulon.<note caller="+" style="f"><char style="fr" closed="false">30:20 </char><char style="ft">Jebulon lohngo re ekpunu</char></note><verse eid="GEN 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 30:21" />Eji kpe kang a, Lia kpe jel mmon no nkal, bo jo lung-e re Dayina.<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />Esowo kehm buumu Rasel, wuung-e atung, fere lennge ejˈjele eje. <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />Á sa ela jel mmon no nlum, á kehm bungu re, &lt;&lt;Esowo ma-m yehke go ndon.&gt;&gt; <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />Á gung-e mbing re Josef,<note caller="+" style="f"><char style="fr" closed="false">30:24 </char><char style="ft">Josef lohngo re nong á kpe budu</char></note> kehm bung re, &lt;&lt;Nong Jehova kpe-m budu mmon no nlum nondiki.&gt;&gt;<verse eid="GEN 30:24" /></para>
  <para style="s">Atohkondi nya Jekob kpe gbal na budu</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />Eji Rasel jele Josef, Jekob kehm tongo Leban re, &lt;&lt;Tum-m me n song kehnge go egame ejahbe. <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />Ka-m akal ebame, a abon abon, bo ba wahnge m ma-a loko, me n tahm ejame. A kpˈkahne elkohn eltum ni m ma lim ka-a.<verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />Leban kehm-e tongo re, &lt;&lt;Lˈjol re a kpˈkpi eyebatahng aname, titi tohko kpe jol aname, tibre me bu kahn re, Jehova ma-m fuulu tib esi eja. <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />Á kpe bung budu re, &lt;&lt;Tong-m ana m bahk-a kpiki, me n kpi-a.&gt;&gt;<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />Jekob kehm-e tongo re, &lt;&lt;Wob kahn eltum ni m ma lim ka-a, ana atohkondi enya li nob nob, fere nyˈnyab go egame abo. <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />Atohkondi enya jolo ntiil, anv bob rur gbalee, Jehova ma-a fuulu go edi ajehng ajehng ji m ba jol. Anv, ngare anyii fuumu re me n tob bom ejum alimi ka elname?<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />Leban kehm-e tongo re, &lt;&lt;Anv me n ka-a jen? Jekob kehm-e faange re, &lt;&lt;Kama ka ejumjum.&gt;&gt; A lˈfere lim ejum ajehng jia ka-m, m bahke soro asi jo le atohkondi enya, fere jo kpur bo. <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />Nong lela me n feede go ellong atohkondi enya kpee, fere jak ejoro bi kpi anyono, a bo ji kpi adebbe, a abon njoro ba kpˈremme, a ebul bi kpi anyono, a bo ji kpi a adebbe, bo ba bahke jolo nsehng enyame. <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />Behnjehle, ngare anyehng anyehng nyi a lˈba nyehn ana a kpi-m no, a bahke kahne re n jolo etingi nne. Mbul baange anyehng anyehng nyi li nyˈnyame, nyi ki kpi anyono, afii adebbe, afii mmona njoro awohng awohng no ki remme, bahke lohngo re me n v na.<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />Leban kehm bungu re, &lt;&lt;Me n taame, nong jol ana a ma bung.&gt;&gt; <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />Efung bˈnehm o Leban kehm yehke afahmbul kpee nya kpi anyono, a ba bele adebbe, a ebul baange kpee bi kpi adale, a bi kpi adebbe, bo ji kpi abarebare adale, a ejoro kpee bi kpˈremme, faake abo kpee kak abon ebe go abo. <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />Leban a abon ebe mehle eljen ejum nfung era, tahm Jekob sa edi ji á jolo no. Jekob sa soro asi jo kpur erik atohkondi nya Leban.<verse eid="GEN 30:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37" />Fvfo Jekob song kiimi ajoobo abˈbo nti, go nti nyi bo kpo lung re poplar, Almon, a eplen, go abˈbo nyao kpee, laade akpake nyandiki, eji bo lˈnyehn nnyam eti nyi kpˈbare go elatahk. <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />Á kehm rodo abˈbo nyao kpee song bum kohlo go ejum ji atohkondi nyao kpo wo alahb, eji lˈjol songo songo wane go ebo mbuksong atohkondi, ngare nyi atohkondi kpo ba alahb wo owo bo kpo kuumu atemtem, <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />bo kpo ba gbehl abˈbo nyao go mbuksong jo kuumu atemtem, jo jel abon ba kpi anyono, adebbe, a adale. <verse eid="GEN 30:39" /><verse number="40" style="v" sid="GEN 30:40" />Jekob rodo abon mbul bao bum eje eje, á limi bo jehko kpee jo seenge atohkondi nya Leban nya kpi anyono, a remme, eji bo jo kuumu atem. Ano wo á limi no yehke atohkondi nya bahke jolo ka-e á semmem bo go ellong enyam bi Leban.<verse eid="GEN 30:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 30:41" />Ngare anyehng anyehng nyi atahntahn enyam bi nkal, lˈba elkuumu atemtem, Jekob jo rodo abˈbo nti nyao yahke go edi ji bo kpo wo alahb, go ebo esamahr, eji bo kpˈkuumu atemtem kohlo abˈbo nti. <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />Wo lˈfere jol re enyam bio eko bo kpimm, Jekob nehm sahd abˈbo nyao o. Ano wo bo ji ki bel eko jo jol ba Leban, bo ji jolo eko eko jol ka Jekob. <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />Go mbang nyia nyi Jekob koo gbo afang, nya sahb gbˈgbal, fere bel ellong atohkondi, alokeltum ba nkal, a ba nlum, akamel, a ebvankang.<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s">Elbeke ni Jekob be goji Leban</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />Jekob kehm wuku re, abone Leban ba nlum kpˈbungu re, &lt;&lt;Jekob ebrod ejum ajehng ajehng ji nsoo ewahre kpi no, afang kpee nya Jekob ma bel, lohng go nsol nyi nsoo ewahre, <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />Jekob sebe kahn re eljini ni Leban jolo a ne wuku wuku, anv ebyaange. <verse eid="GEN 31:2" /><verse number="3" style="v" sid="GEN 31:3" />Jehova kehm tongo Jekob re, &lt;&lt;Feere song go ndi a nso, go nnahb enya, m bahke jolo a na.&gt;&gt;<verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />Owo Jekob kehm tumu ellum tv Rasel abola Lia re bo lohng ba kpir-e go emahng edi ji atohkondi enye li no. <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />Á kehm tongo bo re, &lt;&lt;Me n seb kahn re eljini ni nso ewahne kpi no aname anv ebyaange, kpeem li ana wuku wuku jolo no, wo Esowo bi nso ewame noa aname. <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />Wahn kpˈkahne re me n lim eltum ka nso ewahne a eko eko ejame, <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />jol tvtv o, nso ewahne ma-m nehm fere yaange eltuuru ename nkpel na ewubu. Wo Esowo taamem re á lim-m ejum. <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />Leban lˈfere tong re atohkondi nya kpi adale nya nya li eltuuru ename, atohkondi kpee jo jele nya kpi adale, afi á fere tong re bo ji kpi anyono, bo ba li eltuuru ename, atohkondi kpee jo jele bo ji kpi anyono. <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />Owo wahnge Esowo ma taare nso ewahne atohkondi feere a nya ka-m.<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />Ngare nyi atohkondi kpo sa ela, n leeme nlem n nyehne re, afahmbul nya jo kuumu ebul baange bo bele anyono, adebbe, a adale. <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />Enjel nyi Jehova tong-m go nlem re, &lt;Jekob,&gt; N kehm faange re, &lt;Nyehn me ga.&gt; <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />Enjel nyio kehm bungu re,&lt;&lt;Seenge wo nyehn re, afahmbul kpee nya kpˈkuumu akal, bo jehko bahke bele anyono, bo jehko bel adebbe, bo jehko bel a adale, tibre me n nyehn nsol kpee nyi Leban jo lim-a. <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />Me wo li Esowo bi Betel, edi jio ji a wohngo akehng go ego, jˈnehm ji a nyame no tong-m. Tahm anv anv wo yake ndi nyia, fere song go ega ejahbe.&gt;&gt;&gt;<verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />Owo Rasel abola Lia kehm faange re, &lt;&lt;Fono anv wahr kpˈkpe kpi ebo abehng abehng go nsol elehke elkv nyi etahk nsoo ewahr-a? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />Anv, á wahr kpehme ko ana ajahmjahma? Saam go elgungu no á ma-r gungu, yeb tob li kpee ji bo ka go egahre esi. <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />Etingitingi ji re nsol afang nyi Esowo ma taare nsoo ewahre li ka wahr a abon ebahre. Fvfo lim ajehng ajehng ji Esowo tong-a no.<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />Owo Jekob kehm rodo abon ebe, a akal ebe kunu go akamel, <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />tahm a bo, atohkondi enye gbo-e mbang, á tahma nsol kpee nyi á bele no o Padan Aram, asongo goji nde Aisik go ndi nyi Kenan. <verse eid="GEN 31:18" /><verse number="19" style="v" sid="GEN 31:19" />Eji Leban tahme re á song kpud ejoro ebe anyar, Rasel v alokelom etahk nde. <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />Fvfo Jekob nehme Leban nnea Aram eji á ki-e tong re, á kpˈtahme. <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />Jekob bee a nsol kpee nyi á bele no, song siiri aya Yufrat, asongo go ejahbe ewong ji Gilied.<verse eid="GEN 31:21" /></para>
  <para style="s">Leban mehle jo kam Jekob</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />Go nfung era, bo kehm tongo Leban re Jekob ebbe fio. <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />Leban kehm rodo abonanyehn ebe, bo jo kam Jekob go nfung na esehma song bob-e go ejahbe ewong ji Gilied. <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />Esowo kehm ba kpiri Leban nne no lohng go Aram go nlem atv, kehm-e tongo re, &lt;&lt;Kunu ekpu, ka tiki bung ejum ajehng ajehng bada Jekob, afi jolo ji kpˈnobo, afi ji kpˈsabe.&gt;&gt;<verse eid="GEN 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 31:25" />Jekob tohko si ebehre eje go ejahbe ewong ji Gilied, Leban kehm ba kpir-e. Leban a abonanyehn kehm tob ba si abehre nya bo o. <verse eid="GEN 31:25" /><verse number="26" style="v" sid="GEN 31:26" />Owo Leban kehm tongo Jekob re, &lt;&lt;Jenji wahnge a ma-m lim ana me? A ma-m nehm, wob kpu abon ebame, ana nne bobo ane go ebta ba bum eju. <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />Nˈnan a kehm weele na be fere nehm-m, nˈnan a ki-m tong eji n lˈtuma go eyebatahng, a ekahn ase ji bo jol jo kub asoongo, a akpasake toon-a. <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />Jol a nongem re me n bingi abon abon ebame nnyo, a yefono abon ebame ba nkal, fere tong bo re wahn songo. Woblim egboongo ejum. <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />N kpˈkpi nsahm nyi m bahk-a ma lim ejum, wo nyaane atv Esowo bi nso tong-m re, &lt;&lt;Kunu ekpu, ka tiki bung ejumjum bada Jekob, afi jolo ji kpˈnobo, afi jolo ji kpˈsab. <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />Anv wob tahm eja, tibre ma-a kor re wo feere go etahk nso, jenji wahnge a kehm vohko asowo enyame? <verse eid="GEN 31:30" /><verse number="31" style="v" sid="GEN 31:31" />Jekob kehm faange Leban re, &lt;&lt;N jo fˈfahl, tibre n tiri re a bahk-m taare abon eba ba nkal go eko. <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />A lˈfere nyehn nne awohng awohng no rodo asowo enya a bahke kpoko. Go ellong nnahb enyame, kpur antahng wo nyehng joare ejum eja ajehng ajehng jia aname, lˈfere jol ano rod. Jekob kahnem re Rasel wo v asowo nyao. <verse eid="GEN 31:32" /><verse number="33" style="v" sid="GEN 31:33" />Leban kehm yele ebehre ji Jekob, a ji Lia, go ji aloketum abal bao ba nkal, ejumjum á nyˈnehm. Eji á lohngo go ebehre ji Lia, á kehm song yel goji Rasel. <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />Ngare nyio Rasel ebrod asowo etahk nde kunu go njahm nyi ekamel rod ejum bo kpo koongo ekamel go njahm bulu ji tv. Leban feede ejum ajehng ajehng o ebehre kpee á nyehnem ejumjum.<verse eid="GEN 31:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 31:35" />Rasel kehm tongo nde re, &lt;&lt;Atahng ki-a rak nsoo re m maam mehl yiimi go ega esamahr, me ga me n gbo alung.&gt;&gt; Leban feede kpee á tikem nyehn asowo etahk eje. <verse eid="GEN 31:35" /><verse number="36" style="v" sid="GEN 31:36" />Jekob atahng kehm-e rake, á rod Leban song kak elam, kehm bahbe Leban re, &lt;&lt;Ebi ajii m ma lim? Abiafem anyaa m ma lim, nya wahnge a kp-m bimi abake? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />Anv eji a feede go egama nsol, jenji a ma nyehn ji lohng go ega etahk? Lohng aji a esamahr nnahb enyame, a nnahb enyame, bo lam-r, me a wahra na. <verse eid="GEN 31:37" /><verse number="38" style="v" sid="GEN 31:38" />Me n jol a na go nnya na eltahl, ejoro eba, a ebul eba, anyehng anyehng tikem fumu, jol n tikem li nkom anyehng anyehng go ellong atohkondi enya. <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />N tikem ko nnyam enya anyehng anyehng ba a nyi re, ebi nnyam me-e jaake, me wo jo nyehn erem bio antahn, anv a kpˈsebe re me n gal-a ji bo v a njul afii bo v atv. <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />Ji jo jol aname ji a, njul jo ya-m ngara njul, alohk jo fil-m ngare atv, ellu n joom lal. <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />Ana wo jolo aname go ejum nnya eltahl nyi n jolo go ega etahk. N limi eltum ka-a go ewuba nnya eni tib abon eba ba nkal, fere kpe ko nnya erakera jo kpur atohkondi enya, á fere yaange eltuuru ename nkpel na ewubu. <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />Ki li re Esowo bi nsoo, Esowo bio bi Ebraham, ye ji Aisik jo fahl-e ki jol aname, a jol-m lohko tum n kehnge abo abo. Wo Esowo ebnyehn ana jo riid-m, fere jo nyehn ji n jo ko abo enyame lim, atv ma nyaane Esowo kak-a erehke.&gt;&gt;<verse eid="GEN 31:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />Leban kehm faange Jekob re, &lt;&lt;Anebkal baa abon ebame ba nkal ba, abon baa, abon abon ebame ba, atohkondi nyaa, atohkondi enyame nya. Nya a kpˈnyehne a kpee a nyame nya, fono anv jenji m bahke limi lela a abon ebame ba nkal, afi abon ba bo ma jel? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />Anv wahr lim egbanngalung, jol ejum ntianse ka wo, a me.&gt;&gt;<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />Owo Jekob kehm rodo eltal lo ana ego. <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />Jekob kehm tongo nnahb enye re, &lt;&lt;Kpu-n atal ba a nya, bo kehm solo atal ba luk ebim, bo ji go nkpe ebim atal jo li nsol. <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />Leban lungu edi jio re, Jegar Sahaduta,<note caller="+" style="f"><char style="fr" closed="false">31:47 </char><char style="ft">Jegar Sahaduta lohngo go Aramaik re Elbum ntianse</char></note> Jekob tob lungu edi jio re, Galed.<note caller="+" style="f"><char style="fr" closed="false">31:47 </char><char style="ft">Galed go Hibru lohngo re Elbum ntianse</char></note> <verse eid="GEN 31:47" /><verse number="48" style="v" sid="GEN 31:48" />Leban kehm bungu re &lt;&lt;Ebim atal jia ebjol ntianse ka me a wo lela.&gt;&gt; Owo wahnge bo jo lung re Galed. <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />Fvfo bo jo tob lungu re Mijipah,<note caller="+" style="f"><char style="fr" closed="false">31:49 </char><char style="ft">Mijipa lohngo re nkahm bungubungu etahk ji bo kpo kuumu baabe</char></note> tibre á bungu re, Nong Jehova jo baab-r eji e ma yaame atemtem. <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />A lˈfere sab abon ebame ba nkal go elfili, afii a lˈsong ko akal bandiki sehnge abon ebame baa ba nkal jol afi nnene jolem, buumu re Esowo bi li ntianse enya, a me.<verse eid="GEN 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 31:51" />Leban tob tongo Jekob re, &lt;&lt;Nyehn ebim atal ga, tob nyehn eltal ga m ma lo ana ego ka wo a me. <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />Ebim atal jia ji li ntianse, ego jia ji tob li ntianse re me nehm tiki siiri ebim atal jia rehng ega ejang ba lim-a ejum, re wo fvfo, a nehm siiri ebim atal jia a, a ego jia ba rehng ga egame ejang ba lim-m ejum. <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />Nong Esowo bi Ebraham, a Esowo bi Nahor, Esowo bio bi babnde ebo lam-r a wahra na.&gt;&gt;</para>
  <para style="p" vid="GEN 31:53">Owo Jekob kehm koko nwongo go mbing nyio nyi Esowo bio bi Aisik nde kpo fahl. <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />Jekob limi njom o ejahbe ewong, fere tiingi nnahb enye re bo ba li nsol. Eji bo ba li nsol bo sa kang o atv mao.<verse eid="GEN 31:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 31:55" />Njahm efungfu, efungfu behre behre Leban kehm bingi abon abon ebe, a yefono abon ebe ba nkal fere fuulu bo, kehm feere kehnge.<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">Jekob toobo ebjing bi a bahke song wane Eso</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />Jekob kehm tob tahm eje, babenjel nya Esowo kehm-e kpiri go mbang. <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />Eji Jekob nyehne bo, á kehm bungu re, &lt;&lt;A wo li ebehre ji Esowo.&gt;&gt; Á kehm lungu edi jio re Mahanayim.<note caller="+" style="f"><char style="fr" closed="false">32:2 </char><char style="ft">Mahanayim lohngo re Ebehre ebbal</char></note><verse eid="GEN 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3" />Jekob tumu atiingi etib re bo gbo-e mbang tv Eso mmonannyehn, go ndi nyi Seir ji li ejahbe ji Edom. <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />Á tubu bo elle re, ana wo ḿ bahke tongo nsoo ewame Eso: &lt;Jekob nlokeltum ewa re, me n jol a Leban, fere sa a ne tete rehng anv. <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />Me n bel efong, ebvankang, ejoro, ebul, alokeltum ba nlum, a ba nkal. Anv n kpˈtumu etib tv wo ntubesi ewame, re me lub fil-a ndon go ega esamahr.<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />Eji atiingi etib feere no ba kpiri Jekob, bo tong-e re, &lt;&lt;Wahr ebje goji Eso mmonanne, anv á kpˈbake ba kpir-a, a aneblum atahltahl ba kp-e toono.&gt;&gt; <verse eid="GEN 32:6" /><verse number="7" style="v" sid="GEN 32:7" />Jekob bele egburu elfahle gbalee,eko fere jo tane, owo á kehm yabe ane ba jolo a ne go nlong na ebal, á tob yabe ebul ebe, akamel, a ebvankang. <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />Á tiri re, &lt;&lt;Eso lˈfere ba nok a ellong anehng, ellong ni lˈsa, bo lub be for.<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />Owo Jekob kehm kake ero re, &lt;&lt;O Esowo bi nsoo Ebraham, Esowo bi nsoo Aisik, O Jehova, wo ji tong-m re, &lt;Feere song go ega ejahbe, go ega ebangenahb, m bahke limi nob a na.&gt; <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />Me n tohkem fˈfuumu go nnoobo eljini, a ekakesehk ji a ma tib me nlokeltum ewa, m bele ebti efilebo bi bi, eji n siiri aya ma Jodan maa, wo anv me n jol nlong ebal. <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />N kpˈkake ero re, wo tahr-m go abo nya mmonanee Eso, tibre n kpˈfahle re á bahke ba nok aname, tob nok a bab nnyehn, a abon abon. <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />Wo wo ma bung re, &lt;Etingitingi m bahke limi nob a na, m bahke fere lim etˈtohngo eja jol ana erikehndi aya bi nnene lˈkˈma fange.&gt;&gt;&gt;<verse eid="GEN 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />Jekob kange o atv mao, nsol enye nyi á bele no, á yehke o re á song yare mmonannyehn Eso: <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />ebul baange atahl awubu, efahmbul eltahl, ejoro atahlawubu, ekom eltahl, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />eltahl ekamel ebwubu bi jolo akal budu abon, edahmagbudu atahl abal, nfong ewubu, akal ebvankang jolo eltahl, alum jolo ewubu. <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />Jekob yake bo kpee kak alokeltum ebe go ebo re bo jo kpur bo, nne awohng awohng no jo jen a bo, bele ellong nˈne, á kehm tongo alokeltum ebe re, &lt;&lt;Gbo-m wahn mbang, jo jenen wahn jo ka ane baa, a enyam eyake.&gt;&gt;<verse eid="GEN 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 32:17" />Á tubu nne no gbo bo mbang elle re, &lt;&lt;Mmonanee Eso lˈkpir-a fere bahb re, &lt;Wo li ka nne awoo, fvfo gan wo a kpˈtahme? Nne awoo kpi enyam bi li-a go mbuksong o?&gt; <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />Á bahk-e tongo re, &lt;&lt;Enyam bio bi Jekob nlokeltum ewa bi, ayare nya á ma tum tv ntubesi ewe Eso nya a. Yefono kpˈbake go njahm. <verse eid="GEN 32:18" /><verse number="19" style="v" sid="GEN 32:19" />Jekob tob tubu etoono ane abal, a etoono ane ara elle, a ane bako kpee ba kpˈtoono ane ba kpo jen a enyam re, &lt;&lt;Wahn ane kpee bungen nnyo nnyo amehng tong Eso ń lˈwan-e go mbang. <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />Jo kunen ekpu wahn bung re, &lt;Yefono Jekob nlokeltum ewa kpˈbake toon-r go njahm. Jekob jo tiri re, &lt;&lt;M bahk-e gono go ayare nya n kpˈtumu tv-e, n lˈnyehne, fundiki á bahk-m koko.&gt;&gt; <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />Owo Jekob kehm tumu ayare nyao bo gbo mbang a nya, yefono sa kang o ebo ebehre.<verse eid="GEN 32:21" /></para>
  <para style="s">Elrahng bi Jekob noko a Esowo</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />Atv mao Jekob kehm mehle rod akal ebe na abal, a alokeltum ba nkal abal, go abon ebe, ewubu a mmon awohng, kpee ba nlum bo song siiri ebgba bi bo jo lung re Jabok. <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />Ngare nyi á ma tum bo siiri ebgba, á tob tumu nsol enye kpee. <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />Jekob sa ntahngtahng, owo nnenlum kehm ba gong ebrahng a ne tete efungfu se. <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />Eji nnenlum noo nyehne re á nehme mal a ne, á kehm kooro Jekob go ebrudu, ebrudu soro radde, eji á jo gong ebrahng a ne. <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />Nnenlum noo tong-e re, &lt;&lt;Nong me n song tibre efungfu yahke se.&gt;&gt;</para>
  <para style="p" vid="GEN 32:26">Jekob kehm faange re, &lt;&lt;Me wa-a nehm yake á song tete á fuul-m.<verse eid="GEN 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27" />Nnenlum noo kehm-e bahbe re, &lt;&lt;Mbing enya mee?&gt;&gt;</para>
  <para style="p" vid="GEN 32:27">Á kehm-e faange re, &lt;&lt;Me Jekob wo,&gt;&gt;<verse eid="GEN 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28" />Nnenlum noo kehm bungu re, &lt;&lt;Bo wa-a nehm kpe jo lung re Jekob, bo bahke fere jo lung-a re Isreel,<note caller="+" style="f"><char style="fr" closed="false">32:28 </char><char style="ft">Isreel lohngo re a gongo elrahng a Esowo</char></note> tibre wob nok a Esowo, tob nok a ane fere ga bo.&gt;&gt;<verse eid="GEN 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29" />Jekob kehm bungu re, &lt;&lt;Titi tong-m mbing enya.&gt;&gt; Nnenlum noo kehm bungu re, &lt;&lt;Jenji wahnge a kehm bahbe mbing enyame? Nnenlum noo kehm-e fuulu o.<verse eid="GEN 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30" />Owo Jekob kehm lungu edi jio re Peniel.<note caller="+" style="f"><char style="fr" closed="false">32:30 </char><char style="ft">Peniel lohngo re esamahr bi Esowo</char></note> Á kehm bungu re, &lt;&lt;Tibre me n nyehn Esowo gbul gbul gbuul, tvtv o yebkpe kuuru elkpin aname.&gt;&gt;<verse eid="GEN 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 32:31" />Njul rehnge ero tv-e o ana á sehnge Peniel, á fere jo feebe na tibre ebrudu ebradde. <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />Owo wahnge anebe Isreel kˈlˈli njahb nyi li kohlo ebrudu, tibre ebrudu bi Jekob rˈradde eji nnenlum noo koor-e kohlo o njahb ebrudu.<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">Jekob feere ba kpiri Eso</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />Jekob kehm tabe amahr nyehn Eso kpˈbake a aneblum atahltahl ebe, Jekob kehm yabe abon ebe, bako jolo a Lia, bako jolo a Rasel, bako jolo a alokeltum ebe ba nkal na abal. <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />Á tongo alokeltum ba nkal bao bo gbo mbang a abon ebo, Lia a abon ebe bo toono, Rasel abola Josef bo ba kahle njahm. <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />Yefono antahng gbo mbang, ana á jo jen asongo goji mmonannyehn á gongo go ndi nkpel esehma.<verse eid="GEN 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 33:4" />Eso bee song kpiri Jekob, fere bing-e, á kpehre abo go emel walle. Bo ane abal abal kehme ellingi. <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />Owo Eso kehm seenge nyehn anebkal a abon, kehm bahbe Jekob re, &lt;&lt;Ane a ba a, ba li a na?</para>
  <para style="p" vid="GEN 33:5">Jekob kehm faange re, &lt;&lt;Abon ba Esowo ma lim nnoobo ka me nlokeltum ewa ba a.<verse eid="GEN 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 33:6" />Owo alokeltum ba nkal a abon ebo kehm tob jeere ba kohl-e gong ndi. <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />Etoono, Lia a abon ba gong go ndi. Esˈkohro Josef a Rasel, bo fvfo tob ba gong ndi.<verse eid="GEN 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8" />Eso kehm bahbe re, &lt;&lt;Nlong atohkondi nyaa kpee nya m ma wane a lohngo renan?&gt;&gt;</para>
  <para style="p" vid="GEN 33:8">Jekob kehm faange re, &lt;&lt;Li tib eji ntubesi ewame lˈbel eyebatahng aname.<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />Eso kehm bungu re, &lt;&lt;Me n kpˈkpi wuku wuku gbalee mmonannee, bum ji a kpi no jol ka wofono antahng.<verse eid="GEN 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10" />Jekob kehm faange re, &lt;&lt;Eˈee, titi joare a kpˈkpi eyebatahng aname, ko ayare nyaa go egame abo. Re me n nyehn esamahr eba, li ana m ma nyehn esamahr bi Esowo, Anv eji a ma-m ko eyebatahng. <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />Titi ko ji bo ma ko ba bum-a go alata, tibre Esowo eblim nnoobo gbalee ka-m, me n bel nsol kpee nyi n kpˈsebe.&gt;&gt; Tib eji Jekob jo tiki ten, Eso kˈko nsol nyio.<verse eid="GEN 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />Owo Eso kehm bungu re, &lt;&lt;Nong wahr tahm, m bahke jene a na.<verse eid="GEN 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13" />Jekob kehm-e faange re, &lt;&lt;Ntubesi a kpˈkahne re abon kpˈseke, fvfo li re me n kpur ejoro, adahmagbudu nya kpˈyabe abon ebo, nne lˈga jen a bo elwaare jol efung kohro kohro enyam bia kpee bahke kpoko. <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />Ntubesi ewame wo gbo nloketum ewa mbang, m bahke jo jen bembem a enyam, a abon baa, tete m ba rehng goji ntubesi ewame go Seir.&gt;&gt;<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />Eso kehm bungu re, &lt;&lt;Nong me n tahm aneblum ebame bako sa-a a.&gt;&gt;</para>
  <para style="p" vid="GEN 33:15">Jekob kehm bungu re, &lt;&lt;Nsehng limm re wo kpe gbiingi elna&gt;&gt; N lub sebe na seb re ntubesi ewame bel eyebatahng a aname.<verse eid="GEN 33:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 33:16" />Owo Eso kehm bomo eljen ene efung bio asongo go Seir. <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />Jekob tob tahme go Sokod, go wo á song lim edi jol fere tob lim edi ji enyam ebe bahke jo kang. Owo wahnge edi jio bo jo lung re Sokod.<note caller="+" style="f"><char style="fr" closed="false">33:17 </char><char style="ft">Sokod lohngo re ebkpatahk</char></note><verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />Bomo ana Jekob lohng go Padan Aram á rehnge o ejahbe Sekem nob nob go Kenan ba sa jol go nkpe ejahbe jio. <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />Jekob gunu erohko ndi goji abone Hamor nde no Sekem ka akpohko asilva atahlalon. Owo á si ebehre ji á jolo no. <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />Jekob kehm limi egudu njom, fere lung edi jio re, El Elohe Isreel (ji lohngo re Esowo bi Isreel kpˈgbale).<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">Dayina a anebe Sekem</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />Efung abehng Dayina, mmon no nkal no Lia jele no ka Jekob kehm lohngo tahm elbong goji anebkal ba lene ejahbe jio. <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />Hamor ji nnea Hiv, ye ji jolo ntubesi ejahbe, á bele mmon no bo jo lung-e re Sekem, eji Sekem nyehne Dayina, á kehm-e rodo tahm a ne, song bobo sahb nne. <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />Eltim ene kpee lohngo toono Dayina mmona Jekob. Mmonse nnenkal noa kor-e sehng, á jo bungu a ne yebe yebe. <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />Sekem tongo Hamor nde re, &lt;&lt;Ko mmonse nnenkal noa ka-m, á jol nkal ewame.<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />Eji Jekob wuku re Dayina mmon ewe no nkal bo me-e rannge, abon ebe ba nlum jolo go emahng jo kpur atohkondi, owo á belle eje tete bo kehnge.<verse eid="GEN 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 34:6" />Hamor nde no Sekem kehm tahme song bung a Jekob. <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />Ngare nyia abone Jekob ebtob kehnge na kehnge, soro ba wuk ji ma lim, atahng rake bo sehng, sahb rˈrak bo tibre Sekem eblim ejum esono go Isreel, eji á noongo a mmona Jekob ejum ji ki fuumu re nne lim.<verse eid="GEN 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 34:8" />Hamor tongo bo re, &lt;&lt;Sekem mmon ewame ebyehke eltim ene kunu mmon ewa no nkal, titi yak-n ye, á jol nkal ewe. <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />Semm-n elbal anahre, Kaan wahr abon ebahne ba nkal, wahr bahke tob ka-n abon ebahre. <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />Ḿ bahke ba lene tob-r, ndi nyia nong gbalee ka-n. Ba jolen, wahn jo jen are, fere bel ndi gbalee.<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />Owo Sekem kehm tongo ndea Dayina a abonanyehn re, &lt;&lt;Nong me n fil-n ndon go egahne esamahr. M bahk-n kake ejum ajehng ajehng ji ń lˈbahb. <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />Tong-m wahn ekun elaame, a ayare nya kpˈsahb gbˈgbal nya bahk-n koro, m bahke kpiki ejum ajehng ajehng ji ń lˈtong-m. Sehngem re, lub ka-m wahn mmonse nkal noa, á jol nkal ewame.<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />Tib eji Dayina mmonannyehn ebo ma rannge, abone Jekob jo bungu alum enehm nyaa tong Sekem a Hamor nde abo. <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />Bo tongo bo re, &lt;&lt;Wahr nehm ma yake mmon ewahre no nkal ka nnenlum no kala yehke nrur, ejum ana jia bahke jolo esono sehng ka-r. <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />E bahke ma taame tv-n ń lˈlim ejum ajehng jia ji ji, ḿ bahke jolo ana wahr, ń bahke yehke aneblum kpee nrur. <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />Owo wahr bahk-n kake abon ebahre ba nkal, fere tob ko ebahne, wahr bahke lene anahne, wahn a wahr bahke jolo ajehng. <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />Ń tohko fere taame yehke nrur, wahr bahke koko mmonannee ejahre tahm ejahre.<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />Ntoobo abo kˈkor Hamor, a Sekem mmon ewe. <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />Njangkun nyia nyi ga bel ekpunu go nlaaga nde, á laangem ellimi ji bo tong-e no, tibre ntir enye á yehke kunu mmona Jekob noa no nkal. <verse eid="GEN 34:19" /><verse number="20" style="v" sid="GEN 34:20" />Owo Hamor a Sekem mmon ewe, kehm tahme song rehng go eti mbu ji ejahbe ebo re, bo song tong ane ebo. <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />Bo tongo bo re, &lt;&lt;Ane baa li go elkoono a nahre, nong bo lene egahra ndi, fere jo jen are a, tibre ndi nyia gbalee nyi bo bahke ma jol a nahre, e bahke ma ko abon ebo ba nkal go elbal, bo tob ko ba bahre. <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />Wo aneblum bao re, &lt;&lt;Bo bahke lene anahre fere jol ajehng anahre, go ejum jia re, aneblum ebahre yehke nrur tob jol ana bo. <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />Anv atohkondi ebo, a nsol ebo go enyam ebo kpee nehm tob jol nsol enyahra? Nong wahr limen ana ji bo ma bung, bo bahke lene anahre a.<verse eid="GEN 34:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 34:24" />Aneblum kpee ba lohngo je go eti mbu ji ejahbe jio, bo taame tv ji Hamor, a Sekem mmon ewe bungu no, nnenlum awohng awohng go ejahbe jio yehke nrur.<verse eid="GEN 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25" />Eji ma kang nfung era, ngare nyio nrur nyi bo yehke no kpi bo nnyame nnyame, abon ba nlum abal ba Jekob, Simion abola Levi abonanyehn Dayina, bo kehm rodo akahngkahng ebo song kehme elnoko a ejahbe jio ji ki kunu ekpu, fere wul nnenlum awohng awohng o. <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />Bo tob wulu Hamor a Sekem mmon ewe go ekahngkahng, fere yehke Dayina go etahk Sekem tahm ebo. <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />Abone Jekob kehm jeke ejahbe ji bo wulu ane bao, song da nsol, tibre o wo bo rannge mmonannyehn ebo no nkal. <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />Bo soro ba kpu ejoro, a ebul ebo, a efong, ebvankang, a ejum ebo ajehng ajehng ji bo bele no, go ejahbe jio, a nya li go emahng. <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />Bo kpu nsol afang ebo a anebkal ebo kpee a abon abon ana aju ebta, fere da ejum ajehng ajehng go ntahk.<verse eid="GEN 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30" />Jekob kehm tongo Simion a Levi re, &lt;&lt;Wahn ebseb nfem ba ka-m, wahn eblim, me njol ana ebi nrabe ka anebe Kenan a anebe Peris bo ji li ane ba lene a ndi nyia a bo. Wahr nehme rur, bo lˈfere fadde elbo ba nok aname, me a etahk ejame, bo bahk-r rannge kpee.&gt;&gt;<verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />Bo kehm faange Jekob re, &lt;&lt;Anv, fˈfuumu re Sekem lim mmonannee ejahre ana nne asˈsaa?&gt;&gt;<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">Jekob feere go Betel</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />Esowo kehm tongo Jekob re, &lt;&lt;Song go Betel wo song jol o, lim egudu njom o ka Esowo, ye ji jo ba kpir-a eji a jo be Eso mmonanne.<verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />Jekob kehm tongo anebe etahk ebe, a ane ba lene a ne re, &lt;&lt;Yehken, ajen asowo nya ń kpi no, wahn ru elnahne, fere yannge abomo. <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />Baan, wahr tahmen go Betel, go wo m bahke limi egudu njom ka Esowo, ye ji jo faang-m afung nya ejahkjahk jo jol aname, ye ji jo tob jol aname go edi ajehng ajehng ji n je no.&gt;&gt; <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />Owo bo kehm koko ajen asowo a abangetung nya jolo go ebo atung, ba ka Jekob, á kpa kak nnahb eti nyi bo kpo lung re oak go Sekem. <verse eid="GEN 35:4" /><verse number="5" style="v" sid="GEN 35:5" />Owo bo kehm lohngo tahm, egburu efahle ni lohng goji Esowo jolo a ajahbe nya jolo sennge bo kak, jol nnene lohngem kam bo.<verse eid="GEN 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 35:6" />Jekob a ane ebe kpee jene ba rehng go Lusi, ji li Betel, go ndi nyi Kenan. <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />O edi jio wo á limi egudu njom, á jo lungu edi jio re, El Betel<note caller="+" style="f"><char style="fr" closed="false">35:7 </char><char style="ft">El Betel lohngo re Esowo bi Betel</char></note>, tibre o edi jio wo Esowo lennge elne ka-e, eji á jo be Eso mmonane.<verse eid="GEN 35:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 35:8" />Nnenkal no jo rennge Rebeka, no bo jo lung-e re, Debora kehm kpoko, bo kpa-e kak go nnahb eti nyi bo kpo lung re Ok kohlo Betel, ano wo wahnge edi jio bo jo lung re, Alon Bakud.<note caller="+" style="f"><char style="fr" closed="false">35:8 </char><char style="ft">Alon Bakud lohngo re Ok ji eling</char></note><verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />Ngare nyi Jekob lohngo go Padan Aram, Esowo kehm kpe ba kpiri Jekob fere fuul-e. <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />Esowo kehm-e tongo re, &lt;&lt;Mbing enya bo kpo lung-a re Jekob, bo wa-a nehm kpe lung re Jekob; Bo bahke fere jo lung-a re Isreel. Owo á fere gung-e mbing re Isreel.<verse eid="GEN 35:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 35:11" />Esowo kehm-e tongo re, &lt;&lt;Me wo li Esowo Bi Kpi Nsahm Kpee, jel wo rur wahn jol go nfange gbˈgbal. Ejahbe, a abon ajahbe ba bahke lohngo go ega elwo, a atul atul kpee bahke lohngo go ega ngubjing. <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />Ndi nyi n ka Ebraham a Aisik, me n tob faake anyi ka-a, m bahke kake etˈtohngo eja ji kpa-a toono ndi nyia. <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />Esowo kehm feere go ero, tahme sa edi jio ji á jolo a ne.<verse eid="GEN 35:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 35:14" />Jekob kehm loko eltal ana ego, edi jio ji Esowo jo bung a ne, kehm yaange njom nyio nyi elwoko wohngo o, á tob yaange akehng wohngo o. <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />Jekob lungu edi ji Esowo bungu a ne re Betel.<verse eid="GEN 35:15" /></para>
  <para style="s">Elkv ni Rasel</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />Bo kehm mehle o Betel asongo, edi jio ekidi kpˈkpeka lab nne kehm rehnge go Efrad, Rasel kehm kehme ejel rahng, ejel jo riid-e sehng. <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />Ana ejel jo sahb riid-e riidi go eljele, owo nnenkal no jo bob-e ejel kehm-e tongo re, &lt;&lt;Ka kpe fahl, wob bel mmon no nlum noko. <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />Ana á gohro v elv ni elkv, á lungu mmon noo re Ben Oni,<note caller="+" style="f"><char style="fr" closed="false">35:18 </char><char style="ft">Ben Oni lohngo re no atongtong enyame</char></note> wo nde lung-e re Benjamin.<note caller="+" style="f"><char style="fr" closed="false">35:18 </char><char style="ft">Benjamin lohngo re mmon no eboblum ebame</char></note><verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />Owo Rasel kehm kpo, bo kpa-e kak go mbang eji bo jo tahm Efrad, ji li Betlehem. <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />O ero elahm bi Rasel, Jekob loo ego o, tete rehng lela ego jio kpˈtibi elahm bi Rasel.<verse eid="GEN 35:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 35:21" />Isreel kehm mehle o asongo, song si ebehre eje go esˈsong, nne lˈsehng Migdal Eder. <verse eid="GEN 35:21" /><verse number="22" style="v" sid="GEN 35:22" />Eji Isreel lene o edi jio, Ruben kehm tahme song noongo a nne elkora nde Bilha, Isreel wˈwuk bade.</para>
  <para style="s" vid="GEN 35:22">Abon ba nlum ba Jekob</para>
  <para style="p" vid="GEN 35:22">Jekob bele ewubu abon abal ba nlum: <verse eid="GEN 35:22" /><verse number="23" style="v" sid="GEN 35:23" />Abon ba nlum ba Lia ba a: Ruben wo jolo ngbokambang a mmona Jekob, Simion, Levi, Juda, Isaka a Jebulon. <verse eid="GEN 35:23" /><verse number="24" style="v" sid="GEN 35:24" />Abon ba nlum ba Rasel ba a: Josef abola Benjamin. <verse eid="GEN 35:24" /><verse number="25" style="v" sid="GEN 35:25" />Abon ba nlum ba Bilha nlokeltum Rasel jele no ba a, Dan abola Naftali. <verse eid="GEN 35:25" /><verse number="26" style="v" sid="GEN 35:26" />Abon ba nlum ba Jilpa jele no ba a, ye ji jolo nlokeltum a mmon no nkal no Lia, Gad abola Aser.</para>
  <para style="p" vid="GEN 35:26">A wo li abon ba nlum ba bo jele no ka Jekob go Padan Aram.<verse eid="GEN 35:26" /></para>
  <para style="s">Elkv ni Aisik</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />Jekob feere kehnge goji nde Aisik ga Mamre, kohlo Kiriad Arba, ji li Hebron, edi ji Ebraham abola Aisik tohko lene. <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />Aisik kange nnya atahl asehmwubu. <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />Á gohro v esˈkohro elv soro kpo, bo rod-e song kak eyele ane ebe, á sahb kˈkul go nnya tvv. Eso abola Jekob, bo ji jolo abon ebe ba rod-e song kpa kak.<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">Etˈtohngo ji Eso</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />Ana wo li ntoora nnyo mi li bade Eso, ji li Edom. <verse eid="GEN 36:1" /><verse number="2" style="v" sid="GEN 36:2" />Eso koo akal ebe goji anebkal Kenan: Adah mmon no nkal no Elon nnea Hid, a Oholibama mmon no nkal no Anah, ye ji jolo mmon a mmon no Jibion nnea Hiv, <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />á tob ko Basemad mmon no nkal no Ismeel, á jolo mmonannyehn no nkal no Nebayod. <verse eid="GEN 36:3" /><verse number="4" style="v" sid="GEN 36:4" />Adah jele Elifas ka Eso, Basemad jel Reuel, <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />Oholibama tob jele Jewus, Jalam a Korah. Abon ba nlum ba a, ba bo jele ka Eso go Kenan. <verse eid="GEN 36:5" /><verse number="6" style="v" sid="GEN 36:6" />Eso kehm rodo akal ebe, a abon ebe ba nlum, a ba nkal, a ane kpee ba jolo go egea nlaaga, atohkondi enye, go enyam behko, a nsol enye kpee nyi á bele no o Kenan, tahm song jol edi ji li fee a kehm rehnge edi ji Jekob mmonannyehn li no. <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />Nsol ebo nyi bo bele no gbale sehng re bo maam jol edi ajehng, edi ndi ji bo jolo no biingem bo, ane abal abal tib ntohkondi ebo. <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />Owo Eso, ji li Edom kehm tahme song jol go ejahbe ewong ji Seir.<verse eid="GEN 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />Ana wo li ntoora nnyo mi li bade Eso, nde no anebe Edom go ejahbe ewong ji Seir. <verse eid="GEN 36:9" /><verse number="10" style="v" sid="GEN 36:10" />A wo li abing nya abone Eso ba nlum, Elifas ji Ada nkala Eso jele no, a Reuel ji Basemad nkala Eso jele no. <verse eid="GEN 36:10" /><verse number="11" style="v" sid="GEN 36:11" />Abon ba nlum ba Elifas ba a: Tema, Omar, Jefo, Gatam a Kenas. <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />Mmona Eso noa no nlum Elifas tob bele nne elkoro no bo jo lung-e re Timna, ye wo jele Amalek ka-e. A wo li abon abon ba Ada nkala Eso. <verse eid="GEN 36:12" /><verse number="13" style="v" sid="GEN 36:13" />Abon ba nlum ba Reuel ba a: Nahad, Jera, Sama, a Mija. Bo ba jolo abon ba nlum ba abone Basemad nkala Eso. <verse eid="GEN 36:13" /><verse number="14" style="v" sid="GEN 36:14" />Abon ba nlum ba Oholibama nkala Eso ji mmona Ana ba a, ye ji jolo mmon no mmona Jibion, ba á jele ka Eso: Jewus, Jalam a Kora.<verse eid="GEN 36:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15" />Ane ba jolo atubesi go etˈtohng ji Eso ba a: Abon ba nlum ba Elifas ji jolo ngbokambanga mmon no Eso: Ntula Teman, ntula Omar, ntula Jefo, a ntula Kenas, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />ntula Kora, ntula Gatam, a ntula Amalek, bo ba jolo atul ane go etˈtohngo ji Elifas go Edom, bo jolo abon ba abon Ada. <verse eid="GEN 36:16" /><verse number="17" style="v" sid="GEN 36:17" />Abon ba nlum ba mmona Eso Reuel: Atula Nahad, ntula Jera, ntula Sama, a ntula Mija. Bo ba jolo atubesi etˈtohngo ji Reuel gona Edom; Bo ba jolo abon ba abon nkala Eso nobo jo lung-e re Basemad. <verse eid="GEN 36:17" /><verse number="18" style="v" sid="GEN 36:18" />Abon ba nlum ba nkala Eso, Oholibama: Ntula Jewus, ntula, ntula Jalam, a ntula Kora, bo ba jolo atul go etˈtohngo ji nkala Eso Oholibama mmon no Ana.<verse eid="GEN 36:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 36:19" />Baa kpee jolo abon ba Eso, ji li Edom, bo jˈnehm ba jolo atul ebo.<verse eid="GEN 36:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />Abon ba Seir nnea Hor, bo ji lene erohko jio ba a: Lotan, Sobal, Jibion, Ana, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />Dison, Ejer a Disan. Abon baa ba Seirba nlum go Edom, bo ba jolo atul anebe Hor. <verse eid="GEN 36:21" /><verse number="22" style="v" sid="GEN 36:22" />Abon ba nlum ba Lotan ba a: Hori abola Homam. Timna jolo mmonannyehn Lotan no nkal. <verse eid="GEN 36:22" /><verse number="23" style="v" sid="GEN 36:23" />Abon ba nlum ba Sobal ba a: Alvan, Manahad, Ebal, Sefo a Onam. <verse eid="GEN 36:23" /><verse number="24" style="v" sid="GEN 36:24" />Abon ba nlum ba Jibion ba a: Aya abola Ana. Ana jia wo, song nyehn elbing alahb ni jo fub go elka emahng, eji á jo jen ebvankang nde Jibion bo jo li nsol. <verse eid="GEN 36:24" /><verse number="25" style="v" sid="GEN 36:25" />Abon ba Ana ba a: Dison mmon no nlum, a Oholibama mmon no nkal. <verse eid="GEN 36:25" /><verse number="26" style="v" sid="GEN 36:26" />Abon ba nlum ba Dison ba a: Hemdan, Eshban, Itran a Keran. <verse eid="GEN 36:26" /><verse number="27" style="v" sid="GEN 36:27" />Abon ba Ejerba nlum ba a: Bilhan, Jaavan, a Akan. <verse eid="GEN 36:27" /><verse number="28" style="v" sid="GEN 36:28" />Abon ba Disan ba nlum ba a: Uju abola Aran. <verse eid="GEN 36:28" /><verse number="29" style="v" sid="GEN 36:29" />Ane ba jolo atul ba anebe Hor ba a: Lotan, Sobal, Jibion, Ana, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />Dison, Ejer a Disan. Ane baa ba jolo atul ba anebe Hor, ana bo yabe elbo ndi nyi Seir.<verse eid="GEN 36:30" /></para>
  <para style="s">Ane ba jo fili Edom</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />A wo li atul ba jo fili Edom anebe Isreel kehm tob bel atul ba bo. <verse eid="GEN 36:31" /><verse number="32" style="v" sid="GEN 36:32" />Bela mmon no Beyo ba jolo ntul no Edom. Ejahbe eje bo jo lungu re Dinhaba. <verse eid="GEN 36:32" /><verse number="33" style="v" sid="GEN 36:33" />Eji Bela kpoo no, Jobab mmon no Jera no lohng go Bojra wo ko nji etul ebe. <verse eid="GEN 36:33" /><verse number="34" style="v" sid="GEN 36:34" />Eji Jobab kpoo no Husam ji lohng go ndi nyi anebe Teman wo ko nji etul ebe. <verse eid="GEN 36:34" /><verse number="35" style="v" sid="GEN 36:35" />Eji Husam kpoo no Hadad mmona Bedad ye ji noko ga anebe Midia go ejahbe Moab, ye wo fere ba ko nji etul ebe. Elsi ene bo jo lungu re Avid. <verse eid="GEN 36:35" /><verse number="36" style="v" sid="GEN 36:36" />Eji Hadad kpoo no, Samla ji lohng go Masreka wo ko nji etul ebe. <verse eid="GEN 36:36" /><verse number="37" style="v" sid="GEN 36:37" />Eji Samla kpoo no, Sawul ji lohng go Rehobod go ejang aya wo ko nji etul ebe. <verse eid="GEN 36:37" /><verse number="38" style="v" sid="GEN 36:38" />Eji Sawul kpoo no, Bal Hanan mmon no Akbor wo ko nji etul ebe. <verse eid="GEN 36:38" /><verse number="39" style="v" sid="GEN 36:39" />Eji Bal Hanan mmona Akbor kpoo no, Hadad wo ko nji etul ebe. Elsi ene bo jo lung re Pawu, nkal ewe bo jo lung-e re Mehetabel ji mmona Matred, ji jolo mmona Me-Jahab no nkal.<verse eid="GEN 36:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 36:40" />A wo li ane ba jolo atubesi go etˈtohngo ji Eso, a abing ebo, ana arohko abangenahb ebo li no, a adi nya bo lene no: Timna, Alva, Jethed, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />Oholibama, Ela, Pinon, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />Kenaji, Teman, Mibjar, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />Magidiel a Iram. Ane baa ba jolo atul ba Edom, toono ana bo kake nsi ebo go ndi nyi bo ji no.</para>
  <para style="p" vid="GEN 36:43">Eso wo jolo nde no anebe Edom.<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s">Alem nya Josef leeme no</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />Jekob lene ndi nyi nde jolo no, go ndi nyi Kenan. <verse eid="GEN 37:1" /><verse number="2" style="v" sid="GEN 37:2" />Ntoora nnyo mi li bade Jekob mi a.</para>
  <para style="p" vid="GEN 37:2">Josef jolo mmonjangkun no ma kang elku a nnya ebal, á jo jene toono abonanyehn, bo jo le atohkondi, abon ba nlum ba Bilha, a ba Jilpa akal ndea bo. Josef jo ba tooro asabsab nsol nya abonanyehn jo kono ellimi.<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />Ana jolo o, Isreel nde, Josef wo jo ga-e kor sehnge abon ebe bako nlum, tibre Josef bo jele ka-e ngare nyi á ma kul; Owo wahnge á jahme ekpawobo ji jolo anyono anyono ka-e. <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />Eji abonanyehn sebe kahn re Josef wo jo ga kor nde ebo sehnge bo kpee, bo ko-e ekv, bo joom kpe bung a ne yebe yebe.<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />Josef kehm leeme nlem tooro tong abonanyehn, bo kpe-e ko na ekv budu. <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />Á kehm tongo bo re, &lt;&lt;Wuungen atung wahn wuk nlem nyi n leeme no. <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />E jolen go emahng jo gba agan nkohl, tvtv ngan nyˈnyame kehm mehle yiimi nsunsu, agan nya nyahne kehm bake ba yiimi sennge nyˈnyame kak, fere gong ka nyˈnyame.&gt;&gt;<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />Abonanyehn kehm-e tongo re, &lt;Anv, a kpˈtiri re wo wo bahke jolo ntul ewahr-a? Wo bahke lohko jo fil-ra? Bo kpe-e jo ko na ekv budu tib go nlem nyia nyi á lake bo, a ji á tongo bo.<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />Josef kehm kpe leeme nlem nyehko tong abonanyehn re, &lt;&lt;Wuungen atung, me n kpe leeme nlem nyehka, anv jolo re njul a ebareka, go ewubu elonlo ajehng gongo ka-m.&gt;&gt;<verse eid="GEN 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10" />Eji á tongo nde, fere tob tong abonanyehn, nde kehm-e nyame, fere tong-e re, &lt;&lt;Nlem nyi a ma leeme a, lohngo renan? Anv, nne a me, go abonane bahke bake ba gong go ndi ka-a?&gt;&gt; <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />Josef kpe sahb lˈli na abonanyehn ala, wo nde kuuru ejum ajehng ajehng go ege atahng.<verse eid="GEN 37:11" /></para>
  <para style="s">Abonanyehn Josef, rodo Josef gungu</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />Ngare nyia abonanyehn ebrod atohkondi ndea bo song kehme bo nsol alehke kaa kohlo Sekem, <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />Isreel kehm tongo Josef re, &lt;&lt;A kpˈkahne re abonane kpi atohkondi kpur kohlo go Sekem. Ba, me n tum-a tv bo.&gt;&gt;</para>
  <para style="p" vid="GEN 37:13">Á kehm faange re, &lt;&lt;Ebnob sehng.&gt;&gt;<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />Isreel kehm-e tongo re, &lt;&lt;Song wo song nyehn abonane joare bo baa go efel, afi atohkondi nyaa tob li nseenge, wo feere ba tong-m.&gt;&gt; Owo Isreel kehm-e tumu, á mehl o edamme ji Hebron asongo.</para>
  <para style="p" vid="GEN 37:14">Eji Josef rehnge go Sekem, <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />nne awohng kehm-e nyehne á kpˈdaale yannge go elka emahng, nne noo kehm-e bahbe re, &lt;&lt;Jenji a kpˈsebe?&gt;&gt;<verse eid="GEN 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16" />Á kehm-e faange re, &lt;&lt;N kpi abonanee kpur. A bahk-m ma tib edi ji bo li no kpˈkpuru atohkondi eboa?&gt;&gt;<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />Nne noo kehm-e faange re, &lt;&lt;Bob mehl ao, n jo wuku eji bo jo bung re, &lt;E tahmen go Dotan.&gt;&gt;&gt;</para>
  <para style="p" vid="GEN 37:17">Owo Josef kehm tahme jo seb abonanyehn asongo, song nyehn bo kohlo go Dotan. <verse eid="GEN 37:17" /><verse number="18" style="v" sid="GEN 37:18" />Eji bo sa nyehn-e go fee, re á kehm ba rehng o eji bo, bob toobo ana bo bahk-e wulu.<verse eid="GEN 37:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 37:19" />Bo jo bungu tong atemtem re, &lt;&lt;Nyehn monleeme alem ga kpˈbake!&gt;&gt; <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />Nong wahr wulen ye ro kak ekpabingi ajehng a, fere bung re ebi nnyam nyi me-e li, wahr kehm nyehne ana ji alem enye bahke jolo.<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />Eji Ruben wuku ano, á sebe re a á tahr-e yehke go ebo abo, á tongo bo re, &lt;&lt;Nong wahr ki-e wul.&gt;&gt; <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />Kana faade alung amehng amehng, roon na ye kak ekpabingi a elka emahng, kana lak ye ebo abehng abehng. Ruben bungu jia re á tahr-e go ebo abo, feere a ne song ka nde.<verse eid="GEN 37:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 37:23" />Eji Josef ma rehng goji abonanyehn, bo kehm-e yehke ekpawobo eje ji jolo anyono anyono ji á kake no, <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />bo kehm-e rodo ro kak ekpabingi, ekpabingi jolo nnehme nehme, alahb jolem.<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />Eji bo ji no jo li nsol alehke, bo kehm nyehne ellong anebe Ismeel ba lohng go Giled, kun go ebo akamel kpˈbake, akamel solo nsol are, ana akehng ma kpo yebe abehne, a ajoobo akehng eltaame ma kpo lim ane nob ayam, a alahb eti esˈsvv ma lohng eti ji bo kpo lung re Merr, bo jo tahm go Ijib.<verse eid="GEN 37:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 37:26" />Juda kehm tongo abonanyehn re, &lt;&lt;Anv nsehng anyii e bahke lehke, e lˈwul mmonannee ewahre fere bulu alung eme? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />Nong wahr gungen na ye ka anebe Ismeel, wahr kiin ye abo lak, gana ye mmonannee ewahre wo, e kpi alung amehng.&gt;&gt;Abonanyehn soro taame.<verse eid="GEN 37:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 37:28" />Eji anebe Ismeel ba lohng go Midia ba jo jen are ba no, abonanyehn kehm tohngo Josef yehke go ekpabingi jio, fere rod-e gungu anebe Ismeel go akpohko asilva eltahl, ane bao rod-e tahm a ne go Ijib.<verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />Eji Ruben feere no song kpur go ekpabingi jio, Josef o kpeem jol, á yare elne nsol nyi á kake no. <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />Ruben kehm jeke goji abonanyehn kehm song bung re, &lt;&lt;Mmon njangkun noo o kpeem li, anv gan wo m bahke jeke?&gt;&gt;<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />Bo kehm wulu mmombul, fere rod ekpawobo Josef behde go alung mao. <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />Bo kehm rodo ekpawobo anyono anyono song tib ndea bo, fere tong-e re, &lt;&lt;Wahr ebnyehn ekpawobo jia. Feede wo nyehn joare ekpawobo mmon ewa ji.&gt;&gt;<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />Á kehm liingi soro bung re, ekpawobo mmon ewame ji. Ebi nnyam me-e li. Josef bo me-e lohko jaake arohko arohko. <verse eid="GEN 37:33" /><verse number="34" style="v" sid="GEN 37:34" />Owo Jekob kehm yare nsol nyi á kake no, fere kak anyake nsol, noongo elkv mmon ewe afung tvv. <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />Abon ebe kpee, ba nlum a ba nkal ba re bo ba kak-e eltim, á ten fere bung re, &lt;&lt;Eˈee, m bahke soro asi noongo elkv tete n yel elahm toono mmon ewame.&gt;&gt; Jekob soro na asi jo ling mmon ewe.<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />Eji ma jol ano, anebe Media rodo Josef gungu Potifa, ji jolo ntubesi awohng go ellong atubesi abalimeltum Fero. Potifa wo jolo ntubesi ababˈbaabe.<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">Juda abola Tamar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />Ngare nyio Juda yake abonanyehn ebe kehm tahme re á song jol a nnelohng Adulam no bo jo lung-e re Hira. <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />Gona wo Juda kpiri mmonse no nkal, nde bo jolung-e Sua ji lohng go Kenan. Á ko-e go elbal, kehm noongo a ne, <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />á sa ela jel mmon no nlum no á gung-e mbing re Er. <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />Á kpe sa ela jel mmon no nlum no á gung-e mbing re Onan. <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />Á kpe bulu kpe sa ela jel mmon no nlum no á gung-e mbing re Sela, á jel-e go Kejib. <verse eid="GEN 38:5" /><verse number="6" style="v" sid="GEN 38:6" />Juda ko nkal ka ngbokambang a mmon ewe no nlum Er, mbing enye bo jo lung-e re Tamar. <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />Ngbokambang a mmon ewe Er jolo nne no jo lim abˈbi go ejang bi Jehova, wahng ka Jehova wul-e. <verse eid="GEN 38:7" /><verse number="8" style="v" sid="GEN 38:8" />Owo Juda kehm bungu tong Onan re, &lt;&lt;Song noongo a nkala mmonanne, wo ruru eltum ene ana nnar a mmonanyehn nne, eji a lˈjel abon ka mmonanne.&gt;&gt; <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />Onan kahne kpee re, mmon noo nehm jol no we. Owo wahnge ngare anyehng anyehng nyi á lˈnoongo a nkala mmonannyehn, á jo fere fonngo ebjing wohng go ndi, eji á lˈkˈjel abon ka mmonannyehn. <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />Ji Onan jo lim o jolo ebˈbi go ejang bi Jehova, Jehova tob wul-e. <verse eid="GEN 38:10" /><verse number="11" style="v" sid="GEN 38:11" />Juda kehm tongo Tamar nnar ewe re,&lt;&lt;Jol go etahk nso ana nkal ebun tete mmon ewame Sela gbal,&gt;&gt;Á bele ntir re, á bahke tob kpo, ana abonanyehn.&gt;&gt; Ano wo Tama mehle no song lene go etahk nde. <verse eid="GEN 38:11" /><verse number="12" style="v" sid="GEN 38:12" />Eji ma kang afung gbalee nkala Juda, mmon no nkal no Sua, kehm kpoko. Eji Juda ma noongo elkv mal, á mehle tahm go Timna, goji ane kpo kpud anyar ejoro ebe, nte ewe Hira ji lohng go Adulam toon-e je o. <verse eid="GEN 38:12" /><verse number="13" style="v" sid="GEN 38:13" />Ana bo tongo Tama re, Nde nlum wa fi mbang mbang asongo go Timna re á song kpud anyar ejoro ebe,&gt;&gt; <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />Tama kehm yehke nsol nkalebun, kehm rodo mbomo konngo bulu elne eji nnene lˈki-e liingi, mehl song ji go mbang nyi li rehng go Enayim go mbang nyi li tahm go Timna. Á sebe kahn re jol eji Sela ma gbˈgbal o, bo we nehme ka á jol nkal ewe. <verse eid="GEN 38:14" /><verse number="15" style="v" sid="GEN 38:15" />Eji Juda nyehn-e no, Juda tiri re nne asˈsa wo, tib yebkonngo esamahr ebe. <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />Juda kahnem re nkala mmon ewe wo, á song kpir-e o nkpe a mbang, kehm bungu re, &lt;&lt;Ba me, me n nkang a na.&gt;&gt; Tama kehm-e bahbe re, &lt;&lt;Jenji á bahk-m kake a lˈnoongo aname?&gt;&gt; <verse eid="GEN 38:16" /><verse number="17" style="v" sid="GEN 38:17" />Juda kehm-e faange re, &lt;&lt;M bahke tumu mmon mbul no nse tv-a go ellong ebul ebame. Tama kehm-e tongo re, &lt;&lt;Á bahk-m ma yahke ejum ji m bahke bumu ana ejum ntianse tete á tum mmona mbul noo tv-m?&gt;&gt; <verse eid="GEN 38:17" /><verse number="18" style="v" sid="GEN 38:18" />Juda kehm bungu re, &lt;&lt;Ejum ajii á kpˈsebe re me ka-a ana atianse? Tama kehm faange re, &lt;&lt;Yake ejum elliingi eja a nlehke eme, a ebti efilebo bi wob-a ebo ka-m.&gt;&gt; Á kehm-e kake, noongo a ne, á soro sa ela ka Juda. <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />Eji ma jol ano, Tama kehm feere go etahk, song lennge mbomo mi á konngo elne, rod abomo nkalebun bobo ana wuku wuku. <verse eid="GEN 38:19" /><verse number="20" style="v" sid="GEN 38:20" />Eji ejum jio ma sehng, Juda kehm kake nte ewe Hira ji lohng go Adulam mombul re á song ka nnenkal noo fere ko nsol enye ba ka-e. Eji Hira je no á we kpeem nyehn. <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />Owo á kehm bahb aneblum ba lene o re, &lt;&lt;Nne a asˈsa no jo kono eljehke nkpe a mbang nyi li asongo Enayim mee? Bo kehm-e faange re, &lt;&lt;E ka bˈbel nne asˈsa ao.&gt;&gt; <verse eid="GEN 38:21" /><verse number="22" style="v" sid="GEN 38:22" />Owo Hira kehm feere song tong Juda re,&lt;&lt;M we nyehnem edi ajehng ajehng, aneblum ba li ejahbe jio kpˈbungu re nne asˈsa ka jˈjol ona.&gt;&gt; <verse eid="GEN 38:22" /><verse number="23" style="v" sid="GEN 38:23" />Juda kehm bungu re, &lt;&lt;Nong á bum nsol nyi n ka-e no, eji e lˈk jol ejum asol. Kehn n tˈtumu mombul ana e toobo no, á we nyehnem.&gt;&gt; <verse eid="GEN 38:23" /><verse number="24" style="v" sid="GEN 38:24" />Eji yahke biingi nnyahng era, bo kehm tongo Juda re, &lt;&lt;Tama nkala mmon ewa kpˈjene yannge ana nne asˈsa, anv, tib esi jia, yebsa ela.&gt;&gt;Juda kehm bungu re, &lt;&lt;Koon ye ba, wahn ba jahm-e agun á kpo!&gt;&gt; <verse eid="GEN 38:24" /><verse number="25" style="v" sid="GEN 38:25" />Eji bo me-e rod re bo song wul, owo á tumu etib tv nde nlum re, &lt;&lt;Nne no kpi nsol nyia, ye wo ma-m kak ela. Seenge nˈnob. Nne awoo kpi ejum elliingi jia a nlehke eme, a ebti efilebo bia?&gt;&gt; <verse eid="GEN 38:25" /><verse number="26" style="v" sid="GEN 38:26" />Juda soro liingi nsol nyio tvtv, kehm bungu re, &lt;&lt;Tama wo ga li etingitingi nne sehnge me, tib m taam-m re Sela mmon ewame ko-e go elbal.&gt;&gt; Juda kpeem tiki noongo a Tama. <verse eid="GEN 38:26" /><verse number="27" style="v" sid="GEN 38:27" />Eji ba rehng ngare ejel, bo sebe kahn re Tama jolo ela ayafele. <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />Ana á jo rahng ejel, mmon awohng gbo mbang yehke ebo ebe. Mbohngo ejel kehm tubu mmon noo ejahm, gba-e mbila mbomo go ege ebo, kehm bungu re, &lt;&lt;Noa wo gbo mbang lohng.&gt;&gt; <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />Á kehm fere tohng ebo ebe kak atahng, mmonannyehn fere lohng! Mbohngo ejel kehm biingi re, &lt;&lt;Lohngo renan!&gt;&gt; Á limi renan a ma bohngo lohng?&gt;&gt; Bo kehm gungu mbing re Pereji<note caller="+" style="f"><char style="fr" closed="false">38:29 </char><char style="ft">Pereji lohng re ebbohngo lohng</char></note> <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />Owo mmonannyehn no bo kahn-e mbila mbomo go ebo kehm lohngo, bo ka-e mbing re Jera.<note caller="+" style="f"><char style="fr" closed="false">38:30 </char><char style="ft">Jera lohngo re mbilibila mbomo</char></note><verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">Josef a nkala Potifa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />Eji bo ko Josef song rehng a ne go Ijib, Potifa ji jolo nnea Ijib, ji jolo ntubesi awohng go ellong atubesi abalimiltum Fero, a ntubesi ababˈbaabe, ye wo gunu Josef goji anebe Ismeel ba ko-e no rehng o. <verse eid="GEN 39:1" /><verse number="2" style="v" sid="GEN 39:2" />Jehova jolo a Josef owo wahnge edi jo nob a Josef, á jolo go etahk ndeju ewe nnea Ijib. <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />Eji ndeju ewe nyehne re Jehova jolo a ne, go fvfo Jehova tob ka-e efa go ejum ajehng ajehng ji á jo lim. <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />Potifa bele eyebatahng a Josef, owo wahnge á rod-e lim ntubesi go ege a nlaaga. Á jolo nne no jo lim eltum a ne bad bad.Á lim-e Á lim-e á jo kpur nlaaga enye, fere yake nsol enye kpee kak-e go ebo nyi á bele no. <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />Bomo ngare nyi á lim-e ntubesi fere yake nsol nlaaga kake go ebo, Jehova fuulu nlaaga nyi nnea Ijib tib esi Josef. Elfuulu ni Jehova jolo go ejum ajehng ajehng ji Potifa bele no, jolo go nlaaga afi go ekulugbe. <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />Potifa yake ejum ajehng ajehng ji á bele no ka Josef, tib esi ji Josef jo kpur nsol, Potifa joom kpe kunu ekpu go ejum ajehng ajehng, sehngem nsol alehke nyi nyi á jo li. Josef gbo eljini fere nˈnob. <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />Eji jolo ano nkala ndeju ewe yehke amahr kun-e, fere tong-e re, &lt;&lt;Ba noongo aname!&gt;&gt; <verse eid="GEN 39:7" /><verse number="8" style="v" sid="GEN 39:8" />Josef tˈten fere tong-e re, &lt;&lt;Tib eji nsol kpee wob-m go ebo, ntubesi ewame ejumjum lim ji ye kpo kpe gbiingi elne go ege etahk, ejum ajehng ajehng yeb yake kak-m go ebo. <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />Nnene limm no kpˈgbale etahk jia ana me, ejumjum limm ji ntubesi ewame kala yake kak-m go ebo, sehngem wo ntahng ntahng, tibre wo nkal ewe wo. Bahke limi renan me n kehm limi elkohn ebi ejum ana jia, fere lim abiafem soodo Esowo. <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />Jol ana á jo bˈbung a Josef efung abehng abehng, Josef jo tˈten elnoongo a ne, jol Josef lubem jol na a ne. <verse eid="GEN 39:10" /><verse number="11" style="v" sid="GEN 39:11" />Efung abehng Josef kehm yele ekpˈkpa re á song lim eltum ene, aloketum ba etahk jio kpee nnene jolem o ekpˈkpa. <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />Á kehm-e jabbe go ege ekpawobo, kehm bungu re, &lt;&lt;Ba noongo aname!&gt;&gt; Josef kehm yehke ekpawobo tv-e go, be lohng alatahk. <verse eid="GEN 39:12" /><verse number="13" style="v" sid="GEN 39:13" />Eji á nyehne re yebyake ekpawobo tv-e ebo, fere be lohng alatahk, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />á kehm lungu alokeltum ba etahk jio, kehm tongo bo re, &lt;&lt;Nyehnen nnea Hibru no bo ko-e ba ka-r re á ba nyok-r, nyehn ye go ma ba re á ba noongo aname, n kehm rabe. <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />Eji á wuku ana m ma rabe re tob-m wahn, owo á ma tahm ekpawobo sa go egame ejang, fere be lohng alatahk.&gt;&gt; <verse eid="GEN 39:15" /><verse number="16" style="v" sid="GEN 39:16" />Nnenkal noo bumu ekpawobo jio tete nlum ewe kehnge ba etahk. <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />Owo á kehm-e tubu eka re: &lt;&lt;Nju nnea Hibru no á ko-e ba ka-r eblohng ba re á ba nyok-m. <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />Ana n soro kehme elrabe re tob-m wahn, á soro tahm ekpawobo eje sa go egame ejang, fere be lohng alatahk.&gt;&gt;<verse eid="GEN 39:18" /></para>
  <para style="s">Josef bo me-e kak ngbekobo</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19" />Eji Potifa wuku eka jio ji nkal ewe tub-e no re, &lt;&lt;Ana wo nju enya lim-m no,&gt;&gt; atahng kehm-e sahb rˈrak. <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />Á kehm rodo Josef nju enye song kak go ngbekobo, edi jio ji Fero kpo bum anebe agbekobo ebe.</para>
  <para style="p" vid="GEN 39:20">Ana Josef woomo o ngbekobo, <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />Jehova jolo a ne. Á tib-e nnoobo eljini, fere lim mbaaba ngbekobo jol eyebatahng a ne. <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />Owo mbaaba agbekobo kehm limi re Josef fere jo kpur anebe agbekobo ba wob o kpee, fere tob jo kpur ejum ajehng ajehng ji bo kpˈlimi o. <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />Mbaaba agbekobo joom kpe kunu amahr go ejum ajehng ajehng ji á ma yake kak Josef go ebo, tibre Jehova jolo a ne, fere lim-e á li efa go ejum ajehng ajehng ji á jo lim.<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s">Josef tooro alem tong aneba agbekobo ba Fero</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />Eji ma kang afung, nfili ebtuka ntul abola nlima abred no ntula Ijib, soodo ndea bo, ntul no Ijib. <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />Fero atahng rak-e sehng tob atubesi ane abal ebe baa, ntubesia abafili ntuku abola ntubesia abalima abred, <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />á rodo bo kak ngbekobo go etahk jˈnehm ji ntubesia mbabˈbaabe, go ngbekobo nyˈnehm nyi Josef woomo no. <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />Ntubesia mbˈbaabe yake agbekobo nyao ka Josef re á jo kpur bo, Josef jo kpˈkpur bo. Eji bo ma jol o ngbekobo ma kang afung ntiil, <verse eid="GEN 40:4" /><verse number="5" style="v" sid="GEN 40:5" />aneblum abal bao nfili ebtuku abola nlima abred ka ntula Ijib, bo ji woomo o ngbekobo, bo leeme nlem atv manehm, bo ane abal abal, nlem anyehng anyehng lohngo eje eje. <verse eid="GEN 40:5" /><verse number="6" style="v" sid="GEN 40:6" />Eji Josef ba nyehn bo njahm efungfu, á sebe kahn re bo joom bang. <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />Owo á kehm bahbe atubesi alokeltum Fero bo ji woomo go ngbekobo go etahk ntubesi ewe re, &lt;&lt;Jenji wahnge ń kil bange lela?&gt;&gt; <verse eid="GEN 40:7" /><verse number="8" style="v" sid="GEN 40:8" />Bo kehm-e faange re, &lt;&lt;Wahr ane abal abal leeme alem, wo nnene limm no bahke tooro tong-r ana lohngo no.&gt;&gt; Josef kehm tongo bo re, &lt;&lt;Esowo sang kpˈkahne ana ntooro alem lohngo noa?. Tong-m wahn alem enyahne. <verse eid="GEN 40:8" /><verse number="9" style="v" sid="GEN 40:9" />Owo ntubesia nfili ntuku kehm tongo Josef nlem enye. Á tong-e re, &lt;&lt;Egama nlem n nyehne eti ji bo kpo lung re nlehke egreb, yim go egama mbuksong, <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />nlehke mio bele njad era, ana kake anyane o, soro fem lim atasok agreb fere bil. <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />Ebtuku Fero woomo egame abo, n kehm bongo akaba greb nyao, fere kaame kak go ebtuku, fere rod ebtuku bio kak Fero go ebo.&gt;&gt; <verse eid="GEN 40:11" /><verse number="12" style="v" sid="GEN 40:12" />Josef kehm-e tongo re, &lt;&lt;Ana wo nlem enya lohngo no. Njad era nyio lohngo nfung era. <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />Re kang nfung era, Fero bahk-a yehke go ngbekobo, fere feere a na go ega nji eltum, a bahke feere jo song kak Fero ebtuku go ebo ana a jo lim wuku wuku, eji a jolo nfili ebtuku ewe. <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />Lˈfere nob a na buum-m wo tib-m nnoobo eljini, gahm-m go esamahr Fero wo kak-m ebo me n lohng go ngbekobo nyia. <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />Bo bob-m na yehke go ndi nyi anebe Hibru, jol edi ji n li a ejumjum n limem ji fuumu re bo kak-m go ngbekobo elbing.&gt;&gt; <verse eid="GEN 40:15" /><verse number="16" style="v" sid="GEN 40:16" />Eji ntubesia abalima abred nyehne re Josef ebtooro ntooro nyi nno, á kehm tongo Josef re, &lt;&lt;Me fvfo n tob leeme nlem, ejeere ebra kuum-m go esi bi abred woomo no.&gt;&gt; <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />Ejeere ji gohro kuumu go ero, ajoobo akaange kaange nsol ellehke woomo atahng nya jolo ka Fero, nruk jo suudu nsol nyio li go atahng ejeere ji n solo go egame esi. <verse eid="GEN 40:17" /><verse number="18" style="v" sid="GEN 40:18" />Josef kehm-e tongo re, &lt;&lt;Ana wo nlem enya lohngo no, ejeere ebra bio lohngo nfung era. <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />Lˈkang nfung era, Fero bahke kimi esi eja, fere rod-a song kahn tohko go eti, nruk bahke bake ba suudu nnyama ngubjing enya li kpee.&gt;&gt; <verse eid="GEN 40:19" /><verse number="20" style="v" sid="GEN 40:20" />Sa nfung era Fero bahke buumu efung bi bo jel-e no, á limi elkak ka atubesi abalimeltum ebe. Á kehm tumu bo song yehke ntubesia abafili ntuku, a ntubesia abalima abred go ngbekobo, ba a bo go esamahr atubesi abalimeltum ebe. <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />Fero feere a ntubesia abafili ntuku jehke ege a nji eltum, eji á lˈkpe jo kak Fero ebtubu go ebo, <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />fere rod ntubesi abalima abred song kahn ekehd tohko go eti. Ana wo alem nyao lohko jol jangjang ana Josef tooro no tong bo. <verse eid="GEN 40:22" /><verse number="23" style="v" sid="GEN 40:23" />Ntubesia abafili ntuku kpeem buumu Josef; á yin-e yini.<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">Alem nya Fero leeme no</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />Eji ma sehng nnya ebal, Fero kehm leeme nlem: Á leeme no, á yiimi go nkpe aya Nayel, <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />edahmagbudu na ebsehma kehm lohngo o aya nya sahb jˈjok fere fˈfeele, ba kehme ajele li go nkpe aya. <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />Eji ma jol ano edahmagbudu na ebsehma behko kehm kpe lohng aya mao toono bo. Adahmagbudu nyao jolo akpuk kpuk fere sˈsab ba yiimi kohlo ajokojoko nyao go nkpe aya. <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />Akpuk kpuk adahmagbudu nyao fere sˈsab kehm lehke edahmagbudu bio na ebsehma bi joko fere fˈfeele. Fero kehm nyahme go ellu. <verse eid="GEN 41:4" /><verse number="5" style="v" sid="GEN 41:5" />Á kehm kpe gbo ellu kehm kpe leeme etoono nlem, elrahn nkohl anehng lake abon na asehma fere gbal egburu arum nkohl sahb nˈnob. <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />Eji ma jol ano, akpuudu akpuk kpuk nkohl esehma kehm tob kpe kehme elgbale sahb fˈfiiri, elfeb ero nfam ba lim fi akohl nyao. <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />Akpuudu afiiri akohl nyao fere mele agburu arum anoobo akohl nyao, Fero soro nyahme, na ga nlem nyi. <verse eid="GEN 41:7" /><verse number="8" style="v" sid="GEN 41:8" />Eji efungfu ma se, eltim jo gbiing-e sehng, á kehm tumu re bo lung anebe ntaane kpee a akahnkahn ane ba Ijib bo ba. Fero kehm lake bo alem enye, nnene we maam tong ana alem nyao lohngo no. <verse eid="GEN 41:8" /><verse number="9" style="v" sid="GEN 41:9" />Owo ntubesia abafili ntuku kehm tongo Fero re, &lt;&lt;Lela me mbuumu abˈbi enyame. <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />Ngare jˈjol nyi a rake atahng tob alokeltum eba, fere tum-m ngbekobo awahra ntubesia abalima abred go etahk ntubesia mbˈbaabe. <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />Wahr ane abal abal leeme alem atv manehm na amehng, nlem anyehng anyehng jo lohngo eje eje. <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />Njangkun, nnea Hibru awohng jolo anahre, á jolo nlokeltum no ntubesia mbˈbaabe. Ye wo e lake alem enyahre, á tong-r ana lohng no, no nne á tong-e ana nlem enye lohngo no. <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />Nsol nyio lohko jol ana á tooro no tong-r, me feere go egama nji eltum, nne noko bo song kahn-e ekehd. <verse eid="GEN 41:13" /><verse number="14" style="v" sid="GEN 41:14" />Fero kehm tumu tv Josef, bo soro yehk-e go ngbekobo elbing. Ngare nyi á ma kpud elne fere yaange abomo elkake, á kehm ba yiimi go esamahr Fero. <verse eid="GEN 41:14" /><verse number="15" style="v" sid="GEN 41:15" />Fero kehm tongo Josef re, &lt;&lt;N leeme nlem, nnene me-e nehme ma tong ana lohngo no, me n wuk bob bung bada na re a lˈwuk nlem, a bahke ma tooro ana lohngo no.&gt;&gt; <verse eid="GEN 41:15" /><verse number="16" style="v" sid="GEN 41:16" />Josef kehm faange Fero re, &lt;&lt;Me n nehm ma lim, wo Esowo bahke kake Fero nfaange nyi bahk-e koro.&gt;&gt; <verse eid="GEN 41:16" /><verse number="17" style="v" sid="GEN 41:17" />Owo Fero kehm tongo Josef re, &lt;&lt;Go egama nlem, n yiimi go nkpe aya Nayel, <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />edahmagbudu na ebsehma kehm lohngo o aya, bo sahb jˈjok fere fˈfeele ba kehme ajele li. <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />Edahmagbudu ebsehma behko kehm tob kpe lohng o aya, bo sahb kpˈkpuk, fere fˈfiiri, n ka nyehn a nyehn adahmagbudu ana nyao a ndi nyi Ijib kpee. <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />Akpuk kpuk adahmagbudu nyao nya fere sˈsahb sˈsab kehm lehke ajokojoko adahmagbudu nyao na ebsehma nya gbo mbang lohng aya. <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />Jol tvtv o, eji bo ma li bo o, jol nnene nehm ma tong re bob lim ano, bo kpake yim ano kpuk kpuk kpuk kpuk ana wuku wuku. N kehm soro nyahme. <verse eid="GEN 41:21" /><verse number="22" style="v" sid="GEN 41:22" />&lt;&lt;Go egame a nlem n nyehne agburu arum nkohl na esehma sahb nˈnob go elrahn anehng. <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />Eji jolo ano n kehm kpe nyehn akpuudu- akpawake akohl na esehma kpˈgbale sahb fˈfiiri, elfeb ero nfam ba fi. <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />Afiiri fiiri akohl nyao jo mele arum nyao na esehma nya sahb nˈnob. Me n tong anebe ntaane, bo ane kpee nnene lim no male no tong-m ana lohngo no.&gt;&gt; <verse eid="GEN 41:24" /><verse number="25" style="v" sid="GEN 41:25" />Owo Josef kehm tongo Fero re, &lt;&lt;Alem nya Fero li elkohnkohn anehng, Esowo eblennge ka Fero ejum ji á yahke lim. <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />Anoobo adahmagbudu na ebsehma lohngo nnya esehma, anoobo arum akohl nyao na esehma lohngo nnya esehma; li na anehng fvfo li elkohn nlem anyehng. <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />Akpuk kpuk adahmagbudu na ebsehma nya sabb fˈfiiri fere sˈsab nya lohngo toono, tob lohngo re nnya esehma, ano wo akpuudu akpawake akohl nya elfeb ero fi no: Nya li nnya esehma nyi njal. <verse eid="GEN 41:27" /><verse number="28" style="v" sid="GEN 41:28" />&lt;&lt;Li na li jang jang ana n tong-a no Fero, Esowo ebtib Fero ejum ji á yahke ba lim. <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />Egburu nnya esehma nyi nsol ndi bahke lake tv fad kpˈbake go ndia Ijib. <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />Wo nnya esehma nyi njal bahke toono, Bo bahke yini bade nlaka nsol nyi jolo a Ijib, njal nyi bahke fere ko nji a ndi nyia. <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />Bo nehm kpe buumu nlaka nsol nyi jolo go ndi nyia, tib re njal nyi bahke toono, bahke sabe sehng, <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />Ejum ji wahnge Esowo tibi Fero go nlem mbang ebal li re ejum jio Esowo ebtoobo sahb tˈtahne, fvfo Esowo bahke gulu ellimi. <verse eid="GEN 41:32" /><verse number="33" style="v" sid="GEN 41:33" />&lt;&lt;Eji ma jol ana, nong Fero kpur nne no kpi ngbere a elkahne, fere rod-e kak á jo kpur ndia Ijib. <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />Nong Fero yehke atubesi ane kak go ndi nyia nyi Ijib, bo jo yehke ejum ajehng go nsol elon anyehng anyehng, go ngara nsol akpake go nnya esehma nyi nsol bahke lake tv fad. <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />Bo ko nsol alehke nyio go nnooba nnya na esehma nyi kpˈbake, bo kuuru nkohl go elwo ni Fero, bo kuuru nsol alehke nyio go ajahbe ajabe ajahbe. <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />Nsol alehke nyia bo bahke kuuru bum ejahbe, eji behnjehle bo lˈjo ko li, go nnya esehma nyi njal kpˈbake a Ijib, eji ejahbe lˈkˈnyehn erem njal.&gt;&gt; <verse eid="GEN 41:36" /><verse number="37" style="v" sid="GEN 41:37" />Ntoobo nyia kˈkor Fero a atubesi alokeltum ebe. <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />Owo Fero kehm bahbe bo re,&lt;&lt;Anv wahr bahke ma bel elkohn nne ana noa, no etohko ji Esowo li a nea?&gt;&gt; <verse eid="GEN 41:38" /><verse number="39" style="v" sid="GEN 41:39" />Fero kehm tongo Josef re,&lt;&lt;Eji Esowo ma lim re wo kahn nsol nyia kpee, nnene lim no kpe kpi ngbere a elkahne ana wo. <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />Ekpasiki ejame bahk-a woomo go ebo, ane ebame kpee bahke tob woom-a go ebo, fere jo wuk ajehke enya. Sehngem ga eti etul wo, me n bahke gbale sehng-a.&gt;&gt; <verse eid="GEN 41:40" /><verse number="41" style="v" sid="GEN 41:41" />Owo Fero kehm tongo Josef re,&lt;&lt;Me n yake ndi a Ijib kpee kak ega ebo, re wo jo kpur.&gt;&gt; <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" />Owo Fero kehm yehke ebil nsahm enye go ege ebnyohkobo, fere kak Josef go ege ebnyohkobo. Á fere liib-e ekpawobo ji etul, fere kak-e nlehke agul go emel. <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />Fere lim-e re bo sol-e go mmvtv akuungu ana etoono ntubesi, ane fere jo rabe re, &lt;&lt;Tahmen go mbango.&gt;&gt; Mbang nyia wo Fero ma yake ndi nyi Ijib kpee kak Josef go ebo re á jo kpur. <verse eid="GEN 41:43" /><verse number="44" style="v" sid="GEN 41:44" />Owo Fero kehm tongo Josef re, &lt;&lt;Me wo li Fero, tohko jol re ellum ena ni, nnene lim no bahke tabe ebo afi ekpade go ndi nyi Ijib kpee.&gt;&gt; <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />Fero kehm kake Josef mbing re Jafena-pania<note caller="+" style="f"><char style="fr" closed="false">41:45 </char><char style="ft">Jafena-Pania lohngo re Esowo ebbung, á li elkpin</char></note> fere ka-e Asenad mmon no nkal no Potifera, ye ji jolo nlimanjom go On<note caller="+" style="f"><char style="fr" closed="false">41:45 </char><char style="ft">On mbing nyehko nyi On li re Heliopolis</char></note> re á jol nkala Josef. Josef yannge kpee go ndi nyi Ijib. <verse eid="GEN 41:45" /><verse number="46" style="v" sid="GEN 41:46" />Ngare nyia Josef ebkang eltahl a nnya ewubu eji á yele eltum aloko goji Fero ntul no Ijib. Josef jo tahme o esamahr Fero jo yannge go ndi nyio nyi Ijib kpee. <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />Go nnya esehma nyi nsol bahke lake, nsol sahb lˈlak gbalee go ndi nyio. <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />Josef jo jene ko nsol alehke nyio nyi bo jo bel go nnya esehma nyio nyi nsol lake no tv fad go Ijib, fere jo kuuru go ajahbe, ajahbe. Go ejahbe ajehng ajehng nsol mbahmandi nyi bo jo bahm o á jo ko kuuru o. <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />Josef kuuru abim nkohl jolo are erikehndi aya ma. Gbale sehng re nfange á joom kpe ma kak go nwer, tibre siiri eso. <verse eid="GEN 41:49" /><verse number="50" style="v" sid="GEN 41:50" />Re nnya nyio nyi njal kehm rehnge, Asenad mmon no nkal no Potifera nlimanjom no On, ebjel abon ba nlum abal ka Josef. <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />Josef gungu ngbokambang a mmon ewe mbing re Manase,<note caller="+" style="f"><char style="fr" closed="false">41:51 </char><char style="ft">Manase lohngo re eblim re me n yini</char></note> kehm bungu re, &lt;&lt;Tibre Esowo eblim re me n yini afemfem enyame kpee, a nya nlaaga nsoo kpee.&gt;&gt; <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />Etoono mmon no nlum a gung-e mbing re Efriim,<note caller="+" style="f"><char style="fr" closed="false">41:52 </char><char style="ft">Efriim lohngo re ebnob aname nkpel ebal</char></note> kehm bungu re, &lt;&lt;Tibre Esowo ma-m ka nrur go ndi nyi m ma nyehn erem.&gt;&gt; <verse eid="GEN 41:52" /><verse number="53" style="v" sid="GEN 41:53" />Owo nnya esehma nyi nsol alehk tv fad go Ijib kehm male. <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />Nnya esehma nyi njal kehm bomo ana Josef bungu no. Njal jolo adi nyako kpee, wo go ndi nyi Ijib kpee nsol alehke jˈjol. <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />Eji anebe Ijib kpee kehme njal wa, bo kehm lingi tob Fero bade nsol alehke, Fero tongo aneb Ijib kpee, re &lt;&lt;Songen goji Josef wahn lim ajehng ajehng ji á bahk-n tongo.&gt;&gt; <verse eid="GEN 41:55" /><verse number="56" style="v" sid="GEN 41:56" />Eji njal ma rehng edi ajehng ajehng go ejahbe kpee, Josef kehm lennge abutahk ntahk nyi á kuuru nsol alehke, jo gungu anebe Ijib nsol alehke, tibre njal gbale sehng go ndi nyi Ijib kpee. <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />Ane kpee jo lohngo go ajahbe ajahbe ba go Ijib ba gunu nsol alehke goji Josef, tibre njal gbale sehng go edi ajehng ajehng.<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">Abonanyehn Josef tahme nsol alehke gunu go Ijib</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />Eji Jekob wuku re nsol alehke nyia go Ijib, á tongo abon ebe re, &lt;&lt;Jenji wahnge ḿ ma sa kpi atemtem seenge?&gt;&gt; <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />Á kpe soro asi bung re, &lt;&lt;Me n wuk re alehke nyia go Ijib, songen go wahn song gunu ba ka-r, eji e lˈkpin, kˈkpo.&gt;&gt; <verse eid="GEN 42:2" /><verse number="3" style="v" sid="GEN 42:3" />Owo abonanyehn Josef na awubu kehm tahme re bo song gunu alehke go Ijib. <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />Wo Jekob tumem Benjamin mmonanyehna Josef a ane bako, tibre á jo fahle re, ejum ki-e lim. <verse eid="GEN 42:4" /><verse number="5" style="v" sid="GEN 42:5" />Abon Isreel kehm tahme a ellong ane bako re, bo song gunu nsol alehke, tibre njal tˈtob jol go ndia Kenan. <verse eid="GEN 42:5" /><verse number="6" style="v" sid="GEN 42:6" />Josef wo jolo nne no jo fili ndi nyio, ye wo jolo nne no jo gungu anebe ejahbe bao kpee nsol alehke. Eji abonanyehn Josef bao rehnge o, bo gongo asamahr ebo go ndi ka-e. <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />Ana Josef nyehne abonanyehn, á lˈliingi bo, fere lim awini ana njenne, bung a bo egban egban re, &lt;&lt;Wahn lohng gan?&gt;&gt; Bo kehm-e faange re, &lt;&lt;Wahr lohng go ndi nyi Kenan, e ba re wahr ba gunu nsol alehke.&gt;&gt; <verse eid="GEN 42:7" /><verse number="8" style="v" sid="GEN 42:8" />Jol eji Josef liingi liingi abonanyehn, bo we-e liigem <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />Josef kehm buumu nlem enye bada bo, kehm bungu tong bo re, &lt;&lt;Wahn ane ba kpo weele nyehn egahbe ba, ḿ ba re wahn ba nyehn nkpe ejahbe anyehng anyehng nyi nne bahke ma sehng yel,&gt;&gt; <verse eid="GEN 42:9" /><verse number="10" style="v" sid="GEN 42:10" />Bo kehm faange re, &lt;&lt;Eˈee ntubesi wahr alokeltum eba, e ba re wahr ba gunu nsol alehke. <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />Wahr kpee abon ba nlum ba nne awohng ba, wahr alokeltum eba ane ba kpi ekpunu ba, abaweele nyehn ejahbe sang.&gt;&gt; <verse eid="GEN 42:11" /><verse number="12" style="v" sid="GEN 42:12" />Josef faange bo re &lt;&lt;Eˈee, ḿ ba re wahn ba nyehn nkpe ejahbe anyehng anyehng nyi nne bahke ma sehng yel.&gt;&gt; <verse eid="GEN 42:12" /><verse number="13" style="v" sid="GEN 42:13" />Bo kehm faange re, &lt;&lt;Wahr alokeltum eba jolo ewubu abonanyehn ba nlum na abal, abon nne awohng, bo lene go ndi nyi Kenan, monkalla li a nsoo ewahre, noko kpeem li.&gt;&gt; <verse eid="GEN 42:13" /><verse number="14" style="v" sid="GEN 42:14" />Josef kehm tongo bo re, &lt;&lt;Tiki li ana n kp-n tongo re, wahn abaweele nyehn ejahbe ba! <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />Ana wo bo bahk-n wunngu, Go mbing nyi Fero ji li go elkpin, ń nehm tiki tahm a tete monkalla mmonanne ewahne ba a. <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />Tumen nne awohng wahne a song ko mmonanne wahne á ba; wahn egom jehka kpee ḿ bahke woomo go ngbekobo, eji bo lˈwuungu alum enyahne fere seb kahn joare ń kpˈbung etingitingi. Lˈjol re ń kpi kimi efahne, go mbing nyi Fero ji li go elkpin, wahn abaweele nyehn ejahbe ba!&gt;&gt; <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />Á kehm kake bo kpee go ngbekobo go nfung era. <verse eid="GEN 42:17" /><verse number="18" style="v" sid="GEN 42:18" />Eji ma biingi nfung era Josef kehm tongo bo re, &lt;&lt;Limen jia wahn jol go elkpin, tibre me n kpˈfahle Esowo. <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />Joare ń lohko li ane ba kpi ekpunu, nong mmonanne ewahne awohng jol o ngbekobo, wahn ga roden nsol alehke wahn song kehnge, song ka anebe njal go etahk. <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />Koon mmonkalla mmonanne ewahne ba ka-m, eji alum enyahne lˈlohko jol ano, fvfo eji ń lˈkˈkpo.&gt;&gt; Bo tˈtaame re bo bahke limi ano. <verse eid="GEN 42:20" /><verse number="21" style="v" sid="GEN 42:21" />Bo kehm bungu tong atemtem re, &lt;&lt;Etingitingi e kpˈnyehne erem bia tib esi mmonannee ewahre, e nyˈnyehn erem bi jolo a ne, eji á jo gboong-r tib esi elkpin ene, wo e we wukem, ano wo wahnge erem bia ma feere ba kuum-r.&gt;&gt; <verse eid="GEN 42:21" /><verse number="22" style="v" sid="GEN 42:22" />Ruben kehm tongo bo re, &lt;&lt;Wahn tong-ma, re wahn kˈlim abiafem tob mmonse nlum noa? Ń wukem, anv wahr ba bahke gale mbong alung eme.&gt;&gt; <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />Bo joom kahn re Josef kpˈwuku ana bo kpˈ bungu, eji jolo re nne jo tooro na tong bo. <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />Josef kehm tahme bo sa song kehme ellingi, eji á ma rahke eling á kehm feere ba kehme elbungu a bo. Á kaa nsahm bo gba Simion go ebo esamahr. <verse eid="GEN 42:24" /><verse number="25" style="v" sid="GEN 42:25" />Josef kehm tongo aloketum re bo kak bo nsol alehke rur go ebo abam, fere feere akpohko asilva ebo kak nne awohng awohng go ege ebam, fere toobo nsol eljen ka bo. Ngare nyi bo ma lim ano ka bo, <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />bo kehm gbade ebvankang, abam nsol alehke soro tahm. <verse eid="GEN 42:26" /><verse number="27" style="v" sid="GEN 42:27" />Edi ji bo kange no wo, nne awohng kehm fannge ebam eje re á ka mbvankang nsol alehke, soro nyehn akpohko silva enye go egea nnyo ebam. <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />Kehm tongo abonanyehn re, &lt;&lt;Akpohko silva enyame, bob fere a nya kak-m egame ebam. Nyehnen nya ga egame ebam.&gt;&gt;Ntim kehm kimi bo, bo keebe seenge atemtem fere kehme elkahme kehm bungu re, &lt;&lt;Jenjii a ji Esowo ma-r lim anae?&gt;&gt; <verse eid="GEN 42:28" /><verse number="29" style="v" sid="GEN 42:29" />Bo kehm ba rehng eji Jekob ndea bo, go ndi nyi Kenan, bo tongo ndea bo nsol kpee nyi ma lim bo. <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />Bo kehm bungu re, Nne no li ntubesi a ndi jo bungu anahre egbangban, fere jo ko-r are wahr ane ba kpo weele nyehn ndi ba. <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />Wo wahr tong-e re, &lt;Wahr ane ba kpi ekpunu ba; wahr abaweele nyehn adi sang.&gt; <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />E tong-e re, &lt;E jolo ewubu abonanyehn abal, abon nde awohng, na awohng kpeem li, monkalla noa a nsoo ewahre go Kenan.&gt; <verse eid="GEN 42:32" /><verse number="33" style="v" sid="GEN 42:33" />&lt;&lt;Owo nne no li ntubesia ndi kehm-r tongo re, &lt;Ana wo ḿ bahke kahne re wahn ane ba kpii ekpunu ba: Yaken mmonanne ewahne awohng bum a egame, wahn jehko ko nsol alehke song ka anebe njal go egahna ntahk. <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />Koon monkalla mmonanne ewahne ba ka-m, eji n lˈkahn re wahn abaweele nyehn edi sang, ane ba kpi ekpunu ba. M bahke feere a mmonannee ewahne kaan, ń fere jo jen are go ndi nyia.&gt;&gt;&gt; <verse eid="GEN 42:34" /><verse number="35" style="v" sid="GEN 42:35" />Ana bo jo yaange nsol alehke go ebo abam, nne awohng awohng nyehne ebgba akpohko silva enye go ege ebam! Eji bo a ndea bo ma nyehn ebgba akpohko silva ano, bo kehme elfahle. <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />Owo Jekob ndea bo kehm tongo bo re, &lt;&lt;M ma-m lim re me n kˈkpe bel mmon awohng awohng. Josef kpeem li, Simion kpeem tob li, anv ń yahke kpe rod Benjamin tahm a ne. Me wo nsol nyia kpee ma sennge kuumu me!&gt;&gt; <verse eid="GEN 42:36" /><verse number="37" style="v" sid="GEN 42:37" />Ruben kehm tongo nde re, &lt;&lt;A bahke ma wul abon nlum abal ebame, n tohko ko Benjamin ba ka-a, yak-e kak-m go ebo re me n kpur-e, m bahke feere a ne.&gt;&gt; <verse eid="GEN 42:37" /><verse number="38" style="v" sid="GEN 42:38" />Jekob kehm bungu re, &lt;&lt;Mmon ewame wahn nehm toono je go; mmonannyehn ebkpo, ye ntahng ntahng wo ma sa, ejum ajehng.&gt;&gt; Ajehng lˈsong lim-e go mbang eljen eji ń fi a ne, ḿ bahke limi abi enyame yel go elahm ndon ndon.<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s">Abonanyehn Josef ko Benjamin je go Ijib</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />Ngare nyia njal kpˈkpake gbal go ndi nyio. <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />Owo eji bo ma li nsol alehke kpee nyi bo gunu go Ijib, ndea bo kehm tongo bo re, &lt;&lt;Feeren song Ijib wahn kpe song gunu nsol alehke ntiil ba ka-r.&gt;&gt; <verse eid="GEN 43:2" /><verse number="3" style="v" sid="GEN 43:3" />Juda kehm bung tong nde re, &lt;&lt;Nne noo sahb rehk-r rehke tˈtahne re, &lt;Ń nehm kpe nyehn esamahr ebame, ń tohko tiki ko nkalla ewahne ba a ne.&gt; <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />Á lˈtum mmonannee ewahre á toon-r ba, wahr bahke jeke song gunu nsol alehke ba ka-a. <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />Á tohk-e tum á toon-r, wahr nehm je, tibre nne noo tong-r re, &lt;Ń nehm kpe nyehn esamahr ebame, ń tohko tiki ko mmonanne ewahne ba a ne.&gt;&gt;&gt; <verse eid="GEN 43:5" /><verse number="6" style="v" sid="GEN 43:6" />Isreel kehm tongo bo re, &lt;&lt;Jenji wahnge ń kehm koko nfem nyia ba ka-m, eji ń tong-e re ń kpi mmonanne ewahne ga?&gt;&gt; <verse eid="GEN 43:6" /><verse number="7" style="v" sid="GEN 43:7" />Bo kehm-e faange re, &lt;&lt;Nne noo bahb-r abahbe bade elnahre fere bahb-r bade a nnahb enyahre, á bahb-r nyehko re anv nso ewahne noa kpeka li go elkpina?&gt; Fere kpe bahb re, &lt;Ń kpˈkpi mmonanyehn nokoa?&gt; Wahr tob faang-e na faange abahbe enye, e bahke limi renan kehm kahne re, á bahk-r tongo re, koon mmonanne ewahne ba a ne?&gt;&gt;&gt; <verse eid="GEN 43:7" /><verse number="8" style="v" sid="GEN 43:8" />Juda kehm tongo Isreel nde re, &lt;&lt;Yake mmonse nlum noa kak-m go ebo, wahr bahke tahme tvtv, eji wahr, a wo, a abon ebahre e kpin kˈkpo njal. <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />Mefono antahng m bahke yiimi nkpaneka tahr-e; me wo a bahk-m jabbe antahng. N tohk-e ko feere a ne ba yiimi a ne a go ega esamahr, me wo bahke solo elfeeme go egame elkpin kpee antahng. <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />Ana li a, ki li re wahr eblaange, kehn wahr ebje na kpe feere je nkpel ebal.&gt;&gt; <verse eid="GEN 43:10" /><verse number="11" style="v" sid="GEN 43:11" />Owo Isreel ndea bo kehm tongo bo re, &lt;&lt;Lˈjol ano, limen jia: kaken akab nti nya nno go egahne abam nya lohng egahna ndi, wahn ko je a nya song ka nne noo ana ayare. Koon afubfub akehng, akehng ekon, a nsol nyi kpo lim nsol alehke yebe, a alahb eti ma kpo v esˈsvv eleenge, ma lohng eti ji bo kpo lung re Merr, mmohka pistasio, mmohka almond. <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />Roden akpohko asilva nyao edi ebbal, tibre ḿ bahke tiki song ka asilva nya bo kake egahne anyo abam, fundiki elsoodo ni. <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />Tob roden mmonanne ewahne, wahn song a ne anv anv goji nne noo. <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />Nong Esowo Bi Kpi Nsahm Kpee lim wahn fili nne noo ndon go ege esamahr, eji á lˈyake mmonanne ewahne noko, a Benjamin bo fere toon-n kehnge. Ana me, lˈjol re abon ebame bahke kpoko nong bo kpo.&gt;&gt; <verse eid="GEN 43:14" /><verse number="15" style="v" sid="GEN 43:15" />Owo ane bao kehm rodo nsol ayare nyao, fere rod akpohko asilva edi ebbal, a Benjamin fvfo. Bo kehm foomo tahm song rehng go Ijib, song tib elbo go esamahr Josef. <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />Eji Josef nyehne Benjamin a bo, a kehm bungu tongo ntubesi alokeltum no etahk eje re,&lt;&lt;Rod ane baa song a bo egame etahk, song wul nyam o wo lam nsol alehke, bo bahke lehke nsol aname ngare efin.&gt;&gt; <verse eid="GEN 43:16" /><verse number="17" style="v" sid="GEN 43:17" />Nne noo limi ana Josef tong-e no, lohko rod ane bao tahm a bo go etahk Josef. <verse eid="GEN 43:17" /><verse number="18" style="v" sid="GEN 43:18" />Ane baa jo fˈfahl, eji bo rodo bo tahm a bo go etahk Josef. Bo jo tiri re, &lt;&lt;Bo ma-r ko ba a, tib akpohko silva nya bo kake go ebo anyo abam ngbokambang efung. Á yahke nok anahre fere ga-r, red-r fere ko-r ana aju fere taare ebvakanng ebahre.&gt;&gt; <verse eid="GEN 43:18" /><verse number="19" style="v" sid="GEN 43:19" />Owo bo kehm tahme toono atubesi alokeltuma Josef, fere bungu a ne, eji bo yahke yel etahk. <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />Bo tong-e re, &lt;&lt;Titi nsoo, nyanjehle e ba a ba gunu nsol alehke. <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />Go edi ji e kange no atv, efannge anyo abam enyahre fere nyehn akpohko asilva wob ebam nne awohng awohng ewahre, go nseenga seenge wahr ebko feere a nya. <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />Wahr ebkpe ko akpohko silva nyako ba re wahr ba gunu nsol alehke, wahr nehme kahn nne no kake akpohko silva go egahre abam.&gt;&gt; <verse eid="GEN 43:22" /><verse number="23" style="v" sid="GEN 43:23" />A kehm bungu re, &lt;&lt;Ebnob sehng,&gt;&gt; &lt;&lt;Kana kpe fahl. Esowo ebahne, Esowo bi nso ejahne, ye wo ma-n ka afange go egahne abam; n kˈko akpohko asilva enyahne.&gt;&gt; Owo á kehm yehke Simion feere a ne ba ka bo. <verse eid="GEN 43:23" /><verse number="24" style="v" sid="GEN 43:24" />A kehm koko ane bao tahm a bo go etahk Josef, song ka bo alahb bo ru akpade, fere tob toobo nsol alehke ebvankang ka bo. <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />Bo kehm toobo nsol ayare bum jo sik re Josef ba ngare efin, tib re bo wuku re bo bahke lehke nsol o. <verse eid="GEN 43:25" /><verse number="26" style="v" sid="GEN 43:26" />Eji Josef ma kehnge ba, bo kehm-e kake ayare nya bo ko no ba, bo gongo go ndi ka-e. <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />Á kehm bahbe bo ana bo li no, fere tong bo re, &lt;&lt;Ekˈkulu nso ewahne no ń tong-m no bada ne, á li rejen? Á noa kpaka li go elkpina?&gt;&gt; <verse eid="GEN 43:27" /><verse number="28" style="v" sid="GEN 43:28" />Bo kehm faange re &lt;&lt;Nlokeltum ewa nsoo ewahre noa kpaka li elkpin. Fvfo ye noa nob nob.&gt;&gt; Bo kehm gongo go ndi, sahb gˈgong ka-e ekpunu. <verse eid="GEN 43:28" /><verse number="29" style="v" sid="GEN 43:29" />Eji a kpuru no fere nyehn Benjamin mmonannyehn, mmon no nlum no nyehn jele no, a kehm bahbe re, &lt;&lt;Monkalla mmonane ewahne no ń tong-m no bade wo aa?&gt;&gt; Á kehm bungu re, &lt;&lt;Nong nnoobo nyi Esowo jol a na, mmon ewame.&gt;&gt; <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />Eji Josef nyehne mmonannyehn á kpeem ma bob elne, á kehm soro mehl esamahr abonanyehn tahm bo sa, foomo lohng, re á song seb edi ling. Á song yele ege a nkimi song ling. <verse eid="GEN 43:30" /><verse number="31" style="v" sid="GEN 43:31" />Á ru esamahr ebe, kehm lohngo jo bob elne, fere tong re &lt;&lt;Bak nsol alehke.&gt;&gt; <verse eid="GEN 43:31" /><verse number="32" style="v" sid="GEN 43:32" />Bo bake nya nye ka-e eje eje, abonanyehn bo ka bo ebo ebo, anebe Ijib ba li nsol a bo, bo tob bake ka bo eje eje, tibre aneb Ijib joom li nsol semme a aneb Hebru, tibre jolo ebi ejum ka aneb Ijib re bo lim ano. <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />Ane bao bo jehke bo nti go esamahr Josef toono esi ekul ebo, bomo nnenkul tete song rehng nkalla; bo jo seenge atemtem eko fere jo tan bo. <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />Eji bo jo bak nsol go ekpˈkuru ji Josef, nsol nyi bo jo ka Benjamin jo gbale nkpel elon sehnge nya nne awohng awohng ga. Bo li fere wo fannge ngubjing a Josef.<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s">Ebtuku Josef go atahng ebam ji Benjamin</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />Josef kehm kake ntubesi alokeltum etahk ewe elle re &lt;&lt;Kak nsol alehke go abam ane baa, ana bo bahke ma sol, wo feere a akpohko asilva nya nne awohng awohng kak go ege nnyo ebam, <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />wo kak ebtuku ebame, ebtuku asilva go nnyo ebam mi nkalla. Tob kak akpohko asilva nya á ko gunu nsol alehke go ege ebam.&gt;&gt; Ano wo á limi no ana Josef tong-e no. <verse eid="GEN 44:2" /><verse number="3" style="v" sid="GEN 44:3" />Re efungfu se, bo song tv bo re bo song a ebvankang ebo. <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />Jol eji bo lohngo ejahbe jio bo gaam jen fee, Josef tongo ntubesia nlokeltum ewe re, &lt;&lt;Song toono ane baa anv anv, a lˈkpiri bo, tong bo re, &lt;Jenji wahnge ḿ ma ko ebi, feere a nnoobo? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />Ebtuku asilva bia sang nsoo ewame kpo ko jo wo, fere jo bu elbua? Esab sab ejum ji ḿ ma lim.&gt;&gt;&gt; <verse eid="GEN 44:5" /><verse number="6" style="v" sid="GEN 44:6" />Eji á song kpiri bo, alum nyanehm o nya á tongo bo. <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />Bo kehm-e faange re, &lt;&lt;Jenji wahnge nsoo kpˈbungu elkohn ejum ana jia? Ndan gbaa re wahr alokeltum eba lim elkohn ejum ana jia! <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />Kehn wahr lˈlohng go ndi a Kenan feere a akpohko silva ba ka-a nya e nyehne egahra abam. Jenji wahnge wahr bahke kehm vohko silva afii agul etahk nso? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />Lˈfere jol re nlokeltum ewa awohng awohng noa no bo bahke nyehne go ege, nong á kpo; wahr egom jehka bahke jolo alokeltum ba nsoo.&gt;&gt; <verse eid="GEN 44:9" /><verse number="10" style="v" sid="GEN 44:10" />&lt;&lt;Á kehm bungu re ebnob sehng, &lt;&lt;Nong jol ana a ma bung. Nne no bo lˈnyehn go ege ye wo bahke jolo nju enyame; wahn egom jehko ń nehm kpe li ebi.&gt;&gt; <verse eid="GEN 44:10" /><verse number="11" style="v" sid="GEN 44:11" />Bo nne awohng awohng foomo radde abam eje bum ndi fere fange anyo abam. <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />Owo ntubesi alokeltum kehm kehme elfeede, bomo goji nnenkul abo tete ba rehng eji nkalla. Etuku bio bo nyehne go ebam ji Benjamin. <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />Eji jolo ano bo kehm, yare abomo ebo. Owo bo kehm feere a nsol gbade ebvankang, fere feere go ejahbe. <verse eid="GEN 44:13" /><verse number="14" style="v" sid="GEN 44:14" />Ngare nyio Josef noa kpake li etahk, Juda a abonanyehn kehm ba gbo noongo go ege alata. <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />Josef tongo bo re, &lt;&lt;Jen ji wahnge ḿ ma lim ana? Ń nehme kahn re nne ana me bahke ma seb ejum kahn go elbua?&gt;&gt; <verse eid="GEN 44:15" /><verse number="16" style="v" sid="GEN 44:16" />Juda kehm faange re, &lt;&lt;Jenjii e bahke tongo nsoo ewame? Jenji e bahke bungu? Anv e bahke tibi renan re wahr nehme kahn? Esowo eblennge abˈbi nya alokeltum eba, anv a wahr aju nya nsoo nya, wahr fono antahng a nne no bo nyehne nkob ege ebam.&gt;&gt; <verse eid="GEN 44:16" /><verse number="17" style="v" sid="GEN 44:17" />Owo Josef kehm bungu re, &lt;&lt;Ndan gbaa re, me n lim elkohn ejum ana jio! Nne no bo nyehne ebtuku go ege wo wo bahke jolo nju enyame, egom jehko feeren song tob nso ewahne go elkoono.&gt;&gt;<verse eid="GEN 44:17" /></para>
  <para style="s">Juda gboongo ka Benjamin</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />Owo Juda kehm song kpir-e fere tong-e re, &lt;&lt;Ntubesi ewame, nong nlokeltum ewa fil-a ndon. Nong me nlokeltum ewa bung moblum, Atahng ki-a rahk tob nlokeltum ewa, n kpˈkahne re, a li jang jang ana yefono Fero. <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />Wo, ntubesi bahbe nlokeltum ewe re a kpˈkpi ndea afii mmonannyehn?&gt; <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />E faange re, &lt;E kpˈkpi nde, yebkul, mmon no nse no nlum noa no bo jele ka-e, eji á ma kul, mmonannyehn noko ebkpo, ye ntahng ntahng wo ma sa go mmon a nnenkal noo. Á kpo kor nsoo sehng.&gt; <verse eid="GEN 44:20" /><verse number="21" style="v" sid="GEN 44:21" />&lt;A tongo nlokeltum ewa re, &lt;&lt;Ko-e ba, eji me n lˈnyehn-e antahng.&gt;&gt; <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />E tongo ntubesi ewame re &lt;&lt;mmonse nnenlum noo nehm ma tahm nde sa; á lˈtahm-e sa, nde bahke kpoko.&gt;&gt; <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />Wo a tongo nlokeltum ewa re, &lt;Tohko tiki jol re, nkalla toon-n ba a, ń nehm kpe tiki nyehn esamahr ebame.&gt; <verse eid="GEN 44:23" /><verse number="24" style="v" sid="GEN 44:24" />Eji e feere no kehnge goji nlokeltum ewa no li nsoo, e song tong-e ji ntubesi tong-r no. <verse eid="GEN 44:24" /><verse number="25" style="v" sid="GEN 44:25" />&lt;&lt;Owo nsoo ewahre kehm-r tongo re, &lt;Songen wahn kpe song gunu abon nsol alehke.&gt; <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />Wo wahr tong-e re &lt;&lt;Wahr nehm feere je o, sehngem re no nkalla mmonnannee ewahre toon-r na, owo e bahke jeke. E nehm ma nyehn esamahr nne noo, tohko jol re nkalla mmonannee ewahre jolo anahre o.&gt; <verse eid="GEN 44:26" /><verse number="27" style="v" sid="GEN 44:27" />&lt;&lt;Nlokeltum ewa nsoo ewame tong-r re, &lt;Ń kpˈ kahne re, nkal ewame jele abon ba nlum abal ka-m. <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />Awohng tahm-m a sa, n bungu re &lt;&lt;Etingitingi bo me-e jaake arohko arohko,&gt;&gt; We n nehme kpe tiki nyehn. <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />Á lˈkpe rod noa tahm-m sa, ejum lˈlim-e, a bahke rodo esi abi ejame yel go elahm ndon ndon. <verse eid="GEN 44:29" /><verse number="30" style="v" sid="GEN 44:30" />Elkpin nsoo li are bob kpennge atem a elkpin monse nlum noa. Anv mmonse nlum noa tohko jol anahre, n lˈfeere goji nlokeltum ewa no li nsoo, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />a lˈnyehn re, mmonse nlum noa lim anahre, á bahke kpoko, alokeltum eba bahke rodo esi abi nsoo ewahre song kak elahm ndon ndon. <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />Me nlokeltum ewa ko mmonse nlum go nkpaneka re m bahk-e kpuru ka nsoo ewahme. N tongo nsoo re, n tohk-e ko feere a ne ba ka-a, me wo bahke lehke ebi go ega esamahr, elkpin ename kpee. <verse eid="GEN 44:32" /><verse number="33" style="v" sid="GEN 44:33" />&lt;&lt;Anv titi nong me nlokeltum ewa sa a ana njua nsoo, go esi mmonse nlum noa, nong mmonse nlum toono abonanyehn song. <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />M bahke limi renan kehm tahme kehnge goji nsoo ewame, mmonse nlum noa tohko jol aname? E,ee! Ka nongo me n nyehn ejum ndon ji bahke limi nsoo.&gt;&gt;<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s">Josef lennge elne ka abonanyehn</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />Josef kpeem ma bob elne go esamahr ane ebe, á kehm rabe re,&lt;&lt;Nong nne awohng awohng tahm-m esamahr!&gt;&gt; Nnene jolem a ne eji á lennge elne ka abonanyehn. <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />Á kehm lingi wahre wahre, anebe Ijib wˈwuk, anebe etahk Fero tˈtob wuk bade. <verse eid="GEN 45:2" /><verse number="3" style="v" sid="GEN 45:3" />Josef kehm tongo abonanyehn re, &lt;&lt;Me Josef wo! Nsoo noa kpeka li go elkpina?&gt;&gt; Wo abonanyehn we ma-m faange, tib re eko tˈtan bo go ege esamahr. <verse eid="GEN 45:3" /><verse number="4" style="v" sid="GEN 45:4" />Owo Josef kehm tongo abonanyehn re, &lt;&lt;Jeeren kohl-m wahn.&gt;&gt; Eji bo ma lim ano, á kehm bungu re, &lt;&lt;Me Josef mmonanne ewahne wo, ye ji ń gung-e ka Ijib. <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />Anv ki-n kpe mennge, jol kana kpe rak atahng tob elnahne tib eji ń gung-m no ka a, tib re jolo re me n tahre elkpin ane, ano wo wahnge Esowo tum-m re, me n gbo-n mbang. <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />Nnya ebal nyi a nyi njal li ndi nyia, nnya elon nyi ma sa, mbahmandi nehm jol, elkpake nehm jol. <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />Wo Esowo tum-m, n gbo-n mbang re me n ko egburu mbang eltahre nia kuuru nkpin enyahne eji n lˈkˈ kpo wahn ane kpee go njini. <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />&lt;&lt;Fvfo wahn sang tum-m tv a, Esowo bi tum-m. Esowo ma-m lim me n jol nde no Fero, ntubesi no nlaaga enye kpee, a nfiladi no Ijib kpee. <verse eid="GEN 45:8" /><verse number="9" style="v" sid="GEN 45:9" />Anv foomen wahn feere song goji nsoo, tong-n ye re, &lt;Ji ji a, ji Josef mmon ewa ma bung: re, Esowo ma-m lim ntubesi go Ijib kpee, mehl ba ga egame; ka laange. <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />Ḿ bahke ba lene nkpohko nyi Gosen, jol o kohlo me, wahn a abon ebahne, a abon abon ebahne, ejoro a ebul, a adahmagbudu enyahne a nsol kpee nyi n kpi no. <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />M bahke jo kpur-n kpur o, tibre ebsa nnya elon nyi njal kpeka li. Tohko jol ano wahn a anebe etahk ebahne, a ane ba li ka-n kpee ḿ bahke gboko ekpak.&gt; <verse eid="GEN 45:11" /><verse number="12" style="v" sid="GEN 45:12" />&lt;&lt;Wahnfono a Benjamin mmonannee kpˈnyehne re me Josef wo kpˈlohko bung anahne. <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />Tong-n nsoo ewame bade ekpunu ji bo ma-m ka ga Ijib, a ejum ajehng ajehng ji ḿ ma nyehn, wahn ko nsoo ewame ba a ne a elwaare.&gt;&gt; <verse eid="GEN 45:13" /><verse number="14" style="v" sid="GEN 45:14" />Á kehm bingi Benjamin mmonannyehn fere kehme ellingi, Benjamin tob bing-e, tob jo ling. <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />Á fere tob bingi abonanyehn kpee fere ling a bo. Eji ma jol ano abonanyehn kehme elbungu a ne. <verse eid="GEN 45:15" /><verse number="16" style="v" sid="GEN 45:16" />Eji eka jia rehnge go ekpasiki Fero re, abonanyehn Josef ebba, Fero a atubesi alakeltum ebe kpee koro bo sehng. <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />Fero kehm tong Josef re, &lt;&lt;Tong abonane re, &lt;Lim-n jia: Gbaden enyam ebahne nsol, wahn feere go ndia Kenan, <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />wahn song ko nso ewahne a nnahb enyahne ba ka-m. M bahk-n kake edi ji ga nob ga ndia Ijib, ń tob li afom ebno ndi.&gt; <verse eid="GEN 45:18" /><verse number="19" style="v" sid="GEN 45:19" />&lt;&lt;A bahke tob tong bo re, lim-n jia: Rod-n nsol nyi kpo sol nsol a Ijib, wahn sol abon ebahne, a akal ebahne, a nso jahne, wahn ko bo ba a. <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />Kana tiiri bade nsol nyi li ka-n, tibre nsol nyi ga nob ga Ijib bahke jolo nyˈnyahne.&gt;&gt;&gt; <verse eid="GEN 45:20" /><verse number="21" style="v" sid="GEN 45:21" />Ano wo abone Isreel limi no, Josef ka bo nsol nyi kpo sol nsol, ana Fero ka ntahm, á tob toobo nsol alehke ka bo go ebo eljen. <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />Josef ka bo nne awohng awohng ewobo nfenfe, wo eji Benjamin á ka-e akpohko asilva atahlku fere ka-e ewobo eblon. <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />A wo li ji á tumu tv nde, mbvankang ewubu solo atingi anoobo nsol nya Ijib, akal ebvankang ewubu solo nsol alehke a abred go nsol nyehko nyi jolo ka eljen ene. <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />Á kehm tumu abonanyehn re bo song, eji bo jo tahm, á tongo bo re, kana taange go mbango. <verse eid="GEN 45:24" /><verse number="25" style="v" sid="GEN 45:25" />Owo bo kehm tahme lohng go Ijib, song kpiri Jekob ndea bo go ndi nyi Kenan. <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />Bo kehm-e tongo re, &lt;&lt;Etingitingi Josef noa kpeka li go elkpin, ye wo li nne no kpˈfili Ijib kpee.&gt;&gt; Jekob eko tan-e tan, á ma-m taame tv bo. <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />Wo eji bo tong-e ejum ajehng ajehng ji Josef tongo bo, á fere tob nyehn nsol nyi kpo sol nsol, nyi Josef tumu re bo ba sol-e feere a ne, etohko ji Jekob ndea bo kehm yahme. <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />Isreel kehm bungu re, &lt;&lt;Ma-m lohko lennge! Josef mmon ewame noa lohko li go elkpin. M bahke tahme song nyehn-e kehm kpoko.&gt;&gt;<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s">Ana Jekob mehle tahm go Ijib</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />Owo Isreel kehm mehle tahm a nsol a nsol enye kpee, eji á rehnge go Beer-seba a kehm limi ajom ka Esowo bi nde Aisik. <verse eid="GEN 46:1" /><verse number="2" style="v" sid="GEN 46:2" />Esowo kehm bungu tong Isreel atv, jolo elfoongo nlem re, &lt;&lt;Jekob! Jekob!&gt;&gt; Á kehm faange re, &lt;&lt;Nyehn me ga.&gt;&gt; <verse eid="GEN 46:2" /><verse number="3" style="v" sid="GEN 46:3" />Esowo kehm bungu re, &lt;&lt;Me wo li Esowo, Esowo bio bi nso, ka fahl eljeke go Ijib, tibre m bahk-a koko lim egburu ejahbe o. <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />M bahke jeke a na go Ijib, etingitingi m bahke tiki feere a na. Josef wo a bahke naange kake go ebo.<note caller="+" style="f"><char style="fr" closed="false">46:4 </char><char style="ft" closed="false">Go ellum ni Hibru: &lt;Josef wo bahke koko ebo ebe bulu amahr enya.&gt;</char></note>&gt;&gt; <verse eid="GEN 46:4" /><verse number="5" style="v" sid="GEN 46:5" />Owo Jekob kehm mehle o Beer-seba, abon Isreel ba nlum kehm soro rod Jekob ndea bo, a abon ebo, a akal ebo, kak go amvtv nya Fero tumu tv re ba sol bo. <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />Fvfo bo tob rodo atohkondi ebo a nsol kpee nyi bo bele go Kenan. Jekob a abon ebe kpee mehle tahm go Ijib. <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />Jekob rodo abon ebe ba nlum, a abon abon ebe ba nlum, a tob rodo abon ebe ba nkal, a abon abon ebe ba nkal, etˈtohngo eje kpee tahm a bo go Ijib. <verse eid="GEN 46:7" /><verse number="8" style="v" sid="GEN 46:8" />A wo li abing abon ba nlum ba Isreel ba tahme go Ijib: Ruben wo Jekob gbo mbang jel-e. <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />Abon ba nlum ba Ruben ba a: Hanok, Palu, Hejiron a Karmi. <verse eid="GEN 46:9" /><verse number="10" style="v" sid="GEN 46:10" />Abon ba nlum ba Simion ba a: Jamuel, Jamin, Ohad, Jakin, Johar, a Sawul ji nnenkala Kenan wo jele ka-e. <verse eid="GEN 46:10" /><verse number="11" style="v" sid="GEN 46:11" />Abon ba nlum ba Levi ba a: Gerson, Kohad a Merari. <verse eid="GEN 46:11" /><verse number="12" style="v" sid="GEN 46:12" />Abon ba nlum ba Judah ba a: Er, Onan, Sela, Pereji a Jerah, (Er, a Onan bo kpo go ndi nyi Kenan) Abon ba nlum ba Pereji: ba a, Hejiron a Hamul. <verse eid="GEN 46:12" /><verse number="13" style="v" sid="GEN 46:13" />Abon ba nlum ba Isaka ba a: Tola, Pua, Jasub a Simron. <verse eid="GEN 46:13" /><verse number="14" style="v" sid="GEN 46:14" />Abon ba nlum ba Jebulun ba a: Sered, Elon a Jaleel. <verse eid="GEN 46:14" /><verse number="15" style="v" sid="GEN 46:15" />Abon ba nlum baa, ba Lia jele ka Jekob go Padan Aram, a lˈyehke Dayina mmon ewe no nkal. Abon ba nlum, a ba nkal ebe kpee jolo eltahl ane awubu ane ara. <verse eid="GEN 46:15" /><verse number="16" style="v" sid="GEN 46:16" />Abon ba nlum ba Gad ba a: Jefon, Hagi, Suni, Ejibon, Eri, Arodi a Areli. <verse eid="GEN 46:16" /><verse number="17" style="v" sid="GEN 46:17" />Abon ba nlum ba Aser ba a: Imna, Isva, Isvi, a Beria, mmonannyehn ebo no nkal no bo jo lung-e re Sera. Abon ba nlum ba Beria ba a: Heber a Malkiyel. <verse eid="GEN 46:17" /><verse number="18" style="v" sid="GEN 46:18" />Abon kpee ba Jilpa jele no ka Jekob ba a, Jilpa ji Laban rod-e no ka Lia mmon ewe no nkal, bo kpee jolo elku a nne awohng. <verse eid="GEN 46:18" /><verse number="19" style="v" sid="GEN 46:19" />Abon ba nlum ba Rasel nkala Jekob jele no ba a: Josef a Bejamin. <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />Gona Ijib wo Asenad mmon no nkal no Potifera ji jolo nlimajom no On, jele Manase, a Efriim ka Josef. <verse eid="GEN 46:20" /><verse number="21" style="v" sid="GEN 46:21" />Abon ba nlum ba Benjamin ba a: Bela, Beker, Asbel, Gera, Naaman, Ehi, Ros, Mupim, Hupim, a Ard. <verse eid="GEN 46:21" /><verse number="22" style="v" sid="GEN 46:22" />Bo ba jolo abon ba nlum ba Rasel jele no ka Jekob, bo kpee jolo ewubu ane ani. <verse eid="GEN 46:22" /><verse number="23" style="v" sid="GEN 46:23" />Mmon no nlum no Dan wo a: Husim. <verse eid="GEN 46:23" /><verse number="24" style="v" sid="GEN 46:24" />Abon ba nlum ba Naftali ba a: Jajiyel, Guni, Jejer a Silem. <verse eid="GEN 46:24" /><verse number="25" style="v" sid="GEN 46:25" />Abon ba nlum ba Bilha jele ka Jekob ba a, Bilha ji Laban rod-e no ka Rasel mmon ewe no nkal, bo kpee jolo ane asehma. <verse eid="GEN 46:25" /><verse number="26" style="v" sid="GEN 46:26" />Ane ba toono Jekob je go Ijib, bo jolo ane atahl ara, ane arakera, bo kpee jolo etˈtohngo eje, a lˈyehke akal abon ebe bum nkpe. <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />A lˈbudu abon ba nlum abal ba Josef jele go Ijib, etˈtohngo Jekob, jolo ane atahl ara ane awubu kpe kpe. <verse eid="GEN 46:27" /><verse number="28" style="v" sid="GEN 46:28" />Jekob tumu Judah á gbo-e mbang, song goji Josef, eji á lˈsong kahn ana bo bahke sehnge song rehng go Gosen. Eji bo rehnge go ejang bio bi Gosen, <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />Josef toobo mmvtv akuungu enye tahm go Gosen song wane Isreel nde go mbang. Ana Josef nyehne nde, á kehm song bingi nde, bahk emel kun-e go ekpakebahk, soro kehme ellingi ekidi tete. <verse eid="GEN 46:29" /><verse number="30" style="v" sid="GEN 46:30" />Isreel kehm tongo Josef re, &lt;&lt;Anv wo fuumu re me n kpo, eji m ma ba nyehn antahng re wo noa kpeke li go elkpin.&gt;&gt; <verse eid="GEN 46:30" /><verse number="31" style="v" sid="GEN 46:31" />Owo Josef kehm tongo abonanyehn a anebe etahk nde kpee re, &lt;&lt;M bahke tahme song bung a Fero, m bahk-e tongo re, &lt;Abonanee, a anebe etahk nsoo kpee, bo ji lene go ndi nyi Kenan, bob ba, ba tob-m. <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />Aneblum baa, abaabebul ba, bo kpo le enyam, bob ko efong, ejoro, a ebul baange ebo ba a bi, a ejum ajehng ajehng ji bo kpi no.&gt; <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />Fero lˈlung-n fere bahb re, &lt;Eltum anii ń kpo lim?&gt; <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />Li re wahn faang-e re, &lt;Alokeltum eba kpo le atohkondi bomo ese ese tete ba rehng anv, ana babnsoo ejahre jo lim. Á bahk-n yake re wahn song jol go ejang bi Gosen, tibre eltum ebul abaabe li ebi eltum ka anebe Ijib.&gt;&gt;<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="s">Fero tˈtaame re ane ba Jekob lene go Gosen</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />Josef kehm tahme song tong Fero re, &lt;&lt;Nsoo, a abonanee, boblohng go ndi nyi Kenan ba, bo ba a efong, ejoro, a ebul baange ebo, go ejum ajehng ajehng ji bo kpi no kpee, anv bo li go ndi nyi Gosen.&gt;&gt; <verse eid="GEN 47:1" /><verse number="2" style="v" sid="GEN 47:2" />Josef yehke abonanyehn ebe na alon ko bo song tib Fero. <verse eid="GEN 47:2" /><verse number="3" style="v" sid="GEN 47:3" />Fero kehm bahbe abonanyehn Josef re, &lt;&lt;Ń kpo lim eltum anii?&gt;&gt; Bo kehm faange Fero re, &lt;Alokeltum eba abaabebul ba, jang jang ana babnsoo ejahre jolo no.&gt;&gt; <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />Bo kpe-e tong re, &lt;&lt;Wahr ebba re wahr ba jol a mongare ntiil, tibre njal kpˈgbale go Kenan atohkondi nya alokeltum eba nehme kpe bel nsol li. Titi nong alokeltum eba song jol go Gosen.&gt;&gt; <verse eid="GEN 47:4" /><verse number="5" style="v" sid="GEN 47:5" />Fero kehm tongo Josef re, &lt;&lt;Nso, a abonane ebba a ega, <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />Ndi nyi Ijib li go ega elwo; song bum nso a abonane go edi ji ga nob. Nong bo jol go Gosen. Joare nne awohng awohng go ebo ellong noa no kpi ekahmekahme ebo eltum nong bo jo kpur atohkondi nya nyame.&gt;&gt; <verse eid="GEN 47:6" /><verse number="7" style="v" sid="GEN 47:7" />Owo Josef kehm koko Jekob nde ba tib Fero. Owo Jekob kehm fuulu Fero, <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />Fero kehm-e bahbe re, &lt;&lt;Wob kang renan?&gt;&gt; <verse eid="GEN 47:8" /><verse number="9" style="v" sid="GEN 47:9" />Owo Jekob kehm tongo Fero re, &lt;&lt;Me n kang nnya atahl arakera a nnya ewubu. Aya enyame li ntiil fere rur ajahkjahk, aya nyaa biingem a aya ekul nya babnsoo ba bame.&gt;&gt; <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />Owo Jekob kehm fuulu Fero, soro lohng eje tahm. <verse eid="GEN 47:10" /><verse number="11" style="v" sid="GEN 47:11" />Josef kehm toobo edi ji nde a abonanyehn bahke jolo o Ijib, fere ka bo edi ndi, go ejang ejahbe ji ga nob, jolo ejang bio bi Rameses ana Fero tibi no. <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />Fvfo Josef tob ka nde a abonanyehn go anebe etahk nde kpee nsol alehke, toono ana nfange abon ebo jolo no.<verse eid="GEN 47:12" /></para>
  <para style="s">Ana Josef fili ane ngara njal</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />Ngare nyia nsol alehke ebmal go ajahbe nyao kpee, tibre njal gbale sehng, anebe Ijib, a anebe Kenan ebgbo awo tib njal. <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />Josef ko akpohko kpee nya jolo go Ijib, a Kenan, nya bo jo gunu nsol alehke, ba a nya go ekpasiki Fero. <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />Eji akpohko nya anebe Ijib, a anebe Kanan ma mal bo, ane kpee ba Ijib kehm bake goji Josef ba tong-e re, &lt;&lt;Ka-r nsol alehke! Anv wahr kpo go ega esamahra? Akpohko enyahre ebmal kpeeo.&gt;&gt; <verse eid="GEN 47:15" /><verse number="16" style="v" sid="GEN 47:16" />Owo Josef kehm tongo bo re, &lt;&lt;Koon atohkondi enyahne ba, m bahke koko gung-n nsol alehke, yaange asi go akpohko, eji akpohko enyahne ma mal.&gt;&gt; <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />Owo bo kehm koko atohkondi bo ba, Josef jo ko anyˈya, ejoro, ebul baange, a adahmagbudu, a ebvankang Josef jo yaange ka bo nsol alehke. Á koo ano go elya nio jo ka bo nsol alehke, á jo ko atohkondi ebo go esi akpohko. <verse eid="GEN 47:17" /><verse number="18" style="v" sid="GEN 47:18" />Eji elya nio ma sehng, bo kpe ba etoono elya, ba tong-e re, &lt;&lt;Wahr nehm ma behr elnahre go esamahr nsoo wahre, eji ma jol re akpohko enyahre ebmal, atohkondi enyahre li ka wo, ejumjum wahr kpeem kpi, sehngem re agubjing enyahre, a ndi enyahre. <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />A bahk-r yake e kpoa, ndi enyahre sa ekpehle kpehla? Gun-r, a ndi enyahre wo ko yaange fere jo ka-r nsol alehke, wahr a ndi enyahre e bahke jolo aju ka Fero. Ka-r amohk nti nya elbahme, eji e lˈkpin kˈkpo, fvfo eji ndi lˈkˈsa nnehme nehme.&gt;&gt; <verse eid="GEN 47:19" /><verse number="20" style="v" sid="GEN 47:20" />Ano wo Josef gunu ndi nyi Ijib kpee ka Fero. Anebe Ijib kpee gungu ebgbe ebo, tibre njal gbale a bo sehng. Ndi fere jol ka Fero. <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />Josef limi ane bo jol aju bomo esi ejahbe Ijib jehko tete ba rehng esˈkohlo jehka. <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />Fvfo Josef gunem adi ndi nya abalimajom, tibre abalimiajom jo bele ekakebo goji Fero jo ka bo. Bo jo bele nsol alehke gbalee go ekakebo jio ji Fero jo kak bo, owo wahnge bo ki gungu adi ndi ebo. <verse eid="GEN 47:22" /><verse number="23" style="v" sid="GEN 47:23" />Josef kehm tongo ane bao re, &lt;&lt;Anv eji m ma-n gunu a adi ndi enyahne ka Fero, kehm-n koko amohk nti elbahme wahn song bahm. <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />Ngare nyi ń lˈkehme elkpake nsol enyahne, ḿ bahke jo yehke ejum ajehng go nsol elon anyehng anyehng ba ka Fero. Wahnfono ko nsol eni eni bum elnahne go, ana amohk nya elbahme, a nya ellehke ka alaaga enyahne, a abon ebahne.&gt;&gt; <verse eid="GEN 47:24" /><verse number="25" style="v" sid="GEN 47:25" />Bo kehm bungu re, &lt;&lt;Wob tahre nkpin enyahre, nsoo nong wahr jol go eyebatahng a na; wahr bahke jolo aju ka Fero.&gt;&gt; <verse eid="GEN 47:25" /><verse number="26" style="v" sid="GEN 47:26" />Josef limi jia jol ntahm go ndi nyi Ijib, ntahm nyio nyia kpeke yim tete rehng lela re ejum ajehng go nsol elon, go nsol nkpakandi jol ka Fero. Sehngem re ndi nyi abalimajom nyi nyi ki jol ka Fero.<verse eid="GEN 47:26" /></para>
  <para style="s">Ejum ji Jekob gohro bahb</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />Ngare nyio kpee anebe Isreel jolo go Ijib go ejang erohko ji Gosen. Bo bele adi ndi gbalee, jo jel, fere sahb gbˈgbal go nrur. <verse eid="GEN 47:27" /><verse number="28" style="v" sid="GEN 47:28" />Jekob kange elku nnya ebal o Ijib, nnya kpee nyi Jekob kange no go ege elkpin jolo nnya atahl asehma a nnya esehma. <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />Eji ngare nyi Jekob yake kpo ma kabbe, á kehm lungu Josef mmon ewe fere tong-e re, &lt;&lt;Lˈjol re m bahke bele nnoobo go ega, kak ebo eba go egame a nla eyo wo nyam re, a bahk-m tibi nnoobo a ekakesehk. Kama kpa kak a ndi nyi Ijib, <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />n lˈtahm song re ekv a babnsoo, sol-m a Ijib lohng aname, wo song kak-m go eyele babnsoo.&gt;&gt; Josef kehm bungu re, &lt;&lt;M bahke limi ana a ma bung.&gt;&gt; <verse eid="GEN 47:30" /><verse number="31" style="v" sid="GEN 47:31" />&lt;&lt;Á kehm bungu re, &lt;&lt;Tir go egame esamahr,&gt;&gt; Josef kehm tiri tong-e, Isreel kehm gongo yakke esinong kak Esowo.<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s">Jekob fuulu Manase a Efriim</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />Ba jolo mongare ntiil, bo kehm tongo Josef re, &lt;&lt;Nso kpˈyame.&gt;&gt; Owo Josef kehm rodo abon abal ebe Manase abola Efriim tahm a bo goji nde. <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />Eji bo tongo Jekob re, &lt;&lt;Josef mmon ewa ebba re á ba nyehn-a,&gt;&gt; Isreel soro bel eko, mehl ji ege edilnong. <verse eid="GEN 48:2" /><verse number="3" style="v" sid="GEN 48:3" />Jekob kehm tongo Josef re, &lt;&lt;Esowo Bi Kpi Nsahm Kpee tib-m elne go Luji, go ndi nyi Kenan, edi jio wo á fuul-m no. <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />Fere tong-m re, &lt;M bahk-a limi a gbal fere rˈrur go nfange. M bahk-a koko lim ejahbe ji ane gbalee, m bahk-a kake ndi nyia ana edi jˈja go njinanjini, bahke jolo ka etˈtohngo eja ji bahk-a toono.&gt;<verse eid="GEN 48:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 48:5" />&lt;&lt;Anv, abon abal eba ba nlum ba bo jele bo ka-a a Ijib, me n kehm bake a ega, bo bahke fange bo ana abon ebame; Efriim abola Manase bahke jolo ka me jang jang ana Ruben abola Simion bo li ka-m. <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />A lˈkpe bel abon bandikandiki, bo bahke jolo ba ba, ejum elehkelkv ebo bahke sehnge goji Efriim abola Manase. <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />Eji n lohngo go Padan jo kehnge, n jolo ndon ndon ana Rashel kpo go ndi nyi Kenan ngare nyi e kpeke li go mbang, ekidi kpeem ga lab tahm rehng Efrad. N kpa-e kak nkpe a mbang nyi nne kpˈtahme go Efrad, (ji lohngo re Betlehem). <verse eid="GEN 48:7" /><verse number="8" style="v" sid="GEN 48:8" />Eji Isreel nyehne abon ba nlum ba Josef, á kehm bahbe re, &lt;&lt;A ane abaa?&gt;&gt; <verse eid="GEN 48:8" /><verse number="9" style="v" sid="GEN 48:9" />Josef kehm faange nde re, &lt;&lt;Abon ba nlum ba Esowo ma-m ka a, ba a.&gt;&gt; Owo Isreel kehm bungu re, &lt;&lt;Ko bo ba ka-m, eji n lˈfuulu bo.&gt;&gt; <verse eid="GEN 48:9" /><verse number="10" style="v" sid="GEN 48:10" />Ngare nyia Isreel amahr enye ebkehme elbamme, á nehme ga kpe nyehn tib eji á ma kul. Josef kehm jeere abon ebe kohlo nde, nde kehm sodo bo nnyo fere bingi bo. <verse eid="GEN 48:10" /><verse number="11" style="v" sid="GEN 48:11" />Isreel kehm tongo Josef re, &lt;&lt;Me n kpeem bum re m bahke kpe nyehn esamahr eba, wo anv Esowo eblim re me fere tob nyehn abon eba fvfo.&gt;&gt; <verse eid="GEN 48:11" /><verse number="12" style="v" sid="GEN 48:12" />Owo Josef kehm tabe bo go ayo Isreel nde, kehm gongo esamahr ebe go ndi. <verse eid="GEN 48:12" /><verse number="13" style="v" sid="GEN 48:13" />Josef kehm koko bo ane abal abal ba, Efriim á jabb-e go eboblum á jol go ejang ebobkal bi Isreel, Manase á jabb-e go ege egang ebobkal, a jol go ejang eboblum bi Isreel, kehm jeere bo kohlo nde Isreel. <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />Isreel kehm tanne eboblum ebe kunu Efriim go esi, jol eji á jolo jol monkalla fere siiri ebobkal ebe kunu Manase go esi, jol eji á jolo jol ngbokambang. <verse eid="GEN 48:14" /><verse number="15" style="v" sid="GEN 48:15" />Owo á kehm fuulu Josef kehm bungu re, &lt;&lt;Nong Esowo bio bi babnsoo Ebraham, a Aisik jo lok-e, Esowo bio bi ma jol mbˈbaabe no elkpin ename tete rehng lela, <verse eid="GEN 48:15" /><verse number="16" style="v" sid="GEN 48:16" />Engel nyi ma-m tahre yehke go nsol nyi jol-m limi, nong á fuulu abonse nlum baa, nong bo jo lung bo go egama mbing, a abing nya babnsoo Ebraham a Aisik, nong bo sahb gbˈgbal go njini.&gt;&gt; <verse eid="GEN 48:16" /><verse number="17" style="v" sid="GEN 48:17" />Eji Josef nyehn re nde tabe eboblum ebe kunu Efriim go esi, atahng we yebem; owo á kehm jabbe nde go ebo re á radde ebo bio go esi ji Efriim feere a bi kunu Manase. <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />Josef kehm tongo nde re, &lt;&lt;Eˈee, nsoo noa wo li ngbokambang, kun-e eboblum eba go ege esi.&gt;&gt; <verse eid="GEN 48:18" /><verse number="19" style="v" sid="GEN 48:19" />Wo nde tˈten fere tong-e re, &lt;&lt;N kpˈkahne! Mmon ewame, n kpˈkahne, ye fvfo bahke tob jol ejahbe, ye fvfo bahke tob gbal. Jol ana li o, monkalla mmonannyehn wo bahke ga gbal sehng ye, ellong ajahbe gbalee bahke lohngo ege etˈtohngo.&gt;&gt; <verse eid="GEN 48:19" /><verse number="20" style="v" sid="GEN 48:20" />Á fuulu bo efung bio fere bung re, &lt;&lt;Ega mbing wo anebe Isreel bahke jo tooro elfuulu nia re: &lt;Nong Esowo lim-n wahn jol ana Efriim a Manase.&gt;&gt;&gt; Ano wo jolo re, á rodo Efriim bum ngbokambang ka Manase. <verse eid="GEN 48:20" /><verse number="21" style="v" sid="GEN 48:21" />Owo Isreel kehm tongo Josef re, &lt;&lt;N yahke ba elkpoko, Esowo bahke jolo a nahne, fere ko-n feere a nahne go ndi nyi babnso. <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />Wo wo m ma-a ka erohko ndi ajehng kpele, sehnge ji abonane bako, erohko ndi ji n taare anebe Amor go egame ekahngkahng, a elban ename.&gt;&gt;<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s">Ana Jekob fuulu abon ebe ba nlum</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />Owo Jekob kehm lungu abon ebe ba nlum kehm bungu re: &lt;&lt;Ba jiin senng-m wahn kak me n tong-n nsol nyi bahk-n limi go afung nya kpˈbake. <verse eid="GEN 49:1" /><verse number="2" style="v" sid="GEN 49:2" />&lt;&lt;Ba kon-n asi wahn wunngu atung, abon ba nlum ba Jekob; wuungen Isreel nso ewahne atung. <verse eid="GEN 49:2" /><verse number="3" style="v" sid="GEN 49:3" />&lt;&lt;Ruben wo wo li ngbokambang a mmon ewame, eko ejame, ngbokambang elliingi ni nsahm anyame, wob gbal go ekpunu, fere gbal go nsahm. <verse eid="GEN 49:3" /><verse number="4" style="v" sid="GEN 49:4" />Wo wo li alabb ma kil jo yiimi edi ajehng, ekpunu a nehm kpe bel, tibre wob song noongo go edilnong ji nso, wob fili edilnong ji nso rannge. <verse eid="GEN 49:4" /><verse number="5" style="v" sid="GEN 49:5" />Simion abola Levi bo abonanyehn ba. Bo kpo ko akahngkahng ebo jo rannge edi. <verse eid="GEN 49:5" /><verse number="6" style="v" sid="GEN 49:6" />Nong me n kˈwoomo go ebo ellong, nong me n kˈkono asi a bo, tibre bob wul ane tib go ebo erakatahng fere banne efong akpade ana koro bo. <verse eid="GEN 49:6" /><verse number="7" style="v" sid="GEN 49:7" />Nong nkuk jol ka erakatahng ebo ji kpˈsahb sˈsum, nong nkuk jol ka erakatahng ebo ji kil elgbodo. M bahke limi bo yaame, jol go ndi nyi Jekob, fere lim bo jol adi adi go ellong ni anebe Isreel. <verse eid="GEN 49:7" /><verse number="8" style="v" sid="GEN 49:8" />&lt;&lt;Judah, abonanne bahk-a tehke; abo enya bahke jolo go emel anebekv eba. Abon ba nlum ba nso bahke jo gong ka-a. <verse eid="GEN 49:8" /><verse number="9" style="v" sid="GEN 49:9" />Judah, mmon ewame, wo li ana mmona egabe. Wob wul nnyam enya kehnge a nyi, ba rehng go ega elbad. A nong go ndi ana egabe, a kp-e lehke ana nkal egabe. Nne awoo bahke ma nyeenge egabe elkohn ngare ana nyia? <verse eid="GEN 49:9" /><verse number="10" style="v" sid="GEN 49:10" />Ejehm jio ji etul nehm tiki jo lohng go etˈtohngo ji Juda. Abon ebe bahke tiki jo jol atul, tete nfono ejehm noo no etul bahke bake, ye ji ajahbe kpee bahk-e kpunu. <verse eid="GEN 49:10" /><verse number="11" style="v" sid="GEN 49:11" />Juda bahke tohko mbvankang enye go elˈlehke egreb, á bahke kahne mmon a mbvankang go nnobo noba mbˈbo mi greb, á bahke suku akpawobo enye go amahm, esubu eje go akehng greb <verse eid="GEN 49:11" /><verse number="12" style="v" sid="GEN 49:12" />Juda bahke bele amahm elwoko gbalee, bahke wahnge amahr enye bamme, á bahke bele alahbbel ma elwoko gbalee, wahnge amahn enye bahke sahb bˈbar tib esi alahbbel. <verse eid="GEN 49:12" /><verse number="13" style="v" sid="GEN 49:13" />&lt;&lt;Jebulon bahke lene go nkpe aya, edi eje bahke jolo elga ni asohkkahng bahke jo ba tehme, nkonandi enye bahke jolo rehng go Sidon. <verse eid="GEN 49:13" /><verse number="14" style="v" sid="GEN 49:14" />Isaka li ana mbvankang nyi kpˈsahb tˈtahne, á nong go elka elka ni abam nsol. <verse eid="GEN 49:14" /><verse number="15" style="v" sid="GEN 49:15" />Á lˈnyehn ana edi erekekv eje kpˈnobo, fere nyehn ana ndi enye kpˈtob nob, á bahke tahnge akpakebo enye ka go elsol asolo, fere yake elne ka eltum ni bo bahk-e bobo re a lim. <verse eid="GEN 49:15" /><verse number="16" style="v" sid="GEN 49:16" />&lt;&lt;Dan bahke lame ane ebe go nseenga nseenge, ana etˈtohngo ajehng go ellong atˈtohngo nya Isreel. <verse eid="GEN 49:16" /><verse number="17" style="v" sid="GEN 49:17" />Dan bahke jolo nnyo go nkpea nlum mbang, ekumbad go alabmbang, ji bahke jo tokko anyˈnya go aselsel, eji ane ba kun bo bahke jo tuulu gbo feere njahmjahm. <verse eid="GEN 49:17" /><verse number="18" style="v" sid="GEN 49:18" />&lt;&lt;N kpˈsiki eltahre ena O Jehova. <verse eid="GEN 49:18" /><verse number="19" style="v" sid="GEN 49:19" />&lt;&lt;Gad, ellong abanokabohng bahke noko a ne, wo á bahke sehnge go njahm jo nok a bo. <verse eid="GEN 49:19" /><verse number="20" style="v" sid="GEN 49:20" />&lt;&lt;Edi ndi ji Aser, owo nsol alehke nyi nno bahke lohngo, ye wo bahke toobo nsol nyi bahke jo fuumu a ntul. <verse eid="GEN 49:20" /><verse number="21" style="v" sid="GEN 49:21" />&lt;&lt;Naftali li ana mbilikpa nyi bo me-e fannge go ekehd, ye ji kpo jel anobonobo abon.<note caller="+" style="f"><char style="fr" closed="false">49:21 </char><char style="ft" closed="false">Á kpi ayebeyebe alum nya elbungu.</char></note> <verse eid="GEN 49:21" /><verse number="22" style="v" sid="GEN 49:22" />&lt;&lt;Josef nlehke egreb mi bahke jo kab, ji yim kohlo elbing alahb, ji ayal enye ma taare kuumu go egbunggbung.<note caller="+" style="f"><char style="fr" closed="false">49:22 </char><char style="ft" closed="false">Josef li ana mmona mbvankang ekulugbe</char></note> <verse eid="GEN 49:22" /><verse number="23" style="v" sid="GEN 49:23" />Go ebiltim wo anebelkv ba nok a ne; bo bahk-e take elban go eblum eblum. <verse eid="GEN 49:23" /><verse number="24" style="v" sid="GEN 49:24" />Wo elban ene bahke sake ano ano, atahntahn abo enye bahke sake kpan yiimi, tib go ebo bi Etahntahn Nne no Jekob, tib esi Mbaabebul: ye ji li Ekpartal ji Isreel. <verse eid="GEN 49:24" /><verse number="25" style="v" sid="GEN 49:25" />Tib esi ji Esowo bi nso, ye ji kak-a ebo, tib esi ji Nne no Gbale Sehng, ye ji ka-a nfuulu nyi lohng go ero, a nfuulu nyi wob go atahng ndi, nfuulu nyi abel a ejˈjele. <verse eid="GEN 49:25" /><verse number="26" style="v" sid="GEN 49:26" />Elfuulu ni nso kpˈgbale sehnge elfuulu ni babnsoo ejame, sehnge rehng go ero egburu ewong ji ma sahb kˈkul.<note caller="+" style="f"><char style="fr" closed="false">49:26 </char><char style="ft" closed="false">Elfuulu ni nso gbale sehnge elfuulu ni lohng go egburu awong nya ma sahb kˈkul, fere gbal sehnge nobo ejum ajehng ajehng ji lohng go awong nya mahne mahne.</char></note> Nong elfuulu nia kpee kuumu Josef go esi, go elka esi ji nne bo m-e ga kpunu go ellong abonanyehn. <verse eid="GEN 49:26" /><verse number="27" style="v" sid="GEN 49:27" />&lt;&lt;Benjamin li ana ejo ji kpo bob atem enyam jaake, efungfu á kpo li nnyam nyi á bobo no, ngare elgung á kpo bak bi á ma da.&gt;&gt; <verse eid="GEN 49:27" /><verse number="28" style="v" sid="GEN 49:28" />Ane baa kpee ba li ewubu etˈtohngo ebbal bi anebe Isreel, a wo li nsol nyi ndea bo tongo bo, á fuulu nne awohng awohng elkohn elfuulu ana ni fuumu a ne.<verse eid="GEN 49:28" /></para>
  <para style="s">Elkv ni Jekob</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />Owo á kehm tubu bo elle nia re, &lt;&lt;M bahke gulu eltahme song kpiri ane ebame, song kak-m wahn go eyele ji babnsoo wob no, go egohng atal, go ekulugbe ji Efron nnea Hid, <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />egohng atal jio li go Makipela kohlo Mamre go Kenan, edi ji Ebraham gunu ekulegbe budu edi eyele akvne goji Efron nne Hid. <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />O edi jio wo bo kake Ebraham abola Sara nkal ewe, o edi jio wo bo kake Aisik abola Rebeka nkal ewe, o edi jˈnehm wo n kake Lia. <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />Edi egbe jio a egang ji li o bo gunu goji nne a Hid.&gt;&gt; <verse eid="GEN 49:32" /><verse number="33" style="v" sid="GEN 49:33" />Eji Jekob ma tub abon ebe ba nlum elle mal, á kehm fehde akpade enye kunu edilnong soro v esˈkohro elv kpo song kpiri ane ebe.<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />Josef kehm gboko bulu nde fere jo ling-e. <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />Josef kehm tongo abalimakahm ba jolo o re, bo rod nde taame akehng nkvne kuuru go ekpˈkpa eji á lˈkˈrannge. Owo abalimakahm kehm lohko lim ano, <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />Bo ko nfung atahl abal kohro kohro nyi li afung nya bo kpo ko kuuru akvne go ekpˈkpa. Anebe Ijib noongo elkv ene nfung atahl ara a nfung nfung ewubu. <verse eid="GEN 50:3" /><verse number="4" style="v" sid="GEN 50:4" />Eji afung elkv anoongo ma sehng, Josef kehm tongo anebe etahk Fero re, &lt;&lt;Ń lˈjol go eyebatahng a name, lub tongen Fero ka-m, tong-n ye re <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />&lt;Nsoo limi re me n tir ko nwongo a ne re, &lt;&lt;N yake ba elkpoko; song kak-m go elahm bi n rahme bum elname go ndi nyi Kenan.&gt;&gt; Anv, nong me n tahm go song kak Nsoo; m bahke feere ba.&gt;&gt;&gt; <verse eid="GEN 50:5" /><verse number="6" style="v" sid="GEN 50:6" />Fero kehm-e tongo re, &lt;&lt;Song wo song kak Nso, ana á lim-a no a ko nwongo a ne.&gt;&gt; <verse eid="GEN 50:6" /><verse number="7" style="v" sid="GEN 50:7" />Owo Josef kehm tahme re a song kak nde. Atubesi alimeltum ba Fero kpee mehle toon-e, anebkul etahk Fero a alahmlahm anebe Ijib. <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />Ane kpee ba jolo nlaaga nyi Josef, a abonanyehn ba nlum, go ane ba jolo ka nlaaga nyi nde je a ne, sehngem abon ebo, a efong, ejoro, a ebul baange, bo ba sa go Gosen. <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />Amvtv akuungu a ane ba kpo fing bo, bo tob toon-e, jolo egburu ellong ane. <verse eid="GEN 50:9" /><verse number="10" style="v" sid="GEN 50:10" />Eji bo rehnge go edi ji bo kpo ruumu nkohlsal go Atad kohlo aya Jodan bo kpe kehme ellingi wahre wahre wahre sahb mˈmaange bo. O edi jio Josef bumu nfung esehma nyi a ko noongo elkv nde. <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />Eji anebe Kenan ba lene o nyehne elkohn aling nya jolo edi ji bo kpo ruumu nkohlsak go Atad bo bungu re, &lt;&lt;Anebe Ijib kpi egburu elkv lim o.&gt;&gt; Owo wahnge edi jio ji jolo kohlo aya Jodan bo kpo lung re, Abel Mijiraim.<note caller="+" style="f"><char style="fr" closed="false">50:11 </char><char style="ft" closed="false">Ebel Mijiraim lohngo re, elkv anoongo ni anebe Ijib.</char></note> <verse eid="GEN 50:11" /><verse number="12" style="v" sid="GEN 50:12" />Ana wo abon ba nlum ba Jekob limi ana á tongo bo: <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />Bo sol-e tahm a ne go ndi nyi Kenan song kake go egohng edi egbe ji Makipela, kohlo Mamre, ji Ebraham gunu budu edi egbe goji nnea Hid, re jol eyele akvne. <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />Eji Josef ma kak nde, á kehm feere go Ijib, a abonanyehn, go ane kpee ba toon-e je re á song kak nde.<verse eid="GEN 50:14" /></para>
  <para style="s">Josef kake abonanyehn eltim</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />Eji abonanyehn Josef nyehne re ndea bo ebkpo, bo kehm bungu re, &lt;&lt;Anv Josef lˈrak atahng tob-r, fere bong-r go asoodo kpee nya e m-e soodo mee?&gt;&gt; <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />Owo bo kehm tumu ellum tv Josef re, &lt;&lt;Nso tahme nle nyia sa, kehm kpoko: <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />&lt;Ji ji a ji ḿ bahke bungu tong Josef: m bahb-a re wo tahm ka abonane go abˈbi, a asoodo nya bo lim-a no, eji bo sab-a go elfili.&gt; Anv, titi lub tahm ka abˈbi, nya alokeltum ba Esowo bio bi nso.&gt;&gt; Eji etib ba kpiri Josef, á kehme ellingi. <verse eid="GEN 50:17" /><verse number="18" style="v" sid="GEN 50:18" />Abonanyehn kehm bahke ba gbo noong-e alata, kehm bungu re, &lt;&lt;Wahr aju enya nya.&gt;&gt; <verse eid="GEN 50:18" /><verse number="19" style="v" sid="GEN 50:19" />Josef kehm tongo bo re, &lt;&lt;Kana kpe fahl. Anv me n ko nji nyi Esowoa? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />Ń gare re wahn lim-m ebi ejum, wo Esowo ebfere kpiidi lim nnoobo re jol ji kpˈlimi a, eltahre ni elkpin ane gbalee. <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />Fvfo kana kpe fahl. M bahk-n leke, a abon abon ebahne.&gt;&gt; Á kpe tuungu bung a bo, á bungu a bo yebe yebe.<verse eid="GEN 50:21" /></para>
  <para style="s">Elkv ni Josef</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />Josef jolo o Ijib, a nnahb a nde kpe. Á kange nnya atahlalon a nnya ewubu. <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />Fere nyehn etoono eying ebra ji abon ba nlum ba Efriim. Fvfo a abon ba nlum ba Makir mmon a Manase jele kunu Josef go ayo. <verse eid="GEN 50:23" /><verse number="24" style="v" sid="GEN 50:24" />Josef kehm tongo abonanyehn re, &lt;&lt;N yahke ba elkpoko. Fvfo Esowo bahke bake ba tob-n fere yehk-n ndi nyia tahm a nahne go ndi nyi á nyame ko nwongo a Ebraham, Aisik go Jekob.&gt;&gt; <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />Josef limi abon ba nlum ba Isreel tir ko nwongo bung rea,&lt;&lt;Esowo bahke tiki ba ba tob-n, ḿ bahke solo akahb enyame lohng a nya edi jia.&gt;&gt; <verse eid="GEN 50:25" /><verse number="26" style="v" sid="GEN 50:26" />Josef kpoo eji á ma kang nnya atahl alon a nnya ewubu. Bo taame ngubjing enye akehng nkvne kak-e ekpˈkpa, bo kak-e go elkohl o Ijib.<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>