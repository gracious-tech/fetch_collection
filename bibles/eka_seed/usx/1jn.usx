<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Ekajuk New Testament</book>
  <para style="h">1 Jon</para>
  <para style="toc1">1 Jon</para>
  <para style="toc2">1 Jon</para>
  <para style="mt2">1 NWER NYI</para>
  <para style="mt1">JON</para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">Alum nya elkpin</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />E kpꞌnyono Alum nya elkpin tv-n, nyao nya jolo go mboma mbomo, nya e ma wuk, fere nyehn go egahre amahr. Wahr ebnyehn, fere kooro go egahre abo.<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Jon 1:1,14</char></note> <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />Elkpin nio eblohng ba, wahr ebnyehn. Owo wahng ka e kpꞌyiimi ntianse, jo tong-n bade elkpin ni li go njinanjini, ni jolo a Nsoo, ma fere lohng ba, e ma nyehn. <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />Nyao nya e ma nyehn, fere wuk, nyanehm o nya e kpꞌtob tong-n fvfo, eji ń lꞌbel elkoono a nahre, elkoono nio ni e kpi no a Esowo abola Jisos Kraist Mmon ewe. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />E kpꞌnyono ana tv-n, eji eyebatahng ejahre lꞌsahb gbꞌgbal.<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">Jon 15:11</char></note><verse eid="1JN 1:4" /></para>
  <para style="s">Esowo ellennge ni</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />Etib bi ana bi e wuku goji Mmon ewe, bi bi e kp-n tiingi re, Esowo ellennge ni. Go ege, ejannge ajehng ajehng limm.<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">Jems 1:17</char></note><verse eid="1JN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 1:6" />E lꞌtong re, e li go elkoono a Esowo, fere jo jen go ejannge, wahr ebkim efahnge. Elkpin enahre lohkem li go etingitingi. <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />E lꞌjen go ellennge, ana yefono antahng li go ellennge, e kpi elkoono atemtem. Alung ma Jisos Mmon ewe bahke jo ru ntim abiafem enyahre kpee.<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">Hib 9:14; Ell 1:5</char></note><verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />E lꞌtong re, abiafem anyehng anyehng e kpimm, e kpi elnahre nehm. Etingitingi go egahre atahng wobem. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />E lꞌfvvrv abiafem enyahre, ye li nkakesehk a nne no li go etingitingi, á bahke tahme ka-r go egahre abiafem, fere ru ntim enyahre, laade abꞌbi kpee.<verse eid="1JN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1JN 1:10" />E lꞌtong re, wahr abiafem e ka lim a lim, lohngo re, wahr ebrod Esowo bum ana nkimfahnga nne.<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">Rom 3:10; Jems 3:2</char></note> Alum enye go egahre atahng wobem.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">Kraist wo li nkakebo ewahre</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />Abon ebame, n kpꞌnyono ana tv-n re wahn kꞌlim abiafem. Nne awohng awohng ewahre no lꞌfere lim abiafem, Jisos Kraist ji nne no nno bahke gboongo Nsoo ka-e.<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">Rom 8:34; Hib 7:25</char></note><verse eid="1JN 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1JN 2:2" />Tibre Jisos wo gongo Esowo ka-r tib go egahre abiafem, abiafem nyanyahre nya nya sang, tob li ka abiafem nya njini kpee.<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">Kol 1:20</char></note><verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />E lꞌbum atahm nya Jisos, owo e bahke sahb kꞌkahn re, e kp-e lohko kahn. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />Nne no lꞌtong re, “N kp-e kahne,” kꞌfere bum atahm enye, ye nkimfahnga nne wo. Etingitingi go ege atahng wobem. <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />Nne awohng awohng no lꞌbum alum enye, ye wo, elkoro ni Esowo kp-e koro ma biingi go nseenge. Lꞌjol ano, e bahke lohko kahn re, e wob-e go atahng.<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">Jon 14:21,23</char></note> <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />Nne no lꞌtong re, á li a Jisos, nobo re eljini ene jol ana ni Jisos.<verse eid="1JN 2:6" /></para>
  <para style="s">Ntahm nyi nfenfe</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />Akpondahme enyame, n nehme nyon na ntahm nyi nfenfe tv-n. N kpꞌnyono nkꞌkula ntahm tv-n, nyio nyi ḿ bele go mbomannahb. Nkꞌkula ntahm nyio li ellum ni ḿ ma tohko wuk.<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">Jon 13:34</char></note><verse eid="1JN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 2:8" />N kpꞌkpeke tob nyon ntahm nyi nfenfe fvfo tv-n, nyio nyi li etingitingi jio ji nne bahke ma nyehn goji Jisos, fere nyehn go egahne fvfo. Tibre ejannge kpꞌmale, etingitingi ellennge ni ma fere kehme elyake.<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />Nne no lꞌtong re, á kpꞌjene go ellennge, fere jo ko mmonannyehn ekv, á li nne no kpeke wob go ejannge. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />Nne no mmonannyehn lꞌkor-e, á li nne no kpi njene njene go ellennge. Nne noo, ejumjum á kpimm ji bahke limi nne noko gbo yel abiafem. <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />Nne no lꞌko mmonannyehn ekv, á jehk go ejannge, fere kpꞌjene go ejannge. Á kpehme kahn edi ji á fi no. Tibre ejannge m-e tehm go amahr, á nehme nyehn.<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />N kpꞌnyono nwer nyia tv-n, abon ebame, tibre wahn ebbel eltahmeka go egahne abiafem tib go esi mbing nyi Kraist. <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />N kpꞌnyono nwer nyia tv-n, babnsoo, tibre ń kpꞌkahne nne no jolo go mbomannahb. N kpꞌnyono nwer nyia tv-n, ajangkun tibre wahn ebsehnge Ebinne jio. N kpꞌnyono nwer nyia tv-n, abon ebame, tibre wahn kpꞌkahne Esowo Nsoo.<verse eid="1JN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14" />N kpꞌnyono nwer nyia tv-n, babnsoo, tibre wahn kpꞌkahne nne no jolo go mbomannahb. N kpꞌnyono nwer nyia tv-n, ajangkun, tibre wahn kpꞌtahne, alum Esowo nyaa, wob go egahne atahng, wahn ebsehnge Ebinne jio.<verse eid="1JN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />Nong, njini kꞌjo kor-n, jol ejum ajehng ajehng ji li go njini. Nne awohng awohng no njini nyia lꞌkor-e, elkoro ni Nsoo go ege atahng wobem.<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">Jems 4:4; Rom 12:2</char></note> <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />Ejum ajehng ajehng ji li go njini nyia, ji ane kpo yehke amahr ebo kunu, a ekor nsol ngubjing, go nsol nyi ane kpo geere kak, nyao ona kpee lohngem goji Nsoo, lohng go njini nyia. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />Njini nyia bahke male kpee, a ejum ajehng ajehng ji li go njini, ji ane kpo seb re bo bel. Nne no lꞌlim mbang nyi Esowo, ye wo bahke kpini go njinanjini.<verse eid="1JN 2:17" /></para>
  <para style="s">Nnekv no Kraist</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />Abon ebame, esꞌkohro ngare nyi ma rehng a. Wahn ebwuk re, Nnekv no Kraist bahke bake. Jol anv, anebekv ba Kraist ebba gbalee.<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false">Mat 24:5,24</char></note> Owo wahnge e ma lohko kahn re, esꞌkohro ngare nyi ma rehng a. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />Ane bao lohngo go egahre ellong, tibre bo jolo ane ba woomo go egahre ellong go nnyo a nnyo, jol ntim ebo, go egahre woomem. Li re bo lohko woomo go egahre ellong a ntim a ntim ebo, kehn bo jol soro asi a nahre. Wo anv, boblohng, eji lꞌlohko tib re, bo ane kpee lohkem woomo go egahre ellong.<note caller="+" style="f"><char style="fr" closed="false">2:19 </char><char style="ft" closed="false">Elt 20:30</char></note><verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />Wahn ba li ane ba Esowo ma yaange Etingi Etohko wohng-n, owo wahnge ń kpꞌkahne ejum ajehng ajehng. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />N kpꞌnyono nwer nyia tv-n, lohngem re wahn, etingitingi ń nehme kahn, ń kpꞌkahne. Fvfo, ń kpꞌtob kahn re, efahnge ajehng ajehng limm, ji kpo lohng go etingitingi.<verse eid="1JN 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22" />Nne awo li Nkimfahnga nne noo? Nne no kil eltaame re, Jisos wo li Kraist, fere ten Nsoo, a Mmon, ye wo li Nnekv no Kraist.<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">2 Tes 2:3-10; Ell 13</char></note> <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />Nne no lꞌten Mmon, yebtob ten Nsoo. Nne no lꞌtaame tv Mmon, Nsoo wob-e go atahng.<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">Jon 5:23; 14:1</char></note><verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />Nong, alum nya ń wuku go mbomannahb jol go egahne atahng. Nyao nya ń wuku go mbomannahb lꞌfere woomo go egahne atahng, ḿ bahke jolo ajehng a Nsoo, fere jol ajehng a Jisos Mmon ewe. <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />Elkpin ni li go njinanjini ni, Jisos nyame re á bahk-r kake.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />N kpꞌnyono nwer nyia tv-n, tib ane bao ba kpꞌgare re bo nehm-n. <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />Tibre Etingi Etohko ji Esowo ma yaange wohng-n jia a nahne. Ń nehme kpe seb nne awohng awohng no bahk-n tibi. Etingi Etohko kpo tib-n ejum ajehng ajehng. Nsol nyi á kpo tib-n lohko li go etingitingi, afahnge sang. Jo bumen eltibi nio ni Etingi Etohko kp-n tibi, wahn sa ano a Kraist.<note caller="+" style="f"><char style="fr" closed="false">2:27 </char><char style="ft" closed="false">Jon 16:13</char></note><verse eid="1JN 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />Abon ebame, saan ano a ne, eji e lꞌjol esahb esahb efung bi á bahke feere ba. Nong, wahr kꞌfeere njahm efung bio ana ane ba bo ma riki bo ndon.<verse eid="1JN 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1JN 2:29" />Eji ḿ ma kahn re, Kraist li go etingitingi, nobo re wahn tob kahn re, nne awohng awohng no lꞌjo lim etingitingi, á li mmon Esowo.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">Abon Esowo</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />Nyehnen egburu elkoro ni e kpꞌkoro Esowo, eji bo kp-r lungu re abon ba Esowo. E lohko li ano go etingitingi. Ejum ji wahnge njini nyia kil-r elkahne li re, bo ka kahn Esowo.<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">Jon 16:3</char></note><verse eid="1JN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1JN 3:2" />Akpondahme enyame, anv, wahr ebjol abon Esowo. Ka tiki lennge ana e bahke jolo. E kpꞌkahne re, Kraist lꞌba, e bahke yaange, jol ana ye. Tibre e bahk-e nyehne ana á li no.<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">Kol 3:4</char></note> <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />Nne awohng awohng no ekunukpu eje li goji Kraist, á kpo bum elne saang, ana yefono Kraist li saang.<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />Nne awohng awohng no ma lim abiafem, yebrange ntahm nyi Esowo. Tibre abiafem li ejum ji kpo range ntahm nyi Esowo. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />Ń kpꞌkahne re, Kraist ba re á ba sol abiafem enyahre tahm a nya. Abiafem anyehng anyehng go ege atahng wobem. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />Nne awohng awohng no lꞌjol a Kraist, á nehm kpe jo lim abiafem. Nne awohng awohng no lꞌjo lim abiafem, á ka nyehn Kraist, jol we á ka kahn.<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />Abon ebame, kana taame re, nne awohng awohng nehm-n. Nne no lꞌjo lim etingitingi, á li etingitingi nne, jang jang ana yefono Kraist li etingitingi nne. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />Nne no lꞌjo lim abiafem, á li ka nnehm, tibre nnehm bomo abiafem alimi go mboma mbomo. Ejum ji wahng ka Mmon no Esowo ba no, á ba re á ba rannge eltum ni nnehm. <verse eid="1JN 3:8" /><verse number="9" style="v" sid="1JN 3:9" />Nne awohng awohng no Esowo jel-e no limm, no kpo kpe lim abiafem. Tibre yefono Esowo antahng bia a ne. Á nehm kpe ma sa go abiafem, tibre Esowo bi jel-e no.<verse eid="1JN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1JN 3:10" />Ana wo nne bahke ma liingi nne no li mmon Esowo, fere liingi nne no li mmon a nnehm. Nne awohng awohng no mmonannyehn tohk-e kor, kꞌfere lim ji li go etingitingi, ye mmon Esowo sang.<verse eid="1JN 3:10" /></para>
  <para style="s">Belen elkoro atemtem</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />Tibre etib bi ana, bi ń wuku go mbomannahb, bi bungu re, wahr tiki bel elkoro atemtem, <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />wahr kꞌjol ana Ken ji jolo ka Ebinne, fere wul mmonannyehn. Jen ji wahnge á kehm-e wulu? Tibre nsol nyi á jo lim, joom nob. Nsol nyi mmonannyehn jo lim nyi nyi jo nob.<verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />Abonanee, kiin jo kpo esi re njini nyia kp-n koko ekv.<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Jon 15:18; Mat 5:11</char></note> <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />E kpꞌkahne re, wahr ebsehng go elkv rehng go elkpin, tibre abonanee kpo kor-r kor. Nne no ki kpi elkoro, á kpeke li go elkv. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />Nne awohng awohng no lꞌko mmonannyehn ekv, á li nwulane. Ń kpꞌkahne re, nwulane awohng awohng limm, no kpi elkpin ni li go njinanjini go ege atahng.<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">Mat 5:22</char></note> <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />Ana wo wahnge e ma kahn ana elkoro li no, tib eji Kraist yake elkpin ene ka, tib go egahre esi. Owo tob fuumu re, wahr tob yake elkpin enahre ka go esi ji abonane ejahre.<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">Jon 3:16; 15:13</char></note><verse eid="1JN 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1JN 3:17" />Lꞌjol re nne ebfang afang nya njini nyia, á lꞌnyehn mmonannyehn ejum m-e lehng, á lꞌlahm re, we á nehm ka, á bahke ma bung renan re, elkoro ni Esowo nia, wob-e go ege atahng?<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">Jems 2:15-16</char></note> <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />Abon ebame, nong, wahr kꞌbel elkoro go alum nnyo nya nya, wahr belen etingitingi elkoro ni kpo lohko lim etingitingi.<verse eid="1JN 3:18" /></para>
  <para style="s">Esahb go esamahr bi Esowo</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />Ana wo e kpꞌkahne re, e li ka etingitingi jio. Ana wo e bahke goomo ntim enyahre, yiimi go esamahr bi Esowo. <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />Ngare anyehng anyehng nyi ntim enyahre lꞌka-r ebi, owo e bahke kahne re, Esowo gbale sehnge ntim enyahre, á kpꞌkahne ejum ajehng ajehng. <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />Akpondahme enyame, ntim enyahre tohk-r ka ebi, e kpi esahb go esamahr bi Esowo.<note caller="+" style="f"><char style="fr" closed="false">3:21 </char><char style="ft" closed="false">Rom 5:1-2</char></note> <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />E kpo bel ejum ajehng ajehng ji e lꞌbahb-e, tibre e kpꞌbumu alum enye, fere jo lim ji kp-e koro.<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">Jon 15:7</char></note> <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />Atahm enye nya a, nya li re, wahr taame tv Jisos Kraist Mmon ewe, fere bel elkoro atemtem, ana á tong-r no.<note caller="+" style="f"><char style="fr" closed="false">3:23 </char><char style="ft" closed="false">Jon 6:29</char></note><verse eid="1JN 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 3:24" />Ane kpee ba kpꞌbumu atahm enye, bo wob-e go eltim, ye tob wob go bo a ntim. Ana wo e kpꞌkahne re Esowo wob-r go egahra ntim, tib á ma-r ka etohko eje.<note caller="+" style="f"><char style="fr" closed="false">3:24 </char><char style="ft" closed="false">Rom 8:9</char></note><verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">Etingi Etohko, a nkimfahnge etohko</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />Akpondahme enyame, kana jo taame tv etohko ajehng ajehng! Jo wuungen atohko, wahn jo seb kahn, joare bo lohng goji Esowo.<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">1 Kor 14:29; 1 Tes 5:21</char></note> Tibre akimfahnge abanyehnamahr gbalee eblohng kpꞌyannge go njini nyia. <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />Ana wo ḿ bahke kehm kahne, joare etohko jio ji Esowo ji. Etohko ajehng ajehng ji lꞌyiimi ntianse re Jisos Kraist ba, ba ko ngubjing nyia nyi nne, etohko ana jio ji lohng goji Esowo. <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />Etohko ajehng ajehng ji tohko fere yiimi ntianse ka Jisos, lohngem goji Esowo. Etohko jio, Nnekv a Kraist wo, ye jio ji ḿ ma wuk re á kpꞌbake. Tibre etohko jio ebsi bꞌba anv a.<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">1 Jon 2:18,22</char></note> <verse eid="1JN 4:3" /><verse number="4" style="v" sid="1JN 4:4" />Abon ebame, wahn li ka Esowo. Wahn ebsehnge akimfahnge abanyehnamahr bao. Tibre etohko jio ji wob-n go egahne atahng kpi nsahm sehnge etohko jio ji li go njini. <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />Abanyehnamahr bao li ka njini, owo wahnge alum nya bo kpo bung li nya njini. Owo fvfo, njini kpo wuungu bo atung.<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">Jon 15:19</char></note> <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />Wahr li ka Esowo. Nne awohng awohng no lꞌkahn Esowo kpo wuung-r atung. Nne no ki li ka Esowo, wahr á kpehme wuungu atung.<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">Jon 8:47</char></note> Ana wo wahr bahke kahne Etingi Etohko, fere kahn etohko ji kpo kiimi afahnge.<verse eid="1JN 4:6" /></para>
  <para style="s">Esowo elkoro ni</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />Akpondahme enyame, nong wahr bel elkoro atemtem, tibre elkoro lohng goji Esowo. Nne no lꞌbel elkoro, Esowo bi jel-e no. Á kpꞌkahne Esowo. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />Nne no ki kpi elkoro, Esowo á nyimm. Tibre Esowo elkoro ni.<verse eid="1JN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 4:9" />Ana wo Esowo tib-r elkoro ene, eji á tumu mmon mmon awohng ewe tv go njini nyia, eji á lꞌba ka-r elkpin.<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">Jon 3:16</char></note> <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />Ana wo elkoro li no. Lohngem re wahr ba, Esowo kor-r no. Wahr ba koro na Esowo, owo á kehm tumu mmon ewe, ba kpo go egahre esi, eji á lꞌgong-e tib go egahre abiafem.<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />Akpondahme enyame, Esowo, wahr lꞌkor-e ano, nobo re wahr tob bel elkoro atemtem.<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false">Mat 18:33</char></note> <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />Nnene limm, no ma nyꞌnyehn Esowo. E lꞌbel elkoro atemtem, Esowo wob-r go egahra ntim, fere lim elkoro ene gbal go egahre ntim, fere jol go nseenge.<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />Ana wo e kpꞌkahne re, wahr wob-e go ege atahng, á tob wob-r go atahng, tibre á ma-r ka etohko eje. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />Wahr ebnyehn, fere yiimi ntianse re, Esowo Nsoo tumu mmon ewe re, á ba jol ntꞌtahre no njini.<verse eid="1JN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 4:15" />Nne awohng awohng no lꞌyiimi ntianse re, Jisos Mmon Esowo wo, Esowo wob-e go ege atahng, á tob wob Esowo go atahng. <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />Owo fvfo, e kpꞌkahne, fere taame tv elkoro ni wahr koro Esowo. Esowo elkoro ni. Nne no lꞌbel elkoro, á wob Esowo go atahng, Esowo tob wob-e go atahng. <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />E tohko fahl, e lꞌyiimi go esamahr bi Esowo efung elam bi kpꞌbake, lohngo re, elkoro enahre ebgbal kpee, biingi go nseenga nseenge. Tibre ana Kraist li no, ano wo fvfo e bahke tob jol go njini nyia.<verse eid="1JN 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 4:18" />Elkoro, elfahle anehng anehng kpimm. Etingitingi elkoro ni nno a nno kpo kam efahlfahl yake go. Tibre elfahle kpo jen a erem. Nne no kpo fahl, elkoro ene ka gbal, biingi go nseenge.<note caller="+" style="f"><char style="fr" closed="false">4:18 </char><char style="ft" closed="false">Rom 8:33-39</char></note> <verse eid="1JN 4:18" /><verse number="19" style="v" sid="1JN 4:19" />E kpi elkoro, tibre Esowo, wahr ba gbo mbang kor-e.<verse eid="1JN 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 4:20" />Nne awohng awohng no lꞌtong re, “Esowo kp-m koro!” fere jo ko mmonannyehn ekv, ye nkimfahnga nne wo. Eji mmonannyehn no á kp-e nyehne kil-e elkoro, Esowo bahk-e koro renan, ye ji á kal-e nyꞌnyehn?<verse eid="1JN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 4:21" />Ntahm nyi ana, nyi Kraist ka-r no, nyi bungu re, Nne no Esowo lꞌkor-e, nobo re mmonannyehn tob kor-e.<note caller="+" style="f"><char style="fr" closed="false">4:21 </char><char style="ft" closed="false">Mak 12:29-31</char></note><verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">Nne awo bahke ma ga njini nya?</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />Nne awohng awohng no lꞌtaame re, Jisos wo li Kraist, ye mmon Esowo wo. Nne awohng awohng no nde lꞌkor-e, mmon ewe bahk-e tob kor.<verse eid="1JN 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1JN 5:2" />Esowo lꞌkor-r, e lꞌbum atahm enye, ana wo e bahke kahne re, abon Esowo kp-r koro. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />E lꞌbum atahm enye, jia lohngo re, á kp-r koro.<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">Jon 14:15</char></note> Atahm enye riidem.<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">Mat 11:30</char></note> <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />Nne awohng awohng no Esowo jel-e no, á kpꞌgake njini nyia. Eltaame enyahre ni e kpꞌtaame ni wahnge e kpꞌgake njini nyia. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />Nne awo bahke ma ga njini nyia? Nnene limm, sehngem nne no kpꞌtaame re, Jisos wo li Mmon Esowo, ye wo bahke ma ga njini.<verse eid="1JN 5:5" /></para>
  <para style="s">Ntianse nyi Jisos Kraist</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />Jisos Kraist wo li nne no ko alahb, a alung ba a ma. Á koom alahb ma ma ba a ma. Á ko alahb ba a ma, a alung.<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">Jon 19:34</char></note> Etingi Etohko ji li ntianse, tibre Etingi Etohko, etingitingi ji. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />Li ntianse era, <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />Etingi Etohko,<note caller="+" style="f"><char style="fr" closed="false">5:8 </char><char style="ft" closed="false">Mat 3:16</char></note> a alahb,<note caller="+" style="f"><char style="fr" closed="false">5:8 </char><char style="ft" closed="false">Mat 3:14-15</char></note> go alung.<note caller="+" style="f"><char style="fr" closed="false">5:8 </char><char style="ft" closed="false">Ef 1:7</char></note> Bo kpee ebtaame bum nnyo amehng.<verse eid="1JN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 5:9" />E kpo taame tv alum ntianse nya nne kpo bung. Esowo lꞌyiimi ntianse, ntianse nyio nyi bahke ga tahne, nyi á yiimi ka Mmon ewe. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />Nne no lꞌtaame tv Mmon ewe, á kpi ntianse nyio go ege eltim.<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">Rom 8:16</char></note> Nne no tohko taame tv Esowo, yebrod Esowo bum ana nkimfahnga nne. Tibre á taamem tv ntianse nyi Esowo yiimi no ka Mmon ewe. <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />A wo li ntianse nyi li re, Esowo ma-r ka elkpin ni li go njinanjini. Elkpin nio ni li goji Mmon ewe.<verse eid="1JN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 5:12" />Nne no lꞌko Mmon, á kpi elkpin. Nne no tohko ko Mmon no Esowo, elkpin á kpimm.<verse eid="1JN 5:12" /></para>
  <para style="s">Elkpin ni li go njinanjini</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />N kpꞌnyono nwer nyia tv wahn ji ma taame tv mbing nyi Mmon no Esowo, eji ń lꞌkahn re, ń kpi elkpin ni li go njinanjini. <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />Ana wo e kpo sahb Esowo, tibre e lꞌbahb ajehng ajehng ji kor-e no, á kpo wuk-r wuk.<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">Jon 15:7</char></note> <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />E lꞌkahn re, ajehng ajehng ji e lꞌbahb-e, á kpo wꞌwuk, e kpꞌtob kahn fvfo re, e bahke bele ajehng ajehng ji e lꞌbahb-e.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />Nne awohng awohng no lꞌnyehn mmonannyehn ma lim abiafem nya ki li nya elkv, nobo re á kak ero ka Esowo. Esowo bahke fere ka-e elkpin. Jia li ka ane bao ba ki lim abiafem nya elkv. Abiafem nyandiki nya elkv nya. Me, wahn n tongem re, wahn kak ero ka Esowo bade elkohn abiafem nyao.<verse eid="1JN 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1JN 5:17" />Ebꞌbi ajehng ajehng, abiafem nya. Elkohn abiafem nyandiki nyaa, nya ki li nya elkv.<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="ft" closed="false">Mat 12:32; Hib 6:4-6</char></note> <verse eid="1JN 5:17" /><verse number="18" style="v" sid="1JN 5:18" />E kpꞌkahne re, nne awohng awohng no Esowo jel-e no kpehme lim abiafem. Nne no Esowo jel-e no, Jisos wo kpo baab-e. Ebinne jio we nehm ma lim ejumjum.<note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false">Jon 10:28-29</char></note> <verse eid="1JN 5:18" /><verse number="19" style="v" sid="1JN 5:19" />Wahr kpꞌkahne re, wahr li ka Esowo. Njini nyia kpee wob go elwo ni Ebinne jio.<note caller="+" style="f"><char style="fr" closed="false">5:19 </char><char style="ft" closed="false">Luk 4:6</char></note> <verse eid="1JN 5:19" /><verse number="20" style="v" sid="1JN 5:20" />Wahr kpꞌkahne re, Mmon Esowo ebba, ba ka-r elkahne, eji e lꞌkahn Esowo bio bi li go etingitingi. E wob nne nno no li go etingitingi go atahng, a Jisos Kraist Mmon ewe. Ye wo li etingitingi Esowo, a elkpin ni li go njinanjini.<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">Jon 20:28; Rom 9:5</char></note><verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />Abon ebame, yaamen a eblom!<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>