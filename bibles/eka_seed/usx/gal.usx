<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Ekajuk New Testament</book>
  <para style="h">Galesa</para>
  <para style="toc1">Galesa</para>
  <para style="toc2">Gal</para>
  <para style="mt2">NWER NYI POL NYONO TV</para>
  <para style="mt2">ANEB ERO BA LI GO</para>
  <para style="mt1">GALESA</para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="nb">
    <verse number="1" style="v" sid="GAL 1:1" />Me Pol wo ji li ntiingetib no nne ki-m tum. Jisos Kraist, a Esowo Nsoo bi nyahm-e go elkv, bo ba tum-m. Bo sehngem goji nne.<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Gal 1:11-12</char></note><verse eid="GAL 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 1:2" />Me, a abonanee kpee ba li a name, e kpꞌkake aneb ero ba li go Galesa nnyo.<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />Nong, nnoobo, a elkoono jol a nahne, ni lohng goji Esowo Nsoo, a Jisos Kraist Ntul ewahre, <verse eid="GAL 1:3" /><verse number="4" style="v" sid="GAL 1:4" />no yake elne ka tib go egahre abiafem, eji á lꞌtahr-r yehke go ebi eying jia ji anv, tib ana wo koro Esowo Nso ejahre. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />Nong, ellub jol nꞌne go njinanjini. Emen<verse eid="GAL 1:5" /></para>
  <para style="s">Nnoobo etib bi Esowo li na abehng</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />Kp-m kpoko esi sehng, eji ḿ ma tahr yꞌyake ye ji lung-n no re wahn toono nnoobo nyi Kraist, ḿ ma fere yaange kpꞌtoono etib bindiki. <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />Lohngem re nnoobo etib bindiki bia. Ane bandiki ba kpo lim re amahr jo bil-n, bo ba kpꞌsebe re bo yaange nnoobo etib bi Kraist.<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">Elt 15:1,24</char></note> <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />Lꞌfere jol wahr, afi fere jolo enjel nyi lohng go ejahbetul Esowo ba tiing-n etib bindikandiki bi ki li jang jang ana bi e tiing-n no, nkuk a ne!<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">1 Kor 14:37</char></note> <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />Ana e ma tohko bung, ano wo n kpꞌkpeke bung a. Nne awohng awohng no lꞌfere tiing-n etib bi ki li ana bi ḿ ma tohko taame tv, nkuk a ne!<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">Ell 22:18-19</char></note><verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />Anv, n kpꞌsebe re me n jol ntem no anea, afi ntem no Esowo? Anv, n kpꞌsebe re me n lim ji kpꞌkoro anea afi? Li re n kpꞌkpeke lim ji kpꞌkoro ane, kehn me nlokeltum no Kraist sang.<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">Luk 6:26; 1 Tes 2:4</char></note><verse eid="GAL 1:10" /></para>
  <para style="s">Ana Pol kehm jolo ntiingetib no Esowo</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />Abonanee, n kpꞌsebe re wahn kahn re, nnoobo etib bi n tiingi no, bi nne sang. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />N koom goji nne, jol nne sang tib-m no. Jisos Kraist antahng antahng wo lennge no ka-m.<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">Gal 1:1; 2 Kor 12:1-3</char></note><verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />Tibre wahn ebwuk bade ana elkpin ename jolo no, eji n jo toono eljini nio ni Jus, ana n jo sahb nꞌnohk aneb Esowo, fere jo gare re me n tane ero.<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">Elt 9:1-2</char></note> <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />Me wo jo ga toono eljini ni Jus sehnge ane ebame bako gbalee, ba e jolo nkpake anyehng ano a bo, eji n jo sahb kꞌkak ekpuku, jo toono eltibi ni babnso ejahre.<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">Elt 22:3-5; 26:4-5</char></note> <verse eid="GAL 1:14" /><verse number="15" style="v" sid="GAL 1:15" />Esowo yehk-m ngare nyi n kpeke wob nnee go ala, fere lung-m go ege a nnoobo re me m ba lok-e. <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />Wo, eji kor-e no re á lennge mmon ewe ka-m,<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">Mat 16:17</char></note> eji n lꞌsong tiingi nnoobo etib bada ne go ellong ane baka baka,<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">Elt 26:13-18</char></note> n jeem goji nne awohng awohng re me n song ko elle. <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />Jol n jeem go Jeusalem goji ane ba gbo mbang jol abatiingetib ka me. N tahme ejame, song rehng go Arebia, kehm feere song rehng go Damaskus. <verse eid="GAL 1:17" /><verse number="18" style="v" sid="GAL 1:18" />Eji ma kang nnya era, n kehm tahme go Jeusalem, eji n lꞌsong mahnge Pita. Eji n je no, n kange a ne nfung elku. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />N kpeem nyehn ntiingetib awohng awohng gona, sehngem Jems mmonannyehn Ntul a Jisos wo n nyehne-e no.<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">Mat 13:55</char></note> <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />Ji n kpꞌnyono a, n kpꞌnyono go esamahr bi Esowo. Efahnge n nehme kim. <verse eid="GAL 1:20" /><verse number="21" style="v" sid="GAL 1:21" />Owo n kehm tahme go ejang bi Siria, a bi Silisa. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />Ngare nyio aneb ero ba li go Judea ba ma taame tv Kraist m-e ka nyehn a nyehn. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />Bo wuku na wuk ji ane bako jo bung re, “Nne no jo nohk-r wuku wuku, anv, á kpꞌfere tiingi nnoobo etib re ane taame tv Jisos, Jisos jio ji á jo gare wuku wuku re, á tane ero ebe.” <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />Bo kehm kehme Esowo ellub ka tib me.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">Pol, a abatiingetib bako</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />Eji ma kang ewubu a nnya eni, n kehm kpe je go Jeusalem, a Barnabas. N tob ko Taitus fvfo, je a ne.<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">Elt 15:2</char></note> <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />N je, tib eji Esowo lennge ka-m re me n je. Eji e song kono edi ajehng a atubesi ero wahr wahr, owo n kehm tooro tong bo ana nnoobo etib bi n jo tiingi ane baka baka li no. N joom seb re eltum ni n jo lim wuku wuku, a ni n kpꞌlimi anv jol mbol mbol.<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">Mat 18:18</char></note> <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />Jol Taitus ji jolo a name, bo we bobem re á yehke nrur, jol eji á jolo jol nne a Grik.<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="ft" closed="false">Elt 16:3</char></note> <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />Akimfahnge abonanee bandiki jo sebe re bo lim ano. Bobweele ba yel re bo ba seb kahn elkohn elforo ni e ma for go ejang bi Kraist Jisos,<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">Rom 10:4; 13:10</char></note> eji bo lꞌlim-r, e jol aju. <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />Jol e tikem naange tv bo nkpel anyehng anyehng, tib eji e lꞌkuuru etingitingi jio ji nnoobo etib bum-n.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />Ane bandiki baa, ba bo jo bum bo ana atubesi. Jol afi bo jolo elkohn ani, m-e nehme lub. Tibre Esowo kpehme rang nne awohng awohng. Jol atubesi bao m-e tibem ejumjum budu. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />Bo sebe na kahn re, Esowo ebyake nnoobo etib ka-m re me n song tiingi ane ba kil jo yehke nrur,<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">Elt 22:21</char></note> jang jang ana á yake nnoobo etib ka Pita re á jo tiingi ane ba kpo yehke nrur.<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">Luk 22:32</char></note> <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />Tibre ye jio ji jo lim eltum a Pita, eji Pita jo tiingi ane ba kpo yehke nrur nnoobo etib,<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">Elt 9:34,40</char></note> ye jꞌnehm wo jo tob lim eltum a name, eji n jo tiingi ane baka baka nnoobo etib.<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">Elt 13:11-12; 19:11-12</char></note> <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />Eji Jems, Pita, a Jon, ba bo bumu bo ana atubesi nyehne nnoobo nyi Esowo ma lim ka-m, bo kehm kake Barnabas a me ebo bi elkoono. Owo e kehm toobo re wahr bahke jo lim eltum go ellong ane baka baka, bo jo lim eltum go ellong ane ba kpo yehke nrur. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />Ejum jia ji ji bo tong-r no re wahr jo buumu akpak ebo. Ejum jꞌnehm ana ji n jo nok re me n lim.<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">1 Kor 16:1-4</char></note><verse eid="GAL 2:10" /></para>
  <para style="s">Ana Pol nyame Pita go Antiok</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />Eji Pita ba go Antiok, n ka-e ebi go elkab ane, tibre á sꞌsoodo. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />Re ane ba Jems tumu no kehm ba rehng go Antiok, Pita jo li nsol a ane baka baka. Eji bo ba no, á kehm yabe elne, á kpeem tiki jo li nsol a bo, tibre á jo fahle ane ba jo seb re ane baka baka tob yehke nrur.<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">Elt 11:1-3</char></note> <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />Erik Jus jehko ji jo toono Pita, jo tꞌtob lim awini. Barnabas fvfo, awini nyanehm nya tob wer-e. <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />Eji n sebe kahn re, bo nehme jen go nseenge, fere jo toono etingitingi nnoobo etib, owo n kehm bungu tong Pita go esamahr ane bao kpee re, “Wo ji li na nne a Jus, a lꞌfere jo lim eljini ni ane baka baka, kꞌkpe jo lim eljini ana ni nne a Jus, anv, a bahke ma bob ane baka baka renan, bo kehm limi eljini ni Jus?”<note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="ft" closed="false">Elt 15:7-11</char></note><verse eid="GAL 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />Wahrfono antahng, wahr Jus ji dahb dahb dahb. Wahr ane baka baka sang, ba li aneb abiafem. <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />Wo, e kpꞌkahne re, nne kpehme li eno go esamahr bi Esowo tib go atahm abumu, sehngem re no, á lꞌtaame tv Jisos Kraist. Jol wahr jia fvfo, wahr ebtob taame tv Jisos Kraist, eji e lꞌli eno go esamahr bi Esowo tib go eltaame ni e ma taame tv Kraist, limm go atahm abumu. Tibre nnene limm, no bahke ma li eno tib go atahm abumu.<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">Rom 3:20,28</char></note><verse eid="GAL 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17" />E lꞌgare re wahr li eno go esamahr bi Esowo, tib eji e ma taame tv Kraist, bo fere jo tong-r re, wahr aneb abiafem ba, anv, jia lohngo re Kraist nlokeltum no abiafem woa? Eꞌee, ano á limm!<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">Mat 5:17</char></note> <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />N lꞌfere kpe kehme atahm jehke, nya m ma range, mbang nyio me n tib elname ana ngbokatahm. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />Wahr ebmal a atahm.<note caller="+" style="f"><char style="fr" closed="false">2:19 </char><char style="ft" closed="false">Rom 7:6</char></note> Tibre atahm nya wahnge n kpo no, eji n lꞌkpin ka Esowo. <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />Bo ma-m kum lake go ekros a Kraist. Mefono antahng sang kpeke li go elkpin, Kraist wo li go elkpin go egame atahng. Elkpin ni n li a ni anv go egama ngubjing, nꞌnehm ni m ma ko kpꞌjene go mbang nyi Mmon Esowo no n kor-e no, á ba yake elne ka tib go egame esi. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />N kpehme ten nnoobo nyi Esowo. Lꞌjol re nne kpo li eno go esamahr bi Esowo tib go atahm abumu, lohngo re, elkv ni Kraist kpo no, á kpo mbol mbol.<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">Atahm abola eltaame</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />Wahn aneb Galesa, jen ji wahnge ń kpꞌgboolo ano? Nne awo ma-n nehm,<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">Kol 2:16</char></note> wahn ji m ma-n tib Jisos Kraist, á ma fere jol are bo kum-e go ekros go egahne esamahr? <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />Ejum ajehng ji ji n kpꞌsebe re wahn tong-m. Anv, ḿ bele Etingi Etohko tib eji ń jo bum atahma, afi eji ń wuku alum Esowo, fere taame?<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">Elt 10:44</char></note> <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />Jen ji wahnge ḿ ma gboolo ano? Ḿ bomo gona etohko, anv, ń kpꞌsebe re wahn gohro lim go egahne ekoa?<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">Hib 10:28-29</char></note><verse eid="GAL 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 3:4" />Anv, erem bi ḿ ma nyehn o, ń nyehne mbol mbola? Li ma jol mbol mbol.<verse eid="GAL 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GAL 3:5" />Wo anv, eji Esowo ma-n ka Etingi Etohko, fere kpꞌlimi akpokosi go egahne ellong, á kpꞌlimi ano tib eji ń kpꞌbumu atahma, afi tib eji ń kpꞌwuku alum Esowo, fere taame?<verse eid="GAL 3:5" /></para>
  <para style="s">Elfuulu ni Ebraham</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />Nwer Esowo bungu bade Ebraham re, “Á taame tv Esowo, owo Esowo ko-e ana nne no ma li eno.”<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">Rom 4:21</char></note> <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />Nobo re wahn kahn re, ane ba kpꞌtaame tv Esowo ba li abon ba Ebraham.<verse eid="GAL 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 3:8" />Alum Esowo tohko nyehn amahr, ngare kehm rehnge re, Esowo bahke koko ane baka baka ana ane ba ma li eno tib go bo eltaame. Á tohko tiingi Ebraham nnoobo etib re, “Elfuulu ni ane kpee ba li go njini bahke bele, bahke sehnge go ega.” <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />Owo fvfo, ane ba kpꞌtaame tv Esowo ma bel elfuulu a Ebraham ji tob taame.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />Tibre ane kpee ba ma tahm tonngo go nsol nyi bo kpꞌlimi, eji bo kpi atahm bum, bobbel nkuk. Tibre nwer Esowo bungu re, “Nne awohng awohng no tohko jo lim nsol kpee nyi bo nyono go nwer atahm, yebbel nkuk.”<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">Jems 2:10</char></note><verse eid="GAL 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 3:11" />Anv, ebsahb lꞌlennge re, nne nehm ma li eno go esamahr bi Esowo tib eji á kpꞌbumu atahm. Tibre nwer Esowo bungu re, “Nne no ma li eno bahke jolo go elkpin tib go ege eltaame.”<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">Rom 1:17</char></note><verse eid="GAL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 3:12" />Atahm kpehme tonngo go eltaame. Tibre nwer atahm bungu re, “Nne no lꞌlim ejum ajehng ajehng ji atahm bungu no, á bahke kpini tib eji á ma lim ano.”<verse eid="GAL 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13" />Kraist wo ma-r fak yake go nkuk nyi ntahm ko no ba ka-r, eji á jolo ejum nkuk tib go egahre esi. Tibre nwer Esowo bungu re, “Nkuk li a nne awohng awohng no bo tohk-e go eti.”<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Rom 8:3; 2 Kor 5:21</char></note> <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />Kraist taame, jol ejum nkuk, eji ane baka baka lꞌbel elfuulu ni Ebraham ni li Jisos, eji wahr lꞌbel Etingi Etohko ji Esowo nyame no re á bahke kake ane ba lꞌtaame.<verse eid="GAL 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />Abonanee, nong, me n lim ntugare nyi li feere go eyaame ji nne. Nne lꞌsi gꞌgahm nne no bahke lehke elkv ene, fere tob lim ane bako kahn, nnene limm, no bahke ma ten alum nyao, jol nnene limm, no bahke ma budu.<verse eid="GAL 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 3:16" />Esowo nyame enyam bia tong Ebraham, fere tong mmon ewe. Esowo bungem re, “Abon ebe,” ba kehn jol tibi re bo li gbalee. Á bungu bada nne na awohng noo re, “Bahke jolo ka mmon ewa,” no li Kraist. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />Ejum ji a, ji n kpꞌbungu. Atahm nya ba na, eji ma kang nnya atahltahl kunu eltahl a nnya ewubu nehm ma sahde ntoobo nyi Esowo toobo no wuku wuku bum, nyi á ma lim re yiimi. Atahm nehm ma lim re, ji Esowo nyame no kane.<verse eid="GAL 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 3:18" />Lꞌjol re atahm nya bahke wahnge nne bel nsol elehke elkv nyi Esowo, lohngo re á nehm bel tib go enyam bi Esowo. Esowo kꞌka Ebraham elfuulu nio, tibre á nyame na tong-e re á bahke bele.<verse eid="GAL 3:18" /></para>
  <para style="s">Anv, atahm lohngo renan?</para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />Jen ji wahnge atahm li li? Esowo budu atahm tib abiafem,<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">Rom 3:20; 5:20</char></note> eji atahm lꞌjol tete ba rehng ngare nyi mmon no Ebraham noo bahke bake, ye ji Esowo nyame tong-e re, á bahk-e fuulu.<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">Gal 3:16</char></note> Esowo yake atahm ka babenjel re bo ko ba a nya, nya sehnge go abo nya nne no yiimi go elka elka ni Esowo, a ane.<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">Elt 7:53; Hib 2:2</char></note> <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />Njahm ebal ebal tohko jol, nne nehm ma yiimi go elka elka. Fvfo, Esowo li na abehng.<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="ft" closed="false">Jon 1:17; 10:30</char></note><verse eid="GAL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />Anv, atahm kpehme koono a enyam bi Esowoa? Eꞌee.</para>
  <para style="p" vid="GAL 3:21">Li re Esowo ka atahm nya bahke ma ka ane elkpin, kehn ane bahke lehke eno tib go atahm abumu.<note caller="+" style="f"><char style="fr" closed="false">3:21 </char><char style="ft" closed="false">Rom 8:2-4</char></note><verse eid="GAL 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 3:22" />Wo, nwer Esowo bungu re, njini kpee wob go elwo ni abiafem, eji ane ba kpꞌtaame tv Jisos Kraist lꞌbel ji Esowo nyame tong ane ba ma taame.<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">Rom 3:19; 11:32</char></note><verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />Re eltaame kehm bake, e woomo go ngbekobo nyi atahm, nya gbaang-r no tete ngare biingi nyi Esowo lennge eltaame tib. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />Atahm nya jolo ana ntꞌtibi ewahre, tete Kraist ba, eji e lꞌli eno tib go eltaame. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />Anv, eji eltaame ma ba, e kpeem wob go elwo ni ntꞌtibi noo.<note caller="+" style="f"><char style="fr" closed="false">3:25 </char><char style="ft" closed="false">Rom 10:4</char></note><verse eid="GAL 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />Tibre wahn kpee, abon Esowo ba, tib go eltaame ni ń kpꞌtaame tv Jisos Kraist.<note caller="+" style="f"><char style="fr" closed="false">3:26 </char><char style="ft" closed="false">Jon 1:12</char></note> <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />Tibre nne awohng awohng ewahne no ma bel ewohngalahb, fere jol ajehng a Kraist, yebrod Kraist kak ana ewobo. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />Anv, elyaange anehng anehng kpeem li, afi jolo anebe Jus, afi fere jolo ane baka baka, afi jolo aju, afi fere jolo ane ba ki li aju, afi jolo aneblum, afi fere jolo anebkal, wahn kpee li ajehng a Kraist Jisos.<note caller="+" style="f"><char style="fr" closed="false">3:28 </char><char style="ft" closed="false">Rom 10:12; 1 Kor 12:13</char></note> <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />Ń lꞌjol ka Kraist, ń tob li abon ba Ebraham, a abalehkelkv ana Esowo nyame no.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="s">Alokeltum, a abon</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />Ejum ji n yahke ba elbungu ji a. Eji nlehkelkv kpeke li mmonse, elyaange anehng anehng bo kpimm, ye a nlokeltum, jol eji ye li li nfona nsol nyio kpee. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />Nlehkelkv kpo woomo go elwo ni ane ba kpo fil-e, fere woomo go elwo ni ane ba nsol enye wob bo go ebo, tete afung biingi nya nde kunu no.<verse eid="GAL 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 4:3" />Ano wo tob li kak awahr awahr fvfo. Eji e jolo abonse,<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">Gal 3:23-25</char></note> e jolo aju nya atohko nya kpo fili njini.<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">Kol 2:8,20</char></note><verse eid="GAL 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 4:4" />Wo, eji afung nyao biingi no,<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">Ef 1:10</char></note> Esowo kehm tumu Mmon ewe. Nnenkal wo jel-e, á fere woomo go elwo ni atahm, <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />eji á lꞌfak ane ba wob go elwo ni atahm yake, bo fere jol abon ba Esowo.<verse eid="GAL 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6" />Tib eji e li abon ebe, owo wahnge Esowo kehm tumu etohko ji Mmon ewe tv-r, ba yel go egahra ntim, ji kpo rabe re, “Abba, Nsoo!”<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">Rom 8:15</char></note><verse eid="GAL 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 4:7" />Anv, eji Esowo ma-a lim re, wo kꞌkpe jol nlokeltum, wobfere jol mmon. Eji a ma fere jol mmon, wobtob jol nlehkelkv no Esowo.<verse eid="GAL 4:7" /></para>
  <para style="s">Ana Pol jo tiiri aneb Galesa</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />Wuku wuku eji ń kala kahn Esowo, ń jolo aju nya nsol nyi Esowo limi no, nyi ki li yefono Esowo. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />Anv, eji ḿ ma kahn Esowo, kehn n jol bungu re, eji Esowo ma-n kahn, jen ji wahnge ḿ bahke kpe feere goji atohko nyao nya ki kpi nsahm, nya ma gbo ekpak? Jen ji wahnge ń kpꞌsebe re wahn kpe feere jol aju ebo?<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">Gal 4:3</char></note> <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />Ń kpo bum akahmekahme afung, fere jo bum akahmekahme anyahng, fere bum ekahmekahme ngare, a akahmekahme nnya.<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">Kol 2:16</char></note> <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />N kpꞌfahle re, eltum ni n limi go egahne, n limi na tane.<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false">2 Jon 8</char></note><verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />Abonanee, n kp-n gboongo re, wahn fere jol ana me, tibre me n tob li ana wahn.<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">1 Kor 9:21</char></note></para>
  <para style="p" vid="GAL 4:12">Ebꞌbi ajehng ajehng me ń limem. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />Ń kpꞌkahne re, ngare nyi n gbo mbang bung alum Esowo tong-n, n jo yꞌyam.<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="ft" closed="false">1 Kor 2:3</char></note> <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />Eyam ebame bio jolo ana ejum elgaare ka wahn, jol tvtv ona ḿ m-e daangem, fere ten-m. Ń ko-m ana enjel nyi Esowo, fere ko-m ana Kraist Jisos antahng antahng.<verse eid="GAL 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 4:15" />Anv, eyebatahng ji ḿ bele no je gan? N kp-n yiimi ntianse re, ki ga ga, kehn ń jol luudu amahr enyahne ka-m. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />Anv, me n fere jol nnekv ewahne, eji n kp-n tongo etingitinga?<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />Bo kpꞌsahb nꞌnok re bo lim etem a nahne, jol bo nehme lim go ntir atahng nyi nno. Tibre bo kpꞌsebe re bo yaam-r a nahne, eji wahn lꞌtob lim etem a bo.<note caller="+" style="f"><char style="fr" closed="false">4:17 </char><char style="ft" closed="false">Gal 1:7</char></note> <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />Nꞌnob re bo jo nok, lim etem ngare anyehng anyehng, jol afi n jolem ona, bo lꞌsoro lꞌlim go ntir atahng nyi nno. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />Abon ebame, n kpꞌkpeke rahng ejel ebahne,<note caller="+" style="f"><char style="fr" closed="false">4:19 </char><char style="ft" closed="false">1 Kor 4:15</char></note> tete Kraist gbal go egahne atahng.<verse eid="GAL 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 4:20" />Kp-m koro re me n jol a nahne anv, fere bung a nahne go mbang nyindiki. Tibre ji n wuku bada nahne ma-m fohk nkv.<verse eid="GAL 4:20" /></para>
  <para style="s">Hegar abola Sera</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />Tong-m wahn ana atahm bungu no, wahn jio ji kpꞌsebe re wahn kpe woomo go elwo ni atahm! Ń nehme wuk ji atahm bungu noa? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />Nwer Esowo bungu re, Ebraham bele abon ba nlum na abal. Noko, nju nyi jel-e, noko, nnenkal no ma for wo jel-e. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />Mmon no nju nyio jel-e no, á jel-e go mbang nyehka nyehka. Wo, mmon no nnenkal no ma for jel-e no, á jel-e tib go enyam bi Esowo nyame no tong-e.<note caller="+" style="f"><char style="fr" closed="false">4:23 </char><char style="ft" closed="false">Rom 9:7-9</char></note><verse eid="GAL 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24" />A wo li ntugare nyi tib-r ejum. Tibre anebkal abal baa yim go egbanngalung ebbal. Hegar yim go egbanngalung ji Esowo limi a abone Hegar go ewong ji bo kpo lung re Sainai, egbanngalung jio ji limi bo, bo jol aju.<note caller="+" style="f"><char style="fr" closed="false">4:24 </char><char style="ft" closed="false">Rom 8:15</char></note> <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />Tibre aneb Arebia kpo lung Sainai re Hegar, ji kpꞌtibi Jeusalem ji li lela, ji li nju, a abon ebe kpee.<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">Luk 2:38</char></note> <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />Jeusalem ji li go ero ebfor, ji ji li nnee ejahre.<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="ft" closed="false">Hib 12:22</char></note> <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />Tibre nwer Esowo bungu re,</para>
  <para style="q1" vid="GAL 4:27">“Bel eyebatahng, wo ngum a nnenkal no kil jele abon.</para>
  <para style="q1" vid="GAL 4:27">Fa asol kak, wo fere siiki, wo jio ji kala rꞌrahng ejel.</para>
  <para style="q1" vid="GAL 4:27">Tibre nnenkal no nlum ewe m-e tahm sa wo</para>
  <para style="q1" vid="GAL 4:27">ga kpi abon sehnge nnenkal no kpi nlum.”<note caller="+" style="f"><char style="fr" closed="false">4:27 </char><char style="ft" closed="false">Mak 2:20; Ell 7:9</char></note><verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />Abonanee, e li abon Esowo ana Aisik, tib enyam bi Esowo nyame no. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />Ana jolo ngare nyi mmon no bo jel-e go mbang nyehka nyehka jo nohk mmon no bo jel-e go etohko ji Esowo, ano wo tob li anv.<note caller="+" style="f"><char style="fr" closed="false">4:29 </char><char style="ft" closed="false">Elt 17:13</char></note> <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />Wo anv, nwer Esowo bungu renan? Bungu re, “Kam nju nyio, a mmon ewe! Tibre mmon no nju nehm tiki li elkv ano a mmon no nnenkal no ma for jel-e no.”<verse eid="GAL 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GAL 4:31" />Abonanee, wahr abon ba nju sang, e li abon ba nnenkal noo no ma for.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">Ana Kraist ma-r lim, e ma for</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />Yiimen go elforo ni Kraist ma-n lim, ḿ ma for. Kana kpe taame, kpe jol aju.<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">Kol 2:16</char></note><verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />Me Pol, me wo kp-n tongo re, Ń lꞌtaame re bo yehk-n nrur, lohngo re, Kraist, nnoobo anyehng anyehng wahn á nehm ka. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />N kpꞌkpeke bung tong nne awohng awohng no lꞌtaame, bo yehk-e nrur re, á bahke tiki bum atahm kpee. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />Wahn jia ji kpꞌsebe re wahn li eno go esamahr bi Esowo tib go atahm abumu, wahn ebyaame a Kraist, fere yake nnoobo nyi Esowo.<verse eid="GAL 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GAL 5:5" />Tibre go nsahm Etingi Etohko, a eltaame ni e kpꞌtaame tv Jisos e kpꞌsiki ji e kpꞌkunu ekpu, ji li eno ji e bahke lehke go esamahr bi Esowo. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />Go ejang bi Kraist, afi nne yehke nrur, afi á yehkem, nsehng anyehng anyehng limm. Nsehng li go eltaame ni nne kpo taame tv Jisos, eji á kpꞌlimi ejum ajehng ajehng go elkoro.<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">1 Kor 7:19</char></note><verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />Ń jo limi nob nob. Nne awo kpan-n re wahn kꞌkpe toono etingitingi mbang?<verse eid="GAL 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 5:8" />Ane ba kpo nok re bo senng-n eltim, alum nnyo ebo lohngem goji Esowo bi kp-n lungu. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />Abon ayist ntiil kpo lim ebred kohro kohro tung.<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">1 Kor 5:6; Mat 16:12</char></note> <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />Tib eji e li ajehng a Ntul a Jisos, owo wahnge n kp-n bumu go etingitingi re, ń nehme tir ejahne ejahne, me n tir ejame ejame. Wo, nne no lꞌlim re, amahr bil-n, Esowo bahk-e kake erem, afi á jolo elkohn nne awo.<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">2 Kor 11:15</char></note> <verse eid="GAL 5:10" /><verse number="11" style="v" sid="GAL 5:11" />Abonanee, li re n kpꞌkpeke bung alum Esowo nyao nya nrur ayehke, kehn bo m-e nehme kpe nohk. Li re n kpꞌkpeke lim ano, kehn ekros ji Kraist ji n kpo bung alum Esowo bade, nehme kpe jol ana esiti mbang.<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">1 Kor 1:23</char></note> <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />Kor-m kor re, ane ba kpo lim re, amahr bil-n, bo tob fang elbo.<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />Abonanee, Esowo lung-n re wahn for. Kana rod elforo ni ḿ ma for bum ana ejum ji ḿ bahke jo laange kunu, fere jo lim ji kpꞌkoro agubjing enyahne. Ga nob re wahn bel elkoro atemtem, eji ń lꞌjo loko atemtem.<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false">1 Kor 10:23-24; 1 Pit 2:16</char></note> <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />Tibre nne no lꞌbum ellum nia ni bungu re, “Nne ebjing ewa jo kor-a ana ebjing eba,” á li nne no ma bum atahm kpee. <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />Ń lꞌjol ana enyam bi kpo tokko atem, fere jo mele atem, jo kunen ekpu, eji ń lꞌkꞌrannge atemtem.<verse eid="GAL 5:15" /></para>
  <para style="s">Etohko, a ngubjing</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />Ji n kpꞌbungu a li re, wahn jo jen go etohko ji Esowo, eji ń lꞌkꞌjo lim ji kpꞌkoro agubjing enyahne. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />Tibre ntir nyi ngubjing limm ana ntir nyi etohko. Ntir nyi etohko limm ana ntir nyi ngubjing. Bo li go ekv atemtem, owo wahnge ń lꞌkꞌjo ma lim ji kp-n koro.<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="ft" closed="false">Rom 7:15,23</char></note> <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />Etohko lꞌjol ntubesi ewahne, ń nehm kpe woomo go elwo ni atahm.<verse eid="GAL 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19" />Nsol nyi ngubjing eblennge gbuul, ana erehbe, asꞌsa, nsol nyi ki li saang, elfamme yannge, <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />eblom ajomo, ntaane alimi, ekv akoko, ntaange ataange, ala ateele, eltim arake, eltiiri elne elne, nyꞌyabe, eljolo go nlong a nlong, <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />amahr abaare, ane awulu, amahm awoko fere jo bꞌbuumu, nkak alimi nyi kpo jen a abiafem, a nsol nyindiki nyi tob li ana fvfo. N kp-n rehke ana m ma-n tohko rehke wuku wuku. Tibre ane ba lꞌjo lim elkohn nsol nyia nehm li etul bi Esowo.<note caller="+" style="f"><char style="fr" closed="false">5:21 </char><char style="ft" closed="false">1 Kor 6:9-10; Ef 5:5; Ell 22:15</char></note><verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />Akab nya etohko nya a, elkoro, eyebatahng, elkoono, elkpuumu, eljini anobo, nnoobo alimi, eltaame, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />eljolo soom, a elbobo ni nne bahke jo bob elne.<note caller="+" style="f"><char style="fr" closed="false">5:23 </char><char style="ft" closed="false">Ef 5:9</char></note> Ntahm anyehng anyehng limm, nyi kpo sahde nsol nyia.<note caller="+" style="f"><char style="fr" closed="false">5:23 </char><char style="ft" closed="false">1 Tim 1:9</char></note><verse eid="GAL 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 5:24" />Ane ba li ka Kraist Jisos, bobkum agubjing ebo go ekros, a nsol nyi kpo melle ane go eltim, go nsol nyi kpo sahb kꞌkor bo go ellimi.<note caller="+" style="f"><char style="fr" closed="false">5:24 </char><char style="ft" closed="false">Rom 6:6; Kol 3:5</char></note><verse eid="GAL 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GAL 5:25" />Ana Etingi Etohko ma-r ka elkpin, nong, wahr tob jenen a ne.<note caller="+" style="f"><char style="fr" closed="false">5:25 </char><char style="ft" closed="false">Kol 2:6</char></note> <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />Nong, wahr kꞌjo geere kak nsol nyi ki li ejumjum, fere jo seb atemtem aweele, fere jo baare amahr go nsol atem.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">Ana nne bahke jo sol elsol ni ntem</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />Abonanee, nne lꞌgbo yel go elkohn abiafem anehng anehng, wahn ji kpꞌjene go etohko ji Esowo, kaken ye ebo go enange bem, eji á lꞌtuungu yiimi, wahn fere baabe elnahne, tohko jol ano, wahn fvfo bahke tob yel go elgaare.<note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="ft" closed="false">Mat 18:15; Jems 5:19-20</char></note><verse eid="GAL 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 6:2" />Jo solen elsol ni ate ebahne. Ń lꞌlim ano, owo ḿ ma bum ntahm nyi Kraist.<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">Rom 13:8,10; Gal 5:14; Jems 2:8</char></note><verse eid="GAL 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 6:3" />Nne awohng awohng no lꞌtir re, ye nne wo, eji á ki tohko fꞌfoongo nne, á kpi elne nehm. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />Nong, nne awohng awohng jo wuungu eltum ene nyehn.<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">2 Kor 13:5</char></note> Ano wo bahke wahnge á kehm bele ejum ji á bahke jo wor nnyo kunu. Bahke jolo eltum ni yefono antahng, nehm jol ni nne noko ma lim. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />Tibre nne awohng awohng bahke solo elsol nꞌne antahng.<note caller="+" style="f"><char style="fr" closed="false">6:5 </char><char style="ft" closed="false">Rom 14:12</char></note><verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />Nong, nne no bo kp-e tibi alum Esowo jo tob yehke go anoobo nsol kpee nya á kpi no, ka ntꞌtibi ewe.<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">1 Kor 9:13-15</char></note><verse eid="GAL 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7" />Kana nehm elnahne! Esowo kpehme taame re, nne jv-e nnyo. Tibre ejum ajehng ajehng ji nne lꞌbahm, jꞌnehm ji á bahke kpake. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />Nne no lꞌbahm nsol enye go egbe jio ji ngubjing enye, á bahke kpake elrannge. Nne no lꞌbahm go egbe jio ji etohko, á bahke kpake elkpin ni li go njinanjini.<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">Rom 8:13</char></note><verse eid="GAL 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GAL 6:9" />Nong, wahr kꞌlahng go nnoobo alimi. Tibre ngare lꞌbiingi, e bahke kpake, e tohko yini ekpu.<verse eid="GAL 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 6:10" />Anv, eji e kpi eyake, nong, wahr jo lim nnoobo ka nne awohng awohng, asehngesehnge ane ba e kpꞌjene ano a bo go mbang nyi Esowo.<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">Jon 17:21</char></note><verse eid="GAL 6:10" /></para>
  <para style="s">Esꞌkohro erehke</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />Nyehnen alum gbalee nya n nyono no go egame ebo antahng. <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />Ane ba kpo tib elbo, fere jo wor nnyo kunu nsol nyi li ka ngubjing, bo ba li ane ba kpꞌsebe re bo bob-n, yehke nrur. Bo kpo lim ano, eji ane lꞌkꞌnohk bo tib ekros ji Kraist.<note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">Fil 3:18</char></note><verse eid="GAL 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 6:13" />Jol ane bao ba ma yehke nrur kpehme bum atahm.<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Jon 7:19</char></note> Bo kpꞌsebe re wahn yehke nrur, eji bo lꞌjo wor nnyo kunu ejum ji ḿ ma lim go egahne agubjing.<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Mat 23:15</char></note><verse eid="GAL 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 6:14" />Me n nehme seb re me n wor nnyo kunu ejum ajehng ajehng, sehngem ekros ji Jisos Kraist Ntul ewahre ji m bahke jo wor nnyo kunu, ji ji wahnge njini li-m ana ekpakv ejum, me n li ana nne no ma kpo, yaame a njini. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />Afi nne yehke nrur, afi á yehkem, ejumjum o limm. Ji li no li re, á jol nne a nfenfe.<note caller="+" style="f"><char style="fr" closed="false">6:15 </char><char style="ft" closed="false">1 Kor 7:19</char></note><verse eid="GAL 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 6:16" />Nong, elkoono, a ndon nyi Esowo jol a ane ba kpꞌtoono eljini nia, bo ji li Israel jio ji Esowo.<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">Rom 9:6</char></note><verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />Bomo anv asongo, nong, nne awohng awohng ki-m kpe jo gbiingi. Tibre n kpi nliingi nyi Jisos go egama ngubjing.<note caller="+" style="f"><char style="fr" closed="false">6:17 </char><char style="ft" closed="false">2 Kor 11:24-25</char></note><verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />Abonanee, nong, nnoobo nyi Jisos Kraist Ntul ewahre jol a atohko enyahne. Emen.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>