<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Ekajuk Unicode New Testament</book>
  <para style="h">Eltibi</para>
  <para style="toc3">Elti</para>
  <para style="toc2">Eltibi</para>
  <para style="toc1">Nwer nyi Eltibi</para>
  <para style="mt1">Eltibi</para>
  <chapter number="1" style="c" sid="ECC 1" />
  <para style="s">Nsol kpee ejumjum lohngem</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 1:1" />Alum nya a, nya ntiingi etib, mmon a Devid no jolo ntul go Jeruselem, bungu no re:<verse eid="ECC 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 1:2" />&lt;&lt;Nsol kpee ejumjum lohngem!&gt;&gt;Ntiingitib wo bungu.</para>
  <para style="q2" vid="ECC 1:2">&lt;&lt;Jol egburu ejum lohngem ejumjum!&gt;&gt;</para>
  <para style="q3" vid="ECC 1:2">&lt;&lt;Nsol kpkee Ejumjum lohngem ejumjum lohngem.&gt;&gt;<verse eid="ECC 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 1:3" />Nsehng anyii ane kpo li go eboa ntum kpee,</para>
  <para style="q2" vid="ECC 1:3">nyi bo kp'limi go njini nyia?<verse eid="ECC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 1:4" />Aying kpo ba, fere sehng asongo,</para>
  <para style="q2" vid="ECC 1:4">wo ndi tiki li go njinanjini.<verse eid="ECC 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 1:5" />Njul kpo lohng fere lahm,</para>
  <para style="q2" vid="ECC 1:5">fere foomo feere go edi ji á kpo lohng.<verse eid="ECC 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 1:6" />Nfeb kpo lim feere go ejang eboblum, fere sennge feere go ejang ebobkal;</para>
  <para style="q2" vid="ECC 1:6">kpo sennge ano ano, tiki jo feere toono elsehnge ene.<verse eid="ECC 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 1:7" />Ngba kpee kpo fab song yel go agburu aya,</para>
  <para style="q2" vid="ECC 1:7">wo agburu aya nehme tiki rur.</para>
  <para style="q3" vid="ECC 1:7">Go edi ji ngba kpo lohng ba, go wo kpo kpe feere tahm.<verse eid="ECC 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 1:8" />Nsol kpee ebkpen nne,</para>
  <para style="q2" vid="ECC 1:8">sehnge ana nne bahke ma bung.</para>
  <para style="q3" vid="ECC 1:8">Amahr kp'sebe re nyehn wo nsol elyehne lim, jol atung kp'sebe re wuk wo nsol elwuku lim.<verse eid="ECC 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 1:9" />Jio ji ma tohko jol, bahke kpe jol, ji bo ma tohko lim, bo bahke kpe lim;</para>
  <para style="q2" vid="ECC 1:9">ejumjum limm ji li ejum nfenfe go njini.<verse eid="ECC 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 1:10" />Ejum ajehng ajehng jia go ji nne bahke ma bung re,&lt;&lt;Nyehnene! A ejum nfenfe ji a?&gt;&gt;</para>
  <para style="q2" vid="ECC 1:10">Ebtohko jol a, mahne mahne; tohko jol a ngare enyahre kehm rehnge.<verse eid="ECC 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 1:11" />Nnene kpehme kpe buumu aying nya mahne mahne,</para>
  <para style="q2" vid="ECC 1:11">jol aying nya kp'bake ane nehm buumu, ane ba bahke jolo toono ngare nyio, nehm kpe jo buumu aying nyao.<verse eid="ECC 1:11" /></para>
  <para style="s">Ngbere ejumjum lohngem</para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 1:12" />Me ntiingi etib, n kuumu etul go Jerusalem jo fili Isreel.<verse eid="ECC 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 1:13" />N yehke ntir enyame kak re me n kpili nsol, fere ko ngbere feede nsol kpee nyi ane kpo lim go njini.</para>
  <para style="q2" vid="ECC 1:13">A wo li egburu elsol ni Esowo ma rod si nnee!<verse eid="ECC 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 1:14" />Me n seenge nsol kpee nyi ane kpo lim go njini;</para>
  <para style="q2" vid="ECC 1:14">nsol nyio kpee ejumjum lohngem, nne kp'kame na toono elfeb.<verse eid="ECC 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 1:15" />Ejum ji ma galle, nne nehm ma tanne;</para>
  <para style="q2" vid="ECC 1:15">ji ki li a nehm ma fange kak nti.<verse eid="ECC 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 1:16" />M bungu tong elname re, &lt;&lt;Me m bel ngbere sehnge nne awohng awohng no ma tohko kuumu etul go Jerusalem me n kehm ba kuumu; ngbere a elkahne ma-m nahre gbalee.&gt;&gt;<verse eid="ECC 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 1:17" />Owo n kehm yehke ntir enyame kak re me n kpili bada ngbere, a esahl go elgboolo, wo n tob kpili re, jia fvfo, nne kp'beke na kam elfeb.<verse eid="ECC 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 1:18" />Tibre nne no kpi egburu ngebere kpo jol ndon ndon sehng;</para>
  <para style="q2" vid="ECC 1:18">ana elkahne kp'gbale, ano wo egbiingeltim tob li.<verse eid="ECC 1:18" /></para>
  <chapter eid="ECC 1" />
  <chapter number="2" style="c" sid="ECC 2" />
  <para style="s">Elfo alehke ejumjum lohngem</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 2:1" />N kehm bungu tong elname re, &lt;&lt;Wuk-mo! M bahke koko elfo wuung-a eji n l'seb kahn ji kp'nobo.&gt;&gt; Wo jia fvfo n nyehne re ejumjum lohngem.<verse eid="ECC 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 2:2" />N kehm bungu re, &lt;&lt;Asol awolo esahl bi. Anv elfo alehke kpo ka nne jen?&gt;&gt;<verse eid="ECC 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 2:3" />N gare re me n ko amahm ka elname eyebatahng, fere jo lim agbolo nsol, wo ntir atahng enyame jo tiki soong-m a ngbere. N jo sebe re me n kahn ji nobo ka ane re bo jo lim go njini nyia abon afung ba nkpin ebo.<verse eid="ECC 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 2:4" />N kake esehk jo lim agburu ntum: N sii ntahk ka elname fere bahm ebgbe agrab<verse eid="ECC 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 2:5" />N bahme adi ebgbe, fere lim adi ekv areke nya m bahme nkohn a nti kpee nyi kpo kab akab.<verse eid="ECC 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 2:6" />N ramme abing nya alahb akuuru, nya bo jo ko alahb toomo abohko nti.<verse eid="ECC 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 2:7" />N gunu aju nya nlum a nya nkal, fere bel aju nyako nya bo jele bo go egame etahk. N tob bele nlong efong a nlong ebul a ejoro sehnge nne awohng awohng no gbo mbang kuumu etul go Jerusalem ka me.<verse eid="ECC 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 2:8" />N kpu asilva a agul luk ka elname, go atingi nsol nya atul a nya arohko ajahbe. M bele ayimase ba nlum a ba nkal, a aneb elkang gbalee, nsol nyo nyi kpo ka aneblum eyebatahng.<verse eid="ECC 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 2:9" />N sahb gb'gbal sehnge nne awohng awohng no tohko jol ntul go Jeusalem ka me, n kehm kuumu etul. Go nsol nyia kpee, ngbere enyame sa a name.<verse eid="ECC 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 2:10" />N tenem elname ejum ajehng ajehng ji koro amahr enyame;</para>
  <para style="q2" vid="ECC 2:10">N tenem eltim ename elfo anehng anehng.</para>
  <para style="q3" vid="ECC 2:10">Eltim ename jo geere kak ntum abo enyame kpee, jia ji jolo eltuuru eltum ename go agb'gbiingi enyame kpee.<verse eid="ECC 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 2:11" />Wo ga n l'fere seenge nsol kpee nyi abo enyame ma lim,</para>
  <para style="q2" vid="ECC 2:11">a nsol nyi m ma gbiingi elname bel,</para>
  <para style="q3" vid="ECC 2:11">ejum ajehng ajehng ejumjum lohngem, nne kp'beke kam elfeb; nsehng anyehng anyehng nne belem go elwo ni njul.<verse eid="ECC 2:11" /></para>
  <para style="s">Ngbere a elgboolo ejumjum lohngem</para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 2:12" />Owo n kehm sennge fere yehke eltim ename kunu re me n gbo ntir bada ngbere, fvfo esahl a elgboolo.</para>
  <para style="q2" vid="ECC 2:12">Anv ejum ajii ji ntul no bahke ba kuumu etul toono atul bahko bahke ma kpe lim, sehnge ji bo ma toko lim?<verse eid="ECC 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 2:13" />N nyehne re ngbere nobo sehnge elgboolo, ana ellennge kp'nobo sehnge ejannge.<verse eid="ECC 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 2:14" />Aneb ngbere kpo bel amahr go ebo esi, wo egboolo nne kpo jen go ejannge;</para>
  <para style="q2" vid="ECC 2:14">wo n sebe kahn re elkohn ejum ajehng ji kpo gbo tub bo ane abal abal.<verse eid="ECC 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 2:15" />Owo n kehm bungu tong elname re, &lt;&lt;Ji kpo gbo tub egboolo nne bahke tob gbo tub-m fvfo.</para>
  <para style="q2" vid="ECC 2:15">Anv nsehng anyii N kpi no go egama ngbere?&gt;&gt;</para>
  <para style="q3" vid="ECC 2:15">N kehm tongo elname re &lt;&lt;Jia fvfo ejumjum lohngem.&gt;&gt;<verse eid="ECC 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 2:16" />Tibre nne a ngbere tob li ana egboolo nne, bo ane abal abal bo nehm ga buumu bo; afung ebsi r'rehng nya ane bahke yini bo.</para>
  <para style="q2" vid="ECC 2:16">Fvfo nnea ngbere bahke tob kpo ana egboolo nne.<verse eid="ECC 2:16" /></para>
  <para style="s">Elgbiingi ejumjum lohngem</para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 2:17" />Ano wo elkpin tehn-m no, tibre eltum ni ane kpo lim go njini, jo ka-m eyameltim sehng. Nsehng nyi ngbere kpee ejumjum lohngem, nne kpe kame na toono elfeb.<verse eid="ECC 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 2:18" />N kpi etehn ka nsol kpee nyi m ma lim bum go njini a elgbiingi enahme go elwo ni njul, tibre m bahke tahme sa nne no bahk-m toono.<verse eid="ECC 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 2:19" />Anv nne awoo kp'kahne jo re á bahke jolo nnea ngbere afii egboolo nne? Tvtv o, ye wo nsehng nyi ntum enyame bahk-e woomo go elwo, nyi N nyennge ko elkahne ename kak eko lim go elwo ni njul. Jia fvfo ejumjum lohngem.<verse eid="ECC 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 2:20" />Ano wo, eko kehm-m eltane bada ntum kpee nyi m ma nyehn erem lim go njini.<verse eid="ECC 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ECC 2:21" />Tibre nne li ma ko ngbere a elkahne go ebnere lim eltum, fvfo á ba fere yake nsol kpee nyi á kpi no bum nne nondiki, no kii nyehn erem lim eltum nio. Jia fvfo ejumjum lohngem, li egburu ebibisi.<verse eid="ECC 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ECC 2:22" />Nsehng anyii ane kpo bel go ntum ebo nyi bo kpo nyehn erem lim fere jo biingi elbo go njini nyia?<verse eid="ECC 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ECC 2:23" />Afung elkpin ebo kpee, bo kpo lim eltum ndon ndon a abiingi eltim; jol ngare atv, eltim ebo kpehme re ekv. Jia fvfo, ejumjum lohngem.<verse eid="ECC 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ECC 2:24" />Ejumjum limm ji nne bahke ma lim sehnge re á jo li nsol, fere jo w'wo, fere bel elwohngo go eltum erem ebe. Jia fvfo, me N nyehn re Esowo bi kpo ka nne,<verse eid="ECC 2:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ECC 2:25" />tibre tohko jol Esowo, nne awoo bahke ma li fere bel elyebe?<verse eid="ECC 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ECC 2:26" />Esowo kpo ka nne no kp'nobo go ege esamahr ngbere a elkahne go eyebatahng, wo nne abiafem á kpo ka-e eltum ni li re á jo kpu afang bum, nya á bahke faake ka nne no kp'nobo go esamahr bi Esowo. Jia fvfo ejumjum lohngem, nne kp kahme na toono elfeb.<verse eid="ECC 2:26" /></para>
  <chapter eid="ECC 2" />
  <chapter number="3" style="c" sid="ECC 3" />
  <para style="s">Ejum ajehng ajehng kpi ngare ny'nye</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 3:1" />Ejum ajehng ajehng kpi ngare ny'nye,</para>
  <para style="q2" vid="ECC 3:1">fvfo ejum ajehng ajehng ji kp'limi go njini kpi ngare;<verse eid="ECC 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 3:2" />kpi ngare nyi bo kpo jel nne, fvfo tob kpi ngare nyi nne kpo kpo,</para>
  <para style="q2" vid="ECC 3:2">ngare nyi nsol abahme, a ngare nyi elfohko nsol,<verse eid="ECC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 3:3" />ngare nyi elwulu a ngare nyi enobayam,</para>
  <para style="q2" vid="ECC 3:3">ngare nyi etahk afake a ngare nyi elsehke,<verse eid="ECC 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 3:4" />ngare nyi eling alingi a ngare nyi asol awolo,</para>
  <para style="q2" vid="ECC 3:4">ngare nyi eljolo ndon ndon a ngare nyi ase abahne,<verse eid="ECC 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 3:5" />ngare nyi atal afare faade a ngare nyi elkpuku atal luk edi ajehng,</para>
  <para style="q2" vid="ECC 3:5">ngare nyi a bahke bingi nne a ngare nyi a bahke yaame go elbingi nio,<verse eid="ECC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 3:6" />ngare nyi ejum asebe a ngare nyi ekpu ayini,</para>
  <para style="q2" vid="ECC 3:6">ngare nyi elbumu ejum a ngare nyi elroko ejum jio go,<verse eid="ECC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 3:7" />ngare nyi nne bahke yare mbomo a ngare nyi á bahke jahme baade,</para>
  <para style="q2" vid="ECC 3:7">ngare nyi li re nne belle a ngare nyi li re nne bung,<verse eid="ECC 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 3:8" />ngare nyi li re nne jo kor-a a ngare nyi li re nne jo tehn-a,</para>
  <para style="q2" vid="ECC 3:8">ngare nyi ebta a ngare nyi elkoono.<verse eid="ECC 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 3:9" />Nsehng anyii abalimentum kpo bel go ebo eltum ni bo kpo nyehn erem jo lim?<verse eid="ECC 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 3:10" />Me n nyehn elsol ni Esowo ma si nne.<verse eid="ECC 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 3:11" />Esowo eblim ejum ajehng ajehng re nob go ege a ngare. Yebkak elkahne ni elkpin ni njinanjini go eltim ni nne, tvtv o, nnene nehm ma lohko kahn ji Esowo kp'limi kpee go mbomo rehng go ekahlsi.<verse eid="ECC 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 3:12" />Nkp'kahne re ejumjum go limmm ji nobo ka ane, sehnge re bo jo bel eyebatahng fere lim nnoobo ngare nyi bo li go elkpin.<verse eid="ECC 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 3:13" />Re nne jo li fere w'wo fere bel elwohngo go ntum ebo nyi bo kp'nyennge lim, tib jia ayare nya Esowo nya.<verse eid="ECC 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 3:14" />N kp'kahne re ejum ajehng ajehng ji Esowo limi no bahke jolo go njinanjini, jol nne nehm ma budu ejumjum o, afii yehke na. Esowo kpo lim ano eji ane l'jo fahl-e.<verse eid="ECC 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 3:15" />Ejum ajehng ajeng ji li no, ebtohko jol, ji bahke jolo ebtohko jol,</para>
  <para style="q2" vid="ECC 3:15">fvfo Esowo bahke limi ji ma tohko lim kpe lim.<verse eid="ECC 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 3:16" />N kpe nyehn ejum ajehng jehko go njini nyia ji li re:</para>
  <para style="q2" vid="ECC 3:16">Go edi elam alame, ab'bi li o, go edi ji fuumu re ane jo lim nsol songo songo, ab'bi li o.<verse eid="ECC 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 3:17" />N kehm bungu tong elname re, &lt;&lt;Esowo bahke lame etinginne a ebinne, bo ane abal abal,</para>
  <para style="q2" vid="ECC 3:17">tibre ngare bahke jolo ka eltum anehng anehng, ngare nyi bo bahke lame ejum ajehng ajehng ji nne limi no.&gt;&gt;<verse eid="ECC 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 3:18" />N tob bungu tong elname re, &lt;&lt;Ana ane, Esowo kpo wuungu bo, eji bo l'kahn re bo li ana enyam.&gt;&gt;<verse eid="ECC 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 3:19" />Etingitingi, ji li ka nne, tob li ano ka enyam; j'nehm ji kpi bo sik: Ji li re, ana nnyam bahke kpoko, ano wo nne kpo tob kpo. Bo kpee kpi elv elv anehng ni elkpin, nne kpimm na nsehng sehnge nnyam. Go ejum ajehng ajehng, ejumjum lohngem.<verse eid="ECC 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 3:20" />Bo kpee kpo feere tahm edi j'nehm; bo ko ebtohko lim nne a nnyam, ano wo bo bahke feere go ebtohko.<verse eid="ECC 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ECC 3:21" />Nne awoo kp'kahne jo re etohko ji nne kpo mehl tahm go ero, fvfo jo re ji nnyam kpo badde yel go ndi?<verse eid="ECC 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ECC 3:22" />Ano wo n nyehne no re ejumjum go limm ji kp'nobo ka nne, sehnge re a jo geere kak eltum ene tibre jio ji li etuureltum j'je. Tibre, anv, nne awoo bahke feere abo ba tib bo ji bahke jolo ngare nyi bo ma kpo fi?<verse eid="ECC 3:22" /></para>
  <chapter eid="ECC 3" />
  <chapter number="4" style="c" sid="ECC 4" />
  <para style="s">Eblum alimi, eltum alimi a ekubin</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 4:1" />Owo n kehm kpe seenge fere nyehn eblum kpee ni ane kp'limi atem go njini:</para>
  <para style="q2" vid="ECC 4:1">N nyehne abonngo nya ane ba bo kp'limi bo eblum, jol nkakeltim bo kpimm;</para>
  <para style="q3" vid="ECC 4:1">ane ba kp'limi bo nlum kpi eko, wo bo nkakeltim bo kpimm.<verse eid="ECC 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 4:2" />N kehm bungu gbul gbul gbuul re, ane ba ma kpo fi, bo kpi eyebatahng sehnge aneb mbir mbir,</para>
  <para style="q2" vid="ECC 4:2">bo ji kpeka li go elkpin.<verse eid="ECC 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 4:3" />Nne no bo kal-e j'jel ye wo ga nob a ne sehnge bo njahm ebal ebal,</para>
  <para style="q2" vid="ECC 4:3">ye ji kala nyehn ab'bi nya ane kp'limi go njini.<verse eid="ECC 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 4:4" />N t'tob nyehne re enok kpee, a eko kpee ji nne kpo kak go eltum ni alimi no, kpo lohng go eteele ala ji nne kpi no bada ntem. Jia fvfo ejumjum lohngem, li ana nne kp'beke kam elfeb.<verse eid="ECC 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 4:5" />Agboolo ane kpo wal abo ebo, ko elrannge ba ka elbo.<verse eid="ECC 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 4:6" />Ga nob re nne bel ndabbo ejum alehke anyehng a enange eltim, sehnge re á bel ndabbo nsol alehke ebal go elnyennge lim eltum,</para>
  <para style="q2" vid="ECC 4:6">elnyennge lim eltum li ana nne kp'kame toono elfeb.<verse eid="ECC 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 4:7" />Owo n kehm kpe nyehn ejum jehko ji ki lohng ejumjum go njini nyia.<verse eid="ECC 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 4:8" />Nne awohng jolo go no lene ntahng ntahng, jol mmon a belem afii mmonannyehn.</para>
  <para style="q2" vid="ECC 4:8">Tvtv o, á joom lahng eltum alimi, jol afang enye we-e joom gbal.</para>
  <para style="q3" vid="ECC 4:8">Owo á kehm bahbe elne re, &lt;&lt;Anv, nne awoo me n kp'nyehne erem jo lim eltum nia ka-e,&gt;&gt; &lt;&lt;Fvfo jenji wahnge n kil elbele ngare lim elgeere?&gt;&gt;</para>
  <para style="q4" vid="ECC 4:8">Jia fvfo tob li ejum mbol mbol, a erem bi kpo kpo ko et'tane ba!<verse eid="ECC 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 4:9" />Ane abal ba ga nob sehnge nne awohng,</para>
  <para style="q2" vid="ECC 4:9">tibre, tibre nsehng eltum ebo bahke gbale.<verse eid="ECC 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 4:10" />Nne awohng ebo l'foro gbo, noko bahk-e mehle yiimi.</para>
  <para style="q2" vid="ECC 4:10">Wo eyuu a nne no bahke gboko fvfo k'bel nne no bahk-e mehle yiimi.<verse eid="ECC 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 4:11" />Budu o, ane abal l'noongo edi ajehng, bo bahke bele elfuubu bo.</para>
  <para style="q2" vid="ECC 4:11">Wo nne no li antahng bahke limi rejen kehm bele elfuubu ngubjing?<verse eid="ECC 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 4:12" />Jol nne awohng nne noko bahk-e ma ko elfono, ane abal bahke ma yiimi ka elbo.</para>
  <para style="q2" vid="ECC 4:12">Nlehke mi bo fere nja era bahke riidi eltohngo kim.<verse eid="ECC 4:12" /></para>
  <para style="s">Eko edi afili ejumjum lohngem</para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 4:13" />Nkubin a njangkun nyi kpi ngbere nyi ga nob sehnge ek'kulu egboolo ntul, no kil jo wuk erehke.<verse eid="ECC 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 4:14" />Li ma jol re njangkun nyio lohngo ngbekobo ba kuumu etul, afii bo jele go ekpak go ejahbe ji á kp'fili.<verse eid="ECC 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 4:15" />N nyehne re ane kpee ba jolo go elkpin go njini jo toono njangkun nyio nyi ba kuumu etul toon-e.<verse eid="ECC 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 4:16" />Ane ba á jo fili bo, jol go nfange bo jolem.</para>
  <para style="q2" vid="ECC 4:16">Wo ane ba bo jele bo ngare nyi á ma kuumu etul sehng, eltim yebem bo bada a ne. Jia ejumjum lohngem, nne kp'kame na toono elfeb.<verse eid="ECC 4:16" /></para>
  <chapter eid="ECC 4" />
  <chapter number="5" style="c" sid="ECC 5" />
  <para style="s">Lim ana a ko nwongo ka Jehova</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 5:1" />Jo baabe akpade eljen enya a l'je go Etahk Esowo. Jo je re wo song wuungu atung, sehnge re wo song lim njom nyi agboolo ane, bo ji kil jo kahn re boblim ebi.<verse eid="ECC 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 5:2" />Ka jo warre go nnyo, jol ejum ki-a jo foomo go eltim re wo bung ejum ajehng ajehng go esamahr bi Esowo.</para>
  <para style="q2" vid="ECC 5:2">Esowo li go elbung, wo li ga ndi, owo wahnge nobo re wo k'ga jo bung.<verse eid="ECC 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 5:3" />Nne kpo leeme nlem tib go nsol gbalee nyi wob-e go eltim,</para>
  <para style="q2" vid="ECC 5:3">fvfo egboolo nne kpo bung alum gbalee.<verse eid="ECC 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 5:4" />A l'ko nwongo a Esowo, ka laange ellimi ejum jio.</para>
  <para style="q2" vid="ECC 5:4">Esowo eltim we-e kpehme yebe bada agboolo ane; lim ji a ko nwongo.<verse eid="ECC 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 5:5" />Ga fuumu re nne k'ko nwongo sehnge re á ko, k'lim ji á nyame no.<verse eid="ECC 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 5:6" />Ka taame nnyo ema gbul-a kak go abiafem. Fvfo ka yiimi nfaabe a ntiigetib no Etahk Esowo re, &lt;&lt;Nwongo nyi n ko no, n soodo na.&gt;&gt; Jenji wahnge a bahke limi re eltim rak Esowo bade ajum ji a bungu no, fere rannge eltum abo enya?<verse eid="ECC 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 5:7" />Alem gbalee a eb'bungu gb'gbal kehme lohng ejumjum.</para>
  <para style="q2" vid="ECC 5:7">Fvfo jo fahl Esowo.<verse eid="ECC 5:7" /></para>
  <para style="s">Afang ejumjum lohngem</para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 5:8" />A l'nyehn go esi jahbe re bo kp'limi nkpak eblum, fere jo lam elam eje go ebi mbang, taar-e eno eje, nsol ana nyio ki-a jo kpo esi, tibre ntubesi abalimentum awohng awohg kpo bel nne no kpe fil-e. Wo atubesi bao abal abal kpi nne no kp'ware sehnge bo ane abal abal.<verse eid="ECC 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 5:9" />Nsehng nyi ndi li ka ane kpee; yefono ntul kpo tob li nsehng go ebgbe bi bo bahme.<verse eid="ECC 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 5:10" />Nne awohng awohng no akpohko kpo kor-e, akpohko we-e nehm tiki gbal;</para>
  <para style="q2" vid="ECC 5:10">nne awohng awohng no nsol afang kpo kor-e, nsehng afang we-e nehm tiki gbal.</para>
  <para style="q3" vid="ECC 5:10">Jia fvfo ejumjum lohngem.<verse eid="ECC 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 5:11" />Ana nsol kp'ruru,</para>
  <para style="q2" vid="ECC 5:11">ano wo ane ba kpo li kpo tob rur.</para>
  <para style="q3" vid="ECC 5:11">Anv nsehng anyii li no a nne no kpi no, sehnge re kpo kor bo re bo jo ko amahr jo nyehn?<verse eid="ECC 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 5:12" />Ellu ni nne no ma lim nltum kpo yebe sehng, jol afii bo li nsol ntiil afii bo li gbalee,</para>
  <para style="q2" vid="ECC 5:12">wo efangene, nsol afang ebo nehm taame re bo lal.<verse eid="ECC 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 5:13" />Me n nyehn egburu ebi ejum go njini nyia,</para>
  <para style="q2" vid="ECC 5:13">ji li re, nne l'behr afang enye es'kohro bahke koko ebi ba ka-e,<verse eid="ECC 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 5:14" />afii afang nyao fere tane tib go ebibesi,</para>
  <para style="q2" vid="ECC 5:14">wahnge á l'jel mmon, ejumjum nehm kpe jol ji elkv alehke.<verse eid="ECC 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 5:15" />Nne awohng awohng kpo lohng ebun ebun go ala nnyehn ba, ana nne awohng awohng ba no, ano wo á bahke feere.</para>
  <para style="q2" vid="ECC 5:15">Ejumjum á nehm bel go ntum enye kpee nyi á jo nyennge lim, ji á bahke fili go ege ebo asongo.<verse eid="ECC 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 5:16" />Jia fvfo egburu ebi ejum ji:</para>
  <para style="q2" vid="ECC 5:16">Tibre ana nne awohng awohng ba no, ano wo á bahke feere,</para>
  <para style="q3" vid="ECC 5:16">fvfo nsehng anyii bo kpi no, eji bo kp'nyennge lim eltum ka elfeb?<verse eid="ECC 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 5:17" />Go afung enye kpee, á kpo li nsol go ejannge,</para>
  <para style="q2" vid="ECC 5:17">a elmarre ekubin a erakatahng.<verse eid="ECC 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 5:18" />Ejum ji a ji m ma nyehn re kp'nobo: Ji li re, ga fuumu re nne jo li fere jo w'wo, jo bel elwohngo go ntum abo enye nyi á kp'limi go njini nyia go abon afung elkpin ba Esowo me-e ka,</para>
  <para style="q3" vid="ECC 5:18">tibre jia ji li ji Esowo me-e ka.<verse eid="ECC 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 5:19" />Budu o, Esowo l'ka nne agburu afang á fere bel nsol,</para>
  <para style="q2" vid="ECC 5:19">fere ka-e eko re á jo li nsehng go nsol nyio, fere ko re ano wo elkpin li no, jo bel eyebatahng go eltum ene, jia ayare nya Esowo nya.<verse eid="ECC 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 5:20" />Nne noo nehm jo tir gbalee bade afung nya elkpin ene, tibre Esowo me-e bum re á jo li elfo.<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false" /></note><verse eid="ECC 5:20" /></para>
  <chapter eid="ECC 5" />
  <chapter number="6" style="c" sid="ECC 6" />
  <para style="s">Ka yehke ntir kunu go afang</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 6:1" />Me n nyehn ebi ejum jehko go njini, li egburu elsol ka ane.<verse eid="ECC 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 6:2" />Esowo kpo ka ane bandiki agburu afang, a nsol afang go ekpunu, wahnge bo limm elehng ejum ejehng ajehng ji eltim ebo sebe no, wo Esowo kpehme ka bo eko re bo li nsehng nyi nsol nyio, fvfo ajenne nya bahke lehke nsehng nyio. Jia ejumjum lohngem, egburu eyameltim ji.<verse eid="ECC 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 6:3" />Nne li ma bel abon atahl alon, fere kang nya tvv, wo jol afii elkpin ene labe renan, á tohko ma li nsehng nyi afang enye, fvfo bo tohko ma lim elkv ene ana fuumu no, me n kp'bungu re, mmon no bo ejel ekpakv wo ga nob sehnge nne noo.<verse eid="ECC 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 6:4" />Tibre á kpo ba ana ejum ji kii lohng ejumjum, fvfo mbing enye ebtob sa go ejannge.<verse eid="ECC 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 6:5" />Jol mmon no ki nyehn ebare elbung, afii kahn ejumjum, ye wo ga kpi erekekv sehnge efange nne.<verse eid="ECC 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 6:6" />Jol afii nne noo kange nnya atahltahl nkpel elon, wo á maam li nsehng nyi afang nya á bele no. Anv edi j'nehm sang bo kpee fi noa?<verse eid="ECC 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 6:7" />Nne awohng awohng kpo nyennge lim eltum re a bel ejum alehke,</para>
  <para style="q2" vid="ECC 6:7">wo ga ekpidla nehm tiki wohngo.<verse eid="ECC 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 6:8" />Nsehng anyii nnea ngbere kpi no sehnge egboolo nne?</para>
  <para style="q2" vid="ECC 6:8">Nsheng anyii akpak bahke bele go elkahne mbang ana nyi bo bahke jo fili elbo go ellong ane?<verse eid="ECC 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 6:9" />Ellehke ji nne kp'nyehne go ege amahr ji ga nob, sehnge re nne jo tiiri bade ejum ji á kala nyehn go ege amarhr.</para>
  <para style="q2" vid="ECC 6:9">Jia fvfo ejumjum lohngem, nne kp'kame na toono elfeb.<verse eid="ECC 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 6:10" />Ejum ajehng ajehng ji li no bob tohko gungu mbing, fvfo ji nne li no, bob tohko kahn bade;</para>
  <para style="q2" vid="ECC 6:10">nnene nehm ma yiimi abohng a nne no kp'tahne sehng-e.<verse eid="ECC 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 6:11" />Ana alum kp'ruru, ano wo kil jo kpe lohng ejum jum,</para>
  <para style="q2" vid="ECC 6:11">fvfo nsehng anyii jio bahke ma ka nne awohng awohng?<verse eid="ECC 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 6:12" />Tib anv, nne awoo kp'kahne ji kp'nobo ka nne go elkpin, go abon afung ba ki lohng ejumjum nya á li elkpin ni bahke sehnge ana etohko? Nne awoo bahk-e tongo ji bahke jolo go njini, go ngare nyi á ma kpo?<verse eid="ECC 6:12" /></para>
  <chapter eid="ECC 6" />
  <chapter number="7" style="c" sid="ECC 7" />
  <para style="s">Ngbere</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 7:1" />Nnooba mbing kp'nobo sehnge atingi akehng es'sv eleenge,</para>
  <para style="q2" vid="ECC 7:1">fvfo efung bi nne kpo no kp'nobo senge efung bi bo jel-e no.<verse eid="ECC 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 7:2" />Ga nob re nne je go etahk ji ane nong elkv, senge re á je go etahk elkak,</para>
  <para style="q2" vid="ECC 7:2">tibre elkv ni li ejum ji li ka nne awohng awohng;</para>
  <para style="q3" vid="ECC 7:2">nobo re ane ba elkpin ko jia kak go eltim.<verse eid="ECC 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 7:3" />Ndon nyi ga nob sehnge asol,</para>
  <para style="q2" vid="ECC 7:3">tibre esahmahr ndon ndon kp'nobo ka eltim.<verse eid="ECC 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 7:4" />Eltim ni nnea ngbere li go etahk elkv,</para>
  <para style="q2" vid="ECC 7:4">wo eltim ni agboolo ane li go etahk elfo alehke.<verse eid="ECC 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 7:5" />Ga nob re nne wuk erehke ji nne a ngbere</para>
  <para style="q2" vid="ECC 7:5">sehnge re nne jo wuungu atung go ese ji agboolo ane.<verse eid="ECC 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 7:6" />Ana ajoong kp'tahke go agun nya etu kun no, ano wo asol nya egbooko nne li no.</para>
  <para style="q2" vid="ECC 7:6">Jia fvfo ejumjum lohngem.<verse eid="ECC 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 7:7" />Eloono nne kpo lim nnea ngbere fere jol egboolo nne,</para>
  <para style="q2" vid="ECC 7:7">fvfo ngu kpo rannge eltim nne.<verse eid="ECC 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 7:8" />Nkahlsi ejum kp'nobo sehnge mbomannahm,</para>
  <para style="q2" vid="ECC 7:8">fvfo elkpuumu kp'nobo sehnge agaabe.<verse eid="ECC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 7:9" />Ka jo ware rak eltim sohk sohk go ega atahng,</para>
  <para style="q2" vid="ECC 7:9">tibre erakatahg wob go ntim nyi agboolo ane.<verse eid="ECC 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 7:10" />Ka jo bung re, &lt;&lt;Jenji wahnge afung nya mahne mahne, nobo sehnge afung nya lela?&gt;&gt;</para>
  <para style="q2" vid="ECC 7:10">Tibre fuuemem re nne jo bahb abahbe ana nyao.<verse eid="ECC 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 7:11" />Ngbere li nnoobo ejum ana elehkelkv,</para>
  <para style="q2" vid="ECC 7:11">kpi nsehng ka ane ba li go elkpin.<verse eid="ECC 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 7:12" />Ngbere li ejum ji kpo bulu nne</para>
  <para style="q2" vid="ECC 7:12">ana akpohko li ejum ji kpo bulu nne,</para>
  <para style="q3" vid="ECC 7:12">wo nsehng nyi elkahne li re, ngbere kpo kuuru ane ba kpi-e no.<verse eid="ECC 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 7:13" />Tir bada ji Esowo ma lim,</para>
  <para style="q2" vid="ECC 7:13">nne awoo bahke ma tanne ji á ma lim galle galle galle?<verse eid="ECC 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 7:14" />L'nob a na, jo bel eyebatahng; wo l'sab a na, jo buumu jia, re, Esowo eblim ejum jia ana a limi jehko.</para>
  <para style="q2" vid="ECC 7:14">Fvfo, nnene nehm ma kahn ejumjum bade ana bahke jolo a ne behnjehle.<verse eid="ECC 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 7:15" />Go elkpin ename nia ni kii lohng ejumjum, me n nyehn nsol ebal nyia:</para>
  <para style="q2" vid="ECC 7:15">Me n nyehn etinginne kp'kpoko tan go etingi eljini ene, ebi nne fere bel nlaabe elkpin go ege ebi eljini.<verse eid="ECC 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 7:16" />Ka jo tir bade elna re wo wo ga kpi etingi eljini,</para>
  <para style="q2" vid="ECC 7:16">jol ka tir re wo wo ga kpi ngbere, jenji wahnge a bahke rannge elna?<verse eid="ECC 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 7:17" />Ka jo gbal go ab'bi alimi,</para>
  <para style="q2" vid="ECC 7:17">fvfo ka jol egboolo nne, jenji wahnge a bahke kpoko ngare enya kehm rehnge.<verse eid="ECC 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 7:18" />Ga nob re wo gbo ejahm go ejum ajehng go nsol nyia,</para>
  <para style="q2" vid="ECC 7:18">fvfo jol ka yake jehko.</para>
  <para style="q3" vid="ECC 7:18">Nne awohng awohng no kpo fahl Esowo nehm gbo yel nsol nyia.<verse eid="ECC 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 7:19" />Ngbere kpo lim nnea ngbere awohng tahne</para>
  <para style="q2" vid="ECC 7:19">sehnge afiladi awubu ba li go nfam.<verse eid="ECC 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 7:20" />Lohko li ano re, nnene lim go njini no li etinginne;</para>
  <para style="q2" vid="ECC 7:20">nnene lim no kpo lim nsol go nseenga nseenge k'tiki lim abiafem<verse eid="ECC 7:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ECC 7:21" />Ka jo kunu atung go ellum anehng anehng ni ane kp'bungu;</para>
  <para style="q2" vid="ECC 7:21">tohko jol ano, a bahke wuku nlokeltum ewa kp-a suku,<verse eid="ECC 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ECC 7:22" />tibre a kp'kahne go ega eltim</para>
  <para style="q2" vid="ECC 7:22">re, akpel tvv wofonantahng kpo t'tob su ane bako.<verse eid="ECC 7:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ECC 7:23" />Nsol nyia kpee n ko ngbere wuungu, n kehm bung re,</para>
  <para style="q2" vid="ECC 7:23">&lt;&lt;Me n ntoobo egame eltim re me n bel ngbere,&gt;&gt; wo ga ejum jia ebgbal sehng-m.<verse eid="ECC 7:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ECC 7:24" />Ejum ajehng ajehng ji li no, li go fee, fere r'rahbe,</para>
  <para style="q2" vid="ECC 7:24">nne awoo bahke ma seb kahn?<verse eid="ECC 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ECC 7:25" />Owo n kehm fere yehhke ntir enyame kunu re me n bel ekahnafem,</para>
  <para style="q2" vid="ECC 7:25">re me n feede, fere seb ngbere yehke, kahn ana nsol lohngo lohng,</para>
  <para style="q3" vid="ECC 7:25">fere lenng-m bade ademme nya li go ebiljini a esahl bi li go elgboolo.<verse eid="ECC 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ECC 7:26" />Me n nyehn re ejum jia kp'yame sehnge elkv,</para>
  <para style="q2" vid="ECC 7:26">nenkal no li ana ekpoko, ye ji eltim ene li ekpoko, fvfo abo enye li agbekobo.</para>
  <para style="q3" vid="ECC 7:26">Nenlum no kpo lim ji kpo kor Esowo bahke foro go ege abo, wo nne abiafem wo bahke gboko ege ekpoko.<verse eid="ECC 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ECC 7:27" />Nt'tibi kp'bungu re, &lt;&lt;Nyehn gae!&gt;&gt;</para>
  <para style="q2" vid="ECC 7:27">&lt;&lt;Ejum ji a ji m ma seb kahn, me n ko ejum ajehng budu a jehko, eji n l'kahn ana nsol lohngo lohng.&gt;&gt;<verse eid="ECC 7:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ECC 7:28" />Ana n jo seb asongo, jol eji n kala ny'nyehn,</para>
  <para style="q2" vid="ECC 7:28">wo nyehne nnelum na awohng no li songo songo go ellong ane atahl alon nkpel ewubu (1000), wo nenkal na awohng n nyehnem go ellong ane baa kpee.<verse eid="ECC 7:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ECC 7:29" />Ejum ajehn ji m ma nyehn ji a, ji li re, Esowo limi ane ba li elkpin songo songo,</para>
  <para style="q2" vid="ECC 7:29">wo bobtahm kp'sebe afehme abang gbalee.<verse eid="ECC 7:29" /></para>
  <chapter eid="ECC 7" />
  <chapter number="8" style="c" sid="ECC 8" />
  <para style="q1">
    <verse number="1" style="v" sid="ECC 8:1" />Nne awoo li ana nnea ngbere?</para>
  <para style="q2" vid="ECC 8:1">Nne awoo bahke ma lennge nsol ka ane?</para>
  <para style="q3" vid="ECC 8:1">Ngbere nyi nne kpi no kpo lim re esamahr ebe jo bang, fere yaange elbohngo esahmahr ebe bi kp'nyehnge.<verse eid="ECC 8:1" /></para>
  <para style="s">Jo kpunu ntul</para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 8:2" />N kp'bungu tong-a re wo jo kpunu nkahn nyi ntul, tibre a ko nwongo go essamahr bi Esowo<verse eid="ECC 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 8:3" />Ka foomo tahm lohng go esamahr ntul. Ka yel ellong ane ba kpo toobo bade ab'bi, tibre ntul bahke ma lim ejum ajehng ajehng ji kor-e no.<verse eid="ECC 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 8:4" />Eji li re ellum ni ntul kpi egbuuru eko, nne awoo bahke ma bung a ne re, &lt;&lt;Ejum aji a kp'limi?&gt;&gt;<verse eid="ECC 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 8:5" />Nne awohng awohng no kpunu nkahn enye, ebi ejum nehm gbo tub-e,</para>
  <para style="q2" vid="ECC 8:5">fvfo nne no kpi ngbere go eltim bahke kahne ngare nyi fuumu re á lim nsol nyia, a mbang ana nyi á bahke koko lim.<verse eid="ECC 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 8:6" />Tibre ngare nyia, nyi fuumu no re nne lim ejum ajehng ajehng,</para>
  <para style="q2" vid="ECC 8:6">a mbang ana nyi á bahke limi, jol eji li li re nne li ekubin ekubin.<verse eid="ECC 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 8:7" />Eji li re nnene nehme kahn ji behna,</para>
  <para style="q2" vid="ECC 8:7">nne awoo bahke ma tong ntem ejum ji bahke jolo?<verse eid="ECC 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 8:8" />Ana nnene kii kpi nsahm nyi á bahke ma kpan elfeb,</para>
  <para style="q2" vid="ECC 8:8">ano wo nnene kii kpi nsahm bada ngare elkv enye.</para>
  <para style="q3" vid="ECC 8:8">Ana bo kil jo yehke nne go nsoja ngare ebta, ano wo ab'bi l'k'ma yake ane abo bo ji kp'limi.<verse eid="ECC 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 8:9" />N nyehne nsol nyia kpee, eji n yehke ntir enyame kak go nsol kpee nyi bo kp'limi go njini nyi ane bandiki kpi eko fvfo ane bako kpi erem nyehn go ebo elwo.<verse eid="ECC 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 8:10" />Ano wo fvfo n nyehne ana bo limi elkv abi ane, kpa bo kak, bo jio ji jo kono elbake go edi li saang fere feere, fvfo ane jo tehke bo go nfam nyi bo jo lim nsol nyia. Jia fvfo ejumjum lohngem.<verse eid="ECC 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 8:11" />Erem akake bi bo kimi elam bada nne no limi eb'bi l'jo laange, ntim ane kpo kehme elsebe abang nya bo bahke koko jo lim ab'bi.<verse eid="ECC 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 8:12" />Jol afii ebi nne ji limi abi nsol nkpel atahl alon kange aya tvv, n kp'kahne re bahke nobo a ane ba kpo fahl Esowo, ba kpo kpun-e go ege esamahr.<verse eid="ECC 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 8:13" />Wo eji abi ane kil jo fahl Esowo, nehm nob a bo, jol afung ebo nehm lahb ana etohko elgung.<verse eid="ECC 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 8:14" />Ejum ajehng jehko jia ji kpeka li ji ki lohng ejumjum go njini. Etinginne no bele ji kehn fuumu a ebi nne, a ebi nne ji bele ji kehn fuumu a etinginne. Jia fvfo, lohngem ejumjum.<verse eid="ECC 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 8:15" />Owo wahnge egame, fuumu re nne jo li elkpin go njini nyia, tibre ejumjum limm ji nobo no ka nne sehnge re, á jo li, jo w'wo, fere bel eyebatahng go elkpin. Owo eyebatahng bahke toono bo go ntum erem ebo go afung kpee nya elkpin ebo nya Esowo ma ka bo go njini nyia.<verse eid="ECC 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 8:16" />Eji n neyhke ntir enyame kunu re me n kahn bada ngbere fere kunu amahr nyehn ntum nyi ane kpo lim go njini, nyi wahnge bo kil jo lal atv a njul,<verse eid="ECC 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 8:17" />owo n kehm nyehne nsol kpee nyi Esowo ma lim. Nnene nehm ma kahn ana ji kp'j'jol go njini nyia. Jol ana bo kp'n'nok kpee re bo feede kahn, nnene we-e nehm ma tiki lennge ana lohngo lohng. Jolafii aneb ngbere kp'woro nnyo re bo kp'kahne, nehm ma tiki lennge bo.<verse eid="ECC 8:17" /></para>
  <chapter eid="ECC 8" />
  <chapter number="9" style="c" sid="ECC 9" />
  <para style="s">Ji li ka ane kpee</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 9:1" />Ano wo n jo tir bade nsol nyia kpee fere kohlo asi re, etinginne a nnea ngbere a nsol nyi bo kp'limi wob go abo nya Esowo, wo nnene nehme kahn joare elkoro ni nong kpi bo sik afii etehn nne.<verse eid="ECC 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 9:2" />Ejum ajehng j'nehm ji kpo gbo tub bo ane kpee, atingane a abiane, anobonbo a asabsab, ane ba li saang a ba ki li saang, ane ba kpo lim ajom ka Esowo a ba kil jo lim ajom ka Esowo.</para>
  <para style="q2" vid="ECC 9:2">Ana li a nnooba nne ano wo tob li a nne abiafem;</para>
  <para style="q3" vid="ECC 9:2">ana li a ane ba kpo ko nwongo, ano wo tob li a ane ba kpo fahl nwongo akoko.<verse eid="ECC 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 9:3" />A wo li ebi ejum ji li go ejum ajehng ajehng ji kp'jolo go njini, ji li re, ejum ajehng j'nehm ji kpo gbo tub ane kpee. Budu o, ab'bi ebrur go nitim ane, esahl tob wob bo go ntim ana bo li go elkpin, tete bo kpo song jol a akvne.<verse eid="ECC 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 9:4" />Nne awohng awohng no li elkpin kpi ekunukpu, jol mbv nyi li elkpin kp'gake nob sehnge egabi ji ma kpo.<verse eid="ECC 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 9:5" />Tibre ane ba li go elkpin kp'kahne re bo bahke kpoko,</para>
  <para style="q2" vid="ECC 9:5">wo akvne ejumjum bo nehme kahn,</para>
  <para style="q3" vid="ECC 9:5">eltuuru bo kpeem kpi, jol abing ebo ane ebyini<verse eid="ECC 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 9:6" />Elkoro ebo, a etehnne ebo,</para>
  <para style="q2" vid="ECC 9:6">go eteele ala ebo ebtan fi ekidi eblab;</para>
  <para style="q3" vid="ECC 9:6">bo nehm ma kpe lim ejum ajehng ajehng bade nsol nyi kp'jolo go njini<verse eid="ECC 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 9:7" />Song, wo song li nsol alehke enya a eyebatahng, wo amahm ema a eyebeltim tibre Esowo ebtaame tv ejum ji a kp'limi.<verse eid="ECC 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 9:8" />Jo liibi a babare nsol ngare kpekpe, fvfo wo fere jo kak elna akehng go esi ngare kpekpe.<verse eid="ECC 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 9:9" />Jo li elkpin a nkal ewa no kpo kor-a, go afung kpe kpe nya elkpin ena ni ki lohng ejumjum, ni Esowo m-a ka go njini, afung enya kpee nyao nya ki lohng ejumejum. Tibre ejum ji a, ji li ka go elkpin, fvfo go eltum ni a kp'nyennge jo lim go njini.<verse eid="ECC 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 9:10" />Ejum ajehng ajehng ji a kake abo enya re wo lim, lim a eko eko eja kpee, tib go ejahbe akvne ji a fi no, eltum alimi go limm, jol ntoobo, jol elkahne afii ngbere limm.<verse eid="ECC 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ECC 9:11" />Me n tob nyehn ejum jehko go njini nyia:</para>
  <para style="q2" vid="ECC 9:11">Nne no kpo ware abahl abeke sang kpo be ga ane bako,</para>
  <para style="q3" vid="ECC 9:11">jol nne eko sang kpo ko esehnge ebta,</para>
  <para style="q4" vid="ECC 9:11">jol nne a ngbere sang kpo bel nsol alehke,</para>
  <para style="q1" vid="ECC 9:11">afii agburu afang jol ka ebangbanag nne,</para>
  <para style="q2" vid="ECC 9:11">afii nnoobo jol ka nne elkahne;</para>
  <para style="q3" vid="ECC 9:11">Kpo jol go enobesi, nne l'jol go edi ji fuumu no go ngare nyi fuumu no.<verse eid="ECC 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 9:12" />Fvfo, nnene nehme kahn ana ngare ny'nye bahke bake:</para>
  <para style="q2" vid="ECC 9:12">Ana bo kpo ko arim eblum bob nsahre,</para>
  <para style="q3" vid="ECC 9:12">afii ana nruk kpo gbo ekpoko,</para>
  <para style="q4" vid="ECC 9:12">ano wo ebi ngare kpo bob ane ana ekpoko, kpo gbede na bo.<verse eid="ECC 9:12" /></para>
  <para style="s">Ngbere nyi ga nob sehnge elgboolo</para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 9:13" />Fvfo n kehm kpe tob nyehn ntugare nyehko nyi li bada ngbere go njini nyia, nyi liim na egbuuru nkpoko esi ejum.<verse eid="ECC 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 9:14" />Mojahbe awohng jolo go, a abon amohk ane ba lene o. Owo ntul no kpi eko kehm ba yiimi ebta a bo, sennge bo kak, fere si nkpak ngbe sennge ekahme nfam kak.<verse eid="ECC 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 9:15" />Nnenlum awohng lene o no jolo nkpak, wo á bele ngbere, fvfo a ko ngbere enye tahre nfam nyio. Jol nnene buumem nkpak a nne noo.<verse eid="ECC 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 9:16" />Ano wo m bungu no re, &lt;&lt;Ngbere nyi ga nob sehnge atahne.&gt;&gt; Wo bo rodo ngbere nyi nkpak nyio daange, jol alum enye bo nehme kpe wuk.<verse eid="ECC 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 9:17" />Anaange alum nya nnea ngbere nya ga fuumun re nne wuk,</para>
  <para style="q2" vid="ECC 9:17">sehnge elrabe ni mfiladi no agboolo ane.<verse eid="ECC 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 9:18" />Ngbere nyi ga nob sehnge nsol ebta,</para>
  <para style="q2" vid="ECC 9:18">wo nne abiafem awohng kpo rannge anoobo nsol gbalee.<verse eid="ECC 9:18" /></para>
  <chapter eid="ECC 9" />
  <chapter number="10" style="c" sid="ECC 10" />
  <para style="q1">
    <verse number="1" style="v" sid="ECC 10:1" />Ana akpakv aj'jahnge kpo lim re akehng es'sv eleenge jo v esabsab es'sv,</para>
  <para style="q2" vid="ECC 10:1">ano wo li bada nne elkahne a ekpunu bo l'lim elgboolo ntiil.<verse eid="ECC 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 10:2" />Eltim ni nnea ngbere kpo jol feere go ejang etingi mbang,</para>
  <para style="q2" vid="ECC 10:2">wo ni egboolo nne kpo jol feere go ejang ab'bi.<verse eid="ECC 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 10:3" />Jol eji agboolo ane kp'jene asongo go mbang,</para>
  <para style="q2" vid="ECC 10:3">ntir nyi nno bo kpimm,</para>
  <para style="q3" vid="ECC 10:3">bo kpo tib nne awohng awohng eldaabe ebo.<verse eid="ECC 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 10:4" />Nfiladi l'rak eltim bade a na,</para>
  <para style="q2" vid="ECC 10:4">ka tahm edi eltum eja sa;</para>
  <para style="q3" vid="ECC 10:4">nnaangeljini bahke limi bo tahm ka nne go nsoodo.<verse eid="ECC 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 10:5" />Ebi eju jia a, ji m ma nyehn go njini nyia,</para>
  <para style="q2" vid="ECC 10:5">elkohn nsoodo nyi nfiladi kpo lim:<verse eid="ECC 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 10:6" />Agboolo ane bo kpo rod bo kunu go awahrewahre adi gbalee,</para>
  <para style="q2" vid="ECC 10:6">wo ga afangane, kpo kuumu arederede adi.<verse eid="ECC 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 10:7" />Me n nyehn aju kun go ajahm ebvankang,</para>
  <para style="q2" vid="ECC 10:7">wo atubesi ane fere jo jen go akpade ana aju.<verse eid="ECC 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 10:8" />Nne awohng awohng no kpa elbing, li ma gbo yel o;</para>
  <para style="q2" vid="ECC 10:8">nne awohng awohng no wa ekahme re a yel, nnyo li-e ma tohko.<verse eid="ECC 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 10:9" />Nne awohng awohng no kpo kpa atahl yehke, atal nyao bahk-e ma lim ejum;</para>
  <para style="q2" vid="ECC 10:9">nne awohng awohng no kpo yange nti, á li go efin efin, li-e ma lim ejum.<verse eid="ECC 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 10:10" />Elfuk l'kohd,</para>
  <para style="q2" vid="ECC 10:10">fvfo bo tohko k'bange, nne bahke kake eko gbalee lim eltum,</para>
  <para style="q3" vid="ECC 10:10">wo nne no elfuk m-e nahre bahke limi nobnob.<verse eid="ECC 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 10:11" />Nnyo l'gbo mbang tohko nne, nnea ntanne kehm-e koko elfono,</para>
  <para style="q2" vid="ECC 10:11">eblohng re nnea ntaane noo bo we-e nehm kpe kpi.<verse eid="ECC 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 10:12" />Alum nya lohng go nnyo mi nnea ngbere li anoobo alum,</para>
  <para style="q2" vid="ECC 10:12">wo agboolo ane kpo wul elbo go eboa nnyo.<verse eid="ECC 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 10:13" />Go mboma mbomo alum e bo li agboolo alum;</para>
  <para style="q2" vid="ECC 10:13">ekahlsi alum ebo li abi alum nya esahl,<verse eid="ECC 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 10:14" />fvfo agboolo ane kpo bung alum gbalee.</para>
  <para style="q2" vid="ECC 10:14">Nnene nehme kahn ji kp'bake,</para>
  <para style="q3" vid="ECC 10:14">fvfo nne awoo bahke ma tong ntem ji bahke jolo b'njehle ngare nyi bo ki kpe li?<verse eid="ECC 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 10:15" />Eltum ni agboolo ane kpo nyennge jo lim, kpo lahng na bo,</para>
  <para style="q2" vid="ECC 10:15">bo kpehme kahn mbang rehng to nfam.<verse eid="ECC 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 10:16" />Eyuu a ejahbe ji ntula bo jolo nlokeltum,</para>
  <para style="q2" vid="ECC 10:16">bo ji atubesi ane ebo kpo lim nkak efungfu.<verse eid="ECC 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 10:17" />Elfuulu li ka ejahbe ji ntula bo lohng go ebangenahb ji agburu ane,</para>
  <para style="q2" vid="ECC 10:17">ye ji atubesi ane ebe kpo lim nkak go ngare nyi fuumu no,</para>
  <para style="q3" vid="ECC 10:17">eji bo l'bel eko, bo kpehme lim re bo jo wo fere jo b'buumu.<verse eid="ECC 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 10:18" />Ewon kpo lim elbulutahk jak;</para>
  <para style="q2" vid="ECC 10:18">tib eji abo li nehme nehme, etahk kpo l'lahl.<verse eid="ECC 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 10:19" />Elkak bo kpo lim re ane jo wol asol,</para>
  <para style="q2" vid="ECC 10:19">amahm kpo lim elkpin jol yebe yebe,</para>
  <para style="q3" vid="ECC 10:19">fvfo akpohko nya li nfaange nyi ejum ajehng ajehng.<note caller="+" style="fe"><char style="fr" closed="false">10:19 </char><char style="ft" closed="false" /></note><verse eid="ECC 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 10:20" />Ka nyok ntul, jol go ega eltim,</para>
  <para style="q2" vid="ECC 10:20">afii su efangenne go ega ekp'kpa elkang,</para>
  <para style="q3" vid="ECC 10:20">tibre ebruk bi kp'foongo go elbung bahke ma rod alum enya, fvfo ebruk bi kpo foongo bahke ma tooro ji a bungu no.<verse eid="ECC 10:20" /></para>
  <chapter eid="ECC 10" />
  <chapter number="11" style="c" sid="ECC 11" />
  <para style="s">Rod akpohko enya kak, wo jen ajoobo are</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 11:1" />Ro abred enya kak go alahb;</para>
  <para style="q2" vid="ECC 11:1">l'kang afung gbalee, a bahke ma bel nsehng.<verse eid="ECC 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 11:2" />Kak akpohko enya go are na asehma, jol kak rehng anehkeni;</para>
  <para style="q2" vid="ECC 11:2">a nehme kahn ebi erem bi bahke gboko tub ejahbe.<verse eid="ECC 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 11:3" />Akparesemsem l'jol alahb alahb,</para>
  <para style="q2" vid="ECC 11:3">kpo na elahb wohngo go ndi.</para>
  <para style="q3" vid="ECC 11:3">Jol afii eti gbo feere go ejang aboblum afii ejang ebobkal, edi j'nehm ji gbo no, o wo kpo noongo<verse eid="ECC 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 11:4" />Mbahmgbe awohng awohng no kp'kahn ejang ji elfeb kpo lohng ba kp'kahn ngare nyi á l'k'bahme nosl enye;</para>
  <para style="q2" vid="ECC 11:4">mbahmgbe awohng awohng no kp'kahne bade akparesemsem kpo kahn ngare nyi ki fuumu re á fv nsol enye.<verse eid="ECC 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 11:5" />Ana a kil elkahne mbang nyi nfeb kpo sehng,</para>
  <para style="q2" vid="ECC 11:5">afii ana nne kpo jini go ala nnyehn,</para>
  <para style="q3" vid="ECC 11:5">ano wo a l'k'ma kahn eltum ni Esowo, ye ji li Nlima nsol kpee.<verse eid="ECC 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 11:6" />Bahm nsol ndi enya go ngare efungfu,</para>
  <para style="q2" vid="ECC 11:6">fvfo ngare elgung, non abo enya k're ekv,</para>
  <para style="q3" vid="ECC 11:6">tib a nehme kahn nsol nyi bahke nobo, ma nyao nya njii, afii nyako nya,</para>
  <para style="q4" vid="ECC 11:6">afii fundiki abbal abbal bahke nobo.<verse eid="ECC 11:6" /></para>
  <para style="s">Buumu Nne no lim-a no eji a kpeka njangkun</para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 11:7" />Ellennge kp'yebe,</para>
  <para style="q2" vid="ECC 11:7">nne kpo bel eyebe eltim re amahr enye nyehn njul.<verse eid="ECC 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 11:8" />Jol afii ne kahnge aya tvv,</para>
  <para style="q2" vid="ECC 11:8">nong bo bel elgeere aya nyao kpee.</para>
  <para style="q3" vid="ECC 11:8">Wo nong bo buumu afung nya ejannge, tibre afung nyao bahke bahke jolo gbalee.</para>
  <para style="q4" vid="ECC 11:8">Ejum ajehng ajehng ji kp'bake ejumjum lohngem.<verse eid="ECC 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 11:9" />Wahn ji li ajangkun, jo belen eyebatahng eji ń li ajangkun,</para>
  <para style="q2" vid="ECC 11:9">fvfo nong ntim enyahne jo ka-n eyebatahng go afung nya n li ajangkun.</para>
  <para style="q3" vid="ECC 11:9">Jo toonen abang nya nltim enyahne</para>
  <para style="q4" vid="ECC 11:9">a ejum ajehng ajehn ji amahr enyahne nyehne no.</para>
  <para style="q1" vid="ECC 11:9">Wo kahnen re go nsol nyia kpee,</para>
  <para style="q2" vid="ECC 11:9">Esowo bahk-n lungu elam.<verse eid="ECC 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 11:10" />Ano wo wahnge fuumu no re wo yehke egbiingi eltim go ega eltim,</para>
  <para style="q2" vid="ECC 11:10">fere rod atongtong nya ngubjing enya ro go,</para>
  <para style="q3" vid="ECC 11:10">tibre eljolo ejangkun a eljolo eko eko, ejumjum lohngem.<verse eid="ECC 11:10" /></para>
  <chapter eid="ECC 11" />
  <chapter number="12" style="c" sid="ECC 12" />
  <para style="q1">
    <verse number="1" style="v" sid="ECC 12:1" />Buumu nl'limi ewa</para>
  <para style="q2" vid="ECC 12:1">go ngare nyi a kpeka li njangkun,</para>
  <para style="q3" vid="ECC 12:1">afung nya atongtong kehm bake,</para>
  <para style="q4" vid="ECC 12:1">aya kehm kabbe, nya a bahke bung re, &lt;&lt; N kpimm ekor go ejum ajehng ajehng.&gt;&gt;<verse eid="ECC 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 12:2" />Ngare nyio njul a ellennge,</para>
  <para style="q2" vid="ECC 12:2">a ebareka go alonlo bahke daade, siingi ejannge,</para>
  <para style="q3" vid="ECC 12:2">fvfo akparesemsem kehm feere elahb l'na mal;<verse eid="ECC 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 12:3" />ngare nyi ane ba kpo baabe etahk bahke jo kahm,</para>
  <para style="q2" vid="ECC 12:3">tib go elfahle, atahntahn aneblum fere jo jen gong gong;</para>
  <para style="q3" vid="ECC 12:3">ngare nyi abagoko nsol l'k'kpe jol tibre bo li abon mohk ane abik abik,</para>
  <para style="q4" vid="ECC 12:3">fvfo ngare nyi amahr bahke bamme ane ba kpo fahng go mombua nkpe ekahme.<verse eid="ECC 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 12:4" />Ngare nyi bo ma bame abutahk nya afakabang,</para>
  <para style="q2" vid="ECC 12:4">fvfo ewahl nsol agoko fere rahke;</para>
  <para style="q3" vid="ECC 12:4">ngare nyi ane bahke nyahme tib eji nruk kp'siiki, wo ase ebo kpee bahke rahke na;<verse eid="ECC 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 12:5" />ngare nyi ane bahke jo fahl ejum ji kp'wahre,</para>
  <para style="q2" vid="ECC 12:5">a efin bi li go afakabang,</para>
  <para style="q3" vid="ECC 12:5">eji elrahn almon ma nyono,</para>
  <para style="q4" vid="ECC 12:5">fvfo ekpaange kp'feebe asongo,</para>
  <para style="q1" vid="ECC 12:5">ejumjum nehm kpe jo tab nne nkpa.</para>
  <para style="q2" vid="ECC 12:5">Owo ane kpo tahm asongo go ekehnge ebo ji li njinanjini,</para>
  <para style="q3" vid="ECC 12:5">abanoongo elkv fere jo jen yannge go afakabang.<verse eid="ECC 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 12:6" />Buumu nl'limi ewa, nlehke asilva kehm kimi</para>
  <para style="q2" vid="ECC 12:6">fvfo ekpingi agul kehm gboko wa;</para>
  <para style="q3" vid="ECC 12:6">etulahb kehm gboko wa go ebgba,</para>
  <para style="q4" vid="ECC 12:6">fvfo egare kehm kimi go elbing elahb,<verse eid="ECC 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 12:7" />fvfo ebtohko kehm feere go ndi nyi lohng no,</para>
  <para style="q2" vid="ECC 12:7">etohko feere goji Esowo bi kaa no.<verse eid="ECC 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 12:8" />&lt;&lt;Ejumjum lohngem! ejumjum lohngem!&gt;&gt; nt'tibi wo bungu.</para>
  <para style="q2" vid="ECC 12:8">&lt;&lt;Jol ejumjum ajehng ajehng! Ejumjum lohngem ejumjum.&gt;&gt;<verse eid="ECC 12:8" /></para>
  <para style="s">Es'kohro elbungu</para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 12:9" />Nt'tibi jolem na jol nnea ngbere, wo á tob tibi ane elkahne. Á jo tiri bade agaane, jo feede, fere toobo. agaane gbalee bum go ntooranti.<verse eid="ECC 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 12:10" />Nt'tibi kpo feede eji á l'seb kahn ellum ni fuumu no, fvfo jore ji á nyono no, li songo songo a etingitingi.<verse eid="ECC 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 12:11" />Alum nya nnea ngbere li ana ebti mbaabebul, alum ebo li ana aba nya bo ma sahb k'kum kak ejum, mbaabebul awohng wo bungu alum nya.<verse eid="ECC 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 12:12" />Mmon ewame, nong me n rehk-a, re wo k'yehke ntir enya kak go alum anyehng anyehng sehnge nyaa.</para>
  <para style="q2" vid="ECC 12:12">Ane nehm ma tiki nyon awer mal, fvfo nne l'ga kpili sehng, á bahke lahnge na.<verse eid="ECC 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 12:13" />Anv wobwuk nsol kpee;</para>
  <para style="q2" vid="ECC 12:13">a wo li es'kohro elbungu nia, nyi li re:</para>
  <para style="q3" vid="ECC 12:13">Jo fahl Esowo wo jo bum nkahn enye,</para>
  <para style="q4" vid="ECC 12:13">tibre a wo li eltum ni ane kpee.<verse eid="ECC 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 12:14" />Tibre Esowo bahke lame nne bade ejum ajehng ajehng ji á limi no,</para>
  <para style="q2" vid="ECC 12:14">a ejum mbehr mbehr ajehng ajehng,</para>
  <para style="q3" vid="ECC 12:14">jol afii nobo na afii sabe na.<verse eid="ECC 12:14" /></para>
  <chapter eid="ECC 12" />
</usx>