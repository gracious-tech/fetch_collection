<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Ekajuk New Testament</book>
  <para style="h">Failimon</para>
  <para style="toc1">Failimon</para>
  <para style="toc2">Fai</para>
  <para style="mt2">NWER NYI POL NYONO TV</para>
  <para style="mt1">FAILIMON</para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="nb">
    <verse number="1" style="v" sid="PHM 1:1" />Me Pol ji li nne a ngbekobo tib go esi ji Kraist Jisos, a Timoti mmonanne ejahre, e kpꞌnyono nwer nyia tv Failimon ji kpo kor-r sꞌsehng, ye ji e kpꞌlimi eltum ano a ne. <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />Nwer nyia tob li ka Apia ji li mmonanne ejahre no nkal, a Arkipus ji tob li nne a nsoja ana wahr, a aneb ero ba kpo kono asi go ega etahk.<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">Kol 4:17</char></note><verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />Nong, nnoobo jol a nahne, a elkoono ni lohng goji Esowo Nso ejahre, a Ntul a Jisos Kraist.<verse eid="PHM 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />N kpo kak Esowo saam ngare anyehng anyehng nyi n lꞌbuum-a go egame ero bi n kpo kak, <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />tib eji n kpꞌwuku ana aneb Esowo kpee kpo kor-a,<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">1 Jon 4:20-21</char></note> fere wuk bade eltaame ni a kpꞌtaame tv Ntul a Jisos. <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />N kpo kak ero re, elkono ni ń kpo kono asi go eltaame ana ni a kpi no lub lim, wahn kahn elfuulu anehng anehng ni e kpi go ejang bi Kraist.<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">Mak 11:24</char></note> <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />Mmonannee, wahr ebbel egburu eyebatahng, fere bel ekakeltim tib go ega elkoro. Tibre wo wo ma lim re eltim yebe abon Esowo.<verse eid="PHM 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />Jol eji n kpi kpi esahb go ejang bi Kraist ji m bahk-a ma tong ji fuumu re wo lim, <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />n kp-a lub gboongo na tib esi ji elkoro,<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">1 Kor 9:12,15</char></note> me Pol ji li nnenkul, anv, m ma fere jol nne a ngbekobo tib go esi ji Kraist Jisos. <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />N kp-a gboongo ka Onesimus,<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">Kol 4:9</char></note> mmon ewame, no me m ma jol nde<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">1 Kor 4:15</char></note>, eji n wob ngbekobo nyia. <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />Wuku wuku á jolo edemme nne ji a ki-e li nsehng anyehng anyehng, wo anv, yeblohko jol nne no bahk-a ma jo loko, fere tob jo lok-m.<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />Eji n kp-e tumu, á feere ba go ega, li ana n kpꞌtumu eltim ename tv-a. <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />Kor-m re á sa a name, eji á lꞌko nji nyi a jol-m loko ngare nyi n wob go ngbekobo tib go esi nnoobo etib.<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">Fil 2:30</char></note> <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />N sebem re me n lim ejum ajehng ajehng njahm njahm, ki-a tohko lim, a kahn, eji a lꞌkꞌlim nnoobo enya ana bo bob-a na, a lꞌlim ana kor-a no go ega eltim.<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">2 Kor 9:7</char></note><verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />Fundiki ebfere jol re, Onesimus tahm-a sa mmongare ntiil, eji a lꞌfere bel-e go njinanjini. <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />Tibre anv, á kpeem li nju nyi nyi, yebfere jol nne no gbale sehnge nju. Yebjol akor-m mmonannee go ejang bi Kraist, no kpo sahb kor-m kor. Anv, á bahk-a koro elkohn ani, ye ji li nju enya, a mmonanne go ejang bi Ntul a Jisos?<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">1 Tim 6:2</char></note><verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />A lꞌbum-m ana nte ewa, lub ko Onesimus jang jang ana a jol-m koko. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />Lꞌjol nyi á sood-a no, afi á fere bel-a mbong, nong, fere jol ana me n kpi-a mbong. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />Me Pol, me wo kpꞌnyono ana go egame ebo re, Me wo bahke gale. Me m bum re, a kpꞌkahne re, a kpi-m mbong nyi elkpin ena ni wofono antahng.<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">1 Kor 4:15</char></note><verse eid="PHM 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PHM 1:20" />Mmonannee, n kpꞌsebe re me n li-a nsehng go ejang bi Jehova.<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">1 Tes 2:19</char></note> Lim, eji eltim ename lꞌjol yebe yebe go ejang bi Kraist. <verse eid="PHM 1:20" /><verse number="21" style="v" sid="PHM 1:21" />N kpꞌnyono tv-a, tibre n kpꞌsahb kꞌkahn re, a bahke limi ana n tong-a no, jol sꞌsehnge na.<verse eid="PHM 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22" />Fvfo, toobo ekpꞌkpa bum-m, tibre n kpꞌbumu re, Esowo bahke faange aro enyahne nya ń kpꞌkake, fere yak-m ka-n.<verse eid="PHM 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />Epafras ji tob wob ngbekobo ana me tib go esi ji Kraist Jisos kp-a kake nnyo.<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false">Kol 1:7; 4:12</char></note> <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />Mak, Aristarkus, Demas, a Luk, bo ji e kpo lim eltum ano, bo kp-a tob kak nnyo.<note caller="+" style="f"><char style="fr" closed="false">1:24 </char><char style="ft" closed="false">Kol 4:10,14</char></note><verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />Nong, nnoobo nyi Ntul a Jisos Kraist jol a nahne go egahne atohko.<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>