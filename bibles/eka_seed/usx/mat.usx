<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Ekajuk New Testament Nigeria</book>
  <para style="h">Matiu</para>
  <para style="toc1">Matiu</para>
  <para style="toc2">Mat</para>
  <para style="mt2">NWER NYI</para>
  <para style="mt1">MATIU</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Nwer nyi etꞌtohngo ji Jisos lohng no</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luk 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />A wo li nwer nyi etꞌtohngo ji Jisos Kraist lohng no, ji jolo mmon a Devid,<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Mak 12:25-37</char></note> Devid ji jolo mmon no Ebraham.<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Jon 8:58</char></note> <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />Ebraham jele Aisik. Aisik jel Jekob. Jekob jel Juda, a abon bako. <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Juda jele Peres, go Sera. Nnyehn ebo, bo jo lung-e re Tamar. Peres jel Hesron. Hesron jel Ram. <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />Ram jel Aminadab, Aminadab jel Nason. Nason jel Salmon. <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Salmon jel Boas. Nnyehn Boas, bo jo lung-e re Rehab. Boas jel Obed. Nnyehn Obed, bo jo lung-e re Rut. Obed jel Jesi. <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Jesi jel Devid ji jolo ntul. Devid ji jolo ntul jel Solomon. Nnyehn Solomon tohko jol nkal Uraya. <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />Solomon jel Rehoboam. Rehoboam jel Abija. Abija jel Asa. <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />Asa jel Jehosafat. Jehosafat jel Joram. Joram jel Usia. <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Usia jel Jotam. Jotam jel Ehas. Ehas jel Hesekaya. <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Hesekaya jel Manase. Manase jel Amon. Amon jel Josia. <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Josia jel Jekonia, a abon bako, ngare nyi anebe Bebilon ba bob abone Israel, tahm a bo go Bebilon.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Ngare nyi bo ma bob abone Israel, tahm a bo go Bebilon, owo Jekonia kehm jele Sealtiel. Sealtiel jel Serubabel. <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Serubabel jel Abiud. Abiud jel Eliakim. Eliakim jel Asor. <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />Asor jel Sadohk. Sadohk jel Akim. Akim jel Eliud. <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Eliud jel Eleasar. Eleasar jel Matan. Matan jel Jekob.<verse eid="MAT 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 1:16" />Jekob jel Josef ji jolo nlum a Meri. Meri ji jolo nnyehn Jisos, Jisos ji bo kpo lung-e re Kraist. <verse eid="MAT 1:16" /><verse number="17" style="v" sid="MAT 1:17" />Bomo goji Ebraham, nde nne lꞌjel mmon, mmon tahm jel ntem mmon ano ano tete ba rehng go ngare nyi Devid, babnde nne jolo ewubu ane ani. Bomo goji Devid, nde nne lꞌjel mmon, mmon tahm jel ntem mmon ano ano tete ba rehng ngare nyi bo bobo abone Israel, tahm a bo go Bebilon, babnde nne jolo ewubu ane ani. Bomo ngare nyi bo bobo abone Israel, tahm abo go Bebilon, nde nne lꞌjel mmon, mmon tahm jel ntem mmon ano ano tete ba rehng ngare nyi Kraist, babnde nne jolo ewubu ane ani.<verse eid="MAT 1:17" /></para>
  <para style="s">Ana bo jele Jisos</para>
  <para style="r">(<ref loc="LUK 2:1-7">Luk 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Ana wo bo jele Jisos Kraist. Nnyehn Jisos, bo jo lung-e re Meri. Ngare nyi bo ma lam elbal abola Josef, Josef tikem noongo a Meri, Meri sa ela go nsahm Etingi Etohko.<note caller="+" style="f"><char style="fr" closed="false">1:18 </char><char style="ft" closed="false">Luk 1:35</char></note> <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Josef nlum ewe jolo nnobeljina nne. Á sebem re á sono Meri. Á sebe mbang ana nyi á bahk-e tene, ane kꞌwuk.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Eji Josef jo tir nsol nyio kpee, enjel nyi Esowo kehm bake, ba kpir-e go nlem, kehm-e tongo re, “Josef ji mmon no Devid, ka kpe fahl elkoko Meri go elbal! Tibre ela bi á ma sa o, á sa go nsahm Etingi Etohko. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Á bahke jele mmon, no a bahk-e gungu mbing re Jisos (ji lohngo re ntꞌtahre). Tibre á bahke tahre ane ebe yehke go ebo abiafem.”<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">Luk 1:77; Elt 4:12</char></note><verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Nsol nyia kpee limi, eji alum nya Jehova bungu sehng goji nnyehnamahr lꞌlohko jol go etingitingi, nya á bungu re, <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“Mmongungu a nnenkal, (Ngbahme nyi bo kala nꞌnoongo a ne) bahke sake ela, jel mmon no nlum, no bo bahke jo lung-e re Emanuel.” (Ji lohngo re, “Esowo li a nahre”).<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Josef nyahme kan go ellu, á kehm limi ana enjel nyi Jehova tong-e no, á feere song ko Meri go elbal. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Á tikem noongo a ne tete á jel ngbokambang a mmon ewe no nlum. Josef kehm-e gungu mbing re Jisos.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Ana akahnkahn ane lohngo go ero nfam ba</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Jisos, bo jel-e go Betlehem ji Judea ngare nyi Herod jolo ntul. Owo akahnkahn ane kehm lohngo go ero nfam ba go Jeusalem, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />ba kehme elbahbe re, “Mmon no na, no bo m-e jel, no li ntul no Jus? Tibre wahr ebnyehn elonlo eje go ero nfam. Owo wahnge e ba no re wahr ba kak-e.”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Eji ntul a Herod wuku ano, eltim kehm-e jokko, a aneb Jeusalem kpee. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Owo á kehm lungu atubesi abalimajom, a atꞌtibi ba atahm, bo ba kono edi ajehng. Á kehm bahbe bo re, “Kraist jio, bo bahk-e jele gan?”<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />Bo kehm-e faange re, “Go Betlehem ji Judea.<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">Jon 7:42</char></note> Tibre ana wo nnyehnamahr Esowo nyono no re,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />“ ‘Wahn Betlehem ji Juda,</para>
  <para style="q1" vid="MAT 2:6">wahn erennge ejahbe sang go mbang anyehng anyehng</para>
  <para style="q1" vid="MAT 2:6">go ellong atubesi ajahbe nya li go Juda.</para>
  <para style="q1" vid="MAT 2:6">Tibre go egahne ellong wo,</para>
  <para style="q1" vid="MAT 2:6">ntubesi bahke lohngo,</para>
  <para style="q1" vid="MAT 2:6">no bahke ba fili Israel, ane ebame.’ ”<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Herod kehm lungu akahnkahn ane bao, tahm a bo go nkpohko, song bahb bo ekahmekahme ngare nyi elonlo jio lohngo no. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Owo á kehm tumu bo tv go Betlehem, a elle ni á tubu bo re, “Songen, wahn song seb mmon noo nob nob! Ń lꞌsong seb-e nyehn, lim-m wahn, me n kahn, eji me n lꞌtob je song kak-e fvfo.”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Eji bo ma wuk ana ntul bungu no, bo kehm tahme. Elonlo ji bo jo nyehn go ero nfam kehm gboko bo mbang tete song yiimi edi ji mmon noo jolo no. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Eji bo kpe nyehn elonlo jio yim no, bo bele eyebatahng sehng, fere jo gꞌgeere. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Bo kehm yele ekpꞌkpa, song nyehn mmon, a Meri nnyehn, gbo jamme alahng, kak mmon. Bo kehm soro lennge abam ebo, yehke agul, frankinsens, a mmir, yare mmon.<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />Esowo kehm rehke bo go nlem re, bo kꞌkpe feere goji Herod. Owo bo kehm sehnge mbang nyindiki kehnge.<verse eid="MAT 2:12" /></para>
  <para style="s">Ana Josef abola Meri, be no, tahm go Ijib</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Ngare nyi akahnkahn ane bao ma tahm fi, owo enjel nyi Esowo kehm ba kpiri Josef go nlem, kehm-e tongo re, “Tahm, wo rod mmon, a nnyehn, be, song go Ijib, kang ona tete me n kpe ba tong-a. Tibre Herod yahke ba mmon noa seb re á wul.”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Josef kehm tahme, rod mmon, a nnyehn, bo tahm atv atv song rehng go Ijib. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Owo á jolo no tete Herod kpo, eji lꞌlohko jol ana Jehova bungu sehng goji nnyehnamahr re, “N lungu mmon ewame go Ijib, á lohng ba.”<verse eid="MAT 2:15" /></para>
  <para style="s">Ana Herod wulu abonse ba nse a nse</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Herod sebe kan kahn re, akahnkahn ane m-e nehm, atahng kehm-e rake tete. Á kehm tumu ane, bo song wul abon ba nlum kpee go Betlehem, a abon ajahbe ba li sennge o kak, ba ma kang bomo nnya ebal feere ndi, tib ana á wuku goji akahnkahn ane bao bada ngare nyi elonlo lohngo no.<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />Ngare nyio nyi lohko lim ana nnyehnamahr Jeremaya bungu no re,<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“Bobwuk ewahl ane go Rama,</para>
  <para style="q1" vid="MAT 2:18">ewahl ji ane ma biingi aling,</para>
  <para style="q1" vid="MAT 2:18">fere kpꞌlingi ndon ndon.</para>
  <para style="q1" vid="MAT 2:18">Resel kpꞌlingi abon ebe.</para>
  <para style="q1" vid="MAT 2:18">Bo kak-e eltim,</para>
  <para style="q1" vid="MAT 2:18">jol eltim we tikem naange,</para>
  <para style="q1" vid="MAT 2:18">tibre bo kpeem li elikiliki.”<verse eid="MAT 2:18" /></para>
  <para style="s">Ana Bab Josef feere kehnge go Nasaret</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Ngare nyi Herod ma kpo, owo enjel nyi Jehova kehm kpe song kpiri Josef go nlem, eji á jolo go Ijib, kehm-e tongo re, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />“Tahm, rod mmon, a nnyehn, wo feere a bo go ndi nyi Israel. Tibre ane ba jo seb re bo ba wul mmon bobkpo.”<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Josef kehm tahme, rod mmon, a nnyehn, feere a bo go ndi nyi Israel. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Eji Josef wuku re, Arkelaus ebko nji nyi nde Herod, kpꞌfili Judea, á kehm kehme elfahle eljeke o. Owo Esowo kehm-e kpe rehke go nlem, Josef kehm tahme go ejang bi Galili, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />song lene go ejahbe ji bo kpo lung re Nasaret, eji lꞌlohko jol ana abanyehnamahr Esowo bungu no re, “Bo bahke jo lung-e re nne a Nasaret.”<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">Jon 1:46; 7:41</char></note><verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Etib bi Jon ji nwohngalahb jo tiingi</para>
  <para style="r">(<ref loc="MRK 1:1-8">Mak 1:1-8</ref>; <ref loc="LUK 3:1-18">Luk 3:1-18</ref>; <ref loc="JHN 1:19-28">Jon 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Ngare nyio Jon ji nwohngalahb kehm lohngo ba, ba kehme elbungu go elka emahng nio ni Judea re, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />“Yaangen elkpin enahne, tibre etul bi Esowo ebkabbe.”<verse eid="MAT 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 3:3" />Jon wo jolo nne no nnyehnamahr Aisaya jo bung bada ne, eji á jo bung re,</para>
  <para style="q1" vid="MAT 3:3">“Nne noa,</para>
  <para style="q1" vid="MAT 3:3">kpꞌrabe go elka emahng re,</para>
  <para style="q1" vid="MAT 3:3">‘Tuungen mbang nyi Ntul bum-e.</para>
  <para style="q1" vid="MAT 3:3">Limen mbang tꞌtor,</para>
  <para style="q1" vid="MAT 3:3">nyi á bahke sehnge.’ ”<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Nsol nyi Jon jo kak, bo limi go anyar nyam nyi bo kpo lung re ekamel. Á jo gbaange egbaange ji bo limi go ngunyam. Á jo li agohrobi, fere jo yab akehng ekon. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Ane jo lohngo go Jeusalem je go ege, a ane ba jolo go Judea kpee, go ane kpee ba lene ajahbe nya jolo egbuk ebbal ebbal bi aya ma bo kpo lung re Jodan. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Bo jo fvvrv abiafem ebo, á jo wohngo bo alahb go Jodan.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Eji Jon nyehne aneb Farisi, a anebe Sadusi gbalee kpꞌbake re á wohngo bo alahb, á kehm tongo bo re, “Wahn ane ba li ana akumbad ba! Nne awo tong-n re, ḿ bahke foro go erakatahng ji Esowo ji kpꞌbake? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Limen nsol nyi bahke tibi re, wahn eblohko yaange elkpin enahne. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Kana kpe laange, fere jo bung go egahna ntim re, ‘Ebraham wo li nso ejahre.’<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">Jon 8:33-39; Rom 2:28-29; 4:12</char></note> N kp-n tongo re, Esowo bahke ma ko atal nyaa, lim abon ka Ebraham.<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">Gal 3:26-29</char></note><verse eid="MAT 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 3:10" />“Bobtoobo elfuk bum, ni bo bahke kiimi alohk nti, melle nti nyio. Eti ajehng ajehng ji tohko kab akab nya nno, bo bahke mehle tub, fere rod kak agun.<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">Luk 13:7-9</char></note><verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />“N kp-n wohngo alahb mao ma egbokondon. Nne no kpꞌbake toon-m wo ga gbal sehnge me. Jol me n fuumem re me n sol akpaketa enye. Á bahk-n wohngo alahb go Etingi Etohko, a agun.<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">Elt 1:5; 2:3</char></note> <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />A fili edꞌda go ebo, kpꞌfebe arasi enye. Á bahke kpuku arasi enye, song kak go ege ekpꞌkpa, fere jahm awal go agun nya lꞌkꞌtiki lahme elahmelahme.”<verse eid="MAT 3:12" /></para>
  <para style="s">Ana Jisos bele ewohngalahb</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mak 1:9-11</ref>; <ref loc="LUK 3:21-22">Luk 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Ngare nyio Jisos kehm tahme go Galili, song rehng go Jodan goji Jon re Jon wohng-e alahb.<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Luk 12:50; Jon 1:29-34</char></note> <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Jon jo gare re á sahd-e, kehm-e tongo re, “Kehn wo wo nobo re wo wohngo na me alahb, wo ma fere ba na ga egame.”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Owo Jisos kehm-e faange re, “Nong jol ano! Tibre fuumu re wahr lim nsol kpee nyi Esowo sebe re wahr lim.”<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">2 Kor 5:21</char></note> Jon kehm taame.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Tvtv o eji Jisos ma bel ewohngalahb, á kehm lohngo go alahb. Ngare nyio ejahbetul Esowo eblennge ka-e. Owo á kehm nyehne etohko ji Esowo go elfoongo ni ebbehl kpꞌbadde abake, kehm ba jol a ne. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Owo bo kehm wuku ellum go ejahbetul Esowo ni bungu re, “A wo li akor-m mmon ewame, no kpo kor-m sꞌsehng.”<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">Mak 9:7</char></note><verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Ana nnehm gare Jisos</para>
  <para style="r">(<ref loc="MRK 1:12-13">Mak 1:12-13</ref>; <ref loc="LUK 4:1-13">Luk 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Etingi Etohko kehm yehke Jisos, song kak go elka emahng re nnehm gar-e.<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">Jems 1:2; Hib 4:15</char></note> <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Eji Jisos ma bade elne njal nfung atahl abal, owo njal kehm-e yame. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Nnehm kehm bake, ba tong-e re, “A lꞌjol Mmon Esowo, tong atal nyaa siingi abred.”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Jisos kehm-e faange re, “Bo nyono go nwer Esowo re, ‘Abred nya nya sang wahnge nne kpo kpin, á kpo bel elkpin go ellum anehng anehng ni lohng go nnyo mi Esowo.’ ”<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">Jon 4:34; 6:27</char></note><verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Nnehm kehm rodo Jisos, tahm a ne go mbarebare ejahbe, song kun-e go elkong etahk Esowo, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />kehm-e tongo re, “A lꞌjol Mmon Esowo, yehb, wo ba gbo go ndi! Tibre bo nyono go nwer Esowo re,</para>
  <para style="q1" vid="MAT 4:6">“ ‘Esowo bahke tongo enjel enye bada na.</para>
  <para style="q1" vid="MAT 4:6">Bo bahk-a gbiiri go bo abo,</para>
  <para style="q1" vid="MAT 4:6">eji a lꞌkꞌba jahre akpade enya go eltal.’ ”<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Jisos kehm faange re, “Bo tꞌtob nyon go nwer Esowo re, ‘Ka gare Esowo, Ntul ewa!’ ”<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">Mat 27:42</char></note><verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Nnehm kehm kpe rod Jisos, tahm a ne go ewong ji sahb wꞌwahre, fere tib-e ajahbe kpee nya li go njini, a ellub ni bo kpi no, <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />kehm-e tongo re, “M bahk-a kake nyaa kpee, a lꞌjamme alahng kak-m.”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Owo Jisos kehm-e tongo re, “Nnehm, tahm-m go esamahr! Tibre bo nyono go nwer Esowo re, ‘Esowo, Ntul ewa wo wo, a bahk-e jo kak. Ye ntahngtahng wo, a bahke fere jo lok-e.’ ”<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">Jems 4:7-8</char></note><verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Nnehm kehm-e soro yake. Babenjel soro ba kak-e ebo.<verse eid="MAT 4:11" /></para>
  <para style="s">Ana Jisos bomo alum Esowo abungu go Galili</para>
  <para style="r">(<ref loc="MRK 1:14-15">Mak 1:14-15</ref>; <ref loc="LUK 4:14-15">Luk 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Eji Jisos wuku re, Jon, bo m-e kak ngbekobo, á kehm tahme eje, song rehng go Galili.<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">Mat 14:3</char></note> <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />A kehm tahme go Nasaret, fere song lene go Kapenium ji jolo kohlo eto ji Galili, go ndi nyi abone Sebulon, a ba Naftali, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />eji lꞌlohko jol jang jang ana nnyehnamahr Aisaya bungu no re,<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Ndi nyi abon Sebulon,</para>
  <para style="q1" vid="MAT 4:15">a ba Naftali,</para>
  <para style="q1" vid="MAT 4:15">ba lene ejang bio bi eto ji Galili li no,</para>
  <para style="q1" vid="MAT 4:15">egbuk Jodan</para>
  <para style="q1" vid="MAT 4:15">jehko go Galili jio ji ane ba ki nyi Esowo,<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />ane bao ba jehk go ejannge</para>
  <para style="q1" vid="MAT 4:16">ebnyehn egburu ellennge.</para>
  <para style="q1" vid="MAT 4:16">Ane bao ba nong go emel elkv,<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="ft" closed="false">Elt 26:18</char></note></para>
  <para style="q1" vid="MAT 4:16">edi ebkehme bo lennge.”<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Bomo ngare nyio asongo Jisos kehm kehme etib ebe tiingi re, “Senngen njahm go egahne abiafem! Tibre etul bi Esowo ebkabbe.”<verse eid="MAT 4:17" /></para>
  <para style="s">Ana Jisos lungu abasahre nsahre, ane na ani</para>
  <para style="r">(<ref loc="MRK 1:16-20">Mak 1:16-20</ref>; <ref loc="LUK 5:1-11">Luk 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Eji Jisos jo jen go nkpe eto nyi Galili, á kehm nyehne abasahre nsahre, ane na abal, noko jolo Saimon ji bo jo lung-e re Pita, noko, bo jo lung-e re Andru ji mmonannyehn Pita.<note caller="+" style="f"><char style="fr" closed="false">4:18 </char><char style="ft" closed="false">Jon 1:35-42</char></note> Bo kake erim alahb. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Owo Jisos kehm tongo bo re, “Tahmen toon-m, m bahk-n limi ń fere jo bim ane.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Bo kehm soro tahm arim ebo sa, tahm toon-e.<note caller="+" style="f"><char style="fr" closed="false">4:20 </char><char style="ft" closed="false">Mat 19:27</char></note><verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Jisos kehm kpe sehng asongo, kpe song nyehn ane abal bako. Noko, bo jo lung-e re Jems. Noko, bo jo lung-e re Jon, mmonannyehn Jems. Bo jolo abon Sibidi. Bo woomo go egbang, jo baade arim ebo, a Sibidi nde ebo. Owo Jisos kehm lungu bo. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Bo kehm soro tahm egbang sa, tahm nde ebo sa, tahm toono Jisos.<verse eid="MAT 4:22" /></para>
  <para style="s">Ana Jisos jo tib, fere jo lim aneb ayam, bo nob</para>
  <para style="r">(<ref loc="LUK 6:17-19">Luk 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Jisos kehm tahme, jo yannge go Galili kpee, jo tib ane go bo ntahk ero, fere jo tiingi nnoobo etib bio bi etul bi Esowo, fere jo lim ane, bo nob elkohn eyam abehng abehng.<note caller="+" style="f"><char style="fr" closed="false">4:23 </char><char style="ft" closed="false">Elt 10:38</char></note> <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Ane kpee ba jolo go Siria wuku kan elgahm ene, owo bo kehm koko aneb ayam kpee ba go ege, ba jo yam ajoobo ayam tvv, fere jo nyehn ajoobo arem, a ane ba bele abi atohko go bo a ntim, a aneb eyam atatehk, a ane ba ma banne. Jisos limi bo kpee, bo nob. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Ellong ane gbalee ba jo toon-e, egom jindiki lohng go Galili, egom jindiki lohng go Dekapolis, egom jindiki lohng go Jeusalem, egom jindiki lohng go Judea, egom jindiki lohng go egbuk Jodan jehko.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Alum nya Jisos bungu go ero ewong</para>
  <para style="r">(<ref loc="LUK 6:20-23">Luk 6:20-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Eji Jisos nyehne ellong ane bao, á kehm tahme go ewong. Á ji kan a me, abatꞌtoono ebe kehm bake go ege. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Á kehm kehme bo tib re,<verse eid="MAT 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 5:3" />“Elfuulu li ka ane ba ma gbo ekpak bio bi etohko. Tibre etul bi Esowo li ka bo.<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">Luk 18:13-14</char></note><verse eid="MAT 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 5:4" />“Elfuulu li ka ane ba jehk ndon ndon. Tibre bo bahke kake bo eltim.<note caller="+" style="f"><char style="fr" closed="false">5:4 </char><char style="ft" closed="false">Ell 7:14-17</char></note><verse eid="MAT 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 5:5" />“Elfuulu li ka ane ba kpi nnaange eljini. Tibre bo bahke bele njini ana ejum elehke elkv ebo.<verse eid="MAT 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 5:6" />“Elfuulu li ka ane ba kpꞌsahb sꞌseb re bo li eno go esamahr bi Esowo. Tibre bo bahke lehke eno.<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">Elt 16:30</char></note><verse eid="MAT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 5:7" />“Elfuulu li ka ane ba, ane kpo fili bo ndon. Tibre bo bahke tob fili Esowo ndon.<note caller="+" style="f"><char style="fr" closed="false">5:7 </char><char style="ft" closed="false">Jems 2:13</char></note><verse eid="MAT 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 5:8" />“Elfuulu li ka ane ba ntim ebo li saang. Tibre bo bahke nyehne Esowo.<note caller="+" style="f"><char style="fr" closed="false">5:8 </char><char style="ft" closed="false">1 Jon 3:2-3</char></note><verse eid="MAT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 5:9" />“Elfuulu li ka ane ba kpo seb elkoono.<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">Rom 12:18</char></note> Tibre bo bahke jo lung bo re abon ba Esowo.<verse eid="MAT 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 5:10" />“Elfuulu li ka ane ba, bo kpꞌnohko bo tib eji bo kpꞌlimi nsol nyi li go etingitingi. Tibre etul bi Esowo li ka bo.<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">1 Pit 3:14</char></note><verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />“Elfuulu li ka-n, ane lꞌjo su-n, fere jo nohk-n, fere jo kiimi elkohn efahnge anehng anehng lak-n tib go egame esi.<verse eid="MAT 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 5:12" />“Belen eyebatahng, wahn jo geere. Tibre eltuuru enahne ni li go ejahbetul Esowo kpꞌgbale. Ano wo bo jo tob nohk abanyehnamahr Esowo ba tohko jol, wahn kehm jini.<verse eid="MAT 5:12" /></para>
  <para style="s">Akang abola ellennge</para>
  <para style="r">(<ref loc="MRK 9:50">Mak 9:50</ref>; <ref loc="LUK 14:34-35">Luk 14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />“Wahn ba li akang ma njini.<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false">Kol 4:6</char></note> Elyebe akang lꞌlohng go akang, bahke limi renan, kehm kpe yebe? Nehm kpe nob ellahbe. Bo bahke sale na wohng go, ane jo kadde sehng.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />“Wahn ba li ellennge ni njini.<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">Fil 2:15</char></note> Ejahbe ji bo si kunu go ewong nehm kpe ma biiri. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Nnene limm, no kpo nyaale etꞌrekahng, rod ejeere konngo. Á bahke rodo na kunu go ejum ji bo kpo kunu atꞌrekahng. Owo bahke yake ka ane kpee ba wob ekpꞌkpa jio. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Nong, ellennge enahne ni ń kpi no jo ya go esamahr ane, eji bo lꞌnyehn nnoobo enyahne nyi ń kpo lim, fere jo tehk nso ejahne no li go ejahbetul.<note caller="+" style="f"><char style="fr" closed="false">5:16 </char><char style="ft" closed="false">Ef 5:8-9</char></note><verse eid="MAT 5:16" /></para>
  <para style="s">Alum nya Jisos bungu bade atahm nya Moses</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />“Kana tir re m ba re me m ba range atahm nya Moses, a eltibi ni abanyehnamahr tibi no.<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="ft" closed="false">Rom 3:31</char></note> M baam re me m ba range, m ba re me n gohro ba lim, biingi go nseenge.<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="ft" closed="false">Rom 8:3-4; 10:4</char></note> <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Etingitingi, n kp-n tongo re, Eji elbung abola ndi kpeke li, mmonrꞌrohka mmojum awohng awohng no atahm nehm range tete rehng esꞌkohro ji nsol kpee bahke male.<note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false">Luk 16:17</char></note><verse eid="MAT 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 5:19" />“Owo fvfo, nne awohng awohng no lꞌyuudu nrꞌrohka mmontahm awohng awohng,<note caller="+" style="f"><char style="fr" closed="false">5:19 </char><char style="ft" closed="false">Jems 2:10</char></note> afi á tibi ane ano, ye wo bahke ga jol nkpak go ejahbetul Esowo sehnge ane kpee. Nne awohng awohng no lꞌbum atahm, fere jo tꞌtib, ye wo bahke jolo njꞌjoka nne go ejahbetul Esowo.<verse eid="MAT 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 5:20" />“N kp-n tongo re, ń nehm ma yel go ejahbetul Esowo, sehngem re, eno ejahne ji ḿ bahke lehke go esamahr Esowo sehnge ji atꞌtibi ba atahm, a Bab Farisi.<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">Rom 9:31-33</char></note><verse eid="MAT 5:20" /></para>
  <para style="s">Eltibi ni li bade elkoono</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />“Wahn ebwuk ana bo tongo ane ba jolo mahne mahne re, ‘Kana jo wul nne! Nne awohng awohng no lꞌwul nne, bo bahk-e koko, tahm ane go elam.’ <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Wo, me n kp-n tongo re, Nne awohng awohng no eltim lꞌrak-e tob mmonannyehn, bo bahk-e koko, tahm a ne go elam. Nne awohng awohng no lꞌsu mmonannyehn, bo bahk-e koko, tahm a ne go esub. Nne awohng awohng no lꞌtong mmonannyehn re, ‘Egboolo ji!’ yeblim ebi ji bo bahk-e koko, song kak go ellulagun.<note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">1 Jon 3:15</char></note><verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />“A lꞌko ayare ba a nya go edi njom alimi, a lꞌfere buumu ona re, ń li go ntong awahn a mmonanne, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />yake ayare enya bum kohlo edi njom alimi jio, wo feere, tohko song bung ntong nyio mal, fere koono a mmonanne, wo kehm feere ba ka ayare enya.<note caller="+" style="f"><char style="fr" closed="false">5:24 </char><char style="ft" closed="false">Mak 11:25</char></note> <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />Jo koono a nnekv ewa elwaare, eji ngare kpeke li,<note caller="+" style="f"><char style="fr" closed="false">5:25 </char><char style="ft" closed="false">Hib 3:13,15; 9:27</char></note> eji nnekv ewa lꞌki-a song kak esub, nlamalam rod-a kak mbehresi go ebo, á rod-a song kak ngbekobo. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Etingitingi, n kp-a tongo re, Owo a bahke woomo tete a gohro gal mbong nyi a bele no, jol ederi ajehng ajehng nehm sa.<note caller="+" style="f"><char style="fr" closed="false">5:26 </char><char style="ft" closed="false">Mat 18:34</char></note><verse eid="MAT 5:26" /></para>
  <para style="s">Eltibi ni li bade erehbe</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />“Wahn ebwuk ana bo bungu re, ‘Ka jo lim erehbe!’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Wo, me n kp-n tongo re, Nne awohng awohng no lꞌyehke amahr enye kunu nnenkal re á noongo a ne, yeblim abiafem nya erehbe go ege eltim.<note caller="+" style="f"><char style="fr" closed="false">5:28 </char><char style="ft" closed="false">2 Pit 2:14</char></note> <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Elmahr eboblum ena lꞌwahng re wo lim abiafem, luudu ro go! Ga nob re ejum ngubjing enya demme, sehnge re bo rod ngubjing enya kpee, song kak go ellulagun. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Eboblum eba lꞌwahng re wo lim abiafem, kim tub go!<note caller="+" style="f"><char style="fr" closed="false">5:30 </char><char style="ft" closed="false">Kol 3:5</char></note> Ga nob re ejum ngubjing enya tan, sehnge re bo rod ngubjing enya kpee, song kak go ellulagun.<verse eid="MAT 5:30" /></para>
  <para style="s">Eltibi ni li bade elbal amale</para>
  <para style="r">(<ref loc="MAT 19:9">Mat 19:9</ref>; <ref loc="MRK 10:11-12">Mak 10:11-12</ref>; <ref loc="LUK 16:18">Luk 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />“Bo kpe bung re, ‘Nne awohng awohng no lꞌyehke nkal ewe elbal, nong á nyon nwer ka-e, nyi á m-e yehke elbal.’ <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Wo, me n kp-n tongo re, Nne awohng awohng no lꞌyehke nkal ewe elbal, eji nnenlum nondiki ki noongo a ne, á kp-e limi re á lim erehbe. Nne awohng awohng no lꞌko nnenkal no bo m-e yehke elbal, á kpꞌlimi erehbe.<note caller="+" style="f"><char style="fr" closed="false">5:32 </char><char style="ft" closed="false">1 Kor 7:10-11</char></note><verse eid="MAT 5:32" /></para>
  <para style="s">Eltibi ni li bade enyam anyame</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“Wahn ebtob wuk ana bo tongo ane ba jolo mahne mahne re, ‘Ka jo tir go edaange! Ka kane enyam bi a nyame no go esamahr bi Jehova!’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Wo, me n kp-n tongo re, wahn kꞌjo tir nkpel anyehng anyehng. Kana jo tir elbung! Tibre elbung, eti etul ji Esowo ji. <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />Kana jo tir ndi! Tibre ndi, etikunakpade eje ji. Kana jo tir Jeusalem! Tibre Jeusalem, ejahbe ji egburu ntul ji. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Ka jo tir esi eja! Tibre a nehm ma lim ellv esi anehng re, jol mbarebare, jol a nehm ma lim re, jol nnyakenyake.<verse eid="MAT 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 5:37" />“Nong, wahn jo faange re, ‘Ee,’ tohko jol ano, ‘Eꞌee.’ Ellum anehng anehng ni lꞌjol sehnge ano, lohng goji Ebinne jio.<note caller="+" style="f"><char style="fr" closed="false">5:37 </char><char style="ft" closed="false">2 Kor 1:17; Jems 5:12</char></note><verse eid="MAT 5:37" /></para>
  <para style="s">Eltibi ni li bada nfem abongo</para>
  <para style="r">(<ref loc="LUK 6:29-30">Luk 6:29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“Wahn ebwuk ana bo bungu re, ‘Nne no lꞌwa ntem elmahr, bo tob wa-e elmahr. Nne no lꞌbahk ntem elmahn, bo tob bahk-e elmahn.’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Wo, me n kp-n tongo re, Kana jo sahde ebi nne go eko!<note caller="+" style="f"><char style="fr" closed="false">5:39 </char><char style="ft" closed="false">Mat 26:52-53</char></note> Nne lꞌrum-a elkpal go ekpoko eboblum, sennge ekpoko ebobkal ka-e, á kpe-a rum. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Nne no lꞌgbaame ewobo eja re á kpꞌkoko, kpe yake nkud enya ka-e.<note caller="+" style="f"><char style="fr" closed="false">5:40 </char><char style="ft" closed="false">1 Kor 6:7</char></note> <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Nne no lꞌbob-a re, wo jen mmal anyehng a ne, jen mmal ebal a ne. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Nne no lꞌlem-a ejum, ka-e! Nne no lꞌba re á ba yaame ejum go ega, ka-e!<verse eid="MAT 5:42" /></para>
  <para style="s">Ana nne, anebekv ebe bahke jo kor-e</para>
  <para style="r">(<ref loc="LUK 6:27-28">Luk 6:27-28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“Wahn ebwuk ana bo tongo re, ‘Nne ebjing ewa bahke jo kor-a, nnekv ewa jo sab-a.’ <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Wo, me n kp-n tongo re, Nong, anebekv ebahne jo kor-n. Jo biren nnoobo tv ane ba kp-n suku! Jo limen nnoobo ka ane ba kpo ko-n ekv!<note caller="+" style="f"><char style="fr" closed="false">5:44 </char><char style="ft" closed="false">Rom 12:20-21</char></note> Jo kaken ero ka ane ba kpo ka-n ebi mbol mbol, a ane ba kpo nohk-n,<note caller="+" style="f"><char style="fr" closed="false">5:44 </char><char style="ft" closed="false">Elt 7:60</char></note> <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />eji ń lꞌjol abon ba Nso ejahne no li go ejahbetul.<note caller="+" style="f"><char style="fr" closed="false">5:45 </char><char style="ft" closed="false">Ef 5:1</char></note> Tibre á kpo lim njul enye jo ya tub abi ane, a anoobo ane. Á kpo na elahb ka ane ba ma li eno, a ane ba ma li ebi.<verse eid="MAT 5:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 5:46" />“Anv, ane ba ń kpo kor bo, bo l'tob jo kor-n, eltuuru anii Esowo bahk-n tuuru? Anv, abakokatak kpehme lim anoa? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Ń lꞌjo kak abonane ejahne nnyo ba ba, anv, nkpokosi ejum anyi nyi ḿ ma lim? Anv, ane ba ki nyi Esowo kpehme lim anoa? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Jolen saang, wahn kꞌbel elem ajehng ajehng, ana Nso ejahne no li go ero li saang.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Eltibi ni li bada nnoobo alimi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />“Kunen ekpu, eji ń lꞌkꞌjo lim nnoobo enyahne go esamahr ane, tohko jol ano, Nso ejahne no li go ero wahn nehm tuuru. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />Ngare anyehng anyehng nyi a lꞌlim nnoobo, ka jo tooro yannge, ana ane ba kpo tib elbo go ekpꞌkpa ero, fere jo jen alab nfam, eji ane lꞌjo tehk bo. N kp-n tongo re, Eltuuru ebo ebsehng mbang. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />A lꞌlim nnoobo, nong, ebobkal eba kꞌkahn ji eboblum eba kpꞌlimi, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />eji nnoobo enya nyi a kpꞌlimi lꞌkꞌjo jol gbul gbul gbuul. Nso no kpo nyehn nsol nyi ki li gbul gbul gbuul bahk-a tuuru.<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">Mak 4:22; Luk 8:17</char></note><verse eid="MAT 6:4" /></para>
  <para style="s">Eltibi ni li bade ero akake</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luk 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />“A lꞌkehme ero kak, ka jo lim ana ane ba kpo tib elfuumu elfuumu. Kpo kor bo re bo jo mehl yiimi go ekpꞌkpa ero, fere yiimi elatahkgur, jo kak ero, eji ane lꞌnyehn bo. Etingitingi, n kp-n tongo re, Eltuuru ebo ebsehng mbang. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />A lꞌkehm kake ero, yel go ega nkimi. Eji a ma bam mbu tv elna, wo kehm kake ero ka Nso no ane lꞌki-e ma nyehn. Nsoo no kpo nyehn nsol nyi ki li gbul gbul gbuul bahk-a tuuru.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />“A lꞌkehm kake ero, ka jo lim ewok mbol mbol, ana ane ba ki nyi Esowo kpo lim. Ane bao ba kpo tir re, Esowo bahke wuku bo, tib eji bo kpꞌkake alaabe aro. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Kana jol ana bo! Tibre Nso ejahne kpꞌkahne nsol nyi ń kpꞌsebe, jol ń kehm-e bahbe. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Ana wo nobo re wahn jo kak ero re,</para>
  <para style="q1" vid="MAT 6:9">“Nso ejahre no li go ero, nong, mbing enya jol saang.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Yake etul eba ba.</para>
  <para style="q1" vid="MAT 6:10">Nong ntir enya,</para>
  <para style="q1" vid="MAT 6:10">afi jolo go ndi, afi jolo go ero.<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">Mat 7:21; Luk 22:42</char></note><verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Ka-r ejum alehke ji lꞌbiingi a nahre lela.<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">Fil 4:6</char></note><verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Jo tahm ka-r go egahre abiafem, ana wahr kpo tahm ka ane ba lim-r abiafem.<note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">Mat 18:21-35</char></note><verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Ka lim, e yel go elgaare.<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Jems 1:13</char></note> Jo tahr-r yehke go abiafem.<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />“Ń lꞌtahm ka ane go bo abꞌbi nya bo lim-n no, Nso ejahne no li go ero bahke tob tahm ka-n go egahne abꞌbi. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Ń tohko tahm ka ane go bo abꞌbi nya bo lim-n no, bahke limi renan, Nso ejahne kehm tob tahm ka-n?<verse eid="MAT 6:15" /></para>
  <para style="s">Eltibi ni li bada njal abade</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />“Ń lꞌkehme elnahne njal bade, kana jo gehn asamahr, ana ane ba kpo tib elfuumu elfuumu kpo lim. Bo kpo gbod asamahr ebo, eji ane lꞌkahn re, bo kpi elbo njal bade. Etingitingi, n kp-n tongo re, Eltuuru ebo ebsehng mbang.<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">Luk 18:12</char></note> <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />A lꞌkehme elna njal bade, jo ru esamahr, wo fere jak esi, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />eji ane lꞌkꞌkahn re, a kpi elna njal bade, sehngem Nso no ane kil-e elnyehne wo bahke kahne. Nso no kpo nyehn nsol nyi ki li gbul gbul gbuul bahk-a tuuru.<verse eid="MAT 6:18" /></para>
  <para style="s">Afang nya li go ejahbetul</para>
  <para style="r">(<ref loc="LUK 12:33-34">Luk 12:33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />“Kana jo kpu nsol afang bum elnahne go njini nyia, edi ji bahke biili amahn, etan fere wo, awajv fere wa yel ba v.<note caller="+" style="f"><char style="fr" closed="false">6:19 </char><char style="ft" closed="false">Luk 12:16-21</char></note> <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Ga nob re wahn kpu nsol afang bum elnahne go ejahbetul Esowo, edi ji lꞌkꞌtiki biili amahn, etan lꞌkꞌma wo, awajv lꞌkꞌma wa yel song v.<note caller="+" style="f"><char style="fr" closed="false">6:20 </char><char style="ft" closed="false">Mat 19:21</char></note> <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Tibre eltim ena bahke tiki jol edi ji afang enya li no.<note caller="+" style="f"><char style="fr" closed="false">6:21 </char><char style="ft" closed="false">Kol 3:1-3</char></note><verse eid="MAT 6:21" /></para>
  <para style="s">Ellennge ni ngubjing</para>
  <para style="r">(<ref loc="LUK 11:34-36">Luk 11:34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />“Elmahr ni li ana etꞌrekahng ka ngubjing. Elmahr ena lꞌjol sange sange, ngubjing enya bahke bele ellennge. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Elmahr ena lꞌjol abꞌbi abꞌbi, ngubjing enya bahke jolo ejannge ejannge. Ellennge ni wob-a go atahng lꞌfere kpiidi, jol ejannge, nkom ejannge nyi bahke jolo tete, jol nyi nse sang.<verse eid="MAT 6:23" /></para>
  <para style="s">Atꞌtiiri nya njini nyia</para>
  <para style="r">(<ref loc="LUK 16:13">Luk 16:13</ref>; <ref loc="LUK 12:22-31">12:22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />“Nnene limm, no bahke ma loko nde na ebal. Á bahke koko noko ekv, noko jo kor-e. Tohko jol ano, á bahke lake na awohng, fere jo daange noko. Ń nehm ma loko Esowo, fere jo loko akpohko.<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />“Ana wo wahnge n kp-n tongo re, Kana jo tiiri bada nsol nyi ḿ bahke jo li, fere jo wꞌwo, a nsol nyi ḿ bahke jo kak go ngubjing.<note caller="+" style="f"><char style="fr" closed="false">6:25 </char><char style="ft" closed="false">1 Pit 5:7</char></note> Elkpin sang ga gbal sehnge nsol alehka? Ngubjing sang ga gbal sehnge aboma? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Nyehnen nruk ana bo kpꞌfonngo go elbung yannge. Bo kpehme bahm nsol. Bo kpehme kpa. Bo kpehme sol, song lake go abuungu. Nso ejahne no li go ero wo kpo le bo. Anv, wahn sang ga gbal sehnge nruka?<note caller="+" style="f"><char style="fr" closed="false">6:26 </char><char style="ft" closed="false">Mat 10:29-31</char></note> <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Nne awo ewahne no bahke kpe ma budu abon nnya go ege elkpin, eji á kpꞌtiiri ana?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />“Jen ji wahnge ń kpꞌtiiri bada nsol ngubjing? Nyehnen ana atꞌtul nkpad kpo gbal go emahng. Bo kpehme nyennge lim eltum. Bo kpehme jamme nsol kak elbo. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />N kp-n tongo re, Jol Solomon go ege ellub á liibem ana atꞌtul nyao. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Ana Esowo kpo liibi ajele nya li go emahng, nya kpo kpin lela lela, behna bo jahm fi, jen ji wahnge á lꞌki-n tob liibi, wahn ji kpꞌkahn taame ntiil?<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />“Owo fvfo nobo re wahn kꞌjo tiiri, fere jo bung re, ‘Ejum aji e bahke jo li, fere jo wo, fere jo kak go ngubjing?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Nsol nyia nyi ane ba ki nyi Esowo kpo tiiri. Wo, wahn, Nso ejahne no li go ero kpꞌkahne re, nsol nyia kpee nobo re wahn bel.<note caller="+" style="f"><char style="fr" closed="false">6:32 </char><char style="ft" closed="false">Hib 13:5</char></note> <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Ga nob re wahn gbo mbang tiiri bade etul bi Esowo, ana ḿ bahke lehke eno go ege esamahr. Á bahk-n budu nsol nyehko kpee.<verse eid="MAT 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 6:34" />“Kana jo tiiri bade nya behna! Nong behna tiiri bade elne. Efung abehng abehng kpo bel afemfem nyanye. Wahn, kana jo budu atꞌtiiri nya nyahne!<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Kana jo lam ane bako</para>
  <para style="r">(<ref loc="LUK 6:37-38">Luk 6:37-38</ref>,<ref loc="LUK 6:41-42">41-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />“Kana jo lam ane bako, eji Esowo lꞌki-n tob lam.<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="ft" closed="false">Rom 2:1; 1 Kor 4:5</char></note> <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Tibre go mbang nyꞌnehm nyi ń kpo lam ane bako, nyi nyi Esowo bahke tob ko lam-n. Ana ń gaare no ka, ano wo Esowo bahke tob gare ka-n.<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />“Jen ji wahnge a kpꞌseenge mmolsahk no wob mmonanne go elmahr, a kil eltiiri bada nkporti nyi wob go ega elmahr? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />A bahke sahbe renan, tong mmonanne re, ‘Nong, me n yehk-a mmolsahk no wob-a go elmahr,’ eji nkporti wob-a go elmahr? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Wobnob tane! Tohko gbo mbang yehke nkporti go ega elmahr, eji a lꞌmal nyehn, yehke mmolsahk no wob go elmahr mmonanne.<note caller="+" style="f"><char style="fr" closed="false">7:5 </char><char style="ft" closed="false">Gal 6:1-5</char></note><verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />“Kana jo ka ebv nsol Esowo nyi li eje eje, eji bo lꞌkꞌtahm kehm-n eljaake.<note caller="+" style="f"><char style="fr" closed="false">7:6 </char><char style="ft" closed="false">Mat 10:14</char></note> Kana jo rod amohkesol ro tv akuk, eji bo lꞌkꞌkadde go bo akpade.<verse eid="MAT 7:6" /></para>
  <para style="s">Bahben, ḿ bahke bele</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luk 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />“Bahben, ḿ bahke bele. Seben, ḿ bahke nyehne. Kahden, bo bahke lennge mbu ka-n. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Tibre nne awohng awong no lꞌbahb, á bahke bele. Nne no lꞌseb, á bahke nyehne. Nne no lꞌkahd, bo bahke lennge mbu ka-e.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />“Nne awo ewahne no bahke kake mmon ewe eltal, á lꞌbahb-e re á ka-e nsol alehke?<note caller="+" style="f"><char style="fr" closed="false">7:9 </char><char style="ft" closed="false">Mak 11:24</char></note> <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Afi á bahke rodo nnyo ka-e, á lꞌbahb-e re á ka-e nsahre? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Wahn ji li na abi ane, ń kpꞌkahne ana ń kpo ka abon ebahne nsol nyi nno, lꞌlim renan, Nso ejahne no li go ero lꞌki-n tob ka nsol nyi nno, ń lꞌbahb-e?<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">Jems 4:3</char></note><verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />“Nsol kpee nyi ń kpꞌsebe re ane bako jo lim ka-n, nyi nyi ḿ bahke tob jo lim ka bo. Ń lꞌlim ano, wahn ebbum atahm nya Esowo, a alum nya abanyehnamahr bungu no.<note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="ft" closed="false">Mat 22:37-40; Rom 13:8-10</char></note><verse eid="MAT 7:12" /></para>
  <para style="s">Nfiidifiidi eti mbu</para>
  <para style="r">(<ref loc="LUK 13:24">Luk 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />“Sehngen go nfiidifiidi eti mbu jio! Tibre mbang nyi li rehng go ellulagun, mbang elfohk elkul nyi, eti mbu eje kpꞌkpange. Ane gbalee ba kpꞌsehnge ona. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Wo, mbang nyi li rehng go elkpin, mbang asodaroongo nyi. Eti mbu eje li fii.<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">Mat 19:24; Elt 14:22</char></note> Ane ba kpꞌnyehne mbang nyio li ntiil.<verse eid="MAT 7:14" /></para>
  <para style="s">Nnoobo eti, bo kpo liing-e go ege akab</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luk 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“Jo gberen akimfahnge abanyehnamahr. Bo kpo ba go egahne, jo ba lim, are ejoro bi. Wo, go bo atahng bo li, are abibbib enyam bi.<note caller="+" style="f"><char style="fr" closed="false">7:15 </char><char style="ft" closed="false">Elt 20:29</char></note> <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Go bo akab wo, ḿ bahke bo liingi. Anv, asokonso, nne kpo jꞌje song bong akab avaina? Agasame, nne kpo je song bong akab afiga?<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">Gal 5:19-23; Jems 3:12</char></note><verse eid="MAT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 7:17" />“Eti ji nno ajehng ajehng kpo kab anoobo akab. Esabsab eti kpo kab abi akab. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Eti ji nno nehm ma kab abi akab. Esabsab eti nehm ma kab anoobo akab. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Eti ajehng ajehng ji tohko kab anoobo akab, bo bahke gbahke kak agun.<note caller="+" style="f"><char style="fr" closed="false">7:19 </char><char style="ft" closed="false">Jon 15:2,6</char></note> <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Go bo akab wo fvfo, ḿ bahke bo liingi.<verse eid="MAT 7:20" /></para>
  <para style="s">Wahn n nehme kahn</para>
  <para style="r">(<ref loc="LUK 13:25-27">Luk 13:25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“Nne awohng awohng sang no kpo lung-m re, ‘Ntul, Ntul!’ bahke yele go ejahbetul Esowo, sehngem ye ji kpꞌlimi ji Nsoo no li go ero tong-e no re á lim bahke yele.<note caller="+" style="f"><char style="fr" closed="false">7:21 </char><char style="ft" closed="false">Rom 2:13; Jems 1:22</char></note> <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Efung bio ane gbalee bahk-m bahbe re, ‘Ntul, wahr sang jo nyehn amahr go ega mbinga, fere jo kam abi atohko yehke go ega mbinga, jo lim akpokosi gbalee go ega mbinga?’<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">1 Kor 13:1-2</char></note> <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Owo m bahke kehm tongo bo re, ‘Me, wahn n nehme kahn.<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false">Mat 25:12</char></note> Fak-m wahn go esamahr, wahn aneb abꞌbi ba!’<verse eid="MAT 7:23" /></para>
  <para style="s">Ana ane abal si ntahk</para>
  <para style="r">(<ref loc="LUK 6:47-49">Luk 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“Fvfo, nne awohng awohng no lꞌwuk alum enyame, fere jo lim, á li ana ekahnkahn nne no si etahk eje kunu go ekpartal.<note caller="+" style="f"><char style="fr" closed="false">7:24 </char><char style="ft" closed="false">1 Kor 10:4</char></note> <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Elahb kehm ba na, nnyel kehm yele, kuumu agbunggbung, rehng etahk jio, nfeb kehm kehme ellimi, jo gbul etahk jio. Tikem gbo. Tibre á si kunu go ekpartal.<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />“Nne awohng awohng no lꞌwuk alum enyame, kꞌlim, á li ana egboolo nne ji si etahk eje kunu go erikehndi. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Elahb kehm ba na, nnyel kehm yele, kuumu agbunggbung, rehng etahk jio, nfeb kehm kehme ellimi, jo gbul etahk jio.<note caller="+" style="f"><char style="fr" closed="false">7:27 </char><char style="ft" closed="false">Ell 18:10</char></note> Etahk jio kehm gboko, wa rꞌrere rꞌrere.”<verse eid="MAT 7:27" /></para>
  <para style="s">Nsahm nyi Jisos</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Eji Jisos ma bung nsol nyia mal, eltibi ene kehm kpoko ellong ane bao esi. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Á jo tibi bo ana nne no kpi nsahm. Á joom tib ana atꞌtibi ebo ba atahm.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Ana Jisos limi nne abili, á nob</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mak 1:40-45</ref>; <ref loc="LUK 5:12-16">Luk 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Jisos kehm badde go ewong jio, ellong ane gbalee tahm toon-e. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Nne abili kehm lohngo ba go ege, kehm ba jamm-e alahng, kehm bungu re, “Nsoo, lꞌkor-a, a li-m ma lim, n nob.”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Jisos kehm tanne ebo ebe, koor-e, kehm bungu re, “Kor-m kor, wobnob!” Tvtv ona á kehm soro nob abili enye.<verse eid="MAT 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 8:4" />Owo Jisos kehm-e tongo re, “Ka tiki tong nne awohng awohng, wobwuka? Song goji nlimajom, wo song tib-e elna, fere lim njom nyi Moses tibi no, eji lꞌjol ejum ntianse ka ane.”<verse eid="MAT 8:4" /></para>
  <para style="s">Ana Jisos limi nlokeltum awohng, á nob go Kapenium</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luk 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Eji Jisos rehnge go Kapenium, ntubesi a nsoja no Rom kehm bake, ba kpir-e, kehm-e gboongo <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />re, “Nsoo, nlokeltum ewame noa go etahk, kpꞌyame gꞌga, jol á nehme ma jen.”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Jisos kehm-e tongo re, “M bahke bake ba lim-e, á nob.”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Owo ntubesi a nsoja noo kehm-e faange re, “Nsoo, me n fuumem re wo ba yel go egame ekpꞌkpa. Lub bung na bung ellum, nlokeltum ewame bahke nobo. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Tibre me n li nne no wob nne go elwo. N tob kpi nsoja nyi wob-m go elwo. N lꞌtong noo re, ‘Song!’ á tahm. N lꞌtong noka re, ‘Ba!’ á ba. N lꞌtong nlokeltum ewame re, ‘Lim jia!’ á lim na lim.”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Eji Jisos wuku ano, kehm-e kpoko esi. Á kehm tongo ane ba jo toon-e re, “Etingitingi, n kp-n tongo re, elkohn eltaame ana nia n ka nyehn a nyehn go Israel.<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="ft" closed="false">Mat 15:28</char></note> <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />N kp-n tongo re, Ane gbalee bahke lohngo go ero nfam, a erede nfam ba ji a Ebraham, a Aisik, go Jekob go ejahbetul Esowo, jo li nsol a bo.<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">Luk 13:28-29</char></note> <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Wo, abon ntul ba jol lehke etul, bo bahke rodo bo, ro kak edi ji nkom ejannge li no. Owo ane bahke jo ling, fere jo kono amahn.”<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Owo Jisos kehm tongo ntubesi a nsoja noo re, “Song kehnge! Ana a ma taame, ano wo bahke jolo ka-a.”<note caller="+" style="f"><char style="fr" closed="false">8:13 </char><char style="ft" closed="false">Mat 9:29</char></note> Ngare nyꞌnehm ona nyi nlokeltum ewe nobo eyam ebe.<verse eid="MAT 8:13" /></para>
  <para style="s">Ana Jisos limi aneb ayam gbalee, bo nob</para>
  <para style="r">(<ref loc="MRK 1:29-34">Mak 1:29-34</ref>; <ref loc="LUK 4:38-41">Luk 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Jisos song rehnge kan etahk Pita, á kehm song nyehn nnyehn nkal a Pita nong kpꞌyame arumbum.<note caller="+" style="f"><char style="fr" closed="false">8:14 </char><char style="ft" closed="false">1 Kor 9:5</char></note> <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Á kehm-e kooro go ebo, á kehm soro nob arumbum nyao, kehm soro tahm, kehm-e kehme elloko.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Eji elgung ba no, ane kehm koko ane gbalee ba bele abi atohko, ba go ege. Á kehm kame bo abi atohko nyao kpee yehke go ege ellum, fere lim aneb ayam kpee, bo nob, <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />eji lꞌlohko jol ana Esowo bungu sehng goji nnyehnamahr Aisaya re,</para>
  <para style="q1" vid="MAT 8:17">“Á rodo elleenge enahre,</para>
  <para style="q1" vid="MAT 8:17">fere sol ayam enyahre.”<verse eid="MAT 8:17" /></para>
  <para style="s">Nong, akvne kpa akvne kak</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luk 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Eji Jisos nyehne ellong ane gbalee ba ma ba yiimi senng-e kak, á kehm tongo abatꞌtoono ebe re, “Wahr tahmen egbuk jehko!”<verse eid="MAT 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 8:19" />Owo ntꞌtibi atahm awohng kehm bake go ege, ba tong-e re, “Ntꞌtibi, m bahk-a toono rehng edi ajehng ajehng ji a fi no.”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Jisos kehm-e faange re, “Akpangang kpi abing nya bo kpo woomo. Nruk kpi ntahk nyi bo kpo kang. Wo, Mmon no nne, edi ellohko esi ajehng ajehng á kpimm.”<note caller="+" style="f"><char style="fr" closed="false">8:20 </char><char style="ft" closed="false">2 Kor 8:9</char></note><verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Nne noko no jolo ntꞌtoono Jisos kehm-e tongo re, “Nsoo, nong, me n tohko song kpa nsoo kak.”<note caller="+" style="f"><char style="fr" closed="false">8:21 </char><char style="ft" closed="false">Mat 10:37</char></note><verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Owo Jisos kehm-e faange re, “Tahm toon-m, nong, akvne kpa atem akvne kak!”<note caller="+" style="f"><char style="fr" closed="false">8:22 </char><char style="ft" closed="false">Ef 2:1; 5:14; Kol 2:13</char></note><verse eid="MAT 8:22" /></para>
  <para style="s">Ana Jisos bungu tong nfeb, a ebuku</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mak 4:35-41</ref>; <ref loc="LUK 8:22-25">Luk 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Jisos kehm yele go egbang, abatꞌtoono ebe tahm toon-e. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Owo egburu nfeb nyi nnen a nnen kehm ba kehme ellimi go eto jio, ebuku jo lim, bulu egbang. Ngare nyio Jisos jo lꞌlal. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Abatꞌtoono ebe kehm jeke go ege, song nyahm-e, kehm-e tongo re, “Nsoo, tahr-r, e kpꞌtane na a!”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Jisos kehm faange bo re, “Jen ji wahnge ń kpꞌfahle ana, wahn ji kpꞌkahn taame ntiil?”<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">Mat 14:31; 16:8</char></note> Owo á kehm mehle yiimi, kehm nyame nfeb, a ebuku. Edi kehm naange soom.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Owo kehm kpoko ane bao esi. Bo kehm bungu re, “Elkohn nne awo anae, no kpo bung tong nfeb, a ebuku, bo wuk-e?”<verse eid="MAT 8:27" /></para>
  <para style="s">Ana Jisos limi ane abal ba bele abi atohko, bo nob</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mak 5:1-20</ref>; <ref loc="LUK 8:26-39">Luk 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Jisos kehm bake go Gadara ji jolo go egbuk eto jehko. Owo ane abal kehm lohngo edi ji alahm akvne jolo no, ba wan-e. Bo bele abi atohko go bo atahng. Bo jo mennge sehng. Jol nne awohng awohng joom sahb, sehng mbang nyio. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Owo bo kehm biingi tiim re, “Anv, Mmon no Esowo, jen ji e kpi no me atemtem? Anv, a ba na re wo ba kak-r erema, eji ngare kala biinga?”<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">2 Pit 2:4</char></note><verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Ellong akuk jolo ona kpidi kpidi, jo li nsol. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Abi atohko kehm gboongo Jisos re, “A lꞌkehm-r kame yake, nong, wahr song yel akuk nyao go atahng.”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Owo Jisos kehm tongo bo re, “Songen!” Bo kehm soro lohng, song yel akuk nyao go atahng. Ellong akuk nio kehm soro rehm abahl, song fooro agbunggbung eto jio, yel go alahb tan.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />Ane ba jo baabe akuk nyao, kehm soro be ebo tahm, song rehng go nla ejahbe, song tooro kpee, fere tooro ejum ji ma lim ane ba bele abi atohko. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Ejahbe jio kpee kehm tahme, song kpiri Jisos. Eji bo song nyehn-e, bo kehm-e gboongo re, á lub tahm ejahbe jio song.<note caller="+" style="f"><char style="fr" closed="false">8:34 </char><char style="ft" closed="false">Jon 4:40</char></note><verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Ana Jisos limi nne no ki jo ma jen, á nob</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mak 2:1-12</ref>; <ref loc="LUK 5:17-26">Luk 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Jisos kehm yele go egbang, siiri eto jio, song rehng go ege ejahbe.<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="ft" closed="false">Mat 4:13</char></note> <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Ane bandiki kehm koko mbanne nyi noongo go edilnong ba a ne go ege. Eji Jisos nyehne eltaame ebo, á kehm tongo mbanne nyio re, “Mmon ewame, bob eltim! Abiafem enya, me n tahm ka-a.”<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Owo atꞌtibi ba atahm bandiki kehm kehme elbungu atemtem re, “Nne noa kpꞌsuku Esowo, eji á ma rod elne bum ana Esowo.”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Jisos kꞌkahn ntir atahng ebo, owo á kehm bungu re, “Jen ji wahnge ń kpꞌtiri elkohn abi nsol ana nyao go egahna ntim?<note caller="+" style="f"><char style="fr" closed="false">9:4 </char><char style="ft" closed="false">Jon 2:25</char></note> <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Anv, jen ji ga riidi, n lꞌtong-e re, ‘Abiafem enya me n tahm ka-a,’ afi n lꞌtong-e re, ‘Tahm, wo jen!’? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />M bahk-n tibi re, Mmon no nne kpi nsahm go njini nyia nyi á bahke ma tahm ka nne go ege abiafem.”<note caller="+" style="f"><char style="fr" closed="false">9:6 </char><char style="ft" closed="false">Mat 1:21</char></note></para>
  <para style="p" vid="MAT 9:6">Owo á kehm tongo mbanne nyio re, “Mehl, wo rod edilnong eja, song kehnge!”<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />Nne noo kehm mehle yiimi, tahm eje kehnge. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Eji ane bao nyehne ano, bo kehm kehme elfahle, fere jo tehk Esowo bi ma ka ane elkohn nsahm ana nyio.<verse eid="MAT 9:8" /></para>
  <para style="s">Ana Jisos lungu Matiu</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mak 2:13-17</ref>; <ref loc="LUK 5:27-32">Luk 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Jisos kehm tahme edi jio. Eji á jo sehng asongo, á kehm nyehne nne no jehk go ege a nji atak, no bo jo lung-e re Matiu. Owo á kehm-e tongo re, “Tahm toon-m!”</para>
  <para style="p" vid="MAT 9:9">Matiu kehm soro tahm toon-e.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Efung abehng eji Jisos jolo go etahk Matiu, jo li nsol, abakokatak gbalee, a aneb abꞌbi jolo a ne o, go abatꞌtoono ebe fvfo, tob jo li nsol.<verse eid="MAT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 9:11" />Egom Farisi jindiki nyehne kan ano, bo kehm tongo abatꞌtoono ebe re, “Jen ji wahnge ntꞌtibi ewahne kpo li nsol edi ajehng a abakokatak, go aneb abꞌbi?”<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">Luk 15:2</char></note><verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Jisos kehm wuku ana bo jo bung, kehm faange re, “Ane ba li nob nob kpehme seb nlimakahm, sehngem ane ba kpꞌyame ba ba kpo seb nlimakahm. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Songen, wahn song kpili bade ana edi nwer Esowo jia lohngo no, ji bungu re, ‘Njom sang n kpꞌsebe, ndon nyi.’ M baam re me m ba lung anoobo ane, m ba re me m ba lung aneb abꞌbi re bo gbo ndon.”<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">Mat 18:11</char></note><verse eid="MAT 9:13" /></para>
  <para style="s">Mbahbe nyi li bada njal abade</para>
  <para style="r">(<ref loc="MRK 2:18-20">Mak 2:18-20</ref>; <ref loc="LUK 5:33-35">Luk 5:33-35</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Abatꞌtoono Jon ji nwohngalahb kehm bake goji Jisos, ba bahb-e re, “Jen ji wahnge wahr, a Bab Farisi, e kpo kono elnahre njal bade, abatꞌtoono eba kil jo bade?”<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">Luk 18:12</char></note><verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Owo Jisos kehm faange bo re, “Anv, atem nlumanne li ma ji ndon ndon go elkak elbala, eji nlumanne kpeke li a boa?<note caller="+" style="f"><char style="fr" closed="false">9:15 </char><char style="ft" closed="false">Jon 3:29</char></note> Efung bahke rehnge bi bo bahke rodo nlumanne go bo ellong, tahm a ne. Ngare nyio nyi, bo bahke kehme elbo njal bade.<verse eid="MAT 9:15" /></para>
  <para style="s">Eltibi ni mahne mahne lꞌli, eltibi ni Jisos lꞌli</para>
  <para style="r">(<ref loc="MRK 2:21-22">Mak 2:21-22</ref>; <ref loc="LUK 5:36-39">Luk 5:36-39</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“Nnene limm, no bahke koko mmojang mbomo no nfenfe, song baade nkꞌkula mbomo. Á lꞌlim ano, mmojang mbomo no nfenfe nehm yiimi. Nkꞌkula mbomo mio bahke kpe kv edi jio budu sehnge ana wuku wuku.<note caller="+" style="f"><char style="fr" closed="false">9:16 </char><char style="ft" closed="false">Jon 1:17</char></note> <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Nnene limm, no bahke yaange amahm ma kpꞌfahle kak go nkꞌkohko eyahbe. Á lꞌlim ano, eyahbe jio bahke bahnge na, amahm sale. Nobo re nne ko amahm ma kpꞌfahle, song yaange kak go eyahbe nfenfe.<note caller="+" style="f"><char style="fr" closed="false">9:17 </char><char style="ft" closed="false">Rom 7:6</char></note> Eyahbe nfenfe jio, a amahm bahke jolo nob nob.”<verse eid="MAT 9:17" /></para>
  <para style="s">Mmon a ntubesi, a nnenkal no kooro Jisos go ege a nsubu</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mak 5:21-43</ref>; <ref loc="LUK 8:40-56">Luk 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Eji Jisos jo bung nsol nyia tong bo, owo ntubesi a Jus awohng kehm lohngo ba, ba jamm-e alahng, kehm bungu re, “Mmon ewame kpꞌna kpoko. Ba wahr tahm, wo ba koor-e ebo, eji á lꞌfere bel elkpin.”<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />Jisos kehm tahme toon-e, a abatꞌtoono ebe fvfo.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Mmonankal awohng no alung sa-e go nnahb ewubu a nnya ebal, kehm kehme Jisos toono go njahm, kehm kooro esꞌsili nsubu enye. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Tibre á bungu go ege eltim re, “N lꞌlub kooro nsubu enye nyi nyi, m bahke nobo.”<note caller="+" style="f"><char style="fr" closed="false">9:21 </char><char style="ft" closed="false">Mat 14:36</char></note><verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Jisos kehm keebe, nyehn-e, kehm-e tongo re, “Mmon ewame, bob eltim! Eltaame ena ni ma-a lim, a ma nob.” Ngare nyꞌnehm ona nyi nnenkal noo kehm soro nob.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Owo Jisos kehm ba rehng go etahk ntubesi noo, ba nyehn aneb ase, a ane ba ba elkv, bo kpꞌkubu ase, jo lim ewok. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Á kehm tongo bo re, “Tahmen, tibre mmon noa ka kpo, á kpꞌlale na.”</para>
  <para style="p" vid="MAT 9:24">Owo bo kehm-e elwolo.<verse eid="MAT 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 9:25" />Bo kame kan ane bao yehke me, Jisos kehm yele ekpꞌkpa song jabbe mmonse nkal noo go ebo, á kehm mehle ji.<note caller="+" style="f"><char style="fr" closed="false">9:25 </char><char style="ft" closed="false">Luk 7:15; Jon 11:44</char></note><verse eid="MAT 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 9:26" />Eka jio kehm yeere na yeere ejahbe jio kpee.<verse eid="MAT 9:26" /></para>
  <para style="s">Ana Jisos limi awakamahr, ane abal, bo nyehn</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Jisos kehm tahme edi jio, jo jen asongo. Awakamahr ane abal kehm-e kehme eltoono, fere jo rabe re, “Mmon no Devid, nong, wahr lub fil-a ndon!”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Eji Jisos yele go ekpꞌkpa, awakamahr ane bao kehm ba kpir-e. Owo Jisos kehm bahbe bo re, “Anv, ń kpꞌtaame re m bahke ma lim ejum ana jiaa?”</para>
  <para style="p" vid="MAT 9:28">Owo bo kehm taame re, “Ee nsoo.”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Jisos kehm kooro bo go amahr, kehm bungu re, “Nong, jol ana ḿ ma taame.”<note caller="+" style="f"><char style="fr" closed="false">9:29 </char><char style="ft" closed="false">Ell 3:17-18</char></note><verse eid="MAT 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 9:30" />Amahr ebo kehm soro lennge.</para>
  <para style="p" vid="MAT 9:30">Jisos kehm bungu a bo tꞌtahne re, “Kana tiki tong nnene!”<verse eid="MAT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31" />Bo kehm tahme, song tooro tong ejahbe jio kpee ji Jisos ma lim.<verse eid="MAT 9:31" /></para>
  <para style="s">Ana Jisos limi nkamme, á bung</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Eji ane bao kpꞌtahme asongo, ane bako kehm koko nkamme ba a ne go ege, nyi bele ebi etohko go ege atahng. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Jisos kehm kame nne noo ebi etohko jio yehke, nne noo soro kehme elbungu.</para>
  <para style="p" vid="MAT 9:33">Ane bao kehm kpoko bo esi. Bo kehm kehme elbungu re, “Elkohn ejum ana jia, e ka nyehn a nyehn go Israel.”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Bab Farisi kehm bungu re, “Ntul a nnehm wo ka-e nsahm re á jo kam ane abi atohko yehke.”<note caller="+" style="f"><char style="fr" closed="false">9:34 </char><char style="ft" closed="false">Mat 12:24</char></note><verse eid="MAT 9:34" /></para>
  <para style="s">Ana ane fili Jisos ndon</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Jisos kehm tahme, jo yannge ajahbe nya nnen, a nya nse kpee. Á jo tibi ane go bo ntahk ero, fere jo tiingi bo nnoobo etib bi etul bi Esowo, fere jo lim ane, bo jo nob elkohn eyam abehng abehng. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Eji á nyehne ellong ane, bo kehm-e fili ndon. Tibre eko ebtan bo, nkakebo bo kpimm, bo jolo ana ejoro bi ki kpi mbꞌbaabe.<note caller="+" style="f"><char style="fr" closed="false">9:36 </char><char style="ft" closed="false">Mak 6:34</char></note> <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Owo á kehm tongo abatꞌtoono ebe re, “Egburu egbe jia, ji elkpake, wo, abalimeltum li ntiil.<note caller="+" style="f"><char style="fr" closed="false">9:37 </char><char style="ft" closed="false">Luk 10:2</char></note> <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Gboongen nfono egbe, eji á lꞌtum abalimeltum tv re bo ba kpa egbe eje.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Abatꞌtoono ebe, ewubu ane abal</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mak 3:13-19</ref>; <ref loc="LUK 6:12-16">Luk 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Jisos kehm lungu abatꞌtoono ebe, ewubu ane abal tv elne, kehm kake bo nsahm re bo kam ane abi atohko yehke, fere lim ane, bo nob elkohn eyam abehng abehng. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Abing abatiingetib ewubu ane abal nya a. Ngbokambang, Saimon ji bo jo lung-e re Pita, go Andru mmonannyehn, go Jems ji mmon a Sibidi, a Jon ji mmonannyehn Jems, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />go Filip, Batolomi, Tomos, go Matiu nkokatak, Jems ji mmon Alfeus, a Lebeus ji bo jo lung-e re Tadeus, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />a Saimon ji jo seb re ejahbe eje lohng go elwo ni aneb Rom, go Judas Iskariot ji gungu Jisos.<verse eid="MAT 10:4" /></para>
  <para style="s">Eltum ni abatꞌtoono Jisos song lim</para>
  <para style="r">(<ref loc="MRK 6:7-13">Mak 6:7-13</ref>; <ref loc="LUK 9:1-6">Luk 9:1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Re Jisos kehm tumu ewubu ane abal bao, á tubu bo elle re, “Kana je ajahbe nya ane ba ki li Jus, a ajahbe Samaria. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Songen goji ejoro bi Israel bi ma tan.<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false">Mat 15:24; Elt 13:46</char></note> <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Song bungen alum Esowo re, ‘Etul bi Esowo ebkabbe.’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Limen aneb ayam, bo nob, wahn lim aneb abili, bo nob, fere nyahme akvne go elkv, fere kam ane abi atohko yehke.</para>
  <para style="p" vid="MAT 10:8">“Ana n ka-n mbol mbol, tob kaan go mbol mbol.<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false">Elt 20:33; 1 Pit 5:2</char></note> <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Kana fili agul, a asilva, jol kana kak apene go egahne abam fili. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Kana fili abam efilibo, fere fili mbomo ebal ebal, a akpaketa, a nti efilibo. Tibre nlimeltum fꞌfuumu re á bel nsol alehke.<note caller="+" style="f"><char style="fr" closed="false">10:10 </char><char style="ft" closed="false">Luk 22:35; 1 Kor 9:4-15</char></note><verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />“Ejahbe ajehng ajehng ji ń lꞌsong rehng, afi jolo egburu ejahbe, afi jolo mmojahbe no nse, seben nne no bahke kahne re, eltum enahne ni nno ni. Kangen a ne o tete wahn tahm ejahbe jio. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Ń lꞌyange go etahk nne, kaken bo nnyo. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Ane bao lꞌvvr-n, nong, elkoono ni ń kpi no jol a bo. Bo tohko fere vvr-n, elkoono ni ń kpi no bahke feere, ba tob-n. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Nne awohng awohng no tohk-n vvrv, kꞌwuungu atung go egahne alum, afi fere jolo ejahbe, tahmen edi jio, wahn kum ebtohko go egahne akpade.<note caller="+" style="f"><char style="fr" closed="false">10:14 </char><char style="ft" closed="false">Elt 13:51</char></note> <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Etingitingi, n kp-n tongo re, Go efung elam, elam ji ejahbe jio bahke bibi sehnge ji Sodom, a Gomorra.<note caller="+" style="f"><char style="fr" closed="false">10:15 </char><char style="ft" closed="false">Mat 11:24</char></note><verse eid="MAT 10:15" /></para>
  <para style="s">Ebnohko bi kpꞌbake</para>
  <para style="r">(<ref loc="MRK 13:9-13">Mak 13:9-13</ref>; <ref loc="LUK 12:11-12">Luk 12:11-12</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />“Anv, n kp-n tumu ana ejoro tv go ellong abi enyam. Jo bangen ana enyo, wahn fere jol ana mbehl nyi kil jo lim ebi ejum ajehng ajehng.<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="ft" closed="false">Rom 16:19</char></note> <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Jo gberen! Tibre ane bahk-n jo kak go esub, fere jo dv-n go bo a ntahk ero.<verse eid="MAT 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 10:18" />“Bo bahke jo ko-n, song yiimi go esamahr atubesi, a atul tib go egame esi. Nsol nyia nyi bahk-n jo lim, eji ń lꞌjo yiim-m ntianse go bo esamahr, a esamahr ane bako ba ki nyi Esowo.<note caller="+" style="f"><char style="fr" closed="false">10:18 </char><char style="ft" closed="false">Elt 25:23; 27:24</char></note> <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Bo lꞌkak-n go esub, kana jo tiiri bada nsol nyi ḿ bahke bungu, jol ana ḿ bahke bꞌbung. Tibre ngare nyio bo bahk-n kake alum nya ḿ bahke bungu. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Tibre alum nya ḿ bahke bungu, nyanyahne sang, bahke lohngo goji Etohko ji Nso ejahne ji kpꞌbungu go egahne atahng.<note caller="+" style="f"><char style="fr" closed="false">10:20 </char><char style="ft" closed="false">Elt 4:8,13</char></note><verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />“Abonanyehn nne bahke jo yake abonanyehn ka re bo wul. Babnde nne bahke tob jo yake abon ebo ka re bo wul. Abon bahke jo kpiidi kuumu babnde, jo jabbe bo ka, bo wul. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Nne awohng awohng bahke jo ko-n ekv tib go egama mbing. Nne no lꞌkpuumu tete rehng go esꞌkohro, ye wo bahke bele eltahre.<verse eid="MAT 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 10:23" />“Bo lꞌnohk-n go ejahbe jehko, been, song ejahbe jehko. Tibre etingitingi, n kp-n tongo re, Ń nehm ma tiki lim eltum go ajahbe Israel kpee mal, tete Mmon no nne feere ba.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />“Nne no kpꞌkpili kpehme gbal sehnge ntꞌtibi ewe. Nlokeltum kpehme gbal sehnge nde.<note caller="+" style="f"><char style="fr" closed="false">10:24 </char><char style="ft" closed="false">Luk 6:40</char></note> <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Nobo re nne no kpꞌkpili tob taame go eyebatahng jol ana ntꞌtibi ewe. Nobo re nlokeltum taame, jol ana nde. Nfontahk, bo lꞌlung-e re ntul a nnehm, bahke limi renan, bo kꞌtob lung ane ebe ano?<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="ft" closed="false">Jon 15:20</char></note><verse eid="MAT 10:25" /></para>
  <para style="s">Nne awo fuumu re nne fahl-e?</para>
  <para style="r">(<ref loc="LUK 12:2-7">Luk 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />“Kana jo fahl ane! Ejum ajehng ajehng limm, ji bo bulu no, ji Esowo lꞌkꞌlennge. Ejum ajehng ajehng limm, ji bo behre no, ji ane lꞌkꞌkahn.<note caller="+" style="f"><char style="fr" closed="false">10:26 </char><char style="ft" closed="false">Rom 2:16</char></note> <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Ejum ji n kp-n tongo a mbehr mbehr, ḿ bahke bungu gbul gbul gbuul. Ji m bungu go awꞌwa tong-n, ḿ bahke bungu go elkab ane.<verse eid="MAT 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 10:28" />“Kana jo fahl ane ba kpo wul ngubjing, ba lꞌkꞌma wul etohko. Fahlen ye jio ji bahke ma rannge etohko, a ngubjing go ellulagun.<note caller="+" style="f"><char style="fr" closed="false">10:28 </char><char style="ft" closed="false">Jems 4:12</char></note> <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Nne li ma gunu nruk ebal go are, ka mpene. Abehng abehng limm, bi bahke gboko go ndi, sehngem re no, Nso ejahne taame na. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Wahn, alv enyahne kpee nya li go egahne asi, bobfange. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Kana kpe fahl! Wahn ba ga lub sehnge nruk gbalee.<verse eid="MAT 10:31" /></para>
  <para style="s">Ana nne bahke jo yiimi ntianse ka Jisos</para>
  <para style="r">(<ref loc="LUK 12:8-9">Luk 12:8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“Fvfo, nne awohng awohng no lꞌyiimi ntianse ka-m go esamahr ane, ye wo fvfo, m bahke tob yiimi ntianse ka-e go esamahr bi Nsoo no li go ejahbetul. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Nne awohng awohng no lꞌten-m go esamahr ane, ye wo fvfo, m bahk-e tob ten go esamahr bi Nsoo no li go ejahbetul.<verse eid="MAT 10:33" /></para>
  <para style="s">Elkoono sang, ekahngkahng bi</para>
  <para style="r">(<ref loc="LUK 12:51-53">Luk 12:51-53</ref>; <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />“Kana tir re, n ko elkoono ba a ni go njini nyia.<note caller="+" style="f"><char style="fr" closed="false">10:34 </char><char style="ft" closed="false">Jon 14:27</char></note> M baam re me n ko elkoono ba a ni, m ba re me n ko ekahngkahng ba a bi.<note caller="+" style="f"><char style="fr" closed="false">10:34 </char><char style="ft" closed="false">Hib 4:12</char></note> <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />M ba re ‘mmon fere kpiidi kuumu nde, mmon no nkal kpiidi kuumu nnyehn, nkal a nne kpiidi kuumu nnyehn nlum. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />Nne, ane ebe ba bahke fere jol anebekv ebe.’ <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />Nne no nde, afi jolo nnyehn, bo lꞌkor-e sehnge me, á fuumem a name. Nne no abon ebe lꞌkor-e sehnge me, á fuumem a name.<note caller="+" style="f"><char style="fr" closed="false">10:37 </char><char style="ft" closed="false">Luk 14:26</char></note> <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Nne awohng awohng no tohko rod ekros eje, tahm toon-m, á fuumem a name. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Nne no lꞌgare re á tahre elkpin ene, á bahke tane na elkpin ene. Nne no lꞌtane elkpin ene tib go egame esi, á bahke tahre na elkpin ene.<note caller="+" style="f"><char style="fr" closed="false">10:39 </char><char style="ft" closed="false">Jon 12:25</char></note><verse eid="MAT 10:39" /></para>
  <para style="s">Eltuuru</para>
  <para style="r">(<ref loc="MRK 9:41">Mak 9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />“Nne no lꞌvvr-n, á vvrv me. Nne no lꞌvvr-m, á tob vvrv nne no tum-m no. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Nne no lꞌvvrv nnyehnamahr, tib eji á kahne re nnyehnamahr Esowo wo, á bahke bele eltuuru ana ni nnyehnamahr kpo bel. Nne no lꞌvvrv etingitingi nne tib á li go etingitingi, á bahke bele eltuuru ana ni etingitingi nne kpo bel. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Nne awohng awohng no lꞌka nne awohng go ellong abonse baa abon alahb re á wo, tib eji á kpꞌkahne re, ntꞌtoono ewame wo, á bahke bele eltuuru go etingitingi.”<note caller="+" style="f"><char style="fr" closed="false">10:42 </char><char style="ft" closed="false">Mat 25:40</char></note><verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Ane ba Jon ji nwohngalahb tumu no</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luk 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Eji Jisos tubu abatꞌtoono ebe, ewubu ane abal, elle mal, á kehm tahme edi jio, song rehng go ajahbe Jus, jo bung alum Esowo, fere jo tib ane. <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />Eji Jon ji nwohngalahb ji woomo go ngbekobo wuku bada nsol nyi Kraist kpꞌlimi, á kehm yehke abatꞌtoono ebe tum tv-e. <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />Bo kehm song bahb-e re, “Wo wo li nne no Jon tongo re á kpꞌbaka, afi wahr ji sik nne nondiki?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Owo Jisos kehm faange bo re, “Feeren song goji Jon, wahn song tong-e bada nsol nyi ń kpꞌnyehne a, fere kpꞌwuku, <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />ana awakamahr kpꞌnyehne, abanne kpꞌtahme jen, aneb abili kpꞌnobo, alakatung kpꞌwuku, akvne kpꞌnyahme go elkv, akpak, bo kpꞌtiingi bo nnoobo etib. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Eyebatahng li ka nne no lꞌki-m sel gbo.”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Eji abatꞌtoono Jon ma feere fi, Jisos kehm bahbe ellong ane bao bada Jon re, “Elka emahng, eji ń jo je goji Jon, ń jo je re wahn song nyehn jen? Eljele ni nfeb kpꞌlimi kpꞌneenga? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Anv, ejum aji ń jo jꞌje re wahn song nyehn abee? Nne no ma liibi nsol nyi nno a nnoa? Ane ba kpo liibi ano kpo jol go ntahk nyi atul. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Anv, ejum aji ń jo jꞌje o, jo song nyehn? Nnyehnamahr woa? N kp-n tongo re, Wahn ebnyehn nne no gbale sehnge nnyehnamahr.<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false">Luk 1:76</char></note> <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Tibre Jon wo li nne no bo nyono go nwer Esowo bada ne re, ‘M bahke tumu ntiingetib ewame, á gbo-a mbang, song tuungu mbang bum-a.’<verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />“Etingitingi, n kp-n tongo re, nnene limm, no ma jꞌjol go njini nyia no gbale sehnge Jon ji nwohngalahb. Nne no ga rede go ellong ane ba bahke lehke etul bi Esowo, á gbale sehnge Jon.<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">Hib 3:5-6; Mat 13:17</char></note> <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Bomo ngare nyi Jon ji nwohngalahb tete rehng anv, etul bi Esowo li go elkake nsahm kehm kuumu, aneb nsahm bahke kuumu go eko akake.<note caller="+" style="f"><char style="fr" closed="false">11:12 </char><char style="ft" closed="false">Luk 16:16; Mak 7:26-30; Luk 18:5</char></note> <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Atahm nya Moses, a abanyehnamahr Esowo kpee tete ba rehng ngare nyi Jon bungu bade etul bia. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Lꞌkor-n taamen tv alum nyaa, nya li re, Jon wo li Elaija, ji bo bungu re á kpꞌbake.<note caller="+" style="f"><char style="fr" closed="false">11:14 </char><char style="ft" closed="false">Mat 17:10-13</char></note> <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Nne no kpi atung, nong, á wuk.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />“Anv, m bahke koko ane ba li anv gara jen? Bo li ana abonse ba ma lohng elatahkgur kpi mbene lim. Egom jindiki tong egom jehko re,<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />“ ‘Wahr ebwor afiri ka-n,</para>
  <para style="q1" vid="MAT 11:17">ḿ bahnem.</para>
  <para style="q1" vid="MAT 11:17">Wahr ebling aling,</para>
  <para style="q1" vid="MAT 11:17">wahn tobem ling fvfo.’<verse eid="MAT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 11:18" />“Eji Jon ba no, á jo kono elne njal bade, amahm á joom wo. Ane re, á kpi ebi etohko go ege atahng. <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Eji Mmon no nne ba no, á jo li nsol, fere jo wꞌwo, ane jo bungu re, ‘Nyehnen nlehke ebno noa, no kpo wo amahm, á li ntem no abakokatak, a aneb abꞌbi!’ Nne lꞌkpur nsol nyi aneb elkahne kpo lim, owo á bahke tob kahn ana elkahne li no.”<verse eid="MAT 11:19" /></para>
  <para style="s">Ajahbe nya ki taame</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luk 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Jisos kehm kehme ajahbe nya á ma ga lim akpokosi gbalee ebi ka, tibre bo ka gbo ndon.<verse eid="MAT 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 11:21" />“Eyuu a nahne, aneb Korasin! Eyuu a nahne, aneb Betsaida! Li re Taya, a Saidon nyehne agburu akpokosi ana nya wahn ma nyehn a, kehn bo jol gboko ndon wuku wuku, fere kak ajakensol, kpu atong, kak esi.<note caller="+" style="f"><char style="fr" closed="false">11:21 </char><char style="ft" closed="false">Mak 8:22-25</char></note> <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Wo, n kp-n tongo re, Efung elam bio, elam nehm ga bib a bo ana bahke bibi a nahne.<verse eid="MAT 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 11:23" />“Wahn aneb Kapenium, bo ma-n mehl wahre rehng go ejahbetul Esowo.<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">Mat 4:13; 8:5-17</char></note> Bo bahke fere rod-n, ro kak go ellulagun. Li re aneb Sodom nyehne agburu akpokosi ana nya ḿ ma nyehn a, kehn bo baa, kpeke li tete sik anv.<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">Mat 10:15</char></note> <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Owo n kp-n tongo re, Efung elam bio, elam nehm ga bib a Sodom ana bahke bibi a nahne.”<note caller="+" style="f"><char style="fr" closed="false">11:24 </char><char style="ft" closed="false">Luk 12:48</char></note><verse eid="MAT 11:24" /></para>
  <para style="s">Baan go egame, wahn ba bel erekekv</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luk 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Ngare nyio Jisos kehm bungu re, “Nsoo, wo wo li Ntul go ero, a ndi. N kp-a tehke, tib eji a ma lennge abonbili nsol nyia nyi a behre re akahnkahn ane, a anebkul kꞌnyehn.<note caller="+" style="f"><char style="fr" closed="false">11:25 </char><char style="ft" closed="false">1 Kor 1:26-29; 2 Kor 4:3</char></note> <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Tibre kor-a na re wo lim ano, Nsoo.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />“Nsoo ebyake ejum ajehng ajehng kak go egame abo.<note caller="+" style="f"><char style="fr" closed="false">11:27 </char><char style="ft" closed="false">Mat 28:18</char></note> Nnene limm, no kpꞌkahne Mmon, sehngem Nde ntahngtahng wo kp-e kahne. Nnene limm, no kpꞌkahne Nde, sehngem Mmon ntahngtahng wo kp-e kahne, a nne awohng awohng no Mmon kpꞌsebe re á lennge Nde tib-e.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />“Baan go egame, wahn ane kpee ba ma lahng go elsolo nsol nyi kpꞌlubu. M bahk-n kake erekekv.<note caller="+" style="f"><char style="fr" closed="false">11:28 </char><char style="ft" closed="false">Hib 4:10-11</char></note> <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Taamen, wahn woom-m go elwo, fere jo kpili go egame. Tibre me n li soom, fere jol reed. Owo atohko enyahne bahke bele erekekv. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Tibre eltum ename riidem. Elsol ename ni m bahk-n sehke kpꞌyaare.”<note caller="+" style="f"><char style="fr" closed="false">11:30 </char><char style="ft" closed="false">1 Jon 5:3</char></note><verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Mbahbe nyi li bade efung Esabat</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mak 2:23-28</ref>; <ref loc="LUK 6:1-5">Luk 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Ngare nyio eji Jisos jo jen go mbang egbe efung Esabat, abatꞌtoono ebe njal yꞌyam bo. Bo kehm kehme amohk nkohl monngo tv go arahn, jo li.<verse eid="MAT 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 12:2" />Eji Bab Farisi nyehne ano, bo kehm tongo Jisos re, “Nyehn ana abatꞌtoono eba kpꞌlimi ejum ji ki fuumu re nne lim efung Esabat!”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Jisos kehm faange bo re, “Ń ka lung a lung bade ana Devid njal yam-e no, a ane ebea? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Á song yele ekpꞌkpa Esowo, song li abred nya bo limi no bum go ekpꞌkpa Esowo jio, nya ki tohko fꞌfuumu re á li, a ane ebe, sehngem abalimajom ba ba fuumu re bo jo li. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Ń ka lung a lung go atahm nya Moses re, efung Esabat abehng abehng abalimajom ba kpo lim eltum go etahk Esowo kpo sꞌsoodo ntahm nyi Esabat, jol ntahm nyio bo joom gbo.<verse eid="MAT 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 12:6" />“N kp-n tongo re, Ejum jia, ji gbale sehnge etahk Esowo.<note caller="+" style="f"><char style="fr" closed="false">12:6 </char><char style="ft" closed="false">Jon 2:21</char></note> <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Li re ń kpꞌkahne ana edi nwer Esowo jia lohngo no, ji bungu re, ‘Njom sang n kpꞌsebe, ndon nyi’, kehn ń kpehme ka ane ba ki gbo ntahm ebi.<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">Mat 9:13</char></note> <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Tibre Mmon no nne tob li nfono Esabat.”<verse eid="MAT 12:8" /></para>
  <para style="s">Nne no ebo ebe lohngo no</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mak 3:1-6</ref>; <ref loc="LUK 6:6-11">Luk 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Jisos kehm tahme edi jio, song rehng go etahk ero ajehng. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Nne jolo o, no ebo ebe lohngo no. Bo kehm bahbe Jisos re, “Anv, nꞌnob re nne lim ane, bo nob ayam ebo efung Esabata?” Tibre bo jo sebe ejum ji bo bahke koko ka Jisos ebi.<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Owo Jisos kehm tongo bo re, “Anv, nne awohng ewahne lꞌbel njoro, njoro nyio lꞌfere gbo yel go elbing efung Esabat, á nehm song yehk-ea? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Anv, nne sang ga gbal sehnge njora? Ano wo wahng ka atahm enyahre bungu re, nne jo lim nnoobo efung Esabat.”<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Owo á kehm tongo nne noo re, “Tanne ebo eba!” Á kehm tanne ebo, ebo fere feere ana wuku wuku, nob kpee ana ebo behko.<verse eid="MAT 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 12:14" />Bab Farisi kehm soro tahm, song lam kak-e, ana bo bahk-e wulu.<note caller="+" style="f"><char style="fr" closed="false">12:14 </char><char style="ft" closed="false">Jon 5:16</char></note><verse eid="MAT 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Eji Jisos sebe ano kahn, á kehm tahme eje. Ane gbalee kehm tahme toon-e. Á limi bo kpee, bo nob ayam ebo. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Á tongo bo re, bo kꞌtooro tong ane bako bada ne, <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />eji lꞌlohko jol ana Esowo bungu sehng go nnyo mi nnyehnamahr Aisaya re,<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Nyehnee, a wo li nlokeltum ewame no m ma yehke.</para>
  <para style="q1" vid="MAT 12:18">Akor-m ejame ji kpo kor-m sꞌsehng.</para>
  <para style="q1" vid="MAT 12:18">M bahk-e kake etohko ejame.</para>
  <para style="q1" vid="MAT 12:18">Á bahke jo tiingi ane baka baka elam ejame.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Á nehm jo taange ntaange, fere jo rabe.</para>
  <para style="q1" vid="MAT 12:19">Bo nehm jo wuk ewok eje go nla ejahbe.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Eljele ni ma bahne, á nehm wob.</para>
  <para style="q1" vid="MAT 12:20">Etꞌrekahng ji kpꞌrede ellulu,</para>
  <para style="q1" vid="MAT 12:20">á nehm lahme,<note caller="+" style="f"><char style="fr" closed="false">12:20 </char><char style="ft" closed="false">Mak 2:17</char></note></para>
  <para style="q1" vid="MAT 12:20">tete etingitingi ba ko nji.<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />Go ege a mbing wo ane baka baka bahke jo kunu ekpu.”<note caller="+" style="f"><char style="fr" closed="false">12:21 </char><char style="ft" closed="false">Mat 8:11</char></note><verse eid="MAT 12:21" /></para>
  <para style="s">Jisos abola ntul a nnehm</para>
  <para style="r">(<ref loc="MRK 3:20-30">Mak 3:20-30</ref>; <ref loc="LUK 11:14-23">Luk 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Ane bandiki kehm koko nwakamahr nyi ki jo ma bung, ba a ne, nyi bele ebi etohko go ege atahng. Jisos kehm limi nne noo, á nyehn, fere bung.<verse eid="MAT 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 12:23" />Ellong ane bao kehm kpoko bo esi. Bo kehm bungu re, “Anv, mmon a Devid wo aa?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Bab Farisi wuku kan a me, bo kehm bungu re, “Á kpo kam ane abi atohko yehke tib go nsahm nyi Belsebul, ntul a nnehm ka-e no.”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Jisos kꞌkahn ntir atahng ebo, kehm tongo bo re, “Ejahbe ajehng ajehng ji lꞌyab, jol ebo ebo, bahke tane na. Nfam anyehng anyehng nyi lꞌyab, jol ebo ebo, afi fere jol nlaaga, nehm yiimi. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Nnehm lꞌkam nnehm yake go, lohngo re eblehm ebyab. Ejahbetul eje bahke yiimi renan?<verse eid="MAT 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 12:27" />“Lꞌfere jol re, n kpo kam ane abi atohko yehke go nsahm nyi ntul a nnehm, anv abon ebahne kpo kam bo yehke go nsahm anyii?<note caller="+" style="f"><char style="fr" closed="false">12:27 </char><char style="ft" closed="false">Luk 9:49; Elt 19:13</char></note> Owo wahng ka bo bahke jolo ane ba bahk-n lame. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />N kpo kam ane abi atohko yehke go nsahm nyi etohko ji Esowo, eblohng re, Esowo ebbadde ba go egahne, a etul etul ebe.<note caller="+" style="f"><char style="fr" closed="false">12:28 </char><char style="ft" closed="false">1 Jon 3:8</char></note> <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />Nnene limm, no bahke ma wa etahk etahntahn nne yel, song kpu nsol enye tahm a nyi, sehngem re no, á tohko gbo mbang gba etahntahn nne jio alehke, á kehm ma yel, song kpu nsol enye.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />“Nne no ki li ka me, á li nnekv ewame. Nne no tohk-m tob elkpiimi, no lun á kpꞌfare na faade. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Owo wahnge n kp-n tongo re, ane bahke ma bel eltahmeka go bo abiafem anyehng anyehng nya bo limi no, a ebꞌbi ajehng ajehng ji bo bungu no, sehngem abꞌbi nya bo kpo bung bade Etingi Etohko, nya nya bo lꞌkꞌtiki bel eltahmeka.<note caller="+" style="f"><char style="fr" closed="false">12:31 </char><char style="ft" closed="false">Jon 16:7-9; 1 Tim 1:13</char></note> <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Nne awohng awohng no lꞌbung ebꞌbi bada Mmon no nne, á bahke bele eltahmeka. Nne awohng awohng no lꞌbung ebꞌbi bade Etingi Etohko, á nehm bel eltahmeka, jol eying jia ji anv, afi fere jol eying ji kpꞌbake.<verse eid="MAT 12:32" /></para>
  <para style="s">Eti, a akab enye</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luk 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />“Re wahn kehm jo bong anoobo akab nti, lohngo re ḿ bahke bahme na nnoobo eti. Ń lꞌbahm ebi eti, ḿ bahke bongo abi akab. Tibre go akab nya kabe no nya, bo bahke liingi eti jio. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Wahn ane ba li ana akumbad ba! Ḿ bahke ma bung anoobo nsol renan, eji ń li abꞌbi abꞌbi? Tibre nsol nyi ma rur nne go ege eltim, nyi nyi nne kpo bung go ege a nnyo. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Nnooba nne kpo yehke anoobo nsol nya wob-e go ege atahng. Ebi nne kpo yehke abi nsol nya wob-e go ege atahng. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />N kp-n tongo re, Efung elam bio, nne awohng awohng, Esowo bahk-e bahbe bade ellum anehng anehng ni á bungu no, ni ki lohng ejumjum.<note caller="+" style="f"><char style="fr" closed="false">12:36 </char><char style="ft" closed="false">Jems 1:19; Ef 5:4</char></note> <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Tibre Esowo bahke koko alum enya nya a bungu no, lam-a.<note caller="+" style="f"><char style="fr" closed="false">12:37 </char><char style="ft" closed="false">Luk 19:22</char></note> Fundiki a bahke lehke eno. Fundiki a bahke lehke ebi.”<verse eid="MAT 12:37" /></para>
  <para style="s">Ana bo sebe re bo nyehn nkpokosi</para>
  <para style="r">(<ref loc="MRK 8:11-12">Mak 8:11-12</ref>; <ref loc="LUK 11:29-32">Luk 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Egom Farisi, a atꞌtibi ba atahm bandiki kehm tongo Jisos re, “Ntꞌtibi, e kpꞌsebe re wo lim nkpokosi, wahr nyehn.”<note caller="+" style="f"><char style="fr" closed="false">12:38 </char><char style="ft" closed="false">Mat 16:1; 1 Kor 1:22</char></note><verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Á kehm faange bo re, “Abi ane ba li anv, ba ma sennge Esowo njahm kpꞌsebe re bo nyehn nkpokosi. Jol nkpokosi anyehng anyehng bo nehm nyehn, sehngem nkpokosi ana nyi nnyehnamahr a Jona nyi nyi bo bahke nyehne. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Tibre, ana Jona kange ala nnyam alahb nfung era, ano wo fvfo Mmon no nne bahke tob kang atahng ndi nfung era.<note caller="+" style="f"><char style="fr" closed="false">12:40 </char><char style="ft" closed="false">Rom 1:4</char></note><verse eid="MAT 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 12:41" />“Go efung elam bio, aneb Ninive bahke mehle yiimi, ka ane ba li anv ebi. Tibre bo gbꞌgbo ndon go bo abiafem, eji bo wuku alum Esowo nya Jona bungu no.<note caller="+" style="f"><char style="fr" closed="false">12:41 </char><char style="ft" closed="false">Mat 11:20-24</char></note> Nyehnen ga, a wo li nne no ga gbal sehnge Jona. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Go efung elam bio, ntul a nnenkal no Seba bahke mehle yiimi, ka ane ba li anv ebi. Tibre á lohngo nlaabambang ejahbe ba goji Solomon re á ba wuk elkahne ene. Nyehnen ga, a wo li nne no ga gbal sehnge Solomon.<note caller="+" style="f"><char style="fr" closed="false">12:42 </char><char style="ft" closed="false">Mat 12:6</char></note><verse eid="MAT 12:42" /></para>
  <para style="s">Ana ebi etohko kpo feere, ba yel nne</para>
  <para style="r">(<ref loc="LUK 11:24-26">Luk 11:24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“Ebi etohko lꞌlohng nne, á kpo yannge go adi nya kpꞌwaange, jo seb edi ji á bahke reke ekv, á nehm tiki ting.<note caller="+" style="f"><char style="fr" closed="false">12:43 </char><char style="ft" closed="false">2 Pit 2:17</char></note> <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Owo ebi etohko jio bahke kehm bungu re, ‘M bahke feere go etahk ji n lohng no abake.’ Á lꞌfeere song nyehn etahk jio, li nehme nehme, bo ma feenge kpee, tuungu kpee bum, <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />owo á bahke tahme, song ko atohko nyako na asehma ba a nya, nya sahb bꞌbib sehnge ye. Bo feere ba lene etahk jio. Nne noo bahke kpe sab na sehnge ana wuku wuku. Ano wo fvfo bahke tob jol ka abi ane ba li anv.”<note caller="+" style="f"><char style="fr" closed="false">12:45 </char><char style="ft" closed="false">2 Pit 2:20</char></note><verse eid="MAT 12:45" /></para>
  <para style="s">Nnyehn Jisos, a abonanyehn Jisos</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mak 3:31-35</ref>; <ref loc="LUK 8:19-21">Luk 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Ngare nyi Jisos kpi mbungu mbungu a ane bao, nnyehn kehm lohngo ba, a abonanyehn.<note caller="+" style="f"><char style="fr" closed="false">12:46 </char><char style="ft" closed="false">Mat 13:55</char></note> Bo yiimi go elatahk, jo seb re bo bung a ne. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Owo nne awohng kehm tongo Jisos re, “Nyehnee, nne, a abonane yim go elatahk kpꞌsebe re bo bung a na.”<note caller="+" style="f"><char style="fr" closed="false">12:47 </char><char style="ft" closed="false">Luk 2:49</char></note><verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Jisos kehm faange nne no tong-e no re, “Nne awo li nnee? Ane aba li abonanee?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Á kehm tono ebo tv abatꞌtoono ebe, kehm bungu re, “A wo li nnee. A wo li abonanee.<note caller="+" style="f"><char style="fr" closed="false">12:49 </char><char style="ft" closed="false">Jon 7:5</char></note> <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Tibre nne awohng awohng no lꞌlim ji Nsoo no li go ero kpꞌsebe re á lim, ye wo li mmonannee, a nnee.”<note caller="+" style="f"><char style="fr" closed="false">12:50 </char><char style="ft" closed="false">Rom 8:29</char></note><verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Elgan ni li bada mbahmgbe</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mak 4:1-9</ref>; <ref loc="LUK 8:4-8">Luk 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Efung bꞌnehm ona, Jisos kehm mehle go etahk, song ji go nkpe eto. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Eji ellong ane gbalee ba go ege, owo á kehm yele go egbang, song ji. Ane bao kpee yiimi go nkpe egbuk.<verse eid="MAT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 13:3" />Á ko ngaane, jo tong bo nsol gbalee re, “Nne jolo gona, no tahme no, song wohngo amohk nti enye go ege egbe. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Eji á jo wohngo, nyandiki gbo noongo go mbang. Nruk ba suudu kpee mele.<verse eid="MAT 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 13:5" />“Nyandiki gbo noongo go ndi nyi jolo atal atal. Abon ndi jolo ntiil. Amohk nti nyao gulu elmahnge. Tibre edi jio ndi gbalem. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Njul nyaare kan a me, akohdo nti nyao wuudu, fere kpo. Tibre alohk jolem.<verse eid="MAT 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 13:7" />“Nyandiki gbo kuumu go elkob akpiri. Akpiri nyao gbale, bulu akohdo nti nyao.<verse eid="MAT 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 13:8" />“Amohk nti nyako gbo noongo go nnooba ndi, kab akab. Atasok nyandiki jo jolo nkab atahl alon alon, atasok nyandiki nkab atahl ara ara, atasok nyandiki eltahl a nkab ewubu eltahl a nkab ewubu.<verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />“Nne no kpi atung, nong, á wuk!”<note caller="+" style="f"><char style="fr" closed="false">13:9 </char><char style="ft" closed="false">Mat 13:18-23</char></note><verse eid="MAT 13:9" /></para>
  <para style="s">Ji wahnge Jisos jo tꞌtuubu ngaane</para>
  <para style="r">(<ref loc="MRK 4:10-12">Mak 4:10-12</ref>; <ref loc="LUK 8:9-10">Luk 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Owo abatꞌtoono Jisos kehm bake go ege, ba bahb-e re, “Jen ji wahnge a kpo ko ngaane, jo bung a bo?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Jisos kehm faange bo re, “Bo ma-n ka elkahne nio ni etul bi Esowo, bi Esowo behre no. Ane bao, bo kaam bo. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Nne no kpi no, bo bahk-e budu na, á bel gbalee. Nne no ki kpi, bo bahk-e taare na ji á kpi no.<note caller="+" style="f"><char style="fr" closed="false">13:12 </char><char style="ft" closed="false">Mat 25:28</char></note> <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Owo wahng ka n kpo bung a bo go ngaane. Tibre bo kpo seenge, jol bo kpehme nyehn. Bo kpo wuungu atung, jol bo kpehme wuk, fere kahn.<verse eid="MAT 13:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14" />Bo ba li ane ba nnyehnamahr Aisaya bungu no bada bo re,</para>
  <para style="q1" vid="MAT 13:14">“ ‘Ḿ bahke wuungu na wuungu wuungu atung,</para>
  <para style="q1" vid="MAT 13:14">ń nehm tiki kahn.</para>
  <para style="q1" vid="MAT 13:14">Ḿ bahke seenge na seenge seenge,</para>
  <para style="q1" vid="MAT 13:14">ń nehm tiki nyehn.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Tibre asi ane bao ebfere tahne.</para>
  <para style="q1" vid="MAT 13:15">Bobsahde atung ebo.</para>
  <para style="q1" vid="MAT 13:15">Bobbulu amahr ebo.</para>
  <para style="q1" vid="MAT 13:15">Ki li ano, kehn, bo kpꞌnyehne, fere wuk,</para>
  <para style="q1" vid="MAT 13:15">fere kꞌkahn go bo a ntim, fere sennge,</para>
  <para style="q1" vid="MAT 13:15">feere go egame, eji n lꞌlim bo, bo nob.’<note caller="+" style="f"><char style="fr" closed="false">13:15 </char><char style="ft" closed="false">2 Tes 2:11-12</char></note><verse eid="MAT 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Elfuulu li ka amahr enyahne, eji kpꞌnyehne. Elfuulu li ka atung enyahne, eji kpꞌwuku. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Etingitingi, n kp-n tongo re, Abanyehnamahr gbalee, a aneb Esowo gbalee jo sebe re bo nyehn ji ń kpꞌnyehne a. Jol bo tikem nyehn. Bo jo sebe re bo wuk ji ń kpꞌwuku a. Jol bo tikem wuk.<note caller="+" style="f"><char style="fr" closed="false">13:17 </char><char style="ft" closed="false">Luk 10:23-24</char></note><verse eid="MAT 13:17" /></para>
  <para style="s">Ana Jisos lennge elgan ni li bada mbahmgbe</para>
  <para style="r">(<ref loc="MRK 4:13-20">Mak 4:13-20</ref>; <ref loc="LUK 8:11-15">Luk 8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“Wuungen atung anv, wahn kahn ana elgan ni li bada mbahmgbe lohngo no.<verse eid="MAT 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 13:19" />“Ane ba lꞌwuk alum nya etul bi Esowo, kꞌkahn ana lohngo no, Ebinne bahke bake, ba yehke nsol nyi bo ma bahm go bo a ntim tahm a nyi. Nyao nya li amohk nti nya gbo noongo go mbang.<verse eid="MAT 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 13:20" />“Ane bandiki li ana amohk nti nya gbo noongo go ndi nyi jolo atal atal. Bo lꞌwuk alum Esowo nyao o, bo ko tvtv a eyebatahng. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Eji bo ki kpi alohk, bo kpehme kang. Erem lꞌba, a ntong tib go alum Esowo nya bo wuku no, bo soro gbo tvtv.<verse eid="MAT 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 13:22" />“Ane bandiki li ana amohk nti nya fooro gbo go elkob akpiri. Bo kpꞌwuku alum Esowo, wo, nsol nyi njini nyia kpo gbiingi bo go bo a ntim. Ekor akpohko kpo nehm bo.<note caller="+" style="f"><char style="fr" closed="false">13:22 </char><char style="ft" closed="false">1 Tim 6:9</char></note> Nsol nyia kpee kpo bulu alum Esowo nyao tv. Akab bo nehm kab.<verse eid="MAT 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 13:23" />“Ane bako li ana amohk nti nya bo wohngo go nnooba ndi.<note caller="+" style="f"><char style="fr" closed="false">13:23 </char><char style="ft" closed="false">Elt 17:11</char></note> Bo lꞌwuk alum Esowo kahn, bo lohko kab akab, egom jindiki nkab atahl alon alon, egom jindiki nkab atahl ara ara, egom jindiki eltahl a nkab ewubu eltahl a nkab ewubu.”<note caller="+" style="f"><char style="fr" closed="false">13:23 </char><char style="ft" closed="false">Gal 5:22</char></note><verse eid="MAT 13:23" /></para>
  <para style="s">Elgan ni li bade agasame</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Jisos kehm kpe tub bo elgan nehko re, “Etul bi Esowo li ana nne no tahme song kak nkohl go ege egbe. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Eji ane ma lal, nnekv ewe kehm tahme song wohngo afem agasame semme go nkohl nyio, tahm eje. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Eji nkohl ma mahng, gbal, fere lake abon, agasame kehm tob mahng. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Owo alokeltum ba nfono egbe noo kehm ba bahb-e re, ‘Nsoo, nkohl sang a kake go ega egbea? Anv, agasame nyao lohngo gan ba?’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Owo á kehm tongo bo re, ‘Nnekv wo ma lim ejum jio.’ Alokeltum bao kehm-e bahbe re, ‘Anv, a kpꞌsebe re wahr song wooba?’ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Á kehm tene re, ‘Eꞌee, ń lꞌsong woobo agasame, ḿ bahke woobo nkohl semme. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Nong, nsol ebal ebal gbal ano tete rehng go efung elbanne. Owo m bahke tongo ababꞌbanne re, Gboon mbang, wahn tohko woobo agasame, gba agan agan, eji bo lꞌjahm fi, wahn kehm banne nkohl kanne, kpu song kpake go egame etahk.’ ”<note caller="+" style="f"><char style="fr" closed="false">13:30 </char><char style="ft" closed="false">Mat 13:37-43</char></note><verse eid="MAT 13:30" /></para>
  <para style="s">Elgan ni li bada mmohk asia</para>
  <para style="r">(<ref loc="MRK 4:30-32">Mak 4:30-32</ref>; <ref loc="LUK 13:18-19">Luk 13:18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Jisos kehm kpe tub bo elgan nehko re, “Etul bi Esowo li ana mmohk asia nyi nne ko no, song bahm go ege etahngga. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Se sehnge mmohk eti anyehng anyehng.<note caller="+" style="f"><char style="fr" closed="false">13:32 </char><char style="ft" closed="false">Fil 2:8</char></note> Eji gbale no, gbale sehnge eti ajehng ajehng ji bo kpo bahm etahngga.<note caller="+" style="f"><char style="fr" closed="false">13:32 </char><char style="ft" closed="false">Jon 12:24</char></note> Owo nruk kehm bake, ba si ntahk o.”<note caller="+" style="f"><char style="fr" closed="false">13:32 </char><char style="ft" closed="false">Elt 20:29-30; Mat 13:30</char></note><verse eid="MAT 13:32" /></para>
  <para style="s">Elgan nyi li bade ayist</para>
  <para style="r">(<ref loc="LUK 13:20-21">Luk 13:20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Jisos kehm kpe tub bo elgan nehko re, “Etul bi Esowo li ana ayist,<note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="ft" closed="false">Mak 8:15; 1 Kor 5:6-8</char></note> nya nnenkal ko song behr go ebam aflawa na ebra tete semme kpee, fere tung.”<note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="ft" closed="false">Mat 13:30</char></note><verse eid="MAT 13:33" /></para>
  <para style="s">Ana Jisos lennge elgan ni li bade agasame</para>
  <para style="r">(<ref loc="MRK 4:33-34">Mak 4:33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Nsol nyia kpee, Jisos jo bungu go ngaane, tong ellong ane. Á joom tiki bung na bung, kꞌbung go elgan, <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />eji lꞌlohko jol ana nnyehnamahr bungu no re,</para>
  <para style="q1" vid="MAT 13:35">“M bahke jo bung a bo go ngaane.</para>
  <para style="q1" vid="MAT 13:35">M bahke tongo bo nsol nyi Esowo behre no ngare nyi njini bomo no.”<verse eid="MAT 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Jisos kehm tahme ellong ane bao sa, song yel ekpꞌkpa. Abatꞌtoono ebe kehm bake go ege, ba bahb-e re, “Tong-r ana elgan ni li bade agasame lohngo no.”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Owo Jisos kehm faange re, “Nne no kake nkohl, Mmon no nne wo. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Edi egbe jio, njini nyi. Nkohl nyio, abon Ntul ba. Agasame nyao, abon ba Ebinne jio ba. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Nnekv no wohngo afem agasame, nnehm nyi. Ngare elbanne nyio, esꞌkohro eying jia ji. Ababꞌbanne bao, babenjel ba.<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />“Ana bo bahke kpuku agasame nyao, jamme fi, ano wo bahke jolo esꞌkohro eying jia. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Owo Mmon no nne bahke tumu enjel enye,<note caller="+" style="f"><char style="fr" closed="false">13:41 </char><char style="ft" closed="false">Mat 25:31-46</char></note> bo bahke yannge go ege ejahbetul, kpu ane kpee ba jo wahng re ane jo lim abiafem, a aneb abꞌbi, <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />ro bo, kak go agun. Owo bo bahke woomo, jo ling, fere jo kono amahn. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Aneb Esowo bahke jo ya ana njul go ejahbetul ji Nde ebo.</para>
  <para style="p" vid="MAT 13:43">“Nne no kpi atung, nong, á wuk.<verse eid="MAT 13:43" /></para>
  <para style="s">Elgan ni li bade elkohl akpohko</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“Etul bi Esowo tob li ana elkohl akpohko ni bo behre edi egbe.<note caller="+" style="f"><char style="fr" closed="false">13:44 </char><char style="ft" closed="false">1 Pit 1:7; Kol 3:3</char></note> Nne awohng kehm song nyehn, tuungu behr. Á bele eyebatahng sehng, kehm song gungu nsol enye kpee nyi á bele no,<note caller="+" style="f"><char style="fr" closed="false">13:44 </char><char style="ft" closed="false">Fil 2:6-8</char></note> fere ba gunu edi egbe jio.<note caller="+" style="f"><char style="fr" closed="false">13:44 </char><char style="ft" closed="false">Ell 5:9</char></note><verse eid="MAT 13:44" /></para>
  <para style="s">Elgan ni li bada mmohkesol</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />“Etul bi Esowo tob li ana njenare no jo seb anoobo amohkesol. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Eji á nyehne anyehng nyi sahb kꞌkim ekun, fere nꞌnob, owo á kehm soro tahm, song gungu nsol enye kpee, nyi á bele no, fere ba gunu mmohkesol nyio.<verse eid="MAT 13:46" /></para>
  <para style="s">Elgan ni li bade erim</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“Etul bi Esowo tob li ana erim bi bo ma kak go aya, fere bob nsahre go nkohn a nkohn.<note caller="+" style="f"><char style="fr" closed="false">13:47 </char><char style="ft" closed="false">Mat 22:9-10</char></note> <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Eji nsahre ma rur, bo kehm tohngo, bum egbuk.<note caller="+" style="f"><char style="fr" closed="false">13:48 </char><char style="ft" closed="false">Mat 24:14</char></note> Owo bo kehm jehke, kehm kehme nsahre jak. Nyi nno, bo jo kake go ajeere. Abi nsahre, bo ro go. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Ano wo bahke jolo go esꞌkohro eying jia. Babenjel bahke bake, ba jak abi ane go ellong anoobo ane, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />fere ro bo kak agun. Owo bo bahke woomo, jo ling, fere jo kono amahn.”<note caller="+" style="f"><char style="fr" closed="false">13:50 </char><char style="ft" closed="false">Elt 10:35; 1 Kor 6:9-11</char></note><verse eid="MAT 13:50" /></para>
  <para style="s">Akꞌkulu nsol, a nsol nfenfe</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Jisos kehm bahbe bo re, “Anv, nsol nyia lenng-n lennga?” Owo bo kehm-e faange re, “Ee nsoo.” <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />Á kehm tongo bo re, “Owo wahnge ntꞌtibi no atahm awohng awohng no ma jol ntꞌtoono Esowo, no ma kpili bade etul bi Esowo, á li ana nfontahk no kpo yehke nsol afang enye go elkohl, nyindiki nsol nfenfe,<note caller="+" style="f"><char style="fr" closed="false">13:52 </char><char style="ft" closed="false">Jon 13:34</char></note> nyindiki akꞌkulu nsol.”<note caller="+" style="f"><char style="fr" closed="false">13:52 </char><char style="ft" closed="false">1 Tim 1:8; Rom 7:12,14</char></note><verse eid="MAT 13:52" /></para>
  <para style="s">Ana bo tene Jisos go Nasaret</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mak 6:1-6</ref>; <ref loc="LUK 4:16-30">Luk 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Eji Jisos tuubu ngaane nyio kpee mal, owo á kehm tahme edi jio, <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />song rehng go ege ejahbe, song kehme bo tib go bo etahk ero.</para>
  <para style="p" vid="MAT 13:54">Ane ba wuk-e no, jo kpo bo esi sehng, bo kehm bahbe re, “Gan wo á bele elkohn elkahne ana nia, a nsahm nyi á kpo ko lim agburu akpokosi nyaa?<note caller="+" style="f"><char style="fr" closed="false">13:54 </char><char style="ft" closed="false">Jon 7:15</char></note> <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Ye sang li mmon a kapentaa? Nnyehn sang bo kpo lung-e re Meria? Abonanyehn sang bo kpo lung bo re Jems, Joses, Saimon a Judasa? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Abonanyehn ba nkal sang li a nahre a kpeea? Anv, gan wo á bele bel nsol nyio kpee?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Owo bo kehm-e tene.</para>
  <para style="p" vid="MAT 13:57">Jisos kehm tongo bo re, “Nnyehnamahr, bo kpo kak-e edi ajehng ajehng, sehngem ane ebe, a ejahbe eje ji kil jo kak-e.”<note caller="+" style="f"><char style="fr" closed="false">13:57 </char><char style="ft" closed="false">Jon 4:44</char></note><verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Á limem akpokosi gbalee ejahbe jio tib go bo ekꞌtaame.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Ana Jon ji nwohngalahb kpo no</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mak 6:14-29</ref>; <ref loc="LUK 9:7-9">Luk 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Ngare nyio Herod ji jolo ntul a Galili kehm wuku bada Jisos.<verse eid="MAT 14:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 14:2" />Owo á kehm tongo alokeltum ebe re, “Jon ji nwohngalahb wo ona ma nyahme go elkv. Ano wo wahnge á kpi egburu nsahm ana nyio nyi kpo mehl-e.”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Tibre Herod bobo Jon, gba-e, kak go ngbekobo tib esi ji Herodias ji jolo nkal a Filip mmonannyehn.<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">Mat 11:2</char></note><verse eid="MAT 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 14:4" />Tibre Jon jo tong-e re, “Fuumem re a ko-e.” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Herod jo sebe re á wul-e. Á jo fahle Jus, tibre bo jo bumu Jon ana nnyehnamahr.<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="ft" closed="false">Mat 21:26</char></note> <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />Efung bi bo ji, buumu efung bi bo jele Herod, mmon no nkal no Herodias kehm kehme ase bahn go elkab ane nio. Herod, atahng yeb-e sehng, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />á kehm nyame, fere tꞌtir re, “M bahk-a kake ejum ajehng ajehng ji a lꞌbahb-m.”<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />Nnyehn kehm toobo a ne. Mmon noo kehm song tong Herod re, “Ka-m esi Jon ji nwohngalahb anv anv go ekpingi.”<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />Ntul kpeem bang, wo, tib go esi ji á tiri no go esamahr ane ba á tiingi bo elkak, owo á kehm tongo re bo lim ka-e ana á bahbe no. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Á kehm tumu ane, bo song kim Jon esi go ngbekobo, <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />ko esi jio go ekpingi ba a ji, ba ka mmon noo. Mmon noo kehm soro ko, song ka nnyehn. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Abatꞌtoono Jon kehm bake, ba rod ekv eje, song kpa kak, kehm feere song tong Jisos.<verse eid="MAT 14:12" /></para>
  <para style="s">Ana Jisos le ellong ane gbalee (5,000)</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mak 6:30-44</ref>; <ref loc="LUK 9:10-17">Luk 9:10-17</ref>; <ref loc="JHN 6:1-14">Jon 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Eji Jisos wuku eka jio bada Jon, owo á kehm tahme edi jio, song yel egbang antahng, song rehng edi ji li soom. Ellong ane ba wuku no, kehm tahme ajahbe ebo, jo jen egbuk egbuk, jo toon-e. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Jisos lohngo kan egbang me, á kehm nyehne ellong ane gbalee. Bo kehm-e fili ndon. Á kehm limi aneb ayam ebo, bo nob.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Eji elgung ma ba, abatꞌtoono ebe kehm song kpir-e, kehm-e tongo re, “Tahm edi jia ana rehng go ajahbe, ekidi kpꞌlabe. Wo gana, ngare ebsehng. Nong, ane baa song gunu nsol alehke go abon ajahbe li me.”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Owo Jisos kehm tongo bo re, “Bo sang bahke tahme song gunu nsol alehke li, wahn kaan bo nsol alehke, bo li.”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Owo bo kehm-e faange re, “Nsol nyi e kpi a kpee li abon abred na alon, kumu abon nsahre abal.” <figure style="fig" alt="5 loaves and 2 fishes" file="hk00155c.tif" size="col" loc="MAT 14.17" copy="Horace Knowles" ref="14:17">Ebred eblon kunu abon nsahre abal</figure><verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Jisos kehm tongo bo re, “Koon nsol nyio ba ka-m wahn!” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Owo á kehm tongo ane bao re, bo ji go ajele. Á kehm rodo abon abred bao na alon, a abon nsahre na abal, kehm kpiidi amahr enye go elbung, kak Esowo saam, fere bakke abon abred bao, ka abatꞌtoono ebe. Abatꞌtoono ebe ko, song bak ellong ane bao.<verse eid="MAT 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 14:20" />Bo li ane kpee wohngo. Abatꞌtoono ebe kehm song taare bo erik ji sa no, ruru ewubu ejeere na ebbal. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Aneblum ba li nsol nyio jolo ejum ane atahltahl nkpel ewubbal ane atahl awubu (5,000). Jol anebkal, a abonse, bo fangem bo.<verse eid="MAT 14:21" /></para>
  <para style="s">Ana Jisos jene go ero alahb</para>
  <para style="r">(<ref loc="MRK 6:45-52">Mak 6:45-52</ref>; <ref loc="JHN 6:15-21">Jon 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Jisos kehm tongo abatꞌtoono ebe re bo yel egbang, gbo-e mbang, song go egbuk jehko, ye samme ji, yaame ane bao. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Eji á ma yaame ane bao, owo á kehm tahme go ewong antahng re á song kak ero. Eji elgung ba no, Jisos noa, kpeke li go ntahngtahng.<note caller="+" style="f"><char style="fr" closed="false">14:23 </char><char style="ft" closed="false">Luk 6:12</char></note><verse eid="MAT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 14:24" />Ngare nyio egbang ebrehng go nlum alahb. Ebuku jo gbulu egbang bio tv edi ajehng ajehng. Tibre nfeb jo lohngo go bo a mbuksong. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Nkpese efungfu wo, Jisos jene ero alahb, song kpiri bo. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Eji abatꞌtoono ebe nyehn-e no á kpꞌjene go ero alahb, kehm mennge bo. Bo kehm bungu re, “Etohko ji,” fere rabe elfahle elfahle.<note caller="+" style="f"><char style="fr" closed="false">14:26 </char><char style="ft" closed="false">Luk 24:37</char></note><verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Jisos kehm soro bung a bo tvtv re, “Boben eltim, me wo, kana kpe fahl!”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Owo Pita kehm-e faange re, “Nsoo, lꞌlohko jol re wo wo, tong-m, me n lohng, jen go alahb, ba kpir-a!”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Jisos kehm-e tongo re, “Ba!” Pita kehm lohngo go egbang, kehm kehme eljene go ero alahb asongo goji Jisos.<note caller="+" style="f"><char style="fr" closed="false">14:29 </char><char style="ft" closed="false">Jon 21:7</char></note> <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Eji á nyehne re, nfeb nyio kpꞌlimi area, á kehm kehme elfahle, soro kehme eltere, kehm rabe re, “Nsoo, tahr-m!”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Owo Jisos kehm soro tanne ebo ebe, jabb-e kehm-e tongo re, “Wo ji kpꞌkahn taame ntiil, jen ji wahnge a kehm fꞌfaabe me?”<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Eji bo feere song yel go egbang, nfeb nyio kehm soro naange.<verse eid="MAT 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 14:33" />Ane ba woomo go egbang kehm ba jamm-e alahng, kehm bungu re, “Etingitingi, wo Mmon Esowo wo.”<verse eid="MAT 14:33" /></para>
  <para style="s">Ana Jisos limi aneb ayam, bo nob go Genesaret</para>
  <para style="r">(<ref loc="MRK 6:53-56">Mak 6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Bo kehm gohro siiri, song rehng go egbuk jehko ji Genesaret. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Ane bao liingi kan Jisos, bo kehm tiingi etib tv ajahbe kpee nya jolo o. Bo kehm koko aneb ayam kpee, ba a bo go ege. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Bo fere gboong-e re, á nong, aneb ayam lub koor-e go ege asꞌsili nsubu. Ane kpee ba koor-e no, bo nobo ayam ebo.<note caller="+" style="f"><char style="fr" closed="false">14:36 </char><char style="ft" closed="false">Mat 9:21; Luk 6:19</char></note><verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Eltibi ni anebkul jo tib</para>
  <para style="r">(<ref loc="MRK 7:1-13">Mak 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Atꞌtibi ba atahm, a egom Farisi jindiki kehm lohngo go Jeusalem ba goji Jisos, ba bahbe re, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Jen ji wahnge abatꞌtoono eba kpꞌdaange atahm nya babnsoo, tib eji bo kil jo ru abo, kehm jo li nsol?”<note caller="+" style="f"><char style="fr" closed="false">15:2 </char><char style="ft" closed="false">Luk 11:38</char></note><verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Owo á kehm faange bo re, “Jen ji wahnge ń kpo daange atahm Esowo, fere kpꞌtoono eljini nꞌnahne? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Tibre Esowo jehke ntahm re, ‘Jo kak nso, a nne!’ Nyehko kpe li re, ‘Nne no lꞌsu nde, afi jolo nnyehn, bo bahk-e wulu.’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Wahn kpo tib re, ‘Nne no lꞌbel ejum ji á jol kake nde ebo, afi jolo nnyehn, á lꞌfere bung re, Ejum jia li ka Esowo, kpeem li ka-e re, á kpe kak nde, a nnyehn.’<note caller="+" style="f"><char style="fr" closed="false">15:5 </char><char style="ft" closed="false">1 Tim 5:8</char></note> <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Eji ń kpo tib ana wo wahnge ḿ ma range ntahm nyi Esowo, fere kpꞌtoono eljini nꞌnahne. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Wahn aneb alum abal abal ba! Aisaya lohko nyehn enyehnamahr ji nno bada nahne, eji á bungu re,<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />“ ‘Ane baa kpo kak-m go nnyo a nnyo.</para>
  <para style="q1" vid="MAT 15:8">Ntim ebo n wobem.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Bo kp-m kake mbol mbol,</para>
  <para style="q1" vid="MAT 15:9">eji bo kpꞌtibi atahm nya ane baka baka jehke no,</para>
  <para style="q1" vid="MAT 15:9">nya ki li nya Esowo.’ ”<verse eid="MAT 15:9" /></para>
  <para style="s">Nsol nyi kpo lim eltim nne, kꞌjol saang</para>
  <para style="r">(<ref loc="MRK 7:14-23">Mak 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Jisos kehm lungu ellong ane tv elne, kehm tongo bo re, “Wuungen atung, wahn kahn! <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Ejum ji kpo yel nne go nnyo sang kpo lim eltim nne kꞌkpe jol saang.<note caller="+" style="f"><char style="fr" closed="false">15:11 </char><char style="ft" closed="false">1 Kor 8:8</char></note> Jio ji kpo lohng na go ege a nnyo, ji ji kpo lim eltim nne re kꞌkpe jol saang.”<note caller="+" style="f"><char style="fr" closed="false">15:11 </char><char style="ft" closed="false">Jems 3:6</char></note><verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Abatꞌtoono ebe kehm bake go ege, ba tong-e re, “Anv, a kpꞌkahne re, alum nya wuku a bungu no sꞌsab Bab Farisia?”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Owo á kehm faange re, “Eti ajehng ajehng ji Nsoo no li go ero ki bahm, bo bahke mehle na tub go. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Yaken na yake bo go! Bo li awakamahr atubesi! Nwakamahr lꞌseb re á tib ntem nwakamahr mbang, bo ane abal abal bahke gboko na, yel go elbing.”<note caller="+" style="f"><char style="fr" closed="false">15:14 </char><char style="ft" closed="false">Rom 2:17-24</char></note><verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Owo Pita kehm-e tongo re, “Tong-r ana elgan nia lohngo no!”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Jisos kehm faange re, “Wahn fvfo, ń nehme tob kahna? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Ń nehme kahn re, ejum ajehng ajehng ji lꞌyel nne go nnyo kpo sehng go ala, lohng go ngubjinga? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Nsol nyi kpo lohng nne go nnyo kpo lohng-e go eltim. Nsol nyio nyi kpo lim nne, kꞌkpe jol saang. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Tibre go eltim nne wo ebi ntir kpo lohng, a ewulane, erehbe alimi, anebkal akono, ejv avohko, ntianse efahnge, a afahnge akiimi lake ane. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Nsol nyia ana nyi kpo lim nne, kꞌkpe jol saang. Re nne li nsol kꞌru abo, we nehm ma lim á kꞌkpe jol saang.”<verse eid="MAT 15:20" /></para>
  <para style="s">Nnenkal no taame no</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mak 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Jisos kehm tahme edi jio, song rehng go ejang bi Taya, a Saidon.<verse eid="MAT 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 15:22" />Nnenkal a Kenan awohng no lohng ejahbe jio kehm bake go ege, ba rabe gboong-e re, “Nsoo, mmon no Devid, nong, me n fil-a ndon! Mmon ewame, ebi etohko wob-e go atahng, kp-e gbiingi sehng.”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Jisos we tikem faange.</para>
  <para style="p" vid="MAT 15:23">Abatꞌtoono ebe kehm bake go ege, ba gboong-e re, “Tong-e á song. Tibre á kpꞌrabe tob-r sehng.”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Owo Jisos kehm faange re, “Bo tum-m tv go ejoro bio bi Israel bi ma tan bi bi.”<note caller="+" style="f"><char style="fr" closed="false">15:24 </char><char style="ft" closed="false">Mat 10:6</char></note><verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Owo nnenkal noo kehm ba gbo go ege alata, kehm bungu re, “Nsoo, kak-m ebo!”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Owo Jisos kehm faange re, “Nobem re nne rod nsol alehke nyi abon, ka ebv.”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Nnenkal noo kehm taame re, “Ee nsoo, jol ebv kpo kpiimi akahb elang nya kpo fooro ekpꞌkuru nde ebo gbo.”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Owo Jisos kehm-e faange re, “Nnenkal, eltaame ena kpꞌgbale gbalee.<note caller="+" style="f"><char style="fr" closed="false">15:28 </char><char style="ft" closed="false">Luk 11:5-8; 18:2-8</char></note> Nong, lohko jol ana a kpꞌsebe.”</para>
  <para style="p" vid="MAT 15:28">Ngare nyꞌnehm ona nyi mmon ewe noo no nkal nobo eyam bio.<verse eid="MAT 15:28" /></para>
  <para style="s">Ana Jisos limi ane gbalee, bo nob</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Jisos kehm tahme edi jio, song rehng go eto jio ji Galili, kehm wahre go ewong, song ji. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Ellong ane gbalee kehm koko aneb ayam ba a bo goji Jisos. Bandiki jolo abanne, bandiki agboodo, bandiki awakamahr, bandiki akamme. Ane bako gbalee ba jo yame ayam nyandikandiki. Bo jo ba bumu aneb ayam bao go alata nya Jisos. Á jo lim bo, bo nob. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Jo kpo ane esi sehng, eji bo nyehne akamme kpꞌbungu, fere nyehn agboodo ma nob, fere nyehn abanne kpꞌjene, awakamahr fere jo nyehn. Bo kehm kehme Esowo bio bi Israel ellub ka.<note caller="+" style="f"><char style="fr" closed="false">15:31 </char><char style="ft" closed="false">Luk 7:16-22</char></note><verse eid="MAT 15:31" /></para>
  <para style="s">Ana Jisos kpe le ellong ane nehko (4,000)</para>
  <para style="r">(<ref loc="MRK 8:1-10">Mak 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Jisos kehm lungu abatꞌtoono ebe tv elne, kehm tongo bo re, “Ane baa ma-m fili ndon. Tibre nfung era nyi a, nyi bo ma kang a name. Anv, bo kpeem kpi ejum alehke ajehng ajehng. N nehme seb re me n yake bo, bo song njal njal. Fundiki bo bahke gboko awo go mbang.”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Owo abatꞌtoono Jisos kehm-e bahbe re, “Gan wo e bahke tingi nsol alehke elka emahng nia, kehm leke ellong ane ana nia?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Owo Jisos kehm bahbe bo re, “Abon abred abik ń kpi no?”</para>
  <para style="p" vid="MAT 15:34">Bo kehm-e faange re, “E kpi abon abred na asehma, kunu abon nsahre abik abik.”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Jisos kehm tongo ellong ane bao re, bo ji go ndi. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Á kehm rodo abon abred bao na asehma, a nsahre nyio, kehm kake Esowo saam, bakke, ka abatꞌtoono ebe, abatꞌtoono ebe kehm koko, song bak ane. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Bo li ane kpee wohngo. Abatꞌtoono ebe kehm taare bo erik ji sa no, ruru ejeere na ebsehma. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Aneblum ba li nsol nyio jolo ane atahltahl nkpel ewubu (4,000). Jol anebkal, a abonse, bo fangem.<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />Jisos kehm yaame ane bao re bo song kehnge, kehm yele egbang, song rehng go egbuk jehko ji Magadan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Ana bo sebe re bo nyehn nkpokosi</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mak 8:11-13</ref>; <ref loc="LUK 12:54-56">Luk 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Egom Farisi jindiki, a Bab Sadusi kehm bake goji Jisos re bo ba gar-e. Owo bo kehm-e tongo re, á lim nkpokosi nyi lohng go ejahbetul Esowo tib bo.<note caller="+" style="f"><char style="fr" closed="false">16:1 </char><char style="ft" closed="false">Mat 12:38</char></note><verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />Owo Jisos kehm faange bo re, “Ana wo ń kpo kono elbungu. Elgung lꞌba, eji elbung ma biili, ń re, ‘Elahb nehm na.’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Efungfu atv atv eji elbung ma biili, fere nyꞌnyak, ń re, ‘Elahb bahke nake.’ Ń kpo kahn ana elbung li no, joare elahb bahke nake, afi nehm na. Anv, nliingi nyi kpꞌtibi bada ngare ń nehme ma liinga?<note caller="+" style="f"><char style="fr" closed="false">16:3 </char><char style="ft" closed="false">1 Tes 5:1; Luk 2:12; Mat 24:3,30</char></note> <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Abi ane ba li anv, ba ma sennge Esowo njahm kpꞌsebe re bo nyehn nkpokosi. Jol nkpokosi anyehng anyehng bo nehm nyehn, sehngem nkpokosi ana nyio nyi nnyehnamahr Jona nyi nyi bo bahke nyehne.”</para>
  <para style="p" vid="MAT 16:4">Owo á kehm soro tahm bo sa o, tahm eje.<verse eid="MAT 16:4" /></para>
  <para style="s">Ayist nya Farisis, a nya Sadusis</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mak 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Eji abatꞌtoono Jisos siiri eto jio, song rehng egbuk jehko, ebred ajehng ajehng bo belem. Tibre bo yꞌyini, bo rodem. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Owo Jisos kehm tongo bo re, “Jo gberen, wahn jo kunu ekpu go ayist nyao nya Farisis, a nya Sadusis.”<note caller="+" style="f"><char style="fr" closed="false">16:6 </char><char style="ft" closed="false">Luk 12:1; Gal 5:9</char></note><verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Bo kehm kehme elbungu atemtem re, “Á bungu ellum nia a, tib eji e ki rod abred ba a nya.”<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Eji Jisos sebe kahn ana bo jo bung, á kehm bahbe bo re, “Wahn ane ba kpꞌkahn taame ntiil ba! Jen ji wahnge ń kpꞌbungu atemtem bade ana ń ki rod abred ba a nya? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Anv, ń ka tiki kahn naa? Anv, ń nehme kpe buumu ana m bakke abon abred bao na alon, ka ane atahltahl nkpel ewubbal atahl awuba? Anv, erik ji sa no, ji ń taare no, ruru ejeere ebbik? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Abon abred bao na asehma ba m bakke, ka ane atahltahl nkpel ewubu, erik ji sa no, ji ń taare no, ruru ejeere ebbik? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Jen ji wahnge ń kil tiki kahn re, n joom bung a nahne bade abred? Jo gberen elnahne tib ayist nya Farisis, a nya Sadusis.”<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Owo abatꞌtoono ebe kehm kahne re, Jisos jo tongo bo re, bo gbere eltibi nio ni Farisis, a ni Sadusis, bo kꞌgbere ayist nya bo kpo kak go abred.<verse eid="MAT 16:12" /></para>
  <para style="s">Ana Pita bungu bada Jisos</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mak 8:27-30</ref>; <ref loc="LUK 9:18-21">Luk 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Eji Jisos rehnge go ejang bi Sisaria Filipi, owo á kehm bahbe abatꞌtoono ebe re, “Anv, ane kpo bung renan bada Mmon no nne? Nne awo li Mmon no nne?”<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Owo bo kehm faange re, “Ane bandiki kpo bung re, wo Jon ji nwohngalahb wo. Ane bandiki bung re, wo Elaija wo. Ane bandiki re, wo Jeremaya wo, tohko jol ano nnyehnamahr nondiki wo.”<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Owo Jisos kehm bahbe bo re, “Anv, wahn kpo tir re, me n li elkohn nne awo?”<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Saimon Pita kehm faange re, “Wo wo li Mesaya ji Mmon no Esowo bi li go elkpin.”<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">Jon 6:69</char></note><verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Owo Jisos kehm-e faange re, “Eyebatahng li a na, Saimon, mmon a Jona. Ji a bungu a, nne sang tib-a na. Nsoo no li go ero wo ma lennge ka-a. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />N kp-a kpeke tong re, Wo wo li Pita (ji lohngo re eltal).<note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="ft" closed="false">Jon 1:42</char></note> Go ekpartal jia wo m bahke sehke etahk ero ejame.<note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="ft" closed="false">Ef 2:20</char></note> Jol elkv nehm ma rannge etahk jio. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />M bahk-a kake agbokoro nya ejahbetul Esowo.<note caller="+" style="f"><char style="fr" closed="false">16:19 </char><char style="ft" closed="false">Elt 15:7</char></note> Ji a lꞌgba go njini nyia, bobtob gba go ejahbetul Esowo. Ji a lꞌfannge go njini nyia, bobtob fannge go ejahbetul Esowo.”<note caller="+" style="f"><char style="fr" closed="false">16:19 </char><char style="ft" closed="false">Mat 18:18; Jon 20:23</char></note><verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Owo Jisos kehm tongo abatꞌtoono ebe re, bo kꞌtiki tong nne awohng awohng re, ye wo li Mesaya.<verse eid="MAT 16:20" /></para>
  <para style="s">Ana Jisos bungu bade erem ebe, a elkv ene</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">Mak 8:31-9:1</ref>; <ref loc="LUK 9:22-27">Luk 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Bomo ngare nyio asongo, Jisos kehm bomo abatꞌtoono ebe eltongo gbul gbul gbuul re, “M bahke jeke go Jeusalem, song nyehn erem gbalee, bi anebkul nfam, a atubesi abalimajom, a atꞌtibi ba atahm bahk-m kake. Bo bahk-m wulu. Lꞌkang nfung era, n nyahme go elkv.”<note caller="+" style="f"><char style="fr" closed="false">16:21 </char><char style="ft" closed="false">Jon 2:19,21</char></note><verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Pita kehm koko Jisos, tahm a ne go nkpohko, kehm-e rehke re, “Nsoo, Esowo kꞌtaame re ejum ana jia lim-a.”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Owo Jisos kehm sennge, tong Pita re, “Nnehm, fak-m go esamahr! Wo kp-m kpane. Tibre a kpo tir ntir nyehka nyehka nyi ane. A kpehme tir ntir nyi Esowo.”<note caller="+" style="f"><char style="fr" closed="false">16:23 </char><char style="ft" closed="false">Mat 4:10</char></note><verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Owo Jisos kehm tongo abatꞌtoono ebe re, “Nne awohng awohng no lꞌseb re á toon-m, nong á ten elne tv-m, fere rod ekros eje tahm toon-m. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Tibre nne awohng awohng no lꞌseb re á tahre elkpin ene, á bahke tane na elkpin ene. Nne awohng awohng no lꞌtane elkpin ene tib go egame esi, á bahke bele etingitingi elkpin. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Nsehng anyi nne bahke lehke, afi á gbo afang nya njini nyia kpee, fere tane etohko eje? Ejum aji nne bahke kake, kehm fake etohko eje?<note caller="+" style="f"><char style="fr" closed="false">16:26 </char><char style="ft" closed="false">Elt 8:18-20; 1 Pit 1:18-19</char></note><verse eid="MAT 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 16:27" />“Tibre Mmon no nne yahke ba elbake go ellub ni nde, a enjel enye. Owo á bahke tuuru nne awohng awohng jang jang ana á limi no.<note caller="+" style="f"><char style="fr" closed="false">16:27 </char><char style="ft" closed="false">Rom 2:6; Luk 19:16-19</char></note> <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Etingitingi, n kp-n tongo re, Egom ejahne jindiki jia ana, ji lꞌkꞌkpo tete bo nyehn Mmon no nne kpꞌbake ana ntul.”<note caller="+" style="f"><char style="fr" closed="false">16:28 </char><char style="ft" closed="false">Mat 17:2</char></note><verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Ana Jisos yaange ngubjing</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mak 9:2-13</ref>; <ref loc="LUK 9:28-36">Luk 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Eji ma kang nfung erakera, Jisos kehm yehke Pita, Jems, a Jon ji mmonannyehn a Jems. Bo kehm tahme bo bo, song wahr nwahrewahre ewong. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Eji bo jo seenge Jisos, á kehm yaange. Esamahr ebe fere jo ya ana njul. Nsol nyi á kake go ngubjing kehm bare kparaang. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Owo bo kehm soro nyehn Moses abola Elaija ma lohng ba, ba kehme elbungu a Jisos.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Pita kehm tongo Jisos re, “Nsoo, a wo li nnoobo edi ji fuumu re wahr jol. Lꞌkor-a, nong, wahr si nkpatahk era a, behko jol bꞌba, behko jol bi Moses, behko jol bi Elaija.”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Eji Pita kpi mbungu mbungu, ekparesemsem ji jo ya, kehm tahle ba bulu bo. Owo bo kehm wuku ellum go ekparesemsem jio re,</para>
  <para style="p" vid="MAT 17:5">“A wo li akor-m mmon ewame no kpo kor-m sꞌsehng. Wuken ye!”<note caller="+" style="f"><char style="fr" closed="false">17:5 </char><char style="ft" closed="false">2 Pit 1:16-18</char></note><verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Abatꞌtoono bao wuku kan ano, bo kehm gboko, kohk asamahr ebo go ndi, kehm kehme elfahle gbalee.<verse eid="MAT 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 17:7" />Jisos kehm bake, ba kpiri bo, kooro bo, kehm bungu re, “Mehlen yiimi, kana kpe fahl!”<verse eid="MAT 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 17:8" />Eji bo tabe asamahr ebo wahre, bo kpeem nyehn nnene, sehngem Jisos ntahngtahng wo bo nyehn-e no.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Eji bo jo badde go ewong abake, Jisos kehm tongo bo re, “Kana tiki tong nne awohng awohng bada nkpokosi nyi ḿ ma nyehn a, tete Mmon no nne nyahme go elkv.”<note caller="+" style="f"><char style="fr" closed="false">17:9 </char><char style="ft" closed="false">Mat 16:20</char></note><verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Abatꞌtoono bao kehm-e bahbe re, “Jen ji wahnge atꞌtibi ba atahm kpo bung re, Elaija bahke tohko gbo mbang ba?”<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Á kehm faange re, “Elaija bahke gboko mbang ba, ba tuungu ejum ajehng ajehng. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />N kp-n tongo re, Elaija ebsi bꞌba. Bo we liingem. Bo lim-e ejum ajehng ajehng ji koro bo.<note caller="+" style="f"><char style="fr" closed="false">17:12 </char><char style="ft" closed="false">Mat 11:14</char></note> Ano wo fvfo Mmon no nne bahke tob nyehn erem bi ane bao bahk-e kake.”<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />Owo kehm lennge abatꞌtoono bao re, á jo bungu abo bada Jon ji nwohngalahb.<verse eid="MAT 17:13" /></para>
  <para style="s">Ana Jisos limi mmon no bele ebi etohko, á nob</para>
  <para style="r">(<ref loc="MRK 9:14-29">Mak 9:14-29</ref>; <ref loc="LUK 9:37-43">Luk 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Eji bo feere no, ba rehng edi ji ellong ane jolo no, nne awohng kehm lohngo ba, ba jamme Jisos alahng, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />kehm-e tongo re, “Nsoo, nong, mmon ewame fil-a ndon. Á kpo gbo ngboko, kpo gbiing-e sehng. Nkpel tvv á kpo kono elgboko yel agun, fere jo gbo yel alahb. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />N ko-e ba a ne goji abatꞌtoono eba. Bo we maam lim, á nob.”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Owo Jisos kehm faange re, “Wahn ane ba kpo soodo, fere kꞌtaame ba! M bahke kange renan a nahne? Anv, bahke kange renan, ji m bahke koko tib-n, ń kehm kahne? Ko mmon noo, ba a ne!” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Jisos kehm nyame ebi etohko jio, ebi etohko jio kehm soro lohng mmon noo. Mmon noo lohko nob tvtv.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Owo abatꞌtoono Jisos kehm bake, ba kpiri Jisos, eji á li ntahngtahng, kehm-e bahbe re, “Jen ji wahnge wahr ki ma kam ebi etohko jio yehke?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Owo Jisos kehm faange bo re, “Ekꞌtaame ejahne ji wahnge. Etingitingi, n kp-n tongo re, Ń lꞌtaame, jol afi eltaame enahne se ana mmohk asia, ń li ma tong ewong jia re, ‘Mehl, song rehng o!’ Ewong jio bahke lohko mehl tahm. Ejumjum limm, ji bahk-n riidi.<note caller="+" style="f"><char style="fr" closed="false">17:20 </char><char style="ft" closed="false">Mat 21:21; Luk 17:6</char></note> <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Elkohn ebi etohko ana jio ń nehm ma kam yehke, tohko jol re ń kake ero, fere bade elnahne njal.”<verse eid="MAT 17:21" /></para>
  <para style="s">Ana Jisos kpe bung bade elkv ene</para>
  <para style="r">(<ref loc="MRK 9:30-32">Mak 9:30-32</ref>; <ref loc="LUK 9:43-45">Luk 9:43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Ngare nyi bo jolo go Galili, Jisos kehm tongo bo re, “Mmon no nne, bo yahk-e ba elyake, kak ane go ebo. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Bo bahk-e wulu. Lꞌkang nfung era, á nyahme go elkv.”</para>
  <para style="p" vid="MAT 17:23">Abatꞌtoono ebe, ndon kehm gbale bo go eltim.<verse eid="MAT 17:23" /></para>
  <para style="s">Bade etak atahbe</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Eji Jisos, a abatꞌtoono ebe ba rehng go Kapenium, ane ba kpo ko etak ji etahk Esowo kehm ba bahb Pita re, “Anv, ntꞌtibi ewahne kpehme tahb etak ji etahk Esowoa?”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Pita kehm faange re, “Ee.”</para>
  <para style="p" vid="MAT 17:25">Eji Pita yele ekpꞌkpa, owo Jisos kehm gboko mbang bahb-e re, “Saimon, anv, a kpo tir renan bade ejum jia? Atul ba njini nyia kpo ko atak goji abon ebo, afi bo kpo ko goji ane baka baka?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Owo Pita kehm faange re, “Goji ane baka baka.”</para>
  <para style="p" vid="MAT 17:26">Jisos kehm bungu re, “Lꞌfere jol ano, lohngo re, abon, ntahm bo wobem. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Nong, wahr lim, eji lꞌkꞌsab bo. Song, wo song tub eblo go eto! Yehke ngbokambang a nnyam alahb nyi gbo eblo, wo lennge nnyo eme. Owo a bahke nyehne akpohko nya bahke biingi etak ejame, a jꞌja. Nyao nya a bahke koko, song ka bo.”<note caller="+" style="f"><char style="fr" closed="false">17:27 </char><char style="ft" closed="false">1 Kor 9:19</char></note><verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Nne awo ga gbal?</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mak 9:33-37</ref>; <ref loc="LUK 9:46-48">Luk 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Ngare nyio nyi abatꞌtoono Jisos ba rehng go ege, owo bo kehm-e bahbe re, “Nne awo ga gbal go ellong ane ba wob go elwo ni Esowo?”<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Jisos kehm lungu mmonse, ba yiimi go bo a mbuksong, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />kehm bungu re, “Etingitingi, n kp-n tongo re, Ń tohko tiki yaange jol ana abonse, ń nehm tiki li etul bi Esowo. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Fvfo, nne no lꞌrede elne, jol ana mmonse noa, ye wo ga gbal go ellong ane ba wob go elwo ni Esowo. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Nne awohng awohng no lꞌvvrv elkohn mmonse ana noa tib go egama mbing, á vvrv me.<note caller="+" style="f"><char style="fr" closed="false">18:5 </char><char style="ft" closed="false">Mat 10:40</char></note><verse eid="MAT 18:5" /></para>
  <para style="s">Nsol nyi kpo wahng nne yel abiafem</para>
  <para style="r">(<ref loc="MRK 9:42-48">Mak 9:42-48</ref>; <ref loc="LUK 17:1-2">Luk 17:1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />“Ga nob re bo kahn nne egburu eltal go emel, tub-e kak alahb, sehnge re á lim mmonse awohng no ma taame tv-m, á gbo yel abiafem.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />“Eyuu a ane ba njini nyia tib nsol nyi kpo wahng re ane jo lim abiafem! Nsol nyio bahke tiki ba. Eyuu a ane ba kpꞌkoko ba a nyi!<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />“Ebo eba, afi jolo ekpade eja lꞌkehm-a limi re wo gbo yel abiafem, kim tub go! Ga nob re wo yel go edi elkpin ebo abehng, tohko jol ano ekpade ajehng, sehnge re wo bel abo abal abal, a akpade abal abal, bo ro-a kak go agun nya li go njinanjini.<note caller="+" style="f"><char style="fr" closed="false">18:8 </char><char style="ft" closed="false">Mat 5:29-30</char></note><verse eid="MAT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 18:9" />“Elmahr ena lꞌkehm-a limi re wo lim abiafem, luudu ro go! Ga nob re wo bel elmahr anehng, yel edi elkpin, sehnge re wo bel amahr abal abal, bo ro-a kak ellulagun.<verse eid="MAT 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />“Jo kunen ekpu, eji ń lꞌkꞌdaange mmonse awohng awohng no wob go ellong abonse baa. Tibre n kp-n tongo re, Enjel ebo nya li go ejahbetul Esowo kpo nyehn esamahr Nsoo no li go ero ngare anyehng anyehng.<note caller="+" style="f"><char style="fr" closed="false">18:10 </char><char style="ft" closed="false">Hib 1:14</char></note> <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Tibre Mmon no nne ba re, á ba tahre jio ji ma tan.<verse eid="MAT 18:11" /></para>
  <para style="s">Elgan ni li bada njoro nyi tane no</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luk 15:3-7</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />“Anv, ń kpꞌtiri renan bade ejum jia? Nne lꞌbel ejoro atahl alon, anyehng kehm ba tan, nfono ejoro nehm tahm ejoro behko sa go awong, song seb nyio nyi ma tana?<figure style="fig" alt="shepherd with a sheep" file="lb00001c.tif" size="col" loc="MAT 18:12" copy="Louise Bass" ref="18:12">mbaabebul a ebul ebe</figure> <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Á lꞌseb-e nyehn, etingitingi, n kp-n tongo re, á bahke ga bel eyebatahng go njoro nyio, sehnge ejoro behko bi ki tan. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Ano wo fvfo Nso ejahne no li go ero kil sebe re mmonse awohng awohng go ellong abonse baa tan.<verse eid="MAT 18:14" /></para>
  <para style="s">Ana nne Esowo bahke jo lim mmonannyehn lꞌsood-e</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />“Mmonanne lꞌlim abiafem bada na, song lennge ebi ji á lim-a no ka-e wahn wahn. Á lꞌwuk-a, a m-e ko, feere a ne.<note caller="+" style="f"><char style="fr" closed="false">18:15 </char><char style="ft" closed="false">Luk 17:3; Mat 18:21-22; Gal 6:1</char></note> <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Á tohk-a fere wuk, ko ntianse anyehng, tohko jol ano ebal, je a bo, ‘eji ellum anehng anehng lꞌjo yiimi, ni ntianse ebal, tohko jol ano ni ntianse era bungu no, bum nnyo amehng.’ <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Á tohko fere wuk bo, tooro tong aneb ero. Á tohko fere wuk aneb ero, ko-e na ko ana nne no ki nyi Esowo, tohko jol ano ana nkokatak.<note caller="+" style="f"><char style="fr" closed="false">18:17 </char><char style="ft" closed="false">1 Kor 5:9-13</char></note><verse eid="MAT 18:17" /></para>
  <para style="s">Nsahm nyi li go ero akake</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />“Etingitingi, n kp-n tongo re, Ejum ajehng ajehng ji ń lꞌgba go njini nyia, bobtob gba go ejahbetul Esowo. Ejum ajehng ajehng ji ń lꞌfannge go njini nyia, bobtob fannge go ejahbetul Esowo.<note caller="+" style="f"><char style="fr" closed="false">18:18 </char><char style="ft" closed="false">Jon 20:23</char></note><verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />“N kp-n kpeke tong re, Ejum ajehng ajehng ji ane abal ebahne lꞌkod abo kak ero go njini nyia, Nsoo no li go ero bahke limi ka bo.<note caller="+" style="f"><char style="fr" closed="false">18:19 </char><char style="ft" closed="false">Mak 11:24</char></note> <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Tibre edi jio ji ane abal, ane ara lꞌkono go egama mbing, me n li go bo ellong.”<verse eid="MAT 18:20" /></para>
  <para style="s">Elgan ni li bada nne no ki tahm ka ntem</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Pita kehm bake goji Jisos, kehm ba bahb-e re, “Nsoo, nkpel ebik nyi mmonannee lꞌsood-m, m bahke jo tahm ka-e?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Owo Jisos kehm-e faange re, “N kp-a tongo re, Nkpel esehma sang, li nkpel atahltahl atahl ani nkpel ewubu.<note caller="+" style="f"><char style="fr" closed="false">18:22 </char><char style="ft" closed="false">Luk 17:3-4</char></note><verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />“Etul bi Esowo li ana ntul awohng no lungu alokeltum ebe re bo ba toobo akpohko enye ka-e. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Á bomo kan eltoobo a alokeltum ebe, owo bo kehm koko nne awohng ba go ege, no bel-e mbong ekpa akpohko atahltahl nkpel atahltahl. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Eji nlokeltum noo ki bel ejumjum ji á bahke kake, owo nde kehm tongo re, bo gung-e, fere gungu nkal ewe, gungu abon ebe, a nsol kpee nyi á kpi no, ko akpohko nyao gal mbong.<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />“Owo nlokeltum noo kehm jamme nde alahng, kehm-e gboongo re, ‘Nsoo titi, tohko kpe nong, m bahk-a gale mbong enya kpee.’<verse eid="MAT 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 18:27" />“Nde nlokeltum noo, ndon kehm-e fili, á kehm-e yake, á song, fere yake mbong nyi á bel-e no tv-e.<note caller="+" style="f"><char style="fr" closed="false">18:27 </char><char style="ft" closed="false">Luk 6:36; Ef 4:32</char></note><verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />“Nlokeltum nonehm o kehm tahme song kpiri nte ewe, no jo tob loko nde nonehm o. Nte ewe noo bel-e mbong a mpon esehma. Á kehm-e tubu ejahm go nkahng, fere tong-e re, ‘Gal-m mbong enyame!’<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />“Nte ewe noo kehm-e jamme alahng, fere jo gboong-e re, ‘Titi, tohko kpe nong, m bahk-a gale mbong enya.’<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />“Jol atung we á joom wuungu. Á tahm a ne, song kak-e ngbekobo re á woomo o tete gal-e mbong enye.<verse eid="MAT 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 18:31" />“Eji alokeltum bako nyehne ano, bo kpeem jo bang. Bo kehm tahme, song tooro nsol kpee nyi ma lim, tong nde ebo.<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />“Owo nde kehm-e lungu, kehm-e tongo re, ‘Wo ebi nlokeltum wo. Mbong nyio nyi a bel-m no kpee, me n yake tv-a, tib eji a gboong-m no. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Anv, limm nyi kehn nte ewa jol-a tob fili ndon, ana a fil-m ndona?’<verse eid="MAT 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 18:34" />“Nde noo, atahng rak-e sehng, owo á kehm tumu nlokeltum noo ngbekobo re bo kak-e erem tete á gal-e mbong enye kpee.<note caller="+" style="f"><char style="fr" closed="false">18:34 </char><char style="ft" closed="false">Mat 5:26</char></note><verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />“Ano wo Nsoo no li go ero bahke limi nne awohng awohng ewahne no tohko jo tahm ka mmonannyehn go abiafem nya á lim-e no kpee eltim eltim ene.”<note caller="+" style="f"><char style="fr" closed="false">18:35 </char><char style="ft" closed="false">Jems 2:13</char></note><verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Ana Jisos tibi bade elbal amale</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mak 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Eji Jisos ma bung ano mal, á kehm tahme o Galili, feere go Judea, egbuk Jodan jehko. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Ellong ane gbalee kehm tahme toon-e. Á kehm limi bo, bo nob ayam ebo.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Egom Farisi jindiki kehm bake re bo ba gar-e. Bo bahb-e re, “Anv, ntahm enyahre bꞌbung re, nfem anyehng anyehng lꞌgbo nne abola nkal ewe, á yehk-e na yehke elbala?”<note caller="+" style="f"><char style="fr" closed="false">19:3 </char><char style="ft" closed="false">Mat 5:31-32</char></note><verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Owo Jisos kehm faange re, “Anv ń ka tiki lung bade ana Esowo limi ane go mbomannahb re, á limi ‘nnenlum, a nnenkala?’ <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />fere bung re, ‘Ano wo wahnge nne bahke tahme nde, a nnyehn sa, bo song jol ebo ebo abola nkal ewe. Ane bao na abal bahke fere jol ajehng.’ <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Bo nehm kpe jol ane abal, bo bahke fere jol ana ngubjing anyehng. Ejum ji Esowo ma kono edi ajehng, nne kꞌyaame.”<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">1 Kor 7:10-11</char></note><verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Owo Bab Farisi kehm-e bahbe re, “Jen ji wahnge Moses kehm jehke ntahm re, nne jo nyon nwer, ka nkal ewe, kehm-e kame, á song?”<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Jisos kehm faange re, “Moses jehke ntahm re wahn jo yehke akal ebahne ano tib go egahne etahnsi. Go mbomannahb jolem ano. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Wo, n kp-n tongo re, Nne awohng awohng no lꞌkam nkal ewe, eji nnenlum nondiki ki noongo a ne, fere ko nkal nondiki, yeblim abiafem nyao nya erehbe. Nne no lꞌko nnenkal no bo m-e yehke elbal, yebtob lim abiafem nya erehbe.”<note caller="+" style="f"><char style="fr" closed="false">19:9 </char><char style="ft" closed="false">Luk 16:18</char></note><verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Abatꞌtoono ebe kehm-e tongo re, “Joare ano wo li no bada nnenlum, a nnenkal, ga nob re nne kꞌko nkal.”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Owo Jisos kehm tongo bo re, “Ellum ni n fi elbungu a, ane kpee sang bahke lennge bo, sehngem ane bao ba Esowo ma lennge ka bo, bo ba bahke lennge bo. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Ane baa, ba bo ma fang bo. Ane baa, ba bo jele na bo ano. Ane baa, ba fange elbo antahng tib esi jio ona ji etul bi Esowo.<note caller="+" style="f"><char style="fr" closed="false">19:12 </char><char style="ft" closed="false">1 Kor 7:7,32-35</char></note> Nne no lꞌmal kahn ana lohngo no, nong, á kahn.”<verse eid="MAT 19:12" /></para>
  <para style="s">Ana Jisos jo fuulu abon ba nse</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mak 10:13-16</ref>; <ref loc="LUK 18:15-17">Luk 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Ane bandiki kehm koko abon ba nse, ba goji Jisos re á kunu bo abo, kak ero. Abatꞌtoono Jisos kehm nyame ane bao.<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />Owo Jisos kehm tongo bo re, “Yaken abon ba nse, bo jo ba ga egame. Kana jo sahde bo! Tibre etul bi Esowo li ka ane ba li ana bo.”<note caller="+" style="f"><char style="fr" closed="false">19:14 </char><char style="ft" closed="false">Mat 18:2-3</char></note> <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Á kehm kunu bo abo, kehm tahme eje o.<verse eid="MAT 19:15" /></para>
  <para style="s">Njangkun nyi jolo efange nne</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mak 10:17-31</ref>; <ref loc="LUK 18:18-30">Luk 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Nne awohng kehm bake goji Jisos, ba bahb-e re, “Ntꞌtibi, nnoobo anyi m bahke limi, eji n lꞌbel elkpin ni li go njinanjini?”<note caller="+" style="f"><char style="fr" closed="false">19:16 </char><char style="ft" closed="false">Luk 10:25-28</char></note><verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Owo Jisos kehm-e faange re, “Jen ji wahnge a kehm-m bahbe bade ji kpꞌnobo? Esowo ntahngtahng bi kpꞌnobo. Lꞌjol re a kpꞌsebe re wo bel elkpin, jo bum atahm!”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Owo á kehm-e bahbe re, “Atahm anya?”</para>
  <para style="p" vid="MAT 19:18">Jisos kehm-e faange re, “Ka jo wul nne! Ka jo lim erehbe! Ka jo v ejv! Ka jo yiimi ntianse efahnge! <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />Kak nso, a nne! Nne ebjing ewa jo kor-a ana ebjing eba!”<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Owo njangkun nyio kehm-e faange re, “Nyaa kpee n kpo bꞌbum. Anv, ejum aji kpe li, ji m bahke kpe lim!”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Jisos kehm-e tongo re, “A lꞌseb re wo jol go nseenge, song, wo song gungu nsol kpee nyi a kpi no, ko akpohko nyao song ka akpak, a bahke bele afang go ejahbetul Esowo, wo feere ba toon-m.”<note caller="+" style="f"><char style="fr" closed="false">19:21 </char><char style="ft" closed="false">Luk 12:33-34</char></note><verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Eji njangkun nyio wuku ano, á kehm tahme eje ndon ndon. Tibre á fange sehng.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Jisos kehm bungu tong abatꞌtoono ebe re, “Etingitingi, n kp-n tongo re, Bahke riidi sehng re, efange nne kehm lehke etul bi Esowo. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />N kp-n kpeke tong re, Re efange nne kehm yele go ejahbetul Esowo, ekamel bahke sehnge go mbang a nga.”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Abatꞌtoono ebe wuku ano, kehm sahb kpꞌkpo bo esi, bo kehm bahbe re, “Wo anv, nne awo bahke kehm bele eltahre me?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Jisos kehm seenge bo too, kehm bungu tong bo re, “Jia, nne nehm ma lim. Wo, goji Esowo ejum ajehng ajehng riidem.”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Owo Pita kehm bungu re, “Nyehn ana e ma yake nsol kpee kp-a toono. Ejum aji e bahke bele?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Jisos kehm tongo bo re, “Etingitingi, n kp-n tongo re, Ngare nyi Mmon no nne bahke jehke go eti etul ji ellub ene, ngare nyio nyi nsol kpee ma yaange, jol nyi nfenfe, owo wahn jia ji jo toon-m ḿ bahke tob ji go ewubu a nti etul ebal, fere lam ewubu etꞌtohngo ebbal bi Israel.<note caller="+" style="f"><char style="fr" closed="false">19:28 </char><char style="ft" closed="false">Luk 22:30; 1 Kor 6:2-3</char></note> <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Nne awohng awohng no lꞌyake etahk eje, yake abonanyehn, yake nde, yake nnyehn, yake abon ebe, fere yake egbe eje tib go esi mbing enyame, á bahke bele budu nkpel atahl alon, fere bel elkpin ni li go njinanjini. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Ane gbalee ba li agbokombang bahke fere jol akahlenjahm. Akahlenjahm bahke fere jol agbokombang.<note caller="+" style="f"><char style="fr" closed="false">19:30 </char><char style="ft" closed="false">Mat 20:16</char></note><verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Elgan ni li bade ane ba bo lake bo egbe</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“Etul bi Esowo li ana nfono egbe no tahme no efungfu atv atv, song lak ane egbe eje.<note caller="+" style="f"><char style="fr" closed="false">20:1 </char><char style="ft" closed="false">Mat 9:37</char></note> <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Eji á ma lam are ane bao re á bahke kake bo nne awohng awohng nsiring elon elon efung, owo á kehm tubu bo tv go ege egbe re bo song lim eltum.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />“Eji ma rehng nkaranka esehmwubu, á kehm jeke are, song nyehn ane bamongo yim no mbol mbol, kil ejumjum lim. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Owo á kehm tongo bo re, ‘Wahn tob songen go egame egbe, wahn song lim eltum. M bahk-n kpiki nob nob ana bo kpo kono elkpiki.’<verse eid="MAT 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 20:5" />“Owo bo kehm tahme.</para>
  <para style="p" vid="MAT 20:5">“Nfono egbe noo kehm kpe je ngare efin, fere kpe je go nkaranka era nyi elgung, tob lim ano jang jang. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Eji ma rehng nkaranka elon nyi elgung, á kehm kpe je, song nyehn ane bako yim no mbol mbol, kil ejumjum lim. Owo á kehm tongo bo re, ‘Jen ji wahnge ń yim na yim ana efung kohro kohro, ń kil ejumjum lim?’<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />“Owo bo kehm-e faange re, ‘Nnene limm, no ma-r lak eltum.’</para>
  <para style="p" vid="MAT 20:7">“Á kehm tongo bo re, ‘Tob songen fvfo go egame egbe, wahn song lim eltum. M bahk-n kpiki nob nob ana bo kpo kono elkpiki.’<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />“Eji elgung ba no, nfono egbe noo kehm tongo ntubesi a nlokeltum ewe re, ‘Lung aneb eltum ebame, bo ba, wo kpi bo. Gbo mbang bom goji ane ba n gohro ko bo ba, wo kehm gohro kpi ane ba n gbo mbang ko bo.’<verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />“Ane ba bomo eltum nkaranka elon nyi elgung kehm bake, ba ko nsiring elon elon. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Owo ane ba, á gbo mbang lak bo kehm bake. Bo jo tiri re, bo bahke koko akpohko sehnge ane bao. Bo fvfo tob ko nsiring elon elon. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Eji bo ma ko ano, owo bo kehm kehme elmemme tob nfono egbe noo re, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />‘Ane baa ba a gohro ko bo ba, bo limi eltum awa anyehng nya nya, wobkpi bo jang jang ana a kpi-r no, wahr ji ma nyehn erem go nfuba njul nyia efung kohro kohro.’<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />“Owo nfono egbe kehm faange nne awohng re, ‘Mbi, wa n nehmem na. Nsiring elon sang wuku e lame area? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Ko akpohko enya, wo song a nya! Anv, lꞌkor-m re me n ka ane ba gohro ba ekahlenjahm ana n ka-a no, <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />anv, akpohko enyame sang n kpꞌkoko lim ana kor-m noa? Anv, a kpꞌmemme tib eji m ma wehr aboa?’ ”<note caller="+" style="f"><char style="fr" closed="false">20:15 </char><char style="ft" closed="false">Rom 9:16</char></note><verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />Jisos kehm gohro bung re, “Akahlenjahm bahke gboko mbang, agbokombang fere kahle njahm.<note caller="+" style="f"><char style="fr" closed="false">20:16 </char><char style="ft" closed="false">Rom 11:25-26</char></note> Ane gbalee ba bo ma lung bo, wo, abon amohk ane ntiil ba bo ma jak.”<note caller="+" style="f"><char style="fr" closed="false">20:16 </char><char style="ft" closed="false">Rom 10:21</char></note><verse eid="MAT 20:16" /></para>
  <para style="s">Ana Jisos gohro bung bade elkv ene</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mak 10:32-34</ref>; <ref loc="LUK 18:31-34">Luk 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Eji Jisos jo tahm go Jeusalem, ngare nyi bo li go mbang, á kehm koko abatꞌtoono ebe, ewubu ane abal, tahm a bo go nkpohko anyehng, song tong bo re, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Nyehnen, anv, e kpꞌtahme go Jeusalem. Mmon no nne, bo bahk-e yake, kak atubesi abalimajom, a atꞌtibi ba atahm go ebo. Bo bahke lame elam ji bo bahk-e wulu, <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />fere yak-e, kak ane baka baka go ebo, ba bahk-e nyoko, fere dv-e, kum-e go ekros. Lꞌkang nfung era, á nyahme go elkv.”<verse eid="MAT 20:19" /></para>
  <para style="s">Ejum ji nnyehn Bab Jon gboongo no</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mak 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Nkal a Sibidi kehm koko abon ebe Jon, a Jems, ba a bo goji Jisos, kehm ba gong go ege alata, kehm-e gboongo re, á lub lim ejum ka-e.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Jisos kehm-e bahbe re, “Jen ji a kpꞌsebe me?”</para>
  <para style="p" vid="MAT 20:21">Á kehm-e faange re, “Ka abon ebame baa na abal nsahm, eji noko lꞌji go ega ejang eboblum, noko go ega ejang ebobkal ngare nyi a ma jol ntul.”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Owo Jisos kehm faange re, “Ń nehme kahn ji ń kpꞌbꞌbahb. Anv, ḿ bahke ma wo go nkob nyi n yahke ba elwoka?”<note caller="+" style="f"><char style="fr" closed="false">20:22 </char><char style="ft" closed="false">Mat 26:39; Luk 12:50</char></note></para>
  <para style="p" vid="MAT 20:22">Bo kehm-e faange re, “Ee, e bahke ma wo.”<note caller="+" style="f"><char style="fr" closed="false">20:22 </char><char style="ft" closed="false">Luk 22:33</char></note><verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Jisos kehm tongo bo re, “Etingitingi, ḿ bahke lohko wo go egama nkob.<note caller="+" style="f"><char style="fr" closed="false">20:23 </char><char style="ft" closed="false">Elt 12:2; Ell 1:9</char></note> Me, nsahm n kpimm, nyi m bahke yehke ane, noko ji go egame ejang eboblum, noko ji go egame ejang ebobkal. Adi nyao li ka ane ba wahnge Nsoo toobo bum.”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Abatꞌtoono bako na ewubu wuku kan ano, atahng kehm rake bo tob Jon, a Jems.<verse eid="MAT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 20:25" />Owo Jisos kehm lungu bo tv elne, kehm bungu re, “Ń kpꞌkahne re, atubesi ba njini nyia kpi nsahm nyi bo kpo fili ane. Ajꞌjok ane kpo tob fili ane. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Wahn, kana jo lim ano go egahne ellong. Nne awohng awohng ewahne no lꞌseb re á jol njꞌjoka nne, á bahke jolo na nlokeltum ewahne. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Nne awohng awohng ewahne no lꞌseb re á jol ntubesi, á bahke fere jol na nlokeltum ewahne, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />ana Mmon no nne ki ba re bo lok-e, á ba re á ba loko, fere ka elkpin ene, fak ane gbalee yake.”<note caller="+" style="f"><char style="fr" closed="false">20:28 </char><char style="ft" closed="false">Fil 2:7-8; 1 Tim 2:6</char></note><verse eid="MAT 20:28" /></para>
  <para style="s">Ana Jisos limi awakamahr abal, bo nyehn</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mak 10:46-52</ref>; <ref loc="LUK 18:35-43">Luk 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Eji bo jo tahm go Jeriko asongo, ellong ane gbalee kehm tahme toono Jisos.<verse eid="MAT 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 20:30" />Awakamahr na abal ji o nkpe a mbang. Eji bo wuku re, Jisos kpꞌbake elsehnge, bo kehm kehme elrabe re, “Mmon no Devid, nong, wahr fil-a ndon!”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Ellong ane bao kehm sahde bo re bo rahke ewok. Bo jo kpe nyennge na rabe re, “Mmon no Devid, nong, wahr fil-a ndon, nsoo!”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Jisos kehm yiimi, lung bo re bo ba. Á kehm bahbe bo re, “Ń kpꞌsebe re me n lim jen ka-n?”<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Owo bo kehm-e faange re, “Nsoo, lub lenng-r amahr enyahre!”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Owo Jisos ndon kehm-e fili. Á kehm song kooro bo abo go amahr, bo kehm soro nyehn tvtv, soro tahm toon-e.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Ana Jisos yele go Jeusalem, a egburu ellub</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mak 11:1-11</ref>; <ref loc="LUK 19:28-40">Luk 19:28-40</ref>; <ref loc="JHN 12:12-19">Jon 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Eji bo ma kabbe Jeusalem, bo kehm ba rehng go Betfage ji jolo go nnahb ewong ji bo kpo lung re Oliv. Owo Jisos kehm yehke abatꞌtoono ebe, ane na abal, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />kehm tongo bo re, “Songen ejahbe ji li-n o mbuksong. Owo ḿ bahke nyehne mbvankang nyi bo kahn-e go eti, a mmon ewe. Fanngen bo, wahn ko bo ba ka-m.<note caller="+" style="f"><char style="fr" closed="false">21:2 </char><char style="ft" closed="false">Mak 14:13</char></note> <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Nne awohng awohng no lꞌbahb-n ejum bade ebvnkang bio, tongen ye re, ‘Nsoo kpꞌsebe bo,’ nfono ebvnkang bio bahke yake bo elwaare ka.”<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Nsol nyia limi, eji lꞌlohko jol go etingitingi ana nnyehnamahr Esowo bungu no re,<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“Tong Sayon re,</para>
  <para style="q1" vid="MAT 21:5">Nyehnen,</para>
  <para style="q1" vid="MAT 21:5">ntul ewahne kpꞌbake go egahne.</para>
  <para style="q1" vid="MAT 21:5">Á li soom,</para>
  <para style="q1" vid="MAT 21:5">á kun go mbvankang.<note caller="+" style="f"><char style="fr" closed="false">21:5 </char><char style="ft" closed="false">Mat 11:29</char></note></para>
  <para style="q1" vid="MAT 21:5">Á kun go mmon a nnyam no kpo sol nsol.”<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Abatꞌtoono ebe kehm tahme, song lim ana Jisos tongo bo. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Bo kehm koko mbvankang nyio, a mmon ba a bo, yehke awobo ebo, kunu go bo a njahm, Jisos kehm wahre, kuumu mmon a mbvankang noo. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Ellong ane gbalee kehm yehke awobo ebo, yal go mbang. Ane bandiki song ja amang, jo ba yal go mbang. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Ellong ane ba gbo Jisos mbang, a ellong ane ba jo toon-e njahm kehm kehme elrabe re,</para>
  <para style="q1" vid="MAT 21:9">“Tehken mmon no Devid!</para>
  <para style="q1" vid="MAT 21:9">Elfuulu li ka nne no kpꞌbake go mbing nyi Jehova.</para>
  <para style="q1" vid="MAT 21:9">Tehken Esowo bi li go ero!”<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Eji Jisos yele go nla Jeusalem, edi kehm kehme elvvrv na vvrv. Ane kehm kehme elbahbe re, “Nne awo ona?”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Owo ellong ane bao kehm jo bung re, “Jisos wo ana, ji li nnyehnamahr. Á lohng go Nasaret nyi Galili.”<verse eid="MAT 21:11" /></para>
  <para style="s">Ana Jisos sehnge song yange go etahk Esowo</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mak 11:15-19</ref>; <ref loc="LUK 19:45-48">Luk 19:45-48</ref>; <ref loc="JHN 2:13-22">Jon 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Jisos kehm yange go etahk Esowo, song kam ane ba jo gungu, a ane ba jo gunu, fere gbul akpꞌkuru nya abayaangakpohko tuubu go, a nti nyi abagungumbehl. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Á kehm tongo bo re, “Bo nyono go nwer Esowo re, ‘Etahk ejame, bo bahke jo lung re, etahk ero akake.’ Wahn ebfere rod, bum ana ebehre awajv.”<note caller="+" style="f"><char style="fr" closed="false">21:13 </char><char style="ft" closed="false">Rom 2:22</char></note><verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Awakamahr ane, a abanne kehm bake, ba kpir-e go etahk Esowo jio. Á lim bo, bo nob.<verse eid="MAT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 21:15" />Eji atubesi abalimajom, a atꞌtibi ba atahm nyehn akpokosi nya á limi no, fere wuk abonse kpꞌrabe go etahk Esowo jio re, “Tehken mmon no Devid!”<note caller="+" style="f"><char style="fr" closed="false">21:15 </char><char style="ft" closed="false">Mat 1:1</char></note> atahng kehm rake bo. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Owo bo kehm tongo Jisos re, “Wobwuk ana bo kpꞌraba?”</para>
  <para style="p" vid="MAT 21:16">Jisos kehm faange bo re, “Ee, n kpꞌwuku. Wo, ń ka tiki lung edi nwer Esowo ji bungu re,</para>
  <para style="q1" vid="MAT 21:16">“ ‘Esowo ebko anyo abonse,</para>
  <para style="q1" vid="MAT 21:16">a nya abonbili, lim,</para>
  <para style="q1" vid="MAT 21:16">eji lꞌjol ejum eltehke ka yefono antahnga?’ ”<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Jisos kehm tahme bo sa, song rehng go Betani, fere kang o.<verse eid="MAT 21:17" /></para>
  <para style="s">Ana Jisos nyehne amahr bade efig</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mak 11:12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Efungfu atv atv eji Jisos feere asongo go Jeusalem, njal kehm-e yame. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Á kehm nyehne eti ji bo kpo lung re efig go nkpe a mbang. Á jeere kan kohlo o me, á nyehnem nkab anyehng anyehng, sehngem anyane nya nya á nyehne no.<note caller="+" style="f"><char style="fr" closed="false">21:19 </char><char style="ft" closed="false">Luk 13:6-9</char></note> Owo á kehm tongo eti jio re, “A nehm kpe tiki kab akab go njinanjini.” Tvtv ona eti jio kehm soro kpo.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Eji abatꞌtoono ebe nyehne ano, kehm kpoko bo esi. Bo kehm bungu re, “Jen ji wahnge eti jia ma tahr kpꞌkpo elwaare elwaare anae?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Owo Jisos kehm faange bo re, “Etingitingi, n kp-n tongo re, Ń lꞌtaame, kꞌjo faabe, ḿ bahke jo lim ana m ma lim eti jia, jol sꞌsehnge na ana.<note caller="+" style="f"><char style="fr" closed="false">21:21 </char><char style="ft" closed="false">Jon 14:12</char></note> Ń li ma tong ewong jia re, ‘Mehl, song yel aya!’ Bahke lohko lim ano. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Ejum ajehng ajehng ji ń lꞌbahb go egahne ero bi ń kpꞌkake, ń lꞌtaame, ḿ bahke bele.”<verse eid="MAT 21:22" /></para>
  <para style="s">Ana bo bahbe Jisos bada nsahm enye</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mak 11:27-33</ref>; <ref loc="LUK 20:1-8">Luk 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Jisos kehm feere go etahk Esowo.</para>
  <para style="p" vid="MAT 21:23">Eji á jo tib, atubesi abalimajom, a anebkul nfam kehm bake, ba kpir-e, kehm-e bahbe re, “Nsahm anyi a kpi no, nyi wahnge a kpo lim nsol ana nyia? Nne awo ka-a nsahm ana nyio?”<note caller="+" style="f"><char style="fr" closed="false">21:23 </char><char style="ft" closed="false">Jon 2:18</char></note><verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Jisos kehm faange bo re, “M bahk-n tob bahb mbahbe fvfo. Ń lꞌfaang-m, n kehm-n tongo bada nsahm nyi n kpi no, nyi wahnge n kpo lim nsol ana nyia. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Anv, nsahm nyi Jon jo wohngo ane alahb lohng go ejahbetul Esowo baa, afi lohng goji ane?”</para>
  <para style="p" vid="MAT 21:25">Bo kehm kehme eltoobo atemtem re, “E lꞌbung re, ‘Nsahm nyi Jon lohng go ejahbetul Esowo’, á bahk-r bahbe re, ‘Jen ji wahnge ń ki taame tv Jon?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />E lꞌfere bung re, ‘Nsahm enye lohng goji ane’, ma ane bahk-r limi ejum nji. Tibre e kpꞌfahle bo, tib eji bo kpee jo bum Jon ana nnyehnamahr.”<note caller="+" style="f"><char style="fr" closed="false">21:26 </char><char style="ft" closed="false">Mat 14:5</char></note> <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Owo bo kehm faange Jisos re, “Wahr nehme kahn.”</para>
  <para style="p" vid="MAT 21:27">Jisos kehm tongo bo re, “Fvfo, wahn n nehm tong bada nsahm nyi n kpi no, nyi n kpo ko, lim nsol nyia.<verse eid="MAT 21:27" /></para>
  <para style="s">Elgan ni li bade abon na abal</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />“Anv ń kpꞌtiri renan bade elgan nia? Nne jolo go, no bele abon na abal. Owo á kehm jeke goji ngbokambang a mmon, kehm song tong-e re, ‘Mmon ewame, song lela go egame egbe, wo song lim eltum.’<verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />“Mmon noo kehm faange re, ‘N nehm je.’ Ji kan mmokidi, á kehm yaange ntir atahng enye, fere tahm egbe nde.<verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />“Owo nde kehm kpe je, song kpiri mmon noko, kehm-e tob tong ano fvfo. Á kehm taame re, ‘Ee nsoo.’ Jol egbe á tikem je.<note caller="+" style="f"><char style="fr" closed="false">21:30 </char><char style="ft" closed="false">Mat 7:21</char></note><verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />“Nne awo go abon abal bao limi ji nde tong-e re á lim?” Bo kehm-e faange re, “Ngbokambang a mmon wo.”</para>
  <para style="p" vid="MAT 21:31">Owo Jisos kehm tongo bo re, “Etingitingi, n kp-n tongo re, Abakokatak, a abajenasꞌsa ba bahke song yel go ejahbetul Esowo,<note caller="+" style="f"><char style="fr" closed="false">21:31 </char><char style="ft" closed="false">Luk 18:13-14</char></note> wahn sa elatahk, jo seenge bo. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Tibre Jon ji nwohngalahb ba, ba tib-n mbang nyi nno, nyi elsehnge, ń tikem taame tv-e. Abakokatak, a abajenasꞌsa ba taame no tv-e.<note caller="+" style="f"><char style="fr" closed="false">21:32 </char><char style="ft" closed="false">Luk 7:29</char></note> Jol eji ń nyehne nyehn ano, ń tikem yaange ntir atahng enyahne, fere taame tv-e.”<verse eid="MAT 21:32" /></para>
  <para style="s">Elgan ni li bade abayaame etahngga</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mak 12:1-12</ref>; <ref loc="LUK 20:9-19">Luk 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Jisos kehm tongo bo re, “Wuken elgan nehko! Nne jolo go, no bahme avain, fere kak ega sennge.<note caller="+" style="f"><char style="fr" closed="false">21:33 </char><char style="ft" closed="false">Ef 2:14</char></note> Á kehm rahme elbing ni bo jo kak akab nti, fere jo kaame akab nti nyao tv elbing nio, alahb jo lohng. Á si enyong, kak ane ba jo baabe edi jio,<note caller="+" style="f"><char style="fr" closed="false">21:33 </char><char style="ft" closed="false">Hib 13:17</char></note> kehm yaame abahmgbe edi jio, toono eje tahm ejahbe jehko ji li fee.<note caller="+" style="f"><char style="fr" closed="false">21:33 </char><char style="ft" closed="false">Mat 25:14</char></note><verse eid="MAT 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 21:34" />“Eji ngare nyi bo kpo bong akab nti nyao ma kabbe, owo á kehm tumu alokeltum ebe tv ane ba á yaame bo etahngga eje, eji bo lꞌsong ko akab nti enye, ba ka-e. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Abayaame etahngga kehm bobo alokeltum ebe. Noko, bo dv-e, noko, bo wul-e, fere tuubu noko atal, á kpo.<verse eid="MAT 21:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 21:36" />“Owo nfono etahngga kehm kpe tum alokeltum bako gbalee, sehnge ba á gbo mbang tum. Abayaame etahngga tob limi bo jang jang ana bo limi ane bako.<verse eid="MAT 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 21:37" />“Esꞌkohro, á gohro tum mmon ewe tv bo. Á bungu re, ‘Bo bahke kake mmon ewame.’<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />“Eji abayaame etahngga bao nyehne mmon ewe noo kpꞌbake, bo kehm bungu atemtem re, ‘Ye wo li nlehkelkv, nong, wahr song wulen ye, eji etahngga jia lꞌfere jol jꞌjahre.’<note caller="+" style="f"><char style="fr" closed="false">21:38 </char><char style="ft" closed="false">Mat 27:18</char></note> <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Bo kehm-e bobo, ro njahm etahngga nyehko, fere song wul-e. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />Anv, nfono etahngga lꞌba, á bahke limi abayaame etahngga bao renan?”<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Bo kehm-e faange re, “Á bahke wulu abi ane bao, bo kpo esabsab elkv, fere yaame ane bako etahngga jio, ba bahke jo ka-e akab nti nyao go ngare nyi nno.”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Owo Jisos kehm tongo bo re, “Ń ka tiki lung a lung edi nwer Esowo jia re,</para>
  <para style="q1" vid="MAT 21:42">“ ‘Eltal ni asehketahk tene no,</para>
  <para style="q1" vid="MAT 21:42">ni ni ma fere jol nnahb ekahma?<note caller="+" style="f"><char style="fr" closed="false">21:42 </char><char style="ft" closed="false">1 Pit 2:6-8</char></note></para>
  <para style="q1" vid="MAT 21:42">Jehova limi jia ji li nkpokosi go egahra ntim.’<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />“Owo wahnge n kp-n tongo re, Esowo bahk-n taare etul ebe, faake a bi, ka ane ba bahk-e kake akab nti go ngare nyi nno.<note caller="+" style="f"><char style="fr" closed="false">21:43 </char><char style="ft" closed="false">1 Pit 2:9-10</char></note><verse eid="MAT 21:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 21:44" />“Nne no lꞌfooro gbo eltal nio, á bahke banne.</para>
  <para style="q1" vid="MAT 21:44">Wo, nne no eltal nio lꞌgbo nyed-e á bahke rere na rere kpee.”<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Atubesi abalimajom, a Bab Farisi wuku kan ngaane enye, bo kehm soro kahn tvtv re, á jo bungu bada bo. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Bo kehm gare ana bo bahk-e bobo. Bo jo fahle ellong ane ba jo bum Jisos ana nnyehnamahr.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Elgan ni li bade elkak elbal</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luk 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Jisos kehm kpe tub bo elgan nehko re, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“Etul bi Esowo li ana ntul no toobo ebjing bi elkak elbal, ni mmon ewe yahke ko nkal.<note caller="+" style="f"><char style="fr" closed="false">22:2 </char><char style="ft" closed="false">Jon 3:29</char></note> <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Á kehm tumu alokeltum ebe re, bo song tong ane ba á tiingi bo elkak re bo ba.<note caller="+" style="f"><char style="fr" closed="false">22:3 </char><char style="ft" closed="false">Ell 19:7</char></note> Korem bo elbake. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Á kehm kpe yehke alokeltum bako, kehm tongo bo re, ‘Songen, wahn song tong ane ba n tiingi bo elkak re, Me n toobo ejum ajehng ajehng kpee bum. Bobwul efong ebame, a atohkondi nya m ma le bo, bo ma jok. Baan go elkak elbal!’<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />“Ane ba bo tiingi bo elkak, elkak nio lubem bo. Bo tahme na go bo alimi nsol. Noko tahme go ege egbe, noko tahm go ege a nju are. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Egom ane bako bobo alokeltum ntul noo, nohk bo, fere wul bo.<verse eid="MAT 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 22:7" />“Ntul, atahng rak-e sehng. Á kehm tumu nsoja enye, bo song wul awulane bao, fere jahm ejahbe ebo fi.<note caller="+" style="f"><char style="fr" closed="false">22:7 </char><char style="ft" closed="false">Mat 24:2</char></note> <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Owo á kehm tongo alokeltum ebe re, ‘Nsol elkak kpee, me n toobo bum. Ane ba n tiingi bo, bo kpeem fuumu. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Songen go ayaame mbang! Nne awohng awohng no ń lꞌnyehn-e, tongen ye, á ba go elkak elbal.’<verse eid="MAT 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 22:10" />“Alokeltum bao kehm tahme, jo yannge. Nne awohng awohng no bo nyehn-e no, lꞌkor-e, bo ko-e tahm a ne go elkak. Ane bandiki jolo abi ane,<note caller="+" style="f"><char style="fr" closed="false">22:10 </char><char style="ft" closed="false">Luk 19:1-10</char></note> bandiki jol anoobo ane.<note caller="+" style="f"><char style="fr" closed="false">22:10 </char><char style="ft" closed="false">Elt 10:1-2</char></note> Ekpꞌkpa elkak nio kehm ruru ane ane.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />“Owo ntul kehm tahme re á song nyehn ane ba jo li nsol. Á kehm nyehne nne no kake ewobo ji ki fuumu elkak elbal nio. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Ntul kehm-e bahbe re, ‘Mbi, a limi renan, kehm yele a, kꞌkak ewobo ji fuumu elkak nia?’<note caller="+" style="f"><char style="fr" closed="false">22:12 </char><char style="ft" closed="false">Kol 3:12; Ell 19:8</char></note></para>
  <para style="p" vid="MAT 22:12">“Nne noo belle na belle eje.<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />“Owo ntul kehm tongo alokeltum ebe re, ‘Boben ye, wahn gba-e alehke go abo, a akpade akpade, fere ro-e tv go elatahk, edi ejannge jio ji ane kpo woomo, jo ling, fere jo kono amahn go esi.’<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />“Tibre ane gbalee ba bo tiingi no. Abon amohk ane abik abik ba bo ma jak.”<verse eid="MAT 22:14" /></para>
  <para style="s">Bade etak atahbe</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mak 12:13-17</ref>; <ref loc="LUK 20:20-26">Luk 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Bab Farisi kehm tahme, song toobo ana bo bahk-e bobo go ege alum nnyo. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Bo kehm tumu abatꞌtoono ebo, a aneb ntul a Herod tv goji Jisos. Bo kehm song bahb-e re, “Ntꞌtibi, e kpꞌkahne re, wo etingi nne ji. A kpo tib mbang nyi Esowo go etingitingi. A kpehme rang nnene. Jol esamahr ane, a kpehme be. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Tong-r ana a kpꞌtiri bade ejum jia. Nꞌnob re wahr jo tahb etak ka ntul a Roma, afi nobem?”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Jisos kꞌkahn ebi ntir atahng ebo, owo á kehm faange re, “Wahn aneb alum abal abal ba! Jen ji wahnge ń kp-m gare? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Tib-m wahn akpohko nya ḿ bahke koko tahb etak.” Bo kehm koko ba a nya.<verse eid="MAT 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 22:20" />Jisos kehm bahbe bo re, “Esi jia ji nyehne ji? Mbing nyia nyi nyehne nyi?”<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Bo kehm faange re, “Esi jia ji ntul ji. Mbing nyia nyi ntul nyi.”</para>
  <para style="p" vid="MAT 22:21">Owo Jisos kehm tongo bo re, “Kaan ntul ji li ka ntul,<note caller="+" style="f"><char style="fr" closed="false">22:21 </char><char style="ft" closed="false">Rom 13:1-7; Luk 23:2</char></note> wahn ka Esowo ji li ka Esowo.”<note caller="+" style="f"><char style="fr" closed="false">22:21 </char><char style="ft" closed="false">1 Pit 2:17</char></note><verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Eji bo wuku ano, kehm kpoko bo esi. Bo kehm-e yaame sa, tahm ebo.<verse eid="MAT 22:22" /></para>
  <para style="s">Bade elnyahme go elkv</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mak 12:18-27</ref>; <ref loc="LUK 20:27-40">Luk 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Efung bꞌnehm ona, egom Sadusi jindiki kehm bake ba kpiri Jisos. Bo ba kpo tib re, elnyahme go elkv limm.<note caller="+" style="f"><char style="fr" closed="false">22:23 </char><char style="ft" closed="false">Elt 23:8</char></note> Owo bo kehm tongo Jisos re, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“Ntꞌtibi, Moses bungu re, ‘Nne lꞌkpo, eji á ki jel abon, mmonannyehn nkvne ko nnenkal noo, eji á lꞌjel abon ka mmonannyehn no ma kpo.’<verse eid="MAT 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 22:25" />“Abonanyehn na asehma ba jolo a nahre. Ngbokambang ko nkal, mmon awohng awohng á jelem, á kehm kpoko, nkal ewe sa. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Ano wo tob lim etoono mmonannyehn, a mmonannyehn noko no toono noo, a erik abonanyehn bako kpee. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Esꞌkohro, nnenkal noo tob kpo. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Anv, efung bi ane lꞌnyahme go elkv, nne awo á bahke jolo nkal ewe? Tibre bo ane kpee ko-e ana nkal abo.”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Owo Jisos kehm faange bo re, “Ń kpo soodo, tibre ń nehme kahn nwer Esowo, a nsahm nyi Esowo. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Ngare nyi ane ma nyahme go elkv, bo bahke jolo ana babenjel. Aneblum nehm kpe jo ko akal. Anebkal nehm kpe jo bal alum.<note caller="+" style="f"><char style="fr" closed="false">22:30 </char><char style="ft" closed="false">1 Kor 15:44</char></note> <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Bade elnyahme ngubjing go elkv, ń ka lung alung ana Esowo tong-n no re, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Me wo li Esowo bi Ebraham,<note caller="+" style="f"><char style="fr" closed="false">22:32 </char><char style="ft" closed="false">Luk 16:22</char></note> a bi Aisik, a bi Jekob.’ Jia lohngo re, Ye li Esowo bio bi ane ba li go elkpin, bi akvne sang.”<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Eji ellong ane bao wuku ana á jo tib, kpo bo esi sehng.<verse eid="MAT 22:33" /></para>
  <para style="s">Ntahm nyi ga gbal</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mak 12:28-34</ref>; <ref loc="LUK 10:25-28">Luk 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Eji Bab Farisi wuku re, Jisos ebga aneb Sadusi, bobbelle, bo kehm song kono edi ajehng. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Nne awohng go bo ellong no jolo ntꞌtibi no atahm kehm bake ba bahb Jisos mbahbe, jo gar-e. Á bahb-e re, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Ntꞌtibi, ntahm anyi ga gbal kpee go egahre atahm?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Owo Jisos kehm-e faange re, “ ‘Esowo, ntul ewa bahke jo kor-a eltim eltim ena, etohko etohko eja, a ntir a ntir enya.’ <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />A wo li ngbokambang a ntahm nyi ga gbal. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Etoono ntahm tob li na li ana nyio o, nyi li re, ‘Nne ebjing ewa jo kor-a ana ebjing eba.’ <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Atahm nya Moses kpee, a eltibi ni abanyehnamahr tohk ntahm ebal nyia.”<note caller="+" style="f"><char style="fr" closed="false">22:40 </char><char style="ft" closed="false">Rom 13:10; Gal 5:14; 1 Jon 4:20-21</char></note><verse eid="MAT 22:40" /></para>
  <para style="s">Mbahbe nyi li bada Mesaya</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mak 12:35-37</ref>; <ref loc="LUK 20:41-44">Luk 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Ngare nyi Bab Farisi ba kono edi ajehng, Jisos kehm bahbe bo mbahbe re, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“Anv, ń kpo tir renan bada Mesaya? Ye mmon a nyehne wo?”</para>
  <para style="p" vid="MAT 22:42">Owo bo kehm-e faange re, “Mmon a Devid wo.”<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Jisos kehm tongo bo re, “Jen ji wahnge Devid lungu Mesaya re, ‘Ntul ewame’, eji Etingi Etohko mehl-e no, á bungu re,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />“ ‘Jehova tongo ntul ewame re,</para>
  <para style="q1" vid="MAT 22:44">Ji go egame ejang eboblum</para>
  <para style="q1" vid="MAT 22:44">tete me n lim anebekv eba etikunakpade eja.’<verse eid="MAT 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45" />“Yefono Devid jo lung-e re, ‘Ntul ewame’, bahke limi renan, ntul noo kehm fere jol mmon ewe?”<note caller="+" style="f"><char style="fr" closed="false">22:45 </char><char style="ft" closed="false">Mat 1:1; Ell 5:5</char></note><verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Nnene jolem, no male elfaange Jisos ellum anehng anehng. Bomo efung bio asongo nnene kpeem jo sahb, bahb-e mbahbe.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Ana Jisos jo rehke ane bade atꞌtibi ba atahm, a Bab Farisi</para>
  <para style="r">(<ref loc="MRK 12:38-39">Mak 12:38-39</ref>; <ref loc="LUK 11:43">Luk 11:43</ref>,<ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45-46">20:45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Jisos kehm tongo ellong ane bao, a abatꞌtoono ebe re, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“Atꞌtibi ba atahm, a Bab Farisi ebko nji nyi Moses. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Jo bumen ejum ajehng ajehng ji bo lꞌtong-n, wahn fere jo lim. Kana jo toono eljini ni bo! Tibre bo kpehme lim ji bo kpo bung.<verse eid="MAT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 23:4" />“Bo kpo tuuru alublub nsol, nya kpo riidi go elsolo, rod si ane. Jol bofono antahng bo kpehme gare elmehle. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Bo kpo lim ejum ajehng ajehng, eji ane lꞌjo nyehn bo. Nyehnen ana awer nya bo kpo kahn go bo abuk, a abo abo kpꞌkpange, nya bo nyono adi nwer Esowo! Nyehnen ana asohk nya bo tohko go asꞌsili akpawobo ebo kpꞌlabe! <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Go elkak, kpo kor bo re, bo ji adi nya fuumu re ajꞌjok ane ji.<note caller="+" style="f"><char style="fr" closed="false">23:6 </char><char style="ft" closed="false">Luk 14:7</char></note> Go ekpꞌkpa ero, kpo kor bo re, bo ji mbuksong. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Go are, kpo kor bo re, ane jo gong kak bo nnyo, fere jo lung bo re atꞌtibi.<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />“Nong, ane ki-n jo lung re atꞌtibi. Tibre nne awohng wo wo li ntꞌtibi ewahne. Wahn kpee abonanyehn ba. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Kana jo lung nne awohng awohng go njini nyia re Nso ejahne. Tibre nne awohng wo wo li Nso ejahne, ye jio ji li go ejahbetul. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Nong, ane ki-n jo lung re atubesi. Tibre nne awohng wo wo li ntubesi ewahne, ye ji li Mesaya.<verse eid="MAT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 23:11" />“Nne no lꞌga gbal go egahne ellong, ye wo bahke jolo nlokeltum ewahne. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Nne awohng awohng no lꞌmehl elne wahre, bo bahk-e rede na. Nne awohng awohng no lꞌrede elne, bo bahk-e mehle wahre.<note caller="+" style="f"><char style="fr" closed="false">23:12 </char><char style="ft" closed="false">Luk 18:14; 1 Pit 5:5</char></note><verse eid="MAT 23:12" /></para>
  <para style="s">Ana Jisos jo wa Bab Farisi eyuu</para>
  <para style="r">(<ref loc="MRK 12:40">Mak 12:40</ref>; <ref loc="LUK 11:39-52">Luk 11:39-52</ref>; <ref loc="LUK 13:34-35">13:34-35</ref>; <ref loc="LUK 20:47">20:47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“Eyuu a nahne, wahn atꞌtibi ba atahm, a Farisis! Wahn aneb alum abal abal ba! Ń kpo bam ejahbetul Esowo tv ane.<note caller="+" style="f"><char style="fr" closed="false">23:13 </char><char style="ft" closed="false">Jon 9:22</char></note> Ń kpehme taame, yake ane ba kpꞌgare re bo yel. Wahnfono antahng nehm yel.<verse eid="MAT 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14" />“Eyuu a nahne, wahn atꞌtibi ba atahm, a Farisis! Wahn aneb alum abal abal ba! Ń kpo nehm akalebun, taare ntahk ebo. Eyaame jehko, ń kpo kak alaabe aro, jo tib elnahne. Tib esi jio ji bahke wahnge elam ejahne sahb gbꞌgbal!<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />“Eyuu a nahne, wahn atꞌtibi ba atahm, a Farisis! Wahn aneb alum abal abal ba! Ń kpo yannge go njini kpee, jo siiri agburu aya, eji ń lꞌlub were nne awohng, á fere yel-n. Ń lꞌting nne, ń rod-e, lim mmon ellulagun no sahb sꞌsab sehnge wahnfono antahng.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />“Eyuu a nahne, wahn awakamahr ane ba kpo tib ane mbang! Ń kpo tib re, ‘Nne awohng awohng no lꞌtir etahk Esowo, ejumjum limm. Wo, nne no lꞌfere tir agul nya li go etahk Esowo, á bahke tiki lim, nehm tiki kane.’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Wahn agboolo awakamahr ba! Anv, ejum aji ga gbal, agul, afi etahk Esowo ji wahnge agul nyao li saang? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Ń kpo kpe tib re, ‘Nne awohng awohng no lꞌtir edi njom alimi, ejumjum limm. Wo, nne no lꞌfere tir ejum njom ji kun edi njom alimi jio, á bahke tiki lim, nehm kane.’<verse eid="MAT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 23:19" />“Wahn agboolo awakamahr ba! Anv, ejum aji ga gbal, ejum njom, afi edi njom alimi ji wahnge ejum njom li saang? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Fvfo, nne lꞌtir edi njom alimi, yebtir edi njom alimi jio, a nsol njom kpee nyi kun o. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Nne no lꞌtir etahk Esowo, yebtir etahk Esowo, a Esowo bi lene o. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Nne no lꞌtir ejahbetul Esowo, yebtir eti etul ji Esowo, a nne no jehk o.<note caller="+" style="f"><char style="fr" closed="false">23:22 </char><char style="ft" closed="false">Mat 5:34</char></note><verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />“Eyuu a nahne, wahn atꞌtibi ba atahm, a Farisis! Wahn aneb alum abal abal ba! Ń kpo ka eltahme go abon asahkesahke nsol ana nkambe, nfehne, a abehne, fere gbake alahmlahm nsol ana elam,<note caller="+" style="f"><char style="fr" closed="false">23:23 </char><char style="ft" closed="false">Hib 9:27</char></note> ndon,<note caller="+" style="f"><char style="fr" closed="false">23:23 </char><char style="ft" closed="false">Luk 1:78; Jems 2:13</char></note> a eltaame,<note caller="+" style="f"><char style="fr" closed="false">23:23 </char><char style="ft" closed="false">Hib 11:6</char></note> bum go nkpe. Limen nsol ebal ebal, kana gbake ajehng bum go nkpe!<verse eid="MAT 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 23:24" />“Wahn awakamahr ane ba kpo tib ane mbang ba! Ń kpo yehke nnyamnyame go egahne alahb elwoko, fere mele ekamel!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />“Eyuu a nahne, wahn atꞌtibi ba atahm, a Farisis! Wahn aneb alum abal abal ba! Tibre ń kpo ru njahm a nkob, a njahm ekpingi. Go atahng, nsol ejv ebrur, a nsol nyi ń kpo lahm ane bako etong.<note caller="+" style="f"><char style="fr" closed="false">23:25 </char><char style="ft" closed="false">Mak 7:4</char></note> <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Wo nwakamahr a nne a Farisi wo! Gbo mbang ru atahng nkob, a atahng ekpingi, eji njahm lꞌtob bar.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />“Eyuu a nahne, wahn atꞌtibi ba atahm, a Farisis! Wahn li ana alahm nya bo ma taame efem go njahm elatahk, ma nob. Go atahng, akahb akvne nya ma rur, a nsol eltehb. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Ana wo fvfo ń tob li. Go njahm elatahk ń kpo jol nne awohng awohng, are ń li nob nob. Go atahng, abꞌbi nya ma rur, a afahnge afahnge.<note caller="+" style="f"><char style="fr" closed="false">23:28 </char><char style="ft" closed="false">Ell 3:1</char></note><verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“Eyuu a nahne, wahn atꞌtibi ba atahm, a Farisis! Wahn aneb alum abal abal ba! Wahn ba kake alahm nya abanyehnamahr Esowo, fere liibi alahm nya atingitingi ane, <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />fere jo bung re, ‘Li re e jolo ngare nyi babnso ejahre, kehn, e jolem limi ana bo limi no, fere wul abanyehnamahr Esowo.’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Wahnfono antahng ebyiimi ntianse re wahn ba li abon ba ane ba wulu abanyehnamahr.<note caller="+" style="f"><char style="fr" closed="false">23:31 </char><char style="ft" closed="false">Elt 7:52,56</char></note> <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Wahn ebba soro asi, kpꞌgohro lim ji babnso ejahne limi no sa.<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />“Wahn enyo bia, wahn abon akumbad baa, ḿ bahke ma for renan go elam ji bo bahk-n lame, kim ebi ka-n, fere kak-n go ellulagun? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Owo wahng ka m bahke tumu abanyehnamahr tv-n, fere tum akahnkahn ane, fere tum atꞌtibi. Egom jindiki, ḿ bahke wulu bo, jindiki, ń kum bo lake go akros, jindiki, ḿ bahke jo dv bo go egahna ntahk ero, fere jo kam bo yannge ajahbe ajahbe ajahbe, <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />eji ń lꞌli ebi tib go atingitingi ane ba bo wulu bo go njini kpee, bomo goji Ebel ji jolo etingi nne tete ba rehng goji Sekaraya ji jolo mmon a Barakaya, ye ji ń wul-e no go elka elka ni etahk Esowo, a edi njom alimi.<verse eid="MAT 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 23:36" />“Etingitingi, n kp-n tongo re, Ane ba li anv bahke lehke ebi tib go nsol nyio kpee.<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“O Jeusalem, Jeusalem! Wahn ba kpꞌwulu abanyehnamahr Esowo, fere tuubu ane ba Esowo tumu bo tv-n atal. Nkpel tvv n jo gare re me n lung-n tv elname, ana nkok kpo lung abon ebe tv elne, fere walle bo go ege akpungkpung. Wahn joom kor elbake.<verse eid="MAT 23:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 23:38" />“Etahk ejahne bahke sake nehme nehme.<verse eid="MAT 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 23:39" />“N kp-n tongo re, Bomo anv asongo, me n nehm kpe nyehn, tete ngare nyi ḿ bahke bungu re, ‘Elfuulu li ka nne no kpꞌbake go mbing nyi Ntul!’ ”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Ana bo bahke rannge etahk Esowo</para>
  <para style="r">(<ref loc="MRK 13:1-2">Mak 13:1-2</ref>; <ref loc="LUK 21:5-6">Luk 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Jisos kehm lohngo go etahk Esowo jio tahm. Abatꞌtoono ebe kehm bake, ba tib-e ntahk nyi bo si go nlaaga nyi etahk Esowo jolo no.<verse eid="MAT 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 24:2" />Owo Jisos kehm faange bo re, “Nyehnen ntahk nyia a kpee! Etingitingi, n kp-n tongo re, Jol eltal anehng anehng limm, ni bahke kpe kuumu a ntem.<note caller="+" style="f"><char style="fr" closed="false">24:2 </char><char style="ft" closed="false">Luk 19:44</char></note> Bo bahke wake kpee, wohng ndi.”<verse eid="MAT 24:2" /></para>
  <para style="s">Erem, a afemfem</para>
  <para style="r">(<ref loc="MRK 13:3-13">Mak 13:3-13</ref>; <ref loc="LUK 21:7-19">Luk 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Eji Jisos song ji go ewong ji bo kpo lung re Oliv, owo abatꞌtoono ebe kehm song kpir-e bo bo, kehm-e bahbe re, “Tong-r ngare nyi ejum jio bahke limi, wo fere tib-r elliingi ni bahke tibi elbake ena ni a bahke bake, a ni esꞌkohro eying jia.”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Owo Jisos kehm faange bo re, “Kunen ekpu, eji nne awohng awohng lꞌki-n nehm. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Tibre ane gbalee bahke bake go egama mbing, jo ba bung re, ‘Me wo li Mesaya.’ Toono o, bo nehm ane gbalee.<note caller="+" style="f"><char style="fr" closed="false">24:5 </char><char style="ft" closed="false">Elt 5:36-37; 1 Jon 2:18</char></note> <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Ḿ bahke kehme elwuku bada nta, fere jo wuk aka nta. Kana jo fahl! Tibre nsol nyia kpee bahke tiki lim, jol o esꞌkohro sang ma rehng na. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Ajahbe nyandiki bahke jo nok atemtem. Ajahbe nyandiki bahke kehme elnoko a atem ajahbe nyako! Njal, a ayam nya kpo sehnge ane, go ndi agbehke bahke jo jol adi adi. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Nsol nyia kpee nyi li mbomannahb erem.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />“Ngare nyio nyi bo bahke jo bob-n, song ka re bo kak-n erem, fere wul-n. Ane kpee bahk-n jo ko ekv tib go egama mbing.<note caller="+" style="f"><char style="fr" closed="false">24:9 </char><char style="ft" closed="false">Jon 16:2; Ell 13:15,17</char></note> <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Ane gbalee bahke kehme elseele gbo, tibre bo bahke jo jabbe atemtem ka go, fere jo ko atemtem ekv.<verse eid="MAT 24:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 24:11" />“Akimfahnge abanyehnamahr gbalee bahke longo ba, ba nehm ane gbalee.<note caller="+" style="f"><char style="fr" closed="false">24:11 </char><char style="ft" closed="false">1 Jon 4:1</char></note> <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Owo eji abꞌbi ma tv ano, elkoro ni ane gbalee bahke kehme elmale.<note caller="+" style="f"><char style="fr" closed="false">24:12 </char><char style="ft" closed="false">2 Tim 3:1-5</char></note> <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Nne no lꞌyiimi tꞌtahne go mbang nyi Esowo tete rehng go esꞌkohro, ye wo bahke bele eltahre. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Ngare nyi bo ma tiingi nnoobo etib bade etul bi Esowo tong njini kpee ana ejum ntianse, owo esꞌkohro bahke kehm rehnge.<verse eid="MAT 24:14" /></para>
  <para style="s">Ejum ji kpꞌsahb sꞌsab</para>
  <para style="r">(<ref loc="MRK 13:14-23">Mak 13:14-23</ref>; <ref loc="LUK 21:20-24">Luk 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“Ḿ bahke nyehne ‘ejum ji kpꞌsahb sꞌsab, ji bahke rannge edi’, ji nnyehnamahr a Daniel bungu no bade, yim go mbarebare edi.<note caller="+" style="f"><char style="fr" closed="false">24:15 </char><char style="ft" closed="false">2 Tes 2:4</char></note> Nne no lꞌlung nsol nyia, nong á kahn.<verse eid="MAT 24:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 24:16" />“Ngare nyio nyi ane ba li go Judea bahke beke, tahm go awong. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Nne no lꞌkuumu go ege ero etahk, á kꞌtohko seb elyele go ekpꞌkpa, song rod ejum fili.<note caller="+" style="f"><char style="fr" closed="false">24:17 </char><char style="ft" closed="false">Luk 17:31</char></note> <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Nne no lꞌjol go ege egbe, á kꞌtohko be, ba etahk, ba rod nsol ebjing enye.<verse eid="MAT 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 24:19" />“Eyuu a anebkal ba bahke jolo ela ngare nyio, a anebkal ba kpi abon go ebo. <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Kaken ero, eji elbeke enahne ni ḿ bahke beke lꞌkꞌjol ngara nnale, kꞌfere jol efung Esabat. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Tibre erem bio bahke gbale sehng. Jol erem ana bio ka jol a jol ejolojolo bomo eji njini bomo no tete rehng anv. Jol nehm kpe tiki jol ano ejolojolo.<verse eid="MAT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 24:22" />“Tohko jol re Esowo tele afung nyao kahbe, nnene nehm jol no bahke bele eltahre. Tib go esi ji ane ba Esowo ma yehke, owo wahnge Esowo bahke tele afung nyao kahbe.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />“Ngare nyio, nne lꞌtong-n re, ‘Nyehnen, Kraist ga!’ afi á tong-n re, ‘Nyehnen Kraist go!’ kana taame tv-e. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Akimfahnge ane bahke lohngo ba, jo ba bung re, Bo ba li Mesaya. Egom jindiki bahke jo bung re, Bo ba li abanyehnamahr Esowo. Bo bahke kehme nliingi tib, fere jo lim akpokosi, eji limi limi kan, bo lꞌnehm aneb Esowo, ba Esowo ma jak.<note caller="+" style="f"><char style="fr" closed="false">24:24 </char><char style="ft" closed="false">2 Tes 2:9; Ell 13:13</char></note> <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Kunen ekpu, m ma-n tong jia ana, re ngare kehm rehnge.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />“Ane lꞌkehm-n tongo re, ‘Nyehnen, ye go elka emahng!’ kana je go! Bo lꞌfere tong-n re, ‘Nyehnen, ye ga nkimi nyia!’ kana taame tv bo. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Ana emangedu kpo lim, lennge duu, bomo go ero nfam tete rehng go erede nfam, ano wo elbake ni Mmon no nne bahke jolo.<note caller="+" style="f"><char style="fr" closed="false">24:27 </char><char style="ft" closed="false">Luk 17:23-24</char></note> <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Tibre edi ajehng ajehng ji ekpakv ejum lꞌnoongo, owo ntere bahke jeke song rur.<note caller="+" style="f"><char style="fr" closed="false">24:28 </char><char style="ft" closed="false">Ell 19:17,21</char></note><verse eid="MAT 24:28" /></para>
  <para style="s">Elbake ni Mmon no nne</para>
  <para style="r">(<ref loc="MRK 13:24-27">Mak 13:24-27</ref>; <ref loc="LUK 21:25-28">Luk 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“Ngare nyi erem bio ma mal,</para>
  <para style="q1" vid="MAT 24:29">“njul bahke dvvrv,</para>
  <para style="q1" vid="MAT 24:29">ebareka nehm kpe jo ya na eyakeyake.</para>
  <para style="q1" vid="MAT 24:29">Alonlo bahke kehme elfooro go elbung gbo.</para>
  <para style="q1" vid="MAT 24:29">Atahm nya elbung bahke range.<note caller="+" style="f"><char style="fr" closed="false">24:29 </char><char style="ft" closed="false">2 Pit 3:10</char></note><verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />“Owo ane bahke kehm nyehne elliingi ni Mmon no nne go elbung. Ane kpee ba li go njini bahke kehme ellingi, fere nyehn Mmon no nne kpꞌbake go akparesemsem, a nsahm a nsahm, a egburu ellub.<note caller="+" style="f"><char style="fr" closed="false">24:30 </char><char style="ft" closed="false">Ell 1:7; 19:11</char></note> <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Owo enjel bahke woro ntang wahre wahre.<note caller="+" style="f"><char style="fr" closed="false">24:31 </char><char style="ft" closed="false">1 Tes 4:16; 1 Kor 15:52; Ell 10:7</char></note> Á bahke tumu babenjel tv ejang njini abehng abehng, a ejang elbung abehng abehng, eji bo lꞌsong ko ane ba á jake bo, ba a bo edi ajehng.<verse eid="MAT 24:31" /></para>
  <para style="s">Ejum elkpili ji li bade efig</para>
  <para style="r">(<ref loc="MRK 13:28-31">Mak 13:28-31</ref>; <ref loc="LUK 21:29-33">Luk 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“Kpilen ejum go elgan ni li bade eti ji bo kpo lung re efig.<note caller="+" style="f"><char style="fr" closed="false">24:32 </char><char style="ft" closed="false">Luk 13:6-9; Elt 15:16</char></note> Eji eti jio ma nyono, fere kak anyane, owo ḿ bahke kahne re, nnale ebba. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Tob li ka-n fvfo re, ń lꞌnyehn nsol nyio kpꞌlimi, owo ḿ bahke kehm kahne re, ngare ebkabbe kpidi kpidi.<verse eid="MAT 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 24:34" />“Etingitingi, n kp-n tongo re, Ane bao ba bahke jolo go elkpin ngare nyio, bo nehm kpo, tete nsol nyio lim kpee. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Elbung abola ndi bahke tane, alum enyame nehm tiki tan.”<verse eid="MAT 24:35" /></para>
  <para style="s">Nnene limm, no kpꞌkahne ngare nyio</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mak 13:32-37</ref>; <ref loc="LUK 17:26-30">Luk 17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“Nnene nehme kahn efung bio, a ngare nyio, jol babenjel ba li go ejahbetul Esowo nehme kahn, jol Mmon nehme kahn, sehngem Nsoo ntahngtahng wo kpꞌkahne.<note caller="+" style="f"><char style="fr" closed="false">24:36 </char><char style="ft" closed="false">Elt 1:7</char></note><verse eid="MAT 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 24:37" />“Ana jolo go ngare nyi Noa, ano wo fvfo bahke tob jol ngare nyi Mmon no nne bahke bake. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Ana wo jolo no ngare nyi nnyel nyi bulu njini kala yel. Ane bao jo li nsol, fere jo wꞌwo. Aneblum jo ko akal, anebkal jo bal alum tete rehng efung bi Noa yele go egbang. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Tvtv o bo joom kahn ji kpꞌlꞌlim, tete nnyel yel, ba feenge bo kpee, tahm abo.</para>
  <para style="p" vid="MAT 24:39">“Ano wo fvfo bahke tob jol ngare nyi Mmon no nne bahke bake.<note caller="+" style="f"><char style="fr" closed="false">24:39 </char><char style="ft" closed="false">2 Pit 3:5-7</char></note> <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Ngare nyio ane abal bahke jolo go egbe, noko, bo bahk-e koko, noko sa. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Anebkal abal bahke jo gok nsol, noko, bo bahk-e koko, noko sa.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />“Jo baaben, tibre ń nehme kahn efung bi Ntul ewahne bahke bake. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Ji fuumu re wahn kahn, li re, nfontahk kꞌkahn ngare nyi nwajv bahke bake atv, kehn á jol baabe, á jolem taame re, bo ba lahm etahk eje ye.<note caller="+" style="f"><char style="fr" closed="false">24:43 </char><char style="ft" closed="false">Luk 12:39-40</char></note> <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Owo fvfo nobo re wahn toobo ebjing kpee. Tibre Mmon no nne bahke gbede na ba ngare nyi ń ki bum re á kpꞌbake.<verse eid="MAT 24:44" /></para>
  <para style="s">Nnooba nlokeltum, a ebi nlokeltum</para>
  <para style="r">(<ref loc="LUK 12:41-48">Luk 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“Nne awo li ekahnkahn nlokeltum no kpi ekakesehk? Ye wo li nne no nde ma yake alokeltum bako kak go ege ebo re á jo le bo go ngare.<note caller="+" style="f"><char style="fr" closed="false">24:45 </char><char style="ft" closed="false">Jon 21:15,17</char></note> <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Eyebatahng bahke jolo a nlokeltum noo no nde lꞌba, á bahke ba kpir-e, á kpꞌlimi ano.<note caller="+" style="f"><char style="fr" closed="false">24:46 </char><char style="ft" closed="false">1 Kor 4:2</char></note> <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Etingitingi, n kp-n tongo re, Nde bahke faake a nsol enye kpee, kak-e go ebo.<note caller="+" style="f"><char style="fr" closed="false">24:47 </char><char style="ft" closed="false">Mat 25:21,23</char></note><verse eid="MAT 24:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 24:48" />“Á lꞌfere jol ebi nlokeltum, á bahke bungu go ege eltim re, ‘Nsoo nehme waka ba.’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />Á bahke kehme alokeltum bako dv, fere jo jen a abawokamahm, jo li nsol a bo, fere jo wꞌwo. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Owo nde nlokeltum noo bahke kehnge efung bi á ki ekpu kunu, a ngare nyi á kil kahne. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Nde bahk-e bomo, kiimi akv akv akv, fere rod-e, kak edi ji ane ba kpi alum abal abal wob no. Owo ane bahke woomo, jo ling, fere jo kono amahn go esi.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Elgan ni li bada ngbahme na ewubu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />“Etul bi Esowo bahke jolo ana ngbahme na ewubu nyi rodo atꞌrekahng ebo, tahm re bo song wane nlumanne.<note caller="+" style="f"><char style="fr" closed="false">25:1 </char><char style="ft" closed="false">Luk 12:35-36; Ell 19:7</char></note> <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Ngbahme na elon jolo akahnkahn. Ngbahme nyehko na elon jolo agboolo. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Agboolo agbahme nyao rodo atꞌrekahng ebo, akehng bo filem. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Akahnkahn agbahme nyao rodo atꞌrekahng, fere fili akpuma akehng budu.<verse eid="MAT 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 25:5" />“Eji nlumanne laange elbake, agbahme nyao kpee kehm kehme amahke lal, soro sa lal. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />Nlum atv, nne jo rꞌrabe re, ‘Nyehnen, nlumanne kpꞌbake! Songen, wahn song wan-e!’<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />“Agbahme nyao kpee kehm mehle, toobo atꞌrekahng ebo bum. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Owo agboolo nyao kehm tongo akahnkahn re, ‘Nyahken akehng emahne ka-r, tibre atꞌrekahng enyahre yahke lahme.’<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />“Owo akahnkahn kehm faange bo re, ‘Akehng maa nehm biingi rehng egahne. Songen goji abajenare, wahn song gunu antahng.’<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />“Eji bo tahme no re bo song gunu akehng, nlumanne kehm bake. Ane bao ba toobo ebjing kehm tahme toon-e, song rehng go elkak elbal. Bo kehm bame mbu.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />“Ji kan a, agbahme nyako kehm tob ba, ba kehme elbungu re, ‘Nsoo, nsoo, lenng-r mbu!’<note caller="+" style="f"><char style="fr" closed="false">25:11 </char><char style="ft" closed="false">Luk 13:25-27</char></note><verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />“Owo á kehm faange bo re, ‘Etingitingi, n kp-n tongo re, Wahn n nehme kahn!’ ” <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />Jisos kehm gohro bung re, “Jo kunen ekpu, tibre n nehme kahn efung, a ngare nyi Mmon no nne bahke bake.<verse eid="MAT 25:13" /></para>
  <para style="s">Elgan ni li bade alokeltum na ara</para>
  <para style="r">(<ref loc="LUK 19:11-27">Luk 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />“Etul bi Esowo bahke jolo ana nne no yahke ba eltahme eljen. Á kehm lungu alokeltum ebe, yake nsol enye, kak go bo abo.<note caller="+" style="f"><char style="fr" closed="false">25:14 </char><char style="ft" closed="false">Mat 21:33</char></note> <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Á ka nne awohng awohng ana á bahke ma lim. Noko, á ka-e ekpa akpohko eblon, noko, ekpa akpohko ebbal, noko ajehng, kehm soro tahm eje.<note caller="+" style="f"><char style="fr" closed="false">25:15 </char><char style="ft" closed="false">Rom 12:6</char></note> <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Nne no ko ekpa akpohko eblon kehm soro tahm, song jen are, li nsehng go ekpa akpohko eblon. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Ano wo nne no ko ekpa ebbal tob li nsehng ekpa ebbal fvfo. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Nne no ko ekpa ajehng kehm song rahm elbing, rod akpohko nde, kak o behr.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />“Eji ma sahb kꞌkang, nde alokeltum bao kehm kehnge, kehm ba tong alokeltum ebe re, bo ba toobo akpohko enye ka-e.<verse eid="MAT 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 25:20" />“Nlokeltum no ko ekpa akpohko eblon kehm koko ekpa akpohko eblon behko budu, ba a bi, kehm bungu re, ‘Nsoo, a ka-m ekpa akpohko eblon, nyehn ekpa akpohko eblon behka gana bi m ma li nsehng.’<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />“Owo nde kehm-e tongo re, ‘Woblim sehng, nkakesehk a nlokeltum no nno. Eji a bele ekakesehk go abonsꞌsohko abon nsol, m bahke yake agburu nsol, kak-a go ebo.<note caller="+" style="f"><char style="fr" closed="false">25:21 </char><char style="ft" closed="false">Luk 16:10</char></note> Ba yel ga, wo bel eyebatahng ana n kpi no.’<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />“Nne no ko ekpa akpohko ebbal kehm tob ba, ba bung re, ‘Nsoo, a ka-m ekpa akpohko ebbal, nyehn ekpa ebbal behka bi m ma li nsehng.’<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />“Owo nde kehm-e tongo re, ‘Woblim sehng, nkakesehk a nlokeltum no nno. Eji a bele ekakesehk go abonsꞌsohko abon nsol, m bahke yake agburu nsol, kak-a go ebo. Ba yel ga, wo bel eyebatahng ana n kpi no.’<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />“Nne no ko ekpa akpohko ajehng kehm tob ba, ba bung re, ‘Nsoo, n kpꞌkahne re, wo ebibbib nne ji. Á kpo kpa ji a ki bahm, fere fv nya a ki kak. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />N jo fꞌfahl, owo n kehm tahme song behr akpohko enya go ndi. Nyehn nyanya ana.’<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />“Owo nde kehm-e faange re, ‘Wo ebi nlokeltum wo, no ma gbo ewon. Á kꞌkahn re, n kpo kpa ji n ki bahm, fere fv nya n ki kak. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Kehn nde, a jol kake abajenare akpohko enyame, n lꞌba, m ba ko, fere ko nsehng budu.<note caller="+" style="f"><char style="fr" closed="false">25:27 </char><char style="ft" closed="false">2 Kor 6:1</char></note> <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Taaren ye ekpa akpohko jio, wahn ka nne no kpi ekpa ebwubu.<verse eid="MAT 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 25:29" />“ ‘Tibre nne awohng awohng no kpi no, bo bahk-e kake na budu, á bel gbalee. Nne no ki kpi, jol ntiil ana á kpi no, bo bahk-e taare na. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Roden edemme nlokeltum noa, ro tv elatahk edi ejannge. Owo nne bahke woomo, jo ling, fere jo kono amahn go esi.’<verse eid="MAT 25:30" /></para>
  <para style="s">Ana Mmon no nne bahke lame njini</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“Ngare nyi Mmon no nne bahke bake go ege ellub, a enjel kpee, á bahke jehke go eti etul jio ji ellub ene.<note caller="+" style="f"><char style="fr" closed="false">25:31 </char><char style="ft" closed="false">Ell 20:11-15</char></note> <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Ane ba li go njini kpee, bo bahke koko bo, ba yiimi go ege esamahr. Owo á bahke kehm yabe bo ana mbaabebul kpo yab ejoro, bum eje eje, ebulbaange jol eje eje.<note caller="+" style="f"><char style="fr" closed="false">25:32 </char><char style="ft" closed="false">Jon 5:29</char></note> <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Á bahke rodo ejoro, bum ege ejang eboblum, fere rod ebulbaange, bum ege ejang ebobkal. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Owo ntul bahke kehm tongo ane ba yiim-e go ege ejang eboblum re, ‘Baan, wahn jia ji Nsoo ma-n fuulu! Baan, wahn ba li etul bi Esowo ma toobo bum-n, bi lohng eji njini bomo na bom. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Tibre njal jo yam-m yam, ń jo ka-m, n li. Alahb kor-m kor, ń ka-m, n wo. N yel-n ejen, ń vvr-m. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />N jolo ebun ebun, ń ka-m, m bobo. N jo yꞌyam, ḿ ba, ba nyehn-m. N woomo go ngbekobo, ḿ ba, ba nyehn-m.’<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />“Owo atingitingi ane bao bahk-e kehm faange re, ‘Ntul, ntahn wo e nyehn-a no, njal ma-a yam, e ka-a, a li? Ntahn wo e nyehn-a no, alahb ma-a kor, e ka-a, a wo? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Ntahn wo e nyehn-a no ana njenne, e kehm-a vvrv?<note caller="+" style="f"><char style="fr" closed="false">25:38 </char><char style="ft" closed="false">Hib 13:2</char></note> Ntahn wo e nyehn-a ebun ebun, e kehm-a kake, a bobo? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Ntahn wo e nyehn-a no, a kpꞌyame, jol go ngbekobo, e kehm ba nyehn-a?’<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />“Owo ntul noo bahke kehm faange bo re, ‘Etingitingi, n kp-n tongo re, Ngare anyehng anyehng nyi ń jo lim ano ka nne awohng no sahb rꞌrede go ellong abonanee ba li a, ń jo limi ka me.’<note caller="+" style="f"><char style="fr" closed="false">25:40 </char><char style="ft" closed="false">Hib 2:11</char></note><verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />“Owo á bahke kehm tongo ane ba yiim-e go ege ejang ebobkal re, ‘Fak-m wahn go esamahr, wahn ji Esowo ma-n su. Songen go ellulagun ni li go njinanjini, ni bo ma toobo bum nnehm, a enjel enye.<note caller="+" style="f"><char style="fr" closed="false">25:41 </char><char style="ft" closed="false">Ell 20:10,15</char></note> <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Tibre njal yam-m yam, me ń kaam, n li. Alahb kor-m kor, me ń kaam, n wo. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />N yel-n ejen, me ń vvrem. N jolo ebun ebun, me ń kaam, m bobo. N jo yꞌyam, fere woomo go ngbekobo, ḿ baam, ba nyehn-m.’<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />“Owo bofono bahke tob faange re, ‘Ntul, ntahn wo e nyehn-a no, njal kp-a yame, alahb jo kor-a? Ntahn wo e nyehn-a no ana njenne? Ntahn wo e nyehn-a no ebun ebun? Ntahn wo e nyehn-a no, a kpꞌyame? Ntahn wo e nyehn-a no, a wob go ngbekobo? Ntahn wo e nyehn-a ano, ki-a kak ebo?’<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />“Owo á bahke kehm faange bo re, ‘Etingitingi, n kp-n tongo re, Ngare anyehng anyehng nyi ń ki jo lim ano ka nne awohng no sahb rꞌrede go ellong abonanee ba li a, ń limem ka me.’<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />“Ane baa bahke song yel go edi erem, jo nyehn erem o go njinanjini. Atingitingi ane bahke bele elkpin ni li go njinanjini.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Ana bo lame kak Jisos</para>
  <para style="r">(<ref loc="MRK 14:1-2">Mak 14:1-2</ref>; <ref loc="LUK 22:1-2">Luk 22:1-2</ref>; <ref loc="JHN 11:45-53">Jon 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Eji Jisos ma bung alum nyaa kpee mal, á kehm tongo abatꞌtoono ebe re, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Ń kpꞌkahne re, lela ebsa nfung ebal, elkak Pasova rehng. Efung bio bi bo bahke jabbe Mmon no nne ka re bo kum-e go ekros.”<note caller="+" style="f"><char style="fr" closed="false">26:2 </char><char style="ft" closed="false">1 Kor 5:7</char></note><verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Owo atubesi abalimajom, a anebkul nfam kehm song kono go nlaaga ntubesi abalimajom no bo jo lung-e re Kayafas. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Owo bo toobo no ana bo bahke bobo Jisos mbehr mbehr, song wul.<verse eid="MAT 26:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 26:5" />Bo jo bungu re, “Nong, wahr kꞌlim ngare elkak, eji lꞌkꞌgbo ntong.”<verse eid="MAT 26:5" /></para>
  <para style="s">Ana bo wohngo Jisos akehng</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mak 14:3-9</ref>; <ref loc="JHN 12:1-8">Jon 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Eji Jisos jolo go Betani go etahk Saimon ji nne abili, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />nnenkal awohng kehm bake go ege, no fili elom akehng ji nno a nno, ji sahb kꞌkim ekun. Á kehm yaange akehng mao, kak-e go esi ngare nyi á jehk go ekpꞌkuru kpi nsol li.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Eji abatꞌtoono ebe nyehne ano, atahng kehm rake bo. Bo kehm bahbe re, “Jen ji wahnge á kpꞌfade akehng ana maa? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Kehn akehng maa bo jol gungu, ko akpohko gbalee, fere ko, ka akpak.”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Jisos sebe kan kahn ana bo jo bung, á kehm tongo bo re, “Jen ji wahnge ń kpꞌgbiingi mmonankal noa? Yeblim nnoobo ka-m. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Akpak li a nahne ngare anyehng anyehng, wo, me n limm a nahne ngare anyehng anyehng. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Tibre eji mmonankal noa wohng-m akehng go egama ngubjing, á toobo ebjing ebame bum, bi m bahke kpoko.<note caller="+" style="f"><char style="fr" closed="false">26:12 </char><char style="ft" closed="false">Mak 16:1</char></note> <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Etingitingi, n kp-n tongo re, Edi ajehng ajehng go njini kpee, ji bo bahke tiingi nnoobo etib bia, bo bahke tob jo bung jia ji nnenkal noa ma lim, fere jo buum-e.”<verse eid="MAT 26:13" /></para>
  <para style="s">Ana Judas gungu Jisos</para>
  <para style="r">(<ref loc="MRK 14:10-11">Mak 14:10-11</ref>; <ref loc="LUK 22:3-6">Luk 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Nne awohng go ellong abatꞌtoono Jisos, ewubu ane abal, no bo jo lung-e re Judas Iskariot kehm tahme, song kpiri atubesi abalimajom, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />kehm bahbe bo re, “Ejum aji ḿ bahk-m kake, n lꞌjabbe Jisos, kak-n go ebo?”</para>
  <para style="p" vid="MAT 26:15">Bo kehm-e kake mpon esehma.<note caller="+" style="f"><char style="fr" closed="false">26:15 </char><char style="ft" closed="false">Jon 11:57; 1 Tim 6:9-10</char></note> <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Bomo ngare nyio asongo, Judas kehm kehme mbang seb ana nyi á bahke jabbe Jisos ka bo.<verse eid="MAT 26:16" /></para>
  <para style="s">Ana Jisos li elkak Pasova, a abatꞌtoono ebe</para>
  <para style="r">(<ref loc="MRK 14:12-21">Mak 14:12-21</ref>; <ref loc="LUK 22:7-14">Luk 22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Jon 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Ngbokambang efung elkak ni Jus kpo li abred nya bo kil jo kak ayist, abatꞌtoono Jisos kehm ba kpir-e, fere bahb-e re, “Gan wo a kpꞌsebe re wahr song toobo nsol alehke nyi elkak Pasova bum-a?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Á kehm tongo bo re, “Songen go nla ejahbe goji nne awohng, wahn song tong-e re, ‘Ntꞌtibi re, Ngare enyame ebkabbe. M bahke lehke elkak Pasova, a abatꞌtoono ebame go ega etahk.’ ”<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />Abatꞌtoono Jisos kehm song toobo nsol elkak Pasova nio bum, ana Jisos tongo bo.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Eji elgung ma ba, Jisos kehm song ji go ekpꞌkuru, jo li nsol, a abatꞌtoono ebe, ewubu ane abal. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Eji bo jo li nsol o, á kehm bungu re, “Etingitingi, n kp-n tongo re, Nne awohng ewahne bahk-m jabbe ka go.”<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Ndon kehm fili bo. Bo kehm-e kehme elbahbe. No nne re, “Nsoo, me wo afi?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Owo á kehm faange bo re, “Nne no kpꞌna tohko ebred eje ekpingi ajehng a name, ye wo li nne no bahk-m jabbe ka.<note caller="+" style="f"><char style="fr" closed="false">26:23 </char><char style="ft" closed="false">Jon 13:18</char></note> <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Mmon no nne bahke kpoko jang jang ana bo nyono bada ne. Eyuu a nne no bahke jabbe Mmon no nne ka.<note caller="+" style="f"><char style="fr" closed="false">26:24 </char><char style="ft" closed="false">Luk 17:1</char></note> Jol ga nob, li re nne noo bo we jelem.”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Judas ji gung-e no kehm bahbe re, “Ntꞌtibi, anv, me woa?”</para>
  <para style="p" vid="MAT 26:25">Jisos kehm-e faange re, “Ee, wo wo.”<verse eid="MAT 26:25" /></para>
  <para style="s">Nsol alehke nyi elbuumu Jisos</para>
  <para style="r">(<ref loc="MRK 14:22-26">Mak 14:22-26</ref>; <ref loc="LUK 22:15-20">Luk 22:15-20</ref>; <ref loc="1CO 11:23-25">1 Kor 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Eji bo kpi nlehke nlehke nsol, Jisos kehm rodo ebred, kak Esowo saam, fere bakke, ka abatꞌtoono ebe, kehm bungu re, “Koon, wahn li! A wo li ngubjing enyame.”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Owo á kehm rodo nkob, kak Esowo saam, kehm kake bo, kehm bungu re, “Woon, wahn ane kpee! <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Tibre a wo li alung emame ma egbanngalung ji nfenfe, ma kpꞌfabe ka ane gbalee, eji bo lꞌbel eltahmeka go bo abiafem. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />N kp-n tongo re, N nehm kpe wo alahb avain maa tete efung bio rehng bi m bahke kpe wo a nahne go ejahbetul ji Nsoo.” <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" />Owo bo kehm yimi ese, kehm lohngo tahm go ewong ji bo kpo lung re Oliv.<note caller="+" style="f"><char style="fr" closed="false">26:30 </char><char style="ft" closed="false">Luk 22:39; Jon 18:1-2</char></note><verse eid="MAT 26:30" /></para>
  <para style="s">Ana Jisos nyehne amahr bade ana Pita bahk-e tene</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mak 14:27-31</ref>; <ref loc="LUK 22:31-34">Luk 22:31-34</ref>; <ref loc="JHN 13:36-38">Jon 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Owo Jisos kehm tongo bo re, “Atv maa ḿ bahke dulu tib esi ejame. Tibre bo nyono go nwer Esowo re,</para>
  <para style="q1" vid="MAT 26:31">“ ‘M bahke wulu mbaabebul,</para>
  <para style="q1" vid="MAT 26:31">ejoro bahke yaame ebo.’<note caller="+" style="f"><char style="fr" closed="false">26:31 </char><char style="ft" closed="false">Jon 16:32</char></note><verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />Ngare nyi m ma nyahme, m bahk-n gboko mbang, song rehng go Galili.”<note caller="+" style="f"><char style="fr" closed="false">26:32 </char><char style="ft" closed="false">Mat 28:7</char></note><verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Owo Pita kehm-e faange re, “Afi ane baka kpee dulu na, me, wa n nehm be sa.”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Owo Jisos kehm-e tongo re, “Etingitingi, n kp-a tongo re, Atv maa, re nkok kehm kuku, a bahke gbaame nkpel era re, me a nehme kahn.”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Pita kehm-e faange re, “Afi elkv ni m bahke kpoko a na, wa n nehm tiki ten.”</para>
  <para style="p" vid="MAT 26:35">Abatꞌtoono bako kpee tob bung ano fvfo.<verse eid="MAT 26:35" /></para>
  <para style="s">Ana Jisos kake ero go Gesemani</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mak 14:32-42</ref>; <ref loc="LUK 22:39-46">Luk 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Owo Jisos kehm koko abatꞌtoono ebe, tahm a bo song rehng go edi ji bo jo lung re Gesemani, kehm tongo bo re, “Jiin ana, tete me n song kak ero o feere.”<verse eid="MAT 26:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 26:37" />Á kehm rodo Pita, a abon abal ba Sibidi, tahm a bo. Ndon kehm-e kehme elfili, ala fere jo teel-e.<note caller="+" style="f"><char style="fr" closed="false">26:37 </char><char style="ft" closed="false">Hib 5:7</char></note> <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Á kehm tongo bo re, “Eltim ename ebjol ndon ndon sehng, rehng go elkv. Jiin a, wahn jo tob-m elbaabe.”<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Á kehm reenge je go esꞌsong, song gbo, kohk esamahr ndi, kehm kehme ero kak re, “Nsoo, tohko ga tahne, fak-m nkob erem nyia. Ana koro me sang, ana koro wo wo.”<note caller="+" style="f"><char style="fr" closed="false">26:39 </char><char style="ft" closed="false">Jon 12:27; Hib 5:8; Fil 2:8</char></note><verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Á kehm feere ba kpiri abatꞌtoono ebe kpꞌlale, kehm tongo Pita re, “Ḿ maam ji awa anyehng nya nya tob-m elbaaba? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Jo baaben, wahn jo kak ero, eji ń lꞌkꞌyel go elgaare. Etohko, mbang nyi Esowo kp-e koro, wo ga, ngubjing kpꞌleenge.”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Á kehm kpe feere, song kak ero re, “Nsoo, lꞌfere jol nyi m bahke woko go nkob nyia, a tohko fere fak-m nkob nyia go elbohngo, nong, mbang enya lim!”<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Eji á kpe feere ba, á kehm kpe ba nyehn bo kpꞌlale. Tibre akpakamahr lubu bo ellu ellu.<note caller="+" style="f"><char style="fr" closed="false">26:43 </char><char style="ft" closed="false">Rom 7:22-23</char></note><verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />Jisos kehm kpe tahm bo sa, kpe song kak ero bꞌnehm. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Á kehm kpe feere ba kpiri abatꞌtoono ebe, kehm tongo bo re, “Ń kpi nlale nlala, fere jo re ekva? Ngare ebkabbe na a, nyi bo bahke jabbe Mmon no nne, kak aneb abiafem go ebo. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Mehlen, wahr tahmen! Nyehnen, nne no bahk-m jabbe ka, ma kabbe a.”<verse eid="MAT 26:46" /></para>
  <para style="s">Ana bo bobo Jisos</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mak 14:43-50</ref>; <ref loc="LUK 22:47-53">Luk 22:47-53</ref>; <ref loc="JHN 18:3-12">Jon 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Eji Jisos kpi mbungu mbungu, Judas ji woomo go ellong abatꞌtoono ebe, ewubu ane abal, kehm ba lohng, a ellong ane gbalee ba fili akahngkahng, a atahmtahm. Atubesi abalimajom, a anebkul nfam ba tumu bo.<verse eid="MAT 26:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 26:48" />Nne no gung-e no tongo ane bao wuku wuku ana bo bahke liingi Jisos. Á tongo bo re, “Nne no n lꞌsod-e nnyo, ye wo, ḿ bahk-e bobo.” <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Owo á kehm soro sehng na sehng, song rehng goji Jisos, kehm bungu re, “Ntꞌtibi, n kp-a kake nnyo,” kehm soro sod-e nnyo.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Jisos kehm-e bahbe re, “Mbi, a ba jen?”</para>
  <para style="p" vid="MAT 26:50">Owo bo kehm bake, ba bob Jisos. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Nne awohng go ellong ane ba jolo a Jisos o kehm wobo ekahngkahng ebe go mbak, kpale nlokeltum a ntubesi abalimajom etung.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Owo Jisos kehm-e tongo re, “Feere a ekahngkahng eba, wo kak go mbak! Tibre ane ba kpo nok abohng akahngkahng, bo bahke kpoko elkv akahngkahng. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Anv, a nehme kahn re, n jol ma gboongo Nsoo, á tum sehnge nlong enjel ewubbal re bo ba kak-m eboa?<note caller="+" style="f"><char style="fr" closed="false">26:53 </char><char style="ft" closed="false">Jon 10:18</char></note> <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Wo, lꞌfere jol ano, adi nwer Esowo nya bungu bade elkv ename bahke kehm jolo go etingitingi renan?”<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Owo Jisos kehm bungu tong ellong ane bao re, “Anv, ń lohngo ba a akahngkahng, a atahmtahm re wahn ba bob-m ana n li nwajva? Efung abehng abehng n jo ji go etahk Esowo, jo tib-n, me ń tikem bob. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Nyaa kpee limi, eji alum nya abanyehnamahr Esowo nyono no lꞌlohko jol go etingitingi.”<note caller="+" style="f"><char style="fr" closed="false">26:56 </char><char style="ft" closed="false">Mat 26:31</char></note></para>
  <para style="p" vid="MAT 26:56">Abatꞌtoono ebe kpee kehm-e yaame sa, be ebo tahm.<verse eid="MAT 26:56" /></para>
  <para style="s">Ana Jisos yiimi go esamahr elam</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mak 14:53-65</ref>; <ref loc="LUK 22:54-55">Luk 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Jon 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Ane ba bobo Jisos kehm-e koko, tahm a ne go etahk Kayafas ji jolo ntubesi abalimajom. Owo atꞌtibi ba atahm, a anebkul nfam kono asi. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Jisos jo jene ekv. Pita jen ekv, á kehm ba rehng go nlaaga ntubesi abalimajom, kehm song ji a alokeltum nfontahk, eji á lꞌnyehn ji bahke jolo.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Atubesi abalimajom, anebkul nfam, a atul esub jo sebe mbang ana nyi bo bahke kiimi afahnge lake Jisos, toono o, bo wul-e. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Bo tikem kahn mbang anyehng anyehng, jol eji akimfahnge atianse gbalee lohngo lohng ba yiimi.</para>
  <para style="p" vid="MAT 26:60">Esꞌkohro, akimfahnge atianse na abal kehm gohro lohng ba yiimi, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />fere bung re, “Nne noa tongo re, á bahke ma wa etahk Esowo, fere tuungu si go nfung era.”<note caller="+" style="f"><char style="fr" closed="false">26:61 </char><char style="ft" closed="false">Jon 2:19-21</char></note><verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Owo ntubesi abalimajom kehm mehle yiimi, kehm bahbe Jisos re, “A nehm faanga? Ejum aji ane baa kpꞌbungu tob-a?”<verse eid="MAT 26:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MAT 26:63" />Jisos belle na eje.</para>
  <para style="p" vid="MAT 26:63">Ntubesi abalimajom kehm-e kpe tong re, “N kpa rehke go esamahr Esowo bi li go elkpin re wo tong-r joare wo Mesaya wo, ji li Mmon no Esowo.”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Owo Jisos kehm-e faange re, “Me wo. N kp-a tongo re, Bomo anv asongo ḿ bahke nyehne Mmon no nne jehk go ejang eboblum bi Esowo bi gbale sehng, ń fere nyehn-e á kpꞌbake go akparesemsem.”<note caller="+" style="f"><char style="fr" closed="false">26:64 </char><char style="ft" closed="false">Mat 24:30; Ell 14:14</char></note><verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Owo ntubesi abalimajom noo kehm yare ewobo eje, kehm bungu re, “Yebsu Esowo! Ntianse anyehng anyehng e nehme kpe seb. Wahnfono antahng ebwuk abꞌbi alum nya á ma bung.<verse eid="MAT 26:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 26:66" />“Ń tiri renan?” Bo kehm faange re, “Yebli ebi ji fuumu re bo wul-e.”<note caller="+" style="f"><char style="fr" closed="false">26:66 </char><char style="ft" closed="false">Jon 10:33; 19:7</char></note><verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Bo kehm soko atel wohng-e go ege esamahr, fere dv-e. Egom jindiki jo ruum-e nkpal, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />fere jo bung re, “Mesaya, nyehn-r amahr, wo fere tong-r nne no rum-a no.”<verse eid="MAT 26:68" /></para>
  <para style="s">Ana Pita tene Jisos</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mak 14:66-72</ref>; <ref loc="LUK 22:56-62">Luk 22:56-62</ref>; <ref loc="JHN 18:15-18">Jon 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Pita ji eje ga elatahk. Nlokeltum awohng no jolo nnenkal kehm lohngo ba rehng go ege, kehm-e tongo re, “Wo fvfo, a tob jolo a Jisos ji Galili.”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Á kehm gbaame go esamahr ane bao kpee re, “N nehme kahn ejum ji a kpꞌbꞌbung.”<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Eji Pita ma tahm, song rehng go mbuga, nnenkal noko kehm-e kpe nyehn, kehm tongo ane ba jolo ona re, “Ye jia tob jolo a Jisos ji Nasaret.”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Á kehm kpe gbaame, fere tir re, “Nne noo, we n nehme kahn.”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Eji ma ji mmokidi, ane ba yiimi kohlo o kehm bake ba kpiri Pita, kehm-e tongo re, “Etingitingi, a tob wob go bo ellong. Tibre alum nya a kpꞌbungu, nya nya kpꞌtibi ejahbe ji a lohng no.”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Pita kehm tiri re, “Esowo demm-m na demme. N nehme kahn nne noo.”</para>
  <para style="p" vid="MAT 26:74">Tvtv ona nkok kehm soro kuk.<verse eid="MAT 26:74" /></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75" />Pita kehm soro buumu alum nya Jisos tong-e re, “Re nkok kehm kuku, a bahk-m tene nkpel era.” Pita kehm lohngo ona, song kehme ellingi ndon ndon.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Ana bo ko Jisos, tahm a ne goji Pailet, nne a Rom no jo fili Juda</para>
  <para style="r">(<ref loc="MRK 15:1">Mak 15:1</ref>; <ref loc="LUK 23:1-2">Luk 23:1-2</ref>; <ref loc="JHN 18:28-32">Jon 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Eji efungfu se no, atubesi abalimajom kpee, a anebkul nfam kehm toobo ana bo bahke wulu Jisos. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Eji bo m-e kak agbekobo, bo kehm-e koko, tahm a ne, song yak-e kak Pailet go ebo, ye ji jolo ntubesi ejahbe.<verse eid="MAT 27:2" /></para>
  <para style="s">Ana Judas kpo no</para>
  <para style="r">(<ref loc="ACT 1:18-19">Elt 1:18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Eji Judas ji gung-e no nyehne re, Jisos ebli ebi, á kehm gboko ndon, fere rod mpon esehma nyio, feere a nyi re á song ka atubesi abalimajom, a anebkul nfam,<note caller="+" style="f"><char style="fr" closed="false">27:3 </char><char style="ft" closed="false">Mat 26:15</char></note> <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />kehm bungu tong bo re, “Me n lim abiafem, eji n gungu nne no ki lim ebi ajehng ajehng.”</para>
  <para style="p" vid="MAT 27:4">Bo kehm-e faange re, “O elam ejahre sang, nfem enya nyi go.”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Á kehm saade akpohko nyao, kak go etahk Esowo, kehm tahme eje, song kahn elne ekehd.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Atubesi abalimajom kehm rodo akpohko nyao, fere bung re, “Abi akpohko nyaa, akpohko alung nya. Fuumem re, akpohko nyaa woomo semme a akpohko ayare.”<verse eid="MAT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 27:7" />Bo kehm toobo, rod akpohko nyao, song gunu edi egbe ji jolo ji ntokatu, eji bo lꞌjo kpa ajahmjahm kak edi ndi jio. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Owo wahnge bo kpo lung edi ndi jio re, “Egbe alung”, tete sik anv.<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />Owo kehm lohko jol go etingitingi ana nnyehnamahr Jeremaya bungu no re, “Bo rodo mpon esehma nyio nyi jolo ekun bi aneb Israel taame re bo ka go ege esi, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />song gunu edi egbe ji ntokatu, ana Jehova tong-m no.”<verse eid="MAT 27:10" /></para>
  <para style="s">Ana Pailet jo bahb Jisos abahbe</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mak 15:2-5</ref>; <ref loc="LUK 23:3-5">Luk 23:3-5</ref>; <ref loc="JHN 18:33-38">Jon 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Jisos kehm song yiimi go esamahr ntubesi ejahbe no bahb-e re, “Wo wo li ntul no Jusa?”</para>
  <para style="p" vid="MAT 27:11">Jisos kehm-e faange re, “Ee, me wo.”<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Eji atubesi abalimajom, a anebkul nfam jo ka-e ebi, ejumjum á faangem.<note caller="+" style="f"><char style="fr" closed="false">27:12 </char><char style="ft" closed="false">Mat 26:63</char></note><verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />Owo Pailet kehm-e bahbe re, “Anv, a nehme wuk nsol gbalee nyi bo kpꞌbungu tob-aa?”<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />Jol Jisos we tikem faange.<note caller="+" style="f"><char style="fr" closed="false">27:14 </char><char style="ft" closed="false">Jon 19:9</char></note></para>
  <para style="p" vid="MAT 27:14">Ntubesi ejahbe noo kehm-e kpoko esi tete.<verse eid="MAT 27:14" /></para>
  <para style="s">Elam ji bo kimi re bo wul Jisos</para>
  <para style="r">(<ref loc="MRK 15:6-15">Mak 15:6-15</ref>; <ref loc="LUK 23:13-25">Luk 23:13-25</ref>; <ref loc="JHN 18:39-19:16">Jon 18:39-19:16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Elkak anehng anehng ntubesi ejahbe jo kono elyehke nne a ngbekobo awohng, ka ellong ane, no bo lꞌseb. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Ngare nyio nne awohng woomo ngbekobo, no bo jo lung-e re Barabas. Nnene jolem no ki-e kahn.<verse eid="MAT 27:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 27:17" />Eji bo ba kono edi ajehng, Pailet kehm bahbe bo re, “Nne awo ń kpꞌsebe re me n yehke yake, Barabas, afi Jisos ji bo kpo lung-e re Kraist?”<verse eid="MAT 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 27:18" />Tibre á jo kahne kpee re, bo ko-e ba ka-e, tib eji á jo teele bo ala.<note caller="+" style="f"><char style="fr" closed="false">27:18 </char><char style="ft" closed="false">Elt 13:45</char></note><verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Eji Pailet jehk go ege eti elam, nkal ewe kehm tiingi tv-e re, “Ka lak etingi nne jio abo, tibre ye wo wahng ka n nyehne erem gbalee go egama nlem nyi n leeme no lela.”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Atubesi abalimajom, a anebkul nfam kehm kehme ellong ane bao eltim sennge re, bo gboongo Pailet, á yehke Barabas yake, fere wul Jisos.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Ntubesi ejahbe noo kehm bahbe bo re, “Ane abal baa, nne awo ń kpꞌsebe re me n yehke yake?”</para>
  <para style="p" vid="MAT 27:21">Bo kehm faange re, “Barabas wo.”<note caller="+" style="f"><char style="fr" closed="false">27:21 </char><char style="ft" closed="false">Elt 3:14; 1 Pit 3:18</char></note><verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Pailet kehm bahbe bo re, “Anv, me n lim Jisos jen, ye ji bo kpo lung-e re Kraist?”</para>
  <para style="p" vid="MAT 27:22">Bo ane kpee kehm faange re, “Kum-e go ekros!” <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Ntubesi ejahbe noo kehm bahbe re, “Anv, ebi aji á ma lim?”</para>
  <para style="p" vid="MAT 27:23">Bo kehm kpe rabe wahre wahre wahre re, “Kum-e go ekros!”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Eji Pailet sebe kahn re, ejumjum kpeem li ji á bahke kpe ma lim, gana ntong yahke gbo, owo á kehm koko alahb, ba ru abo go esamahr ane bao, kehm bungu re, “Elkv ni nne noa bahke kpoko, ebo ebame o wobem, nfem enyahne nyi go.”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Owo ellong ane bao kpee kehm-e faange re, “Nong, alung eme tuun-r, a abon abon ebahre.”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Pailet kehm yehke Barabas ka bo, á for, tong bo dv Jisos, fere yak-e ka re bo song kum-e go ekros.<verse eid="MAT 27:26" /></para>
  <para style="s">Ana nsoja nyoko Jisos</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mak 15:16-20</ref>; <ref loc="JHN 19:2-3">Jon 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Owo nsoja nyi ntubesi ejahbe noo kehm rodo Jisos, tahm a ne go nlaaga ntubesi noo, kehm song lung ellong nsoja nehko re bo ba. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Bo kehm-e yehke nsol go ngubjing, fere kak-e mbilibili ekpawobo ana ji atul kpo kono elkake. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Bo kehm tahnge ekpasi akpiri, ba konng-e go esi, fere ka-e ebti, á fili go ege eboblum, kehm jo gbo, jamm-e alahng go ege alata, fere jo nyok-e re, “E kp-a kake nnyo, ntul no Jus.” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Bo kehm jo so atel wohng-e, fere taare ebti bi á fili go ebo, jo rum-e go esi. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Eji bo m-e nyok ano kpee, owo bo kehm-e yehke ekpawobo jio, feere a nsol enye kak-e, ko-e tahm a ne re bo song kum-e go ekros.<verse eid="MAT 27:31" /></para>
  <para style="s">Ana bo kumu Jisos go ekros</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mak 15:21-32</ref>; <ref loc="LUK 23:26-43">Luk 23:26-43</ref>; <ref loc="JHN 19:17-27">Jon 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Eji bo ma lohng fi, bo kehm song nyehn nne no bo jo lung-e re Saimon ji jolo nne a Sirin. Bo kehm-e bobo re á sol ekros ji Jisos.<verse eid="MAT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 27:33" />Eji bo song rehng go edi ji bo jo lung re Golgota ji lohngo re “edi nkpakesi”, <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />owo bo kehm-e kake amahm ma bo semme alullul anyane. Eji Jisos wuungu no, á kpeem wo. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Bo kum-e kan a lake go ekros, bo kehm soro kehme elfaange tub, eji bo lꞌmal baange nsol ebjing enye. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Eji bo ma baange nsol nyio, bo kehm jehke o, jo baab-e.<verse eid="MAT 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 27:37" />Bo kehm lake ekpakenwer go ero kohlo go ege esi, ji bo nyono ebi ji bo ka-e re, “A WO LI JISOS, NTUL NO JUS.” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Owo bo kehm tob kum awajv abal lake go akros, noko go ege ejang eboblum, noko go ege ejang ebobkal.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />Ane ba jo sehng go mbang kehm kehme aromo tuubu, fere jo su-e re, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />“Wo sang jo bung re, a bahke wake etahk Esowo, fere tuungu si go nfung eraa? Tahre elna anv me! Lꞌjol re, wo Mmon no Esowo wo, badde go ekros me!”<note caller="+" style="f"><char style="fr" closed="false">27:40 </char><char style="ft" closed="false">Mat 26:61; Jon 2:19-21</char></note><verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Atubesi abalimajom, a atꞌtibi ba atahm, go anebkul nfam tob jo nyok-e ano fvfo re, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Á kpo tahre ane bako, yefono nehm ma tahre elne! Lꞌjol re ye ntul no Israel wo, nong, á tohko badde go ekros ba, wahr kehm taame tv-e.<note caller="+" style="f"><char style="fr" closed="false">27:42 </char><char style="ft" closed="false">Mat 12:39-40</char></note> <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Á kpo bum Esowo go etingitingi, nong, Esowo tahr-e me, á lꞌkor-e. Tibre á kpo bung re, ye Mmon Esowo wo.” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Awajv nya bo tob kumu bo ana ye, jo tob su-e ano.<verse eid="MAT 27:44" /></para>
  <para style="s">Ana Jisos kpo no</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mak 15:33-41</ref>; <ref loc="LUK 23:44-49">Luk 23:44-49</ref>; <ref loc="JHN 19:28-30">Jon 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Eji efin ma yiimi, ejannge kehm gboko go ejahbe jio kpee, ji tete biingi awa ara.<verse eid="MAT 27:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 27:46" />Eji ma rehng nkaranka era nyi elgung, Jisos kehm rabe wahre wahre wahre re, “Eli, Eli, lama sabaktani?” ji lohngo re, “Nsoo, Nsoo, jen ji wahng ka a ma-m yake ana?”<note caller="+" style="f"><char style="fr" closed="false">27:46 </char><char style="ft" closed="false">2 Kor 5:21</char></note><verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Ane bandiki ba yiimi o wuk, kehm bungu re, “Á kpi Elaija lung.”<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />Owo nne awohng kehm soro be eje, song rod ndꞌdahng, suku go evinegar, tung go esi ebti, rod ton-e re á yab. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Egom ane bako kehm bungu re, “Tohken nong, wahr nyehnen, joare Elaija bahke bake, ba tahr-e.”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Jisos kehm kpe rabe wahre wahre wahre, kehm yake etohko eje ka go. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Owo ekpiki ji bo tohko go etahk Esowo kehm soro yang ejang ebbal, bomo go ero tete ba jahm ndi.<note caller="+" style="f"><char style="fr" closed="false">27:51 </char><char style="ft" closed="false">Hib 10:19-20</char></note> Ndi kehm gbehke. Akpartal bahnge. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Alahm kehm lennge. Aneb Esowo gbalee ba kpo no, kehm nyahme. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Ngare nyi Jisos nyahme go elkv, bo kehm lohngo go alahm, tahm song rehng go Jeusalem. Owo ane gbalee nyehne bo.<note caller="+" style="f"><char style="fr" closed="false">27:53 </char><char style="ft" closed="false">Elt 26:23</char></note><verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Eji ntubesi a nsoja, a nsoja nyehko nyi jo tob baabe Jisos a ne nyehne ana ndi ma gbehke, fere nyehn nsol nyehko nyi kpe lim budu, bo kehm kehme elfahle, fere kehme elbungu re, “Etingitingi, nne noa lohko jol Mmon no Esowo!”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Anebkal gbalee ba lohngo go Galili, ba jo toono Jisos, fere jo kak-e ebo, yiimi ebo go fee, jo nyehn.<note caller="+" style="f"><char style="fr" closed="false">27:55 </char><char style="ft" closed="false">Luk 8:2-3</char></note> <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Meri ji lohng go Magdala woomo go bo ellong, a Meri nnyehn Jems a Josef, go nnyehn abon Sibidi.<verse eid="MAT 27:56" /></para>
  <para style="s">Ana bo kake Jisos go elahm</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mak 15:42-47</ref>; <ref loc="LUK 23:50-56">Luk 23:50-56</ref>; <ref loc="JHN 19:38-42">Jon 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Eji elgung ma ba, efange nne ajehng ji bo jo lung-e re Josef, ji lohng go Arimatia kehm bake. Ye fvfo tob jolo ntꞌtoono no Jisos. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Á kehm tahme song kpiri Pailet, fere gboong-e re á yake ekv ji Jisos ka-e. Pailet kehm tongo re, bo yake ekv eje ka-e. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Josef kehm rodo ekv ji Jisos, kpennge abarebare abomo nya nfenfe, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />fere rod, song kak go ege elahm bi bo kpꞌna rahme go ekpartal. Á kehm bannge egburu eltal, bulu go nnyo elahm, kehm tahme eje. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Meri ji lohng go Magdala, a Meri jehko, bo kehm song ji, wane elahm bio.<verse eid="MAT 27:61" /></para>
  <para style="s">Ane ba jo baabe elahm</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Etoono efung behko, eji efung ebjing atoobo ma sehng, atubesi abalimajom, a Bab Farisi kehm song kono asi go etahk Pailet, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />kehm-e tongo re, “Nsoo, wahr ebbuumu ana nnehm a nne noo bungu ngare nyi á kpeke li go elkpin re, ‘Nfung era m bahke nyahme go elkv.’<note caller="+" style="f"><char style="fr" closed="false">27:63 </char><char style="ft" closed="false">Mat 12:40</char></note> <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Tum ane, bo song baabe elahm bio tete nfung era nyio biingi, eji abatꞌtoono ebe lꞌkꞌsong v ekv eje, fere jo bung tong ane re, ‘Yebnyahme go elkv’. Tohko jol ano, esꞌkohro enehm bia bahke sabe sehnge bi ngbokambang.”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Owo Pailet kehm bungu re, “Koon abꞌbaabe, wahn song baabe elahm ana ń kahne no.”<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />Bo kehm tahme, song bum abꞌbaabe o re bo baabe elahm, fere rod elak lake, kak elliingi,<note caller="+" style="f"><char style="fr" closed="false">27:66 </char><char style="ft" closed="false">Ell 5:1</char></note> (eji bo lꞌkahn, nne lꞌyel go elahm).<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Ana Jisos nyahme go elkv</para>
  <para style="r">(<ref loc="MRK 16:1-10">Mak 16:1-10</ref>; <ref loc="LUK 24:1-12">Luk 24:1-12</ref>; <ref loc="JHN 20:1-10">Jon 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Eji Esabat ma sehng, ngbokambang efung go erahde, efungfu behre behre Meri ji lohng go Magdala, a Meri jehko, bo kehm tahme re, bo song nyehn elahm. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Owo ndi kehm soro kehme elgbehke tete, tibre enjel nyi Jehova lohngo go ejahbetul Esowo ba, ba bannge eltal nio bum go nkpe, fere ji. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Á jolo are emangedu ji. Nsol nyi á kake go ngubjing jo bare kparaang.<note caller="+" style="f"><char style="fr" closed="false">28:3 </char><char style="ft" closed="false">Mat 17:2; Elt 1:10</char></note> <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Abꞌbaabe bao fahl-e sehng, fere jo kꞌkahm, bo fere jolo are akvne nya.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Enjel nyio kehm tongo anebkal bao re, “Kana kpe fahl! Tibre n kpꞌkahne re, n kpi Jisos seb, ji bo kum-e go ekros. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Ana á limm, yebnyahme fi, ana á bungu no. Baan, wahn ba nyehn edi ji á noongo no. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Songen anv elwaare, wahn song tong abatꞌtoono ebe re, yebnyahme go elkv. Á bahk-n gboko mbang song rehng go Galili.<note caller="+" style="f"><char style="fr" closed="false">28:7 </char><char style="ft" closed="false">Mat 26:32</char></note> Go wo ḿ bahk-e nyehne. Buumen ji m ma-n tong a!”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Owo bo kehm lohngo go elahm elwaare, elfahle elfahle, a egburu eyebatahng, be re bo song tong abatꞌtoono ebe. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Eji bo fi no re bo song tong abatꞌtoono ebe, owo Jisos kehm ba wane bo, kehm bungu re, “N kp-n kake nnyo.”</para>
  <para style="p" vid="MAT 28:9">Bo kehm jeere kohl-e, jamm-e alahng, jabb-e akpade, fere kak-e. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Jisos kehm tongo bo re, “Kana kpe fahl! Songen, wahn song tong abonanee re,<note caller="+" style="f"><char style="fr" closed="false">28:10 </char><char style="ft" closed="false">Hib 2:11</char></note> bo song go Galili. Go wo bo bahk-m nyehne.”<verse eid="MAT 28:10" /></para>
  <para style="s">Ana abꞌbaabe elahm song tooro</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Eji anebkal bao ma tahm fi, abꞌbaabe elahm bandiki kehm tahme, song rehng go nla ejahbe, song tooro ejum ajehng ajehng ji ma lim, tong atubesi abalimajom. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Atubesi abalimajom, a anebkul nfam kehm song kono edi ajehng, kehm toobo, ka abꞌbaabe elahm bao akpohko gbalee, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />kehm bungu re,</para>
  <para style="p" vid="MAT 28:13">“Ana wo ḿ bahke jo bung re, ‘Abatꞌtoono ebe ba atv, ba v nkvne, tahm a ne ngare nyi e jo lal.’<note caller="+" style="f"><char style="fr" closed="false">28:13 </char><char style="ft" closed="false">Mat 27:64</char></note> <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Ntubesi ejahbe lꞌwuk, e bahke song bung a ne, wahn, kana tiiri!”<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Abꞌbaabe elahm bao kehm rodo akpohko nyao, song lim ana bo tongo bo. Eka jia, Jus kpi ntubu ntubu, tong atem tete sik anv.<verse eid="MAT 28:15" /></para>
  <para style="s">Ana Jisos ba kpiri abatꞌtoono ebe</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mak 16:14-18</ref>; <ref loc="LUK 24:36-49">Luk 24:36-49</ref>; <ref loc="JHN 20:19-23">Jon 20:19-23</ref>; <ref loc="ACT 1:6-8">Elt 1:6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Abatꞌtoono Jisos, ewubu a nne awohng, bo kehm tahme go ewong ajehng ji li go Galili, edi ji Jisos tongo bo re bo je. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Eji bo nyehn-e no, bo kehm gboko, jamm-e alahng, fere kak-e. Egom jindiki jo fꞌfaabe.<verse eid="MAT 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18" />Jisos kehm jeere kohlo bo, kehm tongo bo re, “Bo ma-m ka nsahm kpee nyi m bahke jo fili ejahbetul Esowo, fere jo fili njini.<note caller="+" style="f"><char style="fr" closed="false">28:18 </char><char style="ft" closed="false">Mat 11:27; Ef 1:20-23</char></note> <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Songen fvfo go njini kpee, wahn song lim ane, bo jol abatꞌtoono ebame go ejahbe ajehng ajehng. Wohngen bo alahb go mbing nyi Nsoo, a Mmon, a Etingi Etohko, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />wahn fere tib bo, bo jo bum ejum ajehng ajehng ji m ma-n tong. Buumen re, m bahke jolo a nahne ngare anyehng anyehng tete eying jia mal.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>