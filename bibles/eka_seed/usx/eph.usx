<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Ekajuk New Testament</book>
  <para style="h">Efesus</para>
  <para style="toc1">Efesus</para>
  <para style="toc2">Ef</para>
  <para style="mt2">NWER NYI POL NYONO TV</para>
  <para style="mt2">ANEB ERO BA LI GO</para>
  <para style="mt1">EFESUS</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Me Pol wo, ji koro Esowo re me n jol ntiingetib no Kraist Jisos. N kpꞌnyono nwer nyia tv aneb Esowo ba li go Efesus, bo jio ji kpi ekakesehk go eltoono ni bo kpꞌtoono Kraist Jisos. <verse eid="EPH 1:1" /><verse number="2" style="v" sid="EPH 1:2" />Nong, nnoobo jol a nahne, a elkoono ni lohng goji Esowo Nso ejahre, a Jisos Kraist Ntul ewahre.<verse eid="EPH 1:2" /></para>
  <para style="s">Elfuulu ni lohng goji Kraist</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />Nong, wahr tehken Esowo bi li nde no Jisos Kraist Ntul ewahre, bi ma-r fuulu elkohn elfuulu anehng anehng ni etohko, ni li go adi nya li go ejahbetul Esowo, tib eji e li ajehng a Kraist. <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />Esowo tohk-r yehke, njini kehm jolo,<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">Jon 15:16</char></note> tib eji á yehke Kraist,<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">Rom 8:29</char></note> eji e lꞌjol ejahre ejahre, kꞌli ebi ajehng ajehng go ege esamahr. Go ege elkoro wo, <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />á toob-r mahne mahne bum elne, eji e lꞌjol abon ebe sehng goji Jisos Kraist.<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">Jon 1:12</char></note> Ano wo kor-e no, owo wahnge á limi ano, <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />eji bo lꞌtehk ellub ni nnoobo enye nyi á yar-r no, eji á ka-r akor-m mmon ewe.<verse eid="EPH 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 1:7" />Alung eme ma wahnge Esowo ma-r fak yake, fere tahm ka-r go egahre abiafem,<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">Kol 1:14</char></note> ma kpꞌtibi afang nya nnoobo enye, <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />nyi á ma gare ka-r, ma rur wꞌwohng, nyi li elkahne, a ngbere,<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">1 Kor 1:5</char></note> <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />eji á ma lim re, wahr kahn ntir atahng enye nyi á behre no.<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">Ef 3:3-9</char></note> Ano wo kor-e no, á kehm tiri re, <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />ngare lꞌbiingi, á bahke gohro lim ejum ajehng ajehng sehng goji Jisos Kraist. Owo á bahke koko nsol kpee nyi li go elbung, a nyi li go ndi, ba fadde edi ajehng go elwo ni Kraist.<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />Eji e li ajehng a Kraist, owo wahnge e ma bel ejum elehke elkv,<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">Rom 4:13</char></note> wahr ji bo yehk-r wuku wuku jang jang ana Esowo toobo no, ye ji kpo lim nsol mal kpee, ana á tiri no go ege eltim, <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />eji elkpin enahre lꞌjo tehk ellub ene, wahr jia ji gbo mbang jo kunu Kraist ekpu.<verse eid="EPH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13" />Eji ń li ajehng a ne, ano wo wahnge Esowo ma-n kak elliingi ene ngare nyi ń wuku alum nya etingitingi, nya li nnoobo etib bi eltahre enahne, fere taame tv Kraist. Elliingi nio ni li Etingi Etohko ji á nyame no, <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />ji á ko, bom-r esi, tib go ejum ji e bahke lehke elkv, tete ngare rehng nyi á bahk-r fake yake,<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">2 Kor 1:22; 5:6</char></note> wahr ji li ane ebe ba á ma-r gunu re wahr jo tehk ellub ene.<verse eid="EPH 1:14" /></para>
  <para style="s">Ero bi Pol kake no</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Eji m ma wuk bade eltaame ni ń kpꞌtaame tv Ntul a Jisos, fere wuk bade ana aneb Esowo kpee kpo kor-n,<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">Kol 1:4</char></note> <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />n tikem rahke Esowo saam akake tib wahn. Ero ebame bi n kpꞌkake ka-n, n kpꞌkake re,<verse eid="EPH 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 1:17" />Esowo bi Jisos Kraist Ntul ewahre, bi li nde no kpi ellub, ka-n etohko ji elkahne, a ji bahke lennge Esowo ka-n, eji ń lꞌkahn-e. <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />N kpꞌkake ero re, ntim enyahne lennge, a amahr enyahne, eji ń lꞌkahn ekunukpu ji Esowo ka-n no ngare nyi á lung-n no, fere kahn afang nya ellub ni nsol elehke elkv enye kpi no, nyi ane ebe bahke bele, <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />fere kahn egburu nsahm enye nyi nne lꞌkꞌma ko gare, nyi wob-r go egahre atahng, wahr jia ji ma taame. Nsahm nyꞌnehm nyi li nsahm <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />nyi á ko, nyahme Kraist go elkv, fere rod-e jehke go ege eboblum go ejahbetul. <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />Kraist wo ga gbal sehnge atul kpee, a atubesi, a abafiladi, go nne awohng awohng no kpi nsahm.<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">Kol 2:10</char></note> Mbing enye nyi ga gbal sehnge mbing anyehng anyehng go eying jia, a ji kpꞌbake. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />Esowo ebyake nsol kpee kak-e go elwo,<note caller="+" style="f"><char style="fr" closed="false">1:22 </char><char style="ft" closed="false">Mat 28:18</char></note> fere lim-e re, á jol ntubesi no aneb ero, fere jo fili ejum ajehng ajehng. <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />Aneb ero ba li ngubjing nyi Kraist,<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false">1 Kor 12:27</char></note> ba m-e lim re, á biingi go nseenga nseenge, ye ji wahnge nsol kpee ma jol go nseenga nseenge.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">Nnoobo nyi Esowo nyi wahnge ḿ ma bel eltahre</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />Wuku wuku ń jolo ane ba ma kpo, tib go egahna nsoodo,<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">Kol 2:13; 1 Tim 5:6</char></note> a abiafem, <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />nya ń tohko jo lim, eji ń jo toono eljini ni njini nyia, fere jo toono ntubesi no kpꞌfili ewuungu, ye ji li etohko ji wob atahng ma ane ba kil elkake Esowo.<verse eid="EPH 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 2:3" />Ane bao ba, wuku wuku e jo tohko jen a bo, jo lim nsol nyi jo kor-r, fere jo toono ji jo kor agubjing enyahre, a ntir atahng enyahre. Esi jio ji wahnge e jolo ane ba erakatahng ji Esowo jol gboko tub-r, ana bahke gboko tub ane ba li go njini nyia.<verse eid="EPH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4" />Wo, Esowo bi kpi egburu ndon. Tib go egburu elkoro ni e kor-e no, ni ni wahnge <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />á ma-r ka elkpin a Kraist, jol eji e jolo jol ane ba kpo no, tib go egahra nsoodo.<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">Luk 15:24</char></note> Tibre nnoobo nyi Esowo nyi wahnge ḿ ma bel eltahre. <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />Esowo ma-r nyahme go elkv a ne, fere lim-r re wahr ji a ne go adi nya li go ejahbetul, tib eji e li ajehng a Kraist Jisos.<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">Kol 3:1-4</char></note> <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />Esowo limi ano, eji á lꞌtib afang nya nnoobo enye go eying ji kpꞌbake, nya nne lꞌkꞌma fange, nya li elkoro ni á tib-r no goji Kraist Jisos.<verse eid="EPH 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 2:8" />Tibre nnoobo nyi Esowo nyi wahnge ḿ ma bel eltahre tib go egahne eltaame, wahn sang wahnge, ayare nya Esowo nya.<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">Gal 2:16</char></note> <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />Ḿ belem eltahre tib go eltum alimi, eji nne awohng awohng lꞌkꞌjo wor nnyo. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Wahr ba li eltum ni Esowo limi no.<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">Fil 1:6</char></note> Á lim-r goji Kraist Jisos re wahr lim nnoobo nyi Esowo toobo bum wuku wuku re wahr jo lim.<verse eid="EPH 2:10" /></para>
  <para style="s">Jisos wo ma ba yang mbang ka-r, nyi li rehng goji Esowo</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Fvfo, buumen re, go eyaame ji ngubjing ń jolo ane baka baka. Jus ji bo kpo lung bo re, “ane ba kpo yehke nrur” jo lung-n re “ane ba kil jo yehke nrur”, nyi li ejum ji nne kpo ko abo lim go ngubjing. <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />Buumen re, ngare nyio ń jolem a Kraist. Ń jolo ajahmjahm.<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">Ef 5:8</char></note> Ń woomem go ellong anebe Israel ba Esowo yehke no. Ḿ belem ebo abehng abehng go agbanngalung nya Esowo limi a bo, a nsol nyi á nyame tong bo re, bo bahke bele.<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">Rom 9:4</char></note> Ń jolo na jol go njini nyia, ekunukpu ḿ belem, jol Esowo ń kahnem.<verse eid="EPH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 2:13" />Eji ḿ ma jol ajehng a Kraist Jisos, wahn ji wuku wuku jolo fee, anv, bo ma-n ko, ba a nahne goji Esowo tib go alung ma Kraist.<verse eid="EPH 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14" />Tibre Kraist wo ma ko elkoono ba ka-r, ye ji ma lim Jus, a ane baka baka re bo jol ajehng. Ye wo ma ba wa ekahme ji yab-r no.<note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="ft" closed="false">Gal 3:28</char></note> <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />Elkv ni á kpo no go ngubjing ni wahnge e ki kpe li anebekv ba Esowo, ba kpo soodo atahm. Jisos wo ba range atahm, eji á lꞌlim njahm ebal ebal, bo jol ajehng, fere jol aneb nfenfe, ba ma bel elkoono a Esowo, tib eji bo li ajehng a ne.<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">2 Kor 5:17,19</char></note> <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />Kraist kpo go ekros, eji á lꞌlim re, wahr kꞌkpe jol go ekv a Esowo, fere lim njahm ebal ebal re jol ana ngubjing anyehng, fere gongo Esowo ka-r tib go egahre abiafem.<verse eid="EPH 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 2:17" />Kraist ba, ba tiingi nnoobo etib bi elkoono, tong wahn ane baka baka ba jolo fee, fere tong Jus ji jolo a Esowo bad bad. <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />Tibre wahr Jus, a wahn ji li ane baka baka, wahr ebting mbang nyi li Kraist, nyi e bahke ma sehng rehng goji Esowo Nsoo, eji e li go etohko na ajehng.<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />Fvfo, wahn ane baka baka, ń kpeem li ajahmjahm, a ajenne. Anv, wahn ebfere jol afono ejahbe a aneb Esowo. Wahn ebyel nnahb nyi Esowo.<note caller="+" style="f"><char style="fr" closed="false">2:19 </char><char style="ft" closed="false">Hib 12:22-23</char></note> <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />Bo ma-n ko ana abꞌlok, si kunu go nnahb ekahme nyi li abatiingetib,<note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="ft" closed="false">Mat 16:18; Ell 21:14</char></note> a abanyehnamahr, nyi Kraist li eltal ni ga ga.<verse eid="EPH 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 2:21" />Ye wo wahng ka akahme etahk yim no, kpꞌwahre tete song jol mbarebare etahk ji Jehova. <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />Eji ń li ajehng a Kraist, owo wahnge bo ma-n tob ko, si etahk jio ji etohko, ji Esowo lene no.<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">1 Pit 2:4-5</char></note><verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">Eltum ni Pol limi go ellong ane baka baka</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Me Pol, n li nne a ngbekobo no Kraist tib go egahne esi, wahn ane baka baka.<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">Fil 1:7,13</char></note><verse eid="EPH 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 3:2" />N kpꞌbumu re, wahn ebwuk ana Esowo ma-m ka eltum nia go ege a nnoobo re me n lim ka-n.<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">Elt 22:21</char></note> <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />Esowo lennge ntoobo nyi á toobo mbehr mbehr ka-m, ana m ma tohko nyon abon alum bade.<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">Ef 1:9</char></note> <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />Ń lꞌlung alum nyao, owo ḿ bahke kahne elkahne ename ni n kpꞌkahne nkpokosi nyi li bada Kraist, nyi Esowo behre no, <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />nyi á ki tiki lim ane ba jolo mahne mahne, bo kahn. Anv, yeblennge ka abarebare abatiingetib, a abanyehnamahr sehng go ege etohko.<verse eid="EPH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 3:6" />Nkpokosi nyio li re, ane baka baka tob li elkv a Jus, bo fere jol ngubjing anyehng, fere bel nsol nyi Esowo nyame tong bo, nyi li goji Kraist, tib eji bo ma taame tv nnoobo etib. <verse eid="EPH 3:6" /><verse number="7" style="v" sid="EPH 3:7" />Esowo lim-m re me n jol nlokeltum no nnoobo etib bio tib go nnoobo nyi á yar-m no, eji nsahm enye jo tib edu. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />Jol eji me n li li nne no ga rede go ellong aneb Esowo,<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">1 Tim 1:12-15</char></note> Esowo ma-m ka nnoobo nyi m bahke jo tong ane baka baka bade afang nya Kraist, nya nne lꞌkꞌma ko gare, <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />fere lim ane kpee nyehn nkpokosi ejum nyi Esowo toobo no, fere behr mahne mahne, ye ji limi nsol kpee, <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />eji aneb ero lꞌwahng atul, a ajꞌjok ane ba li go ejahbetul Esowo tob kahn ana ajoobo elkahne nya Esowo li no.<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">1 Pit 1:12</char></note><verse eid="EPH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 3:11" />Esowo limi ano, ana á tiri no wuku wuku, eji á ma lim re, lohko jol go etingitingi sehng goji Kraist Jisos Ntul ewahre, <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />ye ji ma wahng e ma bel esahb, mbang ma fere jol ka-r,<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">Jon 14:6; Rom 5:2</char></note> nyi li rehng goji Esowo, nyi e bahke ma sehng, kꞌfahl, tib eji e ma taame tv Jisos. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Owo wahnge n kp-n gboongo re, ntim ki-n woono tib go erem bi n kpꞌnyehne go egahne esi, bi li ellub enahne.<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Kol 1:24</char></note><verse eid="EPH 3:13" /></para>
  <para style="s">Elkoro ni Jisos</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Esi ejahne ji wahnge n kpo jamme alahng enyame go esamahr Esowo Nsoo, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />bi gungu nnahb anyehng anyehng nyi li go ejahbetul, a nyi li go njini mbing enye.<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">Elt 17:28</char></note> <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />N kpꞌgboongo Esowo bi kpi afang nyao nya ellub ene re, á ka-n eko, eji ń lꞌbel atahne go egahne atahng tib go ege etohko, <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />Kraist fere lene go egahna ntim tib go eltaame,<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">Jon 14:23</char></note> eji alohk enyahne lꞌyel rehng edi ji elkoro li no, nnahb ekahme tob kuumu go elkoro,<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">1 Kor 13:13</char></note> <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />wahn fere bel nsahm nyi ḿ bahke kahne, a aneb Esowo bako kpee ana elkoro ni Kraist kpange no, fere lꞌlab, ana rahbe no, fere wꞌwahre,<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">Jon 15:13</char></note> <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />ń fere kahn elkoro ni Kraist ni gbale sehng elkahne anehng anehng, eji nsol kpee nyi Esowo kpi no lꞌrur go egahna ntim, <verse eid="EPH 3:19" /><verse number="20" style="v" sid="EPH 3:20" />ye ji bahke ma lim sehnge ana ji e bahbe no, a ji e tiri no tib go nsahm nyi wob-r go atahng,<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="ft" closed="false">1 Kor 2:9</char></note> <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />nong, á bel ellub goji aneb ero, a goji Kraist Jisos ngare anyehng anyehng tete go njinanjini. Emen<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">Ana ero li ajehng</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Me ji li nne a ngbekobo tib go esi ji Ntul a Jisos,<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">Ef 3:1</char></note> n kp-n gboongo re, wahn ji Esowo ma-n lung, belen elkpin ni biingi ana ni Esowo kpꞌsebe re wahn bel. <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />Jo reden elnahne, wahn jol soom, jo kpooro. Jo tiben elkoro enahne, eji ń kpo kpuumu ka atemtem.<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="ft" closed="false">Rom 14:1,3; 15:7</char></note> <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />Jo noken, wahn soro asi, jo jol ajehng go etohko, tib go elkono ni Esowo ma-n jabbe kono re wahn jol ajehng. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />Li ngubjing anyehng, a etohko na ajehng, jang jang ana li ekunukpu ajehng ji Esowo bi lung-n no kpꞌsebe re wahn bel.<verse eid="EPH 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 4:5" />Li Ntul awohng, a eltaame anehng, a ewohngalahb ajehng fvfo. <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />Li Esowo na abehng bi li nde no ane kpee. Á li Ntul no ane kpee. Á kpo ko ane kpee, lim mbang enye. Á wob ane kpee go atahng.<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">1 Kor 12:4-6</char></note><verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />Wo, Esowo ka nne awohng awohng ewahre nnoobo enye, ana Kraist gare nsol ayare enye ka-r.<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">1 Kor 12:11</char></note> <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />Ana nwer Esowo bungu no re, “Eji á ma tahm go ero, owo á kehm bobo anebekv ebe kak ngbekobo, fere yare ane.”<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">Mak 3:27</char></note><verse eid="EPH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 4:9" />Eltahme ni á tahme go ero lohngo rejen? Lohngo re, á gbo mbang badde song rehng go atahng ndi.<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">1 Pit 3:19</char></note> <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Ye ji badde no, ye jꞌnehm wo tahme go ero sehng elbung sa, eji á lꞌjol edi ajehng ajehng.<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">Jon 4:21,23</char></note><verse eid="EPH 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 4:11" />Ye wo li nne no yare ane, fere lim egom jindiki, bo jol abatiingetib, á fere lim egom jindiki, bo jol abanyehnamahr, egom jindiki abatiinginnoobetib, egom jindiki abaabebul, egom jehko atꞌtibi,<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false">1 Kor 12:28</char></note> <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />eji aneb Esowo lꞌjol go nseenga nseenge, fere bel ejum ajehng ajehng ji bo bahke koko, jo loko Esowo, toono o, ngubjing nyi Kraist gbal, <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />tete e jol go eltaame na anehng, fere kahn Mmon no Esowo, fere gbal kpee, biingi a Kraist jang jang, <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />eji e lꞌkꞌkpe jol abonse ba li ana anyane nya nfeb kpo yehke tv edi ajehng ajehng. Nfeb nyio nyi li ajoobo eltibi nya ane ba kpo nehm ane kpo tib go mbang awak, bo ji kpo seb abang nya bo bahke were ane, fere lim bo, bo tan mbang.<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="ft" closed="false">Hib 13:9</char></note><verse eid="EPH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 4:15" />Ga nob re wahr jolen go etingitingi, fere bel elkoro, fere gbal go mbang anyehng anyehng ka Kraist ji li esi, <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />ji wahnge ejum ngubjing ajehng ajehng fuumu a ngubjing nyio nyi li anyehng tib akon nya Esowo limi no. Ejum ngubjing ajehng ajehng lꞌjo lim nob nob, owo ngubjing kpo gbal, fere tahne antahng tib go elkoro.<verse eid="EPH 4:16" /></para>
  <para style="s">Jolen aneb nfenfe</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Alum nya n yahke bung a, m bahke yiimi go mbing nyi Ntul. Kana kpe lim eljini ni ane baka baka kpo lim, ba kpo tir ntir nyi li mbol mbol. <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />Ntir atahng ebo ebgbo ejannge. Bo li ajahmjahm go ejang bi Esowo, tib eji bo ki kpi elkpin ene. Tibre ekꞌkahn ebo, a etahnsi ebo ji wahnge bo li ano. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />Eltim, bo kpimm. Bobyake elbo ka re bo jo famme yannge. Elkohn ejum ajehng ajehng ji ki li saang kpehme tiki gbal bo.<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />Nsol nyio sang ń kpili goji Kraist.<note caller="+" style="f"><char style="fr" closed="false">4:20 </char><char style="ft" closed="false">Mat 11:29</char></note> <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />Wahn eblohko wuk bada ne. Bo tib-n etingitingi ji li goji Jisos.<note caller="+" style="f"><char style="fr" closed="false">4:21 </char><char style="ft" closed="false">1 Jon 2:29</char></note> <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />Kana kpe jol elkohn ane ba wuku wuku ń jolo no ngare nyi ń jolo go egahne nkꞌkulu elkpin, ni ma rannge tib ekor nsol nyi kpo nehm nne.<note caller="+" style="f"><char style="fr" closed="false">4:22 </char><char style="ft" closed="false">2 Kor 5:17</char></note> <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />Nong, ntim enyahne, a ntir atahng enyahne jol nfenfe. <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />Jolen aneb nfenfe ba Esowo limi go ege elfoongo, ba li go etingitingi, fere li ebo ebo ka Esowo.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />Kana kpe kiimi afahnge! Nne awohng awohng jo bung etingitingi tong mmonannyehn! Tibre nne awohng awohng ewahre li ejum ngubjing nyꞌnehm na anyehng.<verse eid="EPH 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EPH 4:26" />Ntim lꞌrak-n, kana jo taame, eji erakatahng ejahne lꞌko-n, ń song lim abiafem. Kana taame re, njul lahm tv-n erakatahng go egahna ntim.<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="ft" closed="false">Jems 1:19-20</char></note> <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />Kana jo ka nnehm eyake ajehng ajehng.<verse eid="EPH 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EPH 4:28" />Nne no kpo v ejv, á kꞌkpe v. Ga nob re, á jo bade, jo lim etingitingi eltum go ege abo, eji á lꞌmal tob jo ka nne no li go elehng nsol.<verse eid="EPH 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EPH 4:29" />Nong, ebi ellum anehng anehng kꞌjo lohngen go nnyo.<note caller="+" style="f"><char style="fr" closed="false">4:29 </char><char style="ft" closed="false">Ef 5:4</char></note> Jo bungen alum nya nno, nya fuumu no, nya bahke jo kak ane ebo, eji lꞌjo nob a ane ba lꞌwuk.<verse eid="EPH 4:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EPH 4:30" />Kana jo lim re, Etingi Etohko ji Esowo jo jol ndon ndon, ji Esowo ka-n no ana elliingi ni kpꞌtibi re, efung kpꞌbake bi Esowo bahk-n fake yake.<note caller="+" style="f"><char style="fr" closed="false">4:30 </char><char style="ft" closed="false">Ef 1:13-14</char></note><verse eid="EPH 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EPH 4:31" />Yaken nsol nyia kpee, ana eljolo maange maange, atahng amoongo, eltim arake, elrabe tob atemtem, afahnge akiimi lake ane, a eblum alimi. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />Ga nob re wahn jo tib atemtem nnoobo eljini, fere bel eltim ndon, fere jo tahm ka atemtem, ana Esowo ma tahm ka-n, tib eji n li ajehng a Kraist.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s">Eljini ni anebe nfenfe</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />Eji ń li akorokoro abon ba Esowo, jolen ane ba kp-e toono.<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">Kol 2:6</char></note><verse eid="EPH 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 5:2" />Jo jenen go elkoro, jang jang ana wahr koro Kraist, á yake elne ka tib go egahre esi ana ejum ayare, a ejum njom ji kpꞌvohko Esowo eleenge.<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">2 Kor 2:15</char></note><verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />Jol kana jo gahm nsol ana anebkal akono, a nsol nyi ki li saang, a amahr abaare. Tibre fuumem re jol ano go egahne ellong, eji ń li aneb Esowo. <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />Jol tohkem fꞌfuumu re nsol nyia jol go egahne ellong ana abi aka atubu, ayok alimi, a abuuru akpaale. Ga nob re wahn jo kak Esowo saam.<note caller="+" style="f"><char style="fr" closed="false">5:4 </char><char style="ft" closed="false">Ef 4:29</char></note> <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />Tibre jia li re wahn kahn re, nne awohng awohng no kpo noongo a ane limm, no bahke bele ejum elehke elkv ajehng ajehng go ejahbetul ji Kraist, a ji Esowo. Ano wo fvfo bahke tob jol ka nne awohng awohng no ki li saang, a nne no kpo baare amahr go nsol ane.<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false">1 Kor 6:9-10</char></note> Tibre elkohn nne noo li ana njomeblom.<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />Nong, nne awohng awohng ki-n nehm go alum nya ki lohng ejumjum. Tibre nsol nyia nyi wahnge erakatahng ji Esowo bahke gboko tub ane ba kil jo wuk-e.<verse eid="EPH 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 5:7" />Fvfo, nobo re wahn kꞌjo jen a bo.<note caller="+" style="f"><char style="fr" closed="false">5:7 </char><char style="ft" closed="false">2 Kor 6:14</char></note> <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />Tibre wuku wuku ń jolo ejannge. Anv, wahn ebjol ellennge, tib eji ń li ajehng a Ntul a Jisos. Jo jenen ana abon ba ellennge. <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />Akab nyao nya ellennge li go nsol nyi kpꞌnobo, a nsol nyi li go nseenge, a nyi li go etingitingi.<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">Gal 5:22-23</char></note> <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />Jo tiren, wahn kahn ji kpꞌkoro Esowo.<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">Rom 12:2</char></note><verse eid="EPH 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 5:11" />Kana jo yel ellong ane ba kpo lim nsol nyi ki lohng ejumjum, nyi li ka ejannge. Ga nob re wahn jo tib gbul gbul gbuul re, nsol nyio ejumjum o lohngem.<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">Jon 7:7</char></note> <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />Tibre nsol nyi bo kpo lim mbehr mbehr, ebfili ndon sehng re nne bung bade. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />Ejum ajehng ajehng ji bo lꞌko ba a ji go edi ji ellennge li no, ji ji ma jol gbul gbul gbuul. Tibre ejum ajehng ajehng ji lꞌjol gbul gbul gbuul, ji ji li ellennge.<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false">Jon 3:20-21</char></note> <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />Owo fvfo bo bungu re,</para>
  <para style="q1" vid="EPH 5:14">“Nyahme, wo ji kpꞌlale,</para>
  <para style="q1" vid="EPH 5:14">lohng go ellong akvne,</para>
  <para style="q1" vid="EPH 5:14">wo mehl yiimi,</para>
  <para style="q1" vid="EPH 5:14">owo Kraist bahke jo ya tub-a.”<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Jo kunen ekpu ana n kpꞌjene. Kana jo jen ana ane ba kil elkahne ejumjum. Jo jenen ana akahnkahn ane. <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />Kana jo rannge ngare enyahne mbol mbol. Tibre ngare nyia ebi ngare nyi.<verse eid="EPH 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 5:17" />Owo fvfo, nobo re wahn kꞌjol agboolo. Jo kahnen ji Esowo kpꞌsebe re wahn jo lim.<verse eid="EPH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18" />Kana jo wo, fere jo bꞌbuumu! Bahk-n rannge na.<note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false">Luk 21:34-35</char></note> Ga nob re etohko ji Esowo jo rur go egahna ntim. <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />Ń lꞌkehm bungu atemtem, jo koon alum Saams, wahn fere jo ko ase Esowo atehke, a ase nyao nya etohko. Jo yimen ase go egahna ntim, wahn jo tehk Esowo. <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />Jo kaken Esowo Nso ejahre saam ngare anyehng anyehng go ejum ajehng ajehng, go mbing nyi Jisos Kraist Ntul ewahre.<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">1 Tes 5:18</char></note><verse eid="EPH 5:20" /></para>
  <para style="s">Akal ane, a alum ane</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />Jo woomen atemtem go elwo tib go elfahle ni ń kpꞌfahle Kraist.<note caller="+" style="f"><char style="fr" closed="false">5:21 </char><char style="ft" closed="false">1 Pit 5:5</char></note> <verse eid="EPH 5:21" /><verse number="22" style="v" sid="EPH 5:22" />Akal ane, jo woomen alum ebahne go elwo. Tibre ano wo li mbang nyi Esowo.<note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">1 Pit 3:1-7</char></note> <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Tibre nlum a nne wo li ntubesi no nkal ewe, ana Kraist tob li ntubesi no aneb ero, ba li ngubjing enye.<note caller="+" style="f"><char style="fr" closed="false">5:23 </char><char style="ft" closed="false">1 Kor 11:3-9</char></note> Á tob li ntꞌtahre abo. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Ana aneb ero wob Kraist go elwo, nong, akal ane fvfo tob woomo alum ebo go elwo go ejum ajehng ajehng.<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />Alum ane, nong, akal ebahne jo kor-n, ana Kraist, aneb ero kor-e no, á yake elne ka tib go bo esi, <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />eji á lꞌjo lim bo, bo jol ebo ebo ngare nyi á ma lim bo ma bar, tib eji á ma wohngo bo alahb go ege alum. <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />Á limi ano, eji aneb ero lꞌyiimi a egburu ellub go ege esamahr, kꞌbel elem ajehng ajehng, a agbahnggenne, a ejum ajehng ajehng ji li go elfoongo nio, eji bo lꞌjol ebo ebo, kꞌbel egahme ajehng ajehng.<verse eid="EPH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EPH 5:28" />Alum ane, nong, akal ebahne jo koren ana agubjing enyahne wahnfono antahng. Nne no nkal ewe lꞌkor-e, ngubjing enye nyi kp-e koro. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />Nnene limm, no ma kꞌko ngubjing enye ekv. Á kpo le ngubjing enye, fere jo kuuru, ana Kraist kpꞌlimi ka aneb ero. <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />Tibre wahr ba li ngubjing enye.<note caller="+" style="f"><char style="fr" closed="false">5:30 </char><char style="ft" closed="false">1 Kor 11:11-12</char></note><verse eid="EPH 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EPH 5:31" />Ana nwer Esowo bungu no re, “Esi jia ji wahnge nne bahke tahme nde, a nnyehn sa, bo song jol ano a nkal ewe. Bo ane abal abal bahke fere jol ajehng.”<verse eid="EPH 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EPH 5:32" />A egburu nkpokosi nyi. N kpꞌbungu bada Kraist, a aneb ero ebe. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />Tob li ka wahn re, nne awohng awohng ewahne, nkal ewe jo kor-e ana ngubjing enye. Nong, nkal a nne jo kak nlum ewe.<note caller="+" style="f"><char style="fr" closed="false">5:33 </char><char style="ft" closed="false">Kol 3:18-19</char></note><verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">Bade babnde nne, a abon ebo</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />Abonse, jo wuken babnso ejahne, a babnne ejahne, eji ń li abon ba Jehova. Tibre a wo li etingitingi mbang.<note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="ft" closed="false">Luk 2:51</char></note> <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />“Kak nso, a nne!” A wo li ngbokambang a ntahm nyi Esowo ka no, fere nyam enyam kunu re, <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />“Bahke nobo a na, a fere kang nnya tvv go ejahbe jio.”<verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />Babnde nne, kana jo fili abon ebahne go mbang nyi bo bahke jo bel erakatahng.<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">Kol 3:21</char></note> Ga nob re wahn jo le bo, fere jo luumu bo, a elle atubu go mbang nyi Jehova.<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">Hib 12:9-10</char></note><verse eid="EPH 6:4" /></para>
  <para style="s">Bade babnde aju, a aju ebo</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />Aju, jo wuken babnso ejahne ba njini nyia, wahn fere jo fahl bo, fere jo kahm bo. Jo loken bo a eltim anehng, ana ń kpꞌloko Kraist.<note caller="+" style="f"><char style="fr" closed="false">6:5 </char><char style="ft" closed="false">Kol 3:22-25; Tait 2:9-10; 1 Pit 2:18</char></note> <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />Kana jo lim eltum ngare nyi bo kp-n nyehne nyi nyi, ana ane ba kpo lim ji kpo kor ane. Jo limen ji Esowo kpꞌsebe re wahn lim a ntim a ntim enyahne ana aju nya Kraist. <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />Kana jo loko elmooko elmooko. Jo loken ana ane ba kpꞌloko Jehova, ba kil loko ane,<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="ft" closed="false">Kol 3:17</char></note> <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />eji ń kpꞌkahne re, nnoobo anyehng anyehng nyi nne limi no, nyi nyi Jehova bahke feere a nyi ka-e, jol afi á jolo nju, afi nju á jolem.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />Babnde aju, tob jo limen ano jang jang ka aju enyahne. Kana kpe jo nehke bo, eji ń kpꞌkahne re n kpi nde na awohng go ejahbetul, no kil jo rang nne awohng awohng.<note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">Kol 4:1</char></note><verse eid="EPH 6:9" /></para>
  <para style="s">Nsol ebta nyi nne Esowo</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />Abonanee, esꞌkohro elbungu ename ni a, ni li re wahn bel atahne nyao nya Esowo, nya lohng go nsahm nyi agbal enye.<verse eid="EPH 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 6:11" />Jo kaken nsol ebta nyi Esowo ka-n no, eji ń lꞌmal yiimi a nnehm, a awak enye.<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">2 Kor 10:4; 11:14</char></note> <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Tibre e nehme nok a ane, e kpꞌnoko a abi atohko, ana atul, a ajꞌjok ane, a atubesi ba eying jia ji anv ji ejannge, a ellong abi atohko gbalee nya li go adi nya li go elbung.<verse eid="EPH 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 6:13" />Owo fvfo, nobo re wahn rod nsol ebta nyi Esowo kak, eji ń lꞌmal elyiimi go ebꞌbi efung bio o.<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Ell 3:10</char></note> Eji ḿ ma lim ano kpee mal, owo ḿ bahke yiimi. <verse eid="EPH 6:13" /><verse number="14" style="v" sid="EPH 6:14" />Anv, yiimen ana ane ba ma gbaange egbaange ji li etingitingi go ebun.<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">Luk 12:35</char></note> Kaken ngbanggbang nyi nsoja kpo ko bam ngang, nyi li eno ji ḿ ma li go esamahr bi Esowo.<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">1 Tes 5:8</char></note> <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />Kaken akpaketa go egahne akpade, nya li ebjing bi ḿ ma toobo re wahn song tiingi nnoobo etib bi elkoono.<verse eid="EPH 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EPH 6:16" />Filen ekum bi bahk-n bame kpee, bi li eltaame ni ḿ bahke ma jo gbiiri atakelban nya Ebinne, nya li agun agun.<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">1 Pit 5:8-9; 1 Jon 5:4</char></note> <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />Konngen ekpasi ebta ji li eltahre, wahn rod ekahngkahng bio bi etohko, bi li alum Esowo.<note caller="+" style="f"><char style="fr" closed="false">6:17 </char><char style="ft" closed="false">Mat 10:34</char></note><verse eid="EPH 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 6:18" />Jo limen nsol nyia kpee go ero akake, a Esowo agboongo. Jo kaken ero ngare anyehng anyehng ana Etingi Etohko kp-n tibi. Jo baaben, eji ń kpꞌkake ero, ki-n jo kpen. Jo gboongen Esowo ka aneb Esowo bako kpee, <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />a me fvfo, eji Esowo lꞌka-m alum nya m bahke jo bung a esahb esahb, fere tiingi ane nkpokosi a nnoobo etib,<note caller="+" style="f"><char style="fr" closed="false">6:19 </char><char style="ft" closed="false">2 Tes 3:1; Elt 4:29</char></note> <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />bi wahnge Esowo kak-m eltum. Jo kaken ero tv-m, eji n lꞌjo bung esahb esahb ana fuumu re me m bung, jol eji n wobo wob ngbekobo.<note caller="+" style="f"><char style="fr" closed="false">6:20 </char><char style="ft" closed="false">2 Kor 2:17</char></note><verse eid="EPH 6:20" /></para>
  <para style="s">Ana Pol kake bo nnyo</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />Tikikus ji li akor-m mmonannee,<note caller="+" style="f"><char style="fr" closed="false">6:21 </char><char style="ft" closed="false">Elt 20:4; 2 Tim 4:12; Tait 3:12</char></note> ye ji tob li nkakesehk a nlokeltum go eltum ni Jehova bahk-n tongo ejum ajehng ajehng, eji ń lꞌkahn ana n li ga, fere kahn ji n kpꞌlimi.<verse eid="EPH 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 6:22" />Ji wahnge m m-e tum tv-n, n tum-e, eji ń lꞌkahn ana e li ga, á fere kak-n eltim.<note caller="+" style="f"><char style="fr" closed="false">6:22 </char><char style="ft" closed="false">Kol 4:7-8</char></note><verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />Nong, Esowo Nsoo, a Ntul a Jisos Kraist ka abonanee elkoono, a elkoro, a eltaame. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />Nong, nnoobo nyi Esowo jol a ane ba elkoro ebo lꞌkꞌtiki mal, ni Jisos Kraist Ntul ewahre kpi bo kor.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>