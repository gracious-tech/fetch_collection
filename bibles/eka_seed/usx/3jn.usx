<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Ekajuk New Testament</book>
  <para style="h">3 Jon</para>
  <para style="toc1">3 Jon</para>
  <para style="toc2">3 Jon</para>
  <para style="mt2">3 NWER NYI</para>
  <para style="mt1">JON</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Me nnenkul, me wo kpꞌnyono nwer nyia tv Gayus ekpondahme ejame, ye ji kpo kor-m, tib eji e kpꞌtoono etingitingi.<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">2 Jon 1</char></note><verse eid="3JN 1:1" /></para>
  <para style="s">Bada Gayus</para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />Ekpondahme ejame, n kpꞌkake ero re, ejum ajehng ajehng eja jol nob nob, wo fere jol go efel, tib eji n kpꞌkahne re, etohko eja jia nob nob.<verse eid="3JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="3JN 1:3" />Atahng jo yeb-m sehng, eji abonanee bandiki ba no, ba yiimi ntianse re, a kpꞌtoono etingitingi, ano wo a kpꞌlohko toono.<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">2 Jon 4</char></note> <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Eyebatahng ajehng ajehng limm, ji m bahke kpe bel, sehnge jia ji m ma wuk re, abon ebame kpꞌtoono etingitingi.<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">1 Kor 4:14</char></note><verse eid="3JN 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Ekpondahme ejame, li nnoobo ejum sehng eji a kpꞌkake abonanee ebo go mbang anyehng anyehng, asehngesehnge ajenne. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />Bobyiimi ntianse go esamahr aneb ero bade elkoro ni a kpi no. Titi, lub kak bo ebo go bo eljen ji bo bahke tahme.<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">Tait 3:13</char></note> Lim ano go mbang nyi bahke koro Esowo. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Tibre mbing enye nyi wahnge bo ma tahm eljen jio. Bo kpehme ko ejum ajehng ajehng goji ane baka baka ba ki nyi Esowo.<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">1 Kor 9:12,15</char></note> <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Wahr ba fuumu re, wahr kak elkohn ane bao ebo, eji e lꞌtob jol ane ba kpꞌtob lim eltum ka etingitingi ana bo.<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">Hib 13:2</char></note><verse eid="3JN 1:8" /></para>
  <para style="s">Bada Diotrefes, a Demetrius</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Me n nyon nwer tv aneb ero. Diotrefes ji kpo kor-e re á jol ntubesi abo, ebten alum enyahre. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Ngare nyi n lꞌba go, owo m bahke ba bung nsol nyi á ma lim, ana á kpꞌbungu abi alum nya ki li go etingitingi tob-r. Jol tvtv o, we nehme gbal, á kpehme vvrv abonanee, bo lꞌba. Á kpo sahde ane ba kpo seb re bo jo vvrv abonanee, fere jo kam ane bao yehke go ero.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Ekpondahme ejame, ka jo leeme ebi! Jo leeme ji kpꞌnobo! Nne no kpo lim nnoobo, á li ka Esowo. Nne no kpo lim ebi, á ka nyehn Esowo.<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">1 Jon 3:6; Rom 2:10; 12:9</char></note><verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />Ane kpee kpo yiimi Demetrius ntianse. Yefono etingitingi kpꞌtob yiim-e ntianse. Wahr fvfo, e kpo tob yiim-e ntianse. A kpꞌkahne re ntianse enyame li go etingitingi.<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">Jon 19:35; 21:24</char></note><verse eid="3JN 1:12" /></para>
  <para style="s">Esꞌkohro alum</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />N kpi nsol gbalee nyi kehn n jol nyono tv-a. Me nehme kor re me n ko alahb nwer, a ebti nwer nyon. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />N kpꞌbumu re, m bahk-a gulu elnyehne, e fere bung atemtem.<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />Nong, elkoono jol a na. Ate eba kp-a kake nnyo. Kak ate ebahre nnyo, bo ane kpee, go nne awohng awohng.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>